          ((physicalSelectedGroupReindex e (fun g => P g.val)
            (fun j (g : {g // g ∉ groupsᶜ}) =>
              C (physicalRootSmallPlanPattern groups patterns C hC pl j).val g.val)).symm d)) record =
      weight * physicalSelectedSmallWeight
        (fun j (g : ↥groupsᶜ) => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val g.val)
        (fun g => V g.val) q (physicalGroupResidueVector r)
        (Fin.partialSum (physicalRecordDisplacement Cn kn cut record))
        (physicalRootSmallPlanSmallData groups patterns C hC pl) := by
  dsimp only
  simp_rw [physical_root_numbered_small_weight_cumulative groups e patterns C hC k pl V hq r]
  exact physical_original_weighted_offset_phase
    (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val)
    (physicalRootPlanMultiplier groups patterns C hC k pl)
    ω β retention ρ (fun g => V (e.symm g).val) cut hencode
    (fun a => physicalSelectedSmallWeight
      (fun j (g : ↥groupsᶜ) => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val g.val)
      (fun g => V g.val) q (physicalGroupResidueVector r) a
      (physicalRootSmallPlanSmallData groups patterns C hC pl)) x hx path

end Root
