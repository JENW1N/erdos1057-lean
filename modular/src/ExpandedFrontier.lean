section
open Finset Classical
theorem full_mixed_pattern_mask_energy_le
    {I J K G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    {M : G → ℕ} (S : I → K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ i k, SharedActiveLabels P (S i k) → Type*)
    [∀ i k c, Fintype (A i k c)]
    (Δ D : ∀ i k c, A i k c → G → ℤ)
    (ω : ∀ i k c, A i k c → ℝ)
    (μ : ∀ g, P g → ℝ) (q : I → J → ℝ) (ρ : ℝ) (V : G → ℝ)
    (hω : ∀ i k c a, 0 ≤ ω i k c a)
    (hωmass : ∀ i k c, ∑ a, ω i k c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 < μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hq0 : ∀ i j, 0 ≤ q i j) (hq1 : ∀ i j, q i j ≤ 1)
    (hD : ∀ i j, q i j / ρ ^ 2 + ((1 - q i j) / ρ) / v ≤ 1)
    (hC : ∀ i j g, q i j / ρ ^ 2 + ((1 - q i j) * V g / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ i k g, (S i k g)ᶜ.card ≤ T)
    (steps : I → List (J ⊕ K))
    (allowed : ∀ i s, FullMixedMemoryPath n (S i) B (A i) (Δ i) (D i) (steps i) s → Prop)
    (phase : ∀ i s, FullMixedMemoryPath n (S i) B (A i) (Δ i) (D i) (steps i) s → ℂ)
    (hphase : ∀ i s p, ‖phase i s p‖ ≤ 1)
    (patterns : Finset I) (coeffBound : I → ℝ)
    (hcoeffBound : ∀ i ∈ patterns, 0 ≤ coeffBound i)
    (coeff : I → ProductBoundedOrderedState P
      (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hcoeff : ∀ i ∈ patterns, ∀ s, ‖coeff i s‖ ≤ coeffBound i)
    {H C : ℝ} (hH : ∑ i ∈ patterns, coeffBound i ≤ H) (hC0 : 0 ≤ C)
    (hcost : ∀ i ∈ patterns,
      ((steps i).map (mixedMemoryStepEnergy ρ v vmin vmax T (Fintype.card G))).prod ≤ C)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fun s => ∑ i ∈ patterns, coeff i s *
        fullMixedMemoryPathAction n (S i) B (A i) (Δ i) (D i) (ω i) μ (q i) ρ V (steps i)
          (fun x p => if allowed i x p then phase i x p else 0) f s) ≤
    H ^ 2 * C *
      finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  have hmeasure : ∀ s : ProductBoundedOrderedState P
      (fun g => UnrestrictedResidueParticle (n g)) M B,
      0 ≤ productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)) s :=
    productMemoryWeight_nonneg μ (fun g => unrestrictedResidueWeight (μ g))
    (fun g p => (hμ g p).le) (fun g z => (hμ g z.1).le)
  apply finite_pattern_energy_le patterns _ hmeasure coeffBound hcoeffBound coeff _ hcoeff hH hC0 f
  intro i hi
  have h := full_mixed_memory_path_mask_energy_le n (S i) B (A i) (Δ i) (D i) (ω i) μ
    (q i) ρ V (hω i) (hωmass i) hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass (hq0 i) (hq1 i)
    (hD i) (hC i) T (ht i) (steps i) (allowed i) (phase i) (hphase i) f hf
  exact h.trans (mul_le_mul_of_nonneg_right (hcost i hi)
    (sum_nonneg fun s _ => mul_nonneg (hmeasure s) (sq_nonneg _)))

/-- The coefficient may depend on the entire trajectory. Its uniform bound
is paid once in total pattern mass, including when that bound is zero. -/
theorem full_mixed_pattern_bounded_phase_energy_le
    {I J K G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    {M : G → ℕ} (S : I → K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ i k, SharedActiveLabels P (S i k) → Type*)
    [∀ i k c, Fintype (A i k c)]
    (Δ D : ∀ i k c, A i k c → G → ℤ)
    (ω : ∀ i k c, A i k c → ℝ)
    (μ : ∀ g, P g → ℝ) (q : I → J → ℝ) (ρ : ℝ) (V : G → ℝ)
    (hω : ∀ i k c a, 0 ≤ ω i k c a)
    (hωmass : ∀ i k c, ∑ a, ω i k c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 < μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hq0 : ∀ i j, 0 ≤ q i j) (hq1 : ∀ i j, q i j ≤ 1)
    (hD : ∀ i j, q i j / ρ ^ 2 + ((1 - q i j) / ρ) / v ≤ 1)
    (hC : ∀ i j g, q i j / ρ ^ 2 + ((1 - q i j) * V g / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ i k g, (S i k g)ᶜ.card ≤ T)
    (steps : I → List (J ⊕ K))
    (allowed : ∀ i s, FullMixedMemoryPath n (S i) B (A i) (Δ i) (D i) (steps i) s → Prop)
    (phase : ∀ i s, FullMixedMemoryPath n (S i) B (A i) (Δ i) (D i) (steps i) s → ℂ)
    (coeffBound : I → ℝ) (hcoeffBound : ∀ i, 0 ≤ coeffBound i)
    (hphase : ∀ i s p, ‖phase i s p‖ ≤ coeffBound i)
    (patterns : Finset I)
    {H C : ℝ} (hH : ∑ i ∈ patterns, coeffBound i ≤ H) (hC0 : 0 ≤ C)
    (hcost : ∀ i ∈ patterns,
      ((steps i).map (mixedMemoryStepEnergy ρ v vmin vmax T (Fintype.card G))).prod ≤ C)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fun s => ∑ i ∈ patterns,
        fullMixedMemoryPathAction n (S i) B (A i) (Δ i) (D i) (ω i) μ (q i) ρ V (steps i)
          (fun x p => if allowed i x p then phase i x p else 0) f s) ≤
    H ^ 2 * C *
      finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  have h := full_mixed_pattern_mask_energy_le n S B A Δ D ω μ q ρ V hω hωmass
    hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass hq0 hq1 hD hC T ht steps allowed
    (fun i s p => phase i s p / (coeffBound i : ℂ))
    (fun i s p => norm_div_real_bound_le_one (hcoeffBound i) (hphase i s p))
    patterns coeffBound (fun i _ => hcoeffBound i) (fun i _ => (coeffBound i : ℂ))
    (fun i _ _ => by simp [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hcoeffBound i)])
    hH hC0 hcost f hf
  convert h using 2
  funext s
  apply sum_congr rfl
  intro i hi
  dsimp only [fullMixedMemoryPathAction]
  rw [← finite_event_path_phase_mul]
  congr 1
  funext x p
  by_cases hp : allowed i x p
  · simp only [if_pos hp]
    exact (real_bound_mul_div_eq (hphase i x p)).symm
  · simp only [if_neg hp, mul_zero]
end

