open scoped BigOperators Classical
theorem prime_ideal_kernel_conj {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ) (Q : ℕ) (h : ℝ) (kept : Finset ℤ) (x y : ∀ j, P j) :
    (starRingEnd ℂ) (primeProductIdealKernel P V Q h kept x y) =
      primeProductIdealKernel P V Q h kept y x :=
  finite_cell_kernel_conj _ _ _ _ x y

theorem prime_ideal_kernel_log_localized {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ) (Q : ℕ) {h : ℝ} (hh : 0 < h)
    (kept : Finset ℤ) (x y : ∀ j, P j) (hne : primeProductIdealKernel P V Q h kept x y ≠ 0) :
    |Real.log (∏ j, (x j).val : ℕ) - Real.log (∏ j, (y j).val : ℕ)| < h := by
  apply upper_log_cell_distance_lt hh
  unfold primeProductIdealKernel finiteCellFrameKernel at hne
  split_ifs at hne with he
  · exact he.1
  · exact (hne rfl).elim

theorem prime_ideal_kernel_norm_le {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ) (Q : ℕ) (h : ℝ) (kept : Finset ℤ)
    {ξ : ℝ} (hξ : 0 < ξ)
    (hkept : ∀ d ∈ kept, ξ ≤ finiteCellMass (finiteProductWeight (physicalLabelLaw (P := P) V))
      (fun x => upperLogCell h (Real.log (∏ j, (x j).val : ℕ))) d) (x y : ∀ j, P j) :
    ‖primeProductIdealKernel P V Q h kept x y‖ ≤ (Q * Q : ℕ) / ξ := by
  have hψ (t : BoundedPrimitiveCharacter Q) (z : ∀ j, P j) :
      ‖star (boundedPrimitiveValue t ((∏ j, (z j).val : ℕ) : ZMod (boundedPrimitiveModulus t)))‖ ≤ 1 := by
    rw [norm_star]
    exact (boundedPrimitiveValue t).norm_le_one _
  have hb := finite_cell_kernel_norm_le
    (finiteProductWeight (physicalLabelLaw (P := P) V))
    (fun z => upperLogCell h (Real.log (∏ j, (z j).val : ℕ))) kept _ hψ hξ hkept x y
  exact hb.trans (div_le_div_of_nonneg_right (by exact_mod_cast bounded_primitive_character_card_le Q) hξ.le)

theorem prime_ideal_kernel_abs_row_le {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ) (hV : ∀ i, 0 ≤ V i) (Q : ℕ) (h : ℝ) (kept : Finset ℤ)
    (hkept : ∀ d ∈ kept, 0 < finiteCellMass (finiteProductWeight (physicalLabelLaw (P := P) V))
      (fun x => upperLogCell h (Real.log (∏ j, (x j).val : ℕ))) d) (x : ∀ j, P j) :
    (∑ y, finiteProductWeight (physicalLabelLaw V) y * ‖primeProductIdealKernel P V Q h kept x y‖) ≤
      (Q * Q : ℕ) := by
  have hμ (z : ∀ j, P j) : 0 ≤ finiteProductWeight (physicalLabelLaw V) z :=
    Finset.prod_nonneg (fun j _ => physical_label_law_nonneg V hV j (z j))
  have hψ (t : BoundedPrimitiveCharacter Q) (z : ∀ j, P j) :
      ‖star (boundedPrimitiveValue t ((∏ j, (z j).val : ℕ) : ZMod (boundedPrimitiveModulus t)))‖ ≤ 1 := by
    rw [norm_star]
    exact (boundedPrimitiveValue t).norm_le_one _
  exact (finite_cell_kernel_abs_row_le _ hμ _ kept hkept _ hψ x).trans
    (by exact_mod_cast bounded_primitive_character_card_le Q)

theorem prime_ideal_kernel_abs_column_le {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ) (hV : ∀ i, 0 ≤ V i) (Q : ℕ) (h : ℝ) (kept : Finset ℤ)
    (hkept : ∀ d ∈ kept, 0 < finiteCellMass (finiteProductWeight (physicalLabelLaw (P := P) V))
      (fun x => upperLogCell h (Real.log (∏ j, (x j).val : ℕ))) d) (y : ∀ j, P j) :
    (∑ x, finiteProductWeight (physicalLabelLaw V) x * ‖primeProductIdealKernel P V Q h kept x y‖) ≤
      (Q * Q : ℕ) := by
  have hn (x : ∀ j, P j) : ‖primeProductIdealKernel P V Q h kept x y‖ =
      ‖primeProductIdealKernel P V Q h kept y x‖ := by
    rw [← prime_ideal_kernel_conj P V Q h kept y x, Complex.norm_conj]
  simp_rw [hn]
  exact prime_ideal_kernel_abs_row_le P V hV Q h kept hkept y
end

section

theorem dirichlet_coprime_nat_bound (α : ℝ) (n : ℕ) (hn : 0 < n) :
    ∃ (u : ℤ) (r : ℕ), 0 < r ∧ r ≤ n ∧ (r : ℤ).gcd u = 1 ∧
      |α - (u : ℝ) / (r : ℝ)| ≤ 1 / (((n : ℝ) + 1) * (r : ℝ)) := by
  obtain ⟨q, hq, hden⟩ := Real.exists_rat_abs_sub_le_and_den_le α hn
  refine ⟨q.num, q.den, q.pos, hden, ?_, ?_⟩
  · simpa only [Int.gcd_def, Int.natAbs_natCast] using q.reduced.symm
  · simpa only [Rat.cast_def] using hq

/-- The `n+1` denominator in finite Dirichlet approximation absorbs the floor
loss, so the scaled error has constant one rather than two. -/
theorem dirichlet_coprime_real_bound (α Z S : ℝ)
    (hZ : 0 < Z) (hS : 0 < S) (hscale : 1 ≤ Z / S) :
    ∃ (u : ℤ) (r : ℕ), 0 < r ∧ (r : ℝ) ≤ Z / S ∧ (r : ℤ).gcd u = 1 ∧
      |α - (u : ℝ) / (r : ℝ)| ≤ 1 / (r : ℝ) ^ 2 ∧
      |α - (u : ℝ) / (r : ℝ)| * Z ≤ S / (r : ℝ) := by
  let n : ℕ := ⌊Z / S⌋₊
  have hn : 0 < n := Nat.floor_pos.mpr hscale
  obtain ⟨u, r, hr, hrn, hcop, hβ⟩ := dirichlet_coprime_nat_bound α n hn
  have hrR : (0 : ℝ) < r := by exact_mod_cast hr
  have hnR : (0 : ℝ) < n + 1 := by positivity
  have hrnR : (r : ℝ) ≤ n := by exact_mod_cast hrn
  have hnle : (n : ℝ) ≤ Z / S := Nat.floor_le (by positivity)
  have hZle : Z ≤ ((n : ℝ) + 1) * S :=
    (div_le_iff₀ hS).mp (Nat.lt_floor_add_one (Z / S)).le
  refine ⟨u, r, hr, hrnR.trans hnle, hcop, ?_, ?_⟩
  · refine hβ.trans (one_div_le_one_div_of_le (sq_pos_of_pos hrR) ?_)
    nlinarith
  · calc
      _ ≤ (1 / (((n : ℝ) + 1) * (r : ℝ))) * Z :=
        mul_le_mul_of_nonneg_right hβ hZ.le
      _ ≤ (1 / (((n : ℝ) + 1) * (r : ℝ))) * (((n : ℝ) + 1) * S) :=
        mul_le_mul_of_nonneg_left hZle (by positivity)
      _ = S / (r : ℝ) := by field_simp

/-- A decomposition in the exact coprime form used by rational phase separation. -/
theorem dirichlet_scaled_decomposition (α Z S : ℝ)
    (hZ : 0 < Z) (hS : 0 < S) (hscale : 1 ≤ Z / S) :
    ∃ (u : ℤ) (r : ℕ) (β : ℝ), 0 < r ∧ (r : ℝ) ≤ Z / S ∧
      (r : ℤ).gcd u = 1 ∧ α = (u : ℝ) / (r : ℝ) + β ∧
      |β| ≤ 1 / (r : ℝ) ^ 2 ∧ |β| * Z ≤ S / (r : ℝ) := by
  obtain ⟨u, r, hr, hbudget, hcop, hβ, hscaled⟩ :=
    dirichlet_coprime_real_bound α Z S hZ hS hscale
  exact ⟨u, r, α - (u : ℝ) / (r : ℝ), hr, hbudget, hcop, by ring, hβ, hscaled⟩

/-- The manuscript's looser constant-two version follows with no loss of
coprimality and without rounding the real denominator budget upward. -/
theorem dirichlet_scaled_decomposition_two (α Z S : ℝ)
    (hZ : 0 < Z) (hS : 0 < S) (hscale : 2 ≤ Z / S) :
    ∃ (u : ℤ) (r : ℕ) (β : ℝ), 0 < r ∧ (r : ℝ) ≤ Z / S ∧
      (r : ℤ).gcd u = 1 ∧ α = (u : ℝ) / (r : ℝ) + β ∧
      |β| ≤ 1 / (r : ℝ) ^ 2 ∧ |β| * Z ≤ 2 * S / (r : ℝ) := by
  obtain ⟨u, r, β, hr, hbudget, hcop, heq, hβ, hscaled⟩ :=
    dirichlet_scaled_decomposition α Z S hZ hS (by linarith)
  refine ⟨u, r, β, hr, hbudget, hcop, heq, hβ, hscaled.trans ?_⟩
  exact div_le_div_of_nonneg_right (by linarith) (Nat.cast_nonneg r)
end

section

noncomputable def majorArcMultiplier (ζ β v : ℝ) : ℂ :=
  Complex.exp (Complex.I * (ζ * v + 2 * Real.pi * β * Real.exp v : ℝ))

theorem real_exp_sub_le_endpoint (v w R : ℝ) (hvw : v ≤ w)
    (hw : Real.exp w ≤ R) : Real.exp w - Real.exp v ≤ R * (w - v) := by
  have ht := mul_le_mul_of_nonneg_left (Real.add_one_le_exp (v - w)) (Real.exp_pos w).le
  rw [← Real.exp_add, show w + (v - w) = v by ring] at ht
  have hR := mul_le_mul_of_nonneg_right hw (sub_nonneg.mpr hvw)
  nlinarith

theorem real_exp_lipschitz_of_endpoint_bounds (v w R : ℝ)
    (hv : Real.exp v ≤ R) (hw : Real.exp w ≤ R) :
    |Real.exp v - Real.exp w| ≤ R * |v - w| := by
  rcases le_total v w with h | h
  · rw [abs_of_nonpos (sub_nonpos.mpr (Real.exp_le_exp.mpr h)),
      abs_of_nonpos (sub_nonpos.mpr h)]
    simpa only [neg_sub] using real_exp_sub_le_endpoint v w R h hw
  · rw [abs_of_nonneg (sub_nonneg.mpr (Real.exp_le_exp.mpr h)),
      abs_of_nonneg (sub_nonneg.mpr h)]
    exact real_exp_sub_le_endpoint w v R h hv

theorem unit_complex_phase_lipschitz (v w : ℝ) :
    ‖Complex.exp (Complex.I * (v : ℂ)) - Complex.exp (Complex.I * (w : ℂ))‖ ≤ |v - w| := by
  have he : Complex.exp (Complex.I * (v : ℂ)) - Complex.exp (Complex.I * (w : ℂ)) =
      Complex.exp (Complex.I * (w : ℂ)) * (Complex.exp (Complex.I * ((v - w : ℝ) : ℂ)) - 1) := by
    rw [mul_sub, mul_one, ← Complex.exp_add]
    congr 2
    push_cast
    ring
  rw [he, norm_mul]
  have hn : ‖Complex.exp (Complex.I * (w : ℂ))‖ = 1 := by
    simpa only [mul_comm] using Complex.norm_exp_ofReal_mul_I w
  rw [hn, one_mul]
  exact Real.norm_exp_I_mul_ofReal_sub_one_le

theorem major_arc_multiplier_norm (ζ β v : ℝ) : ‖majorArcMultiplier ζ β v‖ = 1 := by
  unfold majorArcMultiplier
  simpa only [mul_comm] using
    Complex.norm_exp_ofReal_mul_I (ζ * v + 2 * Real.pi * β * Real.exp v)

theorem major_arc_multiplier_lipschitz (ζ β v w R : ℝ)
    (hv : Real.exp v ≤ R) (hw : Real.exp w ≤ R) :
    ‖majorArcMultiplier ζ β v - majorArcMultiplier ζ β w‖ ≤
      (|ζ| + 2 * Real.pi * |β| * R) * |v - w| := by
  have hc : 0 ≤ 2 * Real.pi * |β| := by positivity
  have he : (ζ * v + 2 * Real.pi * β * Real.exp v) -
      (ζ * w + 2 * Real.pi * β * Real.exp w) =
      ζ * (v - w) + (2 * Real.pi * β) * (Real.exp v - Real.exp w) := by ring
  calc
    _ ≤ |(ζ * v + 2 * Real.pi * β * Real.exp v) -
        (ζ * w + 2 * Real.pi * β * Real.exp w)| :=
      unit_complex_phase_lipschitz _ _
    _ ≤ |ζ * (v - w)| + |(2 * Real.pi * β) * (Real.exp v - Real.exp w)| := by
      rw [he]
      exact abs_add_le _ _
    _ = |ζ| * |v - w| + (2 * Real.pi * |β|) * |Real.exp v - Real.exp w| := by
      simp only [abs_mul, abs_of_pos Real.pi_pos, abs_of_pos (show (0 : ℝ) < 2 by norm_num)]
    _ ≤ |ζ| * |v - w| + (2 * Real.pi * |β|) * (R * |v - w|) :=
      add_le_add_right (mul_le_mul_of_nonneg_left (real_exp_lipschitz_of_endpoint_bounds v w R hv hw) hc) _
    _ = _ := by ring

/-- Two logarithmic coordinates moving by at most one cell width move their sum
by at most two widths. The same endpoint product bound controls the multiplier. -/
theorem major_arc_multiplier_two_coordinates (ζ β a b a' b' R h : ℝ)
    (ha : |a - a'| ≤ h) (hb : |b - b'| ≤ h)
    (hab : Real.exp (a + b) ≤ R) (hab' : Real.exp (a' + b') ≤ R) :
    ‖majorArcMultiplier ζ β (a + b) - majorArcMultiplier ζ β (a' + b')‖ ≤
      2 * h * (|ζ| + 2 * Real.pi * |β| * R) := by
  have hR : 0 ≤ R := (Real.exp_pos (a + b)).le.trans hab
  have hC : 0 ≤ |ζ| + 2 * Real.pi * |β| * R := by positivity
  have hdiff : |(a + b) - (a' + b')| ≤ 2 * h := by
    calc
      _ = |(a - a') + (b - b')| := by congr 1; ring
      _ ≤ |a - a'| + |b - b'| := abs_add_le _ _
      _ ≤ 2 * h := by linarith
  calc
    _ ≤ (|ζ| + 2 * Real.pi * |β| * R) * |(a + b) - (a' + b')| :=
      major_arc_multiplier_lipschitz ζ β _ _ R hab hab'
    _ ≤ (|ζ| + 2 * Real.pi * |β| * R) * (2 * h) :=
      mul_le_mul_of_nonneg_left hdiff hC
    _ = _ := by ring

/-- Product notation for cell representatives, with their enlarged product range
stated explicitly rather than inferred from individual endpoint bounds. -/
theorem major_arc_multiplier_log_products (ζ β x y x' y' R h : ℝ)
    (hx : 0 < x) (hy : 0 < y) (hx' : 0 < x') (hy' : 0 < y')
    (hlogx : |Real.log x - Real.log x'| ≤ h)
    (hlogy : |Real.log y - Real.log y'| ≤ h)
    (hxy : x * y ≤ R) (hxy' : x' * y' ≤ R) :
    ‖majorArcMultiplier ζ β (Real.log (x * y)) -
        majorArcMultiplier ζ β (Real.log (x' * y'))‖ ≤
      2 * h * (|ζ| + 2 * Real.pi * |β| * R) := by
  rw [Real.log_mul hx.ne' hy.ne', Real.log_mul hx'.ne' hy'.ne']
  apply major_arc_multiplier_two_coordinates ζ β _ _ _ _ R h hlogx hlogy
  · simpa only [Real.exp_add, Real.exp_log hx, Real.exp_log hy] using hxy
  · simpa only [Real.exp_add, Real.exp_log hx', Real.exp_log hy'] using hxy'
end

section
open Finset
theorem fin_tensor_row_events_at (N : ℕ) {S T : Fin N → Type*}
    (row : (g : Fin N) → (T g → ℂ) → S g → ℂ) (s : (g : Fin N) → S g)
    (E : Fin N → Type*) [∀ g, Fintype (E g)]
    (target : (g : Fin N) → E g → T g) (weight : (g : Fin N) → E g → ℂ)
    (hrow : ∀ g F, row g F (s g) = ∑ e : E g, weight g e * F (target g e))
    (F : ((g : Fin N) → T g) → ℂ) :
    finTensorRow N row F s =
      ∑ e : (g : Fin N) → E g, (∏ g, weight g (e g)) * F (fun g => target g (e g)) := by
  classical
  have he := fin_tensor_row_intertwines_on N
    (S := fun _ => Unit) (T := T)
    (fun g G _ => ∑ e : E g, weight g e * G (target g e)) row
    (fun g _ => s g) (fun _ t => t) (fun _ _ => True) (fun _ _ => True)
    (by
      intro g u _ G K hGK
      have hh : G = K := funext (fun t => hGK t trivial)
      rw [hh]
      exact (hrow g K).symm)
    F F (fun _ _ => rfl) (fun _ => ()) (fun _ => trivial)
  rw [← he]
  exact fin_tensor_row_events N (fun g (_ : Unit) => E g)
    (fun g _ => target g) (fun g _ => weight g) F (fun _ => ())
end

section
open scoped BigOperators Classical
noncomputable def finiteOccupiedCells {X D : Type*} [Fintype X] [DecidableEq D]
    (cell : X → D) : Finset D := Finset.univ.image cell

noncomputable def finiteRetainedCells {X D : Type*} [Fintype X] [DecidableEq D]
    (μ : X → ℝ) (cell : X → D) (ξ : ℝ) : Finset D :=
  (finiteOccupiedCells cell).filter (fun d => ξ ≤ finiteCellMass μ cell d)

theorem finite_cell_mem_occupied {X D : Type*} [Fintype X] [DecidableEq D]
    (cell : X → D) (x : X) : cell x ∈ finiteOccupiedCells cell := by
  exact Finset.mem_image.mpr ⟨x, Finset.mem_univ x, rfl⟩

theorem finite_retained_cell_mass {X D : Type*} [Fintype X] [DecidableEq D]
    (μ : X → ℝ) (cell : X → D) (ξ : ℝ) {d : D}
    (hd : d ∈ finiteRetainedCells μ cell ξ) : ξ ≤ finiteCellMass μ cell d :=
  (Finset.mem_filter.mp hd).2

theorem finite_cell_not_retained_iff {X D : Type*} [Fintype X] [DecidableEq D]
    (μ : X → ℝ) (cell : X → D) (ξ : ℝ) (x : X) :
    cell x ∉ finiteRetainedCells μ cell ξ ↔ finiteCellMass μ cell (cell x) < ξ := by
  simp only [finiteRetainedCells, Finset.mem_filter, finite_cell_mem_occupied, true_and, not_le]

theorem finite_cell_mass_partition {X D : Type*} [Fintype X] [DecidableEq D]
    (μ : X → ℝ) (cell : X → D) (S : Finset D) :
    (∑ d ∈ S, finiteCellMass μ cell d) = ∑ x, if cell x ∈ S then μ x else 0 := by
  unfold finiteCellMass
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro x _
  by_cases hx : cell x ∈ S
  · rw [if_pos hx, Finset.sum_eq_single (cell x)]
    · simp
    · intro d _ hd
      simp [Ne.symm hd]
    · exact fun h => (h hx).elim
  · rw [if_neg hx]
    apply Finset.sum_eq_zero
    intro d hd
    have he : cell x ≠ d := by intro he; exact hx (he ▸ hd)
    simp [he]

theorem finite_occupied_cell_mass_sum {X D : Type*} [Fintype X] [DecidableEq D]
    (μ : X → ℝ) (cell : X → D) :
    (∑ d ∈ finiteOccupiedCells cell, finiteCellMass μ cell d) = ∑ x, μ x := by
  rw [finite_cell_mass_partition]
  simp only [finite_cell_mem_occupied, ite_true]

theorem finite_discarded_cell_mass_identity {X D : Type*} [Fintype X] [DecidableEq D]
    (μ : X → ℝ) (cell : X → D) (ξ : ℝ) :
    (∑ x, if cell x ∉ finiteRetainedCells μ cell ξ then μ x else 0) =
      ∑ d ∈ (finiteOccupiedCells cell).filter (fun d => finiteCellMass μ cell d < ξ),
        finiteCellMass μ cell d := by
  rw [finite_cell_mass_partition]
  apply Finset.sum_congr rfl
  intro x _
  simp only [Finset.mem_filter, finite_cell_mem_occupied, true_and,
    finite_cell_not_retained_iff]

theorem finite_discarded_cell_mass_le {X D : Type*} [Fintype X] [DecidableEq D]
    (μ : X → ℝ) (cell : X → D) {ξ : ℝ} (hξ : 0 ≤ ξ) :
    (∑ x, if cell x ∉ finiteRetainedCells μ cell ξ then μ x else 0) ≤
      (finiteOccupiedCells cell).card * ξ := by
  rw [finite_discarded_cell_mass_identity]
  calc
    _ ≤ ∑ _d ∈ (finiteOccupiedCells cell).filter (fun d => finiteCellMass μ cell d < ξ), ξ := by
      apply Finset.sum_le_sum
      intro d hd
      exact (Finset.mem_filter.mp hd).2.le
    _ = (((finiteOccupiedCells cell).filter (fun d => finiteCellMass μ cell d < ξ)).card : ℝ) * ξ := by simp
    _ ≤ _ := mul_le_mul_of_nonneg_right (by exact_mod_cast Finset.card_filter_le _ _) hξ

theorem finite_retained_probability_ge {X D : Type*} [Fintype X] [DecidableEq D]
    (μ : X → ℝ) (cell : X → D) {ξ : ℝ} (hξ : 0 ≤ ξ)
    (hmass : ∑ x, μ x = 1) :
    1 - (finiteOccupiedCells cell).card * ξ ≤
      ∑ x, if cell x ∈ finiteRetainedCells μ cell ξ then μ x else 0 := by
  have hsplit : (∑ x, if cell x ∈ finiteRetainedCells μ cell ξ then μ x else 0) +
      (∑ x, if cell x ∉ finiteRetainedCells μ cell ξ then μ x else 0) = 1 := by
    rw [← Finset.sum_add_distrib, ← hmass]
    apply Finset.sum_congr rfl
    intro x _
    by_cases hx : cell x ∈ finiteRetainedCells μ cell ξ <;> simp [hx]
  have hb := finite_discarded_cell_mass_le μ cell hξ
  linarith

theorem finite_cell_mass_pos_iff_occupied {X D : Type*} [Fintype X] [DecidableEq D]
    (μ : X → ℝ) (hμ : ∀ x, 0 < μ x) (cell : X → D) (d : D) :
    0 < finiteCellMass μ cell d ↔ d ∈ finiteOccupiedCells cell := by
  unfold finiteCellMass
  rw [Finset.sum_pos_iff_of_nonneg (by
    intro x _
    split_ifs
    · exact (hμ x).le
    · exact le_rfl)]
  constructor
  · rintro ⟨x, _, hx⟩
    by_cases he : cell x = d
    · exact Finset.mem_image.mpr ⟨x, Finset.mem_univ x, he⟩
    · simp [he] at hx
  · intro hd
    obtain ⟨x, hx, he⟩ := Finset.mem_image.mp hd
    exact ⟨x, hx, by simp [he, hμ x]⟩
end

section
open Finset Filter
open scoped Topology
theorem primeFactors_card_le_multiplicity (n : ℕ) :
    n.primeFactors.card ≤ primeFactorMultiplicity n := by
  calc
    _ = ∑ _p ∈ n.primeFactors, (1 : ℕ) := by simp
    _ ≤ ∑ p ∈ n.primeFactors, n.factorization p := by
      apply sum_le_sum
      intro p hp
      apply Nat.one_le_iff_ne_zero.mpr
      exact Finsupp.mem_support_iff.mp (by simpa only [Nat.support_factorization] using hp)

theorem prime_factor_inverse_sum_le_card {n : ℕ} {Y : ℝ} (hY : 1 < Y)
    (hlarge : ∀ p ∈ n.primeFactors, Y ≤ (p : ℝ)) :
    (∑ p ∈ n.primeFactors, 1 / ((p : ℝ) - 1)) ≤
      (n.primeFactors.card : ℝ) / (Y - 1) := by
  calc
    _ ≤ ∑ _p ∈ n.primeFactors, 1 / (Y - 1) := by
      apply sum_le_sum
      intro p hp
      exact one_div_le_one_div_of_le (by linarith) (by linarith [hlarge p hp])
    _ = _ := by simp [div_eq_mul_inv]

theorem prime_factor_inverse_sum_le_log {n : ℕ} (hn : n ≠ 0)
    {Y : ℝ} (hY : 1 < Y) (hlarge : ∀ p ∈ n.primeFactors, Y ≤ (p : ℝ)) :
    (∑ p ∈ n.primeFactors, 1 / ((p : ℝ) - 1)) ≤
      Real.log (n : ℝ) / (Real.log Y * (Y - 1)) := by
  have hcard : (n.primeFactors.card : ℝ) ≤ (primeFactorMultiplicity n : ℝ) :=
    Nat.cast_le.mpr (primeFactors_card_le_multiplicity n)
  calc
    _ ≤ (n.primeFactors.card : ℝ) / (Y - 1) :=
      prime_factor_inverse_sum_le_card hY hlarge
    _ ≤ (primeFactorMultiplicity n : ℝ) / (Y - 1) :=
      div_le_div_of_nonneg_right hcard (by linarith)
    _ ≤ (Real.log (n : ℝ) / Real.log Y) / (Y - 1) :=
      div_le_div_of_nonneg_right
        (multiplicity_le_log_div_of_large_primeFactors hn hY hlarge) (by linarith)
    _ = _ := by rw [div_div]

theorem prime_factor_inverse_sum_le_four_rpow {L : ℝ}
    (hL : 2 ≤ L) (hlog16 : Real.log 16 ≤ L) (hlogL : 1 ≤ Real.log L)
    {n : ℕ} (hn : n ≠ 0) (hsize : (n : ℝ) ≤ 16 * Real.exp L)
    (hlarge : ∀ p ∈ n.primeFactors, L^20 ≤ (p : ℝ)) :
    (∑ p ∈ n.primeFactors, 1 / ((p : ℝ) - 1)) ≤ 4 * L^(-19 : ℝ) := by
  have hL0 : 0 < L := by linarith
  have hpow : (2 : ℝ) ≤ L^20 := by
    have hh := pow_le_pow_left₀ (by norm_num : (0 : ℝ) ≤ 2) hL 20
    norm_num at hh
    linarith
  have hY : 1 < L^20 := by linarith
  have hlogY : 1 ≤ Real.log (L^20) := by
    rw [Real.log_pow]
    norm_num
    linarith
  have hden : L^20 / 2 ≤ Real.log (L^20) * (L^20 - 1) := by
    have hmul := mul_le_mul_of_nonneg_right hlogY (by linarith : 0 ≤ L^20 - 1)
    nlinarith
  have hn0 : (0 : ℝ) < n := by exact_mod_cast Nat.pos_of_ne_zero hn
  have hnum : Real.log (n : ℝ) ≤ 2 * L := by
    have hh := Real.log_le_log hn0 hsize
    rw [Real.log_mul (by norm_num) (Real.exp_ne_zero L), Real.log_exp] at hh
    linarith
  calc
    _ ≤ Real.log (n : ℝ) / (Real.log (L^20) * (L^20 - 1)) :=
      prime_factor_inverse_sum_le_log hn hY hlarge
    _ ≤ (2 * L) / (L^20 / 2) :=
      div_le_div₀ (by positivity) hnum (by positivity) hden
    _ = 4 * L^(-19 : ℝ) := by
      rw [Real.rpow_neg hL0.le]
      norm_num
      field_simp
      ring

theorem eventually_prime_factor_inverse_sum_le_four_rpow :
    ∀ᶠ L : ℝ in atTop, ∀ n : ℕ, n ≠ 0 → (n : ℝ) ≤ 16 * Real.exp L →
      (∀ p ∈ n.primeFactors, L^20 ≤ (p : ℝ)) →
      (∑ p ∈ n.primeFactors, 1 / ((p : ℝ) - 1)) ≤ 4 * L^(-19 : ℝ) := by
  filter_upwards [eventually_ge_atTop (2 : ℝ), eventually_ge_atTop (Real.log 16),
    Real.tendsto_log_atTop.eventually (eventually_ge_atTop (1 : ℝ))]
    with L hL hlog16 hlogL
  exact fun n hn hsize hlarge =>
    prime_factor_inverse_sum_le_four_rpow hL hlog16 hlogL hn hsize hlarge
end

section
open Finset
theorem totient_sieve_prime_product (P : Finset ℕ) (hP : ∀ p ∈ P, p.Prime) :
    Nat.totient (∏ p ∈ P, p) = ∏ p ∈ P, (p - 1) := by
  have hp0 : (∏ p ∈ P, p) ≠ 0 :=
    prod_ne_zero_iff.mpr (fun p hp => (hP p hp).ne_zero)
  rw [Nat.totient_eq_div_primeFactors_mul, Nat.primeFactors_prod hP,
    Nat.div_self (Nat.pos_of_ne_zero hp0), one_mul]

theorem totient_sieve_prime_product_reciprocal (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) :
    1 / (Nat.totient (∏ p ∈ P, p) : ℝ) = ∏ p ∈ P, (1 / ((p : ℝ) - 1)) := by
  rw [totient_sieve_prime_product P hP, Nat.cast_prod]
  simp only [one_div, prod_inv_distrib]
  congr 1
  apply prod_congr rfl
  intro p hp
  rw [Nat.cast_sub (hP p hp).one_le, Nat.cast_one]

theorem totient_sieve_prime_product_divisors (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) :
    (∏ p ∈ P, p).divisors = P.powerset.image (fun S => ∏ p ∈ S, p) := by
  have hp0 : (∏ p ∈ P, p) ≠ 0 :=
    prod_ne_zero_iff.mpr (fun p hp => (hP p hp).ne_zero)
  have hsq : Squarefree (∏ p ∈ P, p) := by
    refine squarefree_prod_of_pairwise_isCoprime (fun p hp q hq hpq => ?_)
      (fun p hp => (hP p hp).squarefree)
    simp only [← Nat.coprime_iff_isRelPrime]
    exact (Nat.coprime_primes (hP p hp) (hP q hq)).mpr hpq
  ext d
  constructor
  · intro hd
    have hdvd := Nat.dvd_of_mem_divisors hd
    refine mem_image.mpr ⟨d.primeFactors, mem_powerset.mpr ?_,
      Nat.prod_primeFactors_of_squarefree (hsq.squarefree_of_dvd hdvd)⟩
    simpa only [Nat.primeFactors_prod hP] using Nat.primeFactors_mono hdvd hp0
  · intro hd
    obtain ⟨S, hS, rfl⟩ := mem_image.mp hd
    exact Nat.mem_divisors.mpr
      ⟨prod_dvd_prod_of_subset S P (fun p => p) (mem_powerset.mp hS), hp0⟩

theorem totient_sieve_sum_divisors_eq_subsets (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) (F : ℕ → ℝ) :
    (∑ d ∈ (∏ p ∈ P, p).divisors, F d) =
      ∑ S ∈ P.powerset, F (∏ p ∈ S, p) := by
  rw [totient_sieve_prime_product_divisors P hP]
  apply sum_image
  intro S hS T hT heq
  have hs : (∏ p ∈ S, p).primeFactors = S := Nat.primeFactors_prod
    (fun p hp => hP p ((mem_powerset.mp hS) hp))
  have ht : (∏ p ∈ T, p).primeFactors = T := Nat.primeFactors_prod
    (fun p hp => hP p ((mem_powerset.mp hT) hp))
  rw [← hs, ← ht]
  exact congrArg Nat.primeFactors heq

theorem totient_sieve_divisor_mass (P : Finset ℕ) (hP : ∀ p ∈ P, p.Prime) :
    (∑ d ∈ (∏ p ∈ P, p).divisors, 1 / (Nat.totient d : ℝ)) =
      ∏ p ∈ P, (1 + 1 / ((p : ℝ) - 1)) := by
  rw [totient_sieve_sum_divisors_eq_subsets P hP]
  calc
    _ = ∑ S ∈ P.powerset, ∏ p ∈ S, 1 / ((p : ℝ) - 1) := by
      apply sum_congr rfl
      intro S hS
      exact totient_sieve_prime_product_reciprocal S
        (fun p hp => hP p ((mem_powerset.mp hS) hp))
    _ = _ := (prod_one_add P).symm
end

section
open Finset
theorem totient_sieve_marked_subset_sum (P : Finset ℕ) (w : ℕ → ℝ)
    {p : ℕ} (hp : p ∈ P) :
    (∑ S ∈ P.powerset, if p ∈ S then ∏ q ∈ S, w q else 0) =
      w p * ∏ q ∈ P.erase p, (1 + w q) := by
  classical
  have hn : ∀ S ∈ (P.erase p).powerset, p ∉ S := by
    intro S hS
    exact notMem_mono (mem_powerset.mp hS) (notMem_erase p P)
  calc
    _ = (∑ S ∈ (P.erase p).powerset, if p ∈ S then ∏ q ∈ S, w q else 0) +
        ∑ S ∈ (P.erase p).powerset,
          if p ∈ insert p S then ∏ q ∈ insert p S, w q else 0 := by
      conv_lhs => rw [← insert_erase hp]
      exact sum_powerset_insert (notMem_erase p P) _
    _ = 0 + ∑ S ∈ (P.erase p).powerset, w p * ∏ q ∈ S, w q := by
      congr 1
      · exact sum_eq_zero (fun S hS => if_neg (hn S hS))
      · apply sum_congr rfl
        intro S hS
        rw [if_pos (mem_insert_self _ _), prod_insert (hn S hS)]
    _ = _ := by rw [zero_add, ← mul_sum, ← prod_one_add]

theorem totient_sieve_subset_union_bound (P : Finset ℕ) (w : ℕ → ℝ)
    (hw : ∀ p ∈ P, 0 ≤ w p) (bad : ℕ → Prop) [DecidablePred bad] :
    (∑ S ∈ P.powerset.filter (fun S => ∃ p ∈ S, bad p), ∏ p ∈ S, w p) ≤
      (∑ p ∈ P.filter bad, w p) * ∏ p ∈ P, (1 + w p) := by
  classical
  have hprod : ∀ S ∈ P.powerset, 0 ≤ ∏ p ∈ S, w p := by
    intro S hS
    exact prod_nonneg (fun p hp => hw p ((mem_powerset.mp hS) hp))
  calc
    _ = ∑ S ∈ P.powerset, if ∃ p ∈ S, bad p then ∏ p ∈ S, w p else 0 :=
      sum_filter _ _
    _ ≤ ∑ S ∈ P.powerset, ∑ p ∈ P.filter bad,
        if p ∈ S then ∏ q ∈ S, w q else 0 := by
      apply sum_le_sum
      intro S hS
      by_cases hb : ∃ p ∈ S, bad p
      · rw [if_pos hb]
        obtain ⟨p, hpS, hpb⟩ := hb
        have hpP : p ∈ P.filter bad := mem_filter.mpr ⟨(mem_powerset.mp hS) hpS, hpb⟩
        have hsingle := single_le_sum
          (f := fun p => if p ∈ S then ∏ q ∈ S, w q else 0)
          (fun q _ => by split_ifs <;> first | exact hprod S hS | positivity) hpP
        simpa only [if_pos hpS] using hsingle
      · rw [if_neg hb]
        apply sum_nonneg
        intro p _
        split_ifs <;> first | exact hprod S hS | positivity
    _ = ∑ p ∈ P.filter bad,
        ∑ S ∈ P.powerset, if p ∈ S then ∏ q ∈ S, w q else 0 := sum_comm
    _ = ∑ p ∈ P.filter bad, w p * ∏ q ∈ P.erase p, (1 + w q) := by
      apply sum_congr rfl
      intro p hp
      exact totient_sieve_marked_subset_sum P w (mem_filter.mp hp).1
    _ ≤ ∑ p ∈ P.filter bad, w p * ∏ q ∈ P, (1 + w q) := by
      apply sum_le_sum
      intro p hp
      apply mul_le_mul_of_nonneg_left _ (hw p (mem_filter.mp hp).1)
      apply prod_le_prod_of_subset_of_one_le₀ (erase_subset p P)
      · intro q hq
        linarith [hw q (mem_of_mem_erase hq)]
      · intro q hq _
        linarith [hw q hq]
    _ = _ := (sum_mul _ _ _).symm
end

section
open Finset
theorem totient_sieve_principal_error_eq_bad_mass {Ω : Type*} (T : Finset Ω)
    (μ : Ω → ℝ) (value : Ω → ℕ) (hμ : ∀ u ∈ T, 0 ≤ μ u) (d : ℕ) :
    |(∑ u ∈ T.filter (fun u => Nat.Coprime d (value u)), μ u) / (Nat.totient d : ℝ) -
        (∑ u ∈ T, μ u) / (Nat.totient d : ℝ)| =
      (∑ u ∈ T.filter (fun u => ¬ Nat.Coprime d (value u)), μ u) /
        (Nat.totient d : ℝ) := by
  have hsplit := sum_filter_add_sum_filter_not T
    (fun u => Nat.Coprime d (value u)) μ
  have hbad : 0 ≤ ∑ u ∈ T.filter (fun u => ¬ Nat.Coprime d (value u)), μ u :=
    sum_nonneg (fun u hu => hμ u (mem_filter.mp hu).1)
  rw [← hsplit, add_div]
  have hdiv : 0 ≤ (∑ u ∈ T.filter (fun u => ¬ Nat.Coprime d (value u)), μ u) /
      (Nat.totient d : ℝ) := div_nonneg hbad (Nat.cast_nonneg _)
  rw [show (∑ u ∈ T.filter (fun u => Nat.Coprime d (value u)), μ u) /
      (Nat.totient d : ℝ) -
        ((∑ u ∈ T.filter (fun u => Nat.Coprime d (value u)), μ u) /
          (Nat.totient d : ℝ) +
          (∑ u ∈ T.filter (fun u => ¬ Nat.Coprime d (value u)), μ u) /
            (Nat.totient d : ℝ)) =
      -((∑ u ∈ T.filter (fun u => ¬ Nat.Coprime d (value u)), μ u) /
        (Nat.totient d : ℝ)) by ring, abs_neg, abs_of_nonneg hdiv]

theorem totient_sieve_principal_replacement_identity {Ω : Type*}
    (T : Finset Ω) (M : Finset ℕ) (μ : Ω → ℝ) (value : Ω → ℕ)
    (hμ : ∀ u ∈ T, 0 ≤ μ u) :
    (∑ d ∈ M,
      |(∑ u ∈ T.filter (fun u => Nat.Coprime d (value u)), μ u) /
          (Nat.totient d : ℝ) - (∑ u ∈ T, μ u) / (Nat.totient d : ℝ)|) =
      ∑ u ∈ T, μ u *
        ∑ d ∈ M.filter (fun d => ¬ Nat.Coprime d (value u)), 1 / (Nat.totient d : ℝ) := by
  calc
    _ = ∑ d ∈ M,
        (∑ u ∈ T.filter (fun u => ¬ Nat.Coprime d (value u)), μ u) /
          (Nat.totient d : ℝ) := by
      apply sum_congr rfl
      intro d _
      exact totient_sieve_principal_error_eq_bad_mass T μ value hμ d
    _ = ∑ d ∈ M, ∑ u ∈ T,
        μ u * (if ¬ Nat.Coprime d (value u) then 1 / (Nat.totient d : ℝ) else 0) := by
      apply sum_congr rfl
      intro d _
      rw [sum_div, sum_filter]
      apply sum_congr rfl
      intro u _
      split_ifs <;> simp [div_eq_mul_inv]
    _ = ∑ u ∈ T, ∑ d ∈ M,
        μ u * (if ¬ Nat.Coprime d (value u) then 1 / (Nat.totient d : ℝ) else 0) :=
      sum_comm
    _ = _ := by
      apply sum_congr rfl
      intro u _
      rw [← mul_sum, sum_filter]

theorem totient_sieve_principal_replacement_bound {Ω : Type*}
    (T : Finset Ω) (M : Finset ℕ) (μ : Ω → ℝ) (value : Ω → ℕ)
    (hμ : ∀ u ∈ T, 0 ≤ μ u) (X B : ℝ) (hX : (∑ u ∈ T, μ u) = X)
    (hpoint : ∀ u ∈ T, μ u ≠ 0 →
      (∑ d ∈ M.filter (fun d => ¬ Nat.Coprime d (value u)), 1 / (Nat.totient d : ℝ)) ≤ B) :
    (∑ d ∈ M,
      |(∑ u ∈ T.filter (fun u => Nat.Coprime d (value u)), μ u) /
          (Nat.totient d : ℝ) - X / (Nat.totient d : ℝ)|) ≤ X * B := by
  rw [← hX, totient_sieve_principal_replacement_identity T M μ value hμ, sum_mul]
  apply sum_le_sum
  intro u hu
  by_cases hz : μ u = 0
  · simp only [hz, zero_mul, le_refl]
  · exact mul_le_mul_of_nonneg_left (hpoint u hu hz) (hμ u hu)
end

section
open scoped BigOperators Classical
noncomputable def finitePairEventMass {X Y : Type*} [Fintype X] [Fintype Y]
    (μ : X → ℝ) (ν : Y → ℝ) (E : X → Y → Prop) : ℝ :=
  ∑ x, ∑ y, if E x y then μ x * ν y else 0

theorem finite_pair_event_mass_nonneg {X Y : Type*} [Fintype X] [Fintype Y]
    (μ : X → ℝ) (ν : Y → ℝ) (hμ : ∀ x, 0 ≤ μ x) (hν : ∀ y, 0 ≤ ν y)
    (E : X → Y → Prop) : 0 ≤ finitePairEventMass μ ν E := by
  apply Finset.sum_nonneg
  intro x _
  apply Finset.sum_nonneg
  intro y _
  split_ifs
  · exact mul_nonneg (hμ x) (hν y)
  · exact le_rfl

theorem finite_pair_event_pairing_sq_le {X Y : Type*} [Fintype X] [Fintype Y]
    (μ : X → ℝ) (ν : Y → ℝ) (hμ : ∀ x, 0 ≤ μ x) (hν : ∀ y, 0 ≤ ν y)
    (E : X → Y → Prop) (K : X → Y → ℂ) (hK : ∀ x y, ‖K x y‖ ≤ 1)
    (f : X → ℂ) (g : Y → ℂ) :
    ‖∑ x, ∑ y, if E x y then
      ((μ x * ν y : ℝ) : ℂ) * (K x y * f x * g y) else 0‖ ^ 2 ≤
      finitePairEventMass μ ν E *
        ((∑ x, μ x * ‖f x‖ ^ 2) * ∑ y, ν y * ‖g y‖ ^ 2) := by
  let w (z : X × Y) : ℝ := if E z.1 z.2 then μ z.1 * ν z.2 else 0
  let F (z : X × Y) : ℂ := K z.1 z.2 * f z.1 * g z.2
  have hw (z : X × Y) : 0 ≤ w z := by
    dsimp only [w]
    split_ifs
    · exact mul_nonneg (hμ z.1) (hν z.2)
    · exact le_rfl
  have hmass : (∑ z, w z) = finitePairEventMass μ ν E := by
    rw [Fintype.sum_prod_type]
    rfl
  have hleft : (∑ z, (w z : ℂ) * F z) = ∑ x, ∑ y, if E x y then
      ((μ x * ν y : ℝ) : ℂ) * (K x y * f x * g y) else 0 := by
    rw [Fintype.sum_prod_type]
    apply Finset.sum_congr rfl
    intro x _
    apply Finset.sum_congr rfl
    intro y _
    by_cases he : E x y <;> simp [w, F, he]
  have hnorm (x : X) (y : Y) :
      ‖K x y * f x * g y‖ ^ 2 ≤ ‖f x‖ ^ 2 * ‖g y‖ ^ 2 := by
    have hk : ‖K x y‖ ^ 2 ≤ 1 := by nlinarith [hK x y, norm_nonneg (K x y)]
    calc
      _ = ‖K x y‖ ^ 2 * (‖f x‖ ^ 2 * ‖g y‖ ^ 2) := by rw [norm_mul, norm_mul]; ring
      _ ≤ 1 * (‖f x‖ ^ 2 * ‖g y‖ ^ 2) :=
        mul_le_mul_of_nonneg_right hk (mul_nonneg (sq_nonneg _) (sq_nonneg _))
      _ = _ := one_mul _
  have henergy : (∑ z, w z * ‖F z‖ ^ 2) ≤
      (∑ x, μ x * ‖f x‖ ^ 2) * ∑ y, ν y * ‖g y‖ ^ 2 := by
    calc
      _ ≤ ∑ z : X × Y, μ z.1 * ν z.2 * (‖f z.1‖ ^ 2 * ‖g z.2‖ ^ 2) := by
        apply Finset.sum_le_sum
        intro z _
        dsimp only [w, F]
        split_ifs
        · exact mul_le_mul_of_nonneg_left (hnorm z.1 z.2) (mul_nonneg (hμ z.1) (hν z.2))
        · simp only [zero_mul]
          exact mul_nonneg (mul_nonneg (hμ z.1) (hν z.2)) (mul_nonneg (sq_nonneg _) (sq_nonneg _))
      _ = _ := by
        rw [Fintype.sum_prod_type, Finset.sum_mul_sum]
        apply Finset.sum_congr rfl
        intro x _
        apply Finset.sum_congr rfl
        intro y _
        ring
  have hc := finite_weighted_sum_cauchy Finset.univ w (fun z _ => hw z) F
  rw [hleft, hmass] at hc
  exact hc.trans (mul_le_mul_of_nonneg_left henergy (finite_pair_event_mass_nonneg μ ν hμ hν E))

theorem finite_pair_event_pairing_le {X Y : Type*} [Fintype X] [Fintype Y]
    (μ : X → ℝ) (ν : Y → ℝ) (hμ : ∀ x, 0 ≤ μ x) (hν : ∀ y, 0 ≤ ν y)
    (E : X → Y → Prop) (K : X → Y → ℂ) (hK : ∀ x y, ‖K x y‖ ≤ 1)
    (f : X → ℂ) (g : Y → ℂ) :
    ‖∑ x, ∑ y, if E x y then
      ((μ x * ν y : ℝ) : ℂ) * (K x y * f x * g y) else 0‖ ≤
      Real.sqrt (finitePairEventMass μ ν E) *
        Real.sqrt ((∑ x, μ x * ‖f x‖ ^ 2) * ∑ y, ν y * ‖g y‖ ^ 2) := by
  have hc := finite_pair_event_pairing_sq_le μ ν hμ hν E K hK f g
  have hm := finite_pair_event_mass_nonneg μ ν hμ hν E
  have hE : 0 ≤ (∑ x, μ x * ‖f x‖ ^ 2) * ∑ y, ν y * ‖g y‖ ^ 2 := by
    exact mul_nonneg (Finset.sum_nonneg (fun x _ => mul_nonneg (hμ x) (sq_nonneg _)))
      (Finset.sum_nonneg (fun y _ => mul_nonneg (hν y) (sq_nonneg _)))
  have hs := Real.sqrt_le_sqrt hc
  rw [Real.sqrt_sq (norm_nonneg _), Real.sqrt_mul hm] at hs
  exact hs
end

section
open Finset
theorem sum_subsets_complement {I M : Type*} [Fintype I] [DecidableEq I]
    [AddCommMonoid M] (Z : Finset I) (F : Finset I → M) :
    (∑ T ∈ Z.powerset, F T) =
      ∑ S : Finset I, if univ \ S ⊆ Z then F (univ \ S) else 0 := by
  classical
  have he : (∑ T ∈ Z.powerset, F T) = ∑ T : Finset I, if T ⊆ Z then F T else 0 := by
    rw [← sum_filter]
    congr 1
    ext T
    simp only [mem_powerset, mem_filter, mem_univ, true_and]
  rw [he]
  let e : Finset I ≃ Finset I :=
    ⟨fun T => Tᶜ, fun T => Tᶜ, compl_compl, compl_compl⟩
  exact (e.sum_comp (fun T => if T ⊆ Z then F T else 0)).symm

theorem physical_ghost_old_event_sum {P : Type*} (n : P → ℕ)
    {N : ℕ} (old : Fin N → UnrestrictedResidueParticle n)
    (η ρ : ℝ) (F : Finset (Fin N) → ℂ) :
    (∑ T ∈ (globalBirthVisitZeroIndices (fun _ => 0) old).powerset,
      (((-η / ρ) ^ T.card * ((1 - η) / ρ ^ 2) ^
        (globalBirthVisitZeroIndices (fun _ => 0) old \ T).card : ℝ) : ℂ) * F (univ \ T)) =
    ∑ S : Finset (Fin N),
      (((∏ j ∈ S, physicalGhostRetention n (1 - η) ρ (old j)) *
        ∏ j ∈ univ \ S, physicalGhostTermination n (1 - η) ρ (old j) : ℝ) : ℂ) * F S := by
  classical
  rw [sum_subsets_complement]
  apply sum_congr rfl
  intro S _
  have hc : univ \ (univ \ S) = S := by
    ext j
    simp only [mem_sdiff, mem_univ, true_and, not_not]
  by_cases hS : univ \ S ⊆ globalBirthVisitZeroIndices (fun _ => 0) old
  · rw [if_pos hS, hc]
    have hw := physical_ghost_old_event_coefficient n old η ρ (univ \ S) hS
    rw [hc] at hw
    rw [← hw]
  · rw [if_neg hS, physical_ghost_terminated_coefficient_zero n old η ρ (univ \ S) hS,
      mul_zero, Complex.ofReal_zero, zero_mul]
end

section
open Finset Classical
section

variable {G : Type*} {P : G → Type*}
  (n : ∀ g, P g → ℕ) {M : G → ℕ}
  (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : SharedActiveLabels P S → Type*) (Δ D : ∀ c, A c → G → ℤ)
  (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
  (e : FullActiveEdgeEvent n S B A Δ D x)

theorem fullActiveEdgeEventTarget_shared :
    (productActiveMemorySplit S B (fullActiveEdgeEventTarget n S B A Δ D x e)).1 =
      (productActiveMemorySplit S B x).1 := by
  simp only [fullActiveEdgeEventTarget, Equiv.apply_symm_apply]

theorem fullActiveEdgeEventTarget_total [Fintype G] :
    productTotalMemory (fullActiveEdgeEventTarget n S B A Δ D x e) =
      productTotalMemory (unrestrictedJointEventTarget n
        (Δ (productActiveMemorySplit S B x).1 e.1) (D (productActiveMemorySplit S B x).1 e.1)
        (fun g => (S g)ᶜ.card) B (productActiveMemorySplit S B x).2 e.2) := by
  exact productActiveMemorySplit_total_memory_symm S B _ _

theorem fullActiveEdgeEventWeight_full_caps [Fintype G]
    (ω : ∀ c, A c → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ) :
    fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V x e =
      if productTotalMemory x ≤ B ∧ productTotalMemory (fullActiveEdgeEventTarget n S B A Δ D x e) ≤ B
      then ω (productActiveMemorySplit S B x).1 e.1 *
        ∏ g, unrestrictedBoundedEventWeight (n g)
          (Δ (productActiveMemorySplit S B x).1 e.1 g) (D (productActiveMemorySplit S B x).1 e.1 g)
          (μ g) ρ (V g) (S g)ᶜ.card B ((productActiveMemorySplit S B x).2 g) (e.2 g)
      else 0 := by
  rw [fullActiveEdgeEventTarget_total]
  unfold fullActiveEdgeEventWeight unrestrictedJointCutoffEventWeight
  rw [productActiveMemorySplit_total_memory]
  split_ifs <;> simp only [mul_zero]

end
end

section
open Finset Classical
universe uJ uK uG uP uA

section

variable {J : Type uJ} {K : Type uK} {G : Type uG} {P : G → Type uP}
  (n : ∀ g, P g → ℕ) {M : G → ℕ}
  (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type uA)
  (Δ D : ∀ k c, A k c → G → ℤ)

def FullMixedMemoryEvent : (J ⊕ K) →
    ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → Type _
  | .inl _, s => ULift.{uA} (CoupledGhostEvent M B s)
  | .inr k, s => FullActiveEdgeEvent n (S k) B (A k) (Δ k) (D k) s

noncomputable abbrev fullMixedMemoryEventFintype [Fintype G] [∀ g, Fintype (P g)]
    [∀ g p, NeZero (n g p)] [∀ k c, Fintype (A k c)] (k : J ⊕ K)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    Fintype (FullMixedMemoryEvent n S B A Δ D k s) := by
  cases k <;> dsimp [FullMixedMemoryEvent] <;> infer_instance

noncomputable def fullMixedMemoryEventTarget (k : J ⊕ K)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    FullMixedMemoryEvent n S B A Δ D k s →
      ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B :=
  match k with
  | .inl _ => fun e => coupledGhostJointEventTarget M B s e.down
  | .inr k => fullActiveEdgeEventTarget n (S k) B (A k) (Δ k) (D k) s

noncomputable def fullMixedMemoryEventWeight [Fintype G]
    (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)
    (k : J ⊕ K)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    FullMixedMemoryEvent n S B A Δ D k s → ℝ :=
  match k with
  | .inl j => fun e => coupledGhostJointEventWeight
      (fun g => physicalGhostRetention (n g) (q j) ρ)
      (fun g => physicalGhostTermination (n g) (q j) ρ)
      (fun g => physicalGhostBirth (n g) (q j) ρ (V g))
      (fun g => unrestrictedResidueWeight (μ g)) M B s e.down
  | .inr k => fullActiveEdgeEventWeight n (S k) B (A k) (Δ k) (D k) (ω k) μ ρ V s

noncomputable def fullMixedMemoryPositiveOperator [Fintype G] [DecidableEq G]
    [∀ g, Fintype (P g)] [∀ g p, NeZero (n g p)] [∀ k c, Fintype (A k c)]
    (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)
    (k : J ⊕ K) :=
  match k with
  | .inl j => physicalAbsoluteGhostCutoffProductOperator n μ (q j) ρ V M B univ
  | .inr k => fullActiveUnrestrictedEdge n (S k) B (ω k) (Δ k) (D k) μ ρ V (fun _ _ _ _ => 1)

theorem full_mixed_memory_absolute_actions_eq [Fintype G] [DecidableEq G]
    [∀ g, Fintype (P g)] [∀ g p, NeZero (n g p)] [∀ k c, Fintype (A k c)]
    (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)
    (hω : ∀ k c a, 0 ≤ ω k c a)
    (hμ : ∀ g p, 0 ≤ μ g p) (hq : ∀ j, 0 ≤ q j) (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ V g) :
    let _ : ∀ (k : J ⊕ K) s, Fintype (FullMixedMemoryEvent n S B A Δ D k s) :=
      fullMixedMemoryEventFintype n S B A Δ D
    finiteLocalEventAction (FullMixedMemoryEvent n S B A Δ D)
      (fun k s e => |fullMixedMemoryEventWeight n S B A Δ D ω μ q ρ V k s e|)
      (fullMixedMemoryEventTarget n S B A Δ D) =
        fullMixedMemoryPositiveOperator n S B A Δ D ω μ q ρ V := by
  let _ : ∀ (k : J ⊕ K) s, Fintype (FullMixedMemoryEvent n S B A Δ D k s) :=
    fullMixedMemoryEventFintype n S B A Δ D
  funext k f s
  cases k with
  | inl j =>
    dsimp only [finiteLocalEventAction, fullMixedMemoryEventWeight, fullMixedMemoryEventTarget,
      fullMixedMemoryPositiveOperator]
    refine Eq.trans ?_ (physical_absolute_joint_ghost_action_eq n μ (q j) ρ V M B (hq j) hμ f s)
    refine Eq.trans ?_ (Equiv.sum_comp
      (Equiv.ulift : ULift.{uA} (CoupledGhostEvent M B s) ≃ CoupledGhostEvent M B s)
      (fun e : CoupledGhostEvent M B s =>
        ((|coupledGhostJointEventWeight
          (fun g => physicalGhostRetention (n g) (q j) ρ)
          (fun g => physicalGhostTermination (n g) (q j) ρ)
          (fun g => physicalGhostBirth (n g) (q j) ρ (V g))
          (fun g => unrestrictedResidueWeight (μ g)) M B s e| : ℝ) : ℂ) *
            f (coupledGhostJointEventTarget M B s e)))
    apply sum_congr
    · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
    · intro e _
      rfl
  | inr k =>
    dsimp only [finiteLocalEventAction, fullMixedMemoryEventWeight, fullMixedMemoryEventTarget,
      fullMixedMemoryPositiveOperator]
    have h := full_active_edge_eq_event_sum n (S k) B (A k) (Δ k) (D k) (ω k) μ ρ V
      (fun _ _ _ _ => 1) f s
    simp only [mul_one] at h
    refine Eq.trans ?_ h.symm
    apply sum_congr
    · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
    · intro e _
      rw [abs_of_nonneg (fullActiveEdgeEventWeight_nonneg n (S k) B (A k) (Δ k) (D k)
        (ω k) μ ρ V (hω k) hμ hρ hV s e)]

end
end

