/- Absorb both retained-cell and character expansions into a prescribed saving. -/

open Finset
open scoped Classical
namespace Bounty

theorem prime_retained_pair_cell_decay
    {I J : Type*} [Fintype I] [DecidableEq I] [Fintype J] [DecidableEq J]
    (PA : I → Finset ℕ) (VA : I → ℝ) (PB : J → Finset ℕ) (VB : J → ℝ)
    {Q : ℕ} {L B C R D Y : ℝ} (hL : 3 ≤ L) (hB : 0 ≤ B)
    (hQ : (Q : ℝ) ≤ L^R) (hY : 0 ≤ Y)
    (hPA : ∀ x : (∀ i, PA i),
      0 ≤ Real.log (∏ i, (x i).val : ℕ) ∧ Real.log (∏ i, (x i).val : ℕ) ≤ L)
    (hPB : ∀ x : (∀ i, PB i),
      0 ≤ Real.log (∏ i, (x i).val : ℕ) ∧ Real.log (∏ i, (x i).val : ℕ) ≤ L)
    (F : ℤ → BoundedPrimitiveCharacter Q → ℤ → BoundedPrimitiveCharacter Q → ℂ)
    (hF : ∀ d ∈ primeProductRetainedCells PA VA (L^(-B)) (L^(-C)), ∀ χ,
      ∀ e ∈ primeProductRetainedCells PB VB (L^(-B)) (L^(-C)), ∀ ψ,
        ‖F d χ e ψ‖ ≤ Y * L^(-(D+2*(B+C+2*R+2)))) :
    let a := fun d => ((1 / finiteCellMass (finiteProductWeight
      (physicalLabelLaw (P := PA) VA))
      (fun x => upperLogCell (L^(-B)) (Real.log (∏ i, (x i).val : ℕ))) d : ℝ) : ℂ)
    let b := fun e => ((1 / finiteCellMass (finiteProductWeight
      (physicalLabelLaw (P := PB) VB))
      (fun x => upperLogCell (L^(-B)) (Real.log (∏ i, (x i).val : ℕ))) e : ℝ) : ℂ)
    ‖∑ d ∈ primeProductRetainedCells PA VA (L^(-B)) (L^(-C)),
      ∑ χ : BoundedPrimitiveCharacter Q,
        ∑ e ∈ primeProductRetainedCells PB VB (L^(-B)) (L^(-C)),
          ∑ ψ : BoundedPrimitiveCharacter Q, a d * b e * F d χ e ψ‖ ≤ Y * L^(-D) := by
  dsimp only
  have hL0 : 0 < L := by linarith
  have ha := prime_retained_cell_polynomial_cost (C := C) PA VA hL hB hQ hPA
  have hb := prime_retained_cell_polynomial_cost (C := C) PB VB hL hB hQ hPB
  refine (finite_two_cell_expansion_norm _ _ _ _ F
    (Real.rpow_pos_of_pos hL0 _).le
    (mul_nonneg hY (Real.rpow_pos_of_pos hL0 _).le) ha hb hF).trans_eq ?_
  calc
    _ = Y * ((L^(B+C+2*R+2) * L^(B+C+2*R+2)) *
      L^(-(D+2*(B+C+2*R+2)))) := by ring
    _ = _ := by
      rw [← Real.rpow_add hL0, ← Real.rpow_add hL0]
      congr 2
      ring

end Bounty
