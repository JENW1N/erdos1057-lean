/- The permutation event in the mixed path is exactly the independent
small and big active-slot average. Its original multiplicity is retained. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_small_big_path_positive_permutation_eq
    {H K S G : Type} [Fintype S] [dS : DecidableEq S] [Fintype G] [dG : DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Type} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] {J ell : ℕ} {M : G → ℕ}
    (shared : K → ∀ g, Finset (Fin (M g))) (B : ℕ) (A : K → Type) [∀ k, Fintype (A k)]
    (Δ D : ∀ k, PhysicalSharedLists Ps J → SharedActiveLabels P (shared k) → A k → G → ℤ)
    (kbig : ∀ k, SharedActiveLabels P (shared k) → A k → ℤ)
    (ω : ∀ k, A k → ℝ) (μ : ∀ g, P g → ℝ)
    (qghost : H → ℝ) (ρ : ℝ) (Vedge Vghost : G → ℝ) (Vs : S → ℝ) (qsmall : ℝ)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ) :
    physicalSmallBigPathPositiveAction n shared B A Δ D kbig ω μ qghost ρ
      Vedge Vghost Vs qsmall none F = physicalSmallBigJointAverage F := by
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  funext s
  rw [physical_small_big_joint_average_eq_sum]
  unfold physicalSmallBigPathPositiveAction finiteLocalEventAction
  apply sum_congr
  · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
  · intro e _
    dsimp only [physicalSmallBigPathPositiveWeight, physicalSmallBigPathEventWeight,
      physicalSmallBigPathEventTarget]
    rw [abs_of_nonneg (mul_nonneg (inv_nonneg.mpr (Nat.cast_nonneg _))
      (fullActivePermutationWeight_nonneg M e.2))]
    congr 3

