section

/- The literal positive mixed storage and reverse rows preserve permutation
symmetry of the big pending memory. The proof uses their pointwise completion
form, not an inference from a restricted bilinear identity. -/

open Finset Classical

namespace Bounty

section

variable {S G : Type*} [Fintype S] [DecidableEq S] [Fintype G] [DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  {J ell : ℕ} {M : G → ℕ} (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
  (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
  (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (kbig : SharedActiveLabels P shared → ℤ) (Vs : S → ℝ) (q : ℝ)
  (aux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))))

theorem physical_small_big_storage_memory_symmetric
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (hF : ∀ s, ProductMemorySymmetric (fun x => F (s, x))) :
    ∀ s, ProductMemorySymmetric (fun x =>
      physicalSmallBigStorageAction n shared B Δ D μ ρ V kbig Vs q aux F (s, x)) := by
  rintro ⟨r, L⟩ x g σ
  unfold physicalSmallBigStorageAction
  dsimp only
  rw [physical_small_big_action_completion, physical_small_big_action_completion,
    physical_small_big_storage_prefix_eq, physical_small_big_storage_prefix_eq]
  apply congrArg
    (fun z : ℂ => ((physicalCompletionMass Vs (fun _ => (∅ : Finset (Fin J))) ell *
      physicalResidueVertexWeight L (Real.sqrt q) r : ℝ) : ℂ) * z)
  exact full_active_storage_external_symmetric n shared B
    (fun c (_ : Unit) => Δ (physicalSharedPrefix L) c)
    (fun c (_ : Unit) => D (physicalSharedPrefix L) c) (fun _ _ => 1) μ ρ V
    (fun c _ => physicalResidueTranslationEquiv (P := Ps)
      (kbig c * (physicalSharedProduct (physicalSharedPrefix L) : ℕ)))
    (physicalSmallBigCompletion q F (physicalSharedPrefix L))
    (fun r => physical_small_big_completion_memory_symmetric q F hF (physicalSharedPrefix L) r)
    r x g σ

theorem physical_small_big_reverse_memory_symmetric
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (hF : ∀ s, ProductMemorySymmetric (fun x => F (s, x))) :
    ∀ s, ProductMemorySymmetric (fun x =>
      physicalSmallBigReverseAction n shared B Δ D μ ρ V kbig Vs q aux F (s, x)) := by
  rintro ⟨r, L⟩ x g σ
  unfold physicalSmallBigReverseAction
  dsimp only
  rw [physical_small_big_action_completion, physical_small_big_action_completion,
    physical_small_big_reverse_prefix_eq, physical_small_big_reverse_prefix_eq]
  apply congrArg
    (fun z : ℂ => ((physicalCompletionMass Vs (fun _ => (∅ : Finset (Fin J))) ell *
      physicalResidueVertexWeight L (Real.sqrt q) r : ℝ) : ℂ) * z)
  exact full_active_reverse_promotion_external_symmetric n shared B
    (fun c (_ : Unit) => Δ (physicalSharedPrefix L) c)
    (fun c (_ : Unit) => D (physicalSharedPrefix L) c) (fun _ _ => 1) μ ρ V
    (fun c _ => physicalResidueTranslationEquiv (P := Ps)
      (kbig c * (physicalSharedProduct (physicalSharedPrefix L) : ℕ)))
    (physicalSmallBigCompletion q F (physicalSharedPrefix L))
    (fun r => physical_small_big_completion_memory_symmetric q F hF (physicalSharedPrefix L) r)
    r x g σ

end

end Bounty
