theorem eventually_linear_exponential_profile_le_rpow {c d : ℝ}
    (hc : 0 < c) (hd : 0 < d) (C D s : ℝ) :
    ∀ᶠ L : ℝ in atTop,
      C * Real.exp (-c * L) + D * L * Real.exp (-d * L) ≤ L ^ (-s) := by
  have ht1 := (tendsto_rpow_mul_exp_neg_mul_atTop_nhds_zero s c hc).const_mul C
  have ht2 := (tendsto_rpow_mul_exp_neg_mul_atTop_nhds_zero (s + 1) d hd).const_mul D
  have ht := ht1.add ht2
  have he : ∀ᶠ L : ℝ in atTop,
      C * (L ^ s * Real.exp (-c * L)) +
        D * (L ^ (s + 1) * Real.exp (-d * L)) ≤ 1 :=
    ht.eventually_le_const (by simp)
  filter_upwards [he, eventually_gt_atTop (0 : ℝ)] with L hL hL0
  rw [Real.rpow_add hL0, Real.rpow_one] at hL
  rw [Real.rpow_neg hL0.le, ← one_div]
  apply (le_div_iff₀ (Real.rpow_pos_of_pos hL0 s)).mpr
  nlinarith only [hL]

theorem prime_coprime_relative_profile_bound {c L C : ℝ}
    (hc : 0 < c) (hL : 0 < L) (hC : 0 ≤ C)
    {f m : ℕ} (hf : 0 < f) (hfL : (f : ℝ) ≤ Real.exp L)
    (hm : m ≠ 0) (hmL : (m : ℝ) ≤ Real.exp L) :
    2 * C * (Real.exp (c * L)) ^ (-(1 : ℝ) / 32) *
        (1 + Real.log (f : ℝ) / Real.log (Real.exp (c * L))) +
          (m.primeFactors.card : ℝ) / Real.exp (c * L) ≤
      (2 * C * (1 + 1 / c)) * Real.exp (-(c / 32) * L) +
        (1 / Real.log 2) * L * Real.exp (-c * L) := by
  have hf0 : (0 : ℝ) < f := by exact_mod_cast hf
  have hm0 : (0 : ℝ) < m := by exact_mod_cast Nat.pos_of_ne_zero hm
  have hflog : Real.log (f : ℝ) ≤ L := by
    simpa only [Real.log_exp] using Real.log_le_log hf0 hfL
  have hmlog : Real.log (m : ℝ) ≤ L := by
    simpa only [Real.log_exp] using Real.log_le_log hm0 hmL
  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hcard : (m.primeFactors.card : ℝ) ≤ L / Real.log 2 :=
    (primeFactors_card_le_log_div_log_two (Nat.pos_of_ne_zero hm)).trans
      (div_le_div_of_nonneg_right hmlog hlog2.le)
  have hquot : Real.log (f : ℝ) / (c * L) ≤ 1 / c := by
    apply (div_le_iff₀ (mul_pos hc hL)).mpr
    calc
      Real.log (f : ℝ) ≤ L := hflog
      _ = (1 / c) * (c * L) := by field_simp
  rw [Real.log_exp, ← Real.exp_mul]
  have hexp : c * L * (-(1 : ℝ) / 32) = -(c / 32) * L := by ring
  rw [hexp]
  calc
    _ ≤ 2 * C * Real.exp (-(c / 32) * L) * (1 + 1 / c) +
        (L / Real.log 2) / Real.exp (c * L) := by
      apply add_le_add
      · exact mul_le_mul_of_nonneg_left (add_le_add le_rfl hquot) (by positivity)
      · exact div_le_div_of_nonneg_right hcard (Real.exp_nonneg _)
    _ = _ := by simp only [neg_mul, Real.exp_neg]; ring

theorem eventually_prime_band_coprime_relative_power_bound
    (hZ : PrimitiveZeroFreeHalfPlane) {c : ℝ} (hc : 0 < c) (B : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (f : ℕ), 0 < f → (f : ℝ) ≤ Real.exp L →
      ∀ χ : DirichletCharacter ℂ f, χ ≠ 1 →
      ∀ b t U V : ℝ, 0 ≤ b → 0 < t → 0 ≤ U → 0 ≤ V →
      ∀ m : ℕ, m ≠ 0 → (m : ℝ) ≤ Real.exp L →
        ‖∑ p ∈ ((primeBand (Real.exp (c * L)) b).filter
          (fun p : ℕ => U < t * (p : ℝ) ∧ t * (p : ℝ) ≤ V)).filter
            (fun p => p.Coprime m), χ (p : ZMod f)‖ ≤
          (V / t) * L ^ (-B) := by
  obtain ⟨C, hC, hbound⟩ := ordinary_prime_band_product_coprime_relative_bound hZ
  have hlarge : ∀ᶠ L : ℝ in atTop, (2 : ℝ) ≤ Real.exp (c * L) :=
    (Real.tendsto_exp_atTop.comp (tendsto_id.const_mul_atTop hc)).eventually_ge_atTop 2
  filter_upwards [eventually_linear_exponential_profile_le_rpow
    (div_pos hc (by norm_num : (0 : ℝ) < 32)) hc
    (2 * C * (1 + 1 / c)) (1 / Real.log 2) B,
    hlarge, eventually_gt_atTop (0 : ℝ)] with L hdecay hlarge hL
  intro f hf hfL χ hχ b t U V hb ht hU hV m hm hmL
  apply (hbound f hf χ hχ (Real.exp (c * L)) b t U V hlarge hb ht hU hV m hm).trans
  apply mul_le_mul_of_nonneg_left _ (div_nonneg hV ht.le)
  exact (prime_coprime_relative_profile_bound hc hL hC.le hf hfL hm hmL).trans hdecay
end

section
open scoped BigOperators
theorem stdAddChar_mul_eq_fourier {q : ℕ} [NeZero q] (n : ℤ) (k : ZMod q) :
    ZMod.stdAddChar ((n : ZMod q) * k) =
      fourier n (((k.val : ℝ) / q : ℝ) : AddCircle (1 : ℝ)) := by
  have hcast : (n : ZMod q) * k = ((n * (k.val : ℤ) : ℤ) : ZMod q) := by
    simp only [Int.cast_mul, Int.cast_natCast, ZMod.natCast_zmod_val]
  rw [hcast, ZMod.stdAddChar_coe, fourier_coe_apply]
  push_cast
  congr 1
  ring

theorem sum_stdAddChar_mul_eq_finiteFourierSum {q : ℕ} [NeZero q]
    (freq : Finset ℤ) (a : ℤ → ℂ) (k : ZMod q) :
    (∑ n ∈ freq, a n * ZMod.stdAddChar ((n : ZMod q) * k)) =
      finiteFourierSum freq a ((k.val : ℝ) / q) := by
  simp only [stdAddChar_mul_eq_fourier, finiteFourierSum]

def reducedResidues (q : ℕ) : Finset ℕ :=
  (Finset.range q).filter (fun a => a.Coprime q)

theorem reducedResidues_eq_unit_val_image (q : ℕ) [NeZero q] :
    reducedResidues q =
      (Finset.univ.filter (fun k : ZMod q => IsUnit k)).image ZMod.val := by
  classical
  ext a
  simp only [reducedResidues, Finset.mem_filter, Finset.mem_range, Finset.mem_image,
    Finset.mem_univ, true_and]
  constructor
  · rintro ⟨ha, hacop⟩
    exact ⟨(a : ZMod q), (ZMod.isUnit_iff_coprime a q).mpr hacop,
      ZMod.val_natCast_of_lt ha⟩
  · rintro ⟨k, hk, rfl⟩
    refine ⟨ZMod.val_lt k, ?_⟩
    apply (ZMod.isUnit_iff_coprime k.val q).mp
    simpa only [ZMod.natCast_zmod_val] using hk

theorem sum_unit_stdAddChar_energy_eq_reducedResidues {q : ℕ} [NeZero q]
    (freq : Finset ℤ) (a : ℤ → ℂ) :
    (∑ k ∈ Finset.univ.filter (fun k : ZMod q => IsUnit k),
      ‖∑ n ∈ freq, a n * ZMod.stdAddChar ((n : ZMod q) * k)‖ ^ 2) =
      ∑ k ∈ reducedResidues q, ‖finiteFourierSum freq a ((k : ℝ) / q)‖ ^ 2 := by
  classical
  rw [reducedResidues_eq_unit_val_image, Finset.sum_image]
  · apply Finset.sum_congr rfl
    intro k _
    rw [sum_stdAddChar_mul_eq_finiteFourierSum]
  · intro k _ l _ hkl
    exact ZMod.val_injective q hkl

def reducedFractionSamples (Q : Finset ℕ) : Finset (ℕ × ℕ) :=
  (Q.sigma reducedResidues).image (fun v => (v.2, v.1))

theorem mem_reducedFractionSamples {Q : Finset ℕ} {a q : ℕ} :
    (a, q) ∈ reducedFractionSamples Q ↔ q ∈ Q ∧ a ∈ reducedResidues q := by
  simp [reducedFractionSamples, Finset.mem_sigma, Prod.ext_iff]

theorem sum_reducedFractionSamples (Q : Finset ℕ) (F : ℕ × ℕ → ℝ) :
    (∑ v ∈ reducedFractionSamples Q, F v) =
      ∑ q ∈ Q, ∑ a ∈ reducedResidues q, F (a, q) := by
  rw [reducedFractionSamples, Finset.sum_image]
  · rw [Finset.sum_sigma]
  · rintro ⟨q, a⟩ _ ⟨r, b⟩ _ h
    simp only [Prod.mk.injEq] at h
    rcases h with ⟨rfl, rfl⟩
    rfl

theorem additive_large_sieve_moduli (Q : Finset ℕ) {R N : ℝ} (hR : 1 ≤ R)
    (hQ0 : ∀ q ∈ Q, 0 < q) (hQR : ∀ q ∈ Q, (q : ℝ) ≤ R)
    (freq : Finset ℤ) (a : ℤ → ℂ) (hN : 0 ≤ N)
    (hfreq : ∀ n ∈ freq, |(n : ℝ)| ≤ N) :
    (∑ q ∈ Q, ∑ k ∈ reducedResidues q,
      ‖finiteFourierSum freq a ((k : ℝ) / q)‖ ^ 2) ≤
      (6 + 8 * Real.pi) * (N + R ^ 2) * ∑ n ∈ freq, ‖a n‖ ^ 2 := by
  rw [← sum_reducedFractionSamples Q (fun v => ‖finiteFourierSum freq a ((v.1 : ℝ) / v.2)‖ ^ 2)]
  apply additive_large_sieve_reduced_fractions_coarse _ hR _ freq a hN hfreq
  intro v hv
  obtain ⟨hq, hk⟩ := mem_reducedFractionSamples.mp hv
  have hk' : v.1 < v.2 ∧ v.1.Coprime v.2 := by
    simpa only [reducedResidues, Finset.mem_filter, Finset.mem_range] using hk
  exact ⟨hQ0 _ hq, hk'.1, hk'.2, hQR _ hq⟩

theorem additive_large_sieve_moduli_Icc {R N : ℝ} (hR : 1 ≤ R)
    (freq : Finset ℤ) (a : ℤ → ℂ) (hN : 0 ≤ N)
    (hfreq : ∀ n ∈ freq, |(n : ℝ)| ≤ N) :
    (∑ q ∈ Finset.Icc 1 ⌊R⌋₊, ∑ k ∈ reducedResidues q,
      ‖finiteFourierSum freq a ((k : ℝ) / q)‖ ^ 2) ≤
      (6 + 8 * Real.pi) * (N + R ^ 2) * ∑ n ∈ freq, ‖a n‖ ^ 2 := by
  apply additive_large_sieve_moduli _ hR _ _ freq a hN hfreq
  · intro q hq
    exact (Finset.mem_Icc.mp hq).1
  · intro q hq
    exact (Nat.le_floor_iff (zero_le_one.trans hR)).mp (Finset.mem_Icc.mp hq).2
end

