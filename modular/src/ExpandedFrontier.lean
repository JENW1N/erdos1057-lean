section

/- The Mellin phase on the original free product factors across the actual
auxiliary split without changing the phase sign or either test orientation. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_aux_mellin_multiplier_split
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (k : ℤ)
    (f : (∀ i : A, P i.val.1) → ℂ) (g : (∀ i : B, P i.val.1) → ℂ)
    (hposA : ∀ x : (∀ i : A, P i.val.1), 0 < ∏ i, (x i).val)
    (hposB : ∀ y : (∀ i : B, P i.val.1), 0 < ∏ i, (y i).val) (ζ θ : ℝ) :
    physicalAuxFourierMultiplier P V A B hU hAB k
      (fun x => f x*physicalPhase ζ (∏ i, (x i).val))
      (fun y => g y*physicalPhase ζ (∏ i, (y i).val)) θ =
    ∑ aux : PhysicalAuxLabels P (repeatedBigAuxCut A B),
      (physicalAuxMass V (repeatedBigAuxCut A B) aux : ℂ) *
        (f (repeatedBigAuxSplitEquiv P A B hU hAB aux).1 *
          g (repeatedBigAuxSplitEquiv P A B hU hAB aux).2) *
        physicalPhase ζ (physicalFreeFactor (repeatedBigAuxCut A B) aux) *
        fourier (-(k * (physicalFreeFactor (repeatedBigAuxCut A B) aux : ℤ)))
          (θ : AddCircle (1 : ℝ)) := by
  unfold physicalAuxFourierMultiplier
  apply sum_congr rfl
  intro aux _
  have he := repeatedBigAuxSplitEquiv_symm_label_prod P A B hU hAB
    (repeatedBigAuxSplitEquiv P A B hU hAB aux).1
    (repeatedBigAuxSplitEquiv P A B hU hAB aux).2
  simp only [Prod.mk.eta, Equiv.symm_apply_apply] at he
  change physicalFreeFactor (repeatedBigAuxCut A B) aux = _ at he
  change _ = _ * _ * physicalPhase ζ (physicalFreeFactor (repeatedBigAuxCut A B) aux) * _
  rw [he, physical_phase_mul ζ (hposA _) (hposB _)]
  simp only [physicalFreeFactor] at he ⊢
  rw [he]
  ring

end Bounty
end

section

/- The actual dependent divisor-character family has a cubic denominator energy cost. -/

open Finset MeasureTheory

namespace Bounty

theorem rational_gcd_character_family_energy_le (r Q : ℕ)
    (c : (d : ℕ) → AddChar (Additive (ZMod (r/d))ˣ) ℂ → ℂ)
    (P : (d : ℕ) → AddChar (Additive (ZMod (r/d))ˣ) ℂ → ℝ → ℂ)
    (a b B : ℝ) (hB : 0 ≤ B)
    (hP : ∀ d ∈ r.divisors, ∀ ψ, ContinuousOn (P d ψ) (Set.Icc a b))
    (henergy : ∀ d ∈ r.divisors, ∀ ψ, (∫ t in Set.Icc a b, ‖P d ψ t‖^2) ≤ B)
    (hmass : (∑ d ∈ r.divisors, ∑ ψ, ‖c d ψ‖) ≤ (Q : ℝ)*Real.sqrt (Q : ℝ)) :
    (∫ t in Set.Icc a b, ‖∑ d ∈ r.divisors, ∑ ψ, c d ψ * P d ψ t‖^2) ≤
      (Q : ℝ)^3 * B := by
  have h := dependent_weighted_family_energy_le r.divisors c P a b B hP henergy
  calc
    _ ≤ (∑ d ∈ r.divisors, ∑ ψ, ‖c d ψ‖)^2 * B := h
    _ ≤ ((Q : ℝ)*Real.sqrt (Q : ℝ))^2 * B :=
      mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (by positivity) hmass 2) hB
    _ = _ := by rw [mul_pow, Real.sq_sqrt (Nat.cast_nonneg Q)]; ring

end Bounty
end

section

/- Polynomial cell width, mass threshold and modulus give an explicit polynomial cost. -/

open Finset
open scoped Classical
namespace Bounty

theorem prime_cell_polynomial_cost {L B C R : ℝ} {Q : ℕ}
    (hL : 3 ≤ L) (hB : 0 ≤ B) (hQ : (Q : ℝ) ≤ L^R) :
    (L / L^(-B) + 2) * (Q * Q : ℕ) / L^(-C) ≤ L^(B+C+2*R+2) := by
  have hL0 : 0 < L := by linarith
  have hL1 : 1 ≤ L := by linarith
  have hp : 1 ≤ L^(B+1) := Real.one_le_rpow hL1 (by linarith)
  have he : L / L^(-B) = L^(B+1) := by
    calc
      _ = L^(1 : ℝ) / L^(-B) := by rw [Real.rpow_one]
      _ = _ := by rw [← Real.rpow_sub hL0]; congr 1; ring
  have hc : L / L^(-B) + 2 ≤ L^(B+2) := by
    rw [he]
    have he' : L^(B+2) = L^(B+1)*L := by
      calc
        _ = L^((B+1)+1) := by congr 1; ring
        _ = _ := by rw [Real.rpow_add hL0, Real.rpow_one]
    rw [he']
    nlinarith
  have hqq : ((Q*Q : ℕ) : ℝ) ≤ L^R*L^R := by
    rw [Nat.cast_mul]
    exact mul_le_mul hQ hQ (Nat.cast_nonneg _) (Real.rpow_pos_of_pos hL0 R).le
  calc
    _ ≤ L^(B+2) * (L^R*L^R) / L^(-C) :=
      div_le_div_of_nonneg_right
        (mul_le_mul hc hqq (Nat.cast_nonneg _) (Real.rpow_pos_of_pos hL0 _).le)
        (Real.rpow_pos_of_pos hL0 _).le
    _ = _ := by
      rw [Real.rpow_neg hL0.le, div_inv_eq_mul,
        ← Real.rpow_add hL0, ← Real.rpow_add hL0, ← Real.rpow_add hL0]
      congr 1
      ring

theorem prime_retained_cell_polynomial_cost {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ) {Q : ℕ} {L B C R : ℝ}
    (hL : 3 ≤ L) (hB : 0 ≤ B) (hQ : (Q : ℝ) ≤ L^R)
    (hrange : ∀ x : (∀ i, P i),
      0 ≤ Real.log (∏ i, (x i).val : ℕ) ∧ Real.log (∏ i, (x i).val : ℕ) ≤ L) :
    (∑ d ∈ primeProductRetainedCells P V (L^(-B)) (L^(-C)),
      ∑ _χ : BoundedPrimitiveCharacter Q,
        ‖((1 / finiteCellMass (finiteProductWeight (physicalLabelLaw (P := P) V))
          (fun z => upperLogCell (L^(-B)) (Real.log (∏ i, (z i).val : ℕ))) d : ℝ) : ℂ)‖) ≤
      L^(B+C+2*R+2) := by
  have hL0 : 0 < L := by linarith
  exact (prime_retained_cell_expansion_cost P V Q
    (Real.rpow_pos_of_pos hL0 _) (Real.rpow_pos_of_pos hL0 _) hL0.le hrange).trans
      (prime_cell_polynomial_cost hL hB hQ)

end Bounty
end

section

/- Literal four-factor kernel sums and their rational additive twists. -/

open Finset

namespace Bounty

noncomputable def fourBoxKernelSum (D A B C : Finset ℕ)
    (δ α β γ H : ℕ → ℂ) : ℂ :=
  ∑ d ∈ D, ∑ a ∈ A, ∑ b ∈ B, ∑ c ∈ C,
    (δ d*α a*β b*γ c)*H (d*a*b*c)

noncomputable def rationalFourBoxKernelSum (r : ℕ) (k : ℤ)
    (D A B C : Finset ℕ) (δ α β γ H : ℕ → ℂ) : ℂ :=
  fourBoxKernelSum D A B C δ α β γ (fun n => H n *
    Complex.exp (Complex.I*(2*Real.pi*((k : ℝ)/r*(n : ℝ)) : ℝ)))

theorem continuous_four_box_kernel_sum (D A B C : Finset ℕ)
    (δ α β γ : ℕ → ℂ) (H : ℝ → ℕ → ℂ)
    (hH : ∀ n, Continuous (fun t => H t n)) :
    Continuous (fun t => fourBoxKernelSum D A B C δ α β γ (H t)) := by
  unfold fourBoxKernelSum
  fun_prop

theorem four_box_kernel_harmonic_eq (D A B C : Finset ℕ)
    (hD : ∀ d ∈ D, 0 < d) (hA : ∀ a ∈ A, 0 < a)
    (hB : ∀ b ∈ B, 0 < b) (hC : ∀ c ∈ C, 0 < c)
    (δ α β γ : ℕ → ℂ) (t : ℝ) :
    fourBoxKernelSum D A B C δ α β γ (fun n => harmonicMellinWeight t n) =
      (∑ d ∈ D, δ d*harmonicMellinWeight t d)*
      (∑ a ∈ A, α a*harmonicMellinWeight t a)*
      (∑ b ∈ B, β b*harmonicMellinWeight t b)*
      (∑ c ∈ C, γ c*harmonicMellinWeight t c) :=
  harmonic_mellin_four_factor_box D A B C hD hA hB hC δ α β γ t

theorem rational_box_cubic_cost {L A R : ℝ} (hL : 0 < L) {r : ℕ}
    (hr : (r : ℝ) ≤ L^R) :
    (r : ℝ)^3*L^(-(A+3*R)) ≤ L^(-A) := by
  calc
    _ ≤ (L^R)^3*L^(-(A+3*R)) :=
      mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (Nat.cast_nonneg r) hr 3)
        (Real.rpow_nonneg hL.le _)
    _ = L^(-A) := by
      rw [← Real.rpow_mul_natCast hL.le, ← Real.rpow_add hL]
      congr 1
      ring

end Bounty
end

section

/- Uniform cancellation for the extracted actual Q-zero prime window. -/

open Finset Filter

namespace Bounty

theorem candidate_Q_zero_product_window_eq (c L : ℝ) {a R : ℕ} (ha : a ≠ 0) :
    (candidateQBand (c*L) 0).filter (fun p => p*R ∈ arithmeticProductWindow a (Real.exp L)) =
      (primeBand (Real.exp (c*L)) (Real.exp ((6/5 : ℝ)*(c*L)))).filter
        (fun p : ℕ => Real.exp L < ((a*R : ℕ) : ℝ)*(p : ℝ) ∧
          ((a*R : ℕ) : ℝ)*(p : ℝ) ≤ 16*Real.exp L) := by
  ext p
  simp only [candidateQBand, dyadicPrimeBand, pow_zero, div_one, one_mul, mem_filter,
    mem_arithmeticProductWindow_iff ha]
  have he : a*(p*R) = (a*R)*p := by ac_rfl
  rw [he, Nat.cast_mul]

theorem eventually_candidate_Q_prime_cancellation
    (hZ : PrimitiveZeroFreeHalfPlane) {c : ℝ} (hc : 0 < c) (B : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (f : ℕ), 0 < f → (f : ℝ) ≤ Real.exp L →
      ∀ χ : DirichletCharacter ℂ f, χ ≠ 1 →
      ∀ (m : ℕ), m ≠ 0 → (m : ℝ) ≤ Real.exp L →
      ∀ (a R : ℕ), a ≠ 0 → R ≠ 0 →
        ‖∑ p ∈ ((candidateQBand (c*L) 0).filter
          (fun p => p*R ∈ arithmeticProductWindow a (Real.exp L))).filter
            (fun p => p.Coprime m), χ (p : ZMod f)‖ ≤
          ((16*Real.exp L) / ((a*R : ℕ) : ℝ)) * L^(-B) := by
  filter_upwards [eventually_prime_band_coprime_relative_power_bound hZ hc B] with L hL
  intro f hf hfL χ hχ m hm hmL a R ha hR
  rw [candidate_Q_zero_product_window_eq c L ha]
  exact hL f hf hfL χ hχ (Real.exp ((6/5 : ℝ)*(c*L))) ((a*R : ℕ) : ℝ)
    (Real.exp L) (16*Real.exp L) (Real.exp_pos _).le
    (Nat.cast_pos.mpr (Nat.mul_pos (Nat.pos_of_ne_zero ha) (Nat.pos_of_ne_zero hR)))
    (Real.exp_pos L).le (by positivity) m hm hmL

theorem eventually_candidate_Q_character_cancellation
    (hZ : PrimitiveZeroFreeHalfPlane) {c : ℝ} (hc : 0 < c) (B : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (f : ℕ), 0 < f → (f : ℝ) ≤ Real.exp L →
      ∀ χ : DirichletCharacter ℂ f, χ ≠ 1 →
      ∀ (m : ℕ), m ≠ 0 → (m : ℝ) ≤ Real.exp L →
      ∀ (r jStar : ℕ) (hr : 0 < r), 0 < jStar →
      ∀ a : ℕ, a ≠ 0 →
        ‖∑ n ∈ (arithmeticProductWindow a (Real.exp L)).filter (fun n => n.Coprime m),
          (candidateQWeight c L r jStar n : ℂ) * χ (n : ZMod f)‖ ≤
          ((16*Real.exp L) / (a : ℝ)) * L^(-B) * candidateQRestHarmonicMass c L r jStar hr := by
  filter_upwards [eventually_candidate_Q_prime_cancellation hZ hc B,
    eventually_ge_atTop (0 : ℝ)] with L hL hL0
  intro f hf hfL χ hχ m hm hmL r jStar hr hj a ha
  apply candidate_Q_character_bound_of_prime_bound c L r jStar hr hj
    (arithmeticProductWindow a (Real.exp L)) χ m ((16*Real.exp L)/(a : ℝ)) (L^(-B))
    (by positivity) (Real.rpow_nonneg hL0 _)
  intro y
  have hb := hL f hf hfL χ hχ m hm hmL a
    (orderedSlotProduct (candidateQRestChoices c L r jStar hr) y) ha
    (candidate_Q_rest_product_nonzero c L r jStar hr y)
  simpa only [Nat.cast_mul, div_mul_eq_div_div] using hb

end Bounty

end

section

/- Literal physical rows on marks, ledgers and bounded memory. Ghost rows
and every fixed-target edge row use the original raw operators. Full-slot
permutations retain their original normalized average. -/

open Finset
open scoped Classical
namespace Bounty

section Physical
variable {I K : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g, ∀ p : ↥(P g), NeZero p.val]
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (retention : I → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
  (hV : ∀ g, V g ≠ 0)

noncomputable def physicalBoundedMarkRow : Option (I ⊕ K) →
    (PhysicalBoundedMarkState P J ell B → ℂ) → PhysicalBoundedMarkState P J ell B → ℂ
  | none, F, s =>
      ∑ σ : PhysicalPermutations (Fin N) J ell,
        ((Fintype.card (PhysicalPermutations (Fin N) J ell) : ℝ)⁻¹ : ℂ) *
          F (physicalPermuteLabels σ s.1, s.2.1, s.2.2)
  | some (.inl j), F, s =>
      globalBirthJointCutRawRow
        (fun g => GlobalBirthRawStep.visit (a := physicalGroupPhaseActivity s.1 g)
          (fun _ => 0) (β g) (1 - retention j) (V g) ρ (hV g) B) B B
        (physicalMarkRawExtension F s.1)
        (fun g => (s.2.1 g, boundedOrderedTupleToFinite (s.2.2 g)))
  | some (.inr j), F, s =>
      ∑ R : PhysicalMarkLists P J ell, ∑ aux : PhysicalAuxLabels P (C j),
        (ω j (productActiveMemorySplit (fun g => physicalFullSharedIndices (C j g)) B
          (physicalFullMemoryState (C j) s.1 s.2.2)).1 aux : ℂ) *
        if physicalListAdmissible (C j) aux s.1 R then
          jointRawTensorCutoff B (physicalFullEdgeRawRow (B := B) (C j) (k j) s.1 R β ρ V aux)
            (physicalMarkRawExtension F R)
            (fun g => (s.2.1 g, boundedOrderedTupleToFinite (s.2.2 g))) else 0

def PhysicalMarkRowEncoding (tag : Option (I ⊕ K))
    (before after : Fin N → Finset (Fin J)) : Prop :=
  match tag with
  | none => True
  | some (.inl _) => before = after
  | some (.inr j) => before = C j ∧ after = C j

theorem physical_bounded_mark_row_intertwines
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (tag : Option (I ⊕ K)) (before after : Fin N → Finset (Fin J))
    (hencode : PhysicalMarkRowEncoding C tag before after)
    (F : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) :
    physicalBoundedMarkRow C k ω β retention ρ V hV tag
      (F ∘ physicalBoundedMarkEncode after) s =
    physicalFullLedgerRow C k ω β retention ρ V tag F (physicalBoundedMarkEncode before s) := by
  cases tag with
  | none =>
    rw [physical_full_global_permutation_row]
    exact physical_full_transition_average before after s.1 s.2.2 (fun x => F (s.2.1, x))
  | some tag =>
    cases tag with
    | inl j =>
      change before = after at hencode
      subst after
      exact physical_full_global_ghost_row C k ω β retention ρ V j before s.1 s.2.1 s.2.2
        (fun g => physicalGroupPhaseActivity s.1 g) hV F
    | inr j =>
      change before = C j ∧ after = C j at hencode
      rcases hencode with ⟨rfl, rfl⟩
      exact (physical_full_global_edge_row C k ω β retention ρ V j s.1 s.2.1 s.2.2 hP hdis F).symm

end Physical
end Bounty
end

section

/- Exact comparison between two memory caps. Every nonzero smaller-cap path
is identified with a larger-cap path whose total memory never exceeds the
smaller cap. Whole-path phases retain all ordered event identities. -/

open Finset Classical

namespace Bounty

universe uJ uK uG uP uA

section

variable {J : Type uJ} {K : Type uK} {G : Type uG} {P : G → Type uP}
  [Fintype G] [DecidableEq G]
  (n : ∀ g, P g → ℕ) {M : G → ℕ}
  (S : K → ∀ g, Finset (Fin (M g)))
  (A : ∀ k, SharedActiveLabels P (S k) → Type uA)
  (Δ D : ∀ k c, A k c → G → ℤ)
  {b B : ℕ} (h : b ≤ B)
  (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)

noncomputable def fullPermutationMixedCapPhase
    (steps : List (Option (J ⊕ K)))
    (phase : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → ℂ) :
    ∀ s, FullPermutationMixedPath n S b A Δ D steps s → ℂ :=
  finiteSupportedPathPhase
    (FullPermutationMixedEvent n S b A Δ D) (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S b A Δ D) (fullPermutationMixedEventTarget n S B A Δ D)
    (fullPermutationMixedEventWeight n S b A Δ D ω μ q ρ V)
    (finiteSafeEventPredicate (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D)
      (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V) productTotalMemory b)
    (productStateCapEmbed h) (fun s => productTotalMemory s ≤ b)
    (fun k s hs e => fullPermutationMixedEvent_supported_target n S A Δ D ω μ q ρ V k s hs e.val e.property)
    (fullPermutationMixedEventCapSupportEquiv n S A Δ D h ω μ q ρ V)
    (fullPermutationMixedEventCapSupportEquiv_target n S A Δ D h ω μ q ρ V) steps phase

theorem full_permutation_mixed_cap_phase_norm_le
    (steps : List (Option (J ⊕ K)))
    (phase : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b)
    (p : FullPermutationMixedPath n S b A Δ D steps s) :
    ‖fullPermutationMixedCapPhase n S A Δ D h ω μ q ρ V steps phase s p‖ ≤ 1 := by
  exact finite_supported_path_phase_norm_le _ _ _ _ _ _ _ _ _ _ _ steps phase hphase s p

variable [∀ g, Fintype (P g)] [∀ g p, NeZero (n g p)] [∀ k c, Fintype (A k c)]

theorem full_permutation_mixed_cap_path_action
    (steps : List (Option (J ⊕ K)))
    (phase : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → ℂ)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b)
    (hs : productTotalMemory s ≤ b) :
    fullPermutationMixedPathAction n S b A Δ D ω μ q ρ V steps
        (fullPermutationMixedCapPhase n S A Δ D h ω μ q ρ V steps phase)
        (fun s => f (productStateCapEmbed h s)) s =
      fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps
        (fun s p => if fullMemoryPathPeak n S B A Δ D steps s p ≤ b then phase s p else 0)
        f (productStateCapEmbed h s) := by
  let _ : ∀ (k : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S b A Δ D k s) :=
    fullPermutationMixedEventFintype n S b A Δ D
  let _ : ∀ (k : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D k s) :=
    fullPermutationMixedEventFintype n S B A Δ D
  exact finite_safe_path_action_transport
    (FullPermutationMixedEvent n S b A Δ D) (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S b A Δ D) (fullPermutationMixedEventTarget n S B A Δ D)
    (fullPermutationMixedEventWeight n S b A Δ D ω μ q ρ V)
    (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V)
    productTotalMemory b (productStateCapEmbed h) (fun s => productTotalMemory s ≤ b)
    (fun k s hs e => fullPermutationMixedEvent_supported_target n S A Δ D ω μ q ρ V k s hs e.val e.property)
    (fullPermutationMixedEventCapSupportEquiv n S A Δ D h ω μ q ρ V)
    (fullPermutationMixedEventCapSupportEquiv_target n S A Δ D h ω μ q ρ V)
    (fullPermutationMixedEventCapSupportEquiv_weight n S A Δ D h ω μ q ρ V)
    steps phase f s hs hs

end

end Bounty
end

section

/- Uniform per-block cancellation with arbitrary real product-window cutoffs. -/

open Finset Filter

namespace Bounty

theorem eventually_product_window_block_power_saving {a eta theta H C : ℝ}
    (ha : 0 < a) (heta : 0 < eta) (htheta : theta < 1/2)
    (hH : 0 ≤ H) (hC : 0 ≤ C) (B : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ P U R : ℝ,
      Real.exp (a*L) ≤ P → Real.exp (a*L) ≤ U → U ≤ 32*Real.exp L →
      P*U ≤ C*Real.exp L → Real.exp (eta*L) ≤ R → R ≤ Real.exp (theta*L) →
      ∀ (Q S T : Finset ℕ),
        (∀ q ∈ Q, R/2 ≤ (q : ℝ)) → (∀ q ∈ Q, (q : ℝ) ≤ R) →
        (∀ m ∈ S, 0 < m) → (∀ n ∈ T, 0 < n) →
        (∀ m ∈ S, (m : ℝ) ≤ P) → (∀ n ∈ T, (n : ℝ) ≤ U) →
        ∀ α β : ℕ → ℂ,
          (∀ m ∈ S, ‖α m‖ ≤ Real.exp (H*Real.sqrt L)) →
          (∀ n ∈ T, ‖β n‖ ≤ Real.exp (H*Real.sqrt L)) →
          ∀ A Z : ℝ, 0 ≤ A → 0 ≤ Z →
            (∑ q ∈ Q, 1/(q.totient : ℝ) * ∑ χ ∈ primitiveCharacters q,
              ‖∑ m ∈ S, ∑ n ∈ T.filter (fun n : ℕ =>
                A < (m : ℝ)*(n : ℝ) ∧ (m : ℝ)*(n : ℝ) ≤ Z),
                α m * β n * χ ((m*n : ℕ) : ZMod q)‖) ≤
              Real.exp L * L^(-B) := by
  have hdecay := eventually_large_sieve_subexponential_energy_bound ha heta htheta
    (mul_nonneg (by norm_num : (0 : ℝ) ≤ 2) hH)
    (mul_nonneg (by norm_num : (0 : ℝ) ≤ 2) hC) 3 B
  filter_upwards [hdecay, eventually_window_dyadic_prefix_cost,
    eventually_ge_atTop (0 : ℝ), eventually_ge_atTop (4*(6 + 8*Real.pi))]
      with L hdecayL hcostL hL hprefL
  intro P U R hP hU hUHi hPU hRLo hRHi Q S T hQD hQR hSpos hTpos hS hT α β hα hβ A Z hA hZ
  have hP0 : 0 ≤ P := (Real.exp_pos _).le.trans hP
  have hU0 : 0 ≤ U := (Real.exp_pos _).le.trans hU
  have hU1 : 1 ≤ U := (Real.one_le_exp_iff.mpr (mul_nonneg ha.le hL)).trans hU
  have hR1 : 1 ≤ R := (Real.one_le_exp_iff.mpr (mul_nonneg heta.le hL)).trans hRLo
  have hR0 : 0 < R := zero_lt_one.trans_le hR1
  let K := ⌊U⌋₊.log2 + 1
  obtain ⟨hprefix, hcol⟩ := finite_nat_dyadic_prefix hU1 T hT
  have hK : (K + 1 : ℝ) ≤ L^2 := by
    simpa only [K, Nat.cast_add, Nat.cast_one] using hcostL U hU1 hUHi
  have hEa := positive_nat_finset_exponential_energy_le S α hP0 hSpos hS hα
  have hEb := positive_nat_finset_exponential_energy_le T β hU0 hTpos hT hβ
  have hEb' : (∑ n ∈ T, ‖β n‖^2) ≤ (2*U)*Real.exp ((2*H)*Real.sqrt L) := by
    exact hEb.trans (mul_le_mul_of_nonneg_right (by linarith) (Real.exp_nonneg _))
  have hV : Real.exp (a*L) ≤ 2*U := hU.trans (by linarith)
  have hPV : P*(2*U) ≤ (2*C)*Real.exp L := by nlinarith
  have hnumeric := hdecayL P (2*U) R (∑ m ∈ S, ‖α m‖^2) (∑ n ∈ T, ‖β n‖^2)
    hP hV hPV hRLo hRHi (sum_nonneg (fun _ _ => sq_nonneg _)) hEa hEb'
  have hwindow := multiplicative_large_sieve_product_window_real Q
    (show 0 < R/2 by positivity) hR1 hQD hQR hA hZ K S T hSpos hprefix α β
    hP0 (by positivity : 0 ≤ 2*U) hS hcol
  calc
    _ ≤ 2*(K + 1 : ℝ)*((6 + 8*Real.pi)/(R/2)) *
        Real.sqrt ((P + R^2)*(2*U + R^2)*(∑ m ∈ S, ‖α m‖^2)*∑ n ∈ T, ‖β n‖^2) := hwindow
    _ ≤ (L^3/R) *
        Real.sqrt ((P + R^2)*(2*U + R^2)*(∑ m ∈ S, ‖α m‖^2)*∑ n ∈ T, ‖β n‖^2) :=
      mul_le_mul_of_nonneg_right (window_dyadic_prefactor_le K hR0 hK hprefL) (Real.sqrt_nonneg _)
    _ ≤ _ := by
      rw [show (3 : ℝ) = ((3 : ℕ) : ℝ) by norm_num, Real.rpow_natCast] at hnumeric
      exact hnumeric

end Bounty

end

