/- Exact finite dyadic reassembly for the original ambient bilinear discrepancies. -/

open Finset

namespace Bounty

theorem sum_typeIIRestrict_dyadic (M : Finset ℕ) (α : ℕ → ℝ) {n : ℕ} (hn : n ∈ M) :
    (∑ k ∈ dyadicNatIndices M, typeIIRestrict (dyadicNatBucket M k) α n) = α n := by
  classical
  have hidx : n.log2 ∈ dyadicNatIndices M := mem_image_of_mem Nat.log2 hn
  simp [typeIIRestrict,dyadicNatBucket,hn,hidx]

theorem shifted_typeII_bilinear_eq_dyadic_restrictions
    (T : Finset ℕ) (μ α β : ℕ → ℝ) (H : ℕ) (hT : ∀ u ∈ T, 2*u+1 ≤ H) :
    shiftedTypeIIBilinear T μ α β =
      ∑ i ∈ dyadicNatIndices (Icc 1 H), ∑ j ∈ dyadicNatIndices (Icc 1 H),
        shiftedTypeIIBilinear T μ (typeIIRestrict (dyadicNatBucket (Icc 1 H) i) α)
          (typeIIRestrict (dyadicNatBucket (Icc 1 H) j) β) := by
  classical
  unfold shiftedTypeIIBilinear
  simp_rw [sum_comm (s := dyadicNatIndices (Icc 1 H)) (t := shiftedFactorPairs T)]
  apply sum_congr rfl
  intro v hv
  obtain ⟨hm,hn⟩ := shifted_factor_pairs_coordinate_bounds T H hT hv
  simp only [← mul_sum,← sum_mul]
  rw [sum_typeIIRestrict_dyadic _ _ hm,sum_typeIIRestrict_dyadic _ _ hn]

theorem shifted_typeII_bilinear_eq_dyadic_Ioc
    (T : Finset ℕ) (μ α β : ℕ → ℝ) (H : ℕ) (hT : ∀ u ∈ T, 2*u+1 ≤ H) :
    shiftedTypeIIBilinear T μ α β =
      ∑ i ∈ dyadicNatIndices (Icc 1 H), ∑ j ∈ dyadicNatIndices (Icc 1 H),
        shiftedTypeIIBilinear T μ
          (typeIIRestrict (Ioc ((2 : ℕ)^i-1) (min H ((2 : ℕ)^(i+1)-1))) α)
          (typeIIRestrict (Ioc ((2 : ℕ)^j-1) (min H ((2 : ℕ)^(j+1)-1))) β) := by
  simpa only [dyadicNatBucket_Icc_eq_Ioc] using
    shifted_typeII_bilinear_eq_dyadic_restrictions T μ α β H hT

theorem ambient_rough_proxy_error_eq_dyadic_Ioc {L : ℝ} (hL : 0 ≤ L)
    (μ : ℕ → ℝ) (γ S a v : ℝ) :
    ambientRoughProxyError (arithmeticProductWindow 1 (Real.exp L)) μ γ L S
      (Real.exp (a*L)) (Real.exp (v*L)) =
      ∑ i ∈ dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊),
        ∑ j ∈ dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊),
          shiftedTypeIIBilinear (arithmeticProductWindow 1 (Real.exp L)) μ
            (typeIIRestrict (Ioc ((2 : ℕ)^i-1) (min ⌊33*Real.exp L⌋₊ ((2 : ℕ)^(i+1)-1)))
              (ambientRoughIntervalTypeIIAlpha γ L S a v))
            (typeIIRestrict (Ioc ((2 : ℕ)^j-1) (min ⌊33*Real.exp L⌋₊ ((2 : ℕ)^(j+1)-1)))
              (ambientRoughTypeIIBeta (Real.exp (a*L)) (Real.exp (v*L)))) := by
  rw [ambient_rough_proxy_error_eq_interval_typeII hL]
  exact shifted_typeII_bilinear_eq_dyadic_Ioc _ _ _ _ _
    (fun _ hu => shifted_wide_window_nat_factor_bound hL hu)

theorem ambient_prime_proxy_error_eq_dyadic_Ioc {L : ℝ} (hL : 0 ≤ L)
    (μ : ℕ → ℝ) (κ S : ℝ) :
    ambientPrimeProxyError (arithmeticProductWindow 1 (Real.exp L)) μ κ L S =
      ∑ i ∈ dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊),
        ∑ j ∈ dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊),
          (shiftedTypeIIBilinear (arithmeticProductWindow 1 (Real.exp L)) μ
            (typeIIRestrict (Ioc ((2 : ℕ)^i-1) (min ⌊33*Real.exp L⌋₊ ((2 : ℕ)^(i+1)-1)))
              (ambientPrimeTypeIIAlpha κ L S))
            (typeIIRestrict (Ioc ((2 : ℕ)^j-1) (min ⌊33*Real.exp L⌋₊ ((2 : ℕ)^(j+1)-1)))
              (ambientPrimeTypeIIBeta κ L)) +
           shiftedTypeIIBilinear (arithmeticProductWindow 1 (Real.exp L)) μ
            (typeIIRestrict (Ioc ((2 : ℕ)^i-1) (min ⌊33*Real.exp L⌋₊ ((2 : ℕ)^(i+1)-1)))
              (ambientPrimeTypeIIAlpha κ L S))
            (typeIIRestrict (Ioc ((2 : ℕ)^j-1) (min ⌊33*Real.exp L⌋₊ ((2 : ℕ)^(j+1)-1)))
              (ambientProxyTypeIIBeta κ L S))) := by
  rw [ambient_prime_proxy_error_eq_typeII hL]
  rw [shifted_typeII_bilinear_eq_dyadic_Ioc _ _ _ _ _
    (fun _ hu => shifted_wide_window_nat_factor_bound hL hu),
    shifted_typeII_bilinear_eq_dyadic_Ioc _ _ _ _ _
    (fun _ hu => shifted_wide_window_nat_factor_bound hL hu)]
  simp only [sum_add_distrib]

end Bounty
