open Finset Classical
abbrev UnrestrictedProductPhase {G : Type*} {P : G → Type*}
    (n : ∀ g, P g → ℕ) (Δ D : G → ℤ) (t : G → ℕ) (B : ℕ) :=
  ∀ s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B,
    (∀ g, UnrestrictedBoundedEvent (n g) (Δ g) (D g) (t g) B (s g)) → ℂ

noncomputable def unrestrictedCoupledProductOperator
    {G : Type*} [Fintype G] {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) (Δ D : G → ℤ) (μ : ∀ g, P g → ℝ)
    (ρ : ℝ) (V : G → ℝ) (t : G → ℕ) (B : ℕ)
    (phase : UnrestrictedProductPhase n Δ D t B)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ) :=
  finiteProductEventAction
    (fun g => UnrestrictedBoundedEvent (n g) (Δ g) (D g) (t g) B)
    (fun g => unrestrictedBoundedEventWeight (n g) (Δ g) (D g) (μ g) ρ (V g) (t g) B)
    (fun g => unrestrictedBoundedEventTarget (n g) (Δ g) (D g) (t g) B) phase f

noncomputable def unrestrictedCoupledCutoffProductOperator
    {G : Type*} [Fintype G] {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) (Δ D : G → ℤ) (μ : ∀ g, P g → ℝ)
    (ρ : ℝ) (V : G → ℝ) (t : G → ℕ) (B : ℕ)
    (phase : UnrestrictedProductPhase n Δ D t B)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ) :=
  productMemoryCutoff
    (unrestrictedCoupledProductOperator n Δ D μ ρ V t B phase (productMemoryCutoff f))

theorem unrestricted_coupled_product_norm_le_positive
    {G : Type*} [Fintype G] {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) (Δ D : G → ℤ) (μ : ∀ g, P g → ℝ)
    {ρ : ℝ} (V : G → ℝ) (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ V g)
    (hμ : ∀ g p, 0 ≤ μ g p) (t : G → ℕ) (B : ℕ)
    (phase : UnrestrictedProductPhase n Δ D t B)
    (hphase : ∀ s e, ‖phase s e‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) :
    ‖unrestrictedCoupledProductOperator n Δ D μ ρ V t B phase f s‖ ≤
      ‖unrestrictedCoupledProductOperator n Δ D μ ρ V t B (fun _ _ => 1)
        (complexNormEnvelope f) s‖ := by
  exact (finite_product_event_norm_le_positive_re
    (fun g => UnrestrictedBoundedEvent (n g) (Δ g) (D g) (t g) B)
    (fun g => unrestrictedBoundedEventWeight (n g) (Δ g) (D g) (μ g) ρ (V g) (t g) B)
    (fun g => unrestrictedBoundedEventTarget (n g) (Δ g) (D g) (t g) B)
    (fun g x e => unrestrictedBoundedEventWeight_nonneg (n g) (Δ g) (D g) (μ g)
      hρ (hV g) (hμ g) (t g) B x e) phase hphase f s).trans (Complex.re_le_norm _)
end

