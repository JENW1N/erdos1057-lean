open Finset
open scoped Classical
noncomputable def physicalEnumerationChange {G : Type*} {J ell : ℕ}
    (C D : G → Finset (Fin J)) : FullActiveSlotPermutations (fun _ : G => J + ell) :=
  fun g => (physicalFullSlotIndex (D g)).trans (physicalFullSlotIndex (C g)).symm

theorem physical_full_memory_enumeration_change {G : Type*} {P : G → Finset ℕ}
    {Z : G → Type*} {J ell B : ℕ} (C D : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (q : ∀ g, BoundedOrderedTuple (Z g) B) :
    fullActivePermutation (physicalEnumerationChange C D) (physicalFullMemoryState C L q) =
      physicalFullMemoryState D L q := by
  funext g
  apply Prod.ext
  · funext i
    change L g (physicalFullSlotIndex (C g)
      ((physicalFullSlotIndex (C g)).symm (physicalFullSlotIndex (D g) i))) = _
    rw [Equiv.apply_symm_apply]
    rfl
  · rfl

noncomputable def physicalFullPermutationEquiv {G : Type*} {J ell : ℕ}
    (C : G → Finset (Fin J)) :
    PhysicalPermutations G J ell ≃ FullActiveSlotPermutations (fun _ : G => J + ell) where
  toFun σ g := ((physicalFullSlotIndex (C g)).trans (σ g)).trans (physicalFullSlotIndex (C g)).symm
  invFun τ g := ((physicalFullSlotIndex (C g)).symm.trans (τ g)).trans (physicalFullSlotIndex (C g))
  left_inv σ := by
    funext g
    apply Equiv.ext
    intro i
    simp only [Equiv.trans_apply, Equiv.apply_symm_apply]
  right_inv τ := by
    funext g
    apply Equiv.ext
    intro i
    simp only [Equiv.trans_apply, Equiv.symm_apply_apply]

theorem physical_full_memory_permute {G : Type*} {P : G → Finset ℕ}
    {Z : G → Type*} {J ell B : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (q : ∀ g, BoundedOrderedTuple (Z g) B)
    (σ : PhysicalPermutations G J ell) :
    physicalFullMemoryState C (physicalPermuteLabels σ L) q =
      fullActivePermutation (physicalFullPermutationEquiv C σ) (physicalFullMemoryState C L q) := by
  funext g
  apply Prod.ext
  · funext i
    change L g (σ g (physicalFullSlotIndex (C g) i)) =
      L g (physicalFullSlotIndex (C g) ((physicalFullSlotIndex (C g)).symm
        (σ g (physicalFullSlotIndex (C g) i))))
    rw [Equiv.apply_symm_apply]
  · rfl

theorem physical_full_permutation_weight {G : Type*} [Fintype G] [DecidableEq G]
    {J ell : ℕ} (C : G → Finset (Fin J)) (σ : PhysicalPermutations G J ell) :
    (Fintype.card (PhysicalPermutations G J ell) : ℝ)⁻¹ =
      fullActivePermutationWeight (fun _ : G => J + ell) (physicalFullPermutationEquiv C σ) := by
  unfold fullActivePermutationWeight
  rw [Fintype.card_congr (physicalFullPermutationEquiv C)]

theorem physical_full_permutation_phase_reindex {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {Z : G → Type*} {J ell B : ℕ}
    (C : G → Finset (Fin J)) (L : PhysicalMarkLists P J ell)
    (q : ∀ g, BoundedOrderedTuple (Z g) B)
    (F : PhysicalPermutations G J ell →
      ProductBoundedOrderedState (fun g => ↥(P g)) Z (fun _ : G => J + ell) B → ℂ) :
    (∑ σ : PhysicalPermutations G J ell,
      ((Fintype.card (PhysicalPermutations G J ell) : ℝ)⁻¹ : ℂ) *
        F σ (physicalFullMemoryState C (physicalPermuteLabels σ L) q)) =
    ∑ τ : FullActiveSlotPermutations (fun _ : G => J + ell),
      (fullActivePermutationWeight (fun _ : G => J + ell) τ : ℂ) *
        F ((physicalFullPermutationEquiv C).symm τ)
          (fullActivePermutation τ (physicalFullMemoryState C L q)) := by
  calc
    _ = ∑ σ : PhysicalPermutations G J ell,
        (fullActivePermutationWeight (fun _ : G => J + ell) (physicalFullPermutationEquiv C σ) : ℂ) *
          F σ (fullActivePermutation (physicalFullPermutationEquiv C σ) (physicalFullMemoryState C L q)) := by
      apply sum_congr rfl
      intro σ _
      rw [physical_full_memory_permute C L q σ]
      have hw := congrArg Complex.ofReal (physical_full_permutation_weight C σ)
      simpa only [Complex.ofReal_inv] using congrArg
        (fun z : ℂ => z * F σ (fullActivePermutation (physicalFullPermutationEquiv C σ)
          (physicalFullMemoryState C L q))) hw
    _ = _ := by
      simpa only [Equiv.symm_apply_apply] using
        (physicalFullPermutationEquiv C).sum_comp
          (fun τ => (fullActivePermutationWeight (fun _ : G => J + ell) τ : ℂ) *
            F ((physicalFullPermutationEquiv C).symm τ)
              (fullActivePermutation τ (physicalFullMemoryState C L q)))

theorem physical_full_permutation_average {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {Z : G → Type*} {J ell B : ℕ}
    (C : G → Finset (Fin J)) (L : PhysicalMarkLists P J ell)
    (q : ∀ g, BoundedOrderedTuple (Z g) B)
    (F : ProductBoundedOrderedState (fun g => ↥(P g)) Z (fun _ : G => J + ell) B → ℂ) :
    (∑ σ : PhysicalPermutations G J ell,
      ((Fintype.card (PhysicalPermutations G J ell) : ℝ)⁻¹ : ℂ) *
        F (physicalFullMemoryState C (physicalPermuteLabels σ L) q)) =
      fullActiveAverage F (physicalFullMemoryState C L q) := by
  exact physical_full_permutation_phase_reindex C L q (fun _ => F)

theorem physical_full_average_enumeration_independent {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {Z : G → Type*} {J ell B : ℕ}
    (C D : G → Finset (Fin J)) (L : PhysicalMarkLists P J ell)
    (q : ∀ g, BoundedOrderedTuple (Z g) B)
    (F : ProductBoundedOrderedState (fun g => ↥(P g)) Z (fun _ : G => J + ell) B → ℂ) :
    fullActiveAverage F (physicalFullMemoryState D L q) =
      fullActiveAverage F (physicalFullMemoryState C L q) := by
  rw [← physical_full_memory_enumeration_change C D L q]
  exact fullActiveAverage_invariant F (physicalEnumerationChange C D) _
end

