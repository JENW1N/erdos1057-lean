  apply fin_tensor_row_intertwines_on N
    (fun g => boundedGhostLedgerRow (n g) (β g) (η g) (V g) (ρ g) (t g) B)
    (fun g (K : GlobalBirthHistoryState (fun p => ZMod (n g p)) → ℂ)
      (u : GlobalBirthHistoryState (fun p => ZMod (n g p))) =>
        globalBirthGhostVisitRawRow (fun _ => 0) (β g) (η g) (V g) (ρ g) B u.1 u.2.2
          (fun H q => K (H, q)))
    (fun g => boundedGhostLedgerDecode (n g) (t g) B)
    (fun g => boundedGhostLedgerDecode (n g) (t g) B)
    (fun _ _ => True) (fun _ _ => True)
  · intro g u _ G K hGK
    have he : G = K ∘ boundedGhostLedgerDecode (n g) (t g) B :=
      funext (fun v => hGK v trivial)
    rw [he]
    exact bounded_ghost_ledger_row_decode (n g) (β g) (η g) (V g) (ρ g) (t g) B K u
  · intro u _
    rfl
  · exact fun _ => trivial

theorem bounded_ghost_joint_row_events (F : BoundedGhostJointLedgerState n t B → ℂ)
