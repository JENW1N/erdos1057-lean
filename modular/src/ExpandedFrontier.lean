/- The common-address forest leaves exactly the original weight and local residual phases outside its constraints. -/

namespace Bounty
section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, DecidableEq (P g)]
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ)
  (edgePhase : ∀ k, ((g : Fin N) → Finset (P g)) →
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) →
    FullActiveEdgeEvent n (S k) B (A k) (Δ k) (D k) x → ℂ)
  (ω : ∀ k c, A k c → ℝ) (μ : (g : Fin N) → P g → ℝ)
  (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ) (steps : List (Option (J ⊕ K)))

noncomputable def fullMixedCommonResidualWeight
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x) : ℂ :=
  (finiteEventPathWeight (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D)
    (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V) steps x p : ℂ) *
  finiteEventLocalPhase (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D)
    (fullMixedBirthResidualPhase n S B A Δ D edgePhase) steps x p

end Full
