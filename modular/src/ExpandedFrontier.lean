    {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (q ζ : ℝ)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (κ : PhysicalSharedLists P J → ℂ)
    (E : PhysicalSharedLists P J → X → Type*)
    (a : PhysicalResidues P → ∀ d x, E d x → ℂ) (k : X → ℤ)
    (s : PhysicalSmallBigState P J ell X) (e : PhysicalSmallBigEvent E s)
    (h : physicalSmallBigEventWeight V q ζ aux κ E a k s e ≠ 0) :
    physicalResidueMarksValid s.1.1 s.1.2 ∧
      physicalResidueMarksValid (physicalTranslateResidues s.1.1
