theorem prime_power_error_le_character_scale_linear {q x : ℝ}
    (hq : 1 ≤ q) (hx : 2 ≤ x) :
    2 * Real.sqrt x * Real.log x ≤
      2 * x ^ ((31 : ℝ) / 32) * Real.log (q * x) := by
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hlog : Real.log x ≤ Real.log (q * x) :=
    Real.log_le_log hx0 (by nlinarith)
  have hsqrt : Real.sqrt x ≤ x ^ ((31 : ℝ) / 32) := by
    rw [Real.sqrt_eq_rpow]
    exact Real.rpow_le_rpow_of_exponent_le hx1 (by norm_num)
  have hlog0 : 0 ≤ Real.log x := Real.log_nonneg hx1
  gcongr

theorem primitive_twistedTheta_power_saving_linear_log
    (hZ : PrimitiveZeroFreeHalfPlane) :
    ∃ C : ℝ, 0 < C ∧ ∀ (χ : OAI.Ostmann.PrimitiveComplexCharacter) (x : ℝ),
      2 ≤ x → ‖twistedTheta χ.character x‖ ≤
        C * x ^ ((31 : ℝ) / 32) * Real.log ((χ.modulus : ℝ) * x) := by
  obtain ⟨C, hC, hbound⟩ := primitive_twistedPsi_power_saving hZ
  refine ⟨C + 2, by linarith, ?_⟩
  intro χ x hx
  have hq : (1 : ℝ) ≤ χ.modulus := by exact_mod_cast χ.positive
  have he := prime_power_error_le_character_scale_linear hq hx
  have ht := norm_twistedTheta_le χ.character (by linarith : 1 ≤ x) (hbound χ x hx)
  nlinarith
end

section
open Finset Classical
noncomputable def productMemorySymmetrizeOn {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ} (groups : Finset G)
    (f : ProductBoundedOrderedState P Z t B → ℂ) :
    ProductBoundedOrderedState P Z t B → ℂ :=
  finiteCoordinateFinsetAction (fun g => boundedMemorySymmetrize
    (P := P g) (Z := Z g) (t := t g) (B := B)) groups f

noncomputable def productMemorySymmetrize {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (f : ProductBoundedOrderedState P Z t B → ℂ) :
    ProductBoundedOrderedState P Z t B → ℂ :=
  productMemorySymmetrizeOn univ f

theorem productMemory_coordinate_average_eq_self {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (f : ProductBoundedOrderedState P Z t B → ℂ) (hf : ProductMemorySymmetric f) (g : G) :
    finiteCoordinateLift g (boundedMemorySymmetrize
      (P := P g) (Z := Z g) (t := t g) (B := B)) f = f := by
  funext x
  rw [finite_coordinate_lift_eq_update]
  unfold boundedMemorySymmetrize birthPermutationAverage
  have hc : (Fintype.card (Equiv.Perm (Fin (x g).2.1.val)) : ℂ) ≠ 0 := by
    exact_mod_cast Fintype.card_ne_zero
  have heq (σ : Equiv.Perm (Fin (x g).2.1.val)) :
      f (Function.update x g ((x g).1, ⟨(x g).2.1, fun j => (x g).2.2 (σ j)⟩)) = f x :=
    hf x g σ
  simp_rw [heq]
  simp only [sum_const, card_univ, nsmul_eq_mul]
  rw [← mul_assoc, inv_mul_cancel₀ hc, one_mul]

theorem productMemorySymmetrizeOn_eq_self {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ} (groups : Finset G)
    (f : ProductBoundedOrderedState P Z t B → ℂ) (hf : ProductMemorySymmetric f) :
    productMemorySymmetrizeOn groups f = f := by
  have hlist (is : List G) : finiteCoordinateCompose
      (fun g => boundedMemorySymmetrize (P := P g) (Z := Z g) (t := t g) (B := B)) is f = f := by
    induction is with
    | nil => rfl
    | cons g is ih =>
      rw [finiteCoordinateCompose, ih]
      exact productMemory_coordinate_average_eq_self f hf g
  exact hlist groups.toList

theorem productMemorySymmetrize_eq_self {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (f : ProductBoundedOrderedState P Z t B → ℂ) (hf : ProductMemorySymmetric f) :
    productMemorySymmetrize f = f := productMemorySymmetrizeOn_eq_self univ f hf

theorem productMemorySymmetrizeOn_energy_le {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    {t : G → ℕ} {B : ℕ} (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hν : ∀ g z, 0 ≤ ν g z) (groups : Finset G)
    (f : ProductBoundedOrderedState P Z t B → ℂ) :
    (∑ x : ProductBoundedOrderedState P Z t B,
      productMemoryWeight μ ν x * ‖productMemorySymmetrizeOn groups f x‖ ^ 2) ≤
      ∑ x : ProductBoundedOrderedState P Z t B, productMemoryWeight μ ν x * ‖f x‖ ^ 2 := by
  have h := finite_coordinate_finset_energy_le
    (fun g => boundedOrderedStateWeight (μ g) (ν g))
    (fun g x => boundedOrderedStateWeight_nonneg (μ g) (ν g) (hμ g) (hν g) x)
    (fun g => boundedMemorySymmetrize (P := P g) (Z := Z g) (t := t g) (B := B))
    (fun _ => 1) (by intro g; norm_num)
    (by
      intro g q
      simpa only [finiteWeightedEnergy, one_mul] using
        boundedMemorySymmetrize_energy_le (μ g) (ν g) (hμ g) (hν g) q) groups f
  simpa only [finiteWeightedEnergy, finiteProductWeight, productMemoryWeight,
    productMemorySymmetrizeOn, prod_const_one, one_mul] using h

theorem productMemorySymmetrize_energy_le {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    {t : G → ℕ} {B : ℕ} (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hν : ∀ g z, 0 ≤ ν g z)
    (f : ProductBoundedOrderedState P Z t B → ℂ) :
    (∑ x : ProductBoundedOrderedState P Z t B,
      productMemoryWeight μ ν x * ‖productMemorySymmetrize f x‖ ^ 2) ≤
      ∑ x : ProductBoundedOrderedState P Z t B, productMemoryWeight μ ν x * ‖f x‖ ^ 2 :=
  productMemorySymmetrizeOn_energy_le μ ν hμ hν univ f
end

section
open Finset Classical
def FiniteLocalInvariant {X : Type*} (R : X → X → Prop) (f : X → ℂ) : Prop :=
  ∀ x y, R x y → f y = f x

def FiniteCoordinateInvariant {I : Type*} [DecidableEq I] {X : I → Type*}
    (i : I) (R : X i → X i → Prop) (f : (∀ j, X j) → ℂ) : Prop :=
  ∀ x y, R (x i) y → f (Function.update x i y) = f x

theorem finite_coordinate_invariant_slice {I : Type*} [DecidableEq I]
    {X : I → Type*} (i : I) (R : X i → X i → Prop)
    (f : (∀ j, X j) → ℂ) (hf : FiniteCoordinateInvariant i R f) (x : ∀ j, X j) :
    FiniteLocalInvariant R (fun y => f (Function.update x i y)) := by
  intro y z hyz
  have h := hf (Function.update x i y) z (by simpa using hyz)
  simpa only [Function.update_idem] using h

theorem finite_coordinate_lift_preserves_other {I : Type*} [DecidableEq I]
    {X : I → Type*} (i j : I) (hij : i ≠ j) (R : X i → X i → Prop)
    (A : (X j → ℂ) → X j → ℂ) (f : (∀ k, X k) → ℂ)
    (hf : FiniteCoordinateInvariant i R f) :
    FiniteCoordinateInvariant i R (finiteCoordinateLift j A f) := by
  intro x y hxy
  simp only [finite_coordinate_lift_eq_update]
  have hsection : (fun z => f (Function.update (Function.update x i y) j z)) =
      (fun z => f (Function.update x j z)) := by
    funext z
    rw [Function.update_comm hij]
    apply hf
    simpa only [Function.update_of_ne hij] using hxy
  rw [hsection, Function.update_of_ne hij.symm]

theorem finite_coordinate_compose_preserves_absent {I : Type*} [DecidableEq I]
    {X : I → Type*} (i : I) (R : X i → X i → Prop)
    (A : ∀ j, (X j → ℂ) → X j → ℂ) (is : List I) (hi : i ∉ is)
    (f : (∀ j, X j) → ℂ) (hf : FiniteCoordinateInvariant i R f) :
    FiniteCoordinateInvariant i R (finiteCoordinateCompose A is f) := by
  induction is with
  | nil => exact hf
  | cons j js ih =>
    apply finite_coordinate_lift_preserves_other i j
    · intro hij
      exact hi (by simp [hij])
    · apply ih
      intro hmem
      exact hi (List.mem_cons_of_mem j hmem)

theorem finite_coordinate_projected_lift_eq {I : Type*} [DecidableEq I]
    {X : I → Type*} (i : I) (R : X i → X i → Prop)
    (A P : (X i → ℂ) → X i → ℂ)
    (hP : ∀ g, FiniteLocalInvariant R g → P g = g)
    (f : (∀ j, X j) → ℂ) (hf : FiniteCoordinateInvariant i R f) :
    finiteCoordinateLift i (fun g => A (P g)) f = finiteCoordinateLift i A f := by
  funext x
  simp only [finite_coordinate_lift_eq_update]
  rw [hP _ (finite_coordinate_invariant_slice i R f hf x)]

/-- On separately invariant inputs, inserted local symmetry projections
do not change a composition with no repeated coordinate. -/
theorem finite_coordinate_projected_compose_eq {I : Type*} [DecidableEq I]
    {X : I → Type*} (R : ∀ i, X i → X i → Prop)
    (A P : ∀ i, (X i → ℂ) → X i → ℂ)
    (hP : ∀ i g, FiniteLocalInvariant (R i) g → P i g = g)
    (is : List I) (his : is.Nodup) (f : (∀ i, X i) → ℂ)
    (hf : ∀ i, FiniteCoordinateInvariant i (R i) f) :
    finiteCoordinateCompose (fun i g => A i (P i g)) is f = finiteCoordinateCompose A is f := by
  induction is with
  | nil => rfl
  | cons i is ih =>
    obtain ⟨hi, htail⟩ := List.nodup_cons.mp his
    simp only [finiteCoordinateCompose, ih htail]
    apply finite_coordinate_projected_lift_eq i (R i) (A i) (P i) (hP i)
    exact finite_coordinate_compose_preserves_absent i (R i) A is hi f (hf i)

/-- A within-memory permutation preserves the active tuple and memory length. -/
def BoundedMemoryPermutationRelation {P Z : Type*} {t B : ℕ}
    (x y : BoundedOrderedState P Z t B) : Prop :=
  ∃ τ : Equiv.Perm (Fin x.2.1.val), y = (x.1, ⟨x.2.1, x.2.2 ∘ τ⟩)

theorem finite_local_memory_invariant_iff {P Z : Type*} {t B : ℕ}
    (f : BoundedOrderedState P Z t B → ℂ) :
    FiniteLocalInvariant BoundedMemoryPermutationRelation f ↔ BoundedOrderedSymmetric f := by
  constructor
  · intro h active N q τ
    exact h (active, ⟨N, q⟩) (active, ⟨N, q ∘ τ⟩) ⟨τ, rfl⟩
  · intro h x y hxy
    obtain ⟨τ, rfl⟩ := hxy
    exact h x.1 x.2.1 x.2.2 τ

theorem product_memory_symmetric_iff_coordinate {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (f : ProductBoundedOrderedState P Z t B → ℂ) :
    ProductMemorySymmetric f ↔
      ∀ g : G, FiniteCoordinateInvariant
        (X := fun h => BoundedOrderedState (P h) (Z h) (t h) B) g
        (BoundedMemoryPermutationRelation (P := P g) (Z := Z g) (t := t g) (B := B)) f := by
  constructor
  · intro h g x y hxy
    obtain ⟨τ, rfl⟩ := hxy
    exact h x g τ
  · intro h x g τ
    exact h g x _ ⟨τ, rfl⟩

/-- Inserting actual bounded-memory permutation averaging before every
coordinate action leaves the raw product unchanged on separately symmetric
input, as long as no group is used twice. -/
theorem product_memory_projected_compose_eq {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (A : ∀ g, (BoundedOrderedState (P g) (Z g) (t g) B → ℂ) →
      BoundedOrderedState (P g) (Z g) (t g) B → ℂ)
    (is : List G) (his : is.Nodup) (f : ProductBoundedOrderedState P Z t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteCoordinateCompose (fun g h => A g (boundedMemorySymmetrize h)) is f =
      finiteCoordinateCompose A is f := by
  apply finite_coordinate_projected_compose_eq
    (fun g => BoundedMemoryPermutationRelation (P := P g) (Z := Z g) (t := t g) (B := B))
    A (fun _ => boundedMemorySymmetrize)
  · intro g h hh
    exact boundedMemorySymmetrize_eq_self h ((finite_local_memory_invariant_iff h).mp hh)
  · exact his
  · exact (product_memory_symmetric_iff_coordinate f).mp hf

theorem product_memory_projected_finset_eq {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (A : ∀ g, (BoundedOrderedState (P g) (Z g) (t g) B → ℂ) →
      BoundedOrderedState (P g) (Z g) (t g) B → ℂ)
    (s : Finset G) (f : ProductBoundedOrderedState P Z t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteCoordinateFinsetAction (fun g h => A g (boundedMemorySymmetrize h)) s f =
      finiteCoordinateFinsetAction A s f := by
  exact product_memory_projected_compose_eq A s.toList s.nodup_toList f hf
end

