/- The original full-path forest mask is exactly the conjunction of causal owner-stage conditions. -/

namespace Bounty

section History
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K)))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps s)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))

theorem full_mixed_forest_stage_history_iff (u : Fin steps.length) :
    birthForestStageCondition
      (fun i => fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i)) u
      (fullMixedPathBirthHistory n S B A Δ D steps s p history (u.val + 1)) code ↔
    birthForestStageCondition
      (fun i => fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i)) u
      (fun i => fullMixedPathBirthLabel n S B A Δ D steps s p (fullMixedBirthOrder S B steps i)) code := by
  apply birth_forest_stage_congr _ (full_mixed_birth_order_owner_monotone S B steps)
  intro i hi
  exact if_pos (Nat.lt_succ_of_le hi)

theorem full_mixed_forest_compatible_iff_history_stages :
    birthForestCompatible
      (fun i => fullMixedPathBirthPerformed n S B A Δ D steps s p (fullMixedBirthOrder S B steps i))
      (fun i => fullMixedPathBirthLabel n S B A Δ D steps s p (fullMixedBirthOrder S B steps i)) code ↔
    ∀ u : Fin steps.length, birthForestStageCondition
      (fun i => fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i)) u
      (fullMixedPathBirthHistory n S B A Δ D steps s p history (u.val + 1)) code := by
  have hp : (fun i => fullMixedPathBirthPerformed n S B A Δ D steps s p
      (fullMixedBirthOrder S B steps i)) =
      (fun i => (fullMixedPathBirthLabel n S B A Δ D steps s p
        (fullMixedBirthOrder S B steps i)).isSome = true) := by
    funext i
    simp only [fullMixedPathBirthPerformed, fullMixedPathBirthLabel, Option.isSome_map]
  rw [hp, birth_forest_compatible_iff_stages
    (fun i => fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i))]
  exact forall_congr' fun u => (full_mixed_forest_stage_history_iff n S B A Δ D steps s p history code u).symm

end History
end Bounty
