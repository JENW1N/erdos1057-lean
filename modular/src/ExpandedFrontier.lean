      (rpow_nonneg hL0.le Cb) hb pool α β γ
      (rpow_nonneg hL0.le Ce) (rpow_nonneg hL0.le Ce) (rpow_nonneg hL0.le Ce)
      hα hβ hγ (Icc 1 N) N (fun n hn => (mem_Icc.mp hn).2)
    have hd := selected_four_convolution_error_energy P (by norm_num : (0 : ℝ) ≤ 1/2)
      (by norm_num : (1/2 : ℝ) < 1) hv mass marks (ell+J) hmass hmarks hprime hdis
      g κ hκ big hg b (rpow_nonneg hL0.le Cb) hb pool hpool α β γ hαfree hβfree
      (rpow_nonneg hL0.le Ce) (rpow_nonneg hL0.le Ce) (rpow_nonneg hL0.le Ce)
      hα hβ hγ (Icc 1 N) N (fun n hn => ⟨(mem_Icc.mp hn).1,(mem_Icc.mp hn).2⟩)
    have hd' : (∑ n ∈ Icc 1 N, ‖selectedMarkedEndpoint P (1/2) mass marks big b pool α β γ n-
