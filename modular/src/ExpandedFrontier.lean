variable {J K G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  {M : G → ℕ} (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
  (Δ D : ∀ k c, A k c → G → ℤ) (ω : ∀ k c, A k c → ℝ)
  (μ : ∀ g, P g → ℝ) (q : J → ℝ) (V : G → ℝ)

/-- The explicit pair chosen from qmax and vmax satisfies both ordinary
termination damping and doubled-birth damping. No existence hypothesis
for a group is needed to discharge the termination inequality. -/
theorem full_ghost_birth_tail_energy_le_parameters
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    {qmax vmin vmax : ℝ} (hqmax0 : 0 ≤ qmax) (hqmax1 : qmax < 1)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 < μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hq0 : ∀ j, 0 ≤ q j) (hqmax : ∀ j, q j ≤ qmax)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (steps : List (Option (J ⊕ K))) (r : ℕ)
    (allowed : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → Prop)
    (phase : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    let ρ := physicalGhostRhoChoice qmax
    let v := physicalGhostWeightChoice qmax vmax
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps
        (fun s p => if r ≤ fullGhostPathBirthCount n S B A Δ D steps s p then
          (if allowed s p then phase s p else 0) else 0) f) ≤
    ((2 : ℝ) ^ r)⁻¹ ^ 2 *
      (steps.map (fullDoubledGhostStepEnergy ρ v vmin vmax T (Fintype.card G))).prod *
      finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  obtain ⟨hρ0, hρ1, hgap, hv, hthreshold, _⟩ :=
    physical_ghost_parameter_choice (Vmax := vmax) hqmax0 hqmax1
  apply full_ghost_birth_tail_energy_le n S B A Δ D ω μ q (physicalGhostRhoChoice qmax) V
    hω hωmass hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass hq0
    (fun j => (hqmax j).trans hqmax1.le) ?_ ?_ T ht steps r allowed phase hphase f hf
  · intro j
    simpa only [one_mul, mul_one] using
      (physical_ghost_scaled_damping_lt_one (hq0 j) (hqmax j) hgap hρ0 hρ1 hthreshold
        (a := 1) (W := 1) (by norm_num) zero_le_one (le_max_left _ _)).le
  · intro j g
    have h := (physical_ghost_doubled_birth_damping (hq0 j) (hqmax j) hgap hρ0 hρ1
      hthreshold (hvmin.trans_le (hVlo g)).le (hVhi g)).le
    convert h using 1 <;> first | rfl | ring

/-- Polynomial group loss times the exact exponential birth-tail gain.
The exponent counts ghost and edge steps, excluding permutations. -/
theorem full_ghost_birth_tail_energy_le_parameters_rpow
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    {qmax vmin vmax : ℝ} (hqmax0 : 0 ≤ qmax) (hqmax1 : qmax < 1)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 < μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hq0 : ∀ j, 0 ≤ q j) (hqmax : ∀ j, q j ≤ qmax)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    {L R : ℝ} (hL : 0 < L) (hgroups : (Fintype.card G : ℝ) ≤ R * Real.log L)
    (steps : List (Option (J ⊕ K))) (r : ℕ)
    (allowed : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → Prop)
    (phase : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    let ρ := physicalGhostRhoChoice qmax
    let v := physicalGhostWeightChoice qmax vmax
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps
        (fun s p => if r ≤ fullGhostPathBirthCount n S B A Δ D steps s p then
          (if allowed s p then phase s p else 0) else 0) f) ≤
    ((2 : ℝ) ^ r)⁻¹ ^ 2 *
      L ^ ((steps.filterMap id).length * R *
        Real.log (fullDoubledGhostUniformEnergy ρ v vmin vmax T)) *
      finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  have he := full_ghost_birth_tail_energy_le_parameters n S B A Δ D ω μ q V
    hω hωmass hqmax0 hqmax1 hvmin hVlo hVhi hμ hmass hq0 hqmax
    T ht steps r allowed phase hphase f hf
  apply he.trans
  apply mul_le_mul_of_nonneg_right
    (mul_le_mul_of_nonneg_left
      (fullDoubledGhost_product_le_rpow (physicalGhostRhoChoice qmax)
        (physicalGhostWeightChoice qmax vmax) vmin vmax T (Fintype.card G) steps hL hgroups)
      (sq_nonneg _))
  apply sum_nonneg
  intro x _
  exact mul_nonneg (productMemoryWeight_nonneg μ (fun g => unrestrictedResidueWeight (μ g))
    (fun g p => (hμ g p).le) (fun g z => (hμ g z.1).le) x) (sq_nonneg _)

end
