      (physicalPermuteLabels (d.val.2.2.1 j) (d.val.2.1 j.castSucc))
      (physicalPermuteLabels (d.val.2.2.2 j) (d.val.2.1 j.succ)))
    (hk : ∀ d : S, ∀ j : Fin (r + 1), ∀ g t, ¬ ((d.val.2.1 j.castSucc g t).val : ℤ) ∣ k j) :
    ‖(∑ d : S, mask d.val *
      physicalMemoryWalkScalar V patterns C phase K
        (finitePathLabels ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d.val⟩).2)
        (finitePathMarks ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d.val⟩).1
