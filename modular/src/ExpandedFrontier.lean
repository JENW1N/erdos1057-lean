section

/- On the actual divisor fibers, shared endpoint and auxiliary avoidance
implies the original compatible-completion restrictions. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_shared_good_implies_cut_good {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (u v : GroupMarkedLists P (fun g => ell + (C g).card))
    (aux : PhysicalAuxLabels P C) {w z : ℕ} (hw : 0 < w) (hz : 0 < z)
    (hu : ∀ g i, (u g i).val ∣ w) (hv : ∀ g i, (v g i).val ∣ z)
    (s : PhysicalAuxLabels P (fun g => univ \ C g))
    (hs : physicalSharedDrawGood C (fun g => physicalSharedForbidden C aux g w z) s) :
    physicalRawCutGood C u v s := by
  refine ⟨fun g => (hs g).2, fun g => ⟨?_, ?_⟩⟩
  · apply Set.disjoint_left.mpr
    rintro p ⟨j, rfl⟩ ⟨i, hi⟩
    apply (hs g).1 j
    apply (physical_mem_shared_forbidden_iff C aux g (hprime g) hw hz (s g j)).mpr
    left
    rw [← hi]
    exact hu g i
  · apply Set.disjoint_left.mpr
    rintro p ⟨j, rfl⟩ ⟨i, hi⟩
    apply (hs g).1 j
    apply (physical_mem_shared_forbidden_iff C aux g (hprime g) hw hz (s g j)).mpr
    right
    left
    rw [← hi]
    exact hv g i

theorem physical_shared_good_iff_cut_avoiding {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (u v : GroupMarkedLists P (fun g => ell + (C g).card))
    (aux : PhysicalAuxLabels P C) {w z : ℕ} (hw : 0 < w) (hz : 0 < z)
    (hu : ∀ g i, (u g i).val ∣ w) (hv : ∀ g i, (v g i).val ∣ z)
    (s : PhysicalAuxLabels P (fun g => univ \ C g)) :
    physicalSharedDrawGood C (fun g => physicalSharedForbidden C aux g w z) s ↔
      physicalRawCutGood C u v s ∧
        ∀ g j, s g j ∉ physicalSharedForbidden C aux g w z := by
  constructor
  · intro hs
    exact ⟨physical_shared_good_implies_cut_good C hprime u v aux hw hz hu hv s hs,
      fun g => (hs g).1⟩
  · rintro ⟨hcut, havoid⟩ g
    exact ⟨havoid g, hcut.1 g⟩

theorem physical_cut_avoiding_mean_eq_shared_good_mean {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (u v : GroupMarkedLists P (fun g => ell + (C g).card))
    (aux : PhysicalAuxLabels P C) {w z : ℕ} (hw : 0 < w) (hz : 0 < z)
    (hu : ∀ g i, (u g i).val ∣ w) (hv : ∀ g i, (v g i).val ∣ z)
    (F : PhysicalAuxLabels P (fun g => univ \ C g) → ℂ) :
    (∑ s : PhysicalAuxLabels P (fun g => univ \ C g),
      if physicalRawCutGood C u v s then
        if ∀ g j, s g j ∉ physicalSharedForbidden C aux g w z then F s else 0
      else 0) =
      ∑ s : PhysicalAuxLabels P (fun g => univ \ C g),
        if physicalSharedDrawGood C (fun g => physicalSharedForbidden C aux g w z) s
          then F s else 0 := by
  apply sum_congr rfl
  intro s _
  rw [physical_shared_good_iff_cut_avoiding C hprime u v aux hw hz hu hv s]
  by_cases hc : physicalRawCutGood C u v s
  · simp only [hc, true_and, if_true]
  · simp only [hc, false_and, if_false]

end Bounty
end

