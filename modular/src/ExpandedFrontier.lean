    (phase : UnrestrictedProductPhase (fun g (p : P g) => p.val) Δ D t B)
    (hphase : ∀ s e, ‖phase s e‖ ≤ 1)
    (f : ProductBoundedOrderedState (fun g => P g)
      (fun g => UnrestrictedResidueParticle (fun p : P g => p.val)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    let _ : ∀ g (p : P g), NeZero p.val := fun g p => ⟨Nat.ne_of_gt (hpositive g p)⟩
    finiteWeightedEnergy
      (productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (baseline g))
        (fun g => unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g (baseline g))))
      (unrestrictedCoupledCutoffProductOperator (fun g (p : P g) => p.val) Δ D
        (fun g => tiltedPhysicalBirthLaw V g (baseline g)) ρ V t B phase f) ≤
    unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
