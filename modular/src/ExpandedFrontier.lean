    (tag : Option (Fin (n + 1) ⊕ Fin n)) →
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B) →
    PhysicalFullLedgerEvent C k tag s → ℂ
