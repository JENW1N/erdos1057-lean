    ((physicalSmallSelectedArraysEquiv
      (fun (i : patterns) (g : ↥groupsᶜ) => C i.val g.val) hC)
        ((physicalSmallSelectedPlanEquiv
          (fun (i : patterns) (g : ↥groupsᶜ) => C i.val g.val) hC).symm p))).1 = p.1 at hi
