theorem exists_candidate_rough_slot_scale {c b : ℝ} (hb : 0 < b) :
    ∃ J : ℕ, ∀ j : ℕ, J < j → (6/5 : ℝ)*c/2^j ≤ b/4 := by
  have hpow : ∀ᶠ j : ℕ in atTop, 24*c/(5*b) ≤ (2 : ℝ)^j :=
    (tendsto_pow_atTop_atTop_of_one_lt (by norm_num : (1 : ℝ)<2)).eventually
      (eventually_ge_atTop (24*c/(5*b)))
  obtain ⟨J,hJ⟩ := eventually_atTop.mp hpow
  refine ⟨J, fun j hj => ?_⟩
  have hh := (div_le_iff₀ (by positivity : (0 : ℝ)<5*b)).mp (hJ j hj.le)
  apply (div_le_iff₀ (by positivity : (0 : ℝ)<2^j)).mpr
  nlinarith

theorem eventually_candidate_compact_range_exact {c b : ℝ} (hc : 0 < c) (hb : 0 < b)
    {r : ℕ} (hr : 6 ≤ r) (jStar : ℕ)
    (hscale : (6/5 : ℝ)*c/2^jStar ≤ b/4) :
    ∀ᶠ L : ℝ in atTop, ∀ (E q : ℝ), 1 ≤ E → log E ≤ (1-b)*L →
      ∀ u ∈ arithmeticProductWindow 1 (exp L),
      (primePoolPart ((candidatePIndices c L).biUnion (candidatePBand (c*L))) u : ℝ) ≤ exp (b/4*L) →
      candidateCompactRangeCoefficient c L q r jStar E u = candidateCoefficient c L q r jStar u := by
  filter_upwards [eventually_candidate_good_tuple_compact_allocation hc hr,
    eventually_fixed_candidateQ_prefix hc jStar, eventually_gt_atTop (1 : ℝ)]
    with L hgood hjPrefix hL
  intro E q hE hlogE u hu hP
  have hL0 : 0 < L := zero_lt_one.trans hL
  have hj : jStar ∈ candidateQIndices c L := hjPrefix (mem_Icc.mpr ⟨Nat.zero_le _, le_rfl⟩)
  let P := primePoolPart ((candidatePIndices c L).biUnion (candidatePBand (c*L))) u
  have hsum : candidateCompactRangeQWeight c L r jStar E
      (primePoolFreePart ((candidatePIndices c L).biUnion (candidatePBand (c*L))) u) =
      candidateQWeight c L r jStar
        (primePoolFreePart ((candidatePIndices c L).biUnion (candidatePBand (c*L))) u) := by
    unfold candidateCompactRangeQWeight candidateQWeight orderedSlotWeight
    refine sum_congr ?_ ?_
    · ext x; simp only [mem_univ]
    intro x hx
    split_ifs with hxprod
    · have hprod : P*orderedSlotProduct (candidateQSlotChoices c L r jStar) x = u := by
        rw [hxprod]
        exact primePoolPart_mul_primePoolFreePart _ _
      have htotal : exp L ≤ (P*orderedSlotProduct (candidateQSlotChoices c L r jStar) x : ℕ) := by
        rw [hprod]
        have hh : exp L < (u : ℝ) := by simpa only [one_mul] using
          ((mem_arithmeticProductWindow_iff one_ne_zero (exp L)).mp hu).1
        exact hh.le
      have hxlog := (candidate_Q_slot_log_bounds c L r jStar
        (candidateRoughSlot c L r jStar (by omega) hj) (x _).property).2
      simp only [candidateRoughSlot] at hxlog
      have hxpos : (0 : ℝ) < (x (candidateRoughSlot c L r jStar (by omega) hj)).val := by
        exact_mod_cast Nat.pos_of_ne_zero (candidate_Q_slot_nonzero c L r jStar _ (x _).property)
      have hxsmall : ((x (candidateRoughSlot c L r jStar (by omega) hj)).val : ℝ) ≤ exp (b/4*L) := by
        apply (log_le_iff_le_exp hxpos).mp
        apply hxlog.trans
        convert mul_le_mul_of_nonneg_right hscale hL0.le using 1 <;> ring
      have hretained : (P*(x (candidateRoughSlot c L r jStar (by omega) hj)).val : ℕ) ≤ exp (b/2*L) := by
        calc
          _ = (P : ℝ)*((x (candidateRoughSlot c L r jStar (by omega) hj)).val : ℝ) := by norm_cast
          _ ≤ exp (b/4*L)*exp (b/4*L) := mul_le_mul hP hxsmall (Nat.cast_nonneg _) (exp_pos _).le
          _ = _ := by rw [← exp_add]; congr 1; ring
      have hunit := (hgood jStar P hj x E b hb.le hE htotal hretained hlogE).2
      rw [candidate_range_allocation_mass_eq_one c L r jStar x E hunit]
      intro take ht
      exact candidate_allocation_good_tuple_range hc hL0 (log_pos hL) hb.le hE hr hj x
        htotal hretained hlogE take (lt_of_lt_of_le ht
          (candidate_compact_allocation_bounds c L r jStar x (log E) take).2)
    · rfl
  unfold candidateCompactRangeCoefficient candidateCoefficient
  rw [hsum]

