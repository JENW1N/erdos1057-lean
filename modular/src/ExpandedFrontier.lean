section

/- Arbitrary power saving survives the full original prime-pattern and auxiliary average. -/

open Filter Finset Real
open scoped Classical
namespace Bounty

theorem eventually_candidate_pattern_harmonic_decay {c b K q x : ℝ}
    (hc : 0 < c) (hb : 0 < b) (hK : 0 ≤ K) (hq : 0 ≤ q) (hx : 0 ≤ x)
    (J ell : ℕ) (Cenv D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (groups : Finset ℕ), groups ⊆ candidatePIndices c L →
      ∀ (probes : groups → Finset (Fin J)) (r t : Finset groups) (hrt : Disjoint r t)
        (Q : ℕ) (h ξ : ℝ), (Q : ℝ) ≤ L^q → L^(-x) ≤ ξ →
      ∀ (a a' : ℝ) (pool : Finset ℕ), (∀ g : groups, candidatePBand (c*L) g.val ⊆ pool) →
      ∀ (α β γ α' β' γ' : ℕ → ℂ),
      (∀ n, ‖α n‖ ≤ L^Cenv) → (∀ n, ‖β n‖ ≤ L^Cenv) → (∀ n, ‖γ n‖ ≤ L^Cenv) →
      (∀ n, ‖α' n‖ ≤ L^Cenv) → (∀ n, ‖β' n‖ ≤ L^Cenv) → (∀ n, ‖γ' n‖ ≤ L^Cenv) →
      ∀ U V : ℝ, exp (b*L) ≤ U → U ≤ exp L → exp (b*L) ≤ V → V ≤ exp L →
      ∀ k ∈ Icc (-(typeIIAdmissibleDeterminantBound L K : ℤ)) (typeIIAdmissibleDeterminantBound L K : ℤ),
      ∀ j ∈ range (typeIISmoothDyadicCount L),
      ‖∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
        ∑ aux : PhysicalAuxLabels (fun g : groups => candidatePBand (c*L) g.val)
            (repeatedBigPrimePatternCut probes r t i),
          (physicalAuxMass (fun g : groups => ∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ))
            (repeatedBigPrimePatternCut probes r t i) aux : ℂ)*
          physicalPositiveHarmonicDifference (fun g : groups => candidatePBand (c*L) g.val)
            (fun g => ∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ)) probes r t hrt Q h ξ i aux
            a a' (typeIISmoothDyadicScale U V (U*L^(-K)) j) k pool α β γ α' β' γ'‖ ≤ L^(-D) := by
  obtain ⟨v, A, hv, hA, hinputs⟩ := exists_candidate_shared_error_inputs hc J
  let Acard := A*log 2+1
  filter_upwards [hinputs, eventually_ge_atTop (2 : ℝ),
    eventually_candidate_harmonic_replacement_decay hc hb hK J ell Cenv (4*q+2*x) (D+Acard)]
    with L hinput hL hbase
  intro groups hgroups probes r t hrt Q h ξ hQ hξ a a' pool hpool
    α β γ α' β' γ' hα hβ hγ hα' hβ' hγ' U V hUlo hUhi hVlo hVhi k hk j hj
  have hL0 : 0 < L := by linarith
  have hL1 : 1 ≤ L := by linarith
  have hξ0 : 0 < ξ := (rpow_pos_of_pos hL0 (-x)).trans_le hξ
  have hmass : ∀ g : groups, 0 < ∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ) :=
    fun g => hv.trans_le ((hinput groups hgroups).2 g).1
  have hslots : ((J*Fintype.card groups : ℕ) : ℝ) ≤ A*log L := by
    simpa only [Fintype.card_coe] using (hinput groups hgroups).1
  have hcard : (Fintype.card (RepeatedBigPrimePatternIndex (ell := ell) probes r t) : ℝ) ≤ L^Acard :=
    harmonic_pattern_card_power probes r t hrt hL hA hslots
  apply physical_pattern_error_power
    (fun g : groups => ∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ))
    hmass (fun _ => rfl) probes r t hL0 hcard
  intro i aux
  exact hbase groups hgroups probes r t hrt Q h ξ hξ0 i aux
    (harmonic_pattern_bound_power probes r t hL1 hq hx Q hQ hξ i)
    a a' pool hpool α β γ α' β' γ' hα hβ hγ hα' hβ' hγ'
    U V hUlo hUhi hVlo hVhi k hk j hj

end Bounty
end

section

/- Arbitrary precision at a fixed polynomial Mellin radius for the original harmonic sum. -/

open Filter Finset MeasureTheory Real
namespace Bounty

noncomputable def harmonicCellTruncationError (Z H : ℝ) (d : ℕ) (k : ℤ)
    (a b : ℝ) (F G : ℤ → ℂ) (R : ℝ) : ℝ :=
  ‖physicalPhase (-(a+b)) d *
        (∑ n ∈ harmonicPositiveSupport Z k d,
          ((typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) : ℂ)/(n : ℂ))*
            physicalPhase a n.natAbs*physicalPhase b (n+k*(d : ℤ)).natAbs*
            star (F n)*G (n+k*(d : ℤ))) -
        ((Z*H : ℝ) : ℂ)⁻¹ * (∫ v in {v : ℝ | ‖v‖ ≤ R},
          harmonicLogFourier v*physicalPhase (-(a+b+2*Real.pi*v)) d*
            harmonicCellPairing (Z*H) Z a b (2*Real.pi*v) (k*(d : ℤ)) F G)‖

theorem eventually_harmonic_cell_sum_mellin_tail {r : ℝ} (hr : 0 < r) (C D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (Z H : ℝ) (d : ℕ) (k : ℤ) (a b : ℝ) (F G : ℤ → ℂ),
      0 < Z → 0 < H → H ≤ (d : ℝ) → (d : ℝ) ≤ exp 2*H → |(k : ℝ)| ≤ Z/4 →
      (8/(Z*H)) * sqrt (∑ n ∈ harmonicCommonSupport (Z*H),
        ‖(harmonicCommonCutoff ((n : ℝ)/(Z*H)) : ℂ)*F n‖^2) *
        sqrt (∑ n ∈ harmonicCommonSupport (Z*H),
          ‖(harmonicCommonCutoff (((n+k*(d : ℤ) : ℤ) : ℝ)/(Z*H)) : ℂ)*G (n+k*(d : ℤ))‖^2)
          ≤ L^C →
      harmonicCellTruncationError Z H d k a b F G (L^r) ≤ L^(-D) := by
  filter_upwards [eventually_harmonic_mellin_tail_power hr C D] with L htail
  intro Z H d k a b F G hZ hH hHd hdH hk hmass
  exact (harmonic_cell_sum_mellin_truncation_energy hZ hH hHd hdH hk a b F G (L^r)).trans
    (htail _ (by positivity) hmass)

end Bounty
end

section

/- Exact finite weighted averaging of the common-cell harmonic Mellin representation. -/

open Finset MeasureTheory

namespace Bounty

theorem harmonic_cell_family_integrable {ι : Type*} {Z H : ℝ}
    (hZ : 0 < Z) (hH : 0 < H) (I : Finset ι) (c : ι → ℂ) (d : ι → ℕ)
    (hscale : ∀ i ∈ I, c i ≠ 0 → H ≤ (d i : ℝ) ∧ (d i : ℝ) ≤ Real.exp 2*H)
    (a b : ℝ) (k : ℤ) (F G : ℤ → ℂ) :
    Integrable (fun v : ℝ => harmonicLogFourier v *
      ∑ i ∈ I, c i*physicalPhase (-(a+b+2*Real.pi*v)) (d i)*
        harmonicCellPairing (Z*H) Z a b (2*Real.pi*v) (k*(d i : ℤ)) F G) := by
  have hi : ∀ i ∈ I, Integrable (fun v : ℝ => c i *
      (harmonicLogFourier v*physicalPhase (-(a+b+2*Real.pi*v)) (d i)*
        harmonicCellPairing (Z*H) Z a b (2*Real.pi*v) (k*(d i : ℤ)) F G)) := by
    intro i hi
    by_cases hc : c i = 0
    · simp only [hc,zero_mul]
      exact integrable_zero _ _ _
    · have hd : d i ≠ 0 := by
        have hp : (0 : ℝ) < d i := hH.trans_le (hscale i hi hc).1
        exact_mod_cast hp.ne'
      exact (harmonic_cell_weighted_pairing_integrable (mul_pos hZ hH) hZ.ne' hd
        a b (k*(d i : ℤ)) F G).const_mul (c i)
  apply (integrable_finsetSum I hi).congr
  filter_upwards [] with v
  rw [mul_sum]
  apply sum_congr rfl
  intro i hi
  ring

theorem harmonic_cell_family_sum_eq_mellin {ι : Type*} {Z H : ℝ}
    (hZ : 0 < Z) (hH : 0 < H) (I : Finset ι) (c : ι → ℂ) (d : ι → ℕ)
    (hscale : ∀ i ∈ I, c i ≠ 0 → H ≤ (d i : ℝ) ∧ (d i : ℝ) ≤ Real.exp 2*H)
    {k : ℤ} (hk : |(k : ℝ)| ≤ Z/4) (a b : ℝ) (F G : ℤ → ℂ) :
    (∑ i ∈ I, c i * (physicalPhase (-(a+b)) (d i) *
      ∑ n ∈ harmonicPositiveSupport Z k (d i),
        ((typeIIHarmonicDyadic ((n : ℝ)/(Z*(d i : ℝ))) : ℂ)/(n : ℂ))*
          physicalPhase a n.natAbs*physicalPhase b (n+k*(d i : ℤ)).natAbs*
          star (F n)*G (n+k*(d i : ℤ)))) =
      ((Z*H : ℝ) : ℂ)⁻¹ * ∫ v : ℝ, harmonicLogFourier v *
        ∑ i ∈ I, c i*physicalPhase (-(a+b+2*Real.pi*v)) (d i)*
          harmonicCellPairing (Z*H) Z a b (2*Real.pi*v) (k*(d i : ℤ)) F G := by
  classical
  let f : ι → ℝ → ℂ := fun i v => harmonicLogFourier v *
    (c i*physicalPhase (-(a+b+2*Real.pi*v)) (d i)*
      harmonicCellPairing (Z*H) Z a b (2*Real.pi*v) (k*(d i : ℤ)) F G)
  have hi : ∀ i ∈ I, Integrable (f i) := by
    intro i hi
    have ht := harmonic_cell_family_integrable hZ hH {i} c d (by
      intro j hj hc
      have hj' : j = i := mem_singleton.mp hj
      subst j
      exact hscale i hi hc) a b k F G
    simpa only [sum_singleton] using ht
  calc
    _ = ((Z*H : ℝ) : ℂ)⁻¹ * ∑ i ∈ I, ∫ v : ℝ, f i v := by
      rw [mul_sum]
      apply sum_congr rfl
      intro i hi
      by_cases hc : c i = 0
      · simp only [f,hc,zero_mul,mul_zero,integral_zero]
      · rw [harmonic_cell_sum_eq_mellin hZ hH (hscale i hi hc).1 (hscale i hi hc).2 hk a b F G]
        have hf : f i = fun v : ℝ => c i *
            (harmonicLogFourier v*physicalPhase (-(a+b+2*Real.pi*v)) (d i)*
              harmonicCellPairing (Z*H) Z a b (2*Real.pi*v) (k*(d i : ℤ)) F G) := by
          funext v
          dsimp only [f]
          ring
        rw [hf,integral_const_mul]
        ring
    _ = ((Z*H : ℝ) : ℂ)⁻¹ * ∫ v : ℝ, ∑ i ∈ I, f i v := by
      rw [integral_finsetSum I hi]
    _ = _ := by
      congr 1
      apply integral_congr_ae
      filter_upwards [] with v
      exact (mul_sum ..).symm

end Bounty
end

section

/- Frequency-uniform total Fourier energies for the actual candidate endpoint functions. -/

open Filter Finset Real

namespace Bounty

theorem exists_candidate_harmonic_fourier_energy {c : ℝ} (hc : 0 < c)
    (J ell : ℕ) (Cb Ce : ℝ) :
    ∃ T : ℝ, ∀ᶠ L : ℝ in atTop,
      ∀ (groups : Finset ℕ), groups ⊆ candidatePIndices c L →
      ∀ (cut : groups → Finset (Fin J)) (big : Finset groups) (g : groups) (κ : ℕ),
      ell+(cut g).card = κ+1 → g ∉ big →
      ∀ (b₀ b₁ : GroupMarkedLists (fun j : big => candidatePBand (c*L) j.val.val)
          (fun j : big => ell+(cut j.val).card) → ℂ),
      (∀ l, ‖b₀ l‖ ≤ L^Cb) → (∀ l, ‖b₁ l‖ ≤ L^Cb) →
      ∀ (pool : Finset ℕ), (∀ j : groups, candidatePBand (c*L) j.val ⊆ pool) →
      ∀ (α₀ β₀ γ₀ α₁ β₁ γ₁ : ℕ → ℂ),
      (∀ n, ¬ Disjoint n.primeFactors pool → α₀ n = 0) →
      (∀ n, ¬ Disjoint n.primeFactors pool → β₀ n = 0) →
      (∀ n, ¬ Disjoint n.primeFactors pool → α₁ n = 0) →
      (∀ n, ¬ Disjoint n.primeFactors pool → β₁ n = 0) →
      (∀ n, ‖α₀ n‖ ≤ L^Ce) → (∀ n, ‖β₀ n‖ ≤ L^Ce) → (∀ n, ‖γ₀ n‖ ≤ L^Ce) →
      (∀ n, ‖α₁ n‖ ≤ L^Ce) → (∀ n, ‖β₁ n‖ ≤ L^Ce) → (∀ n, ‖γ₁ n‖ ≤ L^Ce) →
      ∀ Y : ℝ, 1 ≤ Y → log Y ≤ 6*L → ∀ Z a b v : ℝ,
      let P := fun j : groups => candidatePBand (c*L) j.val
      let mass := fun j : groups => ∑ p ∈ P j, 1/(p : ℝ)
      let marks := fun j : groups => ell+(cut j).card
      let F₀ := fun n : ℤ => selectedMarkedEndpoint P (1/2) mass marks big b₀ pool α₀ β₀ γ₀ n.natAbs
      let F₁ := fun n : ℤ => selectedMarkedEndpoint P (1/2) mass marks big b₁ pool α₁ β₁ γ₁ n.natAbs
      let G₀ := fun n : ℤ => selectedPeeledEndpoint P (1/2) mass marks g κ big b₀ pool α₀ β₀ γ₀ n.natAbs
      let G₁ := fun n : ℤ => selectedPeeledEndpoint P (1/2) mass marks g κ big b₁ pool α₁ β₁ γ₁ n.natAbs
      ((1/Y)*sqrt (∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellSource Y Z a v F₀ n‖^2)*
        sqrt (∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellTarget Y b F₁ n‖^2) ≤ L^T) ∧
      ((1/Y)*sqrt (∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellSource Y Z a v G₀ n‖^2)*
        sqrt (∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellTarget Y b G₁ n‖^2) ≤ L^T) := by
  obtain ⟨T,hT⟩ := exists_candidate_harmonic_cutoff_energy hc J ell Cb Ce
  refine ⟨T,?_⟩
  filter_upwards [hT] with L hL
  intro groups hgroups cut big g κ hκ hg b₀ b₁ hb₀ hb₁ pool hpool
    α₀ β₀ γ₀ α₁ β₁ γ₁ hα₀free hβ₀free hα₁free hβ₁free
    hα₀ hβ₀ hγ₀ hα₁ hβ₁ hγ₁ Y hY hlogY Z a b v
  have h := hL groups hgroups cut big g κ hκ hg b₀ b₁ hb₀ hb₁ pool hpool
    α₀ β₀ γ₀ α₁ β₁ γ₁ hα₀free hβ₀free hα₁free hβ₁free
    hα₀ hβ₀ hγ₀ hα₁ hβ₁ hγ₁ Y hY hlogY 0
  dsimp only at h ⊢
  have hY0 : 0 < Y := zero_lt_one.trans_le hY
  constructor
  · apply (harmonic_cell_fourier_energy_le_cutoff hY0 Z a b v _ _).trans
    simpa only [add_zero] using h.1
  · apply (harmonic_cell_fourier_energy_le_cutoff hY0 Z a b v _ _).trans
    simpa only [add_zero] using h.2

end Bounty
end

section

/- Individual candidate selected and peeled source and target energies. -/

open Filter Finset Real

namespace Bounty

theorem exists_candidate_harmonic_single_energy {c : ℝ} (hc : 0 < c)
    (J ell : ℕ) (Cb Ce : ℝ) :
    ∃ T : ℝ, ∀ᶠ L : ℝ in atTop,
      ∀ (groups : Finset ℕ), groups ⊆ candidatePIndices c L →
      ∀ (cut : groups → Finset (Fin J)) (big : Finset groups) (g : groups) (κ : ℕ),
      ell+(cut g).card = κ+1 → g ∉ big →
      ∀ (b₀ : GroupMarkedLists (fun j : big => candidatePBand (c*L) j.val.val)
          (fun j : big => ell+(cut j.val).card) → ℂ),
      (∀ l, ‖b₀ l‖ ≤ L^Cb) →
      ∀ (pool : Finset ℕ), (∀ j : groups, candidatePBand (c*L) j.val ⊆ pool) →
      ∀ (α β γ : ℕ → ℂ),
      (∀ n, ¬ Disjoint n.primeFactors pool → α n = 0) →
      (∀ n, ¬ Disjoint n.primeFactors pool → β n = 0) →
      (∀ n, ‖α n‖ ≤ L^Ce) → (∀ n, ‖β n‖ ≤ L^Ce) → (∀ n, ‖γ n‖ ≤ L^Ce) →
      ∀ Y : ℝ, 1 ≤ Y → log Y ≤ 6*L → ∀ Z a b v : ℝ,
      let P := fun j : groups => candidatePBand (c*L) j.val
      let mass := fun j : groups => ∑ p ∈ P j, 1/(p : ℝ)
      let marks := fun j : groups => ell+(cut j).card
      let F := fun n : ℤ => selectedMarkedEndpoint P (1/2) mass marks big b₀ pool α β γ n.natAbs
      let G := fun n : ℤ => selectedPeeledEndpoint P (1/2) mass marks g κ big b₀ pool α β γ n.natAbs
      ((∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellSource Y Z a v F n‖^2) ≤ Y*L^T ∧
        (∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellTarget Y b F n‖^2) ≤ Y*L^T) ∧
      ((∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellSource Y Z a v G n‖^2) ≤ Y*L^T ∧
        (∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellTarget Y b G n‖^2) ≤ Y*L^T) := by
  obtain ⟨T,hT⟩ := exists_candidate_harmonic_cutoff_energy hc J ell Cb Ce
  refine ⟨T+1,?_⟩
  filter_upwards [hT,eventually_ge_atTop (8:ℝ)] with L hT hL
  intro groups hgroups cut big g κ hκ hg b₀ hb₀ pool hpool α β γ hαfree hβfree
    hα hβ hγ Y hY hlogY Z a b v
  have h := hT groups hgroups cut big g κ hκ hg b₀ b₀ hb₀ hb₀ pool hpool
    α β γ α β γ hαfree hβfree hαfree hβfree hα hβ hγ hα hβ hγ Y hY hlogY 0
  dsimp only at h ⊢
  have hYp : 0 < Y := zero_lt_one.trans_le hY
  constructor
  · apply harmonic_single_energies_of_self_cutoff hYp hL Z a b v
    simpa only [add_zero] using h.1
  · apply harmonic_single_energies_of_self_cutoff hYp hL Z a b v
    simpa only [add_zero] using h.2

