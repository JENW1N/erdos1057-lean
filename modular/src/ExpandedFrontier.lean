        physicalMellinPhase (-2 * Real.pi * u) Y *
          ∑ q ∈ K, f q * harmonicMellinWeight (s + 2 * Real.pi * u) (m q) := by
        rw [mul_sum]
        apply sum_congr rfl
        intro q hq
        rw [mul_assoc, normalized_box_weight_ratio hY (hm q hq)]
        ring
      rw [hs, ← mul_assoc]
      dsimp only [K, f, m]
      simp only [sum_product]
