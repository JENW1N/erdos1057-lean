/- A locally incompatible physical edge has zero raw row on coherent memory. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_bad_common_mark_unshared {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) (L R : PhysicalMarkLists P J ell)
    (hlist : physicalListAdmissible C aux L R)
    (g : G) (s t : PhysicalSlots J ell)
    (he : (L g s).val = (R g t).val)
    (hbad : ¬ ((L g s).val : ℤ) ∣ k * (physicalD C L aux : ℤ)) :
    t ∈ physicalUnsharedSlots (ell := ell) (C g) := by
  rw [physicalUnsharedSlots, mem_compl]
  intro ht
  obtain ⟨j, hj, rfl⟩ := (physical_mem_shared_slots_iff (C g) t).mp ht
  have hs : L g s = L g (Sum.inl j) :=
    (Subtype.ext he).trans (hlist.1 g j hj).symm
  have hd : ((L g (Sum.inl j)).val : ℤ) ∣ (physicalD C L aux : ℤ) := by
    exact_mod_cast physical_shared_label_dvd_D C L aux g j hj
  apply hbad
  rw [hs]
  exact dvd_mul_of_dvd_right hd k

theorem physical_bad_common_mark_target_active {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) (L R : PhysicalMarkLists P J ell)
    (hlist : physicalListAdmissible C aux L R)
    (g : G) (s t : PhysicalSlots J ell)
    (he : (L g s).val = (R g t).val)
    (hbad : ¬ ((L g s).val : ℤ) ∣ k * (physicalD C L aux : ℤ)) :
    ∃ i, physicalGroupUnsharedEmbedding C R g i ∈
      ghostPhaseActivitySupport (physicalGroupPhaseActivity L g) := by
  let t' : physicalUnsharedSlots (ell := ell) (C g) :=
    ⟨t, physical_bad_common_mark_unshared C aux k L R hlist g s t he hbad⟩
  refine ⟨(physicalGroupUnsharedIndex (ell := ell) (C g)).symm t', ?_⟩
  change R g ((physicalGroupUnsharedIndex (ell := ell) (C g))
    ((physicalGroupUnsharedIndex (ell := ell) (C g)).symm t')).val ∈ _
  rw [Equiv.apply_symm_apply, physical_group_phase_activity_support_mem]
  exact (mem_physical_group_marks L g _).mpr ⟨s, he⟩

theorem physical_full_edge_raw_zero_of_bad_common_mark
    {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (C : Fin N → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (k : ℤ) (L R : PhysicalMarkLists P J ell)
    (hlist : physicalListAdmissible C aux L R)
    (β : (g : Fin N) → ↥(P g) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (g : Fin N) (s t : PhysicalSlots J ell)
    (he : (L g s).val = (R g t).val)
    (hbad : ¬ ((L g s).val : ℤ) ∣ k * (physicalD C L aux : ℤ))
    (u : GlobalBirthHistoryState (fun p : ↥(P g) => ZMod p.val))
    (hu : GlobalBirthMemoryCoherent
      (ghostPhaseActivitySupport (physicalGroupPhaseActivity L g)) u.1 u.2)
    (F : GlobalBirthHistoryState (fun p : ↥(P g) => ZMod p.val) → ℂ) :
    physicalFullEdgeRawRow (B := B) C k L R β ρ V aux g F u = 0 := by
  apply global_birth_edge_raw_zero_of_active_target
    (active := ghostPhaseActivitySupport (physicalGroupPhaseActivity L g))
  · exact hu.active_born
  · intro j hj
    exact disjoint_left.mp hu.labels_inactive (mem_image.mpr ⟨j, mem_univ j, rfl⟩) hj
  · exact physical_bad_common_mark_target_active C aux k L R hlist g s t he hbad

end Bounty
end

section

/- A locally incompatible physical displacement has zero normalized capped history. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_capped_history_zero_of_bad
    {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    [∀ g, ∀ p : ↥(P g), NeZero p.val]
    (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
    (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
    (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
    (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
      k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
    (hbad : ¬ ∀ j g s t,
      ((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val =
        ((physicalPermuteLabels (τ j) (L j.succ)) g t).val →
      (((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val : ℤ) ∣
        k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
    (η : PhysicalPrime P → ℕ → ℝ) (β : PhysicalPrime P → ℝ)
    (V : PhysicalPrime P → ℝ) (visitCap edgeCap : ℕ → ℕ) :
    ghostPhaseCappedHistory
      (fun p : PhysicalPrime P => fun j =>
        globalBirthFiniteActivity (physicalGroupBareFiniteActivity L p.1) j p.2)
      (fun p => physicalResidueAbsoluteHit a p.1 p.2)
      η β V visitCap edgeCap n = 0 := by
  push Not at hbad
  obtain ⟨j, g, s, t, he, hn⟩ := hbad
  let p : ↥(P g) := (physicalPermuteLabels (σ j) (L j.castSucc)) g s
  have ha : physicalGroupPhaseActivity (L j.castSucc) g p = true := by
    rw [← physical_group_phase_activity_permute (σ j) (L j.castSucc) g]
    exact (physical_group_phase_activity_iff _ _ _).mpr
      ((mem_physical_group_marks _ _ _).mpr ⟨s, rfl⟩)
  have hb : physicalGroupPhaseActivity (L j.succ) g p = true := by
    rw [← physical_group_phase_activity_permute (τ j) (L j.succ) g]
    exact (physical_group_phase_activity_iff _ _ _).mpr
      ((mem_physical_group_marks _ _ _).mpr ⟨t, he.symm⟩)
  have hh : physicalResidueAbsoluteHit a g p j.val ≠
      physicalResidueAbsoluteHit a g p (j.val + 1) := by
    intro hh
    unfold physicalResidueAbsoluteHit at hh
    rw [show globalBirthFiniteIndex n j.val = j.castSucc from
      global_birth_finite_index_at j.castSucc,
      show globalBirthFiniteIndex n (j.val + 1) = j.succ from
        global_birth_finite_index_at j.succ] at hh
    have hd := (ZMod.intCast_eq_intCast_iff_dvd_sub (a j.castSucc) (a j.succ) p.val).mp
      (neg_injective hh)
    apply hn
    simpa only [hstep j, add_sub_cancel_left] using hd
  apply ghost_phase_capped_history_zero_of_adjacent_hits _ _ _ _ _ _ _ n j.val j.isLt ⟨g, p⟩
  · change globalBirthFiniteActivity (physicalGroupBareFiniteActivity L g) j.castSucc.val p = true
    rw [global_birth_finite_activity_at]
    exact ha
  · change globalBirthFiniteActivity (physicalGroupBareFiniteActivity L g) j.succ.val p = true
    rw [global_birth_finite_activity_at]
    exact hb
  · exact hh

end Bounty
end

section

/- A common positive limiting ratio for the shifted and ordinary sieve products. -/

open Finset Filter
open scoped Topology

namespace Bounty

noncomputable def oddPrimeCorrectionProduct (z : ℝ) : ℝ :=
  ∏ p ∈ (primeBand 0 z).erase 2, (1 - 1 / ((p : ℝ) - 1)^2)

theorem odd_prime_correction_product_bounds (z : ℝ) :
    1/2 ≤ oddPrimeCorrectionProduct z ∧ oddPrimeCorrectionProduct z ≤ 1 := by
  have hp : ∀ p ∈ (primeBand 0 z).erase 2, p.Prime :=
    fun _ hp => small_prime_pool_prime (mem_of_mem_erase hp)
  have ho : ∀ p ∈ (primeBand 0 z).erase 2, p ≠ 2 := fun _ hp => (mem_erase.mp hp).1
  refine ⟨finite_odd_prime_correction_product_lower _ hp ho, ?_⟩
  apply prod_le_one₀
  · intro p hmem
    have hp3 : (3 : ℝ) ≤ p := by exact_mod_cast (show 3 ≤ p by have := (hp p hmem).two_le; have := ho p hmem; omega)
    have hden : (1 : ℝ) ≤ ((p : ℝ)-1)^2 := by nlinarith
    exact sub_nonneg.mpr ((div_le_one (by positivity : (0 : ℝ) < ((p : ℝ)-1)^2)).mpr hden)
  · intro p _
    exact sub_le_self _ (by positivity)

theorem odd_prime_correction_product_antitone : Antitone oddPrimeCorrectionProduct := by
  intro x y hxy
  have hsub : (primeBand 0 x).erase 2 ⊆ (primeBand 0 y).erase 2 := by
    intro p hp
    obtain ⟨hp2, hp⟩ := mem_erase.mp hp
    obtain ⟨hpI, hprime⟩ := mem_filter.mp hp
    exact mem_erase.mpr ⟨hp2, mem_filter.mpr ⟨mem_Ioc.mpr
      ⟨(mem_Ioc.mp hpI).1, (mem_Ioc.mp hpI).2.trans (Nat.floor_mono hxy)⟩, hprime⟩⟩
  apply prod_le_prod_of_subset_of_le_one₀ hsub
  · intro p hp
    have hp3 : (3 : ℝ) ≤ p := by
      have hprime := small_prime_pool_prime (mem_of_mem_erase hp)
      have hp2 := (mem_erase.mp hp).1
      exact_mod_cast (show 3 ≤ p by have := hprime.two_le; omega)
    apply sub_nonneg.mpr
    apply (div_le_one (by nlinarith : (0 : ℝ) < ((p : ℝ)-1)^2)).mpr
    nlinarith
  · intro p _ _
    exact sub_le_self _ (by positivity)

noncomputable def shiftedSieveRatioConstant : ℝ :=
  2 * ⨅ z : ℝ, oddPrimeCorrectionProduct z

theorem shifted_sieve_ratio_constant_bounds :
    1 ≤ shiftedSieveRatioConstant ∧ shiftedSieveRatioConstant ≤ 2 := by
  have hlo : (1/2 : ℝ) ≤ ⨅ z : ℝ, oddPrimeCorrectionProduct z :=
    le_ciInf (fun z => (odd_prime_correction_product_bounds z).1)
  have hbdd : BddBelow (Set.range oddPrimeCorrectionProduct) :=
    ⟨1/2, by rintro _ ⟨z, rfl⟩; exact (odd_prime_correction_product_bounds z).1⟩
  have hhi : (⨅ z : ℝ, oddPrimeCorrectionProduct z) ≤ 1 :=
    (ciInf_le hbdd 0).trans (odd_prime_correction_product_bounds 0).2
  unfold shiftedSieveRatioConstant
  constructor <;> linarith

theorem odd_prime_correction_product_tendsto :
    Tendsto (fun z : ℝ => 2 * oddPrimeCorrectionProduct z) atTop (𝓝 shiftedSieveRatioConstant) := by
  have hbdd : BddBelow (Set.range oddPrimeCorrectionProduct) :=
    ⟨1/2, by rintro _ ⟨z, rfl⟩; exact (odd_prime_correction_product_bounds z).1⟩
  exact (tendsto_atTop_ciInf odd_prime_correction_product_antitone hbdd).const_mul 2

theorem shifted_prime_avoidance_product_factorization {z : ℝ} (hz : 2 ≤ z) :
    shiftedPrimeAvoidanceProduct z =
      2 * (∏ p ∈ primeBand 0 z, (1-1/(p : ℝ))) * oddPrimeCorrectionProduct z := by
  have htwo : 2 ∈ primeBand 0 z :=
    (mem_primeBand_iff (by norm_num) (by linarith) 2).mpr ⟨Nat.prime_two, by norm_num, hz⟩
  have hprod : (∏ p ∈ primeBand 0 z, (1-1/(p : ℝ))) =
      (1/2 : ℝ) * ∏ p ∈ (primeBand 0 z).erase 2, (1-1/(p : ℝ)) := by
    rw [← mul_prod_erase (primeBand 0 z) (fun p : ℕ => (1-1/(p : ℝ))) htwo]
    norm_num
  calc
    shiftedPrimeAvoidanceProduct z =
        (∏ p ∈ (primeBand 0 z).erase 2, (1-1/(p : ℝ))) * oddPrimeCorrectionProduct z := by
      unfold shiftedPrimeAvoidanceProduct oddPrimeCorrectionProduct
      rw [← prod_mul_distrib]
      apply prod_congr rfl
      intro p hp
      have hp1 : (1 : ℝ) < p := by exact_mod_cast (small_prime_pool_prime (mem_of_mem_erase hp)).one_lt
      have hp0 : (p : ℝ) ≠ 0 := by linarith
      have hpred : (p : ℝ)-1 ≠ 0 := by linarith
      field_simp
      ring
    _ = _ := by rw [hprod]; ring

theorem shifted_prime_avoidance_ratio_tendsto :
    Tendsto (fun z : ℝ => shiftedPrimeAvoidanceProduct z /
      (∏ p ∈ primeBand 0 z, (1-1/(p : ℝ)))) atTop (𝓝 shiftedSieveRatioConstant) := by
  apply odd_prime_correction_product_tendsto.congr'
  filter_upwards [eventually_ge_atTop (2 : ℝ)] with z hz
  rw [shifted_prime_avoidance_product_factorization hz]
  have hne : (∏ p ∈ primeBand 0 z, (1-1/(p : ℝ))) ≠ 0 :=
    (finite_prime_avoidance_product_pos _ (fun _ hp => small_prime_pool_prime hp)).ne'
  field_simp

end Bounty
end

section

/- Ordinary rough-integer density upper bounds with the common Mertens constant. -/

open Finset Filter
open scoped Topology

namespace Bounty

theorem exists_ordinary_rough_density_upper :
    ∃ K : ℝ, 0 < K ∧ ∀ (b : ℝ), 0 < b → ∀ h : ℕ, 1 ≤ h → Even h →
      b*(4*(h : ℝ)+2) < 1 → ∀ ε : ℝ, 0 < ε →
      ∀ᶠ L : ℝ in atTop,
        (L/Real.exp L)*((roughBand (Real.exp L) (2*Real.exp L) (Real.exp (b*L))).card : ℝ) ≤
          (Mertens.primeProductLimitConstant/b)*(1+K*Real.exp (-(h : ℝ)))+ε := by
  obtain ⟨K, hK, hsieve⟩ := exists_real_rough_integer_interval_count
  refine ⟨K, hK, ?_⟩
  intro b hb h hh heven hlevel ε hε
  let d := 1-b*(4*(h : ℝ)+2)
  have hd : 0 < d := by dsimp [d]; linarith
  have ht0 : Tendsto (fun L : ℝ => L*Real.exp (-d*L)) atTop (𝓝 0) := by
    simpa only [Real.rpow_one] using tendsto_rpow_mul_exp_neg_mul_atTop_nhds_zero 1 d hd
  have ht := ((exponential_prime_avoidance_product_tendsto hb).mul_const
    (1+K*Real.exp (-(h : ℝ)))).add (ht0.const_mul K)
  simp only [mul_zero, add_zero] at ht
  have hev := ht.eventually_lt_const (show
    (Mertens.primeProductLimitConstant/b)*(1+K*Real.exp (-(h : ℝ))) <
      (Mertens.primeProductLimitConstant/b)*(1+K*Real.exp (-(h : ℝ)))+ε by linarith)
  filter_upwards [hev, eventually_gt_atTop (0 : ℝ)] with L hmajor hL
  let V := ∏ p ∈ primeBand 0 (Real.exp (b*L)), (1-1/(p : ℝ))
  have hbase := hsieve (a := Real.exp L) (b := 2*Real.exp L) (z := Real.exp (b*L))
    (h := h) (Real.exp_pos L).le (by linarith [Real.exp_pos L])
    (Real.one_lt_exp_iff.mpr (mul_pos hb hL)) hh heven
  have hcount : ((roughBand (Real.exp L) (2*Real.exp L) (Real.exp (b*L))).card : ℝ) ≤
      Real.exp L*V+K*(Real.exp L*V*Real.exp (-(h : ℝ))+(Real.exp (b*L))^(4*(h : ℝ)+2)) := by
    change |((roughBand (Real.exp L) (2*Real.exp L) (Real.exp (b*L))).card : ℝ) -
      (2*Real.exp L-Real.exp L)*V| ≤
        K*((2*Real.exp L-Real.exp L)*V*Real.exp (-(h : ℝ))+(Real.exp (b*L))^(4*(h : ℝ)+2)) at hbase
    have hupper := (le_abs_self _).trans hbase
    linarith
  have he : (Real.exp (b*L))^(4*(h : ℝ)+2)/Real.exp L = Real.exp (-d*L) := by
    rw [← Real.exp_mul, ← Real.exp_sub]
    congr 1
    dsimp [d]
    ring
  calc
    _ ≤ (L/Real.exp L)*(Real.exp L*V+K*(Real.exp L*V*Real.exp (-(h : ℝ))+
          (Real.exp (b*L))^(4*(h : ℝ)+2))) :=
      mul_le_mul_of_nonneg_left hcount (by positivity)
    _ = (L*V)*(1+K*Real.exp (-(h : ℝ)))+
        K*(L*((Real.exp (b*L))^(4*(h : ℝ)+2)/Real.exp L)) := by
      field_simp
      ring
    _ = (L*V)*(1+K*Real.exp (-(h : ℝ)))+K*(L*Real.exp (-d*L)) := by rw [he]
    _ ≤ _ := hmajor.le

end Bounty
end

section

/- Original full event rows with local phases, and their exact projected edge. -/

open Finset
namespace Bounty
universe uJ uK uP uA
section Full
variable {J : Type uJ} {K : Type uK} {N : ℕ} {P : Fin N → Type uP}
  [∀ g, Fintype (P g)]
  (n : (g : Fin N) → P g → ℕ) [∀ g p, NeZero (n g p)] {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type uA) [∀ k c, Fintype (A k c)]
  (Δ D : ∀ k c, A k c → Fin N → ℤ)
  (phase : ∀ tag (x : ProductBoundedOrderedState P
    (fun g => UnrestrictedResidueParticle (n g)) M B),
    FullPermutationMixedEvent n S B A Δ D tag x → ℂ)
  (ω : ∀ k c, A k c → ℝ) (μ : (g : Fin N) → P g → ℝ)
  (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

noncomputable def fullPermutationMixedPhasedRow : Option (J ⊕ K) →
    (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ) →
    ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ :=
  let _ : ∀ (tag : Option (J ⊕ K)) x, Fintype (FullPermutationMixedEvent n S B A Δ D tag x) :=
    fullPermutationMixedEventFintype n S B A Δ D
  finiteLocalPhasedRow (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) phase
    (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V)

theorem full_permutation_phased_row_permutation
    (hnone : ∀ x e, phase none x e = 1)
    (F : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ) :
    fullPermutationMixedPhasedRow n S B A Δ D phase ω μ q ρ V none F = fullActiveAverage F := by
  funext x
  unfold fullPermutationMixedPhasedRow finiteLocalPhasedRow
  refine Eq.trans ?_ (Equiv.sum_comp
    (Equiv.ulift : ULift.{max uA uP} (FullActiveSlotPermutations M) ≃ FullActiveSlotPermutations M)
    (fun τ => (fullActivePermutationWeight M τ : ℂ) * F (fullActivePermutation τ x)))
  apply sum_congr
  · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
  · intro e _
    simp only [hnone, mul_one]
    rfl

theorem full_permutation_phased_row_edge (k : K)
    (F : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ) :
    fullPermutationMixedPhasedRow n S B A Δ D phase ω μ q ρ V (some (.inr k)) F =
      fullActiveCoefficientAction n (S k) B (A k) (Δ k) (D k) (ω k) μ ρ V
        (phase (some (.inr k))) F := by
  funext x
  unfold fullPermutationMixedPhasedRow finiteLocalPhasedRow fullActiveCoefficientAction
  apply sum_congr
  · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
  · intro e _
    rfl

theorem full_permutation_phased_three_rows
    (hnone : ∀ x e, phase none x e = 1) (k : K)
    (F : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ) :
    fullPermutationMixedPhasedRow n S B A Δ D phase ω μ q ρ V none
      (fullPermutationMixedPhasedRow n S B A Δ D phase ω μ q ρ V (some (.inr k))
        (fullPermutationMixedPhasedRow n S B A Δ D phase ω μ q ρ V none F)) =
      fullActiveAverage (fullActiveCoefficientAction n (S k) B (A k) (Δ k) (D k)
        (ω k) μ ρ V (phase (some (.inr k))) (fullActiveAverage F)) := by
  rw [full_permutation_phased_row_permutation n S B A Δ D phase ω μ q ρ V hnone,
    full_permutation_phased_row_permutation n S B A Δ D phase ω μ q ρ V hnone,
    full_permutation_phased_row_edge]

theorem full_permutation_phased_rows_eq_paths (steps : List (Option (J ⊕ K)))
    (F : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ) :
    finiteOperatorListAction (fullPermutationMixedPhasedRow n S B A Δ D phase ω μ q ρ V) steps F =
      fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps
        (finiteEventLocalPhase (FullPermutationMixedEvent n S B A Δ D)
          (fullPermutationMixedEventTarget n S B A Δ D) phase steps) F := by
  let _ : ∀ (tag : Option (J ⊕ K)) x, Fintype (FullPermutationMixedEvent n S B A Δ D tag x) :=
    fullPermutationMixedEventFintype n S B A Δ D
  exact finite_phased_rows_eq_event_paths (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) phase
    (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V) steps F

end Full
end Bounty
end

section

/- A one-storage obstruction to prime-size smallness of the positive dirty
remainder. Residues carry counting measure. Storing an active label transfers
its existing label weight to memory, and does not supply an additional small
atom. This does not assert anything about cancellation in a signed family. -/

open Finset
open scoped Classical

namespace Bounty

def unrestrictedEmptyOneState {P : Type*} (n : P → ℕ) (p : P) :
    BoundedOrderedState P (UnrestrictedResidueParticle n) 1 1 :=
  (fun _ => p, ⟨0, Fin.elim0⟩)

noncomputable def unrestrictedOneStoredTest {P : Type*} (n : P → ℕ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) 1 1) : ℂ :=
  if s.2.1.val = 1 ∧ ∀ j, (s.2.2 j).2 = -1 then 1 else 0

noncomputable def unrestrictedOneStorePhase {P : Type*} (n : P → ℕ) :
    UnrestrictedBoundedPhase n 1 1 1 1 :=
  fun _ stores promotions _ _ => if stores = univ ∧ promotions = ∅ then 1 else 0

theorem unrestrictedOneStoredTest_symmetric {P : Type*} (n : P → ℕ) :
    BoundedOrderedSymmetric (unrestrictedOneStoredTest n) := by
  intro active N q τ
  unfold unrestrictedOneStoredTest
  congr 1
  apply propext
  apply and_congr_right
  intro _
  constructor
  · intro h j
    obtain ⟨i, rfl⟩ := τ.surjective j
    exact h i
  · intro h j
    exact h (τ j)

theorem unrestrictedOneStoredTest_empty {P : Type*} (n : P → ℕ) (p : P) :
    unrestrictedOneStoredTest n (unrestrictedEmptyOneState n p) = 0 := by
  simp [unrestrictedOneStoredTest, unrestrictedEmptyOneState]

theorem unrestrictedOneStoredTest_single {P : Type*} (n : P → ℕ)
    (a p : P) :
    unrestrictedOneStoredTest n (fun _ => a, ⟨1, fun _ => ⟨p, -1⟩⟩) = 1 := by
  simp [unrestrictedOneStoredTest]

theorem unrestrictedOneStoredTest_energy {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) :
    (∑ s : BoundedOrderedState P (UnrestrictedResidueParticle n) 1 1,
      boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s *
        ‖unrestrictedOneStoredTest n s‖ ^ 2) = (∑ p, μ p) ^ 2 := by
  simp only [Fintype.sum_prod_type, Fintype.sum_sigma, boundedOrderedStateWeight]
  simp only [unrestrictedOneStoredTest]
  simp only [boundedOrderedMemoryWeight, Fin.prod_univ_one]
  simp
  have hs (a : Fin 1 → P) :
      (∑ q : Fin 1 → UnrestrictedResidueParticle n,
        μ (a 0) * unrestrictedResidueWeight μ (q 0) *
          ‖(if (q 0).2 = -1 then (1 : ℂ) else 0)‖ ^ 2) =
      μ (a 0) * ∑ p, μ p := by
    let e : (Fin 1 → UnrestrictedResidueParticle n) ≃ UnrestrictedResidueParticle n :=
      { toFun := fun q => q 0
        invFun := fun z _ => z
        left_inv := by intro q; funext j; change q 0 = q j; congr 1; exact Subsingleton.elim _ _
        right_inv := by intro z; rfl }
    rw [← e.symm.sum_comp]
    change (∑ z : UnrestrictedResidueParticle n,
      μ (a 0) * μ z.1 * ‖(if z.2 = -1 then (1 : ℂ) else 0)‖ ^ 2) = _
    simp [Fintype.sum_sigma, apply_ite, mul_sum]
    apply sum_congr rfl
    intro p _
    rw [sum_eq_single (-1)]
    · simp only [if_true]
    · intro r _ hr
      exact if_neg hr
    · intro h
      exact (h (mem_univ _)).elim
  simp_rw [hs]
  rw [← sum_mul]
  have ha : (∑ a : Fin 1 → P, μ (a 0)) = ∑ p, μ p :=
    (Equiv.funUnique (Fin 1) P).sum_comp μ
  rw [ha, pow_two]

theorem unrestricted_one_store_output {P : Type*} (n : P → ℕ) (p : P)
    (eligible : Finset (Fin 0)) :
    unrestrictedEdgeOutput (fun _ : Fin 1 => p) (Fin.elim0 : Fin 0 → UnrestrictedResidueParticle n)
      (unrestrictedResidueSeed n) (unrestrictedResidueTransport n 1) univ ∅
      (unrestrictedCleanPromotion 1 eligible) =
        ⟨1, fun _ => ⟨p, -1⟩⟩ := by
  have ht : unrestrictedResidueTransport n 1 ∘
      unrestrictedStoredTuple (fun _ : Fin 1 => p) (unrestrictedResidueSeed n) univ =
      fun _ => (⟨p, -1⟩ : UnrestrictedResidueParticle n) := by
    funext i
    change (⟨p, (0 : ZMod (n p)) - ((1 : ℤ) : ZMod (n p))⟩ : UnrestrictedResidueParticle n) = ⟨p, -1⟩
    simp
  unfold unrestrictedEdgeOutput unrestrictedEdgeMemory
  rw [unrestricted_clean_survivors, ht]
  have he : (univ : Finset (Fin 0)) = ∅ := by ext j; exact Fin.elim0 j
  rw [he]
  unfold retainedBirthTuple
  have hf : Fin.addCases
      (retainedOrderedTuple (unrestrictedResidueTransport n 1 ∘
        (Fin.elim0 : Fin 0 → UnrestrictedResidueParticle n)) (∅ : Finset (Fin 0)))
      (fun _ : Fin (univ : Finset (Fin 1)).card => (⟨p, -1⟩ : UnrestrictedResidueParticle n)) =
      fun _ => (⟨p, -1⟩ : UnrestrictedResidueParticle n) := by
    funext j
    refine Fin.addCases (m := (∅ : Finset (Fin 0)).card)
      (n := (univ : Finset (Fin 1)).card) ?_ ?_ j
    · intro i
      exact Fin.elim0 i
    · intro i
      rw [Fin.addCases_right]
  rw [hf]
  exact congrArg (fun k : ℕ => (⟨k, fun _ => (⟨p, -1⟩ : UnrestrictedResidueParticle n)⟩ :
    FiniteOrderedTuple (UnrestrictedResidueParticle n))) (by simp)

theorem unrestricted_one_store_action_empty {P : Type*} [Fintype P]
    (n : P → ℕ) (hn : ∀ p, 1 < n p) (μ : P → ℝ) (ρ V : ℝ) (p : P) :
    unrestrictedBoundedOperator n 1 1 μ ρ V 1 1 (unrestrictedOneStorePhase n)
      (unrestrictedOneStoredTest n) (unrestrictedEmptyOneState n p) = (∑ a, μ a : ℝ) := by
  have hban : unrestrictedResidueStorageAllowed n 1 (fun _ : Fin 1 => p) univ := by
    intro i _ hd
    have hd' : n p ∣ 1 := by exact_mod_cast hd
    have := Nat.le_of_dvd (by decide : 0 < 1) hd'
    have := hn p
    omega
  have hnz : (-1 : ZMod (n p)) ≠ 0 := by
    intro h
    have hz : (1 : ZMod (n p)) = 0 := neg_eq_zero.mp h
    have := ZMod.one_eq_zero_iff.mp hz
    have := hn p
    omega
  let eligible := unrestrictedResidueEligible n 1 1 (Fin.elim0 : Fin 0 → UnrestrictedResidueParticle n)
  unfold unrestrictedBoundedOperator unrestrictedBoundedAction
  dsimp only [unrestrictedEmptyOneState, unrestrictedOneStorePhase]
  unfold unrestrictedResidueEdgeAction unrestrictedEdgeAction
  simp only [unrestrictedOneStorePhase]
  rw [sum_eq_single univ]
  · rw [sum_eq_single ∅]
    · erw [sum_eq_single (unrestrictedCleanPromotion 1 eligible)]
      · simp only [if_pos hban, and_self, if_true]
        unfold unrestrictedEdgeEventMass
        erw [unrestricted_one_store_output n p eligible]
        simp [orderedPredicateCount, unrestrictedResidueHit, hnz,
          boundedOrderedZeroExtension, unrestrictedOneStoredTest]
        have hm : (∑ fresh : UnrestrictedFreshLabels P (∅ : Finset (Fin 1)),
            unrestrictedFreshWeight μ ∅ fresh) = ∑ a, μ a := by
          simpa using unrestricted_fresh_mass_eq μ (∅ : Finset (Fin 1))
        exact_mod_cast hm
      · intro e _ he
        exact (he (unrestricted_clean_promotion_unique eligible e)).elim
      · intro h
        exact (h (mem_univ _)).elim
    · intro promotions _ hp
      simp only [hp, and_false, if_false, ite_self, mul_zero, zero_mul, sum_const_zero]
    · intro h
      exact (h (mem_univ _)).elim
  · intro stores _ hs
    simp only [hs, false_and, if_false, ite_self, mul_zero, zero_mul, sum_const_zero]
  · intro h
    exact (h (mem_univ _)).elim

theorem unrestrictedOneStorePhase_norm_le_one {P : Type*} (n : P → ℕ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) 1 1)
    (stores promotions : Finset (Fin 1))
    (e : promotions ↪ unrestrictedResidueEligible n 1 1 s.2.2)
    (fresh : UnrestrictedFreshLabels P promotions) :
    ‖unrestrictedOneStorePhase n s stores promotions e fresh‖ ≤ 1 := by
  unfold unrestrictedOneStorePhase
  split_ifs <;> norm_num

theorem unrestrictedOneStorePhase_clean_zero {P : Type*} (n : P → ℕ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) 1 1)
    (e : (∅ : Finset (Fin 1)) ↪ unrestrictedResidueEligible n 1 1 s.2.2)
    (fresh : UnrestrictedFreshLabels P (∅ : Finset (Fin 1))) :
    unrestrictedOneStorePhase n s ∅ ∅ e fresh = 0 := by
  simp [unrestrictedOneStorePhase]

theorem unrestricted_one_store_energy_lower {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (hn : ∀ p, 1 < n p)
    (μ : P → ℝ) (hμ : ∀ p, 0 ≤ μ p) (hmass : ∑ p, μ p = 1) (ρ V : ℝ) :
    1 ≤ finiteWeightedEnergy (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ))
      (unrestrictedBoundedOperator n 1 1 μ ρ V 1 1 (unrestrictedOneStorePhase n)
        (unrestrictedOneStoredTest n)) := by
  have h := unrestricted_empty_one_energy_le n μ hμ 1
    (unrestrictedBoundedOperator n 1 1 μ ρ V 1 1 (unrestrictedOneStorePhase n)
      (unrestrictedOneStoredTest n))
  change (∑ p, μ p * ‖unrestrictedBoundedOperator n 1 1 μ ρ V 1 1 (unrestrictedOneStorePhase n)
    (unrestrictedOneStoredTest n) (unrestrictedEmptyOneState n p)‖ ^ 2) ≤ _ at h
  simpa only [unrestricted_one_store_action_empty n hn μ ρ V, hmass,
    Complex.ofReal_one, norm_one, one_pow, mul_one] using h

/-- No uniform coefficient less than one bounds this storage-only energy
by input energy, regardless of how large all moduli are. -/
theorem unrestricted_one_store_not_small {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (hn : ∀ p, 1 < n p)
    (μ : P → ℝ) (hμ : ∀ p, 0 ≤ μ p) (hmass : ∑ p, μ p = 1)
    (ρ V c : ℝ) (hc : c < 1) :
    ¬ finiteWeightedEnergy (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ))
        (unrestrictedBoundedOperator n 1 1 μ ρ V 1 1 (unrestrictedOneStorePhase n)
          (unrestrictedOneStoredTest n)) ≤
      c * finiteWeightedEnergy (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ))
        (unrestrictedOneStoredTest n) := by
  have hlo := unrestricted_one_store_energy_lower n hn μ hμ hmass ρ V
  have hin : finiteWeightedEnergy (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ))
      (unrestrictedOneStoredTest n) = 1 := by
    change (∑ s, boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s *
      ‖unrestrictedOneStoredTest n s‖ ^ 2) = 1
    rw [unrestrictedOneStoredTest_energy, hmass, one_pow]
  rw [hin, mul_one]
  exact not_le.mpr (hc.trans_le hlo)

end Bounty
end

section

/- A literal average of promotion-containing, globally capped event
operators gains its source-wise eligibility probability. The only rarity
input is a scalar count; every individual operator bound is derived from
the unrestricted event weights. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def unrestrictedPromotionAverage
    {A G : Type*} [Fintype A] [Fintype G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) (Δ D : A → G → ℤ)
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ) (t : G → ℕ) (B : ℕ)
    (π : A → ℝ) (phase : ∀ a, UnrestrictedProductPhase n (Δ a) (D a) t B)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) : ℂ :=
  ∑ a, (π a : ℂ) * unrestrictedCoupledCutoffProductOperator n (Δ a) (D a) μ ρ V t B
    (fun s e => if ∃ g, (e g).2.1.Nonempty then phase a s e else 0) f s

theorem unrestricted_coupled_cutoff_zero_above_cap
    {G : Type*} [Fintype G] {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) (Δ D : G → ℤ) (μ : ∀ g, P g → ℝ)
    (ρ : ℝ) (V : G → ℝ) (t : G → ℕ) (B : ℕ)
    (phase : UnrestrictedProductPhase n Δ D t B)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B)
    (hs : ¬ productTotalMemory s ≤ B) :
    unrestrictedCoupledCutoffProductOperator n Δ D μ ρ V t B phase f s = 0 := by
  simp only [unrestrictedCoupledCutoffProductOperator, productMemoryCutoff, if_neg hs]

theorem unrestricted_promotion_average_energy_le
    {A G : Type*} [Fintype A] [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] (Δ D : A → G → ℤ)
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ) (t : G → ℕ) (B : ℕ)
    (π : A → ℝ) (hπ : ∀ a, 0 ≤ π a) (hπmass : ∑ a, π a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, t g ≤ T)
    (phase : ∀ a, UnrestrictedProductPhase n (Δ a) (D a) t B)
    (hphase : ∀ a s e, ‖phase a s e‖ ≤ 1)
    {δ : ℝ} (hδ : 0 ≤ δ)
    (hrare : ∀ s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B,
      productTotalMemory s ≤ B →
      (∑ a, if ∃ g, (unrestrictedResidueEligible (n g) (Δ a g) (D a g) (s g).2.2).Nonempty
        then π a else 0) ≤ δ)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (unrestrictedPromotionAverage n Δ D μ ρ V t B π phase f) ≤
      δ * unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  let bad : A → ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → Prop :=
    fun a s => productTotalMemory s ≤ B ∧
    ∃ g, (unrestrictedResidueEligible (n g) (Δ a g) (D a g) (s g).2.2).Nonempty
  refine finite_sparse_average_energy_le π hπ hπmass
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productMemoryWeight_nonneg μ (fun g => unrestrictedResidueWeight (μ g)) hμ (fun g z => hμ g z.1))
    bad _ ?_ hδ (pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _) ?_ f ?_
  · intro a s hbad
    by_cases hs : productTotalMemory s ≤ B
    · apply unrestricted_joint_promoting_operator_zero
      intro hg
      exact hbad ⟨hs, hg⟩
    · exact unrestricted_coupled_cutoff_zero_above_cap n (Δ a) (D a) μ ρ V t B _ f s hs
  · intro s
    by_cases hs : productTotalMemory s ≤ B
    · simpa only [bad, hs, true_and] using hrare s hs
    · simpa only [bad, hs, false_and, if_false, sum_const_zero] using hδ
  · intro a
    apply unrestricted_coupled_cutoff_product_energy_le n (Δ a) (D a) μ ρ V t B
      hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht _ _ f hf
    intro s e
    split_ifs
    · exact hphase a s e
    · simp only [norm_zero, zero_le_one]

end Bounty
end

section

/- Sparse averaging can be performed before summing an external finite
coordinate. The per-choice estimate is required only after that sum, so
choice-dependent permutations of the external coordinate cost nothing. -/

open Finset
open scoped Classical

namespace Bounty

theorem finite_sparse_external_average_energy_le
    {A X R : Type*} [Fintype A] [Fintype X] [Fintype R]
    (π : A → ℝ) (hπ : ∀ a, 0 ≤ π a) (hπmass : ∑ a, π a ≤ 1)
    (w : X → ℝ) (hw : ∀ x, 0 ≤ w x)
    (bad : A → X → Prop) (F : A → X → R → ℂ)
    (hzero : ∀ a x r, ¬ bad a x → F a x r = 0)
    {δ K : ℝ} (hδ : 0 ≤ δ) (hK : 0 ≤ K)
    (hmass : ∀ x, (∑ a, if bad a x then π a else 0) ≤ δ)
    (f : X → R → ℂ)
    (hF : ∀ a, (∑ r, finiteWeightedEnergy w (fun x => F a x r)) ≤
      K * ∑ r, finiteWeightedEnergy w (fun x => f x r)) :
    (∑ r, finiteWeightedEnergy w (fun x => ∑ a, (π a : ℂ) * F a x r)) ≤
      δ * K * ∑ r, finiteWeightedEnergy w (fun x => f x r) := by
  have h := finite_sparse_average_energy_le π hπ hπmass
    (fun z : R × X => w z.2) (fun z => hw z.2)
    (fun a z => bad a z.2) (fun a z => F a z.2 z.1)
    (fun a z => hzero a z.2 z.1) hδ hK (fun z => hmass z.2)
    (fun z => f z.2 z.1) (fun a => by
      simpa only [finiteWeightedEnergy, Fintype.sum_prod_type] using hF a)
  simpa only [finiteWeightedEnergy, Fintype.sum_prod_type] using h

end Bounty
end

section

/- A reverse energy estimate transfers through a bilinear identity on a
conjugation-stable class. This is useful for ordered-memory operators whose
adjoint identity is valid on symmetric tests rather than all ordered tests. -/

open Finset Classical

namespace Bounty

theorem finite_weighted_bilinear_cauchy {X : Type*} [Fintype X]
    (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (f g : X → ℂ) :
    ‖∑ x, (μ x : ℂ) * f x * g x‖ ≤
      Real.sqrt (finiteWeightedEnergy μ f) * Real.sqrt (finiteWeightedEnergy μ g) := by
  have h := clean_raw_pairing_norm_le μ hμ (fun _ => 1) (by intro x; simp)
    (fun x => (starRingEnd ℂ) (f x)) g
  simpa only [cleanRawPairing, map_star, star_star, Complex.conj_conj, mul_one,
    finiteWeightedEnergy, Complex.norm_conj] using h

/-- The forward operator must preserve the test class, while the reverse
operator only needs an energy estimate on that class. No matrix identity or
linearity is assumed, and zero measure atoms are allowed. -/
theorem finite_symmetric_transpose_energy_le {X : Type*} [Fintype X]
    (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (S : (X → ℂ) → Prop)
    (A R : (X → ℂ) → X → ℂ)
    (hconj : ∀ f, S f → S (fun x => (starRingEnd ℂ) (f x)))
    (hA : ∀ f, S f → S (A f))
    (hpair : ∀ f g, S f → S g →
      (∑ x, (μ x : ℂ) * f x * A g x) =
        ∑ x, (μ x : ℂ) * R f x * g x)
    {K : ℝ} (hK : 0 ≤ K)
    (hR : ∀ f, S f → finiteWeightedEnergy μ (R f) ≤ K * finiteWeightedEnergy μ f)
    (f : X → ℂ) (hf : S f) :
    finiteWeightedEnergy μ (A f) ≤ K * finiteWeightedEnergy μ f := by
  let g : X → ℂ := fun x => (starRingEnd ℂ) (A f x)
  have hg : S g := hconj (A f) (hA f hf)
  have hgn : finiteWeightedEnergy μ g = finiteWeightedEnergy μ (A f) := by
    simp only [g, finiteWeightedEnergy, Complex.norm_conj]
  have hn : cleanActiveNorm μ (A f) ≤ Real.sqrt K * cleanActiveNorm μ f := by
    apply clean_active_norm_le_of_self_pairing μ hμ (A f)
      (mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _))
    change ‖∑ x, (μ x : ℂ) * g x * A f x‖ ≤ _
    rw [hpair g f hg hf]
    have hc := finite_weighted_bilinear_cauchy μ hμ (R g) f
    have hb := Real.sqrt_le_sqrt (hR g hg)
    rw [hgn, Real.sqrt_mul hK] at hb
    calc
      _ ≤ Real.sqrt (finiteWeightedEnergy μ (R g)) * Real.sqrt (finiteWeightedEnergy μ f) := hc
      _ ≤ (Real.sqrt K * Real.sqrt (finiteWeightedEnergy μ (A f))) *
          Real.sqrt (finiteWeightedEnergy μ f) :=
        mul_le_mul_of_nonneg_right hb (Real.sqrt_nonneg _)
      _ = _ := by change _ = Real.sqrt K * Real.sqrt (finiteWeightedEnergy μ f) * Real.sqrt (finiteWeightedEnergy μ (A f)); ring
  have hnonneg : 0 ≤ finiteWeightedEnergy μ f := sum_nonneg fun x _ =>
    mul_nonneg (hμ x) (sq_nonneg _)
  have hs := (sq_le_sq₀ (Real.sqrt_nonneg (finiteWeightedEnergy μ (A f)))
    (mul_nonneg (Real.sqrt_nonneg K) (Real.sqrt_nonneg (finiteWeightedEnergy μ f)))).mpr hn
  have hAnonneg : 0 ≤ finiteWeightedEnergy μ (A f) := sum_nonneg fun x _ =>
    mul_nonneg (hμ x) (sq_nonneg _)
  rw [mul_pow, Real.sq_sqrt hK, Real.sq_sqrt hnonneg, Real.sq_sqrt hAnonneg] at hs
  exact hs

/-- Multiplication by the same endpoint gate on the two sides preserves a
bilinear identity. This includes both total-memory cutoffs. -/
theorem finite_bilinear_pairing_cutoffs {X : Type*} [Fintype X]
    (μ : X → ℝ) (A R : (X → ℂ) → X → ℂ) (c d : X → ℂ) (f g : X → ℂ)
    (hpair : (∑ x, (μ x : ℂ) * (c x * f x) * A (fun y => d y * g y) x) =
      ∑ x, (μ x : ℂ) * R (fun y => c y * f y) x * (d x * g x)) :
    (∑ x, (μ x : ℂ) * f x * (c x * A (fun y => d y * g y) x)) =
      ∑ x, (μ x : ℂ) * (d x * R (fun y => c y * f y) x) * g x := by
  calc
    _ = ∑ x, (μ x : ℂ) * (c x * f x) * A (fun y => d y * g y) x := by
      apply sum_congr rfl; intro x hx; ring
    _ = _ := hpair
    _ = _ := by apply sum_congr rfl; intro x hx; ring

end Bounty
end

section

/- Exact small-source permutation insertion in the full active average.
The conjugation works on arbitrary ordered labels, including repeated big
labels. It changes no pending memory and fixes every group outside `small`.
No equivariance of the intervening physical operator is required. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def physicalSmallFullPermutationEquiv {G : Type*} {J ell : ℕ}
    (C : G → Finset (Fin J)) (small : Finset G) :
    (↥small → Equiv.Perm (PhysicalSlots J ell)) ≃
      FullActiveGroupPermutations (fun _ : G => J + ell) small :=
  physicalFullPermutationEquiv (fun g : small => C g.val)

theorem physicalSmallFullPermutationEquiv_extend {G : Type*} {J ell : ℕ}
    (C : G → Finset (Fin J)) (small : Finset G)
    (σ : ↥small → Equiv.Perm (PhysicalSlots J ell)) :
    fullActiveExtendGroupPermutation small (physicalSmallFullPermutationEquiv C small σ) =
      physicalFullPermutationEquiv C (physicalExtendSmallPermutations small σ) := by
  funext g
  apply Equiv.ext
  intro i
  by_cases hg : g ∈ small
  · simp only [fullActiveExtendGroupPermutation, dif_pos hg,
      physicalSmallFullPermutationEquiv, physicalFullPermutationEquiv,
      Equiv.coe_fn_mk, Equiv.trans_apply, physicalExtendSmallPermutations]
  · simp only [fullActiveExtendGroupPermutation, dif_neg hg, Equiv.refl_apply,
      physicalFullPermutationEquiv, Equiv.coe_fn_mk, Equiv.trans_apply,
      physicalExtendSmallPermutations]
    exact (Equiv.symm_apply_apply (physicalFullSlotIndex (C g)) i).symm

theorem physical_full_repeated_labels_permute {G : Type*} {J ell B : ℕ}
    {P Z : G → Type*} (C : G → Finset (Fin J))
    (x : ProductBoundedOrderedState P Z (fun _ : G => J + ell) B)
    (σ : PhysicalPermutations G J ell) (g : G) (s : PhysicalSlots J ell) :
    (fullActivePermutation (physicalFullPermutationEquiv C σ) x g).1
        ((physicalFullSlotIndex (C g)).symm s) =
      (x g).1 ((physicalFullSlotIndex (C g)).symm (σ g s)) := by
  change (x g).1 ((physicalFullSlotIndex (C g)).symm
    (σ g (physicalFullSlotIndex (C g) ((physicalFullSlotIndex (C g)).symm s)))) = _
  rw [Equiv.apply_symm_apply]

noncomputable def physicalSmallSourceAverage {G : Type*} [Fintype G]
    {J ell B : ℕ} {P Z : G → Type*}
    (C : G → Finset (Fin J)) (small : Finset G)
    (f : ProductBoundedOrderedState P Z (fun _ : G => J + ell) B → ℂ)
    (x : ProductBoundedOrderedState P Z (fun _ : G => J + ell) B) : ℂ :=
  (Fintype.card (↥small → Equiv.Perm (PhysicalSlots J ell)) : ℂ)⁻¹ *
    ∑ σ : ↥small → Equiv.Perm (PhysicalSlots J ell),
      f (fullActivePermutation
        (physicalFullPermutationEquiv C (physicalExtendSmallPermutations small σ)) x)

theorem physicalSmallSourceAverage_eq {G : Type*} [Fintype G]
    {J ell B : ℕ} {P Z : G → Type*}
    (C : G → Finset (Fin J)) (small : Finset G)
    (f : ProductBoundedOrderedState P Z (fun _ : G => J + ell) B → ℂ) :
    physicalSmallSourceAverage C small f = fullActiveGroupAverage small f := by
  funext x
  unfold physicalSmallSourceAverage fullActiveGroupAverage
  rw [Fintype.card_congr (physicalSmallFullPermutationEquiv C small)]
  congr 1
  rw [← (physicalSmallFullPermutationEquiv C small).sum_comp
    (fun σ => f (fullActivePermutation (fullActiveExtendGroupPermutation small σ) x))]
  apply sum_congr rfl
  intro σ _
  rw [physicalSmallFullPermutationEquiv_extend]

theorem fullActiveAverage_physical_small_source_insertion
    {G : Type*} [Fintype G] [DecidableEq G]
    {J ell B : ℕ} {P Z : G → Type*}
    (C : G → Finset (Fin J)) (small : Finset G)
    (F : ProductBoundedOrderedState P Z (fun _ : G => J + ell) B → ℂ) :
    fullActiveAverage F = fullActiveAverage (physicalSmallSourceAverage C small F) := by
  rw [physicalSmallSourceAverage_eq, fullActiveAverage_fullActiveGroupAverage]

theorem fullActiveAverage_physical_small_operator_insertion
    {G : Type*} [Fintype G] [DecidableEq G]
    {J ell B : ℕ} {P Z : G → Type*}
    (C : G → Finset (Fin J)) (small : Finset G)
    (T : (ProductBoundedOrderedState P Z (fun _ : G => J + ell) B → ℂ) →
      ProductBoundedOrderedState P Z (fun _ : G => J + ell) B → ℂ)
    (f : ProductBoundedOrderedState P Z (fun _ : G => J + ell) B → ℂ) :
    fullActiveAverage (T (fullActiveAverage f)) =
      fullActiveAverage (physicalSmallSourceAverage C small
        (T (physicalSmallSourceAverage C small (fullActiveAverage f)))) := by
  simp only [physicalSmallSourceAverage_eq]
  exact fullActiveAverage_group_source_insertion small T f

theorem physical_small_source_permutation_outside
    {G : Type*} {J ell B : ℕ} {P Z : G → Type*}
    (C : G → Finset (Fin J)) (small : Finset G)
    (σ : ↥small → Equiv.Perm (PhysicalSlots J ell))
    (x : ProductBoundedOrderedState P Z (fun _ : G => J + ell) B)
    (g : G) (hg : g ∉ small) :
    fullActivePermutation
      (physicalFullPermutationEquiv C (physicalExtendSmallPermutations small σ)) x g = x g := by
  rw [← physicalSmallFullPermutationEquiv_extend]
  exact fullActiveExtendGroupPermutation_outside small _ x g hg

/-- The auxiliary sum remains inside each source permutation. Its law is
unchanged, so sparsity may be tested on the joint pair of choices. -/
theorem fullActiveAverage_physical_small_auxiliary_insertion
    {G A : Type*} [Fintype G] [DecidableEq G] [Fintype A]
    {J ell B : ℕ} {P Z : G → Type*}
    (C : G → Finset (Fin J)) (small : Finset G) (ω : A → ℝ)
    (F : A → ProductBoundedOrderedState P Z (fun _ : G => J + ell) B → ℂ) :
    fullActiveAverage (fun x => ∑ a, (ω a : ℂ) * F a x) =
      fullActiveAverage (fun x =>
        (Fintype.card (↥small → Equiv.Perm (PhysicalSlots J ell)) : ℂ)⁻¹ *
          ∑ σ : ↥small → Equiv.Perm (PhysicalSlots J ell), ∑ a,
            (ω a : ℂ) * F a (fullActivePermutation
              (physicalFullPermutationEquiv C (physicalExtendSmallPermutations small σ)) x)) := by
  rename_i dG _
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  exact fullActiveAverage_physical_small_source_insertion C small _

end Bounty
end

section

/- Actual old-index promotion eligibility under independent small-group
source permutations. The pending memory and active big labels may repeat.
The sign is the moving-frame convention Δ = -kD. -/

open Finset Filter
open scoped Classical Topology

namespace Bounty

abbrev PromotionOldIndex {G : Type*} {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (state : ProductBoundedOrderedState P Z t B) :=
  Σ g, Fin (state g).2.1.val

theorem promotion_old_index_card {G : Type*} [Fintype G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (state : ProductBoundedOrderedState P Z t B) :
    Fintype.card (PromotionOldIndex state) = productTotalMemory state := by
  simp only [PromotionOldIndex, Fintype.card_sigma, Fintype.card_fin, productTotalMemory]

theorem small_source_pending_eligible_fraction_le {S G : Type*}
    [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {P : G → Type*} {J ell B : ℕ} {t : G → ℕ}
    (labels : PhysicalMarkLists Ps J ell)
    (hP : ∀ g p, p ∈ Ps g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (Ps g) (Ps h)))
    (n : ∀ g, P g → ℕ) (state : ProductBoundedOrderedState P
      (fun g => UnrestrictedResidueParticle (n g)) t B)
    (D_B : ℕ) (k : ℤ)
    (hp : ∀ g j, (n g ((state g).2.2 j).1).Prime)
    (hk : ∀ g j, ¬ (n g ((state g).2.2 j).1 : ℤ) ∣ k)
    (hlt : ∀ g j, ∀ A : PrimeOmissionChoices (physicalGroupMarks labels) ell,
      primeOmissionProduct (physicalGroupMarks labels) ell A < n g ((state g).2.2 j).1) :
    letI : DecidableEq S := Classical.decEq _
    letI : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
    ((univ.filter (fun σ : S → Equiv.Perm (PhysicalSlots J ell) =>
        ∃ g, (unrestrictedResidueEligible (n g)
          (-(k * (smallSourcePermutationDilation labels D_B σ : ℤ)))
          (smallSourcePermutationDilation labels D_B σ) (state g).2.2).Nonempty)).card : ℝ) /
        (Fintype.card (S → Equiv.Perm (PhysicalSlots J ell)) : ℝ) ≤
      (productTotalMemory state : ℝ) / (((J + ell).choose ell) ^ Fintype.card S : ℕ) := by
  let _ : DecidableEq S := Classical.decEq _
  let _ : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
  let p : PromotionOldIndex state → ℕ := fun z => n z.1 ((state z.1).2.2 z.2).1
  let r : ∀ z : PromotionOldIndex state, ZMod (p z) := fun z => ((state z.1).2.2 z.2).2
  have h := small_source_permutation_eligible_fraction_le labels hP hdis D_B
    (univ : Finset (PromotionOldIndex state)) p (fun z => hp z.1 z.2) r k
    (fun z _ => hk z.1 z.2) (fun z _ A => hlt z.1 z.2 A)
  have he (σ : S → Equiv.Perm (PhysicalSlots J ell)) :
      (∃ z ∈ (univ : Finset (PromotionOldIndex state)),
        ¬ p z ∣ smallSourcePermutationDilation labels D_B σ ∧
          r z + (k : ZMod (p z)) *
            (smallSourcePermutationDilation labels D_B σ : ZMod (p z)) = 0) ↔
      ∃ g, (unrestrictedResidueEligible (n g)
        (-(k * (smallSourcePermutationDilation labels D_B σ : ℤ)))
        (smallSourcePermutationDilation labels D_B σ) (state g).2.2).Nonempty := by
    simp only [mem_univ, true_and, PromotionOldIndex, Sigma.exists,
      unrestricted_eligible_physical_congruence, p, r]
  simp only [he, card_univ, promotion_old_index_card] at h
  exact h

theorem eventually_candidate_pending_eligible_fraction_le {s : ℝ} (hs : 0 < s)
    (ell : ℕ) (C₂ : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ J B : ℕ,
      ∀ labels : PhysicalMarkLists
        (fun g : ↥(candidateSmallPIndices s L) => candidatePBand (s * L) g.val) J ell,
      ∀ D_B : ℕ, ∀ k : ℤ, k ≠ 0 → (k.natAbs : ℝ) ≤ L ^ C₂ →
      ∀ t : ↥(candidateBigPIndices s L) → ℕ,
      ∀ state : ProductBoundedOrderedState
        (fun g : ↥(candidateBigPIndices s L) => ↥(candidatePBand (s * L) g.val))
        (fun g => UnrestrictedResidueParticle (fun p : ↥(candidatePBand (s * L) g.val) => p.val)) t B,
      productTotalMemory state ≤ B →
      letI : DecidableEq ↥(candidateSmallPIndices s L) := Classical.decEq _
      letI : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
      ((univ.filter (fun σ : ↥(candidateSmallPIndices s L) → Equiv.Perm (PhysicalSlots J ell) =>
          ∃ g : ↥(candidateBigPIndices s L), (unrestrictedResidueEligible
            (fun p : ↥(candidatePBand (s * L) g.val) => p.val)
            (-(k * (smallSourcePermutationDilation labels D_B σ : ℤ)))
            (smallSourcePermutationDilation labels D_B σ) (state g).2.2).Nonempty)).card : ℝ) /
          (Fintype.card (↥(candidateSmallPIndices s L) → Equiv.Perm (PhysicalSlots J ell)) : ℝ) ≤
        (B : ℝ) / (((J + ell).choose ell) ^ (candidateSmallPIndices s L).card : ℕ) := by
  filter_upwards [eventually_candidate_omission_bounds hs ell C₂,
    eventually_candidate_small_source_omission_arithmetic hs ell C₂] with L hL harith
  intro J B labels D_B k hk hkbound t state hB
  let _ : DecidableEq ↥(candidateSmallPIndices s L) := Classical.decEq _
  let _ : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
  have hP : ∀ (g : ↥(candidateSmallPIndices s L)) q, q ∈ candidatePBand (s * L) g.val → q.Prime := by
    intro g q hq
    exact hL.2.2.2.2.1 g.val (mem_union_left _ g.property) q hq
  have hdis : Pairwise (fun g h : ↥(candidateSmallPIndices s L) =>
      Disjoint (candidatePBand (s * L) g.val) (candidatePBand (s * L) h.val)) := by
    intro g h hne
    exact hL.2.2.2.2.2 (fun he => hne (Subtype.ext he))
  have hmem (g : ↥(candidateBigPIndices s L)) (j : Fin (state g).2.1.val) :
      (((state g).2.2 j).1).val ∈
        (candidateBigPIndices s L).biUnion (candidatePBand (s * L)) :=
    mem_biUnion.mpr ⟨g.val, g.property, (((state g).2.2 j).1).property⟩
  have h := small_source_pending_eligible_fraction_le labels hP hdis
    (fun (g : ↥(candidateBigPIndices s L)) (p : ↥(candidatePBand (s * L) g.val)) => p.val) state D_B k
    (fun g j => (hL.2.2.2.1 g.val g.property _ (((state g).2.2 j).1).property).1)
    (fun g j => (harith J labels _ (hmem g j) k hk hkbound).1)
    (fun g j A => (harith J labels _ (hmem g j) k hk hkbound).2 A)
  rw [Fintype.card_coe] at h
  exact h.trans (div_le_div_of_nonneg_right (Nat.cast_le.mpr hB) (Nat.cast_nonneg _))

theorem uniform_indicator_probability_eq {A : Type*} [Fintype A] (R : A → Prop) :
    (∑ a, if R a then 1 / (Fintype.card A : ℝ) else 0) =
      ((univ.filter R).card : ℝ) / (Fintype.card A : ℝ) := by
  calc
    _ = (∑ a, if R a then (1 : ℝ) else 0) / (Fintype.card A : ℝ) := by
      rw [sum_div]
      apply sum_congr rfl
      intro a _
      split_ifs <;> simp
    _ = _ := by rw [sum_boole]

theorem eventually_candidate_pending_eligibility_probability_le {s : ℝ} (hs : 0 < s)
    (ell : ℕ) (C₂ : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ J B : ℕ,
      ∀ labels : PhysicalMarkLists
        (fun g : ↥(candidateSmallPIndices s L) => candidatePBand (s * L) g.val) J ell,
      ∀ D_B : ℕ, ∀ k : ℤ, k ≠ 0 → (k.natAbs : ℝ) ≤ L ^ C₂ →
      ∀ t : ↥(candidateBigPIndices s L) → ℕ,
      ∀ state : ProductBoundedOrderedState
        (fun g : ↥(candidateBigPIndices s L) => ↥(candidatePBand (s * L) g.val))
        (fun g => UnrestrictedResidueParticle (fun p : ↥(candidatePBand (s * L) g.val) => p.val)) t B,
      productTotalMemory state ≤ B →
      letI : DecidableEq ↥(candidateSmallPIndices s L) := Classical.decEq _
      letI : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
      (∑ σ : ↥(candidateSmallPIndices s L) → Equiv.Perm (PhysicalSlots J ell),
        if ∃ g : ↥(candidateBigPIndices s L), (unrestrictedResidueEligible
          (fun p : ↥(candidatePBand (s * L) g.val) => p.val)
          (-(k * (smallSourcePermutationDilation labels D_B σ : ℤ)))
          (smallSourcePermutationDilation labels D_B σ) (state g).2.2).Nonempty
        then 1 / (Fintype.card (↥(candidateSmallPIndices s L) → Equiv.Perm (PhysicalSlots J ell)) : ℝ)
        else 0) ≤ (B : ℝ) / (((J + ell).choose ell) ^ (candidateSmallPIndices s L).card : ℕ) := by
  filter_upwards [eventually_candidate_pending_eligible_fraction_le hs ell C₂] with L hL
  intro J B labels D_B k hk hkbound t state hB
  let _ : DecidableEq ↥(candidateSmallPIndices s L) := Classical.decEq _
  let _ : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
  let R := fun σ : ↥(candidateSmallPIndices s L) → Equiv.Perm (PhysicalSlots J ell) =>
    ∃ g : ↥(candidateBigPIndices s L), (unrestrictedResidueEligible
      (fun p : ↥(candidatePBand (s * L) g.val) => p.val)
      (-(k * (smallSourcePermutationDilation labels D_B σ : ℤ)))
      (smallSourcePermutationDilation labels D_B σ) (state g).2.2).Nonempty
  have he := uniform_indicator_probability_eq R
  have hh := hL J B labels D_B k hk hkbound t state hB
  apply le_trans _ hh
  exact le_of_eq (by
    convert he using 1
    · apply sum_congr rfl
      intro σ _
      split_ifs <;> rfl
    · apply congrArg (fun F : Finset (↥(candidateSmallPIndices s L) → Equiv.Perm (PhysicalSlots J ell)) =>
        (F.card : ℝ) / (Fintype.card (↥(candidateSmallPIndices s L) → Equiv.Perm (PhysicalSlots J ell)) : ℝ))
      ext σ
      simp only [mem_filter]
      rfl)

end Bounty
end

section

/- Exact product adjoints of real active-subset masks. The reverse has the
same product memory law and the mandatory local volume ratio. Both endpoint
total-memory cutoffs are retained. -/

open Finset Classical

namespace Bounty

section

variable {G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  (Δ D : G → ℤ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (t : G → ℕ) (B : ℕ)

noncomputable def unrestrictedRealSlotLocals
    (w : ∀ g, Finset (Fin (t g)) → Finset (Fin (t g)) → ℝ) :=
  fun g => unrestrictedSlotOperator (n g) (Δ g) (D g) (μ g) ρ (V g) (t g) B
    (fun S T => (w g S T : ℂ))

noncomputable def unrestrictedRealSlotProduct
    (w : ∀ g, Finset (Fin (t g)) → Finset (Fin (t g)) → ℝ) :=
  finiteCoordinateFinsetAction (unrestrictedRealSlotLocals n Δ D μ ρ V t B w) univ

omit [Fintype G] [DecidableEq G] [∀ g p, NeZero (n g p)] in
theorem unrestricted_real_slot_locals_event
    (w : ∀ g, Finset (Fin (t g)) → Finset (Fin (t g)) → ℝ) :
    unrestrictedRealSlotLocals n Δ D μ ρ V t B w =
      finiteLocalEventAction
        (fun g => UnrestrictedBoundedEvent (n g) (Δ g) (D g) (t g) B)
        (fun g s e => unrestrictedBoundedEventWeight (n g) (Δ g) (D g) (μ g) ρ
          (V g) (t g) B s e * w g e.1 e.2.1)
        (fun g => unrestrictedBoundedEventTarget (n g) (Δ g) (D g) (t g) B) := by
  funext g f s
  unfold unrestrictedRealSlotLocals unrestrictedSlotOperator
  rw [unrestricted_bounded_operator_eq_event_sum]
  simp only [finiteLocalEventAction, Complex.ofReal_mul]

theorem unrestricted_real_slot_product_eq_coupled
    (w : ∀ g, Finset (Fin (t g)) → Finset (Fin (t g)) → ℝ)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ) :
    unrestrictedRealSlotProduct n Δ D μ ρ V t B w f =
      unrestrictedCoupledProductOperator n Δ D μ ρ V t B
        (fun _ e => ((∏ g, w g (e g).1 (e g).2.1 : ℝ) : ℂ)) f := by
  unfold unrestrictedRealSlotProduct
  rw [unrestricted_real_slot_locals_event]
  rw [← finite_product_event_eq_coordinate_action]
  funext s
  simp only [finiteProductEventAction, unrestrictedCoupledProductOperator,
    prod_mul_distrib, Complex.ofReal_mul, mul_one]

theorem unrestricted_real_slot_product_symmetric
    (w : ∀ g, Finset (Fin (t g)) → Finset (Fin (t g)) → ℝ)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric (unrestrictedRealSlotProduct n Δ D μ ρ V t B w f) := by
  exact product_memory_finset_symmetric _
    (fun i q hq => unrestricted_slot_operator_symmetric (n i) (Δ i) (D i) (μ i)
      ρ (V i) (t i) B (fun S T => (w i S T : ℂ)) q hq) univ f hf

/-- All group transposes are taken against the actual product factorial law. -/
theorem unrestricted_real_slot_product_pairing
    (hV : ∀ g, V g ≠ 0)
    (w : ∀ g, Finset (Fin (t g)) → Finset (Fin (t g)) → ℝ)
    (f g : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) (hg : ProductMemorySymmetric g) :
    (∑ s, (productMemoryWeight μ (fun j => unrestrictedResidueWeight (μ j)) s : ℂ) *
      f s * unrestrictedRealSlotProduct n Δ D μ ρ V t B w g s) =
    ∑ s, (productMemoryWeight μ (fun j => unrestrictedResidueWeight (μ j)) s : ℂ) *
      unrestrictedRealSlotProduct n (fun j => -Δ j) D μ ρ V t B
        (fun j S T => V j ^ T.card / V j ^ S.card * w j T S) f s * g s := by
  let A := unrestrictedRealSlotLocals n Δ D μ ρ V t B w
  let R := unrestrictedRealSlotLocals n (fun j => -Δ j) D μ ρ V t B
    (fun j S T => V j ^ T.card / V j ^ S.card * w j T S)
  have hA : ∀ i q, BoundedOrderedSymmetric q → BoundedOrderedSymmetric (A i q) := by
    intro i q hq
    exact unrestricted_slot_operator_symmetric (n i) (Δ i) (D i) (μ i) ρ (V i) (t i) B _ q hq
  have hR : ∀ i q, BoundedOrderedSymmetric q → BoundedOrderedSymmetric (R i q) := by
    intro i q hq
    exact unrestricted_slot_operator_symmetric (n i) (-Δ i) (D i) (μ i) ρ (V i) (t i) B _ q hq
  have hp : ∀ i q r, BoundedOrderedSymmetric q → BoundedOrderedSymmetric r →
      (∑ s, (boundedOrderedStateWeight (μ i) (unrestrictedResidueWeight (μ i)) s : ℂ) *
        q s * A i r s) =
      ∑ s, (boundedOrderedStateWeight (μ i) (unrestrictedResidueWeight (μ i)) s : ℂ) *
        R i q s * r s := by
    intro i q r hq hr
    simpa only [A, R, unrestrictedRealSlotLocals, Complex.ofReal_mul] using
      unrestricted_slot_operator_pairing_reverse (n i) (Δ i) (D i) (μ i) ρ (hV i)
        (t i) B (fun S T => (w i S T : ℂ)) q r hq hr
  have he := product_memory_compose_pairing_reverse μ (fun j => unrestrictedResidueWeight (μ j))
    A R hA hR hp (univ : Finset G).toList f g hf hg
  have horder : finiteCoordinateCompose R (univ : Finset G).toList.reverse f =
      finiteCoordinateCompose R (univ : Finset G).toList f := by
    unfold R
    rw [unrestricted_real_slot_locals_event]
    exact finite_local_event_compose_reverse _ _ _ _ (univ : Finset G).nodup_toList f
  rw [horder] at he
  exact he

/-- Total cutoffs multiply the two paired tests; transposition keeps both. -/
theorem unrestricted_real_slot_cutoff_pairing
    (hV : ∀ g, V g ≠ 0)
    (w : ∀ g, Finset (Fin (t g)) → Finset (Fin (t g)) → ℝ)
    (f g : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) (hg : ProductMemorySymmetric g) :
    (∑ s, (productMemoryWeight μ (fun j => unrestrictedResidueWeight (μ j)) s : ℂ) *
      f s * productMemoryCutoff
        (unrestrictedRealSlotProduct n Δ D μ ρ V t B w (productMemoryCutoff g)) s) =
    ∑ s, (productMemoryWeight μ (fun j => unrestrictedResidueWeight (μ j)) s : ℂ) *
      productMemoryCutoff (unrestrictedRealSlotProduct n (fun j => -Δ j) D μ ρ V t B
        (fun j S T => V j ^ T.card / V j ^ S.card * w j T S) (productMemoryCutoff f)) s * g s := by
  have he := unrestricted_real_slot_product_pairing n Δ D μ ρ V t B hV w
    (productMemoryCutoff f) (productMemoryCutoff g)
    (productMemoryCutoff_symmetric f hf) (productMemoryCutoff_symmetric g hg)
  convert he using 1 <;> apply sum_congr rfl <;> intro s hs <;>
    unfold productMemoryCutoff <;> split_ifs <;> simp

end

end Bounty
end

section

/- The exact small-active injectivity projection. It changes no pending
memory and imposes no empty-memory condition on any group. -/

open Finset
open scoped Classical

namespace Bounty

def SmallActiveInjective {G : Type*} {P Z : G → Type*} {M : G → ℕ} {B : ℕ}
    (small : Finset G) (x : ProductBoundedOrderedState P Z M B) : Prop :=
  ∀ g ∈ small, Function.Injective (x g).1

noncomputable def smallActiveInjectiveGate {G : Type*} {P Z : G → Type*}
    {M : G → ℕ} {B : ℕ} (small : Finset G)
    (f : ProductBoundedOrderedState P Z M B → ℂ)
    (x : ProductBoundedOrderedState P Z M B) : ℂ :=
  if SmallActiveInjective small x then f x else 0

theorem small_active_injective_of_full {G : Type*} {P Z : G → Type*}
    {M : G → ℕ} {B : ℕ} (small : Finset G)
    (x : ProductBoundedOrderedState P Z M B) (hx : FullActiveInjective x) :
    SmallActiveInjective small x := fun g _ => hx g

theorem small_active_injective_permutation {G : Type*} {P Z : G → Type*}
    {M : G → ℕ} {B : ℕ} (small : Finset G) (τ : FullActiveSlotPermutations M)
    (x : ProductBoundedOrderedState P Z M B) :
    SmallActiveInjective small (fullActivePermutation τ x) ↔ SmallActiveInjective small x := by
  constructor
  · intro h g hg i j hij
    have he : (τ g).symm i = (τ g).symm j := h g hg (by
      change (x g).1 (τ g ((τ g).symm i)) = (x g).1 (τ g ((τ g).symm j))
      simpa only [Equiv.apply_symm_apply] using hij)
    exact (τ g).symm.injective he
  · intro h g hg i j hij
    exact (τ g).injective (h g hg hij)

theorem small_active_injective_memory_permutation {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ} (small : Finset G)
    (x : ProductBoundedOrderedState P Z M B) (g : G)
    (τ : Equiv.Perm (Fin (x g).2.1.val)) :
    SmallActiveInjective small (productMemoryPermuteAt x g τ) ↔ SmallActiveInjective small x := by
  have he (j : G) : (productMemoryPermuteAt x g τ j).1 = (x j).1 := by
    by_cases hj : j = g
    · subst j
      simp only [productMemoryPermuteAt, Function.update_self]
    · simp only [productMemoryPermuteAt, Function.update_of_ne hj]
  simp only [SmallActiveInjective, he]

theorem small_active_injective_gate_norm_le {G : Type*} {P Z : G → Type*}
    {M : G → ℕ} {B : ℕ} (small : Finset G)
    (f : ProductBoundedOrderedState P Z M B → ℂ)
    (x : ProductBoundedOrderedState P Z M B) :
    ‖smallActiveInjectiveGate small f x‖ ≤ ‖f x‖ := by
  unfold smallActiveInjectiveGate
  split_ifs
  · exact le_rfl
  · simpa only [norm_zero] using norm_nonneg (f x)

theorem small_active_injective_gate_energy_le {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    {M : G → ℕ} {B : ℕ} (small : Finset G)
    (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hν : ∀ g z, 0 ≤ ν g z)
    (f : ProductBoundedOrderedState P Z M B → ℂ) :
    finiteWeightedEnergy (productMemoryWeight μ ν) (smallActiveInjectiveGate small f) ≤
      finiteWeightedEnergy (productMemoryWeight μ ν) f := by
  apply sum_le_sum
  intro x _
  exact mul_le_mul_of_nonneg_left
    ((sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mpr
      (small_active_injective_gate_norm_le small f x))
    (productMemoryWeight_nonneg μ ν hμ hν x)

theorem small_active_injective_gate_symmetric {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ} (small : Finset G)
    (f : ProductBoundedOrderedState P Z M B → ℂ) (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric (smallActiveInjectiveGate small f) := by
  intro x g τ
  simp only [smallActiveInjectiveGate, small_active_injective_memory_permutation, hf x g τ]

theorem small_active_injective_gate_average {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ} (small : Finset G)
    (f : ProductBoundedOrderedState P Z M B → ℂ) :
    smallActiveInjectiveGate small (fullActiveAverage f) =
      fullActiveAverage (smallActiveInjectiveGate small f) := by
  funext x
  by_cases hx : SmallActiveInjective small x
  · simp only [smallActiveInjectiveGate, if_pos hx, fullActiveAverage,
      small_active_injective_permutation]
  · simp only [smallActiveInjectiveGate, if_neg hx, fullActiveAverage,
      small_active_injective_permutation]
    simp only [mul_zero, sum_const_zero]

theorem physical_global_phase_small_source_gate {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (small : Finset (Fin N)) (C : Fin N → Finset (Fin J)) (k : ℤ)
    (H : ∀ g, Finset (P g))
    (ω : SharedActiveLabels (fun g => ↥(P g))
      (fun g => physicalFullSharedIndices (ell := ell) (C g)) → PhysicalAuxLabels P C → ℝ)
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (x : PhysicalFullBoundedState P J ell B) (e : PhysicalFullEdgeEvent C k x) (a : ℂ) :
    (if SmallActiveInjective small x then physicalFullGlobalEdgePhase C k H ω μ ρ V x e * a else 0) =
      physicalFullGlobalEdgePhase C k H ω μ ρ V x e * a := by
  by_cases hx : SmallActiveInjective small x
  · exact if_pos hx
  · have hn : ¬ FullActiveInjective x := fun h => hx (small_active_injective_of_full small x h)
    simp only [if_neg hx, physicalFullGlobalEdgePhase, dif_neg hn, zero_mul]

end Bounty
end

section

/- Sparse averaging over actual full-state events, auxiliary draws and
source permutations. Shared labels are integrated in the full-state norm.
The source gate makes any injectivity restriction explicit, and the rarity
hypothesis is a scalar probability on literal eligible old positions. -/

open Finset
open scoped Classical

namespace Bounty

section

variable {G A : Type*} [Fintype G] [dG : DecidableEq G] [Fintype A]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
  (Δ D : SharedActiveLabels P S → A → G → ℤ)
  (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)

noncomputable def fullActiveChosenAuxiliaryAction (a : A)
    (phase : ∀ x, FullActiveEdgeEvent n S B (fun _ => A) Δ D x → ℂ)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ) :=
  fullActiveCoefficientAction n S B (fun _ => A) Δ D
    (fun _ b => if b = a then 1 else 0) μ ρ V phase f

theorem full_active_chosen_auxiliary_energy_le (a : A)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, (S g)ᶜ.card ≤ T)
    (phase : ∀ x, FullActiveEdgeEvent n S B (fun _ => A) Δ D x → ℂ)
    (hphase : ∀ x e, ‖phase x e‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fullActiveChosenAuxiliaryAction n S B Δ D μ ρ V a phase f) ≤
      unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  have h := full_active_coefficient_energy_le n S B (fun _ => A) Δ D
    (fun _ b => if b = a then 1 else 0) μ ρ V
    (by intros; split_ifs <;> norm_num) (by intro c; simp)
    hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht phase 1 zero_le_one hphase f hf
  simpa only [fullActiveChosenAuxiliaryAction, one_pow, one_mul] using h

omit [∀ g p, NeZero (n g p)] in
theorem full_active_chosen_promoting_zero (a : A) (groups : Finset G)
    (phase : ∀ x, FullActiveEdgeEvent n S B (fun _ => A) Δ D x → ℂ)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (hno : ¬ ∃ g ∈ groups,
      (unrestrictedResidueEligible (n g) (Δ (productActiveMemorySplit S B x).1 a g)
        (D (productActiveMemorySplit S B x).1 a g) (x g).2.2).Nonempty) :
    fullActiveChosenAuxiliaryAction n S B Δ D μ ρ V a
      (fun x e => if ∃ g ∈ groups, (e.2 g).2.1.Nonempty then phase x e else 0) f x = 0 := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  unfold fullActiveChosenAuxiliaryAction fullActiveCoefficientAction
  apply sum_eq_zero
  rintro ⟨b,e⟩ _
  by_cases hab : b = a
  · subst b
    have hp : ¬ ∃ g ∈ groups, (e g).2.1.Nonempty := by
      rintro ⟨g, hg, he⟩
      apply hno
      refine ⟨g, hg, ?_⟩
      exact unrestricted_promoting_event_eligible (n g) _ _ (S g)ᶜ.card B
        ((productActiveMemorySplit S B x).2 g) (e g) he.ne_empty
    simp only [hp, if_false, mul_zero, zero_mul]
  · simp only [fullActiveEdgeEventWeight, hab, if_false, zero_mul, Complex.ofReal_zero]

theorem full_active_gated_permutation_energy_le (a : A) (τ : FullActiveSlotPermutations M)
    (good : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → Prop)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, (S g)ᶜ.card ≤ T)
    (phase : ∀ x, FullActiveEdgeEvent n S B (fun _ => A) Δ D x → ℂ)
    (hphase : ∀ x e, ‖phase x e‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fun x => if good x then fullActiveChosenAuxiliaryAction n S B Δ D μ ρ V a phase f
        (fullActivePermutation τ x) else 0) ≤
      unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  calc
    _ ≤ finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
        (fun x => fullActiveChosenAuxiliaryAction n S B Δ D μ ρ V a phase f
          (fullActivePermutation τ x)) := by
      apply sum_le_sum
      intro x _
      apply mul_le_mul_of_nonneg_left _ (productMemoryWeight_nonneg μ _ hμ (fun g z => hμ g z.1) x)
      dsimp only
      split_ifs
      · exact le_rfl
      · simpa only [norm_zero, zero_pow (by decide : 2 ≠ 0)] using sq_nonneg
          ‖fullActiveChosenAuxiliaryAction n S B Δ D μ ρ V a phase f (fullActivePermutation τ x)‖
    _ = finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
        (fullActiveChosenAuxiliaryAction n S B Δ D μ ρ V a phase f) :=
      fullActivePermutation_energy μ _ τ _
    _ ≤ _ := full_active_chosen_auxiliary_energy_le n S B Δ D μ ρ V a
      hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht phase hphase f hf

noncomputable def fullActiveSparseAuxiliaryAverage {Q : Type*} [Fintype Q]
    (π : Q → ℝ) (a : Q → A) (τ : Q → FullActiveSlotPermutations M)
    (good : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → Prop)
    (groups : Finset G)
    (phase : ∀ (_q : Q) x, FullActiveEdgeEvent n S B (fun _ => A) Δ D x → ℂ)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) : ℂ :=
  ∑ q, (π q : ℂ) * (if good x ∧ productTotalMemory x ≤ B then
    fullActiveChosenAuxiliaryAction n S B Δ D μ ρ V (a q)
      (fun y e => if ∃ g ∈ groups, (e.2 g).2.1.Nonempty then phase q y e else 0)
      f (fullActivePermutation (τ q) x) else 0)

theorem full_active_sparse_auxiliary_average_energy_le {Q : Type*} [Fintype Q]
    (π : Q → ℝ) (hπ : ∀ q, 0 ≤ π q) (hπmass : ∑ q, π q ≤ 1)
    (a : Q → A) (τ : Q → FullActiveSlotPermutations M)
    (good : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → Prop)
    (groups : Finset G)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, (S g)ᶜ.card ≤ T)
    (phase : ∀ (_q : Q) x, FullActiveEdgeEvent n S B (fun _ => A) Δ D x → ℂ)
    (hphase : ∀ q x e, ‖phase q x e‖ ≤ 1)
    {δ : ℝ} (hδ : 0 ≤ δ)
    (hrare : ∀ x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B,
      good x → productTotalMemory x ≤ B →
      (∑ q, if ∃ g ∈ groups,
        (unrestrictedResidueEligible (n g)
          (Δ (productActiveMemorySplit S B (fullActivePermutation (τ q) x)).1 (a q) g)
          (D (productActiveMemorySplit S B (fullActivePermutation (τ q) x)).1 (a q) g)
          (x g).2.2).Nonempty then π q else 0) ≤ δ)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fullActiveSparseAuxiliaryAverage n S B Δ D μ ρ V π a τ good groups phase f) ≤
      δ * unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  have hphase' : ∀ q x (e : FullActiveEdgeEvent n S B (fun _ => A) Δ D x),
      ‖if ∃ g ∈ groups, (e.2 g).2.1.Nonempty then phase q x e else 0‖ ≤ 1 := by
    intro q x e
    split_ifs
    · exact hphase q x e
    · simp only [norm_zero, zero_le_one]
  have hF (q : Q) := full_active_gated_permutation_energy_le n S B Δ D μ ρ V (a q) (τ q)
    (fun x => good x ∧ productTotalMemory x ≤ B)
    hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht
    (fun x e => if ∃ g ∈ groups, (e.2 g).2.1.Nonempty then phase q x e else 0)
    (hphase' q) f hf
  let bad : Q → ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → Prop :=
    fun q x => (good x ∧ productTotalMemory x ≤ B) ∧ ∃ g ∈ groups,
      (unrestrictedResidueEligible (n g)
        (Δ (productActiveMemorySplit S B (fullActivePermutation (τ q) x)).1 (a q) g)
        (D (productActiveMemorySplit S B (fullActivePermutation (τ q) x)).1 (a q) g)
        (x g).2.2).Nonempty
  refine finite_sparse_average_energy_le π hπ hπmass
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productMemoryWeight_nonneg μ _ hμ (fun g z => hμ g z.1)) bad _ ?_ hδ
    (pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _) ?_ f ?_
  · intro q x hbad
    by_cases hx : good x ∧ productTotalMemory x ≤ B
    · simp only [if_pos hx]
      apply full_active_chosen_promoting_zero n S B Δ D μ ρ V (a q) groups
        (phase q) f (fullActivePermutation (τ q) x)
      intro hel
      exact hbad ⟨hx, hel⟩
    · simp only [if_neg hx]
  · intro x
    by_cases hx : good x ∧ productTotalMemory x ≤ B
    · simpa only [bad, hx, true_and] using hrare x hx.1 hx.2
    · simpa only [bad, hx, false_and, if_false, sum_const_zero] using hδ
  · intro q
    apply le_trans _ (hF q)
    apply sum_le_sum
    intro x _
    by_cases hx : good x ∧ productTotalMemory x ≤ B
    · simp only [if_pos hx]
      apply le_of_eq
      apply congrArg (fun z : ℂ => productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)) x * ‖z‖ ^ 2)
      apply congrArg (fun Ψ : ∀ y, FullActiveEdgeEvent n S B (fun _ => A) Δ D y → ℂ =>
        fullActiveChosenAuxiliaryAction n S B Δ D μ ρ V (a q) Ψ f (fullActivePermutation (τ q) x))
      funext y e
      split_ifs <;> rfl
    · simp only [if_neg hx, le_refl]

end

end Bounty
end

section

/- A mixed finite-event edge: small groups retain their original injective
mark lists and residue coordinate, while `X` is an independent big-memory
state. Only the big factor is expanded into memory events. This construction
does not assert an invariant zero-small-memory sector of another model. -/

open Finset
open scoped Classical

namespace Bounty

abbrev PhysicalSmallBigState {G : Type*} (P : G → Finset ℕ) (J ell : ℕ) (X : Type*) :=
  PhysicalBareResidueState P J ell × X

abbrev PhysicalSmallBigEvent {G X : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (E : PhysicalSharedLists P J → X → Type*) (s : PhysicalSmallBigState P J ell X) :=
  PhysicalMarkLists P J ell × E (physicalSharedPrefix s.1.2) s.2

noncomputable def physicalSmallBigTarget {G X : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (E : PhysicalSharedLists P J → X → Type*)
    (target : ∀ d x, E d x → X) (k : X → ℤ)
    (s : PhysicalSmallBigState P J ell X) (e : PhysicalSmallBigEvent E s) :
    PhysicalSmallBigState P J ell X :=
  ((physicalTranslateResidues s.1.1
      (k s.2 * (physicalSharedProduct (physicalSharedPrefix s.1.2) : ℕ)), e.1),
    target (physicalSharedPrefix s.1.2) s.2 e.2)

noncomputable def physicalSmallBigEventWeight {G X : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (q ζ : ℝ)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (κ : PhysicalSharedLists P J → ℂ)
    (E : PhysicalSharedLists P J → X → Type*)
    (a : PhysicalResidues P → ∀ d x, E d x → ℂ) (k : X → ℤ)
    (s : PhysicalSmallBigState P J ell X) (e : PhysicalSmallBigEvent E s) : ℂ :=
  physicalBarePatternScalar V (fun _ => (∅ : Finset (Fin J))) ζ
    (fun L _ _ => κ (physicalSharedPrefix L)) aux s.1.2 e.1 *
  ((physicalResidueVertexWeight s.1.2 (Real.sqrt q) s.1.1 *
    physicalResidueVertexWeight e.1 (Real.sqrt q)
      (physicalTranslateResidues s.1.1
        (k s.2 * (physicalSharedProduct (physicalSharedPrefix s.1.2) : ℕ))) : ℝ) : ℂ) *
  a s.1.1 (physicalSharedPrefix s.1.2) s.2 e.2

noncomputable def physicalSmallBigAction {G X : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (q ζ : ℝ)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (κ : PhysicalSharedLists P J → ℂ)
    (E : PhysicalSharedLists P J → X → Type*) [∀ d x, Fintype (E d x)]
    (target : ∀ d x, E d x → X)
    (a : PhysicalResidues P → ∀ d x, E d x → ℂ) (k : X → ℤ)
    (f : PhysicalSmallBigState P J ell X → ℂ) (s : PhysicalSmallBigState P J ell X) : ℂ :=
  ∑ e : PhysicalSmallBigEvent E s,
    physicalSmallBigEventWeight V q ζ aux κ E a k s e *
      f (physicalSmallBigTarget E target k s e)

theorem physical_small_big_target_residue {G X : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (E : PhysicalSharedLists P J → X → Type*)
    (target : ∀ d x, E d x → X) (k : X → ℤ)
    (s : PhysicalSmallBigState P J ell X) (e : PhysicalSmallBigEvent E s) :
    (physicalSmallBigTarget E target k s e).1.1 =
      physicalTranslateResidues s.1.1
        (k s.2 * (physicalSharedProduct (physicalSharedPrefix s.1.2) : ℕ)) := rfl

theorem physical_small_big_target_labels {G X : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (E : PhysicalSharedLists P J → X → Type*)
    (target : ∀ d x, E d x → X) (k : X → ℤ)
    (s : PhysicalSmallBigState P J ell X) (e : PhysicalSmallBigEvent E s) :
    (physicalSmallBigTarget E target k s e).1.2 = e.1 := rfl

theorem physical_small_big_event_shared {G X : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (q ζ : ℝ)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (κ : PhysicalSharedLists P J → ℂ)
    (E : PhysicalSharedLists P J → X → Type*)
    (a : PhysicalResidues P → ∀ d x, E d x → ℂ) (k : X → ℤ)
    (s : PhysicalSmallBigState P J ell X) (e : PhysicalSmallBigEvent E s)
    (h : physicalSmallBigEventWeight V q ζ aux κ E a k s e ≠ 0) :
    physicalSharedPrefix s.1.2 = physicalSharedPrefix e.1 := by
  by_contra hn
  apply h
  simp only [physicalSmallBigEventWeight, physical_bare_empty_prefix, if_neg hn, zero_mul]

