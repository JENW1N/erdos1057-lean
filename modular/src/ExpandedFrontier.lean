    (β : (g : Fin N) → P g → ℝ) (q : Fin (n + 1) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (cut : ℕ → Fin N → Finset (Fin J)) (ζ : Fin n → ℝ)
    (K : ∀ j, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C j) → ℂ)
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress (fun _ : Fin N => J + ell) B
      ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)))))
    (encode : ((g : Fin N) × P g) → ℤ) (hinj : Function.Injective encode)
    (f : PhysicalFullBoundedState P J ell B → ℂ) (x : PhysicalFullBoundedState P J ell B) :
    let steps := (List.range (4 * n + 1)).map (physicalSelectedFineTag n)
    let sizes := fun g (p : P g) => p.val
    let shared := fun j g => physicalFullSharedIndices (ell := ell) (C j g)
    let aux := fun j (_ : SharedActiveLabels (fun g => P g) (shared j)) => PhysicalAuxLabels P (C j)
    let delta := fun j => physicalFullEdgeDelta (C j) (k j)
    let displacement := fun j => physicalFullEdgeD (C j)
    physicalCommonEnrichedForestAction C k ω β q ρ V cut ζ K code f x =
      ∫ θ, commonForestObservedMultiplier (fun _ : Fin N => J + ell) B steps code θ encode
          (commonForestInitialLabels (fun _ : Fin N => J + ell) B steps (fullMixedCommonInitialPrime x)) none *
        finiteOperatorListAction
          (fullMixedCommonStageRow sizes shared B aux delta displacement steps
            (fullMixedBirthResidualPhase sizes shared B aux delta displacement
              (physicalEnrichedEdgePhase C k ω β ρ V cut ζ K))
            code θ encode ω (fun g p => β g p / V g) q ρ V)
          (List.finRange steps.length) f x
        ∂birthFourierCubeMeasure (Fin (Fintype.card (FullMixedCommonBirthAddress
            (fun _ : Fin N => J + ell) B steps)) ×
          Fin (Fintype.card (FullMixedCommonBirthAddress (fun _ : Fin N => J + ell) B steps))) := by
  dsimp only
  exact full_mixed_common_forest_action_eq_fourier_rows
    (fun g (p : P g) => p.val) (fun j g => physicalFullSharedIndices (C j g)) B
    (fun j _ => PhysicalAuxLabels P (C j))
    (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j))
    (physicalEnrichedEdgePhase C k ω β ρ V cut ζ K) ω (fun g p => β g p / V g) q ρ V
    ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)) code encode f x hinj

theorem physical_original_selected_eq_common_fourier_rows
    {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
    [∀ g (p : P g), NeZero p.val]
    (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
    (ω : ∀ j, SharedActiveLabels (fun g => P g)
      (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
    (β : (g : Fin N) → P g → ℝ) (q : Fin (n + 1) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (cut : ℕ → Fin N → Finset (Fin J)) (ζ : Fin n → ℝ)
    (K : ∀ j, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C j) → ℂ)
    [Fintype (PhysicalSelectedData P ell C)]
    (hencode : ∀ i, PhysicalMarkRowEncoding C (physicalSelectedFineTag n i) (cut i) (cut (i + 1)))
    (encode : ((g : Fin N) × P g) → ℤ) (hinj : Function.Injective encode)
    (f : PhysicalFullBoundedState P J ell B → ℂ) (x : PhysicalFullBoundedState P J ell B)
    (hx : FullActiveInjective x)
    (hcover : FullMixedLedgerCovers (fun g (p : P g) => p.val) B (fullActiveInitialLedger x, x)) :
    let steps := (List.range (4 * n + 1)).map (physicalSelectedFineTag n)
    let sizes := fun g (p : P g) => p.val
    let shared := fun j g => physicalFullSharedIndices (ell := ell) (C j g)
    let aux := fun j (_ : SharedActiveLabels (fun g => P g) (shared j)) => PhysicalAuxLabels P (C j)
    let delta := fun j => physicalFullEdgeDelta (C j) (k j)
    let displacement := fun j => physicalFullEdgeD (C j)
    physicalOriginalSelectedMoment C k ω β q ρ V cut ζ K f x =
      ∑ code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress (fun _ : Fin N => J + ell) B steps)),
        (-1 : ℂ) ^ birthForestRank code * ∫ θ, commonForestObservedMultiplier (fun _ : Fin N => J + ell) B steps code θ encode
          (commonForestInitialLabels (fun _ : Fin N => J + ell) B steps (fullMixedCommonInitialPrime x)) none *
        finiteOperatorListAction
          (fullMixedCommonStageRow sizes shared B aux delta displacement steps
            (fullMixedBirthResidualPhase sizes shared B aux delta displacement
              (physicalEnrichedEdgePhase C k ω β ρ V cut ζ K))
            code θ encode ω (fun g p => β g p / V g) q ρ V)
          (List.finRange steps.length) f x
        ∂birthFourierCubeMeasure (Fin (Fintype.card (FullMixedCommonBirthAddress
            (fun _ : Fin N => J + ell) B steps)) ×
          Fin (Fintype.card (FullMixedCommonBirthAddress (fun _ : Fin N => J + ell) B steps))) := by
  dsimp only
  rw [physical_original_selected_common_forest_expansion C k ω β q ρ V cut ζ K hencode encode hinj f x hx hcover]
  apply sum_congr rfl
  intro code _
  rw [physical_common_enriched_forest_eq_fourier_rows C k ω β q ρ V cut ζ K code encode hinj]

end Bounty
