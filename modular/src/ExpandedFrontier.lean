open Finset
noncomputable def finiteAlternatingPairing {X : Type*} [Fintype X]
    (G E : ℕ → X → X → ℝ) (f q : X → ℝ) (n : ℕ) : ℝ :=
  ∑ x, q x * finitePathAction (finiteAlternatingKernel G E) f (2 * n + 1) x

section Kernels
variable {I : Type*} [Fintype I] {R : I → Type*}
  [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]

noncomputable def ghostPhaseTensorDiagonal (h : (p : I) → R p) (ρ : I → ℝ)
    (z : (p : I) → GhostPhaseState (R p)) : ℝ :=
  ∏ p, ghostPhaseDiagonal (h p) (ρ p) (z p)

noncomputable def ghostPhaseCappedVisit (a : I → Bool) (h : (p : I) → R p)
    (η β : I → ℝ) (cap : ℕ) (z w : (p : I) → GhostPhaseState (R p)) : ℝ :=
  if (ghostPhasePendingSupport z).card ≤ cap then
    ∏ p, ghostPhaseVisit (a p) (h p) (η p) (β p) (z p) (w p) else 0

noncomputable def ghostPhaseCappedDampedVisit (a : I → Bool) (h : (p : I) → R p)
    (η β ρ : I → ℝ) (cap : ℕ) (z w : (p : I) → GhostPhaseState (R p)) : ℝ :=
  if (ghostPhasePendingSupport z).card ≤ cap then
    ∏ p, ghostPhaseDampedVisit (a p) (h p) (η p) (β p) (ρ p) (z p) (w p) else 0

noncomputable def ghostPhaseCappedEdge (atgt asrc : I → Bool)
    (htgt hsrc : (p : I) → R p) (β V : I → ℝ) (cap : ℕ)
    (z w : (p : I) → GhostPhaseState (R p)) : ℝ :=
  if (ghostPhasePendingSupport z).card ≤ cap then
    ∏ p, (if atgt p && !(asrc p) then (V p)⁻¹ else 1) *
      ghostPhaseEdge (atgt p) (asrc p) (htgt p) (hsrc p) (β p) (z p) (w p) else 0

noncomputable def ghostPhaseCappedDampedEdge (atgt asrc : I → Bool)
    (htgt hsrc : (p : I) → R p) (β V ρtgt ρsrc : I → ℝ) (cap : ℕ)
    (z w : (p : I) → GhostPhaseState (R p)) : ℝ :=
  if (ghostPhasePendingSupport z).card ≤ cap then
    ∏ p, (if atgt p && !(asrc p) then (V p)⁻¹ else 1) *
      ghostPhaseDampedEdge (atgt p) (asrc p) (htgt p) (hsrc p) (β p)
        (ρtgt p) (ρsrc p) (z p) (w p) else 0

omit [∀ p, Fintype (R p)] in
theorem ghost_phase_tensor_diagonal_ne_zero (h : (p : I) → R p) (ρ : I → ℝ)
    (hρ : ∀ p, ρ p ≠ 0) (z : (p : I) → GhostPhaseState (R p)) :
    ghostPhaseTensorDiagonal h ρ z ≠ 0 :=
  prod_ne_zero_iff.mpr (fun p _ => ghostPhaseDiagonal_ne_zero (h p) (hρ p) (z p))

omit [∀ p, Fintype (R p)] in
theorem ghost_phase_capped_visit_diagonal (a : I → Bool) (h : (p : I) → R p)
    (η β ρ : I → ℝ) (cap : ℕ) (z w : (p : I) → GhostPhaseState (R p)) :
    ghostPhaseCappedDampedVisit a h η β ρ cap z w =
      ghostPhaseCappedVisit a h η β cap z w /
        (ghostPhaseTensorDiagonal h ρ z * ghostPhaseTensorDiagonal h ρ w) := by
  unfold ghostPhaseCappedDampedVisit ghostPhaseCappedVisit
  split_ifs
  · simp only [ghostPhaseDampedVisit, prod_div_distrib, prod_mul_distrib,
      ghostPhaseTensorDiagonal]
  · exact (zero_div _).symm

theorem ghost_phase_capped_edge_diagonal (atgt asrc : I → Bool)
    (htgt hsrc : (p : I) → R p) (β V ρtgt ρsrc : I → ℝ) (cap : ℕ)
    (z w : (p : I) → GhostPhaseState (R p)) :
    ghostPhaseCappedDampedEdge atgt asrc htgt hsrc β V ρtgt ρsrc cap z w =
      ghostPhaseTensorDiagonal htgt ρtgt z *
        ghostPhaseCappedEdge atgt asrc htgt hsrc β V cap z w *
          ghostPhaseTensorDiagonal hsrc ρsrc w := by
  unfold ghostPhaseCappedDampedEdge ghostPhaseCappedEdge
  split_ifs
  · simp only [ghostPhaseDampedEdge, prod_mul_distrib, ghostPhaseTensorDiagonal]
    ring
  · ring

end Kernels

section History
variable {I : Type*} [Fintype I] [DecidableEq I] {R : I → Type*}
  [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
  (a : I → ℕ → Bool) (h : (p : I) → ℕ → R p) (η : I → ℕ → ℝ)
  (β V : I → ℝ) (ρ : I → ℕ → ℝ) (visitCap edgeCap : ℕ → ℕ)

noncomputable def ghostPhaseCappedHistory (n : ℕ) : ℝ :=
  finiteAlternatingPairing
    (fun j => ghostPhaseCappedVisit (fun p => a p j) (fun p => h p j)
      (fun p => η p j) β (visitCap j))
    (fun j => ghostPhaseCappedEdge (fun p => a p (j + 1)) (fun p => a p j)
      (fun p => h p (j + 1)) (fun p => h p j) β V (edgeCap j))
    (fun z => ∏ p, ghostPhaseRunInitial (a p 0) (β p) (V p) (z p))
    (fun z => ∏ p, ghostPhaseTerminal (a p n) (z p)) n

noncomputable def ghostPhaseCappedDampedHistory (n : ℕ) : ℝ :=
  finiteAlternatingPairing
    (fun j => ghostPhaseCappedDampedVisit (fun p => a p j) (fun p => h p j)
      (fun p => η p j) β (fun p => ρ p j) (visitCap j))
    (fun j => ghostPhaseCappedDampedEdge (fun p => a p (j + 1)) (fun p => a p j)
      (fun p => h p (j + 1)) (fun p => h p j) β V
      (fun p => ρ p (j + 1)) (fun p => ρ p j) (edgeCap j))
    (fun z => ∏ p, ghostPhaseRunInitial (a p 0) (β p) (V p) (z p))
    (fun z => ∏ p, ghostPhaseTerminal (a p n) (z p)) n

/-- Exact tensor rho cancellation with all visit and edge cutoffs retained.
The rho values may vary independently by prime and physical vertex. -/
theorem ghost_phase_capped_damped_history_eq (hρ : ∀ p j, ρ p j ≠ 0) (n : ℕ) :
    ghostPhaseCappedDampedHistory a h η β V ρ visitCap edgeCap n =
      ghostPhaseCappedHistory a h η β V visitCap edgeCap n := by
  unfold ghostPhaseCappedDampedHistory ghostPhaseCappedHistory finiteAlternatingPairing
  simp_rw [finite_alternating_action, ghost_phase_capped_visit_diagonal,
    ghost_phase_capped_edge_diagonal]
  refine alternating_visit_edge_diagonal_pairing
    (fun j => ghostPhaseCappedVisit (fun p => a p j) (fun p => h p j)
      (fun p => η p j) β (visitCap j))
    (fun j => ghostPhaseCappedEdge (fun p => a p (j + 1)) (fun p => a p j)
      (fun p => h p (j + 1)) (fun p => h p j) β V (edgeCap j))
    (fun j => ghostPhaseTensorDiagonal (fun p => h p j) (fun p => ρ p j))
    ?_ (fun z => ∏ p, ghostPhaseRunInitial (a p 0) (β p) (V p) (z p))
    (fun z => ∏ p, ghostPhaseTerminal (a p n) (z p)) n ?_ ?_
  · intro j z
    exact ghost_phase_tensor_diagonal_ne_zero _ _ (fun p => hρ p j) z
  · intro z hz
    apply prod_eq_one
    intro p _
    have hp := prod_ne_zero_iff.mp hz p (mem_univ p)
    have hi : ghostPhaseInitial (a p 0) (β p) (z p) ≠ 0 :=
      (mul_ne_zero_iff.mp hp).2
    exact ghost_phase_initial_diagonal_one (a p 0) (h p 0) (β p) (ρ p 0) (z p) hi
  · intro z hz
    apply prod_eq_one
    intro p _
    exact ghost_phase_terminal_diagonal_one (a p n) (h p n) (ρ p n) (z p)
      (prod_ne_zero_iff.mp hz p (mem_univ p))

end History
end

section

noncomputable def finTensorRow {V : Type*} : (n : Nat) →
    {S T : Fin n → Type*} →
    ((g : Fin n) → (T g → V) → S g → V) →
    (((g : Fin n) → T g) → V) → ((g : Fin n) → S g) → V
  | 0, _, _, _, F, _ => F (fun g => Fin.elim0 g)
  | n + 1, _, _, row, F, s =>
      row 0 (fun t => finTensorRow n (fun g => row g.succ)
        (fun u => F (Fin.cons t u)) (Fin.tail s)) (s 0)

theorem fin_tensor_row_zero {V : Type*} {S T : Fin 0 → Type*}
    (row : (g : Fin 0) → (T g → V) → S g → V)
    (F : ((g : Fin 0) → T g) → V) (s : (g : Fin 0) → S g) :
    finTensorRow 0 row F s = F (fun g => Fin.elim0 g) := rfl

theorem fin_tensor_row_succ {V : Type*} (n : Nat) {S T : Fin (n + 1) → Type*}
    (row : (g : Fin (n + 1)) → (T g → V) → S g → V)
    (F : ((g : Fin (n + 1)) → T g) → V) (s : (g : Fin (n + 1)) → S g) :
    finTensorRow (n + 1) row F s =
      row 0 (fun t => finTensorRow n (fun g => row g.succ)
        (fun u => F (Fin.cons t u)) (Fin.tail s)) (s 0) := rfl

/-- Coordinate identities requiring agreement only on admissible outputs
combine into a full tensor identity. The output predicate is tested on all
coordinates jointly, so a terminal mask can depend on their total size. -/
theorem fin_tensor_row_intertwines_on {V : Type*} (n : Nat)
    {S T X Y : Fin n → Type*}
    (rowS : (g : Fin n) → (T g → V) → S g → V)
    (rowX : (g : Fin n) → (Y g → V) → X g → V)
    (source : (g : Fin n) → S g → X g)
    (target : (g : Fin n) → T g → Y g)
    (validS : (g : Fin n) → S g → Prop)
    (validT : (g : Fin n) → T g → Prop)
    (hrow : ∀ g s, validS g s → ∀ G F,
      (∀ t, validT g t → G t = F (target g t)) →
      rowS g G s = rowX g F (source g s))
    (G : ((g : Fin n) → T g) → V) (F : ((g : Fin n) → Y g) → V)
    (hGF : ∀ t, (∀ g, validT g (t g)) → G t = F (fun g => target g (t g)))
    (s : (g : Fin n) → S g) (hs : ∀ g, validS g (s g)) :
    finTensorRow n rowS G s = finTensorRow n rowX F (fun g => source g (s g)) := by
  induction n with
  | zero =>
      change G _ = F _
      have h := hGF (fun g => Fin.elim0 g) (fun g => Fin.elim0 g)
      convert h using 1
      congr 1
      funext g
      exact Fin.elim0 g
  | succ n ih =>
      simp only [fin_tensor_row_succ]
      apply hrow 0 (s 0) (hs 0)
      intro t ht
      apply ih (fun g => rowS g.succ) (fun g => rowX g.succ)
        (fun g => source g.succ) (fun g => target g.succ)
        (fun g => validS g.succ) (fun g => validT g.succ)
        (fun g => hrow g.succ)
      · intro u hu
        have hv : ∀ g, validT g (Fin.cons t u g) := by
          intro g
          refine Fin.cases ?_ (fun j => ?_) g
          · exact ht
          · exact hu j
        have he := hGF (Fin.cons t u) hv
        convert he using 1
        congr 1
        funext g
        refine Fin.cases ?_ (fun j => ?_) g <;> rfl
      · exact fun g => hs g.succ
end

section
open Finset
section Kernel
variable {P : Type*} [Fintype P] [DecidableEq P] {R : P → Type*}
  [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]

theorem global_birth_raw_step_kernel_visit (a : P → Bool) (h : (p : P) → R p)
    (β : P → ℝ) (η V ρ : ℝ) (hV : V ≠ 0) (cap : ℕ)
    (z w : (p : P) → GhostPhaseState (R p)) :
    globalBirthRawStepKernel (.visit (a := a) h β η V ρ hV cap) z w =
      if (ghostPhasePendingSupport z).card ≤ cap then
        ((∏ p, ghostPhaseDampedVisit (a p) (h p) η (β p) ρ (z p) (w p) : ℝ) : ℂ)
      else 0 := rfl

theorem global_birth_raw_step_kernel_edge (a b : P → Bool) (delta : (p : P) → R p)
    (hshared : ∀ p, b p = true ∧ a p = true → delta p = 0)
    {t : ℕ} (source target : Fin t ↪ P)
    (hsource : univ.image source = ghostPhaseActivitySupport a \ ghostPhaseActivitySupport b)
    (htarget : univ.image target = ghostPhaseNewRunSet b a)
    (β : P → ℝ) (ρ V : ℝ) (cap : ℕ) (z w : (p : P) → GhostPhaseState (R p)) :
    globalBirthRawStepKernel (.edge delta hshared source target hsource htarget β ρ V cap) z w =
      if (ghostPhasePendingSupport z).card ≤ cap then
        ((∏ p, (if b p && !(a p) then V⁻¹ else 1) *
          ghostPhaseDampedMovingEdge (b p) (a p) (delta p) (β p) ρ ρ (z p) (w p) : ℝ) : ℂ)
      else 0 := rfl

end Kernel
end

section
open Finset
noncomputable def finiteInputMaskedKernel {X 𝕜 : Type*} [Zero 𝕜]
    (C : Nat → X → Prop) (K : Nat → X → X → 𝕜)
    (i : Nat) (z w : X) : 𝕜 := by
  classical
  exact if C i w then K i z w else 0

theorem finite_chronological_prefix_zero_of_cut {X 𝕜 : Type*} [CommMonoidWithZero 𝕜]
    (C : Nat → X → Prop) (K : Nat → X → X → 𝕜) (initial : X → 𝕜)
    (hK : ∀ i z w, ¬ C (i + 1) z → K i z w = 0)
    (hinit : ∀ z, ¬ C 0 z → initial z = 0)
    (n : Nat) (x : Fin (n + 1) → X) (j : Fin (n + 1))
    (hj : ¬ C j.val (x j)) : finiteChronologicalPrefix K initial n x = 0 := by
  classical
  by_cases hzero : j.val = 0
  · have he : j = 0 := Fin.ext hzero
    subst j
    simp only [finiteChronologicalPrefix, hinit (x 0) hj, zero_mul]
  · let i : Fin n := ⟨j.val - 1, by omega⟩
    have hi : i.succ = j := by
      apply Fin.ext
      dsimp [i]
      omega
    have hk : K i.val (x i.succ) (x i.castSucc) = 0 := by
      apply hK
      simpa only [← hi, Fin.val_succ] using hj
    unfold finiteChronologicalPrefix
    rw [prod_eq_zero (mem_univ i) hk, mul_zero]

/-- No sum or cancellation is required: duplicate cut projectors collapse
on each individual chronological state trace. -/
theorem finite_chronological_input_masks_collapse {X 𝕜 : Type*}
    [CommMonoidWithZero 𝕜]
    (C : Nat → X → Prop) (K : Nat → X → X → 𝕜) (initial : X → 𝕜)
    (hK : ∀ i z w, ¬ C (i + 1) z → K i z w = 0)
    (hinit : ∀ z, ¬ C 0 z → initial z = 0)
    (n : Nat) (x : Fin (n + 1) → X) :
    finiteChronologicalPrefix (finiteInputMaskedKernel C K) initial n x =
      finiteChronologicalPrefix K initial n x := by
  classical
  by_cases hcut : ∀ j : Fin (n + 1), C j.val (x j)
  · unfold finiteChronologicalPrefix
    congr 1
    apply prod_congr rfl
    intro j _
    exact if_pos (hcut j.castSucc)
  · obtain ⟨j, hj⟩ := not_forall.mp hcut
    have hmasked : ∀ i z w, ¬ C (i + 1) z → finiteInputMaskedKernel C K i z w = 0 := by
      intro i z w hz
      unfold finiteInputMaskedKernel
      rw [hK i z w hz]
      split_ifs <;> rfl
    rw [finite_chronological_prefix_zero_of_cut C _ initial hmasked hinit n x j hj,
      finite_chronological_prefix_zero_of_cut C K initial hK hinit n x j hj]
end

section
open Finset Classical
noncomputable def boundedOrderedGhostOperator {P Z : Type*}
    [Fintype Z] [DecidableEq Z] (A D C ν : Z → ℝ) (t B : ℕ)
    (f : BoundedOrderedState P Z t B → ℂ) (s : BoundedOrderedState P Z t B) : ℂ :=
  symmetricOrderedGhostOperator A D C ν B
    (boundedOrderedZeroExtension f s.1) (boundedOrderedTupleToFinite s.2)

theorem bounded_ordered_memory_energy_range {Z : Type*} [Fintype Z]
    (ν : Z → ℝ) (B : ℕ) (F : FiniteOrderedTuple Z → ℂ) :
    finiteWeightedEnergy (boundedOrderedMemoryWeight ν)
      (fun q : BoundedOrderedTuple Z B => F (boundedOrderedTupleToFinite q)) =
      ∑ n ∈ range (B + 1),
        (∑ q : Fin n → Z, (∏ j, ν (q j)) * ‖F ⟨n, q⟩‖ ^ 2) / (n.factorial : ℝ) := by
  simpa only [finiteWeightedEnergy, smul_eq_mul, one_div_mul_eq_div] using
    bounded_ordered_memory_smul_sum_range ν B (fun q => ‖F q‖ ^ 2)

theorem bounded_ordered_state_energy_split {P Z : Type*} [Fintype P] [Fintype Z]
    (μ : P → ℝ) (ν : Z → ℝ) (t B : ℕ) (f : BoundedOrderedState P Z t B → ℂ) :
    finiteWeightedEnergy (boundedOrderedStateWeight μ ν) f =
      ∑ active : Fin t → P, (∏ i, μ (active i)) *
        finiteWeightedEnergy (boundedOrderedMemoryWeight ν) (fun q => f (active, q)) := by
  simp only [finiteWeightedEnergy, Fintype.sum_prod_type, boundedOrderedStateWeight,
    mul_sum, mul_assoc]

theorem bounded_ordered_ghost_symmetric {P Z : Type*} [Fintype Z] [DecidableEq Z]
    (A D C ν : Z → ℝ) (t B : ℕ) (f : BoundedOrderedState P Z t B → ℂ)
    (hf : BoundedOrderedSymmetric f) :
    BoundedOrderedSymmetric (boundedOrderedGhostOperator A D C ν t B f) := by
  intro active N q τ
  exact symmetric_ordered_ghost_operator_symmetric A D C ν B
    (boundedOrderedZeroExtension f active)
    ((boundedOrderedZeroExtension_symmetric_iff f).mpr hf active) N.val q τ

theorem bounded_ordered_ghost_energy_le {P Z : Type*} [Fintype P] [Fintype Z]
    [DecidableEq Z] (μ : P → ℝ) (A D C ν v : Z → ℝ) (t B : ℕ)
    (hμ : ∀ p, 0 ≤ μ p) (hA : ∀ z, 0 ≤ A z)
    (hν : ∀ z, 0 < ν z) (hv : ∀ z, 0 < v z)
    (hD : ∀ z, A z + |D z| / v z ≤ 1) (hC : ∀ z, A z + |C z| / v z ≤ 1)
    (f : BoundedOrderedState P Z t B → ℂ) (hf : BoundedOrderedSymmetric f) :
    finiteWeightedEnergy (boundedOrderedStateWeight μ ν)
      (boundedOrderedGhostOperator A D C ν t B f) ≤
      Real.exp (∑ z, (|C z| + |D z|) * ν z * v z) *
        finiteWeightedEnergy (boundedOrderedStateWeight μ ν) f := by
  have hlocal (active : Fin t → P) :
      finiteWeightedEnergy (boundedOrderedMemoryWeight ν)
        (fun q => boundedOrderedGhostOperator A D C ν t B f (active, q)) ≤
      Real.exp (∑ z, (|C z| + |D z|) * ν z * v z) *
        finiteWeightedEnergy (boundedOrderedMemoryWeight ν) (fun q => f (active, q)) := by
    have h := symmetric_ordered_ghost_l2_sq_le A D C ν v B hA hν hv hD hC
      (boundedOrderedZeroExtension f active)
      ((boundedOrderedZeroExtension_symmetric_iff f).mpr hf active)
    rw [← bounded_ordered_memory_energy_range, ← bounded_ordered_memory_energy_range] at h
    have hext (q : BoundedOrderedTuple Z B) :
        boundedOrderedZeroExtension f active (boundedOrderedTupleToFinite q) = f (active, q) :=
      boundedOrderedZeroExtension_apply f (active, q)
    simpa only [boundedOrderedGhostOperator, hext] using h
  rw [bounded_ordered_state_energy_split, bounded_ordered_state_energy_split, mul_sum]
  apply sum_le_sum
  intro active _
  calc
    _ ≤ (∏ i, μ (active i)) *
        (Real.exp (∑ z, (|C z| + |D z|) * ν z * v z) *
          finiteWeightedEnergy (boundedOrderedMemoryWeight ν) (fun q => f (active, q))) :=
      mul_le_mul_of_nonneg_left (hlocal active) (prod_nonneg fun i _ => hμ (active i))
    _ = _ := by ring
end

section

noncomputable def physicalGhostWeightThreshold (qmax ρ Vmax : ℝ) : ℝ :=
  1 + 2 * max 1 Vmax * ρ / (ρ ^ 2 - qmax)

theorem physicalGhostWeightThreshold_gt_one {qmax ρ Vmax : ℝ}
    (hρ : 0 < ρ) (hgap : qmax < ρ ^ 2) :
    1 < physicalGhostWeightThreshold qmax ρ Vmax := by
  have hM : 0 < max 1 Vmax := lt_of_lt_of_le zero_lt_one (le_max_left _ _)
  unfold physicalGhostWeightThreshold
  exact lt_add_of_pos_right 1 (div_pos (mul_pos (mul_pos (by norm_num) hM) hρ)
    (sub_pos.mpr hgap))

theorem physical_ghost_q_lt_one {q qmax ρ : ℝ}
    (hq : q ≤ qmax) (hgap : qmax < ρ ^ 2) (hρ0 : 0 < ρ) (hρ1 : ρ < 1) :
    q < 1 := by
  nlinarith

/-- The explicit threshold gives the strict common inequality used for
both row and column damping, uniformly over all q below qmax. -/
theorem physical_ghost_uniform_weight_margin {q qmax ρ Vmax v : ℝ}
    (hq0 : 0 ≤ q) (hq : q ≤ qmax) (hgap : qmax < ρ ^ 2)
    (hρ : 0 < ρ) (hv : physicalGhostWeightThreshold qmax ρ Vmax ≤ v) :
    q / ρ ^ 2 + (2 * max 1 Vmax * (1 - q) / ρ) / v < 1 := by
  have hv1 : 1 < v := (physicalGhostWeightThreshold_gt_one hρ hgap).trans_le hv
  have hv0 : 0 < v := zero_lt_one.trans hv1
  have hM : 0 < max 1 Vmax := lt_of_lt_of_le zero_lt_one (le_max_left _ _)
  have hlarge : 2 * max 1 Vmax * ρ / (ρ ^ 2 - qmax) < v := by
    unfold physicalGhostWeightThreshold at hv
    linarith
  have hbase := (div_lt_iff₀ (sub_pos.mpr hgap)).mp hlarge
  have hqv := mul_le_mul_of_nonneg_right hq hv0.le
  have hnon : 0 ≤ 2 * max 1 Vmax * q * ρ := by positivity
  have heq : q / ρ ^ 2 + (2 * max 1 Vmax * (1 - q) / ρ) / v =
      (q * v + 2 * max 1 Vmax * (1 - q) * ρ) / (ρ ^ 2 * v) := by
    field_simp
  rw [heq, div_lt_one (mul_pos (sq_pos_of_pos hρ) hv0)]
  nlinarith

/-- Any coefficient bounded by twice max(1,Vmax) obeys the same damping
condition. Taking W=1 gives termination; W=V gives ordinary or doubled birth. -/
theorem physical_ghost_scaled_damping_lt_one {q qmax ρ Vmax v a W : ℝ}
    (hq0 : 0 ≤ q) (hq : q ≤ qmax) (hgap : qmax < ρ ^ 2)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1)
    (hv : physicalGhostWeightThreshold qmax ρ Vmax ≤ v)
    (ha2 : a ≤ 2) (hW0 : 0 ≤ W) (hW : W ≤ max 1 Vmax) :
    q / ρ ^ 2 + (a * (1 - q) * W / ρ) / v < 1 := by
  have hv0 : 0 < v := zero_lt_one.trans
    ((physicalGhostWeightThreshold_gt_one hρ0 hgap).trans_le hv)
  have hη : 0 ≤ 1 - q := sub_nonneg.mpr (physical_ghost_q_lt_one hq hgap hρ0 hρ1).le
  have hcoeff : a * W ≤ 2 * max 1 Vmax :=
    mul_le_mul ha2 hW hW0 (by norm_num)
  have hnum : a * (1 - q) * W ≤ 2 * max 1 Vmax * (1 - q) := by
    nlinarith [mul_le_mul_of_nonneg_right hcoeff hη]
  exact (add_le_add le_rfl (div_le_div_of_nonneg_right
    (div_le_div_of_nonneg_right hnum hρ0.le) hv0.le)).trans_lt
    (physical_ghost_uniform_weight_margin hq0 hq hgap hρ0 hv)

/-- The two exact scalar hypotheses consumed by physical ghost energy. -/
theorem physical_ghost_damping_conditions {q qmax ρ Vmax V v : ℝ}
    (hq0 : 0 ≤ q) (hq : q ≤ qmax) (hgap : qmax < ρ ^ 2)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1)
    (hv : physicalGhostWeightThreshold qmax ρ Vmax ≤ v)
    (hV0 : 0 ≤ V) (hV : V ≤ Vmax) :
    (q / ρ ^ 2 + ((1 - q) / ρ) / v ≤ 1) ∧
    (q / ρ ^ 2 + ((1 - q) * V / ρ) / v ≤ 1) := by
  constructor
  · simpa only [one_mul, mul_one] using
      (physical_ghost_scaled_damping_lt_one hq0 hq hgap hρ0 hρ1 hv
        (a := 1) (W := 1) (by norm_num) zero_le_one (le_max_left _ _)).le
  · simpa only [one_mul] using
      (physical_ghost_scaled_damping_lt_one hq0 hq hgap hρ0 hρ1 hv
        (a := 1) (W := V) (by norm_num) hV0
        (hV.trans (le_max_right _ _))).le

theorem physical_ghost_doubled_birth_damping {q qmax ρ Vmax V v : ℝ}
    (hq0 : 0 ≤ q) (hq : q ≤ qmax) (hgap : qmax < ρ ^ 2)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1)
    (hv : physicalGhostWeightThreshold qmax ρ Vmax ≤ v)
    (hV0 : 0 ≤ V) (hV : V ≤ Vmax) :
    q / ρ ^ 2 + (2 * ((1 - q) * V / ρ)) / v < 1 := by
  have h := physical_ghost_scaled_damping_lt_one hq0 hq hgap hρ0 hρ1 hv
    (a := 2) (W := V) (by norm_num) hV0 (hV.trans (le_max_right _ _))
  convert h using 1; ring
end

section
open Finset Classical
theorem finite_product_event_norm_le_abs_positive {I : Type*} [Fintype I]
    {X : I → Type*} (E : ∀ i, X i → Type*) [∀ i x, Fintype (E i x)]
    (weight : ∀ i x, E i x → ℝ) (target : ∀ i x, E i x → X i)
    (phase : ∀ x : (∀ i, X i), (∀ i, E i (x i)) → ℂ)
    (hphase : ∀ x e, ‖phase x e‖ ≤ 1) (f : (∀ i, X i) → ℂ) (x : ∀ i, X i) :
    ‖finiteProductEventAction E weight target phase f x‖ ≤
      finiteProductEventPositive E (fun i x e => |weight i x e|) target (fun y => ‖f y‖) x := by
  unfold finiteProductEventAction finiteProductEventPositive
  refine (norm_sum_le _ _).trans (sum_le_sum fun e _ => ?_)
  rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, Finset.abs_prod]
  calc
    _ ≤ ((∏ i, |weight i (x i) (e i)|) * 1) * ‖f (fun i => target i (x i) (e i))‖ :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (hphase x e)
        (prod_nonneg fun _ _ => abs_nonneg _)) (norm_nonneg _)
    _ = _ := by rw [mul_one]

theorem finite_product_event_norm_le_abs_positive_re {I : Type*} [Fintype I]
    {X : I → Type*} (E : ∀ i, X i → Type*) [∀ i x, Fintype (E i x)]
    (weight : ∀ i x, E i x → ℝ) (target : ∀ i x, E i x → X i)
    (phase : ∀ x : (∀ i, X i), (∀ i, E i (x i)) → ℂ)
    (hphase : ∀ x e, ‖phase x e‖ ≤ 1) (f : (∀ i, X i) → ℂ) (x : ∀ i, X i) :
    ‖finiteProductEventAction E weight target phase f x‖ ≤
      (finiteProductEventAction E (fun i x e => |weight i x e|) target (fun _ _ => 1)
        (complexNormEnvelope f) x).re := by
  rw [show complexNormEnvelope f = fun y => (‖f y‖ : ℂ) from rfl,
    ← finite_product_event_positive_cast, Complex.ofReal_re]
  exact finite_product_event_norm_le_abs_positive E weight target phase hphase f x

theorem finite_event_path_weight_abs {K X : Type*} (E : K → X → Type*)
    (target : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (ks : List K) (x : X) (p : FiniteEventPath E target ks x) :
    |finiteEventPathWeight E target w ks x p| =
      finiteEventPathWeight E target (fun k x e => |w k x e|) ks x p := by
  induction ks generalizing x with
  | nil => exact abs_one
  | cons k ks ih =>
    rcases p with ⟨e, p⟩
    exact (abs_mul _ _).trans (congrArg (fun a => |w k x e| * a) (ih _ p))

theorem finite_event_path_norm_le_abs_list_re {K X : Type*}
    (E : K → X → Type*) [∀ k x, Fintype (E k x)]
    (target : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (ks : List K) (phase : ∀ x, FiniteEventPath E target ks x → ℂ)
    (hphase : ∀ x p, ‖phase x p‖ ≤ 1) (f : X → ℂ) (x : X) :
    ‖finiteEventPathAction E target w ks phase f x‖ ≤
      (finiteOperatorListAction
        (finiteLocalEventAction E (fun k x e => |w k x e|) target) ks (complexNormEnvelope f) x).re := by
  rw [← finite_event_path_positive_eq_list]
  let _ := finiteEventPathFintype E target ks x
  have hpos : (finiteEventPathPositive E target (fun k x e => |w k x e|)
      ks (complexNormEnvelope f) x).re =
      ∑ p : FiniteEventPath E target ks x,
        |finiteEventPathWeight E target w ks x p| * ‖f (finiteEventPathTerminal E target ks x p)‖ := by
    simp only [finiteEventPathPositive, complexNormEnvelope, Complex.re_sum, Complex.mul_re,
      Complex.ofReal_re, Complex.ofReal_im, mul_zero, sub_zero, ← finite_event_path_weight_abs]
  rw [hpos]
  unfold finiteEventPathAction
  refine (norm_sum_le _ _).trans (sum_le_sum fun p _ => ?_)
  rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs]
  calc
    _ ≤ (|finiteEventPathWeight E target w ks x p| * 1) *
        ‖f (finiteEventPathTerminal E target ks x p)‖ :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (hphase x p) (abs_nonneg _))
        (norm_nonneg _)
    _ = _ := by rw [mul_one]
end

section
open scoped BigOperators
theorem finite_product_expectation_split {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (i : I) (f : (∀ j, X j) → ℂ) :
    (∑ x, (finiteProductWeight μ x : ℂ) * f x) =
      ∑ z : (∀ j : {j : I // j ≠ i}, X j.val),
        ((∏ j, μ j.val (z j) : ℝ) : ℂ) *
          ∑ y, (μ i y : ℂ) * f ((Equiv.piSplitAt i X).symm (y, z)) := by
  let E := Equiv.piSplitAt i X
  rw [← E.symm.sum_comp, Fintype.sum_prod_type, Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro z _
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro y _
  rw [finite_product_weight_split μ i]
  have hE := E.apply_symm_apply (y, z)
  have hfirst : E.symm (y, z) i = y := congrArg Prod.fst hE
  have hrest : (fun j : {j : I // j ≠ i} => E.symm (y, z) j.val) = z :=
    congrArg Prod.snd hE
  have hprod : (∏ j : {j : I // j ≠ i}, μ j.val (E.symm (y, z) j.val)) =
      ∏ j, μ j.val (z j) := congrArg (fun q => ∏ j, μ j.val (q j)) hrest
  rw [hfirst, hprod, Complex.ofReal_mul]
  ring

theorem finite_product_weight_sum_one {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hmass : ∀ i, ∑ x, μ i x = 1) :
    ∑ x, finiteProductWeight μ x = 1 := by
  classical
  unfold finiteProductWeight
  rw [← Fintype.prod_sum]
  exact Finset.prod_eq_one (fun i _ => hmass i)

theorem finite_product_value_split {I M : Type*} [Fintype I] [DecidableEq I]
    [CommMonoid M] {X : I → Type*} (v : ∀ i, X i → M) (i : I) (x : ∀ j, X j) :
    (∏ j, v j (x j)) = v i (x i) * ∏ j : {j : I // j ≠ i}, v j.val (x j.val) := by
  have h := Fintype.prod_subtype_mul_prod_subtype (fun j => j = i) (fun j => v j (x j))
  have heq (j : {j : I // j = i}) : v j.val (x j.val) = v i (x i) := by
    rcases j with ⟨j, rfl⟩
    rfl
  simpa only [Fintype.prod_unique, heq] using h.symm

theorem finite_product_value_expectation_split {I M : Type*} [Fintype I] [DecidableEq I]
    [CommMonoid M] {X : I → Type*} [∀ i, Fintype (X i)]
    (μ : ∀ i, X i → ℝ) (v : ∀ i, X i → M) (i : I) (F : M → ℂ) :
    (∑ x, (finiteProductWeight μ x : ℂ) * F (∏ j, v j (x j))) =
      ∑ z : (∀ j : {j : I // j ≠ i}, X j.val),
        ((∏ j, μ j.val (z j) : ℝ) : ℂ) *
          ∑ y, (μ i y : ℂ) * F (v i y * ∏ j, v j.val (z j)) := by
  rw [finite_product_expectation_split μ i]
  apply Finset.sum_congr rfl
  intro z _
  congr 1
  apply Finset.sum_congr rfl
  intro y _
  congr 2
  let E := Equiv.piSplitAt i X
  have hE := E.apply_symm_apply (y, z)
  have hfirst : E.symm (y, z) i = y := congrArg Prod.fst hE
  have hrest : (fun j : {j : I // j ≠ i} => E.symm (y, z) j.val) = z :=
    congrArg Prod.snd hE
  rw [finite_product_value_split v i, hfirst]
  congr 1
  exact congrArg (fun q => ∏ j, v j.val (q j)) hrest
end

section
open scoped Classical
theorem finite_fiber_pushforward_sum {X I : Type*} [Fintype X] [Fintype I]
    (π : X → I) (a : X → ℂ) (K : I → ℂ) :
    (∑ i, (∑ x ∈ Finset.univ.filter (fun x => π x = i), a x) * K i) =
      ∑ x, a x * K (π x) := by
  classical
  simp only [Finset.sum_filter, Finset.sum_mul, ite_mul, zero_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro x hx
  simp

theorem finite_fiber_pushforward_bilinear {X Y I J : Type*}
    [Fintype X] [Fintype Y] [Fintype I] [Fintype J]
    (π : X → I) (τ : Y → J) (a : X → ℂ) (b : Y → ℂ) (K : I → J → ℂ) :
    (∑ i, ∑ j,
      (∑ x ∈ Finset.univ.filter (fun x => π x = i), a x) *
      (∑ y ∈ Finset.univ.filter (fun y => τ y = j), b y) * K i j) =
      ∑ x, ∑ y, a x * b y * K (π x) (τ y) := by
  classical
  calc
    _ = ∑ i, (∑ x ∈ Finset.univ.filter (fun x => π x = i), a x) *
        ∑ j, (∑ y ∈ Finset.univ.filter (fun y => τ y = j), b y) * K i j := by
      apply Finset.sum_congr rfl
      intro i hi
      conv_rhs => rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro j hj
      exact mul_assoc _ _ _
    _ = ∑ i, (∑ x ∈ Finset.univ.filter (fun x => π x = i), a x) *
        ∑ y, b y * K i (τ y) := by simp_rw [finite_fiber_pushforward_sum]
    _ = ∑ y, ∑ i, (∑ x ∈ Finset.univ.filter (fun x => π x = i), a x) *
        (b y * K i (τ y)) := by
      simp only [Finset.mul_sum]
      rw [Finset.sum_comm]
    _ = ∑ y, ∑ x, a x * (b y * K (π x) (τ y)) := by
      apply Finset.sum_congr rfl
      intro y hy
      exact finite_fiber_pushforward_sum π a (fun i => b y * K i (τ y))
    _ = _ := by rw [Finset.sum_comm]; simp only [mul_assoc]
end

section
open scoped Classical
theorem weighted_fiber_mass_le_of_atom_bound {X I : Type*} [Fintype X]
    (π : X → I) (n : I → ℕ) (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x)
    {C P : ℝ} (hC : 0 ≤ C) (hP : 0 < P)
    (hlower : ∀ x, P ≤ (n (π x) : ℝ))
    (hatom : ∀ m : ℕ,
      (∑ x ∈ Finset.univ.filter (fun x => n (π x) = m), μ x) ≤ C / (m : ℝ))
    (i : I) :
    (∑ x ∈ Finset.univ.filter (fun x => π x = i), μ x) ≤ C / P := by
  classical
  by_cases hi : ∃ x, π x = i
  · obtain ⟨x, hx⟩ := hi
    have hPi : P ≤ (n i : ℝ) := by simpa only [hx] using hlower x
    have hs : Finset.univ.filter (fun x => π x = i) ⊆
        Finset.univ.filter (fun x => n (π x) = n i) := by
      intro y hy
      obtain ⟨hyU, hyi⟩ := Finset.mem_filter.mp hy
      exact Finset.mem_filter.mpr ⟨hyU, congrArg n hyi⟩
    calc
      _ ≤ ∑ x ∈ Finset.univ.filter (fun x => n (π x) = n i), μ x :=
        Finset.sum_le_sum_of_subset_of_nonneg hs (fun x _ _ => hμ x)
      _ ≤ C / (n i : ℝ) := hatom (n i)
      _ ≤ C / P := div_le_div_of_nonneg_left hC hP hPi
  · have he : Finset.univ.filter (fun x => π x = i) = ∅ := by
      apply Finset.filter_eq_empty_iff.mpr
      intro x hx hxi
      exact hi ⟨x, hxi⟩
    rw [he, Finset.sum_empty]
    exact div_nonneg hC hP.le

theorem weighted_fiber_energy_le_of_atom_bound {X I : Type*} [Fintype X]
    (values : Finset I) (π : X → I) (n : I → ℕ)
    (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (f : X → ℂ)
    {C P : ℝ} (hC : 0 ≤ C) (hP : 0 < P)
    (hlower : ∀ x, P ≤ (n (π x) : ℝ))
    (hatom : ∀ m : ℕ,
      (∑ x ∈ Finset.univ.filter (fun x => n (π x) = m), μ x) ≤ C / (m : ℝ)) :
    (∑ i ∈ values,
      ‖∑ x ∈ Finset.univ.filter (fun x => π x = i), (μ x : ℂ) * f x‖ ^ 2) ≤
      (C / P) * ∑ x, μ x * ‖f x‖ ^ 2 :=
  finite_weighted_fiber_energy_le values π μ hμ f (div_nonneg hC hP.le)
    (fun i _ => weighted_fiber_mass_le_of_atom_bound π n μ hμ hC hP hlower hatom i)
end

section
open Finset
/-- Impossible requirements have zero weight, including when natural subtraction
would otherwise replace a negative requested cardinality with zero. -/
noncomputable def hoeffdingRetainedFraction (M m ell j : ℕ) : ℝ :=
  if m ≤ j ∧ j + ell ≤ M then
    ((M - m - ell).choose (j - m) : ℝ) / (M.choose j : ℝ)
  else 0

/-- A single nonnegative term of Vandermonde's identity bounds the numerator. -/
theorem hoeffding_retained_choose_mul_le (M m ell j : ℕ)
    (hmj : m ≤ j) (hjM : j + ell ≤ M) :
    (M - m - ell).choose (j - m) * (m + ell).choose m ≤ M.choose j := by
  have hsum := Nat.add_choose_eq (M - m - ell) (m + ell) j
  have hadd : M - m - ell + (m + ell) = M := by omega
  rw [hadd] at hsum
  rw [hsum]
  exact single_le_sum (f := fun ij : ℕ × ℕ => (M - m - ell).choose ij.1 * (m + ell).choose ij.2) (fun _ _ => Nat.zero_le _)
    (show (j - m, m) ∈ antidiagonal j from by
      rw [Finset.HasAntidiagonal.mem_antidiagonal]
      omega)

/-- A crude binomial lower bound is enough for the required polynomial decay. -/
theorem hoeffding_probe_power_le_choose (m ell : ℕ) :
    m ^ ell ≤ ell ^ ell * (m + ell).choose m := by
  have h := Nat.pow_sub_le_descFactorial (m + ell) ell
  have hsub : m + ell + 1 - ell = m + 1 := by omega
  rw [hsub, Nat.descFactorial_eq_factorial_mul_choose] at h
  calc
    m ^ ell ≤ (m + 1) ^ ell := Nat.pow_le_pow_left (by omega) ell
    _ ≤ ell.factorial * (m + ell).choose ell := h
    _ ≤ ell ^ ell * (m + ell).choose ell :=
      Nat.mul_le_mul_right _ (Nat.factorial_le_pow ell)
    _ = _ := by rw [Nat.choose_symm_add]

/-- The feasible fraction is at most `ell^ell / m^ell`. No large ambient-cardinality
assumption is needed; the estimate is stronger than the factor-two target. -/
theorem hoeffding_retained_ratio_le (M m ell j : ℕ) (hm : 0 < m)
    (hmj : m ≤ j) (hjM : j + ell ≤ M) :
    ((M - m - ell).choose (j - m) : ℝ) / (M.choose j : ℝ) ≤
      (ell : ℝ) ^ ell / (m : ℝ) ^ ell := by
  have hB : (0 : ℝ) < M.choose j := by
    exact_mod_cast Nat.choose_pos (show j ≤ M by omega)
  have hmR : (0 : ℝ) < m := by exact_mod_cast hm
  have hterm : ((M - m - ell).choose (j - m) : ℝ) * ((m + ell).choose m : ℝ) ≤
      (M.choose j : ℝ) := by
    exact_mod_cast hoeffding_retained_choose_mul_le M m ell j hmj hjM
  have hpower : (m : ℝ) ^ ell ≤ (ell : ℝ) ^ ell * ((m + ell).choose m : ℝ) := by
    exact_mod_cast hoeffding_probe_power_le_choose m ell
  apply (div_le_div_iff₀ hB (pow_pos hmR ell)).mpr
  calc
    _ ≤ ((M - m - ell).choose (j - m) : ℝ) *
        ((ell : ℝ) ^ ell * ((m + ell).choose m : ℝ)) :=
      mul_le_mul_of_nonneg_left hpower (Nat.cast_nonneg _)
    _ = (ell : ℝ) ^ ell *
        (((M - m - ell).choose (j - m) : ℝ) * ((m + ell).choose m : ℝ)) := by ring
    _ ≤ _ := mul_le_mul_of_nonneg_left hterm (pow_nonneg (Nat.cast_nonneg _) ell)

theorem hoeffding_retained_fraction_eq_zero (M m ell j : ℕ)
    (h : ¬ (m ≤ j ∧ j + ell ≤ M)) : hoeffdingRetainedFraction M m ell j = 0 := by
  simp only [hoeffdingRetainedFraction, if_neg h]

theorem hoeffding_retained_fraction_nonneg (M m ell j : ℕ) :
    0 ≤ hoeffdingRetainedFraction M m ell j := by
  unfold hoeffdingRetainedFraction
  split_ifs
  · exact div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _)
  · exact le_rfl

/-- Uniform scalar estimate, with impossible component cardinalities included. -/
theorem hoeffding_retained_fraction_le (M m ell j : ℕ) (hm : 0 < m) :
    hoeffdingRetainedFraction M m ell j ≤ (ell : ℝ) ^ ell / (m : ℝ) ^ ell := by
  unfold hoeffdingRetainedFraction
  split_ifs with h
  · exact hoeffding_retained_ratio_le M m ell j hm h.1 h.2
  · exact div_nonneg (pow_nonneg (Nat.cast_nonneg _) ell) (pow_nonneg (Nat.cast_nonneg _) ell)

theorem hoeffding_retained_fraction_le_twice (M m ell j : ℕ) (hm : 0 < m) :
    hoeffdingRetainedFraction M m ell j ≤ 2 * (ell : ℝ) ^ ell / (m : ℝ) ^ ell := by
  have h := hoeffding_retained_fraction_le M m ell j hm
  have hnonneg : 0 ≤ (ell : ℝ) ^ ell / (m : ℝ) ^ ell :=
    div_nonneg (pow_nonneg (Nat.cast_nonneg _) ell) (pow_nonneg (Nat.cast_nonneg _) ell)
  rw [mul_div_assoc]
  linarith
end

section

open Finset
open scoped Classical

noncomputable def repeatedBigRowAction {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (f : RepeatedBigLists P J ell → ℂ) : RepeatedBigLists P J ell → ℂ :=
  fun source => ∑ target, (∑ aux, repeatedBigKernel V b C ζ K aux source target) * f target

noncomputable def repeatedBigUnbannedRowAction {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J)) (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (f : RepeatedBigLists P J ell → ℂ) : RepeatedBigLists P J ell → ℂ :=
  fun source => ∑ target, (∑ aux,
    repeatedBigUnbannedKernel V (fun _ _ => 1) C ζ K aux source target) * f target

noncomputable def repeatedBigPatternError {G : Type*} [Fintype G]
    {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J)) (T Pmin B : ℝ) : ℝ :=
  B * ((((2 * ∑ g, (ell + (C g).card) : ℕ) : ℝ) * T / Pmin) +
    ∑ g, (C g).card * (2 * (J + ell : ℕ)) / (V g * Pmin))

theorem repeated_big_conjugated_row {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (f : RepeatedBigLists P J ell → ℂ) :
    repeatedBigDensityMap b (repeatedBigRowAction V b C ζ K (repeatedBigDensityInverse b f)) =
      fun source => ∑ target,
        (((Real.sqrt (cleanActiveDensity b source) /
          Real.sqrt (cleanActiveDensity b target) : ℝ) : ℂ) *
          (∑ aux, repeatedBigKernel V b C ζ K aux source target)) * f target := by
  ext source
  change (Real.sqrt (cleanActiveDensity b source) : ℂ) *
    (∑ target, (∑ aux, repeatedBigKernel V b C ζ K aux source target) *
      (f target / (Real.sqrt (cleanActiveDensity b target) : ℂ))) = _
  rw [mul_sum]
  apply sum_congr rfl
  intro target _
  push_cast
  ring

theorem repeated_big_conjugated_unbanned_error {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (hbpos : ∀ g p, 0 < b g p) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (B : ℝ) (hB : 0 ≤ B) (hK : ∀ x y a, ‖K x y a‖ ≤ B)
    {T Pmin : ℝ} (hT : 0 ≤ T) (hPmin : 0 < Pmin)
    (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (hb : ∀ g (p : P g), b g p = 1 - T / (p.val : ℝ))
    (hsmall : ((2 * ∑ g, (ell + (C g).card) : ℕ) : ℝ) * T / Pmin ≤ 1 / 2)
    (f : RepeatedBigLists P J ell → ℂ) :
    cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
      (repeatedBigDensityMap b (repeatedBigRowAction V b C ζ K (repeatedBigDensityInverse b f)) -
        repeatedBigUnbannedRowAction V C ζ K f) ≤
      repeatedBigPatternError (ell := ell) V C T Pmin B *
        cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f := by
  let A := repeatedBigDensityMap b (repeatedBigRowAction V b C ζ K (repeatedBigDensityInverse b f))
  let D := repeatedBigRowAction V (fun _ _ => 1) C ζ K f
  let U := repeatedBigUnbannedRowAction V C ζ K f
  have hd := repeated_big_lifespan_density_operator_error
    V b hbpos C hV hMass ζ K B hB hK hT hPmin hp hb hsmall f
  have hu := repeated_big_ban_removal_operator_error V C hV hMass ζ K B hB hK hPmin hp f
  have hed : A - D = fun source => ∑ target,
      (((Real.sqrt (cleanActiveDensity b source) /
        Real.sqrt (cleanActiveDensity b target) : ℝ) : ℂ) *
        (∑ aux, repeatedBigKernel V b C ζ K aux source target) -
        ∑ aux, repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target) * f target := by
    dsimp [A, D]
    rw [repeated_big_conjugated_row]
    ext source
    simp only [Pi.sub_apply, repeatedBigRowAction, sub_mul, sum_sub_distrib]
  have heu : U - D = fun source => ∑ target,
      (∑ aux, (repeatedBigUnbannedKernel V (fun _ _ => 1) C ζ K aux source target -
        repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target)) * f target := by
    ext source
    simp only [U, D, Pi.sub_apply, repeatedBigUnbannedRowAction, repeatedBigRowAction,
      sum_sub_distrib, sub_mul]
  change cleanActiveNorm _ (A - U) ≤ _
  calc
    _ = cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) ((A - D) - (U - D)) := by
      congr 1; abel
    _ ≤ cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) (A - D) +
        cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) (U - D) :=
      clean_active_norm_sub_le _ (repeated_big_untilted_active_mass_nonneg V (fun g => (hV g).le)) _ _
    _ ≤ _ := by rw [hed, heu]; exact le_trans (add_le_add hd hu) (le_of_eq (by unfold repeatedBigPatternError; ring))

theorem repeated_big_pattern_error_nonneg {G : Type*} [Fintype G]
    {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (T Pmin B : ℝ) (hV : ∀ g, 0 ≤ V g) (hT : 0 ≤ T)
    (hPmin : 0 ≤ Pmin) (hB : 0 ≤ B) :
    0 ≤ repeatedBigPatternError (ell := ell) V C T Pmin B := by
  apply mul_nonneg hB
  apply add_nonneg
  · exact div_nonneg (mul_nonneg (Nat.cast_nonneg _) hT) hPmin
  · apply sum_nonneg
    intro g _
    exact div_nonneg (mul_nonneg (Nat.cast_nonneg _) (mul_nonneg (by norm_num) (Nat.cast_nonneg _)))
      (mul_nonneg (hV g) hPmin)

/-- Only perturbations are estimated pattern by pattern. The ideal term retains
its entire signed sum inside the compressed operator norm. -/
theorem repeated_big_symmetric_pattern_perturbation {I G : Type*}
    [Fintype I] [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (b : ∀ g, P g → ℝ) (hbpos : ∀ g p, 0 < b g p)
    (C : I → G → Finset (Fin J)) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) (ζ : ℝ)
    (K : ∀ i, RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (c : I → ℂ) (B : I → ℝ) (hB : ∀ i, 0 ≤ B i)
    (hK : ∀ i x y a, ‖K i x y a‖ ≤ B i)
    {T Pmin : ℝ} (hT : 0 ≤ T) (hPmin : 0 < Pmin)
    (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (hb : ∀ g (p : P g), b g p = 1 - T / (p.val : ℝ))
    (hsmall : ∀ i, ((2 * ∑ g, (ell + (C i g).card) : ℕ) : ℝ) * T / Pmin ≤ 1 / 2)
    (M : ℝ)
    (hideal : ∀ u : RepeatedBigLists P J ell → ℂ, u ∈ repeatedBigSymmetricSubspace →
      cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
        (repeatedBigSymmetrizeLinear (∑ i, c i • repeatedBigUnbannedRowAction V (C i) ζ (K i) u)) ≤
        M * cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) u)
    (v : RepeatedBigLists P J ell → ℂ) (hv : v ∈ repeatedBigSymmetricSubspace) :
    cleanActiveNorm (repeatedBigActiveMass V b)
      (repeatedBigSymmetrizeLinear (∑ i, c i • repeatedBigRowAction V b (C i) ζ (K i) v)) ≤
      (M + ∑ i, ‖c i‖ * repeatedBigPatternError (ell := ell) V (C i) T Pmin (B i)) *
        cleanActiveNorm (repeatedBigActiveMass V b) v := by
  let u := repeatedBigDensityMap b v
  let a := ∑ i, c i • repeatedBigUnbannedRowAction V (C i) ζ (K i) u
  let e := ∑ i, c i • (repeatedBigDensityMap b (repeatedBigRowAction V b (C i) ζ (K i) v) -
    repeatedBigUnbannedRowAction V (C i) ζ (K i) u)
  have hμ := repeated_big_untilted_active_mass_nonneg (P := P) (J := J) (ell := ell) V (fun g => (hV g).le)
  have he : cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) e ≤
      (∑ i, ‖c i‖ * repeatedBigPatternError (ell := ell) V (C i) T Pmin (B i)) *
        cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) u := by
    calc
      _ ≤ ∑ i, cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
          (c i • (repeatedBigDensityMap b (repeatedBigRowAction V b (C i) ζ (K i) v) -
            repeatedBigUnbannedRowAction V (C i) ζ (K i) u)) :=
        clean_active_norm_sum_le _ hμ _ _
      _ ≤ ∑ i, ‖c i‖ * (repeatedBigPatternError (ell := ell) V (C i) T Pmin (B i) *
          cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) u) := by
        apply sum_le_sum
        intro i _
        rw [clean_active_norm_smul _ hμ]
        apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
        have hi := repeated_big_conjugated_unbanned_error V b hbpos (C i) hV hMass ζ
          (K i) (B i) (hB i) (hK i) hT hPmin hp hb (hsmall i) u
        simpa only [u, repeated_big_density_inverse_map b hbpos] using hi
      _ = _ := by rw [sum_mul]; apply sum_congr rfl; intro i _; ring
  have hd : repeatedBigDensityMap b
      (∑ i, c i • repeatedBigRowAction V b (C i) ζ (K i) v) = a + e := by
    simp only [map_sum, map_smul, a, e, ← sum_add_distrib, ← smul_add]
    apply sum_congr rfl
    intro i _
    congr 1
    abel
  calc
    _ = cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
        (repeatedBigSymmetrizeLinear (a + e)) := by
      rw [← repeated_big_density_norm V b (fun g p => (hbpos g p).le),
        repeated_big_density_map_symmetrize, hd]
    _ = cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
        (repeatedBigSymmetrizeLinear a + repeatedBigSymmetrizeLinear e) := by rw [map_add]
    _ ≤ cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) (repeatedBigSymmetrizeLinear a) +
        cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) (repeatedBigSymmetrizeLinear e) :=
      clean_active_norm_add_le _ hμ _ _
    _ ≤ M * cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) u +
        (∑ i, ‖c i‖ * repeatedBigPatternError (ell := ell) V (C i) T Pmin (B i)) *
          cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) u := by
      apply add_le_add (hideal u (repeated_big_density_map_mem b v hv))
      exact (repeated_big_symmetrize_norm_le _ hμ (repeated_big_active_mass_permutation V _) e).trans he
    _ = _ := by rw [← add_mul, repeated_big_density_norm V b (fun g p => (hbpos g p).le)]
end

section
open Finset
noncomputable def candidateFullPSet (c L : ℝ) : Finset ℕ :=
  candidateSmallPSet c L (16 * Real.exp L + 1)

noncomputable def candidateFullOrdinaryWindowMass (c L q : ℝ) (r jStar : ℕ) : ℝ :=
  ∑ p ∈ candidateFullPSet c L, candidatePWeight c L q p *
    ∑ n ∈ arithmeticProductWindow p (Real.exp L), candidateQWeight c L r jStar n

theorem candidate_full_P_set_nonzero {c L : ℝ} {p : ℕ}
    (hp : p ∈ candidateFullPSet c L) : p ≠ 0 :=
  candidate_small_P_set_nonzero hp

theorem candidate_full_ordinary_window_split (c L q : ℝ) (r jStar : ℕ)
    (hr : 0 < r) (hj : 0 < jStar) :
    candidateFullOrdinaryWindowMass c L q r jStar =
      ∑ p ∈ candidateFullPSet c L,
        ∑ y : ∀ slot, candidateQRestChoices c L r jStar hr slot,
          (candidatePWeight c L q p / ((r.factorial : ℝ)^(candidateQIndices c L).card)) *
            ((primeProductWindow (candidateQBand (c * L) 0)
              ((p * orderedSlotProduct (candidateQRestChoices c L r jStar hr) y : ℕ) : ℝ)
              (Real.exp L)).card : ℝ) := by
  classical
  unfold candidateFullOrdinaryWindowMass
  apply sum_congr rfl
  intro p hp
  simp only [candidateQWeight]
  rw [ordered_slot_arithmetic_window_split _ (candidateFreeSlot c L r hr) _
    (candidate_full_P_set_nonzero hp), candidate_Q_free_choice c L r jStar hr hj, mul_sum]
  apply sum_congr rfl
  intro y _
  change candidatePWeight c L q p *
    (((primeProductWindow (candidateQBand (c * L) 0)
      ((p * orderedSlotProduct (candidateQRestChoices c L r jStar hr) y : ℕ) : ℝ)
      (Real.exp L)).card : ℝ) / ((r.factorial : ℝ)^(candidateQIndices c L).card)) = _
  ring

theorem candidate_Q_rest_product_nonzero (c L : ℝ) (r jStar : ℕ) (hr : 0 < r)
    (y : ∀ slot, candidateQRestChoices c L r jStar hr slot) :
    orderedSlotProduct (candidateQRestChoices c L r jStar hr) y ≠ 0 := by
  apply Finset.prod_ne_zero_iff.mpr
  intro slot _
  exact candidate_Q_slot_nonzero c L r jStar slot.val (y slot).property

theorem candidate_small_P_harmonic_le_total {c L q : ℝ}
    (hcL : 0 ≤ c * L) (hq : 0 ≤ q) (X : ℝ) :
    candidateSmallPHarmonicMass c L q X ≤ candidateOneMarkedHarmonicMass c L q := by
  have hnonneg (n : ℕ) : 0 ≤ candidatePHarmonicTerm c L q n := by
    exact div_nonneg
      (marked_divisor_weight_nonneg _ _ hq _ _
        (fun _ _ => sum_nonneg (fun _ _ => by positivity)) _)
      (Nat.cast_nonneg n)
  change (∑' n : Nat.factoredNumbers ((candidatePIndices c L).biUnion (candidatePBand (c * L))),
    if (n.val : ℝ) < X then candidatePHarmonicTerm c L q n.val else 0) ≤
    ∑' n : Nat.factoredNumbers ((candidatePIndices c L).biUnion (candidatePBand (c * L))),
      candidatePHarmonicTerm c L q n.val
  apply hasSum_le _ (candidate_small_P_harmonic_summable hcL q X).hasSum
    (candidate_P_harmonic_summable hcL q).hasSum
  intro n
  split_ifs
  · exact le_rfl
  · exact hnonneg n.val

theorem candidate_full_P_harmonic_sum_le_total {c L q : ℝ}
    (hcL : 0 ≤ c * L) (hq : 0 ≤ q) :
    (∑ p ∈ candidateFullPSet c L, candidatePWeight c L q p / (p : ℝ)) ≤
      candidateOneMarkedHarmonicMass c L q := by
  rw [candidateFullPSet, candidate_small_P_weight_harmonic_sum]
  exact candidate_small_P_harmonic_le_total hcL hq _
end

section
open Finset Filter
open scoped Topology
theorem candidate_coefficient_full_convolution_of_free (c L q : ℝ) (r jStar : ℕ)
    (hfree : ∀ n, candidateQWeight c L r jStar n ≠ 0 →
      n ≠ 0 ∧ Disjoint n.primeFactors
        ((candidatePIndices c L).biUnion (candidatePBand (c * L)))) :
    candidateCoefficientWindowMass c L q r jStar =
      ∑ p ∈ candidateSmallPSet c L (16 * Real.exp L + 1),
        candidatePWeight c L q p *
          ∑ n ∈ arithmeticProductWindow p (Real.exp L), candidateQWeight c L r jStar n := by
  symm
  apply supported_free_window_convolution_eq
    ((candidatePIndices c L).biUnion (candidatePBand (c * L)))
    (candidateSmallPSet c L (16 * Real.exp L + 1))
    (candidatePWeight c L q) (candidateQWeight c L r jStar)
    (candidateCoefficient c L q r jStar) (Real.exp L)
  · intro p hp
    exact ((mem_candidateSmallPSet_iff c L _ p).mp hp).2
  · exact hfree
  · intro p hp n hn
    exact candidate_coefficient_mul_of_free c L q r jStar
      ((mem_candidateSmallPSet_iff c L _ p).mp hp).2 (hfree n hn).1 (hfree n hn).2
  · intro u hu hWu
    let P := (candidatePIndices c L).biUnion (candidatePBand (c * L))
    let p := primePoolPart P u
    let n := primePoolFreePart P u
    have hurange : Real.exp L < (u : ℝ) ∧ (u : ℝ) ≤ 16 * Real.exp L := by
      simpa only [one_mul] using
        (mem_arithmeticProductWindow_iff one_ne_zero (Real.exp L)).mp hu
    have hu0 : u ≠ 0 := by
      have hpos : (0 : ℝ) < u := (Real.exp_pos L).trans hurange.1
      exact_mod_cast ne_of_gt hpos
    have hpu : p ≤ u := Nat.le_of_dvd (Nat.pos_of_ne_zero hu0) (primePoolPart_dvd P u)
    have hpSupport : p ∈ Nat.factoredNumbers P := primePoolPart_mem_factoredNumbers P u
    have hpn : p * n = u := primePoolPart_mul_primePoolFreePart P u
    have hp : p ∈ candidateSmallPSet c L (16 * Real.exp L + 1) := by
      apply (mem_candidateSmallPSet_iff c L _ p).mpr
      refine ⟨?_, hpSupport⟩
      have hpuR : (p : ℝ) ≤ u := Nat.cast_le.mpr hpu
      linarith [hurange.2]
    have hn : n ∈ arithmeticProductWindow p (Real.exp L) := by
      apply (mem_arithmeticProductWindow_iff (primePoolPart_ne_zero P u) (Real.exp L)).mpr
      change Real.exp L < (p * n : ℕ) ∧ (p * n : ℕ) ≤ 16 * Real.exp L
      simpa only [hpn] using hurange
    exact ⟨p, hp, n, hn, left_ne_zero_of_mul hWu, hpn⟩

/-- The eventual threshold is uniform over the damping parameter, the number
of slots, and the distinguished rough-slot index. -/
theorem eventually_candidate_coefficient_full_convolution {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ),
      candidateCoefficientWindowMass c L q r jStar =
        ∑ p ∈ candidateSmallPSet c L (16 * Real.exp L + 1),
          candidatePWeight c L q p *
            ∑ n ∈ arithmeticProductWindow p (Real.exp L), candidateQWeight c L r jStar n := by
  filter_upwards [eventually_candidate_P_pool_below_rough_cutoff hc,
    eventually_ge_atTop (0 : ℝ)] with L hpool hL
  intro q r jStar
  apply candidate_coefficient_full_convolution_of_free
  intro n hn
  obtain ⟨x, hx⟩ := ordered_slot_weight_ne_zero_support _ _ hn
  refine ⟨?_, ?_⟩
  · rw [← hx]
    exact prod_ne_zero_iff.mpr
      (fun slot _ => candidate_Q_slot_nonzero c L r jStar slot (x slot).property)
  · rw [← hx]
    exact candidate_Q_tuple_primeFactors_disjoint (mul_nonneg hc.le hL) hpool x
end

section
open Finset
open scoped Classical
section Paths
variable {P : Type*} [Fintype P] [DecidableEq P] {R : P → Type*}
  [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)]
  (a : ℕ → P → Bool) (steps : ∀ i, GlobalBirthRawStep (R := R) (a i) (a (i + 1)))

abbrev GlobalBirthRawEventPath (n : ℕ) (s : GlobalBirthHistoryState R) :=
  FiniteEventPath (fun i => GlobalBirthRawEvent (steps i))
    (fun i => globalBirthRawEventTarget (steps i)) (List.range n) s

def globalBirthRawPathAllowed (n : ℕ) (s : GlobalBirthHistoryState R)
    (p : GlobalBirthRawEventPath a steps n s) : Prop :=
  finiteEventPathAllowed (fun i => GlobalBirthRawEvent (steps i))
    (fun i => globalBirthRawEventTarget (steps i))
    (fun i => globalBirthRawEventAllowed (steps i)) (List.range n) s p

/-- The actual filtered history with an arbitrary complex phase on its entire
event path. This includes chronological visits as well as edges. -/
noncomputable def globalBirthRawEventPathAction (n : ℕ)
    (phase : ∀ s, GlobalBirthRawEventPath a steps n s → ℂ)
    (F : GlobalBirthHistoryState R → ℂ) (s : GlobalBirthHistoryState R) : ℂ :=
  let _ : ∀ i s, Fintype (GlobalBirthRawEvent (steps i) s) :=
    fun i s => globalBirthRawEventFintype (steps i) s
  finiteEventPathAction (fun i => GlobalBirthRawEvent (steps i))
    (fun i => globalBirthRawEventTarget (steps i))
    (fun i => globalBirthRawEventMass (steps i)) (List.range n) phase F s

/-- The exact unfiltered signed coefficient product, with every local
restriction moved into one path predicate. Visit birth types still specify
injective batches outside the current ledger; no event multiplicity is lost. -/
theorem global_birth_raw_event_path_action_eq_masked (n : ℕ)
    (phase : ∀ s, GlobalBirthRawEventPath a steps n s → ℂ)
    (F : GlobalBirthHistoryState R → ℂ) (s : GlobalBirthHistoryState R) :
    let _ : ∀ i s, Fintype (GlobalBirthRawEvent (steps i) s) :=
      fun i s => globalBirthRawEventFintype (steps i) s
    globalBirthRawEventPathAction a steps n phase F s =
      finiteEventPathAction (fun i => GlobalBirthRawEvent (steps i))
        (fun i => globalBirthRawEventTarget (steps i))
        (fun i => globalBirthRawEventWeight (steps i)) (List.range n)
        (fun s p => if globalBirthRawPathAllowed a steps n s p then phase s p else 0) F s := by
  let _ : ∀ i s, Fintype (GlobalBirthRawEvent (steps i) s) :=
    fun i s => globalBirthRawEventFintype (steps i) s
  exact finite_event_path_action_restrict _ _ _ _ _ _ _ _

/-- Additional global exclusions combine with the actual raw-row restrictions
as a single mask on complete trajectories. -/
theorem global_birth_raw_event_path_mask_eq (n : ℕ)
    (allowed : ∀ s, GlobalBirthRawEventPath a steps n s → Prop)
    (phase : ∀ s, GlobalBirthRawEventPath a steps n s → ℂ)
    (F : GlobalBirthHistoryState R → ℂ) (s : GlobalBirthHistoryState R) :
    let _ : ∀ i s, Fintype (GlobalBirthRawEvent (steps i) s) :=
      fun i s => globalBirthRawEventFintype (steps i) s
    globalBirthRawEventPathAction a steps n
      (fun s p => if allowed s p then phase s p else 0) F s =
      finiteEventPathAction (fun i => GlobalBirthRawEvent (steps i))
        (fun i => globalBirthRawEventTarget (steps i))
        (fun i => globalBirthRawEventWeight (steps i)) (List.range n)
        (fun s p => if globalBirthRawPathAllowed a steps n s p ∧ allowed s p
          then phase s p else 0) F s := by
  rw [global_birth_raw_event_path_action_eq_masked]
  unfold finiteEventPathAction
  apply sum_congr rfl
  intro p _
  dsimp only
  split_ifs <;> simp_all

/-- Exact match between the existing full-ledger raw composition and the
literal interleaved event trajectory sum. No coherence premise is needed for
this algebraic expansion, and every step's cutoff remains present. -/
theorem global_birth_raw_history_event_paths (n : ℕ)
    (F : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p)) :
    globalBirthRawHistory a steps n F H q =
      globalBirthRawEventPathAction a steps n (fun _ _ => 1)
        (fun s => F s.1 s.2) (H, q) := by
  let _ : ∀ i s, Fintype (GlobalBirthRawEvent (steps i) s) :=
    fun i s => globalBirthRawEventFintype (steps i) s
  have hr : globalBirthHistoryRawRow a steps =
      finiteLocalEventAction (fun i => GlobalBirthRawEvent (steps i))
        (fun i => globalBirthRawEventMass (steps i))
        (fun i => globalBirthRawEventTarget (steps i)) := by
    funext i G s
    exact global_birth_raw_step_event_sum (steps i) s G
  unfold globalBirthRawEventPathAction globalBirthRawHistory
  dsimp only
  rw [finite_event_path_action_one, hr]
  exact finite_row_composition_eq_event_paths _ _ _ _ _ _

/-- Direct trajectory form of the unphased history, with an explicit single
path mask for all local fixed-target, ledger and cutoff restrictions. -/
theorem global_birth_raw_history_masked_event_sum (n : ℕ)
    (F : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p)) :
    let _ : ∀ i s, Fintype (GlobalBirthRawEvent (steps i) s) :=
      fun i s => globalBirthRawEventFintype (steps i) s
    globalBirthRawHistory a steps n F H q =
      finiteEventPathAction (fun i => GlobalBirthRawEvent (steps i))
        (fun i => globalBirthRawEventTarget (steps i))
        (fun i => globalBirthRawEventWeight (steps i)) (List.range n)
        (fun s p => if globalBirthRawPathAllowed a steps n s p then 1 else 0)
        (fun s => F s.1 s.2) (H, q) := by
  rw [global_birth_raw_history_event_paths, global_birth_raw_event_path_action_eq_masked]

end Paths
end

section
open Finset
open scoped Classical
/-- At a fixed length, finite-pool embeddings are exactly ordered ambient
draws selected by injectivity and membership in that pool. -/
theorem birth_pool_sum_eq_ambient_mask {P : Type*} [Fintype P] [DecidableEq P]
    (U : Finset P) (m : ℕ) (F : (Fin m → P) → ℂ) :
    (∑ f : Fin m ↪ U, F (fun j => (f j).val)) =
      ∑ f : Fin m → P, if Function.Injective f ∧ (∀ j, f j ∈ U) then F f else 0 := by
  rw [← sum_filter]
  apply sum_bij (fun f _ => fun j => (f j).val)
  · intro f _
    refine mem_filter.mpr ⟨mem_univ _, ?_, fun j => (f j).property⟩
    intro j k hjk
    exact f.injective (Subtype.ext hjk)
  · intro f _ g _ hfg
    apply Function.Embedding.ext
    intro j
    exact Subtype.ext (congrFun hfg j)
  · intro f hf
    have hv := (mem_filter.mp hf).2
    refine ⟨⟨fun j => ⟨f j, hv.2 j⟩, ?_⟩, mem_univ _, rfl⟩
    intro j k hjk
    exact hv.1 (congrArg Subtype.val hjk)
  · intro f _
    rfl

/-- Extending the length range to the whole ambient label pool adds only
zero terms, since an accepted injection cannot exceed its allowed pool. -/
theorem birth_pool_batch_sum_eq_ambient_mask {P : Type*} [Fintype P] [DecidableEq P]
    (U : Finset P) (F : ∀ m, (Fin m → P) → ℂ) :
    (∑ m ∈ range (U.card + 1), ∑ f : Fin m ↪ U, F m (fun j => (f j).val)) =
      ∑ m ∈ range (Fintype.card P + 1), ∑ f : Fin m → P,
        if Function.Injective f ∧ (∀ j, f j ∈ U) then F m f else 0 := by
  simp_rw [birth_pool_sum_eq_ambient_mask]
  apply sum_subset (range_mono (Nat.add_le_add_right (card_le_univ U) 1))
  intro m _ hm
  apply sum_eq_zero
  intro f _
  apply if_neg
  intro hf
  let e : Fin m ↪ U := ⟨fun j => ⟨f j, hf.2 j⟩, fun _ _ h => hf.1 (congrArg Subtype.val h)⟩
  have hcard : m ≤ U.card := by
    simpa only [Fintype.card_fin, Fintype.card_coe] using Fintype.card_le_of_embedding e
  exact hm (mem_range.mpr (Nat.lt_succ_of_le hcard))

/-- Ambient repeated-birth row with distinctness and the entire cumulative
ledger exclusion expressed only in an explicit acceptance predicate. -/
noncomputable def globalBirthGhostVisitAmbientRow {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, DecidableEq (R p)] {N : ℕ}
    (h : (p : P) → R p) (β : P → ℝ) (η V ρ : ℝ) (cap : ℕ)
    (H : Finset P) (old : Fin N → Σ p, R p)
    (G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ) : ℂ :=
  ∑ T ∈ (globalBirthVisitZeroIndices h old).powerset,
    ∑ m ∈ range (Fintype.card P + 1), ∑ f : Fin m → P,
      if Function.Injective f ∧ (∀ j, f j ∉ H) then
        ((((-η / ρ) ^ T.card * ((1 - η) / ρ ^ 2) ^ (globalBirthVisitZeroIndices h old \ T).card) *
          ((-η * V / ρ) ^ m * (∏ j, β (f j) / V)) / (m.factorial : ℝ) : ℝ) : ℂ) *
        (if (retainedBirthTuple old (univ \ T) (fun j => ⟨f j, h (f j)⟩)).1 ≤ cap then
          G (H ∪ univ.image f) (retainedBirthTuple old (univ \ T) (fun j => ⟨f j, h (f j)⟩))
        else 0)
      else 0

/-- The original global-birth visit is exactly the ambient repeated-draw row.
Every ordered batch coefficient, including its single 1/m! factor, is unchanged. -/
theorem global_birth_ghost_visit_eq_ambient_row {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, DecidableEq (R p)] {N : ℕ}
    (h : (p : P) → R p) (β : P → ℝ) (η V ρ : ℝ) (cap : ℕ)
    (H : Finset P) (old : Fin N → Σ p, R p)
    (G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ) :
    globalBirthGhostVisitRawRow h β η V ρ cap H old G =
      globalBirthGhostVisitAmbientRow h β η V ρ cap H old G := by
  unfold globalBirthGhostVisitRawRow globalBirthGhostVisitAmbientRow
  apply sum_congr rfl
  intro T _
  have hs := birth_pool_batch_sum_eq_ambient_mask (univ \ H)
    (fun m f =>
      ((((-η / ρ) ^ T.card * ((1 - η) / ρ ^ 2) ^ (globalBirthVisitZeroIndices h old \ T).card) *
        ((-η * V / ρ) ^ m * (∏ j, β (f j) / V)) / (m.factorial : ℝ) : ℝ) : ℂ) *
      (if (retainedBirthTuple old (univ \ T) (fun j => ⟨f j, h (f j)⟩)).1 ≤ cap then
        G (H ∪ univ.image f) (retainedBirthTuple old (univ \ T) (fun j => ⟨f j, h (f j)⟩))
      else 0))
  simpa only [← global_visit_birth_range_image, mem_sdiff, mem_univ, true_and] using hs
end

section
open Finset
/-- A separate coordinate equivalence at each physical vertex reindexes
both cuts of its visit and the adjoining cuts of its edges. -/
theorem finite_alternating_pairing_conjugate {X : Type*} [Fintype X]
    (e : ℕ → X ≃ X) (G E : ℕ → X → X → ℝ) (f q : X → ℝ) (n : ℕ) :
    finiteAlternatingPairing
      (fun j x y => G j ((e j).symm x) ((e j).symm y))
      (fun j x y => E j ((e (j + 1)).symm x) ((e j).symm y))
      (fun x => f ((e 0).symm x)) (fun x => q ((e n).symm x)) n =
      finiteAlternatingPairing G E f q n := by
  unfold finiteAlternatingPairing
  simp_rw [finite_alternating_action]
  have hK : (fun j x y => ∑ z,
      G (j + 1) ((e (j + 1)).symm x) ((e (j + 1)).symm z) *
        E j ((e (j + 1)).symm z) ((e j).symm y)) =
      (fun j x y => (fun u v => ∑ z, G (j + 1) u z * E j z v)
        ((e (j + 1)).symm x) ((e j).symm y)) := by
    funext j x y
    exact (e (j + 1)).symm.sum_comp
      (fun z => G (j + 1) ((e (j + 1)).symm x) z * E j z ((e j).symm y))
  have hF : (fun x => ∑ y, G 0 ((e 0).symm x) ((e 0).symm y) * f ((e 0).symm y)) =
      (fun x => (fun u => ∑ y, G 0 u y * f y) ((e 0).symm x)) := by
    funext x
    exact (e 0).symm.sum_comp (fun y => G 0 ((e 0).symm x) y * f y)
  rw [hK, hF]
  simp_rw [finite_path_action_conjugate_apply e
    (fun j u v => ∑ z, G (j + 1) u z * E j z v)
    (fun u => ∑ y, G 0 u y * f y) n]
  exact (e n).symm.sum_comp (fun x => q x * finitePathAction
    (fun j u v => ∑ z, G (j + 1) u z * E j z v)
    (fun u => ∑ y, G 0 u y * f y) n x)

section Shift
variable {I : Type*} {R : I → Type*} [∀ p, AddGroup (R p)]

def ghostPhaseTensorShift (h : (p : I) → R p) :
    ((p : I) → GhostPhaseState (R p)) ≃ ((p : I) → GhostPhaseState (R p)) :=
  Equiv.piCongrRight (fun p => ghostPhaseShift (h p))

theorem ghost_phase_tensor_shift_symm_apply (h : (p : I) → R p)
    (z : (p : I) → GhostPhaseState (R p)) (p : I) :
    (ghostPhaseTensorShift h).symm z p = (ghostPhaseShift (h p)).symm (z p) := rfl

theorem ghost_phase_run_initial_shift_symm {S : Type*} [AddGroup S]
    (a : Bool) (β V : ℝ) (h : S) (z : GhostPhaseState S) :
    ghostPhaseRunInitial a β V ((ghostPhaseShift h).symm z) =
      ghostPhaseRunInitial a β V z := by
  cases a <;> rcases z with _ | (_ | (_ | r)) <;> rfl

theorem ghost_phase_terminal_shift_symm {S : Type*} [AddGroup S]
    (a : Bool) (h : S) (z : GhostPhaseState S) :
    ghostPhaseTerminal a ((ghostPhaseShift h).symm z) = ghostPhaseTerminal a z := by
  cases a <;> rcases z with _ | (_ | (_ | r)) <;> rfl

variable [Fintype I]

theorem ghost_phase_pending_support_tensor_shift_symm (h : (p : I) → R p)
    (z : (p : I) → GhostPhaseState (R p)) :
    ghostPhasePendingSupport ((ghostPhaseTensorShift h).symm z) =
      ghostPhasePendingSupport z := by
  change ghostPhasePendingSupport (fun p => (ghostPhaseShift (h p)).symm (z p)) = _
  simpa only [ghostPhaseShift_symm] using
    ghost_phase_pending_support_shift (fun p => -h p) z

variable [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]

noncomputable def ghostPhaseCappedDampedMovingEdge (atgt asrc : I → Bool)
    (delta : (p : I) → R p) (β V ρtgt ρsrc : I → ℝ) (cap : ℕ)
    (z w : (p : I) → GhostPhaseState (R p)) : ℝ :=
  if (ghostPhasePendingSupport z).card ≤ cap then
    ∏ p, (if atgt p && !(asrc p) then (V p)⁻¹ else 1) *
      ghostPhaseDampedMovingEdge (atgt p) (asrc p) (delta p) (β p)
        (ρtgt p) (ρsrc p) (z p) (w p) else 0

omit [∀ p, Fintype (R p)] in
theorem ghost_phase_capped_damped_visit_relative_zero (a : I → Bool)
    (h : (p : I) → R p) (η β ρ : I → ℝ) (cap : ℕ)
    (z w : (p : I) → GhostPhaseState (R p)) :
    ghostPhaseCappedDampedVisit a h η β ρ cap
      ((ghostPhaseTensorShift h).symm z) ((ghostPhaseTensorShift h).symm w) =
    ghostPhaseCappedDampedVisit a (fun _ => 0) η β ρ cap z w := by
  unfold ghostPhaseCappedDampedVisit
  rw [ghost_phase_pending_support_tensor_shift_symm]
  split_ifs
  · apply prod_congr rfl
    intro p _
    exact ghost_phase_damped_visit_relative_zero (a p) (h p) (η p) (β p) (ρ p) (z p) (w p)
  · rfl

theorem ghost_phase_capped_damped_edge_conjugation (atgt asrc : I → Bool)
    (htgt hsrc : (p : I) → R p) (β V ρtgt ρsrc : I → ℝ) (cap : ℕ)
    (z w : (p : I) → GhostPhaseState (R p)) :
    ghostPhaseCappedDampedEdge atgt asrc htgt hsrc β V ρtgt ρsrc cap
      ((ghostPhaseTensorShift htgt).symm z) ((ghostPhaseTensorShift hsrc).symm w) =
    ghostPhaseCappedDampedMovingEdge atgt asrc (fun p => htgt p - hsrc p)
      β V ρtgt ρsrc cap z w := by
  unfold ghostPhaseCappedDampedEdge ghostPhaseCappedDampedMovingEdge
  rw [ghost_phase_pending_support_tensor_shift_symm]
  split_ifs
  · apply prod_congr rfl
    intro p _
    congr 1
    exact ghost_phase_damped_edge_conjugation (atgt p) (asrc p) (htgt p) (hsrc p)
      (β p) (ρtgt p) (ρsrc p) (z p) (w p)
  · rfl

end Shift

section History
variable {I : Type*} [Fintype I] [DecidableEq I] {R : I → Type*}
  [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
  (a : I → ℕ → Bool) (h : (p : I) → ℕ → R p) (η : I → ℕ → ℝ)
  (β V : I → ℝ) (ρ : I → ℕ → ℝ) (visitCap edgeCap : ℕ → ℕ)

noncomputable def ghostPhaseCappedMovingDampedHistory (n : ℕ) : ℝ :=
  finiteAlternatingPairing
    (fun j => ghostPhaseCappedDampedVisit (fun p => a p j) (fun _ => 0)
      (fun p => η p j) β (fun p => ρ p j) (visitCap j))
    (fun j => ghostPhaseCappedDampedMovingEdge (fun p => a p (j + 1)) (fun p => a p j)
      (fun p => h p (j + 1) - h p j) β V
      (fun p => ρ p (j + 1)) (fun p => ρ p j) (edgeCap j))
    (fun z => ∏ p, ghostPhaseRunInitial (a p 0) (β p) (V p) (z p))
    (fun z => ∏ p, ghostPhaseTerminal (a p n) (z p)) n

/-- Expanded atomic trace form, with one actual total-memory cutoff after
each of the n+1 visits and n edges. -/
theorem ghost_phase_capped_moving_history_trace (n : ℕ) :
    ghostPhaseCappedMovingDampedHistory a h η β V ρ visitCap edgeCap n =
      ∑ z : Fin (2 * n + 2) → (p : I) → GhostPhaseState (R p),
        (∏ p, ghostPhaseTerminal (a p n) (z (Fin.last (2 * n + 1)) p)) *
          ((∏ p, ghostPhaseRunInitial (a p 0) (β p) (V p) (z 0 p)) *
            ∏ j : Fin (2 * n + 1), finiteAlternatingKernel
              (fun k => ghostPhaseCappedDampedVisit (fun p => a p k) (fun _ => 0)
                (fun p => η p k) β (fun p => ρ p k) (visitCap k))
              (fun k => ghostPhaseCappedDampedMovingEdge
                (fun p => a p (k + 1)) (fun p => a p k)
                (fun p => h p (k + 1) - h p k) β V
                (fun p => ρ p (k + 1)) (fun p => ρ p k) (edgeCap k))
              j.val (z j.succ) (z j.castSucc)) := by
  exact (finite_chronological_trace_expansion _ _ _ (2 * n + 1)).symm

/-- Reindex every phase cut to its absolute residue frame. All pending-card
cutoffs are preserved exactly, with no nonzero-rho assumption needed. -/
theorem ghost_phase_capped_moving_history_eq_absolute (n : ℕ) :
    ghostPhaseCappedMovingDampedHistory a h η β V ρ visitCap edgeCap n =
      ghostPhaseCappedDampedHistory a h η β V ρ visitCap edgeCap n := by
  have he := finite_alternating_pairing_conjugate
    (fun j => ghostPhaseTensorShift (fun p => h p j))
    (fun j => ghostPhaseCappedDampedVisit (fun p => a p j) (fun p => h p j)
      (fun p => η p j) β (fun p => ρ p j) (visitCap j))
    (fun j => ghostPhaseCappedDampedEdge (fun p => a p (j + 1)) (fun p => a p j)
      (fun p => h p (j + 1)) (fun p => h p j) β V
      (fun p => ρ p (j + 1)) (fun p => ρ p j) (edgeCap j))
    (fun z => ∏ p, ghostPhaseRunInitial (a p 0) (β p) (V p) (z p))
    (fun z => ∏ p, ghostPhaseTerminal (a p n) (z p)) n
  simpa only [ghostPhaseCappedMovingDampedHistory, ghostPhaseCappedDampedHistory,
    ghost_phase_capped_damped_visit_relative_zero, ghost_phase_capped_damped_edge_conjugation,
    ghost_phase_tensor_shift_symm_apply, ghost_phase_run_initial_shift_symm,
    ghost_phase_terminal_shift_symm] using he

/-- The capped normalized moving history equals the undamped absolute-hit
history whenever every local rho is nonzero. No cap is discarded. -/
theorem ghost_phase_capped_moving_history_eq_undamped
    (hρ : ∀ p j, ρ p j ≠ 0) (n : ℕ) :
    ghostPhaseCappedMovingDampedHistory a h η β V ρ visitCap edgeCap n =
      ghostPhaseCappedHistory a h η β V visitCap edgeCap n := by
  rw [ghost_phase_capped_moving_history_eq_absolute,
    ghost_phase_capped_damped_history_eq a h η β V ρ visitCap edgeCap hρ n]

end History
end

section
open Finset
section Joint

variable {N : Nat} {P : Fin N → Type*} [∀ g, Fintype (P g)]
  [∀ g, DecidableEq (P g)] {R : (g : Fin N) → P g → Type*}

abbrev GlobalBirthJointState (R : (g : Fin N) → P g → Type*) :=
  (g : Fin N) → GlobalBirthHistoryState (R g)

abbrev GlobalBirthJointPhase (R : (g : Fin N) → P g → Type*) :=
  (g : Fin N) → (p : P g) → GhostPhaseState (R g p)

def GlobalBirthJointCoherent (a : (g : Fin N) → P g → Bool)
    (s : GlobalBirthJointState R) : Prop :=
  ∀ g, GlobalBirthMemoryCoherent (ghostPhaseActivitySupport (a g)) (s g).1 (s g).2

noncomputable def globalBirthJointReadout (a : (g : Fin N) → P g → Bool)
    (s : GlobalBirthJointState R) : GlobalBirthJointPhase R :=
  fun g => globalBirthMemoryReadout (ghostPhaseActivitySupport (a g)) (s g).1 (s g).2

def globalBirthJointLength (s : GlobalBirthJointState R) : Nat :=
  ∑ g, (s g).2.1

noncomputable def globalBirthJointPending (z : GlobalBirthJointPhase R) : Nat :=
  ∑ g, (ghostPhasePendingSupport (z g)).card

def globalBirthJointRawCutoff (cap : Nat) (G : GlobalBirthJointState R → ℂ)
    (s : GlobalBirthJointState R) : ℂ :=
  if globalBirthJointLength s ≤ cap then G s else 0

noncomputable def globalBirthJointPhaseCutoff (cap : Nat) (F : GlobalBirthJointPhase R → ℂ)
    (z : GlobalBirthJointPhase R) : ℂ :=
  if globalBirthJointPending z ≤ cap then F z else 0

theorem global_birth_coherent_readout_pending_card {Q : Type*}
    [Fintype Q] [DecidableEq Q] {S : Q → Type*}
    (active born : Finset Q) (q : FiniteOrderedTuple (Σ p, S p))
    (hq : GlobalBirthMemoryCoherent active born q) :
    (ghostPhasePendingSupport (globalBirthMemoryReadout active born q)).card = q.1 := by
  rw [global_birth_coherent_readout_pending_support active born q hq]
  have hinj : Function.Injective (fun j => (q.2 j).1) := hq.label_injective
  rw [Finset.card_image_of_injective _ hinj]
  simp only [card_univ, Fintype.card_fin]

theorem global_birth_joint_readout_pending
    (a : (g : Fin N) → P g → Bool) (s : GlobalBirthJointState R)
    (hs : GlobalBirthJointCoherent a s) :
    globalBirthJointPending (globalBirthJointReadout a s) = globalBirthJointLength s := by
  apply Finset.sum_congr rfl
  intro g _
  exact global_birth_coherent_readout_pending_card _ _ _ (hs g)

theorem global_birth_joint_cutoff_readout
    (a : (g : Fin N) → P g → Bool) (cap : Nat)
    (G : GlobalBirthJointState R → ℂ) (F : GlobalBirthJointPhase R → ℂ)
    (hGF : ∀ s, GlobalBirthJointCoherent a s → G s = F (globalBirthJointReadout a s))
    (s : GlobalBirthJointState R) (hs : GlobalBirthJointCoherent a s) :
    globalBirthJointRawCutoff cap G s =
      globalBirthJointPhaseCutoff cap F (globalBirthJointReadout a s) := by
  unfold globalBirthJointRawCutoff globalBirthJointPhaseCutoff
  rw [global_birth_joint_readout_pending a s hs, hGF s hs]

variable [∀ g p, AddGroup (R g p)] [∀ g p, Fintype (R g p)]
  [∀ g p, DecidableEq (R g p)]

noncomputable def globalBirthJointRawRow
    {a b : (g : Fin N) → P g → Bool}
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (cap : Nat) (G : GlobalBirthJointState R → ℂ)
    (s : GlobalBirthJointState R) : ℂ :=
  finTensorRow N (fun g K t => globalBirthRawStepRow (step g)
    (fun H q => K (H, q)) t.1 t.2) (globalBirthJointRawCutoff cap G) s

noncomputable def globalBirthJointPhaseRow
    {a b : (g : Fin N) → P g → Bool}
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (cap : Nat) (F : GlobalBirthJointPhase R → ℂ)
    (z : GlobalBirthJointPhase R) : ℂ :=
  finTensorRow N (fun g => globalBirthRawStepPhaseRow (step g))
    (globalBirthJointPhaseCutoff cap F) z

/-- The actual group rows commute with readout when the one joint cutoff
is applied to the completed output, regardless of the continuation's shape. -/
theorem global_birth_joint_raw_row_intertwines
    {a b : (g : Fin N) → P g → Bool}
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (cap : Nat) (G : GlobalBirthJointState R → ℂ) (F : GlobalBirthJointPhase R → ℂ)
    (hGF : ∀ s, GlobalBirthJointCoherent b s → G s = F (globalBirthJointReadout b s))
    (s : GlobalBirthJointState R) (hs : GlobalBirthJointCoherent a s) :
    globalBirthJointRawRow step cap G s =
      globalBirthJointPhaseRow step cap F (globalBirthJointReadout a s) := by
  unfold globalBirthJointRawRow globalBirthJointPhaseRow globalBirthJointReadout
  apply fin_tensor_row_intertwines_on N
    (S := fun g => GlobalBirthHistoryState (R g))
    (T := fun g => GlobalBirthHistoryState (R g))
    (X := fun g => (p : P g) → GhostPhaseState (R g p))
    (Y := fun g => (p : P g) → GhostPhaseState (R g p))
    (fun g K t => globalBirthRawStepRow (step g) (fun H q => K (H, q)) t.1 t.2)
    (fun g => globalBirthRawStepPhaseRow (step g))
    (fun g t => globalBirthMemoryReadout (ghostPhaseActivitySupport (a g)) t.1 t.2)
    (fun g t => globalBirthMemoryReadout (ghostPhaseActivitySupport (b g)) t.1 t.2)
    (fun g t => GlobalBirthMemoryCoherent (ghostPhaseActivitySupport (a g)) t.1 t.2)
    (fun g t => GlobalBirthMemoryCoherent (ghostPhaseActivitySupport (b g)) t.1 t.2)
  · intro g t ht K L hKL
    exact global_birth_raw_step_intertwines (step g) t.1 t.2 ht
      (fun H q => K (H, q)) L (fun H q hq _ => hKL (H, q) hq)
  · intro t ht
    exact global_birth_joint_cutoff_readout b cap G F hGF t ht
  · exact hs

end Joint
end

section
open Finset
theorem fin_tensor_row_kernel (n : Nat) {S T : Fin n → Type*} [∀ g, Fintype (T g)]
    (K : (g : Fin n) → T g → S g → ℂ)
    (F : ((g : Fin n) → T g) → ℂ) (s : (g : Fin n) → S g) :
    finTensorRow n (fun g G w => ∑ z, K g z w * G z) F s =
      ∑ z, (∏ g, K g (z g) (s g)) * F z := by
  classical
  induction n with
  | zero =>
      simp only [finTensorRow, Fintype.prod_empty, one_mul, Fintype.sum_unique]
      exact congrArg F (Subsingleton.elim _ _)
  | succ n ih =>
      simp only [finTensorRow, ih, mul_sum]
      rw [← (Fin.consEquiv T).sum_comp]
      rw [Fintype.sum_prod_type]
      apply sum_congr rfl
      intro t _
      apply sum_congr rfl
      intro u _
      simp only [Fin.consEquiv, Equiv.coe_fn_mk, Fin.prod_univ_succ,
        Fin.cons_zero, Fin.cons_succ, Fin.tail]
      rw [mul_assoc]
end

section
open Finset
theorem finite_alternating_pairing_complex_trace {X : Type*} [Fintype X]
    (G E : ℕ → X → X → ℝ) (f q : X → ℝ) (n : ℕ) :
    (finiteAlternatingPairing G E f q n : ℂ) =
      ∑ x : Fin (2 * n + 2) → X,
        (q (x (Fin.last (2 * n + 1))) : ℂ) *
          ((f (x 0) : ℂ) * ∏ j : Fin (2 * n + 1),
            ((finiteAlternatingKernel G E j.val (x j.succ) (x j.castSucc) : ℝ) : ℂ)) := by
  have ht := (finite_chronological_trace_expansion
    (finiteAlternatingKernel G E) f q (2 * n + 1)).symm
  simpa only [finiteAlternatingPairing, finiteChronologicalPrefix,
    Complex.ofReal_sum, Complex.ofReal_mul, Complex.ofReal_prod] using
    congrArg (fun r : ℝ => (r : ℂ)) ht

theorem complex_trace_eq_real_alternating {X : Type*} [Fintype X]
    (G E : ℕ → X → X → ℝ) (K : ℕ → X → X → ℂ)
    (f q : X → ℝ) (n : ℕ)
    (hK : ∀ j < 2 * n + 1, ∀ z w,
      K j z w = ((finiteAlternatingKernel G E j z w : ℝ) : ℂ)) :
    (∑ x : Fin (2 * n + 2) → X,
      (q (x (Fin.last (2 * n + 1))) : ℂ) *
        ((f (x 0) : ℂ) * ∏ j : Fin (2 * n + 1), K j.val (x j.succ) (x j.castSucc))) =
      (finiteAlternatingPairing G E f q n : ℂ) := by
  rw [finite_alternating_pairing_complex_trace]
  apply sum_congr rfl
  intro x _
  congr 2
  apply prod_congr rfl
  intro j _
  exact hK j.val j.isLt _ _
end

section
open Finset
section Ledger
variable {K L X : Type*} (E : K → X → Type*)
  (target : ∀ k x, E k x → X) (update : ∀ k, L → (x : X) → E k x → L)

def finiteLedgerEventTarget (k : K) (s : L × X) (e : E k s.2) : L × X :=
  (update k s.1 s.2 e, target k s.2 e)

def finiteEventPathLedger : ∀ ks, L → (x : X) → FiniteEventPath E target ks x → L
  | [], l, _, _ => l
  | k :: ks, l, x, ⟨e, p⟩ =>
      finiteEventPathLedger ks (update k l x e) (target k x e) p

def finiteLedgerEventPathEquiv : ∀ ks (l : L) (x : X),
    FiniteEventPath (fun k (s : L × X) => E k s.2)
      (finiteLedgerEventTarget E target update) ks (l, x) ≃ FiniteEventPath E target ks x
  | [], _, _ => Equiv.refl _
  | k :: ks, l, x =>
      Equiv.sigmaCongrRight (fun e : E k x =>
        finiteLedgerEventPathEquiv ks (update k l x e) (target k x e))

theorem finite_ledger_event_path_terminal (ks : List K) (l : L) (x : X)
    (p : FiniteEventPath (fun k (s : L × X) => E k s.2)
      (finiteLedgerEventTarget E target update) ks (l, x)) :
    finiteEventPathTerminal (fun k (s : L × X) => E k s.2)
      (finiteLedgerEventTarget E target update) ks (l, x) p =
    (finiteEventPathLedger E target update ks l x (finiteLedgerEventPathEquiv E target update ks l x p),
      finiteEventPathTerminal E target ks x (finiteLedgerEventPathEquiv E target update ks l x p)) := by
  induction ks generalizing l x with
  | nil => rfl
  | cons k ks ih =>
      rcases p with ⟨e, p⟩
      exact ih (update k l x e) (target k x e) p

theorem finite_ledger_event_path_weight (w : ∀ k x, E k x → ℝ)
    (ks : List K) (l : L) (x : X)
    (p : FiniteEventPath (fun k (s : L × X) => E k s.2)
      (finiteLedgerEventTarget E target update) ks (l, x)) :
    finiteEventPathWeight (fun k (s : L × X) => E k s.2)
      (finiteLedgerEventTarget E target update) (fun k s => w k s.2) ks (l, x) p =
      finiteEventPathWeight E target w ks x (finiteLedgerEventPathEquiv E target update ks l x p) := by
  induction ks generalizing l x with
  | nil => rfl
  | cons k ks ih =>
      rcases p with ⟨e, p⟩
      exact congrArg (w k x e * ·) (ih (update k l x e) (target k x e) p)

variable [∀ k x, Fintype (E k x)]

/-- A deterministic ledger can be removed from the state of the path sum.
Every dependence on its history is retained in a pulled-back path phase. -/
theorem finite_ledger_event_path_action_memory
    (w : ∀ k x, E k x → ℝ) (ks : List K)
    (phase : ∀ s : L × X, FiniteEventPath (fun k s => E k s.2)
      (finiteLedgerEventTarget E target update) ks s → ℂ)
    (F : X → ℂ) (l : L) (x : X) :
    finiteEventPathAction (fun k (s : L × X) => E k s.2)
      (finiteLedgerEventTarget E target update) (fun k s => w k s.2) ks phase
      (fun s => F s.2) (l, x) =
    finiteEventPathAction E target w ks
      (fun y p => phase (l, y) ((finiteLedgerEventPathEquiv E target update ks l y).symm p)) F x := by
  classical
  let _ := finiteEventPathFintype E target ks x
  let _ := finiteEventPathFintype (fun k (s : L × X) => E k s.2)
    (finiteLedgerEventTarget E target update) ks (l, x)
  unfold finiteEventPathAction
  rw [← (finiteLedgerEventPathEquiv E target update ks l x).symm.sum_comp]
  apply sum_congr rfl
  intro p _
  rw [finite_ledger_event_path_weight, finite_ledger_event_path_terminal]
  simp only [Equiv.apply_symm_apply]

end Ledger
end

section
open Finset Classical
noncomputable def physicalGhostRetention {P : Type*} (n : P → ℕ) (q ρ : ℝ)
    (z : UnrestrictedResidueParticle n) : ℝ :=
  if unrestrictedResidueHit z then q / ρ ^ 2 else 1

noncomputable def physicalGhostTermination {P : Type*} (n : P → ℕ) (q ρ : ℝ)
    (z : UnrestrictedResidueParticle n) : ℝ :=
  if unrestrictedResidueHit z then -((1 - q) / ρ) else 0

noncomputable def physicalGhostBirth {P : Type*} (n : P → ℕ) (q ρ V : ℝ)
    (z : UnrestrictedResidueParticle n) : ℝ :=
  if unrestrictedResidueHit z then -((1 - q) * V / ρ) else 0

noncomputable def physicalBoundedGhostOperator {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (q ρ V : ℝ) (t B : ℕ) :=
  boundedOrderedGhostOperator (P := P) (physicalGhostRetention n q ρ)
    (physicalGhostTermination n q ρ) (physicalGhostBirth n q ρ V)
    (unrestrictedResidueWeight μ) t B

theorem physical_ghost_exponent_eq {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ)
    (q ρ V v : ℝ) (hq : q ≤ 1) (hρ : 0 ≤ ρ) (hV : 0 ≤ V) :
    (∑ z : UnrestrictedResidueParticle n,
      (|physicalGhostBirth n q ρ V z| + |physicalGhostTermination n q ρ z|) *
        unrestrictedResidueWeight μ z * v) =
      ((1 - q) * V / ρ + (1 - q) / ρ) * v * ∑ p, μ p := by
  have hη : 0 ≤ 1 - q := sub_nonneg.mpr hq
  have hD : 0 ≤ (1 - q) / ρ := div_nonneg hη hρ
  have hC : 0 ≤ (1 - q) * V / ρ := div_nonneg (mul_nonneg hη hV) hρ
  rw [Fintype.sum_sigma]
  calc
    _ = ∑ p, (((1 - q) * V / ρ + (1 - q) / ρ) * μ p * v) := by
      apply sum_congr rfl
      intro p _
      rw [sum_eq_single (0 : ZMod (n p))]
      · simp [physicalGhostBirth, physicalGhostTermination, unrestrictedResidueHit,
          unrestrictedResidueWeight, abs_of_nonneg hC, abs_of_nonneg hD]
      · intro r _ hr
        simp [physicalGhostBirth, physicalGhostTermination, unrestrictedResidueHit, hr]
      · simp
    _ = _ := by
      rw [mul_sum]
      apply sum_congr rfl
      intro p _
      ring

theorem physical_bounded_ghost_symmetric {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (q ρ V : ℝ) (t B : ℕ)
    (f : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
    (hf : BoundedOrderedSymmetric f) :
    BoundedOrderedSymmetric (physicalBoundedGhostOperator n μ q ρ V t B f) :=
  bounded_ordered_ghost_symmetric _ _ _ _ t B f hf

theorem physical_bounded_ghost_energy_le {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ)
    (q ρ V v : ℝ) (t B : ℕ) (hμ : ∀ p, 0 < μ p)
    (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (hρ : 0 < ρ) (hV : 0 ≤ V) (hv : 0 < v)
    (hD : q / ρ ^ 2 + ((1 - q) / ρ) / v ≤ 1)
    (hC : q / ρ ^ 2 + ((1 - q) * V / ρ) / v ≤ 1)
    (f : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
    (hf : BoundedOrderedSymmetric f) :
    finiteWeightedEnergy (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ))
      (physicalBoundedGhostOperator n μ q ρ V t B f) ≤
      Real.exp (((1 - q) * V / ρ + (1 - q) / ρ) * v * ∑ p, μ p) *
        finiteWeightedEnergy (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ)) f := by
  have hη : 0 ≤ 1 - q := sub_nonneg.mpr hq1
  have hD0 : 0 ≤ (1 - q) / ρ := div_nonneg hη hρ.le
  have hC0 : 0 ≤ (1 - q) * V / ρ := div_nonneg (mul_nonneg hη hV) hρ.le
  have hA' (z : UnrestrictedResidueParticle n) : 0 ≤ physicalGhostRetention n q ρ z := by
    unfold physicalGhostRetention
    split_ifs
    · exact div_nonneg hq0 (sq_nonneg ρ)
    · exact zero_le_one
  have hD' (z : UnrestrictedResidueParticle n) :
      physicalGhostRetention n q ρ z + |physicalGhostTermination n q ρ z| / v ≤ 1 := by
    by_cases hz : unrestrictedResidueHit z
    · simpa [physicalGhostRetention, physicalGhostTermination, hz, abs_of_nonneg hD0] using hD
    · simp [physicalGhostRetention, physicalGhostTermination, hz]
  have hC' (z : UnrestrictedResidueParticle n) :
      physicalGhostRetention n q ρ z + |physicalGhostBirth n q ρ V z| / v ≤ 1 := by
    by_cases hz : unrestrictedResidueHit z
    · simpa [physicalGhostRetention, physicalGhostBirth, hz, abs_of_nonneg hC0] using hC
    · simp [physicalGhostRetention, physicalGhostBirth, hz]
  have h := bounded_ordered_ghost_energy_le μ
    (physicalGhostRetention n q ρ) (physicalGhostTermination n q ρ)
    (physicalGhostBirth n q ρ V) (unrestrictedResidueWeight μ) (fun _ => v) t B
    (fun p => (hμ p).le) hA' (fun z => hμ z.1) (fun _ => hv) hD' hC' f hf
  rw [physical_ghost_exponent_eq n μ q ρ V v hq1 hρ.le hV] at h
  exact h

/-- A group-independent energy constant, independent of memory cutoff and
the number or sizes of the prime moduli. -/
noncomputable def physicalGhostUniformEnergyBound (ρ vmax v : ℝ) : ℝ :=
  Real.exp (2 * (vmax + 1) * v / ρ)

theorem physical_bounded_ghost_energy_le_uniform {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ)
    (q ρ V v vmax : ℝ) (t B : ℕ) (hμ : ∀ p, 0 < μ p)
    (hmass : ∑ p, μ p ≤ 2) (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (hρ : 0 < ρ) (hV : 0 ≤ V) (hVmax : V ≤ vmax) (hv : 0 < v)
    (hD : q / ρ ^ 2 + ((1 - q) / ρ) / v ≤ 1)
    (hC : q / ρ ^ 2 + ((1 - q) * V / ρ) / v ≤ 1)
    (f : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
    (hf : BoundedOrderedSymmetric f) :
    finiteWeightedEnergy (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ))
      (physicalBoundedGhostOperator n μ q ρ V t B f) ≤
      physicalGhostUniformEnergyBound ρ vmax v *
        finiteWeightedEnergy (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ)) f := by
  have hη : 0 ≤ 1 - q := sub_nonneg.mpr hq1
  have hη1 : 1 - q ≤ 1 := sub_le_self _ hq0
  have hA0 : 0 ≤ (1 - q) * V / ρ + (1 - q) / ρ :=
    add_nonneg (div_nonneg (mul_nonneg hη hV) hρ.le) (div_nonneg hη hρ.le)
  have hAV : (1 - q) * V ≤ vmax := by
    have hAV' : (1 - q) * V ≤ V := by
      simpa only [one_mul] using mul_le_mul_of_nonneg_right hη1 hV
    exact hAV'.trans hVmax
  have hA : (1 - q) * V / ρ + (1 - q) / ρ ≤ (vmax + 1) / ρ := by
    rw [add_div]
    exact add_le_add (div_le_div_of_nonneg_right hAV hρ.le)
      (div_le_div_of_nonneg_right hη1 hρ.le)
  have he : ((1 - q) * V / ρ + (1 - q) / ρ) * v * (∑ p, μ p) ≤
      2 * (vmax + 1) * v / ρ := by
    calc
      _ ≤ ((1 - q) * V / ρ + (1 - q) / ρ) * v * 2 :=
        mul_le_mul_of_nonneg_left hmass (mul_nonneg hA0 hv.le)
      _ ≤ ((vmax + 1) / ρ) * v * 2 :=
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hA hv.le) (by norm_num)
      _ = _ := by ring
  exact (physical_bounded_ghost_energy_le n μ q ρ V v t B hμ hq0 hq1 hρ hV hv hD hC f hf).trans
    (mul_le_mul_of_nonneg_right (Real.exp_le_exp.mpr he)
      (sum_nonneg fun s _ => mul_nonneg
        (boundedOrderedStateWeight_nonneg μ (unrestrictedResidueWeight μ)
          (fun p => (hμ p).le) (fun z => (hμ z.1).le) s) (sq_nonneg _)))
end

section
open Finset Classical
abbrev BoundedGhostEvent {P Z : Type*} (t B : ℕ)
    (s : BoundedOrderedState P Z t B) :=
  Σ b : Fin (B + 1), Finset (Fin s.2.1.val) × (Fin b.val → Z)

noncomputable def boundedGhostEventTarget {P Z : Type*} (t B : ℕ)
    (s : BoundedOrderedState P Z t B) (e : BoundedGhostEvent t B s) :
    BoundedOrderedState P Z t B :=
  let q := retainedBirthTuple s.2.2 e.2.1 e.2.2
  if h : q.1 ≤ B then (s.1, ⟨⟨q.1, Nat.lt_succ_of_le h⟩, q.2⟩) else s

noncomputable def boundedGhostEventWeight {P Z : Type*} (A D C ν : Z → ℝ)
    (t B : ℕ) (s : BoundedOrderedState P Z t B) (e : BoundedGhostEvent t B s) : ℝ :=
  if e.2.1.card + e.1.val ≤ B then
    ((∏ j ∈ e.2.1, A (s.2.2 j)) * (∏ j ∈ univ \ e.2.1, D (s.2.2 j))) *
      (∏ j, C (e.2.2 j) * ν (e.2.2 j)) / (e.1.val.factorial : ℝ)
  else 0

noncomputable def boundedGhostPositiveEventWeight {P Z : Type*} (A D C ν : Z → ℝ)
    (t B : ℕ) (s : BoundedOrderedState P Z t B) (e : BoundedGhostEvent t B s) : ℝ :=
  boundedGhostEventWeight A (fun z => |D z|) (fun z => |C z|) ν t B s e

theorem boundedGhostEventWeight_nonneg {P Z : Type*} (A D C ν : Z → ℝ)
    (hA : ∀ z, 0 ≤ A z) (hD : ∀ z, 0 ≤ D z) (hC : ∀ z, 0 ≤ C z)
    (hν : ∀ z, 0 ≤ ν z) (t B : ℕ) (s : BoundedOrderedState P Z t B)
    (e : BoundedGhostEvent t B s) : 0 ≤ boundedGhostEventWeight A D C ν t B s e := by
  unfold boundedGhostEventWeight
  split_ifs
  · exact div_nonneg (mul_nonneg
      (mul_nonneg (prod_nonneg fun j _ => hA _) (prod_nonneg fun j _ => hD _))
      (prod_nonneg fun j _ => mul_nonneg (hC _) (hν _))) (Nat.cast_nonneg _)
  · exact le_rfl

theorem boundedGhostPositiveEventWeight_nonneg {P Z : Type*} (A D C ν : Z → ℝ)
    (hA : ∀ z, 0 ≤ A z) (hν : ∀ z, 0 ≤ ν z) (t B : ℕ)
    (s : BoundedOrderedState P Z t B) (e : BoundedGhostEvent t B s) :
    0 ≤ boundedGhostPositiveEventWeight A D C ν t B s e := by
  exact boundedGhostEventWeight_nonneg A (fun z => |D z|) (fun z => |C z|) ν
    hA (fun z => abs_nonneg _) (fun z => abs_nonneg _) hν t B s e

theorem bounded_ordered_ghost_eq_event_sum {P Z : Type*}
    [Fintype Z] [DecidableEq Z] (A D C ν : Z → ℝ) (t B : ℕ)
    (f : BoundedOrderedState P Z t B → ℂ) (s : BoundedOrderedState P Z t B) :
    boundedOrderedGhostOperator A D C ν t B f s =
      ∑ e : BoundedGhostEvent t B s, (boundedGhostEventWeight A D C ν t B s e : ℂ) *
        f (boundedGhostEventTarget t B s e) := by
  change symmetricOrderedGhostRow s.2.2 A D C ν B (boundedOrderedZeroExtension f s.1) = _
  unfold symmetricOrderedGhostRow
  rw [Fintype.sum_sigma]
  simp only [Fintype.sum_prod_type]
  rw [← Fin.sum_univ_eq_sum_range]
  apply sum_congr rfl
  intro b _
  rw [powerset_univ]
  apply sum_congr rfl
  intro retained _
  apply sum_congr rfl
  intro births _
  by_cases h : retained.card + b.val ≤ B
  · simp [boundedGhostEventWeight, boundedGhostEventTarget, retainedBirthTuple,
      boundedOrderedZeroExtension, h]
  · simp [boundedGhostEventWeight, h]

theorem bounded_ordered_ghost_positive_eq_event_sum {P Z : Type*}
    [Fintype Z] [DecidableEq Z] (A D C ν : Z → ℝ) (t B : ℕ)
    (f : BoundedOrderedState P Z t B → ℂ) (s : BoundedOrderedState P Z t B) :
    boundedOrderedGhostOperator A (fun z => |D z|) (fun z => |C z|) ν t B f s =
      ∑ e : BoundedGhostEvent t B s,
        (boundedGhostPositiveEventWeight A D C ν t B s e : ℂ) *
          f (boundedGhostEventTarget t B s e) := by
  exact bounded_ordered_ghost_eq_event_sum A (fun z => |D z|) (fun z => |C z|) ν t B f s

theorem boundedGhostEventWeight_abs {P Z : Type*} (A D C ν : Z → ℝ)
    (hA : ∀ z, 0 ≤ A z) (hν : ∀ z, 0 ≤ ν z) (t B : ℕ)
    (s : BoundedOrderedState P Z t B) (e : BoundedGhostEvent t B s) :
    |boundedGhostEventWeight A D C ν t B s e| =
      boundedGhostEventWeight A (fun z => |D z|) (fun z => |C z|) ν t B s e := by
  unfold boundedGhostEventWeight
  split_ifs
  · simp only [abs_div, abs_mul, abs_prod, abs_of_nonneg (Nat.cast_nonneg e.1.val.factorial : (0 : ℝ) ≤ _)]
    simp only [abs_of_nonneg (hA _), abs_of_nonneg (hν _)]
  · exact abs_zero
end

