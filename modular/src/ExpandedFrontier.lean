section

/- The literal capped promotion average gains the omission probability.
The individual operator bound is derived from the actual event weights;
there is no assumed operator estimate or scalar rarity premise. -/

open Finset
open scoped Classical

namespace Bounty

theorem uniform_probability_sum_of_card_bound {A : Type*} [Fintype A]
    (R : A → Prop) [DecidablePred R] {δ : ℝ}
    (h : ((univ.filter R).card : ℝ) / (Fintype.card A : ℝ) ≤ δ) :
    (∑ a, if R a then 1 / (Fintype.card A : ℝ) else 0) ≤ δ := by
  calc
    _ = (∑ a, if R a then (1 : ℝ) else 0) / (Fintype.card A : ℝ) := by
      rw [sum_div]
      apply sum_congr rfl
      intro a _
      split_ifs <;> simp
    _ ≤ δ := by simpa only [sum_boole] using h

noncomputable def smallSourcePromotionAverage {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {P : G → Type*} [∀ g, Fintype (P g)] {J ell : ℕ}
    (n : ∀ g, P g → ℕ) (labels : PhysicalMarkLists Ps J ell) (D_B : ℕ) (k : ℤ)
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ) (t : G → ℕ) (B : ℕ)
    (phase : ∀ σ : S → Equiv.Perm (PhysicalSlots J ell),
      UnrestrictedProductPhase n (fun _ => -(k * (smallSourcePermutationDilation labels D_B σ : ℤ)))
        (fun _ => (smallSourcePermutationDilation labels D_B σ : ℤ)) t B)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ) :
    ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ := by
  let _ : DecidableEq S := Classical.decEq _
  let _ : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
  exact unrestrictedPromotionAverage n
    (fun σ _ => -(k * (smallSourcePermutationDilation labels D_B σ : ℤ)))
    (fun σ _ => (smallSourcePermutationDilation labels D_B σ : ℤ)) μ ρ V t B
    (fun _ => 1 / (Fintype.card (S → Equiv.Perm (PhysicalSlots J ell)) : ℝ)) phase f

theorem small_source_promotion_energy_le {S G : Type*} [Fintype S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Type*} [∀ g, Fintype (P g)] {J ell : ℕ}
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (labels : PhysicalMarkLists Ps J ell)
    (hP : ∀ g p, p ∈ Ps g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (Ps g) (Ps h)))
    (D_B : ℕ) (k : ℤ) (hp : ∀ g p, (n g p).Prime)
    (hk : ∀ g p, ¬ (n g p : ℤ) ∣ k)
    (hlt : ∀ g p, ∀ A : PrimeOmissionChoices (physicalGroupMarks labels) ell,
      primeOmissionProduct (physicalGroupMarks labels) ell A < n g p)
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ) (t : G → ℕ) (B : ℕ)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, t g ≤ T)
    (phase : ∀ σ : S → Equiv.Perm (PhysicalSlots J ell),
      UnrestrictedProductPhase n (fun _ => -(k * (smallSourcePermutationDilation labels D_B σ : ℤ)))
        (fun _ => (smallSourcePermutationDilation labels D_B σ : ℤ)) t B)
    (hphase : ∀ σ state e, ‖phase σ state e‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (smallSourcePromotionAverage n labels D_B k μ ρ V t B phase f) ≤
      ((B : ℝ) / (((J + ell).choose ell) ^ Fintype.card S : ℕ)) *
        unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
          finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  let _ : DecidableEq S := Classical.decEq _
  let _ : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
  have hπ : ∀ _σ : S → Equiv.Perm (PhysicalSlots J ell),
      0 ≤ 1 / (Fintype.card (S → Equiv.Perm (PhysicalSlots J ell)) : ℝ) := by
    intro σ
    positivity
  have hπmass : (∑ _σ : S → Equiv.Perm (PhysicalSlots J ell),
      1 / (Fintype.card (S → Equiv.Perm (PhysicalSlots J ell)) : ℝ)) ≤ 1 := by
    have hc : (Fintype.card (S → Equiv.Perm (PhysicalSlots J ell)) : ℝ) ≠ 0 := by
      exact_mod_cast Fintype.card_ne_zero
    simp only [sum_const, card_univ, nsmul_eq_mul, one_div, mul_inv_cancel₀ hc, le_refl]
  apply unrestricted_promotion_average_energy_le n _ _ μ ρ V t B _ hπ hπmass
    hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht phase hphase (by positivity) _ f hf
  intro state hB
  apply uniform_probability_sum_of_card_bound
  have h := small_source_pending_eligible_fraction_le labels hP hdis n state D_B k
    (fun g j => hp g ((state g).2.2 j).1)
    (fun g j => hk g ((state g).2.2 j).1)
    (fun g j A => hlt g ((state g).2.2 j).1 A)
  exact h.trans (div_le_div_of_nonneg_right (Nat.cast_le.mpr hB) (Nat.cast_nonneg _))

end Bounty
end

