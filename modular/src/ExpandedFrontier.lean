/- The actual original path offset is indexed by all numbered big selected
data, so the original fixed-plan multiplier supplies the moment's step law. -/

open scoped Classical
namespace Bounty
section Offset
variable {I : Type} {N M J ell n : ℕ} {P : Fin N → Finset ℕ}
  (groups : Finset (Fin N)) (e : {g // g ∉ groupsᶜ} ≃ Fin M)
  (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
  (hC : ∀ i : patterns, ∀ g : ↥groupsᶜ, C i.val g.val = ∅)
  (k : ℕ → I → ℤ)
  (p : PhysicalRootSmallPlan (P := P) (J := J) (ell := ell) (n := n) groups patterns)

noncomputable def physicalRootNumberedPlanOffset
    (dn : PhysicalSelectedData (fun g => P (e.symm g).val) ell
      (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val)) :
    Fin (n + 2) → ℤ :=
  let db := (physicalSelectedGroupReindex e (fun g => P g.val)
    (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val g.val)).symm dn
  let old := physicalRootSmallPlanPath groups patterns C hC p db
  physicalPathSelectedOffset C k old.1 old.2

theorem physical_root_numbered_plan_offset_step
    (dn : PhysicalSelectedData (fun g => P (e.symm g).val) ell
      (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val))
    (j : Fin (n + 1)) :
    physicalRootNumberedPlanOffset groups e patterns C hC k p dn j.succ =
      physicalRootNumberedPlanOffset groups e patterns C hC k p dn j.castSucc +
      physicalRootPlanMultiplier groups patterns C hC k p j *
        (physicalD (fun g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val)
          (physicalPermuteLabels (dn.2.2.1 j) (dn.2.1 j.castSucc)) (dn.1 j) : ℤ) := by
  have h := physical_root_plan_offset_step groups patterns C hC k p e
    ((physicalSelectedGroupReindex e (fun g => P g.val)
      (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val g.val)).symm dn) j
  simpa only [physicalRootNumberedPlanOffset, physicalRootNumberedBigData,
    Equiv.apply_symm_apply] using h

end Offset

theorem physical_numbered_big_pools_disjoint
    {N M : ℕ} {P : Fin N → Finset ℕ} (groups : Finset (Fin N))
    (e : {g // g ∉ groupsᶜ} ≃ Fin M)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) :
    Pairwise (fun g h => Disjoint (P (e.symm g).val) (P (e.symm h).val)) := by
  intro a b hab
  apply hdis
  intro h
  exact hab (e.symm.injective (Subtype.ext h))

end Bounty
