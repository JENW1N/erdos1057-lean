section

/- Signed original-event suffixes for a fixed birth forest preserve pending-memory symmetry. -/

open Finset Classical
namespace Bounty
section Suffix
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
    [∀ g, Fintype (P g)] [∀ g, DecidableEq (P g)]
    (n : (g : Fin N) → P g → ℕ) [∀ g p, NeZero (n g p)]
    {M : Fin N → ℕ} (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (ω : ∀ k c, A k c → ℝ) (μ : (g : Fin N) → P g → ℝ)
    (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (steps : List (Option (J ⊕ K)))
    (residual : ∀ (tag : Option (J ⊕ K)) s, FullPermutationMixedEvent n S B A Δ D tag s → ℂ)
    (initial : (g : Fin N) → Finset (P g))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))
    (θ : (Fin (Fintype.card (FullMixedBirthAddress S B steps)) ×
      Fin (Fintype.card (FullMixedBirthAddress S B steps))) → ℝ)
    (encode : ((g : Fin N) × P g) → ℤ)

noncomputable def fullMixedForestStagePhase (i : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (steps.get i) s) : ℂ :=
  residual (steps.get i) s e *
    (if FullMixedLocalBirthAvoids n S B A Δ D initial (steps.get i) s e then 1 else 0) *
    fullMixedLocalForestFactor S B steps code θ encode i
      (fullMixedEventBirthLabel n S B A Δ D (steps.get i) s e)

omit [∀ g, Fintype (P g)] [∀ g, DecidableEq (P g)]
  [∀ g p, NeZero (n g p)] [∀ k c, Fintype (A k c)] in
theorem full_mixed_forest_stage_phase_occurrence
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x) (i : Fin steps.length) :
    let e := finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x p i
    fullMixedForestStagePhase n S B A Δ D steps residual initial code θ encode i e.1 e.2 =
      residual (steps.get i) e.1 e.2 *
        (if FullMixedLocalBirthAvoids n S B A Δ D initial (steps.get i) e.1 e.2 then 1 else 0) *
        fullMixedBirthOperationMultiplier n S B A Δ D steps code θ encode x p i := by
  dsimp only
  unfold fullMixedForestStagePhase
  rw [full_mixed_local_forest_factor_eq]

noncomputable def fullMixedForestStageRow (i : Fin steps.length)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) : ℂ :=
  let _ := fullPermutationMixedEventFintype n S B A Δ D (steps.get i) s
  ∑ e : FullPermutationMixedEvent n S B A Δ D (steps.get i) s,
    (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V (steps.get i) s e : ℂ) *
      fullMixedForestStagePhase n S B A Δ D steps residual initial code θ encode i s e *
      f (fullPermutationMixedEventTarget n S B A Δ D (steps.get i) s e)

omit [∀ g, Fintype (P g)] [∀ g, DecidableEq (P g)]
  [∀ g p, NeZero (n g p)] [∀ k c, Fintype (A k c)] in
theorem full_mixed_forest_stage_phase_reindex
    (hp : FullMixedPhaseMemoryInvariant n S B A Δ D residual)
    (i : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (τ : ∀ g, Equiv.Perm (Fin (s g).2.1.val))
    (e : FullPermutationMixedEvent n S B A Δ D (steps.get i) s) :
    fullMixedForestStagePhase n S B A Δ D steps residual initial code θ encode i
      (productMemoryReindex s τ) (fullMixedMemoryReindex n S B A Δ D (steps.get i) s τ e) =
      fullMixedForestStagePhase n S B A Δ D steps residual initial code θ encode i s e := by
  unfold fullMixedForestStagePhase FullMixedLocalBirthAvoids
  rw [hp, full_mixed_reindex_birth_labels]

omit [∀ g, DecidableEq (P g)] in
theorem full_mixed_forest_stage_row_symmetric
    (hp : FullMixedPhaseMemoryInvariant n S B A Δ D residual)
    (i : Fin steps.length)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric
      (fullMixedForestStageRow n S B A Δ D ω μ q ρ V steps residual initial code θ encode i f) := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
    fullPermutationMixedEventFintype n S B A Δ D
  intro s g τ
  rw [← product_memory_reindex_at s g τ]
  unfold fullMixedForestStageRow
  rw [← (fullMixedMemoryReindex n S B A Δ D (steps.get i) s
    (Function.update (fun h => Equiv.refl (Fin (s h).2.1.val)) g τ)).sum_comp]
  apply sum_congr rfl
  intro e _
  rw [full_mixed_reindex_weight,
    full_mixed_forest_stage_phase_reindex n S B A Δ D steps residual initial code θ encode hp,
    full_mixed_reindex_test n S B A Δ D (steps.get i) s _ e f hf]

omit [∀ g, DecidableEq (P g)] in
theorem full_mixed_forest_suffix_symmetric
    (hp : FullMixedPhaseMemoryInvariant n S B A Δ D residual)
    (start : ℕ)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric
      (finiteOperatorListAction
        (fullMixedForestStageRow n S B A Δ D ω μ q ρ V steps residual initial code θ encode)
        ((List.finRange steps.length).drop start) f) := by
  exact finite_operator_list_preserves ProductMemorySymmetric _
    (full_mixed_forest_stage_row_symmetric n S B A Δ D ω μ q ρ V
      steps residual initial code θ encode hp) _ f hf

end Suffix
end Bounty
end

section

/- The exact right-closed logarithmic partition used by the count-matched proxies. -/

open Finset

namespace Bounty

noncomputable def logarithmicCellIndex (δ : ℝ) (n : ℕ) : ℤ :=
  ⌈Real.log (n : ℝ)/δ⌉-1

noncomputable def logarithmicCellBase (δ : ℝ) (k : ℤ) : ℝ :=
  Real.exp ((k : ℝ)*δ)

noncomputable def logarithmicCellSet (δ : ℝ) (k : ℤ) : Finset ℕ :=
  Ioc ⌊logarithmicCellBase δ k⌋₊ ⌊Real.exp δ*logarithmicCellBase δ k⌋₊

noncomputable def logarithmicCellIndices (δ : ℝ) (F : Finset ℕ) : Finset ℤ :=
  F.image (logarithmicCellIndex δ)

noncomputable def primeLogarithmicProxy (L S : ℝ) (n : ℕ) : ℝ :=
  primeCellProxy L S (logarithmicCellBase (L^(-S)) (logarithmicCellIndex (L^(-S)) n)) n

theorem logarithmic_cell_base_pos (δ : ℝ) (k : ℤ) : 0 < logarithmicCellBase δ k :=
  Real.exp_pos _

theorem logarithmic_cell_index_bounds {δ : ℝ} (hδ : 0 < δ) (n : ℕ) :
    (logarithmicCellIndex δ n : ℝ)*δ < Real.log (n : ℝ) ∧
      Real.log (n : ℝ) ≤ ((logarithmicCellIndex δ n : ℝ)+1)*δ := by
  have h := Int.ceil_eq_iff.mp (rfl : ⌈Real.log (n : ℝ)/δ⌉ = ⌈Real.log (n : ℝ)/δ⌉)
  constructor
  · apply (lt_div_iff₀ hδ).mp
    simpa only [logarithmicCellIndex, Int.cast_sub, Int.cast_one] using h.1
  · apply (div_le_iff₀ hδ).mp
    simpa only [logarithmicCellIndex, Int.cast_sub, Int.cast_one, sub_add_cancel] using h.2

theorem mem_logarithmic_cell_iff {δ : ℝ} (hδ : 0 < δ) {n : ℕ} (hn : 0 < n) (k : ℤ) :
    n ∈ logarithmicCellSet δ k ↔ logarithmicCellIndex δ n = k := by
  have hnR : 0 < (n : ℝ) := Nat.cast_pos.mpr hn
  have he : Real.exp δ*logarithmicCellBase δ k = Real.exp (((k : ℝ)+1)*δ) := by
    dsimp [logarithmicCellBase]
    rw [← Real.exp_add]
    congr 1
    ring
  simp only [logarithmicCellSet, mem_Ioc, Nat.floor_lt (logarithmic_cell_base_pos δ k).le,
    Nat.le_floor_iff (mul_nonneg (Real.exp_pos δ).le (logarithmic_cell_base_pos δ k).le)]
  rw [he]
  change Real.exp ((k : ℝ)*δ) < (n : ℝ) ∧ (n : ℝ) ≤ Real.exp (((k : ℝ)+1)*δ) ↔ _
  nth_rw 1 [← Real.exp_log hnR]
  nth_rw 2 [← Real.exp_log hnR]
  rw [Real.exp_lt_exp, Real.exp_le_exp]
  rw [logarithmicCellIndex, sub_eq_iff_eq_add, Int.ceil_eq_iff]
  simp only [Int.cast_add, Int.cast_one, add_sub_cancel_right]
  rw [lt_div_iff₀ hδ, div_le_iff₀ hδ]

theorem mem_own_logarithmic_cell {δ : ℝ} (hδ : 0 < δ) {n : ℕ} (hn : 0 < n) :
    n ∈ logarithmicCellSet δ (logarithmicCellIndex δ n) :=
  (mem_logarithmic_cell_iff hδ hn _).mpr rfl

theorem logarithmic_cell_pos {δ : ℝ} {k : ℤ} {n : ℕ}
    (hn : n ∈ logarithmicCellSet δ k) : 0 < n :=
  lt_of_le_of_lt (Nat.zero_le _) (mem_Ioc.mp hn).1

theorem logarithmic_interval_fiber {δ : ℝ} (hδ : 0 < δ) (m n : ℕ) (k : ℤ) :
    (Ioc m n).filter (fun i => logarithmicCellIndex δ i = k) =
      Ioc (max m ⌊logarithmicCellBase δ k⌋₊)
        (min n ⌊Real.exp δ*logarithmicCellBase δ k⌋₊) := by
  ext i
  simp only [mem_filter, mem_Ioc, max_lt_iff, le_min_iff]
  constructor
  · rintro ⟨⟨hmi, hin⟩, hik⟩
    have hi0 : 0 < i := lt_of_le_of_lt (Nat.zero_le _) hmi
    have hc := (mem_Ioc.mp ((mem_logarithmic_cell_iff hδ hi0 k).mpr hik))
    exact ⟨⟨hmi, hc.1⟩, hin, hc.2⟩
  · rintro ⟨⟨hmi, hki⟩, hin, hik⟩
    have hi0 : 0 < i := lt_of_le_of_lt (Nat.zero_le _) hmi
    exact ⟨⟨hmi, hin⟩, (mem_logarithmic_cell_iff hδ hi0 k).mp (mem_Ioc.mpr ⟨hki, hik⟩)⟩

theorem sum_logarithmic_cell_fibers {M : Type*} [AddCommMonoid M]
    (δ : ℝ) (F : Finset ℕ) (f : ℕ → M) :
    (∑ k ∈ logarithmicCellIndices δ F, ∑ n ∈ F.filter (fun n => logarithmicCellIndex δ n = k), f n) =
      ∑ n ∈ F, f n := by
  classical
  exact sum_fiberwise_of_maps_to (fun n hn => mem_image.mpr ⟨n, hn, rfl⟩) _

theorem prime_logarithmic_proxy_eq_on_cell {L S : ℝ} (hL : 0 < L) {k : ℤ} {n : ℕ}
    (hn : n ∈ logarithmicCellSet (L^(-S)) k) :
    primeLogarithmicProxy L S n = primeCellProxy L S (logarithmicCellBase (L^(-S)) k) n := by
  unfold primeLogarithmicProxy
  rw [(mem_logarithmic_cell_iff (by positivity) (logarithmic_cell_pos hn) k).mp hn]

end Bounty
end

section

/- An original compatible forest induces the actual local prime-label forest; no head parent comes from a later event. -/

open Classical

namespace Bounty

section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K)))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)

section Ghost
variable (j : J) (sk : CoupledGhostSkeleton M B s) (births : CoupledGhostSamples M B s sk)
    (tail : FullPermutationMixedPath n S B A Δ D steps
      (fullPermutationMixedEventTarget n S B A Δ D (some (.inl j)) s ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩)))

theorem full_mixed_ghost_head_forest_restriction
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B (some (.inl j) :: steps)))) :
    let embed := fun i : Fin (Fintype.card (CoupledGhostSampleIndex M B s sk)) => (fullMixedGhostHeadSampleEmbedding S B j steps s sk) ((fullMixedGhostHeadSampleOrder S B j steps s sk) i)
    let path : FullPermutationMixedPath n S B A Δ D (some (.inl j) :: steps) s := ⟨(fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩, tail⟩
    let values := fun i => fullMixedPathBirthLabel n S B A Δ D (some (.inl j) :: steps) s path
      (fullMixedBirthOrder S B (some (.inl j) :: steps) i)
    let performed := fun i => fullMixedPathBirthPerformed n S B A Δ D (some (.inl j) :: steps) s path
      (fullMixedBirthOrder S B (some (.inl j) :: steps) i)
    birthForestCompatible performed values code →
      birthForestEqualValues (restrictedBirthCode embed code) (fun i => (⟨((fullMixedGhostHeadSampleOrder S B j steps s sk) i).1, (births ((fullMixedGhostHeadSampleOrder S B j steps s sk) i)).1⟩ : Sigma P)) ∧
        restrictedBirthAnchors embed code values = (fun _ => none) := by
  dsimp only
  intro h
  let embed := fun i : Fin (Fintype.card (CoupledGhostSampleIndex M B s sk)) => (fullMixedGhostHeadSampleEmbedding S B j steps s sk) ((fullMixedGhostHeadSampleOrder S B j steps s sk) i)
  let path : FullPermutationMixedPath n S B A Δ D (some (.inl j) :: steps) s := ⟨(fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩, tail⟩
  let values := fun i => fullMixedPathBirthLabel n S B A Δ D (some (.inl j) :: steps) s path
    (fullMixedBirthOrder S B (some (.inl j) :: steps) i)
  let performed := fun i => fullMixedPathBirthPerformed n S B A Δ D (some (.inl j) :: steps) s path
    (fullMixedBirthOrder S B (some (.inl j) :: steps) i)
  have hc : ∀ i, performed i →
      fullMixedBirthOwner S B (some (.inl j) :: steps) (fullMixedBirthOrder S B (some (.inl j) :: steps) i) = 0 →
      i ∈ Set.range embed := by
    intro i hi hu
    obtain ⟨c, he⟩ := (full_mixed_ghost_head_sample_coverage n S B A Δ D steps s j sk births tail i).mp ⟨hi, hu⟩
    refine ⟨(fullMixedGhostHeadSampleOrder S B j steps s sk).symm c, ?_⟩
    dsimp only [embed]
    rw [Equiv.apply_symm_apply]
    exact he
  have hr := compatible_zero_owner_restriction embed
    (full_mixed_ghost_head_sample_order_strictMono S B j steps s sk)
    (fun i => fullMixedBirthOwner S B (some (.inl j) :: steps) (fullMixedBirthOrder S B (some (.inl j) :: steps) i))
    (full_mixed_birth_order_owner_monotone S B (some (.inl j) :: steps))
    (fun i => full_mixed_ghost_head_sample_owner S B j steps s sk ((fullMixedGhostHeadSampleOrder S B j steps s sk) i))
    performed hc code values h
  refine ⟨?_, hr.2⟩
  intro a b hab
  have he := hr.1 a b hab
  change values (embed a) = values (embed (birthForestParentEmbedding a b)) at he
  dsimp only [values, embed, path] at he
  rw [full_mixed_ghost_head_sample_label, full_mixed_ghost_head_sample_label] at he
  exact Option.some.inj he

end Ghost

section Edge
variable (k : K) (sk : FullActiveEdgeSkeleton n (S k) B (A k) (Δ k) (D k) s) (fresh : FullActiveEdgeSamples n (S k) B (A k) (Δ k) (D k) s sk)
    (tail : FullPermutationMixedPath n S B A Δ D steps
      (fullPermutationMixedEventTarget n S B A Δ D (some (.inr k)) s ((fullPermutationEdgeBirthEquiv (J := J) n S B A Δ D s k).symm ⟨sk, fresh⟩)))

theorem full_mixed_edge_head_forest_restriction
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B (some (.inr k) :: steps)))) :
    let embed := fun i : Fin (Fintype.card (FullActiveEdgeSampleIndex n (S k) B (A k) (Δ k) (D k) s sk)) => (fullMixedEdgeHeadSampleEmbedding n S B k steps (A k) (Δ k) (D k) s sk) ((fullMixedEdgeHeadSampleOrder n S B k steps (A k) (Δ k) (D k) s sk) i)
    let path : FullPermutationMixedPath n S B A Δ D (some (.inr k) :: steps) s := ⟨(fullPermutationEdgeBirthEquiv (J := J) n S B A Δ D s k).symm ⟨sk, fresh⟩, tail⟩
    let values := fun i => fullMixedPathBirthLabel n S B A Δ D (some (.inr k) :: steps) s path
      (fullMixedBirthOrder S B (some (.inr k) :: steps) i)
    let performed := fun i => fullMixedPathBirthPerformed n S B A Δ D (some (.inr k) :: steps) s path
      (fullMixedBirthOrder S B (some (.inr k) :: steps) i)
    birthForestCompatible performed values code →
      birthForestEqualValues (restrictedBirthCode embed code) (fun i => (⟨((fullMixedEdgeHeadSampleOrder n S B k steps (A k) (Δ k) (D k) s sk) i).1, fresh ((fullMixedEdgeHeadSampleOrder n S B k steps (A k) (Δ k) (D k) s sk) i)⟩ : Sigma P)) ∧
        restrictedBirthAnchors embed code values = (fun _ => none) := by
  dsimp only
  intro h
  let embed := fun i : Fin (Fintype.card (FullActiveEdgeSampleIndex n (S k) B (A k) (Δ k) (D k) s sk)) => (fullMixedEdgeHeadSampleEmbedding n S B k steps (A k) (Δ k) (D k) s sk) ((fullMixedEdgeHeadSampleOrder n S B k steps (A k) (Δ k) (D k) s sk) i)
  let path : FullPermutationMixedPath n S B A Δ D (some (.inr k) :: steps) s := ⟨(fullPermutationEdgeBirthEquiv (J := J) n S B A Δ D s k).symm ⟨sk, fresh⟩, tail⟩
  let values := fun i => fullMixedPathBirthLabel n S B A Δ D (some (.inr k) :: steps) s path
    (fullMixedBirthOrder S B (some (.inr k) :: steps) i)
  let performed := fun i => fullMixedPathBirthPerformed n S B A Δ D (some (.inr k) :: steps) s path
    (fullMixedBirthOrder S B (some (.inr k) :: steps) i)
  have hc : ∀ i, performed i →
      fullMixedBirthOwner S B (some (.inr k) :: steps) (fullMixedBirthOrder S B (some (.inr k) :: steps) i) = 0 →
      i ∈ Set.range embed := by
    intro i hi hu
    obtain ⟨c, he⟩ := (full_mixed_edge_head_sample_coverage n S B A Δ D steps s k sk fresh tail i).mp ⟨hi, hu⟩
    refine ⟨(fullMixedEdgeHeadSampleOrder n S B k steps (A k) (Δ k) (D k) s sk).symm c, ?_⟩
    dsimp only [embed]
    rw [Equiv.apply_symm_apply]
    exact he
  have hr := compatible_zero_owner_restriction embed
    (full_mixed_edge_head_sample_order_strictMono n S B k steps (A k) (Δ k) (D k) s sk)
    (fun i => fullMixedBirthOwner S B (some (.inr k) :: steps) (fullMixedBirthOrder S B (some (.inr k) :: steps) i))
    (full_mixed_birth_order_owner_monotone S B (some (.inr k) :: steps))
    (fun i => full_mixed_edge_head_sample_owner n S B k steps (A k) (Δ k) (D k) s sk ((fullMixedEdgeHeadSampleOrder n S B k steps (A k) (Δ k) (D k) s sk) i))
    performed hc code values h
  refine ⟨?_, hr.2⟩
  intro a b hab
  have he := hr.1 a b hab
  change values (embed a) = values (embed (birthForestParentEmbedding a b)) at he
  dsimp only [values, embed, path] at he
  rw [full_mixed_edge_head_sample_label, full_mixed_edge_head_sample_label] at he
  exact Option.some.inj he

end Edge

end Full
end Bounty
end

section

/- The chronological sample embedding keeps the exact original group tag. -/

namespace Bounty

theorem full_mixed_ghost_head_sample_group
    {J K : Type*} {N : ℕ} {P Z : Fin N → Type*} {M : Fin N → ℕ}
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ) (j : J) (steps : List (Option (J ⊕ K)))
    (s : ProductBoundedOrderedState P Z M B) (sk : CoupledGhostSkeleton M B s)
    (i : CoupledGhostSampleIndex M B s sk) :
    (fullMixedBirthOrder S B (some (.inl j) :: steps)
      (fullMixedGhostHeadSampleEmbedding S B j steps s sk i)).2.1 = i.1 := by
  change ((fullMixedBirthOrder S B (some (.inl j) :: steps))
    ((fullMixedBirthOrder S B (some (.inl j) :: steps)).symm _)).2.1 = i.1
  rw [Equiv.apply_symm_apply]
  rfl

theorem full_mixed_edge_head_sample_group
    {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ) (k : K)
    (steps : List (Option (J ⊕ K))) (A : SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ c, A c → Fin N → ℤ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (sk : FullActiveEdgeSkeleton n (S k) B A Δ D s)
    (i : FullActiveEdgeSampleIndex n (S k) B A Δ D s sk) :
    (fullMixedBirthOrder S B (some (.inr k) :: steps)
      (fullMixedEdgeHeadSampleEmbedding n S B k steps A Δ D s sk i)).2.1 = i.1 := by
  change ((fullMixedBirthOrder S B (some (.inr k) :: steps))
    ((fullMixedBirthOrder S B (some (.inr k) :: steps)).symm _)).2.1 = i.1
  rw [Equiv.apply_symm_apply]
  rfl

end Bounty
end

section

/- Original forest constraints at any owner depend only on current birth labels and the retained past. -/

namespace Bounty

section Path
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K)))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps s) (u : Fin steps.length)
    [Fintype (FullMixedEventBirthCoordinate n S B A Δ D (steps.get u)
      (fullMixedOwnerOccurrence n S B A Δ D steps s p u).1
      (fullMixedOwnerOccurrence n S B A Δ D steps s p u).2)]
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))

theorem full_mixed_owner_anchors_past_local {α : Type*}
    (values history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → α)
    (hparents : ∀ i, fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i) = u →
      ∀ r, code i = some r → fullMixedPathBirthPerformed n S B A Δ D steps s p
        (fullMixedBirthOrder S B steps (birthForestParentEmbedding i r)))
    (hpast : ∀ i, fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i) < u →
      values i = history i) :
    let embed := fullMixedOwnerOrderedSampleEmbedding n S B A Δ D steps u
      (fullMixedOwnerOccurrence n S B A Δ D steps s p u).1
      (fullMixedOwnerOccurrence n S B A Δ D steps s p u).2
    restrictedBirthAnchors embed code values = restrictedBirthAnchors embed code history := by
  apply restricted_birth_anchors_past_local _
    (full_mixed_owner_ordered_sample_strictMono n S B A Δ D steps u _ _)
    (fun i => fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i))
    (full_mixed_birth_order_owner_monotone S B steps) u
    (full_mixed_owner_ordered_sample_owner n S B A Δ D steps u _ _)
    (fun i => fullMixedPathBirthPerformed n S B A Δ D steps s p (fullMixedBirthOrder S B steps i))
    (fun i hi hu => (full_mixed_owner_ordered_sample_coverage n S B A Δ D steps s p u i).mp ⟨hi, hu⟩)
    code _ values history hpast
  intro j r hr
  exact hparents _ (full_mixed_owner_ordered_sample_owner n S B A Δ D steps u _ _ j) r hr

theorem full_mixed_owner_forest_past_iff {α : Type*}
    (values history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → α)
    (hchildren : ∀ i, fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i) = u →
      code i ≠ none → fullMixedPathBirthPerformed n S B A Δ D steps s p (fullMixedBirthOrder S B steps i))
    (hparents : ∀ i, fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i) = u →
      ∀ r, code i = some r → fullMixedPathBirthPerformed n S B A Δ D steps s p
        (fullMixedBirthOrder S B steps (birthForestParentEmbedding i r)))
    (hpast : ∀ i, fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i) < u →
      values i = history i) :
    let embed := fullMixedOwnerOrderedSampleEmbedding n S B A Δ D steps u
      (fullMixedOwnerOccurrence n S B A Δ D steps s p u).1
      (fullMixedOwnerOccurrence n S B A Δ D steps s p u).2
    (∀ i, fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i) = u →
      ∀ r, code i = some r → values i = values (birthForestParentEmbedding i r)) ↔
      birthForestEqualValues (restrictedBirthCode embed code) (values ∘ embed) ∧
        birthLabelsAnchored (restrictedBirthAnchors embed code history) (values ∘ embed) := by
  apply owner_restricted_birth_forest_past_iff _
    (full_mixed_owner_ordered_sample_strictMono n S B A Δ D steps u _ _)
    (fun i => fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i))
    (full_mixed_birth_order_owner_monotone S B steps) u
    (full_mixed_owner_ordered_sample_owner n S B A Δ D steps u _ _)
    (fun i => fullMixedPathBirthPerformed n S B A Δ D steps s p (fullMixedBirthOrder S B steps i))
    (fun i hi hu => (full_mixed_owner_ordered_sample_coverage n S B A Δ D steps s p u i).mp ⟨hi, hu⟩)
    code values history hchildren _ hpast
  intro j r hr
  exact hparents _ (full_mixed_owner_ordered_sample_owner n S B A Δ D steps u _ _ j) r hr

theorem full_mixed_owner_compatible_restriction {α : Type*}
    (values history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → α)
    (h : birthForestCompatible
      (fun i => fullMixedPathBirthPerformed n S B A Δ D steps s p (fullMixedBirthOrder S B steps i))
      values code)
    (hpast : ∀ i, fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i) < u →
      values i = history i) :
    let embed := fullMixedOwnerOrderedSampleEmbedding n S B A Δ D steps u
      (fullMixedOwnerOccurrence n S B A Δ D steps s p u).1
      (fullMixedOwnerOccurrence n S B A Δ D steps s p u).2
    birthForestEqualValues (restrictedBirthCode embed code) (values ∘ embed) ∧
      birthLabelsAnchored (restrictedBirthAnchors embed code history) (values ∘ embed) := by
  apply (full_mixed_owner_forest_past_iff n S B A Δ D steps s p u code values history
    (fun i _ hi => by
      have he := h i
      cases hc : code i with
      | none => exact False.elim (hi hc)
      | some r => rw [hc] at he; exact he.2.1)
    (fun i _ r hr => by have he := h i; rw [hr] at he; exact he.1) hpast).mp
  intro i _ r hr
  have he := h i
  rw [hr] at he
  exact he.2.2.symm

end Path
end Bounty
end

section

/- At any owner, the actual ghost and edge sample order depends only on the fixed skeleton. -/

namespace Bounty

section Ghost
variable {J K : Type*} {N : ℕ} {P Z : Fin N → Type*} {M : Fin N → ℕ}
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ) (j : J)
    (steps : List (Option (J ⊕ K))) (u : Fin steps.length) (htag : steps.get u = some (.inl j))
    (s : ProductBoundedOrderedState P Z M B) (sk : CoupledGhostSkeleton M B s)

noncomputable def fullMixedGhostOwnerSampleEmbedding :
    CoupledGhostSampleIndex M B s sk ↪ Fin (Fintype.card (FullMixedBirthAddress S B steps)) :=
  (coupledGhostLocalSampleEmbedding S B j s sk).trans
    (fullMixedTaggedOccurrenceEmbedding S B steps u (some (.inl j)) htag)

noncomputable def fullMixedGhostOwnerSampleOrder :
    Fin (Fintype.card (CoupledGhostSampleIndex M B s sk)) ≃ CoupledGhostSampleIndex M B s sk :=
  finiteEmbeddedOrder (fullMixedGhostOwnerSampleEmbedding S B j steps u htag s sk)

theorem full_mixed_ghost_owner_sample_strictMono :
    StrictMono (fun i => fullMixedGhostOwnerSampleEmbedding S B j steps u htag s sk
      (fullMixedGhostOwnerSampleOrder S B j steps u htag s sk i)) :=
  finite_embedded_order_strictMono _

theorem full_mixed_ghost_owner_sample_owner (i : CoupledGhostSampleIndex M B s sk) :
    fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps
      (fullMixedGhostOwnerSampleEmbedding S B j steps u htag s sk i)) = u :=
  full_mixed_tagged_occurrence_owner S B steps u (some (.inl j)) htag _

theorem full_mixed_ghost_owner_sample_group (i : CoupledGhostSampleIndex M B s sk) :
    (fullMixedBirthOrder S B steps
      (fullMixedGhostOwnerSampleEmbedding S B j steps u htag s sk i)).2.1 = i.1 :=
  full_mixed_tagged_occurrence_group S B steps u (some (.inl j)) htag _

end Ghost

section Edge
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ) (k : K)
    (steps : List (Option (J ⊕ K))) (u : Fin steps.length) (htag : steps.get u = some (.inr k))
    (A : SharedActiveLabels P (S k) → Type*) (Δ D : ∀ c, A c → Fin N → ℤ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (sk : FullActiveEdgeSkeleton n (S k) B A Δ D s)

noncomputable def fullMixedEdgeOwnerSampleEmbedding :
    FullActiveEdgeSampleIndex n (S k) B A Δ D s sk ↪ Fin (Fintype.card (FullMixedBirthAddress S B steps)) :=
  (fullEdgeLocalSampleEmbedding (J := J) S B n k A Δ D s sk).trans
    (fullMixedTaggedOccurrenceEmbedding S B steps u (some (.inr k)) htag)

noncomputable def fullMixedEdgeOwnerSampleOrder :
    Fin (Fintype.card (FullActiveEdgeSampleIndex n (S k) B A Δ D s sk)) ≃
      FullActiveEdgeSampleIndex n (S k) B A Δ D s sk :=
  finiteEmbeddedOrder (fullMixedEdgeOwnerSampleEmbedding n S B k steps u htag A Δ D s sk)

theorem full_mixed_edge_owner_sample_strictMono :
    StrictMono (fun i => fullMixedEdgeOwnerSampleEmbedding n S B k steps u htag A Δ D s sk
      (fullMixedEdgeOwnerSampleOrder n S B k steps u htag A Δ D s sk i)) :=
  finite_embedded_order_strictMono _

theorem full_mixed_edge_owner_sample_owner (i : FullActiveEdgeSampleIndex n (S k) B A Δ D s sk) :
    fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps
      (fullMixedEdgeOwnerSampleEmbedding n S B k steps u htag A Δ D s sk i)) = u :=
  full_mixed_tagged_occurrence_owner S B steps u (some (.inr k)) htag _

theorem full_mixed_edge_owner_sample_group (i : FullActiveEdgeSampleIndex n (S k) B A Δ D s sk) :
    (fullMixedBirthOrder S B steps
      (fullMixedEdgeOwnerSampleEmbedding n S B k steps u htag A Δ D s sk i)).2.1 = i.1 :=
  full_mixed_tagged_occurrence_group S B steps u (some (.inr k)) htag _

end Edge
end Bounty
end

section

/- A fixed global birth history is updated only at the original event's owner. -/

open Classical

namespace Bounty

section History
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K)))

noncomputable def fullMixedBirthAddressWrite (u : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (steps.get u) s)
    (history : FullMixedBirthAddress S B steps → Option (Sigma P))
    (a : FullMixedBirthAddress S B steps) : Option (Sigma P) :=
  if h : a.1 = u then
    fullMixedEventBirthLabel n S B A Δ D (steps.get u) s e
      (cast (congrArg (fun v : Fin steps.length => FullMixedLocalBirthAddress S B (steps.get v)) h) a.2)
  else history a

noncomputable def fullMixedBirthHistoryWrite (u : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (steps.get u) s)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P))
    (i : Fin (Fintype.card (FullMixedBirthAddress S B steps))) : Option (Sigma P) :=
  fullMixedBirthAddressWrite n S B A Δ D steps u s e
    (fun a => history ((fullMixedBirthOrder S B steps).symm a)) (fullMixedBirthOrder S B steps i)

theorem full_mixed_birth_history_write_here (u : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (steps.get u) s)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P))
    (a : FullMixedLocalBirthAddress S B (steps.get u)) :
    fullMixedBirthHistoryWrite n S B A Δ D steps u s e history
      ((fullMixedBirthOrder S B steps).symm ⟨u, a⟩) =
      fullMixedEventBirthLabel n S B A Δ D (steps.get u) s e a := by
  unfold fullMixedBirthHistoryWrite
  rw [Equiv.apply_symm_apply]
  simp [fullMixedBirthAddressWrite]

theorem full_mixed_birth_history_write_other (u : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (steps.get u) s)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P))
    (i : Fin (Fintype.card (FullMixedBirthAddress S B steps)))
    (hi : fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i) ≠ u) :
    fullMixedBirthHistoryWrite n S B A Δ D steps u s e history i = history i := by
  change (fullMixedBirthOrder S B steps i).1 ≠ u at hi
  unfold fullMixedBirthHistoryWrite fullMixedBirthAddressWrite
  rw [dif_neg hi]
  exact congrArg history ((fullMixedBirthOrder S B steps).symm_apply_apply i)

noncomputable def fullMixedPathBirthHistory
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps s)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P))
    (t : ℕ) (i : Fin (Fintype.card (FullMixedBirthAddress S B steps))) : Option (Sigma P) :=
  if (fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i)).val < t then
    fullMixedPathBirthLabel n S B A Δ D steps s p (fullMixedBirthOrder S B steps i)
  else history i

theorem full_mixed_path_birth_history_zero
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps s)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P)) :
    fullMixedPathBirthHistory n S B A Δ D steps s p history 0 = history := by
  funext i
  exact if_neg (Nat.not_lt_zero _)

theorem full_mixed_path_birth_history_complete
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps s)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P)) :
    fullMixedPathBirthHistory n S B A Δ D steps s p history steps.length =
      fun i => fullMixedPathBirthLabel n S B A Δ D steps s p (fullMixedBirthOrder S B steps i) := by
  funext i
  exact if_pos (fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i)).isLt

theorem full_mixed_path_birth_history_write
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps s)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P))
    (u : Fin steps.length) :
    fullMixedBirthHistoryWrite n S B A Δ D steps u
      (fullMixedOwnerOccurrence n S B A Δ D steps s p u).1
      (fullMixedOwnerOccurrence n S B A Δ D steps s p u).2
      (fullMixedPathBirthHistory n S B A Δ D steps s p history u.val) =
      fullMixedPathBirthHistory n S B A Δ D steps s p history (u.val + 1) := by
  funext i
  obtain ⟨a, rfl⟩ := (fullMixedBirthOrder S B steps).symm.surjective i
  rcases a with ⟨v, a⟩
  by_cases hv : v = u
  · subst v
    rw [full_mixed_birth_history_write_here]
    simp only [fullMixedPathBirthHistory, Equiv.apply_symm_apply, fullMixedBirthOwner,
      Nat.lt_add_one, if_true]
    rfl
  · rw [full_mixed_birth_history_write_other n S B A Δ D steps u _ _ _ _ (by
      simpa only [Equiv.apply_symm_apply, fullMixedBirthOwner] using hv)]
    simp only [fullMixedPathBirthHistory, Equiv.apply_symm_apply, fullMixedBirthOwner]
    have hval : v.val ≠ u.val := fun h => hv (Fin.ext h)
    by_cases h : v.val < u.val
    · have h' : v.val < u.val + 1 := by omega
      simp only [if_pos h, if_pos h']
    · have h' : ¬v.val < u.val + 1 := by omega
      simp only [if_neg h, if_neg h']

end History
end Bounty
end

section

/- The big memory factors can be passed to a finite numbered group index without alteration. -/

open scoped Classical
namespace Bounty
section Reindex
variable {G H I : Type*} (e : G ≃ H) (P : G → Finset ℕ) (J ell : ℕ)
  (patterns : Finset I) (C : I → G → Finset (Fin J))
  [Fintype G] [Fintype H] [DecidableEq G] [DecidableEq H]

theorem physical_memory_labeled_group_reindex
    (V : G → ℝ) (ζ : I → ℝ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (L R : PhysicalMarkLists P J ell) :
    physicalMemoryLabeledScalar (fun h => V (e.symm h)) patterns (fun i h => C i (e.symm h)) ζ
      (fun i => physicalGroupReindexedCoefficient e (C i) (K i))
      (physicalEdgeGroupReindex e P J ell patterns C a)
      (physicalMarkGroupReindex e P J ell L) (physicalMarkGroupReindex e P J ell R) =
      physicalMemoryLabeledScalar V patterns C ζ K a L R := by
  unfold physicalMemoryLabeledScalar
  change (Fintype.card (PhysicalPermutations H J ell) : ℂ)⁻¹ *
    (Fintype.card (PhysicalPermutations H J ell) : ℂ)⁻¹ *
    (if physicalListAdmissible (fun h => C a.2.2.1.val (e.symm h))
      (physicalAuxGroupReindex e P J (C a.2.2.1.val) a.2.2.2)
      (physicalPermuteLabels (physicalPermutationGroupReindex e J ell a.1)
        (physicalMarkGroupReindex e P J ell L))
      (physicalPermuteLabels (physicalPermutationGroupReindex e J ell a.2.1)
        (physicalMarkGroupReindex e P J ell R)) then
      (physicalAuxMass (fun h => V (e.symm h)) (fun h => C a.2.2.1.val (e.symm h))
        (physicalAuxGroupReindex e P J (C a.2.2.1.val) a.2.2.2) : ℂ) *
      physicalGroupReindexedCoefficient e (C a.2.2.1.val) (K a.2.2.1.val)
        (physicalPermuteLabels (physicalPermutationGroupReindex e J ell a.1)
          (physicalMarkGroupReindex e P J ell L))
        (physicalPermuteLabels (physicalPermutationGroupReindex e J ell a.2.1)
          (physicalMarkGroupReindex e P J ell R))
        (physicalAuxGroupReindex e P J (C a.2.2.1.val) a.2.2.2) *
      physicalPhase (ζ a.2.2.1.val)
        (physicalD (fun h => C a.2.2.1.val (e.symm h))
          (physicalPermuteLabels (physicalPermutationGroupReindex e J ell a.1)
            (physicalMarkGroupReindex e P J ell L))
          (physicalAuxGroupReindex e P J (C a.2.2.1.val) a.2.2.2)) else 0) = _
  simp only [← physical_permute_group_reindex, physical_list_admissible_group_reindex,
    physical_aux_mass_group_reindex, physical_D_group_reindex,
    physical_group_reindexed_coefficient_apply]
  have hc := physical_permutation_group_reindex_card (J := J) (ell := ell) e
  simp only [← Nat.card_eq_fintype_card] at hc ⊢
  rw [hc]

theorem physical_memory_walk_group_reindex
    (V : G → ℝ) (ζ : ℕ → I → ℝ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C) (L : ℕ → PhysicalMarkLists P J ell) (n : ℕ) :
    physicalMemoryWalkScalar (fun h => V (e.symm h)) patterns (fun i h => C i (e.symm h)) ζ
      (fun t i => physicalGroupReindexedCoefficient e (C i) (K t i))
      (fun j => physicalEdgeGroupReindex e P J ell patterns C (a j))
      (fun j => physicalMarkGroupReindex e P J ell (L j)) n =
      physicalMemoryWalkScalar V patterns C ζ K a L n := by
  simp only [physicalMemoryWalkScalar, physical_memory_labeled_group_reindex]

end Reindex
end Bounty
end

section

/- Current birth support is fixed by the sample slots; only earlier-label presence comes from history. -/

open Classical

namespace Bounty

noncomputable def ownerSampleSupport {N m L : ℕ} {α : Type*}
    (embed : Fin m → Fin N) (owner : Fin N → Fin L) (u : Fin L)
    (history : Fin N → Option α) (i : Fin N) : Prop :=
  if owner i = u then i ∈ Set.range embed else (history i).isSome = true

theorem owner_sample_support_cover {N m L : ℕ} {α : Type*}
    (embed : Fin m → Fin N) (owner : Fin N → Fin L) (u : Fin L)
    (history : Fin N → Option α) :
    ∀ i, ownerSampleSupport embed owner u history i → owner i = u → i ∈ Set.range embed := by
  intro i hi hu
  simpa only [ownerSampleSupport, if_pos hu] using hi

theorem owner_sample_support_presence {N m L : ℕ} {α : Type*}
    (embed : Fin m → Fin N) (owner : Fin N → Fin L) (u : Fin L)
    (values history : Fin N → Option α)
    (hcover : ∀ i, (values i).isSome = true ∧ owner i = u ↔ i ∈ Set.range embed)
    (hother : ∀ i, owner i ≠ u → values i = history i) :
    ∀ i, ownerSampleSupport embed owner u history i ↔ (values i).isSome = true := by
  intro i
  by_cases hi : owner i = u
  · simp only [ownerSampleSupport, if_pos hi]
    exact ⟨fun h => ((hcover i).mpr h).1, fun h => (hcover i).mp ⟨h, hi⟩⟩
  · simp only [ownerSampleSupport, if_neg hi, hother i hi]

theorem owner_sample_support_anchors_valid {N m L : ℕ} {α : Type*}
    (embed : Fin m → Fin N) (hstrict : StrictMono embed)
    (owner : Fin N → Fin L) (hmono : Monotone owner) (u : Fin L)
    (howner : ∀ j, owner (embed j) = u) (history : Fin N → Option α) (code : BirthForestCode N)
    (hs : birthForestStageSupport owner u (ownerSampleSupport embed owner u history) code) :
    ∀ j, restrictedBirthAnchors embed code history j ≠ some none := by
  intro j
  cases hc : code (embed j) with
  | none => simp [restrictedBirthAnchors, hc]
  | some p =>
    by_cases he : ∃ k : Fin j.val,
      embed (birthForestParentEmbedding j k) = birthForestParentEmbedding (embed j) p
    · simp [restrictedBirthAnchors, hc, he]
    · have hp := (hs (embed j) (howner j) p hc).1
      have hlt := restricted_birth_external_parent_owner_lt embed hstrict owner hmono u howner
        (ownerSampleSupport embed owner u history) (owner_sample_support_cover embed owner u history)
        j p hp he
      have hv : (history (birthForestParentEmbedding (embed j) p)).isSome = true := by
        simpa only [ownerSampleSupport, if_neg (ne_of_lt hlt)] using hp
      have hn : history (birthForestParentEmbedding (embed j) p) ≠ none := by
        intro h
        rw [h] at hv
        cases hv
      simpa only [restrictedBirthAnchors, hc, if_neg he, ne_eq, Option.some.injEq] using hn

theorem owner_sample_stage_iff {N m L : ℕ} {α : Type*}
    (embed : Fin m → Fin N) (hstrict : StrictMono embed)
    (owner : Fin N → Fin L) (hmono : Monotone owner) (u : Fin L)
    (howner : ∀ j, owner (embed j) = u) (code : BirthForestCode N)
    (values history : Fin N → Option α) (localValues : Fin m → α)
    (hcover : ∀ i, (values i).isSome = true ∧ owner i = u ↔ i ∈ Set.range embed)
    (hother : ∀ i, owner i ≠ u → values i = history i)
    (hlocal : ∀ j, values (embed j) = some (localValues j)) :
    birthForestStageCondition owner u values code ↔
      birthForestStageSupport owner u (ownerSampleSupport embed owner u history) code ∧
        birthForestEqualValues (restrictedBirthCode embed code) localValues ∧
          birthLabelsAnchored (fun j => (restrictedBirthAnchors embed code history j).join) localValues :=
  owner_stage_support_forest_iff embed hstrict owner hmono u howner
    (ownerSampleSupport embed owner u history) (owner_sample_support_cover embed owner u history)
    code values history localValues (owner_sample_support_presence embed owner u values history hcover hother)
    hlocal (fun i hi => hother i (ne_of_lt hi))

end Bounty
end

section

/- A genuine mixed-measure promotion rarity estimate. The finite choice
index can jointly encode small-source permutations and fixed auxiliary
draws. Only the scalar eligible-position probability remains as input;
all per-choice operator bounds are proved for the actual capped events. -/

open Finset
open scoped Classical

namespace Bounty

theorem exists_physical_small_big_promotion_average_energy_bound
    {q vs : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hvs : 0 < vs) (ell : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (S G Q : Type) [Fintype S] [DecidableEq S]
      [Fintype G] [DecidableEq G] [Fintype Q]
      (Ps : S → Finset ℕ) [∀ p : PhysicalPrime Ps, NeZero p.2.val]
      (P : G → Type) [∀ g, Fintype (P g)] (n : ∀ g, P g → ℕ)
      [∀ g p, NeZero (n g p)] (J : ℕ) (M : G → ℕ)
      (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
      (Δ D : Q → PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
      (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
      (kbig : Q → SharedActiveLabels P shared → ℤ)
      (Vs : S → ℝ), (∀ s, vs ≤ Vs s) →
      ∀ (_aux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))))
        (v vmin vmax : ℝ), 0 < ρ → ρ < 1 → 1 < v → 0 < vmin →
      (∀ g, vmin ≤ V g) → (∀ g, V g ≤ vmax) →
      (∀ g p, 0 ≤ μ g p) → (∀ g, ∑ p, μ g p ≤ 2) →
      ∀ (T : ℕ), (∀ g, (shared g)ᶜ.card ≤ T) →
      ∀ (π : Q → ℝ), (∀ a, 0 ≤ π a) → (∑ a, π a ≤ 1) →
      ∀ (σ : Q → PhysicalPermutations S J ell)
        (good : PhysicalSmallBigState Ps J ell
          (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → Prop)
        (Φ : ∀ a, ∀ s : PhysicalSmallBigState Ps J ell
          (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B),
          PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B (Δ a) (D a)) s → ℂ)
        (H : ℝ), 0 ≤ H → (∀ a s e, ‖Φ a s e‖ ≤ H) →
      ∀ (δ : ℝ), 0 ≤ δ →
      (∀ s, good s → (∑ a, if physicalSmallBigEligible n shared B (Δ a) (D a)
        (physicalSmallBigPermutation (σ a) s) then π a else 0) ≤ δ) →
      ∀ (F : PhysicalSmallBigState Ps J ell
        (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ),
      (∀ s, ProductMemorySymmetric (fun x => F (s, x))) →
      physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
        (fun s => ∑ a, (π a : ℂ) * (if good s then
          physicalSmallBigFullPhasedAction n shared B (Δ a) (D a) μ ρ V (kbig a) Vs q
            (fun y e => if ∃ g, (e.2.2 g).2.1.Nonempty then Φ a y e else 0) F
            (physicalSmallBigPermutation (σ a) s) else 0)) ≤
        δ * (H ^ 2 * (A ^ (2 * Fintype.card S) *
          unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G)) *
          physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) F := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_small_big_phased_energy_bound hq0 hq1 hvs ell
  refine ⟨A, hA, ?_⟩
  intro S G Q _ dS _ dG _
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  intro Ps _ P _ n _ J M shared B Δ D μ ρ V kbig Vs hVs aux
    v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht π hπ hπmass σ good Φ H hH hΦ
    δ hδ hrare F hF
  refine physical_small_big_sparse_permutation_energy_le Vs (fun s => hvs.trans_le (hVs s))
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productMemoryWeight_nonneg μ _ hμ (fun g z => hμ g z.1)) π hπ hπmass σ good
    (fun a => physicalSmallBigEligible n shared B (Δ a) (D a)) _ ?_ hδ ?_ hrare F ?_
  · intro a s hno
    exact physical_small_big_promoting_zero n shared B (Δ a) (D a) μ ρ V (kbig a) Vs q
      (Φ a) F s hno
  · exact mul_nonneg (sq_nonneg H) (mul_nonneg (pow_nonneg (zero_le_one.trans hA) _)
      (pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _))
  · intro a
    apply hbound S G Ps P n J M shared B (Δ a) (D a) μ ρ V (kbig a) Vs hVs aux
      v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht _ H hH _ F hF
    intro s e
    split_ifs
    · exact hΦ a s e
    · simpa only [norm_zero] using hH

end Bounty
end

section

/- Candidate omission rarity for literal mixed-state support. The big
factor may depend on retained big labels and fixed auxiliary data; it is
unchanged by the small-source permutation. No big-label injectivity is used. -/

open Finset Filter
open scoped Classical Topology

namespace Bounty

theorem physical_small_big_shared_dilation_permute
    {S G : Type*} [Fintype S] {Ps : S → Finset ℕ} {P Z : G → Type*}
    {J ell B : ℕ} {M : G → ℕ} (shared : ∀ g, Finset (Fin (M g)))
    (D_B : SharedActiveLabels P shared → ℕ)
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B))
    (σ : PhysicalPermutations S J ell) :
    D_B (productActiveMemorySplit shared B (physicalSmallBigPermutation σ s).2).1 *
      physicalSharedProduct (physicalSharedPrefix (physicalSmallBigPermutation σ s).1.2) =
    smallSourcePermutationDilation s.1.2 (D_B (productActiveMemorySplit shared B s.2).1) σ := by
  rfl

theorem physical_small_big_eligible_permute_iff
    {S G : Type*} [Fintype S] {Ps : S → Finset ℕ} {P : G → Type*}
    (n : ∀ g, P g → ℕ) {J ell B : ℕ} {M : G → ℕ}
    (shared : ∀ g, Finset (Fin (M g))) (D_B : SharedActiveLabels P shared → ℕ) (k : ℤ)
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (σ : PhysicalPermutations S J ell) :
    physicalSmallBigEligible n shared B
      (fun d c _ => -(k * (D_B c * physicalSharedProduct d : ℕ)))
      (fun d c _ => (D_B c * physicalSharedProduct d : ℕ)) (physicalSmallBigPermutation σ s) ↔
    ∃ g, (unrestrictedResidueEligible (n g)
      (-(k * (smallSourcePermutationDilation s.1.2
        (D_B (productActiveMemorySplit shared B s.2).1) σ : ℤ)))
      (smallSourcePermutationDilation s.1.2
        (D_B (productActiveMemorySplit shared B s.2).1) σ) (s.2 g).2.2).Nonempty := by
  rfl

theorem eventually_candidate_mixed_eligibility_probability_le
    {scale : ℝ} (hscale : 0 < scale) (ell : ℕ) (C₂ : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ J B : ℕ,
      ∀ M : ↥(candidateBigPIndices scale L) → ℕ,
      ∀ shared : ∀ g, Finset (Fin (M g)),
      ∀ D_B : SharedActiveLabels
        (fun g : ↥(candidateBigPIndices scale L) => ↥(candidatePBand (scale * L) g.val)) shared → ℕ,
      ∀ k : ℤ, k ≠ 0 → (k.natAbs : ℝ) ≤ L ^ C₂ →
      ∀ s : PhysicalSmallBigState
        (fun g : ↥(candidateSmallPIndices scale L) => candidatePBand (scale * L) g.val) J ell
        (ProductBoundedOrderedState
          (fun g : ↥(candidateBigPIndices scale L) => ↥(candidatePBand (scale * L) g.val))
          (fun g => UnrestrictedResidueParticle (fun p : ↥(candidatePBand (scale * L) g.val) => p.val)) M B),
      productTotalMemory s.2 ≤ B →
      letI : DecidableEq ↥(candidateSmallPIndices scale L) := Classical.decEq _
      letI : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
      (∑ σ : PhysicalPermutations ↥(candidateSmallPIndices scale L) J ell,
        if physicalSmallBigEligible
          (fun (g : ↥(candidateBigPIndices scale L)) (p : ↥(candidatePBand (scale * L) g.val)) => p.val)
          shared B (fun d c _ => -(k * (D_B c * physicalSharedProduct d : ℕ)))
          (fun d c _ => (D_B c * physicalSharedProduct d : ℕ))
          (physicalSmallBigPermutation σ s)
        then 1 / (Fintype.card (PhysicalPermutations ↥(candidateSmallPIndices scale L) J ell) : ℝ)
        else 0) ≤ (B : ℝ) / (((J + ell).choose ell) ^ (candidateSmallPIndices scale L).card : ℕ) := by
  filter_upwards [eventually_candidate_pending_eligibility_probability_le hscale ell C₂] with L hL
  intro J B M shared D_B k hk hkbound s hB
  let _ : DecidableEq ↥(candidateSmallPIndices scale L) := Classical.decEq _
  let _ : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
  have h := hL J B s.1.2 (D_B (productActiveMemorySplit shared B s.2).1) k hk hkbound M s.2 hB
  simpa only [physical_small_big_eligible_permute_iff] using h

end Bounty
end

section

/- The mixed reverse row retains the same big-group energy constant,
even though its literal event coefficient includes the reversal ratios. -/

open Finset Classical

namespace Bounty

theorem physical_small_big_reverse_prefix_energy_le
    {S G : Type*} [Fintype S] [dS : DecidableEq S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} [∀ p : PhysicalPrime Ps, NeZero p.2.val]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    {J ell : ℕ} {M : G → ℕ} (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (kbig : SharedActiveLabels P shared → ℤ) (Vs : S → ℝ) (q : ℝ)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, (shared g)ᶜ.card ≤ T)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (hF : ∀ s, ProductMemorySymmetric (fun x => F (s, x))) :
    physicalSmallBigConditionEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (physicalSmallBigPrefixAction (PhysicalSmallBigFullEvent n shared B (fun d c g => -Δ d c g) D)
        (physicalSmallBigFullTarget n shared B (fun d c g => -Δ d c g) D)
        (physicalSmallBigFullCoefficient n shared B (fun d c g => -Δ d c g) D μ ρ V
          (physicalSmallBigReversePhase n shared B Δ D V))
        (fun x => -kbig (productActiveMemorySplit shared B x).1) (physicalSmallBigCondition Vs q F)) ≤
      unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        physicalSmallBigConditionEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
          (physicalSmallBigCondition Vs q F) := by
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  unfold physicalSmallBigConditionEnergy
  rw [mul_sum]
  apply sum_le_sum
  intro d hd
  simp_rw [physical_small_big_reverse_prefix_eq]
  exact full_active_reverse_promotion_external_energy_le n shared B
    (fun c (_ : Unit) => Δ d c) (fun c (_ : Unit) => D d c) (fun _ _ => 1) μ ρ V
    (fun c _ => physicalResidueTranslationEquiv (P := Ps) (kbig c * (physicalSharedProduct d : ℕ)))
    (by intros; exact zero_le_one) (by intro c; simp only [Fintype.sum_unique, le_refl])
    hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht (physicalSmallBigCondition Vs q F d)
    (fun r => physical_small_big_condition_memory_symmetric Vs q F hF d r)

/-- All per-choice operator and conditioning bounds are discharged; A is
uniform in J and the event data. -/
theorem exists_physical_small_big_reverse_energy_bound
    {q vs : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hvs : 0 < vs) (ell : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (S G : Type) [Fintype S] [DecidableEq S]
      [Fintype G] [DecidableEq G]
      (Ps : S → Finset ℕ) [∀ p : PhysicalPrime Ps, NeZero p.2.val]
      (P : G → Type) [∀ g, Fintype (P g)] (n : ∀ g, P g → ℕ)
      [∀ g p, NeZero (n g p)] (J : ℕ) (M : G → ℕ)
      (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
      (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
      (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
      (kbig : SharedActiveLabels P shared → ℤ)
      (Vs : S → ℝ), (∀ s, vs ≤ Vs s) →
      ∀ (aux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))))
        (v vmin vmax : ℝ), 0 < ρ → ρ < 1 → 1 < v → 0 < vmin →
      (∀ g, vmin ≤ V g) → (∀ g, V g ≤ vmax) →
      (∀ g p, 0 ≤ μ g p) → (∀ g, ∑ p, μ g p ≤ 2) →
      ∀ (T : ℕ), (∀ g, (shared g)ᶜ.card ≤ T) →
      ∀ (F : PhysicalSmallBigState Ps J ell
        (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ),
      (∀ s, ProductMemorySymmetric (fun x => F (s, x))) →
      physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
        (physicalSmallBigReverseAction n shared B Δ D μ ρ V kbig Vs q aux F) ≤
        A ^ (2 * Fintype.card S) *
          unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
          physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) F := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_small_big_energy_bound hq0 hq1 hvs ell
  refine ⟨A, hA, ?_⟩
  intro S G _ dS _ dG
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  intro Ps _ P _ n _ J M shared B Δ D μ ρ V kbig Vs hVs aux
    v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht F hF
  have h := hbound S
    (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    Ps J Vs hVs 0 (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productMemoryWeight_nonneg μ _ hμ (fun g z => hμ g z.1)) aux (fun _ => 1)
    (PhysicalSmallBigFullEvent n shared B (fun d c g => -Δ d c g) D)
    (physicalSmallBigFullTarget n shared B (fun d c g => -Δ d c g) D)
    (physicalSmallBigFullCoefficient n shared B (fun d c g => -Δ d c g) D μ ρ V
      (physicalSmallBigReversePhase n shared B Δ D V))
    (fun x => -kbig (productActiveMemorySplit shared B x).1)
    1 (unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G) zero_le_one
    (pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _) (by intro d; simp) F
    (physical_small_big_reverse_prefix_energy_le n shared B Δ D μ ρ V kbig Vs q
      hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht F hF)
  simp only [one_pow, mul_one] at h
  convert h using 1 <;> congr 2

end Bounty
end

section

/- Literal reverse mixed events vanish unless an old big-memory position
is eligible for promotion. This is a support statement, not a norm premise. -/

open Finset Classical

namespace Bounty

theorem physical_small_big_reverse_zero
    {S G : Type*} [Fintype S] [DecidableEq S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} [∀ p : PhysicalPrime Ps, NeZero p.2.val]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    {J ell : ℕ} {M : G → ℕ} (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (kbig : SharedActiveLabels P shared → ℤ) (Vs : S → ℝ) (q : ℝ)
    (aux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))))
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (hno : ¬ ∃ g, (unrestrictedResidueEligible (n g)
      (-Δ (physicalSharedPrefix s.1.2) (productActiveMemorySplit shared B s.2).1 g)
      (D (physicalSharedPrefix s.1.2) (productActiveMemorySplit shared B s.2).1 g)
      (s.2 g).2.2).Nonempty) :
    physicalSmallBigReverseAction n shared B Δ D μ ρ V kbig Vs q aux F s = 0 := by
  unfold physicalSmallBigReverseAction physicalSmallBigAction
  apply sum_eq_zero
  rintro ⟨L, e⟩ he
  have hp : ¬ ((∀ g, (e.2 g).1 = ∅) ∧ (∃ g, (e.2 g).2.1 ≠ ∅)) := by
    rintro ⟨_, g, hg⟩
    apply hno
    refine ⟨g, ?_⟩
    exact unrestricted_promoting_event_eligible (n g) _ _ (shared g)ᶜ.card B
      ((productActiveMemorySplit shared B s.2).2 g) (e.2 g) hg
  simp only [physicalSmallBigEventWeight, physicalSmallBigFullCoefficient,
    physicalSmallBigReversePhase, if_neg hp, mul_zero, zero_mul]

end Bounty
end

section

/- Pointwise completion form of the positive mixed row. It makes explicit
that the source small factor is independent of the big pending-memory order. -/

open Finset Classical

namespace Bounty

noncomputable def physicalSmallBigCompletion
    {S X : Type*} [Fintype S] {P : S → Finset ℕ} {J ell : ℕ}
    (q : ℝ) (F : PhysicalSmallBigState P J ell X → ℂ)
    (d : PhysicalSharedLists P J) (x : X) (r : PhysicalResidues P) : ℂ :=
  ∑ L : PhysicalMarkLists P J ell, if physicalSharedPrefix L = d then
    (physicalResidueVertexWeight L (Real.sqrt q) r : ℂ) * F ((r, L), x) else 0

theorem physical_small_big_action_completion
    {S X : Type*} [Fintype S] [DecidableEq S]
    {P : S → Finset ℕ} {J ell : ℕ}
    (V : S → ℝ) (q : ℝ)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (E : PhysicalSharedLists P J → X → Type*) [∀ d x, Fintype (E d x)]
    (target : ∀ d x, E d x → X)
    (a : PhysicalResidues P → ∀ d x, E d x → ℂ) (k : X → ℤ)
    (F : PhysicalSmallBigState P J ell X → ℂ)
    (r : PhysicalResidues P) (L : PhysicalMarkLists P J ell) (x : X) :
    physicalSmallBigAction V q 0 aux (fun _ => 1) E target a k F ((r,L),x) =
      ((physicalCompletionMass V (fun _ => (∅ : Finset (Fin J))) ell *
        physicalResidueVertexWeight L (Real.sqrt q) r : ℝ) : ℂ) *
      physicalSmallBigPrefixAction E target a k (physicalSmallBigCompletion q F)
        (physicalSharedPrefix L) x r := by
  unfold physicalSmallBigAction physicalSmallBigEventWeight physicalSmallBigTarget
    physicalSmallBigPrefixAction physicalSmallBigCompletion
  simp only [Fintype.sum_prod_type]
  rw [sum_comm]
  simp only [mul_sum]
  apply sum_congr rfl
  intro e he
  apply sum_congr rfl
  intro R hR
  rw [physical_bare_empty_prefix V 0 aux (fun _ => 1) L R]
  have hz : physicalPhase 0 (physicalSharedProduct (physicalSharedPrefix L)) = 1 := by
    simp [physicalPhase]
  by_cases hh : physicalSharedPrefix L = physicalSharedPrefix R
  · simp only [if_pos hh, if_pos hh.symm, hz, mul_one, Complex.ofReal_mul]
    ring
  · have hh' : physicalSharedPrefix R ≠ physicalSharedPrefix L := Ne.symm hh
    simp only [if_neg hh, if_neg hh', zero_mul, mul_zero]

theorem physical_small_big_completion_memory_symmetric
    {S G : Type*} [Fintype S] [DecidableEq G]
    {Ps : S → Finset ℕ} {P Z : G → Type*} {J ell B : ℕ} {M : G → ℕ}
    (q : ℝ)
    (F : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ)
    (hF : ∀ s, ProductMemorySymmetric (fun x => F (s, x)))
    (d : PhysicalSharedLists Ps J) (r : PhysicalResidues Ps) :
    ProductMemorySymmetric (fun x => physicalSmallBigCompletion q F d x r) := by
  intro x g τ
  unfold physicalSmallBigCompletion
  apply sum_congr rfl
  intro L hL
  split_ifs
  · exact congrArg (fun z : ℂ => (physicalResidueVertexWeight L (Real.sqrt q) r : ℂ) * z)
      (hF (r,L) x g τ)
  · rfl

end Bounty
end

section

/- Literal dirty domination after small-source averaging. Storage is
identified with the exact row whose two-sided adjoint estimate is proved. -/

open Finset
open scoped Classical

namespace Bounty

section

variable {S G : Type*} [Fintype S] [Fintype G] [dG : DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
  (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
  (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (kbig : SharedActiveLabels P shared → ℤ) (Vs : S → ℝ) (q : ℝ)
  (aux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))))

theorem physical_small_big_storage_eq_phased
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ) :
    physicalSmallBigStorageAction n shared B Δ D μ ρ V kbig Vs q aux F =
    physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q
      (fun _ e => if (∀ g, (e.2.2 g).2.1 = ∅) ∧ (∃ g, (e.2.2 g).1.Nonempty)
        then 1 else 0) F := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  unfold physicalSmallBigStorageAction physicalSmallBigFullCoefficient
  have h := physical_small_big_action_eq_phased Vs q 0 aux (fun _ => 1)
    (PhysicalSmallBigFullEvent n shared B Δ D) (physicalSmallBigFullTarget n shared B Δ D)
    (physicalSmallBigFullWeight n shared B Δ D μ ρ V)
    (fun r d x e => physicalSmallBigStoragePhase n shared B Δ D d x r e)
    (fun x => kbig (productActiveMemorySplit shared B x).1) F
  simp only [physicalSmallBigFullWeight, physicalSmallBigFullPhasedAction,
    physicalSmallBigStoragePhase, physicalPhase, zero_mul,
    Complex.ofReal_zero, Complex.exp_zero, one_mul, Finset.nonempty_iff_ne_empty] at h ⊢
  convert h using 1 <;> funext s
  all_goals
    simp only [physicalSmallBigAction, physicalSmallBigPhasedAction, physicalSmallBigEventWeight]
    apply sum_congr rfl
    intro e _
    dsimp only

theorem physical_small_big_full_dirty_norm_le_positive
    (hVs : ∀ s, 0 < Vs s) (hμ : ∀ g p, 0 ≤ μ g p)
    (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ V g)
    (Φ : ∀ s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B),
      PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B Δ D) s → ℂ)
    (hΦ : ∀ s e, ‖Φ s e‖ ≤ 1)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)) :
    ‖physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q
      (fun y e => if ¬ (∀ g, (e.2.2 g).1 = ∅ ∧ (e.2.2 g).2.1 = ∅) then Φ y e else 0) F s‖ ≤
    (physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q
      (fun _ e => if ¬ (∀ g, (e.2.2 g).1 = ∅ ∧ (e.2.2 g).2.1 = ∅) then 1 else 0)
      (complexNormEnvelope F) s).re := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  have h := physical_small_big_masked_norm_le_positive Vs q
    (PhysicalSmallBigFullEvent n shared B Δ D) (physicalSmallBigFullTarget n shared B Δ D)
    (physicalSmallBigFullWeight n shared B Δ D μ ρ V)
    (fun x => kbig (productActiveMemorySplit shared B x).1)
    hVs (physical_small_big_full_weight_nonneg n shared B Δ D μ ρ V hμ hρ hV)
    (fun _ e => ¬ (∀ g, (e.2.2 g).1 = ∅ ∧ (e.2.2 g).2.1 = ∅)) Φ hΦ F s
  unfold physicalSmallBigFullPhasedAction physicalSmallBigPhasedAction at h ⊢
  convert h using 1 <;> congr 1 <;> apply sum_congr rfl <;> intro e _ <;>
    dsimp only <;> split_ifs <;> rfl

variable [DecidableEq S]

theorem physical_small_big_averaged_dirty_domination
    (hVs : ∀ s, 0 < Vs s) (hμ : ∀ g p, 0 ≤ μ g p)
    (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ V g)
    (Φ : ∀ s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B),
      PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B Δ D) s → ℂ)
    (hΦ : ∀ s e, ‖Φ s e‖ ≤ 1)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)) :
    ‖physicalSmallBigAverage (physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q
      (fun y e => if ¬ (∀ g, (e.2.2 g).1 = ∅ ∧ (e.2.2 g).2.1 = ∅) then Φ y e else 0) F) s‖ ≤
    ‖physicalSmallBigAverage (physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q
        (fun _ e => if ∃ g, (e.2.2 g).2.1.Nonempty then 1 else 0) (complexNormEnvelope F)) s +
      physicalSmallBigAverage (physicalSmallBigStorageAction n shared B Δ D μ ρ V kbig Vs q aux
        (complexNormEnvelope F)) s‖ := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  have h := physical_small_big_average_norm_domination _ _
    (physical_small_big_full_dirty_norm_le_positive n shared B Δ D μ ρ V kbig Vs q
      hVs hμ hρ hV Φ hΦ F) s
  rw [physical_small_big_full_dirty_positive_split,
    ← physical_small_big_storage_eq_phased n shared B Δ D μ ρ V kbig Vs q aux,
    physical_small_big_average_add] at h
  exact h.trans (Complex.re_le_norm _)

end

end Bounty
end

section

/- Explicit determinant domain for the finite Type-II off-diagonal sum. -/

open Finset

namespace Bounty

def TypeIIShiftConditions (E N : Finset ℕ) (y : TypeIIShiftIndex) : Prop :=
  0 < y.2.1.1 ∧ y.1.1 ≠ 0 ∧ y.1.2 = y.2.2.1 * y.2.1.2 ∧
  (y.1.2 : ℤ) + y.1.1 = (y.2.1.1 : ℤ) * y.2.2.2 ∧
  Int.ModEq (2 * |y.1.1|) (y.2.1.1 : ℤ) (y.2.2.1 : ℤ) ∧
  0 < typeIIRecoveredE y ∧ 0 < typeIIRecoveredN y ∧
  (typeIIRecoveredE y).toNat ∈ E ∧ (typeIIRecoveredN y).toNat ∈ N

noncomputable def typeIIDeterminantDomain (E N M H : Finset ℕ)
    (K : Finset ℤ) (Z : Finset ℕ) : Finset TypeIIShiftIndex := by
  classical
  exact ((K ×ˢ Z) ×ˢ ((M ×ˢ H) ×ˢ (M ×ˢ H))).filter (TypeIIShiftConditions E N)

theorem typeII_shift_map_conditions {E N M H : Finset ℕ} {x : TypeIIOffIndex}
    (hx : x ∈ typeIIOffDiagonalSupport E N M H) :
    TypeIIShiftConditions E N (typeIIShiftMap x) := by
  obtain ⟨he, hn, hm, hh, hm', hh', hne, hfirst, hsecond⟩ := mem_typeII_off_diagonal_support.mp hx
  have hp := typeII_off_support_positive hx
  obtain ⟨k, hk, _⟩ := typeII_determinant_unique_nat hfirst hsecond hne
  obtain ⟨hEq, hNq⟩ := typeII_recovered_quotients hx
  refine ⟨hp.2.2.1, ?_, rfl, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · change (x.2.1.1 : ℤ) * x.2.2.2 - (x.2.2.1 : ℤ) * x.2.1.2 ≠ 0
    rw [hk.2.2.2]
    exact hk.1
  · change ((x.2.2.1 * x.2.1.2 : ℕ) : ℤ) +
      ((x.2.1.1 : ℤ) * x.2.2.2 - (x.2.2.1 : ℤ) * x.2.1.2) =
        (x.2.1.1 : ℤ) * x.2.2.2
    push_cast
    ring
  · change Int.ModEq (2 * |(x.2.1.1 : ℤ) * x.2.2.2 - (x.2.2.1 : ℤ) * x.2.1.2|)
      (x.2.1.1 : ℤ) (x.2.2.1 : ℤ)
    rw [hk.2.2.2]
    exact typeII_determinant_congruence hk.2.1
  · rw [hEq]
    exact_mod_cast hp.1
  · rw [hNq]
    exact_mod_cast hp.2.1
  · simpa only [hEq, Int.toNat_natCast] using he
  · simpa only [hNq, Int.toNat_natCast] using hn

theorem typeII_shift_conditions_reconstruction {E N M H : Finset ℕ}
    {y : TypeIIShiftIndex} {W : ℝ}
    (hv : y.2.1 ∈ M ×ˢ H) (hw : y.2.2 ∈ M ×ˢ H)
    (hconditions : TypeIIShiftConditions E N y)
    (hrough : ∀ p ∈ y.2.1.1.primeFactors, W < (p : ℝ))
    (hsmall : |(y.1.1 : ℝ)| ≤ W) :
    typeIIRecoveredIndex y ∈ typeIIOffDiagonalSupport E N M H ∧
      typeIIShiftMap (typeIIRecoveredIndex y) = y := by
  obtain ⟨hm, hk, hz, hcross, hmod, hepos, hnpos, heE, hnN⟩ := hconditions
  have hc := typeII_rough_coprime_determinant hm hk hrough hsmall
  have hd : (y.2.1.1 : ℤ) * y.2.2.2 - (y.2.2.1 : ℤ) * y.2.1.2 = y.1.1 := by
    rw [hz, Nat.cast_mul] at hcross
    linarith
  obtain ⟨en, hen, _⟩ := typeII_determinant_from_congruence
    (by exact_mod_cast hm) (by positivity : (0 : ℤ) ≤ y.2.1.2) hk hc hd hmod hepos
  have hEq : typeIIRecoveredE y = en.1 := typeII_determinant_e_quotient hk hen.2.2.2.2.1
  have hNq : typeIIRecoveredN y = en.2 := by
    unfold typeIIRecoveredN
    rw [hEq]
    exact typeII_determinant_n_quotient (by exact_mod_cast hm.ne') hen.2.2.1
  have hEc : ((typeIIRecoveredE y).toNat : ℤ) = en.1 := by
    rw [hEq]
    exact Int.toNat_of_nonneg hen.1.le
  have hNc : ((typeIIRecoveredN y).toNat : ℤ) = en.2 := by
    rw [hNq]
    exact Int.toNat_of_nonneg hen.2.1.le
  have hfirst : y.2.1.1 * (typeIIRecoveredN y).toNat =
      2 * (typeIIRecoveredE y).toNat * y.2.1.2 + 1 := by
    exact_mod_cast (show (y.2.1.1 : ℤ) * ((typeIIRecoveredN y).toNat : ℤ) =
      2 * ((typeIIRecoveredE y).toNat : ℤ) * y.2.1.2 + 1 by rw [hEc, hNc]; exact hen.2.2.1)
  have hsecond : y.2.2.1 * (typeIIRecoveredN y).toNat =
      2 * (typeIIRecoveredE y).toNat * y.2.2.2 + 1 := by
    exact_mod_cast (show (y.2.2.1 : ℤ) * ((typeIIRecoveredN y).toNat : ℤ) =
      2 * ((typeIIRecoveredE y).toNat : ℤ) * y.2.2.2 + 1 by rw [hEc, hNc]; exact hen.2.2.2.1)
  have hne : y.2.1.1 ≠ y.2.2.1 := by
    intro heq
    have hzE : typeIIRecoveredE y = 0 := by unfold typeIIRecoveredE; rw [heq]; simp
    rw [hzE] at hepos
    exact (lt_irrefl 0) hepos
  constructor
  · apply mem_typeII_off_diagonal_support.mpr
    exact ⟨heE, hnN, (mem_product.mp hv).1, (mem_product.mp hv).2,
      (mem_product.mp hw).1, (mem_product.mp hw).2, hne, hfirst, hsecond⟩
  · apply Prod.ext
    · apply Prod.ext
      · exact hd
      · exact hz.symm
    · rfl

theorem typeII_shift_image_eq_determinant_domain (E N M H : Finset ℕ)
    (K : Finset ℤ) (Z : Finset ℕ) {W : ℝ}
    (hrough : ∀ m ∈ M, ∀ p ∈ m.primeFactors, W < (p : ℝ))
    (hsmall : ∀ k ∈ K, |(k : ℝ)| ≤ W)
    (hK : ∀ x ∈ typeIIOffDiagonalSupport E N M H, (typeIIShiftMap x).1.1 ∈ K)
    (hZ : ∀ x ∈ typeIIOffDiagonalSupport E N M H, (typeIIShiftMap x).1.2 ∈ Z) :
    (typeIIOffDiagonalSupport E N M H).image typeIIShiftMap =
      typeIIDeterminantDomain E N M H K Z := by
  classical
  ext y
  constructor
  · intro hy
    obtain ⟨x, hx, rfl⟩ := mem_image.mp hy
    obtain ⟨he, hn, hm, hh, hm', hh', hne, hfirst, hsecond⟩ := mem_typeII_off_diagonal_support.mp hx
    apply mem_filter.mpr
    refine ⟨?_, typeII_shift_map_conditions hx⟩
    exact mem_product.mpr ⟨mem_product.mpr ⟨hK x hx, hZ x hx⟩,
      mem_product.mpr ⟨mem_product.mpr ⟨hm, hh⟩, mem_product.mpr ⟨hm', hh'⟩⟩⟩
  · intro hy
    obtain ⟨hrange, hconditions⟩ := mem_filter.mp hy
    obtain ⟨hkz, hvw⟩ := mem_product.mp hrange
    obtain ⟨hv, hw⟩ := mem_product.mp hvw
    have hr := typeII_shift_conditions_reconstruction hv hw hconditions
      (hrough _ (mem_product.mp hv).1) (hsmall _ (mem_product.mp hkz).1)
    exact mem_image.mpr ⟨typeIIRecoveredIndex y, hr.1, hr.2⟩

theorem typeII_off_diagonal_energy_eq_determinant_sum (E N M H : Finset ℕ)
    (K : Finset ℤ) (Z : Finset ℕ) {W : ℝ}
    (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ)
    (hrough : ∀ m ∈ M, ∀ p ∈ m.primeFactors, W < (p : ℝ))
    (hsmall : ∀ k ∈ K, |(k : ℝ)| ≤ W)
    (hK : ∀ x ∈ typeIIOffDiagonalSupport E N M H, (typeIIShiftMap x).1.1 ∈ K)
    (hZ : ∀ x ∈ typeIIOffDiagonalSupport E N M H, (typeIIShiftMap x).1.2 ∈ Z) :
    typeIIOffDiagonalEnergy E N M H η α aH =
      ∑ y ∈ typeIIDeterminantDomain E N M H K Z, typeIIShiftWeight η α aH y := by
  rw [typeII_off_diagonal_energy_eq_shift_image,
    typeII_shift_image_eq_determinant_domain E N M H K Z hrough hsmall hK hZ]

end Bounty

end

section

/- Positive local actions for the literal mixed path events. Ghost and edge
birth parameters are independent, so ghost births may be doubled alone. -/

open Finset
open scoped Classical

namespace Bounty

section
variable {H K S G : Type} [Fintype S] [Fintype G]
  {Ps : S → Finset ℕ} {P : G → Type}
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : K → ∀ g, Finset (Fin (M g))) (B : ℕ) (A : K → Type)
  (Δ D : ∀ k, PhysicalSharedLists Ps J → SharedActiveLabels P (shared k) → A k → G → ℤ)
  (kbig : ∀ k, SharedActiveLabels P (shared k) → A k → ℤ)
  (ω : ∀ k, A k → ℝ) (μ : ∀ g, P g → ℝ)
  (qghost : H → ℝ) (ρ : ℝ) (Vedge Vghost : G → ℝ) (Vs : S → ℝ) (qsmall : ℝ)

noncomputable def physicalSmallBigPathPositiveWeight (tag : Option (H ⊕ K))
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (e : PhysicalSmallBigPathEvent n shared B A Δ D tag s) : ℝ :=
  |physicalSmallBigPathEventWeight n shared B A Δ D kbig ω μ qghost ρ
    (match tag with | some (.inl _) => Vghost | _ => Vedge) Vs qsmall tag s e|

theorem physicalSmallBigPathPositiveWeight_nonneg (tag : Option (H ⊕ K))
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (e : PhysicalSmallBigPathEvent n shared B A Δ D tag s) :
    0 ≤ physicalSmallBigPathPositiveWeight n shared B A Δ D kbig ω μ qghost ρ
      Vedge Vghost Vs qsmall tag s e := abs_nonneg _

variable [∀ g, Fintype (P g)] [∀ g p, NeZero (n g p)] [∀ k, Fintype (A k)]

noncomputable def physicalSmallBigPathPositiveAction (tag : Option (H ⊕ K))
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ) :=
  let _ : ∀ (tag : Option (H ⊕ K)) (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)),
      Fintype (PhysicalSmallBigPathEvent n shared B A Δ D tag s) :=
    physicalSmallBigPathEventFintype n shared B A Δ D
  finiteLocalEventAction (PhysicalSmallBigPathEvent n shared B A Δ D)
    (physicalSmallBigPathPositiveWeight n shared B A Δ D kbig ω μ qghost ρ Vedge Vghost Vs qsmall)
    (physicalSmallBigPathEventTarget n shared B A Δ D kbig) tag F

theorem physical_small_big_path_positive_ghost_eq
    (hμ : ∀ g p, 0 ≤ μ g p) (j : H) (hq : 0 ≤ qghost j)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ) :
    physicalSmallBigPathPositiveAction n shared B A Δ D kbig ω μ qghost ρ
      Vedge Vghost Vs qsmall (some (.inl j)) F =
    physicalSmallBigGhostAction (fun g => physicalGhostRetention (n g) (qghost j) ρ)
      (fun g z => |physicalGhostTermination (n g) (qghost j) ρ z|)
      (fun g z => |physicalGhostBirth (n g) (qghost j) ρ (Vghost g) z|)
      (fun g => unrestrictedResidueWeight (μ g)) M B (fun _ _ => 1) F := by
  funext s
  rw [physical_small_big_ghost_eq_event_sum]
  unfold physicalSmallBigPathPositiveAction finiteLocalEventAction
  apply sum_congr
  · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
  · intro e _
    change CoupledGhostEvent M B s.2 at e
    simp only [physicalSmallBigPathPositiveWeight, physicalSmallBigPathEventWeight,
      physicalSmallBigPathEventTarget, mul_one]
    rw [coupledGhostJointEventWeight_abs]
    · intro g z
      unfold physicalGhostRetention
      split_ifs
      · exact div_nonneg hq (sq_nonneg ρ)
      · exact zero_le_one
    · intro g z
      exact hμ g z.1

omit [∀ g, Fintype (P g)] [∀ g p, NeZero (n g p)] [∀ k, Fintype (A k)] in
theorem physical_small_big_path_edge_weight_nonneg
    (hVs : ∀ s, 0 < Vs s) (hω : ∀ k a, 0 ≤ ω k a)
    (hμ : ∀ g p, 0 ≤ μ g p) (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ Vedge g)
    (k : K) (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (e : PhysicalSmallBigPathEvent n shared B A Δ D (some (.inr k) : Option (H ⊕ K)) s) :
    0 ≤ physicalSmallBigPathEventWeight n shared B A Δ D kbig ω μ qghost ρ Vedge Vs qsmall
      (some (.inr k)) s e := by
  unfold physicalSmallBigPathEventWeight
  dsimp only
  apply mul_nonneg
  · split_ifs
    · exact mul_nonneg (physical_completion_mass_pos Vs _ ell hVs).le
        (mul_nonneg (physical_residue_vertex_weight_nonneg _ (Real.sqrt_nonneg qsmall) _)
          (physical_residue_vertex_weight_nonneg _ (Real.sqrt_nonneg qsmall) _))
    · exact le_rfl
  · exact fullActiveEdgeEventWeight_nonneg n (shared k) B (fun _ => A k) _ _ _ μ ρ Vedge
      (fun _ a => hω k a) hμ hρ hV s.2 e.2

end
end Bounty
end

section

/- Paths and memory heights for moving small states and capped big memory. -/
open Finset
open scoped Classical
namespace Bounty
section
variable {H K S G : Type} {Ps : S → Finset ℕ} {P : G → Type}
  [Fintype S] [Fintype G]
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : K → ∀ g, Finset (Fin (M g))) (B : ℕ) (A : K → Type)
  (Δ D : ∀ k, PhysicalSharedLists Ps J → SharedActiveLabels P (shared k) → A k → G → ℤ)
  (kbig : ∀ k, SharedActiveLabels P (shared k) → A k → ℤ)

abbrev PhysicalSmallBigPath (steps : List (Option (H ⊕ K)))
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)) :=
  FiniteEventPath (PhysicalSmallBigPathEvent (H := H) (J := J) (ell := ell) n shared B A Δ D)
    (physicalSmallBigPathEventTarget n shared B A Δ D kbig) steps s

noncomputable def physicalSmallBigPathPeak (steps : List (Option (H ⊕ K)))
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (p : PhysicalSmallBigPath n shared B A Δ D kbig steps s) : ℕ :=
  finiteEventPathMaximum (PhysicalSmallBigPathEvent (H := H) (J := J) (ell := ell) n shared B A Δ D)
    (physicalSmallBigPathEventTarget n shared B A Δ D kbig)
    (fun s => productTotalMemory s.2) steps s p

variable [∀ g, Fintype (P g)] [∀ g p, NeZero (n g p)] [∀ k, Fintype (A k)]
  (ω : ∀ k, A k → ℝ) (μ : ∀ g, P g → ℝ)
  (qghost : H → ℝ) (ρ : ℝ) (V : G → ℝ) (Vs : S → ℝ) (qsmall : ℝ)

noncomputable def physicalSmallBigPathAction (steps : List (Option (H ⊕ K)))
    (phase : ∀ s, PhysicalSmallBigPath n shared B A Δ D kbig steps s → ℂ)
    (f : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ) :=
  let _ : ∀ (k : Option (H ⊕ K)) s,
      Fintype (PhysicalSmallBigPathEvent (H := H) (J := J) (ell := ell) n shared B A Δ D k s) :=
    physicalSmallBigPathEventFintype (H := H) (J := J) (ell := ell) n shared B A Δ D
  finiteEventPathAction (PhysicalSmallBigPathEvent (H := H) (J := J) (ell := ell) n shared B A Δ D)
    (physicalSmallBigPathEventTarget n shared B A Δ D kbig)
    (physicalSmallBigPathEventWeight n shared B A Δ D kbig ω μ qghost ρ V Vs qsmall)
    steps phase f
end
end Bounty
end

section

/- Supported event transport preserves every small coordinate while changing
the big-memory cap. Target agreement is asserted only at nonzero weight. -/

open Finset
open scoped Classical

namespace Bounty

section
variable {H K S G : Type} {Ps : S → Finset ℕ} {P : G → Type}
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : K → ∀ g, Finset (Fin (M g))) (A : K → Type)
  (Δ D : ∀ k, PhysicalSharedLists Ps J → SharedActiveLabels P (shared k) → A k → G → ℤ)
  {b B : ℕ} (h : b ≤ B)

def physicalSmallBigPathEventCapEmbed (tag : Option (H ⊕ K))
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b)) :
    PhysicalSmallBigPathEvent n shared b A Δ D tag s →
      PhysicalSmallBigPathEvent n shared B A Δ D tag (physicalSmallBigCapEmbed h s) :=
  match tag with
  | none => id
  | some (.inl _) => coupledGhostEventCapEmbed h s.2
  | some (.inr k) => fun e => (e.1,
      fullActiveEdgeEventCapEquiv n (shared k) (fun _ => A k)
        (Δ k (physicalSharedPrefix s.1.2)) (D k (physicalSharedPrefix s.1.2)) h s.2 e.2)

theorem physicalSmallBigPathEventCapEmbed_injective (tag : Option (H ⊕ K))
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b)) :
    Function.Injective (physicalSmallBigPathEventCapEmbed n shared A Δ D h tag s) := by
  cases tag with
  | none => exact Function.injective_id
  | some tag =>
    cases tag with
    | inl j => exact coupledGhostEventCapEmbed_injective h s.2
    | inr k =>
      intro e f he
      exact Prod.ext (congrArg Prod.fst he) (congrArg Prod.snd he)

variable [Fintype S] [Fintype G]
  (kbig : ∀ k, SharedActiveLabels P (shared k) → A k → ℤ)
  (ω : ∀ k, A k → ℝ) (μ : ∀ g, P g → ℝ)
  (qghost : H → ℝ) (ρ : ℝ) (V : G → ℝ) (Vs : S → ℝ) (qsmall : ℝ)

theorem physicalSmallBigPathEventCapEmbed_target (tag : Option (H ⊕ K))
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b))
    (e : PhysicalSmallBigPathEvent n shared b A Δ D tag s)
    (hw : physicalSmallBigPathEventWeight n shared b A Δ D kbig ω μ qghost ρ V Vs qsmall tag s e ≠ 0) :
    physicalSmallBigPathEventTarget n shared B A Δ D kbig tag (physicalSmallBigCapEmbed h s)
        (physicalSmallBigPathEventCapEmbed n shared A Δ D h tag s e) =
      physicalSmallBigCapEmbed h (physicalSmallBigPathEventTarget n shared b A Δ D kbig tag s e) := by
  cases tag with
  | none => rfl
  | some tag =>
    cases tag with
    | inl j =>
      exact Prod.ext rfl (coupledGhostEventCapEmbed_target_of_ne_zero h
        (fun g => physicalGhostRetention (n g) (qghost j) ρ)
        (fun g => physicalGhostTermination (n g) (qghost j) ρ)
        (fun g => physicalGhostBirth (n g) (qghost j) ρ (V g))
        (fun g => unrestrictedResidueWeight (μ g)) s.2 e hw)
    | inr k =>
      change _ * _ ≠ 0 at hw
      exact Prod.ext rfl ((fullActiveEdgeEventTarget_cap_of_weight_ne_zero n (shared k) (fun _ => A k)
        (Δ k (physicalSharedPrefix s.1.2)) (D k (physicalSharedPrefix s.1.2)) h s.2
        (fun _ a => ω k a) μ ρ V e.2 (mul_ne_zero_iff.mp hw).2).symm)

theorem physicalSmallBigPathEventCapEmbed_weight (tag : Option (H ⊕ K))
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b))
    (hs : productTotalMemory s.2 ≤ b) (e : PhysicalSmallBigPathEvent n shared b A Δ D tag s) :
    physicalSmallBigPathEventWeight n shared b A Δ D kbig ω μ qghost ρ V Vs qsmall tag s e =
      if productTotalMemory (physicalSmallBigPathEventTarget n shared B A Δ D kbig tag
          (physicalSmallBigCapEmbed h s) (physicalSmallBigPathEventCapEmbed n shared A Δ D h tag s e)).2 ≤ b
      then physicalSmallBigPathEventWeight n shared B A Δ D kbig ω μ qghost ρ V Vs qsmall tag
        (physicalSmallBigCapEmbed h s) (physicalSmallBigPathEventCapEmbed n shared A Δ D h tag s e)
      else 0 := by
  cases tag with
  | none =>
      change _ = if productTotalMemory (fullActivePermutation e.2 (productStateCapEmbed h s.2)) ≤ b then _ else _
      rw [fullActivePermutation_total_memory, productStateCapEmbed_totalMemory, if_pos hs]
      rfl
  | some tag =>
    cases tag with
    | inl j =>
      exact coupledGhostEventCapEmbed_weight h
        (fun g => physicalGhostRetention (n g) (qghost j) ρ)
        (fun g => physicalGhostTermination (n g) (qghost j) ρ)
        (fun g => physicalGhostBirth (n g) (qghost j) ρ (V g))
        (fun g => unrestrictedResidueWeight (μ g)) s.2 hs e
    | inr k =>
      have he := fullActiveEdgeEventWeight_cap n (shared k) (fun _ => A k)
        (Δ k (physicalSharedPrefix s.1.2)) (D k (physicalSharedPrefix s.1.2)) h s.2
        (fun _ a => ω k a) μ ρ V hs e.2
      dsimp only [physicalSmallBigPathEventWeight, physicalSmallBigPathEventTarget,
        physicalSmallBigPathEventCapEmbed, physicalSmallBigCapEmbed]
      rw [he]
      (split_ifs <;> simp_all only [mul_zero]); rfl

theorem physicalSmallBigPathEventCapEmbed_surjective_of_ne_zero (tag : Option (H ⊕ K))
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b))
    (e : PhysicalSmallBigPathEvent n shared B A Δ D tag (physicalSmallBigCapEmbed h s))
    (hw : physicalSmallBigPathEventWeight n shared B A Δ D kbig ω μ qghost ρ V Vs qsmall tag
      (physicalSmallBigCapEmbed h s) e ≠ 0)
    (ht : productTotalMemory (physicalSmallBigPathEventTarget n shared B A Δ D kbig tag
      (physicalSmallBigCapEmbed h s) e).2 ≤ b) :
    ∃ d : PhysicalSmallBigPathEvent n shared b A Δ D tag s,
      physicalSmallBigPathEventCapEmbed n shared A Δ D h tag s d = e := by
  cases tag with
  | none => exact ⟨e, rfl⟩
  | some tag =>
    cases tag with
    | inl j =>
      exact coupledGhostEventCapEmbed_surjective_of_ne_zero h
        (fun g => physicalGhostRetention (n g) (qghost j) ρ)
        (fun g => physicalGhostTermination (n g) (qghost j) ρ)
        (fun g => physicalGhostBirth (n g) (qghost j) ρ (V g))
        (fun g => unrestrictedResidueWeight (μ g)) s.2 e hw ht
    | inr k => exact ⟨e, rfl⟩

theorem physicalSmallBigPathEvent_supported_target (tag : Option (H ⊕ K))
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b))
    (hs : productTotalMemory s.2 ≤ b) (e : PhysicalSmallBigPathEvent n shared b A Δ D tag s)
    (hw : physicalSmallBigPathEventWeight n shared b A Δ D kbig ω μ qghost ρ V Vs qsmall tag s e ≠ 0) :
    productTotalMemory (physicalSmallBigPathEventTarget n shared b A Δ D kbig tag s e).2 ≤ b := by
  cases tag with
  | none => exact (fullActivePermutation_total_memory e.2 s.2).le.trans hs
  | some tag =>
    cases tag with
    | inl j =>
      exact (coupledGhostJointEventWeight_support
        (fun g => physicalGhostRetention (n g) (qghost j) ρ)
        (fun g => physicalGhostTermination (n g) (qghost j) ρ)
        (fun g => physicalGhostBirth (n g) (qghost j) ρ (V g))
        (fun g => unrestrictedResidueWeight (μ g)) s.2 e hw).1.2
    | inr k =>
      change _ * _ ≠ 0 at hw
      have hb := (mul_ne_zero_iff.mp hw).2
      rw [fullActiveEdgeEventWeight_full_caps] at hb
      by_contra ht
      exact hb (if_neg (fun hc => ht hc.2))

theorem physicalSmallBigPathEventCapEmbed_support (k : Option (H ⊕ K))
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b))
    (hs : productTotalMemory s.2 ≤ b) (e : PhysicalSmallBigPathEvent n shared b A Δ D k s) :
    physicalSmallBigPathEventWeight n shared b A Δ D kbig ω μ qghost ρ V Vs qsmall k s e ≠ 0 ↔
      physicalSmallBigPathEventWeight n shared B A Δ D kbig ω μ qghost ρ V Vs qsmall k (physicalSmallBigCapEmbed h s)
        (physicalSmallBigPathEventCapEmbed n shared A Δ D h k s e) ≠ 0 ∧
      productTotalMemory (physicalSmallBigPathEventTarget n shared B A Δ D kbig k (physicalSmallBigCapEmbed h s)
        (physicalSmallBigPathEventCapEmbed n shared A Δ D h k s e)).2 ≤ b := by
  rw [physicalSmallBigPathEventCapEmbed_weight n shared A Δ D h kbig ω μ qghost ρ V Vs qsmall k s hs e]
  split_ifs <;> simp_all

theorem physicalSmallBigPathEventCapEmbed_weight_of_ne_zero (k : Option (H ⊕ K))
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b))
    (hs : productTotalMemory s.2 ≤ b) (e : PhysicalSmallBigPathEvent n shared b A Δ D k s)
    (hw : physicalSmallBigPathEventWeight n shared b A Δ D kbig ω μ qghost ρ V Vs qsmall k s e ≠ 0) :
    physicalSmallBigPathEventWeight n shared B A Δ D kbig ω μ qghost ρ V Vs qsmall k (physicalSmallBigCapEmbed h s)
      (physicalSmallBigPathEventCapEmbed n shared A Δ D h k s e) =
      physicalSmallBigPathEventWeight n shared b A Δ D kbig ω μ qghost ρ V Vs qsmall k s e := by
  have ht := ((physicalSmallBigPathEventCapEmbed_support n shared A Δ D h kbig ω μ qghost ρ V Vs qsmall k s hs e).mp hw).2
  exact ((physicalSmallBigPathEventCapEmbed_weight n shared A Δ D h kbig ω μ qghost ρ V Vs qsmall k s hs e).trans (if_pos ht)).symm

noncomputable def physicalSmallBigPathEventCapSupportEquiv (k : Option (H ⊕ K))
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b))
    (hs : productTotalMemory s.2 ≤ b) :
    {e : PhysicalSmallBigPathEvent n shared b A Δ D k s //
      physicalSmallBigPathEventWeight n shared b A Δ D kbig ω μ qghost ρ V Vs qsmall k s e ≠ 0} ≃
    {e : PhysicalSmallBigPathEvent n shared B A Δ D k (physicalSmallBigCapEmbed h s) //
      physicalSmallBigPathEventWeight n shared B A Δ D kbig ω μ qghost ρ V Vs qsmall k (physicalSmallBigCapEmbed h s) e ≠ 0 ∧
      productTotalMemory (physicalSmallBigPathEventTarget n shared B A Δ D kbig k (physicalSmallBigCapEmbed h s) e).2 ≤ b} :=
  Equiv.ofBijective (fun e => ⟨physicalSmallBigPathEventCapEmbed n shared A Δ D h k s e.val,
    (physicalSmallBigPathEventCapEmbed_support n shared A Δ D h kbig ω μ qghost ρ V Vs qsmall k s hs e.val).mp e.property⟩) ⟨by
      intro e f hef
      apply Subtype.ext
      exact physicalSmallBigPathEventCapEmbed_injective n shared A Δ D h k s (congrArg Subtype.val hef), by
    intro e
    obtain ⟨d, hd⟩ := physicalSmallBigPathEventCapEmbed_surjective_of_ne_zero n shared A Δ D h kbig ω μ qghost ρ V Vs qsmall k s e.val
      e.property.1 e.property.2
    have hw := (physicalSmallBigPathEventCapEmbed_support n shared A Δ D h kbig ω μ qghost ρ V Vs qsmall k s hs d).mpr
      (by simpa only [hd] using e.property)
    exact ⟨⟨d, hw⟩, Subtype.ext hd⟩⟩

theorem physicalSmallBigPathEventCapSupportEquiv_apply (k : Option (H ⊕ K))
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b))
    (hs : productTotalMemory s.2 ≤ b)
    (e : {e : PhysicalSmallBigPathEvent n shared b A Δ D k s //
      physicalSmallBigPathEventWeight n shared b A Δ D kbig ω μ qghost ρ V Vs qsmall k s e ≠ 0}) :
    (physicalSmallBigPathEventCapSupportEquiv n shared A Δ D h kbig ω μ qghost ρ V Vs qsmall k s hs e).val =
      physicalSmallBigPathEventCapEmbed n shared A Δ D h k s e.val := rfl

theorem physicalSmallBigPathEventCapSupportEquiv_target (k : Option (H ⊕ K))
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b))
    (hs : productTotalMemory s.2 ≤ b)
    (e : {e : PhysicalSmallBigPathEvent n shared b A Δ D k s //
      physicalSmallBigPathEventWeight n shared b A Δ D kbig ω μ qghost ρ V Vs qsmall k s e ≠ 0}) :
    physicalSmallBigCapEmbed h (physicalSmallBigPathEventTarget n shared b A Δ D kbig k s e.val) =
      physicalSmallBigPathEventTarget n shared B A Δ D kbig k (physicalSmallBigCapEmbed h s)
        (physicalSmallBigPathEventCapSupportEquiv n shared A Δ D h kbig ω μ qghost ρ V Vs qsmall k s hs e).val := by
  exact (physicalSmallBigPathEventCapEmbed_target n shared A Δ D h kbig ω μ qghost ρ V Vs qsmall k s e.val e.property).symm

theorem physicalSmallBigPathEventCapSupportEquiv_weight (k : Option (H ⊕ K))
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b))
    (hs : productTotalMemory s.2 ≤ b)
    (e : {e : PhysicalSmallBigPathEvent n shared b A Δ D k s //
      physicalSmallBigPathEventWeight n shared b A Δ D kbig ω μ qghost ρ V Vs qsmall k s e ≠ 0}) :
    physicalSmallBigPathEventWeight n shared B A Δ D kbig ω μ qghost ρ V Vs qsmall k (physicalSmallBigCapEmbed h s)
        (physicalSmallBigPathEventCapSupportEquiv n shared A Δ D h kbig ω μ qghost ρ V Vs qsmall k s hs e).val =
      physicalSmallBigPathEventWeight n shared b A Δ D kbig ω μ qghost ρ V Vs qsmall k s e.val := by
  exact physicalSmallBigPathEventCapEmbed_weight_of_ne_zero n shared A Δ D h kbig ω μ qghost ρ V Vs qsmall k s hs e.val e.property

end
end Bounty
end

section

/- Fourier inversion over precisely the active allocation slots. -/

open Finset MeasureTheory

namespace Bounty

abbrev ActiveAllocationIndex {N : ℕ} (active : Fin N → Bool) :=
  {i : Fin N // active i = true}

noncomputable def activeAllocationFourierWeight {N : ℕ} (A : ℝ)
    (active take : Fin N → Bool) (ξ : ActiveAllocationIndex active → ℝ) : ℂ :=
  ∏ i, typeIICutoffFourier A (take i.val) (ξ i)

noncomputable def activeAllocationFourierIntegrand {N : ℕ} (A R : ℝ)
    (v s : Fin N → ℝ) (active take : Fin N → Bool)
    (ξ : ActiveAllocationIndex active → ℝ) : ℂ :=
  ∏ i, typeIICutoffFourierIntegrand A (take i.val)
    ((allocationPrefixResidual v R take i.val - v i.val) / s i.val) (ξ i)

theorem compact_allocation_active_product {N : ℕ} (A R : ℝ)
    (v s : Fin N → ℝ) (active take : Fin N → Bool)
    (hkeep : ∀ i, active i = false → take i = false) :
    compactAllocationWeight A N v s active R take =
      ∏ i : ActiveAllocationIndex active,
        typeIISmoothCutoff A (take i.val)
          ((allocationPrefixResidual v R take i.val - v i.val) / s i.val) := by
  classical
  unfold compactAllocationWeight
  calc
    _ = ∏ i, if active i = true then typeIISmoothCutoff A (take i)
        ((allocationPrefixResidual v R take i - v i) / s i) else 1 := by
      apply prod_congr rfl
      intro i hi
      cases ha : active i
      · simp [compactSlotTransition, hkeep i ha]
      · simp [compactSlotTransition]
    _ = ∏ i ∈ univ.filter (fun i => active i = true), typeIISmoothCutoff A (take i)
        ((allocationPrefixResidual v R take i - v i) / s i) := (prod_filter _ _).symm
    _ = _ := prod_subtype _ (by simp) _

theorem active_allocation_fourier_weight_integrable {N : ℕ} (A : ℝ)
    (active take : Fin N → Bool) :
    Integrable (activeAllocationFourierWeight A active take) :=
  Integrable.fintype_prod (fun i => typeII_cutoff_fourier_integrable A (take i.val))

theorem active_allocation_fourier_integrand_integrable {N : ℕ} (A R : ℝ)
    (v s : Fin N → ℝ) (active take : Fin N → Bool) :
    Integrable (activeAllocationFourierIntegrand A R v s active take) :=
  Integrable.fintype_prod (fun i => typeII_cutoff_fourier_integrand_integrable A _ (take i.val))

theorem compact_allocation_fourier_inversion {N : ℕ} (A R : ℝ)
    (v s : Fin N → ℝ) (active take : Fin N → Bool)
    (hkeep : ∀ i, active i = false → take i = false) :
    (compactAllocationWeight A N v s active R take : ℂ) =
      ∫ ξ : ActiveAllocationIndex active → ℝ,
        activeAllocationFourierIntegrand A R v s active take ξ := by
  rw [compact_allocation_active_product A R v s active take hkeep]
  simp only [Complex.ofReal_prod, activeAllocationFourierIntegrand,
    integral_fintype_prod_volume_eq_prod]
  apply prod_congr rfl
  intro i hi
  exact typeII_cutoff_fourier_inversion A _ (take i.val)

theorem active_allocation_fourier_integrand_norm {N : ℕ} (A R : ℝ)
    (v s : Fin N → ℝ) (active take : Fin N → Bool)
    (ξ : ActiveAllocationIndex active → ℝ) :
    ‖activeAllocationFourierIntegrand A R v s active take ξ‖ =
      ‖activeAllocationFourierWeight A active take ξ‖ := by
  simp only [activeAllocationFourierIntegrand, activeAllocationFourierWeight,
    norm_prod, typeII_cutoff_fourier_integrand_norm]

theorem active_allocation_fourier_l1_le {N : ℕ} (A C : ℝ)
    (hC1 : 1 ≤ C)
    (hC : ∀ take : Bool, (∫ ξ : ℝ, ‖typeIICutoffFourier A take ξ‖) ≤ C)
    (active take : Fin N → Bool) :
    (∫ ξ : ActiveAllocationIndex active → ℝ,
      ‖activeAllocationFourierWeight A active take ξ‖) ≤ C ^ N := by
  simp only [activeAllocationFourierWeight, norm_prod]
  rw [integral_fintype_prod_volume_eq_prod
    (fun (i : ActiveAllocationIndex active) (ξ : ℝ) =>
      ‖typeIICutoffFourier A (take i.val) ξ‖)]
  calc
    _ ≤ ∏ _i : ActiveAllocationIndex active, C :=
      prod_le_prod₀ (fun _ _ => integral_nonneg (fun _ => norm_nonneg _))
        (fun i _ => hC (take i.val))
    _ = C ^ Fintype.card (ActiveAllocationIndex active) := by simp
    _ ≤ C ^ N := by
      apply pow_le_pow_right₀ hC1
      simpa only [Fintype.card_fin] using Fintype.card_subtype_le (fun i => active i = true)

end Bounty

end

section

/- Uniform Fourier costs and power cutoffs for admissible Type-II scales. -/

open Filter MeasureTheory

namespace Bounty

theorem typeII_scale_fourier_polynomial_l1 {A K₀ Cz : ℝ} (hA : 0 ≤ A) :
    ∃ B : ℝ, 0 < B ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (U V E Z : ℝ) (k : ℤ), 0 < U → 0 < V → 0 ≤ Z → k ≠ 0 →
        E = U * L ^ (-K₀) → 1 ≤ U * V → Z / (U * V) ≤ L ^ Cz →
          (∫ ξ : EuclideanSpace ℝ (Fin 3),
            ‖typeIIPulledFourier A (L ^ 88) (U / (2 * (k : ℝ) * E))
              (Z / ((k : ℝ) * U * V)) (1 / (U * V)) ξ‖) ≤ L ^ B := by
  have ha : 0 ≤ typeIIScaleEnvelopeExponent K₀ Cz :=
    (by norm_num : (0 : ℝ) ≤ 88).trans (le_max_left _ _)
  obtain ⟨B, hB, hb⟩ := typeII_pulled_fourier_polynomial_l1_cost hA ha
  refine ⟨B, hB, ?_⟩
  filter_upwards [hb, eventually_ge_atTop (1 : ℝ)] with L hcost hL
  intro U V E Z k hU hV hZ hk hE hUV hZbound
  have hp := typeII_scale_parameter_envelope hL hU hV hZ hk hE hUV hZbound
  exact hcost (typeIIScaleParameters L U V E Z k) hp

theorem typeII_scale_fourier_exists_power_cutoff {A K₀ Cz D : ℝ}
    (hA : 0 ≤ A) (hD : 0 ≤ D) :
    ∃ B : ℝ, 0 < B ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (U V E Z : ℝ) (k : ℤ), 0 < U → 0 < V → 0 ≤ Z → k ≠ 0 →
        E = U * L ^ (-K₀) → 1 ≤ U * V → Z / (U * V) ≤ L ^ Cz →
          ∀ t : EuclideanSpace ℝ (Fin 3),
            ‖(typeIIPulledCutoff A (L ^ 88) (U / (2 * (k : ℝ) * E))
                  (Z / ((k : ℝ) * U * V)) (1 / (U * V)) t : ℂ) -
                ∫ ξ in {ξ : EuclideanSpace ℝ (Fin 3) | ‖ξ‖ ≤ L ^ B},
                  typeIIPulledFourierIntegrand A (L ^ 88) (U / (2 * (k : ℝ) * E))
                    (Z / ((k : ℝ) * U * V)) (1 / (U * V)) t ξ‖ ≤ L ^ (-D) := by
  have ha : 0 ≤ typeIIScaleEnvelopeExponent K₀ Cz :=
    (by norm_num : (0 : ℝ) ≤ 88).trans (le_max_left _ _)
  obtain ⟨B, hB, hb⟩ := typeII_pulled_fourier_exists_power_cutoff hA ha hD
  refine ⟨B, hB, ?_⟩
  filter_upwards [hb, eventually_ge_atTop (1 : ℝ)] with L hcost hL
  intro U V E Z k hU hV hZ hk hE hUV hZbound t
  have hp := typeII_scale_parameter_envelope hL hU hV hZ hk hE hUV hZbound
  exact hcost (typeIIScaleParameters L U V E Z k) hp t

end Bounty
end

section

/- Polynomially many free labels above an exponential threshold have negligible reciprocal mass. -/

open Finset Filter

namespace Bounty

theorem finite_reciprocal_sum_le_card_div (T : Finset ℕ) {P : ℝ}
    (hP : 0 < P) (hT : ∀ p ∈ T, P ≤ (p : ℝ)) :
    (∑ p ∈ T, 1 / (p : ℝ)) ≤ (T.card : ℝ) / P := by
  calc
    _ ≤ ∑ _p ∈ T, 1 / P :=
      sum_le_sum (fun p hp => one_div_le_one_div_of_le hP (hT p hp))
    _ = _ := by simp [div_eq_mul_inv]

theorem eventually_rpow_mul_exp_neg_rpow_le {a : ℝ} (ha : 0 < a) (C D : ℝ) :
    ∀ᶠ L : ℝ in atTop, L ^ C * Real.exp (-(L ^ a)) ≤ L ^ (-D) := by
  filter_upwards [eventually_gt_atTop (0 : ℝ),
    eventually_mul_rpow_log_add_le_rpow (a := 0) ha ha (show (0 : ℝ) < 1 by norm_num)
      (C + D) 0] with L hL hlog
  simp only [Real.rpow_zero, mul_one, add_zero, one_mul] at hlog
  simp only [Real.rpow_def_of_pos hL] at hlog ⊢
  rw [← Real.exp_add]
  apply Real.exp_le_exp.mpr
  nlinarith

theorem eventually_weighted_free_label_reciprocals_le {a : ℝ}
    (ha : 0 < a) (C D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (T : Finset ℕ) (H : ℝ), 0 ≤ H →
      H * T.card ≤ L ^ C → (∀ p ∈ T, Real.exp (L ^ a) ≤ (p : ℝ)) →
      H * (∑ p ∈ T, 1 / (p : ℝ)) ≤ L ^ (-D) := by
  filter_upwards [eventually_rpow_mul_exp_neg_rpow_le ha C D] with L hL
  intro T H hH hsize hT
  calc
    _ ≤ H * ((T.card : ℝ) / Real.exp (L ^ a)) :=
      mul_le_mul_of_nonneg_left (finite_reciprocal_sum_le_card_div T (Real.exp_pos _) hT) hH
    _ = (H * T.card) * Real.exp (-(L ^ a)) := by rw [Real.exp_neg]; ring
    _ ≤ L ^ C * Real.exp (-(L ^ a)) :=
      mul_le_mul_of_nonneg_right hsize (Real.exp_pos _).le
    _ ≤ _ := hL

end Bounty
end

section

/- Transfer an integrable bound on the actual physical pairings to the root-weighted sum. -/

open MeasureTheory

namespace Bounty

theorem physical_mellin_root_norm_bound
    {G I : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (hP : ∀ g p, p ∈ P g → 0 < p)
    (V : G → ℝ) (hV : ∀ g, 0 < V g) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (positions : Finset ℤ) (f g : ℤ → ℂ)
    (hsource : ∀ n ∈ positions, f n ≠ 0 → 0 < n)
    (X Z : ℝ) (hX : 0 < X) (hZ : 0 < Z)
    (ρ : ℝ → ℂ) (ν : ℝ → ℝ) (hρ : Integrable ρ) (hν : Continuous ν)
    (Ψ : ℝ → ℂ)
    (hΨ : ∀ t : ℝ, 0 < t → Ψ t = ∫ v : ℝ, ρ v * physicalMellinPhase (ν v) t)
    (B : ℝ → ℝ) (hB : Integrable (fun v => ‖ρ v‖ * B v))
    (hpair : ∀ᵐ v, ‖physicalMellinPairing V patterns C q ζ k K positions f g X Z (ν v)‖ ≤ B v) :
    ‖physicalMellinRootCorrelation V patterns C q ζ k K positions f g Ψ Z‖ ≤
      X⁻¹ * ∫ v : ℝ, ‖ρ v‖ * B v := by
  rw [physical_mellin_root_eq_integral hP V hV patterns C hq ζ k K positions f g hsource
    X Z (ne_of_gt hX) hZ ρ ν hρ hν Ψ hΨ,
    norm_mul, norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hX]
  apply mul_le_mul_of_nonneg_left _ (inv_nonneg.mpr hX.le)
  apply norm_integral_le_of_norm_le hB
  filter_upwards [hpair] with v hv
  rw [norm_mul]
  exact mul_le_mul_of_nonneg_left hv (norm_nonneg _)

end Bounty
end

section

/- Instantiate physical Mellin separation with the actual compact cutoff Fourier transform. -/

open MeasureTheory

namespace Bounty

theorem physical_typeII_cutoff_mellin_representation (A t : ℝ) (active : Bool) :
    (typeIISmoothCutoff A active (Real.log t) : ℂ) =
      ∫ v : ℝ, typeIICutoffFourier A active v * physicalMellinPhase (2 * Real.pi * v) t := by
  rw [typeII_cutoff_fourier_inversion]
  apply integral_congr_ae
  exact Filter.Eventually.of_forall (fun v => mul_comm _ _)

theorem physical_typeII_cutoff_root_eq_integral
    {G I : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (hP : ∀ g p, p ∈ P g → 0 < p)
    (V : G → ℝ) (hV : ∀ g, 0 < V g) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (positions : Finset ℤ) (f g : ℤ → ℂ)
    (hsource : ∀ n ∈ positions, f n ≠ 0 → 0 < n)
    (X Z : ℝ) (hX : X ≠ 0) (hZ : 0 < Z) (A : ℝ) (active : Bool) :
    physicalMellinRootCorrelation V patterns C q ζ k K positions f g
      (fun t => (typeIISmoothCutoff A active (Real.log t) : ℂ)) Z =
      (X : ℂ)⁻¹ * ∫ v : ℝ, typeIICutoffFourier A active v *
        physicalMellinPairing V patterns C q ζ k K positions f g X Z (2 * Real.pi * v) := by
  exact physical_mellin_root_eq_integral hP V hV patterns C hq ζ k K positions f g hsource
    X Z hX hZ (typeIICutoffFourier A active) (fun v => 2 * Real.pi * v)
    (typeII_cutoff_fourier_integrable A active) (by fun_prop)
    (fun t => (typeIISmoothCutoff A active (Real.log t) : ℂ))
    (fun t _ => physical_typeII_cutoff_mellin_representation A t active)

end Bounty
end

section

/- The full compact, range-restricted allocation retains the original marking. -/

open Finset Real

namespace Bounty

noncomputable def candidateRangeAllocationMass (c L : ℝ) (r jStar : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) (E : ℝ) : ℝ :=
  ∑ take : Fin ((candidateQIndices c L).card*r) → Bool,
    if E/L^88 ≤ (candidateAllocatedFactor c L r jStar x take : ℝ) ∧
      (candidateAllocatedFactor c L r jStar x take : ℝ) ≤ E
    then candidateCompactAllocationWeight c L r jStar x (log E) take else 0

noncomputable def candidateCompactRangeQWeight (c L : ℝ) (r jStar : ℕ) (E : ℝ) (n : ℕ) : ℝ :=
  ∑ x : ∀ slot, candidateQSlotChoices c L r jStar slot,
    if orderedSlotProduct (candidateQSlotChoices c L r jStar) x = n
    then candidateRangeAllocationMass c L r jStar x E /
      ((r.factorial : ℝ)^(candidateQIndices c L).card) else 0

noncomputable def candidateCompactRangeCoefficient (c L q : ℝ) (r jStar : ℕ) (E : ℝ) (u : ℕ) : ℝ :=
  candidateCompactRangeQWeight c L r jStar E
    (primePoolFreePart ((candidatePIndices c L).biUnion (candidatePBand (c*L))) u) *
  markedDivisorWeight (candidatePIndices c L) (candidatePBand (c*L)) q
    (fun j => ∑ p ∈ candidatePBand (c*L) j, 1/(p : ℝ)) (fun _ => 1) (u : ℤ)

theorem candidate_range_allocation_mass_bounds (c L : ℝ) (r jStar : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) (E : ℝ) :
    0 ≤ candidateRangeAllocationMass c L r jStar x E ∧
      candidateRangeAllocationMass c L r jStar x E ≤ 1 := by
  constructor
  · exact sum_nonneg (fun take _ => by
      split_ifs
      · exact (candidate_compact_allocation_bounds c L r jStar x (log E) take).1
      · exact le_rfl)
  · apply le_trans ?_ (candidate_compact_allocation_total_mass_le_one c L r jStar x (log E))
    apply sum_le_sum
    intro take _
    split_ifs
    · exact le_rfl
    · exact (candidate_compact_allocation_bounds c L r jStar x (log E) take).1

theorem candidate_compact_range_Q_bounds (c L : ℝ) (r jStar : ℕ) (E : ℝ) (n : ℕ) :
    0 ≤ candidateCompactRangeQWeight c L r jStar E n ∧
      candidateCompactRangeQWeight c L r jStar E n ≤ candidateQWeight c L r jStar n := by
  classical
  have sum_compare {X : Type} (s t : Finset X) (f g : X → ℝ)
      (hst : s=t) (hfg : ∀ x ∈ s, f x ≤ g x) : (∑ x ∈ s, f x) ≤ ∑ x ∈ t, g x := by
    rw [← hst]
    exact sum_le_sum hfg
  have hnorm : 0 ≤ (r.factorial : ℝ)^(candidateQIndices c L).card := by positivity
  constructor
  · exact sum_nonneg (fun x _ => by
      split_ifs
      · exact div_nonneg (candidate_range_allocation_mass_bounds c L r jStar x E).1 hnorm
      · exact le_rfl)
  · unfold candidateCompactRangeQWeight candidateQWeight orderedSlotWeight
    apply sum_compare
    · ext x; simp only [mem_univ]
    · intro x hx
      split_ifs
      · exact div_le_div_of_nonneg_right (candidate_range_allocation_mass_bounds c L r jStar x E).2 hnorm
      · exact le_rfl

theorem candidate_compact_range_coefficient_bounds (c L : ℝ) {q : ℝ} (hq : 0 ≤ q)
    (r jStar : ℕ) (E : ℝ) (u : ℕ) :
    0 ≤ candidateCompactRangeCoefficient c L q r jStar E u ∧
      candidateCompactRangeCoefficient c L q r jStar E u ≤ candidateCoefficient c L q r jStar u := by
  have hw := marked_divisor_weight_nonneg (candidatePIndices c L) (candidatePBand (c*L)) hq
    (fun j => ∑ p ∈ candidatePBand (c*L) j, 1/(p : ℝ)) (fun _ => 1)
    (fun _ _ => sum_nonneg (fun _ _ => by positivity)) (u : ℤ)
  have hb := candidate_compact_range_Q_bounds c L r jStar E
    (primePoolFreePart ((candidatePIndices c L).biUnion (candidatePBand (c*L))) u)
  exact ⟨mul_nonneg hb.1 hw, mul_le_mul_of_nonneg_right hb.2 hw⟩

theorem candidate_range_allocation_mass_eq_one (c L : ℝ) (r jStar : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) (E : ℝ)
    (hunit : (∑ take, candidateCompactAllocationWeight c L r jStar x (log E) take) = 1)
    (hrange : ∀ take, 0 < candidateCompactAllocationWeight c L r jStar x (log E) take →
      E/L^88 ≤ (candidateAllocatedFactor c L r jStar x take : ℝ) ∧
        (candidateAllocatedFactor c L r jStar x take : ℝ) ≤ E) :
    candidateRangeAllocationMass c L r jStar x E = 1 := by
  rw [← hunit]
  apply sum_congr rfl
  intro take ht
  split_ifs with h
  · rfl
  · have hn := (candidate_compact_allocation_bounds c L r jStar x (log E) take).1
    have hp : ¬0 < candidateCompactAllocationWeight c L r jStar x (log E) take :=
      fun hp => h (hrange take hp)
    linarith

end Bounty
end

section

/- Smoothing the literal candidate window with the specified smooth cutoff. -/

open Finset Filter Real

namespace Bounty

theorem exists_candidate_actual_window_smoothing_error_bound {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1) (A D : ℝ) :
    ∃ B : ℝ, 1 ≤ B ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (jStar : ℕ) (T : Finset ℕ) (F : ℕ → ℕ → ℂ),
      arithmeticProductWindow 1 (exp L) ⊆ T →
      (∀ u, ∀ m ∈ (2*u+1).divisors, ‖F u m‖ ≤ L^A) →
      ‖(∑ u ∈ arithmeticProductWindow 1 (exp L),
          (candidateCoefficient c L q r jStar u : ℂ) *
            (∑ m ∈ (2*u+1).divisors, F u m)) -
        (∑ u ∈ T, (candidateCoefficient c L q r jStar u : ℂ) *
            (typeIIWindowSmooth (L^(-B)) ((u : ℝ)/exp L) : ℂ) *
            (∑ m ∈ (2*u+1).divisors, F u m))‖ ≤ exp L * L^(-D) := by
  obtain ⟨B, hB, hbound⟩ := exists_candidate_sharp_smoothing_error_bound hc hr hq0 hq1 A D
  refine ⟨B, hB, ?_⟩
  filter_upwards [hbound, eventually_gt_atTop (0 : ℝ)] with L hL hL0
  intro jStar T F hT hF
  apply hL jStar T (fun u => typeIIWindowSmooth (L^(-B)) ((u : ℝ)/exp L)) F hT
  · intro u hu
    exact typeII_window_smooth_bounds _ _
  · intro u hu hnot
    exact typeII_window_smooth_ratio_eq_off_boundary (exp_pos L)
      (rpow_pos_of_pos hL0 _) hnot
  · intro u hu m hm
    exact hF u m hm

theorem exists_candidate_actual_window_factorization_smoothing_error_bound
    {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1) (A D : ℝ) :
    ∃ B : ℝ, 1 ≤ B ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (jStar : ℕ) (T : Finset ℕ) (α β : ℕ → ℂ),
      arithmeticProductWindow 1 (exp L) ⊆ T →
      (∀ m, ‖α m‖ ≤ L^A) → (∀ n, ‖β n‖ ≤ L^A) →
      ‖(∑ u ∈ arithmeticProductWindow 1 (exp L),
          (candidateCoefficient c L q r jStar u : ℂ) *
            (∑ m ∈ (2*u+1).divisors, α m * β ((2*u+1)/m))) -
        (∑ u ∈ T, (candidateCoefficient c L q r jStar u : ℂ) *
            (typeIIWindowSmooth (L^(-B)) ((u : ℝ)/exp L) : ℂ) *
            (∑ m ∈ (2*u+1).divisors, α m * β ((2*u+1)/m)))‖ ≤ exp L * L^(-D) := by
  obtain ⟨B, hB, hbound⟩ :=
    exists_candidate_factorization_sharp_smoothing_error_bound hc hr hq0 hq1 A D
  refine ⟨B, hB, ?_⟩
  filter_upwards [hbound, eventually_gt_atTop (0 : ℝ)] with L hL hL0
  intro jStar T α β hT hα hβ
  apply hL jStar T (fun u => typeIIWindowSmooth (L^(-B)) ((u : ℝ)/exp L)) α β hT
  · intro u hu
    exact typeII_window_smooth_bounds _ _
  · intro u hu hnot
    exact typeII_window_smooth_ratio_eq_off_boundary (exp_pos L)
      (rpow_pos_of_pos hL0 _) hnot
  · exact hα
  · exact hβ


end Bounty
end

section

/- Apply the proved Mellin cutoff to the actual candidate test on its coarse finite support. -/

open Finset Filter MeasureTheory Real

namespace Bounty

noncomputable def candidateWindowMellinIntegrand (c L q : ℝ) (r jStar : ℕ)
    (B : ℝ) (F : ℕ → ℕ → ℂ) (ξ : ℝ) : ℂ :=
  finiteWindowMellinIntegrand L B (candidateWindowBox L)
    (fun u => (candidateCoefficient c L q r jStar u : ℂ))
    (fun u => ∑ m ∈ (2*u+1).divisors, F u m) ξ

theorem candidate_window_mellin_integrable (c L q : ℝ) (r jStar : ℕ)
    (B : ℝ) (F : ℕ → ℕ → ℂ) :
    Integrable (candidateWindowMellinIntegrand c L q r jStar B F) := by
  apply finite_window_mellin_integrable
  intro u hu
  exact (mem_candidate_window_box_bounds hu).1

theorem exists_candidate_smooth_window_truncation_bound {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (B : ℝ) (hB : 0 ≤ B) (A D : ℝ) :
    ∃ K : ℝ, 0 < K ∧ ∀ᶠ L : ℝ in atTop, ∀ (jStar : ℕ) (F : ℕ → ℕ → ℂ),
      (∀ u ∈ candidateWindowBox L, ∀ m ∈ (2*u+1).divisors, ‖F u m‖ ≤ L^A) →
      ‖(∑ u ∈ candidateWindowBox L, (candidateCoefficient c L q r jStar u : ℂ) *
          (typeIIWindowSmooth (L^(-B)) ((u:ℝ)/exp L) : ℂ) *
          (∑ m ∈ (2*u+1).divisors, F u m)) -
        (∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ L^K}, candidateWindowMellinIntegrand c L q r jStar B F ξ)‖ ≤
          exp L * L^(-D) := by
  obtain ⟨C, hC, hmass⟩ := exists_candidate_window_box_absolute_bound hc hr hq0 hq1 A
  let E := C+max D 0
  have hE : 0 ≤ E := add_nonneg hC (le_max_right _ _)
  obtain ⟨K, hK, hcut⟩ := typeII_window_mellin_power_cutoff hB hE
  refine ⟨K, hK, ?_⟩
  filter_upwards [hmass, hcut, eventually_ge_atTop (1 : ℝ)] with L hmassL hcutL hL
  intro jStar F hF
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hfinite := finite_window_mellin_error_le L B (candidateWindowBox L)
    (fun u => (candidateCoefficient c L q r jStar u : ℂ))
    (fun u => ∑ m ∈ (2*u+1).divisors, F u m)
    (fun u => (typeIIWindowSmooth (L^(-B)) ((u:ℝ)/exp L) : ℂ))
    (fun u hu => (mem_candidate_window_box_bounds hu).1)
    {ξ : ℝ | ‖ξ‖ ≤ L^K} (L^(-E)) (by
      intro u hu
      have hup : (0 : ℝ) < u := by exact_mod_cast (mem_candidate_window_box_bounds hu).1
      simpa only [mul_one, Complex.ofReal_natCast, Complex.ofReal_one, Complex.one_cpow,
        candidateWindowMellinKernel] using
        hcutL (u:ℝ) 1 (exp L) hup (by norm_num) (exp_pos L))
  change ‖(∑ u ∈ candidateWindowBox L, _ ) -
    (∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ L^K}, candidateWindowMellinIntegrand c L q r jStar B F ξ)‖ ≤ _ at hfinite
  have hweights : (∑ u ∈ candidateWindowBox L,
      ‖(candidateCoefficient c L q r jStar u : ℂ)‖ * ‖∑ m ∈ (2*u+1).divisors, F u m‖) ≤
      exp L * L^C := by
    apply le_trans ?_ (hmassL jStar F hF)
    apply sum_le_sum
    intro u hu
    rw [Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (candidate_coefficient_nonneg c L hq0 r jStar u)]
    exact mul_le_mul_of_nonneg_left (norm_sum_le _ _)
      (candidate_coefficient_nonneg c L hq0 r jStar u)
  apply hfinite.trans
  calc
    _ ≤ L^(-E)*(exp L*L^C) :=
      mul_le_mul_of_nonneg_left hweights (rpow_nonneg hL0.le _)
    _ = exp L*L^(-max D 0) := by
      rw [mul_left_comm, ← rpow_add hL0]
      congr 2
      dsimp [E]
      ring
    _ ≤ exp L*L^(-D) := mul_le_mul_of_nonneg_left
      (rpow_le_rpow_of_exponent_le hL (neg_le_neg (le_max_left _ _))) (exp_pos _).le

end Bounty
end

section

open MeasureTheory

namespace Bounty

theorem exists_local_log_mellin_energy_constant {j : ℕ} (hj : 2 ≤ j) :
    ∃ C : ℝ, 0 < C ∧ ∀ (S : Finset ℕ) (a : ℕ → ℂ), (∀ n ∈ S, 0 < n) →
      ∀ h Y : ℝ, 0 < h → 0 < Y →
      (∫ v in Set.Icc (Y/2) (3*Y), ‖localLogConvolution S a (h*Y) v‖^2) ≤
        3*Y*h^2*C * ∫ t : ℝ, (1+|h*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2 := by
  obtain ⟨C, hC, hop⟩ := exists_local_mellin_transform_energy_constant hj
  refine ⟨C, hC, ?_⟩
  intro S a hS h Y hh hY
  let g := centeredLocalMellinPolynomial S a Y
  have hg : Continuous g := centered_local_mellin_polynomial_continuous S a Y
  have hgM : ∃ M : ℝ, ∀ t, ‖g t‖ ≤ M := by
    refine ⟨∑ n ∈ S, ‖a n‖, ?_⟩
    intro t
    rw [centered_local_mellin_polynomial_norm]
    exact local_mellin_polynomial_norm_le S a t
  obtain ⟨hloc, hbound⟩ := hop h hh g hg hgM
  have heI : (fun u : ℝ => ‖localMellinTransform h g u‖^2) =ᵐ[
      volume.restrict (Set.Icc (Real.log (1/2:ℝ)) (Real.log 3))]
      (fun u : ℝ => ‖(typeIISmoothRho 2 u : ℂ)*localMellinTransform h g u‖^2) := by
    filter_upwards [ae_restrict_mem measurableSet_Icc] with u hu
    rw [local_mellin_rho_one_on_log_dyad hu, Complex.ofReal_one, one_mul]
  have hTi : IntegrableOn (fun u : ℝ => ‖localMellinTransform h g u‖^2)
      (Set.Icc (Real.log (1/2:ℝ)) (Real.log 3)) := hloc.integrableOn.congr heI.symm
  rw [logarithmic_dyad_integral_substitution hY]
  have hscale : (h/(2*Real.pi))^2 ≤ h^2 := by
    apply pow_le_pow_left₀ (by positivity)
    apply div_le_self hh.le
    linarith [Real.two_le_pi]
  calc
    _ ≤ ∫ u in Set.Icc (Real.log (1/2:ℝ)) (Real.log 3),
        (3*Y*h^2) * ‖localMellinTransform h g u‖^2 := by
      apply integral_mono_of_nonneg
      · filter_upwards [] with u
        exact mul_nonneg (mul_nonneg hY.le (Real.exp_pos u).le) (sq_nonneg _)
      · exact hTi.const_mul _
      · filter_upwards [ae_restrict_mem measurableSet_Icc] with u hu
        rw [local_log_convolution_mellin_coordinates S a hS hh hY u,
          norm_mul, Complex.norm_real, Real.norm_of_nonneg (by positivity), mul_pow]
        have hu3 : Real.exp u ≤ 3 := by
          simpa only [Real.exp_log (by norm_num : (0:ℝ)<3)] using Real.exp_le_exp.mpr hu.2
        have hc : Y*Real.exp u*(h/(2*Real.pi))^2 ≤ 3*Y*h^2 := by
          calc
            _ ≤ Y*3*h^2 := mul_le_mul
              (mul_le_mul_of_nonneg_left hu3 hY.le) hscale (sq_nonneg _)
              (mul_nonneg hY.le (by norm_num))
            _ = _ := by ring
        simpa only [mul_assoc] using mul_le_mul_of_nonneg_right hc
          (sq_nonneg ‖localMellinTransform h g u‖)
    _ = (3*Y*h^2) * ∫ u in Set.Icc (Real.log (1/2:ℝ)) (Real.log 3),
        ‖localMellinTransform h g u‖^2 := integral_const_mul _ _
    _ ≤ (3*Y*h^2) * (C * ∫ t : ℝ, (1+|h*t|)^(-(j:ℝ))*‖g t‖^2) :=
      mul_le_mul_of_nonneg_left hbound (by positivity)
    _ = _ := by
      simp only [g, centered_local_mellin_polynomial_norm]
      ring

end Bounty
end

section

/- The original event updates only its common birth slots; initial prime labels are seeded once at the boundary. -/

open Classical
namespace Bounty
section History
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ) (steps : List (Option (J ⊕ K)))

noncomputable def fullMixedCommonAddressWrite (u : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (steps.get u) s)
    (history : FullMixedCommonBirthAddress M B steps → Option (Sigma P)) :
    FullMixedCommonBirthAddress M B steps → Option (Sigma P)
  | .inl a => history (.inl a)
  | .inr a => if h : a.1 = u then
      fullMixedCommonEventBirthLabel n S B A Δ D (steps.get u) s e
        (cast (congrArg (fun v : Fin steps.length => FullMixedCommonLocalAddress M B (steps.get v)) h) a.2)
    else history (.inr a)

noncomputable def fullMixedCommonHistoryWrite (u : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (steps.get u) s)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P))
    (i : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps))) : Option (Sigma P) :=
  fullMixedCommonAddressWrite n S B A Δ D steps u s e
    (fun a => history ((fullMixedCommonBirthOrder M B steps).symm a)) (fullMixedCommonBirthOrder M B steps i)

noncomputable def fullMixedCommonHistorySeed
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P))
    (i : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps))) : Option (Sigma P) :=
  match fullMixedCommonBirthOrder M B steps i with
  | .inl a => some (fullMixedCommonInitialPrime s a)
  | .inr _ => history i

theorem full_mixed_common_history_write_here (u : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (steps.get u) s)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P))
    (a : FullMixedCommonLocalAddress M B (steps.get u)) :
    fullMixedCommonHistoryWrite n S B A Δ D steps u s e history
      ((fullMixedCommonBirthOrder M B steps).symm (.inr ⟨u, a⟩)) =
      fullMixedCommonEventBirthLabel n S B A Δ D (steps.get u) s e a := by
  unfold fullMixedCommonHistoryWrite
  rw [Equiv.apply_symm_apply]
  simp [fullMixedCommonAddressWrite]

theorem full_mixed_common_history_write_other (u : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (steps.get u) s)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P))
    (i : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)))
    (hi : fullMixedCommonOwner M B steps (fullMixedCommonBirthOrder M B steps i) ≠ some u) :
    fullMixedCommonHistoryWrite n S B A Δ D steps u s e history i = history i := by
  obtain ⟨a, rfl⟩ := (fullMixedCommonBirthOrder M B steps).symm.surjective i
  cases a with
  | inl a => simp [fullMixedCommonHistoryWrite, fullMixedCommonAddressWrite]
  | inr a =>
    have hv : a.1 ≠ u := by
      simpa only [Equiv.apply_symm_apply, fullMixedCommonOwner, ne_eq, Option.some.injEq] using hi
    simp [fullMixedCommonHistoryWrite, fullMixedCommonAddressWrite, hv]

end History
end Bounty
end

section

/- Natural-index logarithmic sums and the first-derivative frequency range. -/

open Finset

namespace Bounty

theorem nat_logarithmic_first_derivative (a b : ℕ) (U t : ℝ)
    (hU : 1 ≤ U) (ha : U ≤ (a : ℝ)) (hab : a ≤ b) (hb : (b : ℝ) ≤ 2*U)
    (ht : t ≠ 0) (htmax : |t| ≤ U) :
    ‖∑ n ∈ Icc a b, Complex.exp ((t*Real.log (n : ℝ) : ℝ)*Complex.I)‖ ≤
      12*Real.pi*U/|t| := by
  have hcast : ∀ n : ℤ, ((n : ℤ) : ℝ) = (n : ℝ) := fun _ => rfl
  have he := nat_sum_eq_integer_interval_sum
    (fun n : ℤ => Complex.exp ((t*Real.log (n : ℝ) : ℝ)*Complex.I)) a b
  simp only [Int.cast_natCast] at he
  rw [he]
  have ha' : 0 < ((a : ℤ) : ℝ) := by exact_mod_cast (by linarith : 0 < (a : ℝ))
  have hav : ((a : ℤ) : ℝ) ≤ 3*U := by
    simp only [Int.cast_natCast]
    have : (a : ℝ) ≤ (b : ℝ) := by exact_mod_cast hab
    linarith
  have hbV : ((b : ℤ) : ℝ)+1 ≤ 3*U := by simp only [Int.cast_natCast]; linarith
  have htpi : |t| ≤ Real.pi*((a : ℤ) : ℝ) := by
    simp only [Int.cast_natCast]
    have hp := Real.pi_gt_three
    nlinarith
  have hh := logarithmic_first_derivative_signed (a : ℤ) (b : ℤ) (3*U) t ha' hav hbV ht htpi
  convert hh using 1 <;> ring

end Bounty
end

section

/- The exceptional-interval subpower bound is uniform over coefficients
bounded by any fixed real constant, with the large-scale threshold allowed
to depend on that constant. -/

open Filter
open scoped Topology

namespace Bounty

theorem eventually_prime_exceptional_bounded_coefficients_subpower
    {a beta c A B d ε : ℝ}
    (ha : 0 < a) (ha1 : a ≤ 1) (hbeta : beta < 1) (hc : 0 ≤ c) (hA : 0 ≤ A)
    (hB : 1 ≤ B) (hd : 0 < d) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ (s : Finset ℕ), (∀ p ∈ s, Nat.Prime p) →
      ∀ (coeff : s → ℂ) (Y P R : ℝ),
      1 ≤ Y → d * L ≤ Real.log Y → Real.log Y ≤ c * L →
      Real.exp (L ^ a) / 2 ≤ P → P ≤ Real.exp (L ^ beta) →
      0 ≤ R → R ≤ Y →
      (∀ p ∈ s, P ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2 * P) →
      (∀ p : s, ‖coeff p‖ ≤ B) →
      ((primeExceptionalIntervals s coeff (L ^ (-A)) R).card : ℝ) ≤ Y ^ ε := by
  have hA' : 0 ≤ A + 1 := by linarith
  have hB0 : 0 < B := zero_lt_one.trans_le hB
  filter_upwards [eventually_prime_exceptional_intervals_subpower ha ha1 hbeta hc hA' hd hε,
    eventually_ge_atTop B] with L hsub hBL
  intro s hs coeff Y P R hY hloglo hloghi hPlo hPhi hR hRY hband hcoeff
  have hcard := Finset.card_le_card
    (prime_exceptional_intervals_normalize_subset s coeff A R hB0 hBL)
  have hcardR : ((primeExceptionalIntervals s coeff (L ^ (-A)) R).card : ℝ) ≤
      ((primeExceptionalIntervals s (fun p => coeff p / (B : ℂ))
        (L ^ (-(A + 1))) R).card : ℝ) := by exact_mod_cast hcard
  exact hcardR.trans (hsub s hs (fun p => coeff p / (B : ℂ)) Y P R
    hY hloglo hloghi hPlo hPhi hR hRY hband
    (prime_normalized_coefficient_norm_le_one s coeff hB0 hcoeff))

end Bounty
end

section

/- Uniform terminal power saving for the actual iterated logarithmic exponential phase. -/

open Finset

namespace Bounty

theorem exists_mixed_terminal_power_saving (k : ℕ) (C : ℝ) (hk : 2 ≤ k) (hC : 1 ≤ C) :
    ∃ B : ℝ, 0 < B ∧ ∀ (N eps : ℝ) (hs : List ℝ) (q a u : ℝ) (l r : ℤ),
      1 ≤ N → 0 ≤ eps → hs.length = k-2 →
      (∀ h ∈ hs, 1 ≤ h ∧ h ≤ (⌊N^(eps/(2*(k : ℝ)))⌋₊ : ℝ)) →
      N^((k : ℝ)-2+eps) ≤ |u| → |u| ≤ N^((k : ℝ)-eps) →
      0 < q → l ≤ r →
      (∀ x ∈ Set.Icc (l : ℝ) ((r : ℝ)+1),
        N ≤ x+a/q ∧ x+a/q+hs.sum ≤ C*N) →
      ‖∑ n ∈ Icc l r, Complex.exp
        ((mixedForwardDifference hs (fun y => u*Real.log (q*y+a)) (n : ℝ) : ℂ)*Complex.I)‖ ≤
        B*N*N^(-eps/4) := by
  let K := ((k-1).factorial : ℝ)/(2*Real.pi*C^k)
  have hC0 : 0 < C := by linarith
  have hK : 0 < K := by dsimp [K]; positivity
  refine ⟨6*(C^k*C*Real.sqrt K+2/Real.sqrt K),by positivity,?_⟩
  intro N eps hs q a u l r hN heps hlen hhs hu0 hu1 hq hlr hbox
  have hN0 : 0 < N := by linarith
  have hu : u ≠ 0 := abs_pos.mp ((Real.rpow_pos_of_pos hN0 _).trans_le hu0)
  have hhspos : ∀ h ∈ hs, 0 < h := fun h hh => lt_of_lt_of_le (by norm_num) (hhs h hh).1
  have hhs0 : ∀ h ∈ hs, 0 ≤ h := fun h hh => (hhspos h hh).le
  have hdepth : hs.length+2 = k := by omega
  have hfac : hs.length+1 = k-1 := by omega
  have hNC : N ≤ C*N := by simpa only [one_mul] using mul_le_mul_of_nonneg_right hC hN0.le
  have h := integer_mixed_logarithmic_exp_sum_bound hs q a u N (C*N) l r
    hq hu hlr hhspos hN0 hNC hbox
  dsimp only at h
  rw [hdepth,hfac] at h
  have hratio : C*N/N = C := by field_simp
  rw [hratio] at h
  have hlam : hs.prod*|u/(2*Real.pi)| *((k-1).factorial : ℝ)/(C*N)^k =
      K*hs.prod*|u|/N^k := by
    dsimp [K]
    rw [abs_div,abs_of_pos (show 0 < 2*Real.pi by positivity),mul_pow]
    field_simp
  rw [hlam] at h
  obtain ⟨hp0,hp1⟩ := terminal_shift_product_bounds hs hN heps hk hlen hhs
  obtain ⟨hcurv0,hcurv1⟩ := scaled_curvature_power_bounds hN hK.le hp0 hp1 hu0 hu1
  have hlrR : (l : ℝ) ≤ r := by exact_mod_cast hlr
  have hleft := (hbox l ⟨le_rfl,by linarith⟩).1
  have hright := (hbox ((r : ℝ)+1) ⟨by linarith,le_rfl⟩).2
  have hsum : 0 ≤ hs.sum := List.sum_nonneg hhs0
  have hlength : (r : ℝ)-l+1 ≤ C*N := by linarith
  have hM : 0 ≤ (r : ℝ)-l+1 := by linarith
  exact h.trans (curvature_test_power_saving hN heps hK hK.le
    (pow_nonneg hC0.le _) hC0.le hM hlength hcurv0 hcurv1)

end Bounty
end

section

/- Arbitrary finite factor coefficients are restricted to their actual boxes automatically. -/

open Finset

namespace Bounty

theorem finite_support_weighted_sum (S : Finset ℕ) (a F : ℕ → ℂ) :
    (∑ n ∈ S, (if n ∈ S then a n else 0)*F n) = ∑ n ∈ S, a n*F n := by
  apply sum_congr rfl
  intro n hn
  rw [if_pos hn]

theorem finite_pair_polynomial_five_dyads (A B : Finset ℕ) (α β : ℕ → ℂ)
    {UA UB : ℝ} (hUA : 0 < UA) (hUB : 0 < UB)
    (hA : ∀ a ∈ A, UA ≤ (a : ℝ) ∧ (a : ℝ) ≤ 2*UA)
    (hB : ∀ b ∈ B, UB ≤ (b : ℝ) ∧ (b : ℝ) ≤ 2*UB) (t : ℝ) :
    let V := UA*UB
    let S := Icc 1 ⌊16*V⌋₊
    let U := V/2
    (∑ a ∈ A, α a*harmonicMellinWeight t a)*(∑ b ∈ B, β b*harmonicMellinWeight t b) =
      ∑ j : Fin 5, ∑ n ∈ Icc (⌊(2 : ℝ)^j.val*U⌋₊+1) ⌊(2 : ℝ)^(j.val+1)*U⌋₊,
        (if n ∈ S then (∑ d ∈ n.divisors,
          (if d ∈ A then α d else 0)*(if n/d ∈ B then β (n/d) else 0))/(n : ℂ) else 0)*
          Complex.exp (((Real.log (n : ℝ)*t : ℝ) : ℂ)*Complex.I) := by
  classical
  dsimp only
  have hApos : ∀ a ∈ A, 0 < a := fun a ha => Nat.cast_pos.mp (hUA.trans_le (hA a ha).1)
  have hBpos : ∀ b ∈ B, 0 < b := fun b hb => Nat.cast_pos.mp (hUB.trans_le (hB b hb).1)
  have hprod : ∀ a ∈ A, ∀ b ∈ B, UA*UB ≤ (a*b : ℕ) ∧ (a*b : ℕ) ≤ 16*(UA*UB) := by
    intro a ha b hb
    simpa only [one_mul,Nat.one_mul] using four_dyadic_factor_product_bounds
      (UD := 1) (UA := 1) (UB := UA) (UC := UB) (d := 1) (a := 1) (b := a) (c := b)
      (by norm_num) (by norm_num) hUA hUB (by norm_num) (by norm_num) (hA a ha) (hB b hb)
  have hs : ∀ a ∈ A, ∀ b ∈ B, a*b ∈ Icc 1 ⌊16*(UA*UB)⌋₊ := by
    intro a ha b hb
    exact mem_Icc.mpr ⟨Nat.mul_pos (hApos a ha) (hBpos b hb),Nat.le_floor (hprod a ha b hb).2⟩
  have hsize : ∀ a ∈ A, ∀ b ∈ B,
      UA*UB/2 < (a*b : ℕ) ∧ (a*b : ℕ) ≤ (2 : ℝ)^5*(UA*UB/2) := by
    intro a ha b hb
    have hp := hprod a ha b hb
    have hV : 0 < UA*UB := mul_pos hUA hUB
    constructor
    · linarith
    · norm_num at hp ⊢
      linarith
  have hr := divisor_pair_dyadic_representation (Icc 1 ⌊16*(UA*UB)⌋₊) A B
    (fun n => if n ∈ A then α n else 0) (fun n => if n ∈ B then β n else 0)
    hApos hBpos (by intro n hn; exact if_neg hn) (by intro n hn; exact if_neg hn)
    hs (UA*UB/2) (by positivity) 5 hsize t
  simpa only [finite_support_weighted_sum] using hr

theorem finite_triple_polynomial_five_dyads (A B C : Finset ℕ) (α β γ : ℕ → ℂ)
    {UA UB UC : ℝ} (hUA : 0 < UA) (hUB : 0 < UB) (hUC : 0 < UC)
    (hA : ∀ a ∈ A, UA ≤ (a : ℝ) ∧ (a : ℝ) ≤ 2*UA)
    (hB : ∀ b ∈ B, UB ≤ (b : ℝ) ∧ (b : ℝ) ≤ 2*UB)
    (hC : ∀ c ∈ C, UC ≤ (c : ℝ) ∧ (c : ℝ) ≤ 2*UC) (t : ℝ) :
    let V := UA*UB*UC
    let S := Icc 1 ⌊16*V⌋₊
    let U := V/2
    (∑ a ∈ A, α a*harmonicMellinWeight t a)*(∑ b ∈ B, β b*harmonicMellinWeight t b)*
      (∑ c ∈ C, γ c*harmonicMellinWeight t c) =
      ∑ j : Fin 5, ∑ n ∈ Icc (⌊(2 : ℝ)^j.val*U⌋₊+1) ⌊(2 : ℝ)^(j.val+1)*U⌋₊,
        (if n ∈ S then endpointTripleConvolution
          (fun n => if n ∈ A then α n else 0) (fun n => if n ∈ B then β n else 0)
          (fun n => if n ∈ C then γ n else 0) n/(n : ℂ) else 0)*
          Complex.exp (((Real.log (n : ℝ)*t : ℝ) : ℂ)*Complex.I) := by
  classical
  dsimp only
  have hApos : ∀ a ∈ A, 0 < a := fun a ha => Nat.cast_pos.mp (hUA.trans_le (hA a ha).1)
  have hBpos : ∀ b ∈ B, 0 < b := fun b hb => Nat.cast_pos.mp (hUB.trans_le (hB b hb).1)
  have hCpos : ∀ c ∈ C, 0 < c := fun c hc => Nat.cast_pos.mp (hUC.trans_le (hC c hc).1)
  have hprod : ∀ a ∈ A, ∀ b ∈ B, ∀ c ∈ C,
      UA*UB*UC ≤ (a*b*c : ℕ) ∧ (a*b*c : ℕ) ≤ 16*(UA*UB*UC) := by
    intro a ha b hb c hc
    simpa only [one_mul,Nat.one_mul] using four_dyadic_factor_product_bounds
      (UD := 1) (UA := UA) (UB := UB) (UC := UC) (d := 1) (a := a) (b := b) (c := c)
      (by norm_num) hUA hUB hUC (by norm_num) (hA a ha) (hB b hb) (hC c hc)
  have hs : ∀ a ∈ A, ∀ b ∈ B, ∀ c ∈ C, a*b*c ∈ Icc 1 ⌊16*(UA*UB*UC)⌋₊ := by
    intro a ha b hb c hc
    exact mem_Icc.mpr ⟨Nat.mul_pos (Nat.mul_pos (hApos a ha) (hBpos b hb)) (hCpos c hc),
      Nat.le_floor (hprod a ha b hb c hc).2⟩
  have hsize : ∀ a ∈ A, ∀ b ∈ B, ∀ c ∈ C,
      UA*UB*UC/2 < (a*b*c : ℕ) ∧ (a*b*c : ℕ) ≤ (2 : ℝ)^5*(UA*UB*UC/2) := by
    intro a ha b hb c hc
    have hp := hprod a ha b hb c hc
    have hV : 0 < UA*UB*UC := by positivity
    constructor
    · linarith
    · norm_num at hp ⊢
      linarith
  have hr := endpoint_triple_dyadic_representation (Icc 1 ⌊16*(UA*UB*UC)⌋₊) A B C
    (fun n => if n ∈ A then α n else 0) (fun n => if n ∈ B then β n else 0)
    (fun n => if n ∈ C then γ n else 0) hApos hBpos hCpos
    (by intro n hn; exact if_neg hn) (by intro n hn; exact if_neg hn) (by intro n hn; exact if_neg hn)
    hs (UA*UB*UC/2) (by positivity) 5 hsize t
  simpa only [finite_support_weighted_sum] using hr

end Bounty
end

section

/- Unit coefficients embed the actual shorter divisor convolutions in the fourfold estimate. -/

open Finset Filter

namespace Bounty

theorem divisor_unit_convolution (f : ℕ → ℂ) {n : ℕ} (hn : n ≠ 0) :
    (∑ d ∈ n.divisors, (if d = 1 then (1 : ℂ) else 0)*f (n/d)) = f n := by
  classical
  rw [sum_eq_single 1]
  · simp only [ite_true, Nat.div_one, one_mul]
  · intro b _ hb
    rw [if_neg hb,zero_mul]
  · intro hnot
    exact False.elim (hnot (Nat.mem_divisors.mpr ⟨one_dvd n,hn⟩))

theorem endpoint_four_unit_left (α β γ : ℕ → ℂ) {n : ℕ} (hn : n ≠ 0) :
    endpointFourConvolution (fun d => if d = 1 then 1 else 0) α β γ n =
      endpointTripleConvolution α β γ n := by
  exact divisor_unit_convolution _ hn

theorem endpoint_triple_unit_left (β γ : ℕ → ℂ) {n : ℕ} (hn : n ≠ 0) :
    endpointTripleConvolution (fun d => if d = 1 then 1 else 0) β γ n =
      ∑ d ∈ n.divisors, β d*γ (n/d) := by
  classical
  unfold endpointTripleConvolution
  rw [sum_eq_single 1]
  · simp only [ite_true, Nat.div_one, one_mul]
  · intro b _ hb
    simp only [if_neg hb,zero_mul,sum_const_zero]
  · intro hnot
    exact False.elim (hnot (Nat.mem_divisors.mpr ⟨one_dvd n,hn⟩))

end Bounty
end

section

/- Exact local decoding of common forest factors on the original path.
The path occurrence and full-slot chronological enumeration are unchanged. -/

open Finset Classical
namespace Bounty

section Decode
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (steps : List (Option (J ⊕ K)))
  (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))
  (θ : (Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) ×
    Fin (Fintype.card (FullMixedCommonBirthAddress M B steps))) → ℝ)
  (encode : ((g : Fin N) × P g) → ℤ)

noncomputable def commonForestEdgeOperationObservation
    (i : Fin steps.length) (k : K) (hi : steps.get i = some (.inr k))
    (draw : ∀ g, EdgeDrawObservation (P g) (S k g)ᶜ.card) : ℂ :=
  commonForestObservedMultiplier M B steps code θ encode
    (commonForestEventLabels M B steps i
      (fun a => commonForestEdgeLabels S B k draw (hi ▸ a))) (some i)

theorem common_forest_edge_operation_observation_norm_le_one
    (i : Fin steps.length) (k : K) (hi : steps.get i = some (.inr k))
    (draw : ∀ g, EdgeDrawObservation (P g) (S k g)ᶜ.card) :
    ‖commonForestEdgeOperationObservation S B steps code θ encode i k hi draw‖ ≤ 1 :=
  common_forest_observed_multiplier_norm_le_one _ _ _ _ _ _ _ _

noncomputable def commonForestGhostOperationObservation
    (i : Fin steps.length) (j : J) (hi : steps.get i = some (.inl j))
    (born : ∀ g, Σ b : Fin (B + 1), Fin b.val → P g) : ℂ :=
  commonForestObservedMultiplier M B steps code θ encode
    (commonForestEventLabels M B steps i
      (fun a => commonForestGhostLabels B j born (hi ▸ a))) (some i)

variable (n : (g : Fin N) → P g → ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ)

theorem full_mixed_common_event_label_cast
    {tag tag' : Option (J ⊕ K)} (h : tag = tag')
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag s)
    (a : FullMixedCommonLocalAddress M B tag) :
    fullMixedCommonEventBirthLabel n S B A Δ D tag s e a =
      fullMixedCommonEventBirthLabel n S B A Δ D tag' s
        (cast (congrArg (fun t => FullPermutationMixedEvent n S B A Δ D t s) h) e) (h ▸ a) := by
  subst tag'
  rfl

theorem full_mixed_common_path_edge_decode
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x)
    (i : Fin steps.length) (k : K) (hi : steps.get i = some (.inr k)) :
    let o := finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x p i
    let e : FullPermutationMixedEvent n S B A Δ D (some (.inr k)) o.1 :=
      cast (congrArg (fun t => FullPermutationMixedEvent n S B A Δ D t o.1) hi) o.2
    fullMixedCommonOperationMultiplier n S B A Δ D steps code θ encode x p (some i) =
      commonForestEdgeOperationObservation S B steps code θ encode i k hi
        (fun g => ⟨(e.2 g).1, (e.2 g).2.1, (e.2 g).2.2.2⟩) := by
  dsimp only
  rw [full_mixed_common_operation_multiplier_event]
  unfold commonForestEdgeOperationObservation
  apply congrArg (fun label => commonForestObservedMultiplier M B steps code θ encode label (some i))
  apply congrArg (commonForestEventLabels M B steps i)
  funext a
  rw [full_mixed_common_event_label_cast S B n A Δ D hi]
  exact congrArg (fun label => label (hi ▸ a))
    (full_mixed_common_edge_labels_eq_observation S B k n A Δ D _ _)

theorem full_mixed_common_path_ghost_decode
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x)
    (i : Fin steps.length) (j : J) (hi : steps.get i = some (.inl j)) :
    let o := finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x p i
    let e : FullPermutationMixedEvent n S B A Δ D (some (.inl j)) o.1 :=
      cast (congrArg (fun t => FullPermutationMixedEvent n S B A Δ D t o.1) hi) o.2
    fullMixedCommonOperationMultiplier n S B A Δ D steps code θ encode x p (some i) =
      commonForestGhostOperationObservation B steps code θ encode i j hi
        (fun g => ⟨(e.down g).1, fun a => ((e.down g).2.2 a).1⟩) := by
  dsimp only
  rw [full_mixed_common_operation_multiplier_event]
  unfold commonForestGhostOperationObservation
  apply congrArg (fun label => commonForestObservedMultiplier M B steps code θ encode label (some i))
  apply congrArg (commonForestEventLabels M B steps i)
  funext a
  rw [full_mixed_common_event_label_cast S B n A Δ D hi]
  exact congrArg (fun label => label (hi ▸ a))
    (full_mixed_common_ghost_labels_eq_observation S B j n A Δ D _ _)

end Decode
end Bounty
end

section

/- Compatible original endpoints use one shared embedding and two independent completions. -/

open Finset
open scoped Classical
namespace Bounty

abbrev PhysicalCompatibleMarkPair {G : Type*} (P : G → Finset ℕ) {J : ℕ}
    (C : G → Finset (Fin J)) (ell : ℕ) :=
  {x : PhysicalMarkLists P J ell × PhysicalMarkLists P J ell // physicalSharedCompatible C x.1 x.2}

abbrev PhysicalJointCutData {G : Type*} (P : G → Finset ℕ) {J : ℕ}
    (C : G → Finset (Fin J)) (ell : ℕ) :=
  Σ s : PhysicalCutSharedEmbedding P C, PhysicalCutCompletion P C ell s × PhysicalCutCompletion P C ell s

noncomputable def physicalCutPairEquiv {G : Type*} (P : G → Finset ℕ) {J : ℕ}
    (C : G → Finset (Fin J)) (ell : ℕ) :
    PhysicalCompatibleMarkPair P C ell ≃ PhysicalJointCutData P C ell :=
  (Equiv.subtypeEquiv
    (Equiv.prodCongr (physicalCutListSigmaEquiv P C ell) (physicalCutListSigmaEquiv P C ell))
    (fun x => physical_cut_shared_compatible_iff C x.1 x.2)).trans sigmaSameBasePairEquiv

theorem physical_cut_pair_inverse_left {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (d : PhysicalJointCutData P C ell) :
    ((physicalCutPairEquiv P C ell).symm d).val.1 = physicalCutGlue C d.1 d.2.1 := rfl

theorem physical_cut_pair_inverse_right {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (d : PhysicalJointCutData P C ell) :
    ((physicalCutPairEquiv P C ell).symm d).val.2 = physicalCutGlue C d.1 d.2.2 := rfl

theorem physical_cut_pair_inverse_shared_aux {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (d : PhysicalJointCutData P C ell) :
    physicalSharedAux C ((physicalCutPairEquiv P C ell).symm d).val.1 = fun g j => d.1 g j := by
  rw [physical_cut_pair_inverse_left]
  have h := physical_cut_glue_shared C d.1 d.2.1
  exact congrArg (fun s : PhysicalCutSharedEmbedding P C => fun g => (s g : ↥(univ \ C g) → ↥(P g))) h

end Bounty
end

section

/- The stripped vertex is the original variable-length marked-list weight. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_divisor_subtype_card {G : Type*} (P : G → Finset ℕ) (g : G) (n : ℤ) :
    ((univ : Finset (P g)).filter (fun p => (p.val : ℤ) ∣ n)).card = physicalOmega P g n := by
  have he : (((univ : Finset (P g)).filter (fun p => (p.val : ℤ) ∣ n)).image Subtype.val) =
      (P g).filter (fun p : ℕ => (p : ℤ) ∣ n) := by
    ext p
    simp only [mem_image, mem_filter, mem_univ, true_and, Subtype.exists]
    constructor
    · rintro ⟨a, ha, han, rfl⟩
      exact ⟨ha, han⟩
    · rintro ⟨hp, hpn⟩
      exact ⟨p, hp, hpn, rfl⟩
  rw [← card_image_of_injective _ Subtype.val_injective, he]
  rfl

noncomputable def groupMarkedVertexWeight {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (q : ℝ) (t : G → ℕ) (n : ℤ) (L : GroupMarkedLists P t) : ℝ :=
  if ∀ g i, ((L g i).val : ℤ) ∣ n then ∏ g, q ^ (physicalOmega P g n - t g) else 0

theorem physical_unshared_vertex_eq_group_weight {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (q : ℝ) (n : ℤ) :
    physicalUnsharedVertex C L q n =
      groupMarkedVertexWeight P q (fun g => ell + (C g).card) n (physicalGroupUnsharedEmbedding C L) := by
  have he : physicalUnsharedVertex C L q n =
      ∏ g, finiteMarkedVertex (univ.image (physicalGroupUnsharedEmbedding C L g))
        (fun p : P g => (p.val : ℤ) ∣ n) q := by
    unfold physicalUnsharedVertex finiteMarkedVertex
    rw [Fintype.prod_sigma]
    apply prod_congr rfl
    intro g _
    apply prod_congr rfl
    intro p _
    simp only [physical_unshared_tagged_mem]
  rw [he]
  trans ∏ g, if ∀ i, ((physicalGroupUnsharedEmbedding C L g i).val : ℤ) ∣ n
    then q ^ (physicalOmega P g n - (ell + (C g).card)) else 0
  · apply prod_congr rfl
    intro g _
    have hf := finite_marked_embedding_indicator (physicalGroupUnsharedEmbedding C L g)
      (fun p : P g => (p.val : ℤ) ∣ n) q
    simp only [Fintype.card_fin] at hf
    convert hf using 2
    congr 2
    rw [← physical_divisor_subtype_card P g n]
    congr 1
    ext p
    simp only [mem_filter, mem_univ, true_and]
  · unfold groupMarkedVertexWeight
    by_cases h : ∀ g i, ((physicalGroupUnsharedEmbedding C L g i).val : ℤ) ∣ n
    · rw [if_pos h]
      apply prod_congr rfl
      intro g _
      rw [if_pos (h g)]
    · rw [if_neg h]
      push Not at h
      obtain ⟨g, i, hi⟩ := h
      apply prod_eq_zero (mem_univ g)
      exact if_neg (fun hh => hi (hh i))

theorem completion_marked_vertex_sum_eq_average {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {J ell : ℕ} (C : G → Finset (Fin J))
    (q : ℝ) (V : G → ℝ) (n : ℤ)
    (b : GroupMarkedLists P (fun g => ell + (C g).card) → ℂ) :
    (physicalCompletionMass V C ell : ℂ) *
      (∑ L : GroupMarkedLists P (fun g => ell + (C g).card),
        (groupMarkedVertexWeight P q (fun g => ell + (C g).card) n L : ℂ) * b L) =
      (markedDivisorWeight univ P q V (fun g => ell + (C g).card) n : ℂ) *
        groupMarkedAverage P (fun g => ell + (C g).card) n b := by
  have hs : (∑ L : GroupMarkedLists P (fun g => ell + (C g).card),
      (groupMarkedVertexWeight P q (fun g => ell + (C g).card) n L : ℂ) * b L) =
      ((∏ g, q ^ (physicalOmega P g n - (ell + (C g).card)) : ℝ) : ℂ) *
        ∑ L : GroupMarkedLists P (fun g => ell + (C g).card),
          if ∀ g i, ((L g i).val : ℤ) ∣ n then b L else 0 := by
    rw [mul_sum]
    apply sum_congr rfl
    intro L _
    unfold groupMarkedVertexWeight
    split_ifs <;> simp only [Complex.ofReal_zero, zero_mul, mul_zero]
  rw [hs, ← mul_assoc]
  have hm : (physicalCompletionMass V C ell : ℂ) *
      ((∏ g, q ^ (physicalOmega P g n - (ell + (C g).card)) : ℝ) : ℂ) =
      ((∏ g, q ^ (physicalOmega P g n - (ell + (C g).card)) / V g ^ (ell + (C g).card) : ℝ) : ℂ) := by
    rw [← Complex.ofReal_mul]
    congr 1
    unfold physicalCompletionMass
    rw [← prod_mul_distrib]
    apply prod_congr rfl
    intro g _
    ring
  rw [hm, weighted_group_marked_indicator_eq_average]

end Bounty
end

section

/- Indexed rows on the common initial-and-event birth allocation. Initial
birth factors remain outside the event composition; no initial gate is lost. -/

open Finset Classical
namespace Bounty

section Affected
variable {J K Z : Type*} {N : ℕ} (M : Fin N → ℕ) (B : ℕ)
  (steps : List (Option (J ⊕ K)))
  (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))

noncomputable def commonForestAffectedOperations : Finset (Option (Fin steps.length)) :=
  birthForestAffectedOperations code
    (fun j => fullMixedCommonOwner M B steps (fullMixedCommonBirthOrder M B steps j))

theorem common_forest_affected_operations_card_le :
    (commonForestAffectedOperations M B steps code).card ≤ 2 * birthForestRank code :=
  birthForestAffectedOperations_card_le _ _

theorem common_forest_observed_multiplier_eq_one
    (θ : (Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) ×
      Fin (Fintype.card (FullMixedCommonBirthAddress M B steps))) → ℝ)
    (encode : Z → ℤ) (label : FullMixedCommonBirthAddress M B steps → Option Z)
    (o : Option (Fin steps.length)) (ho : o ∉ commonForestAffectedOperations M B steps code) :
    commonForestObservedMultiplier M B steps code θ encode label o = 1 :=
  birthForestOperationMultiplier_eq_one _ _ _ _ _ _ ho

end Affected

section Stage
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ) (steps : List (Option (J ⊕ K)))
  (residual : ∀ (tag : Option (J ⊕ K)) s, FullPermutationMixedEvent n S B A Δ D tag s → ℂ)
  (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))
  (θ : (Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) ×
    Fin (Fintype.card (FullMixedCommonBirthAddress M B steps))) → ℝ)
  (encode : ((g : Fin N) × P g) → ℤ)

noncomputable def fullMixedCommonStagePhase (i : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (steps.get i) s) : ℂ :=
  residual (steps.get i) s e * commonForestObservedMultiplier M B steps code θ encode
    (commonForestEventLabels M B steps i
      (fullMixedCommonEventBirthLabel n S B A Δ D (steps.get i) s e)) (some i)

theorem full_mixed_common_stage_phase_occurrence
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x) (i : Fin steps.length) :
    let e := finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x p i
    fullMixedCommonStagePhase n S B A Δ D steps residual code θ encode i e.1 e.2 =
      residual (steps.get i) e.1 e.2 *
        fullMixedCommonOperationMultiplier n S B A Δ D steps code θ encode x p (some i) := by
  dsimp only
  rw [full_mixed_common_operation_multiplier_event]
  rfl

theorem full_mixed_common_stage_phase_untouched
    (i : Fin steps.length) (hi : some i ∉ commonForestAffectedOperations M B steps code)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (steps.get i) s) :
    fullMixedCommonStagePhase n S B A Δ D steps residual code θ encode i s e =
      residual (steps.get i) s e := by
  unfold fullMixedCommonStagePhase
  rw [common_forest_observed_multiplier_eq_one M B steps code θ encode _ (some i) hi, mul_one]

theorem full_mixed_common_stage_phase_product
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x) :
    (∏ i : Fin steps.length, fullMixedCommonStagePhase n S B A Δ D steps residual code θ encode i
      (finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
        (fullPermutationMixedEventTarget n S B A Δ D) steps x p i).1
      (finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
        (fullPermutationMixedEventTarget n S B A Δ D) steps x p i).2) =
      finiteEventLocalPhase (FullPermutationMixedEvent n S B A Δ D)
        (fullPermutationMixedEventTarget n S B A Δ D) residual steps x p *
      ∏ i : Fin steps.length,
        fullMixedCommonOperationMultiplier n S B A Δ D steps code θ encode x p (some i) := by
  simp_rw [full_mixed_common_stage_phase_occurrence]
  rw [prod_mul_distrib, ← finite_event_local_phase_occurrences]

variable [∀ g, Fintype (P g)] [∀ g p, NeZero (n g p)] [∀ k c, Fintype (A k c)]

noncomputable def fullMixedCommonStageRow
    (ω : ∀ k c, A k c → ℝ) (μ : (g : Fin N) → P g → ℝ)
    (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ) (i : Fin steps.length)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) : ℂ :=
  let _ : ∀ (tag : Option (J ⊕ K)) y, Fintype (FullPermutationMixedEvent n S B A Δ D tag y) :=
    fullPermutationMixedEventFintype n S B A Δ D
  finiteOccurrencePhasedRow (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D)
    (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V) steps
    (fullMixedCommonStagePhase n S B A Δ D steps residual code θ encode) i f s

end Stage
end Bounty
end

section

/- Exact unrestricted-mark formula for each original root contribution. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_fixed_root_fibers
    {G : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (C : G → Finset (Fin J)) (q ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (positions : Finset ℤ)
    (f g : ℤ → ℂ) (Ψ : ℝ → ℂ) (Z : ℝ) :
    physicalFixedRootCorrelation V C q ζ k K aux positions f g Ψ Z =
      (physicalStateMass V J ell : ℂ) *
      ∑ n ∈ positions, ∑ L : PhysicalMarksAt P J ell n,
        if n + k * (physicalD C L.val aux : ℕ) ∈ positions then
          ∑ R : PhysicalMarksAt P J ell (n + k * (physicalD C L.val aux : ℕ)),
            physicalRootPositionTerm V C q ζ k K aux f g Ψ Z L.val R.val n
        else 0 := by
  unfold physicalFixedRootCorrelation
  rw [physical_cutoff_sum]
  congr 1
  apply sum_congr rfl
  intro n _
  apply sum_congr rfl
  intro L _
  rw [← physical_cutoff_sum_at P J ell positions
    (n + k * (physicalD C L.val aux : ℕ))
    (fun R => physicalRootPositionTerm V C q ζ k K aux f g Ψ Z L.val R n)]
  apply sum_congr rfl
  intro y _
  split_ifs with h
  · simp only [physicalRootPositionTerm, h]
  · rfl

theorem physical_fixed_root_all_lists
    {G : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (C : G → Finset (Fin J)) (q ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (positions : Finset ℤ)
    (f g : ℤ → ℂ) (Ψ : ℝ → ℂ) (Z : ℝ) :
    physicalFixedRootCorrelation V C q ζ k K aux positions f g Ψ Z =
      (physicalStateMass V J ell : ℂ) *
      ∑ L : PhysicalMarkLists P J ell, ∑ R : PhysicalMarkLists P J ell,
        ∑ n ∈ positions, if n + k * (physicalD C L aux : ℕ) ∈ positions then
          physicalRootPositionTerm V C q ζ k K aux f g Ψ Z L R n else 0 := by
  rw [physical_fixed_root_fibers]
  congr 1
  have hf (n : ℤ) :
      (∑ L : PhysicalMarksAt P J ell n,
        if n + k * (physicalD C L.val aux : ℕ) ∈ positions then
          ∑ R : PhysicalMarksAt P J ell (n + k * (physicalD C L.val aux : ℕ)),
            physicalRootPositionTerm V C q ζ k K aux f g Ψ Z L.val R.val n else 0) =
      ∑ L : PhysicalMarkLists P J ell, ∑ R : PhysicalMarkLists P J ell,
        if n + k * (physicalD C L aux : ℕ) ∈ positions then
          physicalRootPositionTerm V C q ζ k K aux f g Ψ Z L R n else 0 := by
    trans ∑ L : PhysicalMarksAt P J ell n, ∑ R : PhysicalMarkLists P J ell,
      if n + k * (physicalD C L.val aux : ℕ) ∈ positions then
        physicalRootPositionTerm V C q ζ k K aux f g Ψ Z L.val R n else 0
    · apply sum_congr rfl
      intro L _
      split_ifs with ht
      · rw [← physical_marks_sum_all P J ell _
          (fun R => physicalRootPositionTerm V C q ζ k K aux f g Ψ Z L.val R n)]
        intro R hR
        simp only [physicalRootPositionTerm, physicalVertexWeight, if_neg hR, mul_zero,
          Complex.ofReal_zero]
      · simp only [sum_const_zero]
    · apply physical_marks_sum_all P J ell n (fun L =>
        ∑ R : PhysicalMarkLists P J ell,
          if n + k * (physicalD C L aux : ℕ) ∈ positions then
            physicalRootPositionTerm V C q ζ k K aux f g Ψ Z L R n else 0)
      intro L hL
      apply sum_eq_zero
      intro R _
      split_ifs
      · simp only [physicalRootPositionTerm, physicalVertexWeight, if_neg hL, zero_mul,
          Complex.ofReal_zero, mul_zero]
      · rfl
  simp only [hf]
  rw [sum_comm]
  apply sum_congr rfl
  intro L _
  rw [sum_comm]

end Bounty
end

section

/- Exact reciprocal, phase, and auxiliary factors in a shared-scaled root term. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def physicalPhasedPairCoefficient
    {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J))
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (a b : ℝ) (w z : ℕ)
    (L R : PhysicalMarkLists P J ell) : ℂ :=
  if physicalListAdmissible C aux L R then
    K L R aux * physicalPhase a (physicalSharedFactor C L * w) *
      physicalPhase b (physicalSharedFactor C L * z) *
      physicalPhase (-(a+b)) (physicalD C L aux)
  else 0

theorem physical_phased_root_term_scaled
    {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (V : G → ℝ) (C : G → Finset (Fin J)) (q a b : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (f g : ℤ → ℂ) (Ψ : ℝ → ℂ) (Z : ℝ)
    (L R : PhysicalMarkLists P J ell) (w : ℤ)
    (hf : f ((physicalSharedFactor C L : ℤ) * w) = f w)
    (hg : g ((physicalSharedFactor C L : ℤ) *
      (w + k * (physicalFreeFactor C aux : ℕ))) =
      g (w + k * (physicalFreeFactor C aux : ℕ))) :
    physicalRootPositionTerm V C q (-(a+b)) k K aux
      (fun n => physicalPhase (-a) n.natAbs * f n)
      (fun n => physicalPhase b n.natAbs * g n) Ψ Z L R
      ((physicalSharedFactor C L : ℤ) * w) =
    ((physicalAuxMass V C aux * physicalCompletionMass V C ell /
      (physicalSharedFactor C L : ℝ) : ℝ) : ℂ) *
    (Ψ ((w : ℝ) / (Z * physicalFreeFactor C aux)) * (w : ℂ)⁻¹ *
      (starRingEnd ℂ) (f w) * g (w + k * (physicalFreeFactor C aux : ℕ))) *
    ((physicalVertexWeight L q ((physicalSharedFactor C L : ℤ) * (w.natAbs : ℤ)) *
      physicalVertexWeight R q ((physicalSharedFactor C L : ℤ) *
        ((w + k * (physicalFreeFactor C aux : ℕ)).natAbs : ℤ)) : ℝ) : ℂ) *
    physicalPhasedPairCoefficient C K aux a b w.natAbs
      (w + k * (physicalFreeFactor C aux : ℕ)).natAbs L R := by
  have hs : (physicalSharedFactor C L : ℤ) ≠ 0 := by
    exact_mod_cast (physical_shared_factor_pos C L hprime).ne'
  have he : (physicalSharedFactor C L : ℤ) * w + k * (physicalD C L aux : ℕ) =
      (physicalSharedFactor C L : ℤ) * (w + k * (physicalFreeFactor C aux : ℕ)) := by
    rw [physical_D_shared_free, Nat.cast_mul]
    ring
  have harg := physical_shared_scaled_position C L aux hprime
    ((physicalSharedFactor C L : ℤ) * w) Z (dvd_mul_right _ _)
  rw [Int.mul_ediv_cancel_left w hs] at harg
  unfold physicalRootPositionTerm
  dsimp only
  rw [he, hf, hg, harg]
  rw [physical_vertex_weight_scaled_natAbs, physical_vertex_weight_scaled_natAbs]
  simp only [Int.natAbs_mul, Int.natAbs_natCast, map_mul,
    ← physical_phase_reverse, neg_neg, Int.cast_mul, Int.cast_natCast, mul_inv]
  unfold physicalBarePatternScalar physicalPhasedPairCoefficient
  split_ifs
  · push_cast
    ring
  · simp only [mul_zero, zero_mul]

end Bounty
end

section

/- Positive extension agrees with the original endpoint on a positive cutoff. -/

open Finset
namespace Bounty

theorem physical_fixed_root_endpoint_congr
    {G : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (C : G → Finset (Fin J)) (q ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (positions : Finset ℤ)
    (f g f' g' : ℤ → ℂ) (Ψ : ℝ → ℂ) (Z : ℝ)
    (hf : ∀ n ∈ positions, f n = f' n) (hg : ∀ n ∈ positions, g n = g' n) :
    physicalFixedRootCorrelation V C q ζ k K aux positions f g Ψ Z =
      physicalFixedRootCorrelation V C q ζ k K aux positions f' g' Ψ Z := by
  classical
  unfold physicalFixedRootCorrelation
  congr 1
  apply sum_congr rfl
  intro x hx
  apply sum_congr rfl
  intro y hy
  rw [hf x.1 ((mem_physical_cutoff P J ell positions x).mp hx),
    hg y.1 ((mem_physical_cutoff P J ell positions y).mp hy)]

theorem physical_positive_root_agrees_on_positive_cutoff
    {G : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (C : G → Finset (Fin J)) (q ζ a b : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (positions : Finset ℤ)
    (hpos : ∀ n ∈ positions, 0 < n) (pool : Finset ℕ)
    (α₀ β₀ γ₀ α₁ β₁ γ₁ : ℕ → ℂ) (Ψ : ℝ → ℂ) (Z : ℝ) :
    physicalFixedRootCorrelation V C q ζ k K aux positions
      (fun n => physicalPhase a n.natAbs * invariantTripleEndpoint pool α₀ β₀ γ₀ n.natAbs)
      (fun n => physicalPhase b n.natAbs * invariantTripleEndpoint pool α₁ β₁ γ₁ n.natAbs) Ψ Z =
    physicalFixedRootCorrelation V C q ζ k K aux positions
      (fun n => physicalPhase a n.natAbs * positiveInvariantEndpoint pool α₀ β₀ γ₀ n)
      (fun n => physicalPhase b n.natAbs * positiveInvariantEndpoint pool α₁ β₁ γ₁ n) Ψ Z := by
  apply physical_fixed_root_endpoint_congr
  · intro n hn
    rw [positiveInvariantEndpoint, if_pos (hpos n hn)]
  · intro n hn
    rw [positiveInvariantEndpoint, if_pos (hpos n hn)]

end Bounty
end

section

/- A bounded error supported on the actual free-prime divisibility set is
controlled by the endpoint exclusion estimate. -/

open Finset
open scoped Classical
namespace Bounty

theorem invariant_harmonic_supported_error
    (Q T : Finset ℕ) (α β γ α' β' γ' : ℕ → ℂ)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (hα' : ∀ m, ‖α' m‖ ≤ A) (hβ' : ∀ p, ‖β' p‖ ≤ B) (hγ' : ∀ r, ‖γ' r‖ ≤ C)
    (S : Finset ℤ) (δ : ℤ) (N : ℕ)
    (hT : ∀ d ∈ T, d ∈ Nat.factoredNumbers Q) (hδ : ∀ d ∈ T, (d : ℤ) ∣ δ)
    (hS : ∀ n ∈ S, 0 ≤ n ∧ n ≤ (N : ℤ))
    (hS' : ∀ n ∈ S, 0 ≤ n + δ ∧ n + δ ≤ (N : ℤ))
    {Y K E : ℝ} (hY : 0 < Y) (hK : 0 ≤ K) (hE : 0 ≤ E)
    (hYlow : ∀ n ∈ S, Y ≤ (n : ℝ)) (θ e : ℤ → ℂ)
    (hθ : ∀ n ∈ S, ‖θ n‖ ≤ K) (he : ∀ n ∈ S, ‖e n‖ ≤ E)
    (hsupport : ∀ n ∈ S, (∀ d ∈ T, ¬ (d : ℤ) ∣ n) → e n = 0) :
    ‖∑ n ∈ S, (θ n / (n : ℂ)) *
      star (invariantTripleEndpoint Q α β γ n.natAbs) *
      invariantTripleEndpoint Q α' β' γ' (n+δ).natAbs * e n‖ ≤
      (K * E / Y) * ((A * B * C)^2 * (N : ℝ) * (1+Real.log N)^15) *
        ∑ d ∈ T, 1/(d : ℝ) := by
  have h := invariant_triple_endpoint_exclusion_error Q T α β γ α' β' γ'
    hA hB hC hα hβ hγ hα' hβ' hγ' S δ N hT hδ hS hS'
    hY (mul_nonneg hK hE) hYlow (fun n => θ n * e n)
    (fun n hn => by
      rw [norm_mul]
      exact mul_le_mul (hθ n hn) (he n hn) (norm_nonneg _) hK)
  dsimp only at h
  have hz : (∑ n ∈ S.filter (fun n => ¬ ∃ d ∈ T, (d : ℤ) ∣ n),
      ((θ n * e n) / (n : ℂ)) * star (invariantTripleEndpoint Q α β γ n.natAbs) *
        invariantTripleEndpoint Q α' β' γ' (n+δ).natAbs) = 0 := by
    apply sum_eq_zero
    intro n hn
    have hnS := (mem_filter.mp hn).1
    have hnT := (mem_filter.mp hn).2
    rw [hsupport n hnS (by simpa only [not_exists, not_and] using hnT)]
    simp
  rw [hz, sub_zero] at h
  convert h using 1
  congr 1
  apply sum_congr rfl
  intro n _
  ring

end Bounty
end

section

/- The original selected marked endpoint is approximated by its exact
four-factor convolution, with the proved small-prime square-error bound. -/

open Finset
open scoped Classical
namespace Bounty

theorem selected_four_convolution_error_energy
    {G : Type*} [Fintype G] [dG : DecidableEq G]
    (P : G → Finset ℕ) {q v : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v)
    (V : G → ℝ) (t : G → ℕ) (T : ℕ)
    (hV : ∀ g, v ≤ V g) (ht : ∀ g, t g ≤ T)
    (hprime : ∀ g, ∀ p ∈ P g, p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (g : G) (k : ℕ) (htg : t g = k + 1) (big : Finset G) (hsmall : g ∉ big)
    (b : GroupMarkedLists (fun h : big => P h.val) (fun h : big => t h.val) → ℂ)
    {H : ℝ} (hH : 0 ≤ H) (hb : ∀ L, ‖b L‖ ≤ H)
    (Q : Finset ℕ) (hQ : ∀ g, P g ⊆ Q) (α β γ : ℕ → ℂ)
    (hαfree : ∀ d, ¬ Disjoint d.primeFactors Q → α d = 0)
    (hβfree : ∀ d, ¬ Disjoint d.primeFactors Q → β d = 0)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (positions : Finset ℕ) (N : ℕ) (hpos : ∀ n ∈ positions, 0 < n ∧ n ≤ N) :
    let c := fun n : ℕ => groupMarkedAverage
      (fun h : big => P h.val) (fun h : big => t h.val) (n : ℤ) b
    (∑ n ∈ positions,
      ‖(markedDivisorWeight univ P q V t (n : ℤ) : ℂ) * c n *
          invariantTripleEndpoint Q α β γ n -
        endpointFourConvolution (fun p => if p ∈ P g then 1 / (V g : ℂ) else 0) α β
          (fun r => selectedMarkedWeight P Q q V (Function.update t g k) t big b (fun _ => 1) r *
            γ (primePoolFreePart Q r)) n‖ ^ 2) ≤
      H ^ 2 * (((markedDivisorBound q v T) ^ Fintype.card G * (1 + 2 * Real.log N / v)) ^ 2 *
        (((A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15) *
          ∑ p ∈ P g, 1 / (p : ℝ) ^ 2)) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  have he := weighted_small_mark_extraction_error_energy P hq0 hq1 hv V t T hV ht hprime hdis
    g k htg big hsmall b hH hb Q (hQ g) α β γ hA hB hC hα hβ hγ positions N hpos
  dsimp only at he ⊢
  convert he using 1
  apply sum_congr rfl
  intro n hn
  rw [weighted_group_marked_sum_selected_average,
    selected_marked_prime_peel_four_convolution P Q q V t t g k big b α β γ hprime hQ
      hαfree hβfree (ne_of_gt (hpos n hn).1)]
  rfl

end Bounty
end

section

/- Bounded four-factor convolutions become exact dyadic boxes without enlarging the output support. -/

open Finset

namespace Bounty

theorem endpoint_four_bounded_dyadic_transform (S : Finset ℕ) (N : ℕ)
    (hS : ∀ n ∈ S, n ≤ N) (δ α β γ F : ℕ → ℂ) :
    (∑ n ∈ S, endpointFourConvolution δ α β γ n * F n) =
      ∑ i ∈ dyadicNatIndices (Icc 1 N), ∑ j ∈ dyadicNatIndices (Icc 1 N),
      ∑ k ∈ dyadicNatIndices (Icc 1 N), ∑ l ∈ dyadicNatIndices (Icc 1 N),
      ∑ d ∈ dyadicNatBucket (Icc 1 N) i, ∑ a ∈ dyadicNatBucket (Icc 1 N) j,
      ∑ b ∈ dyadicNatBucket (Icc 1 N) k, ∑ c ∈ dyadicNatBucket (Icc 1 N) l,
        if d*a*b*c ∈ S then δ d * α a * β b * γ c * F (d*a*b*c) else 0 := by
  rw [sum_four_dyadicNatBuckets]
  exact endpoint_four_bounded_cutoff_transform S N hS δ α β γ F

theorem harmonic_mellin_cutoff_four_factor_box (S D A B C : Finset ℕ)
    (hD : ∀ d ∈ D, 0 < d) (hA : ∀ a ∈ A, 0 < a)
    (hB : ∀ b ∈ B, 0 < b) (hC : ∀ c ∈ C, 0 < c)
    (δ α β γ κ : ℕ → ℂ) (t : ℝ) :
    (∑ d ∈ D, ∑ a ∈ A, ∑ b ∈ B, ∑ c ∈ C,
      if d*a*b*c ∈ S then (δ d * α a * β b * γ c) *
        (κ (d*a*b*c) * harmonicMellinWeight t ((d*a*b*c : ℕ) : ℝ)) else 0) =
      ∑ d ∈ D, ∑ a ∈ A, ∑ b ∈ B, ∑ c ∈ C,
      if d*a*b*c ∈ S then
        (δ d * harmonicMellinWeight t d) * (α a * harmonicMellinWeight t a) *
        (β b * harmonicMellinWeight t b) * (γ c * harmonicMellinWeight t c) *
          κ (d*a*b*c) else 0 := by
  classical
  apply sum_congr rfl
  intro d hd
  apply sum_congr rfl
  intro a ha
  apply sum_congr rfl
  intro b hb
  apply sum_congr rfl
  intro c hc
  split_ifs
  · rw [harmonic_mellin_weight_four_factors t (hD d hd) (hA a ha) (hB b hb) (hC c hc)]
    ring
  · rfl

theorem endpoint_four_bounded_dyadic_mellin (S : Finset ℕ) (N : ℕ)
    (hS : ∀ n ∈ S, n ≤ N) (δ α β γ κ : ℕ → ℂ) (t : ℝ) :
    (∑ n ∈ S, endpointFourConvolution δ α β γ n *
      (κ n * harmonicMellinWeight t n)) =
      ∑ i ∈ dyadicNatIndices (Icc 1 N), ∑ j ∈ dyadicNatIndices (Icc 1 N),
      ∑ k ∈ dyadicNatIndices (Icc 1 N), ∑ l ∈ dyadicNatIndices (Icc 1 N),
      ∑ d ∈ dyadicNatBucket (Icc 1 N) i, ∑ a ∈ dyadicNatBucket (Icc 1 N) j,
      ∑ b ∈ dyadicNatBucket (Icc 1 N) k, ∑ c ∈ dyadicNatBucket (Icc 1 N) l,
        if d*a*b*c ∈ S then
          (δ d * harmonicMellinWeight t d) * (α a * harmonicMellinWeight t a) *
          (β b * harmonicMellinWeight t b) * (γ c * harmonicMellinWeight t c) *
            κ (d*a*b*c) else 0 := by
  classical
  rw [endpoint_four_bounded_dyadic_transform S N hS]
  apply sum_congr rfl
  intro i _
  apply sum_congr rfl
  intro j _
  apply sum_congr rfl
  intro k _
  apply sum_congr rfl
  intro l _
  apply harmonic_mellin_cutoff_four_factor_box
  all_goals intro n hn; exact (mem_Icc.mp (dyadicNatBucket_subset _ _ hn)).1

end Bounty
end

section

open MeasureTheory Filter

namespace Bounty

theorem eventually_local_mellin_geometric_truncation {c : ℝ} (hc : 0 ≤ c) (B D : ℝ) :
    ∃ j : ℕ, 2 ≤ j ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (Y h : ℝ) (S : Finset ℕ) (a : ℕ → ℂ) (N : ℕ),
      0 < Y → 0 < h → h⁻¹ ≤ Y →
      (∀ n ∈ S, 1 ≤ n ∧ n ≤ N) →
      (N:ℝ) ≤ c*Y → Real.log N ≤ c*L →
      (∑ n ∈ S, ‖a n‖^2) ≤ Y*L^B →
      (∫ t : ℝ, (1+|h*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2) ≤
        (∫ t in {t : ℝ | |t| ≤ L/h}, ‖localMellinPolynomial S a t‖^2)+Y^2*L^(-D) := by
  obtain ⟨j,hj,htrunc⟩ := local_mellin_truncation_power_saving 2 B D
  refine ⟨j,hj,?_⟩
  filter_upwards [eventually_ge_atTop (16:ℝ), eventually_ge_atTop (c*(c+1))] with L hL hcL
  intro Y h S a N hY hh hhi hS hN hlog hE
  apply htrunc L Y h S a N hL hY hh hhi hS _ hE
  have hL1 : 1 ≤ L := by linarith
  have hL0 : 0 ≤ L := by linarith
  have hlog0 : 0 ≤ Real.log N := Real.log_natCast_nonneg N
  calc
    (N:ℝ)*(1+Real.log N) ≤ (c*Y)*(1+c*L) := by gcongr
    _ ≤ (c*Y)*((c+1)*L) := mul_le_mul_of_nonneg_left (by nlinarith) (mul_nonneg hc hY.le)
    _ = Y*(c*(c+1)*L) := by ring
    _ ≤ Y*(L*L) := mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hcL hL0) hY.le
    _ = Y*L^2 := by ring
    _ = Y*L^(2:ℝ) := by rw [Real.rpow_two]

end Bounty
end

section

/- A fixed nine-interval cover of the full common-window convolution support. -/

open Finset MeasureTheory

namespace Bounty

theorem geometric_local_interval_cover {X : ℝ} (hX : 0 < X) (K : ℕ) {v : ℝ}
    (hv : v ∈ Set.Icc (X/2) (3*X*(2:ℝ)^K)) :
    ∃ i ∈ range (K+1), v ∈ Set.Icc ((X*(2:ℝ)^i)/2) (3*(X*(2:ℝ)^i)) := by
  induction K with
  | zero => exact ⟨0, by simp, by simpa using hv⟩
  | succ K ih =>
    by_cases hprev : v ≤ 3*X*(2:ℝ)^K
    · obtain ⟨i,hi,hvi⟩ := ih ⟨hv.1,hprev⟩
      exact ⟨i, mem_range.mpr (by have := mem_range.mp hi; omega), hvi⟩
    · refine ⟨K+1, by simp, ?_⟩
      have hpos : 0 < X*(2:ℝ)^K := by positivity
      rw [pow_succ] at hv ⊢
      constructor <;> nlinarith [hv.2]

theorem wide_mellin_interval_cover {Y v : ℝ} (hY : 0 < Y)
    (hv : v ∈ Set.Icc (Y/16) (65*Y)) :
    ∃ i ∈ range 9, v ∈ Set.Icc (((Y/8)*(2:ℝ)^i)/2) (3*((Y/8)*(2:ℝ)^i)) := by
  apply geometric_local_interval_cover (by positivity : 0 < Y/8) 8
  constructor <;> norm_num <;> linarith [hv.1,hv.2]

theorem wide_mellin_scale_bounds {Y : ℝ} (hY : 0 < Y) {i : ℕ} (hi : i ∈ range 9) :
    Y/8 ≤ (Y/8)*(2:ℝ)^i ∧ (Y/8)*(2:ℝ)^i ≤ 32*Y := by
  have hlo : 1 ≤ (2:ℝ)^i := one_le_pow₀ (by norm_num)
  have hhi : (2:ℝ)^i ≤ 256 := by
    have h := pow_le_pow_right₀ (by norm_num : (1:ℝ) ≤ 2) (show i ≤ 8 by
      have := mem_range.mp hi; omega)
    norm_num at h
    exact h
  constructor <;> nlinarith

theorem local_additive_convolution_wide_support (S : Finset ℕ) (a : ℕ → ℂ)
    {Y H v : ℝ} (_hY : 0 < Y) (hH : 0 < H) (hsmall : H ≤ Y/64)
    (hS : ∀ n ∈ S, Y/8 ≤ (n:ℝ) ∧ (n:ℝ) ≤ 64*Y)
    (hv : v ∉ Set.Icc (Y/16) (65*Y)) : localAdditiveConvolution S a H v = 0 := by
  unfold localAdditiveConvolution
  apply sum_eq_zero
  intro n hn
  have hz : localMellinKernelSchwartz (((n:ℝ)-v)/H) = 0 := by
    apply local_mellin_kernel_unit_support
    apply lt_of_not_ge
    intro hb
    rw [abs_div, abs_of_pos hH] at hb
    have ht := abs_le.mp ((div_le_one hH).mp hb)
    apply hv
    constructor <;> linarith [(hS n hn).1, (hS n hn).2, ht.1, ht.2]
  rw [hz, mul_zero]

end Bounty
end

section

/- Retained normalized four-factor boxes have uniform polynomial shifted energy. -/

open Finset Filter MeasureTheory

namespace Bounty

theorem eventually_harmonic_four_box_shifted_mean_square {c E : ℝ} (hc : 0 ≤ c) :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, 1 ≤ Y → Real.log Y ≤ c*L →
      ∀ (D A B C : Finset ℕ) (δ α β γ : ℕ → ℂ) (D₀ A₀ B₀ C₀ : ℝ),
      0 ≤ D₀ → 0 ≤ A₀ → 0 ≤ B₀ → 0 ≤ C₀ → D₀*A₀*B₀*C₀ ≤ L^E →
      (∀ d ∈ D, 0 < d) → (∀ a ∈ A, 0 < a) →
      (∀ b ∈ B, 0 < b) → (∀ z ∈ C, 0 < z) →
      (∀ d ∈ D, ‖δ d‖ ≤ D₀) → (∀ a ∈ A, ‖α a‖ ≤ A₀) →
      (∀ b ∈ B, ‖β b‖ ≤ B₀) → (∀ z ∈ C, ‖γ z‖ ≤ C₀) →
      (∀ d ∈ D, ∀ a ∈ A, ∀ b ∈ B, ∀ z ∈ C,
        Y/128 ≤ ((d*a*b*z : ℕ) : ℝ) ∧
          ((d*a*b*z : ℕ) : ℝ) ≤ 64*Real.exp 2*Y) →
      ∀ T v : ℝ, 0 ≤ T → T ≤ L*Y →
        (∫ t in Set.Icc (-T) T,
          ‖(∑ d ∈ D, δ d * harmonicMellinWeight (t + v) d) *
            (∑ a ∈ A, α a * harmonicMellinWeight (t + v) a) *
            (∑ b ∈ B, β b * harmonicMellinWeight (t + v) b) *
            (∑ z ∈ C, γ z * harmonicMellinWeight (t + v) z)‖ ^ 2) ≤ L^(2*E+17) := by
  filter_upwards [eventually_harmonic_box_mean_square_scalar (E := E) hc] with L hL
  intro Y hY hlogY D A B C δ α β γ D₀ A₀ B₀ C₀
    hD₀ hA₀ hB₀ hC₀ hprod hD hA hB hC hδ hα hβ hγ hgeom T v hT hTY
  let N := ⌈64*Real.exp 2*Y⌉₊
  have hY0 : 0 < Y := zero_lt_one.trans_le hY
  have hb := harmonic_four_box_shifted_mean_square D A B C δ α β γ
    hD₀ hA₀ hB₀ hC₀ (show 0 < Y/128 by positivity) hD hA hB hC
    hδ hα hβ hγ N (by
      intro d hd a ha b hb z hz
      have hp := hgeom d hd a ha b hb z hz
      refine ⟨hp.1, ?_⟩
      exact_mod_cast hp.2.trans (Nat.le_ceil (64*Real.exp 2*Y))) T v hT
  exact hb.trans (hL Y T (D₀*A₀*B₀*C₀) hY hlogY hT hTY (by positivity) hprod)

end Bounty
end

section

/- An exponentially growing conductor range has arbitrary relative power saving. -/

open Finset Filter

namespace Bounty

theorem exists_candidate_exponential_conductor_range_power_bound
    (hZ : PrimitiveZeroFreeHalfPlane) {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1) (B : ℝ) :
    ∃ J : ℕ, ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, J < jStar →
      ∀ N R : ℕ, (N : ℝ) ≤ Real.exp L → (R : ℝ) ≤ Real.exp ((c/512)*L) →
        candidateSmallPrimitiveTypeIMass c L q r jStar N R ≤
          candidateCoefficientWindowMass c L q r jStar * L^(-B) := by
  obtain ⟨J, hnorm⟩ := exists_candidate_character_relative_exponential_bound
    hZ hc hr hq0 hq1 hcenter
  have hdecay := eventually_linear_exponential_profile_le_rpow
    (by positivity : 0 < (3*c)/512) (by positivity : 0 < (3*c)/512)
    0 (4*primeEulerProductUpperConstant) B
  simp only [zero_mul, zero_add] at hdecay
  refine ⟨J, ?_⟩
  filter_upwards [hnorm, hdecay, eventually_ge_atTop (1 : ℝ),
    eventually_ge_atTop (Real.log 2)] with L hnormL hdecayL hL1 hlog2
  intro jStar hj N R hN hR
  have hL : 0 < L := lt_of_lt_of_le zero_lt_one hL1
  let XA := candidateCoefficientWindowMass c L q r jStar
  have hXA : 0 ≤ XA := by
    apply sum_nonneg
    intro u _
    exact candidate_coefficient_nonneg c L hq0 r jStar u
  have hweight : 0 ≤ XA * Real.exp (-(c/128)*L) := by positivity
  have hD : 1 ≤ Real.exp L := by
    exact (Real.one_le_exp_iff).mpr hL.le
  have hbound := candidate_small_primitive_mass_le c L q r jStar N R
    (fun _ => XA * Real.exp (-(c/128)*L)) (fun _ _ => hweight) hD hN (by
      intro d hd f hf ψ _ hψ
      have hdpos : 0 < d := (mem_Icc.mp (mem_filter.mp hd).1).1
      have hdN : d ≤ N := (mem_Icc.mp (mem_filter.mp hd).1).2
      have hffilt := mem_filter.mp hf
      have hfpos : 0 < f := lt_trans Nat.zero_lt_one hffilt.2.1
      have hfdvd : f ∣ d := Nat.dvd_of_mem_divisors hffilt.1
      have hfle : f ≤ d := Nat.le_of_dvd hdpos hfdvd
      have hfL : (f : ℝ) ≤ Real.exp L :=
        (Nat.cast_le.mpr (hfle.trans hdN)).trans hN
      have hdf : d/f ≠ 0 := (Nat.div_pos hfle hfpos).ne'
      have hdfL : ((d/f : ℕ) : ℝ) ≤ Real.exp L :=
        (Nat.cast_le.mpr ((Nat.div_le_self d f).trans hdN)).trans hN
      exact hnormL jStar hj f hfpos hfL ψ hψ (d/f) hdf hdfL)
  have hlog : Real.log (2*Real.exp L) ≤ 2*L := by
    rw [Real.log_mul (by norm_num : (2 : ℝ) ≠ 0) (Real.exp_ne_zero L), Real.log_exp]
    linarith
  have hlog0 : 0 ≤ Real.log (2*Real.exp L) := by
    rw [Real.log_mul (by norm_num : (2 : ℝ) ≠ 0) (Real.exp_ne_zero L), Real.log_exp]
    positivity
  have hcardN : (Icc 2 R).card ≤ R := by rw [Nat.card_Icc]; omega
  have hcard : ((Icc 2 R).card : ℝ) ≤ Real.exp ((c/512)*L) := (Nat.cast_le.mpr hcardN).trans hR
  have hsum : (∑ _f ∈ Icc 2 R, XA * Real.exp (-(c/128)*L)) ≤
      Real.exp ((c/512)*L) * (XA * Real.exp (-(c/128)*L)) := by
    simp only [sum_const, nsmul_eq_mul]
    exact mul_le_mul_of_nonneg_right hcard hweight
  calc
    _ ≤ ((2*primeEulerProductUpperConstant) * Real.log (2*Real.exp L)) *
        ∑ _f ∈ Icc 2 R, XA * Real.exp (-(c/128)*L) := hbound
    _ ≤ ((2*primeEulerProductUpperConstant) * (2*L)) *
        (Real.exp ((c/512)*L) * (XA * Real.exp (-(c/128)*L))) := by
      apply mul_le_mul
      · exact mul_le_mul_of_nonneg_left hlog (by positivity [primeEulerProductUpperConstant_pos])
      · exact hsum
      · exact sum_nonneg (fun _ _ => hweight)
      · positivity [primeEulerProductUpperConstant_pos]
    _ = XA * ((4*primeEulerProductUpperConstant) * L * Real.exp (-((3*c)/512)*L)) := by
      have hexp : Real.exp ((c/512)*L) * Real.exp (-(c/128)*L) =
          Real.exp (-((3*c)/512)*L) := by rw [← Real.exp_add]; congr 1; ring
      calc
        _ = XA * ((4*primeEulerProductUpperConstant) * L *
            (Real.exp ((c/512)*L) * Real.exp (-(c/128)*L))) := by ring
        _ = _ := by rw [hexp]
    _ ≤ XA * L^(-B) := mul_le_mul_of_nonneg_left hdecayL hXA

end Bounty

end

section

/- The physical edge with every target list and auxiliary draw is one
unified full-state row. Its globally extended phase is bounded everywhere. -/

open Finset
open scoped Classical
namespace Bounty

section Physical
variable {I K : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g, ∀ p : ↥(P g), NeZero p.val]
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (retention : I → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

abbrev PhysicalFullLedgerEvent (tag : Option (I ⊕ K))
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B) :=
  FullPermutationMixedEvent (fun g (p : ↥(P g)) => p.val)
    (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
    (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j)) tag s.2

noncomputable abbrev physicalFullLedgerEventFintype (tag : Option (I ⊕ K))
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B) :
    Fintype (PhysicalFullLedgerEvent C k tag s) :=
  fullPermutationMixedEventFintype (fun g (p : ↥(P g)) => p.val)
    (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
    (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j)) tag s.2

noncomputable def physicalFullLedgerEventTarget (tag : Option (I ⊕ K))
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (e : PhysicalFullLedgerEvent C k tag s) :=
  fullMixedLedgerTarget (fun g (p : ↥(P g)) => p.val)
    (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
    (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j)) tag s e

noncomputable def physicalFullLedgerEventPhase (tag : Option (I ⊕ K))
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (e : PhysicalFullLedgerEvent C k tag s) : ℂ :=
  fullMixedLedgerPhase (fun g (p : ↥(P g)) => p.val)
    (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
    (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j))
    (fun j H x e => physicalFullGlobalEdgePhase (C j) (k j) H (ω j)
      (fun g p => β g p / V g) ρ V x e) tag s e

noncomputable def physicalFullLedgerEventWeight (tag : Option (I ⊕ K))
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (e : PhysicalFullLedgerEvent C k tag s) : ℝ :=
  fullPermutationMixedEventWeight (fun g (p : ↥(P g)) => p.val)
    (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
    (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j))
    ω (fun g p => β g p / V g) retention ρ V tag s.2 e

abbrev PhysicalFullTraceEntry :=
  FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B ×
  PhysicalMarkObservation P ell C ×
  FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B

def physicalFullTraceAppend (r : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C))
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (o : PhysicalMarkObservation P ell C)
    (t : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B) :=
  r ++ [(s, o, t)]

noncomputable def physicalFullTraceObservation (tags : ℕ → Option (I ⊕ K))
    (cut : ℕ → Fin N → Finset (Fin J)) (i : ℕ)
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (e : PhysicalFullLedgerEvent C k (tags i) s) : PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C :=
  (s, physicalFullEventObservation C k (cut i) (cut (i + 1)) (tags i) s e,
    physicalFullLedgerEventTarget C k (tags i) s e)

noncomputable def physicalFullTraceRow (tags : ℕ → Option (I ⊕ K))
    (cut : ℕ → Fin N → Finset (Fin J)) :=
  let _ : ∀ (tag : Option (I ⊕ K)) s, Fintype (PhysicalFullLedgerEvent (P := P) (ell := ell) (B := B) C k tag s) :=
    physicalFullLedgerEventFintype (P := P) (ell := ell) (B := B) C k
  finiteRecordedPhasedRow (fun i => PhysicalFullLedgerEvent (P := P) (ell := ell) (B := B) C k (tags i))
    (fun i => physicalFullLedgerEventTarget C k (tags i))
    (fun i => physicalFullLedgerEventPhase C k ω β ρ V (tags i))
    (physicalFullTraceObservation C k tags cut)
    (fun i => physicalFullLedgerEventWeight C k ω β retention ρ V (tags i))

theorem physical_full_trace_row_eq (tags : ℕ → Option (I ⊕ K))
    (cut : ℕ → Fin N → Finset (Fin J)) (i : ℕ) :
    physicalFullRecordedRow (P := P) (ell := ell) (B := B) C k ω β retention ρ V
      (tags i) (cut i) (cut (i + 1)) (physicalFullTraceAppend C) =
      physicalFullTraceRow (P := P) (ell := ell) (B := B) C k ω β retention ρ V tags cut i := by
  funext F s
  unfold physicalFullRecordedRow finiteObservedRecordRow physicalFullObservedRow fullMixedObservedRow
    physicalFullTraceRow finiteRecordedPhasedRow finiteLocalPhasedRow
  apply sum_congr
  · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
  · intro e _
    rfl

omit [∀ g, ∀ p : ↥(P g), NeZero p.val] in
theorem physical_full_ledger_event_phase_norm_le (tag : Option (I ⊕ K))
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (e : PhysicalFullLedgerEvent C k tag s) :
    ‖physicalFullLedgerEventPhase C k ω β ρ V tag s e‖ ≤ 1 :=
  full_mixed_ledger_phase_norm_le _ _ _ _ _ _ _
    (fun j H x e => physical_full_global_edge_phase_norm_le (C j) (k j) H (ω j)
      (fun g p => β g p / V g) ρ V x e) tag s e

end Physical
end Bounty
