/- Admissible actual components satisfy the shared-slice comparison estimate. -/

namespace Bounty

open Finset
open scoped Classical

theorem finite_admissible_component_slice_error_le {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)]
    (μ : ∀ i, X i → ℝ) (hμ : ∀ i x, 0 ≤ μ i x) (hmass : ∀ i, ∑ x, μ i x = 1)
    (active U V S T A B : Finset I) (hU : U ⊆ active) (hV : V ⊆ active) (hUV : Disjoint U V)
    (hA : A ⊆ U \ S) (hB : B ⊆ V \ T)
    (KA : (∀ i : A, X i.1) → (∀ i : A, X i.1) → ℂ)
    (KB : (∀ i : B, X i.1) → (∀ i : B, X i.1) → ℂ)
    (phase : (∀ i : ↥(active \ (A ∪ B)), X i.1) →
      (∀ i : A, X i.1) → (∀ i : B, X i.1) → ℂ)
    (f g : (∀ i, X i) → ℂ) (ε : ℝ) (hε : 0 ≤ ε)
    (hfree : ∀ c, ∀ (u : (∀ i : A, X i.1) → ℂ) (v : (∀ i : B, X i.1) → ℂ),
      ‖finiteTwoKernelPairingError
        (finiteProductWeight (fun i : A => μ i.1)) (finiteProductWeight (fun i : B => μ i.1))
        KA KB (phase c) u v‖ ≤
      ε * Real.sqrt (finiteWeightedEnergy (finiteProductWeight (fun i : A => μ i.1)) u) *
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight (fun i : B => μ i.1)) v)) :
    ‖cleanRawPairing (finiteProductWeight μ)
        (fun x => phase (finiteCoordinateRestrict (active \ (A ∪ B)) x)
          (finiteCoordinateRestrict A x) (finiteCoordinateRestrict B x))
        (finiteCoordinateComponent μ S U.toList (finiteCoordinateComponent μ ∅ activeᶜ.toList f))
        (finiteCoordinateComponent μ T V.toList (finiteCoordinateComponent μ ∅ activeᶜ.toList g)) -
      cleanKernelPairing (finiteProductWeight μ)
        (finiteAsymmetricKernel μ (active \ (A ∪ B)) A B (fun c a b => finiteTwoKernelAverage
          (finiteProductWeight (fun i : A => μ i.1)) (finiteProductWeight (fun i : B => μ i.1))
          KA KB a b (phase c)))
        (finiteCoordinateComponent μ S U.toList (finiteCoordinateComponent μ ∅ activeᶜ.toList f))
        (finiteCoordinateComponent μ T V.toList (finiteCoordinateComponent μ ∅ activeᶜ.toList g))‖ ≤
      ε * Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ)
        (finiteCoordinateComponent μ S U.toList (finiteCoordinateComponent μ ∅ activeᶜ.toList f))) *
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ)
          (finiteCoordinateComponent μ T V.toList (finiteCoordinateComponent μ ∅ activeᶜ.toList g))) := by
  have hAU : A ⊆ U := fun i hi => (mem_sdiff.mp (hA hi)).1
  have hBV : B ⊆ V := fun i hi => (mem_sdiff.mp (hB hi)).1
  have hAa : A ⊆ active := hAU.trans hU
  have hBa : B ⊆ active := hBV.trans hV
  have hAB : Disjoint A B := hUV.mono hAU hBV
  obtain ⟨hsA, hsB, hsT, _, hAT, hBT, hc⟩ := finite_active_four_partition active A B hAa hBa hAB
  obtain ⟨F, hF⟩ := finite_four_component_factors_shared_b μ hmass
    (active \ (A ∪ B)) A B activeᶜ hsA hsB hsT hAB hAT hBT hc U S hA f
  obtain ⟨G, hG⟩ := finite_four_component_factors_shared_a μ hmass
    (active \ (A ∪ B)) A B activeᶜ hsA hsB hsT hAB hAT hBT hc V T hB g
  apply finite_four_asymmetric_pairing_error_le μ hμ hmass
    (active \ (A ∪ B)) A B activeᶜ hsA hsB hsT hAB hAT hBT hc KA KB phase _ _ F G hF hG ε hε
  intro c
  simpa only [finiteWeightedEnergy, Complex.norm_conj] using
    hfree c (G c) (fun b => (starRingEnd ℂ) (F c b))

end Bounty
