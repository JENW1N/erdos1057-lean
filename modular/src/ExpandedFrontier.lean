section

/- Full character/Mellin discrepancy for the actual prime test and global count-matched proxy. -/

open Finset Filter

namespace Bounty

theorem eventually_prime_proxy_character_discrepancy (hZ : PrimitiveZeroFreeHalfPlane)
    {a S T Bsave : ℝ} (ha : 0 < a) (hS : 0 ≤ S) (hT : 0 ≤ T)
    (hprecision : T+Bsave+2 ≤ S) :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, Real.exp (a*L) ≤ Y →
      ∀ (r : ℕ) [NeZero r] (χ : DirichletCharacter ℂ r), (r : ℝ) ≤ L^T →
      ∀ v : ℝ, |v| ≤ L^T → ∀ m n : ℕ, m ≤ n → Y ≤ (m+1 : ℕ) → (n : ℝ) ≤ 2*Y →
        ‖∑ i ∈ Ioc m n,
          (((if i.Prime then 1 else 0 : ℝ)-primeLogarithmicProxy L S i : ℝ) : ℂ)*
            harmonicMellinWeight v i*χ (i : ZMod r)‖ ≤ L^(-Bsave) := by
  filter_upwards [eventually_prime_proxy_mellin_difference_bound ha hS hT hprecision,
    eventually_prime_logarithmic_proxy_principal_identity ha S T,
    eventually_prime_interval_mellin_power_bound hZ ha hT (Bsave+1),
    eventually_prime_logarithmic_proxy_mellin_power_bound ha hS hT (Bsave+1),
    eventually_ge_atTop (2 : ℝ)] with L hprincipal hidentity hprime hproxy hL2
  have hL : 0 < L := by linarith
  intro Y hY r hr χ hrT v hv m n hmn hYm hn
  have hrpos : 0 < r := Nat.pos_of_ne_zero (NeZero.ne r)
  by_cases hχ : χ = 1
  · subst χ
    have heq : (∑ i ∈ Ioc m n,
        (((if i.Prime then 1 else 0 : ℝ)-primeLogarithmicProxy L S i : ℝ) : ℂ)*
          harmonicMellinWeight v i*(1 : DirichletCharacter ℂ r) (i : ZMod r)) =
        ∑ i ∈ Ioc m n,
          (((if i.Prime then 1 else 0 : ℝ)-primeLogarithmicProxy L S i : ℝ) : ℂ)*
            harmonicMellinWeight v i := by
      apply sum_congr rfl
      intro i hi
      have hiY : Real.exp (a*L) ≤ (i : ℝ) := hY.trans (hYm.trans (Nat.cast_le.mpr (mem_Ioc.mp hi).1))
      have hiid := hidentity i hiY r hrpos hrT
      calc
        _ = ((((if i.Prime then 1 else 0 : ℝ)-primeLogarithmicProxy L S i : ℝ) : ℂ)*
            (1 : DirichletCharacter ℂ r) (i : ZMod r))*harmonicMellinWeight v i := by ring
        _ = _ := by rw [hiid]
    rw [heq]
    exact hprincipal Y hY v hv m n hmn hYm hn
  · have hp := hprime Y hY r hrpos hrT χ hχ v hv m n hmn hYm hn
    have hb := hproxy Y hY r χ hχ hrT v hv m n hmn hYm hn
    have heq : (∑ i ∈ Ioc m n,
        (((if i.Prime then 1 else 0 : ℝ)-primeLogarithmicProxy L S i : ℝ) : ℂ)*
          harmonicMellinWeight v i*χ (i : ZMod r)) =
        (∑ i ∈ (Ioc m n).filter Nat.Prime, harmonicMellinWeight v i*χ (i : ZMod r))-
        ∑ i ∈ Ioc m n, (primeLogarithmicProxy L S i : ℂ)*
          harmonicMellinWeight v i*χ (i : ZMod r) := by
      simp only [sum_filter, Complex.ofReal_sub, sub_mul, sum_sub_distrib]
      congr 1
      apply sum_congr rfl
      intro i _
      by_cases hi : i.Prime <;> simp [hi]
    rw [heq]
    apply (norm_sub_le _ _).trans
    apply (add_le_add hp hb).trans
    have he : L^(-(Bsave+1)) = L^(-Bsave)/L := by
      rw [show -(Bsave+1) = -Bsave+(-1) by ring, Real.rpow_add hL, Real.rpow_neg_one]
      ring
    rw [he, ← add_div]
    apply (div_le_iff₀ hL).mpr
    nlinarith [mul_le_mul_of_nonneg_left hL2 (Real.rpow_nonneg hL.le (-Bsave))]

end Bounty
end

section

/- Exact physical history normalization under adjacent common-mark compatibility.
No global residue assignment is supplied; all original local rows and cutoffs remain. -/

open Finset
open scoped Classical
namespace Bounty

section ResiduePath
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (hcompat : ∀ j : Fin n, ∀ g s t,
    ((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val =
      ((physicalPermuteLabels (τ j) (L j.succ)) g t).val →
    (((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val : ℤ) ∣
      k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ) (η : Fin N → Fin (n + 1) → ℝ)
  (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0) (B : ℕ)

variable
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)

include hstep in
theorem physical_selected_adjacent_edge_extension (j : Fin n)
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    physicalMarkRawExtension
      (physicalSelectedStateEdgeBlock C k ω β retention ρ V hV j (aux j) (σ j) (τ j)
        (L j.succ) F) (L j.castSucc) =
      fun s => (((Fintype.card (PhysicalPermutations (Fin N) J ell) : ℝ)⁻¹ : ℂ) ^ 2) *
        (ω j (physicalSharedMarkLabels (C j) (physicalPermuteLabels (σ j) (L j.castSucc)))
          (aux j) : ℂ) *
      globalBirthJointCutRawRow
        (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β η V
          (fun _ => ρ) hV B (2 * j.val + 1)) B B
        (physicalMarkRawExtension F (L j.succ)) s := by
  apply physical_mark_raw_extension_eq_of_total_cutoff
  · intro s hs
    simp only [globalBirthJointCutRawRow, globalBirthJointRawCutoff,
      if_neg (Nat.not_le_of_gt hs), mul_zero]
  · intro s hs
    have he := physical_selected_adjacent_state_edge_block C aux k L a σ τ hstep hcompat hlist hP hdis hk β η V ρ hV B ω retention j F s hs
    simpa only [physical_full_memory_state_shared_labels] using he

theorem physical_selected_adjacent_visit_extension (j : Fin (n + 1))
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    physicalMarkRawExtension
      (physicalObservedMarkRow C k ω β retention ρ V hV (some (.inl j))
        (fun o t => if o = .inr none ∧ t.1 = L j then F t else 0)) (L j) =
      globalBirthJointCutRawRow
        (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β
          (fun _ i => 1 - retention i) V (fun _ => ρ) hV B (2 * j.val))
        B B (physicalMarkRawExtension F (L j)) := by
  apply physical_mark_raw_extension_eq_of_total_cutoff
  · intro s hs
    simp only [globalBirthJointCutRawRow, globalBirthJointRawCutoff,
      if_neg (Nat.not_le_of_gt hs)]
  · intro s hs
    have he := physical_selected_adjacent_state_visit C aux k L a σ τ hcompat hlist hP hdis hk β V ρ hV B ω retention j F s
    have hstate : (L j, s.2) = s := by rw [← hs]
    rw [hstate] at he
    exact he

end ResiduePath
end Bounty
