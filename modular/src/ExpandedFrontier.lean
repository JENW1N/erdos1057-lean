open scoped BigOperators
theorem norm_circle_phase_sub_one_ge (x : ℝ) :
    4 * ‖(x : UnitAddCircle)‖ ≤
      ‖Complex.exp (Complex.I * (2 * Real.pi * x : ℝ)) - 1‖ := by
  rw [Complex.norm_exp_I_mul_ofReal_sub_one, UnitAddCircle.norm_eq, Real.norm_eq_abs, abs_mul, abs_of_pos (show (0 : ℝ) < 2 by norm_num)]
  have hhalf := abs_sub_round x
  have harg : |Real.pi * (x - round x)| ≤ Real.pi / 2 := by
    rw [abs_mul, abs_of_pos Real.pi_pos]
    nlinarith [Real.pi_pos]
  have hsin := Real.mul_abs_le_abs_sin harg
  have habs : |Real.sin (Real.pi * (x - round x))| =
      |Real.sin (Real.pi * x)| := by
    rw [mul_sub, mul_comm Real.pi (round x : ℝ), Real.sin_sub_int_mul_pi,
      abs_mul, abs_zpow, abs_neg, abs_one, one_zpow, one_mul]
  rw [habs, abs_mul, abs_of_pos Real.pi_pos] at hsin
  have hpi : 2 / Real.pi * (Real.pi * |x - round x|) =
      2 * |x - round x| := by field_simp
  rw [hpi] at hsin
  have he : 2 * Real.pi * x / 2 = Real.pi * x := by ring
  rw [he]
  linarith

theorem norm_circle_phase_sub_one_pos (x : ℝ) (hx : (x : UnitAddCircle) ≠ 0) :
    0 < ‖Complex.exp (Complex.I * (2 * Real.pi * x : ℝ)) - 1‖ := by
  exact lt_of_lt_of_le (mul_pos (by norm_num) (norm_pos_iff.mpr hx))
    (norm_circle_phase_sub_one_ge x)

theorem circle_geometric_sum_norm_le_min (x : ℝ)
    (hx : (x : UnitAddCircle) ≠ 0) (N : ℕ) :
    ‖∑ n ∈ Finset.range N, Complex.exp (Complex.I * (2 * Real.pi * x : ℝ)) ^ n‖ ≤
      min (N : ℝ) (1 / (2 * ‖(x : UnitAddCircle)‖)) := by
  let z := Complex.exp (Complex.I * (2 * Real.pi * x : ℝ))
  have hz : ‖z‖ = 1 := by
    simpa [z, mul_comm Complex.I] using Complex.norm_exp_ofReal_mul_I (2 * Real.pi * x)
  have hd : 0 < ‖(x : UnitAddCircle)‖ := norm_pos_iff.mpr hx
  refine le_min (unit_geometric_sum_norm_le_length z hz N) ?_
  apply (le_div_iff₀ (mul_pos (by norm_num) hd)).mpr
  have hg := unit_geometric_sum_norm_mul_chord_le z hz N
  have hl := mul_le_mul_of_nonneg_left (norm_circle_phase_sub_one_ge x)
    (norm_nonneg (∑ n ∈ Finset.range N, z ^ n))
  change _ ≤ ‖∑ n ∈ Finset.range N, z ^ n‖ * ‖z - 1‖ at hl
  nlinarith
end

