open Finset
open scoped Classical
def physicalFullSharedIndices {J ell : ℕ} (C : Finset (Fin J)) : Finset (Fin (J + ell)) :=
  univ.map (Fin.castLEEmb ((Nat.sub_le J C.card).trans (Nat.le_add_right J ell)))

theorem physical_full_shared_indices_card {J ell : ℕ} (C : Finset (Fin J)) :
    (physicalFullSharedIndices (ell := ell) C).card = J - C.card := by
  simp only [physicalFullSharedIndices, card_map, card_univ, Fintype.card_fin]

theorem physical_full_unshared_indices_card {J ell : ℕ} (C : Finset (Fin J)) :
    (physicalFullSharedIndices (ell := ell) C)ᶜ.card = ell + C.card := by
  rw [card_compl, Fintype.card_fin, physical_full_shared_indices_card]
  have hc : C.card ≤ J := by simpa only [Fintype.card_fin] using card_le_univ C
  omega

noncomputable def physicalFullSharedEquiv {J ell : ℕ} (C : Finset (Fin J)) :
    ↥(physicalFullSharedIndices (ell := ell) C) ≃ ↥(physicalSharedSlots (ell := ell) C) :=
  (physicalFullSharedIndices C).equivFin.trans
    ((finCongr ((physical_full_shared_indices_card C).trans
      (physical_shared_slots_card C).symm)).trans (physicalSharedSlots C).equivFin.symm)

noncomputable def physicalFullUnsharedEquiv {J ell : ℕ} (C : Finset (Fin J)) :
    ↥((physicalFullSharedIndices (ell := ell) C)ᶜ) ≃ ↥(physicalUnsharedSlots (ell := ell) C) :=
  (physicalFullSharedIndices C)ᶜ.equivFin.trans
    ((finCongr (physical_full_unshared_indices_card C)).trans (physicalGroupUnsharedIndex C))

noncomputable def physicalFullSlotIndex {J ell : ℕ} (C : Finset (Fin J)) :
    Fin (J + ell) ≃ PhysicalSlots J ell :=
  finitePartitionEquiv (physicalFullSharedIndices C) (physicalSharedSlots C)
    (physicalFullSharedEquiv C) (physicalFullUnsharedEquiv C)

theorem physical_full_slot_index_shared_iff {J ell : ℕ} (C : Finset (Fin J))
    (i : Fin (J + ell)) :
    physicalFullSlotIndex C i ∈ physicalSharedSlots C ↔ i ∈ physicalFullSharedIndices C :=
  finite_partition_equiv_mem_iff _ _ _ _ i

theorem physical_full_slot_index_unshared {J ell : ℕ} (C : Finset (Fin J))
    (i : Fin (physicalFullSharedIndices (ell := ell) C)ᶜ.card) :
    physicalFullSlotIndex C ((physicalFullSharedIndices C)ᶜ.equivFin.symm i).val =
      (physicalGroupUnsharedIndex C (finCongr (physical_full_unshared_indices_card C) i)).val := by
  have h := finite_partition_equiv_right (physicalFullSharedIndices C) (physicalSharedSlots C)
    (physicalFullSharedEquiv C) (physicalFullUnsharedEquiv C)
    ((physicalFullSharedIndices C)ᶜ.equivFin.symm i)
  refine h.trans ?_
  change (physicalGroupUnsharedIndex C (finCongr (physical_full_unshared_indices_card C)
    ((physicalFullSharedIndices C)ᶜ.equivFin ((physicalFullSharedIndices C)ᶜ.equivFin.symm i)))).val = _
  exact congrArg (fun j => (physicalGroupUnsharedIndex C
    (finCongr (physical_full_unshared_indices_card C) j)).val)
    ((physicalFullSharedIndices C)ᶜ.equivFin.apply_symm_apply i)

theorem physical_full_slot_index_shared {J ell : ℕ} (C : Finset (Fin J))
    (i : Fin (physicalFullSharedIndices (ell := ell) C).card) :
    physicalFullSlotIndex C ((physicalFullSharedIndices C).equivFin.symm i).val =
      ((physicalSharedSlots C).equivFin.symm
        (finCongr ((physical_full_shared_indices_card C).trans
          (physical_shared_slots_card C).symm) i)).val := by
  have h := finite_partition_equiv_left (physicalFullSharedIndices C) (physicalSharedSlots C)
    (physicalFullSharedEquiv C) (physicalFullUnsharedEquiv C)
    ((physicalFullSharedIndices C).equivFin.symm i)
  simpa only [physicalFullSlotIndex, physicalFullSharedEquiv,
    Equiv.trans_apply, Equiv.apply_symm_apply] using h
end

