/- A performed parent outside the current owner fiber lies strictly in the past. -/

namespace Bounty

theorem restricted_birth_external_parent_owner_lt {N m L : ℕ}
    (embed : Fin m → Fin N) (hstrict : StrictMono embed)
    (owner : Fin N → Fin L) (hmono : Monotone owner) (u : Fin L)
    (howner : ∀ j, owner (embed j) = u) (performed : Fin N → Prop)
    (hcover : ∀ i, performed i → owner i = u → i ∈ Set.range embed)
    (j : Fin m) (p : Fin (embed j).val)
    (hp : performed (birthForestParentEmbedding (embed j) p))
    (he : ¬ ∃ k : Fin j.val,
      embed (birthForestParentEmbedding j k) = birthForestParentEmbedding (embed j) p) :
    owner (birthForestParentEmbedding (embed j) p) < u := by
  have hle : owner (birthForestParentEmbedding (embed j) p) ≤ u := by
    rw [← howner j]
    exact hmono (show birthForestParentEmbedding (embed j) p ≤ embed j from Nat.le_of_lt p.isLt)
  apply lt_of_le_of_ne hle
  intro hu
  exact restricted_birth_parent_not_in_range embed hstrict j p he (hcover _ hp hu)

theorem restricted_birth_anchors_past_local {N m L : ℕ} {α : Type*}
    (embed : Fin m → Fin N) (hstrict : StrictMono embed)
    (owner : Fin N → Fin L) (hmono : Monotone owner) (u : Fin L)
    (howner : ∀ j, owner (embed j) = u) (performed : Fin N → Prop)
    (hcover : ∀ i, performed i → owner i = u → i ∈ Set.range embed)
    (code : BirthForestCode N)
    (hparents : ∀ j p, code (embed j) = some p → performed (birthForestParentEmbedding (embed j) p))
    (values other : Fin N → α) (hpast : ∀ i, owner i < u → values i = other i) :
    restrictedBirthAnchors embed code values = restrictedBirthAnchors embed code other := by
  funext j
  cases hc : code (embed j) with
  | none => simp only [restrictedBirthAnchors, hc]
  | some p =>
    by_cases he : ∃ k : Fin j.val,
        embed (birthForestParentEmbedding j k) = birthForestParentEmbedding (embed j) p
    · simp only [restrictedBirthAnchors, hc, if_pos he]
    · simp only [restrictedBirthAnchors, hc, if_neg he]
      congr 1
      exact hpast _ (restricted_birth_external_parent_owner_lt embed hstrict owner hmono u howner
        performed hcover j p (hparents j p hc) he)

theorem restricted_birth_anchors_zero_owner {N m L : ℕ} {α : Type*}
    (embed : Fin m → Fin N) (hstrict : StrictMono embed)
    (owner : Fin N → Fin (L + 1)) (hmono : Monotone owner)
    (howner : ∀ j, owner (embed j) = 0) (performed : Fin N → Prop)
    (hcover : ∀ i, performed i → owner i = 0 → i ∈ Set.range embed)
    (code : BirthForestCode N)
    (hparents : ∀ j p, code (embed j) = some p → performed (birthForestParentEmbedding (embed j) p))
    (values : Fin N → α) : restrictedBirthAnchors embed code values = fun _ => none := by
  funext j
  cases hc : code (embed j) with
  | none => simp only [restrictedBirthAnchors, hc]
  | some p =>
    by_cases he : ∃ k : Fin j.val,
        embed (birthForestParentEmbedding j k) = birthForestParentEmbedding (embed j) p
    · simp only [restrictedBirthAnchors, hc, if_pos he]
    · have hlt := restricted_birth_external_parent_owner_lt embed hstrict owner hmono 0 howner
        performed hcover j p (hparents j p hc) he
      exact False.elim (Fin.not_lt_zero _ hlt)

theorem restricted_birth_equalValues_of_compatible {N m : ℕ} {α : Type*}
    (embed : Fin m → Fin N) (code : BirthForestCode N)
    (performed : Fin N → Prop) (values : Fin N → α)
    (h : birthForestCompatible performed values code) :
    birthForestEqualValues (restrictedBirthCode embed code) (values ∘ embed) := by
  apply ((restricted_birth_forest_iff embed code values).mp ?_).1
  intro j p hp
  have hj := h (embed j)
  rw [hp] at hj
  exact hj.2.2.symm

theorem compatible_zero_owner_restriction {N m L : ℕ} {α : Type*}
    (embed : Fin m → Fin N) (hstrict : StrictMono embed)
    (owner : Fin N → Fin (L + 1)) (hmono : Monotone owner)
    (howner : ∀ j, owner (embed j) = 0) (performed : Fin N → Prop)
    (hcover : ∀ i, performed i → owner i = 0 → i ∈ Set.range embed)
    (code : BirthForestCode N) (values : Fin N → α)
    (h : birthForestCompatible performed values code) :
    birthForestEqualValues (restrictedBirthCode embed code) (values ∘ embed) ∧
      restrictedBirthAnchors embed code values = (fun _ => none) := by
  refine ⟨restricted_birth_equalValues_of_compatible embed code performed values h, ?_⟩
  apply restricted_birth_anchors_zero_owner embed hstrict owner hmono howner performed hcover code _ values
  intro j p hp
  have hj := h (embed j)
  rw [hp] at hj
  exact hj.1

end Bounty
end

section

/- Local phase products along the original schedule and its four-step edge positions. -/

open Finset
open scoped Classical
namespace Bounty

theorem finite_schedule_local_phase_product
    {X : Type*} (E : ℕ → X → Type*) (target : ∀ i x, E i x → X)
    (phase : ∀ i x, E i x → ℂ) (m : ℕ) (x : X)
    (p : FiniteEventPath E target (List.range m) x) :
    finiteEventLocalPhase E target phase (List.range m) x p =
      ∏ i : Fin m, phase i.val (finiteScheduleOccurrence E target m x p i).1
        (finiteScheduleOccurrence E target m x p i).2 := by
  rw [finite_event_local_phase_occurrences]
  let F : Fin m → ℂ := fun i => phase i.val (finiteScheduleOccurrence E target m x p i).1
    (finiteScheduleOccurrence E target m x p i).2
  change _ = ∏ i : Fin m, F i
  rw [← (finCongr (show (List.range m).length = m from List.length_range)).prod_comp F]
  apply prod_congr rfl
  intro i _
  exact (finite_schedule_occurrence_apply E target phase m x p
    ((finCongr (show (List.range m).length = m from List.length_range)) i)).symm

theorem four_step_sparse_product (n : ℕ) (f : Fin (4 * n + 1) → ℂ)
    (hf : ∀ i, i.val % 4 ≠ 2 → f i = 1) :
    (∏ i : Fin (4 * n + 1), f i) =
      ∏ j : Fin n, f ⟨4 * j.val + 2, by have := j.isLt; omega⟩ := by
  symm
  apply prod_bij_ne_one (fun j _ _ => (⟨4 * j.val + 2, by have := j.isLt; omega⟩ : Fin (4 * n + 1)))
  · intros; exact mem_univ _
  · intro a _ _ b _ _ hab
    apply Fin.ext
    have hv := congrArg Fin.val hab
    dsimp only at hv
    omega
  · intro i _ hi
    have hm : i.val % 4 = 2 := by
      by_contra h
      exact hi (hf i h)
    let j : Fin n := ⟨i.val / 4, by have := i.isLt; omega⟩
    have he : (⟨4 * j.val + 2, by have := j.isLt; omega⟩ : Fin (4 * n + 1)) = i := by
      apply Fin.ext
      dsimp only [j]
      omega
    refine ⟨j, mem_univ _, ?_, he⟩
    simpa only [he] using hi
  · intros; rfl

end Bounty
end

section

/- The original ghost skeleton sum pays one atom for each fixed marked birth and no address-count factor. -/

open Finset Classical

namespace Bounty

theorem bounded_ghost_marked_coefficient_le {P Z : Type*}
    (A D : Z → ℝ) (hA : ∀ z, 0 ≤ A z)
    (ℓ ε v : ℝ) (hℓ : 0 ≤ ℓ) (hε : 0 ≤ ε) (hv : 0 ≤ v)
    (t B d : ℕ) (s : BoundedOrderedState P Z t B)
    (b : Fin (B + 1)) (r : Finset (Fin s.2.1.val)) :
    (if d ≤ b.val then boundedGhostSkeletonAbsMass A D t B s b r *
      v ^ boundedGhostSkeletonOutputCount t B s b r * ε ^ d * ℓ ^ (b.val - d) else 0) ≤
    (((∏ i ∈ r, A (s.2.2 i)) * (∏ i ∈ univ \ r, |D (s.2.2 i)|)) * v ^ r.card) *
      (if d ≤ b.val then ε ^ d * ℓ ^ (b.val - d) * v ^ b.val / (b.val.factorial : ℝ) else 0) := by
  by_cases hd : d ≤ b.val
  · simp only [hd, if_true]
    by_cases hc : r.card + b.val ≤ B
    · simp only [boundedGhostSkeletonAbsMass, boundedGhostSkeletonOutputCount, hc, if_true]
      rw [abs_div, abs_mul, abs_of_nonneg (prod_nonneg fun i _ => hA _), abs_prod,
        abs_of_nonneg (Nat.cast_nonneg _), pow_add]
      exact (by ring : _ = _).le
    · simp only [boundedGhostSkeletonAbsMass, hc, if_false, zero_mul]
      exact mul_nonneg
        (mul_nonneg (mul_nonneg (prod_nonneg fun i _ => hA _) (prod_nonneg fun i _ => abs_nonneg _))
          (pow_nonneg hv _))
        (div_nonneg (mul_nonneg (mul_nonneg (pow_nonneg hε _) (pow_nonneg hℓ _)) (pow_nonneg hv _))
          (Nat.cast_nonneg _))
  · simp only [hd, if_false, mul_zero, le_refl]

theorem bounded_ghost_marked_length_row_le {P Z : Type*}
    (A D : Z → ℝ) (hA : ∀ z, 0 ≤ A z)
    (ℓ ε v : ℝ) (hℓ : 0 ≤ ℓ) (hε : 0 ≤ ε) (hv : 0 ≤ v)
    (hdamp : ∀ z, A z * v + |D z| ≤ v)
    (t B d : ℕ) (s : BoundedOrderedState P Z t B) :
    (∑ b : Fin (B + 1), ∑ r : Finset (Fin s.2.1.val),
      if d ≤ b.val then boundedGhostSkeletonAbsMass A D t B s b r *
        v ^ boundedGhostSkeletonOutputCount t B s b r * ε ^ d * ℓ ^ (b.val - d) else 0) ≤
      (ε * v) ^ d * Real.exp (ℓ * v) * v ^ s.2.1.val := by
  have hret : 0 ≤ ∏ i : Fin s.2.1.val, (A (s.2.2 i) * v + |D (s.2.2 i)|) :=
    prod_nonneg fun i _ => add_nonneg (mul_nonneg (hA _) hv) (abs_nonneg _)
  calc
    _ ≤ ∑ b : Fin (B + 1), ∑ r : Finset (Fin s.2.1.val),
        (((∏ i ∈ r, A (s.2.2 i)) * (∏ i ∈ univ \ r, |D (s.2.2 i)|)) * v ^ r.card) *
          (if d ≤ b.val then ε ^ d * ℓ ^ (b.val - d) * v ^ b.val / (b.val.factorial : ℝ) else 0) := by
      apply sum_le_sum
      intro b _
      exact sum_le_sum fun r _ => bounded_ghost_marked_coefficient_le A D hA ℓ ε v hℓ hε hv t B d s b r
    _ = (∏ i : Fin s.2.1.val, (A (s.2.2 i) * v + |D (s.2.2 i)|)) *
        ∑ b ∈ range (B + 1), if d ≤ b then ε ^ d * ℓ ^ (b - d) * v ^ b / (b.factorial : ℝ) else 0 := by
      simp_rw [← sum_mul, ghost_retention_length_sum]
      rw [← mul_sum, Fin.sum_univ_eq_sum_range
        (fun b => if d ≤ b then ε ^ d * ℓ ^ (b - d) * v ^ b / (b.factorial : ℝ) else 0) (B + 1)]
    _ ≤ (∏ i : Fin s.2.1.val, (A (s.2.2 i) * v + |D (s.2.2 i)|)) *
        ((ε * v) ^ d * Real.exp (ℓ * v)) :=
      mul_le_mul_of_nonneg_left (marked_ghost_series_le ℓ ε v hℓ hε hv B d) hret
    _ ≤ v ^ s.2.1.val * ((ε * v) ^ d * Real.exp (ℓ * v)) := by
      apply mul_le_mul_of_nonneg_right _ (mul_nonneg (pow_nonneg (mul_nonneg hε hv) _) (Real.exp_pos _).le)
      rw [← Fin.prod_const]
      exact prod_le_prod₀ (fun i _ => add_nonneg (mul_nonneg (hA _) hv) (abs_nonneg _)) (fun i _ => hdamp _)
    _ = _ := by ring

end Bounty
end

section

/- Static selected-child counts agree with performed sample counts when all selected children are covered. -/

open Finset Classical

namespace Bounty

theorem selected_fiber_card {G : Type*} [DecidableEq G] {I : G → Type*}
    [∀ g, Fintype (I g)] {J : Type*} [Fintype J]
    (f : Sigma I ↪ J) (owner selected : J → Prop) [DecidablePred owner] [DecidablePred selected] (group : J → G)
    (howner : ∀ c, owner (f c)) (hgroup : ∀ c, group (f c) = c.1)
    (hcover : ∀ j, owner j → selected j → ∃ c, f c = j) (g : G) :
    (univ.filter (fun i : I g => selected (f ⟨g, i⟩))).card =
      (univ.filter (fun j => owner j ∧ group j = g ∧ selected j)).card := by
  apply card_bij (fun i _ => f ⟨g, i⟩)
  · intro i hi
    simp only [mem_filter, mem_univ, true_and] at hi ⊢
    exact ⟨howner _, hgroup _, hi⟩
  · intro a ha b hb hab
    have he := f.injective hab
    simpa only [Sigma.mk.inj_iff, heq_eq_eq, true_and] using he
  · intro j hj
    simp only [mem_filter, mem_univ, true_and] at hj
    obtain ⟨⟨h, c⟩, hc⟩ := hcover j hj.1 hj.2.2
    have hh : h = g := by
      exact (hgroup ⟨h, c⟩).symm.trans ((congrArg group hc).trans hj.2.1)
    subst h
    refine ⟨c, ?_, hc⟩
    simp only [mem_filter, mem_univ, true_and]
    rw [hc]
    exact hj.2.2

theorem birthForestCompatible_selected_performed {n : ℕ} {α : Type*}
    (performed : Fin n → Prop) (values : Fin n → α) (code : BirthForestCode n)
    (h : birthForestCompatible performed values code) (i : Fin n) (hi : code i ≠ none) : performed i := by
  cases hc : code i with
  | none => exact False.elim (hi hc)
  | some p =>
    have hh := h i
    rw [hc] at hh
    exact hh.2.1

theorem restricted_birth_selected_iff {N m : ℕ} {α : Type*}
    (embed : Fin m → Fin N) (code : BirthForestCode N) (values : Fin N → α) (j : Fin m) :
    (restrictedBirthCode embed code j ≠ none ∨ restrictedBirthAnchors embed code values j ≠ none) ↔
      code (embed j) ≠ none := by
  cases hc : code (embed j) with
  | none => simp [restrictedBirthCode, restrictedBirthAnchors, hc]
  | some p =>
    by_cases he : ∃ k : Fin j.val,
        embed (birthForestParentEmbedding j k) = birthForestParentEmbedding (embed j) p
    · simp [restrictedBirthCode, restrictedBirthAnchors, hc, he]
    · simp [restrictedBirthCode, restrictedBirthAnchors, hc, he]

end Bounty
end

section

/- A reverse eligibility probability bounds the actual averaged storage-only
operator. Choice-dependent external translations are transposed by inversion,
and the proved per-choice energy constant is unchanged. -/

open Finset Classical

namespace Bounty

theorem unrestricted_reverse_promotion_only_zero
    {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (Δ D : G → ℤ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (t : G → ℕ) (B : ℕ)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B)
    (hno : ¬ ∃ g, (unrestrictedResidueEligible (n g) (-Δ g) (D g) (s g).2.2).Nonempty) :
    unrestrictedReversePromotionOnlyProduct n Δ D μ ρ V t B f s = 0 := by
  unfold unrestrictedReversePromotionOnlyProduct
  rw [unrestricted_coupled_cutoff_eq_joint_event_sum]
  apply sum_eq_zero
  intro e he
  have hp : ¬ ((∀ g, (e g).1 = ∅) ∧ (∃ g, (e g).2.1 ≠ ∅)) := by
    rintro ⟨_, g, hg⟩
    exact hno ⟨g, unrestricted_promoting_event_eligible (n g) (-Δ g) (D g)
      (t g) B (s g) (e g) hg⟩
  simp only [if_neg hp, mul_zero, zero_mul]

section

variable {A G R : Type*} [Fintype A] [Fintype G] [Fintype R] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  (Δ D : A → G → ℤ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (t : G → ℕ) (B : ℕ) (π : A → ℝ) (τ : A → R ≃ R)

noncomputable def unrestrictedStorageExternalAverage
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → R → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) (r : R) : ℂ :=
  ∑ a, (π a : ℂ) * unrestrictedStorageOnlyProduct n (Δ a) (D a) μ ρ V t B
    (fun x => f x (τ a r)) s

noncomputable def unrestrictedReversePromotionExternalAverage
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → R → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) (r : R) : ℂ :=
  ∑ a, (π a : ℂ) * unrestrictedReversePromotionOnlyProduct n (Δ a) (D a) μ ρ V t B
    (fun x => f x ((τ a).symm r)) s

theorem unrestricted_storage_external_average_pairing
    (hV : ∀ g, V g ≠ 0)
    (f g : ProductBoundedOrderedState P (fun j => UnrestrictedResidueParticle (n j)) t B → R → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun s => f s r))
    (hg : ∀ r, ProductMemorySymmetric (fun s => g s r)) :
    (∑ r, ∑ s, (productMemoryWeight μ (fun j => unrestrictedResidueWeight (μ j)) s : ℂ) *
      f s r * unrestrictedStorageExternalAverage n Δ D μ ρ V t B π τ g s r) =
      ∑ r, ∑ s, (productMemoryWeight μ (fun j => unrestrictedResidueWeight (μ j)) s : ℂ) *
        unrestrictedReversePromotionExternalAverage n Δ D μ ρ V t B π τ f s r * g s r := by
  exact finite_external_fiber_average_pairing
    (productMemoryWeight μ (fun j => unrestrictedResidueWeight (μ j)))
    (fun (_ : Unit) a => π a)
    (fun (_ : Unit) a => unrestrictedStorageOnlyProduct n (Δ a) (D a) μ ρ V t B)
    (fun (_ : Unit) a => unrestrictedReversePromotionOnlyProduct n (Δ a) (D a) μ ρ V t B)
    (fun (_ : Unit) a => τ a) (fun (_ : Unit) => f) (fun (_ : Unit) => g) ()
    (fun a r q => unrestricted_storage_only_product_pairing n (Δ a) (D a) μ ρ V t B
      hV (fun s => f s r) (fun s => g s q) (hf r) (hg q))

omit [Fintype R] in
theorem unrestricted_storage_external_average_symmetric
    (f : ProductBoundedOrderedState P (fun j => UnrestrictedResidueParticle (n j)) t B → R → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun s => f s r)) (r : R) :
    ProductMemorySymmetric (fun s => unrestrictedStorageExternalAverage n Δ D μ ρ V t B π τ f s r) := by
  intro x j σ
  apply sum_congr rfl
  intro a ha
  rw [unrestricted_storage_only_product_symmetric n (Δ a) (D a) μ ρ V t B
    (fun s => f s (τ a r)) (hf (τ a r)) x j σ]

theorem unrestricted_reverse_promotion_external_average_energy_le
    (hπ : ∀ a, 0 ≤ π a) (hπmass : ∑ a, π a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, t g ≤ T) {δ : ℝ} (hδ : 0 ≤ δ)
    (hrare : ∀ s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B,
      productTotalMemory s ≤ B →
      (∑ a, if ∃ g, (unrestrictedResidueEligible (n g) (-Δ a g) (D a g) (s g).2.2).Nonempty
        then π a else 0) ≤ δ)
    (f : ProductBoundedOrderedState P (fun j => UnrestrictedResidueParticle (n j)) t B → R → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun s => f s r)) :
    (∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fun s => unrestrictedReversePromotionExternalAverage n Δ D μ ρ V t B π τ f s r)) ≤
      δ * unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        ∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
          (fun s => f s r) := by
  let bad : A → ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → Prop :=
    fun a s => productTotalMemory s ≤ B ∧
      ∃ g, (unrestrictedResidueEligible (n g) (-Δ a g) (D a g) (s g).2.2).Nonempty
  refine finite_sparse_external_average_energy_le π hπ hπmass
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productMemoryWeight_nonneg μ (fun g => unrestrictedResidueWeight (μ g)) hμ (fun g z => hμ g z.1))
    bad _ ?_ hδ (pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _) ?_ f ?_
  · intro a s r hbad
    by_cases hs : productTotalMemory s ≤ B
    · apply unrestricted_reverse_promotion_only_zero
      intro hh
      exact hbad ⟨hs, hh⟩
    · exact unrestricted_coupled_cutoff_zero_above_cap n (fun g => -Δ a g) (D a) μ ρ V t B _
        (fun x => f x ((τ a).symm r)) s hs
  · intro s
    by_cases hs : productTotalMemory s ≤ B
    · simpa only [bad, hs, true_and] using hrare s hs
    · simpa only [bad, hs, false_and, if_false, sum_const_zero] using hδ
  · intro a
    calc
      _ ≤ ∑ r, unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
          finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
            (fun s => f s ((τ a).symm r)) := by
        apply sum_le_sum
        intro r hr
        exact unrestricted_reverse_promotion_only_product_energy_le n (Δ a) (D a) μ ρ V t B
          hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht _ (hf ((τ a).symm r))
      _ = _ := by
        rw [← mul_sum, Equiv.sum_comp (τ a).symm
          (fun r => finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
            (fun s => f s r))]

theorem unrestricted_storage_external_average_energy_le
    (hπ : ∀ a, 0 ≤ π a) (hπmass : ∑ a, π a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, t g ≤ T) {δ : ℝ} (hδ : 0 ≤ δ)
    (hrare : ∀ s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B,
      productTotalMemory s ≤ B →
      (∑ a, if ∃ g, (unrestrictedResidueEligible (n g) (-Δ a g) (D a g) (s g).2.2).Nonempty
        then π a else 0) ≤ δ)
    (f : ProductBoundedOrderedState P (fun j => UnrestrictedResidueParticle (n j)) t B → R → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun s => f s r)) :
    (∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fun s => unrestrictedStorageExternalAverage n Δ D μ ρ V t B π τ f s r)) ≤
      δ * unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        ∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
          (fun s => f s r) := by
  apply finite_external_symmetric_transpose_energy_le
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productMemoryWeight_nonneg μ (fun g => unrestrictedResidueWeight (μ g))
      hμ (fun g z => hμ g z.1)) ProductMemorySymmetric
    (unrestrictedStorageExternalAverage n Δ D μ ρ V t B π τ)
    (unrestrictedReversePromotionExternalAverage n Δ D μ ρ V t B π τ)
  · intro q hq x i σ
    dsimp only
    rw [hq x i σ]
  · exact unrestricted_storage_external_average_symmetric n Δ D μ ρ V t B π τ
  · exact unrestricted_storage_external_average_pairing n Δ D μ ρ V t B π τ
      (fun g => (hvmin.trans_le (hVlo g)).ne')
  · exact mul_nonneg hδ (pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _)
  · exact unrestricted_reverse_promotion_external_average_energy_le n Δ D μ ρ V t B π τ
      hπ hπmass hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht hδ hrare
  · exact hf

end

end Bounty
end

section

/- The original labeled scalar splits with both exact permutation normalizations. -/

open scoped Classical
namespace Bounty

theorem physical_bare_labeled_group_factor
    {G I : Type*} [Fintype G] [dG : DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (small : G → Prop) (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (ζ : I → ℝ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (L R : PhysicalMarkLists P J ell) :
    physicalBareLabeledScalar V patterns C ζ K a L R =
      let i := a.2.2.1.val
      let src := physicalPermuteLabels a.1 L
      let tgt := physicalPermuteLabels a.2.1 R
      let aux := a.2.2.2
      ((Fintype.card (PhysicalPermutations {g // small g} J ell) : ℂ)⁻¹ *
        (Fintype.card (PhysicalPermutations {g // small g} J ell) : ℂ)⁻¹ *
        physicalBarePatternScalar (fun g : {g // small g} => V g.val) (fun g => C i g.val)
          0 (fun _ _ _ => 1) (fun g => aux g.val) (fun g => src g.val) (fun g => tgt g.val)) *
      ((Fintype.card (PhysicalPermutations {g // ¬small g} J ell) : ℂ)⁻¹ *
        (Fintype.card (PhysicalPermutations {g // ¬small g} J ell) : ℂ)⁻¹ *
        physicalBarePatternScalar (fun g : {g // ¬small g} => V g.val) (fun g => C i g.val)
          0 (physicalCoupledBigCoefficient small (C i) (ζ i) (K i)
            (fun g => src g.val) (fun g => tgt g.val) (fun g => aux g.val))
          (fun g => aux g.val) (fun g => src g.val) (fun g => tgt g.val)) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  dsimp only
  unfold physicalBareLabeledScalar
  have hn := physical_permutation_group_normalization small J ell
  simp only [← Nat.card_eq_fintype_card] at hn ⊢
  rw [hn, physical_bare_pattern_group_factor small]
  ring

end Bounty
end

section

/- Arbitrary logarithmic error bounds for the ordinary prime-number theorem. -/

open Filter Asymptotics

namespace Bounty

theorem ordinary_psi_error_isLittleO (B : ℝ) :
    (Chebyshev.psi - id) =o[atTop]
      (fun x : ℝ => x * (Real.log x)^(-B)) := by
  obtain ⟨c, hc, h⟩ := MediumPNT
  exact h.trans_isLittleO ((isBigO_refl (fun x : ℝ => x) atTop).mul_isLittleO
    (ordinary_stretched_exp_log_isLittleO hc (by norm_num : (0 : ℝ) < 1/10) B))

theorem eventually_ordinary_psi_log_power_bound (B : ℝ) :
    ∀ᶠ x : ℝ in atTop, |Chebyshev.psi x - x| ≤ x * (Real.log x)^(-B) := by
  filter_upwards [(ordinary_psi_error_isLittleO B).def (by norm_num : (0 : ℝ) < 1),
    eventually_ge_atTop (1 : ℝ)] with x hx hx1
  have hp : 0 ≤ x * (Real.log x)^(-B) := mul_nonneg (by linarith)
    (Real.rpow_nonneg (Real.log_nonneg hx1) _)
  simpa only [Pi.sub_apply, id_eq, Real.norm_eq_abs, one_mul, abs_of_nonneg hp] using hx

theorem eventually_ordinary_psi_uniform_log_power_bound {a : ℝ} (ha : 0 < a) (B : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ x : ℝ, Real.exp (a*L) ≤ x →
      |Chebyshev.psi x - x| ≤ x * (Real.log x)^(-B) := by
  obtain ⟨N, hN⟩ := eventually_atTop.mp (eventually_ordinary_psi_log_power_bound B)
  have hlim : Tendsto (fun L : ℝ => Real.exp (a*L)) atTop atTop :=
    Real.tendsto_exp_atTop.comp (tendsto_id.const_mul_atTop ha)
  filter_upwards [hlim.eventually (eventually_ge_atTop N)] with L hL
  exact fun x hx => hN x (hL.trans hx)

end Bounty
end

section

/- Exact last-prime decomposition of finite ordered rough-prime tuples. -/

open Finset

namespace Bounty

noncomputable def roughOrderedPrimeTuples (A B z : ℝ) (k : ℕ) : Finset (Fin k → ℕ) := by
  classical
  exact (Fintype.piFinset (fun _ : Fin k => primeBand z B)).filter
    (fun x => A < ((∏ i, x i : ℕ) : ℝ) ∧ ((∏ i, x i : ℕ) : ℝ) ≤ B)

theorem pi_finset_snoc_decomposition (P : Finset ℕ) (k : ℕ) :
    Fintype.piFinset (fun _ : Fin (k + 1) => P) =
      (P ×ˢ Fintype.piFinset (fun _ : Fin k => P)).map
        (Fin.snocEquiv (fun _ : Fin (k + 1) => ℕ)).toEmbedding := by
  have h := filter_piFinset_eq_map_snocEquiv (fun _ : Fin (k + 1) => P) (fun _ => True)
  simp only [filter_true] at h
  rw [show Fin.init (fun _ : Fin (k + 1) => P) = (fun _ : Fin k => P) from rfl] at h
  exact h

theorem prime_tuple_product_pos {P : Finset ℕ} (hP : ∀ p ∈ P, p.Prime)
    {k : ℕ} {x : Fin k → ℕ} (hx : x ∈ Fintype.piFinset (fun _ : Fin k => P)) :
    0 < ∏ i, x i := by
  apply prod_pos
  intro i hi
  exact (hP _ (Fintype.mem_piFinset.mp hx i)).pos

theorem rough_ordered_prime_tuple_last_count {A B z : ℝ}
    (hA : 0 ≤ A) (hB : 0 ≤ B) (hz : 0 ≤ z) (k : ℕ) :
    (roughOrderedPrimeTuples A B z (k + 1)).card =
      ∑ x ∈ Fintype.piFinset (fun _ : Fin k => primeBand z B),
        (primeBand (max z (A / ((∏ i, x i : ℕ) : ℝ)))
          (B / ((∏ i, x i : ℕ) : ℝ))).card := by
  classical
  rw [roughOrderedPrimeTuples, card_filter, pi_finset_snoc_decomposition, sum_map, sum_product,
    sum_comm]
  apply sum_congr rfl
  intro x hx
  have hxpos : 0 < ∏ i, x i := prime_tuple_product_pos
    (fun p hp => ((mem_primeBand_iff hz hB p).mp hp).1) hx
  have hxR : 0 < ((∏ i, x i : ℕ) : ℝ) := Nat.cast_pos.mpr hxpos
  have hxone : (1 : ℝ) ≤ ((∏ i, x i : ℕ) : ℝ) := by exact_mod_cast hxpos
  have hprod (p : ℕ) :
      (∏ i, (Fin.snocEquiv (fun _ : Fin (k + 1) => ℕ)) (p, x) i) = (∏ i, x i) * p := by
    change (∏ i, Fin.snoc x p i) = _
    rw [Fin.prod_univ_castSucc]
    simp only [Fin.snoc_castSucc, Fin.snoc_last]
  simp only [Equiv.toEmbedding_apply, hprod, Nat.cast_mul]
  rw [sum_boole, primeBand_product_interval hz hB hxR hA hB,
    min_eq_right (div_le_self hB hxone)]
  simp

theorem rough_ordered_prime_tuple_last_count_pos {A B z : ℝ}
    (hA : 0 ≤ A) (hB : 0 ≤ B) (hz : 0 ≤ z) {k : ℕ} (hk : 1 ≤ k) :
    (roughOrderedPrimeTuples A B z k).card =
      ∑ x ∈ Fintype.piFinset (fun _ : Fin (k - 1) => primeBand z B),
        (primeBand (max z (A / ((∏ i, x i : ℕ) : ℝ)))
          (B / ((∏ i, x i : ℕ) : ℝ))).card := by
  cases k with
  | zero => omega
  | succ k => simpa only [Nat.succ_sub_one] using rough_ordered_prime_tuple_last_count hA hB hz k

theorem rough_band_card_le_ordered_tuple_sum {A B z : ℝ}
    (hA : 1 ≤ A) (hB : 0 ≤ B) (hz : 0 < z) (K : ℕ)
    (hK : ∀ n ∈ roughBand A B z, n.primeFactorsList.length ≤ K) :
    ((roughBand A B z).card : ℝ) ≤
      (∑ k ∈ Icc 1 K, ((roughOrderedPrimeTuples A B z k).card : ℝ) / (k.factorial : ℝ)) +
        2 * B / z := by
  classical
  let S := (roughBand A B z).filter Squarefree
  have hP : ∀ p ∈ primeBand z B, p.Prime :=
    fun p hp => ((mem_primeBand_iff hz.le hB p).mp hp).1
  have hmap : ∀ n ∈ S, n.primeFactorsList.length ∈ Icc 1 K := by
    intro n hn
    have hnR := (mem_filter.mp hn).1
    have hAn : A < (n : ℝ) := Nat.lt_of_floor_lt (mem_Ioc.mp (mem_filter.mp hnR).1).1
    have hn1 : 1 < n := by exact_mod_cast (hA.trans_lt hAn)
    exact mem_Icc.mpr ⟨List.length_pos_iff.mpr ((Nat.primeFactorsList_ne_nil n).mpr hn1), hK n hnR⟩
  have hpartition : (S.card : ℝ) =
      ∑ k ∈ Icc 1 K, ((S.filter (fun n => n.primeFactorsList.length = k)).card : ℝ) := by
    exact_mod_cast (card_eq_sum_card_fiberwise hmap)
  have hsq : (S.card : ℝ) ≤
      ∑ k ∈ Icc 1 K, ((roughOrderedPrimeTuples A B z k).card : ℝ) / (k.factorial : ℝ) := by
    rw [hpartition]
    apply sum_le_sum
    intro k hk
    let F := S.filter (fun n => n.primeFactorsList.length = k)
    have hF : ∀ n ∈ F, Squarefree n ∧ n.primeFactors ⊆ primeBand z B ∧
        n.primeFactorsList.length = k := by
      intro n hn
      obtain ⟨hnS, hnk⟩ := mem_filter.mp hn
      obtain ⟨hnR, hnsq⟩ := mem_filter.mp hnS
      exact ⟨hnsq, rough_band_prime_factors_subset hB hz.le hnR, hnk⟩
    have heq := ordered_prime_tuple_count_squarefree hP k F hF
    change (F.card : ℝ) ≤ _
    rw [← heq]
    apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg _)
    apply Nat.cast_le.mpr
    apply card_le_card
    intro x hx
    obtain ⟨hxP, hxF⟩ := mem_filter.mp hx
    have hxR := (mem_filter.mp (mem_filter.mp hxF).1).1
    apply mem_filter.mpr
    refine ⟨hxP, Nat.lt_of_floor_lt (mem_Ioc.mp (mem_filter.mp hxR).1).1, ?_⟩
    exact (Nat.cast_le.mpr (mem_Ioc.mp (mem_filter.mp hxR).1).2).trans (Nat.floor_le hB)
  have hsplit : ((roughBand A B z).card : ℝ) = (S.card : ℝ) +
      (((roughBand A B z).filter (fun n => ¬ Squarefree n)).card : ℝ) := by
    exact_mod_cast (card_filter_add_card_filter_not (s := roughBand A B z) Squarefree).symm
  rw [hsplit]
  exact add_le_add hsq (rough_band_nonsquarefree_card_le hB hz)

theorem rough_band_card_le_last_prime_sum {A B z : ℝ}
    (hA : 1 ≤ A) (hB : 0 ≤ B) (hz : 0 < z) (K : ℕ)
    (hK : ∀ n ∈ roughBand A B z, n.primeFactorsList.length ≤ K) :
    ((roughBand A B z).card : ℝ) ≤
      (∑ k ∈ Icc 1 K,
        (∑ x ∈ Fintype.piFinset (fun _ : Fin (k - 1) => primeBand z B),
          ((primeBand (max z (A / ((∏ i, x i : ℕ) : ℝ)))
            (B / ((∏ i, x i : ℕ) : ℝ))).card : ℝ)) / (k.factorial : ℝ)) + 2 * B / z := by
  have h := rough_band_card_le_ordered_tuple_sum hA hB hz K hK
  apply h.trans_eq
  congr 1
  apply sum_congr rfl
  intro k hk
  rw [rough_ordered_prime_tuple_last_count_pos (by linarith : 0 ≤ A) hB hz.le (mem_Icc.mp hk).1,
    Nat.cast_sum]

theorem exponential_rough_band_card_le_last_prime_sum {A B γ L C : ℝ}
    (hA : 1 ≤ A) (hB : 0 ≤ B) (hγ : 0 < γ) (hL : 0 < L)
    (hBC : B ≤ Real.exp (C * L)) :
    ((roughBand A B (Real.exp (γ * L))).card : ℝ) ≤
      (∑ k ∈ Icc 1 ⌊C / γ⌋₊,
        (∑ x ∈ Fintype.piFinset (fun _ : Fin (k - 1) => primeBand (Real.exp (γ * L)) B),
          ((primeBand (max (Real.exp (γ * L)) (A / ((∏ i, x i : ℕ) : ℝ)))
            (B / ((∏ i, x i : ℕ) : ℝ))).card : ℝ)) / (k.factorial : ℝ)) +
              2 * B * Real.exp (-γ * L) := by
  have hK : ∀ n ∈ roughBand A B (Real.exp (γ * L)),
      n.primeFactorsList.length ≤ ⌊C / γ⌋₊ := by
    intro n hn
    have hnB : (n : ℝ) ≤ B :=
      (Nat.cast_le.mpr (mem_Ioc.mp (mem_filter.mp hn).1).2).trans (Nat.floor_le hB)
    exact exponential_rough_factor_list_length_le hγ hL (roughBand_pos hn).ne'
      (hnB.trans hBC) (mem_filter.mp hn).2
  have h := rough_band_card_le_last_prime_sum hA hB (Real.exp_pos (γ * L)) ⌊C / γ⌋₊ hK
  simpa only [neg_mul, Real.exp_neg, div_eq_mul_inv] using h

end Bounty


end

section

/- Exact and asymptotic normalized strict Buchstab recursions on logarithmic cells. -/

open Finset Filter

namespace Bounty

noncomputable def logarithmicCellCountScale (L S Y : ℝ) : ℝ :=
  (Real.exp (L ^ (-S)) * Y - Y) / L

noncomputable def normalizedRoughCellCount (L S Y z : ℝ) : ℝ :=
  ((roughBand Y (Real.exp (L ^ (-S)) * Y) z).card : ℝ) / logarithmicCellCountScale L S Y

noncomputable def normalizedPrimeCellCount (L S Y : ℝ) : ℝ :=
  ((primeBand Y (Real.exp (L ^ (-S)) * Y)).card : ℝ) / logarithmicCellCountScale L S Y

theorem logarithmic_cell_count_scale_pos {L S Y : ℝ} (hL : 0 < L) (hY : 0 < Y) :
    0 < logarithmicCellCountScale L S Y := by
  unfold logarithmicCellCountScale
  apply div_pos _ hL
  have hδ : 0 < L ^ (-S) := Real.rpow_pos_of_pos hL _
  have he : 1 < Real.exp (L ^ (-S)) := by
    simpa only [Real.exp_zero] using Real.exp_lt_exp.mpr hδ
  nlinarith

theorem logarithmic_cell_count_scale_div (L S Y t : ℝ) :
    logarithmicCellCountScale L S (Y / t) = logarithmicCellCountScale L S Y / t := by
  unfold logarithmicCellCountScale
  simp only [div_eq_mul_inv]
  ring

theorem logarithmic_cell_small_prime_bound {L S Y : ℝ}
    (hY : Real.exp (L ^ (-S)) ≤ Y) {p : ℕ}
    (hp : (p : ℝ) ≤ Real.sqrt (Real.exp (L ^ (-S)) * Y)) : (p : ℝ) ≤ Y := by
  have hY0 : 0 < Y := (Real.exp_pos _).trans_le hY
  have hB : Real.exp (L ^ (-S)) * Y ≤ Y ^ 2 := by nlinarith
  exact hp.trans ((Real.sqrt_le_iff).mpr ⟨hY0.le, hB⟩)

theorem normalized_buchstab_cell_remainder_identity {L S Y z : ℝ}
    (hL : 0 < L) (hY : Real.exp (L ^ (-S)) ≤ Y) (hz : 0 < z) (hzY : z ≤ Y) :
    normalizedRoughCellCount L S Y z - normalizedPrimeCellCount L S Y -
      (∑ p ∈ primeBand z (Real.sqrt (Real.exp (L ^ (-S)) * Y)),
        normalizedRoughCellCount L S (Y / (p : ℝ)) (p : ℝ) / (p : ℝ)) =
      ((strictBuchstabRemainder Y (Real.exp (L ^ (-S)) * Y) z).card : ℝ) /
        logarithmicCellCountScale L S Y := by
  classical
  have hY0 : 0 < Y := (Real.exp_pos _).trans_le hY
  have hscale := logarithmic_cell_count_scale_pos (S := S) hL hY0
  have hδ : 0 < L ^ (-S) := Real.rpow_pos_of_pos hL _
  have hY1 : 1 ≤ Y := (Real.one_le_exp hδ.le).trans hY
  have hB : 0 ≤ Real.exp (L ^ (-S)) * Y := by positivity
  have hcount : ((roughBand Y (Real.exp (L ^ (-S)) * Y) z).card : ℝ) =
      ((primeBand (max Y z) (Real.exp (L ^ (-S)) * Y)).card : ℝ) +
      (∑ p ∈ primeBand z (Real.sqrt (Real.exp (L ^ (-S)) * Y)),
        ((roughBand (max 1 (Y / (p : ℝ)))
          ((Real.exp (L ^ (-S)) * Y) / (p : ℝ)) (p : ℝ)).card : ℝ)) +
      ((strictBuchstabRemainder Y (Real.exp (L ^ (-S)) * Y) z).card : ℝ) := by
    exact_mod_cast strict_buchstab_count_with_remainder hY1 hB hz.le
  rw [max_eq_left hzY] at hcount
  have hcofactor : ∀ p ∈ primeBand z (Real.sqrt (Real.exp (L ^ (-S)) * Y)),
      ((roughBand (max 1 (Y / (p : ℝ)))
        ((Real.exp (L ^ (-S)) * Y) / (p : ℝ)) (p : ℝ)).card : ℝ) /
          logarithmicCellCountScale L S Y =
        normalizedRoughCellCount L S (Y / (p : ℝ)) (p : ℝ) / (p : ℝ) := by
    intro p hp
    obtain ⟨hpp, _, hpB⟩ := (mem_primeBand_iff hz.le (Real.sqrt_nonneg _) p).mp hp
    have hp0 : (0 : ℝ) < p := Nat.cast_pos.mpr hpp.pos
    have hpY : (p : ℝ) ≤ Y := logarithmic_cell_small_prime_bound hY hpB
    have hquot : 1 ≤ Y / (p : ℝ) := (le_div_iff₀ hp0).mpr (by simpa using hpY)
    rw [max_eq_right hquot, mul_div_assoc]
    unfold normalizedRoughCellCount
    rw [logarithmic_cell_count_scale_div]
    field_simp
  have hnorm := congrArg (fun t : ℝ => t / logarithmicCellCountScale L S Y) hcount
  rw [add_div, add_div, sum_div] at hnorm
  have hsum :
      (∑ p ∈ primeBand z (Real.sqrt (Real.exp (L ^ (-S)) * Y)),
        ((roughBand (max 1 (Y / (p : ℝ)))
          ((Real.exp (L ^ (-S)) * Y) / (p : ℝ)) (p : ℝ)).card : ℝ) /
            logarithmicCellCountScale L S Y) =
      ∑ p ∈ primeBand z (Real.sqrt (Real.exp (L ^ (-S)) * Y)),
        normalizedRoughCellCount L S (Y / (p : ℝ)) (p : ℝ) / (p : ℝ) := sum_congr rfl hcofactor
  rw [hsum] at hnorm
  change ((roughBand Y (Real.exp (L ^ (-S)) * Y) z).card : ℝ) / logarithmicCellCountScale L S Y -
    ((primeBand Y (Real.exp (L ^ (-S)) * Y)).card : ℝ) / logarithmicCellCountScale L S Y - _ = _
  linarith

theorem normalized_rough_cell_count_nonneg {L S Y z : ℝ} (hL : 0 < L) (hY : 0 < Y) :
    0 ≤ normalizedRoughCellCount L S Y z :=
  div_nonneg (Nat.cast_nonneg _) (logarithmic_cell_count_scale_pos hL hY).le

theorem normalized_prime_cell_count_nonneg {L S Y : ℝ} (hL : 0 < L) (hY : 0 < Y) :
    0 ≤ normalizedPrimeCellCount L S Y :=
  div_nonneg (Nat.cast_nonneg _) (logarithmic_cell_count_scale_pos hL hY).le

theorem eventually_normalized_buchstab_cell_error {a γ₀ S : ℝ}
    (ha : 0 < a) (hγ₀ : 0 < γ₀) (hS : 0 ≤ S) (Bsave : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ γ : ℝ, γ₀ ≤ γ → ∀ Y : ℝ, Real.exp (a * L) ≤ Y →
      Real.exp (γ * L) ≤ Y →
      0 ≤ normalizedRoughCellCount L S Y (Real.exp (γ * L)) - normalizedPrimeCellCount L S Y -
        (∑ p ∈ primeBand (Real.exp (γ * L)) (Real.sqrt (Real.exp (L ^ (-S)) * Y)),
          normalizedRoughCellCount L S (Y / (p : ℝ)) (p : ℝ) / (p : ℝ)) ∧
      normalizedRoughCellCount L S Y (Real.exp (γ * L)) - normalizedPrimeCellCount L S Y -
        (∑ p ∈ primeBand (Real.exp (γ * L)) (Real.sqrt (Real.exp (L ^ (-S)) * Y)),
          normalizedRoughCellCount L S (Y / (p : ℝ)) (p : ℝ) / (p : ℝ)) ≤ L ^ (-Bsave) := by
  filter_upwards [eventually_rough_logarithmic_cell_squarefree_count_error hγ₀ hS Bsave,
    eventually_ge_atTop (1 : ℝ), eventually_ge_atTop (1 / a)] with L hbad hL1 hLa
  intro γ hγ Y hY hzY
  have hL : 0 < L := zero_lt_one.trans_le hL1
  have hY0 : 0 < Y := (Real.exp_pos _).trans_le hY
  have haL : 1 ≤ a * L := by
    have h := (div_le_iff₀ ha).mp hLa
    nlinarith
  have hδ : L ^ (-S) ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos hL1 (neg_nonpos.mpr hS)
  have hcellY : Real.exp (L ^ (-S)) ≤ Y :=
    (Real.exp_le_exp.mpr (hδ.trans haL)).trans hY
  rw [normalized_buchstab_cell_remainder_identity hL hcellY (Real.exp_pos _) hzY]
  have hscale := logarithmic_cell_count_scale_pos (S := S) hL hY0
  refine ⟨div_nonneg (Nat.cast_nonneg _) hscale.le, ?_⟩
  apply (div_le_iff₀ hscale).mpr
  have hY1 : 1 ≤ Y := (Real.one_le_exp (mul_nonneg ha.le hL.le)).trans hY
  have hrem : ((strictBuchstabRemainder Y (Real.exp (L ^ (-S)) * Y) (Real.exp (γ * L))).card : ℝ) ≤
      (((roughBand Y (Real.exp (L ^ (-S)) * Y) (Real.exp (γ * L))).filter
        (fun n => ¬ Squarefree n)).card : ℝ) := by
    exact_mod_cast card_le_card (strict_buchstab_remainder_subset_nonsquarefree hY1)
  have herror := hbad γ hγ Y hY0.le
  rw [rough_band_squarefree_count_error] at herror
  exact hrem.trans herror

end Bounty


end

section

/- At a retained small prefix, the big action is the literal full capped
edge event sum. Its displacement and residue translation depend only on the
retained big labels and fixed auxiliary data. -/

open Finset Classical

namespace Bounty

section

variable {S G : Type*} [Fintype S] [Fintype G] [DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  {J : ℕ} {M : G → ℕ} (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
  (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
  (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (kbig : SharedActiveLabels P shared → ℤ)

abbrev PhysicalSmallBigFullEvent (d : PhysicalSharedLists Ps J)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :=
  FullActiveEdgeEvent n shared B (fun _ => Unit) (fun c _ => Δ d c) (fun c _ => D d c) x

noncomputable def physicalSmallBigFullTarget (d : PhysicalSharedLists Ps J)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : PhysicalSmallBigFullEvent n shared B Δ D d x) :=
  fullActiveEdgeEventTarget n shared B (fun _ => Unit) (fun c _ => Δ d c) (fun c _ => D d c) x e

noncomputable def physicalSmallBigFullCoefficient
    (Ψ : ∀ d x, PhysicalResidues Ps → PhysicalSmallBigFullEvent n shared B Δ D d x → ℂ)
    (r : PhysicalResidues Ps) (d : PhysicalSharedLists Ps J)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : PhysicalSmallBigFullEvent n shared B Δ D d x) : ℂ :=
  (fullActiveEdgeEventWeight n shared B (fun _ => Unit) (fun c _ => Δ d c) (fun c _ => D d c)
    (fun _ _ => 1) μ ρ V x e : ℂ) * Ψ d x r e

omit [∀ g p, NeZero (n g p)] in
/-- This is an identity of the actual finite event sums, including both
memory cutoffs and any bounded source/event-dependent coefficient. -/
theorem physical_small_big_full_prefix_eq
    (Ψ : ∀ d x, PhysicalResidues Ps → PhysicalSmallBigFullEvent n shared B Δ D d x → ℂ)
    (F : PhysicalSharedLists Ps J →
      ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → PhysicalResidues Ps → ℂ)
    (d : PhysicalSharedLists Ps J)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (r : PhysicalResidues Ps) :
    physicalSmallBigPrefixAction (PhysicalSmallBigFullEvent n shared B Δ D)
      (physicalSmallBigFullTarget n shared B Δ D)
      (physicalSmallBigFullCoefficient n shared B Δ D μ ρ V Ψ)
      (fun y => kbig (productActiveMemorySplit shared B y).1) F d x r =
    fullActiveExternalCoefficientAction n shared B (fun _ => Unit)
      (fun c _ => Δ d c) (fun c _ => D d c) (fun _ _ => 1) μ ρ V
      (fun c _ => physicalResidueTranslationEquiv (P := Ps)
        (kbig c * (physicalSharedProduct d : ℕ))) (Ψ d) (F d) x r := by
  rfl

variable [∀ p : PhysicalPrime Ps, NeZero p.2.val]

theorem physical_small_big_full_prefix_energy_le
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, (shared g)ᶜ.card ≤ T)
    (Ψ : ∀ d x, PhysicalResidues Ps → PhysicalSmallBigFullEvent n shared B Δ D d x → ℂ)
    (H : ℝ) (hH : 0 ≤ H) (hΨ : ∀ d x r e, ‖Ψ d x r e‖ ≤ H)
    (F : PhysicalSharedLists Ps J →
      ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → PhysicalResidues Ps → ℂ)
    (hF : ∀ d r, ProductMemorySymmetric (fun x => F d x r)) :
    physicalSmallBigConditionEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (physicalSmallBigPrefixAction (PhysicalSmallBigFullEvent n shared B Δ D)
        (physicalSmallBigFullTarget n shared B Δ D)
        (physicalSmallBigFullCoefficient n shared B Δ D μ ρ V Ψ)
        (fun y => kbig (productActiveMemorySplit shared B y).1) F) ≤
      H ^ 2 * unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        physicalSmallBigConditionEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) F := by
  unfold physicalSmallBigConditionEnergy
  rw [mul_sum]
  apply sum_le_sum
  intro d hd
  simp_rw [physical_small_big_full_prefix_eq]
  exact full_active_external_coefficient_energy_le n shared B (fun _ => Unit)
    (fun c _ => Δ d c) (fun c _ => D d c) (fun _ _ => 1) μ ρ V
    (fun c _ => physicalResidueTranslationEquiv (P := Ps) (kbig c * (physicalSharedProduct d : ℕ)))
    (by intros; exact zero_le_one) (by intro c; simp only [Fintype.sum_unique, le_refl])
    hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht (Ψ d) H hH (hΨ d) (F d) (hF d)

theorem physical_small_big_conditioned_full_prefix_energy_le [DecidableEq S]
    {ell : ℕ} (Vs : S → ℝ) (q : ℝ)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, (shared g)ᶜ.card ≤ T)
    (Ψ : ∀ d x, PhysicalResidues Ps → PhysicalSmallBigFullEvent n shared B Δ D d x → ℂ)
    (H : ℝ) (hH : 0 ≤ H) (hΨ : ∀ d x r e, ‖Ψ d x r e‖ ≤ H)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (hF : ∀ s, ProductMemorySymmetric (fun x => F (s, x))) :
    physicalSmallBigConditionEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (physicalSmallBigPrefixAction (PhysicalSmallBigFullEvent n shared B Δ D)
        (physicalSmallBigFullTarget n shared B Δ D)
        (physicalSmallBigFullCoefficient n shared B Δ D μ ρ V Ψ)
        (fun y => kbig (productActiveMemorySplit shared B y).1) (physicalSmallBigCondition Vs q F)) ≤
      H ^ 2 * unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        physicalSmallBigConditionEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
          (physicalSmallBigCondition Vs q F) := by
  exact physical_small_big_full_prefix_energy_le n shared B Δ D μ ρ V kbig
    hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht Ψ H hH hΨ
    (physicalSmallBigCondition Vs q F)
    (fun d r => physical_small_big_condition_memory_symmetric Vs q F hF d r)

end

end Bounty
end

section

/- Energy transfer through the two actual small conditioning maps.
The remaining bound is on the big event action at each retained small
prefix. The small measure is the original residue-valid counting measure. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_small_big_energy_of_prefix_bound
    {S X : Type*} [Fintype S] [dS : DecidableEq S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (hV : ∀ s, 0 < V s) (q ζ : ℝ) (W : X → ℝ) (hW : ∀ x, 0 ≤ W x)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (κ : PhysicalSharedLists P J → ℂ)
    (E : PhysicalSharedLists P J → X → Type*) [∀ d x, Fintype (E d x)]
    (target : ∀ d x, E d x → X)
    (a : PhysicalResidues P → ∀ d x, E d x → ℂ) (k : X → ℤ)
    {A H K : ℝ} (hA : 0 ≤ A) (hH : 0 ≤ H) (hK : 0 ≤ K)
    (hκ : ∀ d, ‖κ d‖ ≤ H)
    (hcondition : ∀ u : PhysicalSmallBigState P J ell X → ℂ,
      physicalSmallBigConditionEnergy W (physicalSmallBigCondition V q u) ≤
        A * physicalSmallBigEnergy V W u)
    (F : PhysicalSmallBigState P J ell X → ℂ)
    (hprefix : physicalSmallBigConditionEnergy W
      (physicalSmallBigPrefixAction E target a k (physicalSmallBigCondition V q F)) ≤
        K * physicalSmallBigConditionEnergy W (physicalSmallBigCondition V q F)) :
    physicalSmallBigEnergy V W (physicalSmallBigAction V q ζ aux κ E target a k F) ≤
      A ^ 2 * H ^ 2 * K * physicalSmallBigEnergy V W F := by
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  let Y := PhysicalSharedLists P J × (PhysicalResidues P × X)
  let ν : Y → ℝ := fun y => W y.2.2
  let C : (PhysicalSmallBigState P J ell X → ℂ) → Y → ℂ :=
    fun u y => physicalSmallBigCondition V q u y.1 y.2.2 y.2.1
  let v : Y → ℂ := fun y => κ y.1 * physicalPhase ζ (physicalSharedProduct y.1) *
    physicalSmallBigPrefixAction E target a k (physicalSmallBigCondition V q F) y.1 y.2.2 y.2.1
  have hCe (u : PhysicalSmallBigState P J ell X → ℂ) :
      finiteWeightedEnergy ν (C u) =
        physicalSmallBigConditionEnergy W (physicalSmallBigCondition V q u) := by
    simp only [ν, C, Y, finiteWeightedEnergy, Fintype.sum_prod_type, physicalSmallBigConditionEnergy]
  have hv : finiteWeightedEnergy ν v ≤
      (H ^ 2 * K * A) * finiteWeightedEnergy (physicalSmallBigMeasure V W) F := by
    calc
      _ ≤ H ^ 2 * physicalSmallBigConditionEnergy W
          (physicalSmallBigPrefixAction E target a k (physicalSmallBigCondition V q F)) := by
        simp only [ν, v, Y, finiteWeightedEnergy, Fintype.sum_prod_type,
          physicalSmallBigConditionEnergy, mul_sum]
        apply sum_le_sum
        intro d _
        apply sum_le_sum
        intro r _
        apply sum_le_sum
        intro x _
        rw [norm_mul, norm_mul, physical_phase_norm, mul_one, mul_pow]
        have hsq : ‖κ d‖ ^ 2 ≤ H ^ 2 := (sq_le_sq₀ (norm_nonneg _) hH).mpr (hκ d)
        nlinarith [mul_le_mul_of_nonneg_right hsq
          (mul_nonneg (hW x) (sq_nonneg
            ‖physicalSmallBigPrefixAction E target a k (physicalSmallBigCondition V q F) d x r‖))]
      _ ≤ H ^ 2 * (K * physicalSmallBigConditionEnergy W (physicalSmallBigCondition V q F)) :=
        mul_le_mul_of_nonneg_left hprefix (sq_nonneg H)
      _ ≤ H ^ 2 * (K * (A * physicalSmallBigEnergy V W F)) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left (hcondition F) hK) (sq_nonneg H)
      _ = _ := by rw [physical_small_big_energy_eq]; ring
  have h := finite_conditioned_energy_le (physicalSmallBigMeasure V W) ν
    (physical_small_big_measure_nonneg V hV W hW) (fun y => hW y.2.2)
    C hA (mul_nonneg (mul_nonneg (sq_nonneg H) hK) hA)
    (fun u => by rw [hCe, physical_small_big_energy_eq]; exact hcondition u)
    F (physicalSmallBigAction V q ζ aux κ E target a k F) v hv
    (fun u => by
      simpa only [ν, C, v, Y, Fintype.sum_prod_type] using
        physical_small_big_pairing V hV q ζ W aux κ E target a k u F)
  rw [physical_small_big_energy_eq, physical_small_big_energy_eq] at h
  convert h using 1
  ring

/-- The small norm conversion is supplied by the original conditioning
estimate, uniformly in the number J of retained slots. The only remaining
energy premise concerns the explicit big-event operator. -/
theorem exists_physical_small_big_energy_bound
    {q v : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (ell : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (S X : Type) [Fintype S] [DecidableEq S] [Fintype X]
      (P : S → Finset ℕ) [∀ p : PhysicalPrime P, NeZero p.2.val]
      (J : ℕ) (V : S → ℝ), (∀ s, v ≤ V s) →
      ∀ (ζ : ℝ) (W : X → ℝ), (∀ x, 0 ≤ W x) →
      ∀ (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
        (κ : PhysicalSharedLists P J → ℂ)
        (E : PhysicalSharedLists P J → X → Type) [∀ d x, Fintype (E d x)]
        (target : ∀ d x, E d x → X)
        (a : PhysicalResidues P → ∀ d x, E d x → ℂ) (k : X → ℤ)
        (H K : ℝ), 0 ≤ H → 0 ≤ K → (∀ d, ‖κ d‖ ≤ H) →
      ∀ F : PhysicalSmallBigState P J ell X → ℂ,
      physicalSmallBigConditionEnergy W
        (physicalSmallBigPrefixAction E target a k (physicalSmallBigCondition V q F)) ≤
          K * physicalSmallBigConditionEnergy W (physicalSmallBigCondition V q F) →
      physicalSmallBigEnergy V W (physicalSmallBigAction V q ζ aux κ E target a k F) ≤
        A ^ (2 * Fintype.card S) * H ^ 2 * K * physicalSmallBigEnergy V W F := by
  obtain ⟨A, hA, hcond⟩ := exists_physical_small_big_condition_energy_bound hq0 hq1 hv ell
  refine ⟨A, hA, ?_⟩
  intro S X _ dS _
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  intro P _ J V hV ζ W hW aux κ E _ target a k H K hH hK hκ F hprefix
  have h := physical_small_big_energy_of_prefix_bound V (fun s => hv.trans_le (hV s)) q ζ W hW
    aux κ E target a k (pow_nonneg (zero_le_one.trans hA) _) hH hK hκ
    (hcond S X P J V hV W hW) F hprefix
  simpa only [← pow_mul, Nat.mul_comm (Fintype.card S) 2] using h

end Bounty
end

section

/- Sparse small-source averaging in the original mixed measure. The
choice index may include an auxiliary draw. A source gate stays explicit,
and support rarity is used jointly before integrating either choice. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_small_big_sparse_permutation_energy_le
    {S X Q : Type*} [Fintype S] [Fintype X] [Fintype Q]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (hV : ∀ s, 0 < V s) (W : X → ℝ) (hW : ∀ x, 0 ≤ W x)
    (π : Q → ℝ) (hπ : ∀ a, 0 ≤ π a) (hπmass : ∑ a, π a ≤ 1)
    (σ : Q → PhysicalPermutations S J ell)
    (good : PhysicalSmallBigState P J ell X → Prop)
    (bad : Q → PhysicalSmallBigState P J ell X → Prop)
    (output : Q → PhysicalSmallBigState P J ell X → ℂ)
    (hzero : ∀ a s, ¬ bad a s → output a s = 0)
    {δ K : ℝ} (hδ : 0 ≤ δ) (hK : 0 ≤ K)
    (hrare : ∀ s, good s →
      (∑ a, if bad a (physicalSmallBigPermutation (σ a) s) then π a else 0) ≤ δ)
    (f : PhysicalSmallBigState P J ell X → ℂ)
    (henergy : ∀ a, physicalSmallBigEnergy V W (output a) ≤
      K * physicalSmallBigEnergy V W f) :
    physicalSmallBigEnergy V W (fun s => ∑ a, (π a : ℂ) *
      (if good s then output a (physicalSmallBigPermutation (σ a) s) else 0)) ≤
      δ * K * physicalSmallBigEnergy V W f := by
  rw [← physical_small_big_energy_eq, ← physical_small_big_energy_eq]
  refine finite_sparse_average_energy_le π hπ hπmass (physicalSmallBigMeasure V W)
    (physical_small_big_measure_nonneg V hV W hW)
    (fun a s => good s ∧ bad a (physicalSmallBigPermutation (σ a) s)) _ ?_ hδ hK ?_ f ?_
  · intro a s h
    by_cases hs : good s
    · rw [if_pos hs]
      exact hzero a _ (fun hb => h ⟨hs, hb⟩)
    · exact if_neg hs
  · intro s
    by_cases hs : good s
    · simpa only [hs, true_and] using hrare s hs
    · simpa only [hs, false_and, ite_false, sum_const_zero] using hδ
  · intro a
    rw [physical_small_big_energy_eq]
    calc
      _ ≤ physicalSmallBigEnergy V W (fun s => output a (physicalSmallBigPermutation (σ a) s)) := by
        rw [← physical_small_big_energy_eq, ← physical_small_big_energy_eq]
        apply sum_le_sum
        intro s _
        apply mul_le_mul_of_nonneg_left _ (physical_small_big_measure_nonneg V hV W hW s)
        dsimp only
        split_ifs
        · exact le_rfl
        · simpa only [norm_zero, zero_pow (by decide : 2 ≠ 0)] using
            sq_nonneg ‖output a (physicalSmallBigPermutation (σ a) s)‖
      _ = physicalSmallBigEnergy V W (output a) := physical_small_big_permutation_energy V W (σ a) _
      _ ≤ _ := by simpa only [physical_small_big_energy_eq] using henergy a

end Bounty
end

section

/- Uniform small-slot averaging is self-adjoint for the actual mixed
residue-valid measure. Big pending-memory symmetry is retained. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def physicalSmallBigAverage {S X : Type*} [Fintype S] [DecidableEq S]
    {P : S → Finset ℕ} {J ell : ℕ}
    (f : PhysicalSmallBigState P J ell X → ℂ) (s : PhysicalSmallBigState P J ell X) : ℂ :=
  (Fintype.card (PhysicalPermutations S J ell) : ℂ)⁻¹ *
    ∑ σ : PhysicalPermutations S J ell, f (physicalSmallBigPermutation σ s)

theorem physical_small_big_permutation_pairing
    {S X : Type*} [Fintype S] [DecidableEq S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (W : X → ℝ) (σ : PhysicalPermutations S J ell)
    (f g : PhysicalSmallBigState P J ell X → ℂ) :
    (∑ s, (physicalSmallBigMeasure V W s : ℂ) * f s *
      g (physicalSmallBigPermutation σ s)) =
      ∑ s, (physicalSmallBigMeasure V W s : ℂ) *
        f (physicalSmallBigPermutation σ⁻¹ s) * g s := by
  have h := (physicalSmallBigPermutation (P := P) (X := X) σ).sum_comp
    (fun s => (physicalSmallBigMeasure V W s : ℂ) *
      f ((physicalSmallBigPermutation σ).symm s) * g s)
  have hi : (physicalSmallBigPermutation (P := P) (X := X) σ).symm =
      physicalSmallBigPermutation σ⁻¹ := by
    apply Equiv.ext
    intro s
    rfl
  simp only [physical_small_big_permutation_measure, Equiv.symm_apply_apply] at h
  simpa only [hi] using h

theorem physical_small_big_average_pairing
    {S X : Type*} [Fintype S] [DecidableEq S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (W : X → ℝ)
    (f g : PhysicalSmallBigState P J ell X → ℂ) :
    (∑ s, (physicalSmallBigMeasure V W s : ℂ) * f s * physicalSmallBigAverage g s) =
      ∑ s, (physicalSmallBigMeasure V W s : ℂ) * physicalSmallBigAverage f s * g s := by
  calc
    _ = (Fintype.card (PhysicalPermutations S J ell) : ℂ)⁻¹ *
        ∑ σ : PhysicalPermutations S J ell, ∑ s,
          (physicalSmallBigMeasure V W s : ℂ) * f s * g (physicalSmallBigPermutation σ s) := by
      simp only [physicalSmallBigAverage, mul_sum]
      rw [sum_comm]
      apply sum_congr rfl
      intro σ _
      apply sum_congr rfl
      intro s _
      ring
    _ = (Fintype.card (PhysicalPermutations S J ell) : ℂ)⁻¹ *
        ∑ σ : PhysicalPermutations S J ell, ∑ s,
          (physicalSmallBigMeasure V W s : ℂ) * f (physicalSmallBigPermutation σ⁻¹ s) * g s := by
      simp_rw [physical_small_big_permutation_pairing]
    _ = (Fintype.card (PhysicalPermutations S J ell) : ℂ)⁻¹ *
        ∑ σ : PhysicalPermutations S J ell, ∑ s,
          (physicalSmallBigMeasure V W s : ℂ) * f (physicalSmallBigPermutation σ s) * g s := by
      apply congrArg (fun z : ℂ => (Fintype.card (PhysicalPermutations S J ell) : ℂ)⁻¹ * z)
      exact Equiv.sum_comp (Equiv.inv (PhysicalPermutations S J ell))
        (fun σ => ∑ s, (physicalSmallBigMeasure V W s : ℂ) *
          f (physicalSmallBigPermutation σ s) * g s)
    _ = _ := by
      simp only [physicalSmallBigAverage, mul_sum, sum_mul]
      rw [sum_comm]
      apply sum_congr rfl
      intro s _
      apply sum_congr rfl
      intro σ _
      ring

theorem physical_small_big_average_conj
    {S X : Type*} [Fintype S] [DecidableEq S]
    {P : S → Finset ℕ} {J ell : ℕ}
    (f : PhysicalSmallBigState P J ell X → ℂ) (s : PhysicalSmallBigState P J ell X) :
    physicalSmallBigAverage (fun x => (starRingEnd ℂ) (f x)) s =
      (starRingEnd ℂ) (physicalSmallBigAverage f s) := by
  simp only [physicalSmallBigAverage, map_mul, map_inv₀, Complex.conj_natCast, map_sum]

theorem physical_small_big_average_self_adjoint
    {S X : Type*} [Fintype S] [DecidableEq S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (W : X → ℝ)
    (f g : PhysicalSmallBigState P J ell X → ℂ) :
    (∑ s, (physicalSmallBigMeasure V W s : ℂ) * (starRingEnd ℂ) (f s) *
      physicalSmallBigAverage g s) =
      ∑ s, (physicalSmallBigMeasure V W s : ℂ) *
        (starRingEnd ℂ) (physicalSmallBigAverage f s) * g s := by
  simpa only [physical_small_big_average_conj] using
    physical_small_big_average_pairing V W (fun s => (starRingEnd ℂ) (f s)) g

theorem physical_small_big_average_memory_symmetric
    {S G : Type*} [Fintype S] [DecidableEq S] [DecidableEq G]
    {P : S → Finset ℕ} {Pb Z : G → Type*} {J ell B : ℕ} {t : G → ℕ}
    (f : PhysicalSmallBigState P J ell (ProductBoundedOrderedState Pb Z t B) → ℂ)
    (hf : ∀ s, ProductMemorySymmetric (fun x => f (s, x))) :
    ∀ s, ProductMemorySymmetric (fun x => physicalSmallBigAverage f (s, x)) := by
  intro s x g τ
  unfold physicalSmallBigAverage
  apply congrArg (fun z : ℂ => (Fintype.card (PhysicalPermutations S J ell) : ℂ)⁻¹ * z)
  apply sum_congr rfl
  intro σ _
  exact hf (s.1, physicalPermuteLabels σ s.2) x g τ

theorem physical_small_big_average_sandwich_pairing
    {S X : Type*} [Fintype S] [DecidableEq S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (W : X → ℝ)
    (T R : (PhysicalSmallBigState P J ell X → ℂ) → PhysicalSmallBigState P J ell X → ℂ)
    (f g : PhysicalSmallBigState P J ell X → ℂ)
    (hpair : (∑ s, (physicalSmallBigMeasure V W s : ℂ) * physicalSmallBigAverage f s *
        T (physicalSmallBigAverage g) s) =
      ∑ s, (physicalSmallBigMeasure V W s : ℂ) * R (physicalSmallBigAverage f) s *
        physicalSmallBigAverage g s) :
    (∑ s, (physicalSmallBigMeasure V W s : ℂ) * f s *
      physicalSmallBigAverage (T (physicalSmallBigAverage g)) s) =
      ∑ s, (physicalSmallBigMeasure V W s : ℂ) *
        physicalSmallBigAverage (R (physicalSmallBigAverage f)) s * g s := by
  rw [physical_small_big_average_pairing]
  exact hpair.trans (physical_small_big_average_pairing V W _ g)

end Bounty
end

section

/- Exact transposition through the original small conditioning map.
The underlying measure remains the residue-valid small-state measure. -/

open Finset Classical

namespace Bounty

theorem physical_small_big_condition_conj
    {S X : Type*} [Fintype S] [DecidableEq S]
    {P : S → Finset ℕ} {J ell : ℕ} (V : S → ℝ) (q : ℝ)
    (F : PhysicalSmallBigState P J ell X → ℂ)
    (d : PhysicalSharedLists P J) (x : X) (r : PhysicalResidues P) :
    physicalSmallBigCondition V q (fun s => (starRingEnd ℂ) (F s)) d x r =
      (starRingEnd ℂ) (physicalSmallBigCondition V q F d x r) := by
  simp only [physicalSmallBigCondition, physicalSmallCondition, map_mul, map_sum,
    Complex.conj_ofReal]

theorem physical_small_big_bilinear_pairing
    {S X : Type*} [Fintype S] [DecidableEq S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (hV : ∀ s, 0 < V s) (q ζ : ℝ) (W : X → ℝ)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (κ : PhysicalSharedLists P J → ℂ)
    (E : PhysicalSharedLists P J → X → Type*) [∀ d x, Fintype (E d x)]
    (target : ∀ d x, E d x → X)
    (a : PhysicalResidues P → ∀ d x, E d x → ℂ) (k : X → ℤ)
    (u F : PhysicalSmallBigState P J ell X → ℂ) :
    (∑ s, (physicalSmallBigMeasure V W s : ℂ) * u s *
      physicalSmallBigAction V q ζ aux κ E target a k F s) =
      ∑ d, ∑ r, ∑ x, (W x : ℂ) * physicalSmallBigCondition V q u d x r *
        (κ d * physicalPhase ζ (physicalSharedProduct d) *
          physicalSmallBigPrefixAction E target a k (physicalSmallBigCondition V q F) d x r) := by
  have h := physical_small_big_pairing V hV q ζ W aux κ E target a k
    (fun s => (starRingEnd ℂ) (u s)) F
  simpa only [physical_small_big_condition_conj, Complex.conj_conj] using h

/-- A prefix transpose lifts exactly to the mixed measure. This statement is
algebraic: its premise is an equality of the specified two prefix actions. -/
theorem physical_small_big_transpose_of_prefix_pairing
    {S X : Type*} [Fintype S] [DecidableEq S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (hV : ∀ s, 0 < V s) (q : ℝ) (W : X → ℝ)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (E R : PhysicalSharedLists P J → X → Type*)
    [∀ d x, Fintype (E d x)] [∀ d x, Fintype (R d x)]
    (target : ∀ d x, E d x → X) (back : ∀ d x, R d x → X)
    (a : PhysicalResidues P → ∀ d x, E d x → ℂ)
    (b : PhysicalResidues P → ∀ d x, R d x → ℂ) (k l : X → ℤ)
    (u F : PhysicalSmallBigState P J ell X → ℂ)
    (hprefix : ∀ d,
      (∑ r, ∑ x, (W x : ℂ) * physicalSmallBigCondition V q u d x r *
        physicalSmallBigPrefixAction E target a k (physicalSmallBigCondition V q F) d x r) =
      ∑ r, ∑ x, (W x : ℂ) *
        physicalSmallBigPrefixAction R back b l (physicalSmallBigCondition V q u) d x r *
          physicalSmallBigCondition V q F d x r) :
    (∑ s, (physicalSmallBigMeasure V W s : ℂ) * u s *
      physicalSmallBigAction V q 0 aux (fun _ => 1) E target a k F s) =
      ∑ s, (physicalSmallBigMeasure V W s : ℂ) *
        physicalSmallBigAction V q 0 aux (fun _ => 1) R back b l u s * F s := by
  have hf := physical_small_big_bilinear_pairing V hV q 0 W aux (fun _ => 1)
    E target a k u F
  have hb := physical_small_big_bilinear_pairing V hV q 0 W aux (fun _ => 1)
    R back b l F u
  have hz (d : PhysicalSharedLists P J) : physicalPhase 0 (physicalSharedProduct d) = 1 := by
    simp [physicalPhase]
  simp only [hz, mul_one, one_mul] at hf hb
  rw [hf]
  calc
    _ = ∑ d, ∑ r, ∑ x, (W x : ℂ) *
        physicalSmallBigPrefixAction R back b l (physicalSmallBigCondition V q u) d x r *
          physicalSmallBigCondition V q F d x r := by
      apply sum_congr rfl
      intro d hd
      exact hprefix d
    _ = _ := by
      simpa only [mul_assoc, mul_comm, mul_left_comm] using hb.symm

end Bounty
end

section

/- Absorb the genuine small-conditioning cost and big-memory energy cost
into a fixed polynomial before choosing the omission parameter J. These are
scalar bounds only; no identity for a physical operator is asserted. -/

open Finset Filter
open scoped Topology

namespace Bounty

theorem mixed_conditioning_cost_le (small big : ℕ) {L aSmall aBig A₀ K : ℝ}
    (hL : 0 < L) (hA₀ : 0 ≤ A₀) (hK : 0 ≤ K)
    (hsmall : (small : ℝ) ≤ aSmall * Real.log L)
    (hbig : (big : ℝ) ≤ aBig * Real.log L) :
    A₀ ^ small * Real.sqrt (K ^ big) ≤
      L ^ (aSmall * Real.log (max 1 A₀) + (aBig / 2) * Real.log (max 1 K)) := by
  have hs := repeated_big_group_energy_cost_le small hL hA₀ hsmall
  have hb := Real.sqrt_le_sqrt (repeated_big_group_energy_cost_le big hL hK hbig)
  have he : Real.sqrt (L ^ (aBig * Real.log (max 1 K))) =
      L ^ ((aBig / 2) * Real.log (max 1 K)) := by
    rw [Real.sqrt_eq_rpow, ← Real.rpow_mul hL.le]
    congr 1
    ring
  rw [he] at hb
  calc
    _ ≤ L ^ (aSmall * Real.log (max 1 A₀)) *
        L ^ ((aBig / 2) * Real.log (max 1 K)) :=
      mul_le_mul hs hb (Real.sqrt_nonneg _) (Real.rpow_nonneg hL.le _)
    _ = _ := (Real.rpow_add hL _ _).symm

noncomputable def candidateMixedRareCostExponent (A₀ K : ℝ) : ℝ :=
  (2 / (5 * Real.log 2)) * Real.log (max 1 A₀) +
    ((2 / (5 * Real.log 2)) / 2) * Real.log (max 1 K)

theorem eventually_candidate_mixed_conditioning_cost_le {s : ℝ} (hs : 0 < s) :
    ∀ᶠ L : ℝ in atTop, ∀ A₀ K : ℝ, 0 ≤ A₀ → 0 ≤ K →
      A₀ ^ (candidateSmallPIndices s L).card *
        Real.sqrt (K ^ (candidateBigPIndices s L).card) ≤
          L ^ candidateMixedRareCostExponent A₀ K := by
  obtain ⟨v, V, _, _, hpool⟩ := exists_candidate_P_pool_bounds hs
  filter_upwards [hpool] with L hp
  intro A₀ K hA₀ hK
  have hsmall : (candidateSmallPIndices s L).card ≤ (candidatePIndices s L).card :=
    card_le_card (show candidateSmallPIndices s L ⊆ candidatePIndices s L from subset_union_left)
  have hbig : (candidateBigPIndices s L).card ≤ (candidatePIndices s L).card :=
    card_le_card (show candidateBigPIndices s L ⊆ candidatePIndices s L from subset_union_right)
  apply mixed_conditioning_cost_le _ _ (zero_lt_one.trans_le hp.1) hA₀ hK
  · exact (by exact_mod_cast hsmall : ((candidateSmallPIndices s L).card : ℝ) ≤
      ((candidatePIndices s L).card : ℝ)).trans hp.2.2.2.1
  · exact (by exact_mod_cast hbig : ((candidateBigPIndices s L).card : ℝ) ≤
      ((candidatePIndices s L).card : ℝ)).trans hp.2.2.2.1

theorem exists_candidate_mixed_rare_parameter {s : ℝ} (hs : 0 < s)
    (ell : ℕ) (hell : 0 < ell) (J₀ : ℕ) (A₀ K A E : ℝ)
    (hA₀ : 0 ≤ A₀) (hK : 0 ≤ K) :
    ∃ J : ℕ, J₀ ≤ J ∧
      ((1 / (20 * Real.log 2)) / 2) * Real.log (((J + ell).choose ell : ℕ) : ℝ) >
        A + candidateMixedRareCostExponent A₀ K + E + 3 ∧
      ∀ᶠ L : ℝ in atTop,
        let cost := 2 * L ^ A *
          (A₀ ^ (candidateSmallPIndices s L).card * Real.sqrt (K ^ (candidateBigPIndices s L).card)) *
          Real.sqrt ((⌈L ^ 2⌉₊ : ℝ) /
            (((J + ell).choose ell) ^ (candidateSmallPIndices s L).card : ℕ))
        cost ≤ (1 / 2 : ℝ) * L ^ (-E) ∧ L ^ (-(E + 1)) + cost ≤ L ^ (-E) := by
  obtain ⟨J, hJ, hgain, hrare⟩ := exists_candidate_rare_transfer_parameter hs ell hell J₀
    (A + candidateMixedRareCostExponent A₀ K) E
  refine ⟨J, hJ, hgain, ?_⟩
  filter_upwards [hrare, eventually_candidate_mixed_conditioning_cost_le hs,
    eventually_ge_atTop (2 : ℝ)] with L hr hc hL
  dsimp only
  have hL0 : 0 < L := by linarith
  have hcost : 2 * L ^ A *
      (A₀ ^ (candidateSmallPIndices s L).card * Real.sqrt (K ^ (candidateBigPIndices s L).card)) *
      Real.sqrt ((⌈L ^ 2⌉₊ : ℝ) /
        (((J + ell).choose ell) ^ (candidateSmallPIndices s L).card : ℕ)) ≤
      (1 / 2 : ℝ) * L ^ (-E) := by
    calc
      _ ≤ 2 * L ^ A * L ^ candidateMixedRareCostExponent A₀ K *
          Real.sqrt ((⌈L ^ 2⌉₊ : ℝ) /
            (((J + ell).choose ell) ^ (candidateSmallPIndices s L).card : ℕ)) :=
        mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_left (hc A₀ K hA₀ hK) (by positivity)) (Real.sqrt_nonneg _)
      _ = 2 * L ^ (A + candidateMixedRareCostExponent A₀ K) *
          Real.sqrt ((⌈L ^ 2⌉₊ : ℝ) /
            (((J + ell).choose ell) ^ (candidateSmallPIndices s L).card : ℕ)) := by
        rw [Real.rpow_add hL0]
        ring
      _ ≤ _ := hr
  refine ⟨hcost, ?_⟩
  have hclean := rpow_next_saving_le_half E L hL
  linarith

end Bounty
end

section

/- The actual small and big candidate pools used by the mixed-state
energy bounds. Their residue moduli are nonzero because all labels are prime. -/

namespace Bounty

abbrev CandidateSmallGroup (scale L : ℝ) := ↥(candidateSmallPIndices scale L)

noncomputable abbrev candidateSmallPool (scale L : ℝ) (g : CandidateSmallGroup scale L) : Finset ℕ :=
  candidatePBand (scale * L) g.val

theorem candidateSmallPrimeNeZero (scale L : ℝ) :
    ∀ p : PhysicalPrime (candidateSmallPool scale L), NeZero p.2.val :=
  fun p => ⟨((mem_dyadicPrimeBand_iff (scale * L) (3/2) (9/5) p.1.val p.2.val).mp
    p.2.property).1.ne_zero⟩

end Bounty
end

section

/- Exact small conditioning with two endpoint gates. Only the residual
coefficient is a function of the small prefix; endpoint gates may depend on
the complete small source or target. No norm bound is used. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def physicalSmallBigEndpointPhase {S X : Type*} [Fintype S]
    {P : S → Finset ℕ} {J ell : ℕ}
    (E : PhysicalSharedLists P J → X → Type*)
    (target : ∀ d x, E d x → X)
    (Ψ : PhysicalResidues P → ∀ d x, E d x → ℂ) (k : X → ℤ)
    (sourceGate targetGate : PhysicalSmallBigState P J ell X → ℂ)
    (s : PhysicalSmallBigState P J ell X) (e : PhysicalSmallBigEvent E s) : ℂ :=
  (starRingEnd ℂ) (sourceGate s) * Ψ s.1.1 (physicalSharedPrefix s.1.2) s.2 e.2 *
    targetGate (physicalSmallBigTarget E target k s e)

theorem physical_small_big_phased_endpoint_gates {S X : Type*} [Fintype S]
    {P : S → Finset ℕ} {J ell : ℕ} (V : S → ℝ) (q : ℝ)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (E : PhysicalSharedLists P J → X → Type*) [∀ d x, Fintype (E d x)]
    (target : ∀ d x, E d x → X)
    (a : PhysicalResidues P → ∀ d x, E d x → ℝ)
    (Ψ : PhysicalResidues P → ∀ d x, E d x → ℂ) (k : X → ℤ)
    (sourceGate targetGate F : PhysicalSmallBigState P J ell X → ℂ)
    (s : PhysicalSmallBigState P J ell X) :
    physicalSmallBigPhasedAction V q E target a k
      (physicalSmallBigEndpointPhase E target Ψ k sourceGate targetGate) F s =
      (starRingEnd ℂ) (sourceGate s) *
        physicalSmallBigAction V q 0 aux (fun _ => 1) E target
          (fun r d x e => (a r d x e : ℂ) * Ψ r d x e) k
          (fun t => targetGate t * F t) s := by
  simp only [physicalSmallBigPhasedAction, physicalSmallBigAction, mul_sum,
    physical_small_big_event_weight_phase, physicalSmallBigEndpointPhase,
    physicalPhase, zero_mul, Complex.ofReal_zero, Complex.exp_zero, one_mul]
  apply sum_congr rfl
  intro e _
  ring

theorem physical_small_big_gated_pairing
    {S X : Type*} [Fintype S] [dS : DecidableEq S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (hV : ∀ s, 0 < V s) (q : ℝ) (W : X → ℝ)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (E : PhysicalSharedLists P J → X → Type*) [∀ d x, Fintype (E d x)]
    (target : ∀ d x, E d x → X)
    (a : PhysicalResidues P → ∀ d x, E d x → ℝ)
    (Ψ : PhysicalResidues P → ∀ d x, E d x → ℂ) (k : X → ℤ)
    (sourceGate targetGate u F : PhysicalSmallBigState P J ell X → ℂ) :
    (∑ s, (physicalSmallBigMeasure V W s : ℂ) * (starRingEnd ℂ) (u s) *
      physicalSmallBigPhasedAction V q E target a k
        (physicalSmallBigEndpointPhase E target Ψ k sourceGate targetGate) F s) =
      ∑ d, ∑ r, ∑ x, (W x : ℂ) *
        (starRingEnd ℂ) (physicalSmallBigCondition V q (fun s => sourceGate s * u s) d x r) *
        physicalSmallBigPrefixAction E target (fun r d x e => (a r d x e : ℂ) * Ψ r d x e) k
          (physicalSmallBigCondition V q (fun s => targetGate s * F s)) d x r := by
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  calc
    _ = ∑ s, (physicalSmallBigMeasure V W s : ℂ) *
        (starRingEnd ℂ) (sourceGate s * u s) *
        physicalSmallBigAction V q 0 aux (fun _ => 1) E target
          (fun r d x e => (a r d x e : ℂ) * Ψ r d x e) k (fun t => targetGate t * F t) s := by
      apply sum_congr rfl
      intro s _
      rw [physical_small_big_phased_endpoint_gates V q aux]
      simp only [map_mul]
      ring
    _ = _ := by
      have h := physical_small_big_pairing V hV q 0 W aux (fun _ => 1) E target
        (fun r d x e => (a r d x e : ℂ) * Ψ r d x e) k
        (fun s => sourceGate s * u s) (fun s => targetGate s * F s)
      simp only [physicalPhase, zero_mul, Complex.ofReal_zero, Complex.exp_zero, one_mul] at h
      convert h using 1
      congr 3

end Bounty
end

section

/- Exact per-list energy bounds for the pool-invariant convolution on positive positions. -/

open Finset

namespace Bounty

theorem invariant_triple_endpoint_int_divisible_energy (Q : Finset ℕ) (α β γ : ℕ → ℂ)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (S : Finset ℤ) (d N : ℕ) (hd : d ∈ Nat.factoredNumbers Q)
    (hdiv : ∀ n ∈ S, d ∣ n.natAbs)
    (hS : ∀ n ∈ S, 0 ≤ n ∧ n ≤ (N : ℤ)) :
    (∑ n ∈ S, ‖invariantTripleEndpoint Q α β γ n.natAbs‖ ^ 2) ≤
      (A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15 / d := by
  classical
  have hinj : Set.InjOn Int.natAbs S := by
    intro a ha b hb hab
    have hab' := congrArg (fun n : ℕ => (n : ℤ)) hab
    simpa only [Int.natAbs_of_nonneg (hS a ha).1,
      Int.natAbs_of_nonneg (hS b hb).1] using hab'
  calc
    _ = ∑ n ∈ S.image Int.natAbs, ‖invariantTripleEndpoint Q α β γ n‖ ^ 2 := by
      rw [sum_image]
      exact fun a ha b hb hab => hinj ha hb hab
    _ ≤ _ := invariant_triple_endpoint_divisible_energy Q α β γ hA hB hC hα hβ hγ
      (S.image Int.natAbs) d N hd
      (by
        intro m hm
        obtain ⟨n, hn, rfl⟩ := mem_image.mp hm
        exact hdiv n hn)
      (by
        intro m hm
        obtain ⟨n, hn, rfl⟩ := mem_image.mp hm
        have ht : (n.natAbs : ℤ) ≤ N := by
          rw [Int.natAbs_of_nonneg (hS n hn).1]
          exact (hS n hn).2
        exact_mod_cast ht)

theorem invariant_triple_endpoint_list_energy {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime) (Q : Finset ℕ) (hQ : ∀ g, P g ⊆ Q)
    (α β γ : ℕ → ℂ) {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (S : Finset ℤ) (N : ℕ) (hS : ∀ n ∈ S, 0 ≤ n ∧ n ≤ (N : ℤ))
    {J ell : ℕ} (L : PhysicalMarkLists P J ell) :
    (∑ n ∈ S, if ∀ g s, ((L g s).val : ℤ) ∣ n
      then ‖invariantTripleEndpoint Q α β γ n.natAbs‖ ^ 2 else 0) ≤
      ((A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15) *
        ∏ g, ∏ s, 1 / ((L g s).val : ℝ) := by
  classical
  rw [← sum_filter]
  have h := invariant_triple_endpoint_int_divisible_energy Q α β γ hA hB hC hα hβ hγ
    (S.filter (fun n => ∀ g s, ((L g s).val : ℤ) ∣ n)) (physicalMarkProduct L) N
    (physical_mark_product_supported hprime Q hQ L)
    (by intro n hn; exact (physical_mark_product_dvd_iff hP hprime L n).mpr (mem_filter.mp hn).2)
    (by intro n hn; exact hS n (mem_filter.mp hn).1)
  rw [div_eq_mul_one_div, physical_mark_product_inverse L] at h
  exact h

end Bounty
end

section

/- The original small-residue normalization is one global scalar. It
multiplies the whole mixed-state measure, rather than each transition. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def physicalSmallBigNormalizedMeasure
    {S X : Type*} [Fintype S] [dS : DecidableEq S]
    {P : S → Finset ℕ} {J ell : ℕ}
    (V : S → ℝ) (W : X → ℝ) (s : PhysicalSmallBigState P J ell X) : ℝ :=
  physicalResidueInitialMass V s.1 * W s.2

theorem physical_small_residue_factor_pos
    {S : Type*} [Fintype S] {P : S → Finset ℕ}
    [∀ p : PhysicalPrime P, NeZero p.2.val] :
    0 < ∏ p : PhysicalPrime P, (1 : ℝ) / p.2.val := by
  apply prod_pos
  intro p _
  exact one_div_pos.mpr (by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne p.2.val))

theorem physical_small_big_normalized_measure_eq
    {S X : Type*} [Fintype S] [dS : DecidableEq S]
    {P : S → Finset ℕ} {J ell : ℕ}
    (V : S → ℝ) (W : X → ℝ) (s : PhysicalSmallBigState P J ell X) :
    physicalSmallBigNormalizedMeasure V W s =
      (∏ p : PhysicalPrime P, (1 : ℝ) / p.2.val) * physicalSmallBigMeasure V W s := by
  unfold physicalSmallBigNormalizedMeasure physicalSmallBigMeasure
  by_cases h : physicalResidueMarksValid s.1.1 s.1.2
  · rw [if_pos h, physical_residue_initial_mass_of_valid V s.1.1 s.1.2 h]
    ring
  · rw [if_neg h, physical_residue_initial_mass_zero V s.1 h]
    ring

theorem physical_small_big_normalized_energy_eq
    {S X : Type*} [Fintype S] [dS : DecidableEq S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (W : X → ℝ) (F : PhysicalSmallBigState P J ell X → ℂ) :
    finiteWeightedEnergy (physicalSmallBigNormalizedMeasure V W) F =
      (∏ p : PhysicalPrime P, (1 : ℝ) / p.2.val) * physicalSmallBigEnergy V W F := by
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  rw [← physical_small_big_energy_eq]
  simp only [finiteWeightedEnergy, physical_small_big_normalized_measure_eq,
    mul_assoc, mul_sum]
  congr 3

theorem physical_small_big_normalized_pairing_eq
    {S X : Type*} [Fintype S] [dS : DecidableEq S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (W : X → ℝ) (u F : PhysicalSmallBigState P J ell X → ℂ) :
    (∑ s, (physicalSmallBigNormalizedMeasure V W s : ℂ) *
      (starRingEnd ℂ) (u s) * F s) =
      (((∏ p : PhysicalPrime P, (1 : ℝ) / p.2.val) : ℝ) : ℂ) *
        ∑ s, (physicalSmallBigMeasure V W s : ℂ) * (starRingEnd ℂ) (u s) * F s := by
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  simp only [physical_small_big_normalized_measure_eq, Complex.ofReal_mul,
    mul_assoc, mul_sum]

theorem physical_small_big_normalized_norm_eq
    {S X : Type*} [Fintype S] [dS : DecidableEq S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (W : X → ℝ) (F : PhysicalSmallBigState P J ell X → ℂ) :
    cleanActiveNorm (physicalSmallBigNormalizedMeasure V W) F =
      Real.sqrt (∏ p : PhysicalPrime P, (1 : ℝ) / p.2.val) *
        cleanActiveNorm (physicalSmallBigMeasure V W) F := by
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  change Real.sqrt (finiteWeightedEnergy (physicalSmallBigNormalizedMeasure V W) F) = _
  rw [physical_small_big_normalized_energy_eq,
    Real.sqrt_mul (physical_small_residue_factor_pos (P := P)).le,
    physical_small_big_sqrt_energy_eq_norm]
  congr 3

theorem physical_small_big_normalized_energy_le_iff
    {S X : Type*} [Fintype S] [dS : DecidableEq S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (W : X → ℝ) (F output : PhysicalSmallBigState P J ell X → ℂ)
    (K : ℝ) :
    finiteWeightedEnergy (physicalSmallBigNormalizedMeasure V W) output ≤
        K * finiteWeightedEnergy (physicalSmallBigNormalizedMeasure V W) F ↔
      physicalSmallBigEnergy V W output ≤ K * physicalSmallBigEnergy V W F := by
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  rw [physical_small_big_normalized_energy_eq, physical_small_big_normalized_energy_eq,
    mul_left_comm K]
  exact mul_le_mul_iff_right₀ (physical_small_residue_factor_pos (P := P))

theorem physical_small_big_normalized_measure_total
    {S X : Type*} [Fintype S] [dS : DecidableEq S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (W : X → ℝ) :
    (∑ s : PhysicalSmallBigState P J ell X, physicalSmallBigNormalizedMeasure V W s) =
      (∑ s : PhysicalBareResidueState P J ell, physicalResidueInitialMass V s) *
        ∑ x, W x := by
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  simp only [physicalSmallBigNormalizedMeasure, Fintype.sum_prod_type]
  rw [sum_mul]
  apply sum_congr rfl
  intro r _
  rw [sum_mul]
  apply sum_congr rfl
  intro L _
  rw [mul_sum]

theorem physical_small_big_normalized_measure_subprobability
    {S X : Type*} [Fintype S] [dS : DecidableEq S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (hV : ∀ s, 0 < V s)
    (hMass : ∀ s, ∑ p ∈ P s, 1 / (p : ℝ) = V s)
    (W : X → ℝ) (hW : ∀ x, 0 ≤ W x) (hWsum : ∑ x, W x ≤ 1) :
    (∑ s : PhysicalSmallBigState P J ell X, physicalSmallBigNormalizedMeasure V W s) ≤ 1 := by
  rw [physical_small_big_normalized_measure_total]
  calc
    _ ≤ 1 * ∑ x, W x := mul_le_mul_of_nonneg_right
      (physical_residue_initial_mass_total V hV hMass) (sum_nonneg (fun x _ => hW x))
    _ ≤ 1 := by simpa only [one_mul] using hWsum

end Bounty
end

section

/- Ghost visits on the genuine mixed state keep its small coordinate fixed.
Their literal event sum, pending symmetry, and energy bounds use the original
small measure and the product-factorial big memory law. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def physicalSmallBigGhostAction
    {S G : Type*} [Fintype G] {Ps : S → Finset ℕ}
    {P Z : G → Type*} [∀ g, Fintype (Z g)] {J ell : ℕ}
    (A D C ν : ∀ g, Z g → ℝ) (M : G → ℕ) (B : ℕ)
    (phase : ∀ s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B),
      CoupledGhostEvent M B s.2 → ℂ)
    (F : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ)
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B)) : ℂ :=
  coupledGhostCutoffOperator A D C ν M B (fun x e => phase (s.1, x) e)
    (fun x => F (s.1, x)) s.2

theorem physical_small_big_ghost_eq_event_sum
    {S G : Type*} [Fintype G] {Ps : S → Finset ℕ}
    {P Z : G → Type*} [∀ g, Fintype (Z g)] {J ell : ℕ}
    (A D C ν : ∀ g, Z g → ℝ) (M : G → ℕ) (B : ℕ)
    (phase : ∀ s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B),
      CoupledGhostEvent M B s.2 → ℂ)
    (F : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ)
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B)) :
    physicalSmallBigGhostAction A D C ν M B phase F s =
      ∑ e : CoupledGhostEvent M B s.2,
        (coupledGhostJointEventWeight A D C ν M B s.2 e : ℂ) * phase s e *
          F (s.1, coupledGhostJointEventTarget M B s.2 e) :=
  coupled_ghost_cutoff_eq_joint_event_sum A D C ν M B _ _ s.2

theorem physical_small_big_ghost_one_memory_symmetric
    {S G : Type*} [Fintype G] [DecidableEq G] {Ps : S → Finset ℕ}
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    [∀ g, DecidableEq (Z g)] {J ell : ℕ}
    (A D C ν : ∀ g, Z g → ℝ) (M : G → ℕ) (B : ℕ)
    (F : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ)
    (hF : ∀ s, ProductMemorySymmetric (fun x => F (s, x))) :
    ∀ s, ProductMemorySymmetric (fun x =>
      physicalSmallBigGhostAction A D C ν M B (fun _ _ => 1) F (s, x)) := by
  intro s
  exact coupled_ghost_cutoff_one_symmetric A D C ν M B (fun x => F (s, x)) (hF s)

theorem physical_small_big_ghost_energy_le
    {S G : Type*} [Fintype S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} [∀ p : PhysicalPrime Ps, NeZero p.2.val]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    [∀ g, DecidableEq (Z g)] {J ell : ℕ}
    (Vs : S → ℝ) (hVs : ∀ s, 0 < Vs s) (μ : ∀ g, P g → ℝ)
    (A D C ν v : ∀ g, Z g → ℝ) (M : G → ℕ) (B : ℕ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hA : ∀ g z, 0 ≤ A g z)
    (hν : ∀ g z, 0 < ν g z) (hv : ∀ g z, 0 < v g z)
    (hD : ∀ g z, A g z + |D g z| / v g z ≤ 1)
    (hC : ∀ g z, A g z + |C g z| / v g z ≤ 1)
    (phase : ∀ s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B),
      CoupledGhostEvent M B s.2 → ℂ)
    (hphase : ∀ s e, ‖phase s e‖ ≤ 1)
    (F : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ)
    (hF : ∀ s, ProductMemorySymmetric (fun x => F (s, x))) :
    physicalSmallBigEnergy Vs (productMemoryWeight μ ν)
      (physicalSmallBigGhostAction A D C ν M B phase F) ≤
      (∏ g, Real.exp (∑ z, (|C g z| + |D g z|) * ν g z * v g z)) *
        physicalSmallBigEnergy Vs (productMemoryWeight μ ν) F := by
  apply physical_small_big_fiber_energy_le Vs hVs _ F _ _
  intro s
  exact coupled_ghost_cutoff_energy_le μ A D C ν v M B hμ hA hν hv hD hC
    (fun x e => phase (s, x) e) (fun x e => hphase (s, x) e) (fun x => F (s, x)) (hF s)

theorem physical_small_big_absolute_ghost_energy_le_uniform
    {S G : Type*} [Fintype S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} [∀ p : PhysicalPrime Ps, NeZero p.2.val]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] {J ell : ℕ}
    (Vs : S → ℝ) (hVs : ∀ s, 0 < Vs s) (μ : ∀ g, P g → ℝ)
    (q ρ : ℝ) (V : G → ℝ) (v vmax : ℝ) (M : G → ℕ) (B : ℕ)
    (hμ : ∀ g p, 0 < μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (hρ : 0 < ρ)
    (hV : ∀ g, 0 ≤ V g) (hVmax : ∀ g, V g ≤ vmax) (hv : 0 < v)
    (hD : q / ρ ^ 2 + ((1 - q) / ρ) / v ≤ 1)
    (hC : ∀ g, q / ρ ^ 2 + ((1 - q) * V g / ρ) / v ≤ 1)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (hF : ∀ s, ProductMemorySymmetric (fun x => F (s, x))) :
    physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (physicalSmallBigGhostAction (fun g => physicalGhostRetention (n g) q ρ)
        (fun g z => |physicalGhostTermination (n g) q ρ z|)
        (fun g z => |physicalGhostBirth (n g) q ρ (V g) z|)
        (fun g => unrestrictedResidueWeight (μ g)) M B (fun _ _ => 1) F) ≤
      physicalGhostUniformEnergyBound ρ vmax v ^ Fintype.card G *
        physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) F := by
  apply physical_small_big_fiber_energy_le Vs hVs _ F _ _
  intro s
  have he : (fun x => physicalSmallBigGhostAction (fun g => physicalGhostRetention (n g) q ρ)
      (fun g z => |physicalGhostTermination (n g) q ρ z|)
      (fun g z => |physicalGhostBirth (n g) q ρ (V g) z|)
      (fun g => unrestrictedResidueWeight (μ g)) M B (fun _ _ => 1) F (s, x)) =
      physicalAbsoluteGhostCutoffProductOperator n μ q ρ V M B univ (fun x => F (s, x)) := by
    exact coupled_ghost_cutoff_one_eq_coordinate_action _ _ _ _ M B (fun x => F (s, x))
  rw [he]
  simpa only [card_univ] using physical_ghost_absolute_cutoff_product_energy_le n μ q ρ V v vmax M B
    hμ hmass hq0 hq1 hρ hV hVmax hv hD hC univ (fun x => F (s, x)) (hF s)

end Bounty
end

section

/- Exact finite Cauchy expansion for the two shifted product equations. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

noncomputable def typeIIEquationTerm (α aH : ℕ → ℂ) (e n : ℕ) (v : ℕ × ℕ) : ℂ :=
  if v.1 * n = 2 * e * v.2 + 1 then α v.1 * aH v.2 else 0

noncomputable def typeIIInnerSum (M H : Finset ℕ) (α aH : ℕ → ℂ) (e n : ℕ) : ℂ :=
  ∑ v ∈ M ×ˢ H, typeIIEquationTerm α aH e n v

theorem typeII_equation_same_m {e n m h h' : ℕ} (he : 0 < e)
    (hh : m*n=2*e*h+1) (hh' : m*n=2*e*h'+1) : h=h' := by
  have hmul : (2*e)*h=(2*e)*h' := by omega
  exact Nat.eq_of_mul_eq_mul_left (by omega : 0<2*e) hmul

theorem typeII_equation_term_same_first {e n : ℕ} (he : 0<e)
    (α aH : ℕ → ℂ) {v w : ℕ × ℕ} (hm : v.1=w.1) (hne : v≠w) :
    typeIIEquationTerm α aH e n v * conj (typeIIEquationTerm α aH e n w) = 0 := by
  unfold typeIIEquationTerm
  split_ifs with hv hw
  · exfalso
    apply hne
    apply Prod.ext hm
    exact typeII_equation_same_m he hv (hm ▸ hw)
  · simp
  · simp
  · simp

theorem complex_finite_sum_norm_sq {ι : Type*} (S : Finset ι) (f : ι → ℂ) :
    ‖∑ i ∈ S, f i‖^2 = ∑ i ∈ S, ∑ j ∈ S, (f i * conj (f j)).re := by
  have h : ((‖∑ i ∈ S, f i‖^2 : ℝ) : ℂ) =
      (∑ i ∈ S, f i) * conj (∑ i ∈ S, f i) := by
    rw [← Complex.normSq_eq_norm_sq, Complex.normSq_eq_conj_mul_self, mul_comm]
  have hr := congrArg Complex.re h
  simp only [Complex.ofReal_re, map_sum, sum_mul, mul_sum, Complex.re_sum] at hr
  exact hr.trans (sum_comm)

theorem typeII_inner_norm_sq_split (M H : Finset ℕ) (α aH : ℕ → ℂ)
    {e n : ℕ} (he : 0<e) :
    ‖typeIIInnerSum M H α aH e n‖^2 =
      (∑ v ∈ M ×ˢ H, ‖typeIIEquationTerm α aH e n v‖^2) +
      ∑ v ∈ M ×ˢ H, ∑ w ∈ (M ×ˢ H).filter (fun w => v.1≠w.1),
        (typeIIEquationTerm α aH e n v * conj (typeIIEquationTerm α aH e n w)).re := by
  classical
  unfold typeIIInnerSum
  rw [complex_finite_sum_norm_sq, ← sum_add_distrib]
  apply sum_congr rfl
  intro v hv
  have hdiag :
      (∑ w ∈ (M ×ˢ H).filter (fun w => v.1=w.1),
        (typeIIEquationTerm α aH e n v * conj (typeIIEquationTerm α aH e n w)).re) =
      ‖typeIIEquationTerm α aH e n v‖^2 := by
    rw [sum_eq_single v]
    · have h := congrArg Complex.re
        (Complex.normSq_eq_conj_mul_self (z := typeIIEquationTerm α aH e n v))
      simpa only [Complex.ofReal_re, Complex.normSq_eq_norm_sq, mul_comm] using h.symm
    · intro w hw hwv
      rw [typeII_equation_term_same_first he α aH (mem_filter.mp hw).2 (Ne.symm hwv)]
      rfl
    · exact fun h => (h (mem_filter.mpr ⟨hv,rfl⟩)).elim
  rw [← hdiag]
  exact (sum_filter_add_sum_filter_not (M ×ˢ H) (fun w => v.1=w.1) _).symm

theorem finite_complex_cauchy (S : Finset (ℕ × ℕ)) (a b : ℕ × ℕ → ℂ) :
    ‖∑ v ∈ S, a v*b v‖^2 ≤ (∑ v ∈ S, ‖a v‖^2)*(∑ v ∈ S, ‖b v‖^2) := by
  have ht : ‖∑ v ∈ S, a v*b v‖ ≤ ∑ v ∈ S, ‖a v‖*‖b v‖ := by
    simpa only [norm_mul] using norm_sum_le S (fun v => a v*b v)
  exact (pow_le_pow_left₀ (norm_nonneg _) ht 2).trans
    (sum_mul_sq_le_sq_mul_sq S (fun v => ‖a v‖) (fun v => ‖b v‖))

theorem typeII_cauchy_majorant (E N M H : Finset ℕ) (aE β α aH : ℕ → ℂ)
    (η : ℕ → ℕ → ℝ) (hη : ∀ e∈E, ∀ n∈N, 1≤η e n) :
    ‖∑ e∈E, ∑ n∈N, aE e*β n*typeIIInnerSum M H α aH e n‖^2 ≤
      ((∑ e∈E, ‖aE e‖^2)*(∑ n∈N, ‖β n‖^2))*
        ∑ e∈E, ∑ n∈N, η e n*‖typeIIInnerSum M H α aH e n‖^2 := by
  have h := finite_complex_cauchy (E ×ˢ N) (fun v => aE v.1*β v.2)
    (fun v => typeIIInnerSum M H α aH v.1 v.2)
  simp only [sum_product, norm_mul, mul_pow] at h
  have hfactor : (∑ e∈E, ∑ n∈N, ‖aE e‖^2*‖β n‖^2) =
      (∑ e∈E, ‖aE e‖^2)*(∑ n∈N, ‖β n‖^2) := by
    rw [sum_mul]
    simp only [mul_sum]
  rw [hfactor] at h
  apply h.trans
  apply mul_le_mul_of_nonneg_left _ (by positivity)
  apply sum_le_sum
  intro e he
  apply sum_le_sum
  intro n hn
  exact le_mul_of_one_le_left (sq_nonneg _) (hη e he n hn)

end Bounty
end

section

/- Positive actual candidate allocation branches have a fixed logarithmic size loss. -/

open Finset Real

namespace Bounty

theorem candidate_allocation_residual_bound {c L : ℝ} (hc : 0 < c) (hL : 0 < L)
    (hlog : 0 < log L) {r jStar : ℕ} (hr : 6 ≤ r)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) {R : ℝ} (hR : 0 ≤ R)
    (hcap : R ≤ smoothAllocationInventory _
      (fun i => log (candidateAllocationValue c L r jStar x i))
      (candidateAllocationActive c L r jStar)+88*log L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hweight : 0 < candidateAllocationWeight c L r jStar x R take) :
    0 ≤ smoothAllocationResidual _ (fun i => log (candidateAllocationValue c L r jStar x i)) R take ∧
      smoothAllocationResidual _ (fun i => log (candidateAllocationValue c L r jStar x i)) R take ≤
        88*log L := by
  exact smooth_allocation_terminal_residual _ _ _ _ _ _ _
    (fun i => by positivity) hR hcap (candidate_allocation_room hc hL hlog hr x) hweight

theorem candidate_allocation_exp_range {c L : ℝ} (hc : 0 < c) (hL : 0 < L)
    (hlog : 0 < log L) {r jStar : ℕ} (hr : 6 ≤ r)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) {R : ℝ} (hR : 0 ≤ R)
    (hcap : R ≤ smoothAllocationInventory _
      (fun i => log (candidateAllocationValue c L r jStar x i))
      (candidateAllocationActive c L r jStar)+88*log L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hweight : 0 < candidateAllocationWeight c L r jStar x R take) :
    exp (R-88*log L) ≤ (candidateAllocatedFactor c L r jStar x take : ℝ) ∧
      (candidateAllocatedFactor c L r jStar x take : ℝ) ≤ exp R := by
  exact smooth_allocation_product_range _ (candidate_allocation_value_pos c L r jStar x)
    _ _ _ _ _ (fun i => by positivity) hR hcap
    (candidate_allocation_room hc hL hlog hr x) hweight

theorem candidate_allocation_size_range {c L E : ℝ} (hc : 0 < c) (hL : 0 < L)
    (hlog : 0 < log L) (hE : 0 < E) (hE1 : 1 ≤ E) {r jStar : ℕ} (hr : 6 ≤ r)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot)
    (hcap : log E ≤ smoothAllocationInventory _
      (fun i => log (candidateAllocationValue c L r jStar x i))
      (candidateAllocationActive c L r jStar)+88*log L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hweight : 0 < candidateAllocationWeight c L r jStar x (log E) take) :
    E/L^88 ≤ (candidateAllocatedFactor c L r jStar x take : ℝ) ∧
      (candidateAllocatedFactor c L r jStar x take : ℝ) ≤ E := by
  have hh := candidate_allocation_exp_range hc hL hlog hr x (log_nonneg hE1) hcap take hweight
  rw [exp_sub, exp_log hE] at hh
  have he : exp (88*log L) = L^88 := by
    rw [show (88 : ℝ)*log L = (88 : ℕ)*log L by norm_num, exp_nat_mul, exp_log hL]
  rwa [he] at hh

end Bounty
end

section

/- The localized pairing bound uses the exact original alternating physical root moment. -/

open scoped BigOperators InnerProductSpace

namespace Bounty

theorem physical_endpoint_block_gram_bound {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (patterns : Finset I) (C : I → G → Finset (Fin J)) {q : ℝ} (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ) (starts : Finset ℤ) (R b D : ℕ)
    (hR : 2 ≤ R) (hD : 0 < D) (hstep : physicalOperatorStepBound P J ell patterns C k ≤ D)
    (f g : ℤ → ℂ)
    (hf : ∀ n ∈ reachablePositions starts (2 * R * b), n ∉ starts → f n = 0)
    {M : ℝ} (hM : 0 ≤ M) (hfM : ∀ n ∈ starts, ‖f n‖ ≤ M) :
    let positions := reachablePositions starts (2 * R * b)
    let A := physicalHilbertOperator V patterns C q ζ k K positions
    let F := physicalEndpointVector P V J ell q positions f
    let H := physicalEndpointVector P V J ell q positions g
    ‖inner ℂ F (A H)‖ ≤
      ((D : ℝ) * M ^ 2) ^ (1 / (2 * (R : ℝ))) *
        (3 * ‖H‖ ^ 2) ^ (1 / 2 : ℝ) * (‖F‖ ^ 2) ^ ((1 - 1 / (R : ℝ)) / 2) *
        ((starts.card : ℝ) * (physicalRootMoment V patterns C q
          (fun j i => if j % 2 = 0 then -ζ i else ζ i)
          (fun j i => if j % 2 = 0 then -k i else k i)
          (fun j i a c aux => if j % 2 = 0 then (starRingEnd ℂ) (K i c a aux)
            else K i a c aux) starts (2 * R - 1) b).re) ^ (1 / (2 * (R : ℝ))) := by
  classical
  dsimp only
  let positions := reachablePositions starts (2 * R * b)
  let A := physicalHilbertOperator V patterns C q ζ k K positions
  let pos := fun x : physicalCutoff P J ell positions => x.val.1
  let u := fun n => finiteFiberVector pos (physicalStateMass V J ell) n
  let kernel := fun x y : physicalCutoff P J ell positions =>
    physicalSymmetricKernel (fun a c => ∑ i ∈ patterns,
      physicalPatternKernel V (C i) q (ζ i) (k i) (K i) a c) x.val y.val
  let f₀ := fun n => f n * (physicalDamping P J ell q n : ℂ)
  let g₀ := fun n => g n * (physicalDamping P J ell q n : ℂ)
  have hfs : ∀ x, pos x ∉ starts → f₀ (pos x) = 0 := by
    intro x hx
    dsimp only [f₀, pos]
    rw [hf x.val.1 ((mem_physical_cutoff P J ell positions x.val).mp x.property) hx, zero_mul]
  have hmax : ∀ n ∈ starts, ‖f₀ n‖ ≤ M := by
    intro n hn
    have hd := physical_damping_unit P J ell hq0 hq1 n
    dsimp only [f₀]
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hd.1]
    simpa only [mul_one] using mul_le_mul (hfM n hn) hd.2 hd.1 hM
  have hk : ∀ x y, (D : ℤ) < |pos x - pos y| → kernel x y = 0 := by
    intro x y hxy
    apply physical_operator_zero_of_far V patterns C q ζ k K x.val y.val
    have hcast : (physicalOperatorStepBound P J ell patterns C k : ℤ) <
        |y.val.1 - x.val.1| := by
      have hs : (physicalOperatorStepBound P J ell patterns C k : ℤ) ≤ D := by
        exact_mod_cast hstep
      exact hs.trans_lt (by simpa only [pos, abs_sub_comm] using hxy)
    rw [← Int.natCast_natAbs] at hcast
    exact_mod_cast hcast
  have hb := finite_position_block_gram_bound pos (physical_state_mass_pos V hV J ell).le
    kernel starts (by exact_mod_cast hD : (0 : ℤ) < D) f₀ g₀ hfs hk hM hmax hR
  have hr := physical_root_moment_re_eq_fiber_gram V hV patterns C q ζ k K starts R b (by omega)
  dsimp only at hr
  have hsum : (starts.card : ℝ) * (physicalRootMoment V patterns C q
      (fun j i => if j % 2 = 0 then -ζ i else ζ i)
      (fun j i => if j % 2 = 0 then -k i else k i)
      (fun j i a c aux => if j % 2 = 0 then (starRingEnd ℂ) (K i c a aux)
        else K i a c aux) starts (2 * R - 1) b).re =
      ∑ n ∈ starts, (inner ℂ (u n) (((A * A.adjoint) ^ R) (u n))).re := by
    by_cases hs : starts.card = 0
    · have he : starts = ∅ := Finset.card_eq_zero.mp hs
      simp only [he, Finset.card_empty, Nat.cast_zero, zero_mul, Finset.sum_empty]
    · have hsr : (starts.card : ℝ) ≠ 0 := by exact_mod_cast hs
      have hh := (eq_div_iff hsr).mp hr
      rw [mul_comm] at hh
      exact hh
  change _ ≤ _ * _ * _ * (∑ n ∈ starts,
    (inner ℂ (u n) (((A * A.adjoint) ^ R) (u n))).re) ^ (1 / (2 * (R : ℝ))) at hb
  rw [← hsum] at hb
  simpa only [physicalEndpointVector, physicalHilbertOperator, positions, pos, kernel, f₀, g₀,
    Int.toNat_natCast] using hb

end Bounty
end

section

/- Exact lifted correlation after removing the prescribed shared primes from
both invariant triple endpoints. All original damping and exclusion factors remain. -/

open Finset

namespace Bounty

theorem physical_endpoint_pairing_eq_invariant_correlation
    {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (V : G → ℝ) (hV : ∀ g, 0 < V g) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ)
    (positions : Finset ℤ) (u v : ℤ → ℂ)
    (α₀ β₀ γ₀ α₁ β₁ γ₁ : ℕ → ℂ) :
    inner ℂ
      (physicalEndpointVector P V J ell q positions (fun n =>
        u n * invariantTripleEndpoint (univ.biUnion P) α₀ β₀ γ₀ n.natAbs))
      (physicalHilbertOperator V patterns C q ζ k K positions
        (physicalEndpointVector P V J ell q positions (fun n =>
          v n * invariantTripleEndpoint (univ.biUnion P) α₁ β₁ γ₁ n.natAbs))) =
      (physicalStateMass V J ell : ℂ) *
      ∑ n ∈ positions, ∑ L : PhysicalMarksAt P J ell n,
      ∑ i ∈ patterns, ∑ aux : PhysicalAuxLabels P (C i),
        let t := n + k i * (physicalD (C i) L.val aux : ℕ)
        let w := n / physicalSharedFactor (C i) L.val
        if t ∈ positions then ∑ R : PhysicalMarksAt P J ell t,
          (starRingEnd ℂ) (u n * invariantTripleEndpoint (univ.biUnion P) α₀ β₀ γ₀ w.natAbs) *
          physicalBarePatternScalar V (C i) (ζ i) (K i) aux L.val R.val *
          (v t * invariantTripleEndpoint (univ.biUnion P) α₁ β₁ γ₁
            (w + k i * (physicalFreeFactor (C i) aux : ℕ)).natAbs) *
          ((physicalVertexWeight L.val q n * physicalVertexWeight R.val q t : ℝ) : ℂ)
        else 0 := by
  classical
  rw [physical_endpoint_pairing_eq_shifted V hV patterns C hq ζ k K positions]
  apply congrArg (fun z : ℂ => (physicalStateMass V J ell : ℂ) * z)
  apply sum_congr rfl
  intro n _
  apply sum_congr rfl
  intro L _
  apply sum_congr rfl
  intro i _
  apply sum_congr rfl
  intro aux _
  dsimp only
  have h₀ := (physical_invariant_endpoints_strip (C i) L.val aux hdis hprime n
    (k i) L.property α₀ β₀ γ₀).1
  have h₁ := (physical_invariant_endpoints_strip (C i) L.val aux hdis hprime n
    (k i) L.property α₁ β₁ γ₁).2
  rw [h₀, h₁]

end Bounty
end

section

/- Exact character expansion with the full signed determinant modulus. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

theorem typeII_congruence_character_indicator {q : ℕ} [NeZero q]
    (m m' : ℕ) (hm' : m'.Coprime q) :
    (if Nat.ModEq q m m' then (1 : ℂ) else 0) =
      (1 / (q.totient : ℂ)) *
        ∑ χ : DirichletCharacter ℂ q, χ (m : ZMod q) * conj (χ (m' : ZMod q)) := by
  classical
  have hu : IsUnit (m' : ZMod q) := (ZMod.isUnit_iff_coprime m' q).mpr hm'
  have hs := DirichletCharacter.sum_char_inv_mul_char_eq ℂ hu (m : ZMod q)
  have hsum : (∑ χ : DirichletCharacter ℂ q,
      χ (m : ZMod q) * conj (χ (m' : ZMod q))) =
      if Nat.ModEq q m m' then (q.totient : ℂ) else 0 := by
    calc
      _ = ∑ χ : DirichletCharacter ℂ q, χ (m' : ZMod q)⁻¹ * χ (m : ZMod q) := by
        apply sum_congr rfl
        intro χ hχ
        rw [character_conj_apply_unit χ hu, mul_comm]
      _ = _ := by
        rw [hs]
        congr 1
        rw [ZMod.natCast_eq_natCast_iff]
        exact propext Nat.ModEq.comm
  rw [hsum]
  have hφ : (q.totient : ℂ) ≠ 0 := by
    exact_mod_cast (Nat.totient_pos.mpr (NeZero.pos q)).ne'
  split_ifs <;> simp [hφ]

theorem typeII_congruence_character_sum {q : ℕ} [NeZero q]
    {ι : Type*} (S : Finset ι) (m m' : ι → ℕ) (f : ι → ℂ)
    (hm' : ∀ x ∈ S, (m' x).Coprime q) :
    (∑ x ∈ S with Nat.ModEq q (m x) (m' x), f x) =
      (1 / (q.totient : ℂ)) * ∑ χ : DirichletCharacter ℂ q,
        ∑ x ∈ S, f x * χ (m x : ZMod q) * conj (χ (m' x : ZMod q)) := by
  classical
  rw [sum_filter]
  simp only [mul_sum]
  rw [sum_comm]
  apply sum_congr rfl
  intro x hx
  calc
    (if Nat.ModEq q (m x) (m' x) then f x else 0) =
        f x * (if Nat.ModEq q (m x) (m' x) then (1 : ℂ) else 0) := by
      split_ifs <;> simp
    _ = _ := by
      rw [typeII_congruence_character_indicator (m x) (m' x) (hm' x hx)]
      simp only [mul_sum]
      apply sum_congr rfl
      intro χ hχ
      ring

theorem typeII_signed_congruence_iff {k : ℤ} {m m' : ℕ} :
    Int.ModEq (2 * |k|) (m : ℤ) (m' : ℤ) ↔ Nat.ModEq (2 * k.natAbs) m m' := by
  have hq : ((2 * k.natAbs : ℕ) : ℤ) = 2 * |k| := by
    simp only [Nat.cast_mul, Nat.cast_ofNat, Int.natCast_natAbs]
  rw [← hq, Int.natCast_modEq_iff]

theorem typeII_rough_coprime_twice_natAbs {m : ℕ} {k : ℤ} {W : ℝ}
    (hm : 0 < m) (hk : k ≠ 0) (hW : 2 ≤ W)
    (hrough : ∀ p ∈ m.primeFactors, W < (p : ℝ))
    (hsmall : (k.natAbs : ℝ) ≤ W) : Nat.Coprime m (2 * k.natAbs) := by
  have htwo : m.Coprime 2 := by
    apply Nat.coprime_of_dvd
    intro p hp hpm hptwo
    have hlarge := hrough p (Nat.mem_primeFactors.mpr ⟨hp, hpm, hm.ne'⟩)
    have hp2 : p ≤ 2 := Nat.le_of_dvd (by decide) hptwo
    have hp2' : (p : ℝ) ≤ 2 := by exact_mod_cast hp2
    linarith
  exact htwo.mul_right (typeII_rough_coprime_natAbs hm hk hrough hsmall)

end Bounty

end

section

/- Uniform removal of the large P-part for bounded complex tests on rough shifted divisors. -/

open Finset Filter Real

namespace Bounty

theorem norm_weighted_finite_fibers_le (T : Finset ℕ) (fibers : ℕ → Finset ℕ)
    (a : ℕ → ℝ) (F : ℕ → ℕ → ℂ) (M : ℝ)
    (ha : ∀ u ∈ T, 0 ≤ a u) (hF : ∀ u ∈ T, ∀ m ∈ fibers u, ‖F u m‖ ≤ M) :
    ‖∑ u ∈ T, (a u : ℂ)*∑ m ∈ fibers u, F u m‖ ≤
      M*(∑ u ∈ T, a u*((fibers u).card : ℝ)) := by
  calc
    _ ≤ ∑ u ∈ T, ‖(a u : ℂ)*∑ m ∈ fibers u, F u m‖ := norm_sum_le _ _
    _ ≤ ∑ u ∈ T, a u*(((fibers u).card : ℝ)*M) := by
      apply sum_le_sum
      intro u hu
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (ha u hu)]
      apply mul_le_mul_of_nonneg_left _ (ha u hu)
      calc
        _ ≤ ∑ m ∈ fibers u, ‖F u m‖ := norm_sum_le _ _
        _ ≤ ∑ _m ∈ fibers u, M := sum_le_sum (fun m hm => hF u hu m hm)
        _ = _ := by simp
    _ = _ := by
      rw [mul_sum]
      apply sum_congr rfl
      intro u hu
      ring

theorem eventually_candidate_large_P_bounded_rough_tests {c q κ : ℝ} (hc : 0 < c)
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hκ : 0 < κ) (r jStar : ℕ) (A D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ F : ℕ → ℕ → ℂ,
      (∀ u ∈ arithmeticProductWindow 1 (exp L),
        ∀ m ∈ roughDivisors (exp (sqrt L)) (2*u+1), ‖F u m‖ ≤ L^A) →
      ‖∑ u ∈ (arithmeticProductWindow 1 (exp L)).filter
          (fun u => exp (κ*L) < (primePoolPart
            ((candidatePIndices c L).biUnion (candidatePBand (c*L))) u : ℝ)),
        (candidateCoefficient c L q r jStar u : ℂ) *
          ∑ m ∈ roughDivisors (exp (sqrt L)) (2*u+1), F u m‖ ≤ exp L*L^(-D) := by
  filter_upwards [eventually_candidate_large_P_rough_power_saving hc hq0 hq1 hκ r jStar (D+A),
    eventually_gt_atTop (0 : ℝ)] with L hmass hL
  intro F hF
  calc
    _ ≤ L^A*candidateLargePRoughDivisorMass c L q r jStar (exp (κ*L)) := by
      apply norm_weighted_finite_fibers_le
      · intro u hu
        exact candidate_coefficient_nonneg c L hq0 r jStar u
      · intro u hu m hm
        exact hF u (mem_filter.mp hu).1 m hm
    _ ≤ L^A*(exp L*L^(-(D+A))) := mul_le_mul_of_nonneg_left hmass (by positivity)
    _ = exp L*L^(-D) := by
      rw [mul_left_comm, ← rpow_add hL]
      congr 2
      ring

end Bounty
end

section

/- Polynomial separated-coefficient bounds uniform over allocation patterns and unit-bounded twists. -/

open Finset Filter

namespace Bounty

theorem norm_candidate_remaining_coefficient_le_divisors {c L : ℝ} {r jStar : ℕ}
    (hcL : 0 ≤ c*L) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm (candidateRoughSlot c L r jStar hr hj)) = false)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ)
    (htwist : ∀ slot p, p ∈ candidateQSlotChoices c L r jStar slot → ‖twist slot p‖ ≤ 1)
    (h : ℕ) (hh : h ≠ 0) :
    ‖candidateRemainingComplexCoefficient c L r jStar take twist h‖ ≤ (h.divisors.card : ℝ) := by
  apply (norm_candidate_remaining_coefficient_le_rough_divisors hcL hr hj take hkeep twist htwist h).trans
  apply Nat.cast_le.mpr
  apply card_le_card
  intro p hp
  exact Nat.mem_divisors.mpr ⟨(mem_filter.mp hp).2, hh⟩

theorem exists_candidate_separated_coefficients_polynomial_bound
    {c : ℝ} (hc : 0 < c) {r : ℕ} (hr : 0 < r) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ,
      ∀ hj : jStar ∈ candidateQIndices c L,
      ∀ take : Fin ((candidateQIndices c L).card*r) → Bool,
      ∀ hkeep : take ((candidateAllocationOrder c L r).symm
        (candidateRoughSlot c L r jStar hr hj)) = false,
      ∀ twist : (candidateQIndices c L) × Fin r → ℕ → ℂ,
      (∀ slot p, p ∈ candidateQSlotChoices c L r jStar slot → ‖twist slot p‖ ≤ 1) →
      (∀ e : ℕ, ‖candidateTakenComplexCoefficient c L r jStar take twist e‖ ≤ L^C) ∧
      (∀ q : ℕ, ‖candidateResidualPrimeCoefficient c L r jStar hr hj take hkeep twist q‖ ≤ 1) ∧
      (∀ h : ℕ, ‖candidateRemainingComplexCoefficient c L r jStar take twist h‖ ≤
        (((candidateRoughBand c L jStar).filter (fun p => p ∣ h)).card : ℝ)) := by
  obtain ⟨C, hC, hpoly⟩ := exists_candidate_factorial_normalization_polynomial_bound hc r
  refine ⟨C, hC, ?_⟩
  filter_upwards [hpoly, eventually_ge_atTop (0 : ℝ)] with L hpoly hL
  intro jStar hj take hkeep twist htwist
  have hcL : 0 ≤ c*L := mul_nonneg hc.le hL
  refine ⟨?_, ?_, ?_⟩
  · intro e
    exact (norm_candidate_taken_coefficient_le_factorial_pow hcL hr hj take hkeep twist htwist e).trans hpoly
  · intro q
    exact norm_candidate_residual_prime_coefficient_le_one hcL hr hj take hkeep twist htwist q
  · intro h
    exact norm_candidate_remaining_coefficient_le_rough_divisors hcL hr hj take hkeep twist htwist h


end Bounty
end

section

/- Explicit exponent budgets for the low-rank forest contribution. -/

open Finset Classical

namespace Bounty

theorem birthForest_low_rank_power_saving {m : ℕ} (F : BirthForestCode m → ℂ)
    (r₀ N : ℕ) {L H G Cv Ca M Ch E : ℝ}
    (hL : 2 ≤ L) (hH : 0 ≤ H) (hM : 0 ≤ M) (hD : 0 ≤ G + Ca + M)
    (hm : (m : ℝ) ≤ L ^ M) (hHb : H ≤ L ^ Ch)
    (hfixed : Cv + Ch + M + 1 ≤ (N : ℝ) / 2)
    (haffected : 2 * r₀ * (G + Ca + M) ≤ (N : ℝ) / 2)
    (hgain : E + Cv + 1 ≤ G)
    (hF : ∀ code, birthForestRank code < r₀ →
      ‖F code‖ ≤ H * L ^ ((-G + Cv) * N + Cv +
        2 * birthForestRank code * (G + Ca))) :
    ‖∑ code ∈ (univ : Finset (BirthForestCode m)).filter
        (fun code => birthForestRank code < r₀),
      (-1 : ℂ) ^ birthForestRank code * F code‖ ≤ L ^ (-(E * N)) := by
  have hL1 : 1 ≤ L := by linarith
  have hL0 : 0 < L := by linarith
  have hM1 : 1 ≤ L ^ M := Real.one_le_rpow hL1 hM
  have hm1 : (m : ℝ) + 1 ≤ L ^ (M + 1) := by
    calc
      (m : ℝ) + 1 ≤ L ^ M + L ^ M := add_le_add hm hM1
      _ ≤ L ^ M * L := by nlinarith [Real.rpow_pos_of_pos hL0 M]
      _ = L ^ (M + 1) := by rw [Real.rpow_add hL0, Real.rpow_one]
  apply (birthForest_low_rank_power_bound F r₀ hL1 hH hD hm hF).trans
  calc
    _ ≤ L ^ (M + 1) * L ^ Ch *
        L ^ ((-G + Cv) * N + Cv + 2 * r₀ * (G + Ca + M)) := by
      apply mul_le_mul_of_nonneg_right _ (Real.rpow_pos_of_pos hL0 _).le
      exact mul_le_mul hm1 hHb hH (Real.rpow_pos_of_pos hL0 _).le
    _ = L ^ ((-G + Cv) * N + Cv + Ch + M + 1 +
        2 * r₀ * (G + Ca + M)) := by
      rw [← Real.rpow_add hL0, ← Real.rpow_add hL0]
      congr 1
      ring
    _ ≤ L ^ (-(E * N)) := by
      apply Real.rpow_le_rpow_of_exponent_le hL1
      have hg := mul_le_mul_of_nonneg_right hgain (Nat.cast_nonneg N : (0 : ℝ) ≤ N)
      nlinarith

end Bounty
end

section

/- Encoding prime labels preserves every forest constraint on performed births. -/

open scoped Classical
namespace Bounty

theorem optional_forest_encoding_iff {m : ℕ} {α : Type*}
    (performed : Fin m → Prop) (label : Fin m → Option α)
    (hp : ∀ i, performed i → (label i).isSome = true)
    (encode : α → ℤ) (hinj : Function.Injective encode) (code : BirthForestCode m) :
    birthForestCompatible performed (fun i => ((label i).map encode).getD 0) code ↔
      birthForestCompatible performed label code := by
  apply forall_congr'
  intro j
  cases code j with
  | none => rfl
  | some i =>
    change (_ ∧ _ ∧ _) ↔ (_ ∧ _ ∧ _)
    constructor <;> rintro ⟨hi, hj, he⟩
    · exact ⟨hi, hj, (optional_encoded_eq_iff encode hinj _ _ (hp _ hi) (hp _ hj)).mp he⟩
    · exact ⟨hi, hj, (optional_encoded_eq_iff encode hinj _ _ (hp _ hi) (hp _ hj)).mpr he⟩

theorem full_mixed_indexed_forest_encoding_iff
    {J K : Type*} {N : ℕ} {P : Fin N → Type*}
    (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
    (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ) (steps : List (Option (J ⊕ K)))
    (encode : ((g : Fin N) × P g) → ℤ) (hinj : Function.Injective encode)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x)
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps))) :
    birthForestCompatible (fullMixedIndexedBirthPerformed n S B A Δ D steps x p)
      (fullMixedIndexedBirthValue n S B A Δ D steps encode x p) code ↔
    birthForestCompatible
      (fun i => fullMixedPathBirthPerformed n S B A Δ D steps x p (fullMixedBirthOrder S B steps i))
      (fun i => fullMixedPathBirthLabel n S B A Δ D steps x p (fullMixedBirthOrder S B steps i)) code := by
  apply optional_forest_encoding_iff _ _ _ encode hinj code
  intro i hi
  exact (full_mixed_path_birth_performed_iff_label_present n S B A Δ D steps x p _).mp hi

end Bounty
end

section

/- Compact transitions preserve bounded positive branches and have total mass at most one. -/

open Finset Real

namespace Bounty

theorem smooth_allocation_weight_eq_product (n : ℕ) (v s : Fin n → ℝ)
    (active : Fin n → Bool) (R : ℝ) (take : Fin n → Bool) :
    smoothAllocationWeight n v s active R take =
      ∏ i, smoothSlotTransition (v i) (s i) (allocationPrefixResidual v R take i)
        (active i) (take i) := by
  induction n generalizing R with
  | zero => simp [smoothAllocationWeight]
  | succ n ih =>
    rw [smoothAllocationWeight, Fin.prod_univ_succ, allocation_prefix_zero, ih]
    congr 1
    apply prod_congr rfl
    intro i hi
    rw [allocation_prefix_succ]
    rfl

noncomputable def compactSlotTransition (A v s R : ℝ) (active take : Bool) : ℝ :=
  if active then typeIISmoothCutoff A take ((R-v)/s) else if take then 0 else 1

noncomputable def compactAllocationWeight (A : ℝ) (n : ℕ) (v s : Fin n → ℝ)
    (active : Fin n → Bool) (R : ℝ) (take : Fin n → Bool) : ℝ :=
  ∏ i, compactSlotTransition A (v i) (s i) (allocationPrefixResidual v R take i) (active i) (take i)

theorem compact_slot_transition_bounds (A v s R : ℝ) (active take : Bool) :
    0 ≤ compactSlotTransition A v s R active take ∧
      compactSlotTransition A v s R active take ≤ smoothSlotTransition v s R active take := by
  cases active
  · cases take <;> simp [compactSlotTransition, smoothSlotTransition, smoothSlotTakeProbability]
  · have hr := typeII_smooth_rho_bounds A ((R-v)/s)
    have ht := smooth_slot_transition_nonneg v s R true take
    have he : compactSlotTransition A v s R true take =
        typeIISmoothRho A ((R-v)/s)*smoothSlotTransition v s R true take := by
      cases take <;> simp [compactSlotTransition, typeIISmoothCutoff,
        smoothSlotTransition, smoothSlotTakeProbability]
    rw [he]
    refine ⟨mul_nonneg hr.1 ht, ?_⟩
    simpa only [one_mul] using mul_le_mul_of_nonneg_right hr.2 ht

theorem compact_slot_transition_eq {A v s R : ℝ} (active take : Bool)
    (harg : active = true → (R-v)/s ∈ Set.Icc (-A) A) :
    compactSlotTransition A v s R active take = smoothSlotTransition v s R active take := by
  cases active
  · cases take <;> simp [compactSlotTransition, smoothSlotTransition, smoothSlotTakeProbability]
  · have h := typeII_smooth_cutoff_eq_transition take (harg rfl)
    cases take <;> simpa only [compactSlotTransition, smoothSlotTransition, smoothSlotTakeProbability,
      Bool.false_eq_true, if_false, if_true] using h

theorem compact_allocation_weight_bounds (A : ℝ) (n : ℕ) (v s : Fin n → ℝ)
    (active : Fin n → Bool) (R : ℝ) (take : Fin n → Bool) :
    0 ≤ compactAllocationWeight A n v s active R take ∧
      compactAllocationWeight A n v s active R take ≤ smoothAllocationWeight n v s active R take := by
  constructor
  · exact prod_nonneg (fun i _ => (compact_slot_transition_bounds _ _ _ _ _ _).1)
  · rw [smooth_allocation_weight_eq_product]
    exact prod_le_prod₀ (fun i _ => (compact_slot_transition_bounds _ _ _ _ _ _).1)
      (fun i _ => (compact_slot_transition_bounds _ _ _ _ _ _).2)

theorem compact_allocation_total_mass_le_one (A : ℝ) (n : ℕ) (v s : Fin n → ℝ)
    (active : Fin n → Bool) (R : ℝ) :
    (∑ take, compactAllocationWeight A n v s active R take) ≤ 1 := by
  rw [← smooth_allocation_total_mass n v s active R]
  exact sum_le_sum (fun take _ => (compact_allocation_weight_bounds A n v s active R take).2)

theorem compact_allocation_eq_of_args (A : ℝ) (n : ℕ) (v s : Fin n → ℝ)
    (active : Fin n → Bool) (R : ℝ) (take : Fin n → Bool)
    (harg : ∀ i, active i = true →
      (allocationPrefixResidual v R take i-v i)/s i ∈ Set.Icc (-A) A) :
    compactAllocationWeight A n v s active R take = smoothAllocationWeight n v s active R take := by
  rw [smooth_allocation_weight_eq_product]
  exact prod_congr rfl (fun i _ => compact_slot_transition_eq (active i) (take i) (harg i))

end Bounty
end

section

open scoped ContDiff

namespace Bounty

theorem typeII_pulled_schwartz_tsupport_subset (A : ℝ) (p : Fin 4 → ℝ) :
    tsupport (typeIIPulledSchwartz A (p 0) (p 1) (p 2) (p 3)) ⊆
      tsupport (typeIIThreeLocalizer A) := by
  apply (tsupport_comp_subset (g := fun x : ℝ => (x : ℂ)) (by simp)
    (typeIIPulledCutoff A (p 0) (p 1) (p 2) (p 3))).trans
  exact tsupport_mul_subset_left.trans tsupport_mul_subset_left

theorem typeII_pulled_support_radius (A : ℝ) :
    ∃ R : ℝ, 0 ≤ R ∧ ∀ p : Fin 4 → ℝ,
      tsupport (typeIIPulledSchwartz A (p 0) (p 1) (p 2) (p 3)) ⊆
        Metric.closedBall 0 R := by
  obtain ⟨R, hR⟩ := (typeII_three_localizer_hasCompactSupport A).isCompact.isBounded.subset_closedBall 0
  refine ⟨max R 0, le_max_right _ _, ?_⟩
  intro p
  exact (typeII_pulled_schwartz_tsupport_subset A p).trans
    (hR.trans (Metric.closedBall_subset_closedBall (le_max_left _ _)))

theorem typeII_pulled_derivative_polynomial_bound {A : ℝ} (hA : 0 ≤ A) (n : ℕ) :
    ∃ (d : ℕ) (C : ℝ), 0 ≤ C ∧ ∀ (p : Fin 4 → ℝ) (x : EuclideanSpace ℝ (Fin 3)),
      ‖iteratedFDeriv ℝ n (typeIIPulledSchwartz A (p 0) (p 1) (p 2) (p 3)) x‖ ≤
        C * (1 + ‖p‖) ^ d := by
  have hG : Function.HasTemperateGrowth
      (fun y : (Fin 4 → ℝ) × EuclideanSpace ℝ (Fin 3) => (typeIIPulledJoint A y : ℂ)) :=
    Complex.ofRealCLM.hasTemperateGrowth.comp (typeII_pulled_joint_hasTemperateGrowth A)
  obtain ⟨d, C, hC, hb⟩ := hG.norm_iteratedFDeriv_le_uniform n
  obtain ⟨R, hR0, hR⟩ := typeII_pulled_support_radius A
  refine ⟨d, C * (1 + R) ^ d, mul_nonneg hC (pow_nonneg (by linarith) _), ?_⟩
  intro p x
  by_cases hx : x ∈ Metric.closedBall 0 R
  · have hfun : (fun x : EuclideanSpace ℝ (Fin 3) => (typeIIPulledJoint A (p, x) : ℂ)) =
        (typeIIPulledSchwartz A (p 0) (p 1) (p 2) (p 3) : EuclideanSpace ℝ (Fin 3) → ℂ) := by
      funext y
      change (typeIIPulledJoint A (p, y) : ℂ) = (typeIIPulledCutoff A (p 0) (p 1) (p 2) (p 3) y : ℂ)
      rw [typeII_pulled_joint_eq hA]
    have hslice := norm_iteratedFDeriv_slice_le hG.1 p x n
    rw [hfun] at hslice
    have hxR : ‖x‖ ≤ R := mem_closedBall_zero_iff.mp hx
    have hbase : 1 + ‖(p, x)‖ ≤ (1 + R) * (1 + ‖p‖) := by
      rw [Prod.norm_def]
      have hm : max ‖p‖ ‖x‖ ≤ ‖p‖ + R := max_le (by linarith) (by linarith [norm_nonneg p])
      nlinarith [norm_nonneg p]
    calc
      _ ≤ C * (1 + ‖(p, x)‖) ^ d := hslice.trans (hb n le_rfl (p, x))
      _ ≤ C * ((1 + R) * (1 + ‖p‖)) ^ d :=
        mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by positivity) hbase d) hC
      _ = _ := by rw [mul_pow]; ring
  · have hz : iteratedFDeriv ℝ n (typeIIPulledSchwartz A (p 0) (p 1) (p 2) (p 3)) x = 0 := by
      apply Function.notMem_support.mp
      intro hs
      exact hx (hR p (support_iteratedFDeriv_subset n hs))
    rw [hz, norm_zero]
    positivity

end Bounty
end

section

/- The actual first and second invariant endpoints, with exact finite support masks. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

noncomputable def typeIIInvariantEndpoint (P M R C : Finset ℕ)
    (A c : ℕ → ℂ) (t σ : ℝ) (v : ℕ) : ℂ :=
  invariantTripleEndpoint P
    (fun m => if m ∈ M then A m * typeIIPhase t m else 0)
    (fun p => if p ∈ R then typeIIPhase (-σ) p else 0)
    (fun r => if r ∈ C then conj (c r) else 0) v

theorem typeII_cross_pair_eq_masked_endpoints
    (P M H R C : Finset ℕ) (A c : ℕ → ℂ) (W : ℕ → ℝ)
    (ρ σ ξ₁ ξ₂ ξ₃ : ℝ) {z w : ℕ} (hz : 0 < z) (hw : 0 < w)
    (hM : ∀ m ∈ M, 0 < m) (hH : ∀ h ∈ H, 0 < h)
    (hfree : ∀ m ∈ M, Disjoint m.primeFactors P)
    (hW : ∀ m ∈ M, ∀ h ∈ H, W (m*h)=W h) :
    typeIICrossPairCoefficient M H A W
      (fun h => typeIIRoughConvolution R C σ c (primePoolFreePart P h)) ρ ξ₁ ξ₂ ξ₃ z w =
      typeIIPhase (ρ+ξ₃) z * typeIIPhase (-ρ) w *
        conj (typeIIMaskedTripleEndpoint P M H R C A c (ρ-ξ₂) σ z) *
        typeIIMaskedTripleEndpoint P M H R C A c (ξ₁+ρ) σ w * (W z : ℂ) * (W w : ℂ) := by
  rw [typeII_cross_pair_coefficient_factorization M H A W _ ρ ξ₁ ξ₂ ξ₃ z w hM hH hW,
    typeII_direct_rough_endpoint_eq_masked_triple P M H R C A c (ρ-ξ₂) σ hz hM hfree,
    typeII_direct_rough_endpoint_eq_masked_triple P M H R C A c (ξ₁+ρ) σ hw hM hfree]

theorem typeII_cross_pair_eq_invariant_endpoints
    (P M H R C : Finset ℕ) (A c : ℕ → ℂ) (W : ℕ → ℝ)
    (ρ σ ξ₁ ξ₂ ξ₃ : ℝ) {z w : ℕ} (hz : 0 < z) (hw : 0 < w)
    (hM : ∀ m ∈ M, 0 < m) (hH : ∀ h ∈ H, 0 < h)
    (hfree : ∀ m ∈ M, Disjoint m.primeFactors P)
    (hW : ∀ m ∈ M, ∀ h ∈ H, W (m*h)=W h)
    (hHz : ∀ m ∈ M, m ∣ z → z/m ∈ H) (hHw : ∀ m ∈ M, m ∣ w → w/m ∈ H) :
    typeIICrossPairCoefficient M H A W
      (fun h => typeIIRoughConvolution R C σ c (primePoolFreePart P h)) ρ ξ₁ ξ₂ ξ₃ z w =
      typeIIPhase (ρ+ξ₃) z * typeIIPhase (-ρ) w *
        conj (typeIIInvariantEndpoint P M R C A c (ρ-ξ₂) σ z) *
        typeIIInvariantEndpoint P M R C A c (ξ₁+ρ) σ w * (W z : ℂ) * (W w : ℂ) := by
  rw [typeII_cross_pair_eq_masked_endpoints P M H R C A c W ρ σ ξ₁ ξ₂ ξ₃ hz hw hM hH hfree hW,
    typeII_masked_triple_eq_invariant_of_complete P M H R C A c (ρ-ξ₂) σ hz hHz,
    typeII_masked_triple_eq_invariant_of_complete P M H R C A c (ξ₁+ρ) σ hw hHw]
  rfl

theorem typeII_cross_pair_Icc_eq_invariant_endpoints
    (P M R C : Finset ℕ) (A c : ℕ → ℂ) (W : ℕ → ℝ) (B : ℕ)
    (ρ σ ξ₁ ξ₂ ξ₃ : ℝ) {z w : ℕ} (hz : 0 < z) (hw : 0 < w)
    (hzB : z ≤ B) (hwB : w ≤ B)
    (hM : ∀ m ∈ M, 0 < m) (hfree : ∀ m ∈ M, Disjoint m.primeFactors P)
    (hW : ∀ m ∈ M, ∀ h ∈ Icc 1 B, W (m*h)=W h) :
    typeIICrossPairCoefficient M (Icc 1 B) A W
      (fun h => typeIIRoughConvolution R C σ c (primePoolFreePart P h)) ρ ξ₁ ξ₂ ξ₃ z w =
      typeIIPhase (ρ+ξ₃) z * typeIIPhase (-ρ) w *
        conj (typeIIInvariantEndpoint P M R C A c (ρ-ξ₂) σ z) *
        typeIIInvariantEndpoint P M R C A c (ξ₁+ρ) σ w * (W z : ℂ) * (W w : ℂ) := by
  apply typeII_cross_pair_eq_invariant_endpoints P M (Icc 1 B) R C A c W ρ σ ξ₁ ξ₂ ξ₃
    hz hw hM (fun h hh => (mem_Icc.mp hh).1) hfree hW
  · intro m _ hm
    exact reconstructed_factor_mem_Icc hz hm hzB
  · intro m _ hm
    exact reconstructed_factor_mem_Icc hw hm hwB

theorem typeII_marked_cross_pair_eq_invariant_endpoints {G : Type*}
    (groups : Finset G) (P : G → Finset ℕ) (q : ℝ) (mass : G → ℝ) (marks : G → ℕ)
    (hprime : ∀ g ∈ groups, ∀ p ∈ P g, p.Prime)
    (M H R C : Finset ℕ) (A c : ℕ → ℂ) (ρ σ ξ₁ ξ₂ ξ₃ : ℝ)
    {z w : ℕ} (hz : 0 < z) (hw : 0 < w)
    (hM : ∀ m ∈ M, 0 < m) (hH : ∀ h ∈ H, 0 < h)
    (hfree : ∀ m ∈ M, Disjoint m.primeFactors (groups.biUnion P))
    (hHz : ∀ m ∈ M, m ∣ z → z/m ∈ H) (hHw : ∀ m ∈ M, m ∣ w → w/m ∈ H) :
    let W : ℕ → ℝ := fun n => markedDivisorWeight groups P q mass marks (n : ℤ)
    typeIICrossPairCoefficient M H A W
      (fun h => typeIIRoughConvolution R C σ c (primePoolFreePart (groups.biUnion P) h))
      ρ ξ₁ ξ₂ ξ₃ z w =
      typeIIPhase (ρ+ξ₃) z * typeIIPhase (-ρ) w *
        conj (typeIIInvariantEndpoint (groups.biUnion P) M R C A c (ρ-ξ₂) σ z) *
        typeIIInvariantEndpoint (groups.biUnion P) M R C A c (ξ₁+ρ) σ w *
        (W z : ℂ) * (W w : ℂ) := by
  dsimp only
  apply typeII_cross_pair_eq_invariant_endpoints (groups.biUnion P) M H R C A c _
    ρ σ ξ₁ ξ₂ ξ₃ hz hw hM hH hfree _ hHz hHw
  intro m hm h _
  exact marked_divisor_weight_mul_free_left groups P q mass marks hprime
    (hM m hm).ne' (hfree m hm) h

theorem typeII_invariant_endpoint_unmask_coefficients
    (P M R C : Finset ℕ) (A c : ℕ → ℂ) (t σ : ℝ)
    (hA : ∀ m, m ∉ M → A m=0) (hc : ∀ r, r ∉ C → c r=0) (v : ℕ) :
    typeIIInvariantEndpoint P M R C A c t σ v =
      invariantTripleEndpoint P (fun m => A m * typeIIPhase t m)
        (fun p => if p ∈ R then typeIIPhase (-σ) p else 0) (fun r => conj (c r)) v := by
  have hfirst : (fun m => if m ∈ M then A m * typeIIPhase t m else 0) =
      (fun m => A m * typeIIPhase t m) := by
    funext m
    by_cases hm : m ∈ M
    · simp only [hm, if_true]
    · simp only [hm, if_false, hA m hm, zero_mul]
  have hlast : (fun r => if r ∈ C then conj (c r) else 0) = (fun r => conj (c r)) := by
    funext r
    by_cases hr : r ∈ C
    · simp only [hr, if_true]
    · simp only [hr, if_false, hc r hr, map_zero]
  unfold typeIIInvariantEndpoint
  rw [hfirst, hlast]

theorem typeII_character_cross_pair_eq_original_endpoints
    (P M H R C : Finset ℕ) (α c : ℕ → ℂ) (W : ℕ → ℝ)
    (modulus : ℕ) (χ : DirichletCharacter ℂ modulus) (ρ σ ξ₁ ξ₂ ξ₃ : ℝ)
    {z w : ℕ} (hz : 0 < z) (hw : 0 < w)
    (hM : ∀ m ∈ M, 0 < m) (hH : ∀ h ∈ H, 0 < h)
    (hfree : ∀ m ∈ M, Disjoint m.primeFactors P)
    (hW : ∀ m ∈ M, ∀ h ∈ H, W (m*h)=W h)
    (hHz : ∀ m ∈ M, m ∣ z → z/m ∈ H) (hHw : ∀ m ∈ M, m ∣ w → w/m ∈ H)
    (hα : ∀ m, m ∉ M → α m=0) (hc : ∀ r, r ∉ C → c r=0) :
    let F₀ := invariantTripleEndpoint P
      (fun m => α m * χ (m : ZMod modulus) * typeIIPhase (ρ-ξ₂) m)
      (fun p => if p ∈ R then typeIIPhase (-σ) p else 0) (fun r => conj (c r))
    let G₀ := invariantTripleEndpoint P
      (fun m => α m * χ (m : ZMod modulus) * typeIIPhase (ξ₁+ρ) m)
      (fun p => if p ∈ R then typeIIPhase (-σ) p else 0) (fun r => conj (c r))
    typeIICrossPairCoefficient M H (fun m => α m * χ (m : ZMod modulus)) W
      (fun h => typeIIRoughConvolution R C σ c (primePoolFreePart P h)) ρ ξ₁ ξ₂ ξ₃ z w =
      typeIIPhase (ρ+ξ₃) z * typeIIPhase (-ρ) w * conj (F₀ z) * G₀ w * (W z : ℂ) * (W w : ℂ) := by
  dsimp only
  have hA : ∀ m, m ∉ M → α m * χ (m : ZMod modulus)=0 := by
    intro m hm
    rw [hα m hm, zero_mul]
  rw [typeII_cross_pair_eq_invariant_endpoints P M H R C _ c W
    ρ σ ξ₁ ξ₂ ξ₃ hz hw hM hH hfree hW hHz hHw,
    typeII_invariant_endpoint_unmask_coefficients P M R C _ c (ρ-ξ₂) σ hA hc z,
    typeII_invariant_endpoint_unmask_coefficients P M R C _ c (ξ₁+ρ) σ hA hc w]


end Bounty
end

section

/- The actual remaining candidate coefficient has the required rough convolution. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

noncomputable def candidateResidualPrimeSupport (c L : ℝ) (r jStar : ℕ)
    (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card * r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm
      (candidateRoughSlot c L r jStar hr hj)) = false) : Finset ℕ :=
  orderedSlotProductSupport
    (fun slot : {slot : CandidateRemainingSlot c L r take //
      slot ≠ candidateRemainingRoughSlot c L r jStar hr hj take hkeep} =>
      candidateQSlotChoices c L r jStar slot.val.val)

theorem candidate_remaining_eq_typeIIRoughConvolution (c L : ℝ) (r jStar : ℕ)
    (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card * r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm
      (candidateRoughSlot c L r jStar hr hj)) = false)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (σ : ℝ)
    (hphase : ∀ p ∈ candidateRoughBand c L jStar,
      twist (candidateRoughSlot c L r jStar hr hj) p = typeIIPhase σ p) (n : ℕ) :
    candidateRemainingComplexCoefficient c L r jStar take twist n =
      typeIIRoughConvolution (candidateRoughBand c L jStar)
        (candidateResidualPrimeSupport c L r jStar hr hj take hkeep) σ
        (candidateResidualPrimeCoefficient c L r jStar hr hj take hkeep twist) n := by
  classical
  rw [candidate_remaining_rough_convolution c L r jStar hr hj take hkeep twist n]
  unfold typeIIRoughConvolution candidateResidualPrimeSupport
  conv_rhs => rw [← sum_attach]
  apply sum_congr
  · ext p
    simp only [mem_univ, mem_attach]
  · intro p _
    rw [hphase p.val p.property]

theorem candidate_residual_prime_coefficient_eq_zero_of_not_mem
    (c L : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card * r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm
      (candidateRoughSlot c L r jStar hr hj)) = false)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) {n : ℕ}
    (hn : n ∉ candidateResidualPrimeSupport c L r jStar hr hj take hkeep) :
    candidateResidualPrimeCoefficient c L r jStar hr hj take hkeep twist n = 0 := by
  unfold candidateResidualPrimeCoefficient
  rw [ordered_slot_complex_weight_support _ _ hn, zero_div]

theorem candidate_residual_prime_coefficient_mask
    (c L : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card * r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm
      (candidateRoughSlot c L r jStar hr hj)) = false)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (n : ℕ) :
    (if n ∈ candidateResidualPrimeSupport c L r jStar hr hj take hkeep then
      candidateResidualPrimeCoefficient c L r jStar hr hj take hkeep twist n else 0) =
        candidateResidualPrimeCoefficient c L r jStar hr hj take hkeep twist n := by
  classical
  by_cases hn : n ∈ candidateResidualPrimeSupport c L r jStar hr hj take hkeep
  · exact if_pos hn
  · rw [if_neg hn, candidate_residual_prime_coefficient_eq_zero_of_not_mem
      c L r jStar hr hj take hkeep twist hn]

theorem candidate_residual_prime_conj_mask
    (c L : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card * r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm
      (candidateRoughSlot c L r jStar hr hj)) = false)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (n : ℕ) :
    (if n ∈ candidateResidualPrimeSupport c L r jStar hr hj take hkeep then
      conj (candidateResidualPrimeCoefficient c L r jStar hr hj take hkeep twist n) else 0) =
        conj (candidateResidualPrimeCoefficient c L r jStar hr hj take hkeep twist n) := by
  classical
  by_cases hn : n ∈ candidateResidualPrimeSupport c L r jStar hr hj take hkeep
  · exact if_pos hn
  · rw [if_neg hn, candidate_residual_prime_coefficient_eq_zero_of_not_mem
      c L r jStar hr hj take hkeep twist hn, map_zero]


end Bounty
end

section

/- Absolute divisor cross mass on the original candidate window. -/

open Finset Filter Real

namespace Bounty

theorem shifted_divisor_cross_mass_le (T : Finset ℕ) (N : ℕ)
    (hN : ∀ u ∈ T, 2*u+1 ≤ N) :
    (∑ u ∈ T, (u.divisors.card : ℝ) * ((2*u+1).divisors.card : ℝ)) ≤
      (N : ℝ) * (1 + log N) ^ 15 := by
  have h := divisor_square_cross_moment T (fun u => u) (fun u => 2*u+1) N N
    (fun _ _ _ _ h => h) (by intro a _ b _ h; dsimp at h; omega)
    (fun u hu => by have := hN u hu; omega) hN
  have hpos : 0 ≤ (N : ℝ) * (1 + log N)^15 := by positivity
  rw [← sq, sq_sqrt hpos] at h
  apply le_trans ?_ h
  apply sum_le_sum
  intro u _
  have hp := Nat.le_mul_self (u.divisors.card * (2*u+1).divisors.card)
  have hp' : (u.divisors.card : ℝ) * ((2*u+1).divisors.card : ℝ) ≤
      ((u.divisors.card : ℝ) * ((2*u+1).divisors.card : ℝ)) *
        ((u.divisors.card : ℝ) * ((2*u+1).divisors.card : ℝ)) := by exact_mod_cast hp
  nlinarith only [hp']

theorem eventually_arithmetic_window_divisor_cross_mass :
    ∀ᶠ L : ℝ in atTop,
      (∑ u ∈ arithmeticProductWindow 1 (exp L),
        (u.divisors.card : ℝ) * ((2*u+1).divisors.card : ℝ)) ≤ exp L * L^(16 : ℝ) := by
  filter_upwards [eventually_ge_atTop (1 : ℝ),
    eventually_ge_atTop (33*(2+log 33)^15 : ℝ)] with L hL hK
  have hL0 : 0 < L := by linarith
  have hE : 1 ≤ exp L := one_le_exp hL0.le
  let N : ℕ := ⌊33*exp L⌋₊
  have hN0 : 0 < N := Nat.floor_pos.mpr (by linarith)
  have hNpos : (0 : ℝ) < N := by exact_mod_cast hN0
  have hNle : (N : ℝ) ≤ 33*exp L := Nat.floor_le (by positivity)
  have hlog : 1+log N ≤ (2+log 33)*L := by
    have hh := log_le_log hNpos hNle
    rw [log_mul (by norm_num : (33 : ℝ) ≠ 0) (exp_ne_zero L), log_exp] at hh
    have h33 : 0 ≤ log 33 := log_nonneg (by norm_num)
    nlinarith
  have hmass := shifted_divisor_cross_mass_le (arithmeticProductWindow 1 (exp L)) N
    (by
      intro u hu
      have huhi : (u : ℝ) ≤ 16*exp L := by
        simpa only [one_mul] using ((mem_arithmeticProductWindow_iff one_ne_zero (exp L)).mp hu).2
      apply Nat.le_floor
      push_cast
      linarith)
  calc
    _ ≤ (N : ℝ) * (1+log N)^15 := hmass
    _ ≤ (33*exp L) * ((2+log 33)*L)^15 :=
      mul_le_mul hNle (pow_le_pow_left₀ (by positivity) hlog 15) (by positivity) (by positivity)
    _ = (33*(2+log 33)^15) * exp L * L^15 := by rw [mul_pow]; ring
    _ ≤ L * exp L * L^15 := mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right hK (exp_pos _).le) (pow_nonneg hL0.le _)
    _ = exp L * L^(16 : ℝ) := by norm_num only [rpow_ofNat]; ring

end Bounty
end

section

/- Fold the original P-weight into the retained h coefficient by exact supported/free uniqueness. -/

open Finset Filter

namespace Bounty

theorem supported_free_complex_product_reindex (P A B : Finset ℕ)
    (hA : ∀ p ∈ A, p ∈ Nat.factoredNumbers P)
    (hB : ∀ n ∈ B, n ≠ 0 ∧ Disjoint n.primeFactors P)
    (W Q F : ℕ → ℂ) :
    (∑ p ∈ A, ∑ n ∈ B, W p * Q n * F (p * n)) =
      ∑ h ∈ (A ×ˢ B).image (fun z => z.1 * z.2),
        W (primePoolPart P h) * Q (primePoolFreePart P h) * F h := by
  classical
  have hinj : Set.InjOn (fun z : ℕ × ℕ => z.1 * z.2) (↑(A ×ˢ B) : Set (ℕ × ℕ)) := by
    intro x hx y hy hxy
    obtain ⟨hxp, hxn⟩ := mem_product.mp hx
    obtain ⟨hyp, hyn⟩ := mem_product.mp hy
    obtain ⟨hp, hn⟩ := supported_free_product_unique (hA _ hxp) (hB _ hxn).1 (hB _ hxn).2
      (hA _ hyp) (hB _ hyn).1 (hB _ hyn).2 hxy
    exact Prod.ext hp hn
  rw [sum_image hinj, sum_product]
  apply sum_congr rfl
  intro p hp
  apply sum_congr rfl
  intro n hn
  rw [primePoolPart_mul_of_free (hA _ hp) (hB _ hn).1 (hB _ hn).2,
    primePoolFreePart_mul_of_free (hA _ hp) (hB _ hn).1 (hB _ hn).2]

noncomputable def candidateRetainedComplexCoefficient (c L q : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card * r) → Bool)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (h : ℕ) : ℂ :=
  (markedDivisorWeight (candidatePIndices c L) (candidatePBand (c * L)) q
    (fun j => ∑ p ∈ candidatePBand (c * L) j, 1 / (p : ℝ)) (fun _ => 1) (h : ℤ) : ℂ) *
      candidateRemainingComplexCoefficient c L r jStar take twist
        (primePoolFreePart ((candidatePIndices c L).biUnion (candidatePBand (c * L))) h)

theorem eventually_candidate_retained_convolution {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ)
      (take : Fin ((candidateQIndices c L).card * r) → Bool)
      (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (S : Finset ℕ),
      (∀ p ∈ S, p ∈ Nat.factoredNumbers
        ((candidatePIndices c L).biUnion (candidatePBand (c * L)))) → ∀ F : ℕ → ℂ,
      (∑ p ∈ S, ∑ n ∈ orderedSlotProductSupport
        (fun slot : CandidateRemainingSlot c L r take => candidateQSlotChoices c L r jStar slot.val),
        (candidatePWeight c L q p : ℂ) *
          candidateRemainingComplexCoefficient c L r jStar take twist n * F (p * n)) =
      ∑ h ∈ (S ×ˢ orderedSlotProductSupport
        (fun slot : CandidateRemainingSlot c L r take => candidateQSlotChoices c L r jStar slot.val)).image
          (fun z => z.1 * z.2), candidateRetainedComplexCoefficient c L q r jStar take twist h * F h := by
  filter_upwards [eventually_candidate_remaining_support_free hc] with L hfree
  intro q r jStar take twist S hS F
  classical
  rw [supported_free_complex_product_reindex _ S _ hS (hfree r jStar take)]
  apply sum_congr rfl
  intro h hh
  obtain ⟨pn, hpn, rfl⟩ := mem_image.mp hh
  obtain ⟨hp, hn⟩ := mem_product.mp hpn
  obtain ⟨hn0, hnfree⟩ := hfree r jStar take pn.2 hn
  have hp0 := Nat.ne_zero_of_mem_factoredNumbers (hS _ hp)
  rw [primePoolPart_mul_of_free (hS _ hp) hn0 hnfree,
    primePoolFreePart_mul_of_free (hS _ hp) hn0 hnfree]
  unfold candidateRetainedComplexCoefficient
  rw [candidate_marked_weight_mul_of_free c L q hn0 hnfree pn.1,
    primePoolFreePart_mul_of_free (hS _ hp) hn0 hnfree,
    candidate_P_weight_eq_marked c L q hp0]

end Bounty

end

section

/- Divisor-product mass on small finite subsets, with an absolute logarithmic loss. -/

open Finset

namespace Bounty

theorem divisor_product_subset_concentration {α : Type*} [DecidableEq α]
    (S : Finset α) (f g : α → ℕ) (N : ℕ)
    (hf : Set.InjOn f S) (hg : Set.InjOn g S)
    (hNf : ∀ x ∈ S, f x ≤ N) (hNg : ∀ x ∈ S, g x ≤ N) :
    (∑ x ∈ S, ((f x).divisors.card : ℝ) * ((g x).divisors.card : ℝ)) ≤
      Real.sqrt (S.card : ℝ) * Real.sqrt ((N : ℝ) * (1 + Real.log N) ^ 15) := by
  have hmoment := divisor_square_cross_moment S f g N N hf hg hNf hNg
  rw [Real.mul_self_sqrt (by positivity)] at hmoment
  have hcs := Real.sum_mul_le_sqrt_mul_sqrt S (fun _ => (1 : ℝ))
    (fun x => ((f x).divisors.card : ℝ) * ((g x).divisors.card : ℝ))
  simp only [one_mul, one_pow, sum_const, nsmul_eq_mul, mul_one, mul_pow] at hcs
  exact hcs.trans (mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt hmoment) (Real.sqrt_nonneg _))

theorem shifted_divisor_subset_concentration (S : Finset ℕ) (N : ℕ)
    (hN : ∀ u ∈ S, 2 * u + 1 ≤ N) :
    (∑ u ∈ S, (u.divisors.card : ℝ) * ((2 * u + 1).divisors.card : ℝ)) ≤
      Real.sqrt (S.card : ℝ) * Real.sqrt ((N : ℝ) * (1 + Real.log N) ^ 15) := by
  apply divisor_product_subset_concentration S (fun u => u) (fun u => 2 * u + 1) N
  · intro a _ b _ hab
    exact hab
  · intro a _ b _ hab
    change 2 * a + 1 = 2 * b + 1 at hab
    omega
  · intro u hu
    have := hN u hu
    omega
  · exact hN


end Bounty
end

section

/- Real logarithmic phases, with an explicit integration-frequency convention. -/

open MeasureTheory

namespace Bounty

noncomputable def physicalMellinPhase (v t : ℝ) : ℂ :=
  Complex.exp ((v * Real.log t : ℝ) * Complex.I)

theorem physical_mellin_phase_norm (v t : ℝ) : ‖physicalMellinPhase v t‖ = 1 := by
  exact Complex.norm_exp_ofReal_mul_I _

theorem physical_mellin_phase_conj (v t : ℝ) :
    (starRingEnd ℂ) (physicalMellinPhase v t) = physicalMellinPhase (-v) t := by
  unfold physicalMellinPhase
  rw [← Complex.exp_conj]
  congr 1
  simp only [map_mul, Complex.conj_ofReal, Complex.conj_I, neg_mul, Complex.ofReal_neg]
  ring

theorem physical_mellin_phase_ratio (v n Z : ℝ) (D : ℕ)
    (hn : n ≠ 0) (hZ : Z ≠ 0) (hD : D ≠ 0) :
    physicalMellinPhase v (n / Z) * physicalPhase (-v) D =
      physicalMellinPhase v (n / (Z * D)) := by
  have hDr : (D : ℝ) ≠ 0 := by exact_mod_cast hD
  unfold physicalMellinPhase physicalPhase
  rw [← Complex.exp_add, Real.log_div hn hZ,
    Real.log_div hn (mul_ne_zero hZ hDr), Real.log_mul hZ hDr]
  congr 1
  push_cast
  ring

theorem physical_mellin_phase_integrable (ρ : ℝ → ℂ) (ν : ℝ → ℝ)
    (hρ : Integrable ρ) (hν : Continuous ν) (t : ℝ) :
    Integrable (fun v => ρ v * physicalMellinPhase (ν v) t) := by
  have hc : Continuous (fun v => physicalMellinPhase (ν v) t) := by
    unfold physicalMellinPhase
    fun_prop
  exact hρ.mul_bdd hc.aestronglyMeasurable
    (Filter.Eventually.of_forall (fun v => (physical_mellin_phase_norm (ν v) t).le))

end Bounty
end

section

/- The original permutation/ghost/edge path is preserved by exact edge parameter transport. -/

open Finset
open scoped Classical
namespace Bounty
section Events
variable {J K G : Type*} {P : G → Type*}
  (n : ∀ g, P g → ℕ) {M : G → ℕ}
  (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ Δ' D D' : ∀ k c, A k c → G → ℤ)
  (hΔ : ∀ k, Δ k = Δ' k)
  (hD : ∀ k c a g p, ((n g p : ℤ) ∣ D k c a g ↔ (n g p : ℤ) ∣ D' k c a g))

noncomputable def fullPermutationParameterEventEquiv
    (tag : Option (J ⊕ K))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    FullPermutationMixedEvent n S B A Δ D tag x ≃
      FullPermutationMixedEvent n S B A Δ' D' tag x :=
  match tag with
  | none => Equiv.refl _
  | some (.inl _) => Equiv.refl _
  | some (.inr k) => fullActiveParameterEventEquiv n (S k) B (A k)
      (Δ k) (Δ' k) (D k) (D' k) (hΔ k) (hD k) x

theorem full_permutation_parameter_target
    (tag : Option (J ⊕ K))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag x) :
    fullPermutationMixedEventTarget n S B A Δ' D' tag x
        (fullPermutationParameterEventEquiv n S B A Δ Δ' D D' hΔ hD tag x e) =
      fullPermutationMixedEventTarget n S B A Δ D tag x e := by
  cases tag with
  | none => rfl
  | some tag =>
    cases tag with
    | inl j => rfl
    | inr k =>
      exact full_active_parameter_target n (S k) B (A k)
        (Δ k) (Δ' k) (D k) (D' k) (hΔ k) (hD k) x e

theorem full_permutation_parameter_weight [Fintype G] [DecidableEq G]
    (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)
    (tag : Option (J ⊕ K))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag x) :
    fullPermutationMixedEventWeight n S B A Δ' D' ω μ q ρ V tag x
        (fullPermutationParameterEventEquiv n S B A Δ Δ' D D' hΔ hD tag x e) =
      fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V tag x e := by
  cases tag with
  | none => rfl
  | some tag =>
    cases tag with
    | inl j => rfl
    | inr k =>
      exact full_active_parameter_weight n (S k) B (A k)
        (Δ k) (Δ' k) (D k) (D' k) (hΔ k) (hD k) (ω k) μ ρ V x e

noncomputable def fullPermutationParameterPathEquiv (steps : List (Option (J ⊕ K)))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    FiniteEventPath (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x ≃
    FiniteEventPath (FullPermutationMixedEvent n S B A Δ' D')
      (fullPermutationMixedEventTarget n S B A Δ' D') steps x :=
  finiteEventPathEquiv _ _ _ _ id
    (fullPermutationParameterEventEquiv n S B A Δ Δ' D D' hΔ hD)
    (fun tag x e => (full_permutation_parameter_target n S B A Δ Δ' D D' hΔ hD tag x e).symm)
    steps x

theorem full_permutation_parameter_path_terminal (steps : List (Option (J ⊕ K)))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FiniteEventPath (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x) :
    finiteEventPathTerminal _ (fullPermutationMixedEventTarget n S B A Δ' D') steps x
        (fullPermutationParameterPathEquiv n S B A Δ Δ' D D' hΔ hD steps x p) =
      finiteEventPathTerminal _ (fullPermutationMixedEventTarget n S B A Δ D) steps x p :=
  finite_event_path_equiv_terminal _ _ _ _ id _ _ steps x p

theorem full_permutation_parameter_path_weight [Fintype G] [DecidableEq G]
    (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)
    (steps : List (Option (J ⊕ K)))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FiniteEventPath (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x) :
    finiteEventPathWeight _ (fullPermutationMixedEventTarget n S B A Δ' D')
        (fullPermutationMixedEventWeight n S B A Δ' D' ω μ q ρ V) steps x
        (fullPermutationParameterPathEquiv n S B A Δ Δ' D D' hΔ hD steps x p) =
      finiteEventPathWeight _ (fullPermutationMixedEventTarget n S B A Δ D)
        (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V) steps x p :=
  finite_event_path_equiv_weight _ _ _ _ id _ _ _ _
    (full_permutation_parameter_weight n S B A Δ Δ' D D' hΔ hD ω μ q ρ V) steps x p

end Events
end Bounty
end

section

/- A fixed-support logarithmic cutoff with the inverse smoothing width as parameter. -/

open MeasureTheory
open scoped ContDiff FourierTransform

namespace Bounty

noncomputable def typeIIWindowLogLocalizer (s : ℝ) : ℝ :=
  Real.smoothTransition (s + 1) * Real.smoothTransition (Real.log 16 + 1 - s)

noncomputable def typeIIWindowLogCutoff (r s : ℝ) : ℝ :=
  typeIIWindowLogLocalizer s * Real.smoothTransition (r * (Real.exp s - 1)) *
    Real.smoothTransition (r * (16 - Real.exp s))

noncomputable def typeIIWindowLogJoint (y : ℝ × ℝ) : ℝ :=
  typeIIWindowLogLocalizer y.2 *
    Real.smoothTransition (y.1 * (typeIITameExp (Real.log 16 + 1) y.2 - 1)) *
    Real.smoothTransition (y.1 * (16 - typeIITameExp (Real.log 16 + 1) y.2))

theorem typeII_window_log_localizer_eq_one {s : ℝ} (hs : s ∈ Set.Icc 0 (Real.log 16)) :
    typeIIWindowLogLocalizer s = 1 := by
  rw [typeIIWindowLogLocalizer, Real.smoothTransition.one_of_one_le (by linarith [hs.1]),
    Real.smoothTransition.one_of_one_le (by linarith [hs.2]), mul_one]

theorem typeII_window_log_localizer_eq_zero {s : ℝ}
    (hs : s ∉ Set.Icc (-1) (Real.log 16 + 1)) : typeIIWindowLogLocalizer s = 0 := by
  by_cases hlo : s < -1
  · rw [typeIIWindowLogLocalizer, Real.smoothTransition.zero_of_nonpos (by linarith), zero_mul]
  · have hhi : Real.log 16 + 1 < s := lt_of_not_ge (fun h => hs ⟨le_of_not_gt hlo, h⟩)
    rw [typeIIWindowLogLocalizer, Real.smoothTransition.zero_of_nonpos (by linarith : Real.log 16+1-s≤0), mul_zero]

theorem typeII_window_log_localizer_hasCompactSupport :
    HasCompactSupport typeIIWindowLogLocalizer :=
  HasCompactSupport.intro isCompact_Icc (fun _ hs => typeII_window_log_localizer_eq_zero hs)

theorem typeII_window_log_localizer_contDiff : ContDiff ℝ ∞ typeIIWindowLogLocalizer := by
  unfold typeIIWindowLogLocalizer
  fun_prop

theorem typeII_window_log_cutoff_contDiff (r : ℝ) : ContDiff ℝ ∞ (typeIIWindowLogCutoff r) := by
  have hl := typeII_window_log_localizer_contDiff
  unfold typeIIWindowLogCutoff
  fun_prop

theorem typeII_window_log_cutoff_hasCompactSupport (r : ℝ) :
    HasCompactSupport (typeIIWindowLogCutoff r) :=
  typeII_window_log_localizer_hasCompactSupport.mul_right.mul_right

theorem typeII_window_log_cutoff_eq_smooth {δ : ℝ} (hδ : 0 < δ) (s : ℝ) :
    typeIIWindowLogCutoff δ⁻¹ s = typeIIWindowSmooth δ (Real.exp s) := by
  have heq : typeIIWindowLogCutoff δ⁻¹ s =
      typeIIWindowLogLocalizer s * typeIIWindowSmooth δ (Real.exp s) := by
    simp only [typeIIWindowLogCutoff, typeIIWindowSmooth, div_eq_mul_inv]
    rw [mul_comm δ⁻¹ (Real.exp s - 1), mul_comm δ⁻¹ (16 - Real.exp s)]
    ring
  rw [heq]
  by_cases hz : typeIIWindowSmooth δ (Real.exp s) = 0
  · rw [hz, mul_zero]
  · have hs := typeII_window_smooth_support hδ hz
    have hlo : 0 < s := by simpa using hs.1
    have hhi : s < Real.log 16 := (Real.lt_log_iff_exp_lt (by norm_num)).mpr hs.2
    rw [typeII_window_log_localizer_eq_one ⟨hlo.le, hhi.le⟩, one_mul]

theorem typeII_window_log_joint_hasTemperateGrowth :
    Function.HasTemperateGrowth typeIIWindowLogJoint := by
  have hr : Function.HasTemperateGrowth (fun y : ℝ × ℝ => y.1) :=
    (ContinuousLinearMap.fst ℝ ℝ ℝ).hasTemperateGrowth
  have hs : Function.HasTemperateGrowth (fun y : ℝ × ℝ => y.2) :=
    (ContinuousLinearMap.snd ℝ ℝ ℝ).hasTemperateGrowth
  have hl := (typeII_window_log_localizer_hasCompactSupport.hasTemperateGrowth
    typeII_window_log_localizer_contDiff).comp hs
  have he := (typeII_tame_exp_hasTemperateGrowth (Real.log 16 + 1)).comp hs
  have hg := smoothTransition_hasTemperateGrowth
  unfold typeIIWindowLogJoint
  fun_prop

theorem typeII_window_log_joint_eq (r s : ℝ) :
    typeIIWindowLogJoint (r, s) = typeIIWindowLogCutoff r s := by
  by_cases hz : typeIIWindowLogLocalizer s = 0
  · simp only [typeIIWindowLogJoint, typeIIWindowLogCutoff, hz, zero_mul]
  · have hs : s ∈ Set.Icc (-1) (Real.log 16 + 1) :=
      by_contra (fun h => hz (typeII_window_log_localizer_eq_zero h))
    have hp : 0 < Real.log 16 := Real.log_pos (by norm_num)
    have hb : |s| ≤ 2 * (Real.log 16 + 1 + 1) :=
      abs_le.mpr ⟨by linarith [hs.1], by linarith [hs.2]⟩
    simp only [typeIIWindowLogJoint, typeIIWindowLogCutoff, typeII_tame_exp_eq hb]

noncomputable def typeIIWindowLogSchwartz (r : ℝ) : SchwartzMap ℝ ℂ :=
  ((typeII_window_log_cutoff_hasCompactSupport r).comp_left
    (g := fun x : ℝ => (x : ℂ)) (by simp)).toSchwartzMap
    (Complex.ofRealCLM.contDiff.comp (typeII_window_log_cutoff_contDiff r))

noncomputable def typeIIWindowFourier (r : ℝ) : SchwartzMap ℝ ℂ := 𝓕 (typeIIWindowLogSchwartz r)

theorem typeII_window_fourier_integrable (r : ℝ) : Integrable (typeIIWindowFourier r) :=
  (typeIIWindowFourier r).integrable

theorem typeII_window_fourier_moment_integrable (r : ℝ) (M : ℕ) :
    Integrable (fun ξ : ℝ => ‖ξ‖ ^ M * ‖typeIIWindowFourier r ξ‖) :=
  (typeIIWindowFourier r).integrable_pow_mul volume M

theorem typeII_window_fourier_inversion (r s : ℝ) :
    (typeIIWindowLogCutoff r s : ℂ) =
      ∫ ξ : ℝ, Complex.exp (((2 * Real.pi * ξ * s : ℝ) : ℂ) * Complex.I) *
        typeIIWindowFourier r ξ := by
  have hi := congrArg (fun f : SchwartzMap ℝ ℂ => f s)
    (FourierPair.fourierInv_fourier_eq (E := SchwartzMap ℝ ℂ) (F := SchwartzMap ℝ ℂ)
      (typeIIWindowLogSchwartz r))
  rw [SchwartzMap.fourierInv_coe, Real.fourierInv_eq'] at hi
  change (∫ ξ : ℝ, Complex.exp (((2 * Real.pi * inner ℝ ξ s : ℝ) : ℂ) * Complex.I) •
    typeIIWindowFourier r ξ) = (typeIIWindowLogCutoff r s : ℂ) at hi
  rw [← hi]
  apply integral_congr_ae
  filter_upwards [] with ξ
  simp only [RCLike.inner_apply, starRingEnd_apply, star_trivial, smul_eq_mul]
  congr 2
  push_cast
  ring

end Bounty
end

section

/- Pool-invariant endpoint energy on the exceptional square-divisibility set. -/

open Finset

namespace Bounty

theorem invariant_triple_endpoint_square_energy
    (Q P : Finset ℕ) (α β γ : ℕ → ℂ)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (hP : ∀ p ∈ P, p ∈ Nat.factoredNumbers Q)
    (S : Finset ℕ) (N : ℕ) (hS : ∀ n ∈ S, n ≤ N) :
    (∑ n ∈ S.filter (fun n => ∃ p ∈ P, p ^ 2 ∣ n),
      ‖invariantTripleEndpoint Q α β γ n‖ ^ 2) ≤
      ((A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15) *
        ∑ p ∈ P, 1 / (p : ℝ) ^ 2 := by
  classical
  let f := fun n : ℕ => ‖invariantTripleEndpoint Q α β γ n‖ ^ 2
  have hpoint (n : ℕ) : (if ∃ p ∈ P, p ^ 2 ∣ n then f n else 0) ≤
      ∑ p ∈ P, if p ^ 2 ∣ n then f n else 0 := by
    by_cases hn : ∃ p ∈ P, p ^ 2 ∣ n
    · obtain ⟨p, hp, hpn⟩ := hn
      rw [if_pos ⟨p, hp, hpn⟩]
      calc
        f n = (if p ^ 2 ∣ n then f n else 0) := (if_pos hpn).symm
        _ ≤ _ := single_le_sum (s := P)
          (f := fun r => if r ^ 2 ∣ n then f n else 0)
          (fun r _ => by split_ifs <;> positivity) hp
    · rw [if_neg hn]
      exact sum_nonneg (fun p _ => by split_ifs <;> positivity)
  change (∑ n ∈ S.filter (fun n => ∃ p ∈ P, p ^ 2 ∣ n), f n) ≤ _
  rw [sum_filter]
  calc
    _ ≤ ∑ n ∈ S, ∑ p ∈ P, if p ^ 2 ∣ n then f n else 0 :=
      sum_le_sum (fun n _ => hpoint n)
    _ = ∑ p ∈ P, ∑ n ∈ S.filter (fun n => p ^ 2 ∣ n), f n := by
      rw [sum_comm]
      simp only [sum_filter]
    _ ≤ ∑ p ∈ P, (A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15 /
        (p : ℝ) ^ 2 := by
      apply sum_le_sum
      intro p hp
      have hsq : p ^ 2 ∈ Nat.factoredNumbers Q := by
        simpa only [pow_two] using Nat.mul_mem_factoredNumbers (hP p hp) (hP p hp)
      simpa only [Nat.cast_pow] using
        invariant_triple_endpoint_divisible_energy Q α β γ hA hB hC hα hβ hγ
          (S.filter (fun n => p ^ 2 ∣ n)) (p ^ 2) N hsq
          (fun n hn => (mem_filter.mp hn).2)
          (fun n hn => hS n (mem_filter.mp hn).1)
    _ = _ := by rw [mul_sum]; apply sum_congr rfl; intro p _; ring

theorem invariant_triple_endpoint_square_error_energy
    (Q P : Finset ℕ) (α β γ : ℕ → ℂ)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (hP : ∀ p ∈ P, p ∈ Nat.factoredNumbers Q)
    (S : Finset ℕ) (N : ℕ) (hS : ∀ n ∈ S, n ≤ N)
    (e : ℕ → ℂ) {H : ℝ}
    (he : ∀ n ∈ S, (∀ p ∈ P, ¬ p ^ 2 ∣ n) → e n = 0)
    (hbound : ∀ n ∈ S, ‖e n‖ ≤ H * ‖invariantTripleEndpoint Q α β γ n‖) :
    (∑ n ∈ S, ‖e n‖ ^ 2) ≤
      H ^ 2 * (((A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15) *
        ∑ p ∈ P, 1 / (p : ℝ) ^ 2) := by
  classical
  have heq : (∑ n ∈ S, ‖e n‖ ^ 2) =
      ∑ n ∈ S.filter (fun n => ∃ p ∈ P, p ^ 2 ∣ n), ‖e n‖ ^ 2 := by
    rw [sum_filter]
    apply sum_congr rfl
    intro n hn
    split_ifs with hp
    · rfl
    · have hz := he n hn (by simpa only [not_exists, not_and] using hp)
      simp only [hz, norm_zero, zero_pow (by decide : 2 ≠ 0)]
  rw [heq]
  calc
    _ ≤ ∑ n ∈ S.filter (fun n => ∃ p ∈ P, p ^ 2 ∣ n),
        H ^ 2 * ‖invariantTripleEndpoint Q α β γ n‖ ^ 2 := by
      apply sum_le_sum
      intro n hn
      simpa only [mul_pow] using pow_le_pow_left₀ (norm_nonneg _)
        (hbound n (mem_filter.mp hn).1) 2
    _ = H ^ 2 * ∑ n ∈ S.filter (fun n => ∃ p ∈ P, p ^ 2 ∣ n),
        ‖invariantTripleEndpoint Q α β γ n‖ ^ 2 := (mul_sum ..).symm
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (invariant_triple_endpoint_square_energy Q P α β γ hA hB hC hα hβ hγ hP S N hS)
      (sq_nonneg H)

end Bounty
end

section

/- Common birth labels on the unchanged original paths retain their exact owning event. -/

open Classical
namespace Bounty
section Path
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ) (steps : List (Option (J ⊕ K)))
  (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
  (p : FullPermutationMixedPath n S B A Δ D steps x)

noncomputable def fullMixedCommonPathBornData : FullMixedCommonStepAddress M B steps → Option (FullMixedBornData n) :=
  optionalBirthExtension (fullMixedCommonStepEmbedding S B steps) (fullMixedPathBornData n S B A Δ D steps x p)

noncomputable def fullMixedCommonPathBirthLabel (a : FullMixedCommonStepAddress M B steps) :
    Option ((g : Fin N) × P g) :=
  (fullMixedCommonPathBornData n S B A Δ D steps x p a).map (fullMixedBornPrime n)

noncomputable def fullMixedCommonPathBirthPerformed (a : FullMixedCommonStepAddress M B steps) : Prop :=
  (fullMixedCommonPathBornData n S B A Δ D steps x p a).isSome = true

theorem full_mixed_common_path_data_embed (a : FullMixedBirthAddress S B steps) :
    fullMixedCommonPathBornData n S B A Δ D steps x p (fullMixedCommonStepEmbedding S B steps a) =
      fullMixedPathBornData n S B A Δ D steps x p a := optional_birth_extension_apply _ _ _

theorem full_mixed_common_path_label_embed (a : FullMixedBirthAddress S B steps) :
    fullMixedCommonPathBirthLabel n S B A Δ D steps x p (fullMixedCommonStepEmbedding S B steps a) =
      fullMixedPathBirthLabel n S B A Δ D steps x p a := by
  unfold fullMixedCommonPathBirthLabel fullMixedPathBirthLabel
  rw [full_mixed_common_path_data_embed]

theorem full_mixed_common_path_label_extension (a : FullMixedCommonStepAddress M B steps) :
    fullMixedCommonPathBirthLabel n S B A Δ D steps x p a =
      optionalBirthExtension (fullMixedCommonStepEmbedding S B steps)
        (fullMixedPathBirthLabel n S B A Δ D steps x p) a := optional_birth_extension_map _ _ _ _

theorem full_mixed_common_path_data_occurrence (i : Fin steps.length)
    (a : FullMixedCommonLocalAddress M B (steps.get i)) :
    let e := finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x p i
    fullMixedCommonPathBornData n S B A Δ D steps x p ⟨i, a⟩ =
      fullMixedCommonEventBornData n S B A Δ D (steps.get i) e.1 e.2 a := by
  exact optional_birth_extension_sigma (fun i => fullMixedCommonLocalEmbedding S B (steps.get i))
    (fullMixedPathBornData n S B A Δ D steps x p) i a

theorem full_mixed_common_path_label_occurrence (i : Fin steps.length)
    (a : FullMixedCommonLocalAddress M B (steps.get i)) :
    let e := finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x p i
    fullMixedCommonPathBirthLabel n S B A Δ D steps x p ⟨i, a⟩ =
      fullMixedCommonEventBirthLabel n S B A Δ D (steps.get i) e.1 e.2 a := by
  unfold fullMixedCommonPathBirthLabel fullMixedCommonEventBirthLabel
  rw [full_mixed_common_path_data_occurrence]

theorem full_mixed_common_path_distinct_iff :
    (∀ a b z, fullMixedCommonPathBirthLabel n S B A Δ D steps x p a = some z →
      fullMixedCommonPathBirthLabel n S B A Δ D steps x p b = some z → a = b) ↔
    (∀ a b z, fullMixedPathBirthLabel n S B A Δ D steps x p a = some z →
      fullMixedPathBirthLabel n S B A Δ D steps x p b = some z → a = b) := by
  simp only [full_mixed_common_path_label_extension]
  exact optional_birth_extension_distinct_iff _ _

theorem full_mixed_common_path_all_labels_iff (Q : ((g : Fin N) × P g) → Prop) :
    (∀ a z, fullMixedCommonPathBirthLabel n S B A Δ D steps x p a = some z → Q z) ↔
      (∀ a z, fullMixedPathBirthLabel n S B A Δ D steps x p a = some z → Q z) := by
  simp only [full_mixed_common_path_label_extension]
  exact optional_birth_extension_all_iff _ _ _

end Path
end Bounty
end

section

/- Absolute finite factorization and shifted correlation bounds from the divisor fourth moment. -/

open Finset Real

namespace Bounty

noncomputable def factorizationAbsoluteMass (M H : Finset ℕ) (α a : ℕ → ℂ) (z : ℕ) : ℝ :=
  ∑ v ∈ (M ×ˢ H).filter (fun v => v.1*v.2 = z), ‖α v.1 * a v.2‖

theorem factorization_absolute_mass_nonneg (M H : Finset ℕ) (α a : ℕ → ℂ) (z : ℕ) :
    0 ≤ factorizationAbsoluteMass M H α a z := sum_nonneg (fun _ _ => norm_nonneg _)

theorem factorization_absolute_mass_le (M H : Finset ℕ) (α a : ℕ → ℂ)
    {A B : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hα : ∀ m ∈ M, ‖α m‖ ≤ A)
    (ha : ∀ h ∈ H, h ≠ 0 → ‖a h‖ ≤ B*(h.divisors.card : ℝ))
    {z : ℕ} (hz : z ≠ 0) :
    factorizationAbsoluteMass M H α a z ≤ A*B*(z.divisors.card : ℝ)^2 := by
  classical
  let S := (M ×ˢ H).filter (fun v => v.1*v.2 = z)
  have hprod (v : ℕ × ℕ) (hv : v ∈ S) : v.1*v.2 = z := (mem_filter.mp hv).2
  have hc : S.card ≤ z.divisors.card := by
    apply card_le_card_of_injOn Prod.fst
    · intro v hv
      exact Nat.mem_divisors.mpr ⟨⟨v.2, (hprod v hv).symm⟩, hz⟩
    · intro v hv w hw heq
      apply Prod.ext heq
      have hp : v.1 ≠ 0 := by intro h; apply hz; simpa [h] using (hprod v hv).symm
      have hh : v.1*v.2 = v.1*w.2 := by
        simpa only [heq] using (hprod v hv).trans (hprod w hw).symm
      exact Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero hp) hh
  have hs : factorizationAbsoluteMass M H α a z ≤ (S.card : ℝ)*(A*B*(z.divisors.card : ℝ)) := by
    unfold factorizationAbsoluteMass
    calc
      _ ≤ ∑ v ∈ S, A*B*(z.divisors.card : ℝ) := by
        apply sum_le_sum
        intro v hv
        have hvp := mem_product.mp (mem_filter.mp hv).1
        have hvz : v.2 ≠ 0 := by intro h; apply hz; simpa [h] using (hprod v hv).symm
        have hd : v.2 ∣ z := ⟨v.1, by simpa [mul_comm] using (hprod v hv).symm⟩
        have hcard : (v.2.divisors.card : ℝ) ≤ z.divisors.card := by
          exact_mod_cast card_le_card (Nat.divisors_subset_of_dvd hz hd)
        rw [norm_mul]
        calc
          _ ≤ A*(B*(v.2.divisors.card : ℝ)) :=
            mul_le_mul (hα v.1 hvp.1) (ha v.2 hvp.2 hvz) (norm_nonneg _) hA
          _ ≤ A*(B*(z.divisors.card : ℝ)) :=
            mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hcard hB) hA
          _ = _ := by ring
      _ = _ := by simp
  calc
    _ ≤ (S.card : ℝ)*(A*B*(z.divisors.card : ℝ)) := hs
    _ ≤ (z.divisors.card : ℝ)*(A*B*(z.divisors.card : ℝ)) := by
      exact mul_le_mul_of_nonneg_right (by exact_mod_cast hc) (by positivity)
    _ = _ := by ring

theorem factorization_absolute_cross_moment {ι : Type*} [DecidableEq ι]
    (S : Finset ι) (f g : ι → ℕ) (N : ℕ)
    (M H : Finset ℕ) (α a : ℕ → ℂ) {A B : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hα : ∀ m ∈ M, ‖α m‖ ≤ A)
    (ha : ∀ h ∈ H, h ≠ 0 → ‖a h‖ ≤ B*(h.divisors.card : ℝ))
    (hf : Set.InjOn f S) (hg : Set.InjOn g S)
    (hf0 : ∀ x ∈ S, f x ≠ 0) (hg0 : ∀ x ∈ S, g x ≠ 0)
    (hfN : ∀ x ∈ S, f x ≤ N) (hgN : ∀ x ∈ S, g x ≤ N) :
    (∑ x ∈ S, factorizationAbsoluteMass M H α a (f x) *
      factorizationAbsoluteMass M H α a (g x)) ≤
      (A*B)^2*(N : ℝ)*(1+log N)^15 := by
  have hmoment := divisor_square_cross_moment S f g N N hf hg hfN hgN
  have hN : 0 ≤ (N : ℝ)*(1+log N)^15 := by
    by_cases h : N = 0
    · simp [h]
    · have hlog : 0 ≤ log (N : ℝ) := log_nonneg (by exact_mod_cast Nat.one_le_iff_ne_zero.mpr h)
      positivity
  rw [← pow_two, sq_sqrt hN] at hmoment
  calc
    _ ≤ ∑ x ∈ S, (A*B)^2*((f x).divisors.card : ℝ)^2*((g x).divisors.card : ℝ)^2 := by
      apply sum_le_sum
      intro x hx
      calc
        _ ≤ (A*B*((f x).divisors.card : ℝ)^2)*(A*B*((g x).divisors.card : ℝ)^2) :=
          mul_le_mul (factorization_absolute_mass_le M H α a hA hB hα ha (hf0 x hx))
            (factorization_absolute_mass_le M H α a hA hB hα ha (hg0 x hx))
            (factorization_absolute_mass_nonneg M H α a (g x)) (by positivity)
        _ = _ := by ring
    _ = (A*B)^2 * ∑ x ∈ S, ((f x).divisors.card : ℝ)^2*((g x).divisors.card : ℝ)^2 := by
      rw [mul_sum]; apply sum_congr rfl; intro x hx; ring
    _ ≤ (A*B)^2*((N : ℝ)*(1+log N)^15) := mul_le_mul_of_nonneg_left hmoment (sq_nonneg _)
    _ = _ := by ring

end Bounty
end

section

/- The actual normalized smooth kernel satisfies the manuscript's quadratic replacement error. -/

open Finset MeasureTheory
open scoped NNReal

namespace Bounty

theorem local_mellin_kernel_unit_support (t : ℝ) (ht : 1 < |t|) :
    localMellinKernelSchwartz t = 0 := by
  change (localMellinKernel t : ℂ) = 0
  rw [local_mellin_kernel_support]
  · norm_num
  · apply lt_trans _ ht
    apply (div_lt_one (by positivity : 0 < 16*Real.pi+1)).mpr
    linarith [Real.pi_gt_three]

theorem normalized_local_kernel_error_bound (S : Finset ℕ) (a : ℕ → ℂ)
    {K : ℝ → ℂ} {C : ℝ≥0} (hK : LipschitzWith C K)
    (hsupp : ∀ t, 1 < |t| → K t = 0) (hS : ∀ n ∈ S, 0 < n)
    {Y H : ℝ} (hY : 0 < Y) (hH : 1 ≤ H) (hsmall : H ≤ Y/8) :
    (∫ v in Set.Icc (Y/2) (3*Y),
      ‖∑ n ∈ S, a n * (K (((n:ℝ)-v)/H) - K (v*Real.log ((n:ℝ)/v)/H))‖^2) / H^2 ≤
        (5120*(C:ℝ)^2) * (H/Y)^2 * (∑ n ∈ S, ‖a n‖^2) := by
  have hHp : 0 < H := lt_of_lt_of_le zero_lt_one hH
  have hi := finite_local_kernel_error_integral S a hK hsupp hS hY hHp hsmall
  apply (div_le_div_of_nonneg_right hi (sq_nonneg H)).trans
  have heq :
      ((4*H+1)*((C:ℝ)*(16*H/Y))^2*(4*H)*(∑ n ∈ S, ‖a n‖^2)) / H^2 =
        1024*(C:ℝ)^2*H*(4*H+1)/Y^2*(∑ n ∈ S, ‖a n‖^2) := by
    field_simp
    ring
  rw [heq]
  have hm : 0 ≤ ∑ n ∈ S, ‖a n‖^2 := sum_nonneg (fun n _ => sq_nonneg _)
  apply mul_le_mul_of_nonneg_right _ hm
  rw [div_pow, ← mul_div_assoc]
  apply (div_le_div_iff_of_pos_right (sq_pos_of_pos hY)).mpr
  nlinarith [mul_nonneg (sq_nonneg (C:ℝ)) (show 0 ≤ H*(H-1) by positivity)]

theorem exists_actual_local_kernel_error_constant :
    ∃ C : ℝ, 0 < C ∧ ∀ (S : Finset ℕ) (a : ℕ → ℂ),
      (∀ n ∈ S, 0 < n) → ∀ Y H : ℝ, 0 < Y → 1 ≤ H → H ≤ Y/8 →
      (∫ v in Set.Icc (Y/2) (3*Y),
        ‖∑ n ∈ S, a n * (localMellinKernelSchwartz (((n:ℝ)-v)/H) -
          localMellinKernelSchwartz (v*Real.log ((n:ℝ)/v)/H))‖^2) / H^2 ≤
          C * (H/Y)^2 * (∑ n ∈ S, ‖a n‖^2) := by
  obtain ⟨K, hK⟩ := local_mellin_kernel_lipschitz
  refine ⟨5120*(K:ℝ)^2+1, by positivity, ?_⟩
  intro S a hS Y H hY hH hsmall
  apply (normalized_local_kernel_error_bound S a hK local_mellin_kernel_unit_support hS hY hH hsmall).trans
  gcongr
  linarith

end Bounty
end

section

/- The weighted Mellin energy is a genuine finite integral for exponents greater than one. -/

open Finset MeasureTheory

namespace Bounty

theorem local_mellin_polynomial_continuous (S : Finset ℕ) (a : ℕ → ℂ) :
    Continuous (localMellinPolynomial S a) := by
  unfold localMellinPolynomial
  fun_prop

theorem local_mellin_polynomial_norm_le (S : Finset ℕ) (a : ℕ → ℂ) (t : ℝ) :
    ‖localMellinPolynomial S a t‖ ≤ ∑ n ∈ S, ‖a n‖ := by
  unfold localMellinPolynomial
  apply (norm_sum_le _ _).trans
  apply sum_le_sum
  intro n hn
  rw [norm_mul, Complex.norm_exp_ofReal_mul_I, mul_one]

theorem local_mellin_polynomial_cpow (S : Finset ℕ) (a : ℕ → ℂ)
    (hS : ∀ n ∈ S, 0 < n) (t : ℝ) :
    localMellinPolynomial S a t = ∑ n ∈ S, a n * (n:ℂ)^((t:ℂ)*Complex.I) := by
  unfold localMellinPolynomial
  apply sum_congr rfl
  intro n hn
  have hnR : 0 < (n:ℝ) := by exact_mod_cast hS n hn
  rw [Complex.cpow_def_of_ne_zero (by exact_mod_cast (hS n hn).ne')]
  rw [show (n:ℂ) = ((n:ℝ):ℂ) by norm_cast, ← Complex.ofReal_log hnR.le]
  congr 2
  push_cast
  ring

theorem local_mellin_weighted_energy_integrable (S : Finset ℕ) (a : ℕ → ℂ)
    {h j : ℝ} (hh : 0 < h) (hj : 1 < j) :
    Integrable (fun t : ℝ => (1+|h*t|)^(-j) * ‖localMellinPolynomial S a t‖^2) := by
  have hi : Integrable (fun t : ℝ => (1+|t|)^(-j)) := by
    simpa only [Real.norm_eq_abs] using
      (integrable_one_add_norm (E := ℝ) (r := j) (by simpa using hj))
  have hs := hi.comp_mul_left' hh.ne'
  apply (hs.mul_const ((∑ n ∈ S, ‖a n‖)^2)).mono'
  · have hc : Continuous (fun t : ℝ => (1+|h*t|)^(-j) * ‖localMellinPolynomial S a t‖^2) := by
      have hp := local_mellin_polynomial_continuous S a
      have hb : Continuous (fun t : ℝ => 1+|h*t|) := by fun_prop
      exact (hb.rpow_const (fun t => Or.inl (by positivity))).mul (hp.norm.pow 2)
    exact hc.aestronglyMeasurable
  · filter_upwards [] with t
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    exact mul_le_mul_of_nonneg_left
      (pow_le_pow_left₀ (norm_nonneg _) (local_mellin_polynomial_norm_le S a t) 2)
      (Real.rpow_nonneg (by positivity) _)

end Bounty
end

section

/- Rough factors outside all group pools leave the actual weighted marked sum unchanged. -/

open Finset

namespace Bounty

theorem weighted_group_marked_sum_congr_divisor_pools {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (q : ℝ) (V : G → ℝ) (t : G → ℕ) (n m : ℤ)
    (b : GroupMarkedLists P t → ℂ)
    (hpool : ∀ g, physicalDivisorPool P g n = physicalDivisorPool P g m) :
    weightedGroupMarkedSum P q V t n b = weightedGroupMarkedSum P q V t m b := by
  rw [weighted_group_marked_sum_eq_average, weighted_group_marked_sum_eq_average,
    group_marked_average_congr_divisor_pools P t n m b hpool]
  congr 1
  apply congrArg (fun x : ℝ => (x : ℂ))
  unfold markedDivisorWeight
  apply prod_congr rfl
  intro g _
  simp only [physicalOmega, hpool g]

theorem weighted_group_marked_sum_mul_disjoint {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (q : ℝ) (V : G → ℝ) (t : G → ℕ)
    (hP : ∀ g, ∀ p ∈ P g, p.Prime) {Q : Finset ℕ}
    (hPQ : ∀ g, Disjoint (P g) Q) {b : ℕ} (hb : b ∈ Nat.factoredNumbers Q)
    (a : ℕ) (c : GroupMarkedLists P t → ℂ) :
    weightedGroupMarkedSum P q V t ((a * b : ℕ) : ℤ) c =
      weightedGroupMarkedSum P q V t (a : ℤ) c := by
  apply weighted_group_marked_sum_congr_divisor_pools
  intro g
  exact physical_divisor_pool_mul_disjoint P g (hP g) (hPQ g) hb a

end Bounty
