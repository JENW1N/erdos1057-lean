/- Birth sample coordinates embed into the unchanged global chronological address set. -/

open Classical

namespace Bounty

section Occurrence
variable {J K : Type*} {N : ℕ} {M : Fin N → ℕ}
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (steps : List (Option (J ⊕ K))) (u : Fin steps.length)

noncomputable def fullMixedOccurrenceAddressEmbedding :
    FullMixedLocalBirthAddress S B (steps.get u) ↪
      Fin (Fintype.card (FullMixedBirthAddress S B steps)) where
  toFun a := (fullMixedBirthOrder S B steps).symm ⟨u, a⟩
  inj' := by
    intro a b h
    have he := (fullMixedBirthOrder S B steps).symm.injective h
    simpa only [Sigma.mk.inj_iff, heq_eq_eq, true_and] using he

theorem full_mixed_occurrence_address_owner
    (a : FullMixedLocalBirthAddress S B (steps.get u)) :
    fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps
      (fullMixedOccurrenceAddressEmbedding S B steps u a)) = u := by
  change fullMixedBirthOwner S B steps
    ((fullMixedBirthOrder S B steps) ((fullMixedBirthOrder S B steps).symm ⟨u, a⟩)) = u
  rw [Equiv.apply_symm_apply]
  rfl

end Occurrence

section Samples
variable {J K : Type*} {N : ℕ} {P Z : Fin N → Type*} {M : Fin N → ℕ}
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)

noncomputable def coupledGhostLocalSampleEmbedding (j : J)
    (s : ProductBoundedOrderedState P Z M B) (sk : CoupledGhostSkeleton M B s) :
    CoupledGhostSampleIndex M B s sk ↪ FullMixedLocalBirthAddress S B (some (.inl j)) where
  toFun i := ⟨i.1, ⟨i.2.val, lt_of_lt_of_le i.2.isLt (Nat.le_of_lt_succ (sk i.1).1.isLt)⟩⟩
  inj' := by
    rintro ⟨g, a⟩ ⟨h, b⟩ he
    simp only [Sigma.mk.inj_iff] at he
    rcases he with ⟨rfl, he⟩
    have hv := congrArg Fin.val (eq_of_heq he)
    have hab : a = b := Fin.ext hv
    subst b
    rfl

noncomputable def fullEdgeLocalSampleEmbedding (n : ∀ g, P g → ℕ) (k : K)
    (A : SharedActiveLabels P (S k) → Type*) (Δ D : ∀ c, A c → Fin N → ℤ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (sk : FullActiveEdgeSkeleton n (S k) B A Δ D s) :
    FullActiveEdgeSampleIndex n (S k) B A Δ D s sk ↪
      FullMixedLocalBirthAddress S B (some (.inr k) : Option (J ⊕ K)) where
  toFun i := ⟨i.1, i.2.val⟩
  inj' := by
    rintro ⟨g, a⟩ ⟨h, b⟩ he
    change (⟨g, a.val⟩ : (g : Fin N) × Fin (S k g)ᶜ.card) = ⟨h, b.val⟩ at he
    simp only [Sigma.mk.inj_iff] at he
    rcases he with ⟨rfl, he⟩
    have hab : a = b := Subtype.ext (eq_of_heq he)
    subst b
    rfl

end Samples

end Bounty
