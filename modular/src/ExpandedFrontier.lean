noncomputable def candidateCoefficientWindowMass (c L q : ℝ) (r jStar : ℕ) : ℝ :=
  ∑ u ∈ arithmeticProductWindow 1 (Real.exp L), candidateCoefficient c L q r jStar u

theorem eventually_candidate_ordinary_le_coefficient_mass {c q : ℝ} (hc : 0 < c)
    (hq : 0 ≤ q) (r : ℕ) :
    ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ,
      candidateOrdinaryWindowMass c L q r jStar ≤ candidateCoefficientWindowMass c L q r jStar := by
  filter_upwards [eventually_candidate_Q_weight_free_support hc r] with L hfree
  intro jStar
  apply supported_free_window_convolution_le
    ((candidatePIndices c L).biUnion (candidatePBand (c * L)))
    (candidateSmallPSet c L (Real.exp ((c / 100) * L)))
    (candidatePWeight c L q) (candidateQWeight c L r jStar)
    (candidateCoefficient c L q r jStar) (Real.exp L)
  · intro p hp
    exact ((mem_candidateSmallPSet_iff c L _ p).mp hp).2
  · exact hfree jStar
  · exact fun u _ => candidate_coefficient_nonneg c L hq r jStar u
  · intro p hp n hn
    exact candidate_coefficient_mul_of_free c L q r jStar
      ((mem_candidateSmallPSet_iff c L _ p).mp hp).2 (hfree jStar n hn).1 (hfree jStar n hn).2

theorem exists_candidate_coefficient_window_mass_lower {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1) :
    ∃ K : ℝ, 0 < K ∧ ∃ J : ℕ,
      ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, J < jStar →
        K * (Real.exp L / L) * candidateOneMarkedHarmonicMass c L q *
          candidateQHarmonicMass c L r jStar ≤
        candidateCoefficientWindowMass c L q r jStar := by
  obtain ⟨K, hK, J, hmass⟩ := exists_candidate_ordinary_window_mass_lower hc hr hq0 hq1 hcenter
  refine ⟨K, hK, J, ?_⟩
  filter_upwards [hmass, eventually_candidate_ordinary_le_coefficient_mass hc hq0 r] with L hm hcMass
  intro jStar hj
  exact (hm jStar hj).trans (hcMass jStar)

theorem exists_candidate_coefficient_mass_polynomial_lower {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∃ J : ℕ, ∀ jStar : ℕ, J < jStar →
      ∀ᶠ L : ℝ in atTop,
        Real.exp L * L^(-C) ≤ candidateCoefficientWindowMass c L q r jStar := by
  obtain ⟨C, hC, J, hmass⟩ := exists_candidate_ordinary_mass_polynomial_lower hc hr hq0 hq1 hcenter
  refine ⟨C, hC, J, ?_⟩
  intro jStar hj
  filter_upwards [hmass jStar hj, eventually_candidate_ordinary_le_coefficient_mass hc hq0 r] with L hm hcMass
  exact hm.trans (hcMass jStar)
end

