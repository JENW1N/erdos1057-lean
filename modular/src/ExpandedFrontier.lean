/- The full normalized candidate compact-allocation sum as a retained-factor integral. -/

open Finset Filter MeasureTheory

namespace Bounty

theorem eventually_candidate_retained_allocation_integral {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ) (R : ℝ) (S : Finset ℕ)
      (take : Fin ((candidateQIndices c L).card*r) → Bool),
      (∀ p ∈ S, p ∈ Nat.factoredNumbers
        ((candidatePIndices c L).biUnion (candidatePBand (c*L)))) →
      (∀ i, candidateAllocationActive c L r jStar i = false → take i = false) →
      ∀ F : ℕ → ℕ → ℂ,
      (∑ p ∈ S, (candidatePWeight c L q p : ℂ) *
        ((∑ x : ∀ slot, candidateQSlotChoices c L r jStar slot,
          (candidateCompactAllocationWeight c L r jStar x R take : ℂ) *
            F (candidateAllocatedFactor c L r jStar x take)
              (candidateRetainedFactor c L r jStar p x take)) /
            (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ))) =
        ∫ ξ, candidateRetainedAllocationIntegrand c L q r jStar R S take F ξ := by
  filter_upwards [eventually_candidate_retained_allocation_integrand_eq hc] with L hL
  intro q r jStar R S take hS hkeep F
  rw [candidate_full_P_compact_allocation_integral c L q r jStar R S take hkeep F]
  apply integral_congr_ae
  exact Filter.Eventually.of_forall (hL q r jStar R S take hS F)

theorem eventually_candidate_full_P_retained_allocation_integral {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ) (R : ℝ)
      (take : Fin ((candidateQIndices c L).card*r) → Bool),
      (∀ i, candidateAllocationActive c L r jStar i = false → take i = false) →
      ∀ F : ℕ → ℕ → ℂ,
      Integrable (candidateRetainedAllocationIntegrand c L q r jStar R
        (candidateSmallPSet c L (16*Real.exp L+1)) take F) ∧
      (∑ p ∈ candidateSmallPSet c L (16*Real.exp L+1), (candidatePWeight c L q p : ℂ) *
        ((∑ x : ∀ slot, candidateQSlotChoices c L r jStar slot,
          (candidateCompactAllocationWeight c L r jStar x R take : ℂ) *
            F (candidateAllocatedFactor c L r jStar x take)
              (candidateRetainedFactor c L r jStar p x take)) /
            (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ))) =
        ∫ ξ, candidateRetainedAllocationIntegrand c L q r jStar R
          (candidateSmallPSet c L (16*Real.exp L+1)) take F ξ := by
  filter_upwards [eventually_candidate_retained_allocation_integrable hc,
    eventually_candidate_retained_allocation_integral hc] with L hint heq
  intro q r jStar R take hkeep F
  have hS : ∀ p ∈ candidateSmallPSet c L (16*Real.exp L+1),
      p ∈ Nat.factoredNumbers
        ((candidatePIndices c L).biUnion (candidatePBand (c*L))) := by
    intro p hp
    exact ((mem_candidateSmallPSet_iff c L _ p).mp hp).2
  exact ⟨hint q r jStar R _ take hS F, heq q r jStar R _ take hS hkeep F⟩

theorem eventually_candidate_compact_window_retained_integral {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ) (R : ℝ)
      (take : Fin ((candidateQIndices c L).card*r) → Bool),
      (∀ i, candidateAllocationActive c L r jStar i = false → take i = false) →
      ∀ F : ℕ → ℕ → ℂ,
      Integrable (candidateRetainedAllocationIntegrand c L q r jStar R
        (candidateSmallPSet c L (16*Real.exp L+1)) take
        (fun e h => if e*h ∈ arithmeticProductWindow 1 (Real.exp L) then F e h else 0)) ∧
      (∑ p ∈ candidateSmallPSet c L (16*Real.exp L+1), (candidatePWeight c L q p : ℂ) *
        ((∑ x : ∀ slot, candidateQSlotChoices c L r jStar slot,
          (candidateCompactAllocationWeight c L r jStar x R take : ℂ) *
            (if p*orderedSlotProduct (candidateQSlotChoices c L r jStar) x ∈
                arithmeticProductWindow 1 (Real.exp L) then
              F (candidateAllocatedFactor c L r jStar x take)
                (candidateRetainedFactor c L r jStar p x take) else 0)) /
            (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ))) =
        ∫ ξ, candidateRetainedAllocationIntegrand c L q r jStar R
          (candidateSmallPSet c L (16*Real.exp L+1)) take
          (fun e h => if e*h ∈ arithmeticProductWindow 1 (Real.exp L) then F e h else 0) ξ := by
  filter_upwards [eventually_candidate_full_P_retained_allocation_integral hc] with L hL
  intro q r jStar R take hkeep F
  simpa only [candidate_allocation_factorization] using
    hL q r jStar R take hkeep
      (fun e h => if e*h ∈ arithmeticProductWindow 1 (Real.exp L) then F e h else 0)

end Bounty
end

section

/- Character separation with real smooth cutoffs and no recovered quotient guards. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

theorem typeII_smooth_determinant_character_sum (E N M H Z : Finset ℕ)
    (k : ℤ) [NeZero (2 * k.natAbs)] (η : ℝ → ℝ → ℝ) (α aH : ℕ → ℂ)
    {W : ℝ} (hW : 2 ≤ W) (hM : ∀ m ∈ M, 0 < m)
    (hrough : ∀ m ∈ M, ∀ p ∈ m.primeFactors, W < (p : ℝ))
    (hsmall : (k.natAbs : ℝ) ≤ W)
    (hpos : ∀ e n, η e n ≠ 0 → 0 < e)
    (hmem : ∀ e n : ℕ, η e n ≠ 0 → e ∈ E ∧ n ∈ N) :
    (∑ y ∈ typeIIDeterminantDomain E N M H {k} Z,
        typeIIShiftComplexWeight (fun e n => η e n) α aH y) =
      (1 / ((2 * k.natAbs).totient : ℂ)) *
        ∑ χ : DirichletCharacter ℂ (2 * k.natAbs),
          ∑ y ∈ typeIICrossSlice M H Z k,
            typeIIRealShiftWeight η α aH y * χ (y.2.1.1 : ZMod (2 * k.natAbs)) *
              conj (χ (y.2.2.1 : ZMod (2 * k.natAbs))) := by
  classical
  have hk : k ≠ 0 := by
    intro hk
    have hne := NeZero.ne (2 * k.natAbs)
    simp [hk] at hne
  have habs : (k.natAbs : ℝ) = |(k : ℝ)| := by
    simpa only [Int.cast_abs, Int.cast_natCast] using
      congrArg (fun z : ℤ => (z : ℝ)) (Int.natCast_natAbs k)
  have hs : (∑ y ∈ typeIIDeterminantDomain E N M H {k} Z,
      typeIIShiftComplexWeight (fun e n => η e n) α aH y) =
      ∑ y ∈ (typeIICrossSlice M H Z k).filter
        (fun y => Nat.ModEq (2 * k.natAbs) y.2.1.1 y.2.2.1),
          typeIIRealShiftWeight η α aH y := by
    unfold typeIIDeterminantDomain typeIICrossSlice
    rw [filter_filter]
    simp only [sum_filter]
    apply sum_congr rfl
    intro y hy
    obtain ⟨hkz, hvw⟩ := mem_product.mp hy
    have hyk : y.1.1 = k := mem_singleton.mp (mem_product.mp hkz).1
    obtain ⟨hv, hw⟩ := mem_product.mp hvw
    have hp := typeII_smooth_shift_pointwise E N η α aH
      (hM _ (mem_product.mp hw).1) (hrough _ (mem_product.mp hv).1)
      (show |(y.1.1 : ℝ)| ≤ W by simpa only [hyk, ← habs] using hsmall) hpos hmem
    simpa only [hyk] using hp
  rw [hs]
  apply typeII_congruence_character_sum
  intro y hy
  have hrange := (mem_filter.mp hy).1
  have hm := (mem_product.mp (mem_product.mp (mem_product.mp hrange).2).2).1
  exact typeII_rough_coprime_twice_natAbs (hM _ hm) hk hW (hrough _ hm) hsmall

theorem typeII_majorant_real_support {L E V e n : ℝ}
    (hL : 0 < L) (hE : 0 < E) (hV : 0 < V)
    (hne : typeIIEMajorant (L ^ 88) (e / E) * typeIINMajorant (n / V) ≠ 0) :
    0 < e ∧ e < 2 * E ∧ n < 3 * V := by
  have he := typeII_e_majorant_normalized_support hL (left_ne_zero_of_mul hne)
  have hn := typeII_n_majorant_normalized_support (right_ne_zero_of_mul hne)
  have hlo : 0 < e / E := lt_trans (by positivity) he.1
  exact ⟨(div_pos_iff_of_pos_right hE).mp hlo,
    (div_lt_iff₀ hE).mp he.2, (div_lt_iff₀ hV).mp hn.2⟩

theorem typeII_majorant_real_box {L E V e n : ℝ}
    (hL : 0 < L) (hE : 0 < E) (hV : 0 < V)
    (hne : typeIIEMajorant (L ^ 88) (e / E) * typeIINMajorant (n / V) ≠ 0) :
    E / (2 * L ^ 88) < e ∧ e < 2 * E ∧ V / 2 < n ∧ n < 3 * V := by
  have he := typeII_e_majorant_normalized_support hL (left_ne_zero_of_mul hne)
  have hn := typeII_n_majorant_normalized_support (right_ne_zero_of_mul hne)
  refine ⟨?_, (div_lt_iff₀ hE).mp he.2, ?_, (div_lt_iff₀ hV).mp hn.2⟩
  · have hh := (lt_div_iff₀ hE).mp he.1
    calc
      E / (2 * L ^ 88) = ((L ^ 88)⁻¹ / 2) * E := by ring
      _ < e := hh
  · have hh := (lt_div_iff₀ hV).mp hn.1
    calc
      V / 2 = (1 / 2 : ℝ) * V := by ring
      _ < n := hh

theorem typeII_majorant_integer_support {L E V : ℝ}
    (hL : 0 < L) (hE : 0 < E) (hV : 0 < V) (e n : ℕ)
    (hne : typeIIEMajorant (L ^ 88) ((e : ℝ) / E) *
      typeIINMajorant ((n : ℝ) / V) ≠ 0) :
    e ∈ Icc ⌈E / (2 * L ^ 88)⌉₊ ⌊2 * E⌋₊ ∧ n ∈ Icc ⌈V / 2⌉₊ ⌊3 * V⌋₊ := by
  have hs := typeII_majorant_real_box hL hE hV hne
  exact ⟨mem_Icc.mpr ⟨Nat.ceil_le.mpr hs.1.le, Nat.le_floor hs.2.1.le⟩,
    mem_Icc.mpr ⟨Nat.ceil_le.mpr hs.2.2.1.le, Nat.le_floor hs.2.2.2.le⟩⟩

theorem typeII_majorant_determinant_character_sum (M H Z : Finset ℕ)
    (k : ℤ) [NeZero (2 * k.natAbs)] (α aH : ℕ → ℂ)
    {L E V W : ℝ} (hL : 0 < L) (hE : 0 < E) (hV : 0 < V)
    (hW : 2 ≤ W) (hM : ∀ m ∈ M, 0 < m)
    (hrough : ∀ m ∈ M, ∀ p ∈ m.primeFactors, W < (p : ℝ))
    (hsmall : (k.natAbs : ℝ) ≤ W) :
    (∑ y ∈ typeIIDeterminantDomain (Icc ⌈E / (2 * L ^ 88)⌉₊ ⌊2 * E⌋₊) (Icc ⌈V / 2⌉₊ ⌊3 * V⌋₊) M H {k} Z,
        typeIIShiftComplexWeight
          (fun e n => typeIIEMajorant (L ^ 88) ((e : ℝ) / E) *
            typeIINMajorant ((n : ℝ) / V)) α aH y) =
      (1 / ((2 * k.natAbs).totient : ℂ)) *
        ∑ χ : DirichletCharacter ℂ (2 * k.natAbs),
          ∑ y ∈ typeIICrossSlice M H Z k,
            typeIIRealShiftWeight
              (fun e n => typeIIEMajorant (L ^ 88) (e / E) * typeIINMajorant (n / V))
              α aH y * χ (y.2.1.1 : ZMod (2 * k.natAbs)) *
                conj (χ (y.2.2.1 : ZMod (2 * k.natAbs))) := by
  apply typeII_smooth_determinant_character_sum _ _ M H Z k
    (fun e n => typeIIEMajorant (L ^ 88) (e / E) * typeIINMajorant (n / V))
    α aH hW hM hrough hsmall
  · intro e n hne
    exact (typeII_majorant_real_support hL hE hV hne).1
  · exact typeII_majorant_integer_support hL hE hV

end Bounty
end

section

/- Both cross-products are positive on rough nontrivial factor supports. -/

namespace Bounty

theorem typeII_rough_nontrivial_not_dvd {m : ℕ} {k : ℤ} {W : ℝ}
    (hm : 1 < m) (hk : k ≠ 0)
    (hrough : ∀ p ∈ m.primeFactors, W < (p : ℝ)) (hsmall : |(k : ℝ)| ≤ W) :
    ¬ (m : ℤ) ∣ k := by
  intro hd
  have hc := typeII_rough_coprime_determinant (by omega : 0 < m) hk hrough hsmall
  have hu := hc.isUnit_of_dvd hd
  rw [Int.isUnit_iff] at hu
  omega

theorem typeII_cross_positive_products {y : TypeIIShiftIndex} {W : ℝ}
    (hc : TypeIICrossConditions y) (hm : 1 < y.2.1.1) (hm' : 1 < y.2.2.1)
    (hrough : ∀ p ∈ y.2.1.1.primeFactors, W < (p : ℝ))
    (hrough' : ∀ p ∈ y.2.2.1.primeFactors, W < (p : ℝ))
    (hsmall : |(y.1.1 : ℝ)| ≤ W) :
    0 < y.1.2 ∧ 0 < (y.1.2 : ℤ) + y.1.1 ∧ 0 < y.2.1.2 ∧ 0 < y.2.2.2 := by
  obtain ⟨_, hk, hz, hcross⟩ := hc
  have hn := typeII_rough_nontrivial_not_dvd hm hk hrough hsmall
  have hn' := typeII_rough_nontrivial_not_dvd hm' hk hrough' hsmall
  have hzp : 0 < y.1.2 := by
    by_contra hp
    have hz0 : y.1.2 = 0 := by omega
    rw [hz0, Nat.cast_zero, zero_add] at hcross
    exact hn ⟨(y.2.2.2 : ℤ), hcross⟩
  have hhp : 0 < y.2.1.2 := by
    rw [hz] at hzp
    by_contra hp
    have hh0 : y.2.1.2 = 0 := by omega
    simp [hh0] at hzp
  have hh'p : 0 < y.2.2.2 := by
    by_contra hp
    have hh0 : y.2.2.2 = 0 := by omega
    rw [hh0, Nat.cast_zero, mul_zero, hz, Nat.cast_mul] at hcross
    apply hn'
    refine ⟨-(y.2.1.2 : ℤ), ?_⟩
    linear_combination hcross
  refine ⟨hzp, ?_, hhp, hh'p⟩
  rw [hcross]
  exact mul_pos (by exact_mod_cast (show 0 < y.2.1.1 by omega)) (by exact_mod_cast hh'p)

end Bounty
end

section

/- Direct original-candidate to full box-allocation reduction, with rough support. -/

open Finset Filter Real

namespace Bounty

theorem exists_candidate_original_box_reduction {c b q : ℝ}
    (hc : 0 < c) (hb : 0 < b) (hq0 : 0 ≤ q) (hq1 : q < 1) {r : ℕ} (hr : 6 ≤ r) :
    ∃ J : ℕ, ∀ jStar : ℕ, J < jStar → ∀ A D : ℝ,
      ∀ᶠ L : ℝ in atTop, ∀ (E : ℝ) (F : ℕ → ℕ → ℂ),
        1 ≤ E → log E ≤ (1-b)*L →
        (∀ u ∈ arithmeticProductWindow 1 (exp L), ∀ m ∈ (2*u+1).divisors, ‖F u m‖ ≤ L^A) →
        (∀ u ∈ arithmeticProductWindow 1 (exp L), ∀ m ∈ (2*u+1).divisors,
          ¬(∀ p ∈ m.primeFactors, exp (sqrt L) ≤ (p : ℝ)) → F u m = 0) →
        ‖(∑ u ∈ arithmeticProductWindow 1 (exp L),
            (candidateCoefficient c L q r jStar u : ℂ)*∑ m ∈ (2*u+1).divisors, F u m) -
          ∑ u ∈ arithmeticProductWindow 1 (exp L),
            candidateBoxRangeCoefficient c L q r jStar E L u*∑ m ∈ (2*u+1).divisors, F u m‖ ≤
          exp L*L^(-D) := by
  obtain ⟨J,hJ⟩ := exists_candidate_compact_divisor_test_reduction hc hb hq0 hq1 hr
  refine ⟨J,fun jStar hj A D => ?_⟩
  filter_upwards [hJ jStar hj A (D+1),
    eventually_candidate_allocation_box_error hc (show 0 < r by omega) hq0 hq1 A (D+1),
    eventually_ge_atTop (2 : ℝ)] with L hcompact hbox hL
  intro E F hE hlogE hF hsupp
  have hL0 : 0 < L := by linarith
  let middle : ℂ := ∑ u ∈ arithmeticProductWindow 1 (exp L),
    (candidateCompactRangeCoefficient c L q r jStar E u : ℂ)*∑ m ∈ (2*u+1).divisors, F u m
  calc
    _ ≤ ‖(∑ u ∈ arithmeticProductWindow 1 (exp L),
          (candidateCoefficient c L q r jStar u : ℂ)*∑ m ∈ (2*u+1).divisors, F u m)-middle‖ +
        ‖middle-(∑ u ∈ arithmeticProductWindow 1 (exp L),
          candidateBoxRangeCoefficient c L q r jStar E L u*∑ m ∈ (2*u+1).divisors, F u m)‖ :=
      norm_sub_le_norm_sub_add_norm_sub _ middle _
    _ ≤ exp L*L^(-(D+1))+exp L*L^(-(D+1)) :=
      add_le_add (hcompact E F hE hlogE hF hsupp) (hbox jStar E F hF)
    _ = (2/L)*(exp L*L^(-D)) := by
      rw [show -(D+1) = -D+(-1) by ring, rpow_add hL0, rpow_neg_one]
      ring
    _ ≤ exp L*L^(-D) :=
      mul_le_of_le_one_left (by positivity) ((div_le_one hL0).mpr hL)

end Bounty
end

section

/- Exact finite cross-slice reindexing with the signed second endpoint preserved. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

theorem typeII_cross_slice_sum_reindex (M H Z : Finset ℕ) (k : ℤ)
    (W : TypeIIShiftIndex → ℂ) (hM : ∀ m ∈ M, 0 < m) (hk : k ≠ 0) :
    (∑ y ∈ typeIICrossSlice M H Z k, W y) =
      ∑ z ∈ Z, ∑ m ∈ M, ∑ h' ∈ H, ∑ m' ∈ M, ∑ h ∈ H,
        if m'*h=z ∧ (z : ℤ)+k=(m : ℤ)*h' then
          W ((k,z),((m,h),(m',h'))) else 0 := by
  classical
  simp only [typeIICrossSlice, sum_filter, sum_product, sum_singleton]
  apply sum_congr rfl
  intro z hz
  apply sum_congr rfl
  intro m hm
  simp only [TypeIICrossConditions, hM m hm, true_and]
  rw [sum_comm]
  calc
    _ = ∑ m' ∈ M, ∑ h' ∈ H, ∑ h ∈ H,
        if z=m'*h ∧ (z : ℤ)+k=(m : ℤ)*h' then
          W ((k,z),((m,h),(m',h'))) else 0 := by
      apply sum_congr rfl
      intro m' hm'
      rw [sum_comm]
      apply sum_congr rfl
      intro h' hh'
      apply sum_congr rfl
      intro h hh
      by_cases hcross : z=m'*h ∧ (z : ℤ)+k=(m : ℤ)*h'
      · rw [if_pos ⟨hk, hcross⟩, if_pos hcross]
      · rw [if_neg (fun hc => hcross hc.2), if_neg hcross]
    _ = _ := by
      rw [sum_comm]
      apply sum_congr rfl
      intro h' hh'
      apply sum_congr rfl
      intro m' hm'
      apply sum_congr rfl
      intro h hh
      simp only [eq_comm (a := z) (b := m'*h)]

theorem typeII_cross_slice_phase_sum_reindex
    (M H Z : Finset ℕ) (k : ℤ) (A aH : ℕ → ℂ) (ξ₁ ξ₂ ξ₃ : ℝ)
    (hM : ∀ m ∈ M, 0 < m) (hk : k ≠ 0) :
    (∑ y ∈ typeIICrossSlice M H Z k,
      A y.2.1.1 * conj (A y.2.2.1) * aH y.2.1.2 * conj (aH y.2.2.2) *
        typeIIPhase ξ₁ y.2.1.1 * typeIIPhase ξ₂ y.2.2.1 * typeIIPhase ξ₃ y.1.2) =
      ∑ z ∈ Z, ∑ m ∈ M, ∑ h' ∈ H, ∑ m' ∈ M, ∑ h ∈ H,
        if m'*h=z ∧ (z : ℤ)+k=(m : ℤ)*h' then
          A m * conj (A m') * aH h * conj (aH h') *
            typeIIPhase ξ₁ m * typeIIPhase ξ₂ m' * typeIIPhase ξ₃ z else 0 :=
  typeII_cross_slice_sum_reindex M H Z k _ hM hk

theorem typeII_cross_slice_singleton_eq_cross_pair_coefficient
    (M H : Finset ℕ) (k : ℤ) (z w : ℕ)
    (A : ℕ → ℂ) (W : ℕ → ℝ) (B : ℕ → ℂ) (ρ ξ₁ ξ₂ ξ₃ : ℝ)
    (hM : ∀ m ∈ M, 0 < m) (hk : k ≠ 0) (hzw : (z : ℤ)+k=(w : ℤ)) :
    (∑ y ∈ typeIICrossSlice M H {z} k,
      A y.2.1.1 * conj (A y.2.2.1) * typeIISeparatedH W B ρ y.2.1.2 *
        conj (typeIISeparatedH W B ρ y.2.2.2) *
        typeIIPhase ξ₁ y.2.1.1 * typeIIPhase ξ₂ y.2.2.1 * typeIIPhase ξ₃ y.1.2) =
      typeIICrossPairCoefficient M H A W B ρ ξ₁ ξ₂ ξ₃ z w := by
  classical
  rw [typeII_cross_slice_sum_reindex M H {z} k _ hM hk, sum_singleton]
  unfold typeIICrossPairCoefficient
  apply sum_congr rfl
  intro m hm
  apply sum_congr rfl
  intro h' hh'
  apply sum_congr rfl
  intro m' hm'
  apply sum_congr rfl
  intro h hh
  have hcross : ((z : ℤ)+k=(m : ℤ)*h') ↔ m*h'=w := by
    rw [hzw]
    constructor <;> intro heq <;> exact_mod_cast heq.symm
  simp only [hcross]


end Bounty
end

section

/- Apply the proved Mellin cutoff to the actual candidate test on its coarse finite support. -/

open Finset Filter MeasureTheory Real

namespace Bounty

noncomputable def candidateBoxWindowMellinIntegrand (c L q : ℝ) (r jStar : ℕ)
    (E B : ℝ) (F : ℕ → ℕ → ℂ) (ξ : ℝ) : ℂ :=
  finiteWindowMellinIntegrand L B (candidateWindowBox L)
    (candidateBoxRangeCoefficient c L q r jStar E L)
    (fun u => ∑ m ∈ (2*u+1).divisors, F u m) ξ

theorem candidate_box_window_mellin_integrable (c L q : ℝ) (r jStar : ℕ)
    (E B : ℝ) (F : ℕ → ℕ → ℂ) :
    Integrable (candidateBoxWindowMellinIntegrand c L q r jStar E B F) := by
  apply finite_window_mellin_integrable
  intro u hu
  exact (mem_candidate_window_box_bounds hu).1

theorem exists_candidate_box_smooth_window_truncation_bound {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (B : ℝ) (hB : 0 ≤ B) (A D : ℝ) :
    ∃ K : ℝ, 0 < K ∧ ∀ᶠ L : ℝ in atTop, ∀ (jStar : ℕ) (E : ℝ) (F : ℕ → ℕ → ℂ),
      (∀ u ∈ candidateWindowBox L, ∀ m ∈ (2*u+1).divisors, ‖F u m‖ ≤ L^A) →
      ‖(∑ u ∈ candidateWindowBox L, candidateBoxRangeCoefficient c L q r jStar E L u *
          (typeIIWindowSmooth (L^(-B)) ((u:ℝ)/exp L) : ℂ) *
          (∑ m ∈ (2*u+1).divisors, F u m)) -
        (∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ L^K}, candidateBoxWindowMellinIntegrand c L q r jStar E B F ξ)‖ ≤
          exp L * L^(-D) := by
  obtain ⟨C, hC, hmass⟩ := exists_candidate_window_box_absolute_bound hc hr hq0 hq1 A
  let precision := C+max D 0+1
  have hprecision : 0 ≤ precision := by dsimp [precision]; positivity
  obtain ⟨K, hK, hcut⟩ := typeII_window_mellin_power_cutoff hB hprecision
  refine ⟨K, hK, ?_⟩
  filter_upwards [hmass, hcut, eventually_candidate_box_norm_bound hc r,
    eventually_ge_atTop (2 : ℝ)] with L hmassL hcutL hnorm hL
  intro jStar E F hF
  have hL0 : 0 < L := by linarith
  have hfinite := finite_window_mellin_error_le L B (candidateWindowBox L)
    (candidateBoxRangeCoefficient c L q r jStar E L)
    (fun u => ∑ m ∈ (2*u+1).divisors, F u m)
    (fun u => (typeIIWindowSmooth (L^(-B)) ((u:ℝ)/exp L) : ℂ))
    (fun u hu => (mem_candidate_window_box_bounds hu).1)
    {ξ : ℝ | ‖ξ‖ ≤ L^K} (L^(-precision)) (by
      intro u hu
      have hup : (0 : ℝ) < u := by exact_mod_cast (mem_candidate_window_box_bounds hu).1
      simpa only [mul_one, Complex.ofReal_natCast, Complex.ofReal_one, Complex.one_cpow,
        candidateWindowMellinKernel] using
        hcutL (u:ℝ) 1 (exp L) hup (by norm_num) (exp_pos L))
  change ‖(∑ u ∈ candidateWindowBox L, _ ) -
    (∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ L^K}, candidateBoxWindowMellinIntegrand c L q r jStar E B F ξ)‖ ≤ _ at hfinite
  have hweights : (∑ u ∈ candidateWindowBox L,
      ‖candidateBoxRangeCoefficient c L q r jStar E L u‖ * ‖∑ m ∈ (2*u+1).divisors, F u m‖) ≤
      2*(exp L * L^C) := by
    calc
      _ ≤ ∑ u ∈ candidateWindowBox L,
          2*(candidateCoefficient c L q r jStar u * ∑ m ∈ (2*u+1).divisors, ‖F u m‖) := by
        apply sum_le_sum
        intro u hu
        have hh := mul_le_mul (hnorm q hq0 jStar E u) (norm_sum_le (2*u+1).divisors (fun m => F u m))
          (norm_nonneg (∑ m ∈ (2*u+1).divisors, F u m)) (mul_nonneg (by norm_num) (candidate_coefficient_nonneg c L hq0 r jStar u))
        simpa only [mul_assoc] using hh
      _ = 2*(∑ u ∈ candidateWindowBox L,
          candidateCoefficient c L q r jStar u * ∑ m ∈ (2*u+1).divisors, ‖F u m‖) :=
        (mul_sum ..).symm
      _ ≤ _ := mul_le_mul_of_nonneg_left (hmassL jStar F hF) (by norm_num)
  apply hfinite.trans
  calc
    _ ≤ L^(-precision)*(2*(exp L*L^C)) :=
      mul_le_mul_of_nonneg_left hweights (rpow_nonneg hL0.le _)
    _ ≤ L^(-precision)*(L*(exp L*L^C)) :=
      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hL (by positivity)) (by positivity)
    _ = exp L*(L^(-precision)*(L^(1:ℝ)*L^C)) := by rw [rpow_one]; ring
    _ = exp L*L^(-max D 0) := by
      rw [← rpow_add hL0, ← rpow_add hL0]
      congr 2
      dsimp [precision]
      ring
    _ ≤ exp L*L^(-D) := mul_le_mul_of_nonneg_left
      (rpow_le_rpow_of_exponent_le (by linarith) (neg_le_neg (le_max_left _ _))) (exp_pos _).le

end Bounty
end

section

/- Exact full-P expansion of the actual box coefficient. -/

open Finset Filter

namespace Bounty

theorem eventually_candidate_box_finite_convolution {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ) (E R X : ℝ) (U₀ : Finset ℕ) (F : ℕ → ℂ),
      (∀ u ∈ U₀, 0 < u ∧ (u : ℝ) ≤ X) →
      (∑ u ∈ U₀,
        candidateBoxRangeCoefficient c L q r jStar E R u*F u) =
      ∑ p ∈ candidateSmallPSet c L (X+1), (candidatePWeight c L q p : ℂ)*
        ∑ n ∈ orderedSlotProductSupport (candidateQSlotChoices c L r jStar),
          candidateBoxRangeQWeight c L r jStar E R n*
            (if p*n ∈ U₀ then F (p*n) else 0) := by
  classical
  filter_upwards [eventually_candidate_P_pool_below_rough_cutoff hc,
    eventually_ge_atTop (0 : ℝ)] with L hpool hL
  intro q r jStar E R X U₀ F hU₀
  let P := (candidatePIndices c L).biUnion (candidatePBand (c*L))
  let S := candidateSmallPSet c L (X+1)
  let B := orderedSlotProductSupport (candidateQSlotChoices c L r jStar)
  let U := U₀
  let T := (S ×ˢ B).image (fun z => z.1*z.2)
  have hS : ∀ p ∈ S, p ∈ Nat.factoredNumbers P := fun p hp =>
    ((mem_candidateSmallPSet_iff c L _ p).mp hp).2
  have hB : ∀ n ∈ B, n ≠ 0 ∧ Disjoint n.primeFactors P := by
    intro n hn
    obtain ⟨x,hx,rfl⟩ := mem_image.mp hn
    exact ⟨prod_ne_zero_iff.mpr (fun slot _ =>
      candidate_Q_slot_nonzero c L r jStar slot (x slot).property),
      candidate_Q_tuple_primeFactors_disjoint (mul_nonneg hc.le hL) hpool x⟩
  have hreindex := supported_free_complex_product_reindex P S B hS hB
    (fun p => (candidatePWeight c L q p : ℂ)) (candidateBoxRangeQWeight c L r jStar E R)
    (fun u => if u ∈ U then F u else 0)
  symm
  calc
    _ = ∑ u ∈ T, (candidatePWeight c L q (primePoolPart P u) : ℂ)*
        candidateBoxRangeQWeight c L r jStar E R (primePoolFreePart P u)*
        (if u ∈ U then F u else 0) := by
      simp_rw [mul_sum, ← mul_assoc]
      exact hreindex
    _ = ∑ u ∈ T, candidateBoxRangeCoefficient c L q r jStar E R u*
        (if u ∈ U then F u else 0) := by
      apply sum_congr rfl
      intro u hu
      obtain ⟨pn,hpn,rfl⟩ := mem_image.mp hu
      obtain ⟨hp,hn⟩ := mem_product.mp hpn
      obtain ⟨hn0,hnfree⟩ := hB pn.2 hn
      have hp0 := Nat.ne_zero_of_mem_factoredNumbers (hS pn.1 hp)
      rw [primePoolPart_mul_of_free (hS _ hp) hn0 hnfree,
        primePoolFreePart_mul_of_free (hS _ hp) hn0 hnfree]
      unfold candidateBoxRangeCoefficient
      rw [candidate_marked_weight_mul_of_free c L q hn0 hnfree pn.1,
        primePoolFreePart_mul_of_free (hS _ hp) hn0 hnfree,
        candidate_P_weight_eq_marked c L q hp0]
      ring
    _ = ∑ u ∈ T.filter (fun u => u ∈ U), candidateBoxRangeCoefficient c L q r jStar E R u*F u := by
      rw [sum_filter]
      simp only [mul_ite, mul_zero]
    _ = ∑ u ∈ U.filter (fun u => u ∈ T), candidateBoxRangeCoefficient c L q r jStar E R u*F u := by
      congr 1
      ext u
      simp only [mem_filter, and_comm]
    _ = _ := by
      rw [sum_filter]
      apply sum_congr rfl
      intro u hu
      by_cases ht : u ∈ T
      · simp only [ht, if_true]
      · simp only [ht, if_false]
        have hnot : primePoolFreePart P u ∉ B := by
          intro hn
          have hurange := hU₀ u hu
          have hu0 : u ≠ 0 := (hurange.1).ne'
          have hpu : (primePoolPart P u : ℝ) ≤ (u : ℝ) := by
            exact_mod_cast Nat.le_of_dvd (Nat.pos_of_ne_zero hu0) (primePoolPart_dvd P u)
          have hp : primePoolPart P u ∈ S := by
            apply (mem_candidateSmallPSet_iff c L _ _).mpr
            exact ⟨by linarith [hurange.2],primePoolPart_mem_factoredNumbers P u⟩
          exact ht (mem_image.mpr ⟨(primePoolPart P u,primePoolFreePart P u),
            mem_product.mpr ⟨hp,hn⟩,primePoolPart_mul_primePoolFreePart P u⟩)
        have hz := candidate_box_Q_support c L r jStar E R (primePoolFreePart P u) hnot
        change 0 = candidateBoxRangeQWeight c L r jStar E R (primePoolFreePart P u) * _ * _
        rw [hz, zero_mul, zero_mul]

end Bounty
end

