section

/- Normalized finite box masses and rapid decay of the fixed harmonic source tail. -/

open Finset MeasureTheory Filter Real
namespace Bounty

theorem harmonic_coefficient_norm_sum_le (S : Finset ℕ) (A : ℕ → ℂ)
    {L B C : ℝ} (hL : 0 < L) (hcard : (S.card : ℝ) ≤ B)
    (hA : ∀ n ∈ S, ‖A n‖ ≤ L^C) :
    (∑ n ∈ S, ‖A n‖) ≤ B*L^C := by
  calc
    _ ≤ ∑ _n ∈ S, L^C := sum_le_sum hA
    _ = (S.card : ℝ)*L^C := by simp
    _ ≤ B*L^C := mul_le_mul_of_nonneg_right hcard (rpow_nonneg hL.le _)

theorem harmonic_box_normalized_mass_le
    (S₁ S₂ S₃ S₄ : Finset ℕ) (A₁ A₂ A₃ A₄ : ℕ → ℂ)
    {L Y K B₁ B₂ B₃ B₄ C₁ C₂ C₃ C₄ : ℝ}
    (hL : 0 < L) (hY : 0 < Y)
    (hcard₁ : (S₁.card : ℝ) ≤ B₁) (hcard₂ : (S₂.card : ℝ) ≤ B₂)
    (hcard₃ : (S₃.card : ℝ) ≤ B₃) (hcard₄ : (S₄.card : ℝ) ≤ B₄)
    (hA₁ : ∀ n ∈ S₁, ‖A₁ n‖ ≤ L^C₁) (hA₂ : ∀ n ∈ S₂, ‖A₂ n‖ ≤ L^C₂)
    (hA₃ : ∀ n ∈ S₃, ‖A₃ n‖ ≤ L^C₃) (hA₄ : ∀ n ∈ S₄, ‖A₄ n‖ ≤ L^C₄)
    (hvolume : B₁*B₂*B₃*B₄ ≤ K*Y) :
    (1/Y)*(∑ n ∈ S₁, ‖A₁ n‖)*(∑ n ∈ S₂, ‖A₂ n‖)*
      (∑ n ∈ S₃, ‖A₃ n‖)*(∑ n ∈ S₄, ‖A₄ n‖) ≤
        K*L^(C₁+C₂+C₃+C₄) := by
  have h₁ := harmonic_coefficient_norm_sum_le S₁ A₁ hL hcard₁ hA₁
  have h₂ := harmonic_coefficient_norm_sum_le S₂ A₂ hL hcard₂ hA₂
  have h₃ := harmonic_coefficient_norm_sum_le S₃ A₃ hL hcard₃ hA₃
  have h₄ := harmonic_coefficient_norm_sum_le S₄ A₄ hL hcard₄ hA₄
  have hB₁ : 0 ≤ B₁ := (Nat.cast_nonneg S₁.card).trans hcard₁
  have hB₂ : 0 ≤ B₂ := (Nat.cast_nonneg S₂.card).trans hcard₂
  have hB₃ : 0 ≤ B₃ := (Nat.cast_nonneg S₃.card).trans hcard₃
  have hB₄ : 0 ≤ B₄ := (Nat.cast_nonneg S₄.card).trans hcard₄
  calc
    _ ≤ (1/Y)*(B₁*L^C₁)*(B₂*L^C₂)*(B₃*L^C₃)*(B₄*L^C₄) := by gcongr
    _ = (B₁*B₂*B₃*B₄/Y)*L^(C₁+C₂+C₃+C₄) := by
      rw [rpow_add hL, rpow_add hL, rpow_add hL]
      ring
    _ ≤ K*L^(C₁+C₂+C₃+C₄) :=
      mul_le_mul_of_nonneg_right ((div_le_iff₀ hY).mpr hvolume) (rpow_nonneg hL.le _)

theorem eventually_schwartz_tail_polynomial (f : SchwartzMap ℝ ℂ) {r : ℝ} (hr : 0 < r)
    (K C D : ℝ) (hK : 0 ≤ K) :
    ∀ᶠ L : ℝ in atTop,
      (∫ u in {u : ℝ | L^r < ‖u‖}, ‖f u‖)*K*L^C ≤ L^(-D) := by
  obtain ⟨M, hM⟩ := exists_nat_gt ((C+D+1)/r)
  have hMr : C+D+1 < r*(M : ℝ) := by
    have hh := (div_lt_iff₀ hr).mp hM
    simpa only [mul_comm] using hh
  obtain ⟨A, hA, htail⟩ := schwartz_norm_rapid_tail f M
  filter_upwards [eventually_ge_atTop (max 1 (A*K))] with L hL
  have hL1 : 1 ≤ L := (le_max_left _ _).trans hL
  have hAK : A*K ≤ L := (le_max_right _ _).trans hL
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL1
  calc
    _ ≤ (A*(L^r)^(-(M : ℝ)))*K*L^C := by
      gcongr
      exact htail (L^r) (one_le_rpow hL1 hr.le)
    _ = (A*K)*(L^r)^(-(M : ℝ))*L^C := by ring
    _ ≤ L*(L^r)^(-(M : ℝ))*L^C := by gcongr
    _ = L^(1-r*(M : ℝ)+C) := by
      nth_rw 1 [← rpow_one L]
      rw [← rpow_mul hL0.le, ← rpow_add hL0, ← rpow_add hL0]
      congr 1
      ring
    _ ≤ L^(-D) := rpow_le_rpow_of_exponent_le hL1 (by linarith)

theorem eventually_harmonic_source_tail_polynomial {r : ℝ} (hr : 0 < r)
    (K C D : ℝ) (hK : 0 ≤ K) :
    ∀ᶠ L : ℝ in atTop,
      (∫ u in {u : ℝ | L^r < ‖u‖}, ‖harmonicSourceLogFourier u‖)*K*L^C ≤ L^(-D) :=
  eventually_schwartz_tail_polynomial harmonicSourceLogFourier hr K C D hK

end Bounty
end

section

/- Harmonic coefficient-mass control of the window Mellin integrand. -/

open Finset
namespace Bounty

theorem harmonic_normalized_four_box_integrand_norm (Y s u : ℝ)
    (D A B C : Finset ℕ) (δ α β γ : ℕ → ℂ)
    (hD : ∀ d ∈ D, 0 < d) (hA : ∀ a ∈ A, 0 < a)
    (hB : ∀ b ∈ B, 0 < b) (hC : ∀ c ∈ C, 0 < c) :
    ‖harmonicWindowLogFourier u * physicalMellinPhase (-2 * Real.pi * u) Y *
      ((∑ d ∈ D, δ d * harmonicMellinWeight (s + 2 * Real.pi * u) d) *
        (∑ a ∈ A, α a * harmonicMellinWeight (s + 2 * Real.pi * u) a) *
        (∑ b ∈ B, β b * harmonicMellinWeight (s + 2 * Real.pi * u) b) *
        (∑ c ∈ C, γ c * harmonicMellinWeight (s + 2 * Real.pi * u) c))‖ ≤
      ‖harmonicWindowLogFourier u‖ *
        ((∑ d ∈ D, ‖δ d‖ / (d : ℝ)) * (∑ a ∈ A, ‖α a‖ / (a : ℝ)) *
          (∑ b ∈ B, ‖β b‖ / (b : ℝ)) * (∑ c ∈ C, ‖γ c‖ / (c : ℝ))) := by
  have hb (S : Finset ℕ) (f : ℕ → ℂ) (hS : ∀ n ∈ S, 0 < n) :
      ‖∑ n ∈ S, f n * harmonicMellinWeight (s + 2 * Real.pi * u) n‖ ≤
        ∑ n ∈ S, ‖f n‖ / (n : ℝ) := by
    apply (norm_sum_le _ _).trans
    apply le_of_eq
    apply sum_congr rfl
    intro n hn
    have hn0 : (0 : ℝ) < n := by exact_mod_cast hS n hn
    rw [norm_mul, norm_harmonic_mellin_weight _ hn0]
    ring
  simp only [norm_mul, physical_mellin_phase_norm, mul_one]
  exact mul_le_mul_of_nonneg_left
    (mul_le_mul (mul_le_mul (mul_le_mul (hb D δ hD) (hb A α hA)
      (norm_nonneg _) (by positivity)) (hb B β hB) (norm_nonneg _) (by positivity))
      (hb C γ hC) (norm_nonneg _) (by positivity)) (norm_nonneg _)

end Bounty
end

section

/- The original finite joint residue histories satisfy one scalar bound with their exact initial and permutation weights. -/

open Finset
namespace Bounty

section Energy
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g, ∀ p : ↥(P g), NeZero p.val]
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)
  (S : Finset (PhysicalSelectedData P ell C)) (w : PhysicalSelectedData P ell C → ℂ)

theorem physical_selected_original_history_sum_bound
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hω : ∀ j c a, 0 ≤ ω j c a) (hωmass : ∀ j c, ∑ a, ω j c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 < β g p / V g) (hmass : ∀ g, ∑ p, β g p / V g ≤ 2)
    (hq0 : ∀ i, 0 ≤ retention i) (hq1 : ∀ i, retention i ≤ 1)
    (hD : ∀ i, retention i / ρ ^ 2 + ((1 - retention i) / ρ) / v ≤ 1)
    (hC : ∀ i g, retention i / ρ ^ 2 + ((1 - retention i) * V g / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ j g, ell + (C j g).card ≤ T)
    (hw : ∀ d ∈ S, ‖w d‖ ≤ 1)
    (a : S → Fin (n + 1) → ℤ)
    (hstep : ∀ d : S, ∀ j : Fin n, a d j.succ = a d j.castSucc +
      k j * (physicalD (C j) (physicalPermuteLabels (d.val.2.2.1 j)
        (d.val.2.1 j.castSucc)) (d.val.1 j) : ℤ))
    (ζ : S → ∀ p : PhysicalPrime P, ZMod p.2.val)
    (hmarks : ∀ d : S, ∀ j : Fin (n + 1), ∀ p ∈ physicalMarkedPrimes (d.val.2.1 j),
      ζ d p = -(a d j : ZMod p.2.val))
    (hlist : ∀ d : S, ∀ j : Fin n, physicalListAdmissible (C j) (d.val.1 j)
      (physicalPermuteLabels (d.val.2.2.1 j) (d.val.2.1 j.castSucc))
      (physicalPermuteLabels (d.val.2.2.2 j) (d.val.2.1 j.succ)))
    (hk : ∀ d : S, ∀ j : Fin n, ∀ g t, ¬ ((d.val.2.1 j.castSucc g t).val : ℤ) ∣ k j) :
    ‖(∑ d : S,
      ((∏ g, ∏ i : PhysicalSlots J ell, β g (d.val.2.1 0 g i) / V g : ℝ) : ℂ) *
        (w d.val * ((∏ i ∈ range (2 * n + 1),
          physicalSelectedCoarseScalar C d.val.1 d.val.2.1 d.val.2.2.1 ω i) *
          physicalJointResidueRawHistory C d.val.1 k d.val.2.1 (a d) d.val.2.2.1 d.val.2.2.2
            (hstep d) (ζ d) (hmarks d) (hlist d) hP hdis (hk d) β
            (fun _ j => 1 - retention j) V (fun _ => ρ) hV B)))‖ ^ 2 ≤
      physicalMarkMass (J := J) (ell := ell) (fun g p => β g p / V g) *
        (physicalGhostUniformEnergyBound ρ vmax v ^ (N * (n + 1)) *
          unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ (N * n) *
          ∏ g, (∑ p, β g p / V g) ^ (J + ell)) := by
  have he := physical_selected_outer_path_scalar_le (B := B) C k β V ρ hV ω retention S w
    hP hdis hω hωmass hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass hq0 hq1 hD hC T ht hw
  have hsum : (∑ d ∈ S,
      ((∏ g, ∏ i : PhysicalSlots J ell, β g (d.2.1 0 g i) / V g : ℝ) : ℂ) * (w d *
        finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
          (physicalSelectedFineRow C d.1 d.2.1 d.2.2.1 d.2.2.2 k β V ρ hV ω retention)
          (4 * n + 1) physicalEmptyMemoryTerminal (physicalInitialMarkState B (d.2.1 0)))) = (
    ∑ d : S,
      ((∏ g, ∏ i : PhysicalSlots J ell, β g (d.val.2.1 0 g i) / V g : ℝ) : ℂ) *
        (w d.val * ((∏ i ∈ range (2 * n + 1),
          physicalSelectedCoarseScalar C d.val.1 d.val.2.1 d.val.2.2.1 ω i) *
          physicalJointResidueRawHistory C d.val.1 k d.val.2.1 (a d) d.val.2.2.1 d.val.2.2.2
            (hstep d) (ζ d) (hmarks d) (hlist d) hP hdis (hk d) β
            (fun _ j => 1 - retention j) V (fun _ => ρ) hV B))) := by
    rw [← Finset.sum_coe_sort S]
    apply sum_congr rfl
    intro d hd
    rw [physical_selected_fine_path_eq_original C d.val.1 k d.val.2.1 (a d)
      d.val.2.2.1 d.val.2.2.2 (hstep d) (ζ d) (hmarks d) (hlist d) hP hdis (hk d)
      β V ρ hV B ω retention]
  rw [hsum] at he
  exact he

end Energy
