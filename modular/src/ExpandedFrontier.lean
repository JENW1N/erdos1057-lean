section

/- Uniform character energy bounds control the literal normalized rational cutoff box. -/

open Finset Filter MeasureTheory

namespace Bounty

theorem eventually_rational_normalized_full_box_precision
    {ρ c E : ℝ} (hρ : 0 < ρ) (hc : 0 ≤ c) (F : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ qRat : ℕ, 0 < qRat → ∀ k : ℤ,
      ∀ Y : ℝ, 1 ≤ Y → Real.log Y ≤ c*L →
      ∀ (D A B C : Finset ℕ) (δ α β γ : ℕ → ℂ) (D₀ A₀ B₀ C₀ : ℝ),
      0 ≤ D₀ → 0 ≤ A₀ → 0 ≤ B₀ → 0 ≤ C₀ → D₀*A₀*B₀*C₀ ≤ L^E →
      (∀ d ∈ D, 0 < d) → (∀ a ∈ A, 0 < a) →
      (∀ b ∈ B, 0 < b) → (∀ z ∈ C, 0 < z) →
      (∀ d ∈ D, d.Coprime qRat) → (∀ a ∈ A, a.Coprime qRat) →
      (∀ b ∈ B, b.Coprime qRat) →
      (∀ d ∈ D, ‖δ d‖ ≤ D₀) → (∀ a ∈ A, ‖α a‖ ≤ A₀) →
      (∀ b ∈ B, ‖β b‖ ≤ B₀) → (∀ z ∈ C, ‖γ z‖ ≤ C₀) →
      (∀ d ∈ D, ∀ a ∈ A, ∀ b ∈ B, ∀ z ∈ C,
        Y/128 ≤ ((d*a*b*z : ℕ) : ℝ) ∧
          ((d*a*b*z : ℕ) : ℝ) ≤ 64*Real.exp 2*Y) →
      ∀ T w : ℝ, 0 ≤ T → T ≤ L*Y →
      (∀ d ∈ qRat.divisors, ∀ ψ : AddChar (Additive (ZMod (qRat/d))ˣ) ℂ,
        ∀ u : ℝ, ‖u‖ ≤ L^ρ → (∫ s in Set.Icc (-T) T,
          ‖(∑ n ∈ D, (δ n*unitAddCharDirichlet ψ (n : ZMod (qRat/d)))*
              harmonicMellinWeight (s+w+2*Real.pi*u) n) *
            (∑ n ∈ A, (α n*unitAddCharDirichlet ψ (n : ZMod (qRat/d)))*
              harmonicMellinWeight (s+w+2*Real.pi*u) n) *
            (∑ n ∈ B, (β n*unitAddCharDirichlet ψ (n : ZMod (qRat/d)))*
              harmonicMellinWeight (s+w+2*Real.pi*u) n) *
            (∑ n ∈ C, (γ n*rationalResidualGcdMultiplier qRat d ψ n)*
              harmonicMellinWeight (s+w+2*Real.pi*u) n)‖^2) ≤ L^(-(F+1))) →
      (∫ s in Set.Icc (-T) T,
        ‖rationalFourBoxKernelSum qRat k D A B C δ α β γ
          (fun n => ((harmonicCommonCutoff ((n : ℝ)/Y)/(n : ℝ) : ℝ) : ℂ)*
            physicalMellinPhase (s+w) (n : ℝ))‖^2) ≤ (qRat : ℝ)^3*L^(-F) := by
  filter_upwards [eventually_harmonic_normalized_full_box_precision (E := E) hρ hc F,
    eventually_gt_atTop (0 : ℝ)] with L hcutoff hL
  intro qRat hqRat k Y hY hlogY D A B C δ α β γ D₀ A₀ B₀ C₀
    hD₀ hA₀ hB₀ hC₀ hprod hD hA hB hC hDcop hAcop hBcop hδ hα hβ hγ
    hgeom T w hT hTY hcentral
  have htwist (x y : ℂ) (K : ℝ) (hx : ‖x‖ ≤ K) (hy : ‖y‖ ≤ 1) :
      ‖x*y‖ ≤ K := by
    calc
      _ = ‖x‖*‖y‖ := norm_mul x y
      _ ≤ ‖x‖*1 := mul_le_mul_of_nonneg_left hy (norm_nonneg x)
      _ = ‖x‖ := mul_one _
      _ ≤ K := hx
  apply rational_box_kernel_energy_le hqRat k D A B C δ α β γ
    (fun s n => ((harmonicCommonCutoff ((n : ℝ)/Y)/(n : ℝ) : ℝ) : ℂ)*
      physicalMellinPhase (s+w) (n : ℝ)) hDcop hAcop hBcop
    (fun _ => by unfold physicalMellinPhase; fun_prop)
    (-T) T (L^(-F)) (Real.rpow_nonneg hL.le _)
  intro d hd ψ
  have hbound := hcutoff Y hY hlogY D A B C
    (fun n => δ n*unitAddCharDirichlet ψ (n : ZMod (qRat/d)))
    (fun n => α n*unitAddCharDirichlet ψ (n : ZMod (qRat/d)))
    (fun n => β n*unitAddCharDirichlet ψ (n : ZMod (qRat/d)))
    (fun n => γ n*rationalResidualGcdMultiplier qRat d ψ n)
    D₀ A₀ B₀ C₀ hD₀ hA₀ hB₀ hC₀ hprod hD hA hB hC
    (fun n hn => htwist _ _ _ (hδ n hn) ((unitAddCharDirichlet ψ).norm_le_one _))
    (fun n hn => htwist _ _ _ (hα n hn) ((unitAddCharDirichlet ψ).norm_le_one _))
    (fun n hn => htwist _ _ _ (hβ n hn) ((unitAddCharDirichlet ψ).norm_le_one _))
    (fun n hn => htwist _ _ _ (hγ n hn) (rational_residual_gcd_multiplier_norm_le qRat d ψ n))
    hgeom T w hT hTY (hcentral d hd ψ)
  simpa only [fourBoxKernelSum, mul_assoc] using hbound

end Bounty
end

