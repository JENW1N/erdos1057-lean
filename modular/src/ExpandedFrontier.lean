open Finset
open scoped Classical

/-- All signed patterns stay in one block. Only the two exceptional raw pairings
and the comparison errors contribute to the final bound. -/
theorem finite_signed_ideal_block_bound {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hμ : ∀ i x, 0 ≤ μ i x) (hmass : ∀ i, ∑ y, μ i y = 1)
    (U V : Finset I) (k : (∀ i, X i) → ℂ) (hk : ∀ x, ‖k x‖ ≤ 1)
    (K : Finset I → Finset I → (∀ i, X i) → (∀ i, X i) → ℂ)
    (f g : (∀ i, X i) → ℂ) (θA θB : ℝ)
    (hA : Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ U U.toList f)) ≤
      θA * Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) f))
    (hB : Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ V V.toList g)) ≤
      θB * Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) g))
    (hzero : ∀ S ∈ U.powerset, ∀ T ∈ V.powerset,
      ∀ A ∈ cleanNonemptySubsets U, ∀ B ∈ cleanNonemptySubsets V,
        ¬(A ⊆ U \ S ∧ B ⊆ V \ T) →
        cleanKernelPairing (finiteProductWeight μ) (K A B)
          (finiteCoordinateComponent μ S U.toList f)
          (finiteCoordinateComponent μ T V.toList g) = 0)
    (ε : ℝ) (hε : 0 ≤ ε)
    (herr : ∀ S ∈ U.powerset, ∀ T ∈ V.powerset,
      ∀ A ∈ cleanNonemptySubsets (U \ S), ∀ B ∈ cleanNonemptySubsets (V \ T),
        ‖cleanKernelPairing (finiteProductWeight μ) (K A B)
            (finiteCoordinateComponent μ S U.toList f)
            (finiteCoordinateComponent μ T V.toList g) -
          cleanRawPairing (finiteProductWeight μ) k
            (finiteCoordinateComponent μ S U.toList f)
            (finiteCoordinateComponent μ T V.toList g)‖ ≤
        ε * Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ)
          (finiteCoordinateComponent μ S U.toList f)) *
          Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ)
            (finiteCoordinateComponent μ T V.toList g))) :
    ‖cleanRawPairing (finiteProductWeight μ) k f g -
      ∑ A ∈ cleanNonemptySubsets U, ∑ B ∈ cleanNonemptySubsets V,
        (-1 : ℂ) ^ (A.card + B.card) * cleanKernelPairing (finiteProductWeight μ) (K A B) f g‖ ≤
      (θA + θB + (3 : ℝ) ^ (U.card + V.card) * ε) *
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) f) *
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) g) := by
  have hc := finite_probe_signed_cancellation_bound μ hμ hmass U V k K f g hzero ε hε herr
  have he := finite_exceptional_pairing_norm_le μ hμ hmass U V k hk f g θA θB hA hB
  calc
    _ ≤ _ := hc
    _ ≤ (θA + θB) * Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) f) *
          Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) g) +
        (3 : ℝ) ^ (U.card + V.card) * ε *
          Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) f) *
          Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) g) := add_le_add he le_rfl
    _ = _ := by ring

/-- The same bound measured against the original vectors before tail averaging. -/
theorem finite_signed_ideal_block_envelope {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hμ : ∀ i x, 0 ≤ μ i x) (hmass : ∀ i, ∑ y, μ i y = 1)
    (U V : Finset I) (k : (∀ i, X i) → ℂ) (hk : ∀ x, ‖k x‖ ≤ 1)
    (K : Finset I → Finset I → (∀ i, X i) → (∀ i, X i) → ℂ)
    (f g : (∀ i, X i) → ℂ) (a b θA θB : ℝ)
    (hf : Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) f) ≤ a)
    (hg : Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) g) ≤ b)
    (hA : Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ U U.toList f)) ≤
      θA * a)
    (hB : Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ V V.toList g)) ≤
      θB * b)
    (hzero : ∀ S ∈ U.powerset, ∀ T ∈ V.powerset,
      ∀ A ∈ cleanNonemptySubsets U, ∀ B ∈ cleanNonemptySubsets V,
        ¬(A ⊆ U \ S ∧ B ⊆ V \ T) →
        cleanKernelPairing (finiteProductWeight μ) (K A B)
          (finiteCoordinateComponent μ S U.toList f)
          (finiteCoordinateComponent μ T V.toList g) = 0)
    (ε : ℝ) (hε : 0 ≤ ε)
    (herr : ∀ S ∈ U.powerset, ∀ T ∈ V.powerset,
      ∀ A ∈ cleanNonemptySubsets (U \ S), ∀ B ∈ cleanNonemptySubsets (V \ T),
        ‖cleanKernelPairing (finiteProductWeight μ) (K A B)
            (finiteCoordinateComponent μ S U.toList f)
            (finiteCoordinateComponent μ T V.toList g) -
          cleanRawPairing (finiteProductWeight μ) k
            (finiteCoordinateComponent μ S U.toList f)
            (finiteCoordinateComponent μ T V.toList g)‖ ≤
        ε * Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ)
          (finiteCoordinateComponent μ S U.toList f)) *
          Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ)
            (finiteCoordinateComponent μ T V.toList g))) :
    ‖cleanRawPairing (finiteProductWeight μ) k f g -
      ∑ A ∈ cleanNonemptySubsets U, ∑ B ∈ cleanNonemptySubsets V,
        (-1 : ℂ) ^ (A.card + B.card) * cleanKernelPairing (finiteProductWeight μ) (K A B) f g‖ ≤
      (θA + θB + (3 : ℝ) ^ (U.card + V.card) * ε) * a * b := by
  have hc := finite_probe_signed_cancellation_bound μ hμ hmass U V k K f g hzero ε hε herr
  have he := finite_exceptional_pairing_envelope μ hμ hmass U V k hk f g a b θA θB hf hg hA hB
  have ha : 0 ≤ a := (Real.sqrt_nonneg _).trans hf
  have hab := mul_le_mul hf hg (Real.sqrt_nonneg _) ha
  have hscale : (3 : ℝ) ^ (U.card + V.card) * ε *
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) f) *
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) g) ≤
      (3 : ℝ) ^ (U.card + V.card) * ε * a * b := by
    have hn : 0 ≤ (3 : ℝ) ^ (U.card + V.card) * ε := mul_nonneg (by positivity) hε
    simpa only [mul_assoc] using mul_le_mul_of_nonneg_left hab hn
  calc
    _ ≤ _ := hc
    _ ≤ (θA + θB) * a * b + (3 : ℝ) ^ (U.card + V.card) * ε * a * b := add_le_add he hscale
    _ = _ := by ring
end

section
open scoped BigOperators Classical
theorem rational_kernel_reproduction {X Y : Type*} [Fintype X] [Fintype Y]
    (π : X → ℕ) (τ : Y → ℕ) (μ : X → ℝ) (ν : Y → ℝ)
    (KA : X → X → ℂ) (KB : Y → Y → ℂ) (x : X) (y : Y)
    {r Q : ℕ} (hr : 0 < r) (hrQ : r ≤ Q) (u : ℤ)
    (hπ : ∀ d, (π d).Coprime r) (hτ : ∀ e, (τ e).Coprime r)
    {εA εB : ℝ} (hεA : 0 ≤ εA) (hεB : 0 ≤ εB)
    (hA : ∀ χ : DirichletCharacter ℂ r,
      ‖(∑ d, (μ d : ℂ) * KA d x * χ (π d : ZMod r)) - χ (π x : ZMod r)‖ ≤ εA)
    (hB : ∀ χ : DirichletCharacter ℂ r,
      ‖(∑ e, (ν e : ℂ) * KB e y * χ (τ e : ZMod r)) - χ (τ y : ZMod r)‖ ≤ εB) :
    ‖finiteTwoKernelAverage μ ν KA KB x y (fun d e =>
        Complex.exp (Complex.I * (2 * Real.pi * ((u : ℝ) / r * (π d * τ e)) : ℝ))) -
      Complex.exp (Complex.I * (2 * Real.pi * ((u : ℝ) / r * (π x * τ y)) : ℝ))‖ ≤
        Real.sqrt (Q : ℝ) * (εA + εB + εA * εB) := by
  obtain ⟨c, hc, he⟩ := rational_bilinear_character_expansion hr hrQ u
  let χA := fun (ψ : AddChar (Additive (ZMod r)ˣ) ℂ) (d : X) =>
    unitAddCharDirichlet ψ (π d : ZMod r)
  let χB := fun (ψ : AddChar (Additive (ZMod r)ˣ) ℂ) (e : Y) =>
    unitAddCharDirichlet ψ (τ e : ZMod r)
  have hphase (d : X) (e : Y) :
      (∑ ψ, c ψ * (χA ψ d * χB ψ e)) =
        Complex.exp (Complex.I * (2 * Real.pi * ((u : ℝ) / r * (π d * τ e)) : ℝ)) := by
    simpa only [χA, χB, mul_assoc] using he (π d) (τ e) (hπ d) (hτ e)
  have hb := finite_two_kernel_expansion_error Finset.univ μ ν KA KB x y c χA χB
    εA εB (Real.sqrt (Q : ℝ)) hεA hεB hc
    (fun ψ _ => (unitAddCharDirichlet ψ).norm_le_one _) (fun ψ _ => (unitAddCharDirichlet ψ).norm_le_one _)
    (fun ψ _ => hA (unitAddCharDirichlet ψ)) (fun ψ _ => hB (unitAddCharDirichlet ψ))
  simpa only [hphase] using hb
end

