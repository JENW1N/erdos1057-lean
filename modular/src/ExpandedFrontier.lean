  have hmassUpper : mass g ≤ L := ((hpoolL.2.2.2.2.2 g.val (hgroups g.property)).2.1).trans hvmax
  have hfactorMass : (1+2*log (N : ℝ)/v)^2*(∑ p ∈ P g, 1/(p : ℝ)) ≤ L^(5 : ℝ) := by
    calc
      _ ≤ L^(4 : ℝ)*L := mul_le_mul hfactor hmassUpper (by positivity) (rpow_nonneg hL0.le _)
      _ = _ := by norm_num [pow_succ]
  have hsq : (1+2*log (N : ℝ)/v)^2*(∑ p ∈ P g, 1/(p : ℝ)^2) ≤ 1 := by
    simpa only [neg_zero,rpow_zero] using hsquare (P g) _ (sq_nonneg _) hfactorMass
      (fun p hp => ((hpoolL.2.2.2.2.2 g.val (hgroups g.property)).2.2 p hp).2.1.le)
  have hprime : ∀ j p, p ∈ P j → p.Prime := by
    intro j p hp
    exact ((hpoolL.2.2.2.2.2 j.val (hgroups j.property)).2.2 p hp).1
  have hdis : Pairwise (fun j j' => Disjoint (P j) (P j')) := by
    intro j j' hne
    exact hpoolL.2.2.2.2.1 (by intro heq; exact hne (Subtype.ext heq))
  have hmarks : ∀ j, marks j ≤ ell+J := fun j => Nat.add_le_add_left
    (by simpa only [Fintype.card_fin] using card_le_univ (cut j)) ell
  have hendpoint (b : GroupMarkedLists (fun j : big => P j.val) (fun j : big => marks j.val) → ℂ)
      (hb : ∀ l, ‖b l‖ ≤ L^Cb) (α β γ : ℕ → ℂ)
      (hαfree : ∀ n, ¬ Disjoint n.primeFactors pool → α n = 0)
      (hβfree : ∀ n, ¬ Disjoint n.primeFactors pool → β n = 0)
      (hα : ∀ n, ‖α n‖ ≤ L^Ce) (hβ : ∀ n, ‖β n‖ ≤ L^Ce) (hγ : ∀ n, ‖γ n‖ ≤ L^Ce)
      (s : ℤ) :
      (∑ n ∈ harmonicCommonSupport Y, ‖(harmonicCommonCutoff (((n+s : ℤ) : ℝ)/Y) : ℂ)*
        selectedMarkedEndpoint P (1/2) mass marks big b pool α β γ (n+s).natAbs‖^2) ≤ 4*E ∧
      (∑ n ∈ harmonicCommonSupport Y, ‖(harmonicCommonCutoff (((n+s : ℤ) : ℝ)/Y) : ℂ)*
        selectedPeeledEndpoint P (1/2) mass marks g κ big b pool α β γ (n+s).natAbs‖^2) ≤ 4*E := by
    have hm := selected_marked_endpoint_energy P (by norm_num : (0 : ℝ) ≤ 1/2)
