/- The original coefficient phase is retained along the entire relabeled full path. -/

open scoped Classical
namespace Bounty
section Path
variable {I H V : Type} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : I → Fin N → Finset (Fin J)) (k : I → ℤ) (ζ : I → ℝ)
