open Finset
open scoped Classical

noncomputable def cleanHybridPatternCoreAction {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : I → G → Finset (Fin J)) (ζ θ : ℝ) (k : ℤ)
    (p : FixedOrderedMemoryLabels Pb N)
    (K : ∀ i, RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb (C i) → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : RepeatedBigLists Pb J ell → (PhysicalResidues Ps × FixedOrderedResidues p) → ℂ)
    (source : RepeatedBigLists Pb J ell) (r : PhysicalResidues Ps × FixedOrderedResidues p) : ℂ :=
  ∑ i, cleanHybridCoreAction Vb b (C i) ζ θ k p (K i) d f source r

theorem clean_hybrid_pattern_core_translated {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : I → G → Finset (Fin J)) (ζ θ : ℝ) (k : ℤ)
    (p : FixedOrderedMemoryLabels Pb N)
    (K : ∀ i, RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb (C i) → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : RepeatedBigLists Pb J ell → (PhysicalResidues Ps × FixedOrderedResidues p) → ℂ) :
    cleanHybridPatternCoreAction Vb b C ζ θ k p K d f =
      cleanTranslatedSumOperator
        (fun a : (i : I) × PhysicalAuxLabels Pb (C i) =>
          cleanHybridCoreCoefficient Vb b (C a.1) ζ θ k (K a.1) d a.2)
        (fun a source _ => cleanHybridResidueDirection p (cleanHybridStep k (C a.1) source a.2 d)) f := by
  funext source r
  simp only [cleanHybridPatternCoreAction, cleanHybridCoreAction, cleanTranslatedSumOperator,
    cleanTranslatedOperator, Fintype.sum_sigma, clean_hybrid_residue_translation]

/-- The frequency is independent of the pattern, so all signed patterns remain
inside a single real-frequency ideal block. -/
theorem clean_hybrid_pattern_block_real_frequency {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : I → G → Finset (Fin J)) (ζ θ : ℝ) (k : ℤ)
    (p : FixedOrderedMemoryLabels Pb N)
    [∀ q : PhysicalPrime Ps, NeZero q.2.val] [∀ g j, NeZero (p g j).val]
    (K : ∀ i, RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb (C i) → ℂ)
    (d : PhysicalSharedLists Ps J)
    (χ : AddChar (PhysicalResidues Ps × FixedOrderedResidues p) ℂ) :
    ∃ Θ : ℝ, ∀ (v : RepeatedBigLists Pb J ell → ℂ) source,
      cleanFourierSumBlock
        (fun a : (i : I) × PhysicalAuxLabels Pb (C i) =>
          cleanHybridCoreCoefficient Vb b (C a.1) ζ θ k (K a.1) d a.2)
        (fun a source _ => cleanHybridResidueDirection p (cleanHybridStep k (C a.1) source a.2 d))
        χ v source = physicalPhase ζ (physicalSharedProduct d) *
          ∑ target, (∑ i, ∑ aux, repeatedBigKernel Vb b (C i) ζ (K i) aux source target *
            physicalReturnPhase Θ (repeatedBigD (C i) source aux)) * v target := by
  obtain ⟨Θ, hΘ⟩ := exists_physical_character_return_frequency χ
    (cleanHybridResidueDirection (Ps := Ps) p) θ (k * (physicalSharedProduct d : ℤ))
  refine ⟨Θ, ?_⟩
  intro v source
  rw [clean_fourier_sum_block_matrix, mul_sum]
  apply sum_congr rfl
  intro target ht
  rw [← mul_assoc]
  congr 1
  rw [Fintype.sum_sigma, mul_sum]
  apply sum_congr rfl
  intro i hi
  rw [mul_sum]
  apply sum_congr rfl
  intro aux ha
  have hstep : cleanHybridStep k (C i) source aux d =
      (k * (physicalSharedProduct d : ℤ)) * (repeatedBigD (C i) source aux : ℤ) := by
    unfold cleanHybridStep
    ring
  unfold cleanHybridCoreCoefficient
  rw [hstep]
  have h := hΘ (repeatedBigD (C i) source aux : ℤ)
  calc
    _ = physicalPhase ζ (physicalSharedProduct d) *
        (repeatedBigKernel Vb b (C i) ζ (K i) aux source target *
          (χ (cleanHybridResidueDirection p
            ((k * (physicalSharedProduct d : ℤ)) * (repeatedBigD (C i) source aux : ℤ))) *
            physicalReturnPhase θ
              ((k * (physicalSharedProduct d : ℤ)) * (repeatedBigD (C i) source aux : ℤ)))) := by ring
    _ = _ := by rw [h]

theorem clean_hybrid_pattern_projected_norm_le {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : I → G → Finset (Fin J)) (ζ θ : ℝ) (k : ℤ)
    (p : FixedOrderedMemoryLabels Pb N)
    [∀ q : PhysicalPrime Ps, NeZero q.2.val] [∀ g j, NeZero (p g j).val]
    (K : ∀ i, RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb (C i) → ℂ)
    (d : PhysicalSharedLists Ps J) (w : RepeatedBigLists Pb J ell → ℝ) (hw : ∀ x, 0 ≤ w x)
    (Proj : (RepeatedBigLists Pb J ell → ℂ) →ₗ[ℂ] (RepeatedBigLists Pb J ell → ℂ))
    (U : Submodule ℂ (RepeatedBigLists Pb J ell → ℂ)) (hProjU : ∀ v, Proj v ∈ U)
    (hProj : ∀ v, cleanActiveNorm w (Proj v) ≤ cleanActiveNorm w v)
    (M : ℝ) (hM : 0 ≤ M)
    (hblock : ∀ (Θ : ℝ) (v : RepeatedBigLists Pb J ell → ℂ), v ∈ U →
      cleanActiveNorm w (Proj (fun source => ∑ target,
        (∑ i, ∑ aux, repeatedBigKernel Vb b (C i) ζ (K i) aux source target *
          physicalReturnPhase Θ (repeatedBigD (C i) source aux)) * v target)) ≤
        M * cleanActiveNorm w v)
    (f : RepeatedBigLists Pb J ell → (PhysicalResidues Ps × FixedOrderedResidues p) → ℂ) :
    cleanWeightedNorm w (cleanActiveMap Proj
        (cleanHybridPatternCoreAction Vb b C ζ θ k p K d (cleanActiveMap Proj f))) ≤
      M * cleanWeightedNorm w f := by
  rw [clean_hybrid_pattern_core_translated]
  change cleanWeightedNorm w (cleanProjectedTranslatedSum Proj _ _ f) ≤ _
  apply clean_projected_translated_norm_le Proj w hw U hProjU hProj _ _ M hM _ f
  intro χ v hv
  obtain ⟨Θ, hΘ⟩ := clean_hybrid_pattern_block_real_frequency Vb b C ζ θ k p K d χ
  have he : cleanFourierSumBlock
      (fun a : (i : I) × PhysicalAuxLabels Pb (C i) =>
        cleanHybridCoreCoefficient Vb b (C a.1) ζ θ k (K a.1) d a.2)
      (fun a source _ => cleanHybridResidueDirection p (cleanHybridStep k (C a.1) source a.2 d)) χ v =
      physicalPhase ζ (physicalSharedProduct d) • (fun source => ∑ target,
        (∑ i, ∑ aux, repeatedBigKernel Vb b (C i) ζ (K i) aux source target *
          physicalReturnPhase Θ (repeatedBigD (C i) source aux)) * v target) := by
    funext source
    exact hΘ v source
  rw [he, map_smul]
  simpa only [cleanActiveNorm, Pi.smul_apply, smul_eq_mul, norm_mul, physical_phase_norm, one_mul]
    using hblock Θ v hv
end

