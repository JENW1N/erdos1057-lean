    (fun u => ∑ n ∈ F, γ n*harmonicMellinWeight u n)
    (by unfold harmonicMellinWeight; fun_prop) (by unfold harmonicMellinWeight; fun_prop)
    UQ Alo Blo σ q χ hUQ hQA hAB hBQ hq hσ (fun _ => rfl)
    (fun u _ => by
      simpa only [Real.rpow_one] using
        (roughBand_mellin_global_norm UQ Alo Blo (Real.exp (Real.sqrt L)) (u+σ)
          hUQ1 hQA hAB hBQ q χ).trans (by linarith : 2 ≤ L))
    (fun u _ => hTbound u) hlow
    5 5 lom him lor hir wm wr Vm Vr
    (by simpa only [Nat.cast_ofNat, Real.rpow_one] using hL) (by simpa only [Nat.cast_ofNat, Real.rpow_one] using hL)
  · intro j
