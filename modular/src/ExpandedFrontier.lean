      (fullMixedEdgeOwnerSampleEmbedding n S B k steps u htag (A k) (Δ k) (D k) s sk i)) = some (.inr ⟨i.1, fresh i⟩) := by
  have h := full_mixed_tagged_owner_born_data n S B A Δ D steps u (some (.inr k)) htag s
    ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm ⟨sk, fresh⟩) x p hocc
    (fullMixedBirthCoordinateEquiv n S B A Δ D (some (.inr k)) s ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm ⟨sk, fresh⟩) i).val
  exact h.trans (full_mixed_birth_coordinate_data n S B A Δ D (some (.inr k)) s ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm ⟨sk, fresh⟩) i)

theorem full_mixed_edge_owner_sample_label (hocc : fullMixedOwnerOccurrence n S B A Δ D steps x p u =
      ⟨s, fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inr k)) htag s ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm ⟨sk, fresh⟩)⟩)
    (i : FullActiveEdgeSampleIndex n (S k) B (A k) (Δ k) (D k) s sk) :
    fullMixedPathBirthLabel n S B A Δ D steps x p (fullMixedBirthOrder S B steps
      (fullMixedEdgeOwnerSampleEmbedding n S B k steps u htag (A k) (Δ k) (D k) s sk i)) = some ⟨i.1, fresh i⟩ := by
  unfold fullMixedPathBirthLabel
