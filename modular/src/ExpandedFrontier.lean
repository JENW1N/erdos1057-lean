        ⟨physicalRootSmallPlanPattern groups patterns C hC p,
          (physicalGroupSelectedSplit (fun g => g ∈ groupsᶜ)
            (fun j => C (physicalRootSmallPlanPattern groups patterns C hC p j).val)).symm
              (physicalRootSmallPlanSmallData groups patterns C hC p, db)⟩ := by
