section
open Finset Classical
universe u v w

def finiteEventPathCount {K : Type u} {X : Type v} (E : K → X → Type w)
    (target : ∀ k x, E k x → X) (count : ∀ k x, E k x → ℕ) :
    ∀ steps x, FiniteEventPath E target steps x → ℕ
  | [], _, _ => 0
  | k :: steps, x, ⟨e, p⟩ =>
      count k x e + finiteEventPathCount E target count steps (target k x e) p

theorem finite_event_path_weight_eq_pow_mul {K : Type u} {X : Type v}
    (E : K → X → Type w) (target : ∀ k x, E k x → X)
    (weight marked : ∀ k x, E k x → ℝ) (count : ∀ k x, E k x → ℕ) (a : ℝ)
    (h : ∀ k x e, marked k x e = a ^ count k x e * weight k x e)
    (steps : List K) (x : X) (p : FiniteEventPath E target steps x) :
    finiteEventPathWeight E target marked steps x p =
      a ^ finiteEventPathCount E target count steps x p *
        finiteEventPathWeight E target weight steps x p := by
  induction steps generalizing x with
  | nil => simp only [finiteEventPathWeight, finiteEventPathCount, pow_zero, one_mul]
  | cons k steps ih =>
    rcases p with ⟨e, p⟩
    simp only [finiteEventPathWeight, finiteEventPathCount, h, ih, pow_add]
    ring

theorem boundedGhostEventWeight_birth_scale {P Z : Type*} (A D C ν : Z → ℝ)
    (a : ℝ) (t B : ℕ) (s : BoundedOrderedState P Z t B) (e : BoundedGhostEvent t B s) :
    boundedGhostEventWeight A D (fun z => a * C z) ν t B s e =
      a ^ e.1.val * boundedGhostEventWeight A D C ν t B s e := by
  unfold boundedGhostEventWeight
  split_ifs
  · simp only [mul_assoc, prod_mul_distrib, prod_const, card_univ, Fintype.card_fin]
    ring
  · exact (mul_zero _).symm

theorem coupledGhostJointEventWeight_birth_scale {G : Type*} [Fintype G]
    {P Z : G → Type*} (A D C ν : ∀ g, Z g → ℝ) (a : ℝ)
    (t : G → ℕ) (B : ℕ) (s : ProductBoundedOrderedState P Z t B)
    (e : CoupledGhostEvent t B s) :
    coupledGhostJointEventWeight A D (fun g z => a * C g z) ν t B s e =
      a ^ (∑ g, (e g).1.val) * coupledGhostJointEventWeight A D C ν t B s e := by
  unfold coupledGhostJointEventWeight
  split_ifs
  · simp_rw [boundedGhostEventWeight_birth_scale]
    rw [prod_mul_distrib, prod_pow_eq_pow_sum]
  · exact (mul_zero _).symm

theorem physicalGhostBirth_scale {P : Type*} (n : P → ℕ) (q ρ V a : ℝ)
    (z : UnrestrictedResidueParticle n) :
    physicalGhostBirth n q ρ (a * V) z = a * physicalGhostBirth n q ρ V z := by
  unfold physicalGhostBirth
  split_ifs <;> ring

section Full

variable {J K G : Type*} [Fintype G] {P : G → Type*}
  (n : ∀ g, P g → ℕ) {M : G → ℕ}
  (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → G → ℤ)

def fullGhostEventBirthCount :
    (k : Option (J ⊕ K)) →
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) →
    FullPermutationMixedEvent n S B A Δ D k s → ℕ
  | none, _, _ => 0
  | some (.inl _), _, e => ∑ g, (e.down g).1.val
  | some (.inr _), _, _ => 0

noncomputable def fullGhostPathBirthCount (steps : List (Option (J ⊕ K)))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps s) : ℕ :=
  finiteEventPathCount (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) (fullGhostEventBirthCount n S B A Δ D)
    steps s p

theorem full_doubled_ghost_event_weight_eq [DecidableEq G]
    (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)
    (k : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D k s) :
    fullDoubledGhostEventWeight n S B A Δ D ω μ q ρ V k s e =
      (2 : ℝ) ^ fullGhostEventBirthCount n S B A Δ D k s e *
        fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V k s e := by
  cases k with
  | none =>
    simp only [fullDoubledGhostEventWeight, fullGhostEventBirthCount,
      pow_zero, one_mul]
    rfl
  | some k =>
    cases k with
    | inl j =>
      dsimp only [FullPermutationMixedEvent, FullMixedMemoryEvent] at e
      change coupledGhostJointEventWeight
          (fun g => physicalGhostRetention (n g) (q j) ρ)
          (fun g => physicalGhostTermination (n g) (q j) ρ)
          (fun g z => physicalGhostBirth (n g) (q j) ρ (2 * V g) z)
          (fun g => unrestrictedResidueWeight (μ g)) M B s e.down =
        (2 : ℝ) ^ (∑ g, (e.down g).1.val) *
          coupledGhostJointEventWeight
            (fun g => physicalGhostRetention (n g) (q j) ρ)
            (fun g => physicalGhostTermination (n g) (q j) ρ)
            (fun g => physicalGhostBirth (n g) (q j) ρ (V g))
            (fun g => unrestrictedResidueWeight (μ g)) M B s e.down
      simp_rw [physicalGhostBirth_scale]
      exact coupledGhostJointEventWeight_birth_scale
        (fun g => physicalGhostRetention (n g) (q j) ρ)
        (fun g => physicalGhostTermination (n g) (q j) ρ)
        (fun g => physicalGhostBirth (n g) (q j) ρ (V g))
        (fun g => unrestrictedResidueWeight (μ g)) 2 M B s e.down
    | inr k =>
      simp only [fullDoubledGhostEventWeight, fullGhostEventBirthCount,
        pow_zero, one_mul]
      rfl

theorem full_doubled_ghost_path_weight_eq [DecidableEq G]
    (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)
    (steps : List (Option (J ⊕ K)))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps s) :
    finiteEventPathWeight (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D)
      (fullDoubledGhostEventWeight n S B A Δ D ω μ q ρ V) steps s p =
      (2 : ℝ) ^ fullGhostPathBirthCount n S B A Δ D steps s p *
        finiteEventPathWeight (FullPermutationMixedEvent n S B A Δ D)
          (fullPermutationMixedEventTarget n S B A Δ D)
          (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V) steps s p :=
  finite_event_path_weight_eq_pow_mul (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D)
    (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V)
    (fullDoubledGhostEventWeight n S B A Δ D ω μ q ρ V)
    (fullGhostEventBirthCount n S B A Δ D) 2
    (full_doubled_ghost_event_weight_eq n S B A Δ D ω μ q ρ V) steps s p

end Full
end

section
open scoped BigOperators Classical
theorem prime_major_arc_dyadic_pairing (hZ : PrimitiveZeroFreeHalfPlane) :
    ∃ C : ℝ, 0 < C ∧ ∀ Q : ℕ, 0 < Q →
    ∀ {I J : Type u} [Fintype I] [DecidableEq I] [Fintype J] [DecidableEq J],
    ∀ (P : I → Finset ℕ) (V : I → ℝ) (i : I)
      (R : J → Finset ℕ) (W : J → ℝ) (j : J),
    (∀ k, 0 < V k) → (∀ k, 0 < W k) →
    (∀ k p, p ∈ P k → p.Prime ∧ Q < p) →
    (∀ k p, p ∈ R k → p.Prime ∧ Q < p) →
    (∀ k, ∑ p ∈ P k, 1 / (p : ℝ) = V k) →
    (∀ k, ∑ p ∈ R k, 1 / (p : ℝ) = W k) →
    ∀ a b a' b' : ℝ, P i = primeBand a b → R j = primeBand a' b' →
    2 ≤ a → 0 ≤ b → 2 ≤ a' → 0 ≤ b' →
    ∀ h ξ : ℝ, 0 < h → h ≤ Real.log 2 → 0 < ξ →
    ∀ U T : ℝ, 0 ≤ U → 0 ≤ T →
    ∀ (f : (∀ k, P k) → ℂ) (g : (∀ k, R k) → ℂ),
    (∀ x, f x ≠ 0 → U ≤ ((∏ k, (x k).val : ℕ) : ℝ) ∧
      ((∏ k, (x k).val : ℕ) : ℝ) ≤ 2 * U) →
    (∀ y, g y ≠ 0 → T ≤ ((∏ k, (y k).val : ℕ) : ℝ) ∧
      ((∏ k, (y k).val : ℕ) : ℝ) ≤ 2 * T) →
    ∀ r : ℕ, 0 < r → r ≤ Q → ∀ u : ℤ, ∀ ζ β : ℝ,
    let μ := finiteProductWeight (physicalLabelLaw (P := P) V)
    let ν := finiteProductWeight (physicalLabelLaw (P := R) W)
    let cellP := fun x : (∀ k, P k) => upperLogCell h (Real.log (∏ k, (x k).val : ℕ))
    let cellR := fun y : (∀ k, R k) => upperLogCell h (Real.log (∏ k, (y k).val : ℕ))
    let KA := primeProductIdealKernel P V Q h (primeProductRetainedCells P V h ξ)
    let KB := primeProductIdealKernel R W Q h (primeProductRetainedCells R W h ξ)
    let phase := fun (x : ∀ k, P k) (y : ∀ k, R k) => Complex.exp (Complex.I *
      (ζ * Real.log (((∏ k, (x k).val : ℕ) : ℝ) * (∏ k, (y k).val : ℕ)) +
        2 * Real.pi * (((u : ℝ) / r + β) *
          (((∏ k, (x k).val : ℕ) : ℝ) * (∏ k, (y k).val : ℕ))) : ℝ))
    ‖∑ x, ∑ y, ((μ x * ν y : ℝ) : ℂ) *
      ((phase x y - finiteTwoKernelAverage μ ν KA KB x y phase) * f x * g y)‖ ≤
      (Real.sqrt (((finiteOccupiedCells cellP).card + (finiteOccupiedCells cellR).card : ℝ) * ξ) +
        (2 * h * (|ζ| + 2 * Real.pi * |β| * (16 * U * T))) * (Q * Q : ℕ) * (Q * Q : ℕ) +
        Real.sqrt (Q : ℝ) * (primeKernelError C Q (V i) a ξ + primeKernelError C Q (W j) a' ξ +
          primeKernelError C Q (V i) a ξ * primeKernelError C Q (W j) a' ξ)) *
      Real.sqrt ((∑ x, μ x * ‖f x‖ ^ 2) * ∑ y, ν y * ‖g y‖ ^ 2) := by
  obtain ⟨C, hC, hpoint⟩ := prime_major_arc_comparison.{u} hZ
  refine ⟨C, hC, ?_⟩
  intro Q hQ I J _ _ _ _ P V i R W j hV hW hP hR hVP hWR
    a b a' b' hPi hRj ha hb ha' hb' h ξ hh hh2 hξ U T hU hT f g hf hg r hr hrQ u ζ β
  let μ := finiteProductWeight (physicalLabelLaw (P := P) V)
  let ν := finiteProductWeight (physicalLabelLaw (P := R) W)
  let cellP := fun x : (∀ k, P k) => upperLogCell h (Real.log (∏ k, (x k).val : ℕ))
  let cellR := fun y : (∀ k, R k) => upperLogCell h (Real.log (∏ k, (y k).val : ℕ))
  let keptP := primeProductRetainedCells P V h ξ
  let keptR := primeProductRetainedCells R W h ξ
  let KA := primeProductIdealKernel P V Q h keptP
  let KB := primeProductIdealKernel R W Q h keptR
  let phase := fun (x : ∀ k, P k) (y : ∀ k, R k) => Complex.exp (Complex.I *
    (ζ * Real.log (((∏ k, (x k).val : ℕ) : ℝ) * (∏ k, (y k).val : ℕ)) +
      2 * Real.pi * (((u : ℝ) / r + β) *
        (((∏ k, (x k).val : ℕ) : ℝ) * (∏ k, (y k).val : ℕ))) : ℝ))
  let comparison := fun x y => finiteTwoKernelAverage μ ν KA KB x y phase
  let E := fun x y => cellP x ∉ keptP ∨ cellR y ∉ keptR
  let ε := (2 * h * (|ζ| + 2 * Real.pi * |β| * (16 * U * T))) * (Q * Q : ℕ) * (Q * Q : ℕ) +
    Real.sqrt (Q : ℝ) * (primeKernelError C Q (V i) a ξ + primeKernelError C Q (W j) a' ξ +
      primeKernelError C Q (V i) a ξ * primeKernelError C Q (W j) a' ξ)
  have hμ (x : ∀ k, P k) : 0 ≤ μ x :=
    Finset.prod_nonneg (fun k _ => physical_label_law_nonneg V (fun k => (hV k).le) k (x k))
  have hν (y : ∀ k, R k) : 0 ≤ ν y :=
    Finset.prod_nonneg (fun k _ => physical_label_law_nonneg W (fun k => (hW k).le) k (y k))
  have hμmass : ∑ x, μ x = 1 :=
    finite_product_weight_sum_one _ (fun k => physical_label_law_sum V k (hV k) (hVP k))
  have hνmass : ∑ y, ν y = 1 :=
    finite_product_weight_sum_one _ (fun k => physical_label_law_sum W k (hW k) (hWR k))
  have hraw (x : ∀ k, P k) (y : ∀ k, R k) : ‖phase x y‖ ≤ 1 := by
    have hn (t : ℝ) : ‖Complex.exp (Complex.I * (t : ℂ))‖ = 1 := by
      rw [Complex.norm_exp]
      simp
    exact (hn _).le
  have hzero (x : ∀ k, P k) (y : ∀ k, R k) (he : E x y) : comparison x y = 0 := by
    rcases he with hx | hy
    · apply finite_two_kernel_average_zero_left
      intro d
      exact prime_ideal_kernel_zero_of_right_discarded P V Q h keptP d x hx
    · apply finite_two_kernel_average_zero_right
      intro e
      exact prime_ideal_kernel_zero_of_right_discarded R W Q h keptR e y hy
  have hε : 0 ≤ ε := by
    have hεA := prime_kernel_error_nonneg hC.le (hV i).le ha hξ.le hQ
    have hεB := prime_kernel_error_nonneg hC.le (hW j).le ha' hξ.le hQ
    dsimp only [ε]
    positivity
  have hclose (x : ∀ k, P k) (y : ∀ k, R k)
      (hfx : f x ≠ 0) (hgy : g y ≠ 0) (he : ¬ E x y) :
      ‖phase x y - comparison x y‖ ≤ ε := by
    have hx : cellP x ∈ keptP := not_not.mp (not_or.mp he).1
    have hy : cellR y ∈ keptR := not_not.mp (not_or.mp he).2
    have hc := prime_kernel_pair_dyadic_cap P V R W Q
      (fun k p hp => (hP k p hp).1.pos) (fun k p hp => (hR k p hp).1.pos)
      hh hh2 keptP keptR hU hT x y (hf x hfx).2 (hg y hgy).2
    have hp := hpoint Q hQ P V i R W j hV hW hP hR hVP hWR
      a b a' b' hPi hRj ha hb ha' hb' h ξ hh hξ keptP keptR
      (fun d hd => prime_product_retained_cell_mass P V h ξ hd)
      (fun e he => prime_product_retained_cell_mass R W h ξ he)
      x y hx hy r hr hrQ u ζ β (16 * U * T) (by positivity) hc.1 hc.2
    rw [norm_sub_rev]
    exact hp
  have hpair := finite_retained_comparison_pairing_supported μ ν hμ hν hμmass hνmass
    E phase comparison hraw hzero f g hε hclose
  have hmass : finitePairEventMass μ ν E ≤
      ((finiteOccupiedCells cellP).card + (finiteOccupiedCells cellR).card : ℝ) * ξ :=
    finite_pair_discarded_mass_le μ ν hμ hν hμmass hνmass cellP cellR hξ.le
  have heps : Real.sqrt (finitePairEventMass μ ν E) + ε ≤
      Real.sqrt (((finiteOccupiedCells cellP).card + (finiteOccupiedCells cellR).card : ℝ) * ξ) + ε :=
    add_le_add (Real.sqrt_le_sqrt hmass) le_rfl
  have hbound := hpair.trans (mul_le_mul_of_nonneg_right heps (Real.sqrt_nonneg _))
  simpa only [ε, add_assoc] using hbound
end

