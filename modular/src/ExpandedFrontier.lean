/- Fixed-radius arbitrary-precision window tails on the actual harmonic dyadic factors. -/

open Finset Filter Real
namespace Bounty

theorem eventually_harmonic_normalized_dyadic_tail {r : ℝ} (hr : 0 < r)
    (Cδ Cα Cβ Cγ F : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, 0 < Y → ∀ s Uδ Uα Uβ Uγ : ℝ,
      1 ≤ Uδ → 1 ≤ Uα → 1 ≤ Uβ → 1 ≤ Uγ →
      ∀ (D A B C : Finset ℕ) (δ α β γ : ℕ → ℂ),
      (∀ n ∈ D, Uδ ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*Uδ) →
      (∀ n ∈ A, Uα ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*Uα) →
      (∀ n ∈ B, Uβ ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*Uβ) →
      (∀ n ∈ C, Uγ ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*Uγ) →
      (∀ n ∈ D, ‖δ n‖ ≤ L^Cδ) → (∀ n ∈ A, ‖α n‖ ≤ L^Cα) →
      (∀ n ∈ B, ‖β n‖ ≤ L^Cβ) → (∀ n ∈ C, ‖γ n‖ ≤ L^Cγ) →
      ‖harmonicNormalizedFourBoxError Y s (L^r) D A B C δ α β γ‖ ≤ L^(-F) := by
  filter_upwards [eventually_harmonic_normalized_four_box_tail hr
    16 (Cδ+Cα+Cβ+Cγ) F (by norm_num), eventually_gt_atTop (0 : ℝ)] with L ht hL
  intro Y hY s Uδ Uα Uβ Uγ hUδ hUα hUβ hUγ D A B C δ α β γ hD hA hB hC hδ hα hβ hγ
  have hp {U : ℝ} (hU : 1 ≤ U) {S : Finset ℕ}
      (hS : ∀ n ∈ S, U ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*U) : ∀ n ∈ S, 0 < n := by
    intro n hn
    have hn0 : (0 : ℝ) < n := (zero_lt_one.trans_le hU).trans_le (hS n hn).1
    exact_mod_cast hn0
  apply ht Y hY s D A B C δ α β γ (hp hUδ hD) (hp hUα hA) (hp hUβ hB) (hp hUγ hC)
  calc
    _ ≤ (2*L^Cδ)*(2*L^Cα)*(2*L^Cβ)*(2*L^Cγ) := by
      gcongr
      · exact dyadic_harmonic_mass_le D δ hUδ (rpow_nonneg hL.le _) hD hδ
      · exact dyadic_harmonic_mass_le A α hUα (rpow_nonneg hL.le _) hA hα
      · exact dyadic_harmonic_mass_le B β hUβ (rpow_nonneg hL.le _) hB hβ
      · exact dyadic_harmonic_mass_le C γ hUγ (rpow_nonneg hL.le _) hC hγ
    _ = 16*(L^Cδ*L^Cα*L^Cβ*L^Cγ) := by ring
    _ = _ := by rw [← rpow_add hL, ← rpow_add hL, ← rpow_add hL]

end Bounty
end

