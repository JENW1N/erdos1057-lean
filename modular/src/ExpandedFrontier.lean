  specialize hc₁ ε ε_pos ε_lt_one X X_gt_3 T_gt_3
  specialize hc₂ X X_gt_3 ε_pos ε_lt_one T_gt_3
  specialize hc₃ X X_gt_3 ε_pos ε_lt_one T_gt_3
  specialize hc₅ X X_gt_3 ε_pos ε_lt_one
  specialize hc₇ X X_gt_3 ε_pos ε_lt_one T_gt_3
  specialize hc₈ X X_gt_3 ε_pos ε_lt_one T_gt_3
  specialize hc₉ ε_pos ε_lt_one X X_gt_3 T_gt_3
  specialize hc₄ X X_gt_3 ε_pos ε_lt_one T_gt_Tlb₄
  specialize hc₆ X X_gt_3 ε_pos ε_lt_one T_gt_Tlb₆

  clear ν_nonneg ν_massOne ContDiff1ν ν_supp holo2

  have C'bnd : c_close * ε * X * Real.log X + C_main * ε * X ≤ C' * ε * X * Real.log X := by
    have : C_main * ε * X * 1 ≤ C_main * ε * X * Real.log X := by
      gcongr
    linarith

  have C''bnd : c₁ * X * Real.log X / (ε * T) + c₂ * X / (ε * T) + c₈ * X / (ε * T)
    + c₉ * X * Real.log X / (ε * T) ≤ C'' * X * Real.log X / (ε * T) := by
    unfold C''
    rw [(by ring : (c₁ + c₂ + c₈ + c₉) * X * Real.log X / (ε * T)
      = c₁ * X * Real.log X / (ε * T) + c₂ * X * Real.log X / (ε * T)
        + c₈ * X * Real.log X / (ε * T) + c₉ * X * Real.log X / (ε * T))]
    have : c₂ * X / (ε * T) * 1 ≤ c₂ * X / (ε * T) * Real.log X := by
      gcongr
    have : c₂ * X / (ε * T) ≤ c₂ * X * Real.log X / (ε * T) := by
      ring_nf at this ⊢
      linarith
    grw [this]
    have : c₈ * X / (ε * T) * 1 ≤ c₈ * X / (ε * T) * Real.log X := by
      gcongr
    have : c₈ * X / (ε * T) ≤ c₈ * X * Real.log X / (ε * T) := by
      ring_nf at this ⊢
      linarith
    grw [this]

  have C'''bnd : c₃ * X * X ^ (-A / Real.log T ^ n₁) / ε
                    + c₄ * X * X ^ (-A / Real.log T ^ n₁) / ε
                    + c₆ * X * X ^ (-A / Real.log T ^ n₁) / ε
                    + c₇ * X * X ^ (-A / Real.log T ^ n₁) / ε
                  ≤ C''' * X * X ^ (-A / Real.log T ^ n₁) / ε := by
    apply le_of_eq
    ring

  calc
    _         = ‖(ψ X - ψ_ε_of_X) + (ψ_ε_of_X - X)‖ := by ring_nf; norm_cast
    _         ≤ ‖ψ X - ψ_ε_of_X‖ + ‖ψ_ε_of_X - X‖ := norm_add_le _ _
    _         = ‖ψ X - ψ_ε_of_X‖ + ‖(ψ_ε_of_X - mellin (fun x ↦ (Smooth1 ν ε x : ℂ)) 1 * X)
                  + (mellin (fun x ↦ (Smooth1 ν ε x : ℂ)) 1 * X - X)‖ := by ring_nf
    _         ≤ ‖ψ X - ψ_ε_of_X‖ + ‖ψ_ε_of_X - mellin (fun x ↦ (Smooth1 ν ε x : ℂ)) 1 * X‖
                  + ‖mellin (fun x ↦ (Smooth1 ν ε x : ℂ)) 1 * X - X‖ := by
                    rw [add_assoc]
                    gcongr
                    apply norm_add_le
    _         = ‖ψ X - ψ_ε_of_X‖ + ‖mellin (fun x ↦ (Smooth1 ν ε x : ℂ)) 1 * X - X‖
                  + ‖ψ_ε_of_X - mellin (fun x ↦ (Smooth1 ν ε x : ℂ)) 1 * X‖ := by ring
    _         ≤ ‖ψ X - ψ_ε_of_X‖ + ‖mellin (fun x ↦ (Smooth1 ν ε x : ℂ)) 1 * X - X‖
                  + (‖I₁ ν ε X T‖ + ‖I₂ ν ε T X σ₁‖ + ‖I₃ ν ε T X σ₁‖ + ‖I₄ ν ε X σ₁ σ₂‖
                  + ‖I₅ ν ε X σ₂‖ + ‖I₆ ν ε X σ₁ σ₂‖ + ‖I₇ ν ε T X σ₁‖ + ‖I₈ ν ε T X σ₁‖
                  + ‖I₉ ν ε X T‖) := by gcongr
    _         ≤ c_close * ε * X * Real.log X + C_main * ε * X
                  + (c₁ * X * Real.log X / (ε * T) + c₂ * X / (ε * T)
                  + c₃ * X * X ^ (-A / Real.log T ^ n₁) / ε
                  + c₄ * X * X ^ (-A / Real.log T ^ n₁) / ε
                  + c₅ * X ^ σ₂ / ε
                  + c₆ * X * X ^ (-A / Real.log T ^ n₁) / ε
                  + c₇ * X * X ^ (-A / Real.log T ^ n₁) / ε
                  + c₈ * X / (ε * T)
                  + c₉ * X * Real.log X / (ε * T)) := by
      gcongr
      convert! h_close using 1
      rw [← norm_neg]
      congr
      ring
    _         =  (c_close * ε * X * Real.log X + C_main * ε * X)
                  + ((c₁ * X * Real.log X / (ε * T) + c₂ * X / (ε * T)
                  + c₈ * X / (ε * T)
                  + c₉ * X * Real.log X / (ε * T))
                  + (c₃ * X * X ^ (-A / Real.log T ^ n₁) / ε
                  + c₄ * X * X ^ (-A / Real.log T ^ n₁) / ε
                  + c₆ * X * X ^ (-A / Real.log T ^ n₁) / ε
                  + c₇ * X * X ^ (-A / Real.log T ^ n₁) / ε)
                  + c₅ * X ^ σ₂ / ε
                  ) := by ring
    _         ≤ C' * ε * X * Real.log X
                  + (C'' * X * Real.log X / (ε * T)
                  + C''' * X * X ^ (-A / Real.log T ^ n₁) / ε
                  + c₅ * X ^ σ₂ / ε
                  ) := by
      gcongr
    _        = C' * ε * X * Real.log X
                  + C'' * X * Real.log X / (ε * T)
                  + C''' * X * X ^ (-A / Real.log T ^ n₁) / ε
                  + c₅ * X ^ σ₂ / ε
                    := by ring
    _        ≤ C' * X * rexp (-c * Real.log X ^ ((1 : ℝ) / (1 + n₁)))
                  + C'' * X * rexp (-c * Real.log X ^ ((1 : ℝ) / (1 + n₁)))
                  + C''' * X * rexp (-c * Real.log X ^ ((1 : ℝ) / (1 + n₁)))
                  + c₅ * X * rexp (-c * Real.log X ^ ((1 : ℝ) / (1 + n₁)))
                    := by
      gcongr
    _        = C * X * rexp (-c * Real.log X ^ ((1 : ℝ) / (1 + n₁)))
                    := by ring
    _        = _ := by
      rw [Real.norm_of_nonneg]
      · rw [← mul_assoc]
      · positivity

 
theorem MediumPNT : ∃ c > 0,
    (ψ - id) =O[atTop]
      fun (x : ℝ) ↦ x * Real.exp (-c * (Real.log x) ^ ((1 : ℝ) / 10)) := by
  have := GenStrengthPNT LogDerivZetaBoundedAndHolo99 (by linarith) (by linarith); ring_nf at this
  simpa only [gt_iff_lt, one_div, neg_mul] using this
end

section

/- The strict Buchstab recursion, with its repeated-least-prime error retained explicitly. -/

open Finset

namespace Bounty

noncomputable def strictBuchstabComposites (A B z : ℝ) : Finset ℕ := by
  classical
  exact (roughBand A B z).filter (fun n => ¬ n.Prime ∧ ¬ n.minFac ∣ n / n.minFac)

noncomputable def strictBuchstabRemainder (A B z : ℝ) : Finset ℕ := by
  classical
  exact (roughBand A B z).filter (fun n => ¬ n.Prime ∧ n.minFac ∣ n / n.minFac)

theorem strict_buchstab_fiber_image {A B z : ℝ} (hA : 1 ≤ A) (hB : 0 ≤ B)
    {p : ℕ} (hp : p.Prime) (hpz : z < (p : ℝ)) :
    (strictBuchstabComposites A B z).filter (fun n => n.minFac = p) =
      (roughBand (max 1 (A / (p : ℝ))) (B / (p : ℝ)) (p : ℝ)).image (fun m => p * m) := by
  classical
  have hpR : (0 : ℝ) < p := Nat.cast_pos.mpr hp.pos
  have hA0 : 0 ≤ A := by linarith
  have hmax : 0 ≤ max 1 (A / (p : ℝ)) := le_trans (by norm_num) (le_max_left _ _)
  have hBp : 0 ≤ B / (p : ℝ) := div_nonneg hB hpR.le
  ext n
  constructor
  · intro hn
    obtain ⟨hnC, hnp⟩ := mem_filter.mp hn
    obtain ⟨hnR, hnprime, hndiv⟩ := mem_filter.mp hnC
    have hn0 := roughBand_pos hnR
    have hpdiv : p ∣ n := hnp ▸ Nat.minFac_dvd n
    have hmul : p * (n / p) = n := Nat.mul_div_cancel' hpdiv
    have hmlo : 2 ≤ n / p := hp.two_le.trans (by simpa only [hnp] using Nat.minFac_le_div hn0 hnprime)
    have hnA : A < (n : ℝ) := Nat.lt_of_floor_lt (mem_Ioc.mp (mem_filter.mp hnR).1).1
    have hnB : (n : ℝ) ≤ B :=
      (Nat.cast_le.mpr (mem_Ioc.mp (mem_filter.mp hnR).1).2).trans (Nat.floor_le hB)
    have hmulR : (p : ℝ) * (n / p : ℕ) = n := by exact_mod_cast hmul
    apply mem_image.mpr
    refine ⟨n / p, mem_filter.mpr ⟨mem_Ioc.mpr ⟨?_, ?_⟩, ?_⟩, hmul⟩
    · apply (Nat.floor_lt hmax).mpr
      apply max_lt_iff.mpr
      constructor
      · exact_mod_cast hmlo
      · apply (div_lt_iff₀ hpR).mpr
        nlinarith
    · apply Nat.le_floor
      apply (le_div_iff₀ hpR).mpr
      nlinarith
    · intro q hq
      have hpq : p ≤ q := by
        simpa only [hnp] using buchstab_cofactor_prime_factors n q (by simpa only [hnp] using hq)
      have hpne : p ≠ q := by
        intro he
        apply hndiv
        simpa only [hnp, he] using Nat.dvd_of_mem_primeFactors hq
      exact_mod_cast lt_of_le_of_ne hpq hpne
  · intro hn
    obtain ⟨m, hm, rfl⟩ := mem_image.mp hn
    have hm0 := roughBand_pos hm
    have hmlo : max 1 (A / (p : ℝ)) < (m : ℝ) :=
      Nat.lt_of_floor_lt (mem_Ioc.mp (mem_filter.mp hm).1).1
    have hm1 : m ≠ 1 := by
      have hh := (le_max_left 1 (A / (p : ℝ))).trans_lt hmlo
      intro he
      simp only [he, Nat.cast_one, lt_self_iff_false] at hh
    have hmB : (m : ℝ) ≤ B / (p : ℝ) :=
      (Nat.cast_le.mpr (mem_Ioc.mp (mem_filter.mp hm).1).2).trans (Nat.floor_le hBp)
    have hrough := (mem_filter.mp hm).2
    have hmin : (p * m).minFac = p := buchstab_minFac_mul hp hm0.ne'
      (fun q hq => by exact_mod_cast (hrough q hq).le)
    have hpndiv : ¬ p ∣ m := by
      intro hdiv
      have hh := hrough p (hp.mem_primeFactors hdiv hm0.ne')
      exact lt_irrefl _ hh
    have hquot : p * m / p = m := Nat.mul_div_cancel_left m hp.pos
    apply mem_filter.mpr
    refine ⟨mem_filter.mpr ⟨?_, Nat.not_prime_mul hp.ne_one hm1, ?_⟩, hmin⟩
    · apply mem_filter.mpr
      refine ⟨mem_Ioc.mpr ⟨?_, ?_⟩, ?_⟩
      · apply (Nat.floor_lt hA0).mpr
        have hh := (div_lt_iff₀ hpR).mp ((le_max_right 1 (A / (p : ℝ))).trans_lt hmlo)
        simpa only [Nat.cast_mul, mul_comm] using hh
      · apply Nat.le_floor
        have hh := (le_div_iff₀ hpR).mp hmB
        simpa only [Nat.cast_mul, mul_comm] using hh
      · intro q hq
        rw [Nat.primeFactors_mul hp.ne_zero hm0.ne', hp.primeFactors] at hq
        rcases mem_union.mp hq with hqp | hqm
        · simpa only [mem_singleton.mp hqp] using hpz
        · exact hpz.trans (hrough q hqm)
    · simpa only [hmin, hquot] using hpndiv

theorem strict_buchstab_composites_count {A B z : ℝ}
    (hA : 1 ≤ A) (hB : 0 ≤ B) (hz : 0 ≤ z) :
    (strictBuchstabComposites A B z).card =
      ∑ p ∈ primeBand z (Real.sqrt B),
        (roughBand (max 1 (A / (p : ℝ))) (B / (p : ℝ)) (p : ℝ)).card := by
  classical
  have hmap : ∀ n ∈ strictBuchstabComposites A B z,
      n.minFac ∈ primeBand z (Real.sqrt B) := by
    intro n hn
    obtain ⟨hnR, hnprime, _⟩ := mem_filter.mp hn
    have hn0 := roughBand_pos hnR
    have hnA : A < (n : ℝ) := Nat.lt_of_floor_lt (mem_Ioc.mp (mem_filter.mp hnR).1).1
    have hn1 : n ≠ 1 := by
      intro he
      simp only [he, Nat.cast_one] at hnA
      linarith
    have hp := Nat.minFac_prime hn1
    have hnB : (n : ℝ) ≤ B :=
      (Nat.cast_le.mpr (mem_Ioc.mp (mem_filter.mp hnR).1).2).trans (Nat.floor_le hB)
    apply (mem_primeBand_iff hz (Real.sqrt_nonneg _) _).mpr
    refine ⟨hp, (mem_filter.mp hnR).2 n.minFac
      (Nat.mem_primeFactors.mpr ⟨hp, Nat.minFac_dvd n, hn0.ne'⟩), ?_⟩
    apply Real.le_sqrt_of_sq_le
    have hsq : (n.minFac : ℝ) ^ 2 ≤ n := by exact_mod_cast Nat.minFac_sq_le_self hn0 hnprime
    exact hsq.trans hnB
  rw [card_eq_sum_card_fiberwise hmap]
  apply sum_congr rfl
  intro p hp
  obtain ⟨hpp, hpz, _⟩ := (mem_primeBand_iff hz (Real.sqrt_nonneg _) p).mp hp
  rw [strict_buchstab_fiber_image hA hB hpp hpz]
  exact card_image_of_injective _ (fun a b hab => Nat.eq_of_mul_eq_mul_left hpp.pos hab)

theorem strict_buchstab_count_with_remainder {A B z : ℝ}
    (hA : 1 ≤ A) (hB : 0 ≤ B) (hz : 0 ≤ z) :
    (roughBand A B z).card = (primeBand (max A z) B).card +
      (∑ p ∈ primeBand z (Real.sqrt B),
        (roughBand (max 1 (A / (p : ℝ))) (B / (p : ℝ)) (p : ℝ)).card) +
      (strictBuchstabRemainder A B z).card := by
  classical
  have hprime := card_filter_add_card_filter_not (s := roughBand A B z) Nat.Prime
  have hcomp := card_filter_add_card_filter_not
    (s := (roughBand A B z).filter (fun n => ¬ n.Prime))
    (fun n => ¬ n.minFac ∣ n / n.minFac)
  have hgood : ((roughBand A B z).filter (fun n => ¬ n.Prime)).filter
      (fun n => ¬ n.minFac ∣ n / n.minFac) = strictBuchstabComposites A B z := by
    simp only [filter_filter, strictBuchstabComposites]
  have hbad : ((roughBand A B z).filter (fun n => ¬ n.Prime)).filter
      (fun n => ¬ ¬ n.minFac ∣ n / n.minFac) = strictBuchstabRemainder A B z := by
    simp only [not_not, filter_filter, strictBuchstabRemainder]
  rw [hgood, hbad, strict_buchstab_composites_count hA hB hz] at hcomp
  rw [prime_part_of_rough_band (by linarith : 0 ≤ A) hB] at hprime
  omega

theorem strict_buchstab_remainder_subset_nonsquarefree {A B z : ℝ} (hA : 1 ≤ A) :
    strictBuchstabRemainder A B z ⊆ (roughBand A B z).filter (fun n => ¬ Squarefree n) := by
  classical
  intro n hn
  obtain ⟨hnR, _, hdiv⟩ := mem_filter.mp hn
  have hnA : A < (n : ℝ) := Nat.lt_of_floor_lt (mem_Ioc.mp (mem_filter.mp hnR).1).1
  have hn1 : n ≠ 1 := by
    intro he
    simp only [he, Nat.cast_one] at hnA
    linarith
  refine mem_filter.mpr ⟨hnR, ?_⟩
  intro hsq
  exact (Nat.squarefree_iff_prime_squarefree.mp hsq) n.minFac (Nat.minFac_prime hn1)
    (Nat.mul_dvd_of_dvd_div (Nat.minFac_dvd n) hdiv)

theorem strict_buchstab_remainder_card_le {A B z : ℝ}
    (hA : 1 ≤ A) (hB : 0 ≤ B) (hz : 0 < z) :
    ((strictBuchstabRemainder A B z).card : ℝ) ≤ 2 * B / z := by
  have hsub : ((strictBuchstabRemainder A B z).card : ℝ) ≤
      (((roughBand A B z).filter (fun n => ¬ Squarefree n)).card : ℝ) := by
    exact_mod_cast card_le_card (strict_buchstab_remainder_subset_nonsquarefree hA)
  exact hsub.trans (rough_band_nonsquarefree_card_le hB hz)

theorem rough_band_strict_buchstab_error {A B z : ℝ}
    (hA : 1 ≤ A) (hB : 0 ≤ B) (hz : 0 < z) :
    0 ≤ ((roughBand A B z).card : ℝ) - ((primeBand (max A z) B).card +
      ∑ p ∈ primeBand z (Real.sqrt B),
        ((roughBand (max 1 (A / (p : ℝ))) (B / (p : ℝ)) (p : ℝ)).card : ℝ)) ∧
    ((roughBand A B z).card : ℝ) - ((primeBand (max A z) B).card +
      ∑ p ∈ primeBand z (Real.sqrt B),
        ((roughBand (max 1 (A / (p : ℝ))) (B / (p : ℝ)) (p : ℝ)).card : ℝ)) ≤ 2 * B / z := by
  have hcount : ((roughBand A B z).card : ℝ) = ((primeBand (max A z) B).card : ℝ) +
      (∑ p ∈ primeBand z (Real.sqrt B),
        ((roughBand (max 1 (A / (p : ℝ))) (B / (p : ℝ)) (p : ℝ)).card : ℝ)) +
      ((strictBuchstabRemainder A B z).card : ℝ) := by
    exact_mod_cast strict_buchstab_count_with_remainder hA hB hz.le
  have hdiff : ((roughBand A B z).card : ℝ) - ((primeBand (max A z) B).card +
      ∑ p ∈ primeBand z (Real.sqrt B),
        ((roughBand (max 1 (A / (p : ℝ))) (B / (p : ℝ)) (p : ℝ)).card : ℝ)) =
      ((strictBuchstabRemainder A B z).card : ℝ) := by linarith
  rw [hdiff]
  exact ⟨Nat.cast_nonneg _, strict_buchstab_remainder_card_le hA hB hz⟩

end Bounty


end

section

/- Conditioning the original small residue labels does not alter the
independent permutation symmetry of the big pending-memory coordinates. -/

namespace Bounty

theorem physical_small_big_condition_memory_symmetric
    {S G : Type*} [Fintype S] [DecidableEq S] [DecidableEq G]
    {Ps : S → Finset ℕ} {P Z : G → Type*} {J ell B : ℕ} {M : G → ℕ}
    (V : S → ℝ) (q : ℝ)
    (F : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ)
    (hF : ∀ s, ProductMemorySymmetric (fun x => F (s, x)))
    (d : PhysicalSharedLists Ps J) (r : PhysicalResidues Ps) :
    ProductMemorySymmetric (fun x => physicalSmallBigCondition V q F d x r) := by
  intro x g τ
  unfold physicalSmallBigCondition
  apply congrArg (physicalSmallCondition V q r d)
  funext L
  exact hF (r, L) x g τ

end Bounty
end

section

/- Choose the clean parameters before the polynomial cost, and the fixed
omission parameter afterwards. This is a scalar budget, not an operator
decomposition or a physical-state identification. -/

open Filter
open scoped Topology

namespace Bounty

theorem rpow_next_saving_le_half (E L : ℝ) (hL : 2 ≤ L) :
    L ^ (-(E + 1)) ≤ (1 / 2 : ℝ) * L ^ (-E) := by
  have hL0 : 0 < L := by linarith
  rw [show -(E + 1) = -E - 1 by ring, Real.rpow_sub hL0, Real.rpow_one]
  apply (div_le_iff₀ hL0).mpr
  have h := mul_le_mul_of_nonneg_left hL (Real.rpow_nonneg hL0.le (-E))
  nlinarith

theorem candidate_clean_rare_scalar_budget (ell J : ℕ) (s A E L : ℝ)
    (hL : 2 ≤ L)
    (hrare : 2 * L ^ A * Real.sqrt ((⌈L ^ 2⌉₊ : ℝ) /
      (((J + ell).choose ell) ^ (candidateSmallPIndices s L).card : ℕ)) ≤
        (1 / 2 : ℝ) * L ^ (-E)) :
    L ^ (-(E + 1)) + 2 * L ^ A * Real.sqrt ((⌈L ^ 2⌉₊ : ℝ) /
      (((J + ell).choose ell) ^ (candidateSmallPIndices s L).card : ℕ)) ≤
        L ^ (-E) := by
  have hclean := rpow_next_saving_le_half E L hL
  linarith

theorem exists_candidate_clean_rare_parameters {s : ℝ} (hs : 0 < s)
    (ell J₀ : ℕ) (hell : 0 < ell) (a E : ℝ) {beta : ℝ} (hbeta : 0 < beta) :
    ∃ (m : ℕ) (D : ℝ), ell ≤ m ∧ 0 ≤ D ∧
      beta * Real.log ((ell : ℝ) ^ ell / (m : ℝ) ^ ell) / 2 ≤ -(E + 3) ∧
      (m : ℝ) * a * Real.log 3 + E + 3 ≤ D ∧
      ∀ A : ℝ, ∃ J : ℕ, max m J₀ ≤ J ∧
        ((1 / (20 * Real.log 2)) / 2) *
          Real.log (((J + ell).choose ell : ℕ) : ℝ) > A + E + 3 ∧
        ∀ᶠ L : ℝ in atTop,
          L ^ (-(E + 1)) ≤ (1 / 2 : ℝ) * L ^ (-E) ∧
          2 * L ^ A * Real.sqrt ((⌈L ^ 2⌉₊ : ℝ) /
            (((J + ell).choose ell) ^ (candidateSmallPIndices s L).card : ℕ)) ≤
              (1 / 2 : ℝ) * L ^ (-E) ∧
          L ^ (-(E + 1)) + 2 * L ^ A * Real.sqrt ((⌈L ^ 2⌉₊ : ℝ) /
            (((J + ell).choose ell) ^ (candidateSmallPIndices s L).card : ℕ)) ≤
              L ^ (-E) := by
  obtain ⟨m, D, hm, hD, hgap, hDgap⟩ :=
    exists_repeated_big_clean_parameters ell hell a (E + 1) hbeta
  refine ⟨m, D, hm, hD, ?_, ?_, ?_⟩
  · linarith
  · linarith
  · intro A
    obtain ⟨J, hJ, hgain, hrare⟩ :=
      exists_candidate_rare_transfer_parameter hs ell hell (max m J₀) A E
    refine ⟨J, hJ, hgain, ?_⟩
    filter_upwards [hrare, eventually_ge_atTop (2 : ℝ)] with L hr hL
    exact ⟨rpow_next_saving_le_half E L hL, hr,
      candidate_clean_rare_scalar_budget ell J s A E L hL hr⟩

end Bounty
end

section

/- The literal mixed event row factors between the two actual small
conditioning maps. This is an equality for the genuine residue-valid small
measure, with all big event coefficients and targets retained. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def physicalSmallBigPrefixAction {S X : Type*} [Fintype S]
    {P : S → Finset ℕ} {J : ℕ}
    (E : PhysicalSharedLists P J → X → Type*) [∀ d x, Fintype (E d x)]
    (target : ∀ d x, E d x → X)
    (a : PhysicalResidues P → ∀ d x, E d x → ℂ) (k : X → ℤ)
    (F : PhysicalSharedLists P J → X → PhysicalResidues P → ℂ)
    (d : PhysicalSharedLists P J) (x : X) (r : PhysicalResidues P) : ℂ :=
  ∑ e : E d x, a r d x e *
    F d (target d x e) (physicalTranslateResidues r (k x * (physicalSharedProduct d : ℕ)))

theorem physical_small_big_action_invalid {S X : Type*} [Fintype S]
    {P : S → Finset ℕ} {J ell : ℕ}
    (V : S → ℝ) (q ζ : ℝ)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (κ : PhysicalSharedLists P J → ℂ)
    (E : PhysicalSharedLists P J → X → Type*) [∀ d x, Fintype (E d x)]
    (target : ∀ d x, E d x → X)
    (a : PhysicalResidues P → ∀ d x, E d x → ℂ) (k : X → ℤ)
    (F : PhysicalSmallBigState P J ell X → ℂ) (s : PhysicalSmallBigState P J ell X)
    (h : ¬physicalResidueMarksValid s.1.1 s.1.2) :
    physicalSmallBigAction V q ζ aux κ E target a k F s = 0 := by
  simp only [physicalSmallBigAction, physicalSmallBigEventWeight,
    physicalResidueVertexWeight, if_neg h, zero_mul, Complex.ofReal_zero,
    mul_zero, sum_const_zero]

theorem physical_small_big_pairing
    {S X : Type*} [Fintype S] [dS : DecidableEq S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (hV : ∀ s, 0 < V s) (q ζ : ℝ) (W : X → ℝ)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (κ : PhysicalSharedLists P J → ℂ)
    (E : PhysicalSharedLists P J → X → Type*) [∀ d x, Fintype (E d x)]
    (target : ∀ d x, E d x → X)
    (a : PhysicalResidues P → ∀ d x, E d x → ℂ) (k : X → ℤ)
    (u F : PhysicalSmallBigState P J ell X → ℂ) :
    (∑ s, (physicalSmallBigMeasure V W s : ℂ) * (starRingEnd ℂ) (u s) *
      physicalSmallBigAction V q ζ aux κ E target a k F s) =
      ∑ d, ∑ r, ∑ x, (W x : ℂ) *
        (starRingEnd ℂ) (physicalSmallBigCondition V q u d x r) *
        (κ d * physicalPhase ζ (physicalSharedProduct d) *
          physicalSmallBigPrefixAction E target a k (physicalSmallBigCondition V q F) d x r) := by
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  rw [Fintype.sum_prod_type, sum_comm]
  have hx : (∑ x, ∑ s : PhysicalBareResidueState P J ell,
      (physicalSmallBigMeasure V W (s, x) : ℂ) * (starRingEnd ℂ) (u (s, x)) *
        physicalSmallBigAction V q ζ aux κ E target a k F (s, x)) =
      ∑ x, ∑ r, ∑ d, (W x : ℂ) *
        (starRingEnd ℂ) (physicalSmallBigCondition V q u d x r) *
        (κ d * physicalPhase ζ (physicalSharedProduct d) *
          physicalSmallBigPrefixAction E target a k (physicalSmallBigCondition V q F) d x r) := by
    apply sum_congr rfl
    intro x _
    rw [Fintype.sum_prod_type]
    apply sum_congr rfl
    intro r _
    have h := physical_small_big_action_bilinear V hV q ζ aux κ E target a k
      (fun L => u ((r, L), x)) F r x
    change _ = _ at h
    have hleft : (∑ L, (physicalSmallBigMeasure V W ((r, L), x) : ℂ) *
        (starRingEnd ℂ) (u ((r, L), x)) *
        physicalSmallBigAction V q ζ aux κ E target a k F ((r, L), x)) =
        (W x : ℂ) * ∑ L, (physicalStateMass V J ell : ℂ) *
          (starRingEnd ℂ) (u ((r, L), x)) *
          physicalSmallBigAction V q ζ aux κ E target a k F ((r, L), x) := by
      rw [mul_sum]
      apply sum_congr rfl
      intro L _
      by_cases hv : physicalResidueMarksValid r L
      · simp only [physicalSmallBigMeasure, if_pos hv, Complex.ofReal_mul]
        ring
      · rw [physical_small_big_action_invalid V q ζ aux κ E target a k F ((r, L), x) hv]
        simp only [mul_zero]
    rw [hleft]
    erw [h]
    simp only [mul_sum, physicalSmallBigCondition, physicalSmallBigPrefixAction]
    apply sum_congr rfl
    intro d _
    ring_nf
  erw [hx]
  calc
    (∑ x, ∑ r, ∑ d, (W x : ℂ) *
      (starRingEnd ℂ) (physicalSmallBigCondition V q u d x r) *
      (κ d * physicalPhase ζ (physicalSharedProduct d) *
        physicalSmallBigPrefixAction E target a k (physicalSmallBigCondition V q F) d x r)) =
      ∑ x, ∑ d, ∑ r, (W x : ℂ) *
      (starRingEnd ℂ) (physicalSmallBigCondition V q u d x r) *
      (κ d * physicalPhase ζ (physicalSharedProduct d) *
        physicalSmallBigPrefixAction E target a k (physicalSmallBigCondition V q F) d x r) := by
      apply sum_congr rfl
      intro x _
      exact sum_comm
    _ = _ := by
      rw [sum_comm]
      apply sum_congr rfl
      intro d _
      exact sum_comm

end Bounty
end

section

/- Small-slot permutations preserve the actual mixed measure: the big
state and small residues stay fixed, and only the injective small mark list
is reordered. This is the isometry used before omission averaging. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_residue_marks_valid_permute {S : Type*}
    {P : S → Finset ℕ} {J ell : ℕ} (σ : PhysicalPermutations S J ell)
    (r : PhysicalResidues P) (L : PhysicalMarkLists P J ell) :
    physicalResidueMarksValid r (physicalPermuteLabels σ L) ↔ physicalResidueMarksValid r L := by
  constructor
  · intro h g s
    obtain ⟨t, rfl⟩ := (σ g).surjective s
    exact h g t
  · intro h g s
    exact h g (σ g s)

def physicalSmallBigPermutation {S X : Type*} {P : S → Finset ℕ} {J ell : ℕ}
    (σ : PhysicalPermutations S J ell) :
    PhysicalSmallBigState P J ell X ≃ PhysicalSmallBigState P J ell X where
  toFun s := ((s.1.1, physicalPermuteLabels σ s.1.2), s.2)
  invFun s := ((s.1.1, physicalPermuteLabels (fun g => (σ g).symm) s.1.2), s.2)
  left_inv s := by
    apply Prod.ext
    · apply Prod.ext
      · rfl
      · funext g
        apply Function.Embedding.ext
        intro i
        change s.1.2 g (σ g ((σ g).symm i)) = s.1.2 g i
        rw [Equiv.apply_symm_apply]
    · rfl
  right_inv s := by
    apply Prod.ext
    · apply Prod.ext
      · rfl
      · funext g
        apply Function.Embedding.ext
        intro i
        change s.1.2 g ((σ g).symm (σ g i)) = s.1.2 g i
        rw [Equiv.symm_apply_apply]
    · rfl

theorem physical_small_vertex_permutation {S : Type*} [Fintype S]
    {P : S → Finset ℕ} {J ell : ℕ} (σ : PhysicalPermutations S J ell)
    (r : PhysicalResidues P) (L : PhysicalMarkLists P J ell) (q : ℝ) :
    physicalResidueVertexWeight (physicalPermuteLabels σ L) q r =
      physicalResidueVertexWeight L q r := by
  simp only [physicalResidueVertexWeight, physical_residue_marks_valid_permute]

theorem physical_small_big_permutation_measure {S X : Type*} [Fintype S]
    {P : S → Finset ℕ} {J ell : ℕ} (V : S → ℝ) (W : X → ℝ)
    (σ : PhysicalPermutations S J ell) (s : PhysicalSmallBigState P J ell X) :
    physicalSmallBigMeasure V W (physicalSmallBigPermutation σ s) =
      physicalSmallBigMeasure V W s := by
  change (if physicalResidueMarksValid s.1.1 (physicalPermuteLabels σ s.1.2)
    then physicalStateMass V J ell * W s.2 else 0) = _
  rw [physical_residue_marks_valid_permute]
  rfl

theorem physical_small_big_permutation_energy {S X : Type*} [Fintype S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (W : X → ℝ) (σ : PhysicalPermutations S J ell)
    (f : PhysicalSmallBigState P J ell X → ℂ) :
    physicalSmallBigEnergy V W (fun s => f (physicalSmallBigPermutation σ s)) =
      physicalSmallBigEnergy V W f := by
  rw [← physical_small_big_energy_eq, ← physical_small_big_energy_eq]
  have h := (physicalSmallBigPermutation (P := P) (X := X) σ).sum_comp
    (fun s => physicalSmallBigMeasure V W s * ‖f s‖ ^ 2)
  simpa only [finiteWeightedEnergy, physical_small_big_permutation_measure] using h

end Bounty
end

section

/- Uniform prime-weighted Buchstab kernels and finite-depth induction geometry. -/

namespace Bounty

open Finset Filter Real MeasureTheory
open scoped Topology

noncomputable def buchstabDepthExtendedKernel (n : ℕ) (w α : ℝ) : ℝ :=
  buchstabDepthDensity n α (max (w/2) (w-α))

theorem buchstab_depth_extended_kernel_continuous (n : ℕ) :
    ContinuousOn (fun p : ℝ × ℝ => buchstabDepthExtendedKernel n p.1 p.2)
      {p | 0 < p.1 ∧ 0 < p.2} := by
  apply (buchstab_depth_density_continuous n).comp
    (show ContinuousOn (fun p : ℝ × ℝ => (p.2, max (p.1/2) (p.1-p.2)))
      {p | 0 < p.1 ∧ 0 < p.2} by fun_prop)
  intro p hp
  exact ⟨hp.2, (half_pos hp.1).trans_le (le_max_left _ _)⟩

theorem buchstab_depth_extended_kernel_eq (n : ℕ) {w α : ℝ} (hα : α ≤ w/2) :
    buchstabDepthExtendedKernel n w α = buchstabDepthDensity n α (w-α) := by
  unfold buchstabDepthExtendedKernel
  rw [max_eq_right (by linarith)]

theorem buchstab_depth_extended_integral (n : ℕ) (γ w : ℝ) :
    (∫ α in γ..max γ (w/2), buchstabDepthExtendedKernel n w α/α) =
      buchstabDepthDensity (n+1) γ w-1/w := by
  rw [buchstabDepthDensity, add_sub_cancel_left]
  by_cases hhalf : w/2 ≤ γ
  · simp only [max_eq_left hhalf, intervalIntegral.integral_same]
  · have hhalf' : γ ≤ w/2 := (lt_of_not_ge hhalf).le
    rw [max_eq_right hhalf']
    apply intervalIntegral.integral_congr
    intro α hα
    have hα' : α ≤ w/2 := (show α ∈ Set.Icc γ (w/2) by
      simpa only [Set.uIcc_of_le hhalf'] using hα).2
    change buchstabDepthExtendedKernel n w α/α = buchstabDepthDensity n α (w-α)/α
    rw [buchstab_depth_extended_kernel_eq n hα']

theorem buchstab_depth_prime_kernel_uniform_error (n : ℕ)
    {a b γ₀ : ℝ} (ha : 0 < a) (hγ₀ : 0 < γ₀) (hγb : γ₀ < b)
    {ε : ℝ} (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ w γ : ℝ, a ≤ w → w ≤ b → γ₀ ≤ γ → γ ≤ w →
      |(∑ p ∈ primeBand (exp (γ*L)) (exp (max γ (w/2)*L)),
        buchstabDepthExtendedKernel n w (log (p : ℝ)/L)/(p : ℝ)) -
        (buchstabDepthDensity (n+1) γ w-1/w)| < ε := by
  have hc : ContinuousOn (fun p : ℝ × ℝ => buchstabDepthExtendedKernel n p.1 p.2)
      ((Set.Icc a b) ×ˢ (Set.Icc γ₀ b)) := by
    apply (buchstab_depth_extended_kernel_continuous n).mono
    intro p hp
    exact ⟨ha.trans_le hp.1.1, hγ₀.trans_le hp.2.1⟩
  filter_upwards [exponential_prime_weighted_reciprocal_uniform_error hγ₀ hγb
    (fun p : ℝ × ℝ => buchstabDepthExtendedKernel n p.1 p.2) hc hε] with L hL
  intro w γ haw hwb hγ hγw
  have hmax : max γ (w/2) ≤ b := max_le (hγw.trans hwb) (by linarith)
  have hh := hL w ⟨haw,hwb⟩ γ (max γ (w/2)) hγ (le_max_left _ _) hmax
  rw [buchstab_depth_extended_integral] at hh
  exact hh

theorem buchstab_good_cofactor_domain (n : ℕ)
    {a b γ₀ γ w α η δ : ℝ}
    (hη : 0 ≤ η) (haw : a ≤ w) (hwb : w ≤ b) (hγ₀ : γ₀ ≤ γ)
    (hγα : γ ≤ α) (hα : α ≤ w/2-η)
    (htop : w+δ ≤ ((n : ℝ)+3)*γ) :
    a/2 ≤ w-α ∧ w-α ≤ b-γ₀ ∧ γ₀ ≤ α ∧
      2*η ≤ (w-α)-α ∧ w-α+δ ≤ ((n : ℝ)+2)*α := by
  have hn : 0 ≤ (n : ℝ)+3 := by positivity
  have hm := mul_le_mul_of_nonneg_left hγα hn
  constructor
  · linarith
  constructor
  · linarith
  constructor
  · exact hγ₀.trans hγα
  constructor <;> linarith

theorem exponential_prime_band_short_interval_bound
    {a η ε : ℝ} (ha : 0 < a) (hη : 0 ≤ η) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ u v : ℝ, a ≤ u → u ≤ v → v-u ≤ η →
      primeBandHarmonic (exp (u*L)) (exp (v*L)) ≤ η/a+ε := by
  filter_upwards [exponential_prime_band_harmonic_uniform_error ha hε] with L hL
  intro u v hau huv hwidth
  have hu := ha.trans_le hau
  have hv := hu.trans_le huv
  have hlog : log (v/u) ≤ (v-u)/u := by
    have h := log_le_sub_one_of_pos (div_pos hv hu)
    convert h using 1; field_simp
  have hr : (v-u)/u ≤ η/a := by
    exact (div_le_div_of_nonneg_right hwidth hu.le).trans
      (div_le_div_of_nonneg_left hη ha hau)
  have he := (abs_lt.mp (hL u v hau huv)).2
  linarith

theorem exponential_prime_log_coordinate {L p : ℝ} (hL : L ≠ 0) (hp : 0 < p) :
    exp ((log p/L)*L) = p := by rw [div_mul_cancel₀ _ hL, exp_log hp]

theorem exponential_cofactor_log_coordinate (w : ℝ) {L p : ℝ}
    (hL : L ≠ 0) (hp : 0 < p) :
    exp (w*L)/p = exp ((w-log p/L)*L) := by
  rw [sub_mul, exp_sub, exponential_prime_log_coordinate hL hp]

end Bounty

/- Public declaration closure audit. -/
end

section

/- Finite upper meshes for the continuous Buchstab density, with logarithmic bin weights. -/

open Finset Filter MeasureTheory
open scoped Topology

namespace Bounty

theorem reciprocal_grid_strict_step {a b : ℝ} (hab : a < b) {N : ℕ} (hN : 0 < N) (i : ℕ) :
    reciprocalGrid a b N (i : ℕ) < reciprocalGrid a b N ((i : ℕ) + 1) := by
  have hstep := reciprocal_grid_step a b N (i : ℕ)
  have hp : 0 < (b - a) / (N : ℝ) := div_pos (sub_pos.mpr hab) (Nat.cast_pos.mpr hN)
  linarith

theorem reciprocal_grid_log_weight_sum {a b : ℝ} (ha : 0 < a) (hab : a ≤ b)
    {N : ℕ} (hN : 0 < N) :
    (∑ i ∈ range N, Real.log (reciprocalGrid a b N ((i : ℕ) + 1) / reciprocalGrid a b N (i : ℕ))) =
      Real.log (b / a) := by
  have hlog : ∀ i ∈ range N,
      Real.log (reciprocalGrid a b N ((i : ℕ) + 1) / reciprocalGrid a b N (i : ℕ)) =
        Real.log (reciprocalGrid a b N ((i : ℕ) + 1)) - Real.log (reciprocalGrid a b N (i : ℕ)) := by
    intro i hi
    have hleft := ha.trans_le (reciprocal_grid_mem hab hN (mem_range.mp hi).le).1
    have hright := ha.trans_le (reciprocal_grid_mem hab hN (Nat.succ_le_of_lt (mem_range.mp hi))).1
    exact Real.log_div hright.ne' hleft.ne'
  rw [sum_congr rfl hlog, sum_range_adjacent_real_difference (fun i => Real.log (reciprocalGrid a b N (i : ℕ))) N,
    reciprocal_grid_zero, reciprocal_grid_end a b hN,
    Real.log_div (ha.trans_le hab).ne' ha.ne']

theorem exists_square_reciprocal_grid_oscillation {a b : ℝ} (hab : a < b)
    (F : ℝ × ℝ → ℝ) (hF : ContinuousOn F (Set.Icc a b ×ˢ Set.Icc a b))
    {η : ℝ} (hη : 0 < η) :
    ∃ N : ℕ, 0 < N ∧ ∀ i : ℕ, i < N →
      ∀ x ∈ Set.Icc (reciprocalGrid a b N (i : ℕ)) (reciprocalGrid a b N ((i : ℕ) + 1)),
        |F (reciprocalGrid a b N (i : ℕ), x) - F (reciprocalGrid a b N (i : ℕ), reciprocalGrid a b N (i : ℕ))| ≤ η ∧
        |F (x, x) - F (reciprocalGrid a b N (i : ℕ), reciprocalGrid a b N (i : ℕ))| ≤ η := by
  have hu := (isCompact_Icc.prod isCompact_Icc).uniformContinuousOn_of_continuous hF
  obtain ⟨δ, hδ, hclose⟩ := Metric.uniformContinuousOn_iff_le.mp hu η hη
  obtain ⟨N, hN⟩ := exists_nat_gt ((b - a) / δ)
  have hN0 : 0 < N := by
    have hh : (0 : ℝ) < N := (div_pos (sub_pos.mpr hab) hδ).trans hN
    exact_mod_cast hh
  have hstep : (b - a) / (N : ℝ) ≤ δ := by
    apply (div_le_iff₀ (Nat.cast_pos.mpr hN0)).mpr
    have hh := (div_lt_iff₀ hδ).mp hN
    nlinarith
  refine ⟨N, hN0, ?_⟩
  intro i hi x hx
  have hleft := reciprocal_grid_mem hab.le hN0 hi.le
  have hright := reciprocal_grid_mem hab.le hN0 (Nat.succ_le_of_lt hi)
  have hxmem : x ∈ Set.Icc a b := ⟨hleft.1.trans hx.1, hx.2.trans hright.2⟩
  have hd : dist x (reciprocalGrid a b N (i : ℕ)) ≤ δ := by
    rw [Real.dist_eq, abs_of_nonneg (sub_nonneg.mpr hx.1)]
    calc
      _ ≤ reciprocalGrid a b N ((i : ℕ) + 1) - reciprocalGrid a b N (i : ℕ) := sub_le_sub_right hx.2 _
      _ = (b - a) / (N : ℝ) := reciprocal_grid_step a b N (i : ℕ)
      _ ≤ δ := hstep
  constructor
  · have hh := hclose (reciprocalGrid a b N (i : ℕ), x) ⟨hleft, hxmem⟩
      (reciprocalGrid a b N (i : ℕ), reciprocalGrid a b N (i : ℕ)) ⟨hleft, hleft⟩
      (by simpa only [Prod.dist_eq, dist_self, max_eq_right (dist_nonneg)] using hd)
    simpa only [Real.dist_eq] using hh
  · have hh := hclose (x, x) ⟨hxmem, hxmem⟩
      (reciprocalGrid a b N (i : ℕ), reciprocalGrid a b N (i : ℕ)) ⟨hleft, hleft⟩
      (by simpa only [Prod.dist_eq, max_self] using hd)
    simpa only [Real.dist_eq] using hh

theorem buchstab_bin_density_continuous {b q : ℝ} (hb : 0 < b) (hq : q ≤ 1 / 2) :
    ContinuousOn (fun p : ℝ × ℝ => buchstabDensity p.1 (1 - p.2))
      (Set.Icc b q ×ˢ Set.Icc b q) := by
  apply buchstab_density_continuous.comp
    (show ContinuousOn (fun p : ℝ × ℝ => (p.1, 1 - p.2))
      (Set.Icc b q ×ˢ Set.Icc b q) by fun_prop)
  intro p hp
  exact ⟨hb.trans_le hp.1.1, by linarith [hp.2.2]⟩

theorem reciprocal_grid_added_sample_bound (f : ℝ → ℝ) {b q η : ℝ}
    (hb : 0 < b) (hbq : b ≤ q) (hη : 0 ≤ η) (hf : ContinuousOn f (Set.Icc b q))
    {N : ℕ} (hN : 0 < N)
    (hosc : ∀ i : ℕ, i < N → ∀ α ∈ Set.Icc (reciprocalGrid b q N i) (reciprocalGrid b q N (i + 1)),
      |f α - f (reciprocalGrid b q N i)| ≤ η) :
    (∑ i ∈ range N, (f (reciprocalGrid b q N i) + η) *
      Real.log (reciprocalGrid b q N (i + 1) / reciprocalGrid b q N i)) ≤
        (∫ α in b..q, f α / α) + (η / b) * (q - b) + η * Real.log (q / b) := by
  have happ := reciprocal_grid_integral_approximation f hb hbq hη hf hN hosc
  simp only [add_mul, sum_add_distrib]
  rw [← mul_sum, reciprocal_grid_log_weight_sum hb hbq hN]
  have hh := (abs_le.mp happ).1
  linarith

theorem reciprocal_mesh_error_budget {b q ε : ℝ} (hb : 0 < b) (hbq : b < q) (hε : 0 < ε) :
    let η := ε / ((q - b) / b + |Real.log (q / b)| + 1)
    0 < η ∧ (η / b) * (q - b) + η * Real.log (q / b) ≤ ε := by
  let C := (q - b) / b + |Real.log (q / b)| + 1
  have hC : 0 < C := by dsimp [C]; positivity
  let η := ε / C
  have hη : 0 < η := div_pos hε hC
  refine ⟨hη, ?_⟩
  change (η / b) * (q - b) + η * Real.log (q / b) ≤ ε
  have heq : η * C = ε := by dsimp [η]; field_simp
  calc
    _ ≤ η * C := by
      have hh := mul_le_mul_of_nonneg_left (le_abs_self (Real.log (q / b))) hη.le
      dsimp [C]
      calc
        _ = η * ((q - b) / b) + η * Real.log (q / b) := by ring
        _ ≤ η * ((q - b) / b) + η * |Real.log (q / b)| := add_le_add le_rfl hh
        _ ≤ η * ((q - b) / b + |Real.log (q / b)| + 1) := by nlinarith
    _ = ε := heq


theorem exists_buchstab_upper_mesh {b q ε : ℝ}
    (hb : 0 < b) (hbq : b < q) (hq : q ≤ 1 / 2) (hε : 0 < ε) :
    ∃ N : ℕ, 0 < N ∧ ∃ M : Fin N → ℝ,
      (∀ i : Fin N,
        reciprocalGrid b q N (i : ℕ) < reciprocalGrid b q N ((i : ℕ) + 1) ∧ 0 < M i ∧
        ∀ α ∈ Set.Icc (reciprocalGrid b q N (i : ℕ)) (reciprocalGrid b q N ((i : ℕ) + 1)),
          buchstabDensity (reciprocalGrid b q N (i : ℕ)) (1 - α) ≤ M i) ∧
      (∑ i : Fin N, M i * Real.log (reciprocalGrid b q N ((i : ℕ) + 1) / reciprocalGrid b q N (i : ℕ))) ≤
        (∫ α in b..q, buchstabDensity α (1 - α) / α) + ε := by
  let F : ℝ × ℝ → ℝ := fun p => buchstabDensity p.1 (1 - p.2)
  let f : ℝ → ℝ := fun α => buchstabDensity α (1 - α)
  have hF : ContinuousOn F (Set.Icc b q ×ˢ Set.Icc b q) := buchstab_bin_density_continuous hb hq
  have hf : ContinuousOn f (Set.Icc b q) :=
    hF.comp (f := fun α : ℝ => (α, α))
      (continuousOn_id.prodMk continuousOn_id) (fun α hα => ⟨hα, hα⟩)
  let η : ℝ := ε / ((q - b) / b + |Real.log (q / b)| + 1)
  have hbudget : 0 < η ∧ (η / b) * (q - b) + η * Real.log (q / b) ≤ ε :=
    reciprocal_mesh_error_budget hb hbq hε
  obtain ⟨N, hN, hosc⟩ := exists_square_reciprocal_grid_oscillation hbq F hF hbudget.1
  let M : Fin N → ℝ := fun i => f (reciprocalGrid b q N (i : ℕ)) + η
  refine ⟨N, hN, M, ?_, ?_⟩
  · intro i
    have hi := reciprocal_grid_mem hbq.le hN i.isLt.le
    have hleft0 : 0 < reciprocalGrid b q N (i : ℕ) := hb.trans_le hi.1
    have hlast0 : 0 < 1 - reciprocalGrid b q N (i : ℕ) := by linarith [hi.2]
    refine ⟨reciprocal_grid_strict_step hbq hN (i : ℕ), ?_, ?_⟩
    · change 0 < buchstabDensity (reciprocalGrid b q N (i : ℕ)) (1 - reciprocalGrid b q N (i : ℕ)) + η
      exact add_pos (buchstab_density_pos hleft0 hlast0) hbudget.1
    · intro α hα
      have hh := (abs_le.mp (hosc (i : ℕ) i.isLt α hα).1).2
      change buchstabDensity (reciprocalGrid b q N (i : ℕ)) (1 - α) ≤
        buchstabDensity (reciprocalGrid b q N (i : ℕ)) (1 - reciprocalGrid b q N (i : ℕ)) + η
      change buchstabDensity (reciprocalGrid b q N (i : ℕ)) (1 - α) -
        buchstabDensity (reciprocalGrid b q N (i : ℕ)) (1 - reciprocalGrid b q N (i : ℕ)) ≤ η at hh
      linarith only [hh]
  · have hh := reciprocal_grid_added_sample_bound f hb hbq.le hbudget.1.le hf hN
      (fun i hi α hα => (hosc i hi α hα).2)
    change (∑ i : Fin N, (f (reciprocalGrid b q N (i : ℕ)) + η) *
      Real.log (reciprocalGrid b q N ((i : ℕ) + 1) / reciprocalGrid b q N (i : ℕ))) ≤
      (∫ α in b..q, f α / α) + ε
    rw [Fin.sum_univ_eq_sum_range (fun i : ℕ =>
      (f (reciprocalGrid b q N i) + η) * Real.log (reciprocalGrid b q N (i + 1) / reciprocalGrid b q N i)) N]
    linarith [hbudget.2]

theorem buchstab_partial_kernel_integral_le {b q : ℝ}
    (hb : 0 < b) (hbq : b ≤ q) (hq : q ≤ 1 / 2) :
    (∫ α in b..q, buchstabDensity α (1 - α) / α) ≤ buchstabDensity b 1 - 1 := by
  have hnonneg : ∀ᵐ α ∂volume.restrict (Set.Ioc b (1 / 2 : ℝ)),
      0 ≤ buchstabDensity α (1 - α) / α := by
    apply (ae_restrict_iff' measurableSet_Ioc).mpr
    apply Filter.Eventually.of_forall
    intro α hα
    have hα0 : 0 < α := hb.trans hα.1
    have hlast : 0 < 1 - α := by linarith [hα.2]
    exact div_nonneg (buchstab_density_nonneg hα0 hlast) hα0.le
  have hmono := intervalIntegral.integral_mono_interval (a := b) (b := q)
    (c := b) (d := (1 / 2 : ℝ)) le_rfl hbq hq hnonneg
    (buchstab_density_kernel_intervalIntegrable (w := 1) hb (hbq.trans hq))
  rw [buchstab_density_integral_identity hb (hbq.trans hq)] at hmono
  exact hmono

theorem exists_buchstab_upper_mesh_density_bound {b q ε : ℝ}
    (hb : 0 < b) (hbq : b < q) (hq : q ≤ 1 / 2) (hε : 0 < ε) :
    ∃ N : ℕ, 0 < N ∧ ∃ M : Fin N → ℝ,
      (∀ i : Fin N,
        reciprocalGrid b q N (i : ℕ) < reciprocalGrid b q N ((i : ℕ) + 1) ∧ 0 < M i ∧
        ∀ α ∈ Set.Icc (reciprocalGrid b q N (i : ℕ)) (reciprocalGrid b q N ((i : ℕ) + 1)),
          buchstabDensity (reciprocalGrid b q N (i : ℕ)) (1 - α) ≤ M i) ∧
      (∑ i : Fin N, M i * Real.log (reciprocalGrid b q N ((i : ℕ) + 1) / reciprocalGrid b q N (i : ℕ))) ≤
        buchstabDensity b 1 - 1 + ε := by
  obtain ⟨N, hN, M, hbins, hsum⟩ := exists_buchstab_upper_mesh hb hbq hq hε
  refine ⟨N, hN, M, hbins, ?_⟩
  exact hsum.trans (add_le_add (buchstab_partial_kernel_integral_le hb hbq.le hq) le_rfl)

end Bounty



end

section

/- Norm consequences in the genuine mixed measure. Promotion and
storage estimates combine without replacing the small-state measure. -/

open Finset
open scoped Classical

namespace Bounty

section

variable {S X : Type*} [Fintype S] [Fintype X]
  {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
  (V : S → ℝ) (W : X → ℝ)

theorem physical_small_big_sqrt_energy_eq_norm
    (F : PhysicalSmallBigState P J ell X → ℂ) :
    Real.sqrt (physicalSmallBigEnergy V W F) =
      cleanActiveNorm (physicalSmallBigMeasure V W) F := by
  rw [← physical_small_big_energy_eq]
  rfl

theorem physical_small_big_norm_le_of_energy
    (H K : ℝ) (hH : 0 ≤ H) (hK : 0 ≤ K)
    (F output : PhysicalSmallBigState P J ell X → ℂ)
    (h : physicalSmallBigEnergy V W output ≤ H ^ 2 * K * physicalSmallBigEnergy V W F) :
    cleanActiveNorm (physicalSmallBigMeasure V W) output ≤
      H * Real.sqrt K * cleanActiveNorm (physicalSmallBigMeasure V W) F := by
  have hs := Real.sqrt_le_sqrt h
  rwa [Real.sqrt_mul (mul_nonneg (sq_nonneg H) hK), Real.sqrt_mul (sq_nonneg H),
    Real.sqrt_sq hH, physical_small_big_sqrt_energy_eq_norm,
    physical_small_big_sqrt_energy_eq_norm] at hs

theorem physical_small_big_dirty_energy_of_components
    (hV : ∀ s, 0 < V s) (hW : ∀ x, 0 ≤ W x)
    (F output promotion storage : PhysicalSmallBigState P J ell X → ℂ)
    (δ K : ℝ)
    (hdom : ∀ s, ‖output s‖ ≤ ‖promotion s + storage s‖)
    (hprom : physicalSmallBigEnergy V W promotion ≤ δ * K * physicalSmallBigEnergy V W F)
    (hstore : physicalSmallBigEnergy V W storage ≤ δ * K * physicalSmallBigEnergy V W F) :
    physicalSmallBigEnergy V W output ≤ 4 * δ * K * physicalSmallBigEnergy V W F := by
  have h := (finiteWeightedEnergy_le_of_norm_le (physicalSmallBigMeasure V W)
    (physical_small_big_measure_nonneg V hV W hW) output
    (fun s => promotion s + storage s) hdom).trans
      (finite_weighted_energy_add_le_two (physicalSmallBigMeasure V W)
        (physical_small_big_measure_nonneg V hV W hW) promotion storage)
  simp only [physical_small_big_energy_eq] at h
  nlinarith

theorem physical_small_big_dirty_norm_of_components
    (hV : ∀ s, 0 < V s) (hW : ∀ x, 0 ≤ W x)
    (F output promotion storage : PhysicalSmallBigState P J ell X → ℂ)
    (δ K : ℝ) (hδ : 0 ≤ δ) (hK : 0 ≤ K)
    (hdom : ∀ s, ‖output s‖ ≤ ‖promotion s + storage s‖)
    (hprom : physicalSmallBigEnergy V W promotion ≤ δ * K * physicalSmallBigEnergy V W F)
    (hstore : physicalSmallBigEnergy V W storage ≤ δ * K * physicalSmallBigEnergy V W F) :
    cleanActiveNorm (physicalSmallBigMeasure V W) output ≤
      2 * Real.sqrt δ * Real.sqrt K * cleanActiveNorm (physicalSmallBigMeasure V W) F := by
  apply physical_small_big_norm_le_of_energy V W (2 * Real.sqrt δ) K
    (mul_nonneg (by norm_num) (Real.sqrt_nonneg δ)) hK F output
  have h := physical_small_big_dirty_energy_of_components V W hV hW
    F output promotion storage δ K hdom hprom hstore
  simpa only [mul_pow, Real.sq_sqrt hδ, show (2 : ℝ) ^ 2 = 4 by norm_num] using h

theorem physical_small_big_clean_rare_norm_le
    (hV : ∀ s, 0 < V s) (hW : ∀ x, 0 ≤ W x)
    (F output clean dirty : PhysicalSmallBigState P J ell X → ℂ)
    (hdecomp : output = clean + dirty) (εclean εdirty : ℝ)
    (hc : cleanActiveNorm (physicalSmallBigMeasure V W) clean ≤
      εclean * cleanActiveNorm (physicalSmallBigMeasure V W) F)
    (hd : cleanActiveNorm (physicalSmallBigMeasure V W) dirty ≤
      εdirty * cleanActiveNorm (physicalSmallBigMeasure V W) F) :
    cleanActiveNorm (physicalSmallBigMeasure V W) output ≤
      (εclean + εdirty) * cleanActiveNorm (physicalSmallBigMeasure V W) F := by
  rw [hdecomp]
  exact (clean_active_norm_add_le (physicalSmallBigMeasure V W)
    (physical_small_big_measure_nonneg V hV W hW) clean dirty).trans
      ((add_le_add hc hd).trans_eq (by ring))

end

end Bounty
end

section

/- Averaging fixed auxiliary draws on the genuine mixed measure. The
auxiliary law is a subprobability independent of the state being integrated. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_small_big_subprobability_energy_le
    {S X Q : Type*} [Fintype S] [Fintype X] [Fintype Q]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (hV : ∀ s, 0 < V s) (W : X → ℝ) (hW : ∀ x, 0 ≤ W x)
    (π : Q → ℝ) (hπ : ∀ a, 0 ≤ π a) (hmass : ∑ a, π a ≤ 1)
    (output : Q → PhysicalSmallBigState P J ell X → ℂ) :
    physicalSmallBigEnergy V W (fun s => ∑ a, (π a : ℂ) * output a s) ≤
      ∑ a, π a * physicalSmallBigEnergy V W (output a) := by
  simpa only [physical_small_big_energy_eq] using
    finite_subprobability_average_energy_le π (physicalSmallBigMeasure V W)
      hπ hmass (physical_small_big_measure_nonneg V hV W hW) output

theorem physical_small_big_auxiliary_energy_bound
    {S X Q : Type*} [Fintype S] [Fintype X] [Fintype Q]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (hV : ∀ s, 0 < V s) (W : X → ℝ) (hW : ∀ x, 0 ≤ W x)
    (π : Q → ℝ) (hπ : ∀ a, 0 ≤ π a) (hmass : ∑ a, π a ≤ 1)
    (output : Q → PhysicalSmallBigState P J ell X → ℂ)
    (F : PhysicalSmallBigState P J ell X → ℂ) (K : ℝ) (hK : 0 ≤ K)
    (hbound : ∀ a, physicalSmallBigEnergy V W (output a) ≤ K * physicalSmallBigEnergy V W F) :
    physicalSmallBigEnergy V W (fun s => ∑ a, (π a : ℂ) * output a s) ≤
      K * physicalSmallBigEnergy V W F := by
  have hEF : 0 ≤ physicalSmallBigEnergy V W F := by
    rw [← physical_small_big_energy_eq]
    exact sum_nonneg fun s _ => mul_nonneg
      (physical_small_big_measure_nonneg V hV W hW s) (sq_nonneg ‖F s‖)
  calc
    _ ≤ ∑ a, π a * physicalSmallBigEnergy V W (output a) :=
      physical_small_big_subprobability_energy_le V hV W hW π hπ hmass output
    _ ≤ ∑ a, π a * (K * physicalSmallBigEnergy V W F) :=
      sum_le_sum fun a _ => mul_le_mul_of_nonneg_left (hbound a) (hπ a)
    _ = (∑ a, π a) * (K * physicalSmallBigEnergy V W F) := (sum_mul ..).symm
    _ ≤ 1 * (K * physicalSmallBigEnergy V W F) :=
      mul_le_mul_of_nonneg_right hmass (mul_nonneg hK hEF)
    _ = _ := one_mul _

end Bounty
end

section

/- Fixed cross moments retain absolute logarithmic exponents. -/

open Finset

namespace Bounty

theorem divisor_square_cross_moment {α : Type*} [DecidableEq α]
    (S : Finset α) (f g : α → ℕ) (M N : ℕ)
    (hf : Set.InjOn f S) (hg : Set.InjOn g S)
    (hM : ∀ x ∈ S, f x ≤ M) (hN : ∀ x ∈ S, g x ≤ N) :
    (∑ x ∈ S, ((f x).divisors.card : ℝ) ^ 2 * ((g x).divisors.card : ℝ) ^ 2) ≤
      Real.sqrt ((M : ℝ) * (1 + Real.log M) ^ 15) *
        Real.sqrt ((N : ℝ) * (1 + Real.log N) ^ 15) := by
  have h := Real.sum_mul_le_sqrt_mul_sqrt S
    (fun x => ((f x).divisors.card : ℝ) ^ 2) (fun x => ((g x).divisors.card : ℝ) ^ 2)
  simp only [← pow_mul, show 2 * 2 = 4 by omega] at h
  apply h.trans
  apply mul_le_mul
  · exact Real.sqrt_le_sqrt (divisor_fourth_moment_injective S f M hf hM)
  · exact Real.sqrt_le_sqrt (divisor_fourth_moment_injective S g N hg hN)
  · positivity
  · positivity

theorem nonnegative_one_three_le_fourths {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) :
    a * b ^ 3 ≤ a ^ 4 + b ^ 4 := by
  rcases le_total a b with hab | hba
  · calc
      _ ≤ b * b ^ 3 := mul_le_mul_of_nonneg_right hab (pow_nonneg hb _)
      _ = b ^ 4 := by ring
      _ ≤ _ := le_add_of_nonneg_left (pow_nonneg ha _)
  · calc
      _ ≤ a * a ^ 3 := mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hb hba _) ha
      _ = a ^ 4 := by ring
      _ ≤ _ := le_add_of_nonneg_right (pow_nonneg hb _)

theorem divisor_adjacent_cross_moment (N : ℕ) :
    (∑ n ∈ Icc 1 N, (n.divisors.card : ℝ) * ((n - 1).divisors.card : ℝ) ^ 3) ≤
      2 * (N : ℝ) * (1 + Real.log N) ^ 15 := by
  have hshift := divisor_fourth_moment_injective (Icc 1 N) (fun n => n - 1) N
    (by
      intro a ha b hb hab
      simp only [mem_coe, mem_Icc] at ha hb
      change a - 1 = b - 1 at hab
      omega)
    (by intro n hn; exact (Nat.sub_le n 1).trans (mem_Icc.mp hn).2)
  calc
    _ ≤ ∑ n ∈ Icc 1 N, ((n.divisors.card : ℝ) ^ 4 +
        ((n - 1).divisors.card : ℝ) ^ 4) := by
      apply sum_le_sum
      intro n _
      exact nonnegative_one_three_le_fourths (by positivity) (by positivity)
    _ = (∑ n ∈ Icc 1 N, (n.divisors.card : ℝ) ^ 4) +
        ∑ n ∈ Icc 1 N, ((n - 1).divisors.card : ℝ) ^ 4 := sum_add_distrib
    _ ≤ (N : ℝ) * (1 + Real.log N) ^ 15 + (N : ℝ) * (1 + Real.log N) ^ 15 :=
      add_le_add (divisor_fourth_moment N) hshift
    _ = _ := by ring

end Bounty
end

section

/- Full shifted-product pair domains, with no primality or roughness restriction. -/

open Finset
namespace Bounty

noncomputable def shiftedFactorPairs (T : Finset ℕ) : Finset (ℕ × ℕ) := by
  classical
  exact T.biUnion (fun u => (2*u+1).divisors.image (fun d => (d,(2*u+1)/d)))

theorem mem_shifted_factor_pairs_iff (T : Finset ℕ) (v : ℕ × ℕ) :
    v ∈ shiftedFactorPairs T ↔ ∃ u ∈ T, v.1*v.2=2*u+1 := by
  classical
  constructor
  · intro hv
    obtain ⟨u,hu,hv'⟩ := mem_biUnion.mp hv
    obtain ⟨d,hd,rfl⟩ := mem_image.mp hv'
    refine ⟨u,hu,?_⟩
    exact Nat.mul_div_cancel' (Nat.mem_divisors.mp hd).1
  · rintro ⟨u,hu,hprod⟩
    apply mem_biUnion.mpr
    refine ⟨u,hu,mem_image.mpr ⟨v.1,?_,?_⟩⟩
    · exact Nat.mem_divisors.mpr ⟨hprod ▸ dvd_mul_right v.1 v.2,by omega⟩
    · have hp : 0 < v.1 := by nlinarith only [hprod]
      apply Prod.ext
      · rfl
      · change (2*u+1)/v.1=v.2
        rw [← hprod, Nat.mul_div_right _ hp]

theorem shifted_factor_pair_properties (T : Finset ℕ) {v : ℕ × ℕ}
    (hv : v ∈ shiftedFactorPairs T) :
    0 < v.1 ∧ 0 < v.2 ∧ shiftedPairIndex v ∈ T ∧
      v.1*v.2=2*shiftedPairIndex v+1 := by
  obtain ⟨u,hu,hprod⟩ := (mem_shifted_factor_pairs_iff T v).mp hv
  have hindex : shiftedPairIndex v=u := by unfold shiftedPairIndex; rw [hprod]; omega
  rw [hindex]
  exact ⟨by nlinarith only [hprod],by nlinarith only [hprod],hu,hprod⟩

theorem shifted_buchstab_pairs_subset_factor_pairs (T : Finset ℕ) (z : ℝ)
    (hT : ∀ u ∈ T, 0 < u) : shiftedBuchstabPairs T z ⊆ shiftedFactorPairs T := by
  intro v hv
  have h := shifted_buchstab_pair_properties T z hT hv
  exact (mem_shifted_factor_pairs_iff T v).mpr ⟨shiftedPairIndex v,h.2.2.1,h.2.2.2.1⟩

end Bounty
end

section

/- Actual masked complex path sums are dominated by their genuine positive path integrals. -/

open Finset Classical

namespace Bounty

section Norm
variable {K X : Type*} (E : K → X → Type*) [∀ k x, Fintype (E k x)]
    (target : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (steps : List K) (Q : ∀ x, FiniteEventPath E target steps x → Prop)
    (phase : ∀ x, FiniteEventPath E target steps x → ℂ)
    (hphase : ∀ x p, ‖phase x p‖ ≤ 1) (f : X → ℂ) (x : X)

include hphase

theorem finite_event_masked_path_norm_le_abs_integral :
    ‖finiteEventPathAction E target w steps
      (fun x p => if Q x p then phase x p else 0) f x‖ ≤
      finiteEventPathIntegral E target (fun k x e => |w k x e|) steps x
        (fun p => if Q x p then ‖f (finiteEventPathTerminal E target steps x p)‖ else 0) := by
  let _ := finiteEventPathFintype E target steps x
  unfold finiteEventPathAction finiteEventPathIntegral
  refine (norm_sum_le _ _).trans (sum_le_sum fun p _ => ?_)
  by_cases hp : Q x p
  · simp only [if_pos hp, norm_mul, Complex.norm_real, Real.norm_eq_abs]
    have h := mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_left (hphase x p) (abs_nonneg (finiteEventPathWeight E target w steps x p)))
      (norm_nonneg (f (finiteEventPathTerminal E target steps x p)))
    simpa only [mul_one, finite_event_path_weight_abs] using h
  · simp only [if_neg hp, mul_zero, zero_mul, norm_zero, le_refl]

theorem finite_event_masked_path_norm_le_mass (L : ℝ) (hf : ∀ y, ‖f y‖ ≤ L) :
    ‖finiteEventPathAction E target w steps
      (fun x p => if Q x p then phase x p else 0) f x‖ ≤
      L * finiteEventPathIntegral E target (fun k x e => |w k x e|) steps x
        (fun p => if Q x p then 1 else 0) := by
  refine (finite_event_masked_path_norm_le_abs_integral E target w steps Q phase hphase f x).trans ?_
  calc
    _ ≤ finiteEventPathIntegral E target (fun k x e => |w k x e|) steps x
        (fun p => L * (if Q x p then 1 else 0)) := by
      apply finite_event_path_integral_mono _ _ _ (fun _ _ _ => abs_nonneg _)
      intro p
      split_ifs
      · simpa only [mul_one] using hf (finiteEventPathTerminal E target steps x p)
      · simp only [mul_zero, le_refl]
    _ = _ := finite_event_path_integral_const_mul _ _ _ _ _ _ _

end Norm
end Bounty
end

section

/- The fourth divisor moment controls an invariant endpoint on every divisibility fibre. -/

open Finset

namespace Bounty

theorem natural_log_mono {a b : ℕ} (hab : a ≤ b) : Real.log a ≤ Real.log b := by
  by_cases ha : a = 0
  · simpa [ha] using Real.log_natCast_nonneg b
  · exact Real.log_le_log (by exact_mod_cast Nat.pos_of_ne_zero ha) (by exact_mod_cast hab)

theorem divisor_fourth_moment_quotient (S : Finset ℕ) (d N : ℕ)
    (hdiv : ∀ n ∈ S, d ∣ n) (hN : ∀ n ∈ S, n ≤ N) :
    (∑ n ∈ S, ((n / d).divisors.card : ℝ) ^ 4) ≤
      ((N : ℝ) / d) * (1 + Real.log N) ^ 15 := by
  by_cases hd : d = 0
  · simp [hd]
  have hmoment := divisor_fourth_moment_injective S (fun n => n / d) (N / d)
    (by
      intro a ha b hb hab
      have hae := Nat.mul_div_cancel' (hdiv a ha)
      have hbe := Nat.mul_div_cancel' (hdiv b hb)
      dsimp at hab
      rw [hab, hbe] at hae
      exact hae.symm)
    (by intro n hn; exact Nat.div_le_div_right (hN n hn))
  apply hmoment.trans
  apply mul_le_mul
  · exact Nat.cast_div_le
  · exact pow_le_pow_left₀ (by positivity) (by
      linarith [natural_log_mono (Nat.div_le_self N d)]) 15
  · positivity
  · positivity

theorem prime_pool_free_part_divisors_le (P : Finset ℕ) (n : ℕ) :
    (primePoolFreePart P n).divisors.card ≤ n.divisors.card := by
  by_cases hn : n = 0
  · simp [hn, primePoolFreePart]
  · apply card_le_card
    exact Nat.divisors_subset_of_dvd hn
      (Nat.div_dvd_of_dvd (primePoolPart_dvd P n))

theorem invariant_triple_endpoint_norm_divisors (P : Finset ℕ) (α β γ : ℕ → ℂ)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (n : ℕ) :
    ‖invariantTripleEndpoint P α β γ n‖ ≤
      A * B * C * (n.divisors.card : ℝ) ^ 2 := by
  apply (invariant_triple_endpoint_norm_le P α β γ hA hB hC hα hβ hγ n).trans
  apply mul_le_mul_of_nonneg_left _ (by positivity)
  exact pow_le_pow_left₀ (by positivity) (by exact_mod_cast prime_pool_free_part_divisors_le P n) 2

theorem invariant_triple_endpoint_divisible_energy (P : Finset ℕ) (α β γ : ℕ → ℂ)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (S : Finset ℕ) (d N : ℕ) (hd : d ∈ Nat.factoredNumbers P)
    (hdiv : ∀ n ∈ S, d ∣ n) (hN : ∀ n ∈ S, n ≤ N) :
    (∑ n ∈ S, ‖invariantTripleEndpoint P α β γ n‖ ^ 2) ≤
      (A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15 / d := by
  have hnorm (n : ℕ) (hn : n ∈ S) :
      ‖invariantTripleEndpoint P α β γ n‖ ^ 2 ≤
        (A * B * C) ^ 2 * ((n / d).divisors.card : ℝ) ^ 4 := by
    have he := invariant_triple_endpoint_mul_supported hd α β γ (n / d)
    rw [Nat.mul_div_cancel' (hdiv n hn)] at he
    rw [he]
    have hb := invariant_triple_endpoint_norm_divisors P α β γ hA hB hC hα hβ hγ (n / d)
    calc
      _ ≤ (A * B * C * ((n / d).divisors.card : ℝ) ^ 2) ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) hb 2
      _ = _ := by ring
  calc
    _ ≤ ∑ n ∈ S, (A * B * C) ^ 2 * ((n / d).divisors.card : ℝ) ^ 4 :=
      sum_le_sum hnorm
    _ = (A * B * C) ^ 2 * ∑ n ∈ S, ((n / d).divisors.card : ℝ) ^ 4 :=
      (mul_sum ..).symm
    _ ≤ (A * B * C) ^ 2 * (((N : ℝ) / d) * (1 + Real.log N) ^ 15) :=
      mul_le_mul_of_nonneg_left (divisor_fourth_moment_quotient S d N hdiv hN) (sq_nonneg _)
    _ = _ := by ring

end Bounty
end

section

/- Exact disintegration over the unchanged small state. The original
residue-valid injective-list measure is retained in every fiber. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_small_big_energy_by_small
    {S X : Type*} [Fintype S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (W : X → ℝ) (F : PhysicalSmallBigState P J ell X → ℂ) :
    physicalSmallBigEnergy V W F =
      ∑ s : PhysicalBareResidueState P J ell,
        (if physicalResidueMarksValid s.1 s.2 then physicalStateMass V J ell else 0) *
          finiteWeightedEnergy W (fun x => F (s, x)) := by
  rw [← physical_small_big_energy_eq]
  unfold finiteWeightedEnergy
  rw [Fintype.sum_prod_type]
  apply sum_congr rfl
  intro s _
  rw [mul_sum]
  apply sum_congr rfl
  intro x _
  unfold physicalSmallBigMeasure
  split_ifs <;> ring

theorem physical_small_big_fiber_energy_le
    {S X : Type*} [Fintype S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (hV : ∀ s, 0 < V s) (W : X → ℝ)
    (F output : PhysicalSmallBigState P J ell X → ℂ) (K : ℝ)
    (hbound : ∀ s, finiteWeightedEnergy W (fun x => output (s, x)) ≤
      K * finiteWeightedEnergy W (fun x => F (s, x))) :
    physicalSmallBigEnergy V W output ≤ K * physicalSmallBigEnergy V W F := by
  rw [physical_small_big_energy_by_small, physical_small_big_energy_by_small, mul_sum]
  apply sum_le_sum
  intro s _
  have hs : 0 ≤ if physicalResidueMarksValid s.1 s.2 then physicalStateMass V J ell else 0 := by
    split_ifs
    · exact (physical_state_mass_pos V hV J ell).le
    · exact le_rfl
  exact (mul_le_mul_of_nonneg_left (hbound s) hs).trans_eq (by ring)

end Bounty
end

section

/- The candidate's next band supplies five active slots. The terminal loss is at most 88 log L. -/

open Finset Real

namespace Bounty

theorem finite_sum_le_of_injective_nonneg {I J : Type*} [Fintype I] [Fintype J]
    [DecidableEq J] (f : I → J) (hf : Function.Injective f)
    (g : J → ℝ) (hg : ∀ j, 0 ≤ g j) : (∑ i, g (f i)) ≤ ∑ j, g j := by
  rw [← sum_image (fun i _ j _ h => hf h)]
  exact sum_le_sum_of_subset_of_nonneg (subset_univ _) (fun j _ _ => hg j)

theorem candidate_allocation_room {c L : ℝ} (hc : 0 < c) (hL : 0 < L)
    (hlog : 0 < log L) {r jStar : ℕ} (hr : 6 ≤ r)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) :
    SmoothAllocationRoom ((candidateQIndices c L).card*r)
      (fun i => log (candidateAllocationValue c L r jStar x i))
      (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val)
      (candidateAllocationActive c L r jStar) (88*log L) := by
  classical
  have hval (i : Fin ((candidateQIndices c L).card*r)) :=
    candidate_Q_slot_log_bounds c L r jStar (candidateAllocationOrder c L r i) (x _).property
  have hv0 (i : Fin ((candidateQIndices c L).card*r)) :
      0 ≤ log (candidateAllocationValue c L r jStar x i) := by
    exact (by positivity : (0 : ℝ) ≤ c*L/2^(candidateAllocationOrder c L r i).1.val).trans
      (hval i).1.le
  have hfuture0 (i : Fin ((candidateQIndices c L).card*r)) :
      0 ≤ smoothAllocationFuture _ (fun k => log (candidateAllocationValue c L r jStar x k))
        (candidateAllocationActive c L r jStar) i := by
    apply sum_nonneg
    intro k hk
    split_ifs
    · exact hv0 k
    · rfl
  apply smooth_allocation_room_of_future_bound
  intro i hai
  let j := (candidateAllocationOrder c L r i).1.val
  let J := ⌊log (c*L/(20*log L))/log 2⌋₊
  have hj : j ≤ J := (mem_Icc.mp (candidateAllocationOrder c L r i).1.property).2
  have hs : 0 < c*L/2^j := by positivity
  have hv : log (candidateAllocationValue c L r jStar x i) ≤ (6/5 : ℝ)*(c*L/2^j) := by
    simpa only [candidateAllocationValue, j, mul_div_assoc] using (hval i).2
  by_cases hjlt : j < J
  · let next : candidateQIndices c L := ⟨j+1, mem_Icc.mpr ⟨Nat.zero_le _, hjlt⟩⟩
    let f : Fin 5 → Fin ((candidateQIndices c L).card*r) := fun k =>
      (candidateAllocationOrder c L r).symm (next, ⟨k.val+1, by have hk := k.isLt; omega⟩)
    have hf : Function.Injective f := by
      intro k k' h
      have hh := congrArg (candidateAllocationOrder c L r) h
      simp only [f, Equiv.apply_symm_apply] at hh
      have he := congrArg (fun z : (candidateQIndices c L) × Fin r => z.2.val) hh
      apply Fin.ext
      dsimp at he
      omega
    have hfi (k : Fin 5) : i < f k := by
      apply candidate_allocation_band_strict
      simp only [f, Equiv.apply_symm_apply, next]
      exact Nat.lt_succ_self j
    have hfa (k : Fin 5) : candidateAllocationActive c L r jStar (f k) = true := by
      simp [candidateAllocationActive, f]
    let g : Fin ((candidateQIndices c L).card*r) → ℝ := fun k =>
      if i < k ∧ candidateAllocationActive c L r jStar k = true
      then log (candidateAllocationValue c L r jStar x k) else 0
    have hg (k) : 0 ≤ g k := by
      dsimp [g]
      split_ifs
      · exact hv0 k
      · rfl
    have hlow (k : Fin 5) : c*L/2^(j+1) ≤ g (f k) := by
      dsimp only [g]
      rw [if_pos ⟨hfi k,hfa k⟩]
      have hh := (hval (f k)).1.le
      simpa only [candidateAllocationValue, f, Equiv.apply_symm_apply, next] using hh
    have hsum : 5*(c*L/2^(j+1)) ≤ smoothAllocationFuture _
        (fun k => log (candidateAllocationValue c L r jStar x k))
        (candidateAllocationActive c L r jStar) i := by
      have hh := (sum_le_sum (fun k (_ : k ∈ (univ : Finset (Fin 5))) => hlow k)).trans
        (finite_sum_le_of_injective_nonneg f hf g hg)
      simpa only [smoothAllocationFuture, g, sum_const, card_univ, Fintype.card_fin, nsmul_eq_mul, Nat.cast_ofNat] using hh
    have he : c*L/2^(j+1) = (c*L/2^j)/2 := by rw [pow_succ, div_mul_eq_div_div]
    rw [he] at hsum
    change log (candidateAllocationValue c L r jStar x i)+c*L/2^j ≤ _
    nlinarith
  · have hjEq : j = J := Nat.le_antisymm hj (Nat.le_of_not_gt hjlt)
    have hlast := candidate_last_band_scale_lt hc hL hlog
    change c*L/2^J < 40*log L at hlast
    rw [← hjEq] at hlast
    have hnonneg := hfuture0 i
    change log (candidateAllocationValue c L r jStar x i)+c*L/2^j ≤ _
    nlinarith

end Bounty
end

section

/- Rough factors are coprime to a smaller nonzero signed determinant. -/

namespace Bounty

theorem typeII_rough_coprime_natAbs {m : ℕ} {k : ℤ} {W : ℝ}
    (hm : 0 < m) (hk : k ≠ 0)
    (hrough : ∀ p ∈ m.primeFactors, W < (p : ℝ))
    (hsmall : (k.natAbs : ℝ) ≤ W) : Nat.Coprime m k.natAbs := by
  apply Nat.coprime_of_dvd
  intro p hp hpm hpk
  have hlarge := hrough p (Nat.mem_primeFactors.mpr ⟨hp, hpm, hm.ne'⟩)
  have hle : p ≤ k.natAbs := Nat.le_of_dvd (Int.natAbs_pos.mpr hk) hpk
  have hle' : (p : ℝ) ≤ k.natAbs := by exact_mod_cast hle
  linarith

theorem typeII_rough_coprime_determinant {m : ℕ} {k : ℤ} {W : ℝ}
    (hm : 0 < m) (hk : k ≠ 0)
    (hrough : ∀ p ∈ m.primeFactors, W < (p : ℝ))
    (hsmall : |(k : ℝ)| ≤ W) : IsCoprime (m : ℤ) k := by
  rw [Int.isCoprime_iff_nat_coprime, Int.natAbs_natCast]
  apply typeII_rough_coprime_natAbs hm hk hrough
  have habs : (k.natAbs : ℝ) = |(k : ℝ)| := by
    simpa only [Int.cast_abs, Int.cast_natCast] using
      congrArg (fun z : ℤ => (z : ℝ)) (Int.natCast_natAbs k)
  rwa [habs]

theorem typeII_determinant_abs_le_of_difference {m m' e : ℕ} {k : ℤ} {E D : ℝ}
    (hE : 0 < E) (he : E ≤ (e : ℝ))
    (hdiff : |(m' : ℝ) - m| ≤ D)
    (hdet : (m' : ℤ) - m = 2 * e * k) : |(k : ℝ)| ≤ D / (2 * E) := by
  have hid : (m' : ℝ) - m = 2 * (e : ℝ) * (k : ℝ) := by exact_mod_cast hdet
  have he0 : 0 ≤ (e : ℝ) := Nat.cast_nonneg e
  have hh : |(m' : ℝ) - m| = 2 * (e : ℝ) * |(k : ℝ)| := by
    rw [hid, abs_mul, abs_of_nonneg (by positivity : 0 ≤ 2 * (e : ℝ))]
  apply (le_div_iff₀ (by positivity : (0 : ℝ) < 2 * E)).mpr
  rw [hh] at hdiff
  nlinarith [abs_nonneg (k : ℝ)]

end Bounty

end

section

/- The actual short-block Gram estimate, with no factor from the total number of positions. -/

open scoped BigOperators InnerProductSpace

namespace Bounty

theorem finite_position_block_gram_bound {X : Type*} [Fintype X]
    (position : X → ℤ) {mass : ℝ} (hmass : 0 ≤ mass)
    (K : X → X → ℂ) (S : Finset ℤ) {H : ℤ} (hH : 0 < H) (f g : ℤ → ℂ)
    (hf : ∀ x, position x ∉ S → f (position x) = 0)
    (hK : ∀ x y, H < |position x - position y| → K x y = 0)
    {M : ℝ} (hM : 0 ≤ M) (hfM : ∀ n ∈ S, ‖f n‖ ≤ M)
    {R : ℕ} (hR : 2 ≤ R) :
    ‖inner ℂ (finitePositionVector position mass f)
      (finiteKernelOperator K (finitePositionVector position mass g))‖ ≤
      ((H.toNat : ℝ) * M ^ 2) ^ (1 / (2 * (R : ℝ))) *
        (3 * ‖finitePositionVector position mass g‖ ^ 2) ^ (1 / 2 : ℝ) *
        (‖finitePositionVector position mass f‖ ^ 2) ^ ((1 - 1 / (R : ℝ)) / 2) *
        (∑ n ∈ S, (inner ℂ (finiteFiberVector position mass n)
          (((finiteKernelOperator K * (finiteKernelOperator K).adjoint) ^ R)
            (finiteFiberVector position mass n))).re) ^ (1 / (2 * (R : ℝ))) := by
  classical
  let J := S.image (fun n => n / H)
  let F : J → EuclideanSpace ℂ X := fun j =>
    finitePositionVector position mass (integerBlockMask id H j.val f)
  let G : J → EuclideanSpace ℂ X := fun j =>
    finitePositionVector position mass (integerBlockNearMask id H j.val g)
  let A := finiteKernelOperator K
  have hbound := finite_endpoint_block_bound A F G
    (fun j (n : S) => integerBlockMask id H j.val f n.val)
    (fun j (n : S) => positionBlockFiber position mass H j.val n.val)
    (fun j => position_block_fiber_sum position mass S H j.val f hf)
    (fun j => position_block_coefficients_bound S hH j.val f hM hfM) hR
  have hfe : (∑ j, ‖F j‖ ^ 2) = ‖finitePositionVector position mass f‖ ^ 2 := by
    rw [Finset.sum_coe_sort J (fun j : ℤ =>
      ‖finitePositionVector position mass (integerBlockMask id H j f)‖ ^ 2)]
    exact position_block_energy_sum position hmass S H f hf
  have hge : (∑ j, ‖G j‖ ^ 2) ≤ 3 * ‖finitePositionVector position mass g‖ ^ 2 := by
    rw [Finset.sum_coe_sort J (fun j : ℤ =>
      ‖finitePositionVector position mass (integerBlockNearMask id H j g)‖ ^ 2)]
    exact position_near_block_energy_sum position hmass J H g
  have htrace := position_block_fiber_trace position mass S H ((A * A.adjoint) ^ R)
  rw [hfe, htrace] at hbound
  have htrace0 : 0 ≤ ∑ n ∈ S, (inner ℂ (finiteFiberVector position mass n)
      (((A * A.adjoint) ^ R) (finiteFiberVector position mass n))).re := by
    apply Finset.sum_nonneg
    intro n _
    apply positive_spectral_moment_nonneg (A * A.adjoint)
      (LinearMap.isSymmetric_self_comp_adjoint A)
    intro v
    rw [Module.End.mul_apply, ← LinearMap.adjoint_inner_left]
    exact inner_self_nonneg (𝕜 := ℂ) (x := A.adjoint v)
  have hpair : ‖inner ℂ (finitePositionVector position mass f)
      (A (finitePositionVector position mass g))‖ ≤ ∑ j, ‖inner ℂ (F j) (A (G j))‖ := by
    rw [position_block_kernel_pairing position hmass K S hH f g hf hK,
      Finset.sum_coe_sort J (fun j : ℤ =>
        ‖inner ℂ (finitePositionVector position mass (integerBlockMask id H j f))
          (A (finitePositionVector position mass (integerBlockNearMask id H j g)))‖)]
    exact norm_sum_le _ _
  apply hpair.trans (hbound.trans ?_)
  dsimp only [A]
  have hpow := Real.rpow_le_rpow
    (Finset.sum_nonneg (fun j _ => sq_nonneg ‖G j‖)) hge (by norm_num : (0 : ℝ) ≤ 1 / 2)
  apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg htrace0 _)
  apply mul_le_mul_of_nonneg_right _ (by positivity)
  exact mul_le_mul_of_nonneg_left hpow (by positivity)

end Bounty
end

section

/- The actual lifted edge pairing as an arithmetic shifted divisor sum. -/

open Finset

namespace Bounty

theorem physical_endpoint_pairing_eq_shifted
    {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (hV : ∀ g, 0 < V g) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ)
    (positions : Finset ℤ) (f g : ℤ → ℂ) :
    inner ℂ (physicalEndpointVector P V J ell q positions f)
      (physicalHilbertOperator V patterns C q ζ k K positions
        (physicalEndpointVector P V J ell q positions g)) =
      (physicalStateMass V J ell : ℂ) *
      ∑ n ∈ positions, ∑ L : PhysicalMarksAt P J ell n,
      ∑ i ∈ patterns, ∑ aux : PhysicalAuxLabels P (C i),
        let t := n + k i * (physicalD (C i) L.val aux : ℕ)
        if t ∈ positions then ∑ R : PhysicalMarksAt P J ell t,
          (starRingEnd ℂ) (f n) *
          physicalBarePatternScalar V (C i) (ζ i) (K i) aux L.val R.val *
          g t * ((physicalVertexWeight L.val q n * physicalVertexWeight R.val q t : ℝ) : ℂ)
        else 0 := by
  classical
  rw [physical_endpoint_pairing_eq_bare V hV patterns C hq ζ k K positions f g,
    physical_cutoff_sum]
  congr 1
  apply sum_congr rfl
  intro n _
  apply sum_congr rfl
  intro L _
  rw [sum_comm]
  apply sum_congr rfl
  intro i _
  rw [sum_comm]
  apply sum_congr rfl
  intro aux _
  dsimp only
  rw [← physical_cutoff_sum_at P J ell positions
    (n + k i * (physicalD (C i) L.val aux : ℕ))
    (fun R => (starRingEnd ℂ) (f n) *
      physicalBarePatternScalar V (C i) (ζ i) (K i) aux L.val R *
      g (n + k i * (physicalD (C i) L.val aux : ℕ)) *
      ((physicalVertexWeight L.val q n *
        physicalVertexWeight R q (n + k i * (physicalD (C i) L.val aux : ℕ)) : ℝ) : ℂ))]
  apply sum_congr rfl
  intro y _
  split_ifs with h
  · simp only [h]
  · rfl

end Bounty
end

section

/- The two literal invariant endpoints survive removal of the shared dilation. -/

open Finset

namespace Bounty

theorem physical_invariant_endpoints_strip {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime) (n k : ℤ)
    (hmarks : ∀ g s, ((L g s).val : ℤ) ∣ n)
    (α β γ : ℕ → ℂ) :
    invariantTripleEndpoint (univ.biUnion P) α β γ n.natAbs =
      invariantTripleEndpoint (univ.biUnion P) α β γ
        (n / physicalSharedFactor C L).natAbs ∧
    invariantTripleEndpoint (univ.biUnion P) α β γ
        (n + k * (physicalD C L aux : ℕ)).natAbs =
      invariantTripleEndpoint (univ.biUnion P) α β γ
        (n / physicalSharedFactor C L + k * (physicalFreeFactor C aux : ℕ)).natAbs := by
  have hs := physical_shared_factor_supported C L hprime
  have hd := physical_shared_factor_dvd C L n hdis hprime hmarks
  constructor
  · exact invariant_triple_endpoint_int_div hs α β γ n hd
  · have hD : (physicalSharedFactor C L : ℤ) ∣ (physicalD C L aux : ℕ) := by
      rw [physical_D_shared_free, Nat.cast_mul]
      exact dvd_mul_right _ _
    rw [invariant_triple_endpoint_int_div hs α β γ _
      (dvd_add hd (dvd_mul_of_dvd_right hD k)),
      physical_shared_quotient_step C L aux hprime n k]

theorem physical_free_factor_empty {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J : ℕ}
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J)))) :
    physicalFreeFactor (fun _ => ∅) aux = 1 := by
  classical
  simp only [physicalFreeFactor, Finset.univ_eq_empty, prod_empty, prod_const_one]

theorem physical_raw_invariant_endpoints_strip {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (L : PhysicalMarkLists P J ell)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime) (n k : ℤ)
    (hmarks : ∀ g s, ((L g s).val : ℤ) ∣ n)
    (α β γ : ℕ → ℂ) :
    invariantTripleEndpoint (univ.biUnion P) α β γ
        (n + k * (physicalD (fun _ => ∅) L aux : ℕ)).natAbs =
      invariantTripleEndpoint (univ.biUnion P) α β γ
        (n / physicalSharedFactor (fun _ => ∅) L + k).natAbs := by
  simpa only [physical_free_factor_empty, Nat.cast_one, mul_one] using
    (physical_invariant_endpoints_strip (fun _ => ∅) L aux hdis hprime n k hmarks α β γ).2

end Bounty
end

section

/- Exact cancellation of the shared factor in the manuscript's three phases. -/

namespace Bounty

theorem physical_phase_add (a b : ℝ) (n : ℕ) :
    physicalPhase (a + b) n = physicalPhase a n * physicalPhase b n := by
  simp only [physicalPhase, add_mul, Complex.ofReal_add, Complex.exp_add]

theorem physical_shared_phase_cancel (a b : ℝ) {s w z d : ℕ}
    (hs : 0 < s) (hw : 0 < w) (hz : 0 < z) (hd : 0 < d) :
    physicalPhase a (s * w) * physicalPhase b (s * z) *
      physicalPhase (-(a + b)) (s * d) =
    physicalPhase a w * physicalPhase b z * physicalPhase (-(a + b)) d := by
  rw [physical_phase_mul a hs hw, physical_phase_mul b hs hz,
    physical_phase_mul (-(a + b)) hs hd]
  have he : physicalPhase a s * physicalPhase b s * physicalPhase (-(a + b)) s = 1 := by
    rw [← physical_phase_add, ← physical_phase_add, add_neg_cancel]
    simp only [physicalPhase, zero_mul, Complex.ofReal_zero, Complex.exp_zero]
  calc
    _ = (physicalPhase a s * physicalPhase b s * physicalPhase (-(a + b)) s) *
      (physicalPhase a w * physicalPhase b z * physicalPhase (-(a + b)) d) := by ring
    _ = _ := by rw [he, one_mul]

theorem physical_shared_positions {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C) (n k : ℤ)
    (hn : (physicalSharedFactor C L : ℤ) ∣ n) :
    n = (physicalSharedFactor C L : ℤ) * (n / physicalSharedFactor C L) ∧
    n + k * (physicalD C L aux : ℕ) = (physicalSharedFactor C L : ℤ) *
      (n / physicalSharedFactor C L + k * (physicalFreeFactor C aux : ℕ)) := by
  have he := (Int.mul_ediv_cancel' hn).symm
  refine ⟨he, ?_⟩
  rw [physical_D_shared_free, Nat.cast_mul]
  conv_lhs => lhs; rw [he]
  ring

theorem physical_shifted_phase_strip {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C)
    (hprime : ∀ g p, p ∈ P g → p.Prime) (n k : ℤ)
    (hdiv : (physicalSharedFactor C L : ℤ) ∣ n)
    (hn : n ≠ 0) (ht : n + k * (physicalD C L aux : ℕ) ≠ 0) (a b : ℝ) :
    physicalPhase a n.natAbs *
      physicalPhase b (n + k * (physicalD C L aux : ℕ)).natAbs *
      physicalPhase (-(a + b)) (physicalD C L aux) =
    physicalPhase a (n / physicalSharedFactor C L).natAbs *
      physicalPhase b
        (n / physicalSharedFactor C L + k * (physicalFreeFactor C aux : ℕ)).natAbs *
      physicalPhase (-(a + b)) (physicalFreeFactor C aux) := by
  obtain ⟨he, ht'⟩ := physical_shared_positions C L aux n k hdiv
  have hw : 0 < (n / physicalSharedFactor C L).natAbs := by
    apply Int.natAbs_pos.mpr
    intro h
    apply hn
    rw [he, h, mul_zero]
  have hz : 0 < (n / physicalSharedFactor C L + k * (physicalFreeFactor C aux : ℕ)).natAbs := by
    apply Int.natAbs_pos.mpr
    intro h
    apply ht
    rw [ht', h, mul_zero]
  have hd : 0 < physicalFreeFactor C aux := by
    classical
    exact Finset.prod_pos (fun g _ => Finset.prod_pos
      (fun j _ => (hprime g _ (aux g j).property).pos))
  have he' := congrArg Int.natAbs he
  have ht'' := congrArg Int.natAbs ht'
  simp only [Int.natAbs_mul, Int.natAbs_natCast] at he' ht''
  rw [he', ht'', physical_D_shared_free]
  exact physical_shared_phase_cancel a b (physical_shared_factor_pos C L hprime) hw hz hd

theorem physical_shared_reciprocal {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (n : ℤ)
    (hdiv : (physicalSharedFactor C L : ℤ) ∣ n) :
    (n : ℂ)⁻¹ = (physicalSharedFactor C L : ℂ)⁻¹ *
      ((n / physicalSharedFactor C L : ℤ) : ℂ)⁻¹ := by
  have hn : n = (physicalSharedFactor C L : ℤ) * (n / physicalSharedFactor C L) :=
    (Int.mul_ediv_cancel' hdiv).symm
  calc
    _ = (((physicalSharedFactor C L : ℤ) * (n / physicalSharedFactor C L) : ℤ) : ℂ)⁻¹ :=
      congrArg (fun x : ℤ => (x : ℂ)⁻¹) hn
    _ = _ := by simp only [Int.cast_mul, Int.cast_natCast, mul_inv]

theorem physical_shared_scaled_position {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C)
    (hprime : ∀ g p, p ∈ P g → p.Prime) (n : ℤ) (Z : ℝ)
    (hdiv : (physicalSharedFactor C L : ℤ) ∣ n) :
    (n : ℝ) / (Z * physicalD C L aux) =
      ((n / physicalSharedFactor C L : ℤ) : ℝ) / (Z * physicalFreeFactor C aux) := by
  have hn : (n : ℝ) = (physicalSharedFactor C L : ℝ) *
      ((n / physicalSharedFactor C L : ℤ) : ℝ) := by
    exact_mod_cast (Int.mul_ediv_cancel' hdiv).symm
  have hs : (physicalSharedFactor C L : ℝ) ≠ 0 := by
    exact_mod_cast (ne_of_gt (physical_shared_factor_pos C L hprime))
  calc
    _ = ((physicalSharedFactor C L : ℝ) * ((n / physicalSharedFactor C L : ℤ) : ℝ)) /
        ((physicalSharedFactor C L : ℝ) * (Z * physicalFreeFactor C aux)) := by
      rw [← hn, physical_D_shared_free, Nat.cast_mul]
      congr 1
      ring
    _ = _ := mul_div_mul_left _ _ hs

end Bounty
end

section

open MeasureTheory Finset

namespace Bounty

theorem typeII_cutoff_fourier_truncated_norm_le (A C R t : ℝ) (active : Bool)
    (hC : (∫ ξ : ℝ, ‖typeIICutoffFourier A active ξ‖) ≤ C) :
    ‖∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ R}, typeIICutoffFourierIntegrand A active t ξ‖ ≤ C := by
  apply (norm_integral_le_integral_norm _).trans
  have heq : (∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ R}, ‖typeIICutoffFourierIntegrand A active t ξ‖) =
      ∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ R}, ‖typeIICutoffFourier A active ξ‖ := by
    exact integral_congr_ae (Filter.Eventually.of_forall (fun ξ =>
      typeII_cutoff_fourier_integrand_norm A t ξ active))
  rw [heq]
  exact (setIntegral_le_integral (typeII_cutoff_fourier_integrable A active).norm
    (Filter.Eventually.of_forall (fun _ => norm_nonneg _))).trans hC

theorem typeII_fourier_product_truncation_le {N : ℕ} (A C D : ℝ) (M : ℕ)
    (hC1 : 1 ≤ C)
    (hC : ∀ active : Bool, (∫ ξ : ℝ, ‖typeIICutoffFourier A active ξ‖) ≤ C)
    (hD : 0 ≤ D)
    (hdecay : ∀ active : Bool, ∀ R : ℝ, 1 ≤ R → ∀ t : ℝ,
      ‖(typeIISmoothCutoff A active t : ℂ) -
          ∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ R}, typeIICutoffFourierIntegrand A active t ξ‖ ≤
        D * R ^ (-(M : ℝ)))
    (branch : Fin N → Bool) (t : Fin N → ℝ) {R : ℝ} (hR : 1 ≤ R) :
    ‖(∏ i, (typeIISmoothCutoff A (branch i) (t i) : ℂ)) -
        ∫ ξ : Fin N → ℝ, typeIIFourierProductIntegrand A branch t ξ
          ∂typeIIFourierBoxMeasure N R‖ ≤
      N * D * C ^ (N - 1) * R ^ (-(M : ℝ)) := by
  rw [typeII_fourier_product_box_factorization]
  have hf : ∀ i ∈ (univ : Finset (Fin N)),
      ‖(typeIISmoothCutoff A (branch i) (t i) : ℂ)‖ ≤ C := by
    intro i hi
    have hb := typeII_smooth_cutoff_bounds A (t i) (branch i)
    simpa only [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hb.1] using hb.2.trans hC1
  have hg : ∀ i ∈ (univ : Finset (Fin N)),
      ‖∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ R}, typeIICutoffFourierIntegrand A (branch i) (t i) ξ‖ ≤ C :=
    fun i _ => typeII_cutoff_fourier_truncated_norm_le A C R (t i) (branch i) (hC _)
  have hp := complex_finset_product_error univ
    (fun i : Fin N => (typeIISmoothCutoff A (branch i) (t i) : ℂ))
    (fun i : Fin N => ∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ R},
      typeIICutoffFourierIntegrand A (branch i) (t i) ξ)
    (by linarith : 0 ≤ C)
    (mul_nonneg hD (Real.rpow_nonneg (by linarith) _)) hf hg
    (fun i _ => hdecay (branch i) R hR (t i))
  simp only [card_univ, Fintype.card_fin] at hp
  calc
    _ ≤ (N : ℝ) * (D * R ^ (-(M : ℝ))) * C ^ (N - 1) := hp
    _ = _ := by ring

theorem typeII_fourier_product_bounds (A : ℝ) :
    ∃ C : ℝ, 1 ≤ C ∧
      (∀ (N : ℕ) (branch : Fin N → Bool),
        (∫ ξ : Fin N → ℝ, ‖typeIIFourierProductWeight A branch ξ‖) ≤ C ^ N) ∧
      (∀ N : ℕ, (∑ branch : Fin N → Bool, ∫ ξ : Fin N → ℝ,
        ‖typeIIFourierProductWeight A branch ξ‖) ≤ (2 * C) ^ N) ∧
      ∀ M : ℕ, ∃ D : ℝ, 0 < D ∧
        ∀ (N : ℕ) (branch : Fin N → Bool) (t : Fin N → ℝ) (R : ℝ), 1 ≤ R →
          ‖(∏ i, (typeIISmoothCutoff A (branch i) (t i) : ℂ)) -
              ∫ ξ : Fin N → ℝ, typeIIFourierProductIntegrand A branch t ξ
                ∂typeIIFourierBoxMeasure N R‖ ≤
            N * D * C ^ (N - 1) * R ^ (-(M : ℝ)) := by
  obtain ⟨C, hC1, hC⟩ := typeII_cutoff_fourier_l1_bound A
  refine ⟨C, hC1, ?_, ?_, ?_⟩
  · exact fun N branch => typeII_fourier_product_l1_le A C hC branch
  · exact fun N => typeII_fourier_all_branches_l1_le N A C hC
  · intro M
    obtain ⟨D, hD, hdecay⟩ := typeII_cutoff_fourier_rapid_truncation A M
    exact ⟨D, hD, fun N branch t R hR =>
      typeII_fourier_product_truncation_le A C D M hC1 hC hD.le hdecay branch t hR⟩

end Bounty
end

section

open MeasureTheory Finset

namespace Bounty

theorem typeII_fourier_product_integrand_eq_phase_mul {N : ℕ} (A : ℝ)
    (branch : Fin N → Bool) (t ξ : Fin N → ℝ) :
    typeIIFourierProductIntegrand A branch t ξ =
      Complex.exp (((2 * Real.pi * ∑ i, ξ i * t i : ℝ) : ℂ) * Complex.I) *
        typeIIFourierProductWeight A branch ξ := by
  simp only [typeIIFourierProductIntegrand, typeIICutoffFourierIntegrand,
    typeIIFourierProductWeight, prod_mul_distrib]
  rw [← Complex.exp_sum]
  congr 2
  simp only [mul_sum, Complex.ofReal_sum, sum_mul]
  apply sum_congr rfl
  intro i hi
  push_cast
  ring

theorem typeII_transition_product_inversion {N : ℕ} (A : ℝ)
    (branch : Fin N → Bool) (t : Fin N → ℝ)
    (ht : ∀ i, t i ∈ Set.Icc (-A) A) :
    (∏ i, ((if branch i then Real.smoothTransition (t i)
        else 1 - Real.smoothTransition (t i) : ℝ) : ℂ)) =
      ∫ ξ : Fin N → ℝ, typeIIFourierProductIntegrand A branch t ξ := by
  rw [← typeII_fourier_product_inversion]
  apply prod_congr rfl
  intro i hi
  rw [typeII_smooth_cutoff_eq_transition (branch i) (ht i)]

theorem typeII_fourier_product_box_weight_integrable {N : ℕ} (A R : ℝ)
    (branch : Fin N → Bool) :
    Integrable (typeIIFourierProductWeight A branch) (typeIIFourierBoxMeasure N R) :=
  Integrable.fintype_prod (fun i => (typeII_cutoff_fourier_integrable A (branch i)).integrableOn)

theorem typeII_fourier_product_box_l1_factorization {N : ℕ} (A R : ℝ)
    (branch : Fin N → Bool) :
    (∫ ξ : Fin N → ℝ, ‖typeIIFourierProductWeight A branch ξ‖
      ∂typeIIFourierBoxMeasure N R) =
      ∏ i, ∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ R}, ‖typeIICutoffFourier A (branch i) ξ‖ := by
  simp only [typeIIFourierProductWeight, norm_prod, typeIIFourierBoxMeasure]
  exact integral_fintype_prod_eq_prod (fun (i : Fin N) (ξ : ℝ) =>
    ‖typeIICutoffFourier A (branch i) ξ‖)

theorem typeII_fourier_product_box_l1_le {N : ℕ} (A C R : ℝ)
    (hC : ∀ active : Bool, (∫ ξ : ℝ, ‖typeIICutoffFourier A active ξ‖) ≤ C)
    (branch : Fin N → Bool) :
    (∫ ξ : Fin N → ℝ, ‖typeIIFourierProductWeight A branch ξ‖
      ∂typeIIFourierBoxMeasure N R) ≤ C ^ N := by
  rw [typeII_fourier_product_box_l1_factorization]
  calc
    _ ≤ ∏ _i : Fin N, C := by
      apply prod_le_prod₀ (fun _ _ => integral_nonneg (fun _ => norm_nonneg _))
      intro i hi
      exact (setIntegral_le_integral (typeII_cutoff_fourier_integrable A (branch i)).norm
        (Filter.Eventually.of_forall (fun _ => norm_nonneg _))).trans (hC _)
    _ = C ^ N := by simp

theorem typeII_fourier_product_integrand_l1_le {N : ℕ} (A C : ℝ)
    (hC : ∀ active : Bool, (∫ ξ : ℝ, ‖typeIICutoffFourier A active ξ‖) ≤ C)
    (branch : Fin N → Bool) (t : Fin N → ℝ) :
    (∫ ξ : Fin N → ℝ, ‖typeIIFourierProductIntegrand A branch t ξ‖) ≤ C ^ N := by
  simp_rw [typeII_fourier_product_integrand_norm]
  exact typeII_fourier_product_l1_le A C hC branch

theorem typeII_fourier_product_box_integrand_l1_le {N : ℕ} (A C R : ℝ)
    (hC : ∀ active : Bool, (∫ ξ : ℝ, ‖typeIICutoffFourier A active ξ‖) ≤ C)
    (branch : Fin N → Bool) (t : Fin N → ℝ) :
    (∫ ξ : Fin N → ℝ, ‖typeIIFourierProductIntegrand A branch t ξ‖
      ∂typeIIFourierBoxMeasure N R) ≤ C ^ N := by
  simp_rw [typeII_fourier_product_integrand_norm]
  exact typeII_fourier_product_box_l1_le A C R hC branch

end Bounty
end

section

/- The actual large P-part contribution, including all rough shifted divisors. -/

open Finset Filter Real

namespace Bounty

noncomputable def candidateLargePRoughDivisorMass (c L q : ℝ) (r jStar : ℕ) (X : ℝ) : ℝ :=
  ∑ u ∈ (arithmeticProductWindow 1 (exp L)).filter
    (fun u => X < (primePoolPart ((candidatePIndices c L).biUnion (candidatePBand (c*L))) u : ℝ)),
      candidateCoefficient c L q r jStar u * ((roughDivisors (exp (sqrt L)) (2*u+1)).card : ℝ)

theorem arithmetic_window_rough_divisors_bound {L : ℝ} (hL : log 33 ≤ L)
    {u : ℕ} (hu : u ∈ arithmeticProductWindow 1 (exp L)) :
    ((roughDivisors (exp (sqrt L)) (2*u+1)).card : ℝ) ≤ exp ((2*log 2)*sqrt L) := by
  have hL0 : 0 < L := (log_pos (by norm_num : (1 : ℝ) < 33)).trans_le hL
  have hE : (33 : ℝ) ≤ exp L := (log_le_iff_le_exp (by norm_num)).mp hL
  have huhi : (u : ℝ) ≤ 16*exp L := by
    simpa only [one_mul] using ((mem_arithmeticProductWindow_iff one_ne_zero (exp L)).mp hu).2
  apply roughDivisors_card_le_exp_sqrt hL0 (by omega : 2*u+1 ≠ 0)
  calc
    ((2*u+1 : ℕ) : ℝ) = 2*(u : ℝ)+1 := by norm_cast
    _ ≤ 33*exp L := by linarith
    _ ≤ exp L*exp L := mul_le_mul_of_nonneg_right hE (exp_pos _).le
    _ = exp (2*L) := by rw [← exp_add]; congr 1; ring

theorem candidate_large_P_rough_mass_le {c L q : ℝ} (hq : 0 ≤ q) (hL : log 33 ≤ L)
    (r jStar : ℕ) (X : ℝ) :
    candidateLargePRoughDivisorMass c L q r jStar X ≤
      candidateLargePWindowMass c L q r jStar X * exp ((2*log 2)*sqrt L) := by
  unfold candidateLargePRoughDivisorMass candidateLargePWindowMass
  rw [sum_mul]
  apply sum_le_sum
  intro u hu
  exact mul_le_mul_of_nonneg_left (arithmetic_window_rough_divisors_bound hL (mem_filter.mp hu).1)
    (candidate_coefficient_nonneg c L hq r jStar u)

theorem exists_candidate_large_P_rough_exp_bound {c q : ℝ} (hc : 0 < c)
    (hq0 : 0 ≤ q) (hq1 : q < 1) (r : ℕ) (κ : ℝ) :
    ∃ C : ℝ, ∀ jStar : ℕ, ∀ᶠ L : ℝ in atTop,
      candidateLargePRoughDivisorMass c L q r jStar (exp (κ*L)) ≤
        16*exp L*exp (-κ*L^(3/5 : ℝ))*L^C*exp ((2*log 2)*sqrt L) := by
  obtain ⟨CP, hP⟩ := exists_candidate_marked_smooth_tail_exp_bound (κ := κ) hc hq0 hq1 1
  obtain ⟨CQ, hCQ, hQ⟩ := exists_candidate_Q_harmonic_polynomial_bounds hc r
  refine ⟨CP+CQ, ?_⟩
  intro jStar
  filter_upwards [hP, hQ jStar, eventually_candidate_Q_weight_free_support hc r,
    eventually_ge_atTop (log 33)] with L hp hq hfree hL
  have hL0 : 0 < L := (log_pos (by norm_num : (1 : ℝ) < 33)).trans_le hL
  have htail := candidate_large_P_window_le_tail (mul_nonneg hc.le hL0.le) hq0 r jStar
    (exp (κ*L)) (hfree jStar)
  have hQ0 : 0 ≤ candidateQHarmonicMass c L r jStar :=
    tsum_nonneg (fun n => div_nonneg (candidate_Q_weight_nonneg c L r jStar n) (Nat.cast_nonneg n))
  calc
    _ ≤ (16*exp L*candidateMarkedSmoothTail c L q 1 (exp (κ*L))*
        candidateQHarmonicMass c L r jStar)*exp ((2*log 2)*sqrt L) :=
      (candidate_large_P_rough_mass_le hq0 hL r jStar _).trans
        (mul_le_mul_of_nonneg_right htail (exp_pos _).le)
    _ ≤ (16*exp L*(exp (-κ*L^(3/5 : ℝ))*L^CP)*L^CQ)*exp ((2*log 2)*sqrt L) := by
      apply mul_le_mul_of_nonneg_right _ (exp_pos _).le
      exact mul_le_mul (mul_le_mul_of_nonneg_left hp (by positivity)) hq.2 hQ0 (by positivity)
    _ = _ := by rw [rpow_add hL0]; ring

theorem eventually_candidate_large_P_rough_power_saving {c q κ : ℝ} (hc : 0 < c)
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hκ : 0 < κ) (r jStar : ℕ) (D : ℝ) :
    ∀ᶠ L : ℝ in atTop,
      candidateLargePRoughDivisorMass c L q r jStar (exp (κ*L)) ≤ exp L*L^(-D) := by
  obtain ⟨C, hC⟩ := exists_candidate_large_P_rough_exp_bound hc hq0 hq1 r κ
  have hK : 0 ≤ (2 : ℝ)*log 2 := by positivity
  filter_upwards [hC jStar, eventually_exp_neg_rpow_mul_rpow_mul_exp_sqrt_le
    (by norm_num : (1/2 : ℝ) < 3/5) hκ hK C (D+1),
    eventually_ge_atTop (16 : ℝ)] with L hmass hdecay hL
  have hL0 : 0 < L := by linarith
  calc
    _ ≤ 16*exp L*((exp (-κ*L^(3/5 : ℝ))*L^C)*exp ((2*log 2)*sqrt L)) := by
      convert hmass using 1
      ring
    _ ≤ 16*exp L*L^(-(D+1)) := mul_le_mul_of_nonneg_left hdecay (by positivity)
    _ = (16/L)*(exp L*L^(-D)) := by
      rw [show -(D+1) = -D+(-1) by ring, rpow_add hL0, rpow_neg_one]
      ring
    _ ≤ exp L*L^(-D) := by
      have hh : 16/L ≤ 1 := (div_le_one hL0).mpr hL
      exact mul_le_of_le_one_left (by positivity) hh

end Bounty
end

section

/- Actual separated candidate coefficients satisfy factorial bounds independently of the allocation target. -/

open Finset

namespace Bounty

theorem candidate_taken_slot_is_pure (c L : ℝ) (r jStar : ℕ)
    (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm (candidateRoughSlot c L r jStar hr hj)) = false)
    (slot : CandidateTakenSlot c L r take) :
    slot.val ≠ candidateRoughSlot c L r jStar hr hj := by
  intro heq
  have hs := slot.property
  rw [heq, hkeep] at hs
  exact Bool.false_ne_true hs

theorem candidate_residual_slot_is_pure (c L : ℝ) (r jStar : ℕ)
    (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm (candidateRoughSlot c L r jStar hr hj)) = false)
    (slot : {slot : CandidateRemainingSlot c L r take //
      slot ≠ candidateRemainingRoughSlot c L r jStar hr hj take hkeep}) :
    slot.val.val ≠ candidateRoughSlot c L r jStar hr hj := by
  intro heq
  exact slot.property (Subtype.ext heq)

theorem norm_candidate_taken_coefficient_le_factorials {c L : ℝ} {r jStar : ℕ}
    (hcL : 0 ≤ c*L) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm (candidateRoughSlot c L r jStar hr hj)) = false)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ)
    (htwist : ∀ slot p, p ∈ candidateQSlotChoices c L r jStar slot → ‖twist slot p‖ ≤ 1)
    (e : ℕ) :
    ‖candidateTakenComplexCoefficient c L r jStar take twist e‖ ≤
      ∏ j : candidateQIndices c L,
        ((Fintype.card {slot : CandidateTakenSlot c L r take // slot.val.1=j}).factorial : ℝ) := by
  exact norm_candidate_Q_pure_subset_fiber_le hcL hr hj Subtype.val
    (candidate_taken_slot_is_pure c L r jStar hr hj take hkeep)
    (fun slot => twist slot.val) (fun slot p hp => htwist slot.val p hp) e

theorem norm_candidate_taken_coefficient_le_factorial_pow {c L : ℝ} {r jStar : ℕ}
    (hcL : 0 ≤ c*L) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm (candidateRoughSlot c L r jStar hr hj)) = false)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ)
    (htwist : ∀ slot p, p ∈ candidateQSlotChoices c L r jStar slot → ‖twist slot p‖ ≤ 1)
    (e : ℕ) :
    ‖candidateTakenComplexCoefficient c L r jStar take twist e‖ ≤
      (r.factorial : ℝ)^(candidateQIndices c L).card := by
  exact norm_candidate_Q_pure_subset_fiber_le_factorial_pow hcL hr hj Subtype.val
    Subtype.val_injective (candidate_taken_slot_is_pure c L r jStar hr hj take hkeep)
    (fun slot => twist slot.val) (fun slot p hp => htwist slot.val p hp) e

theorem norm_candidate_residual_prime_coefficient_le_one {c L : ℝ} {r jStar : ℕ}
    (hcL : 0 ≤ c*L) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm (candidateRoughSlot c L r jStar hr hj)) = false)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ)
    (htwist : ∀ slot p, p ∈ candidateQSlotChoices c L r jStar slot → ‖twist slot p‖ ≤ 1)
    (q : ℕ) :
    ‖candidateResidualPrimeCoefficient c L r jStar hr hj take hkeep twist q‖ ≤ 1 := by
  let I := {slot : CandidateRemainingSlot c L r take //
    slot ≠ candidateRemainingRoughSlot c L r jStar hr hj take hkeep}
  let emb : I → (candidateQIndices c L) × Fin r := fun slot => slot.val.val
  have hemb : Function.Injective emb := by
    intro a b hab
    exact Subtype.ext (Subtype.ext hab)
  unfold candidateResidualPrimeCoefficient orderedSlotComplexWeight
  exact norm_candidate_Q_pure_subset_fiber_normalized_le_one (I := I) hcL hr hj emb hemb
    (candidate_residual_slot_is_pure c L r jStar hr hj take hkeep)
    (fun slot => twist slot.val.val) (fun slot p hp => htwist slot.val.val p hp) q

theorem norm_sum_product_eq_le_indicator (S : Finset ℕ) (w : ℕ → ℂ) (z : ℂ)
    (hw : ∀ q ∈ S, ‖w q‖ ≤ 1) (hz : ‖z‖ ≤ 1) {p : ℕ} (hp : 0 < p) (n : ℕ) :
    ‖∑ q ∈ S, if p*q=n then z*w q else 0‖ ≤ if p ∣ n then (1 : ℝ) else 0 := by
  classical
  by_cases hpn : p ∣ n
  · rw [if_pos hpn]
    have heq (q : ℕ) : p*q=n ↔ q=n/p := by
      constructor
      · intro h
        exact (Nat.div_eq_of_eq_mul_right hp h.symm).symm
      · intro h
        rw [h, Nat.mul_div_cancel' hpn]
    simp only [heq]
    rw [sum_ite_eq']
    by_cases hq : n/p ∈ S
    · rw [if_pos hq, norm_mul]
      exact (mul_le_mul hz (hw _ hq) (norm_nonneg _) (by norm_num)).trans_eq (mul_one 1)
    · rw [if_neg hq, norm_zero]
      norm_num
  · rw [if_neg hpn]
    have hzero : ∀ q ∈ S, ¬p*q=n := by
      intro q _ h
      exact hpn ⟨q, h.symm⟩
    simp only [sum_eq_zero (fun q hq => if_neg (hzero q hq)), norm_zero, le_refl]

theorem norm_candidate_remaining_coefficient_le_rough_divisors {c L : ℝ} {r jStar : ℕ}
    (hcL : 0 ≤ c*L) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm (candidateRoughSlot c L r jStar hr hj)) = false)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ)
    (htwist : ∀ slot p, p ∈ candidateQSlotChoices c L r jStar slot → ‖twist slot p‖ ≤ 1)
    (h : ℕ) :
    ‖candidateRemainingComplexCoefficient c L r jStar take twist h‖ ≤
      (((candidateRoughBand c L jStar).filter (fun p => p ∣ h)).card : ℝ) := by
  classical
  rw [candidate_remaining_rough_convolution c L r jStar hr hj take hkeep]
  apply (norm_sum_le _ _).trans
  calc
    _ ≤ ∑ p : candidateRoughBand c L jStar, if p.val ∣ h then (1 : ℝ) else 0 := by
      apply sum_le_sum
      intro p _
      apply norm_sum_product_eq_le_indicator
      · intro q _
        exact norm_candidate_residual_prime_coefficient_le_one hcL hr hj take hkeep twist htwist q
      · apply htwist
        simpa only [candidateQSlotChoices, candidateRoughSlot, and_self, if_true] using p.property
      · exact roughBand_pos p.property
    _ = _ := by
      rw [sum_coe_sort (candidateRoughBand c L jStar) (fun p => if p ∣ h then (1 : ℝ) else 0)]
      simp only [sum_boole]


end Bounty
end

section

/- Finite low-rank bounds retain the saving on the unaffected operations. -/

open Finset Classical

namespace Bounty

theorem birthForest_low_rank_power_bound {m : ℕ} (F : BirthForestCode m → ℂ)
    (r₀ : ℕ) {L H B D M : ℝ} (hL : 1 ≤ L) (hH : 0 ≤ H)
    (hDM : 0 ≤ D + M) (hm : (m : ℝ) ≤ L ^ M)
    (hF : ∀ code, birthForestRank code < r₀ →
      ‖F code‖ ≤ H * L ^ (B + 2 * birthForestRank code * D)) :
    ‖∑ code ∈ (univ : Finset (BirthForestCode m)).filter
        (fun code => birthForestRank code < r₀),
      (-1 : ℂ) ^ birthForestRank code * F code‖ ≤
      ((m : ℝ) + 1) * H * L ^ (B + 2 * r₀ * (D + M)) := by
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL
  have heq : (univ : Finset (BirthForestCode m)).filter
      (fun code => birthForestRank code < r₀) =
      univ.filter (fun code => birthForestRank code < min r₀ (m + 1)) := by
    ext code
    have hr := birthForestRank_le_addresses code
    simp only [mem_filter, mem_univ, true_and, lt_min_iff]
    omega
  rw [heq]
  apply (birthForest_rank_head_norm_le F (min r₀ (m + 1))
    (fun r => H * L ^ (B + 2 * r * D))
    (fun r _ => mul_nonneg hH (Real.rpow_pos_of_pos hL0 _).le)
    (fun code hc => hF code (lt_of_lt_of_le hc (min_le_left _ _)))).trans
  have hone : 0 ≤ H * L ^ (B + 2 * r₀ * (D + M)) := by positivity
  calc
    _ ≤ ∑ _r ∈ range (min r₀ (m + 1)), H * L ^ (B + 2 * r₀ * (D + M)) := by
      apply sum_le_sum
      intro r hr
      have hrr : (r : ℝ) ≤ r₀ := by
        exact_mod_cast (Nat.le_of_lt (lt_of_lt_of_le (mem_range.mp hr) (min_le_left _ _)))
      have hp : (m : ℝ) ^ (2 * r) ≤ L ^ (2 * r * M) := by
        calc
          _ ≤ (L ^ M) ^ (2 * r) := pow_le_pow_left₀ (Nat.cast_nonneg _) hm _
          _ = L ^ (2 * r * M) := by
            rw [← Real.rpow_natCast, ← Real.rpow_mul hL0.le]
            congr 1
            push_cast
            ring
      calc
        (m : ℝ) ^ (2 * r) * (H * L ^ (B + 2 * r * D)) ≤
            L ^ (2 * r * M) * (H * L ^ (B + 2 * r * D)) :=
          mul_le_mul_of_nonneg_right hp (by positivity)
        _ = H * L ^ (B + 2 * r * (D + M)) := by
          rw [mul_left_comm, ← Real.rpow_add hL0]
          congr 1
          congr 1
          ring
        _ ≤ H * L ^ (B + 2 * r₀ * (D + M)) := by
          apply mul_le_mul_of_nonneg_left _ hH
          apply Real.rpow_le_rpow_of_exponent_le hL
          nlinarith
    _ = (min r₀ (m + 1) : ℕ) * (H * L ^ (B + 2 * r₀ * (D + M))) := by simp
    _ ≤ ((m : ℝ) + 1) * (H * L ^ (B + 2 * r₀ * (D + M))) := by
      apply mul_le_mul_of_nonneg_right _ hone
      exact_mod_cast min_le_right r₀ (m + 1)
    _ = _ := by ring

end Bounty
end

section

/- Memory-cap embeddings retain the genuine small residue and injective-list
coordinate. The mixed measure is preserved exactly on the embedded states. -/

open Finset
open scoped Classical

namespace Bounty

def physicalSmallBigCapEmbed {S G : Type*} {Ps : S → Finset ℕ}
    {P Z : G → Type*} {J ell b B : ℕ} {M : G → ℕ} (h : b ≤ B)
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M b)) :
    PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) :=
  (s.1, productStateCapEmbed h s.2)

theorem physicalSmallBigCapEmbed_injective {S G : Type*} {Ps : S → Finset ℕ}
    {P Z : G → Type*} {J ell b B : ℕ} {M : G → ℕ} (h : b ≤ B) :
    Function.Injective (physicalSmallBigCapEmbed (Ps := Ps) (P := P) (Z := Z)
      (J := J) (ell := ell) (M := M) h) := by
  intro s t he
  change (s.1, productStateCapEmbed h s.2) = (t.1, productStateCapEmbed h t.2) at he
  have hs : s.1 = t.1 := congrArg
    (fun u : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) => u.1) he
  have ht : s.2 = t.2 := productStateCapEmbed_injective h (congrArg
    (fun u : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) => u.2) he)
  exact Prod.ext hs ht

theorem physicalSmallBigCapEmbed_measure {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {P Z : G → Type*} {J ell b B : ℕ} {M : G → ℕ}
    (h : b ≤ B) (Vs : S → ℝ) (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M b)) :
    physicalSmallBigMeasure Vs (productMemoryWeight μ ν) (physicalSmallBigCapEmbed h s) =
      physicalSmallBigMeasure Vs (productMemoryWeight μ ν) s := rfl

theorem physical_small_big_cap_pullback_energy_le
    {S G : Type*} [Fintype S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} [∀ p : PhysicalPrime Ps, NeZero p.2.val]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    {J ell b B : ℕ} {M : G → ℕ} (h : b ≤ B)
    (Vs : S → ℝ) (hVs : ∀ s, 0 < Vs s)
    (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hν : ∀ g z, 0 ≤ ν g z)
    (F : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ) :
    physicalSmallBigEnergy Vs (productMemoryWeight μ ν)
        (fun s => F (physicalSmallBigCapEmbed h s)) ≤
      physicalSmallBigEnergy Vs (productMemoryWeight μ ν) F := by
  rw [← physical_small_big_energy_eq, ← physical_small_big_energy_eq]
  unfold finiteWeightedEnergy
  let embed := physicalSmallBigCapEmbed (Ps := Ps) (P := P) (Z := Z)
    (J := J) (ell := ell) (M := M) h
  let weight := fun s => physicalSmallBigMeasure Vs (productMemoryWeight μ ν) s * ‖F s‖ ^ 2
  calc
    _ = ∑ s ∈ (univ : Finset (PhysicalSmallBigState Ps J ell
        (ProductBoundedOrderedState P Z M b))).image embed, weight s := by
      rw [sum_image (physicalSmallBigCapEmbed_injective h).injOn]
      rfl
    _ ≤ ∑ s, weight s := sum_le_sum_of_subset_of_nonneg (subset_univ _) (by
      intro s _ _
      exact mul_nonneg (physical_small_big_measure_nonneg Vs hVs _
        (productMemoryWeight_nonneg μ ν hμ hν) s) (sq_nonneg _))

end Bounty
end

section

/- Every intermediate residual on a positive allocation branch satisfies the inventory invariant. -/

open Finset Real

namespace Bounty

noncomputable def allocationPrefixResidual {n : ℕ} (v : Fin n → ℝ)
    (R : ℝ) (take : Fin n → Bool) (i : Fin n) : ℝ :=
  R-∑ j, if j < i then (if take j then v j else 0) else 0

noncomputable def allocationSuffixInventory {n : ℕ} (v : Fin n → ℝ)
    (active : Fin n → Bool) (i : Fin n) : ℝ :=
  ∑ j, if i ≤ j ∧ active j = true then v j else 0

theorem allocation_prefix_eq_ordered_residual {n : ℕ} (v : Fin n → ℝ)
    (R : ℝ) (take : Fin n → Bool) (i : Fin n) :
    allocationPrefixResidual v R take i =
      orderedSlotResidual R (fun j => if take j then 1 else 0) v i := by
  simp only [allocationPrefixResidual, orderedSlotResidual, sum_filter, ite_mul, one_mul, zero_mul]

theorem allocation_prefix_zero {n : ℕ} (v : Fin (n+1) → ℝ)
    (R : ℝ) (take : Fin (n+1) → Bool) : allocationPrefixResidual v R take 0 = R := by
  simp [allocationPrefixResidual]

theorem allocation_suffix_zero {n : ℕ} (v : Fin (n+1) → ℝ)
    (active : Fin (n+1) → Bool) :
    allocationSuffixInventory v active 0 = smoothAllocationInventory (n+1) v active := by
  simp [allocationSuffixInventory, smoothAllocationInventory]

theorem allocation_prefix_succ {n : ℕ} (v : Fin (n+1) → ℝ)
    (R : ℝ) (take : Fin (n+1) → Bool) (i : Fin n) :
    allocationPrefixResidual v R take i.succ =
      allocationPrefixResidual (Fin.tail v) (R-if take 0 then v 0 else 0) (Fin.tail take) i := by
  rw [Fin.tail_def, Fin.tail_def]
  unfold allocationPrefixResidual
  rw [Fin.sum_univ_succ, sub_sub]
  simp only [Fin.succ_pos, if_true, Fin.succ_lt_succ_iff]

theorem allocation_suffix_succ {n : ℕ} (v : Fin (n+1) → ℝ)
    (active : Fin (n+1) → Bool) (i : Fin n) :
    allocationSuffixInventory v active i.succ =
      allocationSuffixInventory (Fin.tail v) (Fin.tail active) i := by
  rw [Fin.tail_def, Fin.tail_def]
  unfold allocationSuffixInventory
  rw [Fin.sum_univ_succ]
  have hzero : ¬i.succ ≤ 0 := not_le_of_gt (Fin.succ_pos i)
  simp only [hzero, false_and, if_false, Fin.succ_le_succ_iff, zero_add]

theorem smooth_allocation_next_residual_bound {n : ℕ} (v s : Fin (n+1) → ℝ)
    (active : Fin (n+1) → Bool) (R A : ℝ) (take : Fin (n+1) → Bool)
    (hs : 0 < s 0) (hR : 0 ≤ R)
    (hcap : R ≤ smoothAllocationInventory (n+1) v active+A)
    (hroom : SmoothAllocationRoom (n+1) v s active A)
    (hhead : 0 < smoothSlotTransition (v 0) (s 0) R (active 0) (take 0)) :
    0 ≤ R-(if take 0 then v 0 else 0) ∧
      R-(if take 0 then v 0 else 0) ≤ smoothAllocationInventory n (Fin.tail v) (Fin.tail active)+A := by
  cases ha : active 0 <;> cases ht : take 0
  · have hh : R ≤ smoothAllocationInventory n (Fin.tail v) (Fin.tail active)+A := by
      rw [Fin.tail_def, Fin.tail_def]
      unfold smoothAllocationInventory at *
      simpa only [Fin.sum_univ_succ, ha, Bool.false_eq_true, if_false, zero_add] using hcap
    simpa only [Bool.false_eq_true, if_false, sub_zero] using And.intro hR hh
  · simp only [smoothSlotTransition, smoothSlotTakeProbability, ha, ht,
      Bool.false_eq_true, if_false, if_true] at hhead
    linarith
  · have hh := smooth_slot_skip_requires_room hs (by simpa only [ha,ht] using hhead)
    have hr := hroom.1 ha
    simp only [Bool.false_eq_true, if_false, sub_zero]
    exact ⟨hR,(le_of_lt hh).trans hr⟩
  · have hh := smooth_slot_take_requires_room hs (by simpa only [ht] using hhead)
    have hc : R ≤ v 0+smoothAllocationInventory n (Fin.tail v) (Fin.tail active)+A := by
      rw [Fin.tail_def, Fin.tail_def]
      unfold smoothAllocationInventory at *
      simpa only [Fin.sum_univ_succ, ha, if_true] using hcap
    simp only [if_true]
    constructor <;> linarith

theorem smooth_allocation_prefix_invariant (n : ℕ) (v s : Fin n → ℝ)
    (active : Fin n → Bool) (R A : ℝ) (take : Fin n → Bool)
    (hs : ∀ i, 0 < s i) (hR : 0 ≤ R)
    (hcap : R ≤ smoothAllocationInventory n v active+A)
    (hroom : SmoothAllocationRoom n v s active A)
    (hweight : 0 < smoothAllocationWeight n v s active R take) (i : Fin n) :
    0 ≤ allocationPrefixResidual v R take i ∧
      allocationPrefixResidual v R take i ≤ allocationSuffixInventory v active i+A := by
  induction n generalizing R with
  | zero => exact Fin.elim0 i
  | succ n ih =>
    obtain ⟨hhead,htail⟩ := smooth_allocation_positive_factors hweight
    have hn := smooth_allocation_next_residual_bound v s active R A take (hs 0) hR hcap hroom hhead
    refine Fin.cases ?_ (fun j => ?_) i
    · simpa only [allocation_prefix_zero, allocation_suffix_zero] using And.intro hR hcap
    · rw [allocation_prefix_succ, allocation_suffix_succ]
      exact ih (Fin.tail v) (Fin.tail s) (Fin.tail active) _ (Fin.tail take)
        (fun j => hs j.succ) hn.1 hn.2 hroom.2 htail j

end Bounty
end

section

open scoped ContDiff

namespace Bounty

noncomputable def typeIITameExp (A x : ℝ) : ℝ :=
  typeIISmoothRho (2 * (A + 1)) x * Real.exp x

noncomputable def typeIIPulledJoint (A : ℝ)
    (y : (Fin 4 → ℝ) × EuclideanSpace ℝ (Fin 3)) : ℝ :=
  typeIIThreeLocalizer A y.2 *
    typeIIEMajorant (y.1 0) (y.1 1 * (typeIITameExp A (y.2 1) - typeIITameExp A (y.2 0))) *
    typeIINMajorant (y.1 2 * (typeIITameExp A (y.2 2 - y.2 0) -
      typeIITameExp A (y.2 2 - y.2 1)) + y.1 3 * typeIITameExp A (-y.2 0))

theorem typeII_tame_exp_hasTemperateGrowth (A : ℝ) :
    Function.HasTemperateGrowth (typeIITameExp A) :=
  (typeII_smooth_rho_hasCompactSupport (2 * (A + 1))).mul_right.hasTemperateGrowth
    ((typeII_smooth_rho_contDiff (2 * (A + 1))).mul Real.contDiff_exp)

theorem typeII_tame_exp_eq {A x : ℝ} (hx : |x| ≤ 2 * (A + 1)) :
    typeIITameExp A x = Real.exp x := by
  rw [typeIITameExp, typeII_smooth_rho_eq_one (abs_le.mp hx), one_mul]

theorem typeII_pulled_joint_hasTemperateGrowth (A : ℝ) :
    Function.HasTemperateGrowth (typeIIPulledJoint A) := by
  have hp (i : Fin 4) : Function.HasTemperateGrowth
      (fun y : (Fin 4 → ℝ) × EuclideanSpace ℝ (Fin 3) => y.1 i) :=
    (ContinuousLinearMap.proj i : (Fin 4 → ℝ) →L[ℝ] ℝ).hasTemperateGrowth.comp
      (ContinuousLinearMap.fst ℝ (Fin 4 → ℝ) (EuclideanSpace ℝ (Fin 3))).hasTemperateGrowth
  have ht (i : Fin 3) : Function.HasTemperateGrowth
      (fun y : (Fin 4 → ℝ) × EuclideanSpace ℝ (Fin 3) => y.2 i) :=
    (PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin 3 => ℝ) i).hasTemperateGrowth.comp
      (ContinuousLinearMap.snd ℝ (Fin 4 → ℝ) (EuclideanSpace ℝ (Fin 3))).hasTemperateGrowth
  have hloc : Function.HasTemperateGrowth
      (fun y : (Fin 4 → ℝ) × EuclideanSpace ℝ (Fin 3) => typeIIThreeLocalizer A y.2) :=
    ((typeII_three_localizer_hasCompactSupport A).hasTemperateGrowth
      (typeII_three_localizer_contDiff A)).comp
      (ContinuousLinearMap.snd ℝ (Fin 4 → ℝ) (EuclideanSpace ℝ (Fin 3))).hasTemperateGrowth
  have hexp := typeII_tame_exp_hasTemperateGrowth A
  have hγ := smoothTransition_hasTemperateGrowth
  unfold typeIIPulledJoint typeIIEMajorant typeIINMajorant
  fun_prop

theorem typeII_pulled_joint_eq {A : ℝ} (hA : 0 ≤ A) (p : Fin 4 → ℝ)
    (t : EuclideanSpace ℝ (Fin 3)) :
    typeIIPulledJoint A (p, t) = typeIIPulledCutoff A (p 0) (p 1) (p 2) (p 3) t := by
  by_cases hl : typeIIThreeLocalizer A t = 0
  · simp only [typeIIPulledJoint, typeIIPulledCutoff, hl, zero_mul]
  have ht (i : Fin 3) : t i ∈ Set.Icc (-A - 1) (A + 1) := by
    by_contra hi
    apply hl
    exact Finset.prod_eq_zero (Finset.mem_univ i) (typeII_smooth_rho_eq_zero hi)
  have h0 := ht 0
  have h1 := ht 1
  have h2 := ht 2
  have hb0 : |t 0| ≤ 2 * (A + 1) := abs_le.mpr ⟨by linarith [h0.1], by linarith [h0.2]⟩
  have hb1 : |t 1| ≤ 2 * (A + 1) := abs_le.mpr ⟨by linarith [h1.1], by linarith [h1.2]⟩
  have hb20 : |t 2 - t 0| ≤ 2 * (A + 1) := abs_le.mpr ⟨by linarith [h2.1, h0.2], by linarith [h2.2, h0.1]⟩
  have hb21 : |t 2 - t 1| ≤ 2 * (A + 1) := abs_le.mpr ⟨by linarith [h2.1, h1.2], by linarith [h2.2, h1.1]⟩
  have hbn0 : |-t 0| ≤ 2 * (A + 1) := by simpa using hb0
  simp only [typeIIPulledJoint, typeIIPulledCutoff, typeIIPulledE, typeIIPulledN,
    typeII_tame_exp_eq hb0, typeII_tame_exp_eq hb1, typeII_tame_exp_eq hb20,
    typeII_tame_exp_eq hb21, typeII_tame_exp_eq hbn0]

end Bounty
end

section

open Finset MeasureTheory

namespace Bounty

noncomputable def typeIILogCoordinates (x s : Fin 3 → ℝ) : EuclideanSpace ℝ (Fin 3) :=
  WithLp.toLp 2 (fun i => Real.log (x i / s i))

theorem typeII_euclidean_fourier_phase_eq_prod (ξ t : EuclideanSpace ℝ (Fin 3)) :
    Complex.exp (((2 * Real.pi * inner ℝ ξ t : ℝ) : ℂ) * Complex.I) =
      ∏ i, Complex.exp (((2 * Real.pi * ξ i * t i : ℝ) : ℂ) * Complex.I) := by
  rw [← Complex.exp_sum, PiLp.inner_apply]
  congr 1
  simp only [RCLike.inner_apply, starRingEnd_apply, star_trivial, mul_sum,
    Complex.ofReal_sum, sum_mul]
  apply sum_congr rfl
  intro i hi
  push_cast
  ring

theorem typeII_log_ratio_fourier_phase (x s ξ : ℝ) (hx : 0 < x) (hs : 0 < s) :
    Complex.exp (((2 * Real.pi * ξ * Real.log (x / s) : ℝ) : ℂ) * Complex.I) =
      (s : ℂ) ^ (-((2 * Real.pi * ξ : ℝ) : ℂ) * Complex.I) *
        (x : ℂ) ^ (((2 * Real.pi * ξ : ℝ) : ℂ) * Complex.I) := by
  rw [Complex.cpow_def_of_ne_zero (Complex.ofReal_ne_zero.mpr hs.ne'),
    Complex.cpow_def_of_ne_zero (Complex.ofReal_ne_zero.mpr hx.ne'),
    ← Complex.ofReal_log hs.le, ← Complex.ofReal_log hx.le, ← Complex.exp_add,
    Real.log_div hx.ne' hs.ne']
  congr 1
  push_cast
  ring

theorem typeII_pulled_logarithmic_phase_separation (x s : Fin 3 → ℝ)
    (hx : ∀ i, 0 < x i) (hs : ∀ i, 0 < s i) (ξ : EuclideanSpace ℝ (Fin 3)) :
    Complex.exp (((2 * Real.pi * inner ℝ ξ (typeIILogCoordinates x s) : ℝ) : ℂ) * Complex.I) =
      (∏ i, (s i : ℂ) ^ (-((2 * Real.pi * ξ i : ℝ) : ℂ) * Complex.I)) *
        ∏ i, (x i : ℂ) ^ (((2 * Real.pi * ξ i : ℝ) : ℂ) * Complex.I) := by
  rw [typeII_euclidean_fourier_phase_eq_prod, ← prod_mul_distrib]
  apply prod_congr rfl
  intro i hi
  exact typeII_log_ratio_fourier_phase (x i) (s i) (ξ i) (hx i) (hs i)

theorem typeII_pulled_logarithmic_fourier_inversion (A q a b c : ℝ)
    (x s : Fin 3 → ℝ) (hx : ∀ i, 0 < x i) (hs : ∀ i, 0 < s i) :
    (typeIIPulledCutoff A q a b c (typeIILogCoordinates x s) : ℂ) =
      ∫ ξ : EuclideanSpace ℝ (Fin 3),
        ((∏ i, (s i : ℂ) ^ (-((2 * Real.pi * ξ i : ℝ) : ℂ) * Complex.I)) *
          ∏ i, (x i : ℂ) ^ (((2 * Real.pi * ξ i : ℝ) : ℂ) * Complex.I)) *
            typeIIPulledFourier A q a b c ξ := by
  rw [typeII_pulled_fourier_inversion]
  apply integral_congr_ae
  exact Filter.Eventually.of_forall (fun ξ => by
    dsimp only
    rw [typeII_pulled_logarithmic_phase_separation x s hx hs ξ])

end Bounty
end

section

/- Group-free multiplication preserves the actual marked divisor weight. -/

open Finset

namespace Bounty

theorem marked_divisor_weight_mul_free_left {G : Type*}
    (groups : Finset G) (P : G → Finset ℕ) (q : ℝ) (mass : G → ℝ) (marks : G → ℕ)
    (hprime : ∀ g ∈ groups, ∀ p ∈ P g, p.Prime)
    {m : ℕ} (hm : m ≠ 0) (hfree : Disjoint m.primeFactors (groups.biUnion P)) (h : ℕ) :
    markedDivisorWeight groups P q mass marks ((m*h : ℕ) : ℤ) =
      markedDivisorWeight groups P q mass marks (h : ℤ) := by
  rw [Nat.mul_comm m h]
  apply marked_divisor_weight_mul_disjoint groups P q mass marks hprime (Q := m.primeFactors)
  · intro g hg
    exact hfree.symm.mono (fun p hp => mem_biUnion.mpr ⟨g, hg, hp⟩) (subset_refl _)
  · exact Nat.mem_factoredNumbers_of_primeFactors_subset hm (subset_refl _)

theorem reconstructed_factor_mem_Icc {v m B : ℕ} (hv : 0 < v)
    (hm : m ∣ v) (hB : v ≤ B) : v/m ∈ Icc 1 B := by
  have hmpos : 0 < m := Nat.pos_of_dvd_of_pos hm hv
  apply mem_Icc.mpr
  constructor
  · exact Nat.div_pos (Nat.le_of_dvd hv hm) hmpos
  · exact (Nat.div_le_self v m).trans hB


end Bounty
end

section

/- Rough convolution endpoints with the retained-factor support mask kept explicit. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

noncomputable def typeIIRoughConvolution (R C : Finset ℕ) (σ : ℝ)
    (c : ℕ → ℂ) (n : ℕ) : ℂ :=
  ∑ p ∈ R, ∑ r ∈ C, if p * r = n then typeIIPhase σ p * c r else 0

noncomputable def typeIIMaskedTripleEndpoint (P M H R C : Finset ℕ)
    (A c : ℕ → ℂ) (t σ : ℝ) (v : ℕ) : ℂ :=
  ∑ m ∈ M, ∑ p ∈ R, ∑ r ∈ C,
    if (m ∣ v ∧ v / m ∈ H) ∧ m * p * r = primePoolFreePart P v then
      A m * typeIIPhase t m * typeIIPhase (-σ) p * conj (c r) else 0

theorem typeII_direct_endpoint_eq_divisor_mask
    (M H : Finset ℕ) (A B : ℕ → ℂ) (t : ℝ) (v : ℕ)
    (hM : ∀ m ∈ M, 0 < m) :
    typeIIDirectEndpoint M H A B t v =
      ∑ m ∈ M, if m ∣ v ∧ v / m ∈ H then
        A m * typeIIPhase t m * conj (B (v / m)) else 0 := by
  classical
  unfold typeIIDirectEndpoint
  apply sum_congr rfl
  intro m hm
  by_cases hd : m ∣ v
  · have heq (h : ℕ) : m * h = v ↔ h = v / m := by
      constructor
      · intro hprod
        exact (Nat.div_eq_of_eq_mul_right (hM m hm) hprod.symm).symm
      · intro hquot
        rw [hquot, Nat.mul_div_cancel' hd]
    simp only [heq, hd, true_and]
    rw [sum_ite_eq']
  · have hne (h : ℕ) : ¬m * h = v := fun hprod => hd ⟨h, hprod.symm⟩
    simp only [hd, false_and, if_false, hne, sum_const_zero]

theorem typeII_direct_rough_endpoint_eq_masked_triple
    (P M H R C : Finset ℕ) (A c : ℕ → ℂ) (t σ : ℝ) {v : ℕ}
    (hv : 0 < v) (hM : ∀ m ∈ M, 0 < m)
    (hfree : ∀ m ∈ M, Disjoint m.primeFactors P) :
    typeIIDirectEndpoint M H A
        (fun h => typeIIRoughConvolution R C σ c (primePoolFreePart P h)) t v =
      typeIIMaskedTripleEndpoint P M H R C A c t σ v := by
  classical
  rw [typeII_direct_endpoint_eq_divisor_mask M H A _ t v hM]
  unfold typeIIMaskedTripleEndpoint
  apply sum_congr rfl
  intro m hm
  by_cases hmask : m ∣ v ∧ v / m ∈ H
  · have hmprod : m * (v / m) = v := Nat.mul_div_cancel' hmask.1
    have hquot : v / m ≠ 0 := by
      intro hz
      rw [hz, mul_zero] at hmprod
      exact hv.ne' hmprod.symm
    have hpart : primePoolFreePart P v = m * primePoolFreePart P (v / m) := by
      calc
        _ = primePoolFreePart P (m * (v / m)) := congrArg (primePoolFreePart P) hmprod.symm
        _ = _ := prime_pool_free_part_mul_free_left (hM m hm).ne' hquot (hfree m hm)
    have heq (p r : ℕ) : m * p * r = primePoolFreePart P v ↔
        p * r = primePoolFreePart P (v / m) := by
      rw [hpart, mul_assoc]
      constructor
      · exact Nat.eq_of_mul_eq_mul_left (hM m hm)
      · intro h
        rw [h]
    have hconj (b : Prop) [Decidable b] (x y : ℂ) :
        conj (if b then x else y) = if b then conj x else conj y := by
      split_ifs <;> rfl
    simp only [hmask, true_and, if_true, heq]
    simp only [typeIIRoughConvolution, map_sum, hconj, map_mul, map_zero,
      typeIIPhase_conj, mul_sum, mul_ite, mul_zero, mul_assoc]
  · simp only [hmask, false_and, if_false, sum_const_zero]

theorem typeII_masked_triple_eq_invariant
    (P M H R C : Finset ℕ) (A c : ℕ → ℂ) (t σ : ℝ) {v : ℕ} (hv : 0 < v) :
    typeIIMaskedTripleEndpoint P M H R C A c t σ v =
      invariantTripleEndpoint P
        (fun m => if m ∈ M ∧ m ∣ v ∧ v / m ∈ H then A m * typeIIPhase t m else 0)
        (fun p => if p ∈ R then typeIIPhase (-σ) p else 0)
        (fun r => if r ∈ C then conj (c r) else 0) v := by
  classical
  have hpos : 0 < primePoolFreePart P v :=
    Nat.pos_of_ne_zero (primePoolFreePart_ne_zero P hv.ne')
  calc
    _ = ∑ m ∈ M, ∑ p ∈ R, ∑ r ∈ C,
        if m * p * r = primePoolFreePart P v then
          (if m ∣ v ∧ v / m ∈ H then A m * typeIIPhase t m else 0) *
            typeIIPhase (-σ) p * conj (c r) else 0 := by
      unfold typeIIMaskedTripleEndpoint
      apply sum_congr rfl
      intro m _
      apply sum_congr rfl
      intro p _
      apply sum_congr rfl
      intro r _
      by_cases hm : m ∣ v ∧ v / m ∈ H <;>
        by_cases heq : m * p * r = primePoolFreePart P v <;> simp [hm, heq]
    _ = endpointTripleConvolution
        (fun m => if m ∈ M then
          (if m ∣ v ∧ v / m ∈ H then A m * typeIIPhase t m else 0) else 0)
        (fun p => if p ∈ R then typeIIPhase (-σ) p else 0)
        (fun r => if r ∈ C then conj (c r) else 0) (primePoolFreePart P v) :=
      finite_triple_sum_eq_endpointTripleConvolution M R C _ _ _ hpos
    _ = _ := by
      unfold invariantTripleEndpoint
      congr 1
      funext m
      by_cases hm : m ∈ M <;> by_cases hd : m ∣ v <;>
        by_cases hh : v / m ∈ H <;> simp [hm, hd, hh]

theorem typeII_masked_triple_eq_invariant_of_complete
    (P M H R C : Finset ℕ) (A c : ℕ → ℂ) (t σ : ℝ) {v : ℕ} (hv : 0 < v)
    (hHcomplete : ∀ m ∈ M, m ∣ v → v / m ∈ H) :
    typeIIMaskedTripleEndpoint P M H R C A c t σ v =
      invariantTripleEndpoint P
        (fun m => if m ∈ M then A m * typeIIPhase t m else 0)
        (fun p => if p ∈ R then typeIIPhase (-σ) p else 0)
        (fun r => if r ∈ C then conj (c r) else 0) v := by
  classical
  rw [typeII_masked_triple_eq_invariant P M H R C A c t σ hv]
  unfold invariantTripleEndpoint endpointTripleConvolution
  apply sum_congr rfl
  intro m hm
  have hfdvd : primePoolFreePart P v ∣ v := by
    refine ⟨primePoolPart P v, ?_⟩
    rw [mul_comm]
    exact (primePoolPart_mul_primePoolFreePart P v).symm
  have hmdvd : m ∣ v := (Nat.dvd_of_mem_divisors hm).trans hfdvd
  by_cases hmM : m ∈ M
  · simp only [hmM, hmdvd, hHcomplete m hmM hmdvd, and_self, if_true]
  · simp only [hmM, false_and, if_false, zero_mul, sum_const_zero]

theorem typeII_direct_rough_endpoint_eq_invariant_of_complete
    (P M H R C : Finset ℕ) (A c : ℕ → ℂ) (t σ : ℝ) {v : ℕ}
    (hv : 0 < v) (hM : ∀ m ∈ M, 0 < m)
    (hfree : ∀ m ∈ M, Disjoint m.primeFactors P)
    (hHcomplete : ∀ m ∈ M, m ∣ v → v / m ∈ H) :
    typeIIDirectEndpoint M H A
        (fun h => typeIIRoughConvolution R C σ c (primePoolFreePart P h)) t v =
      invariantTripleEndpoint P
        (fun m => if m ∈ M then A m * typeIIPhase t m else 0)
        (fun p => if p ∈ R then typeIIPhase (-σ) p else 0)
        (fun r => if r ∈ C then conj (c r) else 0) v :=
  (typeII_direct_rough_endpoint_eq_masked_triple P M H R C A c t σ hv hM hfree).trans
    (typeII_masked_triple_eq_invariant_of_complete P M H R C A c t σ hv hHcomplete)


end Bounty
end

section

/- Exact labelled-slot separation for tests of both factors separately. -/

open Finset

namespace Bounty

theorem ordered_slot_twisted_split_bivariate_test {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (take : I → Prop) [DecidablePred take]
    (twist : I → ℕ → ℂ) (F : ℕ → ℕ → ℂ) :
    (∑ x : ∀ i, choices i, (∏ i, twist i (x i).val) *
      F (orderedSlotProduct (fun i : {i // take i} => choices i.val) (fun i => x i.val))
        (orderedSlotProduct (fun i : {i // ¬take i} => choices i.val) (fun i => x i.val))) =
      ∑ e ∈ orderedSlotProductSupport (fun i : {i // take i} => choices i.val),
      ∑ h ∈ orderedSlotProductSupport (fun i : {i // ¬take i} => choices i.val),
        orderedSlotComplexWeight (fun i : {i // take i} => choices i.val)
          (fun i => twist i.val) e *
        orderedSlotComplexWeight (fun i : {i // ¬take i} => choices i.val)
          (fun i => twist i.val) h * F e h := by
  classical
  have htuple :
      (∑ x : ∀ i, choices i, (∏ i, twist i (x i).val) *
        F (orderedSlotProduct (fun i : {i // take i} => choices i.val) (fun i => x i.val))
          (orderedSlotProduct (fun i : {i // ¬take i} => choices i.val) (fun i => x i.val))) =
      ∑ x : ∀ i : {i // take i}, choices i.val,
      ∑ y : ∀ i : {i // ¬take i}, choices i.val,
        (∏ i, twist i.val (x i).val) * (∏ i, twist i.val (y i).val) *
          F (orderedSlotProduct _ x) (orderedSlotProduct _ y) := by
    let f : (∀ i : {i // take i}, choices i.val) ×
        (∀ i : {i // ¬take i}, choices i.val) → ℂ := fun z =>
      (∏ i, twist i.val (z.1 i).val) * (∏ i, twist i.val (z.2 i).val) *
        F (orderedSlotProduct _ z.1) (orderedSlotProduct _ z.2)
    calc
      _ = ∑ z, f z := by
        apply Fintype.sum_equiv (Equiv.piEquivPiSubtypeProd take (fun i => choices i))
        intro x
        simp only [f, Equiv.piEquivPiSubtypeProd_apply]
        rw [Fintype.prod_subtype_mul_prod_subtype take (fun i => twist i (x i).val)]
      _ = _ := Fintype.sum_prod_type f
  rw [htuple]
  symm
  calc
    _ = ∑ e ∈ orderedSlotProductSupport (fun i : {i // take i} => choices i.val),
        orderedSlotComplexWeight (fun i : {i // take i} => choices i.val) (fun i => twist i.val) e *
        ∑ y : ∀ i : {i // ¬take i}, choices i.val,
          (∏ i, twist i.val (y i).val) * F e (orderedSlotProduct _ y) := by
      apply sum_congr rfl
      intro e _
      simp_rw [mul_assoc]
      rw [← mul_sum, ordered_slot_complex_fiber_test]
    _ = _ := by
      rw [ordered_slot_complex_fiber_test]
      apply sum_congr rfl
      intro x _
      rw [mul_sum]
      apply sum_congr rfl
      intro y _
      ring

theorem candidate_slot_twisted_split_bivariate_test (c L : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (F : ℕ → ℕ → ℂ) :
    (∑ x : ∀ slot, candidateQSlotChoices c L r jStar slot,
      (∏ slot, twist slot (x slot).val) *
        F (candidateAllocatedFactor c L r jStar x take)
          (candidateRetainedFactor c L r jStar 1 x take)) /
        (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ) =
      ∑ e ∈ orderedSlotProductSupport
        (fun slot : CandidateTakenSlot c L r take => candidateQSlotChoices c L r jStar slot.val),
      ∑ h ∈ orderedSlotProductSupport
        (fun slot : CandidateRemainingSlot c L r take => candidateQSlotChoices c L r jStar slot.val),
        candidateTakenComplexCoefficient c L r jStar take twist e *
          candidateRemainingComplexCoefficient c L r jStar take twist h * F e h := by
  simp only [candidate_allocated_factor_eq_taken_product,
    candidate_retained_factor_eq_remaining_product, one_mul]
  rw [ordered_slot_twisted_split_bivariate_test _
    (fun slot => take ((candidateAllocationOrder c L r).symm slot) = true)]
  simp only [sum_div, candidateTakenComplexCoefficient, candidateRemainingComplexCoefficient]
  apply sum_congr rfl
  intro e _
  apply sum_congr rfl
  intro h _
  ring

end Bounty
end

section

/- Every retained partial Q-product is nonzero and free of the original group primes. -/

open Finset Filter

namespace Bounty

theorem ordered_slot_product_support_free {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (P : Finset ℕ)
    (hnonzero : ∀ i n, n ∈ choices i → n ≠ 0)
    (hfree : ∀ i n, n ∈ choices i → Disjoint n.primeFactors P)
    {n : ℕ} (hn : n ∈ orderedSlotProductSupport choices) :
    n ≠ 0 ∧ Disjoint n.primeFactors P := by
  classical
  obtain ⟨x, hx, rfl⟩ := mem_image.mp hn
  constructor
  · exact prod_ne_zero_iff.mpr (fun i _ => hnonzero i (x i).val (x i).property)
  · apply disjoint_left.mpr
    intro p hp hP
    obtain ⟨hpp, hpdvd, _⟩ := Nat.mem_primeFactors.mp hp
    obtain ⟨i, hi, hpi⟩ :=
      ((Nat.prime_iff.mp hpp).dvd_finsetProd_iff (fun i => (x i).val)).mp hpdvd
    have hmem : p ∈ (x i).val.primeFactors :=
      Nat.mem_primeFactors.mpr ⟨hpp, hpi, hnonzero i _ (x i).property⟩
    exact disjoint_left.mp (hfree i _ (x i).property) hmem hP

theorem eventually_candidate_remaining_support_free {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (r jStar : ℕ)
      (take : Fin ((candidateQIndices c L).card * r) → Bool) (n : ℕ),
      n ∈ orderedSlotProductSupport
        (fun slot : CandidateRemainingSlot c L r take => candidateQSlotChoices c L r jStar slot.val) →
      n ≠ 0 ∧ Disjoint n.primeFactors
        ((candidatePIndices c L).biUnion (candidatePBand (c * L))) := by
  filter_upwards [eventually_candidate_P_pool_below_rough_cutoff hc,
    eventually_ge_atTop (0 : ℝ)] with L hpool hL
  intro r jStar take n hn
  apply ordered_slot_product_support_free _ _ _ _ hn
  · intro slot m hm
    exact candidate_Q_slot_nonzero c L r jStar slot.val hm
  · intro slot m hm
    exact candidate_Q_slot_primeFactors_disjoint (mul_nonneg hc.le hL) hpool slot.val hm

end Bounty

end

section

/- Exact full-event transport when displacements agree and dilation has the same prime divisors. -/

open Finset
open scoped Classical
namespace Bounty
section Full
variable {G : Type*} {P : G → Type*}
  (n : ∀ g, P g → ℕ) {M : G → ℕ}
  (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : SharedActiveLabels P S → Type*)
  (Δ Δ' D D' : ∀ c, A c → G → ℤ)
  (hΔ : Δ = Δ')
  (hD : ∀ c a g p, ((n g p : ℤ) ∣ D c a g ↔ (n g p : ℤ) ∣ D' c a g))

noncomputable def fullActiveParameterEventEquiv
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    FullActiveEdgeEvent n S B A Δ D x ≃ FullActiveEdgeEvent n S B A Δ' D' x := by
  subst Δ'
  exact fullActiveDilationEventEquiv n S B A Δ D D' hD x

theorem full_active_parameter_auxiliary
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullActiveEdgeEvent n S B A Δ D x) :
    (fullActiveParameterEventEquiv n S B A Δ Δ' D D' hΔ hD x e).1 = e.1 := by
  subst Δ'
  rfl

theorem full_active_parameter_target
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullActiveEdgeEvent n S B A Δ D x) :
    fullActiveEdgeEventTarget n S B A Δ' D' x
        (fullActiveParameterEventEquiv n S B A Δ Δ' D D' hΔ hD x e) =
      fullActiveEdgeEventTarget n S B A Δ D x e := by
  subst Δ'
  exact full_active_dilation_target n S B A Δ D D' hD x e

theorem full_active_parameter_weight [Fintype G]
    (ω : ∀ c, A c → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullActiveEdgeEvent n S B A Δ D x) :
    fullActiveEdgeEventWeight n S B A Δ' D' ω μ ρ V x
        (fullActiveParameterEventEquiv n S B A Δ Δ' D D' hΔ hD x e) =
      fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V x e := by
  subst Δ'
  exact full_active_dilation_weight n S B A Δ D D' hD ω μ ρ V x e

end Full
end Bounty
end

section

/- An inward smooth product window, with exact agreement off the endpoint collars. -/

open Set
open scoped ContDiff

namespace Bounty

noncomputable def typeIIWindowSmooth (δ t : ℝ) : ℝ :=
  Real.smoothTransition ((t - 1) / δ) * Real.smoothTransition ((16 - t) / δ)

noncomputable def typeIISharpWindow (t : ℝ) : ℝ := if 1 < t ∧ t ≤ 16 then 1 else 0

def typeIIWindowCollar (δ : ℝ) : Set ℝ :=
  Icc (1 - δ) (1 + δ) ∪ Icc (16 - δ) (16 + δ)

theorem typeII_window_smooth_bounds (δ t : ℝ) :
    0 ≤ typeIIWindowSmooth δ t ∧ typeIIWindowSmooth δ t ≤ 1 :=
  typeII_transition_product_bounds _ _

theorem typeII_window_smooth_eq_zero {δ t : ℝ} (hδ : 0 < δ) (ht : t ≤ 1 ∨ 16 ≤ t) :
    typeIIWindowSmooth δ t = 0 := by
  rcases ht with ht | ht
  · rw [typeIIWindowSmooth, Real.smoothTransition.zero_of_nonpos
      (show (t - 1) / δ ≤ 0 from div_nonpos_of_nonpos_of_nonneg (by linarith) hδ.le), zero_mul]
  · rw [typeIIWindowSmooth, Real.smoothTransition.zero_of_nonpos
      (show (16 - t) / δ ≤ 0 from div_nonpos_of_nonpos_of_nonneg (by linarith) hδ.le), mul_zero]

theorem typeII_window_smooth_contDiff (δ : ℝ) :
    ContDiff ℝ ∞ (typeIIWindowSmooth δ) := by
  unfold typeIIWindowSmooth
  fun_prop

theorem typeII_window_smooth_hasCompactSupport {δ : ℝ} (hδ : 0 < δ) :
    HasCompactSupport (typeIIWindowSmooth δ) := by
  apply HasCompactSupport.intro (isCompact_Icc : IsCompact (Icc (1 : ℝ) 16))
  intro t ht
  by_cases hlo : t ≤ 1
  · exact typeII_window_smooth_eq_zero hδ (Or.inl hlo)
  · exact typeII_window_smooth_eq_zero hδ (Or.inr (le_of_lt
      (lt_of_not_ge (fun h => ht ⟨le_of_lt (lt_of_not_ge hlo), h⟩))))

theorem typeII_window_smooth_eq_one {δ t : ℝ} (hδ : 0 < δ)
    (ht : t ∈ Icc (1 + δ) (16 - δ)) : typeIIWindowSmooth δ t = 1 := by
  have h1 : 1 ≤ (t - 1) / δ := (le_div_iff₀ hδ).mpr (by linarith [ht.1])
  have h2 : 1 ≤ (16 - t) / δ := (le_div_iff₀ hδ).mpr (by linarith [ht.2])
  rw [typeIIWindowSmooth, Real.smoothTransition.one_of_one_le h1,
    Real.smoothTransition.one_of_one_le h2, mul_one]

theorem typeII_window_smooth_support {δ t : ℝ} (hδ : 0 < δ)
    (ht : typeIIWindowSmooth δ t ≠ 0) : t ∈ Ioo 1 16 := by
  exact ⟨lt_of_not_ge (fun h => ht (typeII_window_smooth_eq_zero hδ (Or.inl h))),
    lt_of_not_ge (fun h => ht (typeII_window_smooth_eq_zero hδ (Or.inr h)))⟩

theorem typeII_window_smooth_eq_sharp_off_collar {δ t : ℝ} (hδ : 0 < δ)
    (ht : t ∉ typeIIWindowCollar δ) : typeIIWindowSmooth δ t = typeIISharpWindow t := by
  by_cases hw : 1 < t ∧ t ≤ 16
  · have hlo : 1 + δ ≤ t := by
      by_contra h
      apply ht
      exact Or.inl ⟨by linarith [hw.1], by linarith⟩
    have hhi : t ≤ 16 - δ := by
      by_contra h
      apply ht
      exact Or.inr ⟨by linarith, by linarith [hw.2]⟩
    rw [typeII_window_smooth_eq_one hδ ⟨hlo, hhi⟩, typeIISharpWindow, if_pos hw]
  · have hout : t ≤ 1 ∨ 16 ≤ t := by
      by_cases h1 : t ≤ 1
      · exact Or.inl h1
      · exact Or.inr (le_of_lt (lt_of_not_ge (fun h => hw ⟨lt_of_not_ge h1, h⟩)))
    rw [typeII_window_smooth_eq_zero hδ hout, typeIISharpWindow, if_neg hw]

theorem typeII_window_smooth_discrepancy_le {δ t : ℝ} (hδ : 0 < δ) :
    |typeIIWindowSmooth δ t - typeIISharpWindow t| ≤
      (by classical exact if t ∈ typeIIWindowCollar δ then 1 else 0) := by
  classical
  by_cases ht : t ∈ typeIIWindowCollar δ
  · rw [if_pos ht]
    have hb := typeII_window_smooth_bounds δ t
    unfold typeIISharpWindow
    split_ifs <;> rw [abs_le] <;> constructor <;> linarith
  · rw [if_neg ht, typeII_window_smooth_eq_sharp_off_collar hδ ht, sub_self, abs_zero]

theorem typeII_window_ratio_sharp {x : ℝ} (hx : 0 < x) (u : ℕ) :
    typeIISharpWindow ((u : ℝ) / x) = if u ∈ arithmeticProductWindow 1 x then 1 else 0 := by
  have heq : (1 < (u : ℝ) / x ∧ (u : ℝ) / x ≤ 16) ↔ u ∈ arithmeticProductWindow 1 x := by
    rw [mem_arithmeticProductWindow_iff one_ne_zero]
    simp only [one_mul, lt_div_iff₀ hx, div_le_iff₀ hx]
  simp only [typeIISharpWindow, heq]

theorem typeII_window_smooth_ratio_eq_off_boundary {x δ : ℝ} (hx : 0 < x)
    (hδ : 0 < δ) {u : ℕ} (hu : u ∉ typeIIBoundaryWindow x δ) :
    typeIIWindowSmooth δ ((u : ℝ) / x) = if u ∈ arithmeticProductWindow 1 x then 1 else 0 := by
  rw [← typeII_window_ratio_sharp hx u]
  apply typeII_window_smooth_eq_sharp_off_collar hδ
  intro ht
  apply hu
  apply (mem_typeII_boundary_window_iff hx.le hδ.le).mpr
  rcases ht with ht | ht
  · exact Or.inl ⟨(le_div_iff₀ hx).mp ht.1, (div_le_iff₀ hx).mp ht.2⟩
  · exact Or.inr ⟨(le_div_iff₀ hx).mp ht.1, (div_le_iff₀ hx).mp ht.2⟩

end Bounty
end

section

/- Uniform control of the small-prime extraction, including its exceptional set. -/

open Finset

namespace Bounty

theorem physical_omega_le_two_log {G : Type*} (P : G → Finset ℕ) (g : G)
    (hP : ∀ p ∈ P g, p.Prime) {n : ℕ} (hn : 0 < n) :
    (physicalOmega P g (n : ℤ) : ℝ) ≤ 2 * Real.log n := by
  apply le_trans _ (primeFactors_card_le_two_log hn)
  apply Nat.cast_le.mpr
  apply card_le_card
  intro p hp
  obtain ⟨hp, hpn⟩ := mem_filter.mp hp
  exact (hP p hp).mem_primeFactors (Int.natCast_dvd_natCast.mp hpn) hn.ne'

noncomputable def markedPrimePeel {G : Type*} [DecidableEq G]
    (groups : Finset G) (P : G → Finset ℕ) (q : ℝ) (V : G → ℝ)
    (t : G → ℕ) (g : G) (k : ℕ) (f : ℕ → ℂ) (n : ℕ) : ℂ :=
  (1 / (V g : ℂ)) * ∑ p ∈ P g, if p ∣ n then
    (markedDivisorWeight groups P q V (Function.update t g k) ((n / p : ℕ) : ℤ) : ℂ) *
      f (n / p) else 0

theorem marked_prime_peel_exact {G : Type*} [DecidableEq G]
    (groups : Finset G) (P : G → Finset ℕ) (q : ℝ) (V : G → ℝ) (t : G → ℕ)
    (hprime : ∀ g ∈ groups, ∀ p ∈ P g, p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (g : G) (hg : g ∈ groups) (k : ℕ) (ht : t g = k + 1) (n : ℕ)
    (hsq : ∀ p ∈ P g, ¬ p ^ 2 ∣ n) (f : ℕ → ℂ)
    (hf : ∀ p ∈ P g, p ∣ n → f (n / p) = f n) :
    (markedDivisorWeight groups P q V t (n : ℤ) : ℂ) * f n =
      markedPrimePeel groups P q V t g k f n := by
  rw [marked_divisor_weight_remove_prime groups P q V t hprime hdis g hg k ht n hsq]
  unfold markedPrimePeel
  push_cast
  rw [mul_assoc, sum_mul]
  congr 1
  apply sum_congr rfl
  intro p hp
  by_cases hpn : p ∣ n
  · simp only [if_pos hpn, hf p hp hpn]
  · simp only [if_neg hpn, Complex.ofReal_zero, zero_mul]

theorem marked_prime_peel_norm_le {G : Type*} [DecidableEq G]
    (groups : Finset G) (P : G → Finset ℕ) {q v : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v)
    (V : G → ℝ) (t : G → ℕ) (T : ℕ)
    (hV : ∀ g ∈ groups, v ≤ V g) (ht : ∀ g ∈ groups, t g ≤ T)
    (g : G) (hg : g ∈ groups) (k : ℕ) (hk : k ≤ t g)
    (f : ℕ → ℂ) (n : ℕ) (hf : ∀ p ∈ P g, p ∣ n → f (n / p) = f n) :
    ‖markedPrimePeel groups P q V t g k f n‖ ≤
      ((physicalOmega P g (n : ℤ) : ℝ) / v) *
        (markedDivisorBound q v T) ^ groups.card * ‖f n‖ := by
  classical
  have ht' : ∀ h ∈ groups, Function.update t g k h ≤ T := by
    intro h hh
    by_cases he : h = g
    · subst h
      simpa only [Function.update_self] using hk.trans (ht g hg)
    · simpa only [Function.update_of_ne he] using ht h hh
  have hV0 : ∀ h ∈ groups, 0 ≤ V h := fun h hh => hv.le.trans (hV h hh)
  have hVg : 0 < V g := hv.trans_le (hV g hg)
  have hnorm (p : ℕ) :
      ‖(markedDivisorWeight groups P q V (Function.update t g k) ((n / p : ℕ) : ℤ) : ℂ)‖ ≤
        (markedDivisorBound q v T) ^ groups.card := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg
      (marked_divisor_weight_nonneg groups P hq0 V _ hV0 _)]
    exact marked_divisor_weight_le_pow groups P hq0 hq1 hv V _ T hV ht' _
  have hc : (((P g).filter (fun p => p ∣ n)).card : ℝ) =
      (physicalOmega P g (n : ℤ) : ℝ) := by
    simp only [physicalOmega, physicalDivisorPool, Int.natCast_dvd_natCast]
  unfold markedPrimePeel
  rw [← sum_filter, norm_mul, norm_div, norm_one, Complex.norm_real,
    Real.norm_eq_abs, abs_of_pos hVg]
  calc
    _ ≤ (1 / V g) * ∑ p ∈ (P g).filter (fun p => p ∣ n),
        ‖(markedDivisorWeight groups P q V (Function.update t g k) ((n / p : ℕ) : ℤ) : ℂ) *
          f (n / p)‖ := mul_le_mul_of_nonneg_left (norm_sum_le _ _) (by positivity)
    _ ≤ (1 / V g) * ∑ _p ∈ (P g).filter (fun p => p ∣ n),
        (markedDivisorBound q v T) ^ groups.card * ‖f n‖ := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      apply sum_le_sum
      intro p hp
      rw [norm_mul, hf p (mem_filter.mp hp).1 (mem_filter.mp hp).2]
      exact mul_le_mul_of_nonneg_right (hnorm p) (norm_nonneg _)
    _ = (1 / V g) * ((physicalOmega P g (n : ℤ) : ℝ) *
        ((markedDivisorBound q v T) ^ groups.card * ‖f n‖)) := by
      rw [sum_const, nsmul_eq_mul, hc]
    _ ≤ (1 / v) * ((physicalOmega P g (n : ℤ) : ℝ) *
        ((markedDivisorBound q v T) ^ groups.card * ‖f n‖)) := by
      apply mul_le_mul_of_nonneg_right (one_div_le_one_div_of_le hv (hV g hg))
      exact mul_nonneg (by positivity)
        (mul_nonneg (pow_nonneg (zero_le_one.trans (one_le_markedDivisorBound q v T)) _) (norm_nonneg _))
    _ = _ := by ring

theorem marked_prime_peel_error_norm_le {G : Type*} [DecidableEq G]
    (groups : Finset G) (P : G → Finset ℕ) {q v : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v)
    (V : G → ℝ) (t : G → ℕ) (T : ℕ)
    (hV : ∀ g ∈ groups, v ≤ V g) (ht : ∀ g ∈ groups, t g ≤ T)
    (g : G) (hg : g ∈ groups) (k : ℕ) (hk : k ≤ t g)
    (hP : ∀ p ∈ P g, p.Prime) (f : ℕ → ℂ) (n N : ℕ)
    (hn : 0 < n) (hN : n ≤ N) (hf : ∀ p ∈ P g, p ∣ n → f (n / p) = f n) :
    ‖(markedDivisorWeight groups P q V t (n : ℤ) : ℂ) * f n -
      markedPrimePeel groups P q V t g k f n‖ ≤
      ((markedDivisorBound q v T) ^ groups.card * (1 + 2 * Real.log N / v)) * ‖f n‖ := by
  have hV0 : ∀ h ∈ groups, 0 ≤ V h := fun h hh => hv.le.trans (hV h hh)
  have hw : ‖(markedDivisorWeight groups P q V t (n : ℤ) : ℂ)‖ ≤
      (markedDivisorBound q v T) ^ groups.card := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg
      (marked_divisor_weight_nonneg groups P hq0 V t hV0 _)]
    exact marked_divisor_weight_le_pow groups P hq0 hq1 hv V t T hV ht _
  have homega := physical_omega_le_two_log P g hP hn
  have hlog := Real.log_le_log (Nat.cast_pos.mpr hn) (Nat.cast_le.mpr hN)
  have hsize : (physicalOmega P g (n : ℤ) : ℝ) / v ≤ 2 * Real.log N / v :=
    div_le_div_of_nonneg_right (homega.trans (by linarith)) hv.le
  calc
    _ ≤ ‖(markedDivisorWeight groups P q V t (n : ℤ) : ℂ) * f n‖ +
        ‖markedPrimePeel groups P q V t g k f n‖ := norm_sub_le _ _
    _ ≤ (markedDivisorBound q v T) ^ groups.card * ‖f n‖ +
        (((physicalOmega P g (n : ℤ) : ℝ) / v) *
          (markedDivisorBound q v T) ^ groups.card * ‖f n‖) := by
      apply add_le_add
      · rw [norm_mul]
        exact mul_le_mul_of_nonneg_right hw (norm_nonneg _)
      · exact marked_prime_peel_norm_le groups P hq0 hq1 hv V t T hV ht g hg k hk f n hf
    _ ≤ (markedDivisorBound q v T) ^ groups.card * ‖f n‖ +
        ((2 * Real.log N / v) * (markedDivisorBound q v T) ^ groups.card * ‖f n‖) := by
      apply add_le_add le_rfl
      apply mul_le_mul_of_nonneg_right _ (norm_nonneg _)
      exact mul_le_mul_of_nonneg_right hsize
        (pow_nonneg (zero_le_one.trans (one_le_markedDivisorBound q v T)) _)
    _ = _ := by ring

end Bounty
end

section

/- The partial residue/run factorization is valid before any new-mark count is imposed. -/

open Finset
open scoped Classical
namespace Bounty
section Factor
variable {G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Finset ℕ} [∀ a : PhysicalPrime P, NeZero a.2.val] {J ell : ℕ}
  (groups : Finset G) (V : G → ℝ) (L : ℕ → PhysicalMarkLists P J ell) (n : ℕ)
  (h : (a : PhysicalPrime P) → ℕ → ZMod a.2.val) (η : ℕ → ℝ) (b : PhysicalPrime P → ℝ)
  (hb : ∀ a : PhysicalPrime P, a.1 ∈ groups → b a = 1 - (∑ j ∈ range (n + 1), η j) / a.2.val)
  (hb0 : ∀ a : PhysicalPrime P, a.1 ∈ groups → b a ≠ 0)

include hb hb0 in
theorem physical_group_run_residue_factor :
    (∏ a ∈ physicalPrimeGroups P groups, b a) *
      (∏ a ∈ physicalPrimeGroups P groups,
        ghostPhaseRunHistory (fun j => decide (a ∈ physicalMarkedPrimes (L j)))
          (h a) η ((a.2.val : ℝ) * b a)⁻¹ (V a.1) n) =
    (∏ a ∈ physicalPrimeGroups P groups,
      (V a.1)⁻¹ ^ ghostPhaseRunCount (fun j => decide (a ∈ physicalMarkedPrimes (L j))) n) *
    poolPathResidueExpectation (fun a : PhysicalPrime P => a.2.val)
      (physicalPrimeGroups P groups) (range (n + 1))
      (fun a => (range (n + 1)).filter (fun j => a ∈ physicalMarkedPrimes (L j))) h η := by
  unfold poolPathResidueExpectation
  rw [← prod_mul_distrib, ← prod_mul_distrib]
  apply prod_congr rfl
  intro a ha
  have hag : a.1 ∈ groups := by simpa [physicalPrimeGroups] using ha
  simpa only [ZMod.card, decide_eq_true_eq] using
    ghost_phase_run_history_residue_identity
      (fun j => decide (a ∈ physicalMarkedPrimes (L j))) (h a) η (V a.1) n (b a)
      (by simpa only [ZMod.card] using hb a hag) (hb0 a hag)

include hb hb0 in
theorem physical_partial_run_residue_factor :
    (∏ a ∈ physicalPrimeGroups P groups, b a) *
      (poolPathResidueExpectation (fun a : PhysicalPrime P => a.2.val)
        (physicalPrimeGroups P groupsᶜ) (range (n + 1))
        (fun a => (range (n + 1)).filter (fun j => a ∈ physicalMarkedPrimes (L j))) h η *
        ∏ a ∈ physicalPrimeGroups P groups,
          ghostPhaseRunHistory (fun j => decide (a ∈ physicalMarkedPrimes (L j)))
            (h a) η ((a.2.val : ℝ) * b a)⁻¹ (V a.1) n) =
    (∏ a ∈ physicalPrimeGroups P groups,
      (V a.1)⁻¹ ^ ghostPhaseRunCount (fun j => decide (a ∈ physicalMarkedPrimes (L j))) n) *
    poolPathResidueExpectation (fun a : PhysicalPrime P => a.2.val) univ (range (n + 1))
      (fun a => (range (n + 1)).filter (fun j => a ∈ physicalMarkedPrimes (L j))) h η := by
  have hs := physical_prime_groups_split groups (fun a : PhysicalPrime P =>
    (∑ r, activeResidueWeight (range (n + 1))
      ((range (n + 1)).filter (fun j => a ∈ physicalMarkedPrimes (L j))) (h a) η r) / (a.2.val : ℝ))
  change poolPathResidueExpectation _ univ _ _ _ _ =
    poolPathResidueExpectation _ (physicalPrimeGroups P groups) _ _ _ _ *
      poolPathResidueExpectation _ (physicalPrimeGroups P groupsᶜ) _ _ _ _ at hs
  rw [hs]
  have hr := physical_group_run_residue_factor groups V L n h η b hb hb0
  linear_combination
    poolPathResidueExpectation (fun a : PhysicalPrime P => a.2.val)
      (physicalPrimeGroups P groupsᶜ) (range (n + 1))
      (fun a => (range (n + 1)).filter (fun j => a ∈ physicalMarkedPrimes (L j))) h η * hr

include hb hb0 in
theorem physical_partial_run_residue_zero
    (hz : poolPathResidueExpectation (fun a : PhysicalPrime P => a.2.val) univ (range (n + 1))
      (fun a => (range (n + 1)).filter (fun j => a ∈ physicalMarkedPrimes (L j))) h η = 0) :
    poolPathResidueExpectation (fun a : PhysicalPrime P => a.2.val)
      (physicalPrimeGroups P groupsᶜ) (range (n + 1))
      (fun a => (range (n + 1)).filter (fun j => a ∈ physicalMarkedPrimes (L j))) h η *
      (∏ a ∈ physicalPrimeGroups P groups,
        ghostPhaseRunHistory (fun j => decide (a ∈ physicalMarkedPrimes (L j)))
          (h a) η ((a.2.val : ℝ) * b a)⁻¹ (V a.1) n) = 0 := by
  have he := physical_partial_run_residue_factor groups V L n h η b hb hb0
  rw [hz, mul_zero] at he
  exact (mul_eq_zero.mp he).resolve_left (prod_ne_zero_iff.mpr (fun a ha =>
    hb0 a (by simpa [physicalPrimeGroups] using ha)))

end Factor
end Bounty
end

section

/- Common full-slot birth data are the exact original event data extended by none. -/

open Classical
namespace Bounty
section Event
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ)
  (tag : Option (J ⊕ K))
  (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
  (e : FullPermutationMixedEvent n S B A Δ D tag s)

noncomputable def fullMixedCommonEventBornData : FullMixedCommonLocalAddress M B tag → Option (FullMixedBornData n) :=
  optionalBirthExtension (fullMixedCommonLocalEmbedding S B tag) (fullMixedEventBornData n S B A Δ D tag s e)

noncomputable def fullMixedCommonEventBirthLabel (a : FullMixedCommonLocalAddress M B tag) :
    Option ((g : Fin N) × P g) :=
  (fullMixedCommonEventBornData n S B A Δ D tag s e a).map (fullMixedBornPrime n)

noncomputable def fullMixedCommonEventBirthPerformed (a : FullMixedCommonLocalAddress M B tag) : Prop :=
  (fullMixedCommonEventBornData n S B A Δ D tag s e a).isSome = true

theorem full_mixed_common_event_data_embed (a : FullMixedLocalBirthAddress S B tag) :
    fullMixedCommonEventBornData n S B A Δ D tag s e (fullMixedCommonLocalEmbedding S B tag a) =
      fullMixedEventBornData n S B A Δ D tag s e a :=
  optional_birth_extension_apply _ _ _

theorem full_mixed_common_event_label_embed (a : FullMixedLocalBirthAddress S B tag) :
    fullMixedCommonEventBirthLabel n S B A Δ D tag s e (fullMixedCommonLocalEmbedding S B tag a) =
      fullMixedEventBirthLabel n S B A Δ D tag s e a := by
  unfold fullMixedCommonEventBirthLabel fullMixedEventBirthLabel
  rw [full_mixed_common_event_data_embed]

theorem full_mixed_common_event_performed_embed (a : FullMixedLocalBirthAddress S B tag) :
    fullMixedCommonEventBirthPerformed n S B A Δ D tag s e (fullMixedCommonLocalEmbedding S B tag a) ↔
      fullMixedEventBirthPerformed n S B A Δ D tag s e a := by
  unfold fullMixedCommonEventBirthPerformed fullMixedEventBirthPerformed
  rw [full_mixed_common_event_data_embed]

theorem full_mixed_common_event_performed_iff (a : FullMixedCommonLocalAddress M B tag) :
    fullMixedCommonEventBirthPerformed n S B A Δ D tag s e a ↔
      ∃ b, fullMixedCommonLocalEmbedding S B tag b = a ∧ fullMixedEventBirthPerformed n S B A Δ D tag s e b :=
  optional_birth_extension_performed_iff _ _ _

theorem full_mixed_common_event_label_extension (a : FullMixedCommonLocalAddress M B tag) :
    fullMixedCommonEventBirthLabel n S B A Δ D tag s e a =
      optionalBirthExtension (fullMixedCommonLocalEmbedding S B tag)
        (fullMixedEventBirthLabel n S B A Δ D tag s e) a :=
  optional_birth_extension_map _ _ _ _

theorem full_mixed_common_event_label_present (a : FullMixedCommonLocalAddress M B tag) :
    fullMixedCommonEventBirthPerformed n S B A Δ D tag s e a ↔
      (fullMixedCommonEventBirthLabel n S B A Δ D tag s e a).isSome = true := by
  simp only [fullMixedCommonEventBirthPerformed, fullMixedCommonEventBirthLabel, Option.isSome_map]

end Event
end Bounty
end

section

/- Finite endpoint-energy control of the additive/logarithmic kernel replacement. -/

open Finset MeasureTheory
open scoped NNReal

namespace Bounty

theorem finite_local_kernel_error_pointwise (S : Finset ℕ) (a : ℕ → ℂ)
    {K : ℝ → ℂ} {C : ℝ≥0} (hK : LipschitzWith C K)
    (hsupp : ∀ t, 1 < |t| → K t = 0) (hS : ∀ n ∈ S, 0 < n)
    {Y H v : ℝ} (hY : 0 < Y) (hH : 0 < H) (hsmall : H ≤ Y/8) (hv : Y/2 ≤ v) :
    ‖∑ n ∈ S, a n * (K (((n:ℝ)-v)/H) - K (v*Real.log ((n:ℝ)/v)/H))‖^2 ≤
      (4*H+1) * ((C:ℝ)* (16*H/Y))^2 *
        ∑ n ∈ S.filter (fun (n : ℕ) => |(n:ℝ)-v| ≤ 2*H), ‖a n‖^2 := by
  classical
  let T := S.filter (fun (n : ℕ) => |(n:ℝ)-v| ≤ 2*H)
  let b : ℕ → ℂ := fun n => K (((n:ℝ)-v)/H) - K (v*Real.log ((n:ℝ)/v)/H)
  have hv0 : 0 < v := by linarith
  have hHv : H ≤ v := by linarith
  have heq : (∑ n ∈ S, a n*b n) = ∑ n ∈ T, a n*b n := by
    symm
    apply sum_subset (filter_subset _ _)
    intro n hn hnt
    have hz : b n = 0 := by
      by_contra hne
      apply hnt
      exact mem_filter.mpr ⟨hn, additive_log_kernel_difference_support hsupp
        (by exact_mod_cast hS n hn) hv0 hH hHv hne⟩
    rw [hz, mul_zero]
  change ‖∑ n ∈ S, a n*b n‖^2 ≤ _
  rw [heq]
  have hb : ∀ n ∈ T, ‖b n‖ ≤ (C:ℝ)*(16*H/Y) := by
    intro n hn
    have hp := lipschitz_log_kernel_comparison hK hY hH (by norm_num : 0 ≤ (2:ℝ))
      hv (by linarith : 2*H≤Y/4) (mem_filter.mp hn).2
    convert hp using 1; ring
  have hcf : 0 ≤ (C:ℝ)*(16*H/Y) := by positivity
  have he := finite_complex_kernel_error_bound T a b hcf hb
  apply he.trans
  have hc := short_nat_interval_card S hH.le (v := v)
  exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hc (sq_nonneg _))
    (sum_nonneg (fun n _ => sq_nonneg _))


theorem finite_local_kernel_error_integral (S : Finset ℕ) (a : ℕ → ℂ)
    {K : ℝ → ℂ} {C : ℝ≥0} (hK : LipschitzWith C K)
    (hsupp : ∀ t, 1 < |t| → K t = 0) (hS : ∀ n ∈ S, 0 < n)
    {Y H : ℝ} (hY : 0 < Y) (hH : 0 < H) (hsmall : H ≤ Y/8) :
    (∫ v in Set.Icc (Y/2) (3*Y),
      ‖∑ n ∈ S, a n * (K (((n:ℝ)-v)/H) - K (v*Real.log ((n:ℝ)/v)/H))‖^2) ≤
      (4*H+1) * ((C:ℝ)*(16*H/Y))^2 * (4*H) * (∑ n ∈ S, ‖a n‖^2) := by
  classical
  let b : ℕ → ℝ → ℝ := fun n =>
    (Set.Icc ((n:ℝ)-2*H) ((n:ℝ)+2*H)).indicator (fun _ => ‖a n‖^2)
  have hi (n : ℕ) : Integrable (b n) := by
    exact (continuous_const.integrableOn_Icc).integrable_indicator measurableSet_Icc
  have hn (n : ℕ) (v : ℝ) : 0 ≤ b n v := by
    dsimp only [b]
    exact Set.indicator_nonneg (fun _ _ => sq_nonneg _) _
  have hb (v : ℝ) :
      (∑ n ∈ S.filter (fun (n : ℕ) => |(n:ℝ)-v| ≤ 2*H), ‖a n‖^2) =
        ∑ n ∈ S, b n v := by
    rw [sum_filter]
    apply sum_congr rfl
    intro n hn
    have he : |(n:ℝ)-v| ≤ 2*H ↔ v ∈ Set.Icc ((n:ℝ)-2*H) ((n:ℝ)+2*H) := by
      rw [abs_le, Set.mem_Icc]
      constructor <;> intro h <;> constructor <;> linarith [h.1,h.2]
    simp only [b, Set.indicator_apply, he]
  have hsum : Integrable (fun v => ∑ n ∈ S, b n v) := integrable_finsetSum S (fun n _ => hi n)
  have hint : (∫ v : ℝ, ∑ n ∈ S, b n v) = 4*H*(∑ n ∈ S, ‖a n‖^2) := by
    rw [integral_finsetSum S (fun n _ => hi n), mul_sum]
    apply sum_congr rfl
    intro n hn
    dsimp only [b]
    rw [integral_indicator_const _ measurableSet_Icc,
      Real.volume_real_Icc_of_le (by linarith : (n:ℝ)-2*H≤(n:ℝ)+2*H), smul_eq_mul]
    ring
  have hcoef : 0 ≤ (4*H+1)*((C:ℝ)*(16*H/Y))^2 := by positivity
  calc
    _ ≤ ∫ v in Set.Icc (Y/2) (3*Y),
        (4*H+1)*((C:ℝ)*(16*H/Y))^2*(∑ n ∈ S, b n v) := by
      apply integral_mono_of_nonneg (Filter.Eventually.of_forall (fun v => sq_nonneg _))
        ((hsum.const_mul _).integrableOn)
      filter_upwards [ae_restrict_mem measurableSet_Icc] with v hv
      rw [← hb]
      exact finite_local_kernel_error_pointwise S a hK hsupp hS hY hH hsmall hv.1
    _ = (4*H+1)*((C:ℝ)*(16*H/Y))^2 *
        (∫ v in Set.Icc (Y/2) (3*Y), ∑ n ∈ S, b n v) := integral_const_mul _ _
    _ ≤ (4*H+1)*((C:ℝ)*(16*H/Y))^2 * (∫ v : ℝ, ∑ n ∈ S, b n v) := by
      apply mul_le_mul_of_nonneg_left _ hcoef
      exact setIntegral_le_integral hsum (Filter.Eventually.of_forall (fun v =>
        sum_nonneg (fun n _ => hn n v)))
    _ = _ := by rw [hint]; ring

end Bounty
end

section

/- Exact Mellin representation of the variable-scale logarithmic convolution. -/

open Finset MeasureTheory
open scoped FourierTransform

namespace Bounty

noncomputable def localMellinPolynomial (S : Finset ℕ) (a : ℕ → ℂ) (t : ℝ) : ℂ :=
  ∑ n ∈ S, a n * Complex.exp (((t * Real.log n : ℝ) : ℂ) * Complex.I)

noncomputable def localLogConvolution (S : Finset ℕ) (a : ℕ → ℂ) (H v : ℝ) : ℂ :=
  ∑ n ∈ S, a n * localMellinKernelSchwartz (v * Real.log ((n:ℝ)/v) / H)

theorem local_kernel_fourier_inversion (x : ℝ) :
    localMellinKernelSchwartz x =
      ∫ ξ : ℝ, Complex.exp (((2*Real.pi*ξ*x:ℝ):ℂ)*Complex.I) *
        𝓕 localMellinKernelSchwartz ξ := by
  have hi := congrArg (fun f : SchwartzMap ℝ ℂ => f x)
    (FourierPair.fourierInv_fourier_eq (E := SchwartzMap ℝ ℂ) (F := SchwartzMap ℝ ℂ)
      localMellinKernelSchwartz)
  rw [SchwartzMap.fourierInv_coe, Real.fourierInv_eq'] at hi
  change (∫ ξ : ℝ, Complex.exp (((2*Real.pi*inner ℝ ξ x:ℝ):ℂ)*Complex.I) •
    𝓕 localMellinKernelSchwartz ξ) = localMellinKernelSchwartz x at hi
  rw [← hi]
  apply integral_congr_ae
  filter_upwards [] with ξ
  simp only [RCLike.inner_apply, starRingEnd_apply, star_trivial, smul_eq_mul]
  congr 2
  push_cast
  ring

theorem local_kernel_scaled_fourier_inversion (x : ℝ) {c : ℝ} (hc : 0 < c) :
    localMellinKernelSchwartz x = (c:ℂ) *
      ∫ t : ℝ, Complex.exp (((2*Real.pi*(c*t)*x:ℝ):ℂ)*Complex.I) *
        𝓕 localMellinKernelSchwartz (c*t) := by
  have hs := Measure.integral_comp_mul_left
    (fun ξ : ℝ => Complex.exp (((2*Real.pi*ξ*x:ℝ):ℂ)*Complex.I) *
      𝓕 localMellinKernelSchwartz ξ) c
  rw [abs_of_pos (inv_pos.mpr hc), ← local_kernel_fourier_inversion, Complex.real_smul] at hs
  rw [hs]
  push_cast
  field_simp [Complex.ofReal_ne_zero.mpr hc.ne']

theorem local_kernel_logarithmic_inversion {w v H : ℝ}
    (hw : 0 < w) (hv : 0 < v) (hH : 0 < H) :
    localMellinKernelSchwartz (v*Real.log (w/v)/H) =
      ((H/(2*Real.pi*v):ℝ):ℂ) * ∫ t : ℝ,
        Complex.exp (((-t*Real.log v:ℝ):ℂ)*Complex.I) *
          Complex.exp (((t*Real.log w:ℝ):ℂ)*Complex.I) *
            𝓕 localMellinKernelSchwartz ((H/(2*Real.pi*v))*t) := by
  rw [local_kernel_scaled_fourier_inversion _ (show 0 < H/(2*Real.pi*v) by positivity)]
  congr 1
  apply integral_congr_ae
  filter_upwards [] with t
  rw [← Complex.exp_add, Real.log_div hw.ne' hv.ne']
  congr 2
  push_cast
  field_simp [Complex.ofReal_ne_zero.mpr hH.ne', Complex.ofReal_ne_zero.mpr hv.ne']
  ring

theorem local_mellin_representation (S : Finset ℕ) (a : ℕ → ℂ)
    (hS : ∀ n ∈ S, 0 < n) {v H : ℝ} (hv : 0 < v) (hH : 0 < H) :
    localLogConvolution S a H v = ((H/(2*Real.pi*v):ℝ):ℂ) *
      ∫ t : ℝ, Complex.exp (((-t*Real.log v:ℝ):ℂ)*Complex.I) *
        localMellinPolynomial S a t * 𝓕 localMellinKernelSchwartz ((H/(2*Real.pi*v))*t) := by
  let c : ℝ := H/(2*Real.pi*v)
  have hc : 0 < c := by dsimp [c]; positivity
  have hint := (𝓕 localMellinKernelSchwartz).integrable.comp_mul_left' hc.ne'
  have hi (n : ℕ) : Integrable (fun t : ℝ => a n *
      (Complex.exp (((-t*Real.log v:ℝ):ℂ)*Complex.I) *
        Complex.exp (((t*Real.log n:ℝ):ℂ)*Complex.I) * 𝓕 localMellinKernelSchwartz (c*t))) := by
    apply (hint.norm.const_mul ‖a n‖).mono'
    · have hh : Continuous (fun t : ℝ => a n *
        (Complex.exp (((-t*Real.log v:ℝ):ℂ)*Complex.I) *
          Complex.exp (((t*Real.log n:ℝ):ℂ)*Complex.I) * 𝓕 localMellinKernelSchwartz (c*t))) := by
        fun_prop
      exact hh.aestronglyMeasurable
    · filter_upwards [] with t
      simp only [norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]
      exact le_rfl
  unfold localLogConvolution
  calc
    _ = (c:ℂ) * ∑ n ∈ S, a n * ∫ t : ℝ,
        Complex.exp (((-t*Real.log v:ℝ):ℂ)*Complex.I) *
          Complex.exp (((t*Real.log n:ℝ):ℂ)*Complex.I) * 𝓕 localMellinKernelSchwartz (c*t) := by
      rw [mul_sum]
      apply sum_congr rfl
      intro n hn
      rw [local_kernel_logarithmic_inversion (by exact_mod_cast hS n hn) hv hH]
      dsimp [c]
      ring
    _ = (c:ℂ) * ∫ t : ℝ, ∑ n ∈ S, a n *
        (Complex.exp (((-t*Real.log v:ℝ):ℂ)*Complex.I) *
          Complex.exp (((t*Real.log n:ℝ):ℂ)*Complex.I) * 𝓕 localMellinKernelSchwartz (c*t)) := by
      rw [integral_finsetSum S (fun n _ => hi n)]
      simp only [integral_const_mul]
    _ = _ := by
      congr 1
      apply integral_congr_ae
      filter_upwards [] with t
      simp only [localMellinPolynomial, mul_sum, sum_mul]
      apply sum_congr rfl
      intro n hn
      ring

end Bounty
end

section

/- Coefficients on designated groups retain exactly their own conditional average. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def groupMarkedListsAtSplit {G : Type*}
    (P : G → Finset ℕ) (t : G → ℕ) (n : ℤ) (S : Finset G) :
    GroupMarkedListsAt P t n ≃
      GroupMarkedListsAt (fun g : S => P g.val) (fun g : S => t g.val) n ×
      GroupMarkedListsAt (fun g : {g // g ∉ S} => P g.val) (fun g : {g // g ∉ S} => t g.val) n := by
  classical
  exact (groupMarkedListsAtEquiv P t n).trans
    ((Equiv.piEquivPiSubtypeProd (fun g => g ∈ S)
      (fun g => Fin (t g) ↪ ↥(physicalDivisorPool P g n))).trans
      (Equiv.prodCongr
        (groupMarkedListsAtEquiv (fun g : S => P g.val) (fun g : S => t g.val) n).symm
        (groupMarkedListsAtEquiv (fun g : {g // g ∉ S} => P g.val)
          (fun g : {g // g ∉ S} => t g.val) n).symm))

theorem group_marked_selected_sum {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (t : G → ℕ) (n : ℤ) (S : Finset G)
    (b : GroupMarkedLists (fun g : S => P g.val) (fun g : S => t g.val) → ℂ) :
    (∑ L : GroupMarkedListsAt P t n, b (fun g : S => L.val g.val)) =
      ∑ x : GroupMarkedListsAt (fun g : S => P g.val) (fun g : S => t g.val) n ×
        GroupMarkedListsAt (fun g : {g // g ∉ S} => P g.val) (fun g : {g // g ∉ S} => t g.val) n,
        b x.1.val := by
  classical
  exact Fintype.sum_equiv (groupMarkedListsAtSplit P t n S) _ _ (fun _ => rfl)

theorem group_marked_selected_card {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (t : G → ℕ) (n : ℤ) (S : Finset G) :
    Nat.card (GroupMarkedListsAt P t n) =
      Nat.card (GroupMarkedListsAt (fun g : S => P g.val) (fun g : S => t g.val) n) *
      Nat.card (GroupMarkedListsAt (fun g : {g // g ∉ S} => P g.val)
        (fun g : {g // g ∉ S} => t g.val) n) := by
  classical
  rw [Nat.card_congr (groupMarkedListsAtSplit P t n S), Nat.card_prod]

theorem weighted_group_marked_sum_selected_average
    {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (q : ℝ) (V : G → ℝ) (t : G → ℕ) (n : ℤ)
    (S : Finset G)
    (b : GroupMarkedLists (fun g : S => P g.val) (fun g : S => t g.val) → ℂ) :
    weightedGroupMarkedSum P q V t n (fun L => b (fun g : S => L g.val)) =
      (markedDivisorWeight univ P q V t n : ℂ) *
        groupMarkedAverage (fun g : S => P g.val) (fun g : S => t g.val) n b := by
  classical
  rw [weightedGroupMarkedSum, group_marked_selected_sum,
    marked_divisor_weight_eq_fiber_mass, group_marked_selected_card P t n S]
  simp only [Complex.ofReal_mul, Complex.ofReal_natCast, Nat.cast_mul,
    Nat.card_eq_fintype_card, groupMarkedAverage]
  by_cases hz : Fintype.card (GroupMarkedListsAt (fun g : S => P g.val) (fun g : S => t g.val) n) = 0
  · let : IsEmpty (GroupMarkedListsAt (fun g : S => P g.val) (fun g : S => t g.val) n) :=
      Fintype.card_eq_zero_iff.mp hz
    simp only [Fintype.sum_empty, mul_zero]
  · have hne : (Fintype.card (GroupMarkedListsAt (fun g : S => P g.val) (fun g : S => t g.val) n) : ℂ) ≠ 0 :=
      Nat.cast_ne_zero.mpr hz
    rw [Fintype.sum_prod_type]
    simp only [sum_const, card_univ, nsmul_eq_mul, ← mul_sum]
    simp only [← Nat.card_eq_fintype_card] at hne ⊢
    field_simp [hne]
    congr 2
    ext L
    simp only [mem_univ]

end Bounty
end

section

/- The actual normalized list average uses only its groups' divisor pools. -/

open Finset

namespace Bounty

theorem group_marked_average_congr_divisor_pools {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (t : G → ℕ) (n m : ℤ) (b : GroupMarkedLists P t → ℂ)
    (hpool : ∀ g, physicalDivisorPool P g n = physicalDivisorPool P g m) :
    groupMarkedAverage P t n b = groupMarkedAverage P t m b := by
  classical
  have hc : Nat.card (GroupMarkedListsAt P t n) = Nat.card (GroupMarkedListsAt P t m) := by
    rw [group_marked_lists_at_card, group_marked_lists_at_card]
    apply prod_congr rfl
    intro g _
    simp only [physicalOmega, hpool g]
  have hp (L : GroupMarkedLists P t) :
      (∀ g s, ((L g s).val : ℤ) ∣ n) ↔ (∀ g s, ((L g s).val : ℤ) ∣ m) := by
    constructor
    · intro h g s
      have hm : (L g s).val ∈ physicalDivisorPool P g n :=
        mem_filter.mpr ⟨(L g s).property, h g s⟩
      rw [hpool g] at hm
      exact (mem_filter.mp hm).2
    · intro h g s
      have hm : (L g s).val ∈ physicalDivisorPool P g m :=
        mem_filter.mpr ⟨(L g s).property, h g s⟩
      rw [← hpool g] at hm
      exact (mem_filter.mp hm).2
  unfold groupMarkedAverage
  simp only [← Nat.card_eq_fintype_card, hc]
  congr 1
  rw [group_marked_sum_eq_indicator, group_marked_sum_eq_indicator]
  apply sum_congr rfl
  intro L _
  simp only [hp L]

theorem group_marked_selected_average_div_prime
    {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (t : G → ℕ) (S : Finset G)
    (hprime : ∀ g ∈ S, ∀ p ∈ P g, p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (g : G) (hg : g ∉ S) {p n : ℕ} (hp : p ∈ P g) (hpr : p.Prime) (hpn : p ∣ n)
    (b : GroupMarkedLists (fun h : S => P h.val) (fun h : S => t h.val) → ℂ) :
    groupMarkedAverage (fun h : S => P h.val) (fun h : S => t h.val) ((n / p : ℕ) : ℤ) b =
      groupMarkedAverage (fun h : S => P h.val) (fun h : S => t h.val) (n : ℤ) b := by
  apply group_marked_average_congr_divisor_pools
  intro h
  have hne : g ≠ h.val := by intro he; exact hg (he.symm ▸ h.property)
  exact physical_divisor_pool_div_other_prime P h.val (hprime h.val h.property)
    hpr (fun hph => disjoint_left.mp (hdis hne) hp hph) hpn

end Bounty
end

section

/- The actual compactly localized Mellin amplitude, with the library Fourier convention. -/

open MeasureTheory
open scoped FourierTransform ContDiff

namespace Bounty

noncomputable def localMellinAmplitude (j : ℕ) (v u : ℝ) : ℂ :=
  ((typeIISmoothRho 2 u * Real.exp (-u) : ℝ) : ℂ) *
    𝓕 localMellinKernelSchwartz (Real.exp (-u)*v/(2*Real.pi)) *
      (((1+v^2)^((j : ℝ)/4) : ℝ) : ℂ)

theorem local_mellin_amplitude_on_log_range (j : ℕ) (v u : ℝ)
    (hu : u ∈ Set.Icc (Real.log (1/2 : ℝ)) (Real.log 3)) :
    localMellinAmplitude j v u = ((Real.exp (-u) : ℝ) : ℂ) *
      𝓕 localMellinKernelSchwartz (Real.exp (-u)*v/(2*Real.pi)) *
        (((1+v^2)^((j : ℝ)/4) : ℝ) : ℂ) := by
  have h2 : Real.log 2 ≤ 1 := by linarith [Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 2)]
  have h3 : Real.log 3 ≤ 2 := by linarith [Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 3)]
  have hh : Real.log (1/2 : ℝ) = -Real.log 2 := by rw [one_div,Real.log_inv]
  have hr : typeIISmoothRho 2 u = 1 := typeII_smooth_rho_eq_one
    ⟨by rw [hh] at hu; linarith [hu.1],by linarith [hu.2]⟩
  rw [localMellinAmplitude,hr,one_mul]

theorem local_mellin_amplitude_contDiff (j : ℕ) (v : ℝ) :
    ContDiff ℝ ∞ (localMellinAmplitude j v) := by
  have hρ := typeII_smooth_rho_contDiff 2
  have hf := (𝓕 localMellinKernelSchwartz).smooth ⊤
  have hc : ContDiff ℝ ∞ (fun x : ℝ => (x : ℂ)) := Complex.ofRealCLM.contDiff
  unfold localMellinAmplitude
  fun_prop

theorem local_mellin_amplitude_zero (j : ℕ) (v u : ℝ)
    (hu : u ∉ Set.Icc (-3) 3) : localMellinAmplitude j v u = 0 := by
  have hρ : typeIISmoothRho 2 u = 0 := by
    apply typeII_smooth_rho_eq_zero
    intro h
    apply hu
    constructor <;> linarith [h.1,h.2]
  simp only [localMellinAmplitude, hρ, zero_mul, Complex.ofReal_zero]

theorem local_mellin_amplitude_compact (j : ℕ) (v : ℝ) :
    HasCompactSupport (localMellinAmplitude j v) :=
  HasCompactSupport.intro isCompact_Icc (fun u hu => local_mellin_amplitude_zero j v u hu)

noncomputable def localMellinAmplitudeSchwartz (j : ℕ) (v : ℝ) : SchwartzMap ℝ ℂ :=
  (local_mellin_amplitude_compact j v).toSchwartzMap (local_mellin_amplitude_contDiff j v)

noncomputable def localMellinAmplitudeFourier (j : ℕ) (s v : ℝ) : ℂ :=
  𝓕 (localMellinAmplitudeSchwartz j v) s

theorem local_mellin_amplitude_inversion (j : ℕ) (u v : ℝ) :
    localMellinAmplitude j v u = ∫ s : ℝ,
      Complex.exp (((2*Real.pi*s*u : ℝ) : ℂ)*Complex.I) * localMellinAmplitudeFourier j s v := by
  have hi := congrArg (fun f : SchwartzMap ℝ ℂ => f u)
    (FourierPair.fourierInv_fourier_eq (E := SchwartzMap ℝ ℂ) (F := SchwartzMap ℝ ℂ)
      (localMellinAmplitudeSchwartz j v))
  rw [SchwartzMap.fourierInv_coe, Real.fourierInv_eq'] at hi
  change (∫ s : ℝ, Complex.exp (((2*Real.pi*inner ℝ s u : ℝ) : ℂ)*Complex.I) •
    𝓕 (localMellinAmplitudeSchwartz j v) s) = localMellinAmplitude j v u at hi
  rw [← hi]
  apply integral_congr_ae
  filter_upwards [] with s
  simp only [localMellinAmplitudeFourier, RCLike.inner_apply, starRingEnd_apply,
    star_trivial, smul_eq_mul]
  congr 2
  push_cast
  ring

end Bounty
end

section

/- A finite stage index reserves stage zero for the initial boundary and the successor stages for actual original events. -/

namespace Bounty
variable {J K : Type*} {N : ℕ} (M : Fin N → ℕ) (B : ℕ)
  (steps : List (Option (J ⊕ K)))

noncomputable def fullMixedCommonIndexStage
    (i : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps))) : Fin (steps.length + 1) :=
  match fullMixedCommonBirthOrder M B steps i with
  | .inl _ => 0
  | .inr a => a.1.succ

theorem full_mixed_common_index_stage_val
    (i : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps))) :
    (fullMixedCommonIndexStage M B steps i).val =
      fullMixedCommonBirthStage M B steps (fullMixedCommonBirthOrder M B steps i) := by
  unfold fullMixedCommonIndexStage
  cases fullMixedCommonBirthOrder M B steps i <;> rfl

theorem full_mixed_common_index_stage_monotone : Monotone (fullMixedCommonIndexStage M B steps) := by
  intro i j hij
  apply Fin.le_iff_val_le_val.mpr
  simp only [full_mixed_common_index_stage_val]
  exact full_mixed_common_order_stage_monotone M B steps hij

theorem full_mixed_common_index_stage_zero_iff
    (i : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps))) :
    fullMixedCommonIndexStage M B steps i = 0 ↔
      ∃ a, fullMixedCommonBirthOrder M B steps i = Sum.inl a := by
  unfold fullMixedCommonIndexStage
  cases h : fullMixedCommonBirthOrder M B steps i with
  | inl a => simp
  | inr a => simp

end Bounty
end

section

open scoped BigOperators ComplexConjugate
open MeasureTheory

namespace Bounty

theorem dirichlet_polynomial_hasDerivAt (s : Finset ℕ) (c : ℕ → ℂ) (t : ℝ) :
    HasDerivAt
      (fun t => ∑ n ∈ s, c n * Complex.exp ((Real.log (n : ℝ) * t : ℝ) * Complex.I))
      (∑ n ∈ s, (c n * ((Real.log (n : ℝ) : ℂ) * Complex.I)) *
        Complex.exp ((Real.log (n : ℝ) * t : ℝ) * Complex.I)) t := by
  apply HasDerivAt.fun_sum
  intro n _
  have hd : HasDerivAt
      (fun y : ℝ => ((Real.log (n : ℝ) : ℂ) * Complex.I) * y)
      ((Real.log (n : ℝ) : ℂ) * Complex.I) t := by
    simpa only [mul_one, id_eq] using!
      ((hasDerivAt_id (t : ℂ)).const_mul ((Real.log (n : ℝ) : ℂ) * Complex.I)).comp_ofReal
  have he := ((Complex.hasDerivAt_exp _).comp t hd).const_mul (c n)
  simpa only [Complex.ofReal_mul, mul_comm, mul_left_comm, mul_assoc, Function.comp_apply] using! he

theorem dirichlet_derivative_coefficient_energy (s : Finset ℕ) (c : ℕ → ℂ) (N : ℕ)
    (hs : ∀ n ∈ s, 1 ≤ n ∧ n ≤ N) :
    (∑ n ∈ s, ‖c n * ((Real.log (n : ℝ) : ℂ) * Complex.I)‖ ^ 2) ≤
      (Real.log N) ^ 2 * ∑ n ∈ s, ‖c n‖ ^ 2 := by
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro n hn
  have hn1 : (1 : ℝ) ≤ n := by exact_mod_cast (hs n hn).1
  have hn0 : (0 : ℝ) < n := zero_lt_one.trans_le hn1
  have hlog0 := Real.log_nonneg hn1
  have hlog := Real.log_le_log hn0 (show (n : ℝ) ≤ N by exact_mod_cast (hs n hn).2)
  simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hlog0,
    Complex.norm_I, mul_one, mul_pow]
  have hsq := (sq_le_sq₀ hlog0 (hlog0.trans hlog)).mpr hlog
  nlinarith [mul_le_mul_of_nonneg_left hsq (sq_nonneg ‖c n‖)]

end Bounty
end

section

open Finset
open scoped ComplexConjugate

namespace Bounty

noncomputable def integerIntervalPhase (a b : ℤ) (φ : ℝ → ℝ) (n : ℤ) : ℂ :=
  if n ∈ Icc a b then Complex.exp ((φ (n:ℝ):ℂ)*Complex.I) else 0

theorem integer_interval_phase_support (a b : ℤ) (φ : ℝ → ℝ) (n : ℤ)
    (hn : n ∉ Icc a b) : integerIntervalPhase a b φ n = 0 := by
  simp only [integerIntervalPhase, if_neg hn]

theorem integer_interval_phase_norm (a b : ℤ) (φ : ℝ → ℝ) (n : ℤ) :
    ‖integerIntervalPhase a b φ n‖ ≤ 1 := by
  unfold integerIntervalPhase
  split_ifs
  · rw [Complex.norm_exp_ofReal_mul_I]
  · simp only [norm_zero, zero_le_one]

theorem integer_interval_phase_sum (a b : ℤ) (φ : ℝ → ℝ) :
    (∑ n ∈ Icc a b, integerIntervalPhase a b φ n) =
      ∑ n ∈ Icc a b, Complex.exp ((φ (n:ℝ):ℂ)*Complex.I) := by
  apply sum_congr rfl
  intro n hn
  simp only [integerIntervalPhase, if_pos hn]

theorem integer_interval_phase_correlation (a b h : ℤ) (φ : ℝ → ℝ) (hh : 0 ≤ h) :
    finiteShiftCorrelation (Icc a b) (integerIntervalPhase a b φ) h =
      ∑ n ∈ Icc a (b-h), Complex.exp (((φ ((n:ℝ)+(h:ℝ))-φ (n:ℝ)):ℂ)*Complex.I) := by
  classical
  have hsub : Icc a (b-h) ⊆ Icc a b := by
    intro n hn
    have hn' := mem_Icc.mp hn
    apply mem_Icc.mpr
    omega
  unfold finiteShiftCorrelation
  rw [← sum_subset hsub (fun n hn hnnot => ?_)]
  · apply sum_congr rfl
    intro n hn
    have hn' := mem_Icc.mp hn
    have hns : n ∈ Icc a b := hsub hn
    have hnh : n+h ∈ Icc a b := by apply mem_Icc.mpr; omega
    simp only [integerIntervalPhase, if_pos hns, if_pos hnh,
      ← Complex.exp_conj, map_mul, Complex.conj_ofReal, Complex.conj_I]
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  · have hnh : n+h ∉ Icc a b := by
      intro hnh
      apply hnnot
      have hn' := mem_Icc.mp hn
      have hnh' := mem_Icc.mp hnh
      apply mem_Icc.mpr
      omega
    rw [integer_interval_phase_support a b φ (n+h) hnh, zero_mul]

theorem integer_phase_van_der_corput (a b H : ℤ) (φ : ℝ → ℝ)
    (hab : a ≤ b) (hH : 1 ≤ H) (hHN : H ≤ b-a+1) :
    ‖∑ n ∈ Icc a b, Complex.exp ((φ (n:ℝ):ℂ)*Complex.I)‖^2 ≤
      2*((b-a+1:ℤ):ℝ)^2/(H:ℝ) + (4*((b-a+1:ℤ):ℝ)/(H:ℝ)) *
        ∑ h ∈ Icc (1:ℤ) (H-1),
          ‖∑ n ∈ Icc a (b-h), Complex.exp (((φ ((n:ℝ)+(h:ℝ))-φ (n:ℝ)):ℂ)*Complex.I)‖ := by
  have hv := integer_interval_van_der_corput_unit a b H (integerIntervalPhase a b φ)
    hab hH hHN (integer_interval_phase_support a b φ)
    (fun n hn => integer_interval_phase_norm a b φ n)
  rw [integer_interval_phase_sum] at hv
  apply hv.trans_eq
  congr 2
  apply sum_congr rfl
  intro h hh
  rw [integer_interval_phase_correlation a b h φ (by have := (mem_Icc.mp hh).1; omega)]

theorem integer_phase_van_der_corput_subinterval (A B a b H : ℤ) (φ : ℝ → ℝ)
    (hAB : A ≤ B) (hAa : A ≤ a) (hbB : b ≤ B)
    (hH : 1 ≤ H) (hHN : H ≤ B-A+1) :
    ‖∑ n ∈ Icc a b, Complex.exp ((φ (n:ℝ):ℂ)*Complex.I)‖^2 ≤
      2*((B-A+1:ℤ):ℝ)^2/(H:ℝ) + (4*((B-A+1:ℤ):ℝ)/(H:ℝ)) *
        ∑ h ∈ Icc (1:ℤ) (H-1),
          ‖∑ n ∈ Icc a (b-h), Complex.exp (((φ ((n:ℝ)+(h:ℝ))-φ (n:ℝ)):ℂ)*Complex.I)‖ := by
  let f := integerIntervalPhase a b φ
  have hsub : Icc a b ⊆ Icc A B := by
    intro n hn
    have hn' := mem_Icc.mp hn
    apply mem_Icc.mpr
    omega
  have hsupp (n : ℤ) (hn : n ∉ Icc A B) : f n = 0 :=
    integer_interval_phase_support a b φ n (fun h => hn (hsub h))
  have hsum : (∑ n ∈ Icc A B, f n) =
      ∑ n ∈ Icc a b, Complex.exp ((φ (n:ℝ):ℂ)*Complex.I) := by
    rw [← sum_subset hsub (fun n hn hnnot => integer_interval_phase_support a b φ n hnnot)]
    exact integer_interval_phase_sum a b φ
  have hcorr (h : ℤ) : finiteShiftCorrelation (Icc A B) f h =
      finiteShiftCorrelation (Icc a b) f h := by
    unfold finiteShiftCorrelation
    symm
    apply sum_subset hsub
    intro n hn hnnot
    have hz : f n = 0 := integer_interval_phase_support a b φ n hnnot
    rw [hz, map_zero, mul_zero]
  have hv := integer_interval_van_der_corput_unit A B H f hAB hH hHN hsupp
    (fun n hn => integer_interval_phase_norm a b φ n)
  rw [hsum] at hv
  apply hv.trans_eq
  congr 2
  apply sum_congr rfl
  intro h hh
  rw [hcorr, integer_interval_phase_correlation a b h φ (by have := (mem_Icc.mp hh).1; omega)]

end Bounty
end

section

/- First-derivative exponential-sum test on a finite natural range. -/

open Finset

namespace Bounty

theorem first_derivative_range_sum_bound (f : ℕ → ℝ) (N : ℕ) (k : ℤ)
    {δ : ℝ} (hδ : 0 < δ) (hδhalf : δ ≤ 1/2)
    (hband : ∀ n < N, (k : ℝ)+δ ≤ f (n+1)-f n ∧
      f (n+1)-f n ≤ (k : ℝ)+1-δ)
    (hmono : MonotoneOn (fun n => f (n+1)-f n) (Set.Iio N) ∨
      AntitoneOn (fun n => f (n+1)-f n) (Set.Iio N)) :
    ‖∑ n ∈ range N, realUnitPhase (f n)‖ ≤ 2/δ := by
  apply discrete_unit_phase_sum_bound (fun n => realUnitPhase (f n))
    (fun n => f (n+1)-f n-k) N hδ hδhalf
  · intro n hn
    exact (real_unit_phase_norm _).le
  · intro n hn
    exact real_unit_phase_increment (f n) (f (n+1)) k
  · intro n hn
    have hb := hband n hn
    constructor <;> linarith
  · rcases hmono with hm | hm
    · left
      intro a ha b hb hab
      exact sub_le_sub_right (hm ha hb hab) _
    · right
      intro a ha b hb hab
      exact sub_le_sub_right (hm ha hb hab) _

end Bounty
end

section

/- Natural interval adapter for the proved discrete Kusmin-Landau estimate. -/

open Finset

namespace Bounty

theorem nat_first_derivative_sum_bound (f : ℕ → ℝ) (a b : ℕ) (k : ℤ)
    {δ : ℝ} (hδ : 0 < δ) (hδhalf : δ ≤ 1/2)
    (hband : ∀ n ∈ Icc a b, (k : ℝ)+δ ≤ f (n+1)-f n ∧ f (n+1)-f n ≤ k+1-δ)
    (hmono : MonotoneOn (fun n => f (n+1)-f n) (Set.Icc a b)) :
    ‖∑ n ∈ Icc a b, realUnitPhase (f n)‖ ≤ 2/δ := by
  have he := discrete_unit_phase_sum_bound
    (fun n => realUnitPhase (f (a+n)))
    (fun n => f (a+n+1)-f (a+n)-k) (b+1-a) hδ hδhalf
    (fun n _ => (real_unit_phase_norm _).le)
    (fun n _ => by
      simpa only [Nat.add_assoc,realUnitPhase] using
        real_unit_phase_increment (f (a+n)) (f (a+n+1)) k)
    (fun n hn => by
      have h := hband (a+n) (mem_Icc.mpr ⟨by omega,by omega⟩)
      constructor <;> linarith)
    (Or.inl (by
      intro i hi j hj hij
      change i < b+1-a at hi
      change j < b+1-a at hj
      have h := hmono (a := a+i) (b := a+j) ⟨by omega,by omega⟩ ⟨by omega,by omega⟩ (by omega)
      exact sub_le_sub_right h k))
  have hset : Icc a b = Ico a (b+1) := by
    ext n
    simp only [mem_Icc,mem_Ico]
    omega
  rw [hset,sum_Ico_eq_sum_range]
  exact he

end Bounty
end

section

/- The literal reciprocal prime polynomial and all unit intervals meeting
its exceptional-time set in a bounded time window. -/

open Finset Set
open scoped Classical

namespace Bounty

noncomputable def primeReciprocalPolynomial (P : Finset ℕ) (b : P → ℂ) (t : ℝ) : ℂ :=
  ∑ p : P, (b p / (p.val : ℂ)) *
    Complex.exp (((Real.log (p.val : ℝ) * t : ℝ) : ℂ) * Complex.I)

def primeExceptionalTimes (P : Finset ℕ) (b : P → ℂ) (η R : ℝ) : Set ℝ :=
  {t | |t| ≤ R ∧ η < ‖primeReciprocalPolynomial P b t‖}

noncomputable def primeExceptionalIntervals (P : Finset ℕ) (b : P → ℂ)
    (η R : ℝ) : Finset ℤ :=
  occupiedUnitIntervals (Finset.Icc (-(⌈R⌉₊ : ℤ) - 1) (⌈R⌉₊ : ℤ))
    (primeExceptionalTimes P b η R)

theorem mem_primeExceptionalIntervals (P : Finset ℕ) (b : P → ℂ)
    (η R : ℝ) (i : ℤ) :
    i ∈ primeExceptionalIntervals P b η R ↔
      ∃ t ∈ Set.Icc (i : ℝ) ((i : ℝ) + 1),
        |t| ≤ R ∧ η < ‖primeReciprocalPolynomial P b t‖ := by
  rw [primeExceptionalIntervals, mem_occupiedUnitIntervals]
  constructor
  · exact fun h => h.2
  · intro h
    refine ⟨?_, h⟩
    obtain ⟨t, ht, hR, _⟩ := h
    have hc : R ≤ (⌈R⌉₊ : ℝ) := Nat.le_ceil R
    have htl : -R ≤ t := (abs_le.mp hR).1
    have htr : t ≤ R := (abs_le.mp hR).2
    apply Finset.mem_Icc.mpr
    constructor
    · have hl : -(⌈R⌉₊ : ℝ) - 1 ≤ (i : ℝ) := by linarith [ht.2]
      exact_mod_cast hl
    · have hr : (i : ℝ) ≤ (⌈R⌉₊ : ℝ) := by linarith [ht.1]
      exact_mod_cast hr

theorem prime_exceptional_power_threshold (P : Finset ℕ)
    (hP : ∀ p ∈ P, Nat.Prime p) (b : P → ℂ) (j : ℕ)
    {η R t : ℝ} (hη : 0 ≤ η) (ht : t ∈ primeExceptionalTimes P b η R) :
    η ^ j ≤ ‖∑ n ∈ primePolynomialSupport P j,
      primePolynomialCoefficient P (fun p => b p / (p.val : ℂ)) j n *
        Complex.exp (((Real.log (n : ℝ) * t : ℝ) : ℂ) * Complex.I)‖ := by
  rw [← prime_polynomial_power_exp_log P hP, norm_pow]
  exact pow_le_pow_left₀ hη ht.2.le j

theorem prime_exceptional_window_bounds (R : ℝ) (i : ℤ)
    (hi : i ∈ Finset.Icc (-(⌈R⌉₊ : ℤ) - 1) (⌈R⌉₊ : ℤ)) :
    -(⌈R⌉₊ : ℝ) - 1 ≤ (i : ℝ) ∧ (i : ℝ) + 2 ≤ (⌈R⌉₊ : ℝ) + 2 := by
  obtain ⟨hl, hr⟩ := Finset.mem_Icc.mp hi
  constructor
  · exact_mod_cast hl
  · have h : (i : ℝ) ≤ (⌈R⌉₊ : ℝ) := by exact_mod_cast hr
    linarith

end Bounty
end

section

/- Sparse Dirichlet energy for finite integer supports, from a logarithmic kernel bound. -/

open scoped BigOperators

namespace Bounty

theorem sparse_dirichlet_polynomial_energy {ι : Type*}
    (indices : Finset ι) (x : ι → ℝ) (support : Finset ℕ) (c : ℕ → ℂ)
    (N : ℕ) {U E : ℝ} (hU : 0 ≤ U) (hE : 0 ≤ E)
    (hsep : ∀ i ∈ indices, ∀ j ∈ indices, i ≠ j → 1 ≤ |x i - x j|)
    (hspan : ∀ i ∈ indices, ∀ j ∈ indices, |x i - x j| ≤ N)
    (hkernel : ∀ z : ℝ, |z| ≤ N →
      ‖∑ n ∈ support, Complex.exp ((Real.log (n : ℝ) * z : ℝ) * Complex.I)‖ ≤
        U / (1 + |z|) + E) :
    (∑ i ∈ indices, ‖∑ n ∈ support, c n *
      Complex.exp ((Real.log (n : ℝ) * x i : ℝ) * Complex.I)‖ ^ 2) ≤
      (U * (1 + 2 * (1 + Real.log N)) + (indices.card : ℝ) * E) *
        ∑ n ∈ support, ‖c n‖ ^ 2 := by
  have hcs (f : ℕ → ℂ) : (∑ n : ↥support, f n) = ∑ n ∈ support, f n :=
    Finset.sum_coe_sort support f
  have hrs (f : ℕ → ℝ) : (∑ n : ↥support, f n) = ∑ n ∈ support, f n :=
    Finset.sum_coe_sort support f
  have his (f : ι → ℝ) : (∑ i : ↥indices, f i) = ∑ i ∈ indices, f i :=
    Finset.sum_coe_sort indices f
  have h := sparse_exponential_polynomial_energy (I := ↥indices) (X := ↥support)
    (fun i => x i) (fun n => Real.log (n.val : ℝ)) (fun n => c n) N hU hE
    (fun i j hij => hsep i i.property j j.property (fun he => hij (Subtype.ext he)))
    (fun i j => hspan i i.property j j.property)
    (fun z hz => by
      rw [hcs (fun n => Complex.exp ((Real.log (n : ℝ) * z : ℝ) * Complex.I))]
      exact hkernel z hz)
  have hp (i : ι) : (∑ n : ↥support, c n *
      Complex.exp ((Real.log (n.val : ℝ) * x i : ℝ) * Complex.I)) =
      ∑ n ∈ support, c n * Complex.exp ((Real.log (n : ℝ) * x i : ℝ) * Complex.I) :=
    hcs (fun n => c n * Complex.exp ((Real.log (n : ℝ) * x i : ℝ) * Complex.I))
  simp_rw [hp] at h
  rw [hrs (fun n => ‖c n‖ ^ 2)] at h
  rw [his (fun i => ‖∑ n ∈ support, c n *
    Complex.exp ((Real.log (n : ℝ) * x i : ℝ) * Complex.I)‖ ^ 2)] at h
  simpa only [Fintype.card_coe] using h

end Bounty
end

section

namespace Bounty

theorem mixed_logarithmic_difference_abs_bounds_on_box
    (hs : List ℝ) (u c : ℝ) (k : ℕ) (x lo hi : ℝ)
    (hhs : ∀ h ∈ hs, 0 ≤ h) (hlo : 0 < lo)
    (hxlo : lo ≤ x+c) (hxhi : x+c+hs.sum ≤ hi) :
    (hs.prod * |u| * ((k+hs.length).factorial:ℝ)) / hi^(k+hs.length+1) ≤
      |mixedForwardDifference hs (logarithmicDerivativeChain u c (k+1)) x| ∧
    |mixedForwardDifference hs (logarithmicDerivativeChain u c (k+1)) x| ≤
      (hs.prod * |u| * ((k+hs.length).factorial:ℝ)) / lo^(k+hs.length+1) := by
  have hx : 0 < x+c := lt_of_lt_of_le hlo hxlo
  have hsum : 0 ≤ hs.sum := List.sum_nonneg hhs
  have htop : 0 < x+c+hs.sum := by linarith
  have hprod : 0 ≤ hs.prod := List.prod_nonneg hhs
  have hn : 0 ≤ hs.prod * |u| * ((k+hs.length).factorial:ℝ) := by positivity
  obtain ⟨hl, hu⟩ := mixed_logarithmic_difference_abs_bounds hs u c k x hhs hx
  constructor
  · refine le_trans ?_ hl
    exact div_le_div_of_nonneg_left hn (by positivity)
      (pow_le_pow_left₀ (le_of_lt htop) hxhi _)
  · refine le_trans hu ?_
    exact div_le_div_of_nonneg_left hn (by positivity)
      (pow_le_pow_left₀ (le_of_lt hlo) hxlo _)

theorem mixed_logarithmic_difference_positive_bounds_on_box
    (hs : List ℝ) (u c : ℝ) (k : ℕ) (x lo hi : ℝ)
    (hhs : ∀ h ∈ hs, 0 ≤ h) (hlo : 0 < lo)
    (hxlo : lo ≤ x+c) (hxhi : x+c+hs.sum ≤ hi)
    (hsign : 0 ≤ u * (-1:ℝ)^(k+hs.length)) :
    (hs.prod * |u| * ((k+hs.length).factorial:ℝ)) / hi^(k+hs.length+1) ≤
      mixedForwardDifference hs (logarithmicDerivativeChain u c (k+1)) x ∧
    mixedForwardDifference hs (logarithmicDerivativeChain u c (k+1)) x ≤
      (hs.prod * |u| * ((k+hs.length).factorial:ℝ)) / lo^(k+hs.length+1) := by
  have hh := mixed_logarithmic_difference_abs_bounds_on_box hs u c k x lo hi hhs hlo hxlo hxhi
  rwa [abs_of_nonneg (mixed_logarithmic_difference_nonneg hs u c k x hhs
    (lt_of_lt_of_le hlo hxlo) hsign)] at hh

theorem mixed_logarithmic_difference_negative_bounds_on_box
    (hs : List ℝ) (u c : ℝ) (k : ℕ) (x lo hi : ℝ)
    (hhs : ∀ h ∈ hs, 0 ≤ h) (hlo : 0 < lo)
    (hxlo : lo ≤ x+c) (hxhi : x+c+hs.sum ≤ hi)
    (hsign : u * (-1:ℝ)^(k+hs.length) ≤ 0) :
    -((hs.prod * |u| * ((k+hs.length).factorial:ℝ)) / lo^(k+hs.length+1)) ≤
      mixedForwardDifference hs (logarithmicDerivativeChain u c (k+1)) x ∧
    mixedForwardDifference hs (logarithmicDerivativeChain u c (k+1)) x ≤
      -((hs.prod * |u| * ((k+hs.length).factorial:ℝ)) / hi^(k+hs.length+1)) := by
  have hh := mixed_logarithmic_difference_abs_bounds_on_box hs u c k x lo hi hhs hlo hxlo hxhi
  rw [abs_of_nonpos (mixed_logarithmic_difference_nonpos hs u c k x hhs
    (lt_of_lt_of_le hlo hxlo) hsign)] at hh
  constructor <;> linarith [hh.1, hh.2]

theorem mixed_logarithmic_phase_second_derivative
    (hs : List ℝ) (u c x : ℝ)
    (hhs : ∀ h ∈ hs, 0 ≤ h) (hx : 0 < x+c) :
    HasDerivAt (mixedForwardDifference hs (fun y => u * Real.log (y+c)))
      (mixedForwardDifference hs (logarithmicDerivativeChain u c 1) x) x ∧
    HasDerivAt (mixedForwardDifference hs (logarithmicDerivativeChain u c 1))
      (mixedForwardDifference hs (logarithmicDerivativeChain u c 2) x) x := by
  exact ⟨mixed_logarithmic_difference_hasDerivAt hs u c 0 x hhs hx,
    mixed_logarithmic_difference_hasDerivAt hs u c 1 x hhs hx⟩

end Bounty
end

section

/- The derivative-order parameter yields an explicit fixed power saving. -/

namespace Bounty

theorem derivative_order_scalar_power_saving (B C N ε : ℝ) (k : ℕ)
    (hN : 1 ≤ N) (hε : 0 < ε) (hk : 2 ≤ k) (hC : 4 ≤ C)
    (hpow : 2 ≤ N^(ε/(2*(k : ℝ)))) (hB : B ≤ C*N^(-(ε/4))) :
    vanDerCorputScalarBound (Nat.floor (N^(ε/(2*(k : ℝ)))) : ℝ) B (k-2) ≤
      5^(k-2)*C*N^(-((ε/(2*(k : ℝ)))/(2:ℝ)^(k-2))) := by
  have hkR : (2 : ℝ) ≤ k := by exact_mod_cast hk
  have hθ : 0 ≤ ε/(2*(k : ℝ)) := by positivity
  have hle : ε/(2*(k : ℝ)) ≤ ε/4 :=
    div_le_div_of_nonneg_left hε.le (by norm_num) (by linarith)
  apply van_der_corput_floor_power_saving B C N (ε/(2*(k : ℝ))) (k-2) hN hθ hC hpow
  exact hB.trans (mul_le_mul_of_nonneg_left
    (Real.rpow_le_rpow_of_exponent_le hN (neg_le_neg hle)) (by linarith))

theorem derivative_order_decay_exponent_pos (ε : ℝ) (k : ℕ)
    (hε : 0 < ε) (hk : 2 ≤ k) : 0 < (ε/(2*(k : ℝ)))/(2:ℝ)^(k-2) := by
  have hkR : (0 : ℝ) < k := by exact_mod_cast (show 0 < k by omega)
  positivity

end Bounty
end

section

/- Exact conversion of shared normalization into independent harmonic draws. -/

open Finset

namespace Bounty

noncomputable def physicalSharedAux {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (L : PhysicalMarkLists P J ell) :
    PhysicalAuxLabels P (fun g => univ \ C g) :=
  fun g j => L g (Sum.inl j.val)

theorem physical_state_mass_shared_split {G : Type*} [Fintype G] {J ell : ℕ}
    (V : G → ℝ) (C : G → Finset (Fin J)) :
    physicalStateMass V J ell =
      (∏ g, 1 / V g ^ (J - (C g).card)) * physicalCompletionMass V C ell := by
  classical
  rw [physicalStateMass, physicalCompletionMass, ← prod_mul_distrib]
  apply prod_congr rfl
  intro g _
  have hc : (C g).card ≤ J := (card_le_card (subset_univ _)).trans_eq (by simp)
  rw [one_div_mul_one_div, ← pow_add]
  congr 2
  omega

theorem physical_shared_aux_mass {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) :
    physicalAuxMass V (fun g => univ \ C g) (physicalSharedAux C L) =
      (∏ g, 1 / V g ^ (J - (C g).card)) / (physicalSharedFactor C L : ℝ) := by
  classical
  simp only [physicalAuxMass, physicalSharedAux, physicalLabelLaw, physicalSharedFactor,
    Nat.cast_prod, Fintype.prod_sigma, mul_inv, prod_mul_distrib,
    prod_const, Fintype.card_coe, card_sdiff_of_subset (subset_univ _), card_univ,
    Fintype.card_fin, div_eq_mul_inv, inv_pow, prod_inv_distrib, one_mul]

theorem physical_shared_joint_normalization {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) :
    physicalStateMass V J ell * physicalCompletionMass V C ell /
        (physicalSharedFactor C L : ℝ) =
      physicalAuxMass V (fun g => univ \ C g) (physicalSharedAux C L) *
        physicalCompletionMass V C ell ^ 2 := by
  rw [physical_state_mass_shared_split V C, physical_shared_aux_mass]
  ring

theorem physical_shared_aux_injective {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (L : PhysicalMarkLists P J ell) (g : G) :
    Function.Injective (physicalSharedAux C L g) := by
  intro a b h
  exact Subtype.ext (Sum.inl.inj ((L g).injective h))

theorem physical_shared_aux_eq_of_compatible {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) {L R : PhysicalMarkLists P J ell}
    (h : physicalSharedCompatible C L R) : physicalSharedAux C L = physicalSharedAux C R := by
  funext g j
  exact h g j.val (mem_sdiff.mp j.property).2

end Bounty
end

section

/- The shared-draw exclusion error for a genuinely shared-independent coefficient. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_shared_scalar_removal_error {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (aux : PhysicalAuxLabels P C) {w z : ℕ} (hw : 0 < w) (hz : 0 < z)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (c : ℂ) :
    ‖(∑ s : PhysicalAuxLabels P (fun g => univ \ C g),
      if physicalSharedDrawGood C (fun g => physicalSharedForbidden C aux g w z) s
        then (physicalAuxMass V (fun g => univ \ C g) s : ℂ) * c else 0) - c‖ ≤
      (∑ g, (J - (C g).card : ℕ) *
        (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) / (V g * Pmin)) * ‖c‖ := by
  have he := finite_constant_restriction_error
    (S := PhysicalAuxLabels P (fun g => univ \ C g))
    (fun s => physicalAuxMass V (fun g => univ \ C g) s)
    (fun s => physical_aux_mass_nonneg V _ (fun g => (hV g).le) s)
    (physical_aux_mass_sum V _ hV hMass)
    (physicalSharedDrawGood C (fun g => physicalSharedForbidden C aux g w z)) c
  rw [he]
  apply mul_le_mul_of_nonneg_right _ (norm_nonneg c)
  refine le_trans ?_ (physical_shared_draw_endpoint_bad_mass V C hV hMass aux hw hz hPmin hp)
  apply le_of_eq
  apply sum_congr rfl
  intro s _
  by_cases hs : ¬physicalSharedDrawGood C (fun g => physicalSharedForbidden C aux g w z) s
  · simp only [if_pos hs]
  · simp only [if_neg hs]

end Bounty
end

section

/- Ordinary mean square on a dyad, normalized by its coefficient energy. -/

open Finset Set MeasureTheory Filter

namespace Bounty

theorem dyadic_polynomial_mean_square_le (s : Finset ℕ) (w : ℕ → ℂ)
    {U R V : ℝ} (hU : 1 ≤ U) (hR : 0 ≤ R) (hRU : R ≤ U)
    (hband : ∀ n ∈ s, U ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2 * U)
    (henergy : (∑ n ∈ s, ‖w n‖ ^ 2) ≤ V / U) :
    (∫ t in Set.Icc (-R) R, ‖∑ n ∈ s, w n *
      Complex.exp ((Real.log (n : ℝ) * t : ℝ) * Complex.I)‖ ^ 2) ≤
      (72 * Real.pi * (1 + 2 * (1 + Real.log ⌈2 * U⌉₊)) + 1) * V := by
  have hU0 : 0 < U := zero_lt_one.trans_le hU
  have hN : (⌈2 * U⌉₊ : ℝ) ≤ 3 * U := by
    have hh := Nat.ceil_lt_add_one (by linarith : 0 ≤ 2 * U)
    linarith
  have hs : ∀ n ∈ s, 1 ≤ n ∧ n ≤ ⌈2 * U⌉₊ := by
    intro n hn
    constructor
    · exact_mod_cast hU.trans (hband n hn).1
    · exact_mod_cast (hband n hn).2.trans (Nat.le_ceil (2 * U))
  have hraw := dirichlet_polynomial_mean_square s w ⌈2 * U⌉₊ (-R) R (by linarith) hs
  rw [intervalIntegral.integral_of_le (by linarith : -R ≤ R),
    ← integral_Icc_eq_integral_Ioc] at hraw
  have hlog := Real.log_natCast_nonneg ⌈2 * U⌉₊
  have hcoef : (R - -R) + 4 * (⌈2 * U⌉₊ : ℝ) * (1 + Real.log ⌈2 * U⌉₊) ≤
      (2 + 12 * (1 + Real.log ⌈2 * U⌉₊)) * U := by
    have hh := mul_le_mul_of_nonneg_right hN (by linarith : 0 ≤ 1 + Real.log ⌈2 * U⌉₊)
    nlinarith
  have hpref : 2 + 12 * (1 + Real.log ⌈2 * U⌉₊) ≤
      72 * Real.pi * (1 + 2 * (1 + Real.log ⌈2 * U⌉₊)) + 1 := by
    have hpi := Real.pi_gt_three
    have hh := mul_nonneg (by linarith : 0 ≤ 144 * Real.pi - 12) hlog
    nlinarith
  have hV : 0 ≤ V := by
    have hh : 0 ≤ V / U := (Finset.sum_nonneg (fun _ _ => sq_nonneg _)).trans henergy
    simpa only [zero_mul] using (le_div_iff₀ hU0).mp hh
  calc
    _ ≤ ((R - -R) + 4 * (⌈2 * U⌉₊ : ℝ) * (1 + Real.log ⌈2 * U⌉₊)) *
        ∑ n ∈ s, ‖w n‖ ^ 2 := hraw
    _ ≤ ((2 + 12 * (1 + Real.log ⌈2 * U⌉₊)) * U) * (V / U) :=
      mul_le_mul hcoef henergy (Finset.sum_nonneg (fun _ _ => sq_nonneg _)) (by positivity)
    _ = (2 + 12 * (1 + Real.log ⌈2 * U⌉₊)) * V := by field_simp
    _ ≤ _ := mul_le_mul_of_nonneg_right hpref hV

theorem eventually_dyadic_polynomial_mean_square_power {c C : ℝ} (hc : 0 ≤ c) :
    ∀ᶠ L : ℝ in atTop, ∀ (s : Finset ℕ) (w : ℕ → ℂ) (U R : ℝ),
      1 ≤ U → 0 ≤ R → R ≤ U → Real.log U ≤ c * L →
      (∀ n ∈ s, U ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2 * U) →
      (∑ n ∈ s, ‖w n‖ ^ 2) ≤ L ^ C / U →
      (∫ t in Set.Icc (-R) R, ‖∑ n ∈ s, w n *
        Complex.exp ((Real.log (n : ℝ) * t : ℝ) * Complex.I)‖ ^ 2) ≤ L ^ (C + 2) := by
  filter_upwards [eventually_sparse_logarithmic_prefactor_le_square hc,
    eventually_gt_atTop (0 : ℝ)] with L hbudget hL
  intro s w U R hU hR hRU hlog hband henergy
  have hU0 : 0 < U := zero_lt_one.trans_le hU
  have hNpos : 0 < ⌈2 * U⌉₊ := Nat.ceil_pos.mpr (by linarith)
  have hNU : (⌈2 * U⌉₊ : ℝ) ≤ 4 * U := by
    have hh := Nat.ceil_lt_add_one (by linarith : 0 ≤ 2 * U)
    linarith
  have hpref := hbudget U ⌈2 * U⌉₊ hU0 hNpos hNU hlog
  calc
    _ ≤ (72 * Real.pi * (1 + 2 * (1 + Real.log ⌈2 * U⌉₊)) + 1) * L ^ C :=
      dyadic_polynomial_mean_square_le s w hU hR hRU hband henergy
    _ ≤ L ^ (2 : ℕ) * L ^ C := mul_le_mul_of_nonneg_right hpref (Real.rpow_nonneg hL.le C)
    _ = L ^ (C + 2) := by rw [← Real.rpow_two, ← Real.rpow_add hL]; congr 1; ring

end Bounty
end

section

/- On a fixed residual gcd slice the rational phase separates in a finite four-factor box. -/

open Finset
open scoped Classical

namespace Bounty

theorem rational_four_factor_box_expansion {r Q d : ℕ}
    (hr : 0 < r) (hrQ : r ≤ Q) (hd : 0 < d) (hdr : d ∣ r) (u : ℤ)
    (M A P N : Finset ℕ)
    (hM : ∀ m ∈ M, m.Coprime r) (hA : ∀ a ∈ A, a.Coprime r)
    (hP : ∀ p ∈ P, p.Coprime r) (hN : ∀ n ∈ N, n.gcd r = d)
    (α δ β γ : ℕ → ℂ) :
    ∃ c : AddChar (Additive (ZMod (r / d))ˣ) ℂ → ℂ,
      (∑ ψ, ‖c ψ‖) ≤ Real.sqrt (Q : ℝ) ∧
      (∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P, ∑ n ∈ N,
        (α m * δ a * β p * γ n) *
          Complex.exp (Complex.I * (2 * Real.pi * ((u : ℝ) / r * (m * a * p * n)) : ℝ))) =
        ∑ ψ, c ψ *
          (∑ m ∈ M, α m * unitAddCharDirichlet ψ (m : ZMod (r / d))) *
          (∑ a ∈ A, δ a * unitAddCharDirichlet ψ (a : ZMod (r / d))) *
          (∑ p ∈ P, β p * unitAddCharDirichlet ψ (p : ZMod (r / d))) *
          (∑ n ∈ N, γ n * unitAddCharDirichlet ψ ((n / d : ℕ) : ZMod (r / d))) := by
  obtain ⟨c, hc, he⟩ := rational_four_factor_gcd_slice_expansion hr hrQ hd hdr u
  refine ⟨c, hc, ?_⟩
  calc
    _ = ∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P, ∑ n ∈ N, ∑ ψ,
        c ψ * (α m * unitAddCharDirichlet ψ (m : ZMod (r / d))) *
          (δ a * unitAddCharDirichlet ψ (a : ZMod (r / d))) *
          (β p * unitAddCharDirichlet ψ (p : ZMod (r / d))) *
          (γ n * unitAddCharDirichlet ψ ((n / d : ℕ) : ZMod (r / d))) := by
      apply sum_congr rfl
      intro m hm
      apply sum_congr rfl
      intro a ha
      apply sum_congr rfl
      intro p hp
      apply sum_congr rfl
      intro n hn
      rw [← he m a p n (hM m hm) (hA a ha) (hP p hp) (hN n hn), mul_sum]
      apply sum_congr rfl
      intro ψ _
      ring
    _ = ∑ ψ, ∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P, ∑ n ∈ N,
        c ψ * (α m * unitAddCharDirichlet ψ (m : ZMod (r / d))) *
          (δ a * unitAddCharDirichlet ψ (a : ZMod (r / d))) *
          (β p * unitAddCharDirichlet ψ (p : ZMod (r / d))) *
          (γ n * unitAddCharDirichlet ψ ((n / d : ℕ) : ZMod (r / d))) := by
      conv_lhs =>
        arg 2
        ext m
        arg 2
        ext a
        arg 2
        ext p
        rw [sum_comm]
      conv_lhs =>
        arg 2
        ext m
        arg 2
        ext a
        rw [sum_comm]
      conv_lhs =>
        arg 2
        ext m
        rw [sum_comm]
      rw [sum_comm]
    _ = _ := by
      simp only [← mul_sum, ← sum_mul]

end Bounty
end

section

/- Fixed divisor losses in global Mellin bounds fit explicit powers of L. -/

open Filter Finset

namespace Bounty

theorem dyadic_mellin_log_budget {c L U : ℝ} (k : ℕ) (hL : 1 ≤ L)
    (hlarge : 2*(1+Real.log 2+c)^k ≤ L) (hU : 1 ≤ U)
    (hlog : Real.log U ≤ c*L) :
    2*(1+Real.log (2*U))^k ≤ L^(k+1) := by
  have hUpos : 0 < U := zero_lt_one.trans_le hU
  have hlog2 : 0 ≤ Real.log 2 := Real.log_nonneg (by norm_num)
  have hlin : 1+Real.log (2*U) ≤ (1+Real.log 2+c)*L := by
    rw [Real.log_mul (by norm_num) hUpos.ne']
    nlinarith
  have hbase : 0 ≤ 1+Real.log (2*U) := by
    have hh := Real.log_nonneg (by linarith : 1 ≤ 2*U)
    linarith
  calc
    _ ≤ 2*((1+Real.log 2+c)*L)^k :=
      mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hbase hlin k) (by norm_num)
    _ = (2*(1+Real.log 2+c)^k)*L^k := by rw [mul_pow]; ring
    _ ≤ L*L^k := mul_le_mul_of_nonneg_right hlarge (pow_nonneg (by linarith) k)
    _ = _ := by rw [pow_succ]; ring

theorem eventually_finite_dyadic_mellin_zeta_power_norm (c E : ℝ) (k : ℕ) :
    ∀ᶠ L : ℝ in atTop, ∀ (S : Finset ℕ) (f : ℕ → ℂ) (U B : ℝ),
      1 ≤ U → Real.log U ≤ c*L → 0 ≤ B → B ≤ L^E →
      (∀ n ∈ S, U ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*U) →
      (∀ n ∈ S, ‖f n‖ ≤ B*((ArithmeticFunction.zeta^(k+1)) n : ℝ)) →
      ∀ u : ℝ, ‖∑ n ∈ S, harmonicMellinWeight u n*f n‖ ≤ L^(E+(k:ℝ)+1) := by
  filter_upwards [eventually_ge_atTop (1 : ℝ),
    eventually_ge_atTop (2*(1+Real.log 2+c)^k)] with L hL hlarge
  intro S f U B hU hlog hB hBL hS hf u
  have hLpos : 0 < L := zero_lt_one.trans_le hL
  have hbudget := dyadic_mellin_log_budget k hL hlarge hU hlog
  have hbase : 0 ≤ 1+Real.log (2*U) := by
    have hh := Real.log_nonneg (by linarith : 1 ≤ 2*U)
    linarith
  calc
    _ ≤ 2*B*(1+Real.log (2*U))^k := finite_dyadic_mellin_zeta_norm S f u U B k hU hB hS hf
    _ = B*(2*(1+Real.log (2*U))^k) := by ring
    _ ≤ L^E*L^(k+1) := mul_le_mul hBL hbudget (by positivity) (Real.rpow_nonneg hLpos.le E)
    _ = L^(E+(k:ℝ)+1) := by
      rw [← Real.rpow_natCast, ← Real.rpow_add hLpos]
      congr 1
      push_cast
      ring

end Bounty
end

section

/- The actual long rough factor has a global constant bound at all frequencies. -/

open Finset Filter

namespace Bounty

theorem finite_dyadic_mellin_bounded_norm (S : Finset ℕ) (f : ℕ → ℂ)
    (u U B : ℝ) (hU : 1 ≤ U) (hB : 0 ≤ B)
    (hS : ∀ n ∈ S, U ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*U)
    (hf : ∀ n ∈ S, ‖f n‖ ≤ B) :
    ‖∑ n ∈ S, harmonicMellinWeight u n*f n‖ ≤ 2*B := by
  have hh := finite_dyadic_mellin_zeta_norm S f u U B 0 hU hB hS (by
    intro n hn
    have hnpos : 0 < n := by exact_mod_cast (zero_lt_one.trans_le hU).trans_le (hS n hn).1
    simpa only [zero_add, pow_one, ArithmeticFunction.zeta_apply_ne hnpos.ne', Nat.cast_one, mul_one]
      using hf n hn)
  simpa only [pow_zero, mul_one] using hh

theorem roughBand_mellin_global_norm (U A B W u : ℝ) (hU : 1 ≤ U)
    (hUA : U ≤ A) (hAB : A ≤ B) (hBU : B ≤ 2*U)
    (q : ℕ) (χ : DirichletCharacter ℂ q) :
    ‖∑ n ∈ roughBand A B W, harmonicMellinWeight u n*χ (n : ZMod q)‖ ≤ 2 := by
  have hA : 0 ≤ A := le_trans (by linarith) hUA
  have hB : 0 ≤ B := hA.trans hAB
  have hh := finite_dyadic_mellin_bounded_norm (roughBand A B W)
    (fun n => χ (n : ZMod q)) u U 1 hU zero_le_one (by
      intro n hn
      have hi := mem_Ioc.mp (mem_filter.mp hn).1
      exact ⟨hUA.trans ((Nat.floor_lt hA).mp hi.1).le,
        ((Nat.le_floor_iff hB).mp hi.2).trans hBU⟩)
    (fun n _ => χ.norm_le_one (n : ZMod q))
  simpa only [mul_one] using hh

theorem eventually_roughBand_mellin_global_power_norm :
    ∀ᶠ L : ℝ in atTop, ∀ (U A B W u σ : ℝ), 1 ≤ U → U ≤ A → A ≤ B → B ≤ 2*U →
      ∀ (q : ℕ) (χ : DirichletCharacter ℂ q),
      ‖∑ n ∈ roughBand A B W, harmonicMellinWeight (u+σ) n*χ (n : ZMod q)‖ ≤ L := by
  filter_upwards [eventually_ge_atTop (2 : ℝ)] with L hL
  intro U A B W u σ hU hUA hAB hBU q χ
  exact (roughBand_mellin_global_norm U A B W (u+σ) hU hUA hAB hBU q χ).trans hL

end Bounty
end

section

/- Read the actual prime-comparison coordinates from the original unshared
endpoint embedding. No values at shared slots are reconstructed or chosen. -/

open Finset Classical
namespace Bounty

noncomputable def physicalUnsharedCoordinate {G : Type*} {P : G → Finset ℕ}
    {J ell : ℕ} (C : G → Finset (Fin J))
    (u : GroupMarkedLists P (fun g => ell + (C g).card))
    (g : G) (s : PhysicalSlots J ell) (hs : s ∈ physicalUnsharedSlots (C g)) : P g :=
  u g ((physicalGroupUnsharedIndex (C g)).symm ⟨s, hs⟩)

theorem physical_unshared_coordinate_embedding {G : Type*} {P : G → Finset ℕ}
    {J ell : ℕ} (C : G → Finset (Fin J)) (L : PhysicalMarkLists P J ell)
    (g : G) (s : PhysicalSlots J ell) (hs : s ∈ physicalUnsharedSlots (C g)) :
    physicalUnsharedCoordinate C (physicalGroupUnsharedEmbedding C L) g s hs = L g s := by
  change L g ((physicalGroupUnsharedIndex (C g))
    ((physicalGroupUnsharedIndex (C g)).symm ⟨s, hs⟩)).val = _
  rw [Equiv.apply_symm_apply]

theorem repeated_big_aux_union_unshared {G : Type*} [DecidableEq G] {J ell : ℕ}
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (i : RepeatedBigFlatIndex G J ell) (hi : i ∈ A ∪ B) :
    i.2 ∈ physicalUnsharedSlots (repeatedBigAuxCut A B i.1) := by
  rw [physicalUnsharedSlots, mem_compl]
  intro hs
  obtain ⟨j, hj, he⟩ := (physical_mem_shared_slots_iff _ _).mp hs
  apply hj
  apply (mem_repeatedBigAuxCut A B i.1 j).mpr
  have hie : i = ⟨i.1, Sum.inl j⟩ := Sigma.ext rfl (heq_of_eq he)
  rwa [← hie]

noncomputable def physicalPrimeUnsharedRestriction {G : Type*} [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (A B T : Finset (RepeatedBigFlatIndex G J ell)) (hT : T ⊆ A ∪ B)
    (u : GroupMarkedLists P (fun g => ell + (repeatedBigAuxCut A B g).card)) :
    ∀ i : T, P i.val.1 :=
  fun i => physicalUnsharedCoordinate (repeatedBigAuxCut A B) u i.val.1 i.val.2
    (repeated_big_aux_union_unshared A B i.val (hT i.property))

theorem physical_prime_unshared_restriction_embedding {G : Type*} [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (A B T : Finset (RepeatedBigFlatIndex G J ell)) (hT : T ⊆ A ∪ B)
    (L : PhysicalMarkLists P J ell) :
    physicalPrimeUnsharedRestriction A B T hT
      (physicalGroupUnsharedEmbedding (repeatedBigAuxCut A B) L) =
      finiteCoordinateRestrict T (repeatedBigFlatEquiv P J ell (fun g s => L g s)) := by
  funext i
  exact physical_unshared_coordinate_embedding (repeatedBigAuxCut A B) L i.val.1 i.val.2 _

end Bounty
end

section

/- Freezing the small selected data gives an actual local coefficient on big
source, target, and auxiliary labels, while preserving the full coefficient. -/

open scoped Classical
namespace Bounty

theorem physical_selected_split_coefficient
    {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell n : ℕ}
    (small : G → Prop) (C : Fin n → G → Finset (Fin J))
    (ds : PhysicalGroupSelectedData (fun g : {g // small g} => P g.val) ell
      (fun j g => C j g.val))
    (db : PhysicalGroupSelectedData (fun g : {g // ¬small g} => P g.val) ell
      (fun j g => C j g.val))
    (j : Fin n) (ζ : ℝ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C j) → ℂ) :
    let d := (physicalGroupSelectedSplit small C).symm (ds, db)
    physicalCoupledBigCoefficient small (C j) ζ K
      (physicalPermuteLabels (ds.2.2.1 j) (ds.2.1 j.castSucc))
      (physicalPermuteLabels (ds.2.2.2 j) (ds.2.1 j.succ)) (ds.1 j)
      (physicalPermuteLabels (db.2.2.1 j) (db.2.1 j.castSucc))
      (physicalPermuteLabels (db.2.2.2 j) (db.2.1 j.succ)) (db.1 j) =
    K (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc))
      (physicalPermuteLabels (d.2.2.2 j) (d.2.1 j.succ)) (d.1 j) *
      physicalPhase ζ (physicalD (C j)
        (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc)) (d.1 j)) := by
  dsimp only
  let d := (physicalGroupSelectedSplit small C).symm (ds, db)
  have hs := congrArg Prod.fst ((physicalGroupSelectedSplit small C).apply_symm_apply (ds, db))
  have hb := congrArg Prod.snd ((physicalGroupSelectedSplit small C).apply_symm_apply (ds, db))
  have hsl (i) : (fun g : {g // small g} => d.2.1 i g.val) = ds.2.1 i :=
    congrArg (fun x => x.2.1 i) hs
  have hbl (i) : (fun g : {g // ¬small g} => d.2.1 i g.val) = db.2.1 i :=
    congrArg (fun x => x.2.1 i) hb
  have hss : (fun g : {g // small g} => d.2.2.1 j g.val) = ds.2.2.1 j :=
    congrArg (fun x => x.2.2.1 j) hs
  have hbs : (fun g : {g // ¬small g} => d.2.2.1 j g.val) = db.2.2.1 j :=
    congrArg (fun x => x.2.2.1 j) hb
  have hst : (fun g : {g // small g} => d.2.2.2 j g.val) = ds.2.2.2 j :=
    congrArg (fun x => x.2.2.2 j) hs
  have hbt : (fun g : {g // ¬small g} => d.2.2.2 j g.val) = db.2.2.2 j :=
    congrArg (fun x => x.2.2.2 j) hb
  have hsa : (fun g : {g // small g} => d.1 j g.val) = ds.1 j :=
    congrArg (fun x => x.1 j) hs
  have hba : (fun g : {g // ¬small g} => d.1 j g.val) = db.1 j :=
    congrArg (fun x => x.1 j) hb
  have hsp : (fun g : {g // small g} =>
      physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc) g.val) =
      physicalPermuteLabels (ds.2.2.1 j) (ds.2.1 j.castSucc) := by
    rw [physical_permute_group_restrict, hss, hsl]
  have hbp : (fun g : {g // ¬small g} =>
      physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc) g.val) =
      physicalPermuteLabels (db.2.2.1 j) (db.2.1 j.castSucc) := by
    rw [physical_permute_group_restrict, hbs, hbl]
  have hsq : (fun g : {g // small g} =>
      physicalPermuteLabels (d.2.2.2 j) (d.2.1 j.succ) g.val) =
      physicalPermuteLabels (ds.2.2.2 j) (ds.2.1 j.succ) := by
    rw [physical_permute_group_restrict, hst, hsl]
  have hbq : (fun g : {g // ¬small g} =>
      physicalPermuteLabels (d.2.2.2 j) (d.2.1 j.succ) g.val) =
      physicalPermuteLabels (db.2.2.2 j) (db.2.1 j.succ) := by
    rw [physical_permute_group_restrict, hbt, hbl]
  have h := physical_coupled_big_coefficient_restrict small (C j) ζ K (d.1 j)
    (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc))
    (physicalPermuteLabels (d.2.2.2 j) (d.2.1 j.succ))
  rw [← physical_D_group_split small] at h
  simpa only [hsp, hbp, hsq, hbq, hsa, hba] using h

end Bounty
end

section

/- Logarithmic marked-list lengths give a polynomial overlap factor, which
is dominated by the lower endpoint of the prime pools. -/

open Filter
namespace Bounty

theorem four_pow_length_le_rpow {L A : ℝ} (hL : 0 < L) {J n : ℕ}
    (hJ : (J : ℝ) ≤ A * Real.log L) :
    (4 : ℝ) ^ (J * n) ≤ L ^ (A * n * Real.log 4) := by
  have h4 : 0 ≤ Real.log (4 : ℝ) := Real.log_nonneg (by norm_num)
  calc
    _ = Real.exp (((J : ℝ) * n) * Real.log 4) := by
      rw [← Nat.cast_mul, Real.exp_nat_mul, Real.exp_log (by norm_num)]
    _ ≤ Real.exp ((A * Real.log L * n) * Real.log 4) := by
      apply Real.exp_le_exp.mpr
      exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hJ (Nat.cast_nonneg n)) h4
    _ = _ := by rw [Real.rpow_def_of_pos hL]; congr 1; ring

theorem eventually_polynomial_div_exp_power {c : ℝ} (hc : 0 < c) (A a D : ℝ) :
    ∀ᶠ L : ℝ in atTop, A * L ^ a / Real.exp (L ^ c) ≤ L ^ (-D) := by
  filter_upwards [eventually_mul_rpow_le_exp_rpow (a+D) A hc,
    eventually_gt_atTop (0 : ℝ)] with L hbound hL
  rw [Real.rpow_neg hL.le, ← one_div]
  apply (le_div_iff₀ (Real.rpow_pos_of_pos hL D)).mpr
  rw [div_mul_eq_mul_div]
  apply (div_le_iff₀ (Real.exp_pos _)).mpr
  calc
    _ = A * L ^ (a+D) := by rw [Real.rpow_add hL]; ring
    _ ≤ _ := by simpa only [one_mul] using hbound

end Bounty
end

section

/- A relative square-error budget gives a linear error for harmonic pairings. -/

open Finset
namespace Bounty

theorem harmonic_replacement_error_envelope {E D ε : ℝ}
    (hE : 0 ≤ E) (hε : 0 ≤ ε) (hε1 : ε ≤ 1) (hD : D ≤ E*ε^2) :
    Real.sqrt D * Real.sqrt E + Real.sqrt (2*(E+D)) * Real.sqrt D ≤ 3*E*ε := by
  have hs : (Real.sqrt E)^2 = E := Real.sq_sqrt hE
  have hDE : D ≤ E := hD.trans (by
    have hsq : ε^2 ≤ (1 : ℝ)^2 := pow_le_pow_left₀ hε hε1 2
    nlinarith [mul_le_mul_of_nonneg_left hsq hE])
  have hd : Real.sqrt D ≤ Real.sqrt E*ε :=
    (Real.sqrt_le_left (mul_nonneg (Real.sqrt_nonneg _) hε)).mpr (by nlinarith)
  have he : Real.sqrt (2*(E+D)) ≤ 2*Real.sqrt E :=
    (Real.sqrt_le_left (by positivity)).mpr (by nlinarith)
  calc
    _ ≤ (Real.sqrt E*ε)*Real.sqrt E + (2*Real.sqrt E)*(Real.sqrt E*ε) :=
      add_le_add (mul_le_mul_of_nonneg_right hd (Real.sqrt_nonneg _))
        (mul_le_mul he hd (Real.sqrt_nonneg _) (by positivity))
    _ = 3*(Real.sqrt E)^2*ε := by ring
    _ = _ := by rw [hs]

theorem finite_harmonic_replacement_small_error
    (S : Finset ℤ) (θ f g f' g' : ℤ → ℂ)
    {Y K E ε : ℝ} (hY : 0 < Y) (hK : 0 ≤ K)
    (hE : 0 ≤ E) (hε : 0 ≤ ε) (hε1 : ε ≤ 1)
    (hYlow : ∀ n ∈ S, Y ≤ (n : ℝ)) (hθ : ∀ n ∈ S, ‖θ n‖ ≤ K)
    (hf : (∑ n ∈ S, ‖f n‖ ^ 2) ≤ E)
    (hg : (∑ n ∈ S, ‖g n‖ ^ 2) ≤ E)
    (hff : (∑ n ∈ S, ‖f n - f' n‖ ^ 2) ≤ E*ε^2)
    (hgg : (∑ n ∈ S, ‖g n - g' n‖ ^ 2) ≤ E*ε^2) :
    ‖(∑ n ∈ S, (θ n / (n : ℂ)) * (starRingEnd ℂ) (f n) * g n) -
      (∑ n ∈ S, (θ n / (n : ℂ)) * (starRingEnd ℂ) (f' n) * g' n)‖ ≤
      (3*K/Y)*E*ε := by
  apply (finite_harmonic_replacement_energy_bound S θ f g f' g' hY hK hYlow hθ
    hf hg hff hgg).trans
  calc
    _ ≤ (K/Y)*(3*E*ε) := mul_le_mul_of_nonneg_left
      (harmonic_replacement_error_envelope hE hε hε1 le_rfl) (div_nonneg hK hY.le)
    _ = _ := by ring

end Bounty
end

section

/- The original auxiliary draw measure gives a bilinear Fourier multiplier,
without excluding repeated prime labels or changing the tuple spaces. -/

open Finset MeasureTheory
open scoped Classical ComplexConjugate
namespace Bounty

noncomputable def physicalAuxFourierMultiplier
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (k : ℤ)
    (bA : (∀ i : A, P i.val.1) → ℂ) (bB : (∀ i : B, P i.val.1) → ℂ)
    (x : ℝ) : ℂ :=
  ∑ aux : PhysicalAuxLabels P (repeatedBigAuxCut A B),
    (physicalAuxMass V (repeatedBigAuxCut A B) aux : ℂ) *
      bA (repeatedBigAuxSplitEquiv P A B hU hAB aux).1 *
      bB (repeatedBigAuxSplitEquiv P A B hU hAB aux).2 *
      fourier (-(k * (∏ g, ∏ j : repeatedBigAuxCut A B g, (aux g j).val : ℕ)))
        (x : AddCircle (1 : ℝ))

theorem physical_aux_fourier_split
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (k : ℤ)
    (bA : (∀ i : A, P i.val.1) → ℂ) (bB : (∀ i : B, P i.val.1) → ℂ)
    (x : ℝ) :
    physicalAuxFourierMultiplier P V A B hU hAB k bA bB x =
      ∑ a : (∀ i : A, P i.val.1), ∑ b : (∀ i : B, P i.val.1),
        ((finiteProductWeight (fun i : A => physicalLabelLaw V i.val.1) a : ℂ) * bA a) *
        ((finiteProductWeight (fun i : B => physicalLabelLaw V i.val.1) b : ℂ) * bB b) *
        fourier (-(k * ((∏ i : A, (a i).val) * (∏ i : B, (b i).val) : ℕ)))
          (x : AddCircle (1 : ℝ)) := by
  unfold physicalAuxFourierMultiplier
  rw [repeated_big_aux_split_sum P A B hU hAB]
  apply sum_congr rfl
  intro a _
  apply sum_congr rfl
  intro b _
  rw [repeatedBigAuxSplitEquiv_symm_mass, repeatedBigAuxSplitEquiv_symm_label_prod]
  simp only [Equiv.apply_symm_apply, Complex.ofReal_mul]
  ring

theorem physical_aux_averaged_shift_fourier
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (k : ℤ)
    (bA : (∀ i : A, P i.val.1) → ℂ) (bB : (∀ i : B, P i.val.1) → ℂ)
    (S T : Finset ℤ) (f g : ℤ → ℂ) :
    (∑ aux : PhysicalAuxLabels P (repeatedBigAuxCut A B),
      (physicalAuxMass V (repeatedBigAuxCut A B) aux : ℂ) *
        bA (repeatedBigAuxSplitEquiv P A B hU hAB aux).1 *
        bB (repeatedBigAuxSplitEquiv P A B hU hAB aux).2 *
        ∑ n ∈ S, let δ : ℤ := k * (∏ g, ∏ j : repeatedBigAuxCut A B g, (aux g j).val : ℕ)
          if n+δ ∈ T then conj (f n)*g (n+δ) else 0) =
      ∫ x in (0 : ℝ)..1, conj (finiteFourierSum S f x) * finiteFourierSum T g x *
        physicalAuxFourierMultiplier P V A B hU hAB k bA bB x := by
  exact finite_averaged_shift_fourier univ
    (fun aux => (physicalAuxMass V (repeatedBigAuxCut A B) aux : ℂ) *
      bA (repeatedBigAuxSplitEquiv P A B hU hAB aux).1 *
      bB (repeatedBigAuxSplitEquiv P A B hU hAB aux).2)
    (fun aux => k * (∏ g, ∏ j : repeatedBigAuxCut A B g, (aux g j).val : ℕ)) S T f g

end Bounty
end

section

/- The actual major region is bounded by a finite sum of local Fourier
energies on explicit rational-centered intervals. -/

open Finset MeasureTheory
namespace Bounty

theorem product_major_energy_cover (S : Finset ℤ) (f : ℤ → ℂ)
    {k : ℤ} {L q U V : ℝ} (hk : k ≠ 0) (hU : 0 < U) (hV : 0 < V)
    (hscale : L^q ≤ U*V) :
    let Q := ⌊L^q⌋₊
    let N := Q*(k.natAbs+1)
    let w := L^q/(|(k : ℝ)| * (U*V))
    (∫ x in productMajorArcSet k L q U V ∩ Set.Ioc 0 1,
      ‖finiteFourierSum S f x‖^2) ≤
    ∑ r ∈ Icc 1 Q, ∑ u ∈ Icc (-(N : ℤ)) (N : ℤ),
      ∫ x in Set.Icc (-(u : ℝ)/((k : ℝ)*r)-w) (-(u : ℝ)/((k : ℝ)*r)+w),
        ‖finiteFourierSum S f x‖^2 := by
  classical
  dsimp only
  let s := (Icc 1 ⌊L^q⌋₊).product
    (Icc (-((⌊L^q⌋₊*(k.natAbs+1) : ℕ) : ℤ)) ((⌊L^q⌋₊*(k.natAbs+1) : ℕ) : ℤ))
  let C (i : ℕ × ℤ) := Set.Icc
    (-(i.2 : ℝ)/((k : ℝ)*i.1)-L^q/(|(k : ℝ)| * (U*V)))
    (-(i.2 : ℝ)/((k : ℝ)*i.1)+L^q/(|(k : ℝ)| * (U*V)))
  have hc := (continuous_finiteFourierSum S f).norm.pow 2
  have hb := finite_cover_integral_le volume s
    (productMajorArcSet k L q U V ∩ Set.Ioc 0 1) C
    (fun x => ‖finiteFourierSum S f x‖^2)
    ((product_major_arc_set_measurable k L q U V).inter measurableSet_Ioc)
    (fun _ _ => measurableSet_Icc) (fun _ => sq_nonneg _)
    (hc.integrableOn_Ioc.mono_set Set.inter_subset_right)
    (fun _ _ => hc.integrableOn_Icc) ?_
  · apply hb.trans_eq
    exact Finset.sum_finset_product s (Icc 1 ⌊L^q⌋₊)
      (fun _ => Icc (-((⌊L^q⌋₊*(k.natAbs+1) : ℕ) : ℤ))
        ((⌊L^q⌋₊*(k.natAbs+1) : ℕ) : ℤ))
      (fun _ => mem_product)
  · intro x hx
    obtain ⟨r, u, hr, hu, hclose⟩ := product_major_arc_finite_cover hk hU hV hscale
      ⟨hx.2.1.le, hx.2.2⟩ hx.1
    refine ⟨(r,u), mem_product.mpr ⟨hr,hu⟩, ?_⟩
    dsimp only [C, Set.mem_Icc]
    have hh := abs_le.mp hclose
    constructor <;> linarith

end Bounty
end

section

/- On a fixed residual gcd slice the rational phase separates in a finite four-factor box. -/

open Finset
open scoped Classical

namespace Bounty

theorem rational_four_factor_uniform_box_expansion {r Q d : ℕ}
    (hr : 0 < r) (hrQ : r ≤ Q) (hd : 0 < d) (hdr : d ∣ r) (u : ℤ)
    (M A P N : Finset ℕ)
    (hM : ∀ m ∈ M, m.Coprime r) (hA : ∀ a ∈ A, a.Coprime r)
    (hP : ∀ p ∈ P, p.Coprime r) (hN : ∀ n ∈ N, n.gcd r = d)
    :
    ∃ c : AddChar (Additive (ZMod (r / d))ˣ) ℂ → ℂ,
      (∑ ψ, ‖c ψ‖) ≤ Real.sqrt (Q : ℝ) ∧
      ∀ α δ β γ : ℕ → ℂ,
      (∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P, ∑ n ∈ N,
        (α m * δ a * β p * γ n) *
          Complex.exp (Complex.I * (2 * Real.pi * ((u : ℝ) / r * (m * a * p * n)) : ℝ))) =
        ∑ ψ, c ψ *
          (∑ m ∈ M, α m * unitAddCharDirichlet ψ (m : ZMod (r / d))) *
          (∑ a ∈ A, δ a * unitAddCharDirichlet ψ (a : ZMod (r / d))) *
          (∑ p ∈ P, β p * unitAddCharDirichlet ψ (p : ZMod (r / d))) *
          (∑ n ∈ N, γ n * unitAddCharDirichlet ψ ((n / d : ℕ) : ZMod (r / d))) := by
  obtain ⟨c, hc, he⟩ := rational_four_factor_gcd_slice_expansion hr hrQ hd hdr u
  refine ⟨c, hc, ?_⟩
  intro α δ β γ
  calc
    _ = ∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P, ∑ n ∈ N, ∑ ψ,
        c ψ * (α m * unitAddCharDirichlet ψ (m : ZMod (r / d))) *
          (δ a * unitAddCharDirichlet ψ (a : ZMod (r / d))) *
          (β p * unitAddCharDirichlet ψ (p : ZMod (r / d))) *
          (γ n * unitAddCharDirichlet ψ ((n / d : ℕ) : ZMod (r / d))) := by
      apply sum_congr rfl
      intro m hm
      apply sum_congr rfl
      intro a ha
      apply sum_congr rfl
      intro p hp
      apply sum_congr rfl
      intro n hn
      rw [← he m a p n (hM m hm) (hA a ha) (hP p hp) (hN n hn), mul_sum]
      apply sum_congr rfl
      intro ψ _
      ring
    _ = ∑ ψ, ∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P, ∑ n ∈ N,
        c ψ * (α m * unitAddCharDirichlet ψ (m : ZMod (r / d))) *
          (δ a * unitAddCharDirichlet ψ (a : ZMod (r / d))) *
          (β p * unitAddCharDirichlet ψ (p : ZMod (r / d))) *
          (γ n * unitAddCharDirichlet ψ ((n / d : ℕ) : ZMod (r / d))) := by
      conv_lhs =>
        arg 2
        ext m
        arg 2
        ext a
        arg 2
        ext p
        rw [sum_comm]
      conv_lhs =>
        arg 2
        ext m
        arg 2
        ext a
        rw [sum_comm]
      conv_lhs =>
        arg 2
        ext m
        rw [sum_comm]
      rw [sum_comm]
    _ = _ := by
      simp only [← mul_sum, ← sum_mul]

end Bounty
end

section

/- Recombine every residual gcd slice with one frequency-independent coefficient family. -/

open Finset
open scoped Classical
namespace Bounty

theorem sum_eq_sum_residual_gcd_slices {r : ℕ} (hr : 0 < r)
    (N : Finset ℕ) (F : ℕ → ℂ) :
    (∑ n ∈ N, F n) = ∑ d ∈ r.divisors, ∑ n ∈ N.filter (fun n => n.gcd r = d), F n := by
  exact (sum_fiberwise_of_maps_to
    (fun n _ => Nat.mem_divisors.mpr ⟨Nat.gcd_dvd_right n r, hr.ne'⟩) F).symm

theorem rational_four_factor_full_gcd_box_expansion {r Q : ℕ}
    (hr : 0 < r) (hrQ : r ≤ Q) (u : ℤ)
    (M A P N : Finset ℕ)
    (hM : ∀ m ∈ M, m.Coprime r) (hA : ∀ a ∈ A, a.Coprime r)
    (hP : ∀ p ∈ P, p.Coprime r) :
    ∃ c : (d : ℕ) → AddChar (Additive (ZMod (r/d))ˣ) ℂ → ℂ,
      (∑ d ∈ r.divisors, ∑ ψ, ‖c d ψ‖) ≤ (r.divisors.card : ℝ)*Real.sqrt (Q : ℝ) ∧
      (r.divisors.card : ℝ)*Real.sqrt (Q : ℝ) ≤ (Q : ℝ)*Real.sqrt (Q : ℝ) ∧
      ∀ α δ β γ : ℕ → ℂ,
      (∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P, ∑ n ∈ N,
        (α m*δ a*β p*γ n)*
          Complex.exp (Complex.I*(2*Real.pi*((u : ℝ)/r*(m*a*p*n)) : ℝ))) =
        ∑ d ∈ r.divisors, ∑ ψ, c d ψ *
          (∑ m ∈ M, α m*unitAddCharDirichlet ψ (m : ZMod (r/d))) *
          (∑ a ∈ A, δ a*unitAddCharDirichlet ψ (a : ZMod (r/d))) *
          (∑ p ∈ P, β p*unitAddCharDirichlet ψ (p : ZMod (r/d))) *
          (∑ n ∈ N.filter (fun n => n.gcd r = d),
            γ n*unitAddCharDirichlet ψ ((n/d : ℕ) : ZMod (r/d))) := by
  have hex (d : ℕ) : ∃ c : AddChar (Additive (ZMod (r/d))ˣ) ℂ → ℂ,
      (∑ ψ, ‖c ψ‖) ≤ Real.sqrt (Q : ℝ) ∧
      (d ∈ r.divisors →
        ∀ m a p n : ℕ, m.Coprime r → a.Coprime r → p.Coprime r → n.gcd r = d →
          (∑ ψ, c ψ*unitAddCharDirichlet ψ (m : ZMod (r/d))*
            unitAddCharDirichlet ψ (a : ZMod (r/d))*
            unitAddCharDirichlet ψ (p : ZMod (r/d))*
            unitAddCharDirichlet ψ ((n/d : ℕ) : ZMod (r/d))) =
              Complex.exp (Complex.I*(2*Real.pi*((u : ℝ)/r*(m*a*p*n)) : ℝ))) := by
    by_cases hd : d ∈ r.divisors
    · obtain ⟨c, hc, he⟩ := rational_four_factor_gcd_slice_expansion hr hrQ
        (Nat.pos_of_mem_divisors hd) (Nat.dvd_of_mem_divisors hd) u
      exact ⟨c, hc, fun _ => he⟩
    · refine ⟨fun _ => 0, ?_, fun h => (hd h).elim⟩
      simp
  choose c hc using hex
  have hmass : (∑ d ∈ r.divisors, ∑ ψ, ‖c d ψ‖) ≤
      (r.divisors.card : ℝ)*Real.sqrt (Q : ℝ) := by
    calc
      _ ≤ ∑ _d ∈ r.divisors, Real.sqrt (Q : ℝ) := sum_le_sum (fun d _ => (hc d).1)
      _ = _ := by simp
  have hcard : (r.divisors.card : ℝ) ≤ (Q : ℝ) := by
    exact_mod_cast (Nat.card_divisors_le_self r).trans hrQ
  refine ⟨c, hmass, mul_le_mul_of_nonneg_right hcard (Real.sqrt_nonneg _), ?_⟩
  intro α δ β γ
  calc
    _ = ∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P, ∑ d ∈ r.divisors,
        ∑ n ∈ N.filter (fun n => n.gcd r = d),
          (α m*δ a*β p*γ n)*
            Complex.exp (Complex.I*(2*Real.pi*((u : ℝ)/r*(m*a*p*n)) : ℝ)) := by
      apply sum_congr rfl
      intro m _
      apply sum_congr rfl
      intro a _
      apply sum_congr rfl
      intro p _
      exact sum_eq_sum_residual_gcd_slices hr N _
    _ = ∑ d ∈ r.divisors, ∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P,
        ∑ n ∈ N.filter (fun n => n.gcd r = d),
          (α m*δ a*β p*γ n)*
            Complex.exp (Complex.I*(2*Real.pi*((u : ℝ)/r*(m*a*p*n)) : ℝ)) := by
      conv_lhs =>
        arg 2
        ext m
        arg 2
        ext a
        rw [sum_comm]
      conv_lhs =>
        arg 2
        ext m
        rw [sum_comm]
      rw [sum_comm]
    _ = _ := by
      apply sum_congr rfl
      intro d hd
      calc
        _ = ∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P,
            ∑ n ∈ N.filter (fun n => n.gcd r = d), ∑ ψ,
            c d ψ * (α m*unitAddCharDirichlet ψ (m : ZMod (r/d))) *
              (δ a*unitAddCharDirichlet ψ (a : ZMod (r/d))) *
              (β p*unitAddCharDirichlet ψ (p : ZMod (r/d))) *
              (γ n*unitAddCharDirichlet ψ ((n/d : ℕ) : ZMod (r/d))) := by
          apply sum_congr rfl
          intro m hm
          apply sum_congr rfl
          intro a ha
          apply sum_congr rfl
          intro p hp
          apply sum_congr rfl
          intro n hn
          rw [← (hc d).2 hd m a p n (hM m hm) (hA a ha) (hP p hp) (mem_filter.mp hn).2,
            mul_sum]
          apply sum_congr rfl
          intro ψ _
          ring
        _ = ∑ ψ, ∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P,
            ∑ n ∈ N.filter (fun n => n.gcd r = d),
            c d ψ * (α m*unitAddCharDirichlet ψ (m : ZMod (r/d))) *
              (δ a*unitAddCharDirichlet ψ (a : ZMod (r/d))) *
              (β p*unitAddCharDirichlet ψ (p : ZMod (r/d))) *
              (γ n*unitAddCharDirichlet ψ ((n/d : ℕ) : ZMod (r/d))) := by
          conv_lhs =>
            arg 2
            ext m
            arg 2
            ext a
            arg 2
            ext p
            rw [sum_comm]
          conv_lhs =>
            arg 2
            ext m
            arg 2
            ext a
            rw [sum_comm]
          conv_lhs =>
            arg 2
            ext m
            rw [sum_comm]
          rw [sum_comm]
        _ = _ := by simp only [← mul_sum, ← sum_mul]

theorem rational_four_factor_full_gcd_mellin_expansion {r Q : ℕ}
    (hr : 0 < r) (hrQ : r ≤ Q) (u : ℤ)
    (M A P N : Finset ℕ)
    (hM : ∀ m ∈ M, m.Coprime r) (hA : ∀ a ∈ A, a.Coprime r)
    (hP : ∀ p ∈ P, p.Coprime r)
    (hMp : ∀ m ∈ M, 0 < m) (hAp : ∀ a ∈ A, 0 < a)
    (hPp : ∀ p ∈ P, 0 < p) (hNp : ∀ n ∈ N, 0 < n) :
    ∃ c : (d : ℕ) → AddChar (Additive (ZMod (r/d))ˣ) ℂ → ℂ,
      (∑ d ∈ r.divisors, ∑ ψ, ‖c d ψ‖) ≤ (r.divisors.card : ℝ)*Real.sqrt (Q : ℝ) ∧
      (r.divisors.card : ℝ)*Real.sqrt (Q : ℝ) ≤ (Q : ℝ)*Real.sqrt (Q : ℝ) ∧
      ∀ (α δ β γ : ℕ → ℂ) (t : ℝ),
      (∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P, ∑ n ∈ N,
        (α m*δ a*β p*γ n)*harmonicMellinWeight t ((m*a*p*n : ℕ) : ℝ)*
          Complex.exp (Complex.I*(2*Real.pi*((u : ℝ)/r*(m*a*p*n)) : ℝ))) =
        ∑ d ∈ r.divisors, ∑ ψ, c d ψ *
          (∑ m ∈ M, (α m*harmonicMellinWeight t m)*unitAddCharDirichlet ψ (m : ZMod (r/d))) *
          (∑ a ∈ A, (δ a*harmonicMellinWeight t a)*unitAddCharDirichlet ψ (a : ZMod (r/d))) *
          (∑ p ∈ P, (β p*harmonicMellinWeight t p)*unitAddCharDirichlet ψ (p : ZMod (r/d))) *
          (∑ n ∈ N.filter (fun n => n.gcd r = d),
            (γ n*harmonicMellinWeight t n)*unitAddCharDirichlet ψ ((n/d : ℕ) : ZMod (r/d))) := by
  obtain ⟨c, hc, hQ, he⟩ := rational_four_factor_full_gcd_box_expansion hr hrQ u M A P N hM hA hP
  refine ⟨c, hc, hQ, ?_⟩
  intro α δ β γ t
  rw [← he (fun m => α m*harmonicMellinWeight t m)
    (fun a => δ a*harmonicMellinWeight t a) (fun p => β p*harmonicMellinWeight t p)
    (fun n => γ n*harmonicMellinWeight t n)]
  apply sum_congr rfl
  intro m hm
  apply sum_congr rfl
  intro a ha
  apply sum_congr rfl
  intro p hp
  apply sum_congr rfl
  intro n hn
  rw [harmonic_mellin_weight_four_factors t (hMp m hm) (hAp a ha) (hPp p hp) (hNp n hn)]
  ring

end Bounty
end

section

/- The actual conjugated cell character times a Mellin phase has unit bound
and remains in its original logarithmic cell. -/

open Finset
open scoped Classical
namespace Bounty

theorem prime_cell_phased_conjugate_norm {I : Type*} [Fintype I]
    (P : I → Finset ℕ) (h : ℝ) (d : ℤ) {Q : ℕ} (χ : BoundedPrimitiveCharacter Q)
    (ζ : ℝ) (x : ∀ i, P i) :
    ‖(starRingEnd ℂ) (primeProductCellCharacter P h d χ x) *
      physicalPhase ζ (∏ i, (x i).val)‖ ≤ 1 := by
  rw [norm_mul, Complex.norm_conj, physical_phase_norm, mul_one]
  exact prime_product_cell_character_norm P h d χ x

theorem prime_cell_phased_conjugate_range {I : Type*} [Fintype I]
    (P : I → Finset ℕ) {h : ℝ} (hh : 0 < h) (d : ℤ)
    {Q : ℕ} (χ : BoundedPrimitiveCharacter Q) (ζ : ℝ) (x : ∀ i, P i)
    (hpos : 0 < ∏ i, (x i).val)
    (hx : (starRingEnd ℂ) (primeProductCellCharacter P h d χ x) *
      physicalPhase ζ (∏ i, (x i).val) ≠ 0) :
    Real.exp (((d : ℝ)-1)*h) < (∏ i, (x i).val : ℕ) ∧
      (∏ i, (x i).val : ℕ) ≤ Real.exp ((d : ℝ)*h) := by
  have hchar : primeProductCellCharacter P h d χ x ≠ 0 := by
    intro he
    exact hx (by rw [he, map_zero, zero_mul])
  exact (upper_log_cell_nat_eq_iff hh hpos d).mp (prime_cell_character_mem P h d χ x hchar)

end Bounty
end

section

/- The finite retained-cell coefficient sum with its exact mass normalization. -/

open Finset
open scoped Classical
namespace Bounty

theorem finite_retained_log_cells_card {X : Type*} [Fintype X]
    (μ z : X → ℝ) {h ξ L : ℝ} (hh : 0 < h) (hL : 0 ≤ L)
    (hz : ∀ x, 0 ≤ z x ∧ z x ≤ L) :
    ((finiteRetainedCells μ (fun x => upperLogCell h (z x)) ξ).card : ℝ) ≤ L/h+2 := by
  have hcard : (finiteRetainedCells μ (fun x => upperLogCell h (z x)) ξ).card ≤
      (finiteOccupiedCells (fun x => upperLogCell h (z x))).card := card_filter_le _ _
  have hr := upper_log_occupied_cells_card_real_le z hh hL hz
  exact (Nat.cast_le.mpr hcard).trans (by simpa only [sub_zero] using hr)

theorem prime_retained_cell_expansion_cost {I : Type*} [Fintype I] [dI : DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ) (Q : ℕ) {h ξ L : ℝ}
    (hh : 0 < h) (hξ : 0 < ξ) (hL : 0 ≤ L)
    (hrange : ∀ x : (∀ i, P i),
      0 ≤ Real.log (∏ i, (x i).val : ℕ) ∧ Real.log (∏ i, (x i).val : ℕ) ≤ L) :
    (∑ d ∈ primeProductRetainedCells P V h ξ, ∑ _χ : BoundedPrimitiveCharacter Q,
      ‖((1 / finiteCellMass (finiteProductWeight (physicalLabelLaw (P := P) V))
        (fun z => upperLogCell h (Real.log (∏ i, (z i).val : ℕ))) d : ℝ) : ℂ)‖) ≤
      (L / h + 2) * (Q * Q : ℕ) / ξ := by
  cases Subsingleton.elim dI (Classical.typeDecidableEq I)
  have hc : ((primeProductRetainedCells P V h ξ).card : ℝ) ≤ L / h + 2 :=
    finite_retained_log_cells_card
      (finiteProductWeight (physicalLabelLaw (P := P) V))
      (fun z : (∀ i, P i) => Real.log (∏ i, (z i).val : ℕ)) hh hL hrange
  exact (prime_cell_expansion_cost P V Q h _ hξ
    (fun _ hd => prime_product_retained_cell_mass P V h ξ hd)).trans
      (div_le_div_of_nonneg_right
        (mul_le_mul_of_nonneg_right hc (Nat.cast_nonneg _)) hξ.le)

end Bounty
end

section

/- Harmonic summation of the extracted prime-character bound for the actual Q weight. -/

open Finset

namespace Bounty

theorem candidate_Q_character_bound_of_prime_bound (c L : ℝ) (r jStar : ℕ)
    (hr : 0 < r) (hj : 0 < jStar) (S : Finset ℕ) {d : ℕ}
    (χ : DirichletCharacter ℂ d) (h : ℕ) (X H : ℝ) (hX : 0 ≤ X) (hH : 0 ≤ H)
    (hprime : ∀ y : ∀ slot, candidateQRestChoices c L r jStar hr slot,
      ‖∑ p ∈ ((candidateQBand (c*L) 0).filter (fun p =>
        p * orderedSlotProduct (candidateQRestChoices c L r jStar hr) y ∈ S)).filter
          (fun p => p.Coprime h), χ (p : ZMod d)‖ ≤
        (X / (orderedSlotProduct (candidateQRestChoices c L r jStar hr) y : ℝ)) * H) :
    ‖∑ n ∈ S.filter (fun n => n.Coprime h),
      (candidateQWeight c L r jStar n : ℂ) * χ (n : ZMod d)‖ ≤
        X * H * candidateQRestHarmonicMass c L r jStar hr := by
  classical
  let N : ℝ := (r.factorial : ℝ)^(candidateQIndices c L).card
  have hN : 0 < N := by dsimp only [N]; positivity
  have hn : ‖(1 / (N : ℂ))‖ = 1/N := by
    rw [norm_div, norm_one, Complex.norm_real, Real.norm_of_nonneg hN.le]
  have heq := candidate_Q_zero_character_window_split c L r jStar hr hj S χ h (fun _ => 1)
  simp only [mul_one] at heq
  rw [heq, ← Complex.ofReal_pow]
  change ‖(1 / (N : ℂ)) * _‖ ≤ _
  rw [norm_mul, hn]
  calc
    _ ≤ (1/N) * ∑ y : ∀ slot, candidateQRestChoices c L r jStar hr slot,
        ‖if (orderedSlotProduct (candidateQRestChoices c L r jStar hr) y).Coprime h then
          χ (orderedSlotProduct (candidateQRestChoices c L r jStar hr) y : ZMod d) *
            ∑ p ∈ ((candidateQBand (c*L) 0).filter (fun p =>
              p * orderedSlotProduct (candidateQRestChoices c L r jStar hr) y ∈ S)).filter
                (fun p => p.Coprime h), χ (p : ZMod d)
        else 0‖ := mul_le_mul_of_nonneg_left (norm_sum_le _ _) (by positivity)
    _ ≤ (1/N) * ∑ y : ∀ slot, candidateQRestChoices c L r jStar hr slot,
        (X / (orderedSlotProduct (candidateQRestChoices c L r jStar hr) y : ℝ)) * H := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      apply sum_le_sum
      intro y _
      split_ifs with hy
      · rw [norm_mul]
        exact (mul_le_of_le_one_left (norm_nonneg _) (χ.norm_le_one _)).trans (hprime y)
      · simp only [norm_zero]
        positivity
    _ = _ := by
      rw [candidate_Q_rest_harmonic_eq_tuple_sum, mul_sum, mul_sum]
      apply sum_congr rfl
      intro y _
      dsimp only [N]
      ring

end Bounty

end

section

/- The full actual prime comparison block with structural vanishing and probe bounds discharged. -/

namespace Bounty

open Finset
open scoped Classical

noncomputable def primeActivePhase {I : Type*} (P : I → Finset ℕ)
    (active : Finset I) (ζ Θ : ℝ) (x : ∀ i, P i) : ℂ :=
  primeTuplePhase ζ Θ (∏ i ∈ active, (x i).val)

theorem prime_active_phase_norm {I : Type*} (P : I → Finset ℕ)
    (active : Finset I) (ζ Θ : ℝ) (x : ∀ i, P i) :
    ‖primeActivePhase P active ζ Θ x‖ = 1 :=
  prime_tuple_phase_norm ζ Θ _

theorem prime_asymmetric_grouped_block_bound {G : Type*} [Fintype G] [DecidableEq G]
    {I : G → Type*} [∀ g, Fintype (I g)] [∀ g, DecidableEq (I g)]
    (P : G → Finset ℕ) (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (hP : ∀ g p, p ∈ P g → 0 < p)
    (hmass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (probes tails : ∀ g, Finset (I g)) (hpt : ∀ g, Disjoint (probes g) (tails g))
    (m ell : ℕ) (hm : 0 < m) (hp : ∀ g, (probes g).card = m) (ht : ∀ g, (tails g).card = ell)
    (s t : Finset G) (hst : Disjoint s t) (active : Finset (Sigma I))
    (Q : ℕ) (h : ℝ) (keptA keptB : Finset (Sigma I) → Finset ℤ) (ζ Θ : ℝ)
    (f g : (∀ g, I g → P g) → ℂ)
    (hf : ∀ a, finiteGroupSlotSymmetric a f) (hg : ∀ a, finiteGroupSlotSymmetric a g)
    (ε : ℝ) (hε : 0 ≤ ε)
    (herr : ∀ S ∈ (s.sigma probes).powerset, ∀ T ∈ (t.sigma probes).powerset,
      ∀ A ∈ cleanNonemptySubsets (s.sigma probes \ S),
      ∀ B ∈ cleanNonemptySubsets (t.sigma probes \ T),
        ‖cleanKernelPairing (finiteProductWeight (fun a : Sigma I => physicalLabelLaw V a.1))
            (primeAsymmetricComparisonKernel (fun a : Sigma I => P a.1) (fun a => V a.1)
              active Q h keptA keptB ζ Θ A B)
            (finiteCoordinateComponent (fun a : Sigma I => physicalLabelLaw V a.1) S (s.sigma probes).toList
              (finiteGroupedTailTest (physicalLabelLaw V) tails f))
            (finiteCoordinateComponent (fun a : Sigma I => physicalLabelLaw V a.1) T (t.sigma probes).toList
              (finiteGroupedTailTest (physicalLabelLaw V) tails g)) -
          cleanRawPairing (finiteProductWeight (fun a : Sigma I => physicalLabelLaw V a.1))
            (primeActivePhase (fun a : Sigma I => P a.1) active ζ Θ)
            (finiteCoordinateComponent (fun a : Sigma I => physicalLabelLaw V a.1) S (s.sigma probes).toList
              (finiteGroupedTailTest (physicalLabelLaw V) tails f))
            (finiteCoordinateComponent (fun a : Sigma I => physicalLabelLaw V a.1) T (t.sigma probes).toList
              (finiteGroupedTailTest (physicalLabelLaw V) tails g))‖ ≤
        ε * Real.sqrt (finiteWeightedEnergy (finiteProductWeight (fun a : Sigma I => physicalLabelLaw V a.1))
          (finiteCoordinateComponent (fun a : Sigma I => physicalLabelLaw V a.1) S (s.sigma probes).toList
            (finiteGroupedTailTest (physicalLabelLaw V) tails f))) *
          Real.sqrt (finiteWeightedEnergy (finiteProductWeight (fun a : Sigma I => physicalLabelLaw V a.1))
            (finiteCoordinateComponent (fun a : Sigma I => physicalLabelLaw V a.1) T (t.sigma probes).toList
              (finiteGroupedTailTest (physicalLabelLaw V) tails g)))) :
    ‖cleanRawPairing (finiteProductWeight (fun a : Sigma I => physicalLabelLaw V a.1))
            (primeActivePhase (fun a : Sigma I => P a.1) active ζ Θ)
        (finiteGroupedTailTest (physicalLabelLaw V) tails f) (finiteGroupedTailTest (physicalLabelLaw V) tails g) -
      ∑ A ∈ cleanNonemptySubsets (s.sigma probes), ∑ B ∈ cleanNonemptySubsets (t.sigma probes),
        (-1 : ℂ) ^ (A.card + B.card) *
          cleanKernelPairing (finiteProductWeight (fun a : Sigma I => physicalLabelLaw V a.1))
            (primeAsymmetricComparisonKernel (fun a : Sigma I => P a.1) (fun a => V a.1)
              active Q h keptA keptB ζ Θ A B)
            (finiteGroupedTailTest (physicalLabelLaw V) tails f) (finiteGroupedTailTest (physicalLabelLaw V) tails g)‖ ≤
      (Real.sqrt (((ell : ℝ) ^ ell / (m : ℝ) ^ ell) ^ s.card) +
        Real.sqrt (((ell : ℝ) ^ ell / (m : ℝ) ^ ell) ^ t.card) +
        (3 : ℝ) ^ ((s.sigma probes).card + (t.sigma probes).card) * ε) *
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight
          (fun g => finiteProductWeight (fun _ : I g => physicalLabelLaw V g))) f) *
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight
          (fun g => finiteProductWeight (fun _ : I g => physicalLabelLaw V g))) g) := by
  have hμ : ∀ g (x : P g), 0 ≤ physicalLabelLaw V g x :=
    physical_label_law_nonneg V (fun g => (hV g).le)
  have hmμ : ∀ g, ∑ x : P g, physicalLabelLaw V g x = 1 :=
    fun g => physical_label_law_sum V g (hV g) (hmass g)
  have hnμ : ∀ g (x : P g), physicalLabelLaw V g x ≠ 0 := by
    intro g x
    unfold physicalLabelLaw
    apply div_ne_zero one_ne_zero
    exact mul_ne_zero (hV g).ne' (by exact_mod_cast (hP g x.val x.property).ne')
  exact finite_asymmetric_grouped_block_bound (physicalLabelLaw V) hμ hmμ hnμ
    probes tails hpt m ell hm hp ht s t hst active
    (primeActivePhase (fun a : Sigma I => P a.1) active ζ Θ)
    (fun x => (prime_active_phase_norm (fun a : Sigma I => P a.1) active ζ Θ x).le)
    (fun A B => primeAsymmetricValue (fun a : Sigma I => P a.1) (fun a => V a.1)
      (active \ (A ∪ B)) A B Q h (keptA A) (keptB B) ζ Θ)
    f g hf hg ε hε herr

end Bounty
end

section

/- The globally defined physical row family inherits the full-state energy
bound with the exact endpoint phase, original weights and total cutoffs. -/

namespace Bounty

section Physical
variable {I K : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g, ∀ p : ↥(P g), NeZero p.val]
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (retention : I → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

theorem physical_full_ledger_rows_energy_le
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 < β g p / V g) (hmass : ∀ g, ∑ p, β g p / V g ≤ 2)
    (hq0 : ∀ i, 0 ≤ retention i) (hq1 : ∀ i, retention i ≤ 1)
    (hD : ∀ i, retention i / ρ ^ 2 + ((1 - retention i) / ρ) / v ≤ 1)
    (hC : ∀ i g, retention i / ρ ^ 2 + ((1 - retention i) * V g / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ j g, ell + (C j g).card ≤ T)
    (steps : List (Option (I ⊕ K)))
    (initial : PhysicalFullBoundedState P J ell B →
      (g : Fin N) → Finset ↥(P g))
    (f : PhysicalFullBoundedState P J ell B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight (fun g p => β g p / V g)
      (fun g => unrestrictedResidueWeight (fun p => β g p / V g)))
      (fun x => finiteOperatorListAction (physicalFullLedgerRow C k ω β retention ρ V) steps
        (fun s => f s.2) (initial x, x)) ≤
    (steps.map (fullPermutationMixedStepEnergy ρ v vmin vmax T N)).prod *
      finiteWeightedEnergy (productMemoryWeight (fun g p => β g p / V g)
      (fun g => unrestrictedResidueWeight (fun p => β g p / V g))) f := by
  exact full_mixed_ledger_rows_energy_le (fun g (p : ↥(P g)) => p.val)
    (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
    (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j))
    ω (fun g p => β g p / V g) retention ρ V hω hωmass hρ0 hρ1 hv hvmin hVlo hVhi
    hμ hmass hq0 hq1 hD hC T
    (fun j g => by simpa only [physical_full_unshared_indices_card] using ht j g)
    steps initial
    (fun j H x e => physicalFullGlobalEdgePhase (C j) (k j) H (ω j)
      (fun g p => β g p / V g) ρ V x e)
    (fun j H x e => physical_full_global_edge_phase_norm_le (C j) (k j) H (ω j)
      (fun g p => β g p / V g) ρ V x e) f hf

end Physical
end Bounty
end

section

/- At each physical visit, the full continuation passes through the raw
ghost row exactly, with the existing full ledger/memory target. The chosen
physical slot enumeration may be any current pattern. -/

namespace Bounty

section Physical
variable {I K : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g, ∀ p : ↥(P g), NeZero p.val]
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (retention : I → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

theorem physical_full_global_ghost_row (j : I) (D : Fin N → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (H : (g : Fin N) → Finset ↥(P g))
    (q : (g : Fin N) → BoundedOrderedTuple
      (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B)
    (a : (g : Fin N) → ↥(P g) → Bool) (hV : ∀ g, V g ≠ 0)
    (F : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ) :
    globalBirthJointCutRawRow
      (fun g => GlobalBirthRawStep.visit (a := a g) (fun _ => 0) (β g)
        (1 - retention j) (V g) ρ (hV g) B) B B (physicalFullContinuation D L F)
      (fun g => (H g, boundedOrderedTupleToFinite (q g))) =
    physicalFullLedgerRow C k ω β retention ρ V (some (.inl j)) F
      (H, physicalFullMemoryState D L q) := by
  exact full_mixed_raw_ghost_continuation (fun g (p : ↥(P g)) => p.val)
    (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
    (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j))
    (fun j H x e => physicalFullGlobalEdgePhase (C j) (k j) H (ω j)
      (fun g p => β g p / V g) ρ V x e) ω β retention ρ V a hV j F
    (H, physicalFullMemoryState D L q)

end Physical
end Bounty
