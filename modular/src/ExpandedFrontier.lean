/- The observed physical visit reads out to the original signed raw visit;
its existing total cutoff absorbs the bounded-memory zero extension. -/

open scoped Classical
namespace Bounty

section Physical
variable {I K : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (retention : I → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
  (hV : ∀ g, V g ≠ 0)

theorem physical_observed_visit_raw_readout (j : I)
    (F : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) :
    physicalObservedMarkRow C k ω β retention ρ V hV (some (.inl j))
      (fun _ t => F (physicalMarkRawReadout t)) s =
      globalBirthJointCutRawRow
        (fun g => GlobalBirthRawStep.visit (a := physicalGroupPhaseActivity s.1 g)
          (fun _ => 0) (β g) (1 - retention j) (V g) ρ (hV g) B)
        B B F (physicalMarkRawReadout s) := by
  unfold physicalObservedMarkRow
  dsimp only
  change globalBirthJointCutRawRow _ B B
    (physicalMarkRawExtension (B := B) (F ∘ physicalMarkRawReadout) s.1)
    (physicalMarkRawReadout s) = _
  unfold globalBirthJointCutRawRow globalBirthJointRawRow
  rw [physical_mark_raw_readout_cutoff (B := B) s.1 F]


theorem physical_observed_selected_visit (j : I)
    (F : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) :
    physicalObservedMarkRow C k ω β retention ρ V hV (some (.inl j))
      (fun o t => if o = .inr none ∧ t.1 = s.1 then F (physicalMarkRawReadout t) else 0) s =
      globalBirthJointCutRawRow
        (fun g => GlobalBirthRawStep.visit (a := physicalGroupPhaseActivity s.1 g)
          (fun _ => 0) (β g) (1 - retention j) (V g) ρ (hV g) B)
        B B F (physicalMarkRawReadout s) := by
  unfold physicalObservedMarkRow
  dsimp only
  conv_lhs =>
    arg 4
    equals (physicalMarkRawExtension (B := B) (F ∘ physicalMarkRawReadout) s.1) =>
      funext u
      unfold physicalMarkRawExtension
      split_ifs <;> simp
  unfold globalBirthJointCutRawRow globalBirthJointRawRow
  rw [physical_mark_raw_readout_cutoff (B := B) s.1 F]
  rfl

theorem physical_observed_selected_state_visit (j : I)
    (F : PhysicalBoundedMarkState P J ell B → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) :
    physicalObservedMarkRow C k ω β retention ρ V hV (some (.inl j))
      (fun o t => if o = .inr none ∧ t.1 = s.1 then F t else 0) s =
      globalBirthJointCutRawRow
        (fun g => GlobalBirthRawStep.visit (a := physicalGroupPhaseActivity s.1 g)
          (fun _ => 0) (β g) (1 - retention j) (V g) ρ (hV g) B)
        B B (physicalMarkRawExtension F s.1) (physicalMarkRawReadout s) := by
  unfold physicalObservedMarkRow
  dsimp only
  conv_lhs =>
    arg 4
    equals (physicalMarkRawExtension F s.1) =>
      funext u
      unfold physicalMarkRawExtension
      split_ifs <;> simp
  rfl

end Physical
end Bounty
