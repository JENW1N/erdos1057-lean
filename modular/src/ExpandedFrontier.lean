open Finset Filter
open scoped Topology
noncomputable def oddSquarefreeModuli (N : ℕ) : Finset ℕ :=
  (Icc 1 N).filter (fun d => Squarefree d ∧ Odd d)

theorem typeI_shifted_remainder_bound (T M : Finset ℕ) (μ : ℕ → ℝ)
    (hM : ∀ d ∈ M, 0 < d ∧ Odd d) :
    (∑ d ∈ M, |shiftedTotientSieveRemainder T μ d|) ≤
      (∑ d ∈ M, typeINonprincipalNormSum d T (fun u => (μ u : ℂ)) (fun u => u) /
        (d.totient : ℝ)) +
      ∑ d ∈ M, |(∑ u ∈ T.filter (fun u => Nat.Coprime d u), μ u) / (d.totient : ℝ) -
        (∑ u ∈ T, μ u) / (d.totient : ℝ)| := by
  rw [← sum_add_distrib]
  apply sum_le_sum
  intro d hd
  have hdecomp := @typeI_real_deviation_le ℕ d ⟨Nat.ne_of_gt (hM d hd).1⟩
    (hM d hd).2 T μ (fun u => u)
  have hfilter : T.filter (fun u => Nat.Coprime u d) =
      T.filter (fun u => Nat.Coprime d u) := by
    apply filter_congr
    intro u _
    exact Nat.coprime_comm
  rw [hfilter] at hdecomp
  unfold shiftedTotientSieveRemainder
  exact (abs_sub_le _ ((∑ u ∈ T.filter (fun u => Nat.Coprime d u), μ u) /
    (d.totient : ℝ)) _).trans (add_le_add hdecomp le_rfl)

noncomputable def candidateNonprincipalTypeIMass (c L q : ℝ) (r jStar N : ℕ) : ℝ :=
  ∑ d ∈ oddSquarefreeModuli N,
    typeINonprincipalNormSum d (arithmeticProductWindow 1 (Real.exp L))
      (fun u => (candidateCoefficient c L q r jStar u : ℂ)) (fun u => u) /
      (d.totient : ℝ)

theorem eventually_candidate_typeI_remainder_bound {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ q : ℝ, 0 ≤ q → ∀ r jStar N : ℕ,
      (N : ℝ) ≤ Real.exp L →
      (∑ d ∈ oddSquarefreeModuli N,
        |shiftedTotientSieveRemainder (arithmeticProductWindow 1 (Real.exp L))
          (candidateCoefficient c L q r jStar) d|) ≤
        candidateNonprincipalTypeIMass c L q r jStar N +
          candidateCoefficientWindowMass c L q r jStar *
            ((16 * primeEulerProductUpperConstant) * L^(-18 : ℝ)) := by
  filter_upwards [eventually_candidate_principal_coprime_loss hc] with L hprincipal
  intro q hq r jStar N hN
  have hM : ∀ d ∈ oddSquarefreeModuli N, 0 < d ∧ Odd d := by
    intro d hd
    exact ⟨(mem_Icc.mp (mem_filter.mp hd).1).1, (mem_filter.mp hd).2.2⟩
  apply (typeI_shifted_remainder_bound (arithmeticProductWindow 1 (Real.exp L))
    (oddSquarefreeModuli N) (candidateCoefficient c L q r jStar) hM).trans
  apply add_le_add le_rfl
  apply le_trans _ (hprincipal q hq r jStar N hN)
  apply sum_le_sum_of_subset_of_nonneg
  · intro d hd
    exact mem_filter.mpr ⟨(mem_filter.mp hd).1, (mem_filter.mp hd).2.1⟩
  · intro d _ _
    exact abs_nonneg _
end

