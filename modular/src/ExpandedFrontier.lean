/- A bounded chronological record predicate selects the actual local rows
of the encoded physical event model, without changing any event coefficient. -/

open Finset
open scoped Classical

namespace Bounty

section FullRecord
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g, ∀ p : ↥(P g), NeZero p.val]
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (k : Fin n → ℤ) (β : (g : Fin N) → ↥(P g) → ℝ)
  (V : Fin N → ℝ) (ρ : ℝ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)
  (cut : ℕ → Fin N → Finset (Fin J))

noncomputable def physicalSelectedFineFullRow (i : ℕ)
    (F : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ) :=
  physicalFullObservedRow C k ω β retention ρ V (cut i) (cut (i + 1)) (physicalSelectedFineTag n i)
    (fun o t => if physicalSelectedFineEncodedTest C aux L σ τ cut i o t then F t else 0)

theorem physical_selected_full_record_eq_local (steps : ℕ)
    (F : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ)
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B) :
    finiteRowComposition (S := fun _ =>
      List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C) ×
        FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
      (fun i => physicalFullRecordedRow C k ω β retention ρ V
        (physicalSelectedFineTag n i) (cut i) (cut (i + 1)) (physicalFullTraceAppend C)) steps
      (fun r => physicalSelectedFineRecordMask C aux L σ τ cut steps r.1 * F r.2) ([], s) =
    finiteRowComposition (S := fun _ =>
      FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
      (physicalSelectedFineFullRow C aux L σ τ k β V ρ ω retention cut) steps F s := by
  let _ : ∀ i s, Fintype (PhysicalFullLedgerEvent (P := P) (ell := ell) (B := B)
      C k (physicalSelectedFineTag n i) s) :=
    fun i s => physicalFullLedgerEventFintype C k (physicalSelectedFineTag n i) s
  have hrows (i : ℕ) :
      physicalSelectedFineFullRow C aux L σ τ k β V ρ ω retention cut i =
      finiteLocalPhasedRow
        (fun i => PhysicalFullLedgerEvent (P := P) (ell := ell) (B := B) C k (physicalSelectedFineTag n i))
        (fun i => physicalFullLedgerEventTarget C k (physicalSelectedFineTag n i))
        (fun i x e => if physicalSelectedFineTraceTest C aux L σ τ cut i
            (physicalFullTraceObservation C k (physicalSelectedFineTag n) cut i x e)
          then physicalFullLedgerEventPhase C k ω β ρ V (physicalSelectedFineTag n i) x e else 0)
        (fun i => physicalFullLedgerEventWeight C k ω β retention ρ V (physicalSelectedFineTag n i)) i := by
    funext F x
    unfold physicalSelectedFineFullRow physicalFullObservedRow fullMixedObservedRow finiteLocalPhasedRow
    apply sum_congr
    · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
    · intro e _
      unfold physicalSelectedFineTraceTest physicalFullTraceObservation
        physicalFullLedgerEventPhase physicalFullLedgerEventWeight physicalFullLedgerEventTarget
      dsimp only
      split_ifs <;> simp only [mul_zero, zero_mul]
  simp_rw [physical_full_trace_row_eq C k ω β retention ρ V (physicalSelectedFineTag n) cut]
  rw [finite_row_composition_eq_operator_list, finite_row_composition_eq_operator_list]
  have hf := finite_recorded_filtered_rows_eq_local_rows
    (fun i => PhysicalFullLedgerEvent (P := P) (ell := ell) (B := B) C k (physicalSelectedFineTag n i))
    (fun i => physicalFullLedgerEventTarget C k (physicalSelectedFineTag n i))
    (physicalFullTraceObservation C k (physicalSelectedFineTag n) cut)
    (fun i => physicalFullLedgerEventPhase C k ω β ρ V (physicalSelectedFineTag n i))
    (fun i => physicalFullLedgerEventWeight C k ω β retention ρ V (physicalSelectedFineTag n i))
    (physicalSelectedFineTraceTest C aux L σ τ cut) (List.range steps) F s
  rw [← funext hrows] at hf
  simpa only [physicalFullTraceRow, physicalSelectedFineRecordMask] using hf

end FullRecord
end Bounty
