section

/- The four actual fine-schedule tags at their chronological positions. -/

namespace Bounty

theorem physical_fine_tag_visit {n : ℕ} (j : Fin (n + 1)) :
    physicalSelectedFineTag n (4 * j.val) = some (.inl j) := by
  have hj := j.isLt
  have hi : 4 * j.val < 4 * n + 1 := by omega
  have h0 : (4 * j.val) % 4 = 0 := by omega
  have he (h : (4 * j.val) / 4 < n + 1) : (⟨(4 * j.val) / 4, h⟩ : Fin (n + 1)) = j :=
    Fin.ext (show (4 * j.val) / 4 = j.val from by omega)
  simp only [physicalSelectedFineTag, dif_pos hi, dif_pos h0, he]

theorem physical_fine_tag_source_permutation {n : ℕ} (j : Fin n) :
    physicalSelectedFineTag n (4 * j.val + 1) = none := by
  have hj := j.isLt
  have hi : 4 * j.val + 1 < 4 * n + 1 := by omega
  have h0 : ¬ (4 * j.val + 1) % 4 = 0 := by omega
  have h2 : ¬ (4 * j.val + 1) % 4 = 2 := by omega
  simp only [physicalSelectedFineTag, dif_pos hi, dif_neg h0, dif_neg h2]

theorem physical_fine_tag_edge {n : ℕ} (j : Fin n) :
    physicalSelectedFineTag n (4 * j.val + 2) = some (.inr j) := by
  have hj := j.isLt
  have hi : 4 * j.val + 2 < 4 * n + 1 := by omega
  have h0 : ¬ (4 * j.val + 2) % 4 = 0 := by omega
  have h2 : (4 * j.val + 2) % 4 = 2 := by omega
  have he (h : (4 * j.val + 2) / 4 < n) : (⟨(4 * j.val + 2) / 4, h⟩ : Fin n) = j :=
    Fin.ext (show (4 * j.val + 2) / 4 = j.val from by omega)
  simp only [physicalSelectedFineTag, dif_pos hi, dif_neg h0, dif_pos h2, he]

theorem physical_fine_tag_target_permutation {n : ℕ} (j : Fin n) :
    physicalSelectedFineTag n (4 * j.val + 3) = none := by
  have hj := j.isLt
  have hi : 4 * j.val + 3 < 4 * n + 1 := by omega
  have h0 : ¬ (4 * j.val + 3) % 4 = 0 := by omega
  have h2 : ¬ (4 * j.val + 3) % 4 = 2 := by omega
  simp only [physicalSelectedFineTag, dif_pos hi, dif_neg h0, dif_neg h2]

end Bounty
