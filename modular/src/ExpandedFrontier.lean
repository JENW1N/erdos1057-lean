theorem tilted_full_pattern_vacuum_pairing_le
    (hω : ∀ i k c a, 0 ≤ ω i k c a)
    (hωmass : ∀ i k c, ∑ a, ω i k c a ≤ 1)
    {qmax vmin vmax : ℝ} (hqmax0 : 0 ≤ qmax) (hqmax1 : qmax < 1)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hq0 : ∀ i j, 0 ≤ q i j) (hqmax : ∀ i j, q i j ≤ qmax)
    (T : ℕ) (ht : ∀ i k g, (S i k g)ᶜ.card ≤ T)
    {L R : ℝ} (hL : 1 ≤ L) (hR : 0 ≤ R)
    (hgroups : (Fintype.card G : ℝ) ≤ R * Real.log L)
    (steps : I → List (Option (J ⊕ K)))
    (allowed : ∀ i s, FullPermutationMixedPath (fun g (p : P g) => p.val)
      (S i) B (A i) (Δ i) (D i) (steps i) s → Prop)
    (phase : ∀ i s, FullPermutationMixedPath (fun g (p : P g) => p.val)
      (S i) B (A i) (Δ i) (D i) (steps i) s → ℂ)
    (coeffBound : I → ℝ) (hcoeffBound : ∀ i, 0 ≤ coeffBound i)
    (hphase : ∀ i s p, ‖phase i s p‖ ≤ coeffBound i)
    (patterns : Finset I)
    (N : ℕ) (hlength : ∀ i ∈ patterns, ((steps i).filterMap id).length ≤ N)
    {C₁ : ℝ} (hH : ∑ i ∈ patterns, coeffBound i ≤ L ^ C₁) :
    let _ : ∀ g (p : P g), NeZero p.val := fun g p => ⟨Nat.ne_of_gt (hpositive g p)⟩
    let ρ := physicalGhostRhoChoice qmax
    let v := physicalGhostWeightChoice qmax vmax
    ‖∑ s : ProductBoundedOrderedState (fun g => P g)
        (fun g => UnrestrictedResidueParticle (fun p : P g => p.val)) M B,
      (productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (baseline g))
        (fun g => unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g (baseline g))) s : ℂ) *
      fullMemoryVacuum s *
      (∑ i ∈ patterns,
        fullPermutationMixedPathAction (fun g (p : P g) => p.val) (S i) B (A i) (Δ i) (D i) (ω i)
          (fun g => tiltedPhysicalBirthLaw V g (baseline g)) (q i) ρ V (steps i)
          (fun x p => if allowed i x p then phase i x p else 0) fullMemoryVacuum s)‖ ^ 2 ≤
    L ^ (2 * C₁ + (N : ℝ) * R * Real.log (mixedMemoryUniformEnergy ρ v vmin vmax T)) *
      (∏ g, (∑ p : P g, tiltedPhysicalBirthLaw V g (baseline g) p) ^ M g) ^ 2 := by
  let _ : ∀ g (p : P g), NeZero p.val := fun g p => ⟨Nat.ne_of_gt (hpositive g p)⟩
  have hμ : ∀ g (p : P g), 0 ≤ tiltedPhysicalBirthLaw V g (baseline g) p := by
    intro g p
    exact (tiltedPhysicalBirthLaw_pos V g (baseline g) (hvmin.trans_le (hVlo g)) (hpositive g)
      (fun p => lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1 / 2) (hbaseline g p).1) p).le
  have he := tilted_full_pattern_energy_le_of_polynomial_mass_parameter_choice
    P V baseline hpositive hMass hbaseline S B A Δ D ω q hω hωmass hqmax0 hqmax1
    hvmin hVlo hVhi hq0 hqmax T ht hL hR hgroups steps allowed phase coeffBound hcoeffBound
    hphase patterns N hlength hH fullMemoryVacuum fullMemoryVacuum_symmetric
  exact full_memory_vacuum_pairing_le_of_energy
    (fun g => tiltedPhysicalBirthLaw V g (baseline g))
    (fun g => unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g (baseline g)))
    hμ (fun g z => hμ g z.1) M B _ he

end
