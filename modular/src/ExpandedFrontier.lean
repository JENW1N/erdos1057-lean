theorem rational_enlarged_dyad_coefficient_le {U V r L : ℝ}
    (hU : 0 < U) (hV : 0 < V) (hr : 0 < r) (hL : 1 ≤ L) :
    ((1 + 12 * V / r) * (8 * U + 2 * r * L)) / (U * V) ≤
      96 * L * (1 / r + 1 / U + 1 / V + r / (U * V)) := by
  apply (div_le_iff₀ (mul_pos hU hV)).mpr
  have he : 96 * L * (1 / r + 1 / U + 1 / V + r / (U * V)) * (U * V) =
      (12 * (1 + V / r)) * (8 * L * (U + r)) := by
    field_simp
    ring
  rw [he]
  apply mul_le_mul
  · have heq : 1 + 12 * V / r = 12 * (1 + V / r) - 11 := by ring
    rw [heq]
    linarith
  · nlinarith [mul_nonneg hU.le (sub_nonneg.mpr hL), mul_pos hr (lt_of_lt_of_le zero_lt_one hL)]
  · positivity
  · positivity

theorem rational_enlarged_dyad_energy_le {U V r L C D E F : ℝ}
    (hU : 0 < U) (hV : 0 < V) (hr : 0 < r) (hL : 1 ≤ L)
    (hC : 0 ≤ C) (hD : 0 ≤ D) (hE : 0 ≤ E) (hF : 0 ≤ F) :
    ((1 + 12 * V / r) * (8 * U + 2 * r * L)) *
      ((C / (U / 2)) * 4 * E) * ((D / (V / 2)) * 4 * F) ≤
      1024 * (6 * C * D * L * (1 / r + 1 / U + 1 / V + r / (U * V)) * E * F) := by
  have hm := mul_le_mul_of_nonneg_right (rational_enlarged_dyad_coefficient_le hU hV hr hL)
    (show 0 ≤ 64 * C * D * E * F by positivity)
  convert hm using 1 <;> first | rfl | (field_simp; ring)

theorem norm_sub_le_thirty_three_sqrt {a b : ℂ} {H : ℝ}
    (hH : 0 ≤ H) (ha : ‖a‖ ^ 2 ≤ H) (hb : ‖b‖ ^ 2 ≤ 1024 * H) :
    ‖a - b‖ ≤ 33 * Real.sqrt H := by
  have hs := Real.sq_sqrt hH
  have hp := Real.sqrt_nonneg H
  have ha' : ‖a‖ ≤ Real.sqrt H := by nlinarith [norm_nonneg a]
  have hb' : ‖b‖ ≤ 32 * Real.sqrt H := by nlinarith [norm_nonneg b]
  exact (norm_sub_le a b).trans (by linarith)
end

