theorem full_permutation_pattern_bounded_phase_energy_le_rpow
    {I J K G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    {M : G → ℕ} (S : I → K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ i k, SharedActiveLabels P (S i k) → Type*)
    [∀ i k c, Fintype (A i k c)]
    (Δ D : ∀ i k c, A i k c → G → ℤ)
    (ω : ∀ i k c, A i k c → ℝ)
    (μ : ∀ g, P g → ℝ) (q : I → J → ℝ) (ρ : ℝ) (V : G → ℝ)
    (hω : ∀ i k c a, 0 ≤ ω i k c a)
    (hωmass : ∀ i k c, ∑ a, ω i k c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 < μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hq0 : ∀ i j, 0 ≤ q i j) (hq1 : ∀ i j, q i j ≤ 1)
    (hD : ∀ i j, q i j / ρ ^ 2 + ((1 - q i j) / ρ) / v ≤ 1)
    (hC : ∀ i j g, q i j / ρ ^ 2 + ((1 - q i j) * V g / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ i k g, (S i k g)ᶜ.card ≤ T)
    {L R : ℝ} (hL : 1 ≤ L) (hR : 0 ≤ R)
    (hgroups : (Fintype.card G : ℝ) ≤ R * Real.log L)
    (steps : I → List (Option (J ⊕ K)))
    (allowed : ∀ i s, FullPermutationMixedPath n (S i) B (A i) (Δ i) (D i) (steps i) s → Prop)
    (phase : ∀ i s, FullPermutationMixedPath n (S i) B (A i) (Δ i) (D i) (steps i) s → ℂ)
    (coeffBound : I → ℝ) (hcoeffBound : ∀ i, 0 ≤ coeffBound i)
    (hphase : ∀ i s p, ‖phase i s p‖ ≤ coeffBound i)
    (patterns : Finset I)
    (N : ℕ) (hlength : ∀ i ∈ patterns, ((steps i).filterMap id).length ≤ N)
    {H : ℝ} (hH : ∑ i ∈ patterns, coeffBound i ≤ H)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fun s => ∑ i ∈ patterns,
        fullPermutationMixedPathAction n (S i) B (A i) (Δ i) (D i) (ω i) μ (q i) ρ V (steps i)
          (fun x p => if allowed i x p then phase i x p else 0) f s) ≤
    H ^ 2 * L ^ ((N : ℝ) * R * Real.log (mixedMemoryUniformEnergy ρ v vmin vmax T)) *
      finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hlog : 0 ≤ Real.log (mixedMemoryUniformEnergy ρ v vmin vmax T) :=
    Real.log_nonneg (mixedMemoryUniformEnergy_ge_one ρ v vmin vmax T)
  have hmeasure : ∀ s : ProductBoundedOrderedState P
      (fun g => UnrestrictedResidueParticle (n g)) M B,
      0 ≤ productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)) s :=
    productMemoryWeight_nonneg μ (fun g => unrestrictedResidueWeight (μ g))
      (fun g p => (hμ g p).le) (fun g z => (hμ g z.1).le)
  let normalized := fun i s p => phase i s p / (coeffBound i : ℂ)
  let F := fun i =>
    fullPermutationMixedPathAction n (S i) B (A i) (Δ i) (D i) (ω i) μ (q i) ρ V (steps i)
      (fun s p => if allowed i s p then normalized i s p else 0) f
  have hindividual : ∀ i ∈ patterns,
      finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) (F i) ≤
      L ^ ((N : ℝ) * R * Real.log (mixedMemoryUniformEnergy ρ v vmin vmax T)) *
        finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
    intro i hi
    have he := full_permutation_mixed_path_mask_energy_le_rpow n (S i) B (A i)
      (Δ i) (D i) (ω i) μ (q i) ρ V (hω i) (hωmass i) hρ0 hρ1 hv hvmin hVlo hVhi
      hμ hmass (hq0 i) (hq1 i) (hD i) (hC i) T (ht i) hL0 hgroups
      (steps i) (allowed i) (normalized i)
      (fun s p => norm_div_real_bound_le_one (hcoeffBound i) (hphase i s p)) f hf
    apply he.trans
    apply mul_le_mul_of_nonneg_right _
      (sum_nonneg fun s _ => mul_nonneg (hmeasure s) (sq_nonneg _))
    apply Real.rpow_le_rpow_of_exponent_le hL
    apply mul_le_mul_of_nonneg_right _ hlog
    apply mul_le_mul_of_nonneg_right _ hR
    exact_mod_cast hlength i hi
  have h := finite_pattern_energy_le patterns _ hmeasure coeffBound (fun i _ => hcoeffBound i)
    (fun i _ => (coeffBound i : ℂ)) F
    (fun i _ _ => by simp [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hcoeffBound i)])
    hH (Real.rpow_nonneg hL0.le _) f hindividual
  convert h using 2
  funext s
  apply sum_congr rfl
  intro i hi
  dsimp only [F, normalized, fullPermutationMixedPathAction]
  rw [← finite_event_path_phase_mul]
  congr 1
  funext x p
  by_cases hp : allowed i x p
  · simp only [if_pos hp]
    exact (real_bound_mul_div_eq (hphase i x p)).symm
  · simp only [if_neg hp, mul_zero]

theorem full_permutation_pattern_energy_le_of_polynomial_mass
    {I J K G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    {M : G → ℕ} (S : I → K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ i k, SharedActiveLabels P (S i k) → Type*)
    [∀ i k c, Fintype (A i k c)]
    (Δ D : ∀ i k c, A i k c → G → ℤ)
    (ω : ∀ i k c, A i k c → ℝ)
    (μ : ∀ g, P g → ℝ) (q : I → J → ℝ) (ρ : ℝ) (V : G → ℝ)
    (hω : ∀ i k c a, 0 ≤ ω i k c a)
    (hωmass : ∀ i k c, ∑ a, ω i k c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 < μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hq0 : ∀ i j, 0 ≤ q i j) (hq1 : ∀ i j, q i j ≤ 1)
    (hD : ∀ i j, q i j / ρ ^ 2 + ((1 - q i j) / ρ) / v ≤ 1)
    (hC : ∀ i j g, q i j / ρ ^ 2 + ((1 - q i j) * V g / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ i k g, (S i k g)ᶜ.card ≤ T)
    {L R : ℝ} (hL : 1 ≤ L) (hR : 0 ≤ R)
    (hgroups : (Fintype.card G : ℝ) ≤ R * Real.log L)
    (steps : I → List (Option (J ⊕ K)))
    (allowed : ∀ i s, FullPermutationMixedPath n (S i) B (A i) (Δ i) (D i) (steps i) s → Prop)
    (phase : ∀ i s, FullPermutationMixedPath n (S i) B (A i) (Δ i) (D i) (steps i) s → ℂ)
    (coeffBound : I → ℝ) (hcoeffBound : ∀ i, 0 ≤ coeffBound i)
    (hphase : ∀ i s p, ‖phase i s p‖ ≤ coeffBound i)
    (patterns : Finset I)
    (N : ℕ) (hlength : ∀ i ∈ patterns, ((steps i).filterMap id).length ≤ N)
    {C₁ : ℝ} (hH : ∑ i ∈ patterns, coeffBound i ≤ L ^ C₁)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fun s => ∑ i ∈ patterns,
        fullPermutationMixedPathAction n (S i) B (A i) (Δ i) (D i) (ω i) μ (q i) ρ V (steps i)
          (fun x p => if allowed i x p then phase i x p else 0) f s) ≤
    L ^ (2 * C₁ + (N : ℝ) * R * Real.log (mixedMemoryUniformEnergy ρ v vmin vmax T)) *
      finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  have h := full_permutation_pattern_bounded_phase_energy_le_rpow n S B A Δ D ω μ q ρ V
    hω hωmass hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass hq0 hq1 hD hC T ht hL hR hgroups
    steps allowed phase coeffBound hcoeffBound hphase patterns N hlength hH f hf
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hpower : (L ^ C₁) ^ 2 *
      L ^ ((N : ℝ) * R * Real.log (mixedMemoryUniformEnergy ρ v vmin vmax T)) =
      L ^ (2 * C₁ + (N : ℝ) * R * Real.log (mixedMemoryUniformEnergy ρ v vmin vmax T)) := by
    rw [Real.rpow_add hL0]
    congr 1
    rw [mul_comm (2 : ℝ) C₁]
    simpa only [Nat.cast_ofNat] using (Real.rpow_mul_natCast hL0.le C₁ 2).symm
  rw [hpower] at h
  exact h
end

section
open scoped BigOperators Classical
theorem rational_kernel_multiplier_comparison {X Y : Type*} [Fintype X] [Fintype Y]
    (π : X → ℕ) (τ : Y → ℕ) (μ : X → ℝ) (ν : Y → ℝ)
    (KA : X → X → ℂ) (KB : Y → Y → ℂ) (x : X) (y : Y)
    {r Q : ℕ} (hr : 0 < r) (hrQ : r ≤ Q) (u : ℤ)
    (hπ : ∀ d, (π d).Coprime r) (hτ : ∀ e, (τ e).Coprime r)
    {εA εB δ RA RB : ℝ} (hεA : 0 ≤ εA) (hεB : 0 ≤ εB)
    (hA : ∀ χ : DirichletCharacter ℂ r,
      ‖(∑ d, (μ d : ℂ) * KA d x * χ (π d : ZMod r)) - χ (π x : ZMod r)‖ ≤ εA)
    (hB : ∀ χ : DirichletCharacter ℂ r,
      ‖(∑ e, (ν e : ℂ) * KB e y * χ (τ e : ZMod r)) - χ (τ y : ZMod r)‖ ≤ εB)
    (hμ : ∀ d, 0 ≤ μ d) (hν : ∀ e, 0 ≤ ν e) (hδ : 0 ≤ δ)
    (hRA : ∑ d, μ d * ‖KA d x‖ ≤ RA) (hRB : ∑ e, ν e * ‖KB e y‖ ≤ RB)
    (M : X → Y → ℂ) (hMnorm : ‖M x y‖ ≤ 1)
    (hM : ∀ d e, KA d x * KB e y ≠ 0 → ‖M d e - M x y‖ ≤ δ) :
    ‖finiteTwoKernelAverage μ ν KA KB x y (fun d e => M d e *
        Complex.exp (Complex.I * (2 * Real.pi * ((u : ℝ) / r * (π d * τ e)) : ℝ))) -
      M x y * Complex.exp (Complex.I * (2 * Real.pi * ((u : ℝ) / r * (π x * τ y)) : ℝ))‖ ≤
        δ * RA * RB + Real.sqrt (Q : ℝ) * (εA + εB + εA * εB) := by
  let phase := fun d e => Complex.exp (Complex.I * (2 * Real.pi * ((u : ℝ) / r * (π d * τ e)) : ℝ))
  have hp (d : X) (e : Y) : ‖phase d e‖ ≤ 1 := by
    simp only [phase, Complex.norm_exp, Complex.mul_re, Complex.I_re, zero_mul,
      Complex.ofReal_im, mul_zero, sub_self, Real.exp_zero, le_refl]
  have hrep := rational_kernel_reproduction π τ μ ν KA KB x y hr hrQ u hπ hτ hεA hεB hA hB
  have hchange := finite_two_kernel_multiplier_replacement μ ν KA KB x y M phase δ RA RB
    hμ hν hδ hRA hRB hp hM
  change ‖finiteTwoKernelAverage μ ν KA KB x y (fun d e => M d e * phase d e) -
    M x y * phase x y‖ ≤ _
  calc
    _ = ‖(finiteTwoKernelAverage μ ν KA KB x y (fun d e => M d e * phase d e) -
        M x y * finiteTwoKernelAverage μ ν KA KB x y phase) +
        M x y * (finiteTwoKernelAverage μ ν KA KB x y phase - phase x y)‖ := by
      congr 1
      ring
    _ ≤ ‖finiteTwoKernelAverage μ ν KA KB x y (fun d e => M d e * phase d e) -
        M x y * finiteTwoKernelAverage μ ν KA KB x y phase‖ +
        ‖M x y * (finiteTwoKernelAverage μ ν KA KB x y phase - phase x y)‖ := norm_add_le _ _
    _ ≤ δ * RA * RB + Real.sqrt (Q : ℝ) * (εA + εB + εA * εB) := by
      apply add_le_add hchange
      rw [norm_mul]
      exact (mul_le_mul_of_nonneg_right hMnorm (norm_nonneg _)).trans (by simpa only [one_mul] using hrep)

theorem major_arc_rational_phase_factor (ζ β : ℝ) {r : ℕ} (u : ℤ) {n : ℝ} (hn : 0 < n) :
    majorArcMultiplier ζ β (Real.log n) *
      Complex.exp (Complex.I * (2 * Real.pi * ((u : ℝ) / r * n) : ℝ)) =
    Complex.exp (Complex.I * (ζ * Real.log n + 2 * Real.pi * (((u : ℝ) / r + β) * n) : ℝ)) := by
  rw [majorArcMultiplier, Real.exp_log hn, ← Complex.exp_add]
  congr 1
  push_cast
  ring
end

