  | none => rfl
  | some tag => cases tag <;> rfl

variable [∀ g, Fintype (P g)] [∀ g p, NeZero (n g p)] [∀ k, Fintype (A k)]

noncomputable def physicalSmallBigPathVaryingGhostAction (steps : List (Option (H ⊕ K)))
