  rw [congrFun (full_mixed_ledger_path_action_eq (fun g (p : {p // p ∈ P g}) => Subtype.val p) (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B (fun j (_ : SharedActiveLabels (fun g => {p // p ∈ P g}) ((fun j g => physicalFullSharedIndices (ell := ell) (C j g)) j)) => PhysicalAuxLabels P (C j)) (fun j => physicalFullEdgeDelta (ell := ell) (C j) (k j)) (fun j => physicalFullEdgeD (ell := ell) (C j)) ω (fun g p => β g p / V g) retention ρ V
    ((List.range steps).map tags) fullActiveInitialLedger
    (physicalFullRecordedTracePhase C k ω β ρ V tags cut steps initialTrace Φ) f) x]
  unfold fullPermutationMixedPathAction finiteEventPathAction
  apply sum_congr
  · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
  · intro p _
    rw [physical_full_trace_induced_phase_factor]
    ring

end Physical
end Bounty
