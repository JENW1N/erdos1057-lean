theorem physical_selected_planned_ledger_phase
    (hCs : ∀ j s, Cs j s = ∅) (Vs : S → ℝ) (q : ℝ)
    (steps : List (Option (Fin (n + 1) ⊕ Fin n))) (r : PhysicalResidues Ps)
    (x : PhysicalFullBoundedState P J ell B)
    (p : FullPermutationMixedPath (fun g (p : P g) => p.val)
      (fun j g => physicalFullSharedIndices (ell := ell) (C (i j) g)) B
      (fun j _ => PhysicalAuxLabels P (C (i j)))
      (fun j => physicalFullEdgeDelta (C (i j)) (physicalSelectedPlannedMultiplier k i ds j))
      (fun j => physicalFullEdgeD (C (i j))) steps x) :
    deterministicLedgerPhase
      (PhysicalPlannedResidueEvent (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i => PhysicalAuxLabels P (C i))
      (fun t i d => physicalFullEdgeDelta (C i) (k t i * (physicalSharedProduct d : ℕ)))
      (fun _ i _ => physicalFullEdgeD (C i)))
      (physicalPlannedResidueTarget (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i => PhysicalAuxLabels P (C i))
      (fun t i d => physicalFullEdgeDelta (C i) (k t i * (physicalSharedProduct d : ℕ)))
      (fun _ i _ => physicalFullEdgeD (C i)))
      (physicalPlannedSmallUpdate (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i => PhysicalAuxLabels P (C i))
      (fun t i d => physicalFullEdgeDelta (C i) (k t i * (physicalSharedProduct d : ℕ)))
      (fun _ i _ => physicalFullEdgeD (C i))
        (fun t i => physicalMixedBigStep (C i) (k t i)))
      (physicalPlannedSmallPhase (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i => PhysicalAuxLabels P (C i))
      (fun t i d => physicalFullEdgeDelta (C i) (k t i * (physicalSharedProduct d : ℕ)))
      (fun _ i _ => physicalFullEdgeD (C i))
        (fun t i => physicalMixedBigStep (C i) (k t i)) Vs (fun _ => q))
      (steps.map (Option.map (Sum.map id (physicalSelectedPlannedKey i ds)))) r x
      (physicalSelectedPlannedPathEquiv C k i ds steps x p) =
    deterministicLedgerPhase
      (FullPermutationMixedEvent (fun g (p : P g) => p.val)
        (fun j g => physicalFullSharedIndices (ell := ell) (C (i j) g)) B
        (fun j _ => PhysicalAuxLabels P (C (i j)))
        (fun j => physicalFullEdgeDelta (C (i j)) (physicalSelectedPlannedMultiplier k i ds j))
        (fun j => physicalFullEdgeD (C (i j))))
      (fullPermutationMixedEventTarget (fun g (p : P g) => p.val)
        (fun j g => physicalFullSharedIndices (ell := ell) (C (i j) g)) B
        (fun j _ => PhysicalAuxLabels P (C (i j)))
        (fun j => physicalFullEdgeDelta (C (i j)) (physicalSelectedPlannedMultiplier k i ds j))
        (fun j => physicalFullEdgeD (C (i j))))
      (physicalFullSmallRawUpdate (fun j => C (i j)) (physicalSelectedPlannedMultiplier k i ds))
      (physicalFullSmallRawPhase (fun j => C (i j)) (physicalSelectedPlannedMultiplier k i ds)
        Cs Vs q ds) steps r x p := by
  have h := full_permutation_key_ledger_phase (fun g (p : P g) => p.val)
    (fun key : PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := Fin n) =>
      fun g => physicalFullSharedIndices (ell := ell) (C key.2.1 g)) B
    (fun key _ => PhysicalAuxLabels P (C key.2.1))
    (fun key => physicalFullEdgeDelta (C key.2.1)
      (k key.1 key.2.1 * (physicalSharedProduct (physicalSharedPrefix key.2.2.1) : ℕ)))
    (fun key => physicalFullEdgeD (C key.2.1))
    (physicalSelectedPlannedKey i ds)
    (physicalPlannedSmallUpdate (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i => PhysicalAuxLabels P (C i))
      (fun t i d => physicalFullEdgeDelta (C i) (k t i * (physicalSharedProduct d : ℕ)))
      (fun _ i _ => physicalFullEdgeD (C i))
      (fun t i => physicalMixedBigStep (C i) (k t i)))
    (physicalPlannedSmallPhase (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i => PhysicalAuxLabels P (C i))
      (fun t i d => physicalFullEdgeDelta (C i) (k t i * (physicalSharedProduct d : ℕ)))
      (fun _ i _ => physicalFullEdgeD (C i))
      (fun t i => physicalMixedBigStep (C i) (k t i)) Vs (fun _ => q)) steps r x p
  change _ = deterministicLedgerPhase _ _
    (fun tag r x e => physicalPlannedSmallUpdate (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i => PhysicalAuxLabels P (C i))
      (fun t i d => physicalFullEdgeDelta (C i) (k t i * (physicalSharedProduct d : ℕ)))
      (fun _ i _ => physicalFullEdgeD (C i))
      (fun t i => physicalMixedBigStep (C i) (k t i))
      (tag.map (Sum.map id (physicalSelectedPlannedKey i ds))) r x
      (physicalSelectedPlannedEventEquiv C k i ds tag x e))
    (fun tag r x e => physicalPlannedSmallPhase (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i => PhysicalAuxLabels P (C i))
      (fun t i d => physicalFullEdgeDelta (C i) (k t i * (physicalSharedProduct d : ℕ)))
      (fun _ i _ => physicalFullEdgeD (C i))
      (fun t i => physicalMixedBigStep (C i) (k t i)) Vs (fun _ => q)
