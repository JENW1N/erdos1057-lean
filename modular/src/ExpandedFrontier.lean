  have hM (u : ℝ) :
      (∑ n ∈ (Ioc lo hi).filter (fun n =>
          (typeIIRestrict (Ioc lo hi) (ambientPrimeTypeIIAlpha κM L S) n : ℂ) ≠ 0),
