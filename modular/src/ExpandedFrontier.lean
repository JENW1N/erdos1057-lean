      (UnrestrictedResidueParticle (prime g)) B)
    let phase := fun j H y e => physicalFullGlobalEdgePhase (C j) (k j) H (ω j)
      (fun g p => β g p / V g) ρ V y e
    let _ := fullPermutationMixedEventFintype (J := I) prime S B A Δ D
    let _ := finiteEventPathFintype E T schedule x
    finiteRowComposition (S := fun _ =>
      List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C) × PhysicalBoundedMarkState P J ell B)
      (fun i => physicalRecordedMarkRow C k ω β retention ρ V hV
        (tags i) (cut i) (cut (i + 1)) (physicalFullTraceAppend C)) steps
      ((fun r => Φ r.1 r.2 * f r.2.2) ∘ Prod.map id (physicalBoundedMarkEncode (cut steps)))
      (initialTrace (fullActiveInitialLedger x, x), physicalInitialMarkState B L) =
    ∑ code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B schedule)),
      (-1 : ℂ) ^ birthForestRank code *
        birthForestPathSum (Finset.univ : Finset (FiniteEventPath E T schedule x))
          (fun p => (physicalFullTracePathObservable C k tags cut steps initialTrace Φ x p *
            f (finiteEventPathTerminal E T schedule x p)) *
            fullMixedResidualPathWeight prime S B A Δ D phase ω (fun g p => β g p / V g)
              retention ρ V schedule fullActiveInitialLedger x p)
          (fullMixedIndexedBirthPerformed prime S B A Δ D schedule x)
          (fullMixedIndexedBirthValue prime S B A Δ D schedule (fun z => (z.2.val : ℤ)) x) code := by
  dsimp only
  rw [physical_initial_recorded_mark_scalar_paths C k ω β retention ρ V
    tags cut steps initialTrace Φ f hV hP hdis hencode L]
  apply full_mixed_ledger_phase_forest_expansion
  · exact physical_full_schedule_birth_factor C k ω β ρ V
  · exact physical_full_empty_initial_ledger_covers (cut 0) L
  · intro a b hab
    apply physical_prime_value_injective hdis
    change (a.2.val : ℤ) = (b.2.val : ℤ) at hab
    exact Int.ofNat_inj.mp hab

end Physical
end Bounty
end

section

/- The exact prime-pattern family has a uniform initial-ledger error
budget. Pattern signs remain inside their coefficient norms, and the
fresh-target exclusion probability is the only additional loss. -/

open Finset Filter
open scoped Classical

namespace Bounty

theorem repeated_big_prime_initial_pattern_error_le {G : Type*}
    [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell m : ℕ}
    (V : G → ℝ) (probes : G → Finset (Fin J)) (r t : Finset G)
    (hrt : Disjoint r t) (hp : ∀ g, (probes g).card ≤ m)
    (F : ∀ g, Finset (P g)) (hF : ∀ g, (F g).card ≤ J + ell)
    (Q : ℕ) (xi : ℝ) {v Pmin : ℝ}
    (hv : 0 < v) (hV : ∀ g, v ≤ V g) (hPmin : 0 < Pmin) :
    (∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      ‖repeatedBigPrimePatternWeight probes r t i‖ *
        (repeatedBigPrimePatternBound probes r t Q xi i * Real.sqrt
          (repeatedBigInitialForbiddenProbability (ell := ell) V
            (repeatedBigPrimePatternCut probes r t i) F Pmin))) ≤
      repeatedBigInitialError (Fintype.card G) m J ell Q xi Pmin v := by
  let delta := (Fintype.card G : ℝ) *
    (((ell + m : ℕ) : ℝ) * ((J + ell : ℕ) : ℝ)) / (v * Pmin)
  have hprob (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t) :
      repeatedBigInitialForbiddenProbability (ell := ell) V (repeatedBigPrimePatternCut probes r t i)
        F Pmin ≤ delta := by
    simpa only [delta, mul_assoc] using
      repeated_big_initial_forbidden_probability_le V (repeatedBigPrimePatternCut probes r t i)
        F hv hPmin hV (repeated_big_prime_pattern_cut_card_le probes r t hp i) hF
  have hcard : r.card + t.card ≤ Fintype.card G := by
    rw [← card_union_of_disjoint hrt]
    exact card_le_univ _
  simp only [repeated_big_prime_pattern_weight_norm, one_mul]
  calc
    _ ≤ ∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
        repeatedBigPrimePatternBound probes r t Q xi i * Real.sqrt delta := by
      apply sum_le_sum
      intro i _
      exact mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt (hprob i))
        (repeated_big_prime_pattern_bound_nonneg probes r t Q xi i)
    _ = (∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
        repeatedBigPrimePatternBound probes r t Q xi i) * Real.sqrt delta := by
      rw [sum_mul]
    _ ≤ (1 + (2 : ℝ) ^ (m * (r.card + t.card)) * (((Q * Q : ℕ) : ℝ) / xi) ^ 2) *
        Real.sqrt delta :=
      mul_le_mul_of_nonneg_right
        (repeated_big_prime_pattern_bound_sum_le (ell := ell) probes r t hp Q xi)
        (Real.sqrt_nonneg _)
    _ ≤ (1 + (2 : ℝ) ^ (m * Fintype.card G) * (((Q * Q : ℕ) : ℝ) / xi) ^ 2) *
        Real.sqrt delta := by
      apply mul_le_mul_of_nonneg_right _ (Real.sqrt_nonneg _)
      apply add_le_add le_rfl
      apply mul_le_mul_of_nonneg_right _ (sq_nonneg _)
      exact pow_le_pow_right₀ (by norm_num : (1 : ℝ) ≤ 2) (Nat.mul_le_mul_left m hcard)
    _ = _ := rfl

theorem eventually_repeated_big_prime_initial_error_sum_small (m J ell : ℕ)
    {a q x v c : ℝ} (ha : 0 ≤ a) (hq : 0 ≤ q) (hx : 0 ≤ x)
    (hv : 0 < v) (hc : 0 < c) (hell : ell ≤ m) (E : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (G : Type*) [Fintype G] [DecidableEq G]
      (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
      (r t : Finset G) (F : ∀ g, Finset (P g)) (Q : ℕ) (xi Pmin : ℝ),
      Disjoint r t → (∀ g, (probes g).card ≤ m) →
      (∀ g, (F g).card ≤ J + ell) → (∀ g, v ≤ V g) →
      (Fintype.card G : ℝ) ≤ a * Real.log L → (Q : ℝ) ≤ L ^ q →
      L ^ (-x) ≤ xi → Real.exp (L ^ c) ≤ Pmin →
      (∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
        ‖repeatedBigPrimePatternWeight probes r t i‖ *
          (repeatedBigPrimePatternBound probes r t Q xi i * Real.sqrt
            (repeatedBigInitialForbiddenProbability (ell := ell) V
              (repeatedBigPrimePatternCut probes r t i) F Pmin))) ≤ L ^ (-E) := by
  filter_upwards [eventually_repeated_big_initial_error_small m J ell ha hq hx hv hc hell E]
    with L hL
  intro G _ _ P V probes r t F Q xi Pmin hrt hp hF hV hs hQ hxi hPmin
  exact (repeated_big_prime_initial_pattern_error_le V probes r t hrt hp F hF Q xi hv hV
    ((Real.exp_pos _).trans_le hPmin)).trans (hL _ Q xi Pmin hs hQ hxi hPmin)

end Bounty
end

section

/- The complete signed prime family has a concrete exceptional-operation
bound on the original physical event model. All event choices remain summed.
Only pointwise boundedness is required of the additional forest multiplier. -/

open Finset
open scoped Classical

namespace Bounty

theorem finite_energy_bound_to_active_norm {X : Type*} [Fintype X]
    (w : X → ℝ) (f g : X → ℂ) {H K : ℝ} (hH : 0 ≤ H) (hK : 0 ≤ K)
    (h : finiteWeightedEnergy w g ≤ H ^ 2 * K * finiteWeightedEnergy w f) :
    cleanActiveNorm w g ≤ H * Real.sqrt K * cleanActiveNorm w f := by
  have hs := Real.sqrt_le_sqrt h
  rw [Real.sqrt_mul (mul_nonneg (sq_nonneg H) hK),
    Real.sqrt_mul (sq_nonneg H), Real.sqrt_sq hH] at hs
  exact hs

theorem finite_family_active_norm_le {I X : Type*} [Fintype I] [Fintype X]
    (w : X → ℝ) (hw : ∀ x, 0 ≤ w x) (f : X → ℂ) (g : I → X → ℂ)
    (b : I → ℝ) (hb : ∀ i, 0 ≤ b i) {H K : ℝ} (hK : 0 ≤ K)
    (hH : ∑ i, b i ≤ H)
    (hg : ∀ i, finiteWeightedEnergy w (g i) ≤ (b i)^2 * K * finiteWeightedEnergy w f) :
    cleanActiveNorm w (∑ i, g i) ≤ H * Real.sqrt K * cleanActiveNorm w f := by
  calc
    _ ≤ ∑ i, cleanActiveNorm w (g i) := clean_active_norm_sum_le w hw univ g
    _ ≤ ∑ i, b i * Real.sqrt K * cleanActiveNorm w f :=
      sum_le_sum fun i _ => finite_energy_bound_to_active_norm w f (g i) (hb i) hK (hg i)
    _ = (∑ i, b i) * Real.sqrt K * cleanActiveNorm w f := by rw [sum_mul, sum_mul]
    _ ≤ _ := mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right hH (Real.sqrt_nonneg _)) (Real.sqrt_nonneg _)

noncomputable def physicalFullRepeatedLabels {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (C : Fin N → Finset (Fin J)) (x : PhysicalFullBoundedState P J ell B) :
    RepeatedBigLists P J ell := fun g s => (x g).1 ((physicalFullSlotIndex (C g)).symm s)

noncomputable def physicalPrimeFullPatternAction {N J ell B : ℕ}
    (P : Fin N → Finset ℕ) [∀ g (p : P g), NeZero p.val]
    (V : Fin N → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ)
    (probes : Fin N → Finset (Fin J)) (r t : Finset (Fin N)) (hrt : Disjoint r t)
    (Q : ℕ) (h xi : ℝ) (k : ℤ) (F : ∀ g, Finset (P g))
    (φ : ∀ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      ∀ x : PhysicalFullBoundedState P J ell B,
      PhysicalFullEdgeEvent (repeatedBigPrimePatternCut probes r t i) k x → ℂ)
    (f : PhysicalFullBoundedState P J ell B → ℂ) : PhysicalFullBoundedState P J ell B → ℂ :=
  let kept := fun U : Finset (RepeatedBigFlatIndex (Fin N) J ell) => primeProductRetainedCells
    (fun j : U => P j.val.1) (fun j => V j.val.1) h xi
  ∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
    physicalFullCoefficientAction (repeatedBigPrimePatternCut probes r t i) k V baseline ρ F
      (fun x e => repeatedBigPrimePatternWeight probes r t i *
        repeatedBigPrimePatternKernel P V probes r t hrt Q h kept i
          (physicalFullRepeatedLabels (repeatedBigPrimePatternCut probes r t i) x)
          (physicalFullRepeatedLabels (repeatedBigPrimePatternCut probes r t i)
            (fullActiveEdgeEventTarget (fun g (p : P g) => p.val)
              (fun g => physicalFullSharedIndices (ell := ell) (repeatedBigPrimePatternCut probes r t i g)) B
              (fun _ => PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
              (physicalFullEdgeDelta (repeatedBigPrimePatternCut probes r t i) k)
              (physicalFullEdgeD (repeatedBigPrimePatternCut probes r t i)) x e)) e.1 * φ i x e) f

theorem physical_prime_full_pattern_projected_norm_le {N J ell B m : ℕ}
    (P : Fin N → Finset ℕ) [∀ g (p : P g), NeZero p.val]
    (V : Fin N → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ)
    (probes : Fin N → Finset (Fin J)) (r t : Finset (Fin N)) (hrt : Disjoint r t)
    (hp : ∀ g, (probes g).card ≤ m) (Q : ℕ) (h xi : ℝ) (hxi : 0 < xi)
    (k : ℤ) (F : ∀ g, Finset (P g))
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (hbaseline : ∀ g p, 1 / 2 ≤ baseline g p ∧ baseline g p ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (φ : ∀ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      ∀ x : PhysicalFullBoundedState P J ell B,
      PhysicalFullEdgeEvent (repeatedBigPrimePatternCut probes r t i) k x → ℂ)
    (hφ : ∀ i x e, ‖φ i x e‖ ≤ 1)
    (f : PhysicalFullBoundedState P J ell B → ℂ) (hf : ProductMemorySymmetric f) :
    let μ := fun g => tiltedPhysicalBirthLaw V g (baseline g)
    cleanActiveNorm (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fullActiveAverage (physicalPrimeFullPatternAction P V baseline ρ probes r t hrt Q h xi k F φ
        (fullActiveAverage f))) ≤
      repeatedBigFamilyEnvelope N m Q xi *
        Real.sqrt (unrestrictedEdgeEnergyBound ρ v vmin vmax (ell + m) ^ N) *
          cleanActiveNorm (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  intro μ
  let C := repeatedBigPrimePatternCut (ell := ell) probes r t
  let kept := fun U : Finset (RepeatedBigFlatIndex (Fin N) J ell) => primeProductRetainedCells
    (fun j : U => P j.val.1) (fun j => V j.val.1) h xi
  let K := repeatedBigPrimePatternKernel P V probes r t hrt Q h kept
  let b := repeatedBigPrimePatternBound (ell := ell) probes r t Q xi
  let Ψ := fun i x (e : PhysicalFullEdgeEvent (B := B) (C i) k x) =>
    repeatedBigPrimePatternWeight probes r t i * K i (physicalFullRepeatedLabels (C i) x)
      (physicalFullRepeatedLabels (C i) (fullActiveEdgeEventTarget (fun g (p : P g) => p.val)
        (fun g => physicalFullSharedIndices (ell := ell) (C i g)) B
        (fun _ => PhysicalAuxLabels P (C i)) (physicalFullEdgeDelta (C i) k)
        (physicalFullEdgeD (C i)) x e)) e.1 * φ i x e
  have hb : ∀ i, 0 ≤ b i := repeated_big_prime_pattern_bound_nonneg probes r t Q xi
  have hΨ : ∀ i x e, ‖Ψ i x e‖ ≤ b i := by
    intro i x e
    dsimp only [Ψ]
    rw [norm_mul, norm_mul, repeated_big_prime_pattern_weight_norm, one_mul]
    exact (mul_le_mul_of_nonneg_right
      (repeated_big_prime_pattern_kernel_norm_le P V probes r t hrt Q h xi hxi i _ _ _)
      (norm_nonneg _)).trans ((mul_le_mul_of_nonneg_left (hφ i x e) (hb i)).trans_eq (mul_one _))
  have hsum : ∑ i, b i ≤ repeatedBigFamilyEnvelope N m Q xi := by
    apply (repeated_big_prime_pattern_bound_sum_le (ell := ell) probes r t hp Q xi).trans
    apply add_le_add le_rfl
    apply mul_le_mul_of_nonneg_right _ (sq_nonneg _)
    apply pow_le_pow_right₀ (by norm_num : (1 : ℝ) ≤ 2)
    apply Nat.mul_le_mul_left
    rw [← card_union_of_disjoint hrt]
    exact (card_le_univ _).trans_eq (Fintype.card_fin N)
  have hμ : ∀ g p, 0 ≤ μ g p := by
    intro g p
    exact tiltedPhysicalBirthLaw_nonneg V g (baseline g) (hvmin.trans_le (hVlo g)).le
      (fun p => (by norm_num : (0 : ℝ) ≤ 1/2).trans (hbaseline g p).1) p
  have heq : fullActiveAverage (physicalPrimeFullPatternAction P V baseline ρ probes r t hrt Q h xi k F φ
        (fullActiveAverage f)) =
      ∑ i, fullActiveAverage (physicalFullCoefficientAction (C i) k V baseline ρ F (Ψ i) (fullActiveAverage f)) := by
    funext x
    simp only [physicalPrimeFullPatternAction, fullActiveAverage, Finset.sum_apply, mul_sum]
    exact sum_comm
  rw [heq]
  apply finite_family_active_norm_le _
    (productMemoryWeight_nonneg μ _ hμ (fun g z => hμ g z.1)) f _ b hb
    (pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax (ell+m)) N) hsum
  intro i
  exact physical_full_coefficient_projected_energy_le (C i) k V baseline ρ F hMass hbaseline
    hρ0 hρ1 hv hvmin hVlo hVhi (ell+m)
    (fun g => Nat.add_le_add_left (repeated_big_prime_pattern_cut_card_le probes r t hp i g) ell)
    (Ψ i) (b i) (hb i) (hΨ i) f hf

theorem physical_prime_full_pattern_projected_norm_le_rpow {N J ell B m : ℕ}
    (P : Fin N → Finset ℕ) [∀ g (p : P g), NeZero p.val]
    (V : Fin N → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ)
    (probes : Fin N → Finset (Fin J)) (r t : Finset (Fin N)) (hrt : Disjoint r t)
    (hp : ∀ g, (probes g).card ≤ m) (Q : ℕ) (h xi : ℝ) (hxi : 0 < xi)
    (k : ℤ) (F : ∀ g, Finset (P g))
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (hbaseline : ∀ g p, 1 / 2 ≤ baseline g p ∧ baseline g p ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (φ : ∀ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      ∀ x : PhysicalFullBoundedState P J ell B,
      PhysicalFullEdgeEvent (repeatedBigPrimePatternCut probes r t i) k x → ℂ)
    (hφ : ∀ i x e, ‖φ i x e‖ ≤ 1)
    {L a q x : ℝ} (hL : 2 ≤ L) (ha : 0 ≤ a) (hq : 0 ≤ q) (hx : 0 ≤ x)
    (hgroups : (N : ℝ) ≤ a * Real.log L) (hQ : (Q : ℝ) ≤ L ^ q)
    (hcut : L ^ (-x) ≤ xi)
    (f : PhysicalFullBoundedState P J ell B → ℂ) (hf : ProductMemorySymmetric f) :
    let μ := fun g => tiltedPhysicalBirthLaw V g (baseline g)
    cleanActiveNorm (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fullActiveAverage (physicalPrimeFullPatternAction P V baseline ρ probes r t hrt Q h xi k F φ
        (fullActiveAverage f))) ≤
      L ^ ((m : ℝ) * a * Real.log 2 + 4*q + 2*x +
        (a/2) * Real.log (max 1 (unrestrictedEdgeEnergyBound ρ v vmin vmax (ell+m))) + 1) *
          cleanActiveNorm (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  intro μ
  apply (physical_prime_full_pattern_projected_norm_le P V baseline ρ probes r t hrt hp
    Q h xi hxi k F hMass hbaseline hρ0 hρ1 hv hvmin hVlo hVhi φ hφ f hf).trans
  apply mul_le_mul_of_nonneg_right _ (Real.sqrt_nonneg _)
  exact repeated_big_family_norm_cost_le N m Q hL ha hq hx
    (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax (ell+m)) hgroups hQ hcut

end Bounty
end

section

/- Exact physical history normalization under adjacent common-mark compatibility.
No global residue assignment is supplied; all original local rows and cutoffs remain. -/

open Finset
open scoped Classical
namespace Bounty

section ResiduePath
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (hcompat : ∀ j : Fin n, ∀ g s t,
    ((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val =
      ((physicalPermuteLabels (τ j) (L j.succ)) g t).val →
    (((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val : ℤ) ∣
      k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ) (η : Fin N → Fin (n + 1) → ℝ)
  (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0) (B : ℕ)

variable
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)

include hstep in
theorem physical_selected_fine_path_eq_adjacent :
    finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
      (physicalSelectedFineRow (B := B) C aux L σ τ k β V ρ hV ω retention)
      (4 * n + 1) physicalEmptyMemoryTerminal (physicalInitialMarkState B (L 0)) =
      (∏ i ∈ range (2 * n + 1), physicalSelectedCoarseScalar C aux L σ ω i) *
        physicalJointAdjacentRawHistory C aux k L a σ τ hcompat hlist hP hdis hk β
          (fun _ j => 1 - retention j) V (fun _ => ρ) hV B := by
  rw [physical_selected_fine_composition_eq_coarse]
  exact physical_selected_fixed_path_eq_adjacent C aux k L a σ τ hstep hcompat hlist
    hP hdis hk β V ρ hV B ω retention

end ResiduePath
end Bounty
end

section

/- One locally incompatible edge annihilates the original selected fine history. -/

open Finset
open scoped Classical
namespace Bounty
section History
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (β : (g : Fin N) → ↥(P g) → ℝ) (V : Fin N → ℝ) (ρ : ℝ)
  (hV : ∀ g, V g ≠ 0)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)
  (hlist : ∀ j, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc)) (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)

variable [∀ g, ∀ p : ↥(P g), NeZero p.val]

include hlist hP hdis hk in
theorem physical_selected_coarse_coherent_congr (i : ℕ) (hi : i < 2 * n + 1)
    (F G : PhysicalBoundedMarkState P J ell B → ℂ)
    (hFG : ∀ t, PhysicalMarkCoherent (physicalMarkAtCut L (i + 1)) t → F t = G t)
    (s : PhysicalBoundedMarkState P J ell B)
    (hs : PhysicalMarkCoherent (physicalMarkAtCut L i) s) :
    physicalSelectedCoarseRow C aux k L σ τ β V ρ hV ω retention i F s =
      physicalSelectedCoarseRow C aux k L σ τ β V ρ hV ω retention i G s := by
  by_cases he : i % 2 = 0
  · let j : Fin (n + 1) := ⟨i / 2, by omega⟩
    have hij : i = 2 * j.val := by dsimp [j]; omega
    rw [hij] at hFG hs ⊢
    rw [physical_selected_coarse_row_even, physical_selected_coarse_row_even]
    apply physical_selected_visit_coherent_congr C k ω β retention ρ V hV j (L j) F G
    · simpa only [physical_mark_at_cut_odd] using hFG
    · simpa only [physical_mark_at_cut_even] using hs
  · let j : Fin n := ⟨i / 2, by omega⟩
    have hij : i = 2 * j.val + 1 := by dsimp [j]; omega
    have hnext : 2 * j.val + 1 + 1 = 2 * j.succ.val := by simp only [Fin.val_succ]; omega
    have hsource : physicalMarkAtCut L (2 * j.val + 1) = L j.castSucc :=
      physical_mark_at_cut_odd L j.castSucc
    rw [hij] at hFG hs ⊢
    rw [physical_selected_coarse_row_odd, physical_selected_coarse_row_odd]
    apply physical_selected_edge_coherent_congr C k ω β retention ρ V hV j (aux j)
      (σ j) (τ j) (L j.castSucc) (L j.succ) (hlist j) hP hdis (hk j) F G
    · simpa only [hnext, physical_mark_at_cut_even] using hFG
    · simpa only [hsource] using hs

omit [∀ g, ∀ p : ↥(P g), NeZero p.val] in
theorem physical_selected_coarse_zero (i : ℕ) (hi : i < 2 * n + 1)
    (s : PhysicalBoundedMarkState P J ell B)
    (hs : PhysicalMarkCoherent (physicalMarkAtCut L i) s) :
    physicalSelectedCoarseRow C aux k L σ τ β V ρ hV ω retention i (fun _ => 0) s = 0 := by
  by_cases he : i % 2 = 0
  · let j : Fin (n + 1) := ⟨i / 2, by omega⟩
    have hij : i = 2 * j.val := by dsimp [j]; omega
    rw [hij] at hs ⊢
    rw [physical_selected_coarse_row_even]
    apply physical_selected_visit_zero C k ω β retention ρ V hV j (L j) s
    simpa only [physical_mark_at_cut_even] using hs.1
  · let j : Fin n := ⟨i / 2, by omega⟩
    have hij : i = 2 * j.val + 1 := by dsimp [j]; omega
    rw [hij] at hs ⊢
    rw [physical_selected_coarse_row_odd]
    exact physical_selected_edge_zero C k ω β retention ρ V hV j (aux j) (σ j) (τ j) (L j.succ) s

include hlist hP hdis hk in
theorem physical_selected_coarse_history_zero_of_bad
    (hbad : ¬ ∀ j g s t,
      ((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val =
        ((physicalPermuteLabels (τ j) (L j.succ)) g t).val →
      (((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val : ℤ) ∣
        k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
      (physicalSelectedCoarseRow C aux k L σ τ β V ρ hV ω retention)
      (2 * n + 1) F (physicalInitialMarkState B (L 0)) = 0 := by
  obtain ⟨j, hj⟩ := not_forall.mp hbad
  apply finite_row_composition_supported_zero_at
    (physicalSelectedCoarseRow C aux k L σ τ β V ρ hV ω retention)
    (fun i s => PhysicalMarkCoherent (physicalMarkAtCut L i) s) (2 * n + 1)
    (physical_selected_coarse_coherent_congr C aux k L σ τ β V ρ hV ω retention hlist hP hdis hk)
    (physical_selected_coarse_zero C aux k L σ τ β V ρ hV ω retention)
    (2 * j.val + 1) (by have := j.isLt; omega)
  · intro G s hs
    rw [physical_selected_coarse_row_odd]
    apply physical_selected_edge_zero_of_bad C k ω β retention ρ V hV j (aux j)
      (σ j) (τ j) (L j.castSucc) (L j.succ) (hlist j) hj G s
    simpa only [show physicalMarkAtCut L (2 * j.val + 1) = L j.castSucc from
      physical_mark_at_cut_odd L j.castSucc] using hs
  · have he : physicalMarkAtCut L 0 = L 0 := by
      simpa only [Fin.val_zero, Nat.mul_zero] using physical_mark_at_cut_even L (0 : Fin (n + 1))
    rw [he]
    refine ⟨rfl, ?_⟩
    exact global_birth_joint_initial_coherent (fun g => physicalGroupPhaseActivity (L 0) g)

include hlist hP hdis hk in
theorem physical_selected_fine_history_zero_of_bad
    (hbad : ¬ ∀ j g s t,
      ((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val =
        ((physicalPermuteLabels (τ j) (L j.succ)) g t).val →
      (((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val : ℤ) ∣
        k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
      (physicalSelectedFineRow C aux L σ τ k β V ρ hV ω retention)
      (4 * n + 1) F (physicalInitialMarkState B (L 0)) = 0 := by
  rw [physical_selected_fine_composition_eq_coarse]
  exact physical_selected_coarse_history_zero_of_bad C aux k L σ τ β V ρ hV ω retention
    hlist hP hdis hk hbad F

end History
end Bounty
