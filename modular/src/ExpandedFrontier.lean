open Finset Classical
section

variable {E G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  {M : G → ℕ} (S : E → ∀ g, Finset (Fin (M g))) (B : ℕ)
  {A : ∀ e, SharedActiveLabels P (S e) → Type*} [∀ e c, Fintype (A e c)]
  (ω : ∀ e c, A e c → ℝ) (Δ D : ∀ e c, A e c → G → ℤ)
  (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)

noncomputable def fullActiveUnrestrictedEdgeList
    (phase : ∀ e c a, UnrestrictedProductPhase n (Δ e c a) (D e c a)
      (fun g => (S e g)ᶜ.card) B)
    (edges : List E)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ) :=
  finiteOperatorListAction
    (fun e => fullActiveUnrestrictedEdge n (S e) B (ω e) (Δ e) (D e) μ ρ V (phase e)) edges f

theorem full_active_edge_list_energy_le
    (hω : ∀ e c a, 0 ≤ ω e c a) (hωmass : ∀ e c, ∑ a, ω e c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : E → ℕ) (ht : ∀ e g, (S e g)ᶜ.card ≤ T e)
    (phase : ∀ e c a, UnrestrictedProductPhase n (Δ e c a) (D e c a)
      (fun g => (S e g)ᶜ.card) B)
    (hphase : ∀ e c a s events, ‖phase e c a s events‖ ≤ 1)
    (edges : List E)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fullActiveUnrestrictedEdgeList n S B ω Δ D μ ρ V phase edges f) ≤
      (edges.map (fun e => unrestrictedEdgeEnergyBound ρ v vmin vmax (T e) ^ Fintype.card G)).prod *
        finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  apply finite_operator_list_energy_le_of_positive_class
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productMemoryWeight_nonneg μ (fun g => unrestrictedResidueWeight (μ g))
      hμ (fun g z => hμ g z.1)) ProductMemorySymmetric
    (fun e => fullActiveUnrestrictedEdge n (S e) B (ω e) (Δ e) (D e) μ ρ V (phase e))
    (fun e => fullActiveUnrestrictedEdge n (S e) B (ω e) (Δ e) (D e) μ ρ V (fun _ _ _ _ => 1))
  · intro e F H hFH x
    exact full_active_unrestricted_positive_re_mono n (S e) B (ω e) (Δ e) (D e) μ ρ V
      (hω e) hρ0.le (fun g => (hvmin.trans_le (hVlo g)).le) hμ F H hFH x
  · intro e F x
    exact full_active_unrestricted_edge_norm_le_positive n (S e) B (ω e) (Δ e) (D e) μ ρ V
      (hω e) hρ0.le (fun g => (hvmin.trans_le (hVlo g)).le) hμ (phase e) (hphase e) F x
  · intro e F hF
    exact full_active_unrestricted_positive_symmetric n (S e) B (ω e) (Δ e) (D e) μ ρ V F hF
  · intro e
    exact pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax (T e)) _
  · intro e F hF
    exact full_active_unrestricted_edge_energy_le n (S e) B (ω e) (Δ e) (D e) μ ρ V
      (hω e) (hωmass e) hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass (T e) (ht e)
      (fun _ _ _ _ => 1) (by intros; simp) F hF
  · exact complexNormEnvelope_memory_symmetric f hf

end
