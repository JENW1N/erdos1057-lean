theorem ambient_buchstab_mesh_error_le_uniform (T : Finset ℕ) (μ : ℕ → ℝ)
    (b q κ L S : ℝ) (N : ℕ) (R : ℝ)
    (hrough : ∀ i : Fin N,
      |ambientRoughProxyError T μ (reciprocalGrid b q N i) L S
        (Real.exp (reciprocalGrid b q N i*L))
        (Real.exp (reciprocalGrid b q N ((i : ℕ)+1)*L))| ≤ R)
    (hprime : |ambientPrimeProxyError T μ κ L S| ≤ R) :
    |ambientBuchstabMeshError T μ b q κ L S N| ≤ ((N : ℝ)+1)*R := by
  unfold ambientBuchstabMeshError
  calc
    _ ≤ |∑ i : Fin N, ambientRoughProxyError T μ (reciprocalGrid b q N i) L S
          (Real.exp (reciprocalGrid b q N i*L))
          (Real.exp (reciprocalGrid b q N ((i : ℕ)+1)*L))|+
        |ambientPrimeProxyError T μ κ L S| := abs_add_le _ _
    _ ≤ (∑ i : Fin N, |ambientRoughProxyError T μ (reciprocalGrid b q N i) L S
          (Real.exp (reciprocalGrid b q N i*L))
          (Real.exp (reciprocalGrid b q N ((i : ℕ)+1)*L))|)+
        |ambientPrimeProxyError T μ κ L S| :=
      add_le_add (abs_sum_le_sum_abs _ _) le_rfl
    _ ≤ (∑ _i : Fin N, R)+R := add_le_add (sum_le_sum (fun i _ => hrough i)) hprime
    _ = _ := by simp only [sum_const, card_univ, Fintype.card_fin, nsmul_eq_mul]; ring

theorem eventually_candidate_ambient_error_of_component_bounds
    {c q b κ S : ℝ} {r jStar N : ℕ}
    (hrough : ∀ i : Fin N, ∀ᶠ L : ℝ in atTop,
      |ambientRoughProxyError (arithmeticProductWindow 1 (Real.exp L))
        (candidateCoefficient c L q r jStar) (reciprocalGrid b (1/2-κ) N i) L S
        (Real.exp (reciprocalGrid b (1/2-κ) N i*L))
        (Real.exp (reciprocalGrid b (1/2-κ) N ((i : ℕ)+1)*L))| ≤
          candidateCoefficientWindowMass c L q r jStar*L^(-2 : ℝ))
    (hprime : ∀ᶠ L : ℝ in atTop,
      |ambientPrimeProxyError (arithmeticProductWindow 1 (Real.exp L))
        (candidateCoefficient c L q r jStar) κ L S| ≤
          candidateCoefficientWindowMass c L q r jStar*L^(-2 : ℝ)) :
    ∀ᶠ L : ℝ in atTop,
      |ambientBuchstabMeshError (arithmeticProductWindow 1 (Real.exp L))
        (candidateCoefficient c L q r jStar) b (1/2-κ) κ L S N| ≤
          ((N : ℝ)+1)*candidateCoefficientWindowMass c L q r jStar*L^(-2 : ℝ) := by
  filter_upwards [Filter.eventually_all.mpr hrough, hprime] with L hr hp
  simpa only [mul_assoc] using ambient_buchstab_mesh_error_le_uniform
    (arithmeticProductWindow 1 (Real.exp L)) (candidateCoefficient c L q r jStar)
    b (1/2-κ) κ L S N (candidateCoefficientWindowMass c L q r jStar*L^(-2 : ℝ)) hr hp

/-- An explicit analytic component hypothesis with one shared cell exponent and
cutoff index. This definition does not assert either component estimate. -/
def CandidateAmbientComponentBounds : Prop :=
  ∀ (c q : ℝ) (r : ℕ), 0<c → 0<r → 0≤q → q<1 →
    (11/5 : ℝ)*(r : ℝ)*c=1 →
    ∀ (κ b : ℝ) (N : ℕ), 0<κ → κ≤1/50 → 0<b → b<1/2-κ → 0<N →
      ∃ S : ℝ, 0≤S ∧ ∃ J : ℕ, ∀ jStar : ℕ, J<jStar →
        (∀ i : Fin N, ∀ᶠ L : ℝ in atTop,
          |ambientRoughProxyError (arithmeticProductWindow 1 (Real.exp L))
            (candidateCoefficient c L q r jStar) (reciprocalGrid b (1/2-κ) N i) L S
            (Real.exp (reciprocalGrid b (1/2-κ) N i*L))
            (Real.exp (reciprocalGrid b (1/2-κ) N ((i : ℕ)+1)*L))| ≤
              candidateCoefficientWindowMass c L q r jStar*L^(-2 : ℝ)) ∧
        (∀ᶠ L : ℝ in atTop,
          |ambientPrimeProxyError (arithmeticProductWindow 1 (Real.exp L))
            (candidateCoefficient c L q r jStar) κ L S| ≤
              candidateCoefficientWindowMass c L q r jStar*L^(-2 : ℝ))

theorem candidate_ambient_replacement_of_component_bounds
    (hcomponents : CandidateAmbientComponentBounds) : CandidateAmbientReplacement := by
  intro c q r hc hr hq0 hq1 hcenter κ b N hκ hκmax hb hbq hN
  obtain ⟨S,hS,J,hJ⟩ :=
    hcomponents c q r hc hr hq0 hq1 hcenter κ b N hκ hκmax hb hbq hN
  refine ⟨S,hS,J,?_⟩
  intro jStar hj
  exact eventually_candidate_ambient_error_of_component_bounds (hJ jStar hj).1 (hJ jStar hj).2

end Bounty
