section

open Finset Filter
open scoped Topology

namespace Bounty

noncomputable def candidatePrimeBandRoughMass (c L q : ℝ) (r jStar : ℕ)
    (A B z : ℝ) : ℝ := by
  classical
  exact ∑ p ∈ primeBand A B,
    ∑ u ∈ (shiftedRoughSet (arithmeticProductWindow 1 (Real.exp L)) z).filter
      (fun u => p ∣ 2*u+1), candidateCoefficient c L q r jStar u

theorem shifted_rough_prime_filter_eq (T : Finset ℕ) {z : ℝ} (hz : 0 ≤ z) (p : ℕ) :
    (shiftedRoughSet T z).filter (fun u => p ∣ 2*u+1) =
      T.filter (fun u => p ∣ 2*u+1 ∧
        ∀ q ∈ (primeBand 0 z).erase 2, ¬q ∣ 2*u+1) := by
  classical
  ext u
  simp only [mem_filter, mem_shifted_rough_set_iff]
  rw [two_mul_add_one_odd_prime_avoidance_iff_rough u hz]
  tauto

theorem exists_candidate_prime_band_rough_mass_estimate (hZ : PrimitiveZeroFreeHalfPlane) :
    ∃ K : ℝ, 0 < K ∧ ∀ (c q b a v : ℝ) (r h : ℕ),
      0 < c → 0 < r → 0 ≤ q → q < 1 →
      (11/5 : ℝ)*(r : ℝ)*c = 1 →
      0 < b → b ≤ a → a ≤ v → 1 ≤ h → Even h →
      v+b*(4*(h : ℝ)+2) < 1/2 →
      ∃ J : ℕ, ∀ jStar : ℕ, J < jStar → ∀ᶠ L : ℝ in atTop,
        |candidatePrimeBandRoughMass c L q r jStar
            (Real.exp (a*L)) (Real.exp (v*L)) (Real.exp (b*L)) -
          candidateCoefficientWindowMass c L q r jStar *
            shiftedPrimeAvoidanceProduct (Real.exp (b*L)) *
              (∑ p ∈ primeBand (Real.exp (a*L)) (Real.exp (v*L)),
                1 / ((p : ℝ)-1))| ≤
          candidateCoefficientWindowMass c L q r jStar *
            shiftedPrimeAvoidanceProduct (Real.exp (b*L)) *
              (∑ p ∈ primeBand (Real.exp (a*L)) (Real.exp (v*L)),
                1 / ((p : ℝ)-1)) * K * Real.exp (-(h : ℝ)) +
          candidateCoefficientWindowMass c L q r jStar *
            ((1+16*primeEulerProductUpperConstant)*L^(-18 : ℝ)) := by
  classical
  obtain ⟨K, hK, hsieve⟩ := exists_summed_external_odd_prime_shifted_sieve
  refine ⟨K, hK, ?_⟩
  intro c q b a v r h hc hr hq0 hq1 hcenter hb hba hav hh heven hlevel
  let theta : ℝ := (v+b*(4*(h : ℝ)+2)+1/2)/2
  have htheta : theta < 1/2 := by dsimp [theta]; linarith only [hlevel]
  have ha : 0 < a := hb.trans_le hba
  have hv : 0 < v := ha.trans_le hav
  have hgap : v+b*(4*(h : ℝ)+2) < theta := by
    dsimp [theta]; linarith only [hlevel]
  have hbase : 0 ≤ v+b*(4*(h : ℝ)+2) := by positivity
  obtain ⟨J, hdist⟩ := exists_candidate_relative_typeI_remainder_power_bound
    hZ hc hr hq0 hq1 hcenter htheta (18 : ℝ)
  refine ⟨J, ?_⟩
  intro jStar hj
  filter_upwards [hdist jStar hj, eventually_exp_le_floor_exp hbase hgap,
    eventually_gt_atTop (0 : ℝ), eventually_ge_atTop (Real.log 2/a)]
    with L hd hscale hL hLa
  let N : ℕ := ⌊Real.exp (theta*L)⌋₊
  let P : Finset ℕ := (primeBand 0 (Real.exp (b*L))).erase 2
  let Q : Finset ℕ := primeBand (Real.exp (a*L)) (Real.exp (v*L))
  have hz : 1 < Real.exp (b*L) := Real.one_lt_exp_iff.mpr (mul_pos hb hL)
  have hP : ∀ p ∈ P, p.Prime := fun p hp => small_prime_pool_prime (mem_of_mem_erase hp)
  have hQ : ∀ p ∈ Q, p.Prime := by
    intro p hp
    exact ((mem_primeBand_iff (Real.exp_pos _).le (Real.exp_pos _).le p).mp hp).1
  have hQlower : ∀ p ∈ Q, Real.exp (a*L) < (p : ℝ) := by
    intro p hp
    exact ((mem_primeBand_iff (Real.exp_pos _).le (Real.exp_pos _).le p).mp hp).2.1
  have hQupper : ∀ p ∈ Q, (p : ℝ) ≤ Real.exp (v*L) := by
    intro p hp
    exact ((mem_primeBand_iff (Real.exp_pos _).le (Real.exp_pos _).le p).mp hp).2.2
  have hQodd : ∀ p ∈ Q, p ≠ 2 := by
    have hexp : 2 ≤ Real.exp (a*L) := by
      rw [← Real.exp_log (by norm_num : (0 : ℝ)<2)]
      apply Real.exp_le_exp.mpr
      have := (div_le_iff₀ ha).mp hLa
      nlinarith only [this]
    intro p hp heq
    have hp' := hQlower p hp
    norm_num [heq] at hp'
    linarith
  have hout : ∀ p ∈ Q, p ∉ P := by
    intro p hp hpP
    have hpmax := small_prime_pool_le (Real.exp_pos (b*L)).le (mem_of_mem_erase hpP)
    have hcut : Real.exp (b*L) ≤ Real.exp (a*L) :=
      Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right hba hL.le)
    exact (not_lt_of_ge (hpmax.trans hcut)) (hQlower p hp)
  have hprodlevel : ∀ p ∈ Q, ∀ d ∈ blockSieveModuli P
      ((Real.exp (b*L))^(4*(h : ℝ)+2)), p*d ≤ N := by
    intro p hp d hd
    have hdmax := (block_sieve_modulus_properties P hP _ hd).2.1
    have hprod : (p : ℝ)*(d : ℝ) ≤ Real.exp ((v+b*(4*(h : ℝ)+2))*L) := by
      calc
        _ ≤ Real.exp (v*L)*((Real.exp (b*L))^(4*(h : ℝ)+2)) :=
          mul_le_mul (hQupper p hp) hdmax (Nat.cast_nonneg d) (Real.exp_pos _).le
        _ = _ := by
          rw [← Real.exp_mul, ← Real.exp_add]
          congr 1
          ring
    exact_mod_cast hprod.trans hscale
  have hs := hsieve P Q (arithmeticProductWindow 1 (Real.exp L))
    (candidateCoefficient c L q r jStar) N hz hh heven hP
    (fun p hp => (mem_erase.mp hp).1)
    (fun p hp => small_prime_pool_le (Real.exp_pos _).le (mem_of_mem_erase hp))
    hQ hQodd hout (fun u _ => candidate_coefficient_nonneg c L hq0 r jStar u) hprodlevel
  have hmass : (∑ p ∈ Q, ∑ u ∈ (arithmeticProductWindow 1 (Real.exp L)).filter
      (fun u => p ∣ 2*u+1 ∧ ∀ q ∈ P, ¬q ∣ 2*u+1),
      candidateCoefficient c L q r jStar u) =
      candidatePrimeBandRoughMass c L q r jStar
        (Real.exp (a*L)) (Real.exp (v*L)) (Real.exp (b*L)) := by
    unfold candidatePrimeBandRoughMass
    apply sum_congr rfl
    intro p hp
    rw [shifted_rough_prime_filter_eq _ (Real.exp_pos _).le]
  rw [hmass] at hs
  have hN : (N : ℝ) ≤ Real.exp (theta*L) := Nat.floor_le (Real.exp_pos _).le
  have herr := hd N hN
  have herr' : (∑ m ∈ oddSquarefreeModuli N,
      |shiftedTotientSieveRemainder (arithmeticProductWindow 1 (Real.exp L))
        (candidateCoefficient c L q r jStar) m|) ≤
      candidateCoefficientWindowMass c L q r jStar *
        ((1+16*primeEulerProductUpperConstant)*L^(-18 : ℝ)) := by
    convert herr using 1 <;> ring
  exact hs.trans (add_le_add le_rfl herr')

end Bounty
end

section

/- Norm form of the actual mixed dirty estimate. The omission gain is
square-rooted only after the genuine weighted energy bound is established. -/

open Finset Filter
open scoped Classical Topology

namespace Bounty

theorem eventually_candidate_mixed_dirty_norm_le
    {q vs scale : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hvs : 0 < vs) (hscale : 0 < scale)
    (ell : ℕ) (C₂ : ℝ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ᶠ L : ℝ in atTop,
      letI : DecidableEq (CandidateSmallGroup scale L) := Classical.decEq _
      letI : DecidableEq (CandidateBigGroup scale L) := Classical.decEq _
      letI : ∀ p : PhysicalPrime (candidateSmallPool scale L), NeZero p.2.val :=
        candidateSmallPrimeNeZero scale L
      letI : ∀ g p, NeZero (candidateBigModulus scale L g p) := candidateBigModulusNeZero scale L
      ∀ J B : ℕ,
      letI : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
      ∀ M : CandidateBigGroup scale L → ℕ,
      ∀ shared : ∀ g, Finset (Fin (M g)),
      ∀ D_B : SharedActiveLabels (CandidateBigLabel scale L) shared → ℕ,
      ∀ k : ℤ, k ≠ 0 → (k.natAbs : ℝ) ≤ L ^ C₂ →
      ∀ Vs : CandidateSmallGroup scale L → ℝ, (∀ g, vs ≤ Vs g) →
      ∀ μ : ∀ g, CandidateBigLabel scale L g → ℝ, ∀ ρ : ℝ,
      ∀ V : CandidateBigGroup scale L → ℝ,
      ∀ v vmin vmax : ℝ, 0 < ρ → ρ < 1 → 1 < v → 0 < vmin →
      (∀ g, vmin ≤ V g) → (∀ g, V g ≤ vmax) →
      (∀ g p, 0 ≤ μ g p) → (∀ g, ∑ p, μ g p ≤ 2) →
      ∀ T : ℕ, (∀ g, (shared g)ᶜ.card ≤ T) →
      ∀ Φ : ∀ s : PhysicalSmallBigState (candidateSmallPool scale L) J ell
        (ProductBoundedOrderedState (CandidateBigLabel scale L)
          (fun g => UnrestrictedResidueParticle (candidateBigModulus scale L g)) M B),
        PhysicalSmallBigEvent (PhysicalSmallBigFullEvent (candidateBigModulus scale L) shared B
          (fun d c _ => -(k * (D_B c * physicalSharedProduct d : ℕ)))
          (fun d c _ => (D_B c * physicalSharedProduct d : ℕ))) s → ℂ,
      (∀ s e, ‖Φ s e‖ ≤ 1) →
      ∀ F : PhysicalSmallBigState (candidateSmallPool scale L) J ell
        (ProductBoundedOrderedState (CandidateBigLabel scale L)
          (fun g => UnrestrictedResidueParticle (candidateBigModulus scale L g)) M B) → ℂ,
      (∀ s, ProductMemorySymmetric (fun x => F (s, x))) →
      cleanActiveNorm (physicalSmallBigMeasure Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))))
        (physicalSmallBigAverage (fun s =>
          physicalSmallBigFullPhasedAction (candidateBigModulus scale L) shared B
            (fun d c _ => -(k * (D_B c * physicalSharedProduct d : ℕ)))
            (fun d c _ => (D_B c * physicalSharedProduct d : ℕ)) μ ρ V
            (fun c => k * D_B c) Vs q
            (fun y e => if ¬ (∀ g, (e.2.2 g).1 = ∅ ∧ (e.2.2 g).2.1 = ∅) then Φ y e else 0)
            (physicalSmallBigAverage F) s)) ≤
      2 * Real.sqrt ((B : ℝ) / (((J + ell).choose ell) ^ (candidateSmallPIndices scale L).card : ℕ)) *
        A ^ (candidateSmallPIndices scale L).card *
        Real.sqrt (unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ (candidateBigPIndices scale L).card) *
        cleanActiveNorm (physicalSmallBigMeasure Vs
          (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))) F := by
  obtain ⟨A, hA, hbound⟩ := eventually_candidate_mixed_dirty_energy_le hq0 hq1 hvs hscale ell C₂
  refine ⟨A, hA, ?_⟩
  filter_upwards [hbound] with L hL
  let _ : DecidableEq (CandidateSmallGroup scale L) := Classical.decEq _
  let _ : DecidableEq (CandidateBigGroup scale L) := Classical.decEq _
  let _ : ∀ p : PhysicalPrime (candidateSmallPool scale L), NeZero p.2.val := candidateSmallPrimeNeZero scale L
  let _ : ∀ g p, NeZero (candidateBigModulus scale L g p) := candidateBigModulusNeZero scale L
  intro J B
  let _ : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
  intro M shared D_B k hk hkbound Vs hVs μ ρ V v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi
    hμ hmass T ht Φ hΦ F hF
  let δ : ℝ := (B : ℝ) / (((J + ell).choose ell) ^ (candidateSmallPIndices scale L).card : ℕ)
  let C : ℝ := unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ (candidateBigPIndices scale L).card
  have hδ : 0 ≤ δ := div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _)
  have hC : 0 ≤ C := pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _
  have hpow : (A ^ (candidateSmallPIndices scale L).card) ^ 2 =
      A ^ (2 * (candidateSmallPIndices scale L).card) := by rw [← pow_mul, Nat.mul_comm]
  have hcoef : (2 * Real.sqrt δ * A ^ (candidateSmallPIndices scale L).card) ^ 2 * C =
      4 * δ * (A ^ (2 * (candidateSmallPIndices scale L).card) * C) := by
    rw [mul_pow, mul_pow, hpow, Real.sq_sqrt hδ]
    ring
  have h := hL J B M shared D_B k hk hkbound Vs hVs μ ρ V v vmin vmax
    hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht Φ hΦ F hF
  apply physical_small_big_norm_le_of_energy Vs
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (2 * Real.sqrt δ * A ^ (candidateSmallPIndices scale L).card) C
    (mul_nonneg (mul_nonneg (by norm_num) (Real.sqrt_nonneg δ))
      (pow_nonneg (zero_le_one.trans hA) _)) hC F _
  rw [hcoef]
  exact h

end Bounty
end

section

/- Actual fixed-skeleton ghost stages pay exactly their original selected-child atom costs. -/

open Finset Classical

namespace Bounty

section Ghost
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
    [∀ g, DecidableEq (P g)] {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K))) (u : Fin steps.length) (j : J)
    (htag : steps.get u = some (.inl j))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))
    (μ : ∀ g, P g → ℝ) (q ρ v : ℝ) (V η : Fin N → ℝ)

theorem full_mixed_ghost_all_skeletons_stage_le
    (hη : ∀ g, 0 ≤ η g) (hμ : ∀ g p, 0 ≤ μ g p) (hμatom : ∀ g p, μ g p ≤ η g) (hv : 0 < v)
    (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (hρ : 0 < ρ)
    (hD : q / ρ ^ 2 + ((1 - q) / ρ) / v ≤ 1) :
    let d := fullMixedSelectedCount S B steps code u
    (∑ sk : CoupledGhostSkeleton M B s, ∑ births : CoupledGhostSamples M B s sk,
      if birthForestStageCondition
        (fun i => fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i)) u
        (fullMixedBirthHistoryWrite n S B A Δ D steps u s
          (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inl j)) htag s
            ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩)) history) code then
        |coupledGhostJointEventWeight
          (fun g => physicalGhostRetention (n g) q ρ)
          (fun g => physicalGhostTermination (n g) q ρ)
          (fun g => physicalGhostBirth (n g) q ρ (V g))
          (fun g => unrestrictedResidueWeight (μ g)) M B s
          ((coupledGhostSkeletonEquiv M B s).symm ⟨sk, births⟩)| *
        productLengthLyapunov v
          (coupledGhostJointEventTarget M B s ((coupledGhostSkeletonEquiv M B s).symm ⟨sk, births⟩))
      else 0) ≤
    (∏ g, ((|(1 - q) * V g / ρ| * η g) * v) ^ d g) *
      (∏ g, Real.exp ((|(1 - q) * V g / ρ| * ∑ p, μ g p) * v)) * productLengthLyapunov v s := by
  dsimp only
  refine le_trans (sum_le_sum fun sk _ =>
    full_mixed_ghost_skeleton_stage_le n S B A Δ D steps u j htag s history code sk μ q ρ v V η hη hμ hμatom hv.le) ?_
  have h := coupled_physical_ghost_marked_length_row_le n μ q ρ v V
    (fun g => |(1 - q) * V g / ρ| * η g) hμ
    (fun g => mul_nonneg (abs_nonneg _) (hη g)) hq0 hq1 hρ hv hD M B
    (fullMixedSelectedCount S B steps code u) s
  refine le_trans (le_of_eq ?_) h
  apply sum_congr rfl
  intro sk _
  split_ifs <;> rfl

end Ghost
end Bounty
end

section

/- Actual fixed-skeleton full-edge stages pay exactly their original selected-child atom costs. -/

open Finset Classical

namespace Bounty

section Edge
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
    [∀ g, DecidableEq (P g)] {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K))) (u : Fin steps.length) (k : K)
    (htag : steps.get u = some (.inr k))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))
    [∀ c, Fintype (A k c)]
    (ω : ∀ c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (ρ v vmin : ℝ) (V η : Fin N → ℝ)

theorem full_mixed_edge_all_skeletons_stage_le
    (hη : ∀ g, 0 ≤ η g) (hμ : ∀ g p, 0 ≤ μ g p) (hμatom : ∀ g p, μ g p ≤ η g) (hv : 1 < v)
    (hω : ∀ c a, 0 ≤ ω c a) (hωmass : ∀ c, ∑ a, ω c a ≤ 1)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hvmin : 0 < vmin) (hV : ∀ g, vmin ≤ V g)
    (hmass : ∀ g, ∑ p, μ g p ≤ 2) (T : ℕ) (ht : ∀ g, (S k g)ᶜ.card ≤ T) :
    let d := fullMixedSelectedCount S B steps code u
    (∑ sk : FullActiveEdgeSkeleton n (S k) B (A k) (Δ k) (D k) s, ∑ fresh : FullActiveEdgeSamples n (S k) B (A k) (Δ k) (D k) s sk,
      if birthForestStageCondition
        (fun i => fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i)) u
        (fullMixedBirthHistoryWrite n S B A Δ D steps u s
          (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inr k)) htag s
            ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm ⟨sk, fresh⟩)) history) code then
        |fullActiveEdgeEventWeight n (S k) B (A k) (Δ k) (D k) ω μ ρ V s ((fullActiveEdgeSkeletonEquiv n (S k) B (A k) (Δ k) (D k) s).symm ⟨sk, fresh⟩)| * productLengthLyapunov v (fullActiveEdgeEventTarget n (S k) B (A k) (Δ k) (D k) s ((fullActiveEdgeSkeletonEquiv n (S k) B (A k) (Δ k) (D k) s).symm ⟨sk, fresh⟩))
      else 0) ≤
    (∏ g, η g ^ d g) * productLengthLyapunov v s * unrestrictedEdgeRowBound ρ v vmin T ^ N := by
  dsimp only
  refine le_trans (sum_le_sum fun sk _ =>
    full_mixed_edge_skeleton_stage_le n S B A Δ D steps u k htag s history code sk ω μ ρ v V η hη hμ hμatom (zero_lt_one.trans hv).le) ?_
  have h := full_active_edge_marked_length_row_le n (S k) B (A k) (Δ k) (D k) ω
    ρ v vmin V (fun g => ∑ p, μ g p) η hω hωmass hρ0 hρ1 hv hvmin hV
    (fun g => sum_nonneg fun p _ => hμ g p) hmass hη T ht
    (fullMixedSelectedCount S B steps code u) s
  simp only [Fintype.card_fin] at h
  refine le_trans (le_of_eq ?_) h
  apply sum_congr rfl
  intro sk _
  split_ifs <;> rfl

end Edge
end Bounty
end

section

/- Exact original event rows with the chronological owner indicator. -/

open Finset Classical

namespace Bounty

section Reindex
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
    {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ v : ℝ) (V : Fin N → ℝ)
    (steps : List (Option (J ⊕ K))) (u : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))

theorem full_mixed_ghost_stage_reindex (j : J) (htag : steps.get u = some (.inl j)) :
    let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
    (∑ e : FullPermutationMixedEvent n S B A Δ D (some (.inl j)) s,
      |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V (some (.inl j)) s e| *
        fullMixedForestHistoryGain n S B A Δ D steps code u.val (some (.inl j)) s e history *
        productLengthLyapunov v (fullPermutationMixedEventTarget n S B A Δ D (some (.inl j)) s e)) =
    ∑ sk : CoupledGhostSkeleton M B s, ∑ z : CoupledGhostSamples M B s sk,
      if birthForestStageCondition
        (fun i => fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i)) u
        (fullMixedBirthHistoryWrite n S B A Δ D steps u s
          (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inl j)) htag s ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, z⟩)) history) code then
        |coupledGhostJointEventWeight
          (fun g => physicalGhostRetention (n g) (q j) ρ)
          (fun g => physicalGhostTermination (n g) (q j) ρ)
          (fun g => physicalGhostBirth (n g) (q j) ρ (V g))
          (fun g => unrestrictedResidueWeight (μ g)) M B s
          ((coupledGhostSkeletonEquiv M B s).symm ⟨sk, z⟩)| * productLengthLyapunov v (coupledGhostJointEventTarget M B s ((coupledGhostSkeletonEquiv M B s).symm ⟨sk, z⟩))
      else 0 := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
  have he := ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm.sum_comp (fun e =>
    |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V (some (.inl j)) s e| *
      fullMixedForestHistoryGain n S B A Δ D steps code u.val (some (.inl j)) s e history *
      productLengthLyapunov v (fullPermutationMixedEventTarget n S B A Δ D (some (.inl j)) s e))).symm
  rw [Fintype.sum_sigma] at he
  refine he.trans ?_
  apply sum_congr rfl
  intro sk _
  apply sum_congr rfl
  intro z _
  rw [full_mixed_forest_history_gain_tagged n S B A Δ D steps code u (some (.inl j)) htag,
    full_permutation_ghost_skeleton_weight, full_permutation_ghost_skeleton_target]
  split_ifs <;> simp only [mul_one, mul_zero, zero_mul]

theorem full_mixed_edge_stage_reindex (k : K) (htag : steps.get u = some (.inr k)) :
    let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
    (∑ e : FullPermutationMixedEvent n S B A Δ D (some (.inr k)) s,
      |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V (some (.inr k)) s e| *
        fullMixedForestHistoryGain n S B A Δ D steps code u.val (some (.inr k)) s e history *
        productLengthLyapunov v (fullPermutationMixedEventTarget n S B A Δ D (some (.inr k)) s e)) =
    ∑ sk : FullActiveEdgeSkeleton n (S k) B (A k) (Δ k) (D k) s, ∑ z : FullActiveEdgeSamples n (S k) B (A k) (Δ k) (D k) s sk,
      if birthForestStageCondition
        (fun i => fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i)) u
        (fullMixedBirthHistoryWrite n S B A Δ D steps u s
          (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inr k)) htag s ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm ⟨sk, z⟩)) history) code then
        |fullActiveEdgeEventWeight n (S k) B (A k) (Δ k) (D k) (ω k) μ ρ V s ((fullActiveEdgeSkeletonEquiv n (S k) B (A k) (Δ k) (D k) s).symm ⟨sk, z⟩)| * productLengthLyapunov v (fullActiveEdgeEventTarget n (S k) B (A k) (Δ k) (D k) s ((fullActiveEdgeSkeletonEquiv n (S k) B (A k) (Δ k) (D k) s).symm ⟨sk, z⟩))
      else 0 := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
  have he := ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm.sum_comp (fun e =>
    |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V (some (.inr k)) s e| *
      fullMixedForestHistoryGain n S B A Δ D steps code u.val (some (.inr k)) s e history *
      productLengthLyapunov v (fullPermutationMixedEventTarget n S B A Δ D (some (.inr k)) s e))).symm
  rw [Fintype.sum_sigma] at he
  refine he.trans ?_
  apply sum_congr rfl
  intro sk _
  apply sum_congr rfl
  intro z _
  rw [full_mixed_forest_history_gain_tagged n S B A Δ D steps code u (some (.inr k)) htag,
    full_permutation_edge_skeleton_weight, full_permutation_edge_skeleton_target]
  split_ifs <;> simp only [mul_one, mul_zero, zero_mul]

end Reindex
end Bounty
