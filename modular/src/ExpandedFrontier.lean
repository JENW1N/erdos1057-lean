open Finset Filter
open scoped Topology
noncomputable def candidateRestrictedOrdinaryMass (c L eps q : ℝ) (r jStar J : ℕ) : ℝ :=
  ∑ p ∈ candidateSmallPSet c L (Real.exp ((c / 100) * L)),
    candidatePWeight c L q p *
      ∑ n ∈ arithmeticProductWindow p (Real.exp L),
        orderedSlotWeight (candidatePrefixChoices c L eps r jStar J)
          ((r.factorial : ℝ)^(candidateQIndices c L).card) n

noncomputable def candidateOrdinaryWindowMass (c L q : ℝ) (r jStar : ℕ) : ℝ :=
  ∑ p ∈ candidateSmallPSet c L (Real.exp ((c / 100) * L)),
    candidatePWeight c L q p *
      ∑ n ∈ arithmeticProductWindow p (Real.exp L), candidateQWeight c L r jStar n

theorem candidate_restricted_ordinary_eq_localized (c L eps q : ℝ) (r jStar J : ℕ)
    (hr : 0 < r) (hJ : J < jStar) :
    candidateRestrictedOrdinaryMass c L eps q r jStar J =
      candidateLocalizedWindowMass c L eps q r jStar J hr := by
  classical
  unfold candidateRestrictedOrdinaryMass candidateLocalizedWindowMass
  apply sum_congr rfl
  intro p hp
  rw [ordered_slot_arithmetic_window_split _ (candidateFreeSlot c L r hr) _
      (candidate_small_P_set_nonzero hp), candidate_prefix_free_choice c L eps r jStar J hr hJ,
    mul_sum]
  apply sum_congr rfl
  intro y _
  change candidatePWeight c L q p *
    (((primeProductWindow (candidateQBand (c * L) 0)
      ((p * orderedSlotProduct (candidatePrefixRestChoices c L eps r jStar J hr) y : ℕ) : ℝ)
      (Real.exp L)).card : ℝ) / ((r.factorial : ℝ)^(candidateQIndices c L).card)) = _
  ring

theorem candidate_ordinary_window_mass_nonneg (c L : ℝ) {q : ℝ} (hq : 0 ≤ q)
    (r jStar : ℕ) : 0 ≤ candidateOrdinaryWindowMass c L q r jStar := by
  apply sum_nonneg
  intro p _
  exact mul_nonneg (candidate_P_weight_nonneg c L hq p)
    (sum_nonneg (fun n _ => candidate_Q_weight_nonneg c L r jStar n))
end

section
open Finset Filter
open scoped Topology
theorem candidate_restricted_ordinary_mass_le {c L eps q : ℝ} {r jStar J : ℕ}
    (hcL : 0 ≤ c * L) (heps : eps ≤ 1/10) (hq : 0 ≤ q) (hJ : J < jStar) :
    candidateRestrictedOrdinaryMass c L eps q r jStar J ≤
      candidateOrdinaryWindowMass c L q r jStar := by
  apply sum_le_sum
  intro p _
  apply mul_le_mul_of_nonneg_left _ (candidate_P_weight_nonneg c L hq p)
  apply sum_le_sum
  intro n _
  exact ordered_slot_weight_mono _ _ (candidatePrefixChoices_subset hcL heps hJ) (by positivity) n

theorem candidate_localized_mass_le_ordinary {c L eps q : ℝ} {r jStar J : ℕ}
    (hr : 0 < r) (hcL : 0 ≤ c * L) (heps : eps ≤ 1/10) (hq : 0 ≤ q) (hJ : J < jStar) :
    candidateLocalizedWindowMass c L eps q r jStar J hr ≤
      candidateOrdinaryWindowMass c L q r jStar := by
  rw [← candidate_restricted_ordinary_eq_localized c L eps q r jStar J hr hJ]
  exact candidate_restricted_ordinary_mass_le hcL heps hq hJ

/-- The small P-part and full Q candidate supply positive ordinary mass in
the exact wider interval (exp L, 16 exp L]. Constants and thresholds are
uniform in every later rough-slot index jStar > J. -/
theorem exists_candidate_ordinary_window_mass_lower {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1) :
    ∃ K : ℝ, 0 < K ∧ ∃ J : ℕ,
      ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, J < jStar →
        K * (Real.exp L / L) * candidateOneMarkedHarmonicMass c L q *
          candidateQHarmonicMass c L r jStar ≤
        candidateOrdinaryWindowMass c L q r jStar := by
  obtain ⟨eps, J, K, _, heps1, hK, hmass⟩ :=
    exists_candidate_localized_window_mass_lower hc hr hq0 hq1 hcenter
  refine ⟨K, hK, J, ?_⟩
  filter_upwards [hmass, eventually_ge_atTop (0 : ℝ)] with L hL hL0
  intro jStar hJ
  exact (hL jStar hJ).trans (candidate_localized_mass_le_ordinary hr
    (mul_nonneg hc.le hL0) heps1 hq0 hJ)
end

section
open Finset
/-- A coordinate has left the unborn state. -/
def ghostPhaseBorn {R : Type*} (z : GhostPhaseState R) : Prop := z ≠ some none

/-- All coordinates with active, pending, or completed phase tags. -/
noncomputable def ghostPhaseBornSupport {P : Type*} [Fintype P] {R : P → Type*}
    (z : (p : P) → GhostPhaseState (R p)) : Finset P := by
  classical
  exact univ.filter (fun p => ghostPhaseBorn (z p))

theorem ghost_phase_mem_born_support {P : Type*} [Fintype P] {R : P → Type*}
    (z : (p : P) → GhostPhaseState (R p)) (p : P) :
    p ∈ ghostPhaseBornSupport z ↔ z p ≠ some none := by
  classical
  unfold ghostPhaseBornSupport
  exact mem_filter.trans (and_iff_right (mem_univ p))

theorem ghost_phase_born_tags {R : Type*} (r : R) :
    ghostPhaseBorn (none : GhostPhaseState R) ∧
      ghostPhaseBorn (some (some none) : GhostPhaseState R) ∧
      ghostPhaseBorn (some (some (some r))) ∧
      ¬ ghostPhaseBorn (some none : GhostPhaseState R) := by
  simp [ghostPhaseBorn]

/-- Residue frame changes do not change whether the coordinate has been born. -/
theorem ghost_phase_born_shift_iff {R : Type*} [AddGroup R]
    (delta : R) (z : GhostPhaseState R) :
    ghostPhaseBorn (ghostPhaseShift delta z) ↔ ghostPhaseBorn z :=
  not_congr (ghost_phase_shift_unborn_iff delta z)

theorem ghost_phase_born_support_shift {P : Type*} [Fintype P] {R : P → Type*}
    [∀ p, AddGroup (R p)] (delta : (p : P) → R p)
    (z : (p : P) → GhostPhaseState (R p)) :
    ghostPhaseBornSupport (fun p => ghostPhaseShift (delta p) (z p)) =
      ghostPhaseBornSupport z := by
  classical
  ext p
  rw [ghost_phase_mem_born_support, ghost_phase_mem_born_support]
  exact not_congr (ghost_phase_shift_unborn_iff (delta p) (z p))

/-- Every pending particle has already left the unborn state. -/
theorem ghost_phase_pending_subset_born {P : Type*} [Fintype P] {R : P → Type*}
    (z : (p : P) → GhostPhaseState (R p)) :
    ghostPhasePendingSupport z ⊆ ghostPhaseBornSupport z := by
  classical
  intro p hp
  obtain ⟨r, hr⟩ : ∃ r, z p = some (some (some r)) := by
    simpa only [ghostPhasePendingSupport, mem_filter, mem_univ, true_and] using hp
  rw [ghost_phase_mem_born_support, hr]
  simp
end

section
open Finset
open scoped Classical
noncomputable def chronologicalBirthPrefix {T P : Type*} [Fintype T] [LT T]
    {J : T → Type*} [∀ t, Fintype (J t)] (label : (t : T) → J t → P)
    (t : T) : Finset P :=
  (univ.filter (fun s => s < t)).biUnion (fun s => univ.image (label s))

theorem mem_chronological_birth_prefix {T P : Type*} [Fintype T] [LT T]
    {J : T → Type*} [∀ t, Fintype (J t)] (label : (t : T) → J t → P)
    (t : T) (p : P) :
    p ∈ chronologicalBirthPrefix label t ↔ ∃ s, s < t ∧ ∃ j, label s j = p := by
  simp [chronologicalBirthPrefix]

/-- Birth address injectivity forbids a fresh label from matching any label
at an earlier time, whether or not the earlier particle is still present. -/
theorem chronological_birth_injective_implies_fresh {T P : Type*} [Fintype T]
    [Preorder T] {J : T → Type*} [∀ t, Fintype (J t)]
    (label : (t : T) → J t → P)
    (hinj : Function.Injective (fun e : Sigma J => label e.1 e.2)) :
    ∀ t j, label t j ∉ chronologicalBirthPrefix label t := by
  intro t j h
  obtain ⟨s, hst, k, hlabel⟩ := (mem_chronological_birth_prefix label t (label t j)).mp h
  have he : (⟨s, k⟩ : Sigma J) = ⟨t, j⟩ := hinj hlabel
  have htime : s = t := congrArg Sigma.fst he
  exact (ne_of_lt hst) htime

/-- Keeping a cumulative label set implements exactly the global distinct
birth condition once each individual birth batch is itself injective. -/
theorem chronological_birth_injective_iff {T P : Type*} [Fintype T] [LinearOrder T]
    {J : T → Type*} [∀ t, Fintype (J t)] (label : (t : T) → J t → P) :
    Function.Injective (fun e : Sigma J => label e.1 e.2) ↔
      (∀ t, Function.Injective (label t)) ∧
      ∀ t j, label t j ∉ chronologicalBirthPrefix label t := by
  constructor
  · intro h
    refine ⟨?_, chronological_birth_injective_implies_fresh label h⟩
    intro t j k hjk
    have he : (⟨t, j⟩ : Sigma J) = ⟨t, k⟩ := h hjk
    exact eq_of_heq (Sigma.mk.inj he).2
  · rintro ⟨hinj, hfresh⟩ ⟨t, j⟩ ⟨s, k⟩ he
    rcases lt_trichotomy t s with hts | hts | hst
    · exact (hfresh s k ((mem_chronological_birth_prefix label s (label s k)).mpr
        ⟨t, hts, j, he⟩)).elim
    · subst s
      have hjk : j = k := hinj t he
      subst k
      rfl
    · exact (hfresh t j ((mem_chronological_birth_prefix label t (label t j)).mpr
        ⟨s, hst, k, he.symm⟩)).elim

/-- For already-injective ordered batches, only the cumulative exclusion
remains to characterize global injectivity of every birth address. -/
theorem chronological_distinct_batches_iff {T P : Type*} [Fintype T] [LinearOrder T]
    {J : T → Type*} [∀ t, Fintype (J t)] (label : (t : T) → J t ↪ P) :
    Function.Injective (fun e : Sigma J => label e.1 e.2) ↔
      ∀ t j, label t j ∉ chronologicalBirthPrefix (fun s => label s) t := by
  exact (chronological_birth_injective_iff (fun t j => label t j)).trans
    (and_iff_right (fun t => (label t).injective))

/-- There are no earlier births before the initial batch. -/
theorem chronological_birth_prefix_zero {P : Type*} {n : ℕ}
    {J : Fin (n + 1) → Type*} [∀ t, Fintype (J t)]
    (label : (t : Fin (n + 1)) → J t → P) :
    chronologicalBirthPrefix label 0 = ∅ := by
  ext p
  simp [mem_chronological_birth_prefix]

/-- The cumulative set grows by exactly the current batch before the next cut. -/
theorem chronological_birth_prefix_step {P : Type*} [DecidableEq P] {n : ℕ}
    {J : Fin (n + 1) → Type*} [∀ t, Fintype (J t)]
    (label : (t : Fin (n + 1)) → J t → P) (t : Fin n) :
    chronologicalBirthPrefix label t.succ =
      chronologicalBirthPrefix label t.castSucc ∪ univ.image (label t.castSucc) := by
  ext p
  rw [mem_union, mem_chronological_birth_prefix, mem_chronological_birth_prefix]
  constructor
  · rintro ⟨u, hu, j, hj⟩
    by_cases hut : u = t.castSucc
    · subst u
      exact Or.inr (mem_image.mpr ⟨j, mem_univ _, hj⟩)
    · refine Or.inl ⟨u, ?_, j, hj⟩
      have hne : u.val ≠ t.val := fun h => hut (Fin.ext h)
      have hlt : u.val < t.val + 1 := hu
      change u.val < t.val
      omega
  · rintro (⟨u, hu, j, hj⟩ | hp)
    · exact ⟨u, lt_trans hu (by change t.val < t.val + 1; omega), j, hj⟩
    · obtain ⟨j, _, hj⟩ := mem_image.mp hp
      exact ⟨t.castSucc, by change t.val < t.val + 1; omega, j, hj⟩

/-- A ledger starting empty and updated by each birth batch is exactly the
set of all earlier birth labels. No distinctness assumption is needed. -/
theorem chronological_birth_ledger_eq_prefix {P : Type*} [DecidableEq P] {n : ℕ}
    {J : Fin (n + 1) → Type*} [∀ t, Fintype (J t)]
    (label : (t : Fin (n + 1)) → J t → P) (H : Fin (n + 1) → Finset P)
    (h0 : H 0 = ∅)
    (hstep : ∀ t : Fin n, H t.succ = H t.castSucc ∪ univ.image (label t.castSucc)) :
    ∀ t, H t = chronologicalBirthPrefix label t := by
  intro t
  induction t using Fin.induction with
  | zero => rw [h0, chronological_birth_prefix_zero]
  | succ t ih => rw [hstep, ih, chronological_birth_prefix_step]

/-- A complete finite list of distinct birth batches obeys the global
all-addresses rule exactly when every draw avoids the running ledger. -/
theorem chronological_birth_ledger_distinct_iff {P : Type*} [DecidableEq P] {n : ℕ}
    {J : Fin (n + 1) → Type*} [∀ t, Fintype (J t)]
    (label : (t : Fin (n + 1)) → J t ↪ P) (H : Fin (n + 1) → Finset P)
    (h0 : H 0 = ∅)
    (hstep : ∀ t : Fin n, H t.succ = H t.castSucc ∪ univ.image (label t.castSucc)) :
    Function.Injective (fun e : Sigma J => label e.1 e.2) ↔
      ∀ t j, label t j ∉ H t := by
  have hH := chronological_birth_ledger_eq_prefix (fun t => label t) H h0 hstep
  simpa only [hH] using chronological_distinct_batches_iff label
end

section

/-- Pull a terminal test at cut `n` backwards through rows `n-1,...,0`.
The resulting function is on the initial state space. -/
def finiteRowComposition {S : Nat → Type*} {V : Type*}
    (row : (i : Nat) → (S (i + 1) → V) → S i → V) :
    (n : Nat) → (S n → V) → S 0 → V
  | 0, F => F
  | n + 1, F => finiteRowComposition row n (row n F)

theorem finite_row_composition_zero {S : Nat → Type*} {V : Type*}
    (row : (i : Nat) → (S (i + 1) → V) → S i → V) (F : S 0 → V) :
    finiteRowComposition row 0 F = F := rfl

theorem finite_row_composition_succ {S : Nat → Type*} {V : Type*}
    (row : (i : Nat) → (S (i + 1) → V) → S i → V)
    (n : Nat) (F : S (n + 1) → V) :
    finiteRowComposition row (n + 1) F = finiteRowComposition row n (row n F) := rfl

/-- If each actual row pulls readout tests back to the corresponding target
row, the complete finite chronological compositions satisfy the same exact
readout identity. The maps and both state spaces may vary at every cut. -/
theorem finite_row_composition_intertwines {S T : Nat → Type*} {V : Type*}
    (rowS : (i : Nat) → (S (i + 1) → V) → S i → V)
    (rowT : (i : Nat) → (T (i + 1) → V) → T i → V)
    (readout : (i : Nat) → S i → T i)
    (hrow : ∀ i (F : T (i + 1) → V),
      rowS i (F ∘ readout (i + 1)) = (rowT i F) ∘ readout i)
    (n : Nat) (F : T n → V) :
    finiteRowComposition rowS n (F ∘ readout n) =
      (finiteRowComposition rowT n F) ∘ readout 0 := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [finite_row_composition_succ, hrow n F, finite_row_composition_succ]
      exact ih (rowT n F)

/-- Pointwise form, suitable for evaluating at a coherent initial state before
attaching initial weights or terminal pairings. -/
theorem finite_row_composition_intertwines_apply {S T : Nat → Type*} {V : Type*}
    (rowS : (i : Nat) → (S (i + 1) → V) → S i → V)
    (rowT : (i : Nat) → (T (i + 1) → V) → T i → V)
    (readout : (i : Nat) → S i → T i)
    (hrow : ∀ i (F : T (i + 1) → V),
      rowS i (F ∘ readout (i + 1)) = (rowT i F) ∘ readout i)
    (n : Nat) (F : T n → V) (s : S 0) :
    finiteRowComposition rowS n (F ∘ readout n) s =
      finiteRowComposition rowT n F (readout 0 s) :=
  congrFun (finite_row_composition_intertwines rowS rowT readout hrow n F) s
end

section
open Finset
/-- Active labels read directly from the phase snapshot. -/
noncomputable def ghostPhaseStateActiveSupport {P : Type*} [Fintype P]
    {R : P → Type*} (z : (p : P) → GhostPhaseState (R p)) : Finset P := by
  classical
  exact univ.filter (fun p => z p = none)

theorem ghost_phase_mem_state_active_support {P : Type*} [Fintype P]
    {R : P → Type*} (z : (p : P) → GhostPhaseState (R p)) (p : P) :
    p ∈ ghostPhaseStateActiveSupport z ↔ z p = none := by
  classical
  unfold ghostPhaseStateActiveSupport
  exact mem_filter.trans (and_iff_right (mem_univ p))

theorem ghost_phase_state_active_subset_born {P : Type*} [Fintype P]
    {R : P → Type*} (z : (p : P) → GhostPhaseState (R p)) :
    ghostPhaseStateActiveSupport z ⊆ ghostPhaseBornSupport z := by
  intro p hp
  rw [ghost_phase_mem_state_active_support] at hp
  rw [ghost_phase_mem_born_support, hp]
  simp

/-- The state-level active support agrees with the physical activity mask. -/
theorem ghost_phase_state_active_support_of_mask {P : Type*} [Fintype P]
    {R : P → Type*} (a : P → Bool) (z : (p : P) → GhostPhaseState (R p))
    (hz : ghostPhaseMask a z) :
    ghostPhaseStateActiveSupport z = ghostPhaseActivitySupport a := by
  classical
  ext p
  rw [ghost_phase_mem_state_active_support]
  simp only [ghostPhaseActivitySupport, mem_filter, mem_univ, true_and]
  have hp := hz p
  cases ha : a p <;> cases he : z p <;> simp_all

/-- Active labels are active; other previously born labels are completed;
all remaining labels are unborn. Pending particles are supplied separately. -/
noncomputable def globalBirthMemoryBase {P : Type*} {R : P → Type*}
    (active born : Finset P) : (p : P) → GhostPhaseState (R p) := by
  classical
  exact fun p => if p ∈ active then none else
    if p ∈ born then some (some none) else some none

/-- A uniform snapshot readout. Compatible pending particles override the
base only at inactive born labels. On an incompatible arbitrary tuple, the
pending preference may override active or unborn metadata; exact reconstruction
below supplies compatibility through support and particle agreement. -/
noncomputable def globalBirthMemoryReadout {P : Type*} {R : P → Type*}
    (active born : Finset P) (q : FiniteOrderedTuple (Σ p, R p)) :
    (p : P) → GhostPhaseState (R p) :=
  ghostPhaseMemoryReadout (globalBirthMemoryBase active born) q

/-- Off the pending support, the cumulative-born base already reconstructs
the complete phase tag. -/
theorem global_birth_memory_base_eq_outside_pending {P : Type*} [Fintype P]
    {R : P → Type*} (z : (p : P) → GhostPhaseState (R p)) (p : P)
    (hp : p ∉ ghostPhasePendingSupport z) :
    globalBirthMemoryBase (ghostPhaseStateActiveSupport z) (ghostPhaseBornSupport z) p =
      z p := by
  classical
  have hn : ¬ ∃ r, z p = some (some (some r)) := by
    simpa only [ghostPhasePendingSupport, mem_filter, mem_univ, true_and] using hp
  cases he : z p with
  | none => simp [globalBirthMemoryBase, ghost_phase_mem_state_active_support, he]
  | some c =>
      cases c with
      | none => simp [globalBirthMemoryBase, ghost_phase_mem_state_active_support,
          ghost_phase_mem_born_support, he]
      | some c =>
          cases c with
          | none => simp [globalBirthMemoryBase, ghost_phase_mem_state_active_support,
              ghost_phase_mem_born_support, he]
          | some r => exact (hn ⟨r, he⟩).elim

/-- Exact snapshot reconstruction. Particle consistency and complete support
suffice; distinctness is only needed for the ordered-memory sector and norm. -/
theorem global_birth_memory_readout_eq {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (z : (p : P) → GhostPhaseState (R p))
    (q : FiniteOrderedTuple (Σ p, R p))
    (hsupport : univ.image (fun j => (q.2 j).1) = ghostPhasePendingSupport z)
    (hparticle : ∀ j, z (q.2 j).1 = some (some (some (q.2 j).2))) :
    globalBirthMemoryReadout (ghostPhaseStateActiveSupport z) (ghostPhaseBornSupport z) q =
      z := by
  exact ghost_phase_memory_readout_eq _ z q hsupport hparticle
    (global_birth_memory_base_eq_outside_pending z)

/-- The same reconstruction with a supplied physical activity mask. -/
theorem global_birth_memory_readout_eq_of_mask {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (a : P → Bool) (z : (p : P) → GhostPhaseState (R p))
    (hz : ghostPhaseMask a z) (q : FiniteOrderedTuple (Σ p, R p))
    (hsupport : univ.image (fun j => (q.2 j).1) = ghostPhasePendingSupport z)
    (hparticle : ∀ j, z (q.2 j).1 = some (some (some (q.2 j).2))) :
    globalBirthMemoryReadout (ghostPhaseActivitySupport a) (ghostPhaseBornSupport z) q =
      z := by
  rw [← ghost_phase_state_active_support_of_mask a z hz]
  exact global_birth_memory_readout_eq z q hsupport hparticle

/-- Global active and born snapshots plus a complete pending tuple determine
all phase tags, including the otherwise invisible unborn/completed flags. -/
theorem global_birth_memory_snapshot_unique {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (z w : (p : P) → GhostPhaseState (R p))
    (q : FiniteOrderedTuple (Σ p, R p))
    (hactive : ghostPhaseStateActiveSupport z = ghostPhaseStateActiveSupport w)
    (hborn : ghostPhaseBornSupport z = ghostPhaseBornSupport w)
    (hzsupport : univ.image (fun j => (q.2 j).1) = ghostPhasePendingSupport z)
    (hwsupport : univ.image (fun j => (q.2 j).1) = ghostPhasePendingSupport w)
    (hzparticle : ∀ j, z (q.2 j).1 = some (some (some (q.2 j).2)))
    (hwparticle : ∀ j, w (q.2 j).1 = some (some (some (q.2 j).2))) : z = w := by
  rw [← global_birth_memory_readout_eq z q hzsupport hzparticle, hactive, hborn]
  exact global_birth_memory_readout_eq w q hwsupport hwparticle

/-- The cumulative-born base gives an ordered-tuple symmetric phase test. -/
theorem global_birth_symmetric_readout_symmetric {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (active born : Finset P)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) :
    OrderedTupleSymmetric (symmetricPhaseReadout (globalBirthMemoryBase active born) F) :=
  symmetric_phase_readout_symmetric _ F

/-- On an actual distinct pending tuple, the global symmetric readout equals
the original phase continuation exactly. -/
theorem global_birth_symmetric_readout_eq {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (z : (p : P) → GhostPhaseState (R p))
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ)
    (q : FiniteOrderedTuple (Σ p, R p))
    (hinj : Function.Injective (Sigma.fst ∘ q.2))
    (hsupport : univ.image (fun j => (q.2 j).1) = ghostPhasePendingSupport z)
    (hparticle : ∀ j, z (q.2 j).1 = some (some (some (q.2 j).2))) :
    symmetricPhaseReadout
      (globalBirthMemoryBase (ghostPhaseStateActiveSupport z) (ghostPhaseBornSupport z)) F q =
      F z :=
  symmetric_phase_readout_eq_of_reconstruction _ z F q hinj hsupport
    (global_birth_memory_readout_eq z q hsupport hparticle)

/-- The exact symmetric readout also accepts the physical activity mask. -/
theorem global_birth_symmetric_readout_eq_of_mask {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (a : P → Bool) (z : (p : P) → GhostPhaseState (R p))
    (hz : ghostPhaseMask a z) (F : ((p : P) → GhostPhaseState (R p)) → ℂ)
    (q : FiniteOrderedTuple (Σ p, R p))
    (hinj : Function.Injective (Sigma.fst ∘ q.2))
    (hsupport : univ.image (fun j => (q.2 j).1) = ghostPhasePendingSupport z)
    (hparticle : ∀ j, z (q.2 j).1 = some (some (some (q.2 j).2))) :
    symmetricPhaseReadout
      (globalBirthMemoryBase (ghostPhaseActivitySupport a) (ghostPhaseBornSupport z)) F q =
      F z := by
  rw [← ghost_phase_state_active_support_of_mask a z hz]
  exact global_birth_symmetric_readout_eq z F q hinj hsupport hparticle

/-- The global readout preserves the pending-cardinality weight as the
literal ordered-memory length, extending by zero on unsupported tuples. -/
theorem global_birth_symmetric_readout_norm_le {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (active born : Finset P)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ)
    (C v : ℝ) (hC : 0 ≤ C) (hv : 0 ≤ v)
    (hF : ∀ z, ‖F z‖ ≤ C * v ^ (ghostPhasePendingSupport z).card)
    (q : FiniteOrderedTuple (Σ p, R p)) :
    ‖symmetricPhaseReadout (globalBirthMemoryBase active born) F q‖ ≤ C * v ^ q.1 :=
  symmetric_phase_readout_norm_le _ F C v hC hv hF q
end

section
open Finset
open scoped Classical
/-- Monotone lifecycle rank prevents recovery of the unborn tag. -/
theorem ghost_phase_born_of_rank_le {R : Type*} {z w : GhostPhaseState R}
    (h : ghostPhaseRank w ≤ ghostPhaseRank z) (hw : ghostPhaseBorn w) :
    ghostPhaseBorn z := by
  intro hz
  have hw0 : ghostPhaseRank w = 0 := by
    rw [hz] at h
    exact Nat.eq_zero_of_le_zero h
  exact hw ((ghost_phase_rank_zero_iff w).1 hw0)

/-- A monotone finite lifecycle has been born at a cut exactly when it was
already born initially or an earlier transition left the unborn tag. -/
theorem ghost_phase_finite_born_iff {R : Type*} {n : ℕ}
    (x : Fin (n + 1) → GhostPhaseState R)
    (hm : Monotone (fun j => ghostPhaseRank (x j))) (k : Fin (n + 1)) :
    ghostPhaseBorn (x k) ↔ ghostPhaseBorn (x 0) ∨
      ∃ j : Fin n, j.val < k.val ∧
        x j.castSucc = some none ∧ ghostPhaseBorn (x j.succ) := by
  constructor
  · induction k using Fin.induction with
    | zero => exact fun h => Or.inl h
    | succ k ih =>
      intro hk
      by_cases hp : ghostPhaseBorn (x k.castSucc)
      · rcases ih hp with h0 | ⟨j, hj, hU, hB⟩
        · exact Or.inl h0
        · have hj' : j.val < k.succ.val := by
            simpa only [Fin.val_castSucc, Fin.val_succ] using (Nat.lt_succ_of_lt hj)
          exact Or.inr ⟨j, hj', hU, hB⟩
      · exact Or.inr ⟨k, by simp, by simpa [ghostPhaseBorn] using hp, hk⟩
  · rintro (h0 | ⟨j, hj, hU, hB⟩)
    · exact ghost_phase_born_of_rank_le (hm (Fin.zero_le k)) h0
    · exact ghost_phase_born_of_rank_le (hm (show j.succ ≤ k by
        change j.val + 1 ≤ k.val
        omega)) hB

/-- Labels whose actual tag transition left the unborn state before cut `k`. -/
noncomputable def ghostPhaseBirthLabelsBefore {P : Type*} [Fintype P]
    {R : P → Type*} {n : ℕ}
    (x : Fin (n + 1) → (p : P) → GhostPhaseState (R p)) (k : Fin (n + 1)) :
    Finset P := by
  classical
  exact univ.filter (fun p => ∃ j : Fin n, j.val < k.val ∧
    x j.castSucc p = some none ∧ ghostPhaseBorn (x j.succ p))

theorem ghost_phase_mem_birth_labels_before {P : Type*} [Fintype P]
    {R : P → Type*} {n : ℕ}
    (x : Fin (n + 1) → (p : P) → GhostPhaseState (R p)) (k : Fin (n + 1)) (p : P) :
    p ∈ ghostPhaseBirthLabelsBefore x k ↔ ∃ j : Fin n, j.val < k.val ∧
      x j.castSucc p = some none ∧ ghostPhaseBorn (x j.succ p) := by
  classical
  simp [ghostPhaseBirthLabelsBefore]

/-- The born support increases between all cuts of a rank-monotone trace. -/
theorem ghost_phase_born_support_monotone {P : Type*} [Fintype P]
    {R : P → Type*} {n : ℕ}
    (x : Fin (n + 1) → (p : P) → GhostPhaseState (R p))
    (hm : ∀ p, Monotone (fun j => ghostPhaseRank (x j p))) :
    Monotone (fun j => ghostPhaseBornSupport (x j)) := by
  intro i j hij p hp
  rw [ghost_phase_mem_born_support] at hp ⊢
  exact ghost_phase_born_of_rank_le (hm p hij) hp

/-- Exact cumulative born support, retaining an arbitrary initial born set. -/
theorem ghost_phase_born_support_cumulative {P : Type*} [Fintype P]
    {R : P → Type*} {n : ℕ}
    (x : Fin (n + 1) → (p : P) → GhostPhaseState (R p))
    (hm : ∀ p, Monotone (fun j => ghostPhaseRank (x j p))) (k : Fin (n + 1)) :
    ghostPhaseBornSupport (x k) =
      ghostPhaseBornSupport (x 0) ∪ ghostPhaseBirthLabelsBefore x k := by
  classical
  ext p
  rw [mem_union, ghost_phase_mem_born_support, ghost_phase_mem_born_support,
    ghost_phase_mem_birth_labels_before]
  exact ghost_phase_finite_born_iff (fun j => x j p) (hm p) k

/-- All-cut rank monotonicity follows from the actual finite trace weight. -/
theorem ghost_phase_finite_trace_rank_monotone {R : Type*}
    [Fintype R] [DecidableEq R]
    (isVisit atgt asrc : ℕ → Bool) (htgt hsrc : ℕ → R) (η β : ℕ → ℝ)
    (a0 : Bool) (β0 : ℝ) (an : Bool) {n : ℕ}
    (x : Fin (n + 1) → GhostPhaseState R)
    (hx : ghostPhaseFiniteTraceWeight isVisit atgt asrc htgt hsrc η β a0 β0 an x ≠ 0) :
    Monotone (fun j => ghostPhaseRank (x j)) := by
  rw [ghost_phase_finite_trace_weight_eq] at hx
  have hq := ghost_phase_trace_lifecycle isVisit atgt asrc htgt hsrc η β
    a0 β0 an (ghostPhaseFiniteTraceExtend x) n hx
  intro i j hij
  have h := ghost_phase_path_rank_mono (ghostPhaseFiniteTraceExtend x) n
    (fun l hl => (hq.2 l hl).1) i j hij (Nat.le_of_lt_succ j.isLt)
  simpa only [ghost_phase_finite_extend_at] using h

/-- The initial test allows exactly an active state or an unborn state,
according to the initial active flag. -/
theorem ghost_phase_initial_born_iff {R : Type*} (a : Bool) (β : ℝ)
    (z : GhostPhaseState R) (hz : ghostPhaseInitial a β z ≠ 0) :
    ghostPhaseBorn z ↔ a = true := by
  cases a <;> rcases z with _ | (_ | (_ | r)) <;>
    simp_all [ghostPhaseInitial, ghostFiniteInitial, ghostPhaseBorn]

/-- Full finite tensor trace coefficient, including initial and terminal tests. -/
noncomputable def ghostPhaseFiniteTensorTraceWeight {P : Type*} [Fintype P]
    {R : P → Type*} [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    (isVisit : ℕ → Bool) (atgt asrc : ℕ → P → Bool)
    (htgt hsrc : ℕ → (p : P) → R p) (η β : ℕ → P → ℝ)
    (a0 : P → Bool) (β0 : P → ℝ) (an : P → Bool) {n : ℕ}
    (x : Fin (n + 1) → (p : P) → GhostPhaseState (R p)) : ℝ :=
  ∏ p, ghostPhaseFiniteTraceWeight isVisit (fun j => atgt j p) (fun j => asrc j p)
    (fun j => htgt j p) (fun j => hsrc j p) (fun j => η j p) (fun j => β j p)
    (a0 p) (β0 p) (an p) (fun j => x j p)

section TensorTrace

variable {P : Type*} [Fintype P] {R : P → Type*}
  [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
  (isVisit : ℕ → Bool) (atgt asrc : ℕ → P → Bool)
  (htgt hsrc : ℕ → (p : P) → R p) (η β : ℕ → P → ℝ)
  (a0 : P → Bool) (β0 : P → ℝ) (an : P → Bool) {n : ℕ}
  (x : Fin (n + 1) → (p : P) → GhostPhaseState (R p))
  (hx : ghostPhaseFiniteTensorTraceWeight isVisit atgt asrc htgt hsrc η β a0 β0 an x ≠ 0)

include hx

theorem ghost_phase_finite_tensor_trace_rank_monotone (p : P) :
    Monotone (fun j => ghostPhaseRank (x j p)) := by
  exact ghost_phase_finite_trace_rank_monotone _ _ _ _ _ _ _ _ _ _ _
    ((prod_ne_zero_iff.mp hx) p (mem_univ p))

theorem ghost_phase_finite_tensor_trace_born_monotone :
    Monotone (fun j => ghostPhaseBornSupport (x j)) :=
  ghost_phase_born_support_monotone x
    (ghost_phase_finite_tensor_trace_rank_monotone
      isVisit atgt asrc htgt hsrc η β a0 β0 an x hx)

theorem ghost_phase_finite_tensor_trace_born_cumulative (k : Fin (n + 1)) :
    ghostPhaseBornSupport (x k) =
      ghostPhaseBornSupport (x 0) ∪ ghostPhaseBirthLabelsBefore x k :=
  ghost_phase_born_support_cumulative x
    (ghost_phase_finite_tensor_trace_rank_monotone
      isVisit atgt asrc htgt hsrc η β a0 β0 an x hx) k

theorem ghost_phase_finite_tensor_trace_initial_born :
    ghostPhaseBornSupport (x 0) = univ.filter (fun p => a0 p = true) := by
  classical
  ext p
  rw [ghost_phase_mem_born_support, mem_filter]
  simp only [mem_univ, true_and]
  have hp := (prod_ne_zero_iff.mp hx) p (mem_univ p)
  have hinit := (mul_ne_zero_iff.mp (mul_ne_zero_iff.mp hp).1).1
  exact ghost_phase_initial_born_iff (a0 p) (β0 p) (x 0 p) hinit

/-- The cumulative history starts with exactly the initial-active births. -/
theorem ghost_phase_finite_tensor_trace_born_history (k : Fin (n + 1)) :
    ghostPhaseBornSupport (x k) =
      univ.filter (fun p => a0 p = true) ∪ ghostPhaseBirthLabelsBefore x k := by
  classical
  rw [ghost_phase_finite_tensor_trace_born_cumulative
    isVisit atgt asrc htgt hsrc η β a0 β0 an x hx k,
    ghost_phase_finite_tensor_trace_initial_born
      isVisit atgt asrc htgt hsrc η β a0 β0 an x hx]

end TensorTrace

/-- Specialization to the actual alternating chronological trace product.
There are `n+1` visits and `n` edges; cut `k` records all prior birth events. -/
theorem ghost_phase_chronological_tensor_born_history {P : Type*} [Fintype P]
    {R : P → Type*} [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    (a : ℕ → P → Bool) (h : ℕ → (p : P) → R p) (η : ℕ → P → ℝ)
    (β : P → ℝ) (n : ℕ)
    (x : Fin ((2 * n + 1) + 1) → (p : P) → GhostPhaseState (R p))
    (hx : (∏ p, ghostPhaseChronologicalWeight (fun j => a j p) (fun j => h j p)
      (fun j => η j p) (β p) n (fun j => x j p)) ≠ 0) :
    Monotone (fun j => ghostPhaseBornSupport (x j)) ∧
      ∀ k, ghostPhaseBornSupport (x k) =
        univ.filter (fun p => a 0 p = true) ∪ ghostPhaseBirthLabelsBefore x k := by
  classical
  let atgt := fun j p => if j % 2 = 0 then a (j / 2) p else a (j / 2 + 1) p
  let htgt := fun j p => if j % 2 = 0 then h (j / 2) p else h (j / 2 + 1) p
  have hn : ghostPhaseFiniteTensorTraceWeight (fun j => decide (j % 2 = 0))
      atgt (fun j => a (j / 2)) htgt (fun j => h (j / 2)) (fun j => η (j / 2))
      (fun _ => β) (a 0) β (a n) x ≠ 0 := hx
  exact ⟨ghost_phase_finite_tensor_trace_born_monotone _ _ _ _ _ _ _ _ _ _ _ hn,
    ghost_phase_finite_tensor_trace_born_history _ _ _ _ _ _ _ _ _ _ _ hn⟩
end

section
open Finset
/-- The only possible newly born endpoint of an edge is active. -/
theorem ghost_phase_edge_born_iff {R : Type*} [Fintype R] [DecidableEq R]
    (atgt asrc : Bool) (htgt hsrc : R) (β : ℝ) (z w : GhostPhaseState R)
    (hn : ghostPhaseEdge atgt asrc htgt hsrc β z w ≠ 0) :
    ghostPhaseBorn z ↔ ghostPhaseBorn w ∨ atgt = true := by
  cases atgt <;> cases asrc <;> rcases z with _ | (_ | (_ | r)) <;>
    rcases w with _ | (_ | (_ | s)) <;>
    simp_all [ghostPhaseBorn, ghostPhaseEdge, ghostPhaseGather, ghostPhaseScatter,
      ghostActiveInput, ghostActiveOutput]

/-- A newly born ghost is pending at the end of its birth visit. -/
theorem ghost_phase_visit_born_iff {R : Type*} [DecidableEq R]
    (a : Bool) (h : R) (η β : ℝ) (z w : GhostPhaseState R)
    (hn : ghostPhaseVisit a h η β z w ≠ 0) :
    ghostPhaseBorn z ↔ ghostPhaseBorn w ∨ ∃ r, z = some (some (some r)) := by
  cases a <;> rcases z with _ | (_ | (_ | r)) <;>
    rcases w with _ | (_ | (_ | s)) <;>
    simp_all [ghostPhaseBorn, ghostPhaseVisit, ghostFiniteKernel]

/-- Nonzero normalization cannot introduce an otherwise forbidden birth. -/
theorem ghost_phase_damped_visit_born_iff {R : Type*} [DecidableEq R]
    (a : Bool) (h : R) (η β ρ : ℝ) (z w : GhostPhaseState R)
    (hn : ghostPhaseDampedVisit a h η β ρ z w ≠ 0) :
    ghostPhaseBorn z ↔ ghostPhaseBorn w ∨ ∃ r, z = some (some (some r)) := by
  apply ghost_phase_visit_born_iff a h η β z w
  intro hz
  exact hn (by simp only [ghostPhaseDampedVisit, hz, zero_div])

theorem ghost_phase_damped_edge_born_iff {R : Type*} [Fintype R] [DecidableEq R]
    (atgt asrc : Bool) (htgt hsrc : R) (β ρtgt ρsrc : ℝ) (z w : GhostPhaseState R)
    (hn : ghostPhaseDampedEdge atgt asrc htgt hsrc β ρtgt ρsrc z w ≠ 0) :
    ghostPhaseBorn z ↔ ghostPhaseBorn w ∨ atgt = true := by
  apply ghost_phase_edge_born_iff atgt asrc htgt hsrc β z w
  intro hz
  exact hn (by simp only [ghostPhaseDampedEdge, hz, mul_zero, zero_mul])

/-- Moving residues preserve all cumulative birth tags. -/
theorem ghost_phase_damped_moving_edge_born_iff {R : Type*}
    [AddGroup R] [Fintype R] [DecidableEq R]
    (atgt asrc : Bool) (delta : R) (β ρtgt ρsrc : ℝ) (z w : GhostPhaseState R)
    (hn : ghostPhaseDampedMovingEdge atgt asrc delta β ρtgt ρsrc z w ≠ 0) :
    ghostPhaseBorn z ↔ ghostPhaseBorn w ∨ atgt = true := by
  rw [ghost_phase_damped_moving_edge_eq_shifted] at hn
  simpa only [ghost_phase_born_shift_iff] using
    ghost_phase_damped_edge_born_iff atgt asrc 0 (-delta) β ρtgt ρsrc
      z (ghostPhaseShift delta w) hn

/-- The exact edge update is union with target activity, not just currently
pending labels. This retains all completed labels in the cumulative set. -/
theorem ghost_phase_tensor_edge_born_support {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    (atgt asrc : P → Bool) (htgt hsrc : (p : P) → R p) (β ρtgt ρsrc : P → ℝ)
    (z w : (p : P) → GhostPhaseState (R p))
    (hn : (∏ p, ghostPhaseDampedEdge (atgt p) (asrc p) (htgt p) (hsrc p)
      (β p) (ρtgt p) (ρsrc p) (z p) (w p)) ≠ 0) :
    ghostPhaseBornSupport z = ghostPhaseBornSupport w ∪ ghostPhaseActivitySupport atgt := by
  classical
  ext p
  rw [mem_union, ghost_phase_mem_born_support, ghost_phase_mem_born_support]
  change ghostPhaseBorn (z p) ↔ ghostPhaseBorn (w p) ∨ _
  simpa only [ghostPhaseActivitySupport, mem_filter, mem_univ, true_and] using
    ghost_phase_damped_edge_born_iff (atgt p) (asrc p) (htgt p) (hsrc p)
      (β p) (ρtgt p) (ρsrc p) (z p) (w p) ((prod_ne_zero_iff.mp hn) p (mem_univ p))

/-- The exact visit update is union with output pending support. Old labels
remain recorded even when a pending particle terminates at this visit. -/
theorem ghost_phase_tensor_visit_born_support {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, DecidableEq (R p)]
    (a : P → Bool) (h : (p : P) → R p) (η β ρ : P → ℝ)
    (z w : (p : P) → GhostPhaseState (R p))
    (hn : (∏ p, ghostPhaseDampedVisit (a p) (h p) (η p) (β p) (ρ p) (z p) (w p)) ≠ 0) :
    ghostPhaseBornSupport z = ghostPhaseBornSupport w ∪ ghostPhasePendingSupport z := by
  classical
  ext p
  rw [mem_union, ghost_phase_mem_born_support, ghost_phase_mem_born_support]
  change ghostPhaseBorn (z p) ↔ ghostPhaseBorn (w p) ∨ _
  simpa only [ghostPhasePendingSupport, mem_filter, mem_univ, true_and] using
    ghost_phase_damped_visit_born_iff (a p) (h p) (η p) (β p) (ρ p) (z p) (w p)
      ((prod_ne_zero_iff.mp hn) p (mem_univ p))

/-- The moving edge has the same cumulative-label update as the fixed frame. -/
theorem ghost_phase_tensor_moving_edge_born_support {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    (atgt asrc : P → Bool) (delta : (p : P) → R p) (β ρtgt ρsrc : P → ℝ)
    (z w : (p : P) → GhostPhaseState (R p))
    (hn : (∏ p, ghostPhaseDampedMovingEdge (atgt p) (asrc p) (delta p)
      (β p) (ρtgt p) (ρsrc p) (z p) (w p)) ≠ 0) :
    ghostPhaseBornSupport z = ghostPhaseBornSupport w ∪ ghostPhaseActivitySupport atgt := by
  classical
  ext p
  rw [mem_union, ghost_phase_mem_born_support, ghost_phase_mem_born_support]
  change ghostPhaseBorn (z p) ↔ ghostPhaseBorn (w p) ∨ _
  simpa only [ghostPhaseActivitySupport, mem_filter, mem_univ, true_and] using
    ghost_phase_damped_moving_edge_born_iff (atgt p) (asrc p) (delta p)
      (β p) (ρtgt p) (ρsrc p) (z p) (w p) ((prod_ne_zero_iff.mp hn) p (mem_univ p))
end

section
open Finset
open scoped Classical
/-- The actual target reconstruction and the global all-previous-births ban.
H is cumulative, rather than just the labels currently held in memory. -/
def GlobalBirthEdgeEventValid {S J P : Type*} [DecidableEq S] [DecidableEq P]
    (H : Finset P) (f : J ↪ P) (target : S ↪ P)
    {eligible : Finset J} (event : FixedTargetEdgeEvent S J P eligible) : Prop :=
  unrestrictedTargetLabels event.1 (fun s => f (event.2.1 s).val) event.2.2 = target ∧
    ∀ s, event.2.2 s ∉ H

theorem global_birth_event_implies_fixed_target {S J P : Type*} [Fintype J]
    [DecidableEq S] [DecidableEq P] (H : Finset P) (f : J ↪ P) (target : S ↪ P)
    (hH : univ.image f ⊆ H) {eligible : Finset J}
    (event : FixedTargetEdgeEvent S J P eligible)
    (h : GlobalBirthEdgeEventValid H f target event) :
    FixedTargetEdgeEventValid f target event :=
  ⟨h.1, fun s hs => h.2 s (hH hs)⟩

/-- Every fresh value of a compatible fixed-target event is genuinely unborn,
including labels whose previous lifespans have already completed. -/
theorem fixed_target_fresh_outside_born {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)] {N t : ℕ}
    (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
    (target : Fin t ↪ P) (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    (hc : ∀ p, ghostPhaseMovingEdgeCompatible (atgt p) (asrc p) (delta p) (w p) = true)
    {eligible : Finset (Fin N)} (event : FixedTargetEdgeEvent (Fin t) (Fin N) P eligible)
    (h : FixedTargetEdgeEventValid f.val target event) :
    ∀ s, event.2.2 s ∉ ghostPhaseBornSupport w := by
  intro s
  have hp : event.2.2 s ∈ ghostPhaseFreshSet atgt asrc w := by
    rw [← ghost_phase_new_run_without_pending atgt asrc delta w hw hc,
      ← htarget, ← distinct_ordered_support_image f]
    refine mem_sdiff.mpr ⟨?_, h.2 s⟩
    refine mem_image.mpr ⟨s.val, mem_univ _, ?_⟩
    exact (congrFun (fixed_target_edge_event_fresh f.val target event h) s).symm
  have hu : w (event.2.2 s) = some none := by
    simp only [ghostPhaseFreshSet, mem_filter, mem_univ, true_and,
      ghostPhaseEdgeFresh, Bool.and_eq_true, decide_eq_true_eq] at hp
    exact hp.2
  rw [ghost_phase_mem_born_support, hu]
  exact not_not_intro rfl

/-- The global birth ban may replace the local fresh-avoidance filter on every
compatible phase snapshot. The equality concerns all actual events. -/
theorem global_birth_event_valid_iff_fixed_target {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)] {N t : ℕ}
    (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
    (target : Fin t ↪ P) (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    (hc : ∀ p, ghostPhaseMovingEdgeCompatible (atgt p) (asrc p) (delta p) (w p) = true)
    {eligible : Finset (Fin N)} (event : FixedTargetEdgeEvent (Fin t) (Fin N) P eligible) :
    GlobalBirthEdgeEventValid (ghostPhaseBornSupport w) f.val target event ↔
      FixedTargetEdgeEventValid f.val target event := by
  constructor
  · apply global_birth_event_implies_fixed_target
    rw [distinct_ordered_support_image f]
    exact ghost_phase_pending_subset_born w
  · intro h
    exact ⟨h.1, fixed_target_fresh_outside_born atgt asrc delta w hw f target htarget hc event h⟩

/-- The literal subset/injection/fresh-draw sum still has one term when the
full cumulative-birth exclusion replaces the old-memory-only condition. -/
theorem sum_global_birth_edge_events {P M : Type*} [Fintype P] [DecidableEq P]
    [AddCommMonoid M] {R : P → Type*}
    [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)] {N t : ℕ}
    (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
    (target : Fin t ↪ P) (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    (hc : ∀ p, ghostPhaseMovingEdgeCompatible (atgt p) (asrc p) (delta p) (w p) = true)
    (eligible : Finset (Fin N)) (e : distinctPromotedTargetSlots f.val target ↪ eligible)
    (he : ∀ s, f.val (e s).val = target s.val)
    (F : FixedTargetEdgeEvent (Fin t) (Fin N) P eligible → M) :
    (∑ U : Finset (Fin t), ∑ g : U ↪ eligible, ∑ fresh : UnrestrictedFreshLabels P U,
      if GlobalBirthEdgeEventValid (ghostPhaseBornSupport w) f.val target ⟨U, g, fresh⟩
        then F ⟨U, g, fresh⟩ else 0) = F (fixedTargetCanonicalEvent f.val target e) := by
  simp_rw [global_birth_event_valid_iff_fixed_target atgt asrc delta w hw f target htarget hc]
  exact sum_fixed_target_edge_subsets_injections_fresh f.val target eligible e he F
end

section
open Finset
/-- An allowed selected local outcome has the target activity tag, independent
of hit compatibility or its numerical coefficient. -/
theorem ghost_phase_selected_moving_isSome {R : Type*} [AddGroup R]
    (atgt asrc store : Bool) (delta : R) (w : GhostPhaseState R)
    (hw : w.isSome = !asrc)
    (hs : store = true → atgt = false ∧ asrc = true) :
    (ghostPhaseMovingChoiceTarget atgt asrc delta store w).isSome = !atgt := by
  cases atgt <;> cases asrc <;> cases store <;>
    rcases w with _ | (_ | (_ | r)) <;>
    simp_all [ghostPhaseMovingChoiceTarget, ghostPhaseEdgeBaseTarget,
      ghostPhaseEdgeStoreTarget, ghostPhaseShift_unborn,
      ghostPhaseShift_completed, ghostPhaseShift_pending]

/-- Selecting an allowed edge output preserves previous birth and adds target
activity, even if the selected coefficient is zero. -/
theorem ghost_phase_selected_moving_born_iff {R : Type*} [AddGroup R]
    (atgt asrc store : Bool) (delta : R) (w : GhostPhaseState R)
    (hw : w.isSome = !asrc)
    (hs : store = true → atgt = false ∧ asrc = true) :
    ghostPhaseBorn (ghostPhaseMovingChoiceTarget atgt asrc delta store w) ↔
      ghostPhaseBorn w ∨ atgt = true := by
  cases atgt <;> cases asrc <;> cases store <;>
    rcases w with _ | (_ | (_ | r)) <;>
    simp_all [ghostPhaseBorn, ghostPhaseMovingChoiceTarget, ghostPhaseEdgeBaseTarget,
      ghostPhaseEdgeStoreTarget, ghostPhaseShift_unborn,
      ghostPhaseShift_completed, ghostPhaseShift_pending]

theorem ghost_phase_selected_moving_mask {P : Type*} {R : P → Type*}
    [∀ p, AddGroup (R p)] (atgt asrc store : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (hs : ∀ p, store p = true → atgt p = false ∧ asrc p = true) :
    ghostPhaseMask atgt
      (fun p => ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p) (store p) (w p)) :=
  fun p => ghost_phase_selected_moving_isSome (atgt p) (asrc p) (store p)
    (delta p) (w p) (hw p) (hs p)

theorem ghost_phase_selected_moving_active_support {P : Type*} [Fintype P]
    {R : P → Type*} [∀ p, AddGroup (R p)]
    (atgt asrc store : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (hs : ∀ p, store p = true → atgt p = false ∧ asrc p = true) :
    ghostPhaseStateActiveSupport
      (fun p => ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p) (store p) (w p)) =
      ghostPhaseActivitySupport atgt :=
  ghost_phase_state_active_support_of_mask atgt _
    (ghost_phase_selected_moving_mask atgt asrc store delta w hw hs)

theorem ghost_phase_selected_moving_born_support {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)]
    (atgt asrc store : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (hs : ∀ p, store p = true → atgt p = false ∧ asrc p = true) :
    ghostPhaseBornSupport
      (fun p => ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p) (store p) (w p)) =
      ghostPhaseBornSupport w ∪ ghostPhaseActivitySupport atgt := by
  classical
  ext p
  rw [mem_union, ghost_phase_mem_born_support, ghost_phase_mem_born_support]
  change ghostPhaseBorn _ ↔ ghostPhaseBorn (w p) ∨ _
  simpa only [ghostPhaseActivitySupport, mem_filter, mem_univ, true_and] using
    ghost_phase_selected_moving_born_iff (atgt p) (asrc p) (store p)
      (delta p) (w p) (hw p) (hs p)

section ActualOutput

variable {P : Type*} [Fintype P] [DecidableEq P]
  {R : P → Type*} [∀ p, AddGroup (R p)] {t N : ℕ}
  (source : Fin t ↪ P) (stores promotions : Finset (Fin t))
  (atgt asrc : P → Bool) (delta : (p : P) → R p)
  (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
  (hsource : ∀ j, asrc (source j) = true)
  (hstores : ∀ j ∈ stores, atgt (source j) = false)
  (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
  (old : (j : Fin N) → R (f.val j))
  {eligible : Finset (Fin N)} (e : promotions ↪ ↥eligible)
  (he : ∀ j, j ∈ promotionSelectedIndices e ↔ atgt (f.val j) = true)

include hw hsource hstores he

/-- The literal retained-and-stored output reconstructs the selected phase
using only target activity and the updated cumulative born-label set. -/
theorem global_birth_selected_edge_readout
    (hold : ∀ j, w (f.val j) = some (some (some (old j)))) :
    globalBirthMemoryReadout (ghostPhaseActivitySupport atgt)
      (ghostPhaseBornSupport w ∪ ghostPhaseActivitySupport atgt)
      (unrestrictedEdgeOutput source (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
        (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) stores promotions e) =
      fun p => ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p)
        (distinctUnrestrictedStorageChoice source stores p) (w p) := by
  have hs := distinct_unrestricted_storage_allowed source stores atgt asrc hsource hstores
  rw [← ghost_phase_selected_moving_born_support atgt asrc
    (distinctUnrestrictedStorageChoice source stores) delta w hw hs]
  apply global_birth_memory_readout_eq_of_mask
  · exact ghost_phase_selected_moving_mask atgt asrc
      (distinctUnrestrictedStorageChoice source stores) delta w hw hs
  · exact distinct_unrestricted_output_support source stores promotions atgt asrc delta
      w hw hsource hstores f old e he
  · exact distinct_unrestricted_output_particle source stores promotions atgt asrc delta
      w hw hsource hstores f old e he hold

/-- An arbitrary coupled complex phase continuation is read exactly on the
literal distinct output. No nonzero-weight or hit-compatibility assumption is
needed for this deterministic output correspondence. -/
theorem global_birth_selected_edge_symmetric_readout
    (hold : ∀ j, w (f.val j) = some (some (some (old j))))
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) :
    symmetricPhaseReadout
      (globalBirthMemoryBase (ghostPhaseActivitySupport atgt)
        (ghostPhaseBornSupport w ∪ ghostPhaseActivitySupport atgt)) F
      (unrestrictedEdgeOutput source (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
        (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) stores promotions e) =
      F (fun p => ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p)
        (distinctUnrestrictedStorageChoice source stores p) (w p)) := by
  apply symmetric_phase_readout_eq_of_reconstruction
  · exact distinct_unrestricted_output_label_injective source stores promotions atgt asrc
      delta w hw hsource hstores f old e
  · exact distinct_unrestricted_output_support source stores promotions atgt asrc delta
      w hw hsource hstores f old e he
  · exact global_birth_selected_edge_readout source stores promotions atgt asrc delta
      w hw hsource hstores f old e he hold

end ActualOutput
end

section
open Finset
/-- Compatibility of global birth metadata with a literal pending tuple. -/
structure GlobalBirthMemoryCoherent {P : Type*} [DecidableEq P]
    {R : P → Type*} (active born : Finset P)
    (q : FiniteOrderedTuple (Σ p, R p)) : Prop where
  label_injective : Function.Injective (Sigma.fst ∘ q.2)
  labels_born : univ.image (fun j => (q.2 j).1) ⊆ born
  labels_inactive : Disjoint (univ.image (fun j => (q.2 j).1)) active
  active_born : active ⊆ born

/-- The pending tuple cannot alter a coordinate outside its label image. -/
theorem global_birth_memory_readout_off_labels {P : Type*} [DecidableEq P]
    {R : P → Type*} (active born : Finset P)
    (q : FiniteOrderedTuple (Σ p, R p)) (p : P)
    (hp : p ∉ univ.image (fun j => (q.2 j).1)) :
    globalBirthMemoryReadout active born q p = globalBirthMemoryBase active born p := by
  classical
  have hn : ¬ ∃ j, (q.2 j).1 = p := by
    simpa only [mem_image, mem_univ, true_and] using hp
  simp only [globalBirthMemoryReadout, ghostPhaseMemoryReadout, dif_neg hn]

/-- The activity tag of the global base is exactly its supplied activity set. -/
theorem global_birth_memory_base_active_iff {P : Type*} {R : P → Type*}
    (active born : Finset P) (p : P) :
    @globalBirthMemoryBase P R active born p = none ↔ p ∈ active := by
  classical
  by_cases ha : p ∈ active <;> by_cases hb : p ∈ born <;>
    simp [globalBirthMemoryBase, ha, hb]

/-- The global base contains no pending particles. -/
theorem global_birth_memory_base_not_pending {P : Type*} {R : P → Type*}
    (active born : Finset P) (p : P) :
    ¬ ∃ r, @globalBirthMemoryBase P R active born p = some (some (some r)) := by
  classical
  by_cases ha : p ∈ active <;> by_cases hb : p ∈ born <;>
    simp [globalBirthMemoryBase, ha, hb]

/-- The born tag of the base is the union of its activity and birth metadata. -/
theorem global_birth_memory_base_born_iff {P : Type*} {R : P → Type*}
    (active born : Finset P) (p : P) :
    ghostPhaseBorn (@globalBirthMemoryBase P R active born p) ↔ p ∈ active ∨ p ∈ born := by
  classical
  by_cases ha : p ∈ active <;> by_cases hb : p ∈ born <;>
    simp [ghostPhaseBorn, globalBirthMemoryBase, ha, hb]

/-- On a coherent state, every listed particle is read at its own label with
exactly its own residue. -/
theorem global_birth_coherent_readout_particle {P : Type*} [DecidableEq P]
    {R : P → Type*} (active born : Finset P)
    (q : FiniteOrderedTuple (Σ p, R p)) (hq : GlobalBirthMemoryCoherent active born q)
    (j : Fin q.1) :
    globalBirthMemoryReadout active born q (q.2 j).1 = some (some (some (q.2 j).2)) :=
  ghost_phase_memory_readout_at _ q hq.label_injective j

/-- Coherent pending memory leaves exactly the specified labels active. -/
theorem global_birth_coherent_readout_active_support {P : Type*}
    [Fintype P] [DecidableEq P] {R : P → Type*}
    (active born : Finset P) (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent active born q) :
    ghostPhaseStateActiveSupport (globalBirthMemoryReadout active born q) = active := by
  classical
  ext p
  rw [ghost_phase_mem_state_active_support]
  by_cases hp : p ∈ univ.image (fun j => (q.2 j).1)
  · have hna : p ∉ active := fun ha => Finset.disjoint_left.mp hq.labels_inactive hp ha
    obtain ⟨j, _, rfl⟩ := mem_image.mp hp
    rw [global_birth_coherent_readout_particle active born q hq j]
    simp only [Option.some_ne_none, false_iff]
    exact hna
  · rw [global_birth_memory_readout_off_labels active born q p hp]
    exact global_birth_memory_base_active_iff active born p

/-- Coherent pending memory neither adds nor erases cumulative born labels. -/
theorem global_birth_coherent_readout_born_support {P : Type*}
    [Fintype P] [DecidableEq P] {R : P → Type*}
    (active born : Finset P) (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent active born q) :
    ghostPhaseBornSupport (globalBirthMemoryReadout active born q) = born := by
  classical
  ext p
  rw [ghost_phase_mem_born_support]
  by_cases hp : p ∈ univ.image (fun j => (q.2 j).1)
  · have hb := hq.labels_born hp
    obtain ⟨j, _, rfl⟩ := mem_image.mp hp
    rw [global_birth_coherent_readout_particle active born q hq j]
    simp [hb]
  · rw [global_birth_memory_readout_off_labels active born q p hp]
    change ghostPhaseBorn _ ↔ p ∈ born
    rw [global_birth_memory_base_born_iff]
    exact or_iff_right_of_imp (fun ha => hq.active_born ha)

/-- On the coherent state space the pending support is precisely the literal
tuple's label image; the base contributes no extra pending coordinates. -/
theorem global_birth_coherent_readout_pending_support {P : Type*}
    [Fintype P] [DecidableEq P] {R : P → Type*}
    (active born : Finset P) (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent active born q) :
    ghostPhasePendingSupport (globalBirthMemoryReadout active born q) =
      univ.image (fun j => (q.2 j).1) := by
  classical
  ext p
  change (p ∈ univ.filter (fun p => ∃ r,
    globalBirthMemoryReadout active born q p = some (some (some r)))) ↔ _
  simp only [mem_filter, mem_univ, true_and]
  by_cases hp : p ∈ univ.image (fun j => (q.2 j).1)
  · have hex : ∃ r, globalBirthMemoryReadout active born q p = some (some (some r)) := by
      obtain ⟨j, _, rfl⟩ := mem_image.mp hp
      exact ⟨(q.2 j).2, global_birth_coherent_readout_particle active born q hq j⟩
    exact iff_of_true hex hp
  · rw [global_birth_memory_readout_off_labels active born q p hp]
    exact iff_of_false (global_birth_memory_base_not_pending active born p) hp

/-- True snapshot metadata always gives a coherent global memory state when
the pending tuple has distinct labels and complete support. No residue
agreement is needed merely to establish this metadata compatibility. -/
theorem global_birth_memory_coherent_of_snapshot {P : Type*}
    [Fintype P] [DecidableEq P] {R : P → Type*}
    (z : (p : P) → GhostPhaseState (R p)) (q : FiniteOrderedTuple (Σ p, R p))
    (hinj : Function.Injective (Sigma.fst ∘ q.2))
    (hsupport : univ.image (fun j => (q.2 j).1) = ghostPhasePendingSupport z) :
    GlobalBirthMemoryCoherent (ghostPhaseStateActiveSupport z) (ghostPhaseBornSupport z) q := by
  refine ⟨hinj, ?_, ?_, ghost_phase_state_active_subset_born z⟩
  · rw [hsupport]
    exact ghost_phase_pending_subset_born z
  · rw [hsupport]
    apply Finset.disjoint_left.mpr
    intro p hp ha
    rw [ghost_phase_mem_state_active_support] at ha
    have hex : ∃ r, z p = some (some (some r)) := by
      simpa only [ghostPhasePendingSupport, mem_filter, mem_univ, true_and] using hp
    obtain ⟨r, hr⟩ := hex
    rw [ha] at hr
    cases hr

/-- Coherence depends on the particles, not on their enumeration order. -/
theorem global_birth_memory_coherent_reindex {P : Type*} [DecidableEq P]
    {R : P → Type*} (active born : Finset P)
    (q : FiniteOrderedTuple (Σ p, R p)) {n : ℕ} (e : Fin n ≃ Fin q.1) :
    GlobalBirthMemoryCoherent active born ⟨n, q.2 ∘ e⟩ ↔
      GlobalBirthMemoryCoherent active born q := by
  constructor
  · intro h
    refine ⟨?_, ?_, ?_, h.active_born⟩
    · intro i j hij
      apply e.symm.injective
      apply h.label_injective
      simpa only [Function.comp_apply, e.apply_symm_apply] using hij
    · simpa only [ghost_phase_memory_label_image_reindex q e] using h.labels_born
    · simpa only [ghost_phase_memory_label_image_reindex q e] using h.labels_inactive
  · intro h
    refine ⟨h.label_injective.comp e.injective, ?_, ?_, h.active_born⟩
    · simpa only [ghost_phase_memory_label_image_reindex q e] using h.labels_born
    · simpa only [ghost_phase_memory_label_image_reindex q e] using h.labels_inactive

/-- Every coherent tuple belongs to the support of the symmetric readout. -/
theorem global_birth_coherent_readout_supported {P : Type*}
    [Fintype P] [DecidableEq P] {R : P → Type*}
    (active born : Finset P) (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent active born q) :
    GhostPhaseReadoutSupported (globalBirthMemoryBase active born) q :=
  ⟨hq.label_injective, (global_birth_coherent_readout_pending_support active born q hq).symm⟩

/-- The symmetric zero extension reads the global snapshot on every coherent
state, with no additional support condition. -/
theorem global_birth_coherent_symmetric_readout {P : Type*}
    [Fintype P] [DecidableEq P] {R : P → Type*}
    (active born : Finset P) (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent active born q)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) :
    symmetricPhaseReadout (globalBirthMemoryBase active born) F q =
      F (globalBirthMemoryReadout active born q) := by
  classical
  rw [symmetricPhaseReadout, if_pos (global_birth_coherent_readout_supported active born q hq)]
  rfl
end

section
open Finset
open scoped Classical
/-- Fresh values are exactly the reconstructed target values outside the
whole previous birth set. Promoted values were already present in that set. -/
theorem global_birth_event_fresh_image {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq S] [DecidableEq P]
    (H : Finset P) (f : J ↪ P) (target : S ↪ P) (hH : univ.image f ⊆ H)
    {eligible : Finset J} (event : FixedTargetEdgeEvent S J P eligible)
    (h : GlobalBirthEdgeEventValid H f target event) :
    univ.image event.2.2 = univ.image target \ H := by
  have hl := global_birth_event_implies_fixed_target H f target hH event h
  have hf := fixed_target_edge_event_fresh f target event hl
  ext p
  constructor
  · intro hp
    obtain ⟨s, _, rfl⟩ := mem_image.mp hp
    refine mem_sdiff.mpr ⟨?_, h.2 s⟩
    exact mem_image.mpr ⟨s.val, mem_univ _, (congrFun hf s).symm⟩
  · intro hp
    obtain ⟨s, _, hs⟩ := mem_image.mp (mem_sdiff.mp hp).1
    have hsnot : s ∉ event.1 := by
      intro hsU
      have hmatch := fixed_target_edge_event_matches f target event hl ⟨s, hsU⟩
      have hmem : target s ∈ H := hH (mem_image.mpr
        ⟨(event.2.1 ⟨s, hsU⟩).val, mem_univ _, hmatch⟩)
      exact (mem_sdiff.mp hp).2 (hs ▸ hmem)
    exact mem_image.mpr ⟨⟨s, hsnot⟩, mem_univ _, (congrFun hf ⟨s, hsnot⟩).trans hs⟩

/-- Updating H by all fresh births equals adjoining the full target image;
old promoted labels add nothing. This does not remove completed labels. -/
theorem global_birth_event_update {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq S] [DecidableEq P]
    (H : Finset P) (f : J ↪ P) (target : S ↪ P) (hH : univ.image f ⊆ H)
    {eligible : Finset J} (event : FixedTargetEdgeEvent S J P eligible)
    (h : GlobalBirthEdgeEventValid H f target event) :
    H ∪ univ.image event.2.2 = H ∪ univ.image target := by
  rw [global_birth_event_fresh_image H f target hH event h]
  ext p
  simp only [mem_union, mem_sdiff]
  tauto

/-- Current active and pending labels are already included in a coherent
phase snapshot's cumulative born support. -/
theorem ghost_phase_activity_subset_born_of_mask {P : Type*} [Fintype P]
    {R : P → Type*} (a : P → Bool) (w : (p : P) → GhostPhaseState (R p))
    (hw : ghostPhaseMask a w) : ghostPhaseActivitySupport a ⊆ ghostPhaseBornSupport w := by
  classical
  intro p hp
  have ha : a p = true := by simpa [ghostPhaseActivitySupport] using hp
  rw [ghost_phase_mem_born_support]
  have hm := hw p
  cases he : w p <;> simp_all

/-- For target unshared slots, adjoining their image is the same as adjoining
all target-active labels, because shared source activity was already born. -/
theorem global_birth_new_run_update {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (atgt asrc : P → Bool)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w) :
    ghostPhaseBornSupport w ∪ ghostPhaseNewRunSet atgt asrc =
      ghostPhaseBornSupport w ∪ ghostPhaseActivitySupport atgt := by
  have ha := ghost_phase_activity_subset_born_of_mask asrc w hw
  ext p
  by_cases hs : asrc p = true
  · have hb : p ∈ ghostPhaseBornSupport w := ha (by simp [ghostPhaseActivitySupport, hs])
    simp [hb]
  · have hs' : asrc p = false := Bool.eq_false_iff.mpr hs
    simp [ghostPhaseNewRunSet, ghostPhaseActivitySupport, hs']

/-- The actual event birth update equals the phase edge's cumulative update. -/
theorem global_birth_phase_event_update {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} {N t : ℕ} (atgt asrc : P → Bool)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
    (target : Fin t ↪ P) (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    {eligible : Finset (Fin N)} (event : FixedTargetEdgeEvent (Fin t) (Fin N) P eligible)
    (h : GlobalBirthEdgeEventValid (ghostPhaseBornSupport w) f.val target event) :
    ghostPhaseBornSupport w ∪ univ.image event.2.2 =
      ghostPhaseBornSupport w ∪ ghostPhaseActivitySupport atgt := by
  have hH : univ.image f.val ⊆ ghostPhaseBornSupport w := by
    rw [distinct_ordered_support_image f]
    exact ghost_phase_pending_subset_born w
  rw [global_birth_event_update _ f.val target hH event h, htarget,
    global_birth_new_run_update atgt asrc w hw]
end

section
open Finset
/-- Any old pending label needed at a compatible target is eligible when
eligibility is exactly the transported-zero test on old indices. -/
theorem global_birth_required_indices_eligible {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)] {N t : ℕ}
    (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p))
    (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
    (old : (j : Fin N) → R (f.val j))
    (hold : ∀ j, w (f.val j) = some (some (some (old j))))
    (target : Fin t ↪ P) (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    (eligible : Finset (Fin N))
    (heligible : ∀ j, j ∈ eligible ↔ old j = delta (f.val j))
    (hc : ∀ p, ghostPhaseMovingEdgeCompatible (atgt p) (asrc p) (delta p) (w p) = true) :
    univ.filter (fun j => f.val j ∈ univ.image target) ⊆ eligible := by
  intro j hj
  rw [mem_filter, and_iff_right (mem_univ j), htarget] at hj
  have ha : atgt (f.val j) = true ∧ asrc (f.val j) = false := by
    simpa [ghostPhaseNewRunSet] using hj
  have h := hc (f.val j)
  rw [ha.1, ha.2, hold] at h
  apply (heligible j).mpr
  simpa only [ghostPhaseMovingEdgeCompatible, decide_eq_true_eq] using h

/-- Compatible target data construct a matching eligible promotion without
assuming its existence as an independent row hypothesis. -/
theorem global_birth_matching_promotion_exists {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)] {N t : ℕ}
    (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p))
    (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
    (old : (j : Fin N) → R (f.val j))
    (hold : ∀ j, w (f.val j) = some (some (some (old j))))
    (target : Fin t ↪ P) (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    (eligible : Finset (Fin N))
    (heligible : ∀ j, j ∈ eligible ↔ old j = delta (f.val j))
    (hc : ∀ p, ghostPhaseMovingEdgeCompatible (atgt p) (asrc p) (delta p) (w p) = true) :
    ∃ e : distinctPromotedTargetSlots f.val target ↪ eligible,
      ∀ s, f.val (e s).val = target s.val := by
  have hreq := global_birth_required_indices_eligible atgt asrc delta w f old hold
    target htarget eligible heligible hc
  exact ⟨canonicalEligiblePromotion f.val target eligible hreq,
    canonical_eligible_promotion_matches f.val target eligible hreq⟩
end

section
open Finset
/-- Any nonzero actual damped moving edge satisfies its compatibility bit. -/
theorem ghost_phase_damped_moving_edge_compatible {R : Type*}
    [AddGroup R] [Fintype R] [DecidableEq R]
    (atgt asrc : Bool) (delta : R) (β ρtgt ρsrc : ℝ)
    (z w : GhostPhaseState R) (hw : w.isSome = !asrc)
    (hn : ghostPhaseDampedMovingEdge atgt asrc delta β ρtgt ρsrc z w ≠ 0) :
    ghostPhaseMovingEdgeCompatible atgt asrc delta w = true := by
  cases atgt <;> cases asrc <;>
    rcases z with _ | (_ | (_ | r)) <;> rcases w with _ | (_ | (_ | s)) <;>
    simp_all [ghostPhaseDampedMovingEdge, ghostPhaseMovingEdge,
      ghostPhaseEdge, ghostPhaseGather, ghostPhaseScatter, ghostActiveInput,
      ghostActiveOutput, ghostPhaseDiagonal, ghostPhaseShift, ghostMemoryShift,
      ghostPhaseMovingEdgeCompatible, sub_eq_zero]
  all_goals split_ifs at hn <;> simp_all

/-- Incompatibility annihilates every output coefficient, irrespective of rho
or beta values. This includes the zero-weight boundary parameter cases. -/
theorem ghost_phase_damped_moving_edge_eq_zero_of_incompatible {R : Type*}
    [AddGroup R] [Fintype R] [DecidableEq R]
    (atgt asrc : Bool) (delta : R) (β ρtgt ρsrc : ℝ)
    (z w : GhostPhaseState R) (hw : w.isSome = !asrc)
    (hc : ghostPhaseMovingEdgeCompatible atgt asrc delta w ≠ true) :
    ghostPhaseDampedMovingEdge atgt asrc delta β ρtgt ρsrc z w = 0 := by
  by_contra hn
  exact hc (ghost_phase_damped_moving_edge_compatible atgt asrc delta β ρtgt ρsrc z w hw hn)

/-- A globally valid event can only use an unborn coordinate or promote a
matching eligible pending particle. Thus, after shared-active physical hits
are supplied, every coordinate of the source satisfies edge compatibility. -/
theorem global_birth_event_implies_compatible {P : Type*}
    [Fintype P] [DecidableEq P] {R : P → Type*}
    [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)] {N t : ℕ}
    (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (hshared : ∀ p, atgt p = true ∧ asrc p = true → delta p = 0)
    (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
    (old : (j : Fin N) → R (f.val j))
    (hold : ∀ j, w (f.val j) = some (some (some (old j))))
    (target : Fin t ↪ P) (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    (eligible : Finset (Fin N))
    (heligible : ∀ j ∈ eligible, old j = delta (f.val j))
    (event : FixedTargetEdgeEvent (Fin t) (Fin N) P eligible)
    (hvalid : GlobalBirthEdgeEventValid (ghostPhaseBornSupport w) f.val target event) :
    ∀ p, ghostPhaseMovingEdgeCompatible (atgt p) (asrc p) (delta p) (w p) = true := by
  have hH : univ.image f.val ⊆ ghostPhaseBornSupport w := by
    rw [distinct_ordered_support_image f]
    exact ghost_phase_pending_subset_born w
  have hv := global_birth_event_implies_fixed_target (ghostPhaseBornSupport w)
    f.val target hH event hvalid
  intro p
  rw [ghost_phase_moving_edge_compatible_iff _ _ _ _ (hw p)]
  refine ⟨hshared p, ?_⟩
  intro hp
  have hpt : p ∈ univ.image target := by
    rw [htarget]
    simp [ghostPhaseNewRunSet, hp.1, hp.2]
  obtain ⟨s, _, hs⟩ := mem_image.mp hpt
  by_cases hsp : s ∈ event.1
  · let j := (event.2.1 ⟨s, hsp⟩).val
    have hj : f.val j = p :=
      (fixed_target_edge_event_matches f.val target event hv ⟨s, hsp⟩).trans hs
    have hh : w (f.val j) = some (some (some (delta (f.val j)))) := by
      rw [hold j, heligible j (event.2.1 ⟨s, hsp⟩).property]
    cases hj
    exact Or.inr hh
  · have hf := fixed_target_edge_event_fresh f.val target event hv
    have he : event.2.2 ⟨s, hsp⟩ = p := (congrFun hf ⟨s, hsp⟩).trans hs
    have hn := hvalid.2 ⟨s, hsp⟩
    rw [he, ghost_phase_mem_born_support] at hn
    exact Or.inl (not_not.mp hn)
end

section
open Finset
open scoped Classical
/-- On a valid phase snapshot the unborn pool is exactly the complement of
all previously born labels, including completed labels. -/
theorem ghost_visit_births_eq_unborn {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (a : P → Bool) (y : (p : P) → GhostPhaseState (R p))
    (hy : ghostPhaseMask a y) :
    ghostVisitBirths a y = univ \ ghostPhaseBornSupport y := by
  ext p
  simp only [ghostVisitBirths, mem_filter, mem_univ, true_and, mem_sdiff,
    ghost_phase_mem_born_support, not_not]
  constructor
  · exact And.right
  · intro hp
    refine ⟨?_, hp⟩
    have hm := hy p
    rw [hp] at hm
    cases ha : a p <;> simp_all

/-- Retain precisely the old slots whose labels were not terminated. -/
noncomputable def ghostVisitSurvivingIndices {P : Type*} [DecidableEq P]
    {R : P → Type*} {N : ℕ} (old : Fin N → Σ p, R p) (D : Finset P) :
    Finset (Fin N) := univ.filter (fun j => (old j).1 ∉ D)

/-- The literal visit output is a retained old tuple followed by new particles
at the current hit, with its actual length stored in the sigma type. -/
noncomputable def globalBirthVisitOutput {P : Type*} [DecidableEq P]
    {R : P → Type*} {N b : ℕ} (h : (p : P) → R p)
    (old : Fin N → Σ p, R p) (D : Finset P) (birth : Fin b → P) :
    FiniteOrderedTuple (Σ p, R p) :=
  retainedBirthTuple old (ghostVisitSurvivingIndices old D) (fun j => ⟨birth j, h (birth j)⟩)

/-- Labels of the old memory entries at the current hit. -/
noncomputable def globalBirthVisitZeros {P : Type*} [DecidableEq P]
    {R : P → Type*} [∀ p, DecidableEq (R p)] {N : ℕ}
    (h : (p : P) → R p) (old : Fin N → Σ p, R p) : Finset P :=
  (univ.filter (fun j => (old j).2 = h (old j).1)).image (fun j => (old j).1)

/-- Label image of a literal retained-and-appended tuple. -/
theorem retained_birth_tuple_label_image {P Z : Type*} [DecidableEq P]
    {N b : ℕ} (label : Z → P) (old : Fin N → Z) (s : Finset (Fin N))
    (birth : Fin b → Z) :
    univ.image (fun j => label ((retainedBirthTuple old s birth).2 j)) =
      s.image (label ∘ old) ∪ univ.image (label ∘ birth) := by
  ext p
  simp only [mem_image, mem_univ, true_and, mem_union, Function.comp_apply]
  constructor
  · rintro ⟨j, hj⟩
    change Fin (s.card + b) at j
    rw [retained_birth_tuple_apply_index_equiv old s birth j] at hj
    cases e : retainedBirthIndexEquiv s b j with
    | inl k => exact Or.inl ⟨k.val, k.property, by simpa only [e, Sum.elim_inl] using hj⟩
    | inr k => exact Or.inr ⟨k, by simpa only [e, Sum.elim_inr] using hj⟩
  · rintro (⟨j, hj, hp⟩ | ⟨j, hp⟩)
    · refine ⟨(retainedBirthIndexEquiv s b).symm (Sum.inl ⟨j, hj⟩), ?_⟩
      simpa only [retained_birth_tuple_apply_index_equiv_symm, Sum.elim_inl] using hp
    · refine ⟨(retainedBirthIndexEquiv s b).symm (Sum.inr j), ?_⟩
      simpa only [retained_birth_tuple_apply_index_equiv_symm, Sum.elim_inr] using hp

section Batch

variable {P : Type*} [Fintype P] [DecidableEq P] {R : P → Type*}
  [∀ p, DecidableEq (R p)] (a : P → Bool) (h : (p : P) → R p)
  (y : (p : P) → GhostPhaseState (R p)) (hy : ghostPhaseMask a y)
  (D B : Finset P) (hD : D ⊆ ghostVisitDeaths a h y) (hB : B ⊆ ghostVisitBirths a y)

include hD hB in
theorem ghost_visit_batch_pending_support :
    ghostPhasePendingSupport (ghostVisitBatchOutput h y D B) =
      (ghostPhasePendingSupport y \ D) ∪ B := by
  have hdis := disjoint_left.mp (ghost_visit_eligible_disjoint a h y)
  ext p
  simp only [ghostPhasePendingSupport, mem_filter, mem_univ, true_and, mem_union, mem_sdiff]
  by_cases hpD : p ∈ D
  · have hpB : p ∉ B := fun hp => hdis (hD hpD) (hB hp)
    simp [ghostVisitBatchOutput, hpD, hpB]
  · by_cases hpB : p ∈ B
    · simp [ghostVisitBatchOutput, hpD, hpB]
    · simp [ghostVisitBatchOutput, hpD, hpB]

include hD in
theorem ghost_visit_batch_born_support :
    ghostPhaseBornSupport (ghostVisitBatchOutput h y D B) =
      ghostPhaseBornSupport y ∪ B := by
  ext p
  rw [ghost_phase_mem_born_support, mem_union, ghost_phase_mem_born_support]
  by_cases hpD : p ∈ D
  · have hp := hD hpD
    simp only [ghostVisitDeaths, mem_filter, mem_univ, true_and] at hp
    simp [ghostVisitBatchOutput, hpD, hp.2]
  · by_cases hpB : p ∈ B <;> simp [ghostVisitBatchOutput, hpD, hpB]

include hy hD hB in
theorem ghost_visit_batch_mask : ghostPhaseMask a (ghostVisitBatchOutput h y D B) := by
  intro p
  by_cases hpD : p ∈ D
  · have hp := hD hpD
    simp only [ghostVisitDeaths, mem_filter, mem_univ, true_and] at hp
    simp [ghostVisitBatchOutput, hpD, hp.1]
  · by_cases hpB : p ∈ B
    · have hp := hB hpB
      simp only [ghostVisitBirths, mem_filter, mem_univ, true_and] at hp
      simp [ghostVisitBatchOutput, hpD, hpB, hp.1]
    · simpa only [ghostVisitBatchOutput, if_neg hpD, if_neg hpB] using hy p

variable {N b : ℕ} (old : Fin N → Σ p, R p)
  (hsupport : univ.image (fun j => (old j).1) = ghostPhasePendingSupport y)
  (hold : ∀ j, y (old j).1 = some (some (some (old j).2)))
  (birth : Fin b → P) (hbirth : univ.image birth = B)

include hD hB hsupport hbirth in
theorem global_birth_visit_output_support :
    univ.image (fun j => ((globalBirthVisitOutput h old D birth).2 j).1) =
      ghostPhasePendingSupport (ghostVisitBatchOutput h y D B) := by
  rw [ghost_visit_batch_pending_support a h y D B hD hB]
  rw [globalBirthVisitOutput, retained_birth_tuple_label_image]
  change (ghostVisitSurvivingIndices old D).image (fun j => (old j).1) ∪
    univ.image birth = _
  rw [hbirth, ← hsupport]
  congr 1
  ext p
  simp only [ghostVisitSurvivingIndices, mem_image, mem_filter, mem_univ, true_and, mem_sdiff]
  constructor
  · rintro ⟨j, hj, rfl⟩
    exact ⟨⟨j, rfl⟩, hj⟩
  · rintro ⟨⟨j, rfl⟩, hj⟩
    exact ⟨j, hj, rfl⟩

include hD hB hold hbirth in
theorem global_birth_visit_output_particle
    (j : Fin (globalBirthVisitOutput h old D birth).1) :
    let q := (globalBirthVisitOutput h old D birth).2 j
    ghostVisitBatchOutput h y D B q.1 = some (some (some q.2)) := by
  dsimp only
  change Fin ((ghostVisitSurvivingIndices old D).card + b) at j
  simp only [globalBirthVisitOutput]
  rw [retained_birth_tuple_apply_index_equiv old (ghostVisitSurvivingIndices old D)
    (fun k => (⟨birth k, h (birth k)⟩ : Σ p, R p)) j]
  generalize he : retainedBirthIndexEquiv (ghostVisitSurvivingIndices old D) b j = k
  cases k with
  | inl k =>
      have hkD : (old k.val).1 ∉ D := by
        simpa only [ghostVisitSurvivingIndices, mem_filter, mem_univ, true_and] using k.property
      have hkB : (old k.val).1 ∉ B := by
        intro hk
        have hb := hB hk
        simp only [ghostVisitBirths, mem_filter, mem_univ, true_and] at hb
        rw [hold k.val] at hb
        simp at hb
      simpa [ghostVisitBatchOutput, hkD, hkB] using hold k.val
  | inr k =>
      have hkB : birth k ∈ B := hbirth ▸ mem_image.mpr ⟨k, mem_univ _, rfl⟩
      have hkD : birth k ∉ D := fun hd =>
        disjoint_left.mp (ghost_visit_eligible_disjoint a h y) (hD hd) (hB hkB)
      simp [ghostVisitBatchOutput, hkD, hkB]

include hy hD hB hsupport hold hbirth in
theorem global_birth_visit_output_readout :
    globalBirthMemoryReadout (ghostPhaseActivitySupport a) (ghostPhaseBornSupport y ∪ B)
      (globalBirthVisitOutput h old D birth) = ghostVisitBatchOutput h y D B := by
  rw [← ghost_visit_batch_born_support a h y D B hD]
  exact global_birth_memory_readout_eq_of_mask a _ (ghost_visit_batch_mask a h y hy D B hD hB)
    _ (global_birth_visit_output_support a h y D B hD hB old hsupport birth hbirth)
    (global_birth_visit_output_particle a h y D B hD hB old hold birth hbirth)

include hB hold hbirth in
omit [∀ p, DecidableEq (R p)] in
theorem global_birth_visit_output_injective
    (hi : Function.Injective (Sigma.fst ∘ old)) (hb : Function.Injective birth) :
    Function.Injective (Sigma.fst ∘ (globalBirthVisitOutput h old D birth).2) := by
  apply retained_birth_tuple_label_injective Sigma.fst old
    (ghostVisitSurvivingIndices old D) (fun j => ⟨birth j, h (birth j)⟩) hi hb
  intro j _ k heq
  have hkB : birth k ∈ B := hbirth ▸ mem_image.mpr ⟨k, mem_univ _, rfl⟩
  have hjB : (old j).1 ∈ B := heq.symm ▸ hkB
  have hj := hB hjB
  simp only [ghostVisitBirths, mem_filter, mem_univ, true_and] at hj
  simp [hold j] at hj

include hD hB hsupport hold hbirth in
theorem global_birth_visit_output_length
    (hi : Function.Injective (Sigma.fst ∘ old)) (hb : Function.Injective birth) :
    (globalBirthVisitOutput h old D birth).1 =
      (ghostPhasePendingSupport (ghostVisitBatchOutput h y D B)).card :=
  ghost_phase_memory_length_eq _ _
    (global_birth_visit_output_injective a h y D B hB old hold birth hbirth hi hb)
    (global_birth_visit_output_support a h y D B hD hB old hsupport birth hbirth)

include hy hD hB hsupport hold hbirth in
theorem global_birth_visit_output_symmetric_readout
    (hi : Function.Injective (Sigma.fst ∘ old)) (hb : Function.Injective birth)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) :
    symmetricPhaseReadout
      (globalBirthMemoryBase (ghostPhaseActivitySupport a) (ghostPhaseBornSupport y ∪ B)) F
      (globalBirthVisitOutput h old D birth) = F (ghostVisitBatchOutput h y D B) := by
  exact symmetric_phase_readout_eq_of_reconstruction _ _ F _
    (global_birth_visit_output_injective a h y D B hB old hold birth hbirth hi hb)
    (global_birth_visit_output_support a h y D B hD hB old hsupport birth hbirth)
    (global_birth_visit_output_readout a h y hy D B hD hB old hsupport hold birth hbirth)

include hy hsupport hold in
theorem global_birth_visit_zeros_eq : globalBirthVisitZeros h old = ghostVisitDeaths a h y := by
  ext p
  simp only [globalBirthVisitZeros, mem_image, mem_filter, mem_univ, true_and,
    ghostVisitDeaths]
  constructor
  · rintro ⟨j, hj, rfl⟩
    have hp : y (old j).1 = some (some (some (h (old j).1))) := by rw [hold j, hj]
    refine ⟨?_, hp⟩
    have hm := hy (old j).1
    rw [hp] at hm
    cases ha : a (old j).1 <;> simp_all
  · rintro ⟨_, hp⟩
    have hmem : p ∈ ghostPhasePendingSupport y := by
      simp only [ghostPhasePendingSupport, mem_filter, mem_univ, true_and]
      exact ⟨h p, hp⟩
    rw [← hsupport] at hmem
    obtain ⟨j, _, rfl⟩ := mem_image.mp hmem
    refine ⟨j, ?_, rfl⟩
    exact Option.some.inj (Option.some.inj (Option.some.inj ((hold j).symm.trans hp)))

end Batch
end

section
open Finset
open scoped Classical
theorem distinct_unrestricted_global_birth_phase_row {P : Type*}
    [Fintype P] [DecidableEq P] {R : P → Type*}
    [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    {N t : ℕ} (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (source target : Fin t ↪ P)
    (hsource : univ.image source = ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt)
    (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
    (old : (j : Fin N) → R (f.val j))
    (hold : ∀ j, w (f.val j) = some (some (some (old j))))
    (eligible : Finset (Fin N)) (e : distinctPromotedTargetSlots f.val target ↪ eligible)
    (hmatch : ∀ s : distinctPromotedTargetSlots f.val target, f.val (e s).val = target s.val)
    (hc : ∀ p, ghostPhaseMovingEdgeCompatible (atgt p) (asrc p) (delta p) (w p) = true)
    (β : P → ℝ) (ρ V : ℝ) (B : ℕ)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) :
    unrestrictedEdgeAction source (fun j => (⟨f.val j, old j⟩ : Σ p, R p)) Sigma.fst
      (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) (fun z => z.2 = 0)
      (fun p => β p / V) ρ V eligible B
      (fun _stores promotions g fresh =>
        if GlobalBirthEdgeEventValid (ghostPhaseBornSupport w) f.val target
          ⟨promotions, g, fresh⟩ then 1 else 0)
      (fun target q => symmetricPhaseReadout
        (globalBirthMemoryBase (ghostPhaseActivitySupport atgt)
          (ghostPhaseBornSupport w ∪ univ.image target)) F q) =
      ∑ z, ((∏ p, (if atgt p && !(asrc p) then V⁻¹ else 1) *
        ghostPhaseDampedMovingEdge (atgt p) (asrc p) (delta p) (β p) ρ ρ (z p) (w p) : ℝ) : ℂ) *
        (if (ghostPhasePendingSupport z).card ≤ B then F z else 0) := by
  simp_rw [global_birth_event_valid_iff_fixed_target atgt asrc delta w hw f target htarget hc]
  have hsrc : ∀ j, asrc (source j) = true ∧ atgt (source j) = false := by
    intro j
    have hj : source j ∈ univ.image source := mem_image.mpr ⟨j, mem_univ _, rfl⟩
    rw [hsource] at hj
    simpa [ghostPhaseActivitySupport] using hj
  have he := distinct_phase_event_selected atgt asrc w hw f target htarget eligible e hmatch
  rw [unrestricted_fixed_target_phase_coefficients atgt asrc delta w hw source target
    (fun j => (hsrc j).1) (fun j => (hsrc j).2) htarget f old hold eligible e hmatch hc β ρ V B
    (fun _ _ _ _ => 1)]
  rw [ghost_phase_measured_edge_complex_slots atgt asrc delta β ρ ρ V w hw source hsource]
  simp only [powerset_univ]
  apply sum_congr rfl
  intro stores _
  simp only [mul_one]
  rw [htarget, global_birth_new_run_update atgt asrc w hw]
  rw [global_birth_selected_edge_symmetric_readout source stores _ atgt asrc delta w hw
    (fun j => (hsrc j).1) (fun j _ => (hsrc j).2) f old e he hold F,
    distinct_unrestricted_output_length source stores _ atgt asrc delta w hw
      (fun j => (hsrc j).1) (fun j _ => (hsrc j).2) f old e he]
  rw [ghost_phase_run_normalized_edge_fresh_measure atgt asrc
    (distinctUnrestrictedStorageChoice source stores) delta β ρ ρ V w hw
      (distinct_unrestricted_storage_allowed source stores atgt asrc
        (fun j => (hsrc j).1) (fun j _ => (hsrc j).2))]
  rfl
end

section
open Finset
open scoped Classical
/-- Complex form of the exact measured birth expansion. This is an algebraic
identity with arbitrary coupled continuation, not a norm comparison. -/
theorem ghost_phase_transition_measured_births_complex {P : Type*}
    [Fintype P] [DecidableEq P] {R : P → Type*}
    [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    (a : P → Bool) (h : (p : P) → R p) (β : P → ℝ)
    (η V ρ : ℝ) (hV : V ≠ 0)
    (y : (p : P) → GhostPhaseState (R p)) (hy : ghostPhaseMask a y)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) :
    (∑ x, ((∏ p, ghostPhaseDampedVisit (a p) (h p) η (β p) ρ (x p) (y p) : ℝ) : ℂ) * F x) =
      ∑ D ∈ (ghostVisitDeaths a h y).powerset,
        ∑ b ∈ range ((ghostVisitBirths a y).card + 1),
          ∑ f : Fin b ↪ ghostVisitBirths a y,
            ((((-η / ρ) ^ D.card * ((1 - η) / ρ ^ 2) ^ (ghostVisitDeaths a h y \ D).card) *
              ((-η * V / ρ) ^ b * (∏ j, β (f j).val / V)) / (b.factorial : ℝ) : ℝ) : ℂ) *
              F (ghostVisitBatchOutput h y D ((distinctBirthRange f).map
                (Function.Embedding.subtype (fun p => p ∈ ghostVisitBirths a y)))) := by
  have hr (G : ((p : P) → GhostPhaseState (R p)) → ℝ) :=
    ghost_phase_transition_measured_births a h β η V ρ hV y hy G
  apply Complex.ext
  · simpa only [Complex.re_sum, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
      zero_mul, sub_zero, prod_const, sum_div, mul_sum,
      div_mul_eq_mul_div, mul_div_assoc, mul_assoc] using hr (fun x => (F x).re)
  · simpa only [Complex.im_sum, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
      zero_mul, add_zero, prod_const, sum_div, mul_sum,
      div_mul_eq_mul_div, mul_div_assoc, mul_assoc] using hr (fun x => (F x).im)

/-- The support in the original pool of an actual ordered birth tuple. -/
noncomputable def globalVisitBirthRange {P : Type*} (U : Finset P) {b : ℕ}
    (f : Fin b ↪ U) : Finset P :=
  (distinctBirthRange f).map (Function.Embedding.subtype (fun p => p ∈ U))

theorem global_visit_birth_range_image {P : Type*} [DecidableEq P]
    (U : Finset P) {b : ℕ} (f : Fin b ↪ U) :
    univ.image (fun j => (f j).val) = globalVisitBirthRange U f := by
  ext p
  simp [globalVisitBirthRange, distinctBirthRange]

theorem global_visit_birth_range_subset {P : Type*}
    (U : Finset P) {b : ℕ} (f : Fin b ↪ U) : globalVisitBirthRange U f ⊆ U := by
  intro p hp
  exact property_of_mem_map_subtype (distinctBirthRange f) hp

/-- Literal chronological ghost row with global birth exclusion. Terminations
range over subsets of old hit labels; retained old entries precede new entries.
The memory continuation is the symmetric zero extension of the phase test. -/
noncomputable def globalBirthGhostVisitRow {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, DecidableEq (R p)] {N : ℕ}
    (h : (p : P) → R p) (β : P → ℝ) (η V ρ : ℝ) (cap : ℕ)
    (active H : Finset P) (old : Fin N → Σ p, R p)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) : ℂ :=
  ∑ D ∈ (globalBirthVisitZeros h old).powerset,
    ∑ b ∈ range ((univ \ H).card + 1), ∑ f : Fin b ↪ ↥((univ : Finset P) \ H),
      ((((-η / ρ) ^ D.card * ((1 - η) / ρ ^ 2) ^ (globalBirthVisitZeros h old \ D).card) *
        ((-η * V / ρ) ^ b * (∏ j, β (f j).val / V)) / (b.factorial : ℝ) : ℝ) : ℂ) *
      (if (globalBirthVisitOutput h old D (fun j => (f j).val)).1 ≤ cap then
        symmetricPhaseReadout (globalBirthMemoryBase active
          (H ∪ globalVisitBirthRange (univ \ H) f)) F
          (globalBirthVisitOutput h old D (fun j => (f j).val)) else 0)

/-- The exact global-birth-filtered ordered row is the full damped phase
tensor visit with the same output-memory cutoff. No extra old-memory factorial
is inserted, and no completed label may be born again. -/
theorem global_birth_ghost_visit_row_eq {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)] {N : ℕ}
    (a : P → Bool) (h : (p : P) → R p) (β : P → ℝ)
    (η V ρ : ℝ) (hV : V ≠ 0) (cap : ℕ)
    (y : (p : P) → GhostPhaseState (R p)) (hy : ghostPhaseMask a y)
    (old : Fin N → Σ p, R p)
    (hi : Function.Injective (Sigma.fst ∘ old))
    (hsupport : univ.image (fun j => (old j).1) = ghostPhasePendingSupport y)
    (hold : ∀ j, y (old j).1 = some (some (some (old j).2)))
    (H : Finset P) (hH : H = ghostPhaseBornSupport y)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) :
    globalBirthGhostVisitRow h β η V ρ cap (ghostPhaseActivitySupport a) H old F =
      ∑ x, ((∏ p, ghostPhaseDampedVisit (a p) (h p) η (β p) ρ (x p) (y p) : ℝ) : ℂ) *
        (if (ghostPhasePendingSupport x).card ≤ cap then F x else 0) := by
  subst H
  have hu := ghost_visit_births_eq_unborn a y hy
  have hz := global_birth_visit_zeros_eq a h y hy old hsupport hold
  rw [ghost_phase_transition_measured_births_complex a h β η V ρ hV y hy]
  unfold globalBirthGhostVisitRow
  rw [hz, ← hu]
  apply sum_congr rfl
  intro D hD
  apply sum_congr rfl
  intro b _
  apply sum_congr rfl
  intro f _
  congr 1
  have hf : Function.Injective (fun j => (f j).val) := by
    intro j k hjk
    exact f.injective (Subtype.ext hjk)
  have hB := global_visit_birth_range_subset (ghostVisitBirths a y) f
  have hbi := global_visit_birth_range_image (ghostVisitBirths a y) f
  have hl := global_birth_visit_output_length a h y D
    (globalVisitBirthRange (ghostVisitBirths a y) f) (mem_powerset.mp hD) hB
    old hsupport hold (fun j => (f j).val) hbi hi hf
  rw [hl]
  have hr := global_birth_visit_output_symmetric_readout a h y hy D
    (globalVisitBirthRange (ghostVisitBirths a y) f) (mem_powerset.mp hD) hB
    old hsupport hold (fun j => (f j).val) hbi hi hf F
  convert congrArg (fun v : ℂ =>
    if (ghostPhasePendingSupport (ghostVisitBatchOutput h y D
      (globalVisitBirthRange (ghostVisitBirths a y) f))).card ≤ cap then v else 0) hr using 1
  congr 1
end

section
open Finset
open scoped Classical
noncomputable def globalBirthCoherentSupport {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (A H : Finset P) (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent A H q) :
    DistinctOrderedSupport (Fin q.1) (ghostPhasePendingSupport (globalBirthMemoryReadout A H q)) :=
  ⟨⟨fun j => (q.2 j).1, hq.label_injective⟩, by
    intro p
    rw [global_birth_coherent_readout_pending_support A H q hq]
    simp only [mem_image, mem_univ, true_and]
    rfl⟩

theorem global_birth_coherent_readout_mask {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (a : P → Bool) (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent (ghostPhaseActivitySupport a) H q) :
    ghostPhaseMask a (globalBirthMemoryReadout (ghostPhaseActivitySupport a) H q) := by
  have he := global_birth_coherent_readout_active_support (ghostPhaseActivitySupport a) H q hq
  intro p
  have hp : globalBirthMemoryReadout (ghostPhaseActivitySupport a) H q p = none ↔ a p = true := by
    rw [← ghost_phase_mem_state_active_support, he]
    simp [ghostPhaseActivitySupport]
  cases ha : a p <;>
    cases hz : globalBirthMemoryReadout (ghostPhaseActivitySupport a) H q p <;>
    simp_all

/-- Every coherent ordered snapshot has the exact globally filtered phase
row. Both its cumulative-born set and the source phase are derived from the
snapshot, while the actual pending tuple is passed unchanged to the action. -/
theorem coherent_global_birth_edge_row {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    {t : ℕ} (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent (ghostPhaseActivitySupport asrc) H q)
    (source target : Fin t ↪ P)
    (hsource : univ.image source = ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt)
    (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    (eligible : Finset (Fin q.1))
    (e : distinctPromotedTargetSlots (globalBirthCoherentSupport (ghostPhaseActivitySupport asrc) H q hq).val target ↪ eligible)
    (hmatch : ∀ s, (globalBirthCoherentSupport (ghostPhaseActivitySupport asrc) H q hq).val (e s).val = target s.val)
    (hc : ∀ p, ghostPhaseMovingEdgeCompatible (atgt p) (asrc p) (delta p)
      (globalBirthMemoryReadout (ghostPhaseActivitySupport asrc) H q p) = true)
    (β : P → ℝ) (ρ V : ℝ) (B : ℕ)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) :
    unrestrictedEdgeAction source q.2 Sigma.fst (fun p => ⟨p, 0⟩)
      (unrestrictedPhaseTransport delta) (fun z => z.2 = 0)
      (fun p => β p / V) ρ V eligible B
      (fun _stores promotions g fresh =>
        if GlobalBirthEdgeEventValid H
          (globalBirthCoherentSupport (ghostPhaseActivitySupport asrc) H q hq).val target
          ⟨promotions, g, fresh⟩ then 1 else 0)
      (fun target q' => symmetricPhaseReadout
        (globalBirthMemoryBase (ghostPhaseActivitySupport atgt) (H ∪ univ.image target)) F q') =
      ∑ z, ((∏ p, (if atgt p && !(asrc p) then V⁻¹ else 1) *
        ghostPhaseDampedMovingEdge (atgt p) (asrc p) (delta p) (β p) ρ ρ (z p)
          (globalBirthMemoryReadout (ghostPhaseActivitySupport asrc) H q p) : ℝ) : ℂ) *
        (if (ghostPhasePendingSupport z).card ≤ B then F z else 0) := by
  let w := globalBirthMemoryReadout (ghostPhaseActivitySupport asrc) H q
  let f := globalBirthCoherentSupport (ghostPhaseActivitySupport asrc) H q hq
  have hw : ghostPhaseMask asrc w := global_birth_coherent_readout_mask asrc H q hq
  have hold : ∀ j, w (f.val j) = some (some (some (q.2 j).2)) :=
    global_birth_coherent_readout_particle (ghostPhaseActivitySupport asrc) H q hq
  have hborn : ghostPhaseBornSupport w = H :=
    global_birth_coherent_readout_born_support (ghostPhaseActivitySupport asrc) H q hq
  have heq : (fun j => (⟨f.val j, (q.2 j).2⟩ : Σ p, R p)) = q.2 := by
    funext j
    rfl
  have h := distinct_unrestricted_global_birth_phase_row atgt asrc delta w hw
    source target hsource htarget f (fun j => (q.2 j).2) hold eligible e hmatch hc β ρ V B F
  simpa only [heq, hborn] using h
end

section
open Finset
open scoped Classical
theorem distinct_unrestricted_complete_global_birth_phase_row {P : Type*}
    [Fintype P] [DecidableEq P] {R : P → Type*}
    [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    {N t : ℕ} (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (hshared : ∀ p, atgt p = true ∧ asrc p = true → delta p = 0)
    (source target : Fin t ↪ P)
    (hsource : univ.image source = ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt)
    (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
    (old : (j : Fin N) → R (f.val j))
    (hold : ∀ j, w (f.val j) = some (some (some (old j))))
    (eligible : Finset (Fin N))
    (heligible : ∀ j, j ∈ eligible ↔ old j = delta (f.val j))
    (β : P → ℝ) (ρ V : ℝ) (B : ℕ)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) :
    unrestrictedEdgeAction source (fun j => (⟨f.val j, old j⟩ : Σ p, R p)) Sigma.fst
      (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) (fun z => z.2 = 0)
      (fun p => β p / V) ρ V eligible B
      (fun _stores promotions g fresh =>
        if GlobalBirthEdgeEventValid (ghostPhaseBornSupport w) f.val target
          ⟨promotions, g, fresh⟩ then 1 else 0)
      (fun target q => symmetricPhaseReadout
        (globalBirthMemoryBase (ghostPhaseActivitySupport atgt)
          (ghostPhaseBornSupport w ∪ univ.image target)) F q) =
      ∑ z, ((∏ p, (if atgt p && !(asrc p) then V⁻¹ else 1) *
        ghostPhaseDampedMovingEdge (atgt p) (asrc p) (delta p) (β p) ρ ρ (z p) (w p) : ℝ) : ℂ) *
        (if (ghostPhasePendingSupport z).card ≤ B then F z else 0) := by
  by_cases hc : ∀ p, ghostPhaseMovingEdgeCompatible (atgt p) (asrc p) (delta p) (w p) = true
  · obtain ⟨e, he⟩ := global_birth_matching_promotion_exists atgt asrc delta w f old hold
      target htarget eligible heligible hc
    exact distinct_unrestricted_global_birth_phase_row atgt asrc delta w hw source target
      hsource htarget f old hold eligible e he hc β ρ V B F
  · have hvalid : ∀ event : FixedTargetEdgeEvent (Fin t) (Fin N) P eligible,
        ¬GlobalBirthEdgeEventValid (ghostPhaseBornSupport w) f.val target event := by
      intro event hv
      apply hc
      exact global_birth_event_implies_compatible atgt asrc delta w hw hshared f old hold
        target htarget eligible (fun j hj => (heligible j).mp hj) event hv
    have hout : ∀ z : (p : P) → GhostPhaseState (R p),
        (∏ p, (if atgt p && !(asrc p) then V⁻¹ else 1) *
          ghostPhaseDampedMovingEdge (atgt p) (asrc p) (delta p) (β p) ρ ρ (z p) (w p) : ℝ) = 0 := by
      intro z
      obtain ⟨p, hp⟩ := not_forall.mp hc
      apply prod_eq_zero (mem_univ p)
      rw [ghost_phase_damped_moving_edge_eq_zero_of_incompatible
        (atgt p) (asrc p) (delta p) (β p) ρ ρ (z p) (w p) (hw p) hp, mul_zero]
    simp only [unrestrictedEdgeAction, hvalid, if_false, mul_zero, zero_mul, sum_const_zero,
      hout, Complex.ofReal_zero]
end

section
open Finset
open scoped Classical
/-- Actual old positions eligible to terminate at the current hit. -/
noncomputable def globalBirthVisitZeroIndices {P : Type*} {R : P → Type*}
    [∀ p, DecidableEq (R p)] {N : ℕ} (h : (p : P) → R p)
    (old : Fin N → Σ p, R p) : Finset (Fin N) :=
  univ.filter (fun j => (old j).2 = h (old j).1)

theorem global_birth_visit_zero_labels {P : Type*} [DecidableEq P]
    {R : P → Type*} [∀ p, DecidableEq (R p)] {N : ℕ}
    (h : (p : P) → R p) (old : Fin N → Σ p, R p) :
    globalBirthVisitZeros h old =
      (globalBirthVisitZeroIndices h old).image (fun j => (old j).1) := rfl

/-- Injective labels identify subsets of eligible indices with subsets of
eligible labels, without any ordering multiplicity. -/
noncomputable def globalVisitDeathSubsetEquiv {J P : Type*}
    [DecidableEq J] [DecidableEq P] (Z : Finset J) (label : J → P)
    (hi : Function.Injective label) : Z.powerset ≃ (Z.image label).powerset :=
  Equiv.ofBijective (fun T => ⟨T.val.image label,
    mem_powerset.mpr (image_subset_image (mem_powerset.mp T.property))⟩) (by
      constructor
      · intro T U heq
        apply Subtype.ext
        exact (image_injective hi) (congrArg Subtype.val heq)
      · intro D
        obtain ⟨T, hT, heq⟩ := image_surjOn_powerset D.property
        exact ⟨⟨T, hT⟩, Subtype.ext heq⟩)

theorem global_visit_death_subset_sum {J P M : Type*}
    [DecidableEq J] [DecidableEq P] [AddCommMonoid M]
    (Z : Finset J) (label : J → P) (hi : Function.Injective label)
    (F : Finset P → M) :
    (∑ T ∈ Z.powerset, F (T.image label)) = ∑ D ∈ (Z.image label).powerset, F D := by
  rw [powerset_image, sum_image]
  intro T _ U _ hTU
  exact (image_injective hi) hTU

/-- The number of deaths and of retained old hits are unchanged by the label map. -/
theorem global_visit_death_counts {J P : Type*} [DecidableEq J] [DecidableEq P]
    (Z T : Finset J) (label : J → P) (hi : Function.Injective label) :
    (T.image label).card = T.card ∧
      (Z.image label \ T.image label).card = (Z \ T).card := by
  constructor
  · exact card_image_of_injective _ hi
  · rw [← image_sdiff Z T hi, card_image_of_injective _ hi]

/-- Deleting labels of the chosen indices removes exactly those indices. -/
theorem global_birth_visit_surviving_indices {P : Type*} [DecidableEq P]
    {R : P → Type*} {N : ℕ} (old : Fin N → Σ p, R p)
    (hi : Function.Injective (Sigma.fst ∘ old)) (T : Finset (Fin N)) :
    ghostVisitSurvivingIndices old (T.image (fun j => (old j).1)) = univ \ T := by
  ext j
  have heq : ∀ k, (old k).1 = (old j).1 ↔ k = j := fun k => hi.eq_iff
  simp [ghostVisitSurvivingIndices, mem_image, heq]

/-- The output is the same literal retained tuple, not just a permutation. -/
theorem global_birth_visit_index_output {P : Type*} [DecidableEq P]
    {R : P → Type*} {N b : ℕ} (h : (p : P) → R p) (old : Fin N → Σ p, R p)
    (hi : Function.Injective (Sigma.fst ∘ old)) (T : Finset (Fin N))
    (birth : Fin b → P) :
    globalBirthVisitOutput h old (T.image (fun j => (old j).1)) birth =
      retainedBirthTuple old (univ \ T) (fun j => ⟨birth j, h (birth j)⟩) := by
  rw [globalBirthVisitOutput, global_birth_visit_surviving_indices old hi T]

/-- The actual-index global ghost row: select old hit indices to terminate,
retain all other old entries, and append the globally new ordered birth batch. -/
noncomputable def globalBirthGhostVisitIndexRow {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, DecidableEq (R p)] {N : ℕ}
    (h : (p : P) → R p) (β : P → ℝ) (η V ρ : ℝ) (cap : ℕ)
    (active H : Finset P) (old : Fin N → Σ p, R p)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) : ℂ :=
  ∑ T ∈ (globalBirthVisitZeroIndices h old).powerset,
    ∑ b ∈ range ((univ \ H).card + 1), ∑ f : Fin b ↪ ↥((univ : Finset P) \ H),
      ((((-η / ρ) ^ T.card * ((1 - η) / ρ ^ 2) ^ (globalBirthVisitZeroIndices h old \ T).card) *
        ((-η * V / ρ) ^ b * (∏ j, β (f j).val / V)) / (b.factorial : ℝ) : ℝ) : ℂ) *
      (if (retainedBirthTuple old (univ \ T) (fun j => ⟨(f j).val, h (f j).val⟩)).1 ≤ cap then
        symmetricPhaseReadout (globalBirthMemoryBase active
          (H ∪ globalVisitBirthRange (univ \ H) f)) F
          (retainedBirthTuple old (univ \ T) (fun j => ⟨(f j).val, h (f j).val⟩)) else 0)

/-- Exact index-to-label reindexing of the full complex visit row. -/
theorem global_birth_ghost_visit_index_row_eq_label {P : Type*}
    [Fintype P] [DecidableEq P] {R : P → Type*} [∀ p, DecidableEq (R p)] {N : ℕ}
    (h : (p : P) → R p) (β : P → ℝ) (η V ρ : ℝ) (cap : ℕ)
    (active H : Finset P) (old : Fin N → Σ p, R p)
    (hi : Function.Injective (Sigma.fst ∘ old))
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) :
    globalBirthGhostVisitIndexRow h β η V ρ cap active H old F =
      globalBirthGhostVisitRow h β η V ρ cap active H old F := by
  unfold globalBirthGhostVisitRow globalBirthGhostVisitIndexRow
  rw [global_birth_visit_zero_labels, ← global_visit_death_subset_sum
    (globalBirthVisitZeroIndices h old) (fun j => (old j).1) hi]
  apply sum_congr rfl
  intro T _
  have hc := global_visit_death_counts (globalBirthVisitZeroIndices h old) T
    (fun j => (old j).1) hi
  simp only [hc.1, hc.2, global_birth_visit_index_output h old hi T]

/-- The globally filtered actual-index row equals the damped phase tensor row. -/
theorem global_birth_ghost_visit_index_row_eq {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)] {N : ℕ}
    (a : P → Bool) (h : (p : P) → R p) (β : P → ℝ)
    (η V ρ : ℝ) (hV : V ≠ 0) (cap : ℕ)
    (y : (p : P) → GhostPhaseState (R p)) (hy : ghostPhaseMask a y)
    (old : Fin N → Σ p, R p) (hi : Function.Injective (Sigma.fst ∘ old))
    (hsupport : univ.image (fun j => (old j).1) = ghostPhasePendingSupport y)
    (hold : ∀ j, y (old j).1 = some (some (some (old j).2)))
    (H : Finset P) (hH : H = ghostPhaseBornSupport y)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) :
    globalBirthGhostVisitIndexRow h β η V ρ cap (ghostPhaseActivitySupport a) H old F =
      ∑ x, ((∏ p, ghostPhaseDampedVisit (a p) (h p) η (β p) ρ (x p) (y p) : ℝ) : ℂ) *
        (if (ghostPhasePendingSupport x).card ≤ cap then F x else 0) := by
  rw [global_birth_ghost_visit_index_row_eq_label h β η V ρ cap _ H old hi F]
  exact global_birth_ghost_visit_row_eq a h β η V ρ hV cap y hy old hi hsupport hold H hH F
end

