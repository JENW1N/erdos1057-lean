/- The inner singleton cross-slice is the existing exact endpoint coefficient. -/

open Finset MeasureTheory
open scoped ComplexConjugate

namespace Bounty

theorem typeII_character_cross_fourier_singleton_eq
    (A L U V E Z : ℝ) (k : ℤ) (M H : Finset ℕ) (z w : ℕ)
    (ψ : ℝ → ℝ) (α : ℕ → ℂ) (W : ℕ → ℝ) (B : ℕ → ℂ) (ρ : ℝ)
    (χ : DirichletCharacter ℂ (2*k.natAbs))
    (hM : ∀ m ∈ M, 0 < m) (hk : k ≠ 0) (hzw : (z:ℤ)+k=(w:ℤ))
    (ξ : EuclideanSpace ℝ (Fin 3)) :
    typeIICrossCharacterFourierIntegrand A L U V E Z k M H {z} ψ α (typeIISeparatedH W B ρ) χ ξ =
      typeIICrossFourierScale A L U V E Z k ξ * ((ψ ((z:ℝ)/Z) : ℂ) *
        typeIICrossPairCoefficient M H (fun m => α m * χ (m : ZMod (2*k.natAbs))) W B ρ
          (2*Real.pi*ξ 0) (2*Real.pi*ξ 1) (2*Real.pi*ξ 2) z w) := by
  classical
  unfold typeIICrossCharacterFourierIntegrand typeIIFiniteCrossFourierIntegrand
  apply congrArg (fun v : ℂ => typeIICrossFourierScale A L U V E Z k ξ * v)
  rw [← typeII_cross_slice_singleton_eq_cross_pair_coefficient M H k z w
    (fun m => α m * χ (m : ZMod (2*k.natAbs))) W B ρ
    (2*Real.pi*ξ 0) (2*Real.pi*ξ 1) (2*Real.pi*ξ 2) hM hk hzw, mul_sum]
  apply sum_congr rfl
  intro y hy
  have hzy : y.1.2 = z := mem_singleton.mp
    (mem_product.mp (mem_product.mp (mem_filter.mp hy).1).1).2
  simp only [typeIICrossCharacterAmplitude, typeIICrossFourierPowers, hzy, map_mul]
  ring

theorem candidate_character_cross_fourier_eq_original_endpoints
    (c L q : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm
      (candidateRoughSlot c L r jStar hr hj)) = false)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (σ : ℝ)
    (hphase : ∀ p ∈ candidateRoughBand c L jStar,
      twist (candidateRoughSlot c L r jStar hr hj) p = typeIIPhase σ p)
    (marks : ℕ → ℕ) (A U V E Z : ℝ) (k : ℤ) (M H : Finset ℕ)
    (ψ : ℝ → ℝ) (α : ℕ → ℂ) (ρ : ℝ) (χ : DirichletCharacter ℂ (2*k.natAbs))
    {z w : ℕ} (hz : 0 < z) (hw : 0 < w)
    (hM : ∀ m ∈ M, 0 < m) (hH : ∀ h ∈ H, 0 < h)
    (hk : k ≠ 0) (hzw : (z:ℤ)+k=(w:ℤ))
    (hfree : ∀ m ∈ M, Disjoint m.primeFactors
      ((candidatePIndices c L).biUnion (candidatePBand (c*L))))
    (hHz : ∀ m ∈ M, m ∣ z → z/m ∈ H) (hHw : ∀ m ∈ M, m ∣ w → w/m ∈ H)
    (hα : ∀ m, m ∉ M → α m=0) (ξ : EuclideanSpace ℝ (Fin 3)) :
    let P := (candidatePIndices c L).biUnion (candidatePBand (c*L))
    let W : ℕ → ℝ := fun n => markedDivisorWeight (candidatePIndices c L)
      (candidatePBand (c*L)) q (fun j => ∑ p ∈ candidatePBand (c*L) j, 1/(p:ℝ)) marks (n:ℤ)
    let cr := candidateResidualPrimeCoefficient c L r jStar hr hj take hkeep twist
    let F₀ := invariantTripleEndpoint P
      (fun m => α m * χ (m : ZMod (2*k.natAbs)) * typeIIPhase (ρ-2*Real.pi*ξ 1) m)
      (fun p => if p ∈ candidateRoughBand c L jStar then typeIIPhase (-σ) p else 0)
      (fun s => conj (cr s))
    let G₀ := invariantTripleEndpoint P
      (fun m => α m * χ (m : ZMod (2*k.natAbs)) * typeIIPhase (2*Real.pi*ξ 0+ρ) m)
      (fun p => if p ∈ candidateRoughBand c L jStar then typeIIPhase (-σ) p else 0)
      (fun s => conj (cr s))
    typeIICrossCharacterFourierIntegrand A L U V E Z k M H {z} ψ α
      (typeIISeparatedH W
        (fun h => candidateRemainingComplexCoefficient c L r jStar take twist (primePoolFreePart P h)) ρ) χ ξ =
      typeIICrossFourierScale A L U V E Z k ξ * ((ψ ((z:ℝ)/Z) : ℂ) *
        (typeIIPhase (ρ+2*Real.pi*ξ 2) z * typeIIPhase (-ρ) w * conj (F₀ z) * G₀ w *
          (W z : ℂ) * (W w : ℂ))) := by
  dsimp only
  rw [typeII_character_cross_fourier_singleton_eq A L U V E Z k M H z w ψ α _ _ ρ χ hM hk hzw ξ]
  rw [candidate_cross_pair_eq_original_invariant_endpoints c L q r jStar hr hj take hkeep
    twist σ hphase marks M H α (2*k.natAbs) χ ρ (2*Real.pi*ξ 0) (2*Real.pi*ξ 1) (2*Real.pi*ξ 2)
    hz hw hM hH hfree hHz hHw hα]

end Bounty
end

