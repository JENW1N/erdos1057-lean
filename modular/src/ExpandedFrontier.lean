        (fun (i : patterns) g => C i.val (e.symm g).val)
        (fun (j : Fin (n + 1)) (i : patterns) => k (n - j.val) i.val) B
        (fun g : ↥groupsᶜ => V g.val) (fun _ => q)
        ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1)))
        (physicalGroupResidueVector r) pl.1 pl.2 x
        (physicalRootSelectedEffectivePathEquiv groups e patterns C hC k pl x path) *
      physicalEffectivePlanCoefficientPhase
        (fun (i : patterns) g => C i.val (e.symm g).val)
        (fun (j : Fin (n + 1)) (i : patterns) => k (n - j.val) i.val) B
        (fun _ => 0) (physicalRootKeyCoefficient groups e patterns C hC ζ k K θ)
        ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1)))
        pl.1 pl.2 x (physicalRootSelectedEffectivePathEquiv groups e patterns C hC k pl x path)) * f (finiteEventPathTerminal (FullPermutationMixedEvent (fun g (p : P (e.symm g).val) => p.val)
      (fun j g => physicalFullSharedIndices (ell := ell) (Cn j g)) B
      (fun j _ => PhysicalAuxLabels (fun g => P (e.symm g).val) (Cn j))
      (fun j => physicalFullEdgeDelta (Cn j) (kn j)) (fun j => physicalFullEdgeD (Cn j))) (fullPermutationMixedEventTarget (fun g (p : P (e.symm g).val) => p.val)
      (fun j g => physicalFullSharedIndices (ell := ell) (Cn j g)) B
      (fun j _ => PhysicalAuxLabels (fun g => P (e.symm g).val) (Cn j))
      (fun j => physicalFullEdgeDelta (Cn j) (kn j)) (fun j => physicalFullEdgeD (Cn j))) ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1))) x path) := by
  let _ : ∀ g (z : P (e.symm g).val), NeZero z.val :=
    fun g z => inferInstanceAs (NeZero (⟨(e.symm g).val, z⟩ : PhysicalPrime P).2.val)
  let Cn := fun j g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val
  let kn := physicalRootPlanMultiplier groups patterns C hC k pl
  unfold physicalOriginalWeightedMoment
  dsimp only
  apply Finset.sum_congr rfl
  intro path _
  exact congrArg (fun z => z * f (finiteEventPathTerminal
    (FullPermutationMixedEvent (fun g (p : P (e.symm g).val) => p.val)
      (fun j g => physicalFullSharedIndices (ell := ell) ((fun g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val) g)) B
      (fun j _ => PhysicalAuxLabels (fun g => P (e.symm g).val) ((fun g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val)))
      (fun j => physicalFullEdgeDelta ((fun g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val)) (physicalRootPlanMultiplier groups patterns C hC k pl j)) (fun j => physicalFullEdgeD ((fun g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val)))) (fullPermutationMixedEventTarget (fun g (p : P (e.symm g).val) => p.val)
      (fun j g => physicalFullSharedIndices (ell := ell) (Cn j g)) B
      (fun j _ => PhysicalAuxLabels (fun g => P (e.symm g).val) (Cn j))
      (fun j => physicalFullEdgeDelta (Cn j) (kn j)) (fun j => physicalFullEdgeD (Cn j))) ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1))) x path))
    (physical_root_weighted_effective_complete groups e patterns C hC k pl V hq r ζ K θ
      ω β retention ρ cut hencode x hx path)

end Root
