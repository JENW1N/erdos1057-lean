/-- The remaining analytic input can be restricted to primitive nonprincipal
characters. This definition does not assert the estimate. -/
def PrimitiveTwistedMangoldtEstimate : Prop :=
  ∃ C : ℝ, 0 < C ∧ ∀ x : ℝ, 2 ≤ x → ∀ q : ℕ, 0 < q →
    ∀ χ : DirichletCharacter ℂ q, χ ≠ 1 → χ.IsPrimitive →
      ‖twistedPsi χ x‖ ≤ C * x ^ ((7 : ℝ) / 8) * (Real.log ((q : ℝ) * x)) ^ 2

/-- Prime-power removal and finite partial summation for one fixed character.
The Mangoldt bound need not be available for any other character. -/
theorem prime_sum_bound_of_twistedPsi {q : ℕ} (χ : DirichletCharacter ℂ q)
    (hq : 0 < q) {C : ℝ} (hC : 0 ≤ C)
    (hbound : ∀ x : ℝ, 2 ≤ x →
      ‖twistedPsi χ x‖ ≤ C * x ^ ((7 : ℝ) / 8) * (Real.log ((q : ℝ) * x)) ^ 2)
    {y : ℝ} (hy : 2 ≤ y) :
    ‖∑ p ∈ ambientPrimes y, χ (p : ZMod q)‖ ≤
      (20 * (C + 4)) * y ^ ((7 : ℝ) / 8) * (Real.log (5 * (q : ℝ) * y)) ^ 2 := by
  apply prime_sum_bound_of_twistedTheta χ hq (by linarith : 0 ≤ C + 4) _ hy
  intro x hx
  have htheta := norm_twistedTheta_le χ (by linarith : 1 ≤ x) (hbound x hx)
  have herr := prime_power_error_le_character_scale
    (by exact_mod_cast hq : (1 : ℝ) ≤ q) hx
  nlinarith

/-- A primitive Mangoldt estimate supplies the primitive prime interval
estimate with uniform constant `20 * (C + 4)`. -/
theorem primitivePrimeCharacterEstimate_of_mangoldt
    (h : PrimitiveTwistedMangoldtEstimate) : PrimitivePrimeCharacterEstimate := by
  obtain ⟨C, hC, hbound⟩ := h
  refine ⟨20 * (C + 4), by positivity, ?_⟩
  intro y hy q hq χ hχ hprim
  exact prime_sum_bound_of_twistedPsi χ hq hC.le
    (fun x hx => hbound x hx q hq χ hχ hprim) hy

/-- Thus the entire prime-character input follows from a sharp twisted
Mangoldt bound solely for primitive nonprincipal characters. -/
theorem uniformPrimeCharacterEstimate_of_primitive_mangoldt
    (h : PrimitiveTwistedMangoldtEstimate) : UniformPrimeCharacterEstimate :=
  uniformPrimeCharacterEstimate_of_primitive (primitivePrimeCharacterEstimate_of_mangoldt h)
end

