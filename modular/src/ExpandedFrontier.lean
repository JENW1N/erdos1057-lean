section

/- The actual head-event samples use the original global chronological order, independently of their values. -/

open Classical

namespace Bounty

section Ghost
variable {J K : Type*} {N : ℕ} {P Z : Fin N → Type*} {M : Fin N → ℕ}
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ) (j : J)
    (steps : List (Option (J ⊕ K)))
    (s : ProductBoundedOrderedState P Z M B) (sk : CoupledGhostSkeleton M B s)

noncomputable def fullMixedGhostHeadSampleEmbedding :
    CoupledGhostSampleIndex M B s sk ↪
      Fin (Fintype.card (FullMixedBirthAddress S B (some (.inl j) :: steps))) :=
  (coupledGhostLocalSampleEmbedding S B j s sk).trans
    (fullMixedOccurrenceAddressEmbedding S B (some (.inl j) :: steps) ⟨0, by simp⟩)

noncomputable def fullMixedGhostHeadSampleOrder :
    Fin (Fintype.card (CoupledGhostSampleIndex M B s sk)) ≃ CoupledGhostSampleIndex M B s sk :=
  finiteEmbeddedOrder (fullMixedGhostHeadSampleEmbedding S B j steps s sk)

theorem full_mixed_ghost_head_sample_order_strictMono :
    StrictMono (fun i => fullMixedGhostHeadSampleEmbedding S B j steps s sk
      (fullMixedGhostHeadSampleOrder S B j steps s sk i)) :=
  finite_embedded_order_strictMono _

theorem full_mixed_ghost_head_sample_owner (i : CoupledGhostSampleIndex M B s sk) :
    fullMixedBirthOwner S B (some (.inl j) :: steps)
      (fullMixedBirthOrder S B (some (.inl j) :: steps)
        (fullMixedGhostHeadSampleEmbedding S B j steps s sk i)) = ⟨0, by simp⟩ :=
  full_mixed_occurrence_address_owner _ _ _ _ _

end Ghost

