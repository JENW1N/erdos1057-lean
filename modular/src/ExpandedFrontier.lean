/- Sum the actual auxiliary draw outside the mixed full action, with arbitrary coupled phases. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_mixed_full_auxiliary_action
    {S G A : Type*} [Fintype S] [Fintype G] [DecidableEq G] [Fintype A]
    {Ps : S → Finset ℕ} {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
    (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → A → G → ℤ)
    (ω : SharedActiveLabels P shared → A → ℝ)
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (kbig : SharedActiveLabels P shared → A → ℤ) (Vs : S → ℝ) (q : ℝ)
    (aux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))))
    (Φ : ∀ s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B),
      PhysicalSmallBigEvent (fun d x => FullActiveEdgeEvent n shared B (fun _ => A) (Δ d) (D d) x) s → ℂ)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (r : PhysicalResidues Ps) (L : PhysicalMarkLists Ps J ell)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    (∑ R : PhysicalMarkLists Ps J ell,
      ∑ e : FullActiveEdgeEvent n shared B (fun _ => A)
        (Δ (physicalSharedPrefix L)) (D (physicalSharedPrefix L)) x,
        physicalBarePatternScalar Vs (fun _ => (∅ : Finset (Fin J))) 0
          (fun _ _ _ => 1) aux L R *
        ((physicalResidueVertexWeight L (Real.sqrt q) r *
          physicalResidueVertexWeight R (Real.sqrt q)
            (physicalTranslateResidues r
              (kbig (productActiveMemorySplit shared B x).1 e.1 *
                (physicalSharedProduct (physicalSharedPrefix L) : ℕ))) : ℝ) : ℂ) *
        (fullActiveEdgeEventWeight n shared B (fun _ => A)
          (Δ (physicalSharedPrefix L)) (D (physicalSharedPrefix L)) ω μ ρ V x e : ℂ) *
        Φ ((r, L), x) (R, e) *
        F ((physicalTranslateResidues r
          (kbig (productActiveMemorySplit shared B x).1 e.1 *
            (physicalSharedProduct (physicalSharedPrefix L) : ℕ)), R),
          fullActiveEdgeEventTarget n shared B (fun _ => A)
            (Δ (physicalSharedPrefix L)) (D (physicalSharedPrefix L)) x e)) =
    ∑ a : A, (ω (productActiveMemorySplit shared B x).1 a : ℂ) *
      physicalSmallBigFullPhasedAction n shared B (fun d c => Δ d c a) (fun d c => D d c a)
        μ ρ V (fun c => kbig c a) Vs q
        (fun s e => Φ s (e.1, fullActiveFixedAuxEvent n shared B
          (Δ (physicalSharedPrefix s.1.2)) (D (physicalSharedPrefix s.1.2)) s.2 a e.2)) F ((r, L), x) := by
  simp_rw [physicalSmallBigFullPhasedAction, physical_mixed_phased_bare_expansion Vs q aux]
  simp only [Fintype.sum_sigma, Fintype.sum_unique, fullActiveEdgeEventWeight,
    fullActiveFixedAuxEvent, fullActiveEdgeEventTarget, physicalSmallBigFullWeight,
    physicalSmallBigFullTarget, one_mul, Complex.ofReal_mul, mul_sum]
  rw [sum_comm]
  apply sum_congr rfl
  intro a ha
  apply sum_congr rfl
  intro R hR
  apply sum_congr rfl
  intro e he
  ring

end Bounty
