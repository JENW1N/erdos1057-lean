      (fun i => fullMixedCommonBirthPerformed n S B A Δ D steps s p (fullMixedCommonBirthOrder M B steps i))
      (fun i => fullMixedCommonBirthLabel n S B A Δ D steps s p (fullMixedCommonBirthOrder M B steps i)) code)
    phase hphase f s).trans
    (full_mixed_common_original_forest_bounded n S B A Δ D ω μ q ρ v vmin V η β steps code
    hω hωmass hμ hmass hη hμatom hβ hghostAtom hedgeAtom hq0 hq1 hρ0 hρ1 hv hvmin hV hD T ht s hx
      (fun p => ‖f (finiteEventPathTerminal (FullPermutationMixedEvent n S B A Δ D)
        (fullPermutationMixedEventTarget n S B A Δ D) steps s p)‖) hL (fun p => hf _))

