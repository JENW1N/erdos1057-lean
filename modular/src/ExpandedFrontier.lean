/- Fixed-radius cutoff tails have arbitrary integrated precision on retained full boxes. -/

open Finset Filter MeasureTheory

namespace Bounty

theorem eventually_harmonic_normalized_four_box_integrated_tail
    {r c E : ℝ} (hr : 0 < r) (hc : 0 ≤ c) (F : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, 1 ≤ Y → Real.log Y ≤ c*L →
      ∀ (D A B C : Finset ℕ) (δ α β γ : ℕ → ℂ) (D₀ A₀ B₀ C₀ : ℝ),
      0 ≤ D₀ → 0 ≤ A₀ → 0 ≤ B₀ → 0 ≤ C₀ → D₀*A₀*B₀*C₀ ≤ L^E →
      (∀ d ∈ D, 0 < d) → (∀ a ∈ A, 0 < a) →
      (∀ b ∈ B, 0 < b) → (∀ z ∈ C, 0 < z) →
      (∀ d ∈ D, ‖δ d‖ ≤ D₀) → (∀ a ∈ A, ‖α a‖ ≤ A₀) →
      (∀ b ∈ B, ‖β b‖ ≤ B₀) → (∀ z ∈ C, ‖γ z‖ ≤ C₀) →
      (∀ d ∈ D, ∀ a ∈ A, ∀ b ∈ B, ∀ z ∈ C,
        Y/128 ≤ ((d*a*b*z : ℕ) : ℝ) ∧
          ((d*a*b*z : ℕ) : ℝ) ≤ 64*Real.exp 2*Y) →
      ∀ T w : ℝ, 0 ≤ T → T ≤ L*Y →
        IntegrableOn
          (fun s => ‖harmonicNormalizedFourBoxError Y (s+w) (L^r) D A B C δ α β γ‖^2)
          (Set.Icc (-T) T) ∧
        (∫ s in Set.Icc (-T) T,
          ‖harmonicNormalizedFourBoxError Y (s+w) (L^r) D A B C δ α β γ‖^2) ≤ L^(-F) := by
  filter_upwards [eventually_harmonic_four_box_shifted_mean_square (E := E) hc,
    eventually_schwartz_squared_tail_polynomial harmonicWindowLogFourier hr
      1 (2*E+17) F (by norm_num)] with L hmean htail
  intro Y hY hlogY D A B C δ α β γ D₀ A₀ B₀ C₀
    hD₀ hA₀ hB₀ hC₀ hprod hD hA hB hC hδ hα hβ hγ hgeom T w hT hTY
  have he := harmonic_normalized_four_box_integrated_tail_shifted (zero_lt_one.trans_le hY)
    (-T) T (L^r) (L^(2*E+17)) w D A B C δ α β γ hD hA hB hC (by
      intro u
      simpa only [add_assoc] using hmean Y hY hlogY D A B C δ α β γ D₀ A₀ B₀ C₀
        hD₀ hA₀ hB₀ hC₀ hprod hD hA hB hC hδ hα hβ hγ hgeom
        T (w+2*Real.pi*u) hT hTY)
  exact ⟨he.1, he.2.trans (by simpa only [one_mul] using htail)⟩

end Bounty
end

section

/- Minor cancellation for the literal auxiliary cell/character summand with
the exact Mellin frequency -(a+b+2*pi*v) from harmonic cutoff separation. -/

open Finset Filter
open scoped Classical
namespace Bounty

theorem exists_candidate_actual_cell_mellin_minor {c : ℝ}
    (hc : 0 < c) (J : ℕ) (Rsave : ℝ) :
    ∃ q : ℝ, 0 ≤ q ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (S : Finset ℕ), S ⊆ candidatePIndices c L →
      let P := fun g : S => candidatePBand (c*L) g.val
      let V := fun g : S => ∑ p ∈ P g, 1/(p : ℝ)
      ∀ (ell : ℕ) (probes : S → Finset (Fin J)) (r t : Finset S)
        (A B : Finset (RepeatedBigFlatIndex S J ell)),
        A ⊆ r.sigma (repeatedBigPrimeProbeSlots probes) → A.Nonempty →
        B ⊆ t.sigma (repeatedBigPrimeProbeSlots probes) → B.Nonempty →
      ∀ (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex S J ell) ∉ A ∪ B)
        (hAB : Disjoint A B) (k : ℤ) (Q : ℕ) (h : ℝ), 0 < h →
      ∀ (d e : ℤ) (χ ψ : BoundedPrimitiveCharacter Q) (a b v θ : ℝ),
        θ ∉ productMajorArcSet k L q (Real.exp (((d : ℝ)-1)*h))
          (Real.exp (((e : ℝ)-1)*h)) →
        ‖∑ aux : PhysicalAuxLabels P (repeatedBigAuxCut A B),
          (physicalAuxMass V (repeatedBigAuxCut A B) aux : ℂ) *
            ((starRingEnd ℂ) (primeProductCellCharacter (fun i : A => P i.val.1) h d χ
                (repeatedBigAuxSplitEquiv P A B hU hAB aux).1) *
              (starRingEnd ℂ) (primeProductCellCharacter (fun i : B => P i.val.1) h e ψ
                (repeatedBigAuxSplitEquiv P A B hU hAB aux).2)) *
            physicalPhase (-(a+b+2*Real.pi*v)) (physicalFreeFactor (repeatedBigAuxCut A B) aux) *
            fourier (-(k * (physicalFreeFactor (repeatedBigAuxCut A B) aux : ℤ)))
              (θ : AddCircle (1 : ℝ))‖ ≤ L^(-Rsave) := by
  obtain ⟨q, hq, hminor⟩ := exists_candidate_cell_minor_bound hc J Rsave
  refine ⟨q, hq, ?_⟩
  filter_upwards [hminor,
    eventually_candidate_subset_product_range hc (ε := 1) (by norm_num) J]
    with L hm hrange
  intro S hS P V ell probes r t A B hA hAne hB hBne hU hAB k Q h hh d e χ ψ a b v θ hθ
  let ζ := -(a+b+2*Real.pi*v)
  have hposA (x : ∀ i : A, P i.val.1) : 0 < ∏ i, (x i).val := by
    have hb := (hrange S hS ell probes r A hA hAne x).1
    have hp := (Real.exp_pos _).trans_le hb
    exact_mod_cast hp
  have hposB (y : ∀ i : B, P i.val.1) : 0 < ∏ i, (y i).val := by
    have hb := (hrange S hS ell probes t B hB hBne y).1
    have hp := (Real.exp_pos _).trans_le hb
    exact_mod_cast hp
  rw [← physical_aux_mellin_multiplier_split P V A B hU hAB k
    (fun x => (starRingEnd ℂ) (primeProductCellCharacter (fun i : A => P i.val.1) h d χ x))
    (fun y => (starRingEnd ℂ) (primeProductCellCharacter (fun i : B => P i.val.1) h e ψ y))
    hposA hposB ζ θ]
  exact hm S hS ell probes r t A B hA hAne hB hBne hU hAB k _ _
    (prime_cell_phased_conjugate_norm _ h d χ ζ)
    (prime_cell_phased_conjugate_norm _ h e ψ ζ)
    (Real.exp (((d : ℝ)-1)*h)) (Real.exp (((e : ℝ)-1)*h))
    (Real.exp_pos _).le (Real.exp_pos _).le
    (fun x hx => (prime_cell_phased_conjugate_range _ hh d χ ζ x (hposA x) hx).1.le)
    (fun y hy => (prime_cell_phased_conjugate_range _ hh e ψ ζ y (hposB y) hy).1.le)
    θ hθ

end Bounty
end

section

/- An equal schedule preserves the complete signed weight with its history. -/

open scoped Classical
namespace Bounty
section Schedule
variable {I K : Type} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => P g)
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → P g → ℝ) (retention : I → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

theorem physical_full_signed_weight_schedule_cast
    {steps steps' : List (Option (I ⊕ K))} (h : steps = steps')
    (x : PhysicalFullBoundedState P J ell B)
    (p : FullPermutationMixedPath (fun g (p : ↥(P g)) => p.val)
      (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j)) steps x) :
    physicalFullSignedWeight C k ω β retention ρ V steps' x
      (cast (congrArg (fun ks => FullPermutationMixedPath (fun g (p : P g) => p.val)
        (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B
        (fun j _ => PhysicalAuxLabels P (C j))
        (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j)) ks x) h) p) =
    physicalFullSignedWeight C k ω β retention ρ V steps x p := by
  cases h
  rfl

end Schedule
