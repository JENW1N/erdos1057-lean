    ((physicalPathSelectedEquiv patterns C (L, p)).2.1 j) (physicalPathSelectedMultiplier C k p j)
    (physicalPermuteLabels ((physicalPathSelectedEquiv patterns C (L, p)).2.2.2.1 j)
