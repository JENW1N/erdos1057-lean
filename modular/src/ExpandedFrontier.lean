        (fun p => physicalResidueAbsoluteHit (a d) p.1 p.2)
        (fun _ j => 1 - retention (globalBirthFiniteIndex (r + 1) j))
        (fun p => β p.1 p.2) (fun p => V p.1) (fun _ => B) (fun _ => B) (r + 1) : ℂ))‖ ^ 2 ≤
      (A ^ (r + 1)) ^ 2 * (physicalMarkMass (J := J) (ell := ell) (fun g p => β g p / V g) *
        (physicalGhostUniformEnergyBound ρ vmax v ^ (N * (r + 2)) *
          unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ (N * (r + 1)) *
          ∏ g, (∑ p, β g p / V g) ^ (J + ell))) := by
  have hV : ∀ g, 0 < V g := fun g => lt_of_lt_of_le hvmin (hVlo g)
  let w := fun d : PhysicalSelectedData P ell (fun j => C (pattern j).val) =>
    mask d * physicalSelectedCoefficient (fun j => C (pattern j).val)
      (fun j => phase (r - j.val) (pattern j).val) (fun j => K (r - j.val) (pattern j).val) d
  have hw : ∀ d ∈ S, ‖w d‖ ≤ A ^ (r + 1) := by
    intro d hd
    have hc := physical_selected_coefficient_norm_le_pow (fun j => C (pattern j).val)
      (fun j => phase (r - j.val) (pattern j).val) (fun j => K (r - j.val) (pattern j).val)
      d A (hK d hd)
    dsimp only [w]
    rw [norm_mul]
    exact (mul_le_mul (hmask d hd) hc (norm_nonneg _) zero_le_one).trans_eq (one_mul _)
  have hb := physical_selected_capped_scaled_history_sum_bound (B := B)
    (fun j => C (pattern j).val) k β V ρ
    (fun j _ aux => physicalAuxMass V (C (pattern j).val) aux) retention S w
    hP hdis (fun j _ aux => physical_aux_mass_nonneg V _ (fun g => (hV g).le) aux)
    (fun j _ => (physical_aux_mass_sum V (C (pattern j).val) hV hMass).le)
