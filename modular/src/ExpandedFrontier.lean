section

/- Uniformly bounded factor multiplicity and the prime-only base case for rough integers. -/

open Finset

namespace Bounty

theorem prime_factor_multiplicity_eq_list_length (n : ℕ) :
    primeFactorMultiplicity n = n.primeFactorsList.length := by
  rw [← ArithmeticFunction.cardFactors_apply, ArithmeticFunction.cardFactors_eq_sum_factorization]
  simp only [primeFactorMultiplicity, Finsupp.sum, Nat.support_factorization]

theorem exponential_rough_multiplicity_le {γ L C : ℝ} (hγ : 0 < γ) (hL : 0 < L)
    {n : ℕ} (hn : n ≠ 0) (hnC : (n : ℝ) ≤ Real.exp (C * L))
    (hrough : ∀ p ∈ n.primeFactors, Real.exp (γ * L) < (p : ℝ)) :
    (primeFactorMultiplicity n : ℝ) ≤ C / γ := by
  have hW : 1 < Real.exp (γ * L) := by
    simpa only [Real.exp_zero] using Real.exp_lt_exp.mpr (mul_pos hγ hL)
  have hlog : Real.log (n : ℝ) ≤ C * L := by
    simpa only [Real.log_exp] using Real.log_le_log (Nat.cast_pos.mpr (Nat.pos_of_ne_zero hn)) hnC
  calc
    _ ≤ Real.log (n : ℝ) / Real.log (Real.exp (γ * L)) :=
      multiplicity_le_log_div_of_large_primeFactors hn hW (fun p hp => (hrough p hp).le)
    _ = Real.log (n : ℝ) / (γ * L) := by rw [Real.log_exp]
    _ ≤ (C * L) / (γ * L) := div_le_div_of_nonneg_right hlog (mul_pos hγ hL).le
    _ = C / γ := by field_simp

theorem exponential_rough_factor_list_length_le {γ L C : ℝ} (hγ : 0 < γ) (hL : 0 < L)
    {n : ℕ} (hn : n ≠ 0) (hnC : (n : ℝ) ≤ Real.exp (C * L))
    (hrough : ∀ p ∈ n.primeFactors, Real.exp (γ * L) < (p : ℝ)) :
    n.primeFactorsList.length ≤ ⌊C / γ⌋₊ := by
  apply Nat.le_floor
  rw [← prime_factor_multiplicity_eq_list_length]
  exact exponential_rough_multiplicity_le hγ hL hn hnC hrough

theorem exponential_rough_band_multiplicity_le {A γ L C : ℝ} (hγ : 0 < γ) (hL : 0 < L)
    {n : ℕ} (hn : n ∈ roughBand A (Real.exp (C * L)) (Real.exp (γ * L))) :
    (primeFactorMultiplicity n : ℝ) ≤ C / γ := by
  classical
  have hnC : (n : ℝ) ≤ Real.exp (C * L) :=
    (Nat.cast_le.mpr (mem_Ioc.mp (mem_filter.mp hn).1).2).trans
      (Nat.floor_le (Real.exp_nonneg _))
  exact exponential_rough_multiplicity_le hγ hL (roughBand_pos hn).ne' hnC (mem_filter.mp hn).2

theorem rough_band_prime_of_upper_le_cutoff_sq {A B z : ℝ}
    (hA : 1 ≤ A) (hB : 0 ≤ B) (hz : 0 ≤ z) (hBz : B ≤ z ^ 2)
    {n : ℕ} (hn : n ∈ roughBand A B z) : n.Prime := by
  classical
  have hn0 := roughBand_pos hn
  have hAn : A < (n : ℝ) := Nat.lt_of_floor_lt (mem_Ioc.mp (mem_filter.mp hn).1).1
  have hn1 : n ≠ 1 := by
    intro he
    subst n
    norm_num at hAn
    linarith
  have hnB : (n : ℝ) ≤ B :=
    (Nat.cast_le.mpr (mem_Ioc.mp (mem_filter.mp hn).1).2).trans (Nat.floor_le hB)
  have hmin : z < (n.minFac : ℝ) :=
    (mem_filter.mp hn).2 n.minFac
      (Nat.mem_primeFactors.mpr ⟨Nat.minFac_prime hn1, Nat.minFac_dvd n, hn0.ne'⟩)
  by_contra hprime
  have hsq : (n.minFac : ℝ) ^ 2 ≤ n := by
    exact_mod_cast Nat.minFac_sq_le_self hn0 hprime
  nlinarith

theorem rough_band_eq_prime_band_of_upper_le_cutoff_sq {A B z : ℝ}
    (hA : 1 ≤ A) (hz : 0 ≤ z) (hBz : B ≤ z ^ 2) :
    roughBand A B z = primeBand (max A z) B := by
  classical
  by_cases hB : 0 ≤ B
  · rw [← prime_part_of_rough_band (by linarith : 0 ≤ A) hB]
    exact (filter_true_of_mem (fun n hn =>
      rough_band_prime_of_upper_le_cutoff_sq hA hB hz hBz hn)).symm
  · have hB0 : ⌊B⌋₊ = 0 := Nat.floor_of_nonpos (le_of_not_ge hB)
    have hzero (m : ℕ) : Ioc m 0 = ∅ := Ioc_eq_empty_of_le (Nat.zero_le m)
    simp only [roughBand, primeBand, hB0, hzero, filter_empty]

end Bounty

end

section

/- The storage-only transpose on the full active space. Shared labels and
auxiliary choices are retained on both sides; the local action includes both
total-memory caps. Auxiliary weights may be signed for this exact identity. -/

open Finset Classical

namespace Bounty

section

variable {G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
  {A : SharedActiveLabels P S → Type*} [∀ c, Fintype (A c)]
  (Δ D : ∀ c, A c → G → ℤ) (ω : ∀ c, A c → ℝ)
  (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)

noncomputable def fullActiveStorageOnly :=
  fullActiveMemoryAverage S B ω (fun c a => unrestrictedStorageOnlyProduct n
    (Δ c a) (D c a) μ ρ V (fun g => (S g)ᶜ.card) B)

noncomputable def fullActiveReversePromotionOnly :=
  fullActiveMemoryAverage S B ω (fun c a => unrestrictedReversePromotionOnlyProduct n
    (Δ c a) (D c a) μ ρ V (fun g => (S g)ᶜ.card) B)

theorem full_active_storage_only_symmetric
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric (fullActiveStorageOnly n S B Δ D ω μ ρ V f) := by
  exact full_active_memory_average_symmetric S B ω _
    (fun c a g hg => unrestricted_storage_only_product_symmetric n (Δ c a) (D c a)
      μ ρ V (fun j => (S j)ᶜ.card) B g hg) f hf

theorem full_active_reverse_promotion_only_symmetric
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric (fullActiveReversePromotionOnly n S B Δ D ω μ ρ V f) := by
  exact full_active_memory_average_symmetric S B ω _
    (fun c a g hg => unrestricted_reverse_promotion_only_product_symmetric n (Δ c a) (D c a)
      μ ρ V (fun j => (S j)ᶜ.card) B g hg) f hf

/-- Exact full-space weighted bilinear identity; no dimension factor or
renormalization of shared or auxiliary coordinates is introduced. -/
theorem full_active_storage_only_pairing
    (hV : ∀ g, V g ≠ 0)
    (f g : ProductBoundedOrderedState P (fun j => UnrestrictedResidueParticle (n j)) M B → ℂ)
    (hf : ProductMemorySymmetric f) (hg : ProductMemorySymmetric g) :
    (∑ s, (productMemoryWeight μ (fun j => unrestrictedResidueWeight (μ j)) s : ℂ) *
      f s * fullActiveStorageOnly n S B Δ D ω μ ρ V g s) =
    ∑ s, (productMemoryWeight μ (fun j => unrestrictedResidueWeight (μ j)) s : ℂ) *
      fullActiveReversePromotionOnly n S B Δ D ω μ ρ V f s * g s := by
  apply equiv_fiber_average_pairing (productActiveMemorySplit S B)
    (productMemoryWeight μ (fun j => unrestrictedResidueWeight (μ j)))
    (sharedActiveWeight S μ) (productMemoryWeight μ (fun j => unrestrictedResidueWeight (μ j)))
    (productActiveMemorySplit_weight_symm S B μ (fun j => unrestrictedResidueWeight (μ j)))
    ω (fun c a => unrestrictedStorageOnlyProduct n (Δ c a) (D c a) μ ρ V
      (fun j => (S j)ᶜ.card) B)
    (fun c a => unrestrictedReversePromotionOnlyProduct n (Δ c a) (D c a) μ ρ V
      (fun j => (S j)ᶜ.card) B) f g
  intro c a
  exact unrestricted_storage_only_product_pairing n (Δ c a) (D c a) μ ρ V
    (fun j => (S j)ᶜ.card) B hV _ _
    (productActiveMemorySlice_symmetric S B f hf c)
    (productActiveMemorySlice_symmetric S B g hg c)

end

end Bounty
end

section

/- Both members of the storage/reverse-promotion transpose pair satisfy the
same proved unrestricted product energy constant. This prepares the reverse
promotion operator for the sparse omitted-label average. -/

open Finset Classical

namespace Bounty

section

variable {G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  (Δ D : G → ℤ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (t : G → ℕ) (B : ℕ)

theorem unrestricted_storage_only_product_energy_le
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, t g ≤ T)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (unrestrictedStorageOnlyProduct n Δ D μ ρ V t B f) ≤
      unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  exact unrestricted_coupled_cutoff_product_energy_le n Δ D μ ρ V t B
    hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht _
    (by intros; split_ifs <;> norm_num) f hf

theorem unrestricted_reverse_promotion_only_product_energy_le
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, t g ≤ T)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (unrestrictedReversePromotionOnlyProduct n Δ D μ ρ V t B f) ≤
      unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  apply finite_symmetric_transpose_energy_le
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productMemoryWeight_nonneg μ (fun g => unrestrictedResidueWeight (μ g))
      hμ (fun g z => hμ g z.1)) ProductMemorySymmetric
    (unrestrictedReversePromotionOnlyProduct n Δ D μ ρ V t B)
    (unrestrictedStorageOnlyProduct n Δ D μ ρ V t B)
  · intro q hq x i τ
    dsimp only
    rw [hq x i τ]
  · exact unrestricted_reverse_promotion_only_product_symmetric n Δ D μ ρ V t B
  · intro q r hq hr
    have hp := unrestricted_storage_only_product_pairing n Δ D μ ρ V t B
      (fun g => (hvmin.trans_le (hVlo g)).ne') r q hr hq
    simpa only [mul_assoc, mul_comm, mul_left_comm] using hp.symm
  · exact pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _
  · exact unrestricted_storage_only_product_energy_le n Δ D μ ρ V t B
      hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht
  · exact hf

end

end Bounty
end

section

/- Promotion rarity and the actual capped operator energy bound for the
candidate prime pools. All prime-separation and short-step nondivisibility
conditions are derived; pending and active big labels remain unrestricted. -/

open Finset Filter
open scoped Classical Topology

namespace Bounty

abbrev CandidateBigGroup (s L : ℝ) := ↥(candidateBigPIndices s L)
abbrev CandidateBigLabel (s L : ℝ) (g : CandidateBigGroup s L) :=
  ↥(candidatePBand (s * L) g.val)

def candidateBigModulus (s L : ℝ) (g : CandidateBigGroup s L)
    (p : CandidateBigLabel s L g) : ℕ := p.val

theorem candidateBigModulusNeZero (s L : ℝ) :
    ∀ g p, NeZero (candidateBigModulus s L g p) :=
  fun g p => ⟨((mem_dyadicPrimeBand_iff (s * L) (3/2) (9/5) g.val p.val).mp p.property).1.ne_zero⟩

theorem eventually_candidate_promotion_energy_le {s : ℝ} (hs : 0 < s)
    (ell : ℕ) (C₂ : ℝ) :
    ∀ᶠ L : ℝ in atTop,
      letI : ∀ g p, NeZero (candidateBigModulus s L g p) := candidateBigModulusNeZero s L
      ∀ J B : ℕ,
      ∀ labels : PhysicalMarkLists
        (fun g : ↥(candidateSmallPIndices s L) => candidatePBand (s * L) g.val) J ell,
      ∀ D_B : ℕ, ∀ k : ℤ, k ≠ 0 → (k.natAbs : ℝ) ≤ L ^ C₂ →
      ∀ μ : ∀ g, CandidateBigLabel s L g → ℝ, ∀ ρ : ℝ,
      ∀ V : CandidateBigGroup s L → ℝ, ∀ t : CandidateBigGroup s L → ℕ,
      ∀ v vmin vmax : ℝ, 0 < ρ → ρ < 1 → 1 < v → 0 < vmin →
      (∀ g, vmin ≤ V g) → (∀ g, V g ≤ vmax) →
      (∀ g p, 0 ≤ μ g p) → (∀ g, ∑ p, μ g p ≤ 2) →
      ∀ T : ℕ, (∀ g, t g ≤ T) →
      ∀ phase : ∀ σ : ↥(candidateSmallPIndices s L) → Equiv.Perm (PhysicalSlots J ell),
        UnrestrictedProductPhase (candidateBigModulus s L)
          (fun _ => -(k * (smallSourcePermutationDilation labels D_B σ : ℤ)))
          (fun _ => (smallSourcePermutationDilation labels D_B σ : ℤ)) t B,
      (∀ σ state e, ‖phase σ state e‖ ≤ 1) →
      ∀ f : ProductBoundedOrderedState (CandidateBigLabel s L)
        (fun g => UnrestrictedResidueParticle (candidateBigModulus s L g)) t B → ℂ,
      ProductMemorySymmetric f →
      finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
        (smallSourcePromotionAverage (candidateBigModulus s L) labels D_B k μ ρ V t B phase f) ≤
      ((B : ℝ) / (((J + ell).choose ell) ^ (candidateSmallPIndices s L).card : ℕ)) *
        unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ (candidateBigPIndices s L).card *
