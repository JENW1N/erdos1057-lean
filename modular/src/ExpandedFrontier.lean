/- The proved candidate truncation errors survive the original normalized finite sums. -/

open Finset MeasureTheory Filter

namespace Bounty

theorem exists_candidate_energy_fourier_truncation
    {c q K₀ Cz A D : ℝ} (hc : 0 < c) (hq0 : 0 ≤ q) (hq1 : q < 1) (hCz : 0 ≤ Cz) :
    ∃ F : ℝ, 0 < F ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (r jStar : ℕ) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
        (take : Fin ((candidateQIndices c L).card*r) → Bool),
      take ((candidateAllocationOrder c L r).symm
        (candidateRoughSlot c L r jStar hr hj)) = false →
      ∀ (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ),
      (∀ slot p, p ∈ candidateQSlotChoices c L r jStar slot → ‖twist slot p‖ ≤ 1) →
      ∀ (U V E : ℝ) (B : ℕ), 0 < U → 0 < V → E = U*L^(-K₀) → 4 ≤ U*V →
      max 1 (B:ℝ) ≤ typeIISmoothDyadicScale U V E 0 →
      Real.log (24*U^2*V*L^88/E) ≤ Cz*L →
      ∀ (M H : Finset ℕ) (α : ℕ → ℂ) (ρ : ℝ),
      (∀ m ∈ M, (m:ℝ) ∈ Set.Icc U (2*U)) → (∀ m ∈ M, ‖α m‖ ≤ L^A) →
      (∀ h ∈ H, 0 < h) →
      let aH : ℕ → ℂ := fun h => typeIIPhase ρ h *
        candidateRetainedComplexCoefficient c L q r jStar take twist h
      ‖typeIIEnergyFourierIntegral L U V E B M H α aH Set.univ -
        typeIIEnergyFourierIntegral L U V E B M H α aH
          {ξ : EuclideanSpace ℝ (Fin 3) | ‖ξ‖ ≤ L^F}‖ ≤
        (2*(B:ℝ)) * (∑ j ∈ range (typeIISmoothDyadicCount L), typeIISmoothDyadicScale U V E j) * L^(-D) := by
  classical
  obtain ⟨F, hF, hcut⟩ := exists_candidate_smooth_cross_fourier_truncation_full_support
    (K₀ := K₀) (A := A) (D := D) hc hq0 hq1 hCz
  refine ⟨F, hF, ?_⟩
  filter_upwards [hcut, eventually_ge_atTop (1:ℝ)] with L hcut hL
  intro r jStar hr hj take hkeep twist htwist U V E B hU hV hE hUV hZmin hZlog M H α ρ hM hα hH
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hE0 : 0 < E := by rw [hE]; positivity
  apply typeII_energy_fourier_difference_le L U V E B M H α _ _ _
    (Real.rpow_nonneg hL0.le _)
    (fun j _ => (typeII_smooth_dyadic_scale_pos hU hV hE0 j).le)
  intro k hk hk0 j hjmem χ
  dsimp only
  let M₀ := M.filter (fun m => α m ≠ 0)
  let Zs := Icc 0 (M₀.sup id * H.sup id)
  let Z := typeIISmoothDyadicScale U V E j
  have hZ0 : 0 < Z := typeII_smooth_dyadic_scale_pos hU hV hE0 j
  have hZlo : max 1 (B:ℝ) ≤ Z :=
    hZmin.trans (typeII_smooth_dyadic_scale_mono_zero hU hV hE0 j)
  have hZupper : Z ≤ 24*U^2*V*L^88/E :=
    typeII_smooth_dyadic_scale_le hL hU hV hE0 (mem_range.mp hjmem)
  have hkB : |(k:ℝ)| ≤ B := by
    have hki : |k| ≤ (B:ℤ) := abs_le.mpr (mem_Icc.mp hk)
    exact_mod_cast hki
  have hM₀ : ∀ m ∈ M₀, (m:ℝ) ∈ Set.Icc U (2*U) :=
    fun m hm => hM m (mem_filter.mp hm).1
  let aH : ℕ → ℂ := fun h => typeIIPhase ρ h *
    candidateRetainedComplexCoefficient c L q r jStar take twist h
  have ht := hcut r jStar hr hj take hkeep twist htwist U V E Z k hU hV
    ((le_max_left _ _).trans hZlo) hk0 hE (by linarith) hZupper
    ((Real.log_le_log hZ0 hZupper).trans hZlog)
    (hkB.trans ((le_max_right _ _).trans hZlo)) M₀ H Zs α ρ χ hM₀
    (fun m hm => hα m (mem_filter.mp hm).1) hH
  have hexact := typeII_smooth_dyadic_character_cross_fourier_integral L U V E Z k M₀ H Zs α aH χ
    hU hV hZ0 hk0 hM₀
  dsimp only at ht
  rw [hexact.2] at ht
  simpa only [Measure.restrict_univ] using ht.2

end Bounty
end

