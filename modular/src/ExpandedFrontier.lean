  | some (.inl _), _, _ => 1
  | some (.inr j), s, e =>
      physicalActiveCoefficient (cut (4 * j.val + 2)) (cut (4 * j.val + 3))
        (C j) (ζ j) (K j) (fun g => (s.2 g).1)
        (fun g => ((physicalFullLedgerEventTarget C k (some (.inr j)) s e).2 g).1) e.1

