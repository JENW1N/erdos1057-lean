section

/- The exact raw shared-draw formula also retains shared-dependent phases,
position guards, and auxiliary-label exclusions. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_normalized_cut_sum_eq_raw_draws {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {J ell : ℕ} (C : G → Finset (Fin J)) (V : G → ℝ)
    (F : GroupMarkedLists P (fun g => ell + (C g).card) →
      GroupMarkedLists P (fun g => ell + (C g).card) →
      PhysicalAuxLabels P (fun g => univ \ C g) → ℂ) :
    (∑ L : PhysicalMarkLists P J ell, ∑ R : PhysicalMarkLists P J ell,
      if physicalSharedCompatible C L R then
        ((physicalStateMass V J ell * physicalCompletionMass V C ell /
          (physicalSharedFactor C L : ℝ) : ℝ) : ℂ) *
          F (physicalGroupUnsharedEmbedding C L) (physicalGroupUnsharedEmbedding C R)
            (physicalSharedAux C L) else 0) =
      ∑ u : GroupMarkedLists P (fun g => ell + (C g).card),
      ∑ v : GroupMarkedLists P (fun g => ell + (C g).card),
      ∑ s : PhysicalAuxLabels P (fun g => univ \ C g),
        if physicalRawCutGood C u v s then
          ((physicalAuxMass V (fun g => univ \ C g) s *
            physicalCompletionMass V C ell ^ 2 : ℝ) : ℂ) * F u v s else 0 := by
  have haux (d : PhysicalJointCutData P C ell) :
      physicalSharedAux C (physicalCutGlue C d.1 d.2.1) = fun g j => d.1 g j := by
    simpa only [physical_cut_pair_inverse_left] using physical_cut_pair_inverse_shared_aux C d
  rw [physical_joint_normalized_sum_eq_shared_draw_sum]
  simp only [physical_cut_glue_unshared, haux]
  exact physical_joint_cut_sum_eq_raw_sum P C
    (fun u v s => ((physicalAuxMass V (fun g => univ \ C g) s *
      physicalCompletionMass V C ell ^ 2 : ℝ) : ℂ) * F u v s)

end Bounty
end

section

/- The shared-exclusion loss after both conditional marked-list averages. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_cut_shared_pair_average_error {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (hprime : ∀ g p, p ∈ P g → p.Prime) (V : G → ℝ)
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (aux : PhysicalAuxLabels P C) {w z : ℕ} (hw : 0 < w) (hz : 0 < z)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (b : GroupMarkedLists P (fun g => ell + (C g).card) →
      GroupMarkedLists P (fun g => ell + (C g).card) → ℂ)
    {H : ℝ} (hH : 0 ≤ H)
    (hb : ∀ (u : GroupMarkedListsAt P (fun g => ell + (C g).card) (w : ℤ))
      (v : GroupMarkedListsAt P (fun g => ell + (C g).card) (z : ℤ)), ‖b u.val v.val‖ ≤ H) :
    ‖groupMarkedAverage P (fun g => ell + (C g).card) (w : ℤ) (fun u =>
        groupMarkedAverage P (fun g => ell + (C g).card) (z : ℤ) (fun v =>
          ∑ s : PhysicalAuxLabels P (fun g => univ \ C g),
            if physicalRawCutGood C u v s then
              if ∀ g j, s g j ∉ physicalSharedForbidden C aux g w z
                then (physicalAuxMass V (fun g => univ \ C g) s : ℂ) * b u v else 0
            else 0)) -
      groupMarkedAverage P (fun g => ell + (C g).card) (w : ℤ)
        (fun u => groupMarkedAverage P (fun g => ell + (C g).card) (z : ℤ) (b u))‖ ≤
      (∑ g, (J - (C g).card : ℕ) *
        (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) / (V g * Pmin)) * H := by
  have hwL : 0 ≤ Real.log (w : ℝ) := Real.log_nonneg (by exact_mod_cast (show 1 ≤ w from hw))
  have hzL : 0 ≤ Real.log (z : ℝ) := Real.log_nonneg (by exact_mod_cast (show 1 ≤ z from hz))
  have hδ : 0 ≤ ∑ g, (J - (C g).card : ℕ) *
      (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) / (V g * Pmin) := by
    apply sum_nonneg
    intro g _
    have hv0 := (hV g).le
    positivity
  simp only [← group_marked_average_sub]
  apply group_marked_pair_average_norm_le P (fun g => ell + (C g).card) (w : ℤ) (z : ℤ)
    _ (mul_nonneg hδ hH)
  intro u v
  have hu : ∀ g i, (u.val g i).val ∣ w := by
    intro g i
    exact_mod_cast u.property g i
  have hv : ∀ g i, (v.val g i).val ∣ z := by
    intro g i
    exact_mod_cast v.property g i
  exact (physical_cut_shared_constant_error C hprime V hV hMass u.val v.val aux
    hw hz hu hv hPmin hp (b u.val v.val)).trans
      (mul_le_mul_of_nonneg_left (hb u v) hδ)

end Bounty
end

section

/- The bad-draw probability bound after both actual marked-list averages. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_shared_error_factor_nonneg {G : Type*} [Fintype G]
    {J : ℕ} (C : G → Finset (Fin J)) (V : G → ℝ) (hV : ∀ g, 0 ≤ V g)
    {w z : ℕ} (hw : 0 < w) (hz : 0 < z) {Pmin : ℝ} (hPmin : 0 ≤ Pmin) :
    0 ≤ ∑ g, (J - (C g).card : ℕ) *
      (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) / (V g * Pmin) := by
  have hwL : 0 ≤ Real.log (w : ℝ) := Real.log_nonneg (by exact_mod_cast (show 1 ≤ w from hw))
  have hzL : 0 ≤ Real.log (z : ℝ) := Real.log_nonneg (by exact_mod_cast (show 1 ≤ z from hz))
  apply sum_nonneg
  intro g _
  have hv0 := hV g
  positivity

theorem physical_bad_constant_pair_mean_norm_le {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (aux : PhysicalAuxLabels P C) {w z : ℕ} (hw : 0 < w) (hz : 0 < z)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    {B : ℝ} (hB : 0 ≤ B) :
    ‖groupMarkedAverage P (fun g => ell + (C g).card) (w : ℤ) (fun u =>
      groupMarkedAverage P (fun g => ell + (C g).card) (z : ℤ) (fun v =>
        ∑ s : PhysicalAuxLabels P (fun g => univ \ C g),
          if physicalRawCutGood C u v s ∧
            ¬(∀ g j, s g j ∉ physicalSharedForbidden C aux g w z)
          then (physicalAuxMass V (fun g => univ \ C g) s : ℂ) * (B : ℂ) else 0))‖ ≤
      (∑ g, (J - (C g).card : ℕ) *
        (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) / (V g * Pmin)) * B := by
  apply group_marked_pair_average_norm_le P (fun g => ell + (C g).card) (w : ℤ) (z : ℤ)
    _ (mul_nonneg (physical_shared_error_factor_nonneg C V (fun g => (hV g).le) hw hz hPmin.le) hB)
  intro u v
  apply physical_bad_cut_mean_norm_le V C hV hMass u.val v.val aux hw hz hPmin hp (fun _ => (B : ℂ)) hB
  intro s _
  simp only [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hB, le_refl]

end Bounty
end

section

/- Separation and conjugation for the actual finite marked-list averages. -/

open Finset
open scoped Classical
namespace Bounty

theorem group_marked_average_mul_right {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (t : G → ℕ) (n : ℤ)
    (b : GroupMarkedLists P t → ℂ) (c : ℂ) :
    groupMarkedAverage P t n (fun L => b L * c) =
      groupMarkedAverage P t n b * c := by
  simpa only [mul_comm] using group_marked_average_mul_left P t n c b

theorem group_marked_pair_average_separate {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (t : G → ℕ) (w z : ℤ)
    (a b : GroupMarkedLists P t → ℂ) :
    groupMarkedAverage P t w (fun u =>
      groupMarkedAverage P t z (fun v => a u * b v)) =
      groupMarkedAverage P t w a * groupMarkedAverage P t z b := by
  simp only [group_marked_average_mul_left, group_marked_average_mul_right]

theorem group_marked_average_star {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (t : G → ℕ) (n : ℤ) (b : GroupMarkedLists P t → ℂ) :
    groupMarkedAverage P t n (fun L => star (b L)) = star (groupMarkedAverage P t n b) := by
  simp only [groupMarkedAverage, star_mul, star_inv₀, star_natCast, star_sum, mul_comm]

end Bounty
end

section

/- A rational gcd slice acts on the full residual, separately from its prime-pool cutoff. -/

open Finset

namespace Bounty

noncomputable def rationalResidualGcdMultiplier (r d : ℕ)
    (ψ : AddChar (Additive (ZMod (r/d))ˣ) ℂ) (n : ℕ) : ℂ :=
  if n.gcd r = d then unitAddCharDirichlet ψ ((n/d : ℕ) : ZMod (r/d)) else 0

theorem rational_residual_gcd_multiplier_norm_le (r d : ℕ)
    (ψ : AddChar (Additive (ZMod (r/d))ˣ) ℂ) (n : ℕ) :
    ‖rationalResidualGcdMultiplier r d ψ n‖ ≤ 1 := by
  unfold rationalResidualGcdMultiplier
  split_ifs
  · exact (unitAddCharDirichlet ψ).norm_le_one _
  · simp only [norm_zero, zero_le_one]

theorem rational_residual_gcd_filtered_sum (r d : ℕ)
    (ψ : AddChar (Additive (ZMod (r/d))ˣ) ℂ)
    (F : Finset ℕ) (a w : ℕ → ℂ) :
    (∑ n ∈ F.filter (fun n => n.gcd r = d),
      a n * unitAddCharDirichlet ψ ((n/d : ℕ) : ZMod (r/d)) * w n) =
      ∑ n ∈ F, a n * rationalResidualGcdMultiplier r d ψ n * w n := by
  rw [sum_filter]
  apply sum_congr rfl
  intro n _
  by_cases hn : n.gcd r = d
  · simp only [rationalResidualGcdMultiplier, hn, if_true]
  · simp only [rationalResidualGcdMultiplier, hn, if_false, mul_zero, zero_mul]

noncomputable def rationalProductCharacter (r d : ℕ) {q : ℕ}
    (χ : DirichletCharacter ℂ q) (ψ : AddChar (Additive (ZMod (r/d))ˣ) ℂ) :
    DirichletCharacter ℂ (q*(r/d)) :=
  χ.changeLevel (Nat.dvd_mul_right q (r/d)) *
    (unitAddCharDirichlet ψ).changeLevel (Nat.dvd_mul_left (r/d) q)

theorem rational_product_character_apply (r d : ℕ) {q : ℕ}
    (χ : DirichletCharacter ℂ q) (ψ : AddChar (Additive (ZMod (r/d))ˣ) ℂ) (n : ℕ) :
    rationalProductCharacter r d χ ψ (n : ZMod (q*(r/d))) =
      χ (n : ZMod q) * unitAddCharDirichlet ψ (n : ZMod (r/d)) :=
  product_level_characters_nat_apply χ (unitAddCharDirichlet ψ) n

theorem rational_product_modulus_power_bound {L A B : ℝ} (hL : 0 < L)
    {q r d : ℕ} (hq : (q : ℝ) ≤ L^A) (hr : (r : ℝ) ≤ L^B) :
    ((q*(r/d) : ℕ) : ℝ) ≤ L^(A+B) := by
  apply product_modulus_power_bound hL hq
  exact (Nat.cast_le.mpr (Nat.div_le_self r d)).trans hr

theorem candidate_selected_residual_full_multiplier
    (c L q : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm
      (candidateRoughSlot c L r jStar hr hj)) = false)
    (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ)
    (t u : candidatePIndices c L → ℕ) (big : Finset (candidatePIndices c L))
    (b : GroupMarkedLists (fun g : big => candidatePBand (c*L) g.val.val)
      (fun g : big => u g.val) → ℂ) (κ θ ρ : ℕ → ℂ) (n : ℕ) :
    candidateSelectedResidualCoefficient c L q r jStar hr hj take hkeep ξ
      t u big b κ (fun n => θ n*ρ n) n =
      candidateSelectedResidualCoefficient c L q r jStar hr hj take hkeep ξ
        t u big b κ θ n * ρ n := by
  unfold candidateSelectedResidualCoefficient
  ring

end Bounty
end

section

/- The actual alternating selected visit/edge schedule for a fixed original path. -/

open scoped Classical

namespace Bounty

noncomputable def physicalMarkAtCut {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    (L : Fin (n + 1) → PhysicalMarkLists P J ell) (i : ℕ) : PhysicalMarkLists P J ell :=
  L ⟨min (i / 2) n, Nat.lt_succ_of_le (min_le_right _ _)⟩

theorem physical_mark_at_cut_even {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    (L : Fin (n + 1) → PhysicalMarkLists P J ell) (j : Fin (n + 1)) :
    physicalMarkAtCut L (2 * j.val) = L j := by
  unfold physicalMarkAtCut
  congr 1
  apply Fin.ext
  have := j.isLt
  dsimp
  omega

theorem physical_mark_at_cut_odd {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    (L : Fin (n + 1) → PhysicalMarkLists P J ell) (j : Fin (n + 1)) :
    physicalMarkAtCut L (2 * j.val + 1) = L j := by
  unfold physicalMarkAtCut
  congr 1
  apply Fin.ext
  have := j.isLt
  dsimp
  omega

section Schedule
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (β : (g : Fin N) → ↥(P g) → ℝ) (V : Fin N → ℝ) (ρ : ℝ)
  (hV : ∀ g, V g ≠ 0)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)

noncomputable def physicalSelectedCoarseRow (i : ℕ)
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    PhysicalBoundedMarkState P J ell B → ℂ :=
  if hi : i < 2 * n + 1 then
    if he : i % 2 = 0 then
      let j : Fin (n + 1) := ⟨i / 2, by omega⟩
      physicalObservedMarkRow C k ω β retention ρ V hV (some (.inl j))
        (fun o t => if o = .inr none ∧ t.1 = L j then F t else 0)
    else
      let j : Fin n := ⟨i / 2, by omega⟩
      physicalSelectedStateEdgeBlock C k ω β retention ρ V hV j (aux j) (σ j) (τ j)
        (L j.succ) F
  else fun _ => 0

noncomputable def physicalSelectedCoarseScalar (i : ℕ) : ℂ :=
  if hi : i < 2 * n + 1 then
    if he : i % 2 = 0 then 1
    else
      let j : Fin n := ⟨i / 2, by omega⟩
      (((Fintype.card (PhysicalPermutations (Fin N) J ell) : ℝ)⁻¹ : ℂ) ^ 2) *
        (ω j (physicalSharedMarkLabels (C j) (physicalPermuteLabels (σ j) (L j.castSucc)))
          (aux j) : ℂ)
  else 1

theorem physical_selected_coarse_row_even (j : Fin (n + 1))
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    physicalSelectedCoarseRow C aux k L σ τ β V ρ hV ω retention (2 * j.val) F =
      physicalObservedMarkRow C k ω β retention ρ V hV (some (.inl j))
        (fun o t => if o = .inr none ∧ t.1 = L j then F t else 0) := by
  have hj := j.isLt
  have hi : 2 * j.val < 2 * n + 1 := by omega
  have he : (2 * j.val) % 2 = 0 := by omega
  have hd : (2 * j.val) / 2 = j.val := by omega
  have hjEq (h : (2 * j.val) / 2 < n + 1) : (⟨(2 * j.val) / 2, h⟩ : Fin (n + 1)) = j := Fin.ext hd
  unfold physicalSelectedCoarseRow
  rw [dif_pos hi, dif_pos he]
  simp only [hjEq]
  congr 1
  funext o t
  split_ifs <;> rfl

theorem physical_selected_coarse_row_odd (j : Fin n)
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    physicalSelectedCoarseRow C aux k L σ τ β V ρ hV ω retention (2 * j.val + 1) F =
      physicalSelectedStateEdgeBlock C k ω β retention ρ V hV j (aux j) (σ j) (τ j)
        (L j.succ) F := by
  have hj := j.isLt
  have hi : 2 * j.val + 1 < 2 * n + 1 := by omega
  have he : ¬ (2 * j.val + 1) % 2 = 0 := by omega
  have hd : (2 * j.val + 1) / 2 = j.val := by omega
  have hjEq (h : (2 * j.val + 1) / 2 < n) : (⟨(2 * j.val + 1) / 2, h⟩ : Fin n) = j := Fin.ext hd
  unfold physicalSelectedCoarseRow
  rw [dif_pos hi, dif_neg he]
  exact congrArg (fun t : Fin n =>
    physicalSelectedStateEdgeBlock C k ω β retention ρ V hV t (aux t) (σ t) (τ t)
      (L t.succ) F) (hjEq _)

theorem physical_selected_coarse_scalar_even (j : Fin (n + 1)) :
    physicalSelectedCoarseScalar C aux L σ ω (2 * j.val) = 1 := by
  have hj := j.isLt
  have hi : 2 * j.val < 2 * n + 1 := by omega
  have he : (2 * j.val) % 2 = 0 := by omega
  simp only [physicalSelectedCoarseScalar, dif_pos hi, dif_pos he]

theorem physical_selected_coarse_scalar_odd (j : Fin n) :
    physicalSelectedCoarseScalar C aux L σ ω (2 * j.val + 1) =
      (((Fintype.card (PhysicalPermutations (Fin N) J ell) : ℝ)⁻¹ : ℂ) ^ 2) *
        (ω j (physicalSharedMarkLabels (C j) (physicalPermuteLabels (σ j) (L j.castSucc)))
          (aux j) : ℂ) := by
  have hj := j.isLt
  have hi : 2 * j.val + 1 < 2 * n + 1 := by omega
  have he : ¬ (2 * j.val + 1) % 2 = 0 := by omega
  have hd : (2 * j.val + 1) / 2 = j.val := by omega
  have hjEq (h : (2 * j.val + 1) / 2 < n) : (⟨(2 * j.val + 1) / 2, h⟩ : Fin n) = j := Fin.ext hd
  unfold physicalSelectedCoarseScalar
  rw [dif_pos hi, dif_neg he]
  exact congrArg (fun t : Fin n =>
    (((Fintype.card (PhysicalPermutations (Fin N) J ell) : ℝ)⁻¹ : ℂ) ^ 2) *
      (ω t (physicalSharedMarkLabels (C t) (physicalPermuteLabels (σ t) (L t.castSucc)))
        (aux t) : ℂ)) (hjEq _)

end Schedule
end Bounty
end

section

/- A uniform pair-count bound normalized by the actual candidate marked harmonic mass. -/

open Finset Filter
open scoped Topology

namespace Bounty

theorem exists_candidate_masked_pair_bound :
    ∃ K : ℝ, 0 < K ∧ ∀ (γ q : ℝ), 0 < γ → 0 ≤ q → q ≤ 1 →
      ∀ᶠ L : ℝ in atTop, ∀ (a b c d m : ℕ) [NeZero m] (W z : ℝ) (P : Finset ℕ),
        (m : ℝ) ≤ Real.exp L → (∀ p ∈ m.primeFactors, L^2 ≤ (p : ℝ)) →
        a ≤ b → c ≤ d → 0 ≤ W → W ≤ z → 1 < z →
        P ⊆ (candidatePIndices γ L).biUnion (candidatePBand (γ*L)) →
        (∑ S ∈ P.powerset, bernoulliSubsetWeight q P S *
          ((maskedPairBox a b c d m W z S).card : ℝ)) ≤
          K * (((b : ℝ)-a)*((d : ℝ)-c)/(m : ℝ)) *
            (∏ p ∈ primeBand 0 W, (1 - 1/(p : ℝ)))^2 *
            (∏ p ∈ primeBand 0 z, (1 - 1/(p : ℝ))) *
            candidateOneMarkedHarmonicMass γ L q +
          ((m : ℝ)*(z^(10 : ℝ))^3 + (((b : ℝ)-a)+((d : ℝ)-c))*(z^(10 : ℝ))^2) := by
  obtain ⟨K, hK, hb⟩ := exists_masked_pair_average_upper
  refine ⟨K, hK, ?_⟩
  intro γ q hγ hq0 hq1
  obtain ⟨v, V, hv, _, hpool⟩ := exists_candidate_P_pool_bounds hγ
  filter_upwards [eventually_candidate_mask_inverse_bound hγ hq0 hq1, hpool,
    eventually_ge_atTop (1 : ℝ)] with L hmask hp hL
  rcases hp with ⟨_, _, _, _, _, hdata⟩
  intro a b c d m hm W z P hmL hmin hab hcd hW hWz hz hP
  have hP2 : ∀ p ∈ P, 2 ≤ p := by
    intro p hp
    obtain ⟨j, hj, hpj⟩ := mem_biUnion.mp (hP hp)
    exact (((hdata j hj).2.2 p hpj).1).two_le
  have h := hb L a b c d m W z q P hL hmL hmin hab hcd hW hWz hz hq0 hq1 hP2
  have he := hmask P hP
  rw [bernoulli_mask_inverse_avoidance P q hP2] at he
  have hX : 0 ≤ (b : ℝ)-a := sub_nonneg.mpr (Nat.cast_le.mpr hab)
  have hY : 0 ≤ (d : ℝ)-c := sub_nonneg.mpr (Nat.cast_le.mpr hcd)
  have hV : 0 ≤ ∏ p ∈ primeBand 0 z, (1 - 1/(p : ℝ)) := Finset.prod_nonneg (fun p hp =>
    (avoidance_factor_bounds ((mem_primeBand_iff le_rfl (zero_lt_one.trans hz).le p).mp hp).1.two_le).1.le)
  apply h.trans
  exact add_le_add (mul_le_mul_of_nonneg_left he (by positivity)) le_rfl

end Bounty
end

section

/- The local norm bound in the exact finite pattern-family form consumed by
CleanHybridUnbannedBound. The raw row and alternating comparison signs remain explicit. -/

open Finset Filter
open scoped Classical

namespace Bounty

theorem eventually_repeated_big_prime_pattern_norm_le
    (hZ : PrimitiveZeroFreeHalfPlane) (c s z a v D ε : ℝ) (m : ℕ)
    (hc : 0 < c) (hs : 0 ≤ s) (hz : 0 ≤ z) (ha : 0 ≤ a)
    (hv : 0 < v) (hD : 0 ≤ D) (hε : 0 < ε) (hm : 0 < m) :
    let κ := a * Real.log (primeFiberFactorBound v m)
    let s' := s + ε
    let A₀ := D + 2 * (s' + 1)
    let q := 2 * κ + (s' + 1) + 2 * A₀ + 3
    let w := 4 * q + max z q + A₀ + 2
    let x := (s' + w + 2) + 2 * A₀ + 2
    ∀ᶠ L : ℝ in atTop,
    let Q := ⌊L ^ q⌋₊
    let h := L ^ (-w)
    let ξ := L ^ (-x)
    ∀ {G : Type} [Fintype G] [DecidableEq G] (J ell : ℕ),
    ∀ (P : G → Finset ℕ) (V : G → ℝ),
    Pairwise (fun g h => Disjoint (P g) (P h)) →
    (∀ g p, p ∈ P g → p.Prime ∧ Q < p) →
    (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) →
    (∀ g, v ≤ V g) →
    (∀ g p, p ∈ P g → Real.log p ≤ L ^ s) →
    (Fintype.card G : ℝ) ≤ a * Real.log L →
    (∀ g, ∃ a b : ℝ, P g = primeBand a b ∧ Real.exp (L ^ c) ≤ a ∧ 0 ≤ b) →
    ∀ probes : G → Finset (Fin J), (∀ g, (probes g).card = m) →
    ∀ r t : Finset G, ∀ hrt : Disjoint r t,
    ∀ ζ Θ : ℝ, |ζ| ≤ L ^ z →
    ∀ u : RepeatedBigLists P J ell → ℂ, u ∈ repeatedBigSymmetricSubspace →
    let slots := fun g => (probes g).map (Function.Embedding.inl (β := Fin ell))
    let kept := fun U : Finset (RepeatedBigFlatIndex G J ell) => primeProductRetainedCells
      (fun i : U => P i.1.1) (fun i => V i.1.1) h ξ
    cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
      (repeatedBigSymmetrizeLinear (fun source => ∑ target,
        (∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
          ∑ aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i),
            repeatedBigPrimePatternWeight probes r t i *
              repeatedBigUnbannedKernel V (fun _ _ => 1)
                (repeatedBigPrimePatternCut probes r t i) ζ
                (repeatedBigPrimePatternKernel P V probes r t hrt Q h kept i)
                aux source target *
              physicalReturnPhase Θ
                (repeatedBigD (repeatedBigPrimePatternCut probes r t i) source aux)) * u target)) ≤
      (Real.sqrt (((ell : ℝ) ^ ell / (m : ℝ) ^ ell) ^ r.card) +
        Real.sqrt (((ell : ℝ) ^ ell / (m : ℝ) ^ ell) ^ t.card) +
        (3 : ℝ) ^ ((r.sigma slots).card + (t.sigma slots).card) * L ^ (-D)) *
        cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) u := by
  intro κ s' A₀ q w x
  filter_upwards [eventually_repeated_big_prime_projected_norm_le
    hZ c s z a v D ε m hc hs hz ha hv hD hε hm] with L hnorm
  intro Q h ξ G _ _ J ell P V hdisj hP hmass hV hlog hcard hband
    probes hp r t hrt ζ Θ hζ u hu slots kept
  have hb := hnorm J ell P V hdisj hP hmass hV hlog hcard hband
    probes hp r t hrt ζ Θ hζ u hu
  simpa only [repeated_big_prime_pattern_family_kernel] using hb

end Bounty
end

section

/- Explicit pointwise bounds for the actual raw and comparison pattern
coefficients. Retained-cell membership supplies the required mass floors. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def repeatedBigPrimePatternBound {G : Type*} [DecidableEq G]
    {J ell : ℕ} (probes : G → Finset (Fin J)) (r t : Finset G) (Q : ℕ) (ξ : ℝ) :
    RepeatedBigPrimePatternIndex (ell := ell) probes r t → ℝ
  | .inl _ => 1
  | .inr _ => ((Q * Q : ℕ) / ξ) ^ 2

theorem repeated_big_prime_pattern_bound_nonneg {G : Type*} [DecidableEq G]
    {J ell : ℕ} (probes : G → Finset (Fin J)) (r t : Finset G) (Q : ℕ) (ξ : ℝ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t) :
    0 ≤ repeatedBigPrimePatternBound probes r t Q ξ i := by
  cases i with
  | inl u => exact zero_le_one
  | inr ab => exact sq_nonneg _

theorem repeated_big_prime_pattern_weight_norm {G : Type*} [DecidableEq G]
    {J ell : ℕ} (probes : G → Finset (Fin J)) (r t : Finset G)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t) :
    ‖repeatedBigPrimePatternWeight probes r t i‖ = 1 := by
  cases i <;> simp [repeatedBigPrimePatternWeight, norm_pow]

theorem repeated_big_prime_pattern_kernel_norm_le {G : Type*}
    [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ) (hξ : 0 < ξ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (source target : RepeatedBigLists P J ell)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i)) :
    let kept := fun U : Finset (RepeatedBigFlatIndex G J ell) => primeProductRetainedCells
      (fun j : U => P j.val.1) (fun j => V j.val.1) h ξ
    ‖repeatedBigPrimePatternKernel P V probes r t hrt Q h kept i source target aux‖ ≤
      repeatedBigPrimePatternBound probes r t Q ξ i := by
  intro kept
  cases i with
  | inl u => simp only [repeatedBigPrimePatternKernel, repeatedBigPrimePatternBound, norm_one, le_refl]
  | inr ab =>
      dsimp only [repeatedBigPrimePatternKernel, repeatedBigPrimePatternBound]
      refine repeated_big_prime_coefficient_norm_le P V ab.1.val ab.2.val _ _
        Q h _ _ hξ ?_ ?_ source target aux
      · intro d hd
        exact prime_product_retained_cell_mass _ _ h ξ hd
      · intro d hd
        exact prime_product_retained_cell_mass _ _ h ξ hd

end Bounty
end

section

/- The actual masked pair count averaged over Bernoulli choices. -/

open Finset

namespace Bounty

theorem exists_odd_masked_pair_average_upper :
    ∃ K : ℝ, 0 < K ∧ ∀ (L : ℝ) (a b c d m : ℕ) [NeZero m]
      (W z q : ℝ) (P : Finset ℕ),
      1 ≤ L → (m : ℝ) ≤ Real.exp L →
      (∀ p ∈ m.primeFactors, L^2 ≤ (p : ℝ)) →
      a ≤ b → c ≤ d → 0 ≤ W → W ≤ z → 1 < z →
      0 ≤ q → q ≤ 1 → (∀ p ∈ P, 2 ≤ p) →
      (∑ S ∈ P.powerset, bernoulliSubsetWeight q P S *
        ((oddMaskedPairBox a b c d m W z S).card : ℝ)) ≤
        K * (((b : ℝ)-a)*((d : ℝ)-c)/(m : ℝ)) *
          (∏ p ∈ primeBand 0 W, (1 - 1/(p : ℝ)))^2 *
          (∏ p ∈ primeBand 0 z, (1 - 1/(p : ℝ))) *
          (∏ p ∈ P, (1 + q/((p : ℝ)-1))) +
        ((m : ℝ)*(z^(10 : ℝ))^3 + (((b : ℝ)-a)+((d : ℝ)-c))*(z^(10 : ℝ))^2) := by
  obtain ⟨K, hK, hb⟩ := exists_odd_masked_pair_box_upper
  refine ⟨K, hK, ?_⟩
  intro L a b c d m hm W z q P hL hmL hmin hab hcd hW hWz hz hq0 hq1 hP
  let M := K * (((b : ℝ)-a)*((d : ℝ)-c)/(m : ℝ)) *
    (∏ p ∈ primeBand 0 W, (1 - 1/(p : ℝ)))^2 * (∏ p ∈ primeBand 0 z, (1 - 1/(p : ℝ)))
  let E := (m : ℝ)*(z^(10 : ℝ))^3 + (((b : ℝ)-a)+((d : ℝ)-c))*(z^(10 : ℝ))^2
  have hbound (S : Finset ℕ) (hS : S ∈ P.powerset) :
      bernoulliSubsetWeight q P S * ((oddMaskedPairBox a b c d m W z S).card : ℝ) ≤
        bernoulliSubsetWeight q P S * (M * (∏ p ∈ S, (1 - 1/(p : ℝ))⁻¹) + E) := by
    exact mul_le_mul_of_nonneg_left
      (hb L a b c d m W z S hL hmL hmin hab hcd hW hWz hz
        (fun p hp => hP p (mem_powerset.mp hS hp)))
      (bernoulliSubsetWeight_nonneg hq0 hq1 P S)
  have hid : (∑ S ∈ P.powerset, bernoulliSubsetWeight q P S *
        (M * (∏ p ∈ S, (1 - 1/(p : ℝ))⁻¹) + E)) =
      M * (∑ S ∈ P.powerset, bernoulliSubsetWeight q P S *
        (∏ p ∈ S, (1 - 1/(p : ℝ))⁻¹)) + E * (∑ S ∈ P.powerset, bernoulliSubsetWeight q P S) := by
    rw [mul_sum, mul_sum, ← sum_add_distrib]
    apply sum_congr rfl
    intro S _
    ring
  calc
    _ ≤ _ := sum_le_sum hbound
    _ = _ := hid
    _ = _ := by rw [bernoulli_mask_inverse_avoidance P q hP, sum_bernoulliSubsetWeight, mul_one]

end Bounty
