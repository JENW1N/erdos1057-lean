/- The complete original root integrand follows the actual effective path,
including its signed history weight, small factor, coefficient and terminal value. -/

open scoped Classical
namespace Bounty
section Integrand
variable {I : Type} {N M J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (groups : Finset (Fin N)) (e : {g // g ∉ groupsᶜ} ≃ Fin M)
  (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
  (hC : ∀ i : patterns, ∀ g : ↥groupsᶜ, C i.val g.val = ∅)
  (k : ℕ → I → ℤ)
  (pl : PhysicalRootSmallPlan (P := P) (J := J) (ell := ell) (n := n) groups patterns)
  (V : Fin N → ℝ) (q : ℝ) (ζ : ℕ → I → ℝ)
  (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
    PhysicalAuxLabels P (C i) → ℂ)
  (r : PhysicalGroupResidues P groupsᶜ) (θ : ℝ)
  (β : (g : Fin M) → P (e.symm g).val → ℝ)
  (retention : Fin (n + 2) → ℝ) (ρ : ℝ)

noncomputable def physicalRootEffectiveIntegrand
    (f : PhysicalFullBoundedState (fun g => P (e.symm g).val) J ell B → ℂ)
    (x : PhysicalFullBoundedState (fun g => P (e.symm g).val) J ell B)
    (path : PhysicalEffectivePlannedBigPath (fun (i : patterns) g => C i.val (e.symm g).val) (fun (j : Fin (n + 1)) (i : patterns) => k (n - j.val) i.val) B
      ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1))) pl.1 pl.2 x) : ℂ :=
  physicalEffectivePlanSignedWeight (fun (i : patterns) g => C i.val (e.symm g).val) (fun (j : Fin (n + 1)) (i : patterns) => k (n - j.val) i.val) B
    (fun (key : PhysicalMixedBigKey (Ps := fun s : ↥groupsᶜ => P s.val) (J := J) (ell := ell) (I := patterns) (K := Fin (n + 1))) _ aux => physicalAuxMass (fun g => V (e.symm g).val) (fun g => C key.2.1.val (e.symm g).val) aux) β retention ρ (fun g => V (e.symm g).val)
    ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1))) pl.1 pl.2 x path *
  physicalEffectivePlanSmallFactor (fun (i : patterns) g => C i.val (e.symm g).val) (fun (j : Fin (n + 1)) (i : patterns) => k (n - j.val) i.val) B
    (fun s : ↥groupsᶜ => V s.val) (fun _ => q) ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1)))
    (physicalGroupResidueVector r) pl.1 pl.2 x path *
  physicalEffectivePlanCoefficientPhase (fun (i : patterns) g => C i.val (e.symm g).val) (fun (j : Fin (n + 1)) (i : patterns) => k (n - j.val) i.val) B
    (fun _ => 0) (physicalRootKeyCoefficient groups e patterns C hC ζ k K θ)
    ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1))) pl.1 pl.2 x path *
  f (physicalEffectivePlanTerminal (fun (i : patterns) g => C i.val (e.symm g).val) (fun (j : Fin (n + 1)) (i : patterns) => k (n - j.val) i.val) B
    ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1))) pl.1 pl.2 x path)

theorem physical_root_effective_integrand
    [∀ z : PhysicalPrime P, NeZero z.2.val]
    [Fintype (PhysicalSelectedData (fun g => P (e.symm g).val) ell
      (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val))]
    (hq : 0 ≤ q) (cut : ℕ → Fin M → Finset (Fin J))
    (hencode : ∀ i, PhysicalMarkRowEncoding
      (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val)
      (physicalSelectedFineTag (n + 1) i) (cut i) (cut (i + 1)))
    (f : PhysicalFullBoundedState (fun g => P (e.symm g).val) J ell B → ℂ)
    (x : PhysicalFullBoundedState (fun g => P (e.symm g).val) J ell B)
    (hx : FullActiveInjective x)
    (path : FullPermutationMixedPath (fun g (p : P (e.symm g).val) => p.val)
      (fun j g => physicalFullSharedIndices (ell := ell)
        (C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val)) B
      (fun j _ => PhysicalAuxLabels (fun g => P (e.symm g).val)
        (fun g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val))
      (fun j => physicalFullEdgeDelta
        (fun g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val)
        (physicalRootPlanMultiplier groups patterns C hC k pl j))
      (fun j => physicalFullEdgeD
        (fun g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val))
      ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1))) x) :
    let Cn := fun j g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val
    let kn := physicalRootPlanMultiplier groups patterns C hC k pl
    (physicalOriginalFineWeight Cn kn (fun j _ aux => physicalAuxMass (fun g => V (e.symm g).val) (Cn j) aux)
      β retention ρ (fun g => V (e.symm g).val) x path *
      physicalSelectedDataRecordPhase Cn cut Finset.univ
        (physicalRootNumberedCompleteWeight groups e patterns C hC V q ζ k K r θ pl)
        (physicalOriginalFineRecord Cn kn cut x path)) *
      f (physicalFullPathTerminal Cn kn ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1))) x path) =
    physicalRootEffectiveIntegrand groups e patterns C hC k pl V q ζ K r θ β retention ρ f x
      (physicalRootSelectedEffectivePathEquiv groups e patterns C hC k pl x path) := by
  let Cn := fun j g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val
  let kn := physicalRootPlanMultiplier groups patterns C hC k pl
  have h := physical_root_weighted_effective_complete groups e patterns C hC k pl V hq r ζ K θ
    (fun j _ aux => physicalAuxMass (fun g => V (e.symm g).val) (Cn j) aux) β retention ρ cut hencode x hx path
  have hw := physical_root_effective_signed_weight groups e patterns C hC k pl V β retention ρ x path
  have ht := physical_root_effective_terminal groups e patterns C hC k pl x path
  dsimp only
  unfold physicalRootEffectiveIntegrand
  rw [hw, ht]
  exact congrArg (fun z => z * f (physicalFullPathTerminal Cn kn ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1))) x path)) h

end Integrand
end Bounty
