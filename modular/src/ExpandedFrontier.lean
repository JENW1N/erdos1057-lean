/- Chronological mixed events: one shared pattern, its original auxiliary, both
small endpoints, and the original full big event with both caps. -/

open Finset
open scoped Classical
namespace Bounty

section Events
variable {S G I V K : Type} [Fintype S] [Fintype G] [DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Type} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : I → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : I → Type)
  (Δ D : ∀ _k : K, ∀ i, PhysicalSharedLists Ps J → SharedActiveLabels P (shared i) → A i → G → ℤ)

abbrev PhysicalMixedWordState :=
  PhysicalSmallBigState Ps J ell
    (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)

abbrev PhysicalMixedWordEdge (k : K) (s : PhysicalMixedWordState (Ps := Ps) (J := J) (ell := ell) (M := M) n B) :=
  Σ i : I, Σ a : A i,
    PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n (shared i) B
      (fun d c => Δ k i d c a) (fun d c => D k i d c a)) s

def PhysicalMixedWordEvent : Option (V ⊕ K) →
    PhysicalMixedWordState (Ps := Ps) (J := J) (ell := ell) (M := M) n B → Type _
  | none, _ => PhysicalPermutations S J ell × FullActiveSlotPermutations M
  | some (.inl _), s => CoupledGhostEvent M B s.2
  | some (.inr k), s => PhysicalMixedWordEdge n shared B A Δ D k s

noncomputable abbrev physicalMixedWordEventFintype
    [Fintype I] [∀ i, Fintype (A i)] [∀ g p, NeZero (n g p)]
    (tag : Option (V ⊕ K)) (s : PhysicalMixedWordState (Ps := Ps) (J := J) (ell := ell) (M := M) n B) :
    Fintype (PhysicalMixedWordEvent n shared B A Δ D tag s) := by
  cases tag with
  | none => dsimp [PhysicalMixedWordEvent]; infer_instance
  | some tag =>
    cases tag <;> dsimp [PhysicalMixedWordEvent, PhysicalMixedWordEdge] <;> infer_instance

variable (kbig : ∀ _k : K, ∀ i, SharedActiveLabels P (shared i) → A i → ℤ)

noncomputable def physicalMixedWordTarget (tag : Option (V ⊕ K))
    (s : PhysicalMixedWordState (Ps := Ps) (J := J) (ell := ell) (M := M) n B) :
    PhysicalMixedWordEvent n shared B A Δ D tag s → PhysicalMixedWordState (Ps := Ps) (J := J) (ell := ell) (M := M) n B :=
  match tag with
  | none => fun e => ((s.1.1, physicalPermuteLabels e.1 s.1.2), fullActivePermutation e.2 s.2)
  | some (.inl _) => fun e => (s.1, coupledGhostJointEventTarget M B s.2 e)
  | some (.inr k) => fun e =>
      physicalSmallBigTarget _
        (physicalSmallBigFullTarget n (shared e.1) B
          (fun d c => Δ k e.1 d c e.2.1) (fun d c => D k e.1 d c e.2.1))
        (fun x => kbig k e.1 (productActiveMemorySplit (shared e.1) B x).1 e.2.1) s e.2.2

variable (ω : ∀ i, SharedActiveLabels P (shared i) → A i → ℝ)
  (μ : ∀ g, P g → ℝ) (qghost : V → ℝ) (ρ : ℝ) (Vb : G → ℝ)
  (Vs : S → ℝ) (qedge : K → ℝ)

noncomputable def physicalMixedWordWeight (tag : Option (V ⊕ K))
    (s : PhysicalMixedWordState (Ps := Ps) (J := J) (ell := ell) (M := M) n B) :
    PhysicalMixedWordEvent n shared B A Δ D tag s → ℝ :=
  match tag with
  | none => fun e => (Fintype.card (PhysicalPermutations S J ell) : ℝ)⁻¹ *
      fullActivePermutationWeight M e.2
  | some (.inl j) => fun e => coupledGhostJointEventWeight
      (fun g => physicalGhostRetention (n g) (qghost j) ρ)
      (fun g => physicalGhostTermination (n g) (qghost j) ρ)
      (fun g => physicalGhostBirth (n g) (qghost j) ρ (Vb g))
      (fun g => unrestrictedResidueWeight (μ g)) M B s.2 e
  | some (.inr k) => fun e =>
      ω e.1 (productActiveMemorySplit (shared e.1) B s.2).1 e.2.1 *
      physicalSmallBigPositiveWeight Vs (qedge k) _
        (physicalSmallBigFullWeight n (shared e.1) B
          (fun d c => Δ k e.1 d c e.2.1) (fun d c => D k e.1 d c e.2.1) μ ρ Vb)
        (fun x => kbig k e.1 (productActiveMemorySplit (shared e.1) B x).1 e.2.1) s e.2.2

end Events
end Bounty
