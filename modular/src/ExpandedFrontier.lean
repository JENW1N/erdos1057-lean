open Finset
open scoped Classical
noncomputable def physicalFullMemoryState {G : Type*} {P : G → Finset ℕ}
    {Z : G → Type*} {J ell B : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (q : ∀ g, BoundedOrderedTuple (Z g) B) :
    ProductBoundedOrderedState (fun g => ↥(P g)) Z (fun _ => J + ell) B :=
  fun g => (fun i => L g (physicalFullSlotIndex (C g) i), q g)

theorem physical_full_memory_state_unshared {G : Type*} {P : G → Finset ℕ}
    {Z : G → Type*} {J ell B : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (q : ∀ g, BoundedOrderedTuple (Z g) B) (g : G) :
    ((productActiveMemorySplit (fun g => physicalFullSharedIndices (C g)) B
      (physicalFullMemoryState C L q)).2 g).1 =
    (physicalGroupUnsharedEmbedding C L g) ∘
      finCongr (physical_full_unshared_indices_card (ell := ell) (C g)) := by
  funext i
  change L g (physicalFullSlotIndex (C g)
    ((physicalFullSharedIndices (C g))ᶜ.equivFin.symm i).val) = _
  rw [physical_full_slot_index_unshared]
  rfl

theorem physical_full_memory_state_pending {G : Type*} {P : G → Finset ℕ}
    {Z : G → Type*} {J ell B : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (q : ∀ g, BoundedOrderedTuple (Z g) B) (g : G) :
    ((productActiveMemorySplit (fun g => physicalFullSharedIndices (C g)) B
      (physicalFullMemoryState C L q)).2 g).2 = q g := rfl

theorem physical_full_memory_state_total {G : Type*} [Fintype G] {P : G → Finset ℕ}
    {Z : G → Type*} {J ell B : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (q : ∀ g, BoundedOrderedTuple (Z g) B) :
    productTotalMemory (physicalFullMemoryState C L q) = ∑ g, (q g).1.val := rfl

theorem physical_full_memory_state_shared {G : Type*} {P : G → Finset ℕ}
    {Z : G → Type*} {J ell B : ℕ} (C : G → Finset (Fin J))
    (L R : PhysicalMarkLists P J ell) (hshared : physicalSharedCompatible C L R)
    (q r : ∀ g, BoundedOrderedTuple (Z g) B) :
    (productActiveMemorySplit (fun g => physicalFullSharedIndices (C g)) B
      (physicalFullMemoryState C L q)).1 =
    (productActiveMemorySplit (fun g => physicalFullSharedIndices (C g)) B
      (physicalFullMemoryState C R r)).1 := by
  funext g i
  let j := ((physicalFullSharedIndices (ell := ell) (C g)).equivFin.symm i).val
  change L g (physicalFullSlotIndex (C g) j) = R g (physicalFullSlotIndex (C g) j)
  have hj : physicalFullSlotIndex (C g) j ∈ physicalSharedSlots (C g) :=
    (physical_full_slot_index_shared_iff (C g) j).mpr
      ((physicalFullSharedIndices (ell := ell) (C g)).equivFin.symm i).property
  obtain ⟨s, hs, he⟩ := (physical_mem_shared_slots_iff (C g) _).mp hj
  rw [he]
  exact hshared g s hs

theorem physical_full_memory_state_reassemble {G : Type*} {P : G → Finset ℕ}
    {Z : G → Type*} {J ell B : ℕ} (C : G → Finset (Fin J))
    (L R : PhysicalMarkLists P J ell) (hshared : physicalSharedCompatible C L R)
    (q r : ∀ g, BoundedOrderedTuple (Z g) B) :
    (productActiveMemorySplit (fun g => physicalFullSharedIndices (C g)) B).symm
      ((productActiveMemorySplit (fun g => physicalFullSharedIndices (C g)) B
        (physicalFullMemoryState C L q)).1,
      (productActiveMemorySplit (fun g => physicalFullSharedIndices (C g)) B
        (physicalFullMemoryState C R r)).2) = physicalFullMemoryState C R r := by
  rw [physical_full_memory_state_shared C L R hshared q r]
  exact (productActiveMemorySplit (fun g => physicalFullSharedIndices (C g)) B).symm_apply_apply _

theorem physical_full_memory_state_weight {G : Type*} [Fintype G] {P : G → Finset ℕ}
    {Z : G → Type*} {J ell B : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (q : ∀ g, BoundedOrderedTuple (Z g) B)
    (μ : ∀ g, ↥(P g) → ℝ) (ν : ∀ g, Z g → ℝ) :
    productMemoryWeight μ ν (physicalFullMemoryState C L q) =
      ∏ g, (∏ i : PhysicalSlots J ell, μ g (L g i)) * boundedOrderedMemoryWeight (ν g) (q g) := by
  apply prod_congr rfl
  intro g _
  change (∏ i, μ g (L g (physicalFullSlotIndex (C g) i))) * _ = _
  rw [(physicalFullSlotIndex (C g)).prod_comp (fun i => μ g (L g i))]
  rfl
end

section
open scoped BigOperators Classical
theorem rational_dyad_coefficient_le {U V r L : ℝ}
    (hU : 0 < U) (hV : 0 < V) (hr : 0 < r) (hL : 1 ≤ L) :
    ((1 + 3 * V / r) * (2 * U + 2 * r * L)) / (U * V) ≤
      6 * L * (1 / r + 1 / U + 1 / V + r / (U * V)) := by
  apply (div_le_iff₀ (mul_pos hU hV)).mpr
  have he : 6 * L * (1 / r + 1 / U + 1 / V + r / (U * V)) * (U * V) =
      (3 * (1 + V / r)) * (2 * L * (U + r)) := by
    field_simp
    ring
  rw [he]
  apply mul_le_mul
  · have heq : 1 + 3 * V / r = 3 * (1 + V / r) - 2 := by ring
    rw [heq]
    linarith
  · nlinarith [mul_nonneg hU.le (sub_nonneg.mpr hL)]
  · positivity
  · positivity

theorem supported_weighted_product_dyadic_bound
    {X Y : Type*} [Fintype X] [Fintype Y]
    (π : X → ℕ) (τ : Y → ℕ) (U V : ℕ) (hU : 0 < U) (hV : 0 < V)
    (μ : X → ℝ) (ν : Y → ℝ) (hμ : ∀ x, 0 ≤ μ x) (hν : ∀ y, 0 ≤ ν y)
    (f : X → ℂ) (g : Y → ℂ)
    (hπrange : ∀ x, f x ≠ 0 → U ≤ π x ∧ π x < 2 * U)
    (hτrange : ∀ y, g y ≠ 0 → V ≤ τ y ∧ τ y < 2 * V)
    {C D : ℝ} (hC : 0 ≤ C) (hD : 0 ≤ D)
    (hμatom : ∀ m : ℕ,
      (∑ x ∈ Finset.univ.filter (fun x => π x = m), μ x) ≤ C / (m : ℝ))
    (hνatom : ∀ m : ℕ,
      (∑ y ∈ Finset.univ.filter (fun y => τ y = m), ν y) ≤ D / (m : ℝ))
    {u : ℤ} {r : ℕ} (hr : 0 < r) (hcop : (r : ℤ).gcd u = 1)
    {β : ℝ} (hβ : |β| ≤ 1 / (r : ℝ) ^ 2) :
    ‖∑ x, ∑ y, ((μ x : ℂ) * f x) * ((ν y : ℂ) * g y) *
      (Complex.exp (Complex.I * (2 * Real.pi *
        (((u : ℝ) / r + β) * τ y) : ℝ))) ^ (π x)‖ ^ 2 ≤
      ((1 + 3 * (V : ℝ) / r) *
        (2 * (U : ℝ) + 2 * (r : ℝ) * (1 + Real.log r))) *
          ((C / U) * ∑ x, μ x * ‖f x‖ ^ 2) *
          ((D / V) * ∑ y, ν y * ‖g y‖ ^ 2) := by
  apply supported_weighted_product_rational_bilinear_bound π τ U U (V : ℤ) V
    μ ν hμ hν f g
  · intro x hx
    have hp := hπrange x hx
    omega
  · intro y hy
    obtain ⟨hlo, hhi⟩ := hτrange y hy
    constructor
    · exact_mod_cast hlo
    · have hbound : τ y ≤ V + V := by omega
      exact_mod_cast hbound
  · exact hC
  · exact hD
  · exact_mod_cast hU
  · exact_mod_cast hV
  · intro x hx
    exact_mod_cast (hπrange x hx).1
  · intro y hy
    exact_mod_cast (hτrange y hy).1
  · exact hμatom
  · exact hνatom
  · exact hr
  · exact hcop
  · exact hβ

theorem supported_weighted_product_dyadic_clean_bound
    {X Y : Type*} [Fintype X] [Fintype Y]
    (π : X → ℕ) (τ : Y → ℕ) (U V : ℕ) (hU : 0 < U) (hV : 0 < V)
    (μ : X → ℝ) (ν : Y → ℝ) (hμ : ∀ x, 0 ≤ μ x) (hν : ∀ y, 0 ≤ ν y)
    (f : X → ℂ) (g : Y → ℂ)
    (hπrange : ∀ x, f x ≠ 0 → U ≤ π x ∧ π x < 2 * U)
    (hτrange : ∀ y, g y ≠ 0 → V ≤ τ y ∧ τ y < 2 * V)
    {C D : ℝ} (hC : 0 ≤ C) (hD : 0 ≤ D)
    (hμatom : ∀ m : ℕ,
      (∑ x ∈ Finset.univ.filter (fun x => π x = m), μ x) ≤ C / (m : ℝ))
    (hνatom : ∀ m : ℕ,
      (∑ y ∈ Finset.univ.filter (fun y => τ y = m), ν y) ≤ D / (m : ℝ))
    {u : ℤ} {r : ℕ} (hr : 0 < r) (hcop : (r : ℤ).gcd u = 1)
    {β : ℝ} (hβ : |β| ≤ 1 / (r : ℝ) ^ 2) :
    ‖∑ x, ∑ y, ((μ x : ℂ) * f x) * ((ν y : ℂ) * g y) *
      (Complex.exp (Complex.I * (2 * Real.pi *
        (((u : ℝ) / r + β) * τ y) : ℝ))) ^ (π x)‖ ^ 2 ≤
      6 * C * D * (1 + Real.log r) *
        (1 / (r : ℝ) + 1 / (U : ℝ) + 1 / (V : ℝ) + (r : ℝ) / ((U : ℝ) * V)) *
        (∑ x, μ x * ‖f x‖ ^ 2) * ∑ y, ν y * ‖g y‖ ^ 2 := by
  have hUR : (0 : ℝ) < U := by exact_mod_cast hU
  have hVR : (0 : ℝ) < V := by exact_mod_cast hV
  have hrR : (0 : ℝ) < r := by exact_mod_cast hr
  have hL : 1 ≤ 1 + Real.log (r : ℝ) := by
    have hl := Real.log_nonneg (by exact_mod_cast hr : (1 : ℝ) ≤ r)
    linarith
  have hc := rational_dyad_coefficient_le hUR hVR hrR hL
  have hEx : 0 ≤ ∑ x, μ x * ‖f x‖ ^ 2 :=
    Finset.sum_nonneg (fun x _ => mul_nonneg (hμ x) (sq_nonneg _))
  have hEy : 0 ≤ ∑ y, ν y * ‖g y‖ ^ 2 :=
    Finset.sum_nonneg (fun y _ => mul_nonneg (hν y) (sq_nonneg _))
  have hm := mul_le_mul_of_nonneg_right hc
    (mul_nonneg (mul_nonneg (mul_nonneg hC hD) hEx) hEy)
  have hb := supported_weighted_product_dyadic_bound π τ U V hU hV
    μ ν hμ hν f g hπrange hτrange hC hD hμatom hνatom hr hcop hβ
  apply hb.trans
  convert hm using 1 <;> ring
end

