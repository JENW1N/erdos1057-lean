section

/- Original prime-pool and rough-band factors avoid every polynomial-sized rational modulus. -/

open Finset Filter

namespace Bounty

theorem eventually_rational_candidate_P_properties {c : ℝ} (hc : 0 < c) (Rmod : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ g ∈ candidatePIndices c L, ∀ qRat : ℕ,
      0 < qRat → (qRat : ℝ) ≤ L^Rmod → ∀ p ∈ candidatePBand (c*L) g,
        p.Prime ∧ p.Coprime qRat := by
  obtain ⟨v,V,hv,hV,hpool⟩ := exists_candidate_P_pool_bounds hc
  filter_upwards [hpool, eventually_exp_neg_rpow_mul_rpow_le
    (by norm_num : (0 : ℝ) < 1/10) zero_lt_one Rmod 0] with L hpool hdec
  have hmod : L^Rmod ≤ Real.exp (L^(1/10 : ℝ)) := by
    simp only [neg_one_mul,neg_zero,Real.rpow_zero] at hdec
    have hm := mul_le_mul_of_nonneg_left hdec (Real.exp_nonneg (L^(1/10 : ℝ)))
    have he : Real.exp (L^(1/10 : ℝ)) * Real.exp (-L^(1/10 : ℝ)) = 1 := by
      rw [← Real.exp_add,add_neg_cancel,Real.exp_zero]
    simpa only [← mul_assoc,he,one_mul,mul_one] using hm
  intro g hg qRat hq hqR p hp
  have hd := (hpool.2.2.2.2.2 g hg).2.2 p hp
  refine ⟨hd.1,hd.1.coprime_iff_not_dvd.mpr ?_⟩
  intro hpq
  have hsmall : (p : ℝ) ≤ Real.exp (L^(1/10 : ℝ)) :=
    (Nat.cast_le.mpr (Nat.le_of_dvd hq hpq)).trans (hqR.trans hmod)
  exact (not_lt_of_ge hsmall) hd.2.1

theorem eventually_rational_rough_Q_properties (Rmod : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ A B : ℝ, ∀ qRat : ℕ,
      0 < qRat → (qRat : ℝ) ≤ L^Rmod →
      ∀ n ∈ roughBand A B (Real.exp (Real.sqrt L)), 0 < n ∧ n.Coprime qRat := by
  filter_upwards [eventually_rpow_le_exp_sqrt Rmod] with L hmod
  intro A B qRat hq hqR n hn
  exact ⟨roughBand_pos hn, coprime_of_small_prime_avoidance hq (hqR.trans hmod)
    (rough_band_avoids_small_primes hn)⟩

end Bounty
