    hUQpos hUM hUTpos zero_le_one hBM hBT (by simpa only [one_mul] using hprod)
    hδ hα hγ hQs hD hF htriple1 hlog
  obtain ⟨lor,hir,wr,Vr,hrdata,hrrep⟩ := hpair D F α γ UM UT BM BT
    hUM hUTpos hBM hBT hprod hα hγ hD hF hpair1 hpairlog
  have hTbound : ∀ u : ℝ, ‖∑ n ∈ F, γ n*harmonicMellinWeight u n‖ ≤ L^(Et+1) := by
    intro u
    have hh := finite_dyadic_mellin_bounded_norm F γ u UT BT hUT hBT hF hγ
    simp only [mul_comm (harmonicMellinWeight u _) (γ _)] at hh
    calc
