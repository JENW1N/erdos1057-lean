/- Removing unshared auxiliary bans on the two absolute-value divisor fibers
of the actual signed shift. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_no_free_divisor_natAbs {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J : ℕ} (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (n : ℤ) (hn : ∀ p ∈ physicalFreePrimeSet C aux, ¬ (p : ℤ) ∣ n) :
    ∀ p ∈ physicalFreePrimeSet C aux, ¬ (p : ℤ) ∣ (n.natAbs : ℤ) := by
  intro p hp
  simpa only [Int.natCast_dvd, Int.natAbs_natCast] using hn p hp

theorem physical_marked_pair_aux_restriction_eq_signed {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (n k : ℤ) (hn : ∀ p ∈ physicalFreePrimeSet C aux, ¬ (p : ℤ) ∣ n)
    (b : GroupMarkedLists P (fun g => ell + (C g).card) →
      GroupMarkedLists P (fun g => ell + (C g).card) → ℂ) :
    groupMarkedAverage P (fun g => ell + (C g).card) (n.natAbs : ℤ) (fun u =>
      groupMarkedAverage P (fun g => ell + (C g).card)
        ((n + k * (physicalFreeFactor C aux : ℕ)).natAbs : ℤ)
        (fun v => if physicalUnsharedAuxAvoids C aux u ∧ physicalUnsharedAuxAvoids C aux v
          then b u v else 0)) =
    groupMarkedAverage P (fun g => ell + (C g).card) (n.natAbs : ℤ) (fun u =>
      groupMarkedAverage P (fun g => ell + (C g).card)
        ((n + k * (physicalFreeFactor C aux : ℕ)).natAbs : ℤ) (b u)) := by
  have hw := physical_no_free_divisor_natAbs C aux n hn
  have hz := physical_no_free_divisor_natAbs C aux _ (physical_no_free_divisor_shift C aux n k hn)
  unfold groupMarkedAverage
  congr 1
  apply sum_congr rfl
  intro u _
  dsimp only
  congr 1
  apply sum_congr rfl
  intro v _
  exact if_pos ⟨physical_unshared_aux_avoids_of_no_free_divisor C aux _ hw u,
    physical_unshared_aux_avoids_of_no_free_divisor C aux _ hz v⟩

end Bounty
end

