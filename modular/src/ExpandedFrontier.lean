    (∏ i : Fin steps.length,
      fullMixedBirthOperationMultiplier n S B A Δ D steps code θ encode x p i) =
      if ∀ j ∈ birthForestTouched code,
        fullMixedIndexedBirthPerformed n S B A Δ D steps x p j then
        ∏ j, physicalReturnPhase (birthForestLocalFrequency code θ j)
