namespace Bounty

theorem physical_small_big_big_average_energy_le
    {S G : Type*} [Fintype S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} [∀ p : PhysicalPrime Ps, NeZero p.2.val]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    {J ell B : ℕ} {M : G → ℕ}
    (Vs : S → ℝ) (hVs : ∀ s, 0 < Vs s) (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hν : ∀ g z, 0 ≤ ν g z)
    (f : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ) :
    physicalSmallBigEnergy Vs (productMemoryWeight μ ν) (physicalSmallBigBigAverage f) ≤
      physicalSmallBigEnergy Vs (productMemoryWeight μ ν) f := by
  have h := physical_small_big_fiber_energy_le Vs hVs (productMemoryWeight μ ν)
    f (physicalSmallBigBigAverage f) 1
    (fun s => by
      have hh := fullActiveAverage_energy_le μ ν hμ hν (fun x => f (s,x))
      simp only [one_mul]
      convert hh using 1
      congr 2)
  simpa only [one_mul] using h

section
variable {S G : Type} [Fintype S] [Fintype G] [DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
  (C : G → Finset (Fin J)) (k : ℤ)

noncomputable def physicalMixedDirtyPhase
    (Ψ : ∀ a (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B)),
      PhysicalMixedCoefficientEvent C k a s → ℂ)
    (a : PhysicalAuxLabels P C)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B))
    (e : PhysicalMixedCoefficientEvent C k a s) : ℂ :=
  if ¬ (∀ g, (e.2.2 g).1 = ∅ ∧ (e.2.2 g).2.1 = ∅) then Ψ a s e else 0

omit [DecidableEq G] in
theorem physical_mixed_dirty_phase_norm_le
    (Ψ : ∀ a (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B)),
      PhysicalMixedCoefficientEvent C k a s → ℂ) {H : ℝ} (hH : 0 ≤ H)
    (hΨ : ∀ a s e, ‖Ψ a s e‖ ≤ H) :
    ∀ a s e, ‖physicalMixedDirtyPhase C k Ψ a s e‖ ≤ H := by
  intro a s e
  unfold physicalMixedDirtyPhase
  by_cases hh : ¬ (∀ g, (e.2.2 g).1 = ∅ ∧ (e.2.2 g).2.1 = ∅)
  · rw [if_pos hh]
    exact hΨ a s e
  · rw [if_neg hh]
    simpa only [norm_zero] using hH


theorem physical_mixed_dirty_coefficient_action_eq
    (V : G → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ) (Vs : S → ℝ) (q : ℝ)
    (initial : ∀ g, Finset (P g))
    (Ψ : ∀ a (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B)),
      PhysicalMixedCoefficientEvent C k a s → ℂ)
    (f : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ) :
    physicalMixedCoefficientAction C k V baseline ρ Vs q initial
      (physicalMixedDirtyPhase C k Ψ) f =
    fun s => ∑ a : PhysicalAuxLabels P C, (physicalAuxMass V C a : ℂ) *
      physicalSmallBigFullPhasedAction (fun g (p : P g) => p.val)
        (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
        (fun d c g => physicalMixedEdgeDelta C k d c a g)
        (fun d c g => physicalMixedEdgeD C d c a g)
        (fun g => tiltedPhysicalBirthLaw V g (baseline g)) ρ V
        (fun c => physicalMixedBigStep C k c a) Vs q
        (fun y e => if ¬ (∀ g, (e.2.2 g).1 = ∅ ∧ (e.2.2 g).2.1 = ∅) then
          (if ∀ g i, (e.2.2 g).2.2.2 i ∉ initial g then Ψ a y e else 0) else 0) f s := by
  funext s
  simp only [physicalMixedCoefficientAction, physicalSmallBigFullPhasedAction,
    physicalSmallBigPhasedAction, physicalMixedDirtyPhase, mul_sum]
  apply sum_congr rfl
  intro a _
  apply sum_congr rfl
  intro e _
  split_ifs <;> rfl

end
end Bounty
