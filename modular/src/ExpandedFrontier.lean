section

/- Exact support restriction retaining both the original return coefficient and marked-residue compatibility. -/

open Finset
open scoped Classical
namespace Bounty

section Support
variable {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (V : Fin N → ℝ) (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
  (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
  (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)

noncomputable def physicalRootNormalizablePath
    (L : PhysicalMarkLists P J ell)
    (p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) : Prop :=
  physicalFiniteReturnScalar V patterns C ζ k K n L p ≠ 0 ∧
    ∃ r : PhysicalResidues P, physicalFinitePathResidueCompatible C k n r L p

theorem physical_root_normalizable_return_eq_walk
    (L : PhysicalMarkLists P J ell)
    (p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)
    (hp : physicalRootNormalizablePath V patterns C ζ k K L p) :
    physicalFiniteReturnScalar V patterns C ζ k K n L p =
      physicalBareWalkScalar V patterns C ζ K (finitePathLabels p) (finitePathMarks L p) (n + 1) := by
  have hn := hp.1
  unfold physicalFiniteReturnScalar physicalBareReturnScalar at hn ⊢
  split_ifs at hn ⊢ with h
  · rfl
  · exact (hn rfl).elim

variable [∀ a : PhysicalPrime P, NeZero a.2.val]
  (hP : ∀ g a, a ∈ P g → Nat.Prime a)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))

include hP hdis

theorem physical_root_residue_model_normalizable (q : ℝ) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    physicalRootResidueModel V patterns C q ζ k K n =
      (physicalStateMass V J ell : ℂ) * ∑ L : PhysicalMarkLists P J ell,
        ∑ p : {p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell //
          physicalRootNormalizablePath V patterns C ζ k K L p},
          physicalFiniteReturnScalar V patterns C ζ k K n L p.val *
            (physicalFiniteVertexExpectation C q k n L p.val : ℂ) := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  dsimp only [physicalRootResidueModel]
  congr 1
  apply sum_congr rfl
  intro L _
  let f := fun p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell =>
    physicalFiniteReturnScalar V patterns C ζ k K n L p *
      (physicalFiniteVertexExpectation C q k n L p : ℂ)
  calc
    _ = ∑ p ∈ univ.filter (physicalRootNormalizablePath V patterns C ζ k K L), f p := by
      symm
      apply sum_subset (filter_subset _ _)
      intro p hp hn
      have hn' : ¬ physicalRootNormalizablePath V patterns C ζ k K L p := by
        simpa only [mem_filter, mem_univ, true_and] using hn
      by_cases hs : physicalFiniteReturnScalar V patterns C ζ k K n L p = 0
      · simp only [f, hs, zero_mul]
      · have hi : ¬ ∃ r : PhysicalResidues P, physicalFinitePathResidueCompatible C k n r L p :=
          fun hr => hn' ⟨hs, hr⟩
        rw [show f p = physicalFiniteReturnScalar V patterns C ζ k K n L p *
            (physicalFiniteVertexExpectation C q k n L p : ℂ) from rfl,
          physical_finite_vertex_expectation_zero_of_incompatible hdis hP C q k n L p hi]
        simp only [Complex.ofReal_zero, mul_zero]
    _ = _ := sum_subtype _ (by simp) f

end Support
end Bounty
end

section

/- Uniform clean residue-fiber norms lift with no loss to the full bounded
product memory law. The factorial and prime-label weights remain in the
outer sum; every ordered residue occurrence is integrated. -/

open Finset
open scoped Classical

namespace Bounty

theorem clean_full_memory_lift_norm_le {G R : Type*}
    [Fintype G] [DecidableEq G] [Fintype R]
    {P : G → Finset ℕ} {J ell B : ℕ} [∀ g (p : P g), NeZero p.val]
    (V : G → ℝ) (b : ∀ g, P g → ℝ) (ν : ∀ g, P g → ℝ)
    (hV : ∀ g, 0 ≤ V g) (hb : ∀ g p, 0 ≤ b g p) (hν : ∀ g p, 0 ≤ ν g p)
    (A : ∀ (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val)),
      (RepeatedBigLists P J ell → (R × FixedOrderedResidues p) → ℂ) →
        RepeatedBigLists P J ell → (R × FixedOrderedResidues p) → ℂ)
    (M : ℝ) (hM : 0 ≤ M)
    (hA : ∀ N p v, cleanWeightedNorm (repeatedBigActiveMass V b) (A N p v) ≤
      M * cleanWeightedNorm (repeatedBigActiveMass V b) v)
    (f : CleanFullMemoryState P J ell B → R → ℂ) :
    cleanWeightedNorm (productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (b g))
        (fun g z => ν g z.1)) (cleanFullMemoryLift A f) ≤
      M * cleanWeightedNorm (productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (b g))
        (fun g z => ν g z.1)) f := by
  have hw (source : RepeatedBigLists P J ell) : 0 ≤ repeatedBigActiveMass V b source :=
    prod_nonneg fun g _ => prod_nonneg fun j _ =>
      tiltedPhysicalBirthLaw_nonneg V g (b g) (hV g) (hb g) (source g j)
  have he (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
      (v : RepeatedBigLists P J ell → (R × FixedOrderedResidues p) → ℂ) :
      0 ≤ ∑ source, repeatedBigActiveMass V b source * ∑ r, ‖v source r‖ ^ 2 :=
    sum_nonneg fun source _ => mul_nonneg (hw source) (sum_nonneg fun r _ => sq_nonneg _)
  have hfiber (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val)) :
      (∑ source, repeatedBigActiveMass V b source *
        ∑ r, ‖A N p (cleanFullMemorySlice f N p) source r‖ ^ 2) ≤
      M ^ 2 * ∑ source, repeatedBigActiveMass V b source *
        ∑ r, ‖cleanFullMemorySlice f N p source r‖ ^ 2 := by
    have h := pow_le_pow_left₀ (Real.sqrt_nonneg _)
      (hA N p (cleanFullMemorySlice f N p)) 2
    simpa only [mul_pow, cleanWeightedNorm, Real.sq_sqrt (he N p _)] using h
  have hfull :
      (∑ x : CleanFullMemoryState P J ell B,
        productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (b g))
          (fun g z => ν g z.1) x * ∑ r, ‖cleanFullMemoryLift A f x r‖ ^ 2) ≤
      M ^ 2 * ∑ x : CleanFullMemoryState P J ell B,
        productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (b g))
          (fun g z => ν g z.1) x * ∑ r, ‖f x r‖ ^ 2 := by
    rw [clean_full_memory_tilted_residue_energy, clean_full_memory_tilted_residue_energy]
    change (∑ N : G → Fin (B + 1),
      ∑ p : FixedOrderedMemoryLabels P (fun g => (N g).val),
        cleanMemoryLabelWeight ν N p *
          ∑ source : RepeatedBigLists P J ell, repeatedBigActiveMass V b source *
            ∑ r : R × FixedOrderedResidues p,
              ‖cleanFullMemorySlice (cleanFullMemoryLift A f) N p source r‖ ^ 2) ≤
      M ^ 2 * ∑ N : G → Fin (B + 1),
        ∑ p : FixedOrderedMemoryLabels P (fun g => (N g).val),
          cleanMemoryLabelWeight ν N p *
            ∑ source : RepeatedBigLists P J ell, repeatedBigActiveMass V b source *
              ∑ r : R × FixedOrderedResidues p, ‖cleanFullMemorySlice f N p source r‖ ^ 2
    simp only [clean_full_memory_lift_slice]
    calc
      _ ≤ ∑ N : G → Fin (B + 1),
          ∑ p : FixedOrderedMemoryLabels P (fun g => (N g).val),
            cleanMemoryLabelWeight ν N p * (M ^ 2 *
              ∑ source, repeatedBigActiveMass V b source *
                ∑ r, ‖cleanFullMemorySlice f N p source r‖ ^ 2) := by
        apply sum_le_sum
        intro N _
        apply sum_le_sum
        intro p _
        exact mul_le_mul_of_nonneg_left (hfiber N p) (cleanMemoryLabelWeight_nonneg ν hν N p)
      _ = _ := by
        simp only [mul_sum, mul_left_comm]
  have h := Real.sqrt_le_sqrt hfull
  simpa only [cleanWeightedNorm, Real.sqrt_mul (sq_nonneg M), Real.sqrt_sq hM] using h

theorem clean_full_memory_projected_damped_norm_le {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G] [dG : DecidableEq G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell B : ℕ}
    [∀ q : PhysicalPrime Ps, NeZero q.2.val] [∀ g (p : Pb g), NeZero p.val]
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (ν : ∀ g, Pb g → ℝ)
    (hV : ∀ g, 0 ≤ Vb g) (hb : ∀ g p, 0 ≤ b g p) (hν : ∀ g p, 0 ≤ ν g p)
    (C : I → G → Finset (Fin J)) (ζ θ ρ : ℝ) (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1) (k : ℤ)
    (K : ∀ i, RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb (C i) → ℂ)
    (d : PhysicalSharedLists Ps J) (M : ℝ) (hM : 0 ≤ M)
    (hcore : ∀ (N : G → Fin (B + 1))
      (p : FixedOrderedMemoryLabels Pb (fun g => (N g).val))
      (f : RepeatedBigLists Pb J ell → (PhysicalResidues Ps × FixedOrderedResidues p) → ℂ),
      cleanWeightedNorm (repeatedBigActiveMass Vb b) (cleanActiveMap repeatedBigSymmetrizeLinear
        (cleanHybridPatternCoreAction Vb b C ζ θ k p K d
          (cleanActiveMap repeatedBigSymmetrizeLinear f))) ≤
            M * cleanWeightedNorm (repeatedBigActiveMass Vb b) f)
    (f : CleanFullMemoryState Pb J ell B → PhysicalResidues Ps → ℂ) :
    cleanWeightedNorm (productMemoryWeight (fun g => tiltedPhysicalBirthLaw Vb g (b g))
        (fun g z => ν g z.1))
      (cleanFullMemoryActiveMap (cleanFullMemoryPatternDampedAction Vb b C ζ θ ρ k K d
        (cleanFullMemoryActiveMap f))) ≤
      M * cleanWeightedNorm (productMemoryWeight (fun g => tiltedPhysicalBirthLaw Vb g (b g))
        (fun g z => ν g z.1)) f := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  rw [clean_full_memory_projected_damped_lift]
  apply clean_full_memory_lift_norm_le (R := PhysicalResidues Ps) Vb b ν hV hb hν
    (fun (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels Pb (fun g => (N g).val)) v =>
      cleanActiveMap repeatedBigSymmetrizeLinear
        (cleanHybridPatternDampedAction Vb b C ζ θ ρ k (fun _ => B) p K d
          (cleanActiveMap repeatedBigSymmetrizeLinear v))) M hM _ f
  intro N p v
  have hw (source : RepeatedBigLists Pb J ell) : 0 ≤ repeatedBigActiveMass Vb b source :=
    prod_nonneg fun g _ => prod_nonneg fun j _ =>
      tiltedPhysicalBirthLaw_nonneg Vb g (b g) (hV g) (hb g) (source g j)
  exact clean_hybrid_projected_damped_norm_le Vb b C ζ θ ρ hρ0 hρ1 k
    (fun _ => B) p K d repeatedBigSymmetrizeLinear (repeatedBigActiveMass Vb b) hw
      M hM (hcore N p) v

end Bounty
end

section

/- Actual Q-list majorants retain every small-prime exclusion forced by the omitted bands. -/

open Finset

namespace Bounty

def smallPrimeDivisorsSupported (z : ℝ) (n d : ℕ) : Prop :=
  ∀ p : ℕ, p.Prime → (p : ℝ) ≤ z → p ∣ n → p ∣ d

noncomputable def candidateMicroQMajorant (c L : ℝ) (r jStar J : ℕ) (z : ℝ) (n : ℕ) : ℝ := by
  classical
  exact ∑ x : ∀ i, candidateMicroQSlotChoices c L r jStar J i,
    if orderedSlotProduct (candidateMicroQSlotChoices c L r jStar J) x ∣ n ∧
      smallPrimeDivisorsSupported z n (orderedSlotProduct (candidateMicroQSlotChoices c L r jStar J) x)
    then 1/(r.factorial : ℝ)^(candidateMicroQIndices c L J).card else 0

theorem candidate_Q_weight_le_micro_majorant {c L z : ℝ} (hcL : 0 ≤ c*L)
    (r jStar J : ℕ) (hJ : J ≤ jStar)
    (hz : ∀ j ∈ candidateMacroQIndices c L J, ∀ p ∈ candidateQBand (c*L) j, z < (p : ℝ))
    (n : ℕ) : candidateQWeight c L r jStar n ≤ candidateMicroQMajorant c L r jStar J z n := by
  classical
  rw [candidateQWeight, ordered_slot_weight_equiv _ (candidateQSlotSplit c L r J),
    candidate_Q_choices_split c L r jStar J hJ, candidate_Q_normalization_split]
  unfold candidateMicroQMajorant
  apply ordered_slot_split_majorant _ _ (by positivity)
    (candidate_micro_Q_product_pos c L r jStar J) (candidate_macro_Q_weight_le_one hcL r J)
  intro x y hxy p hp hpz hpn
  rw [← hxy] at hpn
  exact (hp.dvd_mul.mp hpn).resolve_right (candidate_macro_Q_no_small_prime hz y hp hpz)

noncomputable def candidateMicroQFreeMajorant (c L : ℝ) (r jStar J : ℕ)
    (z : ℝ) (P : Finset ℕ) (u : ℕ) : ℝ := by
  classical
  exact ∑ x : ∀ i, candidateMicroQSlotChoices c L r jStar J i,
    if orderedSlotProduct (candidateMicroQSlotChoices c L r jStar J) x ∣ u ∧
      (∀ p : ℕ, p.Prime → (p : ℝ) ≤ z → p ∉ P →
        p ∣ u → p ∣ orderedSlotProduct (candidateMicroQSlotChoices c L r jStar J) x)
    then 1/(r.factorial : ℝ)^(candidateMicroQIndices c L J).card else 0

theorem candidate_Q_free_weight_le_micro_majorant {c L z : ℝ} (hcL : 0 ≤ c*L)
    (r jStar J : ℕ) (hJ : J ≤ jStar)
    (hz : ∀ j ∈ candidateMacroQIndices c L J, ∀ p ∈ candidateQBand (c*L) j, z < (p : ℝ))
    (P : Finset ℕ) (u : ℕ) :
    candidateQWeight c L r jStar (primePoolFreePart P u) ≤
      candidateMicroQFreeMajorant c L r jStar J z P u := by
  classical
  refine (candidate_Q_weight_le_micro_majorant hcL r jStar J hJ hz _).trans ?_
  unfold candidateMicroQMajorant candidateMicroQFreeMajorant
  apply sum_le_sum
  intro x _
  split_ifs with h h'
  · exact le_rfl
  · exfalso
    apply h'
    refine ⟨h.1.trans (Nat.div_dvd_of_dvd (primePoolPart_dvd P u)), ?_⟩
    intro p hp hpz hpP hpu
    exact h.2 p hp hpz ((prime_dvd_primePoolFreePart_iff hp hpP).mpr hpu)
  · positivity
  · exact le_rfl

end Bounty
end

section

/- The retained cutoff leaves every omitted Q prime above the sieve level. -/

open Finset

namespace Bounty

theorem candidate_macro_Q_band_above {c L θ : ℝ} (hc : 0 ≤ c) (hL : 0 < L)
    (J : ℕ) (hθ : θ < 2*c/(2 : ℝ)^J) :
    ∀ j ∈ candidateMacroQIndices c L J, ∀ p ∈ candidateQBand (c*L) j,
      Real.exp (θ*L) < (p : ℝ) := by
  intro j hj p hp
  have hjJ : j < J := (mem_filter.mp hj).2
  have hpL := ((mem_dyadicPrimeBand_iff (c*L) 1 (6/5) j p).mp hp).2.1
  have hpow : (2 : ℝ)^(j+1) ≤ 2^J := pow_le_pow_right₀ (by norm_num) (Nat.succ_le_of_lt hjJ)
  have hdiv : 2*c/(2 : ℝ)^J ≤ c/(2 : ℝ)^j := by
    calc
      _ ≤ 2*c/(2 : ℝ)^(j+1) := div_le_div_of_nonneg_left (by positivity) (by positivity) hpow
      _ = _ := by rw [pow_succ]; field_simp
  have hexp : θ*L < (c*L)/(2 : ℝ)^j := by
    calc
      θ*L < (c/(2 : ℝ)^j)*L := mul_lt_mul_of_pos_right (hθ.trans_le hdiv) hL
      _ = _ := by ring
  apply lt_trans (Real.exp_lt_exp.mpr hexp)
  simpa only [one_mul] using hpL

end Bounty
end

section

/- Combining a pool-free divisor with its distinct marked primes. -/

open Finset

namespace Bounty

def primeAssignmentCondition (P : Finset ℕ) (z : ℝ) (u d : ℕ) : Prop :=
  d ∣ u ∧ ∀ p : ℕ, p.Prime → (p : ℝ) ≤ z → p ∉ P → p ∣ u → p ∣ d

noncomputable def primeAssignmentTerm (P : Finset ℕ) (q z normalization : ℝ) (u d : ℕ) : ℝ := by
  classical
  exact if primeAssignmentCondition P z u d then
    q^(((P \ d.primeFactors).filter (fun p => p ∣ u)).card) / normalization else 0

theorem prime_assignment_term_nonneg (P : Finset ℕ) {q : ℝ} (hq : 0 ≤ q)
    (z : ℝ) {normalization : ℝ} (hN : 0 ≤ normalization) (u d : ℕ) :
    0 ≤ primeAssignmentTerm P q z normalization u d := by
  unfold primeAssignmentTerm
  split_ifs <;> positivity

theorem free_mark_unmarked_set {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h))) (x : ∀ g, P g)
    {d : ℕ} (hd : d ≠ 0) (hfree : Disjoint d.primeFactors (univ.biUnion P)) (u : ℕ) :
    (((univ.biUnion P) \ (d * orderedSlotProduct P x).primeFactors).filter (fun p => p ∣ u)) =
      unmarkedDivisorSet P x u := by
  classical
  rw [Nat.primeFactors_mul hd (chosen_mark_product_ne_zero P hprime x),
    chosen_mark_product_primeFactors P hprime hdisj x]
  ext p
  simp only [mem_filter, mem_sdiff, mem_union, unmarkedDivisorSet]
  have hf : p ∈ univ.biUnion P → p ∉ d.primeFactors := fun hp hd => disjoint_left.mp hfree hd hp
  tauto

theorem free_mark_assignment_term {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h))) (x : ∀ g, P g)
    {d : ℕ} (hd : d ≠ 0) (hfree : Disjoint d.primeFactors (univ.biUnion P))
    {q α β : ℝ} (hq : 0 ≤ q) (hα : 0 ≤ α) (hβ : 0 ≤ β) (z : ℝ) (u : ℕ)
    [Decidable (primeAssignmentCondition (univ.biUnion P) z u d)] :
    (if primeAssignmentCondition (univ.biUnion P) z u d then 1/α else 0) *
      (if ∀ g, (x g).val ∣ u then q^(unmarkedDivisorSet P x u).card / β else 0) ≤
        primeAssignmentTerm (univ.biUnion P) q z (α*β) u (d * orderedSlotProduct P x) := by
  classical
  by_cases hc : primeAssignmentCondition (univ.biUnion P) z u d
  · rw [if_pos hc]
    by_cases hx : ∀ g, (x g).val ∣ u
    · rw [if_pos hx]
      have hcop : d.Coprime (orderedSlotProduct P x) :=
        (Nat.disjoint_primeFactors hd (chosen_mark_product_ne_zero P hprime x)).mp
          (hfree.mono (subset_refl _) (chosen_mark_product_support P hprime hdisj x))
      have hcond : primeAssignmentCondition (univ.biUnion P) z u (d * orderedSlotProduct P x) := by
        refine ⟨hcop.mul_dvd_of_dvd_of_dvd hc.1 (chosen_mark_product_dvd P hprime hdisj x u hx), ?_⟩
        intro p hp hpz hpP hpu
        exact (hc.2 p hp hpz hpP hpu).trans (dvd_mul_right _ _)
      rw [primeAssignmentTerm, if_pos hcond, free_mark_unmarked_set P hprime hdisj x hd hfree u]
      apply le_of_eq
      ring
    · rw [if_neg hx, mul_zero]
      exact prime_assignment_term_nonneg _ hq z (mul_nonneg hα hβ) u _
  · rw [if_neg hc, zero_mul]
    exact prime_assignment_term_nonneg _ hq z (mul_nonneg hα hβ) u _

end Bounty
end

section

/- Concrete tilted prime-atom costs for the original local ghost and edge events. -/

open Finset Classical

namespace Bounty

section Tilted
variable {G : Type*} {P : G → Finset ℕ} (V : G → ℝ) (g : G) (baseline : P g → ℝ)
    {P₀ : ℝ} (p : P g)
    (ρ : ℝ) (t B : ℕ)
    (s : BoundedOrderedState (P g)
      (UnrestrictedResidueParticle (fun p : P g => p.val)) t B)

theorem tilted_unrestricted_bounded_fresh_slot_le
    (hV : 0 < V g) (hbaseline : ∀ p, 1 / 2 ≤ baseline p)
    (hP₀ : 0 < P₀) (hp : P₀ ≤ (p.val : ℝ)) (Δ D : ℤ)
    (stores promotions : Finset (Fin t))
    (e : promotions ↪ ↥(unrestrictedResidueEligible (fun p : P g => p.val) Δ D s.2.2))
    (i : {j : Fin t // j ∉ promotions})
    (F : ({j : {j : Fin t // j ∉ promotions} // j ≠ i} → P g) → ℝ)
    (hρ : 0 ≤ ρ) (hF : ∀ f, 0 ≤ F f) :
    (∑ fresh : UnrestrictedFreshLabels (P g) promotions, if fresh i = p then
      unrestrictedBoundedEventWeight (fun p : P g => p.val) Δ D
        (tiltedPhysicalBirthLaw V g baseline) ρ (V g) t B s
        ⟨stores, promotions, e, fresh⟩ * F (fun j => fresh j.1) else 0) ≤
      (2 / (V g * P₀)) *
        (unrestrictedBoundedSkeletonMass (fun p : P g => p.val) Δ D ρ (V g)
          t B s stores promotions e *
          ∑ fresh : {j : {j : Fin t // j ∉ promotions} // j ≠ i} → P g,
            (∏ j, tiltedPhysicalBirthLaw V g baseline (fresh j)) * F fresh) := by
  apply unrestricted_bounded_fresh_slot_le _ Δ D _ ρ (V g) t B s stores promotions e i p F
    hρ hV.le
  · exact tiltedPhysicalBirthLaw_nonneg V g baseline hV.le
      (fun p => le_trans (by norm_num) (hbaseline p))
  · exact hF
  · exact tiltedPhysicalBirthLaw_atom_le V g baseline hV hP₀ p hp (hbaseline p)

theorem tilted_bounded_physical_ghost_slot_le [∀ p : P g, NeZero p.val]
    (hV : 0 < V g) (hbaseline : ∀ p, 1 / 2 ≤ baseline p)
    (hP₀ : 0 < P₀) (hp : P₀ ≤ (p.val : ℝ))
    (q : ℝ) (b : Fin (B + 1)) (retained : Finset (Fin s.2.1.val)) (i : Fin b.val)
    (F : ({j : Fin b.val // j ≠ i} →
      UnrestrictedResidueParticle (fun p : P g => p.val)) → ℝ)
    (hF : ∀ f, 0 ≤ F f) :
    (∑ births : Fin b.val → UnrestrictedResidueParticle (fun p : P g => p.val),
      if (births i).1 = p then
        |boundedGhostEventWeight (physicalGhostRetention (fun p : P g => p.val) q ρ)
          (physicalGhostTermination (fun p : P g => p.val) q ρ)
          (physicalGhostBirth (fun p : P g => p.val) q ρ (V g))
          (unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g baseline))
          t B s ⟨b, retained, births⟩| * F (fun j => births j.1) else 0) ≤
      (|(1 - q) / ρ| * (2 / P₀)) *
        (boundedGhostSkeletonAbsMass (physicalGhostRetention (fun p : P g => p.val) q ρ)
          (physicalGhostTermination (fun p : P g => p.val) q ρ) t B s b retained *
          ∑ births : {j : Fin b.val // j ≠ i} →
              UnrestrictedResidueParticle (fun p : P g => p.val),
            (∏ j, physicalGhostBirthAtom (fun p : P g => p.val)
              (tiltedPhysicalBirthLaw V g baseline) q ρ (V g) (births j)) * F births) := by
  apply bounded_physical_ghost_slot_le _ _ q ρ (V g) t B s b retained i p F
  · exact tiltedPhysicalBirthLaw_nonneg V g baseline hV.le
      (fun p => le_trans (by norm_num) (hbaseline p))
  · exact hF
  · have h := physical_ghost_birth_atom_tilted_le V g baseline q ρ hV hP₀ p hp (hbaseline p)
    rwa [physical_ghost_birth_atom_prime_sum] at h

end Tilted

theorem tagged_prime_atom_sum {G : Type*} {P : G → Type*}
    (g : G) [Fintype (P g)] (μ : P g → ℝ) (p : P g) :
    (∑ r : P g, if (⟨g, r⟩ : Sigma P) = ⟨g, p⟩ then μ r else 0) = μ p := by
  simp only [Sigma.mk.inj_iff, heq_eq_eq, true_and, sum_ite_eq', mem_univ, if_true]

theorem tagged_prime_atom_other_group {G : Type*} {P : G → Type*}
    (g h : G) [Fintype (P g)] (μ : P g → ℝ) (p : P h) (hne : g ≠ h) :
    (∑ r : P g, if (⟨g, r⟩ : Sigma P) = ⟨h, p⟩ then μ r else 0) = 0 := by
  apply sum_eq_zero
  intro r _
  apply if_neg
  intro he
  exact hne (congrArg Sigma.fst he)

end Bounty
end

section

/- The original ghost freshness mask is exactly local birth avoidance and distinctness. -/

open scoped Classical
namespace Bounty
section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ)
  (j : J) (H : (g : Fin N) → Finset (P g))
  (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
  (e : FullPermutationMixedEvent n S B A Δ D (some (.inl j)) s)

theorem full_mixed_ghost_birth_avoids_iff :
    FullMixedLocalBirthAvoids n S B A Δ D H (some (.inl j)) s e ↔
      ∀ g i, ((e.down g).2.2 i).1 ∉ H g := by
  constructor
  · intro h g i
    let a : Fin B := ⟨i.val, lt_of_lt_of_le i.isLt (Nat.le_of_lt_succ (e.down g).1.isLt)⟩
    exact h ⟨g, a⟩ ⟨g, ((e.down g).2.2 i).1⟩
      (full_mixed_ghost_local_label n S B A Δ D j s e g a i.isLt)
  · rintro h ⟨g, i⟩ z hz
    obtain ⟨hi, rfl⟩ := full_mixed_ghost_local_label_some n S B A Δ D j s e g i z hz
    exact h g ⟨i.val, hi⟩

theorem full_mixed_ghost_birth_distinct_iff :
    FullMixedLocalBirthDistinct n S B A Δ D (some (.inl j)) s e ↔
      ∀ g, Function.Injective (fun i => ((e.down g).2.2 i).1) := by
  constructor
  · intro h g i k hik
    let a : Fin B := ⟨i.val, lt_of_lt_of_le i.isLt (Nat.le_of_lt_succ (e.down g).1.isLt)⟩
    let b : Fin B := ⟨k.val, lt_of_lt_of_le k.isLt (Nat.le_of_lt_succ (e.down g).1.isLt)⟩
    have ha := full_mixed_ghost_local_label n S B A Δ D j s e g a i.isLt
    have hb := full_mixed_ghost_local_label n S B A Δ D j s e g b k.isLt
    have hab := h ⟨g, a⟩ ⟨g, b⟩ ⟨g, ((e.down g).2.2 i).1⟩ ha (by simpa only [hik] using hb)
    exact Fin.ext (congrArg (fun c => c.2.val) hab)
  · rintro h ⟨g, i⟩ ⟨k, l⟩ z hi hl
    obtain ⟨hi', rfl⟩ := full_mixed_ghost_local_label_some n S B A Δ D j s e g i z hi
    obtain ⟨hl', hz⟩ := full_mixed_ghost_local_label_some n S B A Δ D j s e k l _ hl
    have hgk : g = k := congrArg Sigma.fst hz
    subst k
    have hp : ((e.down g).2.2 ⟨i.val, hi'⟩).1 = ((e.down g).2.2 ⟨l.val, hl'⟩).1 := by
      simpa only [Sigma.mk.inj_iff, heq_eq_eq, true_and] using hz
    have heq : i.val = l.val :=
      congrArg (fun u : Fin (e.down g).1.val => u.val) (h g hp)
    have hil : i = l := Fin.ext heq
    subst l
    rfl

theorem bounded_ghost_joint_fresh_birth_iff :
    boundedGhostJointFresh n M B (fun g => (H g, s g)) e.down ↔
      FullMixedLocalBirthAvoids n S B A Δ D H (some (.inl j)) s e ∧
        FullMixedLocalBirthDistinct n S B A Δ D (some (.inl j)) s e := by
  rw [full_mixed_ghost_birth_avoids_iff, full_mixed_ghost_birth_distinct_iff]
  change (∀ g, Function.Injective (fun i => ((e.down g).2.2 i).1) ∧
    ∀ i, ((e.down g).2.2 i).1 ∉ H g) ↔ _
  constructor
  · exact fun h => ⟨fun g => (h g).2, fun g => (h g).1⟩
  · exact fun h g => ⟨h.2 g, h.1 g⟩

theorem full_mixed_ghost_freshness_phase_birth_mask :
    fullMixedGhostFreshnessPhase n S B A Δ D j (fun g => (H g, s g)) e =
      if FullMixedLocalBirthAvoids n S B A Δ D H (some (.inl j)) s e ∧
        FullMixedLocalBirthDistinct n S B A Δ D (some (.inl j)) s e then 1 else 0 := by
  unfold fullMixedGhostFreshnessPhase
  rw [bounded_ghost_joint_fresh_birth_iff n S B A Δ D j H s e]
  split_ifs <;> rfl

theorem full_mixed_ghost_freshness_phase_factor :
    fullMixedGhostFreshnessPhase n S B A Δ D j (fun g => (H g, s g)) e =
      (if FullMixedLocalBirthAvoids n S B A Δ D H (some (.inl j)) s e then 1 else 0) *
      (if FullMixedLocalBirthDistinct n S B A Δ D (some (.inl j)) s e then 1 else 0) := by
  unfold fullMixedGhostFreshnessPhase
  rw [bounded_ghost_joint_fresh_birth_iff n S B A Δ D j H s e]
  split_ifs <;> simp_all

end Full
end Bounty
end

section

/- The fresh unpromoted edge draws are exactly its local performed birth labels. -/

open scoped Classical
namespace Bounty
section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ)
  (k : K) (H : (g : Fin N) → Finset (P g))
  (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
  (e : FullPermutationMixedEvent (J := J) n S B A Δ D (some (.inr k)) s)

theorem full_mixed_edge_birth_avoids_iff :
    FullMixedLocalBirthAvoids n S B A Δ D H (some (.inr k)) s e ↔
      ∀ g i, (e.2 g).2.2.2 i ∉ H g := by
  constructor
  · intro h g i
    exact h ⟨g, i.val⟩ ⟨g, (e.2 g).2.2.2 i⟩
      (full_mixed_edge_local_label n S B A Δ D k s e g i.val i.property)
  · rintro h ⟨g, i⟩ z hz
    obtain ⟨hi, rfl⟩ := full_mixed_edge_local_label_some n S B A Δ D k s e g i z hz
    exact h g ⟨i, hi⟩

theorem full_mixed_edge_birth_distinct_iff :
    FullMixedLocalBirthDistinct n S B A Δ D (some (.inr k)) s e ↔
      ∀ g, Function.Injective (e.2 g).2.2.2 := by
  constructor
  · intro h g i l hil
    have hi := full_mixed_edge_local_label n S B A Δ D k s e g i.val i.property
    have hl := full_mixed_edge_local_label n S B A Δ D k s e g l.val l.property
    have he := h ⟨g, i.val⟩ ⟨g, l.val⟩ ⟨g, (e.2 g).2.2.2 i⟩ hi (by simpa only [hil] using hl)
    exact Subtype.ext (Fin.ext (congrArg (fun c => c.2.val) he))
  · rintro h ⟨g, i⟩ ⟨l, m⟩ z hi hm
    obtain ⟨hi', rfl⟩ := full_mixed_edge_local_label_some n S B A Δ D k s e g i z hi
    obtain ⟨hm', hz⟩ := full_mixed_edge_local_label_some n S B A Δ D k s e l m _ hm
    have hgl : g = l := congrArg Sigma.fst hz
    subst l
    have hp : (e.2 g).2.2.2 ⟨i, hi'⟩ = (e.2 g).2.2.2 ⟨m, hm'⟩ := by
      simpa only [Sigma.mk.inj_iff, heq_eq_eq, true_and] using hz
    have him : i = m := congrArg Subtype.val (h g hp)
    subst m
    rfl

end Full
end Bounty
end

section

/- The literal joint clean event sum retains the common total-memory cap. -/

open Finset
open scoped Classical

namespace Bounty

theorem unrestricted_joint_clean_event_sum {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (Δ D : G → ℤ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (t : G → ℕ) (B : ℕ)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) :
    (∑ e : UnrestrictedJointEvent n Δ D t B s,
      (unrestrictedJointCutoffEventWeight n Δ D μ ρ V t B s e : ℂ) *
        (if ∀ g, (e g).1 = ∅ ∧ (e g).2.1 = ∅ then 1 else 0) *
        f (unrestrictedJointEventTarget n Δ D t B s e)) =
      if productTotalMemory s ≤ B then
        (∏ g, (unrestrictedBoundedCleanFactor (n g) (Δ g) ρ (s g) : ℂ)) *
          ∑ target : (∀ g, Fin (t g) → P g),
            (∏ g, (∏ j, μ g (target g j) : ℝ) : ℂ) *
              f (fun g => unrestrictedBoundedCleanTarget (n g) (Δ g) (s g) (target g))
      else 0 := by
  have h := unrestricted_product_clean_event_sum n Δ D μ ρ V t B f hf s
  calc
    _ = if productTotalMemory s ≤ B then
        (∑ e : UnrestrictedJointEvent n Δ D t B s,
          (∏ g, (if (e g).1 = ∅ ∧ (e g).2.1 = ∅ then
            unrestrictedBoundedEventWeight (n g) (Δ g) (D g) (μ g) ρ (V g) (t g) B (s g) (e g)
            else 0 : ℝ) : ℂ) * f (unrestrictedJointEventTarget n Δ D t B s e))
        else 0 := by
      by_cases hs : productTotalMemory s ≤ B
      · rw [if_pos hs]
        apply sum_congr rfl
        intro e _
        rw [← Complex.ofReal_prod, Fintype.prod_ite_zero]
        by_cases he : ∀ g, (e g).1 = ∅ ∧ (e g).2.1 = ∅
        · rw [if_pos he, if_pos he,
            unrestricted_joint_clean_event_weight n Δ D μ ρ V t B s e he, if_pos hs]
          simp only [mul_one, Complex.ofReal_prod]
        · rw [if_neg he, if_neg he]
          simp
      · rw [if_neg hs]
        apply sum_eq_zero
        intro e _
        simp [unrestrictedJointCutoffEventWeight, hs]
    _ = _ := by rw [h]

theorem unrestricted_joint_clean_event_phase_sum {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (Δ D : G → ℤ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (t : G → ℕ) (B : ℕ) (θ : (∀ g, Fin (t g) → P g) → ℂ)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) :
    (∑ e : UnrestrictedJointEvent n Δ D t B s,
      (unrestrictedJointCutoffEventWeight n Δ D μ ρ V t B s e : ℂ) *
        (if ∀ g, (e g).1 = ∅ ∧ (e g).2.1 = ∅ then
          θ (fun g => (unrestrictedJointEventTarget n Δ D t B s e g).1) else 0) *
        f (unrestrictedJointEventTarget n Δ D t B s e)) =
      if productTotalMemory s ≤ B then
        (∏ g, (unrestrictedBoundedCleanFactor (n g) (Δ g) ρ (s g) : ℂ)) *
          ∑ target : (∀ g, Fin (t g) → P g),
            (∏ g, (∏ j, μ g (target g j) : ℝ) : ℂ) * θ target *
              f (fun g => unrestrictedBoundedCleanTarget (n g) (Δ g) (s g) (target g))
      else 0 := by
  have h := unrestricted_joint_clean_event_sum n Δ D μ ρ V t B
    (fun y => θ (fun g => (y g).1) * f y) (productMemorySymmetric_mul_active θ f hf) s
  calc
    _ = ∑ e : UnrestrictedJointEvent n Δ D t B s,
      (unrestrictedJointCutoffEventWeight n Δ D μ ρ V t B s e : ℂ) *
        (if ∀ g, (e g).1 = ∅ ∧ (e g).2.1 = ∅ then 1 else 0) *
        (θ (fun g => (unrestrictedJointEventTarget n Δ D t B s e g).1) *
          f (unrestrictedJointEventTarget n Δ D t B s e)) := by
      apply sum_congr rfl
      intro e _
      split_ifs <;> simp [mul_assoc]
    _ = _ := by
      simp only [mul_assoc] at h ⊢
      refine h.trans ?_
      split_ifs
      · congr 1
      · rfl

end Bounty
end

section

/- Exact identification of canonical clean fresh integration with the
repeated-list kernel. Every ordered pending occurrence is retained, and
unrestricted transport by `-Δ` is fixed-sector transport by `+Δ`. -/

open Finset
open scoped Classical

namespace Bounty

theorem cleanFullMemoryState_reassemble_clean_target {G : Type*}
    {P : G → Finset ℕ} {J ell B : ℕ} (C : G → Finset (Fin J))
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
    (source : RepeatedBigLists P J ell) (r : FixedOrderedResidues p) (Δ : ℤ)
    (fresh : ∀ g, Fin (cleanFullSharedSlots (ell := ell) C g)ᶜ.card → P g) :
    (productActiveMemorySplit (cleanFullSharedSlots C) B).symm
      ((productActiveMemorySplit (cleanFullSharedSlots C) B
        (cleanFullMemoryState N p source r)).1,
       fun g => unrestrictedBoundedCleanTarget (fun q : P g => q.val) (-Δ)
         ((productActiveMemorySplit (cleanFullSharedSlots C) B
           (cleanFullMemoryState N p source r)).2 g) (fresh g)) =
      cleanFullMemoryState N p (repeatedBigFill C source (cleanFullFreshEquiv P C fresh))
        (fixedOrderedResidueTranslate p r Δ) := by
  have htarget : (fun g => unrestrictedBoundedCleanTarget (fun q : P g => q.val) (-Δ)
      ((productActiveMemorySplit (cleanFullSharedSlots C) B
        (cleanFullMemoryState N p source r)).2 g) (fresh g)) =
      (fun g => (fresh g, (⟨N g, fun j =>
        ⟨p g j, fixedOrderedResidueTranslate p r Δ g j⟩⟩ :
          BoundedOrderedTuple (UnrestrictedResidueParticle (fun q : P g => q.val)) B))) := by
    funext g
    exact unrestricted_bounded_clean_target_fixed_memory N p r g Δ _ _
  rw [htarget]
  exact cleanFullMemoryState_reassemble_fill C N p source
    (fixedOrderedResidueTranslate p r Δ) fresh

theorem cleanFullMemoryState_clean_factor {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell B : ℕ} (C : G → Finset (Fin J))
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
    (source : RepeatedBigLists P J ell) (r : FixedOrderedResidues p) (Δ : ℤ) (ρ : ℝ) :
    (∏ g, unrestrictedBoundedCleanFactor (fun q : P g => q.val) (-Δ) ρ
      ((productActiveMemorySplit (cleanFullSharedSlots C) B
        (cleanFullMemoryState N p source r)).2 g)) =
      cleanHybridMemoryFactor ρ (fun _ => B) p r Δ := by
  unfold cleanHybridMemoryFactor
  apply prod_congr rfl
  intro g _
  rw [if_pos (Nat.le_of_lt_succ (N g).isLt)]
  unfold unrestrictedBoundedCleanFactor
  have htarget := unrestricted_bounded_clean_target_fixed_memory N p r g Δ
    ((productActiveMemorySplit (cleanFullSharedSlots C) B
      (cleanFullMemoryState N p source r)).2 g).1
    ((productActiveMemorySplit (cleanFullSharedSlots C) B
      (cleanFullMemoryState N p source r)).2 g).1
  change unrestrictedBoundedCleanTarget (fun q : P g => q.val) (-Δ)
    ((productActiveMemorySplit (cleanFullSharedSlots C) B
      (cleanFullMemoryState N p source r)).2 g)
    ((productActiveMemorySplit (cleanFullSharedSlots C) B
      (cleanFullMemoryState N p source r)).2 g).1 = _ at htarget
  rw [htarget]
  rfl

/-- The physical phases and both auxiliary-label bans are retained exactly. -/
theorem clean_full_memory_fresh_kernel_row {S G : Type*}
    [Fintype S] [Fintype G] [dG : DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    (V : G → ℝ) (b : ∀ g, P g → ℝ) (C : G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ) (N : G → Fin (B + 1))
    (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
    (r : FixedOrderedResidues p) (d : PhysicalSharedLists Ps J)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (source : RepeatedBigLists P J ell)
    (f : CleanFullMemoryState P J ell B → ℂ) :
    let Δ := cleanHybridStep k C source aux d
    (physicalAuxMass V C aux : ℂ) *
      (∏ g, (unrestrictedBoundedCleanFactor (fun q : P g => q.val) (-Δ) ρ
        ((productActiveMemorySplit (cleanFullSharedSlots C) B
          (cleanFullMemoryState N p source r)).2 g) : ℂ)) *
      (∑ fresh : ∀ g, Fin (cleanFullSharedSlots (ell := ell) C g)ᶜ.card → P g,
        ((∏ g, ∏ i, tiltedPhysicalBirthLaw V g (b g) (fresh g i) : ℝ) : ℂ) *
          (if repeatedBigAuxAvoids C aux source ∧
              repeatedBigAuxAvoids C aux (repeatedBigFill C source (cleanFullFreshEquiv P C fresh)) then
            K source (repeatedBigFill C source (cleanFullFreshEquiv P C fresh)) aux *
              physicalPhase ζ (repeatedBigD C source aux) * physicalReturnPhase θ Δ *
                physicalPhase ζ (physicalSharedProduct d) else 0) *
          f ((productActiveMemorySplit (cleanFullSharedSlots C) B).symm
            ((productActiveMemorySplit (cleanFullSharedSlots C) B
              (cleanFullMemoryState N p source r)).1,
             fun g => unrestrictedBoundedCleanTarget (fun q : P g => q.val) (-Δ)
               ((productActiveMemorySplit (cleanFullSharedSlots C) B
                 (cleanFullMemoryState N p source r)).2 g) (fresh g)))) =
      ∑ target : RepeatedBigLists P J ell,
        (cleanHybridBetweenKernel V b C ζ θ ρ k (fun _ => B) p r K d aux source target *
          physicalPhase ζ (physicalSharedProduct d)) *
            f (cleanFullMemoryState N p target (fixedOrderedResidueTranslate p r Δ)) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  intro Δ
  simp_rw [cleanFullMemoryState_reassemble_clean_target]
  rw [← Complex.ofReal_prod, cleanFullMemoryState_clean_factor]
  let F : RepeatedBigFresh P C ell → ℂ := fun fresh =>
    (if repeatedBigAuxAvoids C aux source ∧
        repeatedBigAuxAvoids C aux (repeatedBigFill C source fresh) then
      K source (repeatedBigFill C source fresh) aux *
        physicalPhase ζ (repeatedBigD C source aux) * physicalReturnPhase θ Δ *
          physicalPhase ζ (physicalSharedProduct d) else 0) *
      f (cleanFullMemoryState N p (repeatedBigFill C source fresh)
        (fixedOrderedResidueTranslate p r Δ))
  have hfresh := clean_full_fresh_weighted_sum V b C F
  simp only [F, ← mul_assoc] at hfresh
  erw [hfresh]
  have hrow := repeated_big_kernel_row V b C ζ K aux source
    (fun target => physicalReturnPhase θ Δ *
      (cleanHybridMemoryFactor ρ (fun _ => B) p r Δ : ℂ) *
      physicalPhase ζ (physicalSharedProduct d) *
      f (cleanFullMemoryState N p target (fixedOrderedResidueTranslate p r Δ)))
  calc
    _ = ∑ fresh : RepeatedBigFresh P C ell,
        if repeatedBigAuxAvoids C aux source ∧
            repeatedBigAuxAvoids C aux (repeatedBigFill C source fresh) then
          ((physicalAuxMass V C aux * repeatedBigFreshMass V b C fresh : ℝ) : ℂ) *
            K source (repeatedBigFill C source fresh) aux *
            physicalPhase ζ (repeatedBigD C source aux) *
            (physicalReturnPhase θ Δ * (cleanHybridMemoryFactor ρ (fun _ => B) p r Δ : ℂ) *
              physicalPhase ζ (physicalSharedProduct d) *
              f (cleanFullMemoryState N p (repeatedBigFill C source fresh)
                (fixedOrderedResidueTranslate p r Δ))) else 0 := by
      rw [mul_sum]
      apply sum_congr rfl
      intro fresh _
      split_ifs <;> simp only [Complex.ofReal_mul, mul_zero, zero_mul]
      ring
    _ = _ := hrow
    _ = _ := by
      apply sum_congr rfl
      intro target _
      dsimp only [cleanHybridBetweenKernel, Δ]
      ring

end Bounty
end

section

/- Selected birth kernels retain arbitrary nonnegative continuation at the actual target. -/

open Finset Classical

namespace Bounty

theorem physical_ghost_birth_atom_weighted_sum {P : Type*} [Fintype P] [DecidableEq P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (q ρ V : ℝ) (p : P)
    (F : UnrestrictedResidueParticle n → ℝ) :
    (∑ z : UnrestrictedResidueParticle n, if z.1 = p then
      physicalGhostBirthAtom n μ q ρ V z * F z else 0) =
      (|(1 - q) * V / ρ| * μ p) * F (unrestrictedResidueSeed n p) := by
  rw [Fintype.sum_sigma, sum_eq_single p]
  · simp only [ite_true]
    rw [sum_eq_single (0 : ZMod (n p))]
    · simp [physicalGhostBirthAtom, physicalGhostBirth, unrestrictedResidueHit,
        unrestrictedResidueWeight, unrestrictedResidueSeed]
    · intro r _ hr
      simp [physicalGhostBirthAtom, physicalGhostBirth, unrestrictedResidueHit, hr]
    · simp
  · intro a _ ha
    simp only [ha, if_false, sum_const_zero]
  · simp

section Edge
variable {P : Type*} [Fintype P] [DecidableEq P] (n : P → ℕ) (Δ D : ℤ)
    (μ : P → ℝ) (ρ V : ℝ) (t B : ℕ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (stores promotions : Finset (Fin t))
    (e : promotions ↪ ↥(unrestrictedResidueEligible n Δ D s.2.2))
    (i : {j : Fin t // j ∉ promotions}) (p : P)
    (F : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℝ)

theorem unrestricted_bounded_fresh_target_kernel :
    (∑ fresh : UnrestrictedFreshLabels P promotions, if fresh i = p then
      unrestrictedBoundedEventWeight n Δ D μ ρ V t B s ⟨stores, promotions, e, fresh⟩ *
        F (unrestrictedBoundedEventTarget n Δ D t B s ⟨stores, promotions, e, fresh⟩) else 0) =
      μ p * (unrestrictedBoundedSkeletonMass n Δ D ρ V t B s stores promotions e *
        ∑ rest : {j : {j : Fin t // j ∉ promotions} // j ≠ i} → P,
          (∏ j, μ (rest j)) * F (unrestrictedBoundedEventTarget n Δ D t B s
            ⟨stores, promotions, e, birthCoordinateInsert (fun _ => P) i p rest⟩)) := by
  simp_rw [unrestricted_bounded_event_fresh_factor, unrestrictedFreshWeight]
  exact selected_coordinate_value_kernel_sum (fun _ => P) i (fun _ => μ) p _
    (fun fresh => F (unrestrictedBoundedEventTarget n Δ D t B s
      ⟨stores, promotions, e, fresh⟩))

theorem unrestricted_bounded_fresh_target_kernel_le
    (hρ : 0 ≤ ρ) (hV : 0 ≤ V) (hμ : ∀ p, 0 ≤ μ p) (hF : ∀ x, 0 ≤ F x)
    {ε : ℝ} (hatom : μ p ≤ ε) :
    (∑ fresh : UnrestrictedFreshLabels P promotions, if fresh i = p then
      unrestrictedBoundedEventWeight n Δ D μ ρ V t B s ⟨stores, promotions, e, fresh⟩ *
        F (unrestrictedBoundedEventTarget n Δ D t B s ⟨stores, promotions, e, fresh⟩) else 0) ≤
      ε * (unrestrictedBoundedSkeletonMass n Δ D ρ V t B s stores promotions e *
        ∑ rest : {j : {j : Fin t // j ∉ promotions} // j ≠ i} → P,
          (∏ j, μ (rest j)) * F (unrestrictedBoundedEventTarget n Δ D t B s
            ⟨stores, promotions, e, birthCoordinateInsert (fun _ => P) i p rest⟩)) := by
  rw [unrestricted_bounded_fresh_target_kernel]
  exact mul_le_mul_of_nonneg_right hatom (mul_nonneg
    (unrestricted_bounded_skeleton_mass_nonneg n Δ D ρ V hρ hV t B s stores promotions e)
    (sum_nonneg fun rest _ => mul_nonneg (prod_nonneg fun j _ => hμ _) (hF _)))

end Edge

section Ghost
variable {P : Type*} [Fintype P] [DecidableEq P] (n : P → ℕ) [∀ p, NeZero (n p)]
    (μ : P → ℝ) (q ρ V : ℝ) (t B : ℕ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (b : Fin (B + 1)) (retained : Finset (Fin s.2.1.val)) (i : Fin b.val) (p : P)
    (F : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℝ)

theorem bounded_physical_ghost_target_kernel (hμ : ∀ p, 0 ≤ μ p) :
    (∑ births : Fin b.val → UnrestrictedResidueParticle n, if (births i).1 = p then
      |boundedGhostEventWeight (physicalGhostRetention n q ρ) (physicalGhostTermination n q ρ)
        (physicalGhostBirth n q ρ V) (unrestrictedResidueWeight μ)
        t B s ⟨b, retained, births⟩| * F (boundedGhostEventTarget t B s ⟨b, retained, births⟩)
      else 0) =
      (|(1 - q) * V / ρ| * μ p) *
        (boundedGhostSkeletonAbsMass (physicalGhostRetention n q ρ)
          (physicalGhostTermination n q ρ) t B s b retained *
          ∑ rest : {j : Fin b.val // j ≠ i} → UnrestrictedResidueParticle n,
            (∏ j, physicalGhostBirthAtom n μ q ρ V (rest j)) *
              F (boundedGhostEventTarget t B s ⟨b, retained,
                birthCoordinateInsert (fun _ => UnrestrictedResidueParticle n) i
                  (unrestrictedResidueSeed n p) rest⟩)) := by
  simp_rw [bounded_ghost_event_abs_factor (physicalGhostRetention n q ρ)
    (physicalGhostTermination n q ρ) (physicalGhostBirth n q ρ V)
    (unrestrictedResidueWeight μ) (fun z : UnrestrictedResidueParticle n => hμ z.1)
    t B s b retained]
  change (∑ births : Fin b.val → UnrestrictedResidueParticle n, if (births i).1 = p then
    (_ * ∏ j, physicalGhostBirthAtom n μ q ρ V (births j)) *
      F (boundedGhostEventTarget t B s ⟨b, retained, births⟩) else 0) = _
  rw [selected_coordinate_kernel_sum]
  exact physical_ghost_birth_atom_weighted_sum n μ q ρ V p _

theorem bounded_physical_ghost_target_kernel_le (hμ : ∀ p, 0 ≤ μ p)
    (hF : ∀ x, 0 ≤ F x) {ε : ℝ} (hatom : |(1 - q) * V / ρ| * μ p ≤ ε) :
    (∑ births : Fin b.val → UnrestrictedResidueParticle n, if (births i).1 = p then
      |boundedGhostEventWeight (physicalGhostRetention n q ρ) (physicalGhostTermination n q ρ)
        (physicalGhostBirth n q ρ V) (unrestrictedResidueWeight μ)
        t B s ⟨b, retained, births⟩| * F (boundedGhostEventTarget t B s ⟨b, retained, births⟩)
      else 0) ≤
      ε * (boundedGhostSkeletonAbsMass (physicalGhostRetention n q ρ)
        (physicalGhostTermination n q ρ) t B s b retained *
        ∑ rest : {j : Fin b.val // j ≠ i} → UnrestrictedResidueParticle n,
          (∏ j, physicalGhostBirthAtom n μ q ρ V (rest j)) *
            F (boundedGhostEventTarget t B s ⟨b, retained,
              birthCoordinateInsert (fun _ => UnrestrictedResidueParticle n) i
                (unrestrictedResidueSeed n p) rest⟩)) := by
  rw [bounded_physical_ghost_target_kernel n μ q ρ V t B s b retained i p F hμ]
  exact mul_le_mul_of_nonneg_right hatom (mul_nonneg
    (bounded_ghost_skeleton_abs_mass_nonneg _ _ t B s b retained)
    (sum_nonneg fun rest _ => mul_nonneg
      (prod_nonneg fun j _ => physical_ghost_birth_atom_nonneg n μ q ρ V hμ _) (hF _)))

end Ghost

end Bounty
end

section

/- Pinned-prime kernels for a complete original full edge, with the exact target continuation. -/

open Finset Classical

namespace Bounty

section Edge
variable {G : Type*} [Fintype G] [DecidableEq G] {P : G → Type*}
    [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : SharedActiveLabels P S → Type*) (Δ D : ∀ c, A c → G → ℤ)
    (ω : ∀ c, A c → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (sk : FullActiveEdgeSkeleton n S B A Δ D s)
    (i : FullActiveEdgeSampleIndex n S B A Δ D s sk) (p : P i.1)
    (F : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℝ)

noncomputable def fullEdgePinnedBirthKernel : ℝ :=
  fullActiveEdgeSkeletonAbsMass n S B A Δ D ω ρ V s sk *
  ∑ rest : (j : {j : FullActiveEdgeSampleIndex n S B A Δ D s sk // j ≠ i}) → P j.1.1,
    (∏ j, μ j.1.1 (rest j)) *
      F (fullActiveEdgeEventTarget n S B A Δ D s ((fullActiveEdgeSkeletonEquiv n S B A Δ D s).symm
        ⟨sk, birthCoordinateInsert (fun j => P j.1) i p rest⟩))

theorem full_edge_pinned_birth_kernel_nonneg (hμ : ∀ g p, 0 ≤ μ g p)
    (hF : ∀ x, 0 ≤ F x) :
    0 ≤ fullEdgePinnedBirthKernel n S B A Δ D ω μ ρ V s sk i p F := by
  apply mul_nonneg (full_active_edge_skeleton_abs_mass_nonneg _ _ _ _ _ _ _ _ _ _ _)
  exact sum_nonneg fun rest _ => mul_nonneg (prod_nonneg fun j _ => hμ j.1.1 _) (hF _)

theorem full_edge_pinned_kernel_eq [DecidableEq (P i.1)] (hμ : ∀ g p, 0 ≤ μ g p) :
    (∑ fresh : FullActiveEdgeSamples n S B A Δ D s sk, if fresh i = p then
      |fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V s
        ((fullActiveEdgeSkeletonEquiv n S B A Δ D s).symm ⟨sk, fresh⟩)| *
      F (fullActiveEdgeEventTarget n S B A Δ D s
        ((fullActiveEdgeSkeletonEquiv n S B A Δ D s).symm ⟨sk, fresh⟩)) else 0) =
      μ i.1 p * fullEdgePinnedBirthKernel n S B A Δ D ω μ ρ V s sk i p F := by
  unfold fullEdgePinnedBirthKernel
  simp_rw [full_active_edge_skeleton_weight_factor n S B A Δ D ω ρ V s sk μ hμ]
  exact selected_coordinate_value_kernel_sum (fun j => P j.1) i (fun j => μ j.1) p _
    (fun fresh => F (fullActiveEdgeEventTarget n S B A Δ D s
      ((fullActiveEdgeSkeletonEquiv n S B A Δ D s).symm ⟨sk, fresh⟩)))

theorem full_edge_pinned_kernel_le [DecidableEq (P i.1)] (hμ : ∀ g p, 0 ≤ μ g p)
    (hF : ∀ x, 0 ≤ F x) {ε : ℝ} (hatom : μ i.1 p ≤ ε) :
    (∑ fresh : FullActiveEdgeSamples n S B A Δ D s sk, if fresh i = p then
      |fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V s
        ((fullActiveEdgeSkeletonEquiv n S B A Δ D s).symm ⟨sk, fresh⟩)| *
      F (fullActiveEdgeEventTarget n S B A Δ D s
        ((fullActiveEdgeSkeletonEquiv n S B A Δ D s).symm ⟨sk, fresh⟩)) else 0) ≤
      ε * fullEdgePinnedBirthKernel n S B A Δ D ω μ ρ V s sk i p F := by
  rw [full_edge_pinned_kernel_eq n S B A Δ D ω μ ρ V s sk i p F hμ]
  exact mul_le_mul_of_nonneg_right hatom
    (full_edge_pinned_birth_kernel_nonneg n S B A Δ D ω μ ρ V s sk i p F hμ hF)

end Edge

end Bounty
end

section

/- Exact clean fresh-tuple transport from the original physical slot order
to the canonical first/tail order. Shared source labels are retained, and
replacement pending memories are unrestricted and unchanged. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def physicalCleanUnsharedEquiv {G : Type*} {J ell : ℕ}
    (C : G → Finset (Fin J)) (g : G) :
    ↥((physicalFullSharedIndices (ell := ell) (C g))ᶜ) ≃
      ↥((cleanFullSharedSlots (ell := ell) C g)ᶜ) where
  toFun i := ⟨cleanPhysicalSlotChange C g i.val, mem_compl.mpr (by
    rw [clean_physical_slot_change_shared]
    exact mem_compl.mp i.property)⟩
  invFun j := ⟨(cleanPhysicalSlotChange C g).symm j.val, mem_compl.mpr (by
    have h := clean_physical_slot_change_shared C g ((cleanPhysicalSlotChange C g).symm j.val)
    rw [Equiv.apply_symm_apply] at h
    exact mt h.mpr (mem_compl.mp j.property))⟩
  left_inv i := Subtype.ext ((cleanPhysicalSlotChange C g).symm_apply_apply i.val)
  right_inv j := Subtype.ext ((cleanPhysicalSlotChange C g).apply_symm_apply j.val)

noncomputable def physicalCleanFreshIndex {G : Type*} {J ell : ℕ}
    (C : G → Finset (Fin J)) (g : G) :
    Fin ((physicalFullSharedIndices (ell := ell) (C g))ᶜ.card) ≃
      Fin ((cleanFullSharedSlots (ell := ell) C g)ᶜ.card) :=
  ((physicalFullSharedIndices (ell := ell) (C g))ᶜ.equivFin.symm.trans
    (physicalCleanUnsharedEquiv C g)).trans (cleanFullSharedSlots C g)ᶜ.equivFin

noncomputable def physicalCleanFreshEquiv {G : Type*} (P : G → Type*) {J ell : ℕ}
    (C : G → Finset (Fin J)) :
    (∀ g, Fin ((physicalFullSharedIndices (ell := ell) (C g))ᶜ.card) → P g) ≃
      (∀ g, Fin ((cleanFullSharedSlots (ell := ell) C g)ᶜ.card) → P g) :=
  Equiv.piCongrRight (fun g => Equiv.arrowCongr (physicalCleanFreshIndex C g) (Equiv.refl (P g)))

theorem physicalCleanFreshEquiv_apply_index {G : Type*} (P : G → Type*) {J ell : ℕ}
    (C : G → Finset (Fin J))
    (fresh : ∀ g, Fin ((physicalFullSharedIndices (ell := ell) (C g))ᶜ.card) → P g)
    (g : G) (i : Fin ((physicalFullSharedIndices (ell := ell) (C g))ᶜ.card)) :
    physicalCleanFreshEquiv P C fresh g (physicalCleanFreshIndex C g i) = fresh g i := by
  change fresh g ((physicalCleanFreshIndex C g).symm (physicalCleanFreshIndex C g i)) = _
  rw [Equiv.symm_apply_apply]

theorem physicalCleanFreshEquiv_apply_subtype {G : Type*} (P : G → Type*) {J ell : ℕ}
    (C : G → Finset (Fin J))
    (fresh : ∀ g, Fin ((physicalFullSharedIndices (ell := ell) (C g))ᶜ.card) → P g)
    (g : G) (i : ↥((physicalFullSharedIndices (ell := ell) (C g))ᶜ)) :
    physicalCleanFreshEquiv P C fresh g
      ((cleanFullSharedSlots C g)ᶜ.equivFin (physicalCleanUnsharedEquiv C g i)) =
        fresh g ((physicalFullSharedIndices (C g))ᶜ.equivFin i) := by
  have h := physicalCleanFreshEquiv_apply_index P C fresh g
    ((physicalFullSharedIndices (C g))ᶜ.equivFin i)
  simpa only [physicalCleanFreshIndex, Equiv.trans_apply, Equiv.symm_apply_apply] using h

theorem physicalCleanFreshEquiv_weight {G : Type*} [Fintype G]
    (P : G → Type*) {J ell : ℕ} (C : G → Finset (Fin J)) (μ : ∀ g, P g → ℝ)
    (fresh : ∀ g, Fin ((physicalFullSharedIndices (ell := ell) (C g))ᶜ.card) → P g) :
    (∏ g, ∏ j, μ g (physicalCleanFreshEquiv P C fresh g j)) =
      ∏ g, ∏ i, μ g (fresh g i) := by
  apply prod_congr rfl
  intro g _
  exact Equiv.prod_comp (physicalCleanFreshIndex C g).symm (fun i => μ g (fresh g i))

/-- Reassembly commutes with the explicit encoding permutation. Arbitrary
replacement memories include translated residues and do not need symmetry. -/
theorem physical_clean_reassemble_fresh {G : Type*} {P Z : G → Type*}
    {J ell B : ℕ} (C : G → Finset (Fin J))
    (x : ProductBoundedOrderedState P Z (fun _ => J + ell) B)
    (q : ∀ g, BoundedOrderedTuple (Z g) B)
    (fresh : ∀ g, Fin ((physicalFullSharedIndices (ell := ell) (C g))ᶜ.card) → P g) :
    (productActiveMemorySplit (fun g => physicalFullSharedIndices (ell := ell) (C g)) B).symm
      ((productActiveMemorySplit (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
        (fullActivePermutation (cleanPhysicalSlotChange C) x)).1,
       fun g => (fresh g, q g)) =
      fullActivePermutation (cleanPhysicalSlotChange C)
        ((productActiveMemorySplit (cleanFullSharedSlots C) B).symm
          ((productActiveMemorySplit (cleanFullSharedSlots C) B x).1,
           fun g => (physicalCleanFreshEquiv P C fresh g, q g))) := by
  funext g
  apply Prod.ext
  · funext i
    change (if hi : i ∈ physicalFullSharedIndices (ell := ell) (C g) then
      (x g).1 (cleanPhysicalSlotChange C g
        (((physicalFullSharedIndices (C g)).equivFin.symm
          ((physicalFullSharedIndices (C g)).equivFin ⟨i, hi⟩)).val))
      else fresh g ((physicalFullSharedIndices (C g))ᶜ.equivFin ⟨i, mem_compl.mpr hi⟩)) =
      (if hc : cleanPhysicalSlotChange C g i ∈ cleanFullSharedSlots C g then
        (x g).1 (((cleanFullSharedSlots C g).equivFin.symm
          ((cleanFullSharedSlots C g).equivFin ⟨cleanPhysicalSlotChange C g i, hc⟩)).val)
      else physicalCleanFreshEquiv P C fresh g
        ((cleanFullSharedSlots C g)ᶜ.equivFin
          ⟨cleanPhysicalSlotChange C g i, mem_compl.mpr hc⟩))
    have hshared := clean_physical_slot_change_shared C g i
    by_cases hi : i ∈ physicalFullSharedIndices (ell := ell) (C g)
    · have hc := hshared.mpr hi
      simp only [dif_pos hi, dif_pos hc, Equiv.symm_apply_apply]
    · have hc : cleanPhysicalSlotChange C g i ∉ cleanFullSharedSlots C g := mt hshared.mp hi
      rw [dif_neg hi, dif_neg hc]
      exact (physicalCleanFreshEquiv_apply_subtype P C fresh g ⟨i, mem_compl.mpr hi⟩).symm
  · rfl

/-- Weighted finite fresh integration is unchanged by the reindexing. -/
theorem physical_clean_fresh_weighted_sum {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Type*) [∀ g, Fintype (P g)] {J ell : ℕ}
    (C : G → Finset (Fin J)) (μ : ∀ g, P g → ℝ)
    (F : (∀ g, Fin ((cleanFullSharedSlots (ell := ell) C g)ᶜ.card) → P g) → ℂ) :
    (∑ fresh : ∀ g, Fin ((physicalFullSharedIndices (ell := ell) (C g))ᶜ.card) → P g,
      ((∏ g, ∏ i, μ g (fresh g i) : ℝ) : ℂ) * F (physicalCleanFreshEquiv P C fresh)) =
      ∑ fresh : ∀ g, Fin ((cleanFullSharedSlots (ell := ell) C g)ᶜ.card) → P g,
        ((∏ g, ∏ j, μ g (fresh g j) : ℝ) : ℂ) * F fresh := by
  have h := (physicalCleanFreshEquiv P C).sum_comp
    (fun fresh => ((∏ g, ∏ j, μ g (fresh g j) : ℝ) : ℂ) * F fresh)
  simpa only [physicalCleanFreshEquiv_weight] using h

end Bounty
end

section

/- The shared dilation is preserved by the explicit physical slot encoding,
on arbitrary repeated-label full states and arbitrary pending memories. -/

open Finset
open scoped Classical

namespace Bounty

theorem clean_physical_shared_D_reencode {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {Z : G → Type*} {J ell B : ℕ}
    (C : G → Finset (Fin J))
    (x : ProductBoundedOrderedState (fun g => ↥(P g)) Z (fun _ => J + ell) B)
    (aux : PhysicalAuxLabels P C) :
    physicalFullSharedD C
      (productActiveMemorySplit (fun g => physicalFullSharedIndices (C g)) B
        (fullActivePermutation (cleanPhysicalSlotChange C) x)).1 aux =
      cleanFullSharedD C
        (productActiveMemorySplit (cleanFullSharedSlots C) B x).1 aux := by
  unfold physicalFullSharedD cleanFullSharedD
  apply prod_congr rfl
  intro g _
  congr 1
  let S := physicalFullSharedIndices (ell := ell) (C g)
  let T := cleanFullSharedSlots (ell := ell) C g
  let τ := cleanPhysicalSlotChange (ell := ell) C g
  let e : ↥S ≃ ↥T :=
    { toFun := fun i => ⟨τ i.val, (clean_physical_slot_change_shared C g i.val).mpr i.property⟩
      invFun := fun j => ⟨τ.symm j.val, by
        apply (clean_physical_slot_change_shared C g (τ.symm j.val)).mp
        change τ (τ.symm j.val) ∈ T
        rw [Equiv.apply_symm_apply]
        exact j.property⟩
      left_inv := fun i => Subtype.ext (Equiv.symm_apply_apply τ i.val)
      right_inv := fun j => Subtype.ext (Equiv.apply_symm_apply τ j.val) }
  change (∏ i : Fin S.card, ((x g).1 (τ (S.equivFin.symm i).val)).val) =
    ∏ j : Fin T.card, ((x g).1 (T.equivFin.symm j).val).val
  calc
    _ = ∏ i : S, ((x g).1 (τ i.val)).val :=
      Equiv.prod_comp S.equivFin.symm (fun i => ((x g).1 (τ i.val)).val)
    _ = ∏ j : T, ((x g).1 j.val).val :=
      Equiv.prod_comp e (fun j => ((x g).1 j.val).val)
    _ = _ := (Equiv.prod_comp T.equivFin.symm (fun j => ((x g).1 j.val).val)).symm

end Bounty
end

section

/- Exactly the performed original sample slots, with no auxiliary draws counted as births. -/

open Classical

namespace Bounty

section Coordinates
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
    (n : ∀ g, P g → ℕ) {M : Fin N → ℕ}
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)

def FullMixedEventBirthCoordinate : (tag : Option (J ⊕ K)) →
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) →
    FullPermutationMixedEvent n S B A Δ D tag s → Type _
  | none, _, _ => PEmpty
  | some (.inl _), _, e => (g : Fin N) × Fin (e.down g).1.val
  | some (.inr k), _, e =>
      (g : Fin N) × {i : Fin (S k g)ᶜ.card // i ∉ (e.2 g).2.1}

noncomputable def fullMixedBirthCoordinateEquiv (tag : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag s) :
    FullMixedEventBirthCoordinate n S B A Δ D tag s e ≃
      {a : FullMixedLocalBirthAddress S B tag //
        fullMixedEventBirthPerformed n S B A Δ D tag s e a} := by
  cases tag with
  | none =>
    exact { toFun := fun i => PEmpty.elim i
            invFun := fun a => Fin.elim0 a.val.2
            left_inv := fun i => PEmpty.elim i
            right_inv := fun a => Fin.elim0 a.val.2 }
  | some tag =>
    cases tag with
    | inl j =>
      refine {
        toFun := fun i => ⟨⟨i.1, ⟨i.2.val,
          lt_of_lt_of_le i.2.isLt (Nat.le_of_lt_succ (e.down i.1).1.isLt)⟩⟩,
          (full_mixed_ghost_birth_performed_iff n S B A Δ D j s e _ _).mpr i.2.isLt⟩
        invFun := fun a => ⟨a.val.1, ⟨a.val.2.val,
          (full_mixed_ghost_birth_performed_iff n S B A Δ D j s e _ _).mp a.property⟩⟩
        left_inv := ?_
        right_inv := ?_ }
      · intro i; rfl
      · intro a; rfl
    | inr k =>
      refine {
        toFun := fun i => ⟨⟨i.1, i.2.val⟩,
          (full_mixed_edge_birth_performed_iff (J := J) n S B A Δ D k s e _ _).mpr i.2.property⟩
        invFun := fun a => ⟨a.val.1, ⟨a.val.2,
          (full_mixed_edge_birth_performed_iff (J := J) n S B A Δ D k s e _ _).mp a.property⟩⟩
        left_inv := ?_
        right_inv := ?_ }
      · intro i; rfl
      · intro a; rfl

noncomputable def fullMixedBirthCoordinateData : (tag : Option (J ⊕ K)) →
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) →
    (e : FullPermutationMixedEvent n S B A Δ D tag s) →
    FullMixedEventBirthCoordinate n S B A Δ D tag s e → FullMixedBornData n
  | none, _, _, i => PEmpty.elim i
  | some (.inl _), _, e, i => .inl ⟨i.1, (e.down i.1).2.2 i.2⟩
  | some (.inr _), _, e, i => .inr ⟨i.1, (e.2 i.1).2.2.2 i.2⟩

theorem full_mixed_birth_coordinate_data (tag : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag s)
    (i : FullMixedEventBirthCoordinate n S B A Δ D tag s e) :
    fullMixedEventBornData n S B A Δ D tag s e
      (fullMixedBirthCoordinateEquiv n S B A Δ D tag s e i).val =
      some (fullMixedBirthCoordinateData n S B A Δ D tag s e i) := by
  cases tag with
  | none => exact PEmpty.elim i
  | some tag =>
    cases tag with
    | inl j => exact full_mixed_ghost_born_data n S B A Δ D j s e _ _ i.2.isLt
    | inr k => exact full_mixed_edge_born_data n S B A Δ D k s e _ _ i.2.property

theorem full_mixed_ghost_reconstructed_coordinate
    (j : J) (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (sk : CoupledGhostSkeleton M B s) (births : CoupledGhostSamples M B s sk)
    (i : CoupledGhostSampleIndex M B s sk) :
    fullMixedBirthCoordinateData n S B A Δ D (some (.inl j)) s
      ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩) i =
      .inl ⟨i.1, births i⟩ := rfl

theorem full_mixed_edge_reconstructed_coordinate
    (k : K) (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (sk : FullActiveEdgeSkeleton n (S k) B (A k) (Δ k) (D k) s)
    (fresh : FullActiveEdgeSamples n (S k) B (A k) (Δ k) (D k) s sk)
    (i : FullActiveEdgeSampleIndex n (S k) B (A k) (Δ k) (D k) s sk) :
    fullMixedBirthCoordinateData (J := J) n S B A Δ D (some (.inr k)) s
      ((fullPermutationEdgeBirthEquiv (J := J) n S B A Δ D s k).symm ⟨sk, fresh⟩) i =
      .inr ⟨i.1, fresh i⟩ := rfl

end Coordinates

end Bounty
end

section

/- The actual initial physical state has no pending labels outside its active ledger. -/

open Finset
namespace Bounty

theorem physical_full_empty_initial_ledger_covers
    {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (C : Fin N → Finset (Fin J)) (L : PhysicalMarkLists P J ell) :
    let x := physicalFullMemoryState C L (fun g => fullEmptyBoundedMemory
      (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B)
    FullMixedLedgerCovers (fun g (p : ↥(P g)) => p.val) B (fullActiveInitialLedger x, x) := by
  intro x g
  constructor
  · intro i
    exact mem_image_of_mem _ (mem_univ i)
  · intro i
    exact Fin.elim0 i

end Bounty
end

section

/- Original recorded phases split into the local product and unchanged record observable. -/

namespace Bounty
section Paths
variable {I K X O : Type*} (E : K → X → Type*)
  (target : ∀ k x, E k x → X) (phase : ∀ k x, E k x → ℂ)

theorem finite_event_path_map_local_phase (tag : I → K) (steps : List I)
    (x : X) (p : FiniteEventPath (fun i => E (tag i)) (fun i => target (tag i)) steps x) :
    finiteEventLocalPhase (fun i => E (tag i)) (fun i => target (tag i))
      (fun i => phase (tag i)) steps x p =
    finiteEventLocalPhase E target phase (steps.map tag) x
      (finiteEventPathMapEquiv E target tag steps x p) := by
  induction steps generalizing x with
  | nil => rfl
  | cons i steps ih =>
    rcases p with ⟨e, p⟩
    exact congrArg (phase (tag i) x e * ·) (ih (target (tag i) x e) p)

theorem finite_recorded_path_phase_factor (observe : ∀ k x, E k x → O)
    (steps : List K) (initial : X → List O) (F : List O → X → ℂ)
    (x : X) (p : FiniteEventPath E target steps x) :
    finiteRecordedPathPhase E target phase observe steps initial F x p =
      finiteEventLocalPhase E target phase steps x p *
        F (initial x ++ finiteEventPathObservations E target observe steps x p)
          (finiteEventPathTerminal E target steps x p) := by
  unfold finiteRecordedPathPhase
  rw [finite_ledger_event_local_phase]
  rw [Equiv.apply_symm_apply]

theorem finite_recorded_schedule_phase_factor (tag : ℕ → K)
    (observe : ∀ i x, E (tag i) x → O) (steps : ℕ) (initial : X → List O)
    (F : List O → X → ℂ) (x : X)
    (p : FiniteEventPath E target ((List.range steps).map tag) x) :
    finiteRecordedSchedulePhase E target phase tag observe steps initial F x p =
      finiteEventLocalPhase E target phase ((List.range steps).map tag) x p *
        F (initial x ++ finiteEventPathObservations (fun i => E (tag i))
          (fun i => target (tag i)) observe (List.range steps) x
            ((finiteEventPathMapEquiv E target tag (List.range steps) x).symm p))
          (finiteEventPathTerminal E target ((List.range steps).map tag) x p) := by
  unfold finiteRecordedSchedulePhase
  rw [finite_recorded_path_phase_factor, finite_event_path_map_local_phase,
    finite_event_path_map_terminal, Equiv.apply_symm_apply]

noncomputable def finiteRecordedScheduleObservable (tag : ℕ → K)
    (observe : ∀ i x, E (tag i) x → O) (steps : ℕ) (initial : X → List O)
    (F : List O → X → ℂ) (x : X)
    (p : FiniteEventPath E target ((List.range steps).map tag) x) : ℂ :=
  F (initial x ++ finiteEventPathObservations (fun i => E (tag i))
      (fun i => target (tag i)) observe (List.range steps) x
        ((finiteEventPathMapEquiv E target tag (List.range steps) x).symm p))
    (finiteEventPathTerminal E target ((List.range steps).map tag) x p)

theorem finite_recorded_schedule_phase_observable (tag : ℕ → K)
    (observe : ∀ i x, E (tag i) x → O) (steps : ℕ) (initial : X → List O)
    (F : List O → X → ℂ) (x : X)
    (p : FiniteEventPath E target ((List.range steps).map tag) x) :
    finiteRecordedSchedulePhase E target phase tag observe steps initial F x p =
      finiteEventLocalPhase E target phase ((List.range steps).map tag) x p *
        finiteRecordedScheduleObservable E target tag observe steps initial F x p :=
  finite_recorded_schedule_phase_factor E target phase tag observe steps initial F x p

end Paths
end Bounty
end

section

/- A linear bound for the number of compatible balanced dyadic rectangles. -/

open Finset

namespace Bounty

theorem nat_finset_card_le_diameter (S : Finset ℕ) (N : ℕ)
    (hS : ∀ i ∈ S, ∀ j ∈ S, i ≤ j+N) : S.card ≤ N+1 := by
  classical
  by_cases hs : S.Nonempty
  · let lo := S.min' hs
    have hsub : S ⊆ Icc lo (lo+N) := by
      intro i hi
      exact mem_Icc.mpr ⟨S.min'_le i hi, hS i hi lo (S.min'_mem hs)⟩
    have h := card_le_card hsub
    rw [Nat.card_Icc] at h
    omega
  · simp only [not_nonempty_iff_eq_empty.mp hs, card_empty]
    omega

theorem dyadic_pair_fiber_card_le (S : Finset (ℕ × ℕ)) {L : ℝ}
    (hS : ∀ v ∈ S, 0 < v.1 ∧ 0 < v.2 ∧ Real.exp L ≤ ((v.1*v.2 : ℕ) : ℝ) ∧
      ((v.1*v.2 : ℕ) : ℝ) ≤ 33*Real.exp L) (i : ℕ) :
    ((dyadicPairIndices S).filter (fun k => k.1 = i)).card ≤ 9 := by
  let T := (dyadicPairIndices S).filter (fun k => k.1 = i)
  have hinj : Set.InjOn Prod.snd (↑T : Set (ℕ × ℕ)) := by
    intro k hk l hl he
    have hk1 := (mem_filter.mp hk).2
    have hl1 := (mem_filter.mp hl).2
    exact Prod.ext (hk1.trans hl1.symm) he
  have hcard : (T.image Prod.snd).card = T.card := card_image_of_injOn hinj
  rw [← hcard]
  apply nat_finset_card_le_diameter _ 8
  intro k hk l hl
  obtain ⟨p, hp, rfl⟩ := mem_image.mp hk
  obtain ⟨q, hq, rfl⟩ := mem_image.mp hl
  obtain ⟨hpS, hp1⟩ := mem_filter.mp hp
  obtain ⟨hqS, hq1⟩ := mem_filter.mp hq
  exact dyadic_pair_second_diameter S hS hpS hqS (hp1.trans hq1.symm)

theorem dyadic_pair_indices_card_le (S : Finset (ℕ × ℕ)) {L : ℝ}
    (hS : ∀ v ∈ S, 0 < v.1 ∧ 0 < v.2 ∧ Real.exp L ≤ ((v.1*v.2 : ℕ) : ℝ) ∧
      ((v.1*v.2 : ℕ) : ℝ) ≤ 33*Real.exp L) :
    (dyadicPairIndices S).card ≤ 9 * (dyadicNatIndices (S.image Prod.fst)).card := by
  have hImage : (dyadicPairIndices S).image Prod.fst = dyadicNatIndices (S.image Prod.fst) := by
    simp only [dyadicPairIndices, dyadicNatIndices, Finset.image_image, Function.comp_def]
  calc
    _ = ∑ i ∈ (dyadicPairIndices S).image Prod.fst,
        ((dyadicPairIndices S).filter (fun k => k.1 = i)).card := card_eq_sum_card_image _ _
    _ ≤ ∑ _i ∈ (dyadicPairIndices S).image Prod.fst, 9 :=
      sum_le_sum (fun i _ => dyadic_pair_fiber_card_le S hS i)
    _ = _ := by simp only [sum_const, smul_eq_mul, hImage]; omega

theorem dyadic_balanced_pair_count (S : Finset (ℕ × ℕ)) {κ L : ℝ}
    (hκ : 0 ≤ κ) (hL : 0 ≤ L)
    (hS : ∀ v ∈ S, 0 < v.1 ∧ 0 < v.2 ∧
      Real.exp (((1/2 : ℝ)-2*κ)*L) ≤ (v.1 : ℝ) ∧
      (v.1 : ℝ) ≤ Real.exp (((1/2 : ℝ)+2*κ)*L) ∧
      Real.exp L ≤ ((v.1*v.2 : ℕ) : ℝ) ∧ ((v.1*v.2 : ℕ) : ℝ) ≤ 33*Real.exp L) :
    ((dyadicPairIndices S).card : ℝ) ≤ (36/Real.log 2+18)*(κ*L+1) := by
  have hc := dyadic_pair_indices_card_le S (fun v hv =>
    ⟨(hS v hv).1, (hS v hv).2.1, (hS v hv).2.2.2.2⟩)
  have hspan : ((1/2 : ℝ)-2*κ)*L ≤ ((1/2 : ℝ)+2*κ)*L := by nlinarith
  have hfirst := dyadic_indices_card_window (S.image Prod.fst) hspan (by
    intro n hn
    obtain ⟨v, hv, rfl⟩ := mem_image.mp hn
    exact ⟨(hS v hv).1, (hS v hv).2.2.1, (hS v hv).2.2.2.1⟩)
  have hcR : ((dyadicPairIndices S).card : ℝ) ≤
      9*((dyadicNatIndices (S.image Prod.fst)).card : ℝ) := by exact_mod_cast hc
  have h2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have he : 9*((((1/2 : ℝ)+2*κ)*L-((1/2 : ℝ)-2*κ)*L)/Real.log 2+2) =
      (36/Real.log 2)*(κ*L)+18 := by ring
  have hfinal : (36/Real.log 2)*(κ*L)+18 ≤ (36/Real.log 2+18)*(κ*L+1) := by
    have : 0 ≤ 36/Real.log 2 := by positivity
    nlinarith
  exact (hcR.trans (mul_le_mul_of_nonneg_left hfirst (by norm_num))).trans ((le_of_eq he).trans hfinal)

end Bounty
end

section

/- Exact natural endpoints and side lengths for the half-open dyadic buckets. -/

open Finset

namespace Bounty

theorem dyadic_index_interval {n k : ℕ} (hn : 0 < n) (hk : n.log2 = k) :
    n ∈ Ioc (2^k-1) (2^(k+1)-1) := by
  have h := (Nat.log2_eq_iff hn.ne').mp hk
  have hp : 0 < 2^k := by positivity
  apply mem_Ioc.mpr
  omega

theorem dyadic_index_side_length (k : ℕ) :
    ((2^(k+1)-1 : ℕ) : ℝ) - ((2^k-1 : ℕ) : ℝ) = (2 : ℝ)^k := by
  have h1 : 1 ≤ (2 : ℕ)^k := Nat.succ_le_of_lt (by positivity)
  have h2 : 1 ≤ (2 : ℕ)^(k+1) := Nat.succ_le_of_lt (by positivity)
  rw [Nat.cast_sub h1, Nat.cast_sub h2]
  push_cast
  rw [pow_succ]
  ring

theorem dyadic_pair_bucket_rectangle (S : Finset (ℕ × ℕ))
    (hS : ∀ v ∈ S, 0 < v.1 ∧ 0 < v.2) (k : ℕ × ℕ)
    {v : ℕ × ℕ} (hv : v ∈ dyadicPairBucket S k) :
    v.1 ∈ Ioc (2^k.1-1) (2^(k.1+1)-1) ∧ v.2 ∈ Ioc (2^k.2-1) (2^(k.2+1)-1) := by
  obtain ⟨hvS, hk⟩ := mem_filter.mp hv
  exact ⟨dyadic_index_interval (hS v hvS).1 (congrArg Prod.fst hk),
    dyadic_index_interval (hS v hvS).2 (congrArg Prod.snd hk)⟩

theorem dyadic_pair_bucket_scales (S : Finset (ℕ × ℕ))
    (hS : ∀ v ∈ S, 0 < v.1 ∧ 0 < v.2) {k : ℕ × ℕ}
    (hk : k ∈ dyadicPairIndices S) :
    ∃ v ∈ S, (2 : ℝ)^k.1 ≤ (v.1 : ℝ) ∧ (2 : ℝ)^k.2 ≤ (v.2 : ℝ) ∧
      (2 : ℝ)^k.1 * (2 : ℝ)^k.2 ≤ ((v.1*v.2 : ℕ) : ℝ) := by
  obtain ⟨v, hv, rfl⟩ := mem_image.mp hk
  have hm := ((Nat.log2_eq_iff (hS v hv).1.ne').mp rfl).1
  have hn := ((Nat.log2_eq_iff (hS v hv).2.ne').mp rfl).1
  have hmR : (2 : ℝ)^v.1.log2 ≤ v.1 := by exact_mod_cast hm
  have hnR : (2 : ℝ)^v.2.log2 ≤ v.2 := by exact_mod_cast hn
  refine ⟨v, hv, hmR, hnR, ?_⟩
  rw [Nat.cast_mul]
  exact mul_le_mul hmR hnR (by positivity) (by positivity)

end Bounty
end

section

/- A positive potential depending only on the original pending-memory lengths. -/

open Finset Classical

namespace Bounty

noncomputable def productLengthLyapunov {G : Type*} [Fintype G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ} (v : ℝ)
    (s : ProductBoundedOrderedState P Z M B) : ℝ :=
  ∏ g, v ^ (s g).2.1.val

theorem productLengthLyapunov_nonneg {G : Type*} [Fintype G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ} {v : ℝ} (hv : 0 ≤ v)
    (s : ProductBoundedOrderedState P Z M B) : 0 ≤ productLengthLyapunov v s :=
  prod_nonneg fun _ _ => pow_nonneg hv _

theorem productLengthLyapunov_pos {G : Type*} [Fintype G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ} {v : ℝ} (hv : 0 < v)
    (s : ProductBoundedOrderedState P Z M B) : 0 < productLengthLyapunov v s :=
  prod_pos fun _ _ => pow_pos hv _

theorem productLengthLyapunov_eq_total {G : Type*} [Fintype G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ} (v : ℝ)
    (s : ProductBoundedOrderedState P Z M B) :
    productLengthLyapunov v s = v ^ productTotalMemory s :=
  prod_pow_eq_pow_sum univ (fun g => (s g).2.1.val) v

theorem productLengthLyapunov_split {G : Type*} [Fintype G]
    {P Z : G → Type*} {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ) (v : ℝ)
    (s : ProductBoundedOrderedState P Z M B) :
    productLengthLyapunov v ((productActiveMemorySplit S B s).2) = productLengthLyapunov v s := rfl

theorem productLengthLyapunov_reassemble {G : Type*} [Fintype G]
    {P Z : G → Type*} {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ) (v : ℝ)
    (c : SharedActiveLabels P S)
    (s : ProductBoundedOrderedState P Z (fun g => (S g)ᶜ.card) B) :
    productLengthLyapunov v ((productActiveMemorySplit S B).symm (c, s)) =
      productLengthLyapunov v s := rfl

theorem finite_product_gated_row_le {G : Type*} [Fintype G] [DecidableEq G]
    {E : G → Type*} [∀ g, Fintype (E g)]
    (w L : ∀ g, E g → ℝ) (hL : ∀ g e, 0 ≤ L g e) (R : G → ℝ)
    (hrow : ∀ g, ∑ e, |w g e| * L g e ≤ R g) (allowed : (∀ g, E g) → Prop)
    [DecidablePred allowed] :
    (∑ e : ∀ g, E g, |if allowed e then ∏ g, w g (e g) else 0| * ∏ g, L g (e g)) ≤
      ∏ g, R g := by
  calc
    _ ≤ ∑ e : ∀ g, E g, ∏ g, |w g (e g)| * L g (e g) := by
      apply sum_le_sum
      intro e _
      by_cases h : allowed e
      · simp only [if_pos h, abs_prod, prod_mul_distrib, le_refl]
      · simp only [if_neg h, abs_zero, zero_mul]
        exact prod_nonneg fun g _ => mul_nonneg (abs_nonneg _) (hL g _)
    _ = ∏ g, ∑ e, |w g e| * L g e := (Fintype.prod_sum (fun g e => |w g e| * L g e)).symm
    _ ≤ _ := prod_le_prod₀ (fun g _ => sum_nonneg fun e _ => mul_nonneg (abs_nonneg _) (hL g e))
      (fun g _ => hrow g)

end Bounty
end

section

/- Read positions of an original range-indexed path without adding events or states. -/

namespace Bounty
section Schedule
variable {X O : Type*} (E : ℕ → X → Type*) (target : ∀ i x, E i x → X)

theorem event_sigma_transport_fst {i j : ℕ} (h : i = j)
    (u : Σ y, E i y) :
    (cast (congrArg (fun z => Σ y, E z y) h) u).1 = u.1 := by
  subst j
  rfl

theorem event_sigma_transport_apply {Y : Type*} (F : ∀ i x, E i x → Y)
    {i j : ℕ} (h : i = j) (u : Σ y, E i y) :
    F j (cast (congrArg (fun z => Σ y, E z y) h) u).1
      (cast (congrArg (fun z => Σ y, E z y) h) u).2 = F i u.1 u.2 := by
  subst j
  rfl

def finiteScheduleOccurrence (m : ℕ) (x : X)
    (p : FiniteEventPath E target (List.range m) x) (i : Fin m) : Σ y, E i.val y :=
  let a : Fin (List.range m).length := ⟨i.val, by simpa only [List.length_range] using i.isLt⟩
  cast (congrArg (fun z => Σ y, E z y)
    (show (List.range m).get a = i.val by simp only [List.get_eq_getElem, List.getElem_range, a]))
    (finiteEventPathOccurrence E target (List.range m) x p a)

theorem finite_schedule_occurrence_fst (m : ℕ) (x : X)
    (p : FiniteEventPath E target (List.range m) x) (i : Fin m) :
    (finiteScheduleOccurrence E target m x p i).1 =
      (finiteEventPathOccurrence E target (List.range m) x p
        ⟨i.val, by simpa only [List.length_range] using i.isLt⟩).1 :=
  event_sigma_transport_fst E (by simp only [List.get_eq_getElem, List.getElem_range]) _

theorem finite_schedule_occurrence_apply {Y : Type*} (F : ∀ i x, E i x → Y)
    (m : ℕ) (x : X) (p : FiniteEventPath E target (List.range m) x) (i : Fin m) :
    F i.val (finiteScheduleOccurrence E target m x p i).1
      (finiteScheduleOccurrence E target m x p i).2 =
      F ((List.range m).get ⟨i.val, by simpa only [List.length_range] using i.isLt⟩)
        (finiteEventPathOccurrence E target (List.range m) x p
          ⟨i.val, by simpa only [List.length_range] using i.isLt⟩).1
        (finiteEventPathOccurrence E target (List.range m) x p
          ⟨i.val, by simpa only [List.length_range] using i.isLt⟩).2 :=
  event_sigma_transport_apply E F (by simp only [List.get_eq_getElem, List.getElem_range]) _

theorem finite_schedule_supported_invariant
    (phase : ∀ i x, E i x → ℂ) (Q : X → Prop)
    (hstep : ∀ i x e, Q x → phase i x e ≠ 0 → Q (target i x e))
    (m : ℕ) (x : X) (p : FiniteEventPath E target (List.range m) x)
    (hx : Q x) (hp : finiteEventLocalPhase E target phase (List.range m) x p ≠ 0)
    (i : Fin m) :
    Q (finiteScheduleOccurrence E target m x p i).1 ∧
      Q (target i.val (finiteScheduleOccurrence E target m x p i).1
        (finiteScheduleOccurrence E target m x p i).2) := by
  have h := finite_event_local_phase_supported_invariant E target phase Q hstep
    (List.range m) x p hx hp ⟨i.val, by simpa only [List.length_range] using i.isLt⟩
  constructor
  · exact (congrArg Q (finite_schedule_occurrence_fst E target m x p i)).mpr h.1
  · exact (congrArg Q (finite_schedule_occurrence_apply E target target m x p i)).mpr h.2

theorem finite_schedule_source_after
    (m : ℕ) (x : X) (p : FiniteEventPath E target (List.range m) x)
    (i : ℕ) (hi : i + 1 < m) :
    (finiteScheduleOccurrence E target m x p ⟨i + 1, hi⟩).1 =
      target i (finiteScheduleOccurrence E target m x p ⟨i, by omega⟩).1
        (finiteScheduleOccurrence E target m x p ⟨i, by omega⟩).2 := by
  have h := finite_event_occurrence_source_after E target (List.range m) x p i
    (by simpa only [List.length_range] using hi)
  exact (finite_schedule_occurrence_fst E target m x p ⟨i + 1, hi⟩).trans
    (h.trans (finite_schedule_occurrence_apply E target target m x p ⟨i, by omega⟩).symm)

theorem finite_schedule_observations_get
    (observe : ∀ i x, E i x → O)
    (m : ℕ) (x : X) (p : FiniteEventPath E target (List.range m) x) (i : Fin m) :
    (finiteEventPathObservations E target observe (List.range m) x p).get
      ⟨i.val, by rw [finite_event_path_observations_length, List.length_range]; exact i.isLt⟩ =
      observe i.val (finiteScheduleOccurrence E target m x p i).1
        (finiteScheduleOccurrence E target m x p i).2 := by
  have h := finite_event_observations_get E target observe (List.range m) x p i.val
    (by simpa only [List.length_range] using i.isLt)
  exact h.trans (finite_schedule_occurrence_apply E target observe m x p i).symm

end Schedule
end Bounty
end

section

/- On a clean event, the tested births are exactly the raw fresh draws.
The equivalence retains the actual bounded event target and its fallback. -/

open Finset
open scoped Classical

namespace Bounty

theorem unrestricted_clean_fresh_allowed {P : Type*}
    (F : Finset P) (n : P → ℕ) (Δ D : ℤ) (t B : ℕ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (e : UnrestrictedBoundedEvent n Δ D t B s)
    (he : e.1 = ∅ ∧ e.2.1 = ∅) :
    (∀ i, (unrestrictedBoundedEventTarget n Δ D t B s e).1 i ∉ F) ↔
      ∀ i, e.2.2.2 i ∉ F := by
  rcases e with ⟨stores, promotions, select, fresh⟩
  rcases he with ⟨hs, hp⟩
  dsimp only at hs hp
  subst stores
  subst promotions
  have hs := unrestricted_clean_promotion_unique (unrestrictedResidueEligible n Δ D s.2.2) select
  subst select
  have hlen := unrestricted_clean_output_length s.1 s.2.2 (unrestrictedResidueSeed n)
    (unrestrictedResidueTransport n Δ) (unrestrictedResidueEligible n Δ D s.2.2)
  have hb : (unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
      (unrestrictedResidueTransport n Δ) ∅ ∅
      (unrestrictedCleanPromotion t (unrestrictedResidueEligible n Δ D s.2.2))).1 ≤ B := by
    rw [hlen]
    exact Nat.le_of_lt_succ s.2.1.isLt
  unfold unrestrictedBoundedEventTarget
  rw [dif_pos hb]
  simp only [unrestrictedEdgeTarget, unrestrictedTargetLabels, Finset.notMem_empty, dite_false]
  constructor
  · intro h i
    exact h i.val
  · intro h i
    exact h ⟨i, Finset.notMem_empty i⟩

theorem clean_initial_birth_allowed_event_target {G : Type*}
    {P : G → Finset ℕ} {J ell B : ℕ}
    (F : ∀ g, Finset (P g)) (C : G → Finset (Fin J))
    (Δ D : G → ℤ) (source : RepeatedBigLists P J ell)
    (s : ProductBoundedOrderedState (fun g => ↥(P g))
      (fun g => UnrestrictedResidueParticle (fun q : P g => q.val))
      (fun g => (cleanFullSharedSlots (ell := ell) C g)ᶜ.card) B)
    (e : UnrestrictedJointEvent (fun g (q : P g) => q.val) Δ D
      (fun g => (cleanFullSharedSlots (ell := ell) C g)ᶜ.card) B s)
    (he : ∀ g, (e g).1 = ∅ ∧ (e g).2.1 = ∅) :
    cleanInitialBirthAllowed F C
      (repeatedBigFill C source (cleanFullFreshEquiv P C
        (fun g => (unrestrictedJointEventTarget (fun g (q : P g) => q.val) Δ D
          (fun g => (cleanFullSharedSlots (ell := ell) C g)ᶜ.card) B s e g).1))) ↔
      ∀ g i, (e g).2.2.2 i ∉ F g := by
  rw [clean_initial_birth_allowed_fill]
  exact forall_congr' fun g => unrestricted_clean_fresh_allowed (F g) (fun q : P g => q.val)
    (Δ g) (D g) _ B (s g) (e g) (he g)

end Bounty
end

section

/- Initial-ledger exclusions apply to fresh active target slots only.
Their mass is bounded under the exact normalized reciprocal-prime law;
shared labels and auxiliary labels are not excluded here. -/

open Finset
open scoped Classical

namespace Bounty

def repeatedBigFreshHits {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (F : ∀ g, Finset (P g)) (C : G → Finset (Fin J))
    (target : RepeatedBigLists P J ell) : Prop :=
  ∃ g, ∃ s : {s : PhysicalSlots J ell // repeatedBigUnshared C g s}, target g s.val ∈ F g

noncomputable def repeatedBigInitialForbiddenProbability {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (F : ∀ g, Finset (P g)) (Pmin : ℝ) : ℝ :=
  ∑ g, ((ell + (C g).card : ℕ) : ℝ) * (F g).card / (V g * Pmin)

theorem repeatedBigInitialForbiddenProbability_nonneg {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (F : ∀ g, Finset (P g)) {Pmin : ℝ} (hV : ∀ g, 0 ≤ V g) (hPmin : 0 ≤ Pmin) :
    0 ≤ repeatedBigInitialForbiddenProbability (ell := ell) V C F Pmin := by
  unfold repeatedBigInitialForbiddenProbability
  exact sum_nonneg fun g _ => div_nonneg (by positivity) (mul_nonneg (hV g) hPmin)

theorem repeated_big_fresh_hits_iff_not_allowed {G : Type*}
    {P : G → Finset ℕ} {J ell : ℕ} (F : ∀ g, Finset (P g))
    (C : G → Finset (Fin J)) (target : RepeatedBigLists P J ell) :
    repeatedBigFreshHits F C target ↔ ¬ cleanInitialBirthAllowed F C target := by
  constructor
  · rintro ⟨g, s, hs⟩ h
    exact h g s.val s.property hs
  · intro h
    by_contra hn
    apply h
    intro g s hs hf
    exact hn ⟨g, ⟨s, hs⟩, hf⟩

theorem repeated_big_fresh_hits_fill {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (F : ∀ g, Finset (P g)) (C : G → Finset (Fin J))
    (source : RepeatedBigLists P J ell) (fresh : RepeatedBigFresh P C ell) :
    repeatedBigFreshHits F C (repeatedBigFill C source fresh) ↔ ∃ g s, fresh g s ∈ F g := by
  simp only [repeatedBigFreshHits, repeated_big_fill_unshared]

/-- The marginal of one complete fresh group has no contribution from other
normalized groups. -/
theorem repeated_big_fresh_group_marginal {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (g : G) (F : ({s : PhysicalSlots J ell // repeatedBigUnshared C g s} → P g) → ℝ) :
    (∑ fresh : RepeatedBigFresh P C ell,
      repeatedBigFreshMass V (fun _ _ => 1) C fresh * F (fresh g)) =
      ∑ a : {s : PhysicalSlots J ell // repeatedBigUnshared C g s} → P g,
        cleanAuxiliaryWeight (physicalLabelLaw V g) a * F a := by
  let factors (i : G) (a : {s : PhysicalSlots J ell // repeatedBigUnshared C i s} → P i) : ℝ :=
    (∏ j, physicalLabelLaw V i (a j)) * (if h : i = g then F (h ▸ a) else 1)
  have hprod (fresh : RepeatedBigFresh P C ell) :
      repeatedBigFreshMass V (fun _ _ => 1) C fresh * F (fresh g) =
        ∏ i, factors i (fresh i) := by
    simp only [factors, prod_mul_distrib, repeatedBigFreshMass, tiltedPhysicalBirthLaw, div_one]
    congr 1
    rw [prod_eq_single g]
    · simp
    · intro i _ hig
      simp only [dif_neg hig]
    · simp
  simp_rw [hprod]
  rw [← Fintype.prod_sum factors, prod_eq_single g]
  · simp only [factors, ↓reduceDIte, cleanAuxiliaryWeight]
  · intro i _ hig
    simp only [factors, dif_neg hig, mul_one]
    rw [← Fintype.prod_sum
      (fun (_j : {s : PhysicalSlots J ell // repeatedBigUnshared C i s}) (q : P i) =>
        physicalLabelLaw V i q)]
    simp only [physical_label_law_sum V i (hV i) (hMass i), prod_const_one]
  · simp

theorem repeated_big_unshared_type_card {G : Type*} {J ell : ℕ}
    (C : G → Finset (Fin J)) (g : G) :
    Fintype.card {s : PhysicalSlots J ell // repeatedBigUnshared C g s} = ell + (C g).card := by
  have he : {s : PhysicalSlots J ell // repeatedBigUnshared C g s} ≃
      ↥(physicalUnsharedSlots (ell := ell) (C g)) :=
    Equiv.subtypeEquivRight (repeated_big_unshared_iff_physical C g)
  rw [Fintype.card_congr he, Fintype.card_coe, physical_unshared_slots_card]

/-- A single group's forbidden mass uses exactly its number of fresh slots. -/
theorem repeated_big_initial_forbidden_group_mass_le {G : Type*}
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (F : ∀ g, Finset (P g)) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ)) (g : G) :
    (∑ a : {s : PhysicalSlots J ell // repeatedBigUnshared C g s} → P g,
      cleanAuxiliaryWeight (physicalLabelLaw V g) a * (if ∃ s, a s ∈ F g then 1 else 0)) ≤
      ((ell + (C g).card : ℕ) : ℝ) * (F g).card / (V g * Pmin) := by
  have h := finite_forbidden_hits_mass_le
    (A := {s : PhysicalSlots J ell // repeatedBigUnshared C g s}) (physicalLabelLaw V g)
    (physical_label_law_nonneg V (fun g => (hV g).le) g)
    (physical_label_law_sum V g (hV g) (hMass g)) (F g)
    (1 / (V g * Pmin)) (fun p => physical_label_law_atom_le V g (hV g) hPmin p (hp g p))
  rw [repeated_big_unshared_type_card] at h
  have hr : ((ell + (C g).card : ℕ) : ℝ) * (F g).card * (1 / (V g * Pmin)) =
      ((ell + (C g).card : ℕ) : ℝ) * (F g).card / (V g * Pmin) := by ring
  rw [hr] at h
  convert h using 1
  apply sum_congr
  · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
  · intro f _
    split_ifs <;> rfl

/-- The initial forbidden set is tested only at newly drawn target slots. -/
theorem repeated_big_initial_forbidden_fresh_mass_le {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (F : ∀ g, Finset (P g)) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ)) :
    (∑ fresh : RepeatedBigFresh P C ell,
      repeatedBigFreshMass V (fun _ _ => 1) C fresh *
        (if ∃ g s, fresh g s ∈ F g then 1 else 0)) ≤
      ∑ g, ((ell + (C g).card : ℕ) : ℝ) * (F g).card / (V g * Pmin) := by
  have h := finite_product_forbidden_hits_mass_le
    (A := fun g => {s : PhysicalSlots J ell // repeatedBigUnshared C g s})
    (fun g => physicalLabelLaw V g)
    (physical_label_law_nonneg V (fun g => (hV g).le))
    (fun g => physical_label_law_sum V g (hV g) (hMass g)) F
    (fun g => 1 / (V g * Pmin))
    (fun g p => physical_label_law_atom_le V g (hV g) hPmin p (hp g p))
  simp only [repeated_big_unshared_type_card, mul_one_div] at h
  simp only [repeatedBigFreshMass, tiltedPhysicalBirthLaw, div_one]
  convert h using 1
  apply sum_congr
  · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
  · intro f _
    split_ifs <;> rfl

/-- Exact compatible-target row bound. Shared target coordinates contribute
no loss, even when the source or target labels repeat. -/
theorem repeated_big_initial_forbidden_target_mass_le {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (F : ∀ g, Finset (P g)) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (source : RepeatedBigLists P J ell) :
    (∑ target : RepeatedBigLists P J ell,
      if repeatedBigSharedCompatible C source target then
        repeatedBigTargetMass V (fun _ _ => 1) C target *
          (if repeatedBigFreshHits F C target then 1 else 0) else 0) ≤
      ∑ g, ((ell + (C g).card : ℕ) : ℝ) * (F g).card / (V g * Pmin) := by
  rw [← repeated_big_target_sum C source]
  simp_rw [repeated_big_fill_mass, repeated_big_fresh_hits_fill]
  exact repeated_big_initial_forbidden_fresh_mass_le V C F hV hMass hPmin hp

/-- A repeated initial active list has at most one forbidden label per slot. -/
theorem repeated_big_initial_label_image_card_le {G : Type*}
    {P : G → Finset ℕ} {J ell : ℕ} (source : RepeatedBigLists P J ell) (g : G) :
    (univ.image (source g)).card ≤ J + ell := by
  apply (card_image_le).trans
  simp only [card_univ, PhysicalSlots, Fintype.card_sum, Fintype.card_fin, le_refl]

/-- Uniform finite budget when both the probe and initial-ledger sizes are bounded. -/
theorem repeated_big_initial_forbidden_probability_le {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell m : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (F : ∀ g, Finset (P g)) {v Pmin : ℝ} (hv : 0 < v) (hPmin : 0 < Pmin)
    (hV : ∀ g, v ≤ V g) (hC : ∀ g, (C g).card ≤ m)
    (hF : ∀ g, (F g).card ≤ J + ell) :
    repeatedBigInitialForbiddenProbability (ell := ell) V C F Pmin ≤
      (Fintype.card G : ℝ) * ((ell + m : ℕ) : ℝ) * ((J + ell : ℕ) : ℝ) / (v * Pmin) := by
  unfold repeatedBigInitialForbiddenProbability
  calc
    _ ≤ ∑ _g : G, ((ell + m : ℕ) : ℝ) * ((J + ell : ℕ) : ℝ) / (v * Pmin) := by
      apply sum_le_sum
      intro g _
      apply div_le_div₀ (by positivity)
      · apply mul_le_mul
        · exact_mod_cast Nat.add_le_add_left (hC g) ell
        · exact_mod_cast hF g
        · positivity
        · positivity
      · exact mul_pos hv hPmin
      · exact mul_le_mul_of_nonneg_right (hV g) hPmin.le
    _ = _ := by simp only [sum_const, card_univ, nsmul_eq_mul]; ring

end Bounty
end

section

/- Forest estimates for the actual dependent sample coordinates of an original event. -/

open Finset Classical

namespace Bounty

theorem labeled_anchored_forest_sum_le_equiv {I : Type*} [Fintype I] [DecidableEq I]
    (Z : I → Type*) [∀ i, Fintype (Z i)]
    {α : Type*} [Fintype α] [DecidableEq α] {n : ℕ} (e : Fin n ≃ I)
    (label : ∀ i, Z i → α) (w : ∀ i, Z i → ℝ)
    (code : BirthForestCode n) (anchor : Fin n → Option α)
    (M ε : I → ℝ) (hM : ∀ i, 0 ≤ M i) (hε : ∀ i, 0 ≤ ε i)
    (hw : ∀ i z, 0 ≤ w i z) (hsum : ∀ i, ∑ z, w i z ≤ M i)
    (hatom : ∀ i a, finiteLabelMass (label i) (w i) a ≤ ε i) :
    (∑ f : ∀ i, Z i,
      if birthForestEqualValues code (fun j => label (e j) (f (e j))) ∧
          birthLabelsAnchored anchor (fun j => label (e j) (f (e j))) then
        ∏ i, w i (f i) else 0) ≤
      ∏ j, match code j with
        | some _ => ε (e j)
        | none => match anchor j with | none => M (e j) | some _ => ε (e j) := by
  rw [← (Equiv.piCongrLeft Z e).sum_comp]
  have hp (f : ∀ j, Z (e j)) :
      (∏ i, w i ((Equiv.piCongrLeft Z e) f i)) = ∏ j, w (e j) (f j) := by
    rw [← e.prod_comp]
    simp only [Equiv.piCongrLeft_apply_apply]
  simp_rw [Equiv.piCongrLeft_apply_apply, hp]
  exact labeled_anchored_birth_forest_sum_le (fun j => Z (e j))
    (fun j => label (e j)) (fun j => w (e j)) code anchor (M ∘ e) (ε ∘ e)
    (fun j => hM (e j)) (fun j => hε (e j)) (fun j => hw (e j))
    (fun j => hsum (e j)) (fun j => hatom (e j))

theorem labeled_anchored_forest_continuation_le {I : Type*} [Fintype I] [DecidableEq I]
    (Z : I → Type*) [∀ i, Fintype (Z i)]
    {α : Type*} [Fintype α] [DecidableEq α] {n : ℕ} (e : Fin n ≃ I)
    (label : ∀ i, Z i → α) (w : ∀ i, Z i → ℝ)
    (code : BirthForestCode n) (anchor : Fin n → Option α)
    (M ε : I → ℝ) (hM : ∀ i, 0 ≤ M i) (hε : ∀ i, 0 ≤ ε i)
    (hw : ∀ i z, 0 ≤ w i z) (hsum : ∀ i, ∑ z, w i z ≤ M i)
    (hatom : ∀ i a, finiteLabelMass (label i) (w i) a ≤ ε i)
    (F : (∀ i, Z i) → ℝ) (K H : ℝ) (hK : 0 ≤ K) (hH : 0 ≤ H)
    (hF : ∀ f, F f ≤ H) :
    (∑ f : ∀ i, Z i,
      if birthForestEqualValues code (fun j => label (e j) (f (e j))) ∧
          birthLabelsAnchored anchor (fun j => label (e j) (f (e j))) then
        (K * ∏ i, w i (f i)) * F f else 0) ≤
      K * H * ∏ j, match code j with
        | some _ => ε (e j)
        | none => match anchor j with | none => M (e j) | some _ => ε (e j) := by
  calc
    _ ≤ K * H * (∑ f : ∀ i, Z i,
        if birthForestEqualValues code (fun j => label (e j) (f (e j))) ∧
            birthLabelsAnchored anchor (fun j => label (e j) (f (e j))) then
          ∏ i, w i (f i) else 0) := by
      rw [mul_sum]
      apply sum_le_sum
      intro f _
      split_ifs
      · calc
          _ ≤ (K * ∏ i, w i (f i)) * H :=
            mul_le_mul_of_nonneg_left (hF f) (mul_nonneg hK (prod_nonneg fun i _ => hw i (f i)))
          _ = _ := by ring
      · simp
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (labeled_anchored_forest_sum_le_equiv Z e label w code anchor M ε hM hε hw hsum hatom)
      (mul_nonneg hK hH)

end Bounty
end

section

/- Restrict an existing chronological forest to an ordered block of sampled coordinates. -/

open Classical

namespace Bounty

noncomputable def restrictedBirthCode {N m : ℕ} (embed : Fin m → Fin N)
    (code : BirthForestCode N) : BirthForestCode m := fun j =>
  match code (embed j) with
  | none => none
  | some p =>
    if h : ∃ k : Fin j.val,
        embed (birthForestParentEmbedding j k) = birthForestParentEmbedding (embed j) p then
      some (Classical.choose h)
    else none

noncomputable def restrictedBirthAnchors {N m : ℕ} {α : Type*}
    (embed : Fin m → Fin N) (code : BirthForestCode N) (values : Fin N → α) : Fin m → Option α := fun j =>
  match code (embed j) with
  | none => none
  | some p =>
    if ∃ k : Fin j.val,
        embed (birthForestParentEmbedding j k) = birthForestParentEmbedding (embed j) p then
      none
    else some (values (birthForestParentEmbedding (embed j) p))

theorem restricted_birth_parent_not_in_range {N m : ℕ} (embed : Fin m → Fin N)
    (hmono : StrictMono embed) (j : Fin m) (p : Fin (embed j).val)
    (h : ¬ ∃ k : Fin j.val,
      embed (birthForestParentEmbedding j k) = birthForestParentEmbedding (embed j) p) :
    birthForestParentEmbedding (embed j) p ∉ Set.range embed := by
  rintro ⟨k, hk⟩
  have hkj : k < j := hmono.lt_iff_lt.mp (by rw [hk]; exact p.isLt)
  exact h ⟨⟨k.val, hkj⟩, hk⟩

theorem restricted_birth_forest_iff {N m : ℕ} {α : Type*}
    (embed : Fin m → Fin N) (code : BirthForestCode N) (values : Fin N → α) :
    (∀ j p, code (embed j) = some p →
      values (embed j) = values (birthForestParentEmbedding (embed j) p)) ↔
    birthForestEqualValues (restrictedBirthCode embed code) (values ∘ embed) ∧
      birthLabelsAnchored (restrictedBirthAnchors embed code values) (values ∘ embed) := by
  constructor
  · intro h
    constructor
    · intro j k hk
      cases hc : code (embed j) with
      | none => simp [restrictedBirthCode, hc] at hk
      | some p =>
        by_cases he : ∃ r : Fin j.val,
            embed (birthForestParentEmbedding j r) = birthForestParentEmbedding (embed j) p
        · have hk' : Classical.choose he = k := by
            simpa only [restrictedBirthCode, hc, dif_pos he, Option.some.injEq] using hk
          change values (embed j) = values (embed (birthForestParentEmbedding j k))
          rw [← hk', Classical.choose_spec he]
          exact h j p hc
        · simp only [restrictedBirthCode, hc, dif_neg he] at hk
          cases hk
    · intro j a ha
      cases hc : code (embed j) with
      | none => simp [restrictedBirthAnchors, hc] at ha
      | some p =>
        by_cases he : ∃ r : Fin j.val,
            embed (birthForestParentEmbedding j r) = birthForestParentEmbedding (embed j) p
        · simp only [restrictedBirthAnchors, hc, if_pos he] at ha
          cases ha
        · have ha' : values (birthForestParentEmbedding (embed j) p) = a := by
            simpa only [restrictedBirthAnchors, hc, if_neg he, Option.some.injEq] using ha
          exact (h j p hc).trans ha'
  · rintro ⟨hi, ha⟩ j p hp
    by_cases he : ∃ r : Fin j.val,
        embed (birthForestParentEmbedding j r) = birthForestParentEmbedding (embed j) p
    · have hk : restrictedBirthCode embed code j = some (Classical.choose he) := by
        simp only [restrictedBirthCode, hp, dif_pos he]
      have hv := hi j (Classical.choose he) hk
      change values (embed j) = values (embed (birthForestParentEmbedding j (Classical.choose he))) at hv
      rwa [Classical.choose_spec he] at hv
    · apply ha j (values (birthForestParentEmbedding (embed j) p))
      simp only [restrictedBirthAnchors, hp, if_neg he]

theorem restricted_birth_anchors_local {N m : ℕ} {α : Type*}
    (embed : Fin m → Fin N) (hmono : StrictMono embed) (code : BirthForestCode N)
    (values other : Fin N → α)
    (hvalues : ∀ i, i ∉ Set.range embed → values i = other i) :
    restrictedBirthAnchors embed code values = restrictedBirthAnchors embed code other := by
  funext j
  cases hc : code (embed j) with
  | none => simp only [restrictedBirthAnchors, hc]
  | some p =>
    by_cases he : ∃ r : Fin j.val,
        embed (birthForestParentEmbedding j r) = birthForestParentEmbedding (embed j) p
    · simp only [restrictedBirthAnchors, hc, if_pos he]
    · simp only [restrictedBirthAnchors, hc, if_neg he]
      congr 1
      exact hvalues _ (restricted_birth_parent_not_in_range embed hmono j p he)

theorem restricted_birth_cost_eq {N m : ℕ} {α : Type*}
    (embed : Fin m → Fin N) (code : BirthForestCode N) (values : Fin N → α)
    (M ε : Fin m → ℝ) (j : Fin m) :
    (match restrictedBirthCode embed code j with
      | some _ => ε j
      | none => match restrictedBirthAnchors embed code values j with
        | none => M j | some _ => ε j) =
    match code (embed j) with | none => M j | some _ => ε j := by
  cases hc : code (embed j) with
  | none => simp only [restrictedBirthCode, restrictedBirthAnchors, hc]
  | some p =>
    by_cases he : ∃ r : Fin j.val,
        embed (birthForestParentEmbedding j r) = birthForestParentEmbedding (embed j) p
    · simp only [restrictedBirthCode, hc, dif_pos he]
    · simp only [restrictedBirthCode, restrictedBirthAnchors, hc, dif_neg he, if_neg he]

end Bounty
end

section

/- Reindex all pending memories inside the complete coupled edge sum. -/

open Finset Classical
namespace Bounty
section Joint
variable {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] (Δ D : G → ℤ)
    (t : G → ℕ) (B : ℕ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B)
    (τ : ∀ g, Equiv.Perm (Fin (s g).2.1.val))

noncomputable def jointEdgeMemoryReindex : UnrestrictedJointEvent n Δ D t B s ≃
    UnrestrictedJointEvent n Δ D t B (productMemoryReindex s τ) :=
  Equiv.piCongrRight fun g => boundedEdgeMemoryReindex (n g) (Δ g) (D g) (s g) (τ g)

theorem joint_edge_reindex_test (e : UnrestrictedJointEvent n Δ D t B s)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    f (unrestrictedJointEventTarget n Δ D t B (productMemoryReindex s τ)
      (jointEdgeMemoryReindex n Δ D t B s τ e)) =
      f (unrestrictedJointEventTarget n Δ D t B s e) := by
  apply product_memory_test_congr f hf
  intro g h hh
  exact bounded_edge_reindex_test (n g) (Δ g) (D g) (s g) (τ g) (e g) h hh

omit [Fintype G] [DecidableEq G] in
theorem joint_edge_reindex_active (e : UnrestrictedJointEvent n Δ D t B s) (g : G) :
    (unrestrictedJointEventTarget n Δ D t B (productMemoryReindex s τ)
      (jointEdgeMemoryReindex n Δ D t B s τ e) g).1 =
      (unrestrictedJointEventTarget n Δ D t B s e g).1 :=
  bounded_edge_reindex_active (n g) (Δ g) (D g) (s g) (τ g) (e g)

omit [DecidableEq G] in
theorem joint_edge_reindex_total (e : UnrestrictedJointEvent n Δ D t B s) :
    productTotalMemory (unrestrictedJointEventTarget n Δ D t B (productMemoryReindex s τ)
      (jointEdgeMemoryReindex n Δ D t B s τ e)) =
      productTotalMemory (unrestrictedJointEventTarget n Δ D t B s e) := by
  apply sum_congr rfl
  intro g _
  exact congrArg Fin.val (bounded_edge_reindex_length (n g) (Δ g) (D g) (s g) (τ g) (e g))

omit [DecidableEq G] in
theorem joint_edge_reindex_weight (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (e : UnrestrictedJointEvent n Δ D t B s) :
    unrestrictedJointCutoffEventWeight n Δ D μ ρ V t B (productMemoryReindex s τ)
      (jointEdgeMemoryReindex n Δ D t B s τ e) =
      unrestrictedJointCutoffEventWeight n Δ D μ ρ V t B s e := by
  unfold unrestrictedJointCutoffEventWeight
  rw [joint_edge_reindex_total]
  have hs : productTotalMemory (productMemoryReindex s τ) = productTotalMemory s := rfl
  rw [hs]
  split_ifs
  · apply prod_congr rfl
    intro g _
    exact bounded_edge_reindex_weight (n g) (Δ g) (D g) (s g) (τ g) (e g) (μ g) ρ (V g)
  · rfl

end Joint
end Bounty
end

section

/- Exact physical history normalization under adjacent common-mark compatibility.
No global residue assignment is supplied; all original local rows and cutoffs remain. -/

open Finset
namespace Bounty

section ResiduePath
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (hcompat : ∀ j : Fin n, ∀ g s t,
    ((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val =
      ((physicalPermuteLabels (τ j) (L j.succ)) g t).val →
    (((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val : ℤ) ∣
      k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))

variable
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ) (η : Fin N → Fin (n + 1) → ℝ)
  (V ρ : Fin N → ℝ) (hV : ∀ g, V g ≠ 0) (cap : ℕ)


variable [∀ g, ∀ p : ↥(P g), NeZero p.val]

/- The normalized actual joint residue history equals a single real capped
moving history on the tagged prime pool, with every total output cap retained. -/
include hstep in
theorem physical_joint_adjacent_normalized_eq_capped_moving :
    ((∏ g, ∏ s : PhysicalSlots J ell, β g (L 0 g s) / V g : ℝ) : ℂ) *
      physicalJointAdjacentRawHistory C aux k L a σ τ hcompat hlist hP hdis hk β η V ρ hV cap =
    (ghostPhaseCappedMovingDampedHistory
      (fun p : PhysicalPrime P => fun j => globalBirthFiniteActivity (physicalGroupBareFiniteActivity L p.1) j p.2)
      (fun p => physicalResidueAbsoluteHit a p.1 p.2)
      (fun p j => η p.1 (globalBirthFiniteIndex n j))
      (fun p => β p.1 p.2) (fun p => V p.1) (fun p _ => ρ p.1)
      (fun _ => cap) (fun _ => cap) n : ℂ) := by
  rw [physical_joint_adjacent_normalized_history_trace]
  simp only [ghost_phase_run_initial_eq_tilted]
  have hc := global_birth_joint_initial_trace_output_only
    (fun i g => physicalGroupBareAtomicActivity L g i)
    (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β η V ρ hV cap)
    (fun _ => cap) (fun g p => β g p / V g)
    (fun z => ((∏ g, ∏ p, ghostPhaseTerminal (physicalGroupPhaseActivity (L (Fin.last n)) g p)
      (z g p) : ℝ) : ℂ)) (2 * n + 1)
  simp only [physical_group_bare_atomic_activity_initial, finiteChronologicalPrefix] at hc
  rw [hc]
  let f := fun z : (p : PhysicalPrime P) → GhostPhaseState (ZMod p.2.val) =>
    ∏ p, ghostPhaseRunInitial (physicalGroupPhaseActivity (L 0) p.1 p.2) (β p.1 p.2) (V p.1) (z p)
  let q := fun z : (p : PhysicalPrime P) → GhostPhaseState (ZMod p.2.val) =>
    ∏ p, ghostPhaseTerminal (physicalGroupPhaseActivity (L (Fin.last n)) p.1 p.2) (z p)
  have he := complex_trace_eq_real_alternating_equiv
    (globalBirthFlattenEquiv (P := fun g : Fin N => ↥(P g)) (R := fun g p => ZMod p.val))
    (physicalJointCappedVisitKernel L β η ρ cap)
    (physicalJointCappedMovingEdgeKernel L a β V ρ cap)
    (fun i => globalBirthJointKernel
      (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β η V ρ hV cap i) cap)
    f q n (fun i hi z w => physical_joint_adjacent_kernel_to_real
      C aux k L a σ τ hstep hcompat hlist hP hdis hk β η V ρ hV cap i hi z w)
  have h0 (g : Fin N) : globalBirthFiniteActivity (physicalGroupBareFiniteActivity L g) 0 =
      physicalGroupPhaseActivity (L 0) g :=
    global_birth_finite_activity_at (physicalGroupBareFiniteActivity L g) (0 : Fin (n + 1))
  have hn (g : Fin N) : globalBirthFiniteActivity (physicalGroupBareFiniteActivity L g) n =
      physicalGroupPhaseActivity (L (Fin.last n)) g :=
    global_birth_finite_activity_at (physicalGroupBareFiniteActivity L g) (Fin.last n)
  calc
    _ = (finiteAlternatingPairing (physicalJointCappedVisitKernel L β η ρ cap)
        (physicalJointCappedMovingEdgeKernel L a β V ρ cap) f q n : ℂ) := by
      simpa only [f, q, Fintype.prod_sigma, globalBirthFlattenEquiv, Equiv.coe_fn_mk,
        ghost_phase_run_initial_eq_tilted] using he
    _ = _ := by
      congr 1
      unfold ghostPhaseCappedMovingDampedHistory
      change finiteAlternatingPairing (physicalJointCappedVisitKernel L β η ρ cap)
        (physicalJointCappedMovingEdgeKernel L a β V ρ cap) _ _ n =
        finiteAlternatingPairing (physicalJointCappedVisitKernel L β η ρ cap)
          (physicalJointCappedMovingEdgeKernel L a β V ρ cap) _ _ n
      dsimp only [f, q]
      simp only [h0, hn]

/- Nonzero group damping parameters disappear from the actual joint trace.
This equality retains the intended total pending-memory cutoff. -/
include hstep in
theorem physical_joint_adjacent_normalized_eq_capped_absolute (hρ : ∀ g, ρ g ≠ 0) :
    ((∏ g, ∏ s : PhysicalSlots J ell, β g (L 0 g s) / V g : ℝ) : ℂ) *
      physicalJointAdjacentRawHistory C aux k L a σ τ hcompat hlist hP hdis hk β η V ρ hV cap =
    (ghostPhaseCappedHistory
      (fun p : PhysicalPrime P => fun j => globalBirthFiniteActivity (physicalGroupBareFiniteActivity L p.1) j p.2)
      (fun p => physicalResidueAbsoluteHit a p.1 p.2)
      (fun p j => η p.1 (globalBirthFiniteIndex n j))
      (fun p => β p.1 p.2) (fun p => V p.1) (fun _ => cap) (fun _ => cap) n : ℂ) := by
  rw [physical_joint_adjacent_normalized_eq_capped_moving C aux k L a σ τ hstep hcompat hlist hP hdis hk β η V ρ hV cap]
  exact congrArg (fun r : ℝ => (r : ℂ))
    (ghost_phase_capped_moving_history_eq_undamped
      (fun p : PhysicalPrime P => fun j => globalBirthFiniteActivity (physicalGroupBareFiniteActivity L p.1) j p.2)
      (fun p => physicalResidueAbsoluteHit a p.1 p.2)
      (fun p j => η p.1 (globalBirthFiniteIndex n j))
      (fun p => β p.1 p.2) (fun p => V p.1) (fun p _ => ρ p.1)
      (fun _ => cap) (fun _ => cap) (fun p _ => hρ p.1) n)

end ResiduePath
end Bounty
end

section

/- The exact cofactor-first prime-interval sum for rough integers. -/

open Finset

namespace Bounty

theorem weighted_rough_band_cofactor_identity {M : Type*} [AddCommMonoid M]
    {U V z : ℝ} (hU : 1 ≤ U) (hV : 0 ≤ V) (hz : 0 ≤ z) (w : ℕ → M) :
    (∑ n ∈ roughBand U V z, w n) = (∑ p ∈ primeBand (max U z) V, w p)+
      ∑ m ∈ roughBand 1 V z,
        ∑ p ∈ (primeBand z (m.minFac : ℝ)).filter
          (fun p : ℕ => U < (m : ℝ)*(p : ℝ) ∧ (m : ℝ)*(p : ℝ) ≤ V), w (p*m) := by
  classical
  have hU0 : 0 ≤ U := by linarith
  have hSlo : ∀ n ∈ roughBand U V z, 2 ≤ n := by
    intro n hn
    have hlo := Nat.lt_of_floor_lt (mem_Ioc.mp (mem_filter.mp hn).1).1
    have hn1 : (1 : ℝ) < n := hU.trans_lt hlo
    exact_mod_cast hn1
  have hShi : ∀ n ∈ roughBand U V z, n ≤ ⌊V⌋₊ := fun n hn => (mem_Ioc.mp (mem_filter.mp hn).1).2
  have hrough : ∀ n ∈ roughBand U V z, ∀ p ∈ n.primeFactors, z < (p : ℝ) :=
    fun n hn => (mem_filter.mp hn).2
  have h := weighted_buchstab_identity (roughBand U V z) ⌊V⌋₊ w hz hSlo hShi hrough
  have hP : primeBand z (⌊V⌋₊ : ℝ) = primeBand z V := by simp only [primeBand, Nat.floor_natCast]
  rw [prime_part_of_rough_band hU0 hV, hP] at h
  rw [h]
  congr 1
  calc
    _ = ∑ p ∈ primeBand z V, ∑ m ∈ roughBand 1 V z,
        if p ≤ m.minFac ∧ U < ((p*m : ℕ) : ℝ) ∧ ((p*m : ℕ) : ℝ) ≤ V then w (p*m) else 0 := by
      apply sum_congr rfl
      intro p hp
      obtain ⟨hpp, hpz, _⟩ := (mem_primeBand_iff hz hV p).mp hp
      rw [buchstab_cofactors_as_rough_band hU hV hpp hpz, sum_filter]
    _ = ∑ m ∈ roughBand 1 V z, ∑ p ∈ primeBand z V,
        if p ≤ m.minFac ∧ U < ((p*m : ℕ) : ℝ) ∧ ((p*m : ℕ) : ℝ) ≤ V then w (p*m) else 0 := sum_comm
    _ = _ := by
      apply sum_congr rfl
      intro m hm
      have hmV : (m : ℝ) ≤ V :=
        (Nat.cast_le.mpr (mem_Ioc.mp (mem_filter.mp hm).1).2).trans (Nat.floor_le hV)
      have hfacV : (m.minFac : ℝ) ≤ V :=
        (Nat.cast_le.mpr (Nat.minFac_le (roughBand_pos hm))).trans hmV
      have hset : (primeBand z V).filter
          (fun p : ℕ => p ≤ m.minFac ∧ U < ((p*m : ℕ) : ℝ) ∧ ((p*m : ℕ) : ℝ) ≤ V) =
          ((primeBand z V).filter (fun p : ℕ => U < (m : ℝ)*(p : ℝ) ∧ (m : ℝ)*(p : ℝ) ≤ V)).filter
            (fun p => p ≤ m.minFac) := by
        ext p
        simp only [mem_filter, Nat.cast_mul, mul_comm (p : ℝ) (m : ℝ)]
        tauto
      rw [← sum_filter, hset, primeBand_product_filter_prefix hz hV m.minFac, min_eq_right hfacV]

end Bounty
end

section

/- Fixed marked birth positions shift the existing ghost factorial series without any counting factor. -/

open Finset Classical

namespace Bounty

theorem marked_ghost_series_term_le (ℓ ε v : ℝ) (hℓ : 0 ≤ ℓ) (hε : 0 ≤ ε)
    (hv : 0 ≤ v) (b d : ℕ) (hd : d ≤ b) :
    ε ^ d * ℓ ^ (b - d) * v ^ b / (b.factorial : ℝ) ≤
      (ε * v) ^ d * ((ℓ * v) ^ (b - d) / ((b - d).factorial : ℝ)) := by
  have hvpow : v ^ b = v ^ d * v ^ (b - d) := by
    rw [← pow_add, Nat.add_sub_of_le hd]
  have hfac : ((b - d).factorial : ℝ) ≤ (b.factorial : ℝ) := by
    exact_mod_cast Nat.factorial_le (Nat.sub_le b d)
  calc
    _ = (ε * v) ^ d * ((ℓ * v) ^ (b - d) / (b.factorial : ℝ)) := by
      rw [hvpow, mul_pow, mul_pow]
      ring
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (div_le_div_of_nonneg_left (pow_nonneg (mul_nonneg hℓ hv) _)
        (by positivity) hfac) (pow_nonneg (mul_nonneg hε hv) _)

theorem marked_ghost_series_le (ℓ ε v : ℝ) (hℓ : 0 ≤ ℓ) (hε : 0 ≤ ε)
    (hv : 0 ≤ v) (B d : ℕ) :
    (∑ b ∈ range (B + 1), if d ≤ b then
      ε ^ d * ℓ ^ (b - d) * v ^ b / (b.factorial : ℝ) else 0) ≤
      (ε * v) ^ d * Real.exp (ℓ * v) := by
  have hs : (range (B + 1)).filter (fun b => d ≤ b) = Ico d (B + 1) := by
    ext b
    simp only [mem_filter, mem_range, mem_Ico]
    tauto
  calc
    _ ≤ ∑ b ∈ range (B + 1), if d ≤ b then
        (ε * v) ^ d * ((ℓ * v) ^ (b - d) / ((b - d).factorial : ℝ)) else 0 := by
      apply sum_le_sum
      intro b _
      split_ifs with h
      · exact marked_ghost_series_term_le ℓ ε v hℓ hε hv b d h
      · exact le_rfl
    _ = (ε * v) ^ d * ∑ b ∈ Ico d (B + 1),
        (ℓ * v) ^ (b - d) / ((b - d).factorial : ℝ) := by
      rw [← sum_filter, hs, mul_sum]
    _ = (ε * v) ^ d * ∑ b ∈ range (B + 1 - d), (ℓ * v) ^ b / (b.factorial : ℝ) := by
      rw [sum_Ico_eq_sum_range]
      simp only [Nat.add_sub_cancel_left]
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (Real.sum_le_exp_of_nonneg (mul_nonneg hℓ hv) _) (pow_nonneg (mul_nonneg hε hv) _)

end Bounty
end

section

/- Marked fresh edge slots retain an explicit atom cost through the original skeleton row. -/

open Finset Classical

namespace Bounty

theorem unrestricted_marked_choice_row_le {P : Type*}
    (n : P → ℕ) (Δ D : ℤ) (ρ V v ℓ ε : ℝ)
    (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1) (hV : 0 ≤ V) (hv : 0 < v)
    (hℓ : 0 ≤ ℓ) (hℓ2 : ℓ ≤ 2) (hε : 0 ≤ ε)
    (t B d : ℕ) (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (stores promotions : Finset (Fin t)) :
    (∑ e : promotions ↪ ↥(unrestrictedResidueEligible n Δ D s.2.2),
      if d ≤ t - promotions.card then
        |unrestrictedBoundedSkeletonMass n Δ D ρ V t B s stores promotions e| *
          v ^ unrestrictedSkeletonOutputCount n Δ D t B s ⟨stores, promotions, e⟩ *
          ε ^ d * ℓ ^ (t - promotions.card - d) else 0) ≤
      ε ^ d * v ^ s.2.1.val * unrestrictedEdgeChoiceCost ρ v V 2
        (unrestrictedResidueEligible n Δ D s.2.2).card t promotions.card stores.card := by
  have hcost := unrestrictedEdgeChoiceCost_nonneg hρ0 hv.le hV (by norm_num : (0 : ℝ) ≤ 2)
    (unrestrictedResidueEligible n Δ D s.2.2).card t promotions.card stores.card
  by_cases hd : d ≤ t - promotions.card
  · simp only [hd, if_true]
    have hpow : ℓ ^ (t - promotions.card - d) ≤ (2 : ℝ) ^ (t - promotions.card) :=
      (pow_le_pow_left₀ hℓ hℓ2 _).trans (pow_le_pow_right₀ (by norm_num) (Nat.sub_le _ _))
    calc
      _ ≤ ∑ _e : promotions ↪ ↥(unrestrictedResidueEligible n Δ D s.2.2),
          ((ρ ^ ((unrestrictedResidueEligible n Δ D s.2.2).card - promotions.card) /
            V ^ promotions.card) * (v ^ s.2.1.val * (v ^ stores.card / v ^ promotions.card))) *
              ε ^ d * (2 : ℝ) ^ (t - promotions.card) := by
        apply sum_le_sum
        intro e _
        apply mul_le_mul
        · exact mul_le_mul_of_nonneg_right
            (unrestricted_bounded_skeleton_length_cost n Δ D ρ V v hρ0 hρ1 hV hv t B s
              ⟨stores, promotions, e⟩) (pow_nonneg hε _)
        · exact hpow
        · exact pow_nonneg hℓ _
        · positivity
      _ = _ := by
        simp only [sum_const, card_univ, nsmul_eq_mul, promotionChoice_card, Fintype.card_coe]
        unfold unrestrictedEdgeChoiceCost
        ring
  · simp only [hd, if_false, sum_const_zero]
    exact mul_nonneg (mul_nonneg (pow_nonneg hε _) (pow_nonneg hv.le _)) hcost

theorem unrestricted_bounded_marked_length_row_le {P : Type*}
    (n : P → ℕ) (Δ D : ℤ) (ρ V v vmin ℓ ε : ℝ)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin) (hV : vmin ≤ V)
    (hℓ : 0 ≤ ℓ) (hℓ2 : ℓ ≤ 2) (hε : 0 ≤ ε)
    (t B T d : ℕ) (ht : t ≤ T) (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B) :
    (∑ sk : UnrestrictedLocalEdgeSkeleton n Δ D t B s,
      if d ≤ t - sk.2.1.card then
        |unrestrictedBoundedSkeletonMass n Δ D ρ V t B s sk.1 sk.2.1 sk.2.2| *
          v ^ unrestrictedSkeletonOutputCount n Δ D t B s sk *
          ε ^ d * ℓ ^ (t - sk.2.1.card - d) else 0) ≤
      ε ^ d * v ^ s.2.1.val * unrestrictedEdgeRowBound ρ v vmin T := by
  calc
    _ ≤ ε ^ d * v ^ s.2.1.val * unrestrictedEdgeRowCost ρ v V 2 t
        (fun _ _ => (unrestrictedResidueEligible n Δ D s.2.2).card) := by
      simp only [Fintype.sum_sigma, unrestrictedEdgeRowCost, mul_sum]
      apply sum_le_sum
      intro stores _
      apply sum_le_sum
      intro promotions _
      exact unrestricted_marked_choice_row_le n Δ D ρ V v ℓ ε hρ0.le hρ1.le
        (hvmin.trans_le hV).le (zero_lt_one.trans hv) hℓ hℓ2 hε t B d s stores promotions
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (unrestricted_edge_row_cost_le hρ0 hρ1 hv hvmin hV (by norm_num : (0 : ℝ) ≤ 2) le_rfl
        T t ht (fun _ _ => (unrestrictedResidueEligible n Δ D s.2.2).card))
      (mul_nonneg (pow_nonneg hε _) (pow_nonneg (zero_lt_one.trans hv).le _))

end Bounty
end

section

/- Convert the local forest product into its exact number of constrained births in each group. -/

open Finset Classical

namespace Bounty

theorem finite_product_two_values {I : Type*} [Fintype I]
    (selected : I → Prop) [DecidablePred selected] (root atom : ℝ) :
    (∏ i, if selected i then atom else root) =
      atom ^ (univ.filter selected).card * root ^ (Fintype.card I - (univ.filter selected).card) := by
  rw [prod_ite, prod_const, prod_const]
  have hc := univ.card_filter_add_card_filter_not selected
  simp only [card_univ] at hc
  have hn : (univ.filter (fun i => ¬ selected i)).card = Fintype.card I - (univ.filter selected).card := by omega
  rw [hn]

theorem grouped_forest_cost_eq {G : Type*} [Fintype G] [DecidableEq G]
    (I : G → Type*) [∀ g, Fintype (I g)] {m : ℕ} {α : Type*}
    (ord : Fin m ≃ Sigma I) (code : BirthForestCode m) (anchor : Fin m → Option α)
    (root atom : G → ℝ) (d : G → ℕ)
    (hd : ∀ g, (univ.filter (fun i : I g =>
      code (ord.symm ⟨g, i⟩) ≠ none ∨ anchor (ord.symm ⟨g, i⟩) ≠ none)).card = d g) :
    (∏ j, match code j with
      | some _ => atom (ord j).1
      | none => match anchor j with | none => root (ord j).1 | some _ => atom (ord j).1) =
      ∏ g, atom g ^ d g * root g ^ (Fintype.card (I g) - d g) := by
  rw [← ord.symm.prod_comp]
  calc
    _ = ∏ i : Sigma I, if code (ord.symm i) ≠ none ∨ anchor (ord.symm i) ≠ none then atom i.1 else root i.1 := by
      apply prod_congr rfl
      intro i _
      simp only [Equiv.apply_symm_apply]
      cases code (ord.symm i) <;> cases anchor (ord.symm i) <;> simp
    _ = _ := by
      rw [Fintype.prod_sigma]
      apply prod_congr rfl
      intro g _
      have hh := finite_product_two_values
        (fun y : I g => code (ord.symm ⟨g, y⟩) ≠ none ∨ anchor (ord.symm ⟨g, y⟩) ≠ none)
        (root g) (atom g)
      rw [hd g] at hh
      exact hh

end Bounty
end

section

/- Original physical edge rows preserve coherent continuation tests, including bad edges. -/

open Finset
open scoped Classical
namespace Bounty
section Edge
variable {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin N → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
  (k : ℤ) (L R : PhysicalMarkLists P J ell)
  (hlist : physicalListAdmissible C aux L R)
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ g s, ¬ ((L g s).val : ℤ) ∣ k)
  (β : (g : Fin N) → ↥(P g) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

noncomputable def physicalJointBareEdgeStep
    (hcompat : ∀ g s t, (L g s).val = (R g t).val →
      ((L g s).val : ℤ) ∣ k * (physicalD C L aux : ℤ)) (g : Fin N) :
    GlobalBirthRawStep (R := fun p : ↥(P g) => ZMod p.val)
      (physicalGroupPhaseActivity L g) (physicalGroupPhaseActivity R g) :=
  physicalGroupBareRawEdge C aux k L R 0 hlist hP hdis hcompat g (hk g) (β g) ρ (V g) B

theorem physical_raw_tensor_eq_bare_step
    (hcompat : ∀ g s t, (L g s).val = (R g t).val →
      ((L g s).val : ℤ) ∣ k * (physicalD C L aux : ℤ))
    (F : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ)
    (s : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val)) :
    jointRawTensorCutoff B (physicalFullEdgeRawRow (B := B) C k L R β ρ V aux) F s =
      globalBirthJointCutRawRow
        (physicalJointBareEdgeStep (B := B) C aux k L R hlist hP hdis hk β ρ V hcompat) B B F s := by
  have hr : (fun g (K : GlobalBirthHistoryState (fun p : ↥(P g) => ZMod p.val) → ℂ)
      (u : GlobalBirthHistoryState (fun p : ↥(P g) => ZMod p.val)) =>
        globalBirthRawStepRow
          (physicalJointBareEdgeStep (B := B) C aux k L R hlist hP hdis hk β ρ V hcompat g)
          (fun H q => K (H, q)) u.1 u.2) =
      physicalFullEdgeRawRow (B := B) C k L R β ρ V aux := by
    funext g K u
    unfold physicalJointBareEdgeStep
    rw [physical_group_bare_raw_edge_row]
    have hd := physical_group_phase_delta_as_integer_step (P := P)
      0 (0 + k * (physicalD C L aux : ℤ)) k (physicalD C L aux : ℤ) rfl g
    rw [hd]
    rfl
  unfold jointRawTensorCutoff globalBirthJointCutRawRow globalBirthJointRawRow
  rw [hr]

include hlist in
theorem physical_raw_tensor_zero_of_bad_edge
    (hbad : ¬ ∀ g s t, (L g s).val = (R g t).val →
      ((L g s).val : ℤ) ∣ k * (physicalD C L aux : ℤ))
    (F : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ)
    (s : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val))
    (hs : GlobalBirthJointCoherent (fun g => physicalGroupPhaseActivity L g) s) :
    jointRawTensorCutoff B (physicalFullEdgeRawRow (B := B) C k L R β ρ V aux) F s = 0 := by
  push Not at hbad
  obtain ⟨g, i, j, he, hn⟩ := hbad
  unfold jointRawTensorCutoff globalBirthJointRawCutoff
  split_ifs
  · refine fin_tensor_row_zero_at N _ s ?_ g ?_ _
    · intro h
      simpa only [zero_mul] using
        physical_full_edge_raw_row_mul (B := B) C k L R β ρ V aux h 0 (fun _ => 0) (s h)
    · intro K
      exact physical_full_edge_raw_zero_of_bad_common_mark C aux k L R hlist β ρ V
        g i j he hn (s g) (hs g) K
  · rfl

include hlist hP hdis hk in
theorem physical_raw_tensor_coherent_congr
    [∀ g, ∀ p : ↥(P g), NeZero p.val]
    (F G : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ)
    (hFG : ∀ t, GlobalBirthJointCoherent (fun g => physicalGroupPhaseActivity R g) t → F t = G t)
    (s : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val))
    (hs : GlobalBirthJointCoherent (fun g => physicalGroupPhaseActivity L g) s) :
    jointRawTensorCutoff B (physicalFullEdgeRawRow (B := B) C k L R β ρ V aux) F s =
      jointRawTensorCutoff B (physicalFullEdgeRawRow (B := B) C k L R β ρ V aux) G s := by
  by_cases hc : ∀ g i j, (L g i).val = (R g j).val →
      ((L g i).val : ℤ) ∣ k * (physicalD C L aux : ℤ)
  · rw [physical_raw_tensor_eq_bare_step C aux k L R hlist hP hdis hk β ρ V hc,
      physical_raw_tensor_eq_bare_step C aux k L R hlist hP hdis hk β ρ V hc]
    exact global_birth_joint_cut_raw_row_congr _ B B F G hFG s hs
  · rw [physical_raw_tensor_zero_of_bad_edge C aux k L R hlist β ρ V hc F s hs,
      physical_raw_tensor_zero_of_bad_edge C aux k L R hlist β ρ V hc G s hs]

end Edge
end Bounty
