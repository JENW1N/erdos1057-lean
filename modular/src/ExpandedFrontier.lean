  simp only [Finset.sum_apply]
  apply sum_congr rfl
  intro i _
  apply physical_mixed_coefficient_signed_memory_symmetric _ _ _ _ _ _ _ _ _ _ f hf s x g τ
  intro a y σ e
  rw [physical_mixed_target_labels_reindex, hφ i a y σ e]
  rfl

