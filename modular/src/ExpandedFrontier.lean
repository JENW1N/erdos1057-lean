section

/- The fixed compact cutoff preserves the actual allocation exactly on good tuples. -/

open Finset Filter Real

namespace Bounty

noncomputable def candidateCompactAllocationWeight (c L : ℝ) (r jStar : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) (R : ℝ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) : ℝ :=
  compactAllocationWeight (candidateAllocationRadius r) _
    (fun i => log (candidateAllocationValue c L r jStar x i))
    (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val)
    (candidateAllocationActive c L r jStar) R take

theorem candidate_compact_allocation_bounds (c L : ℝ) (r jStar : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) (R : ℝ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) :
    0 ≤ candidateCompactAllocationWeight c L r jStar x R take ∧
      candidateCompactAllocationWeight c L r jStar x R take ≤
        candidateAllocationWeight c L r jStar x R take :=
  compact_allocation_weight_bounds _ _ _ _ _ _ _

theorem candidate_compact_allocation_total_mass_le_one (c L : ℝ) (r jStar : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) (R : ℝ) :
    (∑ take, candidateCompactAllocationWeight c L r jStar x R take) ≤ 1 :=
  compact_allocation_total_mass_le_one _ _ _ _ _ _

theorem eventually_candidate_compact_allocation_exact {c : ℝ} (hc : 0 < c)
    {r : ℕ} (hr : 6 ≤ r) :
    ∀ᶠ L : ℝ in atTop, ∀ (jStar : ℕ) (x : ∀ slot, candidateQSlotChoices c L r jStar slot)
      (R : ℝ), 0 ≤ R → R ≤ smoothAllocationInventory _
        (fun i => log (candidateAllocationValue c L r jStar x i))
        (candidateAllocationActive c L r jStar)+88*log L →
      (∀ take, candidateCompactAllocationWeight c L r jStar x R take =
        candidateAllocationWeight c L r jStar x R take) ∧
      (∑ take, candidateCompactAllocationWeight c L r jStar x R take) = 1 := by
  filter_upwards [eventually_candidate_allocation_arguments_bounded hc hr] with L hargs
  intro jStar x R hR hcap
  have heq : ∀ take, candidateCompactAllocationWeight c L r jStar x R take =
      candidateAllocationWeight c L r jStar x R take := by
    intro take
    by_cases hpos : 0 < candidateAllocationWeight c L r jStar x R take
    · apply compact_allocation_eq_of_args
      intro i hi
      exact hargs jStar x R take hR hcap hpos i
    · have hb := candidate_compact_allocation_bounds c L r jStar x R take
      have hn := candidate_allocation_weight_nonneg c L r jStar x R take
      linarith
  refine ⟨heq, ?_⟩
  simp only [heq, candidate_allocation_total_mass]

theorem eventually_candidate_good_tuple_compact_allocation {c : ℝ} (hc : 0 < c)
    {r : ℕ} (hr : 6 ≤ r) :
    ∀ᶠ L : ℝ in atTop, ∀ (jStar P : ℕ) (hj : jStar ∈ candidateQIndices c L)
      (x : ∀ slot, candidateQSlotChoices c L r jStar slot) (E b : ℝ),
      0 ≤ b → 1 ≤ E →
      exp L ≤ (P*orderedSlotProduct (candidateQSlotChoices c L r jStar) x : ℕ) →
      (P*(x (candidateRoughSlot c L r jStar (by omega) hj)).val : ℕ) ≤ exp (b/2*L) →
      log E ≤ (1-b)*L →
      (∀ take, candidateCompactAllocationWeight c L r jStar x (log E) take =
        candidateAllocationWeight c L r jStar x (log E) take) ∧
      (∑ take, candidateCompactAllocationWeight c L r jStar x (log E) take) = 1 := by
  filter_upwards [eventually_candidate_compact_allocation_exact hc hr,
    eventually_ge_atTop (1 : ℝ)] with L hL hL1
  intro jStar P hj x E b hb hE1 htotal hretained hE
  apply hL jStar x (log E) (log_nonneg hE1)
  have hi := candidate_allocation_inventory_of_product_bounds c L r jStar P (by omega) hj x
    L (b/2*L) htotal hretained
  have hlog := log_nonneg hL1
  nlinarith [mul_nonneg hb (zero_le_one.trans hL1)]

end Bounty
end

section

/- Explicit polynomial envelope for the actual Type-II scale parameters. -/

open Filter MeasureTheory

namespace Bounty

noncomputable def typeIIScaleParameters (L U V E Z : ℝ) (k : ℤ) : Fin 4 → ℝ :=
  ![L ^ 88, U / (2 * (k : ℝ) * E), Z / ((k : ℝ) * U * V), 1 / (U * V)]

noncomputable def typeIIScaleEnvelopeExponent (K₀ Cz : ℝ) : ℝ :=
  max 88 (max K₀ (max Cz 0))

theorem typeII_integer_abs_ge_one {k : ℤ} (hk : k ≠ 0) : 1 ≤ |(k : ℝ)| := by
  have hpos : (0 : ℤ) < |k| := abs_pos.mpr hk
  have h : (1 : ℤ) ≤ |k| := by omega
  exact_mod_cast h

theorem typeII_scale_first_coefficient {L U E K₀ : ℝ} {k : ℤ}
    (hL : 0 < L) (hU : 0 < U) (hk : k ≠ 0) (hE : E = U * L ^ (-K₀)) :
    U / (2 * (k : ℝ) * E) = L ^ K₀ / (2 * (k : ℝ)) := by
  have hkr : (k : ℝ) ≠ 0 := by exact_mod_cast hk
  rw [hE, Real.rpow_neg hL.le]
  have hp : L ^ K₀ ≠ 0 := (Real.rpow_pos_of_pos hL K₀).ne'
  field_simp

theorem typeII_scale_parameter_envelope {L U V E Z K₀ Cz : ℝ} {k : ℤ}
    (hL : 1 ≤ L) (hU : 0 < U) (hV : 0 < V) (hZ : 0 ≤ Z) (hk : k ≠ 0)
    (hE : E = U * L ^ (-K₀)) (hUV : 1 ≤ U * V)
    (hZbound : Z / (U * V) ≤ L ^ Cz) :
    ‖typeIIScaleParameters L U V E Z k‖ ≤ L ^ typeIIScaleEnvelopeExponent K₀ Cz := by
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL
  have hk1 := typeII_integer_abs_ge_one hk
  have hUV0 : 0 < U * V := mul_pos hU hV
  have ha : |U / (2 * (k : ℝ) * E)| ≤ L ^ K₀ := by
    rw [typeII_scale_first_coefficient hL0 hU hk hE, abs_div,
      abs_of_pos (Real.rpow_pos_of_pos hL0 K₀), abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
    exact div_le_self (Real.rpow_nonneg hL0.le _) (by linarith)
  have hb : |Z / ((k : ℝ) * U * V)| ≤ L ^ Cz := by
    rw [abs_div, abs_of_nonneg hZ, abs_mul, abs_mul, abs_of_pos hU, abs_of_pos hV]
    have hd : U * V ≤ |(k : ℝ)| * U * V := by nlinarith
    exact (div_le_div_of_nonneg_left hZ hUV0 hd).trans hZbound
  have hc : |1 / (U * V)| ≤ 1 := by
    rw [abs_of_pos (one_div_pos.mpr hUV0)]
    exact div_le_self (by norm_num) hUV
  have hM0 : 0 ≤ typeIIScaleEnvelopeExponent K₀ Cz := by
    unfold typeIIScaleEnvelopeExponent
    exact (le_max_right Cz 0).trans ((le_max_right K₀ (max Cz 0)).trans (le_max_right 88 _))
  apply (pi_norm_le_iff_of_nonneg (Real.rpow_nonneg hL0.le _)).mpr
  intro i
  fin_cases i
  · change ‖L ^ 88‖ ≤ _
    rw [Real.norm_of_nonneg (pow_nonneg hL0.le _), ← Real.rpow_natCast]
    exact Real.rpow_le_rpow_of_exponent_le hL (le_max_left _ _)
  · change ‖U / (2 * (k : ℝ) * E)‖ ≤ _
    rw [Real.norm_eq_abs]
    exact ha.trans (Real.rpow_le_rpow_of_exponent_le hL
      ((le_max_left K₀ _).trans (le_max_right 88 _)))
  · change ‖Z / ((k : ℝ) * U * V)‖ ≤ _
    rw [Real.norm_eq_abs]
    exact hb.trans (Real.rpow_le_rpow_of_exponent_le hL
      ((le_max_left Cz 0).trans ((le_max_right K₀ _).trans (le_max_right 88 _))))
  · change ‖1 / (U * V)‖ ≤ _
    rw [Real.norm_eq_abs]
    exact hc.trans (Real.one_le_rpow hL hM0)

end Bounty
end

section

/- An arbitrary logarithmic saving for replacing the literal sharp candidate window. -/

open Finset Filter Real

namespace Bounty

theorem exists_candidate_sharp_smoothing_error_bound {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1) (A D : ℝ) :
    ∃ B : ℝ, 1 ≤ B ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (jStar : ℕ) (T : Finset ℕ) (ψ : ℕ → ℝ) (F : ℕ → ℕ → ℂ),
      arithmeticProductWindow 1 (exp L) ⊆ T →
      (∀ u ∈ T, 0 ≤ ψ u ∧ ψ u ≤ 1) →
      (∀ u ∈ T, u ∉ typeIIBoundaryWindow (exp L) (L^(-B)) →
        ψ u = if u ∈ arithmeticProductWindow 1 (exp L) then 1 else 0) →
      (∀ u ∈ typeIIBoundaryWindow (exp L) (L^(-B)),
        ∀ m ∈ (2*u+1).divisors, ‖F u m‖ ≤ L^A) →
      ‖(∑ u ∈ arithmeticProductWindow 1 (exp L),
          (candidateCoefficient c L q r jStar u : ℂ) *
            (∑ m ∈ (2*u+1).divisors, F u m)) -
        (∑ u ∈ T, (candidateCoefficient c L q r jStar u : ℂ) * (ψ u : ℂ) *
            (∑ m ∈ (2*u+1).divisors, F u m))‖ ≤ exp L * L^(-D) := by
  obtain ⟨B, hB, hbound⟩ := exists_candidate_boundary_divisor_test_bound hc hr hq0 hq1 A D
  refine ⟨B, hB, ?_⟩
  filter_upwards [hbound] with L hL
  intro jStar T ψ F hT hψ hmatch hF
  have herror := finite_divisor_sharp_smoothed_difference_norm_le T
    (typeIIBoundaryWindow (exp L) (L^(-B))) (arithmeticProductWindow 1 (exp L))
    (candidateCoefficient c L q r jStar) ψ F
    (candidate_coefficient_nonneg c L hq0 r jStar) hψ hmatch
  rw [inter_eq_right.mpr hT] at herror
  exact herror.trans (hL jStar F hF)

theorem exists_candidate_factorization_sharp_smoothing_error_bound {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1) (A D : ℝ) :
    ∃ B : ℝ, 1 ≤ B ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (jStar : ℕ) (T : Finset ℕ) (ψ : ℕ → ℝ) (α β : ℕ → ℂ),
      arithmeticProductWindow 1 (exp L) ⊆ T →
      (∀ u ∈ T, 0 ≤ ψ u ∧ ψ u ≤ 1) →
      (∀ u ∈ T, u ∉ typeIIBoundaryWindow (exp L) (L^(-B)) →
        ψ u = if u ∈ arithmeticProductWindow 1 (exp L) then 1 else 0) →
      (∀ m, ‖α m‖ ≤ L^A) → (∀ n, ‖β n‖ ≤ L^A) →
      ‖(∑ u ∈ arithmeticProductWindow 1 (exp L),
          (candidateCoefficient c L q r jStar u : ℂ) *
            (∑ m ∈ (2*u+1).divisors, α m * β ((2*u+1)/m))) -
        (∑ u ∈ T, (candidateCoefficient c L q r jStar u : ℂ) * (ψ u : ℂ) *
            (∑ m ∈ (2*u+1).divisors, α m * β ((2*u+1)/m)))‖ ≤ exp L * L^(-D) := by
  obtain ⟨B, hB, hbound⟩ := exists_candidate_sharp_smoothing_error_bound hc hr hq0 hq1 (2*A) D
  refine ⟨B, hB, ?_⟩
  filter_upwards [hbound, eventually_gt_atTop (0 : ℝ)] with L hL hL0
  intro jStar T ψ α β hT hψ hmatch hα hβ
  apply hL jStar T ψ (fun u m => α m * β ((2*u+1)/m)) hT hψ hmatch
  intro u hu m hm
  rw [norm_mul, show 2*A = A+A by ring, rpow_add hL0]
  exact mul_le_mul (hα m) (hβ _) (norm_nonneg _) (rpow_nonneg hL0.le _)

end Bounty
end

section

/- Removing a union of free-label divisibility exclusions costs the sum of reciprocal labels. -/

open Finset

namespace Bounty

section Endpoints

variable (Q T : Finset ℕ) (α β γ α' β' γ' : ℕ → ℂ)
  {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
  (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
  (hα' : ∀ m, ‖α' m‖ ≤ A) (hβ' : ∀ p, ‖β' p‖ ≤ B) (hγ' : ∀ r, ‖γ' r‖ ≤ C)
  (S : Finset ℤ) (δ : ℤ) (N : ℕ)
  (hT : ∀ d ∈ T, d ∈ Nat.factoredNumbers Q) (hδ : ∀ d ∈ T, (d : ℤ) ∣ δ)
  (hS : ∀ n ∈ S, 0 ≤ n ∧ n ≤ (N : ℤ))
  (hS' : ∀ n ∈ S, 0 ≤ n + δ ∧ n + δ ≤ (N : ℤ))

include hA hB hC hα hβ hγ hα' hβ' hγ' hT hδ hS hS'

theorem invariant_triple_endpoint_excluded_cross_bound :
    (∑ n ∈ S.filter (fun n => ∃ d ∈ T, (d : ℤ) ∣ n),
      ‖invariantTripleEndpoint Q α β γ n.natAbs‖ *
      ‖invariantTripleEndpoint Q α' β' γ' (n + δ).natAbs‖) ≤
      ((A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15) * ∑ d ∈ T, 1 / (d : ℝ) := by
  classical
  let f := fun n : ℤ => ‖invariantTripleEndpoint Q α β γ n.natAbs‖ *
    ‖invariantTripleEndpoint Q α' β' γ' (n + δ).natAbs‖
  have hpos : ∀ n, 0 ≤ f n := fun n => mul_nonneg (norm_nonneg _) (norm_nonneg _)
  have hpoint (n : ℤ) : (if ∃ d ∈ T, (d : ℤ) ∣ n then f n else 0) ≤
      ∑ d ∈ T, if (d : ℤ) ∣ n then f n else 0 := by
    by_cases hn : ∃ d ∈ T, (d : ℤ) ∣ n
    · obtain ⟨d, hd, hdn⟩ := hn
      rw [if_pos ⟨d, hd, hdn⟩]
      calc
        f n = (if (d : ℤ) ∣ n then f n else 0) := (if_pos hdn).symm
        _ ≤ _ := single_le_sum (s := T) (f := fun (e : ℕ) => if (e : ℤ) ∣ n then f n else 0)
          (a := d) (fun e _ => by split_ifs <;> positivity) hd
    · rw [if_neg hn]
      exact sum_nonneg (fun d _ => by split_ifs <;> positivity)
  change (∑ n ∈ S.filter (fun n => ∃ d ∈ T, (d : ℤ) ∣ n), f n) ≤ _
  rw [sum_filter]
  calc
    _ ≤ ∑ n ∈ S, ∑ d ∈ T, if (d : ℤ) ∣ n then f n else 0 :=
      sum_le_sum (fun n _ => hpoint n)
    _ = ∑ d ∈ T, ∑ n ∈ S.filter (fun n => (d : ℤ) ∣ n), f n := by
      rw [sum_comm]
      simp only [sum_filter]
    _ ≤ ∑ d ∈ T, (A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15 / d := by
      apply sum_le_sum
      intro d hd
      exact invariant_triple_endpoint_cross_multiples Q α β γ α' β' γ'
        hA hB hC hα hβ hγ hα' hβ' hγ' (S.filter (fun n => (d : ℤ) ∣ n)) δ d N
        (hT d hd) (hδ d hd) (fun n hn => (mem_filter.mp hn).2)
        (fun n hn => hS n (mem_filter.mp hn).1)
        (fun n hn => hS' n (mem_filter.mp hn).1)
    _ = _ := by
      rw [mul_sum]
      apply sum_congr rfl
      intro d _
      ring

theorem invariant_triple_endpoint_exclusion_error
    {Y K : ℝ} (hY : 0 < Y) (hK : 0 ≤ K) (hYlow : ∀ n ∈ S, Y ≤ (n : ℝ))
    (w : ℤ → ℂ) (hw : ∀ n ∈ S, ‖w n‖ ≤ K) :
    let f := fun n : ℤ => (w n / (n : ℂ)) *
      star (invariantTripleEndpoint Q α β γ n.natAbs) *
      invariantTripleEndpoint Q α' β' γ' (n + δ).natAbs
    ‖(∑ n ∈ S, f n) -
      ∑ n ∈ S.filter (fun n => ¬ ∃ d ∈ T, (d : ℤ) ∣ n), f n‖ ≤
      (K / Y) * ((A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15) *
        ∑ d ∈ T, 1 / (d : ℝ) := by
  classical
  dsimp only
  let bad := fun n : ℤ => ∃ d ∈ T, (d : ℤ) ∣ n
  let f := fun n : ℤ => (w n / (n : ℂ)) *
    star (invariantTripleEndpoint Q α β γ n.natAbs) *
    invariantTripleEndpoint Q α' β' γ' (n + δ).natAbs
  have heq : (∑ n ∈ S, f n) - ∑ n ∈ S.filter (fun n => ¬ bad n), f n =
      ∑ n ∈ S.filter bad, f n := by
    apply sub_eq_iff_eq_add.mpr
    exact (sum_filter_add_sum_filter_not S bad f).symm
  change ‖(∑ n ∈ S, f n) - ∑ n ∈ S.filter (fun n => ¬ bad n), f n‖ ≤ _
  rw [heq]
  apply (norm_sum_le _ _).trans
  calc
    _ ≤ ∑ n ∈ S.filter bad, (K / Y) *
        (‖invariantTripleEndpoint Q α β γ n.natAbs‖ *
          ‖invariantTripleEndpoint Q α' β' γ' (n + δ).natAbs‖) := by
      apply sum_le_sum
      intro n hn
      have hnS := (mem_filter.mp hn).1
      have hn0 : (0 : ℝ) < n := hY.trans_le (hYlow n hnS)
      have hnC : ‖(n : ℂ)‖ = (n : ℝ) := by
        rw [← Complex.ofReal_intCast, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hn0]
      dsimp only [f]
      rw [norm_mul, norm_mul, norm_div, norm_star, hnC, mul_assoc]
      exact mul_le_mul_of_nonneg_right (div_le_div₀ hK (hw n hnS) hY (hYlow n hnS))
        (mul_nonneg (norm_nonneg _) (norm_nonneg _))
    _ = (K / Y) * ∑ n ∈ S.filter bad,
        ‖invariantTripleEndpoint Q α β γ n.natAbs‖ *
          ‖invariantTripleEndpoint Q α' β' γ' (n + δ).natAbs‖ := (mul_sum ..).symm
    _ ≤ _ := by
      rw [mul_assoc]
      exact mul_le_mul_of_nonneg_left
        (invariant_triple_endpoint_excluded_cross_bound Q T α β γ α' β' γ'
          hA hB hC hα hβ hγ hα' hβ' hγ' S δ N hT hδ hS hS') (div_nonneg hK hY.le)

end Endpoints

end Bounty
end

section

/- Exact Bochner integral separation of the original root-weighted physical pairing. -/

open Finset MeasureTheory

namespace Bounty

noncomputable def physicalMellinPairing
    {G I : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (patterns : Finset I) (C : I → G → Finset (Fin J))
    (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (positions : Finset ℤ) (f g : ℤ → ℂ) (X Z v : ℝ) : ℂ :=
  inner ℂ (physicalEndpointVector P V J ell q positions (physicalMellinSource X Z v f))
    (physicalHilbertOperator V patterns C q (fun i => ζ i - v) k K positions
      (physicalEndpointVector P V J ell q positions g))

theorem physical_mellin_pairing_integrable
    {G I : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (hP : ∀ g p, p ∈ P g → 0 < p)
    (V : G → ℝ) (hV : ∀ g, 0 < V g) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (positions : Finset ℤ) (f g : ℤ → ℂ)
    (hsource : ∀ n ∈ positions, f n ≠ 0 → 0 < n)
    (X Z : ℝ) (hZ : Z ≠ 0) (ρ : ℝ → ℂ) (ν : ℝ → ℝ)
    (hρ : Integrable ρ) (hν : Continuous ν) :
    Integrable (fun v => ρ v * physicalMellinPairing V patterns C q ζ k K positions f g X Z (ν v)) := by
  classical
  have hi := (finite_mellin_sum_integrable univ ρ ν hρ hν
    (physicalMellinAtomCoefficient V patterns C q ζ k K positions f g)
    (physicalMellinAtomArgument Z)).const_mul ((X : ℂ) * (physicalStateMass V J ell : ℂ))
  apply hi.congr
  exact Filter.Eventually.of_forall (fun v => by
    dsimp only [physicalMellinPairing]
    rw [physical_mellin_pairing_atoms hP V hV patterns C hq ζ k K
      positions f g hsource X Z (ν v) hZ]
    ring)

theorem physical_mellin_root_eq_integral
    {G I : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (hP : ∀ g p, p ∈ P g → 0 < p)
    (V : G → ℝ) (hV : ∀ g, 0 < V g) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (positions : Finset ℤ) (f g : ℤ → ℂ)
    (hsource : ∀ n ∈ positions, f n ≠ 0 → 0 < n)
    (X Z : ℝ) (hX : X ≠ 0) (hZ : 0 < Z)
    (ρ : ℝ → ℂ) (ν : ℝ → ℝ) (hρ : Integrable ρ) (hν : Continuous ν)
    (Ψ : ℝ → ℂ)
    (hΨ : ∀ t : ℝ, 0 < t → Ψ t = ∫ v : ℝ, ρ v * physicalMellinPhase (ν v) t) :
    physicalMellinRootCorrelation V patterns C q ζ k K positions f g Ψ Z =
      (X : ℂ)⁻¹ * ∫ v : ℝ, ρ v * physicalMellinPairing V patterns C q ζ k K positions f g X Z (ν v) := by
  classical
  let c := physicalMellinAtomCoefficient V patterns C q ζ k K positions f g
  let t := fun a : PhysicalMellinAtom P J ell patterns C positions => physicalMellinAtomArgument Z a
  have he := finite_mellin_sum_representation univ ρ ν hρ hν c t Ψ (by
    intro a _ ha
    apply hΨ
    have hf : f a.1.val.1 ≠ 0 := by
      intro hf
      exact ha (physical_mellin_atom_coefficient_zero V patterns C q ζ k K positions f g a hf)
    exact physical_mellin_atom_argument_pos hZ hP a
      (hsource _ ((mem_physical_cutoff P J ell positions a.1.val).mp a.1.property) hf))
  have hi : (∫ v : ℝ, ρ v * physicalMellinPairing V patterns C q ζ k K positions f g X Z (ν v)) =
      (X : ℂ) * ((physicalStateMass V J ell : ℂ) *
        ∫ v : ℝ, ρ v * ∑ a, c a * physicalMellinPhase (ν v) (t a)) := by
    calc
      _ = ∫ v : ℝ, (X : ℂ) * ((physicalStateMass V J ell : ℂ) *
          (ρ v * ∑ a, c a * physicalMellinPhase (ν v) (t a))) := by
        apply integral_congr_ae
        exact Filter.Eventually.of_forall (fun v => by
          dsimp only [physicalMellinPairing]
          rw [physical_mellin_pairing_atoms hP V hV patterns C hq ζ k K
            positions f g hsource X Z (ν v) (ne_of_gt hZ)]
          dsimp only [c, t]
          ring)
      _ = _ := by rw [integral_const_mul, integral_const_mul]
  rw [physical_mellin_root_as_atoms]
  change (physicalStateMass V J ell : ℂ) * (∑ a, c a * Ψ (t a)) = _
  rw [he, hi]
  have hXc : (X : ℂ) ≠ 0 := by exact_mod_cast hX
  rw [inv_mul_cancel_left₀ hXc]

end Bounty
end

section

/- Smoothing precision is chosen before the Fourier truncation precision. -/

open Filter MeasureTheory

namespace Bounty

theorem typeII_window_fourier_polynomial_cost {B : ℝ} (hB : 0 ≤ B) :
    ∃ H : ℝ, 0 < H ∧ ∀ᶠ L : ℝ in atTop,
      (∫ ξ : ℝ, ‖typeIIWindowFourier (L ^ B) ξ‖) ≤ L ^ H := by
  obtain ⟨d, C, hC, hb⟩ := typeII_window_fourier_l1_polynomial
  refine ⟨B * d + 1, by positivity, ?_⟩
  filter_upwards [eventually_ge_atTop (max 1 (C * 2 ^ d))] with L hL
  have hL1 : 1 ≤ L := (le_max_left _ _).trans hL
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL1
  have hCL : C * 2 ^ d ≤ L := (le_max_right _ _).trans hL
  have hp : ‖L ^ B‖ ≤ L ^ B := by rw [Real.norm_eq_abs, abs_of_pos (Real.rpow_pos_of_pos hL0 B)]
  have hw : (1 + |L ^ B|) ^ d ≤ 2 ^ d * L ^ (B * d) := by
    simpa only [Real.norm_eq_abs] using parameter_weight_le_power hL1 hB hp d
  calc
    _ ≤ C * (1 + |L ^ B|) ^ d := hb _
    _ ≤ C * (2 ^ d * L ^ (B * d)) := mul_le_mul_of_nonneg_left hw hC
    _ = (C * 2 ^ d) * L ^ (B * d) := by ring
    _ ≤ L * L ^ (B * d) := mul_le_mul_of_nonneg_right hCL (Real.rpow_nonneg hL0.le _)
    _ = L ^ (B * d + 1) := by rw [Real.rpow_add hL0, Real.rpow_one]; ring

theorem typeII_window_smoothing_power_cutoff {B D : ℝ} (hB : 0 ≤ B) (hD : 0 ≤ D) :
    ∃ F : ℝ, 0 < F ∧ ∀ᶠ L : ℝ in atTop, ∀ s : ℝ,
      ‖(typeIIWindowSmooth (L ^ (-B)) (Real.exp s) : ℂ) -
        ∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ L ^ F}, typeIIWindowFourierIntegrand (L ^ B) s ξ‖ ≤
          L ^ (-D) := by
  obtain ⟨d, C, hC, hb⟩ := typeII_window_fourier_truncation_polynomial 1
  let F : ℝ := B * d + D + 1
  refine ⟨F, by dsimp [F]; positivity, ?_⟩
  filter_upwards [eventually_ge_atTop (max 1 (C * 2 ^ d))] with L hL
  have hL1 : 1 ≤ L := (le_max_left _ _).trans hL
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL1
  have hCL : C * 2 ^ d ≤ L := (le_max_right _ _).trans hL
  have hp : ‖L ^ B‖ ≤ L ^ B := by rw [Real.norm_eq_abs, abs_of_pos (Real.rpow_pos_of_pos hL0 B)]
  have hw : (1 + |L ^ B|) ^ d ≤ 2 ^ d * L ^ (B * d) := by
    simpa only [Real.norm_eq_abs] using parameter_weight_le_power hL1 hB hp d
  have hid : (L ^ (-B))⁻¹ = L ^ B := by rw [Real.rpow_neg hL0.le, inv_inv]
  have hδ : 0 < L ^ (-B) := Real.rpow_pos_of_pos hL0 _
  intro s
  have heq := typeII_window_log_cutoff_eq_smooth hδ s
  rw [hid] at heq
  rw [← heq]
  have hpower : 0 ≤ (L ^ F) ^ (-(1 : ℝ)) := Real.rpow_nonneg (Real.rpow_nonneg hL0.le _) _
  calc
    _ ≤ C * (1 + |L ^ B|) ^ d * (L ^ F) ^ (-(1 : ℝ)) := by
      simpa only [Nat.cast_one] using hb (L ^ B) (L ^ F) (Real.rpow_pos_of_pos hL0 F) s
    _ ≤ C * (2 ^ d * L ^ (B * d)) * (L ^ F) ^ (-(1 : ℝ)) :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hw hC.le) hpower
    _ = (C * 2 ^ d) * (L ^ (B * d) * (L ^ F) ^ (-(1 : ℝ))) := by ring
    _ ≤ L * (L ^ (B * d) * (L ^ F) ^ (-(1 : ℝ))) :=
      mul_le_mul_of_nonneg_right hCL (mul_nonneg (Real.rpow_nonneg hL0.le _) hpower)
    _ = L ^ (-D) := by
      rw [← Real.rpow_mul hL0.le, mul_neg_one, ← Real.rpow_add hL0]
      conv_lhs => lhs; rw [← Real.rpow_one L]
      rw [← Real.rpow_add hL0]
      congr 1
      dsimp [F]
      ring

theorem typeII_window_mellin_power_cutoff {B D : ℝ} (hB : 0 ≤ B) (hD : 0 ≤ D) :
    ∃ F : ℝ, 0 < F ∧ ∀ᶠ L : ℝ in atTop, ∀ e h x : ℝ, 0 < e → 0 < h → 0 < x →
      ‖(typeIIWindowSmooth (L ^ (-B)) (e * h / x) : ℂ) -
        ∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ L ^ F},
          ((x : ℂ) ^ (-((2 * Real.pi * ξ : ℝ) : ℂ) * Complex.I) *
            (e : ℂ) ^ (((2 * Real.pi * ξ : ℝ) : ℂ) * Complex.I) *
            (h : ℂ) ^ (((2 * Real.pi * ξ : ℝ) : ℂ) * Complex.I)) *
              typeIIWindowFourier (L ^ B) ξ‖ ≤ L ^ (-D) := by
  obtain ⟨F, hF, hf⟩ := typeII_window_smoothing_power_cutoff hB hD
  refine ⟨F, hF, ?_⟩
  filter_upwards [hf] with L hL
  intro e h x he hh hx
  have harg : 0 < e * h / x := div_pos (mul_pos he hh) hx
  have ht := hL (Real.log (e * h / x))
  rw [Real.exp_log harg] at ht
  convert ht using 2
  congr 1
  apply integral_congr_ae
  filter_upwards [] with ξ
  unfold typeIIWindowFourierIntegrand
  rw [typeII_window_mellin_phase he hh hx ξ]

theorem typeII_window_mellin_frequency_bound {F : ℝ} :
    ∀ᶠ L : ℝ in atTop, ∀ ξ : ℝ, ‖ξ‖ ≤ L ^ F →
      |2 * Real.pi * ξ| ≤ L ^ (F + 1) := by
  filter_upwards [eventually_ge_atTop (max 1 (2 * Real.pi))] with L hL
  have hL1 : 1 ≤ L := (le_max_left _ _).trans hL
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL1
  have hc : 2 * Real.pi ≤ L := (le_max_right _ _).trans hL
  intro ξ hξ
  rw [abs_mul, abs_of_pos (by positivity : 0 < 2 * Real.pi)]
  calc
    _ ≤ (2 * Real.pi) * L ^ F := mul_le_mul_of_nonneg_left (by simpa only [Real.norm_eq_abs] using hξ) (by positivity)
    _ ≤ L * L ^ F := mul_le_mul_of_nonneg_right hc (Real.rpow_nonneg hL0.le _)
    _ = L ^ (F + 1) := by rw [Real.rpow_add hL0, Real.rpow_one]; ring

end Bounty
end

section

/- Finite weighted Mellin sums and their exact integral linearity. -/

open Finset MeasureTheory

namespace Bounty

noncomputable def candidateWindowMellinKernel (L : ℝ) (u : ℕ) (ξ : ℝ) : ℂ :=
  (Real.exp L : ℂ) ^ (-((2*Real.pi*ξ : ℝ) : ℂ)*Complex.I) *
    (u : ℂ) ^ (((2*Real.pi*ξ : ℝ) : ℂ)*Complex.I)

theorem candidate_window_mellin_kernel_eq_exp (L : ℝ) {u : ℕ} (hu : 0 < u) (ξ : ℝ) :
    candidateWindowMellinKernel L u ξ =
      Complex.exp (((2*Real.pi*ξ*Real.log ((u:ℝ)/Real.exp L) : ℝ) : ℂ)*Complex.I) := by
  have h := typeII_window_mellin_phase (e := (u:ℝ)) (h := 1) (x := Real.exp L)
    (by exact_mod_cast hu) (by norm_num) (Real.exp_pos L) ξ
  simpa only [mul_one, Complex.ofReal_natCast, Complex.ofReal_one, Complex.one_cpow,
    candidateWindowMellinKernel] using h.symm

theorem candidate_window_mellin_kernel_integrable (L B : ℝ) {u : ℕ} (hu : 0 < u) :
    Integrable (fun ξ : ℝ => candidateWindowMellinKernel L u ξ * typeIIWindowFourier (L^B) ξ) := by
  apply (typeII_window_fourier_integrand_integrable (L^B)
    (Real.log ((u:ℝ)/Real.exp L))).congr
  apply Filter.Eventually.of_forall
  intro ξ
  dsimp only
  rw [candidate_window_mellin_kernel_eq_exp L hu]
  rfl

noncomputable def finiteWindowMellinIntegrand (L B : ℝ) (S : Finset ℕ)
    (a G : ℕ → ℂ) (ξ : ℝ) : ℂ :=
  ∑ u ∈ S, a u * (candidateWindowMellinKernel L u ξ * typeIIWindowFourier (L^B) ξ) * G u

theorem finite_window_mellin_integrand_separated (L B : ℝ) (S : Finset ℕ)
    (a G : ℕ → ℂ) (ξ : ℝ) :
    finiteWindowMellinIntegrand L B S a G ξ =
      (Real.exp L : ℂ)^(-((2*Real.pi*ξ : ℝ):ℂ)*Complex.I) * typeIIWindowFourier (L^B) ξ *
        ∑ u ∈ S, a u * (u:ℂ)^(((2*Real.pi*ξ : ℝ):ℂ)*Complex.I) * G u := by
  simp only [finiteWindowMellinIntegrand, candidateWindowMellinKernel, mul_sum]
  apply sum_congr rfl
  intro u hu
  ring

theorem finite_window_mellin_integrable (L B : ℝ) (S : Finset ℕ)
    (a G : ℕ → ℂ) (hS : ∀ u ∈ S, 0 < u) :
    Integrable (finiteWindowMellinIntegrand L B S a G) := by
  apply integrable_finsetSum
  intro u hu
  exact ((candidate_window_mellin_kernel_integrable L B (hS u hu)).const_mul (a u)).mul_const (G u)

theorem finite_window_mellin_setIntegral (L B : ℝ) (S : Finset ℕ)
    (a G : ℕ → ℂ) (hS : ∀ u ∈ S, 0 < u) (E : Set ℝ) :
    (∫ ξ in E, finiteWindowMellinIntegrand L B S a G ξ) =
      ∑ u ∈ S, a u * (∫ ξ in E,
        candidateWindowMellinKernel L u ξ * typeIIWindowFourier (L^B) ξ) * G u := by
  unfold finiteWindowMellinIntegrand
  rw [integral_finsetSum]
  · apply sum_congr rfl
    intro u hu
    rw [integral_mul_const, integral_const_mul]
  · intro u hu
    exact (((candidate_window_mellin_kernel_integrable L B (hS u hu)).const_mul (a u)).mul_const
      (G u)).integrableOn

theorem finite_window_mellin_error_le (L B : ℝ) (S : Finset ℕ)
    (a G ψ : ℕ → ℂ) (hS : ∀ u ∈ S, 0 < u) (E : Set ℝ) (ε : ℝ)
    (hε : ∀ u ∈ S, ‖ψ u - (∫ ξ in E,
      candidateWindowMellinKernel L u ξ * typeIIWindowFourier (L^B) ξ)‖ ≤ ε) :
    ‖(∑ u ∈ S, a u * ψ u * G u) -
      (∫ ξ in E, finiteWindowMellinIntegrand L B S a G ξ)‖ ≤
        ε * ∑ u ∈ S, ‖a u‖ * ‖G u‖ := by
  rw [finite_window_mellin_setIntegral L B S a G hS E, ← sum_sub_distrib]
  calc
    _ ≤ ∑ u ∈ S, ‖a u * ψ u * G u - a u *
        (∫ ξ in E, candidateWindowMellinKernel L u ξ * typeIIWindowFourier (L^B) ξ) * G u‖ :=
      norm_sum_le _ _
    _ ≤ ∑ u ∈ S, ε * (‖a u‖ * ‖G u‖) := by
      apply sum_le_sum
      intro u hu
      rw [show a u * ψ u * G u - a u *
          (∫ ξ in E, candidateWindowMellinKernel L u ξ * typeIIWindowFourier (L^B) ξ) * G u =
          a u * (ψ u - (∫ ξ in E,
            candidateWindowMellinKernel L u ξ * typeIIWindowFourier (L^B) ξ)) * G u by ring,
        norm_mul, norm_mul]
      have hh := mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left (hε u hu) (norm_nonneg (a u))) (norm_nonneg (G u))
      nlinarith only [hh]
    _ = _ := (mul_sum ..).symm

end Bounty
end

section

/- Only exact original performed births occupy the common event slots; shared active slots add no spurious births. -/

open Classical
namespace Bounty
section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ)
  (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)

theorem full_mixed_common_shared_slot_empty (k : K)
    (e : FullPermutationMixedEvent (J := J) n S B A Δ D (some (.inr k)) x)
    (g : Fin N) (j : Fin (M g)) (hj : j ∈ S k g) :
    fullMixedCommonEventBornData n S B A Δ D (some (.inr k)) x e ⟨g, j⟩ = none := by
  unfold fullMixedCommonEventBornData fullMixedCommonLocalEmbedding
  refine (optional_birth_extension_sigma
    (fullMixedCommonSlotEmbedding (J := J) S B (some (.inr k)))
    (fullMixedEventBornData n S B A Δ D (some (.inr k)) x e) g j).trans ?_
  apply optional_birth_extension_none
  intro h
  exact ((full_mixed_common_edge_slot_range (J := J) S B k g j).mp h) hj

theorem full_mixed_common_path_performed_iff (steps : List (Option (J ⊕ K)))
    (p : FullPermutationMixedPath n S B A Δ D steps x)
    (a : FullMixedCommonStepAddress M B steps) :
    fullMixedCommonPathBirthPerformed n S B A Δ D steps x p a ↔
      ∃ b, fullMixedCommonStepEmbedding S B steps b = a ∧
        fullMixedPathBirthPerformed n S B A Δ D steps x p b :=
  optional_birth_extension_performed_iff _ _ _

theorem full_mixed_common_path_performed_embed (steps : List (Option (J ⊕ K)))
    (p : FullPermutationMixedPath n S B A Δ D steps x)
    (a : FullMixedBirthAddress S B steps) :
    fullMixedCommonPathBirthPerformed n S B A Δ D steps x p
      (fullMixedCommonStepEmbedding S B steps a) ↔
      fullMixedPathBirthPerformed n S B A Δ D steps x p a := by
  unfold fullMixedCommonPathBirthPerformed fullMixedPathBirthPerformed
  rw [full_mixed_common_path_data_embed]

theorem full_mixed_common_path_label_present (steps : List (Option (J ⊕ K)))
    (p : FullPermutationMixedPath n S B A Δ D steps x)
    (a : FullMixedCommonStepAddress M B steps) :
    fullMixedCommonPathBirthPerformed n S B A Δ D steps x p a ↔
      (fullMixedCommonPathBirthLabel n S B A Δ D steps x p a).isSome = true := by
  simp only [fullMixedCommonPathBirthPerformed, fullMixedCommonPathBirthLabel, Option.isSome_map]

end Full
end Bounty
end

section

/- A coefficient that uses only designated big divisor pools is unchanged by a small prime. -/

open Finset

namespace Bounty

def selectedDivisorPools {G : Type*} [DecidableEq G]
    (P : G → Finset ℕ) (groups : Finset G) (n : ℕ) : G → Finset ℕ :=
  fun g => if g ∈ groups then physicalDivisorPool P g (n : ℤ) else ∅

theorem selected_divisor_pools_div_prime {G : Type*} [DecidableEq G]
    (P : G → Finset ℕ) (groups : Finset G)
    (hprime : ∀ g ∈ groups, ∀ p ∈ P g, p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (g : G) (hg : g ∉ groups) {p n : ℕ}
    (hp : p ∈ P g) (hpr : p.Prime) (hpn : p ∣ n) :
    selectedDivisorPools P groups (n / p) = selectedDivisorPools P groups n := by
  funext h
  unfold selectedDivisorPools
  by_cases hh : h ∈ groups
  · rw [if_pos hh, if_pos hh]
    have hne : g ≠ h := by intro he; subst h; exact hg hh
    apply physical_divisor_pool_div_other_prime P h (hprime h hh) hpr _ hpn
    intro hph
    exact disjoint_left.mp (hdis hne) hp hph
  · rw [if_neg hh, if_neg hh]

theorem selected_divisor_pool_coefficient_div_prime {G : Type*} [DecidableEq G]
    (P : G → Finset ℕ) (groups : Finset G)
    (hprime : ∀ g ∈ groups, ∀ p ∈ P g, p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (g : G) (hg : g ∉ groups) (b : (G → Finset ℕ) → ℂ) {p n : ℕ}
    (hp : p ∈ P g) (hpr : p.Prime) (hpn : p ∣ n) :
    b (selectedDivisorPools P groups (n / p)) = b (selectedDivisorPools P groups n) := by
  rw [selected_divisor_pools_div_prime P groups hprime hdis g hg hp hpr hpn]

end Bounty
end

section

/- Local additive Fourier energy reduces to the actual logarithmic convolution energy. -/

open Finset MeasureTheory

namespace Bounty

theorem local_additive_convolution_dyadic_support (S : Finset ℕ) (a : ℕ → ℂ)
    {Y H v : ℝ} (_hY : 0 < Y) (hH : 0 < H) (hsmall : H ≤ Y/8)
    (hS : ∀ n ∈ S, Y ≤ (n:ℝ) ∧ (n:ℝ) ≤ 2*Y)
    (hv : v ∉ Set.Icc (Y/2) (3*Y)) : localAdditiveConvolution S a H v = 0 := by
  unfold localAdditiveConvolution
  apply sum_eq_zero
  intro n hn
  have hz : localMellinKernelSchwartz (((n:ℝ)-v)/H) = 0 := by
    apply local_mellin_kernel_unit_support
    apply lt_of_not_ge
    intro hb
    rw [abs_div, abs_of_pos hH] at hb
    have ht := abs_le.mp ((div_le_one hH).mp hb)
    apply hv
    constructor <;> linarith [(hS n hn).1, (hS n hn).2, ht.1, ht.2]
  rw [hz, mul_zero]

theorem local_log_convolution_continuousOn (S : Finset ℕ) (a : ℕ → ℂ)
    (hS : ∀ n ∈ S, 0 < n) {Y : ℝ} (hY : 0 < Y) (H : ℝ) :
    ContinuousOn (localLogConvolution S a H) (Set.Icc (Y/2) (3*Y)) := by
  have hv : ∀ v ∈ Set.Icc (Y/2) (3*Y), v ≠ 0 := by
    intro v hv
    have : 0 < v := by linarith [hv.1]
    exact this.ne'
  apply continuousOn_finsetSum
  intro n hn
  apply continuousOn_const.mul
  apply localMellinKernelSchwartz.continuous.comp_continuousOn
  apply ContinuousOn.div_const
  apply continuousOn_id.mul
  apply ContinuousOn.log
  · exact continuousOn_const.div continuousOn_id hv
  · intro v hv'
    exact div_ne_zero (by exact_mod_cast (hS n hn).ne') (hv v hv')

theorem local_convolution_difference (S : Finset ℕ) (a : ℕ → ℂ) (H v : ℝ) :
    localAdditiveConvolution S a H v - localLogConvolution S a H v =
      ∑ n ∈ S, a n * (localMellinKernelSchwartz (((n:ℝ)-v)/H) -
        localMellinKernelSchwartz (v*Real.log ((n:ℝ)/v)/H)) := by
  simp only [localAdditiveConvolution, localLogConvolution, mul_sub, sum_sub_distrib]

theorem exists_local_fourier_log_energy_constant :
    ∃ C : ℝ, 0 < C ∧ ∀ (S : Finset ℕ) (a : ℕ → ℂ) (Y H : ℝ),
      0 < Y → 1 ≤ H → H ≤ Y/8 →
      (∀ n ∈ S, Y ≤ (n:ℝ) ∧ (n:ℝ) ≤ 2*Y) →
      (∫ β in {β : ℝ | |β| ≤ 1/H}, ‖localAdditivePolynomial S a β‖^2) ≤
        (8/H^2) * (∫ v in Set.Icc (Y/2) (3*Y), ‖localLogConvolution S a H v‖^2) +
          C * (H/Y)^2 * (∑ n ∈ S, ‖a n‖^2) := by
  obtain ⟨C, hC, herr⟩ := exists_actual_local_kernel_error_constant
  refine ⟨8*C, by positivity, ?_⟩
  intro S a Y H hY hH hsmall hS
  have hHp : 0 < H := lt_of_lt_of_le zero_lt_one hH
  have hSpos : ∀ n ∈ S, 0 < n := by
    intro n hn
    exact_mod_cast hY.trans_le (hS n hn).1
  have hla := local_additive_convolution_contDiff S a H
  have hll := local_log_convolution_continuousOn S a hSpos hY H
  have hlaInt : IntegrableOn (fun v => ‖localAdditiveConvolution S a H v‖^2) (Set.Icc (Y/2) (3*Y)) :=
    (hla.continuous.norm.pow 2).integrableOn_Icc
  have hllInt : IntegrableOn (fun v => ‖localLogConvolution S a H v‖^2) (Set.Icc (Y/2) (3*Y)) :=
    (hll.norm.pow 2).integrableOn_Icc
  have hdInt : IntegrableOn (fun v => ‖localAdditiveConvolution S a H v-localLogConvolution S a H v‖^2) (Set.Icc (Y/2) (3*Y)) :=
    ((hla.continuous.continuousOn.sub hll).norm.pow 2).integrableOn_Icc
  have htri (v : ℝ) : ‖localAdditiveConvolution S a H v‖^2 ≤
      2*‖localLogConvolution S a H v‖^2 +
        2*‖localAdditiveConvolution S a H v-localLogConvolution S a H v‖^2 := by
    have hn := norm_add_le (localLogConvolution S a H v)
      (localAdditiveConvolution S a H v-localLogConvolution S a H v)
    have he : localLogConvolution S a H v + (localAdditiveConvolution S a H v-localLogConvolution S a H v) = localAdditiveConvolution S a H v := by abel
    rw [he] at hn
    have hs := pow_le_pow_left₀ (norm_nonneg _) hn 2
    nlinarith [sq_nonneg (‖localLogConvolution S a H v‖-
      ‖localAdditiveConvolution S a H v-localLogConvolution S a H v‖)]
  have hti := integral_mono hlaInt ((hllInt.const_mul 2).add (hdInt.const_mul 2)) htri
  simp only [Pi.add_apply] at hti
  rw [integral_add (hllInt.const_mul 2) (hdInt.const_mul 2), integral_const_mul,
    integral_const_mul] at hti
  have he := herr S a hSpos Y H hY hH hsmall
  simp_rw [← local_convolution_difference S a H] at he
  have heq : (∫ v : ℝ, ‖localAdditiveConvolution S a H v‖^2) =
      ∫ v in Set.Icc (Y/2) (3*Y), ‖localAdditiveConvolution S a H v‖^2 := by
    symm
    apply setIntegral_eq_integral_of_forall_compl_eq_zero
    intro v hv
    rw [local_additive_convolution_dyadic_support S a hY hHp hsmall hS hv, norm_zero, zero_pow (by decide)]
  apply (local_fourier_energy_le_convolution S a hHp).trans
  rw [heq]
  calc
    _ ≤ (4/H^2) * (2*(∫ v in Set.Icc (Y/2) (3*Y), ‖localLogConvolution S a H v‖^2) +
        2*(∫ v in Set.Icc (Y/2) (3*Y), ‖localAdditiveConvolution S a H v-localLogConvolution S a H v‖^2)) :=
      mul_le_mul_of_nonneg_left hti (by positivity)
    _ = (8/H^2)*(∫ v in Set.Icc (Y/2) (3*Y), ‖localLogConvolution S a H v‖^2) +
        8*((∫ v in Set.Icc (Y/2) (3*Y), ‖localAdditiveConvolution S a H v-localLogConvolution S a H v‖^2)/H^2) := by ring
    _ ≤ (8/H^2)*(∫ v in Set.Icc (Y/2) (3*Y), ‖localLogConvolution S a H v‖^2) +
        8*(C*(H/Y)^2*(∑ n ∈ S, ‖a n‖^2)) := by linarith
    _ = _ := by ring

end Bounty
end

section

/- The square-error estimate for the actual ordered-list coefficient on big groups. -/

open Finset
open scoped Classical

namespace Bounty

theorem weighted_small_mark_extraction_error_energy
    {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {q v : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v)
    (V : G → ℝ) (t : G → ℕ) (T : ℕ)
    (hV : ∀ g, v ≤ V g) (ht : ∀ g, t g ≤ T)
    (hprime : ∀ g, ∀ p ∈ P g, p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (g : G) (k : ℕ) (htg : t g = k + 1) (big : Finset G) (hsmall : g ∉ big)
    (b : GroupMarkedLists (fun h : big => P h.val) (fun h : big => t h.val) → ℂ)
    {H : ℝ} (hH : 0 ≤ H) (hb : ∀ L, ‖b L‖ ≤ H)
    (Q : Finset ℕ) (hQ : P g ⊆ Q) (α β γ : ℕ → ℂ)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (positions : Finset ℕ) (N : ℕ) (hpos : ∀ n ∈ positions, 0 < n ∧ n ≤ N) :
    let c := fun n : ℕ => groupMarkedAverage
      (fun h : big => P h.val) (fun h : big => t h.val) (n : ℤ) b
    (∑ n ∈ positions,
      ‖weightedGroupMarkedSum P q V t (n : ℤ) (fun L => b (fun h : big => L h.val)) *
          invariantTripleEndpoint Q α β γ n -
        markedPrimePeel univ P q V t g k (fun m => c m * invariantTripleEndpoint Q α β γ m) n‖ ^ 2) ≤
      H ^ 2 * (((markedDivisorBound q v T) ^ Fintype.card G * (1 + 2 * Real.log N / v)) ^ 2 *
        (((A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15) *
          ∑ p ∈ P g, 1 / (p : ℝ) ^ 2)) := by
  classical
  dsimp only
  have hc (n : ℕ) :
      ‖groupMarkedAverage (fun h : big => P h.val) (fun h : big => t h.val) (n : ℤ) b‖ ≤ H :=
    group_marked_average_norm_le _ _ _ b hH (fun L => hb L.val)
  have hinv (n p : ℕ) (hp : p ∈ P g) (hpn : p ∣ n) :=
    group_marked_selected_average_div_prime P t big (fun h _ => hprime h)
      hdis g hsmall hp (hprime g p hp) hpn b
  have h := invariant_marked_coefficient_peel_error_energy univ P hq0 hq1 hv V t T
    (fun h _ => hV h) (fun h _ => ht h) (fun h _ => hprime h) hdis
    g (mem_univ g) k htg Q hQ α β γ hA hB hC hα hβ hγ positions N hpos
    (fun n => groupMarkedAverage (fun h : big => P h.val) (fun h : big => t h.val) (n : ℤ) b)
    (fun n _ => hc n) (fun n _ p hp hpn => hinv n p hp hpn)
  simpa only [weighted_group_marked_sum_selected_average, mul_assoc, card_univ] using h

end Bounty
end

section

/- Move both genuine big-active projections through the exact conditioned
pairing. The endpoint gates remain inside conditioning. This is an identity,
with no operator-norm premise. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_small_big_big_projected_pairing
    {S G : Type*} [Fintype S] [DecidableEq S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} [∀ p : PhysicalPrime Ps, NeZero p.2.val]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    {J ell : ℕ} {M : G → ℕ} {B : ℕ}
    (Vs : S → ℝ) (q : ℝ) (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (sourceGate targetGate : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P Z M B) → ℂ)
    (hsg : ∀ s (τ : FullActiveSlotPermutations M),
      sourceGate (s.1, fullActivePermutation τ s.2) = sourceGate s)
    (htg : ∀ s (τ : FullActiveSlotPermutations M),
      targetGate (s.1, fullActivePermutation τ s.2) = targetGate s)
    (T : (PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ) →
      PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ)
    (A : PhysicalSharedLists Ps J →
      (ProductBoundedOrderedState P Z M B → PhysicalResidues Ps → ℂ) →
      ProductBoundedOrderedState P Z M B → PhysicalResidues Ps → ℂ)
    (hpair : ∀ u f : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ,
      (∑ s, (physicalSmallBigMeasure Vs (productMemoryWeight μ ν) s : ℂ) *
        (starRingEnd ℂ) (u s) * T f s) =
      ∑ d, ∑ r, ∑ x, (productMemoryWeight μ ν x : ℂ) *
        (starRingEnd ℂ) (physicalSmallBigCondition Vs q (fun s => sourceGate s * u s) d x r) *
        A d (physicalSmallBigCondition Vs q (fun s => targetGate s * f s) d) x r)
    (u f : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ) :
    (∑ s, (physicalSmallBigMeasure Vs (productMemoryWeight μ ν) s : ℂ) *
      (starRingEnd ℂ) (u s) *
        physicalSmallBigBigAverage (T (physicalSmallBigBigAverage f)) s) =
    ∑ d, ∑ r, ∑ x, (productMemoryWeight μ ν x : ℂ) *
      (starRingEnd ℂ) (physicalSmallBigCondition Vs q (fun s => sourceGate s * u s) d x r) *
      fullActiveAverage (fun y => A d
        (fun z rs => fullActiveAverage
          (fun w => physicalSmallBigCondition Vs q (fun s => targetGate s * f s) d w rs) z)
        y r) x := by
  rw [physical_small_big_big_average_self_adjoint, hpair]
  have hs : (fun s => sourceGate s * physicalSmallBigBigAverage u s) =
      physicalSmallBigBigAverage (fun s => sourceGate s * u s) := by
    funext s
    exact physical_small_big_gate_big_average sourceGate u hsg s
  have ht : (fun s => targetGate s * physicalSmallBigBigAverage f s) =
      physicalSmallBigBigAverage (fun s => targetGate s * f s) := by
    funext s
    exact physical_small_big_gate_big_average targetGate f htg s
  rw [hs, ht]
  have htc : physicalSmallBigCondition Vs q
      (physicalSmallBigBigAverage (fun s => targetGate s * f s)) =
      fun d x r => fullActiveAverage
        (fun y => physicalSmallBigCondition Vs q (fun s => targetGate s * f s) d y r) x := by
    funext d x r
    exact physical_small_big_condition_big_average Vs q _ d x r
  rw [htc]
  simp_rw [physical_small_big_condition_big_average]
  apply sum_congr rfl
  intro d _
  apply sum_congr rfl
  intro r _
  exact (fullActiveAverage_self_adjoint μ ν
    (fun x => physicalSmallBigCondition Vs q (fun s => sourceGate s * u s) d x r)
    (fun y => A d
      (fun z rs => fullActiveAverage
        (fun w => physicalSmallBigCondition Vs q (fun s => targetGate s * f s) d w rs) z) y r)).symm

end Bounty
end

section

/- The independent small and big averages commute. No endpoint gate is
moved through the small average in this identity. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_small_big_averages_commute
    {S G : Type*} [Fintype S] [DecidableEq S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {P Z : G → Type*} {J ell : ℕ} {M : G → ℕ} {B : ℕ}
    (f : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ) :
    physicalSmallBigAverage (physicalSmallBigBigAverage f) =
      physicalSmallBigBigAverage (physicalSmallBigAverage f) := by
  funext s
  simp only [physicalSmallBigAverage, physicalSmallBigBigAverage, fullActiveAverage, mul_sum]
  rw [sum_comm]
  apply sum_congr rfl
  intro τ _
  apply sum_congr rfl
  intro σ _
  change _ * (_ * f ((s.1.1, physicalPermuteLabels σ s.1.2), fullActivePermutation τ s.2)) =
    _ * (_ * f ((s.1.1, physicalPermuteLabels σ s.1.2), fullActivePermutation τ s.2))
  ring

theorem physical_small_big_joint_average_eq_big_small
    {S G : Type*} [Fintype S] [DecidableEq S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {P Z : G → Type*} {J ell : ℕ} {M : G → ℕ} {B : ℕ}
    (f : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ) :
    physicalSmallBigJointAverage f = physicalSmallBigBigAverage (physicalSmallBigAverage f) :=
  physical_small_big_averages_commute f

end Bounty
end

section

/- Actual physical ghost bounds for signed birth-observable multipliers on
the genuine mixed measure. The fixed initial gate and both adjacent joint
slot averages remain in the operator. No local operator norm is assumed. -/

open Finset Classical
namespace Bounty

section Energy
variable {S G : Type*} [Fintype S] [Fintype G] [dG : DecidableEq G]
  {Ps : S → Finset ℕ} [∀ p : PhysicalPrime Ps, NeZero p.2.val]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] {J ell : ℕ}
  (Vs : S → ℝ) (hVs : ∀ s, 0 < Vs s) (μ : ∀ g, P g → ℝ)
  (q ρ : ℝ) (V : G → ℝ) (v vmax : ℝ) (M : G → ℕ) (B : ℕ)
  (hμ : ∀ g p, 0 < μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
  (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (hρ : 0 < ρ)
  (hV : ∀ g, 0 ≤ V g) (hVmax : ∀ g, V g ≤ vmax) (hv : 0 < v)
  (hD : q / ρ ^ 2 + ((1 - q) / ρ) / v ≤ 1)
  (hC : ∀ g, q / ρ ^ 2 + ((1 - q) * V g / ρ) / v ≤ 1)

include hVs hμ hmass hq0 hq1 hρ hV hVmax hv hD hC in
theorem physical_small_big_ghost_phase_energy_le_uniform
    (phase : ∀ s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B),
      CoupledGhostEvent M B s.2 → ℂ)
    (hphase : ∀ s e, ‖phase s e‖ ≤ 1)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (hF : ∀ s, ProductMemorySymmetric (fun x => F (s, x))) :
    physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (physicalSmallBigGhostAction (fun g => physicalGhostRetention (n g) q ρ)
        (fun g => physicalGhostTermination (n g) q ρ)
        (fun g => physicalGhostBirth (n g) q ρ (V g))
        (fun g => unrestrictedResidueWeight (μ g)) M B phase F) ≤
      physicalGhostUniformEnergyBound ρ vmax v ^ Fintype.card G *
        physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) F := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  apply physical_small_big_fiber_energy_le Vs hVs _ F _ _
  intro s
  apply finiteWeightedEnergy_le_of_envelope_domination
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (n := n g) (μ g)))
    (productMemoryWeight_nonneg μ (fun g => unrestrictedResidueWeight (n := n g) (μ g))
      (fun g p => (hμ g p).le) (fun g z => (hμ g z.1).le))
    (fun x => F (s,x)) _
    (coupledGhostCutoffOperator (fun g => physicalGhostRetention (n g) q ρ)
      (fun g z => |physicalGhostTermination (n g) q ρ z|)
      (fun g z => |physicalGhostBirth (n g) q ρ (V g) z|)
      (fun g => unrestrictedResidueWeight (μ g)) M B (fun _ _ => 1))
  · intro x
    exact (coupled_ghost_cutoff_norm_le_positive_re
      (fun g => physicalGhostRetention (n g) q ρ)
      (fun g => physicalGhostTermination (n g) q ρ)
      (fun g => physicalGhostBirth (n g) q ρ (V g))
      (fun g => unrestrictedResidueWeight (μ g))
      (by intro g z; unfold physicalGhostRetention; split_ifs
          · exact div_nonneg hq0 (sq_nonneg ρ)
          · exact zero_le_one)
      (fun g z => (hμ g z.1).le) M B (fun x e => phase (s,x) e)
      (fun x e => hphase (s,x) e) (fun x => F (s,x)) x).trans (Complex.re_le_norm _)
  · rw [coupled_ghost_cutoff_one_eq_coordinate_action]
    have h := physical_ghost_absolute_cutoff_product_energy_le n μ q ρ V v vmax M B
        hμ hmass hq0 hq1 hρ hV hVmax hv hD hC univ (complexNormEnvelope (fun x => F (s,x)))
        (complexNormEnvelope_memory_symmetric _ (hF s))
    simp only [physicalAbsoluteGhostCutoffProductOperator, physicalAbsoluteGhostProductOperator,
      physicalAbsoluteBoundedGhostOperator, card_univ] at h
    convert h using 1

include hVs hμ hmass hq0 hq1 hρ hV hVmax hv hD hC in
theorem physical_small_big_ghost_initial_birth_energy_le_uniform
    (initial : ∀ g, Finset (P g))
    (φ : PhysicalBareResidueState Ps J ell → (∀ g, Fin (M g) → P g) →
      (∀ g, FiniteOrderedTuple (UnrestrictedResidueParticle (n g))) → ℂ)
    (hφ : ∀ s active births, ‖φ s active births‖ ≤ 1)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (hF : ∀ s, ProductMemorySymmetric (fun x => F (s, x))) :
    physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (physicalSmallBigGhostAction (fun g => physicalGhostRetention (n g) q ρ)
        (fun g => physicalGhostTermination (n g) q ρ)
        (fun g => physicalGhostBirth (n g) q ρ (V g))
        (fun g => unrestrictedResidueWeight (μ g)) M B
        (physicalSmallBigGhostInitialBirthPhase (fun _ => Sigma.fst) initial M B φ) F) ≤
      physicalGhostUniformEnergyBound ρ vmax v ^ Fintype.card G *
        physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) F :=
  physical_small_big_ghost_phase_energy_le_uniform n Vs hVs μ q ρ V v vmax M B
    hμ hmass hq0 hq1 hρ hV hVmax hv hD hC _
    (physical_small_big_ghost_initial_birth_phase_norm_le _ initial M B φ hφ) F hF

variable [dS : DecidableEq S]

omit [∀ p : PhysicalPrime Ps, NeZero p.2.val] in
theorem physical_small_big_ghost_initial_birth_projected_memory_symmetric
    (initial : ∀ g, Finset (P g))
    (φ : PhysicalBareResidueState Ps J ell → (∀ g, Fin (M g) → P g) →
      (∀ g, FiniteOrderedTuple (UnrestrictedResidueParticle (n g))) → ℂ)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (hF : ∀ s, ProductMemorySymmetric (fun x => F (s, x))) :
    ∀ s, ProductMemorySymmetric (fun x => physicalSmallBigJointAverage
      (physicalSmallBigGhostAction (fun g => physicalGhostRetention (n g) q ρ)
        (fun g => physicalGhostTermination (n g) q ρ)
        (fun g => physicalGhostBirth (n g) q ρ (V g))
        (fun g => unrestrictedResidueWeight (μ g)) M B
        (physicalSmallBigGhostInitialBirthPhase (fun _ => Sigma.fst) initial M B φ)
        (physicalSmallBigJointAverage F)) (s, x)) := by
  apply physical_small_big_joint_average_memory_symmetric
  exact physical_small_big_ghost_initial_birth_memory_symmetric _ _ _ _ _ initial M B φ _
    (physical_small_big_joint_average_memory_symmetric F hF)

include hVs hμ hmass hq0 hq1 hρ hV hVmax hv hD hC in
theorem physical_small_big_ghost_initial_birth_projected_norm_le
    (initial : ∀ g, Finset (P g))
    (φ : PhysicalBareResidueState Ps J ell → (∀ g, Fin (M g) → P g) →
      (∀ g, FiniteOrderedTuple (UnrestrictedResidueParticle (n g))) → ℂ)
    (hφ : ∀ s active births, ‖φ s active births‖ ≤ 1)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (hF : ∀ s, ProductMemorySymmetric (fun x => F (s, x))) :
    cleanActiveNorm (physicalSmallBigMeasure Vs
      (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))))
      (physicalSmallBigJointAverage
        (physicalSmallBigGhostAction (fun g => physicalGhostRetention (n g) q ρ)
          (fun g => physicalGhostTermination (n g) q ρ)
          (fun g => physicalGhostBirth (n g) q ρ (V g))
          (fun g => unrestrictedResidueWeight (μ g)) M B
          (physicalSmallBigGhostInitialBirthPhase (fun _ => Sigma.fst) initial M B φ)
          (physicalSmallBigJointAverage F))) ≤
      Real.sqrt (physicalGhostUniformEnergyBound ρ vmax v ^ Fintype.card G) *
        cleanActiveNorm (physicalSmallBigMeasure Vs
          (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))) F := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  have hK : 0 ≤ physicalGhostUniformEnergyBound ρ vmax v ^ Fintype.card G :=
    pow_nonneg (Real.exp_pos _).le _
  have hp := physical_small_big_joint_average_energy_le
    (Ps := Ps) (J := J) (ell := ell) (M := M) (B := B) Vs hVs μ
    (fun g => unrestrictedResidueWeight (n := n g) (μ g)) (fun g p => (hμ g p).le)
    (fun g z => (hμ g z.1).le)
  have hi := physical_small_big_ghost_initial_birth_energy_le_uniform n Vs hVs μ q ρ V v vmax M B
    hμ hmass hq0 hq1 hρ hV hVmax hv hD hC initial φ hφ (physicalSmallBigJointAverage F)
    (physical_small_big_joint_average_memory_symmetric F hF)
  have he := (hp _).trans (hi.trans (mul_le_mul_of_nonneg_left (hp F) hK))
  have hn := physical_small_big_norm_le_of_energy Vs
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) 1
    (physicalGhostUniformEnergyBound ρ vmax v ^ Fintype.card G) zero_le_one hK F _
    (by simpa only [one_pow, one_mul] using he)
  simp only [one_mul] at hn
  convert hn using 1 <;> congr 2

end Energy
end Bounty
end

section

open MeasureTheory
open scoped FourierTransform

namespace Bounty

noncomputable def centeredLocalMellinPolynomial
    (S : Finset ℕ) (a : ℕ → ℂ) (Y t : ℝ) : ℂ :=
  Complex.exp (((-t*Real.log Y:ℝ):ℂ)*Complex.I) * localMellinPolynomial S a t

theorem centered_local_mellin_polynomial_continuous
    (S : Finset ℕ) (a : ℕ → ℂ) (Y : ℝ) :
    Continuous (centeredLocalMellinPolynomial S a Y) := by
  have hp := local_mellin_polynomial_continuous S a
  unfold centeredLocalMellinPolynomial
  fun_prop

theorem centered_local_mellin_polynomial_norm
    (S : Finset ℕ) (a : ℕ → ℂ) (Y t : ℝ) :
    ‖centeredLocalMellinPolynomial S a Y t‖ = ‖localMellinPolynomial S a t‖ := by
  unfold centeredLocalMellinPolynomial
  rw [norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]

theorem local_log_convolution_mellin_coordinates
    (S : Finset ℕ) (a : ℕ → ℂ) (hS : ∀ n ∈ S, 0 < n)
    {h Y : ℝ} (hh : 0 < h) (hY : 0 < Y) (u : ℝ) :
    localLogConvolution S a (h*Y) (Y*Real.exp u) =
      ((h/(2*Real.pi):ℝ):ℂ) *
        localMellinTransform h (centeredLocalMellinPolynomial S a Y) u := by
  have hv : 0 < Y*Real.exp u := mul_pos hY (Real.exp_pos u)
  rw [local_mellin_representation S a hS hv (mul_pos hh hY)]
  have hc : h*Y/(2*Real.pi*(Y*Real.exp u)) = (h/(2*Real.pi))*Real.exp (-u) := by
    rw [Real.exp_neg]
    field_simp
  rw [hc]
  unfold localMellinTransform
  rw [Complex.ofReal_mul, mul_assoc]
  congr 1
  congr 1
  apply integral_congr_ae
  filter_upwards [] with t
  have hfreq : (h/(2*Real.pi)*Real.exp (-u))*t = Real.exp (-u)*(h*t)/(2*Real.pi) := by ring
  rw [hfreq, Real.log_mul hY.ne' (Real.exp_ne_zero u), Real.log_exp]
  unfold centeredLocalMellinPolynomial
  have hexp : Complex.exp (((-t*(Real.log Y+u):ℝ):ℂ)*Complex.I) =
      Complex.exp (((-t*u:ℝ):ℂ)*Complex.I) *
        Complex.exp (((-t*Real.log Y:ℝ):ℂ)*Complex.I) := by
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  rw [hexp]
  ring

theorem scaled_exponential_log_dyad_image {Y : ℝ} (hY : 0 < Y) :
    (fun u : ℝ => Y*Real.exp u) '' Set.Icc (Real.log (1/2:ℝ)) (Real.log 3) =
      Set.Icc (Y/2) (3*Y) := by
  have hc : Continuous (fun u : ℝ => Y*Real.exp u) := by fun_prop
  have hm : StrictMono (fun u : ℝ => Y*Real.exp u) :=
    fun a b hab => mul_lt_mul_of_pos_left (Real.exp_strictMono hab) hY
  rw [hc.image_Icc_of_strictMono hm, Real.exp_log (by norm_num : (0:ℝ)<1/2),
    Real.exp_log (by norm_num : (0:ℝ)<3)]
  congr 1 <;> ring

theorem logarithmic_dyad_integral_substitution {Y : ℝ} (hY : 0 < Y) (F : ℝ → ℝ) :
    (∫ v in Set.Icc (Y/2) (3*Y), F v) =
      ∫ u in Set.Icc (Real.log (1/2:ℝ)) (Real.log 3), Y*Real.exp u * F (Y*Real.exp u) := by
  rw [← scaled_exponential_log_dyad_image hY]
  have hi : Set.InjOn (fun u : ℝ => Y*Real.exp u)
      (Set.Icc (Real.log (1/2:ℝ)) (Real.log 3)) := by
    intro a ha b hb hab
    apply Real.exp_injective
    exact (mul_left_cancel₀ hY.ne') hab
  rw [integral_image_eq_integral_abs_deriv_smul measurableSet_Icc
    (fun u hu => ((Real.hasDerivAt_exp u).const_mul Y).hasDerivWithinAt) hi]
  apply integral_congr_ae
  filter_upwards [] with u
  rw [abs_of_pos (mul_pos hY (Real.exp_pos u)), smul_eq_mul]

end Bounty
end

section

open MeasureTheory
open scoped ComplexConjugate

namespace Bounty

theorem exists_local_mellin_transform_energy_constant {j : ℕ} (hj : 2 ≤ j) :
    ∃ C : ℝ, 0 < C ∧ ∀ h : ℝ, 0 < h → ∀ g : ℝ → ℂ, Continuous g →
      (∃ M : ℝ, ∀ t, ‖g t‖ ≤ M) →
      Integrable (fun u : ℝ => ‖(typeIISmoothRho 2 u : ℂ) * localMellinTransform h g u‖^2) ∧
      (∫ u in Set.Icc (Real.log (1/2:ℝ)) (Real.log 3), ‖localMellinTransform h g u‖^2) ≤
        C * ∫ t : ℝ, (1+|h*t|)^(-(j:ℝ)) * ‖g t‖^2 := by
  obtain ⟨M₀, M₁, M₂, hM₀, hM₁, hM₂, hderiv⟩ :=
    local_mellin_amplitude_uniform_derivatives (4*j)
  obtain ⟨C₀, hC₀, hCi, hFourier⟩ := local_mellin_amplitude_product_fourier_bound (4*j)
  have hCbase : 0 ≤ C₀*(2*Real.pi^2)*(2:ℝ)^j := by positivity
  refine ⟨C₀*(2*Real.pi^2)*(2:ℝ)^j+1, by linarith, ?_⟩
  intro h hh g hg hgBound
  obtain ⟨M, hgM⟩ := hgBound
  let f : ℝ → ℂ := fun t => (mellinDecayWeight j h t : ℂ) * g t
  have hfc : Continuous f :=
    (Complex.continuous_ofReal.comp (mellin_decay_weight_continuous j h)).mul hg
  have hfi : Integrable f := mellin_weighted_bounded_integrable hj hh hg hgM
  have hf2 : Integrable (fun t => ‖f t‖^2) :=
    mellin_weighted_bounded_square_integrable hj hh hg hgM
  have hab (v u : ℝ) : ‖localMellinAmplitude (4*j) v u‖ ≤ M₀ := (hderiv v u).1
  have hsupp := local_mellin_amplitude_zero (4*j)
  have hloc := oscillatory_schur_energy_integrable
    (local_mellin_amplitude_joint_continuous (4*j)) hM₀ hab hsupp hfc hfi h
  have hbound := oscillatory_schur_energy_bound
    (local_mellin_amplitude_joint_continuous (4*j)) hM₀ hab hsupp hC₀ hFourier hfc hfi hf2 h
  have heq (u : ℝ) : (∫ t : ℝ, Complex.exp (((-t*u:ℝ):ℂ)*Complex.I) *
      localMellinAmplitude (4*j) (h*t) u * f t) =
      (typeIISmoothRho 2 u : ℂ) * localMellinTransform h g u :=
    (local_mellin_transform_weighted_representation j h g u).symm
  simp_rw [heq] at hloc hbound
  refine ⟨hloc, ?_⟩
  have hsame : (∫ u in Set.Icc (Real.log (1/2:ℝ)) (Real.log 3), ‖localMellinTransform h g u‖^2) =
      ∫ u in Set.Icc (Real.log (1/2:ℝ)) (Real.log 3),
        ‖(typeIISmoothRho 2 u : ℂ) * localMellinTransform h g u‖^2 := by
    apply setIntegral_congr_fun measurableSet_Icc
    intro u hu
    dsimp only
    rw [local_mellin_rho_one_on_log_dyad hu, Complex.ofReal_one, one_mul]
  rw [hsame]
  calc
    _ ≤ ∫ u : ℝ, ‖(typeIISmoothRho 2 u : ℂ) * localMellinTransform h g u‖^2 :=
      setIntegral_le_integral hloc (Filter.Eventually.of_forall (fun u => sq_nonneg _))
    _ ≤ C₀*(2*Real.pi^2) * ∫ t : ℝ, ‖f t‖^2 := hbound
    _ ≤ C₀*(2*Real.pi^2) * ((2:ℝ)^j *
        ∫ t : ℝ, (1+|h*t|)^(-(j:ℝ))*‖g t‖^2) :=
      mul_le_mul_of_nonneg_left (mellin_weighted_square_energy_bound hj hh hg hgM) (by positivity)
    _ ≤ _ := by
      have hE : 0 ≤ ∫ t : ℝ, (1+|h*t|)^(-(j:ℝ))*‖g t‖^2 :=
        integral_nonneg (fun t => by positivity)
      nlinarith

end Bounty
end

