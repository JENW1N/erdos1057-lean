              (fun a => ((a.2.val : ℝ) * b a)⁻¹) B pattern d.val := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  let : ∀ pattern : Fin (n + 1) → patterns,
    Fintype (PhysicalSelectedData P ell (fun j => C (pattern j).val)) :=
    fun pattern => physicalSelectedDataFintype (fun j => C (pattern j).val)
  rw [physical_root_residue_model_capped_normalization V patterns C q ζ k K hP hdis hk b hb hb0 B hB]
  congr 1
  let F := fun (L : PhysicalMarkLists P J ell)
      (p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) =>
    physicalMemoryWalkScalar V patterns C ζ K (finitePathLabels p) (finitePathMarks L p) (n + 1) *
