variable {J K G : Type*} {P : G → Type*}
  (n : ∀ g, P g → ℕ) (Δ D : K → G → ℤ) (t : G → ℕ) (B : ℕ)

def MixedMemoryEvent : (J ⊕ K) →
    ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → Type _
  | .inl _, s => CoupledGhostEvent t B s
  | .inr k, s => UnrestrictedJointEvent n (Δ k) (D k) t B s

noncomputable abbrev mixedMemoryEventFintype [Fintype G] [∀ g, Fintype (P g)]
    [∀ g p, NeZero (n g p)] (k : J ⊕ K)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) :
    Fintype (MixedMemoryEvent n Δ D t B k s) := by
  cases k <;> dsimp [MixedMemoryEvent] <;> infer_instance

noncomputable def mixedMemoryEventTarget (k : J ⊕ K)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) :
    MixedMemoryEvent n Δ D t B k s →
      ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B :=
  match k with
  | .inl _ => coupledGhostJointEventTarget t B s
  | .inr k => unrestrictedJointEventTarget n (Δ k) (D k) t B s

noncomputable def mixedMemoryEventWeight [Fintype G]
    (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ) (k : J ⊕ K)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) :
    MixedMemoryEvent n Δ D t B k s → ℝ :=
  match k with
  | .inl j => coupledGhostJointEventWeight
      (fun g => physicalGhostRetention (n g) (q j) ρ)
      (fun g => physicalGhostTermination (n g) (q j) ρ)
      (fun g => physicalGhostBirth (n g) (q j) ρ (V g))
      (fun g => unrestrictedResidueWeight (μ g)) t B s
  | .inr k => unrestrictedJointCutoffEventWeight n (Δ k) (D k) μ ρ V t B s

noncomputable def mixedMemoryPositiveOperator [Fintype G] [DecidableEq G]
    [∀ g, Fintype (P g)] [∀ g p, NeZero (n g p)]
    (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ) (k : J ⊕ K) :=
  match k with
  | .inl j => physicalAbsoluteGhostCutoffProductOperator n μ (q j) ρ V t B univ
  | .inr k => unrestrictedCutoffProductOperator n (Δ k) (D k) μ ρ V t B (fun _ _ _ _ _ _ => 1) univ

theorem mixed_memory_absolute_actions_eq [Fintype G] [DecidableEq G]
    [∀ g, Fintype (P g)] [∀ g p, NeZero (n g p)]
    (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hq : ∀ j, 0 ≤ q j) (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ V g) :
    let _ : ∀ (k : J ⊕ K) s, Fintype (MixedMemoryEvent n Δ D t B k s) :=
      mixedMemoryEventFintype n Δ D t B
    finiteLocalEventAction (MixedMemoryEvent n Δ D t B)
      (fun k s e => |mixedMemoryEventWeight n Δ D t B μ q ρ V k s e|)
      (mixedMemoryEventTarget n Δ D t B) = mixedMemoryPositiveOperator n Δ D t B μ q ρ V := by
  let _ : ∀ (k : J ⊕ K) s, Fintype (MixedMemoryEvent n Δ D t B k s) :=
    mixedMemoryEventFintype n Δ D t B
  funext k f s
  cases k with
  | inl j =>
    dsimp only [finiteLocalEventAction, mixedMemoryEventWeight, mixedMemoryEventTarget,
      mixedMemoryPositiveOperator]
    refine Eq.trans ?_ (physical_absolute_joint_ghost_action_eq n μ (q j) ρ V t B (hq j) hμ f s)
    apply sum_congr
    · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
    · intro e _
      rfl
  | inr k =>
    dsimp only [finiteLocalEventAction, mixedMemoryEventWeight, mixedMemoryEventTarget,
      mixedMemoryPositiveOperator]
    have h := unrestricted_coupled_cutoff_eq_joint_event_sum n (Δ k) (D k) μ ρ V t B
      (fun _ _ => 1) f s
    simp only [mul_one] at h
    refine Eq.trans ?_ (Eq.trans h.symm
      (congrFun (unrestricted_coupled_positive_cutoff_eq_product n (Δ k) (D k) μ ρ V t B f) s))
    apply sum_congr
    · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
    · intro e _
      rw [abs_of_nonneg (unrestrictedJointCutoffEventWeight_nonneg n (Δ k) (D k)
        μ V hρ hV hμ t B s e)]

end
