/- The explicit retained-cell cost for the original candidate probe subsets. -/

open Finset Filter
open scoped Classical
namespace Bounty

theorem eventually_candidate_retained_cell_cost {c : ℝ} (hc : 0 < c)
    (J : ℕ) (B C R : ℝ) (hB : 0 ≤ B) :
    ∀ᶠ L : ℝ in atTop, ∀ (S : Finset ℕ), S ⊆ candidatePIndices c L →
      let P := fun g : S => candidatePBand (c*L) g.val
      ∀ (ell : ℕ) (probes : S → Finset (Fin J)) (r : Finset S)
        (A : Finset (RepeatedBigFlatIndex S J ell)),
        A ⊆ r.sigma (repeatedBigPrimeProbeSlots probes) → A.Nonempty →
      ∀ (V : A → ℝ) (Q : ℕ), (Q : ℝ) ≤ L^R →
        (∑ d ∈ primeProductRetainedCells (fun i : A => P i.val.1) V
          (L^(-B)) (L^(-C)), ∑ _χ : BoundedPrimitiveCharacter Q,
          ‖((1 / finiteCellMass (finiteProductWeight
            (physicalLabelLaw (P := fun i : A => P i.val.1) V))
            (fun x => upperLogCell (L^(-B)) (Real.log (∏ i, (x i).val : ℕ))) d : ℝ) : ℂ)‖) ≤
          L^(B+C+2*R+2) := by
  filter_upwards [eventually_candidate_subset_product_range hc (show (0 : ℝ) < 1 by norm_num) J,
    eventually_ge_atTop (3 : ℝ)] with L hrange hL
  intro S hS P ell probes r A hA hne V Q hQ
  apply prime_retained_cell_polynomial_cost _ V hL hB hQ
  intro x
  obtain ⟨hlo, hhi⟩ := hrange S hS ell probes r A hA hne x
  have hL0 : 0 ≤ L := by linarith
  have hprod : (1 : ℝ) ≤ (∏ i, (x i).val : ℕ) :=
    (Real.one_le_exp (Real.rpow_nonneg hL0 _)).trans hlo
  exact ⟨Real.log_nonneg hprod,
    (Real.log_le_iff_le_exp (zero_lt_one.trans_le hprod)).mpr (by simpa only [one_mul] using hhi)⟩

