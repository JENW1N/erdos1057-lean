/- Restricting the reconstructed path recovers its literal selected mark arrays. -/

namespace Bounty

theorem physical_group_selected_inverse_big_marks
    {G : Type*} {P : G → Finset ℕ} {J ell n : ℕ} (small : G → Prop)
    (C : Fin n → G → Finset (Fin J))
    (ds : PhysicalGroupSelectedData (fun g : {g // small g} => P g.val) ell (fun j g => C j g.val))
    (db : PhysicalGroupSelectedData (fun g : {g // ¬small g} => P g.val) ell (fun j g => C j g.val)) :
    (fun j (g : {g // ¬small g}) =>
      ((physicalGroupSelectedSplit small C).symm (ds, db)).2.1 j g.val) = db.2.1 := by
  have h := congrArg (fun d => d.2.2.1)
    ((physicalGroupSelectedSplit small C).apply_symm_apply (ds, db))
  exact h

theorem physical_root_small_plan_big_marks
    {I : Type} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    (groups : Finset (Fin N)) (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
    (hC : ∀ i : patterns, ∀ g : ↥groupsᶜ, C i.val g.val = ∅)
    (p : PhysicalRootSmallPlan (P := P) (J := J) (ell := ell) (n := n) groups patterns)
    (db : PhysicalRootSmallPlanBigData groups patterns C hC p) :
    (fun j (g : {g // g ∉ groupsᶜ}) =>
      (physicalPathSelectedEquiv patterns C (physicalRootSmallPlanPath groups patterns C hC p db)).2.2.1
        j g.val) = db.2.1 := by
  rw [physical_root_small_plan_selected_coordinates]
  exact physical_group_selected_inverse_big_marks _ _ _ _

end Bounty
