/-- Full-slot symmetrization and the physical active product weight instantiate
all projection hypotheses. The only analytic input is the compressed ideal block. -/
theorem clean_hybrid_symmetric_pattern_norm_le {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vb : G → ℝ) (hV : ∀ g, 0 ≤ Vb g) (b : ∀ g, Pb g → ℝ) (hb : ∀ g q, 0 ≤ b g q)
    (C : I → G → Finset (Fin J)) (ζ θ : ℝ) (k : ℤ) (p : FixedOrderedMemoryLabels Pb N)
    [∀ q : PhysicalPrime Ps, NeZero q.2.val] [∀ g j, NeZero (p g j).val]
    (K : ∀ i, RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb (C i) → ℂ)
    (d : PhysicalSharedLists Ps J) (M : ℝ) (hM : 0 ≤ M)
    (hblock : ∀ (Θ : ℝ) (v : RepeatedBigLists Pb J ell → ℂ), v ∈ repeatedBigSymmetricSubspace →
      cleanActiveNorm (repeatedBigActiveMass Vb b)
        (repeatedBigSymmetrizeLinear (fun source => ∑ target,
          (∑ i, ∑ aux, repeatedBigKernel Vb b (C i) ζ (K i) aux source target *
            physicalReturnPhase Θ (repeatedBigD (C i) source aux)) * v target)) ≤
          M * cleanActiveNorm (repeatedBigActiveMass Vb b) v)
    (f : RepeatedBigLists Pb J ell → (PhysicalResidues Ps × FixedOrderedResidues p) → ℂ) :
    cleanWeightedNorm (repeatedBigActiveMass Vb b) (cleanActiveMap repeatedBigSymmetrizeLinear
        (cleanHybridPatternCoreAction Vb b C ζ θ k p K d (cleanActiveMap repeatedBigSymmetrizeLinear f))) ≤
      M * cleanWeightedNorm (repeatedBigActiveMass Vb b) f := by
  have hμ (source : RepeatedBigLists Pb J ell) : 0 ≤ repeatedBigActiveMass Vb b source := by
    apply prod_nonneg
    intro g hg
    apply prod_nonneg
    intro s hs
    exact tiltedPhysicalBirthLaw_nonneg Vb g (b g) (hV g) (hb g) (source g s)
  exact clean_hybrid_pattern_projected_norm_le Vb b C ζ θ k p K d
    (repeatedBigActiveMass Vb b) hμ repeatedBigSymmetrizeLinear repeatedBigSymmetricSubspace
    (fun v => repeated_big_symmetrize_mem v)
    (fun v => repeated_big_symmetrize_norm_le _ hμ (repeated_big_active_mass_permutation Vb b) v)
    M hM hblock f
end

