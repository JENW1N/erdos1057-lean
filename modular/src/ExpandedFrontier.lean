/- The original candidate selected and peeled harmonic sums have arbitrary Mellin tail precision. -/

open Filter Finset MeasureTheory Real
namespace Bounty

theorem eventually_candidate_harmonic_cell_tail {c b K r : ℝ}
    (hc : 0 < c) (hb : 0 < b) (hK : 0 ≤ K) (hr : 0 < r)
    (J ell : ℕ) (Cb Ce D : ℝ) :
    ∀ᶠ L : ℝ in atTop,
      ∀ (groups : Finset ℕ), groups ⊆ candidatePIndices c L →
      ∀ (cut : groups → Finset (Fin J)) (big : Finset groups) (g : groups) (κ : ℕ),
      ell+(cut g).card = κ+1 → g ∉ big →
      ∀ (b₀ b₁ : GroupMarkedLists (fun j : big => candidatePBand (c*L) j.val.val)
          (fun j : big => ell+(cut j.val).card) → ℂ),
      (∀ l, ‖b₀ l‖ ≤ L^Cb) → (∀ l, ‖b₁ l‖ ≤ L^Cb) →
      ∀ (pool : Finset ℕ), (∀ j : groups, candidatePBand (c*L) j.val ⊆ pool) →
      ∀ (α₀ β₀ γ₀ α₁ β₁ γ₁ : ℕ → ℂ),
      (∀ n, ¬ Disjoint n.primeFactors pool → α₀ n = 0) →
      (∀ n, ¬ Disjoint n.primeFactors pool → β₀ n = 0) →
      (∀ n, ¬ Disjoint n.primeFactors pool → α₁ n = 0) →
      (∀ n, ¬ Disjoint n.primeFactors pool → β₁ n = 0) →
      (∀ n, ‖α₀ n‖ ≤ L^Ce) → (∀ n, ‖β₀ n‖ ≤ L^Ce) → (∀ n, ‖γ₀ n‖ ≤ L^Ce) →
      (∀ n, ‖α₁ n‖ ≤ L^Ce) → (∀ n, ‖β₁ n‖ ≤ L^Ce) → (∀ n, ‖γ₁ n‖ ≤ L^Ce) →
      ∀ (aux : PhysicalAuxLabels (fun j : groups => candidatePBand (c*L) j.val) cut),
      ∀ U V : ℝ, exp (b*L) ≤ U → U ≤ exp L → exp (b*L) ≤ V → V ≤ exp L →
      ∀ k ∈ Icc (-(typeIIAdmissibleDeterminantBound L K : ℤ))
        (typeIIAdmissibleDeterminantBound L K : ℤ),
      ∀ j ∈ range (typeIISmoothDyadicCount L),
      ∀ (h : ℝ) (D_A D_B : ℕ) (i_A i_B : ℤ),
      0 < h → h ≤ 1 → 0 < D_A → 0 < D_B → physicalFreeFactor cut aux = D_A*D_B →
      upperLogCell h (log D_A) = i_A → upperLogCell h (log D_B) = i_B →
      let P := fun j : groups => candidatePBand (c*L) j.val
      let mass := fun j : groups => ∑ p ∈ P j, 1/(p : ℝ)
      let marks := fun j : groups => ell+(cut j).card
      let Z := typeIISmoothDyadicScale U V (U*L^(-K)) j
      let H := harmonicCellProductScale h i_A i_B
      let d := physicalFreeFactor cut aux
      ∀ a₀ a₁ : ℝ,
      harmonicCellTruncationError Z H d k a₀ a₁
        (fun n => selectedMarkedEndpoint P (1/2) mass marks big b₀ pool α₀ β₀ γ₀ n.natAbs)
        (fun n => selectedMarkedEndpoint P (1/2) mass marks big b₁ pool α₁ β₁ γ₁ n.natAbs)
        (L^r) ≤ L^(-D) ∧
      harmonicCellTruncationError Z H d k a₀ a₁
        (fun n => selectedPeeledEndpoint P (1/2) mass marks g κ big b₀ pool α₀ β₀ γ₀ n.natAbs)
        (fun n => selectedPeeledEndpoint P (1/2) mass marks g κ big b₁ pool α₁ β₁ γ₁ n.natAbs)
        (L^r) ≤ L^(-D) := by
  obtain ⟨T,henergy⟩ := exists_candidate_harmonic_cutoff_energy hc J ell Cb Ce
  filter_upwards [henergy,eventually_candidate_harmonic_common_scale hc hb hK J,
    eventually_harmonic_cell_sum_mellin_tail hr T D] with L henergyL hscale htail
  intro groups hgroups cut big g κ hκ hg b₀ b₁ hb₀ hb₁ pool hpool
    α₀ β₀ γ₀ α₁ β₁ γ₁ hα₀free hβ₀free hα₁free hβ₁free
    hα₀ hβ₀ hγ₀ hα₁ hβ₁ hγ₁ aux U V hUlo hUhi hVlo hVhi k hk j hj
    h D_A D_B i_A i_B hh hh1 hDA hDB hd hcA hcB
  dsimp only
  intro a₀ a₁
  let Z := typeIISmoothDyadicScale U V (U*L^(-K)) j
  let H := harmonicCellProductScale h i_A i_B
  let d := physicalFreeFactor cut aux
  have hp := hscale groups hgroups cut aux U V hUlo hUhi hVlo hVhi k hk j hj
    h D_A D_B i_A i_B hh hh1 hDA hDB hd hcA hcB
  have hH : 0 < H := harmonic_cell_product_scale_pos h i_A i_B
  have hY : 1 ≤ Z*H := hp.2.1
  have hZ : 0 < Z := (mul_pos_iff_of_pos_right hH).mp (zero_lt_one.trans_le hY)
  have hcell := harmonic_cell_product_bounds hh hh1 hDA hDB hcA hcB
  have hHd : H ≤ (d : ℝ) := by
    dsimp only [d]
    rw [hd]
    exact hcell.1.le
  have hdH : (d : ℝ) ≤ exp 2*H := by
    dsimp only [d]
    rw [hd]
    exact hcell.2
  have he := henergyL groups hgroups cut big g κ hκ hg b₀ b₁ hb₀ hb₁ pool hpool
    α₀ β₀ γ₀ α₁ β₁ γ₁ hα₀free hβ₀free hα₁free hβ₁free
    hα₀ hβ₀ hγ₀ hα₁ hβ₁ hγ₁ (Z*H) hY hp.2.2.1 (k*(d : ℤ))
  constructor
  · apply htail Z H d k a₀ a₁ _ _ hZ hH hHd hdH hp.2.2.2.1
    simpa only [add_zero] using he.1
  · apply htail Z H d k a₀ a₁ _ _ hZ hH hHd hdH hp.2.2.2.1
    simpa only [add_zero] using he.2

end Bounty
end

section

/- The original local coefficient can be written using the edge cut directly,
then transported through a relabeling of the original full-event keys. -/

open scoped Classical
namespace Bounty
section Coefficient
variable {I V : Type} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : I → Fin N → Finset (Fin J)) (k : I → ℤ) (ζ : I → ℝ)
  (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)

noncomputable def physicalFullKeyCoefficientPhase
    (tag : Option (V ⊕ I)) (x : PhysicalFullBoundedState P J ell B)
    (e : FullPermutationMixedEvent (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i _ => PhysicalAuxLabels P (C i))
      (fun i => physicalFullEdgeDelta (C i) (k i)) (fun i => physicalFullEdgeD (C i)) tag x) : ℂ :=
  match tag with
  | none => 1
  | some (.inl _) => 1
  | some (.inr i) =>
    physicalActiveCoefficient (C i) (C i) (C i) (ζ i) (K i)
      (fun g => (x g).1)
      (fun g => (fullPermutationMixedEventTarget (fun g (p : P g) => p.val)
        (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
        (fun i _ => PhysicalAuxLabels P (C i))
        (fun i => physicalFullEdgeDelta (C i) (k i)) (fun i => physicalFullEdgeD (C i))
        (some (.inr i)) x e g).1) e.1

theorem physical_full_key_coefficient_transport {H : Type} (f : H → I)
    (tag : Option (V ⊕ H)) (x : PhysicalFullBoundedState P J ell B)
    (e : FullPermutationMixedEvent (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C (f i) g)) B
      (fun i _ => PhysicalAuxLabels P (C (f i)))
      (fun i => physicalFullEdgeDelta (C (f i)) (k (f i)))
      (fun i => physicalFullEdgeD (C (f i))) tag x) :
    physicalFullKeyCoefficientPhase C k ζ K (tag.map (Sum.map id f)) x
      (fullPermutationKeyEventEquiv (fun g (p : P g) => p.val)
        (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
        (fun i _ => PhysicalAuxLabels P (C i))
        (fun i => physicalFullEdgeDelta (C i) (k i)) (fun i => physicalFullEdgeD (C i)) f tag x e) =
    physicalFullKeyCoefficientPhase (fun i => C (f i)) (fun i => k (f i))
      (fun i => ζ (f i)) (fun i => K (f i)) tag x e := by
  cases tag with
  | none => rfl
  | some tag => cases tag <;> rfl

end Coefficient
section Fine
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (cut : ℕ → Fin N → Finset (Fin J))
  (hbefore : ∀ j : Fin n, cut (4 * j.val + 2) = C j)
  (hafter : ∀ j : Fin n, cut (4 * j.val + 3) = C j)
  (ζ : Fin n → ℝ)
  (K : ∀ j, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C j) → ℂ)

include hbefore hafter in
theorem physical_full_coefficient_edge_cut
    (tag : Option (Fin (n + 1) ⊕ Fin n)) (x : PhysicalFullBoundedState P J ell B)
    (e : PhysicalFullLedgerEvent C k tag (fullActiveInitialLedger x, x)) :
    physicalFullCoefficientPhase C k cut ζ K tag x e =
      physicalFullKeyCoefficientPhase C k ζ K tag x e := by
  cases tag with
  | none => rfl
  | some tag =>
    cases tag with
    | inl j => rfl
    | inr j =>
      dsimp only [physicalFullCoefficientPhase, physicalLocalCoefficientPhase,
        physicalFullKeyCoefficientPhase]
      rw [hbefore, hafter]
      rfl

end Fine
end Bounty
end

section

/- Exact full cutoff-box energy from central shifted energy and a controlled tail. -/

open Finset MeasureTheory

namespace Bounty

theorem harmonic_normalized_full_box_energy {Y : ℝ} (hY : 0 < Y)
    (a b R Eall Ecentral w : ℝ) (D A B C : Finset ℕ) (δ α β γ : ℕ → ℂ)
    (hD : ∀ d ∈ D, 0 < d) (hA : ∀ a ∈ A, 0 < a)
    (hB : ∀ z ∈ B, 0 < z) (hC : ∀ z ∈ C, 0 < z)
    (hall : ∀ u, (∫ s in Set.Icc a b,
      ‖(∑ d ∈ D, δ d * harmonicMellinWeight (s+w+2*Real.pi*u) d) *
        (∑ z ∈ A, α z * harmonicMellinWeight (s+w+2*Real.pi*u) z) *
        (∑ z ∈ B, β z * harmonicMellinWeight (s+w+2*Real.pi*u) z) *
        (∑ z ∈ C, γ z * harmonicMellinWeight (s+w+2*Real.pi*u) z)‖^2) ≤ Eall)
    (hcentral : ∀ u, ‖u‖ ≤ R → (∫ s in Set.Icc a b,
      ‖(∑ d ∈ D, δ d * harmonicMellinWeight (s+w+2*Real.pi*u) d) *
        (∑ z ∈ A, α z * harmonicMellinWeight (s+w+2*Real.pi*u) z) *
        (∑ z ∈ B, β z * harmonicMellinWeight (s+w+2*Real.pi*u) z) *
        (∑ z ∈ C, γ z * harmonicMellinWeight (s+w+2*Real.pi*u) z)‖^2) ≤ Ecentral) :
    (∫ s in Set.Icc a b,
      ‖∑ d ∈ D, ∑ x ∈ A, ∑ y ∈ B, ∑ z ∈ C,
        (δ d * α x * β y * γ z) *
          ((harmonicCommonCutoff (((d*x*y*z : ℕ) : ℝ) / Y) /
            ((d*x*y*z : ℕ) : ℝ) : ℝ) : ℂ) *
          physicalMellinPhase (s+w) ((d*x*y*z : ℕ) : ℝ)‖^2) ≤
      2*(∫ u in {u : ℝ | R < ‖u‖}, ‖harmonicWindowLogFourier u‖)^2*Eall +
      2*(∫ u in {u : ℝ | ‖u‖ ≤ R}, ‖harmonicWindowLogFourier u‖)^2*Ecentral := by
  let P : ℝ → ℂ := fun s =>
    ∑ d ∈ D, ∑ x ∈ A, ∑ y ∈ B, ∑ z ∈ C,
      (δ d * α x * β y * γ z) *
        ((harmonicCommonCutoff (((d*x*y*z : ℕ) : ℝ) / Y) /
          ((d*x*y*z : ℕ) : ℝ) : ℝ) : ℂ) *
        physicalMellinPhase (s+w) ((d*x*y*z : ℕ) : ℝ)
  let Q : ℝ → ℂ := fun s =>
    ∫ u in {u : ℝ | ‖u‖ ≤ R},
      harmonicWindowLogFourier u * physicalMellinPhase (-2*Real.pi*u) Y *
        ((∑ d ∈ D, δ d * harmonicMellinWeight (s+w+2*Real.pi*u) d) *
          (∑ z ∈ A, α z * harmonicMellinWeight (s+w+2*Real.pi*u) z) *
          (∑ z ∈ B, β z * harmonicMellinWeight (s+w+2*Real.pi*u) z) *
          (∑ z ∈ C, γ z * harmonicMellinWeight (s+w+2*Real.pi*u) z))
  have ht := harmonic_normalized_four_box_integrated_tail_shifted hY a b R Eall w
    D A B C δ α β γ hD hA hB hC hall
  have hc := harmonic_normalized_four_box_truncated_energy a b Y R Ecentral w
    D A B C δ α β γ hD hA hB hC hcentral
  have hPc : Continuous P := by dsimp [P,physicalMellinPhase]; fun_prop
  have herr (s : ℝ) : P s - Q s =
      harmonicNormalizedFourBoxError Y (s+w) R D A B C δ α β γ := rfl
  have he : Integrable (fun s => ‖P s - Q s‖^2) (volume.restrict (Set.Icc a b)) := by
    simpa only [IntegrableOn,herr] using ht.1
  have hq : Integrable (fun s => ‖Q s‖^2) (volume.restrict (Set.Icc a b)) := hc.1
  have htb : (∫ s in Set.Icc a b, ‖P s - Q s‖^2) ≤
      (∫ u in {u : ℝ | R < ‖u‖}, ‖harmonicWindowLogFourier u‖)^2*Eall := by
    simpa only [herr] using ht.2
  have hcb : (∫ s in Set.Icc a b, ‖Q s‖^2) ≤
      (∫ u in {u : ℝ | ‖u‖ ≤ R}, ‖harmonicWindowLogFourier u‖)^2*Ecentral := hc.2
  have hsplit := integral_square_le_twice_error_add_approximation
    (volume.restrict (Set.Icc a b)) P Q (hPc.norm.pow 2).integrableOn_Icc he hq
  change (∫ s in Set.Icc a b, ‖P s‖^2) ≤ _
  apply hsplit.trans
  simpa only [mul_assoc] using add_le_add
    (mul_le_mul_of_nonneg_left htb (by norm_num : (0 : ℝ) ≤ 2))
    (mul_le_mul_of_nonneg_left hcb (by norm_num : (0 : ℝ) ≤ 2))

end Bounty
end

