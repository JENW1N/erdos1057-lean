/- Exact finite positive cutoffs covering the actual auxiliary shift. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_fixed_aux_closure_subset_Icc
    {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (hprime : ∀ g p, p ∈ P g → p.Prime)
    (k : ℤ) (aux : PhysicalAuxLabels P C) (S : Finset ℤ) (B M : ℕ)
    (hshared : ∀ L : PhysicalMarkLists P J ell, physicalSharedFactor C L ≤ M)
    (hS : ∀ w ∈ S, (0 < w ∧ w ≤ (B : ℤ)) ∧
      (0 < w+k*(physicalFreeFactor C aux : ℕ) ∧
        w+k*(physicalFreeFactor C aux : ℕ) ≤ (B : ℤ))) :
    physicalFixedAuxPositionClosure P C ell k aux S ⊆ Icc 1 ((M*B : ℕ) : ℤ) := by
  apply (physical_fixed_aux_closure_subset_iff P C k aux S _).mpr
  intro L w hw
  have hs : 0 < (physicalSharedFactor C L : ℤ) := by
    exact_mod_cast physical_shared_factor_pos C L hprime
  have hle : (physicalSharedFactor C L : ℤ) ≤ (M : ℤ) := by exact_mod_cast hshared L
  have hb (n : ℤ) (hn : 0 < n) (hnB : n ≤ (B : ℤ)) :
      (physicalSharedFactor C L : ℤ)*n ∈ Icc 1 ((M*B : ℕ) : ℤ) := by
    apply mem_Icc.mpr
    constructor
    · have := mul_pos hs hn
      omega
    · have hh := mul_le_mul hle hnB hn.le (Int.natCast_nonneg M)
      simpa only [Nat.cast_mul] using hh
  exact ⟨hb w (hS w hw).1.1 (hS w hw).1.2,
    hb _ (hS w hw).2.1 (hS w hw).2.2⟩

theorem physical_harmonic_fixed_aux_cutoff
    {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (hprime : ∀ g p, p ∈ P g → p.Prime)
    (k : ℤ) (aux : PhysicalAuxLabels P C) {Z : ℝ} (hZ : 0 < Z)
    (hk : |(k : ℝ)| ≤ Z) (M : ℕ)
    (hshared : ∀ L : PhysicalMarkLists P J ell, physicalSharedFactor C L ≤ M) :
    physicalFixedAuxPositionClosure P C ell k aux
      (harmonicPositiveSupport Z k (physicalFreeFactor C aux)) ⊆
      Icc 1 ((M*⌈3*Z*(physicalFreeFactor C aux : ℝ)⌉₊ : ℕ) : ℤ) := by
  have hd : 0 < physicalFreeFactor C aux := by
    classical
    exact prod_pos (fun g _ => prod_pos (fun j _ => (hprime g _ (aux g j).property).pos))
  apply physical_fixed_aux_closure_subset_Icc C hprime k aux _ _ M hshared
  intro w hw
  have hs := (harmonic_positive_error_parameters hZ k hd hk).2 w hw
  exact ⟨⟨(mem_harmonic_positive_support hw).1, hs.1.2⟩, hs.2.1⟩

theorem physical_harmonic_fixed_aux_finite_cutoff
    {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (hprime : ∀ g p, p ∈ P g → p.Prime)
    (k : ℤ) (aux : PhysicalAuxLabels P C) {Z : ℝ} (hZ : 0 < Z)
    (hk : |(k : ℝ)| ≤ Z) :
    let M := (univ : Finset (PhysicalMarkLists P J ell)).sup (physicalSharedFactor C)
    physicalFixedAuxPositionClosure P C ell k aux
      (harmonicPositiveSupport Z k (physicalFreeFactor C aux)) ⊆
      Icc 1 ((M*⌈3*Z*(physicalFreeFactor C aux : ℝ)⌉₊ : ℕ) : ℤ) := by
  classical
  dsimp only
  apply physical_harmonic_fixed_aux_cutoff C hprime k aux hZ hk
  intro L
  exact le_sup (f := physicalSharedFactor C) (mem_univ L)

end Bounty
