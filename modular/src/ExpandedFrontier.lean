  rw [bounded_ghost_joint_row_events]
  apply sum_congr rfl
  intro e _
  rw [prod_mul_distrib, ← Complex.ofReal_prod, bounded_ghost_joint_fresh_product]

omit [∀ g, Fintype (P g)] [∀ g, DecidableEq (P g)] [∀ g p, NeZero (n g p)] in
theorem bounded_ghost_joint_decode_length (s : BoundedGhostJointLedgerState n t B) :
    globalBirthJointLength (boundedGhostJointDecode n t B s) =
      productTotalMemory (fun g => (s g).2) := rfl

