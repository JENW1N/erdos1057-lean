theorem finite_group_flatten_components {G : Type*} [DecidableEq G]
    {I X : G → Type*} [∀ g, DecidableEq (I g)] [∀ g, Fintype (X g)]
    (μ : ∀ g, X g → ℝ) (S : Finset (Sigma I)) (A : ∀ g, Finset (I g))
    (is : ∀ g, List (I g)) (gs : List G)
    (hS : ∀ g ∈ gs, ∀ i ∈ is g, (⟨g, i⟩ : Sigma I) ∈ S ↔ i ∈ A g)
    (f : (∀ g, I g → X g) → ℂ) :
    finiteCoordinateComponent (fun a : Sigma I => μ a.1) S (gs.sigma is)
        (finiteGroupFlattenFunction f) =
      finiteGroupFlattenFunction (finiteCoordinateCompose
        (fun g (v : (I g → X g) → ℂ) => finiteCoordinateComponent (fun _ : I g => μ g) (A g) (is g) v) gs f) := by
  induction gs with
  | nil => rfl
  | cons g gs ih =>
    change finiteCoordinateComponent _ S ((is g).map (Sigma.mk g) ++ gs.sigma is) _ = _
    rw [finite_coordinate_component_append,
      ih (fun h hh => hS h (List.mem_cons_of_mem _ hh)),
      finite_group_flatten_component μ g S (A g) (is g) (hS g (List.mem_cons_self))]
    rfl

theorem finite_group_flatten_finset_action {G : Type*} [DecidableEq G]
    {I X : G → Type*} [∀ g, DecidableEq (I g)] [∀ g, Fintype (X g)]
    (μ : ∀ g, X g → ℝ) (S : Finset (Sigma I)) (A B : ∀ g, Finset (I g))
    (s : Finset G)
    (hS : ∀ g ∈ s, ∀ i ∈ B g, (⟨g, i⟩ : Sigma I) ∈ S ↔ i ∈ A g)
    (f : (∀ g, I g → X g) → ℂ) :
    finiteCoordinateComponent (fun a : Sigma I => μ a.1) S (s.sigma B).toList
        (finiteGroupFlattenFunction f) =
      finiteGroupFlattenFunction (finiteCoordinateFinsetAction
        (fun g (v : (I g → X g) → ℂ) => finiteCoordinateComponent (fun _ : I g => μ g) (A g) (B g).toList v) s f) := by
  rw [← finite_coordinate_component_perm (fun a : Sigma I => μ a.1) S
    (finite_sigma_toList_perm s B) (finiteGroupFlattenFunction f)]
  exact finite_group_flatten_components μ S A (fun g => (B g).toList) s.toList
    (fun g hg i hi => hS g (mem_toList.mp hg) i (mem_toList.mp hi)) f
end

