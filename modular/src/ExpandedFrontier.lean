/- The full selected-data weight can retain the small residue factor. Its
actual capped history is encoded without assuming local factorization. -/

open Finset Classical
namespace Bounty

theorem physical_selected_weighted_history_sum_eq_record_action
    {N J ell r B : ℕ} {P : Fin N → Finset ℕ}
    [∀ g (p : P g), NeZero p.val]
    (C : Fin (r + 1) → Fin N → Finset (Fin J))
    [Fintype (PhysicalSelectedData P ell C)]
    (k : Fin (r + 1) → ℤ)
    (a : PhysicalSelectedData P ell C → Fin (r + 2) → ℤ)
    (hstep : ∀ d, ∀ j : Fin (r + 1), a d j.succ = a d j.castSucc +
      k j * (physicalD (C j)
        (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc)) (d.1 j) : ℤ))
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hk : ∀ d : PhysicalSelectedData P ell C,
      ∀ j : Fin (r + 1), ∀ g s, ¬ ((d.2.1 j.castSucc g s).val : ℤ) ∣ k j)
    (β : (g : Fin N) → P g → ℝ) (V : Fin N → ℝ) (ρ : ℝ)
    (hV : ∀ g, V g ≠ 0) (q : Fin (r + 2) → ℝ) (hρ : ρ ≠ 0)
    (cut : ℕ → Fin N → Finset (Fin J))
    (hencode : ∀ i, PhysicalMarkRowEncoding C
      (physicalSelectedFineTag (r + 1) i) (cut i) (cut (i + 1)))
    (w : PhysicalSelectedData P ell C → ℂ) :
    (∑ d : PhysicalSelectedData P ell C,
      (if ∀ j : Fin (r + 1), physicalListAdmissible (C j) (d.1 j)
        (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc))
        (physicalPermuteLabels (d.2.2.2 j) (d.2.1 j.succ)) then (1 : ℂ) else 0) *
      (∏ i ∈ range (2 * (r + 1) + 1), physicalSelectedCoarseScalar C
        d.1 d.2.1 d.2.2.1 (fun j _ aux => physicalAuxMass V (C j) aux) i) *
      w d *
      (ghostPhaseCappedHistory
        (fun p : PhysicalPrime P => fun j => globalBirthFiniteActivity
          (physicalGroupBareFiniteActivity d.2.1 p.1) j p.2)
        (fun p => physicalResidueAbsoluteHit (a d) p.1 p.2)
        (fun _ j => 1 - q (globalBirthFiniteIndex (r + 1) j))
        (fun p => β p.1 p.2) (fun p => V p.1) (fun _ => B) (fun _ => B) (r + 1) : ℂ)) =
    ∑ L : PhysicalMarkLists P J ell,
      ((∏ g, ∏ s : PhysicalSlots J ell, β g (L g s) / V g : ℝ) : ℂ) *
      physicalSelectedRecordAction C k β V ρ hV
        (fun j _ aux => physicalAuxMass V (C j) aux) q cut univ w fullMemoryVacuum
        (physicalInitialMarkState B L) := by
  have hn (d : PhysicalSelectedData P ell C) :=
    physical_selected_fine_normalization_unrestricted C d.1 k d.2.1 (a d)
      d.2.2.1 d.2.2.2 (hstep d) hP hdis (hk d) β V ρ hV B
      (fun j _ aux => physicalAuxMass V (C j) aux) q hρ
  calc
    _ = ∑ d : PhysicalSelectedData P ell C,
        ((∏ g, ∏ s : PhysicalSlots J ell, β g (d.2.1 0 g s) / V g : ℝ) : ℂ) *
        (w d *
          finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
            (physicalSelectedFineRow C d.1 d.2.1 d.2.2.1 d.2.2.2 k β V ρ hV
              (fun j _ aux => physicalAuxMass V (C j) aux) q)
            (4 * (r + 1) + 1) physicalEmptyMemoryTerminal (physicalInitialMarkState B (d.2.1 0))) := by
      apply sum_congr rfl
      intro d _
      linear_combination -(w d) * hn d
    _ = _ := by
      rw [← physical_selected_initial_pairing C k β V ρ hV
        (fun j _ aux => physicalAuxMass V (C j) aux) q univ w
        (fun L => ((∏ g, ∏ s : PhysicalSlots J ell, β g (L g s) / V g : ℝ) : ℂ))
        physicalEmptyMemoryTerminal]
      apply sum_congr rfl
      intro L _
      congr 1
      rw [physical_selected_record_action_eq_sum C k β V ρ hV
        (fun j _ aux => physicalAuxMass V (C j) aux) q cut univ w hP hdis hencode]
      rw [physical_full_vacuum_terminal_encode]

end Bounty
