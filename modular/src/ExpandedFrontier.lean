/- Exact positive harmonic root with arbitrary original list coefficient. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_positive_harmonic_root
    {G : Type*} [Fintype G] [dG : DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ) (C : G → Finset (Fin J))
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (q a b : ℝ) (k : ℤ) (positions : Finset ℤ)
    (α₀ β₀ γ₀ α₁ β₁ γ₁ : ℕ → ℂ) {Z : ℝ} (hZ : 0 < Z)
    (hclosure : physicalFixedAuxPositionClosure P
      C ell k aux
      (harmonicPositiveSupport Z k (physicalFreeFactor C aux)) ⊆ positions) :
    physicalFixedRootCorrelation V C q (-(a+b)) k
      K aux positions
      (fun n => physicalPhase (-a) n.natAbs *
        positiveInvariantEndpoint (univ.biUnion P) α₀ β₀ γ₀ n)
      (fun n => physicalPhase b n.natAbs *
        positiveInvariantEndpoint (univ.biUnion P) α₁ β₁ γ₁ n)
      (fun x => (typeIIHarmonicDyadic x : ℂ)) Z =
    (physicalAuxMass V C aux : ℂ) *
      ∑ w ∈ harmonicPositiveSupport Z k (physicalFreeFactor C aux),
        ((typeIIHarmonicDyadic ((w : ℝ) /
          (Z * physicalFreeFactor C aux)) : ℂ) *
          (w : ℂ)⁻¹ *
          (starRingEnd ℂ) (invariantTripleEndpoint (univ.biUnion P) α₀ β₀ γ₀ w.natAbs) *
          invariantTripleEndpoint (univ.biUnion P) α₁ β₁ γ₁
            (w + k * (physicalFreeFactor C aux : ℕ)).natAbs) *
        physicalFullPairCorrelation P C V q w.natAbs
          (w + k * (physicalFreeFactor C aux : ℕ)).natAbs
          (physicalPhasedPairCoefficient C K aux a b w.natAbs
            (w + k * (physicalFreeFactor C aux : ℕ)).natAbs) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  have hd : 0 < physicalFreeFactor C aux :=
    prod_pos (fun g _ => prod_pos (fun j _ => (hprime g _ (aux g j).property).pos))
  have hbase := physical_fixed_root_full_pair_on_fixed_support hdis hprime V C q a b k
    K aux positions (harmonicPositiveSupport Z k (physicalFreeFactor C aux)) hclosure
    (positiveInvariantEndpoint (univ.biUnion P) α₀ β₀ γ₀)
    (positiveInvariantEndpoint (univ.biUnion P) α₁ β₁ γ₁)
    (fun x => (typeIIHarmonicDyadic x : ℂ)) Z
    (positive_invariant_endpoint_shared_scale C hprime α₀ β₀ γ₀)
    (positive_invariant_endpoint_shared_scale C hprime α₁ β₁ γ₁)
    (original_harmonic_test_support (univ.biUnion P) α₀ β₀ γ₀ α₁ β₁ γ₁ hZ k hd)
  apply Eq.trans hbase
  congr 1
  apply sum_congr rfl
  intro w hw
  have hs := mem_harmonic_positive_support hw
  rw [positiveInvariantEndpoint, if_pos hs.1,
    positiveInvariantEndpoint, if_pos hs.2.2.2]


end Bounty
end

section

/- Removing the actual remaining auxiliary exclusions inside the weighted
invariant harmonic sum costs a reciprocal sum over the actual free labels. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_prime_aux_harmonic_error {G : Type*} [Fintype G] [dG : DecidableEq G]
    {J ell : ℕ} (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    {v : ℝ} (hv : 0 < v) (hV : ∀ g, v ≤ V g)
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ) (hξ : 0 < ξ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
    (a b : ℝ) (k : ℤ)
    (pool : Finset ℕ) (hpool : ∀ g, P g ⊆ pool) (α β γ α' β' γ' : ℕ → ℂ)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ n, ‖γ n‖ ≤ C)
    (hα' : ∀ m, ‖α' m‖ ≤ A) (hβ' : ∀ p, ‖β' p‖ ≤ B) (hγ' : ∀ n, ‖γ' n‖ ≤ C)
    (S : Finset ℤ) (N : ℕ)
    (hS : ∀ n ∈ S, 0 ≤ n ∧ n ≤ (N : ℤ))
    (hS' : ∀ n ∈ S,
      let δ : ℤ := k * (physicalFreeFactor (repeatedBigPrimePatternCut probes r t i) aux : ℕ)
      0 ≤ n+δ ∧ n+δ ≤ (N : ℤ))
    {Y K : ℝ} (hY : 0 < Y) (hK : 0 ≤ K) (hYlow : ∀ n ∈ S, Y ≤ (n : ℝ))
    (θ : ℤ → ℂ) (hθ : ∀ n ∈ S, ‖θ n‖ ≤ K) :
    let cut := repeatedBigPrimePatternCut probes r t i
    let δ : ℤ := k * (physicalFreeFactor cut aux : ℕ)
    let M := (markedDivisorBound (1/2) v (ell+J)) ^ Fintype.card G
    let W := fun n : ℤ => markedDivisorWeight univ P (1/2) V (fun g => ell + (cut g).card) n
    ‖∑ n ∈ S, (θ n / (n : ℂ)) *
      star (invariantTripleEndpoint pool α β γ n.natAbs) *
      invariantTripleEndpoint pool α' β' γ' (n+δ).natAbs *
      ((W n.natAbs * W (n+δ).natAbs : ℝ) : ℂ) *
      physicalFreePrimePairError P V probes r t hrt Q h ξ i aux a b n.natAbs (n+δ).natAbs‖ ≤
      (K * (M * M * (2 * repeatedBigPrimePatternBound probes r t Q ξ i)) / Y) *
        ((A*B*C)^2 * (N : ℝ) * (1+Real.log N)^15) *
        ∑ p ∈ physicalFreePrimeSet cut aux, 1/(p : ℝ) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  let cut := repeatedBigPrimePatternCut probes r t i
  let δ : ℤ := k * (physicalFreeFactor cut aux : ℕ)
  let M := (markedDivisorBound (1/2) v (ell+J)) ^ Fintype.card G
  let H := repeatedBigPrimePatternBound probes r t Q ξ i
  let W := fun n : ℤ => markedDivisorWeight univ P (1/2) V (fun g => ell + (cut g).card) n
  let e := fun n : ℤ => ((W n.natAbs * W (n+δ).natAbs : ℝ) : ℂ) *
    physicalFreePrimePairError P V probes r t hrt Q h ξ i aux a b n.natAbs (n+δ).natAbs
  have hW (n : ℤ) : 0 ≤ W n ∧ W n ≤ M := physical_marked_weight_bound P V cut hv hV n
  have hM : 0 ≤ M := (hW 0).1.trans (hW 0).2
  have hH : 0 ≤ H := repeated_big_prime_pattern_bound_nonneg probes r t Q ξ i
  have he (n : ℤ) : ‖e n‖ ≤ M*M*(2*H) := by
    dsimp only [e]
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (mul_nonneg (hW _).1 (hW _).1)]
    exact mul_le_mul
      (mul_le_mul (hW _).2 (hW _).2 (hW _).1 hM)
      (physical_free_prime_pair_error_norm_le P V probes r t hrt Q h ξ hξ i aux a b _ _)
      (norm_nonneg _) (mul_nonneg hM hM)
  have hzero (n : ℤ) (hn : ∀ p ∈ physicalFreePrimeSet cut aux, ¬ (p : ℤ) ∣ n) : e n = 0 := by
    dsimp only [e]
    rw [physical_free_prime_pair_error_zero P V probes r t hrt Q h ξ i aux a b n k hn,
      mul_zero]
  have hb := invariant_harmonic_supported_error pool (physicalFreePrimeSet cut aux)
    α β γ α' β' γ' hA hB hC hα hβ hγ hα' hβ' hγ' S δ N
    (fun p hp => physical_free_prime_set_supported cut aux hprime pool hpool hp)
    (fun p hp => physical_free_prime_set_dvd_step cut aux k hp) hS hS'
    hY hK (mul_nonneg (mul_nonneg hM hM) (mul_nonneg (by norm_num) hH))
    hYlow θ e hθ (fun n _ => he n) (fun n _ hn => hzero n hn)
  simpa only [e, mul_assoc] using hb

end Bounty
end

section

/- The original memory scalar is a product over selected data, with both
permutation normalizers and every zero-weight list constraint retained. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def physicalSelectedMemoryProduct
    {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell n : ℕ}
    (C : Fin n → G → Finset (Fin J)) (V : G → ℝ) (ζ : Fin n → ℝ)
    (K : ∀ j, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C j) → ℂ)
    (d : PhysicalGroupSelectedData P ell C) : ℂ :=
  ∏ j : Fin n, (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
    (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
    (if physicalListAdmissible (C j) (d.1 j)
      (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc))
      (physicalPermuteLabels (d.2.2.2 j) (d.2.1 j.succ)) then
      (physicalAuxMass V (C j) (d.1 j) : ℂ) *
        K j (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc))
          (physicalPermuteLabels (d.2.2.2 j) (d.2.1 j.succ)) (d.1 j) *
        physicalPhase (ζ j) (physicalD (C j)
          (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc)) (d.1 j))
      else 0)

theorem physical_selected_memory_product_unrestricted
    {N J ell r : ℕ} {P : Fin N → Finset ℕ}
    (C : Fin (r + 1) → Fin N → Finset (Fin J)) (V : Fin N → ℝ)
    (ζ : Fin (r + 1) → ℝ)
    (K : ∀ j, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C j) → ℂ)
    (d : PhysicalSelectedData P ell C) :
    physicalSelectedMemoryProduct C V ζ K d =
      (if ∀ j : Fin (r + 1), physicalListAdmissible (C j) (d.1 j)
        (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc))
        (physicalPermuteLabels (d.2.2.2 j) (d.2.1 j.succ)) then (1 : ℂ) else 0) *
      (∏ i ∈ range (2 * (r + 1) + 1), physicalSelectedCoarseScalar C
        d.1 d.2.1 d.2.2.1 (fun j _ aux => physicalAuxMass V (C j) aux) i) *
      physicalSelectedCoefficient C ζ K d := by
  by_cases hlist : ∀ j : Fin (r + 1), physicalListAdmissible (C j) (d.1 j)
      (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc))
      (physicalPermuteLabels (d.2.2.2 j) (d.2.1 j.succ))
  · rw [if_pos hlist, one_mul, physical_selected_coarse_scalar_product,
      physicalSelectedCoefficient, ← prod_mul_distrib]
    unfold physicalSelectedMemoryProduct
    apply prod_congr rfl
    intro j _
    rw [if_pos (hlist j)]
    simp only [Complex.ofReal_natCast, ← Nat.card_eq_fintype_card]
    ring
  · rw [if_neg hlist, zero_mul, zero_mul]
    push Not at hlist
    obtain ⟨j, hj⟩ := hlist
    unfold physicalSelectedMemoryProduct
    apply Finset.prod_eq_zero (mem_univ j)
    rw [if_neg hj, mul_zero]

theorem physical_selected_memory_product_reindex
    {G : Type*} [Fintype G] [DecidableEq G] {N J ell n : ℕ} {P : G → Finset ℕ}
    (e : G ≃ Fin N) (C : Fin n → G → Finset (Fin J)) (V : G → ℝ) (ζ : Fin n → ℝ)
    (K : ∀ j, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C j) → ℂ)
    (d : PhysicalGroupSelectedData P ell C) :
    physicalSelectedMemoryProduct (fun j g => C j (e.symm g)) (fun g => V (e.symm g)) ζ
      (fun j => physicalGroupReindexedCoefficient e (C j) (K j))
      (physicalSelectedGroupReindex e P C d) = physicalSelectedMemoryProduct C V ζ K d := by
  unfold physicalSelectedMemoryProduct
  apply prod_congr rfl
  intro j _
  have h := physical_memory_labeled_group_reindex e P J ell (univ : Finset (Fin n)) C V ζ K
    (d.2.2.1 j, d.2.2.2 j, ⟨⟨j, mem_univ j⟩, d.1 j⟩) (d.2.1 j.castSucc) (d.2.1 j.succ)
  simp only [physicalMemoryLabeledScalar, ← Nat.card_eq_fintype_card] at h ⊢
  dsimp only [physicalSelectedGroupReindex, physicalEdgeGroupReindex, Equiv.prodCongr,
    Equiv.piCongrRight, Equiv.sigmaCongrRight, Equiv.coe_fn_mk, Prod.map] at h ⊢
  exact h

end Bounty
end

section

/- The literal full-pair harmonic sum minus its unrestricted marked-average sum. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def physicalPositiveHarmonicDifference {G : Type*} [Fintype G] [DecidableEq G]
    {J ell : ℕ} (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
    (a b Z : ℝ) (k : ℤ) (pool : Finset ℕ) (α β γ α' β' γ' : ℕ → ℂ) : ℂ :=
  let cut := repeatedBigPrimePatternCut probes r t i
  let d := physicalFreeFactor cut aux
  let δ : ℤ := k*(d : ℤ)
  let marks := fun g => ell+(cut g).card
  let W := fun n : ℤ => markedDivisorWeight univ P (1/2) V marks n
  let S := harmonicPositiveSupport Z k d
  let F := fun n : ℤ => ((typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) : ℂ)/(n : ℂ)) *
    star (invariantTripleEndpoint pool α β γ n.natAbs) *
    invariantTripleEndpoint pool α' β' γ' (n+δ).natAbs
  (∑ n ∈ S, F n * physicalFullPairCorrelation P cut V (1/2) n.natAbs (n+δ).natAbs
    (physicalOriginalPrimePairCoefficient P V probes r t hrt Q h ξ i aux a b n.natAbs (n+δ).natAbs)) -
  (∑ n ∈ S, F n * ((W n.natAbs * W (n+δ).natAbs : ℝ) : ℂ) *
    groupMarkedAverage P marks (n.natAbs : ℤ) (fun u =>
      groupMarkedAverage P marks ((n+δ).natAbs : ℤ)
        (physicalFreePrimePairCoefficient P V probes r t hrt Q h ξ i aux a b n.natAbs (n+δ).natAbs u)))

end Bounty
end

section

/- Exact logarithmic Mellin representation and uniform truncation for the original cutoff. -/

open MeasureTheory
namespace Bounty

theorem harmonic_dyadic_mellin_representation {t : ℝ} (ht : 0 < t) :
    (typeIIHarmonicDyadic t : ℂ) = ∫ v : ℝ,
      harmonicLogFourier v*physicalMellinPhase (2*Real.pi*v) t := by
  have he := harmonic_log_fourier_inversion (Real.log t)
  simp only [harmonicLogCutoff, Real.exp_log ht] at he
  rw [he]
  apply integral_congr_ae
  exact Filter.Eventually.of_forall (fun v => mul_comm _ _)

theorem harmonic_dyadic_mellin_integrable (t : ℝ) :
    Integrable (fun v : ℝ => harmonicLogFourier v*physicalMellinPhase (2*Real.pi*v) t) :=
  physical_mellin_phase_integrable harmonicLogFourier (fun v => 2*Real.pi*v)
    harmonic_log_fourier_integrable (by fun_prop) t

theorem harmonic_dyadic_mellin_truncation {t : ℝ} (ht : 0 < t) (R : ℝ) :
    ‖(typeIIHarmonicDyadic t : ℂ) -
      ∫ v in {v : ℝ | ‖v‖ ≤ R}, harmonicLogFourier v*physicalMellinPhase (2*Real.pi*v) t‖ ≤
      ∫ v in {v : ℝ | R < ‖v‖}, ‖harmonicLogFourier v‖ := by
  have hs : MeasurableSet {v : ℝ | ‖v‖ ≤ R} :=
    (isClosed_le continuous_norm continuous_const).measurableSet
  have heq : {v : ℝ | ‖v‖ ≤ R}ᶜ = {v : ℝ | R < ‖v‖} := by ext v; simp
  rw [harmonic_dyadic_mellin_representation ht,
    ← setIntegral_compl hs (harmonic_dyadic_mellin_integrable t), heq]
  apply (norm_integral_le_integral_norm _).trans
  apply le_of_eq
  apply integral_congr_ae
  exact Filter.Eventually.of_forall (fun v => by
    dsimp only
    rw [norm_mul, physical_mellin_phase_norm, mul_one])

theorem harmonic_dyadic_mellin_rapid_truncation (M : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ R : ℝ, 1 ≤ R → ∀ t : ℝ, 0 < t →
      ‖(typeIIHarmonicDyadic t : ℂ) -
        ∫ v in {v : ℝ | ‖v‖ ≤ R}, harmonicLogFourier v*physicalMellinPhase (2*Real.pi*v) t‖ ≤
          C*R^(-(M : ℝ)) := by
  obtain ⟨C, hC, hb⟩ := harmonic_log_fourier_rapid_tail M
  exact ⟨C, hC, fun R hR t ht => (harmonic_dyadic_mellin_truncation ht R).trans (hb R hR)⟩

end Bounty
end

section

/- A fixed positive compact cutoff covering both endpoints of every cell comparison. -/

open scoped ContDiff

namespace Bounty

noncomputable def harmonicCommonCutoff (t : ℝ) : ℝ :=
  Real.smoothTransition (8 * t - 1) * Real.smoothTransition (4 - t / Real.exp 2)

theorem harmonic_common_cutoff_bounds (t : ℝ) :
    0 ≤ harmonicCommonCutoff t ∧ harmonicCommonCutoff t ≤ 1 := by
  unfold harmonicCommonCutoff
  constructor
  · exact mul_nonneg (Real.smoothTransition.nonneg _) (Real.smoothTransition.nonneg _)
  · exact mul_le_one₀ (Real.smoothTransition.le_one _) (Real.smoothTransition.nonneg _)
      (Real.smoothTransition.le_one _)

theorem harmonic_common_cutoff_eq_one {t : ℝ}
    (ht : t ∈ Set.Icc (1 / 4) (3 * Real.exp 2)) : harmonicCommonCutoff t = 1 := by
  have hdiv : t / Real.exp 2 ≤ 3 := (div_le_iff₀ (Real.exp_pos _)).mpr (by linarith [ht.2])
  unfold harmonicCommonCutoff
  rw [Real.smoothTransition.one_of_one_le (by linarith [ht.1]),
    Real.smoothTransition.one_of_one_le (by linarith), mul_one]

theorem harmonic_common_cutoff_support {t : ℝ} (ht : harmonicCommonCutoff t ≠ 0) :
    t ∈ Set.Ioo (1 / 8) (4 * Real.exp 2) := by
  constructor
  · by_contra hlo
    have hzero : 8 * t - 1 ≤ 0 := by linarith
    exact ht (by unfold harmonicCommonCutoff; rw [Real.smoothTransition.zero_of_nonpos hzero, zero_mul])
  · by_contra hhi
    have hdiv : 4 ≤ t / Real.exp 2 := (le_div_iff₀ (Real.exp_pos _)).mpr (by linarith)
    exact ht (by unfold harmonicCommonCutoff; rw [Real.smoothTransition.zero_of_nonpos (by linarith : 4 - t / Real.exp 2 ≤ 0), mul_zero])

theorem harmonic_common_cutoff_div_bound (t : ℝ) :
    |harmonicCommonCutoff t / t| ≤ 8 := by
  by_cases hz : harmonicCommonCutoff t = 0
  · simp only [hz, zero_div, abs_zero]
    norm_num
  · have hs := harmonic_common_cutoff_support hz
    have ht : 0 < t := by linarith [hs.1]
    have hc := harmonic_common_cutoff_bounds t
    rw [abs_of_nonneg (div_nonneg hc.1 ht.le)]
    apply (div_le_iff₀ ht).mpr
    linarith [hs.1, hc.2]

theorem harmonic_common_cutoff_contDiff : ContDiff ℝ ∞ harmonicCommonCutoff := by
  unfold harmonicCommonCutoff
  fun_prop

theorem harmonic_common_cutoff_hasCompactSupport : HasCompactSupport harmonicCommonCutoff := by
  apply HasCompactSupport.intro (K := Set.Icc (1 / 8) (4 * Real.exp 2)) isCompact_Icc
  intro t ht
  by_contra hn
  have hs := harmonic_common_cutoff_support hn
  exact ht ⟨hs.1.le, hs.2.le⟩

theorem harmonic_common_cutoff_scaled_eq_one {Y x : ℝ} (hY : 0 < Y)
    (hx : x ∈ Set.Icc (Y / 4) (3 * Real.exp 2 * Y)) : harmonicCommonCutoff (x / Y) = 1 := by
  apply harmonic_common_cutoff_eq_one
  constructor
  · apply (le_div_iff₀ hY).mpr
    linarith [hx.1]
  · exact (div_le_iff₀ hY).mpr hx.2

theorem harmonic_common_cutoff_scaled_support {Y x : ℝ} (hY : 0 < Y)
    (hx : harmonicCommonCutoff (x / Y) ≠ 0) :
    x ∈ Set.Ioo (Y / 8) (4 * Real.exp 2 * Y) := by
  have hs := harmonic_common_cutoff_support hx
  constructor
  · have := (lt_div_iff₀ hY).mp hs.1
    linarith
  · exact (div_lt_iff₀ hY).mp hs.2

theorem harmonic_common_cutoffs_of_cells {Z h : ℝ} (hZ : 0 < Z)
    (hh : 0 < h) (hh1 : h ≤ 1) {D_A D_B : ℕ} (hA : 0 < D_A) (hB : 0 < D_B)
    {i j k w : ℤ} (hcA : upperLogCell h (Real.log D_A) = i)
    (hcB : upperLogCell h (Real.log D_B) = j) (hk : |(k : ℝ)| ≤ Z / 4)
    (hψ : typeIIHarmonicDyadic ((w : ℝ) / (Z * ((D_A * D_B : ℕ) : ℝ))) ≠ 0) :
    harmonicCommonCutoff ((w : ℝ) / (Z * harmonicCellProductScale h i j)) = 1 ∧
      harmonicCommonCutoff (((w + k * (D_A * D_B : ℕ) : ℤ) : ℝ) /
        (Z * harmonicCellProductScale h i j)) = 1 := by
  have hY := mul_pos hZ (harmonic_cell_product_scale_pos h i j)
  have hs := harmonic_common_window_of_cells hZ hh hh1 hA hB hcA hcB hk hψ
  exact ⟨harmonic_common_cutoff_scaled_eq_one hY ⟨hs.1.1.le, hs.1.2.le⟩,
    harmonic_common_cutoff_scaled_eq_one hY ⟨hs.2.1.le, hs.2.2.le⟩⟩

end Bounty
end

section

/- The normalized central Mellin integral uses the fixed Fourier L1 mass. -/

open MeasureTheory Filter
namespace Bounty

theorem normalized_harmonic_central_bound {Y E : ℝ} (hY : 0 < Y) (hE : 0 ≤ E)
    (S : Set ℝ) (G : ℝ → ℂ)
    (hG : ∀ᵐ v ∂volume.restrict S, ‖G v‖ ≤ Y*E) :
    ‖(Y : ℂ)⁻¹ * ∫ v in S, harmonicLogFourier v * G v‖ ≤
      (∫ v : ℝ, ‖harmonicLogFourier v‖) * E := by
  have hb : ‖∫ v in S, harmonicLogFourier v * G v‖ ≤
      (∫ v in S, ‖harmonicLogFourier v‖) * (Y*E) := by
    calc
      _ ≤ ∫ v in S, ‖harmonicLogFourier v‖ * (Y*E) :=
        norm_integral_le_of_norm_le
          ((harmonic_log_fourier_integrable.norm.mul_const (Y*E)).integrableOn)
          (hG.mono (fun v hv => by
            rw [norm_mul]
            exact mul_le_mul_of_nonneg_left hv (norm_nonneg _)))
      _ = _ := integral_mul_const _ _
  have hm : (∫ v in S, ‖harmonicLogFourier v‖) ≤
      ∫ v : ℝ, ‖harmonicLogFourier v‖ :=
    setIntegral_le_integral harmonic_log_fourier_integrable.norm
      (Eventually.of_forall (fun v => norm_nonneg (harmonicLogFourier v)))
  rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hY]
  calc
    _ ≤ Y⁻¹ * ((∫ v in S, ‖harmonicLogFourier v‖) * (Y*E)) :=
      mul_le_mul_of_nonneg_left hb (inv_nonneg.mpr hY.le)
    _ ≤ Y⁻¹ * ((∫ v : ℝ, ‖harmonicLogFourier v‖) * (Y*E)) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_right hm (mul_nonneg hY.le hE)) (inv_nonneg.mpr hY.le)
    _ = _ := by field_simp

end Bounty
end

section

/- The selected-history sum with both empty-memory boundaries has an exact scalar energy bound. -/

open Finset
namespace Bounty

section Energy
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g, ∀ p : ↥(P g), NeZero p.val]
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ) (cut : ℕ → Fin N → Finset (Fin J))
  (S : Finset (PhysicalSelectedData P ell C)) (w : PhysicalSelectedData P ell C → ℂ)

theorem physical_selected_outer_vacuum_scalar_le
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hencode : ∀ i, PhysicalMarkRowEncoding C (physicalSelectedFineTag n i) (cut i) (cut (i + 1)))
    (hω : ∀ j c a, 0 ≤ ω j c a) (hωmass : ∀ j c, ∑ a, ω j c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 < β g p / V g) (hmass : ∀ g, ∑ p, β g p / V g ≤ 2)
    (hq0 : ∀ i, 0 ≤ retention i) (hq1 : ∀ i, retention i ≤ 1)
    (hD : ∀ i, retention i / ρ ^ 2 + ((1 - retention i) / ρ) / v ≤ 1)
    (hC : ∀ i g, retention i / ρ ^ 2 + ((1 - retention i) * V g / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ j g, ell + (C j g).card ≤ T)
    (initial : PhysicalFullBoundedState P J ell B → (g : Fin N) → Finset ↥(P g))
    (hw : ∀ d ∈ S, ‖w d‖ ≤ 1)
    :
    ‖∑ M : PhysicalMarkLists P J ell,
      ((∏ g, ∏ i : PhysicalSlots J ell, β g (M g i) / V g : ℝ) : ℂ) *
        (∑ d ∈ S, w d *
          finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
            (physicalSelectedFineRow C d.1 d.2.1 d.2.2.1 d.2.2.2 k β V ρ hV ω retention)
            (4 * n + 1) physicalEmptyMemoryTerminal
            (M, initial (physicalFullMemoryState (cut 0) M
              (fun _ => ⟨⟨0, Nat.zero_lt_succ B⟩, Fin.elim0⟩)),
              fun _ => ⟨⟨0, Nat.zero_lt_succ B⟩, Fin.elim0⟩))‖ ^ 2 ≤
      physicalMarkMass (J := J) (ell := ell) (fun g p => β g p / V g) *
        (physicalGhostUniformEnergyBound ρ vmax v ^ (N * (n + 1)) *
          unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ (N * n) *
          ∏ g, (∑ p, β g p / V g) ^ (J + ell)) := by
  let F := fun (M : PhysicalMarkLists P J ell)
      (q : (g : Fin N) → BoundedOrderedTuple (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B) =>
    ∑ d ∈ S, w d *
      finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
        (physicalSelectedFineRow C d.1 d.2.1 d.2.2.1 d.2.2.2 k β V ρ hV ω retention)
        (4 * n + 1) physicalEmptyMemoryTerminal
        (M, initial (physicalFullMemoryState (cut 0) M q), q)
  have he := physical_selected_outer_sum_energy_le C k β V ρ hV ω retention cut S w
    hP hdis hencode hω hωmass hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass hq0 hq1 hD hC
    T ht initial hw fullMemoryVacuum fullMemoryVacuum_symmetric
  have hterminal : (fun t : PhysicalBoundedMarkState P J ell B =>
      fullMemoryVacuum (physicalBoundedMarkEncode (cut (4 * n + 1)) t).2) =
      physicalEmptyMemoryTerminal := by
    funext t
    simp only [fullMemoryVacuum, physicalBoundedMarkEncode, physicalFullMemoryState,
      physicalEmptyMemoryTerminal]
    split_ifs with h <;> simp [h]
    simpa only [Fin.ext_iff, Fin.val_zero] using not_forall.mp h
  rw [hterminal] at he
  change physicalMarkMemoryEnergy (fun g p => β g p / V g)
    (fun g => unrestrictedResidueWeight (fun p => β g p / V g)) F ≤ _ at he
  rw [fullMemoryVacuum_energy, physical_selected_fine_energy_product] at he
  exact (physical_mark_vacuum_pairing_energy_le
    (fun g p => β g p / V g) (fun g => unrestrictedResidueWeight (fun p => β g p / V g))
    (fun g p => (hμ g p).le) (fun g z => (hμ g z.1).le)
    (fun _ => ⟨⟨0, Nat.zero_lt_succ B⟩, Fin.elim0⟩) (fun _ => rfl) F).trans
    (mul_le_mul_of_nonneg_left he (physical_mark_mass_nonneg _ (fun g p => (hμ g p).le)))

end Energy
end Bounty
end

