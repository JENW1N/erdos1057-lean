section

/- The actual amplitude has uniformly bounded derivatives through order two. -/

open Set Real
open scoped FourierTransform ContDiff

namespace Bounty

noncomputable def localMellinAmplitudeCutoff : SchwartzMap ℝ ℂ :=
  (show HasCompactSupport (fun u : ℝ => ((typeIISmoothRho 2 u*exp (-u) : ℝ) : ℂ)) from by
    apply HasCompactSupport.intro (isCompact_Icc : IsCompact (Icc (-3 : ℝ) 3))
    intro u hu
    have hz : typeIISmoothRho 2 u = 0 := by
      apply typeII_smooth_rho_eq_zero
      intro h
      apply hu
      constructor <;> linarith [h.1,h.2]
    simp [hz]).toSchwartzMap (by
      have hρ := typeII_smooth_rho_contDiff 2
      have hc : ContDiff ℝ ∞ (fun x : ℝ => (x : ℂ)) := Complex.ofRealCLM.contDiff
      fun_prop)

theorem local_mellin_amplitude_first (j : ℕ) (v u : ℝ) :
    SchwartzMap.derivCLM ℂ ℂ (localMellinAmplitudeSchwartz j v) u =
      exponentialProfileFirst localMellinAmplitudeCutoff (𝓕 localMellinKernelSchwartz) v u *
        (((1+v^2)^((j : ℝ)/4) : ℝ) : ℂ) := by
  exact ((exponential_profile_hasDerivAt localMellinAmplitudeCutoff
    (𝓕 localMellinKernelSchwartz) v u).mul_const _).deriv

theorem local_mellin_amplitude_second (j : ℕ) (v u : ℝ) :
    SchwartzMap.derivCLM ℂ ℂ (SchwartzMap.derivCLM ℂ ℂ (localMellinAmplitudeSchwartz j v)) u =
      exponentialProfileSecond localMellinAmplitudeCutoff (𝓕 localMellinKernelSchwartz) v u *
        (((1+v^2)^((j : ℝ)/4) : ℝ) : ℂ) := by
  have he : (SchwartzMap.derivCLM ℂ ℂ (localMellinAmplitudeSchwartz j v) : ℝ → ℂ) =
      fun x => exponentialProfileFirst localMellinAmplitudeCutoff (𝓕 localMellinKernelSchwartz) v x *
        (((1+v^2)^((j : ℝ)/4) : ℝ) : ℂ) := funext (local_mellin_amplitude_first j v)
  change deriv _ u = _
  rw [he]
  exact ((exponential_profile_first_hasDerivAt localMellinAmplitudeCutoff
    (𝓕 localMellinKernelSchwartz) v u).mul_const _).deriv

theorem local_mellin_amplitude_derivatives_zero (j : ℕ) (v u : ℝ)
    (hu : u ∉ Icc (-3 : ℝ) 3) :
    SchwartzMap.derivCLM ℂ ℂ (localMellinAmplitudeSchwartz j v) u = 0 ∧
    SchwartzMap.derivCLM ℂ ℂ (SchwartzMap.derivCLM ℂ ℂ (localMellinAmplitudeSchwartz j v)) u = 0 := by
  have hs : tsupport (localMellinAmplitudeSchwartz j v) ⊆ Icc (-3 : ℝ) 3 := by
    apply closure_minimal _ isClosed_Icc
    intro x hx
    by_contra hn
    exact hx (local_mellin_amplitude_zero j v x hn)
  have hs₁ := (SchwartzMap.tsupport_derivCLM_subset ℂ (localMellinAmplitudeSchwartz j v)).trans hs
  have hs₂ := (SchwartzMap.tsupport_derivCLM_subset ℂ
    (SchwartzMap.derivCLM ℂ ℂ (localMellinAmplitudeSchwartz j v))).trans hs₁
  exact ⟨image_eq_zero_of_notMem_tsupport (fun h => hu (hs₁ h)),
    image_eq_zero_of_notMem_tsupport (fun h => hu (hs₂ h))⟩

theorem local_mellin_amplitude_uniform_derivatives (j : ℕ) :
    ∃ C₀ C₁ C₂ : ℝ, 0 ≤ C₀ ∧ 0 ≤ C₁ ∧ 0 ≤ C₂ ∧ ∀ v u : ℝ,
      ‖localMellinAmplitudeSchwartz j v u‖ ≤ C₀ ∧
      ‖SchwartzMap.derivCLM ℂ ℂ (localMellinAmplitudeSchwartz j v) u‖ ≤ C₁ ∧
      ‖SchwartzMap.derivCLM ℂ ℂ (SchwartzMap.derivCLM ℂ ℂ (localMellinAmplitudeSchwartz j v)) u‖ ≤ C₂ := by
  obtain ⟨C₀,C₁,C₂,hC₀,hC₁,hC₂,hbound⟩ := exponential_profile_weighted_bounds
    localMellinAmplitudeCutoff (𝓕 localMellinKernelSchwartz) j 3
  refine ⟨C₀,C₁,C₂,hC₀,hC₁,hC₂,?_⟩
  intro v u
  by_cases hu : u ∈ Icc (-3 : ℝ) 3
  · have hb := hbound v u hu
    have hW : 0 ≤ (1+v^2)^((j : ℝ)/4) := by positivity
    constructor
    · change ‖exponentialProfile localMellinAmplitudeCutoff (𝓕 localMellinKernelSchwartz) v u *
        (((1+v^2)^((j : ℝ)/4) : ℝ) : ℂ)‖ ≤ _
      simpa only [norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg hW,mul_comm] using hb.1
    · rw [local_mellin_amplitude_first,local_mellin_amplitude_second]
      simpa only [norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg hW,mul_comm] using hb.2
  · have hz := local_mellin_amplitude_derivatives_zero j v u hu
    simpa only [show localMellinAmplitudeSchwartz j v u = 0 from local_mellin_amplitude_zero j v u hu,
      hz.1,hz.2,norm_zero] using And.intro hC₀ (And.intro hC₁ hC₂)

end Bounty
end

section

open scoped BigOperators
open MeasureTheory

namespace Bounty

theorem dirichlet_derivative_mean_square (s : Finset ℕ) (c : ℕ → ℂ)
    (N : ℕ) (a b : ℝ) (hab : a ≤ b) (hs : ∀ n ∈ s, 1 ≤ n ∧ n ≤ N) :
    (∫ t in a..b, ‖∑ n ∈ s, (c n * ((Real.log (n : ℝ) : ℂ) * Complex.I)) *
      Complex.exp ((Real.log (n : ℝ) * t : ℝ) * Complex.I)‖ ^ 2) ≤
      (Real.log N) ^ 2 *
        (((b - a) + 4 * (N : ℝ) * (1 + Real.log N)) * ∑ n ∈ s, ‖c n‖ ^ 2) := by
  have hM0 : 0 ≤ (b - a) + 4 * (N : ℝ) * (1 + Real.log N) := by
    have := sub_nonneg.mpr hab
    have := Real.log_natCast_nonneg N
    positivity
  calc
    _ ≤ ((b - a) + 4 * (N : ℝ) * (1 + Real.log N)) *
        ∑ n ∈ s, ‖c n * ((Real.log (n : ℝ) : ℂ) * Complex.I)‖ ^ 2 :=
      dirichlet_polynomial_mean_square s _ N a b hab hs
    _ ≤ ((b - a) + 4 * (N : ℝ) * (1 + Real.log N)) *
        ((Real.log N) ^ 2 * ∑ n ∈ s, ‖c n‖ ^ 2) :=
      mul_le_mul_of_nonneg_left (dirichlet_derivative_coefficient_energy s c N hs) hM0
    _ = _ := by ring

theorem dirichlet_polynomial_separated_samples {ι : Type*}
    (indices : Finset ι) (x : ι → ℝ) (s : Finset ℕ) (c : ℕ → ℂ)
    (N : ℕ) {δ a b : ℝ} (hδ : 0 < δ) (hab : a ≤ b)
    (hleft : ∀ i ∈ indices, a ≤ x i) (hright : ∀ i ∈ indices, x i + δ ≤ b)
    (hsep : ∀ i ∈ indices, ∀ j ∈ indices, i ≠ j → δ ≤ |x i - x j|)
    (hs : ∀ n ∈ s, 1 ≤ n ∧ n ≤ N) :
    (∑ i ∈ indices, ‖∑ n ∈ s, c n *
      Complex.exp ((Real.log (n : ℝ) * x i : ℝ) * Complex.I)‖ ^ 2) ≤
      (δ⁻¹ + 2 * (1 + Real.log N)) *
        (((b - a) + 4 * (N : ℝ) * (1 + Real.log N)) * ∑ n ∈ s, ‖c n‖ ^ 2) := by
  have hlog : 0 ≤ Real.log (N : ℝ) := Real.log_natCast_nonneg N
  have hQ0 : 0 ≤ ((b - a) + 4 * (N : ℝ) * (1 + Real.log N)) *
      ∑ n ∈ s, ‖c n‖ ^ 2 := by
    have := sub_nonneg.mpr hab
    positivity
  apply separated_samples_norm_sq_le_energy indices x hδ hab hleft hright hsep
    (fun t => ∑ n ∈ s, c n * Complex.exp ((Real.log (n : ℝ) * t : ℝ) * Complex.I))
    (fun t => ∑ n ∈ s, (c n * ((Real.log (n : ℝ) : ℂ) * Complex.I)) *
      Complex.exp ((Real.log (n : ℝ) * t : ℝ) * Complex.I))
  · exact dirichlet_polynomial_hasDerivAt s c
  · fun_prop
  · positivity
  · exact dirichlet_polynomial_mean_square s c N a b hab hs
  · refine (dirichlet_derivative_mean_square s c N a b hab hs).trans ?_
    apply mul_le_mul_of_nonneg_right _ hQ0
    nlinarith

end Bounty
end

section

/- A first-derivative test with monotone phase increments on an integer interval. -/

open Finset

namespace Bounty

theorem sum_integer_interval_as_range (g : ℤ → ℂ) {a b : ℤ} (hab : a ≤ b) :
    ∑ n ∈ Icc a b, g n = ∑ n ∈ range (b-a+1).toNat, g (a+n) := by
  symm
  apply sum_bij (fun (n : ℕ) _ => a+(n : ℤ))
  · intro n hn
    rw [mem_range] at hn
    rw [mem_Icc]
    have hcast : ((b-a+1).toNat : ℤ) = b-a+1 := Int.toNat_of_nonneg (by omega)
    constructor <;> omega
  · intro n hn m hm he
    omega
  · intro z hz
    have hz' := mem_Icc.mp hz
    refine ⟨(z-a).toNat, ?_, ?_⟩
    · rw [mem_range]
      omega
    · omega
  · intro n hn
    rfl

theorem integer_first_derivative_sum_bound (f : ℤ → ℝ) (a b k : ℤ)
    {δ : ℝ} (hδ : 0 < δ) (hδhalf : δ ≤ 1/2)
    (hband : ∀ n ∈ Icc a b, (k : ℝ)+δ ≤ f (n+1)-f n ∧
      f (n+1)-f n ≤ (k : ℝ)+1-δ)
    (hmono : MonotoneOn (fun n => f (n+1)-f n) (Set.Icc a b) ∨
      AntitoneOn (fun n => f (n+1)-f n) (Set.Icc a b)) :
    ‖∑ n ∈ Icc a b, realUnitPhase (f n)‖ ≤ 2/δ := by
  by_cases hab : a ≤ b
  · rw [sum_integer_interval_as_range _ hab]
    have hm (n : ℕ) (hn : n < (b-a+1).toNat) : a+(n : ℤ) ∈ Icc a b := by
      rw [mem_Icc]
      have hcast : ((b-a+1).toNat : ℤ) = b-a+1 := Int.toNat_of_nonneg (by omega)
      constructor <;> omega
    apply first_derivative_range_sum_bound (fun n => f (a+(n : ℤ))) _ k hδ hδhalf
    · intro n hn
      simpa only [Nat.cast_add, Nat.cast_one, ← add_assoc] using hband _ (hm n hn)
    · rcases hmono with hmon | hmon
      · left
        intro n hn m hm' hnm
        simpa only [Nat.cast_add, Nat.cast_one, ← add_assoc] using
          hmon (mem_Icc.mp (hm n hn)) (mem_Icc.mp (hm m hm')) (by omega)
      · right
        intro n hn m hm' hnm
        simpa only [Nat.cast_add, Nat.cast_one, ← add_assoc] using
          hmon (mem_Icc.mp (hm n hn)) (mem_Icc.mp (hm m hm')) (by omega)
  · rw [Icc_eq_empty_of_lt (lt_of_not_ge hab),sum_empty,norm_zero]
    positivity

end Bounty
end

section

/- A genuine second derivative exponential-sum test, using the proved first derivative estimate. -/

open Finset

namespace Bounty

theorem nat_second_derivative_sum_bound (f : ℕ → ℝ) {a b : ℕ} {lam A : ℝ}
    (hab : a ≤ b) (hlam : 0 < lam) (hA : 1 ≤ A)
    (hsep : ∀ i ∈ Icc a b, ∀ j ∈ Icc a b, i ≤ j →
      lam*((j : ℝ)-i) ≤ (f (j+1)-f j)-(f (i+1)-f i) ∧
        (f (j+1)-f j)-(f (i+1)-f i) ≤ A*lam*((j : ℝ)-i)) :
    ‖∑ n ∈ Icc a b, realUnitPhase (f n)‖ ≤
      6*(A*((b : ℝ)-a+1)*Real.sqrt lam+2/Real.sqrt lam) := by
  have he := discrete_second_derivative_from_first (d := fun n => f (n+1)-f n)
    (z := fun n => realUnitPhase (f n)) (C := 2) hab hlam hA (by norm_num) hsep
    (fun n _ => (real_unit_phase_norm _).le)
  norm_num only [show (2 : ℝ)+4=6 by norm_num] at he
  apply he
  intro δ hδ hδhalf l r k hl hr hlr hband
  apply nat_first_derivative_sum_bound f l r k hδ hδhalf hband
  intro i hi j hj hij
  have hi' : i ∈ Icc a b := mem_Icc.mpr ⟨hl.trans hi.1,hi.2.trans hr⟩
  have hj' : j ∈ Icc a b := mem_Icc.mpr ⟨hl.trans hj.1,hj.2.trans hr⟩
  have h := (hsep i hi' j hj' hij).1
  have hijR : (i : ℝ) ≤ j := by exact_mod_cast hij
  nlinarith

theorem second_derivative_sum_bound {f f' f'' : ℝ → ℝ} {a b : ℕ} {lam A : ℝ}
    (hab : a ≤ b) (hlam : 0 < lam) (hA : 1 ≤ A)
    (hf : ∀ x ∈ Set.Icc (a : ℝ) (b+1), HasDerivAt f (f' x) x)
    (hf' : ∀ x ∈ Set.Icc (a : ℝ) (b+1), HasDerivAt f' (f'' x) x)
    (hb : ∀ x ∈ Set.Icc (a : ℝ) (b+1), lam ≤ f'' x ∧ f'' x ≤ A*lam) :
    ‖∑ n ∈ Icc a b, realUnitPhase (f n)‖ ≤
      6*(A*((b : ℝ)-a+1)*Real.sqrt lam+2/Real.sqrt lam) := by
  apply nat_second_derivative_sum_bound (fun n => f n) hab hlam hA
  intro i hi j hj hij
  have hi' : (i : ℝ) ∈ Set.Icc (a : ℝ) b := by
    constructor
    · exact_mod_cast (mem_Icc.mp hi).1
    · exact_mod_cast (mem_Icc.mp hi).2
  have hj' : (j : ℝ) ∈ Set.Icc (a : ℝ) b := by
    constructor
    · exact_mod_cast (mem_Icc.mp hj).1
    · exact_mod_cast (mem_Icc.mp hj).2
  simpa only [Nat.cast_add,Nat.cast_one] using
    second_derivative_increment_bounds hf hf' hb hi' hj' (by exact_mod_cast hij)

theorem norm_sum_real_unit_phase_neg (S : Finset ℕ) (f : ℕ → ℝ) :
    ‖∑ n ∈ S, realUnitPhase (-f n)‖ = ‖∑ n ∈ S, realUnitPhase (f n)‖ := by
  have he (x : ℝ) : realUnitPhase (-x) = (starRingEnd ℂ) (realUnitPhase x) := by
    unfold realUnitPhase
    rw [← Complex.exp_conj]
    congr 1
    simp only [map_mul,Complex.conj_ofReal,Complex.conj_I]
    push_cast
    ring
  simp_rw [he]
  rw [← map_sum]
  exact Complex.norm_conj _

theorem second_derivative_sum_bound_negative {f f' f'' : ℝ → ℝ} {a b : ℕ} {lam A : ℝ}
    (hab : a ≤ b) (hlam : 0 < lam) (hA : 1 ≤ A)
    (hf : ∀ x ∈ Set.Icc (a : ℝ) (b+1), HasDerivAt f (f' x) x)
    (hf' : ∀ x ∈ Set.Icc (a : ℝ) (b+1), HasDerivAt f' (f'' x) x)
    (hb : ∀ x ∈ Set.Icc (a : ℝ) (b+1), -A*lam ≤ f'' x ∧ f'' x ≤ -lam) :
    ‖∑ n ∈ Icc a b, realUnitPhase (f n)‖ ≤
      6*(A*((b : ℝ)-a+1)*Real.sqrt lam+2/Real.sqrt lam) := by
  have h := second_derivative_sum_bound hab hlam hA
    (fun x hx => (hf x hx).neg) (fun x hx => (hf' x hx).neg)
    (show ∀ x ∈ Set.Icc (a : ℝ) (b+1), lam ≤ -f'' x ∧ -f'' x ≤ A*lam from by
      intro x hx
      have hb' := hb x hx
      constructor <;> linarith)
  simpa only [Pi.neg_apply,norm_sum_real_unit_phase_neg] using h

end Bounty
end

section

/- Actual prime-polynomial power moments and derivative moments. The
integer coefficients, their factorial energy bound, and their support range
are all derived from the prime tuples rather than assumed. -/

open Finset MeasureTheory
open scoped Classical
namespace Bounty

theorem prime_polynomial_support_range (P : Finset ℕ)
    (hP : ∀ p ∈ P, Nat.Prime p) (U : ℝ) (hU : ∀ p ∈ P, (p : ℝ) ≤ U)
    (j N : ℕ) (hN : U ^ j ≤ (N : ℝ)) :
    ∀ n ∈ primePolynomialSupport P j, 1 ≤ n ∧ n ≤ N := by
  intro n hn
  exact ⟨prime_polynomial_support_pos P hP j n hn,
    Nat.cast_le.mp ((prime_polynomial_support_real_le P U hU j n hn).trans hN)⟩

theorem prime_polynomial_mean_square_factor_nonneg (N : ℕ) (hN : 1 ≤ N)
    (a b : ℝ) (hab : a ≤ b) :
    0 ≤ (b - a) + 4 * (N : ℝ) * (1 + Real.log N) := by
  have hlog : 0 ≤ Real.log N := Real.log_nonneg (by exact_mod_cast hN)
  exact add_nonneg (sub_nonneg.mpr hab)
    (mul_nonneg (mul_nonneg (by norm_num) (Nat.cast_nonneg _))
      (add_nonneg zero_le_one hlog))

theorem prime_polynomial_power_mean_square (P : Finset ℕ)
    (hP : ∀ p ∈ P, Nat.Prime p) (w : P → ℂ)
    (U : ℝ) (hU : ∀ p ∈ P, (p : ℝ) ≤ U) (j N : ℕ)
    (hN : 1 ≤ N) (hUN : U ^ j ≤ (N : ℝ)) (a b : ℝ) (hab : a ≤ b) :
    (∫ t in a..b,
      ‖(∑ p : P, w p * Complex.exp (((Real.log (p.val : ℝ) * t : ℝ) : ℂ) * Complex.I)) ^ j‖ ^ 2) ≤
      ((b - a) + 4 * (N : ℝ) * (1 + Real.log N)) *
        (j.factorial : ℝ) * (∑ p : P, ‖w p‖ ^ 2) ^ j := by
  have hexp : (fun t : ℝ =>
      ‖(∑ p : P, w p * Complex.exp (((Real.log (p.val : ℝ) * t : ℝ) : ℂ) * Complex.I)) ^ j‖ ^ 2) =
      (fun t : ℝ => ‖∑ n ∈ primePolynomialSupport P j, primePolynomialCoefficient P w j n *
        Complex.exp (((Real.log (n : ℝ) * t : ℝ) : ℂ) * Complex.I)‖ ^ 2) := by
    funext t
    rw [prime_polynomial_power_exp_log P hP w j t]
  rw [hexp]
  have hm := dirichlet_polynomial_mean_square (primePolynomialSupport P j)
    (primePolynomialCoefficient P w j) N a b hab (prime_polynomial_support_range P hP U hU j N hUN)
  have hc := mul_le_mul_of_nonneg_left (prime_polynomial_coefficients_sq_le_factorial P hP w j)
    (prime_polynomial_mean_square_factor_nonneg N hN a b hab)
  exact hm.trans (by simpa only [mul_assoc] using hc)

theorem prime_polynomial_even_moment (P : Finset ℕ)
    (hP : ∀ p ∈ P, Nat.Prime p) (w : P → ℂ)
    (U : ℝ) (hU : ∀ p ∈ P, (p : ℝ) ≤ U) (j N : ℕ)
    (hN : 1 ≤ N) (hUN : U ^ j ≤ (N : ℝ)) (a b : ℝ) (hab : a ≤ b) :
    (∫ t in a..b,
      ‖∑ p : P, w p * Complex.exp (((Real.log (p.val : ℝ) * t : ℝ) : ℂ) * Complex.I)‖ ^ (2 * j)) ≤
      ((b - a) + 4 * (N : ℝ) * (1 + Real.log N)) *
        (j.factorial : ℝ) * (∑ p : P, ‖w p‖ ^ 2) ^ j := by
  simpa only [norm_pow, ← pow_mul, Nat.mul_comm j 2] using
    prime_polynomial_power_mean_square P hP w U hU j N hN hUN a b hab

theorem prime_polynomial_power_hasDerivAt (P : Finset ℕ)
    (hP : ∀ p ∈ P, Nat.Prime p) (w : P → ℂ) (j : ℕ) (t : ℝ) :
    HasDerivAt
      (fun t : ℝ =>
        (∑ p : P, w p * Complex.exp (((Real.log (p.val : ℝ) * t : ℝ) : ℂ) * Complex.I)) ^ j)
      (∑ n ∈ primePolynomialSupport P j,
        (primePolynomialCoefficient P w j n * ((Real.log (n : ℝ) : ℂ) * Complex.I)) *
          Complex.exp (((Real.log (n : ℝ) * t : ℝ) : ℂ) * Complex.I)) t := by
  have hexp : (fun t : ℝ =>
      (∑ p : P, w p * Complex.exp (((Real.log (p.val : ℝ) * t : ℝ) : ℂ) * Complex.I)) ^ j) =
      (fun t : ℝ => ∑ n ∈ primePolynomialSupport P j, primePolynomialCoefficient P w j n *
        Complex.exp (((Real.log (n : ℝ) * t : ℝ) : ℂ) * Complex.I)) :=
    funext (prime_polynomial_power_exp_log P hP w j)
  rw [hexp]
  exact dirichlet_polynomial_hasDerivAt _ _ t

theorem prime_polynomial_power_derivative_mean_square (P : Finset ℕ)
    (hP : ∀ p ∈ P, Nat.Prime p) (w : P → ℂ)
    (U : ℝ) (hU : ∀ p ∈ P, (p : ℝ) ≤ U) (j N : ℕ)
    (hN : 1 ≤ N) (hUN : U ^ j ≤ (N : ℝ)) (a b : ℝ) (hab : a ≤ b) :
    (∫ t in a..b, ‖∑ n ∈ primePolynomialSupport P j,
      (primePolynomialCoefficient P w j n * ((Real.log (n : ℝ) : ℂ) * Complex.I)) *
        Complex.exp (((Real.log (n : ℝ) * t : ℝ) : ℂ) * Complex.I)‖ ^ 2) ≤
      ((b - a) + 4 * (N : ℝ) * (1 + Real.log N)) * (Real.log N) ^ 2 *
        (j.factorial : ℝ) * (∑ p : P, ‖w p‖ ^ 2) ^ j := by
  have hs := prime_polynomial_support_range P hP U hU j N hUN
  have hm := dirichlet_polynomial_mean_square (primePolynomialSupport P j)
    (fun n => primePolynomialCoefficient P w j n * ((Real.log (n : ℝ) : ℂ) * Complex.I))
    N a b hab hs
  have he := (dirichlet_derivative_coefficient_energy (primePolynomialSupport P j)
    (primePolynomialCoefficient P w j) N hs).trans
    (mul_le_mul_of_nonneg_left (prime_polynomial_coefficients_sq_le_factorial P hP w j)
      (sq_nonneg _))
  exact hm.trans (by simpa only [mul_assoc] using
    mul_le_mul_of_nonneg_left he (prime_polynomial_mean_square_factor_nonneg N hN a b hab))

end Bounty
end

section

/- Supremum energy on an arbitrary finite collection of closed unit intervals. -/

open scoped BigOperators
open Set

namespace Bounty

theorem sparse_dirichlet_unit_interval_suprema (indices : Finset ℤ)
    (support : Finset ℕ) (c : ℕ → ℂ) (N : ℕ) {a b U E : ℝ}
    (hU : 0 ≤ U) (hE : 0 ≤ E)
    (hleft : ∀ j ∈ indices, a ≤ (j : ℝ))
    (hright : ∀ j ∈ indices, (j : ℝ) + 1 ≤ b) (hwidth : b - a ≤ N)
    (hkernel : ∀ z : ℝ, |z| ≤ N →
      ‖∑ n ∈ support, Complex.exp ((Real.log (n : ℝ) * z : ℝ) * Complex.I)‖ ≤
        U / (1 + |z|) + E) :
    (∑ j ∈ indices, unitIntervalEnergySup
      (fun t => ∑ n ∈ support, c n * Complex.exp ((Real.log (n : ℝ) * t : ℝ) * Complex.I)) j) ≤
      (3 * U * (1 + 2 * (1 + Real.log N)) + (indices.card : ℝ) * E) *
        ∑ n ∈ support, ‖c n‖ ^ 2 := by
  classical
  let F : ℝ → ℂ := fun t => ∑ n ∈ support,
    c n * Complex.exp ((Real.log (n : ℝ) * t : ℝ) * Complex.I)
  have hF : Continuous F := by dsimp [F]; fun_prop
  choose point hpoint hvalue using exists_unit_interval_energy_max F hF
  have hspan (i : ℤ) (hi : i ∈ indices) (j : ℤ) (hj : j ∈ indices) :
      |point i - point j| ≤ N := by
    have hi0 := (hpoint i).1
    have hi1 := (hpoint i).2
    have hj0 := (hpoint j).1
    have hj1 := (hpoint j).2
    exact abs_le.mpr ⟨by linarith [hleft i hi, hright j hj],
      by linarith [hright i hi, hleft j hj]⟩
  have hclass (r : Fin 3) :
      (∑ j ∈ indices.filter (fun j => unitIntervalResidue j = r), unitIntervalEnergySup F j) ≤
      (U * (1 + 2 * (1 + Real.log N)) +
        ((indices.filter (fun j => unitIntervalResidue j = r)).card : ℝ) * E) *
        ∑ n ∈ support, ‖c n‖ ^ 2 := by
    simp_rw [hvalue]
    exact sparse_dirichlet_polynomial_energy _ point support c N hU hE
      (fun i hi j hj hij => unit_interval_residue_separated (hpoint i) (hpoint j)
        ((Finset.mem_filter.mp hi).2.trans (Finset.mem_filter.mp hj).2.symm) hij)
      (fun i hi j hj => hspan i (Finset.mem_filter.mp hi).1 j (Finset.mem_filter.mp hj).1)
      hkernel
  have hsum := Finset.sum_le_sum (fun r (_ : r ∈ (Finset.univ : Finset (Fin 3))) => hclass r)
  have hcard : (∑ r : Fin 3, ((indices.filter (fun j => unitIntervalResidue j = r)).card : ℝ)) =
      (indices.card : ℝ) := by exact_mod_cast unit_interval_residue_card_sum indices
  have hfiber : (∑ r : Fin 3, ∑ j ∈ indices.filter (fun j => unitIntervalResidue j = r),
      unitIntervalEnergySup F j) = ∑ j ∈ indices, unitIntervalEnergySup F j :=
    Finset.sum_fiberwise_of_maps_to (fun _ _ => Finset.mem_univ _) _
  rw [hfiber, ← Finset.sum_mul, Finset.sum_add_distrib] at hsum
  simp_rw [← Finset.sum_mul] at hsum
  rw [hcard] at hsum
  simpa only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
    Nat.cast_ofNat, mul_assoc] using hsum

end Bounty
end

section

namespace Bounty

theorem affine_logarithmic_phase_hasDerivAt
    (q a u x : ℝ) (hq : 0 < q) (hx : 0 < x+a/q) :
    HasDerivAt (fun y => u * Real.log (q*y+a))
      (logarithmicDerivativeChain u (a/q) 1 x) x := by
  have heq : q*x+a = q*(x+a/q) := by field_simp
  have hpos : 0 < q*x+a := by rw [heq]; positivity
  have h := ((((hasDerivAt_id x).const_mul q).add_const a).log (ne_of_gt hpos)).const_mul u
  simp only [logarithmicDerivativeChain, pow_zero, Nat.factorial_zero, Nat.cast_one,
    mul_one, Nat.zero_add, pow_one]
  simp only [id_eq, mul_one] at h
  apply h.congr_deriv
  rw [heq]
  field_simp

theorem mixed_affine_logarithmic_phase_derivatives
    (hs : List ℝ) (q a u x : ℝ) (hq : 0 < q)
    (hhs : ∀ h ∈ hs, 0 ≤ h) (hx : 0 < x+a/q) :
    HasDerivAt (mixedForwardDifference hs (fun y => u * Real.log (q*y+a)))
      (mixedForwardDifference hs (logarithmicDerivativeChain u (a/q) 1) x) x ∧
    HasDerivAt (mixedForwardDifference hs (logarithmicDerivativeChain u (a/q) 1))
      (mixedForwardDifference hs (logarithmicDerivativeChain u (a/q) 2) x) x := by
  constructor
  · apply mixed_forward_difference_hasDerivAt hs _ _ (-(a/q)) hhs
    · intro y hy
      exact affine_logarithmic_phase_hasDerivAt q a u y hq (by linarith)
    · linarith
  · exact mixed_logarithmic_difference_hasDerivAt hs u (a/q) 1 x hhs hx

end Bounty
end

section

open Finset

namespace Bounty

theorem integer_phase_iterated_van_der_corput
    (A B H : ℤ) (m : ℕ) (T : ℝ) (φ : ℝ → ℝ)
    (hAB : A ≤ B) (hH : 1 ≤ H) (hHN : H ≤ B-A+1) (hT : 0 ≤ T)
    (hterminal : ∀ hs : List ℤ, hs.length = m →
      (∀ h ∈ hs, 1 ≤ h ∧ h < H) →
      ∀ a b : ℤ, A ≤ a → b ≤ B →
      ‖∑ n ∈ Icc a b, Complex.exp
        ((mixedForwardDifference (hs.map (fun h : ℤ => (h:ℝ))) φ (n:ℝ):ℂ)*Complex.I)‖ ≤
        ((B-A+1:ℤ):ℝ)*T) :
    ∀ a b : ℤ, A ≤ a → b ≤ B →
      ‖∑ n ∈ Icc a b, Complex.exp ((φ (n:ℝ):ℂ)*Complex.I)‖ ≤
        ((B-A+1:ℤ):ℝ)*vanDerCorputScalarBound (H:ℝ) T m := by
  induction m generalizing φ with
  | zero =>
    intro a b ha hb
    simpa only [List.length_nil, List.map_nil, mixedForwardDifference,
      vanDerCorputScalarBound] using hterminal [] rfl (by simp) a b ha hb
  | succ m ih =>
    intro a b ha hb
    let N : ℝ := ((B-A+1:ℤ):ℝ)
    let V : ℝ := vanDerCorputScalarBound (H:ℝ) T m
    have hN : 0 < N := by dsimp only [N]; exact_mod_cast (by omega : 0 < B-A+1)
    have hHr : 0 < (H:ℝ) := by exact_mod_cast (by omega : 0 < H)
    have hV : 0 ≤ V := van_der_corput_scalar_bound_nonneg _ _ hT _
    have hdiff (h : ℤ) (hh : h ∈ Icc (1:ℤ) (H-1)) :
        ‖∑ n ∈ Icc a (b-h), Complex.exp
          (((φ ((n:ℝ)+(h:ℝ))-φ (n:ℝ)):ℂ)*Complex.I)‖ ≤ N*V := by
      simp only [← Complex.ofReal_sub]
      apply ih (φ := fun x => φ (x+(h:ℝ))-φ x)
      · intro hs hlen hshifts c d hc hd
        have hlen' : (hs++[h]).length = m+1 := by simp [hlen]
        have hshifts' : ∀ k ∈ hs++[h], 1 ≤ k ∧ k < H := by
          intro k hk
          rcases List.mem_append.mp hk with hk | hk
          · exact hshifts k hk
          · have heq : k = h := by simpa using hk
            subst k
            have hh' := mem_Icc.mp hh
            omega
        have he := hterminal (hs++[h]) hlen' hshifts' c d hc hd
        simpa only [List.map_append, List.map_cons, List.map_nil,
          mixed_forward_difference_append, mixedForwardDifference] using he
      · exact ha
      · have hh' := mem_Icc.mp hh
        omega
    have hsumbound :
        (∑ h ∈ Icc (1:ℤ) (H-1), ‖∑ n ∈ Icc a (b-h), Complex.exp
          (((φ ((n:ℝ)+(h:ℝ))-φ (n:ℝ)):ℂ)*Complex.I)‖) ≤ (H:ℝ)*(N*V) := by
      calc
        _ ≤ ∑ _h ∈ Icc (1:ℤ) (H-1), N*V := sum_le_sum hdiff
        _ = ((H:ℝ)-1)*(N*V) := by
          rw [sum_const, nsmul_eq_mul]
          congr 1
          have hc := Int.card_Icc_of_le (a := 1) (b := H-1) (by omega)
          have heq : H-1+1-1 = H-1 := by ring
          rw [heq] at hc
          exact_mod_cast hc
        _ ≤ (H:ℝ)*(N*V) := by nlinarith
    have hvdc := integer_phase_van_der_corput_subinterval A B a b H φ hAB ha hb hH hHN
    have hsq : ‖∑ n ∈ Icc a b, Complex.exp ((φ (n:ℝ):ℂ)*Complex.I)‖^2 ≤
        N^2*(2/(H:ℝ)+4*V) := by
      calc
        _ ≤ 2*N^2/(H:ℝ)+(4*N/(H:ℝ))*((H:ℝ)*(N*V)) :=
          hvdc.trans (add_le_add le_rfl (mul_le_mul_of_nonneg_left hsumbound (by positivity)))
        _ = _ := by field_simp
    have hbase : 0 ≤ 2/(H:ℝ)+4*V := by positivity
    have hsqrt : (N*Real.sqrt (2/(H:ℝ)+4*V))^2 = N^2*(2/(H:ℝ)+4*V) := by
      rw [mul_pow, Real.sq_sqrt hbase]
    have hnonneg : 0 ≤ N*Real.sqrt (2/(H:ℝ)+4*V) := by positivity
    change _ ≤ N*Real.sqrt (2/(H:ℝ)+4*V)
    nlinarith [norm_nonneg (∑ n ∈ Icc a b, Complex.exp ((φ (n:ℝ):ℂ)*Complex.I))]

end Bounty
end

section

/- Prime divisibility after removing the actual shared product. -/

open Finset

namespace Bounty

theorem physical_prime_dvd_shared_factor {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (p : PhysicalPrime P) :
    p.2.val ∣ physicalSharedFactor C L ↔ p ∈ physicalSharedPrimes C L := by
  classical
  have hp := hprime p.1 _ p.2.property
  constructor
  · intro hd
    obtain ⟨a, _, ha⟩ := (hp.prime.dvd_finsetProd_iff _).mp hd
    have he : p.2.val = (L a.1 (Sum.inl a.2.val)).val :=
      ((Nat.dvd_prime (hprime a.1 _ (L a.1 (Sum.inl a.2.val)).property)).mp ha).resolve_left hp.ne_one
    have htag : p = ⟨a.1, L a.1 (Sum.inl a.2.val)⟩ :=
      physical_prime_value_injective hdis he
    rw [htag, mem_physical_shared_primes]
    exact ⟨Sum.inl a.2.val,
      (physical_mem_shared_slots_iff _ _).mpr ⟨a.2.val, (mem_sdiff.mp a.2.property).2, rfl⟩, rfl⟩
  · intro hm
    obtain ⟨s, hs, he⟩ := (mem_physical_shared_primes C L p).mp hm
    obtain ⟨j, hj, rfl⟩ := (physical_mem_shared_slots_iff _ _).mp hs
    rw [← he]
    exact dvd_prod_of_mem (fun a : PhysicalSharedIndex C => (L a.1 (Sum.inl a.2.val)).val)
      (mem_univ ⟨p.1, ⟨j, mem_sdiff.mpr ⟨mem_univ _, hj⟩⟩⟩)

theorem physical_prime_dvd_shared_mul {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (p : PhysicalPrime P) (w : ℤ) :
    (p.2.val : ℤ) ∣ (physicalSharedFactor C L : ℤ) * w ↔
      p ∈ physicalSharedPrimes C L ∨ (p.2.val : ℤ) ∣ w := by
  rw [(Nat.prime_iff_prime_int.mp (hprime p.1 _ p.2.property)).dvd_mul,
    Int.natCast_dvd_natCast, physical_prime_dvd_shared_factor C L hprime hdis]

end Bounty
end

section

/- Extracted prime sums as literal four-factor divisor convolutions. -/

open Finset

namespace Bounty

noncomputable def endpointFourConvolution (δ α β γ : ℕ → ℂ) (n : ℕ) : ℂ :=
  ∑ d ∈ n.divisors, δ d * endpointTripleConvolution α β γ (n / d)

theorem prime_sum_eq_divisor_convolution (S : Finset ℕ) (δ f : ℕ → ℂ)
    {n : ℕ} (hn : n ≠ 0) :
    (∑ p ∈ S, if p ∣ n then δ p * f (n / p) else 0) =
      ∑ p ∈ n.divisors, (if p ∈ S then δ p else 0) * f (n / p) := by
  classical
  have hs : S.filter (fun p => p ∣ n) = n.divisors.filter (fun p => p ∈ S) := by
    ext p
    constructor
    · intro h
      obtain ⟨hp, hd⟩ := mem_filter.mp h
      exact mem_filter.mpr ⟨Nat.mem_divisors.mpr ⟨hd, hn⟩, hp⟩
    · intro h
      obtain ⟨hd, hp⟩ := mem_filter.mp h
      exact mem_filter.mpr ⟨hp, (Nat.mem_divisors.mp hd).1⟩
  rw [← sum_filter, hs, sum_filter]
  simp only [ite_mul, zero_mul]

theorem prime_peel_weighted_triple_convolution (S Q : Finset ℕ) (δ W α β γ : ℕ → ℂ)
    (hW : ∀ a d : ℕ, d ≠ 0 → Disjoint d.primeFactors Q → W (a * d) = W a)
    (hα : ∀ d, ¬ Disjoint d.primeFactors Q → α d = 0)
    (hβ : ∀ d, ¬ Disjoint d.primeFactors Q → β d = 0)
    {n : ℕ} (hn : n ≠ 0) :
    (∑ p ∈ S, if p ∣ n then δ p *
      (W (n / p) * invariantTripleEndpoint Q α β γ (n / p)) else 0) =
      endpointFourConvolution (fun p => if p ∈ S then δ p else 0) α β
        (fun r => W r * γ (primePoolFreePart Q r)) n := by
  classical
  unfold endpointFourConvolution
  rw [← prime_sum_eq_divisor_convolution S δ _ hn]
  apply sum_congr rfl
  intro p _
  by_cases hp : p ∣ n
  · rw [if_pos hp, if_pos hp]
    congr 1
    apply weighted_invariant_triple_convolution Q W α β γ hW hα hβ
    intro hz
    have he := Nat.mul_div_cancel' hp
    rw [hz, mul_zero] at he
    exact hn he.symm
  · rw [if_neg hp, if_neg hp]

end Bounty
end

section

/- The actual prime-polynomial exceptional set is measurable and covered
by exactly the occupied unit intervals used in its counting theorem. -/

open Finset Set MeasureTheory
open scoped Classical

namespace Bounty

theorem prime_exceptional_times_measurable (s : Finset ℕ) (coeff : s → ℂ)
    (η R : ℝ) : MeasurableSet (primeExceptionalTimes s coeff η R) := by
  have hp : Continuous (primeReciprocalPolynomial s coeff) := by
    unfold primeReciprocalPolynomial
    fun_prop
  exact (isClosed_le continuous_abs continuous_const).measurableSet.inter
    (isOpen_lt continuous_const hp.norm).measurableSet

theorem prime_exceptional_times_covered (s : Finset ℕ) (coeff : s → ℂ)
    (η R : ℝ) :
    ∀ t ∈ primeExceptionalTimes s coeff η R,
      ∃ j ∈ primeExceptionalIntervals s coeff η R,
        t ∈ Icc (j : ℝ) ((j : ℝ) + 1) := by
  intro t ht
  have hunit : t ∈ Icc ((⌊t⌋ : ℤ) : ℝ) (((⌊t⌋ : ℤ) : ℝ) + 1) :=
    ⟨Int.floor_le t, (Int.lt_floor_add_one t).le⟩
  refine ⟨⌊t⌋, ?_, hunit⟩
  exact (mem_primeExceptionalIntervals s coeff η R ⌊t⌋).mpr ⟨t, hunit, ht⟩

theorem prime_exceptional_energy_integrable (s : Finset ℕ) (coeff : s → ℂ)
    (η R : ℝ) (F : ℝ → ℂ) (hF : Continuous F) :
    IntegrableOn (fun t => ‖F t‖ ^ 2) (primeExceptionalTimes s coeff η R) :=
  (unit_interval_cover_energy (primeExceptionalIntervals s coeff η R)
    (primeExceptionalTimes s coeff η R) (prime_exceptional_times_measurable s coeff η R)
    F hF (prime_exceptional_times_covered s coeff η R)).1

theorem prime_exceptional_integral_le_unit_suprema (s : Finset ℕ) (coeff : s → ℂ)
    (η R : ℝ) (F : ℝ → ℂ) (hF : Continuous F) :
    (∫ t in primeExceptionalTimes s coeff η R, ‖F t‖ ^ 2) ≤
      ∑ j ∈ primeExceptionalIntervals s coeff η R, unitIntervalEnergySup F j :=
  exceptional_integral_le_unit_suprema (primeExceptionalIntervals s coeff η R)
    (primeExceptionalTimes s coeff η R) (prime_exceptional_times_measurable s coeff η R)
    F hF (prime_exceptional_times_covered s coeff η R)

end Bounty
end

section

/- A global norm bound for the literal reciprocal prime polynomial. -/

open Finset

namespace Bounty

theorem prime_reciprocal_polynomial_norm_le (s : Finset ℕ) (coeff : s → ℂ)
    {P B : ℝ} (hP : 1 ≤ P) (hB : 0 ≤ B)
    (hband : ∀ p ∈ s, P ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2 * P)
    (hcoeff : ∀ p : s, ‖coeff p‖ ≤ B) (t : ℝ) :
    ‖primeReciprocalPolynomial s coeff t‖ ≤ 2 * B := by
  have hP0 : 0 < P := zero_lt_one.trans_le hP
  unfold primeReciprocalPolynomial
  calc
    _ ≤ ∑ p : s, ‖(coeff p / (p.val : ℂ)) *
        Complex.exp (((Real.log (p.val : ℝ) * t : ℝ) : ℂ) * Complex.I)‖ := norm_sum_le _ _
    _ ≤ ∑ _p : s, B / P := by
      apply Finset.sum_le_sum
      intro p _
      rw [norm_mul, Complex.norm_exp_ofReal_mul_I, mul_one, norm_div, Complex.norm_natCast]
      exact div_le_div₀ hB (hcoeff p) hP0 (hband p.val p.property).1
    _ = (s.card : ℝ) * (B / P) := by simp
    _ ≤ (2 * P) * (B / P) :=
      mul_le_mul_of_nonneg_right (nat_dyadic_card_le s P hP hband) (div_nonneg hB hP0.le)
    _ = 2 * B := by field_simp

end Bounty
end

section

/- Unit-size character, phase and cutoff factors preserve the global power bound. -/

open Finset Filter

namespace Bounty

theorem eventually_twisted_dyadic_mellin_zeta_power_norm (c E : ℝ) (k : ℕ) :
    ∀ᶠ L : ℝ in atTop, ∀ (S : Finset ℕ) (f : ℕ → ℂ) (θ : ℝ → ℕ → ℂ) (U B : ℝ),
      1 ≤ U → Real.log U ≤ c*L → 0 ≤ B → B ≤ L^E →
      (∀ n ∈ S, U ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*U) →
      (∀ n ∈ S, ‖f n‖ ≤ B*((ArithmeticFunction.zeta^(k+1)) n : ℝ)) →
      (∀ u n, n ∈ S → ‖θ u n‖ ≤ 1) →
      ∀ u : ℝ, ‖∑ n ∈ S, harmonicMellinWeight u n*(f n*θ u n)‖ ≤ L^(E+(k:ℝ)+1) := by
  filter_upwards [eventually_finite_dyadic_mellin_zeta_power_norm c E k] with L hL
  intro S f θ U B hU hlog hB hBL hS hf hθ u
  apply hL S (fun n => f n*θ u n) U B hU hlog hB hBL hS _ u
  intro n hn
  calc
    ‖f n*θ u n‖ = ‖f n‖*‖θ u n‖ := norm_mul _ _
    _ ≤ ‖f n‖*1 := mul_le_mul_of_nonneg_left (hθ u n hn) (norm_nonneg _)
    _ ≤ _ := by simpa only [mul_one] using hf n hn

end Bounty
end

section

/- The actual normalized small-prime factor, including arbitrary unit phases. -/

open Finset Filter

namespace Bounty

theorem prime_reciprocal_polynomial_eq_harmonic_sum
    (s : Finset ℕ) (δ : ℕ → ℂ) (u : ℝ) :
    primeReciprocalPolynomial s (fun p => δ p.val) u =
      ∑ p ∈ s, δ p*harmonicMellinWeight u p := by
  unfold primeReciprocalPolynomial
  rw [← sum_coe_sort s (fun p => δ p*harmonicMellinWeight u p)]
  apply sum_congr rfl
  intro p _
  unfold harmonicMellinWeight
  have he : ((Real.log (p.val : ℝ)*u : ℝ) : ℂ)*Complex.I =
      Complex.I*((u*Real.log (p.val : ℝ) : ℝ) : ℂ) := by push_cast; ring
  rw [he]
  push_cast
  ring

theorem exists_candidate_small_prime_factor_data {c : ℝ} (hc : 0 < c) :
    ∃ Bcoeff : ℝ, 1 ≤ Bcoeff ∧ ∀ᶠ L : ℝ in atTop,
      ∀ g ∈ candidateSmallPIndices c L, ∀ (s : Finset ℕ) (P : ℝ),
      s ⊆ candidatePBand (c*L) g → s.Nonempty →
      (∀ p ∈ s, P ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2*P) →
      (∀ p ∈ s, p.Prime) ∧
      Real.exp (L^(1/10 : ℝ))/2 ≤ P ∧ P ≤ Real.exp (L^(1/5 : ℝ)) ∧
      ∀ θ : ℕ → ℂ, (∀ p ∈ s, ‖θ p‖ ≤ 1) →
        ∀ p : s, ‖(1 / (((∑ p ∈ candidatePBand (c*L) g, 1/(p : ℝ)) : ℝ) : ℂ))*θ p.val‖ ≤ Bcoeff := by
  obtain ⟨v,V,hv,_,hgroups⟩ := eventually_candidate_P_groups
    (α := (1/10 : ℝ)) (β := (1/5 : ℝ)) hc (by norm_num) (by norm_num) (by norm_num)
  refine ⟨max 1 (1/v),le_max_left _ _,?_⟩
  filter_upwards [hgroups] with L hg
  intro g hgin s P hs hne hband
  have hdata := hg.2.2.2 g hgin
  obtain ⟨p,hp⟩ := hne
  have hpdata := hdata.2.2 p (hs hp)
  have hpband := hband p hp
  refine ⟨(fun p hp => (hdata.2.2 p (hs hp)).1),by linarith [hpdata.2.1],
    hpband.1.trans hpdata.2.2,?_⟩
  intro θ hθ p
  have hmass := hdata.1
  have hmasspos : 0 < ∑ p ∈ candidatePBand (c*L) g, 1/(p : ℝ) := hv.trans_le hmass
  rw [norm_mul,norm_div,norm_one,Complex.norm_real,Real.norm_eq_abs,abs_of_pos hmasspos]
  calc
    _ ≤ 1/v*1 := mul_le_mul (one_div_le_one_div_of_le hv hmass) (hθ p.val p.property)
      (norm_nonneg _) (by positivity)
    _ ≤ max 1 (1/v) := by simpa only [mul_one] using le_max_right 1 (1/v)

end Bounty
end

section

/- Exact finite pullback along multiplication, with a constructed finite cutoff. -/

open Finset
open scoped Classical
namespace Bounty

theorem integer_scaled_position_sum {s : ℤ} (hs : s ≠ 0)
    (Z positions : Finset ℤ) (hcover : ∀ z ∈ Z, s * z ∈ positions) (F : ℤ → ℂ) :
    (∑ n ∈ positions, if s ∣ n ∧ n / s ∈ Z then F (n / s) else 0) =
      ∑ z ∈ Z, F z := by
  have hsub : Z.image (fun z => s * z) ⊆ positions := by
    intro n hn
    obtain ⟨z, hz, rfl⟩ := mem_image.mp hn
    exact hcover z hz
  have ho : ∀ n ∈ positions, n ∉ Z.image (fun z => s * z) →
      (if s ∣ n ∧ n / s ∈ Z then F (n / s) else 0) = 0 := by
    intro n _ hn
    apply if_neg
    rintro ⟨hd, hz⟩
    exact hn (mem_image.mpr ⟨n / s, hz, Int.mul_ediv_cancel' hd⟩)
  rw [← sum_subset hsub ho]
  rw [sum_image]
  · apply sum_congr rfl
    intro z hz
    have he : s * z / s = z := by exact Int.mul_ediv_cancel_left z hs
    rw [he, if_pos ⟨dvd_mul_right s z, hz⟩]
  · intro a _ b _ hab
    exact mul_left_cancel₀ hs hab

noncomputable def physicalScaledPositionClosure {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {J : ℕ} (C : G → Finset (Fin J)) (ell : ℕ)
    (Z : Finset ℤ) : Finset ℤ :=
  univ.biUnion (fun L : PhysicalMarkLists P J ell =>
    Z.image (fun z => (physicalSharedFactor C L : ℤ) * z))

theorem physical_scaled_position_mem {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {J ell : ℕ} (C : G → Finset (Fin J))
    (Z : Finset ℤ) (L : PhysicalMarkLists P J ell) {z : ℤ} (hz : z ∈ Z) :
    (physicalSharedFactor C L : ℤ) * z ∈ physicalScaledPositionClosure P C ell Z := by
  exact mem_biUnion.mpr ⟨L, mem_univ _, mem_image.mpr ⟨z, hz, rfl⟩⟩

theorem physical_scaled_position_sum {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {J ell : ℕ} (C : G → Finset (Fin J))
    (hprime : ∀ g p, p ∈ P g → p.Prime) (Z : Finset ℤ)
    (L : PhysicalMarkLists P J ell) (F : ℤ → ℂ) :
    (∑ n ∈ physicalScaledPositionClosure P C ell Z,
      if (physicalSharedFactor C L : ℤ) ∣ n ∧ n / physicalSharedFactor C L ∈ Z
        then F (n / physicalSharedFactor C L) else 0) = ∑ z ∈ Z, F z := by
  apply integer_scaled_position_sum
  · exact_mod_cast (physical_shared_factor_pos C L hprime).ne'
  · exact fun z hz => physical_scaled_position_mem P C Z L hz

end Bounty
end

section

/- Exact shared and unshared coordinates for the original marked slots. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def physicalCutSlotMap {J ell : ℕ} (C : Finset (Fin J)) :
    ↥(univ \ C) ⊕ Fin (ell + C.card) → PhysicalSlots J ell :=
  Sum.elim (fun j => Sum.inl j.val) (fun j => (physicalGroupUnsharedIndex C j).val)

theorem physical_cut_slot_map_bijective {J ell : ℕ} (C : Finset (Fin J)) :
    Function.Bijective (physicalCutSlotMap (ell := ell) C) := by
  constructor
  · intro a b hab
    cases a with
    | inl a =>
      cases b with
      | inl b =>
        exact congrArg Sum.inl (Subtype.ext (Sum.inl.inj hab))
      | inr b =>
        have hs : Sum.inl a.val ∈ physicalSharedSlots (ell := ell) C :=
          (physical_mem_shared_slots_iff C _).mpr ⟨a.val, (mem_sdiff.mp a.property).2, rfl⟩
        have hn := (physicalGroupUnsharedIndex (ell := ell) C b).property
        change Sum.inl a.val = (physicalGroupUnsharedIndex C b).val at hab
        rw [hab] at hs
        exact False.elim ((mem_compl.mp hn) hs)
    | inr a =>
      cases b with
      | inl b =>
        have hs : Sum.inl b.val ∈ physicalSharedSlots (ell := ell) C :=
          (physical_mem_shared_slots_iff C _).mpr ⟨b.val, (mem_sdiff.mp b.property).2, rfl⟩
        have hn := (physicalGroupUnsharedIndex (ell := ell) C a).property
        change (physicalGroupUnsharedIndex C a).val = Sum.inl b.val at hab
        rw [← hab] at hs
        exact False.elim ((mem_compl.mp hn) hs)
      | inr b =>
        exact congrArg Sum.inr ((physicalGroupUnsharedIndex C).injective (Subtype.ext hab))
  · intro s
    by_cases hs : s ∈ physicalSharedSlots (ell := ell) C
    · obtain ⟨j, hj, rfl⟩ := (physical_mem_shared_slots_iff C s).mp hs
      exact ⟨Sum.inl ⟨j, mem_sdiff.mpr ⟨mem_univ _, hj⟩⟩, rfl⟩
    · have hu : s ∈ physicalUnsharedSlots (ell := ell) C := mem_compl.mpr hs
      refine ⟨Sum.inr ((physicalGroupUnsharedIndex C).symm ⟨s, hu⟩), ?_⟩
      exact congrArg Subtype.val ((physicalGroupUnsharedIndex C).apply_symm_apply ⟨s, hu⟩)

noncomputable def physicalCutSlotEquiv {J ell : ℕ} (C : Finset (Fin J)) :
    ↥(univ \ C) ⊕ Fin (ell + C.card) ≃ PhysicalSlots J ell :=
  Equiv.ofBijective (physicalCutSlotMap C) (physical_cut_slot_map_bijective C)

theorem physical_cut_slot_equiv_shared {J ell : ℕ} (C : Finset (Fin J))
    (j : ↥(univ \ C)) : physicalCutSlotEquiv (ell := ell) C (Sum.inl j) = Sum.inl j.val := rfl

theorem physical_cut_slot_equiv_unshared {J ell : ℕ} (C : Finset (Fin J))
    (j : Fin (ell + C.card)) :
    physicalCutSlotEquiv C (Sum.inr j) = (physicalGroupUnsharedIndex C j).val := rfl

end Bounty
end

section

/- Shared-coordinate independence of a prime coefficient does not remove
the original auxiliary exclusions from the surrounding physical edge. -/

open Finset Classical
namespace Bounty

theorem physical_aux_avoids_shared_unshared_iff
    {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (L : PhysicalMarkLists P J ell) :
    physicalAuxAvoids C aux L ↔
      (∀ g (j : C g) (s : ↥(univ \ C g)), aux g j ≠ L g (Sum.inl s.val)) ∧
      (∀ g (j : C g) (u : Fin (ell + (C g).card)),
        aux g j ≠ physicalGroupUnsharedEmbedding C L g u) := by
  constructor
  · intro h
    exact ⟨fun g j s => h g j (Sum.inl s.val),
      fun g j u => h g j (physicalGroupUnsharedIndex (C g) u).val⟩
  · rintro ⟨hs, hu⟩ g j s
    by_cases hmem : s ∈ physicalUnsharedSlots (C g)
    · intro he
      exact hu g j ((physicalGroupUnsharedIndex (C g)).symm ⟨s, hmem⟩)
        (he.trans (physical_unshared_coordinate_embedding C L g s hmem).symm)
    · have hshared : s ∈ physicalSharedSlots (C g) := by
        simpa only [physicalUnsharedSlots, mem_compl, not_not] using hmem
      obtain ⟨v, hv, rfl⟩ := (physical_mem_shared_slots_iff (C g) s).mp hshared
      exact hs g j ⟨v, mem_sdiff.mpr ⟨mem_univ _, hv⟩⟩

end Bounty
end

section

/- Arbitrary power saving for the actual shared-draw error, uniformly over
cuts, harmonic masses, and logarithmic list lengths. -/

open Finset Filter
open scoped Classical
namespace Bounty

theorem eventually_physical_shared_error_decay {c v A B : ℝ} (hc : 0 < c) (hv : 0 < v) (hA : 0 ≤ A) (hB : 0 ≤ B)
    (E D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (G : Type*) [Fintype G] (J : ℕ) (C : G → Finset (Fin J)) (V : G → ℝ)
      (T H Pmin : ℝ),
      (∀ g, v ≤ V g) → (J * Fintype.card G : ℕ) ≤ A * Real.log L →
      0 ≤ T → T ≤ B * L → 0 ≤ H → H ≤ L ^ E → Real.exp (L ^ c) ≤ Pmin →
      (∑ g : G, (J - (C g).card : ℕ) * T / (V g * Pmin)) *
        (H + H / (1 / 2 : ℝ) ^ (2 * ∑ g : G, (J - (C g).card))) ≤ L ^ (-D) := by
  let e : ℝ := A * Real.log 4
  let C0 : ℝ := A * B / v
  have hC0 : 0 ≤ C0 := by dsimp only [C0]; positivity
  filter_upwards [eventually_polynomial_div_exp_power hc (2*C0) (2+E+e) D,
    eventually_ge_atTop (1 : ℝ)] with L hdec hL
  intro G _ J C V T H Pmin hV hJ hT hTL hH hHL hPmin
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hP0 : 0 < Pmin := (Real.exp_pos _).trans_le hPmin
  have hJL : ((J * Fintype.card G : ℕ) : ℝ) ≤ A * L :=
    hJ.trans (mul_le_mul_of_nonneg_left (Real.log_le_self hL0.le) hA)
  have hδ : (∑ g : G, (J - (C g).card : ℕ) * T / (V g * Pmin)) ≤
      C0 * L^2 / Real.exp (L^c) := by
    calc
      _ ≤ (Fintype.card G : ℝ) * J * T / (v * Pmin) :=
        physical_shared_error_uniform_bound C V hv hP0 hT hV
      _ ≤ (A*L) * (B*L) / (v * Real.exp (L^c)) := by
        have hjn : (Fintype.card G : ℝ) * J ≤ A*L := by
          simpa only [Nat.cast_mul, mul_comm] using hJL
        apply div_le_div₀ (by positivity)
          (mul_le_mul hjn hTL hT (by positivity))
          (mul_pos hv (Real.exp_pos _))
          (mul_le_mul_of_nonneg_left hPmin hv.le)
      _ = _ := by dsimp only [C0]; field_simp
  have hother : H + H / (1 / 2 : ℝ) ^ (2 * ∑ g : G, (J - (C g).card)) ≤
      2 * L^E * L^e := by
    calc
      _ ≤ 2 * H * (4 : ℝ) ^ (J * Fintype.card G) := physical_shared_half_overlap_bound C hH
      _ ≤ 2 * L^E * L^e :=
        mul_le_mul (mul_le_mul_of_nonneg_left hHL (by norm_num))
          (by simpa only [Nat.mul_one, Nat.cast_one, mul_one] using
            (four_pow_length_le_rpow (n := 1) hL0 hJ)) (by positivity) (by positivity)
  calc
    _ ≤ (C0 * L^2 / Real.exp (L^c)) * (2 * L^E * L^e) :=
      mul_le_mul hδ hother (by positivity) (by positivity)
    _ = (2*C0) * L^(2+E+e) / Real.exp (L^c) := by
      rw [Real.rpow_add hL0, Real.rpow_add hL0, Real.rpow_two]
      ring
    _ ≤ _ := hdec

end Bounty
end

section

/- Vertex weights are insensitive to the sign of the integer position. -/

open Finset
namespace Bounty

theorem physical_vertex_weight_natAbs
    {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    (L : PhysicalMarkLists P J ell) (q : ℝ) (n : ℤ) :
    physicalVertexWeight L q (n.natAbs : ℤ) = physicalVertexWeight L q n := by
  classical
  simp only [physicalVertexWeight, physicalOmega, physicalDivisorPool, Int.dvd_natAbs]

theorem physical_vertex_weight_scaled_natAbs
    {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    (L : PhysicalMarkLists P J ell) (q : ℝ) (s : ℕ) (n : ℤ) :
    physicalVertexWeight L q ((s : ℤ) * (n.natAbs : ℤ)) =
      physicalVertexWeight L q ((s : ℤ) * n) := by
  simpa only [Int.natAbs_mul, Int.natAbs_natCast, Nat.cast_mul] using
    physical_vertex_weight_natAbs L q ((s : ℤ) * n)

