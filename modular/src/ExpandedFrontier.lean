/- The high-rank tail of the actual original complex forest-masked path actions. -/

open Finset Classical

namespace Bounty

section Owner
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
    [∀ g, DecidableEq (P g)] {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
    (Δ D : ∀ k c, A k c → Fin N → ℤ) (ω : ∀ k c, A k c → ℝ)
    (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ v vmin : ℝ) (V η : Fin N → ℝ) (β : ℝ)
    (steps : List (Option (J ⊕ K)))

theorem full_mixed_common_original_high_rank_tail
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hη : ∀ g, 0 ≤ η g) (hμatom : ∀ g p, μ g p ≤ η g)
    (hβ : 0 ≤ β)
    (hghostAtom : ∀ j g, (|(1 - q j) * V g / ρ| * η g) * v ≤ β)
    (hedgeAtom : ∀ g, η g ≤ β)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : ∀ g, vmin ≤ V g)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (phase : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)) →
      ∀ s, FullPermutationMixedPath n S B A Δ D steps s → ℂ)
    (hphase : ∀ code s p, ‖phase code s p‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (hx : FullActiveInjective s)
    {L : ℝ} (hL : 0 ≤ L) (hf : ∀ y, ‖f y‖ ≤ L) (r₀ : ℕ)
    (hδ : (Fintype.card (FullMixedCommonBirthAddress M B steps) : ℝ) ^ 2 * β < 1) :
    ‖∑ code ∈ (univ : Finset (BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))).filter
        (fun code => r₀ ≤ birthForestRank code),
      (-1 : ℂ) ^ birthForestRank code *
        fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps
          (fun s p => if birthForestCompatible
            (fun i => fullMixedCommonBirthPerformed n S B A Δ D steps s p (fullMixedCommonBirthOrder M B steps i))
            (fun i => fullMixedCommonBirthLabel n S B A Δ D steps s p (fullMixedCommonBirthOrder M B steps i)) code
            then phase code s p else 0) f s‖ ≤
      ((steps.map (fullMixedLengthRowFactor μ q ρ v vmin V T)).prod * (L * productLengthLyapunov v s)) *
        ((Fintype.card (FullMixedCommonBirthAddress M B steps) : ℝ) ^ 2 * β) ^ r₀ / (1 - ((Fintype.card (FullMixedCommonBirthAddress M B steps) : ℝ) ^ 2 * β)) := by
  have hroot : 0 ≤ (steps.map (fullMixedLengthRowFactor μ q ρ v vmin V T)).prod := by
    apply List.prod_nonneg
    intro x hx
    obtain ⟨tag, _, rfl⟩ := List.mem_map.mp hx
    exact fullMixedLengthRowFactor_nonneg μ q ρ v vmin V T hρ1 (zero_lt_one.trans hv).le tag
  apply birthForest_rank_tail_norm_le _ r₀
    (mul_nonneg hroot (mul_nonneg hL (productLengthLyapunov_nonneg (zero_lt_one.trans hv).le s))) hβ hδ
  intro code _
  exact (full_mixed_common_masked_path_norm_le_rank n S B A Δ D ω μ q ρ v vmin V η β steps code
    hω hωmass hμ hmass hη hμatom hβ hghostAtom hedgeAtom hq0 hq1 hρ0 hρ1 hv hvmin hV hD T ht
    (phase code) (hphase code) f s hx hL hf).trans_eq (by ring)

theorem full_mixed_common_empty_original_high_rank_tail
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hη : ∀ g, 0 ≤ η g) (hμatom : ∀ g p, μ g p ≤ η g)
    (hβ : 0 ≤ β)
    (hghostAtom : ∀ j g, (|(1 - q j) * V g / ρ| * η g) * v ≤ β)
    (hedgeAtom : ∀ g, η g ≤ β)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : ∀ g, vmin ≤ V g)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (phase : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)) →
      ∀ s, FullPermutationMixedPath n S B A Δ D steps s → ℂ)
    (hphase : ∀ code s p, ‖phase code s p‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (hx : FullActiveInjective s)
    {L : ℝ} (hL : 0 ≤ L) (hf : ∀ y, ‖f y‖ ≤ L) (r₀ : ℕ)
    (hδ : (Fintype.card (FullMixedCommonBirthAddress M B steps) : ℝ) ^ 2 * β < 1)
    (hs : productTotalMemory s = 0) :
    ‖∑ code ∈ (univ : Finset (BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))).filter
        (fun code => r₀ ≤ birthForestRank code),
      (-1 : ℂ) ^ birthForestRank code *
        fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps
          (fun s p => if birthForestCompatible
            (fun i => fullMixedCommonBirthPerformed n S B A Δ D steps s p (fullMixedCommonBirthOrder M B steps i))
            (fun i => fullMixedCommonBirthLabel n S B A Δ D steps s p (fullMixedCommonBirthOrder M B steps i)) code
            then phase code s p else 0) f s‖ ≤
      ((steps.map (fullMixedLengthRowFactor μ q ρ v vmin V T)).prod * L) *
        ((Fintype.card (FullMixedCommonBirthAddress M B steps) : ℝ) ^ 2 * β) ^ r₀ / (1 - ((Fintype.card (FullMixedCommonBirthAddress M B steps) : ℝ) ^ 2 * β)) := by
  simpa only [productLengthLyapunov_empty v s hs, mul_one] using
    full_mixed_common_original_high_rank_tail n S B A Δ D ω μ q ρ v vmin V η β steps
      hω hωmass hμ hmass hη hμatom hβ hghostAtom hedgeAtom hq0 hq1 hρ0 hρ1 hv hvmin hV hD T ht
      phase hphase f s hx hL hf r₀ hδ

