section

/- Uniform and polynomial bounds retain only the genuine visit and edge costs. -/

namespace Bounty

theorem physical_selected_fine_energy_product_le_uniform
    (ρ v vmin vmax : ℝ) (T N n : ℕ) :
    (((List.range (4 * n + 1)).map (physicalSelectedFineTag n)).map
      (fullPermutationMixedStepEnergy ρ v vmin vmax T N)).prod ≤
      mixedMemoryUniformEnergy ρ v vmin vmax T ^ (N * (2 * n + 1)) := by
  have hU : 0 ≤ mixedMemoryUniformEnergy ρ v vmin vmax T :=
    zero_le_one.trans (mixedMemoryUniformEnergy_ge_one ρ v vmin vmax T)
  have hG : physicalGhostUniformEnergyBound ρ vmax v ≤
      mixedMemoryUniformEnergy ρ v vmin vmax T :=
    (le_max_left _ _).trans (le_max_right _ _)
  have hE : unrestrictedEdgeEnergyBound ρ v vmin vmax T ≤
      mixedMemoryUniformEnergy ρ v vmin vmax T :=
    (le_max_right _ _).trans (le_max_right _ _)
  rw [physical_selected_fine_energy_product]
  calc
    _ ≤ mixedMemoryUniformEnergy ρ v vmin vmax T ^ (N * (n + 1)) *
        mixedMemoryUniformEnergy ρ v vmin vmax T ^ (N * n) :=
      mul_le_mul (pow_le_pow_left₀ (Real.exp_pos _).le hG _)
        (pow_le_pow_left₀ (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) hE _)
        (pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _)
        (pow_nonneg hU _)
    _ = _ := by
      rw [← pow_add]
      congr 1
      ring

theorem physical_selected_fine_energy_product_le_rpow
    (ρ v vmin vmax : ℝ) (T N n : ℕ)
    {L A : ℝ} (hL : 0 < L) (hgroups : (N : ℝ) ≤ A * Real.log L) :
    (((List.range (4 * n + 1)).map (physicalSelectedFineTag n)).map
      (fullPermutationMixedStepEnergy ρ v vmin vmax T N)).prod ≤
      L ^ ((2 * n + 1) * A * Real.log (mixedMemoryUniformEnergy ρ v vmin vmax T)) := by
  have hC := mixedMemoryUniformEnergy_ge_one ρ v vmin vmax T
  have hC0 : 0 ≤ mixedMemoryUniformEnergy ρ v vmin vmax T := zero_le_one.trans hC
  have hp : mixedMemoryUniformEnergy ρ v vmin vmax T ^ N ≤
      L ^ (A * Real.log (mixedMemoryUniformEnergy ρ v vmin vmax T)) := by
    simpa only [Finset.prod_const, Finset.card_univ, Fintype.card_fin] using
      group_product_bound_of_log_card (Finset.univ : Finset (Fin N))
        (fun _ => mixedMemoryUniformEnergy ρ v vmin vmax T) hC hL
        (fun _ _ => hC0) (fun _ _ => le_rfl)
        (by simpa only [Finset.card_univ, Fintype.card_fin] using hgroups)
  calc
    _ ≤ mixedMemoryUniformEnergy ρ v vmin vmax T ^ (N * (2 * n + 1)) :=
      physical_selected_fine_energy_product_le_uniform ρ v vmin vmax T N n
    _ = (mixedMemoryUniformEnergy ρ v vmin vmax T ^ N) ^ (2 * n + 1) := pow_mul _ _ _
    _ ≤ (L ^ (A * Real.log (mixedMemoryUniformEnergy ρ v vmin vmax T))) ^ (2 * n + 1) :=
      pow_le_pow_left₀ (pow_nonneg hC0 _) hp _
    _ = _ := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hL.le]
      congr 1
      push_cast
      ring

end Bounty
end

section

/- A complete chronological selection identifies every mark list, permutation and auxiliary draw. -/

open scoped Classical
namespace Bounty

theorem physical_inverse_permutations_injective {G : Type*} {J ell : ℕ} :
    Function.Injective (physicalInversePermutations (G := G) (J := J) (ell := ell)) := by
  intro σ τ h
  funext g
  have hg := congrFun h g
  exact congrArg Equiv.symm hg

section Fine
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J))
  {aux aux' : ∀ j, PhysicalAuxLabels P (C j)}
  {L L' : Fin (n + 1) → PhysicalMarkLists P J ell}
  {σ τ σ' τ' : Fin n → PhysicalPermutations (Fin N) J ell}

theorem physical_selected_fine_data_unique_of_joint_tests
    (h : ∀ i < 4 * n + 1, ∃ (o : PhysicalMarkObservation P ell C)
      (t : PhysicalBoundedMarkState P J ell B),
      physicalSelectedFineTest C aux L σ τ i o t ∧
      physicalSelectedFineTest C aux' L' σ' τ' i o t) :
    aux = aux' ∧ L = L' ∧ σ = σ' ∧ τ = τ' := by
  have hL : L = L' := by
    funext j
    have hj := j.isLt
    have hi : 4 * j.val < 4 * n + 1 := by omega
    obtain ⟨o, t, ha, hb⟩ := h _ hi
    have ha := (physical_selected_fine_test_visit C aux L σ τ j _ _).mp ha
    have hb := (physical_selected_fine_test_visit C aux' L' σ' τ' j _ _).mp hb
    exact ha.2.symm.trans hb.2
  have hσ : σ = σ' := by
    funext j
    have hj := j.isLt
    have hi : 4 * j.val + 1 < 4 * n + 1 := by omega
    obtain ⟨o, t, ha, hb⟩ := h _ hi
    have ha := (physical_selected_fine_test_source_permutation C aux L σ τ j _ _).mp ha
    have hb := (physical_selected_fine_test_source_permutation C aux' L' σ' τ' j _ _).mp hb
    exact Sum.inl.inj (ha.symm.trans hb)
  have hτ : τ = τ' := by
    funext j
    have hj := j.isLt
    have hi : 4 * j.val + 3 < 4 * n + 1 := by omega
    obtain ⟨o, t, ha, hb⟩ := h _ hi
    have ha := (physical_selected_fine_test_target_permutation C aux L σ τ j _ _).mp ha
    have hb := (physical_selected_fine_test_target_permutation C aux' L' σ' τ' j _ _).mp hb
    exact physical_inverse_permutations_injective (Sum.inl.inj (ha.symm.trans hb))
  have haux : aux = aux' := by
    funext j
    have hj := j.isLt
    have hi : 4 * j.val + 2 < 4 * n + 1 := by omega
    obtain ⟨o, t, ha, hb⟩ := h _ hi
    have ha := (physical_selected_fine_test_edge C aux L σ τ j _ _).mp ha
    have hb := (physical_selected_fine_test_edge C aux' L' σ' τ' j _ _).mp hb
    exact eq_of_heq ((Sigma.mk.inj_iff.mp (Option.some.inj (Sum.inr.inj (ha.1.symm.trans hb.1)))).2)
  exact ⟨haux, hL, hσ, hτ⟩

theorem physical_selected_fine_data_unique
    (o : ℕ → PhysicalMarkObservation P ell C)
    (t : ℕ → PhysicalBoundedMarkState P J ell B)
    (h : ∀ i < 4 * n + 1, physicalSelectedFineTest C aux L σ τ i (o i) (t i))
    (h' : ∀ i < 4 * n + 1, physicalSelectedFineTest C aux' L' σ' τ' i (o i) (t i)) :
    aux = aux' ∧ L = L' ∧ σ = σ' ∧ τ = τ' :=
  physical_selected_fine_data_unique_of_joint_tests C
    (fun i hi => ⟨o i, t i, h i hi, h' i hi⟩)

end Fine
end Bounty
