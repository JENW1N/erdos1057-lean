open OAI.Ostmann

/-- A sharp truncated explicit formula at height `x`, with an absolute error
constant. The finite set consists of actual nontrivial zeros; multiplicities
are supplied by `characterZeroOrder`. This predicate is not proved here. -/
def PrimitiveTruncatedExplicitFormula : Prop :=
  ∃ E : ℝ, 0 < E ∧ ∀ χ : PrimitiveComplexCharacter, ∀ x : ℝ, 2 ≤ x →
    ∃ S : Finset ℂ,
      (∀ z ∈ S, χ.L z = 0 ∧ 0 < z.re ∧ z.re < 1 ∧ |z.im| ≤ x) ∧
      ‖twistedPsi χ.character x +
        ∑ z ∈ S, (characterZeroOrder χ z : ℂ) * (((x : ℂ) ^ z - 1) / z)‖ ≤
        E * (Real.log ((χ.modulus : ℝ) * x)) ^ 2

/-- Zero counting and reflection supply the character bound once the two
remaining analytic assertions have been established. -/
theorem primitive_mangoldt_of_zero_free_and_explicit_formula
    (hZ : PrimitiveZeroFreeHalfPlane) (hE : PrimitiveTruncatedExplicitFormula) :
    PrimitiveTwistedMangoldtEstimate := by
  obtain ⟨E, hEpos, hE⟩ := hE
  let A : ℝ := 18432 / Real.log (14 / 13)
  have hA : 0 < A := by
    dsimp [A]
    exact div_pos (by norm_num) (Real.log_pos (by norm_num))
  refine ⟨E + A, by positivity, ?_⟩
  intro x hx q hq χ hχ hprim
  let ψ : PrimitiveComplexCharacter := ⟨q, hq, χ, hprim, hχ⟩
  obtain ⟨S, hS, herr⟩ := hE ψ x hx
  have hstrip : ∀ z ∈ S, (1 : ℝ) / 8 ≤ z.re ∧ z.re ≤ 7 / 8 ∧ |z.im| ≤ x := by
    intro z hz
    have hh := hS z hz
    exact ⟨(primitive_zero_mem_strip hZ ψ z hh.1 hh.2.1).1,
      (primitive_zero_mem_strip hZ ψ z hh.1 hh.2.1).2, hh.2.2.2⟩
  have hsum := character_truncated_zero_sum_le ψ S hx hx hstrip
  have hq1 : (1 : ℝ) ≤ q := by exact_mod_cast hq
  have hx0 : 0 < x := by linarith
  have hqx : x ≤ (q : ℝ) * x := by nlinarith
  have hlogx : 0 ≤ Real.log x := Real.log_nonneg (by linarith)
  have hlog : Real.log x ≤ Real.log ((q : ℝ) * x) := Real.log_le_log hx0 hqx
  have hlogq : 0 ≤ Real.log ((q : ℝ) * x) := hlogx.trans hlog
  have hpow : 1 ≤ x ^ ((7 : ℝ) / 8) := Real.one_le_rpow (by linarith) (by norm_num)
  have hnorm : ‖twistedPsi χ x‖ ≤
      ‖twistedPsi χ x +
        ∑ z ∈ S, (characterZeroOrder ψ z : ℂ) * (((x : ℂ) ^ z - 1) / z)‖ +
      ‖∑ z ∈ S, (characterZeroOrder ψ z : ℂ) * (((x : ℂ) ^ z - 1) / z)‖ := by
    simpa only [add_sub_cancel_right, norm_neg] using
      (norm_sub_le (twistedPsi χ x +
        ∑ z ∈ S, (characterZeroOrder ψ z : ℂ) * (((x : ℂ) ^ z - 1) / z))
        (∑ z ∈ S, (characterZeroOrder ψ z : ℂ) * (((x : ℂ) ^ z - 1) / z)))
  change ‖twistedPsi χ x + _‖ ≤ E * (Real.log ((q : ℝ) * x)) ^ 2 at herr
  change ‖_‖ ≤ A * x ^ ((7 : ℝ) / 8) * Real.log ((q : ℝ) * x) * Real.log x at hsum
  have hsum' : ‖∑ z ∈ S, (characterZeroOrder ψ z : ℂ) * (((x : ℂ) ^ z - 1) / z)‖ ≤
      A * x ^ ((7 : ℝ) / 8) * (Real.log ((q : ℝ) * x)) ^ 2 := by
    calc
      _ ≤ A * x ^ ((7 : ℝ) / 8) * Real.log ((q : ℝ) * x) * Real.log x := hsum
      _ ≤ A * x ^ ((7 : ℝ) / 8) * Real.log ((q : ℝ) * x) * Real.log ((q : ℝ) * x) := by
        gcongr
      _ = _ := by ring
  have herr' : E * (Real.log ((q : ℝ) * x)) ^ 2 ≤
      E * x ^ ((7 : ℝ) / 8) * (Real.log ((q : ℝ) * x)) ^ 2 := by
    nlinarith [sq_nonneg (Real.log ((q : ℝ) * x)),
      mul_nonneg (show 0 ≤ E * (Real.log ((q : ℝ) * x)) ^ 2 by positivity)
        (sub_nonneg.mpr hpow)]
  calc
    _ ≤ E * (Real.log ((q : ℝ) * x)) ^ 2 +
        A * x ^ ((7 : ℝ) / 8) * (Real.log ((q : ℝ) * x)) ^ 2 :=
      hnorm.trans (add_le_add herr hsum')
    _ ≤ E * x ^ ((7 : ℝ) / 8) * (Real.log ((q : ℝ) * x)) ^ 2 +
        A * x ^ ((7 : ℝ) / 8) * (Real.log ((q : ℝ) * x)) ^ 2 := add_le_add herr' le_rfl
    _ = _ := by ring

/-- The complete conditional submission route, with all remaining analytic
obligations visible as hypotheses. -/
theorem target_of_smooth_primes_zero_free_and_explicit_formula
    (hS : SmoothShiftedPrimeSupply) (hZ : PrimitiveZeroFreeHalfPlane)
    (hE : PrimitiveTruncatedExplicitFormula) :
    fcTypeOfName% "Erdos1057.erdos_1057" :=
  target_of_smooth_primes_and_uniform_character_estimate hS
    (uniformPrimeCharacterEstimate_of_primitive_mangoldt
      (primitive_mangoldt_of_zero_free_and_explicit_formula hZ hE))
end

