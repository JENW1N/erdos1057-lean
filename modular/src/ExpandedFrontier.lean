    have hget := finite_schedule_observations_get E target
      (physicalFullTraceObservation C k (physicalSelectedFineTag n) cut) (4 * n + 1) s p ⟨i, hii⟩
    exact (congrArg (fun r => r.2.2) hget).trans (ht ⟨i, hii⟩).symm

