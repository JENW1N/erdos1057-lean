section

/- Exact common-window Mellin separation with auxiliary-independent endpoint functions. -/

open Finset MeasureTheory
namespace Bounty

noncomputable def harmonicCellSource (Y Z a v : ℝ) (F : ℤ → ℂ) (n : ℤ) : ℂ :=
  physicalMellinSource Y Z v (fun m => physicalPhase (-a) m.natAbs *
    ((harmonicCommonCutoff ((m : ℝ)/Y) : ℂ)*F m)) n

noncomputable def harmonicCellTarget (Y b : ℝ) (G : ℤ → ℂ) (n : ℤ) : ℂ :=
  physicalPhase b n.natAbs*((harmonicCommonCutoff ((n : ℝ)/Y) : ℂ)*G n)

noncomputable def harmonicCellPairing (Y Z a b v : ℝ) (δ : ℤ) (F G : ℤ → ℂ) : ℂ :=
  ∑ n ∈ harmonicCommonSupport Y, star (harmonicCellSource Y Z a v F n)*
    harmonicCellTarget Y b G (n+δ)

theorem harmonic_cell_sum_eq_mellin {Z H : ℝ} (hZ : 0 < Z) (hH : 0 < H)
    {d : ℕ} (hHd : H ≤ (d : ℝ)) (hdH : (d : ℝ) ≤ Real.exp 2*H)
    {k : ℤ} (hk : |(k : ℝ)| ≤ Z/4) (a b : ℝ) (F G : ℤ → ℂ) :
    physicalPhase (-(a+b)) d *
      (∑ n ∈ harmonicPositiveSupport Z k d,
        ((typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) : ℂ)/(n : ℂ))*
          physicalPhase a n.natAbs*physicalPhase b (n+k*(d : ℤ)).natAbs*
          star (F n)*G (n+k*(d : ℤ))) =
      ((Z*H : ℝ) : ℂ)⁻¹ * ∫ v : ℝ,
        harmonicLogFourier v*physicalPhase (-(a+b+2*Real.pi*v)) d*
          harmonicCellPairing (Z*H) Z a b (2*Real.pi*v) (k*(d : ℤ)) F G := by
  let Y := Z*H
  let T := harmonicCommonSupport Y
  let δ : ℤ := k*(d : ℤ)
  let Fc := fun n : ℤ => (harmonicCommonCutoff ((n : ℝ)/Y) : ℂ)*F n
  let Gc := fun n : ℤ => (harmonicCommonCutoff ((n : ℝ)/Y) : ℂ)*G n
  let c := fun n : ℤ => physicalPhase (-(a+b)) d *
    ((n : ℂ)⁻¹*physicalPhase a n.natAbs*physicalPhase b (n+δ).natAbs*star (Fc n)*Gc (n+δ))
  have hY : 0 < Y := mul_pos hZ hH
  have hdr : (0 : ℝ) < d := hH.trans_le hHd
  have hd : 0 < d := by exact_mod_cast hdr
  have hTpos : ∀ n ∈ T, 0 < n := fun n hn => harmonic_common_support_positive hY hn
  have hleft : physicalPhase (-(a+b)) d *
      (∑ n ∈ harmonicPositiveSupport Z k d,
        ((typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) : ℂ)/(n : ℂ))*
          physicalPhase a n.natAbs*physicalPhase b (n+δ).natAbs*star (F n)*G (n+δ)) =
      ∑ n ∈ T, c n*(typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) : ℂ) := by
    rw [mul_sum]
    trans ∑ n ∈ harmonicPositiveSupport Z k d,
      (typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) : ℂ)*c n
    · apply sum_congr rfl
      intro n hn
      by_cases hψ : typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) = 0
      · simp only [hψ, Complex.ofReal_zero, zero_div, zero_mul, mul_zero]
      · have hw := harmonic_common_window_of_scale hZ hH hHd hdH hk hψ
        have hχn := harmonic_common_cutoff_scaled_eq_one hY ⟨hw.1.1.le, hw.1.2.le⟩
        have hχz := harmonic_common_cutoff_scaled_eq_one hY ⟨hw.2.1.le, hw.2.2.le⟩
        dsimp only [c, Fc, Gc]
        rw [hχn, hχz]
        simp only [Complex.ofReal_one, one_mul]
        ring
    · rw [harmonic_sum_common_support hZ hH hHd hdH hk c]
      apply sum_congr rfl
      intro n _
      exact mul_comm _ _
  have he := finite_mellin_sum_representation T harmonicLogFourier (fun v => 2*Real.pi*v)
    harmonic_log_fourier_integrable (by fun_prop) c
    (fun n => (n : ℝ)/(Z*(d : ℝ))) (fun t => (typeIIHarmonicDyadic t : ℂ)) (by
      intro n hn _
      apply harmonic_dyadic_mellin_representation
      exact div_pos (by exact_mod_cast hTpos n hn) (mul_pos hZ hdr))
  rw [hleft, he, ← integral_const_mul]
  apply integral_congr_ae
  filter_upwards [] with v
  dsimp only [harmonicCellPairing]
  rw [mul_sum, mul_sum, mul_sum]
  apply sum_congr rfl
  intro n hn
  have hp := physical_mellin_phased_edge_normalized Y Z a b (2*Real.pi*v) d n (n+δ)
    Fc Gc hY.ne' hZ.ne' hd.ne' (hTpos n hn).ne'
  dsimp only [harmonicCellSource, harmonicCellTarget, c]
  dsimp only [Fc, Gc] at hp
  calc
    _ = harmonicLogFourier v *
        (physicalPhase (-(a+b)) d*physicalMellinPhase (2*Real.pi*v) ((n : ℝ)/(Z*(d : ℝ)))*
          ((n : ℂ)⁻¹*physicalPhase a n.natAbs*physicalPhase b (n+δ).natAbs*
            star (Fc n)*Gc (n+δ))) := by ring
    _ = _ := by rw [← hp]; ring

end Bounty
end

section

/- Every supported product dyad of a nonempty actual probe subset is large. -/

open Finset Filter
open scoped Classical
namespace Bounty

theorem eventually_candidate_supported_dyad {c : ℝ} (hc : 0 < c)
    (J : ℕ) (q : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (S : Finset ℕ), S ⊆ candidatePIndices c L →
      ∀ (ell : ℕ) (probes : S → Finset (Fin J)) (r : Finset S)
        (A : Finset (RepeatedBigFlatIndex S J ell)),
        A ⊆ r.sigma (repeatedBigPrimeProbeSlots probes) → A.Nonempty →
        ∀ U : ℕ,
          (∃ a : (∀ i : A, candidatePBand (c*L) i.val.1.val),
            U ≤ ∏ i, (a i).val ∧ (∏ i, (a i).val) < 2*U) →
          0 < U ∧ L^q ≤ (U : ℝ) ∧ Real.log (U : ℝ) ≤ L := by
  filter_upwards [eventually_candidate_subset_product_range hc (ε := 1) (by norm_num) J,
    eventually_mul_rpow_le_exp_rpow q 2 (c := (1/10 : ℝ)) (by norm_num)]
    with L hrange hlarge
  intro S hS ell probes r A hA hne U hU
  obtain ⟨a, hlo, hhi⟩ := hU
  have hUp : 0 < U := by omega
  obtain ⟨hpl, hph⟩ := hrange S hS ell probes r A hA hne a
  have hhi' : ((∏ i, (a i).val : ℕ) : ℝ) < 2*(U : ℝ) := by exact_mod_cast hhi
  have hlo' : (U : ℝ) ≤ (∏ i, (a i).val : ℕ) := by exact_mod_cast hlo
  refine ⟨hUp, by linarith, ?_⟩
  have hu := Real.log_le_log (by exact_mod_cast hUp : (0 : ℝ) < U) (hlo'.trans hph)
  simpa only [Real.log_exp, one_mul] using hu

theorem supported_dyad_log_product {L : ℝ} {U W : ℕ}
    (hL : 2 ≤ L) (hU : 0 < U) (hW : 0 < W)
    (hlogU : Real.log (U : ℝ) ≤ L) (hlogW : Real.log (W : ℝ) ≤ L) :
    Real.log ((U : ℝ)*W) ≤ L^(2 : ℝ) := by
  rw [Real.log_mul (by exact_mod_cast Nat.ne_of_gt hU) (by exact_mod_cast Nat.ne_of_gt hW),
    Real.rpow_two]
  nlinarith

end Bounty
end

section

/- The original signed full-path moment retains an arbitrary complete selected weight. -/

open Finset Classical
namespace Bounty
section Weighted
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g, ∀ p : ↥(P g), NeZero p.val]
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (q : Fin (n + 1) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
  (cut : ℕ → Fin N → Finset (Fin J))
  [Fintype (PhysicalSelectedData P ell C)]
  (w : PhysicalSelectedData P ell C → ℂ)

noncomputable def physicalOriginalWeightedMoment
    (f : PhysicalFullBoundedState P J ell B → ℂ) (x : PhysicalFullBoundedState P J ell B) : ℂ :=
  let sizes := fun g (p : ↥(P g)) => p.val
  let S := fun j g => physicalFullSharedIndices (ell := ell) (C j g)
  let A := fun j (_ : SharedActiveLabels (fun g => ↥(P g)) (S j)) => PhysicalAuxLabels P (C j)
  let Δ := fun j => physicalFullEdgeDelta (ell := ell) (C j) (k j)
  let D := fun j => physicalFullEdgeD (ell := ell) (C j)
  let steps := (List.range (4 * n + 1)).map (physicalSelectedFineTag n)
  let _ := fullPermutationMixedEventFintype (J := Fin (n + 1)) sizes S B A Δ D
  let _ := finiteEventPathFintype (FullPermutationMixedEvent sizes S B A Δ D)
    (fullPermutationMixedEventTarget sizes S B A Δ D) steps x
  ∑ p : FullPermutationMixedPath sizes S B A Δ D steps x,
    (physicalOriginalFineWeight C k ω β q ρ V x p *
      physicalSelectedDataRecordPhase C cut univ w
        (physicalOriginalFineRecord C k cut x p)) *
    f (finiteEventPathTerminal (FullPermutationMixedEvent sizes S B A Δ D)
      (fullPermutationMixedEventTarget sizes S B A Δ D) steps x p)

end Weighted
end Bounty
end

section

/- Truncation of the independent source-cutoff frequency on a full four-factor box. -/

open Finset MeasureTheory Filter

namespace Bounty

noncomputable def harmonicSourceFourBoxError (Y s R : ℝ) (D A B C : Finset ℕ)
    (δ α β γ : ℕ → ℂ) : ℂ :=
  (∑ d ∈ D, ∑ a ∈ A, ∑ b ∈ B, ∑ c ∈ C,
    (δ d * α a * β b * γ c) *
      ((harmonicCommonCutoff (((d*a*b*c : ℕ) : ℝ) / Y) /
        (((d*a*b*c : ℕ) : ℝ) / Y) : ℝ) : ℂ) *
      physicalMellinPhase s ((d*a*b*c : ℕ) : ℝ)) -
    ∫ u in {u : ℝ | ‖u‖ ≤ R},
      harmonicSourceLogFourier u * physicalMellinPhase (-2 * Real.pi * u) Y *
        ((∑ d ∈ D, δ d * physicalMellinPhase (s + 2 * Real.pi * u) d) *
          (∑ a ∈ A, α a * physicalMellinPhase (s + 2 * Real.pi * u) a) *
          (∑ b ∈ B, β b * physicalMellinPhase (s + 2 * Real.pi * u) b) *
          (∑ c ∈ C, γ c * physicalMellinPhase (s + 2 * Real.pi * u) c))

theorem harmonic_source_four_box_tail_le {Y : ℝ} (hY : 0 < Y) (s R : ℝ)
    (D A B C : Finset ℕ) (δ α β γ : ℕ → ℂ)
    (hD : ∀ d ∈ D, 0 < d) (hA : ∀ a ∈ A, 0 < a)
    (hB : ∀ b ∈ B, 0 < b) (hC : ∀ c ∈ C, 0 < c) :
    ‖harmonicSourceFourBoxError Y s R D A B C δ α β γ‖ ≤
      (∫ u in {u : ℝ | R < ‖u‖}, ‖harmonicSourceLogFourier u‖) *
        ((∑ d ∈ D, ‖δ d‖) * (∑ a ∈ A, ‖α a‖) *
          (∑ b ∈ B, ‖β b‖) * (∑ c ∈ C, ‖γ c‖)) := by
  have hs : MeasurableSet {u : ℝ | ‖u‖ ≤ R} :=
    (isClosed_le continuous_norm continuous_const).measurableSet
  have heq : {u : ℝ | ‖u‖ ≤ R}ᶜ = {u : ℝ | R < ‖u‖} := by ext u; simp
  unfold harmonicSourceFourBoxError
  rw [harmonic_source_four_box_mellin hY s D A B C δ α β γ hD hA hB hC,
    ← setIntegral_compl hs
      (harmonic_source_four_box_integrable Y s D A B C δ α β γ hD hA hB hC), heq]
  calc
    _ ≤ ∫ u in {u : ℝ | R < ‖u‖}, ‖harmonicSourceLogFourier u‖ *
        ((∑ d ∈ D, ‖δ d‖) * (∑ a ∈ A, ‖α a‖) *
          (∑ b ∈ B, ‖β b‖) * (∑ c ∈ C, ‖γ c‖)) :=
      norm_integral_le_of_norm_le
        ((harmonic_source_log_fourier_integrable.norm.mul_const _).integrableOn)
        (Filter.Eventually.of_forall (fun u =>
          harmonic_source_four_box_integrand_norm Y s u D A B C δ α β γ))
    _ = _ := integral_mul_const _ _

theorem harmonic_source_four_box_normalized_tail_le_mass {Y : ℝ} (hY : 0 < Y)
    (s R : ℝ) (D A B C : Finset ℕ) (δ α β γ : ℕ → ℂ)
    (hD : ∀ d ∈ D, 0 < d) (hA : ∀ a ∈ A, 0 < a)
    (hB : ∀ b ∈ B, 0 < b) (hC : ∀ c ∈ C, 0 < c) :
    ‖(Y : ℂ)⁻¹ * harmonicSourceFourBoxError Y s R D A B C δ α β γ‖ ≤
      (∫ u in {u : ℝ | R < ‖u‖}, ‖harmonicSourceLogFourier u‖) *
        ((1/Y) * (∑ d ∈ D, ‖δ d‖) * (∑ a ∈ A, ‖α a‖) *
          (∑ b ∈ B, ‖β b‖) * (∑ c ∈ C, ‖γ c‖)) := by
  rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hY]
  calc
    _ ≤ Y⁻¹ * ((∫ u in {u : ℝ | R < ‖u‖}, ‖harmonicSourceLogFourier u‖) *
        ((∑ d ∈ D, ‖δ d‖) * (∑ a ∈ A, ‖α a‖) *
          (∑ b ∈ B, ‖β b‖) * (∑ c ∈ C, ‖γ c‖))) :=
      mul_le_mul_of_nonneg_left
        (harmonic_source_four_box_tail_le hY s R D A B C δ α β γ hD hA hB hC)
        (inv_nonneg.mpr hY.le)
    _ = _ := by ring

theorem harmonic_source_four_box_normalized_tail_le_polynomial
    {Y L K B₁ B₂ B₃ B₄ C₁ C₂ C₃ C₄ : ℝ} (hY : 0 < Y) (hL : 0 < L)
    (s R : ℝ) (D A B C : Finset ℕ) (δ α β γ : ℕ → ℂ)
    (hD : ∀ d ∈ D, 0 < d) (hA : ∀ a ∈ A, 0 < a)
    (hB : ∀ b ∈ B, 0 < b) (hC : ∀ c ∈ C, 0 < c)
    (hcard₁ : (D.card : ℝ) ≤ B₁) (hcard₂ : (A.card : ℝ) ≤ B₂)
    (hcard₃ : (B.card : ℝ) ≤ B₃) (hcard₄ : (C.card : ℝ) ≤ B₄)
    (hδ : ∀ n ∈ D, ‖δ n‖ ≤ L^C₁) (hα : ∀ n ∈ A, ‖α n‖ ≤ L^C₂)
    (hβ : ∀ n ∈ B, ‖β n‖ ≤ L^C₃) (hγ : ∀ n ∈ C, ‖γ n‖ ≤ L^C₄)
    (hvolume : B₁*B₂*B₃*B₄ ≤ K*Y) :
    ‖(Y : ℂ)⁻¹ * harmonicSourceFourBoxError Y s R D A B C δ α β γ‖ ≤
      (∫ u in {u : ℝ | R < ‖u‖}, ‖harmonicSourceLogFourier u‖) *
        K * L^(C₁+C₂+C₃+C₄) := by
  calc
    _ ≤ (∫ u in {u : ℝ | R < ‖u‖}, ‖harmonicSourceLogFourier u‖) *
        ((1/Y) * (∑ d ∈ D, ‖δ d‖) * (∑ a ∈ A, ‖α a‖) *
          (∑ b ∈ B, ‖β b‖) * (∑ c ∈ C, ‖γ c‖)) :=
      harmonic_source_four_box_normalized_tail_le_mass hY s R D A B C δ α β γ
        hD hA hB hC
    _ ≤ (∫ u in {u : ℝ | R < ‖u‖}, ‖harmonicSourceLogFourier u‖) *
        (K * L^(C₁+C₂+C₃+C₄)) :=
      mul_le_mul_of_nonneg_left
        (harmonic_box_normalized_mass_le D A B C δ α β γ hL hY
          hcard₁ hcard₂ hcard₃ hcard₄ hδ hα hβ hγ hvolume)
        (integral_nonneg (fun _ => norm_nonneg _))
    _ = _ := by ring

theorem eventually_harmonic_source_four_box_tail {r : ℝ} (hr : 0 < r)
    (K C₁ C₂ C₃ C₄ E : ℝ) (hK : 0 ≤ K) :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, 0 < Y → ∀ s : ℝ,
      ∀ D A B C : Finset ℕ, ∀ δ α β γ : ℕ → ℂ,
        (∀ d ∈ D, 0 < d) → (∀ a ∈ A, 0 < a) →
        (∀ b ∈ B, 0 < b) → (∀ c ∈ C, 0 < c) →
        ∀ B₁ B₂ B₃ B₄ : ℝ,
          (D.card : ℝ) ≤ B₁ → (A.card : ℝ) ≤ B₂ →
          (B.card : ℝ) ≤ B₃ → (C.card : ℝ) ≤ B₄ →
          (∀ n ∈ D, ‖δ n‖ ≤ L^C₁) → (∀ n ∈ A, ‖α n‖ ≤ L^C₂) →
          (∀ n ∈ B, ‖β n‖ ≤ L^C₃) → (∀ n ∈ C, ‖γ n‖ ≤ L^C₄) →
          B₁*B₂*B₃*B₄ ≤ K*Y →
          ‖(Y : ℂ)⁻¹ * harmonicSourceFourBoxError Y s (L^r) D A B C δ α β γ‖ ≤
            L^(-E) := by
  filter_upwards [eventually_gt_atTop (0 : ℝ),
    eventually_harmonic_source_tail_polynomial hr K (C₁+C₂+C₃+C₄) E hK] with L hL ht
  intro Y hY s D A B C δ α β γ hD hA hB hC B₁ B₂ B₃ B₄
    hcard₁ hcard₂ hcard₃ hcard₄ hδ hα hβ hγ hvolume
  exact (harmonic_source_four_box_normalized_tail_le_polynomial hY hL s (L^r)
    D A B C δ α β γ hD hA hB hC hcard₁ hcard₂ hcard₃ hcard₄ hδ hα hβ hγ hvolume).trans ht

end Bounty
end

section

/- Source-frequency tails with the exact harmonic normalization on every coordinate. -/

open Finset MeasureTheory Filter

namespace Bounty

noncomputable def harmonicNormalizedFourBoxError (Y s R : ℝ) (D A B C : Finset ℕ)
    (δ α β γ : ℕ → ℂ) : ℂ :=
  (∑ d ∈ D, ∑ a ∈ A, ∑ b ∈ B, ∑ c ∈ C,
    (δ d * α a * β b * γ c) *
      ((harmonicCommonCutoff (((d*a*b*c : ℕ) : ℝ) / Y) /
        ((d*a*b*c : ℕ) : ℝ) : ℝ) : ℂ) *
      physicalMellinPhase s ((d*a*b*c : ℕ) : ℝ)) -
    ∫ u in {u : ℝ | ‖u‖ ≤ R},
      harmonicWindowLogFourier u * physicalMellinPhase (-2 * Real.pi * u) Y *
        ((∑ d ∈ D, δ d * harmonicMellinWeight (s + 2 * Real.pi * u) d) *
          (∑ a ∈ A, α a * harmonicMellinWeight (s + 2 * Real.pi * u) a) *
          (∑ b ∈ B, β b * harmonicMellinWeight (s + 2 * Real.pi * u) b) *
          (∑ c ∈ C, γ c * harmonicMellinWeight (s + 2 * Real.pi * u) c))

theorem harmonic_normalized_four_box_tail_le {Y : ℝ} (hY : 0 < Y) (s R : ℝ)
    (D A B C : Finset ℕ) (δ α β γ : ℕ → ℂ)
    (hD : ∀ d ∈ D, 0 < d) (hA : ∀ a ∈ A, 0 < a)
    (hB : ∀ b ∈ B, 0 < b) (hC : ∀ c ∈ C, 0 < c) :
    ‖harmonicNormalizedFourBoxError Y s R D A B C δ α β γ‖ ≤
      (∫ u in {u : ℝ | R < ‖u‖}, ‖harmonicWindowLogFourier u‖) *
        ((∑ d ∈ D, ‖δ d‖ / (d : ℝ)) * (∑ a ∈ A, ‖α a‖ / (a : ℝ)) *
          (∑ b ∈ B, ‖β b‖ / (b : ℝ)) * (∑ c ∈ C, ‖γ c‖ / (c : ℝ))) := by
  have hs : MeasurableSet {u : ℝ | ‖u‖ ≤ R} :=
    (isClosed_le continuous_norm continuous_const).measurableSet
  have heq : {u : ℝ | ‖u‖ ≤ R}ᶜ = {u : ℝ | R < ‖u‖} := by ext u; simp
  unfold harmonicNormalizedFourBoxError
  rw [harmonic_normalized_four_box_mellin hY s D A B C δ α β γ hD hA hB hC,
    ← setIntegral_compl hs
      (harmonic_normalized_four_box_integrable Y s D A B C δ α β γ hD hA hB hC), heq]
  calc
    _ ≤ ∫ u in {u : ℝ | R < ‖u‖}, ‖harmonicWindowLogFourier u‖ *
        ((∑ d ∈ D, ‖δ d‖ / (d : ℝ)) * (∑ a ∈ A, ‖α a‖ / (a : ℝ)) *
          (∑ b ∈ B, ‖β b‖ / (b : ℝ)) * (∑ c ∈ C, ‖γ c‖ / (c : ℝ))) :=
      norm_integral_le_of_norm_le
        ((harmonic_window_log_fourier_integrable.norm.mul_const _).integrableOn)
        (Filter.Eventually.of_forall (fun u =>
          harmonic_normalized_four_box_integrand_norm Y s u D A B C δ α β γ hD hA hB hC))
    _ = _ := integral_mul_const _ _

theorem eventually_harmonic_normalized_four_box_tail {r : ℝ} (hr : 0 < r)
    (K E F : ℝ) (hK : 0 ≤ K) :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, 0 < Y → ∀ s : ℝ,
      ∀ D A B C : Finset ℕ, ∀ δ α β γ : ℕ → ℂ,
        (∀ d ∈ D, 0 < d) → (∀ a ∈ A, 0 < a) →
        (∀ b ∈ B, 0 < b) → (∀ c ∈ C, 0 < c) →
        (∑ d ∈ D, ‖δ d‖ / (d : ℝ)) * (∑ a ∈ A, ‖α a‖ / (a : ℝ)) *
          (∑ b ∈ B, ‖β b‖ / (b : ℝ)) * (∑ c ∈ C, ‖γ c‖ / (c : ℝ)) ≤ K*L^E →
        ‖harmonicNormalizedFourBoxError Y s (L^r) D A B C δ α β γ‖ ≤ L^(-F) := by
  filter_upwards [eventually_schwartz_tail_polynomial harmonicWindowLogFourier hr K E F hK]
    with L ht
  intro Y hY s D A B C δ α β γ hD hA hB hC hm
  calc
    _ ≤ (∫ u in {u : ℝ | L^r < ‖u‖}, ‖harmonicWindowLogFourier u‖) *
        ((∑ d ∈ D, ‖δ d‖ / (d : ℝ)) * (∑ a ∈ A, ‖α a‖ / (a : ℝ)) *
          (∑ b ∈ B, ‖β b‖ / (b : ℝ)) * (∑ c ∈ C, ‖γ c‖ / (c : ℝ))) :=
      harmonic_normalized_four_box_tail_le hY s (L^r) D A B C δ α β γ hD hA hB hC
    _ ≤ (∫ u in {u : ℝ | L^r < ‖u‖}, ‖harmonicWindowLogFourier u‖) * (K*L^E) :=
      mul_le_mul_of_nonneg_left hm (integral_nonneg (fun _ => norm_nonneg _))
    _ ≤ L^(-F) := by simpa only [mul_assoc] using ht

end Bounty
end

section

/- The original birth and freshness phase is an explicit deterministic history phase. -/

open scoped Classical
namespace Bounty
section History
variable {I K : Type} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

noncomputable def physicalFullHistoryPhase (steps : List (Option (I ⊕ K)))
    (x : PhysicalFullBoundedState P J ell B)
    (p : FullPermutationMixedPath (fun g (p : P g) => p.val)
      (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B
      (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j)) steps x) : ℂ :=
  deterministicLedgerPhase
    (FullPermutationMixedEvent (fun g (p : P g) => p.val)
      (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B
      (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j)))
    (fullPermutationMixedEventTarget (fun g (p : P g) => p.val)
      (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B
      (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j)))
    (fullMixedLedgerUpdate (fun g (p : P g) => p.val)
      (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B
      (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j)))
    (fun tag H x e => physicalFullLedgerEventPhase C k ω β ρ V tag (H, x) e)
