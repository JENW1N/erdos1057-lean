section
open Finset
open scoped Classical
theorem birth_ambient_cap_range {P : Type*} [Fintype P] [DecidableEq P] (retained cap : ℕ)
    (H : Finset P) (F : ∀ m, (Fin m → P) → ℂ) :
    (∑ m ∈ range (Fintype.card P + 1), ∑ f : Fin m → P,
      if Function.Injective f ∧ (∀ j, f j ∉ H) ∧ retained + m ≤ cap then F m f else 0) =
    ∑ m ∈ range (cap + 1), ∑ f : Fin m → P,
      if Function.Injective f ∧ (∀ j, f j ∉ H) ∧ retained + m ≤ cap then F m f else 0 := by
  have hp (m : ℕ) (hm : Fintype.card P < m) :
      (∑ f : Fin m → P,
        if Function.Injective f ∧ (∀ j, f j ∉ H) ∧ retained + m ≤ cap then F m f else 0) = 0 := by
    apply sum_eq_zero
    intro f _
    apply if_neg
    intro hf
    have hc : m ≤ Fintype.card P := by
      simpa only [Fintype.card_fin] using Fintype.card_le_of_injective f hf.1
    omega
  have hb (m : ℕ) (hm : cap < m) :
      (∑ f : Fin m → P,
        if Function.Injective f ∧ (∀ j, f j ∉ H) ∧ retained + m ≤ cap then F m f else 0) = 0 := by
    apply sum_eq_zero
    intro f _
    apply if_neg
    intro hf
    have hc := hf.2.2
    omega
  by_cases h : Fintype.card P ≤ cap
  · apply sum_subset (range_mono (Nat.add_le_add_right h 1))
    intro m _ hm
    apply hp
    have := mt mem_range.mpr hm
    omega
  · symm
    apply sum_subset (range_mono (Nat.add_le_add_right (Nat.le_of_lt (Nat.lt_of_not_ge h)) 1))
    intro m _ hm
    apply hb
    have := mt mem_range.mpr hm
    omega

theorem birth_ambient_cap_range_nested {P : Type*} [Fintype P] [DecidableEq P] (retained cap : ℕ)
    (H : Finset P)
    (F G : ∀ m, (Fin m → P) → ℂ) :
    (∑ m ∈ range (Fintype.card P + 1), ∑ f : Fin m → P,
      if Function.Injective f ∧ (∀ j, f j ∉ H) then
        F m f * (if retained + m ≤ cap then G m f else 0) else 0) =
    ∑ m ∈ range (cap + 1), ∑ f : Fin m → P,
      if Function.Injective f ∧ (∀ j, f j ∉ H) ∧ retained + m ≤ cap then F m f * G m f else 0 := by
  rw [← birth_ambient_cap_range retained cap H (fun m f => F m f * G m f)]
  apply sum_congr rfl
  intro m _
  apply sum_congr rfl
  intro f _
  split_ifs <;> simp_all

noncomputable def globalBirthGhostVisitCapRow {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, DecidableEq (R p)] {N : ℕ}
    (h : (p : P) → R p) (β : P → ℝ) (η V ρ : ℝ) (cap : ℕ)
    (H : Finset P) (old : Fin N → Σ p, R p)
    (G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ) : ℂ :=
  ∑ T ∈ (globalBirthVisitZeroIndices h old).powerset,
    ∑ m ∈ range (cap + 1), ∑ f : Fin m → P,
      if Function.Injective f ∧ (∀ j, f j ∉ H) ∧ (univ \ T).card + m ≤ cap then
        ((((-η / ρ) ^ T.card * ((1 - η) / ρ ^ 2) ^ (globalBirthVisitZeroIndices h old \ T).card) *
          ((-η * V / ρ) ^ m * (∏ j, β (f j) / V)) / (m.factorial : ℝ) : ℝ) : ℂ) *
          G (H ∪ univ.image f) (retainedBirthTuple old (univ \ T) (fun j => ⟨f j, h (f j)⟩))
      else 0

/-- The literal ambient raw visit can use the bounded ghost operator's birth
range once distinctness and the actual output-length cutoff are imposed. -/
theorem global_birth_ghost_visit_cap_range {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, DecidableEq (R p)] {N : ℕ}
    (h : (p : P) → R p) (β : P → ℝ) (η V ρ : ℝ) (cap : ℕ)
    (H : Finset P) (old : Fin N → Σ p, R p)
    (G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ) :
    globalBirthGhostVisitRawRow h β η V ρ cap H old G =
      globalBirthGhostVisitCapRow h β η V ρ cap H old G := by
  rw [global_birth_ghost_visit_eq_ambient_row]
  unfold globalBirthGhostVisitAmbientRow globalBirthGhostVisitCapRow
  apply sum_congr rfl
  intro T _
  exact birth_ambient_cap_range_nested (univ \ T).card cap H _ _
end

section
open Finset Classical
noncomputable def physicalGhostProductOperator
    {G : Type*} [DecidableEq G] {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] (μ : ∀ g, P g → ℝ)
    (q ρ : ℝ) (V : G → ℝ) (t : G → ℕ) (B : ℕ) (groups : Finset G) :=
  finiteCoordinateFinsetAction
    (fun g => physicalBoundedGhostOperator (n g) (μ g) q ρ (V g) (t g) B) groups

noncomputable def physicalGhostCutoffProductOperator
    {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] (μ : ∀ g, P g → ℝ)
    (q ρ : ℝ) (V : G → ℝ) (t : G → ℕ) (B : ℕ) (groups : Finset G)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ) :=
  productMemoryCutoff
    (physicalGhostProductOperator n μ q ρ V t B groups (productMemoryCutoff f))

theorem physical_ghost_product_energy_le
    {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] (μ : ∀ g, P g → ℝ)
    (q ρ : ℝ) (V : G → ℝ) (v vmax : ℝ) (t : G → ℕ) (B : ℕ)
    (hμ : ∀ g p, 0 < μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (hρ : 0 < ρ)
    (hV : ∀ g, 0 ≤ V g) (hVmax : ∀ g, V g ≤ vmax) (hv : 0 < v)
    (hD : q / ρ ^ 2 + ((1 - q) / ρ) / v ≤ 1)
    (hC : ∀ g, q / ρ ^ 2 + ((1 - q) * V g / ρ) / v ≤ 1)
    (groups : Finset G)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (physicalGhostProductOperator n μ q ρ V t B groups f) ≤
    physicalGhostUniformEnergyBound ρ vmax v ^ groups.card *
      finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  have hlocal (g : G) (h : BoundedOrderedState (P g)
      (UnrestrictedResidueParticle (n g)) (t g) B → ℂ) (hh : BoundedOrderedSymmetric h) :=
    physical_bounded_ghost_energy_le_uniform (n g) (μ g) q ρ (V g) v vmax (t g) B
      (hμ g) (hmass g) hq0 hq1 hρ (hV g) (hVmax g) hv hD (hC g) h hh
  have h := product_symmetric_finset_energy_le μ
    (fun g => unrestrictedResidueWeight (μ g))
    (fun g p => (hμ g p).le) (fun g z => (hμ g z.1).le)
    (fun g => physicalBoundedGhostOperator (n g) (μ g) q ρ (V g) (t g) B)
    (fun _ => physicalGhostUniformEnergyBound ρ vmax v)
    (fun _ => (Real.exp_pos _).le) hlocal groups f hf
  simpa only [prod_const, physicalGhostProductOperator, finiteWeightedEnergy] using h

theorem physical_ghost_cutoff_product_energy_le
    {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] (μ : ∀ g, P g → ℝ)
    (q ρ : ℝ) (V : G → ℝ) (v vmax : ℝ) (t : G → ℕ) (B : ℕ)
    (hμ : ∀ g p, 0 < μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (hρ : 0 < ρ)
    (hV : ∀ g, 0 ≤ V g) (hVmax : ∀ g, V g ≤ vmax) (hv : 0 < v)
    (hD : q / ρ ^ 2 + ((1 - q) / ρ) / v ≤ 1)
    (hC : ∀ g, q / ρ ^ 2 + ((1 - q) * V g / ρ) / v ≤ 1)
    (groups : Finset G)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (physicalGhostCutoffProductOperator n μ q ρ V t B groups f) ≤
    physicalGhostUniformEnergyBound ρ vmax v ^ groups.card *
      finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  have hlocal (g : G) (h : BoundedOrderedState (P g)
      (UnrestrictedResidueParticle (n g)) (t g) B → ℂ) (hh : BoundedOrderedSymmetric h) :=
    physical_bounded_ghost_energy_le_uniform (n g) (μ g) q ρ (V g) v vmax (t g) B
      (hμ g) (hmass g) hq0 hq1 hρ (hV g) (hVmax g) hv hD (hC g) h hh
  have h := product_symmetric_cutoff_sandwich_energy_le μ
    (fun g => unrestrictedResidueWeight (μ g))
    (fun g p => (hμ g p).le) (fun g z => (hμ g z.1).le)
    (fun g => physicalBoundedGhostOperator (n g) (μ g) q ρ (V g) (t g) B)
    (fun _ => physicalGhostUniformEnergyBound ρ vmax v)
    (fun _ => (Real.exp_pos _).le) hlocal groups f hf
  simpa only [prod_const, physicalGhostCutoffProductOperator,
    physicalGhostProductOperator, finiteWeightedEnergy] using h
end

section
open Finset Classical
abbrev CoupledGhostEvent {G : Type*} {P Z : G → Type*} (t : G → ℕ) (B : ℕ)
    (s : ProductBoundedOrderedState P Z t B) :=
  ∀ g, BoundedGhostEvent (t g) B (s g)

abbrev CoupledGhostPhase {G : Type*} (P Z : G → Type*) (t : G → ℕ) (B : ℕ) :=
  ∀ s : ProductBoundedOrderedState P Z t B, CoupledGhostEvent t B s → ℂ

noncomputable def coupledGhostOperator {G : Type*} [Fintype G]
    {P Z : G → Type*} [∀ g, Fintype (Z g)]
    (A D C ν : ∀ g, Z g → ℝ) (t : G → ℕ) (B : ℕ)
    (phase : CoupledGhostPhase P Z t B) (f : ProductBoundedOrderedState P Z t B → ℂ) :=
  finiteProductEventAction (fun g => BoundedGhostEvent (t g) B)
    (fun g => boundedGhostEventWeight (A g) (D g) (C g) (ν g) (t g) B)
    (fun g => boundedGhostEventTarget (t g) B) phase f

noncomputable def coupledGhostCutoffOperator {G : Type*} [Fintype G]
    {P Z : G → Type*} [∀ g, Fintype (Z g)]
    (A D C ν : ∀ g, Z g → ℝ) (t : G → ℕ) (B : ℕ)
    (phase : CoupledGhostPhase P Z t B) (f : ProductBoundedOrderedState P Z t B → ℂ) :=
  productMemoryCutoff (coupledGhostOperator A D C ν t B phase (productMemoryCutoff f))

noncomputable def coupledGhostJointEventTarget {G : Type*} {P Z : G → Type*}
    (t : G → ℕ) (B : ℕ) (s : ProductBoundedOrderedState P Z t B)
    (e : CoupledGhostEvent t B s) : ProductBoundedOrderedState P Z t B :=
  fun g => boundedGhostEventTarget (t g) B (s g) (e g)

noncomputable def coupledGhostJointEventWeight {G : Type*} [Fintype G]
    {P Z : G → Type*} (A D C ν : ∀ g, Z g → ℝ) (t : G → ℕ) (B : ℕ)
    (s : ProductBoundedOrderedState P Z t B) (e : CoupledGhostEvent t B s) : ℝ :=
  if productTotalMemory s ≤ B ∧ productTotalMemory (coupledGhostJointEventTarget t B s e) ≤ B
  then ∏ g, boundedGhostEventWeight (A g) (D g) (C g) (ν g) (t g) B (s g) (e g)
  else 0

theorem coupled_ghost_one_eq_coordinate_action {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)] [∀ g, DecidableEq (Z g)]
    (A D C ν : ∀ g, Z g → ℝ) (t : G → ℕ) (B : ℕ)
    (f : ProductBoundedOrderedState P Z t B → ℂ) :
    coupledGhostOperator A D C ν t B (fun _ _ => 1) f =
      finiteCoordinateFinsetAction
        (fun g => boundedOrderedGhostOperator (A g) (D g) (C g) (ν g) (t g) B) univ f := by
  let E := fun g => @BoundedGhostEvent (P g) (Z g) (t g) B
  let w := fun g => @boundedGhostEventWeight (P g) (Z g) (A g) (D g) (C g) (ν g) (t g) B
  let target := fun g => @boundedGhostEventTarget (P g) (Z g) (t g) B
  have hlocal : finiteLocalEventAction E w target =
      fun g => boundedOrderedGhostOperator (A g) (D g) (C g) (ν g) (t g) B := by
    funext g q s
    have h := bounded_ordered_ghost_eq_event_sum (A g) (D g) (C g) (ν g) (t g) B q s
    refine Eq.trans ?_ h.symm
    apply sum_congr
    · ext e
      simp only [mem_univ]
    · intro e _
      rfl
  have h := finite_product_event_eq_coordinate_action E w target f
  rw [hlocal] at h
  exact h

theorem coupled_ghost_cutoff_one_eq_coordinate_action {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)] [∀ g, DecidableEq (Z g)]
    (A D C ν : ∀ g, Z g → ℝ) (t : G → ℕ) (B : ℕ)
    (f : ProductBoundedOrderedState P Z t B → ℂ) :
    coupledGhostCutoffOperator A D C ν t B (fun _ _ => 1) f =
      productMemoryCutoff (finiteCoordinateFinsetAction
        (fun g => boundedOrderedGhostOperator (A g) (D g) (C g) (ν g) (t g) B)
        univ (productMemoryCutoff f)) := by
  unfold coupledGhostCutoffOperator
  rw [coupled_ghost_one_eq_coordinate_action]

theorem coupled_ghost_norm_le_positive_re {G : Type*} [Fintype G]
    {P Z : G → Type*} [∀ g, Fintype (Z g)]
    (A D C ν : ∀ g, Z g → ℝ) (hA : ∀ g z, 0 ≤ A g z) (hν : ∀ g z, 0 ≤ ν g z)
    (t : G → ℕ) (B : ℕ) (phase : CoupledGhostPhase P Z t B)
    (hphase : ∀ s e, ‖phase s e‖ ≤ 1) (f : ProductBoundedOrderedState P Z t B → ℂ)
    (s : ProductBoundedOrderedState P Z t B) :
    ‖coupledGhostOperator A D C ν t B phase f s‖ ≤
      (coupledGhostOperator A (fun g z => |D g z|) (fun g z => |C g z|) ν t B
        (fun _ _ => 1) (complexNormEnvelope f) s).re := by
  have h := finite_product_event_norm_le_abs_positive_re
    (fun g => @BoundedGhostEvent (P g) (Z g) (t g) B)
    (fun g => boundedGhostEventWeight (A g) (D g) (C g) (ν g) (t g) B)
    (fun g => boundedGhostEventTarget (t g) B) phase hphase f s
  have habs : (fun g x e => |boundedGhostEventWeight (A g) (D g) (C g) (ν g) (t g) B x e|) =
      fun g => @boundedGhostEventWeight (P g) (Z g)
        (A g) (fun z => |D g z|) (fun z => |C g z|) (ν g) (t g) B := by
    funext g x e
    exact boundedGhostEventWeight_abs (A g) (D g) (C g) (ν g) (hA g) (hν g) (t g) B x e
  rw [habs] at h
  exact h

theorem coupled_ghost_cutoff_norm_le_positive_re {G : Type*} [Fintype G]
    {P Z : G → Type*} [∀ g, Fintype (Z g)]
    (A D C ν : ∀ g, Z g → ℝ) (hA : ∀ g z, 0 ≤ A g z) (hν : ∀ g z, 0 ≤ ν g z)
    (t : G → ℕ) (B : ℕ) (phase : CoupledGhostPhase P Z t B)
    (hphase : ∀ s e, ‖phase s e‖ ≤ 1) (f : ProductBoundedOrderedState P Z t B → ℂ)
    (s : ProductBoundedOrderedState P Z t B) :
    ‖coupledGhostCutoffOperator A D C ν t B phase f s‖ ≤
      (coupledGhostCutoffOperator A (fun g z => |D g z|) (fun g z => |C g z|) ν t B
        (fun _ _ => 1) (complexNormEnvelope f) s).re := by
  have he : complexNormEnvelope (productMemoryCutoff f) =
      productMemoryCutoff (complexNormEnvelope f) := by
    funext x
    simp only [complexNormEnvelope, productMemoryCutoff]
    split_ifs
    · rfl
    · simp only [norm_zero, Complex.ofReal_zero]
  have h := coupled_ghost_norm_le_positive_re A D C ν hA hν t B phase hphase (productMemoryCutoff f) s
  rw [he] at h
  unfold coupledGhostCutoffOperator
  simp only [productMemoryCutoff]
  split_ifs
  · exact h
  · simp only [norm_zero, Complex.zero_re, le_refl]

theorem coupled_ghost_cutoff_eq_joint_event_sum {G : Type*} [Fintype G]
    {P Z : G → Type*} [∀ g, Fintype (Z g)]
    (A D C ν : ∀ g, Z g → ℝ) (t : G → ℕ) (B : ℕ)
    (phase : CoupledGhostPhase P Z t B) (f : ProductBoundedOrderedState P Z t B → ℂ)
    (s : ProductBoundedOrderedState P Z t B) :
    coupledGhostCutoffOperator A D C ν t B phase f s =
      ∑ e : CoupledGhostEvent t B s, (coupledGhostJointEventWeight A D C ν t B s e : ℂ) *
        phase s e * f (coupledGhostJointEventTarget t B s e) := by
  unfold coupledGhostCutoffOperator coupledGhostOperator finiteProductEventAction productMemoryCutoff
  by_cases hs : productTotalMemory s ≤ B
  · rw [if_pos hs]
    apply sum_congr rfl
    intro e _
    by_cases ht : productTotalMemory (coupledGhostJointEventTarget t B s e) ≤ B
    · simp [coupledGhostJointEventWeight, hs, ht,
        show productTotalMemory (fun g => boundedGhostEventTarget (t g) B (s g) (e g)) ≤ B from ht]
      exact Or.inl rfl
    · simp [coupledGhostJointEventWeight, hs, ht,
        show ¬productTotalMemory (fun g => boundedGhostEventTarget (t g) B (s g) (e g)) ≤ B from ht]
  · simp [hs, coupledGhostJointEventWeight]

theorem coupledGhostJointEventWeight_nonneg {G : Type*} [Fintype G]
    {P Z : G → Type*} (A D C ν : ∀ g, Z g → ℝ)
    (hA : ∀ g z, 0 ≤ A g z) (hD : ∀ g z, 0 ≤ D g z)
    (hC : ∀ g z, 0 ≤ C g z) (hν : ∀ g z, 0 ≤ ν g z)
    (t : G → ℕ) (B : ℕ) (s : ProductBoundedOrderedState P Z t B)
    (e : CoupledGhostEvent t B s) : 0 ≤ coupledGhostJointEventWeight A D C ν t B s e := by
  unfold coupledGhostJointEventWeight
  split_ifs
  · exact prod_nonneg fun g _ => boundedGhostEventWeight_nonneg (A g) (D g) (C g) (ν g)
      (hA g) (hD g) (hC g) (hν g) (t g) B (s g) (e g)
  · exact le_rfl

theorem coupledGhostJointEventWeight_abs {G : Type*} [Fintype G]
    {P Z : G → Type*} (A D C ν : ∀ g, Z g → ℝ)
    (hA : ∀ g z, 0 ≤ A g z) (hν : ∀ g z, 0 ≤ ν g z)
    (t : G → ℕ) (B : ℕ) (s : ProductBoundedOrderedState P Z t B)
    (e : CoupledGhostEvent t B s) :
    |coupledGhostJointEventWeight A D C ν t B s e| =
      coupledGhostJointEventWeight A (fun g z => |D g z|) (fun g z => |C g z|) ν t B s e := by
  unfold coupledGhostJointEventWeight
  split_ifs
  · rw [abs_prod]
    apply prod_congr rfl
    intro g _
    exact boundedGhostEventWeight_abs (A g) (D g) (C g) (ν g) (hA g) (hν g) (t g) B (s g) (e g)
  · exact abs_zero
end

section
open scoped BigOperators Classical
theorem prime_tuple_cell_correlation_bound (hZ : PrimitiveZeroFreeHalfPlane) :
    ∃ C : ℝ, 0 < C ∧ ∀ (q r : ℕ), 0 < q → 0 < r →
      ∀ (χ : DirichletCharacter ℂ q) (ψ : DirichletCharacter ℂ r),
      χ.IsPrimitive → ψ.IsPrimitive →
      (⟨q, χ⟩ : (n : ℕ) × DirichletCharacter ℂ n) ≠ ⟨r, ψ⟩ →
      ∀ {I : Type*} [Fintype I] [DecidableEq I],
      ∀ (P : I → Finset ℕ) (V : I → ℝ) (i : I),
      (∀ j, 0 < V j) → (∀ j p, p ∈ P j → 0 < p) →
      (∀ j, ∑ p ∈ P j, 1 / (p : ℝ) = V j) →
      ∀ a b : ℝ, P i = primeBand a b → 2 ≤ a → 0 ≤ b →
      ∀ U W : ℝ, 0 ≤ U → 0 ≤ W →
        ‖∑ x : (∀ j, P j), (finiteProductWeight (physicalLabelLaw V) x : ℂ) *
          (if U < ((∏ j, (x j).val : ℕ) : ℝ) ∧ ((∏ j, (x j).val : ℕ) : ℝ) ≤ W
          then χ ((∏ j, (x j).val : ℕ) : ZMod q) *
            star (ψ ((∏ j, (x j).val : ℕ) : ZMod r)) else 0)‖ ≤
            (C / V i) * a ^ (-(1 : ℝ) / 32) * (1 + Real.log (q * r : ℕ) / Real.log a) := by
  obtain ⟨C, hC, hbound⟩ := prime_tuple_cell_bound_of_zero_free hZ
  refine ⟨C, hC, ?_⟩
  intro q r hq hr χ ψ hχ hψ hne I _ _ P V i hV hp hmass a b hPi ha hb U W hU hW
  have hn := primitive_product_level_mul_star_ne_one χ ψ hq hr hχ hψ hne
  have h := hbound (q * r) (Nat.mul_pos hq hr)
    (χ.changeLevel (Nat.dvd_mul_right q r) * star (ψ.changeLevel (Nat.dvd_mul_left r q)))
    hn P V i hV hp hmass a b hPi ha hb U W hU hW
  simpa only [product_level_mul_star_nat_apply] using h
end

section
open scoped Classical
/-- A direct weighted bilinear estimate on the original tuple spaces.
Neither test is required to be constant on product fibers. -/
theorem weighted_product_rational_bilinear_bound
    {X Y : Type*} [Fintype X] [Fintype Y]
    (π : X → ℕ) (τ : Y → ℕ) (a N : ℕ) (A : ℤ) (V : ℕ)
    (hπrange : ∀ x, a ≤ π x ∧ π x < a + N)
    (hτrange : ∀ y, A ≤ (τ y : ℤ) ∧ (τ y : ℤ) ≤ A + (V : ℤ))
    (μ : X → ℝ) (ν : Y → ℝ) (hμ : ∀ x, 0 ≤ μ x) (hν : ∀ y, 0 ≤ ν y)
    (f : X → ℂ) (g : Y → ℂ)
    {C D P Q : ℝ} (hC : 0 ≤ C) (hD : 0 ≤ D) (hP : 0 < P) (hQ : 0 < Q)
    (hπ : ∀ x, P ≤ (π x : ℝ)) (hτ : ∀ y, Q ≤ (τ y : ℝ))
    (hμatom : ∀ m : ℕ,
      (∑ x ∈ Finset.univ.filter (fun x => π x = m), μ x) ≤ C / (m : ℝ))
    (hνatom : ∀ m : ℕ,
      (∑ y ∈ Finset.univ.filter (fun y => τ y = m), ν y) ≤ D / (m : ℝ))
    {u : ℤ} {r : ℕ} (hr : 0 < r) (hcop : (r : ℤ).gcd u = 1)
    {β : ℝ} (hβ : |β| ≤ 1 / (r : ℝ) ^ 2) :
    ‖∑ x, ∑ y, ((μ x : ℂ) * f x) * ((ν y : ℂ) * g y) *
      (Complex.exp (Complex.I * (2 * Real.pi *
        (((u : ℝ) / r + β) * τ y) : ℝ))) ^ (π x)‖ ^ 2 ≤
      ((1 + 3 * (V : ℝ) / r) *
        (2 * (N : ℝ) + 2 * (r : ℝ) * (1 + Real.log r))) *
          ((C / P) * ∑ x, μ x * ‖f x‖ ^ 2) *
          ((D / Q) * ∑ y, ν y * ‖g y‖ ^ 2) := by
  let ρ : X → Fin N := fun x => ⟨π x - a, by obtain ⟨hlo, hhi⟩ := hπrange x; omega⟩
  have hρ : ∀ x, a + (ρ x).val = π x := by
    intro x
    obtain ⟨hlo, hhi⟩ := hπrange x
    dsimp only [ρ]
    omega
  let I := ↥(Finset.univ.image τ)
  let σ : Y → I := fun y => ⟨τ y, Finset.mem_image.mpr ⟨y, Finset.mem_univ y, rfl⟩⟩
  have hI : Function.Injective (fun i : I => i.val) := fun _ _ h => Subtype.ext h
  have hIr : ∀ i : I, A ≤ (i.val : ℤ) ∧ (i.val : ℤ) ≤ A + (V : ℤ) := by
    intro i
    obtain ⟨y, hy, he⟩ := Finset.mem_image.mp i.property
    simpa only [he] using hτrange y
  have hπ' : ∀ x, P ≤ (a + (ρ x).val : ℕ) := by
    intro x
    simpa only [hρ] using hπ x
  have hμ' : ∀ m : ℕ,
      (∑ x ∈ Finset.univ.filter (fun x => a + (ρ x).val = m), μ x) ≤ C / (m : ℝ) := by
    intro m
    simpa only [hρ] using hμatom m
  have hb := weighted_indexed_rational_bilinear_bound a N ρ σ (fun i : I => i.val)
    hI A V hIr μ ν hμ hν f g hC hD hP hQ hπ' hτ hμ' hνatom hr hcop hβ
  simpa only [hρ] using hb
end

section
open Filter
theorem exists_candidate_coefficient_window_mass_comparison {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1) :
    ∃ Klo Khi : ℝ, 0 < Klo ∧ 0 < Khi ∧ ∃ J : ℕ,
      ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, J < jStar →
        Klo * (Real.exp L / L) * candidateOneMarkedHarmonicMass c L q *
          candidateQHarmonicMass c L r jStar ≤ candidateCoefficientWindowMass c L q r jStar ∧
        candidateCoefficientWindowMass c L q r jStar ≤
          Khi * (Real.exp L / L) * candidateOneMarkedHarmonicMass c L q *
            candidateQHarmonicMass c L r jStar := by
  obtain ⟨Klo, hlo, J, hlower⟩ :=
    exists_candidate_coefficient_window_mass_lower hc hr hq0 hq1 hcenter
  obtain ⟨Khi, hhi, hupper⟩ := exists_candidate_coefficient_window_mass_upper hc hq0 hr
  refine ⟨Klo, Khi, hlo, hhi, J, ?_⟩
  filter_upwards [hlower, hupper] with L hloL hhiL
  intro jStar hj
  exact ⟨hloL jStar hj, hhiL jStar (lt_of_le_of_lt (Nat.zero_le J) hj)⟩

theorem exists_candidate_coefficient_mass_polynomial_upper {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q ≤ 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ jStar : ℕ, 0 < jStar → ∀ᶠ L : ℝ in atTop,
      candidateCoefficientWindowMass c L q r jStar ≤ Real.exp L * L^C := by
  obtain ⟨K, hK, hmass⟩ := exists_candidate_coefficient_window_mass_upper hc hq0 hr
  obtain ⟨P, hP, hpmass⟩ := exists_candidate_one_marked_harmonic_polynomial_upper hc hq0 hq1
  obtain ⟨Q, hQ, hqmass⟩ := exists_candidate_Q_harmonic_polynomial_bounds hc r
  refine ⟨P + Q, add_nonneg hP hQ, ?_⟩
  intro jStar hj
  filter_upwards [hmass, hpmass, hqmass jStar,
    eventually_candidate_one_marked_mass_ge_one hc hq0 hq1,
    eventually_ge_atTop K, eventually_gt_atTop (0 : ℝ)] with L hm hp hq hp1 hKL hL
  have hp0 : 0 ≤ candidateOneMarkedHarmonicMass c L q := zero_le_one.trans hp1
  have hq0' : 0 ≤ candidateQHarmonicMass c L r jStar :=
    (Real.rpow_pos_of_pos hL (-Q)).le.trans hq.1
  have hKL' : K / L ≤ 1 := (div_le_one hL).mpr hKL
  calc
    _ ≤ K * (Real.exp L / L) * candidateOneMarkedHarmonicMass c L q *
        candidateQHarmonicMass c L r jStar := hm jStar hj
    _ = (K / L) * (Real.exp L * candidateOneMarkedHarmonicMass c L q *
        candidateQHarmonicMass c L r jStar) := by ring
    _ ≤ Real.exp L * candidateOneMarkedHarmonicMass c L q *
        candidateQHarmonicMass c L r jStar :=
      mul_le_of_le_one_left (by positivity) hKL'
    _ ≤ Real.exp L * L^P * L^Q :=
      mul_le_mul (mul_le_mul_of_nonneg_left hp (Real.exp_pos L).le) hq.2 hq0'
        (by positivity)
    _ = Real.exp L * L^(P + Q) := by rw [Real.rpow_add hL]; ring

theorem exists_candidate_coefficient_mass_polynomial_bounds {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∃ J : ℕ, ∀ jStar : ℕ, J < jStar → ∀ᶠ L : ℝ in atTop,
      Real.exp L * L^(-C) ≤ candidateCoefficientWindowMass c L q r jStar ∧
      candidateCoefficientWindowMass c L q r jStar ≤ Real.exp L * L^C := by
  obtain ⟨Clo, hlo, J, hlower⟩ :=
    exists_candidate_coefficient_mass_polynomial_lower hc hr hq0 hq1 hcenter
  obtain ⟨Chi, hhi, hupper⟩ :=
    exists_candidate_coefficient_mass_polynomial_upper hc hr hq0 hq1.le
  refine ⟨max Clo Chi, hlo.trans (le_max_left _ _), J, ?_⟩
  intro jStar hj
  filter_upwards [hlower jStar hj, hupper jStar (lt_of_le_of_lt (Nat.zero_le J) hj),
    eventually_ge_atTop (1 : ℝ)] with L hloL hhiL hL
  constructor
  · exact (mul_le_mul_of_nonneg_left
      (Real.rpow_le_rpow_of_exponent_le hL (neg_le_neg (le_max_left _ _)))
      (Real.exp_pos L).le).trans hloL
  · exact hhiL.trans (mul_le_mul_of_nonneg_left
      (Real.rpow_le_rpow_of_exponent_le hL (le_max_right _ _)) (Real.exp_pos L).le)
end

section
open Finset
open scoped Classical
section Paths
variable {P : Type*} [Fintype P] [DecidableEq P] {R : P → Type*}
  [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)]
  (a : ℕ → P → Bool) (steps : ∀ i, GlobalBirthRawStep (R := R) (a i) (a (i + 1)))

abbrev GlobalBirthAmbientEventPath (n : ℕ) (s : GlobalBirthHistoryState R) :=
  FiniteEventPath (fun i s => GlobalBirthAmbientEvent (steps i) s.2)
    (fun i => globalBirthAmbientEventTarget (steps i)) (List.range n) s

def globalBirthAmbientPathAllowed (n : ℕ) (s : GlobalBirthHistoryState R)
    (p : GlobalBirthAmbientEventPath a steps n s) : Prop :=
  finiteEventPathAllowed (fun i s => GlobalBirthAmbientEvent (steps i) s.2)
    (fun i => globalBirthAmbientEventTarget (steps i))
    (fun i => globalBirthAmbientEventAllowed (steps i)) (List.range n) s p

noncomputable def globalBirthAmbientEventPathAction (n : ℕ)
    (phase : ∀ s, GlobalBirthAmbientEventPath a steps n s → ℂ)
    (F : GlobalBirthHistoryState R → ℂ) (s : GlobalBirthHistoryState R) : ℂ :=
  let _ : ∀ i (s : GlobalBirthHistoryState R), Fintype (GlobalBirthAmbientEvent (steps i) s.2) :=
    fun i s => globalBirthAmbientEventFintype (steps i) s.2
  finiteEventPathAction (fun i s => GlobalBirthAmbientEvent (steps i) s.2)
    (fun i => globalBirthAmbientEventTarget (steps i))
    (fun i => globalBirthAmbientEventMass (steps i)) (List.range n) phase F s

/-- All local restrictions are one path mask, with no remaining ledger
dependence in the local event type or signed coefficient. -/
theorem global_birth_ambient_event_path_action_eq_masked (n : ℕ)
    (phase : ∀ s, GlobalBirthAmbientEventPath a steps n s → ℂ)
    (F : GlobalBirthHistoryState R → ℂ) (s : GlobalBirthHistoryState R) :
    let _ : ∀ i (s : GlobalBirthHistoryState R), Fintype (GlobalBirthAmbientEvent (steps i) s.2) :=
      fun i s => globalBirthAmbientEventFintype (steps i) s.2
    globalBirthAmbientEventPathAction a steps n phase F s =
      finiteEventPathAction (fun i s => GlobalBirthAmbientEvent (steps i) s.2)
        (fun i => globalBirthAmbientEventTarget (steps i))
        (fun i s => globalBirthAmbientEventWeight (steps i) s.2) (List.range n)
        (fun s p => if globalBirthAmbientPathAllowed a steps n s p then phase s p else 0) F s := by
  let _ : ∀ i (s : GlobalBirthHistoryState R), Fintype (GlobalBirthAmbientEvent (steps i) s.2) :=
    fun i s => globalBirthAmbientEventFintype (steps i) s.2
  exact finite_event_path_action_restrict _ _ _ _ _ _ _ _

theorem global_birth_ambient_event_path_mask_eq (n : ℕ)
    (allowed : ∀ s, GlobalBirthAmbientEventPath a steps n s → Prop)
    (phase : ∀ s, GlobalBirthAmbientEventPath a steps n s → ℂ)
    (F : GlobalBirthHistoryState R → ℂ) (s : GlobalBirthHistoryState R) :
    let _ : ∀ i (s : GlobalBirthHistoryState R), Fintype (GlobalBirthAmbientEvent (steps i) s.2) :=
      fun i s => globalBirthAmbientEventFintype (steps i) s.2
    globalBirthAmbientEventPathAction a steps n
      (fun s p => if allowed s p then phase s p else 0) F s =
      finiteEventPathAction (fun i s => GlobalBirthAmbientEvent (steps i) s.2)
        (fun i => globalBirthAmbientEventTarget (steps i))
        (fun i s => globalBirthAmbientEventWeight (steps i) s.2) (List.range n)
        (fun s p => if globalBirthAmbientPathAllowed a steps n s p ∧ allowed s p
          then phase s p else 0) F s := by
  rw [global_birth_ambient_event_path_action_eq_masked]
  unfold finiteEventPathAction
  apply sum_congr rfl
  intro p _
  dsimp only
  split_ifs <;> simp_all

theorem global_birth_raw_history_ambient_event_paths (n : ℕ)
    (F : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p)) :
    globalBirthRawHistory a steps n F H q =
      globalBirthAmbientEventPathAction a steps n (fun _ _ => 1)
        (fun s => F s.1 s.2) (H, q) := by
  let _ : ∀ i (s : GlobalBirthHistoryState R), Fintype (GlobalBirthAmbientEvent (steps i) s.2) :=
    fun i s => globalBirthAmbientEventFintype (steps i) s.2
  have hr : globalBirthHistoryRawRow a steps =
      finiteLocalEventAction (fun i s => GlobalBirthAmbientEvent (steps i) s.2)
        (fun i => globalBirthAmbientEventMass (steps i))
        (fun i => globalBirthAmbientEventTarget (steps i)) := by
    funext i G s
    exact global_birth_raw_step_ambient_event_sum (steps i) s G
  unfold globalBirthAmbientEventPathAction globalBirthRawHistory
  dsimp only
  rw [finite_event_path_action_one, hr]
  exact finite_row_composition_eq_event_paths _ _ _ _ _ _

/-- Existing full-ledger raw histories are exactly repeated ambient event
trajectories with one global acceptance mask. Coefficients retain all signs,
birth factorials and original edge normalizations. -/
theorem global_birth_raw_history_ambient_masked_sum (n : ℕ)
    (F : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p)) :
    let _ : ∀ i (s : GlobalBirthHistoryState R), Fintype (GlobalBirthAmbientEvent (steps i) s.2) :=
      fun i s => globalBirthAmbientEventFintype (steps i) s.2
    globalBirthRawHistory a steps n F H q =
      finiteEventPathAction (fun i s => GlobalBirthAmbientEvent (steps i) s.2)
        (fun i => globalBirthAmbientEventTarget (steps i))
        (fun i s => globalBirthAmbientEventWeight (steps i) s.2) (List.range n)
        (fun s p => if globalBirthAmbientPathAllowed a steps n s p then 1 else 0)
        (fun s => F s.1 s.2) (H, q) := by
  rw [global_birth_raw_history_ambient_event_paths, global_birth_ambient_event_path_action_eq_masked]

end Paths
end

section
open Finset
section Single
variable {P : Type*} [Fintype P] [DecidableEq P] {R : P → Type*}
  [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]

noncomputable def globalBirthRawStepUncutKernel {a b : P → Bool}
    (step : GlobalBirthRawStep (R := R) a b)
    (z w : (p : P) → GhostPhaseState (R p)) : ℂ := by
  classical
  cases step with
  | visit h β η V ρ hV cap =>
      exact ((∏ p, ghostPhaseDampedVisit (a p) (h p) η (β p) ρ (z p) (w p) : ℝ) : ℂ)
  | edge delta hshared source target hsource htarget β ρ V cap =>
      exact ((∏ p, (if b p && !(a p) then V⁻¹ else 1) *
        ghostPhaseDampedMovingEdge (b p) (a p) (delta p) (β p) ρ ρ (z p) (w p) : ℝ) : ℂ)

theorem global_birth_raw_step_kernel_of_cap {a b : P → Bool}
    (step : GlobalBirthRawStep (R := R) a b)
    (z w : (p : P) → GhostPhaseState (R p))
    (hz : (ghostPhasePendingSupport z).card ≤ globalBirthRawStepCap step) :
    globalBirthRawStepKernel step z w = globalBirthRawStepUncutKernel step z w := by
  cases step <;> exact if_pos hz

end Single

section Joint
variable {N : Nat} {P : Fin N → Type*} [∀ g, Fintype (P g)]
  [∀ g, DecidableEq (P g)] {R : (g : Fin N) → P g → Type*}
  [∀ g p, AddGroup (R g p)] [∀ g p, Fintype (R g p)]
  [∀ g p, DecidableEq (R g p)]

noncomputable def globalBirthJointKernel
    {a b : (g : Fin N) → P g → Bool}
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (cap : Nat) (z w : GlobalBirthJointPhase R) : ℂ :=
  if globalBirthJointPending z ≤ cap then ∏ g, globalBirthRawStepKernel (step g) (z g) (w g)
  else 0

theorem global_birth_joint_phase_row_eq
    {a b : (g : Fin N) → P g → Bool}
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (cap : Nat) (F : GlobalBirthJointPhase R → ℂ) (w : GlobalBirthJointPhase R) :
    globalBirthJointPhaseRow step cap F w = ∑ z, globalBirthJointKernel step cap z w * F z := by
  classical
  unfold globalBirthJointPhaseRow
  have hrow : (fun g => globalBirthRawStepPhaseRow (step g)) =
      (fun g G v => ∑ z, globalBirthRawStepKernel (step g) z v * G z) := by
    funext g G v
    exact global_birth_raw_step_phase_row_eq (step g) G v
  rw [hrow, fin_tensor_row_kernel]
  apply sum_congr rfl
  intro z _
  unfold globalBirthJointPhaseCutoff globalBirthJointKernel
  split_ifs <;> simp

theorem global_birth_joint_kernel_remove_local_caps
    {a b : (g : Fin N) → P g → Bool}
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (cap : Nat) (hcaps : ∀ g, cap ≤ globalBirthRawStepCap (step g))
    (z w : GlobalBirthJointPhase R) :
    globalBirthJointKernel step cap z w =
      if globalBirthJointPending z ≤ cap then
        ∏ g, globalBirthRawStepUncutKernel (step g) (z g) (w g) else 0 := by
  unfold globalBirthJointKernel
  split_ifs with hz
  · apply prod_congr rfl
    intro g _
    apply global_birth_raw_step_kernel_of_cap
    exact (single_le_sum (fun i _ => Nat.zero_le _) (mem_univ g)).trans (hz.trans (hcaps g))
  · rfl

noncomputable def globalBirthJointCutKernel
    {a b : (g : Fin N) → P g → Bool}
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (inputCap outputCap : Nat) (z w : GlobalBirthJointPhase R) : ℂ :=
  if globalBirthJointPending w ≤ inputCap then globalBirthJointKernel step outputCap z w else 0

theorem global_birth_joint_cut_phase_row_eq
    {a b : (g : Fin N) → P g → Bool}
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (inputCap outputCap : Nat) (F : GlobalBirthJointPhase R → ℂ) (w : GlobalBirthJointPhase R) :
    globalBirthJointCutPhaseRow step inputCap outputCap F w =
      ∑ z, globalBirthJointCutKernel step inputCap outputCap z w * F z := by
  classical
  unfold globalBirthJointCutPhaseRow globalBirthJointPhaseCutoff globalBirthJointCutKernel
  split_ifs with hw
  · exact global_birth_joint_phase_row_eq step outputCap F w
  · simp only [zero_mul, sum_const_zero]

end Joint
end

section
open Finset
open scoped Classical
section Boundary
variable {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
  [∀ g, DecidableEq (P g)] {R : (g : Fin N) → P g → Type*}

noncomputable def globalBirthJointInitial (a : (g : Fin N) → P g → Bool) : GlobalBirthJointState R :=
  fun g => (ghostPhaseActivitySupport (a g), globalBirthEmptyMemory)

theorem global_birth_joint_initial_coherent (a : (g : Fin N) → P g → Bool) :
    GlobalBirthJointCoherent a (globalBirthJointInitial (R := R) a) :=
  fun g => global_birth_empty_memory_coherent (ghostPhaseActivitySupport (a g))

theorem global_birth_joint_initial_readout (a : (g : Fin N) → P g → Bool) :
    globalBirthJointReadout a (globalBirthJointInitial (R := R) a) =
      fun g p => if a g p then none else some none := by
  funext g
  exact global_birth_initial_phase (a g)

theorem global_birth_joint_terminal_tensor (a : (g : Fin N) → P g → Bool)
    (s : GlobalBirthJointState R) (hs : GlobalBirthJointCoherent a s) :
    (∏ g, ∏ p, ghostPhaseTerminal (a g p) (globalBirthJointReadout a s g p)) =
      if ∀ g, (s g).2.1 = 0 then 1 else 0 := by
  have he (g : Fin N) : (∏ p, ghostPhaseTerminal (a g p)
      (globalBirthJointReadout a s g p)) = if (s g).2.1 = 0 then 1 else 0 :=
    global_birth_coherent_terminal_tensor (a g) (s g).1 (s g).2 (hs g)
  simp_rw [he]
  by_cases h : ∀ g, (s g).2.1 = 0
  · simp only [h, if_pos, prod_const_one, implies_true]
  · rw [if_neg h]
    obtain ⟨g, hg⟩ := not_forall.mp h
    exact prod_eq_zero (mem_univ g) (if_neg hg)

omit [∀ g, Fintype (P g)] [∀ g, DecidableEq (P g)] in
theorem global_birth_joint_empty_iff_total_zero (s : GlobalBirthJointState R) :
    (∀ g, (s g).2.1 = 0) ↔ globalBirthJointLength s = 0 := by
  simp only [globalBirthJointLength, sum_eq_zero_iff, mem_univ, true_implies]

variable [∀ g p, AddGroup (R g p)] [∀ g p, Fintype (R g p)]
  [∀ g p, DecidableEq (R g p)]

/-- The actual joint history with every total input/output cutoff agrees
with the full terminal phase tensor, evaluated at the actual initial state. -/
theorem global_birth_joint_raw_history_empty_boundary
    (a : ℕ → (g : Fin N) → P g → Bool)
    (steps : (i : ℕ) → (g : Fin N) → GlobalBirthRawStep (R := R g) (a i g) (a (i + 1) g))
    (cap : ℕ → ℕ) (n : ℕ) :
    globalBirthJointRawHistory a steps cap n
      (fun s => if ∀ g, (s g).2.1 = 0 then 1 else 0) (globalBirthJointInitial (a 0)) =
      globalBirthJointPhaseHistory a steps cap n
        (fun z => ((∏ g, ∏ p, ghostPhaseTerminal (a n g p) (z g p) : ℝ) : ℂ))
        (fun g p => if a 0 g p then none else some none) := by
  have he := global_birth_joint_raw_history_intertwines a steps cap n
    (fun s => if ∀ g, (s g).2.1 = 0 then (1 : ℂ) else 0)
    (fun z => ((∏ g, ∏ p, ghostPhaseTerminal (a n g p) (z g p) : ℝ) : ℂ))
    (by
      intro s hs
      rw [global_birth_joint_terminal_tensor (a n) s hs]
      split_ifs <;> rfl)
    (globalBirthJointInitial (a 0)) (global_birth_joint_initial_coherent (a 0))
  rw [global_birth_joint_initial_readout] at he
  exact he

end Boundary
end

section
open Finset
def physicalGroupAbsoluteHit {G : Type*} {P : G → Finset ℕ} {J ell n : ℕ}
    (x : Fin (n + 1) → PhysicalState P J ell) (g : G) (p : ↥(P g)) (j : ℕ) :
    ZMod p.val := -((x (globalBirthFiniteIndex n j)).1 : ZMod p.val)

theorem physical_group_absolute_hit_step {G : Type*} {P : G → Finset ℕ}
    {J ell n : ℕ} (x : Fin (n + 1) → PhysicalState P J ell) (g : G)
    (j : Fin n) (p : ↥(P g)) :
    physicalGroupAbsoluteHit x g p (j.val + 1) - physicalGroupAbsoluteHit x g p j.val =
      physicalGroupPhaseDelta (x j.castSucc).1 (x j.succ).1 g p := by
  unfold physicalGroupAbsoluteHit
  rw [show globalBirthFiniteIndex n (j.val + 1) = j.succ from
    global_birth_finite_index_at j.succ]
  rw [show globalBirthFiniteIndex n j.val = j.castSucc from
    global_birth_finite_index_at j.castSucc]
  exact (physical_group_phase_delta_eq_hit_difference _ _ g p).symm

section PhysicalPath
variable {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell n : ℕ}
  (C : Fin n → G → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (x : Fin (n + 1) → PhysicalState P J ell)
  (σ τ : Fin n → PhysicalPermutations G J ell)
  (hadm : ∀ j : Fin n, physicalAdmissible (C j) (aux j) (k j)
    (physicalPermutationEquiv (σ j) (x j.castSucc))
    (physicalPermutationEquiv (τ j) (x j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (g : G)
  (hk : ∀ j : Fin n, ∀ s, ¬ (((x j.castSucc).2.val g s).val : ℤ) ∣ k j)
  (β : ↥(P g) → ℝ) (η : Fin (n + 1) → ℝ) (V ρ : ℝ) (hV : V ≠ 0) (cap : ℕ)

noncomputable def physicalGroupCappedVisitKernel (j : ℕ) :
    ((p : ↥(P g)) → GhostPhaseState (ZMod p.val)) →
    ((p : ↥(P g)) → GhostPhaseState (ZMod p.val)) → ℝ :=
  ghostPhaseCappedDampedVisit
    (globalBirthFiniteActivity (physicalGroupFiniteActivity x g) j) (fun _ => 0)
    (fun _ => η (globalBirthFiniteIndex n j)) β (fun _ => ρ) cap

variable [∀ p : ↥(P g), NeZero p.val]

noncomputable def physicalGroupCappedMovingEdgeKernel (j : ℕ) :
    ((p : ↥(P g)) → GhostPhaseState (ZMod p.val)) →
    ((p : ↥(P g)) → GhostPhaseState (ZMod p.val)) → ℝ :=
  ghostPhaseCappedDampedMovingEdge
    (globalBirthFiniteActivity (physicalGroupFiniteActivity x g) (j + 1))
    (globalBirthFiniteActivity (physicalGroupFiniteActivity x g) j)
    (fun p => physicalGroupAbsoluteHit x g p (j + 1) - physicalGroupAbsoluteHit x g p j)
    β (fun _ => V) (fun _ => ρ) (fun _ => ρ) cap

omit [Fintype G] in
theorem physical_group_visit_kernel_to_real (j : Fin (n + 1))
    (z w : (p : ↥(P g)) → GhostPhaseState (ZMod p.val)) :
    globalBirthRawStepKernel (physicalGroupFiniteVisit x g β η V ρ hV cap j) z w =
      (physicalGroupCappedVisitKernel x g β η ρ cap j.val z w : ℂ) := by
  unfold physicalGroupCappedVisitKernel
  rw [global_birth_finite_activity_at, global_birth_finite_index_at]
  change globalBirthRawStepKernel (.visit (a := physicalGroupPhaseActivity (x j).2.val g)
    (fun _ => 0) β (η j) V ρ hV cap) z w = _
  rw [global_birth_raw_step_kernel_visit]
  unfold ghostPhaseCappedDampedVisit
  split_ifs <;> rfl

theorem physical_group_permuted_edge_kernel_to_real (j : Fin n)
    (z w : (p : ↥(P g)) → GhostPhaseState (ZMod p.val)) :
    globalBirthRawStepKernel
      (physicalGroupPermutedFiniteEdge C aux k x σ τ hadm hP hdis g hk β V ρ cap j) z w =
      (physicalGroupCappedMovingEdgeKernel x g β V ρ cap j.val z w : ℂ) := by
  unfold physicalGroupCappedMovingEdgeKernel
  rw [show globalBirthFiniteActivity (physicalGroupFiniteActivity x g) (j.val + 1) =
      physicalGroupFiniteActivity x g j.succ from
    global_birth_finite_activity_at _ j.succ]
  rw [show globalBirthFiniteActivity (physicalGroupFiniteActivity x g) j.val =
      physicalGroupFiniteActivity x g j.castSucc from
    global_birth_finite_activity_at _ j.castSucc]
  simp_rw [physical_group_absolute_hit_step x g j]
  refine (physical_group_permuted_raw_edge_kernel (C j) (aux j) (k j) (σ j) (τ j)
    (hadm j) hP hdis g (hk j) β ρ V cap z w).trans ?_
  simp only [physicalGroupRawEdge, global_birth_raw_step_kernel_edge,
    physical_permutation_marks, physical_permutation_position,
    physical_group_phase_activity_permute]
  unfold ghostPhaseCappedDampedMovingEdge
  split_ifs <;> rfl

/-- The finite atomic physical kernels are exactly the real capped kernels,
after their canonical complex embedding. Only used time indices are compared. -/
theorem physical_group_permuted_atomic_kernel_to_real (i : ℕ) (hi : i < 2 * n + 1)
    (z w : (p : ↥(P g)) → GhostPhaseState (ZMod p.val)) :
    globalBirthRawStepKernel
      (physicalGroupPermutedFiniteStep C aux k x σ τ hadm hP hdis g hk β η V ρ hV cap i) z w =
      ((finiteAlternatingKernel (physicalGroupCappedVisitKernel x g β η ρ cap)
        (physicalGroupCappedMovingEdgeKernel x g β V ρ cap) i z w : ℝ) : ℂ) := by
  by_cases hp : i % 2 = 0
  · let j : Fin (n + 1) := ⟨i / 2, by omega⟩
    have hi' : i = 2 * j.val := by dsimp [j]; omega
    rw [hi', finite_alternating_kernel_even]
    exact (global_birth_finite_alternating_kernel_even (physicalGroupFiniteActivity x g)
      (physicalGroupFiniteVisit x g β η V ρ hV cap)
      (physicalGroupPermutedFiniteEdge C aux k x σ τ hadm hP hdis g hk β V ρ cap) j z w).trans
      (physical_group_visit_kernel_to_real x g β η V ρ hV cap j z w)
  · let j : Fin n := ⟨i / 2, by omega⟩
    have hi' : i = 2 * j.val + 1 := by dsimp [j]; omega
    rw [hi', finite_alternating_kernel_odd]
    exact (global_birth_finite_alternating_kernel_odd (physicalGroupFiniteActivity x g)
      (physicalGroupFiniteVisit x g β η V ρ hV cap)
      (physicalGroupPermutedFiniteEdge C aux k x σ τ hadm hP hdis g hk β V ρ cap) j z w).trans
      (physical_group_permuted_edge_kernel_to_real C aux k x σ τ hadm hP hdis g hk β V ρ cap j z w)

/-- Exact real/complex identification of the existing normalized physical
history, including both endpoint permutations and all atomic memory caps. -/
theorem physical_group_normalized_history_eq_capped_moving :
    ((∏ s : PhysicalSlots J ell, β ((x 0).2.val g s) / V : ℝ) : ℂ) *
      physicalGroupPermutedFiniteRawHistory C aux k x σ τ hadm hP hdis g hk β η V ρ hV cap =
      (ghostPhaseCappedMovingDampedHistory
        (fun p j => globalBirthFiniteActivity (physicalGroupFiniteActivity x g) j p)
        (physicalGroupAbsoluteHit x g) (fun _ j => η (globalBirthFiniteIndex n j))
        β (fun _ => V) (fun _ _ => ρ) (fun _ => cap) (fun _ => cap) n : ℂ) := by
  rw [physical_group_permuted_normalized_history_trace]
  have he := complex_trace_eq_real_alternating
    (physicalGroupCappedVisitKernel x g β η ρ cap)
    (physicalGroupCappedMovingEdgeKernel x g β V ρ cap)
    (fun i => globalBirthRawStepKernel
      (physicalGroupPermutedFiniteStep C aux k x σ τ hadm hP hdis g hk β η V ρ hV cap i))
    (fun z => ∏ p, ghostPhaseRunInitial (physicalGroupPhaseActivity (x 0).2.val g p)
      (β p) V (z p))
    (fun z => ∏ p, ghostPhaseTerminal
      (physicalGroupPhaseActivity (x (Fin.last n)).2.val g p) (z p)) n
    (physical_group_permuted_atomic_kernel_to_real C aux k x σ τ hadm hP hdis g hk β η V ρ hV cap)
  have h0 : globalBirthFiniteActivity (physicalGroupFiniteActivity x g) 0 =
      physicalGroupPhaseActivity (x 0).2.val g :=
    global_birth_finite_activity_at (physicalGroupFiniteActivity x g) (0 : Fin (n + 1))
  have hn : globalBirthFiniteActivity (physicalGroupFiniteActivity x g) n =
      physicalGroupPhaseActivity (x (Fin.last n)).2.val g :=
    global_birth_finite_activity_at (physicalGroupFiniteActivity x g) (Fin.last n)
  refine he.trans ?_
  congr 1
  unfold ghostPhaseCappedMovingDampedHistory
  change finiteAlternatingPairing _ _ _ _ n =
    finiteAlternatingPairing (physicalGroupCappedVisitKernel x g β η ρ cap)
      (physicalGroupCappedMovingEdgeKernel x g β V ρ cap) _ _ n
  dsimp only
  rw [h0, hn]

/-- Auxiliary rho and moving frames are removed from the actual physical
history under rho != 0. The exact visit and edge cutoff remains in force. -/
theorem physical_group_normalized_history_eq_capped_absolute (hρ : ρ ≠ 0) :
    ((∏ s : PhysicalSlots J ell, β ((x 0).2.val g s) / V : ℝ) : ℂ) *
      physicalGroupPermutedFiniteRawHistory C aux k x σ τ hadm hP hdis g hk β η V ρ hV cap =
      (ghostPhaseCappedHistory
        (fun p j => globalBirthFiniteActivity (physicalGroupFiniteActivity x g) j p)
        (physicalGroupAbsoluteHit x g) (fun _ j => η (globalBirthFiniteIndex n j))
        β (fun _ => V) (fun _ => cap) (fun _ => cap) n : ℂ) := by
  rw [physical_group_normalized_history_eq_capped_moving]
  rw [ghost_phase_capped_moving_history_eq_undamped _ _ _ _ _ _ _ _ (fun _ _ => hρ)]

/-- When the cap is at least the whole group pool, it excludes no phase
state and the actual normalized physical history is the product of the
original one-prime lifespan histories. -/
theorem physical_group_normalized_history_eq_run_product (hρ : ρ ≠ 0)
    (hcap : (P g).card ≤ cap) :
    ((∏ s : PhysicalSlots J ell, β ((x 0).2.val g s) / V : ℝ) : ℂ) *
      physicalGroupPermutedFiniteRawHistory C aux k x σ τ hadm hP hdis g hk β η V ρ hV cap =
      ((∏ p : ↥(P g), ghostPhaseRunHistory
        (fun j => globalBirthFiniteActivity (physicalGroupFiniteActivity x g) j p)
        (physicalGroupAbsoluteHit x g p) (fun j => η (globalBirthFiniteIndex n j))
        (β p) V n : ℝ) : ℂ) := by
  have hc : Fintype.card ↥(P g) ≤ cap := by simpa only [Fintype.card_coe] using hcap
  rw [physical_group_normalized_history_eq_capped_absolute C aux k x σ τ hadm hP hdis g hk
    β η V ρ hV cap hρ]
  rw [ghost_phase_capped_history_eq_run_product _ _ _ _ _ _ _ (fun _ => hc) (fun _ => hc)]

end PhysicalPath
end

section
open Finset Classical
theorem tilted_physical_ghost_cutoff_product_energy_le
    {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (V : G → ℝ) (baseline : ∀ g, P g → ℝ)
    (hpositive : ∀ g (p : P g), 0 < p.val)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (hbaseline : ∀ g p, 1 / 2 ≤ baseline g p ∧ baseline g p ≤ 1)
    (q ρ v vmax : ℝ) (t : G → ℕ) (B : ℕ)
    (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (hρ : 0 < ρ) (hv : 0 < v)
    (hV : ∀ g, 0 < V g) (hVmax : ∀ g, V g ≤ vmax)
    (hD : q / ρ ^ 2 + ((1 - q) / ρ) / v ≤ 1)
    (hC : ∀ g, q / ρ ^ 2 + ((1 - q) * V g / ρ) / v ≤ 1)
    (groups : Finset G)
    (f : ProductBoundedOrderedState (fun g => P g)
      (fun g => UnrestrictedResidueParticle (fun p : P g => p.val)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    let _ : ∀ g (p : P g), NeZero p.val := fun g p => ⟨Nat.ne_of_gt (hpositive g p)⟩
    finiteWeightedEnergy
      (productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (baseline g))
        (fun g => unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g (baseline g))))
      (physicalGhostCutoffProductOperator (fun g (p : P g) => p.val)
        (fun g => tiltedPhysicalBirthLaw V g (baseline g)) q ρ V t B groups f) ≤
    physicalGhostUniformEnergyBound ρ vmax v ^ groups.card *
      finiteWeightedEnergy
        (productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (baseline g))
          (fun g => unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g (baseline g)))) f := by
  let _ : ∀ g (p : P g), NeZero p.val := fun g p => ⟨Nat.ne_of_gt (hpositive g p)⟩
  apply physical_ghost_cutoff_product_energy_le (fun g (p : P g) => p.val)
    (fun g => tiltedPhysicalBirthLaw V g (baseline g)) q ρ V v vmax t B
    _ _ hq0 hq1 hρ (fun g => (hV g).le) hVmax hv hD hC groups f hf
  · intro g p
    exact tiltedPhysicalBirthLaw_pos V g (baseline g) (hV g) (hpositive g)
      (fun p => lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1 / 2) (hbaseline g p).1) p
  · intro g
    exact (tiltedPhysicalBirthLaw_sum_bounds V g (baseline g) (hV g) (hMass g) (hbaseline g)).2

theorem tilted_physical_ghost_cutoff_product_energy_le_rpow
    {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (V : G → ℝ) (baseline : ∀ g, P g → ℝ)
    (hpositive : ∀ g (p : P g), 0 < p.val)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (hbaseline : ∀ g p, 1 / 2 ≤ baseline g p ∧ baseline g p ≤ 1)
    (q ρ v vmax : ℝ) (t : G → ℕ) (B : ℕ)
    (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (hρ : 0 < ρ) (hv : 0 < v)
    (hV : ∀ g, 0 < V g) (hVmax : ∀ g, V g ≤ vmax)
    (hD : q / ρ ^ 2 + ((1 - q) / ρ) / v ≤ 1)
    (hC : ∀ g, q / ρ ^ 2 + ((1 - q) * V g / ρ) / v ≤ 1)
    (groups : Finset G) {L K : ℝ} (hL : 0 < L) (hcard : (groups.card : ℝ) ≤ K * Real.log L)
    (f : ProductBoundedOrderedState (fun g => P g)
      (fun g => UnrestrictedResidueParticle (fun p : P g => p.val)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    let _ : ∀ g (p : P g), NeZero p.val := fun g p => ⟨Nat.ne_of_gt (hpositive g p)⟩
    finiteWeightedEnergy
      (productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (baseline g))
        (fun g => unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g (baseline g))))
      (physicalGhostCutoffProductOperator (fun g (p : P g) => p.val)
        (fun g => tiltedPhysicalBirthLaw V g (baseline g)) q ρ V t B groups f) ≤
    L ^ (K * Real.log (max 1 (physicalGhostUniformEnergyBound ρ vmax v))) *
      finiteWeightedEnergy
        (productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (baseline g))
          (fun g => unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g (baseline g)))) f := by
  let _ : ∀ g (p : P g), NeZero p.val := fun g p => ⟨Nat.ne_of_gt (hpositive g p)⟩
  apply group_energy_bound_of_log_card groups (Real.exp_pos _).le hL _ hcard
    (tilted_physical_ghost_cutoff_product_energy_le P V baseline hpositive hMass hbaseline
      q ρ v vmax t B hq0 hq1 hρ hv hV hVmax hD hC groups f hf)
  apply sum_nonneg
  intro s _
  apply mul_nonneg _ (sq_nonneg _)
  exact (physical_product_memory_weight_pos P V baseline hV hpositive
    (fun g p => lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1 / 2) (hbaseline g p).1) t B s).le
end

section
open Finset Classical
noncomputable def physicalAbsoluteBoundedGhostOperator {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (q ρ V : ℝ) (t B : ℕ) :=
  boundedOrderedGhostOperator (P := P) (physicalGhostRetention n q ρ)
    (fun z => |physicalGhostTermination n q ρ z|)
    (fun z => |physicalGhostBirth n q ρ V z|) (unrestrictedResidueWeight μ) t B

theorem physical_bounded_ghost_absolute_energy_le_uniform {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ)
    (q ρ V v vmax : ℝ) (t B : ℕ) (hμ : ∀ p, 0 < μ p)
    (hmass : ∑ p, μ p ≤ 2) (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (hρ : 0 < ρ) (hV : 0 ≤ V) (hVmax : V ≤ vmax) (hv : 0 < v)
    (hD : q / ρ ^ 2 + ((1 - q) / ρ) / v ≤ 1)
    (hC : q / ρ ^ 2 + ((1 - q) * V / ρ) / v ≤ 1)
    (f : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
    (hf : BoundedOrderedSymmetric f) :
    finiteWeightedEnergy (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ))
      (physicalAbsoluteBoundedGhostOperator n μ q ρ V t B f) ≤
      physicalGhostUniformEnergyBound ρ vmax v *
        finiteWeightedEnergy (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ)) f := by
  have hη : 0 ≤ 1 - q := sub_nonneg.mpr hq1
  have hD0 : 0 ≤ (1 - q) / ρ := div_nonneg hη hρ.le
  have hC0 : 0 ≤ (1 - q) * V / ρ := div_nonneg (mul_nonneg hη hV) hρ.le
  have hA' (z : UnrestrictedResidueParticle n) : 0 ≤ physicalGhostRetention n q ρ z := by
    unfold physicalGhostRetention
    split_ifs
    · exact div_nonneg hq0 (sq_nonneg ρ)
    · exact zero_le_one
  have hD' (z : UnrestrictedResidueParticle n) :
      physicalGhostRetention n q ρ z + abs (abs (physicalGhostTermination n q ρ z)) / v ≤ 1 := by
    by_cases hz : unrestrictedResidueHit z
    · simpa [physicalGhostRetention, physicalGhostTermination, hz, abs_of_nonneg hD0] using hD
    · simp [physicalGhostRetention, physicalGhostTermination, hz]
  have hC' (z : UnrestrictedResidueParticle n) :
      physicalGhostRetention n q ρ z + abs (abs (physicalGhostBirth n q ρ V z)) / v ≤ 1 := by
    by_cases hz : unrestrictedResidueHit z
    · simpa [physicalGhostRetention, physicalGhostBirth, hz, abs_of_nonneg hC0] using hC
    · simp [physicalGhostRetention, physicalGhostBirth, hz]
  have h := bounded_ordered_ghost_energy_le μ (physicalGhostRetention n q ρ)
    (fun z => |physicalGhostTermination n q ρ z|) (fun z => |physicalGhostBirth n q ρ V z|)
    (unrestrictedResidueWeight μ) (fun _ => v) t B
    (fun p => (hμ p).le) hA' (fun z => hμ z.1) (fun _ => hv) hD' hC' f hf
  simp only [abs_abs] at h
  rw [physical_ghost_exponent_eq n μ q ρ V v hq1 hρ.le hV] at h
  have hη1 : 1 - q ≤ 1 := sub_le_self _ hq0
  have hAV : (1 - q) * V ≤ vmax := by
    have hAV' : (1 - q) * V ≤ V := by
      simpa only [one_mul] using mul_le_mul_of_nonneg_right hη1 hV
    exact hAV'.trans hVmax
  have hcoeff : (1 - q) * V / ρ + (1 - q) / ρ ≤ (vmax + 1) / ρ := by
    rw [add_div]
    exact add_le_add (div_le_div_of_nonneg_right hAV hρ.le)
      (div_le_div_of_nonneg_right hη1 hρ.le)
  have he : ((1 - q) * V / ρ + (1 - q) / ρ) * v * (∑ p, μ p) ≤
      2 * (vmax + 1) * v / ρ := by
    calc
      _ ≤ ((1 - q) * V / ρ + (1 - q) / ρ) * v * 2 :=
        mul_le_mul_of_nonneg_left hmass (mul_nonneg (add_nonneg hC0 hD0) hv.le)
      _ ≤ ((vmax + 1) / ρ) * v * 2 :=
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hcoeff hv.le) (by norm_num)
      _ = _ := by ring
  exact h.trans (mul_le_mul_of_nonneg_right (Real.exp_le_exp.mpr he)
    (sum_nonneg fun s _ => mul_nonneg
      (boundedOrderedStateWeight_nonneg μ (unrestrictedResidueWeight μ)
        (fun p => (hμ p).le) (fun z => (hμ z.1).le) s) (sq_nonneg _)))

noncomputable def physicalAbsoluteGhostProductOperator
    {G : Type*} [DecidableEq G] {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] (μ : ∀ g, P g → ℝ)
    (q ρ : ℝ) (V : G → ℝ) (t : G → ℕ) (B : ℕ) (groups : Finset G) :=
  finiteCoordinateFinsetAction
    (fun g => physicalAbsoluteBoundedGhostOperator (n g) (μ g) q ρ (V g) (t g) B) groups

noncomputable def physicalAbsoluteGhostCutoffProductOperator
    {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] (μ : ∀ g, P g → ℝ)
    (q ρ : ℝ) (V : G → ℝ) (t : G → ℕ) (B : ℕ) (groups : Finset G)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ) :=
  productMemoryCutoff
    (physicalAbsoluteGhostProductOperator n μ q ρ V t B groups (productMemoryCutoff f))

theorem physical_ghost_absolute_cutoff_product_energy_le
    {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] (μ : ∀ g, P g → ℝ)
    (q ρ : ℝ) (V : G → ℝ) (v vmax : ℝ) (t : G → ℕ) (B : ℕ)
    (hμ : ∀ g p, 0 < μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (hρ : 0 < ρ)
    (hV : ∀ g, 0 ≤ V g) (hVmax : ∀ g, V g ≤ vmax) (hv : 0 < v)
    (hD : q / ρ ^ 2 + ((1 - q) / ρ) / v ≤ 1)
    (hC : ∀ g, q / ρ ^ 2 + ((1 - q) * V g / ρ) / v ≤ 1)
    (groups : Finset G)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (physicalAbsoluteGhostCutoffProductOperator n μ q ρ V t B groups f) ≤
    physicalGhostUniformEnergyBound ρ vmax v ^ groups.card *
      finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  have hlocal (g : G) (h : BoundedOrderedState (P g)
      (UnrestrictedResidueParticle (n g)) (t g) B → ℂ) (hh : BoundedOrderedSymmetric h) :=
    physical_bounded_ghost_absolute_energy_le_uniform (n g) (μ g) q ρ (V g) v vmax (t g) B
      (hμ g) (hmass g) hq0 hq1 hρ (hV g) (hVmax g) hv hD (hC g) h hh
  have h := product_symmetric_cutoff_sandwich_energy_le μ
    (fun g => unrestrictedResidueWeight (μ g))
    (fun g p => (hμ g p).le) (fun g z => (hμ g z.1).le)
    (fun g => physicalAbsoluteBoundedGhostOperator (n g) (μ g) q ρ (V g) (t g) B)
    (fun _ => physicalGhostUniformEnergyBound ρ vmax v)
    (fun _ => (Real.exp_pos _).le) hlocal groups f hf
  simpa only [prod_const, physicalAbsoluteGhostCutoffProductOperator,
    physicalAbsoluteGhostProductOperator, finiteWeightedEnergy] using h
end

