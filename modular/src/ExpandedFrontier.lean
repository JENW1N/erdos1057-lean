/- Exact mixed Fourier formula over all original paths; the small residue average remains outside the word. -/

open Finset MeasureTheory
open scoped Classical
namespace Bounty

theorem physical_root_residue_model_mixed_fourier
    {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    [∀ a : PhysicalPrime P, NeZero a.2.val]
    (groups : Finset (Fin N)) (V : Fin N → ℝ) (patterns : Finset I)
    (C : I → Fin N → Finset (Fin J)) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ)
    (hV : ∀ g, 0 < V g)
    (hP : ∀ g a, a ∈ P g → Nat.Prime a)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hk : ∀ t < n + 1, ∀ i ∈ patterns, ∀ g a, a ∈ P g → ¬ (a : ℤ) ∣ k t i)
    (b : PhysicalPrime P → ℝ)
    (hb : ∀ a : PhysicalPrime P, a.1 ∈ groups →
      b a = 1 - (∑ j ∈ range (n + 2), (1 - physicalEndpointSchedule q (n + 1) j)) / a.2.val)
    (hb0 : ∀ a : PhysicalPrime P, a.1 ∈ groups → b a ≠ 0)
    (B : ℕ) (hB : (physicalPrimeGroups P groups).card ≤ B) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    physicalRootResidueModel V patterns C q ζ k K n =
      (∏ a ∈ physicalPrimeGroups P groups, b a : ℝ) *
      ∑ r : PhysicalGroupResidues P groupsᶜ,
        (∏ a : ↥(physicalPrimeGroups P groupsᶜ), 1 / (a.val.2.val : ℝ)) *
        ∫ θ : ℝ in (0 : ℝ)..1,
        ∑ L : PhysicalMarkLists P J ell,
        ∑ p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
        (((physicalStateMass (fun g : ↥groupsᶜ => V g.val) J ell *
          ∏ j ∈ range (n + 1), physicalCompletionMass (fun g : ↥groupsᶜ => V g.val)
            (fun g => C (finitePathLabels p j).2.2.1.val g.val) ell : ℝ) : ℂ) *
          physicalMemoryFourierWalkScalar V patterns C ζ k K (finitePathLabels p) (finitePathMarks L p) (n + 1) θ *
          physicalGroupFiniteVertexWeight groupsᶜ C q k L p r *
          physicalGroupFiniteCappedHistory groups C q k
            (fun a => ((a.2.val : ℝ) * b a)⁻¹) V B L p) := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  rw [physical_root_residue_model_mixed_unrestricted groups V patterns C q ζ k K hV hP hdis hk b hb hb0 B hB]
  congr 1
  apply sum_congr rfl
  intro r _
  congr 1
  symm
  rw [intervalIntegral.integral_finsetSum]
  · apply sum_congr rfl
    intro L _
    rw [intervalIntegral.integral_finsetSum]
    · apply sum_congr rfl
      intro p _
      rw [intervalIntegral.integral_mul_const, intervalIntegral.integral_mul_const,
        intervalIntegral.integral_const_mul]
      have he := physical_memory_fourier_return_integral V patterns C ζ k K
        (finitePathLabels p) (finitePathMarks L p) (n + 1) 1
      simp only [mul_one] at he
      rw [he]
      split_ifs <;> simp only [mul_zero, zero_mul]
    · intro p _
      exact (((continuous_const.mul (physical_memory_fourier_walk_scalar_continuous V patterns C ζ k K
        (finitePathLabels p) (finitePathMarks L p) (n + 1))).mul continuous_const).mul continuous_const).intervalIntegrable _ _
  · intro L _
    apply Continuous.intervalIntegrable
    apply continuous_finsetSum
    intro p _
    exact ((continuous_const.mul (physical_memory_fourier_walk_scalar_continuous V patterns C ζ k K
      (finitePathLabels p) (finitePathMarks L p) (n + 1))).mul continuous_const).mul continuous_const

end Bounty
