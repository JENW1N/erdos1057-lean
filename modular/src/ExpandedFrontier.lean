/- Replacing both literal selected endpoints on the original harmonic support. -/

open Finset
open scoped Classical
namespace Bounty

theorem selected_harmonic_peel_replacement
    {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) {q v : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v)
    (V : G → ℝ) (t : G → ℕ) (T : ℕ)
    (hV : ∀ g, v ≤ V g) (ht : ∀ g, t g ≤ T)
    (hprime : ∀ g, ∀ p ∈ P g, p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (g : G) (k : ℕ) (htg : t g = k + 1) (big : Finset G) (hsmall : g ∉ big)
    (b₀ b₁ : GroupMarkedLists (fun h : big => P h.val) (fun h : big => t h.val) → ℂ)
    {H : ℝ} (hH : 0 ≤ H) (hb₀ : ∀ l, ‖b₀ l‖ ≤ H) (hb₁ : ∀ l, ‖b₁ l‖ ≤ H)
    (Q : Finset ℕ) (hQ : ∀ g, P g ⊆ Q) (α₀ β₀ γ₀ α₁ β₁ γ₁ : ℕ → ℂ)
    (hα₀free : ∀ d, ¬ Disjoint d.primeFactors Q → α₀ d = 0)
    (hβ₀free : ∀ d, ¬ Disjoint d.primeFactors Q → β₀ d = 0)
    (hα₁free : ∀ d, ¬ Disjoint d.primeFactors Q → α₁ d = 0)
    (hβ₁free : ∀ d, ¬ Disjoint d.primeFactors Q → β₁ d = 0)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα₀ : ∀ m, ‖α₀ m‖ ≤ A) (hβ₀ : ∀ p, ‖β₀ p‖ ≤ B) (hγ₀ : ∀ r, ‖γ₀ r‖ ≤ C)
    (hα₁ : ∀ m, ‖α₁ m‖ ≤ A) (hβ₁ : ∀ p, ‖β₁ p‖ ≤ B) (hγ₁ : ∀ r, ‖γ₁ r‖ ≤ C)
    (S : Finset ℤ) (δ : ℤ) (N : ℕ) (θ : ℤ → ℂ)
    {Y K : ℝ} (hY : 0 < Y) (hK : 0 ≤ K)
    (hS : ∀ n ∈ S, 0 < n ∧ n ≤ (N : ℤ))
    (hshift : ∀ n ∈ S, 0 < n+δ ∧ n+δ ≤ (N : ℤ))
    (hYlow : ∀ n ∈ S, Y ≤ (n : ℝ)) (hθ : ∀ n ∈ S, ‖θ n‖ ≤ K) :
    let E := ((markedDivisorBound q v T) ^ Fintype.card G * H) ^ 2 *
      ((A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15)
    let D := H ^ 2 *
      (((markedDivisorBound q v T) ^ Fintype.card G * (1 + 2 * Real.log N / v)) ^ 2 *
        (((A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15) *
          ∑ p ∈ P g, 1 / (p : ℝ) ^ 2))
    ‖(∑ n ∈ S, (θ n / (n : ℂ)) *
        (starRingEnd ℂ) (selectedMarkedEndpoint P q V t big b₀ Q α₀ β₀ γ₀ n.natAbs) *
        selectedMarkedEndpoint P q V t big b₁ Q α₁ β₁ γ₁ (n+δ).natAbs) -
      (∑ n ∈ S, (θ n / (n : ℂ)) *
        (starRingEnd ℂ) (selectedPeeledEndpoint P q V t g k big b₀ Q α₀ β₀ γ₀ n.natAbs) *
        selectedPeeledEndpoint P q V t g k big b₁ Q α₁ β₁ γ₁ (n+δ).natAbs)‖ ≤
      (K/Y) * (Real.sqrt D * Real.sqrt E + Real.sqrt (2*(E+D)) * Real.sqrt D) := by
  dsimp only
  apply finite_harmonic_replacement_energy_bound S θ _ _ _ _ hY hK hYlow hθ
  · simpa only [add_zero] using selected_shifted_endpoint_energy P hq0 hq1 hv V t T hV ht
      big b₀ hH hb₀ Q α₀ β₀ γ₀ hA hB hC hα₀ hβ₀ hγ₀ S 0 N
        (by simpa only [add_zero] using hS)
  · exact selected_shifted_endpoint_energy P hq0 hq1 hv V t T hV ht
      big b₁ hH hb₁ Q α₁ β₁ γ₁ hA hB hC hα₁ hβ₁ hγ₁ S δ N hshift
  · simpa only [add_zero] using selected_shifted_peel_error_energy P hq0 hq1 hv V t T hV ht
      hprime hdis g k htg big hsmall b₀ hH hb₀ Q hQ α₀ β₀ γ₀ hα₀free hβ₀free
      hA hB hC hα₀ hβ₀ hγ₀ S 0 N (by simpa only [add_zero] using hS)
  · exact selected_shifted_peel_error_energy P hq0 hq1 hv V t T hV ht
      hprime hdis g k htg big hsmall b₁ hH hb₁ Q hQ α₁ β₁ γ₁ hα₁free hβ₁free
      hA hB hC hα₁ hβ₁ hγ₁ S δ N hshift

end Bounty
end

section

/- The whole common window has a local Fourier-to-Mellin estimate with unchanged coefficients. -/

open Finset MeasureTheory

namespace Bounty

theorem exists_wide_local_fourier_mellin_energy_constants {j : ℕ} (hj : 2 ≤ j) :
    ∃ Cj Cerr : ℝ, 0 < Cj ∧ 0 < Cerr ∧
      ∀ (S : Finset ℕ) (a : ℕ → ℂ) (Y H : ℝ),
      0 < Y → 1 ≤ H → H ≤ Y/64 →
      (∀ n ∈ S, Y/8 ≤ (n:ℝ) ∧ (n:ℝ) ≤ 64*Y) →
      (∫ β in {β : ℝ | |β| ≤ 1/H}, ‖localAdditivePolynomial S a β‖^2) ≤
        (Cj/Y) * (∫ t : ℝ, (1+|(H/Y)*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2) +
          Cerr * (H/Y)^2 * (∑ n ∈ S, ‖a n‖^2) := by
  obtain ⟨Cj,Cerr,hCj,hCerr,hinterval⟩ := exists_local_additive_mellin_interval_constants hj
  refine ⟨72*Cj*(32:ℝ)^j,576*Cerr,by positivity,by positivity,?_⟩
  intro S a Y H hY hH hsmall hS
  have hHp : 0 < H := lt_of_lt_of_le zero_lt_one hH
  have hSpos : ∀ n ∈ S, 0 < n := by
    intro n hn
    have hp : 0 < (n:ℝ) := (by positivity : 0 < Y/8).trans_le (hS n hn).1
    exact_mod_cast hp
  let I : ℝ := ∫ t : ℝ, (1+|(H/Y)*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2
  let E : ℝ := ∑ n ∈ S, ‖a n‖^2
  have hI : 0 ≤ I := integral_nonneg (fun t => by positivity)
  have hE : 0 ≤ E := sum_nonneg (fun n _ => sq_nonneg _)
  have hlocal (i : ℕ) (hi : i ∈ range 9) :
      (4/H^2) * (∫ v in Set.Icc (((Y/8)*(2:ℝ)^i)/2) (3*((Y/8)*(2:ℝ)^i)),
        ‖localAdditiveConvolution S a H v‖^2) ≤
        (8*Cj*(32:ℝ)^j/Y)*I + 64*Cerr*(H/Y)^2*E := by
    let Z : ℝ := (Y/8)*(2:ℝ)^i
    have hZ : 0 < Z := by dsimp [Z]; positivity
    obtain ⟨hZlo,hZhi⟩ := wide_mellin_scale_bounds hY hi
    have hHZ : H ≤ Z/8 := by dsimp [Z]; linarith
    have hbound := hinterval S a hSpos Z H hZ hH hHZ
    have hscale := local_mellin_energy_scale_le hj S a hY hZ hHp hZhi
    have hIz : 0 ≤ ∫ t : ℝ, (1+|(H/Z)*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2 :=
      integral_nonneg (fun t => by positivity)
    have hdiv : Cj/Z ≤ 8*Cj/Y := by
      apply (div_le_div_iff₀ hZ hY).mpr
      dsimp [Z]
      nlinarith [mul_le_mul_of_nonneg_left hZlo hCj.le]
    have hm : (Cj/Z) * (∫ t : ℝ, (1+|(H/Z)*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2) ≤
        (8*Cj*(32:ℝ)^j/Y)*I := by
      calc
        _ ≤ (8*Cj/Y)*((32:ℝ)^j*I) :=
          mul_le_mul hdiv hscale hIz (by positivity)
        _ = _ := by ring
    have hratio : H/Z ≤ 8*(H/Y) := by
      calc
        _ ≤ H/(Y/8) := div_le_div_of_nonneg_left hHp.le (by positivity) hZlo
        _ = _ := by ring
    have he : Cerr*(H/Z)^2*E ≤ 64*Cerr*(H/Y)^2*E := by
      have hs := pow_le_pow_left₀ (by positivity : 0 ≤ H/Z) hratio 2
      have he' := mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hs hCerr.le) hE
      calc
        _ ≤ Cerr*(8*(H/Y))^2*E := he'
        _ = _ := by ring
    exact hbound.trans (add_le_add hm he)
  have hcont := (local_additive_convolution_contDiff S a H).continuous
  have hcover := finite_cover_integral_le volume (range 9) (Set.Icc (Y/16) (65*Y))
    (fun i => Set.Icc (((Y/8)*(2:ℝ)^i)/2) (3*((Y/8)*(2:ℝ)^i)))
    (fun v => ‖localAdditiveConvolution S a H v‖^2) measurableSet_Icc
    (fun _ _ => measurableSet_Icc) (fun _ => sq_nonneg _)
    (hcont.norm.pow 2).integrableOn_Icc
    (fun _ _ => (hcont.norm.pow 2).integrableOn_Icc)
    (fun v hv => wide_mellin_interval_cover hY hv)
  have heq : (∫ v : ℝ, ‖localAdditiveConvolution S a H v‖^2) =
      ∫ v in Set.Icc (Y/16) (65*Y), ‖localAdditiveConvolution S a H v‖^2 := by
    symm
    apply setIntegral_eq_integral_of_forall_compl_eq_zero
    intro v hv
    rw [local_additive_convolution_wide_support S a hY hHp hsmall hS hv,
      norm_zero, zero_pow (by decide)]
  apply (local_fourier_energy_le_convolution S a hHp).trans
  rw [heq]
  calc
    _ ≤ (4/H^2) * (∑ i ∈ range 9,
        ∫ v in Set.Icc (((Y/8)*(2:ℝ)^i)/2) (3*((Y/8)*(2:ℝ)^i)),
          ‖localAdditiveConvolution S a H v‖^2) :=
      mul_le_mul_of_nonneg_left hcover (by positivity)
    _ = ∑ i ∈ range 9, (4/H^2) *
        (∫ v in Set.Icc (((Y/8)*(2:ℝ)^i)/2) (3*((Y/8)*(2:ℝ)^i)),
          ‖localAdditiveConvolution S a H v‖^2) := mul_sum _ _ _
    _ ≤ ∑ _i ∈ range 9, ((8*Cj*(32:ℝ)^j/Y)*I + 64*Cerr*(H/Y)^2*E) :=
      sum_le_sum hlocal
    _ = _ := by
      simp only [sum_const,card_range,nsmul_eq_mul]
      dsimp only [I,E]
      ring

theorem exists_common_window_fourier_mellin_energy_constants {j : ℕ} (hj : 2 ≤ j) :
    ∃ Cj Cerr : ℝ, 0 < Cj ∧ 0 < Cerr ∧
      ∀ (S : Finset ℕ) (a : ℕ → ℂ) (Y H : ℝ),
      0 < Y → 1 ≤ H → H ≤ Y/64 →
      (∀ n ∈ S, Y/8 ≤ (n:ℝ) ∧ (n:ℝ) ≤ 4*Real.exp 2*Y) →
      (∫ β in {β : ℝ | |β| ≤ 1/H}, ‖localAdditivePolynomial S a β‖^2) ≤
        (Cj/Y) * (∫ t : ℝ, (1+|(H/Y)*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2) +
          Cerr * (H/Y)^2 * (∑ n ∈ S, ‖a n‖^2) := by
  obtain ⟨Cj,Cerr,hCj,hCerr,hwide⟩ := exists_wide_local_fourier_mellin_energy_constants hj
  refine ⟨Cj,Cerr,hCj,hCerr,?_⟩
  intro S a Y H hY hH hsmall hS
  apply hwide S a Y H hY hH hsmall
  have he : Real.exp (2:ℝ) = Real.exp 1 * Real.exp 1 := by
    rw [← Real.exp_add]
    norm_num
  have he16 : Real.exp (2:ℝ) ≤ 16 := by
    rw [he]
    nlinarith [Real.exp_one_lt_three,Real.exp_pos 1]
  intro n hn
  refine ⟨(hS n hn).1, (hS n hn).2.trans ?_⟩
  have hb := mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left he16 (by norm_num : (0:ℝ) ≤ 4)) hY.le
  norm_num at hb
  exact hb

end Bounty
end

section

/- The local Fourier-to-Mellin estimate on the same positive integer
support and rational-center modulation used by the auxiliary major arcs. -/

open Finset MeasureTheory
namespace Bounty

theorem finite_fourier_modulated_energy (S : Finset ℤ) (f : ℤ → ℂ)
    (hS : ∀ n ∈ S, 0 ≤ n) (c : ℝ) :
    (∑ n ∈ S.image Int.natAbs,
      ‖f n * fourier (n : ℤ) (c : AddCircle (1 : ℝ))‖^2) =
      ∑ n ∈ S, ‖f n‖^2 := by
  rw [sum_image]
  · apply sum_congr rfl
    intro n hn
    rw [Int.natAbs_of_nonneg (hS n hn), norm_mul, fourier_apply, Circle.norm_coe, mul_one]
  · intro a ha b hb hab
    have he := congrArg (fun n : ℕ => (n : ℤ)) hab
    simpa only [Int.natAbs_of_nonneg (hS a ha), Int.natAbs_of_nonneg (hS b hb)] using he

theorem exists_local_integer_mellin_energy_constants {j : ℕ} (hj : 2 ≤ j) :
    ∃ Cj Cerr : ℝ, 0 < Cj ∧ 0 < Cerr ∧
      ∀ (S : Finset ℤ) (f : ℤ → ℂ) (Y H c : ℝ),
      0 < Y → 1 ≤ H → H ≤ Y/8 →
      (∀ n ∈ S, Y ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*Y) →
      (∫ x in Set.Icc (c-1/H) (c+1/H), ‖finiteFourierSum S f x‖^2) ≤
        (Cj/Y) * (∫ t : ℝ, (1+|(H/Y)*t|)^(-(j : ℝ))*
          ‖localMellinPolynomial (S.image Int.natAbs)
            (fun n => f n * fourier (n : ℤ) (c : AddCircle (1 : ℝ))) t‖^2) +
        Cerr*(H/Y)^2*(∑ n ∈ S, ‖f n‖^2) := by
  obtain ⟨Cj, Cerr, hCj, hCerr, hlocal⟩ := exists_local_fourier_mellin_energy_constants hj
  refine ⟨Cj, Cerr, hCj, hCerr, ?_⟩
  intro S f Y H c hY hH hHY hS
  have hpos (n : ℤ) (hn : n ∈ S) : 0 ≤ n := by
    exact_mod_cast hY.le.trans (hS n hn).1
  have himage : ∀ n ∈ S.image Int.natAbs, Y ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*Y := by
    intro n hn
    obtain ⟨m, hm, rfl⟩ := mem_image.mp hn
    have he : (m.natAbs : ℝ) = (m : ℝ) := by
      simpa only [Int.cast_natCast] using
        congrArg (fun z : ℤ => (z : ℝ)) (Int.natAbs_of_nonneg (hpos m hm))
    rw [he]
    exact hS m hm
  rw [finite_fourier_centered_energy S f hpos c H (by linarith)]
  have hb := hlocal (S.image Int.natAbs)
    (fun n => f n * fourier (n : ℤ) (c : AddCircle (1 : ℝ))) Y H hY hH hHY himage
  simpa only [finite_fourier_modulated_energy S f hpos c] using hb

end Bounty
end

section

/- Exact energy assembly from only the retained full dyadic boxes. -/

open Finset MeasureTheory
namespace Bounty

def retainedFourDyadicBox (S : Finset ℕ) (N i j k l : ℕ) : Prop :=
  ∃ d ∈ dyadicNatBucket (Icc 1 N) i, ∃ a ∈ dyadicNatBucket (Icc 1 N) j,
    ∃ b ∈ dyadicNatBucket (Icc 1 N) k, ∃ c ∈ dyadicNatBucket (Icc 1 N) l,
      d*a*b*c ∈ S

noncomputable def fourDyadicBoxSum (N : ℕ) (δ α β γ F : ℕ → ℂ)
    (i j k l : ℕ) : ℂ :=
  ∑ d ∈ dyadicNatBucket (Icc 1 N) i, ∑ a ∈ dyadicNatBucket (Icc 1 N) j,
    ∑ b ∈ dyadicNatBucket (Icc 1 N) k, ∑ c ∈ dyadicNatBucket (Icc 1 N) l,
      δ d*α a*β b*γ c*F (d*a*b*c)

theorem endpoint_four_dyadic_energy {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) (S : Finset ℕ) (N : ℕ) (hS : ∀ n ∈ S, n ≤ N)
    (δ α β γ : ℕ → ℂ) (F : Ω → ℕ → ℂ) (hF : ∀ s n, n ∉ S → F s n = 0)
    (E : ℝ) (hE0 : 0 ≤ E)
    (hf : ∀ i ∈ dyadicNatIndices (Icc 1 N), ∀ j ∈ dyadicNatIndices (Icc 1 N),
      ∀ k ∈ dyadicNatIndices (Icc 1 N), ∀ l ∈ dyadicNatIndices (Icc 1 N),
      retainedFourDyadicBox S N i j k l →
      Integrable (fun s => ‖fourDyadicBoxSum N δ α β γ (F s) i j k l‖ ^ 2) μ)
    (hE : ∀ i ∈ dyadicNatIndices (Icc 1 N), ∀ j ∈ dyadicNatIndices (Icc 1 N),
      ∀ k ∈ dyadicNatIndices (Icc 1 N), ∀ l ∈ dyadicNatIndices (Icc 1 N),
      retainedFourDyadicBox S N i j k l →
      (∫ s, ‖fourDyadicBoxSum N δ α β γ (F s) i j k l‖ ^ 2 ∂μ) ≤ E) :
    (∫ s, ‖∑ n ∈ S, endpointFourConvolution δ α β γ n * F s n‖ ^ 2 ∂μ)
      ≤ ((dyadicNatIndices (Icc 1 N)).card : ℝ) ^ 8 * E := by
  classical
  let f : ℕ → ℕ → ℕ → ℕ → Ω → ℂ := fun i j k l s =>
    if retainedFourDyadicBox S N i j k l then fourDyadicBoxSum N δ α β γ (F s) i j k l else 0
  have heq (s : Ω) : (∑ n ∈ S, endpointFourConvolution δ α β γ n * F s n) =
      ∑ i ∈ dyadicNatIndices (Icc 1 N), ∑ j ∈ dyadicNatIndices (Icc 1 N),
        ∑ k ∈ dyadicNatIndices (Icc 1 N), ∑ l ∈ dyadicNatIndices (Icc 1 N), f i j k l s := by
    rw [endpoint_four_supported_dyadic_boxes S N hS δ α β γ (F s) (hF s)]
    apply sum_congr rfl
    intro i _
    apply sum_congr rfl
    intro j _
    apply sum_congr rfl
    intro k _
    apply sum_congr rfl
    intro l _
    by_cases h : retainedFourDyadicBox S N i j k l
    · have h' : ∃ d ∈ dyadicNatBucket (Icc 1 N) i, ∃ a ∈ dyadicNatBucket (Icc 1 N) j,
          ∃ b ∈ dyadicNatBucket (Icc 1 N) k, ∃ c ∈ dyadicNatBucket (Icc 1 N) l,
            d*a*b*c ∈ S := h
      simp only [f, if_pos h, if_pos h', fourDyadicBoxSum]
    · have h' : ¬∃ d ∈ dyadicNatBucket (Icc 1 N) i, ∃ a ∈ dyadicNatBucket (Icc 1 N) j,
          ∃ b ∈ dyadicNatBucket (Icc 1 N) k, ∃ c ∈ dyadicNatBucket (Icc 1 N) l,
            d*a*b*c ∈ S := h
      simp only [f, if_neg h, if_neg h']
  simp_rw [heq]
  apply four_integrated_energy_le_card_eight μ _ f E
  · intro i hi j hj k hk l hl
    by_cases h : retainedFourDyadicBox S N i j k l
    · simpa only [f, if_pos h] using hf i hi j hj k hk l hl h
    · simp only [f, if_neg h, norm_zero, zero_pow (by omega : 2 ≠ 0)]
      exact integrable_zero _ _ _
  · intro i hi j hj k hk l hl
    by_cases h : retainedFourDyadicBox S N i j k l
    · simpa only [f, if_pos h] using hE i hi j hj k hk l hl h
    · simpa only [f, if_neg h, norm_zero, zero_pow (by omega : 2 ≠ 0), integral_zero] using hE0

end Bounty
end

section

/- The literal physical history retains a bounded condition on its entire
record of states, permutations and auxiliary draws. Its weighted energy is
bounded by the original full-path estimate with no record norm or counting
factor. Identifying a particular independently defined physical sum remains
a separate requirement. -/

namespace Bounty

section Physical
variable {I K : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g, ∀ p : ↥(P g), NeZero p.val]
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (retention : I → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

theorem physical_recorded_trace_history_energy_le
    (hV : ∀ g, V g ≠ 0)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (tags : ℕ → Option (I ⊕ K)) (cut : ℕ → Fin N → Finset (Fin J))
    (hencode : ∀ i, PhysicalMarkRowEncoding C (tags i) (cut i) (cut (i + 1)))
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 < β g p / V g) (hmass : ∀ g, ∑ p, β g p / V g ≤ 2)
    (hq0 : ∀ i, 0 ≤ retention i) (hq1 : ∀ i, retention i ≤ 1)
    (hD : ∀ i, retention i / ρ ^ 2 + ((1 - retention i) / ρ) / v ≤ 1)
    (hC : ∀ i g, retention i / ρ ^ 2 + ((1 - retention i) * V g / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ j g, ell + (C j g).card ≤ T)
    (steps : ℕ)
    (initial : PhysicalFullBoundedState P J ell B →
      (g : Fin N) → Finset ↥(P g))
    (initialTrace : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val)
      (M := fun _ => J + ell) B → List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C))
    (Φ : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C) →
      FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ)
    (hΦ : ∀ r s, ‖Φ r s‖ ≤ 1)
    (f : PhysicalFullBoundedState P J ell B → ℂ)
    (hf : ProductMemorySymmetric f) :
    physicalMarkMemoryEnergy (fun g p => β g p / V g)
      (fun g => unrestrictedResidueWeight (fun p => β g p / V g))
      (fun L q =>
        let x := physicalFullMemoryState (cut 0) L q
        finiteRowComposition (S := fun _ =>
          List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C) × PhysicalBoundedMarkState P J ell B)
          (fun i => physicalRecordedMarkRow C k ω β retention ρ V hV
            (tags i) (cut i) (cut (i + 1)) (physicalFullTraceAppend C)) steps
          ((fun r => Φ r.1 r.2 * f r.2.2) ∘ Prod.map id (physicalBoundedMarkEncode (cut steps)))
          (initialTrace (initial x, x), (L, initial x, q))) ≤
    (((List.range steps).map tags).map
      (fullPermutationMixedStepEnergy ρ v vmin vmax T N)).prod *
      finiteWeightedEnergy (productMemoryWeight (fun g p => β g p / V g)
      (fun g => unrestrictedResidueWeight (fun p => β g p / V g))) f := by
  let pathAction := fullMixedLedgerPathAction (fun g (p : ↥(P g)) => p.val)
    (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
    (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j))
    ω (fun g p => β g p / V g) retention ρ V ((List.range steps).map tags)
    (physicalFullRecordedTracePhase C k ω β ρ V tags cut steps initialTrace Φ)
    (fun s => f s.2)
  have hr := physical_recorded_mark_history_intertwines C k ω β retention ρ V hV
    hP hdis tags cut hencode (fun _ => physicalFullTraceAppend C) steps
    (fun r => Φ r.1 r.2 * f r.2.2)
  have hp := physical_full_recorded_trace_rows_eq_paths C k ω β retention ρ V
    tags cut steps initialTrace Φ (fun s => f s.2)
  have he : (fun L q =>
      let x := physicalFullMemoryState (cut 0) L q
      finiteRowComposition (S := fun _ =>
        List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C) × PhysicalBoundedMarkState P J ell B)
        (fun i => physicalRecordedMarkRow C k ω β retention ρ V hV
          (tags i) (cut i) (cut (i + 1)) (physicalFullTraceAppend C)) steps
        ((fun r => Φ r.1 r.2 * f r.2.2) ∘ Prod.map id (physicalBoundedMarkEncode (cut steps)))
        (initialTrace (initial x, x), (L, initial x, q))) =
      (fun L q => let x := physicalFullMemoryState (cut 0) L q; pathAction (initial x, x)) := by
    funext L q
    dsimp only
    rw [hr]
    exact congrFun hp (initial (physicalFullMemoryState (cut 0) L q), physicalFullMemoryState (cut 0) L q)
  rw [he]
  apply (physical_full_state_energy_le (cut 0) (fun g p => β g p / V g)
    (fun g => unrestrictedResidueWeight (fun p => β g p / V g))
    (fun g p => (hμ g p).le) (fun g z => (hμ g z.1).le)
    (fun x => pathAction (initial x, x))).trans
  exact full_mixed_ledger_path_energy_le (fun g (p : ↥(P g)) => p.val)
    (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
    (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j))
    ω (fun g p => β g p / V g) retention ρ V hω hωmass hρ0 hρ1 hv hvmin hVlo hVhi
    hμ hmass hq0 hq1 hD hC T
    (fun j g => by simpa only [physical_full_unshared_indices_card] using ht j g)
    ((List.range steps).map tags) initial
    (physicalFullRecordedTracePhase C k ω β ρ V tags cut steps initialTrace Φ)
    (physical_full_recorded_trace_phase_norm_le C k ω β ρ V tags cut steps initialTrace Φ hΦ) f hf

end Physical
end Bounty
end

section

/- Combining small and large conductor estimates with the principal-character loss. -/

open Finset Filter

namespace Bounty

theorem candidate_primitive_typeI_mass_bound_of_split
    (c L q C D : ℝ) (r jStar N R : ℕ) (hL : 2 ≤ L)
    (hmass : candidateCoefficientWindowMass c L q r jStar ≤ Real.exp L * L^C)
    (hsmall : candidateSmallPrimitiveTypeIMass c L q r jStar N R ≤
      candidateCoefficientWindowMass c L q r jStar * L^(-(C + D + 1)))
    (hlarge : candidateLargePrimitiveTypeIMass c L q r jStar N R ≤
      Real.exp L * L^(-(D + 1))) :
    candidatePrimitiveTypeIMass c L q r jStar N ≤ Real.exp L * L^(-D) := by
  have hLpos : 0 < L := by linarith
  have hpow : L^C * L^(-(C + D + 1)) = L^(-(D + 1)) := by
    rw [← Real.rpow_add hLpos]
    congr 1
    ring
  have hpow' : L * L^(-(D + 1)) = L^(-D) := by
    calc
      _ = L^(1 : ℝ) * L^(-(D + 1)) := by rw [Real.rpow_one]
      _ = _ := by rw [← Real.rpow_add hLpos]; congr 1; ring
  have hs : candidateSmallPrimitiveTypeIMass c L q r jStar N R ≤
      Real.exp L * L^(-(D + 1)) := by
    calc
      _ ≤ candidateCoefficientWindowMass c L q r jStar * L^(-(C + D + 1)) := hsmall
      _ ≤ (Real.exp L * L^C) * L^(-(C + D + 1)) :=
        mul_le_mul_of_nonneg_right hmass (Real.rpow_nonneg hLpos.le _)
      _ = _ := by rw [mul_assoc, hpow]
  rw [candidate_primitive_typeI_mass_split c L q r jStar N R]
  calc
    _ ≤ Real.exp L * L^(-(D + 1)) + Real.exp L * L^(-(D + 1)) := add_le_add hs hlarge
    _ = Real.exp L * (2 * L^(-(D + 1))) := by ring
    _ ≤ Real.exp L * (L * L^(-(D + 1))) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_right hL (Real.rpow_nonneg hLpos.le _)) (Real.exp_pos L).le
    _ = _ := by rw [hpow']

theorem candidate_primitive_typeI_relative_bound_of_split
    (c L q C D : ℝ) (r jStar N R : ℕ) (hL : 2 ≤ L)
    (hmass : Real.exp L * L^(-C) ≤ candidateCoefficientWindowMass c L q r jStar)
    (hsmall : candidateSmallPrimitiveTypeIMass c L q r jStar N R ≤
      candidateCoefficientWindowMass c L q r jStar * L^(-(D + 1)))
    (hlarge : candidateLargePrimitiveTypeIMass c L q r jStar N R ≤
      Real.exp L * L^(-(C + D + 1))) :
    candidatePrimitiveTypeIMass c L q r jStar N ≤
      candidateCoefficientWindowMass c L q r jStar * L^(-D) := by
  have hLpos : 0 < L := by linarith
  have hmass0 : 0 ≤ candidateCoefficientWindowMass c L q r jStar :=
    (mul_pos (Real.exp_pos L) (Real.rpow_pos_of_pos hLpos (-C))).le.trans hmass
  have hpow : L^(-C) * L^(-(D + 1)) = L^(-(C + D + 1)) := by
    rw [← Real.rpow_add hLpos]
    congr 1
    ring
  have hpow' : L * L^(-(D + 1)) = L^(-D) := by
    calc
      _ = L^(1 : ℝ) * L^(-(D + 1)) := by rw [Real.rpow_one]
      _ = _ := by rw [← Real.rpow_add hLpos]; congr 1; ring
  have hl : candidateLargePrimitiveTypeIMass c L q r jStar N R ≤
      candidateCoefficientWindowMass c L q r jStar * L^(-(D + 1)) := by
    calc
      _ ≤ Real.exp L * L^(-(C + D + 1)) := hlarge
      _ = (Real.exp L * L^(-C)) * L^(-(D + 1)) := by rw [mul_assoc, hpow]
      _ ≤ _ := mul_le_mul_of_nonneg_right hmass (Real.rpow_nonneg hLpos.le _)
  rw [candidate_primitive_typeI_mass_split c L q r jStar N R]
  calc
    _ ≤ candidateCoefficientWindowMass c L q r jStar * L^(-(D + 1)) +
        candidateCoefficientWindowMass c L q r jStar * L^(-(D + 1)) := add_le_add hsmall hl
    _ = candidateCoefficientWindowMass c L q r jStar * (2 * L^(-(D + 1))) := by ring
    _ ≤ candidateCoefficientWindowMass c L q r jStar * (L * L^(-(D + 1))) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_right hL (Real.rpow_nonneg hLpos.le _)) hmass0
    _ = _ := by rw [hpow']

theorem exists_candidate_relative_typeI_remainder_bound_of_large
    (hZ : PrimitiveZeroFreeHalfPlane) {c q θ : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1) (hθ : θ ≤ 1)
    (hlarge : ∀ B : ℝ, ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, 0 < jStar →
      ∀ N : ℕ, (N : ℝ) ≤ Real.exp (θ * L) →
        candidateLargePrimitiveTypeIMass c L q r jStar N ⌊Real.exp ((c/512)*L)⌋₊ ≤
          Real.exp L * L^(-B)) (D : ℝ) :
    ∃ J : ℕ, ∀ jStar : ℕ, J < jStar → ∀ᶠ L : ℝ in atTop,
      ∀ N : ℕ, (N : ℝ) ≤ Real.exp (θ * L) →
        (∑ d ∈ oddSquarefreeModuli N,
          |shiftedTotientSieveRemainder (arithmeticProductWindow 1 (Real.exp L))
            (candidateCoefficient c L q r jStar) d|) ≤
          candidateCoefficientWindowMass c L q r jStar *
            (L^(-D) + (16 * primeEulerProductUpperConstant) * L^(-18 : ℝ)) := by
  obtain ⟨C, _, Jmass, hmass⟩ :=
    exists_candidate_coefficient_mass_polynomial_lower hc hr hq0 hq1 hcenter
  obtain ⟨Jsmall, hsmall⟩ :=
    exists_candidate_exponential_conductor_range_power_bound hZ hc hr hq0 hq1 hcenter (D + 1)
  refine ⟨max Jmass Jsmall, ?_⟩
  intro jStar hj
  have hjmass : Jmass < jStar := lt_of_le_of_lt (le_max_left _ _) hj
  have hjsmall : Jsmall < jStar := lt_of_le_of_lt (le_max_right _ _) hj
  have hjpos : 0 < jStar := lt_of_le_of_lt (Nat.zero_le _) hj
  filter_upwards [hmass jStar hjmass, hsmall, hlarge (C + D + 1),
    eventually_candidate_typeI_remainder_le_primitive hc,
    eventually_ge_atTop (2 : ℝ)] with L hm hs hl hrem hL
  intro N hN
  have hL0 : 0 ≤ L := by linarith
  have hN' : (N : ℝ) ≤ Real.exp L := hN.trans
    (Real.exp_le_exp.mpr (by nlinarith only [hθ, hL0]))
  have hR : (⌊Real.exp ((c/512)*L)⌋₊ : ℝ) ≤ Real.exp ((c/512)*L) :=
    Nat.floor_le (Real.exp_pos _).le
  have hprim := candidate_primitive_typeI_relative_bound_of_split c L q C D
    r jStar N ⌊Real.exp ((c/512)*L)⌋₊ hL hm
    (hs jStar hjsmall N _ hN' hR) (hl jStar hjpos N hN)
  calc
    _ ≤ candidatePrimitiveTypeIMass c L q r jStar N +
        candidateCoefficientWindowMass c L q r jStar *
          ((16 * primeEulerProductUpperConstant) * L^(-18 : ℝ)) := hrem q hq0 r jStar N hN'
    _ ≤ candidateCoefficientWindowMass c L q r jStar * L^(-D) +
        candidateCoefficientWindowMass c L q r jStar *
          ((16 * primeEulerProductUpperConstant) * L^(-18 : ℝ)) := add_le_add hprim le_rfl
    _ = _ := (mul_add _ _ _).symm

theorem exists_candidate_typeI_remainder_bound_of_large
    (hZ : PrimitiveZeroFreeHalfPlane) {c q θ : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1) (hθ : θ ≤ 1)
    (hlarge : ∀ B : ℝ, ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, 0 < jStar →
      ∀ N : ℕ, (N : ℝ) ≤ Real.exp (θ * L) →
        candidateLargePrimitiveTypeIMass c L q r jStar N ⌊Real.exp ((c/512)*L)⌋₊ ≤
          Real.exp L * L^(-B)) (D : ℝ) :
    ∃ J : ℕ, ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, J < jStar →
      ∀ N : ℕ, (N : ℝ) ≤ Real.exp (θ * L) →
        (∑ d ∈ oddSquarefreeModuli N,
          |shiftedTotientSieveRemainder (arithmeticProductWindow 1 (Real.exp L))
            (candidateCoefficient c L q r jStar) d|) ≤
          Real.exp L * L^(-D) + candidateCoefficientWindowMass c L q r jStar *
            ((16 * primeEulerProductUpperConstant) * L^(-18 : ℝ)) := by
  obtain ⟨C, _, hmass⟩ :=
    exists_candidate_coefficient_mass_polynomial_upper_uniform hc hr hq0 hq1.le
  obtain ⟨J, hsmall⟩ :=
    exists_candidate_exponential_conductor_range_power_bound hZ hc hr hq0 hq1 hcenter (C + D + 1)
  refine ⟨J, ?_⟩
  filter_upwards [hmass, hsmall, hlarge (D + 1),
    eventually_candidate_typeI_remainder_le_primitive hc,
    eventually_ge_atTop (2 : ℝ)] with L hm hs hl hrem hL
  intro jStar hj N hN
  have hjpos : 0 < jStar := lt_of_le_of_lt (Nat.zero_le _) hj
  have hL0 : 0 ≤ L := by linarith
  have hN' : (N : ℝ) ≤ Real.exp L := hN.trans
    (Real.exp_le_exp.mpr (by nlinarith only [hθ, hL0]))
  have hR : (⌊Real.exp ((c/512)*L)⌋₊ : ℝ) ≤ Real.exp ((c/512)*L) :=
    Nat.floor_le (Real.exp_pos _).le
  have hprim := candidate_primitive_typeI_mass_bound_of_split c L q C D
    r jStar N ⌊Real.exp ((c/512)*L)⌋₊ hL (hm jStar hjpos)
    (hs jStar hj N _ hN' hR) (hl jStar hjpos N hN)
  exact (hrem q hq0 r jStar N hN').trans (add_le_add hprim le_rfl)

theorem exists_candidate_typeI_remainder_power_bound
    (hZ : PrimitiveZeroFreeHalfPlane) {c q θ : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1) (hθ : θ < 1/2) (D : ℝ) :
    ∃ J : ℕ, ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, J < jStar →
      ∀ N : ℕ, (N : ℝ) ≤ Real.exp (θ * L) →
        (∑ d ∈ oddSquarefreeModuli N,
          |shiftedTotientSieveRemainder (arithmeticProductWindow 1 (Real.exp L))
            (candidateCoefficient c L q r jStar) d|) ≤
          Real.exp L * L^(-D) + candidateCoefficientWindowMass c L q r jStar *
            ((16 * primeEulerProductUpperConstant) * L^(-18 : ℝ)) := by
  apply exists_candidate_typeI_remainder_bound_of_large hZ hc hr hq0 hq1 hcenter
    (by linarith : θ ≤ 1) ?_ D
  intro B
  exact eventually_candidate_large_primitive_power_saving hc hr hcenter hq0 hq1 hθ B

theorem exists_candidate_relative_typeI_remainder_power_bound
    (hZ : PrimitiveZeroFreeHalfPlane) {c q θ : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1) (hθ : θ < 1/2) (D : ℝ) :
    ∃ J : ℕ, ∀ jStar : ℕ, J < jStar → ∀ᶠ L : ℝ in atTop,
      ∀ N : ℕ, (N : ℝ) ≤ Real.exp (θ * L) →
        (∑ d ∈ oddSquarefreeModuli N,
          |shiftedTotientSieveRemainder (arithmeticProductWindow 1 (Real.exp L))
            (candidateCoefficient c L q r jStar) d|) ≤
          candidateCoefficientWindowMass c L q r jStar *
            (L^(-D) + (16 * primeEulerProductUpperConstant) * L^(-18 : ℝ)) := by
  apply exists_candidate_relative_typeI_remainder_bound_of_large hZ hc hr hq0 hq1 hcenter
    (by linarith : θ ≤ 1) ?_ D
  intro B
  exact eventually_candidate_large_primitive_power_saving hc hr hcenter hq0 hq1 hθ B

end Bounty
