section

/- The full-residual rational multiplier is exactly the gcd-filtered original polynomial. -/

open Finset

namespace Bounty

theorem candidate_selected_residual_rational_filtered_polynomial
    (c L q : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm
      (candidateRoughSlot c L r jStar hr hj)) = false)
    (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ)
    (tmarks umarks : candidatePIndices c L → ℕ) (big : Finset (candidatePIndices c L))
    (b : GroupMarkedLists (fun g : big => candidatePBand (c*L) g.val.val)
      (fun g : big => umarks g.val) → ℂ) (κ θ : ℕ → ℂ)
    (qRat dRat : ℕ) (ψ : AddChar (Additive (ZMod (qRat/dRat))ˣ) ℂ)
    (F : Finset ℕ) (s : ℝ) :
    (∑ n ∈ F.filter (fun n => n.gcd qRat = dRat),
      candidateSelectedResidualCoefficient c L q r jStar hr hj take hkeep ξ
        tmarks umarks big b κ θ n *
          unitAddCharDirichlet ψ ((n/dRat : ℕ) : ZMod (qRat/dRat)) * harmonicMellinWeight s n) =
      ∑ n ∈ F, candidateSelectedResidualCoefficient c L q r jStar hr hj take hkeep ξ
        tmarks umarks big b κ (fun n => θ n*rationalResidualGcdMultiplier qRat dRat ψ n) n *
          harmonicMellinWeight s n := by
  simp_rw [candidate_selected_residual_full_multiplier]
  exact rational_residual_gcd_filtered_sum qRat dRat ψ F
    (candidateSelectedResidualCoefficient c L q r jStar hr hj take hkeep ξ
      tmarks umarks big b κ θ) (fun n => harmonicMellinWeight s n)

end Bounty
end

section

/- One rational coefficient family handles arbitrary product kernels and Mellin weights. -/

open Finset
open scoped Classical

namespace Bounty

theorem rational_four_factor_full_gcd_kernel_expansion {r Q : ℕ}
    (hr : 0 < r) (hrQ : r ≤ Q) (u : ℤ)
    (M A P N : Finset ℕ)
    (hM : ∀ m ∈ M, m.Coprime r) (hA : ∀ a ∈ A, a.Coprime r)
    (hP : ∀ p ∈ P, p.Coprime r) :
    ∃ c : (d : ℕ) → AddChar (Additive (ZMod (r/d))ˣ) ℂ → ℂ,
      (∑ d ∈ r.divisors, ∑ ψ, ‖c d ψ‖) ≤ (r.divisors.card : ℝ)*Real.sqrt (Q : ℝ) ∧
      (r.divisors.card : ℝ)*Real.sqrt (Q : ℝ) ≤ (Q : ℝ)*Real.sqrt (Q : ℝ) ∧
      ∀ α δ β γ H : ℕ → ℂ,
      (∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P, ∑ n ∈ N,
        (α m*δ a*β p*γ n)*H (m*a*p*n)*
          Complex.exp (Complex.I*(2*Real.pi*((u : ℝ)/r*(m*a*p*n)) : ℝ))) =
        ∑ d ∈ r.divisors, ∑ ψ, c d ψ *
          ∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P, ∑ n ∈ N,
            (α m*unitAddCharDirichlet ψ (m : ZMod (r/d)))*
            (δ a*unitAddCharDirichlet ψ (a : ZMod (r/d)))*
            (β p*unitAddCharDirichlet ψ (p : ZMod (r/d)))*
            (γ n*rationalResidualGcdMultiplier r d ψ n)*H (m*a*p*n) := by
  have hex (d : ℕ) : ∃ c : AddChar (Additive (ZMod (r/d))ˣ) ℂ → ℂ,
      (∑ ψ, ‖c ψ‖) ≤ Real.sqrt (Q : ℝ) ∧
      (d ∈ r.divisors →
        ∀ m a p n : ℕ, m.Coprime r → a.Coprime r → p.Coprime r → n.gcd r = d →
          (∑ ψ, c ψ*unitAddCharDirichlet ψ (m : ZMod (r/d))*
            unitAddCharDirichlet ψ (a : ZMod (r/d))*
            unitAddCharDirichlet ψ (p : ZMod (r/d))*
            unitAddCharDirichlet ψ ((n/d : ℕ) : ZMod (r/d))) =
              Complex.exp (Complex.I*(2*Real.pi*((u : ℝ)/r*(m*a*p*n)) : ℝ))) := by
    by_cases hd : d ∈ r.divisors
    · obtain ⟨c, hc, he⟩ := rational_four_factor_gcd_slice_expansion hr hrQ
        (Nat.pos_of_mem_divisors hd) (Nat.dvd_of_mem_divisors hd) u
      exact ⟨c, hc, fun _ => he⟩
    · refine ⟨fun _ => 0, ?_, fun h => (hd h).elim⟩
      simp
  choose c hc using hex
  have hmass : (∑ d ∈ r.divisors, ∑ ψ, ‖c d ψ‖) ≤
      (r.divisors.card : ℝ)*Real.sqrt (Q : ℝ) := by
    calc
      _ ≤ ∑ _d ∈ r.divisors, Real.sqrt (Q : ℝ) := sum_le_sum (fun d _ => (hc d).1)
      _ = _ := by simp
  have hcard : (r.divisors.card : ℝ) ≤ (Q : ℝ) := by
    exact_mod_cast (Nat.card_divisors_le_self r).trans hrQ
  refine ⟨c, hmass, mul_le_mul_of_nonneg_right hcard (Real.sqrt_nonneg _), ?_⟩
  intro α δ β γ H
  calc
    _ = ∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P, ∑ d ∈ r.divisors,
        ∑ n ∈ N.filter (fun n => n.gcd r = d),
          (α m*δ a*β p*γ n)*H (m*a*p*n)*
            Complex.exp (Complex.I*(2*Real.pi*((u : ℝ)/r*(m*a*p*n)) : ℝ)) := by
      apply sum_congr rfl
      intro m _
      apply sum_congr rfl
      intro a _
      apply sum_congr rfl
      intro p _
      exact sum_eq_sum_residual_gcd_slices hr N _
    _ = ∑ d ∈ r.divisors, ∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P,
        ∑ n ∈ N.filter (fun n => n.gcd r = d),
          (α m*δ a*β p*γ n)*H (m*a*p*n)*
            Complex.exp (Complex.I*(2*Real.pi*((u : ℝ)/r*(m*a*p*n)) : ℝ)) := by
      conv_lhs =>
        arg 2
        ext m
        arg 2
        ext a
        rw [sum_comm]
      conv_lhs =>
        arg 2
        ext m
        rw [sum_comm]
      rw [sum_comm]
    _ = _ := by
      apply sum_congr rfl
      intro d hd
      calc
        _ = ∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P,
            ∑ n ∈ N.filter (fun n => n.gcd r = d), ∑ ψ,
            c d ψ * (α m*unitAddCharDirichlet ψ (m : ZMod (r/d))) *
              (δ a*unitAddCharDirichlet ψ (a : ZMod (r/d))) *
              (β p*unitAddCharDirichlet ψ (p : ZMod (r/d))) *
              (γ n*unitAddCharDirichlet ψ ((n/d : ℕ) : ZMod (r/d))) * H (m*a*p*n) := by
          apply sum_congr rfl
          intro m hm
          apply sum_congr rfl
          intro a ha
          apply sum_congr rfl
          intro p hp
          apply sum_congr rfl
          intro n hn
          rw [← (hc d).2 hd m a p n (hM m hm) (hA a ha) (hP p hp) (mem_filter.mp hn).2,
            mul_sum]
          apply sum_congr rfl
          intro ψ _
          ring
        _ = ∑ ψ, ∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P,
            ∑ n ∈ N.filter (fun n => n.gcd r = d),
            c d ψ * (α m*unitAddCharDirichlet ψ (m : ZMod (r/d))) *
              (δ a*unitAddCharDirichlet ψ (a : ZMod (r/d))) *
              (β p*unitAddCharDirichlet ψ (p : ZMod (r/d))) *
              (γ n*unitAddCharDirichlet ψ ((n/d : ℕ) : ZMod (r/d))) * H (m*a*p*n) := by
          conv_lhs =>
            arg 2
            ext m
            arg 2
            ext a
            arg 2
            ext p
            rw [sum_comm]
          conv_lhs =>
            arg 2
            ext m
            arg 2
            ext a
            rw [sum_comm]
          conv_lhs =>
            arg 2
            ext m
            rw [sum_comm]
          rw [sum_comm]
        _ = ∑ ψ, c d ψ *
            ∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P,
            ∑ n ∈ N.filter (fun n => n.gcd r = d),
              (α m*unitAddCharDirichlet ψ (m : ZMod (r/d))) *
              (δ a*unitAddCharDirichlet ψ (a : ZMod (r/d))) *
              (β p*unitAddCharDirichlet ψ (p : ZMod (r/d))) *
              (γ n*unitAddCharDirichlet ψ ((n/d : ℕ) : ZMod (r/d))) * H (m*a*p*n) := by
          simp only [mul_assoc, mul_sum]
        _ = _ := by
          apply sum_congr rfl
          intro ψ _
          congr 1
          apply sum_congr rfl
          intro m _
          apply sum_congr rfl
          intro a _
          apply sum_congr rfl
          intro p _
          simpa only [mul_assoc] using rational_residual_gcd_filtered_sum r d ψ N
            (fun n => (α m*unitAddCharDirichlet ψ (m : ZMod (r/d))) *
              (δ a*unitAddCharDirichlet ψ (a : ZMod (r/d))) *
              (β p*unitAddCharDirichlet ψ (p : ZMod (r/d))) * γ n)
            (fun n => H (m*a*p*n))

theorem rational_four_factor_full_gcd_kernel_mellin_expansion {r Q : ℕ}
    (hr : 0 < r) (hrQ : r ≤ Q) (u : ℤ)
    (M A P N : Finset ℕ)
    (hM : ∀ m ∈ M, m.Coprime r) (hA : ∀ a ∈ A, a.Coprime r)
    (hP : ∀ p ∈ P, p.Coprime r)
    (hMp : ∀ m ∈ M, 0 < m) (hAp : ∀ a ∈ A, 0 < a)
    (hPp : ∀ p ∈ P, 0 < p) (hNp : ∀ n ∈ N, 0 < n) :
    ∃ c : (d : ℕ) → AddChar (Additive (ZMod (r/d))ˣ) ℂ → ℂ,
      (∑ d ∈ r.divisors, ∑ ψ, ‖c d ψ‖) ≤ (r.divisors.card : ℝ)*Real.sqrt (Q : ℝ) ∧
      (r.divisors.card : ℝ)*Real.sqrt (Q : ℝ) ≤ (Q : ℝ)*Real.sqrt (Q : ℝ) ∧
      (∀ α δ β γ H : ℕ → ℂ,
        (∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P, ∑ n ∈ N,
          (α m*δ a*β p*γ n)*H (m*a*p*n)*
            Complex.exp (Complex.I*(2*Real.pi*((u : ℝ)/r*(m*a*p*n)) : ℝ))) =
          ∑ d ∈ r.divisors, ∑ ψ, c d ψ *
            ∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P, ∑ n ∈ N,
              (α m*unitAddCharDirichlet ψ (m : ZMod (r/d)))*
              (δ a*unitAddCharDirichlet ψ (a : ZMod (r/d)))*
              (β p*unitAddCharDirichlet ψ (p : ZMod (r/d)))*
              (γ n*rationalResidualGcdMultiplier r d ψ n)*H (m*a*p*n)) ∧
      ∀ (α δ β γ : ℕ → ℂ) (t : ℝ),
        (∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P, ∑ n ∈ N,
          (α m*δ a*β p*γ n)*harmonicMellinWeight t ((m*a*p*n : ℕ) : ℝ)*
            Complex.exp (Complex.I*(2*Real.pi*((u : ℝ)/r*(m*a*p*n)) : ℝ))) =
          ∑ d ∈ r.divisors, ∑ ψ, c d ψ *
            ((∑ m ∈ M, (α m*unitAddCharDirichlet ψ (m : ZMod (r/d)))*
              harmonicMellinWeight t m) *
            (∑ a ∈ A, (δ a*unitAddCharDirichlet ψ (a : ZMod (r/d)))*
              harmonicMellinWeight t a) *
            (∑ p ∈ P, (β p*unitAddCharDirichlet ψ (p : ZMod (r/d)))*
              harmonicMellinWeight t p) *
            (∑ n ∈ N, (γ n*rationalResidualGcdMultiplier r d ψ n)*
              harmonicMellinWeight t n)) := by
  obtain ⟨c, hc, hQ, hkernel⟩ :=
    rational_four_factor_full_gcd_kernel_expansion hr hrQ u M A P N hM hA hP
  refine ⟨c, hc, hQ, hkernel, ?_⟩
  intro α δ β γ t
  rw [hkernel α δ β γ (fun k => harmonicMellinWeight t (k : ℝ))]
  apply sum_congr rfl
  intro d _
  apply sum_congr rfl
  intro ψ _
  congr 1
  exact harmonic_mellin_four_factor_box M A P N hMp hAp hPp hNp
    (fun m => α m*unitAddCharDirichlet ψ (m : ZMod (r/d)))
    (fun a => δ a*unitAddCharDirichlet ψ (a : ZMod (r/d)))
    (fun p => β p*unitAddCharDirichlet ψ (p : ZMod (r/d)))
    (fun n => γ n*rationalResidualGcdMultiplier r d ψ n) t

end Bounty
end

section

/- The complete fixed-path selected physical composition equals the original weighted raw schedule. -/

open Finset
open scoped Classical
namespace Bounty

section ResiduePath
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (ζ : ∀ p : PhysicalPrime P, ZMod p.2.val)
  (hmarks : ∀ j : Fin (n + 1), ∀ p ∈ physicalMarkedPrimes (L j),
    ζ p = -(a j : ZMod p.2.val))
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ) (η : Fin N → Fin (n + 1) → ℝ)
  (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0) (B : ℕ)

variable
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)

theorem physical_selected_coarse_extension (i : ℕ) (hi : i < 2 * n + 1)
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    physicalMarkRawExtension
      (physicalSelectedCoarseRow (B := B) C aux k L σ τ β V ρ hV ω retention i F)
      (physicalMarkAtCut L i) =
      fun s => physicalSelectedCoarseScalar C aux L σ ω i *
        globalBirthJointCutRawRow
          (physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β
            (fun _ j => 1 - retention j) V (fun _ => ρ) hV B i) B B
          (physicalMarkRawExtension F (physicalMarkAtCut L (i + 1))) s := by
  by_cases he : i % 2 = 0
  · let j : Fin (n + 1) := ⟨i / 2, by omega⟩
    have hiEq : i = 2 * j.val := by dsimp [j]; omega
    rw [hiEq, physical_selected_coarse_row_even,
      physical_mark_at_cut_even, physical_mark_at_cut_odd, physical_selected_coarse_scalar_even]
    simp only [one_mul]
    exact physical_selected_original_visit_extension C aux k L a σ τ hstep ζ hmarks
      hlist hP hdis hk β V ρ hV B ω retention j F
  · let j : Fin n := ⟨i / 2, by omega⟩
    have hiEq : i = 2 * j.val + 1 := by dsimp [j]; omega
    have hnext : 2 * j.val + 1 + 1 = 2 * j.succ.val := by simp only [Fin.val_succ]; omega
    have hsource : physicalMarkAtCut L (2 * j.val + 1) = L j.castSucc :=
      physical_mark_at_cut_odd L j.castSucc
    have htarget : physicalMarkAtCut L (2 * j.val + 1 + 1) = L j.succ := by
      rw [hnext, physical_mark_at_cut_even]
    rw [hiEq, physical_selected_coarse_row_odd, hsource, htarget,
      physical_selected_coarse_scalar_odd]
    exact physical_selected_original_edge_extension C aux k L a σ τ hstep ζ hmarks
      hlist hP hdis hk β (fun _ j => 1 - retention j) V ρ hV B ω retention j F

theorem physical_selected_coarse_composition
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    physicalMarkRawExtension
      (finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
        (physicalSelectedCoarseRow (B := B) C aux k L σ τ β V ρ hV ω retention) (2 * n + 1) F)
      (L 0) =
      finiteRowComposition (S := fun _ => GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val))
        (fun i G s => physicalSelectedCoarseScalar C aux L σ ω i *
          globalBirthJointCutRawRow
            (physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β
              (fun _ j => 1 - retention j) V (fun _ => ρ) hV B i) B B G s)
        (2 * n + 1) (physicalMarkRawExtension F (L (Fin.last n))) := by
  have h := finite_row_composition_test_maps
    (S := fun _ => GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val))
    (T := fun _ => PhysicalBoundedMarkState P J ell B)
    (fun i G s => physicalSelectedCoarseScalar C aux L σ ω i *
      globalBirthJointCutRawRow
        (physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β
          (fun _ j => 1 - retention j) V (fun _ => ρ) hV B i) B B G s)
    (physicalSelectedCoarseRow (B := B) C aux k L σ τ β V ρ hV ω retention)
    (fun i G => physicalMarkRawExtension G (physicalMarkAtCut L i)) (2 * n + 1)
    (fun i hi G => physical_selected_coarse_extension C aux k L a σ τ hstep ζ hmarks
      hlist hP hdis hk β V ρ hV B ω retention i hi G) F
  have hfirst : physicalMarkAtCut L 0 = L 0 := by
    simpa using physical_mark_at_cut_even L (0 : Fin (n + 1))
  have hlast : physicalMarkAtCut L (2 * n + 1) = L (Fin.last n) := by
    simpa using physical_mark_at_cut_odd L (Fin.last n)
  simpa only [hfirst, hlast] using h

end ResiduePath
end Bounty
end

section

/- Four chronological selected physical rows per edge: a visit, the chosen
source permutation, the chosen auxiliary edge and target marks, and the
inverse target permutation. Each is a local filter of the original observed row. -/

open scoped Classical

namespace Bounty

noncomputable def physicalSelectedFineTag (n i : ℕ) : Option (Fin (n + 1) ⊕ Fin n) :=
  if hi : i < 4 * n + 1 then
    if h0 : i % 4 = 0 then some (.inl ⟨i / 4, by omega⟩)
    else if h2 : i % 4 = 2 then some (.inr ⟨i / 4, by omega⟩)
    else none
  else none

section Fine
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)

noncomputable def physicalSelectedFineTest (i : ℕ)
    (o : PhysicalMarkObservation P ell C) (t : PhysicalBoundedMarkState P J ell B) : Prop :=
  if hi : i < 4 * n + 1 then
    if h0 : i % 4 = 0 then
      let j : Fin (n + 1) := ⟨i / 4, by omega⟩
      o = .inr none ∧ t.1 = L j
    else
      let j : Fin n := ⟨i / 4, by omega⟩
      if i % 4 = 1 then o = .inl (σ j)
      else if i % 4 = 2 then
        o = .inr (some ⟨j, aux j⟩) ∧ t.1 = physicalPermuteLabels (τ j) (L j.succ)
      else o = .inl (physicalInversePermutations (τ j))
  else False

variable (k : Fin n → ℤ) (β : (g : Fin N) → ↥(P g) → ℝ)
  (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)

noncomputable def physicalSelectedFineRow (i : ℕ)
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    PhysicalBoundedMarkState P J ell B → ℂ :=
  physicalObservedMarkRow C k ω β retention ρ V hV (physicalSelectedFineTag n i)
    (fun o t => if physicalSelectedFineTest C aux L σ τ i o t then F t else 0)

theorem physical_selected_fine_row_visit (j : Fin (n + 1))
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    physicalSelectedFineRow C aux L σ τ k β V ρ hV ω retention (4 * j.val) F =
      physicalObservedMarkRow C k ω β retention ρ V hV (some (.inl j))
        (fun o t => if o = .inr none ∧ t.1 = L j then F t else 0) := by
  have hj := j.isLt
  have hi : 4 * j.val < 4 * n + 1 := by omega
  have h0 : (4 * j.val) % 4 = 0 := by omega
  have hd : (4 * j.val) / 4 = j.val := by omega
  have he (h : (4 * j.val) / 4 < n + 1) : (⟨(4 * j.val) / 4, h⟩ : Fin (n + 1)) = j := Fin.ext hd
  simp only [physicalSelectedFineRow, physicalSelectedFineTag, physicalSelectedFineTest,
    dif_pos hi, dif_pos h0, he]
  congr 1
  funext o t
  split_ifs <;> rfl

theorem physical_selected_fine_row_source_permutation (j : Fin n)
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    physicalSelectedFineRow C aux L σ τ k β V ρ hV ω retention (4 * j.val + 1) F =
      physicalObservedMarkRow C k ω β retention ρ V hV none
        (fun o t => if o = .inl (σ j) then F t else 0) := by
  have hj := j.isLt
  have hi : 4 * j.val + 1 < 4 * n + 1 := by omega
  have h0 : ¬ (4 * j.val + 1) % 4 = 0 := by omega
  have h1 : (4 * j.val + 1) % 4 = 1 := by omega
  have h2 : ¬ (4 * j.val + 1) % 4 = 2 := by omega
  have hd : (4 * j.val + 1) / 4 = j.val := by omega
  have he (h : (4 * j.val + 1) / 4 < n) : (⟨(4 * j.val + 1) / 4, h⟩ : Fin n) = j := Fin.ext hd
  simp only [physicalSelectedFineRow, physicalSelectedFineTag, physicalSelectedFineTest,
    dif_pos hi, dif_neg h0, dif_neg h2, if_pos h1, he]

theorem physical_selected_fine_row_edge (j : Fin n)
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    physicalSelectedFineRow C aux L σ τ k β V ρ hV ω retention (4 * j.val + 2) F =
      physicalObservedMarkRow C k ω β retention ρ V hV (some (.inr j))
        (fun o t => if o = .inr (some ⟨j, aux j⟩) ∧
          t.1 = physicalPermuteLabels (τ j) (L j.succ) then F t else 0) := by
  have hj := j.isLt
  have hi : 4 * j.val + 2 < 4 * n + 1 := by omega
  have h0 : ¬ (4 * j.val + 2) % 4 = 0 := by omega
  have h1 : ¬ (4 * j.val + 2) % 4 = 1 := by omega
  have h2 : (4 * j.val + 2) % 4 = 2 := by omega
  have hd : (4 * j.val + 2) / 4 = j.val := by omega
  have he (h : (4 * j.val + 2) / 4 < n) : (⟨(4 * j.val + 2) / 4, h⟩ : Fin n) = j := Fin.ext hd
  simp only [physicalSelectedFineRow, physicalSelectedFineTag, physicalSelectedFineTest,
    dif_pos hi, dif_neg h0, dif_pos h2, if_neg h1, if_pos h2, he]
  congr 1
  funext o t
  have haux (h : (4 * j.val + 2) / 4 < n) :
      (⟨⟨(4 * j.val + 2) / 4, h⟩, aux ⟨(4 * j.val + 2) / 4, h⟩⟩ :
        Σ j : Fin n, PhysicalAuxLabels P (C j)) = ⟨j, aux j⟩ :=
    congrArg (fun j : Fin n => (⟨j, aux j⟩ : Σ j : Fin n, PhysicalAuxLabels P (C j))) (he h)
  simp only [haux]
  split_ifs <;> rfl

theorem physical_selected_fine_row_target_permutation (j : Fin n)
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    physicalSelectedFineRow C aux L σ τ k β V ρ hV ω retention (4 * j.val + 3) F =
      physicalObservedMarkRow C k ω β retention ρ V hV none
        (fun o t => if o = .inl (physicalInversePermutations (τ j)) then F t else 0) := by
  have hj := j.isLt
  have hi : 4 * j.val + 3 < 4 * n + 1 := by omega
  have h0 : ¬ (4 * j.val + 3) % 4 = 0 := by omega
  have h1 : ¬ (4 * j.val + 3) % 4 = 1 := by omega
  have h2 : ¬ (4 * j.val + 3) % 4 = 2 := by omega
  have hd : (4 * j.val + 3) / 4 = j.val := by omega
  have he (h : (4 * j.val + 3) / 4 < n) : (⟨(4 * j.val + 3) / 4, h⟩ : Fin n) = j := Fin.ext hd
  simp only [physicalSelectedFineRow, physicalSelectedFineTag, physicalSelectedFineTest,
    dif_pos hi, dif_neg h0, dif_neg h2, if_neg h1, if_neg h2, he]

end Fine
end Bounty
end

section

/- The mask average equals the actual power weight on shifted prime divisibility. -/

open Finset Filter
open scoped Topology

namespace Bounty

noncomputable def pairShiftedPrimeSet (P : Finset ℕ) (v : ℕ × ℕ) : Finset ℕ :=
  P.filter (fun p => (v.1*v.2) % p = 1 % p)

theorem masked_pair_box_filter (a b c d m : ℕ) (W z : ℝ) (P S : Finset ℕ)
    (hP : P ⊆ primeBand 0 z) (hPm : ∀ p ∈ P, ¬p ∣ m) (hS : S ⊆ P) :
    maskedPairBox a b c d m W z S =
      (maskedPairBox a b c d m W z P).filter (fun v => pairShiftedPrimeSet P v ⊆ S) := by
  classical
  apply Finset.ext
  intro v
  rw [mem_filter]
  simp only [maskedPairBox, mem_filter]
  change _ ↔ _ ∧ P.filter (fun p => (v.1*v.2) % p = 1 % p) ⊆ S
  constructor
  · rintro ⟨hbase, hrough, hban⟩
    refine ⟨⟨hbase, hrough, ?_⟩, ?_⟩
    · intro p hp hpm hpP
      exact hban p hp hpm (fun hpS => hpP (hS hpS))
    · intro p hp
      obtain ⟨hpP, hpone⟩ := mem_filter.mp hp
      by_contra hpS
      exact hban p (hP hpP) (hPm p hpP) hpS hpone
  · rintro ⟨⟨hbase, hrough, hban⟩, hforced⟩
    refine ⟨hbase, hrough, ?_⟩
    intro p hp hpm hpS hpone
    by_cases hpP : p ∈ P
    · exact hpS (hforced (mem_filter.mpr ⟨hpP, hpone⟩))
    · exact hban p hp hpm hpP hpone

theorem masked_pair_average_eq_power_weight (a b c d m : ℕ) (W z q : ℝ)
    (P : Finset ℕ) (hP : P ⊆ primeBand 0 z) (hPm : ∀ p ∈ P, ¬p ∣ m) :
    (∑ S ∈ P.powerset, bernoulliSubsetWeight q P S *
      ((maskedPairBox a b c d m W z S).card : ℝ)) =
      ∑ v ∈ maskedPairBox a b c d m W z P, q^(pairShiftedPrimeSet P v).card := by
  classical
  calc
    _ = ∑ S ∈ P.powerset, ∑ v ∈ maskedPairBox a b c d m W z P,
        if pairShiftedPrimeSet P v ⊆ S then bernoulliSubsetWeight q P S else 0 := by
      apply sum_congr rfl
      intro S hS
      rw [masked_pair_box_filter a b c d m W z P S hP hPm (mem_powerset.mp hS)]
      have hc : (((maskedPairBox a b c d m W z P).filter
          (fun v => pairShiftedPrimeSet P v ⊆ S)).card : ℝ) =
          ∑ v ∈ maskedPairBox a b c d m W z P,
            if pairShiftedPrimeSet P v ⊆ S then (1 : ℝ) else 0 := by simp
      rw [hc, mul_sum]
      apply sum_congr rfl
      intro v _
      split_ifs <;> simp
    _ = ∑ v ∈ maskedPairBox a b c d m W z P,
        ∑ S ∈ P.powerset, if pairShiftedPrimeSet P v ⊆ S then bernoulliSubsetWeight q P S else 0 :=
      sum_comm
    _ = _ := by
      apply sum_congr rfl
      intro v _
      exact bernoulli_mask_contains P (pairShiftedPrimeSet P v) (filter_subset _ _) q

theorem pair_shifted_prime_set_eq_divisors (P : Finset ℕ) (v : ℕ × ℕ)
    (hv : 1 ≤ v.1*v.2) :
    pairShiftedPrimeSet P v = P.filter (fun p => p ∣ v.1*v.2-1) := by
  apply filter_congr
  intro p _
  rw [eq_comm]
  exact Nat.modEq_iff_dvd' hv

theorem masked_pair_average_eq_divisor_weight (a b c d m : ℕ) (W z q : ℝ)
    (P : Finset ℕ) (hP : P ⊆ primeBand 0 z) (hPm : ∀ p ∈ P, ¬p ∣ m) :
    (∑ S ∈ P.powerset, bernoulliSubsetWeight q P S *
      ((maskedPairBox a b c d m W z S).card : ℝ)) =
      ∑ v ∈ maskedPairBox a b c d m W z P, q^((P.filter (fun p => p ∣ v.1*v.2-1)).card) := by
  rw [masked_pair_average_eq_power_weight a b c d m W z q P hP hPm]
  apply sum_congr rfl
  intro v hv
  have hbase := (mem_filter.mp hv).1
  simp only [pairSieveBaseBox, Finset.product_eq_sprod, mem_filter, mem_product, mem_Ioc] at hbase
  have hx : 0 < v.1 := lt_of_le_of_lt (Nat.zero_le a) hbase.1.1.1
  have hy : 0 < v.2 := lt_of_le_of_lt (Nat.zero_le c) hbase.1.2.1
  rw [pair_shifted_prime_set_eq_divisors P v (Nat.succ_le_of_lt (mul_pos hx hy))]

theorem exists_candidate_shifted_divisor_pair_bound :
    ∃ K : ℝ, 0 < K ∧ ∀ (γ q : ℝ), 0 < γ → 0 ≤ q → q ≤ 1 →
      ∀ᶠ L : ℝ in atTop, ∀ (a b c d m : ℕ) [NeZero m] (W z : ℝ) (P : Finset ℕ),
        (m : ℝ) ≤ Real.exp L → (∀ p ∈ m.primeFactors, L^2 ≤ (p : ℝ)) →
        a ≤ b → c ≤ d → 0 ≤ W → W ≤ z → 1 < z →
        P ⊆ (candidatePIndices γ L).biUnion (candidatePBand (γ*L)) →
        P ⊆ primeBand 0 z → (∀ p ∈ P, ¬p ∣ m) →
        (∑ v ∈ maskedPairBox a b c d m W z P,
          q^((P.filter (fun p => p ∣ v.1*v.2-1)).card)) ≤
          K * (((b : ℝ)-a)*((d : ℝ)-c)/(m : ℝ)) *
            (∏ p ∈ primeBand 0 W, (1 - 1/(p : ℝ)))^2 *
            (∏ p ∈ primeBand 0 z, (1 - 1/(p : ℝ))) *
            candidateOneMarkedHarmonicMass γ L q +
          ((m : ℝ)*(z^(10 : ℝ))^3 + (((b : ℝ)-a)+((d : ℝ)-c))*(z^(10 : ℝ))^2) := by
  obtain ⟨K, hK, hb⟩ := exists_candidate_masked_pair_bound
  refine ⟨K, hK, ?_⟩
  intro γ q hγ hq0 hq1
  filter_upwards [hb γ q hγ hq0 hq1] with L h
  intro a b c d m hm W z P hmL hmin hab hcd hW hWz hz hP hPz hPm
  rw [← masked_pair_average_eq_divisor_weight a b c d m W z q P hPz hPm]
  exact h a b c d m W z P hmL hmin hab hcd hW hWz hz hP

end Bounty
end

section

/- The selected scalar product retains exactly one auxiliary law and both permutation averages per edge. -/

open Finset
namespace Bounty

section Product
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (σ : Fin n → PhysicalPermutations (Fin N) J ell)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)

theorem physical_selected_coarse_scalar_product :
    (∏ i ∈ range (2 * n + 1), physicalSelectedCoarseScalar C aux L σ ω i) =
      ∏ j : Fin n, (((Fintype.card (PhysicalPermutations (Fin N) J ell) : ℝ)⁻¹ : ℂ) ^ 2) *
        (ω j (physicalSharedMarkLabels (C j) (physicalPermuteLabels (σ j) (L j.castSucc)))
          (aux j) : ℂ) := by
  rw [alternating_even_one_product _ n (fun j hj =>
    physical_selected_coarse_scalar_even C aux L σ ω ⟨j, by omega⟩)]
  rw [← Fin.prod_univ_eq_prod_range]
  apply prod_congr rfl
  intro j hj
  exact physical_selected_coarse_scalar_odd C aux L σ ω j

end Product
end Bounty
end

section

/- Finite cardinality bounds for the concrete physical prime patterns. -/

open Finset
open scoped Classical

namespace Bounty

theorem repeated_big_prime_pattern_cut_subset {G : Type*} [DecidableEq G]
    {J ell : ℕ} (probes : G → Finset (Fin J)) (r t : Finset G)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t) (g : G) :
    repeatedBigPrimePatternCut probes r t i g ⊆ probes g := by
  cases i with
  | inl u => exact empty_subset _
  | inr ab =>
      intro j hj
      have hm := (mem_repeatedBigAuxCut ab.1.val ab.2.val g j).mp hj
      rcases mem_union.mp hm with ha | hb
      · have hs := ((clean_mem_nonempty_subsets _ _).mp ab.1.property).2 ha
        have hp := (mem_sigma.mp hs).2
        simpa [repeatedBigPrimeProbeSlots] using hp
      · have hs := ((clean_mem_nonempty_subsets _ _).mp ab.2.property).2 hb
        have hp := (mem_sigma.mp hs).2
        simpa [repeatedBigPrimeProbeSlots] using hp

theorem repeated_big_prime_pattern_cut_card_le {G : Type*} [DecidableEq G]
    {J ell m : ℕ} (probes : G → Finset (Fin J)) (r t : Finset G)
    (hp : ∀ g, (probes g).card ≤ m)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t) (g : G) :
    (repeatedBigPrimePatternCut probes r t i g).card ≤ m :=
  (card_le_card (repeated_big_prime_pattern_cut_subset probes r t i g)).trans (hp g)

theorem repeated_big_prime_probe_sigma_card_le {G : Type*} [DecidableEq G]
    {J ell m : ℕ} (probes : G → Finset (Fin J)) (r : Finset G)
    (hp : ∀ g, (probes g).card ≤ m) :
    (r.sigma (repeatedBigPrimeProbeSlots (ell := ell) probes)).card ≤ m * r.card := by
  rw [card_sigma]
  calc
    _ ≤ ∑ _g ∈ r, m := by
      apply sum_le_sum
      intro g hg
      simpa only [repeatedBigPrimeProbeSlots, card_map] using hp g
    _ = _ := by simp [Nat.mul_comm]

theorem repeated_big_prime_pattern_pair_card {G : Type*} [DecidableEq G]
    {J ell : ℕ} (probes : G → Finset (Fin J)) (r t : Finset G) :
    Fintype.card (RepeatedBigPrimePatternPair (ell := ell) probes r t) =
      (2 ^ (r.sigma (repeatedBigPrimeProbeSlots (ell := ell) probes)).card - 1) *
        (2 ^ (t.sigma (repeatedBigPrimeProbeSlots (ell := ell) probes)).card - 1) := by
  unfold RepeatedBigPrimePatternPair
  rw [Fintype.card_prod, Fintype.card_coe, Fintype.card_coe]
  simp [cleanNonemptySubsets]

theorem repeated_big_prime_pattern_pair_card_le {G : Type*} [DecidableEq G]
    {J ell m : ℕ} (probes : G → Finset (Fin J)) (r t : Finset G)
    (hp : ∀ g, (probes g).card ≤ m) :
    Fintype.card (RepeatedBigPrimePatternPair (ell := ell) probes r t) ≤
      2 ^ (m * (r.card + t.card)) := by
  rw [repeated_big_prime_pattern_pair_card]
  calc
    _ ≤ 2 ^ (r.sigma (repeatedBigPrimeProbeSlots (ell := ell) probes)).card *
        2 ^ (t.sigma (repeatedBigPrimeProbeSlots (ell := ell) probes)).card :=
      Nat.mul_le_mul (Nat.sub_le _ _) (Nat.sub_le _ _)
    _ = 2 ^ ((r.sigma (repeatedBigPrimeProbeSlots (ell := ell) probes)).card +
        (t.sigma (repeatedBigPrimeProbeSlots (ell := ell) probes)).card) := (pow_add _ _ _).symm
    _ ≤ _ := by
      apply Nat.pow_le_pow_right (by decide : 1 ≤ 2)
      have hr := repeated_big_prime_probe_sigma_card_le (ell := ell) probes r hp
      have ht := repeated_big_prime_probe_sigma_card_le (ell := ell) probes t hp
      nlinarith

theorem repeated_big_prime_pattern_card_le {G : Type*} [DecidableEq G]
    {J ell m : ℕ} (probes : G → Finset (Fin J)) (r t : Finset G)
    (hp : ∀ g, (probes g).card ≤ m) :
    Fintype.card (RepeatedBigPrimePatternIndex (ell := ell) probes r t) ≤
      1 + 2 ^ (m * (r.card + t.card)) := by
  simpa only [RepeatedBigPrimePatternIndex, Fintype.card_sum, Fintype.card_unit] using
    Nat.add_le_add_left (repeated_big_prime_pattern_pair_card_le (ell := ell) probes r t hp) 1

theorem repeated_big_prime_pattern_pair_card_le_groups {G : Type*}
    [Fintype G] [DecidableEq G] {J ell m : ℕ}
    (probes : G → Finset (Fin J)) (r t : Finset G) (hrt : Disjoint r t)
    (hp : ∀ g, (probes g).card ≤ m) :
    Fintype.card (RepeatedBigPrimePatternPair (ell := ell) probes r t) ≤
      2 ^ (m * Fintype.card G) := by
  apply (repeated_big_prime_pattern_pair_card_le (ell := ell) probes r t hp).trans
  apply Nat.pow_le_pow_right (by decide : 1 ≤ 2)
