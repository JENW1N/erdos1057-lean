theorem eventually_candidate_big_cell_local_scale {c b : ℝ}
    (hc : 0 < c) (hb : 0 < b) (J : ℕ) (K q : ℝ) (hq : 0 ≤ q) :
    ∀ᶠ L : ℝ in atTop, ∀ (S : Finset ℕ), S ⊆ candidatePIndices c L →
      let P := fun g : S => candidatePBand (c*L) g.val
      ∀ (ell : ℕ) (probes : S → Finset (Fin J)) (r t : Finset S)
        (A B : Finset (RepeatedBigFlatIndex S J ell)),
        A ⊆ r.sigma (repeatedBigPrimeProbeSlots probes) → A.Nonempty →
        B ⊆ t.sigma (repeatedBigPrimeProbeSlots probes) → B.Nonempty →
        (∃ i : A, i.val.1.val ∈ candidateBigPIndices c L) →
      ∀ (Q : ℕ) (h : ℝ), 0 < h → h ≤ 1 →
      ∀ (d e : ℤ) (χ ψ : BoundedPrimitiveCharacter Q) (ζ : ℝ),
        (∃ x : (∀ i : A, P i.val.1),
          (starRingEnd ℂ) (primeProductCellCharacter (fun i : A => P i.val.1) h d χ x) *
            physicalPhase ζ (∏ i, (x i).val) ≠ 0) →
        (∃ y : (∀ i : B, P i.val.1),
          (starRingEnd ℂ) (primeProductCellCharacter (fun i : B => P i.val.1) h e ψ y) *
            physicalPhase ζ (∏ i, (y i).val) ≠ 0) →
      ∀ (k : ℤ), k ≠ 0 → |(k : ℝ)| ≤ L^K →
      ∀ Psmall : ℝ, Psmall ≤ Real.exp (L^(1/5 : ℝ)) →
        let HA := Real.exp (((d : ℝ)-1)*h)
        let HB := Real.exp (((e : ℝ)-1)*h)
        let H := |(k : ℝ)| *HA*HB/L^q
        4096*Psmall*L ≤ H ∧ H ≤ Real.exp ((b/2)*L) := by
  filter_upwards [eventually_candidate_big_slot_cell_lower hc J,
    eventually_small_prime_scale_le_big (q+1),
    eventually_candidate_occupied_cell_scale hc (ε := 1) (by norm_num) J 0,
    eventually_candidate_cell_local_scale hc hb J K q 0 hq (le_refl 0),
    eventually_ge_atTop (1 : ℝ)] with L hbig hsmall hcell hlocal hL
  intro S hS P ell probes r t A B hA hAne hB hBne hAbig Q h hh hh1
    d e χ ψ ζ hx hy k hk hkK Psmall hPsmall
  let HA := Real.exp (((d : ℝ)-1)*h)
  let HB := Real.exp (((e : ℝ)-1)*h)
  change 4096*Psmall*L ≤ |(k : ℝ)| *HA*HB/L^q ∧
    |(k : ℝ)| *HA*HB/L^q ≤ Real.exp ((b/2)*L)
  have hHA : 4096*Real.exp (L^(1/5 : ℝ))*L^(q+1) ≤ HA :=
    hsmall.trans (hbig S hS ell A hAbig Q h hh hh1 d χ ζ hx)
  have hHB : 1 ≤ HB := by
    simpa only [Real.rpow_zero] using
      (hcell S hS ell probes t B hB hBne Q h hh hh1 e ψ ζ hy).1
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hk1 : 1 ≤ |(k : ℝ)| := by
    have hz : (0 : ℤ) < |k| := abs_pos.mpr hk
    have hi : (1 : ℤ) ≤ |k| := by omega
    exact_mod_cast hi
  refine ⟨?_, (hlocal S hS ell probes r t A B hA hAne hB hBne Q h hh hh1
    d e χ ψ ζ hx hy k hk hkK).2⟩
  apply (le_div_iff₀ (Real.rpow_pos_of_pos hL0 q)).mpr
  calc
    4096*Psmall*L*L^q = 4096*Psmall*L^(q+1) := by
      rw [Real.rpow_add hL0, Real.rpow_one]
      ring
    _ ≤ 4096*Real.exp (L^(1/5 : ℝ))*L^(q+1) :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hPsmall (by norm_num))
        (Real.rpow_nonneg hL0.le _)
    _ = 1*(4096*Real.exp (L^(1/5 : ℝ))*L^(q+1))*1 := by ring
    _ ≤ |(k : ℝ)| *HA*HB := by gcongr

end Bounty
