noncomputable def distanceBinCap (N r j : ℕ) : ℝ :=
  if j = 0 then N else (r : ℝ) / j

theorem distance_bin_cap_nonneg (N r j : ℕ) : 0 ≤ distanceBinCap N r j := by
  unfold distanceBinCap
  split_ifs <;> positivity

theorem distance_bin_cap_sum (N r : ℕ) :
    (∑ j ∈ Finset.range (r + 1), distanceBinCap N r j) =
      N + (r : ℝ) * (harmonic r : ℝ) := by
  rw [Finset.sum_range_succ']
  simp only [distanceBinCap, Nat.add_eq_zero_iff, one_ne_zero, and_false,
    ↓reduceIte, Nat.cast_add, Nat.cast_one]
  have hh : (∑ j ∈ Finset.range r, (r : ℝ) / (j + 1)) =
      (r : ℝ) * (harmonic r : ℝ) := by
    simp only [harmonic, Rat.cast_sum, Rat.cast_inv, Rat.cast_add, Rat.cast_one, Rat.cast_natCast,
      Finset.mul_sum, Nat.cast_add, Nat.cast_one, div_eq_mul_inv]
  rw [hh, add_comm]

theorem centered_circle_bin_le (r : ℕ) (x : ℝ) :
    (signedDistanceBin (2 * (r : ℝ)) (x - (round x : ℝ))).2 ≤ r := by
  change ⌊2 * (r : ℝ) * |x - (round x : ℝ)|⌋₊ ≤ r
  have hb : 2 * (r : ℝ) * |x - (round x : ℝ)| ≤ r := by
    have h := abs_sub_round x
    nlinarith
  exact (Nat.floor_le_floor hb).trans_eq (Nat.floor_natCast r)

theorem circle_geometric_le_distance_bin_cap (N : ℕ) {r : ℕ} (hr : 0 < r) (x : ℝ) :
    circleGeometricBound N x ≤
      distanceBinCap N r (signedDistanceBin (2 * (r : ℝ)) (x - (round x : ℝ))).2 := by
  let j := (signedDistanceBin (2 * (r : ℝ)) (x - (round x : ℝ))).2
  change circleGeometricBound N x ≤ distanceBinCap N r j
  by_cases hj : j = 0
  · rw [distanceBinCap, if_pos hj]
    unfold circleGeometricBound
    split_ifs
    · exact le_rfl
    · exact min_le_left _ _
  · have hj0 : (0 : ℝ) < j := by exact_mod_cast (Nat.pos_of_ne_zero hj)
    have hr0 : (0 : ℝ) < r := by exact_mod_cast hr
    have hfloor : (j : ℝ) ≤ 2 * (r : ℝ) * ‖(x : UnitAddCircle)‖ := by
      rw [UnitAddCircle.norm_eq]
      exact Nat.floor_le (by positivity)
    have hd : 0 < ‖(x : UnitAddCircle)‖ := by nlinarith
    rw [distanceBinCap, if_neg hj, circleGeometricBound, if_neg (norm_pos_iff.mp hd)]
    apply (min_le_right _ _).trans
    apply (div_le_div_iff₀ (by positivity : 0 < 2 * ‖(x : UnitAddCircle)‖) hj0).mpr
    nlinarith

/-- Mutually `1/(2r)`-separated phases have two near-zero bins and a harmonic tail. -/
theorem circle_geometric_finite_sum_le {ι : Type*} (S : Finset ι) (θ : ι → ℝ)
    (N : ℕ) {r : ℕ} (hr : 0 < r)
    (hsep : ∀ i ∈ S, ∀ j ∈ S, i ≠ j →
      1 / (2 * (r : ℝ)) ≤ ‖((θ i - θ j : ℝ) : UnitAddCircle)‖) :
    (∑ i ∈ S, circleGeometricBound N (θ i)) ≤
      2 * (N : ℝ) + 2 * (r : ℝ) * (1 + Real.log r) := by
  classical
  let key := fun i => signedDistanceBin (2 * (r : ℝ)) (θ i - (round (θ i) : ℝ))
  let W : Bool × ℕ → ℝ := fun b => distanceBinCap N r b.2
  have hi : Set.InjOn key S := centered_circle_distance_bin_injOn S θ (by positivity) hsep
  have hs : S.image key ⊆ Finset.univ ×ˢ Finset.range (r + 1) := by
    intro b hb
    obtain ⟨i, hiS, rfl⟩ := Finset.mem_image.mp hb
    simp only [Finset.mem_product, Finset.mem_univ, true_and, Finset.mem_range]
    exact Nat.lt_succ_of_le (centered_circle_bin_le r (θ i))
  calc
    _ ≤ ∑ i ∈ S, W (key i) :=
      Finset.sum_le_sum (fun i hiS => circle_geometric_le_distance_bin_cap N hr (θ i))
    _ = ∑ b ∈ S.image key, W b := (Finset.sum_image hi).symm
    _ ≤ ∑ b ∈ Finset.univ ×ˢ Finset.range (r + 1), W b :=
      Finset.sum_le_sum_of_subset_of_nonneg hs (fun b hb hn => distance_bin_cap_nonneg N r b.2)
    _ = 2 * ((N : ℝ) + (r : ℝ) * (harmonic r : ℝ)) := by
      rw [Finset.sum_product]
      simp only [W, distance_bin_cap_sum, Finset.sum_const, Finset.card_univ,
        Fintype.card_bool, nsmul_eq_mul, Nat.cast_ofNat]
    _ ≤ _ := by
      have hh := harmonic_le_one_add_log r
      have hr0 : (0 : ℝ) ≤ r := by positivity
      nlinarith
end

