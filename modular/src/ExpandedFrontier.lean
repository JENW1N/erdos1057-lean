  fullActiveMemoryAverage S B ω
    (fun c a => unrestrictedCoupledCutoffProductOperator n (Δ c a) (D c a)
      μ ρ V (fun g => (S g)ᶜ.card) B (phase c a)) f

theorem full_active_unrestricted_edge_energy_le
    (hω : ∀ c a, 0 ≤ ω c a) (hωmass : ∀ c, ∑ a, ω c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, (S g)ᶜ.card ≤ T)
    (phase : ∀ c a, UnrestrictedProductPhase n (Δ c a) (D c a)
      (fun g => (S g)ᶜ.card) B)
    (hphase : ∀ c a s e, ‖phase c a s e‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fullActiveUnrestrictedEdge n S B ω Δ D μ ρ V phase f) ≤
      unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  apply full_active_memory_average_energy_le S B μ
    (fun g => unrestrictedResidueWeight (μ g)) hμ (fun g z => hμ g z.1)
    ω hω hωmass _ (pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _)
    _ f hf
  intro c a F hF
  exact unrestricted_coupled_cutoff_product_energy_le n (Δ c a) (D c a) μ ρ V
    (fun g => (S g)ᶜ.card) B hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht
    (phase c a) (hphase c a) F hF

theorem full_active_unrestricted_positive_symmetric
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric
      (fullActiveUnrestrictedEdge n S B ω Δ D μ ρ V (fun _ _ _ _ => 1) f) := by
  apply full_active_memory_average_symmetric S B ω _ _ f hf
  intro c a F hF
  rw [unrestricted_coupled_positive_cutoff_eq_product]
  exact unrestricted_positive_cutoff_product_symmetric n (Δ c a) (D c a) μ ρ V
    (fun g => (S g)ᶜ.card) B univ F hF


omit [DecidableEq G] [∀ g p, NeZero (n g p)] in
theorem full_active_unrestricted_positive_re_mono
    (hω : ∀ c a, 0 ≤ ω c a) (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ V g)
    (hμ : ∀ g p, 0 ≤ μ g p)
    (f h : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hfh : ∀ x, (f x).re ≤ (h x).re)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    (fullActiveUnrestrictedEdge n S B ω Δ D μ ρ V (fun _ _ _ _ => 1) f x).re ≤
      (fullActiveUnrestrictedEdge n S B ω Δ D μ ρ V (fun _ _ _ _ => 1) h x).re := by
  apply equiv_fiber_average_lift_re_mono (productActiveMemorySplit S B) ω hω _ _ f h hfh x
  intro c a F H hFH y
  exact unrestricted_coupled_positive_cutoff_re_mono n (Δ c a) (D c a) μ ρ V
    (fun g => (S g)ᶜ.card) B hρ hV hμ F H hFH y

omit [DecidableEq G] [∀ g p, NeZero (n g p)] in
theorem full_active_unrestricted_edge_norm_le_positive
    (hω : ∀ c a, 0 ≤ ω c a) (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ V g)
    (hμ : ∀ g p, 0 ≤ μ g p)
    (phase : ∀ c a, UnrestrictedProductPhase n (Δ c a) (D c a)
      (fun g => (S g)ᶜ.card) B)
    (hphase : ∀ c a s e, ‖phase c a s e‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
