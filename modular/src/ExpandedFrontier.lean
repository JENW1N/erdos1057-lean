section

/- Comparison of the actual vacuum scalars at two finite memory caps. -/

open Finset Classical

namespace Bounty

section

variable {J K G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  {M : G → ℕ} (S : K → ∀ g, Finset (Fin (M g)))
  (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
  (Δ D : ∀ k c, A k c → G → ℤ)
  {b B : ℕ} (h : b ≤ B)
  (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)

theorem full_permutation_vacuum_scalar_sub_cap
    (steps : List (Option (J ⊕ K)))
    (phase : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → ℂ) :
    fullPermutationVacuumScalar n S A Δ D ω μ q ρ V steps B phase -
      fullPermutationVacuumScalar n S A Δ D ω μ q ρ V steps b
        (fullPermutationMixedCapPhase n S A Δ D h ω μ q ρ V steps phase) =
    ∑ s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b,
      (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)) s : ℂ) *
        fullMemoryVacuum s *
          (fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps phase
              fullMemoryVacuum (productStateCapEmbed h s) -
            fullPermutationMixedPathAction n S b A Δ D ω μ q ρ V steps
              (fullPermutationMixedCapPhase n S A Δ D h ω μ q ρ V steps phase)
              fullMemoryVacuum s) := by
  unfold fullPermutationVacuumScalar
  rw [full_memory_vacuum_pairing_cap h μ (fun g => unrestrictedResidueWeight (μ g))
    (fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps phase fullMemoryVacuum)]
  rw [← sum_sub_distrib]
  apply sum_congr rfl
  intro s _
  ring

theorem full_permutation_vacuum_scalar_cap_error
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 < μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (hC : ∀ j g, q j / ρ ^ 2 + ((1 - q j) * (2 * V g) / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (steps : List (Option (J ⊕ K)))
    (phase : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1) :
    ‖fullPermutationVacuumScalar n S A Δ D ω μ q ρ V steps B phase -
      fullPermutationVacuumScalar n S A Δ D ω μ q ρ V steps b
        (fullPermutationMixedCapPhase n S A Δ D h ω μ q ρ V steps phase)‖ ^ 2 ≤
      ((2 : ℝ) ^ (b + 1 - fullMemoryEdgeCount steps * (T * Fintype.card G)))⁻¹ ^ 2 *
        (steps.map (fullDoubledGhostStepEnergy ρ v vmin vmax T (Fintype.card G))).prod *
        (∏ g, (∑ p, μ g p) ^ M g) ^ 2 := by
  rw [full_permutation_vacuum_scalar_sub_cap]
  exact full_permutation_mixed_cap_vacuum_pairing_le n S A Δ D h ω μ q ρ V
    hω hωmass hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass hq0 hq1 hD hC T ht steps phase hphase

end

end Bounty
end

section

/- Candidate remainder cancellation on the actual prime and remainder dyadic buckets. -/

open Finset Filter

namespace Bounty

theorem eventually_candidate_dyadic_block_decay {c q theta : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ)*(r : ℝ)*c = 1) (htheta : theta < 1/2) (B : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, 0 < jStar → ∀ (h : ℕ) (R : ℝ),
      Real.exp ((c/512)*L) ≤ R → R ≤ Real.exp (theta*L) →
      ∀ Q : Finset ℕ,
        (∀ d ∈ Q, R/2 ≤ (d : ℝ)) → (∀ d ∈ Q, (d : ℝ) ≤ R) →
        ∀ i j : ℕ,
          primitiveCharacterBlockNorm Q
            (∑ p ∈ dyadicNatBucket (candidateQBand (c*L) 0) i,
              ∑ n ∈ dyadicNatBucket (Icc 1 ⌊16*Real.exp L⌋₊) j, fun f χ =>
                if Real.exp L < ((p*n : ℕ) : ℝ) ∧ ((p*n : ℕ) : ℝ) ≤ 16*Real.exp L then
                  (if p.Coprime h then (1 : ℂ) else 0) *
                  (if n.Coprime h then (candidateRemainderCoefficient c L q r jStar hr n : ℂ) else 0) *
                    χ ((p*n : ℕ) : ZMod f)
                else 0) ≤ Real.exp L * L^(-B) := by
  filter_upwards [eventually_candidate_factor_two_block_decay hc hr hq0 hq1 hcenter htheta B]
    with L hblockL
  intro jStar hj h R hRLo hRHi Q hQD hQR i j
  have hSpos : ∀ p ∈ candidateQBand (c*L) 0, 0 < p := by
    intro p hp
    exact ((mem_dyadicPrimeBand_iff (c*L) 1 (6/5) 0 p).mp hp).1.pos
  have hTpos : ∀ n ∈ Icc 1 ⌊16*Real.exp L⌋₊, 0 < n :=
    fun n hn => (mem_Icc.mp hn).1
  exact hblockL jStar hj h R ((2 : ℝ)^(i+1)) ((2 : ℝ)^(j+1)) hRLo hRHi Q
    (dyadicNatBucket (candidateQBand (c*L) 0) i)
    (dyadicNatBucket (Icc 1 ⌊16*Real.exp L⌋₊) j) hQD hQR
    (dyadicNatBucket_subset _ _) (dyadicNatBucket_subset _ _)
    (fun p hp => dyadicNatBucket_upper_scale_real _ hSpos hp)
    (fun n hn => dyadicNatBucket_upper_scale_real _ hTpos hn)

end Bounty

