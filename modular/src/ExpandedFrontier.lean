namespace Bounty
section Full
variable {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin N → Finset (Fin J)) (k : ℤ) (L R : PhysicalMarkLists P J ell)
  (H : (g : Fin N) → Finset ↥(P g))
  (q : (g : Fin N) → BoundedOrderedTuple
    (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B)

theorem physical_full_edge_auxiliary_observed_rows
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (β : (g : Fin N) → ↥(P g) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (ω : ∀ _c : SharedActiveLabels (fun g => ↥(P g))
      (fun g => physicalFullSharedIndices (ell := ell) (C g)), PhysicalAuxLabels P C → ℝ)
    (F : PhysicalAuxLabels P C → GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ) :
    let S := fun g => physicalFullSharedIndices (ell := ell) (C g)
    let x := physicalFullMemoryState C L q
    let c := (productActiveMemorySplit S B x).1
    (∑ aux : PhysicalAuxLabels P C, (ω c aux : ℂ) *
      if physicalListAdmissible C aux L R then
        jointRawTensorCutoff B (physicalFullEdgeRawRow (B := B) C k L R β ρ V aux) (F aux)
          (fun g => (H g, boundedOrderedTupleToFinite (q g))) else 0) =
    ∑ e : PhysicalFullEdgeEvent C k x,
      (fullActiveEdgeEventWeight (fun g (p : ↥(P g)) => p.val) S B
        (fun _ => PhysicalAuxLabels P C) (physicalFullEdgeDelta C k) (physicalFullEdgeD C)
        ω (fun g p => β g p / V g) ρ V x e : ℂ) * physicalFullEdgePhase C k L R H q e *
      F e.1 (fullEdgeLedgerRawTarget (fun g (p : ↥(P g)) => p.val) S B
        (fun _ => PhysicalAuxLabels P C) (physicalFullEdgeDelta C k) (physicalFullEdgeD C) H x e) := by
  exact full_edge_ledger_observed_rows (fun g (p : ↥(P g)) => p.val)
    (fun g => physicalFullSharedIndices (C g)) B (fun _ => PhysicalAuxLabels P C)
    (physicalFullEdgeDelta C k) (physicalFullEdgeD C)
    (fun g => ((productActiveMemorySplit (fun g => physicalFullSharedIndices (C g)) B
      (physicalFullMemoryState C R q)).2 g).1) H (physicalFullMemoryState C L q)
    β ρ V ω (fun aux => physicalListAdmissible C aux L R)
    (physicalFullEdgeRawRow (B := B) C k L R β ρ V)
