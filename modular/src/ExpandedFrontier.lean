section

/- A positive margin after the unbalanced Buchstab mesh and balanced tail. -/

namespace Bounty

open Finset Real

theorem exists_positive_buchstab_mesh_parameters (Kpre Cbal : ℝ) (hCbal : 0 ≤ Cbal) :
    ∃ κ q b : ℝ, ∃ h N : ℕ, ∃ M : Fin N → ℝ,
      0 < κ ∧ κ ≤ 1/50 ∧ q = 1/2-κ ∧ 0 < q ∧ q < 1/2 ∧
      0 < b ∧ b < q ∧ 1 ≤ h ∧ Even h ∧ b*(4*(h : ℝ)+2) < 1/2 ∧
      Cbal*κ ≤ shiftedSieveRatioConstant/16 ∧ 0 < N ∧
      (∀ i : Fin N,
        reciprocalGrid b q N (i : ℕ) < reciprocalGrid b q N ((i : ℕ)+1) ∧ 0 < M i ∧
        ∀ α ∈ Set.Icc (reciprocalGrid b q N (i : ℕ)) (reciprocalGrid b q N ((i : ℕ)+1)),
          buchstabDensity (reciprocalGrid b q N (i : ℕ)) (1-α) ≤ M i) ∧
      (∑ i : Fin N, M i*log (reciprocalGrid b q N ((i : ℕ)+1)/reciprocalGrid b q N (i : ℕ))) ≤
        buchstabDensity b 1-1+1/16 ∧
      shiftedSieveRatioConstant/2 <
        shiftedSieveRatioConstant*(Mertens.primeProductLimitConstant/b)*(1-Kpre*exp (-(h : ℝ))) -
          shiftedSieveRatioConstant*
            (∑ i : Fin N, M i*log (reciprocalGrid b q N ((i : ℕ)+1)/reciprocalGrid b q N (i : ℕ))) -
          Cbal*κ := by
  have hS : 0 < shiftedSieveRatioConstant :=
    lt_of_lt_of_le zero_lt_one shifted_sieve_ratio_constant_bounds.1
  let κ : ℝ := min (1/50) (shiftedSieveRatioConstant/(16*(Cbal+1)))
  have hκ : 0 < κ := by dsimp [κ]; positivity
  have hκmax : κ ≤ 1/50 := min_le_left _ _
  have hκloss : Cbal*κ ≤ shiftedSieveRatioConstant/16 := by
    have he : κ*(16*(Cbal+1)) ≤ shiftedSieveRatioConstant :=
      (le_div_iff₀ (by positivity : 0 < 16*(Cbal+1))).mp (min_le_right _ _)
    nlinarith
  let q : ℝ := 1/2-κ
  have hq : 0 < q := by dsimp [q]; linarith
  have hqhalf : q < 1/2 := by dsimp [q]; linarith
  obtain ⟨b,h,hb,hbq,hh,heven,hlevel,hgap⟩ := exists_positive_buchstab_subtraction Kpre hq
  obtain ⟨N,hN,M,hbins,hsum⟩ := exists_buchstab_upper_mesh_density_bound hb hbq hqhalf.le
    (show (0 : ℝ)<1/16 by norm_num)
  refine ⟨κ,q,b,h,N,M,hκ,hκmax,rfl,hq,hqhalf,hb,hbq,hh,heven,hlevel,hκloss,hN,hbins,hsum,?_⟩
  have hgapS := mul_lt_mul_of_pos_left hgap hS
  have hsumS := mul_le_mul_of_nonneg_left hsum hS.le
  nlinarith

end Bounty

/- Public declaration closure audit. -/
end

section

/- Actual rough-proxy bin bounds and their finite aggregation. -/

open Finset Filter

namespace Bounty

theorem half_error_density_slack {R ε : ℝ} (hε : 0 < ε) :
    let η := ε / (2 * (|R| + 1))
    0 < η ∧ R * η ≤ ε / 2 := by
  have hd : 0 < 2 * (|R| + 1) := by positivity
  refine ⟨div_pos hε hd, ?_⟩
  have hη : 0 ≤ ε / (2 * (|R| + 1)) := (div_pos hε hd).le
  calc
    R * (ε / (2 * (|R| + 1))) ≤ (|R| + 1) * (ε / (2 * (|R| + 1))) :=
      mul_le_mul_of_nonneg_right (by linarith [le_abs_self R]) hη
    _ = ε / 2 := by field_simp

theorem arithmetic_window_cofactor_product_bounds {L : ℝ} (hL : 0 ≤ L)
    {p m u : ℕ} (hu : u ∈ arithmeticProductWindow 1 (Real.exp L))
    (hprod : p * m = 2 * u + 1) :
    0 < m ∧ 2 * Real.exp L ≤ (p : ℝ) * (m : ℝ) ∧
      (p : ℝ) * (m : ℝ) ≤ 33 * Real.exp L := by
  have hw := (mem_arithmeticProductWindow_iff (by norm_num : (1 : ℕ) ≠ 0) (Real.exp L)).mp hu
  simp only [one_mul] at hw
  have he : 1 ≤ Real.exp L := Real.one_le_exp hL
  have hp : (p : ℝ) * (m : ℝ) = 2 * (u : ℝ) + 1 := by exact_mod_cast hprod
  refine ⟨?_, ?_, ?_⟩
  · by_contra hm
    have hm0 : m = 0 := by omega
    simp [hm0] at hprod
  · nlinarith [hw.1]
  · nlinarith [hw.2]

theorem exists_candidate_unbalanced_rough_bin_upper
    (hZ : PrimitiveZeroFreeHalfPlane) {c q γ a v S M : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11 / 5 : ℝ) * (r : ℝ) * c = 1)
    (hγ : 0 < γ) (ha : 0 < a) (hav : a ≤ v) (hvhalf : v < 1 / 2)
    (hvγ : v < 1 - γ) (hS : 0 ≤ S) (hM : 0 ≤ M)
    (hdensity : ∀ α ∈ Set.Icc a v, buchstabDensity γ (1 - α) ≤ M) :
    ∃ J : ℕ, ∀ jStar : ℕ, J < jStar → ∀ ε : ℝ, 0 < ε →
      ∀ᶠ L : ℝ in atTop, ∀ (F : Finset (ℕ × ℕ)) (u : ℕ × ℕ → ℕ),
        (∀ w ∈ F, u w ∈ arithmeticProductWindow 1 (Real.exp L) ∧
          w.1 ∈ primeBand (Real.exp (a * L)) (Real.exp (v * L)) ∧ w.1 * w.2 = 2 * u w + 1) →
        (∑ w ∈ F, candidateCoefficient c L q r jStar (u w) * roughTestLogarithmicProxy γ L S w.2) ≤
          (shiftedSieveRatioConstant * M * Real.log (v / a) + ε) *
            candidateCoefficientWindowMass c L q r jStar / L := by
  obtain ⟨J, hJ⟩ := exists_candidate_unbalanced_rough_logarithmic_proxy_upper
    hZ hc hr hq0 hq1 hcenter ha hav hvhalf
  refine ⟨J, ?_⟩
  intro jStar hj ε hε
  let R := shiftedSieveRatioConstant * Real.log (v / a)
  let η := ε / (2 * (|R| + 1))
  have hη : 0 < η ∧ R * η ≤ ε / 2 := half_error_density_slack hε
  filter_upwards [hJ jStar hj (M + η) (by positivity) (ε / 2) (by positivity),
    eventually_cofactor_rough_test_coefficient_upper hγ ha hav hvγ
      (by norm_num : (0 : ℝ) < 2) (by norm_num : (0 : ℝ) < 33) hS hdensity hη.1,
    eventually_gt_atTop (0 : ℝ)] with L hbound hcoef hL
  intro F u hdata
  have hb := hbound γ S F u hdata (by
    intro w hw
    obtain ⟨huw, hpw, hprod⟩ := hdata w hw
    obtain ⟨hm, hlo, hhi⟩ := arithmetic_window_cofactor_product_bounds hL.le huw hprod
    exact hcoef w.1 w.2 hpw hm hlo hhi)
  have hX : 0 ≤ candidateCoefficientWindowMass c L q r jStar := by
    apply sum_nonneg
    intro n hn
    exact candidate_coefficient_nonneg c L hq0 r jStar n
  apply hb.trans
  apply div_le_div_of_nonneg_right _ hL.le
