  full_mixed_indexed_birth_owner_monotone S B steps
    (le_of_lt (show i < j from birthForestEdges_parent_lt code h))

variable (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))
    (θ : (Fin (Fintype.card (FullMixedBirthAddress S B steps)) ×
      Fin (Fintype.card (FullMixedBirthAddress S B steps))) → ℝ)
