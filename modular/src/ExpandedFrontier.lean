open OAI.Ostmann Complex Finset

theorem smoothedTwistedPsi_eq_riesz (χ : PrimitiveComplexCharacter)
    {x : ℝ} (hx : 0 < x) : smoothedTwistedPsi χ.character x = characterRieszMean χ x := by
  classical
  have hs (n : ℕ) (hn : n ∉ Icc 1 ⌊x⌋₊) :
      characterMangoldtCoefficient χ n * rieszPrimeTest (n / x) = 0 := by
    by_cases hn0 : n = 0
    · subst n
      simp [characterMangoldtCoefficient]
    · have hlarge : ⌊x⌋₊ < n := by simp only [mem_Icc] at hn; omega
      have hnlarge : x < n := Nat.lt_of_floor_lt hlarge
      have hdiv : 1 < (n : ℝ) / x := (one_lt_div hx).mpr hnlarge
      simp [rieszPrimeTest, max_eq_right (by linarith : 1 - (n : ℝ) / x ≤ 0)]
  rw [characterRieszMean, tsum_eq_sum hs]
  unfold smoothedTwistedPsi
  apply sum_congr rfl
  intro n hn
  have hnle : (n : ℝ) ≤ x := (Nat.le_floor_iff hx.le).mp (mem_Icc.mp hn).2
  have hdiv : (n : ℝ) / x ≤ 1 := (div_le_one hx).mpr hnle
  simp [mangoldtTwist, characterMangoldtCoefficient, rieszPrimeTest,
    max_eq_left (by linarith : 0 ≤ 1 - (n : ℝ) / x)]

theorem riesz_conductor_log_bound {q x : ℝ} (hq : 1 ≤ q) (hx : 2 ≤ x) :
    1 + Real.log (24 * q * (x ^ 2 + 2)) ≤ 12 * Real.log (q * x) := by
  have hx0 : 0 < x := by linarith
  have hq0 : 0 < q := by linarith
  have hlq : 0 ≤ Real.log q := Real.log_nonneg hq
  have hlx : Real.log 2 ≤ Real.log x := Real.log_le_log (by norm_num) hx
  have hl2 : 1 / 2 ≤ Real.log (2 : ℝ) := by
    have h := Real.one_sub_inv_le_log_of_pos (by norm_num : (0 : ℝ) < 2)
    norm_num at h ⊢
    exact h
  have hl48 : Real.log (48 : ℝ) ≤ 6 * Real.log 2 := by
    have h := Real.log_le_log (by norm_num : (0 : ℝ) < 48)
      (by norm_num : (48 : ℝ) ≤ 2 ^ 6)
    simpa only [Real.log_pow, Nat.cast_ofNat] using h
  have harg : 24 * q * (x ^ 2 + 2) ≤ 48 * q * x ^ 2 := by
    nlinarith [mul_nonneg (show 0 ≤ q by linarith) (show 0 ≤ x ^ 2 - 2 by nlinarith)]
  have hlog := Real.log_le_log (show 0 < 24 * q * (x ^ 2 + 2) by positivity) harg
  rw [Real.log_mul (by positivity : 48 * q ≠ 0) (by positivity : x ^ 2 ≠ 0),
    Real.log_mul (by norm_num : (48 : ℝ) ≠ 0) hq0.ne', Real.log_pow] at hlog
  rw [Real.log_mul hq0.ne' hx0.ne']
  norm_num at hlog
  linarith

theorem primitive_smoothed_estimate_of_zero_free (hZ : PrimitiveZeroFreeHalfPlane) :
    ∃ C : ℝ, 0 < C ∧ ∀ (χ : PrimitiveComplexCharacter) (x : ℝ), 2 ≤ x →
      ‖smoothedTwistedPsi χ.character x‖ ≤
        C * x ^ ((15 : ℝ) / 16) * Real.log ((χ.modulus : ℝ) * x) := by
  obtain ⟨D, hD, hbound⟩ := character_riesz_bound_of_zero_free hZ
  refine ⟨12 * D, by positivity, ?_⟩
  intro χ x hx
  rw [smoothedTwistedPsi_eq_riesz χ (by linarith)]
  have hl := riesz_conductor_log_bound (q := (χ.modulus : ℝ))
    (by exact_mod_cast χ.positive) hx
  calc
    _ ≤ D * x ^ ((15 : ℝ) / 16) * (1 + Real.log (24 * (χ.modulus : ℝ) * (x ^ 2 + 2))) :=
      hbound χ x hx
    _ ≤ D * x ^ ((15 : ℝ) / 16) * (12 * Real.log ((χ.modulus : ℝ) * x)) := by gcongr
    _ = _ := by ring
end

