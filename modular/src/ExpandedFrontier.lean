  let _ : ∀ (k : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D k s) := fullPermutationMixedEventFintype n S B A Δ D
  finiteEventPathAction (FullPermutationMixedEvent n S B A Δ D) (fullPermutationMixedEventTarget n S B A Δ D)
    (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V) steps phase f

theorem full_permutation_mixed_path_norm_le_positive_list
    (hω : ∀ k c a, 0 ≤ ω k c a)
    (hμ : ∀ g p, 0 ≤ μ g p) (hq : ∀ j, 0 ≤ q j) (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ V g)
    (steps : List (Option (J ⊕ K))) (phase : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    ‖fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps phase f s‖ ≤
      (finiteOperatorListAction (fullPermutationMixedPositiveOperator n S B A Δ D ω μ q ρ V)
        steps (complexNormEnvelope f) s).re := by
  let _ : ∀ (k : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D k s) := fullPermutationMixedEventFintype n S B A Δ D
  have h := finite_event_path_norm_le_abs_list_re (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V)
    steps phase hphase f s
  rw [full_permutation_mixed_absolute_actions_eq n S B A Δ D ω μ q ρ V hω hμ hq hρ hV] at h
  exact h

theorem full_permutation_mixed_positive_symmetric (k : Option (J ⊕ K))
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric (fullPermutationMixedPositiveOperator n S B A Δ D ω μ q ρ V k f) := by
  cases k with
  | none => exact fullActiveAverage_symmetric f hf
  | some k => exact full_mixed_memory_positive_symmetric n S B A Δ D ω μ q ρ V k f hf

theorem full_permutation_mixed_path_energy_le
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 < μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (hC : ∀ j g, q j / ρ ^ 2 + ((1 - q j) * V g / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (steps : List (Option (J ⊕ K))) (phase : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps phase f) ≤
    (steps.map (fullPermutationMixedStepEnergy ρ v vmin vmax T (Fintype.card G))).prod *
      finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  have hμ0 : ∀ g p, 0 ≤ μ g p := fun g p => (hμ g p).le
  have hV0 : ∀ g, 0 ≤ V g := fun g => (hvmin.trans_le (hVlo g)).le
  apply finiteWeightedEnergy_le_of_envelope_domination
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productMemoryWeight_nonneg μ (fun g => unrestrictedResidueWeight (μ g)) hμ0
      (fun g z => hμ0 g z.1)) f _
    (finiteOperatorListAction (fullPermutationMixedPositiveOperator n S B A Δ D ω μ q ρ V) steps)
  · intro s
    exact (full_permutation_mixed_path_norm_le_positive_list n S B A Δ D ω μ q ρ V hω hμ0 hq0 hρ0.le hV0
      steps phase hphase f s).trans (Complex.re_le_norm _)
  · apply finite_operator_list_energy_le _ ProductMemorySymmetric
      (fullPermutationMixedPositiveOperator n S B A Δ D ω μ q ρ V)
      (full_permutation_mixed_positive_symmetric n S B A Δ D ω μ q ρ V)
      (fullPermutationMixedStepEnergy ρ v vmin vmax T (Fintype.card G))
    · intro k
      cases k with
      | none => exact zero_le_one
      | some k =>
        cases k with
        | inl j => exact pow_nonneg (Real.exp_pos _).le _
        | inr k => exact pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _
    · intro k F hF
      cases k with
      | none =>
        simpa only [fullPermutationMixedPositiveOperator, fullPermutationMixedStepEnergy, one_mul] using
          fullActiveAverage_energy_le μ (fun g => unrestrictedResidueWeight (μ g)) hμ0
            (fun g z => hμ0 g z.1) F
      | some k =>
        cases k with
        | inl j =>
          simpa only [fullPermutationMixedPositiveOperator, fullMixedMemoryPositiveOperator,
            fullPermutationMixedStepEnergy, mixedMemoryStepEnergy, card_univ] using
            physical_ghost_absolute_cutoff_product_energy_le n μ (q j) ρ V v vmax M B
              hμ hmass (hq0 j) (hq1 j) hρ0 hV0 hVhi (zero_lt_one.trans hv)
              (hD j) (hC j) univ F hF
        | inr k =>
          exact full_active_unrestricted_edge_energy_le n (S k) B (ω k) (Δ k) (D k) μ ρ V
            (hω k) (hωmass k) hρ0 hρ1 hv hvmin hVlo hVhi hμ0 hmass T (ht k)
            (fun _ _ _ _ => 1) (by intros; simp) F hF
    · exact complexNormEnvelope_memory_symmetric f hf

theorem full_permutation_mixed_path_mask_energy_le
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 < μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (hC : ∀ j g, q j / ρ ^ 2 + ((1 - q j) * V g / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (steps : List (Option (J ⊕ K)))
    (allowed : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → Prop)
    (phase : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps
        (fun s p => if allowed s p then phase s p else 0) f) ≤
    (steps.map (fullPermutationMixedStepEnergy ρ v vmin vmax T (Fintype.card G))).prod *
      finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  apply full_permutation_mixed_path_energy_le n S B A Δ D ω μ q ρ V hω hωmass hρ0 hρ1 hv hvmin hVlo hVhi
    hμ hmass hq0 hq1 hD hC T ht steps _ _ f hf
  intro s p
  split_ifs
  · exact hphase s p
  · simp

end
