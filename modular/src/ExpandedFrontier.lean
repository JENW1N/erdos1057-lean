            fun g => C key.2.1.val (e.symm g).val)
          (fun key => physicalSharedPrefix key.2.2.1)
          (fun key => k (n - key.1.val) key.2.1.val) B
          (physicalMixedBigSteps
            ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1))) pl.1 pl.2) x).symm
          (physicalRootSelectedEffectivePathEquiv groups e patterns C hC k pl x path)) : ℂ) *
      finiteEventLocalPhase
        (FullPermutationMixedEvent (fun g (p : P (e.symm g).val) => p.val)
          (fun j g => physicalFullSharedIndices (Cn j g)) B
          (fun j _ => PhysicalAuxLabels (fun g => P (e.symm g).val) (Cn j))
          (fun j => physicalFullEdgeDelta (Cn j) (kn j)) (fun j => physicalFullEdgeD (Cn j)))
        (fullPermutationMixedEventTarget (fun g (p : P (e.symm g).val) => p.val)
          (fun j g => physicalFullSharedIndices (Cn j g)) B
          (fun j _ => PhysicalAuxLabels (fun g => P (e.symm g).val) (Cn j))
          (fun j => physicalFullEdgeDelta (Cn j) (kn j)) (fun j => physicalFullEdgeD (Cn j)))
        (physicalFullCoefficientPhase Cn kn cut (fun _ => 0)
          (fun j => physicalGroupReindexedCoefficient e
            (fun g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val g.val)
            (physicalRootPlanBigCoefficient groups patterns C hC ζ k K θ pl j)))
        ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1))) x path := by
  let Cn := fun j g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val
  let kn := physicalRootPlanMultiplier groups patterns C hC k pl
  have hc := physical_original_weighted_selected_local_phase Cn kn
    ω β retention ρ (fun g => V (e.symm g).val) cut hencode (fun _ => 0)
    (fun j => physicalGroupReindexedCoefficient e
      (fun g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val g.val)
