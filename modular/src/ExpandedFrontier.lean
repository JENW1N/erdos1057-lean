theorem finite_symmetric_probe_tensor_energy {G : Type*} [Fintype G] [DecidableEq G]
    {I X : G → Type*} [∀ g, Fintype (I g)] [∀ g, DecidableEq (I g)] [∀ g, Fintype (X g)]
    (μ : ∀ g, X g → ℝ) (hμ : ∀ g x, 0 ≤ μ g x) (hmass : ∀ g, ∑ x, μ g x = 1)
    (A B : ∀ g, Finset (I g)) (hAB : ∀ g, Disjoint (A g) (B g)) (hm : ∀ g, 0 < (A g).card)
    (s : Finset G) (f : (∀ g, I g → X g) → ℂ) (hf : ∀ g, finiteGroupSlotSymmetric g f) :
    finiteWeightedEnergy (finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g)))
      (finiteCoordinateFinsetAction (fun (g : G) (v : (I g → X g) → ℂ) => finiteCoordinateComponent (fun _ : I g => μ g)
        (A g) (A g ∪ B g).toList v) s f) ≤
      (∏ g ∈ s, (((B g).card : ℝ) ^ (B g).card / ((A g).card : ℝ) ^ (B g).card)) *
        finiteWeightedEnergy (finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g))) f := by
  have h := finite_projected_probe_tensor_energy μ hμ hmass A B hAB hm s f
  unfold finiteCoordinateFinsetAction at h ⊢
  rw [finite_group_symmetrized_compose_eq (I := I) (X := X)
    (fun (g : G) (v : (I g → X g) → ℂ) => finiteCoordinateComponent (fun _ : I g => μ g) (A g) (A g ∪ B g).toList v)
    s.toList (Finset.nodup_toList s) f hf] at h
  exact h

theorem finite_symmetric_probe_tensor_uniform {G : Type*} [Fintype G] [DecidableEq G]
    {I X : G → Type*} [∀ g, Fintype (I g)] [∀ g, DecidableEq (I g)] [∀ g, Fintype (X g)]
    (μ : ∀ g, X g → ℝ) (hμ : ∀ g x, 0 ≤ μ g x) (hmass : ∀ g, ∑ x, μ g x = 1)
    (A B : ∀ g, Finset (I g)) (hAB : ∀ g, Disjoint (A g) (B g))
    (m ell : ℕ) (hm : 0 < m) (hA : ∀ g, (A g).card = m) (hB : ∀ g, (B g).card = ell)
    (s : Finset G) (f : (∀ g, I g → X g) → ℂ) (hf : ∀ g, finiteGroupSlotSymmetric g f) :
    finiteWeightedEnergy (finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g)))
      (finiteCoordinateFinsetAction (fun (g : G) (v : (I g → X g) → ℂ) => finiteCoordinateComponent (fun _ : I g => μ g)
        (A g) (A g ∪ B g).toList v) s f) ≤
      (((ell : ℝ) ^ ell / (m : ℝ) ^ ell) ^ s.card) *
        finiteWeightedEnergy (finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g))) f := by
  simpa only [hA, hB, Finset.prod_const] using finite_symmetric_probe_tensor_energy
    μ hμ hmass A B hAB (fun g => (hA g).symm ▸ hm) s f hf
end

