    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (retention : Fin (n + 1) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)


theorem physical_original_weighted_selected_local_phase
    [Fintype (PhysicalSelectedData P ell C)]
    (cut : ℕ → Fin N → Finset (Fin J))
    (hencode : ∀ i, PhysicalMarkRowEncoding C (physicalSelectedFineTag n i) (cut i) (cut (i + 1)))
    (ζ : Fin n → ℝ)
    (K : ∀ j, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C j) → ℂ)
    (w : PhysicalSelectedData P ell C → ℂ)
    (x : PhysicalFullBoundedState P J ell B) (hx : FullActiveInjective x)
    (p : FullPermutationMixedPath (fun g (p : ↥(P g)) => p.val)
      (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j)) ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)) x) :
    physicalOriginalFineWeight C k ω β retention ρ V x p *
        physicalSelectedDataRecordPhase C cut Finset.univ (fun d => w d * physicalSelectedCoefficient C ζ K d)
          (physicalOriginalFineRecord C k cut x p) =
      physicalOriginalFineWeight C k ω β retention ρ V x p *
        physicalSelectedDataRecordPhase C cut Finset.univ w (physicalOriginalFineRecord C k cut x p) *
        finiteEventLocalPhase (FullPermutationMixedEvent (fun g (p : ↥(P g)) => p.val)
          (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
          (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j)))
          (fullPermutationMixedEventTarget (fun g (p : ↥(P g)) => p.val)
            (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
            (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j)))
          (physicalFullCoefficientPhase C k cut ζ K)
          ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)) x p := by
  rw [physical_selected_record_phase_mul]
  have h := physical_original_selected_local_phase C k ω β retention ρ V cut hencode ζ K x hx p
  linear_combination
    (physicalSelectedDataRecordPhase C cut Finset.univ w (physicalOriginalFineRecord C k cut x p)) * h

end Fine
