/- The normalized balanced rough-pair bound with all microscopic choices discharged. -/

open Finset Filter
open scoped Topology

namespace Bounty

theorem exists_candidate_balanced_normalized_pair_bound {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ)*(r : ℝ)*c = 1) :
    ∃ C : ℝ, 0 < C ∧ ∃ J0 : ℕ,
      ∀ᶠ L : ℝ in atTop, ∀ κ : ℝ, 0 ≤ κ → κ ≤ 1/50 →
      ∀ jStar : ℕ, J0 < jStar → ∀ (S : Finset (ℕ × ℕ)) (u : ℕ × ℕ → ℕ),
        (∀ v ∈ S, balancedPairWindow κ L v) →
        (∀ v ∈ S, v.1*v.2 = 2*u v+1) →
        (∀ v ∈ S, ∀ p ∈ primeBand 0 (Real.exp (Real.sqrt L)), ¬p ∣ v.1*v.2) →
        (∑ v ∈ S, candidateCoefficient c L q r jStar (u v)) /
          (L^2*(∏ p ∈ primeBand 0 (Real.exp (Real.sqrt L)), (1-1/(p : ℝ)))^2) ≤
          C*(κ+1/L)*candidateCoefficientWindowMass c L q r jStar/L := by
  obtain ⟨J, θ, hθ, _, hcut, hθsmall, hsize⟩ := exists_candidate_micro_cutoff hc r
  obtain ⟨C, hC, J0, _, hbound⟩ := exists_candidate_balanced_rough_pair_bound hc hr hq0 hq1 hcenter
    hθ J hcut hsize hθsmall
  refine ⟨C, hC, J0, ?_⟩
  filter_upwards [hbound, eventually_sqrt_le_dyadic_scale hθ 0,
    eventually_gt_atTop (0 : ℝ)] with L hb hsqrt hL
  intro κ hκ hκup jStar hj S u hS hv hrough
  have hW : Real.exp (Real.sqrt L) ≤ Real.exp (θ*L) := by
    apply Real.exp_le_exp.mpr
    simpa only [pow_zero, div_one] using hsqrt
  have hraw := hb κ hκ hκup jStar hj (Real.exp (Real.sqrt L)) S u
    (Real.one_le_exp (Real.sqrt_nonneg _)) hW hS hv hrough
  have hV : 0 < ∏ p ∈ primeBand 0 (Real.exp (Real.sqrt L)), (1-1/(p : ℝ)) :=
    finite_prime_avoidance_product_pos _ (fun p hp => (mem_filter.mp hp).2)
  have hden : 0 < L^2*(∏ p ∈ primeBand 0 (Real.exp (Real.sqrt L)), (1-1/(p : ℝ)))^2 := by
    positivity
  refine (div_le_div_of_nonneg_right hraw hden.le).trans_eq ?_
  field_simp

end Bounty
