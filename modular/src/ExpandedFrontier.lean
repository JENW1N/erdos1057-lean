section

/- Exact real rational coordinates of the recovered determinant variables. -/

namespace Bounty

noncomputable def typeIIRealE (y : TypeIIShiftIndex) : ℝ :=
  ((y.2.2.1 : ℝ) - y.2.1.1) / (2 * (y.1.1 : ℝ))

noncomputable def typeIIRealN (y : TypeIIShiftIndex) : ℝ :=
  ((y.2.2.1 : ℝ) - y.2.1.1) * y.1.2 /
    ((y.1.1 : ℝ) * y.2.1.1 * y.2.2.1) + 1 / (y.2.1.1 : ℝ)

theorem typeII_real_coordinate_algebra {m m' e n h z k : ℝ}
    (hm : m ≠ 0) (hm' : m' ≠ 0) (hk : k ≠ 0)
    (hdet : m' - m = 2 * e * k) (heq : m * n = 2 * e * h + 1)
    (hz : z = m' * h) :
    e = (m' - m) / (2 * k) ∧ n = (m' - m) * z / (k * m * m') + 1 / m := by
  constructor
  · apply (eq_div_iff (mul_ne_zero (by norm_num) hk)).mpr
    linear_combination -hdet
  · rw [hdet, hz]
    field_simp
    linear_combination heq

theorem typeII_original_real_coordinates {E N M H : Finset ℕ} {x : TypeIIOffIndex}
    (hx : x ∈ typeIIOffDiagonalSupport E N M H) :
    (x.1.1 : ℝ) = typeIIRealE (typeIIShiftMap x) ∧
      (x.1.2 : ℝ) = typeIIRealN (typeIIShiftMap x) := by
  obtain ⟨he, hn, hm, hh, hm', hh', hne, hfirst, hsecond⟩ :=
    mem_typeII_off_diagonal_support.mp hx
  have hp := typeII_off_support_positive hx
  obtain ⟨k, hk, _⟩ := typeII_determinant_unique_nat hfirst hsecond hne
  have hk0 : (k : ℝ) ≠ 0 := by exact_mod_cast hk.1
  have hmr : (x.2.1.1 : ℝ) ≠ 0 := by exact_mod_cast hp.2.2.1.ne'
  have hm'r : (x.2.2.1 : ℝ) ≠ 0 := by exact_mod_cast hp.2.2.2.ne'
  have hdet : (x.2.2.1 : ℝ) - x.2.1.1 = 2 * (x.1.1 : ℝ) * k := by
    exact_mod_cast hk.2.1
  have heqr : (x.2.1.1 : ℝ) * x.1.2 = 2 * (x.1.1 : ℝ) * x.2.1.2 + 1 := by
    exact_mod_cast hfirst
  have hz : ((x.2.2.1 * x.2.1.2 : ℕ) : ℝ) = (x.2.2.1 : ℝ) * x.2.1.2 := by
    push_cast
    rfl
  have hr := typeII_real_coordinate_algebra hmr hm'r hk0 hdet heqr hz
  simpa only [typeIIRealE, typeIIRealN, typeIIShiftMap, hk.2.2.2] using hr

theorem typeII_shift_conditions_real_coordinates {E N M H : Finset ℕ}
    {y : TypeIIShiftIndex} {W : ℝ}
    (hv : y.2.1 ∈ M ×ˢ H) (hw : y.2.2 ∈ M ×ˢ H)
    (hconditions : TypeIIShiftConditions E N y)
    (hrough : ∀ p ∈ y.2.1.1.primeFactors, W < (p : ℝ))
    (hsmall : |(y.1.1 : ℝ)| ≤ W) :
    ((typeIIRecoveredE y).toNat : ℝ) = typeIIRealE y ∧
      ((typeIIRecoveredN y).toNat : ℝ) = typeIIRealN y := by
  obtain ⟨horiginal, hmap⟩ :=
    typeII_shift_conditions_reconstruction hv hw hconditions hrough hsmall
  have hr := typeII_original_real_coordinates horiginal
  rw [hmap] at hr
  exact hr

theorem typeII_determinant_real_coordinates {E N M H : Finset ℕ}
    {K : Finset ℤ} {Z : Finset ℕ} {y : TypeIIShiftIndex} {W : ℝ}
    (hy : y ∈ typeIIDeterminantDomain E N M H K Z)
    (hrough : ∀ m ∈ M, ∀ p ∈ m.primeFactors, W < (p : ℝ))
    (hsmall : ∀ k ∈ K, |(k : ℝ)| ≤ W) :
    ((typeIIRecoveredE y).toNat : ℝ) = typeIIRealE y ∧
      ((typeIIRecoveredN y).toNat : ℝ) = typeIIRealN y := by
  classical
  obtain ⟨hrange, hc⟩ := Finset.mem_filter.mp hy
  obtain ⟨hkz, hvw⟩ := Finset.mem_product.mp hrange
  obtain ⟨hv, hw⟩ := Finset.mem_product.mp hvw
  exact typeII_shift_conditions_real_coordinates hv hw hc
    (hrough _ (Finset.mem_product.mp hv).1) (hsmall _ (Finset.mem_product.mp hkz).1)

theorem typeII_determinant_real_cutoffs {E N M H : Finset ℕ}
    {K : Finset ℤ} {Z : Finset ℕ} {y : TypeIIShiftIndex} {W : ℝ}
    (hy : y ∈ typeIIDeterminantDomain E N M H K Z)
    (hrough : ∀ m ∈ M, ∀ p ∈ m.primeFactors, W < (p : ℝ))
    (hsmall : ∀ k ∈ K, |(k : ℝ)| ≤ W) (η : ℝ → ℝ → ℝ) :
    η (typeIIRecoveredE y).toNat (typeIIRecoveredN y).toNat =
      η (typeIIRealE y) (typeIIRealN y) := by
  obtain ⟨he, hn⟩ := typeII_determinant_real_coordinates hy hrough hsmall
  rw [he, hn]

theorem typeII_normalized_e_log_coordinates (U E k t₁ t₂ : ℝ) :
    ((U * Real.exp t₂ - U * Real.exp t₁) / (2 * k)) / E =
      (U / (2 * k * E)) * (Real.exp t₂ - Real.exp t₁) := by
  ring

theorem typeII_normalized_n_log_coordinates (U V Z k t₁ t₂ t₃ : ℝ)
    (hU : U ≠ 0) (hV : V ≠ 0) (hk : k ≠ 0) :
    (((U * Real.exp t₂ - U * Real.exp t₁) * (Z * Real.exp t₃) /
      (k * (U * Real.exp t₁) * (U * Real.exp t₂)) + 1 / (U * Real.exp t₁)) / V) =
      (Z / (k * U * V)) * (Real.exp (t₃ - t₁) - Real.exp (t₃ - t₂)) +
        (1 / (U * V)) * Real.exp (-t₁) := by
  rw [Real.exp_sub, Real.exp_sub, Real.exp_neg]
  field_simp

end Bounty

end

section

/- The actual active-slot Fourier phase separates into unit prime-slot twists. -/

open Finset MeasureTheory

namespace Bounty

noncomputable def activeAllocationFrequencyInput {N : ℕ}
    (active : Fin N → Bool) (s : Fin N → ℝ)
    (ξ : ActiveAllocationIndex active → ℝ) (i : Fin N) : ℝ :=
  if hi : active i = true then 2 * Real.pi * ξ ⟨i, hi⟩ / s i else 0

theorem active_allocation_frequency_sum {N : ℕ} (R : ℝ)
    (v s : Fin N → ℝ) (active take : Fin N → Bool)
    (ξ : ActiveAllocationIndex active → ℝ) :
    (∑ i, activeAllocationFrequencyInput active s ξ i *
      (orderedSlotResidual R (fun j => if take j then 1 else 0) v i - v i)) =
      2 * Real.pi * ∑ i : ActiveAllocationIndex active,
        ξ i * ((allocationPrefixResidual v R take i.val - v i.val) / s i.val) := by
  classical
  simp_rw [← allocation_prefix_eq_ordered_residual]
  calc
    _ = ∑ i ∈ univ.filter (fun i => active i = true),
        activeAllocationFrequencyInput active s ξ i *
          (allocationPrefixResidual v R take i - v i) := by
      rw [sum_filter]
      apply sum_congr rfl
      intro i hi
      by_cases ha : active i = true
      · simp [ha]
      · simp [activeAllocationFrequencyInput, ha]
    _ = ∑ i : ActiveAllocationIndex active,
        activeAllocationFrequencyInput active s ξ i.val *
          (allocationPrefixResidual v R take i.val - v i.val) := sum_subtype _ (by simp) _
    _ = _ := by
      rw [mul_sum]
      apply sum_congr rfl
      intro i hi
      simp only [activeAllocationFrequencyInput, i.property, dite_true]
      ring

theorem active_allocation_integrand_phase {N : ℕ} (A R : ℝ)
    (v s : Fin N → ℝ) (active take : Fin N → Bool)
    (ξ : ActiveAllocationIndex active → ℝ) :
    activeAllocationFourierIntegrand A R v s active take ξ =
      Complex.exp (Complex.I * ((2 * Real.pi * ∑ i : ActiveAllocationIndex active,
        ξ i * ((allocationPrefixResidual v R take i.val - v i.val) / s i.val) : ℝ) : ℂ)) *
          activeAllocationFourierWeight A active take ξ := by
  simp only [activeAllocationFourierIntegrand, activeAllocationFourierWeight,
    typeIICutoffFourierIntegrand, prod_mul_distrib]
  rw [← Complex.exp_sum]
  congr 2
  simp only [mul_sum, Complex.ofReal_sum]
  apply sum_congr rfl
  intro i hi
  push_cast
  ring

theorem active_allocation_integrand_separated {N : ℕ} (A R : ℝ)
    (v s : Fin N → ℝ) (active take : Fin N → Bool)
    (ξ : ActiveAllocationIndex active → ℝ) :
    activeAllocationFourierIntegrand A R v s active take ξ =
      (Complex.exp (Complex.I * ((R * ∑ i, activeAllocationFrequencyInput active s ξ i : ℝ) : ℂ)) *
        ∏ j, Complex.exp (Complex.I * ((v j * orderedSlotFrequency
          (fun i => if take i then 1 else 0) (activeAllocationFrequencyInput active s ξ) j : ℝ) : ℂ))) *
            activeAllocationFourierWeight A active take ξ := by
  rw [active_allocation_integrand_phase, ← active_allocation_frequency_sum,
    ordered_slot_exponential_separation]

theorem active_allocation_prime_powers_separated {N : ℕ} (A R : ℝ)
    (p s : Fin N → ℝ) (hp : ∀ i, 0 < p i) (active take : Fin N → Bool)
    (ξ : ActiveAllocationIndex active → ℝ) :
    activeAllocationFourierIntegrand A R (fun i => Real.log (p i)) s active take ξ =
      (Complex.exp (Complex.I * ((R * ∑ i, activeAllocationFrequencyInput active s ξ i : ℝ) : ℂ)) *
        ∏ j, (p j : ℂ) ^ ((orderedSlotFrequency (fun i => if take i then 1 else 0)
          (activeAllocationFrequencyInput active s ξ) j : ℂ) * Complex.I)) *
            activeAllocationFourierWeight A active take ξ := by
  rw [active_allocation_integrand_phase, ← active_allocation_frequency_sum,
    ordered_slot_prime_power_separation R _ p _ hp]

theorem compact_allocation_prime_power_integral {N : ℕ} (A R : ℝ)
    (p s : Fin N → ℝ) (hp : ∀ i, 0 < p i) (active take : Fin N → Bool)
    (hkeep : ∀ i, active i = false → take i = false) :
    (compactAllocationWeight A N (fun i => Real.log (p i)) s active R take : ℂ) =
      ∫ ξ : ActiveAllocationIndex active → ℝ,
        (Complex.exp (Complex.I * ((R * ∑ i, activeAllocationFrequencyInput active s ξ i : ℝ) : ℂ)) *
          ∏ j, (p j : ℂ) ^ ((orderedSlotFrequency (fun i => if take i then 1 else 0)
            (activeAllocationFrequencyInput active s ξ) j : ℂ) * Complex.I)) *
              activeAllocationFourierWeight A active take ξ := by
  rw [compact_allocation_fourier_inversion A R _ s active take hkeep]
  apply integral_congr_ae
  exact Filter.Eventually.of_forall (active_allocation_prime_powers_separated A R p s hp active take)

theorem active_allocation_inactive_frequency_zero {N : ℕ}
    (active take : Fin N → Bool) (s : Fin N → ℝ)
    (ξ : ActiveAllocationIndex active → ℝ) (i : Fin N)
    (ha : active i = false) (ht : take i = false) :
    orderedSlotFrequency (fun j => if take j then 1 else 0)
      (activeAllocationFrequencyInput active s ξ) i = 0 := by
  simp [orderedSlotFrequency, activeAllocationFrequencyInput, ha, ht]

theorem active_allocation_frequency_bound {N : ℕ}
    (active take : Fin N → Bool) (s : Fin N → ℝ) (hs : ∀ i, 0 < s i)
    (ξ : ActiveAllocationIndex active → ℝ) {R : ℝ} (hR : 0 ≤ R)
    (hξ : ∀ i, |ξ i| ≤ R) (j : Fin N) :
    |orderedSlotFrequency (fun i => if take i then 1 else 0)
      (activeAllocationFrequencyInput active s ξ) j| ≤
        (2 * Real.pi * R) * ∑ i, 1 / s i := by
  apply (ordered_slot_frequency_abs_le _ _ (fun i => by cases take i <;> norm_num) j).trans
  rw [mul_sum]
  apply sum_le_sum
  intro i hi
  unfold activeAllocationFrequencyInput
  split_ifs with ha
  · rw [abs_div, abs_mul, abs_of_pos (hs i),
      abs_of_pos (mul_pos (by norm_num) Real.pi_pos)]
    have hb := mul_le_mul_of_nonneg_left (hξ ⟨i, ha⟩)
      (show (0 : ℝ) ≤ 2 * Real.pi by positivity)
    simpa only [mul_one_div] using div_le_div_of_nonneg_right hb (hs i).le
  · simp only [abs_zero]
    exact mul_nonneg (mul_nonneg (by positivity) hR) (div_nonneg zero_le_one (hs i).le)

end Bounty

end

section

/- Uniform cube truncation for the actual active-slot allocation integral. -/

open Finset MeasureTheory

namespace Bounty

noncomputable def activeAllocationBoxMeasure {N : ℕ} (active : Fin N → Bool)
    (R : ℝ) : Measure (ActiveAllocationIndex active → ℝ) :=
  Measure.pi (fun _ : ActiveAllocationIndex active => volume.restrict {ξ : ℝ | ‖ξ‖ ≤ R})

theorem active_allocation_box_integrable {N : ℕ} (A E R : ℝ)
    (v s : Fin N → ℝ) (active take : Fin N → Bool) :
    Integrable (activeAllocationFourierIntegrand A E v s active take)
      (activeAllocationBoxMeasure active R) :=
  Integrable.fintype_prod (fun i =>
    (typeII_cutoff_fourier_integrand_integrable A _ (take i.val)).integrableOn)

theorem active_allocation_box_factorization {N : ℕ} (A E R : ℝ)
    (v s : Fin N → ℝ) (active take : Fin N → Bool) :
    (∫ ξ : ActiveAllocationIndex active → ℝ,
      activeAllocationFourierIntegrand A E v s active take ξ
        ∂activeAllocationBoxMeasure active R) =
      ∏ i : ActiveAllocationIndex active, ∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ R},
        typeIICutoffFourierIntegrand A (take i.val)
          ((allocationPrefixResidual v E take i.val - v i.val) / s i.val) ξ :=
  integral_fintype_prod_eq_prod _

theorem active_allocation_truncation_le {N : ℕ} (A C D E : ℝ) (M : ℕ)
    (hC1 : 1 ≤ C)
    (hC : ∀ take : Bool, (∫ ξ : ℝ, ‖typeIICutoffFourier A take ξ‖) ≤ C)
    (hD : 0 ≤ D)
    (hdecay : ∀ take : Bool, ∀ R : ℝ, 1 ≤ R → ∀ t : ℝ,
      ‖(typeIISmoothCutoff A take t : ℂ) -
        ∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ R}, typeIICutoffFourierIntegrand A take t ξ‖ ≤
          D * R ^ (-(M : ℝ)))
    (v s : Fin N → ℝ) (active take : Fin N → Bool)
    (hkeep : ∀ i, active i = false → take i = false) {R : ℝ} (hR : 1 ≤ R) :
    ‖(compactAllocationWeight A N v s active E take : ℂ) -
      ∫ ξ : ActiveAllocationIndex active → ℝ,
        activeAllocationFourierIntegrand A E v s active take ξ
          ∂activeAllocationBoxMeasure active R‖ ≤
      N * D * C ^ (N - 1) * R ^ (-(M : ℝ)) := by
  rw [compact_allocation_active_product A E v s active take hkeep,
    Complex.ofReal_prod, active_allocation_box_factorization]
  have hC0 : 0 ≤ C := by linarith
  have hR0 : 0 ≤ R := by linarith
  have hbound := complex_finset_product_error
    (univ : Finset (ActiveAllocationIndex active))
    (fun i => (typeIISmoothCutoff A (take i.val)
      ((allocationPrefixResidual v E take i.val - v i.val) / s i.val) : ℂ))
    (fun i => ∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ R}, typeIICutoffFourierIntegrand A (take i.val)
      ((allocationPrefixResidual v E take i.val - v i.val) / s i.val) ξ)
    hC0 (mul_nonneg hD (Real.rpow_nonneg hR0 _))
    (fun i _ => by
      have hb := typeII_smooth_cutoff_bounds A
        ((allocationPrefixResidual v E take i.val - v i.val) / s i.val) (take i.val)
      simpa only [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hb.1] using hb.2.trans hC1)
    (fun i _ => typeII_cutoff_fourier_truncated_norm_le A C R _ (take i.val) (hC _))
    (fun i _ => hdecay (take i.val) R hR _)
  have hcard : Fintype.card (ActiveAllocationIndex active) ≤ N := by
    simpa only [Fintype.card_fin] using Fintype.card_subtype_le (fun i => active i = true)
  simp only [card_univ] at hbound
  apply hbound.trans
  calc
    _ ≤ (N : ℝ) * (D * R ^ (-(M : ℝ))) * C ^ (N - 1) := by
      apply mul_le_mul
      · exact mul_le_mul_of_nonneg_right (Nat.cast_le.mpr hcard)
          (mul_nonneg hD (Real.rpow_nonneg hR0 _))
      · exact pow_le_pow_right₀ hC1 (Nat.sub_le_sub_right hcard 1)
      · positivity
      · positivity
    _ = _ := by ring

theorem active_allocation_fourier_bounds (A : ℝ) :
    ∃ C : ℝ, 1 ≤ C ∧
      (∀ (N : ℕ) (active take : Fin N → Bool),
        (∫ ξ : ActiveAllocationIndex active → ℝ,
          ‖activeAllocationFourierWeight A active take ξ‖) ≤ C ^ N) ∧
      ∀ M : ℕ, ∃ D : ℝ, 0 < D ∧
        ∀ (N : ℕ) (E : ℝ) (v s : Fin N → ℝ) (active take : Fin N → Bool),
          (∀ i, active i = false → take i = false) → ∀ R : ℝ, 1 ≤ R →
            ‖(compactAllocationWeight A N v s active E take : ℂ) -
              ∫ ξ : ActiveAllocationIndex active → ℝ,
                activeAllocationFourierIntegrand A E v s active take ξ
                  ∂activeAllocationBoxMeasure active R‖ ≤
              N * D * C ^ (N - 1) * R ^ (-(M : ℝ)) := by
  obtain ⟨C, hC1, hC⟩ := typeII_cutoff_fourier_l1_bound A
  refine ⟨C, hC1, fun N active take => active_allocation_fourier_l1_le A C hC1 hC active take, ?_⟩
  intro M
  obtain ⟨D, hD, hdecay⟩ := typeII_cutoff_fourier_rapid_truncation A M
  exact ⟨D, hD, fun N E v s active take hkeep R hR =>
    active_allocation_truncation_le A C D E M hC1 hC hD.le hdecay v s active take hkeep hR⟩

end Bounty

