section

/- The small factor recovered from the record is exactly the deterministic
residue phase along the original four-step event schedule. -/

open Finset
open scoped Classical
namespace Bounty
section Ledger
variable {S : Type} [Fintype S] {Ps : S → Finset ℕ}
  {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (cut : ℕ → Fin N → Finset (Fin J))
  (Cs : Fin n → S → Finset (Fin J)) (Vs : S → ℝ) (q : ℝ)
  (ds : PhysicalGroupSelectedData Ps ell Cs)

theorem physical_record_small_ledger
    (r : PhysicalResidues Ps)
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (p : FiniteEventPath (fun i => PhysicalFullLedgerEvent C k (physicalSelectedFineTag n i))
      (fun i => physicalFullLedgerEventTarget C k (physicalSelectedFineTag n i))
      (List.range (4 * n + 1)) s) :
    let E := fun i => PhysicalFullLedgerEvent (P := P) (ell := ell) (B := B) C k (physicalSelectedFineTag n i)
    let target := fun i => physicalFullLedgerEventTarget (P := P) (ell := ell) (B := B) C k (physicalSelectedFineTag n i)
    let record := finiteEventPathObservations E target
      (physicalFullTraceObservation C k (physicalSelectedFineTag n) cut) (List.range (4 * n + 1)) s p
    deterministicLedgerPhase E target
        (fun i => physicalSelectedSmallLocalUpdate C k cut (physicalSelectedFineTag n i))
        (fun i => physicalSelectedSmallLocalPhase C k cut Cs Vs q ds (physicalSelectedFineTag n i))
        (List.range (4 * n + 1)) r s p =
      physicalSelectedSmallWeight Cs Vs q r (Fin.partialSum (physicalRecordDisplacement C k cut record)) ds := by
  dsimp only
  let E := fun i => PhysicalFullLedgerEvent (P := P) (ell := ell) (B := B) C k (physicalSelectedFineTag n i)
  let target := fun i => physicalFullLedgerEventTarget (P := P) (ell := ell) (B := B) C k (physicalSelectedFineTag n i)
  let occ := finiteScheduleOccurrence E target (4 * n + 1) s p
  let record := finiteEventPathObservations E target
    (physicalFullTraceObservation C k (physicalSelectedFineTag n) cut) (List.range (4 * n + 1)) s p
  let d := physicalRecordDisplacement C k cut record
  let a := Fin.partialSum d
  let l : Fin (4 * n + 2) → PhysicalResidues Ps :=
    fun i => physicalTranslateResidues r (a (fourStepVertex n i))
  have hs (i : Fin (4 * n + 1)) :
      physicalSelectedSmallLocalUpdate C k cut (physicalSelectedFineTag n i.val)
        (l i.castSucc) (occ i).1 (occ i).2 = l i.succ := by
    dsimp only [physicalSelectedSmallLocalUpdate, l]
    rw [physical_translate_residues_add]
    by_cases hi : i.val % 4 = 2
    · let j : Fin n := ⟨i.val / 4, by have := i.isLt; omega⟩
      have he : i = (⟨4 * j.val + 2, by have := j.isLt; omega⟩ : Fin (4 * n + 1)) := by
        apply Fin.ext
        dsimp only [j]
        omega
      rw [he]
      have hd := physical_record_displacement_local C k cut s p j
      change d j = physicalLocalDisplacement C k cut
        (physicalSelectedFineTag n (4 * j.val + 2))
        (occ ⟨4 * j.val + 2, by have := j.isLt; omega⟩).1
        (occ ⟨4 * j.val + 2, by have := j.isLt; omega⟩).2 at hd
      rw [← hd]
      change physicalTranslateResidues r
        (a (fourStepVertex n ⟨4 * j.val + 2, _⟩) + d j) =
          physicalTranslateResidues r (a (fourStepVertex n ⟨4 * j.val + 3, _⟩))
      rw [four_step_vertex_edge_before, four_step_vertex_edge_after]
      exact congrArg (physicalTranslateResidues r) (Fin.partialSum_succ d j).symm
    · rw [physical_local_displacement_nonedge C k cut i.val hi, add_zero,
        four_step_vertex_nonedge n i hi]
  have hzero : l 0 = r := by
    dsimp only [l]
    rw [four_step_vertex_zero]
    exact (congrArg (physicalTranslateResidues r) (Fin.partialSum_zero d)).trans
      (physical_translate_residues_zero r)
  have hp := deterministic_ledger_schedule_product E target
    (fun i => physicalSelectedSmallLocalUpdate C k cut (physicalSelectedFineTag n i))
    (fun i => physicalSelectedSmallLocalPhase C k cut Cs Vs q ds (physicalSelectedFineTag n i))
    (4 * n + 1) s p l hs
  rw [hzero] at hp
  rw [hp]
  let f : Fin (4 * n + 1) → ℂ := fun i =>
    physicalSelectedSmallLocalPhase C k cut Cs Vs q ds (physicalSelectedFineTag n i.val)
      (l i.castSucc) (occ i).1 (occ i).2
  have hv (j : Fin (n + 1)) :
      f ⟨4 * j.val, Nat.lt_succ_of_le (Nat.mul_le_mul_left 4 (Nat.le_of_lt_succ j.isLt))⟩ = 1 := by
    dsimp only [f]
    exact physical_selected_small_local_phase_visit C k cut Cs Vs q ds j _ (physical_fine_tag_visit j) _ _ _
  have hl (j : Fin n) : f ⟨4 * j.val + 1, by have := j.isLt; omega⟩ =
      (Nat.card (PhysicalPermutations S J ell) : ℂ)⁻¹ := by
    dsimp only [f]
    exact physical_selected_small_local_phase_permutation C k cut Cs Vs q ds _
      (physical_fine_tag_source_permutation j) _ _ _
  have hr (j : Fin n) : f ⟨4 * j.val + 3, by have := j.isLt; omega⟩ =
      (Nat.card (PhysicalPermutations S J ell) : ℂ)⁻¹ := by
    dsimp only [f]
    exact physical_selected_small_local_phase_permutation C k cut Cs Vs q ds _
      (physical_fine_tag_target_permutation j) _ _ _
  change (∏ i, f i) = _
  rw [four_step_normalized_product n _ f hv hl hr]
  unfold physicalSelectedSmallWeight
  apply prod_congr rfl
  intro j _
  dsimp only [f]
  rw [physical_selected_small_local_phase_edge C k cut Cs Vs q ds j _ (physical_fine_tag_edge j)]
  rw [hs ⟨4 * j.val + 2, by have := j.isLt; omega⟩]
  have hb : l (⟨4 * j.val + 2, by have := j.isLt; omega⟩ : Fin (4 * n + 1)).castSucc =
      physicalTranslateResidues r (a j.castSucc) := by
    dsimp only [l]
    change physicalTranslateResidues r (a (fourStepVertex n ⟨4 * j.val + 2, _⟩)) = _
    rw [four_step_vertex_edge_before]
  have ha : l (⟨4 * j.val + 2, by have := j.isLt; omega⟩ : Fin (4 * n + 1)).succ =
      physicalTranslateResidues r (a j.succ) := by
    dsimp only [l]
    change physicalTranslateResidues r (a (fourStepVertex n ⟨4 * j.val + 3, _⟩)) = _
    rw [four_step_vertex_edge_after]
  rw [hb, ha]
  ring

end Ledger
end Bounty
end

section

/- The complete original root integrand, including its path-dependent small
vertex weight and its original Fourier coefficient, enters the record action. -/

open Finset Classical
namespace Bounty
section Numbered
variable {I : Type} {N M J ell n : ℕ} {P : Fin N → Finset ℕ}
  [∀ z : PhysicalPrime P, NeZero z.2.val]
  (groups : Finset (Fin N)) (e : {g // g ∉ groupsᶜ} ≃ Fin M)
  (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
  (hC : ∀ i : patterns, ∀ g : ↥groupsᶜ, C i.val g.val = ∅)
  (V : Fin N → ℝ) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
  (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
    PhysicalAuxLabels P (C i) → ℂ)
  (r : PhysicalGroupResidues P groupsᶜ) (θ : ℝ)
  (p : PhysicalRootSmallPlan (P := P) (J := J) (ell := ell) (n := n) groups patterns)

noncomputable def physicalRootNumberedCompleteWeight
    (d : PhysicalSelectedData (fun g => P (e.symm g).val) ell
      (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val)) : ℂ :=
  physicalRootPlanSmallWeight groups patterns C hC V q k r p
    ((physicalSelectedGroupReindex e (fun g => P g.val)
      (fun j (g : {g // g ∉ groupsᶜ}) => C (physicalRootSmallPlanPattern groups patterns C hC p j).val g.val)).symm d) *
  physicalSelectedCoefficient
    (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val)
    (fun _ => 0)
    (fun j => physicalGroupReindexedCoefficient e
      (fun g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val g.val)
      (physicalRootPlanBigCoefficient groups patterns C hC ζ k K θ p j)) d

theorem physical_root_numbered_integrand_sum_eq_record_action
    {B : ℕ}
    [Fintype (PhysicalSelectedData (fun g => P (e.symm g).val) ell
      (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val))]
    (hP : ∀ g a, a ∈ P g → Nat.Prime a)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hk : ∀ t < n + 1, ∀ i ∈ patterns, ∀ g a, a ∈ P g → ¬ (a : ℤ) ∣ k t i)
    (β : PhysicalPrime P → ℝ) (ρ : ℝ)
    (hV : ∀ g, V g ≠ 0) (hρ : ρ ≠ 0)
    (hB : (physicalPrimeGroups P groups).card ≤ B)
    (cut : ℕ → Fin M → Finset (Fin J))
    (hencode : ∀ i, PhysicalMarkRowEncoding
      (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val)
      (physicalSelectedFineTag (n + 1) i) (cut i) (cut (i + 1))) :
    let _ : ∀ g (z : P (e.symm g).val), NeZero z.val :=
      fun g z => inferInstanceAs (NeZero (⟨(e.symm g).val, z⟩ : PhysicalPrime P).2.val)
    let Pn := fun g => P (e.symm g).val
    let Cn := fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val
    let Vn := fun g => V (e.symm g).val
    let βn := fun (g : Fin M) (z : Pn g) => β ⟨(e.symm g).val, z⟩
    (∑ d : PhysicalSelectedData Pn ell Cn,
      let db := (physicalSelectedGroupReindex e (fun g => P g.val)
        (fun j (g : {g // g ∉ groupsᶜ}) => C (physicalRootSmallPlanPattern groups patterns C hC p j).val g.val)).symm d
      let old := physicalRootSmallPlanPath groups patterns C hC p db
      physicalRootMixedPathIntegrand groups patterns C V q ζ k K β B r θ old.1 old.2) =
    (physicalStateMass (fun g : ↥groupsᶜ => V g.val) J ell : ℂ) *
    ∑ L : PhysicalMarkLists Pn J ell,
      ((∏ g, ∏ s : PhysicalSlots J ell, βn g (L g s) / Vn g : ℝ) : ℂ) *
      physicalSelectedRecordAction Cn (physicalRootPlanMultiplier groups patterns C hC k p)
        βn Vn ρ (fun g => hV (e.symm g).val)
        (fun j _ aux => physicalAuxMass Vn (Cn j) aux)
        (fun j => physicalEndpointSchedule q (n + 1) j.val) cut univ
        (physicalRootNumberedCompleteWeight groups e patterns C hC V q ζ k K r θ p) fullMemoryVacuum
        (physicalInitialMarkState B L) := by
  let _ : ∀ g (z : P (e.symm g).val), NeZero z.val :=
    fun g z => inferInstanceAs (NeZero (⟨(e.symm g).val, z⟩ : PhysicalPrime P).2.val)
  dsimp only
  have h := physical_root_numbered_weighted_history_sum_eq_record_action groups e patterns C hC k p
    hP hdis hk β V q ρ hV hρ hB cut hencode
    (physicalRootNumberedCompleteWeight groups e patterns C hC V q ζ k K r θ p)
  rw [← h, Finset.mul_sum]
  apply sum_congr rfl
  intro d _
  rw [physical_root_plan_integrand_selected]
  have hm := physical_selected_memory_product_reindex e
    (fun j (g : {g // g ∉ groupsᶜ}) => C (physicalRootSmallPlanPattern groups patterns C hC p j).val g.val)
    (fun g : {g // g ∉ groupsᶜ} => V g.val) (fun _ => 0)
    (physicalRootPlanBigCoefficient groups patterns C hC ζ k K θ p)
    ((physicalSelectedGroupReindex e (fun g => P g.val)
      (fun j (g : {g // g ∉ groupsᶜ}) => C (physicalRootSmallPlanPattern groups patterns C hC p j).val g.val)).symm d)
  simp only [Equiv.apply_symm_apply] at hm
  rw [← hm, physical_selected_memory_product_unrestricted, physicalRootNumberedCompleteWeight]
  ring

end Numbered
end Bounty
