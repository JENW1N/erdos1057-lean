open Finset Classical
theorem coupled_ghost_cutoff_one_symmetric {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)] [∀ g, DecidableEq (Z g)]
    (A D C ν : ∀ g, Z g → ℝ) (t : G → ℕ) (B : ℕ)
    (f : ProductBoundedOrderedState P Z t B → ℂ) (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric (coupledGhostCutoffOperator A D C ν t B (fun _ _ => 1) f) := by
  rw [coupled_ghost_cutoff_one_eq_coordinate_action]
  apply product_memory_cutoff_sandwich_symmetric
  · intro g h hh
    exact bounded_ordered_ghost_symmetric (A g) (D g) (C g) (ν g) (t g) B h hh
  · exact hf

theorem coupled_ghost_cutoff_energy_le {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)] [∀ g, DecidableEq (Z g)]
    (μ : ∀ g, P g → ℝ) (A D C ν v : ∀ g, Z g → ℝ) (t : G → ℕ) (B : ℕ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hA : ∀ g z, 0 ≤ A g z)
    (hν : ∀ g z, 0 < ν g z) (hv : ∀ g z, 0 < v g z)
    (hD : ∀ g z, A g z + |D g z| / v g z ≤ 1)
    (hC : ∀ g z, A g z + |C g z| / v g z ≤ 1)
    (phase : CoupledGhostPhase P Z t B) (hphase : ∀ s e, ‖phase s e‖ ≤ 1)
    (f : ProductBoundedOrderedState P Z t B → ℂ) (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ ν)
      (coupledGhostCutoffOperator A D C ν t B phase f) ≤
      (∏ g, Real.exp (∑ z, (|C g z| + |D g z|) * ν g z * v g z)) *
        finiteWeightedEnergy (productMemoryWeight μ ν) f := by
  apply finiteWeightedEnergy_le_of_envelope_domination
    (productMemoryWeight μ ν) (productMemoryWeight_nonneg μ ν hμ (fun g z => (hν g z).le)) f _
    (coupledGhostCutoffOperator A (fun g z => |D g z|) (fun g z => |C g z|) ν t B (fun _ _ => 1))
  · intro s
    exact (coupled_ghost_cutoff_norm_le_positive_re A D C ν hA (fun g z => (hν g z).le)
      t B phase hphase f s).trans (Complex.re_le_norm _)
  · rw [coupled_ghost_cutoff_one_eq_coordinate_action]
    have hlocal (g : G) (h : BoundedOrderedState (P g) (Z g) (t g) B → ℂ)
        (hh : BoundedOrderedSymmetric h) :
        finiteWeightedEnergy (boundedOrderedStateWeight (μ g) (ν g))
          (boundedOrderedGhostOperator (A g) (fun z => |D g z|) (fun z => |C g z|) (ν g) (t g) B h) ≤
        Real.exp (∑ z, (|C g z| + |D g z|) * ν g z * v g z) *
          finiteWeightedEnergy (boundedOrderedStateWeight (μ g) (ν g)) h := by
      simpa only [abs_abs] using bounded_ordered_ghost_energy_le (μ g) (A g)
        (fun z => |D g z|) (fun z => |C g z|) (ν g) (v g) (t g) B
        (hμ g) (hA g) (hν g) (hv g)
        (by intro z; simpa only [abs_abs] using hD g z)
        (by intro z; simpa only [abs_abs] using hC g z) h hh
    exact product_symmetric_cutoff_sandwich_energy_le μ ν hμ (fun g z => (hν g z).le)
      (fun g => boundedOrderedGhostOperator (A g) (fun z => |D g z|) (fun z => |C g z|) (ν g) (t g) B)
      (fun g => Real.exp (∑ z, (|C g z| + |D g z|) * ν g z * v g z))
      (fun _ => (Real.exp_pos _).le) hlocal univ (complexNormEnvelope f)
      (complexNormEnvelope_memory_symmetric f hf)
end

