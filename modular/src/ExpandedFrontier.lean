theorem ghost_phase_inactive_capped_history_reindex
    {I H : Type*} [Fintype I] [Fintype H] [DecidableEq I] [DecidableEq H]
    {R : I → Type*} [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (e : H ≃ I) (a : I → ℕ → Bool) (h : (i : I) → ℕ → R i)
    (η : I → ℕ → ℝ) (β V : I → ℝ) (B n : ℕ) (hB : Fintype.card I ≤ B) :
