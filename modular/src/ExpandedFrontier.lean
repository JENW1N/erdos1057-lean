noncomputable def candidatePrimitiveTypeIMass (c L q : ℝ) (r jStar N : ℕ) : ℝ :=
  ∑ d ∈ oddSquarefreeModuli N,
    typeIPrimitiveConductorNormSum d (arithmeticProductWindow 1 (Real.exp L))
      (fun u => (candidateCoefficient c L q r jStar u : ℂ)) (fun u => u) /
      (d.totient : ℝ)

theorem candidate_nonprincipal_typeI_mass_le_primitive (c L q : ℝ) (r jStar N : ℕ) :
    candidateNonprincipalTypeIMass c L q r jStar N ≤
      candidatePrimitiveTypeIMass c L q r jStar N := by
  apply sum_le_sum
  intro d hd
  have hd0 : 0 < d := (mem_Icc.mp (mem_filter.mp hd).1).1
  exact div_le_div_of_nonneg_right
    (@typeI_nonprincipal_norm_sum_le_conductors ℕ d ⟨hd0.ne'⟩
      (arithmeticProductWindow 1 (Real.exp L))
      (fun u => (candidateCoefficient c L q r jStar u : ℂ)) (fun u => u))
    (Nat.cast_nonneg _)

theorem eventually_candidate_typeI_remainder_le_primitive {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ q : ℝ, 0 ≤ q → ∀ r jStar N : ℕ,
      (N : ℝ) ≤ Real.exp L →
      (∑ d ∈ oddSquarefreeModuli N,
        |shiftedTotientSieveRemainder (arithmeticProductWindow 1 (Real.exp L))
          (candidateCoefficient c L q r jStar) d|) ≤
        candidatePrimitiveTypeIMass c L q r jStar N +
          candidateCoefficientWindowMass c L q r jStar *
            ((16 * primeEulerProductUpperConstant) * L^(-18 : ℝ)) := by
  filter_upwards [eventually_candidate_typeI_remainder_bound hc] with L hL
  intro q hq r jStar N hN
  exact (hL q hq r jStar N hN).trans
    (add_le_add (candidate_nonprincipal_typeI_mass_le_primitive c L q r jStar N) le_rfl)
