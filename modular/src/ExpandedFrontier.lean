/- The original candidate off-diagonal energy, with normalized finite-frequency error. -/

open Finset MeasureTheory Filter

namespace Bounty

theorem exists_candidate_original_energy_fourier_reduction
    {c q K₀ Cz A D : ℝ} (hc : 0 < c) (hq0 : 0 ≤ q) (hq1 : q < 1) (hCz : 0 ≤ Cz) :
    ∃ F : ℝ, 0 < F ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (r jStar : ℕ) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
        (take : Fin ((candidateQIndices c L).card*r) → Bool),
      take ((candidateAllocationOrder c L r).symm
        (candidateRoughSlot c L r jStar hr hj)) = false →
      ∀ (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ),
      (∀ slot p, p ∈ candidateQSlotChoices c L r jStar slot → ‖twist slot p‖ ≤ 1) →
      ∀ (U V E W : ℝ) (B : ℕ), 0 < U → 0 < V → E = U*L^(-K₀) → 4 ≤ U*V →
      max 1 (B:ℝ) ≤ typeIISmoothDyadicScale U V E 0 →
      Real.log (24*U^2*V*L^88/E) ≤ Cz*L →
      ∀ (M H : Finset ℕ) (α : ℕ → ℂ) (ρ : ℝ),
      (∀ m ∈ M, (m:ℝ) ∈ Set.Icc U (2*U)) → (∀ m ∈ M, ‖α m‖ ≤ L^A) →
      (∀ h ∈ H, 0 < h) →
      (2*U) / (2*(E/(2*L^88))) ≤ B → (B:ℝ) ≤ W → 2 ≤ W →
      (∀ m ∈ M, α m ≠ 0 → ∀ p ∈ m.primeFactors, W < (p:ℝ)) →
      let aH : ℕ → ℂ := fun h => typeIIPhase ρ h *
        candidateRetainedComplexCoefficient c L q r jStar take twist h
      |typeIIOffDiagonalEnergy (Icc ⌈E/(2*L^88)⌉₊ ⌊2*E⌋₊)
          (Icc ⌈V/2⌉₊ ⌊3*V⌋₊) M H
          (fun e n => typeIIEMajorant (L^88) ((e:ℝ)/E) * typeIINMajorant ((n:ℝ)/V)) α aH -
        (typeIIEnergyFourierIntegral L U V E B M H α aH
          {ξ : EuclideanSpace ℝ (Fin 3) | ‖ξ‖ ≤ L^F}).re| ≤
        (2*(B:ℝ)) * (∑ j ∈ range (typeIISmoothDyadicCount L), typeIISmoothDyadicScale U V E j) * L^(-D) := by
  obtain ⟨F, hF, herr⟩ := exists_candidate_energy_fourier_truncation
    (K₀ := K₀) (A := A) (D := D) hc hq0 hq1 hCz
  refine ⟨F, hF, ?_⟩
  filter_upwards [herr, eventually_gt_atTop (0:ℝ)] with L herr hL
  intro r jStar hr hj take hkeep twist htwist U V E W B hU hV hE hUV hZmin hZlog
    M H α ρ hM hα hH hB hBW hW hrough
  have hE0 : 0 < E := by rw [hE]; positivity
  have he := herr r jStar hr hj take hkeep twist htwist U V E B hU hV hE hUV
    hZmin hZlog M H α ρ hM hα hH
  dsimp only at he ⊢
  rw [typeII_majorant_energy_eq_dyadic_fourier M H α _ hL hU hV hE0 hUV hM hB hBW hW hrough]
  rw [← Complex.sub_re]
  exact (Complex.abs_re_le_norm _).trans he

