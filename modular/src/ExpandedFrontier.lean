               (fun key : PhysicalMixedBigKey (Ps := fun g : ↥groupsᶜ => P g.val)
                   (J := J) (ell := ell) (I := patterns) (K := Fin (n + 1)) =>
                 fun g => C key.2.1.val (e.symm g).val)
               (fun key => physicalSharedPrefix key.2.2.1)
               (fun key => k (n - key.1.val) key.2.1.val) B
               (physicalMixedBigSteps
                 ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1))) p.1 p.2) x).symm
