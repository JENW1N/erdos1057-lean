section

/- Actual error from changing memory caps is bounded by the ghost-birth
excursion tail. The comparison transports the whole-path phase, retains
all event identities, and measures the error on the smaller state space. -/

open Finset Classical

namespace Bounty

section

variable {J K G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  {M : G → ℕ} (S : K → ∀ g, Finset (Fin (M g)))
  (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
  (Δ D : ∀ k c, A k c → G → ℤ)
  {b B : ℕ} (h : b ≤ B)
  (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)

theorem full_permutation_mixed_cap_difference_energy_le
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 < μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (hC : ∀ j g, q j / ρ ^ 2 + ((1 - q j) * (2 * V g) / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (steps : List (Option (J ⊕ K))) (I : ℕ) (hIb : I ≤ b)
    (phase : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fun s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b =>
        if productTotalMemory s ≤ I then
          fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps phase f (productStateCapEmbed h s) -
            fullPermutationMixedPathAction n S b A Δ D ω μ q ρ V steps
              (fullPermutationMixedCapPhase n S A Δ D h ω μ q ρ V steps phase)
              (fun x => f (productStateCapEmbed h x)) s
        else 0) ≤
      ((2 : ℝ) ^ (b + 1 - I - fullMemoryEdgeCount steps * (T * Fintype.card G)))⁻¹ ^ 2 *
        (steps.map (fullDoubledGhostStepEnergy ρ v vmin vmax T (Fintype.card G))).prod *
        finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  have heq :
      (fun s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b =>
        if productTotalMemory s ≤ I then
          fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps phase f (productStateCapEmbed h s) -
            fullPermutationMixedPathAction n S b A Δ D ω μ q ρ V steps
              (fullPermutationMixedCapPhase n S A Δ D h ω μ q ρ V steps phase)
              (fun x => f (productStateCapEmbed h x)) s
        else 0) =
      (fun s => fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps
        (fun y p => if productTotalMemory y ≤ I ∧
          b < fullMemoryPathPeak n S B A Δ D steps y p then phase y p else 0)
        f (productStateCapEmbed h s)) := by
    funext s
    exact full_permutation_mixed_cap_difference_mask n S A Δ D h ω μ q ρ V steps phase f I hIb s
  rw [heq]
  apply le_trans (product_cap_pullback_energy_le h μ (fun g => unrestrictedResidueWeight (μ g))
    (fun g p => (hμ g p).le) (fun g z => (hμ g z.1).le) _)
  simpa only [and_true] using
    full_memory_excursion_energy_le n S B A Δ D ω μ q ρ V
      hω hωmass hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass hq0 hq1 hD hC T ht steps
      I b (fun _ _ => True) phase hphase f hf

end

