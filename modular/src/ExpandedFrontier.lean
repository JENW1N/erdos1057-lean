namespace Bounty

theorem physical_prime_harmonic_pair_error {G : Type*} [Fintype G] [dG : DecidableEq G]
    {J ell : ℕ} (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    {v : ℝ} (hv : 0 < v) (hV : ∀ g, v ≤ V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1/(p : ℝ) = V g)
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ) (hξ : 0 < ξ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
    (a b : ℝ) {Pmin ε : ℝ} (hPmin : 0 < Pmin) (hε : 0 ≤ ε)
    (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (pool : Finset ℕ) (α β γ α' β' γ' : ℕ → ℂ)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ n, ‖γ n‖ ≤ C)
    (hα' : ∀ m, ‖α' m‖ ≤ A) (hβ' : ∀ p, ‖β' p‖ ≤ B) (hγ' : ∀ n, ‖γ' n‖ ≤ C)
    (S : Finset ℤ) (δ : ℤ) (N : ℕ)
    (hS : ∀ n ∈ S, 0 ≤ n ∧ n ≤ (N : ℤ))
    (hS' : ∀ n ∈ S, 0 < n+δ ∧ n+δ ≤ (N : ℤ))
    {Y K : ℝ} (hY : 0 < Y) (hK : 0 ≤ K) (hYlow : ∀ n ∈ S, Y ≤ (n : ℝ))
    (θ : ℤ → ℂ) (hθ : ∀ n ∈ S, ‖θ n‖ ≤ K)
    (herror : ∀ n ∈ S,
      let cut := repeatedBigPrimePatternCut probes r t i
      let H := repeatedBigPrimePatternBound probes r t Q ξ i
      (∑ g, (J - (cut g).card : ℕ) *
        (Real.log n.natAbs / Real.log 2 + Real.log (n+δ).natAbs / Real.log 2 + J) /
          (V g * Pmin)) *
        (H + H / (1/2 : ℝ) ^ (2 * ∑ g : G, (J - (cut g).card))) ≤ ε) :
    let M := (markedDivisorBound (1/2) v (ell+J)) ^ Fintype.card G
    ‖∑ n ∈ S, (θ n / (n : ℂ)) *
      star (invariantTripleEndpoint pool α β γ n.natAbs) *
      invariantTripleEndpoint pool α' β' γ' (n+δ).natAbs *
        physicalPrimePairError P V probes r t hrt Q h ξ i aux a b n.natAbs (n+δ).natAbs‖ ≤
      (K * M * M * ε / Y) * ((A*B*C)^2 * (N : ℝ) * (1+Real.log N)^15) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  let cut := repeatedBigPrimePatternCut probes r t i
  let marks := fun g => ell + (cut g).card
  let W := fun n : ℤ => markedDivisorWeight univ P (1/2) V marks n
  let M := (markedDivisorBound (1/2) v (ell+J)) ^ Fintype.card G
  have hV0 : ∀ g, 0 < V g := fun g => hv.trans_le (hV g)
  have hmarks : ∀ g, marks g ≤ ell+J := by
    intro g
    apply Nat.add_le_add_left
    exact (card_le_card (subset_univ (cut g))).trans_eq (by simp)
  have hW (n : ℤ) : 0 ≤ W n ∧ W n ≤ M := by
    refine ⟨marked_divisor_weight_nonneg univ P (by norm_num) V marks
      (fun g _ => (hV0 g).le) n, ?_⟩
    simpa only [card_univ] using marked_divisor_weight_le_pow univ P
      (by norm_num : (0 : ℝ) ≤ 1/2) (by norm_num : (1/2 : ℝ) < 1) hv
      V marks (ell+J) (fun g _ => hV g) (fun g _ => hmarks g) n
  have hM : 0 ≤ M := pow_nonneg (zero_le_one.trans (one_le_markedDivisorBound (1/2) v (ell+J))) _
  apply invariant_harmonic_pair_error pool α β γ α' β' γ' hA hB hC hα hβ hγ hα' hβ' hγ'
    S δ N hS (fun n hn => ⟨(hS' n hn).1.le, (hS' n hn).2⟩) hY hK hM hM hε hYlow θ
    (fun n => physicalPrimePairError P V probes r t hrt Q h ξ i aux a b n.natAbs (n+δ).natAbs)
    (fun n => W n.natAbs) (fun n => W (n+δ).natAbs) hθ
    (fun n _ => hW n.natAbs) (fun n _ => hW (n+δ).natAbs)
  intro n hn
  have hn0 : (0 : ℤ) < n := by exact_mod_cast hY.trans_le (hYlow n hn)
  exact physical_prime_pair_error_bound P V probes hprime hdis hV0 hMass r t hrt Q h ξ hξ
    i aux a b (Int.natAbs_pos.mpr (ne_of_gt hn0))
    (Int.natAbs_pos.mpr (ne_of_gt (hS' n hn).1)) hPmin hp (herror n hn)

end Bounty
end

section

/- The exact pair formula uses coverage only for its actual auxiliary labels. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_fixed_root_full_pair_on_fixed_support
    {G : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (V : G → ℝ) (C : G → Finset (Fin J)) (q a b : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (positions S : Finset ℤ)
    (hclosure : physicalFixedAuxPositionClosure P C ell k aux S ⊆ positions)
    (f g : ℤ → ℂ) (Ψ : ℝ → ℂ) (Z : ℝ)
    (hf : ∀ (L : PhysicalMarkLists P J ell) w,
      f ((physicalSharedFactor C L : ℤ) * w) = f w)
    (hg : ∀ (L : PhysicalMarkLists P J ell) w,
      g ((physicalSharedFactor C L : ℤ) * w) = g w)
    (hsupport : ∀ w : ℤ,
      Ψ ((w : ℝ) / (Z * physicalFreeFactor C aux)) * (w : ℂ)⁻¹ *
        (starRingEnd ℂ) (f w) * g (w + k * (physicalFreeFactor C aux : ℕ)) ≠ 0 → w ∈ S) :
    physicalFixedRootCorrelation V C q (-(a+b)) k K aux positions
      (fun n => physicalPhase (-a) n.natAbs * f n)
      (fun n => physicalPhase b n.natAbs * g n) Ψ Z =
    (physicalAuxMass V C aux : ℂ) * ∑ w ∈ S,
      (Ψ ((w : ℝ) / (Z * physicalFreeFactor C aux)) * (w : ℂ)⁻¹ *
        (starRingEnd ℂ) (f w) * g (w + k * (physicalFreeFactor C aux : ℕ))) *
      physicalFullPairCorrelation P C V q w.natAbs
        (w + k * (physicalFreeFactor C aux : ℕ)).natAbs
        (physicalPhasedPairCoefficient C K aux a b w.natAbs
          (w + k * (physicalFreeFactor C aux : ℕ)).natAbs) := by
  let W := S ∪ physicalQuotientPositions P C ell positions
  have hW : ∀ L : PhysicalMarkLists P J ell, ∀ n ∈ positions,
      n / physicalSharedFactor C L ∈ W :=
    fun L n hn => mem_union_right _ (physical_mem_quotient_positions P C positions L hn)
  have hc : ∀ w ∈ W,
      Ψ ((w : ℝ) / (Z * physicalFreeFactor C aux)) * (w : ℂ)⁻¹ *
        (starRingEnd ℂ) (f w) * g (w + k * (physicalFreeFactor C aux : ℕ)) ≠ 0 →
      ∀ L : PhysicalMarkLists P J ell,
        (physicalSharedFactor C L : ℤ) * w ∈ positions ∧
        (physicalSharedFactor C L : ℤ) *
          (w + k * (physicalFreeFactor C aux : ℕ)) ∈ positions := by
    intro w _ hw L
    exact (physical_fixed_aux_closure_subset_iff P C k aux S positions).mp hclosure L w
      (hsupport w hw)
  rw [physical_fixed_root_full_pair_of_coverage hdis hprime V C q a b k K aux positions W hW
    f g Ψ Z hf hg hc]
  congr 1
  symm
  apply sum_subset (subset_union_left (s₁ := S) (s₂ := physicalQuotientPositions P C ell positions))
  intro w _ hw
  have hz : Ψ ((w : ℝ) / (Z * physicalFreeFactor C aux)) * (w : ℂ)⁻¹ *
      (starRingEnd ℂ) (f w) * g (w + k * (physicalFreeFactor C aux : ℕ)) = 0 := by
    by_contra hn
    exact hw (hsupport w hn)
  rw [hz, zero_mul]

end Bounty
end

section

/- Concrete support parameters for the original invariant harmonic error estimate. -/

open Finset
namespace Bounty

theorem harmonic_positive_error_parameters {Z : ℝ} (hZ : 0 < Z)
    (k : ℤ) {d : ℕ} (hd : 0 < d) (hk : |(k : ℝ)| ≤ Z) :
    0 < Z*(d : ℝ)/2 ∧
    ∀ w ∈ harmonicPositiveSupport Z k d,
      (0 ≤ w ∧ w ≤ (⌈3*Z*(d : ℝ)⌉₊ : ℤ)) ∧
      (0 < w+k*(d : ℤ) ∧ w+k*(d : ℤ) ≤ (⌈3*Z*(d : ℝ)⌉₊ : ℤ)) ∧
      Z*(d : ℝ)/2 ≤ (w : ℝ) ∧
      ‖(typeIIHarmonicDyadic ((w : ℝ)/(Z*(d : ℝ))) : ℂ)‖ ≤ 2 := by
  have hZd : 0 < Z*(d : ℝ) := mul_pos hZ (by exact_mod_cast hd)
  refine ⟨half_pos hZd, ?_⟩
  intro w hw
  have hs := mem_harmonic_positive_support hw
  have hwN : (w : ℝ) ≤ (⌈3*Z*(d : ℝ)⌉₊ : ℝ) := by
    calc
      _ ≤ 2*Z*(d : ℝ) := hs.2.2.1
      _ ≤ 3*Z*(d : ℝ) := by nlinarith
      _ ≤ _ := Nat.le_ceil _
  have htN : ((w+k*(d : ℤ) : ℤ) : ℝ) ≤ (⌈3*Z*(d : ℝ)⌉₊ : ℝ) :=
    (Int.le_floor.mp (harmonic_positive_support_upper_shift k hk hw)).trans (Nat.le_ceil _)
  refine ⟨⟨hs.1.le, by exact_mod_cast hwN⟩,
    ⟨hs.2.2.2, by exact_mod_cast htN⟩, hs.2.1.le, ?_⟩
  rw [Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (typeII_harmonic_dyadic_bounds _).1]
  exact (typeII_harmonic_dyadic_bounds _).2

end Bounty
end

section

/- A uniform bound for the actual marked weights at any retained cut. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_marked_weight_bound {G : Type*} [Fintype G]
    {J ell : ℕ} (P : G → Finset ℕ) (V : G → ℝ) (cut : G → Finset (Fin J))
    {v : ℝ} (hv : 0 < v) (hV : ∀ g, v ≤ V g) (n : ℤ) :
    let W := markedDivisorWeight univ P (1/2) V (fun g => ell + (cut g).card) n
    0 ≤ W ∧ W ≤ (markedDivisorBound (1/2) v (ell+J)) ^ Fintype.card G := by
  refine ⟨marked_divisor_weight_nonneg univ P (by norm_num) V _
    (fun g _ => (hv.trans_le (hV g)).le) n, ?_⟩
  have hmarks : ∀ g, ell + (cut g).card ≤ ell+J := by
    intro g
    apply Nat.add_le_add_left
    exact (card_le_card (subset_univ (cut g))).trans_eq (by simp)
  simpa only [card_univ] using marked_divisor_weight_le_pow univ P
    (by norm_num : (0 : ℝ) ≤ 1/2) (by norm_num : (1/2 : ℝ) < 1) hv
    V (fun g => ell + (cut g).card) (ell+J) (fun g _ => hV g) (fun g _ => hmarks g) n

end Bounty
end

section

/- Exact decomposition of the original full prime pair into the unrestricted
marked pair and the two checked error terms. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_prime_pair_decomposition {G : Type*} [Fintype G] [DecidableEq G]
    {J ell : ℕ} (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
    (a b : ℝ) (w z : ℕ) :
    let cut := repeatedBigPrimePatternCut probes r t i
    let marks := fun g => ell + (cut g).card
    let W := fun n : ℤ => markedDivisorWeight univ P (1/2) V marks n
    physicalFullPairCorrelation P cut V (1/2) w z
      (physicalOriginalPrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w z) =
      physicalPrimePairError P V probes r t hrt Q h ξ i aux a b w z +
      ((W w * W z : ℝ) : ℂ) * physicalFreePrimePairError P V probes r t hrt Q h ξ i aux a b w z +
      ((W w * W z : ℝ) : ℂ) * groupMarkedAverage P marks (w : ℤ) (fun u =>
        groupMarkedAverage P marks (z : ℤ)
          (physicalFreePrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w z u)) := by
  unfold physicalPrimePairError physicalFreePrimePairError
  dsimp only
  push_cast
  ring

theorem physical_prime_harmonic_decomposition {G : Type*} [Fintype G] [DecidableEq G]
    {J ell : ℕ} (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
    (a b : ℝ) (S : Finset ℤ) (δ : ℤ) (F : ℤ → ℂ) :
    let cut := repeatedBigPrimePatternCut probes r t i
    let marks := fun g => ell + (cut g).card
    let W := fun n : ℤ => markedDivisorWeight univ P (1/2) V marks n
    (∑ n ∈ S, F n * physicalFullPairCorrelation P cut V (1/2) n.natAbs (n+δ).natAbs
      (physicalOriginalPrimePairCoefficient P V probes r t hrt Q h ξ i aux a b n.natAbs (n+δ).natAbs)) -
      (∑ n ∈ S, F n * ((W n.natAbs * W (n+δ).natAbs : ℝ) : ℂ) *
        groupMarkedAverage P marks (n.natAbs : ℤ) (fun u =>
          groupMarkedAverage P marks ((n+δ).natAbs : ℤ)
            (physicalFreePrimePairCoefficient P V probes r t hrt Q h ξ i aux a b n.natAbs (n+δ).natAbs u))) =
      (∑ n ∈ S, F n * physicalPrimePairError P V probes r t hrt Q h ξ i aux a b n.natAbs (n+δ).natAbs) +
      (∑ n ∈ S, F n * ((W n.natAbs * W (n+δ).natAbs : ℝ) : ℂ) *
        physicalFreePrimePairError P V probes r t hrt Q h ξ i aux a b n.natAbs (n+δ).natAbs) := by
  dsimp only
  rw [← sum_sub_distrib, ← sum_add_distrib]
  apply sum_congr rfl
  intro n _
  rw [physical_prime_pair_decomposition]
  ring

end Bounty
end

section

/- The logarithmic Fourier transform of the literal original harmonic dyadic cutoff. -/

open MeasureTheory
open scoped FourierTransform ContDiff
namespace Bounty

noncomputable def harmonicLogCutoff (u : ℝ) : ℝ := typeIIHarmonicDyadic (Real.exp u)

theorem harmonic_log_cutoff_contDiff : ContDiff ℝ ∞ harmonicLogCutoff :=
  typeII_harmonic_dyadic_contDiff.comp Real.contDiff_exp

theorem harmonic_log_cutoff_support {u : ℝ} (h : harmonicLogCutoff u ≠ 0) :
    u ∈ Set.Icc (-1) 1 := by
  have hs : typeIISmoothDyadic (Real.exp u) ≠ 0 := by
    intro hz
    exact h (by simp only [harmonicLogCutoff, typeIIHarmonicDyadic, hz, mul_zero])
  simpa only [Real.log_exp] using typeII_smooth_dyadic_log_box hs

theorem harmonic_log_cutoff_hasCompactSupport : HasCompactSupport harmonicLogCutoff := by
  apply HasCompactSupport.intro isCompact_Icc
  intro u hu
  by_contra hn
  exact hu (harmonic_log_cutoff_support hn)

noncomputable def harmonicLogSchwartz : SchwartzMap ℝ ℂ :=
  (harmonic_log_cutoff_hasCompactSupport.comp_left
    (g := fun x : ℝ => (x : ℂ)) (by simp)).toSchwartzMap
      (Complex.ofRealCLM.contDiff.comp harmonic_log_cutoff_contDiff)

noncomputable def harmonicLogFourier : SchwartzMap ℝ ℂ := 𝓕 harmonicLogSchwartz

theorem harmonic_log_fourier_integrable : Integrable harmonicLogFourier := harmonicLogFourier.integrable

theorem harmonic_log_fourier_moment_integrable (M : ℕ) :
    Integrable (fun v : ℝ => ‖v‖^M*‖harmonicLogFourier v‖) :=
  harmonicLogFourier.integrable_pow_mul volume M

theorem harmonic_log_fourier_inversion (u : ℝ) :
    (harmonicLogCutoff u : ℂ) = ∫ v : ℝ,
      Complex.exp ((2*Real.pi*v*u : ℝ)*Complex.I)*harmonicLogFourier v := by
  have hi := congrArg (fun f : SchwartzMap ℝ ℂ => f u)
    (FourierPair.fourierInv_fourier_eq (E := SchwartzMap ℝ ℂ)
      (F := SchwartzMap ℝ ℂ) harmonicLogSchwartz)
  rw [SchwartzMap.fourierInv_coe, Real.fourierInv_eq'] at hi
  change (∫ v : ℝ, Complex.exp ((2*Real.pi*inner ℝ v u : ℝ)*Complex.I) •
    harmonicLogFourier v) = (harmonicLogCutoff u : ℂ) at hi
  rw [← hi]
  apply integral_congr_ae
  filter_upwards [] with v
  simp only [RCLike.inner_apply, starRingEnd_apply, star_trivial, smul_eq_mul]
  congr 2
  push_cast
  ring

theorem harmonic_log_fourier_rapid_tail (M : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ R : ℝ, 1 ≤ R →
      (∫ v in {v : ℝ | R < ‖v‖}, ‖harmonicLogFourier v‖) ≤ C*R^(-(M : ℝ)) :=
  schwartz_norm_rapid_tail harmonicLogFourier M

end Bounty
end

section

/- Common positive endpoint windows for two fixed logarithmic cells. -/

namespace Bounty

noncomputable def harmonicCellProductScale (h : ℝ) (i j : ℤ) : ℝ :=
  Real.exp (((i : ℝ) - 1) * h) * Real.exp (((j : ℝ) - 1) * h)

theorem harmonic_cell_product_scale_pos (h : ℝ) (i j : ℤ) :
    0 < harmonicCellProductScale h i j := by
  unfold harmonicCellProductScale
  positivity

theorem harmonic_cell_product_bounds {h : ℝ} (hh : 0 < h) (hh1 : h ≤ 1)
    {D_A D_B : ℕ} (hA : 0 < D_A) (hB : 0 < D_B) {i j : ℤ}
    (hcA : upperLogCell h (Real.log D_A) = i)
    (hcB : upperLogCell h (Real.log D_B) = j) :
    harmonicCellProductScale h i j < (D_A * D_B : ℕ) ∧
      ((D_A * D_B : ℕ) : ℝ) ≤ Real.exp 2 * harmonicCellProductScale h i j := by
  obtain ⟨hAl, hAu⟩ := (upper_log_cell_nat_eq_iff hh hA i).mp hcA
  obtain ⟨hBl, hBu⟩ := (upper_log_cell_nat_eq_iff hh hB j).mp hcB
  have hAe : 0 < Real.exp (((i : ℝ) - 1) * h) := Real.exp_pos _
  have hBr : (0 : ℝ) < D_B := by exact_mod_cast hB
  constructor
  · rw [Nat.cast_mul]
    unfold harmonicCellProductScale
    exact (mul_lt_mul_of_pos_left hBl hAe).trans (mul_lt_mul_of_pos_right hAl hBr)
  · have hu : (D_A : ℝ) * (D_B : ℝ) ≤ Real.exp ((i : ℝ) * h) * Real.exp ((j : ℝ) * h) :=
      mul_le_mul hAu hBu (Nat.cast_nonneg _) (Real.exp_pos _).le
    have he : Real.exp ((i : ℝ) * h) * Real.exp ((j : ℝ) * h) =
        Real.exp (2 * h) * harmonicCellProductScale h i j := by
      unfold harmonicCellProductScale
      simp only [← Real.exp_add]
      congr 1
      ring
    rw [Nat.cast_mul]
    apply hu.trans
    rw [he]
    exact mul_le_mul_of_nonneg_right (Real.exp_le_exp.mpr (by linarith))
      (harmonic_cell_product_scale_pos h i j).le

theorem harmonic_common_window_of_scale {Z H : ℝ} (hZ : 0 < Z) (hH : 0 < H)
    {d : ℕ} (hHd : H ≤ (d : ℝ)) (hdH : (d : ℝ) ≤ Real.exp 2 * H)
    {k w : ℤ} (hk : |(k : ℝ)| ≤ Z / 4)
    (hψ : typeIIHarmonicDyadic ((w : ℝ) / (Z * (d : ℝ))) ≠ 0) :
    (w : ℝ) ∈ Set.Ioo (Z * H / 4) (3 * Real.exp 2 * (Z * H)) ∧
      ((w + k * (d : ℤ) : ℤ) : ℝ) ∈
        Set.Ioo (Z * H / 4) (3 * Real.exp 2 * (Z * H)) := by
  have hd : (0 : ℝ) < d := hH.trans_le hHd
  have hZd : 0 < Z * (d : ℝ) := mul_pos hZ hd
  have hs := typeII_harmonic_dyadic_support hψ
  have hwlo := (lt_div_iff₀ hZd).mp hs.1
  have hwhi := (div_lt_iff₀ hZd).mp hs.2
  have hYd : Z * H ≤ Z * (d : ℝ) := mul_le_mul_of_nonneg_left hHd hZ.le
  have hdY : Z * (d : ℝ) ≤ Real.exp 2 * (Z * H) := by
    nlinarith [mul_le_mul_of_nonneg_left hdH hZ.le]
  have hY : 0 < Z * H := mul_pos hZ hH
  have hEY : 0 < Real.exp 2 * (Z * H) := mul_pos (Real.exp_pos _) hY
  have hkl := mul_le_mul_of_nonneg_right (abs_le.mp hk).1 hd.le
  have hku := mul_le_mul_of_nonneg_right (abs_le.mp hk).2 hd.le
  constructor
  · constructor <;> nlinarith
  · push_cast
    constructor <;> nlinarith

theorem harmonic_common_window_of_cells {Z h : ℝ} (hZ : 0 < Z)
    (hh : 0 < h) (hh1 : h ≤ 1) {D_A D_B : ℕ} (hA : 0 < D_A) (hB : 0 < D_B)
    {i j k w : ℤ} (hcA : upperLogCell h (Real.log D_A) = i)
    (hcB : upperLogCell h (Real.log D_B) = j) (hk : |(k : ℝ)| ≤ Z / 4)
    (hψ : typeIIHarmonicDyadic ((w : ℝ) / (Z * ((D_A * D_B : ℕ) : ℝ))) ≠ 0) :
    (w : ℝ) ∈ Set.Ioo (Z * harmonicCellProductScale h i j / 4)
      (3 * Real.exp 2 * (Z * harmonicCellProductScale h i j)) ∧
    ((w + k * (D_A * D_B : ℕ) : ℤ) : ℝ) ∈
      Set.Ioo (Z * harmonicCellProductScale h i j / 4)
        (3 * Real.exp 2 * (Z * harmonicCellProductScale h i j)) := by
  have hb := harmonic_cell_product_bounds hh hh1 hA hB hcA hcB
  exact harmonic_common_window_of_scale hZ (harmonic_cell_product_scale_pos h i j)
    hb.1.le hb.2 hk hψ

theorem harmonic_common_window_positive_natAbs {Y : ℝ} (hY : 0 < Y)
    {k w : ℤ} {d : ℕ}
    (hw : (w : ℝ) ∈ Set.Ioo (Y / 4) (3 * Real.exp 2 * Y))
    (ht : ((w + k * (d : ℤ) : ℤ) : ℝ) ∈ Set.Ioo (Y / 4) (3 * Real.exp 2 * Y)) :
    0 < w ∧ 0 < w + k * (d : ℤ) ∧
      (w.natAbs : ℝ) ∈ Set.Ioo (Y / 4) (3 * Real.exp 2 * Y) ∧
      ((w + k * (d : ℤ)).natAbs : ℝ) ∈ Set.Ioo (Y / 4) (3 * Real.exp 2 * Y) := by
  have hwpos : 0 < w := by exact_mod_cast (show (0 : ℝ) < w by linarith [hw.1])
  have htpos : 0 < w + k * (d : ℤ) := by
    exact_mod_cast (show (0 : ℝ) < (w + k * (d : ℤ) : ℤ) by linarith [ht.1])
  refine ⟨hwpos, htpos, ?_, ?_⟩
  · have heq : (w.natAbs : ℝ) = (w : ℝ) := by
      simpa only [Int.cast_natCast] using congrArg (fun z : ℤ => (z : ℝ)) (Int.natAbs_of_nonneg hwpos.le)
    rwa [heq]
  · have heq : ((w + k * (d : ℤ)).natAbs : ℝ) = ((w + k * (d : ℤ) : ℤ) : ℝ) := by
      simpa only [Int.cast_natCast] using congrArg (fun z : ℤ => (z : ℝ)) (Int.natAbs_of_nonneg htpos.le)
    rwa [heq]

end Bounty
end

section

/- The actual weighted sum of selected physical histories satisfies the same energy bound. -/

open Finset
namespace Bounty

section Energy
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g, ∀ p : ↥(P g), NeZero p.val]
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ) (cut : ℕ → Fin N → Finset (Fin J))
  (S : Finset (PhysicalSelectedData P ell C)) (w : PhysicalSelectedData P ell C → ℂ)

theorem physical_selected_outer_sum_energy_le
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hencode : ∀ i, PhysicalMarkRowEncoding C (physicalSelectedFineTag n i) (cut i) (cut (i + 1)))
    (hω : ∀ j c a, 0 ≤ ω j c a) (hωmass : ∀ j c, ∑ a, ω j c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 < β g p / V g) (hmass : ∀ g, ∑ p, β g p / V g ≤ 2)
    (hq0 : ∀ i, 0 ≤ retention i) (hq1 : ∀ i, retention i ≤ 1)
