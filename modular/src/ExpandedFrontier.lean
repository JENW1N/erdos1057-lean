/- Nonprincipal harmonic Mellin cancellation for the actual exponential roughness test. -/

open Finset Filter

namespace Bounty

theorem eventually_exponential_rough_test_mellin_bound (hZ : PrimitiveZeroFreeHalfPlane)
    {γ C T : ℝ} (hγ : 0 < γ) (hC : 0 < C) (hT : 0 ≤ T) (Bsave : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ U V : ℝ, 1 ≤ U → 0 ≤ V → V ≤ Real.exp (C*L) →
      ∀ (r : ℕ), 0 < r → (r : ℝ) ≤ L^T →
      ∀ χ : DirichletCharacter ℂ r, χ ≠ 1 → ∀ v : ℝ, |v| ≤ L^T →
        ‖∑ n ∈ roughBand U V (Real.exp (γ*L)),
          harmonicMellinWeight v n*χ (n : ZMod r)‖ ≤ L^(-Bsave) := by
  classical
  filter_upwards [eventually_prime_mellin_band_power_bound hZ hγ hC hT (Bsave+2),
    eventually_ge_atTop (1 : ℝ), eventually_ge_atTop (C+2)] with L hprime hL1 hLc
  have hL : 0 < L := zero_lt_one.trans_le hL1
  intro U V hU hV hVmax r hr hrT χ hχ v hv
  by_cases hV1 : 1 ≤ V
  swap
  · have hVU : V ≤ U := by linarith
    simp only [roughBand, Ioc_eq_empty_of_le (Nat.floor_le_floor hVU), filter_empty, sum_empty, norm_zero]
    positivity
  let z := Real.exp (γ*L)
  let w := fun n : ℕ => harmonicMellinWeight v n*χ (n : ZMod r)
  have hwprod : ∀ p m : ℕ, 0 < p → 0 < m → w (p*m) = w p*w m := by
    intro p m hp hm
    dsimp [w]
    rw [Nat.cast_mul, harmonic_mellin_weight_mul v (Nat.cast_pos.mpr hp) (Nat.cast_pos.mpr hm),
      Nat.cast_mul, map_mul]
    ring
  have hwnorm : ∀ m : ℕ, 0 < m → ‖w m‖ ≤ 1/(m : ℝ) := by
    intro m hm
    dsimp [w]
    rw [norm_mul, norm_harmonic_mellin_weight v (Nat.cast_pos.mpr hm)]
    exact mul_le_of_le_one_right (by positivity) (χ.norm_le_one _)
  have hfirst : ‖∑ p ∈ primeBand (max U z) V, w p‖ ≤ L^(-(Bsave+2)) :=
    hprime _ V (le_max_right _ _) hV hVmax r hr hrT χ hχ v hv
  have hinner : ∀ m ∈ roughBand 1 V z,
      ‖∑ p ∈ (primeBand z (m.minFac : ℝ)).filter
        (fun p : ℕ => U < (m : ℝ)*(p : ℝ) ∧ (m : ℝ)*(p : ℝ) ≤ V), w (p*m)‖ ≤
          (1/(m : ℝ))*L^(-(Bsave+2)) := by
    intro m hm
    have hm0 := roughBand_pos hm
    have hmR : 0 < (m : ℝ) := Nat.cast_pos.mpr hm0
    have hm1 : (1 : ℝ) ≤ m := by exact_mod_cast hm0
    let P := (primeBand z (m.minFac : ℝ)).filter
      (fun p : ℕ => U < (m : ℝ)*(p : ℝ) ∧ (m : ℝ)*(p : ℝ) ≤ V)
    have hsum : (∑ p ∈ P, w (p*m)) = (∑ p ∈ P, w p)*w m := by
      rw [sum_mul]
      apply sum_congr rfl
      intro p hp
      exact hwprod p m ((mem_filter.mp (mem_filter.mp hp).1).2.pos) hm0
    have hPbound : ‖∑ p ∈ P, w p‖ ≤ L^(-(Bsave+2)) := by
      dsimp [P]
      rw [primeBand_product_interval (Real.exp_pos _).le (Nat.cast_nonneg _) hmR (by linarith) hV]
      apply hprime _ _ (le_max_left _ _) (le_min (Nat.cast_nonneg _) (div_nonneg hV hmR.le))
        _ r hr hrT χ hχ v hv
      exact (min_le_right _ _).trans ((div_le_self hV hm1).trans hVmax)
    change ‖∑ p ∈ P, w (p*m)‖ ≤ _
    rw [hsum, norm_mul]
    have hmul := mul_le_mul hPbound (hwnorm m hm0) (norm_nonneg _) (by positivity)
    exact hmul.trans_eq (mul_comm _ _)
  have hlogV : Real.log V ≤ C*L := by
    simpa only [Real.log_exp] using Real.log_le_log (zero_lt_one.trans_le hV1) hVmax
  have hmass : (∑ m ∈ roughBand 1 V z, 1/(m : ℝ)) ≤ 1+C*L :=
    (roughBandHarmonic_le_log hV1).trans (add_le_add le_rfl hlogV)
  have hscale : 2+C*L ≤ L^2 := by
    have hh := mul_le_mul_of_nonneg_right hLc hL.le
    nlinarith
  change ‖∑ n ∈ roughBand U V z, w n‖ ≤ _
  rw [weighted_rough_band_cofactor_identity hU hV (Real.exp_pos _).le w]
  calc
    _ ≤ ‖∑ p ∈ primeBand (max U z) V, w p‖+
        ‖∑ m ∈ roughBand 1 V z,
          ∑ p ∈ (primeBand z (m.minFac : ℝ)).filter
            (fun p : ℕ => U < (m : ℝ)*(p : ℝ) ∧ (m : ℝ)*(p : ℝ) ≤ V), w (p*m)‖ := norm_add_le _ _
    _ ≤ L^(-(Bsave+2))+∑ m ∈ roughBand 1 V z, (1/(m : ℝ))*L^(-(Bsave+2)) := by
      apply add_le_add hfirst
      exact (norm_sum_le _ _).trans (sum_le_sum hinner)
    _ = (1+∑ m ∈ roughBand 1 V z, 1/(m : ℝ))*L^(-(Bsave+2)) := by rw [← sum_mul]; ring
    _ ≤ (2+C*L)*L^(-(Bsave+2)) := by
      apply mul_le_mul_of_nonneg_right _ (by positivity)
      linarith
    _ ≤ L^2*L^(-(Bsave+2)) := mul_le_mul_of_nonneg_right hscale (by positivity)
    _ = L^(-Bsave) := by
      rw [← Real.rpow_natCast L 2, ← Real.rpow_add hL]
      congr 1
      norm_num

end Bounty
end

section

/- Order actual samples at any original owner by their unchanged global birth addresses. -/

namespace Bounty

section Order
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K))) (u : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (steps.get u) s)
    [Fintype (FullMixedEventBirthCoordinate n S B A Δ D (steps.get u) s e)]

noncomputable def fullMixedOwnerSampleOrder :
    Fin (Fintype.card (FullMixedEventBirthCoordinate n S B A Δ D (steps.get u) s e)) ≃
      FullMixedEventBirthCoordinate n S B A Δ D (steps.get u) s e :=
  finiteEmbeddedOrder (fullMixedOwnerCoordinateEmbedding n S B A Δ D steps u s e)

noncomputable def fullMixedOwnerOrderedSampleEmbedding :
    Fin (Fintype.card (FullMixedEventBirthCoordinate n S B A Δ D (steps.get u) s e)) ↪
      Fin (Fintype.card (FullMixedBirthAddress S B steps)) :=
  (fullMixedOwnerSampleOrder n S B A Δ D steps u s e).toEmbedding.trans
    (fullMixedOwnerCoordinateEmbedding n S B A Δ D steps u s e)

theorem full_mixed_owner_ordered_sample_strictMono :
    StrictMono (fullMixedOwnerOrderedSampleEmbedding n S B A Δ D steps u s e) :=
  finite_embedded_order_strictMono (fullMixedOwnerCoordinateEmbedding n S B A Δ D steps u s e)

theorem full_mixed_owner_ordered_sample_owner
    (i : Fin (Fintype.card (FullMixedEventBirthCoordinate n S B A Δ D (steps.get u) s e))) :
    fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps
      (fullMixedOwnerOrderedSampleEmbedding n S B A Δ D steps u s e i)) = u :=
  full_mixed_owner_coordinate_owner n S B A Δ D steps u s e _

end Order

section Path
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K)))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps s) (u : Fin steps.length)
    [Fintype (FullMixedEventBirthCoordinate n S B A Δ D (steps.get u)
      (fullMixedOwnerOccurrence n S B A Δ D steps s p u).1
      (fullMixedOwnerOccurrence n S B A Δ D steps s p u).2)]

theorem full_mixed_owner_ordered_sample_coverage
    (i : Fin (Fintype.card (FullMixedBirthAddress S B steps))) :
    (fullMixedPathBirthPerformed n S B A Δ D steps s p (fullMixedBirthOrder S B steps i) ∧
      fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i) = u) ↔
    i ∈ Set.range (fullMixedOwnerOrderedSampleEmbedding n S B A Δ D steps u
      (fullMixedOwnerOccurrence n S B A Δ D steps s p u).1
      (fullMixedOwnerOccurrence n S B A Δ D steps s p u).2) := by
  rw [full_mixed_owner_coordinate_coverage]
  constructor
  · rintro ⟨c, rfl⟩
    refine ⟨(fullMixedOwnerSampleOrder n S B A Δ D steps u _ _).symm c, ?_⟩
    change fullMixedOwnerCoordinateEmbedding n S B A Δ D steps u _ _
      ((fullMixedOwnerSampleOrder n S B A Δ D steps u _ _)
        ((fullMixedOwnerSampleOrder n S B A Δ D steps u _ _).symm c)) = _
    rw [Equiv.apply_symm_apply]
  · rintro ⟨j, rfl⟩
    exact ⟨(fullMixedOwnerSampleOrder n S B A Δ D steps u _ _) j, rfl⟩

end Path
end Bounty
end

section

/- A known event tag can use its actual local addresses at an arbitrary original schedule owner. -/

namespace Bounty

section Tagged
variable {J K : Type*} {N : ℕ} {M : Fin N → ℕ}
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (steps : List (Option (J ⊕ K))) (u : Fin steps.length)
    (tag : Option (J ⊕ K)) (htag : steps.get u = tag)

noncomputable def fullMixedTaggedOccurrenceEmbedding :
    FullMixedLocalBirthAddress S B tag ↪ Fin (Fintype.card (FullMixedBirthAddress S B steps)) :=
  (Equiv.cast (congrArg (FullMixedLocalBirthAddress S B) htag.symm)).toEmbedding.trans
    (fullMixedOccurrenceAddressEmbedding S B steps u)

theorem full_mixed_tagged_occurrence_owner (a : FullMixedLocalBirthAddress S B tag) :
    fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps
      (fullMixedTaggedOccurrenceEmbedding S B steps u tag htag a)) = u :=
  full_mixed_occurrence_address_owner S B steps u _

theorem full_mixed_tagged_occurrence_group (a : FullMixedLocalBirthAddress S B tag) :
    (fullMixedBirthOrder S B steps
      (fullMixedTaggedOccurrenceEmbedding S B steps u tag htag a)).2.1 = a.1 := by
  subst tag
  change (fullMixedBirthOrder S B steps ((fullMixedBirthOrder S B steps).symm ⟨u, a⟩)).2.1 = a.1
  rw [Equiv.apply_symm_apply]


theorem full_mixed_tagged_occurrence_range
    (i : Fin (Fintype.card (FullMixedBirthAddress S B steps))) :
    fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i) = u ↔
      ∃ a, fullMixedTaggedOccurrenceEmbedding S B steps u tag htag a = i := by
  constructor
  · intro hi
    subst tag
    generalize ha : fullMixedBirthOrder S B steps i = b at hi
    rcases b with ⟨v, a⟩
    have hv : v = u := by simpa only [fullMixedBirthOwner] using hi
    subst v
    refine ⟨a, ?_⟩
    change (fullMixedBirthOrder S B steps).symm ⟨u, a⟩ = i
    rw [← ha, Equiv.symm_apply_apply]
  · rintro ⟨a, rfl⟩
    exact full_mixed_tagged_occurrence_owner S B steps u tag htag a

end Tagged

section Path
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K))) (u : Fin steps.length)
    (tag : Option (J ⊕ K)) (htag : steps.get u = tag)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag s)

noncomputable def fullMixedTaggedOwnerEvent : FullPermutationMixedEvent n S B A Δ D (steps.get u) s :=
  cast (congrArg (fun tag => FullPermutationMixedEvent n S B A Δ D tag s) htag.symm) e

theorem full_mixed_tagged_owner_born_data
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x)
    (hocc : fullMixedOwnerOccurrence n S B A Δ D steps x p u =
      ⟨s, fullMixedTaggedOwnerEvent n S B A Δ D steps u tag htag s e⟩)
    (a : FullMixedLocalBirthAddress S B tag) :
    fullMixedPathBornData n S B A Δ D steps x p (fullMixedBirthOrder S B steps
      (fullMixedTaggedOccurrenceEmbedding S B steps u tag htag a)) =
      fullMixedEventBornData n S B A Δ D tag s e a := by
  subst tag
  change fullMixedPathBornData n S B A Δ D steps x p
    (fullMixedBirthOrder S B steps ((fullMixedBirthOrder S B steps).symm ⟨u, a⟩)) = _
  rw [Equiv.apply_symm_apply]
  unfold fullMixedPathBornData
  change fullMixedEventBornData n S B A Δ D (steps.get u)
    (fullMixedOwnerOccurrence n S B A Δ D steps x p u).1
    (fullMixedOwnerOccurrence n S B A Δ D steps x p u).2 a = _
  rw [hocc]
  rfl

theorem full_mixed_tagged_owner_birth_label
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x)
    (hocc : fullMixedOwnerOccurrence n S B A Δ D steps x p u =
      ⟨s, fullMixedTaggedOwnerEvent n S B A Δ D steps u tag htag s e⟩)
    (a : FullMixedLocalBirthAddress S B tag) :
    fullMixedPathBirthLabel n S B A Δ D steps x p (fullMixedBirthOrder S B steps
      (fullMixedTaggedOccurrenceEmbedding S B steps u tag htag a)) =
      fullMixedEventBirthLabel n S B A Δ D tag s e a := by
  unfold fullMixedPathBirthLabel fullMixedEventBirthLabel
  rw [full_mixed_tagged_owner_born_data n S B A Δ D steps u tag htag s e x p hocc a]


theorem full_mixed_tagged_owner_coordinate_coverage
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x)
    (hocc : fullMixedOwnerOccurrence n S B A Δ D steps x p u =
      ⟨s, fullMixedTaggedOwnerEvent n S B A Δ D steps u tag htag s e⟩)
    (i : Fin (Fintype.card (FullMixedBirthAddress S B steps))) :
    (fullMixedPathBirthPerformed n S B A Δ D steps x p (fullMixedBirthOrder S B steps i) ∧
      fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i) = u) ↔
    ∃ c : FullMixedEventBirthCoordinate n S B A Δ D tag s e,
      fullMixedTaggedOccurrenceEmbedding S B steps u tag htag
        (fullMixedBirthCoordinateEquiv n S B A Δ D tag s e c).val = i := by
  constructor
  · rintro ⟨hi, hu⟩
    obtain ⟨a, rfl⟩ := (full_mixed_tagged_occurrence_range S B steps u tag htag i).mp hu
    have ha : fullMixedEventBirthPerformed n S B A Δ D tag s e a := by
      unfold fullMixedPathBirthPerformed at hi
      rw [full_mixed_tagged_owner_born_data n S B A Δ D steps u tag htag s e x p hocc a] at hi
      exact hi
    refine ⟨(fullMixedBirthCoordinateEquiv n S B A Δ D tag s e).symm ⟨a, ha⟩, ?_⟩
    rw [Equiv.apply_symm_apply]
  · rintro ⟨c, rfl⟩
    refine ⟨?_, full_mixed_tagged_occurrence_owner S B steps u tag htag _⟩
    unfold fullMixedPathBirthPerformed
    rw [full_mixed_tagged_owner_born_data n S B A Δ D steps u tag htag s e x p hocc]
    exact (fullMixedBirthCoordinateEquiv n S B A Δ D tag s e c).property

end Path
end Bounty
end

section

/- Both forward and reverse eligibility rarity control the full nonclean
average, including arbitrary bounded coefficients. The factor four in
energy is the squared sum of the two square-root rarity bounds. -/

open Finset
open scoped Classical

namespace Bounty

section

variable {A G R : Type*} [Fintype A] [Fintype G] [Fintype R] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  (Δ D : A → G → ℤ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (t : G → ℕ) (B : ℕ) (π : A → ℝ) (τ : A → R ≃ R)

theorem unrestricted_dirty_external_average_norm_le
    (hπ : ∀ a, 0 ≤ π a) (hπmass : ∑ a, π a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, t g ≤ T) {δ : ℝ} (hδ : 0 ≤ δ)
    (hrareMinus : ∀ s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B,
      productTotalMemory s ≤ B →
      (∑ a, if ∃ g, (unrestrictedResidueEligible (n g) (-Δ a g) (D a g) (s g).2.2).Nonempty
        then π a else 0) ≤ δ)
    (hrarePlus : ∀ s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B,
      productTotalMemory s ≤ B →
      (∑ a, if ∃ g, (unrestrictedResidueEligible (n g) (Δ a g) (D a g) (s g).2.2).Nonempty
        then π a else 0) ≤ δ)
    (phase : ∀ a, R → UnrestrictedProductPhase n (Δ a) (D a) t B)
    (hphase : ∀ a r s e, ‖phase a r s e‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun j => UnrestrictedResidueParticle (n j)) t B → R → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun s => f s r)) :
    cleanWeightedNorm (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (unrestrictedDirtyExternalAverage n Δ D μ ρ V t B π τ phase f) ≤
      2 * Real.sqrt δ * Real.sqrt (unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G) *
        cleanWeightedNorm (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  have h := unrestricted_dirty_external_average_energy_le n Δ D μ ρ V t B π τ
    hπ hπmass hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht hδ hrareMinus hrarePlus phase hphase f hf
  apply clean_weighted_norm_le_of_external_energy _ (2 * Real.sqrt δ)
    (mul_nonneg (by norm_num) (Real.sqrt_nonneg _)) _
    (pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _) f
  calc
    _ ≤ _ := h
    _ = _ := by rw [mul_pow, Real.sq_sqrt hδ]; ring

end

end Bounty
end

section

/- Exact small bare / big memory factorization along a fixed original labeled path. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_group_path_mass_subtype_factors {G : Type*} {J : ℕ}
    (V : G → ℝ) (groups : Finset G) (C : ℕ → G → Finset (Fin J)) (ell n : ℕ) :
    physicalGroupPathMass V groups C ell n =
      physicalStateMass (fun g : {g // g ∈ groups} => V g.val) J ell *
        ∏ j ∈ range n, physicalCompletionMass (fun g : {g // g ∈ groups} => V g.val)
          (fun g => C j g.val) ell := by
  rw [physical_group_path_mass_factors]
  congr 1
  · exact prod_subtype groups (fun _ => Iff.rfl) _
  · apply prod_congr rfl
    intro j hj
    exact prod_subtype groups (fun _ => Iff.rfl) _

theorem physical_group_fixed_path_factor
    {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (small : Finset G) (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (ζ : ℕ → I → ℝ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (n : ℕ) :
    (physicalGroupPathMass V small (fun j => C (a j).2.2.1.val) ell n : ℂ) *
      physicalMemoryWalkScalar V patterns C ζ K a L n =
    (physicalStateMass (fun g : {g // g ∈ small} => V g.val) J ell : ℂ) *
      physicalBareWalkScalar (fun g : {g // g ∈ small} => V g.val) patterns
        (fun i g => C i g.val) (fun _ _ => 0) (fun _ _ _ _ _ => 1)
        (fun j => physicalRestrictedEdge (fun g => g ∈ small) patterns C (a j))
        (fun j g => L j g.val) n *
      ∏ j ∈ range n, physicalMemoryLabeledScalar (fun g : {g // g ∉ small} => V g.val)
        patterns (fun i g => C i g.val) (fun _ => 0)
        (physicalFixedEdgeBigCoefficient (fun g => g ∈ small) patterns C
          (ζ (n - 1 - j)) (K (n - 1 - j)) (a j) (L j) (L (j + 1)))
        (physicalRestrictedEdge (fun g => g ∉ small) patterns C (a j))
        (fun g => L j g.val) (fun g => L (j + 1) g.val) := by
  rw [physical_group_path_mass_subtype_factors]
  simp only [Complex.ofReal_mul, Complex.ofReal_prod, physicalMemoryWalkScalar,
    physicalBareWalkScalar]
  rw [mul_assoc, mul_assoc]
  congr 1
  rw [← prod_mul_distrib, ← prod_mul_distrib]
  apply prod_congr rfl
  intro j hj
  have h := physical_partial_memory_labeled_group_factor (fun g => g ∈ small)
    V patterns C (ζ (n - 1 - j)) (K (n - 1 - j)) (a j) (L j) (L (j + 1))
  convert h using 1 <;> congr!

theorem physical_fixed_edge_displacement_split
    {G I : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    (small : G → Prop) {patterns : Finset I} (C : I → G → Finset (Fin J))
    (k : I → ℤ) (a : PhysicalEdgeLabels P J ell patterns C)
    (L : PhysicalMarkLists P J ell) :
    physicalBareStep C k a L = k a.2.2.1.val *
      (physicalD (fun g : {g // small g} => C a.2.2.1.val g.val)
        (fun g => physicalPermuteLabels a.1 L g.val) (fun g => a.2.2.2 g.val) : ℕ) *
      (physicalD (fun g : {g // ¬small g} => C a.2.2.1.val g.val)
        (fun g => physicalPermuteLabels a.1 L g.val) (fun g => a.2.2.2 g.val) : ℕ) := by
  rw [physicalBareStep, physical_D_group_split small, Nat.cast_mul, mul_assoc]

end Bounty
end

section

/- A fixed stage support condition separates absent births from the actual sampled-label ties. -/

namespace Bounty

def birthForestStageSupport {N L : ℕ} (owner : Fin N → Fin L) (u : Fin L)
    (performed : Fin N → Prop) (code : BirthForestCode N) : Prop :=
  ∀ i, owner i = u → ∀ p, code i = some p →
    performed (birthForestParentEmbedding i p) ∧ performed i

theorem birth_forest_stage_support_iff {N L : ℕ} {α : Type*}
    (owner : Fin N → Fin L) (u : Fin L) (performed : Fin N → Prop)
    (values : Fin N → Option α) (code : BirthForestCode N)
    (hperformed : ∀ i, performed i ↔ (values i).isSome = true) :
    birthForestStageCondition owner u values code ↔
      birthForestStageSupport owner u performed code ∧
        ∀ i, owner i = u → ∀ p, code i = some p → values i = values (birthForestParentEmbedding i p) := by
  constructor
  · intro h
    constructor
    · intro i hi p hp
      have hc := h i hi
      rw [hp] at hc
      exact ⟨(hperformed _).mpr hc.1, (hperformed _).mpr hc.2.1⟩
    · intro i hi p hp
      have hc := h i hi
      rw [hp] at hc
      exact hc.2.2.symm
  · rintro ⟨hs, he⟩ i hi
    cases hc : code i with
    | none => trivial
    | some p =>
      exact ⟨(hperformed _).mp (hs i hi p hc).1,
        (hperformed _).mp (hs i hi p hc).2, (he i hi p hc).symm⟩

theorem birth_forest_stage_support_children {N L : ℕ}
    (owner : Fin N → Fin L) (u : Fin L) (performed : Fin N → Prop) (code : BirthForestCode N)
    (h : birthForestStageSupport owner u performed code) :
    ∀ i, owner i = u → code i ≠ none → performed i := by
  intro i hi hc
  cases hp : code i with
  | none => exact False.elim (hc hp)
  | some p => exact (h i hi p hp).2

theorem owner_stage_support_forest_iff {N m L : ℕ} {α : Type*}
    (embed : Fin m → Fin N) (hstrict : StrictMono embed)
    (owner : Fin N → Fin L) (hmono : Monotone owner) (u : Fin L)
    (howner : ∀ j, owner (embed j) = u) (performed : Fin N → Prop)
    (hcover : ∀ i, performed i → owner i = u → i ∈ Set.range embed)
    (code : BirthForestCode N) (values history : Fin N → Option α)
    (localValues : Fin m → α)
    (hperformed : ∀ i, performed i ↔ (values i).isSome = true)
    (hlocal : ∀ j, values (embed j) = some (localValues j))
    (hpast : ∀ i, owner i < u → values i = history i) :
    birthForestStageCondition owner u values code ↔
      birthForestStageSupport owner u performed code ∧
        birthForestEqualValues (restrictedBirthCode embed code) localValues ∧
          birthLabelsAnchored (fun j => (restrictedBirthAnchors embed code history j).join) localValues := by
  rw [birth_forest_stage_support_iff owner u performed values code hperformed]
  apply and_congr_right
  intro hs
  apply owner_optional_forest_past_iff embed hstrict owner hmono u howner performed hcover
    code values history localValues hlocal (birth_forest_stage_support_children owner u performed code hs)
    (fun j p hp => (hs (embed j) (howner j) p hp).1) _ hpast
  intro i hi hn
  have hv := (hperformed i).mp hi
  rw [hn] at hv
  cases hv

theorem restricted_join_selected_iff {N m : ℕ} {α : Type*}
    (embed : Fin m → Fin N) (code : BirthForestCode N) (history : Fin N → Option α)
    (hvalid : ∀ j, restrictedBirthAnchors embed code history j ≠ some none) (j : Fin m) :
    (restrictedBirthCode embed code j ≠ none ∨
      (restrictedBirthAnchors embed code history j).join ≠ none) ↔ code (embed j) ≠ none := by
  have ha : (restrictedBirthAnchors embed code history j).join ≠ none ↔
      restrictedBirthAnchors embed code history j ≠ none := by
    cases he : restrictedBirthAnchors embed code history j with
    | none => simp only [Option.join_none, ne_eq, not_true_eq_false]
    | some a =>
      cases a with
      | none => exact False.elim (hvalid j he)
      | some a => simp
  rw [ha]
  exact restricted_birth_selected_iff embed code history j

end Bounty
end

section

/- Uniform convergence of normalized ordinary-prime counts on logarithmic cells. -/

open Filter Real

namespace Bounty

theorem eventually_normalized_prime_cell_error {a S ε : ℝ}
    (ha : 0 < a) (hS : 0 ≤ S) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ w : ℝ, a ≤ w →
      |normalizedPrimeCellCount L S (exp (w*L))-1/w| ≤ ε := by
  filter_upwards [eventually_ordinary_prime_logarithmic_cell_relative_error
    ha hS (mul_pos hε ha), eventually_gt_atTop (0 : ℝ)] with L hraw hL
  intro w hw
  have hw0 : 0 < w := ha.trans_le hw
  have hscale := logarithmic_cell_count_scale_pos (S := S) hL (exp_pos (w*L))
  have hmain : (((exp (L^(-S))-1)*exp (w*L))/log (exp (w*L))) /
      logarithmicCellCountScale L S (exp (w*L)) = 1/w := by
    rw [log_exp]
    have hexp : exp (L^(-S))-1 ≠ 0 :=
      (sub_pos.mpr (one_lt_exp_iff.mpr (rpow_pos_of_pos hL _))).ne'
    unfold logarithmicCellCountScale
    field_simp [hL.ne', hw0.ne', hexp]
  have hh := hraw (exp (w*L)) (exp_le_exp.mpr (mul_le_mul_of_nonneg_right hw hL.le))
  calc
    _ = |((primeBand (exp (w*L)) (exp (L^(-S))*exp (w*L))).card : ℝ) -
          ((exp (L^(-S))-1)*exp (w*L))/log (exp (w*L))| /
          logarithmicCellCountScale L S (exp (w*L)) := by
      unfold normalizedPrimeCellCount
      rw [← hmain, ← sub_div, abs_div, abs_of_pos hscale]
    _ ≤ (ε*a) * ((((exp (L^(-S))-1)*exp (w*L))/log (exp (w*L))) /
          logarithmicCellCountScale L S (exp (w*L))) := by
      simpa only [mul_div_assoc] using div_le_div_of_nonneg_right hh hscale.le
    _ = ε*(a/w) := by rw [hmain]; ring
    _ ≤ ε := by
      apply mul_le_of_le_one_right hε.le
      exact (div_le_one hw0).mpr hw

end Bounty
end

section

/- Promotion support for the genuine mixed small/big model. Both endpoint
memory caps remain inside the full event weight, and the small labels remain
injective source lists. Eligibility is tested before auxiliary averaging. -/

open Finset
open scoped Classical

namespace Bounty

section

variable {S G : Type*} [Fintype S] [Fintype G] [dG : DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
  (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)

noncomputable def physicalSmallBigEligible
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)) : Prop :=
  ∃ g, (unrestrictedResidueEligible (n g)
    (Δ (physicalSharedPrefix s.1.2) (productActiveMemorySplit shared B s.2).1 g)
    (D (physicalSharedPrefix s.1.2) (productActiveMemorySplit shared B s.2).1 g)
    (s.2 g).2.2).Nonempty

omit [Fintype S] [Fintype G] [dG : DecidableEq G] [∀ g, Fintype (P g)] in
theorem physical_small_big_promoting_event_eligible
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (e : PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B Δ D) s)
    (he : ∃ g, (e.2.2 g).2.1.Nonempty) : physicalSmallBigEligible n shared B Δ D s := by
  obtain ⟨g, hg⟩ := he
  refine ⟨g, ?_⟩
  exact unrestricted_promoting_event_eligible (n g) _ _ (shared g)ᶜ.card B
    ((productActiveMemorySplit shared B s.2).2 g) (e.2.2 g) hg.ne_empty

theorem physical_small_big_promoting_zero
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (kbig : SharedActiveLabels P shared → ℤ) (Vs : S → ℝ) (q : ℝ)
    (Φ : ∀ s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B),
      PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B Δ D) s → ℂ)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (hno : ¬ physicalSmallBigEligible n shared B Δ D s) :
    physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q
      (fun s e => if ∃ g, (e.2.2 g).2.1.Nonempty then Φ s e else 0) F s = 0 := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  unfold physicalSmallBigFullPhasedAction physicalSmallBigPhasedAction
  apply sum_eq_zero
  intro e _
  have he : ¬ ∃ g, (e.2.2 g).2.1.Nonempty := fun h =>
    hno (physical_small_big_promoting_event_eligible n shared B Δ D s e h)
  simp only [if_neg he, mul_zero, zero_mul]

end

end Bounty
end

section

/- The literal mixed positive storage row transposes to reverse promotion.
The original small measure, both memory caps and all volume ratios are kept. -/

open Finset Classical

namespace Bounty

section

variable {S G : Type*} [Fintype S] [DecidableEq S] [Fintype G] [DecidableEq G]
  {Ps : S → Finset ℕ} [∀ p : PhysicalPrime Ps, NeZero p.2.val]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  {J ell : ℕ} {M : G → ℕ} (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
  (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
  (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (kbig : SharedActiveLabels P shared → ℤ)

noncomputable def physicalSmallBigStoragePhase
    (d : PhysicalSharedLists Ps J)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (_r : PhysicalResidues Ps) (e : PhysicalSmallBigFullEvent n shared B Δ D d x) : ℂ :=
  if (∀ g, (e.2 g).2.1 = ∅) ∧ (∃ g, (e.2 g).1 ≠ ∅) then 1 else 0

noncomputable def physicalSmallBigReversePhase
    (d : PhysicalSharedLists Ps J)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (_r : PhysicalResidues Ps)
    (e : PhysicalSmallBigFullEvent n shared B (fun d c g => -Δ d c g) D d x) : ℂ :=
  ((∏ g, V g ^ (e.2 g).2.1.card / V g ^ (e.2 g).1.card : ℝ) : ℂ) *
    (if (∀ g, (e.2 g).1 = ∅) ∧ (∃ g, (e.2 g).2.1 ≠ ∅) then 1 else 0)

noncomputable def physicalSmallBigStorageAction (Vs : S → ℝ) (q : ℝ)
    (aux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J)))) :=
  physicalSmallBigAction (ell := ell) Vs q 0 aux (fun _ => 1)
    (PhysicalSmallBigFullEvent n shared B Δ D) (physicalSmallBigFullTarget n shared B Δ D)
    (physicalSmallBigFullCoefficient n shared B Δ D μ ρ V (physicalSmallBigStoragePhase n shared B Δ D))
    (fun x => kbig (productActiveMemorySplit shared B x).1)

noncomputable def physicalSmallBigReverseAction (Vs : S → ℝ) (q : ℝ)
    (aux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J)))) :=
  physicalSmallBigAction (ell := ell) Vs q 0 aux (fun _ => 1)
    (PhysicalSmallBigFullEvent n shared B (fun d c g => -Δ d c g) D)
    (physicalSmallBigFullTarget n shared B (fun d c g => -Δ d c g) D)
    (physicalSmallBigFullCoefficient n shared B (fun d c g => -Δ d c g) D μ ρ V
      (physicalSmallBigReversePhase n shared B Δ D V))
    (fun x => -kbig (productActiveMemorySplit shared B x).1)

omit [DecidableEq S] [∀ p : PhysicalPrime Ps, NeZero p.2.val] [∀ g p, NeZero (n g p)] in
theorem physical_small_big_storage_prefix_eq
    (F : PhysicalSharedLists Ps J →
      ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → PhysicalResidues Ps → ℂ)
    (d : PhysicalSharedLists Ps J)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (r : PhysicalResidues Ps) :
    physicalSmallBigPrefixAction (PhysicalSmallBigFullEvent n shared B Δ D)
      (physicalSmallBigFullTarget n shared B Δ D)
      (physicalSmallBigFullCoefficient n shared B Δ D μ ρ V (physicalSmallBigStoragePhase n shared B Δ D))
      (fun y => kbig (productActiveMemorySplit shared B y).1) F d x r =
    fullActiveStorageExternal (A := fun _ => Unit) n shared B (fun c _ => Δ d c) (fun c _ => D d c) (fun _ _ => 1)
      μ ρ V (fun c _ => physicalResidueTranslationEquiv (P := Ps) (kbig c * (physicalSharedProduct d : ℕ)))
      (F d) x r := by
  rw [physical_small_big_full_prefix_eq, full_active_storage_external_eq_sum]
  rfl

omit [DecidableEq S] [∀ p : PhysicalPrime Ps, NeZero p.2.val] [∀ g p, NeZero (n g p)] in
theorem physical_small_big_reverse_prefix_eq
    (F : PhysicalSharedLists Ps J →
      ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → PhysicalResidues Ps → ℂ)
    (d : PhysicalSharedLists Ps J)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (r : PhysicalResidues Ps) :
    physicalSmallBigPrefixAction (PhysicalSmallBigFullEvent n shared B (fun d c g => -Δ d c g) D)
      (physicalSmallBigFullTarget n shared B (fun d c g => -Δ d c g) D)
      (physicalSmallBigFullCoefficient n shared B (fun d c g => -Δ d c g) D μ ρ V
        (physicalSmallBigReversePhase n shared B Δ D V))
      (fun y => -kbig (productActiveMemorySplit shared B y).1) F d x r =
    fullActiveReversePromotionExternal (A := fun _ => Unit) n shared B (fun c _ => Δ d c) (fun c _ => D d c) (fun _ _ => 1)
      μ ρ V (fun c _ => physicalResidueTranslationEquiv (P := Ps) (kbig c * (physicalSharedProduct d : ℕ)))
      (F d) x r := by
  rw [physical_small_big_full_prefix_eq n shared B (fun d c g => -Δ d c g) D μ ρ V
    (fun c => -kbig c) (physicalSmallBigReversePhase n shared B Δ D V) F d x r,
    full_active_reverse_promotion_external_eq_sum]
  have he : (fun c (_ : Unit) => physicalResidueTranslationEquiv (P := Ps)
      (-kbig c * (physicalSharedProduct d : ℕ))) =
      (fun c (_ : Unit) => (physicalResidueTranslationEquiv (P := Ps)
        (kbig c * (physicalSharedProduct d : ℕ))).symm) := by
    funext c u
    apply Equiv.ext
    intro r
    change physicalTranslateResidues r (-kbig c * (physicalSharedProduct d : ℕ)) =
      physicalTranslateResidues r (-(kbig c * (physicalSharedProduct d : ℕ)))
    rw [neg_mul]
  rw [he]
  rfl

theorem physical_small_big_storage_pairing
    (Vs : S → ℝ) (hVs : ∀ s, 0 < Vs s) (q : ℝ)
    (aux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J)))) (hV : ∀ g, V g ≠ 0)
    (u F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (hu : ∀ s, ProductMemorySymmetric (fun x => u (s,x)))
    (hF : ∀ s, ProductMemorySymmetric (fun x => F (s,x))) :
    (∑ s, (physicalSmallBigMeasure Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) s : ℂ) *
      u s * physicalSmallBigStorageAction n shared B Δ D μ ρ V kbig Vs q aux F s) =
    ∑ s, (physicalSmallBigMeasure Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) s : ℂ) *
      physicalSmallBigReverseAction n shared B Δ D μ ρ V kbig Vs q aux u s * F s := by
  apply physical_small_big_transpose_of_prefix_pairing Vs hVs q
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) aux
  intro d
  simp_rw [physical_small_big_storage_prefix_eq, physical_small_big_reverse_prefix_eq]
  exact full_active_storage_external_pairing (A := fun _ => Unit) n shared B (fun c _ => Δ d c) (fun c _ => D d c)
    (fun _ _ => 1) μ ρ V
    (fun c _ => physicalResidueTranslationEquiv (P := Ps) (kbig c * (physicalSharedProduct d : ℕ)))
    hV (physicalSmallBigCondition Vs q u d) (physicalSmallBigCondition Vs q F d)
    (fun r => physical_small_big_condition_memory_symmetric Vs q u hu d r)
    (fun r => physical_small_big_condition_memory_symmetric Vs q F hF d r)

end

end Bounty
end

section

/- Exact clean/dirty separation on the genuine mixed small-residue and
big-memory row. The coefficient can depend on both small endpoints and on
all big event choices; both memory cutoffs remain inside the event weight. -/

open Finset
open scoped Classical

namespace Bounty

section

variable {S X : Type*} [Fintype S]
  {P : S → Finset ℕ} {J ell : ℕ} (V : S → ℝ) (q : ℝ)
  (E : PhysicalSharedLists P J → X → Type*) [∀ d x, Fintype (E d x)]
  (target : ∀ d x, E d x → X)
  (a : PhysicalResidues P → ∀ d x, E d x → ℝ) (k : X → ℤ)

theorem physical_small_big_phased_add
    (Φ Ψ : ∀ s : PhysicalSmallBigState P J ell X, PhysicalSmallBigEvent E s → ℂ)
    (F : PhysicalSmallBigState P J ell X → ℂ) :
    physicalSmallBigPhasedAction V q E target a k (fun s e => Φ s e + Ψ s e) F =
      physicalSmallBigPhasedAction V q E target a k Φ F +
        physicalSmallBigPhasedAction V q E target a k Ψ F := by
  funext s
  simp only [physicalSmallBigPhasedAction, mul_add, add_mul, sum_add_distrib,
    Pi.add_apply]

theorem physical_small_big_phased_partition
    (Q : ∀ s : PhysicalSmallBigState P J ell X, PhysicalSmallBigEvent E s → Prop)
    (Φ : ∀ s : PhysicalSmallBigState P J ell X, PhysicalSmallBigEvent E s → ℂ)
    (F : PhysicalSmallBigState P J ell X → ℂ) :
    physicalSmallBigPhasedAction V q E target a k Φ F =
      physicalSmallBigPhasedAction V q E target a k
        (fun s e => if Q s e then Φ s e else 0) F +
      physicalSmallBigPhasedAction V q E target a k
        (fun s e => if Q s e then 0 else Φ s e) F := by
  rw [← physical_small_big_phased_add]
  congr 1
  funext s e
  split_ifs <;> simp

theorem physical_small_big_masked_norm_le_positive
    (hV : ∀ s, 0 < V s) (ha : ∀ r d x e, 0 ≤ a r d x e)
    (Q : ∀ s : PhysicalSmallBigState P J ell X, PhysicalSmallBigEvent E s → Prop)
    (Φ : ∀ s : PhysicalSmallBigState P J ell X, PhysicalSmallBigEvent E s → ℂ)
    (hΦ : ∀ s e, ‖Φ s e‖ ≤ 1)
    (F : PhysicalSmallBigState P J ell X → ℂ)
    (s : PhysicalSmallBigState P J ell X) :
    ‖physicalSmallBigPhasedAction V q E target a k
      (fun y e => if Q y e then Φ y e else 0) F s‖ ≤
    (physicalSmallBigPhasedAction V q E target a k
      (fun y e => if Q y e then 1 else 0) (complexNormEnvelope F) s).re := by
  unfold physicalSmallBigPhasedAction complexNormEnvelope
  exact finite_masked_event_norm_le_positive_re
    (physicalSmallBigPositiveWeight V q E a k s)
    (physical_small_big_positive_weight_nonneg V hV q E a ha k s)
    (Q s) (Φ s) (fun e => F (physicalSmallBigTarget E target k s e)) (hΦ s)

end

section

variable {S G : Type*} [Fintype S] [Fintype G] [dG : DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
  (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
  (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (kbig : SharedActiveLabels P shared → ℤ) (Vs : S → ℝ) (q : ℝ)

theorem physical_small_big_full_clean_split
    (Φ : ∀ s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B),
      PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B Δ D) s → ℂ)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ) :
    physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q Φ F =
      physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q
        (fun s e => if ∀ g, (e.2.2 g).1 = ∅ ∧ (e.2.2 g).2.1 = ∅ then Φ s e else 0) F +
      physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q
        (fun s e => if ∀ g, (e.2.2 g).1 = ∅ ∧ (e.2.2 g).2.1 = ∅ then 0 else Φ s e) F := by
  funext s
  simp only [physicalSmallBigFullPhasedAction, physicalSmallBigPhasedAction,
    Pi.add_apply, ← sum_add_distrib]
  apply sum_congr rfl
  intro e _
  split_ifs <;> simp

theorem physical_small_big_full_dirty_positive_split
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ) :
    physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q
      (fun _ e => if ¬ (∀ g, (e.2.2 g).1 = ∅ ∧ (e.2.2 g).2.1 = ∅) then 1 else 0) F =
    physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q
      (fun _ e => if ∃ g, (e.2.2 g).2.1.Nonempty then 1 else 0) F +
    physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q
      (fun _ e => if (∀ g, (e.2.2 g).2.1 = ∅) ∧ (∃ g, (e.2.2 g).1.Nonempty)
        then 1 else 0) F := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  unfold physicalSmallBigFullPhasedAction
  rw [← physical_small_big_phased_add]
  congr 1
  funext s e
  have h := finite_dirty_indicator (fun g => (e.2.2 g).1 = ∅) (fun g => (e.2.2 g).2.1 = ∅)
  simp only [Finset.nonempty_iff_ne_empty]
  convert h using 1 <;> split_ifs <;> rfl

end

end Bounty
end

section

/- The arbitrary-phase mixed action already enforces its source cap.
The uniform-average identity permits any finite enumeration of small-slot
permutations, including the enumeration in the omission probability law. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_small_big_average_uniform
    {S X : Type*} [Fintype S] [dS : DecidableEq S]
    {Ps : S → Finset ℕ} {J ell : ℕ}
    (fi : Fintype (PhysicalPermutations S J ell))
    (f : PhysicalSmallBigState Ps J ell X → ℂ) (s : PhysicalSmallBigState Ps J ell X) :
    physicalSmallBigAverage f s =
      ∑ σ ∈ fi.elems,
        ((1 / (@Fintype.card (PhysicalPermutations S J ell) fi : ℝ) : ℝ) : ℂ) *
          f (physicalSmallBigPermutation σ s) := by
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  let canon : Fintype (PhysicalPermutations S J ell) := Pi.instFintype
  rw [Subsingleton.elim fi canon]
  simp only [physicalSmallBigAverage, one_div, Complex.ofReal_inv,
    Complex.ofReal_natCast, mul_sum]
  rfl

section

variable {S G : Type*} [Fintype S] [Fintype G] [dG : DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
  (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
  (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (kbig : SharedActiveLabels P shared → ℤ) (Vs : S → ℝ) (q : ℝ)
  (Φ : ∀ s : PhysicalSmallBigState Ps J ell
    (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B),
    PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B Δ D) s → ℂ)
  (F : PhysicalSmallBigState Ps J ell
    (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)

theorem physical_small_big_full_phased_zero_above_cap
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (hs : ¬ productTotalMemory s.2 ≤ B) :
    physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q Φ F s = 0 := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  unfold physicalSmallBigFullPhasedAction physicalSmallBigPhasedAction
  apply sum_eq_zero
  intro e _
  simp only [physicalSmallBigPositiveWeight, physicalSmallBigFullWeight,
    fullActiveEdgeEventWeight, unrestrictedJointCutoffEventWeight,
    productActiveMemorySplit_total_memory, hs, false_and, if_false,
    mul_zero, ite_self, Complex.ofReal_zero, zero_mul]

theorem physical_small_big_full_phased_source_cap
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)) :
    physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q Φ F s =
      if productTotalMemory s.2 ≤ B then
        physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q Φ F s else 0 := by
  split_ifs with hs
  · rfl
  · exact physical_small_big_full_phased_zero_above_cap n shared B Δ D μ ρ V kbig Vs q Φ F s hs

end

end Bounty
end

section

/- At a fixed original auxiliary draw, the actual clean mixed row factors
through the original small conditioning and the literal capped big event
sum. The initial ledger tests only new fresh draws, never auxiliaries. -/

open Finset
open scoped Classical

namespace Bounty

section

variable {S G : Type*} [Fintype S] [Fintype G] [DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
  (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
  (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (kbig : SharedActiveLabels P shared → ℤ)

noncomputable def physicalSmallBigCleanInitialPhase
    (initial : ∀ g, Finset (P g))
    (Ψ : ∀ d x, PhysicalResidues Ps → PhysicalSmallBigFullEvent n shared B Δ D d x → ℂ)
    (d : PhysicalSharedLists Ps J)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (r : PhysicalResidues Ps) (e : PhysicalSmallBigFullEvent n shared B Δ D d x) : ℂ :=
  if (∀ g, (e.2 g).1 = ∅ ∧ (e.2 g).2.1 = ∅) ∧
      (∀ g i, (e.2 g).2.2.2 i ∉ initial g) then Ψ d x r e else 0

variable [dS : DecidableEq S] [∀ p : PhysicalPrime Ps, NeZero p.2.val]
  [∀ g p, NeZero (n g p)]

theorem physical_small_big_clean_initial_pairing
    (Vs : S → ℝ) (hVs : ∀ s, 0 < Vs s) (q : ℝ)
    (W : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℝ)
    (aux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))))
    (initial : ∀ g, Finset (P g))
    (Ψ : ∀ d x, PhysicalResidues Ps → PhysicalSmallBigFullEvent n shared B Δ D d x → ℂ)
    (sourceGate targetGate u F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ) :
    (∑ s, (physicalSmallBigMeasure Vs W s : ℂ) * (starRingEnd ℂ) (u s) *
      physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q
        (physicalSmallBigEndpointPhase (PhysicalSmallBigFullEvent n shared B Δ D)
          (physicalSmallBigFullTarget n shared B Δ D)
          (fun r d x e => physicalSmallBigCleanInitialPhase n shared B Δ D initial Ψ d x r e)
          (fun x => kbig (productActiveMemorySplit shared B x).1) sourceGate targetGate) F s) =
      ∑ d, ∑ r, ∑ x, (W x : ℂ) *
        (starRingEnd ℂ) (physicalSmallBigCondition Vs q (fun s => sourceGate s * u s) d x r) *
        fullActiveExternalCoefficientAction n shared B (fun _ => Unit)
          (fun c _ => Δ d c) (fun c _ => D d c) (fun _ _ => 1) μ ρ V
          (fun c _ => physicalResidueTranslationEquiv (P := Ps)
            (kbig c * (physicalSharedProduct d : ℕ)))
          (physicalSmallBigCleanInitialPhase n shared B Δ D initial Ψ d)
          (physicalSmallBigCondition Vs q (fun s => targetGate s * F s) d) x r := by
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  have h := physical_small_big_gated_pairing Vs hVs q W aux
    (PhysicalSmallBigFullEvent n shared B Δ D) (physicalSmallBigFullTarget n shared B Δ D)
    (physicalSmallBigFullWeight n shared B Δ D μ ρ V)
    (fun r d x e => physicalSmallBigCleanInitialPhase n shared B Δ D initial Ψ d x r e)
    (fun x => kbig (productActiveMemorySplit shared B x).1) sourceGate targetGate u F
  change _ = ∑ d, ∑ r, ∑ x, (W x : ℂ) *
    (starRingEnd ℂ) (physicalSmallBigCondition Vs q (fun s => sourceGate s * u s) d x r) *
    physicalSmallBigPrefixAction (PhysicalSmallBigFullEvent n shared B Δ D)
      (physicalSmallBigFullTarget n shared B Δ D)
      (physicalSmallBigFullCoefficient n shared B Δ D μ ρ V
        (physicalSmallBigCleanInitialPhase n shared B Δ D initial Ψ))
      (fun x => kbig (productActiveMemorySplit shared B x).1)
      (physicalSmallBigCondition Vs q (fun s => targetGate s * F s)) d x r at h
  simp_rw [physical_small_big_full_prefix_eq] at h
  exact h

end

end Bounty
end

section

/- Cauchy energy on larger smooth-cutoff ranges retains the original outside factor. -/

open Finset

namespace Bounty

theorem typeII_energy_enlarge (E₀ N₀ E N M H : Finset ℕ)
    (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ) (hE : E₀⊆E) (hN : N₀⊆N)
    (hη : ∀ e∈E, ∀ n∈N, 0≤η e n) :
    (∑ e∈E₀, ∑ n∈N₀, η e n*‖typeIIInnerSum M H α aH e n‖^2) ≤
      ∑ e∈E, ∑ n∈N, η e n*‖typeIIInnerSum M H α aH e n‖^2 := by
  calc
    _ ≤ ∑ e∈E₀, ∑ n∈N, η e n*‖typeIIInnerSum M H α aH e n‖^2 := by
      apply sum_le_sum
      intro e he
      exact sum_le_sum_of_subset_of_nonneg hN (fun n hn _ =>
        mul_nonneg (hη e (hE he) n hn) (sq_nonneg _))
    _ ≤ _ := sum_le_sum_of_subset_of_nonneg hE (fun e he _ =>
      sum_nonneg (fun n hn => mul_nonneg (hη e he n hn) (sq_nonneg _)))

theorem typeII_cauchy_enlarged_majorant (E₀ N₀ E N M H : Finset ℕ)
    (aE β α aH : ℕ → ℂ) (η : ℕ → ℕ → ℝ) (hEE : E₀⊆E) (hNN : N₀⊆N)
    (hE : ∀ e∈E, 0<e) (hη : ∀ e∈E, ∀ n∈N, 0≤η e n)
    (hη₀ : ∀ e∈E₀, ∀ n∈N₀, 1≤η e n) :
    ‖∑ e∈E₀, ∑ n∈N₀, aE e*β n*typeIIInnerSum M H α aH e n‖^2 ≤
      ((∑ e∈E₀, ‖aE e‖^2)*(∑ n∈N₀, ‖β n‖^2))*
        (typeIIDiagonalEnergy E N M H η α aH+typeIIOffDiagonalEnergy E N M H η α aH) := by
  rw [← typeII_energy_split E N M H η α aH hE]
  exact (typeII_cauchy_majorant E₀ N₀ M H aE β α aH η hη₀).trans
    (mul_le_mul_of_nonneg_left (typeII_energy_enlarge E₀ N₀ E N M H η α aH hEE hNN hη)
      (by positivity))

end Bounty
end

section

/- Finite determinant reindexing of the actual Type-II off-diagonal energy. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

abbrev TypeIIOffIndex := (ℕ × ℕ) × ((ℕ × ℕ) × (ℕ × ℕ))
abbrev TypeIIShiftIndex := (ℤ × ℕ) × ((ℕ × ℕ) × (ℕ × ℕ))

noncomputable def typeIIOffDiagonalSupport (E N M H : Finset ℕ) : Finset TypeIIOffIndex :=
  ((E ×ˢ N) ×ˢ ((M ×ˢ H) ×ˢ (M ×ˢ H))).filter (fun x =>
    x.2.1.1 ≠ x.2.2.1 ∧ x.2.1.1 * x.1.2 = 2 * x.1.1 * x.2.1.2 + 1 ∧
      x.2.2.1 * x.1.2 = 2 * x.1.1 * x.2.2.2 + 1)

noncomputable def typeIIOffCoefficient (α aH : ℕ → ℂ) (v w : ℕ × ℕ) : ℝ :=
  (α v.1 * conj (α w.1) * aH v.2 * conj (aH w.2)).re

def typeIIShiftMap (x : TypeIIOffIndex) : TypeIIShiftIndex :=
  (((x.2.1.1 : ℤ) * x.2.2.2 - (x.2.2.1 : ℤ) * x.2.1.2, x.2.2.1 * x.2.1.2), x.2)

def typeIIRecoveredE (y : TypeIIShiftIndex) : ℤ :=
  ((y.2.2.1 : ℤ) - y.2.1.1) / (2 * y.1.1)

def typeIIRecoveredN (y : TypeIIShiftIndex) : ℤ :=
  (2 * typeIIRecoveredE y * y.2.1.2 + 1) / y.2.1.1

def typeIIRecoveredIndex (y : TypeIIShiftIndex) : TypeIIOffIndex :=
  ((typeIIRecoveredE y |>.toNat, typeIIRecoveredN y |>.toNat), y.2)

noncomputable def typeIIShiftWeight (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ)
    (y : TypeIIShiftIndex) : ℝ :=
  η (typeIIRecoveredE y).toNat (typeIIRecoveredN y).toNat * typeIIOffCoefficient α aH y.2.1 y.2.2

theorem mem_typeII_off_diagonal_support {E N M H : Finset ℕ} {x : TypeIIOffIndex} :
    x ∈ typeIIOffDiagonalSupport E N M H ↔
      x.1.1 ∈ E ∧ x.1.2 ∈ N ∧ x.2.1.1 ∈ M ∧ x.2.1.2 ∈ H ∧
      x.2.2.1 ∈ M ∧ x.2.2.2 ∈ H ∧ x.2.1.1 ≠ x.2.2.1 ∧
      x.2.1.1 * x.1.2 = 2 * x.1.1 * x.2.1.2 + 1 ∧
      x.2.2.1 * x.1.2 = 2 * x.1.1 * x.2.2.2 + 1 := by
  simp only [typeIIOffDiagonalSupport, mem_filter, mem_product]
  tauto

theorem typeII_off_support_positive {E N M H : Finset ℕ} {x : TypeIIOffIndex}
    (hx : x ∈ typeIIOffDiagonalSupport E N M H) :
    0 < x.1.1 ∧ 0 < x.1.2 ∧ 0 < x.2.1.1 ∧ 0 < x.2.2.1 := by
  obtain ⟨he, hn, hm, hh, hm', hh', hne, hfirst, hsecond⟩ := mem_typeII_off_diagonal_support.mp hx
  have hn0 : x.1.2 ≠ 0 := by intro hz; simp [hz] at hfirst
  have hm0 : x.2.1.1 ≠ 0 := by intro hz; simp [hz] at hfirst
  have hm'0 : x.2.2.1 ≠ 0 := by intro hz; simp [hz] at hsecond
  refine ⟨?_, Nat.pos_of_ne_zero hn0, Nat.pos_of_ne_zero hm0, Nat.pos_of_ne_zero hm'0⟩
  by_contra h
  have he0 : x.1.1 = 0 := by omega
  simp only [he0, mul_zero, zero_mul, zero_add] at hfirst hsecond
  have hm1 := Nat.eq_one_of_mul_eq_one_right hfirst
  have hm'1 := Nat.eq_one_of_mul_eq_one_right hsecond
  exact hne (hm1.trans hm'1.symm)

theorem typeII_off_diagonal_energy_eq_support (E N M H : Finset ℕ)
    (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ) :
    typeIIOffDiagonalEnergy E N M H η α aH =
      ∑ x ∈ typeIIOffDiagonalSupport E N M H,
        η x.1.1 x.1.2 * typeIIOffCoefficient α aH x.2.1 x.2.2 := by
  classical
  unfold typeIIOffDiagonalEnergy typeIIOffDiagonalSupport
  simp only [sum_filter, sum_product, mul_sum]
  apply sum_congr rfl
  intro e he
  apply sum_congr rfl
  intro n hn
  apply sum_congr rfl
  intro m hm
  apply sum_congr rfl
  intro h hh
  apply sum_congr rfl
  intro m' hm'
  apply sum_congr rfl
  intro h' hh'
  by_cases hoff : m ≠ m'
  · by_cases hfirst : m * n = 2 * e * h + 1
    · by_cases hsecond : m' * n = 2 * e * h' + 1
      · simp [hoff, hfirst, hsecond, typeIIEquationTerm, typeIIOffCoefficient,
          map_mul, mul_assoc, mul_left_comm, mul_comm]
      · simp [hoff, hfirst, hsecond, typeIIEquationTerm]
    · simp [hoff, hfirst, typeIIEquationTerm]
  · simp [hoff]

theorem typeII_recovered_quotients {E N M H : Finset ℕ} {x : TypeIIOffIndex}
    (hx : x ∈ typeIIOffDiagonalSupport E N M H) :
    typeIIRecoveredE (typeIIShiftMap x) = (x.1.1 : ℤ) ∧
      typeIIRecoveredN (typeIIShiftMap x) = (x.1.2 : ℤ) := by
  obtain ⟨he, hn, hm, hh, hm', hh', hne, hfirst, hsecond⟩ := mem_typeII_off_diagonal_support.mp hx
  have hpos := typeII_off_support_positive hx
  obtain ⟨k, hk, huniq⟩ := typeII_determinant_unique_nat hfirst hsecond hne
  have heq : typeIIRecoveredE (typeIIShiftMap x) = (x.1.1 : ℤ) := by
    unfold typeIIRecoveredE typeIIShiftMap
    dsimp
    rw [hk.2.2.2]
    exact typeII_determinant_e_quotient hk.1 hk.2.1
  have hnq : typeIIRecoveredN (typeIIShiftMap x) = (x.1.2 : ℤ) := by
    unfold typeIIRecoveredN
    rw [heq]
    exact typeII_determinant_n_quotient (by exact_mod_cast hpos.2.2.1.ne') (by exact_mod_cast hfirst)
  exact ⟨heq, hnq⟩

theorem typeII_recovered_shift_map {E N M H : Finset ℕ} {x : TypeIIOffIndex}
    (hx : x ∈ typeIIOffDiagonalSupport E N M H) :
    typeIIRecoveredIndex (typeIIShiftMap x) = x := by
  obtain ⟨heq, hnq⟩ := typeII_recovered_quotients hx
  apply Prod.ext
  · apply Prod.ext <;> simp [typeIIRecoveredIndex, heq, hnq]
  · rfl

theorem typeII_shift_map_injective (E N M H : Finset ℕ) :
    Set.InjOn typeIIShiftMap (typeIIOffDiagonalSupport E N M H) := by
  intro x hx y hy hxy
  calc
    x = typeIIRecoveredIndex (typeIIShiftMap x) := (typeII_recovered_shift_map hx).symm
    _ = typeIIRecoveredIndex (typeIIShiftMap y) := congrArg typeIIRecoveredIndex hxy
    _ = y := typeII_recovered_shift_map hy

theorem typeII_shift_weight_map {E N M H : Finset ℕ} {x : TypeIIOffIndex}
    (hx : x ∈ typeIIOffDiagonalSupport E N M H) (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ) :
    typeIIShiftWeight η α aH (typeIIShiftMap x) =
      η x.1.1 x.1.2 * typeIIOffCoefficient α aH x.2.1 x.2.2 := by
  have hr := congrArg Prod.fst (typeII_recovered_shift_map hx)
  have he := congrArg (fun z : ℕ × ℕ => z.1) hr
  have hn := congrArg (fun z : ℕ × ℕ => z.2) hr
  unfold typeIIShiftWeight
  change (typeIIRecoveredE (typeIIShiftMap x)).toNat = x.1.1 at he
  change (typeIIRecoveredN (typeIIShiftMap x)).toNat = x.1.2 at hn
  rw [he, hn]
  rfl

theorem typeII_off_diagonal_energy_eq_shift_image (E N M H : Finset ℕ)
    (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ) :
    typeIIOffDiagonalEnergy E N M H η α aH =
      ∑ y ∈ (typeIIOffDiagonalSupport E N M H).image typeIIShiftMap,
        typeIIShiftWeight η α aH y := by
  rw [sum_image (typeII_shift_map_injective E N M H)]
  rw [typeII_off_diagonal_energy_eq_support]
  apply sum_congr rfl
  intro x hx
  exact (typeII_shift_weight_map hx η α aH).symm

end Bounty

end

section

/- Literal finite events on the genuine mixed state. Edges move both small
residues and small injective lists; visits change only big pending memory.
The auxiliary draw and both independent active permutation choices remain
part of each event. -/

open Finset
open scoped Classical

namespace Bounty

section
variable {H K S G : Type} {Ps : S → Finset ℕ} {P : G → Type}
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : K → ∀ g, Finset (Fin (M g))) (B : ℕ) (A : K → Type)
  (Δ D : ∀ k, PhysicalSharedLists Ps J → SharedActiveLabels P (shared k) → A k → G → ℤ)

def PhysicalSmallBigPathEvent : Option (H ⊕ K) →
    PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → Type _
  | none, _ => PhysicalPermutations S J ell × FullActiveSlotPermutations M
  | some (.inl _), s => CoupledGhostEvent M B s.2
  | some (.inr k), s => PhysicalMarkLists Ps J ell ×
      FullActiveEdgeEvent n (shared k) B (fun _ => A k)
        (Δ k (physicalSharedPrefix s.1.2)) (D k (physicalSharedPrefix s.1.2)) s.2

noncomputable abbrev physicalSmallBigPathEventFintype [Fintype S] [Fintype G]
    [∀ g, Fintype (P g)] [∀ g p, NeZero (n g p)] [∀ k, Fintype (A k)]
    (tag : Option (H ⊕ K))
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)) :
    Fintype (PhysicalSmallBigPathEvent n shared B A Δ D tag s) := by
  cases tag with
  | none => dsimp [PhysicalSmallBigPathEvent]; infer_instance
  | some tag => cases tag <;> dsimp [PhysicalSmallBigPathEvent] <;> infer_instance

variable [Fintype S]
  (kbig : ∀ k, SharedActiveLabels P (shared k) → A k → ℤ)

noncomputable def physicalSmallBigPathEventTarget (tag : Option (H ⊕ K))
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)) :
    PhysicalSmallBigPathEvent n shared B A Δ D tag s →
      PhysicalSmallBigState Ps J ell
        (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :=
  match tag with
  | none => fun e => ((s.1.1, physicalPermuteLabels e.1 s.1.2), fullActivePermutation e.2 s.2)
  | some (.inl _) => fun e => (s.1, coupledGhostJointEventTarget M B s.2 e)
  | some (.inr k) => fun e =>
      ((physicalTranslateResidues s.1.1
          (kbig k (productActiveMemorySplit (shared k) B s.2).1 e.2.1 *
            (physicalSharedProduct (physicalSharedPrefix s.1.2) : ℕ)), e.1),
        fullActiveEdgeEventTarget n (shared k) B (fun _ => A k)
          (Δ k (physicalSharedPrefix s.1.2)) (D k (physicalSharedPrefix s.1.2)) s.2 e.2)

variable [Fintype G]
  (ω : ∀ k, A k → ℝ) (μ : ∀ g, P g → ℝ)
  (qghost : H → ℝ) (ρ : ℝ) (V : G → ℝ) (Vs : S → ℝ) (qsmall : ℝ)

noncomputable def physicalSmallBigPathEventWeight (tag : Option (H ⊕ K))
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)) :
    PhysicalSmallBigPathEvent n shared B A Δ D tag s → ℝ :=
  match tag with
  | none => fun e => (Fintype.card (PhysicalPermutations S J ell) : ℝ)⁻¹ *
      fullActivePermutationWeight M e.2
  | some (.inl j) => fun e => coupledGhostJointEventWeight
      (fun g => physicalGhostRetention (n g) (qghost j) ρ)
      (fun g => physicalGhostTermination (n g) (qghost j) ρ)
      (fun g => physicalGhostBirth (n g) (qghost j) ρ (V g))
      (fun g => unrestrictedResidueWeight (μ g)) M B s.2 e
  | some (.inr k) => fun e =>
      (if physicalSharedPrefix s.1.2 = physicalSharedPrefix e.1 then
        physicalCompletionMass Vs (fun _ => (∅ : Finset (Fin J))) ell *
          (physicalResidueVertexWeight s.1.2 (Real.sqrt qsmall) s.1.1 *
            physicalResidueVertexWeight e.1 (Real.sqrt qsmall)
              (physicalTranslateResidues s.1.1
                (kbig k (productActiveMemorySplit (shared k) B s.2).1 e.2.1 *
                  (physicalSharedProduct (physicalSharedPrefix s.1.2) : ℕ))))
       else 0) *
        fullActiveEdgeEventWeight n (shared k) B (fun _ => A k)
          (Δ k (physicalSharedPrefix s.1.2)) (D k (physicalSharedPrefix s.1.2))
          (fun _ a => ω k a) μ ρ V s.2 e.2

end
end Bounty
end

section

/- Genuine mixed rows preserve big pending-memory symmetry for signed phases
invariant under the complete old-index event correspondence. Both small
endpoints and every active/fresh observation may enter the coefficient. -/

open Finset Classical

namespace Bounty

section
variable {S G : Type*} [Fintype S] [Fintype G] [dG : DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  {J ell : ℕ} {M : G → ℕ} (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
  (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
  (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (kbig : SharedActiveLabels P shared → ℤ)

noncomputable def physicalSmallBigEventMemoryReindex
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (τ : ∀ g, Equiv.Perm (Fin (s.2 g).2.1.val)) :
    PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B Δ D) s ≃
      PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B Δ D)
        (s.1, productMemoryReindex s.2 τ) :=
  Equiv.prodCongr (Equiv.refl _) (fullEdgeMemoryReindex n shared B (fun _ => Unit)
    (fun c _ => Δ (physicalSharedPrefix s.1.2) c)
    (fun c _ => D (physicalSharedPrefix s.1.2) c) s.2 τ)

omit dG in
theorem physical_small_big_reindex_weight (Vs : S → ℝ) (q : ℝ)
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (τ : ∀ g, Equiv.Perm (Fin (s.2 g).2.1.val))
    (e : PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B Δ D) s) :
    physicalSmallBigPositiveWeight Vs q (PhysicalSmallBigFullEvent n shared B Δ D)
      (physicalSmallBigFullWeight n shared B Δ D μ ρ V)
      (fun x => kbig (productActiveMemorySplit shared B x).1)
      (s.1, productMemoryReindex s.2 τ) (physicalSmallBigEventMemoryReindex n shared B Δ D s τ e) =
    physicalSmallBigPositiveWeight Vs q (PhysicalSmallBigFullEvent n shared B Δ D)
      (physicalSmallBigFullWeight n shared B Δ D μ ρ V)
      (fun x => kbig (productActiveMemorySplit shared B x).1) s e := by
  exact congrArg (fun w : ℝ =>
    if physicalSharedPrefix s.1.2 = physicalSharedPrefix e.1 then
      physicalCompletionMass Vs (fun _ => (∅ : Finset (Fin J))) ell *
        (physicalResidueVertexWeight s.1.2 (Real.sqrt q) s.1.1 *
          physicalResidueVertexWeight e.1 (Real.sqrt q) (physicalTranslateResidues s.1.1
            (kbig (productActiveMemorySplit shared B s.2).1 *
              (physicalSharedProduct (physicalSharedPrefix s.1.2) : ℕ)))) * w else 0)
    (full_edge_reindex_weight n shared B (fun _ => Unit)
      (fun c _ => Δ (physicalSharedPrefix s.1.2) c)
      (fun c _ => D (physicalSharedPrefix s.1.2) c) s.2 τ (fun _ _ => 1) μ ρ V e.2)

theorem physical_small_big_reindex_test
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (τ : ∀ g, Equiv.Perm (Fin (s.2 g).2.1.val))
    (e : PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B Δ D) s)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (hF : ∀ z, ProductMemorySymmetric (fun x => F (z,x))) :
    F (physicalSmallBigTarget (PhysicalSmallBigFullEvent n shared B Δ D)
      (physicalSmallBigFullTarget n shared B Δ D)
      (fun x => kbig (productActiveMemorySplit shared B x).1)
      (s.1, productMemoryReindex s.2 τ) (physicalSmallBigEventMemoryReindex n shared B Δ D s τ e)) =
    F (physicalSmallBigTarget (PhysicalSmallBigFullEvent n shared B Δ D)
      (physicalSmallBigFullTarget n shared B Δ D)
      (fun x => kbig (productActiveMemorySplit shared B x).1) s e) := by
  exact full_edge_reindex_test n shared B (fun _ => Unit)
    (fun c _ => Δ (physicalSharedPrefix s.1.2) c)
    (fun c _ => D (physicalSharedPrefix s.1.2) c) s.2 τ e.2
    (fun y => F ((physicalTranslateResidues s.1.1
      (kbig (productActiveMemorySplit shared B s.2).1 *
        (physicalSharedProduct (physicalSharedPrefix s.1.2) : ℕ)), e.1), y)) (hF _)

theorem physical_small_big_full_signed_memory_symmetric (Vs : S → ℝ) (q : ℝ)
    (Φ : ∀ s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B),
      PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B Δ D) s → ℂ)
    (hΦ : ∀ (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
      (τ : ∀ g, Equiv.Perm (Fin (s.2 g).2.1.val))
      (e : PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B Δ D) s),
      Φ (s.1, productMemoryReindex s.2 τ)
        (physicalSmallBigEventMemoryReindex n shared B Δ D s τ e) = Φ s e)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (hF : ∀ z, ProductMemorySymmetric (fun x => F (z,x))) :
    ∀ z, ProductMemorySymmetric (fun x =>
      physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q Φ F (z,x)) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  intro z x g τ
  dsimp only
  refine (congrArg (fun y => physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q Φ F (z,y))
    (product_memory_reindex_at x g τ)).symm.trans ?_
  unfold physicalSmallBigFullPhasedAction physicalSmallBigPhasedAction
  rw [← (physicalSmallBigEventMemoryReindex n shared B Δ D (z,x)
    (Function.update (fun h => Equiv.refl (Fin (x h).2.1.val)) g τ)).sum_comp]
  apply sum_congr rfl
  intro e _
  let σ := Function.update (fun h => Equiv.refl (Fin (x h).2.1.val)) g τ
  have hw := physical_small_big_reindex_weight n shared B Δ D μ ρ V kbig Vs q (z,x) σ e
  have hp := hΦ (z,x) σ e
  have ht := physical_small_big_reindex_test n shared B Δ D kbig (z,x) σ e F hF
  exact congrArg₂ (fun a b : ℂ => a * b)
    (congrArg₂ (fun a b : ℂ => a * b) (congrArg Complex.ofReal hw) hp) ht

noncomputable def physicalSmallBigObservablePhase
    (Φ : PhysicalBareResidueState Ps J ell → PhysicalBareResidueState Ps J ell →
      (∀ g, Fin (M g) → P g) → (∀ g, Fin (M g) → P g) →
      (∀ g, EdgeDrawObservation (P g) (shared g)ᶜ.card) → ℂ)
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (e : PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B Δ D) s) : ℂ :=
  Φ s.1 (physicalSmallBigTarget (PhysicalSmallBigFullEvent n shared B Δ D)
    (physicalSmallBigFullTarget n shared B Δ D)
    (fun x => kbig (productActiveMemorySplit shared B x).1) s e).1
    (fun g => (s.2 g).1) (fun g => (physicalSmallBigFullTarget n shared B Δ D
      (physicalSharedPrefix s.1.2) s.2 e.2 g).1)
    (fun g => ⟨(e.2.2 g).1, (e.2.2 g).2.1, (e.2.2 g).2.2.2⟩)

omit [Fintype G] dG in
theorem physical_small_big_observable_phase_reindex
    (Φ : PhysicalBareResidueState Ps J ell → PhysicalBareResidueState Ps J ell →
