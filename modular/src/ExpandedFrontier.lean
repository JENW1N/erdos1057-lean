      Vedge Vghost Vs qsmall) steps phase f

theorem physical_small_big_varying_ghost_action_same (steps : List (Option (H ⊕ K)))
    (phase : ∀ s, PhysicalSmallBigPath n shared B A Δ D kbig steps s → ℂ)
    (f : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ) :
    physicalSmallBigPathVaryingGhostAction n shared B A Δ D kbig ω μ qghost ρ
      Vedge Vedge Vs qsmall steps phase f =
    physicalSmallBigPathAction n shared B A Δ D kbig ω μ qghost ρ
      Vedge Vs qsmall steps phase f := by
  have hw : physicalSmallBigPathVaryingGhostWeight (J := J) (ell := ell) n shared B A Δ D kbig
      ω μ qghost ρ Vedge Vedge Vs qsmall =
      physicalSmallBigPathEventWeight (J := J) (ell := ell) n shared B A Δ D kbig
        ω μ qghost ρ Vedge Vs qsmall := by
    funext tag s e
    exact physical_small_big_varying_ghost_weight_same n shared B A Δ D kbig
      ω μ qghost ρ Vedge Vs qsmall tag s e
  unfold physicalSmallBigPathVaryingGhostAction physicalSmallBigPathAction
  rw [hw]

theorem physical_small_big_varying_ghost_path_norm_le_positive_list
    (steps : List (Option (H ⊕ K)))
    (phase : ∀ s, PhysicalSmallBigPath n shared B A Δ D kbig steps s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1)
