/- The exact retained-support harmonic target controls the normalized truncated energy. -/

open Finset Filter MeasureTheory

namespace Bounty

noncomputable def typeIIRetainedHarmonicCorrelation (Z : ℝ) (k : ℤ) (M H : Finset ℕ)
    (α : ℕ → ℂ) (W : ℕ → ℝ) (B : ℕ → ℂ) (ρ : ℝ)
    (χ : DirichletCharacter ℂ (2*k.natAbs)) (ξ : EuclideanSpace ℝ (Fin 3)) : ℂ :=
  let M₀ := M.filter (fun m => α m ≠ 0)
  let Zs := Icc 0 (M₀.sup id * H.sup id)
  ∑ z ∈ typeIIActiveCrossZ Z k Zs,
    ((typeIIHarmonicDyadic ((z:ℝ)/Z)/(z:ℝ) : ℝ):ℂ) *
      typeIICrossPairCoefficient M₀ H (fun m => α m * χ (m : ZMod (2*k.natAbs))) W B ρ
        (2*Real.pi*ξ 0) (2*Real.pi*ξ 1) (2*Real.pi*ξ 2) z ((z:ℤ)+k).toNat

theorem eventually_typeII_energy_le_of_retained_harmonic_bound {K : ℝ} :
    ∃ C : ℝ, 0 < C ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (U V E : ℝ) (N : ℕ) (M H : Finset ℕ)
        (α : ℕ → ℂ) (W : ℕ → ℝ) (B : ℕ → ℂ) (ρ Q : ℝ)
        (T : Set (EuclideanSpace ℝ (Fin 3))),
      0 < U → 0 < V → E=U*L^(-K) → 1 ≤ U*V →
      (∀ m ∈ M, 0 < m) → (∀ h ∈ H, 0 < h) → MeasurableSet T →
      (∀ k ∈ Icc (-(N:ℤ)) N, k ≠ 0 → ∀ j ∈ range (typeIISmoothDyadicCount L),
        ∀ χ : DirichletCharacter ℂ (2*k.natAbs), ∀ ξ ∈ T,
        ‖typeIIRetainedHarmonicCorrelation (typeIISmoothDyadicScale U V E j)
          k M H α W B ρ χ ξ‖ ≤ L^(-Q)) →
      ‖typeIIEnergyFourierIntegral L U V E N M H α (typeIISeparatedH W B ρ) T‖ ≤
        (2*(N:ℝ)) * (∑ j ∈ range (typeIISmoothDyadicCount L),
          typeIISmoothDyadicScale U V E j) * L^(C-Q) := by
  obtain ⟨C, hC, hcost⟩ := eventually_typeII_harmonic_cross_integral_bound (K₀ := K)
  refine ⟨C, hC, ?_⟩
  filter_upwards [hcost, eventually_ge_atTop (1:ℝ)] with L hcost hL
  intro U V E N M H α W B ρ Q T hU hV hE hUV hM hH hT hcorr
  have hL0 : 0 < L := by linarith
  have hE0 : 0 < E := by rw [hE]; exact mul_pos hU (Real.rpow_pos_of_pos hL0 _)
  apply typeII_energy_fourier_norm_le L U V E N M H α (typeIISeparatedH W B ρ) T
    (Real.rpow_nonneg hL0.le _) (fun j _ => (typeII_smooth_dyadic_scale_pos hU hV hE0 j).le)
  intro k hk hk0 j hj χ
  have hb := hcost U V E (typeIISmoothDyadicScale U V E j) k hU hV
    (typeII_smooth_dyadic_scale_pos hU hV hE0 j) hk0 hE hUV
    (typeII_smooth_dyadic_scale_le hL hU hV hE0 (mem_range.mp hj))
    (M.filter (fun m => α m ≠ 0)) H
    (Icc 0 ((M.filter (fun m => α m ≠ 0)).sup id * H.sup id)) α W B ρ χ T (L^(-Q))
    hT (Real.rpow_nonneg hL0.le _) (fun m hm => hM m (mem_filter.mp hm).1) hH
    (hcorr k hk hk0 j hj χ)
  dsimp only at hb ⊢
  refine hb.trans_eq ?_
  rw [mul_assoc, ← Real.rpow_add hL0]
  congr 2
  ring

end Bounty
