namespace Bounty

theorem eventually_candidate_harmonic_energy_polynomial {c A : ℝ}
    (hc : 0 < c) (hA : 0 ≤ A) :
    ∀ᶠ L : ℝ in atTop, ∀ (G : Type*) [Fintype G]
      (ι : G → candidatePIndices c L) (J : ℕ) (C : G → Finset (Fin J))
      (aux : PhysicalAuxLabels (fun g => candidatePBand (c*L) (ι g).val) C),
      (J*Fintype.card G : ℕ) ≤ A*Real.log L →
      ∀ Z : ℝ, 0 < Z → 1 ≤ Z*(physicalFreeFactor C aux : ℝ) →
      3*Z < Real.exp (4*L) →
      2*((⌈3*Z*(physicalFreeFactor C aux : ℝ)⌉₊ : ℝ)/(Z*(physicalFreeFactor C aux : ℝ)/2))*
        (1+Real.log (⌈3*Z*(physicalFreeFactor C aux : ℝ)⌉₊ : ℝ))^15 ≤ L^(31 : ℝ) := by
  obtain ⟨v, V, _, _, hpool⟩ := exists_candidate_P_pool_bounds hc
  filter_upwards [hpool, eventually_physical_harmonic_energy_polynomial hA
    (by norm_num : (0 : ℝ) ≤ 2/5)] with L hp he
  intro G _ ι J C aux hslots Z hZ hprod hcut
  have hprime : ∀ g p, p ∈ candidatePBand (c*L) (ι g).val → p.Prime := by
    intro g p hpg
    exact ((hp.2.2.2.2.2 (ι g).val (ι g).property).2.2 p hpg).1
  have hplog : ∀ g p, p ∈ candidatePBand (c*L) (ι g).val → Real.log (p : ℝ) ≤ L^(2/5 : ℝ) := by
    intro g p hpg
    apply (Real.log_le_iff_le_exp (by exact_mod_cast (hprime g p hpg).pos)).mpr
    exact ((hp.2.2.2.2.2 (ι g).val (ι g).property).2.2 p hpg).2.2
  have hexp : (15*(max 1 (2/5 : ℝ)+1)+1) = (31 : ℝ) := by norm_num
  simpa only [hexp] using he G (fun g => candidatePBand (c*L) (ι g).val) J C aux
    hprime hplog hslots Z hZ hprod hcut

end Bounty
