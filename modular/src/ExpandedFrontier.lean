/- Product-window decay for actual candidate remainder coefficients in factor-two blocks. -/

open Finset Filter

namespace Bounty

theorem eventually_candidate_factor_two_block_decay {c q theta : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ)*(r : ℝ)*c = 1) (htheta : theta < 1/2) (B : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, 0 < jStar → ∀ (h : ℕ) (R P U : ℝ),
      Real.exp ((c/512)*L) ≤ R → R ≤ Real.exp (theta*L) →
      ∀ Q S T : Finset ℕ,
        (∀ d ∈ Q, R/2 ≤ (d : ℝ)) → (∀ d ∈ Q, (d : ℝ) ≤ R) →
        S ⊆ candidateQBand (c*L) 0 → T ⊆ Icc 1 ⌊16*Real.exp L⌋₊ →
        (∀ p ∈ S, (p : ℝ) ≤ P ∧ P ≤ 2*(p : ℝ)) →
        (∀ n ∈ T, (n : ℝ) ≤ U ∧ U ≤ 2*(n : ℝ)) →
        primitiveCharacterBlockNorm Q
          (∑ p ∈ S, ∑ n ∈ T, fun f χ =>
            if Real.exp L < ((p*n : ℕ) : ℝ) ∧ ((p*n : ℕ) : ℝ) ≤ 16*Real.exp L then
              (if p.Coprime h then (1 : ℂ) else 0) *
              (if n.Coprime h then (candidateRemainderCoefficient c L q r jStar hr n : ℂ) else 0) *
                χ ((p*n : ℕ) : ZMod f)
            else 0) ≤ Real.exp L * L^(-B) := by
  classical
  let H : ℝ := ((((6/5 : ℝ)*c + 2)*Real.log 2) + 1)
  have hH : 0 ≤ H := by dsimp only [H]; positivity
  have hblock := eventually_product_window_block_power_saving hc
    (div_pos hc (by norm_num : (0 : ℝ) < 512)) htheta hH (by norm_num : (0 : ℝ) ≤ 64) B
  filter_upwards [hblock, eventually_candidate_remainder_coefficient_le_exp_sqrt hc hr hq0 hq1,
    eventually_ge_atTop (0 : ℝ)] with L hblockL hremL hL
  intro jStar hj h R P U hRLo hRHi Q S T hQD hQR hSbase hTbase hSscale hTscale
  by_cases hactive : ∃ p ∈ S, ∃ n ∈ T,
      Real.exp L < ((p*n : ℕ) : ℝ) ∧ ((p*n : ℕ) : ℝ) ≤ 16*Real.exp L
  · obtain ⟨p, hp, n, hn, hpn⟩ := hactive
    have hwindow : p*n ∈ arithmeticProductWindow 1 (Real.exp L) := by
      apply (mem_arithmeticProductWindow_iff (by norm_num : (1 : ℕ) ≠ 0) (Real.exp L)).mpr
      simpa only [one_mul] using hpn
    obtain ⟨hPlo, hUlo, _, _, _, hUHi, hPU⟩ :=
      candidate_Q_zero_factor_two_geometry hc hr hcenter hL (hSbase hp) hwindow
        (hSscale p hp).1 (hSscale p hp).2 (hTscale n hn).1 (hTscale n hn).2
    have hSpos : ∀ p ∈ S, 0 < p := by
      intro p hp
      exact ((mem_dyadicPrimeBand_iff (c*L) 1 (6/5) 0 p).mp (hSbase hp)).1.pos
    have hTpos : ∀ n ∈ T, 0 < n := fun n hn => (mem_Icc.mp (hTbase hn)).1
    have hexp1 : 1 ≤ Real.exp (H*Real.sqrt L) :=
      Real.one_le_exp_iff.mpr (mul_nonneg hH (Real.sqrt_nonneg L))
    have halpha : ∀ p ∈ S, ‖if p.Coprime h then (1 : ℂ) else 0‖ ≤ Real.exp (H*Real.sqrt L) := by
      intro p hp
      split_ifs
      · simpa only [norm_one] using hexp1
      · simp only [norm_zero]; positivity
    have hbeta : ∀ n ∈ T,
        ‖if n.Coprime h then (candidateRemainderCoefficient c L q r jStar hr n : ℂ) else 0‖ ≤
          Real.exp (H*Real.sqrt L) := by
      intro n hn
      split_ifs
      · rw [Complex.norm_real, Real.norm_of_nonneg (candidate_remainder_coefficient_nonneg c L hq0 r jStar hr n)]
        apply hremL jStar hj n
        exact (Nat.cast_le.mpr (mem_Icc.mp (hTbase hn)).2).trans (Nat.floor_le (by positivity))
      · simp only [norm_zero]; positivity
    have hb := hblockL P U R hPlo.le hUlo.le hUHi hPU hRLo hRHi Q S T hQD hQR
      hSpos hTpos (fun p hp => (hSscale p hp).1) (fun n hn => (hTscale n hn).1)
      (fun p => if p.Coprime h then (1 : ℂ) else 0)
      (fun n => if n.Coprime h then (candidateRemainderCoefficient c L q r jStar hr n : ℂ) else 0)
      halpha hbeta (Real.exp L) (16*Real.exp L) (Real.exp_pos L).le (by positivity)
    simpa only [primitiveCharacterBlockNorm, Finset.sum_apply, sum_filter, Nat.cast_mul] using hb
  · have hz : (∑ p ∈ S, ∑ n ∈ T, fun (f : ℕ) (χ : DirichletCharacter ℂ f) =>
          if Real.exp L < ((p*n : ℕ) : ℝ) ∧ ((p*n : ℕ) : ℝ) ≤ 16*Real.exp L then
            (if p.Coprime h then (1 : ℂ) else 0) *
            (if n.Coprime h then (candidateRemainderCoefficient c L q r jStar hr n : ℂ) else 0) *
              χ ((p*n : ℕ) : ZMod f)
          else 0) = 0 := by
      apply sum_eq_zero
      intro p hp
      apply sum_eq_zero
      intro n hn
      funext f χ
      exact if_neg (fun hpn => hactive ⟨p, hp, n, hn, hpn⟩)
    rw [hz, primitiveCharacterBlockNorm_zero]
    exact mul_nonneg (Real.exp_nonneg L) (Real.rpow_nonneg hL _)

end Bounty

