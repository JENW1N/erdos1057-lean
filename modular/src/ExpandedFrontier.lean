/- A single original slot in a candidate big-prime group forces the actual
occupied logarithmic cell above exp(L^(3/10)-1). -/

open Finset Filter
open scoped Classical
namespace Bounty

theorem eventually_candidate_big_slot_cell_lower {c : ℝ} (hc : 0 < c) (J : ℕ) :
    ∀ᶠ L : ℝ in atTop, ∀ (S : Finset ℕ), S ⊆ candidatePIndices c L →
      let P := fun g : S => candidatePBand (c*L) g.val
      ∀ (ell : ℕ) (A : Finset (RepeatedBigFlatIndex S J ell)),
        (∃ i : A, i.val.1.val ∈ candidateBigPIndices c L) →
      ∀ (Q : ℕ) (h : ℝ), 0 < h → h ≤ 1 →
      ∀ (d : ℤ) (χ : BoundedPrimitiveCharacter Q) (ζ : ℝ),
        (∃ x : (∀ i : A, P i.val.1),
          (starRingEnd ℂ) (primeProductCellCharacter (fun i : A => P i.val.1) h d χ x) *
            physicalPhase ζ (∏ i, (x i).val) ≠ 0) →
        Real.exp (L^(3/10 : ℝ)-1) ≤ Real.exp (((d : ℝ)-1)*h) := by
  obtain ⟨_, _, _, _, hpool⟩ := exists_candidate_P_pool_bounds hc
  obtain ⟨_, _, _, _, hbig⟩ := eventually_candidate_P_groups
    (α := (3/10 : ℝ)) (β := (2/5 : ℝ)) hc (by norm_num) (by norm_num) (by norm_num)
  filter_upwards [hpool, hbig] with L hp hb
  intro S hS P ell A hi Q h hh hh1 d χ ζ hx
  obtain ⟨i, hi⟩ := hi
  obtain ⟨x, hx⟩ := hx
  have hprime (j : A) : (x j).val.Prime :=
    ((hp.2.2.2.2.2 j.val.1.val (hS j.val.1.property)).2.2 (x j).val (x j).property).1
  have hiBig : Real.exp (L^(3/10 : ℝ)) < ((x i).val : ℝ) :=
    ((hb.2.2.2 i.val.1.val hi).2.2 (x i).val (x i).property).2.1
  have hsingle : (x i).val ≤ ∏ j : A, (x j).val :=
    single_le_prod' (fun j _ => (hprime j).one_le) (mem_univ i)
  have hprod : Real.exp (L^(3/10 : ℝ)) ≤ ((∏ j : A, (x j).val : ℕ) : ℝ) :=
    hiBig.le.trans (by exact_mod_cast hsingle)
  have hpos : 0 < ∏ j : A, (x j).val := by
    have hp0 := (Real.exp_pos _).trans_le hprod
    exact_mod_cast hp0
  have hcell := (prime_cell_phased_conjugate_range
    (fun i : A => P i.val.1) hh d χ ζ x hpos hx).2
  apply le_of_mul_le_mul_left (a := Real.exp 1)
  · calc
      Real.exp 1 * Real.exp (L^(3/10 : ℝ)-1) = Real.exp (L^(3/10 : ℝ)) := by
        rw [← Real.exp_add]
        congr 1
        ring
      _ ≤ Real.exp ((d : ℝ)*h) := hprod.trans hcell
      _ = Real.exp h * Real.exp (((d : ℝ)-1)*h) := by
        rw [← Real.exp_add]
        congr 1
        ring
      _ ≤ _ := mul_le_mul_of_nonneg_right (Real.exp_le_exp.mpr hh1) (Real.exp_pos _).le
  · exact Real.exp_pos 1

end Bounty
end

