variable {G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  (Δ D : G → ℤ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (t : G → ℕ) (B : ℕ)

theorem unrestricted_coupled_positive_eq_product
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ) :
    unrestrictedCoupledProductOperator n Δ D μ ρ V t B (fun _ _ => 1) f =
      unrestrictedProductOperator n Δ D μ ρ V t B (fun _ _ _ _ _ _ => 1) univ f := by
  let E := fun g => UnrestrictedBoundedEvent (n g) (Δ g) (D g) (t g) B
  let w := fun g => unrestrictedBoundedEventWeight (n g) (Δ g) (D g) (μ g) ρ (V g) (t g) B
  let target := fun g => unrestrictedBoundedEventTarget (n g) (Δ g) (D g) (t g) B
  have hlocal : finiteLocalEventAction E w target =
      fun g => unrestrictedBoundedOperator (n g) (Δ g) (D g) (μ g) ρ (V g) (t g) B
        (fun _ _ _ _ _ => 1) := by
    funext g F s
    simpa only [finiteLocalEventAction, mul_one] using
      (unrestricted_bounded_operator_eq_event_sum (n g) (Δ g) (D g) (μ g) ρ (V g)
        (t g) B (fun _ _ _ _ _ => 1) F s).symm
  have h := finite_product_event_eq_coordinate_action E w target f
  rw [hlocal] at h
  exact h

theorem unrestricted_coupled_product_energy_le
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, t g ≤ T)
    (phase : UnrestrictedProductPhase n Δ D t B)
    (hphase : ∀ s e, ‖phase s e‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (unrestrictedCoupledProductOperator n Δ D μ ρ V t B phase f) ≤
    unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
      finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  apply finiteWeightedEnergy_le_of_envelope_domination
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productMemoryWeight_nonneg μ (fun g => unrestrictedResidueWeight (μ g))
      hμ (fun g z => hμ g z.1)) f _
    (unrestrictedProductOperator n Δ D μ ρ V t B (fun _ _ _ _ _ _ => 1) univ)
  · intro s
    rw [← unrestricted_coupled_positive_eq_product n Δ D μ ρ V t B]
    exact unrestricted_coupled_product_norm_le_positive n Δ D μ V hρ0.le
      (fun g => (hvmin.trans_le (hVlo g)).le) hμ t B phase hphase f s
  · simpa only [card_univ] using unrestricted_product_energy_le n Δ D μ ρ V t B
      hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht (fun _ _ _ _ _ _ => 1)
      (by intros; simp) univ (complexNormEnvelope f) (complexNormEnvelope_memory_symmetric f hf)

theorem unrestricted_coupled_cutoff_product_energy_le
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, t g ≤ T)
    (phase : UnrestrictedProductPhase n Δ D t B)
    (hphase : ∀ s e, ‖phase s e‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (unrestrictedCoupledCutoffProductOperator n Δ D μ ρ V t B phase f) ≤
    unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
      finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  calc
    _ ≤ finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
        (unrestrictedCoupledProductOperator n Δ D μ ρ V t B phase (productMemoryCutoff f)) :=
      productMemoryCutoff_energy_le μ (fun g => unrestrictedResidueWeight (μ g))
        hμ (fun g z => hμ g z.1) _
    _ ≤ unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
          (productMemoryCutoff f) :=
      unrestricted_coupled_product_energy_le n Δ D μ ρ V t B hρ0 hρ1 hv hvmin hVlo hVhi
        hμ hmass T ht phase hphase _ (productMemoryCutoff_symmetric f hf)
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (productMemoryCutoff_energy_le μ (fun g => unrestrictedResidueWeight (μ g))
        hμ (fun g z => hμ g z.1) f)
      (pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _)

end
