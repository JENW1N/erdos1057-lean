  simp only [mul_sum]
  apply sum_congr rfl
  intro L _
  apply sum_congr rfl
  intro p _
  have hkp : ∀ j : Fin (n + 1), ∀ g s,
      ¬ (((physicalPathSelectedEquiv patterns C (L, p.val)).2.2.1 j.castSucc g s).val : ℤ) ∣
