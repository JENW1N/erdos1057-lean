            (ghostPhaseCappedHistory
              (fun a : PhysicalPrime P => fun j => globalBirthFiniteActivity
                (physicalGroupBareFiniteActivity
                  (physicalPathSelectedEquiv patterns C (L, p.val)).2.2.1 a.1) j a.2)
              (fun a => physicalResidueAbsoluteHit (physicalPathSelectedOffset C k L p.val) a.1 a.2)
              (fun _ j => 1 - physicalEndpointSchedule q (n + 1) (globalBirthFiniteIndex (n + 1) j).val)
              (fun a => ((a.2.val : ℝ) * b a)⁻¹) (fun a => V a.1)
              (fun _ => B) (fun _ => B) (n + 1) : ℂ) := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  rw [physical_root_residue_model_memory_normalization V patterns C q ζ k K hP hdis hk b hb hb0]
  congr 1
  apply sum_congr rfl
  intro L _
  apply sum_congr rfl
  intro p _
