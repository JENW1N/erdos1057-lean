open Finset Filter
open scoped Topology
theorem eventually_weighted_principal_coprime_loss :
    ∀ᶠ L : ℝ in atTop, ∀ (T : Finset ℕ) (μ : ℕ → ℝ) (N : ℕ),
      (N : ℝ) ≤ Real.exp L → (∀ u ∈ T, 0 ≤ μ u) →
      (∀ u ∈ T, μ u ≠ 0 → u ≠ 0 ∧ (u : ℝ) ≤ 16 * Real.exp L ∧
        ∀ p ∈ u.primeFactors, L^20 ≤ (p : ℝ)) →
      (∑ d ∈ (Icc 1 N).filter Squarefree,
        |(∑ u ∈ T.filter (fun u => Nat.Coprime d u), μ u) / (Nat.totient d : ℝ) -
          (∑ u ∈ T, μ u) / (Nat.totient d : ℝ)|) ≤
        (∑ u ∈ T, μ u) * ((16 * primeEulerProductUpperConstant) * L^(-18 : ℝ)) := by
  filter_upwards [eventually_totient_sieve_noncoprime_mass_le] with L hL
  intro T μ N hN hμ hsupp
  apply totient_sieve_principal_replacement_bound T ((Icc 1 N).filter Squarefree) μ
    (fun u => u) hμ (∑ u ∈ T, μ u) _ rfl
  intro u hu hne
  obtain ⟨hu0, husize, hularge⟩ := hsupp u hu hne
  simpa only [filter_filter] using hL N u hN hu0 husize hularge

theorem eventually_candidate_principal_coprime_loss {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ q : ℝ, 0 ≤ q → ∀ r jStar N : ℕ,
      (N : ℝ) ≤ Real.exp L →
      (∑ d ∈ (Icc 1 N).filter Squarefree,
        |(∑ u ∈ (arithmeticProductWindow 1 (Real.exp L)).filter (fun u => Nat.Coprime d u),
            candidateCoefficient c L q r jStar u) / (Nat.totient d : ℝ) -
          candidateCoefficientWindowMass c L q r jStar / (Nat.totient d : ℝ)|) ≤
        candidateCoefficientWindowMass c L q r jStar *
          ((16 * primeEulerProductUpperConstant) * L^(-18 : ℝ)) := by
  filter_upwards [eventually_weighted_principal_coprime_loss,
    eventually_candidate_coefficient_primeFactors_range hc (δ := (6/5 : ℝ) * c) le_rfl]
    with L hloss hprime
  intro q hq r jStar N hN
  apply hloss (arithmeticProductWindow 1 (Real.exp L))
    (candidateCoefficient c L q r jStar) N hN
    (fun u _ => candidate_coefficient_nonneg c L hq r jStar u)
  intro u hu hne
  have hwin : Real.exp L < (u : ℝ) ∧ (u : ℝ) ≤ 16 * Real.exp L := by
    simpa only [one_mul] using (mem_arithmeticProductWindow_iff one_ne_zero (Real.exp L)).mp hu
  refine ⟨Nat.ne_of_gt (Nat.cast_pos.mp ((Real.exp_pos L).trans hwin.1)), hwin.2, ?_⟩
  intro p hp
  exact (hprime q r jStar u hne p hp).1.le
end

