theorem physical_joint_residue_visit_full_mixed_lifted_events (j : Fin (n + 1))
    (F : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ)
    (s : BoundedGhostJointLedgerState (fun g (p : ↥(P g)) => p.val) M cap) :
    let _ : ∀ (e : Fin (n + 1) ⊕ K) x,
        Fintype (FullMixedMemoryEvent (fun g (p : ↥(P g)) => p.val) S cap A ΔE DE e x) :=
      fullMixedMemoryEventFintype (fun g (p : ↥(P g)) => p.val) S cap A ΔE DE
    globalBirthJointCutRawRow
      (physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β η V ρ hV cap (2 * j.val))
      cap cap F (boundedGhostJointDecode (fun g (p : ↥(P g)) => p.val) M cap s) =
    ∑ e : FullMixedMemoryEvent (fun g (p : ↥(P g)) => p.val) S cap A ΔE DE (.inl j)
        (fun g => (s g).2),
      (coupledGhostJointEventWeight
        (fun g => physicalGhostRetention (fun p : ↥(P g) => p.val) (1 - η g j) (ρ g))
        (fun g => physicalGhostTermination (fun p : ↥(P g) => p.val) (1 - η g j) (ρ g))
        (fun g => physicalGhostBirth (fun p : ↥(P g) => p.val) (1 - η g j) (ρ g) (V g))
        (fun g => unrestrictedResidueWeight (fun p => β g p / V g))
        M cap (fun g => (s g).2) e.down : ℂ) *
      fullMixedGhostFreshnessPhase (fun g (p : ↥(P g)) => p.val) S cap A ΔE DE j s e *
      F (boundedGhostJointDecode (fun g (p : ↥(P g)) => p.val) M cap
        (fullMixedGhostLedgerTarget (fun g (p : ↥(P g)) => p.val) S cap A ΔE DE j s e)) := by
  let _ : ∀ (e : Fin (n + 1) ⊕ K) x,
        Fintype (FullMixedMemoryEvent (fun g (p : ↥(P g)) => p.val) S cap A ΔE DE e x) :=
      fullMixedMemoryEventFintype (fun g (p : ↥(P g)) => p.val) S cap A ΔE DE
  dsimp only
  have h := physical_joint_residue_visit_bounded_events C aux k L a σ τ hstep ζ hmarks
    hlist hP hdis hk β η V ρ hV cap j M F s
  have hu := full_mixed_ghost_sum_ulift (fun g (p : ↥(P g)) => p.val) S cap A ΔE DE
    j (fun g => (s g).2) (fun e => (coupledGhostJointEventWeight
        (fun g => physicalGhostRetention (fun p : ↥(P g) => p.val) (1 - η g j) (ρ g))
        (fun g => physicalGhostTermination (fun p : ↥(P g) => p.val) (1 - η g j) (ρ g))
        (fun g => physicalGhostBirth (fun p : ↥(P g) => p.val) (1 - η g j) (ρ g) (V g))
        (fun g => unrestrictedResidueWeight (fun p => β g p / V g))
        M cap (fun g => (s g).2) e : ℂ) *
        (if boundedGhostJointFresh (fun g (p : ↥(P g)) => p.val) M cap s e then 1 else 0) *
        F (boundedGhostJointDecode (fun g (p : ↥(P g)) => p.val) M cap
          (boundedGhostJointTarget (fun g (p : ↥(P g)) => p.val) M cap s e)))
  refine h.trans ?_
  symm
  refine Eq.trans ?_ hu
  apply sum_congr
  · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
  · intro e _
    rfl

/-- Common visit retentions and damping give the literal signed weight
of the full permutation/mixed model, with no coefficient adjustment. -/
theorem physical_joint_residue_visit_full_permutation_events
    (ω : ∀ k c, A k c → ℝ) (q : Fin (n + 1) → ℝ) (r : ℝ) (j : Fin (n + 1))
    (F : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ)
    (s : BoundedGhostJointLedgerState (fun g (p : ↥(P g)) => p.val) M cap) :
    let _ : ∀ (e : Option (Fin (n + 1) ⊕ K)) x,
        Fintype (FullPermutationMixedEvent (fun g (p : ↥(P g)) => p.val) S cap A ΔE DE e x) :=
      fullPermutationMixedEventFintype (fun g (p : ↥(P g)) => p.val) S cap A ΔE DE
    globalBirthJointCutRawRow
      (physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β
        (fun _ j => 1 - q j) V (fun _ => r) hV cap (2 * j.val)) cap cap F
      (boundedGhostJointDecode (fun g (p : ↥(P g)) => p.val) M cap s) =
    ∑ e : FullPermutationMixedEvent (fun g (p : ↥(P g)) => p.val) S cap A ΔE DE (some (.inl j))
        (fun g => (s g).2),
      (fullPermutationMixedEventWeight (fun g (p : ↥(P g)) => p.val) S cap A ΔE DE ω
        (fun g p => β g p / V g) q r V (some (.inl j)) (fun g => (s g).2) e : ℂ) *
      fullMixedGhostFreshnessPhase (fun g (p : ↥(P g)) => p.val) S cap A ΔE DE j s e *
      F (boundedGhostJointDecode (fun g (p : ↥(P g)) => p.val) M cap
        (fullMixedGhostLedgerTarget (fun g (p : ↥(P g)) => p.val) S cap A ΔE DE j s e)) := by
  let _ : ∀ (e : Option (Fin (n + 1) ⊕ K)) x,
      Fintype (FullPermutationMixedEvent (fun g (p : ↥(P g)) => p.val) S cap A ΔE DE e x) :=
    fullPermutationMixedEventFintype (fun g (p : ↥(P g)) => p.val) S cap A ΔE DE
  dsimp only
  have h := physical_joint_residue_visit_bounded_events C aux k L a σ τ hstep ζ hmarks
    hlist hP hdis hk β (fun _ j => 1 - q j) V (fun _ => r) hV cap j M F s
  simp only [sub_sub_cancel] at h
  have hs := full_mixed_ghost_ledger_event_sum (fun g (p : ↥(P g)) => p.val) S cap A ΔE DE
    ω (fun g p => β g p / V g) q r V j F s
  refine h.trans ?_
  symm
  refine Eq.trans ?_ hs
  apply sum_congr
  · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
  · intro e _
    rfl

