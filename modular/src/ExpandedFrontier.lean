/- The actual ambient rough discrepancy in the original saturated finite harmonic correlation. -/

open Finset Filter
open scoped ComplexConjugate

namespace Bounty

theorem eventually_ambient_rough_saturated_harmonic {c b K γ : ℝ}
    (hc : 0 < c) (hb : 0 < b) (hK : 0 ≤ K) (hγ : 0 < γ) (S : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ a v : ℝ, ∀ (q : ℝ) (r jStar : ℕ) (hr : 0 < r)
      (hj : jStar ∈ candidateQIndices c L)
      (take : Fin ((candidateQIndices c L).card*r) → Bool)
      (hkeep : take ((candidateAllocationOrder c L r).symm
        (candidateRoughSlot c L r jStar hr hj)) = false)
      (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ)
      (lo hi : ℕ) (U V Z : ℝ) (k : ℤ) (ν : ℝ)
      (χ : DirichletCharacter ℂ (2*k.natAbs)) (ζ : EuclideanSpace ℝ (Fin 3)),
      Real.exp (b*L) ≤ U → U ≤ Real.exp L → Real.exp (b*L) ≤ V → V ≤ Real.exp L →
      0 < Z → Z ≤ 24*U^2*V*L^88/(U*L^(-K)) → |(k : ℝ)| ≤ Z →
    let αM : ℕ → ℂ := fun m => (typeIIRestrict (Ioc lo hi) (ambientRoughIntervalTypeIIAlpha γ L S a v) m : ℂ)
    let H := candidateRetainedAllocationSupport c L r jStar (candidateSmallPSet c L (Real.exp (4*L))) take
    let M₀ := (Ioc lo hi).filter (fun m => αM m ≠ 0)
    let Zs := typeIIActiveCrossZ Z k (Icc 0 (M₀.sup id * H.sup id))
    let P := (candidatePIndices c L).biUnion (candidatePBand (c*L))
    let W : ℕ → ℝ := fun n => markedDivisorWeight (candidatePIndices c L)
      (candidatePBand (c*L)) q (fun j => ∑ p ∈ candidatePBand (c*L) j, 1/(p : ℝ)) (fun _ => 1) (n : ℤ)
    let cr := candidateResidualPrimeCoefficient c L r jStar hr hj take hkeep
      (candidateAllocationFourierTwist c L r jStar take ξ)
    let F₀ := invariantTripleEndpoint P
      (fun m => αM m*χ (m : ZMod (2*k.natAbs))*typeIIPhase ((2*Real.pi*ν)-2*Real.pi*ζ 1) m)
      (fun p => if p ∈ candidateRoughBand c L jStar then 1 else 0) (fun s => conj (cr s))
    let G₀ := invariantTripleEndpoint P
      (fun m => αM m*χ (m : ZMod (2*k.natAbs))*typeIIPhase (2*Real.pi*ζ 0+(2*Real.pi*ν)) m)
      (fun p => if p ∈ candidateRoughBand c L jStar then 1 else 0) (fun s => conj (cr s))
    candidateB0HarmonicCorrelation c L q r jStar (candidateSmallPSet c L (Real.exp (4*L))) take
      (candidateAllocationFourierTwist c L r jStar take ξ) ν Z k (Ioc lo hi) αM χ ζ =
      ∑ z ∈ Zs, ((typeIIHarmonicDyadic ((z : ℝ)/Z)/(z : ℝ) : ℝ) : ℂ)*
        (typeIIPhase ((2*Real.pi*ν)+2*Real.pi*ζ 2) z*typeIIPhase (-(2*Real.pi*ν)) ((z : ℤ)+k).toNat*
          conj (F₀ z)*G₀ ((z : ℤ)+k).toNat*(W z : ℂ)*(W ((z : ℤ)+k).toNat : ℂ)) := by
  filter_upwards [eventually_candidate_harmonic_eq_saturated_endpoints hc,
    eventually_candidate_cross_scale_below_cutoff hb hK,
    eventually_ambient_rough_endpoint_group_free hc hγ] with L hsat hcut hfree
  intro a v q r jStar hr hj take hkeep ξ lo hi U V Z k ν χ ζ hUlo hUhi hVlo hVhi hZ hZhi hk
  have hphase : ∀ p ∈ candidateRoughBand c L jStar,
      candidateAllocationFourierTwist c L r jStar take ξ
        (candidateRoughSlot c L r jStar hr hj) p = typeIIPhase 0 p := by
    intro p _
    rw [candidate_rough_slot_allocation_twist_eq_one c L r jStar hr hj take hkeep ξ p,
      typeIIPhase_zero]
  have heq := hsat q r jStar hr hj (Real.exp (4*L)) take hkeep
    (candidateAllocationFourierTwist c L r jStar take ξ) 0 hphase Z k (Ioc lo hi)
    (fun m => (typeIIRestrict (Ioc lo hi) (ambientRoughIntervalTypeIIAlpha γ L S a v) m : ℂ)) ν χ ζ hk
    (hcut U V (U*L^(-K)) Z hUlo hUhi hVlo hVhi rfl hZ hZhi)
    (fun m hm => (Nat.zero_le lo).trans_lt (mem_Ioc.mp hm).1)
    (by intro m hm; simp only [typeIIRestrict,if_neg hm,Complex.ofReal_zero])
    (by
      intro m hm hne
      have ha := (typeIIRestrict_complex_ne_zero_iff (Ioc lo hi) (ambientRoughIntervalTypeIIAlpha γ L S a v) m).mp hne
      exact (hfree S a v m ha.2).2)
  simpa only [neg_zero,typeIIPhase_zero] using heq

end Bounty
end

