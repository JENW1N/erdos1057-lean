/- A nonzero original block derives its product scale from an actual factor pair. -/

open Finset
namespace Bounty

theorem original_active_dyadic_product_bounds {L : ℝ} (hL : 0 ≤ L)
    (μ α β : ℕ → ℝ) (H i j : ℕ)
    (hne : shiftedTypeIIBilinear (arithmeticProductWindow 1 (Real.exp L)) μ
      (typeIIRestrict (dyadicNatBucket (Icc 1 H) i) α)
      (typeIIRestrict (dyadicNatBucket (Icc 1 H) j) β) ≠ 0) :
    Real.exp L / 4 ≤ originalDyadicBase i * originalDyadicBase j ∧
      originalDyadicBase i * originalDyadicBase j ≤ 33*Real.exp L := by
  obtain ⟨w, hw, hα, hβ⟩ := shifted_typeII_nonzero_factors _ μ _ _ hne
  have hmi := ((typeIIRestrict_ne_zero_iff _ _ _).mp hα).1
  have hnj := ((typeIIRestrict_ne_zero_iff _ _ _).mp hβ).1
  have hm := original_dyadic_member_bounds H i w.1 hmi
  have hn := original_dyadic_member_bounds H j w.2 hnj
  have hi := (originalDyadicBase_pos i).le
  have hj := (originalDyadicBase_pos j).le
  have hd := shifted_factor_pair_properties _ hw
  have hp := shifted_wide_window_factor_bound hL hd.2.2.1
  rw [← hd.2.2.2, Nat.cast_mul] at hp
  have hlo := mul_le_mul hm.1 hn.1 hj (Nat.cast_nonneg w.1)
  have hhi := mul_le_mul hm.2 hn.2 (Nat.cast_nonneg w.2) (by positivity : 0 ≤ 2*originalDyadicBase i)
  constructor <;> nlinarith [hp.1,hp.2]

end Bounty
end

section

/- The sharp original real bilinear block is controlled by its actual saturated harmonic tests. -/

open Finset Filter MeasureTheory Real
namespace Bounty

theorem exists_original_real_bilinear_bound_of_saturated_harmonic {c b : ℝ}
    (hc : 0<c) (hb : 0<b) {r : ℕ} (hr : 6≤r) :
    ∃ J : ℕ, ∀ jStar : ℕ, J<jStar → ∀ D : ℝ,
      ∃ Bwin T : ℝ, 1≤Bwin ∧ 0<T ∧ ∃ Kmin : ℝ, 0<Kmin ∧
      ∀ K : ℝ, Kmin≤K → ∃ Q F : ℝ, 0<Q ∧ 0<F ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (U V : ℝ) (M N : Finset ℕ) (α β : ℕ → ℝ),
      exp (b*L) ≤ U → U ≤ exp L → exp (b*L) ≤ V → V ≤ exp L →
      2*U*V ≤ 66*exp L →
      (∀ m ∈ M, (m:ℝ) ∈ Set.Icc U (2*U)) →
      (∀ n ∈ N, (n:ℝ) ∈ Set.Icc V (2*V)) →
      (∀ m, m ∉ M → α m = 0) → (∀ n, n ∉ N → β n = 0) →
      (∀ m, |α m| ≤ 1) → (∀ n, |β n| ≤ 1) →
      (∀ m, α m ≠ 0 → ∀ p ∈ m.primeFactors, exp (sqrt L) < (p:ℝ)) →
      (∀ ν : ℝ, ‖ν‖ ≤ L^T →
        ∀ take : Fin ((candidateQIndices c L).card*r) → Bool,
        (∀ i, candidateAllocationActive c L r jStar i = false → take i = false) →
        ∀ ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ,
        (∀ i, ‖ξ i‖ ≤ L) →
        ∀ k ∈ Icc (-(typeIIAdmissibleDeterminantBound L K:ℤ)) (typeIIAdmissibleDeterminantBound L K),
        k ≠ 0 → ∀ j ∈ range (typeIISmoothDyadicCount L),
        ∀ χ : DirichletCharacter ℂ (2*k.natAbs), ∀ ζ : EuclideanSpace ℝ (Fin 3), ‖ζ‖ ≤ L^F →
        ‖candidateB0HarmonicCorrelation c L (1/2) r jStar
          (candidateSmallPSet c L (exp (4*L))) take
          (candidateAllocationFourierTwist c L r jStar take ξ) ν
          (typeIISmoothDyadicScale U V (U*L^(-K)) j) k M (fun m => (α m : ℂ)) χ ζ‖ ≤ L^(-Q)) →
      |shiftedTypeIIBilinear (arithmeticProductWindow 1 (exp L))
        (candidateCoefficient c L (1/2) r jStar) α β| ≤ exp L*L^(-D) := by
  obtain ⟨J, hJ⟩ := exists_candidate_original_finite_mixed_mellin_reduction hc (half_pos hb)
    (by norm_num : (0 : ℝ) ≤ 1/2) (by norm_num : (1/2 : ℝ) < 1)
    66 (by norm_num) hr
  refine ⟨J, ?_⟩
  intro jStar hj D
  obtain ⟨Bwin, hBwin, T, hT, hred⟩ := hJ jStar hj 0 (D+1)
  obtain ⟨Kmin, hKmin, hpoint⟩ := exists_candidate_finite_mixed_bound_of_saturated_harmonic_range
    (A := 0) (D := D+1) (Bwin := Bwin) 66 (by norm_num) hc hb (by linarith) hr
  refine ⟨Bwin, T, hBwin, hT, Kmin, hKmin, ?_⟩
  intro K hK
  have hK0 : 0 ≤ K := hKmin.le.trans hK
  obtain ⟨Q, F, hQ, hF, hpoint⟩ := hpoint K hK
  refine ⟨Q, F, hQ, hF, ?_⟩
  filter_upwards [hred,hpoint,eventually_original_mellin_scale_geometry_range hb hK0
      (by norm_num : (0 : ℝ) < 66),eventually_fixed_candidateQ_prefix hc jStar,
    eventually_ge_atTop (2 : ℝ)] with L hred hpoint hgeo hprefix hL
  intro U V M N α β hUlo hUhi hVlo hVhi hcoarse hM hN hαsupp hβsupp hα hβ hrough hcorr
  have hL0 : 0 < L := by linarith
  have hjQ := hprefix (mem_Icc.mpr ⟨Nat.zero_le jStar,le_rfl⟩)
  have hE := hgeo U V hUlo hVlo hcoarse
  let G : ℕ → ℕ → ℂ := fun u m => (α m : ℂ)*(β ((2*u+1)/m) : ℂ)
  have hG : ∀ u, ∀ m ∈ (2*u+1).divisors, ‖G u m‖ ≤ L^(0 : ℝ) := by
    intro u m hm
    dsimp only [G]
    rw [norm_mul,Complex.norm_real,Complex.norm_real,Real.norm_eq_abs,Real.norm_eq_abs,rpow_zero]
    exact (mul_le_mul (hα m) (hβ ((2*u+1)/m)) (abs_nonneg _) zero_le_one).trans (by norm_num)
  have hGrough : ∀ u ∈ arithmeticProductWindow 1 (exp L), ∀ m ∈ (2*u+1).divisors,
      ¬(∀ p ∈ m.primeFactors, exp (sqrt L) ≤ (p : ℝ)) → G u m = 0 := by
    intro u hu m hm hnot
    have hz : α m = 0 := by
      by_contra hn
      exact hnot (fun p hp => (hrough m hn p hp).le)
    simp only [G,hz,Complex.ofReal_zero,zero_mul]
  have hS : ∀ u ∈ Icc 1 ⌊66*exp L⌋₊, 0 < u ∧ (u : ℝ) ≤ 66*exp L := by
    intro u hu
    exact ⟨(mem_Icc.mp hu).1,(Nat.cast_le.mpr (mem_Icc.mp hu).2).trans (Nat.floor_le (by positivity))⟩
  have hSW : arithmeticProductWindow 1 (exp L) ⊆ Icc 1 ⌊66*exp L⌋₊ := by
    intro u hu
    have hw := (mem_arithmeticProductWindow_iff one_ne_zero (exp L)).mp hu
    simp only [one_mul] at hw
    have hu0 : 0 < u := by exact_mod_cast ((exp_pos L).trans hw.1)
    exact mem_Icc.mpr ⟨hu0,Nat.le_floor (by nlinarith [hw.2,exp_pos L])⟩
  have herr := (hred (U*L^(-K)) (Icc 1 ⌊66*exp L⌋₊) G hS hSW hE.1 hE.2 hG hGrough).2
  have hi := hpoint jStar hjQ U V (L^T) M N (fun m => (α m : ℂ)) (fun n => (β n : ℂ))
    hUlo hUhi hVlo hVhi hcoarse hM hN
    (by intro m hm; simp only [hαsupp m hm,Complex.ofReal_zero])
    (by intro n hn; simp only [hβsupp n hn,Complex.ofReal_zero])
    (by intro m hm; simpa only [Complex.norm_real,Real.norm_eq_abs,rpow_zero] using hα m)
    (by intro n hn; simpa only [Complex.norm_real,Real.norm_eq_abs,rpow_zero] using hβ n)
    (by intro m hm hn; exact hrough m (by simpa only [ne_eq,Complex.ofReal_eq_zero] using hn)) hcorr
  rw [← shifted_typeII_bilinear_complex_divisor_sum] at herr
  let z : ℂ := (shiftedTypeIIBilinear (arithmeticProductWindow 1 (exp L))
    (candidateCoefficient c L (1/2) r jStar) α β : ℂ)
  let w : ℂ := ∫ ν in {ν : ℝ | ‖ν‖ ≤ L^T},
    candidateFiniteMixedMellinIntegrand c L (1/2) r jStar (U*L^(-K)) Bwin 66
      (Icc 1 ⌊66*exp L⌋₊) G ν
  have hbnd : ‖z‖ ≤ ‖z-w‖+‖w‖ := by
    simpa only [sub_add_cancel] using norm_add_le (z-w) w
  have hfinal := hbnd.trans (add_le_add herr hi)
  have hid : exp L*L^(-(D+1))+exp L*L^(-(D+1)) ≤ exp L*L^(-D) := by
    calc
      _ = (2/L)*(exp L*L^(-D)) := by
        rw [show -(D+1) = -D+(-1) by ring,rpow_add hL0,rpow_neg_one]
        ring
      _ ≤ _ := mul_le_of_le_one_left (by positivity) ((div_le_one hL0).mpr hL)
  simpa only [z,Complex.norm_real,Real.norm_eq_abs] using hfinal.trans hid

end Bounty
end

section

/- Parameter-neutral absorption of any fixed polynomial prefactor in an integral saving. -/

open Filter
namespace Bounty

theorem eventually_polynomial_integral_absorption (A P C₀ : ℝ) (hC₀ : 0 ≤ C₀) :
    ∀ᶠ L : ℝ in atTop, ∀ F I : ℝ, 0 ≤ I → F ≤ C₀*L^P →
      I ≤ L^(-(A+P+1)) → F*I ≤ L^(-A) := by
  filter_upwards [eventually_ge_atTop (max 1 C₀)] with L hL
  have hL1 : 1 ≤ L := (le_max_left _ _).trans hL
  have hL0 : 0 < L := zero_lt_one.trans_le hL1
  have hCL : C₀ ≤ L := (le_max_right _ _).trans hL
  intro F I hI0 hF hI
  calc
    F*I ≤ (C₀*L^P)*I := mul_le_mul_of_nonneg_right hF hI0
    _ ≤ (C₀*L^P)*L^(-(A+P+1)) := mul_le_mul_of_nonneg_left hI (by positivity)
    _ ≤ (L*L^P)*L^(-(A+P+1)) :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hCL (by positivity)) (by positivity)
    _ = L^(-A) := by
      rw [mul_assoc,← Real.rpow_add hL0]
      conv_lhs => lhs; rw [← Real.rpow_one L]
      rw [← Real.rpow_add hL0]
      congr 1
      ring

theorem eventually_polynomial_sqrt_integral_absorption (A P C₀ : ℝ) (hC₀ : 0 ≤ C₀) :
    ∀ᶠ L : ℝ in atTop, ∀ F I : ℝ, F ≤ C₀*L^P →
      I ≤ L^(-2*(A+P+1)) → F*Real.sqrt I ≤ L^(-A) := by
  filter_upwards [eventually_polynomial_integral_absorption A P C₀ hC₀,
    eventually_gt_atTop (0 : ℝ)] with L habsorb hL
  intro F I hF hI
  apply habsorb F (Real.sqrt I) (Real.sqrt_nonneg I) hF
  apply (Real.sqrt_le_left (by positivity : 0 ≤ L^(-(A+P+1)))).mpr
  have hpow : (L^(-(A+P+1)))^2 = L^(-2*(A+P+1)) := by
    rw [← Real.rpow_mul_natCast hL.le]
    congr 1
    ring
  rwa [hpow]

end Bounty
end

