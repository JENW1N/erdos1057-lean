/- Original product-scale savings imply the exponential-scale block interface. -/

open Finset
namespace Bounty

theorem original_active_block_bound_of_product_saving {L D : ℝ} (hL : 66 ≤ L)
    (μ α β : ℕ → ℝ) (H i j : ℕ)
    (hne : shiftedTypeIIBilinear (arithmeticProductWindow 1 (Real.exp L)) μ
      (typeIIRestrict (dyadicNatBucket (Icc 1 H) i) α)
      (typeIIRestrict (dyadicNatBucket (Icc 1 H) j) β) ≠ 0)
    (hbound : |shiftedTypeIIBilinear (arithmeticProductWindow 1 (Real.exp L)) μ
      (typeIIRestrict (dyadicNatBucket (Icc 1 H) i) α)
      (typeIIRestrict (dyadicNatBucket (Icc 1 H) j) β)| ≤
      2*originalDyadicBase i*originalDyadicBase j*L^(-(D+1))) :
    |shiftedTypeIIBilinear (arithmeticProductWindow 1 (Real.exp L)) μ
      (typeIIRestrict (dyadicNatBucket (Icc 1 H) i) α)
      (typeIIRestrict (dyadicNatBucket (Icc 1 H) j) β)| ≤ Real.exp L*L^(-D) := by
  have hL0 : 0 < L := by linarith
  have hprod := (original_active_dyadic_product_bounds hL0.le μ α β H i j hne).2
  have hid : L * L^(-(D+1)) = L^(-D) := by
    conv_lhs => lhs; rw [← Real.rpow_one L]
    rw [← Real.rpow_add hL0]
    congr 1
    ring
  apply hbound.trans
  calc
    _ ≤ (66*Real.exp L)*L^(-(D+1)) :=
      mul_le_mul_of_nonneg_right (by nlinarith [hprod]) (by positivity)
    _ = 66*(Real.exp L*L^(-(D+1))) := by ring
    _ ≤ L*(Real.exp L*L^(-(D+1))) := mul_le_mul_of_nonneg_right hL (by positivity)
    _ = Real.exp L*(L*L^(-(D+1))) := by ring
    _ = _ := by rw [hid]

end Bounty
end

