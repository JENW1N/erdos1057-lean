open scoped BigOperators
noncomputable def geometricChordBound (N : ℕ) (z : ℂ) : ℝ :=
  if z = 1 then N else min (N : ℝ) (2 / ‖z - 1‖)

theorem unit_geometric_interval_bound (z : ℂ) (hz : ‖z‖ = 1) (a N : ℕ) :
    ‖∑ n ∈ Finset.range N, z ^ (a + n)‖ ≤ geometricChordBound N z := by
  by_cases he : z = 1
  · subst z
    simp [geometricChordBound]
  · simpa only [geometricChordBound, if_neg he] using
      unit_geometric_interval_norm_le_min z hz he a N

theorem unit_geometric_column_gram_bound (z w : ℂ) (hz : ‖z‖ = 1) (hw : ‖w‖ = 1)
    (a N : ℕ) :
    ‖∑ n : Fin N, (starRingEnd ℂ) (z ^ (a + n.val)) * w ^ (a + n.val)‖ ≤
      geometricChordBound N ((starRingEnd ℂ) z * w) := by
  have hr : ‖(starRingEnd ℂ) z * w‖ = 1 := by
    rw [norm_mul, Complex.norm_conj, hz, hw, one_mul]
  simp only [map_pow, ← mul_pow]
  rw [Fin.sum_univ_eq_sum_range (fun n => ((starRingEnd ℂ) z * w) ^ (a + n)) N]
  exact unit_geometric_interval_bound _ hr a N

theorem unit_geometric_bilinear_norm_sq_le {Y : Type*} [Fintype Y]
    (z : Y → ℂ) (hz : ∀ y, ‖z y‖ = 1) (a N : ℕ)
    (c : Fin N → ℂ) (b : Y → ℂ) {B : ℝ}
    (hrow : ∀ y, (∑ w, geometricChordBound N ((starRingEnd ℂ) (z y) * z w)) ≤ B) :
    ‖∑ n : Fin N, ∑ y, c n * b y * (z y) ^ (a + n.val)‖ ^ 2 ≤
      B * (∑ n : Fin N, ‖c n‖ ^ 2) * ∑ y, ‖b y‖ ^ 2 := by
  apply finite_bilinear_gram_norm_sq_le
  intro y
  exact (Finset.sum_le_sum (fun w _ =>
    unit_geometric_column_gram_bound _ _ (hz y) (hz w) a N)).trans (hrow y)
end

