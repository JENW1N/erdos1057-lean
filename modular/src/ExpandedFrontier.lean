/- Original big-prime nondivisibility survives multiplication by the small shared product. -/

open scoped Classical
namespace Bounty
section Multiplier
variable {S G : Type*} [Fintype S] {Ps : S → Finset ℕ} {P : G → Finset ℕ}
  (hPs : ∀ s p, p ∈ Ps s → Nat.Prime p)
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : ∀ s g, Disjoint (Ps s) (P g))
  {J : ℕ} (d : PhysicalSharedLists Ps J)

include hPs hP hdis in
theorem physical_big_prime_dvd_effective_multiplier (g : G) (p : ↥(P g)) (k : ℤ) :
    (p.val : ℤ) ∣ k * (physicalSharedProduct d : ℕ) ↔ (p.val : ℤ) ∣ k := by
  have hp : Prime (p.val : ℤ) := Int.prime_iff_natAbs_prime.mpr (by simpa using hP g p.val p.property)
  have hn : ¬ (p.val : ℤ) ∣ (physicalSharedProduct d : ℕ) := by
    exact_mod_cast physical_big_prime_not_dvd_small_shared hPs hP hdis d g p
  exact hp.dvd_mul.trans (or_iff_left hn)

include hPs hP hdis in
theorem physical_big_prime_not_dvd_effective_multiplier (g : G) (p : ↥(P g)) (k : ℤ)
    (hk : ¬ (p.val : ℤ) ∣ k) :
    ¬ (p.val : ℤ) ∣ k * (physicalSharedProduct d : ℕ) := by
  exact fun h => hk ((physical_big_prime_dvd_effective_multiplier hPs hP hdis d g p k).mp h)

end Multiplier
