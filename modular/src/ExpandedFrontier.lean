/- Bounded shared-dependent coefficients on the actual bad-draw event. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_bad_shared_mean_norm_le {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (aux : PhysicalAuxLabels P C) {w z : ℕ} (hw : 0 < w) (hz : 0 < z)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (A : PhysicalAuxLabels P (fun g => univ \ C g) → Prop) [DecidablePred A]
    (hbad : ∀ s, A s → ¬physicalSharedDrawGood C (fun g => physicalSharedForbidden C aux g w z) s)
    (F : PhysicalAuxLabels P (fun g => univ \ C g) → ℂ)
    {B : ℝ} (hB : 0 ≤ B) (hF : ∀ s, A s → ‖F s‖ ≤ B) :
    ‖∑ s : PhysicalAuxLabels P (fun g => univ \ C g),
      if A s then (physicalAuxMass V (fun g => univ \ C g) s : ℂ) * F s else 0‖ ≤
      (∑ g, (J - (C g).card : ℕ) *
        (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) / (V g * Pmin)) * B := by
  calc
    _ ≤ ∑ s : PhysicalAuxLabels P (fun g => univ \ C g),
        ‖if A s then (physicalAuxMass V (fun g => univ \ C g) s : ℂ) * F s else 0‖ :=
      norm_sum_le _ _
    _ ≤ (∑ s : PhysicalAuxLabels P (fun g => univ \ C g),
        physicalAuxMass V (fun g => univ \ C g) s *
          (if ¬physicalSharedDrawGood C (fun g => physicalSharedForbidden C aux g w z) s
            then 1 else 0)) * B := by
      rw [sum_mul]
      apply sum_le_sum
      intro s _
      have hm := physical_aux_mass_nonneg V (fun g => univ \ C g) (fun g => (hV g).le) s
      by_cases hs : A s
      · rw [if_pos hs, if_pos (hbad s hs), mul_one, norm_mul,
          Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hm]
        exact mul_le_mul_of_nonneg_left (hF s hs) hm
      · rw [if_neg hs, norm_zero]
        exact mul_nonneg (mul_nonneg hm (by split_ifs <;> norm_num)) hB
    _ ≤ _ := mul_le_mul_of_nonneg_right
      (physical_shared_draw_endpoint_bad_mass V C hV hMass aux hw hz hPmin hp) hB

theorem physical_bad_cut_mean_norm_le {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (u v : GroupMarkedLists P (fun g => ell + (C g).card))
    (aux : PhysicalAuxLabels P C) {w z : ℕ} (hw : 0 < w) (hz : 0 < z)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (F : PhysicalAuxLabels P (fun g => univ \ C g) → ℂ)
    {B : ℝ} (hB : 0 ≤ B)
    (hF : ∀ s, physicalRawCutGood C u v s → ‖F s‖ ≤ B) :
    ‖∑ s : PhysicalAuxLabels P (fun g => univ \ C g),
      if physicalRawCutGood C u v s ∧
        ¬(∀ g j, s g j ∉ physicalSharedForbidden C aux g w z)
      then (physicalAuxMass V (fun g => univ \ C g) s : ℂ) * F s else 0‖ ≤
      (∑ g, (J - (C g).card : ℕ) *
        (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) / (V g * Pmin)) * B := by
  apply physical_bad_shared_mean_norm_le V C hV hMass aux hw hz hPmin hp
    (fun s => physicalRawCutGood C u v s ∧
      ¬(∀ g j, s g j ∉ physicalSharedForbidden C aux g w z)) _ F hB
  · intro s hs
    exact hF s hs.1
  · intro s hs hg
    exact hs.2 (fun g => (hg g).1)

end Bounty
end

