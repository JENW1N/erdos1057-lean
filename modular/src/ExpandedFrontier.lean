theorem full_mixed_edge_owner_sample_coverage (hocc : fullMixedOwnerOccurrence n S B A Δ D steps x p u =
      ⟨s, fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inr k)) htag s ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm ⟨sk, fresh⟩)⟩)
    (i : Fin (Fintype.card (FullMixedBirthAddress S B steps))) :
    (fullMixedPathBirthPerformed n S B A Δ D steps x p (fullMixedBirthOrder S B steps i) ∧
      fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i) = u) ↔
      ∃ c, fullMixedEdgeOwnerSampleEmbedding n S B k steps u htag (A k) (Δ k) (D k) s sk c = i :=
  full_mixed_tagged_owner_coordinate_coverage n S B A Δ D steps u (some (.inr k)) htag s
