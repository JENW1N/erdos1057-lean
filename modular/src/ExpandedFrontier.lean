        (source ⟨i, by omega⟩) (event ⟨i, by omega⟩) :=
    finite_schedule_source_after E target (4 * n + 1) s p i hi
  refine ⟨o, t, physical_fine_events_coherent C k cut hencode source event hnext o t ho ht, ?_, ?_, ?_⟩
  · simp only [finite_event_path_observations_length, List.length_range]
  · intro i hi
