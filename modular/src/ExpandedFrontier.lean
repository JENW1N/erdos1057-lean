  (ω : ∀ k, A k → ℝ) (μ : ∀ g, P g → ℝ)
  (qghost : H → ℝ) (ρ : ℝ) (V : G → ℝ) (Vs : S → ℝ) (qsmall : ℝ)

noncomputable def physicalSmallBigCapPhase
    (steps : List (Option (H ⊕ K)))
    (phase : ∀ s, PhysicalSmallBigPath (ell := ell) n shared B A Δ D kbig steps s → ℂ) :
    ∀ s, PhysicalSmallBigPath (ell := ell) n shared b A Δ D kbig steps s → ℂ :=
  finiteSupportedPathPhase
    (PhysicalSmallBigPathEvent (H := H) (ell := ell) n shared b A Δ D) (PhysicalSmallBigPathEvent (H := H) (ell := ell) n shared B A Δ D)
    (physicalSmallBigPathEventTarget n shared b A Δ D kbig)
    (physicalSmallBigPathEventTarget n shared B A Δ D kbig)
    (physicalSmallBigPathEventWeight n shared b A Δ D kbig ω μ qghost ρ V Vs qsmall)
    (finiteSafeEventPredicate (PhysicalSmallBigPathEvent (H := H) (ell := ell) n shared B A Δ D)
      (physicalSmallBigPathEventTarget n shared B A Δ D kbig)
      (physicalSmallBigPathEventWeight n shared B A Δ D kbig ω μ qghost ρ V Vs qsmall)
      (fun s => productTotalMemory s.2) b)
    (physicalSmallBigCapEmbed h) (fun s => productTotalMemory s.2 ≤ b)
    (fun k s hs e => physicalSmallBigPathEvent_supported_target n shared A Δ D
      kbig ω μ qghost ρ V Vs qsmall k s hs e.val e.property)
    (physicalSmallBigPathEventCapSupportEquiv n shared A Δ D h kbig ω μ qghost ρ V Vs qsmall)
    (physicalSmallBigPathEventCapSupportEquiv_target n shared A Δ D h kbig ω μ qghost ρ V Vs qsmall)
    steps phase

theorem physical_small_big_cap_phase_norm_le
    (steps : List (Option (H ⊕ K)))
    (phase : ∀ s, PhysicalSmallBigPath (ell := ell) n shared B A Δ D kbig steps s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1)
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b))
    (p : PhysicalSmallBigPath (ell := ell) n shared b A Δ D kbig steps s) :
    ‖physicalSmallBigCapPhase n shared A Δ D h kbig ω μ qghost ρ V Vs qsmall steps phase s p‖ ≤ 1 := by
  exact finite_supported_path_phase_norm_le _ _ _ _ _ _ _ _ _ _ _ steps phase hphase s p

variable [∀ g, Fintype (P g)] [∀ g p, NeZero (n g p)] [∀ k, Fintype (A k)]

theorem physical_small_big_cap_path_action
    (steps : List (Option (H ⊕ K)))
    (phase : ∀ s, PhysicalSmallBigPath (ell := ell) n shared B A Δ D kbig steps s → ℂ)
    (f : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b))
    (hs : productTotalMemory s.2 ≤ b) :
    physicalSmallBigPathAction n shared b A Δ D kbig ω μ qghost ρ V Vs qsmall steps
        (physicalSmallBigCapPhase n shared A Δ D h kbig ω μ qghost ρ V Vs qsmall steps phase)
        (fun s => f (physicalSmallBigCapEmbed h s)) s =
      physicalSmallBigPathAction n shared B A Δ D kbig ω μ qghost ρ V Vs qsmall steps
        (fun s p => if physicalSmallBigPathPeak n shared B A Δ D kbig steps s p ≤ b then phase s p else 0)
        f (physicalSmallBigCapEmbed h s) := by
  let _ : ∀ (k : Option (H ⊕ K)) s, Fintype (PhysicalSmallBigPathEvent (H := H) (ell := ell) n shared b A Δ D k s) :=
    physicalSmallBigPathEventFintype (H := H) (ell := ell) n shared b A Δ D
  let _ : ∀ (k : Option (H ⊕ K)) s, Fintype (PhysicalSmallBigPathEvent (H := H) (ell := ell) n shared B A Δ D k s) :=
    physicalSmallBigPathEventFintype (H := H) (ell := ell) n shared B A Δ D
  exact finite_safe_path_action_transport
    (PhysicalSmallBigPathEvent (H := H) (ell := ell) n shared b A Δ D) (PhysicalSmallBigPathEvent (H := H) (ell := ell) n shared B A Δ D)
    (physicalSmallBigPathEventTarget n shared b A Δ D kbig)
    (physicalSmallBigPathEventTarget n shared B A Δ D kbig)
    (physicalSmallBigPathEventWeight n shared b A Δ D kbig ω μ qghost ρ V Vs qsmall)
    (physicalSmallBigPathEventWeight n shared B A Δ D kbig ω μ qghost ρ V Vs qsmall)
    (fun s => productTotalMemory s.2) b (physicalSmallBigCapEmbed h) (fun s => productTotalMemory s.2 ≤ b)
    (fun k s hs e => physicalSmallBigPathEvent_supported_target n shared A Δ D
      kbig ω μ qghost ρ V Vs qsmall k s hs e.val e.property)
    (physicalSmallBigPathEventCapSupportEquiv n shared A Δ D h kbig ω μ qghost ρ V Vs qsmall)
    (physicalSmallBigPathEventCapSupportEquiv_target n shared A Δ D h kbig ω μ qghost ρ V Vs qsmall)
    (physicalSmallBigPathEventCapSupportEquiv_weight n shared A Δ D h kbig ω μ qghost ρ V Vs qsmall)
    steps phase f s hs hs
end
end Bounty
