            physicalRootNormalizablePath V patterns C ζ k K
              ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d⟩).1
              ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d⟩).2},
