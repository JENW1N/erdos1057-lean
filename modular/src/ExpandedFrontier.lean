section

/-- The sufficient direction of Korselt's criterion, proved from Fermat's little theorem. -/
theorem isCarmichael_of_korselt {n : ℕ} (hsq : Squarefree n)
    (hn : 1 < n) (hcomp : ¬ n.Prime)
    (hdiv : ∀ p : ℕ, p.Prime → p ∣ n → p - 1 ∣ n - 1) : IsCarmichael n := by
  intro b hb hcoprime
  refine ⟨?_, hcomp, hn⟩
  change n ∣ b ^ (n - 1) - 1
  by_cases hz : b ^ (n - 1) - 1 = 0
  · simp [hz]
  nth_rw 1 [← Nat.prod_primeFactors_of_squarefree hsq]
  rw [Nat.prod_primeFactors_dvd_iff hz]
  intro p hp
  have hp' : p.Prime := (Nat.mem_primeFactors.mp hp).1
  have hpn : p ∣ n := (Nat.mem_primeFactors.mp hp).2.1
  apply Nat.mem_primeFactors.mpr
  refine ⟨hp', ?_, hz⟩
  obtain ⟨k, hk⟩ := hdiv p hp' hpn
  have hfermat := Nat.ModEq.pow_card_sub_one_eq_one hp' (hcoprime.of_dvd_left hpn).symm
  have hpow := hfermat.pow k
  rw [← pow_mul, ← hk, one_pow] at hpow
  exact Nat.dvd_of_mod_eq_zero (Nat.sub_mod_eq_zero_of_mod_eq hpow)

/-- A product of at least two distinct primes is Carmichael if it is one modulo
    a common multiple of all the prime predecessors. -/
theorem isCarmichael_prod_of_dvd {s : Finset ℕ} {L : ℕ}
    (hprime : ∀ p ∈ s, p.Prime) (hcard : 2 ≤ s.card)
    (hL : ∀ p ∈ s, p - 1 ∣ L)
    (hprod : L ∣ (∏ p ∈ s, p) - 1) : IsCarmichael (∏ p ∈ s, p) := by
  have hfactor : (∏ p ∈ s, p).primeFactors = s := Nat.primeFactors_prod hprime
  have hnonempty : s.Nonempty := Finset.card_pos.mp (by omega)
  have hgt : 1 < ∏ p ∈ s, p := Nat.nonempty_primeFactors.mp (hfactor.symm ▸ hnonempty)
  have hsq : Squarefree (∏ p ∈ s, p) := by
    apply Finset.squarefree_prod_of_pairwise_isCoprime
    · intro p hp q hq hpq
      exact Nat.coprime_iff_isRelPrime.mp ((Nat.coprime_primes (hprime p hp)
        (hprime q hq)).mpr hpq)
    · intro p hp
      exact (hprime p hp).squarefree
  have hcomp : ¬ (∏ p ∈ s, p).Prime := by
    intro hp
    have hs : s = {∏ p ∈ s, p} := hfactor.symm.trans hp.primeFactors
    have : s.card = 1 := by
      simpa only [Finset.card_singleton] using congrArg Finset.card hs
    omega
  apply isCarmichael_of_korselt hsq hgt hcomp
  intro p hp hpn
  have hps : p ∈ s := by
    rw [← hfactor]
    exact Nat.mem_primeFactors.mpr ⟨hp, hpn, by omega⟩
  exact (hL p hps).trans hprod

/-- The congruence form of the finite-prime-product construction. -/
theorem isCarmichael_prod_of_modEq {s : Finset ℕ} {L : ℕ}
    (hprime : ∀ p ∈ s, p.Prime) (hcard : 2 ≤ s.card)
    (hL : ∀ p ∈ s, p - 1 ∣ L)
    (hprod : Nat.ModEq L (∏ p ∈ s, p) 1) : IsCarmichael (∏ p ∈ s, p) := by
  exact isCarmichael_prod_of_dvd hprime hcard hL hprod.symm.dvd'
end

section

/-- A finite set of primes can be recovered from its product. -/
theorem prime_subset_product_injective {P : Finset ℕ}
    (hP : ∀ p ∈ P, Nat.Prime p) :
    Set.InjOn (fun s : Finset ℕ => ∏ p ∈ s, p) {s | s ⊆ P} := by
  intro s hs t ht hst
  have hs' : ∀ p ∈ s, Nat.Prime p := fun p hp => hP p (hs hp)
  have ht' : ∀ p ∈ t, Nat.Prime p := fun p hp => hP p (ht hp)
  simpa only [Nat.primeFactors_prod hs', Nat.primeFactors_prod ht'] using
    congrArg Nat.primeFactors hst

/-- Every finite family of admissible prime subsets produces as many distinct
Carmichael numbers below the stated bound. -/
theorem subset_family_card_le_carmichaelCounting {P : Finset ℕ}
    (hP : ∀ p ∈ P, Nat.Prime p) (A : Finset (Finset ℕ)) (x : ℝ)
    (hsub : ∀ s ∈ A, s ⊆ P)
    (hcar : ∀ s ∈ A, IsCarmichael (∏ p ∈ s, p))
    (hbound : ∀ s ∈ A, ((∏ p ∈ s, p : ℕ) : ℝ) ≤ x) :
    (A.card : ℝ) ≤ Erdos1057.carmichaelCounting x := by
  have hfinite : Set.Finite {n : ℕ | IsCarmichael n ∧ (n : ℝ) ≤ x} := by
    apply (Set.finite_Iic ⌊x⌋₊).subset
    intro n hn
    exact Nat.le_floor hn.2
  have hinj : Set.InjOn (fun s : Finset ℕ => ∏ p ∈ s, p) (A : Set (Finset ℕ)) := by
    intro s hs t ht hst
    exact prime_subset_product_injective hP (hsub s hs) (hsub t ht) hst
  have hcard := Set.ncard_le_ncard_of_injOn
    (fun s : Finset ℕ => ∏ p ∈ s, p)
    (fun s hs => And.intro (hcar s hs) (hbound s hs)) hinj hfinite
  simp only [Set.ncard_coe_finset] at hcard
  unfold Erdos1057.carmichaelCounting
  exact_mod_cast hcard
end

section

/-- A prime-power factor of a finite least common multiple occurs in one of its inputs. -/
theorem lcm_prime_power_le_bound {ι : Type*} (s : Finset ι) (f : ι → ℕ)
    (hs : s.Nonempty) (hne : ∀ i ∈ s, f i ≠ 0) {B : ℕ}
    (hbound : ∀ i ∈ s, f i ≤ B) (q : ℕ) :
    q ^ (s.lcm f).factorization q ≤ B := by
  rw [Finset.factorization_lcm hne q]
  obtain ⟨i, hi, heq⟩ := Finset.exists_mem_eq_sup s hs (fun i => (f i).factorization q)
  rw [heq]
  exact (Nat.ordProj_le q (hne i hi)).trans (hbound i hi)

/-- The least common multiple is at most the input bound raised to the number
of distinct prime factors in the modulus. -/
theorem lcm_le_pow_primeFactors_card {ι : Type*} (s : Finset ι) (f : ι → ℕ)
    (hne : ∀ i ∈ s, f i ≠ 0) {B : ℕ} (hbound : ∀ i ∈ s, f i ≤ B) :
    s.lcm f ≤ B ^ (s.lcm f).primeFactors.card := by
  classical
  by_cases hs : s.Nonempty
  · have hL : s.lcm f ≠ 0 := Finset.lcm_ne_zero_iff.mpr hne
    calc
      s.lcm f = ∏ q ∈ (s.lcm f).primeFactors, q ^ (s.lcm f).factorization q :=
        Nat.prod_primeFactors_pow_factorization hL
      _ ≤ ∏ _q ∈ (s.lcm f).primeFactors, B := by
        exact Finset.prod_le_prod' (fun q _ => lcm_prime_power_le_bound s f hs hne hbound q)
      _ = B ^ (s.lcm f).primeFactors.card := by simp
  · have hempty : s = ∅ := Finset.not_nonempty_iff_eq_empty.mp hs
    simp [hempty]

/-- Smoothness of all inputs passes to their least common multiple. -/
theorem primeFactors_lcm_le {ι : Type*} (s : Finset ι) (f : ι → ℕ)
    (hne : ∀ i ∈ s, f i ≠ 0) {K : ℕ}
    (hsmooth : ∀ i ∈ s, ∀ q : ℕ, q.Prime → q ∣ f i → q ≤ K)
    {q : ℕ} (hq : q ∈ (s.lcm f).primeFactors) : q ≤ K := by
  classical
  by_cases hs : s.Nonempty
  · have hpos : (s.lcm f).factorization q ≠ 0 := Finsupp.mem_support_iff.mp hq
    rw [Finset.factorization_lcm hne q] at hpos
    obtain ⟨i, hi, heq⟩ := Finset.exists_mem_eq_sup s hs (fun i => (f i).factorization q)
    rw [heq] at hpos
    exact hsmooth i hi q (Nat.prime_of_mem_primeFactors hq)
      (Nat.dvd_of_factorization_pos hpos)
  · have hempty : s = ∅ := Finset.not_nonempty_iff_eq_empty.mp hs
    simp [hempty] at hq

/-- A smooth least common multiple obeys a bound independent of the number of inputs. -/
theorem smooth_lcm_le_pow {ι : Type*} (s : Finset ι) (f : ι → ℕ)
    (hne : ∀ i ∈ s, f i ≠ 0) {B K : ℕ} (hB : 1 ≤ B)
    (hbound : ∀ i ∈ s, f i ≤ B)
    (hsmooth : ∀ i ∈ s, ∀ q : ℕ, q.Prime → q ∣ f i → q ≤ K) :
    s.lcm f ≤ B ^ K := by
  classical
  have hsub : (s.lcm f).primeFactors ⊆ Finset.Icc 1 K := by
    intro q hq
    exact Finset.mem_Icc.mpr ⟨(Nat.prime_of_mem_primeFactors hq).one_le,
      primeFactors_lcm_le s f hne hsmooth hq⟩
  have hcard : (s.lcm f).primeFactors.card ≤ K := by
    have h := Finset.card_le_card hsub
    simpa using h
  exact (lcm_le_pow_primeFactors_card s f hne hbound).trans
    (pow_le_pow_right₀ hB hcard)

/-- Logarithmic form of the smooth-modulus bound used in the counting argument. -/
theorem log_smooth_lcm_le {ι : Type*} (s : Finset ι) (f : ι → ℕ)
    (hne : ∀ i ∈ s, f i ≠ 0) {B K : ℕ} (hB : 1 ≤ B)
    (hbound : ∀ i ∈ s, f i ≤ B)
    (hsmooth : ∀ i ∈ s, ∀ q : ℕ, q.Prime → q ∣ f i → q ≤ K) :
    Real.log ((s.lcm f : ℕ) : ℝ) ≤ (K : ℝ) * Real.log (B : ℝ) := by
  have hL : 0 < ((s.lcm f : ℕ) : ℝ) := by
    exact_mod_cast Nat.pos_of_ne_zero (Finset.lcm_ne_zero_iff.mpr hne)
  have hbound' : ((s.lcm f : ℕ) : ℝ) ≤ (B : ℝ) ^ K := by
    exact_mod_cast smooth_lcm_le_pow s f hne hB hbound hsmooth
  simpa using Real.log_le_log hL hbound'
end

section

/-- The modulus imposed by the predecessors of a prime reservoir. -/
def primePredecessorLCM (P : Finset ℕ) : ℕ := P.lcm (fun p => p - 1)

theorem primePredecessorLCM_pos {P : Finset ℕ} (hP : ∀ p ∈ P, Nat.Prime p) :
    0 < primePredecessorLCM P := by
  apply Nat.pos_of_ne_zero
  apply Finset.lcm_ne_zero_iff.mpr
  intro p hp
  have := (hP p hp).two_le
  omega

theorem predecessor_dvd_primePredecessorLCM {P : Finset ℕ} {p : ℕ} (hp : p ∈ P) :
    p - 1 ∣ primePredecessorLCM P := Finset.dvd_lcm hp

theorem primePredecessorLCM_smooth {P : Finset ℕ} (hP : ∀ p ∈ P, Nat.Prime p)
    {K : ℕ} (hsmooth : ∀ p ∈ P, ∀ q : ℕ, q.Prime → q ∣ p - 1 → q ≤ K)
    {q : ℕ} (hq : q ∈ (primePredecessorLCM P).primeFactors) : q ≤ K := by
  apply primeFactors_lcm_le P (fun p => p - 1) _ hsmooth hq
  intro p hp
  have := (hP p hp).two_le
  omega

theorem log_primePredecessorLCM_le {P : Finset ℕ} (hP : ∀ p ∈ P, Nat.Prime p)
    {B K : ℕ} (hB : 1 ≤ B) (hbound : ∀ p ∈ P, p - 1 ≤ B)
    (hsmooth : ∀ p ∈ P, ∀ q : ℕ, q.Prime → q ∣ p - 1 → q ≤ K) :
    Real.log (primePredecessorLCM P : ℝ) ≤ (K : ℝ) * Real.log (B : ℝ) := by
  apply log_smooth_lcm_le P (fun p => p - 1) _ hB hbound hsmooth
  intro p hp
  have := (hP p hp).two_le
  omega

/-- Any prime larger than every prime factor of a positive modulus is coprime to it. -/
theorem prime_coprime_of_primeFactors_lt {p L : ℕ} (hp : p.Prime) (hL : 0 < L)
    (hsmall : ∀ q ∈ L.primeFactors, q < p) : p.Coprime L := by
  apply hp.coprime_iff_not_dvd.mpr
  intro hdiv
  have hmem : p ∈ L.primeFactors :=
    (Nat.mem_primeFactors_of_ne_zero (ne_of_gt hL)).mpr ⟨hp, hdiv⟩
  exact (Nat.lt_irrefl p) (hsmall p hmem)

/-- Smoothness guarantees coprimality for every ambient prime above the smoothness cutoff. -/
theorem ambientPrime_coprime_primePredecessorLCM {P : Finset ℕ}
    (hP : ∀ p ∈ P, Nat.Prime p) {K : ℕ}
    (hsmooth : ∀ p ∈ P, ∀ q : ℕ, q.Prime → q ∣ p - 1 → q ≤ K)
    {p : ℕ} (hp : p.Prime) (hlarge : K < p) : p.Coprime (primePredecessorLCM P) := by
  apply prime_coprime_of_primeFactors_lt hp (primePredecessorLCM_pos hP)
  intro q hq
  exact (primePredecessorLCM_smooth hP hsmooth hq).trans_lt hlarge

/-- The natural residue of a reservoir prime, packaged as a unit of the common modulus. -/
noncomputable def primePredecessorLabel (P : Finset ℕ) (hP : ∀ p ∈ P, Nat.Prime p)
    (K : ℕ) (hsmooth : ∀ p ∈ P, ∀ q : ℕ, q.Prime → q ∣ p - 1 → q ≤ K)
    (hlarge : ∀ p ∈ P, K < p) (p : {p : ℕ // p ∈ P}) :
    (ZMod (primePredecessorLCM P))ˣ :=
  ZMod.unitOfCoprime p.val
    (ambientPrime_coprime_primePredecessorLCM hP hsmooth (hP p.val p.property)
      (hlarge p.val p.property))

theorem primePredecessorLabel_val (P : Finset ℕ) (hP : ∀ p ∈ P, Nat.Prime p)
    (K : ℕ) (hsmooth : ∀ p ∈ P, ∀ q : ℕ, q.Prime → q ∣ p - 1 → q ≤ K)
    (hlarge : ∀ p ∈ P, K < p) (p : {p : ℕ // p ∈ P}) :
    (primePredecessorLabel P hP K hsmooth hlarge p : ZMod (primePredecessorLCM P)) = p.val :=
  ZMod.coe_unitOfCoprime _ _

/-- A total version of the residue label, equal to `1` away from the reservoir. -/
noncomputable def primePredecessorLabels (P : Finset ℕ) (hP : ∀ p ∈ P, Nat.Prime p)
    (K : ℕ) (hsmooth : ∀ p ∈ P, ∀ q : ℕ, q.Prime → q ∣ p - 1 → q ≤ K)
    (hlarge : ∀ p ∈ P, K < p) (p : ℕ) : (ZMod (primePredecessorLCM P))ˣ :=
  if hp : p ∈ P then primePredecessorLabel P hP K hsmooth hlarge ⟨p, hp⟩ else 1

theorem primePredecessorLabels_val (P : Finset ℕ) (hP : ∀ p ∈ P, Nat.Prime p)
    (K : ℕ) (hsmooth : ∀ p ∈ P, ∀ q : ℕ, q.Prime → q ∣ p - 1 → q ≤ K)
    (hlarge : ∀ p ∈ P, K < p) {p : ℕ} (hp : p ∈ P) :
    (primePredecessorLabels P hP K hsmooth hlarge p : ZMod (primePredecessorLCM P)) = p := by
  simp only [primePredecessorLabels, dif_pos hp]
  exact primePredecessorLabel_val P hP K hsmooth hlarge ⟨p, hp⟩

/-- There are at most `L` unit residues modulo a positive integer `L`. -/
theorem card_zmod_units_le {L : ℕ} (hL : 0 < L) : Nat.card (ZMod L)ˣ ≤ L := by
  let : NeZero L := ⟨ne_of_gt hL⟩
  have h := Nat.card_le_card_of_injective (fun u : (ZMod L)ˣ => (u : ZMod L))
    Units.val_injective
  simpa only [Nat.card_zmod] using h

/-- A smooth prime reservoir admits a common small modulus and compatible unit labels. -/
theorem exists_smooth_prime_modulus (P : Finset ℕ) (hP : ∀ p ∈ P, Nat.Prime p)
    {B K : ℕ} (hB : 1 ≤ B) (hbound : ∀ p ∈ P, p - 1 ≤ B)
    (hsmooth : ∀ p ∈ P, ∀ q : ℕ, q.Prime → q ∣ p - 1 → q ≤ K)
    (hlarge : ∀ p ∈ P, K < p) :
    ∃ (L : ℕ) (g : {p : ℕ // p ∈ P} → (ZMod L)ˣ),
      0 < L ∧ (∀ p ∈ P, p - 1 ∣ L) ∧
      (∀ q ∈ L.primeFactors, q ≤ K) ∧
      Real.log (L : ℝ) ≤ (K : ℝ) * Real.log (B : ℝ) ∧
      Nat.card (ZMod L)ˣ ≤ L ∧ ∀ p, (g p : ZMod L) = p.val := by
  refine ⟨primePredecessorLCM P, primePredecessorLabel P hP K hsmooth hlarge,
    primePredecessorLCM_pos hP, ?_, ?_, log_primePredecessorLCM_le hP hB hbound hsmooth,
    card_zmod_units_le (primePredecessorLCM_pos hP), ?_⟩
  · intro p hp
    exact predecessor_dvd_primePredecessorLCM hp
  · intro q hq
    exact primePredecessorLCM_smooth hP hsmooth hq
  · intro p
    exact primePredecessorLabel_val P hP K hsmooth hlarge p

/-- Total labels in the form used by the finite Carmichael construction. -/
theorem exists_smooth_prime_modulus_total (P : Finset ℕ) (hP : ∀ p ∈ P, Nat.Prime p)
    {B K : ℕ} (hB : 1 ≤ B) (hbound : ∀ p ∈ P, p - 1 ≤ B)
    (hsmooth : ∀ p ∈ P, ∀ q : ℕ, q.Prime → q ∣ p - 1 → q ≤ K)
    (hlarge : ∀ p ∈ P, K < p) :
    ∃ (L : ℕ) (g : ℕ → (ZMod L)ˣ),
      0 < L ∧ (∀ p ∈ P, p - 1 ∣ L) ∧
      (∀ q ∈ L.primeFactors, q ≤ K) ∧
      Real.log (L : ℝ) ≤ (K : ℝ) * Real.log (B : ℝ) ∧
      Nat.card (ZMod L)ˣ ≤ L ∧ ∀ p ∈ P, (g p : ZMod L) = p := by
  refine ⟨primePredecessorLCM P, primePredecessorLabels P hP K hsmooth hlarge,
    primePredecessorLCM_pos hP, ?_, ?_, log_primePredecessorLCM_le hP hB hbound hsmooth,
    card_zmod_units_le (primePredecessorLCM_pos hP), ?_⟩
  · intro p hp
    exact predecessor_dvd_primePredecessorLCM hp
  · intro q hq
    exact primePredecessorLCM_smooth hP hsmooth hq
  · intro p hp
    exact primePredecessorLabels_val P hP K hsmooth hlarge hp
end

section

/-- A finite collection of positive natural numbers below a real bound has at most
the natural floor of that bound many elements. -/
theorem card_positive_nat_finset_le_floor {S : Finset ℕ} {x : ℝ}
    (hpos : ∀ p ∈ S, 0 < p) (hbound : ∀ p ∈ S, (p : ℝ) ≤ x) :
    S.card ≤ ⌊x⌋₊ := by
  have hsub : S ⊆ Finset.Icc 1 ⌊x⌋₊ := by
    intro p hp
    exact Finset.mem_Icc.mpr ⟨hpos p hp, Nat.le_floor (hbound p hp)⟩
  simpa using Finset.card_le_card hsub

theorem prime_interval_card_le_floor {S : Finset ℕ} {y : ℝ}
    (hprime : ∀ p ∈ S, p.Prime) (hbound : ∀ p ∈ S, (p : ℝ) ≤ 5 * y) :
    S.card ≤ ⌊5 * y⌋₊ :=
  card_positive_nat_finset_le_floor (fun p hp => (hprime p hp).pos) hbound

theorem prime_interval_card_le {S : Finset ℕ} {y : ℝ} (hy : 0 ≤ y)
    (hprime : ∀ p ∈ S, p.Prime) (hbound : ∀ p ∈ S, (p : ℝ) ≤ 5 * y) :
    (S.card : ℝ) ≤ 5 * y := by
  have hcard : (S.card : ℝ) ≤ (⌊5 * y⌋₊ : ℝ) := by
    exact_mod_cast prime_interval_card_le_floor hprime hbound
  exact hcard.trans (Nat.floor_le (by positivity))

/-- The integer smooth-modulus estimate with floors removed from its conclusion. -/
theorem log_primePredecessorLCM_le_real {P : Finset ℕ} {y δ : ℝ}
    (hy : 1 ≤ y) (hprime : ∀ p ∈ P, p.Prime)
    (hbound : ∀ p ∈ P, (p : ℝ) ≤ 5 * y)
    (hsmooth : ∀ p ∈ P, ∀ q : ℕ, q.Prime → q ∣ p - 1 → (q : ℝ) ≤ y ^ δ) :
    Real.log (primePredecessorLCM P : ℝ) ≤ y ^ δ * Real.log (5 * y) := by
  have hypos : 0 < y := lt_of_lt_of_le zero_lt_one hy
  have hB : 1 ≤ ⌊5 * y⌋₊ := Nat.le_floor (by norm_num; linarith)
  have hbound' : ∀ p ∈ P, p - 1 ≤ ⌊5 * y⌋₊ := by
    intro p hp
    exact (Nat.sub_le p 1).trans (Nat.le_floor (hbound p hp))
  have hsmooth' : ∀ p ∈ P, ∀ q : ℕ, q.Prime → q ∣ p - 1 → q ≤ ⌊y ^ δ⌋₊ := by
    intro p hp q hq hdiv
    exact Nat.le_floor (hsmooth p hp q hq hdiv)
  have hlog := log_primePredecessorLCM_le hprime hB hbound' hsmooth'
  have hBpos : (0 : ℝ) < (⌊5 * y⌋₊ : ℕ) := by exact_mod_cast hB
  have hBreal : (⌊5 * y⌋₊ : ℝ) ≤ 5 * y := Nat.floor_le (by positivity)
  have hKreal : (⌊y ^ δ⌋₊ : ℝ) ≤ y ^ δ :=
    Nat.floor_le (Real.rpow_nonneg hypos.le _)
  have hlogB : 0 ≤ Real.log (⌊5 * y⌋₊ : ℝ) := by
    apply Real.log_nonneg
    exact_mod_cast hB
  exact hlog.trans (mul_le_mul hKreal (Real.log_le_log hBpos hBreal)
    hlogB (Real.rpow_nonneg hypos.le _))

/-- Smooth predecessors from a reservoir give a common modulus whose unit labels
are compatible with every prime in a larger interval. Only `δ ≤ 1` is needed. -/
theorem exists_real_smooth_prime_modulus {y δ : ℝ} (hy : 1 ≤ y) (hδ : δ ≤ 1)
    (P S : Finset ℕ) (hsub : P ⊆ S)
    (hprime : ∀ p ∈ S, p.Prime)
    (hinterval : ∀ p ∈ S, 2 * y < (p : ℝ) ∧ (p : ℝ) ≤ 5 * y)
    (hsmooth : ∀ p ∈ P, ∀ q : ℕ, q.Prime → q ∣ p - 1 → (q : ℝ) ≤ y ^ δ) :
    ∃ (L : ℕ) (g : ℕ → (ZMod L)ˣ),
      0 < L ∧ (∀ p ∈ P, p - 1 ∣ L) ∧
      (∀ q ∈ L.primeFactors, (q : ℝ) ≤ y ^ δ) ∧
      Real.log (L : ℝ) ≤ y ^ δ * Real.log (5 * y) ∧
      Nat.card (ZMod L)ˣ ≤ L ∧ ∀ p ∈ S, (g p : ZMod L) = p := by
  have hypos : 0 < y := lt_of_lt_of_le zero_lt_one hy
  have hP : ∀ p ∈ P, p.Prime := fun p hp => hprime p (hsub hp)
  have hLpos : 0 < primePredecessorLCM P := primePredecessorLCM_pos hP
  have hsmooth' : ∀ p ∈ P, ∀ q : ℕ, q.Prime → q ∣ p - 1 → q ≤ ⌊y ^ δ⌋₊ := by
    intro p hp q hq hdiv
    exact Nat.le_floor (hsmooth p hp q hq hdiv)
  have hLsmooth : ∀ q ∈ (primePredecessorLCM P).primeFactors, (q : ℝ) ≤ y ^ δ := by
    intro q hq
    have hsmall : (q : ℝ) ≤ (⌊y ^ δ⌋₊ : ℝ) := by
      exact_mod_cast primePredecessorLCM_smooth hP hsmooth' hq
    exact hsmall.trans (Nat.floor_le (Real.rpow_nonneg hypos.le _))
  have hcoprime : ∀ p ∈ S, p.Coprime (primePredecessorLCM P) := by
    intro p hp
    apply prime_coprime_of_primeFactors_lt (hprime p hp) hLpos
    intro q hq
    have hqp : (q : ℝ) < (p : ℝ) := by
      have hpow := Real.rpow_le_self_of_one_le hy hδ
      have := hLsmooth q hq
      have := (hinterval p hp).1
      linarith
    exact_mod_cast hqp
  let g : ℕ → (ZMod (primePredecessorLCM P))ˣ := fun p =>
    if hp : p ∈ S then ZMod.unitOfCoprime p (hcoprime p hp) else 1
  refine ⟨primePredecessorLCM P, g, hLpos, ?_, hLsmooth,
    log_primePredecessorLCM_le_real hy hP (fun p hp => (hinterval p (hsub hp)).2) hsmooth,
    card_zmod_units_le hLpos, ?_⟩
  · intro p hp
    exact predecessor_dvd_primePredecessorLCM hp
  · intro p hp
    simp only [g, dif_pos hp, ZMod.coe_unitOfCoprime]
end

section

/-- Extend a complex character of the unit group by zero on nonunits. -/
noncomputable def dirichletOfUnitCharacter {L : ℕ} (ξ : (ZMod L)ˣ →* ℂ) :
    DirichletCharacter ℂ L :=
  MulChar.ofUnitHom ξ.toHomUnits

theorem dirichletOfUnitCharacter_apply {L : ℕ} (ξ : (ZMod L)ˣ →* ℂ)
    (u : (ZMod L)ˣ) : dirichletOfUnitCharacter ξ (u : ZMod L) = ξ u := by
  exact MulChar.ofUnitHom_coe ξ.toHomUnits u

/-- Extension preserves and reflects principality. -/
theorem dirichletOfUnitCharacter_eq_one_iff {L : ℕ} (ξ : (ZMod L)ˣ →* ℂ) :
    dirichletOfUnitCharacter ξ = 1 ↔ ξ = 1 := by
  constructor
  · intro h
    ext u
    have hu := congrArg (fun χ : DirichletCharacter ℂ L => χ (u : ZMod L)) h
    simpa only [dirichletOfUnitCharacter_apply, MulChar.one_apply_coe,
      MonoidHom.one_apply] using hu
  · intro h
    apply MulChar.ext
    intro u
    rw [dirichletOfUnitCharacter_apply, MulChar.one_apply_coe, h, MonoidHom.one_apply]

theorem dirichletOfUnitCharacter_ne_one {L : ℕ} {ξ : (ZMod L)ˣ →* ℂ}
    (hξ : ξ ≠ 1) : dirichletOfUnitCharacter ξ ≠ 1 :=
  fun h => hξ ((dirichletOfUnitCharacter_eq_one_iff ξ).mp h)

/-- Compatible unit labels give exactly the conventional character value on a natural number. -/
theorem dirichletOfUnitCharacter_apply_label {L : ℕ} (ξ : (ZMod L)ˣ →* ℂ)
    {g : ℕ → (ZMod L)ˣ} {p : ℕ} (hcompat : (g p : ZMod L) = p) :
    dirichletOfUnitCharacter ξ (p : ZMod L) = ξ (g p) := by
  rw [← hcompat, dirichletOfUnitCharacter_apply]

theorem exists_nonprincipal_dirichlet_of_unitCharacter {L : ℕ}
    (ξ : (ZMod L)ˣ →* ℂ) (hξ : ξ ≠ 1) (S : Finset ℕ)
    (g : ℕ → (ZMod L)ˣ) (hcompat : ∀ p ∈ S, (g p : ZMod L) = p) :
    ∃ χ : DirichletCharacter ℂ L, χ ≠ 1 ∧ ∀ p ∈ S, χ (p : ZMod L) = ξ (g p) := by
  refine ⟨dirichletOfUnitCharacter ξ, dirichletOfUnitCharacter_ne_one hξ, ?_⟩
  intro p hp
  exact dirichletOfUnitCharacter_apply_label ξ (hcompat p hp)

theorem dirichletOfUnitCharacter_sum_eq {L : ℕ} (ξ : (ZMod L)ˣ →* ℂ)
    (S : Finset ℕ) (g : ℕ → (ZMod L)ˣ)
    (hcompat : ∀ p ∈ S, (g p : ZMod L) = p) :
    ∑ p ∈ S, dirichletOfUnitCharacter ξ (p : ZMod L) = ∑ p ∈ S, ξ (g p) := by
  apply Finset.sum_congr rfl
  intro p hp
  exact dirichletOfUnitCharacter_apply_label ξ (hcompat p hp)

/-- A character-sum estimate stated for Dirichlet characters transfers to compatible unit labels. -/
theorem unitCharacter_sum_bound_of_dirichlet {L : ℕ} (S : Finset ℕ)
    (g : ℕ → (ZMod L)ˣ) (hcompat : ∀ p ∈ S, (g p : ZMod L) = p) {R : ℝ}
    (hbound : ∀ χ : DirichletCharacter ℂ L, χ ≠ 1 → ‖∑ p ∈ S, χ (p : ZMod L)‖ ≤ R)
    (ξ : (ZMod L)ˣ →* ℂ) (hξ : ξ ≠ 1) : ‖∑ p ∈ S, ξ (g p)‖ ≤ R := by
  rw [← dirichletOfUnitCharacter_sum_eq ξ S g hcompat]
  exact hbound _ (dirichletOfUnitCharacter_ne_one hξ)
end

section

theorem extend_complex_character {G : Type*} [CommGroup G] [Finite G]
    (H : Subgroup G) (χ : H →* ℂ) :
    ∃ ξ : G →* ℂ, ∀ h : H, ξ h = χ h := by
  obtain ⟨ξ, hξ⟩ := MonoidHom.domRestrict_surjective ℂ H χ.toHomUnits
  refine ⟨(Units.coeHom ℂ).comp ξ, ?_⟩
  intro h
  have heq := DFunLike.congr_fun hξ h
  exact congrArg (fun z : ℂˣ => (z : ℂ)) heq
end

section

open OAI.Ostmann

/-- This is an explicit unproved input, not a new axiom. -/
def PrimitiveZeroFreeHalfPlane : Prop :=
  ∀ χ : PrimitiveComplexCharacter, ∀ s : ℂ,
    (7 / 8 : ℝ) < s.re → χ.L s ≠ 0

/-- Reflection converts the right zero-free half-plane into a closed strip
containing every nontrivial zero. -/
theorem primitive_zero_mem_strip (hZ : PrimitiveZeroFreeHalfPlane)
    (χ : PrimitiveComplexCharacter) (z : ℂ)
    (hz : χ.L z = 0) (hz0 : 0 < z.re) :
    (1 / 8 : ℝ) ≤ z.re ∧ z.re ≤ (7 / 8 : ℝ) := by
  constructor
  · by_contra h
    have hzsmall : z.re < 1 / 8 := lt_of_not_ge h
    have hs0 : 0 < (1 - z).re := by simp only [Complex.sub_re, Complex.one_re]; linarith
    have hs1 : (1 - z).re < 1 := by simp only [Complex.sub_re, Complex.one_re]; linarith
    have hshi : (7 / 8 : ℝ) < (1 - z).re := by
      simp only [Complex.sub_re, Complex.one_re]
      linarith
    have hnonzero := hZ χ.inverse (1 - z) hshi
    have horder := χ.L_order_reflection (1 - z) hs0 hs1
    have hcancel : (1 : ℂ) - (1 - z) = z := by ring
    rw [hcancel] at horder
    have hzeroorder := (χ.L_analytic z).analyticOrderAt_ne_zero.mpr hz
    have hinvorder := (χ.inverse.L_analytic (1 - z)).analyticOrderAt_eq_zero.mpr hnonzero
    exact hzeroorder (horder.trans hinvorder)
  · by_contra h
    exact hZ χ z (lt_of_not_ge h) hz
end

section
open Finset
/-- A finite dyadic majorant for a reciprocal norm, using a lower norm bound
and any dominated height. -/
theorem reciprocal_le_dyadic_sum {r h : ℝ} (hr : (1 : ℝ) / 8 ≤ r) (hhr : h ≤ r)
    (K : ℕ) (hK : h ≤ (2 : ℝ) ^ K) :
    1 / r ≤ 8 * ∑ k ∈ range (K + 1), if h ≤ (2 : ℝ) ^ k then 1 / (2 : ℝ) ^ k else 0 := by
  have hr0 : 0 < r := by linarith
  induction K with
  | zero =>
      have hh : h ≤ 1 := by simpa using hK
      simp only [zero_add, sum_range_one, pow_zero, if_pos hh, div_one]
      exact (div_le_iff₀ hr0).mpr (by linarith)
  | succ K ih =>
      rw [sum_range_succ]
      rw [if_pos hK]
      have hlast : 0 ≤ 1 / (2 : ℝ) ^ (K + 1) := by positivity
      by_cases hsmall : h ≤ (2 : ℝ) ^ K
      · have hprev := ih hsmall
        simpa only [Nat.succ_eq_add_one] using (show 1 / r ≤
          8 * ((∑ k ∈ range (K + 1), if h ≤ (2 : ℝ) ^ k then 1 / (2 : ℝ) ^ k else 0) +
            1 / (2 : ℝ) ^ (K + 1)) by linarith)
      · have hp : (2 : ℝ) ^ K ≤ r := (le_of_lt (lt_of_not_ge hsmall)).trans hhr
        have hinv : 1 / r ≤ 1 / (2 : ℝ) ^ K :=
          one_div_le_one_div_of_le (by positivity) hp
        have hscale : 1 / (2 : ℝ) ^ K ≤ 8 * (1 / (2 : ℝ) ^ (K + 1)) := by
          rw [pow_succ]
          field_simp
          norm_num
        have hsum : 0 ≤ ∑ k ∈ range (K + 1),
            if h ≤ (2 : ℝ) ^ k then 1 / (2 : ℝ) ^ k else 0 := by
          apply sum_nonneg
          intro k hk
          split_ifs <;> positivity
        simpa only [Nat.succ_eq_add_one] using (show 1 / r ≤
          8 * ((∑ k ∈ range (K + 1), if h ≤ (2 : ℝ) ^ k then 1 / (2 : ℝ) ^ k else 0) +
            1 / (2 : ℝ) ^ (K + 1)) by linarith)

/-- Prefix mass estimates turn the pointwise dyadic majorant into a finite
reciprocal sum estimate. -/
theorem finite_reciprocal_sum_le {α : Type*} (S : Finset α) (w r h : α → ℝ)
    (K : ℕ) (C L : ℝ) (hC : 0 ≤ C) (hL : 0 ≤ L)
    (hw : ∀ x ∈ S, 0 ≤ w x) (hr : ∀ x ∈ S, (1 : ℝ) / 8 ≤ r x)
    (hhr : ∀ x ∈ S, h x ≤ r x) (hK : ∀ x ∈ S, h x ≤ (2 : ℝ) ^ K)
    (hprefix : ∀ k ≤ K, (∑ x ∈ S.filter (fun x => h x ≤ (2 : ℝ) ^ k), w x) ≤
      C * ((2 : ℝ) ^ k + 1) * L) :
    (∑ x ∈ S, w x / r x) ≤ 16 * C * (K + 1 : ℕ) * L := by
  classical
  have hlevel (k : ℕ) (hk : k ≤ K) :
      (∑ x ∈ S, w x * (if h x ≤ (2 : ℝ) ^ k then 1 / (2 : ℝ) ^ k else 0)) ≤
        2 * C * L := by
    have hp : 0 < (2 : ℝ) ^ k := by positivity
    have hp1 : 1 ≤ (2 : ℝ) ^ k := one_le_pow₀ (by norm_num)
    calc
      _ = (∑ x ∈ S.filter (fun x => h x ≤ (2 : ℝ) ^ k), w x) / (2 : ℝ) ^ k := by
        rw [sum_filter, sum_div]
        apply sum_congr rfl
        intro x hx
        split_ifs <;> simp [div_eq_mul_inv]
      _ ≤ (C * ((2 : ℝ) ^ k + 1) * L) / (2 : ℝ) ^ k :=
        div_le_div_of_nonneg_right (hprefix k hk) hp.le
      _ ≤ 2 * C * L := by
        apply (div_le_iff₀ hp).mpr
        calc
          C * ((2 : ℝ) ^ k + 1) * L ≤ C * (2 * (2 : ℝ) ^ k) * L := by gcongr; linarith
          _ = (2 * C * L) * (2 : ℝ) ^ k := by ring
  calc
    (∑ x ∈ S, w x / r x) ≤
        ∑ x ∈ S, w x * (8 * ∑ k ∈ range (K + 1),
          if h x ≤ (2 : ℝ) ^ k then 1 / (2 : ℝ) ^ k else 0) := by
      apply sum_le_sum
      intro x hx
      simpa only [mul_one_div] using mul_le_mul_of_nonneg_left
        (reciprocal_le_dyadic_sum (hr x hx) (hhr x hx) K (hK x hx)) (hw x hx)
    _ = 8 * ∑ k ∈ range (K + 1), ∑ x ∈ S,
        w x * (if h x ≤ (2 : ℝ) ^ k then 1 / (2 : ℝ) ^ k else 0) := by
      simp_rw [mul_sum]
      rw [sum_comm]
      apply sum_congr rfl
      intro k hk
      apply sum_congr rfl
      intro x hx
      ring
    _ ≤ 8 * ∑ _k ∈ range (K + 1), 2 * C * L := by
      gcongr with k hk
      exact hlevel k (Nat.le_of_lt_succ (mem_range.mp hk))
    _ = 16 * C * (K + 1 : ℕ) * L := by simp; ring

/-- Multiplicity-weighted reciprocal zero sum in a fixed right-hand substrip.
Only the ordinary zero-count theorem and the explicit strip conditions are used. -/
theorem character_reciprocal_zero_sum_le
    (χ : OAI.Ostmann.PrimitiveComplexCharacter) (S : Finset ℂ) (K : ℕ)
    (hS : ∀ z ∈ S, (1 : ℝ) / 8 ≤ z.re ∧ z.re < 1 ∧ |z.im| ≤ (2 : ℝ) ^ K) :
    (∑ z ∈ S, (OAI.Ostmann.characterZeroOrder χ z : ℝ) / ‖z‖) ≤
      (512 / Real.log (14 / 13)) * (K + 1 : ℕ) *
        Real.log ((χ.modulus : ℝ) * ((2 : ℝ) ^ K + 2)) := by
  classical
  have hq : (1 : ℝ) ≤ χ.modulus := by exact_mod_cast χ.positive
  have hq0 : (0 : ℝ) < χ.modulus := by exact_mod_cast χ.positive
  have hden : 0 < Real.log (14 / 13 : ℝ) := Real.log_pos (by norm_num)
  have hL : 0 ≤ Real.log ((χ.modulus : ℝ) * ((2 : ℝ) ^ K + 2)) := by
    apply Real.log_nonneg
    have hp : 0 ≤ (2 : ℝ) ^ K := by positivity
    nlinarith [mul_nonneg (sub_nonneg.mpr hq) hp]
  have hprefix (k : ℕ) (hk : k ≤ K) :
      (∑ z ∈ S.filter (fun z => |z.im| ≤ (2 : ℝ) ^ k),
        (OAI.Ostmann.characterZeroOrder χ z : ℝ)) ≤
      (32 / Real.log (14 / 13)) * ((2 : ℝ) ^ k + 1) *
        Real.log ((χ.modulus : ℝ) * ((2 : ℝ) ^ K + 2)) := by
    have hcount := χ.full_zero_sum_rate ((2 : ℝ) ^ k) (by positivity)
      (S.filter (fun z => |z.im| ≤ (2 : ℝ) ^ k)) (by
        intro z hz
        obtain ⟨hzS, hzheight⟩ := mem_filter.mp hz
        exact ⟨by linarith [(hS z hzS).1], (hS z hzS).2.1, hzheight⟩)
    apply hcount.trans
    apply mul_le_mul_of_nonneg_left
    · apply Real.log_le_log (by positivity)
      apply mul_le_mul_of_nonneg_left _ hq0.le
      have hp : (2 : ℝ) ^ k ≤ (2 : ℝ) ^ K := pow_le_pow_right₀ (by norm_num) hk
      linarith
    · positivity
  have hbound := finite_reciprocal_sum_le S
    (fun z => (OAI.Ostmann.characterZeroOrder χ z : ℝ))
    (fun z => ‖z‖) (fun z => |z.im|) K
    (32 / Real.log (14 / 13))
    (Real.log ((χ.modulus : ℝ) * ((2 : ℝ) ^ K + 2)))
    (by positivity) hL
    (by intro z hz; exact_mod_cast OAI.Ostmann.characterZeroOrder_nonneg χ z)
    (by intro z hz; exact (hS z hz).1.trans (Complex.re_le_norm z))
    (by intro z hz; exact Complex.abs_im_le_norm z)
    (by intro z hz; exact (hS z hz).2.2) hprefix
  calc
    _ ≤ 16 * (32 / Real.log (14 / 13)) * (K + 1 : ℕ) *
        Real.log ((χ.modulus : ℝ) * ((2 : ℝ) ^ K + 2)) := hbound
    _ = _ := by ring
end

section

open Complex Filter Metric Set
open scoped Topology

theorem exists_normalized_log_on_ball (g : ℂ → ℂ) (R : ℝ) (hR : 0 < R)
    (hg : AnalyticOnNhd ℂ g (ball 0 R)) (hne : ∀ z ∈ ball 0 R, g z ≠ 0) :
    ∃ F : ℂ → ℂ, F 0 = 0 ∧ (∀ z ∈ ball 0 R, HasDerivAt F (logDeriv g z) z) ∧
      ∀ z ∈ ball 0 R, g z = g 0 * exp (F z) := by
  have hd : DifferentiableOn ℂ (logDeriv g) (ball 0 R) := by
    intro z hz
    exact ((hg z hz).deriv.div (hg z hz) (hne z hz)).differentiableWithinAt
  obtain ⟨F, hF0, hF⟩ := hd.isExactOn_ball.with_val_at 0 0
  refine ⟨F, hF0, hF, ?_⟩
  let H : ℂ → ℂ := fun z => g z * exp (-F z)
  have hH (z : ℂ) (hz : z ∈ ball 0 R) : HasDerivAt H 0 z := by
    have h := (hg z hz).differentiableAt.hasDerivAt.mul ((hF z hz).neg.cexp)
    have he : deriv g z * exp (-F z) + g z * (exp (-F z) * -logDeriv g z) = 0 := by
      rw [logDeriv_apply]
      field_simp [hne z hz]
      ring
    change HasDerivAt H (deriv g z * exp (-F z) + g z * (exp (-F z) * -logDeriv g z)) z at h
    rw [he] at h
    exact h
  have hHD : DifferentiableOn ℂ H (ball 0 R) := fun z hz => (hH z hz).differentiableAt.differentiableWithinAt
  intro z hz
  have hc := isOpen_ball.is_const_of_deriv_eq_zero (convex_ball (0 : ℂ) R).isPreconnected
    hHD (fun w hw => (hH w hw).deriv) hz (mem_ball_self hR)
  change g z * exp (-F z) = g 0 * exp (-F 0) at hc
  rw [hF0, neg_zero, exp_zero, mul_one, exp_neg] at hc
  have hmul := congrArg (fun w : ℂ => w * exp (F z)) hc
  simpa [mul_assoc, exp_ne_zero] using hmul

theorem normalized_log_re (g F : ℂ → ℂ) (z : ℂ) (hg0 : g 0 ≠ 0)
    (he : g z = g 0 * exp (F z)) :
    (F z).re = Real.log ‖g z‖ - Real.log ‖g 0‖ := by
  have hnorm := congrArg norm he
  rw [norm_mul, norm_exp] at hnorm
  have hh := congrArg Real.log hnorm
  rw [Real.log_mul (norm_ne_zero_iff.mpr hg0) (Real.exp_ne_zero _), Real.log_exp] at hh
  linarith


/-- A zero-free analytic function has logarithmic derivative controlled by its
logarithmic modulus oscillation and the distance to the boundary of the disk. -/
theorem logDeriv_norm_le_margin_disk (g : ℂ → ℂ) (R A δ : ℝ)
    (hR : 0 < R) (hA : 0 < A) (hδ : 0 < δ)
    (hg : AnalyticOnNhd ℂ g (ball 0 R)) (hne : ∀ z ∈ ball 0 R, g z ≠ 0)
    (hlog : ∀ z ∈ ball 0 R, Real.log ‖g z‖ - Real.log ‖g 0‖ ≤ A)
    (w : ℂ) (hw : ‖w‖ ≤ R - δ) : ‖logDeriv g w‖ ≤ 8 * A * R / δ ^ 2 := by
  obtain ⟨F, hF0, hF, heF⟩ := exists_normalized_log_on_ball g R hR hg hne
  have hd : DifferentiableOn ℂ F (ball 0 R) := fun z hz =>
    (hF z hz).differentiableAt.differentiableWithinAt
  have hreal : MapsTo F (ball 0 R) {z : ℂ | z.re ≤ A} := by
    intro z hz
    change (F z).re ≤ A
    rw [normalized_log_re g F z (hne 0 (mem_ball_self hR)) (heF z hz)]
    exact hlog z hz
  have hv (v : ℂ) (hv : v ∈ closedBall w (δ / 2)) : ‖v‖ ≤ R - δ / 2 := by
    have hh := norm_le_norm_sub_add v w
    have hdist : ‖v - w‖ ≤ δ / 2 := by simpa only [mem_closedBall, dist_eq_norm] using hv
    linarith
  have hvball (v : ℂ) (h : v ∈ closedBall w (δ / 2)) : v ∈ ball 0 R := by
    rw [mem_ball, dist_zero_right]
    linarith [hv v h]
  have hdc : DiffContOnCl ℂ F (ball w (δ / 2)) := by
    apply DiffContOnCl.mk_ball
    · intro v hv'
      exact (hF v (hvball v (ball_subset_closedBall hv'))).differentiableAt.differentiableWithinAt
    · exact fun v hv' => (hF v (hvball v hv')).continuousAt.continuousWithinAt
  have hbound : ∀ v ∈ sphere w (δ / 2), ‖F v‖ ≤ 4 * A * R / δ := by
    intro v hv'
    have hvC := sphere_subset_closedBall hv'
    have hnv := hv v hvC
    have hden : 0 < R - ‖v‖ := by linarith
    have hh := Complex.borelCaratheodory_zero hA hd hreal hR (hvball v hvC) hF0
    apply hh.trans
    calc
      2 * A * ‖v‖ / (R - ‖v‖) ≤ 2 * A * R / (R - ‖v‖) := by
        apply div_le_div_of_nonneg_right _ hden.le
        gcongr
        linarith
      _ ≤ 2 * A * R / (δ / 2) :=
        div_le_div_of_nonneg_left (by positivity) (by positivity) (by linarith)
      _ = _ := by field_simp; ring
  have hh := Complex.norm_deriv_le_of_forall_mem_sphere_norm_le
    (by positivity : 0 < δ / 2) hdc hbound
  have hwball : w ∈ ball 0 R := by rw [mem_ball, dist_zero_right]; linarith
  rw [(hF w hwball).deriv] at hh
  convert hh using 1
  field_simp
  ring
end

section

open Complex Metric Set OAI.Ostmann

/-- The zero-free half-plane controls the logarithmic derivative with a fixed
interior margin. The conductor enters only through a logarithm. -/
theorem character_logDeriv_bound (hZ : PrimitiveZeroFreeHalfPlane)
    (χ : PrimitiveComplexCharacter) {ε : ℝ} (hε : 0 < ε) (hε1 : ε ≤ 1)
    (s : ℂ) (hs : 7 / 8 + ε ≤ s.re) (hs2 : s.re ≤ 2) :
    ‖logDeriv χ.L s‖ ≤ (36 / ε ^ 2) *
      Real.log (24 * (χ.modulus : ℝ) * (|s.im| + 2)) := by
  let c : ℂ := 2 + (s.im : ℂ) * I
  let R : ℝ := 9 / 8 - ε / 2
  let g : ℂ → ℂ := fun z => χ.L (z + c)
  let A : ℝ := Real.log (24 * (χ.modulus : ℝ) * (|s.im| + 2))
  have hc : c.re = 2 := by simp [c]
  have hq : (1 : ℝ) ≤ χ.modulus := by exact_mod_cast χ.positive
  have hq0 : (0 : ℝ) < χ.modulus := by linarith
  have hR : 0 < R := by dsimp [R]; linarith
  have hR2 : R < 2 := by dsimp [R]; linarith
  have hA : 0 < A := by
    apply Real.log_pos
    nlinarith [abs_nonneg s.im]
  have hg : AnalyticOnNhd ℂ g (ball 0 R) := by
    intro z hz
    exact (χ.L_analytic (z + c)).comp (f := fun w : ℂ => w + c) (x := z) (by fun_prop)
  have hre (z : ℂ) (hz : z ∈ ball 0 R) : 7 / 8 < (z + c).re := by
    have hn : ‖z‖ < R := by simpa only [mem_ball, dist_zero_right] using hz
    have hr := (abs_le.mp (abs_re_le_norm z)).1
    simp only [add_re, hc]
    dsimp [R] at hn
    linarith
  have hne : ∀ z ∈ ball 0 R, g z ≠ 0 := fun z hz => hZ χ (z + c) (hre z hz)
  have hcnorm : ‖c‖ ≤ 2 + |s.im| := by
    calc
      ‖c‖ ≤ ‖(2 : ℂ)‖ + ‖(s.im : ℂ) * I‖ := norm_add_le _ _
      _ = _ := by simp
  have hnorm (z : ℂ) (hz : z ∈ ball 0 R) :
      ‖g z‖ ≤ 8 * (χ.modulus : ℝ) * (|s.im| + 2) := by
    have hn : ‖z‖ < R := by simpa only [mem_ball, dist_zero_right] using hz
    have hzn : ‖z + c‖ ≤ 2 * (|s.im| + 2) := by
      have hh := norm_add_le z c
      linarith [abs_nonneg s.im]
    have hzr : 1 / 2 ≤ (z + c).re := by linarith [hre z hz]
    calc
      ‖g z‖ ≤ ‖z + c‖ * ((χ.modulus : ℝ) + 1) / (z + c).re :=
        χ.L_norm_bound_positive (z + c) (by linarith)
      _ ≤ (2 * (|s.im| + 2)) * (2 * (χ.modulus : ℝ)) / (1 / 2) := by
        apply div_le_div₀ (by positivity) _ (by norm_num) hzr
        exact mul_le_mul hzn (by linarith) (by positivity) (by positivity)
      _ = _ := by ring
  have hlog : ∀ z ∈ ball 0 R, Real.log ‖g z‖ - Real.log ‖g 0‖ ≤ A := by
    intro z hz
    have h0 : 1 / 3 ≤ ‖g 0‖ := by simpa [g] using χ.L_lower_re_two c hc
    have h0pos : 0 < ‖g 0‖ := by linarith
    have hzpos : 0 < ‖g z‖ := norm_pos_iff.mpr (hne z hz)
    rw [← Real.log_div (ne_of_gt hzpos) (ne_of_gt h0pos)]
    apply Real.log_le_log (div_pos hzpos h0pos)
    apply (div_le_iff₀ h0pos).mpr
    have hh := mul_le_mul_of_nonneg_left h0
      (show 0 ≤ 24 * (χ.modulus : ℝ) * (|s.im| + 2) by positivity)
    nlinarith [hnorm z hz]
  have hw : ‖s - c‖ ≤ R - ε / 2 := by
    have heq : s - c = ((s.re - 2 : ℝ) : ℂ) := by
      apply Complex.ext <;> simp [c]
    rw [heq, norm_real, Real.norm_eq_abs, abs_of_nonpos (by linarith)]
    dsimp [R]
    linarith
  have hb := logDeriv_norm_le_margin_disk g R A (ε / 2) hR hA
    (by positivity) hg hne hlog (s - c) hw
  have hcomp : logDeriv g (s - c) = logDeriv χ.L s := by
    have hh := logDeriv_comp (f := χ.L) (g := fun z : ℂ => z + c) (x := s - c)
      (χ.L_analytic ((s - c) + c)).differentiableAt
      (show DifferentiableAt ℂ (fun z : ℂ => z + c) (s - c) by fun_prop)
    simpa [g, Function.comp_def] using hh
  rw [hcomp] at hb
  calc
    _ ≤ 8 * A * R / (ε / 2) ^ 2 := hb
    _ ≤ 8 * A * (9 / 8) / (ε / 2) ^ 2 := by
      apply div_le_div_of_nonneg_right _ (sq_nonneg _)
      gcongr
      dsimp [R]
      linarith
    _ = _ := by dsimp [A]; field_simp; ring
end

section

open OAI.Ostmann Complex Metric Set

/-- The nontrivial zeros up to any finite height form a finite set, using
analyticity and nontriviality of the L-function. No zero-free input is needed. -/
theorem finite_character_zeros_in_strip (χ : PrimitiveComplexCharacter) (T : ℝ) :
    {z : ℂ | χ.L z = 0 ∧ 0 < z.re ∧ z.re < 1 ∧ |z.im| ≤ T}.Finite := by
  have ha : AnalyticOnNhd ℂ χ.L (closedBall 0 (T + 2)) := fun z _ => χ.L_analytic z
  have hf := (MeromorphicOn.divisor χ.L (closedBall 0 (T + 2))).finiteSupport
    (isCompact_closedBall 0 (T + 2))
  apply hf.subset
  intro z hz
  have hball : z ∈ closedBall 0 (T + 2) := by
    rw [mem_closedBall, dist_zero_right]
    have hn := norm_le_abs_re_add_abs_im z
    rw [abs_of_pos hz.2.1] at hn
    linarith [hz.2.2.1, hz.2.2.2]
  rw [Function.mem_support, MeromorphicOn.AnalyticOnNhd.divisor_apply ha hball]
  have hnot0 := (χ.L_analytic z).analyticOrderAt_ne_zero.mpr hz.1
  lift analyticOrderAt χ.L z to ℕ using χ.L_order_ne_top z with n hn
  have hn0 : n ≠ 0 := by
    intro he
    apply hnot0
    simp [he]
  simpa using hn0

/-- A finite enumerator contains precisely the actual nontrivial zeros in the
truncation region. Multiplicity remains encoded by `characterZeroOrder`. -/
theorem exists_character_zero_finset (χ : PrimitiveComplexCharacter) (T : ℝ) :
    ∃ S : Finset ℂ, ∀ z : ℂ, z ∈ S ↔
      χ.L z = 0 ∧ 0 < z.re ∧ z.re < 1 ∧ |z.im| ≤ T := by
  classical
  exact ⟨(finite_character_zeros_in_strip χ T).toFinset, fun z => by simp⟩
end

section
open Finset
/-- A dyadic zero-term bound with all zeros confined to the explicit substrip. -/
theorem character_zero_term_dyadic_le
    (χ : OAI.Ostmann.PrimitiveComplexCharacter) (S : Finset ℂ)
    (K : ℕ) {x : ℝ} (hx : 2 ≤ x)
    (hS : ∀ z ∈ S, (1 : ℝ) / 8 ≤ z.re ∧ z.re ≤ 7 / 8 ∧ |z.im| ≤ (2 : ℝ) ^ K) :
    ‖∑ z ∈ S, (OAI.Ostmann.characterZeroOrder χ z : ℂ) * (((x : ℂ) ^ z - 1) / z)‖ ≤
      (1024 / Real.log (14 / 13)) * x ^ ((7 : ℝ) / 8) * (K + 1 : ℕ) *
        Real.log ((χ.modulus : ℝ) * ((2 : ℝ) ^ K + 2)) := by
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hxp : 1 ≤ x ^ ((7 : ℝ) / 8) := Real.one_le_rpow hx1 (by norm_num)
  have hcount := character_reciprocal_zero_sum_le χ S K (by
    intro z hz
    exact ⟨(hS z hz).1, by linarith [(hS z hz).2.1], (hS z hz).2.2⟩)
  have hterm (z : ℂ) (hz : z ∈ S) :
      ‖(OAI.Ostmann.characterZeroOrder χ z : ℂ) * (((x : ℂ) ^ z - 1) / z)‖ ≤
        (2 * x ^ ((7 : ℝ) / 8)) * ((OAI.Ostmann.characterZeroOrder χ z : ℝ) / ‖z‖) := by
    have hw : 0 ≤ (OAI.Ostmann.characterZeroOrder χ z : ℝ) := by
      exact_mod_cast OAI.Ostmann.characterZeroOrder_nonneg χ z
    have hn : ‖(x : ℂ) ^ z - 1‖ ≤ 2 * x ^ ((7 : ℝ) / 8) := by
      calc
        _ ≤ ‖(x : ℂ) ^ z‖ + ‖(1 : ℂ)‖ := norm_sub_le _ _
        _ = x ^ z.re + 1 := by rw [Complex.norm_cpow_eq_rpow_re_of_pos hx0, norm_one]
        _ ≤ x ^ ((7 : ℝ) / 8) + 1 := by
          gcongr
          exact (hS z hz).2.1
        _ ≤ 2 * x ^ ((7 : ℝ) / 8) := by linarith
    rw [norm_mul, norm_div, Complex.norm_intCast, abs_of_nonneg hw]
    calc
      _ ≤ (OAI.Ostmann.characterZeroOrder χ z : ℝ) *
          ((2 * x ^ ((7 : ℝ) / 8)) / ‖z‖) :=
        mul_le_mul_of_nonneg_left (div_le_div_of_nonneg_right hn (norm_nonneg _)) hw
      _ = _ := by ring
  calc
    _ ≤ ∑ z ∈ S, ‖(OAI.Ostmann.characterZeroOrder χ z : ℂ) *
        (((x : ℂ) ^ z - 1) / z)‖ := norm_sum_le _ _
    _ ≤ ∑ z ∈ S, (2 * x ^ ((7 : ℝ) / 8)) *
        ((OAI.Ostmann.characterZeroOrder χ z : ℝ) / ‖z‖) := sum_le_sum hterm
    _ = (2 * x ^ ((7 : ℝ) / 8)) *
        ∑ z ∈ S, (OAI.Ostmann.characterZeroOrder χ z : ℝ) / ‖z‖ := (mul_sum _ _ _).symm
    _ ≤ (2 * x ^ ((7 : ℝ) / 8)) *
        ((512 / Real.log (14 / 13)) * (K + 1 : ℕ) *
          Real.log ((χ.modulus : ℝ) * ((2 : ℝ) ^ K + 2))) := by gcongr
    _ = _ := by ring

/-- Every real height at least two is covered by a dyadic height with controlled
size and with logarithmically many levels. -/
theorem exists_dyadic_height {T : ℝ} (hT : 2 ≤ T) :
    ∃ K : ℕ, T ≤ (2 : ℝ) ^ K ∧ (2 : ℝ) ^ K ≤ 2 * T ∧
      (K + 1 : ℕ) ≤ 6 * Real.log T := by
  have hT0 : 0 < T := by linarith
  have hlogb : 0 ≤ Real.logb 2 T := Real.logb_nonneg (by norm_num) (by linarith)
  refine ⟨⌈Real.logb 2 T⌉₊, ?_, ?_, ?_⟩
  · have h := (Real.logb_le_iff_le_rpow (by norm_num : (1 : ℝ) < 2) hT0).mp
      (Nat.le_ceil (Real.logb 2 T))
    simpa only [Real.rpow_natCast] using h
  · have h := Real.rpow_le_rpow_of_exponent_le (by norm_num : (1 : ℝ) ≤ 2)
      (Nat.ceil_lt_add_one hlogb).le
    rw [Real.rpow_natCast, Real.rpow_add (by norm_num),
      Real.rpow_logb (by norm_num) (by norm_num) hT0, Real.rpow_one] at h
    linarith
  · have hhalf : (1 : ℝ) / 2 ≤ Real.log 2 := by
      have h := Real.one_sub_inv_le_log_of_pos (by norm_num : (0 : ℝ) < 2)
      norm_num at h ⊢
      exact h
    have hlogT : (1 : ℝ) / 2 ≤ Real.log T :=
      hhalf.trans (Real.log_le_log (by norm_num) hT)
    have hratio : Real.logb 2 T ≤ 2 * Real.log T := by
      unfold Real.logb
      apply (div_le_iff₀ (show 0 < Real.log 2 by linarith)).mpr
      nlinarith [mul_nonneg (show 0 ≤ Real.log T by linarith)
        (show 0 ≤ Real.log 2 - 1 / 2 by linarith)]
    have hceil := Nat.ceil_lt_add_one hlogb
    push_cast
    linarith

/-- The conductor-height logarithm changes by only an absolute factor under
the dyadic enlargement used above. -/
theorem dyadic_conductor_log_le {q T H : ℝ} (hq : 1 ≤ q) (hT : 2 ≤ T)
    (hH0 : 0 ≤ H) (hH : H ≤ 2 * T) :
    Real.log (q * (H + 2)) ≤ 3 * Real.log (q * T) := by
  have hq0 : 0 < q := by linarith
  have hQT : 2 ≤ q * T := by
    nlinarith [mul_nonneg (sub_nonneg.mpr hq) (show 0 ≤ T by linarith)]
  have hcube : 3 * (q * T) ≤ (q * T) ^ (3 : ℕ) := by
    have hs : 3 ≤ (q * T) ^ (2 : ℕ) := by nlinarith
    have hm := mul_le_mul_of_nonneg_left hs (show 0 ≤ q * T by linarith)
    nlinarith
  have hbound : q * (H + 2) ≤ (q * T) ^ (3 : ℕ) := by
    calc
      q * (H + 2) ≤ q * (3 * T) := by gcongr; linarith
      _ = 3 * (q * T) := by ring
      _ ≤ _ := hcube
  have h := Real.log_le_log (show 0 < q * (H + 2) by positivity) hbound
  simpa only [Real.log_pow, Nat.cast_ofNat] using h

/-- The actual truncated zero term has the conventional conductor-height bound,
with one absolute explicit constant and explicit strip hypotheses. -/
theorem character_truncated_zero_sum_le
    (χ : OAI.Ostmann.PrimitiveComplexCharacter) (S : Finset ℂ)
    {x T : ℝ} (hx : 2 ≤ x) (hT : 2 ≤ T)
    (hS : ∀ z ∈ S, (1 : ℝ) / 8 ≤ z.re ∧ z.re ≤ 7 / 8 ∧ |z.im| ≤ T) :
    ‖∑ z ∈ S, (OAI.Ostmann.characterZeroOrder χ z : ℂ) * (((x : ℂ) ^ z - 1) / z)‖ ≤
      (18432 / Real.log (14 / 13)) * x ^ ((7 : ℝ) / 8) *
        Real.log ((χ.modulus : ℝ) * T) * Real.log T := by
  obtain ⟨K, hTK, hKT, hlevels⟩ := exists_dyadic_height hT
  have hdyadic := character_zero_term_dyadic_le χ S K hx (by
    intro z hz
    exact ⟨(hS z hz).1, (hS z hz).2.1, (hS z hz).2.2.trans hTK⟩)
  have hq : (1 : ℝ) ≤ χ.modulus := by exact_mod_cast χ.positive
  have hq0 : (0 : ℝ) < χ.modulus := by exact_mod_cast χ.positive
  have hden : 0 < Real.log (14 / 13 : ℝ) := Real.log_pos (by norm_num)
  have hlog := dyadic_conductor_log_le hq hT (by positivity : 0 ≤ (2 : ℝ) ^ K) hKT
  have hlog0 : 0 ≤ Real.log ((χ.modulus : ℝ) * ((2 : ℝ) ^ K + 2)) := by
    apply Real.log_nonneg
    have hp : 0 ≤ (2 : ℝ) ^ K := by positivity
    nlinarith [mul_nonneg (sub_nonneg.mpr hq) hp]
  have hlogT0 : 0 ≤ Real.log T := Real.log_nonneg (by linarith)
  calc
    _ ≤ (1024 / Real.log (14 / 13)) * x ^ ((7 : ℝ) / 8) * (K + 1 : ℕ) *
        Real.log ((χ.modulus : ℝ) * ((2 : ℝ) ^ K + 2)) := hdyadic
    _ ≤ (1024 / Real.log (14 / 13)) * x ^ ((7 : ℝ) / 8) *
        (6 * Real.log T) * (3 * Real.log ((χ.modulus : ℝ) * T)) := by gcongr
    _ = _ := by ring
end

section

/-- A weighted Cauchy--Schwarz estimate for one complex matrix row. -/
theorem complex_row_weighted_cauchy {ι : Type*} (s : Finset ι)
    (K f : ι → ℂ) (v : ι → ℝ) (hv : ∀ j ∈ s, 0 < v j) :
    ‖∑ j ∈ s, K j * f j‖ ^ 2 ≤
      (∑ j ∈ s, ‖K j‖ * v j) * ∑ j ∈ s, ‖K j‖ * ‖f j‖ ^ 2 / v j := by
  have hnorm : ‖∑ j ∈ s, K j * f j‖ ≤ ∑ j ∈ s, ‖K j‖ * ‖f j‖ := by
    simpa only [norm_mul] using norm_sum_le s (fun j => K j * f j)
  have hsq : ‖∑ j ∈ s, K j * f j‖ ^ 2 ≤ (∑ j ∈ s, ‖K j‖ * ‖f j‖) ^ 2 :=
    (sq_le_sq₀ (norm_nonneg _) (Finset.sum_nonneg fun j _ => by positivity)).mpr hnorm
  refine hsq.trans (Finset.sum_sq_le_sum_mul_sum_of_sq_le_mul s ?_ ?_ ?_)
  · intro j hj
    exact mul_nonneg (norm_nonneg _) (hv j hj).le
  · intro j hj
    exact div_nonneg (by positivity) (hv j hj).le
  · intro j hj
    have hvj : v j ≠ 0 := (hv j hj).ne'
    apply le_of_eq
    field_simp

/-- Weighted Schur for a transition matrix. No symmetry is assumed. The column
bound uses the underlying measure, and the matrix action itself is unweighted. -/
theorem finite_weighted_schur_transition {ι : Type*} (s : Finset ι)
    (μ v : ι → ℝ) (K : ι → ι → ℂ)
    (hμ : ∀ i ∈ s, 0 ≤ μ i) (hv : ∀ i ∈ s, 0 < v i)
    {A B : ℝ}
    (hrow : ∀ i ∈ s, (∑ j ∈ s, ‖K i j‖ * v j) ≤ A * v i)
    (hcol : ∀ j ∈ s, (∑ i ∈ s, μ i * ‖K i j‖ * v i) ≤ B * μ j * v j)
    (f : ι → ℂ) :
    (∑ i ∈ s, μ i * ‖∑ j ∈ s, K i j * f j‖ ^ 2) ≤
      A * B * ∑ j ∈ s, μ j * ‖f j‖ ^ 2 := by
  classical
  rcases s.eq_empty_or_nonempty with rfl | ⟨i₀, hi₀⟩
  · simp
  have hA : 0 ≤ A := by
    have hsum : 0 ≤ ∑ j ∈ s, ‖K i₀ j‖ * v j :=
      Finset.sum_nonneg fun j hj => mul_nonneg (norm_nonneg _) (hv j hj).le
    have hAv : 0 ≤ A * v i₀ := hsum.trans (hrow i₀ hi₀)
    exact nonneg_of_mul_nonneg_left hAv (hv i₀ hi₀)
  have hpoint : ∀ i ∈ s, ‖∑ j ∈ s, K i j * f j‖ ^ 2 ≤
      A * v i * ∑ j ∈ s, ‖K i j‖ * ‖f j‖ ^ 2 / v j := by
    intro i hi
    exact (complex_row_weighted_cauchy s (K i) f v hv).trans
      (mul_le_mul_of_nonneg_right (hrow i hi)
        (Finset.sum_nonneg fun j hj => div_nonneg (by positivity) (hv j hj).le))
  calc
    (∑ i ∈ s, μ i * ‖∑ j ∈ s, K i j * f j‖ ^ 2) ≤
        ∑ i ∈ s, μ i * (A * v i * ∑ j ∈ s, ‖K i j‖ * ‖f j‖ ^ 2 / v j) :=
      Finset.sum_le_sum fun i hi => mul_le_mul_of_nonneg_left (hpoint i hi) (hμ i hi)
    _ = A * ∑ j ∈ s, (‖f j‖ ^ 2 / v j) * ∑ i ∈ s, μ i * ‖K i j‖ * v i := by
      simp_rw [Finset.mul_sum]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro j hj
      apply Finset.sum_congr rfl
      intro i hi
      ring
    _ ≤ A * ∑ j ∈ s, (‖f j‖ ^ 2 / v j) * (B * μ j * v j) := by
      apply mul_le_mul_of_nonneg_left _ hA
      apply Finset.sum_le_sum
      intro j hj
      exact mul_le_mul_of_nonneg_left (hcol j hj) (div_nonneg (sq_nonneg _) (hv j hj).le)
    _ = A * B * ∑ j ∈ s, μ j * ‖f j‖ ^ 2 := by
      simp_rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro j hj
      have hvj : v j ≠ 0 := (hv j hj).ne'
      field_simp

/-- A weighted transpose identity turns row bounds for two kernels into the
column bound needed by Schur. The kernels need not be symmetric or equal. -/
theorem finite_weighted_schur_of_transpose {ι : Type*} (s : Finset ι)
    (μ v : ι → ℝ) (K K' : ι → ι → ℂ)
    (hμ : ∀ i ∈ s, 0 ≤ μ i) (hv : ∀ i ∈ s, 0 < v i)
    (htranspose : ∀ i ∈ s, ∀ j ∈ s,
      (μ i : ℂ) * K i j = (μ j : ℂ) * K' j i)
    {A B : ℝ}
    (hrow : ∀ i ∈ s, (∑ j ∈ s, ‖K i j‖ * v j) ≤ A * v i)
    (hrow' : ∀ j ∈ s, (∑ i ∈ s, ‖K' j i‖ * v i) ≤ B * v j)
    (f : ι → ℂ) :
    (∑ i ∈ s, μ i * ‖∑ j ∈ s, K i j * f j‖ ^ 2) ≤
      A * B * ∑ j ∈ s, μ j * ‖f j‖ ^ 2 := by
  apply finite_weighted_schur_transition s μ v K hμ hv hrow
  intro j hj
  calc
    (∑ i ∈ s, μ i * ‖K i j‖ * v i) =
        μ j * ∑ i ∈ s, ‖K' j i‖ * v i := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i hi
      have hn : μ i * ‖K i j‖ = μ j * ‖K' j i‖ := by
        have he := congrArg norm (htranspose i hi j hj)
        simpa [abs_of_nonneg (hμ i hi), abs_of_nonneg (hμ j hj)] using he
      rw [hn, mul_assoc]
    _ ≤ μ j * (B * v j) := mul_le_mul_of_nonneg_left (hrow' j hj) (hμ j hj)
    _ = B * μ j * v j := by ring

/-- Weighted Schur for an integral kernel, with the measure included in the
operator action and in each row and column sum. Zero measure atoms are allowed. -/
theorem finite_weighted_schur {ι : Type*} (s : Finset ι)
    (μ v : ι → ℝ) (K : ι → ι → ℂ)
    (hμ : ∀ i ∈ s, 0 ≤ μ i) (hv : ∀ i ∈ s, 0 < v i)
    {A B : ℝ}
    (hrow : ∀ i ∈ s, (∑ j ∈ s, μ j * ‖K i j‖ * v j) ≤ A * v i)
    (hcol : ∀ j ∈ s, (∑ i ∈ s, μ i * ‖K i j‖ * v i) ≤ B * v j)
    (f : ι → ℂ) :
    (∑ i ∈ s, μ i * ‖∑ j ∈ s, (μ j : ℂ) * K i j * f j‖ ^ 2) ≤
      A * B * ∑ j ∈ s, μ j * ‖f j‖ ^ 2 := by
  have hnorm : ∀ i j, j ∈ s → ‖(μ j : ℂ) * K i j‖ = μ j * ‖K i j‖ := by
    intro i j hj
    simp [abs_of_nonneg (hμ j hj)]
  apply finite_weighted_schur_transition s μ v (fun i j => (μ j : ℂ) * K i j) hμ hv
  · intro i hi
    convert hrow i hi using 1
    apply Finset.sum_congr rfl
    intro j hj
    rw [hnorm i j hj]
  · intro j hj
    calc
      (∑ i ∈ s, μ i * ‖(μ j : ℂ) * K i j‖ * v i) =
          μ j * ∑ i ∈ s, μ i * ‖K i j‖ * v i := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro i hi
        rw [hnorm i j hj]
        ring
      _ ≤ μ j * (B * v j) := mul_le_mul_of_nonneg_left (hcol j hj) (hμ j hj)
      _ = B * μ j * v j := by ring

/-- The square-root formulation of the transition-matrix estimate. -/
theorem finite_weighted_schur_transition_norm {ι : Type*} (s : Finset ι)
    (μ v : ι → ℝ) (K : ι → ι → ℂ)
    (hμ : ∀ i ∈ s, 0 ≤ μ i) (hv : ∀ i ∈ s, 0 < v i)
    {A B : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hrow : ∀ i ∈ s, (∑ j ∈ s, ‖K i j‖ * v j) ≤ A * v i)
    (hcol : ∀ j ∈ s, (∑ i ∈ s, μ i * ‖K i j‖ * v i) ≤ B * μ j * v j)
    (f : ι → ℂ) :
    Real.sqrt (∑ i ∈ s, μ i * ‖∑ j ∈ s, K i j * f j‖ ^ 2) ≤
      Real.sqrt (A * B) * Real.sqrt (∑ j ∈ s, μ j * ‖f j‖ ^ 2) := by
  have h := Real.sqrt_le_sqrt (finite_weighted_schur_transition s μ v K hμ hv hrow hcol f)
  simpa only [Real.sqrt_mul (mul_nonneg hA hB)] using h
end

section

noncomputable def tensorSchurWeight {ι α : Type*} [Fintype ι]
    (v : ι → α → ℝ) (x : ι → α) : ℝ := ∏ i, v i (x i)

noncomputable def tensorSchurKernel {ι α : Type*} [Fintype ι]
    (K : ι → α → α → ℂ) (x y : ι → α) : ℂ := ∏ i, K i (x i) (y i)

theorem tensorSchurWeight_nonneg {ι α : Type*} [Fintype ι]
    (v : ι → α → ℝ) (hv : ∀ i a, 0 ≤ v i a) (x : ι → α) :
    0 ≤ tensorSchurWeight v x :=
  Finset.prod_nonneg fun i _ => hv i (x i)

theorem tensorSchurWeight_pos {ι α : Type*} [Fintype ι]
    (v : ι → α → ℝ) (hv : ∀ i a, 0 < v i a) (x : ι → α) :
    0 < tensorSchurWeight v x :=
  Finset.prod_pos fun i _ => hv i (x i)

/-- The absolute weighted row sum of a finite tensor kernel factors exactly. -/
theorem tensor_schur_row_sum {ι α : Type*} [Fintype ι] [Fintype α] [DecidableEq ι]
    (K : ι → α → α → ℂ) (v : ι → α → ℝ) (x : ι → α) :
    (∑ y : ι → α, ‖tensorSchurKernel K x y‖ * tensorSchurWeight v y) =
      ∏ i, ∑ b, ‖K i (x i) b‖ * v i b := by
  classical
  unfold tensorSchurKernel tensorSchurWeight
  simp_rw [norm_prod, ← Finset.prod_mul_distrib]
  exact (Fintype.prod_sum fun i b => ‖K i (x i) b‖ * v i b).symm

/-- Coordinate row bounds multiply, without symmetry or sign conditions on the
complex kernels. -/
theorem tensor_schur_row_bound {ι α : Type*} [Fintype ι] [Fintype α] [DecidableEq ι]
    (K : ι → α → α → ℂ) (v : ι → α → ℝ) (A : ι → ℝ)
    (hv : ∀ i a, 0 ≤ v i a)
    (hrow : ∀ i a, (∑ b, ‖K i a b‖ * v i b) ≤ A i * v i a)
    (x : ι → α) :
    (∑ y : ι → α, ‖tensorSchurKernel K x y‖ * tensorSchurWeight v y) ≤
      (∏ i, A i) * tensorSchurWeight v x := by
  rw [tensor_schur_row_sum]
  unfold tensorSchurWeight
  rw [← Finset.prod_mul_distrib]
  exact Finset.prod_le_prod₀
    (fun i _ => Finset.sum_nonneg fun b _ => mul_nonneg (norm_nonneg _) (hv i b))
    (fun i _ => hrow i (x i))

/-- Coordinate weighted transpose identities multiply to a weighted transpose
identity for the tensor kernel. -/
theorem tensor_schur_weighted_transpose {ι α : Type*} [Fintype ι]
    (μ : ι → α → ℝ) (K K' : ι → α → α → ℂ)
    (htranspose : ∀ i a b, (μ i a : ℂ) * K i a b = (μ i b : ℂ) * K' i b a)
    (x y : ι → α) :
    (tensorSchurWeight μ x : ℂ) * tensorSchurKernel K x y =
      (tensorSchurWeight μ y : ℂ) * tensorSchurKernel K' y x := by
  unfold tensorSchurWeight tensorSchurKernel
  simp only [Complex.ofReal_prod, ← Finset.prod_mul_distrib]
  exact Finset.prod_congr rfl fun i _ => htranspose i (x i) (y i)

/-- Full absolute row estimates survive restriction to an arbitrary finite
cutoff, hence control the actual restricted operator in weighted squared L2. -/
theorem finite_weighted_schur_cutoff {α : Type*} [Fintype α]
    (S : Finset α) (μ v : α → ℝ) (K K' : α → α → ℂ)
    (hμ : ∀ a, 0 ≤ μ a) (hv : ∀ a, 0 < v a)
    (htranspose : ∀ a b, (μ a : ℂ) * K a b = (μ b : ℂ) * K' b a)
    {A B : ℝ}
    (hrow : ∀ a, (∑ b, ‖K a b‖ * v b) ≤ A * v a)
    (hrow' : ∀ a, (∑ b, ‖K' a b‖ * v b) ≤ B * v a)
    (f : α → ℂ) :
    (∑ a ∈ S, μ a * ‖∑ b ∈ S, K a b * f b‖ ^ 2) ≤
      A * B * ∑ b ∈ S, μ b * ‖f b‖ ^ 2 := by
  apply finite_weighted_schur_of_transpose S μ v K K'
    (fun a _ => hμ a) (fun a _ => hv a)
    (fun a _ b _ => htranspose a b)
  · intro a ha
    exact (Finset.sum_le_univ_sum_of_nonneg
      (fun b => mul_nonneg (norm_nonneg _) (hv b).le)).trans (hrow a)
  · intro a ha
    exact (Finset.sum_le_univ_sum_of_nonneg
      (fun b => mul_nonneg (norm_nonneg _) (hv b).le)).trans (hrow' a)

/-- Tensorized coordinate bounds control every finite cutoff of the product
state space, including cutoffs coupling different coordinates. -/
theorem tensor_schur_cutoff {ι α : Type*} [Fintype ι] [Fintype α] [DecidableEq ι]
    (S : Finset (ι → α)) (μ v : ι → α → ℝ) (K K' : ι → α → α → ℂ)
    (hμ : ∀ i a, 0 ≤ μ i a) (hv : ∀ i a, 0 < v i a)
    (htranspose : ∀ i a b, (μ i a : ℂ) * K i a b = (μ i b : ℂ) * K' i b a)
    (A B : ι → ℝ)
    (hrow : ∀ i a, (∑ b, ‖K i a b‖ * v i b) ≤ A i * v i a)
    (hrow' : ∀ i a, (∑ b, ‖K' i a b‖ * v i b) ≤ B i * v i a)
    (f : (ι → α) → ℂ) :
    (∑ x ∈ S, tensorSchurWeight μ x *
      ‖∑ y ∈ S, tensorSchurKernel K x y * f y‖ ^ 2) ≤
      (∏ i, A i) * (∏ i, B i) * ∑ y ∈ S, tensorSchurWeight μ y * ‖f y‖ ^ 2 := by
  apply finite_weighted_schur_cutoff S (tensorSchurWeight μ) (tensorSchurWeight v)
    (tensorSchurKernel K) (tensorSchurKernel K')
    (tensorSchurWeight_nonneg μ hμ) (tensorSchurWeight_pos v hv)
    (tensor_schur_weighted_transpose μ K K' htranspose)
  · exact tensor_schur_row_bound K v A (fun i a => (hv i a).le) hrow
  · exact tensor_schur_row_bound K' v B (fun i a => (hv i a).le) hrow'
end

section
open Finset
/-- The factorial weight of a single species with occupancy `n`. -/
noncomputable def ghostWeight (ν : ℝ) (n : ℕ) : ℝ := ν ^ n / (n.factorial : ℝ)

/-- A ghost transition retains `k` old particles, terminates the others, and
creates `m-k` particles. The birth coefficient is `C`, the termination coefficient `D`. -/
noncomputable def ghostKernel (A D C ν : ℝ) (n m : ℕ) : ℝ :=
  ∑ k ∈ range (min n m + 1),
    (n.choose k : ℝ) * A ^ k * D ^ (n - k) * (C * ν) ^ (m - k) /
      ((m - k).factorial : ℝ)

/-- Choosing particles cancels the corresponding occupancy factorials. -/
theorem ghostWeight_mul_choose (ν : ℝ) {n k : ℕ} (hk : k ≤ n) :
    ghostWeight ν n * (n.choose k : ℝ) =
      ν ^ n / ((k.factorial : ℝ) * ((n - k).factorial : ℝ)) := by
  have hn : (n.factorial : ℝ) ≠ 0 := by positivity
  have hkf : (k.factorial : ℝ) ≠ 0 := by positivity
  have hnk : ((n - k).factorial : ℝ) ≠ 0 := by positivity
  have hfac : (n.choose k : ℝ) * (k.factorial : ℝ) * ((n - k).factorial : ℝ) =
      (n.factorial : ℝ) := by exact_mod_cast Nat.choose_mul_factorial_mul_factorial hk
  unfold ghostWeight
  field_simp
  linear_combination (ν ^ n) * hfac

/-- Weighted transposition exchanges births and terminations. This remains exact
for any finite occupancy cutoff, including repeated particles of the same species. -/
theorem ghostKernel_weighted_transpose (A D C ν : ℝ) (n m : ℕ) :
    ghostWeight ν n * ghostKernel A D C ν n m =
      ghostWeight ν m * ghostKernel A C D ν m n := by
  unfold ghostKernel
  rw [mul_sum, mul_sum, min_comm m n]
  apply sum_congr rfl
  intro k hk
  have hkn : k ≤ n := (Nat.le_min.mp (Nat.le_of_lt_succ (mem_range.mp hk))).1
  have hkm : k ≤ m := (Nat.le_min.mp (Nat.le_of_lt_succ (mem_range.mp hk))).2
  have hn : ν ^ n = ν ^ k * ν ^ (n - k) := by
    rw [← pow_add, Nat.add_sub_of_le hkn]
  have hm : ν ^ m = ν ^ k * ν ^ (m - k) := by
    rw [← pow_add, Nat.add_sub_of_le hkm]
  calc
    ghostWeight ν n * ((n.choose k : ℝ) * A ^ k * D ^ (n - k) *
        (C * ν) ^ (m - k) / ((m - k).factorial : ℝ)) =
      (ghostWeight ν n * (n.choose k : ℝ)) * A ^ k * D ^ (n - k) *
        (C * ν) ^ (m - k) / ((m - k).factorial : ℝ) := by ring
    _ = (ghostWeight ν m * (m.choose k : ℝ)) * A ^ k * C ^ (m - k) *
        (D * ν) ^ (n - k) / ((n - k).factorial : ℝ) := by
      rw [ghostWeight_mul_choose ν hkn, ghostWeight_mul_choose ν hkm, hn, hm, mul_pow, mul_pow]
      ring
    _ = ghostWeight ν m * ((m.choose k : ℝ) * A ^ k * C ^ (m - k) *
        (D * ν) ^ (n - k) / ((n - k).factorial : ℝ)) := by ring

/-- Reindex a finite birth-and-retention sum by the number retained and then born. -/
theorem ghost_triangular_sum (f : ℕ → ℕ → ℝ) (n B : ℕ) :
    (∑ m ∈ range (B + 1), ∑ k ∈ range (min n m + 1), f k (m - k)) =
      ∑ k ∈ range (n + 1), ∑ b ∈ range (B + 1 - k), f k b := by
  have hinner (m : ℕ) :
      (∑ k ∈ range (min n m + 1), f k (m - k)) =
        ∑ k ∈ range (n + 1), if k ≤ m then f k (m - k) else 0 := by
    calc
      _ = ∑ k ∈ range (min n m + 1), if k ≤ m then f k (m - k) else 0 := by
        apply sum_congr rfl
        intro k hk
        have hkm : k ≤ m := (Nat.le_min.mp (Nat.le_of_lt_succ (mem_range.mp hk))).2
        rw [if_pos hkm]
      _ = _ := by
        apply sum_subset
        · intro k hk
          simp only [mem_range] at *
          omega
        · intro k hk hnot
          simp only [mem_range] at hk hnot
          rw [if_neg (by omega)]
  simp_rw [hinner]
  rw [sum_comm]
  apply sum_congr rfl
  intro k hk
  rw [← sum_filter]
  have hfilter : (range (B + 1)).filter (fun m => k ≤ m) = Ico k (B + 1) := by
    ext m
    simp only [mem_filter, mem_range, mem_Ico]
    omega
  rw [hfilter, sum_Ico_eq_sum_range]
  apply sum_congr rfl
  intro b hb
  rw [Nat.add_sub_cancel_left]

/-- Exact finite row formula after separating retained particles from births. -/
theorem ghostKernel_row_sum (A D C ν v : ℝ) (n B : ℕ) :
    (∑ m ∈ range (B + 1), ghostKernel A D C ν n m * v ^ m) =
      ∑ k ∈ range (n + 1),
        ((n.choose k : ℝ) * A ^ k * D ^ (n - k) * v ^ k) *
          ∑ b ∈ range (B + 1 - k), (C * ν * v) ^ b / (b.factorial : ℝ) := by
  calc
    _ = ∑ m ∈ range (B + 1), ∑ k ∈ range (min n m + 1),
        ((n.choose k : ℝ) * A ^ k * D ^ (n - k) * v ^ k) *
          ((C * ν * v) ^ (m - k) / ((m - k).factorial : ℝ)) := by
      apply sum_congr rfl
      intro m hm
      unfold ghostKernel
      rw [sum_mul]
      apply sum_congr rfl
      intro k hk
      have hkm : k ≤ m := (Nat.le_min.mp (Nat.le_of_lt_succ (mem_range.mp hk))).2
      have hv : v ^ m = v ^ k * v ^ (m - k) := by
        rw [← pow_add, Nat.add_sub_of_le hkm]
      rw [hv, mul_pow]
      ring
    _ = ∑ k ∈ range (n + 1), ∑ b ∈ range (B + 1 - k),
        ((n.choose k : ℝ) * A ^ k * D ^ (n - k) * v ^ k) *
          ((C * ν * v) ^ b / (b.factorial : ℝ)) :=
      ghost_triangular_sum (fun k b =>
        ((n.choose k : ℝ) * A ^ k * D ^ (n - k) * v ^ k) *
          ((C * ν * v) ^ b / (b.factorial : ℝ))) n B
    _ = _ := by simp_rw [mul_sum]

/-- The truncated positive row is bounded uniformly in the truncation level. -/
theorem ghostKernel_row_le (A D C ν v : ℝ) (n B : ℕ)
    (hA : 0 ≤ A) (hD : 0 ≤ D) (hC : 0 ≤ C) (hν : 0 ≤ ν) (hv : 0 ≤ v) :
    (∑ m ∈ range (B + 1), ghostKernel A D C ν n m * v ^ m) ≤
      Real.exp (C * ν * v) * (A * v + D) ^ n := by
  rw [ghostKernel_row_sum]
  calc
    _ ≤ ∑ k ∈ range (n + 1),
        ((n.choose k : ℝ) * A ^ k * D ^ (n - k) * v ^ k) * Real.exp (C * ν * v) := by
      apply sum_le_sum
      intro k hk
      apply mul_le_mul_of_nonneg_left
      · exact Real.sum_le_exp_of_nonneg (by positivity) _
      · positivity
    _ = Real.exp (C * ν * v) * (A * v + D) ^ n := by
      rw [add_pow, mul_sum]
      apply sum_congr rfl
      intro k hk
      rw [mul_pow]
      ring

/-- Factorial occupancy weights are positive for a positive species weight. -/
theorem ghostWeight_pos {ν : ℝ} (hν : 0 < ν) (n : ℕ) : 0 < ghostWeight ν n := by
  unfold ghostWeight
  positivity

/-- Replacing the signed coefficients by their absolute values dominates the kernel. -/
theorem abs_ghostKernel_le (A D C ν : ℝ) (n m : ℕ) :
    |ghostKernel A D C ν n m| ≤ ghostKernel |A| |D| |C| |ν| n m := by
  unfold ghostKernel
  calc
    _ ≤ ∑ k ∈ range (min n m + 1),
        |(n.choose k : ℝ) * A ^ k * D ^ (n - k) * (C * ν) ^ (m - k) /
          ((m - k).factorial : ℝ)| := abs_sum_le_sum_abs _ _
    _ = _ := by
      apply sum_congr rfl
      intro k hk
      simp only [abs_div, abs_mul, abs_pow, Nat.abs_cast]

/-- The absolute row estimate in the Schur weight `v^n`, with the exact source constants. -/
theorem ghostKernel_abs_row_le {A ν v : ℝ} (D C : ℝ) (n B : ℕ)
    (hA : 0 ≤ A) (hν : 0 ≤ ν) (hv : 0 < v) :
    (∑ m ∈ range (B + 1), |ghostKernel A D C ν n m| * v ^ m) ≤
      Real.exp (|C| * ν * v) * (A + |D| / v) ^ n * v ^ n := by
  calc
    _ ≤ ∑ m ∈ range (B + 1), ghostKernel A |D| |C| ν n m * v ^ m := by
      apply sum_le_sum
      intro m hm
      apply mul_le_mul_of_nonneg_right _ (pow_nonneg hv.le _)
      simpa only [abs_of_nonneg hA, abs_of_nonneg hν] using abs_ghostKernel_le A D C ν n m
    _ ≤ Real.exp (|C| * ν * v) * (A * v + |D|) ^ n :=
      ghostKernel_row_le A |D| |C| ν v n B hA (abs_nonneg _) (abs_nonneg _) hν hv.le
    _ = Real.exp (|C| * ν * v) * (A + |D| / v) ^ n * v ^ n := by
      have heq : A * v + |D| = (A + |D| / v) * v := by field_simp
      rw [heq, mul_pow]
      ring

/-- Damping makes the absolute row constant independent of the input occupancy. -/
theorem ghostKernel_abs_row_le_of_damping {A ν v : ℝ} (D C : ℝ) (n B : ℕ)
    (hA : 0 ≤ A) (hν : 0 ≤ ν) (hv : 0 < v) (hdamp : A + |D| / v ≤ 1) :
    (∑ m ∈ range (B + 1), |ghostKernel A D C ν n m| * v ^ m) ≤
      Real.exp (|C| * ν * v) * v ^ n := by
  apply (ghostKernel_abs_row_le D C n B hA hν hv).trans
  have hp : (A + |D| / v) ^ n ≤ 1 := pow_le_one₀ (by positivity) hdamp
  nlinarith [mul_nonneg (Real.exp_pos (|C| * ν * v)).le (pow_nonneg hv.le n),
    mul_le_mul_of_nonneg_left hp
      (mul_nonneg (Real.exp_pos (|C| * ν * v)).le (pow_nonneg hv.le n))]
end

section

/-- Product factorial measure on bounded species occupancies. -/
noncomputable def ghostMemoryWeight {ι : Type*} [Fintype ι] {B : ℕ}
    (ν : ι → ℝ) (x : ι → Fin (B + 1)) : ℝ :=
  ∏ i, ghostWeight (ν i) (x i)

/-- The tensor product of the signed scalar ghost kernels. -/
noncomputable def ghostMemoryKernel {ι : Type*} [Fintype ι] {B : ℕ}
    (A D C ν : ι → ℝ) (x y : ι → Fin (B + 1)) : ℂ :=
  ∏ i, (ghostKernel (A i) (D i) (C i) (ν i) (x i) (y i) : ℂ)

/-- Actual row action, with the input and output restricted to the same cutoff. -/
noncomputable def ghostMemoryAction {ι : Type*} [Fintype ι] {B : ℕ}
    (S : Finset (ι → Fin (B + 1))) (A D C ν : ι → ℝ)
    (f : (ι → Fin (B + 1)) → ℂ) (x : ι → Fin (B + 1)) : ℂ :=
  ∑ y ∈ S, ghostMemoryKernel A D C ν x y * f y

/-- The finite ghost memory operator has a cutoff-independent weighted L2 bound.
Signed birth and termination coefficients are permitted. -/
theorem ghostMemory_l2_sq_le {ι : Type*} [Fintype ι] {B : ℕ}
    (S : Finset (ι → Fin (B + 1))) (A D C ν v : ι → ℝ)
    (hA : ∀ i, 0 ≤ A i) (hν : ∀ i, 0 < ν i) (hv : ∀ i, 0 < v i)
    (hD : ∀ i, A i + |D i| / v i ≤ 1)
    (hC : ∀ i, A i + |C i| / v i ≤ 1)
    (f : (ι → Fin (B + 1)) → ℂ) :
    (∑ x ∈ S, ghostMemoryWeight ν x * ‖ghostMemoryAction S A D C ν f x‖ ^ 2) ≤
      Real.exp (∑ i, (|C i| + |D i|) * ν i * v i) *
        ∑ y ∈ S, ghostMemoryWeight ν y * ‖f y‖ ^ 2 := by
  classical
  let μ : ι → Fin (B + 1) → ℝ := fun i n => ghostWeight (ν i) n
  let w : ι → Fin (B + 1) → ℝ := fun i n => v i ^ (n : ℕ)
  let K : ι → Fin (B + 1) → Fin (B + 1) → ℂ :=
    fun i n m => (ghostKernel (A i) (D i) (C i) (ν i) n m : ℂ)
  let K' : ι → Fin (B + 1) → Fin (B + 1) → ℂ :=
    fun i n m => (ghostKernel (A i) (C i) (D i) (ν i) n m : ℂ)
  have hμ : ∀ i n, 0 ≤ μ i n := fun i n => (ghostWeight_pos (hν i) n).le
  have hw : ∀ i n, 0 < w i n := fun i n => pow_pos (hv i) n
  have htranspose : ∀ i n m, (μ i n : ℂ) * K i n m = (μ i m : ℂ) * K' i m n := by
    intro i n m
    simpa only [μ, K, K', Complex.ofReal_mul] using
      congrArg (fun t : ℝ => (t : ℂ))
        (ghostKernel_weighted_transpose (A i) (D i) (C i) (ν i) n m)
  have hrow : ∀ i n, (∑ m, ‖K i n m‖ * w i m) ≤
      Real.exp (|C i| * ν i * v i) * w i n := by
    intro i n
    simp only [K, w, Complex.norm_real, Real.norm_eq_abs]
    rw [Fin.sum_univ_eq_sum_range
      (fun m : ℕ => |ghostKernel (A i) (D i) (C i) (ν i) (n : ℕ) m| * v i ^ m) (B + 1)]
    exact ghostKernel_abs_row_le_of_damping (D i) (C i) n B (hA i) (hν i).le (hv i) (hD i)
  have hrow' : ∀ i n, (∑ m, ‖K' i n m‖ * w i m) ≤
      Real.exp (|D i| * ν i * v i) * w i n := by
    intro i n
    simp only [K', w, Complex.norm_real, Real.norm_eq_abs]
    rw [Fin.sum_univ_eq_sum_range
      (fun m : ℕ => |ghostKernel (A i) (C i) (D i) (ν i) (n : ℕ) m| * v i ^ m) (B + 1)]
    exact ghostKernel_abs_row_le_of_damping (C i) (D i) n B (hA i) (hν i).le (hv i) (hC i)
  have h := tensor_schur_cutoff S μ w K K' hμ hw htranspose
    (fun i => Real.exp (|C i| * ν i * v i))
    (fun i => Real.exp (|D i| * ν i * v i)) hrow hrow' f
  have hprod : (∏ i, Real.exp (|C i| * ν i * v i)) *
      (∏ i, Real.exp (|D i| * ν i * v i)) =
        Real.exp (∑ i, (|C i| + |D i|) * ν i * v i) := by
    rw [← Finset.prod_mul_distrib]
    simp_rw [← Real.exp_add]
    rw [← Real.exp_sum]
    congr 1
    apply Finset.sum_congr rfl
    intro i hi
    ring
  simpa only [hprod, tensorSchurWeight, tensorSchurKernel,
    ghostMemoryWeight, ghostMemoryAction, ghostMemoryKernel, μ, K] using h
end

section

/-- Telescoping toward the last index leaves only the strictly later factors. -/
theorem lifespan_suffix_telescoping {A : Type*} [CommRing A]
    (a : ℕ → A) (n : ℕ) :
    (∏ i ∈ Finset.range n, (1 - a i)) =
      1 - ∑ j ∈ Finset.range n, a j * ∏ t ∈ Finset.Ioo j n, (1 - a t) := by
  have h := Finset.prod_one_sub_ordered (ι := OrderDual ℕ) (Finset.range n) a
  change (∏ i ∈ Finset.range n, (1 - a i)) =
    1 - ∑ j ∈ Finset.range n, a j *
      ∏ t ∈ (Finset.range n).filter (fun t => j < t), (1 - a t) at h
  rw [h]
  congr 1
  apply Finset.sum_congr rfl
  intro j hj
  congr 1
  have he : (Finset.range n).filter (fun t => j < t) = Finset.Ioo j n := by
    ext t
    simp [and_comm]
  rw [he]

/-- The other telescope leaves the strictly earlier factors. -/
theorem lifespan_prefix_telescoping {A : Type*} [CommRing A]
    (a : ℕ → A) (n : ℕ) :
    (∏ i ∈ Finset.range n, (1 - a i)) =
      1 - ∑ j ∈ Finset.range n, a j * ∏ t ∈ Finset.range j, (1 - a t) := by
  rw [Finset.prod_one_sub_ordered]
  congr 1
  apply Finset.sum_congr rfl
  intro j hj
  congr 1
  have he : (Finset.range n).filter (fun t => t < j) = Finset.range j := by
    ext t
    simp only [Finset.mem_filter, Finset.mem_range]
    have hjn : j < n := Finset.mem_range.mp hj
    omega
  rw [he]

/-- The degree-zero and degree-one terms are separated; all remaining terms
are grouped by their first and last selected indices. -/
theorem lifespan_orphan_expansion {A : Type*} [CommRing A]
    (a : ℕ → A) (n : ℕ) :
    (∏ i ∈ Finset.range n, (1 - a i)) =
      1 - (∑ i ∈ Finset.range n, a i) +
        ∑ i ∈ Finset.range n, ∑ j ∈ Finset.range i,
          a j * a i * ∏ t ∈ Finset.Ioo j i, (1 - a t) := by
  rw [lifespan_prefix_telescoping]
  have he : ∀ i, a i * (∏ t ∈ Finset.range i, (1 - a t)) =
      a i - ∑ j ∈ Finset.range i,
        a j * a i * ∏ t ∈ Finset.Ioo j i, (1 - a t) := by
    intro i
    rw [lifespan_suffix_telescoping, mul_sub, mul_one, Finset.mul_sum]
    congr 1
    apply Finset.sum_congr rfl
    intro j hj
    ring
  simp_rw [he, Finset.sum_sub_distrib]
  ring

/-- A pair of residue hits forces the two endpoints to coincide, and fixes the
residue in every interior damping factor. -/
theorem lifespan_residue_pair_sum {R : Type*} [Fintype R] [DecidableEq R]
    (h : ℕ → R) (η : ℕ → ℝ) (j i : ℕ) :
    (∑ r : R, (η j * (if r = h j then 1 else 0)) *
      (η i * (if r = h i then 1 else 0)) *
        ∏ t ∈ Finset.Ioo j i, (1 - η t * (if r = h t then 1 else 0))) =
      η j * η i * (if h j = h i then
        ∏ t ∈ Finset.Ioo j i, (1 - η t * (if h t = h j then 1 else 0)) else 0) := by
  classical
  rw [Finset.sum_eq_single (h j)]
  · by_cases hij : h j = h i <;> simp [hij, eq_comm]
  · intro r hr hneq
    simp [hneq]
  · simp

/-- Unnormalized finite residue expectation of an inactive prime's full
product, exactly grouped into its absent, singleton and lifespan terms. -/
theorem lifespan_residue_sum {R : Type*} [Fintype R] [DecidableEq R]
    (h : ℕ → R) (η : ℕ → ℝ) (n : ℕ) :
    (∑ r : R, ∏ i ∈ Finset.range n,
      (1 - η i * (if r = h i then 1 else 0))) =
      (Fintype.card R : ℝ) - (∑ i ∈ Finset.range n, η i) +
        ∑ i ∈ Finset.range n, ∑ j ∈ Finset.range i,
          η j * η i * (if h j = h i then
            ∏ t ∈ Finset.Ioo j i,
              (1 - η t * (if h t = h j then 1 else 0)) else 0) := by
  classical
  simp_rw [lifespan_orphan_expansion]
  rw [Finset.sum_add_distrib, Finset.sum_sub_distrib]
  have hlinear : (∑ r : R, ∑ i ∈ Finset.range n,
      η i * (if r = h i then 1 else 0)) = ∑ i ∈ Finset.range n, η i := by
    rw [Finset.sum_comm]
    simp
  rw [hlinear]
  simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one]
  congr 1
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i hi
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro j hj
  exact lifespan_residue_pair_sum h η j i

/-- Exact normalized orphan expansion. No positivity or size assumption on the
real coefficients is needed. -/
theorem lifespan_residue_expectation {R : Type*} [Fintype R] [DecidableEq R] [Nonempty R]
    (h : ℕ → R) (η : ℕ → ℝ) (n : ℕ) :
    (1 / (Fintype.card R : ℝ)) *
      (∑ r : R, ∏ i ∈ Finset.range n,
        (1 - η i * (if r = h i then 1 else 0))) =
      1 - (∑ i ∈ Finset.range n, η i) / (Fintype.card R : ℝ) +
        (1 / (Fintype.card R : ℝ)) *
          ∑ i ∈ Finset.range n, ∑ j ∈ Finset.range i,
            η j * η i * (if h j = h i then
              ∏ t ∈ Finset.Ioo j i,
                (1 - η t * (if h t = h j then 1 else 0)) else 0) := by
  rw [lifespan_residue_sum]
  have hc : (Fintype.card R : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr Fintype.card_ne_zero
  field_simp
end

section
open Finset
/-- Occupancy vector of an ordered tuple; every position contributes once. -/
noncomputable def tupleOccupancy {ι : Type*} [DecidableEq ι] {n : ℕ}
    (p : Fin n → ι) : ι → ℕ :=
  ∑ j, Pi.single (p j) 1

theorem tupleOccupancy_apply {ι : Type*} [DecidableEq ι] {n : ℕ}
    (p : Fin n → ι) (i : ι) :
    tupleOccupancy p i = (univ.filter (fun j => p j = i)).card := by
  simp [tupleOccupancy, Finset.sum_apply, Pi.single_apply, eq_comm]

/-- The same polynomial expanded by ordered positions and by occupancies. -/
theorem tuple_occupancy_generating_identity {ι : Type*} [Fintype ι] [DecidableEq ι]
    (ν : ι → ℝ) (n : ℕ) :
    (∑ p : Fin n → ι,
      AddMonoidAlgebra.single (tupleOccupancy p) (∏ j, ν (p j))) =
    ∑ k ∈ (univ : Finset ι).piAntidiag n,
      AddMonoidAlgebra.single k
        ((Nat.multinomial univ k : ℝ) * ∏ i, ν i ^ k i) := by
  let z : ι → AddMonoidAlgebra ℝ (ι → ℕ) :=
    fun i => AddMonoidAlgebra.single (Pi.single i 1) (ν i)
  have htuple : (∑ i, z i) ^ n =
      ∑ p : Fin n → ι,
        AddMonoidAlgebra.single (tupleOccupancy p) (∏ j, ν (p j)) := by
    rw [Finset.sum_pow']
    simp only [Fintype.piFinset_univ]
    apply Finset.sum_congr rfl
    intro p hp
    exact AddMonoidAlgebra.prod_single univ (fun j => Pi.single (p j) 1)
      (fun j => ν (p j))
  rw [← htuple, Finset.sum_pow_eq_sum_piAntidiag]
  apply Finset.sum_congr rfl
  intro k hk
  have hexp : (∑ i, k i • Pi.single i (1 : ℕ)) = k := by
    ext i
    simp [Finset.sum_apply, Pi.single_apply]
  simp only [z, AddMonoidAlgebra.single_pow, AddMonoidAlgebra.prod_single, hexp]
  rw [← nsmul_eq_mul]
  simp

/-- Grouping ordered tuples by occupancy, with an arbitrary occupancy test. -/
theorem sum_tuple_eq_multinomial {ι : Type*} [Fintype ι] [DecidableEq ι]
    (ν : ι → ℝ) (n : ℕ) (F : (ι → ℕ) → ℝ) :
    (∑ p : Fin n → ι, (∏ j, ν (p j)) * F (tupleOccupancy p)) =
      ∑ k ∈ (univ : Finset ι).piAntidiag n,
        (Nat.multinomial univ k : ℝ) * (∏ i, ν i ^ k i) * F k := by
  let T : AddMonoidAlgebra ℝ (ι → ℕ) →+ ℝ :=
    (Finsupp.liftAddHom (fun k => AddMonoidHom.mulRight (F k))).comp
      AddMonoidAlgebra.coeffAddEquiv.toAddMonoidHom
  have hT (k : ι → ℕ) (r : ℝ) : T (AddMonoidAlgebra.single k r) = r * F k := by
    simp [T]
  have h := congrArg T (tuple_occupancy_generating_identity ν n)
  simpa only [map_sum, hT] using h

/-- The ordered `1/n!` measure is exactly the product occupancy-factorial
measure. There are no positivity assumptions on the weights or the test. -/
theorem sum_tuple_div_factorial_eq_occupancy {ι : Type*} [Fintype ι] [DecidableEq ι]
    (ν : ι → ℝ) (n : ℕ) (F : (ι → ℕ) → ℝ) :
    (∑ p : Fin n → ι, (∏ j, ν (p j)) * F (tupleOccupancy p)) /
        (n.factorial : ℝ) =
      ∑ k ∈ (univ : Finset ι).piAntidiag n,
        (∏ i, ν i ^ k i / ((k i).factorial : ℝ)) * F k := by
  rw [sum_tuple_eq_multinomial, Finset.sum_div]
  apply Finset.sum_congr rfl
  intro k hk
  have hsum : ∑ i, k i = n := (Finset.mem_piAntidiag.mp hk).1
  have hfac : (∏ i, ((k i).factorial : ℝ)) * (Nat.multinomial univ k : ℝ) =
      (n.factorial : ℝ) := by
    exact_mod_cast (Nat.multinomial_spec univ k).trans (congrArg Nat.factorial hsum)
  have hd : (∏ i, ((k i).factorial : ℝ)) ≠ 0 := by positivity
  have hn : (n.factorial : ℝ) ≠ 0 := by positivity
  rw [Finset.prod_div_distrib]
  field_simp
  linear_combination ((∏ i, ν i ^ k i) * F k) * hfac
end

section
open Finset
structure GhostLifespanState (R : Type*) where
  pending : R → ℝ
  completed : ℝ

/-- The effective one-visit transition after cancellation of the auxiliary rho
factors. The reciprocal residue/baseline cost `β` is paid once at birth. -/
noncomputable def ghostLifespanStep {R : Type*} [DecidableEq R]
    (hit : R) (η β : ℝ) (s : GhostLifespanState R) : GhostLifespanState R where
  pending := fun r => s.pending r * (1 - η * (if r = hit then 1 else 0)) -
    β * η * (if r = hit then 1 else 0)
  completed := s.completed - η * s.pending hit

/-- Start with the unborn state and no pending or completed lifespan. -/
noncomputable def ghostLifespanRun {R : Type*} [DecidableEq R]
    (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) : ℕ → GhostLifespanState R
  | 0 => ⟨fun _ => 0, 0⟩
  | n + 1 => ghostLifespanStep (h n) (η n) β (ghostLifespanRun h η β n)

/-- Exact pending coefficient at each residue after all possible single births. -/
theorem ghostLifespan_pending {R : Type*} [DecidableEq R]
    (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (n : ℕ) (r : R) :
    (ghostLifespanRun h η β n).pending r =
      β * ((∏ i ∈ range n, (1 - η i * (if r = h i then 1 else 0))) - 1) := by
  induction n with
  | zero => simp [ghostLifespanRun]
  | succ n ih =>
      simp only [ghostLifespanRun, ghostLifespanStep, prod_range_succ]
      rw [ih]
      ring

/-- A finite conservation identity records every termination while retaining
its sign. No absolute values or positivity assumptions are used. -/
theorem ghostLifespan_completed_balance {R : Type*} [Fintype R] [DecidableEq R]
    (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (n : ℕ) :
    (ghostLifespanRun h η β n).completed =
      (∑ r : R, (ghostLifespanRun h η β n).pending r) + β * ∑ i ∈ range n, η i := by
  induction n with
  | zero => simp [ghostLifespanRun]
  | succ n ih =>
      have hstep : (∑ r : R, (ghostLifespanRun h η β (n + 1)).pending r) =
          (∑ r : R, (ghostLifespanRun h η β n).pending r) -
            η n * (ghostLifespanRun h η β n).pending (h n) - β * η n := by
        simp only [ghostLifespanRun, ghostLifespanStep, mul_sub, mul_one, sum_sub_distrib]
        simp only [mul_ite, mul_one, mul_zero, sum_ite_eq', mem_univ, if_true]
        ring
      change (ghostLifespanRun h η β n).completed -
        η n * (ghostLifespanRun h η β n).pending (h n) = _
      rw [hstep, ih, sum_range_succ]
      ring

/-- The completed coefficient is the higher-degree part of the residue product. -/
theorem ghostLifespan_completed_product {R : Type*} [Fintype R] [DecidableEq R]
    (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (n : ℕ) :
    (ghostLifespanRun h η β n).completed =
      β * ((∑ r : R, ∏ i ∈ range n, (1 - η i * (if r = h i then 1 else 0))) -
        Fintype.card R + ∑ i ∈ range n, η i) := by
  rw [ghostLifespan_completed_balance]
  simp_rw [ghostLifespan_pending]
  rw [← mul_sum, sum_sub_distrib]
  simp only [sum_const, card_univ, nsmul_eq_mul, mul_one]
  ring

/-- The transfer evolution is exactly the sum of all compatible orphan
lifespans, with strictly later termination and all interior damping factors. -/
theorem ghostLifespan_completed_orphans {R : Type*} [Fintype R] [DecidableEq R]
    (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (n : ℕ) :
    (ghostLifespanRun h η β n).completed =
      β * ∑ i ∈ range n, ∑ j ∈ range i,
        η j * η i * (if h j = h i then
          ∏ t ∈ Ioo j i, (1 - η t * (if h t = h j then 1 else 0)) else 0) := by
  rw [ghostLifespan_completed_product, lifespan_residue_sum]
  ring

/-- The vacuum coefficient is the normalized finite residue expectation.
The baseline and residue factor occur exactly once. -/
theorem ghostLifespan_vacuum_identity {R : Type*} [Fintype R] [DecidableEq R]
    [Nonempty R] (h : ℕ → R) (η : ℕ → ℝ) (n : ℕ) (b : ℝ)
    (hb : b = 1 - (∑ i ∈ range n, η i) / Fintype.card R) (hb0 : b ≠ 0) :
    1 + (ghostLifespanRun h η ((Fintype.card R : ℝ) * b)⁻¹ n).completed =
      ((∑ r : R, ∏ i ∈ range n, (1 - η i * (if r = h i then 1 else 0))) /
        Fintype.card R) / b := by
  have hc : (Fintype.card R : ℝ) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have heq : b * Fintype.card R = Fintype.card R - ∑ i ∈ range n, η i := by
    rw [hb]
    field_simp
  rw [ghostLifespan_completed_product]
  field_simp
  nlinarith [heq]
end

section
open Finset
/-- Simultaneous active hits and the damping at the inactive visits. -/
noncomputable def activeResidueWeight {R : Type*} [DecidableEq R]
    (visits active : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ) (r : R) : ℝ :=
  (∏ i ∈ active, if r = h i then 1 else 0) *
    ∏ i ∈ visits \ active, (1 - η i * (if r = h i then 1 else 0))

/-- An active visit fixes the residue. Further active visits impose only
compatibility, with no additional reciprocal-residue factor. -/
theorem active_lifespan_residue_sum {R : Type*} [Fintype R] [DecidableEq R]
    (visits active : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ)
    (a : ℕ) (ha : a ∈ active) :
    (∑ r : R, activeResidueWeight visits active h η r) =
      if ∀ i ∈ active, h i = h a then
        ∏ i ∈ visits \ active, (1 - η i * (if h i = h a then 1 else 0))
      else 0 := by
  classical
  rw [sum_eq_single (h a)]
  · simp only [activeResidueWeight, prod_boole]
    have he : (∀ i ∈ active, h a = h i) ↔ (∀ i ∈ active, h i = h a) := by
      constructor <;> intro hh i hi <;> exact (hh i hi).symm
    simp only [he]
    split <;> simp_all [eq_comm]
  · intro r hr hne
    have hh : ¬ (∀ i ∈ active, r = h i) := fun hc => hne (hc a ha)
    simp [activeResidueWeight, prod_boole, hh]
  · simp

/-- A mismatched active pair makes the entire residue contribution vanish. -/
theorem active_lifespan_incompatible {R : Type*} [Fintype R] [DecidableEq R]
    (visits active : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ)
    {a z : ℕ} (ha : a ∈ active) (hz : z ∈ active) (haz : h a ≠ h z) :
    (∑ r : R, activeResidueWeight visits active h η r) = 0 := by
  rw [active_lifespan_residue_sum visits active h η a ha]
  have hh : ¬ (∀ i ∈ active, h i = h a) := fun hc => haz (hc z hz).symm
  simp [hh]

/-- The prefix expansion selects the first ghost birth, leaving all later
inactive damping factors up to the first active visit. -/
theorem active_lifespan_birth_expansion (s : Finset ℕ) (f : ℕ → ℝ) :
    (∏ i ∈ s, (1 - f i)) =
      1 - ∑ j ∈ s, f j * ∏ i ∈ s.filter (fun i => j < i), (1 - f i) := by
  exact prod_one_sub_ordered (ι := OrderDual ℕ) s f

/-- The suffix expansion selects the final ghost termination, retaining all
earlier inactive damping factors after the last active visit. -/
theorem active_lifespan_death_expansion (s : Finset ℕ) (f : ℕ → ℝ) :
    (∏ i ∈ s, (1 - f i)) =
      1 - ∑ j ∈ s, f j * ∏ i ∈ s.filter (fun i => i < j), (1 - f i) := by
  exact prod_one_sub_ordered s f

/-- Split a finite time set before, during and after a closed lifespan. -/
theorem active_lifespan_split_product (s : Finset ℕ) (f : ℕ → ℝ)
    {a z : ℕ} (haz : a ≤ z) :
    (∏ i ∈ s, f i) =
      (∏ i ∈ s.filter (fun i => i < a), f i) *
      (∏ i ∈ s.filter (fun i => a ≤ i ∧ i ≤ z), f i) *
      ∏ i ∈ s.filter (fun i => z < i), f i := by
  have h₁ := prod_filter_mul_prod_filter_not s (fun i => i < a) f
  have h₂ := prod_filter_mul_prod_filter_not
    (s.filter (fun i => ¬ i < a)) (fun i => i ≤ z) f
  have hm : (s.filter (fun i => ¬ i < a)).filter (fun i => i ≤ z) =
      s.filter (fun i => a ≤ i ∧ i ≤ z) := by
    ext i
    simp only [mem_filter, not_lt, and_assoc]
  have ht : (s.filter (fun i => ¬ i < a)).filter (fun i => ¬ i ≤ z) =
      s.filter (fun i => z < i) := by
    ext i
    simp only [mem_filter, not_lt, not_le]
    constructor
    · rintro ⟨⟨hi, _⟩, hzi⟩
      exact ⟨hi, hzi⟩
    · rintro ⟨hi, hzi⟩
      exact ⟨⟨hi, by omega⟩, hzi⟩
  rw [hm, ht] at h₂
  rw [← h₁, ← h₂, mul_assoc]

/-- Exact one-prime lifespan expansion for an active path: births can be at
the first active visit or a preceding ghost hit, and deaths can be at the last
active visit or a subsequent ghost hit. The middle factors occur once. -/
theorem active_lifespan_endpoint_expansion {R : Type*} [Fintype R] [DecidableEq R]
    (visits active : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ)
    {a z : ℕ} (ha : a ∈ active) (haz : a ≤ z) :
    (∑ r : R, activeResidueWeight visits active h η r) =
      if ∀ i ∈ active, h i = h a then
        (1 - ∑ j ∈ (visits \ active).filter (fun j => j < a),
          (η j * (if h j = h a then 1 else 0)) *
          ∏ i ∈ ((visits \ active).filter (fun i => i < a)).filter
            (fun i => j < i), (1 - η i * (if h i = h a then 1 else 0))) *
        (∏ i ∈ (visits \ active).filter (fun i => a ≤ i ∧ i ≤ z),
          (1 - η i * (if h i = h a then 1 else 0))) *
        (1 - ∑ j ∈ (visits \ active).filter (fun j => z < j),
          (η j * (if h j = h a then 1 else 0)) *
          ∏ i ∈ ((visits \ active).filter (fun i => z < i)).filter
            (fun i => i < j), (1 - η i * (if h i = h a then 1 else 0)))
      else 0 := by
  rw [active_lifespan_residue_sum visits active h η a ha]
  split
  · rw [active_lifespan_split_product _ _ haz,
      active_lifespan_birth_expansion, active_lifespan_death_expansion
        ((visits \ active).filter (fun i => z < i))]
  · rfl

/-- After division by the local baseline there is exactly one reciprocal
residue cost, independent of the number of active visits. -/
theorem active_lifespan_normalized {R : Type*} [Fintype R] [DecidableEq R]
    (visits active : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ)
    (a : ℕ) (ha : a ∈ active) (b : ℝ) :
    ((∑ r : R, activeResidueWeight visits active h η r) /
      (Fintype.card R : ℝ)) / b =
      if ∀ i ∈ active, h i = h a then
        ((Fintype.card R : ℝ) * b)⁻¹ *
          ∏ i ∈ visits \ active, (1 - η i * (if h i = h a then 1 else 0))
      else 0 := by
  rw [active_lifespan_residue_sum visits active h η a ha]
  split
  · simp only [div_eq_mul_inv, mul_inv_rev]
    ring
  · simp

/-- When `a` and `z` are the first and last active visits, the surviving
damping product has exactly the prefix, interior gaps and suffix expected
by the single-lifespan description. -/
theorem active_lifespan_first_last_product {R : Type*} [Fintype R] [DecidableEq R]
    (active : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ)
    {n a z : ℕ} (ha : a ∈ active) (hz : z ∈ active) (hzn : z < n)
    (hend : ∀ i ∈ active, a ≤ i ∧ i ≤ z) :
    (∑ r : R, activeResidueWeight (range n) active h η r) =
      if ∀ i ∈ active, h i = h a then
        (∏ i ∈ range a, (1 - η i * (if h i = h a then 1 else 0))) *
        (∏ i ∈ Ioo a z \ active, (1 - η i * (if h i = h a then 1 else 0))) *
        ∏ i ∈ Ioo z n, (1 - η i * (if h i = h a then 1 else 0))
      else 0 := by
  have haz : a ≤ z := (hend a ha).2
  have hp : (range n \ active).filter (fun i => i < a) = range a := by
    ext i
    simp only [mem_filter, mem_sdiff, mem_range]
    constructor
    · exact fun ht => ht.2
    · intro hi
      refine ⟨⟨by omega, ?_⟩, hi⟩
      intro hia
      have := (hend i hia).1
      omega
  have hm : (range n \ active).filter (fun i => a ≤ i ∧ i ≤ z) =
      Ioo a z \ active := by
    ext i
    simp only [mem_filter, mem_sdiff, mem_range, mem_Ioo]
    constructor
    · rintro ⟨⟨hin, hia⟩, hai, hiz⟩
      have hne₁ : i ≠ a := by rintro rfl; exact hia ha
      have hne₂ : i ≠ z := by rintro rfl; exact hia hz
      exact ⟨⟨by omega, by omega⟩, hia⟩
    · rintro ⟨⟨hai, hiz⟩, hia⟩
      exact ⟨⟨by omega, hia⟩, by omega, by omega⟩
  have hs : (range n \ active).filter (fun i => z < i) = Ioo z n := by
    ext i
    simp only [mem_filter, mem_sdiff, mem_range, mem_Ioo]
    constructor
    · rintro ⟨⟨hin, _⟩, hzi⟩
      exact ⟨hzi, hin⟩
    · rintro ⟨hzi, hin⟩
      refine ⟨⟨hin, ?_⟩, hzi⟩
      intro hia
      have := (hend i hia).2
      omega
  rw [active_lifespan_residue_sum _ _ _ _ a ha]
  split
  · rw [active_lifespan_split_product _ _ haz, hp, hm, hs]
  · rfl
end

section
open Finset
/-- A complete period maps bijectively to its tuple of local residues. -/
theorem lifespan_crt_bijective {ι : Type*} [Fintype ι] [DecidableEq ι]
    (m : ι → ℕ) [∀ i, NeZero (m i)]
    (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j))) :
    Function.Bijective (fun k : Fin (∏ i, m i) => fun i => (k.val : ZMod (m i))) := by
  apply (Fintype.bijective_iff_surjective_and_card _).2
  constructor
  · intro r
    have hm : ∀ i ∈ (univ : Finset ι), m i ≠ 0 := fun i _ => NeZero.ne (m i)
    have hp : Set.Pairwise (↑(univ : Finset ι)) (Function.onFun Nat.Coprime m) := by
      intro i _ j _ hij
      exact hc hij
    let k := Nat.chineseRemainderOfFinset (fun i => (r i).val) m univ hm hp
    have hk : k.val < ∏ i, m i :=
      Nat.chineseRemainderOfFinset_lt_prod (fun i => (r i).val) m hm hp
    refine ⟨⟨k.val, hk⟩, ?_⟩
    funext i
    have he : (k.val : ZMod (m i)) = ((r i).val : ZMod (m i)) :=
      (ZMod.natCast_eq_natCast_iff _ _ _).2 (k.property i (mem_univ i))
    exact he.trans (ZMod.natCast_zmod_val (r i))
  · simp only [Fintype.card_fin, Fintype.card_pi, ZMod.card]

/-- Signed weights at independent local residues factor exactly over a
complete period. This is an identity, so no cancellation is discarded. -/
theorem lifespan_crt_sum {ι : Type*} [Fintype ι] [DecidableEq ι]
    (m : ι → ℕ) [∀ i, NeZero (m i)]
    (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (f : ∀ i, ZMod (m i) → ℝ) :
    (∑ k ∈ range (∏ i, m i), ∏ i, f i (k : ZMod (m i))) =
      ∏ i, ∑ r : ZMod (m i), f i r := by
  rw [← Fin.sum_univ_eq_sum_range]
  let e := Equiv.ofBijective _ (lifespan_crt_bijective m hc)
  calc
    _ = ∑ r : ∀ i, ZMod (m i), ∏ i, f i (r i) :=
      e.sum_comp (fun r => ∏ i, f i (r i))
    _ = _ := (Fintype.prod_sum f).symm

/-- The averaged CRT sum factors into the normalized local expectations. -/
theorem lifespan_crt_average {ι : Type*} [Fintype ι] [DecidableEq ι]
    (m : ι → ℕ) [∀ i, NeZero (m i)]
    (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (f : ∀ i, ZMod (m i) → ℝ) :
    (∑ k ∈ range (∏ i, m i), ∏ i, f i (k : ZMod (m i))) /
        ((∏ i, m i) : ℕ) =
      ∏ i, (∑ r : ZMod (m i), f i r) / (m i : ℝ) := by
  rw [lifespan_crt_sum m hc f, prod_div_distrib, prod_natCast]

/-- The CRT identity remains exact after dividing by each local baseline. -/
theorem lifespan_crt_baseline {ι : Type*} [Fintype ι] [DecidableEq ι]
    (m : ι → ℕ) [∀ i, NeZero (m i)]
    (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (f : ∀ i, ZMod (m i) → ℝ) (b : ι → ℝ) :
    ((∑ k ∈ range (∏ i, m i), ∏ i, f i (k : ZMod (m i))) /
        ((∏ i, m i) : ℕ)) / (∏ i, b i) =
      ∏ i, ((∑ r : ZMod (m i), f i r) / (m i : ℝ)) / b i := by
  rw [lifespan_crt_average m hc f]
  exact (prod_div_distrib _ _).symm

/-- The coefficient contributed by a single prime: the vacuum term if it
never becomes active, and one compatible active lifespan otherwise. -/
noncomputable def localLifespanCoefficient {R : Type*} [Fintype R] [DecidableEq R]
    (n : ℕ) (active : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ) (a : ℕ) (b : ℝ) : ℝ :=
  if active = ∅ then
    1 + (ghostLifespanRun h η ((Fintype.card R : ℝ) * b)⁻¹ n).completed
  else if ∀ i ∈ active, h i = h a then
    ((Fintype.card R : ℝ) * b)⁻¹ *
      ∏ i ∈ range n \ active, (1 - η i * (if h i = h a then 1 else 0))
  else 0

/-- Both local cases equal the same normalized signed residue expectation. -/
theorem local_lifespan_coefficient_eq {R : Type*} [Fintype R] [DecidableEq R]
    [Nonempty R] (n : ℕ) (active : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ)
    (a : ℕ) (ha : active ≠ ∅ → a ∈ active) (b : ℝ)
    (hb : b = 1 - (∑ i ∈ range n, η i) / Fintype.card R) (hb0 : b ≠ 0) :
    localLifespanCoefficient n active h η a b =
      ((∑ r : R, activeResidueWeight (range n) active h η r) /
        (Fintype.card R : ℝ)) / b := by
  classical
  by_cases he : active = ∅
  · subst active
    simp only [localLifespanCoefficient, if_true, activeResidueWeight,
      prod_empty, sdiff_empty, one_mul]
    exact ghostLifespan_vacuum_identity h η n b hb hb0
  · simp only [localLifespanCoefficient, he, if_false]
    exact (active_lifespan_normalized (range n) active h η a (ha he) b).symm

/-- The simultaneous local lifespan coefficients recover the complete-period
CRT average, including all signs and one baseline per prime. -/
theorem lifespan_crt_coefficient_identity {ι : Type*} [Fintype ι] [DecidableEq ι]
    (m : ι → ℕ) [∀ i, NeZero (m i)]
    (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (n : ℕ) (active : ι → Finset ℕ) (h : ∀ i, ℕ → ZMod (m i))
    (η : ι → ℕ → ℝ) (a : ι → ℕ) (ha : ∀ i, active i ≠ ∅ → a i ∈ active i)
    (b : ι → ℝ) (hb : ∀ i, b i = 1 - (∑ j ∈ range n, η i j) / (m i : ℝ))
    (hb0 : ∀ i, b i ≠ 0) :
    (∏ i, localLifespanCoefficient n (active i) (h i) (η i) (a i) (b i)) =
      ((∑ k ∈ range (∏ i, m i),
        ∏ i, activeResidueWeight (range n) (active i) (h i) (η i)
          (k : ZMod (m i))) / ((∏ i, m i) : ℕ)) / (∏ i, b i) := by
  rw [lifespan_crt_baseline]
  · apply prod_congr rfl
    intro i hi
    simpa only [ZMod.card] using
      local_lifespan_coefficient_eq n (active i) (h i) (η i) (a i) (ha i)
        (b i) (by simpa only [ZMod.card] using hb i) (hb0 i)
  · exact hc
end

section
open Finset
/-- Every full block of a periodic sequence contributes the same signed sum. -/
theorem periodic_full_blocks (f : ℕ → ℝ) {M : ℕ}
    (hf : Function.Periodic f M) (k : ℕ) :
    (∑ i ∈ range (k * M), f i) = (k : ℝ) * ∑ i ∈ range M, f i := by
  induction k with
  | zero => simp
  | succ k ih =>
      rw [Nat.succ_mul, sum_range_add, ih]
      have hs : (∑ i ∈ range M, f (k * M + i)) = ∑ i ∈ range M, f i := by
        apply sum_congr rfl
        intro i hi
        simpa [Nat.add_comm] using hf.nat_mul k i
      rw [hs, Nat.cast_add, Nat.cast_one]
      ring

/-- Split a periodic sum into its full blocks and the final incomplete block. -/
theorem periodic_quotient_remainder (f : ℕ → ℝ) {M : ℕ}
    (hf : Function.Periodic f M) (N : ℕ) :
    (∑ i ∈ range N, f i) =
      ((N / M : ℕ) : ℝ) * (∑ i ∈ range M, f i) + ∑ i ∈ range (N % M), f i := by
  have hn : N / M * M + N % M = N := by
    simpa only [Nat.mul_comm] using Nat.div_add_mod N M
  conv_lhs => rw [← hn]
  rw [sum_range_add, periodic_full_blocks f hf]
  congr 1
  apply sum_congr rfl
  intro i hi
  simpa [Nat.add_comm] using hf.nat_mul (N / M) i

/-- The error in replacing a finite sum by its period mean is controlled by
twice the absolute mass of one period, uniformly in the interval length. -/
theorem periodic_mean_error (f : ℕ → ℝ) {M : ℕ} (hM : 0 < M)
    (hf : Function.Periodic f M) (N : ℕ) :
    |(∑ i ∈ range N, f i) - ((N : ℝ) / M) * ∑ i ∈ range M, f i| ≤
      2 * ∑ i ∈ range M, |f i| := by
  have hMr : (0 : ℝ) < M := by exact_mod_cast hM
  have hn : (N : ℝ) = ((N / M : ℕ) : ℝ) * M + ((N % M : ℕ) : ℝ) := by
    have hnat : N = N / M * M + N % M := by
      simpa only [Nat.mul_comm] using (Nat.div_add_mod N M).symm
    exact_mod_cast hnat
  have he : (∑ i ∈ range N, f i) - ((N : ℝ) / M) * ∑ i ∈ range M, f i =
      (∑ i ∈ range (N % M), f i) -
        (((N % M : ℕ) : ℝ) / M) * ∑ i ∈ range M, f i := by
    rw [periodic_quotient_remainder f hf N]
    conv_lhs => rw [hn]
    field_simp
    ring
  have hratio0 : (0 : ℝ) ≤ ((N % M : ℕ) : ℝ) / M := by positivity
  have hratio1 : (((N % M : ℕ) : ℝ) / M) ≤ 1 := by
    apply (div_le_one hMr).2
    exact_mod_cast (Nat.mod_lt N hM).le
  have hpart : |∑ i ∈ range (N % M), f i| ≤ ∑ i ∈ range M, |f i| := by
    calc
      _ ≤ ∑ i ∈ range (N % M), |f i| := abs_sum_le_sum_abs _ _
      _ ≤ ∑ i ∈ range M, |f i| := by
        apply sum_le_sum_of_subset_of_nonneg
        · exact range_mono (Nat.mod_lt N hM).le
        · intro i hi hnot
          exact abs_nonneg _
  have hwhole : |∑ i ∈ range M, f i| ≤ ∑ i ∈ range M, |f i| :=
    abs_sum_le_sum_abs _ _
  rw [he]
  calc
    _ ≤ |∑ i ∈ range (N % M), f i| +
        |(((N % M : ℕ) : ℝ) / M) * ∑ i ∈ range M, f i| := abs_sub _ _
    _ = |∑ i ∈ range (N % M), f i| +
        (((N % M : ℕ) : ℝ) / M) * |∑ i ∈ range M, f i| := by
          rw [abs_mul, abs_of_nonneg hratio0]
    _ ≤ (∑ i ∈ range M, |f i|) + 1 * (∑ i ∈ range M, |f i|) := by
      exact add_le_add hpart (mul_le_mul hratio1 hwhole (abs_nonneg _) (by positivity))
    _ = _ := by ring

/-- The product of local residue weights is periodic with the product modulus. -/
theorem lifespan_crt_periodic {ι : Type*} [Fintype ι] [DecidableEq ι]
    (m : ι → ℕ) (f : ∀ i, ZMod (m i) → ℝ) :
    Function.Periodic (fun k : ℕ => ∏ i, f i (k : ZMod (m i))) (∏ i, m i) := by
  intro k
  apply prod_congr rfl
  intro i hi
  have hm : ((∏ j, m j : ℕ) : ZMod (m i)) = 0 :=
    (ZMod.natCast_eq_zero_iff _ _).2 (dvd_prod_of_mem m hi)
  rw [Nat.cast_add, hm, add_zero]

/-- A finite interval differs from its CRT mean by a bounded boundary error.
The absolute local masses, rather than a supremum over tuples, control it. -/
theorem lifespan_crt_interval_error {ι : Type*} [Fintype ι] [DecidableEq ι]
    (m : ι → ℕ) [∀ i, NeZero (m i)]
    (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (f : ∀ i, ZMod (m i) → ℝ) (N : ℕ) :
    |(∑ k ∈ range N, ∏ i, f i (k : ZMod (m i))) -
      ((N : ℝ) / ((∏ i, m i) : ℕ)) * (∏ i, ∑ r : ZMod (m i), f i r)| ≤
      2 * ∏ i, ∑ r : ZMod (m i), |f i r| := by
  have hM : 0 < ∏ i, m i := prod_pos (fun i _ => Nat.pos_of_ne_zero (NeZero.ne (m i)))
  have he := periodic_mean_error (fun k : ℕ => ∏ i, f i (k : ZMod (m i)))
    hM (lifespan_crt_periodic m f) N
  rw [lifespan_crt_sum m hc f] at he
  simpa only [abs_prod, lifespan_crt_sum m hc (fun i r => |f i r|)] using he

/-- Differences of prefix sums give the corresponding bound on an arbitrary
integer interval, with both boundary pieces accounted for. -/
theorem lifespan_crt_between_error {ι : Type*} [Fintype ι] [DecidableEq ι]
    (m : ι → ℕ) [∀ i, NeZero (m i)]
    (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (f : ∀ i, ZMod (m i) → ℝ) {A B : ℕ} (hAB : A ≤ B) :
    |(∑ k ∈ Ico A B, ∏ i, f i (k : ZMod (m i))) -
      (((B : ℝ) - A) / ((∏ i, m i) : ℕ)) * (∏ i, ∑ r : ZMod (m i), f i r)| ≤
      4 * ∏ i, ∑ r : ZMod (m i), |f i r| := by
  have hA := lifespan_crt_interval_error m hc f A
  have hB := lifespan_crt_interval_error m hc f B
  rw [sum_Ico_eq_sub _ hAB]
  have he : (∑ k ∈ range B, ∏ i, f i (k : ZMod (m i))) -
        (∑ k ∈ range A, ∏ i, f i (k : ZMod (m i))) -
        (((B : ℝ) - A) / ((∏ i, m i) : ℕ)) * (∏ i, ∑ r : ZMod (m i), f i r) =
      ((∑ k ∈ range B, ∏ i, f i (k : ZMod (m i))) -
        ((B : ℝ) / ((∏ i, m i) : ℕ)) * (∏ i, ∑ r : ZMod (m i), f i r)) -
      ((∑ k ∈ range A, ∏ i, f i (k : ZMod (m i))) -
        ((A : ℝ) / ((∏ i, m i) : ℕ)) * (∏ i, ∑ r : ZMod (m i), f i r)) := by ring
  rw [he]
  exact (abs_sub _ _).trans (by linarith)
end

section
open Finset
/-- Elementary symmetric sum of the local exclusion weights. -/
noncomputable def exclusionElementary {ι : Type*} (s : Finset ι)
    (w : ι → ℝ) (k : ℕ) : ℝ := ∑ t ∈ s.powersetCard k, ∏ i ∈ t, w i

/-- Truncate the product expansion strictly before degree `k`. -/
noncomputable def exclusionTruncation {ι : Type*} (s : Finset ι)
    (w : ι → ℝ) (k : ℕ) : ℝ :=
  ∑ j ∈ range k, (-1 : ℝ)^j * exclusionElementary s w j

theorem exclusion_elementary_zero {ι : Type*} (s : Finset ι) (w : ι → ℝ) :
    exclusionElementary s w 0 = 1 := by simp [exclusionElementary]

theorem exclusion_elementary_empty_succ {ι : Type*} (w : ι → ℝ) (k : ℕ) :
    exclusionElementary ∅ w (k + 1) = 0 := by
  have he : (∅ : Finset ι).powersetCard (k + 1) = ∅ :=
    powersetCard_eq_empty.mpr (by simp)
  simp [exclusionElementary, he]

/-- Separating subsets according to whether they contain the new index. -/
theorem exclusion_elementary_insert {ι : Type*} [DecidableEq ι]
    {s : Finset ι} {a : ι} (ha : a ∉ s) (w : ι → ℝ) (k : ℕ) :
    exclusionElementary (insert a s) w (k + 1) =
      exclusionElementary s w (k + 1) + w a * exclusionElementary s w k := by
  have hd : Disjoint (s.powersetCard (k + 1)) ((s.powersetCard k).image (insert a)) := by
    apply disjoint_left.2
    intro t ht hti
    rcases mem_image.mp hti with ⟨u, hu, rfl⟩
    exact ha ((mem_powersetCard.mp ht).1 (mem_insert_self a u))
  unfold exclusionElementary
  rw [powersetCard_succ_insert ha, sum_union hd, sum_image]
  · rw [mul_sum]
    congr 1
    apply sum_congr rfl
    intro t ht
    exact prod_insert (fun hat => ha ((mem_powersetCard.mp ht).1 hat))
  · intro t ht u hu he
    have ht' : a ∉ t := fun hat => ha ((mem_powersetCard.mp ht).1 hat)
    have hu' : a ∉ u := fun hau => ha ((mem_powersetCard.mp hu).1 hau)
    simpa only [erase_insert ht', erase_insert hu'] using congrArg (fun t => t.erase a) he

/-- The truncated expansion respects insertion, with adjacent degrees. -/
theorem exclusion_truncation_insert {ι : Type*} [DecidableEq ι]
    {s : Finset ι} {a : ι} (ha : a ∉ s) (w : ι → ℝ) (k : ℕ) :
    exclusionTruncation (insert a s) w (k + 1) =
      exclusionTruncation s w (k + 1) - w a * exclusionTruncation s w k := by
  unfold exclusionTruncation
  rw [sum_range_succ', sum_range_succ' (fun j => (-1 : ℝ)^j * exclusionElementary s w j)]
  simp only [exclusion_elementary_zero, pow_zero, one_mul]
  simp_rw [exclusion_elementary_insert ha, mul_add, sum_add_distrib]
  rw [mul_sum]
  have he : (∑ j ∈ range k, (-1 : ℝ)^(j + 1) * (w a * exclusionElementary s w j)) =
      -(∑ j ∈ range k, w a * ((-1 : ℝ)^j * exclusionElementary s w j)) := by
    rw [← sum_neg_distrib]
    apply sum_congr rfl
    intro j hj
    rw [pow_succ]
    ring
  rw [he]
  ring

/-- Bonferroni's signed remainder lies between zero and the next elementary
symmetric sum, for arbitrary finite weights in the unit interval. -/
theorem exclusion_bonferroni {ι : Type*} (s : Finset ι) (w : ι → ℝ)
    (hw : ∀ i ∈ s, 0 ≤ w i ∧ w i ≤ 1) (k : ℕ) :
    0 ≤ (-1 : ℝ)^k * ((∏ i ∈ s, (1 - w i)) - exclusionTruncation s w k) ∧
    (-1 : ℝ)^k * ((∏ i ∈ s, (1 - w i)) - exclusionTruncation s w k) ≤
      exclusionElementary s w k := by
  classical
  induction s using Finset.induction_on generalizing k with
  | empty =>
      cases k with
      | zero => simp [exclusionTruncation, exclusionElementary]
      | succ k =>
          simp [exclusionTruncation, exclusion_elementary_zero,
            exclusion_elementary_empty_succ, sum_range_succ']
  | @insert a s ha ih =>
      have hwa := hw a (mem_insert_self a s)
      have hws : ∀ i ∈ s, 0 ≤ w i ∧ w i ≤ 1 := fun i hi => hw i (mem_insert_of_mem hi)
      cases k with
      | zero =>
          simp only [pow_zero, one_mul, exclusionTruncation, range_zero, sum_empty,
            sub_zero, exclusion_elementary_zero]
          exact ⟨prod_nonneg (fun i hi => sub_nonneg.mpr (hw i hi).2),
            prod_le_one₀ (fun i hi => sub_nonneg.mpr (hw i hi).2)
              (fun i hi => sub_le_self _ (hw i hi).1)⟩
      | succ k =>
          have hk := ih hws k
          have hk1 := ih hws (k + 1)
          rw [prod_insert ha, exclusion_truncation_insert ha,
            exclusion_elementary_insert ha]
          have he : (-1 : ℝ)^(k + 1) *
              ((1 - w a) * (∏ i ∈ s, (1 - w i)) -
                (exclusionTruncation s w (k + 1) - w a * exclusionTruncation s w k)) =
              (-1 : ℝ)^(k + 1) *
                ((∏ i ∈ s, (1 - w i)) - exclusionTruncation s w (k + 1)) +
              w a * ((-1 : ℝ)^k *
                ((∏ i ∈ s, (1 - w i)) - exclusionTruncation s w k)) := by
            rw [pow_succ]
            ring
          rw [he]
          exact ⟨add_nonneg hk1.1 (mul_nonneg hwa.1 hk.1),
            add_le_add hk1.2 (mul_le_mul_of_nonneg_left hk.2 hwa.1)⟩

/-- The elementary symmetric sum is at most the corresponding exponential
coefficient, without any upper bound on the nonnegative weights. -/
theorem exclusion_elementary_factorial {ι : Type*} (s : Finset ι) (w : ι → ℝ)
    (hw : ∀ i ∈ s, 0 ≤ w i) (k : ℕ) :
    exclusionElementary s w k * (k.factorial : ℝ) ≤ (∑ i ∈ s, w i)^k := by
  classical
  induction s using Finset.induction_on generalizing k with
  | empty =>
      cases k <;> simp [exclusion_elementary_zero, exclusion_elementary_empty_succ]
  | @insert a s ha ih =>
      have hwa := hw a (mem_insert_self a s)
      have hws : ∀ i ∈ s, 0 ≤ w i := fun i hi => hw i (mem_insert_of_mem hi)
      have hsum : 0 ≤ ∑ i ∈ s, w i := sum_nonneg hws
      cases k with
      | zero => simp [exclusion_elementary_zero]
      | succ k =>
          rw [exclusion_elementary_insert ha, sum_insert ha]
          have hk := ih hws k
          have hk1 := ih hws (k + 1)
          have hmul := mul_le_mul_of_nonneg_left hk
            (show 0 ≤ w a * ((k + 1 : ℕ) : ℝ) by positivity)
          have hpow := pow_add_mul_le_add_pow hsum
            (show 0 ≤ 2 * (∑ i ∈ s, w i) + w a by positivity) (k + 1)
          simp only [Nat.add_sub_cancel] at hpow
          have he : (exclusionElementary s w (k + 1) + w a * exclusionElementary s w k) *
                ((k + 1).factorial : ℝ) =
              exclusionElementary s w (k + 1) * ((k + 1).factorial : ℝ) +
                (w a * ((k + 1 : ℕ) : ℝ)) * (exclusionElementary s w k * (k.factorial : ℝ)) := by
            rw [Nat.factorial_succ, Nat.cast_mul]
            ring
          rw [he]
          calc
            _ ≤ (∑ i ∈ s, w i)^(k + 1) +
                (w a * ((k + 1 : ℕ) : ℝ)) * (∑ i ∈ s, w i)^k := add_le_add hk1 hmul
            _ = (∑ i ∈ s, w i)^(k + 1) +
                ((k + 1 : ℕ) : ℝ) * (∑ i ∈ s, w i)^k * w a := by ring
            _ ≤ ((∑ i ∈ s, w i) + w a)^(k + 1) := hpow
            _ = _ := by rw [add_comm]

/-- The standard factorial bound, written in the form used to control the
gap between adjacent Bonferroni truncations. -/
theorem exclusion_elementary_le_pow_div_factorial {ι : Type*}
    (s : Finset ι) (w : ι → ℝ) (hw : ∀ i ∈ s, 0 ≤ w i) (k : ℕ) :
    exclusionElementary s w k ≤ (∑ i ∈ s, w i)^k / (k.factorial : ℝ) := by
  apply (le_div_iff₀ (by exact_mod_cast Nat.factorial_pos k)).2
  exact exclusion_elementary_factorial s w hw k

/-- Absolute truncation error, before replacing the elementary coefficient
by its exponential majorant. -/
theorem exclusion_truncation_error {ι : Type*} (s : Finset ι) (w : ι → ℝ)
    (hw : ∀ i ∈ s, 0 ≤ w i ∧ w i ≤ 1) (k : ℕ) :
    |(∏ i ∈ s, (1 - w i)) - exclusionTruncation s w k| ≤
      exclusionElementary s w k := by
  obtain ⟨h0, h1⟩ := exclusion_bonferroni s w hw k
  calc
    _ = |(-1 : ℝ)^k * ((∏ i ∈ s, (1 - w i)) - exclusionTruncation s w k)| := by
      simp [abs_mul]
    _ = _ := abs_of_nonneg h0
    _ ≤ _ := h1

/-- The factorial truncation error used in the residue-replacement argument. -/
theorem exclusion_truncation_error_factorial {ι : Type*} (s : Finset ι) (w : ι → ℝ)
    (hw : ∀ i ∈ s, 0 ≤ w i ∧ w i ≤ 1) (k : ℕ) :
    |(∏ i ∈ s, (1 - w i)) - exclusionTruncation s w k| ≤
      (∑ i ∈ s, w i)^k / (k.factorial : ℝ) := by
  exact (exclusion_truncation_error s w hw k).trans
    (exclusion_elementary_le_pow_div_factorial s w (fun i hi => (hw i hi).1) k)

/-- The gap between adjacent truncations is exactly the next coefficient. -/
theorem exclusion_adjacent_gap {ι : Type*} (s : Finset ι) (w : ι → ℝ)
    (hw : ∀ i ∈ s, 0 ≤ w i) (k : ℕ) :
    |exclusionTruncation s w (k + 1) - exclusionTruncation s w k| =
      exclusionElementary s w k := by
  have hn : 0 ≤ exclusionElementary s w k := by
    apply sum_nonneg
    intro t ht
    exact prod_nonneg (fun i hi => hw i ((mem_powersetCard.mp ht).1 hi))
  simp [exclusionTruncation, sum_range_succ, abs_mul, abs_of_nonneg hn]
end

section
open Finset
/-- A finite nonnegative average preserves the Bonferroni remainder bound. -/
theorem exclusion_average_remainder {ι Ω : Type*} (s : Finset ι) (t : Finset Ω)
    (μ : Ω → ℝ) (X : Ω → ι → ℝ) (hμ : ∀ x ∈ t, 0 ≤ μ x)
    (hX : ∀ x ∈ t, ∀ i ∈ s, 0 ≤ X x i ∧ X x i ≤ 1) (k : ℕ) :
    |(∑ x ∈ t, μ x * ∏ i ∈ s, (1 - X x i)) -
      (∑ x ∈ t, μ x * exclusionTruncation s (X x) k)| ≤
      ∑ x ∈ t, μ x * exclusionElementary s (X x) k := by
  rw [← sum_sub_distrib]
  calc
    _ ≤ ∑ x ∈ t, |μ x * (∏ i ∈ s, (1 - X x i)) -
        μ x * exclusionTruncation s (X x) k| := abs_sum_le_sum_abs _ _
    _ ≤ _ := by
      apply sum_le_sum
      intro x hx
      rw [← mul_sub, abs_mul, abs_of_nonneg (hμ x hx)]
      exact mul_le_mul_of_nonneg_left (exclusion_truncation_error s (X x) (hX x hx) k) (hμ x hx)

/-- The error for a signed truncation is bounded by the sum of its moment
errors. Its alternating coefficients have absolute value one. -/
theorem exclusion_average_truncation_error {ι Ω : Type*} (s : Finset ι) (t : Finset Ω)
    (μ : Ω → ℝ) (X : Ω → ι → ℝ) (v : ι → ℝ) (d : ℕ → ℝ) (k : ℕ)
    (hd : ∀ j < k, |(∑ x ∈ t, μ x * exclusionElementary s (X x) j) -
      exclusionElementary s v j| ≤ d j) :
    |(∑ x ∈ t, μ x * exclusionTruncation s (X x) k) -
      exclusionTruncation s v k| ≤ ∑ j ∈ range k, d j := by
  have he : (∑ x ∈ t, μ x * exclusionTruncation s (X x) k) - exclusionTruncation s v k =
      ∑ j ∈ range k, (-1 : ℝ)^j *
        ((∑ x ∈ t, μ x * exclusionElementary s (X x) j) - exclusionElementary s v j) := by
    simp only [exclusionTruncation, mul_sum]
    rw [sum_comm, ← sum_sub_distrib]
    apply sum_congr rfl
    intro j hj
    rw [mul_sub, mul_sum]
    congr 1
    apply sum_congr rfl
    intro x hx
    ring
  rw [he]
  calc
    _ ≤ ∑ j ∈ range k, |(-1 : ℝ)^j *
        ((∑ x ∈ t, μ x * exclusionElementary s (X x) j) - exclusionElementary s v j)| :=
      abs_sum_le_sum_abs _ _
    _ ≤ _ := by
      apply sum_le_sum
      intro j hj
      simpa only [abs_mul, abs_pow, abs_neg, abs_one, one_pow, one_mul] using hd j (mem_range.mp hj)

/-- Moment comparison through degree `k` controls the full product. This
form allows arithmetic CRT errors to be inserted independently at each degree. -/
theorem exclusion_moment_transfer {ι Ω : Type*} (s : Finset ι) (t : Finset Ω)
    (μ : Ω → ℝ) (X : Ω → ι → ℝ) (v : ι → ℝ) (d : ℕ → ℝ)
    (hμ : ∀ x ∈ t, 0 ≤ μ x)
    (hX : ∀ x ∈ t, ∀ i ∈ s, 0 ≤ X x i ∧ X x i ≤ 1)
    (hv : ∀ i ∈ s, 0 ≤ v i ∧ v i ≤ 1) (k : ℕ)
    (hd : ∀ j ≤ k, |(∑ x ∈ t, μ x * exclusionElementary s (X x) j) -
      exclusionElementary s v j| ≤ d j) :
    |(∑ x ∈ t, μ x * ∏ i ∈ s, (1 - X x i)) - (∏ i ∈ s, (1 - v i))| ≤
      2 * exclusionElementary s v k + ∑ j ∈ range (k + 1), d j := by
  have hrem := exclusion_average_remainder s t μ X hμ hX k
  have htrunc := exclusion_average_truncation_error s t μ X v d k
    (fun j hj => hd j hj.le)
  have hvrem := exclusion_truncation_error s v hv k
  have hmoment := (le_abs_self ((∑ x ∈ t, μ x * exclusionElementary s (X x) k) -
    exclusionElementary s v k)).trans (hd k le_rfl)
  have htri := abs_sub_le
    (∑ x ∈ t, μ x * ∏ i ∈ s, (1 - X x i))
    (∑ x ∈ t, μ x * exclusionTruncation s (X x) k) (∏ i ∈ s, (1 - v i))
  have htri₂ := abs_sub_le (∑ x ∈ t, μ x * exclusionTruncation s (X x) k)
    (exclusionTruncation s v k) (∏ i ∈ s, (1 - v i))
  rw [abs_sub_comm (∏ i ∈ s, (1 - v i))] at hvrem
  rw [sum_range_succ]
  linarith

/-- A quantitative version using only the sum of the model exclusion
probabilities and the finite arithmetic moment errors. -/
theorem exclusion_moment_transfer_factorial {ι Ω : Type*} (s : Finset ι) (t : Finset Ω)
    (μ : Ω → ℝ) (X : Ω → ι → ℝ) (v : ι → ℝ) (d : ℕ → ℝ)
    (hμ : ∀ x ∈ t, 0 ≤ μ x)
    (hX : ∀ x ∈ t, ∀ i ∈ s, 0 ≤ X x i ∧ X x i ≤ 1)
    (hv : ∀ i ∈ s, 0 ≤ v i ∧ v i ≤ 1) (k : ℕ)
    (hd : ∀ j ≤ k, |(∑ x ∈ t, μ x * exclusionElementary s (X x) j) -
      exclusionElementary s v j| ≤ d j) :
    |(∑ x ∈ t, μ x * ∏ i ∈ s, (1 - X x i)) - (∏ i ∈ s, (1 - v i))| ≤
      2 * ((∑ i ∈ s, v i)^k / (k.factorial : ℝ)) + ∑ j ∈ range (k + 1), d j := by
  refine (exclusion_moment_transfer s t μ X v d hμ hX hv k hd).trans ?_
  have he := exclusion_elementary_le_pow_div_factorial s v (fun i hi => (hv i hi).1) k
  linarith
end

section
open Finset
/-- The uniform local mean of a residue weight. -/
noncomputable def exclusionLocalMean {ι : Type*} (m : ι → ℕ) [∀ i, NeZero (m i)]
    (X : ∀ i, ZMod (m i) → ℝ) (i : ι) : ℝ := (∑ r, X i r) / (m i : ℝ)

/-- The unnormalized local absolute mass, controlling the CRT boundary error. -/
noncomputable def exclusionLocalMass {ι : Type*} (m : ι → ℕ) [∀ i, NeZero (m i)]
    (X : ∀ i, ZMod (m i) → ℝ) (i : ι) : ℝ := ∑ r, |X i r|

/-- CRT comparison for one monomial indexed by an arbitrary finite subset. -/
theorem exclusion_crt_monomial {ι : Type*} [DecidableEq ι]
    (m : ι → ℕ) [∀ i, NeZero (m i)]
    (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (X : ∀ i, ZMod (m i) → ℝ) (s : Finset ι) {N : ℕ} (hN : 0 < N) :
    |((∑ n ∈ range N, ∏ i ∈ s, X i (n : ZMod (m i))) / (N : ℝ)) -
      (∏ i ∈ s, exclusionLocalMean m X i)| ≤
      (2 / (N : ℝ)) * ∏ i ∈ s, exclusionLocalMass m X i := by
  have hNs : (0 : ℝ) < N := by exact_mod_cast hN
  have hcs : Pairwise (fun i j : s => Nat.Coprime (m i) (m j)) := by
    intro i j hij
    exact hc (fun he => hij (Subtype.ext he))
  have he := lifespan_crt_interval_error (fun i : s => m i) hcs (fun i => X i) N
  have hp : ∀ n : ℕ, (∏ i : s, X i (n : ZMod (m i))) =
      ∏ i ∈ s, X i (n : ZMod (m i)) := fun n =>
    prod_coe_sort s (fun i => X i (n : ZMod (m i)))
  simp_rw [hp] at he
  rw [prod_coe_sort s m, prod_coe_sort s (fun i => ∑ r, X i r),
    prod_coe_sort s (fun i => ∑ r, |X i r|)] at he
  have hcprod : ((N : ℝ) / ((∏ i ∈ s, m i) : ℕ)) * (∏ i ∈ s, ∑ r, X i r) =
      (N : ℝ) * ∏ i ∈ s, exclusionLocalMean m X i := by
    simp only [exclusionLocalMean, prod_div_distrib, prod_natCast]
    ring
  rw [hcprod] at he
  calc
    _ = |(∑ n ∈ range N, ∏ i ∈ s, X i (n : ZMod (m i))) -
        (N : ℝ) * ∏ i ∈ s, exclusionLocalMean m X i| / (N : ℝ) := by
      calc
        _ = |((∑ n ∈ range N, ∏ i ∈ s, X i (n : ZMod (m i))) -
            (N : ℝ) * ∏ i ∈ s, exclusionLocalMean m X i) / (N : ℝ)| := by
          congr 1
          field_simp
        _ = _ := by rw [abs_div, abs_of_pos hNs]
    _ ≤ (2 * ∏ i ∈ s, ∑ r, |X i r|) / (N : ℝ) :=
      div_le_div_of_nonneg_right he hNs.le
    _ = _ := by simp only [exclusionLocalMass]; ring

/-- Each elementary moment has an error bounded by the same elementary
polynomial evaluated at the local absolute masses. -/
theorem exclusion_crt_moment {ι : Type*} [DecidableEq ι]
    (m : ι → ℕ) [∀ i, NeZero (m i)]
    (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (X : ∀ i, ZMod (m i) → ℝ) (s : Finset ι) {N : ℕ} (hN : 0 < N) (k : ℕ) :
    |(∑ n ∈ range N, (1 / (N : ℝ)) *
        exclusionElementary s (fun i => X i (n : ZMod (m i))) k) -
      exclusionElementary s (exclusionLocalMean m X) k| ≤
      (2 / (N : ℝ)) * exclusionElementary s (exclusionLocalMass m X) k := by
  have he : (∑ n ∈ range N, (1 / (N : ℝ)) *
        exclusionElementary s (fun i => X i (n : ZMod (m i))) k) -
      exclusionElementary s (exclusionLocalMean m X) k =
      ∑ t ∈ s.powersetCard k,
        ((∑ n ∈ range N, ∏ i ∈ t, X i (n : ZMod (m i))) / (N : ℝ) -
          ∏ i ∈ t, exclusionLocalMean m X i) := by
    simp only [exclusionElementary, mul_sum]
    rw [sum_comm, ← sum_sub_distrib]
    apply sum_congr rfl
    intro t ht
    congr 1
    rw [← mul_sum]
    ring
  rw [he]
  calc
    _ ≤ ∑ t ∈ s.powersetCard k,
        |(∑ n ∈ range N, ∏ i ∈ t, X i (n : ZMod (m i))) / (N : ℝ) -
          ∏ i ∈ t, exclusionLocalMean m X i| := abs_sum_le_sum_abs _ _
    _ ≤ ∑ t ∈ s.powersetCard k,
        (2 / (N : ℝ)) * ∏ i ∈ t, exclusionLocalMass m X i := by
      exact sum_le_sum (fun t ht => exclusion_crt_monomial m hc X t hN)
    _ = _ := by rw [← mul_sum]; rfl

/-- Local means of unit-interval weights are again in the unit interval. -/
theorem exclusion_local_mean_unit {ι : Type*} (m : ι → ℕ) [∀ i, NeZero (m i)]
    (X : ∀ i, ZMod (m i) → ℝ) (i : ι) (hX : ∀ r, 0 ≤ X i r ∧ X i r ≤ 1) :
    0 ≤ exclusionLocalMean m X i ∧ exclusionLocalMean m X i ≤ 1 := by
  have hm : (0 : ℝ) < m i := by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne (m i))
  constructor
  · exact div_nonneg (sum_nonneg (fun r hr => (hX r).1)) hm.le
  · apply (div_le_one hm).2
    calc
      (∑ r, X i r) ≤ ∑ _r : ZMod (m i), (1 : ℝ) := sum_le_sum (fun r hr => (hX r).2)
      _ = _ := by simp [ZMod.card]

/-- Quantitative replacement of a finite integer average by independent
uniform residues, without multiplying all moduli into the error term. -/
theorem exclusion_crt_product_error {ι : Type*} [DecidableEq ι]
    (m : ι → ℕ) [∀ i, NeZero (m i)]
    (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (X : ∀ i, ZMod (m i) → ℝ) (s : Finset ι)
    (hX : ∀ i ∈ s, ∀ r, 0 ≤ X i r ∧ X i r ≤ 1) {N : ℕ} (hN : 0 < N) (k : ℕ) :
    |((∑ n ∈ range N, ∏ i ∈ s, (1 - X i (n : ZMod (m i)))) / (N : ℝ)) -
      (∏ i ∈ s, (1 - exclusionLocalMean m X i))| ≤
      2 * ((∑ i ∈ s, exclusionLocalMean m X i)^k / (k.factorial : ℝ)) +
        (2 / (N : ℝ)) * ∑ j ∈ range (k + 1), exclusionElementary s (exclusionLocalMass m X) j := by
  have he := exclusion_moment_transfer_factorial s (range N) (fun _ => 1 / (N : ℝ))
    (fun n i => X i (n : ZMod (m i))) (exclusionLocalMean m X)
    (fun j => (2 / (N : ℝ)) * exclusionElementary s (exclusionLocalMass m X) j)
    (fun n hn => by positivity) (fun n hn i hi => hX i hi _)
    (fun i hi => exclusion_local_mean_unit m X i (hX i hi)) k
    (fun j hj => exclusion_crt_moment m hc X s hN j)
  rw [← mul_sum, ← mul_sum] at he
  have hmean (z : ℝ) : (1 / (N : ℝ)) * z = z / (N : ℝ) := by ring
  rw [hmean] at he
  exact he
end

section
open Finset
theorem exclusion_elementary_one {ι : Type*} (s : Finset ι) (w : ι → ℝ) :
    exclusionElementary s w 1 = ∑ i ∈ s, w i := by
  classical
  simp [exclusionElementary, powersetCard_one]

/-- The finite union bound for arbitrary numbers in the unit interval. -/
theorem exclusion_product_defect_le_sum {ι : Type*} (s : Finset ι) (w : ι → ℝ)
    (hw : ∀ i ∈ s, 0 ≤ w i ∧ w i ≤ 1) :
    1 - ∏ i ∈ s, (1 - w i) ≤ ∑ i ∈ s, w i := by
  have h := (exclusion_bonferroni s w hw 2).1
  norm_num [exclusionTruncation, sum_range_succ, exclusion_elementary_zero,
    exclusion_elementary_one] at h
  linarith

/-- Repeated visits at the same residue are collected into a single local
weight, retaining the complete damping product at that residue. -/
noncomputable def visitExclusion {R : Type*} [DecidableEq R]
    (visits : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ) (r : R) : ℝ :=
  1 - ∏ i ∈ visits, (1 - η i * (if r = h i then 1 else 0))

theorem visit_exclusion_unit {R : Type*} [DecidableEq R]
    (visits : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ)
    (hη : ∀ i ∈ visits, 0 ≤ η i ∧ η i ≤ 1) (r : R) :
    0 ≤ visitExclusion visits h η r ∧ visitExclusion visits h η r ≤ 1 := by
  have hd : ∀ i ∈ visits, 0 ≤ η i * (if r = h i then 1 else 0) ∧
      η i * (if r = h i then 1 else 0) ≤ 1 := by
    intro i hi
    by_cases hir : r = h i
    · simpa [hir] using hη i hi
    · simp [hir]
  have hp0 : 0 ≤ ∏ i ∈ visits, (1 - η i * (if r = h i then 1 else 0)) :=
    prod_nonneg (fun i hi => sub_nonneg.mpr (hd i hi).2)
  have hp1 : (∏ i ∈ visits, (1 - η i * (if r = h i then 1 else 0))) ≤ 1 :=
    prod_le_one₀ (fun i hi => sub_nonneg.mpr (hd i hi).2)
      (fun i hi => sub_le_self _ (hd i hi).1)
  dsimp [visitExclusion]
  constructor <;> linarith

/-- Repeated hits cannot increase the total exclusion mass beyond the sum
of the individual visit weights. -/
theorem visit_exclusion_mass {R : Type*} [Fintype R] [DecidableEq R]
    (visits : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ)
    (hη : ∀ i ∈ visits, 0 ≤ η i ∧ η i ≤ 1) :
    (∑ r : R, visitExclusion visits h η r) ≤ ∑ i ∈ visits, η i := by
  have hb : ∀ r, visitExclusion visits h η r ≤
      ∑ i ∈ visits, η i * (if r = h i then 1 else 0) := by
    intro r
    apply exclusion_product_defect_le_sum
    intro i hi
    by_cases hir : r = h i
    · simpa [hir] using hη i hi
    · simp [hir]
  calc
    _ ≤ ∑ r : R, ∑ i ∈ visits, η i * (if r = h i then 1 else 0) :=
      sum_le_sum (fun r hr => hb r)
    _ = _ := by rw [sum_comm]; simp

/-- Dividing by the residue count gives the local probability estimate used
in the sum of exclusion probabilities. -/
theorem visit_exclusion_mean_bound (q : ℕ) [NeZero q]
    (visits : Finset ℕ) (h : ℕ → ZMod q) (η : ℕ → ℝ)
    (hη : ∀ i ∈ visits, 0 ≤ η i ∧ η i ≤ 1) :
    (∑ r : ZMod q, visitExclusion visits h η r) / (q : ℝ) ≤
      (∑ i ∈ visits, η i) / (q : ℝ) := by
  exact div_le_div_of_nonneg_right (visit_exclusion_mass visits h η hη) (Nat.cast_nonneg q)

/-- A small local exclusion probability leaves an exponentially bounded
survival probability. -/
theorem exclusion_exp_lower {v : ℝ} (hv0 : 0 ≤ v) (hv1 : v ≤ 1 / 2) :
    Real.exp (-2 * v) ≤ 1 - v := by
  have hp : 0 < 1 - v := by linarith
  have hl : -2 * v ≤ 1 - (1 - v)⁻¹ := by
    apply (mul_le_mul_iff_right₀ hp).mp
    have hinv := mul_inv_cancel₀ hp.ne'
    have hquad := mul_nonneg hv0 (show 0 ≤ 1 - 2 * v by linarith)
    nlinarith
  have hlog := hl.trans (Real.one_sub_inv_le_log_of_pos hp)
  calc
    _ ≤ Real.exp (Real.log (1 - v)) := Real.exp_le_exp.mpr hlog
    _ = _ := Real.exp_log hp

/-- Independent local survival factors retain mass at least `exp(-2 λ)`
when their exclusion probabilities are at most one half. -/
theorem exclusion_product_exp_lower {ι : Type*} (s : Finset ι) (v : ι → ℝ)
    (hv : ∀ i ∈ s, 0 ≤ v i ∧ v i ≤ 1 / 2) :
    Real.exp (-2 * ∑ i ∈ s, v i) ≤ ∏ i ∈ s, (1 - v i) := by
  calc
    _ = ∏ i ∈ s, Real.exp (-2 * v i) := by rw [mul_sum, Real.exp_sum]
    _ ≤ _ := prod_le_prod₀ (fun i hi => (Real.exp_pos _).le)
      (fun i hi => exclusion_exp_lower (hv i hi).1 (hv i hi).2)

/-- An absolute error becomes a relative one at the cost of the reciprocal
survival lower bound. -/
theorem exclusion_relative_error {ι : Type*} (s : Finset ι) (v : ι → ℝ)
    (hv : ∀ i ∈ s, 0 ≤ v i ∧ v i ≤ 1 / 2) {A E : ℝ}
    (hE : |A - ∏ i ∈ s, (1 - v i)| ≤ E) :
    |A / (∏ i ∈ s, (1 - v i)) - 1| ≤
      Real.exp (2 * ∑ i ∈ s, v i) * E := by
  have hp := exclusion_product_exp_lower s v hv
  have hp0 : 0 < ∏ i ∈ s, (1 - v i) := (Real.exp_pos _).trans_le hp
  have hE0 : 0 ≤ E := (abs_nonneg _).trans hE
  calc
    _ = |A - ∏ i ∈ s, (1 - v i)| / (∏ i ∈ s, (1 - v i)) := by
      calc
        _ = |(A - ∏ i ∈ s, (1 - v i)) / (∏ i ∈ s, (1 - v i))| := by
          congr 1
          field_simp
        _ = _ := by rw [abs_div, abs_of_pos hp0]
    _ ≤ E / (∏ i ∈ s, (1 - v i)) := div_le_div_of_nonneg_right hE hp0.le
    _ ≤ E / Real.exp (-2 * ∑ i ∈ s, v i) :=
      div_le_div_of_nonneg_left hE0 (Real.exp_pos _) hp
    _ = _ := by rw [show -2 * (∑ i ∈ s, v i) = -(2 * ∑ i ∈ s, v i) by ring,
      Real.exp_neg]; field_simp

/-- Relative CRT replacement for a damped product, in a fully finite form.
The truncation degree may be chosen after the required error is specified. -/
theorem exclusion_crt_relative_error {ι : Type*} [DecidableEq ι]
    (m : ι → ℕ) [∀ i, NeZero (m i)]
    (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (X : ∀ i, ZMod (m i) → ℝ) (s : Finset ι)
    (hX : ∀ i ∈ s, ∀ r, 0 ≤ X i r ∧ X i r ≤ 1)
    (hsmall : ∀ i ∈ s, exclusionLocalMean m X i ≤ 1 / 2)
    {N : ℕ} (hN : 0 < N) (k : ℕ) :
    |((∑ n ∈ range N, ∏ i ∈ s, (1 - X i (n : ZMod (m i)))) / (N : ℝ)) /
        (∏ i ∈ s, (1 - exclusionLocalMean m X i)) - 1| ≤
      Real.exp (2 * ∑ i ∈ s, exclusionLocalMean m X i) *
        (2 * ((∑ i ∈ s, exclusionLocalMean m X i)^k / (k.factorial : ℝ)) +
          (2 / (N : ℝ)) * ∑ j ∈ range (k + 1), exclusionElementary s (exclusionLocalMass m X) j) := by
  apply exclusion_relative_error s (exclusionLocalMean m X)
    (fun i hi => ⟨(exclusion_local_mean_unit m X i (hX i hi)).1, hsmall i hi⟩)
  exact exclusion_crt_product_error m hc X s hX hN k
end

section
open Finset
/-- CRT with one distinguished coordinate and an arbitrary finite set of
other coordinates. The distinguished weight can have either sign. -/
theorem distinguished_crt_error {ι : Type*} [DecidableEq ι]
    (q : ℕ) [NeZero q] (m : ι → ℕ) [∀ i, NeZero (m i)]
    (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (hqm : ∀ i, Nat.Coprime q (m i)) (F : ZMod q → ℝ)
    (X : ∀ i, ZMod (m i) → ℝ) (s : Finset ι) (N : ℕ) :
    |(∑ n ∈ range N, F (n : ZMod q) * ∏ i ∈ s, X i (n : ZMod (m i))) -
      ((N : ℝ) / q) * (∑ r : ZMod q, F r) * (∏ i ∈ s, exclusionLocalMean m X i)| ≤
      2 * (∑ r : ZMod q, |F r|) * ∏ i ∈ s, exclusionLocalMass m X i := by
  let M : Unit ⊕ s → ℕ := Sum.elim (fun _ => q) (fun i => m i)
  let W : ∀ i, ZMod (M i) → ℝ := fun i =>
    match i with
    | .inl _ => F
    | .inr j => X j
  let : ∀ i, NeZero (M i) := fun i => by
    cases i <;> dsimp [M] <;> infer_instance
  have hM : Pairwise (fun i j => Nat.Coprime (M i) (M j)) := by
    intro i j hij
    cases i with
    | inl i =>
        cases j with
        | inl j => exact False.elim (hij (by congr))
        | inr j => exact hqm j
    | inr i =>
        cases j with
        | inl j => exact (hqm i).symm
        | inr j => exact hc (fun h => hij (congrArg Sum.inr (Subtype.ext h)))
  have he := lifespan_crt_interval_error M hM W N
  simp only [Fintype.prod_sum_type, Fintype.prod_unique] at he
  change |(∑ n ∈ range N, F (n : ZMod q) * ∏ i : s, X i (n : ZMod (m i))) -
      ((N : ℝ) / ((q * ∏ i : s, m i) : ℕ)) *
        ((∑ r : ZMod q, F r) * ∏ i : s, ∑ r, X i r)| ≤
      2 * ((∑ r : ZMod q, |F r|) * ∏ i : s, ∑ r, |X i r|) at he
  have hp : ∀ n : ℕ, (∏ i : s, X i (n : ZMod (m i))) =
      ∏ i ∈ s, X i (n : ZMod (m i)) := fun n =>
    prod_coe_sort s (fun i => X i (n : ZMod (m i)))
  simp_rw [hp] at he
  rw [prod_coe_sort s m, prod_coe_sort s (fun i => ∑ r, X i r),
    prod_coe_sort s (fun i => ∑ r, |X i r|)] at he
  have hmain : ((N : ℝ) / ((q * ∏ i ∈ s, m i) : ℕ)) *
        ((∑ r : ZMod q, F r) * ∏ i ∈ s, ∑ r, X i r) =
      ((N : ℝ) / q) * (∑ r : ZMod q, F r) * ∏ i ∈ s, exclusionLocalMean m X i := by
    simp only [exclusionLocalMean, prod_div_distrib, Nat.cast_mul, prod_natCast]
    ring
  rw [hmain] at he
  simpa only [exclusionLocalMass, mul_assoc] using he

/-- The normalized finite averaging weight associated to a fixed active
residue. It has mass approximately one, with the boundary error retained. -/
noncomputable def activeCongruenceWeight (q N : ℕ) (r : ZMod q) (n : ℕ) : ℝ :=
  (q : ℝ) / N * (if (n : ZMod q) = r then 1 else 0)

theorem active_congruence_weight_nonneg (q N : ℕ) (r : ZMod q) (n : ℕ) :
    0 ≤ activeCongruenceWeight q N r n := by
  unfold activeCongruenceWeight
  positivity

/-- A fixed active congruence multiplies the monomial boundary error by
`q`, and changes none of the model means at the coprime inactive moduli. -/
theorem conditioned_crt_monomial {ι : Type*} [DecidableEq ι]
    (q : ℕ) [NeZero q] (m : ι → ℕ) [∀ i, NeZero (m i)]
    (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (hqm : ∀ i, Nat.Coprime q (m i)) (r : ZMod q)
    (X : ∀ i, ZMod (m i) → ℝ) (s : Finset ι) {N : ℕ} (hN : 0 < N) :
    |(∑ n ∈ range N, activeCongruenceWeight q N r n * ∏ i ∈ s, X i (n : ZMod (m i))) -
      (∏ i ∈ s, exclusionLocalMean m X i)| ≤
      (2 * (q : ℝ) / N) * ∏ i ∈ s, exclusionLocalMass m X i := by
  have hq : (q : ℝ) ≠ 0 := by exact_mod_cast NeZero.ne q
  have hNr : (0 : ℝ) < N := by exact_mod_cast hN
  have hs : 0 ≤ (q : ℝ) / N := by positivity
  have he := distinguished_crt_error q m hc hqm (fun t => if t = r then 1 else 0) X s N
  simp only [sum_ite_eq', mem_univ, if_true, abs_ite, abs_one, abs_zero, mul_one] at he
  have halg : (∑ n ∈ range N, activeCongruenceWeight q N r n * ∏ i ∈ s, X i (n : ZMod (m i))) -
      (∏ i ∈ s, exclusionLocalMean m X i) =
      ((q : ℝ) / N) *
        ((∑ n ∈ range N, (if (n : ZMod q) = r then 1 else 0) * ∏ i ∈ s, X i (n : ZMod (m i))) -
          ((N : ℝ) / q) * ∏ i ∈ s, exclusionLocalMean m X i) := by
    simp only [activeCongruenceWeight, mul_assoc, ← mul_sum]
    field_simp
  rw [halg, abs_mul, abs_of_nonneg hs]
  calc
    _ ≤ ((q : ℝ) / N) * (2 * ∏ i ∈ s, exclusionLocalMass m X i) :=
      mul_le_mul_of_nonneg_left he hs
    _ = _ := by ring

/-- The elementary-moment comparison retains the same active-modulus cost
at every degree, including degree zero. -/
theorem conditioned_crt_moment {ι : Type*} [DecidableEq ι]
    (q : ℕ) [NeZero q] (m : ι → ℕ) [∀ i, NeZero (m i)]
    (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (hqm : ∀ i, Nat.Coprime q (m i)) (r : ZMod q)
    (X : ∀ i, ZMod (m i) → ℝ) (s : Finset ι) {N : ℕ} (hN : 0 < N) (k : ℕ) :
    |(∑ n ∈ range N, activeCongruenceWeight q N r n *
        exclusionElementary s (fun i => X i (n : ZMod (m i))) k) -
      exclusionElementary s (exclusionLocalMean m X) k| ≤
      (2 * (q : ℝ) / N) * exclusionElementary s (exclusionLocalMass m X) k := by
  have he : (∑ n ∈ range N, activeCongruenceWeight q N r n *
        exclusionElementary s (fun i => X i (n : ZMod (m i))) k) -
      exclusionElementary s (exclusionLocalMean m X) k =
      ∑ t ∈ s.powersetCard k,
        ((∑ n ∈ range N, activeCongruenceWeight q N r n * ∏ i ∈ t, X i (n : ZMod (m i))) -
          ∏ i ∈ t, exclusionLocalMean m X i) := by
    simp only [exclusionElementary, mul_sum]
    rw [sum_comm, ← sum_sub_distrib]
  rw [he]
  calc
    _ ≤ ∑ t ∈ s.powersetCard k,
        |(∑ n ∈ range N, activeCongruenceWeight q N r n * ∏ i ∈ t, X i (n : ZMod (m i))) -
          ∏ i ∈ t, exclusionLocalMean m X i| := abs_sum_le_sum_abs _ _
    _ ≤ ∑ t ∈ s.powersetCard k,
        (2 * (q : ℝ) / N) * ∏ i ∈ t, exclusionLocalMass m X i := by
      exact sum_le_sum (fun t ht => conditioned_crt_monomial q m hc hqm r X t hN)
    _ = _ := by rw [← mul_sum]; rfl

/-- Finite residue replacement conditioned on the active congruence. The
error uses only low-degree masses at the inactive moduli. -/
theorem conditioned_crt_product_error {ι : Type*} [DecidableEq ι]
    (q : ℕ) [NeZero q] (m : ι → ℕ) [∀ i, NeZero (m i)]
    (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (hqm : ∀ i, Nat.Coprime q (m i)) (r : ZMod q)
    (X : ∀ i, ZMod (m i) → ℝ) (s : Finset ι)
    (hX : ∀ i ∈ s, ∀ t, 0 ≤ X i t ∧ X i t ≤ 1) {N : ℕ} (hN : 0 < N) (k : ℕ) :
    |(∑ n ∈ range N, activeCongruenceWeight q N r n *
        ∏ i ∈ s, (1 - X i (n : ZMod (m i)))) -
      (∏ i ∈ s, (1 - exclusionLocalMean m X i))| ≤
      2 * ((∑ i ∈ s, exclusionLocalMean m X i)^k / (k.factorial : ℝ)) +
        (2 * (q : ℝ) / N) * ∑ j ∈ range (k + 1), exclusionElementary s (exclusionLocalMass m X) j := by
  have he := exclusion_moment_transfer_factorial s (range N) (activeCongruenceWeight q N r)
    (fun n i => X i (n : ZMod (m i))) (exclusionLocalMean m X)
    (fun j => (2 * (q : ℝ) / N) * exclusionElementary s (exclusionLocalMass m X) j)
    (fun n hn => active_congruence_weight_nonneg q N r n)
    (fun n hn i hi => hX i hi _) (fun i hi => exclusion_local_mean_unit m X i (hX i hi)) k
    (fun j hj => conditioned_crt_moment q m hc hqm r X s hN j)
  rwa [← mul_sum] at he

/-- Relative residue replacement with a fixed active congruence. The
independent survival probability is bounded below before division. -/
theorem conditioned_crt_relative_error {ι : Type*} [DecidableEq ι]
    (q : ℕ) [NeZero q] (m : ι → ℕ) [∀ i, NeZero (m i)]
    (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (hqm : ∀ i, Nat.Coprime q (m i)) (r : ZMod q)
    (X : ∀ i, ZMod (m i) → ℝ) (s : Finset ι)
    (hX : ∀ i ∈ s, ∀ t, 0 ≤ X i t ∧ X i t ≤ 1)
    (hsmall : ∀ i ∈ s, exclusionLocalMean m X i ≤ 1 / 2)
    {N : ℕ} (hN : 0 < N) (k : ℕ) :
    |(∑ n ∈ range N, activeCongruenceWeight q N r n *
        ∏ i ∈ s, (1 - X i (n : ZMod (m i)))) /
        (∏ i ∈ s, (1 - exclusionLocalMean m X i)) - 1| ≤
      Real.exp (2 * ∑ i ∈ s, exclusionLocalMean m X i) *
        (2 * ((∑ i ∈ s, exclusionLocalMean m X i)^k / (k.factorial : ℝ)) +
          (2 * (q : ℝ) / N) * ∑ j ∈ range (k + 1), exclusionElementary s (exclusionLocalMass m X) j) := by
  apply exclusion_relative_error s (exclusionLocalMean m X)
    (fun i hi => ⟨(exclusion_local_mean_unit m X i (hX i hi)).1, hsmall i hi⟩)
  exact conditioned_crt_product_error q m hc hqm r X s hX hN k
end

section
open Finset
/-- A factorial tail bound sufficient for an arbitrary prescribed
exponential precision, using only a linear choice of degree. -/
theorem exclusion_factorial_exp_bound {ℓ : ℝ} (hℓ : 0 ≤ ℓ) (k : ℕ) :
    ℓ^k / (k.factorial : ℝ) ≤ Real.exp (3 * ℓ - k) := by
  rw [Real.exp_sub]
  apply (le_div_iff₀ (Real.exp_pos _)).2
  have he : (Real.exp 1)^k = Real.exp (k : ℝ) := by
    rw [← Real.exp_nat_mul]
    simp
  calc
    (ℓ^k / (k.factorial : ℝ)) * Real.exp (k : ℝ) =
        (Real.exp 1 * ℓ)^k / (k.factorial : ℝ) := by rw [mul_pow, he]; ring
    _ ≤ Real.exp (Real.exp 1 * ℓ) := Real.pow_div_factorial_le_exp _ (by positivity) k
    _ ≤ Real.exp (3 * ℓ) := Real.exp_le_exp.mpr
      (mul_le_mul_of_nonneg_right Real.exp_one_lt_three.le hℓ)

/-- The finite sum of elementary absolute masses has a bound involving
only their total mass and the truncation degree. -/
theorem exclusion_truncated_mass_bound {ι : Type*} (s : Finset ι) (c : ι → ℝ)
    (hc : ∀ i ∈ s, 0 ≤ c i) (k : ℕ) :
    (∑ j ∈ range (k + 1), exclusionElementary s c j) ≤
      (k + 1 : ℕ) * (1 + ∑ i ∈ s, c i)^k := by
  have hsum : 0 ≤ ∑ i ∈ s, c i := sum_nonneg hc
  calc
    _ ≤ ∑ _j ∈ range (k + 1), (1 + ∑ i ∈ s, c i)^k := by
      apply sum_le_sum
      intro j hj
      have hjk : j ≤ k := by have := mem_range.mp hj; omega
      calc
        exclusionElementary s c j ≤ (∑ i ∈ s, c i)^j / (j.factorial : ℝ) :=
          exclusion_elementary_le_pow_div_factorial s c hc j
        _ ≤ (∑ i ∈ s, c i)^j := div_le_self (pow_nonneg hsum j)
          (by exact_mod_cast Nat.factorial_pos j)
        _ ≤ (1 + ∑ i ∈ s, c i)^j := pow_le_pow_left₀ hsum (by linarith) j
        _ ≤ (1 + ∑ i ∈ s, c i)^k := pow_le_pow_right₀ (by linarith) hjk
    _ = _ := by simp

/-- The factorial part of the relative error is at most half the requested
precision once the degree exceeds a linear threshold. -/
theorem exclusion_relative_tail_small {ℓ B : ℝ} (hℓ : 0 ≤ ℓ) (k : ℕ)
    (hk : 5 * ℓ + B + Real.log 4 ≤ (k : ℝ)) :
    Real.exp (2 * ℓ) * (2 * (ℓ^k / (k.factorial : ℝ))) ≤ Real.exp (-B) / 2 := by
  calc
    _ ≤ Real.exp (2 * ℓ) * (2 * Real.exp (3 * ℓ - k)) := by
      gcongr
      exact exclusion_factorial_exp_bound hℓ k
    _ = 2 * Real.exp (5 * ℓ - k) := by
      rw [mul_left_comm, ← Real.exp_add]
      congr 2
      ring
    _ ≤ 2 * Real.exp (-B - Real.log 4) := by
      apply mul_le_mul_of_nonneg_left _ (by norm_num)
      exact Real.exp_le_exp.mpr (by linarith)
    _ = _ := by rw [Real.exp_sub, Real.exp_log (by norm_num : (0 : ℝ) < 4)]; ring

/-- A direct numerical condition for the arithmetic half of the relative
error. Its logarithm will later be compared with the interval length. -/
theorem exclusion_relative_arithmetic_small {ℓ B C q N T : ℝ}
    (hN : 0 < N) (hq : 0 ≤ q) (k : ℕ)
    (hT : T ≤ (k + 1 : ℕ) * (1 + C)^k)
    (hsize : 4 * q * (k + 1 : ℕ) * Real.exp (B + 2 * ℓ) * (1 + C)^k ≤ N) :
    Real.exp (2 * ℓ) * ((2 * q / N) * T) ≤ Real.exp (-B) / 2 := by
  have hexp : Real.exp (B + 2 * ℓ) * Real.exp (-B) = Real.exp (2 * ℓ) := by
    rw [← Real.exp_add]
    congr 1
    ring
  calc
    _ ≤ Real.exp (2 * ℓ) * ((2 * q / N) * ((k + 1 : ℕ) * (1 + C)^k)) := by
      exact mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hT (by positivity)) (by positivity)
    _ = ((4 * q * (k + 1 : ℕ) * Real.exp (B + 2 * ℓ) * (1 + C)^k) / N) *
        (Real.exp (-B) / 2) := by
      rw [show (4 * q * (k + 1 : ℕ) * Real.exp (B + 2 * ℓ) * (1 + C)^k / N) *
          (Real.exp (-B) / 2) =
          (2 * q / N) * (k + 1 : ℕ) * (1 + C)^k *
            (Real.exp (B + 2 * ℓ) * Real.exp (-B)) by ring, hexp]
      ring
    _ ≤ 1 * (Real.exp (-B) / 2) :=
      mul_le_mul_of_nonneg_right ((div_le_one hN).2 hsize) (by positivity)
    _ = _ := one_mul _

/-- Finite numerical assumptions that ensure exponentially small relative
error after both the Bonferroni and CRT contributions are included. -/
theorem residue_replacement_error_small {ℓ B C q N T : ℝ}
    (hℓ : 0 ≤ ℓ) (hN : 0 < N) (hq : 0 ≤ q) (k : ℕ)
    (hk : 5 * ℓ + B + Real.log 4 ≤ (k : ℝ))
    (hT : T ≤ (k + 1 : ℕ) * (1 + C)^k)
    (hsize : 4 * q * (k + 1 : ℕ) * Real.exp (B + 2 * ℓ) * (1 + C)^k ≤ N) :
    Real.exp (2 * ℓ) * (2 * (ℓ^k / (k.factorial : ℝ)) + (2 * q / N) * T) ≤
      Real.exp (-B) := by
  rw [mul_add]
  have htail := exclusion_relative_tail_small hℓ k hk
  have harith := exclusion_relative_arithmetic_small hN hq k hT hsize
  linarith

/-- An additive logarithmic budget suffices for the interval-size condition. -/
theorem residue_size_condition_of_log {ℓ B C q N : ℝ}
    (hC : 0 ≤ C) (hq : 0 < q) (hN : 0 < N) (k : ℕ)
    (hlog : Real.log 4 + Real.log q + Real.log (k + 1 : ℕ) + B + 2 * ℓ +
      (k : ℝ) * Real.log (1 + C) ≤ Real.log N) :
    4 * q * (k + 1 : ℕ) * Real.exp (B + 2 * ℓ) * (1 + C)^k ≤ N := by
  apply (Real.log_le_log_iff (by positivity) hN).mp
  have he : Real.log (4 * q * (k + 1 : ℕ) * Real.exp (B + 2 * ℓ) * (1 + C)^k) =
      Real.log 4 + Real.log q + Real.log (k + 1 : ℕ) + B + 2 * ℓ +
        (k : ℝ) * Real.log (1 + C) := by
    rw [Real.log_mul (by positivity) (by positivity),
      Real.log_mul (by positivity) (by positivity),
      Real.log_mul (by positivity) (by positivity),
      Real.log_mul (by norm_num) hq.ne', Real.log_exp, Real.log_pow]
    ring
  rwa [he]

/-- An explicit finite criterion for exponentially accurate residue
replacement with the active congruence imposed. -/
theorem conditioned_crt_exponential_error {ι : Type*} [DecidableEq ι]
    (q : ℕ) [NeZero q] (m : ι → ℕ) [∀ i, NeZero (m i)]
    (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (hqm : ∀ i, Nat.Coprime q (m i)) (r : ZMod q)
    (X : ∀ i, ZMod (m i) → ℝ) (s : Finset ι)
    (hX : ∀ i ∈ s, ∀ t, 0 ≤ X i t ∧ X i t ≤ 1)
    (hsmall : ∀ i ∈ s, exclusionLocalMean m X i ≤ 1 / 2)
    {N : ℕ} (hN : 0 < N) (k : ℕ) (B : ℝ)
    (hk : 5 * (∑ i ∈ s, exclusionLocalMean m X i) + B + Real.log 4 ≤ (k : ℝ))
    (hsize : 4 * (q : ℝ) * (k + 1 : ℕ) *
      Real.exp (B + 2 * ∑ i ∈ s, exclusionLocalMean m X i) *
        (1 + ∑ i ∈ s, exclusionLocalMass m X i)^k ≤ N) :
    |(∑ n ∈ range N, activeCongruenceWeight q N r n *
        ∏ i ∈ s, (1 - X i (n : ZMod (m i)))) /
        (∏ i ∈ s, (1 - exclusionLocalMean m X i)) - 1| ≤ Real.exp (-B) := by
  refine (conditioned_crt_relative_error q m hc hqm r X s hX hsmall hN k).trans ?_
  exact residue_replacement_error_small
    (sum_nonneg (fun i hi => (exclusion_local_mean_unit m X i (hX i hi)).1))
    (by exact_mod_cast hN) (Nat.cast_nonneg q) k hk
    (exclusion_truncated_mass_bound s (exclusionLocalMass m X)
      (fun i hi => sum_nonneg (fun t ht => abs_nonneg _)) k) hsize
end

section
open Finset
/-- Parameterize an integer interval by its nonnegative offsets. -/
theorem integer_interval_sum {A : Type*} [AddCommMonoid A]
    (f : ℤ → A) (z : ℤ) (N : ℕ) :
    (∑ n ∈ range N, f (z + n)) = ∑ n ∈ Ico z (z + N), f n := by
  refine sum_bij (fun n hn => z + (n : ℤ)) ?_ ?_ ?_ ?_
  · intro n hn
    simp only [mem_range] at hn
    simp only [mem_Ico]
    omega
  · intro a ha b hb he
    omega
  · intro n hn
    simp only [mem_Ico] at hn
    refine ⟨(n - z).toNat, ?_, ?_⟩
    · simp only [mem_range]
      omega
    · omega
  · intro n hn
    rfl

/-- Translation preserves the uniform local mean. -/
theorem exclusion_local_mean_translate {ι : Type*} (m : ι → ℕ) [∀ i, NeZero (m i)]
    (X : ∀ i, ZMod (m i) → ℝ) (z : ℤ) (i : ι) :
    exclusionLocalMean m (fun j t => X j ((z : ZMod (m j)) + t)) i =
      exclusionLocalMean m X i := by
  unfold exclusionLocalMean
  congr 1
  exact Equiv.sum_comp (Equiv.addLeft (z : ZMod (m i))) (X i)

/-- Translation preserves the local absolute mass as well. -/
theorem exclusion_local_mass_translate {ι : Type*} (m : ι → ℕ) [∀ i, NeZero (m i)]
    (X : ∀ i, ZMod (m i) → ℝ) (z : ℤ) (i : ι) :
    exclusionLocalMass m (fun j t => X j ((z : ZMod (m j)) + t)) i =
      exclusionLocalMass m X i := by
  unfold exclusionLocalMass
  exact Equiv.sum_comp (Equiv.addLeft (z : ZMod (m i))) (fun t => |X i t|)

/-- The same active-residue weight, evaluated at integer positions. -/
noncomputable def activeIntegerCongruenceWeight (q N : ℕ) (r : ZMod q) (n : ℤ) : ℝ :=
  (q : ℝ) / N * (if (n : ZMod q) = r then 1 else 0)

theorem active_congruence_weight_translate (q N : ℕ) (r : ZMod q) (z : ℤ) (n : ℕ) :
    activeCongruenceWeight q N (r - z) n =
      activeIntegerCongruenceWeight q N r (z + n) := by
  simp only [activeCongruenceWeight, activeIntegerCongruenceWeight, Int.cast_add,
    Int.cast_natCast, eq_sub_iff_add_eq, add_comm]

/-- Exponentially accurate relative residue replacement on an arbitrary
integer interval, with one fixed active congruence. -/
theorem conditioned_crt_integer_interval {ι : Type*} [DecidableEq ι]
    (q : ℕ) [NeZero q] (m : ι → ℕ) [∀ i, NeZero (m i)]
    (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (hqm : ∀ i, Nat.Coprime q (m i)) (r : ZMod q)
    (X : ∀ i, ZMod (m i) → ℝ) (s : Finset ι)
    (hX : ∀ i ∈ s, ∀ t, 0 ≤ X i t ∧ X i t ≤ 1)
    (hsmall : ∀ i ∈ s, exclusionLocalMean m X i ≤ 1 / 2)
    {N : ℕ} (hN : 0 < N) (z : ℤ) (k : ℕ) (B : ℝ)
    (hk : 5 * (∑ i ∈ s, exclusionLocalMean m X i) + B + Real.log 4 ≤ (k : ℝ))
    (hsize : 4 * (q : ℝ) * (k + 1 : ℕ) *
      Real.exp (B + 2 * ∑ i ∈ s, exclusionLocalMean m X i) *
        (1 + ∑ i ∈ s, exclusionLocalMass m X i)^k ≤ N) :
    |(∑ n ∈ Ico z (z + N), activeIntegerCongruenceWeight q N r n *
        ∏ i ∈ s, (1 - X i (n : ZMod (m i)))) /
        (∏ i ∈ s, (1 - exclusionLocalMean m X i)) - 1| ≤ Real.exp (-B) := by
  have hsmall' : ∀ i ∈ s,
      exclusionLocalMean m (fun j t => X j ((z : ZMod (m j)) + t)) i ≤ 1 / 2 := by
    intro i hi
    simpa only [exclusion_local_mean_translate] using hsmall i hi
  have he := conditioned_crt_exponential_error q m hc hqm (r - z)
    (fun j t => X j ((z : ZMod (m j)) + t)) s (fun i hi t => hX i hi _) hsmall' hN k B
    (by simpa only [exclusion_local_mean_translate] using hk)
    (by simpa only [exclusion_local_mean_translate, exclusion_local_mass_translate] using hsize)
  simp_rw [exclusion_local_mean_translate, active_congruence_weight_translate] at he
  rw [← integer_interval_sum]
  simpa only [Int.cast_add, Int.cast_natCast] using he

/-- Multiplying both the finite average and its model by a deterministic
nonnegative damping factor preserves a relative-error estimate, including
the case where that damping factor is zero. -/
theorem restore_deterministic_damping {A P D E : ℝ} (hP : 0 < P) (hD : 0 ≤ D)
    (hE : |A / P - 1| ≤ E) : |D * A - D * P| ≤ E * (D * P) := by
  have he : |A / P - 1| * P = |A - P| := by
    calc
      _ = |(A / P - 1) * P| := by rw [abs_mul, abs_of_pos hP]
      _ = _ := by congr 1; field_simp
  have hb := mul_le_mul_of_nonneg_right hE hP.le
  rw [he] at hb
  calc
    _ = D * |A - P| := by rw [← mul_sub, abs_mul, abs_of_nonneg hD]
    _ ≤ D * (E * P) := mul_le_mul_of_nonneg_left hb hD
    _ = _ := by ring
end

section
open Finset
/-- Congruence at each coprime factor is equivalent to congruence at their
product, for arbitrary integer positions. -/
theorem integer_congruences_product_iff {ι : Type*} (m : ι → ℕ) (s : Finset ι)
    (hc : (s : Set ι).Pairwise (fun i j => Nat.Coprime (m i) (m j))) (n c : ℤ) :
    (∀ i ∈ s, (n : ZMod (m i)) = (c : ZMod (m i))) ↔
      (n : ZMod (∏ i ∈ s, m i)) = (c : ZMod (∏ i ∈ s, m i)) := by
  simp only [ZMod.intCast_eq_intCast_iff_dvd_sub]
  rw [prod_natCast]
  constructor
  · intro h
    exact prod_dvd_of_coprime (fun i hi j hj hij => (hc hi hj hij).isCoprime) h
  · intro h i hi
    exact (dvd_prod_of_mem (fun j => (m j : ℤ)) hi).trans h

/-- Arbitrary prescribed residues at pairwise coprime positive moduli have
a common integer representative, unique modulo the product. -/
theorem active_congruences_representative {ι : Type*}
    (m : ι → ℕ) [∀ i, NeZero (m i)] (s : Finset ι)
    (hc : (s : Set ι).Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (r : ∀ i, ZMod (m i)) :
    ∃ c : ℤ, ∀ n : ℤ, (∀ i ∈ s, (n : ZMod (m i)) = r i) ↔
      (n : ZMod (∏ i ∈ s, m i)) = (c : ZMod (∏ i ∈ s, m i)) := by
  have hm : ∀ i ∈ s, m i ≠ 0 := fun i hi => NeZero.ne (m i)
  let c := Nat.chineseRemainderOfFinset (fun i => (r i).val) m s hm hc
  have hr : ∀ i ∈ s, ((c.val : ℤ) : ZMod (m i)) = r i := by
    intro i hi
    rw [Int.cast_natCast]
    have he : (c.val : ZMod (m i)) = ((r i).val : ZMod (m i)) :=
      (ZMod.natCast_eq_natCast_iff _ _ _).2 (c.property i hi)
    exact he.trans (ZMod.natCast_zmod_val (r i))
  refine ⟨c.val, ?_⟩
  intro n
  rw [← integer_congruences_product_iff m s hc n c.val]
  constructor
  · intro h i hi
    exact (h i hi).trans (hr i hi).symm
  · intro h i hi
    exact (h i hi).trans (hr i hi)

/-- The product of active-hit indicators is exactly one indicator at the
active product modulus, so it incurs only one density factor. -/
theorem active_indicator_product {ι : Type*} [DecidableEq ι]
    (m : ι → ℕ) [∀ i, NeZero (m i)] (s : Finset ι)
    (hc : (s : Set ι).Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (r : ∀ i, ZMod (m i)) :
    ∃ c : ℤ, ∀ n : ℤ,
      (∏ i ∈ s, (if (n : ZMod (m i)) = r i then (1 : ℝ) else 0)) =
        if (n : ZMod (∏ i ∈ s, m i)) = (c : ZMod (∏ i ∈ s, m i)) then 1 else 0 := by
  obtain ⟨c, hc⟩ := active_congruences_representative m s hc r
  refine ⟨c, ?_⟩
  intro n
  rw [prod_boole]
  simp only [hc n]

/-- A nonnegative deterministic damping factor can be restored without
weakening the relative finite-interval estimate. -/
theorem conditioned_crt_damped_interval {ι : Type*} [DecidableEq ι]
    (q : ℕ) [NeZero q] (m : ι → ℕ) [∀ i, NeZero (m i)]
    (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (hqm : ∀ i, Nat.Coprime q (m i)) (r : ZMod q)
    (X : ∀ i, ZMod (m i) → ℝ) (s : Finset ι)
    (hX : ∀ i ∈ s, ∀ t, 0 ≤ X i t ∧ X i t ≤ 1)
    (hsmall : ∀ i ∈ s, exclusionLocalMean m X i ≤ 1 / 2)
    {N : ℕ} (hN : 0 < N) (z : ℤ) (k : ℕ) (B D : ℝ) (hD : 0 ≤ D)
    (hk : 5 * (∑ i ∈ s, exclusionLocalMean m X i) + B + Real.log 4 ≤ (k : ℝ))
    (hsize : 4 * (q : ℝ) * (k + 1 : ℕ) *
      Real.exp (B + 2 * ∑ i ∈ s, exclusionLocalMean m X i) *
        (1 + ∑ i ∈ s, exclusionLocalMass m X i)^k ≤ N) :
    |(D / (N : ℝ)) * (∑ n ∈ Ico z (z + N),
        (if (n : ZMod q) = r then 1 else 0) * ∏ i ∈ s, (1 - X i (n : ZMod (m i)))) -
      (D / (q : ℝ)) * (∏ i ∈ s, (1 - exclusionLocalMean m X i))| ≤
      Real.exp (-B) * ((D / (q : ℝ)) * ∏ i ∈ s, (1 - exclusionLocalMean m X i)) := by
  have he := conditioned_crt_integer_interval q m hc hqm r X s hX hsmall hN z k B hk hsize
  have hP : 0 < ∏ i ∈ s, (1 - exclusionLocalMean m X i) := by
    apply prod_pos
    intro i hi
    linarith [hsmall i hi]
  have hb := restore_deterministic_damping hP (show 0 ≤ D / (q : ℝ) by positivity) he
  have hq : (q : ℝ) ≠ 0 := by exact_mod_cast NeZero.ne q
  have hmean : (D / (q : ℝ)) *
      (∑ n ∈ Ico z (z + N), activeIntegerCongruenceWeight q N r n *
        ∏ i ∈ s, (1 - X i (n : ZMod (m i)))) =
      (D / (N : ℝ)) * (∑ n ∈ Ico z (z + N), (if (n : ZMod q) = r then 1 else 0) *
        ∏ i ∈ s, (1 - X i (n : ZMod (m i)))) := by
    simp only [activeIntegerCongruenceWeight, mul_assoc, ← mul_sum]
    field_simp
  rwa [hmean] at hb
end

section
open Finset
/-- The inactive damping of a prime whose residue was fixed by an active visit. -/
noncomputable def activeVisitDamping {R : Type*} [DecidableEq R]
    (visits active : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ) (a : ℕ) : ℝ :=
  ∏ i ∈ visits \ active, (1 - η i * (if h i = h a then 1 else 0))

/-- Incompatible active visits vanish pointwise, before any averaging. -/
theorem active_residue_weight_incompatible {R : Type*} [DecidableEq R]
    (visits active : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ)
    {a z : ℕ} (ha : a ∈ active) (hz : z ∈ active) (haz : h a ≠ h z) (r : R) :
    activeResidueWeight visits active h η r = 0 := by
  have hn : ¬ ∀ i ∈ active, r = h i := by
    intro hh
    exact haz ((hh a ha).symm.trans (hh z hz))
  simp [activeResidueWeight, prod_boole, hn]

/-- Compatible active visits fix one residue; all their inactive damping
can then be evaluated at that residue and factored out. -/
theorem active_residue_weight_factor {R : Type*} [DecidableEq R]
    (visits active : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ)
    (a : ℕ) (ha : a ∈ active) (hc : ∀ i ∈ active, h i = h a) (r : R) :
    activeResidueWeight visits active h η r =
      (if r = h a then 1 else 0) * activeVisitDamping visits active h η a := by
  classical
  by_cases hr : r = h a
  · subst r
    have he : ∀ i ∈ active, h a = h i := fun i hi => (hc i hi).symm
    have hp : (∏ i ∈ active, (if h a = h i then (1 : ℝ) else 0)) = 1 := by
      apply prod_eq_one
      intro i hi
      simp only [if_pos (he i hi)]
    unfold activeResidueWeight activeVisitDamping
    rw [hp]
    simp only [ite_true, one_mul]
    apply prod_congr rfl
    intro i hi
    simp only [eq_comm]
  · have he : ¬ ∀ i ∈ active, r = h i := fun hh => hr (hh a ha)
    simp [activeResidueWeight, prod_boole, he, hr]

/-- The factored damping is nonnegative for unit-interval visit weights. -/
theorem active_visit_damping_nonneg {R : Type*} [DecidableEq R]
    (visits active : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ) (a : ℕ)
    (hη : ∀ i ∈ visits, 0 ≤ η i ∧ η i ≤ 1) :
    0 ≤ activeVisitDamping visits active h η a := by
  apply prod_nonneg
  intro i hi
  have hηi := hη i (mem_sdiff.mp hi).1
  by_cases hh : h i = h a
  · simp only [hh, if_true, mul_one]
    linarith
  · simp [hh]

/-- A family of compatible active primes contributes exactly one combined
congruence, times the product of its deterministic inactive damping. -/
theorem active_path_residue_factorization {ι : Type*} [DecidableEq ι]
    (m : ι → ℕ) [∀ i, NeZero (m i)] (S : Finset ι) (visits : Finset ℕ)
    (active : ι → Finset ℕ) (h : ∀ i, ℕ → ZMod (m i)) (η : ℕ → ℝ) (a : ι → ℕ)
    (hm : (S : Set ι).Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (ha : ∀ i ∈ S, a i ∈ active i)
    (hc : ∀ i ∈ S, ∀ j ∈ active i, h i j = h i (a i)) :
    ∃ c : ℤ, ∀ n : ℤ,
      (∏ i ∈ S, activeResidueWeight visits (active i) (h i) η (n : ZMod (m i))) =
        (if (n : ZMod (∏ i ∈ S, m i)) = (c : ZMod (∏ i ∈ S, m i)) then 1 else 0) *
          ∏ i ∈ S, activeVisitDamping visits (active i) (h i) η (a i) := by
  obtain ⟨c, hroot⟩ := active_indicator_product m S hm (fun i => h i (a i))
  refine ⟨c, ?_⟩
  intro n
  calc
    _ = ∏ i ∈ S, (if (n : ZMod (m i)) = h i (a i) then 1 else 0) *
        activeVisitDamping visits (active i) (h i) η (a i) := by
      apply prod_congr rfl
      intro i hi
      exact active_residue_weight_factor visits (active i) (h i) η (a i) (ha i hi) (hc i hi) _
    _ = _ := by rw [prod_mul_distrib, hroot n]

/-- A single incompatible active prime makes the full active-family
contribution vanish at every integer position. -/
theorem active_path_residue_incompatible {ι : Type*} [DecidableEq ι]
    (m : ι → ℕ) (S : Finset ι) (visits : Finset ℕ)
    (active : ι → Finset ℕ) (h : ∀ i, ℕ → ZMod (m i)) (η : ℕ → ℝ)
    {i : ι} (hi : i ∈ S) {a z : ℕ} (ha : a ∈ active i) (hz : z ∈ active i)
    (haz : h i a ≠ h i z) (n : ℤ) :
    (∏ j ∈ S, activeResidueWeight visits (active j) (h j) η (n : ZMod (m j))) = 0 := by
  apply prod_eq_zero hi
  exact active_residue_weight_incompatible visits (active i) (h i) η ha hz haz _
end

section

/-- Reservoir indices whose group labels lie in the selected subgroup. -/
noncomputable def subgroupReservoir {G ι : Type*} [Group G]
    (S : Finset ι) (g : ι → G) (H : Subgroup G) : Finset ι := by
  classical
  exact S.filter fun i => g i ∈ H

theorem subgroupReservoir_top {G ι : Type*} [Group G]
    (S : Finset ι) (g : ι → G) : subgroupReservoir S g ⊤ = S := by
  classical
  simp [subgroupReservoir]

/-- A proper subgroup of a finite group has at most half its order. -/
theorem subgroup_card_twice_le {G : Type*} [Group G] [Finite G]
    {K H : Subgroup G} (hKH : K < H) : 2 * Nat.card K ≤ Nat.card H := by
  have hKpos : 0 < Nat.card K := Nat.card_pos
  have hlt : Nat.card K < Nat.card H := by
    by_contra h
    exact hKH.ne (Subgroup.eq_of_le_of_card_ge hKH.le (by omega))
  obtain ⟨d, hd⟩ := Subgroup.card_dvd_of_le hKH.le
  have hd2 : 2 ≤ d := by nlinarith
  nlinarith

/-- Logarithmic subgroup complexity drops by at least one at a proper inclusion. -/
theorem subgroup_log_card_step {G : Type*} [Group G] [Finite G]
    {K H : Subgroup G} (hKH : K < H) :
    Nat.log 2 (Nat.card K) + 1 ≤ Nat.log 2 (Nat.card H) := by
  have h := Nat.log_mono_right (b := 2) (subgroup_card_twice_le hKH)
  rw [Nat.mul_comm 2 (Nat.card K), Nat.log_mul_base (by decide) Nat.card_pos.ne'] at h
  exact h

/-- There is a subgroup retaining all but `M * log₂ |G|` reservoir indices,
while every proper subgroup of it loses at least `M` further indices.
The argument works for any finite group, without commutativity. -/
theorem exists_pruned_subgroup {G ι : Type*} [Group G] [Finite G]
    (S : Finset ι) (g : ι → G) {M : ℝ} (hM : 0 ≤ M) :
    ∃ H : Subgroup G,
      (S.card : ℝ) - ((subgroupReservoir S g H).card : ℝ) ≤
        M * Nat.log 2 (Nat.card G) ∧
      ∀ K : Subgroup G, K < H →
        M ≤ ((subgroupReservoir S g H).card : ℝ) -
          ((subgroupReservoir S g K).card : ℝ) := by
  classical
  let := Fintype.ofFinite (Subgroup G)
  let potential : Subgroup G → ℝ := fun H =>
    ((subgroupReservoir S g H).card : ℝ) - M * Nat.log 2 (Nat.card H)
  obtain ⟨H, _, hmax⟩ := Finset.exists_max_image
    (Finset.univ : Finset (Subgroup G)) potential Finset.univ_nonempty
  have hmax' : ∀ K : Subgroup G, potential K ≤ potential H :=
    fun K => hmax K (Finset.mem_univ K)
  refine ⟨H, ?_, ?_⟩
  · have htop := hmax' ⊤
    simp only [potential, subgroupReservoir_top, Subgroup.card_top] at htop
    have hpenalty : 0 ≤ M * (Nat.log 2 (Nat.card H) : ℝ) :=
      mul_nonneg hM (Nat.cast_nonneg _)
    linarith
  · intro K hKH
    have hK := hmax' K
    have hlog : (Nat.log 2 (Nat.card K) : ℝ) + 1 ≤ Nat.log 2 (Nat.card H) := by
      exact_mod_cast subgroup_log_card_step hKH
    have hmul := mul_le_mul_of_nonneg_left hlog hM
    dsimp [potential] at hK
    nlinarith

/-- A proper subgroup of `H` remains proper when regarded in the ambient group. -/
theorem map_subtype_lt_of_ne_top {G : Type*} [Group G] (H : Subgroup G)
    (K : Subgroup H) (hK : K ≠ ⊤) : K.map H.subtype < H := by
  have h : K.map H.subtype < (⊤ : Subgroup H).map H.subtype :=
    Subgroup.map_subtype_lt_map_subtype.mpr (lt_top_iff_ne_top.mpr hK)
  simpa only [← MonoidHom.range_eq_map, Subgroup.range_subtype] using h

/-- Pruning expressed directly for every proper subgroup of the retained group. -/
theorem exists_pruned_subgroup_internal {G ι : Type*} [Group G] [Finite G]
    (S : Finset ι) (g : ι → G) {M : ℝ} (hM : 0 ≤ M) :
    ∃ H : Subgroup G,
      (S.card : ℝ) - ((subgroupReservoir S g H).card : ℝ) ≤
        M * Nat.log 2 (Nat.card G) ∧
      ∀ K : Subgroup H, K ≠ ⊤ →
        M ≤ ((subgroupReservoir S g H).card : ℝ) -
          ((subgroupReservoir S g (K.map H.subtype)).card : ℝ) := by
  obtain ⟨H, hloss, hstable⟩ := exists_pruned_subgroup S g hM
  refine ⟨H, hloss, ?_⟩
  intro K hK
  exact hstable _ (map_subtype_lt_of_ne_top H K hK)

/-- If the pruning budget is at most half the reservoir, at least half survives. -/
theorem exists_pruned_subgroup_half {G ι : Type*} [Group G] [Finite G]
    (S : Finset ι) (g : ι → G) {M : ℝ} (hM : 0 ≤ M)
    (hbudget : M * Nat.log 2 (Nat.card G) ≤ (S.card : ℝ) / 2) :
    ∃ H : Subgroup G,
      (S.card : ℝ) / 2 ≤ ((subgroupReservoir S g H).card : ℝ) ∧
      ∀ K : Subgroup H, K ≠ ⊤ →
        M ≤ ((subgroupReservoir S g H).card : ℝ) -
          ((subgroupReservoir S g (K.map H.subtype)).card : ℝ) := by
  obtain ⟨H, hloss, hstable⟩ := exists_pruned_subgroup_internal S g hM
  exact ⟨H, by linarith, hstable⟩

/-- In particular every nontrivial multiplicative character of the retained
subgroup has at least `M` indices outside its kernel. -/
theorem exists_character_pruned_subgroup {G ι : Type*} [Group G] [Finite G]
    (S : Finset ι) (g : ι → G) {M : ℝ} (hM : 0 ≤ M)
    (hbudget : M * Nat.log 2 (Nat.card G) ≤ (S.card : ℝ) / 2) :
    ∃ H : Subgroup G,
      (S.card : ℝ) / 2 ≤ ((subgroupReservoir S g H).card : ℝ) ∧
      ∀ χ : H →* ℂ, χ ≠ 1 →
        M ≤ ((subgroupReservoir S g H).card : ℝ) -
          ((subgroupReservoir S g (χ.ker.map H.subtype)).card : ℝ) := by
  obtain ⟨H, hhalf, hstable⟩ := exists_pruned_subgroup_half S g hM hbudget
  refine ⟨H, hhalf, ?_⟩
  intro χ hχ
  exact hstable χ.ker (fun h => hχ (MonoidHom.ker_eq_top_iff.mp h))
end

section

open scoped BigOperators

/-- Powers of a unit complex number move at most linearly far from one. -/
theorem norm_pow_sub_one_le {z : ℂ} (hz : ‖z‖ = 1) (j : ℕ) :
    ‖z ^ j - 1‖ ≤ (j : ℝ) * ‖z - 1‖ := by
  induction j with
  | zero => simp
  | succ j ih =>
    have he : z ^ (j + 1) - 1 = z * (z ^ j - 1) + (z - 1) := by ring
    rw [he]
    calc
      ‖z * (z ^ j - 1) + (z - 1)‖ ≤ ‖z * (z ^ j - 1)‖ + ‖z - 1‖ := norm_add_le _ _
      _ = ‖z ^ j - 1‖ + ‖z - 1‖ := by rw [norm_mul, hz, one_mul]
      _ ≤ (j : ℝ) * ‖z - 1‖ + ‖z - 1‖ := by linarith
      _ = (↑(j + 1) : ℝ) * ‖z - 1‖ := by push_cast; ring

/-- A nontrivial `m`th root of unity is at least `2/m` away from one. -/
theorem root_unity_norm_sub_one_lower {z : ℂ} {m : ℕ} (hm : 0 < m)
    (hpow : z ^ m = 1) (hz1 : z ≠ 1) :
    2 / (m : ℝ) ≤ ‖z - 1‖ := by
  have hnorm : ‖z‖ = 1 :=
    (isOfFinOrder_iff_pow_eq_one.mpr ⟨m, hm, hpow⟩).norm_eq_one
  have hgeom : (∑ j ∈ Finset.range m, z ^ j) = 0 := by
    rw [geom_sum_eq hz1, hpow, sub_self, zero_div]
  have hsum : (m : ℝ) ≤ (∑ j ∈ Finset.range m, (j : ℝ)) * ‖z - 1‖ := by
    calc
      (m : ℝ) = ‖∑ j ∈ Finset.range m, (z ^ j - 1)‖ := by
        rw [Finset.sum_sub_distrib, hgeom]
        simp
      _ ≤ ∑ j ∈ Finset.range m, ‖z ^ j - 1‖ := norm_sum_le _ _
      _ ≤ ∑ j ∈ Finset.range m, (j : ℝ) * ‖z - 1‖ := by
        exact Finset.sum_le_sum (fun j _ => norm_pow_sub_one_le hnorm j)
      _ = _ := (Finset.sum_mul _ _ _).symm
  have hm' : (0 : ℝ) < m := by exact_mod_cast hm
  have hsumtwice : (∑ j ∈ Finset.range m, (j : ℝ)) * 2 = (m : ℝ) * (m - 1 : ℝ) := by
    have h := congrArg (fun n : ℕ => (n : ℝ)) (Finset.sum_range_id_mul_two m)
    have hm1 : 1 ≤ m := hm
    simpa only [Nat.cast_mul, Nat.cast_ofNat, Nat.cast_sum, Nat.cast_sub hm1,
      Nat.cast_one] using h
  have htwice : (m : ℝ) * 2 ≤ (m : ℝ) * ((m - 1 : ℝ) * ‖z - 1‖) := by
    calc
      (m : ℝ) * 2 ≤ ((∑ j ∈ Finset.range m, (j : ℝ)) * ‖z - 1‖) * 2 :=
        mul_le_mul_of_nonneg_right hsum (by norm_num)
      _ = ((∑ j ∈ Finset.range m, (j : ℝ)) * 2) * ‖z - 1‖ := by ring
      _ = _ := by rw [hsumtwice]; ring
  have htwo : 2 ≤ (m - 1 : ℝ) * ‖z - 1‖ := (mul_le_mul_iff_right₀ hm').mp htwice
  apply (div_le_iff₀ hm').mpr
  nlinarith [norm_nonneg (z - 1)]

/-- A polynomial lower bound on the phase gap of a nontrivial root of unity. -/
theorem root_unity_re_gap {z : ℂ} {m : ℕ} (hm : 0 < m)
    (hpow : z ^ m = 1) (hz1 : z ≠ 1) :
    2 / (m : ℝ) ^ 2 ≤ 1 - z.re := by
  have hnorm : ‖z‖ = 1 :=
    (isOfFinOrder_iff_pow_eq_one.mpr ⟨m, hm, hpow⟩).norm_eq_one
  have hlower := root_unity_norm_sub_one_lower hm hpow hz1
  have hsquare := pow_le_pow_left₀ (by positivity : 0 ≤ 2 / (m : ℝ)) hlower 2
  have he : (2 / (m : ℝ)) ^ 2 = 2 * (2 / (m : ℝ) ^ 2) := by ring
  rw [he, Complex.norm_sub_one_sq_eq_of_norm_eq_one hnorm] at hsquare
  linarith

/-- An upper bound on the order gives a common phase-gap bound. -/
theorem root_unity_re_gap_of_order_le {z : ℂ} {m R : ℕ} (hm : 0 < m)
    (hmR : m ≤ R) (hpow : z ^ m = 1) (hz1 : z ≠ 1) :
    2 / (R : ℝ) ^ 2 ≤ 1 - z.re := by
  have hm' : (0 : ℝ) < m := by exact_mod_cast hm
  have hR' : (0 : ℝ) < R := by exact_mod_cast hm.trans_le hmR
  have hmR' : (m : ℝ) ≤ R := by exact_mod_cast hmR
  apply le_trans _ (root_unity_re_gap hm hpow hz1)
  apply (div_le_div_iff₀ (sq_pos_of_pos hR') (sq_pos_of_pos hm')).mpr
  nlinarith

/-- Root-of-unity values contribute a nonnegative phase gap. -/
theorem root_unity_re_gap_nonneg {z : ℂ} {m : ℕ} (hm : 0 < m)
    (hpow : z ^ m = 1) : 0 ≤ 1 - z.re := by
  have hnorm : ‖z‖ = 1 :=
    (isOfFinOrder_iff_pow_eq_one.mpr ⟨m, hm, hpow⟩).norm_eq_one
  have h := Complex.re_le_norm z
  linarith

/-- The count of separated values gives a total phase-energy lower bound. -/
theorem root_unity_phase_sum_le {ι : Type*} (S : Finset ι) (z : ι → ℂ)
    {m R : ℕ} (hm : 0 < m) (hmR : m ≤ R)
    (hpow : ∀ p ∈ S, (z p) ^ m = 1) :
    (2 / (R : ℝ) ^ 2) * ((S.filter fun p => z p ≠ 1).card : ℝ) ≤
      ∑ p ∈ S, (1 - (z p).re) := by
  classical
  calc
    _ = ∑ _p ∈ S.filter (fun p => z p ≠ 1), (2 / (R : ℝ) ^ 2) := by simp; ring
    _ ≤ ∑ p ∈ S.filter (fun p => z p ≠ 1), (1 - (z p).re) := by
      apply Finset.sum_le_sum
      intro p hp
      obtain ⟨hp, hz1⟩ := Finset.mem_filter.mp hp
      exact root_unity_re_gap_of_order_le hm hmR (hpow p hp) hz1
    _ ≤ ∑ p ∈ S, (1 - (z p).re) := by
      apply Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ S)
      intro p hp _
      exact root_unity_re_gap_nonneg hm (hpow p hp)

/-- If at least `M` values are nontrivial, the phase energy is at least `2M/R²`. -/
theorem root_unity_phase_sum_lower {ι : Type*} (S : Finset ι) (z : ι → ℂ)
    {m R : ℕ} (hm : 0 < m) (hmR : m ≤ R)
    (hpow : ∀ p ∈ S, (z p) ^ m = 1) {M : ℝ}
    (hcount : M ≤ ((S.filter fun p => z p ≠ 1).card : ℝ)) :
    2 * M / (R : ℝ) ^ 2 ≤ ∑ p ∈ S, (1 - (z p).re) := by
  calc
    _ = (2 / (R : ℝ) ^ 2) * M := by ring
    _ ≤ (2 / (R : ℝ) ^ 2) * ((S.filter fun p => z p ≠ 1).card : ℝ) :=
      mul_le_mul_of_nonneg_left hcount (by positivity)
    _ ≤ _ := root_unity_phase_sum_le S z hm hmR hpow
end

section

open scoped BigOperators

/-- The normalized squared geometric sum. -/
noncomputable def fejerPolynomial (R : ℕ) (z : ℂ) : ℝ :=
  ‖∑ j ∈ Finset.range R, z ^ j‖ ^ 2 / R

theorem fejerPolynomial_nonneg (R : ℕ) (z : ℂ) :
    0 ≤ fejerPolynomial R z := by
  exact div_nonneg (sq_nonneg _) (Nat.cast_nonneg _)

/-- If all powers in the geometric sum lie in the right half-plane with
real part at least one half, the Fejér polynomial is at least `R / 4`. -/
theorem fejerPolynomial_lower_of_re {R : ℕ} (hR : 0 < R) (z : ℂ)
    (hre : ∀ j ∈ Finset.range R, (1 / 2 : ℝ) ≤ (z ^ j).re) :
    (R : ℝ) / 4 ≤ fejerPolynomial R z := by
  have hR' : (0 : ℝ) < R := by exact_mod_cast hR
  have hsum : (R : ℝ) / 2 ≤ (∑ j ∈ Finset.range R, z ^ j).re := by
    calc
      (R : ℝ) / 2 = ∑ _j ∈ Finset.range R, (1 / 2 : ℝ) := by simp; ring
      _ ≤ ∑ j ∈ Finset.range R, (z ^ j).re := Finset.sum_le_sum hre
      _ = _ := by simp
  have hnorm : (R : ℝ) / 2 ≤ ‖∑ j ∈ Finset.range R, z ^ j‖ :=
    hsum.trans (Complex.re_le_norm _)
  unfold fejerPolynomial
  apply (le_div_iff₀ hR').mpr
  nlinarith [norm_nonneg (∑ j ∈ Finset.range R, z ^ j)]

/-- The elementary finite counting estimate behind Fejér concentration. -/
theorem card_filter_le_of_sum_le {ι : Type*} (S : Finset ι) (F : ι → ℝ)
    (hF : ∀ p ∈ S, 0 ≤ F p) {c B : ℝ} (hc : 0 < c)
    (hsum : ∑ p ∈ S, F p ≤ B) :
    ((S.filter fun p => c ≤ F p).card : ℝ) ≤ B / c := by
  classical
  apply (le_div_iff₀ hc).mpr
  calc
    ((S.filter fun p => c ≤ F p).card : ℝ) * c =
        ∑ _p ∈ S.filter (fun p => c ≤ F p), c := by simp
    _ ≤ ∑ p ∈ S.filter (fun p => c ≤ F p), F p := by
      apply Finset.sum_le_sum
      intro p hp
      exact (Finset.mem_filter.mp hp).2
    _ ≤ ∑ p ∈ S, F p := by
      exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ S)
        (fun p hp _ => hF p hp)
    _ ≤ B := hsum

/-- Total mass at most `2Q` permits at most `8Q/R` large Fejér values. -/
theorem fejer_large_values_card_le {ι : Type*} (S : Finset ι) (z : ι → ℂ)
    {R : ℕ} (hR : 0 < R) {Q : ℝ}
    (hsum : ∑ p ∈ S, fejerPolynomial R (z p) ≤ 2 * Q) :
    ((S.filter fun p => (R : ℝ) / 4 ≤ fejerPolynomial R (z p)).card : ℝ)
      ≤ 8 * Q / R := by
  classical
  have hR' : (0 : ℝ) < R := by exact_mod_cast hR
  have h := card_filter_le_of_sum_le S (fun p => fejerPolynomial R (z p))
    (fun p _ => fejerPolynomial_nonneg R (z p)) (by positivity : 0 < (R : ℝ) / 4) hsum
  convert h using 1
  field_simp
  ring

/-- Shifting a geometric sum exposes its first coefficient. -/
theorem geometric_sum_succ (R : ℕ) (z : ℂ) :
    (∑ j ∈ Finset.range (R + 1), z ^ j) =
      1 + z * ∑ j ∈ Finset.range R, z ^ j := by
  rw [Finset.sum_range_succ']
  simp only [pow_zero, Finset.mul_sum, pow_succ']
  ring

/-- The unnormalized Fejér polynomial satisfies this exact recurrence. -/
theorem geometric_norm_sq_succ (R : ℕ) (z : ℂ) (hz : ‖z‖ = 1) :
    ‖∑ j ∈ Finset.range (R + 1), z ^ j‖ ^ 2 =
      ‖∑ j ∈ Finset.range R, z ^ j‖ ^ 2 + 1 +
        2 * ∑ j ∈ Finset.range R, (z ^ (j + 1)).re := by
  rw [geometric_sum_succ, ← Complex.normSq_eq_norm_sq,
    Complex.normSq_add]
  simp only [map_one, one_mul, Complex.conj_re, Complex.normSq_eq_norm_sq,
    norm_mul, hz, one_mul]
  have hsum : (z * ∑ j ∈ Finset.range R, z ^ j).re =
      ∑ j ∈ Finset.range R, (z ^ (j + 1)).re := by
    simp only [Finset.mul_sum, ← pow_succ', Complex.re_sum]
  rw [hsum]
  ring

/-- Low-power moment bounds control the total unnormalized Fejér mass. -/
theorem sum_geometric_norm_sq_le {ι : Type*} (S : Finset ι) (z : ι → ℂ)
    (hz : ∀ p ∈ S, ‖z p‖ = 1) (A : ℝ) (R : ℕ)
    (hmoment : ∀ j : ℕ, 1 ≤ j → j < R →
      ∑ p ∈ S, ((z p) ^ j).re ≤ A) :
    ∑ p ∈ S, ‖∑ j ∈ Finset.range R, (z p) ^ j‖ ^ 2 ≤
      (R : ℝ) * S.card + (R : ℝ) * (R - 1 : ℝ) * A := by
  induction R with
  | zero => simp
  | succ R ih =>
    have hprev : ∀ j : ℕ, 1 ≤ j → j < R →
        ∑ p ∈ S, ((z p) ^ j).re ≤ A := by
      intro j hj hjR
      exact hmoment j hj (by omega)
    have hrec : (∑ p ∈ S, ‖∑ j ∈ Finset.range (R + 1), (z p) ^ j‖ ^ 2) =
        (∑ p ∈ S, ‖∑ j ∈ Finset.range R, (z p) ^ j‖ ^ 2) + S.card +
          2 * ∑ j ∈ Finset.range R, ∑ p ∈ S, ((z p) ^ (j + 1)).re := by
      calc
        _ = ∑ p ∈ S, (‖∑ j ∈ Finset.range R, (z p) ^ j‖ ^ 2 + 1 +
              2 * ∑ j ∈ Finset.range R, ((z p) ^ (j + 1)).re) := by
          apply Finset.sum_congr rfl
          intro p hp
          exact geometric_norm_sq_succ R (z p) (hz p hp)
        _ = _ := by
          simp only [Finset.sum_add_distrib, Finset.sum_const, nsmul_eq_mul,
            mul_one, ← Finset.mul_sum]
          rw [Finset.sum_comm]
    have hm : (∑ j ∈ Finset.range R, ∑ p ∈ S, ((z p) ^ (j + 1)).re) ≤ R * A := by
      calc
        _ ≤ ∑ _j ∈ Finset.range R, A := by
          apply Finset.sum_le_sum
          intro j hj
          exact hmoment (j + 1) (by omega) (by have := Finset.mem_range.mp hj; omega)
        _ = _ := by simp
    rw [hrec]
    have hp := ih hprev
    push_cast
    nlinarith

/-- The Fejér total mass follows directly from the real parts of all
nontrivial low-power moments. -/
theorem sum_fejerPolynomial_le {ι : Type*} (S : Finset ι) (z : ι → ℂ)
    (hz : ∀ p ∈ S, ‖z p‖ = 1) (A : ℝ) {R : ℕ} (hR : 0 < R)
    (hmoment : ∀ j : ℕ, 1 ≤ j → j < R →
      ∑ p ∈ S, ((z p) ^ j).re ≤ A) :
    ∑ p ∈ S, fejerPolynomial R (z p) ≤ S.card + (R - 1 : ℝ) * A := by
  have hR' : (0 : ℝ) < R := by exact_mod_cast hR
  simp only [fejerPolynomial, ← Finset.sum_div]
  apply (div_le_iff₀ hR').mpr
  have h := sum_geometric_norm_sq_le S z hz A R hmoment
  nlinarith

/-- A norm bound for each ambient power sum suffices for the Fejér estimate. -/
theorem sum_fejerPolynomial_le_of_norm {ι : Type*} (S : Finset ι) (z : ι → ℂ)
    (hz : ∀ p ∈ S, ‖z p‖ = 1) (A : ℝ) {R : ℕ} (hR : 0 < R)
    (hmoment : ∀ j : ℕ, 1 ≤ j → j < R →
      ‖∑ p ∈ S, (z p) ^ j‖ ≤ A) :
    ∑ p ∈ S, fejerPolynomial R (z p) ≤ S.card + (R - 1 : ℝ) * A := by
  apply sum_fejerPolynomial_le S z hz A hR
  intro j hj hjR
  calc
    (∑ p ∈ S, ((z p) ^ j).re) = (∑ p ∈ S, (z p) ^ j).re := by simp
    _ ≤ ‖∑ p ∈ S, (z p) ^ j‖ := Complex.re_le_norm _
    _ ≤ A := hmoment j hj hjR

/-- The usual short angular arc forces a large Fejér value. -/
theorem fejerPolynomial_lower_of_abs_angle {R : ℕ} (hR : 0 < R) {θ : ℝ}
    (hθ : |θ| ≤ 1 / (R : ℝ)) :
    (R : ℝ) / 4 ≤ fejerPolynomial R (Complex.exp (θ * Complex.I)) := by
  apply fejerPolynomial_lower_of_re hR
  intro j hj
  have hR' : (0 : ℝ) < R := by exact_mod_cast hR
  have hjR : (j : ℝ) ≤ R := by exact_mod_cast (Finset.mem_range.mp hj).le
  have habs : |(j : ℝ) * θ| ≤ 1 := by
    rw [abs_mul, abs_of_nonneg (Nat.cast_nonneg j)]
    calc
      (j : ℝ) * |θ| ≤ (R : ℝ) * (1 / (R : ℝ)) :=
        mul_le_mul hjR hθ (abs_nonneg _) (by positivity)
      _ = 1 := by field_simp
  have hsq : ((j : ℝ) * θ) ^ 2 ≤ 1 := by
    have := (sq_le_sq₀ (abs_nonneg ((j : ℝ) * θ)) (by norm_num : (0 : ℝ) ≤ 1)).mpr habs
    simpa only [sq_abs, one_pow] using this
  have hcos := Real.one_sub_sq_div_two_le_cos (x := (j : ℝ) * θ)
  rw [← Complex.exp_nat_mul]
  have he : (j : ℂ) * ((θ : ℂ) * Complex.I) = (((j : ℝ) * θ : ℝ) : ℂ) * Complex.I := by
    push_cast
    ring
  rw [he]
  simp only [Complex.exp_re, Complex.mul_re, Complex.ofReal_re, Complex.I_re,
    Complex.ofReal_im, Complex.I_im, mul_zero, sub_self, Real.exp_zero,
    Complex.mul_im, mul_one, add_zero, one_mul]
  nlinarith

/-- Ambient character-sum bounds limit the population of any short arc. -/
theorem short_arc_card_le_of_moments {ι : Type*} (S : Finset ι) (θ : ι → ℝ)
    (A : ℝ) {R : ℕ} (hR : 0 < R)
    (hsmall : (R - 1 : ℝ) * A ≤ S.card)
    (hmoment : ∀ j : ℕ, 1 ≤ j → j < R →
      ‖∑ p ∈ S, (Complex.exp (θ p * Complex.I)) ^ j‖ ≤ A) :
    ((S.filter fun p => |θ p| ≤ 1 / (R : ℝ)).card : ℝ) ≤ 8 * S.card / R := by
  classical
  have hsum := sum_fejerPolynomial_le_of_norm S
    (fun p => Complex.exp (θ p * Complex.I))
    (fun p _ => Complex.norm_exp_ofReal_mul_I (θ p)) A hR hmoment
  have hmass : (∑ p ∈ S, fejerPolynomial R (Complex.exp (θ p * Complex.I))) ≤
      2 * S.card := by linarith
  have hcard := fejer_large_values_card_le S
    (fun p => Complex.exp (θ p * Complex.I)) hR hmass
  apply le_trans _ hcard
  exact_mod_cast Finset.card_le_card (show
    (S.filter fun p => |θ p| ≤ 1 / (R : ℝ)) ⊆
      S.filter (fun p => (R : ℝ) / 4 ≤
        fejerPolynomial R (Complex.exp (θ p * Complex.I))) from by
    intro p hp
    obtain ⟨hp, hθ⟩ := Finset.mem_filter.mp hp
    exact Finset.mem_filter.mpr ⟨hp, fejerPolynomial_lower_of_abs_angle hR hθ⟩)

/-- Unit complex numbers in the principal short arc have large Fejér value. -/
theorem fejerPolynomial_lower_of_abs_arg {R : ℕ} (hR : 0 < R) {z : ℂ}
    (hz : ‖z‖ = 1) (harg : |z.arg| ≤ 1 / (R : ℝ)) :
    (R : ℝ) / 4 ≤ fejerPolynomial R z := by
  have he : Complex.exp (z.arg * Complex.I) = z := by
    simpa only [hz, Complex.ofReal_one, one_mul] using Complex.norm_mul_exp_arg_mul_I z
  rw [← he]
  exact fejerPolynomial_lower_of_abs_angle hR harg

/-- The principal short-arc bound for arbitrary unit complex values. -/
theorem short_arg_card_le_of_moments {ι : Type*} (S : Finset ι) (z : ι → ℂ)
    (hz : ∀ p ∈ S, ‖z p‖ = 1) (A : ℝ) {R : ℕ} (hR : 0 < R)
    (hsmall : (R - 1 : ℝ) * A ≤ S.card)
    (hmoment : ∀ j : ℕ, 1 ≤ j → j < R → ‖∑ p ∈ S, (z p) ^ j‖ ≤ A) :
    ((S.filter fun p => |(z p).arg| ≤ 1 / (R : ℝ)).card : ℝ) ≤ 8 * S.card / R := by
  classical
  have hsum := sum_fejerPolynomial_le_of_norm S z hz A hR hmoment
  have hmass : (∑ p ∈ S, fejerPolynomial R (z p)) ≤ 2 * S.card := by linarith
  apply le_trans _ (fejer_large_values_card_le S z hR hmass)
  exact_mod_cast Finset.card_le_card (show
    (S.filter fun p => |(z p).arg| ≤ 1 / (R : ℝ)) ⊆
      S.filter (fun p => (R : ℝ) / 4 ≤ fejerPolynomial R (z p)) from by
    intro p hp
    obtain ⟨hp, harg⟩ := Finset.mem_filter.mp hp
    exact Finset.mem_filter.mpr ⟨hp, fejerPolynomial_lower_of_abs_arg hR (hz p hp) harg⟩)
end

section

/-- Away from an arc of radius `1/R`, a unit complex number has definite energy. -/
theorem unit_energy_lower_of_abs_arg {R : ℕ} (hR : 0 < R) {z : ℂ}
    (hz : ‖z‖ = 1) (harg : 1 / (R : ℝ) ≤ |z.arg|) :
    2 / (Real.pi ^ 2 * (R : ℝ) ^ 2) ≤ 1 - z.re := by
  have hR' : (0 : ℝ) < R := by exact_mod_cast hR
  have hcos : Real.cos z.arg = z.re := by
    simpa only [hz, one_mul] using Complex.norm_mul_cos_arg z
  have hc := Real.cos_le_one_sub_mul_cos_sq (Complex.abs_arg_le_pi z)
  rw [hcos] at hc
  have hs : (1 / (R : ℝ)) ^ 2 ≤ z.arg ^ 2 := by
    have h := (sq_le_sq₀ (by positivity : 0 ≤ 1 / (R : ℝ)) (abs_nonneg z.arg)).mpr harg
    simpa only [sq_abs] using h
  calc
    2 / (Real.pi ^ 2 * (R : ℝ) ^ 2) =
        (2 / Real.pi ^ 2) * (1 / (R : ℝ)) ^ 2 := by field_simp
    _ ≤ (2 / Real.pi ^ 2) * z.arg ^ 2 :=
      mul_le_mul_of_nonneg_left hs (by positivity)
    _ ≤ 1 - z.re := by linarith

/-- A large retained set and a small ambient short arc force positive character energy. -/
theorem energy_lower_of_short_arc_card {ι : Type*} (S T : Finset ι)
    (hTS : T ⊆ S) (z : ι → ℂ) (hz : ∀ i ∈ T, ‖z i‖ = 1)
    {R : ℕ} (hR : 0 < R) {N : ℝ} (hT : N / 2 ≤ T.card)
    (harc : ((S.filter fun i => |(z i).arg| ≤ 1 / (R : ℝ)).card : ℝ) ≤ N / 8) :
    3 * N / (4 * Real.pi ^ 2 * (R : ℝ) ^ 2) ≤
      ∑ i ∈ T, (1 - (z i).re) := by
  classical
  let arc : ι → Prop := fun i => |(z i).arg| ≤ 1 / (R : ℝ)
  let U := T.filter fun i => ¬ arc i
  have hR' : (0 : ℝ) < R := by exact_mod_cast hR
  have hsmall : ((T.filter arc).card : ℝ) ≤ N / 8 := by
    apply le_trans _ harc
    exact_mod_cast Finset.card_le_card (Finset.filter_subset_filter _ hTS)
  have hsplit : ((T.filter arc).card : ℝ) + (U.card : ℝ) = T.card := by
    exact_mod_cast Finset.card_filter_add_card_filter_not (s := T) arc
  have hU : 3 * N / 8 ≤ (U.card : ℝ) := by linarith
  have hterm : ∀ i ∈ U, 2 / (Real.pi ^ 2 * (R : ℝ) ^ 2) ≤ 1 - (z i).re := by
    intro i hi
    obtain ⟨hiT, hiarc⟩ := Finset.mem_filter.mp hi
    exact unit_energy_lower_of_abs_arg hR (hz i hiT) (le_of_lt (not_le.mp hiarc))
  calc
    3 * N / (4 * Real.pi ^ 2 * (R : ℝ) ^ 2) =
        (3 * N / 8) * (2 / (Real.pi ^ 2 * (R : ℝ) ^ 2)) := by ring
    _ ≤ (U.card : ℝ) * (2 / (Real.pi ^ 2 * (R : ℝ) ^ 2)) :=
      mul_le_mul_of_nonneg_right hU (by positivity)
    _ = ∑ _i ∈ U, 2 / (Real.pi ^ 2 * (R : ℝ) ^ 2) := by simp
    _ ≤ ∑ i ∈ U, (1 - (z i).re) := Finset.sum_le_sum hterm
    _ ≤ ∑ i ∈ T, (1 - (z i).re) := by
      apply Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ T)
      intro i hi _
      have h := Complex.re_le_norm (z i)
      rw [hz i hi] at h
      linarith

/-- Ambient low-power character moments force high energy on any retained half-reservoir. -/
theorem energy_lower_of_moments {ι : Type*} (S T : Finset ι) (hTS : T ⊆ S)
    (z : ι → ℂ) (hz : ∀ i ∈ S, ‖z i‖ = 1) (A : ℝ)
    {R : ℕ} (hR : 0 < R) {N : ℝ} (hT : N / 2 ≤ T.card)
    (hRlarge : 64 * (S.card : ℝ) ≤ N * R)
    (hsmall : (R - 1 : ℝ) * A ≤ S.card)
    (hmoment : ∀ j : ℕ, 1 ≤ j → j < R → ‖∑ i ∈ S, (z i) ^ j‖ ≤ A) :
    3 * N / (4 * Real.pi ^ 2 * (R : ℝ) ^ 2) ≤
      ∑ i ∈ T, (1 - (z i).re) := by
  apply energy_lower_of_short_arc_card S T hTS z (fun i hi => hz i (hTS hi)) hR hT
  have hcard := short_arg_card_le_of_moments S z hz A hR hsmall hmoment
  apply hcard.trans
  have hR' : (0 : ℝ) < R := by exact_mod_cast hR
  apply (div_le_iff₀ hR').mpr
  nlinarith
end

section

open scoped BigOperators

/-- A complex character on a finite group takes values on the unit circle. -/
theorem finite_character_norm {G : Type*} [Group G] [Finite G]
    (ξ : G →* ℂ) (g : G) : ‖ξ g‖ = 1 :=
  (ξ.isOfFinOrder (isOfFinOrder_of_finite g)).norm_eq_one

/-- Low-order extensions use the pruned outlier count. Extensions without low-order
relations use the ambient Fejér estimate. Together they give one bound valid for
every nontrivial character of the retained subgroup. -/
theorem character_energy_lower_of_pruned_ambient
    {G ι : Type*} [CommGroup G] [Finite G]
    (H : Subgroup G) (S T : Finset ι) (hTS : T ⊆ S)
    (g : ι → G) (h : ι → H)
    (hlabel : ∀ i ∈ T, (h i : G) = g i)
    {N M A : ℝ} {R : ℕ} (hR : 0 < R)
    (hT : N / 2 ≤ (T.card : ℝ))
    (hRlarge : 64 * (S.card : ℝ) ≤ N * R)
    (hsmall : (R - 1 : ℝ) * A ≤ S.card)
    (hpruned : ∀ χ : H →* ℂ, χ ≠ 1 →
      M ≤ ((T.filter fun i => χ (h i) ≠ 1).card : ℝ))
    (hamb : ∀ ξ : G →* ℂ, ξ ≠ 1 → ‖∑ i ∈ S, ξ (g i)‖ ≤ A)
    (χ : H →* ℂ) (hχ : χ ≠ 1) :
    min (2 * M / (R : ℝ) ^ 2)
        (3 * N / (4 * Real.pi ^ 2 * (R : ℝ) ^ 2)) ≤
      ∑ i ∈ T, (1 - (χ (h i)).re) := by
  classical
  obtain ⟨ξ, hext⟩ := extend_complex_character H χ
  have hagree : ∀ i ∈ T, ξ (g i) = χ (h i) := by
    intro i hi
    rw [← hlabel i hi]
    exact hext (h i)
  by_cases hlow : ∃ m : ℕ, 0 < m ∧ m < R ∧ ξ ^ m = 1
  · obtain ⟨m, hm, hmR, hpow⟩ := hlow
    have hp : ∀ i ∈ T, (χ (h i)) ^ m = 1 := by
      intro i hi
      rw [← hagree i hi]
      have hv := DFunLike.congr_fun hpow (g i)
      simpa only [MonoidHom.pow_apply, MonoidHom.one_apply] using hv
    exact (min_le_left _ _).trans
      (root_unity_phase_sum_lower T (fun i => χ (h i)) hm hmR.le hp (hpruned χ hχ))
  · have hmom : ∀ j : ℕ, 1 ≤ j → j < R →
        ‖∑ i ∈ S, (ξ (g i)) ^ j‖ ≤ A := by
      intro j hj hjR
      have hne : ξ ^ j ≠ 1 := by
        intro heq
        exact hlow ⟨j, by omega, hjR, heq⟩
      simpa only [MonoidHom.pow_apply] using hamb (ξ ^ j) hne
    have henergy := energy_lower_of_moments S T hTS (fun i => ξ (g i))
      (fun i _ => finite_character_norm ξ (g i)) A hR hT hRlarge hsmall hmom
    have hequal : (∑ i ∈ T, (1 - (ξ (g i)).re)) =
        ∑ i ∈ T, (1 - (χ (h i)).re) := by
      apply Finset.sum_congr rfl
      intro i hi
      rw [hagree i hi]
    rw [hequal] at henergy
    exact (min_le_right _ _).trans henergy
end

section

open scoped BigOperators

/-- Extend the subgroup-valued reservoir labels by the identity off the subgroup. -/
noncomputable def subgroupLabel {G ι : Type*} [Group G]
    (H : Subgroup G) (g : ι → G) (i : ι) : H := by
  classical
  exact if hi : g i ∈ H then ⟨g i, hi⟩ else 1

theorem subgroupLabel_coe_of_mem {G ι : Type*} [Group G]
    (H : Subgroup G) (g : ι → G) {i : ι} (hi : g i ∈ H) :
    (subgroupLabel H g i : G) = g i := by
  classical
  simp only [subgroupLabel, hi, dite_true]

theorem subgroupReservoir_subset {G ι : Type*} [Group G]
    (P : Finset ι) (g : ι → G) (H : Subgroup G) : subgroupReservoir P g H ⊆ P := by
  classical
  exact Finset.filter_subset _ P

/-- The ambient reservoir of the mapped kernel is precisely the retained
reservoir on which the subgroup character is trivial. -/
theorem subgroupReservoir_kernel_eq {G ι : Type*} [Group G]
    (P : Finset ι) (g : ι → G) (H : Subgroup G) (χ : H →* ℂ) :
    subgroupReservoir P g (χ.ker.map H.subtype) =
      (subgroupReservoir P g H).filter (fun i => χ (subgroupLabel H g i) = 1) := by
  classical
  ext i
  simp only [subgroupReservoir, Finset.mem_filter]
  constructor
  · rintro ⟨hiP, hiK⟩
    have hiH : g i ∈ H := (Subgroup.map_subtype_le χ.ker) hiK
    obtain ⟨x, hx, hxg⟩ := Subgroup.mem_map.mp hiK
    have hlabel : subgroupLabel H g i = x := by
      apply Subtype.ext
      rw [subgroupLabel_coe_of_mem H g hiH]
      exact hxg.symm
    refine ⟨⟨hiP, hiH⟩, ?_⟩
    rw [hlabel]
    exact hx
  · rintro ⟨⟨hiP, hiH⟩, hχ⟩
    refine ⟨hiP, Subgroup.mem_map.mpr ?_⟩
    exact ⟨subgroupLabel H g i, hχ, subgroupLabel_coe_of_mem H g hiH⟩

/-- Pruning a reservoir inside an ambient set with character cancellation
produces a retained half-reservoir with a uniform positive spectral bound. -/
theorem exists_pruned_energy_reservoir
    {G ι : Type*} [CommGroup G] [Finite G]
    (S P : Finset ι) (hPS : P ⊆ S) (g : ι → G)
    {M A : ℝ} (hM : 0 ≤ M)
    (hbudget : M * Nat.log 2 (Nat.card G) ≤ (P.card : ℝ) / 2)
    {R : ℕ} (hR : 0 < R)
    (hRlarge : 64 * (S.card : ℝ) ≤ (P.card : ℝ) * R)
    (hsmall : (R - 1 : ℝ) * A ≤ S.card)
    (hamb : ∀ ξ : G →* ℂ, ξ ≠ 1 → ‖∑ i ∈ S, ξ (g i)‖ ≤ A) :
    ∃ (H : Subgroup G) (T : Finset ι) (h : ι → H),
      T = subgroupReservoir P g H ∧ T ⊆ P ∧
      (P.card : ℝ) / 2 ≤ (T.card : ℝ) ∧
      (∀ i ∈ T, (h i : G) = g i) ∧
      ∀ χ : H →* ℂ, χ ≠ 1 →
        min (2 * M / (R : ℝ) ^ 2)
          (3 * (P.card : ℝ) / (4 * Real.pi ^ 2 * (R : ℝ) ^ 2)) ≤
          ∑ i ∈ T, (1 - (χ (h i)).re) := by
  classical
  obtain ⟨H, hhalf, hstable⟩ := exists_character_pruned_subgroup P g hM hbudget
  let T := subgroupReservoir P g H
  let h := subgroupLabel H g
  have hTP : T ⊆ P := subgroupReservoir_subset P g H
  have hagree : ∀ i ∈ T, (h i : G) = g i := by
    intro i hi
    exact subgroupLabel_coe_of_mem H g (Finset.mem_filter.mp hi).2
  have hpruned : ∀ χ : H →* ℂ, χ ≠ 1 →
      M ≤ ((T.filter fun i => χ (h i) ≠ 1).card : ℝ) := by
    intro χ hχ
    have hstab := hstable χ hχ
    have hpart : ((T.filter fun i => χ (h i) = 1).card : ℝ) +
        ((T.filter fun i => χ (h i) ≠ 1).card : ℝ) = T.card := by
      exact_mod_cast Finset.card_filter_add_card_filter_not (s := T) (fun i => χ (h i) = 1)
    rw [subgroupReservoir_kernel_eq P g H χ] at hstab
    change M ≤ (T.card : ℝ) - ((T.filter fun i => χ (h i) = 1).card : ℝ) at hstab
    linarith
  refine ⟨H, T, h, rfl, hTP, hhalf, hagree, ?_⟩
  intro χ hχ
  exact character_energy_lower_of_pruned_ambient H S T (hTP.trans hPS) g h hagree
    hR hhalf hRlarge hsmall hpruned hamb χ hχ
end

section

/-- A family carrying mass at least `m`, with every point of mass at most `p`,
has cardinality at least `m / p`. No sign condition on the individual weights is needed. -/
theorem card_ge_mass_div_bound {α : Type*} (A : Finset α) (w : α → ℝ)
    {m p : ℝ} (hp : 0 < p) (hmass : m ≤ ∑ a ∈ A, w a)
    (hpoint : ∀ a ∈ A, w a ≤ p) : m / p ≤ (A.card : ℝ) := by
  apply (div_le_iff₀ hp).2
  have hsum : (∑ a ∈ A, w a) ≤ (A.card : ℝ) * p := by
    calc
      (∑ a ∈ A, w a) ≤ ∑ _a ∈ A, p := Finset.sum_le_sum hpoint
      _ = (A.card : ℝ) * p := by simp
  exact hmass.trans hsum

/-- The mass assigned to `s` when each element of `S` is selected with probability `ρ`. -/
def bernoulliSubsetWeight {α : Type*} (ρ : ℝ) (S s : Finset α) : ℝ :=
  ρ ^ s.card * (1 - ρ) ^ (S.card - s.card)

theorem bernoulliSubsetWeight_nonneg {α : Type*} {ρ : ℝ}
    (hρ₀ : 0 ≤ ρ) (hρ₁ : ρ ≤ 1) (S s : Finset α) :
    0 ≤ bernoulliSubsetWeight ρ S s := by
  unfold bernoulliSubsetWeight
  positivity

/-- A subset with at least `k` elements has mass at most `ρ ^ k`. -/
theorem bernoulliSubsetWeight_le_pow {α : Type*} {ρ : ℝ}
    (hρ₀ : 0 ≤ ρ) (hρ₁ : ρ ≤ 1) (S s : Finset α) {k : ℕ}
    (hk : k ≤ s.card) : bernoulliSubsetWeight ρ S s ≤ ρ ^ k := by
  unfold bernoulliSubsetWeight
  calc
    ρ ^ s.card * (1 - ρ) ^ (S.card - s.card) ≤ ρ ^ s.card * 1 :=
      mul_le_mul_of_nonneg_left (pow_le_one₀ (by linarith) (by linarith))
        (pow_nonneg hρ₀ _)
    _ = ρ ^ s.card := mul_one _
    _ ≤ ρ ^ k := pow_le_pow_of_le_one hρ₀ hρ₁ hk

/-- The Bernoulli masses of all subsets sum to one. -/
theorem sum_bernoulliSubsetWeight {α : Type*} (ρ : ℝ) (S : Finset α) :
    ∑ s ∈ S.powerset, bernoulliSubsetWeight ρ S s = 1 := by
  unfold bernoulliSubsetWeight
  rw [Finset.sum_pow_mul_eq_add_pow]
  simp

/-- The counting step used after obtaining a positive mass of sufficiently large subsets. -/
theorem card_ge_bernoulli_mass_div_pow {α : Type*} {ρ : ℝ}
    (hρ₀ : 0 < ρ) (hρ₁ : ρ ≤ 1) (S : Finset α) (A : Finset (Finset α))
    {m : ℝ} {k : ℕ} (hmass : m ≤ ∑ s ∈ A, bernoulliSubsetWeight ρ S s)
    (hsize : ∀ s ∈ A, k ≤ s.card) :
    m / ρ ^ k ≤ (A.card : ℝ) := by
  exact card_ge_mass_div_bound A (bernoulliSubsetWeight ρ S) (pow_pos hρ₀ k) hmass
    (fun s hs => bernoulliSubsetWeight_le_pow hρ₀.le hρ₁ S s (hsize s hs))

/-- Finite expansion of the product generating function. It applies, in particular,
to complex character values by taking `r = ρ` and `t = 1 - ρ`. -/
theorem subset_weighted_product_expansion {α R : Type*} [CommSemiring R]
    (S : Finset α) (r t : R) (z : α → R) :
    (∑ s ∈ S.powerset,
      (r ^ s.card * t ^ (S.card - s.card)) * ∏ i ∈ s, z i) =
      ∏ i ∈ S, (t + r * z i) := by
  classical
  symm
  simp_rw [add_comm t]
  rw [Finset.prod_add]
  apply Finset.sum_congr rfl
  intro s hs
  rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.prod_const,
    Finset.card_sdiff_of_subset (Finset.mem_powerset.1 hs)]
  ring


/-- The complex generating function for the Bernoulli subset distribution. -/
theorem bernoulli_complex_product_expansion {α : Type*}
    (S : Finset α) (ρ : ℝ) (z : α → ℂ) :
    (∑ s ∈ S.powerset,
      (bernoulliSubsetWeight ρ S s : ℂ) * ∏ i ∈ s, z i) =
      ∏ i ∈ S, (1 - (ρ : ℂ) + (ρ : ℂ) * z i) := by
  simpa [bernoulliSubsetWeight] using
    subset_weighted_product_expansion S (ρ : ℂ) (1 - (ρ : ℂ)) z

/-- The character expectation factors into independent Bernoulli factors. -/
theorem bernoulli_character_expansion {α G : Type*} [CommMonoid G]
    (S : Finset α) (ρ : ℝ) (g : α → G) (χ : G →* ℂ) :
    (∑ s ∈ S.powerset,
      (bernoulliSubsetWeight ρ S s : ℂ) * χ (∏ i ∈ s, g i)) =
      ∏ i ∈ S, (1 - (ρ : ℂ) + (ρ : ℂ) * χ (g i)) := by
  simpa only [map_prod] using
    bernoulli_complex_product_expansion S ρ (fun i => χ (g i))
end

section

/-- Exact squared modulus of one Bernoulli character factor. -/
theorem bernoulliFactor_norm_sq (ρ : ℝ) {z : ℂ} (hz : ‖z‖ = 1) :
    ‖((1 - ρ : ℝ) : ℂ) + (ρ : ℂ) * z‖ ^ 2 =
      1 - 2 * ρ * (1 - ρ) * (1 - z.re) := by
  have hzsq : z.re * z.re + z.im * z.im = 1 := by
    rw [← Complex.normSq_apply, Complex.normSq_eq_norm_sq, hz, one_pow]
  simp only [Complex.sq_norm, Complex.normSq_apply, Complex.add_re, Complex.add_im,
    Complex.mul_re, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
    zero_mul, zero_add, add_zero, sub_zero]
  linear_combination ρ ^ 2 * hzsq

/-- Exponential contraction for one character value on the unit circle.
The estimate in fact holds for every real parameter, and hence for all Bernoulli parameters. -/
theorem bernoulliFactor_norm_le_exp (ρ : ℝ) {z : ℂ} (hz : ‖z‖ = 1) :
    ‖((1 - ρ : ℝ) : ℂ) + (ρ : ℂ) * z‖ ≤
      Real.exp (-ρ * (1 - ρ) * (1 - z.re)) := by
  have hsq := bernoulliFactor_norm_sq ρ hz
  have hexp := Real.add_one_le_exp (-2 * ρ * (1 - ρ) * (1 - z.re))
  have hexpsq : Real.exp (-ρ * (1 - ρ) * (1 - z.re)) ^ 2 =
      Real.exp (-2 * ρ * (1 - ρ) * (1 - z.re)) := by
    rw [pow_two, ← Real.exp_add]
    congr 1
    ring
  have hpos := Real.exp_pos (-ρ * (1 - ρ) * (1 - z.re))
  nlinarith [norm_nonneg (((1 - ρ : ℝ) : ℂ) + (ρ : ℂ) * z)]

/-- Independent Bernoulli character factors have an exponential bound in their total energy. -/
theorem bernoulliProduct_norm_le_exp {ι : Type*} (s : Finset ι) (ρ : ℝ)
    (z : ι → ℂ) (hz : ∀ i ∈ s, ‖z i‖ = 1) :
    ‖∏ i ∈ s, (((1 - ρ : ℝ) : ℂ) + (ρ : ℂ) * z i)‖ ≤
      Real.exp (-ρ * (1 - ρ) * ∑ i ∈ s, (1 - (z i).re)) := by
  rw [norm_prod]
  calc
    ∏ i ∈ s, ‖((1 - ρ : ℝ) : ℂ) + (ρ : ℂ) * z i‖ ≤
        ∏ i ∈ s, Real.exp (-ρ * (1 - ρ) * (1 - (z i).re)) := by
      apply Finset.prod_le_prod₀
      · intro i hi
        exact norm_nonneg _
      · intro i hi
        exact bernoulliFactor_norm_le_exp ρ (hz i hi)
    _ = Real.exp (-ρ * (1 - ρ) * ∑ i ∈ s, (1 - (z i).re)) := by
      rw [← Real.exp_sum, Finset.mul_sum]

/-- The Bernoulli-weighted subset-product transform satisfies the energy bound. -/
theorem bernoulliSubsetSum_norm_le_exp {ι : Type*} (s : Finset ι) (ρ : ℝ)
    (z : ι → ℂ) (hz : ∀ i ∈ s, ‖z i‖ = 1) :
    ‖∑ t ∈ s.powerset,
        (bernoulliSubsetWeight ρ s t : ℂ) * ∏ i ∈ t, z i‖ ≤
      Real.exp (-ρ * (1 - ρ) * ∑ i ∈ s, (1 - (z i).re)) := by
  rw [bernoulli_complex_product_expansion]
  simpa only [Complex.ofReal_sub, Complex.ofReal_one] using
    bernoulliProduct_norm_le_exp s ρ z hz

/-- Applying a multiplicative character to each subset product gives the same contraction. -/
theorem bernoulliCharacterSum_norm_le_exp {ι G : Type*} [CommMonoid G]
    (s : Finset ι) (ρ : ℝ) (g : ι → G) (χ : G →* ℂ)
    (hχ : ∀ i ∈ s, ‖χ (g i)‖ = 1) :
    ‖∑ t ∈ s.powerset,
        (bernoulliSubsetWeight ρ s t : ℂ) * χ (∏ i ∈ t, g i)‖ ≤
      Real.exp (-ρ * (1 - ρ) * ∑ i ∈ s, (1 - (χ (g i)).re)) := by
  simpa only [map_prod] using bernoulliSubsetSum_norm_le_exp s ρ (fun i => χ (g i)) hχ

/-- Finite additive characters have unit modulus, so their Bernoulli coefficients contract. -/
theorem bernoulliAddCharSum_norm_le_exp {ι G : Type*}
    [AddCommGroup G] [Finite G] (s : Finset ι) (ρ : ℝ) (g : ι → G)
    (χ : AddChar G ℂ) :
    ‖∑ t ∈ s.powerset,
        (bernoulliSubsetWeight ρ s t : ℂ) * χ (∑ i ∈ t, g i)‖ ≤
      Real.exp (-ρ * (1 - ρ) * ∑ i ∈ s, (1 - (χ (g i)).re)) := by
  have h := bernoulliCharacterSum_norm_le_exp s ρ (fun i => Multiplicative.ofAdd (g i))
    χ.toMonoidHom (fun i _ => χ.norm_apply (g i))
  simpa only [← ofAdd_sum, AddChar.toMonoidHom_apply, toAdd_ofAdd] using h
end

section
open scoped BigOperators
theorem character_sum_real {G : Type*} [AddCommGroup G] [Fintype G] [DecidableEq G]
    (g : G) :
    (∑ χ : AddChar G ℂ, (χ g).re) =
      if g = 0 then (Fintype.card G : ℝ) else 0 := by
  classical
  have h := congrArg Complex.re (AddChar.sum_apply_eq_ite g)
  by_cases hg : g = 0
  · simp [hg]
  · simpa [hg] using h

theorem weighted_character_sum_real {G ι : Type*}
    [AddCommGroup G] [Fintype G] [DecidableEq G] (s : Finset ι) (w : ι → ℝ) (f : ι → G) :
    (∑ χ : AddChar G ℂ, (∑ a ∈ s, (w a : ℂ) * χ (f a)).re) =
      (Fintype.card G : ℝ) * ∑ a ∈ s, if f a = 0 then w a else 0 := by
  classical
  simp only [Complex.re_sum, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
    zero_mul, sub_zero]
  rw [Finset.sum_comm]
  simp_rw [← Finset.mul_sum, character_sum_real]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro a ha
  split_ifs <;> ring

/-- Small nonprincipal Fourier coefficients force mass near the uniform mass
at the identity. The weights need not be nonnegative for this implication. -/
theorem identity_mass_lower_bound {G ι : Type*}
    [AddCommGroup G] [Fintype G] [DecidableEq G] (s : Finset ι) (w : ι → ℝ) (f : ι → G)
    (hsum : ∑ a ∈ s, w a = 1) {b : ℝ} (hb : 0 ≤ b)
    (hfourier : ∀ χ : AddChar G ℂ, χ ≠ 0 →
      ‖∑ a ∈ s, (w a : ℂ) * χ (f a)‖ ≤ b) :
    1 / (Fintype.card G : ℝ) - b ≤
      ∑ a ∈ s, if f a = 0 then w a else 0 := by
  classical
  let F : AddChar G ℂ → ℂ := fun χ => ∑ a ∈ s, (w a : ℂ) * χ (f a)
  have hF0 : (F 0).re = 1 := by simp [F, hsum]
  have hterm (χ : AddChar G ℂ) (hχ : χ ∈ (Finset.univ.erase 0)) :
      -b ≤ (F χ).re := by
    have hχ0 : χ ≠ 0 := (Finset.mem_erase.mp hχ).1
    have hr := (abs_le.mp (Complex.abs_re_le_norm (F χ))).1
    have hn := hfourier χ hχ0
    dsimp [F] at hr ⊢
    linarith
  have hsumlower := Finset.sum_le_sum hterm
  have hcard : (Finset.univ.erase (0 : AddChar G ℂ)).card = Fintype.card G - 1 := by
    simp [AddChar.card_eq]
  have hsplit : (∑ χ : AddChar G ℂ, (F χ).re) =
      1 + ∑ χ ∈ (Finset.univ.erase 0), (F χ).re := by
    rw [← Finset.sum_erase_add _ _ (Finset.mem_univ (0 : AddChar G ℂ)), hF0]
    ring
  have htotal := weighted_character_sum_real s w f
  change (∑ χ : AddChar G ℂ, (F χ).re) = _ at htotal
  have hc : 0 < (Fintype.card G : ℝ) := by exact_mod_cast Fintype.card_pos
  have hcast : ((Fintype.card G - 1 : ℕ) : ℝ) = Fintype.card G - 1 := by
    rw [Nat.cast_sub (by have := Fintype.card_pos (α := G); omega)]
    norm_num
  simp only [Finset.sum_const, nsmul_eq_mul, hcard, hcast] at hsumlower
  have hmain : 1 - (Fintype.card G : ℝ) * b ≤
      (Fintype.card G : ℝ) * (∑ a ∈ s, if f a = 0 then w a else 0) := by
    linarith
  apply (le_of_mul_le_mul_left (a := (Fintype.card G : ℝ)) ?_ hc)
  calc
    (Fintype.card G : ℝ) * (1 / (Fintype.card G : ℝ) - b) =
        1 - (Fintype.card G : ℝ) * b := by field_simp
    _ ≤ _ := hmain
end

section

/-- Uniform character energy forces the Bernoulli subset sum close to uniform
at the identity of a finite abelian group. -/
theorem bernoulli_identity_mass_lower_bound {ι G : Type*}
    [AddCommGroup G] [Fintype G] [DecidableEq G]
    (s : Finset ι) (g : ι → G) {ρ E : ℝ} (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1)
    (henergy : ∀ χ : AddChar G ℂ, χ ≠ 0 →
      E ≤ ∑ i ∈ s, (1 - (χ (g i)).re)) :
    1 / (Fintype.card G : ℝ) - Real.exp (-ρ * (1 - ρ) * E) ≤
      ∑ t ∈ s.powerset,
        if (∑ i ∈ t, g i) = 0 then bernoulliSubsetWeight ρ s t else 0 := by
  apply identity_mass_lower_bound s.powerset (bernoulliSubsetWeight ρ s)
    (fun t => ∑ i ∈ t, g i) (sum_bernoulliSubsetWeight ρ s) (Real.exp_pos _).le
  intro χ hχ
  apply (bernoulliAddCharSum_norm_le_exp s ρ g χ).trans
  apply Real.exp_le_exp.mpr
  exact mul_le_mul_of_nonpos_left (henergy χ hχ)
    (mul_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr hρ0) (sub_nonneg.mpr hρ1))

/-- Once the Fourier error is below half the uniform mass, at least half
the uniform mass lies on subsets whose sum is the identity. -/
theorem bernoulli_identity_mass_ge_half {ι G : Type*}
    [AddCommGroup G] [Fintype G] [DecidableEq G]
    (s : Finset ι) (g : ι → G) {ρ E : ℝ} (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1)
    (henergy : ∀ χ : AddChar G ℂ, χ ≠ 0 →
      E ≤ ∑ i ∈ s, (1 - (χ (g i)).re))
    (herror : Real.exp (-ρ * (1 - ρ) * E) ≤ 1 / (2 * Fintype.card G)) :
    1 / (2 * Fintype.card G : ℝ) ≤
      ∑ t ∈ s.powerset,
        if (∑ i ∈ t, g i) = 0 then bernoulliSubsetWeight ρ s t else 0 := by
  have h := bernoulli_identity_mass_lower_bound s g hρ0 hρ1 henergy
  have hc : (Fintype.card G : ℝ) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hid : 1 / (Fintype.card G : ℝ) = 2 * (1 / (2 * Fintype.card G : ℝ)) := by
    field_simp
  rw [hid] at h
  linarith
end

section

/-- Exponential Markov inequality for a finite weighted space. -/
theorem finite_exponential_markov {α : Type*}
    (Ω A : Finset α) (hA : A ⊆ Ω) (w f : α → ℝ)
    (hw : ∀ a ∈ Ω, 0 ≤ w a) {b : ℝ} (hf : ∀ a ∈ A, b ≤ f a) :
    (∑ a ∈ A, w a) ≤ Real.exp (-b) * ∑ a ∈ Ω, w a * Real.exp (f a) := by
  calc
    (∑ a ∈ A, w a) ≤ ∑ a ∈ A, Real.exp (-b) * (w a * Real.exp (f a)) := by
      apply Finset.sum_le_sum
      intro a ha
      calc
        w a = w a * Real.exp 0 := by simp
        _ ≤ w a * Real.exp (f a - b) :=
          mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr (by linarith [hf a ha]))
            (hw a (hA ha))
        _ = Real.exp (-b) * (w a * Real.exp (f a)) := by
          rw [sub_eq_add_neg, Real.exp_add]
          ring
    _ = Real.exp (-b) * ∑ a ∈ A, w a * Real.exp (f a) := by
      rw [Finset.mul_sum]
    _ ≤ Real.exp (-b) * ∑ a ∈ Ω, w a * Real.exp (f a) := by
      apply mul_le_mul_of_nonneg_left _ (Real.exp_pos _).le
      apply Finset.sum_le_sum_of_subset_of_nonneg hA
      intro a ha _
      exact mul_nonneg (hw a ha) (Real.exp_pos _).le

/-- Exact exponential moment of the subset size. -/
theorem bernoulli_size_mgf {α : Type*} (S : Finset α) (ρ θ : ℝ) :
    (∑ s ∈ S.powerset, bernoulliSubsetWeight ρ S s * Real.exp (θ * (s.card : ℝ))) =
      (1 - ρ + ρ * Real.exp θ) ^ S.card := by
  have h := subset_weighted_product_expansion S ρ (1 - ρ) (fun _ => Real.exp θ)
  simpa only [bernoulliSubsetWeight, Finset.prod_const, mul_comm θ, Real.exp_nat_mul] using h

/-- Poisson exponential-moment bound for a Bernoulli subset size. -/
theorem bernoulli_size_mgf_le {α : Type*} (S : Finset α) {ρ : ℝ}
    (hρ₀ : 0 ≤ ρ) (hρ₁ : ρ ≤ 1) (θ : ℝ) :
    (∑ s ∈ S.powerset, bernoulliSubsetWeight ρ S s * Real.exp (θ * (s.card : ℝ))) ≤
      Real.exp (ρ * S.card * (Real.exp θ - 1)) := by
  rw [bernoulli_size_mgf]
  have hbase : 0 ≤ 1 - ρ + ρ * Real.exp θ := by positivity
  have hstep : 1 - ρ + ρ * Real.exp θ ≤ Real.exp (ρ * (Real.exp θ - 1)) := by
    have := Real.add_one_le_exp (ρ * (Real.exp θ - 1))
    nlinarith
  calc
    (1 - ρ + ρ * Real.exp θ) ^ S.card ≤
        Real.exp (ρ * (Real.exp θ - 1)) ^ S.card := pow_le_pow_left₀ hbase hstep _
    _ = Real.exp (ρ * S.card * (Real.exp θ - 1)) := by
      rw [← Real.exp_nat_mul]
      congr 1
      ring

/-- The centered exponential moment is bounded uniformly in either sign of `θ`. -/
theorem bernoulli_centered_mgf_le {α : Type*} (S : Finset α) {ρ : ℝ}
    (hρ₀ : 0 ≤ ρ) (hρ₁ : ρ ≤ 1) (θ : ℝ) :
    (∑ s ∈ S.powerset, bernoulliSubsetWeight ρ S s *
      Real.exp (θ * ((s.card : ℝ) - ρ * S.card))) ≤
      Real.exp (ρ * S.card * (Real.exp θ - 1 - θ)) := by
  calc
    (∑ s ∈ S.powerset, bernoulliSubsetWeight ρ S s *
        Real.exp (θ * ((s.card : ℝ) - ρ * S.card))) =
        Real.exp (-θ * (ρ * S.card)) *
          ∑ s ∈ S.powerset, bernoulliSubsetWeight ρ S s * Real.exp (θ * (s.card : ℝ)) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro s _
      rw [show θ * ((s.card : ℝ) - ρ * S.card) =
        -θ * (ρ * S.card) + θ * (s.card : ℝ) by ring, Real.exp_add]
      ring
    _ ≤ Real.exp (-θ * (ρ * S.card)) *
        Real.exp (ρ * S.card * (Real.exp θ - 1)) :=
      mul_le_mul_of_nonneg_left (bernoulli_size_mgf_le S hρ₀ hρ₁ θ) (Real.exp_pos _).le
    _ = Real.exp (ρ * S.card * (Real.exp θ - 1 - θ)) := by
      rw [← Real.exp_add]
      congr 1
      ring

/-- A quadratic bound for the centered exponential moment when `|θ| ≤ 1`. -/
theorem bernoulli_centered_mgf_le_quadratic {α : Type*} (S : Finset α) {ρ θ : ℝ}
    (hρ₀ : 0 ≤ ρ) (hρ₁ : ρ ≤ 1) (hθ : |θ| ≤ 1) :
    (∑ s ∈ S.powerset, bernoulliSubsetWeight ρ S s *
      Real.exp (θ * ((s.card : ℝ) - ρ * S.card))) ≤
      Real.exp (ρ * S.card * θ ^ 2) := by
  apply (bernoulli_centered_mgf_le S hρ₀ hρ₁ θ).trans
  apply Real.exp_le_exp.mpr
  exact mul_le_mul_of_nonneg_left
    ((le_abs_self _).trans (Real.abs_exp_sub_one_sub_id_le hθ)) (by positivity)


/-- Any family above a centered exponential threshold has exponentially small mass. -/
theorem bernoulli_centered_markov {α : Type*} (S : Finset α) (A : Finset (Finset α))
    (hA : A ⊆ S.powerset) {ρ θ b : ℝ} (hρ₀ : 0 ≤ ρ) (hρ₁ : ρ ≤ 1)
    (hθ : |θ| ≤ 1) (hthreshold : ∀ s ∈ A, b ≤ θ * ((s.card : ℝ) - ρ * S.card)) :
    (∑ s ∈ A, bernoulliSubsetWeight ρ S s) ≤ Real.exp (ρ * S.card * θ ^ 2 - b) := by
  calc
    (∑ s ∈ A, bernoulliSubsetWeight ρ S s) ≤ Real.exp (-b) *
        ∑ s ∈ S.powerset, bernoulliSubsetWeight ρ S s *
          Real.exp (θ * ((s.card : ℝ) - ρ * S.card)) :=
      finite_exponential_markov S.powerset A hA _ _
        (fun s _ => bernoulliSubsetWeight_nonneg hρ₀ hρ₁ S s) hthreshold
    _ ≤ Real.exp (-b) * Real.exp (ρ * S.card * θ ^ 2) :=
      mul_le_mul_of_nonneg_left (bernoulli_centered_mgf_le_quadratic S hρ₀ hρ₁ hθ)
        (Real.exp_pos _).le
    _ = Real.exp (ρ * S.card * θ ^ 2 - b) := by
      rw [← Real.exp_add]
      congr 1
      ring

/-- Upper relative deviation of a Bernoulli subset size. -/
theorem bernoulli_upper_tail_mass_le {α : Type*} (S : Finset α) (A : Finset (Finset α))
    (hA : A ⊆ S.powerset) {ρ ν : ℝ} (hρ₀ : 0 ≤ ρ) (hρ₁ : ρ ≤ 1)
    (hν₀ : 0 ≤ ν) (hν₁ : ν ≤ 1)
    (hsize : ∀ s ∈ A, (1 + ν) * (ρ * S.card) ≤ (s.card : ℝ)) :
    (∑ s ∈ A, bernoulliSubsetWeight ρ S s) ≤
      Real.exp (-ν ^ 2 * (ρ * S.card) / 4) := by
  have hθ : |ν / 2| ≤ 1 := by rw [abs_of_nonneg (by positivity)]; linarith
  have hb : ∀ s ∈ A, ν ^ 2 * (ρ * S.card) / 2 ≤
      (ν / 2) * ((s.card : ℝ) - ρ * S.card) := by
    intro s hs
    have hm := mul_le_mul_of_nonneg_left (hsize s hs) hν₀
    nlinarith
  have h := bernoulli_centered_markov S A hA hρ₀ hρ₁ hθ hb
  convert h using 1
  congr 1
  ring

/-- Lower relative deviation of a Bernoulli subset size. -/
theorem bernoulli_lower_tail_mass_le {α : Type*} (S : Finset α) (A : Finset (Finset α))
    (hA : A ⊆ S.powerset) {ρ ν : ℝ} (hρ₀ : 0 ≤ ρ) (hρ₁ : ρ ≤ 1)
    (hν₀ : 0 ≤ ν) (hν₁ : ν ≤ 1)
    (hsize : ∀ s ∈ A, (s.card : ℝ) ≤ (1 - ν) * (ρ * S.card)) :
    (∑ s ∈ A, bernoulliSubsetWeight ρ S s) ≤
      Real.exp (-ν ^ 2 * (ρ * S.card) / 4) := by
  have hθ : |-(ν / 2)| ≤ 1 := by rw [abs_neg, abs_of_nonneg (by positivity)]; linarith
  have hb : ∀ s ∈ A, ν ^ 2 * (ρ * S.card) / 2 ≤
      -(ν / 2) * ((s.card : ℝ) - ρ * S.card) := by
    intro s hs
    have hm := mul_le_mul_of_nonneg_left (hsize s hs) hν₀
    nlinarith
  have h := bernoulli_centered_markov S A hA hρ₀ hρ₁ hθ hb
  convert h using 1
  congr 1
  ring


/-- Two-sided relative tail bound; the constant `1/4` is sufficient for the transfer. -/
theorem bernoulli_relative_tail_mass_le {α : Type*} (S : Finset α)
    {ρ ν : ℝ} (hρ₀ : 0 ≤ ρ) (hρ₁ : ρ ≤ 1) (hν₀ : 0 ≤ ν) (hν₁ : ν ≤ 1) :
    (∑ s ∈ S.powerset with ν * (ρ * S.card) < |(s.card : ℝ) - ρ * S.card|,
      bernoulliSubsetWeight ρ S s) ≤ 2 * Real.exp (-ν ^ 2 * (ρ * S.card) / 4) := by
  classical
  let U := S.powerset.filter fun s => (1 + ν) * (ρ * S.card) ≤ (s.card : ℝ)
  let L := S.powerset.filter fun s => (s.card : ℝ) ≤ (1 - ν) * (ρ * S.card)
  have hu := bernoulli_upper_tail_mass_le S U (Finset.filter_subset _ _)
    hρ₀ hρ₁ hν₀ hν₁ (fun s hs => (Finset.mem_filter.mp hs).2)
  have hl := bernoulli_lower_tail_mass_le S L (Finset.filter_subset _ _)
    hρ₀ hρ₁ hν₀ hν₁ (fun s hs => (Finset.mem_filter.mp hs).2)
  have hsum : (∑ s ∈ S.powerset with ν * (ρ * S.card) < |(s.card : ℝ) - ρ * S.card|,
      bernoulliSubsetWeight ρ S s) ≤
      (∑ s ∈ U, bernoulliSubsetWeight ρ S s) + ∑ s ∈ L, bernoulliSubsetWeight ρ S s := by
    dsimp [U, L]
    simp only [Finset.sum_filter]
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_le_sum
    intro s hs
    have hw := bernoulliSubsetWeight_nonneg hρ₀ hρ₁ S s
    have hcover : ν * (ρ * S.card) < |(s.card : ℝ) - ρ * S.card| →
        (1 + ν) * (ρ * S.card) ≤ (s.card : ℝ) ∨
        (s.card : ℝ) ≤ (1 - ν) * (ρ * S.card) := by
      intro hb
      by_contra h
      push Not at h
      have habs : |(s.card : ℝ) - ρ * S.card| ≤ ν * (ρ * S.card) :=
        abs_le.mpr ⟨by linarith [h.2], by linarith [h.1]⟩
      exact (not_lt_of_ge habs) hb
    split_ifs <;> simp_all
  linarith


/-- Deleting a bad event from a family loses no more than its total ambient mass. -/
theorem finite_mass_filter_lower_bound {α : Type*}
    (Ω A : Finset α) (hA : A ⊆ Ω) (w : α → ℝ) (hw : ∀ a ∈ Ω, 0 ≤ w a)
    (good : α → Prop) [DecidablePred good] {m e : ℝ}
    (hmass : m ≤ ∑ a ∈ A, w a) (hbad : (∑ a ∈ Ω with ¬good a, w a) ≤ e) :
    m - e ≤ ∑ a ∈ A with good a, w a := by
  have hsplit := Finset.sum_filter_add_sum_filter_not A good w
  have hsub : A.filter (fun a => ¬good a) ⊆ Ω.filter (fun a => ¬good a) := by
    intro a ha
    exact Finset.mem_filter.mpr ⟨hA (Finset.mem_filter.mp ha).1, (Finset.mem_filter.mp ha).2⟩
  have hle : (∑ a ∈ A with ¬good a, w a) ≤ ∑ a ∈ Ω with ¬good a, w a := by
    apply Finset.sum_le_sum_of_subset_of_nonneg hsub
    intro a ha _
    exact hw a (Finset.mem_filter.mp ha).1
  linarith

/-- Retaining only subsets near their mean preserves the initial family mass,
up to the proved exponentially small tail loss. -/
theorem bernoulli_good_size_mass_lower_bound {α : Type*}
    (S : Finset α) (A : Finset (Finset α)) (hA : A ⊆ S.powerset)
    {ρ ν m : ℝ} (hρ₀ : 0 ≤ ρ) (hρ₁ : ρ ≤ 1) (hν₀ : 0 ≤ ν) (hν₁ : ν ≤ 1)
    (hmass : m ≤ ∑ s ∈ A, bernoulliSubsetWeight ρ S s) :
    m - 2 * Real.exp (-ν ^ 2 * (ρ * S.card) / 4) ≤
      ∑ s ∈ A with |(s.card : ℝ) - ρ * S.card| ≤ ν * (ρ * S.card),
        bernoulliSubsetWeight ρ S s := by
  apply finite_mass_filter_lower_bound S.powerset A hA _
    (fun s _ => bernoulliSubsetWeight_nonneg hρ₀ hρ₁ S s) _ hmass
  simpa only [not_le] using bernoulli_relative_tail_mass_le S hρ₀ hρ₁ hν₀ hν₁
end

section

noncomputable def balancedZeroSumSubsets {ι G : Type*} [AddCommGroup G]
    (S : Finset ι) (g : ι → G) (ρ ν : ℝ) : Finset (Finset ι) := by
  classical
  exact (S.powerset.filter fun t => (∑ i ∈ t, g i) = 0).filter
    fun t => |(t.card : ℝ) - ρ * S.card| ≤ ν * (ρ * S.card)

/-- A quantitative count of zero-sum subsets concentrated near the desired
size. Both the Fourier error and the size-tail error have been proved. -/
theorem balanced_zero_sum_card_lower_bound {ι G : Type*}
    [AddCommGroup G] [Fintype G] (S : Finset ι) (g : ι → G)
    {ρ ν E : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ ≤ 1) (hν0 : 0 ≤ ν) (hν1 : ν ≤ 1)
    (henergy : ∀ χ : AddChar G ℂ, χ ≠ 0 →
      E ≤ ∑ i ∈ S, (1 - (χ (g i)).re))
    {k : ℕ} (hk : (k : ℝ) ≤ (1 - ν) * (ρ * S.card)) :
    (1 / (Fintype.card G : ℝ) - Real.exp (-ρ * (1 - ρ) * E) -
        2 * Real.exp (-ν ^ 2 * (ρ * S.card) / 4)) / ρ ^ k ≤
      ((balancedZeroSumSubsets S g ρ ν).card : ℝ) := by
  classical
  let A := S.powerset.filter fun t => (∑ i ∈ t, g i) = 0
  have hA : A ⊆ S.powerset := Finset.filter_subset _ _
  have hmass : 1 / (Fintype.card G : ℝ) - Real.exp (-ρ * (1 - ρ) * E) ≤
      ∑ t ∈ A, bernoulliSubsetWeight ρ S t := by
    simpa only [A, Finset.sum_filter] using
      bernoulli_identity_mass_lower_bound S g hρ0.le hρ1 henergy
  have hgood := bernoulli_good_size_mass_lower_bound S A hA hρ0.le hρ1 hν0 hν1 hmass
  apply card_ge_bernoulli_mass_div_pow hρ0 hρ1 S (balancedZeroSumSubsets S g ρ ν)
  · exact hgood
  · intro t ht
    have hsize := (Finset.mem_filter.mp ht).2
    change |(t.card : ℝ) - ρ * S.card| ≤ ν * (ρ * S.card) at hsize
    have hlow := (abs_le.mp hsize).1
    have hcast : (k : ℝ) ≤ t.card := by nlinarith
    exact_mod_cast hcast
end

section

/-- A zero-sum of the additive form of residue units gives a Korselt product. -/
theorem isCarmichael_prod_of_unit_zero_sum {L : ℕ} {P s : Finset ℕ}
    (hsub : s ⊆ P) (hprime : ∀ p ∈ P, p.Prime) (hcard : 2 ≤ s.card)
    (hL : ∀ p ∈ P, p - 1 ∣ L) (g : ℕ → (ZMod L)ˣ)
    (hcompat : ∀ p ∈ P, (g p : ZMod L) = (p : ZMod L))
    (hsum : (∑ p ∈ s, Additive.ofMul (g p)) = 0) :
    IsCarmichael (∏ p ∈ s, p) := by
  have hunit : (∏ p ∈ s, g p) = 1 := by
    have h := congrArg Additive.toMul hsum
    simpa only [toMul_sum, toMul_ofMul, toMul_zero] using h
  have hcast : (∏ p ∈ s, (g p : ZMod L)) = 1 := by
    simpa only [map_prod, map_one, Units.coeHom_apply] using congrArg (Units.coeHom (ZMod L)) hunit
  have hnat : ((∏ p ∈ s, p : ℕ) : ZMod L) = 1 := by
    rw [Nat.cast_prod]
    calc
      (∏ p ∈ s, (p : ZMod L)) = ∏ p ∈ s, (g p : ZMod L) := by
        apply Finset.prod_congr rfl
        intro p hp
        exact (hcompat p (hsub hp)).symm
      _ = 1 := hcast
  apply isCarmichael_prod_of_modEq (fun p hp => hprime p (hsub hp)) hcard
    (fun p hp => hL p (hsub hp))
  exact (ZMod.natCast_eq_natCast_iff _ 1 L).mp (by simpa only [Nat.cast_one] using hnat)

/-- A product of at most `u` factors bounded by `B ≥ 1` is at most `B^u`. -/
theorem nat_product_le_rpow {s : Finset ℕ} {B u : ℝ}
    (hB : 1 ≤ B) (hbound : ∀ p ∈ s, (p : ℝ) ≤ B) (hcard : (s.card : ℝ) ≤ u) :
    ((∏ p ∈ s, p : ℕ) : ℝ) ≤ B ^ u := by
  calc
    ((∏ p ∈ s, p : ℕ) : ℝ) = ∏ p ∈ s, (p : ℝ) := by rw [Nat.cast_prod]
    _ ≤ ∏ _p ∈ s, B := Finset.prod_le_prod₀ (fun p _ => Nat.cast_nonneg p) hbound
    _ = B ^ s.card := Finset.prod_const B
    _ = B ^ (s.card : ℝ) := (Real.rpow_natCast B s.card).symm
    _ ≤ B ^ u := Real.rpow_le_rpow_of_exponent_le hB hcard

/-- Every balanced zero-sum subset yields a distinct Carmichael number below the size bound. -/
theorem balanced_unit_subsets_card_le_carmichaelCounting {L : ℕ} (P : Finset ℕ)
    (g : ℕ → (ZMod L)ˣ) (hprime : ∀ p ∈ P, p.Prime)
    (hL : ∀ p ∈ P, p - 1 ∣ L)
    (hcompat : ∀ p ∈ P, (g p : ZMod L) = (p : ZMod L))
    {B ρ ν : ℝ} (hB : 1 ≤ B) (hbound : ∀ p ∈ P, (p : ℝ) ≤ B)
    (hsize : 2 ≤ (1 - ν) * (ρ * P.card)) :
    ((balancedZeroSumSubsets P (fun p => Additive.ofMul (g p)) ρ ν).card : ℝ) ≤
      Erdos1057.carmichaelCounting (B ^ ((1 + ν) * (ρ * P.card))) := by
  classical
  have hmem (s : Finset ℕ)
      (hs : s ∈ balancedZeroSumSubsets P (fun p => Additive.ofMul (g p)) ρ ν) :
      (s ⊆ P ∧ (∑ p ∈ s, Additive.ofMul (g p)) = 0) ∧
        |(s.card : ℝ) - ρ * P.card| ≤ ν * (ρ * P.card) := by
    simpa only [balancedZeroSumSubsets, Finset.mem_filter, Finset.mem_powerset] using hs
  apply subset_family_card_le_carmichaelCounting hprime
  · intro s hs
    exact (hmem s hs).1.1
  · intro s hs
    obtain ⟨⟨hsub, hszero⟩, hsbalanced⟩ := hmem s hs
    have hlow := (abs_le.mp hsbalanced).1
    have hcard : (2 : ℝ) ≤ s.card := by nlinarith
    exact isCarmichael_prod_of_unit_zero_sum hsub hprime (by exact_mod_cast hcard)
      hL g hcompat hszero
  · intro s hs
    obtain ⟨⟨hsub, _⟩, hsbalanced⟩ := hmem s hs
    apply nat_product_le_rpow hB (fun p hp => hbound p (hsub hp))
    have hhigh := (abs_le.mp hsbalanced).2
    nlinarith

/-- Quantitative Carmichael counting from a finite prime reservoir with a character-energy bound.
Both the zero-sum estimate and concentration loss are supplied by proved finite lemmas. -/
theorem carmichaelCounting_lower_bound_of_unit_energy {L : ℕ} [NeZero L]
    (P : Finset ℕ) (g : ℕ → (ZMod L)ˣ)
    (hprime : ∀ p ∈ P, p.Prime) (hL : ∀ p ∈ P, p - 1 ∣ L)
    (hcompat : ∀ p ∈ P, (g p : ZMod L) = (p : ZMod L))
    {B ρ ν E : ℝ} (hB : 1 ≤ B) (hbound : ∀ p ∈ P, (p : ℝ) ≤ B)
    (hρ0 : 0 < ρ) (hρ1 : ρ ≤ 1) (hν0 : 0 ≤ ν) (hν1 : ν ≤ 1)
    (hsize : 2 ≤ (1 - ν) * (ρ * P.card))
    (henergy : ∀ χ : AddChar (Additive ((ZMod L)ˣ)) ℂ, χ ≠ 0 →
      E ≤ ∑ p ∈ P, (1 - (χ (Additive.ofMul (g p))).re))
    {k : ℕ} (hk : (k : ℝ) ≤ (1 - ν) * (ρ * P.card)) :
    (1 / (Fintype.card (Additive ((ZMod L)ˣ)) : ℝ) - Real.exp (-ρ * (1 - ρ) * E) -
        2 * Real.exp (-ν ^ 2 * (ρ * P.card) / 4)) / ρ ^ k ≤
      Erdos1057.carmichaelCounting (B ^ ((1 + ν) * (ρ * P.card))) := by
  exact (balanced_zero_sum_card_lower_bound P (fun p => Additive.ofMul (g p))
    hρ0 hρ1 hν0 hν1 henergy hk).trans
    (balanced_unit_subsets_card_le_carmichaelCounting P g hprime hL hcompat hB hbound hsize)

/-- The zero-sum construction is valid in any group mapping to the residue units. -/
theorem isCarmichael_prod_of_mapped_unit_zero_sum {H : Type*} [CommGroup H]
    {L : ℕ} {P s : Finset ℕ} (hsub : s ⊆ P)
    (hprime : ∀ p ∈ P, p.Prime) (hcard : 2 ≤ s.card)
    (hL : ∀ p ∈ P, p - 1 ∣ L) (g : ℕ → H) (φ : H →* (ZMod L)ˣ)
    (hcompat : ∀ p ∈ P, (φ (g p) : ZMod L) = (p : ZMod L))
    (hsum : (∑ p ∈ s, Additive.ofMul (g p)) = 0) :
    IsCarmichael (∏ p ∈ s, p) := by
  have hunit : (∏ p ∈ s, g p) = 1 := by
    have h := congrArg Additive.toMul hsum
    simpa only [toMul_sum, toMul_ofMul, toMul_zero] using h
  have hmapped : (∏ p ∈ s, φ (g p)) = 1 := by
    rw [← map_prod, hunit, map_one]
  apply isCarmichael_prod_of_unit_zero_sum hsub hprime hcard hL (fun p => φ (g p)) hcompat
  rw [← ofMul_prod, hmapped, ofMul_one]

/-- Balanced subsets in a subgroup still yield distinct Carmichael products. -/
theorem balanced_mapped_unit_subsets_card_le_carmichaelCounting {H : Type*} [CommGroup H]
    {L : ℕ} (P : Finset ℕ) (g : ℕ → H) (φ : H →* (ZMod L)ˣ)
    (hprime : ∀ p ∈ P, p.Prime) (hL : ∀ p ∈ P, p - 1 ∣ L)
    (hcompat : ∀ p ∈ P, (φ (g p) : ZMod L) = (p : ZMod L))
    {B ρ ν : ℝ} (hB : 1 ≤ B) (hbound : ∀ p ∈ P, (p : ℝ) ≤ B)
    (hsize : 2 ≤ (1 - ν) * (ρ * P.card)) :
    ((balancedZeroSumSubsets P (fun p => Additive.ofMul (g p)) ρ ν).card : ℝ) ≤
      Erdos1057.carmichaelCounting (B ^ ((1 + ν) * (ρ * P.card))) := by
  classical
  have hmem (s : Finset ℕ)
      (hs : s ∈ balancedZeroSumSubsets P (fun p => Additive.ofMul (g p)) ρ ν) :
      (s ⊆ P ∧ (∑ p ∈ s, Additive.ofMul (g p)) = 0) ∧
        |(s.card : ℝ) - ρ * P.card| ≤ ν * (ρ * P.card) := by
    simpa only [balancedZeroSumSubsets, Finset.mem_filter, Finset.mem_powerset] using hs
  apply subset_family_card_le_carmichaelCounting hprime
  · intro s hs
    exact (hmem s hs).1.1
  · intro s hs
    obtain ⟨⟨hsub, hszero⟩, hsbalanced⟩ := hmem s hs
    have hlow := (abs_le.mp hsbalanced).1
    have hcard : (2 : ℝ) ≤ s.card := by nlinarith
    exact isCarmichael_prod_of_mapped_unit_zero_sum hsub hprime (by exact_mod_cast hcard)
      hL g φ hcompat hszero
  · intro s hs
    obtain ⟨⟨hsub, _⟩, hsbalanced⟩ := hmem s hs
    apply nat_product_le_rpow hB (fun p hp => hbound p (hsub hp))
    have hhigh := (abs_le.mp hsbalanced).2
    nlinarith

/-- The counting estimate only needs spectral mixing inside the retained group.
The homomorphism into residue units need not be injective. -/
theorem carmichaelCounting_lower_bound_of_mapped_unit_energy {H : Type*}
    [CommGroup H] [Fintype H] {L : ℕ}
    (P : Finset ℕ) (g : ℕ → H) (φ : H →* (ZMod L)ˣ)
    (hprime : ∀ p ∈ P, p.Prime) (hL : ∀ p ∈ P, p - 1 ∣ L)
    (hcompat : ∀ p ∈ P, (φ (g p) : ZMod L) = (p : ZMod L))
    {B ρ ν E : ℝ} (hB : 1 ≤ B) (hbound : ∀ p ∈ P, (p : ℝ) ≤ B)
    (hρ0 : 0 < ρ) (hρ1 : ρ ≤ 1) (hν0 : 0 ≤ ν) (hν1 : ν ≤ 1)
    (hsize : 2 ≤ (1 - ν) * (ρ * P.card))
    (henergy : ∀ χ : AddChar (Additive H) ℂ, χ ≠ 0 →
      E ≤ ∑ p ∈ P, (1 - (χ (Additive.ofMul (g p))).re))
    {k : ℕ} (hk : (k : ℝ) ≤ (1 - ν) * (ρ * P.card)) :
    (1 / (Fintype.card (Additive H) : ℝ) - Real.exp (-ρ * (1 - ρ) * E) -
        2 * Real.exp (-ν ^ 2 * (ρ * P.card) / 4)) / ρ ^ k ≤
      Erdos1057.carmichaelCounting (B ^ ((1 + ν) * (ρ * P.card))) := by
  exact (balanced_zero_sum_card_lower_bound P (fun p => Additive.ofMul (g p))
    hρ0 hρ1 hν0 hν1 henergy hk).trans
    (balanced_mapped_unit_subsets_card_le_carmichaelCounting P g φ hprime hL hcompat hB hbound hsize)
end

section

/-- An additive character on the additive type tag is a multiplicative character. -/
def addCharOfMulToMonoidHom {H : Type*} [Monoid H] (χ : AddChar (Additive H) ℂ) :
    H →* ℂ where
  toFun x := χ (Additive.ofMul x)
  map_one' := by simpa only [ofMul_one] using χ.map_zero_eq_one
  map_mul' x y := by
    simpa only [ofMul_mul] using χ.map_add_eq_mul (Additive.ofMul x) (Additive.ofMul y)

theorem addCharOfMulToMonoidHom_ne_one {H : Type*} [Monoid H]
    {χ : AddChar (Additive H) ℂ} (hχ : χ ≠ 0) : addCharOfMulToMonoidHom χ ≠ 1 := by
  intro heq
  apply hχ
  ext x
  change χ x = 1
  have h := DFunLike.congr_fun heq x.toMul
  simpa only [addCharOfMulToMonoidHom, MonoidHom.coe_mk, OneHom.coe_mk,
    ofMul_toMul, MonoidHom.one_apply] using h

/-- End-to-end finite transfer: a large reservoir with small predecessor modulus and
ambient character cancellation contains a half-reservoir generating many Carmichael numbers. -/
theorem finite_carmichael_transfer {L : ℕ} [NeZero L]
    (S P : Finset ℕ) (hPS : P ⊆ S) (g : ℕ → (ZMod L)ˣ)
    (hprime : ∀ p ∈ P, p.Prime) (hL : ∀ p ∈ P, p - 1 ∣ L)
    (hcompat : ∀ p ∈ P, (g p : ZMod L) = (p : ZMod L))
    {B M A : ℝ} (hB : 1 ≤ B) (hbound : ∀ p ∈ P, (p : ℝ) ≤ B)
    (hM : 0 ≤ M)
    (hbudget : M * Nat.log 2 (Nat.card ((ZMod L)ˣ)) ≤ (P.card : ℝ) / 2)
    {R : ℕ} (hR : 0 < R)
    (hRlarge : 64 * (S.card : ℝ) ≤ (P.card : ℝ) * R)
    (hsmall : (R - 1 : ℝ) * A ≤ S.card)
    (hamb : ∀ ξ : (ZMod L)ˣ →* ℂ, ξ ≠ 1 → ‖∑ p ∈ S, ξ (g p)‖ ≤ A) :
    ∃ (H : Subgroup ((ZMod L)ˣ)) (T : Finset ℕ) (h : ℕ → H),
      T = subgroupReservoir P g H ∧ T ⊆ P ∧
      (P.card : ℝ) / 2 ≤ (T.card : ℝ) ∧
      (∀ p ∈ T, (h p : (ZMod L)ˣ) = g p) ∧
      ∀ (ρ ν : ℝ) (k : ℕ),
        0 < ρ → ρ ≤ 1 → 0 ≤ ν → ν ≤ 1 →
        2 ≤ (1 - ν) * (ρ * T.card) →
        (k : ℝ) ≤ (1 - ν) * (ρ * T.card) →
        (1 / (Nat.card H : ℝ) -
            Real.exp (-ρ * (1 - ρ) *
              min (2 * M / (R : ℝ) ^ 2)
                (3 * (P.card : ℝ) / (4 * Real.pi ^ 2 * (R : ℝ) ^ 2))) -
            2 * Real.exp (-ν ^ 2 * (ρ * T.card) / 4)) / ρ ^ k ≤
          Erdos1057.carmichaelCounting (B ^ ((1 + ν) * (ρ * T.card))) := by
  classical
  obtain ⟨H, T, h, hTeq, hTP, hhalf, hagree, henergy⟩ :=
    exists_pruned_energy_reservoir S P hPS g hM hbudget hR hRlarge hsmall hamb
  refine ⟨H, T, h, hTeq, hTP, hhalf, hagree, ?_⟩
  intro ρ ν k hρ0 hρ1 hν0 hν1 hsize hk
  let : Fintype H := Fintype.ofFinite H
  have henergy' : ∀ χ : AddChar (Additive H) ℂ, χ ≠ 0 →
      min (2 * M / (R : ℝ) ^ 2)
        (3 * (P.card : ℝ) / (4 * Real.pi ^ 2 * (R : ℝ) ^ 2)) ≤
        ∑ p ∈ T, (1 - (χ (Additive.ofMul (h p))).re) := by
    intro χ hχ
    exact henergy (addCharOfMulToMonoidHom χ) (addCharOfMulToMonoidHom_ne_one hχ)
  have hcompat' : ∀ p ∈ T, (H.subtype (h p) : ZMod L) = (p : ZMod L) := by
    intro p hp
    change ((h p : (ZMod L)ˣ) : ZMod L) = (p : ZMod L)
    rw [hagree p hp]
    exact hcompat p (hTP hp)
  have hcount := carmichaelCounting_lower_bound_of_mapped_unit_energy T h H.subtype
    (fun p hp => hprime p (hTP hp)) (fun p hp => hL p (hTP hp)) hcompat'
    hB (fun p hp => hbound p (hTP hp)) hρ0 hρ1 hν0 hν1 hsize henergy' hk
  have hcard : Fintype.card (Additive H) = Nat.card H := by
    rw [Nat.card_eq_fintype_card]
    exact Fintype.card_congr Additive.ofMul.symm
  simpa only [hcard] using hcount
end

section

/-- The common spectral bound after using a logarithmic pruning budget. -/
theorem pruning_energy_lower_bound {N D r : ℝ} (hN : 0 ≤ N) (hD : 1 ≤ D)
    (hr : 0 < r) :
    N / (100 * D * r ^ 2) ≤
      min (2 * (N / (2 * D)) / r ^ 2) (3 * N / (4 * Real.pi ^ 2 * r ^ 2)) := by
  have hD0 : 0 < D := lt_of_lt_of_le zero_lt_one hD
  have hr2 : 0 < r ^ 2 := sq_pos_of_pos hr
  have hpi2 : 0 < Real.pi ^ 2 := sq_pos_of_pos Real.pi_pos
  have hpi : Real.pi ^ 2 < 16 := by nlinarith [Real.pi_lt_four, Real.pi_pos]
  apply le_min
  · have heq : 2 * (N / (2 * D)) / r ^ 2 = N / (D * r ^ 2) := by
      field_simp
    rw [heq]
    apply div_le_div_of_nonneg_left hN (by positivity)
    nlinarith [mul_pos hD0 hr2]
  · apply (div_le_div_iff₀ (by positivity) (by positivity)).mpr
    have hc : 4 * Real.pi ^ 2 ≤ 300 * D := by nlinarith
    have hm := mul_le_mul_of_nonneg_right hc (mul_nonneg hN hr2.le)
    nlinarith

/-- A sample with expected size `t` inherits an explicit Fourier exponent. -/
theorem sampling_energy_lower_bound {N n D r t E : ℝ}
    (hN : 0 ≤ N) (hn : 0 < n) (hnN : n ≤ N) (hD : 1 ≤ D) (hr : 0 < r)
    (ht : 0 < t) (htn : t / n ≤ 1 / 2)
    (hE : N / (100 * D * r ^ 2) ≤ E) :
    t / (200 * D * r ^ 2) ≤ (t / n) * (1 - t / n) * E := by
  have hD0 : 0 < D := lt_of_lt_of_le zero_lt_one hD
  have he0 : 0 ≤ E := le_trans (by positivity) hE
  have hρ : 0 < t / n := div_pos ht hn
  have hρN : t ≤ (t / n) * N := by
    have hh := mul_le_mul_of_nonneg_left hnN hρ.le
    simpa only [div_mul_cancel₀ _ hn.ne'] using hh
  calc
    t / (200 * D * r ^ 2) = (t / (100 * D * r ^ 2)) / 2 := by ring
    _ ≤ ((t / n) * N / (100 * D * r ^ 2)) / 2 := by gcongr
    _ = (t / n) * (N / (100 * D * r ^ 2)) / 2 := by ring
    _ ≤ (t / n) * E / 2 := by gcongr
    _ ≤ (t / n) * (1 - t / n) * E := by
      nlinarith [mul_nonneg (by linarith : 0 ≤ 1 / 2 - t / n)
        (mul_nonneg hρ.le he0)]

/-- A logarithmic separation makes an exponential error a prescribed fraction
of the inverse ambient group-size bound. -/
theorem exp_error_le_inv_group {U a c : ℝ} (hc : 0 < c)
    (hgap : U + Real.log c ≤ a) :
    Real.exp (-a) ≤ Real.exp (-U) / c := by
  calc
    Real.exp (-a) ≤ Real.exp (-U - Real.log c) := Real.exp_le_exp.mpr (by linarith)
    _ = Real.exp (-U) / c := by rw [Real.exp_sub, Real.exp_log hc]

/-- Quantitative Carmichael production with the pruning and Fourier errors
absorbed into explicit logarithmic inequalities. The retained size is between
half and all of the original prime reservoir. -/
theorem finite_carmichael_counting_bound {L : ℕ} [NeZero L]
    (S P : Finset ℕ) (hPS : P ⊆ S) (g : ℕ → (ZMod L)ˣ)
    (hprime : ∀ p ∈ P, p.Prime) (hL : ∀ p ∈ P, p - 1 ∣ L)
    (hcompat : ∀ p ∈ P, (g p : ZMod L) = (p : ZMod L))
    {B D U A : ℝ} (hB : 1 ≤ B) (hbound : ∀ p ∈ P, (p : ℝ) ≤ B)
    (hD : 1 ≤ D) (hlogD : (Nat.log 2 (Nat.card ((ZMod L)ˣ)) : ℝ) ≤ D)
    (hU : Real.log (Nat.card ((ZMod L)ˣ) : ℝ) ≤ U)
    {R : ℕ} (hR : 0 < R)
    (hRlarge : 64 * (S.card : ℝ) ≤ (P.card : ℝ) * R)
    (hsmall : (R - 1 : ℝ) * A ≤ S.card)
    (hamb : ∀ ξ : (ZMod L)ˣ →* ℂ, ξ ≠ 1 → ‖∑ p ∈ S, ξ (g p)‖ ≤ A) :
    ∃ n : ℕ, (P.card : ℝ) / 2 ≤ n ∧ n ≤ P.card ∧
      ∀ (t ν : ℝ) (k : ℕ),
        0 < t → 2 * t ≤ n → 0 ≤ ν → ν ≤ 1 →
        2 ≤ (1 - ν) * t → (k : ℝ) ≤ (1 - ν) * t →
        U + Real.log 4 ≤ t / (200 * D * (R : ℝ) ^ 2) →
        U + Real.log 8 ≤ ν ^ 2 * t / 4 →
        Real.exp (-U) / 2 * ((n : ℝ) / t) ^ k ≤
          Erdos1057.carmichaelCounting (B ^ ((1 + ν) * t)) := by
  have hD0 : 0 < D := lt_of_lt_of_le zero_lt_one hD
  have hM : 0 ≤ (P.card : ℝ) / (2 * D) := by positivity
  have hbudget : (P.card : ℝ) / (2 * D) *
      Nat.log 2 (Nat.card ((ZMod L)ˣ)) ≤ (P.card : ℝ) / 2 := by
    calc
      _ ≤ (P.card : ℝ) / (2 * D) * D := mul_le_mul_of_nonneg_left hlogD hM
      _ = (P.card : ℝ) / 2 := by field_simp
  obtain ⟨H, T, h, _, hTP, hhalf, _, hcount⟩ :=
    finite_carmichael_transfer S P hPS g hprime hL hcompat hB hbound hM hbudget
      hR hRlarge hsmall hamb
  have hcard : T.card ≤ P.card := Finset.card_le_card hTP
  refine ⟨T.card, hhalf, hcard, ?_⟩
  intro t ν k ht htn hν0 hν1 hsize hk hfourier htail
  have hn : 0 < (T.card : ℝ) := by linarith
  have hρ0 : 0 < t / T.card := div_pos ht hn
  have hρhalf : t / T.card ≤ 1 / 2 := (div_le_iff₀ hn).mpr (by linarith)
  have hρ1 : t / T.card ≤ 1 := hρhalf.trans (by norm_num)
  have heq : t / (T.card : ℝ) * T.card = t := div_mul_cancel₀ _ hn.ne'
  have hresult := hcount (t / T.card) ν k hρ0 hρ1 hν0 hν1
    (by rwa [heq]) (by rwa [heq])
  rw [heq] at hresult
  have hr : 0 < (R : ℝ) := by exact_mod_cast hR
  have hE := pruning_energy_lower_bound (N := (P.card : ℝ))
    (Nat.cast_nonneg _) hD hr
  have hsample := sampling_energy_lower_bound (Nat.cast_nonneg P.card) hn
    (by exact_mod_cast hcard) hD hr ht hρhalf hE
  have herr1 : Real.exp (-(t / T.card) * (1 - t / T.card) *
      min (2 * ((P.card : ℝ) / (2 * D)) / (R : ℝ) ^ 2)
        (3 * (P.card : ℝ) / (4 * Real.pi ^ 2 * (R : ℝ) ^ 2))) ≤
      Real.exp (-U) / 4 := by
    refine (Real.exp_le_exp.mpr ?_).trans (exp_error_le_inv_group (by norm_num) hfourier)
    linarith
  have herr2 : 2 * Real.exp (-ν ^ 2 * t / 4) ≤ Real.exp (-U) / 4 := by
    have h := exp_error_le_inv_group (by norm_num : (0 : ℝ) < 8) htail
    have he : -ν ^ 2 * t / 4 = -(ν ^ 2 * t / 4) := by ring
    rw [he]
    linarith
  have hHpos : 0 < (Nat.card H : ℝ) := by exact_mod_cast (Nat.card_pos (α := H))
  have hHlog : Real.log (Nat.card H : ℝ) ≤ U :=
    (Real.log_le_log hHpos (by exact_mod_cast H.card_le_card_group)).trans hU
  have hinv : Real.exp (-U) ≤ 1 / (Nat.card H : ℝ) := by
    calc
      _ ≤ Real.exp (-Real.log (Nat.card H : ℝ)) := Real.exp_le_exp.mpr (by linarith)
      _ = 1 / (Nat.card H : ℝ) := by rw [Real.exp_neg, Real.exp_log hHpos, one_div]
  have hnum : Real.exp (-U) / 2 ≤ 1 / (Nat.card H : ℝ) -
      Real.exp (-(t / T.card) * (1 - t / T.card) *
        min (2 * ((P.card : ℝ) / (2 * D)) / (R : ℝ) ^ 2)
          (3 * (P.card : ℝ) / (4 * Real.pi ^ 2 * (R : ℝ) ^ 2))) -
      2 * Real.exp (-ν ^ 2 * t / 4) := by linarith
  calc
    Real.exp (-U) / 2 * ((T.card : ℝ) / t) ^ k =
        (Real.exp (-U) / 2) / (t / T.card) ^ k := by
      rw [div_pow, div_pow]
      field_simp
    _ ≤ _ := (div_le_div_of_nonneg_right hnum (pow_nonneg hρ0.le _)).trans hresult
end

section

/-- Rounding the reservoir-to-ambient size ratio gives all the finite spectral
conditions as soon as the ambient character error is at most `N / 64`. -/
theorem fejer_length_parameters {N Q A : ℝ} (hN : 0 < N) (hNQ : N ≤ Q)
    (hA : 0 ≤ A) (hsmall : 64 * A ≤ N) :
    ∃ R : ℕ, 0 < R ∧ 64 * Q ≤ N * R ∧
      (R - 1 : ℝ) * A ≤ Q ∧ (R : ℝ) ≤ 65 * Q / N := by
  let z : ℝ := 64 * Q / N
  have hQ : 0 < Q := hN.trans_le hNQ
  have hz : 0 < z := div_pos (by positivity) hN
  have hratio : 1 ≤ Q / N := (le_div_iff₀ hN).mpr (by simpa using hNQ)
  have hceil := Nat.le_ceil z
  have hceil' := Nat.ceil_lt_add_one hz.le
  have hR : 0 < ⌈z⌉₊ := Nat.ceil_pos.mpr hz
  refine ⟨⌈z⌉₊, hR, ?_, ?_, ?_⟩
  · exact (div_le_iff₀ hN).mp hceil |>.trans_eq (by ring)
  · have hle : (⌈z⌉₊ : ℝ) - 1 ≤ z := by linarith
    have hmul := mul_le_mul_of_nonneg_right hle hA
    have hlast : z * A ≤ Q := by
      change 64 * Q / N * A ≤ Q
      rw [div_mul_eq_mul_div]
      apply (div_le_iff₀ hN).mpr
      have h := mul_le_mul_of_nonneg_left hsmall hQ.le
      convert h using 1
      ring
    exact hmul.trans hlast
  · dsimp [z] at hceil' ⊢
    have hid : 65 * Q / N = 64 * Q / N + Q / N := by ring
    rw [hid]
    linarith
end

section
open Filter Set
open scoped Topology
/-- A continuous cofinal real function maps every terminal ray onto a terminal ray. -/
theorem eventually_exists_preimage_ge {X : ℝ → ℝ} {a : ℝ}
    (hcont : ContinuousOn X (Ici a)) (htop : Tendsto X atTop atTop) (c : ℝ) :
    ∀ᶠ x : ℝ in atTop, ∃ y : ℝ, c ≤ y ∧ X y = x := by
  have hc : ContinuousOn X (Ici (max a c)) :=
    hcont.mono (Ici_subset_Ici.mpr (le_max_left a c))
  refine eventually_atTop.mpr ⟨X (max a c), ?_⟩
  intro x hx
  obtain ⟨y, hy, hxy⟩ := intermediate_value_Ici hc htop hx
  exact ⟨y, (le_max_right a c).trans hy, hxy⟩

/-- An eventual property verified along a continuous cofinal parameter holds for all large values. -/
theorem eventually_of_eventually_comp_cofinal {X : ℝ → ℝ} {a : ℝ}
    (hcont : ContinuousOn X (Ici a)) (htop : Tendsto X atTop atTop)
    {P : ℝ → Prop} (hP : ∀ᶠ y : ℝ in atTop, P (X y)) :
    ∀ᶠ x : ℝ in atTop, P x := by
  obtain ⟨c, hc⟩ := eventually_atTop.mp hP
  filter_upwards [eventually_exists_preimage_ge hcont htop c] with x hx
  obtain ⟨y, hy, rfl⟩ := hx
  exact hc y hy

/-- The all-values limit follows from the limit along a continuous cofinal real parameter. -/
theorem tendsto_of_comp_cofinal {β : Type*} {f : ℝ → β} {X : ℝ → ℝ}
    {a : ℝ} {l : Filter β} (hcont : ContinuousOn X (Ici a))
    (htop : Tendsto X atTop atTop) (h : Tendsto (fun y => f (X y)) atTop l) :
    Tendsto f atTop l := by
  apply tendsto_iff_eventually.mpr
  intro P hP
  exact eventually_of_eventually_comp_cofinal hcont htop (h.eventually hP)

/-- In particular, convergence may be checked after this reparameterization. -/
theorem tendsto_comp_cofinal_iff {β : Type*} {f : ℝ → β} {X : ℝ → ℝ}
    {a : ℝ} {l : Filter β} (hcont : ContinuousOn X (Ici a))
    (htop : Tendsto X atTop atTop) :
    Tendsto (fun y => f (X y)) atTop l ↔ Tendsto f atTop l :=
  ⟨tendsto_of_comp_cofinal hcont htop, fun h => h.comp htop⟩

/-- The size parameter used for prime-subset products in the transfer argument. -/
noncomputable def carmichaelSizeParameter (η ν y : ℝ) : ℝ :=
  (5 * y) ^ ((1 + ν) * y ^ η)

/-- The size parameter is continuous on the ray where its bases are positive. -/
theorem carmichaelSizeParameter_continuousOn (η ν : ℝ) :
    ContinuousOn (carmichaelSizeParameter η ν) (Ici 1) := by
  unfold carmichaelSizeParameter
  have hpow : ContinuousOn (fun y : ℝ => y ^ η) (Ici 1) :=
    continuousOn_id.rpow_const (fun y hy =>
      Or.inl (ne_of_gt (lt_of_lt_of_le zero_lt_one hy)))
  exact (continuousOn_const.mul continuousOn_id).rpow (continuousOn_const.mul hpow)
    (fun y hy => Or.inl (mul_ne_zero (by norm_num)
      (ne_of_gt (lt_of_lt_of_le zero_lt_one hy))))

/-- This elementary comparison already proves that the size parameter tends to infinity. -/
theorem self_le_carmichaelSizeParameter {η ν y : ℝ}
    (hη : 0 ≤ η) (hν : 0 ≤ ν) (hy : 1 ≤ y) :
    y ≤ carmichaelSizeParameter η ν y := by
  have hpow : 1 ≤ y ^ η := Real.one_le_rpow hy hη
  have hexp : 1 ≤ (1 + ν) * y ^ η := by nlinarith
  have hbase : 1 ≤ 5 * y := by linarith
  have hle : 5 * y ≤ (5 * y) ^ ((1 + ν) * y ^ η) :=
    by simpa only [Real.rpow_one] using Real.rpow_le_rpow_of_exponent_le hbase hexp
  exact (by linarith : y ≤ 5 * y).trans hle

theorem carmichaelSizeParameter_tendsto_atTop {η ν : ℝ}
    (hη : 0 ≤ η) (hν : 0 ≤ ν) :
    Tendsto (carmichaelSizeParameter η ν) atTop atTop := by
  apply tendsto_atTop_mono' atTop _ tendsto_id
  filter_upwards [eventually_ge_atTop (1 : ℝ)] with y hy
  exact self_le_carmichaelSizeParameter hη hν hy

/-- All-large-parameter estimates at the Carmichael size scale imply all-large-X estimates. -/
theorem eventually_of_carmichaelSizeParameter {η ν : ℝ}
    (hη : 0 ≤ η) (hν : 0 ≤ ν) {P : ℝ → Prop}
    (hP : ∀ᶠ y : ℝ in atTop, P (carmichaelSizeParameter η ν y)) :
    ∀ᶠ x : ℝ in atTop, P x :=
  eventually_of_eventually_comp_cofinal (carmichaelSizeParameter_continuousOn η ν)
    (carmichaelSizeParameter_tendsto_atTop hη hν) hP
end

section
open Filter
open scoped Topology
/-- A logarithm times a smaller real power is negligible compared with a larger power. -/
theorem tendsto_rpow_log_div_rpow {a b : ℝ} (hab : a < b) :
    Tendsto (fun y : ℝ => y ^ a * Real.log y / y ^ b) atTop (𝓝 0) := by
  have h := (isLittleO_log_rpow_atTop (sub_pos.mpr hab)).tendsto_div_nhds_zero
  refine h.congr' ?_
  filter_upwards [eventually_gt_atTop (0 : ℝ)] with y hy
  rw [Real.rpow_sub hy]
  have ha : y ^ a ≠ 0 := ne_of_gt (Real.rpow_pos_of_pos hy a)
  have hb : y ^ b ≠ 0 := ne_of_gt (Real.rpow_pos_of_pos hy b)
  field_simp

/-- Arbitrary fixed coefficients and an additive constant preserve the comparison. -/
theorem tendsto_mul_rpow_log_add_div_rpow {a b : ℝ} (hb : 0 < b) (hab : a < b)
    (d k : ℝ) :
    Tendsto (fun y : ℝ => (d * y ^ a * Real.log y + k) / y ^ b) atTop (𝓝 0) := by
  have h := ((tendsto_rpow_log_div_rpow hab).const_mul d).add
    ((tendsto_rpow_atTop hb).const_div_atTop k)
  have heq : (fun y : ℝ => (d * y ^ a * Real.log y + k) / y ^ b) =
      (fun y : ℝ => d * (y ^ a * Real.log y / y ^ b) + k / y ^ b) := by
    funext y
    ring
  rw [heq]
  simpa only [mul_zero, zero_add] using h

/-- Eventually every positive multiple of the larger power absorbs the error term. -/
theorem eventually_mul_rpow_log_add_le_rpow {a b c : ℝ}
    (hb : 0 < b) (hab : a < b) (hc : 0 < c) (d k : ℝ) :
    ∀ᶠ y : ℝ in atTop, d * y ^ a * Real.log y + k ≤ c * y ^ b := by
  filter_upwards [(tendsto_mul_rpow_log_add_div_rpow hb hab d k).eventually_le_const hc,
    eventually_gt_atTop (0 : ℝ)] with y h hy
  exact (div_le_iff₀ (Real.rpow_pos_of_pos hy b)).mp h

/-- The larger negative power forces the entire exponent to negative infinity. -/
theorem tendsto_mul_rpow_log_sub_rpow_atBot {a b c : ℝ}
    (hb : 0 < b) (hab : a < b) (hc : 0 < c) (d : ℝ) :
    Tendsto (fun y : ℝ => d * y ^ a * Real.log y - c * y ^ b) atTop atBot := by
  apply tendsto_atBot.mpr
  intro k
  filter_upwards [eventually_mul_rpow_log_add_le_rpow hb hab hc d (-k)] with y hy
  linarith

/-- Exponential decay dominates the power-logarithm growth in the exponent. -/
theorem tendsto_exp_mul_rpow_log_sub_rpow {a b c : ℝ}
    (hb : 0 < b) (hab : a < b) (hc : 0 < c) (d : ℝ) :
    Tendsto (fun y : ℝ => Real.exp (d * y ^ a * Real.log y - c * y ^ b))
      atTop (𝓝 0) :=
  Real.tendsto_exp_atBot.comp (tendsto_mul_rpow_log_sub_rpow_atBot hb hab hc d)

/-- Equivalent product form, convenient for exponential cardinality bounds. -/
theorem tendsto_exp_neg_rpow_mul_exp_rpow_log {a b c : ℝ}
    (hb : 0 < b) (hab : a < b) (hc : 0 < c) (d : ℝ) :
    Tendsto (fun y : ℝ => Real.exp (-c * y ^ b) * Real.exp (d * y ^ a * Real.log y))
      atTop (𝓝 0) := by
  convert tendsto_exp_mul_rpow_log_sub_rpow hb hab hc d using 1
  funext y
  rw [← Real.exp_add]
  congr 1
  ring

/-- The special case of a unit negative coefficient, with a nonnegative lower exponent. -/
theorem tendsto_exp_rpow_log_sub_rpow {a b : ℝ} (ha : 0 ≤ a) (hab : a < b) (d : ℝ) :
    Tendsto (fun y : ℝ => Real.exp (d * y ^ a * Real.log y - y ^ b)) atTop (𝓝 0) := by
  simpa using tendsto_exp_mul_rpow_log_sub_rpow (lt_of_le_of_lt ha hab) hab
    (show (0 : ℝ) < 1 by norm_num) d

/-- A useful fixed additive margin for inverse group-cardinality errors. -/
theorem eventually_rpow_log_add_log_four_le {a b c : ℝ}
    (hb : 0 < b) (hab : a < b) (hc : 0 < c) (d : ℝ) :
    ∀ᶠ y : ℝ in atTop, d * y ^ a * Real.log y + Real.log 4 ≤ c * y ^ b :=
  eventually_mul_rpow_log_add_le_rpow hb hab hc d (Real.log 4)

/-- Exponential decay eventually beats the inverse of a fixed multiple of the
exponential size bound. -/
theorem eventually_exp_neg_rpow_le_inv_exp {a b c K : ℝ}
    (hb : 0 < b) (hab : a < b) (hc : 0 < c) (hK : 0 < K) (d : ℝ) :
    ∀ᶠ y : ℝ in atTop,
      Real.exp (-c * y ^ b) ≤ 1 / (K * Real.exp (d * y ^ a * Real.log y)) := by
  filter_upwards [eventually_mul_rpow_log_add_le_rpow hb hab hc d (Real.log K)] with y hy
  calc
    Real.exp (-c * y ^ b) ≤ Real.exp (-(d * y ^ a * Real.log y + Real.log K)) :=
      Real.exp_le_exp.mpr (by linarith)
    _ = 1 / (K * Real.exp (d * y ^ a * Real.log y)) := by
      rw [Real.exp_neg, Real.exp_add, Real.exp_log hK]
      simp only [one_div, mul_comm]

/-- Uniform form for any positive cardinality bounded by the given exponential.
Taking `K = 4` gives the error threshold used in the finite transfer. -/
theorem eventually_exp_neg_rpow_le_inv_card {a b c K : ℝ}
    (hb : 0 < b) (hab : a < b) (hc : 0 < c) (hK : 0 < K) (d : ℝ) :
    ∀ᶠ y : ℝ in atTop, ∀ q : ℝ, 0 < q → q ≤ Real.exp (d * y ^ a * Real.log y) →
      Real.exp (-c * y ^ b) ≤ 1 / (K * q) := by
  filter_upwards [eventually_exp_neg_rpow_le_inv_exp hb hab hc hK d] with y hy
  intro q hq hbound
  exact hy.trans (one_div_le_one_div_of_le (mul_pos hK hq)
    (mul_le_mul_of_nonneg_left hbound hK.le))
end

section
open Filter Finset
open scoped Topology
/-- The complete logarithmic size budget is sublinear when `a + d < 1`.
This is uniform in all local weights and active moduli satisfying the stated
growth bounds. The degree is chosen explicitly by a ceiling. -/
theorem eventually_residue_precision_parameters {a d A γ : ℝ}
    (ha : 0 ≤ a) (hd : 0 ≤ d) (had : a + d < 1) (hA : 0 < A) (hγ : 0 < γ) :
    ∀ᶠ L : ℝ in atTop, ∀ ℓ B C q N : ℝ,
      0 ≤ ℓ → 0 ≤ B → 0 ≤ C → 0 < q → 0 < N →
      ℓ ≤ A * (L^a * Real.log L) → B ≤ A * (L^a * Real.log L) →
      Real.log q ≤ A * (L^(a + d) * Real.log L) →
      Real.log (1 + C) ≤ A * L^d → γ * L ≤ Real.log N →
      let k := Nat.ceil (5 * ℓ + B + Real.log 4)
      5 * ℓ + B + Real.log 4 ≤ (k : ℝ) ∧
      (k : ℝ) ≤ (6 * A + Real.log 4 + 1) * (L^a * Real.log L) ∧
      4 * q * (k + 1 : ℕ) * Real.exp (B + 2 * ℓ) * (1 + C)^k ≤ N := by
  let K : ℝ := 6 * A + Real.log 4 + 1
  let H : ℝ := Real.log 4 + K + 1 + 4 * A + K * A
  have hlog4 : 0 ≤ Real.log 4 := Real.log_nonneg (by norm_num)
  have hK : 0 ≤ K := by dsimp [K]; positivity
  have hscale : ∀ᶠ L : ℝ in atTop, H * (L^(a + d) * Real.log L) ≤ γ * L := by
    simpa only [add_zero, Real.rpow_one, mul_assoc] using
      eventually_mul_rpow_log_add_le_rpow (b := 1) (by norm_num) had hγ H 0
  filter_upwards [hscale,
    eventually_ge_atTop (Real.exp 1)] with L hbudget hL
  have hL1 : 1 ≤ L := le_trans (Real.one_le_exp (by norm_num : (0 : ℝ) ≤ 1)) hL
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL1
  have hlogL : 1 ≤ Real.log L := by
    simpa only [Real.log_exp] using Real.log_le_log (Real.exp_pos 1) hL
  let u := L^a * Real.log L
  let v := L^(a + d) * Real.log L
  have hu : 1 ≤ u := by
    dsimp [u]
    nlinarith [Real.one_le_rpow hL1 ha]
  have huv : u ≤ v := by
    exact mul_le_mul_of_nonneg_right
      (Real.rpow_le_rpow_of_exponent_le hL1 (by linarith)) (by linarith)
  have hv : 1 ≤ v := hu.trans huv
  have hmul : u * L^d = v := by
    dsimp [u, v]
    rw [Real.rpow_add hL0]
    ring
  intro ℓ B C q N hℓ hB hC hq hN hℓbound hBbound hqbound hCbound hNbound
  dsimp only
  let k := Nat.ceil (5 * ℓ + B + Real.log 4)
  have hk : 5 * ℓ + B + Real.log 4 ≤ (k : ℝ) := Nat.le_ceil _
  have hkupper : (k : ℝ) ≤ 5 * ℓ + B + Real.log 4 + 1 :=
    (Nat.ceil_lt_add_one (by positivity : 0 ≤ 5 * ℓ + B + Real.log 4)).le
  have hku : (k : ℝ) ≤ K * u := by
    dsimp [K]
    change ℓ ≤ A * u at hℓbound
    change B ≤ A * u at hBbound
    nlinarith [mul_le_mul_of_nonneg_left hu (show 0 ≤ Real.log 4 + 1 by positivity)]
  refine ⟨hk, hku, ?_⟩
  apply residue_size_condition_of_log hC hq hN k
  have hlogk : Real.log (k + 1 : ℕ) ≤ (K + 1) * v := by
    have hl := Real.log_le_self (by positivity : (0 : ℝ) ≤ (k + 1 : ℕ))
    have hk1 : ((k + 1 : ℕ) : ℝ) ≤ (K + 1) * u := by
      push_cast
      nlinarith
    exact hl.trans (hk1.trans (mul_le_mul_of_nonneg_left huv (by positivity)))
  have hlinear : B + 2 * ℓ ≤ 3 * A * v := by
    have hAv := mul_le_mul_of_nonneg_left huv hA.le
    change ℓ ≤ A * u at hℓbound
    change B ≤ A * u at hBbound
    nlinarith
  have hlogmass : (k : ℝ) * Real.log (1 + C) ≤ K * A * v := by
    calc
      _ ≤ (k : ℝ) * (A * L^d) := mul_le_mul_of_nonneg_left hCbound (Nat.cast_nonneg k)
      _ ≤ (K * u) * (A * L^d) := mul_le_mul_of_nonneg_right hku (by positivity)
      _ = K * A * v := by rw [← hmul]; ring
  have hlogconst : Real.log 4 ≤ Real.log 4 * v := by nlinarith
  change Real.log q ≤ A * v at hqbound
  change H * v ≤ γ * L at hbudget
  calc
    _ ≤ Real.log 4 * v + A * v + (K + 1) * v + 3 * A * v + K * A * v := by linarith
    _ = H * v := by dsimp [H]; ring
    _ ≤ γ * L := hbudget
    _ ≤ Real.log N := hNbound
end

section
open Finset
/-- The contribution of the primes that have no active visit in the path. -/
noncomputable def inactivePathResidueWeight {ι : Type*} (m : ι → ℕ) (S : Finset ι)
    (visits : Finset ℕ) (h : ∀ i, ℕ → ZMod (m i)) (η : ℕ → ℝ) (n : ℤ) : ℝ :=
  ∏ i ∈ S, ∏ j ∈ visits, (1 - η j * (if (n : ZMod (m i)) = h i j then 1 else 0))

theorem inactive_path_residue_weight_eq {ι : Type*} (m : ι → ℕ) (S : Finset ι)
    (visits : Finset ℕ) (h : ∀ i, ℕ → ZMod (m i)) (η : ℕ → ℝ) (n : ℤ) :
    inactivePathResidueWeight m S visits h η n =
      ∏ i ∈ S, (1 - visitExclusion visits (h i) η (n : ZMod (m i))) := by
  simp [inactivePathResidueWeight, visitExclusion]

/-- The local average of a never-active prime is one minus its exclusion
probability, including all repeated visits. -/
theorem inactive_path_local_average {ι : Type*} (m : ι → ℕ) [∀ i, NeZero (m i)]
    (visits : Finset ℕ) (h : ∀ i, ℕ → ZMod (m i)) (η : ℕ → ℝ) (i : ι) :
    ((∑ r : ZMod (m i), ∏ j ∈ visits, (1 - η j * (if r = h i j then 1 else 0))) / (m i : ℝ)) =
      1 - exclusionLocalMean m (fun i => visitExclusion visits (h i) η) i := by
  have hm : (m i : ℝ) ≠ 0 := by exact_mod_cast NeZero.ne (m i)
  simp only [exclusionLocalMean, visitExclusion, sum_sub_distrib,
    sum_const, card_univ, ZMod.card, nsmul_eq_mul, mul_one]
  field_simp
  ring

/-- The independent-residue expectation is the product of all local
averages, with uniform measure at each active and inactive modulus. -/
noncomputable def pathResidueExpectation {α β : Type*}
    (ma : α → ℕ) [∀ i, NeZero (ma i)] (mb : β → ℕ) [∀ i, NeZero (mb i)]
    (Sa : Finset α) (Sb : Finset β) (visits : Finset ℕ)
    (active : α → Finset ℕ) (ha : ∀ i, ℕ → ZMod (ma i)) (hb : ∀ i, ℕ → ZMod (mb i))
    (η : ℕ → ℝ) : ℝ :=
  (∏ i ∈ Sa, (∑ r, activeResidueWeight visits (active i) (ha i) η r) / (ma i : ℝ)) *
    ∏ i ∈ Sb, (∑ r, ∏ j ∈ visits, (1 - η j * (if r = hb i j then 1 else 0))) / (mb i : ℝ)

/-- For compatible active visits, the product-density main term in residue
replacement is exactly the independent-residue expectation. -/
theorem path_residue_expectation_eq {α β : Type*} [DecidableEq α] [DecidableEq β]
    (ma : α → ℕ) [∀ i, NeZero (ma i)] (mb : β → ℕ) [∀ i, NeZero (mb i)]
    (Sa : Finset α) (Sb : Finset β) (visits : Finset ℕ)
    (active : α → Finset ℕ) (ha : ∀ i, ℕ → ZMod (ma i)) (hb : ∀ i, ℕ → ZMod (mb i))
    (η : ℕ → ℝ) (anchor : α → ℕ)
    (hanchor : ∀ i ∈ Sa, anchor i ∈ active i)
    (hcompat : ∀ i ∈ Sa, ∀ j ∈ active i, ha i j = ha i (anchor i)) :
    pathResidueExpectation ma mb Sa Sb visits active ha hb η =
      ((∏ i ∈ Sa, activeVisitDamping visits (active i) (ha i) η (anchor i)) /
        ((∏ i ∈ Sa, ma i) : ℕ)) *
        ∏ i ∈ Sb, (1 - exclusionLocalMean mb (fun i => visitExclusion visits (hb i) η) i) := by
  unfold pathResidueExpectation
  have he : (∏ i ∈ Sa, (∑ r, activeResidueWeight visits (active i) (ha i) η r) / (ma i : ℝ)) =
      (∏ i ∈ Sa, activeVisitDamping visits (active i) (ha i) η (anchor i)) /
        ((∏ i ∈ Sa, ma i) : ℕ) := by
    rw [prod_natCast, ← prod_div_distrib]
    apply prod_congr rfl
    intro i hi
    rw [active_lifespan_residue_sum visits (active i) (ha i) η (anchor i) (hanchor i hi),
      if_pos (hcompat i hi)]
    rfl
  rw [he]
  congr 1
  apply prod_congr rfl
  intro i hi
  exact inactive_path_local_average mb visits hb η i

/-- Complete finite path replacement. Compatible active primes fix one
congruence; their deterministic damping is retained in both the main term
and the error. The hypotheses on degree and interval length are explicit. -/
theorem path_residue_replacement {α β : Type*} [DecidableEq α] [DecidableEq β]
    (ma : α → ℕ) [∀ i, NeZero (ma i)] (mb : β → ℕ) [∀ i, NeZero (mb i)]
    (Sa : Finset α) (Sb : Finset β) (visits : Finset ℕ)
    (active : α → Finset ℕ) (ha : ∀ i, ℕ → ZMod (ma i)) (hb : ∀ i, ℕ → ZMod (mb i))
    (η : ℕ → ℝ) (anchor : α → ℕ)
    (hma : (Sa : Set α).Pairwise (fun i j => Nat.Coprime (ma i) (ma j)))
    (hmb : Pairwise (fun i j => Nat.Coprime (mb i) (mb j)))
    (hcross : ∀ i ∈ Sa, ∀ j, Nat.Coprime (ma i) (mb j))
    (hanchor : ∀ i ∈ Sa, anchor i ∈ active i)
    (hcompat : ∀ i ∈ Sa, ∀ j ∈ active i, ha i j = ha i (anchor i))
    (hη : ∀ j ∈ visits, 0 ≤ η j ∧ η j ≤ 1)
    (hsmall : ∀ i ∈ Sb, exclusionLocalMean mb (fun i => visitExclusion visits (hb i) η) i ≤ 1 / 2)
    {N : ℕ} (hN : 0 < N) (z : ℤ) (k : ℕ) (B : ℝ)
    (hk : 5 * (∑ i ∈ Sb, exclusionLocalMean mb (fun i => visitExclusion visits (hb i) η) i) +
      B + Real.log 4 ≤ (k : ℝ))
    (hsize : 4 * ((∏ i ∈ Sa, ma i) : ℕ) * (k + 1 : ℕ) *
      Real.exp (B + 2 * ∑ i ∈ Sb, exclusionLocalMean mb (fun i => visitExclusion visits (hb i) η) i) *
        (1 + ∑ i ∈ Sb, exclusionLocalMass mb (fun i => visitExclusion visits (hb i) η) i)^k ≤ N) :
    |((∑ n ∈ Ico z (z + N),
        (∏ i ∈ Sa, activeResidueWeight visits (active i) (ha i) η (n : ZMod (ma i))) *
          inactivePathResidueWeight mb Sb visits hb η n) / (N : ℝ)) -
      pathResidueExpectation ma mb Sa Sb visits active ha hb η| ≤
      Real.exp (-B) * pathResidueExpectation ma mb Sa Sb visits active ha hb η := by
  rw [path_residue_expectation_eq ma mb Sa Sb visits active ha hb η anchor hanchor hcompat]
  let Q := ∏ i ∈ Sa, ma i
  have hQ : 0 < Q := prod_pos (fun i hi => Nat.pos_of_ne_zero (NeZero.ne (ma i)))
  let : NeZero Q := ⟨ne_of_gt hQ⟩
  have hQcop : ∀ j, Nat.Coprime Q (mb j) := fun j =>
    Nat.coprime_prod_left_iff.mpr (fun i hi => hcross i hi j)
  obtain ⟨c, hfactor⟩ := active_path_residue_factorization ma Sa visits active ha η anchor hma hanchor hcompat
  let D := ∏ i ∈ Sa, activeVisitDamping visits (active i) (ha i) η (anchor i)
  have hD : 0 ≤ D := prod_nonneg (fun i hi => active_visit_damping_nonneg visits (active i) (ha i) η (anchor i) hη)
  have he := conditioned_crt_damped_interval Q mb hmb hQcop (c : ZMod Q)
    (fun i => visitExclusion visits (hb i) η) Sb
    (fun i hi t => visit_exclusion_unit visits (hb i) η hη t) hsmall hN z k B D hD hk hsize
  have hsum : (∑ n ∈ Ico z (z + N),
        (∏ i ∈ Sa, activeResidueWeight visits (active i) (ha i) η (n : ZMod (ma i))) *
          inactivePathResidueWeight mb Sb visits hb η n) =
      D * (∑ n ∈ Ico z (z + N), (if (n : ZMod Q) = (c : ZMod Q) then 1 else 0) *
        ∏ i ∈ Sb, (1 - visitExclusion visits (hb i) η (n : ZMod (mb i)))) := by
    rw [mul_sum]
    apply sum_congr rfl
    intro n hn
    rw [hfactor n, inactive_path_residue_weight_eq]
    change (_ * D) * _ = D * (_ * _)
    ring
  rw [hsum]
  simpa only [Q, D, mul_div_right_comm] using he
end

section
open Finset
/-- The absolute local mass is bounded by the total visit weight, since
the grouped exclusion weight is nonnegative. -/
theorem visit_local_mass_le {ι : Type*} (m : ι → ℕ) [∀ i, NeZero (m i)]
    (visits : Finset ℕ) (h : ∀ i, ℕ → ZMod (m i)) (η : ℕ → ℝ)
    (hη : ∀ j ∈ visits, 0 ≤ η j ∧ η j ≤ 1) (i : ι) :
    exclusionLocalMass m (fun i => visitExclusion visits (h i) η) i ≤ ∑ j ∈ visits, η j := by
  unfold exclusionLocalMass
  have he : ∀ r, |visitExclusion visits (h i) η r| = visitExclusion visits (h i) η r :=
    fun r => abs_of_nonneg (visit_exclusion_unit visits (h i) η hη r).1
  simp_rw [he]
  exact visit_exclusion_mass visits (h i) η hη

/-- Summing the local means costs only the harmonic mass of the modulus set. -/
theorem visit_mean_sum_le_harmonic {ι : Type*} (m : ι → ℕ) [∀ i, NeZero (m i)]
    (S : Finset ι) (visits : Finset ℕ) (h : ∀ i, ℕ → ZMod (m i)) (η : ℕ → ℝ)
    (hη : ∀ j ∈ visits, 0 ≤ η j ∧ η j ≤ 1) :
    (∑ i ∈ S, exclusionLocalMean m (fun i => visitExclusion visits (h i) η) i) ≤
      (∑ j ∈ visits, η j) * ∑ i ∈ S, 1 / (m i : ℝ) := by
  calc
    _ ≤ ∑ i ∈ S, (∑ j ∈ visits, η j) / (m i : ℝ) :=
      sum_le_sum (fun i hi => visit_exclusion_mean_bound (m i) visits (h i) η hη)
    _ = _ := by rw [mul_sum]; apply sum_congr rfl; intro i hi; ring

/-- Summing absolute masses is bounded by the number of moduli times
the total visit weight. -/
theorem visit_mass_sum_le_card {ι : Type*} (m : ι → ℕ) [∀ i, NeZero (m i)]
    (S : Finset ι) (visits : Finset ℕ) (h : ∀ i, ℕ → ZMod (m i)) (η : ℕ → ℝ)
    (hη : ∀ j ∈ visits, 0 ≤ η j ∧ η j ≤ 1) :
    (∑ i ∈ S, exclusionLocalMass m (fun i => visitExclusion visits (h i) η) i) ≤
      (S.card : ℝ) * ∑ j ∈ visits, η j := by
  calc
    _ ≤ ∑ _i ∈ S, ∑ j ∈ visits, η j := sum_le_sum (fun i hi => visit_local_mass_le m visits h η hη i)
    _ = _ := by simp

/-- A modulus exceeding twice the total visit weight gives a local
exclusion probability at most one half. -/
theorem visit_mean_le_half {ι : Type*} (m : ι → ℕ) [∀ i, NeZero (m i)]
    (visits : Finset ℕ) (h : ∀ i, ℕ → ZMod (m i)) (η : ℕ → ℝ)
    (hη : ∀ j ∈ visits, 0 ≤ η j ∧ η j ≤ 1) (i : ι)
    (hm : 2 * (∑ j ∈ visits, η j) ≤ (m i : ℝ)) :
    exclusionLocalMean m (fun i => visitExclusion visits (h i) η) i ≤ 1 / 2 := by
  refine (visit_exclusion_mean_bound (m i) visits (h i) η hη).trans ?_
  apply (div_le_iff₀ (by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne (m i)))).2
  linarith

/-- Disjoint prime groups add their harmonic masses without multiplicity. -/
theorem prime_group_harmonic_bound {G : Type*} [DecidableEq G]
    (groups : Finset G) (P : G → Finset ℕ)
    (hdisj : (groups : Set G).PairwiseDisjoint P) (V : ℝ)
    (hV : ∀ g ∈ groups, (∑ p ∈ P g, 1 / (p : ℝ)) ≤ V) :
    (∑ p ∈ groups.biUnion P, 1 / (p : ℝ)) ≤ (groups.card : ℝ) * V := by
  rw [sum_biUnion hdisj]
  calc
    _ ≤ ∑ _g ∈ groups, V := sum_le_sum hV
    _ = _ := by simp

/-- A subfamily of a prime pool has no greater harmonic mass. -/
theorem prime_subpool_harmonic_bound {P S : Finset ℕ} (hS : S ⊆ P) :
    (∑ p ∈ S, 1 / (p : ℝ)) ≤ ∑ p ∈ P, 1 / (p : ℝ) := by
  exact sum_le_sum_of_subset_of_nonneg hS (fun p hp hnot => by positivity)

/-- Distinct positive integers bounded by `exp H` number at most `exp H`. -/
theorem prime_pool_card_le_exp (P : Finset ℕ) (H : ℝ)
    (hpos : ∀ p ∈ P, 0 < p) (hmax : ∀ p ∈ P, (p : ℝ) ≤ Real.exp H) :
    (P.card : ℝ) ≤ Real.exp H := by
  have hc : (P.card : ℝ) ≤ (⌊Real.exp H⌋₊ : ℝ) := by
    exact_mod_cast card_positive_nat_finset_le_floor hpos hmax
  exact hc.trans (Nat.floor_le (Real.exp_pos H).le)

/-- An injective family of positive integer moduli inherits the
cardinality bound for its image. -/
theorem moduli_card_le_exp {ι : Type*} [DecidableEq ι] (m : ι → ℕ)
    (S : Finset ι) (H : ℝ) (hinj : Set.InjOn m S)
    (hpos : ∀ i ∈ S, 0 < m i) (hmax : ∀ i ∈ S, (m i : ℝ) ≤ Real.exp H) :
    (S.card : ℝ) ≤ Real.exp H := by
  have he := prime_pool_card_le_exp (S.image m) H
    (by intro p hp; obtain ⟨i, hi, rfl⟩ := mem_image.mp hp; exact hpos i hi)
    (by intro p hp; obtain ⟨i, hi, rfl⟩ := mem_image.mp hp; exact hmax i hi)
  simpa only [card_image_of_injOn hinj] using he

/-- Indexed modulus products satisfy the same logarithmic estimate, even
without injectivity of the indexing map. -/
theorem modulus_product_log_bound {ι : Type*} (m : ι → ℕ) (S : Finset ι) (H : ℝ)
    (hpos : ∀ i ∈ S, 0 < m i) (hmax : ∀ i ∈ S, (m i : ℝ) ≤ Real.exp H) :
    Real.log ((∏ i ∈ S, m i : ℕ) : ℝ) ≤ (S.card : ℝ) * H := by
  have hp : ∀ i ∈ S, (m i : ℝ) ≠ 0 := fun i hi => ne_of_gt (by exact_mod_cast hpos i hi)
  rw [Nat.cast_prod, Real.log_prod hp]
  calc
    _ ≤ ∑ _i ∈ S, H := by
      apply sum_le_sum
      intro i hi
      have ht := Real.log_le_log (by exact_mod_cast hpos i hi) (hmax i hi)
      simpa only [Real.log_exp] using ht
    _ = _ := by simp

/-- The logarithm of a product of distinct active moduli is bounded
by their count times the uniform logarithmic upper bound. -/
theorem active_modulus_log_bound (P : Finset ℕ) (H : ℝ)
    (hpos : ∀ p ∈ P, 0 < p) (hmax : ∀ p ∈ P, (p : ℝ) ≤ Real.exp H) :
    Real.log ((∏ p ∈ P, p : ℕ) : ℝ) ≤ (P.card : ℝ) * H := by
  have hp : ∀ p ∈ P, (p : ℝ) ≠ 0 := fun p hp => ne_of_gt (by exact_mod_cast hpos p hp)
  rw [Nat.cast_prod, Real.log_prod hp]
  calc
    _ ≤ ∑ _p ∈ P, H := by
      apply sum_le_sum
      intro p hp
      have ht := Real.log_le_log (by exact_mod_cast hpos p hp) (hmax p hp)
      simpa only [Real.log_exp] using ht
    _ = _ := by simp

/-- The distinct active primes used over all visits are bounded by the
sum of the per-visit mark counts. -/
theorem active_pool_card_bound (visits : Finset ℕ) (marked : ℕ → Finset ℕ) (K : ℕ)
    (hK : ∀ j ∈ visits, (marked j).card ≤ K) :
    (visits.biUnion marked).card ≤ visits.card * K := by
  calc
    _ ≤ ∑ j ∈ visits, (marked j).card := card_biUnion_le
    _ ≤ ∑ _j ∈ visits, K := sum_le_sum hK
    _ = _ := by simp

/-- Marks chosen in every group and at every visit use at most the
number of visits times the number of groups times the slot count. -/
theorem grouped_active_pool_card_bound {G : Type*} [DecidableEq G]
    (visits : Finset ℕ) (groups : Finset G) (marked : ℕ → G → Finset ℕ) (M : ℕ)
    (hM : ∀ j ∈ visits, ∀ g ∈ groups, (marked j g).card ≤ M) :
    (visits.biUnion (fun j => groups.biUnion (marked j))).card ≤
      visits.card * (groups.card * M) := by
  apply active_pool_card_bound
  intro j hj
  calc
    _ ≤ ∑ g ∈ groups, (marked j g).card := card_biUnion_le
    _ ≤ ∑ _g ∈ groups, M := sum_le_sum (hM j hj)
    _ = _ := by simp
end

section
open Filter Finset
open scoped Topology
/-- Every fixed real power is negligible relative to an exponential of a
positive power. -/
theorem tendsto_rpow_div_exp_rpow (a : ℝ) {c : ℝ} (hc : 0 < c) :
    Tendsto (fun L : ℝ => L^a / Real.exp (L^c)) atTop (𝓝 0) := by
  have he := ((isLittleO_rpow_exp_atTop (a / c)).tendsto_div_nhds_zero).comp
    (tendsto_rpow_atTop hc)
  apply he.congr'
  filter_upwards [eventually_gt_atTop (0 : ℝ)] with L hL
  simp only [Function.comp_apply]
  rw [← Real.rpow_mul hL.le]
  congr 2
  field_simp

/-- The lower end of a prime pool eventually dominates any fixed power
bound for the total visit weight. -/
theorem eventually_mul_rpow_le_exp_rpow (a A : ℝ) {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, A * L^a ≤ Real.exp (L^c) := by
  have he := (tendsto_rpow_div_exp_rpow a hc).const_mul A
  have hz : A * (0 : ℝ) < 1 := by simp
  filter_upwards [he.eventually_le_const hz] with L hL
  have hd : 0 < Real.exp (L^c) := Real.exp_pos _
  have hh : A * L^a / Real.exp (L^c) ≤ 1 := by
    simpa only [mul_div_assoc] using hL
  simpa only [one_mul] using (div_le_iff₀ hd).mp hh

/-- Taking a logarithm removes the exponential size of the complete
prime pool. The polynomial visit factor only changes a lower-order term. -/
theorem eventually_log_polynomial_exp_bound {a d A : ℝ}
    (ha : 0 ≤ a) (hd : 0 < d) (hA : 0 ≤ A) :
    ∀ᶠ L : ℝ in atTop, ∀ C : ℝ, 0 ≤ C → C ≤ A * L^a * Real.exp (L^d) →
      Real.log (1 + C) ≤ 2 * L^d := by
  have he := eventually_mul_rpow_log_add_le_rpow (a := 0) hd hd
    (show (0 : ℝ) < 1 by norm_num) a (Real.log (1 + A))
  filter_upwards [he, eventually_ge_atTop (1 : ℝ)] with L hlog hL
  have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one hL
  have hLa : 1 ≤ L^a := Real.one_le_rpow hL ha
  have hexp : 1 ≤ Real.exp (L^d) := Real.one_le_exp (Real.rpow_nonneg hLpos.le d)
  have hprod : 1 ≤ L^a * Real.exp (L^d) := by nlinarith
  intro C hC hbound
  have hupper : 1 + C ≤ (1 + A) * L^a * Real.exp (L^d) := by nlinarith
  calc
    Real.log (1 + C) ≤ Real.log ((1 + A) * L^a * Real.exp (L^d)) :=
      Real.log_le_log (by positivity) hupper
    _ = Real.log (1 + A) + a * Real.log L + L^d := by
      rw [Real.log_mul (by positivity) (ne_of_gt (Real.exp_pos _)),
        Real.log_mul (by positivity) (ne_of_gt (Real.rpow_pos_of_pos hLpos a)),
        Real.log_rpow hLpos, Real.log_exp]
    _ ≤ 2 * L^d := by simp only [Real.rpow_zero, mul_one, one_mul] at hlog; linarith

/-- The prime-pool range, harmonic mass, and active-modulus bound give
all numerical hypotheses needed by conditioned residue replacement.
The threshold is independent of the individual path and its residues. -/
theorem eventually_prime_pool_precision {a c d A γ : ℝ}
    (ha : 0 ≤ a) (hc : 0 < c) (hd : 0 < d) (had : a + d < 1)
    (hA : 0 < A) (hγ : 0 < γ) :
    ∀ᶠ L : ℝ in atTop, ∀ t H ℓ B C q N : ℝ,
      0 ≤ t → 0 ≤ H → 0 ≤ ℓ → 0 ≤ B → 0 ≤ C → 0 < q → 0 < N →
      t ≤ A * L^a → H ≤ A * Real.log L → ℓ ≤ t * H →
      B ≤ A * (L^a * Real.log L) → C ≤ t * Real.exp (L^d) →
      Real.log q ≤ A * (L^(a + d) * Real.log L) → γ * L ≤ Real.log N →
      let k := Nat.ceil (5 * ℓ + B + Real.log 4)
      2 * t ≤ Real.exp (L^c) ∧
      5 * ℓ + B + Real.log 4 ≤ (k : ℝ) ∧
      (k : ℝ) ≤ (6 * (A^2 + A + 2) + Real.log 4 + 1) * (L^a * Real.log L) ∧
      4 * q * (k + 1 : ℕ) * Real.exp (B + 2 * ℓ) * (1 + C)^k ≤ N := by
  let K : ℝ := A^2 + A + 2
  have hK : 0 < K := by dsimp [K]; positivity
  have hAK : A ≤ K := by dsimp [K]; nlinarith [sq_nonneg A]
  have hA2K : A^2 ≤ K := by dsimp [K]; linarith
  have h2K : 2 ≤ K := by dsimp [K]; nlinarith [sq_nonneg A]
  filter_upwards [eventually_mul_rpow_le_exp_rpow a (2 * A) hc,
    eventually_log_polynomial_exp_bound ha hd hA.le,
    eventually_residue_precision_parameters ha hd.le had hK hγ,
    eventually_ge_atTop (1 : ℝ)] with L hmin hmass hprecision hL
  have hL0 : 0 ≤ L := zero_le_one.trans hL
  have hlog : 0 ≤ Real.log L := Real.log_nonneg hL
  have hu : 0 ≤ L^a * Real.log L := mul_nonneg (Real.rpow_nonneg hL0 a) hlog
  have hv : 0 ≤ L^(a + d) * Real.log L := mul_nonneg (Real.rpow_nonneg hL0 (a + d)) hlog
  intro t H ℓ B C q N ht hH hℓ hB hC hq hN htbound hHbound hℓbound hBbound hCbound hqbound hNbound
  have hmin' : 2 * t ≤ Real.exp (L^c) := by nlinarith
  have hℓ' : ℓ ≤ K * (L^a * Real.log L) := by
    calc
      ℓ ≤ t * H := hℓbound
      _ ≤ (A * L^a) * (A * Real.log L) := mul_le_mul htbound hHbound hH (by positivity)
      _ = A^2 * (L^a * Real.log L) := by ring
      _ ≤ K * (L^a * Real.log L) := mul_le_mul_of_nonneg_right hA2K hu
  have hB' : B ≤ K * (L^a * Real.log L) :=
    hBbound.trans (mul_le_mul_of_nonneg_right hAK hu)
  have hq' : Real.log q ≤ K * (L^(a + d) * Real.log L) :=
    hqbound.trans (mul_le_mul_of_nonneg_right hAK hv)
  have hC' : Real.log (1 + C) ≤ K * L^d := by
    apply (hmass C hC ?_).trans (mul_le_mul_of_nonneg_right h2K (Real.rpow_nonneg hL0 d))
    exact hCbound.trans (mul_le_mul_of_nonneg_right htbound (Real.exp_pos _).le)
  exact ⟨hmin', hprecision ℓ B C q N hℓ hB hC hq hN hℓ' hB' hq' hC' hNbound⟩
end

section
open Filter Finset
open scoped Topology
/-- An inconsistent active prime has zero independent-residue expectation. -/
theorem path_residue_expectation_incompatible {α β : Type*} [DecidableEq α]
    (ma : α → ℕ) [∀ i, NeZero (ma i)] (mb : β → ℕ) [∀ i, NeZero (mb i)]
    (Sa : Finset α) (Sb : Finset β) (visits : Finset ℕ)
    (active : α → Finset ℕ) (ha : ∀ i, ℕ → ZMod (ma i)) (hb : ∀ i, ℕ → ZMod (mb i))
    (η : ℕ → ℝ) {i : α} (hi : i ∈ Sa) {a z : ℕ}
    (hfirst : a ∈ active i) (hlast : z ∈ active i) (hne : ha i a ≠ ha i z) :
    pathResidueExpectation ma mb Sa Sb visits active ha hb η = 0 := by
  have hz : (∏ j ∈ Sa, (∑ r, activeResidueWeight visits (active j) (ha j) η r) / (ma j : ℝ)) = 0 := by
    apply prod_eq_zero hi
    have hr : ∀ r, activeResidueWeight visits (active i) (ha i) η r = 0 :=
      active_residue_weight_incompatible visits (active i) (ha i) η hfirst hlast hne
    simp only [hr, sum_const_zero, zero_div]
  unfold pathResidueExpectation
  rw [hz, zero_mul]

/-- Prime-pool bounds imply exponentially accurate residue replacement,
uniformly over the residues, marks, damping, and integer interval. The
active visits may be incompatible; in that case both sides vanish exactly. -/
theorem eventually_path_replacement_of_prime_bounds {a c d A γ : ℝ} (ha0 : 0 ≤ a) (hc : 0 < c) (hd : 0 < d)
    (had : a + d < 1) (hA : 0 < A) (hγ : 0 < γ) :
    ∀ᶠ L : ℝ in atTop, ∀ (α β : Type) [DecidableEq α] [DecidableEq β]
      (ma : α → ℕ) [∀ i, NeZero (ma i)] (mb : β → ℕ) [∀ i, NeZero (mb i)]
      (Sa : Finset α) (Sb : Finset β) (visits : Finset ℕ)
      (active : α → Finset ℕ) (ha : ∀ i, ℕ → ZMod (ma i)) (hb : ∀ i, ℕ → ZMod (mb i))
      (η : ℕ → ℝ) (anchor : α → ℕ) (N : ℕ) (z : ℤ) (B : ℝ),
      (Sa : Set α).Pairwise (fun i j => Nat.Coprime (ma i) (ma j)) →
      Pairwise (fun i j => Nat.Coprime (mb i) (mb j)) →
      (∀ i ∈ Sa, ∀ j, Nat.Coprime (ma i) (mb j)) →
      (∀ i ∈ Sa, anchor i ∈ active i) →
      (∀ j ∈ visits, 0 ≤ η j ∧ η j ≤ 1) →
      (∑ j ∈ visits, η j) ≤ A * L^a →
      (Sb.card : ℝ) ≤ Real.exp (L^d) →
      (∑ i ∈ Sb, 1 / (mb i : ℝ)) ≤ A * Real.log L →
      (∀ i ∈ Sb, Real.exp (L^c) ≤ (mb i : ℝ)) →
      (Sa.card : ℝ) ≤ A * (L^a * Real.log L) →
      (∀ i ∈ Sa, (ma i : ℝ) ≤ Real.exp (L^d)) →
      0 < N → γ * L ≤ Real.log (N : ℝ) →
      0 ≤ B → B ≤ A * (L^a * Real.log L) →
      |((∑ n ∈ Ico z (z + N),
          (∏ i ∈ Sa, activeResidueWeight visits (active i) (ha i) η (n : ZMod (ma i))) *
            inactivePathResidueWeight mb Sb visits hb η n) / (N : ℝ)) -
        pathResidueExpectation ma mb Sa Sb visits active ha hb η| ≤
        Real.exp (-B) * pathResidueExpectation ma mb Sa Sb visits active ha hb η := by
  filter_upwards [eventually_prime_pool_precision ha0 hc hd had hA hγ,
    eventually_ge_atTop (1 : ℝ)] with L hprecision hL
  intro α β _ _ ma _ mb _ Sa Sb visits active ha hb η anchor N z B hma hmb hcross hanchor hη
    htbound hcount hHbound hmin hactive hmax hN hNbound hB hBbound
  have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one hL
  let t := ∑ j ∈ visits, η j
  let H := ∑ i ∈ Sb, 1 / (mb i : ℝ)
  let ℓ := ∑ i ∈ Sb, exclusionLocalMean mb (fun i => visitExclusion visits (hb i) η) i
  let C := ∑ i ∈ Sb, exclusionLocalMass mb (fun i => visitExclusion visits (hb i) η) i
  let Q := ∏ i ∈ Sa, ma i
  have ht : 0 ≤ t := sum_nonneg (fun j hj => (hη j hj).1)
  have hH : 0 ≤ H := sum_nonneg (fun i hi => by positivity)
  have hℓ : 0 ≤ ℓ := sum_nonneg (fun i hi =>
    (exclusion_local_mean_unit mb (fun i => visitExclusion visits (hb i) η) i
      (visit_exclusion_unit visits (hb i) η hη)).1)
  have hC : 0 ≤ C := by
    apply sum_nonneg
    intro i hi
    exact sum_nonneg (fun r hr => abs_nonneg _)
  have hQ : 0 < Q := prod_pos (fun i hi => Nat.pos_of_ne_zero (NeZero.ne (ma i)))
  have hℓbound : ℓ ≤ t * H := visit_mean_sum_le_harmonic mb Sb visits hb η hη
  have hCbound : C ≤ t * Real.exp (L^d) := by
    calc
      C ≤ (Sb.card : ℝ) * t := visit_mass_sum_le_card mb Sb visits hb η hη
      _ ≤ Real.exp (L^d) * t := mul_le_mul_of_nonneg_right hcount ht
      _ = _ := mul_comm _ _
  have hqbound : Real.log (Q : ℝ) ≤ A * (L^(a + d) * Real.log L) := by
    calc
      _ ≤ (Sa.card : ℝ) * L^d := modulus_product_log_bound ma Sa (L^d)
        (fun i hi => Nat.pos_of_ne_zero (NeZero.ne (ma i))) hmax
      _ ≤ (A * (L^a * Real.log L)) * L^d :=
        mul_le_mul_of_nonneg_right hactive (Real.rpow_nonneg hLpos.le d)
      _ = _ := by rw [Real.rpow_add hLpos]; ring
  obtain ⟨hsmall, hk, _hkupper, hsize⟩ := hprecision t H ℓ B C (Q : ℝ) (N : ℝ)
    ht hH hℓ hB hC (by exact_mod_cast hQ) (by exact_mod_cast hN)
    htbound hHbound hℓbound hBbound hCbound hqbound hNbound
  by_cases hcompat : ∀ i ∈ Sa, ∀ j ∈ active i, ha i j = ha i (anchor i)
  · apply path_residue_replacement ma mb Sa Sb visits active ha hb η anchor hma hmb hcross
      hanchor hcompat hη _ hN z (Nat.ceil (5 * ℓ + B + Real.log 4)) B hk hsize
    intro i hi
    apply visit_mean_le_half mb visits hb η hη i
    exact hsmall.trans (hmin i hi)
  · push Not at hcompat
    obtain ⟨i, hi, j, hj, hne⟩ := hcompat
    have hexpect := path_residue_expectation_incompatible ma mb Sa Sb visits active ha hb η hi
      hj (hanchor i hi) hne
    have hzero : ∀ n : ℤ, (∏ j ∈ Sa,
        activeResidueWeight visits (active j) (ha j) η (n : ZMod (ma j))) = 0 :=
      active_path_residue_incompatible ma Sa visits active ha η hi hj (hanchor i hi) hne
    simp only [hzero, zero_mul, sum_const_zero, zero_div, hexpect, sub_self, abs_zero, mul_zero, le_refl]
end

section
open Finset
/-- Restricting an independent tuple law to distinct labels can only
reduce its total mass. This supplies the initial-list normalization. -/
theorem distinct_tuple_weight_bound {P : Type*} [Fintype P] [DecidableEq P]
    (w : P → ℝ) (hw : ∀ p, 0 ≤ w p) (M : ℕ) :
    (∑ f ∈ (univ : Finset (Fin M → P)).filter Function.Injective, ∏ i, w (f i)) ≤
      (∑ p, w p)^M := by
  classical
  calc
    _ ≤ ∑ f : Fin M → P, ∏ i, w (f i) :=
      sum_le_sum_of_subset_of_nonneg (filter_subset _ _) (fun f hf hnot => prod_nonneg (fun i hi => hw (f i)))
    _ = _ := by
      simpa only [Fintype.piFinset_univ] using (sum_pow' (univ : Finset P) w M).symm

/-- If the label weights total `V`, dividing each ordered-list weight
by `V^M` bounds the total distinct-list mass by one. -/
theorem normalized_distinct_tuple_weight_bound {P : Type*} [Fintype P] [DecidableEq P]
    (w : P → ℝ) (hw : ∀ p, 0 ≤ w p) {V : ℝ} (hV : 0 < V)
    (hsum : ∑ p, w p = V) (M : ℕ) :
    (∑ f ∈ (univ : Finset (Fin M → P)).filter Function.Injective,
      (∏ i, w (f i)) / V^M) ≤ 1 := by
  classical
  rw [← sum_div, div_le_one (pow_pos hV M)]
  simpa only [hsum] using distinct_tuple_weight_bound w hw M

/-- Relative errors remain controlled when the corresponding path terms
are combined with arbitrary signed coefficients. -/
theorem signed_path_error_bound {P : Type*} (paths : Finset P)
    (c actual expected : P → ℝ) (ε : ℝ)
    (herror : ∀ p ∈ paths, |actual p - expected p| ≤ ε * expected p) :
    |(∑ p ∈ paths, c p * actual p) - ∑ p ∈ paths, c p * expected p| ≤
      ε * ∑ p ∈ paths, |c p| * expected p := by
  rw [← sum_sub_distrib]
  calc
    _ ≤ ∑ p ∈ paths, |c p * actual p - c p * expected p| := abs_sum_le_sum_abs _ _
    _ = ∑ p ∈ paths, |c p| * |actual p - expected p| := by
      apply sum_congr rfl
      intro p hp
      rw [← mul_sub, abs_mul]
    _ ≤ ∑ p ∈ paths, |c p| * (ε * expected p) :=
      sum_le_sum (fun p hp => mul_le_mul_of_nonneg_left (herror p hp) (abs_nonneg _))
    _ = _ := by rw [mul_sum]; apply sum_congr rfl; intro p hp; ring

/-- The same estimate applies to complex coefficients in the operator
expansion while the path residue factors remain real. -/
theorem complex_path_error_bound {P : Type*} (paths : Finset P)
    (c : P → ℂ) (actual expected : P → ℝ) (ε : ℝ)
    (herror : ∀ p ∈ paths, |actual p - expected p| ≤ ε * expected p) :
    ‖(∑ p ∈ paths, c p * (actual p : ℂ)) - ∑ p ∈ paths, c p * (expected p : ℂ)‖ ≤
      ε * ∑ p ∈ paths, ‖c p‖ * expected p := by
  rw [← sum_sub_distrib]
  calc
    _ ≤ ∑ p ∈ paths, ‖c p * (actual p : ℂ) - c p * (expected p : ℂ)‖ := norm_sum_le _ _
    _ = ∑ p ∈ paths, ‖c p‖ * |actual p - expected p| := by
      apply sum_congr rfl
      intro p hp
      rw [← mul_sub, norm_mul, ← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs]
    _ ≤ ∑ p ∈ paths, ‖c p‖ * (ε * expected p) :=
      sum_le_sum (fun p hp => mul_le_mul_of_nonneg_left (herror p hp) (norm_nonneg _))
    _ = _ := by rw [mul_sum]; apply sum_congr rfl; intro p hp; ring

/-- A polynomial-per-step mass bound is absorbed by increasing the
constant in the exponential residue error. -/
theorem summed_path_exponential_error {P : Type*} (paths : Finset P)
    (c actual expected : P → ℝ) {L n E C : ℝ}
    (herror : ∀ p ∈ paths, |actual p - expected p| ≤
      Real.exp (-(E + C) * n * Real.log L) * expected p)
    (hmass : (∑ p ∈ paths, |c p| * expected p) ≤ Real.exp (C * n * Real.log L)) :
    |(∑ p ∈ paths, c p * actual p) - ∑ p ∈ paths, c p * expected p| ≤
      Real.exp (-E * n * Real.log L) := by
  calc
    _ ≤ Real.exp (-(E + C) * n * Real.log L) * ∑ p ∈ paths, |c p| * expected p :=
      signed_path_error_bound paths c actual expected _ herror
    _ ≤ Real.exp (-(E + C) * n * Real.log L) * Real.exp (C * n * Real.log L) :=
      mul_le_mul_of_nonneg_left hmass (Real.exp_pos _).le
    _ = _ := by rw [← Real.exp_add]; congr 1; ring
end

section
open Finset
/-- Damping once for every successful hit is the corresponding product
of affine indicator factors. -/
theorem damping_product_power {P : Type*} (S : Finset P)
    (hit : P → Prop) [DecidablePred hit] (q : ℝ) :
    (∏ p ∈ S, (1 - (1 - q) * (if hit p then 1 else 0))) = q^(S.filter hit).card := by
  have he : ∀ p, (1 - (1 - q) * (if hit p then 1 else 0)) = if hit p then q else 1 := by
    intro p
    by_cases h : hit p <;> simp [h]
  simp only [he, prod_ite, prod_const, one_pow, mul_one]

/-- A local active residue weight can be read as a product over visits. -/
theorem active_residue_weight_as_visit_product {R : Type*} [DecidableEq R]
    (visits active : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ) (r : R)
    (hactive : active ⊆ visits) :
    activeResidueWeight visits active h η r =
      ∏ j ∈ visits, (if j ∈ active then (if r = h j then 1 else 0)
        else 1 - η j * (if r = h j then 1 else 0)) := by
  have hfilter : visits.filter (fun j => j ∈ active) = active := by
    ext j
    simp only [mem_filter]
    exact ⟨And.right, fun hj => ⟨hactive hj, hj⟩⟩
  have hnot : visits.filter (fun j => j ∉ active) = visits \ active := by
    ext j
    simp only [mem_filter, mem_sdiff]
  rw [prod_ite, hfilter, hnot]
  rfl

/-- At a vertex, active divisibility indicators and damping for the
other group primes equal a single product over the whole prime pool. -/
theorem vertex_residue_factor_as_product {P : Type*} [DecidableEq P]
    (pool marked : Finset P) (hit : P → Prop) [DecidablePred hit]
    (q : ℝ) (hmarked : marked ⊆ pool) :
    (∏ p ∈ marked, (if hit p then (1 : ℝ) else 0)) *
        q^((pool \ marked).filter hit).card =
      ∏ p ∈ pool, (if p ∈ marked then (if hit p then 1 else 0)
        else 1 - (1 - q) * (if hit p then 1 else 0)) := by
  have hfilter : pool.filter (fun p => p ∈ marked) = marked := by
    ext p
    simp only [mem_filter]
    exact ⟨And.right, fun hp => ⟨hmarked hp, hp⟩⟩
  have hnot : pool.filter (fun p => p ∉ marked) = pool \ marked := by
    ext p
    simp only [mem_filter, mem_sdiff]
  symm
  rw [prod_ite, hfilter, hnot, damping_product_power]

/-- Regrouping the physical path factor by prime gives precisely the
local active-residue weights used by residue replacement. -/
theorem physical_path_residue_factorization {P : Type*} [DecidableEq P]
    (m : P → ℕ) (pool : Finset P) (visits : Finset ℕ)
    (marked : ℕ → Finset P) (h : ∀ p, ℕ → ZMod (m p)) (q : ℕ → ℝ) (n : ℤ)
    (hmarked : ∀ j ∈ visits, marked j ⊆ pool) :
    (∏ j ∈ visits,
      (∏ p ∈ marked j, (if (n : ZMod (m p)) = h p j then (1 : ℝ) else 0)) *
        (q j)^((pool \ marked j).filter (fun p => (n : ZMod (m p)) = h p j)).card) =
      ∏ p ∈ pool, activeResidueWeight visits
        (visits.filter (fun j => p ∈ marked j)) (h p) (fun j => 1 - q j) (n : ZMod (m p)) := by
  calc
    _ = ∏ j ∈ visits, ∏ p ∈ pool,
        (if p ∈ marked j then (if (n : ZMod (m p)) = h p j then 1 else 0)
        else 1 - (1 - q j) * (if (n : ZMod (m p)) = h p j then 1 else 0)) := by
      apply prod_congr rfl
      intro j hj
      exact vertex_residue_factor_as_product pool (marked j)
        (fun p => (n : ZMod (m p)) = h p j) (q j) (hmarked j hj)
    _ = _ := by
      rw [prod_comm]
      apply prod_congr rfl
      intro p hp
      rw [active_residue_weight_as_visit_product visits _ (h p) _ _ (filter_subset _ _)]
      apply prod_congr rfl
      intro j hj
      simp only [mem_filter, hj, true_and]

/-- A shifted divisibility condition is the residue constraint used in
the local path factors. This also holds for a zero integer offset. -/
theorem shifted_congruence_iff_dvd (m : ℕ) (n h : ℤ) :
    (n : ZMod m) = -(h : ZMod m) ↔ (m : ℤ) ∣ n + h := by
  rw [eq_neg_iff_add_eq_zero, ← Int.cast_add, ZMod.intCast_zmod_eq_zero_iff_dvd]

/-- The divisibility-and-damping expression in the physical path
expansion has exactly the grouped-residue form, including repeated offsets. -/
theorem physical_path_divisibility_factorization {P : Type*} [DecidableEq P]
    (m : P → ℕ) (pool : Finset P) (visits : Finset ℕ)
    (marked : ℕ → Finset P) (offset : ℕ → ℤ) (q : ℕ → ℝ) (n : ℤ)
    (hmarked : ∀ j ∈ visits, marked j ⊆ pool) :
    (∏ j ∈ visits,
      (∏ p ∈ marked j, (if (m p : ℤ) ∣ n + offset j then (1 : ℝ) else 0)) *
        (q j)^((pool \ marked j).filter (fun p => (m p : ℤ) ∣ n + offset j)).card) =
      ∏ p ∈ pool, activeResidueWeight visits
        (visits.filter (fun j => p ∈ marked j)) (fun j => -(offset j : ZMod (m p)))
        (fun j => 1 - q j) (n : ZMod (m p)) := by
  have he := physical_path_residue_factorization m pool visits marked
    (fun p j => -(offset j : ZMod (m p))) q n hmarked
  simpa only [shifted_congruence_iff_dvd] using he
end

section
open Finset
/-- A single binomial-geometric term is bounded by its positive total sum. -/
theorem damped_choose_bound {ρ : ℝ} (hρ0 : 0 ≤ ρ) (hρ1 : ρ < 1) (z t : ℕ) :
    ((z + t).choose t : ℝ) * ρ^z ≤ 1 / (1 - ρ)^(t + 1) := by
  have hnorm : ‖ρ‖ < 1 := by simpa only [Real.norm_eq_abs, abs_of_nonneg hρ0] using hρ1
  have hs := hasSum_choose_mul_geometric_of_norm_lt_one t hnorm
  have hb := sum_le_hasSum ({z} : Finset ℕ)
    (fun n hn => show (0 : ℝ) ≤ ((n + t).choose t : ℝ) * ρ^n by positivity) hs
  simpa only [sum_singleton] using hb

/-- The ordered-list count with geometric damping has an explicit
bound independent of the excess number of available labels. -/
theorem damped_descFactorial_bound {ρ : ℝ} (hρ0 : 0 ≤ ρ) (hρ1 : ρ < 1) (z t : ℕ) :
    ((z + t).descFactorial t : ℝ) * ρ^z ≤ (t.factorial : ℝ) / (1 - ρ)^(t + 1) := by
  rw [Nat.descFactorial_eq_factorial_mul_choose, Nat.cast_mul, mul_assoc]
  simpa only [mul_one_div] using
    mul_le_mul_of_nonneg_left (damped_choose_bound hρ0 hρ1 z t) (Nat.cast_nonneg t.factorial)

/-- A single constant works for every unshared-slot count up to a fixed
bound and for every group harmonic mass bounded below by a positive value. -/
theorem uniform_damped_descFactorial_bound {ρ v V : ℝ}
    (hρ0 : 0 ≤ ρ) (hρ1 : ρ < 1) (hv : 0 < v) (hV : v ≤ V)
    (T z t : ℕ) (ht : t ≤ T) :
    (((z + t).descFactorial t : ℝ) * ρ^z) / V^t ≤
      ((T.factorial : ℝ) * (max 1 (1 / v))^T) / (1 - ρ)^(T + 1) := by
  have hVpos : 0 < V := hv.trans_le hV
  have hden : 0 < 1 - ρ := sub_pos.mpr hρ1
  have hvInv : 1 / V ≤ max 1 (1 / v) :=
    (one_div_le_one_div_of_le hv hV).trans (le_max_right _ _)
  have hInv : (1 / V)^t ≤ (max 1 (1 / v))^T := by
    exact (pow_le_pow_left₀ (by positivity) hvInv t).trans
      (pow_le_pow_right₀ (le_max_left _ _) ht)
  have hfac : (t.factorial : ℝ) ≤ (T.factorial : ℝ) := by exact_mod_cast Nat.factorial_le ht
  have hbase : 1 ≤ 1 / (1 - ρ) := (one_le_div hden).2 (by linarith)
  have hpow : (1 / (1 - ρ))^(t + 1) ≤ (1 / (1 - ρ))^(T + 1) :=
    pow_le_pow_right₀ hbase (Nat.add_le_add_right ht 1)
  calc
    _ ≤ ((t.factorial : ℝ) / (1 - ρ)^(t + 1)) / V^t :=
      div_le_div_of_nonneg_right (damped_descFactorial_bound hρ0 hρ1 z t) (pow_nonneg hVpos.le t)
    _ = (t.factorial : ℝ) * (1 / (1 - ρ))^(t + 1) * (1 / V)^t := by
      rw [one_div_pow, one_div_pow]
      ring
    _ ≤ (T.factorial : ℝ) * (1 / (1 - ρ))^(T + 1) * (max 1 (1 / v))^T := by
      apply mul_le_mul
      · exact mul_le_mul hfac hpow (by positivity) (by positivity)
      · exact hInv
      · positivity
      · positivity
    _ = _ := by rw [one_div_pow]; ring

/-- Endpoint damping by `q^(z/2)` uniformly absorbs the unshared-list
count. The constant only uses `q`, the lower mass bound, and the maximum
number of unshared slots. -/
theorem exists_physical_damping_bound {q v : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hv : 0 < v) (T : ℕ) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ (V : ℝ), v ≤ V → ∀ z t : ℕ, t ≤ T →
      (((z + t).descFactorial t : ℝ) * q^((z : ℝ) / 2)) / V^t ≤ C := by
  let ρ := Real.sqrt q
  have hρ0 : 0 ≤ ρ := Real.sqrt_nonneg q
  have hρ1 : ρ < 1 := by
    have hs : ρ^2 = q := Real.sq_sqrt hq0
    nlinarith
  let C := ((T.factorial : ℝ) * (max 1 (1 / v))^T) / (1 - ρ)^(T + 1)
  refine ⟨max 1 C, le_max_left _ _, ?_⟩
  intro V hV z t ht
  have hp : q^((z : ℝ) / 2) = ρ^z := by
    dsimp [ρ]
    rw [Real.sqrt_eq_rpow, ← Real.rpow_natCast, ← Real.rpow_mul hq0]
    congr 1
    ring
  rw [hp]
  exact (uniform_damped_descFactorial_bound hρ0 hρ1 hv hV T z t ht).trans (le_max_right _ _)

/-- A constant loss in each of logarithmically many groups gives a
fixed power of `L`. -/
theorem group_product_bound_of_log_card {G : Type*} (groups : Finset G)
    (f : G → ℝ) {C L K : ℝ} (hC : 1 ≤ C) (hL : 0 < L)
    (hf0 : ∀ g ∈ groups, 0 ≤ f g) (hfC : ∀ g ∈ groups, f g ≤ C)
    (hcard : (groups.card : ℝ) ≤ K * Real.log L) :
    (∏ g ∈ groups, f g) ≤ L^(K * Real.log C) := by
  have hCpos : 0 < C := lt_of_lt_of_le zero_lt_one hC
  calc
    _ ≤ ∏ _g ∈ groups, C := prod_le_prod₀ hf0 hfC
    _ = C^groups.card := by simp
    _ = Real.exp ((groups.card : ℝ) * Real.log C) := by
      rw [← Real.rpow_natCast, Real.rpow_def_of_pos hCpos]
      congr 1
      ring
    _ ≤ Real.exp ((K * Real.log L) * Real.log C) :=
      Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right hcard (Real.log_nonneg hC))
    _ = L^(K * Real.log C) := by
      rw [Real.rpow_def_of_pos hL]
      congr 1
      ring
end

section
open Filter Finset
open scoped Topology
/-- Independent uniform residues for every modulus in one prime pool. -/
noncomputable def poolPathResidueExpectation {ι : Type*} (m : ι → ℕ)
    [∀ i, NeZero (m i)] (pool : Finset ι) (visits : Finset ℕ)
    (active : ι → Finset ℕ) (h : ∀ i, ℕ → ZMod (m i)) (η : ℕ → ℝ) : ℝ :=
  ∏ i ∈ pool, (∑ r, activeResidueWeight visits (active i) (h i) η r) / (m i : ℝ)

/-- The residue factor of a label with no active visit is just its
product of inactive damping factors. -/
theorem active_residue_weight_empty {R : Type*} [DecidableEq R]
    (visits : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ) (r : R) :
    activeResidueWeight visits ∅ h η r =
      ∏ j ∈ visits, (1 - η j * (if r = h j then 1 else 0)) := by
  simp [activeResidueWeight]

/-- Splitting the prime pool into ever-active and never-active labels
recovers exactly the two-family finite path weight. -/
theorem pool_path_weight_split {ι : Type*} [DecidableEq ι] (m : ι → ℕ)
    (pool A : Finset ι) (visits : Finset ℕ) (active : ι → Finset ℕ)
    (h : ∀ i, ℕ → ZMod (m i)) (η : ℕ → ℝ) (hA : A ⊆ pool)
    (hempty : ∀ i ∈ pool \ A, active i = ∅) (n : ℤ) :
    (∏ i ∈ pool, activeResidueWeight visits (active i) (h i) η (n : ZMod (m i))) =
      (∏ i : A, activeResidueWeight visits (active i.val) (h i.val) η (n : ZMod (m i.val))) *
      inactivePathResidueWeight (fun i : ↥(pool \ A) => m i.val) univ visits
        (fun i => h i.val) η n := by
  change _ = (∏ i : A, activeResidueWeight visits (active i.val) (h i.val) η (n : ZMod (m i.val))) *
    ∏ i : ↥(pool \ A), ∏ j ∈ visits, (1 - η j * (if (n : ZMod (m i.val)) = h i.val j then 1 else 0))
  rw [prod_coe_sort A (fun i => activeResidueWeight visits (active i) (h i) η (n : ZMod (m i))),
    prod_coe_sort (pool \ A) (fun i => ∏ j ∈ visits, (1 - η j * (if (n : ZMod (m i)) = h i j then 1 else 0)))]
  rw [← prod_sdiff (f := fun i => activeResidueWeight visits (active i) (h i) η (n : ZMod (m i))) hA,
    mul_comm]
  congr 1
  apply prod_congr rfl
  intro i hi
  rw [hempty i hi, active_residue_weight_empty]

/-- The two-family expectation is the full product of uniform local
averages over the original prime pool, with no normalization lost. -/
theorem pool_path_expectation_split {ι : Type*} [DecidableEq ι]
    (m : ι → ℕ) [∀ i, NeZero (m i)]
    (pool A : Finset ι) (visits : Finset ℕ) (active : ι → Finset ℕ)
    (h : ∀ i, ℕ → ZMod (m i)) (η : ℕ → ℝ) (hA : A ⊆ pool)
    (hempty : ∀ i ∈ pool \ A, active i = ∅) :
    poolPathResidueExpectation m pool visits active h η =
      pathResidueExpectation (fun i : A => m i.val) (fun i : ↥(pool \ A) => m i.val)
        univ univ visits (fun i => active i.val) (fun i => h i.val) (fun i => h i.val) η := by
  unfold poolPathResidueExpectation pathResidueExpectation
  rw [prod_coe_sort A (fun i => (∑ r, activeResidueWeight visits (active i) (h i) η r) / (m i : ℝ)),
    prod_coe_sort (pool \ A) (fun i => (∑ r, ∏ j ∈ visits, (1 - η j * (if r = h i j then 1 else 0))) / (m i : ℝ))]
  rw [← prod_sdiff (f := fun i => (∑ r, activeResidueWeight visits (active i) (h i) η r) / (m i : ℝ)) hA,
    mul_comm]
  congr 1
  apply prod_congr rfl
  intro i hi
  simp only [hempty i hi, active_residue_weight_empty]

/-- The full pool has the same uniform relative replacement estimate as
the active/inactive model. Only the prime-pool bounds and the number of
ever-active labels occur in the hypotheses. -/
theorem eventually_single_pool_path_replacement {a c d A γ : ℝ}
    (ha0 : 0 ≤ a) (hc : 0 < c) (hd : 0 < d) (had : a + d < 1)
    (hA : 0 < A) (hγ : 0 < γ) :
    ∀ᶠ L : ℝ in atTop, ∀ (ι : Type) [DecidableEq ι]
      (m : ι → ℕ) [∀ i, NeZero (m i)] (pool : Finset ι) (visits : Finset ℕ)
      (active : ι → Finset ℕ) (h : ∀ i, ℕ → ZMod (m i)) (η : ℕ → ℝ)
      (N : ℕ) (z : ℤ) (B : ℝ),
      (pool : Set ι).Pairwise (fun i j => Nat.Coprime (m i) (m j)) →
      Set.InjOn m pool →
      (∀ j ∈ visits, 0 ≤ η j ∧ η j ≤ 1) →
      (∑ j ∈ visits, η j) ≤ A * L^a →
      (∑ i ∈ pool, 1 / (m i : ℝ)) ≤ A * Real.log L →
      (∀ i ∈ pool, Real.exp (L^c) ≤ (m i : ℝ)) →
      (∀ i ∈ pool, (m i : ℝ) ≤ Real.exp (L^d)) →
      ((pool.filter (fun i => (active i).Nonempty)).card : ℝ) ≤ A * (L^a * Real.log L) →
      0 < N → γ * L ≤ Real.log (N : ℝ) →
      0 ≤ B → B ≤ A * (L^a * Real.log L) →
      |((∑ n ∈ Ico z (z + N), ∏ i ∈ pool,
          activeResidueWeight visits (active i) (h i) η (n : ZMod (m i))) / (N : ℝ)) -
        poolPathResidueExpectation m pool visits active h η| ≤
        Real.exp (-B) * poolPathResidueExpectation m pool visits active h η := by
  classical
  filter_upwards [eventually_path_replacement_of_prime_bounds ha0 hc hd had hA hγ] with L hlarge
  intro ι _ m _ pool visits active h η N z B hcop hinj hη ht hH hmin hmax hcount hN hNbound hB hBbound
  let S := pool.filter (fun i => (active i).Nonempty)
  let I := pool \ S
  have hS : S ⊆ pool := filter_subset _ _
  have hI : I ⊆ pool := sdiff_subset
  have hempty : ∀ i ∈ I, active i = ∅ := by
    intro i hi
    have hip := (mem_sdiff.mp hi).1
    have his := (mem_sdiff.mp hi).2
    by_contra hn
    exact his (mem_filter.mpr ⟨hip, nonempty_iff_ne_empty.mpr hn⟩)
  have hnonempty : ∀ i : S, (active i.val).Nonempty := fun i => (mem_filter.mp i.property).2
  let anchor : S → ℕ := fun i => Classical.choose (hnonempty i)
  have hanchor : ∀ i : S, anchor i ∈ active i.val := fun i => Classical.choose_spec (hnonempty i)
  have hcopa : ((univ : Finset S) : Set S).Pairwise (fun i j => Nat.Coprime (m i.val) (m j.val)) := by
    intro i hi j hj hij
    exact hcop (hS i.property) (hS j.property) (fun he => hij (Subtype.ext he))
  have hcopb : Pairwise (fun i j : I => Nat.Coprime (m i.val) (m j.val)) := by
    intro i j hij
    exact hcop (hI i.property) (hI j.property) (fun he => hij (Subtype.ext he))
  have hcross : ∀ i : S, ∀ j : I, Nat.Coprime (m i.val) (m j.val) := by
    intro i j
    apply hcop (hS i.property) (hI j.property)
    intro he
    exact (mem_sdiff.mp j.property).2 (he ▸ i.property)
  have hcardI : ((univ : Finset I).card : ℝ) ≤ Real.exp (L^d) := by
    simpa only [card_univ, Fintype.card_coe] using moduli_card_le_exp m I (L^d)
      (fun i hi j hj hij => hinj (hI hi) (hI hj) hij)
      (fun i hi => Nat.pos_of_ne_zero (NeZero.ne (m i))) (fun i hi => hmax i (hI hi))
  have hHI : (∑ i : I, 1 / (m i.val : ℝ)) ≤ A * Real.log L := by
    rw [sum_coe_sort I (fun i => 1 / (m i : ℝ))]
    exact (sum_le_sum_of_subset_of_nonneg hI (fun i hi hn => by positivity)).trans hH
  have hcardS : ((univ : Finset S).card : ℝ) ≤ A * (L^a * Real.log L) := by
    simpa only [card_univ, Fintype.card_coe] using hcount
  have he := hlarge S I (fun i => m i.val) (fun i => m i.val) univ univ visits
    (fun i => active i.val) (fun i => h i.val) (fun i => h i.val) η anchor N z B
    hcopa hcopb (fun i hi j => hcross i j) (fun i hi => hanchor i) hη ht hcardI hHI
    (fun i hi => hmin i.val (hI i.property)) hcardS
    (fun i hi => hmax i.val (hS i.property)) hN hNbound hB hBbound
  have hweight := pool_path_weight_split m pool S visits active h η hS hempty
  have hexpect := pool_path_expectation_split m pool S visits active h η hS hempty
  rw [hexpect]
  simp_rw [hweight]
  exact he
end

section
open Finset
/-- The ever-active labels are exactly the union of the visit mark sets. -/
theorem active_visit_pool_eq_biUnion {ι : Type*} [DecidableEq ι]
    (pool : Finset ι) (visits : Finset ℕ) (marked : ℕ → Finset ι)
    (hmarked : ∀ j ∈ visits, marked j ⊆ pool) :
    pool.filter (fun i => (visits.filter (fun j => i ∈ marked j)).Nonempty) =
      visits.biUnion marked := by
  ext i
  simp only [mem_filter, nonempty_iff_ne_empty, mem_biUnion]
  constructor
  · rintro ⟨hi, hn⟩
    obtain ⟨j, hj⟩ := nonempty_iff_ne_empty.mpr hn
    exact ⟨j, (mem_filter.mp hj).1, (mem_filter.mp hj).2⟩
  · rintro ⟨j, hj, hi⟩
    exact ⟨hmarked j hj hi, nonempty_iff_ne_empty.mp ⟨j, mem_filter.mpr ⟨hj, hi⟩⟩⟩

/-- The distinct labels appearing anywhere in a path are bounded by
its number of visits times the per-visit mark bound. -/
theorem marked_path_pool_card_bound {ι : Type*} [DecidableEq ι]
    (pool : Finset ι) (visits : Finset ℕ) (marked : ℕ → Finset ι) (K : ℕ)
    (hmarked : ∀ j ∈ visits, marked j ⊆ pool)
    (hK : ∀ j ∈ visits, (marked j).card ≤ K) :
    (pool.filter (fun i => (visits.filter (fun j => i ∈ marked j)).Nonempty)).card ≤
      visits.card * K := by
  rw [active_visit_pool_eq_biUnion pool visits marked hmarked]
  calc
    _ ≤ ∑ j ∈ visits, (marked j).card := card_biUnion_le
    _ ≤ ∑ _j ∈ visits, K := sum_le_sum hK
    _ = _ := by simp

/-- Ceiling the real moment length and including both endpoints changes
its bound by only an absolute factor. -/
theorem ceiling_path_length_bounds {L a : ℝ} (hL : 1 ≤ L) (ha : 0 ≤ a) :
    let n := 2 * Nat.ceil (L^a)
    (n : ℝ) ≤ 4 * L^a ∧ (n + 1 : ℕ) ≤ 5 * L^a := by
  have hp : 1 ≤ L^a := Real.one_le_rpow hL ha
  have hc := (Nat.ceil_lt_add_one (show 0 ≤ L^a by linarith)).le
  dsimp only
  push_cast
  constructor <;> nlinarith

/-- Unit-interval damping defects have total mass bounded by the number
of visits. -/
theorem visit_weight_sum_le_card (visits : Finset ℕ) (η : ℕ → ℝ)
    (hη : ∀ j ∈ visits, η j ≤ 1) :
    (∑ j ∈ visits, η j) ≤ visits.card := by
  calc
    _ ≤ ∑ _j ∈ visits, (1 : ℝ) := sum_le_sum hη
    _ = _ := by simp
end

section
open Filter Finset
open scoped Topology
/-- A logarithmic number of groups and the ceiling moment length give
the uniform replacement estimate for the physical divisibility factor. -/
theorem eventually_grouped_path_replacement {a c d C V E γ : ℝ}
    (ha : 0 ≤ a) (hc : 0 < c) (hd : 0 < d) (had : a + d < 1)
    (hC : 0 < C) (hV : 0 < V) (hE : 0 ≤ E) (hγ : 0 < γ) (M : ℕ) :
    ∀ᶠ L : ℝ in atTop, ∀ (ι : Type) [DecidableEq ι]
      (m : ι → ℕ) [∀ i, NeZero (m i)] (pool : Finset ι) (s : ℕ)
      (marked : ℕ → Finset ι) (offset : ℕ → ℤ) (q : ℕ → ℝ) (N : ℕ) (z : ℤ),
      let n := 2 * Nat.ceil (L^a)
      let visits := range (n + 1)
      (pool : Set ι).Pairwise (fun i j => Nat.Coprime (m i) (m j)) →
      Set.InjOn m pool →
      (s : ℝ) ≤ C * Real.log L →
      (∑ i ∈ pool, 1 / (m i : ℝ)) ≤ s * V →
      (∀ i ∈ pool, Real.exp (L^c) ≤ (m i : ℝ)) →
      (∀ i ∈ pool, (m i : ℝ) ≤ Real.exp (L^d)) →
      (∀ j ∈ visits, marked j ⊆ pool) →
      (∀ j ∈ visits, (marked j).card ≤ M * s) →
      (∀ j ∈ visits, 0 ≤ q j ∧ q j ≤ 1) →
      0 < N → γ * L ≤ Real.log (N : ℝ) →
      |((∑ k ∈ Ico z (z + N), ∏ j ∈ visits,
          (∏ i ∈ marked j, (if (m i : ℤ) ∣ k + offset j then (1 : ℝ) else 0)) *
            (q j)^((pool \ marked j).filter (fun i => (m i : ℤ) ∣ k + offset j)).card) / (N : ℝ)) -
        poolPathResidueExpectation m pool visits
          (fun i => visits.filter (fun j => i ∈ marked j))
          (fun i j => -(offset j : ZMod (m i))) (fun j => 1 - q j)| ≤
        Real.exp (-E * n * Real.log L) *
          poolPathResidueExpectation m pool visits
            (fun i => visits.filter (fun j => i ∈ marked j))
            (fun i j => -(offset j : ZMod (m i))) (fun j => 1 - q j) := by
  let A : ℝ := 6 + 5 * M * C + C * V + 4 * E
  have hA : 0 < A := by dsimp [A]; nlinarith [mul_nonneg (Nat.cast_nonneg M) hC.le, mul_nonneg hC.le hV.le]
  have h5A : 5 ≤ A := by dsimp [A]; nlinarith [mul_nonneg (Nat.cast_nonneg M) hC.le, mul_nonneg hC.le hV.le]
  have hMCA : 5 * M * C ≤ A := by dsimp [A]; nlinarith [mul_nonneg (Nat.cast_nonneg M) hC.le, mul_nonneg hC.le hV.le]
  have hCVA : C * V ≤ A := by dsimp [A]; nlinarith [mul_nonneg (Nat.cast_nonneg M) hC.le, mul_nonneg hC.le hV.le]
  have hEA : 4 * E ≤ A := by dsimp [A]; nlinarith [mul_nonneg (Nat.cast_nonneg M) hC.le, mul_nonneg hC.le hV.le]
  filter_upwards [eventually_single_pool_path_replacement ha hc hd had hA hγ,
    eventually_ge_atTop (1 : ℝ)] with L hlarge hL
  intro ι _ m _ pool s marked offset q N z
  dsimp only
  let n := 2 * Nat.ceil (L^a)
  let visits := range (n + 1)
  intro hcop hinj hs hH hmin hmax hmarked hmarks hq hN hNbound
  have hlog : 0 ≤ Real.log L := Real.log_nonneg hL
  have hpow : 0 ≤ L^a := Real.rpow_nonneg (zero_le_one.trans hL) a
  obtain ⟨hn, hn1⟩ := ceiling_path_length_bounds hL ha
  change (n : ℝ) ≤ 4 * L^a at hn
  change (n + 1 : ℕ) ≤ 5 * L^a at hn1
  have hη : ∀ j ∈ visits, 0 ≤ 1 - q j ∧ 1 - q j ≤ 1 := by
    intro j hj
    have hh := hq j hj
    constructor <;> linarith
  have ht : (∑ j ∈ visits, (1 - q j)) ≤ A * L^a := by
    calc
      _ ≤ (visits.card : ℝ) := visit_weight_sum_le_card visits _ (fun j hj => (hη j hj).2)
      _ ≤ 5 * L^a := by simpa only [visits, card_range] using hn1
      _ ≤ A * L^a := mul_le_mul_of_nonneg_right h5A hpow
  have hHbound : (∑ i ∈ pool, 1 / (m i : ℝ)) ≤ A * Real.log L := by
    calc
      _ ≤ (s : ℝ) * V := hH
      _ ≤ (C * Real.log L) * V := mul_le_mul_of_nonneg_right hs hV.le
      _ = (C * V) * Real.log L := by ring
      _ ≤ A * Real.log L := mul_le_mul_of_nonneg_right hCVA hlog
  have hactive : ((pool.filter (fun i => (visits.filter (fun j => i ∈ marked j)).Nonempty)).card : ℝ) ≤
      A * (L^a * Real.log L) := by
    have hbound : ((pool.filter (fun i => (visits.filter (fun j => i ∈ marked j)).Nonempty)).card : ℝ) ≤
        (visits.card : ℝ) * ((M : ℝ) * s) := by
      exact_mod_cast marked_path_pool_card_bound pool visits marked (M * s) hmarked hmarks
    calc
      _ ≤ (visits.card : ℝ) * ((M : ℝ) * s) := hbound
      _ ≤ (5 * L^a) * ((M : ℝ) * (C * Real.log L)) := by
        apply mul_le_mul
        · simpa only [visits, card_range] using hn1
        · exact mul_le_mul_of_nonneg_left hs (Nat.cast_nonneg M)
        · positivity
        · positivity
      _ = (5 * M * C) * (L^a * Real.log L) := by ring
      _ ≤ A * (L^a * Real.log L) := mul_le_mul_of_nonneg_right hMCA (mul_nonneg hpow hlog)
  have hB : 0 ≤ E * n * Real.log L := by positivity
  have hBbound : E * n * Real.log L ≤ A * (L^a * Real.log L) := by
    calc
      _ ≤ E * (4 * L^a) * Real.log L :=
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hn hE) hlog
      _ = (4 * E) * (L^a * Real.log L) := by ring
      _ ≤ A * (L^a * Real.log L) := mul_le_mul_of_nonneg_right hEA (mul_nonneg hpow hlog)
  have he := hlarge ι m pool visits (fun i => visits.filter (fun j => i ∈ marked j))
    (fun i j => -(offset j : ZMod (m i))) (fun j => 1 - q j) N z (E * n * Real.log L)
    hcop hinj hη ht hHbound hmin hmax hactive hN hNbound hB hBbound
  have hfactor := fun k => physical_path_divisibility_factorization m pool visits marked offset q k hmarked
  dsimp only [visits, n] at he hfactor
  simp_rw [hfactor]
  simpa only [neg_mul] using he

/-- The exponent window in the manuscript satisfies the residue budget:
`0.52 + d < 1` follows already from `d < 0.47`. -/
theorem moment_exponent_budget {d : ℝ} (hd : d < 47 / 100) :
    (13 / 25 : ℝ) + d < 1 := by linarith
end

section
open Finset
/-- Completing a shared embedding is equivalent to embedding the
unshared slots into the labels not used by the shared slots. -/
def sharedCompletionEquiv {S U P : Type*} (shared : S ↪ P) :
    {f : S ⊕ U ↪ P // ∀ s, f (Sum.inl s) = shared s} ≃
      (U ↪ {p : P // p ∉ Set.range shared}) where
  toFun f := {
    toFun := fun u => ⟨f.val (Sum.inr u), by
      rintro ⟨s, hs⟩
      have he : f.val (Sum.inl s) = f.val (Sum.inr u) := (f.property s).trans hs
      have hx := f.val.injective he
      cases hx⟩
    inj' := by
      intro u v huv
      have he := f.val.injective (congrArg Subtype.val huv)
      exact Sum.inr.inj he }
  invFun g := ⟨{
    toFun := Sum.elim shared (fun u => (g u).val)
    inj' := by
      intro x y hxy
      cases x with
      | inl s =>
        cases y with
        | inl t => exact congrArg Sum.inl (shared.injective hxy)
        | inr u => exact False.elim ((g u).property ⟨s, hxy⟩)
      | inr u =>
        cases y with
        | inl s => exact False.elim ((g u).property ⟨s, hxy.symm⟩)
        | inr v => exact congrArg Sum.inr (g.injective (Subtype.ext hxy)) }, fun s => rfl⟩
  left_inv f := by
    apply Subtype.ext
    apply Function.Embedding.ext
    intro x
    cases x with
    | inl s => exact (f.property s).symm
    | inr u => rfl
  right_inv g := by
    apply Function.Embedding.ext
    intro u
    rfl

/-- The number of ordered injective completions is the descending
factorial of the number of labels left after fixing the shared slots. -/
theorem shared_completion_card {S U P : Type*} [Fintype S] [Fintype U] [Fintype P]
    (shared : S ↪ P) :
    Nat.card {f : S ⊕ U ↪ P // ∀ s, f (Sum.inl s) = shared s} =
      (Fintype.card P - Fintype.card S).descFactorial (Fintype.card U) := by
  classical
  rw [Nat.card_congr (sharedCompletionEquiv shared), Nat.card_eq_fintype_card,
    Fintype.card_embedding_eq]
  have he : Fintype.card {p : P // p ∉ Set.range shared} = Fintype.card P - Fintype.card S := by
    let e : {p : P // p ∉ Set.range shared} ≃ ↥((Set.range shared)ᶜ) := {
      toFun := fun p => ⟨p.val, p.property⟩
      invFun := fun p => ⟨p.val, p.property⟩
      left_inv := fun p => rfl
      right_inv := fun p => rfl }
    rw [Fintype.card_congr e]
    simpa only [Fintype.card_range] using Fintype.card_compl_set (Set.range shared)
  rw [he]

/-- For a total of `M` slots with `t` unshared, the familiar count is
`(y-M+t)_t`, provided the target has at least `M` available labels. -/
theorem shared_completion_card_fin {P : Type*} [Fintype P] (M t : ℕ)
    (ht : t ≤ M) (hM : M ≤ Fintype.card P) (shared : Fin (M - t) ↪ P) :
    Nat.card {f : Fin (M - t) ⊕ Fin t ↪ P // ∀ s, f (Sum.inl s) = shared s} =
      (Fintype.card P - M + t).descFactorial t := by
  rw [shared_completion_card]
  simp only [Fintype.card_fin]
  congr 1
  omega
end

section
open Finset
/-- There are no completions when the target has too few labels for the
whole list, even if the shared portion can be embedded. -/
theorem shared_completion_card_zero {P : Type*} [Fintype P] (M t : ℕ)
    (ht : t ≤ M) (hM : Fintype.card P < M) (shared : Fin (M - t) ↪ P) :
    Nat.card {f : Fin (M - t) ⊕ Fin t ↪ P // ∀ s, f (Sum.inl s) = shared s} = 0 := by
  rw [shared_completion_card]
  simp only [Fintype.card_fin]
  apply Nat.descFactorial_eq_zero_iff_lt.mpr
  have hh := Fintype.card_le_of_embedding shared
  simp only [Fintype.card_fin] at hh
  omega

/-- The actual completion count with endpoint damping has a bound uniform
in the total number of slots and in the number of available target labels. -/
theorem exists_completion_mass_bound {q v : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hv : 0 < v) (T : ℕ) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ (P : Type) [Fintype P] (M t : ℕ), t ≤ M → t ≤ T →
      ∀ (shared : Fin (M - t) ↪ P) (V : ℝ), v ≤ V →
        ((Nat.card {f : Fin (M - t) ⊕ Fin t ↪ P // ∀ s, f (Sum.inl s) = shared s} : ℝ) *
          q^(((Fintype.card P - M : ℕ) : ℝ) / 2)) / V^t ≤ C := by
  obtain ⟨C, hC, hbound⟩ := exists_physical_damping_bound hq0 hq1 hv T
  refine ⟨C, hC, ?_⟩
  intro P _ M t ht hT shared V hV
  by_cases hM : M ≤ Fintype.card P
  · rw [shared_completion_card_fin M t ht hM shared]
    exact hbound V hV (Fintype.card P - M) t hT
  · rw [shared_completion_card_zero M t ht (Nat.lt_of_not_ge hM) shared]
    simp only [Nat.cast_zero, zero_mul, zero_div]
    exact zero_le_one.trans hC

/-- The completion bound also holds for arbitrary finite shared and
unshared slot types, so no particular ordering of the shared slots is needed. -/
theorem exists_completion_mass_bound_types {q v : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hv : 0 < v) (T : ℕ) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ (S U P : Type) [Fintype S] [Fintype U] [Fintype P]
      (shared : S ↪ P) (V : ℝ), v ≤ V → Fintype.card U ≤ T →
        ((Nat.card {f : S ⊕ U ↪ P // ∀ s, f (Sum.inl s) = shared s} : ℝ) *
          q^(((Fintype.card P - (Fintype.card S + Fintype.card U) : ℕ) : ℝ) / 2)) /
            V^(Fintype.card U) ≤ C := by
  obtain ⟨C, hC, hbound⟩ := exists_physical_damping_bound hq0 hq1 hv T
  refine ⟨C, hC, ?_⟩
  intro S U P _ _ _ shared V hV hT
  rw [shared_completion_card]
  have hS := Fintype.card_le_of_embedding shared
  by_cases hM : Fintype.card S + Fintype.card U ≤ Fintype.card P
  · have he : Fintype.card P - Fintype.card S =
        Fintype.card P - (Fintype.card S + Fintype.card U) + Fintype.card U := by omega
    rw [he]
    exact hbound V hV _ _ hT
  · have hz : (Fintype.card P - Fintype.card S).descFactorial (Fintype.card U) = 0 :=
      Nat.descFactorial_eq_zero_iff_lt.mpr (by omega)
    rw [hz]
    simp only [Nat.cast_zero, zero_mul, zero_div]
    exact zero_le_one.trans hC

/-- Endpoint bans or other admissibility restrictions can only reduce
the damped sum over injective completions. -/
theorem restricted_completion_mass_le {P : Type*} [Fintype P] [DecidableEq P] (M t : ℕ)
    (shared : Fin (M - t) ↪ P)
    (allowed : {f : Fin (M - t) ⊕ Fin t ↪ P // ∀ s, f (Sum.inl s) = shared s} → Prop)
    [DecidablePred allowed] {q V : ℝ} (hq : 0 ≤ q) (hV : 0 < V) :
    (∑ _f ∈ (univ : Finset {f : Fin (M - t) ⊕ Fin t ↪ P // ∀ s, f (Sum.inl s) = shared s}).filter allowed,
      q^(((Fintype.card P - M : ℕ) : ℝ) / 2) / V^t) ≤
      (Nat.card {f : Fin (M - t) ⊕ Fin t ↪ P // ∀ s, f (Sum.inl s) = shared s} : ℝ) *
        q^(((Fintype.card P - M : ℕ) : ℝ) / 2) / V^t := by
  classical
  calc
    _ ≤ ∑ _f : {f : Fin (M - t) ⊕ Fin t ↪ P // ∀ s, f (Sum.inl s) = shared s},
        q^(((Fintype.card P - M : ℕ) : ℝ) / 2) / V^t :=
      sum_le_sum_of_subset_of_nonneg (filter_subset _ _) (fun f hf hnot => by positivity)
    _ = _ := by simp only [sum_const, card_univ, nsmul_eq_mul, Nat.card_eq_fintype_card, mul_div_assoc]

/-- Independent auxiliary choices with total mass at most one preserve
a uniform nonnegative row bound. -/
theorem auxiliary_average_row_bound {ι : Type*} (choices : Finset ι)
    (μ row : ι → ℝ) {C : ℝ} (hC : 0 ≤ C)
    (hμ : ∀ i ∈ choices, 0 ≤ μ i) (hmass : (∑ i ∈ choices, μ i) ≤ 1)
    (hrow : ∀ i ∈ choices, row i ≤ C) :
    (∑ i ∈ choices, μ i * row i) ≤ C := by
  calc
    _ ≤ ∑ i ∈ choices, μ i * C := sum_le_sum (fun i hi => mul_le_mul_of_nonneg_left (hrow i hi) (hμ i hi))
    _ = (∑ i ∈ choices, μ i) * C := by rw [sum_mul]
    _ ≤ 1 * C := mul_le_mul_of_nonneg_right hmass hC
    _ = C := one_mul C

/-- A source damping factor bounded by one preserves the row estimate. -/
theorem source_damping_row_bound {D R C : ℝ}
    (hD0 : 0 ≤ D) (hD1 : D ≤ 1) (hC : 0 ≤ C) (hrow : R ≤ C) :
    D * R ≤ C := by
  calc
    D * R ≤ D * C := mul_le_mul_of_nonneg_left hrow hD0
    _ ≤ 1 * C := mul_le_mul_of_nonneg_right hD1 hC
    _ = C := one_mul C
end

section
open Finset
/-- A restricted product of nonnegative group weights, multiplied by a
bounded complex coefficient, has at most the unrestricted product mass. -/
theorem restricted_group_row_bound {G : Type*} [Fintype G]
    (P : G → Type*) [∀ g, Fintype (P g)]
    (rows : Finset (∀ g, P g)) (w : ∀ g, P g → ℝ) (K : (∀ g, P g) → ℂ)
    {B C : ℝ} (hB : 0 ≤ B)
    (hw : ∀ g p, 0 ≤ w g p) (hrow : ∀ g, (∑ p, w g p) ≤ C)
    (hK : ∀ f ∈ rows, ‖K f‖ ≤ B) :
    (∑ f ∈ rows, ‖K f‖ * ∏ g, w g (f g)) ≤ B * C^(Fintype.card G) := by
  classical
  have hprod : ∀ f : ∀ g, P g, 0 ≤ ∏ g, w g (f g) :=
    fun f => prod_nonneg (fun g hg => hw g (f g))
  calc
    _ ≤ ∑ f ∈ rows, B * ∏ g, w g (f g) :=
      sum_le_sum (fun f hf => mul_le_mul_of_nonneg_right (hK f hf) (hprod f))
    _ = B * ∑ f ∈ rows, ∏ g, w g (f g) := by rw [mul_sum]
    _ ≤ B * ∑ f : ∀ g, P g, ∏ g, w g (f g) :=
      mul_le_mul_of_nonneg_left (sum_le_univ_sum_of_nonneg hprod) hB
    _ = B * ∏ g, ∑ p, w g p := by rw [Fintype.prod_sum]
    _ ≤ B * ∏ _g : G, C := mul_le_mul_of_nonneg_left
      (prod_le_prod₀ (fun g hg => sum_nonneg (fun p hp => hw g p)) (fun g hg => hrow g)) hB
    _ = _ := by simp

/-- Averaging complex row coefficients over auxiliary choices of total
mass at most one preserves a uniform absolute row estimate. -/
theorem auxiliary_complex_row_bound {A P : Type*}
    (choices : Finset A) (rows : Finset P) (μ : A → ℝ) (K : A → P → ℂ)
    {C : ℝ} (hC : 0 ≤ C) (hμ : ∀ a ∈ choices, 0 ≤ μ a)
    (hmass : (∑ a ∈ choices, μ a) ≤ 1)
    (hrow : ∀ a ∈ choices, (∑ p ∈ rows, ‖K a p‖) ≤ C) :
    (∑ p ∈ rows, ‖∑ a ∈ choices, (μ a : ℂ) * K a p‖) ≤ C := by
  calc
    _ ≤ ∑ p ∈ rows, ∑ a ∈ choices, μ a * ‖K a p‖ := by
      apply sum_le_sum
      intro p hp
      calc
        _ ≤ ∑ a ∈ choices, ‖(μ a : ℂ) * K a p‖ := norm_sum_le _ _
        _ = _ := by
          apply sum_congr rfl
          intro a ha
          simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hμ a ha)]
    _ = ∑ a ∈ choices, μ a * ∑ p ∈ rows, ‖K a p‖ := by
      rw [sum_comm]
      simp only [mul_sum]
    _ ≤ C := auxiliary_average_row_bound choices μ _ hC hμ hmass hrow

/-- Summing patterns costs only the sum of their absolute coefficient
bounds. No orthogonality between patterns is required. -/
theorem pattern_absolute_row_bound {A P : Type*}
    (patterns : Finset A) (rows : Finset P) (K : A → P → ℂ)
    (mass : A → ℝ) (C : ℝ)
    (hrow : ∀ a ∈ patterns, (∑ p ∈ rows, ‖K a p‖) ≤ mass a * C) :
    (∑ p ∈ rows, ‖∑ a ∈ patterns, K a p‖) ≤ (∑ a ∈ patterns, mass a) * C := by
  calc
    _ ≤ ∑ p ∈ rows, ∑ a ∈ patterns, ‖K a p‖ := sum_le_sum (fun p hp => norm_sum_le _ _)
    _ = ∑ a ∈ patterns, ∑ p ∈ rows, ‖K a p‖ := sum_comm
    _ ≤ ∑ a ∈ patterns, mass a * C := sum_le_sum hrow
    _ = _ := by rw [sum_mul]

/-- Logarithmically many group losses and the stated pattern mass produce
a fixed power row bound. The exponent does not involve the total slot count. -/
theorem pattern_row_power_bound {A P : Type*}
    (patterns : Finset A) (rows : Finset P) (K : A → P → ℂ)
    (mass : A → ℝ) (s : ℕ) {L C D C₁ : ℝ} (hL : 0 < L) (hC : 1 ≤ C)
    (hs : (s : ℝ) ≤ D * Real.log L)
    (hmass : (∑ a ∈ patterns, mass a) ≤ L^C₁)
    (hrow : ∀ a ∈ patterns, (∑ p ∈ rows, ‖K a p‖) ≤ mass a * C^s) :
    (∑ p ∈ rows, ‖∑ a ∈ patterns, K a p‖) ≤ L^(C₁ + D * Real.log C) := by
  have hC0 : 0 ≤ C := zero_le_one.trans hC
  have hprod : C^s ≤ L^(D * Real.log C) := by
    simpa only [prod_const, card_range] using
      group_product_bound_of_log_card (range s) (fun _ => C) hC hL
        (fun _ _ => hC0) (fun _ _ => le_rfl) (by simpa only [card_range] using hs)
  calc
    _ ≤ (∑ a ∈ patterns, mass a) * C^s := pattern_absolute_row_bound patterns rows K mass (C^s) hrow
    _ ≤ L^C₁ * C^s := mul_le_mul_of_nonneg_right hmass (pow_nonneg hC0 s)
    _ ≤ L^C₁ * L^(D * Real.log C) := mul_le_mul_of_nonneg_left hprod (Real.rpow_nonneg hL.le C₁)
    _ = _ := (Real.rpow_add hL _ _).symm
end

section
open Finset
/-- Iterated finite row action; the terminal weight can impose a return
condition or any other restriction on the final state. -/
noncomputable def finitePathMass {ι : Type*} (states : Finset ι)
    (K : ℕ → ι → ι → ℝ) (terminal : ι → ℝ) : ℕ → ι → ℝ
  | 0, i => terminal i
  | n + 1, i => ∑ j ∈ states, K n i j * finitePathMass states K terminal n j

/-- A nonnegative transition and terminal weight give nonnegative path mass. -/
theorem finite_path_mass_nonneg {ι : Type*} (states : Finset ι)
    (K : ℕ → ι → ι → ℝ) (terminal : ι → ℝ)
    (hK : ∀ n i, i ∈ states → ∀ j ∈ states, 0 ≤ K n i j)
    (ht : ∀ i ∈ states, 0 ≤ terminal i) (n : ℕ) :
    ∀ i ∈ states, 0 ≤ finitePathMass states K terminal n i := by
  induction n with
  | zero => exact ht
  | succ n ih =>
    intro i hi
    exact sum_nonneg (fun j hj => mul_nonneg (hK n i hi j hj) (ih j hj))

/-- A row bound multiplies once per step, even when the kernels vary and
the endpoint is restricted. -/
theorem finite_path_mass_le_pow {ι : Type*} (states : Finset ι)
    (K : ℕ → ι → ι → ℝ) (terminal : ι → ℝ) {A : ℝ} (hA : 0 ≤ A)
    (hK : ∀ n i, i ∈ states → ∀ j ∈ states, 0 ≤ K n i j)
    (hrow : ∀ n i, i ∈ states → (∑ j ∈ states, K n i j) ≤ A)
    (ht : ∀ i ∈ states, terminal i ≤ 1) (n : ℕ) :
    ∀ i ∈ states, finitePathMass states K terminal n i ≤ A^n := by
  induction n with
  | zero => simpa only [finitePathMass, pow_zero] using ht
  | succ n ih =>
    intro i hi
    calc
      _ ≤ ∑ j ∈ states, K n i j * A^n :=
        sum_le_sum (fun j hj => mul_le_mul_of_nonneg_left (ih j hj) (hK n i hi j hj))
      _ = (∑ j ∈ states, K n i j) * A^n := by rw [sum_mul]
      _ ≤ A * A^n := mul_le_mul_of_nonneg_right (hrow n i hi) (pow_nonneg hA n)
      _ = A^(n + 1) := by rw [pow_succ']

/-- Initial weights of total mass at most one preserve the path bound.
The terminal restriction may depend on the starting state. -/
theorem averaged_finite_path_mass_bound {ι : Type*} (states : Finset ι)
    (K : ℕ → ι → ι → ℝ) (terminal : ι → ι → ℝ) (μ : ι → ℝ)
    {A : ℝ} (hA : 0 ≤ A)
    (hK : ∀ n i, i ∈ states → ∀ j ∈ states, 0 ≤ K n i j)
    (hrow : ∀ n i, i ∈ states → (∑ j ∈ states, K n i j) ≤ A)
    (ht : ∀ i ∈ states, ∀ j ∈ states, terminal i j ≤ 1)
    (hμ : ∀ i ∈ states, 0 ≤ μ i) (hmass : (∑ i ∈ states, μ i) ≤ 1) (n : ℕ) :
    (∑ i ∈ states, μ i * finitePathMass states K (terminal i) n i) ≤ A^n := by
  calc
    _ ≤ ∑ i ∈ states, μ i * A^n := sum_le_sum (fun i hi =>
      mul_le_mul_of_nonneg_left
        (finite_path_mass_le_pow states K (terminal i) hA hK hrow (ht i hi) n i hi) (hμ i hi))
    _ = (∑ i ∈ states, μ i) * A^n := by rw [sum_mul]
    _ ≤ 1 * A^n := mul_le_mul_of_nonneg_right hmass (pow_nonneg hA n)
    _ = A^n := one_mul _

/-- A fixed power row loss gives an exponential of `n log L` for all
length-n paths, which is the mass scale used by residue replacement. -/
theorem averaged_finite_path_mass_exp_bound {ι : Type*} (states : Finset ι)
    (K : ℕ → ι → ι → ℝ) (terminal : ι → ι → ℝ) (μ : ι → ℝ)
    {L C : ℝ} (hL : 0 < L)
    (hK : ∀ n i, i ∈ states → ∀ j ∈ states, 0 ≤ K n i j)
    (hrow : ∀ n i, i ∈ states → (∑ j ∈ states, K n i j) ≤ L^C)
    (ht : ∀ i ∈ states, ∀ j ∈ states, terminal i j ≤ 1)
    (hμ : ∀ i ∈ states, 0 ≤ μ i) (hmass : (∑ i ∈ states, μ i) ≤ 1) (n : ℕ) :
    (∑ i ∈ states, μ i * finitePathMass states K (terminal i) n i) ≤
      Real.exp (C * n * Real.log L) := by
  have he := averaged_finite_path_mass_bound states K terminal μ
    (Real.rpow_nonneg hL.le C) hK hrow ht hμ hmass n
  have hp : (L^C)^n = Real.exp (C * n * Real.log L) := by
    rw [Real.rpow_def_of_pos hL, ← Real.exp_nat_mul]
    congr 1
    ring
  exact hp ▸ he

/-- The residue error can be summed with the complex coefficients of
actual path expansions when their absolute model mass has the row-bound scale. -/
theorem complex_summed_path_exponential_error {P : Type*} (paths : Finset P)
    (c : P → ℂ) (actual expected : P → ℝ) {L n E C : ℝ}
    (herror : ∀ p ∈ paths, |actual p - expected p| ≤
      Real.exp (-(E + C) * n * Real.log L) * expected p)
    (hmass : (∑ p ∈ paths, ‖c p‖ * expected p) ≤ Real.exp (C * n * Real.log L)) :
    ‖(∑ p ∈ paths, c p * (actual p : ℂ)) - ∑ p ∈ paths, c p * (expected p : ℂ)‖ ≤
      Real.exp (-E * n * Real.log L) := by
  calc
    _ ≤ Real.exp (-(E + C) * n * Real.log L) * ∑ p ∈ paths, ‖c p‖ * expected p :=
      complex_path_error_bound paths c actual expected _ herror
    _ ≤ Real.exp (-(E + C) * n * Real.log L) * Real.exp (C * n * Real.log L) :=
      mul_le_mul_of_nonneg_left hmass (Real.exp_pos _).le
    _ = _ := by rw [← Real.exp_add]; congr 1; ring
end

section
open Finset
/-- The first `J` slots and the final `ell` slots of a mark list. -/
abbrev PhysicalSlots (J ell : ℕ) := Fin J ⊕ Fin ell

/-- Each group carries an injective ordered list of its own prime labels. -/
abbrev PhysicalMarkLists {G : Type*} (P : G → Finset ℕ) (J ell : ℕ) :=
  ∀ g, PhysicalSlots J ell ↪ ↥(P g)

/-- The finite mark lists that divide a specified integer position. -/
abbrev PhysicalMarksAt {G : Type*} (P : G → Finset ℕ) (J ell : ℕ) (n : ℤ) :=
  {labels : PhysicalMarkLists P J ell //
    ∀ g s, (((labels g s).val : ℕ) : ℤ) ∣ n}

/-- A physical state consists of its integer position and admissible marks. -/
abbrev PhysicalState {G : Type*} (P : G → Finset ℕ) (J ell : ℕ) :=
  Σ n : ℤ, PhysicalMarksAt P J ell n

/-- The group primes available at an integer position, including zero. -/
def physicalDivisorPool {G : Type*} (P : G → Finset ℕ) (g : G) (n : ℤ) : Finset ℕ :=
  (P g).filter (fun p => (p : ℤ) ∣ n)

/-- The number of available labels in one group. -/
def physicalOmega {G : Type*} (P : G → Finset ℕ) (g : G) (n : ℤ) : ℕ :=
  (physicalDivisorPool P g n).card

/-- An admissible mark list embeds all its slots into the available pool. -/
def physicalMarksEmbedding {G : Type*} (P : G → Finset ℕ) (J ell : ℕ)
    (n : ℤ) (labels : PhysicalMarksAt P J ell n) (g : G) :
    PhysicalSlots J ell ↪ ↥(physicalDivisorPool P g n) where
  toFun s := ⟨(labels.val g s).val, mem_filter.mpr ⟨(labels.val g s).property, labels.property g s⟩⟩
  inj' := by
    intro s t hst
    have he : (labels.val g s).val = (labels.val g t).val :=
      congrArg (fun p : ↥(physicalDivisorPool P g n) => p.val) hst
    exact (labels.val g).injective (Subtype.ext he)

/-- A physical state has at least as many available divisors as mark slots. -/
theorem physical_slots_le_omega {G : Type*} (P : G → Finset ℕ) (J ell : ℕ)
    (n : ℤ) (labels : PhysicalMarksAt P J ell n) (g : G) :
    J + ell ≤ physicalOmega P g n := by
  have h := Fintype.card_le_of_embedding (physicalMarksEmbedding P J ell n labels g)
  simpa only [Fintype.card_sum, Fintype.card_fin, Fintype.card_coe, physicalOmega] using h

/-- Only first-block slots outside `C` are shared by a pattern. -/
def physicalSharedSlots {J ell : ℕ} (C : Finset (Fin J)) : Finset (PhysicalSlots J ell) :=
  (univ \ C).map Function.Embedding.inl

/-- The complementary slots are resampled at each endpoint. -/
def physicalUnsharedSlots {J ell : ℕ} (C : Finset (Fin J)) : Finset (PhysicalSlots J ell) :=
  (physicalSharedSlots (ell := ell) C)ᶜ

theorem physical_shared_slots_card {J ell : ℕ} (C : Finset (Fin J)) :
    (physicalSharedSlots (ell := ell) C).card = J - C.card := by
  simp only [physicalSharedSlots, card_map, card_sdiff, inter_univ, card_univ, Fintype.card_fin]

theorem physical_unshared_slots_card {J ell : ℕ} (C : Finset (Fin J)) :
    (physicalUnsharedSlots (ell := ell) C).card = ell + C.card := by
  have hc : C.card ≤ J := by simpa only [Fintype.card_fin] using card_le_univ C
  simp only [physicalUnsharedSlots, card_compl, Fintype.card_sum, Fintype.card_fin,
    physical_shared_slots_card]
  omega

/-- The number of unshared slots is bounded independently of `J`. -/
theorem physical_unshared_slots_bound {J ell m : ℕ} (C : Finset (Fin J))
    (hC : C.card ≤ m) :
    (physicalUnsharedSlots (ell := ell) C).card ≤ ell + m := by
  rw [physical_unshared_slots_card]
  exact Nat.add_le_add_left hC ell

/-- Groupwise endpoint damping. Natural subtraction equals the genuine
excess count at every physical state by `physical_slots_le_omega`. -/
noncomputable def physicalDamping {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (J ell : ℕ) (q : ℝ) (n : ℤ) : ℝ :=
  ∏ g, q^(((physicalOmega P g n - (J + ell) : ℕ) : ℝ) / 2)

theorem physical_damping_unit {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (J ell : ℕ) {q : ℝ} (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (n : ℤ) :
    0 ≤ physicalDamping P J ell q n ∧ physicalDamping P J ell q n ≤ 1 := by
  constructor
  · exact prod_nonneg (fun g hg => Real.rpow_nonneg hq0 _)
  · exact prod_le_one₀ (fun g hg => Real.rpow_nonneg hq0 _)
      (fun g hg => Real.rpow_le_one hq0 hq1 (by positivity))

/-- Every marked state has the same counting-measure normalization. -/
noncomputable def physicalStateMass {G : Type*} [Fintype G]
    (V : G → ℝ) (J ell : ℕ) : ℝ := ∏ g, 1 / (V g)^(J + ell)

theorem physical_state_mass_pos {G : Type*} [Fintype G]
    (V : G → ℝ) (hV : ∀ g, 0 < V g) (J ell : ℕ) :
    0 < physicalStateMass V J ell := prod_pos (fun g hg => by exact div_pos zero_lt_one (pow_pos (hV g) _))
end

section
open Finset
/-- Free labels are sampled independently; no injectivity is imposed. -/
abbrev PhysicalAuxLabels {G : Type*} (P : G → Finset ℕ) {J : ℕ}
    (C : G → Finset (Fin J)) := ∀ g, ↥(C g) → ↥(P g)

/-- The source and target copy precisely the first-block slots outside C. -/
def physicalSharedCompatible {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (src tgt : PhysicalMarkLists P J ell) : Prop :=
  ∀ g j, j ∉ C g → src g (Sum.inl j) = tgt g (Sum.inl j)

/-- A free label may not occur in any slot of the indicated endpoint. -/
def physicalAuxAvoids {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (labels : PhysicalMarkLists P J ell) : Prop :=
  ∀ g (j : C g) s, aux g j ≠ labels g s

/-- For disjoint prime groups, banning a free label from its own
endpoint group is equivalent to banning it from the entire endpoint list. -/
theorem physical_aux_avoids_global_iff {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (labels : PhysicalMarkLists P J ell)
    (hP : Pairwise (fun g h => Disjoint (P g) (P h))) :
    physicalAuxAvoids C aux labels ↔
      ∀ g (j : C g) h s, (aux g j).val ≠ (labels h s).val := by
  constructor
  · intro ha g j h s he
    by_cases hgh : g = h
    · subst h
      exact ha g j s (Subtype.ext he)
    · have hp : (aux g j).val ∈ P h := by rw [he]; exact (labels h s).property
      exact (disjoint_left.mp (hP hgh)) (aux g j).property hp
  · intro ha g j s he
    exact ha g j g s (congrArg Subtype.val he)

/-- One group contributes one factor for every first-block slot: the
copied shared label or an independent auxiliary label. -/
noncomputable def physicalGroupD {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (labels : PhysicalMarkLists P J ell)
    (aux : PhysicalAuxLabels P C) (g : G) : ℕ :=
  (∏ j ∈ univ \ C g, (labels g (Sum.inl j)).val) * ∏ j : C g, (aux g j).val

noncomputable def physicalD {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (labels : PhysicalMarkLists P J ell)
    (aux : PhysicalAuxLabels P C) : ℕ := ∏ g, physicalGroupD C labels aux g

theorem physical_shared_compatible_symm {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) {src tgt : PhysicalMarkLists P J ell}
    (h : physicalSharedCompatible C src tgt) : physicalSharedCompatible C tgt src :=
  fun g j hj => (h g j hj).symm

/-- D is unchanged when compatible endpoint lists are reversed. -/
theorem physical_D_eq_of_shared {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    {src tgt : PhysicalMarkLists P J ell} (h : physicalSharedCompatible C src tgt)
    (aux : PhysicalAuxLabels P C) : physicalD C src aux = physicalD C tgt aux := by
  unfold physicalD physicalGroupD
  apply prod_congr rfl
  intro g hg
  congr 1
  apply prod_congr rfl
  intro j hj
  rw [h g j (mem_sdiff.mp hj).2]

theorem physical_D_pos {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (labels : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C)
    (hP : ∀ g p, p ∈ P g → 0 < p) : 0 < physicalD C labels aux := by
  apply prod_pos
  intro g hg
  apply mul_pos
  · exact prod_pos (fun j hj => hP g _ (labels g (Sum.inl j)).property)
  · exact prod_pos (fun j hj => hP g _ (aux g j).property)

/-- Each shared label is one of the factors of D. -/
theorem physical_shared_label_dvd_D {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (labels : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C)
    (g : G) (j : Fin J) (hj : j ∉ C g) :
    (labels g (Sum.inl j)).val ∣ physicalD C labels aux := by
  have hmem : j ∈ univ \ C g := mem_sdiff.mpr ⟨mem_univ j, hj⟩
  have hlocal : (labels g (Sum.inl j)).val ∣ physicalGroupD C labels aux g :=
    dvd_mul_of_dvd_left (dvd_prod_of_mem (fun j => (labels g (Sum.inl j)).val) hmem) _
  exact dvd_trans hlocal (dvd_prod_of_mem (fun g => physicalGroupD C labels aux g) (mem_univ g))

/-- Shared divisibility is preserved by the dilation step n -> n+kD. -/
theorem physical_shared_divides_target {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (x : PhysicalState P J ell) (aux : PhysicalAuxLabels P C)
    (k : ℤ) (g : G) (j : Fin J) (hj : j ∉ C g) :
    (((x.2.val g (Sum.inl j)).val : ℕ) : ℤ) ∣ x.1 + k * (physicalD C x.2.val aux : ℕ) := by
  have hD : (((x.2.val g (Sum.inl j)).val : ℕ) : ℤ) ∣ (physicalD C x.2.val aux : ℕ) := by
    exact_mod_cast physical_shared_label_dvd_D C x.2.val aux g j hj
  exact dvd_add (x.2.property g (Sum.inl j)) (dvd_mul_of_dvd_right hD k)

/-- Support conditions of an unsymmetrized physical edge. -/
def physicalAdmissible {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) (x y : PhysicalState P J ell) : Prop :=
  physicalSharedCompatible C x.2.val y.2.val ∧
  physicalAuxAvoids C aux x.2.val ∧ physicalAuxAvoids C aux y.2.val ∧
  y.1 = x.1 + k * (physicalD C x.2.val aux : ℕ)

/-- Reversing an edge exchanges endpoint bans and negates the dilation
step, while leaving the sampled free labels and D unchanged. -/
theorem physical_admissible_reverse {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) {x y : PhysicalState P J ell}
    (h : physicalAdmissible C aux k x y) : physicalAdmissible C aux (-k) y x := by
  rcases h with ⟨hshared, hx, hy, hpos⟩
  refine ⟨physical_shared_compatible_symm C hshared, hy, hx, ?_⟩
  rw [← physical_D_eq_of_shared C hshared aux, hpos]
  ring

theorem physical_admissible_reverse_iff {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) (x y : PhysicalState P J ell) :
    physicalAdmissible C aux k x y ↔ physicalAdmissible C aux (-k) y x := by
  constructor
  · exact physical_admissible_reverse C aux k
  · intro h
    simpa only [neg_neg] using physical_admissible_reverse C aux (-k) h
end

section
open Finset
/-- The reciprocal-prime probability assigned to a group label. -/
noncomputable def physicalLabelLaw {G : Type*} {P : G → Finset ℕ}
    (V : G → ℝ) (g : G) (p : P g) : ℝ := 1 / (V g * (p.val : ℝ))

theorem physical_label_law_nonneg {G : Type*} {P : G → Finset ℕ}
    (V : G → ℝ) (hV : ∀ g, 0 ≤ V g) (g : G) (p : P g) :
    0 ≤ physicalLabelLaw V g p := by
  unfold physicalLabelLaw
  exact div_nonneg zero_le_one (mul_nonneg (hV g) (Nat.cast_nonneg p.val))

/-- The auxiliary law is normalized by the group's harmonic mass. -/
theorem physical_label_law_sum {G : Type*} {P : G → Finset ℕ}
    (V : G → ℝ) (g : G) (hV : 0 < V g)
    (hMass : ∑ p ∈ P g, 1 / (p : ℝ) = V g) :
    (∑ p : P g, physicalLabelLaw V g p) = 1 := by
  have he : ∀ p : P g, physicalLabelLaw V g p = (1 / (p.val : ℝ)) / V g := by
    intro p
    unfold physicalLabelLaw
    rw [div_div, mul_comm]
  simp_rw [he]
  rw [← sum_div, sum_coe_sort (P g) (fun p => 1 / (p : ℝ)), hMass, div_self (ne_of_gt hV)]

/-- Every free slot is sampled independently, including coincidences
between two different free slots. -/
noncomputable def physicalAuxMass {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) : ℝ :=
  ∏ g, ∏ j : C g, physicalLabelLaw V g (aux g j)

theorem physical_aux_mass_nonneg {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 ≤ V g) (aux : PhysicalAuxLabels P C) :
    0 ≤ physicalAuxMass V C aux :=
  prod_nonneg (fun g _ => prod_nonneg (fun j _ => physical_label_law_nonneg V hV g (aux g j)))

theorem physical_aux_mass_sum {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) :
    (∑ aux : PhysicalAuxLabels P C, physicalAuxMass V C aux) = 1 := by
  classical
  unfold physicalAuxMass
  have hout : (∑ aux : PhysicalAuxLabels P C, ∏ g, ∏ j : C g, physicalLabelLaw V g (aux g j)) =
      ∏ g, ∑ f : ↥(C g) → ↥(P g), ∏ j : C g, physicalLabelLaw V g (f j) :=
    (Fintype.prod_sum (fun g (f : ↥(C g) → ↥(P g)) => ∏ j : C g, physicalLabelLaw V g (f j))).symm
  rw [hout]
  apply prod_eq_one
  intro g hg
  have hin : (∑ f : ↥(C g) → ↥(P g), ∏ j : C g, physicalLabelLaw V g (f j)) =
      ∏ _j : C g, ∑ p : P g, physicalLabelLaw V g p :=
    (Fintype.prod_sum (fun (_j : C g) (p : P g) => physicalLabelLaw V g p)).symm
  rw [hin]
  apply prod_eq_one
  intro j hj
  exact physical_label_law_sum V g (hV g) (hMass g)

/-- Each target completion is weighted by one inverse harmonic mass
for every unshared slot. -/
noncomputable def physicalCompletionMass {G : Type*} [Fintype G] {J : ℕ}
    (V : G → ℝ) (C : G → Finset (Fin J)) (ell : ℕ) : ℝ :=
  ∏ g, 1 / (V g)^(ell + (C g).card)

theorem physical_completion_mass_pos {G : Type*} [Fintype G] {J : ℕ}
    (V : G → ℝ) (C : G → Finset (Fin J)) (ell : ℕ) (hV : ∀ g, 0 < V g) :
    0 < physicalCompletionMass V C ell :=
  prod_pos (fun g _ => div_pos zero_lt_one (pow_pos (hV g) _))

/-- The joint source/target normalization is V^(-M-t) in each group;
this expression is unchanged by reversing the edge. -/
theorem physical_joint_mass {G : Type*} [Fintype G] {J : ℕ}
    (V : G → ℝ) (C : G → Finset (Fin J)) (ell : ℕ) :
    physicalStateMass V J ell * physicalCompletionMass V C ell =
      ∏ g, 1 / (V g)^((J + ell) + (ell + (C g).card)) := by
  unfold physicalStateMass physicalCompletionMass
  rw [← prod_mul_distrib]
  apply prod_congr rfl
  intro g hg
  rw [one_div_mul_one_div, ← pow_add]

/-- The product of groupwise dampings agrees with the global exponent
in the physical operator at every admissible state. -/
theorem physical_damping_eq_global {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (J ell : ℕ) {q : ℝ} (hq : 0 < q)
    (x : PhysicalState P J ell) :
    physicalDamping P J ell q x.1 =
      q^(((∑ g, (physicalOmega P g x.1 : ℝ)) - (J + ell : ℕ) * Fintype.card G) / 2) := by
  unfold physicalDamping
  rw [← Real.rpow_sum_of_pos hq]
  congr 1
  have he : ∀ g, ((physicalOmega P g x.1 - (J + ell) : ℕ) : ℝ) =
      (physicalOmega P g x.1 : ℝ) - (J + ell : ℕ) := by
    intro g
    exact Nat.cast_sub (physical_slots_le_omega P J ell x.1 x.2 g)
  simp_rw [he]
  rw [← sum_div, sum_sub_distrib]
  simp only [sum_const, card_univ, nsmul_eq_mul]
  ring
end

section
open Finset
/-- The unit-modulus phase D^(i zeta), written using the real logarithm. -/
noncomputable def physicalPhase (ζ : ℝ) (D : ℕ) : ℂ :=
  Complex.exp ((ζ * Real.log (D : ℝ) : ℝ) * Complex.I)

theorem physical_phase_norm (ζ : ℝ) (D : ℕ) : ‖physicalPhase ζ D‖ = 1 := by
  rw [physicalPhase, Complex.norm_exp]
  simp only [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, Complex.I_re,
    Complex.I_im, mul_zero, zero_mul, sub_self, Real.exp_zero]

theorem physical_phase_reverse (ζ : ℝ) (D : ℕ) :
    physicalPhase (-ζ) D = (starRingEnd ℂ) (physicalPhase ζ D) := by
  unfold physicalPhase
  rw [← Complex.exp_conj]
  congr 1
  simp only [map_mul, Complex.conj_ofReal, Complex.conj_I, neg_mul, Complex.ofReal_neg]
  ring

/-- One sampled auxiliary choice contributes this row coefficient. The
coefficient function may depend on both ordered lists and the free labels. -/
noncomputable def physicalEdgeCoeff {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (q ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (x y : PhysicalState P J ell) : ℂ := by
  classical
  exact if physicalAdmissible C aux k x y then
    ((physicalAuxMass V C aux * physicalCompletionMass V C ell *
      physicalDamping P J ell q x.1 * physicalDamping P J ell q y.1 : ℝ) : ℂ) *
      K x.2.val y.2.val aux * physicalPhase ζ (physicalD C x.2.val aux)
    else 0

/-- The adjoint edge uses the same auxiliary choice, reverses the two
lists and the step, and conjugates the list coefficient and phase. -/
theorem physical_edge_reverse {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (q ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (x y : PhysicalState P J ell) :
    physicalEdgeCoeff V C q (-ζ) (-k) (fun a b f => (starRingEnd ℂ) (K b a f)) aux y x =
      (starRingEnd ℂ) (physicalEdgeCoeff V C q ζ k K aux x y) := by
  classical
  by_cases h : physicalAdmissible C aux k x y
  · have hr := physical_admissible_reverse C aux k h
    have hD := physical_D_eq_of_shared C h.1 aux
    have hscalar : physicalAuxMass V C aux * physicalCompletionMass V C ell *
        physicalDamping P J ell q y.1 * physicalDamping P J ell q x.1 =
        physicalAuxMass V C aux * physicalCompletionMass V C ell *
        physicalDamping P J ell q x.1 * physicalDamping P J ell q y.1 := by ring
    simp only [physicalEdgeCoeff, if_pos h, if_pos hr, hscalar, ← hD,
      physical_phase_reverse, map_mul, Complex.conj_ofReal]
  · have hr : ¬ physicalAdmissible C aux (-k) y x := by
      exact fun hr => h ((physical_admissible_reverse_iff C aux k x y).mpr hr)
    simp only [physicalEdgeCoeff, if_neg h, if_neg hr, map_zero]

/-- Summing all auxiliary choices gives the unsymmetrized pattern kernel. -/
noncomputable def physicalPatternKernel {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (q ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (x y : PhysicalState P J ell) : ℂ :=
  ∑ aux : PhysicalAuxLabels P C, physicalEdgeCoeff V C q ζ k K aux x y

theorem physical_pattern_reverse {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (q ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (x y : PhysicalState P J ell) :
    physicalPatternKernel V C q (-ζ) (-k) (fun a b f => (starRingEnd ℂ) (K b a f)) y x =
      (starRingEnd ℂ) (physicalPatternKernel V C q ζ k K x y) := by
  unfold physicalPatternKernel
  simp only [physical_edge_reverse, map_sum]

/-- The constant state measure is compatible with the edge reversal. -/
theorem physical_pattern_weighted_reverse {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (q ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (x y : PhysicalState P J ell) :
    (physicalStateMass V J ell : ℂ) *
        physicalPatternKernel V C q (-ζ) (-k) (fun a b f => (starRingEnd ℂ) (K b a f)) y x =
      (starRingEnd ℂ) ((physicalStateMass V J ell : ℂ) * physicalPatternKernel V C q ζ k K x y) := by
  rw [physical_pattern_reverse, map_mul, Complex.conj_ofReal]
end

section
open Finset
/-- Multiplicativity of the phase permits the small/big group split. -/
theorem physical_phase_mul (ζ : ℝ) {D E : ℕ} (hD : 0 < D) (hE : 0 < E) :
    physicalPhase ζ (D * E) = physicalPhase ζ D * physicalPhase ζ E := by
  unfold physicalPhase
  rw [Nat.cast_mul, Real.log_mul (by exact_mod_cast ne_of_gt hD) (by exact_mod_cast ne_of_gt hE),
    ← Complex.exp_add]
  congr 1
  push_cast
  ring

/-- The mass of one permitted sampled edge before its bounded list
coefficient and its unit-modulus phase are applied. -/
noncomputable def physicalEdgeMass {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (q : ℝ) (k : ℤ) (aux : PhysicalAuxLabels P C) (x y : PhysicalState P J ell) : ℝ := by
  classical
  exact if physicalAdmissible C aux k x y then
    physicalAuxMass V C aux * physicalCompletionMass V C ell *
      physicalDamping P J ell q x.1 * physicalDamping P J ell q y.1
    else 0

theorem physical_edge_mass_nonneg {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    {q : ℝ} (k : ℤ) (hV : ∀ g, 0 < V g) (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (aux : PhysicalAuxLabels P C) (x y : PhysicalState P J ell) :
    0 ≤ physicalEdgeMass V C q k aux x y := by
  classical
  unfold physicalEdgeMass
  split_ifs
  · exact mul_nonneg (mul_nonneg
      (mul_nonneg (physical_aux_mass_nonneg V C (fun g => (hV g).le) aux)
        (physical_completion_mass_pos V C ell hV).le)
      (physical_damping_unit P J ell hq0 hq1 x.1).1)
      (physical_damping_unit P J ell hq0 hq1 y.1).1
  · exact le_rfl

/-- The sampled coefficient is its real mass times the list coefficient
and dilation phase. -/
theorem physical_edge_coefficient_factor {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (q ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (x y : PhysicalState P J ell) :
    physicalEdgeCoeff V C q ζ k K aux x y =
      (physicalEdgeMass V C q k aux x y : ℂ) * K x.2.val y.2.val aux *
        physicalPhase ζ (physicalD C x.2.val aux) := by
  classical
  unfold physicalEdgeCoeff physicalEdgeMass
  split_ifs <;> simp only [Complex.ofReal_zero, zero_mul]

/-- The absolute coefficient retains the exact support and real edge
mass; taking absolute values does not introduce a phase loss. -/
theorem physical_edge_norm {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    {q : ℝ} (ζ : ℝ) (k : ℤ) (hV : ∀ g, 0 < V g) (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (x y : PhysicalState P J ell) :
    ‖physicalEdgeCoeff V C q ζ k K aux x y‖ =
      physicalEdgeMass V C q k aux x y * ‖K x.2.val y.2.val aux‖ := by
  rw [physical_edge_coefficient_factor, norm_mul, norm_mul, physical_phase_norm, mul_one,
    Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (physical_edge_mass_nonneg V C k hV hq0 hq1 aux x y)]

/-- A uniform list-coefficient bound multiplies the exact nonnegative
edge mass, without dropping the transition support. -/
theorem physical_edge_norm_le {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    {q : ℝ} (ζ : ℝ) (k : ℤ) (hV : ∀ g, 0 < V g) (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (x y : PhysicalState P J ell) {B : ℝ}
    (hK : ‖K x.2.val y.2.val aux‖ ≤ B) :
    ‖physicalEdgeCoeff V C q ζ k K aux x y‖ ≤ physicalEdgeMass V C q k aux x y * B := by
  rw [physical_edge_norm V C ζ k hV hq0 hq1]
  exact mul_le_mul_of_nonneg_left hK (physical_edge_mass_nonneg V C k hV hq0 hq1 aux x y)

/-- The real mass is exactly invariant under edge reversal. -/
theorem physical_edge_mass_reverse {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (q : ℝ) (k : ℤ) (aux : PhysicalAuxLabels P C) (x y : PhysicalState P J ell) :
    physicalEdgeMass V C q (-k) aux y x = physicalEdgeMass V C q k aux x y := by
  classical
  by_cases h : physicalAdmissible C aux k x y
  · have hr := physical_admissible_reverse C aux k h
    simp only [physicalEdgeMass, if_pos h, if_pos hr]
    ring
  · have hr : ¬ physicalAdmissible C aux (-k) y x :=
      fun hr => h ((physical_admissible_reverse_iff C aux k x y).mpr hr)
    simp only [physicalEdgeMass, if_neg h, if_neg hr]
end

section
open Finset
/-- Mark lists satisfying divisibility are exactly lists taking their
values in the corresponding available divisor pools. -/
def physicalMarksAtEquiv {G : Type*} (P : G → Finset ℕ) (J ell : ℕ) (n : ℤ) :
    PhysicalMarksAt P J ell n ≃
      (∀ g, PhysicalSlots J ell ↪ ↥(physicalDivisorPool P g n)) where
  toFun labels g := physicalMarksEmbedding P J ell n labels g
  invFun f := ⟨fun g => {
    toFun := fun s => ⟨(f g s).val, (mem_filter.mp (f g s).property).1⟩
    inj' := by
      intro s t hst
      have he : (f g s).val = (f g t).val :=
        congrArg (fun p : P g => p.val) hst
      exact (f g).injective (Subtype.ext he) },
    fun g s => (mem_filter.mp (f g s).property).2⟩
  left_inv labels := by
    apply Subtype.ext
    funext g
    apply Function.Embedding.ext
    intro s
    rfl
  right_inv f := by
    funext g
    apply Function.Embedding.ext
    intro s
    rfl

/-- The full physical fiber has the expected product of falling-factorial
cardinalities; a group with too few divisors makes the fiber empty. -/
theorem physical_marks_fiber_card {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (J ell : ℕ) (n : ℤ) :
    Nat.card (PhysicalMarksAt P J ell n) =
      ∏ g, (physicalOmega P g n).descFactorial (J + ell) := by
  classical
  rw [Nat.card_congr (physicalMarksAtEquiv P J ell n), Nat.card_eq_fintype_card, Fintype.card_pi]
  apply prod_congr rfl
  intro g hg
  rw [Fintype.card_embedding_eq]
  simp only [Fintype.card_coe, Fintype.card_sum, Fintype.card_fin, physicalOmega]

/-- A finite position cutoff gives a finite type of physical states. -/
def physicalCutoffEquiv {G : Type*} (P : G → Finset ℕ) (J ell : ℕ) (I : Finset ℤ) :
    {x : PhysicalState P J ell // x.1 ∈ I} ≃ (Σ n : I, PhysicalMarksAt P J ell n.val) where
  toFun x := ⟨⟨x.val.1, x.property⟩, x.val.2⟩
  invFun y := ⟨⟨y.1.val, y.2⟩, y.1.property⟩
  left_inv x := by cases x with | mk x hx => cases x; rfl
  right_inv y := by cases y with | mk n labels => cases n; rfl

/-- No global instance is added: the finite cutoff enumeration is an
explicit object that can be installed locally when a finite matrix is used. -/
noncomputable abbrev physicalCutoffFintype {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (J ell : ℕ) (I : Finset ℤ) :
    Fintype {x : PhysicalState P J ell // x.1 ∈ I} := by
  classical
  exact Fintype.ofEquiv (Σ n : I, PhysicalMarksAt P J ell n.val) (physicalCutoffEquiv P J ell I).symm

/-- The cutoff cardinality is the sum of the exact fiber counts. -/
theorem physical_cutoff_card {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (J ell : ℕ) (I : Finset ℤ) :
    Nat.card {x : PhysicalState P J ell // x.1 ∈ I} =
      ∑ n ∈ I, ∏ g, (physicalOmega P g n).descFactorial (J + ell) := by
  classical
  rw [Nat.card_congr (physicalCutoffEquiv P J ell I), Nat.card_eq_fintype_card, Fintype.card_sigma]
  simp only [← Nat.card_eq_fintype_card, physical_marks_fiber_card]
  exact sum_coe_sort I (fun n => ∏ g, (physicalOmega P g n).descFactorial (J + ell))
end

section
open Finset
/-- Reorder a full list into its shared slots followed by the free
first-block slots and the final ell slots. -/
def physicalSlotSplit {J ell : ℕ} (C : Finset (Fin J)) :
    ({j : Fin J // j ∉ C} ⊕ (↥C ⊕ Fin ell)) ≃ PhysicalSlots J ell where
  toFun
    | Sum.inl s => Sum.inl s.val
    | Sum.inr (Sum.inl s) => Sum.inl s.val
    | Sum.inr (Sum.inr s) => Sum.inr s
  invFun
    | Sum.inl j => if hj : j ∈ C then Sum.inr (Sum.inl ⟨j, hj⟩) else Sum.inl ⟨j, hj⟩
    | Sum.inr j => Sum.inr (Sum.inr j)
  left_inv := by
    rintro (s | (s | s))
    · simp only [s.property, ↓reduceDIte]
    · simp only [s.property, ↓reduceDIte]
    · rfl
  right_inv := by
    intro s
    cases s with
    | inl j => by_cases hj : j ∈ C <;> simp only [hj, ↓reduceDIte]
    | inr j => rfl

/-- Reordering the slots identifies actual full-list completions with
the shared/unshared completion type used by the counting argument. -/
def physicalSlotCompletionEquiv {J ell : ℕ} {Q : Type*} (C : Finset (Fin J))
    (shared : {j : Fin J // j ∉ C} ↪ Q) :
    {f : PhysicalSlots J ell ↪ Q // ∀ s : {j : Fin J // j ∉ C}, f (Sum.inl s.val) = shared s} ≃
    {f : ({j : Fin J // j ∉ C} ⊕ (↥C ⊕ Fin ell)) ↪ Q // ∀ s, f (Sum.inl s) = shared s} where
  toFun f := ⟨(physicalSlotSplit C).toEmbedding.trans f.val, f.property⟩
  invFun f := ⟨(physicalSlotSplit C).symm.toEmbedding.trans f.val, by
    intro s
    change f.val ((physicalSlotSplit C).symm ((physicalSlotSplit C) (Sum.inl s))) = shared s
    rw [Equiv.symm_apply_apply]
    exact f.property s⟩
  left_inv f := by
    apply Subtype.ext
    apply Function.Embedding.ext
    intro s
    change f.val ((physicalSlotSplit C) ((physicalSlotSplit C).symm s)) = f.val s
    rw [Equiv.apply_symm_apply]
  right_inv f := by
    apply Subtype.ext
    apply Function.Embedding.ext
    intro s
    change f.val ((physicalSlotSplit C).symm ((physicalSlotSplit C) s)) = f.val s
    rw [Equiv.symm_apply_apply]

/-- The copied-slot type has cardinality J-|C|. -/
theorem physical_shared_slot_type_card {J : ℕ} (C : Finset (Fin J)) :
    Fintype.card {j : Fin J // j ∉ C} = J - C.card := by
  classical
  rw [Fintype.card_subtype_compl]
  simp only [Fintype.card_fin, Fintype.card_coe]

/-- The cardinality formula applies to the original ordering of the
physical slots, not only to an abstract shared/unshared sum. -/
theorem physical_target_completion_card {J ell : ℕ} {Q : Type*} [Fintype Q]
    (C : Finset (Fin J)) (shared : {j : Fin J // j ∉ C} ↪ Q) :
    Nat.card {f : PhysicalSlots J ell ↪ Q // ∀ s : {j : Fin J // j ∉ C}, f (Sum.inl s.val) = shared s} =
      (Fintype.card Q - (J - C.card)).descFactorial (C.card + ell) := by
  classical
  rw [Nat.card_congr (physicalSlotCompletionEquiv C shared), shared_completion_card,
    physical_shared_slot_type_card, Fintype.card_sum, Fintype.card_coe, Fintype.card_fin]

/-- The copied labels of an actual source state embed into the divisors
available at the target position n+kD. -/
def physicalSharedTargetEmbedding {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (x : PhysicalState P J ell) (aux : PhysicalAuxLabels P C) (k : ℤ) (g : G) :
    {j : Fin J // j ∉ C g} ↪
      ↥(physicalDivisorPool P g (x.1 + k * (physicalD C x.2.val aux : ℕ))) where
  toFun s := ⟨(x.2.val g (Sum.inl s.val)).val,
    mem_filter.mpr ⟨(x.2.val g (Sum.inl s.val)).property,
      physical_shared_divides_target C x aux k g s.val s.property⟩⟩
  inj' := by
    intro s t hst
    have he : (x.2.val g (Sum.inl s.val)).val = (x.2.val g (Sum.inl t.val)).val :=
      congrArg (fun p : ↥(physicalDivisorPool P g (x.1 + k * (physicalD C x.2.val aux : ℕ))) => p.val) hst
    have hs := (x.2.val g).injective (Subtype.ext he)
    exact Subtype.ext (Sum.inl.inj hs)

/-- The damped completion bound now applies in the original physical
slot order, uniformly in J and in the target divisor pool. -/
theorem exists_physical_target_mass_bound {q v : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hv : 0 < v) (ell m : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (J : ℕ) (C : Finset (Fin J)), C.card ≤ m →
      ∀ (Q : Type) [Fintype Q] (shared : {j : Fin J // j ∉ C} ↪ Q) (V : ℝ), v ≤ V →
        ((Nat.card {f : PhysicalSlots J ell ↪ Q //
          ∀ s : {j : Fin J // j ∉ C}, f (Sum.inl s.val) = shared s} : ℝ) *
          q^(((Fintype.card Q - (J + ell) : ℕ) : ℝ) / 2)) / V^(ell + C.card) ≤ A := by
  obtain ⟨A, hA, hbound⟩ := exists_completion_mass_bound_types hq0 hq1 hv (ell + m)
  refine ⟨A, hA, ?_⟩
  intro J C hC Q _ shared V hV
  have hcard : C.card ≤ J := by simpa only [Fintype.card_fin] using card_le_univ C
  have hM : Fintype.card {j : Fin J // j ∉ C} + Fintype.card (↥C ⊕ Fin ell) = J + ell := by
    rw [physical_shared_slot_type_card, Fintype.card_sum, Fintype.card_coe, Fintype.card_fin]
    omega
  have hU : Fintype.card (↥C ⊕ Fin ell) = ell + C.card := by
    simp only [Fintype.card_sum, Fintype.card_coe, Fintype.card_fin, Nat.add_comm]
  have hc := Nat.card_congr (physicalSlotCompletionEquiv (ell := ell) C shared)
  have he := hbound {j : Fin J // j ∉ C} (↥C ⊕ Fin ell) Q shared V hV
    (by rw [hU]; exact Nat.add_le_add_left hC ell)
  rw [hM, hU, ← hc] at he
  exact he
end

section
open Finset
noncomputable def physicalNextPosition {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (x : PhysicalState P J ell) (aux : PhysicalAuxLabels P C) (k : ℤ) : ℤ :=
  x.1 + k * (physicalD C x.2.val aux : ℕ)

abbrev PhysicalCompatibleTargets {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (x : PhysicalState P J ell) (aux : PhysicalAuxLabels P C) (k : ℤ) :=
  {y : PhysicalMarksAt P J ell (physicalNextPosition C x aux k) //
    physicalSharedCompatible C x.2.val y.val}

abbrev PhysicalLocalTargets {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (x : PhysicalState P J ell) (aux : PhysicalAuxLabels P C) (k : ℤ) (g : G) :=
  {f : PhysicalSlots J ell ↪ ↥(physicalDivisorPool P g (physicalNextPosition C x aux k)) //
    ∀ s : {j : Fin J // j ∉ C g}, f (Sum.inl s.val) = physicalSharedTargetEmbedding C x aux k g s}

/-- A compatible target state is exactly one independent ordered
completion in each group, in the original physical slot order. -/
noncomputable def physicalCompatibleTargetsEquiv {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (x : PhysicalState P J ell) (aux : PhysicalAuxLabels P C) (k : ℤ) :
    PhysicalCompatibleTargets C x aux k ≃ (∀ g, PhysicalLocalTargets C x aux k g) where
  toFun y g := ⟨physicalMarksEmbedding P J ell (physicalNextPosition C x aux k) y.val g, by
    intro s
    apply Subtype.ext
    exact (congrArg Subtype.val (y.property g s.val s.property)).symm⟩
  invFun f := ⟨(physicalMarksAtEquiv P J ell (physicalNextPosition C x aux k)).symm (fun g => (f g).val), by
    intro g j hj
    apply Subtype.ext
    exact (congrArg (fun p : ↥(physicalDivisorPool P g (physicalNextPosition C x aux k)) => p.val)
      ((f g).property ⟨j, hj⟩)).symm⟩
  left_inv y := by
    apply Subtype.ext
    apply Subtype.ext
    funext g
    apply Function.Embedding.ext
    intro s
    rfl
  right_inv f := by
    funext g
    apply Subtype.ext
    apply Function.Embedding.ext
    intro s
    rfl

theorem physical_compatible_targets_card {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (x : PhysicalState P J ell) (aux : PhysicalAuxLabels P C) (k : ℤ) :
    Nat.card (PhysicalCompatibleTargets C x aux k) =
      ∏ g, Nat.card (PhysicalLocalTargets C x aux k g) := by
  classical
  rw [Nat.card_congr (physicalCompatibleTargetsEquiv C x aux k), Nat.card_eq_fintype_card, Fintype.card_pi]
  simp only [Nat.card_eq_fintype_card]

/-- The complete compatible-target row mass, with target damping and
completion normalization, is bounded by one fixed constant per group.
The constant depends on ell+m, q, and the lower harmonic mass, but not J. -/
theorem exists_physical_compatible_target_mass_bound {q v : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (ell m : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (G : Type) [Fintype G] (P : G → Finset ℕ)
      (J : ℕ) (V : G → ℝ) (C : G → Finset (Fin J)),
      (∀ g, v ≤ V g) → (∀ g, (C g).card ≤ m) →
      ∀ (x : PhysicalState P J ell) (aux : PhysicalAuxLabels P C) (k : ℤ),
        (Nat.card (PhysicalCompatibleTargets C x aux k) : ℝ) * physicalCompletionMass V C ell *
          physicalDamping P J ell q (physicalNextPosition C x aux k) ≤ A^(Fintype.card G) := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_target_mass_bound hq0 hq1 hv ell m
  refine ⟨A, hA, ?_⟩
  intro G _ P J V C hV hC x aux k
  classical
  have hVp : ∀ g, 0 < V g := fun g => hv.trans_le (hV g)
  rw [physical_compatible_targets_card, Nat.cast_prod]
  unfold physicalCompletionMass physicalDamping
  rw [← prod_mul_distrib, ← prod_mul_distrib]
  have hpoint : ∀ g, (Nat.card (PhysicalLocalTargets C x aux k g) : ℝ) *
      (1 / (V g)^(ell + (C g).card)) *
      q^(((physicalOmega P g (physicalNextPosition C x aux k) - (J + ell) : ℕ) : ℝ) / 2) ≤ A := by
    intro g
    have hh := hbound J (C g) (hC g)
      ↥(physicalDivisorPool P g (physicalNextPosition C x aux k))
      (physicalSharedTargetEmbedding C x aux k g) (V g) (hV g)
    have hcard : Nat.card ↥(physicalDivisorPool P g (physicalNextPosition C x aux k)) =
        physicalOmega P g (physicalNextPosition C x aux k) := by
      rw [Nat.card_eq_fintype_card, Fintype.card_coe]
      rfl
    rw [← Nat.card_eq_fintype_card, hcard] at hh
    have hlocal : ((Nat.card (PhysicalLocalTargets C x aux k g) : ℝ) *
        q^(((physicalOmega P g (physicalNextPosition C x aux k) - (J + ell) : ℕ) : ℝ) / 2)) /
          (V g)^(ell + (C g).card) ≤ A := by
      convert hh using 1

    calc
      _ = ((Nat.card (PhysicalLocalTargets C x aux k g) : ℝ) *
          q^(((physicalOmega P g (physicalNextPosition C x aux k) - (J + ell) : ℕ) : ℝ) / 2)) /
            (V g)^(ell + (C g).card) := by ring
      _ ≤ A := hlocal
  calc
    _ ≤ ∏ _g : G, A := by
      apply prod_le_prod₀
      · intro g hg
        exact mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (div_nonneg zero_le_one (pow_nonneg (hVp g).le _)))
          (Real.rpow_nonneg hq0 _)
      · intro g hg
        exact hpoint g
    _ = _ := by simp
end

section
open Finset Classical
theorem physical_state_ext {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    {x y : PhysicalState P J ell} (hpos : x.1 = y.1) (hmarks : x.2.val = y.2.val) : x = y := by
  rcases x with ⟨n, a, ha⟩
  rcases y with ⟨r, b, hb⟩
  dsimp only at hpos hmarks
  cases hpos
  cases hmarks
  rfl

/-- Forgetting the endpoint exclusion bans embeds admissible targets
into the finite collection of compatible completions. -/
def physicalAdmissibleTargetEmbedding {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (x : PhysicalState P J ell) (aux : PhysicalAuxLabels P C) (k : ℤ) :
    {y : PhysicalState P J ell // physicalAdmissible C aux k x y} ↪
      PhysicalCompatibleTargets C x aux k where
  toFun y := ⟨⟨y.val.2.val, by
    intro g s
    rw [physicalNextPosition, ← y.property.2.2.2]
    exact y.val.2.property g s⟩, y.property.1⟩
  inj' := by
    intro y z h
    apply Subtype.ext
    apply physical_state_ext
    · exact y.property.2.2.2.trans z.property.2.2.2.symm
    · exact congrArg (fun t : PhysicalCompatibleTargets C x aux k => t.val.val) h

/-- A finite cutoff or additional restriction can only reduce the number
of admissible targets. -/
theorem physical_admissible_targets_card_le {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (x : PhysicalState P J ell) (aux : PhysicalAuxLabels P C) (k : ℤ)
    (rows : Finset (PhysicalState P J ell)) :
    (rows.filter (fun y => physicalAdmissible C aux k x y)).card ≤
      Nat.card (PhysicalCompatibleTargets C x aux k) := by
  classical
  let f : ↥(rows.filter (fun y => physicalAdmissible C aux k x y)) →
      PhysicalCompatibleTargets C x aux k := fun y =>
    physicalAdmissibleTargetEmbedding C x aux k ⟨y.val, (mem_filter.mp y.property).2⟩
  have hf : Function.Injective f := by
    intro y z h
    have he := (physicalAdmissibleTargetEmbedding C x aux k).injective h
    exact Subtype.ext (congrArg (fun t : {y : PhysicalState P J ell // physicalAdmissible C aux k x y} => t.val) he)
  simpa only [Fintype.card_coe, Nat.card_eq_fintype_card] using Fintype.card_le_of_injective f hf

/-- Every supported edge has the same target position and therefore the
same endpoint damping. This gives an exact row-mass formula. -/
theorem physical_edge_mass_sum {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (q : ℝ) (k : ℤ) (aux : PhysicalAuxLabels P C) (x : PhysicalState P J ell)
    (rows : Finset (PhysicalState P J ell)) :
    (∑ y ∈ rows, physicalEdgeMass V C q k aux x y) =
      (rows.filter (fun y => physicalAdmissible C aux k x y)).card *
        (physicalAuxMass V C aux * physicalCompletionMass V C ell *
          physicalDamping P J ell q x.1 * physicalDamping P J ell q (physicalNextPosition C x aux k)) := by
  classical
  have he : (∑ y ∈ rows, physicalEdgeMass V C q k aux x y) =
      ∑ _y ∈ rows.filter (fun y => physicalAdmissible C aux k x y),
        physicalAuxMass V C aux * physicalCompletionMass V C ell *
          physicalDamping P J ell q x.1 * physicalDamping P J ell q (physicalNextPosition C x aux k) := by
    rw [sum_filter]
    apply sum_congr rfl
    intro y hy
    by_cases ha : physicalAdmissible C aux k x y
    · simp only [physicalEdgeMass, if_pos ha]
      rw [ha.2.2.2]
      rfl
    · simp only [physicalEdgeMass, if_neg ha]
  rw [he, sum_const, nsmul_eq_mul]

/-- The damped completion estimate bounds the mass of actual edges,
including all exclusion bans and any finite cutoff. -/
theorem physical_edge_mass_row_le {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    {q A : ℝ} (k : ℤ) (hV : ∀ g, 0 < V g) (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (aux : PhysicalAuxLabels P C) (x : PhysicalState P J ell)
    (rows : Finset (PhysicalState P J ell))
    (hA : (Nat.card (PhysicalCompatibleTargets C x aux k) : ℝ) * physicalCompletionMass V C ell *
      physicalDamping P J ell q (physicalNextPosition C x aux k) ≤ A) :
    (∑ y ∈ rows, physicalEdgeMass V C q k aux x y) ≤ physicalAuxMass V C aux * A := by
  classical
  have haux := physical_aux_mass_nonneg V C (fun g => (hV g).le) aux
  have hc := (physical_completion_mass_pos V C ell hV).le
  have hx := physical_damping_unit P J ell hq0 hq1 x.1
  have ht := (physical_damping_unit P J ell hq0 hq1 (physicalNextPosition C x aux k)).1
  have hcount : ((rows.filter (fun y => physicalAdmissible C aux k x y)).card : ℝ) ≤
      (Nat.card (PhysicalCompatibleTargets C x aux k) : ℝ) := by
    exact_mod_cast physical_admissible_targets_card_le C x aux k rows
  rw [physical_edge_mass_sum]
  calc
    _ ≤ (Nat.card (PhysicalCompatibleTargets C x aux k) : ℝ) *
        (physicalAuxMass V C aux * physicalCompletionMass V C ell *
          physicalDamping P J ell q x.1 * physicalDamping P J ell q (physicalNextPosition C x aux k)) :=
      mul_le_mul_of_nonneg_right hcount (mul_nonneg (mul_nonneg (mul_nonneg haux hc) hx.1) ht)
    _ = physicalAuxMass V C aux * ((Nat.card (PhysicalCompatibleTargets C x aux k) : ℝ) *
        physicalCompletionMass V C ell * physicalDamping P J ell q (physicalNextPosition C x aux k)) *
          physicalDamping P J ell q x.1 := by ring
    _ ≤ physicalAuxMass V C aux * ((Nat.card (PhysicalCompatibleTargets C x aux k) : ℝ) *
        physicalCompletionMass V C ell * physicalDamping P J ell q (physicalNextPosition C x aux k)) * 1 :=
      mul_le_mul_of_nonneg_left hx.2 (mul_nonneg haux (mul_nonneg (mul_nonneg (Nat.cast_nonneg _) hc) ht))
    _ ≤ physicalAuxMass V C aux * A := by
      rw [mul_one]
      exact mul_le_mul_of_nonneg_left hA haux

/-- The absolute row sum of a sampled physical coefficient is bounded
by its auxiliary probability times the damped completion bound. -/
theorem physical_edge_norm_row_le {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    {q A B : ℝ} (ζ : ℝ) (k : ℤ) (hV : ∀ g, 0 < V g) (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (x : PhysicalState P J ell)
    (rows : Finset (PhysicalState P J ell)) (hB : 0 ≤ B)
    (hK : ∀ y ∈ rows, ‖K x.2.val y.2.val aux‖ ≤ B)
    (hA : (Nat.card (PhysicalCompatibleTargets C x aux k) : ℝ) * physicalCompletionMass V C ell *
      physicalDamping P J ell q (physicalNextPosition C x aux k) ≤ A) :
    (∑ y ∈ rows, ‖physicalEdgeCoeff V C q ζ k K aux x y‖) ≤ physicalAuxMass V C aux * A * B := by
  calc
    _ ≤ ∑ y ∈ rows, physicalEdgeMass V C q k aux x y * B :=
      sum_le_sum (fun y hy => physical_edge_norm_le V C ζ k hV hq0 hq1 K aux x y (hK y hy))
    _ = (∑ y ∈ rows, physicalEdgeMass V C q k aux x y) * B := by rw [sum_mul]
    _ ≤ _ := mul_le_mul_of_nonneg_right (physical_edge_mass_row_le V C k hV hq0 hq1 aux x rows hA) hB
end

section
open Finset
/-- Summing the sampled edge bounds costs exactly the total auxiliary
probability, which is one. -/
theorem physical_pattern_norm_row_le {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    {q A B : ℝ} (ζ : ℝ) (k : ℤ) (hV : ∀ g, 0 < V g) (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (x : PhysicalState P J ell) (rows : Finset (PhysicalState P J ell)) (hB : 0 ≤ B)
    (hK : ∀ aux y, y ∈ rows → ‖K x.2.val y.2.val aux‖ ≤ B)
    (hA : ∀ aux, (Nat.card (PhysicalCompatibleTargets C x aux k) : ℝ) * physicalCompletionMass V C ell *
      physicalDamping P J ell q (physicalNextPosition C x aux k) ≤ A) :
    (∑ y ∈ rows, ‖physicalPatternKernel V C q ζ k K x y‖) ≤ A * B := by
  classical
  calc
    _ ≤ ∑ y ∈ rows, ∑ aux : PhysicalAuxLabels P C, ‖physicalEdgeCoeff V C q ζ k K aux x y‖ :=
      sum_le_sum (fun y _ => norm_sum_le _ _)
    _ = ∑ aux : PhysicalAuxLabels P C, ∑ y ∈ rows, ‖physicalEdgeCoeff V C q ζ k K aux x y‖ := sum_comm
    _ ≤ ∑ aux : PhysicalAuxLabels P C, physicalAuxMass V C aux * A * B :=
      sum_le_sum (fun aux _ => physical_edge_norm_row_le V C ζ k hV hq0 hq1 K aux x rows hB (hK aux) (hA aux))
    _ = (∑ aux : PhysicalAuxLabels P C, physicalAuxMass V C aux) * A * B := by rw [sum_mul, sum_mul]
    _ = A * B := by rw [physical_aux_mass_sum V C hV hMass, one_mul]

/-- The physical kernel has a bound of one fixed constant per prime
group, independent of the number of copied mark slots and the cutoff. -/
theorem exists_physical_pattern_row_bound {q v : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (ell m : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (G : Type) [Fintype G] [DecidableEq G] (P : G → Finset ℕ)
      (J : ℕ) (V : G → ℝ) (C : G → Finset (Fin J)),
      (∀ g, v ≤ V g) → (∀ g, (C g).card ≤ m) →
      (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) →
      ∀ (ζ : ℝ) (k : ℤ)
        (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
        (B : ℝ), 0 ≤ B → (∀ a b aux, ‖K a b aux‖ ≤ B) →
        ∀ (x : PhysicalState P J ell) (rows : Finset (PhysicalState P J ell)),
        (∑ y ∈ rows, ‖physicalPatternKernel V C q ζ k K x y‖) ≤ A^(Fintype.card G) * B := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_compatible_target_mass_bound hq0 hq1 hv ell m
  refine ⟨A, hA, ?_⟩
  intro G _ _ P J V C hV hC hMass ζ k K B hB hK x rows
  exact physical_pattern_norm_row_le V C ζ k (fun g => hv.trans_le (hV g)) hq0 hq1.le hMass K x rows hB
    (fun aux y _ => hK x.2.val y.2.val aux) (fun aux => hbound G P J V C hV hC x aux k)

/-- Edge reversal preserves absolute values, so the reverse kernel
provides exactly the column estimates for the original kernel. -/
theorem physical_pattern_norm_reverse {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (q ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (x y : PhysicalState P J ell) :
    ‖physicalPatternKernel V C q (-ζ) (-k) (fun a b f => (starRingEnd ℂ) (K b a f)) y x‖ =
      ‖physicalPatternKernel V C q ζ k K x y‖ := by
  rw [physical_pattern_reverse]
  exact RCLike.norm_conj _
end

section
open Finset
/-- A uniform Schur bound for the actual physical kernel. The constant
is independent of the number of shared slots, the translation step,
the phase, and the finite position or state cutoff. -/
theorem exists_physical_pattern_schur_bound {q v : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (ell m : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (G : Type) [Fintype G] [DecidableEq G] (P : G → Finset ℕ)
      (J : ℕ) (V : G → ℝ) (C : G → Finset (Fin J)),
      (∀ g, v ≤ V g) → (∀ g, (C g).card ≤ m) →
      (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) →
      ∀ (ζ : ℝ) (k : ℤ)
        (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
        (B : ℝ), 0 ≤ B → (∀ a b aux, ‖K a b aux‖ ≤ B) →
        ∀ (rows : Finset (PhysicalState P J ell)) (f : PhysicalState P J ell → ℂ),
        (∑ x ∈ rows, physicalStateMass V J ell *
          ‖∑ y ∈ rows, physicalPatternKernel V C q ζ k K x y * f y‖^2) ≤
        (A^(Fintype.card G) * B)^2 * ∑ y ∈ rows, physicalStateMass V J ell * ‖f y‖^2 := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_pattern_row_bound hq0 hq1 hv ell m
  refine ⟨A, hA, ?_⟩
  intro G _ _ P J V C hV hC hMass ζ k K B hB hK rows f
  have hμ := (physical_state_mass_pos V (fun g => hv.trans_le (hV g)) J ell).le
  have hr := hbound G P J V C hV hC hMass ζ k K B hB hK
  have hK' : ∀ a b aux, ‖(starRingEnd ℂ) (K b a aux)‖ ≤ B := by
    intro a b aux
    rw [RCLike.norm_conj]
    exact hK b a aux
  have hr' := hbound G P J V C hV hC hMass (-ζ) (-k)
    (fun a b aux => (starRingEnd ℂ) (K b a aux)) B hB hK'
  have hrow : ∀ x ∈ rows,
      (∑ y ∈ rows, ‖physicalPatternKernel V C q ζ k K x y‖ * (1 : ℝ)) ≤
        (A^(Fintype.card G) * B) * 1 := by
    intro x _
    simpa only [mul_one] using hr x rows
  have hcol : ∀ y ∈ rows,
      (∑ x ∈ rows, physicalStateMass V J ell * ‖physicalPatternKernel V C q ζ k K x y‖ * (1 : ℝ)) ≤
        (A^(Fintype.card G) * B) * physicalStateMass V J ell * 1 := by
    intro y _
    have hh : (∑ x ∈ rows, ‖physicalPatternKernel V C q ζ k K x y‖) ≤ A^(Fintype.card G) * B := by
      simpa only [physical_pattern_norm_reverse] using hr' y rows
    simp only [mul_one]
    rw [← mul_sum]
    exact (mul_le_mul_of_nonneg_left hh hμ).trans_eq (mul_comm _ _)
  have hh := finite_weighted_schur_transition rows (fun _ => physicalStateMass V J ell)
    (fun _ => (1 : ℝ)) (physicalPatternKernel V C q ζ k K) (fun _ _ => hμ)
    (fun _ _ => zero_lt_one) hrow hcol f
  simpa only [pow_two] using hh
end

section
open Finset
abbrev PhysicalPermutations (G : Type*) (J ell : ℕ) :=
  G → Equiv.Perm (PhysicalSlots J ell)

/-- Reorder each group's ordered marks by an independent slot permutation. -/
def physicalPermutationEquiv {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (σ : PhysicalPermutations G J ell) : PhysicalState P J ell ≃ PhysicalState P J ell where
  toFun x := ⟨x.1, ⟨fun g => (σ g).toEmbedding.trans (x.2.val g), fun g s => x.2.property g (σ g s)⟩⟩
  invFun x := ⟨x.1, ⟨fun g => (σ g).symm.toEmbedding.trans (x.2.val g), fun g s => x.2.property g ((σ g).symm s)⟩⟩
  left_inv x := by
    apply physical_state_ext
    · rfl
    · funext g
      apply Function.Embedding.ext
      intro s
      exact congrArg (x.2.val g) ((σ g).apply_symm_apply s)
  right_inv x := by
    apply physical_state_ext
    · rfl
    · funext g
      apply Function.Embedding.ext
      intro s
      exact congrArg (x.2.val g) ((σ g).symm_apply_apply s)

theorem physical_permutation_position {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (σ : PhysicalPermutations G J ell) (x : PhysicalState P J ell) :
    (physicalPermutationEquiv σ x).1 = x.1 := rfl

theorem physical_permutation_one {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (x : PhysicalState P J ell) : physicalPermutationEquiv (1 : PhysicalPermutations G J ell) x = x := by
  apply physical_state_ext rfl
  rfl

/-- Successive reordering composes the slot maps in reverse order on
states, as expected for precomposition of an ordered list. -/
theorem physical_permutation_mul {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (σ τ : PhysicalPermutations G J ell) (x : PhysicalState P J ell) :
    physicalPermutationEquiv σ (physicalPermutationEquiv τ x) = physicalPermutationEquiv (τ * σ) x := by
  apply physical_state_ext rfl
  rfl

theorem physical_permutation_inv {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (σ : PhysicalPermutations G J ell) :
    (physicalPermutationEquiv (P := P) σ).symm = physicalPermutationEquiv σ⁻¹ := rfl

/-- Uniformly average over all independent within-group slot permutations. -/
noncomputable def physicalSymmetrize {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (f : PhysicalState P J ell → ℂ)
    (x : PhysicalState P J ell) : ℂ :=
  (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
    ∑ σ : PhysicalPermutations G J ell, f (physicalPermutationEquiv σ x)

/-- Averaging preserves constant functions. -/
theorem physical_symmetrize_const {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (c : ℂ) (x : PhysicalState P J ell) :
    physicalSymmetrize (fun _ => c) x = c := by
  classical
  unfold physicalSymmetrize
  rw [sum_const, card_univ, nsmul_eq_mul, ← mul_assoc, inv_mul_cancel₀, one_mul]
  exact_mod_cast Fintype.card_ne_zero

/-- The averaged function is invariant under every mark permutation. -/
theorem physical_symmetrize_invariant {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (f : PhysicalState P J ell → ℂ)
    (τ : PhysicalPermutations G J ell) (x : PhysicalState P J ell) :
    physicalSymmetrize f (physicalPermutationEquiv τ x) = physicalSymmetrize f x := by
  classical
  unfold physicalSymmetrize
  simp only [physical_permutation_mul]
  congr 1
  exact Equiv.sum_comp (Equiv.mulLeft τ) (fun σ => f (physicalPermutationEquiv σ x))

/-- The uniform mark average is a projection. -/
theorem physical_symmetrize_idempotent {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (f : PhysicalState P J ell → ℂ)
    (x : PhysicalState P J ell) : physicalSymmetrize (physicalSymmetrize f) x = physicalSymmetrize f x := by
  classical
  change (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
    (∑ σ : PhysicalPermutations G J ell, physicalSymmetrize f (physicalPermutationEquiv σ x)) = physicalSymmetrize f x
  simp only [physical_symmetrize_invariant]
  exact physical_symmetrize_const (physicalSymmetrize f x) x
end

section
open Finset
theorem finite_uniform_average_row_bound {A X : Type*} [Fintype A] [Nonempty A]
    (rows : Finset X) (K : A → X → ℂ) {C : ℝ} (hC : 0 ≤ C)
    (hrow : ∀ a, (∑ y ∈ rows, ‖K a y‖) ≤ C) :
    (∑ y ∈ rows, ‖(Fintype.card A : ℂ)⁻¹ * ∑ a, K a y‖) ≤ C := by
  classical
  have hn : (Fintype.card A : ℝ) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hmass : (∑ _a : A, (Fintype.card A : ℝ)⁻¹) ≤ 1 := by
    simp only [sum_const, card_univ, nsmul_eq_mul, mul_inv_cancel₀ hn, le_refl]
  have hh := auxiliary_complex_row_bound (univ : Finset A) rows
    (fun _ => (Fintype.card A : ℝ)⁻¹) K hC
    (fun _ _ => inv_nonneg.mpr (Nat.cast_nonneg _)) hmass (fun a _ => hrow a)
  simpa only [Complex.ofReal_inv, Complex.ofReal_natCast, ← mul_sum] using hh

/-- A row estimate over all finite sets remains true after any bijective
reindexing of the source and target states. -/
theorem equiv_kernel_row_bound {X : Type*} (K : X → X → ℂ) {C : ℝ}
    (hrow : ∀ x rows, (∑ y ∈ rows, ‖K x y‖) ≤ C)
    (a b : X ≃ X) (x : X) (rows : Finset X) :
    (∑ y ∈ rows, ‖K (a x) (b y)‖) ≤ C := by
  have hh := hrow (a x) (rows.map b.toEmbedding)
  simpa only [sum_map, Equiv.coe_toEmbedding] using hh

/-- Averaging independently on both ends of a kernel preserves its
absolute row bound, including for cutoffs not invariant under the maps. -/
theorem finite_permutation_kernel_row_bound {A B X : Type*}
    [Fintype A] [Nonempty A] [Fintype B] [Nonempty B]
    (a : A → X ≃ X) (b : B → X ≃ X) (K : X → X → ℂ) {C : ℝ} (hC : 0 ≤ C)
    (hrow : ∀ x rows, (∑ y ∈ rows, ‖K x y‖) ≤ C) (x : X) (rows : Finset X) :
    (∑ y ∈ rows, ‖(Fintype.card A : ℂ)⁻¹ * ∑ i,
      (Fintype.card B : ℂ)⁻¹ * ∑ j, K (a i x) (b j y)‖) ≤ C := by
  apply finite_uniform_average_row_bound rows _ hC
  intro i
  apply finite_uniform_average_row_bound rows _ hC
  intro j
  exact equiv_kernel_row_bound K hrow (a i) (b j) x rows
end

section
open Finset
noncomputable def physicalSymmetricKernel {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (K : PhysicalState P J ell → PhysicalState P J ell → ℂ)
    (x y : PhysicalState P J ell) : ℂ :=
  physicalSymmetrize (fun a => physicalSymmetrize (K a) y) x

theorem physical_symmetric_kernel_double_sum {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (K : PhysicalState P J ell → PhysicalState P J ell → ℂ)
    (x y : PhysicalState P J ell) :
    physicalSymmetricKernel K x y = (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
      (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
      ∑ σ : PhysicalPermutations G J ell, ∑ τ : PhysicalPermutations G J ell,
        K (physicalPermutationEquiv σ x) (physicalPermutationEquiv τ y) := by
  classical
  unfold physicalSymmetricKernel physicalSymmetrize
  rw [← mul_sum, mul_assoc]

/-- Symmetrizing the transpose is the transpose of the symmetrized kernel. -/
theorem physical_symmetric_kernel_transpose {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (K : PhysicalState P J ell → PhysicalState P J ell → ℂ)
    (x y : PhysicalState P J ell) :
    physicalSymmetricKernel (fun a b => K b a) x y = physicalSymmetricKernel K y x := by
  classical
  rw [physical_symmetric_kernel_double_sum, physical_symmetric_kernel_double_sum]
  congr 1
  exact sum_comm

/-- Averaging permutations on both endpoints preserves every uniform
absolute row bound on finite subsets of the physical state space. -/
theorem physical_symmetric_kernel_row_bound {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (K : PhysicalState P J ell → PhysicalState P J ell → ℂ)
    {A : ℝ} (hA : 0 ≤ A)
    (hrow : ∀ x rows, (∑ y ∈ rows, ‖K x y‖) ≤ A)
    (x : PhysicalState P J ell) (rows : Finset (PhysicalState P J ell)) :
    (∑ y ∈ rows, ‖physicalSymmetricKernel K x y‖) ≤ A := by
  exact finite_permutation_kernel_row_bound
    (fun σ : PhysicalPermutations G J ell => physicalPermutationEquiv σ)
    (fun τ : PhysicalPermutations G J ell => physicalPermutationEquiv τ) K hA hrow x rows

/-- The corresponding column bound follows by transposing before averaging. -/
theorem physical_symmetric_kernel_column_bound {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (K : PhysicalState P J ell → PhysicalState P J ell → ℂ)
    {A : ℝ} (hA : 0 ≤ A)
    (hcol : ∀ y rows, (∑ x ∈ rows, ‖K x y‖) ≤ A)
    (y : PhysicalState P J ell) (rows : Finset (PhysicalState P J ell)) :
    (∑ x ∈ rows, ‖physicalSymmetricKernel K x y‖) ≤ A := by
  have hh := physical_symmetric_kernel_row_bound (fun a b => K b a) hA hcol y rows
  simpa only [physical_symmetric_kernel_transpose] using hh
end

section
open Finset
/-- Absolute row and column bounds for the full symmetrized physical
operator. The only pattern loss is the sum of the coefficient bounds. -/
theorem exists_physical_operator_bounds {q v : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (ell m : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (G : Type) [Fintype G] [DecidableEq G] (P : G → Finset ℕ)
      (J : ℕ) (V : G → ℝ), (∀ g, v ≤ V g) →
      (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) →
      ∀ (I : Type) (patterns : Finset I) (C : I → G → Finset (Fin J))
        (ζ : I → ℝ) (k : I → ℤ)
        (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
        (B : I → ℝ),
        (∀ i ∈ patterns, ∀ g, (C i g).card ≤ m) →
        (∀ i ∈ patterns, 0 ≤ B i) →
        (∀ i ∈ patterns, ∀ a b aux, ‖K i a b aux‖ ≤ B i) →
        ∀ (x : PhysicalState P J ell) (rows : Finset (PhysicalState P J ell)),
        let W := fun a b => ∑ i ∈ patterns, physicalPatternKernel V (C i) q (ζ i) (k i) (K i) a b
        (∑ y ∈ rows, ‖physicalSymmetricKernel W x y‖) ≤ (∑ i ∈ patterns, B i) * A^(Fintype.card G) ∧
        (∑ y ∈ rows, ‖physicalSymmetricKernel W y x‖) ≤ (∑ i ∈ patterns, B i) * A^(Fintype.card G) := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_pattern_row_bound hq0 hq1 hv ell m
  refine ⟨A, hA, ?_⟩
  intro G _ _ P J V hV hMass I patterns C ζ k K B hC hB hK x rows
  classical
  let W := fun a b => ∑ i ∈ patterns, physicalPatternKernel V (C i) q (ζ i) (k i) (K i) a b
  have hnonneg : 0 ≤ (∑ i ∈ patterns, B i) * A^(Fintype.card G) :=
    mul_nonneg (sum_nonneg hB) (pow_nonneg (zero_le_one.trans hA) _)
  have hrow : ∀ a s, (∑ b ∈ s, ‖W a b‖) ≤ (∑ i ∈ patterns, B i) * A^(Fintype.card G) := by
    intro a s
    apply pattern_absolute_row_bound patterns s _ B (A^(Fintype.card G))
    intro i hi
    have hh := hbound G P J V (C i) hV (hC i hi) hMass (ζ i) (k i) (K i) (B i) (hB i hi) (hK i hi) a s
    simpa only [mul_comm] using hh
  have hcol : ∀ b s, (∑ a ∈ s, ‖W a b‖) ≤ (∑ i ∈ patterns, B i) * A^(Fintype.card G) := by
    intro b s
    apply pattern_absolute_row_bound patterns s _ B (A^(Fintype.card G))
    intro i hi
    have hKi : ∀ a b aux, ‖(starRingEnd ℂ) (K i b a aux)‖ ≤ B i := by
      intro a b aux
      rw [RCLike.norm_conj]
      exact hK i hi b a aux
    have hh := hbound G P J V (C i) hV (hC i hi) hMass (-(ζ i)) (-(k i))
      (fun a b aux => (starRingEnd ℂ) (K i b a aux)) (B i) (hB i hi) hKi b s
    simpa only [physical_pattern_norm_reverse, mul_comm] using hh
  exact ⟨physical_symmetric_kernel_row_bound W hnonneg hrow x rows,
    physical_symmetric_kernel_column_bound W hnonneg hcol x rows⟩

/-- Any constant-measure kernel with uniform row and column bounds
satisfies the finite weighted Schur estimate. -/
theorem constant_measure_schur {X : Type*} (rows : Finset X) (K : X → X → ℂ)
    {μ A : ℝ} (hμ : 0 ≤ μ)
    (hrow : ∀ x ∈ rows, (∑ y ∈ rows, ‖K x y‖) ≤ A)
    (hcol : ∀ y ∈ rows, (∑ x ∈ rows, ‖K x y‖) ≤ A) (f : X → ℂ) :
    (∑ x ∈ rows, μ * ‖∑ y ∈ rows, K x y * f y‖^2) ≤ A^2 * ∑ y ∈ rows, μ * ‖f y‖^2 := by
  have hr : ∀ x ∈ rows, (∑ y ∈ rows, ‖K x y‖ * (1 : ℝ)) ≤ A * 1 := by
    simpa only [mul_one] using hrow
  have hc : ∀ y ∈ rows, (∑ x ∈ rows, μ * ‖K x y‖ * (1 : ℝ)) ≤ A * μ * 1 := by
    intro y hy
    simp only [mul_one]
    rw [← mul_sum]
    exact (mul_le_mul_of_nonneg_left (hcol y hy) hμ).trans_eq (mul_comm _ _)
  simpa only [pow_two] using finite_weighted_schur_transition rows (fun _ => μ) (fun _ => (1 : ℝ))
    K (fun _ _ => hμ) (fun _ _ => zero_lt_one) hr hc f
end

section
open Finset
/-- Enumerate all physical states whose position belongs to a finite set. -/
noncomputable def physicalCutoff {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (J ell : ℕ) (I : Finset ℤ) : Finset (PhysicalState P J ell) := by
  classical
  letI := physicalCutoffFintype P J ell I
  exact (univ : Finset {x : PhysicalState P J ell // x.1 ∈ I}).map ⟨Subtype.val, Subtype.val_injective⟩

theorem mem_physical_cutoff {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (J ell : ℕ) (I : Finset ℤ) (x : PhysicalState P J ell) :
    x ∈ physicalCutoff P J ell I ↔ x.1 ∈ I := by
  classical
  unfold physicalCutoff
  simp only [mem_map, mem_univ, true_and, Function.Embedding.coeFn_mk]
  constructor
  · rintro ⟨y, rfl⟩
    exact y.property
  · intro hx
    exact ⟨⟨x, hx⟩, rfl⟩

theorem physical_cutoff_permutation {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (J ell : ℕ) (I : Finset ℤ) (σ : PhysicalPermutations G J ell) (x : PhysicalState P J ell) :
    physicalPermutationEquiv σ x ∈ physicalCutoff P J ell I ↔ x ∈ physicalCutoff P J ell I := by
  rw [mem_physical_cutoff, mem_physical_cutoff, physical_permutation_position]

/-- A permutation of the marks preserves finite counting measure on
any complete position cutoff. -/
theorem physical_permutation_sum {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (J ell : ℕ) (I : Finset ℤ) (σ : PhysicalPermutations G J ell)
    (f : PhysicalState P J ell → ℂ) :
    (∑ x ∈ physicalCutoff P J ell I, f (physicalPermutationEquiv σ x)) =
      ∑ x ∈ physicalCutoff P J ell I, f x := by
  apply sum_equiv (physicalPermutationEquiv σ)
  · intro x
    exact (physical_cutoff_permutation P J ell I σ x).symm
  · intro x _
    rfl

/-- Moving a mark permutation across the finite inner product replaces
it by its inverse. -/
theorem physical_permutation_pairing {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (J ell : ℕ) (I : Finset ℤ) (σ : PhysicalPermutations G J ell)
    (f g : PhysicalState P J ell → ℂ) :
    (∑ x ∈ physicalCutoff P J ell I, (starRingEnd ℂ) (f (physicalPermutationEquiv σ x)) * g x) =
      ∑ x ∈ physicalCutoff P J ell I, (starRingEnd ℂ) (f x) * g (physicalPermutationEquiv σ⁻¹ x) := by
  have hh := physical_permutation_sum P J ell I σ
    (fun x => (starRingEnd ℂ) (f x) * g ((physicalPermutationEquiv σ).symm x))
  simpa only [physical_permutation_inv, physical_permutation_mul, mul_inv_cancel, physical_permutation_one] using hh

/-- Uniform averaging over all mark permutations is self-adjoint on
every complete finite position cutoff. Constant state normalization
may therefore be multiplied into both sides. -/
theorem physical_symmetrize_self_adjoint {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (J ell : ℕ) (I : Finset ℤ)
    (f g : PhysicalState P J ell → ℂ) :
    (∑ x ∈ physicalCutoff P J ell I, (starRingEnd ℂ) (physicalSymmetrize f x) * g x) =
      ∑ x ∈ physicalCutoff P J ell I, (starRingEnd ℂ) (f x) * physicalSymmetrize g x := by
  classical
  calc
    _ = (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
        ∑ σ : PhysicalPermutations G J ell, ∑ x ∈ physicalCutoff P J ell I,
          (starRingEnd ℂ) (f (physicalPermutationEquiv σ x)) * g x := by
      simp only [physicalSymmetrize, map_mul, map_inv₀, Complex.conj_natCast, map_sum]
      simp only [sum_mul, mul_sum]
      rw [sum_comm]
      apply sum_congr rfl
      intro σ _
      apply sum_congr rfl
      intro x _
      ring
    _ = (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
        ∑ σ : PhysicalPermutations G J ell, ∑ x ∈ physicalCutoff P J ell I,
          (starRingEnd ℂ) (f x) * g (physicalPermutationEquiv σ⁻¹ x) := by
      congr 1
      apply sum_congr rfl
      intro σ _
      exact physical_permutation_pairing P J ell I σ f g
    _ = (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
        ∑ σ : PhysicalPermutations G J ell, ∑ x ∈ physicalCutoff P J ell I,
          (starRingEnd ℂ) (f x) * g (physicalPermutationEquiv σ x) := by
      congr 1
      exact Equiv.sum_comp (Equiv.inv (PhysicalPermutations G J ell))
        (fun σ => ∑ x ∈ physicalCutoff P J ell I, (starRingEnd ℂ) (f x) * g (physicalPermutationEquiv σ x))
    _ = _ := by
      unfold physicalSymmetrize
      simp_rw [mul_sum]
      rw [sum_comm]
      apply sum_congr rfl
      intro x _
      apply sum_congr rfl
      intro σ _
      ring
end

section
open Finset
noncomputable def physicalAbsolutePattern {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (q ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (x y : PhysicalState P J ell) : ℝ :=
  ∑ aux : PhysicalAuxLabels P C, ‖physicalEdgeCoeff V C q ζ k K aux x y‖

theorem physical_absolute_pattern_nonneg {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (q ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (x y : PhysicalState P J ell) : 0 ≤ physicalAbsolutePattern V C q ζ k K x y :=
  sum_nonneg (fun _ _ => norm_nonneg _)

theorem physical_pattern_norm_le_absolute {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (q ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (x y : PhysicalState P J ell) :
    ‖physicalPatternKernel V C q ζ k K x y‖ ≤ physicalAbsolutePattern V C q ζ k K x y :=
  norm_sum_le _ _

theorem physical_absolute_pattern_reverse {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (q ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (x y : PhysicalState P J ell) :
    physicalAbsolutePattern V C q (-ζ) (-k) (fun a b f => (starRingEnd ℂ) (K b a f)) y x =
      physicalAbsolutePattern V C q ζ k K x y := by
  unfold physicalAbsolutePattern
  simp only [physical_edge_reverse, RCLike.norm_conj]

/-- The expanded auxiliary sum obeys the same row bound as the summed
complex kernel, without relying on cancellation between its terms. -/
theorem physical_absolute_pattern_row_le {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    {q A B : ℝ} (ζ : ℝ) (k : ℤ) (hV : ∀ g, 0 < V g) (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (x : PhysicalState P J ell) (rows : Finset (PhysicalState P J ell)) (hB : 0 ≤ B)
    (hK : ∀ aux y, y ∈ rows → ‖K x.2.val y.2.val aux‖ ≤ B)
    (hA : ∀ aux, (Nat.card (PhysicalCompatibleTargets C x aux k) : ℝ) * physicalCompletionMass V C ell *
      physicalDamping P J ell q (physicalNextPosition C x aux k) ≤ A) :
    (∑ y ∈ rows, physicalAbsolutePattern V C q ζ k K x y) ≤ A * B := by
  classical
  unfold physicalAbsolutePattern
  rw [sum_comm]
  calc
    _ ≤ ∑ aux : PhysicalAuxLabels P C, physicalAuxMass V C aux * A * B :=
      sum_le_sum (fun aux _ => physical_edge_norm_row_le V C ζ k hV hq0 hq1 K aux x rows hB (hK aux) (hA aux))
    _ = (∑ aux : PhysicalAuxLabels P C, physicalAuxMass V C aux) * A * B := by rw [sum_mul, sum_mul]
    _ = A * B := by rw [physical_aux_mass_sum V C hV hMass, one_mul]

theorem exists_physical_absolute_pattern_row_bound {q v : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (ell m : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (G : Type) [Fintype G] [DecidableEq G] (P : G → Finset ℕ)
      (J : ℕ) (V : G → ℝ) (C : G → Finset (Fin J)),
      (∀ g, v ≤ V g) → (∀ g, (C g).card ≤ m) →
      (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) →
      ∀ (ζ : ℝ) (k : ℤ)
        (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
        (B : ℝ), 0 ≤ B → (∀ a b aux, ‖K a b aux‖ ≤ B) →
        ∀ (x : PhysicalState P J ell) (rows : Finset (PhysicalState P J ell)),
        (∑ y ∈ rows, physicalAbsolutePattern V C q ζ k K x y) ≤ A^(Fintype.card G) * B := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_compatible_target_mass_bound hq0 hq1 hv ell m
  refine ⟨A, hA, ?_⟩
  intro G _ _ P J V C hV hC hMass ζ k K B hB hK x rows
  exact physical_absolute_pattern_row_le V C ζ k (fun g => hv.trans_le (hV g)) hq0 hq1.le hMass K x rows hB
    (fun aux y _ => hK x.2.val y.2.val aux) (fun aux => hbound G P J V C hV hC x aux k)
end

section
open Finset
noncomputable def physicalAverageMass {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (M : PhysicalState P J ell → PhysicalState P J ell → ℝ)
    (x y : PhysicalState P J ell) : ℝ :=
  (Fintype.card (PhysicalPermutations G J ell) : ℝ)⁻¹ *
    ∑ σ : PhysicalPermutations G J ell, (Fintype.card (PhysicalPermutations G J ell) : ℝ)⁻¹ *
      ∑ τ : PhysicalPermutations G J ell, M (physicalPermutationEquiv σ x) (physicalPermutationEquiv τ y)

theorem physical_average_mass_nonneg {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (M : PhysicalState P J ell → PhysicalState P J ell → ℝ)
    (hM : ∀ x y, 0 ≤ M x y) (x y : PhysicalState P J ell) :
    0 ≤ physicalAverageMass M x y := by
  unfold physicalAverageMass
  exact mul_nonneg (inv_nonneg.mpr (Nat.cast_nonneg _))
    (sum_nonneg (fun σ _ => mul_nonneg (inv_nonneg.mpr (Nat.cast_nonneg _))
      (sum_nonneg (fun τ _ => hM _ _))))

theorem physical_average_mass_cast {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (M : PhysicalState P J ell → PhysicalState P J ell → ℝ)
    (x y : PhysicalState P J ell) :
    (physicalAverageMass M x y : ℂ) = physicalSymmetricKernel (fun a b => (M a b : ℂ)) x y := by
  simp only [physicalAverageMass, physicalSymmetricKernel, physicalSymmetrize,
    Complex.ofReal_mul, Complex.ofReal_sum, Complex.ofReal_inv, Complex.ofReal_natCast]

/-- Comparison for one finite uniform average, before adding its terms. -/
theorem finite_uniform_average_norm_le {A : Type*} [Fintype A]
    (K : A → ℂ) (M : A → ℝ) (hKM : ∀ a, ‖K a‖ ≤ M a) :
    ‖(Fintype.card A : ℂ)⁻¹ * ∑ a, K a‖ ≤ (Fintype.card A : ℝ)⁻¹ * ∑ a, M a := by
  rw [norm_mul, norm_inv, Complex.norm_natCast]
  exact mul_le_mul_of_nonneg_left ((norm_sum_le _ _).trans (sum_le_sum (fun a _ => hKM a)))
    (inv_nonneg.mpr (Nat.cast_nonneg _))

/-- A pointwise majorant before symmetrization majorizes the complete
symmetrized kernel after independent averaging of both endpoints. -/
theorem physical_symmetric_kernel_norm_le_mass {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (K : PhysicalState P J ell → PhysicalState P J ell → ℂ)
    (M : PhysicalState P J ell → PhysicalState P J ell → ℝ)
    (hKM : ∀ x y, ‖K x y‖ ≤ M x y) (x y : PhysicalState P J ell) :
    ‖physicalSymmetricKernel K x y‖ ≤ physicalAverageMass M x y := by
  apply finite_uniform_average_norm_le
  intro σ
  apply finite_uniform_average_norm_le
  intro τ
  exact hKM _ _

theorem physical_average_mass_transpose {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (M : PhysicalState P J ell → PhysicalState P J ell → ℝ)
    (x y : PhysicalState P J ell) :
    physicalAverageMass (fun a b => M b a) x y = physicalAverageMass M y x := by
  apply Complex.ofReal_injective
  rw [physical_average_mass_cast, physical_average_mass_cast, physical_symmetric_kernel_transpose]

/-- Nonnegative averaging preserves the absolute row sum, not just a
norm bound for the corresponding complex operator. -/
theorem physical_average_mass_row_bound {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (M : PhysicalState P J ell → PhysicalState P J ell → ℝ)
    (hM : ∀ x y, 0 ≤ M x y) {A : ℝ} (hA : 0 ≤ A)
    (hrow : ∀ x rows, (∑ y ∈ rows, M x y) ≤ A)
    (x : PhysicalState P J ell) (rows : Finset (PhysicalState P J ell)) :
    (∑ y ∈ rows, physicalAverageMass M x y) ≤ A := by
  have hr : ∀ x rows, (∑ y ∈ rows, ‖(M x y : ℂ)‖) ≤ A := by
    intro x rows
    simpa only [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hM _ _)] using hrow x rows
  have hh := physical_symmetric_kernel_row_bound (fun x y => (M x y : ℂ)) hA hr x rows
  simpa only [← physical_average_mass_cast, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (physical_average_mass_nonneg M hM _ _)] using hh

theorem physical_average_mass_column_bound {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (M : PhysicalState P J ell → PhysicalState P J ell → ℝ)
    (hM : ∀ x y, 0 ≤ M x y) {A : ℝ} (hA : 0 ≤ A)
    (hcol : ∀ y rows, (∑ x ∈ rows, M x y) ≤ A)
    (y : PhysicalState P J ell) (rows : Finset (PhysicalState P J ell)) :
    (∑ x ∈ rows, physicalAverageMass M x y) ≤ A := by
  have hh := physical_average_mass_row_bound (fun a b => M b a) (fun a b => hM b a) hA hcol y rows
  simpa only [physical_average_mass_transpose] using hh
end

section
open Finset
/-- Sum absolute sampled-edge coefficients over the auxiliary choices
and patterns, then average over both endpoint permutations. -/
noncomputable def physicalAbsoluteOperator {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (x y : PhysicalState P J ell) : ℝ :=
  physicalAverageMass (fun a b => ∑ i ∈ patterns, physicalAbsolutePattern V (C i) q (ζ i) (k i) (K i) a b) x y

theorem physical_absolute_operator_nonneg {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (x y : PhysicalState P J ell) :
    0 ≤ physicalAbsoluteOperator V patterns C q ζ k K x y := by
  apply physical_average_mass_nonneg
  intro a b
  exact sum_nonneg (fun i _ => physical_absolute_pattern_nonneg V (C i) q (ζ i) (k i) (K i) a b)

/-- The expanded nonnegative operator pointwise dominates the original
complex operator, including both symmetrizing averages. -/
theorem physical_operator_norm_le_absolute {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (x y : PhysicalState P J ell) :
    ‖physicalSymmetricKernel (fun a b =>
      ∑ i ∈ patterns, physicalPatternKernel V (C i) q (ζ i) (k i) (K i) a b) x y‖ ≤
      physicalAbsoluteOperator V patterns C q ζ k K x y := by
  apply physical_symmetric_kernel_norm_le_mass
  intro a b
  exact (norm_sum_le _ _).trans (sum_le_sum (fun i _ =>
    physical_pattern_norm_le_absolute V (C i) q (ζ i) (k i) (K i) a b))

/-- The stronger absolute bounds apply before all path labels are summed.
Consequently no cancellation is used in bounding expanded path masses. -/
theorem exists_physical_absolute_operator_bounds {q v : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (ell m : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (G : Type) [Fintype G] [DecidableEq G] (P : G → Finset ℕ)
      (J : ℕ) (V : G → ℝ), (∀ g, v ≤ V g) →
      (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) →
      ∀ (I : Type) (patterns : Finset I) (C : I → G → Finset (Fin J))
        (ζ : I → ℝ) (k : I → ℤ)
        (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
        (B : I → ℝ),
        (∀ i ∈ patterns, ∀ g, (C i g).card ≤ m) →
        (∀ i ∈ patterns, 0 ≤ B i) →
        (∀ i ∈ patterns, ∀ a b aux, ‖K i a b aux‖ ≤ B i) →
        ∀ (x : PhysicalState P J ell) (rows : Finset (PhysicalState P J ell)),
        (∑ y ∈ rows, physicalAbsoluteOperator V patterns C q ζ k K x y) ≤
          (∑ i ∈ patterns, B i) * A^(Fintype.card G) ∧
        (∑ y ∈ rows, physicalAbsoluteOperator V patterns C q ζ k K y x) ≤
          (∑ i ∈ patterns, B i) * A^(Fintype.card G) := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_absolute_pattern_row_bound hq0 hq1 hv ell m
  refine ⟨A, hA, ?_⟩
  intro G _ _ P J V hV hMass I patterns C ζ k K B hC hB hK x rows
  classical
  let W := fun a b => ∑ i ∈ patterns, physicalAbsolutePattern V (C i) q (ζ i) (k i) (K i) a b
  have hW : ∀ a b, 0 ≤ W a b := fun a b => sum_nonneg (fun i _ =>
    physical_absolute_pattern_nonneg V (C i) q (ζ i) (k i) (K i) a b)
  have hnonneg : 0 ≤ (∑ i ∈ patterns, B i) * A^(Fintype.card G) :=
    mul_nonneg (sum_nonneg hB) (pow_nonneg (zero_le_one.trans hA) _)
  have hrow : ∀ a s, (∑ b ∈ s, W a b) ≤ (∑ i ∈ patterns, B i) * A^(Fintype.card G) := by
    intro a s
    unfold W
    rw [sum_comm]
    calc
      _ ≤ ∑ i ∈ patterns, A^(Fintype.card G) * B i := sum_le_sum (fun i hi =>
        hbound G P J V (C i) hV (hC i hi) hMass (ζ i) (k i) (K i) (B i) (hB i hi) (hK i hi) a s)
      _ = _ := by rw [← mul_sum, mul_comm]
  have hcol : ∀ b s, (∑ a ∈ s, W a b) ≤ (∑ i ∈ patterns, B i) * A^(Fintype.card G) := by
    intro b s
    unfold W
    rw [sum_comm]
    calc
      _ ≤ ∑ i ∈ patterns, A^(Fintype.card G) * B i := by
        apply sum_le_sum
        intro i hi
        have hKi : ∀ a b aux, ‖(starRingEnd ℂ) (K i b a aux)‖ ≤ B i := by
          intro a b aux
          rw [RCLike.norm_conj]
          exact hK i hi b a aux
        have hh := hbound G P J V (C i) hV (hC i hi) hMass (-(ζ i)) (-(k i))
          (fun a b aux => (starRingEnd ℂ) (K i b a aux)) (B i) (hB i hi) hKi b s
        simpa only [physical_absolute_pattern_reverse] using hh
      _ = _ := by rw [← mul_sum, mul_comm]
  exact ⟨physical_average_mass_row_bound W hW hnonneg hrow x rows,
    physical_average_mass_column_bound W hW hnonneg hcol x rows⟩
end

section
open Finset
/-- A finite maximum over all source lists and auxiliary labels. -/
noncomputable def physicalDMax {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (J ell : ℕ) (C : G → Finset (Fin J)) : ℕ :=
  univ.sup (fun a : PhysicalMarkLists P J ell × PhysicalAuxLabels P C => physicalD C a.1 a.2)

theorem physical_D_le_max {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (J ell : ℕ) (C : G → Finset (Fin J))
    (labels : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C) :
    physicalD C labels aux ≤ physicalDMax P J ell C := by
  exact le_sup (f := fun a : PhysicalMarkLists P J ell × PhysicalAuxLabels P C => physicalD C a.1 a.2)
    (mem_univ (labels, aux))

/-- Natural displacement bound, allowing negative translation steps. -/
noncomputable def physicalStepBound {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (J ell : ℕ) (C : G → Finset (Fin J)) (k : ℤ) : ℕ :=
  k.natAbs * physicalDMax P J ell C

theorem physical_admissible_displacement {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) {x y : PhysicalState P J ell}
    (h : physicalAdmissible C aux k x y) :
    (y.1 - x.1).natAbs ≤ physicalStepBound P J ell C k := by
  have he : y.1 - x.1 = k * (physicalD C x.2.val aux : ℕ) := by rw [h.2.2.2]; ring
  rw [he, Int.natAbs_mul, Int.natAbs_natCast]
  exact Nat.mul_le_mul_left _ (physical_D_le_max P J ell C x.2.val aux)

theorem physical_step_bound_neg {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (J ell : ℕ) (C : G → Finset (Fin J)) (k : ℤ) :
    physicalStepBound P J ell C (-k) = physicalStepBound P J ell C k := by
  simp only [physicalStepBound, Int.natAbs_neg]

/-- Coefficients outside the displacement bound vanish individually. -/
theorem physical_edge_zero_of_far {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (q ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (x y : PhysicalState P J ell)
    (hfar : physicalStepBound P J ell C k < (y.1 - x.1).natAbs) :
    physicalEdgeCoeff V C q ζ k K aux x y = 0 := by
  classical
  have hnot : ¬ physicalAdmissible C aux k x y := fun h =>
    (not_lt_of_ge (physical_admissible_displacement C aux k h)) hfar
  simp only [physicalEdgeCoeff, if_neg hnot]

theorem physical_absolute_pattern_zero_of_far {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (q ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (x y : PhysicalState P J ell)
    (hfar : physicalStepBound P J ell C k < (y.1 - x.1).natAbs) :
    physicalAbsolutePattern V C q ζ k K x y = 0 := by
  unfold physicalAbsolutePattern
  apply sum_eq_zero
  intro aux _
  rw [physical_edge_zero_of_far V C q ζ k K aux x y hfar, norm_zero]
end

section
open Finset
noncomputable def physicalOperatorStepBound {G I : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (J ell : ℕ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (k : I → ℤ) : ℕ :=
  patterns.sup (fun i => physicalStepBound P J ell (C i) (k i))

theorem physical_operator_step_bound_neg {G I : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (J ell : ℕ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (k : I → ℤ) :
    physicalOperatorStepBound P J ell patterns C (fun i => -(k i)) =
      physicalOperatorStepBound P J ell patterns C k := by
  simp only [physicalOperatorStepBound, physical_step_bound_neg]

/-- Taking absolute values, adding patterns, and averaging mark permutations
do not enlarge the possible displacement of any individual edge. -/
theorem physical_absolute_operator_zero_of_far {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (x y : PhysicalState P J ell)
    (hfar : physicalOperatorStepBound P J ell patterns C k < (y.1 - x.1).natAbs) :
    physicalAbsoluteOperator V patterns C q ζ k K x y = 0 := by
  classical
  have hzero : ∀ σ τ : PhysicalPermutations G J ell,
      (∑ i ∈ patterns, physicalAbsolutePattern V (C i) q (ζ i) (k i) (K i)
        (physicalPermutationEquiv σ x) (physicalPermutationEquiv τ y)) = 0 := by
    intro σ τ
    apply sum_eq_zero
    intro i hi
    apply physical_absolute_pattern_zero_of_far
    change physicalStepBound P J ell (C i) (k i) < (y.1 - x.1).natAbs
    exact (le_sup (f := fun i => physicalStepBound P J ell (C i) (k i)) hi).trans_lt hfar
  simp only [physicalAbsoluteOperator, physicalAverageMass, hzero, sum_const_zero, mul_zero]

theorem physical_absolute_operator_displacement {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (x y : PhysicalState P J ell)
    (h : physicalAbsoluteOperator V patterns C q ζ k K x y ≠ 0) :
    (y.1 - x.1).natAbs ≤ physicalOperatorStepBound P J ell patterns C k := by
  by_contra hfar
  exact h (physical_absolute_operator_zero_of_far V patterns C q ζ k K x y (lt_of_not_ge hfar))

/-- The complex physical kernel has the same finite displacement bound. -/
theorem physical_operator_zero_of_far {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (x y : PhysicalState P J ell)
    (hfar : physicalOperatorStepBound P J ell patterns C k < (y.1 - x.1).natAbs) :
    physicalSymmetricKernel (fun a b =>
      ∑ i ∈ patterns, physicalPatternKernel V (C i) q (ζ i) (k i) (K i) a b) x y = 0 := by
  apply norm_eq_zero.mp
  apply le_antisymm _ (norm_nonneg _)
  have hh := physical_operator_norm_le_absolute V patterns C q ζ k K x y
  rwa [physical_absolute_operator_zero_of_far V patterns C q ζ k K x y hfar] at hh
end

section
open Finset
theorem integer_walk_displacement {p : ℕ → ℤ} {N b : ℕ}
    (hstep : ∀ j < N, (p (j + 1) - p j).natAbs ≤ b) :
    ∀ j ≤ N, (p j - p 0).natAbs ≤ j * b := by
  intro j
  induction j with
  | zero => simp
  | succ j ih =>
    intro hj
    have hjN : j < N := by omega
    have hh := ih (by omega)
    calc
      (p (j + 1) - p 0).natAbs = ((p (j + 1) - p j) + (p j - p 0)).natAbs := by congr 1; ring
      _ ≤ (p (j + 1) - p j).natAbs + (p j - p 0).natAbs := Int.natAbs_add_le _ _
      _ ≤ b + j * b := Nat.add_le_add (hstep j hjN) hh
      _ = (j + 1) * b := by ring

/-- The union of radius-R integer intervals around a finite starting set. -/
def reachablePositions (I : Finset ℤ) (R : ℕ) : Finset ℤ :=
  I.biUnion (fun n => Icc (n - (R : ℤ)) (n + (R : ℤ)))

theorem mem_reachable_positions {I : Finset ℤ} {R : ℕ} {n r : ℤ}
    (hr : r ∈ I) (hd : (n - r).natAbs ≤ R) : n ∈ reachablePositions I R := by
  have hh : ((n - r).natAbs : ℤ) ≤ (R : ℤ) := by exact_mod_cast hd
  rw [Int.natCast_natAbs] at hh
  have habs := abs_le.mp hh
  exact mem_biUnion.mpr ⟨r, hr, mem_Icc.mpr ⟨by omega, by omega⟩⟩

/-- One finite position set contains all prefixes of all walks of at
most N bounded steps starting in I. -/
theorem integer_walk_mem_reachable {p : ℕ → ℤ} {I : Finset ℤ} {N b : ℕ}
    (hstart : p 0 ∈ I) (hstep : ∀ j < N, (p (j + 1) - p j).natAbs ≤ b)
    {j : ℕ} (hj : j ≤ N) : p j ∈ reachablePositions I (N * b) := by
  apply mem_reachable_positions hstart
  exact (integer_walk_displacement hstep j hj).trans (Nat.mul_le_mul_right b hj)

/-- All states in a physical walk with bounded displacement belong to
a single complete finite position cutoff. -/
theorem physical_walk_mem_cutoff {G : Type*} [Fintype G] {P : G → Finset ℕ}
    {J ell : ℕ} {walk : ℕ → PhysicalState P J ell} {I : Finset ℤ} {N b : ℕ}
    (hstart : (walk 0).1 ∈ I)
    (hstep : ∀ j < N, ((walk (j + 1)).1 - (walk j).1).natAbs ≤ b)
    {j : ℕ} (hj : j ≤ N) :
    walk j ∈ physicalCutoff P J ell (reachablePositions I (N * b)) := by
  rw [mem_physical_cutoff]
  exact integer_walk_mem_reachable (p := fun r => (walk r).1) hstart hstep hj

/-- Every supported path in the expanded physical operator lies in the
finite cutoff, including paths used before any cancellation is taken. -/
theorem physical_absolute_walk_mem_cutoff {G T : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset T)
    (C : T → G → Finset (Fin J)) (q : ℝ) (ζ : T → ℝ) (k : T → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    {walk : ℕ → PhysicalState P J ell} {I : Finset ℤ} {N : ℕ}
    (hstart : (walk 0).1 ∈ I)
    (hstep : ∀ j < N, physicalAbsoluteOperator V patterns C q ζ k K (walk j) (walk (j + 1)) ≠ 0)
    {j : ℕ} (hj : j ≤ N) :
    walk j ∈ physicalCutoff P J ell
      (reachablePositions I (N * physicalOperatorStepBound P J ell patterns C k)) := by
  apply physical_walk_mem_cutoff hstart _ hj
  intro r hr
  exact physical_absolute_operator_displacement V patterns C q ζ k K (walk r) (walk (r + 1)) (hstep r hr)
end

section
open Finset
/-- Finite operator action in reverse step order, matching finitePathMass. -/
noncomputable def finitePathAction {X R : Type*} [Fintype X] [Semiring R]
    (K : ℕ → X → X → R) (terminal : X → R) : ℕ → X → R
  | 0, x => terminal x
  | n + 1, x => ∑ y, K n x y * finitePathAction K terminal n y

/-- One fully expanded path records an edge label and the next state
at each step. Its weight includes the terminal value. -/
def labeledPathTerm {A X R : Type*} [Mul R]
    (K : ℕ → A → X → X → R) (terminal : X → R) :
    (n : ℕ) → X → (Fin n → A × X) → R
  | 0, x, _ => terminal x
  | n + 1, x, p => K n (p 0).1 x (p 0).2 * labeledPathTerm K terminal n (p 0).2 (Fin.tail p)

/-- Finite matrix iteration is exactly the sum over all edge labels
and all visited states, without any suppression of individual terms. -/
theorem finite_labeled_path_expansion {A X R : Type*} [Fintype A] [Fintype X] [Semiring R]
    (K : ℕ → A → X → X → R) (terminal : X → R) (n : ℕ) (x : X) :
    (∑ p : Fin n → A × X, labeledPathTerm K terminal n x p) =
      finitePathAction (fun j a b => ∑ label, K j label a b) terminal n x := by
  classical
  induction n generalizing x with
  | zero => simp [labeledPathTerm, finitePathAction]
  | succ n ih =>
    calc
      _ = ∑ z : A × X, ∑ p : Fin n → A × X,
          K n z.1 x z.2 * labeledPathTerm K terminal n z.2 p := by
        rw [← Equiv.sum_comp (Fin.consEquiv (fun _ : Fin (n + 1) => A × X))
          (fun p => labeledPathTerm K terminal (n + 1) x p), Fintype.sum_prod_type]
        rfl
      _ = ∑ z : A × X, K n z.1 x z.2 *
          finitePathAction (fun j a b => ∑ label, K j label a b) terminal n z.2 := by
        apply sum_congr rfl
        intro z _
        rw [← mul_sum, ih]
      _ = _ := by
        rw [Fintype.sum_prod_type, sum_comm]
        simp only [finitePathAction, sum_mul]

/-- Norms factor over every individual labeled path. -/
theorem norm_labeled_path_term {A X : Type*}
    (K : ℕ → A → X → X → ℂ) (terminal : X → ℂ) (n : ℕ)
    (x : X) (p : Fin n → A × X) :
    ‖labeledPathTerm K terminal n x p‖ =
      labeledPathTerm (fun j a x y => ‖K j a x y‖) (fun y => ‖terminal y‖) n x p := by
  induction n generalizing x with
  | zero => rfl
  | succ n ih =>
    simp only [labeledPathTerm, norm_mul, ih]

theorem real_finite_path_action_eq_mass {X : Type*} [Fintype X]
    (K : ℕ → X → X → ℝ) (terminal : X → ℝ) (n : ℕ) (x : X) :
    finitePathAction K terminal n x = finitePathMass univ K terminal n x := by
  induction n generalizing x with
  | zero => rfl
  | succ n ih => simp only [finitePathAction, finitePathMass, ih]

/-- The sum of the norms of all fully expanded path terms is exactly
iteration of the kernel that sums the norms of individual edge coefficients. -/
theorem absolute_labeled_path_expansion {A X : Type*} [Fintype A] [Fintype X]
    (K : ℕ → A → X → X → ℂ) (terminal : X → ℂ) (n : ℕ) (x : X) :
    (∑ p : Fin n → A × X, ‖labeledPathTerm K terminal n x p‖) =
      finitePathMass univ (fun j a b => ∑ label, ‖K j label a b‖)
        (fun y => ‖terminal y‖) n x := by
  simp only [norm_labeled_path_term]
  rw [finite_labeled_path_expansion, real_finite_path_action_eq_mass]

/-- Uniform absolute row bounds control the sum of all expanded path
magnitudes, not only the norm after the paths have been added. -/
theorem absolute_labeled_path_bound {A X : Type*} [Fintype A] [Fintype X]
    (K : ℕ → A → X → X → ℂ) (terminal : X → ℂ) {B : ℝ} (hB : 0 ≤ B)
    (hrow : ∀ j x, (∑ y, ∑ label, ‖K j label x y‖) ≤ B)
    (ht : ∀ x, ‖terminal x‖ ≤ 1) (n : ℕ) (x : X) :
    (∑ p : Fin n → A × X, ‖labeledPathTerm K terminal n x p‖) ≤ B^n := by
  rw [absolute_labeled_path_expansion]
  exact finite_path_mass_le_pow univ _ _ hB
    (fun _ _ _ _ _ => sum_nonneg (fun _ _ => norm_nonneg _))
    (fun j x _ => hrow j x) (fun x _ => ht x) n x (mem_univ x)
end

section
open Finset
abbrev PhysicalEdgeLabels {G I : Type*} (P : G → Finset ℕ) (J ell : ℕ)
    (patterns : Finset I) (C : I → G → Finset (Fin J)) :=
  PhysicalPermutations G J ell × PhysicalPermutations G J ell ×
    (Σ i : patterns, PhysicalAuxLabels P (C i.val))

theorem physical_edge_labels_sum {G I R : Type*} [Fintype G] [DecidableEq G] [AddCommMonoid R]
    {P : G → Finset ℕ} {J ell : ℕ} (patterns : Finset I) (C : I → G → Finset (Fin J))
    (F : PhysicalPermutations G J ell → PhysicalPermutations G J ell →
      (i : I) → PhysicalAuxLabels P (C i) → R) :
    (∑ a : PhysicalEdgeLabels P J ell patterns C, F a.1 a.2.1 a.2.2.1.val a.2.2.2) =
      ∑ σ : PhysicalPermutations G J ell, ∑ τ : PhysicalPermutations G J ell,
        ∑ i ∈ patterns, ∑ aux : PhysicalAuxLabels P (C i), F σ τ i aux := by
  classical
  simp only [Fintype.sum_prod_type, Fintype.sum_sigma]
  apply sum_congr rfl
  intro σ _
  apply sum_congr rfl
  intro τ _
  exact sum_coe_sort patterns (fun i => ∑ aux : PhysicalAuxLabels P (C i), F σ τ i aux)

noncomputable def physicalLabeledCoeff {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (x y : PhysicalState P J ell) : ℂ :=
  (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
    (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
    physicalEdgeCoeff V (C a.2.2.1.val) q (ζ a.2.2.1.val) (k a.2.2.1.val) (K a.2.2.1.val)
      a.2.2.2 (physicalPermutationEquiv a.1 x) (physicalPermutationEquiv a.2.1 y)

/-- The labeled coefficients sum to exactly the symmetrized physical
operator, with both permutation normalizations included. -/
theorem physical_labeled_coefficient_sum {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (x y : PhysicalState P J ell) :
    (∑ a : PhysicalEdgeLabels P J ell patterns C, physicalLabeledCoeff V patterns C q ζ k K a x y) =
      physicalSymmetricKernel (fun b c => ∑ i ∈ patterns,
        physicalPatternKernel V (C i) q (ζ i) (k i) (K i) b c) x y := by
  classical
  unfold physicalLabeledCoeff
  rw [physical_edge_labels_sum patterns C (fun σ τ i aux =>
    (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
      (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
      physicalEdgeCoeff V (C i) q (ζ i) (k i) (K i) aux
        (physicalPermutationEquiv σ x) (physicalPermutationEquiv τ y)),
    physical_symmetric_kernel_double_sum]
  simp only [← mul_sum, physicalPatternKernel]

/-- Taking the norm before summing any edge labels gives exactly the
expanded absolute operator, retaining all normalization factors. -/
theorem physical_labeled_coefficient_abs_sum {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (x y : PhysicalState P J ell) :
    (∑ a : PhysicalEdgeLabels P J ell patterns C, ‖physicalLabeledCoeff V patterns C q ζ k K a x y‖) =
      physicalAbsoluteOperator V patterns C q ζ k K x y := by
  classical
  unfold physicalLabeledCoeff
  simp only [norm_mul, norm_inv, Complex.norm_natCast]
  rw [physical_edge_labels_sum patterns C (fun σ τ i aux =>
    (Fintype.card (PhysicalPermutations G J ell) : ℝ)⁻¹ *
      (Fintype.card (PhysicalPermutations G J ell) : ℝ)⁻¹ *
      ‖physicalEdgeCoeff V (C i) q (ζ i) (k i) (K i) aux
        (physicalPermutationEquiv σ x) (physicalPermutationEquiv τ y)‖)]
  unfold physicalAbsoluteOperator physicalAverageMass physicalAbsolutePattern
  simp only [← mul_sum, mul_assoc]
end

section
open Finset Classical
/-- Every expanded path is counted before cancellation. The bound is
uniform in J, the cutoff, the length and all phases and translation steps. -/
theorem exists_physical_labeled_path_bound {q v : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (ell m : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (G : Type) [Fintype G] [DecidableEq G] (P : G → Finset ℕ)
      (J : ℕ) (V : G → ℝ), (∀ g, v ≤ V g) →
      (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) →
      ∀ (I : Type) (patterns : Finset I) (C : I → G → Finset (Fin J)) (B : I → ℝ),
      (∀ i ∈ patterns, ∀ g, (C i g).card ≤ m) → (∀ i ∈ patterns, 0 ≤ B i) →
      ∀ (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
        (K : ℕ → (i : I) → PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ),
        (∀ r i, i ∈ patterns → ∀ a b aux, ‖K r i a b aux‖ ≤ B i) →
        ∀ (rows : Finset (PhysicalState P J ell)),
        letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
        ∀ (terminal : ↥rows → ℂ),
        (∀ x, ‖terminal x‖ ≤ 1) → ∀ (n : ℕ) (x : rows),
        (∑ p : Fin n → PhysicalEdgeLabels P J ell patterns C × ↥rows,
          ‖labeledPathTerm (fun r a (x y : rows) =>
            physicalLabeledCoeff V patterns C q (ζ r) (k r) (K r) a x.val y.val) terminal n x p‖) ≤
          ((∑ i ∈ patterns, B i) * A^(Fintype.card G))^n := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_absolute_operator_bounds hq0 hq1 hv ell m
  refine ⟨A, hA, ?_⟩
  intro G _ _ P J V hV hMass I patterns C B hC hB ζ k K hK rows
  classical
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  intro terminal ht n x
  apply absolute_labeled_path_bound
  · exact mul_nonneg (sum_nonneg hB) (pow_nonneg (zero_le_one.trans hA) _)
  · intro r y
    simp only [physical_labeled_coefficient_abs_sum]
    have hh := (hbound G P J V hV hMass I patterns C (ζ r) (k r) (K r) B hC hB (hK r) y.val rows).1
    rwa [sum_coe_sort]
  · exact ht

/-- A normalized starting distribution preserves the labeled path bound,
including when the terminal condition depends on the starting state. -/
theorem averaged_absolute_labeled_path_bound {A X : Type*} [Fintype A] [Fintype X]
    (K : ℕ → A → X → X → ℂ) (terminal : X → X → ℂ) (μ : X → ℝ)
    {B : ℝ} (hB : 0 ≤ B)
    (hrow : ∀ j x, (∑ y, ∑ label, ‖K j label x y‖) ≤ B)
    (ht : ∀ x y, ‖terminal x y‖ ≤ 1) (hμ : ∀ x, 0 ≤ μ x)
    (hmass : (∑ x, μ x) ≤ 1) (n : ℕ) :
    (∑ x, μ x * ∑ p : Fin n → A × X, ‖labeledPathTerm K (terminal x) n x p‖) ≤ B^n := by
  calc
    _ ≤ ∑ x, μ x * B^n := sum_le_sum (fun x _ => mul_le_mul_of_nonneg_left
      (absolute_labeled_path_bound K (terminal x) hB hrow (ht x) n x) (hμ x))
    _ = (∑ x, μ x) * B^n := by rw [sum_mul]
    _ ≤ 1 * B^n := mul_le_mul_of_nonneg_right hmass (pow_nonneg hB n)
    _ = B^n := one_mul _
end

section
open Finset
/-- Logarithmically many group losses and polynomial total pattern mass
give a fixed power of L, with no dependence on the shared-slot count. -/
theorem group_pattern_weight_power_bound {L A B C D : ℝ} {s : ℕ}
    (hL : 0 < L) (hA : 1 ≤ A) (hs : (s : ℝ) ≤ D * Real.log L)
    (hB : B ≤ L^C) : B * A^s ≤ L^(C + D * Real.log A) := by
  have hA0 : 0 ≤ A := zero_le_one.trans hA
  have hprod : A^s ≤ L^(D * Real.log A) := by
    simpa only [prod_const, card_range] using
      group_product_bound_of_log_card (range s) (fun _ => A) hA hL
        (fun _ _ => hA0) (fun _ _ => le_rfl) (by simpa only [card_range] using hs)
  calc
    _ ≤ L^C * A^s := mul_le_mul_of_nonneg_right hB (pow_nonneg hA0 s)
    _ ≤ L^C * L^(D * Real.log A) := mul_le_mul_of_nonneg_left hprod (Real.rpow_nonneg hL.le C)
    _ = _ := (Real.rpow_add hL _ _).symm

/-- The total magnitude of every labeled path, averaged over a starting
measure of mass at most one, has the required exp(C*n*log L) scale. -/
theorem averaged_absolute_labeled_path_exp_bound {A X : Type*} [Fintype A] [Fintype X]
    (K : ℕ → A → X → X → ℂ) (terminal : X → X → ℂ) (μ : X → ℝ)
    {L C : ℝ} (hL : 0 < L)
    (hrow : ∀ j x, (∑ y, ∑ label, ‖K j label x y‖) ≤ L^C)
    (ht : ∀ x y, ‖terminal x y‖ ≤ 1) (hμ : ∀ x, 0 ≤ μ x)
    (hmass : (∑ x, μ x) ≤ 1) (n : ℕ) :
    (∑ x, μ x * ∑ p : Fin n → A × X, ‖labeledPathTerm K (terminal x) n x p‖) ≤
      Real.exp (C * n * Real.log L) := by
  have hh := averaged_absolute_labeled_path_bound K terminal μ (Real.rpow_nonneg hL.le C)
    hrow ht hμ hmass n
  have he : (L^C)^n = Real.exp (C * n * Real.log L) := by
    rw [Real.rpow_def_of_pos hL, ← Real.exp_nat_mul]
    congr 1
    ring
  exact he ▸ hh
end

section
open Finset
theorem physical_labeled_zero_of_far {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (x y : PhysicalState P J ell)
    (hfar : physicalOperatorStepBound P J ell patterns C k < (y.1 - x.1).natAbs) :
    physicalLabeledCoeff V patterns C q ζ k K a x y = 0 := by
  have hi := a.2.2.1.property
  have hlocal : physicalStepBound P J ell (C a.2.2.1.val) (k a.2.2.1.val) <
      ((physicalPermutationEquiv a.2.1 y).1 - (physicalPermutationEquiv a.1 x).1).natAbs :=
    (le_sup (f := fun i => physicalStepBound P J ell (C i) (k i)) hi).trans_lt hfar
  unfold physicalLabeledCoeff
  rw [physical_edge_zero_of_far V (C a.2.2.1.val) q (ζ a.2.2.1.val) (k a.2.2.1.val)
    (K a.2.2.1.val) a.2.2.2 (physicalPermutationEquiv a.1 x) (physicalPermutationEquiv a.2.1 y) hlocal, mul_zero]

theorem physical_labeled_displacement {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (x y : PhysicalState P J ell)
    (h : physicalLabeledCoeff V patterns C q ζ k K a x y ≠ 0) :
    (y.1 - x.1).natAbs ≤ physicalOperatorStepBound P J ell patterns C k := by
  by_contra hfar
  exact h (physical_labeled_zero_of_far V patterns C q ζ k K a x y (lt_of_not_ge hfar))

/-- A single finite cutoff contains all supported labeled walks for
time-varying coefficients, whenever their step bounds are bounded by b. -/
theorem physical_labeled_walk_mem_cutoff {G T : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset T)
    (C : T → G → Finset (Fin J)) (q : ℝ) (ζ : ℕ → T → ℝ) (k : ℕ → T → ℤ)
    (K : ℕ → (i : T) → PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    {walk : ℕ → PhysicalState P J ell} {I : Finset ℤ} {N b : ℕ}
    (hstart : (walk 0).1 ∈ I)
    (hbound : ∀ r < N, physicalOperatorStepBound P J ell patterns C (k r) ≤ b)
    (hstep : ∀ r < N, physicalLabeledCoeff V patterns C q (ζ r) (k r) (K r) (a r) (walk r) (walk (r + 1)) ≠ 0)
    {j : ℕ} (hj : j ≤ N) :
    walk j ∈ physicalCutoff P J ell (reachablePositions I (N * b)) := by
  apply physical_walk_mem_cutoff hstart _ hj
  intro r hr
  exact (physical_labeled_displacement V patterns C q (ζ r) (k r) (K r) (a r)
    (walk r) (walk (r + 1)) (hstep r hr)).trans (hbound r hr)
end

section
open Finset
def physicalGroupMarkEmbedding {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (labels : PhysicalMarkLists P J ell) (g : G) : PhysicalSlots J ell ↪ ℕ :=
  (labels g).trans ⟨Subtype.val, Subtype.val_injective⟩

def physicalGroupMarks {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (labels : PhysicalMarkLists P J ell) (g : G) : Finset ℕ :=
  univ.map (physicalGroupMarkEmbedding labels g)

theorem mem_physical_group_marks {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (labels : PhysicalMarkLists P J ell) (g : G) (p : ℕ) :
    p ∈ physicalGroupMarks labels g ↔ ∃ s, (labels g s).val = p := by
  simp only [physicalGroupMarks, mem_map, mem_univ, true_and]
  rfl

theorem physical_group_marks_card {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (labels : PhysicalMarkLists P J ell) (g : G) :
    (physicalGroupMarks labels g).card = J + ell := by
  simp only [physicalGroupMarks, card_map, card_univ, Fintype.card_sum, Fintype.card_fin]

theorem physical_group_marks_subset {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (labels : PhysicalMarkLists P J ell) (g : G) : physicalGroupMarks labels g ⊆ P g := by
  intro p hp
  obtain ⟨s, rfl⟩ := (mem_physical_group_marks labels g p).mp hp
  exact (labels g s).property

theorem physical_group_marks_divisor_subset {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (n : ℤ) (labels : PhysicalMarksAt P J ell n) (g : G) :
    physicalGroupMarks labels.val g ⊆ physicalDivisorPool P g n := by
  intro p hp
  obtain ⟨s, rfl⟩ := (mem_physical_group_marks labels.val g p).mp hp
  exact mem_filter.mpr ⟨(labels.val g s).property, labels.property g s⟩

/-- The excess divisor count equals the number of unmarked dividing
primes; natural subtraction causes no loss on a physical state. -/
theorem physical_unmarked_divisor_count {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (n : ℤ) (labels : PhysicalMarksAt P J ell n) (g : G) :
    ((P g \ physicalGroupMarks labels.val g).filter (fun p : ℕ => (p : ℤ) ∣ n)).card =
      physicalOmega P g n - (J + ell) := by
  have he : (P g \ physicalGroupMarks labels.val g).filter (fun p : ℕ => (p : ℤ) ∣ n) =
      physicalDivisorPool P g n \ physicalGroupMarks labels.val g := by
    ext p
    simp only [mem_filter, mem_sdiff, physicalDivisorPool]
    tauto
  rw [he, card_sdiff_of_subset (physical_group_marks_divisor_subset n labels g), physical_group_marks_card]
  rfl

/-- A half-power of the excess count is one square-root damping factor
for each unmarked dividing prime. -/
theorem physical_group_damping_as_unmarked {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (n : ℤ) (labels : PhysicalMarksAt P J ell n) (g : G) {q : ℝ} (hq : 0 ≤ q) :
    q^(((physicalOmega P g n - (J + ell) : ℕ) : ℝ) / 2) =
      (Real.sqrt q)^((P g \ physicalGroupMarks labels.val g).filter (fun p : ℕ => (p : ℤ) ∣ n)).card := by
  rw [physical_unmarked_divisor_count n labels g, Real.sqrt_eq_rpow, ← Real.rpow_natCast, ← Real.rpow_mul hq]
  congr 1
  ring

theorem physical_damping_as_unmarked {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (n : ℤ) (labels : PhysicalMarksAt P J ell n)
    {q : ℝ} (hq : 0 ≤ q) :
    physicalDamping P J ell q n = ∏ g,
      (Real.sqrt q)^((P g \ physicalGroupMarks labels.val g).filter (fun p : ℕ => (p : ℤ) ∣ n)).card := by
  unfold physicalDamping
  apply prod_congr rfl
  intro g _
  exact physical_group_damping_as_unmarked n labels g hq
end

section
open Finset
/-- Summing a nonnegative product law over embeddings loses mass relative
to summing over all functions, for any finite slot type. -/
theorem embedding_weight_bound {S P : Type*} [Fintype S] [Fintype P]
    (w : P → ℝ) (hw : ∀ p, 0 ≤ w p) :
    (∑ f : S ↪ P, ∏ s, w (f s)) ≤ (∑ p, w p)^(Fintype.card S) := by
  classical
  let e : (S ↪ P) ↪ (S → P) := ⟨fun f => f, fun _ _ h => Function.Embedding.ext (fun s => congrFun h s)⟩
  calc
    _ = ∑ f ∈ univ.map e, ∏ s, w (f s) := by rw [sum_map]; rfl
    _ ≤ ∑ f : S → P, ∏ s, w (f s) :=
      sum_le_univ_sum_of_nonneg (fun f => prod_nonneg (fun s _ => hw (f s)))
    _ = ∏ _s : S, ∑ p, w p := (Fintype.prod_sum (fun (_s : S) p => w p)).symm
    _ = _ := by simp

theorem normalized_embedding_weight_bound {S P : Type*} [Fintype S] [Fintype P]
    (w : P → ℝ) (hw : ∀ p, 0 ≤ w p) {V : ℝ} (hV : 0 < V) (hsum : ∑ p, w p = V) :
    (∑ f : S ↪ P, (∏ s, w (f s)) / V^(Fintype.card S)) ≤ 1 := by
  rw [← sum_div, div_le_one (pow_pos hV _)]
  simpa only [hsum] using embedding_weight_bound (S := S) w hw

/-- Independent-prime weight of a tuple of distinct ordered mark lists. -/
noncomputable def physicalMarkPriorMass {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (labels : PhysicalMarkLists P J ell) : ℝ :=
  ∏ g, (∏ s, 1 / ((labels g s).val : ℝ)) / (V g)^(J + ell)

theorem physical_mark_prior_nonneg {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (hV : ∀ g, 0 ≤ V g)
    (labels : PhysicalMarkLists P J ell) : 0 ≤ physicalMarkPriorMass V labels := by
  apply prod_nonneg
  intro g _
  exact div_nonneg (prod_nonneg (fun s _ => by positivity)) (pow_nonneg (hV g) _)

/-- Summing over all physical mark lists gives mass at most one. No
normalization of the actual integer-position starting measure is assumed. -/
theorem physical_mark_prior_total_mass {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) :
    (∑ labels : PhysicalMarkLists P J ell, physicalMarkPriorMass V labels) ≤ 1 := by
  classical
  have he : (∑ labels : PhysicalMarkLists P J ell, physicalMarkPriorMass V labels) =
      ∏ g, ∑ f : PhysicalSlots J ell ↪ ↥(P g), (∏ s, 1 / ((f s).val : ℝ)) / (V g)^(J + ell) :=
    (Fintype.prod_sum (fun g (f : PhysicalSlots J ell ↪ ↥(P g)) =>
      (∏ s, 1 / ((f s).val : ℝ)) / (V g)^(J + ell))).symm
  rw [he]
  apply prod_le_one₀
  · intro g _
    exact sum_nonneg (fun f _ => div_nonneg (prod_nonneg (fun s _ => by positivity)) (pow_nonneg (hV g).le _))
  · intro g _
    have hs : (∑ p : P g, 1 / (p.val : ℝ)) = V g := by
      rw [sum_coe_sort (P g) (fun p : ℕ => 1 / (p : ℝ))]
      exact hMass g
    have hh := normalized_embedding_weight_bound (S := PhysicalSlots J ell)
      (fun p : P g => 1 / (p.val : ℝ)) (fun _ => by positivity) (hV g) hs
    simpa only [Fintype.card_sum, Fintype.card_fin] using hh

/-- The prior weight is the original state normalization times the
product of the marked-prime divisibility probabilities. -/
theorem physical_mark_prior_factor {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (labels : PhysicalMarkLists P J ell) :
    physicalMarkPriorMass V labels = physicalStateMass V J ell *
      ∏ g, ∏ s, 1 / ((labels g s).val : ℝ) := by
  unfold physicalMarkPriorMass physicalStateMass
  rw [← prod_mul_distrib]
  apply prod_congr rfl
  intro g _
  ring
end

section
open Finset
abbrev PhysicalPrime {G : Type*} (P : G → Finset ℕ) := Σ g, ↥(P g)

def physicalMarkInjection {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (labels : PhysicalMarkLists P J ell) : (Σ _g : G, PhysicalSlots J ell) ↪ PhysicalPrime P :=
  Function.Embedding.sigmaMap (Function.Embedding.refl G) labels

def physicalMarkedPrimes {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    (labels : PhysicalMarkLists P J ell) : Finset (PhysicalPrime P) :=
  univ.map (physicalMarkInjection labels)

theorem mem_physical_marked_primes {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (labels : PhysicalMarkLists P J ell) (p : PhysicalPrime P) :
    p ∈ physicalMarkedPrimes labels ↔ p.2.val ∈ physicalGroupMarks labels p.1 := by
  rcases p with ⟨g, p⟩
  rw [mem_physical_group_marks]
  constructor
  · intro hp
    obtain ⟨⟨h, s⟩, _, he⟩ := mem_map.mp hp
    change (⟨h, labels h s⟩ : PhysicalPrime P) = ⟨g, p⟩ at he
    have hg : h = g := congrArg Sigma.fst he
    cases hg
    exact ⟨s, congrArg Subtype.val (eq_of_heq (Sigma.mk.inj_iff.mp he).2)⟩
  · rintro ⟨s, hs⟩
    apply mem_map.mpr
    refine ⟨⟨g, s⟩, mem_univ _, ?_⟩
    change (⟨g, labels g s⟩ : PhysicalPrime P) = ⟨g, p⟩
    exact congrArg (Sigma.mk g) (Subtype.ext hs)

theorem physical_marked_primes_card {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (labels : PhysicalMarkLists P J ell) :
    (physicalMarkedPrimes labels).card = (J + ell) * Fintype.card G := by
  simp only [physicalMarkedPrimes, card_map, card_univ, Fintype.card_sigma,
    Fintype.card_sum, Fintype.card_fin, sum_const, card_univ, nsmul_eq_mul]
  change Fintype.card G * (J + ell) = (J + ell) * Fintype.card G
  exact Nat.mul_comm _ _

/-- Divisibility of the tagged marked subset is exactly physical
admissibility of the ordered mark lists at the given position. -/
theorem physical_marked_divisibility_iff {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (labels : PhysicalMarkLists P J ell) (n : ℤ) :
    (∀ p ∈ physicalMarkedPrimes labels, (p.2.val : ℤ) ∣ n) ↔
      ∀ g s, ((labels g s).val : ℤ) ∣ n := by
  constructor
  · intro h g s
    apply h ⟨g, labels g s⟩
    rw [mem_physical_marked_primes, mem_physical_group_marks]
    exact ⟨s, rfl⟩
  · intro h p hp
    obtain ⟨s, hs⟩ := (mem_physical_group_marks labels p.1 p.2.val).mp
      ((mem_physical_marked_primes labels p).mp hp)
    rw [← hs]
    exact h p.1 s

/-- If the prime groups are disjoint, forgetting a prime's group tag
is injective, as required by the grouped residue theorem. -/
theorem physical_prime_value_injective {G : Type*} {P : G → Finset ℕ}
    (hP : Pairwise (fun g h => Disjoint (P g) (P h))) :
    Function.Injective (fun p : PhysicalPrime P => p.2.val) := by
  rintro ⟨g, p⟩ ⟨h, q⟩ hpq
  change p.val = q.val at hpq
  have hg : g = h := by
    by_contra hne
    apply (Finset.disjoint_left.mp (hP hne)) p.property
    rw [hpq]
    exact q.property
  cases hg
  exact congrArg (Sigma.mk g) (Subtype.ext hpq)
end

section
open Finset Classical
theorem unmarked_damping_product {T : Type*} [DecidableEq T]
    (pool marked : Finset T) (hit : T → Prop) [DecidablePred hit] (q : ℝ) :
    (∏ p ∈ pool, if p ∈ marked then (1 : ℝ) else if hit p then q else 1) =
      q^((pool \ marked).filter hit).card := by
  have he : ∀ p, (if p ∈ marked then (1 : ℝ) else if hit p then q else 1) =
      if p ∉ marked ∧ hit p then q else 1 := by
    intro p
    by_cases hm : p ∈ marked <;> by_cases hh : hit p <;> simp only [hm, hh, if_true, if_false, not_true_eq_false, not_false_eq_true, false_and, true_and]
  have hf : pool.filter (fun p => p ∉ marked ∧ hit p) = (pool \ marked).filter hit := by
    ext p
    simp only [mem_filter, mem_sdiff]
    tauto
  simp only [he, prod_ite, prod_const, one_pow, mul_one, hf]

/-- The full-excess damping product is a power of the number of unmarked
hits in the tagged prime pool. -/
theorem physical_count_damping_as_pool {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (n : ℤ) (labels : PhysicalMarksAt P J ell n) (q : ℝ) :
    (∏ g, q^(physicalOmega P g n - (J + ell))) =
      q^((univ \ physicalMarkedPrimes labels.val).filter
        (fun p : PhysicalPrime P => (p.2.val : ℤ) ∣ n)).card := by
  classical
  rw [← unmarked_damping_product]
  rw [Fintype.prod_sigma]
  apply prod_congr rfl
  intro g _
  simp only [mem_physical_marked_primes]
  rw [prod_coe_sort (P g) (fun p : ℕ => if p ∈ physicalGroupMarks labels.val g then (1 : ℝ)
    else if (p : ℤ) ∣ n then q else 1), unmarked_damping_product,
    physical_unmarked_divisor_count n labels g]

/-- The indicator of simultaneous divisibility is the product of its
individual zero-one indicators. -/
theorem finite_divisibility_indicator_product {T : Type*} (S : Finset T)
    (hit : T → Prop) [DecidablePred hit] :
    (∏ p ∈ S, if hit p then (1 : ℝ) else 0) = if ∀ p ∈ S, hit p then 1 else 0 := by
  classical
  by_cases h : ∀ p ∈ S, hit p
  · rw [if_pos h]
    exact prod_eq_one (fun p hp => if_pos (h p hp))
  · rw [if_neg h]
    push Not at h
    obtain ⟨p, hp, hn⟩ := h
    exact prod_eq_zero hp (if_neg hn)

/-- A weight defined for all mark lists, including those not dividing
n. Its parameter is the per-unmarked-prime damping, not its square. -/
noncomputable def physicalVertexWeight {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (labels : PhysicalMarkLists P J ell) (q : ℝ) (n : ℤ) : ℝ :=
  if ∀ g s, ((labels g s).val : ℤ) ∣ n then
    ∏ g, q^(physicalOmega P g n - (J + ell)) else 0

/-- This is exactly the vertex factor in grouped residue replacement. -/
theorem physical_vertex_weight_factor {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (labels : PhysicalMarkLists P J ell) (q : ℝ) (n : ℤ) :
    physicalVertexWeight labels q n =
      (∏ p ∈ physicalMarkedPrimes labels, if (p.2.val : ℤ) ∣ n then (1 : ℝ) else 0) *
        q^((univ \ physicalMarkedPrimes labels).filter
          (fun p : PhysicalPrime P => (p.2.val : ℤ) ∣ n)).card := by
  classical
  rw [finite_divisibility_indicator_product]
  simp only [physical_marked_divisibility_iff]
  unfold physicalVertexWeight
  by_cases h : ∀ g s, ((labels g s).val : ℤ) ∣ n
  · simp only [if_pos h, one_mul]
    exact physical_count_damping_as_pool n ⟨labels, h⟩ q
  · simp only [if_neg h, zero_mul]

/-- On an actual physical state, square-root vertex damping is exactly
the original physical endpoint damping. -/
theorem physical_vertex_weight_endpoint {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (n : ℤ) (labels : PhysicalMarksAt P J ell n)
    {q : ℝ} (hq : 0 ≤ q) :
    physicalVertexWeight labels.val (Real.sqrt q) n = physicalDamping P J ell q n := by
  rw [physicalVertexWeight, if_pos labels.property, physical_damping_as_unmarked n labels hq]
  apply prod_congr rfl
  intro g _
  rw [physical_unmarked_divisor_count n labels g]

/-- Repeated vertex factors multiply their per-prime damping parameters;
the divisibility indicator remains a single zero-one indicator. -/
theorem physical_vertex_weight_mul {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (labels : PhysicalMarkLists P J ell) (q r : ℝ) (n : ℤ) :
    physicalVertexWeight labels q n * physicalVertexWeight labels r n =
      physicalVertexWeight labels (q * r) n := by
  unfold physicalVertexWeight
  by_cases h : ∀ g s, ((labels g s).val : ℤ) ∣ n
  · simp only [if_pos h]
    rw [← prod_mul_distrib]
    apply prod_congr rfl
    intro g _
    exact (mul_pow q r _).symm
  · simp only [if_neg h, mul_zero]
end

section
open Finset
theorem physical_prime_pool_coprime {G : Type*} {P : G → Finset ℕ}
    (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime) :
    Pairwise (fun p q : PhysicalPrime P => Nat.Coprime p.2.val q.2.val) := by
  intro p q hpq
  exact (Nat.coprime_primes (hprime p.1 p.2.val p.2.property)
    (hprime q.1 q.2.val q.2.property)).mpr ((physical_prime_value_injective hP).ne hpq)

theorem physical_prime_harmonic_sum {G : Type*} [Fintype G]
    (P : G → Finset ℕ) :
    (∑ p : PhysicalPrime P, 1 / (p.2.val : ℝ)) = ∑ g, ∑ p ∈ P g, 1 / (p : ℝ) := by
  rw [Fintype.sum_sigma]
  apply sum_congr rfl
  intro g _
  exact sum_coe_sort (P g) (fun p : ℕ => 1 / (p : ℝ))

theorem physical_prime_harmonic_bound {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {V : ℝ} (hV : ∀ g, (∑ p ∈ P g, 1 / (p : ℝ)) ≤ V) :
    (∑ p : PhysicalPrime P, 1 / (p.2.val : ℝ)) ≤ Fintype.card G * V := by
  rw [physical_prime_harmonic_sum]
  calc
    _ ≤ ∑ _g : G, V := sum_le_sum (fun g _ => hV g)
    _ = _ := by simp

/-- All marked labels are distinct in the tagged pool, so their
individual divisibility probabilities form the original ordered product. -/
theorem physical_marked_probability_product {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (labels : PhysicalMarkLists P J ell) :
    (∏ p ∈ physicalMarkedPrimes labels, 1 / (p.2.val : ℝ)) =
      ∏ g, ∏ s, 1 / ((labels g s).val : ℝ) := by
  rw [physicalMarkedPrimes, prod_map, Fintype.prod_sigma]
  rfl

theorem physical_mark_prior_tagged_factor {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (labels : PhysicalMarkLists P J ell) :
    physicalMarkPriorMass V labels = physicalStateMass V J ell *
      ∏ p ∈ physicalMarkedPrimes labels, 1 / (p.2.val : ℝ) := by
  rw [physical_mark_prior_factor, physical_marked_probability_product]

/-- The state-free physical vertex product is exactly the local residue
product, with arbitrary offsets and damping values. -/
theorem physical_vertex_path_factorization {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (labels : ℕ → PhysicalMarkLists P J ell)
    (visits : Finset ℕ) (offset : ℕ → ℤ) (q : ℕ → ℝ) (n : ℤ) :
    (∏ j ∈ visits, physicalVertexWeight (labels j) (q j) (n + offset j)) =
      ∏ p : PhysicalPrime P, activeResidueWeight visits
        (visits.filter (fun j => p ∈ physicalMarkedPrimes (labels j)))
        (fun j => -(offset j : ZMod p.2.val)) (fun j => 1 - q j) (n : ZMod p.2.val) := by
  classical
  simp only [physical_vertex_weight_factor]
  exact physical_path_divisibility_factorization (fun p : PhysicalPrime P => p.2.val)
    univ visits (fun j => physicalMarkedPrimes (labels j)) offset q n (fun _ _ => subset_univ _)
end

section
open Filter Finset
open scoped Topology
theorem eventually_physical_vertex_replacement {a c d C V E γ : ℝ}
    (ha : 0 ≤ a) (hc : 0 < c) (hd : 0 < d) (had : a + d < 1)
    (hC : 0 < C) (hV : 0 < V) (hE : 0 ≤ E) (hγ : 0 < γ) (J ell : ℕ) :
    ∀ᶠ L : ℝ in atTop, ∀ (G : Type) [Fintype G] [DecidableEq G]
      (P : G → Finset ℕ) [∀ p : PhysicalPrime P, NeZero p.2.val]
      (labels : ℕ → PhysicalMarkLists P J ell) (offset : ℕ → ℤ) (q : ℕ → ℝ) (N : ℕ) (z : ℤ),
      let n := 2 * Nat.ceil (L^a)
      let visits := range (n + 1)
      Pairwise (fun g h => Disjoint (P g) (P h)) →
      (∀ g p, p ∈ P g → p.Prime) →
      (Fintype.card G : ℝ) ≤ C * Real.log L →
      (∀ g, (∑ p ∈ P g, 1 / (p : ℝ)) ≤ V) →
      (∀ g p, p ∈ P g → Real.exp (L^c) ≤ (p : ℝ)) →
      (∀ g p, p ∈ P g → (p : ℝ) ≤ Real.exp (L^d)) →
      (∀ j ∈ visits, 0 ≤ q j ∧ q j ≤ 1) → 0 < N → γ * L ≤ Real.log (N : ℝ) →
      |((∑ k ∈ Ico z (z + N), ∏ j ∈ visits,
          physicalVertexWeight (labels j) (q j) (k + offset j)) / (N : ℝ)) -
        poolPathResidueExpectation (fun p : PhysicalPrime P => p.2.val) univ visits
          (fun p => visits.filter (fun j => p ∈ physicalMarkedPrimes (labels j)))
          (fun p j => -(offset j : ZMod p.2.val)) (fun j => 1 - q j)| ≤
        Real.exp (-E * n * Real.log L) *
          poolPathResidueExpectation (fun p : PhysicalPrime P => p.2.val) univ visits
            (fun p => visits.filter (fun j => p ∈ physicalMarkedPrimes (labels j)))
            (fun p j => -(offset j : ZMod p.2.val)) (fun j => 1 - q j) := by
  filter_upwards [eventually_grouped_path_replacement ha hc hd had hC hV hE hγ (J + ell)] with L hL
  intro G _ _ P _ labels offset q N z
  dsimp only
  intro hdis hprime hs hH hmin hmax hq hN hNb
  have hcop : ((univ : Finset (PhysicalPrime P)) : Set (PhysicalPrime P)).Pairwise
      (fun p r => Nat.Coprime p.2.val r.2.val) := by
    intro p _ r _ hne
    exact physical_prime_pool_coprime hdis hprime hne
  have he := hL (PhysicalPrime P) (fun p => p.2.val) univ (Fintype.card G)
    (fun j => physicalMarkedPrimes (labels j)) offset q N z hcop
    (physical_prime_value_injective hdis).injOn hs (physical_prime_harmonic_bound P hH)
    (fun p _ => hmin p.1 p.2.val p.2.property) (fun p _ => hmax p.1 p.2.val p.2.property)
    (fun _ _ => subset_univ _) (fun j _ => by rw [physical_marked_primes_card]) hq hN hNb
  simpa only [← physical_vertex_weight_factor] using he
end

section
open Finset
/-- A path of N+1 edges visits N interior vertices twice. -/
theorem adjacent_endpoint_product (d : ℕ → ℝ) (N : ℕ) :
    (∏ j ∈ range (N + 1), d j * d (j + 1)) =
      d 0 * d (N + 1) * ∏ j ∈ range N, (d (j + 1))^2 := by
  induction N with
  | zero => simp
  | succ N ih =>
    rw [prod_range_succ, ih, prod_range_succ]
    ring

/-- The zero-one state condition is preserved when two endpoint damping
factors meet at an interior vertex. -/
theorem physical_vertex_endpoint_square {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (labels : PhysicalMarkLists P J ell)
    {q : ℝ} (hq : 0 ≤ q) (n : ℤ) :
    (physicalVertexWeight labels (Real.sqrt q) n)^2 = physicalVertexWeight labels q n := by
  rw [pow_two, physical_vertex_weight_mul, Real.mul_self_sqrt hq]

/-- Edge endpoint factors equal the vertex damping factors used in the
residue expression, including when a divisibility condition fails. -/
theorem physical_edge_endpoint_product {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (labels : ℕ → PhysicalMarkLists P J ell)
    (position : ℕ → ℤ) {q : ℝ} (hq : 0 ≤ q) (N : ℕ) :
    (∏ j ∈ range (N + 1),
      physicalVertexWeight (labels j) (Real.sqrt q) (position j) *
        physicalVertexWeight (labels (j + 1)) (Real.sqrt q) (position (j + 1))) =
      physicalVertexWeight (labels 0) (Real.sqrt q) (position 0) *
        physicalVertexWeight (labels (N + 1)) (Real.sqrt q) (position (N + 1)) *
        ∏ j ∈ range N, physicalVertexWeight (labels (j + 1)) q (position (j + 1)) := by
  rw [adjacent_endpoint_product]
  simp only [physical_vertex_endpoint_square _ hq]
end

section
open Finset
/-- A product of uniform residue laws assigns simultaneous zero residues
at marked coordinates probability equal to the product of their reciprocals. -/
theorem uniform_marked_residue_probability {ι : Type*} [Fintype ι] [DecidableEq ι]
    (m : ι → ℕ) [∀ i, NeZero (m i)] (marked : Finset ι) :
    (∑ r : ∀ i, ZMod (m i), ∏ i,
      (if i ∈ marked then (if r i = 0 then (1 : ℝ) else 0) else 1) / (m i : ℝ)) =
      ∏ i ∈ marked, 1 / (m i : ℝ) := by
  classical
  have he : (∑ r : ∀ i, ZMod (m i), ∏ i,
      (if i ∈ marked then (if r i = 0 then (1 : ℝ) else 0) else 1) / (m i : ℝ)) =
      ∏ i, ∑ a : ZMod (m i), (if i ∈ marked then (if a = 0 then (1 : ℝ) else 0) else 1) / (m i : ℝ) :=
    (Fintype.prod_sum (fun i (a : ZMod (m i)) =>
      (if i ∈ marked then (if a = 0 then (1 : ℝ) else 0) else 1) / (m i : ℝ))).symm
  rw [he]
  have hlocal : ∀ i, (∑ a : ZMod (m i),
      (if i ∈ marked then (if a = 0 then (1 : ℝ) else 0) else 1) / (m i : ℝ)) =
      if i ∈ marked then 1 / (m i : ℝ) else 1 := by
    intro i
    have hm : (m i : ℝ) ≠ 0 := by exact_mod_cast NeZero.ne (m i)
    by_cases hi : i ∈ marked
    · simp only [if_pos hi]
      rw [← sum_div]
      simp
    · simp [hi, ZMod.card, hm]
  simp only [hlocal, prod_ite_mem, univ_inter]

/-- The independent-residue mass of an initial marked state is exactly
the prior whose total mass was bounded using injective tuples. -/
theorem physical_initial_residue_mass {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : G → ℝ) (labels : PhysicalMarkLists P J ell) :
    physicalStateMass V J ell *
      (∑ r : ∀ p : PhysicalPrime P, ZMod p.2.val, ∏ p : PhysicalPrime P,
        (if p ∈ physicalMarkedPrimes labels then (if r p = 0 then (1 : ℝ) else 0) else 1) / (p.2.val : ℝ)) =
      physicalMarkPriorMass V labels := by
  rw [uniform_marked_residue_probability, ← physical_mark_prior_tagged_factor]

/-- After averaging the residue coordinates, the total initial physical
mark mass is at most one. This is an explicit averaging identity, not an
assumed normalization of the integer-position state count. -/
theorem physical_initial_residue_total_mass {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) :
    (∑ labels : PhysicalMarkLists P J ell, physicalStateMass V J ell *
      (∑ r : ∀ p : PhysicalPrime P, ZMod p.2.val, ∏ p : PhysicalPrime P,
        (if p ∈ physicalMarkedPrimes labels then (if r p = 0 then (1 : ℝ) else 0) else 1) / (p.2.val : ℝ))) ≤ 1 := by
  simp only [physical_initial_residue_mass]
  exact physical_mark_prior_total_mass V hV hMass
end

section
open Finset
noncomputable def physicalEndpointSchedule (q : ℝ) (edges j : ℕ) : ℝ :=
  if j = 0 ∨ j = edges then Real.sqrt q else q

theorem physical_endpoint_schedule_unit {q : ℝ} (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (edges j : ℕ) :
    0 ≤ physicalEndpointSchedule q edges j ∧ physicalEndpointSchedule q edges j ≤ 1 := by
  have hs : Real.sqrt q ≤ 1 := by simpa only [Real.sqrt_one] using Real.sqrt_le_sqrt hq1
  unfold physicalEndpointSchedule
  split_ifs
  · exact ⟨Real.sqrt_nonneg q, hs⟩
  · exact ⟨hq0, hq1⟩

theorem range_product_endpoints (f : ℕ → ℝ) (N : ℕ) :
    (∏ j ∈ range (N + 2), f j) = f 0 * f (N + 1) * ∏ j ∈ range N, f (j + 1) := by
  rw [prod_range_succ, prod_range_succ']
  ring

/-- The entire edge damping is precisely the vertex product to which
the physical residue-replacement estimate applies. -/
theorem physical_endpoint_schedule_product {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (labels : ℕ → PhysicalMarkLists P J ell)
    (position : ℕ → ℤ) {q : ℝ} (hq : 0 ≤ q) (N : ℕ) :
    (∏ j ∈ range (N + 1),
      physicalVertexWeight (labels j) (Real.sqrt q) (position j) *
        physicalVertexWeight (labels (j + 1)) (Real.sqrt q) (position (j + 1))) =
      ∏ j ∈ range (N + 2), physicalVertexWeight (labels j)
        (physicalEndpointSchedule q (N + 1) j) (position j) := by
  rw [physical_edge_endpoint_product labels position hq N, range_product_endpoints]
  have h0 : physicalEndpointSchedule q (N + 1) 0 = Real.sqrt q := by simp [physicalEndpointSchedule]
  have hlast : physicalEndpointSchedule q (N + 1) (N + 1) = Real.sqrt q := by simp [physicalEndpointSchedule]
  rw [h0, hlast]
  congr 1
  apply prod_congr rfl
  intro j hj
  have hjN : j < N := mem_range.mp hj
  have hne0 : j + 1 ≠ 0 := by omega
  have hnelast : j + 1 ≠ N + 1 := by omega
  simp only [physicalEndpointSchedule, hne0, hnelast, or_self, if_false]
end

section
open Finset
/-- Structural constraints of an edge, with no integer position. -/
def physicalListAdmissible {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (L R : PhysicalMarkLists P J ell) : Prop :=
  physicalSharedCompatible C L R ∧ physicalAuxAvoids C aux L ∧ physicalAuxAvoids C aux R

theorem physical_admissible_split {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) (x y : PhysicalState P J ell) :
    physicalAdmissible C aux k x y ↔
      physicalListAdmissible C aux x.2.val y.2.val ∧ y.1 = x.1 + k * (physicalD C x.2.val aux : ℕ) := by
  unfold physicalAdmissible physicalListAdmissible
  tauto

/-- The bare scalar contains all list constraints, normalized label
weights, the list coefficient, and the phase. It has no position or damping. -/
noncomputable def physicalBarePatternScalar {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J)) (ζ : ℝ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (L R : PhysicalMarkLists P J ell) : ℂ := by
  classical
  exact if physicalListAdmissible C aux L R then
    ((physicalAuxMass V C aux * physicalCompletionMass V C ell : ℝ) : ℂ) * K L R aux *
      physicalPhase ζ (physicalD C L aux) else 0

/-- An actual edge is a bare scalar times its two endpoint damping
factors, and its only remaining support condition is translation. -/
theorem physical_edge_scalar_factor {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J)) (q ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (x y : PhysicalState P J ell) :
    physicalEdgeCoeff V C q ζ k K aux x y =
      if y.1 = x.1 + k * (physicalD C x.2.val aux : ℕ) then
        physicalBarePatternScalar V C ζ K aux x.2.val y.2.val *
          ((physicalDamping P J ell q x.1 * physicalDamping P J ell q y.1 : ℝ) : ℂ) else 0 := by
  classical
  by_cases hs : physicalListAdmissible C aux x.2.val y.2.val
  · by_cases ht : y.1 = x.1 + k * (physicalD C x.2.val aux : ℕ)
    · have ha := (physical_admissible_split C aux k x y).mpr ⟨hs, ht⟩
      simp only [physicalEdgeCoeff, physicalBarePatternScalar, if_pos hs, if_pos ht, if_pos ha]
      push_cast
      ring
    · have ha : ¬ physicalAdmissible C aux k x y := fun h => ht ((physical_admissible_split C aux k x y).mp h).2
      simp only [physicalEdgeCoeff, if_neg ha, if_neg ht]
  · have ha : ¬ physicalAdmissible C aux k x y := fun h => hs ((physical_admissible_split C aux k x y).mp h).1
    simp only [physicalEdgeCoeff, physicalBarePatternScalar, if_neg ha, if_neg hs, zero_mul, ite_self]

/-- The same factorization uses the state-free vertex weights, ready to
be evaluated at a variable starting integer. -/
theorem physical_edge_vertex_factor {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (x y : PhysicalState P J ell) :
    physicalEdgeCoeff V C q ζ k K aux x y =
      if y.1 = x.1 + k * (physicalD C x.2.val aux : ℕ) then
        physicalBarePatternScalar V C ζ K aux x.2.val y.2.val *
          ((physicalVertexWeight x.2.val (Real.sqrt q) x.1 *
            physicalVertexWeight y.2.val (Real.sqrt q) y.1 : ℝ) : ℂ) else 0 := by
  rw [physical_vertex_weight_endpoint x.1 x.2 hq, physical_vertex_weight_endpoint y.1 y.2 hq]
  exact physical_edge_scalar_factor V C q ζ k K aux x y
end

section
open Finset
def physicalPermuteLabels {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (σ : PhysicalPermutations G J ell) (L : PhysicalMarkLists P J ell) : PhysicalMarkLists P J ell :=
  fun g => (σ g).toEmbedding.trans (L g)

theorem physical_permutation_marks {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (σ : PhysicalPermutations G J ell) (x : PhysicalState P J ell) :
    (physicalPermutationEquiv σ x).2.val = physicalPermuteLabels σ x.2.val := rfl

/-- Translation of a labeled edge is determined by its source marks. -/
noncomputable def physicalBareStep {G I : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} {patterns : Finset I} (C : I → G → Finset (Fin J)) (k : I → ℤ)
    (a : PhysicalEdgeLabels P J ell patterns C) (L : PhysicalMarkLists P J ell) : ℤ :=
  k a.2.2.1.val * (physicalD (C a.2.2.1.val) (physicalPermuteLabels a.1 L) a.2.2.2 : ℕ)

/-- All scalar factors of a labeled edge except its vertex damping and
translation condition. The expression is independent of the starting integer. -/
noncomputable def physicalBareLabeledScalar {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (ζ : I → ℝ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (L R : PhysicalMarkLists P J ell) : ℂ :=
  (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
    (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
      physicalBarePatternScalar V (C a.2.2.1.val) (ζ a.2.2.1.val) (K a.2.2.1.val) a.2.2.2
        (physicalPermuteLabels a.1 L) (physicalPermuteLabels a.2.1 R)

/-- Exact factorization of the individual labeled physical coefficient. -/
theorem physical_labeled_vertex_factor {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (x y : PhysicalState P J ell) :
    physicalLabeledCoeff V patterns C q ζ k K a x y =
      if y.1 = x.1 + physicalBareStep C k a x.2.val then
        physicalBareLabeledScalar V patterns C ζ K a x.2.val y.2.val *
          ((physicalVertexWeight x.2.val (Real.sqrt q) x.1 *
            physicalVertexWeight y.2.val (Real.sqrt q) y.1 : ℝ) : ℂ) else 0 := by
  unfold physicalLabeledCoeff
  rw [physical_edge_scalar_factor, mul_ite, mul_zero]
  change (if y.1 = x.1 + physicalBareStep C k a x.2.val then
    (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
      (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
      (physicalBarePatternScalar V (C a.2.2.1.val) (ζ a.2.2.1.val) (K a.2.2.1.val)
        a.2.2.2 (physicalPermuteLabels a.1 x.2.val) (physicalPermuteLabels a.2.1 y.2.val) *
          ((physicalDamping P J ell q x.1 * physicalDamping P J ell q y.1 : ℝ) : ℂ))
    else 0) = _
  rw [physical_vertex_weight_endpoint x.1 x.2 hq, physical_vertex_weight_endpoint y.1 y.2 hq]
  unfold physicalBareLabeledScalar
  split_ifs <;> ring

/-- The bare scalar vanishes whenever its structural list conditions fail. -/
theorem physical_bare_scalar_zero_of_incompatible {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (ζ : I → ℝ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (L R : PhysicalMarkLists P J ell)
    (h : ¬ physicalListAdmissible (C a.2.2.1.val) a.2.2.2
      (physicalPermuteLabels a.1 L) (physicalPermuteLabels a.2.1 R)) :
    physicalBareLabeledScalar V patterns C ζ K a L R = 0 := by
  simp only [physicalBareLabeledScalar, physicalBarePatternScalar, if_neg h, mul_zero]
end

section
open Finset
noncomputable def physicalBareOffset {G I : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} {patterns : Finset I}
    (C : I → G → Finset (Fin J)) (k : ℕ → I → ℤ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (edges : ℕ) : ℕ → ℤ
  | 0 => 0
  | j + 1 => physicalBareOffset C k a L edges j + physicalBareStep C (k (edges - 1 - j)) (a j) (L j)

/-- Every bare step obeys the same finite displacement bound as a
physical edge, without requiring divisibility at any integer position. -/
theorem physical_bare_step_bound {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} {patterns : Finset I}
    (C : I → G → Finset (Fin J)) (k : I → ℤ)
    (a : PhysicalEdgeLabels P J ell patterns C) (L : PhysicalMarkLists P J ell) :
    (physicalBareStep C k a L).natAbs ≤ physicalOperatorStepBound P J ell patterns C k := by
  unfold physicalBareStep
  rw [Int.natAbs_mul, Int.natAbs_natCast]
  exact (Nat.mul_le_mul_left _ (physical_D_le_max P J ell (C a.2.2.1.val)
    (physicalPermuteLabels a.1 L) a.2.2.2)).trans
    (le_sup (f := fun i => physicalStepBound P J ell (C i) (k i)) a.2.2.1.property)

/-- Uniform bounds on the time-dependent steps give a bound on every
bare offset, including for mark data that fail a divisibility condition. -/
theorem physical_bare_offset_bound {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} {patterns : Finset I}
    (C : I → G → Finset (Fin J)) (k : ℕ → I → ℤ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (edges b : ℕ)
    (hbound : ∀ r < edges, physicalOperatorStepBound P J ell patterns C (k r) ≤ b) :
    ∀ j ≤ edges, (physicalBareOffset C k a L edges j).natAbs ≤ j * b := by
  have hstep : ∀ j < edges,
      (physicalBareOffset C k a L edges (j + 1) - physicalBareOffset C k a L edges j).natAbs ≤ b := by
    intro j hj
    have he : physicalBareOffset C k a L edges (j + 1) - physicalBareOffset C k a L edges j =
        physicalBareStep C (k (edges - 1 - j)) (a j) (L j) := by rw [physicalBareOffset]; ring
    rw [he]
    exact (physical_bare_step_bound C (k (edges - 1 - j)) (a j) (L j)).trans
      (hbound _ (by omega))
  intro j hj
  simpa only [physicalBareOffset, sub_zero] using integer_walk_displacement hstep j hj

/-- All bare-path positions lie in the finite reachable interval union.
No nonzero-coefficient assumption is required for this bound. -/
theorem physical_bare_position_mem_reachable {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} {patterns : Finset I}
    (C : I → G → Finset (Fin J)) (k : ℕ → I → ℤ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (edges b : ℕ)
    (hbound : ∀ r < edges, physicalOperatorStepBound P J ell patterns C (k r) ≤ b)
    {positions : Finset ℤ} {n : ℤ} (hn : n ∈ positions) {j : ℕ} (hj : j ≤ edges) :
    n + physicalBareOffset C k a L edges j ∈ reachablePositions positions (edges * b) := by
  apply mem_reachable_positions hn
  have he : n + physicalBareOffset C k a L edges j - n = physicalBareOffset C k a L edges j := by ring
  rw [he]
  exact (physical_bare_offset_bound C k a L edges b hbound j hj).trans (Nat.mul_le_mul_right b hj)

/-- Any walk satisfying the edge translation equations has exactly the
offsets determined by its bare mark and label data. -/
theorem physical_walk_position_eq_bare_offset {G I : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} {patterns : Finset I}
    (C : I → G → Finset (Fin J)) (k : ℕ → I → ℤ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C) (walk : ℕ → PhysicalState P J ell) (edges : ℕ)
    (hstep : ∀ j < edges, (walk (j + 1)).1 = (walk j).1 +
      physicalBareStep C (k (edges - 1 - j)) (a j) (walk j).2.val) :
    ∀ j ≤ edges, (walk j).1 = (walk 0).1 +
      physicalBareOffset C k a (fun r => (walk r).2.val) edges j := by
  intro j
  induction j with
  | zero => simp [physicalBareOffset]
  | succ j ih =>
    intro hj
    rw [hstep j (by omega)]
    conv_lhs => lhs; rw [ih (by omega)]
    rw [physicalBareOffset]
    ring
end

section
open Finset
theorem physical_labeled_zero_of_translation_ne {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (x y : PhysicalState P J ell)
    (h : y.1 ≠ x.1 + physicalBareStep C k a x.2.val) :
    physicalLabeledCoeff V patterns C q ζ k K a x y = 0 := by
  rw [physical_labeled_vertex_factor V patterns C hq ζ k K a x y, if_neg h]

/-- The coefficient of a path before imposing its vertex divisibilities. -/
noncomputable def physicalBareWalkScalar {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (ζ : ℕ → I → ℝ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (edges : ℕ) : ℂ :=
  ∏ j ∈ range edges, physicalBareLabeledScalar V patterns C (ζ (edges - 1 - j))
    (K (edges - 1 - j)) (a j) (L j) (L (j + 1))

/-- A translated walk's full complex coefficient is its bare scalar
times precisely the scheduled vertex weight. -/
theorem physical_labeled_walk_factor {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (walk : ℕ → PhysicalState P J ell) (N : ℕ)
    (hstep : ∀ j < N + 1, (walk (j + 1)).1 = (walk j).1 +
      physicalBareStep C (k (N - j)) (a j) (walk j).2.val) :
    (∏ j ∈ range (N + 1), physicalLabeledCoeff V patterns C q (ζ (N - j))
      (k (N - j)) (K (N - j)) (a j) (walk j) (walk (j + 1))) =
      physicalBareWalkScalar V patterns C ζ K a (fun j => (walk j).2.val) (N + 1) *
        ((∏ j ∈ range (N + 2), physicalVertexWeight (walk j).2.val
          (physicalEndpointSchedule q (N + 1) j) (walk j).1 : ℝ) : ℂ) := by
  have he : (∏ j ∈ range (N + 1), physicalLabeledCoeff V patterns C q (ζ (N - j))
      (k (N - j)) (K (N - j)) (a j) (walk j) (walk (j + 1))) =
      ∏ j ∈ range (N + 1), physicalBareLabeledScalar V patterns C (ζ (N - j))
        (K (N - j)) (a j) (walk j).2.val (walk (j + 1)).2.val *
          ((physicalVertexWeight (walk j).2.val (Real.sqrt q) (walk j).1 *
            physicalVertexWeight (walk (j + 1)).2.val (Real.sqrt q) (walk (j + 1)).1 : ℝ) : ℂ) := by
    apply prod_congr rfl
    intro j hj
    rw [physical_labeled_vertex_factor V patterns C hq, if_pos (hstep j (mem_range.mp hj))]
  rw [he, prod_mul_distrib, ← Complex.ofReal_prod]
  rw [physical_endpoint_schedule_product (fun j => (walk j).2.val) (fun j => (walk j).1) hq]
  rfl

/-- Substitution of the uniquely determined offsets puts the walk in
the exact form required by the vertex residue-replacement theorem. -/
theorem physical_labeled_walk_offset_factor {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (walk : ℕ → PhysicalState P J ell) (N : ℕ)
    (hstep : ∀ j < N + 1, (walk (j + 1)).1 = (walk j).1 +
      physicalBareStep C (k (N - j)) (a j) (walk j).2.val) :
    (∏ j ∈ range (N + 1), physicalLabeledCoeff V patterns C q (ζ (N - j))
      (k (N - j)) (K (N - j)) (a j) (walk j) (walk (j + 1))) =
      physicalBareWalkScalar V patterns C ζ K a (fun j => (walk j).2.val) (N + 1) *
        ((∏ j ∈ range (N + 2), physicalVertexWeight (walk j).2.val
          (physicalEndpointSchedule q (N + 1) j)
          ((walk 0).1 + physicalBareOffset C k a (fun j => (walk j).2.val) (N + 1) j) : ℝ) : ℂ) := by
  rw [physical_labeled_walk_factor V patterns C hq ζ k K a walk N hstep]
  congr 2
  apply prod_congr rfl
  intro j hj
  apply congrArg (physicalVertexWeight (walk j).2.val (physicalEndpointSchedule q (N + 1) j))
  exact physical_walk_position_eq_bare_offset C k a walk (N + 1)
    (by simpa only [Nat.add_sub_cancel] using hstep) j (by have := mem_range.mp hj; omega)

/-- A product with a nonzero value necessarily follows every prescribed
translation, even if arbitrary cancellations occur between different paths. -/
theorem physical_nonzero_walk_translations {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (walk : ℕ → PhysicalState P J ell) (edges : ℕ)
    (h : (∏ j ∈ range edges, physicalLabeledCoeff V patterns C q (ζ (edges - 1 - j))
      (k (edges - 1 - j)) (K (edges - 1 - j)) (a j) (walk j) (walk (j + 1))) ≠ 0) :
    ∀ j < edges, (walk (j + 1)).1 = (walk j).1 +
      physicalBareStep C (k (edges - 1 - j)) (a j) (walk j).2.val := by
  intro j hj
  by_contra hn
  exact h (prod_eq_zero (mem_range.mpr hj)
    (physical_labeled_zero_of_translation_ne V patterns C hq _ _ _ (a j) _ _ hn))
end

section
open Finset Classical
theorem physical_cutoff_sum {G R : Type*} [Fintype G] [DecidableEq G] [AddCommMonoid R]
    (P : G → Finset ℕ) (J ell : ℕ) (positions : Finset ℤ)
    (f : PhysicalState P J ell → R) :
    (∑ x ∈ physicalCutoff P J ell positions, f x) =
      ∑ n ∈ positions, ∑ L : PhysicalMarksAt P J ell n, f ⟨n, L⟩ := by
  classical
  let _ := physicalCutoffFintype P J ell positions
  unfold physicalCutoff
  rw [sum_map]
  change (∑ x : {x : PhysicalState P J ell // x.1 ∈ positions}, f x.val) = _
  rw [← Equiv.sum_comp (physicalCutoffEquiv P J ell positions).symm (fun x => f x.val),
    Fintype.sum_sigma]
  exact sum_coe_sort positions (fun n => ∑ L : PhysicalMarksAt P J ell n, f ⟨n, L⟩)

/-- Restricting a complete cutoff to one position leaves precisely that
position's mark fiber. -/
theorem physical_cutoff_sum_at {G R : Type*} [Fintype G] [DecidableEq G] [AddCommMonoid R]
    (P : G → Finset ℕ) (J ell : ℕ) (positions : Finset ℤ) (m : ℤ)
    (f : PhysicalMarkLists P J ell → R) :
    (∑ x ∈ physicalCutoff P J ell positions, if x.1 = m then f x.2.val else 0) =
      if m ∈ positions then ∑ L : PhysicalMarksAt P J ell m, f L.val else 0 := by
  classical
  rw [physical_cutoff_sum]
  have he : ∀ n : ℤ, (∑ L : PhysicalMarksAt P J ell n, if n = m then f L.val else 0) =
      if n = m then ∑ L : PhysicalMarksAt P J ell m, f L.val else 0 := by
    intro n
    by_cases h : n = m
    · subst n
      simp
    · simp [h]
  simp only [he]
  simp

/-- A function vanishing on inadmissible mark lists can be summed over
all lists instead of the divisibility fiber. -/
theorem physical_marks_sum_all {G R : Type*} [Fintype G] [DecidableEq G] [AddCommMonoid R]
    (P : G → Finset ℕ) (J ell : ℕ) (n : ℤ)
    (f : PhysicalMarkLists P J ell → R)
    (hzero : ∀ L, ¬ (∀ g s, ((L g s).val : ℤ) ∣ n) → f L = 0) :
    (∑ L : PhysicalMarksAt P J ell n, f L.val) = ∑ L : PhysicalMarkLists P J ell, f L := by
  exact (sum_congr_set {L : PhysicalMarkLists P J ell | ∀ g s, ((L g s).val : ℤ) ∣ n}
    f (fun L => f L.val) (fun _ _ => rfl) hzero).symm

/-- A vertex weight supplies the vanishing required to replace the
fiber sum by an unrestricted sum over mark lists. -/
theorem physical_vertex_fiber_sum {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (n : ℤ) (q : ℝ)
    (f : PhysicalMarkLists P J ell → ℂ) :
    (∑ L : PhysicalMarksAt P J ell n, f L.val * (physicalVertexWeight L.val q n : ℂ)) =
      ∑ L : PhysicalMarkLists P J ell, f L * (physicalVertexWeight L q n : ℂ) := by
  apply physical_marks_sum_all P J ell n (fun L => f L * (physicalVertexWeight L q n : ℂ))
  intro L h
  simp only [physicalVertexWeight, if_neg h, Complex.ofReal_zero, mul_zero]
end

section
open Finset Classical
theorem physical_labeled_row_as_marks {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (x : PhysicalState P J ell)
    (positions : Finset ℤ) (f : ℤ → PhysicalMarkLists P J ell → ℂ) :
    (∑ y ∈ physicalCutoff P J ell positions,
      physicalLabeledCoeff V patterns C q ζ k K a x y * f y.1 y.2.val) =
      if x.1 + physicalBareStep C k a x.2.val ∈ positions then
        ∑ R : PhysicalMarkLists P J ell,
          physicalBareLabeledScalar V patterns C ζ K a x.2.val R *
            ((physicalVertexWeight x.2.val (Real.sqrt q) x.1 *
              physicalVertexWeight R (Real.sqrt q) (x.1 + physicalBareStep C k a x.2.val) : ℝ) : ℂ) *
            f (x.1 + physicalBareStep C k a x.2.val) R
      else 0 := by
  let m := x.1 + physicalBareStep C k a x.2.val
  let F : PhysicalMarkLists P J ell → ℂ := fun R =>
    physicalBareLabeledScalar V patterns C ζ K a x.2.val R *
      ((physicalVertexWeight x.2.val (Real.sqrt q) x.1 *
        physicalVertexWeight R (Real.sqrt q) m : ℝ) : ℂ) * f m R
  have he : ∀ y : PhysicalState P J ell,
      physicalLabeledCoeff V patterns C q ζ k K a x y * f y.1 y.2.val =
        if y.1 = m then F y.2.val else 0 := by
    intro y
    rw [physical_labeled_vertex_factor V patterns C hq]
    change (if y.1 = m then _ else _) * _ = _
    rcases y with ⟨n, L⟩
    change (if n = m then _ else _) * _ = if n = m then _ else _
    by_cases h : n = m
    · subst n
      simp only [if_true]
      rfl
    · simp only [if_neg h, zero_mul]
  simp only [he]
  rw [physical_cutoff_sum_at]
  change (if m ∈ positions then ∑ L : PhysicalMarksAt P J ell m, F L.val else 0) =
    if m ∈ positions then ∑ L : PhysicalMarkLists P J ell, F L else 0
  congr 1
  apply physical_marks_sum_all P J ell m F
  intro L h
  simp only [F, physicalVertexWeight, if_neg h, mul_zero, Complex.ofReal_zero, zero_mul]
end

section
open Finset
noncomputable def finiteCutoffAction {X R : Type*} [Semiring R]
    (rows : Finset X) (K : ℕ → X → X → R) (terminal : X → R) : ℕ → X → R
  | 0, x => terminal x
  | r + 1, x => ∑ y ∈ rows, K r x y * finiteCutoffAction rows K terminal r y

theorem finite_cutoff_action_eq_finite {X R : Type*} [Semiring R]
    (rows : Finset X) (K : ℕ → X → X → R) (terminal : X → R) (r : ℕ) (x : rows) :
    finiteCutoffAction rows K terminal r x.val =
      finitePathAction (fun j (a b : rows) => K j a.val b.val)
        (fun a : rows => terminal a.val) r x := by
  induction r generalizing x with
  | zero => rfl
  | succ r ih =>
    rw [finiteCutoffAction, finitePathAction, ← sum_coe_sort]
    apply sum_congr rfl
    intro y _
    rw [ih y]
end

section
open Finset Classical
noncomputable def physicalBareAction {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (positions : Finset ℤ) (terminal : ℤ → PhysicalMarkLists P J ell → ℂ) :
    ℕ → ℤ → PhysicalMarkLists P J ell → ℂ
  | 0, n, L => terminal n L
  | r + 1, n, L => ∑ a : PhysicalEdgeLabels P J ell patterns C,
      if n + physicalBareStep C (k r) a L ∈ positions then
        ∑ R : PhysicalMarkLists P J ell,
          physicalBareLabeledScalar V patterns C (ζ r) (K r) a L R *
            ((physicalVertexWeight L (Real.sqrt q) n *
              physicalVertexWeight R (Real.sqrt q) (n + physicalBareStep C (k r) a L) : ℝ) : ℂ) *
            physicalBareAction V patterns C q ζ k K positions terminal r
              (n + physicalBareStep C (k r) a L) R
      else 0

/-- Every finite physical iterate equals the corresponding bare
iterate. Divisibility failures are included with zero weight. -/
theorem physical_cutoff_action_eq_bare {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (positions : Finset ℤ) (terminal : ℤ → PhysicalMarkLists P J ell → ℂ)
    (r : ℕ) (x : PhysicalState P J ell) :
    finiteCutoffAction (physicalCutoff P J ell positions)
      (fun j a b => ∑ label : PhysicalEdgeLabels P J ell patterns C,
        physicalLabeledCoeff V patterns C q (ζ j) (k j) (K j) label a b)
      (fun a => terminal a.1 a.2.val) r x =
        physicalBareAction V patterns C q ζ k K positions terminal r x.1 x.2.val := by
  induction r generalizing x with
  | zero => rfl
  | succ r ih =>
    rw [finiteCutoffAction, physicalBareAction]
    simp only [sum_mul, ih]
    rw [sum_comm]
    apply sum_congr rfl
    intro a _
    exact physical_labeled_row_as_marks V patterns C hq (ζ r) (k r) (K r) a x positions
      (physicalBareAction V patterns C q ζ k K positions terminal r)

/-- In particular, the finite symmetrized physical matrix has exactly
the same iterates as this sum over bare data. -/
theorem physical_symmetric_cutoff_action_eq_bare {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (positions : Finset ℤ) (terminal : ℤ → PhysicalMarkLists P J ell → ℂ)
    (r : ℕ) (x : ↥(physicalCutoff P J ell positions)) :
    finitePathAction (fun j (a b : ↥(physicalCutoff P J ell positions)) =>
      physicalSymmetricKernel (fun s t => ∑ i ∈ patterns,
        physicalPatternKernel V (C i) q (ζ j i) (k j i) (K j i) s t) a.val b.val)
      (fun a => terminal a.val.1 a.val.2.val) r x =
        physicalBareAction V patterns C q ζ k K positions terminal r x.val.1 x.val.2.val := by
  have h := physical_cutoff_action_eq_bare V patterns C hq ζ k K positions terminal r x.val
  rw [finite_cutoff_action_eq_finite _ _ _ r x] at h
  simpa only [physical_labeled_coefficient_sum] using h
end

section
open Finset
noncomputable def translatedPathAction {A M R : Type*} [Fintype A] [Fintype M] [Semiring R]
    (step : ℕ → A → M → ℤ) (E : ℕ → A → ℤ → M → M → R)
    (terminal : ℤ → M → R) : ℕ → ℤ → M → R
  | 0, n, L => terminal n L
  | r + 1, n, L => ∑ a, ∑ R, E r a n L R *
      translatedPathAction step E terminal r (n + step r a L) R

def translatedPathTerm {A M R : Type*} [Mul R]
    (step : ℕ → A → M → ℤ) (E : ℕ → A → ℤ → M → M → R)
    (terminal : ℤ → M → R) : (r : ℕ) → ℤ → M → (Fin r → A × M) → R
  | 0, n, L, _ => terminal n L
  | r + 1, n, L, p => E r (p 0).1 n L (p 0).2 *
      translatedPathTerm step E terminal r (n + step r (p 0).1 L) (p 0).2 (Fin.tail p)

theorem translated_path_expansion {A M R : Type*} [Fintype A] [Fintype M] [Semiring R]
    (step : ℕ → A → M → ℤ) (E : ℕ → A → ℤ → M → M → R)
    (terminal : ℤ → M → R) (r : ℕ) (n : ℤ) (L : M) :
    (∑ p : Fin r → A × M, translatedPathTerm step E terminal r n L p) =
      translatedPathAction step E terminal r n L := by
  classical
  induction r generalizing n L with
  | zero => simp [translatedPathTerm, translatedPathAction]
  | succ r ih =>
    calc
      _ = ∑ z : A × M, ∑ p : Fin r → A × M,
          E r z.1 n L z.2 * translatedPathTerm step E terminal r (n + step r z.1 L) z.2 p := by
        rw [← Equiv.sum_comp (Fin.consEquiv (fun _ : Fin (r + 1) => A × M))
          (fun p => translatedPathTerm step E terminal (r + 1) n L p), Fintype.sum_prod_type]
        rfl
      _ = ∑ z : A × M, E r z.1 n L z.2 *
          translatedPathAction step E terminal r (n + step r z.1 L) z.2 := by
        apply sum_congr rfl
        intro z _
        rw [← mul_sum, ih]
      _ = _ := by rw [Fintype.sum_prod_type]; rfl

theorem norm_translated_path_term {A M : Type*}
    (step : ℕ → A → M → ℤ) (E : ℕ → A → ℤ → M → M → ℂ)
    (terminal : ℤ → M → ℂ) (r : ℕ) (n : ℤ) (L : M) (p : Fin r → A × M) :
    ‖translatedPathTerm step E terminal r n L p‖ =
      translatedPathTerm step (fun j a n L R => ‖E j a n L R‖)
        (fun n L => ‖terminal n L‖) r n L p := by
  induction r generalizing n L with
  | zero => rfl
  | succ r ih => simp only [translatedPathTerm, norm_mul, ih]
end

section
open Finset Classical
noncomputable def physicalBareKernel {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (n : ℤ) (L R : PhysicalMarkLists P J ell) : ℂ :=
  physicalBareLabeledScalar V patterns C ζ K a L R *
    ((physicalVertexWeight L (Real.sqrt q) n *
      physicalVertexWeight R (Real.sqrt q) (n + physicalBareStep C k a L) : ℝ) : ℂ)

noncomputable def physicalBareFreeAction {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (terminal : ℤ → PhysicalMarkLists P J ell → ℂ) : ℕ → ℤ → PhysicalMarkLists P J ell → ℂ :=
  translatedPathAction (fun r => physicalBareStep C (k r))
    (fun r => physicalBareKernel V patterns C q (ζ r) (k r) (K r)) terminal

/-- A radius containing every possible remaining walk makes the cutoff
irrelevant, including for terms whose marks fail divisibility. -/
theorem physical_bare_action_remove_cutoff {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (positions : Finset ℤ) (terminal : ℤ → PhysicalMarkLists P J ell → ℂ) (r b : ℕ)
    (hbound : ∀ j < r, physicalOperatorStepBound P J ell patterns C (k j) ≤ b)
    (n : ℤ) (L : PhysicalMarkLists P J ell)
    (hsafe : ∀ m : ℤ, (m - n).natAbs ≤ r * b → m ∈ positions) :
    physicalBareAction V patterns C q ζ k K positions terminal r n L =
      physicalBareFreeAction V patterns C q ζ k K terminal r n L := by
  induction r generalizing n L with
  | zero => rfl
  | succ r ih =>
    change _ = translatedPathAction _ _ _ (r + 1) n L
    rw [physicalBareAction, translatedPathAction]
    apply sum_congr rfl
    intro a _
    have hs : (physicalBareStep C (k r) a L).natAbs ≤ b :=
      (physical_bare_step_bound C (k r) a L).trans (hbound r (by omega))
    have hm : n + physicalBareStep C (k r) a L ∈ positions := by
      apply hsafe
      simpa only [add_sub_cancel_left] using hs.trans (Nat.le_mul_of_pos_left b (by omega))
    rw [if_pos hm]
    apply sum_congr rfl
    intro R _
    change _ * physicalBareAction V patterns C q ζ k K positions terminal r _ R =
      _ * physicalBareFreeAction V patterns C q ζ k K terminal r _ R
    congr 1
    apply ih (fun j hj => hbound j (by omega))
    intro m hmn
    apply hsafe
    calc
      (m - n).natAbs = ((m - (n + physicalBareStep C (k r) a L)) +
          physicalBareStep C (k r) a L).natAbs := by congr 1; ring
      _ ≤ (m - (n + physicalBareStep C (k r) a L)).natAbs +
          (physicalBareStep C (k r) a L).natAbs := Int.natAbs_add_le _ _
      _ ≤ r * b + b := Nat.add_le_add hmn hs
      _ = (r + 1) * b := by ring

/-- The previously constructed reachable-position cutoff is large
enough for the unrestricted bare action. -/
theorem physical_bare_action_reachable {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (starts : Finset ℤ) (terminal : ℤ → PhysicalMarkLists P J ell → ℂ) (r b : ℕ)
    (hbound : ∀ j < r, physicalOperatorStepBound P J ell patterns C (k j) ≤ b)
    (n : ℤ) (L : PhysicalMarkLists P J ell) (hn : n ∈ starts) :
    physicalBareAction V patterns C q ζ k K (reachablePositions starts (r * b)) terminal r n L =
      physicalBareFreeAction V patterns C q ζ k K terminal r n L := by
  apply physical_bare_action_remove_cutoff V patterns C q ζ k K _ terminal r b hbound n L
  intro m hm
  exact mem_reachable_positions hn hm
end

section
open Finset
theorem physical_bare_position_step {G I : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} {patterns : Finset I}
    (C : I → G → Finset (Fin J)) (k : ℕ → I → ℤ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (edges j : ℕ) (n : ℤ) :
    n + physicalBareOffset C k a L edges j +
      physicalBareStep C (k (edges - 1 - j)) (a j) (L j) =
        n + physicalBareOffset C k a L edges (j + 1) := by
  rw [physicalBareOffset]
  ring

/-- The complete bare path factors for all n. Consequently a fixed
path's dependence on n is exactly the previously verified vertex product. -/
theorem physical_bare_path_factor {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (N : ℕ) (n : ℤ) :
    (∏ j ∈ range (N + 1), physicalBareKernel V patterns C q (ζ (N - j)) (k (N - j))
      (K (N - j)) (a j) (n + physicalBareOffset C k a L (N + 1) j) (L j) (L (j + 1))) =
      physicalBareWalkScalar V patterns C ζ K a L (N + 1) *
        ((∏ j ∈ range (N + 2), physicalVertexWeight (L j)
          (physicalEndpointSchedule q (N + 1) j)
          (n + physicalBareOffset C k a L (N + 1) j) : ℝ) : ℂ) := by
  have he : ∀ j, n + physicalBareOffset C k a L (N + 1) j +
      physicalBareStep C (k (N - j)) (a j) (L j) =
        n + physicalBareOffset C k a L (N + 1) (j + 1) := by
    intro j
    exact physical_bare_position_step C k a L (N + 1) j n
  simp only [physicalBareKernel, he]
  rw [prod_mul_distrib, ← Complex.ofReal_prod, physical_endpoint_schedule_product L
    (fun j => n + physicalBareOffset C k a L (N + 1) j) hq]
  rfl

/-- The return-to-root condition is independent of the root integer. -/
theorem physical_bare_return_iff {G I : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} {patterns : Finset I}
    (C : I → G → Finset (Fin J)) (k : ℕ → I → ℤ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (edges : ℕ) (n : ℤ) :
    n + physicalBareOffset C k a L edges edges = n ↔ physicalBareOffset C k a L edges edges = 0 := by
  omega
end

section
open Finset
theorem translated_path_term_product {A M R : Type*} [CommMonoid R]
    (step : ℕ → A → M → ℤ) (E : ℕ → A → ℤ → M → M → R)
    (terminal : ℤ → M → R) (edges : ℕ) (a : ℕ → A) (L : ℕ → M) (position : ℕ → ℤ)
    (hstep : ∀ j < edges, position (j + 1) = position j + step (edges - 1 - j) (a j) (L j)) :
    translatedPathTerm step E terminal edges (position 0) (L 0)
      (fun j : Fin edges => (a j.val, L (j.val + 1))) =
        (∏ j ∈ range edges, E (edges - 1 - j) (a j) (position j) (L j) (L (j + 1))) *
          terminal (position edges) (L edges) := by
  induction edges generalizing a L position with
  | zero => simp [translatedPathTerm]
  | succ edges ih =>
    have htime : ∀ j, edges + 1 - 1 - (j + 1) = edges - 1 - j := by omega
    have ht : ∀ j < edges, position (j + 1 + 1) = position (j + 1) +
        step (edges - 1 - j) (a (j + 1)) (L (j + 1)) := by
      intro j hj
      simpa only [htime] using hstep (j + 1) (by omega)
    have hi := ih (fun j => a (j + 1)) (fun j => L (j + 1)) (fun j => position (j + 1)) ht
    have hfirst : position 1 = position 0 + step edges (a 0) (L 0) := by
      simpa only [Nat.add_sub_cancel, Nat.sub_zero] using hstep 0 (by omega)
    rw [translatedPathTerm]
    change E edges (a 0) (position 0) (L 0) (L 1) *
      translatedPathTerm step E terminal edges (position 0 + step edges (a 0) (L 0)) (L 1)
        (fun j : Fin edges => (a (j.val + 1), L (j.val + 1 + 1))) = _
    rw [← hfirst, hi, prod_range_succ']
    simp only [Nat.add_sub_cancel, Nat.sub_zero, Nat.sub_sub, Nat.add_comm]
    ac_rfl
end

section

def finitePathLabels {A M : Type*} {r : ℕ} (p : Fin (r + 1) → A × M) (j : ℕ) : A :=
  if h : j < r + 1 then (p ⟨j, h⟩).1 else (p 0).1

def finitePathMarks {A M : Type*} {r : ℕ} (L : M) (p : Fin r → A × M) : ℕ → M
  | 0 => L
  | j + 1 => if h : j < r then (p ⟨j, h⟩).2 else L

theorem finite_path_sequences {A M : Type*} {r : ℕ} (L : M) (p : Fin (r + 1) → A × M) :
    (fun j : Fin (r + 1) => (finitePathLabels p j.val, finitePathMarks L p (j.val + 1))) = p := by
  funext j
  simp only [finitePathLabels, finitePathMarks, dif_pos j.isLt]
end

section
open Finset Classical
theorem physical_free_path_expansion {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (terminal : ℤ → PhysicalMarkLists P J ell → ℂ) (r : ℕ) (n : ℤ) (L : PhysicalMarkLists P J ell) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    (∑ p : Fin r → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
      translatedPathTerm (fun j => physicalBareStep C (k j))
        (fun j => physicalBareKernel V patterns C q (ζ j) (k j) (K j)) terminal r n L p) =
      physicalBareFreeAction V patterns C q ζ k K terminal r n L := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  exact translated_path_expansion _ _ _ r n L

/-- The original finite operator, on the complete reachable cutoff,
equals the unrestricted bare action at every original starting state. -/
theorem physical_reachable_action_eq_free {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (starts : Finset ℤ) (terminal : ℤ → PhysicalMarkLists P J ell → ℂ) (r b : ℕ)
    (hbound : ∀ j < r, physicalOperatorStepBound P J ell patterns C (k j) ≤ b)
    (x : PhysicalState P J ell) (hx : x.1 ∈ starts) :
    finiteCutoffAction (physicalCutoff P J ell (reachablePositions starts (r * b)))
      (fun j a b => physicalSymmetricKernel (fun s t => ∑ i ∈ patterns,
        physicalPatternKernel V (C i) q (ζ j i) (k j i) (K j i) s t) a b)
      (fun a => terminal a.1 a.2.val) r x =
        physicalBareFreeAction V patterns C q ζ k K terminal r x.1 x.2.val := by
  have h := physical_cutoff_action_eq_bare V patterns C hq ζ k K
    (reachablePositions starts (r * b)) terminal r x
  simp only [physical_labeled_coefficient_sum] at h
  rw [h]
  exact physical_bare_action_reachable V patterns C q ζ k K starts terminal r b hbound x.1 x.2.val hx

/-- A bare path term, including an arbitrary terminal function, has
no hidden dependence on the starting integer. -/
theorem physical_free_path_term_factor {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (terminal : ℤ → PhysicalMarkLists P J ell → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (N : ℕ) (n : ℤ) :
    translatedPathTerm (fun j => physicalBareStep C (k j))
      (fun j => physicalBareKernel V patterns C q (ζ j) (k j) (K j)) terminal (N + 1) n (L 0)
      (fun j : Fin (N + 1) => (a j.val, L (j.val + 1))) =
        physicalBareWalkScalar V patterns C ζ K a L (N + 1) *
          ((∏ j ∈ range (N + 2), physicalVertexWeight (L j)
            (physicalEndpointSchedule q (N + 1) j)
            (n + physicalBareOffset C k a L (N + 1) j) : ℝ) : ℂ) *
          terminal (n + physicalBareOffset C k a L (N + 1) (N + 1)) (L (N + 1)) := by
  have hpos : ∀ j < N + 1, n + physicalBareOffset C k a L (N + 1) (j + 1) =
      (n + physicalBareOffset C k a L (N + 1) j) +
        physicalBareStep C (k (N + 1 - 1 - j)) (a j) (L j) := by
    intro j _
    exact (physical_bare_position_step C k a L (N + 1) j n).symm
  have ht := translated_path_term_product (fun j => physicalBareStep C (k j))
    (fun j => physicalBareKernel V patterns C q (ζ j) (k j) (K j)) terminal (N + 1) a L
    (fun j => n + physicalBareOffset C k a L (N + 1) j) hpos
  have hzero : n + physicalBareOffset C k a L (N + 1) 0 = n := by simp only [physicalBareOffset, add_zero]
  rw [hzero] at ht
  simp only [Nat.add_sub_cancel] at ht
  rw [ht, physical_bare_path_factor V patterns C hq ζ k K a L N n]
end

section
open Finset Classical
noncomputable def physicalBareReturnScalar {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (edges : ℕ) : ℂ :=
  if physicalBareOffset C k a L edges edges = 0 then
    physicalBareWalkScalar V patterns C ζ K a L edges else 0

/-- Every return-path term is a root-independent scalar times the
nonnegative divisibility-and-damping vertex factor. -/
theorem physical_return_path_factor {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (N : ℕ) (n : ℤ) :
    translatedPathTerm (fun j => physicalBareStep C (k j))
      (fun j => physicalBareKernel V patterns C q (ζ j) (k j) (K j))
      (fun m _ => if m = n then 1 else 0) (N + 1) n (L 0)
      (fun j : Fin (N + 1) => (a j.val, L (j.val + 1))) =
        physicalBareReturnScalar V patterns C ζ k K a L (N + 1) *
          ((∏ j ∈ range (N + 2), physicalVertexWeight (L j)
            (physicalEndpointSchedule q (N + 1) j)
            (n + physicalBareOffset C k a L (N + 1) j) : ℝ) : ℂ) := by
  rw [physical_free_path_term_factor V patterns C hq ζ k K]
  simp only [physical_bare_return_iff, physicalBareReturnScalar]
  split_ifs <;> simp only [mul_one, mul_zero, zero_mul]

/-- The same factorization applies to every term of the finite bare
path sum, using canonical extensions independent of the initial integer. -/
theorem physical_return_finite_path_factor {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (N : ℕ) (L₀ : PhysicalMarkLists P J ell)
    (p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) (n : ℤ) :
    let a := finitePathLabels p
    let L := finitePathMarks L₀ p
    translatedPathTerm (fun j => physicalBareStep C (k j))
      (fun j => physicalBareKernel V patterns C q (ζ j) (k j) (K j))
      (fun m _ => if m = n then 1 else 0) (N + 1) n L₀ p =
        physicalBareReturnScalar V patterns C ζ k K a L (N + 1) *
          ((∏ j ∈ range (N + 2), physicalVertexWeight (L j)
            (physicalEndpointSchedule q (N + 1) j)
            (n + physicalBareOffset C k a L (N + 1) j) : ℝ) : ℂ) := by
  have h := physical_return_path_factor V patterns C hq ζ k K
    (finitePathLabels p) (finitePathMarks L₀ p) N n
  rw [finite_path_sequences] at h
  exact h
end

section
open Finset Classical
theorem physical_free_action_zero_of_invalid {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (terminal : ℤ → PhysicalMarkLists P J ell → ℂ) (r : ℕ) (n : ℤ)
    (L : PhysicalMarkLists P J ell) (h : ¬ ∀ g s, ((L g s).val : ℤ) ∣ n) :
    physicalBareFreeAction V patterns C q ζ k K terminal (r + 1) n L = 0 := by
  unfold physicalBareFreeAction
  rw [translatedPathAction]
  apply sum_eq_zero
  intro a _
  apply sum_eq_zero
  intro R _
  simp only [physicalBareKernel, physicalVertexWeight, if_neg h,
    zero_mul, Complex.ofReal_zero, mul_zero]

/-- The unnormalized root moment sums all admissible initial lists.
After reindexing, all bare initial lists may be used with zero weights for
the inadmissible ones. -/
theorem physical_initial_return_sum_eq_free {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (starts : Finset ℤ) (r b : ℕ)
    (hbound : ∀ j < r + 1, physicalOperatorStepBound P J ell patterns C (k j) ≤ b)
    (n : ℤ) (hn : n ∈ starts) :
    (∑ L : PhysicalMarksAt P J ell n,
      finiteCutoffAction (physicalCutoff P J ell (reachablePositions starts ((r + 1) * b)))
        (fun j a b => physicalSymmetricKernel (fun s t => ∑ i ∈ patterns,
          physicalPatternKernel V (C i) q (ζ j i) (k j i) (K j i) s t) a b)
        (fun a => if a.1 = n then 1 else 0) (r + 1) ⟨n, L⟩) =
      ∑ L : PhysicalMarkLists P J ell, physicalBareFreeAction V patterns C q ζ k K
        (fun m _ => if m = n then 1 else 0) (r + 1) n L := by
  calc
    _ = ∑ L : PhysicalMarksAt P J ell n, physicalBareFreeAction V patterns C q ζ k K
        (fun m _ => if m = n then 1 else 0) (r + 1) n L.val := by
      apply sum_congr rfl
      intro L _
      exact physical_reachable_action_eq_free V patterns C hq ζ k K starts
        (fun m _ => if m = n then 1 else 0) (r + 1) b hbound ⟨n, L⟩ hn
    _ = _ := by
      apply physical_marks_sum_all P J ell n
      intro L h
      exact physical_free_action_zero_of_invalid V patterns C q ζ k K _ r n L h
end

section
open Finset Classical
noncomputable def physicalFiniteReturnScalar {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (r : ℕ) (L : PhysicalMarkLists P J ell)
    (p : Fin (r + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) : ℂ :=
  physicalBareReturnScalar V patterns C ζ k K (finitePathLabels p) (finitePathMarks L p) (r + 1)

noncomputable def physicalFiniteVertexProduct {G I : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} {patterns : Finset I}
    (C : I → G → Finset (Fin J)) (q : ℝ) (k : ℕ → I → ℤ)
    (r : ℕ) (L : PhysicalMarkLists P J ell)
    (p : Fin (r + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) (n : ℤ) : ℝ :=
  ∏ j ∈ range (r + 2), physicalVertexWeight (finitePathMarks L p j)
    (physicalEndpointSchedule q (r + 1) j)
    (n + physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p) (r + 1) j)

theorem physical_free_return_factor_sum {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (r : ℕ) (n : ℤ) (L : PhysicalMarkLists P J ell) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    physicalBareFreeAction V patterns C q ζ k K
      (fun m _ => if m = n then 1 else 0) (r + 1) n L =
      ∑ p : Fin (r + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
        physicalFiniteReturnScalar V patterns C ζ k K r L p *
          (physicalFiniteVertexProduct C q k r L p n : ℂ) := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  rw [← physical_free_path_expansion]
  apply sum_congr rfl
  intro p _
  exact physical_return_finite_path_factor V patterns C hq ζ k K r L p n
end

section
open Finset Classical
theorem complex_average_finite_sum {A X : Type*} (roots : Finset X) (terms : Finset A)
    (c : A → ℂ) (w : A → X → ℝ) (denominator : ℝ) :
    ((∑ n ∈ roots, ∑ a ∈ terms, c a * (w a n : ℂ)) / (denominator : ℂ)) =
      ∑ a ∈ terms, c a * (((∑ n ∈ roots, w a n) / denominator : ℝ) : ℂ) := by
  rw [sum_comm, sum_div]
  apply sum_congr rfl
  intro a _
  simp only [Complex.ofReal_div, Complex.ofReal_sum]
  rw [← mul_sum, mul_div_assoc]

noncomputable def physicalRootMoment {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (starts : Finset ℤ) (r b : ℕ) : ℂ :=
  (physicalStateMass V J ell : ℂ) *
    (∑ n ∈ starts, ∑ L : PhysicalMarksAt P J ell n,
      finiteCutoffAction (physicalCutoff P J ell (reachablePositions starts ((r + 1) * b)))
        (fun j a b => physicalSymmetricKernel (fun s t => ∑ i ∈ patterns,
          physicalPatternKernel V (C i) q (ζ j i) (k j i) (K j i) s t) a b)
        (fun a => if a.1 = n then 1 else 0) (r + 1) ⟨n, L⟩) / (starts.card : ℂ)

/-- This is an identity for the actual physical root moment, not an
assumption about a proposed path expansion. -/
theorem physical_root_moment_as_vertex_averages {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (starts : Finset ℤ) (r b : ℕ)
    (hbound : ∀ j < r + 1, physicalOperatorStepBound P J ell patterns C (k j) ≤ b) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    physicalRootMoment V patterns C q ζ k K starts r b =
      (physicalStateMass V J ell : ℂ) *
        ∑ L : PhysicalMarkLists P J ell,
          ∑ p : Fin (r + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
            physicalFiniteReturnScalar V patterns C ζ k K r L p *
              (((∑ n ∈ starts, physicalFiniteVertexProduct C q k r L p n) /
                (starts.card : ℝ) : ℝ) : ℂ) := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  unfold physicalRootMoment
  rw [mul_div_assoc]
  congr 1
  have he : (∑ n ∈ starts, ∑ L : PhysicalMarksAt P J ell n,
      finiteCutoffAction (physicalCutoff P J ell (reachablePositions starts ((r + 1) * b)))
        (fun j a b => physicalSymmetricKernel (fun s t => ∑ i ∈ patterns,
          physicalPatternKernel V (C i) q (ζ j i) (k j i) (K j i) s t) a b)
        (fun a => if a.1 = n then 1 else 0) (r + 1) ⟨n, L⟩) =
      ∑ n ∈ starts, ∑ L : PhysicalMarkLists P J ell,
        ∑ p : Fin (r + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
          physicalFiniteReturnScalar V patterns C ζ k K r L p *
            (physicalFiniteVertexProduct C q k r L p n : ℂ) := by
    apply sum_congr rfl
    intro n hn
    rw [physical_initial_return_sum_eq_free V patterns C hq ζ k K starts r b hbound n hn]
    apply sum_congr rfl
    intro L _
    exact physical_free_return_factor_sum V patterns C hq ζ k K r n L
  rw [he, sum_comm, sum_div]
  apply sum_congr rfl
  intro L _
  exact complex_average_finite_sum starts univ (physicalFiniteReturnScalar V patterns C ζ k K r L)
    (physicalFiniteVertexProduct C q k r L) (starts.card : ℝ)
end

section
open Finset Classical
noncomputable def physicalFiniteVertexExpectation {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ} {patterns : Finset I}
    (C : I → G → Finset (Fin J)) (q : ℝ) (k : ℕ → I → ℤ)
    (r : ℕ) (L : PhysicalMarkLists P J ell)
    (p : Fin (r + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) : ℝ :=
  poolPathResidueExpectation (fun v : PhysicalPrime P => v.2.val) univ (range (r + 2))
    (fun v => (range (r + 2)).filter (fun j => v ∈ physicalMarkedPrimes (finitePathMarks L p j)))
    (fun v j => -(physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p)
      (r + 1) j : ZMod v.2.val))
    (fun j => 1 - physicalEndpointSchedule q (r + 1) j)

noncomputable def physicalRootResidueModel {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : G → ℝ) (patterns : Finset I) (C : I → G → Finset (Fin J))
    (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (r : ℕ) : ℂ := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  exact (physicalStateMass V J ell : ℂ) *
    ∑ L : PhysicalMarkLists P J ell,
      ∑ p : Fin (r + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
        physicalFiniteReturnScalar V patterns C ζ k K r L p *
          (physicalFiniteVertexExpectation C q k r L p : ℂ)

theorem complex_double_path_error_bound {A B : Type*} [Fintype A] [Fintype B]
    (c : A → B → ℂ) (actual expected : A → B → ℝ) (ε : ℝ)
    (h : ∀ a b, |actual a b - expected a b| ≤ ε * expected a b) :
    ‖(∑ a, ∑ b, c a b * (actual a b : ℂ)) - ∑ a, ∑ b, c a b * (expected a b : ℂ)‖ ≤
      ε * ∑ a, ∑ b, ‖c a b‖ * expected a b := by
  simpa only [Fintype.sum_prod_type] using complex_path_error_bound (univ : Finset (A × B))
    (fun p => c p.1 p.2) (fun p => actual p.1 p.2) (fun p => expected p.1 p.2) ε
    (fun p _ => h p.1 p.2)

/-- The per-path relative replacement controls the actual root moment,
with the exact expected absolute path mass as its only multiplicative loss. -/
theorem physical_root_replacement_error {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : G → ℝ) (hV : ∀ g, 0 < V g) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (starts : Finset ℤ) (r b : ℕ)
    (hbound : ∀ j < r + 1, physicalOperatorStepBound P J ell patterns C (k j) ≤ b) (ε : ℝ)
    (herror : ∀ (L : PhysicalMarkLists P J ell)
      (p : Fin (r + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell),
      |(∑ n ∈ starts, physicalFiniteVertexProduct C q k r L p n) / (starts.card : ℝ) -
        physicalFiniteVertexExpectation C q k r L p| ≤ ε * physicalFiniteVertexExpectation C q k r L p) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    ‖physicalRootMoment V patterns C q ζ k K starts r b -
      physicalRootResidueModel V patterns C q ζ k K r‖ ≤
      ε * (physicalStateMass V J ell *
        ∑ L : PhysicalMarkLists P J ell,
          ∑ p : Fin (r + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
            ‖physicalFiniteReturnScalar V patterns C ζ k K r L p‖ *
              physicalFiniteVertexExpectation C q k r L p) := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  rw [physical_root_moment_as_vertex_averages V patterns C hq ζ k K starts r b hbound]
  unfold physicalRootResidueModel
  rw [← mul_sub, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (physical_state_mass_pos V hV J ell).le]
  have h := complex_double_path_error_bound (physicalFiniteReturnScalar V patterns C ζ k K r)
    (fun L p => (∑ n ∈ starts, physicalFiniteVertexProduct C q k r L p n) / (starts.card : ℝ))
    (physicalFiniteVertexExpectation C q k r) ε herror
  exact (mul_le_mul_of_nonneg_left h (physical_state_mass_pos V hV J ell).le).trans_eq (by ring)
end

section
open Filter Finset
theorem eventually_physical_finite_vertex_replacement {a c d C V E γ : ℝ}
    (ha : 0 ≤ a) (hc : 0 < c) (hd : 0 < d) (had : a + d < 1)
    (hC : 0 < C) (hV : 0 < V) (hE : 0 ≤ E) (hγ : 0 < γ) (J ell : ℕ) :
    ∀ᶠ T : ℝ in atTop, ∀ (G : Type) [Fintype G] [DecidableEq G]
      (P : G → Finset ℕ) [∀ p : PhysicalPrime P, NeZero p.2.val]
      (I : Type) (patterns : Finset I) (pattern : I → G → Finset (Fin J))
      (k : ℕ → I → ℤ) (r : ℕ), r + 1 = 2 * Nat.ceil (T^a) →
      ∀ (L : PhysicalMarkLists P J ell)
        (p : Fin (r + 1) → PhysicalEdgeLabels P J ell patterns pattern × PhysicalMarkLists P J ell)
        (q : ℝ) (N : ℕ) (z : ℤ),
      Pairwise (fun g h => Disjoint (P g) (P h)) →
      (∀ g p, p ∈ P g → p.Prime) →
      (Fintype.card G : ℝ) ≤ C * Real.log T →
      (∀ g, (∑ p ∈ P g, 1 / (p : ℝ)) ≤ V) →
      (∀ g p, p ∈ P g → Real.exp (T^c) ≤ (p : ℝ)) →
      (∀ g p, p ∈ P g → (p : ℝ) ≤ Real.exp (T^d)) →
      0 ≤ q → q ≤ 1 → 0 < N → γ * T ≤ Real.log (N : ℝ) →
      |(∑ n ∈ Ico z (z + N), physicalFiniteVertexProduct pattern q k r L p n) / (N : ℝ) -
        physicalFiniteVertexExpectation pattern q k r L p| ≤
        Real.exp (-E * (r + 1) * Real.log T) * physicalFiniteVertexExpectation pattern q k r L p := by
  filter_upwards [eventually_physical_vertex_replacement ha hc hd had hC hV hE hγ J ell] with T hT
  intro G _ _ P _ I patterns pattern k r hlen L p q N z hdis hprime hs hH hmin hmax hq0 hq1 hN hNb
  have hh := hT G P (finitePathMarks L p)
    (physicalBareOffset pattern k (finitePathLabels p) (finitePathMarks L p) (r + 1))
    (physicalEndpointSchedule q (r + 1)) N z
  dsimp only at hh
  rw [← hlen] at hh
  simpa only [physicalFiniteVertexProduct, physicalFiniteVertexExpectation, Nat.cast_add, Nat.cast_one] using
    hh hdis hprime hs hH hmin hmax
      (fun j _ => physical_endpoint_schedule_unit hq0 hq1 (r + 1) j) hN hNb
end

section

/-- A nonzero integer whose absolute value is smaller than `p` is not
divisible by `p`. No primality assumption is needed. -/
theorem nat_not_dvd_int_of_natAbs_lt {p : ℕ} {k : ℤ}
    (hkpos : 0 < k.natAbs) (hklt : k.natAbs < p) : ¬ (p : ℤ) ∣ k := by
  intro h
  exact (not_le_of_gt hklt) (Nat.le_of_dvd hkpos (Int.natCast_dvd.mp h))

/-- If a prime divides both endpoints of a dilation step and does not divide
the step coefficient, it divides the natural-number dilation factor. -/
theorem nat_prime_dvd_dilation_of_dvd_endpoints {p D : ℕ} {n k : ℤ}
    (hp : Nat.Prime p) (hk : ¬ (p : ℤ) ∣ k)
    (hn : (p : ℤ) ∣ n) (htarget : (p : ℤ) ∣ n + k * (D : ℤ)) : p ∣ D := by
  have hproduct : (p : ℤ) ∣ k * (D : ℤ) := by
    simpa only [add_sub_cancel_left] using dvd_sub htarget hn
  exact Int.natCast_dvd_natCast.mp
    (((Nat.prime_iff_prime_int.mp hp).dvd_or_dvd hproduct).resolve_left hk)

/-- The same endpoint criterion with the usual short, nonzero step bound. -/
theorem nat_prime_dvd_dilation_of_dvd_endpoints_of_natAbs_lt
    {p D : ℕ} {n k : ℤ} (hp : Nat.Prime p)
    (hkpos : 0 < k.natAbs) (hklt : k.natAbs < p)
    (hn : (p : ℤ) ∣ n) (htarget : (p : ℤ) ∣ n + k * (D : ℤ)) : p ∣ D :=
  nat_prime_dvd_dilation_of_dvd_endpoints hp
    (nat_not_dvd_int_of_natAbs_lt hkpos hklt) hn htarget

/-- A prime marked at both endpoints divides the dilation, provided it does
not divide the step coefficient. The two marks may have different groups
and slots. -/
theorem physical_common_mark_dvd_D_of_prime {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) {x y : PhysicalState P J ell}
    (hadm : physicalAdmissible C aux k x y)
    (g h : G) (s t : PhysicalSlots J ell)
    (heq : (x.2.val g s).val = (y.2.val h t).val)
    (hp : Nat.Prime (x.2.val g s).val)
    (hk : ¬ ((x.2.val g s).val : ℤ) ∣ k) :
    (x.2.val g s).val ∣ physicalD C x.2.val aux := by
  apply nat_prime_dvd_dilation_of_dvd_endpoints hp hk (x.2.property g s)
  rw [← hadm.2.2.2, heq]
  exact y.2.property h t

/-- The common-mark criterion for prime pools. -/
theorem physical_common_mark_dvd_D {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) {x y : PhysicalState P J ell}
    (hadm : physicalAdmissible C aux k x y)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (g h : G) (s t : PhysicalSlots J ell)
    (heq : (x.2.val g s).val = (y.2.val h t).val)
    (hk : ¬ ((x.2.val g s).val : ℤ) ∣ k) :
    (x.2.val g s).val ∣ physicalD C x.2.val aux :=
  physical_common_mark_dvd_D_of_prime C aux k hadm g h s t heq
    (hP g _ (x.2.val g s).property) hk

/-- A common prime mark divides the dilation whenever the step coefficient
is nonzero and smaller in absolute value than that mark. -/
theorem physical_common_mark_dvd_D_of_natAbs_lt {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) {x y : PhysicalState P J ell}
    (hadm : physicalAdmissible C aux k x y)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (g h : G) (s t : PhysicalSlots J ell)
    (heq : (x.2.val g s).val = (y.2.val h t).val)
    (hkpos : 0 < k.natAbs) (hklt : k.natAbs < (x.2.val g s).val) :
    (x.2.val g s).val ∣ physicalD C x.2.val aux :=
  physical_common_mark_dvd_D C aux k hadm hP g h s t heq
    (nat_not_dvd_int_of_natAbs_lt hkpos hklt)
end

section
open Finset
theorem physical_mem_shared_slots_iff {J ell : ℕ} (C : Finset (Fin J))
    (s : PhysicalSlots J ell) :
    s ∈ physicalSharedSlots C ↔ ∃ j : Fin J, j ∉ C ∧ s = Sum.inl j := by
  simp only [physicalSharedSlots, mem_map, mem_sdiff, mem_univ, true_and]
  constructor
  · rintro ⟨j, hj, he⟩
    exact ⟨j, hj, he.symm⟩
  · rintro ⟨j, hj, he⟩
    exact ⟨j, hj, he.symm⟩

/-- Every prime divisor of the dilation is a shared label or a sampled
auxiliary label. The auxiliary labels need not be distinct. -/
theorem physical_prime_dvd_D_iff {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (labels : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p) {p : ℕ} (hp : Nat.Prime p) :
    p ∣ physicalD C labels aux ↔
      (∃ g j, j ∉ C g ∧ p = (labels g (Sum.inl j)).val) ∨
      (∃ (g : G) (j : C g), p = (aux g j).val) := by
  classical
  constructor
  · intro hd
    obtain ⟨g, _, hg⟩ := (hp.prime.dvd_finsetProd_iff _).mp hd
    rcases hp.dvd_mul.mp hg with hs | ha
    · obtain ⟨j, hj, hjp⟩ := (hp.prime.dvd_finsetProd_iff _).mp hs
      exact Or.inl ⟨g, j, (mem_sdiff.mp hj).2,
        ((Nat.dvd_prime (hP g _ (labels g (Sum.inl j)).property)).mp hjp).resolve_left
          hp.ne_one⟩
    · obtain ⟨j, _, hjp⟩ := (hp.prime.dvd_finsetProd_iff _).mp ha
      exact Or.inr ⟨g, j,
        ((Nat.dvd_prime (hP g _ (aux g j).property)).mp hjp).resolve_left hp.ne_one⟩
  · rintro (⟨g, j, hj, rfl⟩ | ⟨g, j, rfl⟩)
    · exact physical_shared_label_dvd_D C labels aux g j hj
    · apply dvd_trans _ (dvd_prod_of_mem (fun g => physicalGroupD C labels aux g) (mem_univ g))
      exact dvd_mul_of_dvd_right
        (dvd_prod_of_mem (fun j : C g => (aux g j).val) (mem_univ j)) _

/-- Equality of values of endpoint labels in disjoint groups determines
the group, even when the two mark lists differ. -/
theorem physical_mark_value_eq_group {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (src tgt : PhysicalMarkLists P J ell)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    {g h : G} {s t : PhysicalSlots J ell}
    (he : (src g s).val = (tgt h t).val) : g = h := by
  by_contra hne
  apply disjoint_left.mp (hdis hne) (src g s).property
  rw [he]
  exact (tgt h t).property

/-- For an endpoint satisfying the auxiliary ban, the marked primes
dividing the dilation are precisely its prescribed shared slots. -/
theorem physical_mark_dvd_D_iff_shared {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (labels : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (havoid : physicalAuxAvoids C aux labels) (g : G) (s : PhysicalSlots J ell) :
    (labels g s).val ∣ physicalD C labels aux ↔ s ∈ physicalSharedSlots (C g) := by
  classical
  rw [physical_mem_shared_slots_iff]
  constructor
  · intro hd
    rcases (physical_prime_dvd_D_iff C labels aux hP
      (hP g _ (labels g s).property)).mp hd with ⟨h, j, hj, he⟩ | ⟨h, j, he⟩
    · have hgh : g = h := physical_mark_value_eq_group labels labels hdis he
      subst h
      exact ⟨j, hj, (labels g).injective (Subtype.ext he)⟩
    · exact False.elim (((physical_aux_avoids_global_iff C aux labels hdis).mp havoid)
        h j g s he.symm)
  · rintro ⟨j, hj, rfl⟩
    exact physical_shared_label_dvd_D C labels aux g j hj

/-- The same classification at the target, with the dilation still
computed from the source endpoint. -/
theorem physical_target_mark_dvd_D_iff_shared {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    {src tgt : PhysicalMarkLists P J ell} (aux : PhysicalAuxLabels P C)
    (hshared : physicalSharedCompatible C src tgt)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (havoid : physicalAuxAvoids C aux tgt) (g : G) (s : PhysicalSlots J ell) :
    (tgt g s).val ∣ physicalD C src aux ↔ s ∈ physicalSharedSlots (C g) := by
  rw [physical_D_eq_of_shared C hshared aux]
  exact physical_mark_dvd_D_iff_shared C tgt aux hP hdis havoid g s

/-- A prime marked at both endpoints must occupy the same prescribed
shared slot, provided the prime does not divide the step coefficient. -/
theorem physical_common_mark_shared {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) {x y : PhysicalState P J ell}
    (hadm : physicalAdmissible C aux k x y)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (g h : G) (s t : PhysicalSlots J ell)
    (he : (x.2.val g s).val = (y.2.val h t).val)
    (hk : ¬ ((x.2.val g s).val : ℤ) ∣ k) :
    g = h ∧ s = t ∧ s ∈ physicalSharedSlots (C g) := by
  have hd := physical_common_mark_dvd_D C aux k hadm hP g h s t he hk
  have hs := (physical_mark_dvd_D_iff_shared C x.2.val aux hP hdis hadm.2.1 g s).mp hd
  have hgh : g = h := physical_mark_value_eq_group x.2.val y.2.val hdis he
  subst h
  obtain ⟨j, hj, rfl⟩ := (physical_mem_shared_slots_iff (C g) s).mp hs
  have hcopy := hadm.1 g j hj
  have hst : Sum.inl j = t := (y.2.val g).injective (by rw [← hcopy]; exact Subtype.ext he)
  exact ⟨rfl, hst, hs⟩

/-- An unshared source mark cannot divide the dilation. -/
theorem physical_unshared_mark_not_dvd_D {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (labels : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (havoid : physicalAuxAvoids C aux labels) (g : G) (s : PhysicalSlots J ell)
    (hs : s ∈ physicalUnsharedSlots (C g)) :
    ¬ (labels g s).val ∣ physicalD C labels aux := by
  intro hd
  exact (mem_compl.mp hs)
    ((physical_mark_dvd_D_iff_shared C labels aux hP hdis havoid g s).mp hd)

/-- A source mark divides the target position precisely when its slot is
shared, provided its prime does not divide the step coefficient. -/
theorem physical_source_mark_dvd_target_iff_shared {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) {x y : PhysicalState P J ell}
    (hadm : physicalAdmissible C aux k x y)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (g : G) (s : PhysicalSlots J ell)
    (hk : ¬ ((x.2.val g s).val : ℤ) ∣ k) :
    ((x.2.val g s).val : ℤ) ∣ y.1 ↔ s ∈ physicalSharedSlots (C g) := by
  constructor
  · intro hy
    have hd := nat_prime_dvd_dilation_of_dvd_endpoints
      (hP g _ (x.2.val g s).property) hk (x.2.property g s)
      (hadm.2.2.2 ▸ hy)
    exact (physical_mark_dvd_D_iff_shared C x.2.val aux hP hdis hadm.2.1 g s).mp hd
  · intro hs
    obtain ⟨j, hj, rfl⟩ := (physical_mem_shared_slots_iff (C g) s).mp hs
    rw [hadm.2.2.2]
    exact physical_shared_divides_target C x aux k g j hj

/-- At a birth of an unshared target mark, its prime does not divide the
previous position. This is the reverse endpoint version of the source test. -/
theorem physical_target_mark_dvd_source_iff_shared {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) {x y : PhysicalState P J ell}
    (hadm : physicalAdmissible C aux k x y)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (g : G) (s : PhysicalSlots J ell)
    (hk : ¬ ((y.2.val g s).val : ℤ) ∣ k) :
    ((y.2.val g s).val : ℤ) ∣ x.1 ↔ s ∈ physicalSharedSlots (C g) := by
  apply physical_source_mark_dvd_target_iff_shared C aux (-k)
    (physical_admissible_reverse C aux k hadm) hP hdis g s
  simpa only [dvd_neg] using hk

/-- A common endpoint prime under the standard short-step hypothesis
occupies one and the same prescribed shared slot. -/
theorem physical_common_mark_shared_of_natAbs_lt {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) {x y : PhysicalState P J ell}
    (hadm : physicalAdmissible C aux k x y)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (g h : G) (s t : PhysicalSlots J ell)
    (he : (x.2.val g s).val = (y.2.val h t).val)
    (hkpos : 0 < k.natAbs) (hklt : k.natAbs < (x.2.val g s).val) :
    g = h ∧ s = t ∧ s ∈ physicalSharedSlots (C g) :=
  physical_common_mark_shared C aux k hadm hP hdis g h s t he
    (nat_not_dvd_int_of_natAbs_lt hkpos hklt)
end

section
open Finset
open scoped Classical
/-- The tagged primes occupying the prescribed shared slots. -/
def physicalSharedPrimes {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (labels : PhysicalMarkLists P J ell) : Finset (PhysicalPrime P) :=
  (univ.filter (fun a : Σ _g : G, PhysicalSlots J ell =>
    a.2 ∈ physicalSharedSlots (C a.1))).map (physicalMarkInjection labels)

/-- Membership in the tagged shared set is witnessed by a shared slot in
the tag's own group. -/
theorem mem_physical_shared_primes {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (labels : PhysicalMarkLists P J ell) (p : PhysicalPrime P) :
    p ∈ physicalSharedPrimes C labels ↔
      ∃ s, s ∈ physicalSharedSlots (C p.1) ∧ (labels p.1 s).val = p.2.val := by
  rcases p with ⟨g, p⟩
  constructor
  · intro hp
    obtain ⟨⟨h, s⟩, hs, he⟩ := mem_map.mp hp
    change (⟨h, labels h s⟩ : PhysicalPrime P) = ⟨g, p⟩ at he
    have hg : h = g := congrArg Sigma.fst he
    cases hg
    exact ⟨s, (mem_filter.mp hs).2,
      congrArg Subtype.val (eq_of_heq (Sigma.mk.inj_iff.mp he).2)⟩
  · rintro ⟨s, hs, he⟩
    apply mem_map.mpr
    refine ⟨⟨g, s⟩, mem_filter.mpr ⟨mem_univ _, hs⟩, ?_⟩
    change (⟨g, labels g s⟩ : PhysicalPrime P) = ⟨g, p⟩
    exact congrArg (Sigma.mk g) (Subtype.ext he)

/-- Every tagged shared prime is marked. -/
theorem physical_shared_primes_subset_marked {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (labels : PhysicalMarkLists P J ell) :
    physicalSharedPrimes C labels ⊆ physicalMarkedPrimes labels := by
  intro p hp
  obtain ⟨s, _, he⟩ := (mem_physical_shared_primes C labels p).mp hp
  rw [mem_physical_marked_primes, mem_physical_group_marks]
  exact ⟨s, he⟩

/-- Compatible endpoint lists have the same tagged shared primes. -/
theorem physical_shared_primes_eq_of_compatible {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    {src tgt : PhysicalMarkLists P J ell}
    (hshared : physicalSharedCompatible C src tgt) :
    physicalSharedPrimes C src = physicalSharedPrimes C tgt := by
  have forward : ∀ (a b : PhysicalMarkLists P J ell),
      physicalSharedCompatible C a b →
      physicalSharedPrimes C a ⊆ physicalSharedPrimes C b := by
    intro a b hab p hp
    obtain ⟨s, hs, he⟩ := (mem_physical_shared_primes C a p).mp hp
    obtain ⟨j, hj, rfl⟩ := (physical_mem_shared_slots_iff (C p.1) s).mp hs
    apply (mem_physical_shared_primes C b p).mpr
    exact ⟨Sum.inl j, hs, (congrArg Subtype.val (hab p.1 j hj)).symm.trans he⟩
  exact Subset.antisymm (forward src tgt hshared)
    (forward tgt src (physical_shared_compatible_symm C hshared))

/-- A tagged prime is marked at both endpoints exactly when it comes from
a shared source slot. Only source-mark nondivisibility is needed. -/
theorem physical_mem_both_iff_shared {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) {x y : PhysicalState P J ell}
    (hadm : physicalAdmissible C aux k x y)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hk : ∀ g s, ¬ ((x.2.val g s).val : ℤ) ∣ k) (p : PhysicalPrime P) :
    (p ∈ physicalMarkedPrimes x.2.val ∧ p ∈ physicalMarkedPrimes y.2.val) ↔
      ∃ s, s ∈ physicalSharedSlots (C p.1) ∧ (x.2.val p.1 s).val = p.2.val := by
  constructor
  · rintro ⟨hx, hy⟩
    obtain ⟨s, hs⟩ := (mem_physical_group_marks x.2.val p.1 p.2.val).mp
      ((mem_physical_marked_primes x.2.val p).mp hx)
    obtain ⟨t, ht⟩ := (mem_physical_group_marks y.2.val p.1 p.2.val).mp
      ((mem_physical_marked_primes y.2.val p).mp hy)
    have hcommon := physical_common_mark_shared C aux k hadm hP hdis
      p.1 p.1 s t (hs.trans ht.symm) (hk p.1 s)
    exact ⟨s, hcommon.2.2, hs⟩
  · rintro ⟨s, hs, he⟩
    obtain ⟨j, hj, rfl⟩ := (physical_mem_shared_slots_iff (C p.1) s).mp hs
    constructor
    · rw [mem_physical_marked_primes, mem_physical_group_marks]
      exact ⟨Sum.inl j, he⟩
    · rw [mem_physical_marked_primes, mem_physical_group_marks]
      exact ⟨Sum.inl j, (congrArg Subtype.val (hadm.1 p.1 j hj)).symm.trans he⟩

/-- The exact common marked set of a physical edge. -/
theorem physical_marked_inter_eq_shared {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) {x y : PhysicalState P J ell}
    (hadm : physicalAdmissible C aux k x y)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hk : ∀ g s, ¬ ((x.2.val g s).val : ℤ) ∣ k) :
    physicalMarkedPrimes x.2.val ∩ physicalMarkedPrimes y.2.val =
      physicalSharedPrimes C x.2.val := by
  ext p
  rw [mem_inter, mem_physical_shared_primes]
  exact physical_mem_both_iff_shared C aux k hadm hP hdis hk p

/-- The common-set identity under the usual short, nonzero step bound. -/
theorem physical_marked_inter_eq_shared_of_natAbs_lt {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) {x y : PhysicalState P J ell}
    (hadm : physicalAdmissible C aux k x y)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hkpos : 0 < k.natAbs) (hklt : ∀ g s, k.natAbs < (x.2.val g s).val) :
    physicalMarkedPrimes x.2.val ∩ physicalMarkedPrimes y.2.val =
      physicalSharedPrimes C x.2.val :=
  physical_marked_inter_eq_shared C aux k hadm hP hdis
    (fun g s => nat_not_dvd_int_of_natAbs_lt hkpos (hklt g s))
end

section
open Finset
/-- The natural prime values in the shared slots of one group. -/
def physicalGroupSharedPrimes {G : Type*}
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (labels : PhysicalMarkLists P J ell) (g : G) : Finset ℕ :=
  (physicalSharedSlots (C g)).map (physicalGroupMarkEmbedding labels g)

theorem mem_physical_group_shared_primes {G : Type*}
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (labels : PhysicalMarkLists P J ell) (g : G) (p : ℕ) :
    p ∈ physicalGroupSharedPrimes C labels g ↔
      ∃ s, s ∈ physicalSharedSlots (C g) ∧ (labels g s).val = p := by
  simp only [physicalGroupSharedPrimes, mem_map]
  rfl

/-- Injectivity of each group's mark list preserves the shared-slot count. -/
theorem physical_group_shared_primes_card {G : Type*}
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (labels : PhysicalMarkLists P J ell) (g : G) :
    (physicalGroupSharedPrimes C labels g).card = J - (C g).card := by
  simp only [physicalGroupSharedPrimes, card_map, physical_shared_slots_card]

/-- The groupwise primes common to both endpoints are exactly the shared
source primes. Nondivisibility is needed only for this source group. -/
theorem physical_group_marks_inter_eq_shared {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) {x y : PhysicalState P J ell}
    (hadm : physicalAdmissible C aux k x y)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (g : G)
    (hk : ∀ s, ¬ ((x.2.val g s).val : ℤ) ∣ k) :
    physicalGroupMarks x.2.val g ∩ physicalGroupMarks y.2.val g =
      physicalGroupSharedPrimes C x.2.val g := by
  ext p
  rw [mem_inter, mem_physical_group_marks, mem_physical_group_marks,
    mem_physical_group_shared_primes]
  constructor
  · rintro ⟨⟨s, hs⟩, ⟨t, ht⟩⟩
    have hcommon := physical_common_mark_shared C aux k hadm hP hdis
      g g s t (hs.trans ht.symm) (hk s)
    exact ⟨s, hcommon.2.2, hs⟩
  · rintro ⟨s, hs, he⟩
    obtain ⟨j, hj, rfl⟩ := (physical_mem_shared_slots_iff (C g) s).mp hs
    exact ⟨⟨Sum.inl j, he⟩,
      ⟨Sum.inl j, (congrArg Subtype.val (hadm.1 g j hj)).symm.trans he⟩⟩

/-- Exactly the unshared-slot count of new primes appears at the target. -/
theorem physical_group_new_marks_card {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) {x y : PhysicalState P J ell}
    (hadm : physicalAdmissible C aux k x y)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (g : G)
    (hk : ∀ s, ¬ ((x.2.val g s).val : ℤ) ∣ k) :
    (physicalGroupMarks y.2.val g \ physicalGroupMarks x.2.val g).card =
      ell + (C g).card := by
  rw [card_sdiff, physical_group_marks_inter_eq_shared C aux k hadm hP hdis g hk,
    physical_group_marks_card, physical_group_shared_primes_card]
  have hc : (C g).card ≤ J := by
    simpa only [Fintype.card_fin] using card_le_univ (C g)
  omega

/-- The same number of primes disappears from the source. -/
theorem physical_group_departing_marks_card {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) {x y : PhysicalState P J ell}
    (hadm : physicalAdmissible C aux k x y)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (g : G)
    (hk : ∀ s, ¬ ((x.2.val g s).val : ℤ) ∣ k) :
    (physicalGroupMarks x.2.val g \ physicalGroupMarks y.2.val g).card =
      ell + (C g).card := by
  have he : (physicalGroupMarks x.2.val g \ physicalGroupMarks y.2.val g).card =
      (physicalGroupMarks y.2.val g \ physicalGroupMarks x.2.val g).card := by
    apply card_sdiff_eq_card_sdiff_iff.mpr
    simp only [physical_group_marks_card]
  rw [he]
  exact physical_group_new_marks_card C aux k hadm hP hdis g hk

/-- The new-prime count under the usual short, nonzero step bound. -/
theorem physical_group_new_marks_card_of_natAbs_lt {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) {x y : PhysicalState P J ell}
    (hadm : physicalAdmissible C aux k x y)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (g : G)
    (hkpos : 0 < k.natAbs) (hklt : ∀ s, k.natAbs < (x.2.val g s).val) :
    (physicalGroupMarks y.2.val g \ physicalGroupMarks x.2.val g).card =
      ell + (C g).card :=
  physical_group_new_marks_card C aux k hadm hP hdis g
    (fun s => nat_not_dvd_int_of_natAbs_lt hkpos (hklt s))

/-- Permuting slots leaves the set of marked prime values unchanged. -/
theorem physical_group_marks_permute {G : Type*}
    {P : G → Finset ℕ} {J ell : ℕ}
    (σ : PhysicalPermutations G J ell) (labels : PhysicalMarkLists P J ell) (g : G) :
    physicalGroupMarks (physicalPermuteLabels σ labels) g = physicalGroupMarks labels g := by
  ext p
  rw [mem_physical_group_marks, mem_physical_group_marks]
  constructor
  · rintro ⟨s, hs⟩
    exact ⟨σ g s, hs⟩
  · rintro ⟨s, hs⟩
    refine ⟨(σ g).symm s, ?_⟩
    simpa only [physicalPermuteLabels, Function.Embedding.trans_apply,
      Equiv.toEmbedding_apply, Equiv.apply_symm_apply] using hs
end

section
open Finset
/-- A common prime of two structurally compatible lists occupies the same
shared slot when it divides the step but does not divide its coefficient. -/
theorem physical_bare_common_mark_shared {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) (L R : PhysicalMarkLists P J ell)
    (hlist : physicalListAdmissible C aux L R)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (g : G) (s t : PhysicalSlots J ell)
    (he : (L g s).val = (R g t).val)
    (hstep : ((L g s).val : ℤ) ∣ k * (physicalD C L aux : ℤ))
    (hk : ¬ ((L g s).val : ℤ) ∣ k) :
    s = t ∧ s ∈ physicalSharedSlots (C g) := by
  have hp := hP g _ (L g s).property
  have hd : (L g s).val ∣ physicalD C L aux :=
    Int.natCast_dvd_natCast.mp
      (((Nat.prime_iff_prime_int.mp hp).dvd_or_dvd hstep).resolve_left hk)
  have hs := (physical_mark_dvd_D_iff_shared C L aux hP hdis hlist.2.1 g s).mp hd
  obtain ⟨j, hj, rfl⟩ := (physical_mem_shared_slots_iff (C g) s).mp hs
  have hcopy := hlist.1 g j hj
  have hst : Sum.inl j = t := (R g).injective (by
    rw [← hcopy]
    exact Subtype.ext he)
  exact ⟨hst, hs⟩

/-- The common prime values of a bare edge are exactly its shared source
values, assuming divisibility compatibility for each common mark. -/
theorem physical_bare_group_marks_inter_eq_shared {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) (L R : PhysicalMarkLists P J ell)
    (hlist : physicalListAdmissible C aux L R)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hcompat : ∀ g s t, (L g s).val = (R g t).val →
      ((L g s).val : ℤ) ∣ k * (physicalD C L aux : ℤ))
    (g : G) (hk : ∀ s, ¬ ((L g s).val : ℤ) ∣ k) :
    physicalGroupMarks L g ∩ physicalGroupMarks R g = physicalGroupSharedPrimes C L g := by
  ext p
  rw [mem_inter, mem_physical_group_marks, mem_physical_group_marks,
    mem_physical_group_shared_primes]
  constructor
  · rintro ⟨⟨s, hs⟩, ⟨t, ht⟩⟩
    have he := hs.trans ht.symm
    exact ⟨s, (physical_bare_common_mark_shared C aux k L R hlist hP hdis
      g s t he (hcompat g s t he) (hk s)).2, hs⟩
  · rintro ⟨s, hs, he⟩
    obtain ⟨j, hj, rfl⟩ := (physical_mem_shared_slots_iff (C g) s).mp hs
    exact ⟨⟨Sum.inl j, he⟩,
      ⟨Sum.inl j, (congrArg Subtype.val (hlist.1 g j hj)).symm.trans he⟩⟩

/-- The new-prime count of a compatible bare edge. -/
theorem physical_bare_group_new_marks_card {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) (L R : PhysicalMarkLists P J ell)
    (hlist : physicalListAdmissible C aux L R)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hcompat : ∀ g s t, (L g s).val = (R g t).val →
      ((L g s).val : ℤ) ∣ k * (physicalD C L aux : ℤ))
    (g : G) (hk : ∀ s, ¬ ((L g s).val : ℤ) ∣ k) :
    (physicalGroupMarks R g \ physicalGroupMarks L g).card = ell + (C g).card := by
  rw [card_sdiff,
    physical_bare_group_marks_inter_eq_shared C aux k L R hlist hP hdis hcompat g hk,
    physical_group_marks_card, physical_group_shared_primes_card]
  have hc : (C g).card ≤ J := by
    simpa only [Fintype.card_fin] using card_le_univ (C g)
  omega

/-- The bare-list count under a nonzero short-step bound. -/
theorem physical_bare_group_new_marks_card_of_natAbs_lt {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) (L R : PhysicalMarkLists P J ell)
    (hlist : physicalListAdmissible C aux L R)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hcompat : ∀ g s t, (L g s).val = (R g t).val →
      ((L g s).val : ℤ) ∣ k * (physicalD C L aux : ℤ))
    (g : G) (hkpos : 0 < k.natAbs) (hklt : ∀ s, k.natAbs < (L g s).val) :
    (physicalGroupMarks R g \ physicalGroupMarks L g).card = ell + (C g).card :=
  physical_bare_group_new_marks_card C aux k L R hlist hP hdis hcompat g
    (fun s => nat_not_dvd_int_of_natAbs_lt hkpos (hklt s))

/-- If the same tagged residue satisfies the marked constraints at two
offsets, the common prime divides the difference of the offsets. -/
theorem physical_common_mark_step_dvd_of_residues {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (L R : PhysicalMarkLists P J ell)
    (ρ : ∀ p : PhysicalPrime P, ZMod p.2.val) (a step : ℤ)
    (hL : ∀ p ∈ physicalMarkedPrimes L, ρ p = -(a : ZMod p.2.val))
    (hR : ∀ p ∈ physicalMarkedPrimes R, ρ p = -((a + step : ℤ) : ZMod p.2.val))
    (g : G) (s t : PhysicalSlots J ell) (he : (L g s).val = (R g t).val) :
    ((L g s).val : ℤ) ∣ step := by
  let p : PhysicalPrime P := ⟨g, L g s⟩
  have hpL : p ∈ physicalMarkedPrimes L := by
    rw [mem_physical_marked_primes, mem_physical_group_marks]
    exact ⟨s, rfl⟩
  have hpR : p ∈ physicalMarkedPrimes R := by
    rw [mem_physical_marked_primes, mem_physical_group_marks]
    exact ⟨t, he.symm⟩
  have hcast : (a : ZMod p.2.val) = ((a + step : ℤ) : ZMod p.2.val) :=
    neg_injective ((hL p hpL).symm.trans (hR p hpR))
  have hd := (ZMod.intCast_eq_intCast_iff_dvd_sub a (a + step) p.2.val).mp hcast
  simpa only [add_sub_cancel_left] using hd

/-- Mark constraints in an independent residue tuple supply exactly the
bare-edge compatibility hypothesis used in the new-prime count. -/
theorem physical_bare_step_compatibility_of_residues {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) (L R : PhysicalMarkLists P J ell)
    (ρ : ∀ p : PhysicalPrime P, ZMod p.2.val) (a : ℤ)
    (hL : ∀ p ∈ physicalMarkedPrimes L, ρ p = -(a : ZMod p.2.val))
    (hR : ∀ p ∈ physicalMarkedPrimes R,
      ρ p = -((a + k * (physicalD C L aux : ℤ) : ℤ) : ZMod p.2.val)) :
    ∀ g s t, (L g s).val = (R g t).val →
      ((L g s).val : ℤ) ∣ k * (physicalD C L aux : ℤ) :=
  physical_common_mark_step_dvd_of_residues L R ρ a
    (k * (physicalD C L aux : ℤ)) hL hR
end

section
open Finset
/-- Number of active runs of a label during `edges + 1` visits. -/
def activeRunCount {α : Type*} [DecidableEq α]
    (A : ℕ → Finset α) (edges : ℕ) (p : α) : ℕ :=
  (if p ∈ A 0 then 1 else 0) +
    ∑ j ∈ range edges, if p ∈ A (j + 1) \ A j then 1 else 0

/-- Summing the membership indicator over an ambient pool gives the subset's
cardinality. -/
theorem sum_mem_indicator_of_subset {α : Type*} [DecidableEq α]
    (pool s : Finset α) (hs : s ⊆ pool) :
    (∑ p ∈ pool, if p ∈ s then (1 : ℕ) else 0) = s.card := by
  rw [← sum_filter]
  have he : pool.filter (fun p => p ∈ s) = s := by
    ext p
    simp only [mem_filter]
    exact ⟨fun h => h.2, fun h => ⟨hs h, h⟩⟩
  simp only [he, sum_const, smul_eq_mul, mul_one]

/-- Total run count equals initial cardinality plus all subsequent entries. -/
theorem sum_activeRunCount {α : Type*} [DecidableEq α]
    (pool : Finset α) (A : ℕ → Finset α) (edges : ℕ)
    (hA : ∀ j ≤ edges, A j ⊆ pool) :
    (∑ p ∈ pool, activeRunCount A edges p) =
      (A 0).card + ∑ j ∈ range edges, (A (j + 1) \ A j).card := by
  simp only [activeRunCount, sum_add_distrib]
  rw [sum_mem_indicator_of_subset pool (A 0) (hA 0 (Nat.zero_le edges)), sum_comm]
  congr 1
  apply sum_congr rfl
  intro j hj
  apply sum_mem_indicator_of_subset
  exact subset_trans sdiff_subset (hA (j + 1) (by simpa using mem_range.mp hj))

/-- A fixed multiplicative cost charged once per active run is the initial
cost followed by one cost for each new entry. -/
theorem prod_pow_activeRunCount {α M : Type*} [DecidableEq α] [CommMonoid M]
    (pool : Finset α) (A : ℕ → Finset α) (edges : ℕ)
    (hA : ∀ j ≤ edges, A j ⊆ pool) (b : M) :
    (∏ p ∈ pool, b ^ activeRunCount A edges p) =
      b ^ (A 0).card * ∏ j ∈ range edges, b ^ (A (j + 1) \ A j).card := by
  rw [prod_pow_eq_pow_sum, sum_activeRunCount pool A edges hA, pow_add,
    prod_pow_eq_pow_sum]
end

section
open Finset
/-- The state and completion measures collect into one inverse harmonic
mass per initial mark and per newly introduced mark. -/
theorem physical_path_mass_grouped {G : Type*} [Fintype G] {J : ℕ}
    (V : G → ℝ) (C : ℕ → G → Finset (Fin J)) (ell edges : ℕ) :
    physicalStateMass V J ell *
      (∏ j ∈ range edges, physicalCompletionMass V (C j) ell) =
    ∏ g, (1 / V g) ^ ((J + ell) + ∑ j ∈ range edges, (ell + (C j g).card)) := by
  unfold physicalStateMass physicalCompletionMass
  simp only [one_div, ← inv_pow]
  rw [prod_comm (s := range edges) (t := univ), ← prod_mul_distrib]
  apply prod_congr rfl
  intro g hg
  rw [prod_pow_eq_pow_sum, ← pow_add]

/-- Independent endpoint permutations do not affect the count of newly
introduced primes on a supported edge. -/
theorem physical_permuted_group_new_marks_card {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) {x y : PhysicalState P J ell}
    (σ τ : PhysicalPermutations G J ell)
    (hadm : physicalAdmissible C aux k
      (physicalPermutationEquiv σ x) (physicalPermutationEquiv τ y))
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (g : G)
    (hk : ∀ s, ¬ ((x.2.val g s).val : ℤ) ∣ k) :
    (physicalGroupMarks y.2.val g \ physicalGroupMarks x.2.val g).card =
      ell + (C g).card := by
  have h := physical_group_new_marks_card C aux k hadm hP hdis g
    (fun s => hk (σ g s))
  simpa only [physical_permutation_marks, physical_group_marks_permute] using h

/-- Sum of the run counts in a group, using the exact number of new marks
on every edge. -/
theorem physical_group_run_count {G : Type*}
    {P : G → Finset ℕ} {J ell : ℕ}
    (L : ℕ → PhysicalMarkLists P J ell) (C : ℕ → G → Finset (Fin J))
    (edges : ℕ) (g : G)
    (hnew : ∀ j < edges,
      (physicalGroupMarks (L (j + 1)) g \ physicalGroupMarks (L j) g).card =
        ell + (C j g).card) :
    (∑ p ∈ P g, activeRunCount (fun j => physicalGroupMarks (L j) g) edges p) =
      (J + ell) + ∑ j ∈ range edges, (ell + (C j g).card) := by
  rw [sum_activeRunCount (P g) _ edges
    (fun j _ => physical_group_marks_subset (L j) g), physical_group_marks_card]
  congr 1
  apply sum_congr rfl
  intro j hj
  exact hnew j (mem_range.mp hj)

/-- The initial state measure and all completion measures charge exactly
one inverse group mass for each active run of each prime. -/
theorem physical_path_run_normalization_of_counts {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (L : ℕ → PhysicalMarkLists P J ell)
    (C : ℕ → G → Finset (Fin J)) (edges : ℕ)
    (hnew : ∀ j < edges, ∀ g,
      (physicalGroupMarks (L (j + 1)) g \ physicalGroupMarks (L j) g).card =
        ell + (C j g).card) :
    physicalStateMass V J ell *
      (∏ j ∈ range edges, physicalCompletionMass V (C j) ell) =
      ∏ g, ∏ p ∈ P g,
        (1 / V g) ^ activeRunCount (fun j => physicalGroupMarks (L j) g) edges p := by
  rw [physical_path_mass_grouped]
  apply prod_congr rfl
  intro g hg
  rw [prod_pow_eq_pow_sum, physical_group_run_count L C edges g (fun j hj => hnew j hj g)]

/-- Exact active-run normalization for a physical path whose edge support
is tested after independent source and target slot permutations. -/
theorem physical_path_run_normalization {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (x : ℕ → PhysicalState P J ell)
    (C : ℕ → G → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
    (k : ℕ → ℤ) (σ τ : ℕ → PhysicalPermutations G J ell) (edges : ℕ)
    (hadm : ∀ j < edges, physicalAdmissible (C j) (aux j) (k j)
      (physicalPermutationEquiv (σ j) (x j)) (physicalPermutationEquiv (τ j) (x (j + 1))))
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hk : ∀ j < edges, ∀ g s, ¬ (((x j).2.val g s).val : ℤ) ∣ k j) :
    physicalStateMass V J ell *
      (∏ j ∈ range edges, physicalCompletionMass V (C j) ell) =
      ∏ g, ∏ p ∈ P g,
        (1 / V g) ^ activeRunCount (fun j => physicalGroupMarks (x j).2.val g) edges p := by
  apply physical_path_run_normalization_of_counts V (fun j => (x j).2.val) C edges
  intro j hj g
  exact physical_permuted_group_new_marks_card (C j) (aux j) (k j) (σ j) (τ j)
    (hadm j hj) hP hdis g (hk j hj g)

/-- The corresponding normalization for bare paths needs only structural
support and divisibility of each common-prime step. It does not require an
integer realization of the independent residues. -/
theorem physical_bare_path_run_normalization {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (L : ℕ → PhysicalMarkLists P J ell)
    (C : ℕ → G → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
    (k : ℕ → ℤ) (σ τ : ℕ → PhysicalPermutations G J ell) (edges : ℕ)
    (hlist : ∀ j < edges, physicalListAdmissible (C j) (aux j)
      (physicalPermuteLabels (σ j) (L j)) (physicalPermuteLabels (τ j) (L (j + 1))))
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hcompat : ∀ j < edges, ∀ g s t,
      ((physicalPermuteLabels (σ j) (L j)) g s).val =
        ((physicalPermuteLabels (τ j) (L (j + 1))) g t).val →
      (((physicalPermuteLabels (σ j) (L j)) g s).val : ℤ) ∣
        k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j)) (aux j) : ℤ))
    (hk : ∀ j < edges, ∀ g s, ¬ (((L j) g s).val : ℤ) ∣ k j) :
    physicalStateMass V J ell *
      (∏ j ∈ range edges, physicalCompletionMass V (C j) ell) =
      ∏ g, ∏ p ∈ P g,
        (1 / V g) ^ activeRunCount (fun j => physicalGroupMarks (L j) g) edges p := by
  apply physical_path_run_normalization_of_counts V L C edges
  intro j hj g
  have h := physical_bare_group_new_marks_card (C j) (aux j) (k j)
    (physicalPermuteLabels (σ j) (L j)) (physicalPermuteLabels (τ j) (L (j + 1)))
    (hlist j hj) hP hdis (hcompat j hj) g (fun s => hk j hj g (σ j g s))
  simpa only [physical_group_marks_permute] using h
end

section
open scoped BigOperators
open MeasureTheory
/-- Fourier phase attached to an integer displacement. -/
noncomputable def physicalReturnPhase (θ : ℝ) (h : ℤ) : ℂ :=
  Complex.exp (2 * (Real.pi : ℂ) * Complex.I * (θ : ℂ) * (h : ℂ))

theorem physicalReturnPhase_zero (θ : ℝ) :
    physicalReturnPhase θ 0 = 1 := by
  simp [physicalReturnPhase]

theorem physicalReturnPhase_add (θ : ℝ) (h k : ℤ) :
    physicalReturnPhase θ (h + k) = physicalReturnPhase θ h * physicalReturnPhase θ k := by
  simp only [physicalReturnPhase, Int.cast_add, mul_add, Complex.exp_add]

theorem physicalReturnPhase_continuous (h : ℤ) :
    Continuous (fun θ : ℝ => physicalReturnPhase θ h) := by
  unfold physicalReturnPhase
  fun_prop

theorem physicalReturnPhase_intervalIntegrable (h : ℤ) (a b : ℝ) :
    IntervalIntegrable (fun θ : ℝ => physicalReturnPhase θ h) volume a b :=
  (physicalReturnPhase_continuous h).intervalIntegrable a b

/-- Exact orthogonality on one period: integration retains precisely zero displacement. -/
theorem physicalReturnPhase_integral (h : ℤ) :
    (∫ θ : ℝ in (0 : ℝ)..1, physicalReturnPhase θ h) = if h = 0 then 1 else 0 := by
  by_cases hh : h = 0
  · subst h
    simp [physicalReturnPhase_zero]
  · have hc : (h : ℂ) * (2 * (Real.pi : ℂ) * Complex.I) ≠ 0 := by
      exact mul_ne_zero (by exact_mod_cast hh) Complex.two_pi_I_ne_zero
    have he : (fun θ : ℝ => physicalReturnPhase θ h) =
        (fun θ : ℝ => Complex.exp (((h : ℂ) * (2 * (Real.pi : ℂ) * Complex.I)) * θ)) := by
      funext θ
      unfold physicalReturnPhase
      congr 1
      ring
    rw [he, integral_exp_mul_complex hc]
    simp [hh, Complex.exp_int_mul_two_pi_mul_I]

/-- Product of edge phases equals the phase of total displacement. -/
theorem physicalReturnPhase_finset_sum {E : Type*} (edges : Finset E)
    (offset : E → ℤ) (θ : ℝ) :
    physicalReturnPhase θ (∑ e ∈ edges, offset e) =
      ∏ e ∈ edges, physicalReturnPhase θ (offset e) := by
  classical
  induction edges using Finset.induction_on with
  | empty => simp [physicalReturnPhase_zero]
  | @insert e edges he ih => simp [Finset.sum_insert he, Finset.prod_insert he,
      physicalReturnPhase_add, ih]

/-- A finite complex weighted Fourier sum may be integrated term by term. -/
theorem physicalReturnPhase_integral_finset_sum {P : Type*} (paths : Finset P)
    (weight : P → ℂ) (offset : P → ℤ) :
    (∫ θ : ℝ in (0 : ℝ)..1,
      ∑ p ∈ paths, weight p * physicalReturnPhase θ (offset p)) =
      ∑ p ∈ paths, weight p * (if offset p = 0 then 1 else 0) := by
  rw [intervalIntegral.integral_finsetSum]
  · apply Finset.sum_congr rfl
    intro p hp
    rw [intervalIntegral.integral_const_mul, physicalReturnPhase_integral]
  · intro p hp
    exact (continuous_const.mul (physicalReturnPhase_continuous (offset p))).intervalIntegrable _ _

/-- Fourier integration extracts exactly the weighted returning paths. -/
theorem physicalReturnPhase_integral_eq_return_sum {P : Type*} (paths : Finset P)
    (weight : P → ℂ) (offset : P → ℤ) :
    (∫ θ : ℝ in (0 : ℝ)..1,
      ∑ p ∈ paths, weight p * physicalReturnPhase θ (offset p)) =
      ∑ p ∈ paths with offset p = 0, weight p := by
  rw [physicalReturnPhase_integral_finset_sum, Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro p hp
  split_ifs <;> simp_all

/-- A finite path expansion with one phase per edge projects onto zero total offset. -/
theorem physicalReturnPhase_integral_path_expansion {P E : Type*} (paths : Finset P)
    (edges : Finset E) (weight : P → ℂ) (offset : P → E → ℤ) :
    (∫ θ : ℝ in (0 : ℝ)..1,
      ∑ p ∈ paths, weight p * ∏ e ∈ edges, physicalReturnPhase θ (offset p e)) =
      ∑ p ∈ paths with (∑ e ∈ edges, offset p e) = 0, weight p := by
  simp_rw [← physicalReturnPhase_finset_sum]
  exact physicalReturnPhase_integral_eq_return_sum paths weight (fun p => ∑ e ∈ edges, offset p e)
end

section
open Finset Classical
open MeasureTheory
theorem physical_bare_offset_eq_sum {G I : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} {patterns : Finset I}
    (C : I → G → Finset (Fin J)) (k : ℕ → I → ℤ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (edges j : ℕ) :
    physicalBareOffset C k a L edges j =
      ∑ t ∈ range j, physicalBareStep C (k (edges - 1 - t)) (a t) (L t) := by
  induction j with
  | zero => simp [physicalBareOffset]
  | succ j ih => simp [physicalBareOffset, sum_range_succ, ih]

theorem physical_bare_offset_phase_eq_prod {G I : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} {patterns : Finset I}
    (C : I → G → Finset (Fin J)) (k : ℕ → I → ℤ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (edges j : ℕ) (θ : ℝ) :
    physicalReturnPhase θ (physicalBareOffset C k a L edges j) =
      ∏ t ∈ range j, physicalReturnPhase θ
        (physicalBareStep C (k (edges - 1 - t)) (a t) (L t)) := by
  rw [physical_bare_offset_eq_sum, physicalReturnPhase_finset_sum]

/-- Bare edge scalars with one local Fourier phase on each edge. -/
noncomputable def physicalBareFourierWalkScalar {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (edges : ℕ) (θ : ℝ) : ℂ :=
  ∏ j ∈ range edges,
    physicalBareLabeledScalar V patterns C (ζ (edges - 1 - j))
      (K (edges - 1 - j)) (a j) (L j) (L (j + 1)) *
        physicalReturnPhase θ (physicalBareStep C (k (edges - 1 - j)) (a j) (L j))

theorem physical_bare_fourier_walk_scalar_eq {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (edges : ℕ) (θ : ℝ) :
    physicalBareFourierWalkScalar V patterns C ζ k K a L edges θ =
      physicalBareWalkScalar V patterns C ζ K a L edges *
        physicalReturnPhase θ (physicalBareOffset C k a L edges edges) := by
  simp only [physicalBareFourierWalkScalar, prod_mul_distrib, physicalBareWalkScalar,
    physical_bare_offset_phase_eq_prod]

theorem physical_bare_fourier_walk_scalar_continuous {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (edges : ℕ) :
    Continuous (physicalBareFourierWalkScalar V patterns C ζ k K a L edges) := by
  simp_rw [show physicalBareFourierWalkScalar V patterns C ζ k K a L edges =
      (fun θ => physicalBareWalkScalar V patterns C ζ K a L edges *
        physicalReturnPhase θ (physicalBareOffset C k a L edges edges)) from
    funext (physical_bare_fourier_walk_scalar_eq V patterns C ζ k K a L edges)]
  exact continuous_const.mul (physicalReturnPhase_continuous _)

/-- The actual return scalar equals the integral of a product of local phased edge scalars. -/
theorem physical_bare_return_scalar_eq_fourier_integral {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (edges : ℕ) :
    physicalBareReturnScalar V patterns C ζ k K a L edges =
      ∫ θ : ℝ in (0 : ℝ)..1, physicalBareFourierWalkScalar V patterns C ζ k K a L edges θ := by
  simp_rw [physical_bare_fourier_walk_scalar_eq]
  rw [intervalIntegral.integral_const_mul, physicalReturnPhase_integral]
  unfold physicalBareReturnScalar
  split_ifs <;> simp

/-- The same Fourier representation for the canonical finite-path coefficient. -/
theorem physical_finite_return_scalar_eq_fourier_integral {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (r : ℕ) (L : PhysicalMarkLists P J ell)
    (p : Fin (r + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) :
    physicalFiniteReturnScalar V patterns C ζ k K r L p =
      ∫ θ : ℝ in (0 : ℝ)..1, physicalBareFourierWalkScalar V patterns C ζ k K
        (finitePathLabels p) (finitePathMarks L p) (r + 1) θ := by
  exact physical_bare_return_scalar_eq_fourier_integral V patterns C ζ k K _ _ _

/-- The entire finite return action is the Fourier integral of its local-phase
path expansion, retaining exactly the already-established vertex product. -/
theorem physical_free_return_eq_fourier_integral {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (r : ℕ) (n : ℤ) (L : PhysicalMarkLists P J ell) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    physicalBareFreeAction V patterns C q ζ k K
      (fun m _ => if m = n then 1 else 0) (r + 1) n L =
      ∫ θ : ℝ in (0 : ℝ)..1,
        ∑ p : Fin (r + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
          physicalBareFourierWalkScalar V patterns C ζ k K
            (finitePathLabels p) (finitePathMarks L p) (r + 1) θ *
              (physicalFiniteVertexProduct C q k r L p n : ℂ) := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  rw [physical_free_return_factor_sum V patterns C hq ζ k K]
  rw [intervalIntegral.integral_finsetSum]
  · apply sum_congr rfl
    intro p hp
    rw [intervalIntegral.integral_mul_const,
      ← physical_finite_return_scalar_eq_fourier_integral]
  · intro p hp
    exact ((physical_bare_fourier_walk_scalar_continuous V patterns C ζ k K
      (finitePathLabels p) (finitePathMarks L p) (r + 1)).mul
        continuous_const).intervalIntegrable _ _
end

section
open Finset
abbrev GhostFiniteState (R : Type*) := Option (Option R)

/-- Initial mass is concentrated at the unborn state. -/
def ghostFiniteInitial {R : Type*} : GhostFiniteState R → ℝ
  | none => 1
  | some _ => 0

/-- The first state argument is the output, the second is the input.
This orientation makes `finitePathAction` propagate distributions forward. -/
noncomputable def ghostFiniteKernel {R : Type*} [DecidableEq R]
    (hit : R) (η β : ℝ) : GhostFiniteState R → GhostFiniteState R → ℝ
  | none, none => 1
  | none, some _ => 0
  | some none, none => 0
  | some none, some none => 1
  | some none, some (some r) => if r = hit then -η else 0
  | some (some r), none => if r = hit then -β * η else 0
  | some (some _), some none => 0
  | some (some r), some (some s) =>
      if s = r then 1 - η * (if r = hit then 1 else 0) else 0

/-- Embed the scalar ghost recurrence into a finite vector. -/
def ghostFiniteVector {R : Type*} (s : GhostLifespanState R) : GhostFiniteState R → ℝ
  | none => 1
  | some none => s.completed
  | some (some r) => s.pending r

theorem ghost_finite_kernel_step {R : Type*} [Fintype R] [DecidableEq R]
    (hit : R) (η β : ℝ) (s : GhostLifespanState R) (x : GhostFiniteState R) :
    (∑ y, ghostFiniteKernel hit η β x y * ghostFiniteVector s y) =
      ghostFiniteVector (ghostLifespanStep hit η β s) x := by
  rcases x with _ | (_ | r)
  · simp [ghostFiniteKernel, ghostFiniteVector]
  · simp [ghostFiniteKernel, ghostFiniteVector, ghostLifespanStep, sub_eq_add_neg,
      mul_comm]
  · simp [ghostFiniteKernel, ghostFiniteVector, ghostLifespanStep]
    split <;> simp_all
    ring

/-- All three coordinates of finite matrix iteration coincide with the
single-birth ghost recurrence, including the absorbing completed coordinate. -/
theorem ghost_finite_action_eq_vector {R : Type*} [Fintype R] [DecidableEq R]
    (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (n : ℕ) (x : GhostFiniteState R) :
    finitePathAction (fun j => ghostFiniteKernel (h j) (η j) β)
      ghostFiniteInitial n x = ghostFiniteVector (ghostLifespanRun h η β n) x := by
  induction n generalizing x with
  | zero => rcases x with _ | (_ | r) <;> rfl
  | succ n ih =>
    simp only [finitePathAction, ih, ghostLifespanRun]
    exact ghost_finite_kernel_step (h n) (η n) β _ x

/-- Ending with no pending particle permits either no birth or one completed
lifespan. Its coefficient is exactly the normalized residue expectation. -/
theorem ghost_finite_vacuum_identity {R : Type*} [Fintype R] [DecidableEq R]
    [Nonempty R] (h : ℕ → R) (η : ℕ → ℝ) (n : ℕ) (b : ℝ)
    (hb : b = 1 - (∑ i ∈ range n, η i) / Fintype.card R) (hb0 : b ≠ 0) :
    finitePathAction (fun j => ghostFiniteKernel (h j) (η j)
        ((Fintype.card R : ℝ) * b)⁻¹) ghostFiniteInitial n none +
      finitePathAction (fun j => ghostFiniteKernel (h j) (η j)
        ((Fintype.card R : ℝ) * b)⁻¹) ghostFiniteInitial n (some none) =
      ((∑ r : R, ∏ i ∈ range n, (1 - η i * (if r = h i then 1 else 0))) /
        Fintype.card R) / b := by
  simp only [ghost_finite_action_eq_vector, ghostFiniteVector]
  exact ghostLifespan_vacuum_identity h η n b hb hb0
end

section
open Finset
/-- Each ordering of one fixed finite batch has the same product weight. -/
theorem equiv_batch_product {S P R : Type*} [Fintype S] [Fintype P] [CommMonoid R]
    (w : P → R) (e : S ≃ P) : (∏ s, w (e s)) = ∏ p, w p := by
  exact e.prod_comp w

/-- A finite distinct batch has exactly one copy after its ordered forms
are divided by the permutation factorial. -/
theorem distinct_batch_factorial_normalization {S P : Type*} [Fintype S] [Fintype P]
    [DecidableEq S] [DecidableEq P]
    (e : S ≃ P) (w : P → ℝ) :
    (∑ f : S ≃ P, ∏ s, w (f s)) / (Fintype.card S).factorial = ∏ p, w p := by
  simp_rw [equiv_batch_product]
  rw [sum_const, card_univ, nsmul_eq_mul, Fintype.card_equiv e]
  have h : ((Fintype.card S).factorial : ℝ) ≠ 0 := by positivity
  exact mul_div_cancel_left₀ _ h
end

section

theorem ordered_retrieval_factorial {j a : ℕ} (ha : a ≤ j) :
    (j.descFactorial a : ℝ) / j.factorial = 1 / ((j-a).factorial : ℝ) := by
  have hj : (j.factorial : ℝ) ≠ 0 := by positivity
  have hja : ((j-a).factorial : ℝ) ≠ 0 := by positivity
  have hfac : ((j-a).factorial : ℝ) * (j.descFactorial a : ℝ) = j.factorial := by
    exact_mod_cast Nat.factorial_mul_descFactorial ha
  field_simp
  nlinarith [hfac]

/-- The memory factorial is invariant under reversing an ordered retrieval
of `a` old particles and storage of `b` new particles. -/
theorem ordered_retrieval_reversal (u a b : ℕ) :
    ((u+a).descFactorial a : ℝ) / (u+a).factorial =
      ((u+b).descFactorial b : ℝ) / (u+b).factorial := by
  rw [ordered_retrieval_factorial (by omega), ordered_retrieval_factorial (by omega)]
  simp

/-- Weighted retrieval leaves the factorial of the unretrieved particles. -/
theorem ghostWeight_mul_descFactorial (ν : ℝ) (u a : ℕ) :
    ghostWeight ν (u+a) * ((u+a).descFactorial a : ℝ) =
      ν^(u+a) / (u.factorial : ℝ) := by
  unfold ghostWeight
  calc
    _ = ν^(u+a) * (((u+a).descFactorial a : ℝ) / (u+a).factorial) := by ring
    _ = _ := by rw [ordered_retrieval_factorial (by omega)]; simp [div_eq_mul_inv]

/-- Species weights are also unchanged under reversal, including repeated
numerical particles of the same species. No positivity of `ν` is required. -/
theorem ghostWeight_retrieval_reversal (ν : ℝ) (u a b : ℕ) :
    ghostWeight ν (u+a) * ((u+a).descFactorial a : ℝ) * ν^b =
      ghostWeight ν (u+b) * ((u+b).descFactorial b : ℝ) * ν^a := by
  rw [ghostWeight_mul_descFactorial, ghostWeight_mul_descFactorial]
  simp only [pow_add]
  ring

/-- The exact weighted reversal multiplies across all particle species. -/
theorem ghostWeight_retrieval_reversal_prod {I : Type*} [Fintype I]
    (ν : I → ℝ) (u a b : I → ℕ) :
    (∏ i, ghostWeight (ν i) (u i+a i) * ((u i+a i).descFactorial (a i) : ℝ) * (ν i)^(b i)) =
      ∏ i, ghostWeight (ν i) (u i+b i) * ((u i+b i).descFactorial (b i) : ℝ) * (ν i)^(a i) := by
  apply Finset.prod_congr rfl
  intro i _
  exact ghostWeight_retrieval_reversal (ν i) (u i) (a i) (b i)
end

section
open Finset
/-- A finite path action with coordinatewise kernels and terminal values
factors into the product of its coordinate path actions. -/
theorem finite_path_action_tensor {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] {R : Type*} [CommSemiring R]
    (K : ℕ → (i : I) → X i → X i → R) (f : (i : I) → X i → R)
    (n : ℕ) (x : (i : I) → X i) :
    finitePathAction (fun j x y => ∏ i, K j i (x i) (y i))
        (fun x => ∏ i, f i (x i)) n x =
      ∏ i, finitePathAction (fun j => K j i) (f i) n (x i) := by
  classical
  induction n generalizing x with
  | zero => rfl
  | succ n ih =>
    simp only [finitePathAction, ih]
    simp_rw [← prod_mul_distrib]
    exact (Fintype.prod_sum (fun i y =>
      K n i (x i) y * finitePathAction (fun j => K j i) (f i) n y)).symm

/-- Summing tensor path actions over independently selected endpoints
factors into the corresponding coordinate endpoint sums. -/
theorem finite_path_action_tensor_sum_endpoints {I : Type*}
    [Fintype I] [DecidableEq I] {X E : I → Type*}
    [∀ i, Fintype (X i)] [∀ i, Fintype (E i)]
    {R : Type*} [CommSemiring R]
    (K : ℕ → (i : I) → X i → X i → R) (f : (i : I) → X i → R)
    (e : (i : I) → E i → X i) (n : ℕ) :
    (∑ z : (i : I) → E i,
      finitePathAction (fun j x y => ∏ i, K j i (x i) (y i))
        (fun x => ∏ i, f i (x i)) n (fun i => e i (z i))) =
      ∏ i, ∑ z : E i, finitePathAction (fun j => K j i) (f i) n (e i z) := by
  classical
  simp_rw [finite_path_action_tensor K f]
  exact (Fintype.prod_sum (fun i z =>
    finitePathAction (fun j => K j i) (f i) n (e i z))).symm

/-- For two possible endpoints per coordinate, the total tensor action is
the product of the sums at the two coordinate endpoints. -/
theorem finite_path_action_tensor_sum_bool {I : Type*}
    [Fintype I] [DecidableEq I] {X : I → Type*} [∀ i, Fintype (X i)]
    {R : Type*} [CommSemiring R]
    (K : ℕ → (i : I) → X i → X i → R) (f : (i : I) → X i → R)
    (e0 e1 : (i : I) → X i) (n : ℕ) :
    (∑ b : I → Bool,
      finitePathAction (fun j x y => ∏ i, K j i (x i) (y i))
        (fun x => ∏ i, f i (x i)) n (fun i => if b i then e1 i else e0 i)) =
      ∏ i, (finitePathAction (fun j => K j i) (f i) n (e0 i) +
        finitePathAction (fun j => K j i) (f i) n (e1 i)) := by
  classical
  simpa [add_comm] using finite_path_action_tensor_sum_endpoints K f
    (fun i (b : Bool) => if b then e1 i else e0 i) n

/-- Every individual tensor path factors into its coordinate path terms.
This identity needs no finiteness assumptions on labels or states. -/
theorem labeled_path_term_tensor {I : Type*} [Fintype I]
    {A X : I → Type*} {R : Type*} [CommMonoid R]
    (K : ℕ → (i : I) → A i → X i → X i → R)
    (f : (i : I) → X i → R) (n : ℕ) (x : (i : I) → X i)
    (p : Fin n → ((i : I) → A i) × ((i : I) → X i)) :
    labeledPathTerm (fun j a x y => ∏ i, K j i (a i) (x i) (y i))
        (fun x => ∏ i, f i (x i)) n x p =
      ∏ i, labeledPathTerm (fun j => K j i) (f i) n (x i)
        (fun k => ((p k).1 i, (p k).2 i)) := by
  induction n generalizing x with
  | zero => rfl
  | succ n ih =>
    simp only [labeledPathTerm, ih, prod_mul_distrib]
    rfl

/-- Summing all labeled paths in the tensor state space gives the product
of the sums over all coordinate labeled paths. -/
theorem finite_labeled_path_expansion_tensor {I : Type*} [Fintype I] [DecidableEq I]
    {A X : I → Type*} [∀ i, Fintype (A i)] [∀ i, Fintype (X i)]
    {R : Type*} [CommSemiring R]
    (K : ℕ → (i : I) → A i → X i → X i → R)
    (f : (i : I) → X i → R) (n : ℕ) (x : (i : I) → X i) :
    (∑ p : Fin n → ((i : I) → A i) × ((i : I) → X i),
      labeledPathTerm (fun j a x y => ∏ i, K j i (a i) (x i) (y i))
        (fun x => ∏ i, f i (x i)) n x p) =
      ∏ i, ∑ p : Fin n → A i × X i,
        labeledPathTerm (fun j => K j i) (f i) n (x i) p := by
  classical
  rw [finite_labeled_path_expansion]
  have hkernel :
      (fun j (x y : (i : I) → X i) =>
        ∑ a : (i : I) → A i, ∏ i, K j i (a i) (x i) (y i)) =
      (fun j (x y : (i : I) → X i) =>
        ∏ i, ∑ a : A i, K j i a (x i) (y i)) := by
    funext j x y
    exact (Fintype.prod_sum (fun i a => K j i a (x i) (y i))).symm
  rw [hkernel, finite_path_action_tensor (fun j i x y => ∑ a, K j i a x y)]
  apply prod_congr rfl
  intro i _
  exact (finite_labeled_path_expansion (fun j => K j i) (f i) n (x i)).symm
end

section
open Finset
/-- The joint no-pending endpoint sum is the product of the two vacuum
coordinates of each independent ghost recurrence. -/
theorem ghost_tensor_vacuum_factorization {I : Type*}
    [Fintype I] [DecidableEq I] {R : I → Type*}
    [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (h : (i : I) → ℕ → R i) (η : I → ℕ → ℝ) (β : I → ℝ) (n : ℕ) :
    (∑ b : I → Bool,
      finitePathAction
        (fun j (x y : (i : I) → GhostFiniteState (R i)) =>
          ∏ i, ghostFiniteKernel (h i j) (η i j) (β i) (x i) (y i))
        (fun x => ∏ i, ghostFiniteInitial (x i)) n
        (fun i => if b i then some none else none)) =
      ∏ i, (finitePathAction (fun j => ghostFiniteKernel (h i j) (η i j) (β i))
          ghostFiniteInitial n none +
        finitePathAction (fun j => ghostFiniteKernel (h i j) (η i j) (β i))
          ghostFiniteInitial n (some none)) := by
  exact finite_path_action_tensor_sum_bool
    (fun j i => ghostFiniteKernel (h i j) (η i j) (β i))
    (fun _ => ghostFiniteInitial) (fun _ => none) (fun _ => some none) n

/-- Normalized ghost parameters identify the joint vacuum coefficient
with the product of normalized residue expectations. -/
theorem ghost_tensor_vacuum_identity {I : Type*}
    [Fintype I] [DecidableEq I] {R : I → Type*}
    [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)] [∀ i, Nonempty (R i)]
    (h : (i : I) → ℕ → R i) (η : I → ℕ → ℝ) (n : ℕ) (b : I → ℝ)
    (hb : ∀ i, b i = 1 - (∑ j ∈ range n, η i j) / Fintype.card (R i))
    (hb0 : ∀ i, b i ≠ 0) :
    (∑ e : I → Bool,
      finitePathAction
        (fun j (x y : (i : I) → GhostFiniteState (R i)) =>
          ∏ i, ghostFiniteKernel (h i j) (η i j)
            ((Fintype.card (R i) : ℝ) * b i)⁻¹ (x i) (y i))
        (fun x => ∏ i, ghostFiniteInitial (x i)) n
        (fun i => if e i then some none else none)) =
      ∏ i, ((∑ r : R i,
        ∏ j ∈ range n, (1 - η i j * (if r = h i j then 1 else 0))) /
          Fintype.card (R i)) / b i := by
  rw [ghost_tensor_vacuum_factorization]
  apply prod_congr rfl
  intro i _
  exact ghost_finite_vacuum_identity (h i) (η i) n (b i) (hb i) (hb0 i)
end

section
open Finset
structure ActiveGhostState (R : Type*) where
  unborn : ℝ
  pending : R → ℝ
  completed : ℝ

noncomputable def activeGhostStep {R : Type*} [DecidableEq R]
    (active : Bool) (hit : R) (η β : ℝ) (s : ActiveGhostState R) :
    ActiveGhostState R :=
  if active then
    { unborn := 0
      pending := fun r => if r = hit then s.pending r + β * s.unborn else 0
      completed := s.pending hit + β * s.unborn }
  else
    { unborn := s.unborn
      pending := fun r => s.pending r * (1 - η * (if r = hit then 1 else 0)) -
        β * s.unborn * η * (if r = hit then 1 else 0)
      completed := s.completed - η * s.pending hit }

noncomputable def activeGhostRun {R : Type*} [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) : ℕ → ActiveGhostState R
  | 0 => ⟨1, fun _ => 0, 0⟩
  | n + 1 => activeGhostStep (a n) (h n) (η n) β (activeGhostRun a h η β n)

noncomputable def activeGhostLocalFactor {R : Type*} [DecidableEq R]
    (active : Bool) (hit : R) (η : ℝ) (r : R) : ℝ :=
  if active then (if r = hit then 1 else 0)
  else 1 - η * (if r = hit then 1 else 0)

/-- The unborn coefficient disappears permanently at the first active visit. -/
theorem activeGhost_unborn {R : Type*} [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (n : ℕ) :
    (activeGhostRun a h η β n).unborn =
      if ∀ i < n, a i = false then 1 else 0 := by
  induction n with
  | zero => simp [activeGhostRun]
  | succ n ih =>
    have hall : (∀ i < n + 1, a i = false) ↔
        (∀ i < n, a i = false) ∧ a n = false := by
      constructor
      · intro hh
        exact ⟨fun i hi => hh i (by omega), hh n (by omega)⟩
      · rintro ⟨hh, hn⟩ i hi
        by_cases hin : i < n
        · exact hh i hin
        · have : i = n := by omega
          simpa [this] using hn
    simp only [hall]
    cases ha : a n <;> simp only [activeGhostRun, activeGhostStep, ha, ih,
      Bool.false_eq_true, Bool.true_eq_false, ↓reduceIte, and_true, and_false]

/-- Each pending residue retains the full local product, with the surviving
unborn coefficient removed. The birth factor is paid exactly once. -/
theorem activeGhost_pending {R : Type*} [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (n : ℕ) (r : R) :
    (activeGhostRun a h η β n).pending r =
      β * ((∏ i ∈ range n, activeGhostLocalFactor (a i) (h i) (η i) r) -
        (activeGhostRun a h η β n).unborn) := by
  induction n with
  | zero => simp [activeGhostRun]
  | succ n ih =>
    cases ha : a n <;>
      simp only [activeGhostRun, activeGhostStep, activeGhostLocalFactor,
        ha, Bool.false_eq_true, ↓reduceIte, prod_range_succ] <;>
      rw [ih] <;> simp only [activeGhostLocalFactor] <;> split <;> simp_all <;> ring

/-- Signed conservation identity, including the unborn compensation term. -/
theorem activeGhost_completed_balance {R : Type*} [Fintype R] [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (n : ℕ) :
    (activeGhostRun a h η β n).completed =
      (∑ r : R, (activeGhostRun a h η β n).pending r) +
        β * (activeGhostRun a h η β n).unborn * ∑ i ∈ range n, η i := by
  induction n with
  | zero => simp [activeGhostRun]
  | succ n ih =>
    cases ha : a n
    · have hs : (∑ r : R, (activeGhostRun a h η β (n + 1)).pending r) =
          (∑ r : R, (activeGhostRun a h η β n).pending r) -
            η n * (activeGhostRun a h η β n).pending (h n) -
            β * (activeGhostRun a h η β n).unborn * η n := by
        simp only [activeGhostRun, activeGhostStep, ha, Bool.false_eq_true,
          ↓reduceIte, mul_sub, mul_one, sum_sub_distrib]
        simp only [mul_ite, mul_one, mul_zero, sum_ite_eq', mem_univ, if_true]
        ring
      rw [hs]
      simp only [activeGhostRun, activeGhostStep, ha, Bool.false_eq_true,
        ↓reduceIte, sum_range_succ]
      rw [ih]
      ring
    · simp [activeGhostRun, activeGhostStep, ha]

/-- The local product splits into active indicator factors and inactive damping. -/
theorem activeGhost_product_eq_weight {R : Type*} [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (n : ℕ) (r : R) :
    (∏ i ∈ range n, activeGhostLocalFactor (a i) (h i) (η i) r) =
      activeResidueWeight (range n) ((range n).filter (fun i => a i = true)) h η r := by
  classical
  have hs : range n \ (range n).filter (fun i => a i = true) =
      (range n).filter (fun i => ¬ a i = true) := by
    ext i
    simp only [mem_sdiff, mem_filter]
    tauto
  rw [activeResidueWeight, hs]
  rw [← prod_filter_mul_prod_filter_not (range n) (fun i => a i = true)
    (fun i => activeGhostLocalFactor (a i) (h i) (η i) r)]
  congr 1
  · apply prod_congr rfl
    intro i hi
    simp only [mem_filter] at hi
    simp [activeGhostLocalFactor, hi.2]
  · apply prod_congr rfl
    intro i hi
    simp only [mem_filter] at hi
    simp [activeGhostLocalFactor, hi.2]

/-- Once any visit is active, the completed coefficient is the exact signed
residue weight, including all active compatibility and inactive damping. -/
theorem activeGhost_completed_active {R : Type*} [Fintype R] [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (n : ℕ)
    (ha : ∃ i < n, a i = true) :
    (activeGhostRun a h η β n).completed =
      β * ∑ r : R,
        activeResidueWeight (range n) ((range n).filter (fun i => a i = true)) h η r := by
  have hu : (activeGhostRun a h η β n).unborn = 0 := by
    rw [activeGhost_unborn]
    have hnot : ¬ ∀ i < n, a i = false := by
      rintro hh
      obtain ⟨i, hi, hai⟩ := ha
      have := hh i hi
      simp_all
    simp [hnot]
  rw [activeGhost_completed_balance, hu]
  simp only [mul_zero, zero_mul, add_zero]
  simp_rw [activeGhost_pending, hu, sub_zero, activeGhost_product_eq_weight]
  exact (mul_sum _ _ _).symm

/-- A product formula valid with any activity pattern. -/
theorem activeGhost_completed_product {R : Type*} [Fintype R] [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (n : ℕ) :
    (activeGhostRun a h η β n).completed =
      β * ((∑ r : R, ∏ i ∈ range n, activeGhostLocalFactor (a i) (h i) (η i) r) -
        (Fintype.card R : ℝ) * (activeGhostRun a h η β n).unborn +
        (activeGhostRun a h η β n).unborn * ∑ i ∈ range n, η i) := by
  rw [activeGhost_completed_balance]
  simp_rw [activeGhost_pending]
  rw [← mul_sum, sum_sub_distrib]
  simp only [sum_const, card_univ, nsmul_eq_mul]
  ring

/-- The unborn-plus-completed coefficient is the normalized local expectation,
for every pattern of active and inactive visits. -/
theorem activeGhost_vacuum_identity {R : Type*} [Fintype R] [DecidableEq R]
    [Nonempty R] (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (n : ℕ) (b : ℝ)
    (hb : b = 1 - (∑ i ∈ range n, η i) / Fintype.card R) (hb0 : b ≠ 0) :
    (activeGhostRun a h η ((Fintype.card R : ℝ) * b)⁻¹ n).unborn +
      (activeGhostRun a h η ((Fintype.card R : ℝ) * b)⁻¹ n).completed =
      ((∑ r : R, ∏ i ∈ range n,
        activeGhostLocalFactor (a i) (h i) (η i) r) / Fintype.card R) / b := by
  have hc : (Fintype.card R : ℝ) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have heq : b * Fintype.card R = Fintype.card R - ∑ i ∈ range n, η i := by
    rw [hb]
    field_simp
  have hcancel : 1 - ((Fintype.card R : ℝ) * b)⁻¹ * Fintype.card R +
      ((Fintype.card R : ℝ) * b)⁻¹ * (∑ i ∈ range n, η i) = 0 := by
    field_simp
    nlinarith [heq]
  rw [activeGhost_completed_product]
  calc
    _ = ((Fintype.card R : ℝ) * b)⁻¹ *
        (∑ r : R, ∏ i ∈ range n, activeGhostLocalFactor (a i) (h i) (η i) r) +
        (activeGhostRun a h η ((Fintype.card R : ℝ) * b)⁻¹ n).unborn *
        (1 - ((Fintype.card R : ℝ) * b)⁻¹ * Fintype.card R +
          ((Fintype.card R : ℝ) * b)⁻¹ * (∑ i ∈ range n, η i)) := by ring
    _ = _ := by rw [hcancel]; simp only [mul_zero, add_zero, div_eq_mul_inv, mul_inv_rev]; ring

/-- With no active visits this recurrence is exactly the distinct-birth ghost
recurrence, including its completed coordinate. -/
theorem activeGhost_no_active {R : Type*} [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (n : ℕ) :
    (∀ i < n, a i = false) →
      activeGhostRun a h η β n =
        ⟨1, (ghostLifespanRun h η β n).pending, (ghostLifespanRun h η β n).completed⟩ := by
  induction n with
  | zero => intro _; rfl
  | succ n ih =>
    intro ha
    have han : a n = false := ha n (by omega)
    have hap : ∀ i < n, a i = false := fun i hi => ha i (by omega)
    rw [activeGhostRun, ih hap]
    simp [activeGhostStep, han, ghostLifespanRun, ghostLifespanStep]

/-- The same normalized identity expressed with the active/inactive residue
weight used in the lifespan expansion. -/
theorem activeGhost_vacuum_weight_identity {R : Type*} [Fintype R] [DecidableEq R]
    [Nonempty R] (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (n : ℕ) (b : ℝ)
    (hb : b = 1 - (∑ i ∈ range n, η i) / Fintype.card R) (hb0 : b ≠ 0) :
    (activeGhostRun a h η ((Fintype.card R : ℝ) * b)⁻¹ n).unborn +
      (activeGhostRun a h η ((Fintype.card R : ℝ) * b)⁻¹ n).completed =
      ((∑ r : R, activeResidueWeight (range n)
        ((range n).filter (fun i => a i = true)) h η r) / Fintype.card R) / b := by
  simpa only [activeGhost_product_eq_weight] using
    activeGhost_vacuum_identity a h η n b hb hb0
end

section
open Finset
/-- An active visit forces a hit. It may begin or finish an active lifespan,
but neither leaves an unborn prime nor revives a completed lifespan. -/
noncomputable def activeGhostFiniteKernel {R : Type*} [DecidableEq R]
    (active : Bool) (hit : R) (η β : ℝ) : GhostFiniteState R → GhostFiniteState R → ℝ :=
  if active then fun x y => match x, y with
    | none, _ => 0
    | some none, none => β
    | some none, some none => 0
    | some none, some (some r) => if r = hit then 1 else 0
    | some (some r), none => if r = hit then β else 0
    | some (some _), some none => 0
    | some (some r), some (some s) => if r = hit ∧ s = r then 1 else 0
  else ghostFiniteKernel hit η β

/-- All three evolving coefficients form the finite state vector. -/
def activeGhostFiniteVector {R : Type*} (s : ActiveGhostState R) : GhostFiniteState R → ℝ
  | none => s.unborn
  | some none => s.completed
  | some (some r) => s.pending r

/-- The transition matrix is exactly the unified ghost recurrence. -/
theorem active_ghost_finite_kernel_step {R : Type*} [Fintype R] [DecidableEq R]
    (active : Bool) (hit : R) (η β : ℝ) (s : ActiveGhostState R) (x : GhostFiniteState R) :
    (∑ y, activeGhostFiniteKernel active hit η β x y * activeGhostFiniteVector s y) =
      activeGhostFiniteVector (activeGhostStep active hit η β s) x := by
  cases active <;> rcases x with _ | (_ | r)
  · simp [activeGhostFiniteKernel, ghostFiniteKernel, activeGhostFiniteVector, activeGhostStep]
  · simp [activeGhostFiniteKernel, ghostFiniteKernel, activeGhostFiniteVector, activeGhostStep,
      sub_eq_add_neg, mul_comm]
  · simp [activeGhostFiniteKernel, ghostFiniteKernel, activeGhostFiniteVector, activeGhostStep]
    split <;> simp_all
    ring
  · simp [activeGhostFiniteKernel, activeGhostFiniteVector, activeGhostStep]
  · simp [activeGhostFiniteKernel, activeGhostFiniteVector, activeGhostStep, add_comm]
  · by_cases hr : r = hit
    · subst r
      simp [activeGhostFiniteKernel, activeGhostFiniteVector, activeGhostStep, add_comm]
    · simp [activeGhostFiniteKernel, activeGhostFiniteVector, activeGhostStep, hr]

/-- Finite matrix evolution tracks the exact mixed active/inactive history. -/
theorem active_ghost_finite_action_eq_vector {R : Type*} [Fintype R] [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (n : ℕ) (x : GhostFiniteState R) :
    finitePathAction (fun j => activeGhostFiniteKernel (a j) (h j) (η j) β)
      ghostFiniteInitial n x = activeGhostFiniteVector (activeGhostRun a h η β n) x := by
  induction n generalizing x with
  | zero => rcases x with _ | (_ | r) <;> rfl
  | succ n ih =>
    simp only [finitePathAction, ih, activeGhostRun]
    exact active_ghost_finite_kernel_step (a n) (h n) (η n) β _ x
end

section
open Finset
/-- Every coordinate ends unborn or completed; no pending lifespan is retained. -/
noncomputable def activeGhostTensorVacuum {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (a : I → ℕ → Bool) (h : (i : I) → ℕ → R i) (η : I → ℕ → ℝ)
    (β : I → ℝ) (n : ℕ) : ℝ :=
  ∑ b : I → Bool,
    finitePathAction (fun j x y => ∏ i, activeGhostFiniteKernel (a i j)
      (h i j) (η i j) (β i) (x i) (y i))
      (fun x => ∏ i, ghostFiniteInitial (x i)) n
      (fun i => if b i then some none else none)

/-- The finite tensor vacuum coefficient factors into the exact single-prime
unborn-plus-completed coefficients. -/
theorem active_ghost_tensor_vacuum_factor {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (a : I → ℕ → Bool) (h : (i : I) → ℕ → R i) (η : I → ℕ → ℝ)
    (β : I → ℝ) (n : ℕ) :
    activeGhostTensorVacuum a h η β n =
      ∏ i, ((activeGhostRun (a i) (h i) (η i) (β i) n).unborn +
        (activeGhostRun (a i) (h i) (η i) (β i) n).completed) := by
  unfold activeGhostTensorVacuum
  rw [finite_path_action_tensor_sum_bool]
  simp only [active_ghost_finite_action_eq_vector, activeGhostFiniteVector]

/-- After extracting the common baselines, the complete independent residue
expectation is exactly a finite memory evolution with at most one birth per prime. -/
theorem active_ghost_tensor_vacuum_identity {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)] [∀ i, Nonempty (R i)]
    (a : I → ℕ → Bool) (h : (i : I) → ℕ → R i) (η : I → ℕ → ℝ)
    (n : ℕ) (b : I → ℝ)
    (hb : ∀ i, b i = 1 - (∑ j ∈ range n, η i j) / Fintype.card (R i))
    (hb0 : ∀ i, b i ≠ 0) :
    (∏ i, b i) * activeGhostTensorVacuum a h η
      (fun i => ((Fintype.card (R i) : ℝ) * b i)⁻¹) n =
      ∏ i, (∑ r : R i, activeResidueWeight (range n)
        ((range n).filter (fun j => a i j = true)) (h i) (η i) r) / Fintype.card (R i) := by
  rw [active_ghost_tensor_vacuum_factor, ← prod_mul_distrib]
  apply prod_congr rfl
  intro i _
  rw [activeGhost_vacuum_identity (a i) (h i) (η i) n (b i) (hb i) (hb0 i)]
  simp_rw [activeGhost_product_eq_weight]
  exact mul_div_cancel₀ _ (hb0 i)

/-- The existing prime-pool path expectation is represented by the finite
tensor memory kernel without altering its active-visit or baseline normalization. -/
theorem pool_path_residue_eq_memory {I : Type*} [Fintype I] [DecidableEq I]
    (m : I → ℕ) [∀ i, NeZero (m i)] (a : I → ℕ → Bool)
    (h : (i : I) → ℕ → ZMod (m i)) (η : ℕ → ℝ) (n : ℕ) (b : I → ℝ)
    (hb : ∀ i, b i = 1 - (∑ j ∈ range n, η j) / m i)
    (hb0 : ∀ i, b i ≠ 0) :
    poolPathResidueExpectation m univ (range n)
      (fun i => (range n).filter (fun j => a i j = true)) h η =
      (∏ i, b i) * activeGhostTensorVacuum a h (fun _ => η)
        (fun i => ((m i : ℝ) * b i)⁻¹) n := by
  symm
  have he := active_ghost_tensor_vacuum_identity a h (fun _ => η) n b
    (by simpa only [ZMod.card] using hb) hb0
  simpa only [ZMod.card, poolPathResidueExpectation] using he
end

section

/-- The nonnegative occupancy kernel obtained by taking absolute values of
the birth and death coefficients before summing transition choices. -/
noncomputable def ghostMemoryMajorant {ι : Type*} [Fintype ι] {B : ℕ}
    (A D C ν : ι → ℝ) (x y : ι → Fin (B + 1)) : ℝ :=
  ∏ i, ghostKernel (A i) |D i| |C i| (ν i) (x i) (y i)

theorem ghostMemoryMajorant_nonneg {ι : Type*} [Fintype ι] {B : ℕ}
    (A D C ν : ι → ℝ) (hA : ∀ i, 0 ≤ A i) (hν : ∀ i, 0 ≤ ν i)
    (x y : ι → Fin (B + 1)) :
    0 ≤ ghostMemoryMajorant A D C ν x y := by
  apply Finset.prod_nonneg
  intro i hi
  unfold ghostKernel
  apply Finset.sum_nonneg
  intro k hk
  have hAi := hA i
  have hνi := hν i
  positivity

/-- Absolute values must be taken before summing the signed scalar choices. -/
theorem ghostMemoryKernel_norm_le_majorant {ι : Type*} [Fintype ι] {B : ℕ}
    (A D C ν : ι → ℝ) (hA : ∀ i, 0 ≤ A i) (hν : ∀ i, 0 ≤ ν i)
    (x y : ι → Fin (B + 1)) :
    ‖ghostMemoryKernel A D C ν x y‖ ≤ ghostMemoryMajorant A D C ν x y := by
  unfold ghostMemoryKernel ghostMemoryMajorant
  rw [norm_prod]
  apply Finset.prod_le_prod₀ (fun i hi => norm_nonneg _)
  intro i hi
  simpa only [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hA i),
    abs_of_nonneg (hν i)] using
    abs_ghostKernel_le (A i) (D i) (C i) (ν i) (x i) (y i)

/-- Any complex kernel dominated by the absolute transition-choice kernel has
the same cutoff-independent weighted L2 estimate as ghost memory. -/
theorem ghostMemory_dominated_l2_sq_le {ι : Type*} [Fintype ι] {B : ℕ}
    (S : Finset (ι → Fin (B + 1))) (A D C ν v : ι → ℝ)
    (hA : ∀ i, 0 ≤ A i) (hν : ∀ i, 0 < ν i) (hv : ∀ i, 0 < v i)
    (hD : ∀ i, A i + |D i| / v i ≤ 1)
    (hC : ∀ i, A i + |C i| / v i ≤ 1)
    (K : (ι → Fin (B + 1)) → (ι → Fin (B + 1)) → ℂ)
    (hK : ∀ x ∈ S, ∀ y ∈ S, ‖K x y‖ ≤ ghostMemoryMajorant A D C ν x y)
    (f : (ι → Fin (B + 1)) → ℂ) :
    (∑ x ∈ S, ghostMemoryWeight ν x * ‖∑ y ∈ S, K x y * f y‖ ^ 2) ≤
      Real.exp (∑ i, (|C i| + |D i|) * ν i * v i) *
        ∑ y ∈ S, ghostMemoryWeight ν y * ‖f y‖ ^ 2 := by
  classical
  let g : (ι → Fin (B + 1)) → ℂ := fun y => (‖f y‖ : ℂ)
  have hmajor (x y : ι → Fin (B + 1)) :
      ghostMemoryKernel A (fun i => |D i|) (fun i => |C i|) ν x y =
        (ghostMemoryMajorant A D C ν x y : ℂ) := by
    simp only [ghostMemoryKernel, ghostMemoryMajorant, Complex.ofReal_prod]
  have haction (x : ι → Fin (B + 1)) :
      ‖ghostMemoryAction S A (fun i => |D i|) (fun i => |C i|) ν g x‖ =
        ∑ y ∈ S, ghostMemoryMajorant A D C ν x y * ‖f y‖ := by
    have hn : 0 ≤ ∑ y ∈ S, ghostMemoryMajorant A D C ν x y * ‖f y‖ :=
      Finset.sum_nonneg fun y hy =>
        mul_nonneg (ghostMemoryMajorant_nonneg A D C ν hA (fun i => (hν i).le) x y)
          (norm_nonneg _)
    simp only [ghostMemoryAction, hmajor, g, ← Complex.ofReal_mul,
      ← Complex.ofReal_sum, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hn]
  have hpoint (x : ι → Fin (B + 1)) (hx : x ∈ S) :
      ‖∑ y ∈ S, K x y * f y‖ ≤
        ‖ghostMemoryAction S A (fun i => |D i|) (fun i => |C i|) ν g x‖ := by
    rw [haction]
    calc
      _ ≤ ∑ y ∈ S, ‖K x y‖ * ‖f y‖ := by
        simpa only [norm_mul] using norm_sum_le S (fun y => K x y * f y)
      _ ≤ _ := Finset.sum_le_sum fun y hy =>
        mul_le_mul_of_nonneg_right (hK x hx y hy) (norm_nonneg _)
  have hbound := ghostMemory_l2_sq_le S A (fun i => |D i|) (fun i => |C i|)
    ν v hA hν hv (by simpa only [abs_abs] using hD)
    (by simpa only [abs_abs] using hC) g
  calc
    _ ≤ ∑ x ∈ S, ghostMemoryWeight ν x *
        ‖ghostMemoryAction S A (fun i => |D i|) (fun i => |C i|) ν g x‖ ^ 2 := by
      apply Finset.sum_le_sum
      intro x hx
      apply mul_le_mul_of_nonneg_left
        ((sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mpr (hpoint x hx))
      exact Finset.prod_nonneg fun i hi => (ghostWeight_pos (hν i) (x i)).le
    _ ≤ _ := by
      simpa only [abs_abs, g, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (norm_nonneg _)] using hbound

/-- In particular, arbitrary complex masks of modulus at most one preserve
the ghost memory estimate on every finite occupancy cutoff. -/
theorem ghostMemory_masked_l2_sq_le {ι : Type*} [Fintype ι] {B : ℕ}
    (S : Finset (ι → Fin (B + 1))) (A D C ν v : ι → ℝ)
    (hA : ∀ i, 0 ≤ A i) (hν : ∀ i, 0 < ν i) (hv : ∀ i, 0 < v i)
    (hD : ∀ i, A i + |D i| / v i ≤ 1)
    (hC : ∀ i, A i + |C i| / v i ≤ 1)
    (θ : (ι → Fin (B + 1)) → (ι → Fin (B + 1)) → ℂ)
    (hθ : ∀ x ∈ S, ∀ y ∈ S, ‖θ x y‖ ≤ 1)
    (f : (ι → Fin (B + 1)) → ℂ) :
    (∑ x ∈ S, ghostMemoryWeight ν x *
      ‖∑ y ∈ S, (θ x y * ghostMemoryKernel A D C ν x y) * f y‖ ^ 2) ≤
      Real.exp (∑ i, (|C i| + |D i|) * ν i * v i) *
        ∑ y ∈ S, ghostMemoryWeight ν y * ‖f y‖ ^ 2 := by
  apply ghostMemory_dominated_l2_sq_le S A D C ν v hA hν hv hD hC
    (fun x y => θ x y * ghostMemoryKernel A D C ν x y) _ f
  intro x hx y hy
  calc
    _ = ‖θ x y‖ * ‖ghostMemoryKernel A D C ν x y‖ := norm_mul _ _
    _ ≤ 1 * ‖ghostMemoryKernel A D C ν x y‖ :=
      mul_le_mul_of_nonneg_right (hθ x hx y hy) (norm_nonneg _)
    _ ≤ _ := by
      simpa only [one_mul] using
        ghostMemoryKernel_norm_le_majorant A D C ν hA (fun i => (hν i).le) x y
end

section
open Finset
/-- Translate pending residues by `r ↦ r - t`; leave both vacuum states fixed. -/
def ghostMemoryShift {R : Type*} [AddGroup R] (t : R) :
    GhostFiniteState R ≃ GhostFiniteState R where
  toFun
    | none => none
    | some none => some none
    | some (some r) => some (some (r - t))
  invFun
    | none => none
    | some none => some none
    | some (some r) => some (some (r + t))
  left_inv := by intro x; rcases x with _ | (_ | r) <;> simp
  right_inv := by intro x; rcases x with _ | (_ | r) <;> simp

theorem ghostMemoryShift_unborn {R : Type*} [AddGroup R] (t : R) :
    ghostMemoryShift t (none : GhostFiniteState R) = none := rfl

theorem ghostMemoryShift_completed {R : Type*} [AddGroup R] (t : R) :
    ghostMemoryShift t (some none : GhostFiniteState R) = some none := rfl

theorem ghostMemoryShift_pending {R : Type*} [AddGroup R] (t r : R) :
    ghostMemoryShift t (some (some r)) = some (some (r - t)) := rfl

theorem ghostMemoryShift_zero {R : Type*} [AddGroup R]
    (x : GhostFiniteState R) : ghostMemoryShift (0 : R) x = x := by
  rcases x with _ | (_ | r) <;> simp [ghostMemoryShift]

/-- Composition works in an arbitrary additive group, with the displayed order. -/
theorem ghostMemoryShift_add {R : Type*} [AddGroup R] (t u : R)
    (x : GhostFiniteState R) :
    ghostMemoryShift (t + u) x = ghostMemoryShift t (ghostMemoryShift u x) := by
  rcases x with _ | (_ | r) <;> simp [ghostMemoryShift, sub_add_eq_sub_sub_swap]

theorem ghostMemoryShift_symm {R : Type*} [AddGroup R] (t : R)
    (x : GhostFiniteState R) :
    (ghostMemoryShift t).symm x = ghostMemoryShift (-t) x := by
  rcases x with _ | (_ | r) <;> simp [ghostMemoryShift]

/-- Active and inactive kernels are equivariant under translation. -/
theorem activeGhostFiniteKernel_translation {R : Type*} [AddGroup R] [DecidableEq R]
    (a : Bool) (h t : R) (η β : ℝ) (x y : GhostFiniteState R) :
    activeGhostFiniteKernel a h η β x y =
      activeGhostFiniteKernel a (h - t) η β (ghostMemoryShift t x) (ghostMemoryShift t y) := by
  cases a <;> rcases x with _ | (_ | r) <;> rcases y with _ | (_ | s) <;>
    simp [activeGhostFiniteKernel, ghostFiniteKernel, ghostMemoryShift]

/-- In memory coordinates relative to the visited position, the hit residue is zero. -/
theorem activeGhostFiniteKernel_relative_zero {R : Type*} [AddGroup R] [DecidableEq R]
    (a : Bool) (h : R) (η β : ℝ) (x y : GhostFiniteState R) :
    activeGhostFiniteKernel a h η β x y =
      activeGhostFiniteKernel a 0 η β (ghostMemoryShift h x) (ghostMemoryShift h y) := by
  simpa only [sub_self] using activeGhostFiniteKernel_translation a h h η β x y

/-- A translated sum over memory states has exactly the same counting weight. -/
theorem ghostMemoryShift_sum {R : Type*} [AddGroup R] [Fintype R]
    (t : R) (f : GhostFiniteState R → ℝ) :
    (∑ x, f (ghostMemoryShift t x)) = ∑ x, f x := by
  exact Equiv.sum_comp (ghostMemoryShift t) f

theorem ghostFiniteInitial_translation {R : Type*} [AddGroup R]
    (t : R) (x : GhostFiniteState R) :
    ghostFiniteInitial (ghostMemoryShift t x) = ghostFiniteInitial x := by
  rcases x with _ | (_ | r) <;> rfl

/-- A common change of origin commutes with the entire finite memory evolution. -/
theorem activeGhostFiniteAction_translation {R : Type*} [AddGroup R] [Fintype R]
    [DecidableEq R] (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ)
    (β : ℝ) (t : R) (n : ℕ) (x : GhostFiniteState R) :
    finitePathAction (fun j => activeGhostFiniteKernel (a j) (h j) (η j) β)
      ghostFiniteInitial n x =
    finitePathAction (fun j => activeGhostFiniteKernel (a j) (h j - t) (η j) β)
      ghostFiniteInitial n (ghostMemoryShift t x) := by
  induction n generalizing x with
  | zero => simp [finitePathAction, ghostFiniteInitial_translation]
  | succ n ih =>
    simp only [finitePathAction]
    calc
      _ = ∑ y, activeGhostFiniteKernel (a n) (h n - t) (η n) β
          (ghostMemoryShift t x) (ghostMemoryShift t y) *
          finitePathAction (fun j => activeGhostFiniteKernel (a j) (h j - t) (η j) β)
            ghostFiniteInitial n (ghostMemoryShift t y) := by
        apply sum_congr rfl
        intro y _
        rw [ih, activeGhostFiniteKernel_translation (a n) (h n) t]
      _ = _ := ghostMemoryShift_sum t (fun y =>
        activeGhostFiniteKernel (a n) (h n - t) (η n) β (ghostMemoryShift t x) y *
          finitePathAction (fun j => activeGhostFiniteKernel (a j) (h j - t) (η j) β)
            ghostFiniteInitial n y)
end

section
open Finset
/-- Every tuple for finite pairwise-coprime nonzero moduli has an integer lift. -/
theorem independent_residues_integer_lift {ι : Type*} [Fintype ι] [DecidableEq ι]
    (m : ι → ℕ) [∀ i, NeZero (m i)]
    (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (r : ∀ i, ZMod (m i)) :
    ∃ n : ℤ, ∀ i, (n : ZMod (m i)) = r i := by
  obtain ⟨k, hk⟩ := (lifespan_crt_bijective m hc).surjective r
  refine ⟨(k.val : ℤ), ?_⟩
  intro i
  simpa only [Int.cast_natCast] using congrFun hk i

/-- Casting any translated lift gives the translated tuple coordinate. -/
theorem integer_lift_cast_add {ι : Type*} (m : ι → ℕ)
    (r : ∀ i, ZMod (m i)) {n : ℤ}
    (hn : ∀ i, (n : ZMod (m i)) = r i) (d : ℤ) (i : ι) :
    ((n + d : ℤ) : ZMod (m i)) = r i + (d : ZMod (m i)) := by
  rw [Int.cast_add, hn i]

/-- Divisibility of every translated lift is exactly vanishing of its residue. -/
theorem integer_lift_dvd_add_iff {ι : Type*} (m : ι → ℕ)
    (r : ∀ i, ZMod (m i)) {n : ℤ}
    (hn : ∀ i, (n : ZMod (m i)) = r i) (d : ℤ) (i : ι) :
    (m i : ℤ) ∣ n + d ↔ r i + (d : ZMod (m i)) = 0 := by
  rw [← ZMod.intCast_zmod_eq_zero_iff_dvd, integer_lift_cast_add m r hn]

/-- A single integer lift simultaneously represents all translated divisibility
tests, so bounds quantified over integer states transfer to residue states. -/
theorem independent_residues_translated_integer_lift
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (m : ι → ℕ) [∀ i, NeZero (m i)]
    (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (r : ∀ i, ZMod (m i)) :
    ∃ n : ℤ, (∀ i, (n : ZMod (m i)) = r i) ∧
      ∀ (d : ℤ) (i : ι), (m i : ℤ) ∣ n + d ↔ r i + (d : ZMod (m i)) = 0 := by
  obtain ⟨n, hn⟩ := independent_residues_integer_lift m hc r
  exact ⟨n, hn, integer_lift_dvd_add_iff m r hn⟩

/-- Disjoint physical prime groups admit simultaneous integer lifts. Nonzero
modulus instances are derived from the explicit primality hypotheses. -/
theorem physical_residues_integer_lift {G : Type*} [Fintype G]
    {P : G → Finset ℕ}
    (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (r : ∀ p : PhysicalPrime P, ZMod p.2.val) :
    ∃ n : ℤ, ∀ p : PhysicalPrime P, (n : ZMod p.2.val) = r p := by
  classical
  let : ∀ p : PhysicalPrime P, NeZero p.2.val :=
    fun p => ⟨(hprime p.1 p.2.val p.2.property).ne_zero⟩
  exact independent_residues_integer_lift (fun p : PhysicalPrime P => p.2.val)
    (physical_prime_pool_coprime hP hprime) r

/-- The physical lift simultaneously realizes every translated prime hit. -/
theorem physical_residues_translated_integer_lift {G : Type*} [Fintype G]
    {P : G → Finset ℕ}
    (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (r : ∀ p : PhysicalPrime P, ZMod p.2.val) :
    ∃ n : ℤ, (∀ p : PhysicalPrime P, (n : ZMod p.2.val) = r p) ∧
      ∀ (d : ℤ) (p : PhysicalPrime P),
        (p.2.val : ℤ) ∣ n + d ↔ r p + (d : ZMod p.2.val) = 0 := by
  obtain ⟨n, hn⟩ := physical_residues_integer_lift hP hprime r
  exact ⟨n, hn, integer_lift_dvd_add_iff (fun p : PhysicalPrime P => p.2.val) r hn⟩
end

section
open Finset
abbrev PhysicalResidues {G : Type*} (P : G → Finset ℕ) :=
  ∀ p : PhysicalPrime P, ZMod p.2.val

def physicalResiduesOfInt {G : Type*} (P : G → Finset ℕ) (n : ℤ) : PhysicalResidues P :=
  fun _ => n

def physicalTranslateResidues {G : Type*} {P : G → Finset ℕ}
    (r : PhysicalResidues P) (d : ℤ) : PhysicalResidues P := fun p => r p + d

theorem physical_translate_residues_int {G : Type*} (P : G → Finset ℕ) (n d : ℤ) :
    physicalTranslateResidues (physicalResiduesOfInt P n) d = physicalResiduesOfInt P (n + d) := by
  funext p
  exact (Int.cast_add n d).symm

theorem physical_translate_residues_zero {G : Type*} {P : G → Finset ℕ}
    (r : PhysicalResidues P) : physicalTranslateResidues r 0 = r := by
  funext p
  simp [physicalTranslateResidues]

theorem physical_translate_residues_add {G : Type*} {P : G → Finset ℕ}
    (r : PhysicalResidues P) (a b : ℤ) :
    physicalTranslateResidues (physicalTranslateResidues r a) b = physicalTranslateResidues r (a + b) := by
  funext p
  simp [physicalTranslateResidues, add_assoc]

def physicalResidueMarksValid {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (r : PhysicalResidues P) (L : PhysicalMarkLists P J ell) : Prop :=
  ∀ g s, r ⟨g, L g s⟩ = 0

abbrev PhysicalResidueMarksAt {G : Type*} (P : G → Finset ℕ) (J ell : ℕ)
    (r : PhysicalResidues P) := {L : PhysicalMarkLists P J ell // physicalResidueMarksValid r L}

abbrev PhysicalResidueState {G : Type*} (P : G → Finset ℕ) (J ell : ℕ) :=
  Σ r : PhysicalResidues P, PhysicalResidueMarksAt P J ell r

theorem physical_residue_marks_int_iff {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (n : ℤ) (L : PhysicalMarkLists P J ell) :
    physicalResidueMarksValid (physicalResiduesOfInt P n) L ↔
      ∀ g s, ((L g s).val : ℤ) ∣ n := by
  simp only [physicalResidueMarksValid, physicalResiduesOfInt, ZMod.intCast_zmod_eq_zero_iff_dvd]

def physicalResidueMarksIntEquiv {G : Type*} (P : G → Finset ℕ) (J ell : ℕ) (n : ℤ) :
    PhysicalResidueMarksAt P J ell (physicalResiduesOfInt P n) ≃ PhysicalMarksAt P J ell n where
  toFun L := ⟨L.val, (physical_residue_marks_int_iff n L.val).mp L.property⟩
  invFun L := ⟨L.val, (physical_residue_marks_int_iff n L.val).mpr L.property⟩
  left_inv _ := rfl
  right_inv _ := rfl

noncomputable def physicalResidueDivisorPool {G : Type*} (P : G → Finset ℕ)
    (g : G) (r : PhysicalResidues P) : Finset ℕ := by
  classical
  exact (P g).attach.filter (fun p => r ⟨g, p⟩ = 0) |>.image Subtype.val

theorem physical_residue_divisor_pool_int {G : Type*} (P : G → Finset ℕ)
    (g : G) (n : ℤ) :
    physicalResidueDivisorPool P g (physicalResiduesOfInt P n) = physicalDivisorPool P g n := by
  classical
  ext p
  simp only [physicalResidueDivisorPool, mem_image, mem_filter, mem_attach,
    true_and, physicalResiduesOfInt, ZMod.intCast_zmod_eq_zero_iff_dvd, physicalDivisorPool]
  constructor
  · rintro ⟨a, ha, rfl⟩
    exact ⟨a.property, ha⟩
  · rintro ⟨hp, hd⟩
    exact ⟨⟨p, hp⟩, hd, rfl⟩

noncomputable def physicalResidueOmega {G : Type*} (P : G → Finset ℕ)
    (g : G) (r : PhysicalResidues P) : ℕ := (physicalResidueDivisorPool P g r).card

noncomputable def physicalResidueDamping {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (J ell : ℕ) (q : ℝ) (r : PhysicalResidues P) : ℝ :=
  ∏ g, q^(((physicalResidueOmega P g r - (J + ell) : ℕ) : ℝ) / 2)

theorem physical_residue_damping_int {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (J ell : ℕ) (q : ℝ) (n : ℤ) :
    physicalResidueDamping P J ell q (physicalResiduesOfInt P n) = physicalDamping P J ell q n := by
  simp only [physicalResidueDamping, physicalResidueOmega, physical_residue_divisor_pool_int,
    physicalDamping, physicalOmega]

noncomputable def physicalResidueVertexWeight {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (L : PhysicalMarkLists P J ell)
    (q : ℝ) (r : PhysicalResidues P) : ℝ := by
  classical
  exact if physicalResidueMarksValid r L then
    ∏ g, q^(physicalResidueOmega P g r - (J + ell)) else 0

theorem physical_residue_vertex_weight_int {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (L : PhysicalMarkLists P J ell)
    (q : ℝ) (n : ℤ) :
    physicalResidueVertexWeight L q (physicalResiduesOfInt P n) = physicalVertexWeight L q n := by
  simp only [physicalResidueVertexWeight, physical_residue_marks_int_iff, physicalResidueOmega,
    physical_residue_divisor_pool_int, physicalVertexWeight, physicalOmega]
end

section
open Finset Classical
noncomputable def physicalBareStepCoeff {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (n : ℤ) (L R : PhysicalMarkLists P J ell) : ℂ :=
  physicalBareLabeledScalar V patterns C ζ K a L R *
    ((physicalVertexWeight L (Real.sqrt q) n *
      physicalVertexWeight R (Real.sqrt q) (n + physicalBareStep C k a L) : ℝ) : ℂ)

theorem physical_labeled_norm_row_as_marks {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (x : PhysicalState P J ell)
    (positions : Finset ℤ) (hm : x.1 + physicalBareStep C k a x.2.val ∈ positions) :
    (∑ y ∈ physicalCutoff P J ell positions, ‖physicalLabeledCoeff V patterns C q ζ k K a x y‖) =
      ∑ R : PhysicalMarkLists P J ell, ‖physicalBareStepCoeff V patterns C q ζ k K a x.1 x.2.val R‖ := by
  let m := x.1 + physicalBareStep C k a x.2.val
  let F : PhysicalMarkLists P J ell → ℝ := fun R =>
    ‖physicalBareStepCoeff V patterns C q ζ k K a x.1 x.2.val R‖
  have he : ∀ y : PhysicalState P J ell,
      ‖physicalLabeledCoeff V patterns C q ζ k K a x y‖ =
        if y.1 = m then F y.2.val else 0 := by
    intro y
    rw [physical_labeled_vertex_factor V patterns C hq]
    change ‖(if y.1 = m then _ else _)‖ = _
    by_cases h : y.1 = m
    · simp only [h]
      rfl
    · simp only [if_neg h, norm_zero]
  simp only [he]
  rw [physical_cutoff_sum_at, if_pos hm]
  apply physical_marks_sum_all P J ell m F
  intro L h
  dsimp only [m] at h
  simp only [F, physicalBareStepCoeff, physicalVertexWeight, if_neg h,
    mul_zero, Complex.ofReal_zero, norm_zero]

noncomputable def physicalResidueStepCoeff {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (r : PhysicalResidues P)
    (L R : PhysicalMarkLists P J ell) : ℂ :=
  physicalBareLabeledScalar V patterns C ζ K a L R *
    ((physicalResidueVertexWeight L (Real.sqrt q) r *
      physicalResidueVertexWeight R (Real.sqrt q)
        (physicalTranslateResidues r (physicalBareStep C k a L)) : ℝ) : ℂ)

theorem physical_residue_step_coeff_int {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (n : ℤ) (L R : PhysicalMarkLists P J ell) :
    physicalResidueStepCoeff V patterns C q ζ k K a (physicalResiduesOfInt P n) L R =
      physicalBareStepCoeff V patterns C q ζ k K a n L R := by
  simp only [physicalResidueStepCoeff, physical_translate_residues_int,
    physical_residue_vertex_weight_int, physicalBareStepCoeff]

theorem physical_bare_step_coeff_zero {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (n : ℤ) (L R : PhysicalMarkLists P J ell)
    (h : ¬ ∀ g s, ((L g s).val : ℤ) ∣ n) :
    physicalBareStepCoeff V patterns C q ζ k K a n L R = 0 := by
  simp only [physicalBareStepCoeff, physicalVertexWeight, if_neg h,
    zero_mul, Complex.ofReal_zero, mul_zero]

/-- Every bare row has the existing physical bound. The finite cutoff
contains all one-step targets, so this reindexing loses no mass. -/
theorem exists_physical_bare_step_row_bound {q v : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (ell m : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (G : Type) [Fintype G] [DecidableEq G] (P : G → Finset ℕ)
      (J : ℕ) (V : G → ℝ), (∀ g, v ≤ V g) →
      (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) →
      ∀ (I : Type) (patterns : Finset I) (C : I → G → Finset (Fin J)) (B : I → ℝ),
      (∀ i ∈ patterns, ∀ g, (C i g).card ≤ m) → (∀ i ∈ patterns, 0 ≤ B i) →
      ∀ (ζ : I → ℝ) (k : I → ℤ)
        (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ),
        (∀ i ∈ patterns, ∀ L R aux, ‖K i L R aux‖ ≤ B i) →
        letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
        ∀ (n : ℤ) (L : PhysicalMarkLists P J ell),
        (∑ a : PhysicalEdgeLabels P J ell patterns C, ∑ R : PhysicalMarkLists P J ell,
          ‖physicalBareStepCoeff V patterns C q ζ k K a n L R‖) ≤
          (∑ i ∈ patterns, B i) * A^(Fintype.card G) := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_absolute_operator_bounds hq0 hq1 hv ell m
  refine ⟨A, hA, ?_⟩
  intro G _ _ P J V hV hMass I patterns C B hC hB ζ k K hK
  classical
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  intro n L
  by_cases hL : ∀ g s, ((L g s).val : ℤ) ∣ n
  · let x : PhysicalState P J ell := ⟨n, L, hL⟩
    let positions := univ.image (fun a : PhysicalEdgeLabels P J ell patterns C =>
      n + physicalBareStep C k a L)
    have hm : ∀ a : PhysicalEdgeLabels P J ell patterns C,
        x.1 + physicalBareStep C k a x.2.val ∈ positions := by
      intro a
      exact mem_image.mpr ⟨a, mem_univ a, rfl⟩
    have he : (∑ a : PhysicalEdgeLabels P J ell patterns C, ∑ R : PhysicalMarkLists P J ell,
        ‖physicalBareStepCoeff V patterns C q ζ k K a n L R‖) =
        ∑ y ∈ physicalCutoff P J ell positions, physicalAbsoluteOperator V patterns C q ζ k K x y := by
      calc
        _ = ∑ a : PhysicalEdgeLabels P J ell patterns C,
            ∑ y ∈ physicalCutoff P J ell positions,
              ‖physicalLabeledCoeff V patterns C q ζ k K a x y‖ := by
          apply sum_congr rfl
          intro a _
          exact (physical_labeled_norm_row_as_marks V patterns C hq0 ζ k K a x positions (hm a)).symm
        _ = _ := by rw [sum_comm]; simp only [physical_labeled_coefficient_abs_sum]
    rw [he]
    exact (hbound G P J V hV hMass I patterns C ζ k K B hC hB hK x
      (physicalCutoff P J ell positions)).1
  · simp only [physical_bare_step_coeff_zero V patterns C q ζ k K _ n L _ hL,
      norm_zero, sum_const_zero]
    exact mul_nonneg (sum_nonneg hB) (pow_nonneg (zero_le_one.trans hA) _)
end

section
open Finset
abbrev PhysicalBareResidueState {G : Type*} (P : G → Finset ℕ) (J ell : ℕ) :=
  PhysicalResidues P × PhysicalMarkLists P J ell

noncomputable def physicalResidueInitialMass {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (x : PhysicalBareResidueState P J ell) : ℝ := by
  classical
  exact physicalStateMass V J ell * ∏ p : PhysicalPrime P,
    (if p ∈ physicalMarkedPrimes x.2 then (if x.1 p = 0 then (1 : ℝ) else 0) else 1) / (p.2.val : ℝ)

theorem physical_residue_initial_mass_nonneg {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (x : PhysicalBareResidueState P J ell) : 0 ≤ physicalResidueInitialMass V x := by
  classical
  unfold physicalResidueInitialMass
  apply mul_nonneg (physical_state_mass_pos V hV J ell).le
  apply prod_nonneg
  intro p _
  apply div_nonneg
  · split_ifs <;> positivity
  · exact Nat.cast_nonneg _

theorem physical_residue_initial_mass_total {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) :
    (∑ x : PhysicalBareResidueState P J ell, physicalResidueInitialMass V x) ≤ 1 := by
  classical
  rw [Fintype.sum_prod_type, sum_comm]
  simp only [physicalResidueInitialMass, ← mul_sum]
  simpa only [← mul_sum] using (physical_initial_residue_total_mass (J := J) (ell := ell) V hV hMass)

theorem physical_residue_initial_mass_zero {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ)
    (x : PhysicalBareResidueState P J ell) (h : ¬ physicalResidueMarksValid x.1 x.2) :
    physicalResidueInitialMass V x = 0 := by
  classical
  unfold physicalResidueMarksValid at h
  push Not at h
  obtain ⟨g, s, hs⟩ := h
  have hm : (⟨g, x.2 g s⟩ : PhysicalPrime P) ∈ physicalMarkedPrimes x.2 := by
    rw [mem_physical_marked_primes, mem_physical_group_marks]
    exact ⟨s, rfl⟩
  unfold physicalResidueInitialMass
  have hz : (∏ p : PhysicalPrime P,
      (if p ∈ physicalMarkedPrimes x.2 then (if x.1 p = 0 then (1 : ℝ) else 0) else 1) / (p.2.val : ℝ)) = 0 := by
    apply prod_eq_zero (mem_univ (⟨g, x.2 g s⟩ : PhysicalPrime P))
    simp only [if_pos hm, if_neg hs, zero_div]
  rw [hz, mul_zero]
end

section
open Finset
noncomputable def deterministicTargetKernel {R M A : Type*}
    (step : A → R → M → R) (weight : A → R → M → M → ℂ)
    (a : A) (x y : R × M) : ℂ := by
  classical
  exact if y.1 = step a x.1 x.2 then weight a x.1 x.2 y.2 else 0

theorem deterministic_target_norm_row {R M A : Type*}
    [Fintype R] [Fintype M] [Fintype A]
    (step : A → R → M → R) (weight : A → R → M → M → ℂ)
    (x : R × M) :
    (∑ y : R × M, ∑ a : A, ‖deterministicTargetKernel step weight a x y‖) =
      ∑ a : A, ∑ m : M, ‖weight a x.1 x.2 m‖ := by
  classical
  rw [sum_comm]
  apply sum_congr rfl
  intro a _
  rw [Fintype.sum_prod_type]
  simp [deterministicTargetKernel, apply_ite]

theorem deterministic_target_action {R M A : Type*}
    [Fintype R] [Fintype M] [Fintype A]
    (step : A → R → M → R) (weight : A → R → M → M → ℂ)
    (x : R × M) (f : R × M → ℂ) :
    (∑ y : R × M, ∑ a : A, deterministicTargetKernel step weight a x y * f y) =
      ∑ a : A, ∑ m : M, weight a x.1 x.2 m * f (step a x.1 x.2, m) := by
  classical
  rw [sum_comm]
  apply sum_congr rfl
  intro a _
  rw [Fintype.sum_prod_type]
  simp [deterministicTargetKernel, ite_mul]
end

section
open Finset Classical
theorem physical_residues_of_int_surjective {G : Type*} [Fintype G]
    {P : G → Finset ℕ} (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime) : Function.Surjective (physicalResiduesOfInt P) := by
  intro r
  obtain ⟨n, hn⟩ := physical_residues_integer_lift hP hprime r
  exact ⟨n, funext hn⟩

noncomputable def physicalResidueLabeledCoeff {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (x y : PhysicalBareResidueState P J ell) : ℂ :=
  deterministicTargetKernel (fun a r L => physicalTranslateResidues r (physicalBareStep C k a L))
    (physicalResidueStepCoeff V patterns C q ζ k K) a x y

theorem physical_residue_labeled_norm_row {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : G → ℝ) (patterns : Finset I) (C : I → G → Finset (Fin J))
    (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    ∀ x : PhysicalBareResidueState P J ell,
    (∑ y : PhysicalBareResidueState P J ell, ∑ a : PhysicalEdgeLabels P J ell patterns C,
      ‖physicalResidueLabeledCoeff V patterns C q ζ k K a x y‖) =
      ∑ a : PhysicalEdgeLabels P J ell patterns C, ∑ R : PhysicalMarkLists P J ell,
        ‖physicalResidueStepCoeff V patterns C q ζ k K a x.1 x.2 R‖ := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  intro x
  exact deterministic_target_norm_row _ _ x

theorem physical_residue_row_bound_of_lift {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : G → ℝ) (patterns : Finset I) (C : I → G → Finset (Fin J))
    (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (hlift : ∀ r : PhysicalResidues P, ∃ n : ℤ, physicalResiduesOfInt P n = r) (H : ℝ) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    (∀ (n : ℤ) (L : PhysicalMarkLists P J ell),
      (∑ a : PhysicalEdgeLabels P J ell patterns C, ∑ R : PhysicalMarkLists P J ell,
        ‖physicalBareStepCoeff V patterns C q ζ k K a n L R‖) ≤ H) →
    ∀ x : PhysicalBareResidueState P J ell,
      (∑ y : PhysicalBareResidueState P J ell, ∑ a : PhysicalEdgeLabels P J ell patterns C,
        ‖physicalResidueLabeledCoeff V patterns C q ζ k K a x y‖) ≤ H := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  intro hrow x
  rw [physical_residue_labeled_norm_row]
  obtain ⟨n, hn⟩ := hlift x.1
  rw [← hn]
  simp only [physical_residue_step_coeff_int]
  exact hrow n x.2

/-- The full independent-residue operator has the same absolute row
bound as the physical operator. Norms are taken before summing labels. -/
theorem exists_physical_residue_operator_row_bound {q v : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (ell m : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (G : Type) [Fintype G] [DecidableEq G] (P : G → Finset ℕ)
      [∀ p : PhysicalPrime P, NeZero p.2.val],
      Pairwise (fun g h => Disjoint (P g) (P h)) →
      (∀ g p, p ∈ P g → p.Prime) →
      ∀ (J : ℕ) (V : G → ℝ), (∀ g, v ≤ V g) →
      (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) →
      ∀ (I : Type) (patterns : Finset I) (C : I → G → Finset (Fin J)) (B : I → ℝ),
      (∀ i ∈ patterns, ∀ g, (C i g).card ≤ m) → (∀ i ∈ patterns, 0 ≤ B i) →
      ∀ (ζ : I → ℝ) (k : I → ℤ)
        (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ),
        (∀ i ∈ patterns, ∀ L R aux, ‖K i L R aux‖ ≤ B i) →
        letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
        ∀ x : PhysicalBareResidueState P J ell,
        (∑ y : PhysicalBareResidueState P J ell, ∑ a : PhysicalEdgeLabels P J ell patterns C,
          ‖physicalResidueLabeledCoeff V patterns C q ζ k K a x y‖) ≤
          (∑ i ∈ patterns, B i) * A^(Fintype.card G) := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_bare_step_row_bound hq0 hq1 hv ell m
  refine ⟨A, hA, ?_⟩
  intro G _ _ P _ hP hprime J V hV hMass I patterns C B hC hB ζ k K hK
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  exact physical_residue_row_bound_of_lift V patterns C q ζ k K
    (physical_residues_of_int_surjective hP hprime) _
    (hbound G P J V hV hMass I patterns C B hC hB ζ k K hK)

/-- The normalized independent-residue law converts a uniform absolute
row bound into a bound for all labeled paths, with no cancellation assumed. -/
theorem physical_residue_averaged_path_bound {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (patterns : Finset I) (C : I → G → Finset (Fin J))
    (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (H : ℝ) (hH : 0 ≤ H) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    (∀ j (x : PhysicalBareResidueState P J ell),
      (∑ y : PhysicalBareResidueState P J ell, ∑ a : PhysicalEdgeLabels P J ell patterns C,
        ‖physicalResidueLabeledCoeff V patterns C q (ζ j) (k j) (K j) a x y‖) ≤ H) →
    ∀ terminal : PhysicalBareResidueState P J ell → PhysicalBareResidueState P J ell → ℂ,
    (∀ x y, ‖terminal x y‖ ≤ 1) → ∀ n : ℕ,
    (∑ x : PhysicalBareResidueState P J ell, physicalResidueInitialMass V x *
      ∑ p : Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalBareResidueState P J ell,
        ‖labeledPathTerm (fun j a u v => physicalResidueLabeledCoeff V patterns C q (ζ j) (k j) (K j) a u v)
          (terminal x) n x p‖) ≤ H^n := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  intro hrow terminal ht n
  exact averaged_absolute_labeled_path_bound _ terminal (physicalResidueInitialMass V) hH hrow ht
    (physical_residue_initial_mass_nonneg V hV) (physical_residue_initial_mass_total V hV hMass) n
end

section
open Finset
theorem physical_residue_vertex_path_factorization {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (labels : ℕ → PhysicalMarkLists P J ell) (visits : Finset ℕ)
    (offset : ℕ → ℤ) (q : ℕ → ℝ) (r : PhysicalResidues P) :
    (∏ j ∈ visits, physicalResidueVertexWeight (labels j) (q j)
      (physicalTranslateResidues r (offset j))) =
      ∏ p : PhysicalPrime P, activeResidueWeight visits
        (visits.filter (fun j => p ∈ physicalMarkedPrimes (labels j)))
        (fun j => -(offset j : ZMod p.2.val)) (fun j => 1 - q j) (r p) := by
  obtain ⟨n, rfl⟩ := physical_residues_of_int_surjective hP hprime r
  simpa only [physical_translate_residues_int, physical_residue_vertex_weight_int,
    physicalResiduesOfInt] using physical_vertex_path_factorization labels visits offset q n

/-- The whole finite residue-vector expectation equals the product of
local expectations used by the existing uniform replacement theorem. -/
theorem physical_residue_vertex_expectation {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (labels : ℕ → PhysicalMarkLists P J ell) (visits : Finset ℕ)
    (offset : ℕ → ℤ) (q : ℕ → ℝ) :
    (∑ r : PhysicalResidues P, (∏ p : PhysicalPrime P, 1 / (p.2.val : ℝ)) *
      ∏ j ∈ visits, physicalResidueVertexWeight (labels j) (q j)
        (physicalTranslateResidues r (offset j))) =
      poolPathResidueExpectation (fun p : PhysicalPrime P => p.2.val) univ visits
        (fun p => visits.filter (fun j => p ∈ physicalMarkedPrimes (labels j)))
        (fun p j => -(offset j : ZMod p.2.val)) (fun j => 1 - q j) := by
  classical
  simp only [physical_residue_vertex_path_factorization hP hprime]
  let f := fun (p : PhysicalPrime P) (a : ZMod p.2.val) =>
    activeResidueWeight visits (visits.filter (fun j => p ∈ physicalMarkedPrimes (labels j)))
      (fun j => -(offset j : ZMod p.2.val)) (fun j => 1 - q j) a
  change (∑ r : PhysicalResidues P, (∏ p : PhysicalPrime P, 1 / (p.2.val : ℝ)) *
    ∏ p : PhysicalPrime P, f p (r p)) = ∏ p : PhysicalPrime P, (∑ a, f p a) / (p.2.val : ℝ)
  have he : ∀ r : PhysicalResidues P,
      (∏ p : PhysicalPrime P, 1 / (p.2.val : ℝ)) * (∏ p : PhysicalPrime P, f p (r p)) =
        ∏ p : PhysicalPrime P, f p (r p) / (p.2.val : ℝ) := by
    intro r
    rw [← prod_mul_distrib]
    apply prod_congr rfl
    intro p _
    ring
  simp only [he]
  simpa only [← sum_div] using
    (Fintype.prod_sum (fun (p : PhysicalPrime P) (a : ZMod p.2.val) =>
      f p a / (p.2.val : ℝ))).symm
end

section
open Finset
theorem physical_residue_marks_valid_iff_marked {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (r : PhysicalResidues P) (L : PhysicalMarkLists P J ell) :
    physicalResidueMarksValid r L ↔ ∀ p ∈ physicalMarkedPrimes L, r p = 0 := by
  constructor
  · intro h p hp
    rcases p with ⟨g, p⟩
    obtain ⟨s, hs⟩ := (mem_physical_group_marks L g p.val).mp
      ((mem_physical_marked_primes L ⟨g, p⟩).mp hp)
    have he : L g s = p := Subtype.ext hs
    rw [← he]
    exact h g s
  · intro h g s
    apply h ⟨g, L g s⟩
    rw [mem_physical_marked_primes, mem_physical_group_marks]
    exact ⟨s, rfl⟩

theorem physical_residue_initial_mass_of_valid {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ)
    (r : PhysicalResidues P) (L : PhysicalMarkLists P J ell)
    (h : physicalResidueMarksValid r L) :
    physicalResidueInitialMass V (r, L) =
      physicalStateMass V J ell * ∏ p : PhysicalPrime P, 1 / (p.2.val : ℝ) := by
  classical
  unfold physicalResidueInitialMass
  congr 1
  apply prod_congr rfl
  intro p _
  by_cases hp : p ∈ physicalMarkedPrimes L
  · have hr := (physical_residue_marks_valid_iff_marked r L).mp h p hp
    simp only [hp, hr, if_true]
  · simp only [hp, if_false]

/-- A function supported on valid marked states can be averaged against the
uniform residue law, with the constant state mass outside both finite sums. -/
theorem physical_residue_initial_mass_sum_of_supported
    {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : G → ℝ) (F : PhysicalResidues P → PhysicalMarkLists P J ell → ℝ)
    (hF : ∀ r L, ¬ physicalResidueMarksValid r L → F r L = 0) :
    (∑ x : PhysicalBareResidueState P J ell, physicalResidueInitialMass V x * F x.1 x.2) =
      physicalStateMass V J ell * ∑ L : PhysicalMarkLists P J ell,
        ∑ r : PhysicalResidues P, (∏ p : PhysicalPrime P, 1 / (p.2.val : ℝ)) * F r L := by
  classical
  have hpoint (r : PhysicalResidues P) (L : PhysicalMarkLists P J ell) :
      physicalResidueInitialMass V (r, L) * F r L =
        physicalStateMass V J ell * ((∏ p : PhysicalPrime P, 1 / (p.2.val : ℝ)) * F r L) := by
    by_cases h : physicalResidueMarksValid r L
    · rw [physical_residue_initial_mass_of_valid V r L h, mul_assoc]
    · rw [hF r L h, mul_zero, mul_zero, mul_zero]
  rw [Fintype.sum_prod_type, sum_comm]
  simp only [hpoint, ← mul_sum]

theorem physical_residue_vertex_weight_nonneg {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (L : PhysicalMarkLists P J ell)
    {q : ℝ} (hq : 0 ≤ q) (r : PhysicalResidues P) :
    0 ≤ physicalResidueVertexWeight L q r := by
  classical
  unfold physicalResidueVertexWeight
  split_ifs
  · exact prod_nonneg (fun _ _ => pow_nonneg hq _)
  · exact le_rfl

theorem physical_residue_vertex_weight_zero_of_invalid {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (L : PhysicalMarkLists P J ell)
    (q : ℝ) (r : PhysicalResidues P) (h : ¬ physicalResidueMarksValid r L) :
    physicalResidueVertexWeight L q r = 0 := by
  classical
  simp only [physicalResidueVertexWeight, if_neg h]

theorem physical_residue_vertex_product_nonneg {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (labels : ℕ → PhysicalMarkLists P J ell) (visits : Finset ℕ)
    (offset : ℕ → ℤ) (q : ℕ → ℝ) (hq : ∀ j ∈ visits, 0 ≤ q j)
    (r : PhysicalResidues P) :
    0 ≤ ∏ j ∈ visits, physicalResidueVertexWeight (labels j) (q j)
      (physicalTranslateResidues r (offset j)) := by
  exact prod_nonneg (fun j hj => physical_residue_vertex_weight_nonneg
    (labels j) (hq j hj) (physicalTranslateResidues r (offset j)))
end

section
open Finset
theorem physical_endpoint_schedule_nonneg {q : ℝ} (hq : 0 ≤ q) (edges j : ℕ) :
    0 ≤ physicalEndpointSchedule q edges j := by
  unfold physicalEndpointSchedule
  split_ifs
  · exact Real.sqrt_nonneg q
  · exact hq

noncomputable def physicalFiniteResidueExpectation {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ} {patterns : Finset I}
    (C : I → G → Finset (Fin J)) (q : ℝ) (k : ℕ → I → ℤ)
    (N : ℕ) (L₀ : PhysicalMarkLists P J ell)
    (p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) : ℝ :=
  poolPathResidueExpectation (fun p : PhysicalPrime P => p.2.val) univ (range (N + 2))
    (fun a => (range (N + 2)).filter (fun j => a ∈ physicalMarkedPrimes (finitePathMarks L₀ p j)))
    (fun a j => -(physicalBareOffset C k (finitePathLabels p) (finitePathMarks L₀ p) (N + 1) j : ZMod a.2.val))
    (fun j => 1 - physicalEndpointSchedule q (N + 1) j)

theorem physical_finite_residue_expectation_nonneg {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ} {patterns : Finset I}
    (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q) (k : ℕ → I → ℤ)
    (N : ℕ) (L₀ : PhysicalMarkLists P J ell)
    (p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) :
    0 ≤ physicalFiniteResidueExpectation C q k N L₀ p := by
  unfold physicalFiniteResidueExpectation
  rw [← physical_residue_vertex_expectation hP hprime]
  apply sum_nonneg
  intro r _
  apply mul_nonneg
  · exact prod_nonneg (fun p _ => div_nonneg zero_le_one (Nat.cast_nonneg _))
  · exact physical_residue_vertex_product_nonneg _ _ _ _
      (fun j _ => physical_endpoint_schedule_nonneg hq (N + 1) j) r

theorem physical_bare_return_scalar_norm_le {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (edges : ℕ) :
    ‖physicalBareReturnScalar V patterns C ζ k K a L edges‖ ≤
      ‖physicalBareWalkScalar V patterns C ζ K a L edges‖ := by
  unfold physicalBareReturnScalar
  split_ifs
  · exact le_rfl
  · simpa only [norm_zero] using norm_nonneg (physicalBareWalkScalar V patterns C ζ K a L edges)
end

section
open Finset
def deterministicBarePathTerm {R M A S : Type*} [Mul S]
    (step : ℕ → A → R → M → R) (weight : ℕ → A → R → M → M → S)
    (terminal : R → M → S) : (n : ℕ) → R → M → (Fin n → A × M) → S
  | 0, r, m, _ => terminal r m
  | n + 1, r, m, p => weight n (p 0).1 r m (p 0).2 *
      deterministicBarePathTerm step weight terminal n
        (step n (p 0).1 r m) (p 0).2 (Fin.tail p)

theorem norm_deterministic_bare_path_term {R M A : Type*}
    (step : ℕ → A → R → M → R) (weight : ℕ → A → R → M → M → ℂ)
    (terminal : R → M → ℂ) (n : ℕ) (r : R) (m : M) (p : Fin n → A × M) :
    ‖deterministicBarePathTerm step weight terminal n r m p‖ =
      deterministicBarePathTerm step (fun j a r m t => ‖weight j a r m t‖)
        (fun r m => ‖terminal r m‖) n r m p := by
  induction n generalizing r m with
  | zero => rfl
  | succ n ih => simp only [deterministicBarePathTerm, norm_mul, ih]

theorem deterministic_target_path_sum {R M A : Type*}
    [Fintype R] [Fintype M] [Fintype A]
    (step : ℕ → A → R → M → R) (weight : ℕ → A → R → M → M → ℂ)
    (terminal : R → M → ℂ) (n : ℕ) (r : R) (m : M) :
    (∑ p : Fin n → A × (R × M),
      labeledPathTerm (fun j => deterministicTargetKernel (step j) (weight j))
        (fun x => terminal x.1 x.2) n (r, m) p) =
      ∑ p : Fin n → A × M, deterministicBarePathTerm step weight terminal n r m p := by
  classical
  induction n generalizing r m with
  | zero => simp [labeledPathTerm, deterministicBarePathTerm]
  | succ n ih =>
    calc
      _ = ∑ z : A × (R × M), ∑ p : Fin n → A × (R × M),
          deterministicTargetKernel (step n) (weight n) z.1 (r, m) z.2 *
            labeledPathTerm (fun j => deterministicTargetKernel (step j) (weight j))
              (fun x => terminal x.1 x.2) n z.2 p := by
        rw [← Equiv.sum_comp (Fin.consEquiv (fun _ : Fin (n + 1) => A × (R × M)))
          (fun p => labeledPathTerm
            (fun j => deterministicTargetKernel (step j) (weight j))
            (fun x => terminal x.1 x.2) (n + 1) (r, m) p), Fintype.sum_prod_type]
        rfl
      _ = ∑ z : A × (R × M),
          deterministicTargetKernel (step n) (weight n) z.1 (r, m) z.2 *
            ∑ p : Fin n → A × M,
              deterministicBarePathTerm step weight terminal n z.2.1 z.2.2 p := by
        apply sum_congr rfl
        intro z _
        rw [← mul_sum]
        exact congrArg (fun s => deterministicTargetKernel (step n) (weight n) z.1 (r, m) z.2 * s)
          (ih z.2.1 z.2.2)
      _ = ∑ z : A × M, ∑ p : Fin n → A × M,
          weight n z.1 r m z.2 *
            deterministicBarePathTerm step weight terminal n (step n z.1 r m) z.2 p := by
        simp [Fintype.sum_prod_type, deterministicTargetKernel, ite_mul, mul_sum]
      _ = _ := by
        symm
        rw [← Equiv.sum_comp (Fin.consEquiv (fun _ : Fin (n + 1) => A × M))
          (fun p => deterministicBarePathTerm step weight terminal (n + 1) r m p),
          Fintype.sum_prod_type]
        rfl

theorem deterministic_target_absolute_path_sum {R M A : Type*}
    [Fintype R] [Fintype M] [Fintype A]
    (step : ℕ → A → R → M → R) (weight : ℕ → A → R → M → M → ℂ)
    (terminal : R → M → ℂ) (n : ℕ) (r : R) (m : M) :
    (∑ p : Fin n → A × (R × M),
      ‖labeledPathTerm (fun j => deterministicTargetKernel (step j) (weight j))
        (fun x => terminal x.1 x.2) n (r, m) p‖) =
      ∑ p : Fin n → A × M, ‖deterministicBarePathTerm step weight terminal n r m p‖ := by
  classical
  induction n generalizing r m with
  | zero => simp [labeledPathTerm, deterministicBarePathTerm]
  | succ n ih =>
    calc
      _ = ∑ z : A × (R × M), ∑ p : Fin n → A × (R × M),
          ‖deterministicTargetKernel (step n) (weight n) z.1 (r, m) z.2‖ *
            ‖labeledPathTerm (fun j => deterministicTargetKernel (step j) (weight j))
              (fun x => terminal x.1 x.2) n z.2 p‖ := by
        rw [← Equiv.sum_comp (Fin.consEquiv (fun _ : Fin (n + 1) => A × (R × M)))
          (fun p => ‖labeledPathTerm
            (fun j => deterministicTargetKernel (step j) (weight j))
            (fun x => terminal x.1 x.2) (n + 1) (r, m) p‖), Fintype.sum_prod_type]
        apply sum_congr rfl
        intro z _
        apply sum_congr rfl
        intro p _
        exact norm_mul _ _
      _ = ∑ z : A × (R × M),
          ‖deterministicTargetKernel (step n) (weight n) z.1 (r, m) z.2‖ *
            ∑ p : Fin n → A × M,
              ‖deterministicBarePathTerm step weight terminal n z.2.1 z.2.2 p‖ := by
        apply sum_congr rfl
        intro z _
        rw [← mul_sum]
        exact congrArg (fun s => ‖deterministicTargetKernel (step n) (weight n) z.1 (r, m) z.2‖ * s)
          (ih z.2.1 z.2.2)
      _ = ∑ z : A × M, ∑ p : Fin n → A × M,
          ‖weight n z.1 r m z.2‖ *
            ‖deterministicBarePathTerm step weight terminal n (step n z.1 r m) z.2 p‖ := by
        simp [Fintype.sum_prod_type, deterministicTargetKernel, apply_ite, ite_mul, mul_sum]
      _ = _ := by
        symm
        rw [← Equiv.sum_comp (Fin.consEquiv (fun _ : Fin (n + 1) => A × M))
          (fun p => ‖deterministicBarePathTerm step weight terminal (n + 1) r m p‖),
          Fintype.sum_prod_type]
        apply sum_congr rfl
        intro z _
        apply sum_congr rfl
        intro p _
        exact norm_mul _ _
end

section
open Finset
noncomputable def physicalResidueBarePathTerm {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (N : ℕ) (r : PhysicalResidues P) (L₀ : PhysicalMarkLists P J ell)
    (p : Fin N → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) : ℂ :=
  deterministicBarePathTerm
    (fun j a r L => physicalTranslateResidues r (physicalBareStep C (k j) a L))
    (fun j => physicalResidueStepCoeff V patterns C q (ζ j) (k j) (K j))
    (fun _ _ => (1 : ℂ)) N r L₀ p

theorem physical_residue_bare_path_term_zero_of_invalid
    {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (N : ℕ) (r : PhysicalResidues P) (L₀ : PhysicalMarkLists P J ell)
    (p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)
    (hL : ¬ physicalResidueMarksValid r L₀) :
    physicalResidueBarePathTerm V patterns C q ζ k K (N + 1) r L₀ p = 0 := by
  simp only [physicalResidueBarePathTerm, deterministicBarePathTerm,
    physicalResidueStepCoeff, physicalResidueVertexWeight, if_neg hL,
    zero_mul, Complex.ofReal_zero, mul_zero]

/-- A deterministic residue path starting at an integer residue vector is
exactly the corresponding unrestricted physical path. -/
theorem physical_residue_path_term_int {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (t : ℕ) (n : ℤ) (L : PhysicalMarkLists P J ell)
    (p : Fin t → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) :
    deterministicBarePathTerm
      (fun j a r L => physicalTranslateResidues r (physicalBareStep C (k j) a L))
      (fun j => physicalResidueStepCoeff V patterns C q (ζ j) (k j) (K j))
      (fun _ _ => (1 : ℂ)) t (physicalResiduesOfInt P n) L p =
    translatedPathTerm (fun j => physicalBareStep C (k j))
      (fun j => physicalBareKernel V patterns C q (ζ j) (k j) (K j))
      (fun _ _ => (1 : ℂ)) t n L p := by
  induction t generalizing n L with
  | zero => rfl
  | succ t ih =>
    simp only [deterministicBarePathTerm, translatedPathTerm,
      physical_translate_residues_int, physical_residue_step_coeff_int, ih]
    rfl

/-- Positive-length residue paths at integer sources factor into the
unrestricted walk scalar and the scheduled residue vertex product. -/
theorem physical_residue_path_term_factor_int {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (N : ℕ) (n : ℤ) :
    deterministicBarePathTerm
      (fun j a r L => physicalTranslateResidues r (physicalBareStep C (k j) a L))
      (fun j => physicalResidueStepCoeff V patterns C q (ζ j) (k j) (K j))
      (fun _ _ => (1 : ℂ)) (N + 1) (physicalResiduesOfInt P n) (L 0)
      (fun j : Fin (N + 1) => (a j.val, L (j.val + 1))) =
        physicalBareWalkScalar V patterns C ζ K a L (N + 1) *
          ((∏ j ∈ range (N + 2), physicalResidueVertexWeight (L j)
            (physicalEndpointSchedule q (N + 1) j)
            (physicalTranslateResidues (physicalResiduesOfInt P n)
              (physicalBareOffset C k a L (N + 1) j)) : ℝ) : ℂ) := by
  rw [physical_residue_path_term_int]
  simpa only [physical_translate_residues_int, physical_residue_vertex_weight_int, mul_one] using
    physical_free_path_term_factor V patterns C hq ζ k K (fun _ _ => (1 : ℂ)) a L N n

/-- CRT transfers the physical path factorization to every independent
residue vector, simultaneously along the entire path. -/
theorem physical_residue_path_term_factor {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (N : ℕ) (r : PhysicalResidues P) :
    deterministicBarePathTerm
      (fun j a r L => physicalTranslateResidues r (physicalBareStep C (k j) a L))
      (fun j => physicalResidueStepCoeff V patterns C q (ζ j) (k j) (K j))
      (fun _ _ => (1 : ℂ)) (N + 1) r (L 0)
      (fun j : Fin (N + 1) => (a j.val, L (j.val + 1))) =
        physicalBareWalkScalar V patterns C ζ K a L (N + 1) *
          ((∏ j ∈ range (N + 2), physicalResidueVertexWeight (L j)
            (physicalEndpointSchedule q (N + 1) j)
            (physicalTranslateResidues r
              (physicalBareOffset C k a L (N + 1) j)) : ℝ) : ℂ) := by
  obtain ⟨n, rfl⟩ := physical_residues_of_int_surjective hP hprime r
  exact physical_residue_path_term_factor_int V patterns C hq ζ k K a L N n

/-- Every finite positive-length residue path has the walk factorization
used to sum its mass against the independent-residue initial law. -/
theorem physical_residue_finite_path_factor {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (N : ℕ) (L₀ : PhysicalMarkLists P J ell)
    (p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)
    (r : PhysicalResidues P) :
    let a := finitePathLabels p
    let L := finitePathMarks L₀ p
    physicalResidueBarePathTerm V patterns C q ζ k K (N + 1) r L₀ p =
        physicalBareWalkScalar V patterns C ζ K a L (N + 1) *
          ((∏ j ∈ range (N + 2), physicalResidueVertexWeight (L j)
            (physicalEndpointSchedule q (N + 1) j)
            (physicalTranslateResidues r
              (physicalBareOffset C k a L (N + 1) j)) : ℝ) : ℂ) := by
  have h := physical_residue_path_term_factor hP hprime V patterns C hq ζ k K
    (finitePathLabels p) (finitePathMarks L₀ p) N r
  rw [finite_path_sequences] at h
  exact h
end

section
open Finset
theorem physical_residue_bare_path_mass_bound {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (patterns : Finset I) (C : I → G → Finset (Fin J))
    (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (H : ℝ) (hH : 0 ≤ H) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    (∀ j (x : PhysicalBareResidueState P J ell),
      (∑ y : PhysicalBareResidueState P J ell, ∑ a : PhysicalEdgeLabels P J ell patterns C,
        ‖physicalResidueLabeledCoeff V patterns C q (ζ j) (k j) (K j) a x y‖) ≤ H) →
    ∀ n : ℕ,
    (∑ x : PhysicalBareResidueState P J ell, physicalResidueInitialMass V x *
      ∑ p : Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
        ‖deterministicBarePathTerm
          (fun j a r L => physicalTranslateResidues r (physicalBareStep C (k j) a L))
          (fun j => physicalResidueStepCoeff V patterns C q (ζ j) (k j) (K j))
          (fun _ _ => (1 : ℂ)) n x.1 x.2 p‖) ≤ H^n := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  intro hrow n
  have hb := physical_residue_averaged_path_bound V hV hMass patterns C q ζ k K H hH
    hrow (fun _ _ => (1 : ℂ)) (fun _ _ => by simp) n
  have he (x : PhysicalBareResidueState P J ell) :
      (∑ p : Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalBareResidueState P J ell,
        ‖labeledPathTerm (fun j a u v => physicalResidueLabeledCoeff V patterns C q (ζ j) (k j) (K j) a u v)
          (fun _ => (1 : ℂ)) n x p‖) =
      ∑ p : Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
        ‖deterministicBarePathTerm
          (fun j a r L => physicalTranslateResidues r (physicalBareStep C (k j) a L))
          (fun j => physicalResidueStepCoeff V patterns C q (ζ j) (k j) (K j))
          (fun _ _ => (1 : ℂ)) n x.1 x.2 p‖ := by
    exact deterministic_target_absolute_path_sum _ _ (fun _ _ => (1 : ℂ)) n x.1 x.2
  simpa only [he] using hb
end

section
open Finset
theorem physical_residue_path_norm_expectation {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (V : G → ℝ) (patterns : Finset I) (C : I → G → Finset (Fin J))
    {q : ℝ} (hq : 0 ≤ q) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (N : ℕ) (L₀ : PhysicalMarkLists P J ell)
    (p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) :
    (∑ r : PhysicalResidues P, (∏ a : PhysicalPrime P, 1 / (a.2.val : ℝ)) *
      ‖physicalResidueBarePathTerm V patterns C q ζ k K (N + 1) r L₀ p‖) =
      ‖physicalBareWalkScalar V patterns C ζ K (finitePathLabels p) (finitePathMarks L₀ p) (N + 1)‖ *
        physicalFiniteResidueExpectation C q k N L₀ p := by
  let L := finitePathMarks L₀ p
  let a := finitePathLabels p
  let W := fun r : PhysicalResidues P => ∏ j ∈ range (N + 2),
    physicalResidueVertexWeight (L j) (physicalEndpointSchedule q (N + 1) j)
      (physicalTranslateResidues r (physicalBareOffset C k a L (N + 1) j))
  have hW (r : PhysicalResidues P) : 0 ≤ W r :=
    physical_residue_vertex_product_nonneg _ _ _ _
      (fun j _ => physical_endpoint_schedule_nonneg hq (N + 1) j) r
  have he (r : PhysicalResidues P) :
      ‖physicalResidueBarePathTerm V patterns C q ζ k K (N + 1) r L₀ p‖ =
        ‖physicalBareWalkScalar V patterns C ζ K a L (N + 1)‖ * W r := by
    rw [physical_residue_finite_path_factor hP hprime V patterns C hq ζ k K]
    change ‖physicalBareWalkScalar V patterns C ζ K a L (N + 1) * (W r : ℂ)‖ = _
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hW r)]
  simp only [he]
  calc
    _ = ‖physicalBareWalkScalar V patterns C ζ K a L (N + 1)‖ *
        ∑ r : PhysicalResidues P, (∏ a : PhysicalPrime P, 1 / (a.2.val : ℝ)) * W r := by
      rw [mul_sum]
      apply sum_congr rfl
      intro r _
      ring
    _ = _ := congrArg (fun z => ‖physicalBareWalkScalar V patterns C ζ K a L (N + 1)‖ * z)
      (physical_residue_vertex_expectation hP hprime L (range (N + 2))
        (physicalBareOffset C k a L (N + 1)) (physicalEndpointSchedule q (N + 1)))

theorem physical_residue_expected_walk_mass {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (V : G → ℝ) (patterns : Finset I) (C : I → G → Finset (Fin J))
    {q : ℝ} (hq : 0 ≤ q) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (N : ℕ) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    (∑ x : PhysicalBareResidueState P J ell, physicalResidueInitialMass V x *
      ∑ p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
        ‖physicalResidueBarePathTerm V patterns C q ζ k K (N + 1) x.1 x.2 p‖) =
      physicalStateMass V J ell * ∑ L₀ : PhysicalMarkLists P J ell,
        ∑ p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
          ‖physicalBareWalkScalar V patterns C ζ K (finitePathLabels p) (finitePathMarks L₀ p) (N + 1)‖ *
            physicalFiniteResidueExpectation C q k N L₀ p := by
  classical
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  let F := fun (r : PhysicalResidues P) (L : PhysicalMarkLists P J ell) =>
    ∑ p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
      ‖physicalResidueBarePathTerm V patterns C q ζ k K (N + 1) r L p‖
  have hF : ∀ r L, ¬ physicalResidueMarksValid r L → F r L = 0 := by
    intro r L h
    apply sum_eq_zero
    intro p _
    rw [physical_residue_bare_path_term_zero_of_invalid V patterns C q ζ k K N r L p h, norm_zero]
  change (∑ x : PhysicalBareResidueState P J ell, physicalResidueInitialMass V x * F x.1 x.2) = _
  rw [physical_residue_initial_mass_sum_of_supported V F hF]
  congr 1
  apply sum_congr rfl
  intro L₀ _
  simp only [F, mul_sum]
  rw [sum_comm]
  apply sum_congr rfl
  intro p _
  exact physical_residue_path_norm_expectation hP hprime V patterns C hq ζ k K N L₀ p

theorem physical_expected_walk_mass_bound {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (patterns : Finset I) (C : I → G → Finset (Fin J))
    {q : ℝ} (hq : 0 ≤ q) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (H : ℝ) (hH : 0 ≤ H) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    (∀ j (x : PhysicalBareResidueState P J ell),
      (∑ y : PhysicalBareResidueState P J ell, ∑ a : PhysicalEdgeLabels P J ell patterns C,
        ‖physicalResidueLabeledCoeff V patterns C q (ζ j) (k j) (K j) a x y‖) ≤ H) →
    ∀ N : ℕ,
      physicalStateMass V J ell * ∑ L₀ : PhysicalMarkLists P J ell,
        ∑ p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
          ‖physicalBareWalkScalar V patterns C ζ K (finitePathLabels p) (finitePathMarks L₀ p) (N + 1)‖ *
            physicalFiniteResidueExpectation C q k N L₀ p ≤ H^(N + 1) := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  intro hrow N
  rw [← physical_residue_expected_walk_mass hP hprime V patterns C hq ζ k K N]
  exact physical_residue_bare_path_mass_bound V hV hMass patterns C q ζ k K H hH hrow (N + 1)

/-- Integer-return paths are a subset of unrestricted residue walks.
This is the exact nonnegative mass needed to sum the CRT error estimates. -/
theorem physical_expected_return_mass_bound {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (patterns : Finset I) (C : I → G → Finset (Fin J))
    {q : ℝ} (hq : 0 ≤ q) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (H : ℝ) (hH : 0 ≤ H) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    (∀ j (x : PhysicalBareResidueState P J ell),
      (∑ y : PhysicalBareResidueState P J ell, ∑ a : PhysicalEdgeLabels P J ell patterns C,
        ‖physicalResidueLabeledCoeff V patterns C q (ζ j) (k j) (K j) a x y‖) ≤ H) →
    ∀ N : ℕ,
      physicalStateMass V J ell * ∑ L₀ : PhysicalMarkLists P J ell,
        ∑ p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
          ‖physicalBareReturnScalar V patterns C ζ k K (finitePathLabels p) (finitePathMarks L₀ p) (N + 1)‖ *
            physicalFiniteResidueExpectation C q k N L₀ p ≤ H^(N + 1) := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  intro hrow N
  calc
    _ ≤ physicalStateMass V J ell * ∑ L₀ : PhysicalMarkLists P J ell,
        ∑ p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
          ‖physicalBareWalkScalar V patterns C ζ K (finitePathLabels p) (finitePathMarks L₀ p) (N + 1)‖ *
            physicalFiniteResidueExpectation C q k N L₀ p := by
      apply mul_le_mul_of_nonneg_left _ (physical_state_mass_pos V hV J ell).le
      apply sum_le_sum
      intro L₀ _
      apply sum_le_sum
      intro p _
      exact mul_le_mul_of_nonneg_right
        (physical_bare_return_scalar_norm_le V patterns C ζ k K (finitePathLabels p) (finitePathMarks L₀ p) (N + 1))
        (physical_finite_residue_expectation_nonneg hP hprime C hq k N L₀ p)
    _ ≤ _ := physical_expected_walk_mass_bound hP hprime V hV hMass patterns C hq ζ k K H hH hrow N
end

section
open Finset Classical
theorem physical_root_error_of_residue_rows {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (patterns : Finset I) (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (starts : Finset ℤ) (r b : ℕ)
    (hbound : ∀ j < r + 1, physicalOperatorStepBound P J ell patterns C (k j) ≤ b)
    (H ε : ℝ) (hH : 0 ≤ H) (hε : 0 ≤ ε) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    (∀ j (x : PhysicalBareResidueState P J ell),
      (∑ y : PhysicalBareResidueState P J ell, ∑ label : PhysicalEdgeLabels P J ell patterns C,
        ‖physicalResidueLabeledCoeff V patterns C q (ζ j) (k j) (K j) label x y‖) ≤ H) →
    (∀ (L : PhysicalMarkLists P J ell)
      (p : Fin (r + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell),
      |(∑ n ∈ starts, physicalFiniteVertexProduct C q k r L p n) / (starts.card : ℝ) -
        physicalFiniteVertexExpectation C q k r L p| ≤ ε * physicalFiniteVertexExpectation C q k r L p) →
    ‖physicalRootMoment V patterns C q ζ k K starts r b -
      physicalRootResidueModel V patterns C q ζ k K r‖ ≤ ε * H^(r + 1) := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  intro hrow herror
  have hm := physical_expected_return_mass_bound hP hprime V hV hMass patterns C hq ζ k K H hH hrow r
  have he := physical_root_replacement_error V hV patterns C hq ζ k K starts r b hbound ε herror
  apply he.trans
  exact mul_le_mul_of_nonneg_left hm hε

/-- A polynomial residue-row bound is absorbed by choosing the
per-path relative error exponent larger by the row exponent. -/
theorem physical_root_exponential_error {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (patterns : Finset I) (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (starts : Finset ℤ) (r b : ℕ)
    (hbound : ∀ j < r + 1, physicalOperatorStepBound P J ell patterns C (k j) ≤ b)
    {T : ℝ} (hT : 0 < T) (D E : ℝ) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    (∀ j (x : PhysicalBareResidueState P J ell),
      (∑ y : PhysicalBareResidueState P J ell, ∑ label : PhysicalEdgeLabels P J ell patterns C,
        ‖physicalResidueLabeledCoeff V patterns C q (ζ j) (k j) (K j) label x y‖) ≤ T^D) →
    (∀ (L : PhysicalMarkLists P J ell)
      (p : Fin (r + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell),
      |(∑ n ∈ starts, physicalFiniteVertexProduct C q k r L p n) / (starts.card : ℝ) -
        physicalFiniteVertexExpectation C q k r L p| ≤
          Real.exp (-(E + D) * (r + 1) * Real.log T) * physicalFiniteVertexExpectation C q k r L p) →
    ‖physicalRootMoment V patterns C q ζ k K starts r b -
      physicalRootResidueModel V patterns C q ζ k K r‖ ≤ Real.exp (-E * (r + 1) * Real.log T) := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  intro hrow herror
  have he := physical_root_error_of_residue_rows hP hprime V hV hMass patterns C hq ζ k K
    starts r b hbound (T^D) (Real.exp (-(E + D) * (r + 1) * Real.log T))
    (Real.rpow_nonneg hT.le D) (Real.exp_pos _).le hrow herror
  apply he.trans_eq
  rw [Real.rpow_def_of_pos hT, ← Real.exp_nat_mul, ← Real.exp_add]
  congr 1
  push_cast
  ring
end

section
open Finset
/-- Transporting the state coordinates separately at each time preserves
the finite path action. The row at step `j` uses the coordinates at time
`j + 1`, and the column uses those at time `j`. -/
theorem finite_path_action_conjugate {X Y R : Type*}
    [Fintype X] [Fintype Y] [Semiring R]
    (e : ℕ → X ≃ Y) (K : ℕ → X → X → R) (f : X → R)
    (n : ℕ) (x : X) :
    finitePathAction
        (fun j y z => K j ((e (j + 1)).symm y) ((e j).symm z))
        (fun y => f ((e 0).symm y)) n (e n x) =
      finitePathAction K f n x := by
  classical
  induction n generalizing x with
  | zero => simp [finitePathAction]
  | succ n ih =>
    simp only [finitePathAction, Equiv.symm_apply_apply]
    rw [← (e n).sum_comp]
    simp only [Equiv.symm_apply_apply, ih]

/-- The same change-of-coordinates identity at an arbitrary target state. -/
theorem finite_path_action_conjugate_apply {X Y R : Type*}
    [Fintype X] [Fintype Y] [Semiring R]
    (e : ℕ → X ≃ Y) (K : ℕ → X → X → R) (f : X → R)
    (n : ℕ) (y : Y) :
    finitePathAction
        (fun j y z => K j ((e (j + 1)).symm y) ((e j).symm z))
        (fun y => f ((e 0).symm y)) n y =
      finitePathAction K f n ((e n).symm y) := by
  simpa using finite_path_action_conjugate e K f n ((e n).symm y)

/-- A finite sum over endpoints is unchanged when each endpoint is
transported by the coordinates at the final time. -/
theorem finite_path_action_conjugate_sum_endpoints {X Y R A : Type*}
    [Fintype X] [Fintype Y] [Fintype A] [Semiring R]
    (e : ℕ → X ≃ Y) (K : ℕ → X → X → R) (f : X → R)
    (n : ℕ) (v : A → X) :
    (∑ a, finitePathAction
        (fun j y z => K j ((e (j + 1)).symm y) ((e j).symm z))
        (fun y => f ((e 0).symm y)) n (e n (v a))) =
      ∑ a, finitePathAction K f n (v a) := by
  simp only [finite_path_action_conjugate]

/-- Fixed endpoint sums, such as vacuum projections, are invariant under
time-dependent relabelings that fix those endpoints at the final time. -/
theorem finite_path_action_conjugate_sum_fixed_endpoints {X R A : Type*}
    [Fintype X] [Fintype A] [Semiring R]
    (e : ℕ → X ≃ X) (K : ℕ → X → X → R) (f : X → R)
    (n : ℕ) (v : A → X) (hv : ∀ a, e n (v a) = v a) :
    (∑ a, finitePathAction
        (fun j y z => K j ((e (j + 1)).symm y) ((e j).symm z))
        (fun y => f ((e 0).symm y)) n (v a)) =
      ∑ a, finitePathAction K f n (v a) := by
  simpa only [hv] using finite_path_action_conjugate_sum_endpoints e K f n v
end

section
open Finset
/-- For a fixed finite pending support `P`, its prime-coordinate memory sum
is exactly its ordered prime/residue sum with the `1/j!` normalization.
The arbitrary test may couple all pending coordinates. Instantiate `P` with
the subtype of a finite prime set, and `w p r` with its prime mass for the
manuscript memory measure. No factor equal to a residue-space cardinality is
introduced, and empty supports and empty residue spaces are allowed. -/
theorem ordered_pending_sum_div_factorial
    {𝕜 P : Type*} [Field 𝕜] [CharZero 𝕜] [Fintype P] [DecidableEq P]
    (R : P → Type*) [∀ p, Fintype (R p)]
    (w : (p : P) → R p → 𝕜) (F : ((p : P) → R p) → 𝕜) :
    (∑ e : Fin (Fintype.card P) ≃ P,
      ∑ r : (j : Fin (Fintype.card P)) → R (e j),
        (∏ j, w (e j) (r j)) * F (Equiv.piCongrLeft R e r)) /
        ((Fintype.card P).factorial : 𝕜) =
      ∑ r : (p : P) → R p, (∏ p, w p (r p)) * F r := by
  classical
  have hinner (e : Fin (Fintype.card P) ≃ P) :
      (∑ r : (j : Fin (Fintype.card P)) → R (e j),
        (∏ j, w (e j) (r j)) * F (Equiv.piCongrLeft R e r)) =
      ∑ r : (p : P) → R p, (∏ p, w p (r p)) * F r := by
    calc
      _ = ∑ r : (j : Fin (Fintype.card P)) → R (e j),
          (∏ p, w p ((Equiv.piCongrLeft R e r) p)) *
            F (Equiv.piCongrLeft R e r) := by
        apply sum_congr rfl
        intro r hr
        congr 1
        simpa only [Equiv.piCongrLeft_apply_apply] using
          e.prod_comp (fun p => w p ((Equiv.piCongrLeft R e r) p))
      _ = _ := (Equiv.piCongrLeft R e).sum_comp
        (fun r => (∏ p, w p (r p)) * F r)
  simp_rw [hinner]
  rw [sum_const, card_univ, nsmul_eq_mul,
    Fintype.card_equiv (Fintype.equivFin P).symm, Fintype.card_fin]
  exact mul_div_cancel_left₀ _ (Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _))
end

section
open Finset
/-- The two non-alive states are unborn (`false`) and completed (`true`). -/
def ghostFiniteStateEquivSum (R : Type*) : GhostFiniteState R ≃ Bool ⊕ R where
  toFun
    | none => Sum.inl false
    | some none => Sum.inl true
    | some (some r) => Sum.inr r
  invFun
    | Sum.inl false => none
    | Sum.inl true => some none
    | Sum.inr r => some (some r)
  left_inv x := by rcases x with _ | (_ | r) <;> rfl
  right_inv x := by rcases x with (_ | _) | r <;> rfl

/-- Alive coordinates, irrespective of whether their prime is physically active. -/
noncomputable def ghostAliveSupport {I : Type*} [Fintype I]
    {R : I → Type*} (x : (i : I) → GhostFiniteState (R i)) : Finset I := by
  classical
  exact univ.filter (fun i => ∃ r, x i = some (some r))

theorem mem_ghostAliveSupport {I : Type*} [Fintype I]
    {R : I → Type*} (x : (i : I) → GhostFiniteState (R i)) (i : I) :
    i ∈ ghostAliveSupport x ↔ ∃ r, x i = some (some r) := by
  classical
  simp [ghostAliveSupport]

/-- A configuration described by its alive residues and the unborn/completed
flags of all remaining primes. -/
abbrev GhostSupportConfiguration {I : Type*} (R : I → Type*) :=
  Σ S : Finset I, ((i : S) → R i.val) × ({i : I // i ∉ S} → Bool)

/-- Assemble the coordinate state from a chosen support and its two data fields. -/
noncomputable def ghostConfigurationAssemble {I : Type*}
    {R : I → Type*} (z : GhostSupportConfiguration R) :
    (i : I) → GhostFiniteState (R i) := by
  classical
  exact fun i => if hi : i ∈ z.1 then some (some (z.2.1 ⟨i, hi⟩))
    else if z.2.2 ⟨i, hi⟩ then some none else none

theorem ghostAliveSupport_assemble {I : Type*} [Fintype I]
    {R : I → Type*} (z : GhostSupportConfiguration R) :
    ghostAliveSupport (ghostConfigurationAssemble z) = z.1 := by
  classical
  ext i
  by_cases hi : i ∈ z.1
  · simp [mem_ghostAliveSupport, ghostConfigurationAssemble, hi]
  · simp [mem_ghostAliveSupport, ghostConfigurationAssemble, hi]

/-- Distinct support data always reconstruct distinct coordinate states. -/
theorem ghostConfigurationAssemble_injective {I : Type*} [Fintype I]
    {R : I → Type*} : Function.Injective (@ghostConfigurationAssemble I R) := by
  classical
  rintro ⟨S, r, c⟩ ⟨T, r', c'⟩ h
  have hST : S = T := by
    simpa only [ghostAliveSupport_assemble] using congrArg ghostAliveSupport h
  cases hST
  have hr : r = r' := by
    funext i
    have he := congrFun h i.val
    simpa [ghostConfigurationAssemble, i.property] using he
  have hc : c = c' := by
    funext i
    have he := congrFun h i.val
    simp only [ghostConfigurationAssemble, dif_neg i.property] at he
    cases hci : c i <;> cases hci' : c' i <;> simp_all
  cases hr
  cases hc
  rfl

/-- Extract the alive residues, recording all other states by a Boolean flag. -/
noncomputable def ghostConfigurationSplit {I : Type*} [Fintype I]
    {R : I → Type*} (x : (i : I) → GhostFiniteState (R i)) :
    GhostSupportConfiguration R := by
  classical
  refine ⟨ghostAliveSupport x, (fun i => ?_), fun i => (x i.val).isSome⟩
  exact Classical.choose ((mem_ghostAliveSupport x i.val).mp i.property)

theorem ghostConfigurationAssemble_split {I : Type*} [Fintype I]
    {R : I → Type*} (x : (i : I) → GhostFiniteState (R i)) :
    ghostConfigurationAssemble (ghostConfigurationSplit x) = x := by
  classical
  funext i
  dsimp only [ghostConfigurationAssemble, ghostConfigurationSplit]
  split
  · rename_i hi
    exact (Classical.choose_spec ((mem_ghostAliveSupport x i).mp hi)).symm
  · rename_i hi
    have hn : ¬ ∃ r, x i = some (some r) := by simpa only [mem_ghostAliveSupport] using hi
    have hclosed (s : GhostFiniteState (R i)) (hs : ¬ ∃ r, s = some (some r)) :
        (if s.isSome then some none else none) = s := by
      rcases s with _ | (_ | r)
      · rfl
      · rfl
      · exact (hs ⟨r, rfl⟩).elim
    exact hclosed (x i) hn

/-- Full coordinate configurations are equivalent to support/residue/flag data. -/
noncomputable def ghostConfigurationEquiv {I : Type*} [Fintype I]
    (R : I → Type*) :
    ((i : I) → GhostFiniteState (R i)) ≃ GhostSupportConfiguration R where
  toFun := ghostConfigurationSplit
  invFun := ghostConfigurationAssemble
  left_inv := ghostConfigurationAssemble_split
  right_inv z := ghostConfigurationAssemble_injective
    (ghostConfigurationAssemble_split (ghostConfigurationAssemble z))

/-- Reindex any finite sum over all prime-coordinate configurations by their
alive support, alive residues, and complementary unborn/completed flags. -/
theorem ghost_configuration_sum_support {I M : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, Fintype (R i)] [AddCommMonoid M]
    (F : ((i : I) → GhostFiniteState (R i)) → M) :
    (∑ x, F x) =
      ∑ S : Finset I, ∑ r : (i : S) → R i.val,
        ∑ c : {i : I // i ∉ S} → Bool,
          F (ghostConfigurationAssemble ⟨S, r, c⟩) := by
  classical
  have h := (ghostConfigurationEquiv R).symm.sum_comp F
  simpa only [Fintype.sum_sigma, Fintype.sum_prod_type,
    ghostConfigurationEquiv, Equiv.symm_mk, Equiv.coe_fn_mk] using h.symm

/-- The complete configuration sum has an ordered alive-coordinate form.
For each support, its ordering multiplicity is canceled by `1/|S|!`.
The complement flags retain the distinction between unborn and completed. -/
theorem ghost_configuration_sum_ordered_alive {I 𝕜 : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, Fintype (R i)] [Field 𝕜] [CharZero 𝕜]
    (F : ((i : I) → GhostFiniteState (R i)) → 𝕜) :
    (∑ x, F x) =
      ∑ S : Finset I, ∑ c : {i : I // i ∉ S} → Bool,
        (∑ e : Fin (Fintype.card S) ≃ S,
          ∑ r : (j : Fin (Fintype.card S)) → R (e j).val,
            F (ghostConfigurationAssemble
              ⟨S, Equiv.piCongrLeft (fun i : S => R i.val) e r, c⟩)) /
          ((Fintype.card S).factorial : 𝕜) := by
  classical
  rw [ghost_configuration_sum_support]
  apply sum_congr rfl
  intro S hS
  rw [sum_comm]
  apply sum_congr rfl
  intro c hc
  symm
  simpa only [prod_const_one, one_mul] using
    ordered_pending_sum_div_factorial (fun i : S => R i.val)
      (fun _ _ => (1 : 𝕜)) (fun r => F (ghostConfigurationAssemble ⟨S, r, c⟩))
end

section
open Finset
/-- A total local damping at most half the residue modulus leaves a baseline
between one half and one. -/
theorem memory_baseline_bounds {T p : ℝ} (hT : 0 ≤ T) (hp : 0 < p)
    (hTp : 2 * T ≤ p) : 1 / 2 ≤ 1 - T / p ∧ 1 - T / p ≤ 1 := by
  have hlo : 0 ≤ T / p := div_nonneg hT hp.le
  have hhi : T / p ≤ 1 / 2 := (div_le_iff₀ hp).2 (by linarith)
  constructor <;> linarith

theorem memory_baseline_pos {T p : ℝ} (hT : 0 ≤ T) (hp : 0 < p)
    (hTp : 2 * T ≤ p) : 0 < 1 - T / p := by
  have := (memory_baseline_bounds hT hp hTp).1
  linarith

/-- Dividing by an admissible baseline changes a nonnegative weight by a
factor between one and two. -/
theorem memory_baseline_inv_bounds {b : ℝ} (hb : 1 / 2 ≤ b ∧ b ≤ 1) :
    1 ≤ 1 / b ∧ 1 / b ≤ 2 := by
  have hb0 : 0 < b := by linarith [hb.1]
  constructor
  · exact (le_div_iff₀ hb0).2 (by linarith [hb.2])
  · exact (div_le_iff₀ hb0).2 (by linarith [hb.1])

/-- The excess reciprocal factor is at most twice the unnormalized damping. -/
theorem memory_baseline_distortion {T p : ℝ} (hT : 0 ≤ T) (hp : 0 < p)
    (hTp : 2 * T ≤ p) :
    0 ≤ 1 / (1 - T / p) - 1 ∧ 1 / (1 - T / p) - 1 ≤ 2 * T / p := by
  have hb := memory_baseline_bounds hT hp hTp
  have hb0 := memory_baseline_pos hT hp hTp
  have hi := memory_baseline_inv_bounds hb
  have heq : 1 / (1 - T / p) - 1 = (T / p) * (1 / (1 - T / p)) := by
    have hpT : p - T ≠ 0 := ne_of_gt (by linarith)
    field_simp [ne_of_gt hp, ne_of_gt hb0, hpT]
    ring
  constructor
  · linarith [hi.1]
  · rw [heq]
    calc
      _ ≤ (T / p) * 2 := mul_le_mul_of_nonneg_left hi.2 (div_nonneg hT hp.le)
      _ = _ := by ring

/-- Abstract tilted finite mass: any weights of total mass `V` are multiplied
by at most two when every baseline lies between one half and one. -/
theorem memory_tilted_mass_bounds {ι : Type*} (S : Finset ι) (w b : ι → ℝ)
    (V : ℝ) (hV : 0 < V) (hw : ∀ i ∈ S, 0 ≤ w i)
    (hMass : ∑ i ∈ S, w i = V) (hb : ∀ i ∈ S, 1 / 2 ≤ b i ∧ b i ≤ 1) :
    1 ≤ (∑ i ∈ S, w i / b i) / V ∧ (∑ i ∈ S, w i / b i) / V ≤ 2 := by
  have hterm : ∀ i ∈ S, w i ≤ w i / b i ∧ w i / b i ≤ 2 * w i := by
    intro i hi
    have hbi := memory_baseline_inv_bounds (hb i hi)
    constructor
    · calc
        w i = w i * 1 := by ring
        _ ≤ w i * (1 / b i) := mul_le_mul_of_nonneg_left hbi.1 (hw i hi)
        _ = _ := by ring
    · calc
        w i / b i = w i * (1 / b i) := by ring
        _ ≤ w i * 2 := mul_le_mul_of_nonneg_left hbi.2 (hw i hi)
        _ = _ := by ring
  have hlo : V ≤ ∑ i ∈ S, w i / b i := by
    rw [← hMass]
    exact sum_le_sum (fun i hi => (hterm i hi).1)
  have hhi : (∑ i ∈ S, w i / b i) ≤ 2 * V := by
    rw [← hMass, mul_sum]
    exact sum_le_sum (fun i hi => (hterm i hi).2)
  constructor
  · exact (le_div_iff₀ hV).2 (by simpa using hlo)
  · exact (div_le_iff₀ hV).2 hhi

/-- A reciprocal-prime pool of harmonic mass `V` has tilted normalized mass
between one and two. The estimate actually holds for any finite set of naturals. -/
theorem memory_tilted_prime_pool_mass {P : Finset ℕ} (b : ℕ → ℝ) (V : ℝ)
    (hV : 0 < V) (hMass : ∑ p ∈ P, 1 / (p : ℝ) = V)
    (hb : ∀ p ∈ P, 1 / 2 ≤ b p ∧ b p ≤ 1) :
    1 ≤ (∑ p ∈ P, 1 / ((p : ℝ) * b p)) / V ∧
      (∑ p ∈ P, 1 / ((p : ℝ) * b p)) / V ≤ 2 := by
  simpa only [div_div] using memory_tilted_mass_bounds P (fun p => 1 / (p : ℝ))
    b V hV (fun p _ => div_nonneg zero_le_one (Nat.cast_nonneg p)) hMass hb

/-- The existing normalized physical label law obeys the same factor-two tilt. -/
theorem memory_tilted_physical_label_mass {G : Type*} {P : G → Finset ℕ}
    (V : G → ℝ) (g : G) (b : P g → ℝ) (hV : 0 < V g)
    (hMass : ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (hb : ∀ p, 1 / 2 ≤ b p ∧ b p ≤ 1) :
    1 ≤ ∑ p : P g, physicalLabelLaw V g p / b p ∧
      (∑ p : P g, physicalLabelLaw V g p / b p) ≤ 2 := by
  have hl : ∀ p : P g, 0 ≤ physicalLabelLaw V g p := by
    intro p
    exact div_nonneg zero_le_one (mul_nonneg hV.le (Nat.cast_nonneg p.val))
  simpa only [div_one] using memory_tilted_mass_bounds univ (physicalLabelLaw V g)
    b 1 zero_lt_one (fun p _ => hl p) (physical_label_law_sum V g hV hMass)
    (fun p _ => hb p)

/-- Any finite product of admissible baselines is positive and at most one. -/
theorem memory_baseline_prod_bounds {ι : Type*} (S : Finset ι) (b : ι → ℝ)
    (hb : ∀ i ∈ S, 1 / 2 ≤ b i ∧ b i ≤ 1) :
    0 < ∏ i ∈ S, b i ∧ (∏ i ∈ S, b i) ≤ 1 := by
  have hb0 : ∀ i ∈ S, 0 < b i := by
    intro i hi
    linarith [(hb i hi).1]
  exact ⟨prod_pos hb0, prod_le_one₀ (fun i hi => (hb0 i hi).le) (fun i hi => (hb i hi).2)⟩

/-- Applying the local damping bound at every coordinate gives positive global
baseline and prevents that product from enlarging an absolute estimate. -/
theorem memory_lifespan_baseline_prod_bounds {ι : Type*} (S : Finset ι)
    (T p : ι → ℝ) (hT : ∀ i ∈ S, 0 ≤ T i) (hp : ∀ i ∈ S, 0 < p i)
    (hTp : ∀ i ∈ S, 2 * T i ≤ p i) :
    0 < ∏ i ∈ S, (1 - T i / p i) ∧ (∏ i ∈ S, (1 - T i / p i)) ≤ 1 :=
  memory_baseline_prod_bounds S (fun i => 1 - T i / p i)
    (fun i hi => memory_baseline_bounds (hT i hi) (hp i hi) (hTp i hi))
end

section
open Finset
/-- Move pending residues to the new frame, then apply the zero-hit visit.
Unborn and completed states are unchanged by the frame translation. -/
noncomputable def ghostMovingKernel {R : Type*} [AddGroup R] [DecidableEq R]
    (a : Bool) (delta : R) (η β : ℝ) (x y : GhostFiniteState R) : ℝ :=
  activeGhostFiniteKernel a 0 η β x (ghostMemoryShift delta y)

theorem ghost_moving_kernel_conjugation {R : Type*} [AddGroup R] [DecidableEq R]
    (a : Bool) (t u : R) (η β : ℝ) (x y : GhostFiniteState R) :
    activeGhostFiniteKernel a u η β ((ghostMemoryShift u).symm x)
      ((ghostMemoryShift t).symm y) = ghostMovingKernel a (u-t) η β x y := by
  rw [activeGhostFiniteKernel_relative_zero, Equiv.apply_symm_apply]
  rw [ghostMemoryShift_symm, ← ghostMemoryShift_add]
  simp only [ghostMovingKernel, sub_eq_add_neg]

/-- The complete memory evolution depends locally on consecutive frame
increments. The absolute starting coordinate is removed by conjugation. -/
theorem ghost_moving_action {R : Type*} [AddGroup R] [Fintype R] [DecidableEq R]
    (a : ℕ → Bool) (origin : ℕ → R) (η : ℕ → ℝ) (β : ℝ)
    (n : ℕ) (x : GhostFiniteState R) :
    finitePathAction (fun j => ghostMovingKernel (a j) (origin (j+1)-origin j) (η j) β)
      ghostFiniteInitial n x =
    finitePathAction (fun j => activeGhostFiniteKernel (a j) (origin (j+1)) (η j) β)
      ghostFiniteInitial n ((ghostMemoryShift (origin n)).symm x) := by
  have he := finite_path_action_conjugate_apply (fun j => ghostMemoryShift (origin j))
    (fun j => activeGhostFiniteKernel (a j) (origin (j+1)) (η j) β)
    ghostFiniteInitial n x
  simp only [ghost_moving_kernel_conjugation] at he
  simpa only [ghostMemoryShift_symm, ghostFiniteInitial_translation] using he

/-- Summing the two nonpending endpoints is invariant under the moving frame. -/
theorem ghost_moving_vacuum {R : Type*} [AddGroup R] [Fintype R] [DecidableEq R]
    (a : ℕ → Bool) (origin : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (n : ℕ) :
    (finitePathAction (fun j => ghostMovingKernel (a j) (origin (j+1)-origin j) (η j) β)
      ghostFiniteInitial n none +
     finitePathAction (fun j => ghostMovingKernel (a j) (origin (j+1)-origin j) (η j) β)
      ghostFiniteInitial n (some none)) =
    (activeGhostRun a (fun j => origin (j+1)) η β n).unborn +
      (activeGhostRun a (fun j => origin (j+1)) η β n).completed := by
  simp only [ghost_moving_action, ghostMemoryShift_symm, ghostMemoryShift_unborn,
    ghostMemoryShift_completed, active_ghost_finite_action_eq_vector, activeGhostFiniteVector]
end

section
open Finset
noncomputable def ghostMovingTensorVacuum {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, AddGroup (R i)] [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (a : I → ℕ → Bool) (origin : (i : I) → ℕ → R i) (η : I → ℕ → ℝ)
    (β : I → ℝ) (n : ℕ) : ℝ :=
  ∑ b : I → Bool,
    finitePathAction (fun j x y => ∏ i, ghostMovingKernel (a i j)
      (origin i (j+1) - origin i j) (η i j) (β i) (x i) (y i))
      (fun x => ∏ i, ghostFiniteInitial (x i)) n
      (fun i => if b i then some none else none)

/-- Translating every prime separately at every visit changes no vacuum
coefficient and leaves only consecutive increments inside the local kernels. -/
theorem ghost_moving_tensor_vacuum_eq {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, AddGroup (R i)] [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (a : I → ℕ → Bool) (origin : (i : I) → ℕ → R i) (η : I → ℕ → ℝ)
    (β : I → ℝ) (n : ℕ) :
    ghostMovingTensorVacuum a origin η β n =
      activeGhostTensorVacuum a (fun i j => origin i (j+1)) η β n := by
  unfold ghostMovingTensorVacuum
  rw [finite_path_action_tensor_sum_bool, active_ghost_tensor_vacuum_factor]
  apply prod_congr rfl
  intro i _
  exact ghost_moving_vacuum (a i) (origin i) (η i) (β i) n

/-- The independent prime-pool path weight equals a local zero-hit memory
vacuum. The kernels use only frame increments, with no absolute offset. -/
theorem pool_path_residue_eq_moving_memory {I : Type*} [Fintype I] [DecidableEq I]
    (m : I → ℕ) [∀ i, NeZero (m i)] (a : I → ℕ → Bool)
    (origin : (i : I) → ℕ → ZMod (m i)) (η : ℕ → ℝ) (n : ℕ) (b : I → ℝ)
    (hb : ∀ i, b i = 1 - (∑ j ∈ range n, η j) / m i)
    (hb0 : ∀ i, b i ≠ 0) :
    poolPathResidueExpectation m univ (range n)
      (fun i => (range n).filter (fun j => a i j = true)) (fun i j => origin i (j+1)) η =
      (∏ i, b i) * ghostMovingTensorVacuum a origin (fun _ => η)
        (fun i => ((m i : ℝ) * b i)⁻¹) n := by
  rw [ghost_moving_tensor_vacuum_eq]
  exact pool_path_residue_eq_memory m a (fun i j => origin i (j+1)) η n b hb hb0
end

section
open Finset
/-- Exact finite-memory representation of the independent-residue weight of
physical vertex labels and their integer offsets. -/
theorem physical_path_residue_eq_memory {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (labels : ℕ → PhysicalMarkLists P J ell) (offset : ℕ → ℤ)
    (q : ℕ → ℝ) (n : ℕ) (b : PhysicalPrime P → ℝ)
    (hb : ∀ p, b p = 1 - (∑ j ∈ range n, (1 - q j)) / p.2.val)
    (hb0 : ∀ p, b p ≠ 0) :
    poolPathResidueExpectation (fun p : PhysicalPrime P => p.2.val) univ (range n)
      (fun p => (range n).filter (fun j => p ∈ physicalMarkedPrimes (labels j)))
      (fun p j => -(offset j : ZMod p.2.val)) (fun j => 1 - q j) =
      (∏ p, b p) * activeGhostTensorVacuum
        (fun p j => decide (p ∈ physicalMarkedPrimes (labels j)))
        (fun p j => -(offset j : ZMod p.2.val)) (fun _ j => 1 - q j)
        (fun p => ((p.2.val : ℝ) * b p)⁻¹) n := by
  classical
  have he := pool_path_residue_eq_memory (fun p : PhysicalPrime P => p.2.val)
    (fun p j => decide (p ∈ physicalMarkedPrimes (labels j)))
    (fun p j => -(offset j : ZMod p.2.val)) (fun j => 1 - q j) n b hb hb0
  simpa only [decide_eq_true_eq] using he
end

section
open Finset Classical
/-- The absolute row sum has a fixed polynomial bound when there are
logarithmically many groups and polynomial total pattern coefficient mass. -/
theorem exists_physical_residue_operator_power_row_bound {q v : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (ell m : ℕ)
    {C B : ℝ} (hC : 0 ≤ C) (hB : 0 ≤ B) :
    ∃ D : ℝ, 0 ≤ D ∧ ∀ (T : ℝ), 0 < T →
      ∀ (G : Type) [Fintype G] [DecidableEq G],
      (Fintype.card G : ℝ) ≤ C * Real.log T →
      ∀ (P : G → Finset ℕ) [∀ p : PhysicalPrime P, NeZero p.2.val],
      Pairwise (fun g h => Disjoint (P g) (P h)) →
      (∀ g p, p ∈ P g → p.Prime) →
      ∀ (J : ℕ) (V : G → ℝ), (∀ g, v ≤ V g) →
      (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) →
      ∀ (I : Type) (patterns : Finset I) (slots : I → G → Finset (Fin J))
        (bounds : I → ℝ),
      (∀ i ∈ patterns, ∀ g, (slots i g).card ≤ m) →
      (∀ i ∈ patterns, 0 ≤ bounds i) → (∑ i ∈ patterns, bounds i) ≤ T^B →
      ∀ (ζ : I → ℝ) (k : I → ℤ)
        (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
          PhysicalAuxLabels P (slots i) → ℂ),
      (∀ i ∈ patterns, ∀ L R aux, ‖K i L R aux‖ ≤ bounds i) →
      letI : Fintype (PhysicalEdgeLabels P J ell patterns slots) := inferInstance
      ∀ x : PhysicalBareResidueState P J ell,
      (∑ y : PhysicalBareResidueState P J ell,
        ∑ a : PhysicalEdgeLabels P J ell patterns slots,
          ‖physicalResidueLabeledCoeff V patterns slots q ζ k K a x y‖) ≤ T^D := by
  obtain ⟨A, hA, hrow⟩ := exists_physical_residue_operator_row_bound hq0 hq1 hv ell m
  refine ⟨B + C * Real.log A, add_nonneg hB (mul_nonneg hC (Real.log_nonneg hA)), ?_⟩
  intro T hT G _ _ hG P _ hP hprime J V hV hMass I patterns slots bounds hslots
    hbounds hsum ζ k K hK
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns slots) := inferInstance
  intro x
  exact (hrow G P hP hprime J V hV hMass I patterns slots bounds hslots hbounds ζ k K hK x).trans
    (group_pattern_weight_power_bound hT hA hG hsum)
end

section
open Filter Finset
theorem eventually_physical_root_replacement_of_power_rows
    {a c d C V E γ D q : ℝ}
    (ha : 0 ≤ a) (hc : 0 < c) (hd : 0 < d) (had : a + d < 1)
    (hC : 0 < C) (hV : 0 < V) (hE : 0 ≤ E) (hγ : 0 < γ) (hD : 0 ≤ D)
    (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (J ell : ℕ) :
    ∀ᶠ T : ℝ in atTop, ∀ (G : Type) [Fintype G] [DecidableEq G]
      (P : G → Finset ℕ) [∀ p : PhysicalPrime P, NeZero p.2.val]
      (weights : G → ℝ) (I : Type) (patterns : Finset I)
      (slots : I → G → Finset (Fin J))
      (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
      (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (slots i) → ℂ)
      (r b N : ℕ) (z : ℤ),
      r + 1 = 2 * Nat.ceil (T^a) →
      Pairwise (fun g h => Disjoint (P g) (P h)) →
      (∀ g p, p ∈ P g → p.Prime) →
      (Fintype.card G : ℝ) ≤ C * Real.log T →
      (∀ g, 0 < weights g) →
      (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = weights g) →
      (∀ g, weights g ≤ V) →
      (∀ g p, p ∈ P g → Real.exp (T^c) ≤ (p : ℝ)) →
      (∀ g p, p ∈ P g → (p : ℝ) ≤ Real.exp (T^d)) →
      (∀ j < r + 1, physicalOperatorStepBound P J ell patterns slots (k j) ≤ b) →
      0 < N → γ * T ≤ Real.log (N : ℝ) →
      letI : Fintype (PhysicalEdgeLabels P J ell patterns slots) := inferInstance
      (∀ j (x : PhysicalBareResidueState P J ell),
        (∑ y : PhysicalBareResidueState P J ell, ∑ label : PhysicalEdgeLabels P J ell patterns slots,
          ‖physicalResidueLabeledCoeff weights patterns slots q (ζ j) (k j) (K j) label x y‖) ≤ T^D) →
      ‖physicalRootMoment weights patterns slots q ζ k K (Ico z (z + N)) r b -
        physicalRootResidueModel weights patterns slots q ζ k K r‖ ≤
        Real.exp (-E * (r + 1) * Real.log T) := by
  filter_upwards [eventually_physical_finite_vertex_replacement ha hc hd had hC hV
    (add_nonneg hE hD) hγ J ell, eventually_gt_atTop (0 : ℝ)] with T hreplace hT
  intro G _ _ P _ weights I patterns slots ζ k K r b N z hlen hP hprime hs
    hweights hMass hupper hmin hmax hbound hN hNb
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns slots) := inferInstance
  intro hrow
  apply physical_root_exponential_error hP hprime weights hweights hMass patterns slots
    hq0 ζ k K (Ico z (z + N)) r b hbound hT D E hrow
  intro L p
  have hp := hreplace G P I patterns slots k r hlen L p q N z hP hprime hs
    (fun g => (hMass g).trans_le (hupper g)) hmin hmax hq0 hq1 hN hNb
  simpa only [Int.card_Ico, add_sub_cancel_left, Int.toNat_natCast] using hp
end

section
open Filter Finset
theorem eventually_physical_root_replacement
    {a c d C V v E γ B q : ℝ}
    (ha : 0 ≤ a) (hc : 0 < c) (hd : 0 < d) (had : a + d < 1)
    (hC : 0 < C) (hV : 0 < V) (hv : 0 < v) (hE : 0 ≤ E)
    (hγ : 0 < γ) (hB : 0 ≤ B) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (J ell m : ℕ) :
    ∀ᶠ T : ℝ in atTop, ∀ (G : Type) [Fintype G] [DecidableEq G]
      (P : G → Finset ℕ) [∀ p : PhysicalPrime P, NeZero p.2.val]
      (weights : G → ℝ) (I : Type) (patterns : Finset I)
      (slots : I → G → Finset (Fin J)) (bounds : I → ℝ)
      (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
      (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (slots i) → ℂ)
      (r b N : ℕ) (z : ℤ),
      r + 1 = 2 * Nat.ceil (T^a) →
      Pairwise (fun g h => Disjoint (P g) (P h)) →
      (∀ g p, p ∈ P g → p.Prime) →
      (Fintype.card G : ℝ) ≤ C * Real.log T →
      (∀ g, v ≤ weights g) →
      (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = weights g) →
      (∀ g, weights g ≤ V) →
      (∀ g p, p ∈ P g → Real.exp (T^c) ≤ (p : ℝ)) →
      (∀ g p, p ∈ P g → (p : ℝ) ≤ Real.exp (T^d)) →
      (∀ i ∈ patterns, ∀ g, (slots i g).card ≤ m) →
      (∀ i ∈ patterns, 0 ≤ bounds i) → (∑ i ∈ patterns, bounds i) ≤ T^B →
      (∀ j i, i ∈ patterns → ∀ L R aux, ‖K j i L R aux‖ ≤ bounds i) →
      (∀ j < r + 1, physicalOperatorStepBound P J ell patterns slots (k j) ≤ b) →
      0 < N → γ * T ≤ Real.log (N : ℝ) →
      ‖physicalRootMoment weights patterns slots q ζ k K (Ico z (z + N)) r b -
        physicalRootResidueModel weights patterns slots q ζ k K r‖ ≤
        Real.exp (-E * (r + 1) * Real.log T) := by
  obtain ⟨D, hD, hrow⟩ := exists_physical_residue_operator_power_row_bound hq0 hq1 hv ell m hC.le hB
  filter_upwards [eventually_physical_root_replacement_of_power_rows ha hc hd had hC hV hE hγ hD
    hq0 hq1.le J ell, eventually_gt_atTop (0 : ℝ)] with T hreplace hT
  intro G _ _ P _ weights I patterns slots bounds ζ k K r b N z hlen hP hprime hs hlow
    hMass hupper hmin hmax hslots hbounds hsum hK hcut hN hNb
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns slots) := inferInstance
  apply hreplace G P weights I patterns slots ζ k K r b N z hlen hP hprime hs
    (fun g => hv.trans_le (hlow g)) hMass hupper hmin hmax hcut hN hNb
  intro j x
  exact hrow T hT G hs P hP hprime J weights hlow hMass I patterns slots bounds
    hslots hbounds hsum (ζ j) (k j) (K j) (hK j) x
