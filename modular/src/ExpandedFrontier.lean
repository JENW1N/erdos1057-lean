/- The original unnumbered fixed-plan root sum is exactly its recorded action. -/

open Finset Classical
namespace Bounty
section Numbered
variable {I : Type} {N M J ell n : ℕ} {P : Fin N → Finset ℕ}
  [∀ z : PhysicalPrime P, NeZero z.2.val]
  (groups : Finset (Fin N)) (e : {g // g ∉ groupsᶜ} ≃ Fin M)
  (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
  (hC : ∀ i : patterns, ∀ g : ↥groupsᶜ, C i.val g.val = ∅)
  (V : Fin N → ℝ) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
  (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
    PhysicalAuxLabels P (C i) → ℂ)
  (r : PhysicalGroupResidues P groupsᶜ) (θ : ℝ)
  (p : PhysicalRootSmallPlan (P := P) (J := J) (ell := ell) (n := n) groups patterns)

theorem physical_root_integrand_sum_eq_record_action
    {B : ℕ}
    [Fintype (PhysicalRootSmallPlanBigData groups patterns C hC p)]
    [Fintype (PhysicalSelectedData (fun g => P (e.symm g).val) ell
      (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val))]
    (hP : ∀ g a, a ∈ P g → Nat.Prime a)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hk : ∀ t < n + 1, ∀ i ∈ patterns, ∀ g a, a ∈ P g → ¬ (a : ℤ) ∣ k t i)
    (β : PhysicalPrime P → ℝ) (ρ : ℝ)
    (hV : ∀ g, V g ≠ 0) (hρ : ρ ≠ 0)
    (hB : (physicalPrimeGroups P groups).card ≤ B)
    (cut : ℕ → Fin M → Finset (Fin J))
    (hencode : ∀ i, PhysicalMarkRowEncoding
      (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val)
      (physicalSelectedFineTag (n + 1) i) (cut i) (cut (i + 1))) :
    let _ : ∀ g (z : P (e.symm g).val), NeZero z.val :=
      fun g z => inferInstanceAs (NeZero (⟨(e.symm g).val, z⟩ : PhysicalPrime P).2.val)
    let Pn := fun g => P (e.symm g).val
    let Cn := fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val
    let Vn := fun g => V (e.symm g).val
    let βn := fun (g : Fin M) (z : Pn g) => β ⟨(e.symm g).val, z⟩
    (∑ db : PhysicalRootSmallPlanBigData groups patterns C hC p,
      let old := physicalRootSmallPlanPath groups patterns C hC p db
      physicalRootMixedPathIntegrand groups patterns C V q ζ k K β B r θ old.1 old.2) =
    (physicalStateMass (fun g : ↥groupsᶜ => V g.val) J ell : ℂ) *
    ∑ L : PhysicalMarkLists Pn J ell,
      ((∏ g, ∏ s : PhysicalSlots J ell, βn g (L g s) / Vn g : ℝ) : ℂ) *
      physicalSelectedRecordAction Cn (physicalRootPlanMultiplier groups patterns C hC k p)
        βn Vn ρ (fun g => hV (e.symm g).val)
        (fun j _ aux => physicalAuxMass Vn (Cn j) aux)
        (fun j => physicalEndpointSchedule q (n + 1) j.val) cut univ
        (physicalRootNumberedCompleteWeight groups e patterns C hC V q ζ k K r θ p) fullMemoryVacuum
        (physicalInitialMarkState B L) := by
  let _ : ∀ g (z : P (e.symm g).val), NeZero z.val :=
    fun g z => inferInstanceAs (NeZero (⟨(e.symm g).val, z⟩ : PhysicalPrime P).2.val)
  dsimp only
  apply Eq.trans _ (physical_root_numbered_integrand_sum_eq_record_action
    groups e patterns C hC V q ζ k K r θ p hP hdis hk β ρ hV hρ hB cut hencode)
  exact ((physicalSelectedGroupReindex e (fun g => P g.val)
    (fun j (g : {g // g ∉ groupsᶜ}) => C (physicalRootSmallPlanPattern groups patterns C hC p j).val g.val)).symm.sum_comp
      (fun db =>
        let old := physicalRootSmallPlanPath groups patterns C hC p db
        physicalRootMixedPathIntegrand groups patterns C V q ζ k K β B r θ old.1 old.2)).symm

end Numbered
end Bounty
end

section

/- The selected small factor is a deterministic small phase on the original
full path, weighted by the original signed fine-path weight. -/

open scoped Classical
namespace Bounty
section Weighted
variable {S : Type} [Fintype S] {Ps : S → Finset ℕ}
  {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (retention : Fin (n + 1) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
  (cut : ℕ → Fin N → Finset (Fin J))
  (hencode : ∀ i, PhysicalMarkRowEncoding C (physicalSelectedFineTag n i) (cut i) (cut (i + 1)))
  (Cs : Fin n → S → Finset (Fin J)) (Vs : S → ℝ) (q : ℝ)
  (ds : PhysicalGroupSelectedData Ps ell Cs)

include hencode in
theorem physical_original_weighted_small_ledger
    [Fintype (PhysicalSelectedData P ell C)]
    (r : PhysicalResidues Ps) (x : PhysicalFullBoundedState P J ell B) (hx : FullActiveInjective x)
    (p : FullPermutationMixedPath (fun g (p : ↥(P g)) => p.val)
      (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j))
      ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)) x) :
    physicalOriginalFineWeight C k ω β retention ρ V x p *
        physicalSelectedDataRecordPhase C cut Finset.univ
          (fun d => physicalSelectedSmallWeight Cs Vs q r (physicalSelectedCumulativeOffset C k d) ds)
          (physicalOriginalFineRecord C k cut x p) =
      physicalOriginalFineWeight C k ω β retention ρ V x p *
        deterministicLedgerPhase
          (FullPermutationMixedEvent (fun g (p : ↥(P g)) => p.val)
            (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
            (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j)))
          (fullPermutationMixedEventTarget (fun g (p : ↥(P g)) => p.val)
            (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
            (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j)))
          (physicalFullSmallUpdate C k cut) (physicalFullSmallPhase C k cut Cs Vs q ds)
          ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)) r x p := by
  rw [physical_original_small_ledger]
  exact physical_original_weighted_offset_phase C k ω β retention ρ V cut hencode
    (fun a => physicalSelectedSmallWeight Cs Vs q r a ds) x hx p

end Weighted
end Bounty
end

section

/- The literal original root small weight is the deterministic small
residue phase on the original full path, including zero-weight paths. -/

open scoped Classical
namespace Bounty
section Root
variable {I : Type} {N M J ell n B : ℕ} {P : Fin N → Finset ℕ}
  [∀ z : PhysicalPrime P, NeZero z.2.val]
  (groups : Finset (Fin N)) (e : {g // g ∉ groupsᶜ} ≃ Fin M)
  (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
  (hC : ∀ i : patterns, ∀ g : ↥groupsᶜ, C i.val g.val = ∅)
  (k : ℕ → I → ℤ)
  (pl : PhysicalRootSmallPlan (P := P) (J := J) (ell := ell) (n := n) groups patterns)

theorem physical_root_weighted_small_ledger
    [Fintype (PhysicalSelectedData (fun g => P (e.symm g).val) ell
      (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val))]
    (V : Fin N → ℝ) {q : ℝ} (hq : 0 ≤ q)
    (r : PhysicalGroupResidues P groupsᶜ)
    (ω : ∀ j, SharedActiveLabels (fun g => ↥(P (e.symm g).val))
      (fun g => physicalFullSharedIndices (ell := ell)
        (C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val)) →
      PhysicalAuxLabels (fun g => P (e.symm g).val)
        (fun g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val) → ℝ)
    (β : (g : Fin M) → ↥(P (e.symm g).val) → ℝ)
    (retention : Fin (n + 2) → ℝ) (ρ : ℝ)
    (cut : ℕ → Fin M → Finset (Fin J))
    (hencode : ∀ i, PhysicalMarkRowEncoding
      (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val)
      (physicalSelectedFineTag (n + 1) i) (cut i) (cut (i + 1)))
    (x : PhysicalFullBoundedState (fun g => P (e.symm g).val) J ell B) (hx : FullActiveInjective x)
    (path : FullPermutationMixedPath (fun g (p : P (e.symm g).val) => p.val)
      (fun j g => physicalFullSharedIndices (ell := ell)
        (C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val)) B
      (fun j _ => PhysicalAuxLabels (fun g => P (e.symm g).val)
        (fun g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val))
      (fun j => physicalFullEdgeDelta
        (fun g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val)
        (physicalRootPlanMultiplier groups patterns C hC k pl j))
      (fun j => physicalFullEdgeD
        (fun g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val))
      ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1))) x) :
    let Cn := fun j g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val
    let kn := physicalRootPlanMultiplier groups patterns C hC k pl
    let record := physicalOriginalFineRecord Cn kn cut x path
    let weight := physicalOriginalFineWeight Cn kn ω β retention ρ (fun g => V (e.symm g).val) x path
    weight * physicalSelectedDataRecordPhase Cn cut Finset.univ
        (fun d => physicalRootPlanSmallWeight groups patterns C hC V q k r pl
          ((physicalSelectedGroupReindex e (fun g => P g.val)
            (fun j (g : {g // g ∉ groupsᶜ}) =>
              C (physicalRootSmallPlanPattern groups patterns C hC pl j).val g.val)).symm d)) record =
      weight * deterministicLedgerPhase
        (FullPermutationMixedEvent (fun g (p : P (e.symm g).val) => p.val)
          (fun j g => physicalFullSharedIndices (Cn j g)) B
          (fun j _ => PhysicalAuxLabels (fun g => P (e.symm g).val) (Cn j))
          (fun j => physicalFullEdgeDelta (Cn j) (kn j)) (fun j => physicalFullEdgeD (Cn j)))
        (fullPermutationMixedEventTarget (fun g (p : P (e.symm g).val) => p.val)
          (fun j g => physicalFullSharedIndices (Cn j g)) B
          (fun j _ => PhysicalAuxLabels (fun g => P (e.symm g).val) (Cn j))
          (fun j => physicalFullEdgeDelta (Cn j) (kn j)) (fun j => physicalFullEdgeD (Cn j)))
        (physicalFullSmallUpdate Cn kn cut)
        (physicalFullSmallPhase Cn kn cut
          (fun j (g : ↥groupsᶜ) => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val g.val)
          (fun g => V g.val) q (physicalRootSmallPlanSmallData groups patterns C hC pl))
        ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1)))
        (physicalGroupResidueVector r) x path := by
  dsimp only
  rw [physical_original_small_ledger]
  exact physical_root_weighted_small_record groups e patterns C hC k pl V hq r
    ω β retention ρ cut hencode x hx path

end Root
end Bounty
end

section

/- On supported original states, the decoded small displacement agrees
with the raw full-edge divisor used by the mixed-word small residue phase. -/

open scoped Classical
namespace Bounty
section Raw
variable {S : Type} [Fintype S] {Ps : S → Finset ℕ}
  {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)

noncomputable def physicalFullSmallRawUpdate
    (tag : Option (Fin (n + 1) ⊕ Fin n)) (r : PhysicalResidues Ps)
    (x : PhysicalFullBoundedState P J ell B)
    (e : PhysicalFullLedgerEvent C k tag (fullActiveInitialLedger x, x)) : PhysicalResidues Ps :=
  match tag with
  | none => r
  | some (.inl _) => r
  | some (.inr j) => physicalTranslateResidues r
      (k j * (physicalFullSharedD (C j)
        (productActiveMemorySplit (fun g => physicalFullSharedIndices (C j g)) B x).1 e.1 : ℤ))

variable (Cs : Fin n → S → Finset (Fin J)) (Vs : S → ℝ) (q : ℝ)
  (ds : PhysicalGroupSelectedData Ps ell Cs)

noncomputable def physicalFullSmallRawPhase
    (tag : Option (Fin (n + 1) ⊕ Fin n)) (r : PhysicalResidues Ps)
    (x : PhysicalFullBoundedState P J ell B)
    (e : PhysicalFullLedgerEvent C k tag (fullActiveInitialLedger x, x)) : ℂ :=
  match tag with
  | none => (Nat.card (PhysicalPermutations S J ell) : ℂ)⁻¹
  | some (.inl _) => 1
  | some (.inr j) =>
      physicalBarePatternScalar Vs (Cs j) 0 (fun _ _ _ => 1) (ds.1 j)
        (physicalPermuteLabels (ds.2.2.1 j) (ds.2.1 j.castSucc))
        (physicalPermuteLabels (ds.2.2.2 j) (ds.2.1 j.succ)) *
      ((physicalResidueVertexWeight (physicalPermuteLabels (ds.2.2.1 j) (ds.2.1 j.castSucc))
          (Real.sqrt q) r *
        physicalResidueVertexWeight (physicalPermuteLabels (ds.2.2.2 j) (ds.2.1 j.succ))
          (Real.sqrt q) (physicalFullSmallRawUpdate C k (some (.inr j)) r x e) : ℝ) : ℂ)

variable (cut : ℕ → Fin N → Finset (Fin J))
  (hcut : ∀ j : Fin n, cut (4 * j.val + 2) = C j)

include hcut

omit [Fintype S] in
theorem physical_full_small_update_raw
    (tag : Option (Fin (n + 1) ⊕ Fin n)) (r : PhysicalResidues Ps)
    (x : PhysicalFullBoundedState P J ell B) (hx : FullActiveInjective x)
    (e : PhysicalFullLedgerEvent C k tag (fullActiveInitialLedger x, x)) :
    physicalFullSmallUpdate C k cut tag r x e = physicalFullSmallRawUpdate C k tag r x e := by
  cases tag with
  | none => exact physical_translate_residues_zero r
  | some tag =>
    cases tag with
    | inl j => exact physical_translate_residues_zero r
    | inr j =>
      dsimp only [physicalFullSmallUpdate, physicalSelectedSmallLocalUpdate,
        physicalLocalDisplacement, physicalFullSmallRawUpdate]
      rw [physical_active_displacement_full_divisor C k cut j (hcut j) x hx]

theorem physical_full_small_phase_raw
    (tag : Option (Fin (n + 1) ⊕ Fin n)) (r : PhysicalResidues Ps)
    (x : PhysicalFullBoundedState P J ell B) (hx : FullActiveInjective x)
    (e : PhysicalFullLedgerEvent C k tag (fullActiveInitialLedger x, x)) :
    physicalFullSmallPhase C k cut Cs Vs q ds tag r x e =
      physicalFullSmallRawPhase C k Cs Vs q ds tag r x e := by
  cases tag with
  | none => rfl
  | some tag =>
    cases tag with
    | inl j => rfl
    | inr j =>
      have h := physical_full_small_update_raw C k cut hcut (some (.inr j)) r x hx e
      dsimp only [physicalFullSmallUpdate] at h
      dsimp only [physicalFullSmallPhase, physicalSelectedSmallLocalPhase, physicalFullSmallRawPhase]
      rw [h]

theorem physical_small_ledger_raw_on_support
    (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
      (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
    (β : (g : Fin N) → ↥(P g) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (ks : List (Option (Fin (n + 1) ⊕ Fin n))) (r : PhysicalResidues Ps)
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (p : FiniteEventPath (PhysicalFullLedgerEvent C k) (physicalFullLedgerEventTarget C k) ks s)
    (hs : FullActiveInjective s.2)
    (hp : finiteEventLocalPhase (PhysicalFullLedgerEvent C k) (physicalFullLedgerEventTarget C k)
      (physicalFullLedgerEventPhase C k ω β ρ V) ks s p ≠ 0) :
    deterministicLedgerPhase (PhysicalFullLedgerEvent C k) (physicalFullLedgerEventTarget C k)
        (fun tag r s e => physicalFullSmallUpdate C k cut tag r s.2 e)
        (fun tag r s e => physicalFullSmallPhase C k cut Cs Vs q ds tag r s.2 e) ks r s p =
      deterministicLedgerPhase (PhysicalFullLedgerEvent C k) (physicalFullLedgerEventTarget C k)
        (fun tag r s e => physicalFullSmallRawUpdate C k tag r s.2 e)
        (fun tag r s e => physicalFullSmallRawPhase C k Cs Vs q ds tag r s.2 e) ks r s p := by
  exact deterministic_ledger_phase_eq_on_support _ _
    (physicalFullLedgerEventPhase C k ω β ρ V) (fun s => FullActiveInjective s.2)
    (fun tag s e hs hp => physical_local_phase_target_injective C k ω β ρ V tag s e hs hp)
    _ _ (fun tag r s e hs _ => physical_full_small_update_raw C k cut hcut tag r s.2 hs e)
    _ _ (fun tag r s e hs _ => physical_full_small_phase_raw C k Cs Vs q ds cut hcut tag r s.2 hs e)
    ks r s p hs hp

end Raw
end Bounty
end

section

/- The raw divisor and decoded small phases agree after multiplication
by the original signed weight, including every zero-weight path. -/

open scoped Classical
namespace Bounty
section Weighted
variable {S : Type} [Fintype S] {Ps : S → Finset ℕ}
  {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (Cs : Fin n → S → Finset (Fin J)) (Vs : S → ℝ) (q : ℝ)
  (ds : PhysicalGroupSelectedData Ps ell Cs)
  (cut : ℕ → Fin N → Finset (Fin J))
  (hcut : ∀ j : Fin n, cut (4 * j.val + 2) = C j)

include hcut in
theorem physical_original_weighted_raw_small_ledger
    (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
      (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
    (β : (g : Fin N) → ↥(P g) → ℝ) (retention : Fin (n + 1) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (r : PhysicalResidues Ps) (x : PhysicalFullBoundedState P J ell B) (hx : FullActiveInjective x)
    (p : FullPermutationMixedPath (fun g (p : ↥(P g)) => p.val)
      (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j))
      ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)) x) :
    let E := FullPermutationMixedEvent (J := Fin (n + 1)) (fun g (p : ↥(P g)) => p.val)
      (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (ell := ell) (C j) (k j)) (fun j => physicalFullEdgeD (ell := ell) (C j))
    let target := fullPermutationMixedEventTarget (J := Fin (n + 1)) (fun g (p : ↥(P g)) => p.val)
      (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (ell := ell) (C j) (k j)) (fun j => physicalFullEdgeD (ell := ell) (C j))
    let steps := (List.range (4 * n + 1)).map (physicalSelectedFineTag n)
    physicalOriginalFineWeight C k ω β retention ρ V x p *
        deterministicLedgerPhase E target (physicalFullSmallUpdate C k cut)
          (physicalFullSmallPhase C k cut Cs Vs q ds) steps r x p =
      physicalOriginalFineWeight C k ω β retention ρ V x p *
        deterministicLedgerPhase E target (physicalFullSmallRawUpdate C k)
          (physicalFullSmallRawPhase C k Cs Vs q ds) steps r x p := by
  dsimp only
  by_cases hp : physicalOriginalFineWeight C k ω β retention ρ V x p = 0
  · rw [hp, zero_mul, zero_mul]
  · let E := FullPermutationMixedEvent (J := Fin (n + 1)) (fun g (p : ↥(P g)) => p.val)
      (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (ell := ell) (C j) (k j)) (fun j => physicalFullEdgeD (ell := ell) (C j))
    let target := fullPermutationMixedEventTarget (J := Fin (n + 1)) (fun g (p : ↥(P g)) => p.val)
      (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (ell := ell) (C j) (k j)) (fun j => physicalFullEdgeD (ell := ell) (C j))
    let history := fullMixedLedgerUpdate (J := Fin (n + 1)) (fun g (p : ↥(P g)) => p.val)
      (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (ell := ell) (C j) (k j)) (fun j => physicalFullEdgeD (ell := ell) (C j))
    let steps := (List.range (4 * n + 1)).map (physicalSelectedFineTag n)
    let lift := (finiteLedgerEventPathEquiv E target history steps (fullActiveInitialLedger x) x).symm p
    have hphase : finiteEventLocalPhase (PhysicalFullLedgerEvent C k) (physicalFullLedgerEventTarget C k)
        (physicalFullLedgerEventPhase C k ω β ρ V) steps (fullActiveInitialLedger x, x) lift ≠ 0 :=
      (mul_ne_zero_iff.mp hp).2
    have h := physical_small_ledger_raw_on_support C k Cs Vs q ds cut hcut ω β ρ V
      steps r (fullActiveInitialLedger x, x) lift hx hphase
    have hd := deterministic_ledger_phase_forget E target history
      (physicalFullSmallUpdate C k cut) (physicalFullSmallPhase C k cut Cs Vs q ds)
      steps (fullActiveInitialLedger x) r x lift
    have hr := deterministic_ledger_phase_forget E target history
      (physicalFullSmallRawUpdate C k) (physicalFullSmallRawPhase C k Cs Vs q ds)
      steps (fullActiveInitialLedger x) r x lift
    simp only [lift, Equiv.apply_symm_apply] at hd hr
    exact congrArg (fun z => physicalOriginalFineWeight C k ω β retention ρ V x p * z)
      (hd.symm.trans (h.trans hr))

end Weighted
end Bounty
end

section

/- The selected small endpoints decorate the original fine edge keys.
The effective planned phase retains the original raw small residue update. -/

open scoped Classical
namespace Bounty
section Keys
variable {S I : Type} [Fintype S] {Ps : S → Finset ℕ}
  {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : I → Fin N → Finset (Fin J)) (k : Fin n → I → ℤ)
  (i : Fin n → I) {Cs : Fin n → S → Finset (Fin J)}
  (ds : PhysicalGroupSelectedData Ps ell Cs)

def physicalSelectedPlannedKey (j : Fin n) :
    PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := Fin n) :=
  (j, i j, physicalPermuteLabels (ds.2.2.1 j) (ds.2.1 j.castSucc),
    physicalPermuteLabels (ds.2.2.2 j) (ds.2.1 j.succ))

noncomputable def physicalSelectedPlannedMultiplier (j : Fin n) : ℤ :=
  k j (i j) * (physicalSharedProduct (physicalSharedPrefix
    (physicalPermuteLabels (ds.2.2.1 j) (ds.2.1 j.castSucc))) : ℕ)

noncomputable def physicalSelectedPlannedEventEquiv (tag : Option (Fin (n + 1) ⊕ Fin n))
    (x : PhysicalFullBoundedState P J ell B) :=
  fullPermutationKeyEventEquiv (fun g (p : P g) => p.val)
    (fun key : PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := Fin n) =>
      fun g => physicalFullSharedIndices (ell := ell) (C key.2.1 g)) B
    (fun key _ => PhysicalAuxLabels P (C key.2.1))
    (fun key => physicalFullEdgeDelta (C key.2.1)
      (k key.1 key.2.1 * (physicalSharedProduct (physicalSharedPrefix key.2.2.1) : ℕ)))
    (fun key => physicalFullEdgeD (C key.2.1))
    (physicalSelectedPlannedKey i ds) tag x

theorem physical_selected_planned_update
    (tag : Option (Fin (n + 1) ⊕ Fin n)) (r : PhysicalResidues Ps)
    (x : PhysicalFullBoundedState P J ell B)
    (e : PhysicalFullLedgerEvent (fun j => C (i j)) (physicalSelectedPlannedMultiplier k i ds)
      tag (fullActiveInitialLedger x, x)) :
    physicalPlannedSmallUpdate (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i => PhysicalAuxLabels P (C i))
      (fun t i d => physicalFullEdgeDelta (C i) (k t i * (physicalSharedProduct d : ℕ)))
      (fun _ i _ => physicalFullEdgeD (C i))
      (fun t i => physicalMixedBigStep (C i) (k t i))
      (tag.map (Sum.map id (physicalSelectedPlannedKey i ds))) r x
      (physicalSelectedPlannedEventEquiv C k i ds tag x e) =
    physicalFullSmallRawUpdate (fun j => C (i j)) (physicalSelectedPlannedMultiplier k i ds) tag r x e := by
  cases tag with
  | none => rfl
  | some tag =>
    cases tag with
    | inl j => rfl
    | inr j =>
      change physicalTranslateResidues r
        (k j (i j) * (physicalFullSharedD (C (i j))
          (productActiveMemorySplit (fun g => physicalFullSharedIndices (C (i j) g)) B x).1 e.1 : ℤ) *
          (physicalSharedProduct (physicalSharedPrefix
            (physicalPermuteLabels (ds.2.2.1 j) (ds.2.1 j.castSucc))) : ℕ)) =
        physicalTranslateResidues r
          (k j (i j) * (physicalSharedProduct (physicalSharedPrefix
            (physicalPermuteLabels (ds.2.2.1 j) (ds.2.1 j.castSucc))) : ℕ) *
            (physicalFullSharedD (C (i j))
              (productActiveMemorySplit (fun g => physicalFullSharedIndices (C (i j) g)) B x).1 e.1 : ℤ))
      congr 1
      ring

theorem physical_selected_planned_phase
    (hCs : ∀ j s, Cs j s = ∅) (Vs : S → ℝ) (q : ℝ)
    (tag : Option (Fin (n + 1) ⊕ Fin n)) (r : PhysicalResidues Ps)
    (x : PhysicalFullBoundedState P J ell B)
    (e : PhysicalFullLedgerEvent (fun j => C (i j)) (physicalSelectedPlannedMultiplier k i ds)
      tag (fullActiveInitialLedger x, x)) :
    physicalPlannedSmallPhase (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i => PhysicalAuxLabels P (C i))
      (fun t i d => physicalFullEdgeDelta (C i) (k t i * (physicalSharedProduct d : ℕ)))
      (fun _ i _ => physicalFullEdgeD (C i))
      (fun t i => physicalMixedBigStep (C i) (k t i)) Vs (fun _ => q)
      (tag.map (Sum.map id (physicalSelectedPlannedKey i ds))) r x
      (physicalSelectedPlannedEventEquiv C k i ds tag x e) =
    physicalFullSmallRawPhase (fun j => C (i j)) (physicalSelectedPlannedMultiplier k i ds)
      Cs Vs q ds tag r x e := by
  cases tag with
  | none =>
    simp only [Option.map, physicalPlannedSmallPhase, physicalFullSmallRawPhase,
      Complex.ofReal_natCast, Nat.card_eq_fintype_card]
  | some tag =>
    cases tag with
    | inl j => rfl
    | inr j =>
      have hu := physical_selected_planned_update C k i ds (some (.inr j)) r x e
      dsimp only [physicalPlannedSmallPhase, Option.map, Sum.map, Sum.elim, Function.comp_apply,
        physicalSelectedPlannedKey, physicalFullSmallRawPhase]
      rw [physical_bare_neutral_empty_cut Vs (Cs j) (hCs j)]
      dsimp only [physicalSelectedPlannedKey, Option.map, Sum.map, Sum.elim, Function.comp_apply] at hu
      rw [hu]
