theorem candidate_coefficient_support_subset (c L q : ℝ) (r jStar : ℕ) :
    candidateCoefficientSupport c L q r jStar ⊆ arithmeticProductWindow 1 (Real.exp L) :=
  filter_subset _ _

theorem candidate_coefficient_support_mass (c L q : ℝ) (r jStar : ℕ) :
    (∑ u ∈ candidateCoefficientSupport c L q r jStar, candidateCoefficient c L q r jStar u) =
      candidateCoefficientWindowMass c L q r jStar := by
  unfold candidateCoefficientSupport candidateCoefficientWindowMass
  exact sum_filter_ne_zero _

/-- Any subset retaining the stated polynomial weighted mass already
contains exponentially many distinct elements. -/
theorem eventually_candidate_subset_card_lower {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (C : ℝ) {eps : ℝ} (heps : 0 < eps) :
    ∀ᶠ L : ℝ in atTop, ∀ (jStar : ℕ) (S : Finset ℕ),
      S ⊆ arithmeticProductWindow 1 (Real.exp L) →
      Real.exp L * L^(-C) ≤ (∑ u ∈ S, candidateCoefficient c L q r jStar u) →
      Real.exp ((1 - eps) * L) ≤ (S.card : ℝ) := by
  filter_upwards [eventually_candidate_coefficient_le_exp_sqrt hc hr hq0 hq1,
    eventually_weighted_mass_card_lower C (2 * Real.log 2 + 1) heps] with L hpoint hcard
  intro jStar S hS hmass
  apply hcard ℕ S (candidateCoefficient c L q r jStar) hmass
  intro u hu
  have hwindow := (mem_arithmeticProductWindow_iff one_ne_zero (Real.exp L)).mp (hS hu)
  exact hpoint jStar u (by simpa only [one_mul] using hwindow.2)

/-- The constructed coefficient has an exponentially large nonzero support.
The rough-slot index is fixed before the eventual limit in L. -/
theorem exists_candidate_support_card_lower {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1) :
    ∃ J : ℕ, ∀ jStar : ℕ, J < jStar → ∀ eps : ℝ, 0 < eps →
      ∀ᶠ L : ℝ in atTop,
        Real.exp ((1 - eps) * L) ≤ (candidateCoefficientSupport c L q r jStar).card := by
  obtain ⟨C, hC, J, hmass⟩ :=
    exists_candidate_coefficient_mass_polynomial_lower hc hr hq0 hq1 hcenter
  refine ⟨J, ?_⟩
  intro jStar hj eps heps
  filter_upwards [hmass jStar hj,
    eventually_candidate_subset_card_lower hc hr hq0 hq1 C heps] with L hm hcL
  apply hcL jStar (candidateCoefficientSupport c L q r jStar)
    (candidate_coefficient_support_subset c L q r jStar)
  rwa [candidate_coefficient_support_mass]
end

