noncomputable def fullMixedCommonOldIndexEmbedding :
    Fin (Fintype.card (FullMixedBirthAddress S B steps)) ↪
      Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) where
  toFun i := (fullMixedCommonBirthOrder M B steps).symm
    (.inr (fullMixedCommonStepEmbedding S B steps (fullMixedBirthOrder S B steps i)))
  inj' := by
    intro i j h
    have he := congrArg (fullMixedCommonBirthOrder M B steps) h
    simp only [Equiv.apply_symm_apply] at he
    exact (fullMixedBirthOrder S B steps).injective
      ((fullMixedCommonStepEmbedding S B steps).injective (Sum.inr.inj he))

theorem full_mixed_common_old_index_address
    (i : Fin (Fintype.card (FullMixedBirthAddress S B steps))) :
    fullMixedCommonBirthOrder M B steps (fullMixedCommonOldIndexEmbedding S B steps i) =
      .inr (fullMixedCommonStepEmbedding S B steps (fullMixedBirthOrder S B steps i)) :=
  (fullMixedCommonBirthOrder M B steps).apply_symm_apply _

theorem full_mixed_common_old_index_stage
    (i : Fin (Fintype.card (FullMixedBirthAddress S B steps))) :
    fullMixedCommonIndexStage M B steps (fullMixedCommonOldIndexEmbedding S B steps i) =
      (fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i)).succ := by
  unfold fullMixedCommonIndexStage
  rw [full_mixed_common_old_index_address]
  rfl

theorem full_mixed_common_old_index_group
    (i : Fin (Fintype.card (FullMixedBirthAddress S B steps))) :
    fullMixedCommonBirthGroup M B steps
      (fullMixedCommonBirthOrder M B steps (fullMixedCommonOldIndexEmbedding S B steps i)) =
      (fullMixedBirthOrder S B steps i).2.1 := by
  rw [full_mixed_common_old_index_address]
  rfl

end Indices

section Path
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ) (steps : List (Option (J ⊕ K)))
  (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
  (p : FullPermutationMixedPath n S B A Δ D steps x)

theorem full_mixed_common_old_index_label
    (i : Fin (Fintype.card (FullMixedBirthAddress S B steps))) :
    fullMixedCommonBirthLabel n S B A Δ D steps x p
      (fullMixedCommonBirthOrder M B steps (fullMixedCommonOldIndexEmbedding S B steps i)) =
      fullMixedPathBirthLabel n S B A Δ D steps x p (fullMixedBirthOrder S B steps i) := by
  rw [full_mixed_common_old_index_address, full_mixed_common_new_label, full_mixed_common_path_label_embed]

