theorem full_mixed_ledger_path_energy_le
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 < μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (hC : ∀ j g, q j / ρ ^ 2 + ((1 - q j) * V g / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (steps : List (Option (J ⊕ K)))
    (initial : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B →
      (g : Fin N) → Finset (P g))
    (phase : ∀ s, FullMixedLedgerPath n S B A Δ D steps s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fun x => fullMixedLedgerPathAction n S B A Δ D ω μ q ρ V steps phase
        (fun s => f s.2) (initial x, x)) ≤
    (steps.map (fullPermutationMixedStepEnergy ρ v vmin vmax T N)).prod *
      finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  rw [full_mixed_ledger_path_action_eq]
  simpa only [Fintype.card_fin] using
    full_permutation_mixed_path_energy_le n S B A Δ D ω μ q ρ V
      hω hωmass hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass hq0 hq1 hD hC T ht steps
      (fullMixedLedgerInducedPhase n S B A Δ D steps initial phase)
      (full_mixed_ledger_induced_phase_norm_le n S B A Δ D steps initial phase hphase) f hf

theorem full_mixed_ledger_rows_energy_le
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 < μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (hC : ∀ j g, q j / ρ ^ 2 + ((1 - q j) * V g / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (steps : List (Option (J ⊕ K)))
    (initial : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B →
      (g : Fin N) → Finset (P g))
    (edgePhase : ∀ k, ((g : Fin N) → Finset (P g)) →
      (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) →
      FullActiveEdgeEvent n (S k) B (A k) (Δ k) (D k) x → ℂ)
    (hphase : ∀ k H x e, ‖edgePhase k H x e‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fun x => finiteOperatorListAction (fullMixedLedgerRow n S B A Δ D edgePhase ω μ q ρ V) steps
        (fun s => f s.2) (initial x, x)) ≤
    (steps.map (fullPermutationMixedStepEnergy ρ v vmin vmax T N)).prod *
      finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  let phase := finiteEventLocalPhase (fun i (s : FullMixedLedgerState n (M := M) B) =>
    FullPermutationMixedEvent n S B A Δ D i s.2) (fullMixedLedgerTarget n S B A Δ D)
    (fullMixedLedgerPhase n S B A Δ D edgePhase) steps
  have hp : ∀ s p, ‖phase s p‖ ≤ 1 :=
    finite_event_local_phase_norm_le _ _ _
      (full_mixed_ledger_phase_norm_le n S B A Δ D edgePhase hphase) steps
  have h := full_mixed_ledger_path_energy_le n S B A Δ D ω μ q ρ V
    hω hωmass hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass hq0 hq1 hD hC T ht steps initial phase hp f hf
  rw [full_mixed_ledger_path_action_eq] at h
  rw [full_mixed_ledger_rows_eq]
  exact h

end Full
