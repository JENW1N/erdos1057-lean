/-- A nonnegative decreasing weight costs at most twice its initial value when
all complex prefix sums are bounded. This is finite summation by parts. -/
theorem norm_sum_Ioc_smul_le_of_antitone
    (f : ℕ → ℝ) (g : ℕ → ℂ) {m n : ℕ} (hmn : m < n) {B : ℝ}
    (hf : ∀ i ∈ Finset.Icc (m + 1) n, 0 ≤ f i)
    (hanti : AntitoneOn f (Set.Icc (m + 1) n))
    (hprefix : ∀ i ∈ Finset.Icc m n, ‖∑ j ∈ Finset.range (i + 1), g j‖ ≤ B) :
    ‖∑ i ∈ Finset.Ioc m n, f i • g i‖ ≤ 2 * f (m + 1) * B := by
  have hm1 : m + 1 ≤ n := by omega
  have hm1mem : m + 1 ∈ Finset.Icc (m + 1) n := Finset.mem_Icc.mpr ⟨le_rfl, hm1⟩
  have hnmem : n ∈ Finset.Icc (m + 1) n := Finset.mem_Icc.mpr ⟨hm1, le_rfl⟩
  have hsum : ∀ i ∈ Finset.Ioc m (n - 1),
      ‖(f (i + 1) - f i) • (∑ j ∈ Finset.range (i + 1), g j)‖ ≤
        (f i - f (i + 1)) * B := by
    intro i hi
    obtain ⟨hmi, hin⟩ := Finset.mem_Ioc.mp hi
    have hdiff : f (i + 1) ≤ f i := hanti ⟨by omega, by omega⟩ ⟨by omega, by omega⟩ (by omega)
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonpos (sub_nonpos.mpr hdiff), neg_sub]
    exact mul_le_mul_of_nonneg_left (hprefix i (Finset.mem_Icc.mpr ⟨by omega, by omega⟩))
      (sub_nonneg.mpr hdiff)
  have htel : (∑ i ∈ Finset.Ioc m (n - 1), (f i - f (i + 1))) = f (m + 1) - f n := by
    rw [← Finset.Ico_add_one_add_one_eq_Ioc, Nat.sub_add_cancel (by omega : 1 ≤ n)]
    calc
      _ = -(∑ i ∈ Finset.Ico (m + 1) n, (f (i + 1) - f i)) := by
        rw [← Finset.sum_neg_distrib]
        apply Finset.sum_congr rfl
        intro i hi
        ring
      _ = _ := by rw [Finset.sum_Ico_sub f hm1]; ring
  rw [Finset.sum_Ioc_by_parts f g hmn]
  calc
    _ ≤ ‖f n • (∑ j ∈ Finset.range (n + 1), g j)‖ +
        ‖f (m + 1) • (∑ j ∈ Finset.range (m + 1), g j)‖ +
        ‖∑ i ∈ Finset.Ioc m (n - 1),
          (f (i + 1) - f i) • (∑ j ∈ Finset.range (i + 1), g j)‖ :=
      (norm_sub_le _ _).trans (add_le_add (norm_sub_le _ _) le_rfl)
    _ ≤ f n * B + f (m + 1) * B +
        ∑ i ∈ Finset.Ioc m (n - 1), (f i - f (i + 1)) * B := by
      gcongr
      · rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (hf n hnmem)]
        exact mul_le_mul_of_nonneg_left (hprefix n (Finset.mem_Icc.mpr ⟨hmn.le, le_rfl⟩))
          (hf n hnmem)
      · rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (hf (m + 1) hm1mem)]
        exact mul_le_mul_of_nonneg_left (hprefix m (Finset.mem_Icc.mpr ⟨le_rfl, hmn.le⟩))
          (hf (m + 1) hm1mem)
      · exact (norm_sum_le _ _).trans (Finset.sum_le_sum hsum)
    _ = 2 * f (m + 1) * B := by rw [← Finset.sum_mul, htel]; ring
end

section

noncomputable def twistedPsi {q : ℕ} (χ : DirichletCharacter ℂ q) (x : ℝ) : ℂ :=
  ∑ n ∈ Finset.Ioc 0 ⌊x⌋₊, (ArithmeticFunction.vonMangoldt n : ℂ) * χ (n : ZMod q)

noncomputable def twistedTheta {q : ℕ} (χ : DirichletCharacter ℂ q) (x : ℝ) : ℂ :=
  ∑ p ∈ (Finset.Ioc 0 ⌊x⌋₊).filter Nat.Prime, (Real.log p : ℂ) * χ (p : ZMod q)

/-- Removing nontrivial prime powers is uniformly dominated by the untwisted error. -/
theorem norm_twistedPsi_sub_twistedTheta_le {q : ℕ} (χ : DirichletCharacter ℂ q) (x : ℝ) :
    ‖twistedPsi χ x - twistedTheta χ x‖ ≤ Chebyshev.psi x - Chebyshev.theta x := by
  classical
  have hid : twistedPsi χ x - twistedTheta χ x =
      ∑ n ∈ (Finset.Ioc 0 ⌊x⌋₊).filter (fun n => ¬n.Prime),
        (ArithmeticFunction.vonMangoldt n : ℂ) * χ (n : ZMod q) := by
    unfold twistedPsi twistedTheta
    simp only [Finset.sum_filter, ← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro n hn
    by_cases hp : n.Prime
    · simp [hp, ArithmeticFunction.vonMangoldt_apply_prime hp]
    · simp [hp]
  rw [hid, Chebyshev.psi_sub_theta_eq_sum_not_prime]
  apply (norm_sum_le _ _).trans
  apply Finset.sum_le_sum
  intro n hn
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg ArithmeticFunction.vonMangoldt_nonneg]
  exact mul_le_of_le_one_right ArithmeticFunction.vonMangoldt_nonneg (χ.norm_le_one _)

/-- Explicit modulus-independent prime-power removal. -/
theorem norm_twistedPsi_sub_twistedTheta_le_sqrt {q : ℕ}
    (χ : DirichletCharacter ℂ q) {x : ℝ} (hx : 1 ≤ x) :
    ‖twistedPsi χ x - twistedTheta χ x‖ ≤ 2 * Real.sqrt x * Real.log x :=
  (norm_twistedPsi_sub_twistedTheta_le χ x).trans (Chebyshev.psi_sub_theta_le hx)

/-- A prefix estimate for the Mangoldt sum gives one for the prime-log sum. -/
theorem norm_twistedTheta_le {q : ℕ} (χ : DirichletCharacter ℂ q)
    {x B : ℝ} (hx : 1 ≤ x) (hψ : ‖twistedPsi χ x‖ ≤ B) :
    ‖twistedTheta χ x‖ ≤ B + 2 * Real.sqrt x * Real.log x := by
  have he : twistedTheta χ x = twistedPsi χ x - (twistedPsi χ x - twistedTheta χ x) := by ring
  rw [he]
  exact (norm_sub_le _ _).trans (add_le_add hψ (norm_twistedPsi_sub_twistedTheta_le_sqrt χ hx))

/-- The prime-power error is absorbed without any power loss. -/
theorem prime_power_error_le_character_scale {q x : ℝ} (hq : 1 ≤ q) (hx : 2 ≤ x) :
    2 * Real.sqrt x * Real.log x ≤
      4 * x ^ ((7 : ℝ) / 8) * (Real.log (q * x)) ^ 2 := by
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hq0 : 0 < q := by linarith
  have hl2 : (1 : ℝ) / 2 ≤ Real.log 2 := by
    have h := Real.one_sub_inv_le_log_of_pos (by norm_num : (0 : ℝ) < 2)
    norm_num at h ⊢
    exact h
  have hlx : (1 : ℝ) / 2 ≤ Real.log x := hl2.trans (Real.log_le_log (by norm_num) hx)
  have hlog : Real.log x ≤ Real.log (q * x) :=
    Real.log_le_log hx0 (by nlinarith)
  have hsqrt : Real.sqrt x ≤ x ^ ((7 : ℝ) / 8) := by
    rw [Real.sqrt_eq_rpow]
    exact Real.rpow_le_rpow_of_exponent_le hx1 (by norm_num)
  have hlog0 : 0 ≤ Real.log (q * x) := by linarith
  have hlogquad : Real.log (q * x) ≤ 2 * (Real.log (q * x)) ^ 2 := by nlinarith
  calc
    _ ≤ 2 * x ^ ((7 : ℝ) / 8) * Real.log (q * x) := by gcongr
    _ ≤ 2 * x ^ ((7 : ℝ) / 8) * (2 * (Real.log (q * x)) ^ 2) := by gcongr
    _ = _ := by ring

/-- The exact prefix bound whose analytic proof is still needed. -/
def UniformTwistedMangoldtEstimate : Prop :=
  ∃ C : ℝ, 0 < C ∧ ∀ y : ℝ, 2 ≤ y → ∀ q : ℕ, 0 < q →
    ∀ χ : DirichletCharacter ℂ q, χ ≠ 1 →
      ‖twistedPsi χ y‖ ≤ C * y ^ ((7 : ℝ) / 8) * (Real.log ((q : ℝ) * y)) ^ 2

/-- Uniform prefix control of the logarithm-weighted prime sum. -/
def UniformTwistedThetaEstimate : Prop :=
  ∃ C : ℝ, 0 < C ∧ ∀ y : ℝ, 2 ≤ y → ∀ q : ℕ, 0 < q →
    ∀ χ : DirichletCharacter ℂ q, χ ≠ 1 →
      ‖twistedTheta χ y‖ ≤ C * y ^ ((7 : ℝ) / 8) * (Real.log ((q : ℝ) * y)) ^ 2

/-- Removing prime powers preserves the uniform exponent and logarithmic modulus cost. -/
theorem uniformTwistedThetaEstimate_of_mangoldt (h : UniformTwistedMangoldtEstimate) :
    UniformTwistedThetaEstimate := by
  obtain ⟨C, hC, hbound⟩ := h
  refine ⟨C + 4, by linarith, ?_⟩
  intro y hy q hq χ hχ
  have herr := prime_power_error_le_character_scale (by exact_mod_cast hq : (1 : ℝ) ≤ q) hy
  have hθ := norm_twistedTheta_le χ (by linarith : 1 ≤ y) (hbound y hy q hq χ hχ)
  nlinarith
end

section

noncomputable def primeLogTerm {q : ℕ} (χ : DirichletCharacter ℂ q) (n : ℕ) : ℂ :=
  if n.Prime then (Real.log n : ℂ) * χ (n : ZMod q) else 0

theorem sum_primeLogTerm_range {q : ℕ} (χ : DirichletCharacter ℂ q) (n : ℕ) :
    (∑ j ∈ Finset.range (n + 1), primeLogTerm χ j) = twistedTheta χ n := by
  rw [twistedTheta, Finset.sum_filter]
  simp only [Nat.floor_natCast]
  rw [Nat.range_succ_eq_Icc_zero, ← Finset.add_sum_Ioc_eq_sum_Icc (Nat.zero_le n)]
  simp only [primeLogTerm, Nat.not_prime_zero, ↓reduceIte, zero_add]

theorem twistedTheta_nat_zero_one {q : ℕ} (χ : DirichletCharacter ℂ q)
    {n : ℕ} (hn : n < 2) : twistedTheta χ n = 0 := by
  interval_cases n <;> norm_num [twistedTheta, Finset.filter_singleton]

/-- A uniform prefix bound for prime-log sums controls every terminal interval. -/
theorem norm_prime_sum_Ioc_le {q : ℕ} (χ : DirichletCharacter ℂ q)
    {m n : ℕ} (hm : 1 ≤ m) {B : ℝ} (hB : 0 ≤ B)
    (hprefix : ∀ k : ℕ, k ≤ n → ‖twistedTheta χ k‖ ≤ B) :
    ‖∑ p ∈ (Finset.Ioc m n).filter Nat.Prime, χ (p : ZMod q)‖ ≤ 4 * B := by
  classical
  by_cases hmn : m < n
  · have hlog : ∀ i : ℕ, m + 1 ≤ i → 0 < Real.log i := by
      intro i hi
      apply Real.log_pos
      exact_mod_cast (show 1 < i by omega)
    have hf : ∀ i ∈ Finset.Icc (m + 1) n, 0 ≤ 1 / Real.log i := by
      intro i hi
      exact (one_div_pos.mpr (hlog i (Finset.mem_Icc.mp hi).1)).le
    have hanti : AntitoneOn (fun i : ℕ => 1 / Real.log i) (Set.Icc (m + 1) n) := by
      intro i hi j hj hij
      exact one_div_le_one_div_of_le (hlog i hi.1)
        (Real.log_le_log (by exact_mod_cast (show 0 < i by have := hi.1; omega)) (by exact_mod_cast hij))
    have hab := norm_sum_Ioc_smul_le_of_antitone (fun i : ℕ => 1 / Real.log i)
      (primeLogTerm χ) hmn hf hanti (fun k hk => by
        rw [sum_primeLogTerm_range]
        exact hprefix k (Finset.mem_Icc.mp hk).2)
    have heq : (∑ i ∈ Finset.Ioc m n, (1 / Real.log i) • primeLogTerm χ i) =
        ∑ p ∈ (Finset.Ioc m n).filter Nat.Prime, χ (p : ZMod q) := by
      rw [Finset.sum_filter]
      apply Finset.sum_congr rfl
      intro i hi
      by_cases hp : i.Prime
      · simp only [primeLogTerm, hp, ↓reduceIte]
        rw [← Complex.real_smul, smul_smul]
        simp [(hlog i (by have := (Finset.mem_Ioc.mp hi).1; omega)).ne']
      · simp [primeLogTerm, hp]
    rw [heq] at hab
    have hl2 : (1 : ℝ) / 2 ≤ Real.log 2 := by
      have hh := Real.one_sub_inv_le_log_of_pos (by norm_num : (0 : ℝ) < 2)
      norm_num at hh ⊢
      exact hh
    have hln : (1 : ℝ) / 2 ≤ Real.log (m + 1 : ℕ) := hl2.trans
      (Real.log_le_log (by norm_num) (by exact_mod_cast (show 2 ≤ m + 1 by omega)))
    have hinv : 1 / Real.log (m + 1 : ℕ) ≤ 2 :=
      (div_le_iff₀ (hlog (m + 1) le_rfl)).mpr (by linarith)
    exact hab.trans (by nlinarith [mul_le_mul_of_nonneg_right hinv hB])
  · simp only [Finset.Ioc_eq_empty_of_le (by omega : n ≤ m), Finset.filter_empty,
      Finset.sum_empty, norm_zero]
    positivity

/-- The floor-defined ambient prime interval agrees with the interval used by finite Abel summation. -/
theorem ambientPrimes_eq_filter_Ioc {y : ℝ} (hy : 0 ≤ y) :
    ambientPrimes y = (Finset.Ioc ⌊2 * y⌋₊ ⌊5 * y⌋₊).filter Nat.Prime := by
  classical
  ext p
  rw [mem_ambientPrimes_iff hy, Finset.mem_filter, Finset.mem_Ioc,
    Nat.floor_lt (by positivity : 0 ≤ 2 * y), Nat.le_floor_iff (by positivity : 0 ≤ 5 * y)]
  tauto

/-- For one fixed character, logarithm-weighted prefix bounds imply the
unweighted ambient interval estimate. No primitivity hypothesis is required. -/
theorem prime_sum_bound_of_twistedTheta {q : ℕ} (χ : DirichletCharacter ℂ q)
    (hq : 0 < q) {C : ℝ} (hC : 0 ≤ C)
    (hbound : ∀ x : ℝ, 2 ≤ x →
      ‖twistedTheta χ x‖ ≤ C * x ^ ((7 : ℝ) / 8) * (Real.log ((q : ℝ) * x)) ^ 2)
    {y : ℝ} (hy : 2 ≤ y) :
    ‖∑ p ∈ ambientPrimes y, χ (p : ZMod q)‖ ≤
      (20 * C) * y ^ ((7 : ℝ) / 8) * (Real.log (5 * (q : ℝ) * y)) ^ 2 := by
  have hy0 : 0 < y := by linarith
  have hq0 : (0 : ℝ) < q := by exact_mod_cast hq
  have hq1 : (1 : ℝ) ≤ q := by exact_mod_cast hq
  let B : ℝ := C * (5 * y) ^ ((7 : ℝ) / 8) * (Real.log ((q : ℝ) * (5 * y))) ^ 2
  have hB : 0 ≤ B := by positivity
  have hprefix : ∀ k : ℕ, k ≤ ⌊5 * y⌋₊ → ‖twistedTheta χ k‖ ≤ B := by
    intro k hk
    by_cases hk2 : k < 2
    · rw [twistedTheta_nat_zero_one χ hk2, norm_zero]
      exact hB
    · have hkreal : (2 : ℝ) ≤ k := by exact_mod_cast (show 2 ≤ k by omega)
      have hk0 : (0 : ℝ) < k := by linarith
      have hkbound : (k : ℝ) ≤ 5 * y := (Nat.le_floor_iff (by positivity)).mp hk
      have hlog0 : 0 ≤ Real.log ((q : ℝ) * k) := Real.log_nonneg (by nlinarith)
      apply (hbound k hkreal).trans
      dsimp [B]
      gcongr
  rw [ambientPrimes_eq_filter_Ioc hy0.le]
  have hm : 1 ≤ ⌊2 * y⌋₊ := Nat.le_floor (by norm_num; linarith)
  have hmain := norm_prime_sum_Ioc_le χ hm hB hprefix
  apply hmain.trans
  dsimp [B]
  have hpow : (5 : ℝ) ^ ((7 : ℝ) / 8) ≤ 5 :=
    Real.rpow_le_self_of_one_le (by norm_num) (by norm_num)
  rw [Real.mul_rpow (by norm_num : (0 : ℝ) ≤ 5) hy0.le]
  have heq : (q : ℝ) * (5 * y) = 5 * q * y := by ring
  rw [heq]
  nlinarith [mul_le_mul_of_nonneg_right hpow
    (mul_nonneg (mul_nonneg hC (Real.rpow_nonneg hy0.le ((7 : ℝ) / 8))) (sq_nonneg (Real.log (5 * q * y))))]

/-- Uniform logarithm-weighted prime bounds imply the unweighted interval estimate. -/
theorem uniformPrimeCharacterEstimate_of_theta (h : UniformTwistedThetaEstimate) :
    UniformPrimeCharacterEstimate := by
  obtain ⟨C, hC, hbound⟩ := h
  refine ⟨20 * C, by positivity, ?_⟩
  intro y hy q hq χ hχ
  exact prime_sum_bound_of_twistedTheta χ hq hC.le
    (fun x hx => hbound x hx q hq χ hχ) hy

/-- The missing uniform Mangoldt estimate suffices for the analytic character input. -/
theorem uniformPrimeCharacterEstimate_of_mangoldt (h : UniformTwistedMangoldtEstimate) :
    UniformPrimeCharacterEstimate :=
  uniformPrimeCharacterEstimate_of_theta (uniformTwistedThetaEstimate_of_mangoldt h)
end

section

/-- The remaining analytic character input can be supplied through
its sharp twisted Mangoldt prefix estimate. The two hypotheses remain unproved. -/
theorem target_of_smooth_primes_and_uniform_mangoldt_estimate
    (hS : SmoothShiftedPrimeSupply) (hM : UniformTwistedMangoldtEstimate) :
    fcTypeOfName% "Erdos1057.erdos_1057" :=
  target_of_smooth_primes_and_uniform_character_estimate hS
    (uniformPrimeCharacterEstimate_of_mangoldt hM)
end

section

/-- Away from prime divisors of the level, a character and its primitive
character agree. At the excluded primes their difference has norm at most one. -/
theorem primitive_prime_value_error {q p : ℕ} (hq : 0 < q)
    (χ : DirichletCharacter ℂ q) (hp : p.Prime) :
    ‖χ (p : ZMod q) - χ.primitiveCharacter (p : ZMod χ.conductor)‖ ≤
      if p ∈ q.primeFactors then (1 : ℝ) else 0 := by
  classical
  by_cases hdiv : p ∣ q
  · have hc : ¬ IsCoprime (p : ℤ) q := by
      rw [Nat.isCoprime_iff_coprime, hp.coprime_iff_not_dvd]
      exact not_not.mpr hdiv
    have hz := (χ.apply_eq_zero_iff (p : ℤ)).mpr hc
    simp only [Int.cast_natCast] at hz
    rw [hz, zero_sub, norm_neg, if_pos (hp.mem_primeFactors hdiv hq.ne')]
    exact χ.primitiveCharacter.norm_le_one _
  · have he := χ.primitiveCharacter_apply_of_isCoprime
      (Nat.isCoprime_iff_coprime.mpr (hp.coprime_iff_not_dvd.mpr hdiv))
    simp only [Int.cast_natCast] at he
    rw [he, sub_self, norm_zero]
    split_ifs <;> norm_num

/-- The unweighted prime-sum correction is bounded by the number of distinct
prime divisors of the original level, uniformly in the finite prime set. -/
theorem norm_prime_sum_sub_primitive_le {q : ℕ} (hq : 0 < q)
    (χ : DirichletCharacter ℂ q) (S : Finset ℕ) (hS : ∀ p ∈ S, p.Prime) :
    ‖(∑ p ∈ S, χ (p : ZMod q)) -
      ∑ p ∈ S, χ.primitiveCharacter (p : ZMod χ.conductor)‖ ≤
      (q.primeFactors.card : ℝ) := by
  classical
  rw [← Finset.sum_sub_distrib]
  calc
    ‖∑ p ∈ S, (χ (p : ZMod q) - χ.primitiveCharacter (p : ZMod χ.conductor))‖ ≤
        ∑ p ∈ S, ‖χ (p : ZMod q) - χ.primitiveCharacter (p : ZMod χ.conductor)‖ :=
      norm_sum_le _ _
    _ ≤ ∑ p ∈ S, if p ∈ q.primeFactors then (1 : ℝ) else 0 :=
      Finset.sum_le_sum fun p hp => primitive_prime_value_error hq χ (hS p hp)
    _ = ((S.filter fun p => p ∈ q.primeFactors).card : ℝ) := by simp
    _ ≤ (q.primeFactors.card : ℝ) := by
      exact_mod_cast (Finset.card_le_card (show
        (S.filter fun p => p ∈ q.primeFactors) ⊆ q.primeFactors from
          fun p hp => (Finset.mem_filter.mp hp).2))

/-- Distinct prime factors consume at least one factor of two each. -/
theorem primeFactors_card_le_log_div_log_two {q : ℕ} (hq : 0 < q) :
    (q.primeFactors.card : ℝ) ≤ Real.log q / Real.log 2 := by
  have hpow : 2 ^ q.primeFactors.card ≤ q :=
    (Finset.pow_card_le_prod q.primeFactors (fun p => p) 2
      (fun p hp => (Nat.prime_of_mem_primeFactors hp).two_le)).trans
        (Nat.le_of_dvd hq (Nat.prod_primeFactors_dvd q))
  have hpow' : (2 : ℝ) ^ q.primeFactors.card ≤ q := by exact_mod_cast hpow
  have hh := Real.log_le_log (pow_pos (by norm_num : (0 : ℝ) < 2) _) hpow'
  rw [Real.log_pow] at hh
  exact (le_div_iff₀ (Real.log_pos (by norm_num : (1 : ℝ) < 2))).mpr hh

theorem primeFactors_card_le_two_log {q : ℕ} (hq : 0 < q) :
    (q.primeFactors.card : ℝ) ≤ 2 * Real.log q := by
  have hcard := primeFactors_card_le_log_div_log_two hq
  have hlog : (1 : ℝ) / 2 ≤ Real.log 2 := by
    have hh := Real.one_sub_inv_le_log_of_pos (by norm_num : (0 : ℝ) < 2)
    norm_num at hh ⊢
    exact hh
  have hm := (le_div_iff₀ (Real.log_pos (by norm_num : (1 : ℝ) < 2))).mp hcard
  have hc : (0 : ℝ) ≤ q.primeFactors.card := by positivity
  nlinarith

theorem norm_prime_sum_sub_primitive_le_two_log {q : ℕ} (hq : 0 < q)
    (χ : DirichletCharacter ℂ q) (S : Finset ℕ) (hS : ∀ p ∈ S, p.Prime) :
    ‖(∑ p ∈ S, χ (p : ZMod q)) -
      ∑ p ∈ S, χ.primitiveCharacter (p : ZMod χ.conductor)‖ ≤ 2 * Real.log q :=
  (norm_prime_sum_sub_primitive_le hq χ S hS).trans (primeFactors_card_le_two_log hq)

/-- The remaining analytic estimate may be restricted to primitive,
nonprincipal characters. This definition does not assert that estimate. -/
def PrimitivePrimeCharacterEstimate : Prop :=
  ∃ C : ℝ, 0 < C ∧ ∀ y : ℝ, 2 ≤ y → ∀ q : ℕ, 0 < q →
    ∀ χ : DirichletCharacter ℂ q, χ ≠ 1 → χ.IsPrimitive →
      ‖∑ p ∈ ambientPrimes y, χ (p : ZMod q)‖ ≤
        C * y ^ ((7 : ℝ) / 8) * (Real.log (5 * (q : ℝ) * y)) ^ 2

/-- Removing primitivity costs only an additive four in the uniform constant. -/
theorem uniformPrimeCharacterEstimate_of_primitive
    (h : PrimitivePrimeCharacterEstimate) : UniformPrimeCharacterEstimate := by
  obtain ⟨C, hC, hbound⟩ := h
  refine ⟨C + 4, by linarith, ?_⟩
  intro y hy q hq χ hχ
  let : NeZero q := ⟨hq.ne'⟩
  have hd : 0 < χ.conductor := Nat.pos_of_ne_zero χ.conductor_ne_zero
  have hdq : χ.conductor ≤ q := Nat.le_of_dvd hq χ.conductor_dvd_level
  have hprimitive : χ.primitiveCharacter ≠ 1 := by
    intro he
    apply hχ
    rw [← χ.changeLevel_primitiveCharacter, he, map_one]
  have hpbound := hbound y hy χ.conductor hd χ.primitiveCharacter hprimitive
    χ.primitiveCharacter_isPrimitive
  have hq1 : (1 : ℝ) ≤ q := by exact_mod_cast hq
  have hd1 : (1 : ℝ) ≤ χ.conductor := by exact_mod_cast hd
  have hq0 : (0 : ℝ) < q := by positivity
  have hy0 : 0 < y := by linarith
  have hlogd : 0 ≤ Real.log (5 * (χ.conductor : ℝ) * y) :=
    Real.log_nonneg (by nlinarith)
  have hlogs : Real.log (5 * (χ.conductor : ℝ) * y) ≤ Real.log (5 * (q : ℝ) * y) := by
    apply Real.log_le_log (by positivity)
    gcongr
  have hpbound' : ‖∑ p ∈ ambientPrimes y,
      χ.primitiveCharacter (p : ZMod χ.conductor)‖ ≤
      C * y ^ ((7 : ℝ) / 8) * (Real.log (5 * (q : ℝ) * y)) ^ 2 := by
    apply hpbound.trans
    gcongr
  have herr := norm_prime_sum_sub_primitive_le_two_log hq χ (ambientPrimes y)
    (fun p hp => ((mem_ambientPrimes_iff hy0.le).mp hp).1)
  have hlog2 : (1 : ℝ) / 2 ≤ Real.log 2 := by
    have hh := Real.one_sub_inv_le_log_of_pos (by norm_num : (0 : ℝ) < 2)
    norm_num at hh ⊢
    exact hh
  have hlogbig : (1 : ℝ) / 2 ≤ Real.log (5 * (q : ℝ) * y) :=
    hlog2.trans (Real.log_le_log (by norm_num) (by nlinarith))
  have hlogq : Real.log q ≤ Real.log (5 * (q : ℝ) * y) :=
    Real.log_le_log hq0 (by nlinarith)
  have hpow : 1 ≤ y ^ ((7 : ℝ) / 8) :=
    Real.one_le_rpow (by linarith) (by norm_num)
  have habsorb : 2 * Real.log q ≤
      4 * y ^ ((7 : ℝ) / 8) * (Real.log (5 * (q : ℝ) * y)) ^ 2 := by
    nlinarith [mul_nonneg (sub_nonneg.mpr hpow) (sq_nonneg (Real.log (5 * (q : ℝ) * y)))]
  calc
    ‖∑ p ∈ ambientPrimes y, χ (p : ZMod q)‖ =
        ‖((∑ p ∈ ambientPrimes y, χ (p : ZMod q)) -
          (∑ p ∈ ambientPrimes y, χ.primitiveCharacter (p : ZMod χ.conductor))) +
          (∑ p ∈ ambientPrimes y, χ.primitiveCharacter (p : ZMod χ.conductor))‖ := by
      rw [sub_add_cancel]
    _ ≤ ‖(∑ p ∈ ambientPrimes y, χ (p : ZMod q)) -
          (∑ p ∈ ambientPrimes y, χ.primitiveCharacter (p : ZMod χ.conductor))‖ +
          ‖∑ p ∈ ambientPrimes y, χ.primitiveCharacter (p : ZMod χ.conductor)‖ :=
      norm_add_le _ _
    _ ≤ 2 * Real.log q + C * y ^ ((7 : ℝ) / 8) * (Real.log (5 * (q : ℝ) * y)) ^ 2 :=
      add_le_add herr hpbound'
    _ ≤ (C + 4) * y ^ ((7 : ℝ) / 8) * (Real.log (5 * (q : ℝ) * y)) ^ 2 := by
      nlinarith
end

