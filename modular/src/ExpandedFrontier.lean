  have hq : (1 : ℝ) ≤ χ.modulus := by exact_mod_cast χ.positive
  have hden : 0 ≤ Real.log (14 / 13 : ℝ) := (Real.log_pos (by norm_num)).le
  calc
    _ ≤ (2 * T + 2) * (Real.log (48 * (χ.modulus : ℝ) * (T + 3)) / Real.log (14 / 13)) :=
      χ.right_zero_sum_bound T hT S hS
