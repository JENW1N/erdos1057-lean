      ω μ q ρ V steps
      (fullMixedBirthResidualPhase (fun g (p : ↥(P g)) => p.val)
        (fun a g => physicalFullSharedIndices (ell := ell) (C a g)) B
        (fun a _ => PhysicalAuxLabels P (C a))
        (fun a => physicalFullEdgeDelta (C a) (k a)) (fun a => physicalFullEdgeD (C a))
        (fun a H s e => physicalFullGlobalEdgePhase (C a) (k a) H (ω a) μ ρ V s e *
          physicalFullActiveFactor (C a) (k a)
            (physicalActiveCoefficient (C a) (after a) (C a) (ζ a) (fun _ _ _ => 1)) s e))
      initial code θ encode i f s =
    ∑ e : PhysicalFullEdgeEvent (C a) (k a) s,
      let t := fullActiveEdgeEventTarget (fun g (p : ↥(P g)) => p.val)
        (fun g => physicalFullSharedIndices (ell := ell) (C a g)) B
        (fun _ => PhysicalAuxLabels P (C a)) (physicalFullEdgeDelta (C a) (k a))
        (physicalFullEdgeD (C a)) s e
      (fullActiveEdgeEventWeight (fun g (p : ↥(P g)) => p.val)
        (fun g => physicalFullSharedIndices (ell := ell) (C a g)) B
        (fun _ => PhysicalAuxLabels P (C a)) (physicalFullEdgeDelta (C a) (k a))
        (physicalFullEdgeD (C a)) (ω a) μ ρ V s e : ℂ) *
      ((physicalFullGlobalEdgePhase (C a) (k a) (fun _ => ∅) (ω a) μ ρ V s e *
        (if hs : ∀ g, Function.Injective (s g).1 then
          if _ht : ∀ g, Function.Injective (t g).1 then
            physicalPhase (ζ a)
              (physicalSharedProduct (physicalSharedPrefix
                (fun g : {g // small g} => physicalActiveMarkLabels (C a) (fun g => (s g).1) hs g.val)) *
                physicalD (fun g : {g // ¬small g} => C a g.val)
                  (fun g => physicalActiveMarkLabels (C a) (fun g => (s g).1) hs g.val) (fun g => e.1 g.val))
          else 0
        else 0)) *
        (if FullMixedLocalBirthAvoids (J := Ghost) (fun g (p : ↥(P g)) => p.val)
          (fun a g => physicalFullSharedIndices (ell := ell) (C a g)) B
          (fun a _ => PhysicalAuxLabels P (C a))
          (fun a => physicalFullEdgeDelta (C a) (k a)) (fun a => physicalFullEdgeD (C a))
          initial (some (.inr a)) s e then 1 else 0)) * f t := by
  rw [full_mixed_untouched_edge_row _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ i hi a htag]
  apply sum_congr rfl
  intro e _
  dsimp only
  unfold physicalFullActiveFactor
  rw [physical_active_coefficient_one_small_empty small (C a) (after a) (C a) hC]

end Bounty
end

section

/- A positive gap between the preliminary rough mass and the actual logarithmic proxy sums. -/

open Finset Filter

namespace Bounty

theorem exists_candidate_positive_proxy_gap
    (hZ : PrimitiveZeroFreeHalfPlane) {c q S : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11 / 5 : ℝ) * (r : ℝ) * c = 1) (hS : 0 ≤ S) :
    ∃ κ qCut b : ℝ, ∃ h N : ℕ, ∃ M : Fin N → ℝ, ∃ J : ℕ,
      0 < κ ∧ κ ≤ 1 / 50 ∧ qCut = 1 / 2 - κ ∧ 0 < qCut ∧ qCut < 1 / 2 ∧
      0 < b ∧ b < qCut ∧ 1 ≤ h ∧ Even h ∧ b * (4 * (h : ℝ) + 2) < 1 / 2 ∧
      0 < N ∧
      (∀ i : Fin N,
        reciprocalGrid b qCut N (i : ℕ) < reciprocalGrid b qCut N ((i : ℕ) + 1) ∧
        0 < M i ∧ ∀ α ∈ Set.Icc (reciprocalGrid b qCut N (i : ℕ))
          (reciprocalGrid b qCut N ((i : ℕ) + 1)),
          buchstabDensity (reciprocalGrid b qCut N (i : ℕ)) (1 - α) ≤ M i) ∧
      (∑ i : Fin N, M i * Real.log
        (reciprocalGrid b qCut N ((i : ℕ) + 1) / reciprocalGrid b qCut N (i : ℕ))) ≤
          buchstabDensity b 1 - 1 + 1 / 16 ∧
      ∀ jStar : ℕ, J < jStar → ∀ᶠ L : ℝ in atTop,
        ∀ (F : Fin N → Finset (ℕ × ℕ)) (u : Fin N → ℕ × ℕ → ℕ)
          (B : Finset (ℕ × ℕ)) (uB : ℕ × ℕ → ℕ),
        (∀ i, ∀ w ∈ F i, u i w ∈ arithmeticProductWindow 1 (Real.exp L) ∧
          w.1 ∈ primeBand (Real.exp (reciprocalGrid b qCut N (i : ℕ) * L))
            (Real.exp (reciprocalGrid b qCut N ((i : ℕ) + 1) * L)) ∧
          w.1 * w.2 = 2 * u i w + 1) →
        (∀ w ∈ B, balancedPairWindow κ L w ∧
          uB w ∈ arithmeticProductWindow 1 (Real.exp L) ∧ w.1 * w.2 = 2 * uB w + 1) →
        (shiftedSieveRatioConstant / 3) * candidateCoefficientWindowMass c L q r jStar / L ≤
          candidateShiftedRoughMass c L q r jStar (Real.exp (b * L)) -
            (∑ i : Fin N, ∑ w ∈ F i, candidateCoefficient c L q r jStar (u i w) *
              roughTestLogarithmicProxy (reciprocalGrid b qCut N (i : ℕ)) L S w.2) -
            ∑ w ∈ B, candidateCoefficient c L q r jStar (uB w) *
              primeLogarithmicProxy L S w.1 * primeLogarithmicProxy L S w.2 := by
  obtain ⟨Kpre, hKpre, hpre⟩ := exists_candidate_shifted_rough_mass_density_lower hZ
  obtain ⟨Cbal, hCbal, Jbal, hbal⟩ :=
    exists_candidate_balanced_logarithmic_prime_proxy_bound hc hr hq0 hq1 hcenter
  obtain ⟨κ, qCut, b, h, N, M, hκ, hκup, hqCut, hqCut0, hqCuthalf, hb, hbq,
    hh, heven, hlevel, hκloss, hN, hbins, hmesh, hmargin⟩ :=
      exists_positive_buchstab_mesh_parameters Kpre Cbal hCbal.le
  have hstart (i : Fin N) : 0 < reciprocalGrid b qCut N (i : ℕ) :=
    hb.trans_le (reciprocal_grid_mem hbq.le hN (Nat.le_of_lt i.isLt)).1
  have hend (i : Fin N) : reciprocalGrid b qCut N ((i : ℕ) + 1) < 1 / 2 :=
    (reciprocal_grid_mem hbq.le hN (Nat.succ_le_of_lt i.isLt)).2.trans_lt hqCuthalf
  have hgap (i : Fin N) : reciprocalGrid b qCut N ((i : ℕ) + 1) <
      1 - reciprocalGrid b qCut N (i : ℕ) := by
    have hs := (reciprocal_grid_mem hbq.le hN (Nat.le_of_lt i.isLt)).2
    have he := hend i
    linarith
  obtain ⟨Junbal, hunbal⟩ := exists_candidate_unbalanced_rough_finite_bins_upper
    hZ hc hr hq0 hq1 hcenter hstart hstart (fun i => (hbins i).1.le) hend hgap hS
      (fun i => (hbins i).2.1.le) (fun i => (hbins i).2.2)
  obtain ⟨Jpre, hprebound⟩ := hpre c q b r h hc hr hq0 hq1 hcenter hb hh heven hlevel
  refine ⟨κ, qCut, b, h, N, M, max Jpre (max Junbal Jbal), hκ, hκup, hqCut,
    hqCut0, hqCuthalf, hb, hbq, hh, heven, hlevel, hN, hbins, hmesh, ?_⟩
  intro jStar hj
  have hjpre : Jpre < jStar := lt_of_le_of_lt (le_max_left _ _) hj
  have hjunbal : Junbal < jStar := lt_of_le_of_lt
    ((le_max_left Junbal Jbal).trans (le_max_right Jpre _)) hj
  have hjbal : Jbal < jStar := lt_of_le_of_lt
    ((le_max_right Junbal Jbal).trans (le_max_right Jpre _)) hj
  have hd : 0 < shiftedSieveRatioConstant :=
    lt_of_lt_of_le zero_lt_one shifted_sieve_ratio_constant_bounds.1
  have hε : 0 < shiftedSieveRatioConstant / 24 := by positivity
  filter_upwards [hprebound jStar hjpre _ hε, hunbal jStar hjunbal _ hε,
    hbal S hS, eventually_proxy_gap_reciprocal_bound (C := Cbal) hd] with L hpreL hunbalL hbalL htail
  intro F u B uB hF hB
  have hX : 0 ≤ candidateCoefficientWindowMass c L q r jStar := by
    apply sum_nonneg
    intro n hn
    exact candidate_coefficient_nonneg c L hq0 r jStar n
  have hu := hunbalL F u hF
  have hbL := hbalL κ hκ.le hκup jStar hjbal B uB
    (fun w hw => (hB w hw).1) (fun w hw => (hB w hw).2.2)
  have hm : shiftedSieveRatioConstant / 2 <
      (shiftedSieveRatioConstant * Mertens.primeProductLimitConstant / b) *
        (1 - Kpre * Real.exp (-(h : ℝ))) -
      shiftedSieveRatioConstant *
        (∑ i : Fin N, M i * Real.log
          (reciprocalGrid b qCut N ((i : ℕ) + 1) / reciprocalGrid b qCut N (i : ℕ))) -
      Cbal * κ := by
    convert hmargin using 1
    ring
  exact candidate_proxy_gap_arithmetic hd htail.1 hX htail.2 hm hpreL hu hbL

end Bounty

end

section

/- Exact ambient discrepancies as bilinear shifted-product sums with explicit coefficient masks. -/

open Finset Filter

namespace Bounty

noncomputable def shiftedTypeIIBilinear (T : Finset ℕ) (μ α β : ℕ → ℝ) : ℝ :=
  ∑ v ∈ shiftedFactorPairs T, μ (shiftedPairIndex v) * α v.1 * β v.2

noncomputable def typeIIRestrict (F : Finset ℕ) (f : ℕ → ℝ) (n : ℕ) : ℝ :=
  if n ∈ F then f n else 0

theorem typeIIRestrict_ne_zero_iff (F : Finset ℕ) (f : ℕ → ℝ) (n : ℕ) :
    typeIIRestrict F f n ≠ 0 ↔ n ∈ F ∧ f n ≠ 0 := by
  by_cases hn : n ∈ F <;> simp [typeIIRestrict, hn]

theorem typeIIRestrict_support_subset (F : Finset ℕ) (f : ℕ → ℝ) :
    Function.support (typeIIRestrict F f) ⊆ (F : Set ℕ) := by
  intro n hn
  exact ((typeIIRestrict_ne_zero_iff F f n).mp hn).1

theorem typeIIRestrict_finite_support (F : Finset ℕ) (f : ℕ → ℝ) :
    (Function.support (typeIIRestrict F f)).Finite :=
  F.finite_toSet.subset (typeIIRestrict_support_subset F f)

theorem shifted_typeII_bilinear_complex_cast (T : Finset ℕ) (μ α β : ℕ → ℝ) :
    (shiftedTypeIIBilinear T μ α β : ℂ) =
      ∑ v ∈ shiftedFactorPairs T, (μ (shiftedPairIndex v) : ℂ) * (α v.1 : ℂ) * (β v.2 : ℂ) := by
  simp only [shiftedTypeIIBilinear, Complex.ofReal_sum, Complex.ofReal_mul]

theorem typeIIRestrict_abs_le {F : Finset ℕ} {f : ℕ → ℝ} {C : ℝ}
    (hC : 0 ≤ C) (hf : ∀ n ∈ F, |f n| ≤ C) (n : ℕ) :
    |typeIIRestrict F f n| ≤ C := by
  by_cases hn : n ∈ F
  · simpa only [typeIIRestrict, if_pos hn] using hf n hn
  · simpa only [typeIIRestrict, if_neg hn, abs_zero] using hC

theorem shifted_factor_pairs_swap (T : Finset ℕ) (v : ℕ × ℕ) :
    v.swap ∈ shiftedFactorPairs T ↔ v ∈ shiftedFactorPairs T := by
  simp only [mem_shifted_factor_pairs_iff, Prod.fst_swap, Prod.snd_swap, mul_comm]

theorem shifted_typeII_bilinear_swap (T : Finset ℕ) (μ α β : ℕ → ℝ) :
    shiftedTypeIIBilinear T μ α β = shiftedTypeIIBilinear T μ β α := by
  classical
  unfold shiftedTypeIIBilinear
  refine sum_bij' (fun v _ => v.swap) (fun v _ => v.swap) ?_ ?_ ?_ ?_ ?_
  · intro v hv
    exact (shifted_factor_pairs_swap T v).mpr hv
  · intro v hv
    exact (shifted_factor_pairs_swap T v).mpr hv
  · intro v _
    exact Prod.swap_swap v
  · intro v _
    exact Prod.swap_swap v
  · intro v _
    simp only [shiftedPairIndex, Prod.fst_swap, Prod.snd_swap, mul_comm v.2 v.1]
    ring

theorem shifted_factor_pairs_coordinate_bounds (T : Finset ℕ) (H : ℕ)
    (hT : ∀ u ∈ T, 2*u+1 ≤ H) {v : ℕ × ℕ} (hv : v ∈ shiftedFactorPairs T) :
    v.1 ∈ Icc 1 H ∧ v.2 ∈ Icc 1 H := by
  obtain ⟨h1,h2,hu,hprod⟩ := shifted_factor_pair_properties T hv
  have hb : v.1*v.2 ≤ H := hprod ▸ hT (shiftedPairIndex v) hu
  exact ⟨mem_Icc.mpr ⟨h1,(Nat.le_mul_of_pos_right v.1 h2).trans hb⟩,
    mem_Icc.mpr ⟨h2,(Nat.le_mul_of_pos_left v.2 h1).trans hb⟩⟩

theorem shifted_typeII_bilinear_eq_double_sum (T : Finset ℕ) (μ α β : ℕ → ℝ)
    (H : ℕ) (hT : ∀ u ∈ T, 2*u+1 ≤ H) :
    shiftedTypeIIBilinear T μ α β =
      ∑ m ∈ Icc 1 H, ∑ n ∈ Icc 1 H,
        if ∃ u ∈ T, m*n = 2*u+1 then μ ((m*n-1)/2) * α m * β n else 0 := by
  classical
  have hset : shiftedFactorPairs T =
      ((Icc 1 H) ×ˢ (Icc 1 H)).filter (fun v : ℕ × ℕ => ∃ u ∈ T, v.1*v.2=2*u+1) := by
    ext v
    constructor
    · intro hv
      exact mem_filter.mpr ⟨mem_product.mpr (shifted_factor_pairs_coordinate_bounds T H hT hv),
        (mem_shifted_factor_pairs_iff T v).mp hv⟩
    · intro hv
      exact (mem_shifted_factor_pairs_iff T v).mpr (mem_filter.mp hv).2
  rw [shiftedTypeIIBilinear, hset, sum_filter, sum_product]
  rfl

theorem shifted_typeII_bilinear_restrict_left (T F : Finset ℕ) (μ α β : ℕ → ℝ)
    (hF : ∀ v ∈ shiftedFactorPairs T, v.1 ∈ F) :
    shiftedTypeIIBilinear T μ (typeIIRestrict F α) β = shiftedTypeIIBilinear T μ α β := by
  unfold shiftedTypeIIBilinear
  exact sum_congr rfl (fun v hv => by rw [typeIIRestrict, if_pos (hF v hv)])

noncomputable def ambientRoughTypeIIAlpha (γ L S : ℝ) (H : ℕ) : ℕ → ℝ :=
  typeIIRestrict (Icc 1 H) (fun n => roughTestIndicator γ L n - roughTestLogarithmicProxy γ L S n)

noncomputable def ambientRoughTypeIIBeta (A B : ℝ) : ℕ → ℝ :=
  typeIIRestrict (primeBand A B) (fun _ => 1)

theorem ambient_rough_proxy_error_eq_typeII (T : Finset ℕ) (μ : ℕ → ℝ)
    (γ L S A B : ℝ) (H : ℕ) (hT : ∀ u ∈ T, 2*u+1 ≤ H) :
    ambientRoughProxyError T μ γ L S A B =
      shiftedTypeIIBilinear T μ (ambientRoughTypeIIAlpha γ L S H) (ambientRoughTypeIIBeta A B) := by
  classical
  rw [ambientRoughTypeIIAlpha, shifted_typeII_bilinear_restrict_left T (Icc 1 H) μ _ _
    (fun v hv => (shifted_factor_pairs_coordinate_bounds T H hT hv).1),
    shifted_typeII_bilinear_swap]
  unfold ambientRoughProxyError shiftedPrimeBandPairs shiftedTypeIIBilinear ambientRoughTypeIIBeta
  rw [sum_filter]
  apply sum_congr rfl
  intro v _
  by_cases hv : v.1 ∈ primeBand A B <;> simp [typeIIRestrict, hv]

noncomputable def ambientBalancedTypeIIRange (κ L : ℝ) : Finset ℕ :=
  (Icc 1 ⌊Real.exp (((1/2 : ℝ)+2*κ)*L)⌋₊).filter
    (fun n => Real.exp (((1/2 : ℝ)-2*κ)*L) ≤ (n : ℝ))

theorem mem_ambientBalancedTypeIIRange (κ L : ℝ) (n : ℕ) :
    n ∈ ambientBalancedTypeIIRange κ L ↔
      Real.exp (((1/2 : ℝ)-2*κ)*L) ≤ (n : ℝ) ∧
      (n : ℝ) ≤ Real.exp (((1/2 : ℝ)+2*κ)*L) := by
  classical
  simp only [ambientBalancedTypeIIRange, mem_filter, mem_Icc]
  constructor
  · rintro ⟨⟨_,hupper⟩,hlower⟩
    exact ⟨hlower,(Nat.le_floor_iff (Real.exp_pos _).le).mp hupper⟩
  · rintro ⟨hlower,hupper⟩
    exact ⟨⟨Nat.cast_pos.mp ((Real.exp_pos _).trans_le hlower), Nat.le_floor hupper⟩,hlower⟩

theorem shifted_wide_window_factor_bound {L : ℝ} (hL : 0 ≤ L) {u : ℕ}
    (hu : u ∈ arithmeticProductWindow 1 (Real.exp L)) :
    Real.exp L ≤ ((2*u+1 : ℕ) : ℝ) ∧ ((2*u+1 : ℕ) : ℝ) ≤ 33*Real.exp L := by
  obtain ⟨hlo,hhi⟩ := (mem_arithmeticProductWindow_iff one_ne_zero (Real.exp L)).mp hu
  simp only [one_mul] at hlo hhi
  have hE := Real.one_le_exp hL
  push_cast
  constructor <;> nlinarith [Real.exp_pos L]

theorem shifted_wide_window_nat_factor_bound {L : ℝ} (hL : 0 ≤ L) {u : ℕ}
    (hu : u ∈ arithmeticProductWindow 1 (Real.exp L)) :
    2*u+1 ≤ ⌊33*Real.exp L⌋₊ := Nat.le_floor (shifted_wide_window_factor_bound hL hu).2

theorem balanced_pair_window_iff_typeII_ranges {κ L : ℝ} (hL : 0 ≤ L)
    {v : ℕ × ℕ} (hv : v ∈ shiftedFactorPairs (arithmeticProductWindow 1 (Real.exp L))) :
    balancedPairWindow κ L v ↔
      v.1 ∈ ambientBalancedTypeIIRange κ L ∧ v.2 ∈ ambientBalancedTypeIIRange κ L := by
  have hdata := shifted_factor_pair_properties _ hv
  have hprod := shifted_wide_window_factor_bound hL hdata.2.2.1
  rw [← hdata.2.2.2] at hprod
  simp only [balancedPairWindow, mem_ambientBalancedTypeIIRange]
  tauto

noncomputable def ambientPrimeTypeIIAlpha (κ L S : ℝ) : ℕ → ℝ :=
  typeIIRestrict (ambientBalancedTypeIIRange κ L)
    (fun n => (if n.Prime then 1 else 0 : ℝ) - primeLogarithmicProxy L S n)

noncomputable def ambientPrimeTypeIIBeta (κ L : ℝ) : ℕ → ℝ :=
  typeIIRestrict (ambientBalancedTypeIIRange κ L) (fun n => if n.Prime then 1 else 0)

noncomputable def ambientProxyTypeIIBeta (κ L S : ℝ) : ℕ → ℝ :=
  typeIIRestrict (ambientBalancedTypeIIRange κ L) (primeLogarithmicProxy L S)

theorem ambient_prime_proxy_error_eq_typeII {κ L : ℝ} (hL : 0 ≤ L)
    (μ : ℕ → ℝ) (S : ℝ) :
    ambientPrimeProxyError (arithmeticProductWindow 1 (Real.exp L)) μ κ L S =
      shiftedTypeIIBilinear (arithmeticProductWindow 1 (Real.exp L)) μ
        (ambientPrimeTypeIIAlpha κ L S) (ambientPrimeTypeIIBeta κ L) +
      shiftedTypeIIBilinear (arithmeticProductWindow 1 (Real.exp L)) μ
        (ambientPrimeTypeIIAlpha κ L S) (ambientProxyTypeIIBeta κ L S) := by
  classical
  rw [shifted_typeII_bilinear_swap _ μ (ambientPrimeTypeIIAlpha κ L S)
    (ambientProxyTypeIIBeta κ L S)]
  unfold ambientPrimeProxyError shiftedBalancedPairs shiftedTypeIIBilinear
  rw [sum_filter, ← sum_add_distrib]
  apply sum_congr rfl
  intro v hv
  rw [balanced_pair_window_iff_typeII_ranges hL hv]
  unfold ambientPrimeTypeIIAlpha ambientPrimeTypeIIBeta ambientProxyTypeIIBeta typeIIRestrict
  by_cases hm : v.1 ∈ ambientBalancedTypeIIRange κ L <;>
    by_cases hn : v.2 ∈ ambientBalancedTypeIIRange κ L <;>
    simp only [hm,hn,and_self,and_false,false_and,if_true,if_false,mul_zero,zero_mul,add_zero]
  ring

theorem rough_test_discrepancy_rough_support {γ L S : ℝ}
    (hcut : Real.sqrt L ≤ γ*L) {n : ℕ}
    (hn : roughTestIndicator γ L n - roughTestLogarithmicProxy γ L S n ≠ 0) :
    ∀ p ∈ n.primeFactors, Real.exp (Real.sqrt L) < (p : ℝ) := by
  classical
  by_cases ht : exponentialRoughTest γ L n
  · intro p hp
    exact (Real.exp_le_exp.mpr hcut).trans_lt (ht p hp)
  · have hproxy : roughTestLogarithmicProxy γ L S n ≠ 0 := by
      intro hz
      exact hn (by simp only [roughTestIndicator, if_neg ht, hz, sub_self])
    exact rough_test_logarithmic_proxy_support hproxy

theorem prime_test_discrepancy_rough_support {L S : ℝ} {n : ℕ}
    (hnlarge : Real.exp (Real.sqrt L) < (n : ℝ))
    (hn : (if n.Prime then 1 else 0 : ℝ) - primeLogarithmicProxy L S n ≠ 0) :
    ∀ p ∈ n.primeFactors, Real.exp (Real.sqrt L) < (p : ℝ) := by
  classical
  by_cases hp : n.Prime
  · rw [hp.primeFactors]
    intro p hp'
    simpa only [mem_singleton.mp hp'] using hnlarge
  · have hproxy : primeLogarithmicProxy L S n ≠ 0 := by
      intro hz
      exact hn (by simp only [if_neg hp, hz, sub_self])
    exact (mem_filter.mp (prime_cell_proxy_ne_zero_mem hproxy)).2

theorem eventually_rough_typeII_restriction_properties {γ : ℝ} (hγ : 0 < γ) :
    ∀ᶠ L : ℝ in atTop, ∀ (S : ℝ) (F : Finset ℕ) (n : ℕ),
      |typeIIRestrict F (fun m => roughTestIndicator γ L m - roughTestLogarithmicProxy γ L S m) n| ≤ 1 ∧
      (typeIIRestrict F (fun m => roughTestIndicator γ L m - roughTestLogarithmicProxy γ L S m) n ≠ 0 →
        n ∈ F ∧ ∀ p ∈ n.primeFactors, Real.exp (Real.sqrt L) < (p : ℝ)) := by
  filter_upwards [eventually_rough_test_proxy_cutoff hγ,
    eventually_rough_test_logarithmic_proxy_bounds hγ] with L hcut hbound
  intro S F n
  refine ⟨typeIIRestrict_abs_le zero_le_one (fun m _ => (hbound S m).2.2) n, ?_⟩
  intro hn
  obtain ⟨hnF,hnd⟩ := (typeIIRestrict_ne_zero_iff F _ n).mp hn
  exact ⟨hnF, rough_test_discrepancy_rough_support hcut hnd⟩

theorem ambient_rough_typeII_beta_properties (A B : ℝ) (n : ℕ) :
    |ambientRoughTypeIIBeta A B n| ≤ 1 ∧
      (ambientRoughTypeIIBeta A B n ≠ 0 → n ∈ primeBand A B ∧ n.Prime) := by
  refine ⟨typeIIRestrict_abs_le zero_le_one (by intros; norm_num) n, ?_⟩
  intro hn
  have hmem := ((typeIIRestrict_ne_zero_iff (primeBand A B) _ n).mp hn).1
  exact ⟨hmem,(mem_filter.mp hmem).2⟩

theorem ambient_prime_typeII_beta_abs_le (κ L : ℝ) (n : ℕ) :
    |ambientPrimeTypeIIBeta κ L n| ≤ 1 := by
  apply typeIIRestrict_abs_le zero_le_one
  intro m _
  split <;> norm_num

theorem eventually_balanced_typeII_coefficient_properties (S : ℝ) (hS : 0 ≤ S) :
    ∀ᶠ L : ℝ in atTop, ∀ κ : ℝ, 0 ≤ κ → κ ≤ 1/50 → ∀ n : ℕ,
      |ambientPrimeTypeIIAlpha κ L S n| ≤ 1 ∧
      |ambientPrimeTypeIIBeta κ L n| ≤ 1 ∧
      |ambientProxyTypeIIBeta κ L S n| ≤ 1 ∧
      (ambientPrimeTypeIIAlpha κ L S n ≠ 0 →
        n ∈ ambientBalancedTypeIIRange κ L ∧
        ∀ p ∈ n.primeFactors, Real.exp (Real.sqrt L) < (p : ℝ)) := by
  obtain ⟨C,hC,hbound⟩ := exists_prime_logarithmic_proxy_uniform_bound
    (by norm_num : (0 : ℝ) < 1/5)
  filter_upwards [hbound S hS,
    eventually_sqrt_le_dyadic_scale (by norm_num : (0 : ℝ) < 1/5) 0,
    eventually_gt_atTop (0 : ℝ)] with L hb hsqrt hL
  intro κ hκ hκmax n
  simp only [pow_zero, div_one] at hsqrt
  have hsize (m : ℕ) (hm : m ∈ ambientBalancedTypeIIRange κ L) :
      Real.exp ((1/5 : ℝ)*L) ≤ (m : ℝ) ∧ Real.exp (Real.sqrt L) < (m : ℝ) := by
    have hlo := ((mem_ambientBalancedTypeIIRange κ L m).mp hm).1
    have hexp : (1/5 : ℝ)*L < ((1/2 : ℝ)-2*κ)*L := by nlinarith
    exact ⟨(Real.exp_le_exp.mpr hexp.le).trans hlo,
      (Real.exp_lt_exp.mpr (hsqrt.trans_lt hexp)).trans_le hlo⟩
  refine ⟨typeIIRestrict_abs_le zero_le_one (fun m hm => (hb m (hsize m hm).1).2.2.2) n,
    ambient_prime_typeII_beta_abs_le κ L n, ?_, ?_⟩
  · apply typeIIRestrict_abs_le zero_le_one
    intro m hm
    have h := hb m (hsize m hm).1
    simpa only [abs_of_nonneg h.1] using h.2.1
  · intro hn
    obtain ⟨hnF,hnd⟩ := (typeIIRestrict_ne_zero_iff _ _ n).mp hn
    exact ⟨hnF, prime_test_discrepancy_rough_support (hsize n hnF).2 hnd⟩

noncomputable def ambientRoughCofactorRange (L a v : ℝ) : Finset ℕ :=
  (Icc 1 ⌊33*Real.exp L⌋₊).filter (fun m =>
    Real.exp ((1-v)*L) ≤ (m : ℝ) ∧ (m : ℝ) ≤ 33*Real.exp ((1-a)*L))

noncomputable def ambientRoughIntervalTypeIIAlpha (γ L S a v : ℝ) : ℕ → ℝ :=
  typeIIRestrict (ambientRoughCofactorRange L a v)
    (fun m => roughTestIndicator γ L m - roughTestLogarithmicProxy γ L S m)

theorem ambient_rough_cofactor_range_eq_Icc (L a v : ℝ) :
    ambientRoughCofactorRange L a v =
      Icc (max 1 ⌈Real.exp ((1-v)*L)⌉₊)
        (min ⌊33*Real.exp L⌋₊ ⌊33*Real.exp ((1-a)*L)⌋₊) := by
  ext n
  simp only [ambientRoughCofactorRange, mem_filter, mem_Icc, max_le_iff, le_min_iff,
    Nat.ceil_le, Nat.le_floor_iff (by positivity : 0 ≤ 33*Real.exp ((1-a)*L))]
  tauto

theorem ambient_balanced_typeII_range_eq_Icc (κ L : ℝ) :
    ambientBalancedTypeIIRange κ L =
      Icc (max 1 ⌈Real.exp (((1/2 : ℝ)-2*κ)*L)⌉₊) ⌊Real.exp (((1/2 : ℝ)+2*κ)*L)⌋₊ := by
  ext n
  simp only [ambientBalancedTypeIIRange, mem_filter, mem_Icc, max_le_iff, Nat.ceil_le]
  tauto

theorem shifted_prime_band_cofactor_range {L a v : ℝ} (hL : 0 ≤ L)
    {w : ℕ × ℕ} (hw : w ∈ shiftedPrimeBandPairs (arithmeticProductWindow 1 (Real.exp L))
      (Real.exp (a*L)) (Real.exp (v*L))) :
    w.2 ∈ ambientRoughCofactorRange L a v := by
  have hdata := shifted_prime_band_pair_data _ _ _ hw
  have hfac := (mem_filter.mp hw).1
  have hcoords := shifted_factor_pairs_coordinate_bounds
    (arithmeticProductWindow 1 (Real.exp L)) ⌊33*Real.exp L⌋₊
    (fun _ hu => shifted_wide_window_nat_factor_bound hL hu) hfac
  have hband := (mem_primeBand_iff (Real.exp_pos (a*L)).le
    (Real.exp_pos (v*L)).le w.1).mp hdata.2.1
  have hprod := shifted_wide_window_factor_bound hL hdata.1
  rw [← hdata.2.2, Nat.cast_mul] at hprod
  refine mem_filter.mpr ⟨hcoords.2, ?_, ?_⟩
  · apply (mul_le_mul_iff_left₀ (Real.exp_pos (v*L))).mp
    calc
      Real.exp ((1-v)*L) * Real.exp (v*L) = Real.exp L := by
        rw [← Real.exp_add]
        congr 1
        ring
      _ ≤ (w.1 : ℝ) * (w.2 : ℝ) := hprod.1
      _ ≤ (w.2 : ℝ) * Real.exp (v*L) := by
        simpa only [mul_comm] using mul_le_mul_of_nonneg_right hband.2.2 (Nat.cast_nonneg w.2)
  · apply (mul_le_mul_iff_right₀ (Real.exp_pos (a*L))).mp
    calc
      Real.exp (a*L) * (w.2 : ℝ) ≤ (w.1 : ℝ) * (w.2 : ℝ) :=
        mul_le_mul_of_nonneg_right hband.2.1.le (Nat.cast_nonneg w.2)
      _ ≤ 33*Real.exp L := hprod.2
      _ = Real.exp (a*L) * (33*Real.exp ((1-a)*L)) := by
        have he : Real.exp (a*L) * Real.exp ((1-a)*L) = Real.exp L := by
          rw [← Real.exp_add]
          congr 1
          ring
        rw [← he]
        ring

theorem ambient_rough_proxy_error_eq_interval_typeII {L : ℝ} (hL : 0 ≤ L)
    (μ : ℕ → ℝ) (γ S a v : ℝ) :
    ambientRoughProxyError (arithmeticProductWindow 1 (Real.exp L)) μ γ L S
      (Real.exp (a*L)) (Real.exp (v*L)) =
      shiftedTypeIIBilinear (arithmeticProductWindow 1 (Real.exp L)) μ
        (ambientRoughIntervalTypeIIAlpha γ L S a v)
        (ambientRoughTypeIIBeta (Real.exp (a*L)) (Real.exp (v*L))) := by
  classical
  rw [shifted_typeII_bilinear_swap]
  unfold ambientRoughProxyError shiftedPrimeBandPairs shiftedTypeIIBilinear
  rw [sum_filter]
  apply sum_congr rfl
  intro w hw
  by_cases hp : w.1 ∈ primeBand (Real.exp (a*L)) (Real.exp (v*L))
  · have hm := shifted_prime_band_cofactor_range hL (mem_filter.mpr ⟨hw,hp⟩)
    simp only [if_pos hp, ambientRoughIntervalTypeIIAlpha, ambientRoughTypeIIBeta,
      typeIIRestrict, if_pos hm, mul_one]
  · simp only [if_neg hp, ambientRoughIntervalTypeIIAlpha, ambientRoughTypeIIBeta,
      typeIIRestrict, mul_zero, zero_mul]

theorem ambient_rough_interval_typeII_support (γ L S a v : ℝ) :
    Function.support (ambientRoughIntervalTypeIIAlpha γ L S a v) ⊆
      {m : ℕ | 1 ≤ m ∧ m ≤ ⌊33*Real.exp L⌋₊ ∧
        Real.exp ((1-v)*L) ≤ (m : ℝ) ∧ (m : ℝ) ≤ 33*Real.exp ((1-a)*L)} := by
  intro m hm
  have h := ((typeIIRestrict_ne_zero_iff _ _ m).mp hm).1
  exact ⟨(mem_Icc.mp (mem_filter.mp h).1).1, (mem_Icc.mp (mem_filter.mp h).1).2,
    (mem_filter.mp h).2⟩

theorem ambient_balanced_typeII_support (κ L S : ℝ) :
    Function.support (ambientPrimeTypeIIAlpha κ L S) ⊆ (ambientBalancedTypeIIRange κ L : Set ℕ) ∧
    Function.support (ambientPrimeTypeIIBeta κ L) ⊆ (ambientBalancedTypeIIRange κ L : Set ℕ) ∧
    Function.support (ambientProxyTypeIIBeta κ L S) ⊆ (ambientBalancedTypeIIRange κ L : Set ℕ) :=
  ⟨typeIIRestrict_support_subset _ _, typeIIRestrict_support_subset _ _, typeIIRestrict_support_subset _ _⟩

theorem eventually_ambient_rough_interval_typeII_properties {γ : ℝ} (hγ : 0 < γ) :
    ∀ᶠ L : ℝ in atTop, ∀ (S a v : ℝ) (m : ℕ),
      |ambientRoughIntervalTypeIIAlpha γ L S a v m| ≤ 1 ∧
      (ambientRoughIntervalTypeIIAlpha γ L S a v m ≠ 0 →
        m ∈ ambientRoughCofactorRange L a v ∧
        ∀ p ∈ m.primeFactors, Real.exp (Real.sqrt L) < (p : ℝ)) := by
  filter_upwards [eventually_rough_typeII_restriction_properties hγ] with L hL
  intro S a v m
  exact hL S (ambientRoughCofactorRange L a v) m

theorem ambient_buchstab_mesh_error_eq_typeII {L : ℝ} (hL : 0 ≤ L)
    (μ : ℕ → ℝ) (b q κ S : ℝ) (N : ℕ) :
    ambientBuchstabMeshError (arithmeticProductWindow 1 (Real.exp L)) μ b q κ L S N =
      (∑ i : Fin N, shiftedTypeIIBilinear (arithmeticProductWindow 1 (Real.exp L)) μ
        (ambientRoughIntervalTypeIIAlpha (reciprocalGrid b q N (i : ℕ)) L S
          (reciprocalGrid b q N (i : ℕ)) (reciprocalGrid b q N ((i : ℕ)+1)))
        (ambientRoughTypeIIBeta (Real.exp (reciprocalGrid b q N (i : ℕ)*L))
          (Real.exp (reciprocalGrid b q N ((i : ℕ)+1)*L)))) +
      shiftedTypeIIBilinear (arithmeticProductWindow 1 (Real.exp L)) μ
        (ambientPrimeTypeIIAlpha κ L S) (ambientPrimeTypeIIBeta κ L) +
      shiftedTypeIIBilinear (arithmeticProductWindow 1 (Real.exp L)) μ
        (ambientPrimeTypeIIAlpha κ L S) (ambientProxyTypeIIBeta κ L S) := by
  unfold ambientBuchstabMeshError
  simp_rw [ambient_rough_proxy_error_eq_interval_typeII hL]
  rw [ambient_prime_proxy_error_eq_typeII hL]
  ring

end Bounty

end

section

/- Every row is the actual signed ghost row, the two permutation averages,
or the sum of actual mixed full actions over one pattern and one auxiliary. -/

open Finset
open scoped Classical
namespace Bounty
section Rows
variable {S G I V K : Type} [Fintype S] [Fintype G] [DecidableEq G]
  [Fintype I] {Ps : S → Finset ℕ} {P : G → Type} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] {J ell : ℕ} {M : G → ℕ}
  (shared : I → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : I → Type) [∀ i, Fintype (A i)]
  (Δ D : ∀ _k : K, ∀ i, PhysicalSharedLists Ps J → SharedActiveLabels P (shared i) → A i → G → ℤ)
  (kbig : ∀ _k : K, ∀ i, SharedActiveLabels P (shared i) → A i → ℤ)
  (ω : ∀ i, SharedActiveLabels P (shared i) → A i → ℝ)
  (μ : ∀ g, P g → ℝ) (qghost : V → ℝ) (ρ : ℝ) (Vb : G → ℝ)
  (Vs : S → ℝ) (qedge : K → ℝ)
  (phase : ∀ tag s, PhysicalMixedWordEvent (ell := ell) n shared B A Δ D tag s → ℂ)

noncomputable def physicalMixedWordRow :=
  let _ : ∀ tag s, Fintype (PhysicalMixedWordEvent (ell := ell) (V := V) n shared B A Δ D tag s) :=
    physicalMixedWordEventFintype (ell := ell) (V := V) n shared B A Δ D
  finiteLocalPhasedRow (PhysicalMixedWordEvent (ell := ell) (V := V) n shared B A Δ D)
    (physicalMixedWordTarget n shared B A Δ D kbig) phase
    (physicalMixedWordWeight n shared B A Δ D kbig ω μ qghost ρ Vb Vs qedge)

theorem physical_mixed_word_row_edge (k : K)
    (F : PhysicalMixedWordState (Ps := Ps) (J := J) (ell := ell) (M := M) n B → ℂ)
    (s : PhysicalMixedWordState (Ps := Ps) (J := J) (ell := ell) (M := M) n B) :
    physicalMixedWordRow n shared B A Δ D kbig ω μ qghost ρ Vb Vs qedge phase
      (some (.inr k)) F s =
    ∑ i : I, ∑ a : A i, (ω i (productActiveMemorySplit (shared i) B s.2).1 a : ℂ) *
      physicalSmallBigFullPhasedAction n (shared i) B
        (fun d c => Δ k i d c a) (fun d c => D k i d c a) μ ρ Vb
        (fun c => kbig k i c a) Vs (qedge k)
        (fun s e => phase (some (.inr k)) s ⟨i, a, e⟩) F s := by
  unfold physicalMixedWordRow finiteLocalPhasedRow
  change (∑ e : Σ i : I, Σ a : A i, _, _) = _
  rw [Fintype.sum_sigma]
  apply sum_congr rfl
  intro i _
  rw [Fintype.sum_sigma]
  apply sum_congr rfl
  intro a _
  unfold physicalSmallBigFullPhasedAction physicalSmallBigPhasedAction
  rw [mul_sum]
  apply sum_congr rfl
  intro e _
  simp only [physicalMixedWordWeight, physicalMixedWordTarget, Complex.ofReal_mul]
  ring

theorem physical_mixed_word_row_ghost (j : V)
    (F : PhysicalMixedWordState (Ps := Ps) (J := J) (ell := ell) (M := M) n B → ℂ)
    (s : PhysicalMixedWordState (Ps := Ps) (J := J) (ell := ell) (M := M) n B) :
    physicalMixedWordRow n shared B A Δ D kbig ω μ qghost ρ Vb Vs qedge phase
      (some (.inl j)) F s =
    ∑ e : CoupledGhostEvent M B s.2,
      (coupledGhostJointEventWeight
        (fun g => physicalGhostRetention (n g) (qghost j) ρ)
        (fun g => physicalGhostTermination (n g) (qghost j) ρ)
        (fun g => physicalGhostBirth (n g) (qghost j) ρ (Vb g))
        (fun g => unrestrictedResidueWeight (μ g)) M B s.2 e : ℂ) *
      phase (some (.inl j)) s e * F (s.1, coupledGhostJointEventTarget M B s.2 e) := rfl

theorem physical_mixed_word_row_permutation
    (hphase : ∀ s e, phase none s e = 1)
    (F : PhysicalMixedWordState (Ps := Ps) (J := J) (ell := ell) (M := M) n B → ℂ)
    (s : PhysicalMixedWordState (Ps := Ps) (J := J) (ell := ell) (M := M) n B) :
    physicalMixedWordRow n shared B A Δ D kbig ω μ qghost ρ Vb Vs qedge phase none F s =
    (Fintype.card (PhysicalPermutations S J ell) : ℂ)⁻¹ *
      ∑ σ : PhysicalPermutations S J ell,
        fullActiveAverage (fun x => F ((s.1.1, physicalPermuteLabels σ s.1.2), x)) s.2 := by
  unfold physicalMixedWordRow finiteLocalPhasedRow
  change (∑ e : PhysicalPermutations S J ell × FullActiveSlotPermutations M, _) = _
  rw [Fintype.sum_prod_type, mul_sum]
  apply sum_congr rfl
  intro σ _
  unfold fullActiveAverage
  rw [mul_sum]
  apply sum_congr rfl
  intro τ _
  simp only [physicalMixedWordWeight, physicalMixedWordTarget,
    Complex.ofReal_mul, Complex.ofReal_inv, Complex.ofReal_natCast]
  rw [hphase s (σ, τ), mul_one]
  ring
end Rows
end Bounty
end

section

/- Fixing the small permutation and target-mark choices determines the small
prefix at each edge. The remaining path is an original full big-memory path. -/

open Finset
open scoped Classical
namespace Bounty

section Plans
variable {S I V K : Type} {Ps : S → Finset ℕ} {J ell : ℕ}

def PhysicalMixedSmallPlan : List (Option (V ⊕ K)) → Type
  | [] => PUnit
  | none :: ks => PhysicalPermutations S J ell × PhysicalMixedSmallPlan ks
  | some (.inl _) :: ks => PhysicalMixedSmallPlan ks
  | some (.inr _) :: ks => (I × PhysicalMarkLists Ps J ell) × PhysicalMixedSmallPlan ks

noncomputable abbrev physicalMixedSmallPlanFintype [Fintype S] [Fintype I] :
    ∀ ks, Fintype (PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) (V := V) (K := K) ks)
  | [] => inferInstanceAs (Fintype PUnit)
  | none :: ks => let _ := physicalMixedSmallPlanFintype ks; inferInstanceAs (Fintype (_ × _))
  | some (.inl _) :: ks => physicalMixedSmallPlanFintype ks
  | some (.inr _) :: ks => let _ := physicalMixedSmallPlanFintype ks; inferInstanceAs (Fintype (_ × _))

abbrev PhysicalMixedBigKey := K × I × PhysicalMarkLists Ps J ell × PhysicalMarkLists Ps J ell

def physicalMixedBigSteps : ∀ ks : List (Option (V ⊕ K)), PhysicalMarkLists Ps J ell →
    PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) ks → List (Option (V ⊕ PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K)))
  | [], _, _ => []
  | none :: ks, L, (σ, pl) => none :: physicalMixedBigSteps ks (physicalPermuteLabels σ L) pl
  | some (.inl j) :: ks, L, pl => some (.inl j) :: physicalMixedBigSteps ks L pl
  | some (.inr k) :: ks, L, ((i, R), pl) => some (.inr (k, i, L, R)) :: physicalMixedBigSteps ks R pl

end Plans

section Big
variable {S G I V K : Type} [Fintype S] [Fintype G] [DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Type} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : I → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : I → Type)
  (Δ D : ∀ _k : K, ∀ i, PhysicalSharedLists Ps J → SharedActiveLabels P (shared i) → A i → G → ℤ)

abbrev PhysicalMixedPlannedBigPath (ks : List (Option (V ⊕ K)))
    (L : PhysicalMarkLists Ps J ell) (pl : PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) ks)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :=
  FullPermutationMixedPath n
    (fun key : PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K) => shared key.2.1) B
    (fun key _ => A key.2.1)
    (fun key c a => Δ key.1 key.2.1 (physicalSharedPrefix key.2.2.1) c a)
    (fun key c a => D key.1 key.2.1 (physicalSharedPrefix key.2.2.1) c a)
    (physicalMixedBigSteps ks L pl) x

end Big
end Bounty
end

section

/- The only extra real factor relative to the original full big event is
the small completion/vertex factor, or one small permutation normalizer. -/

open Finset
open scoped Classical
namespace Bounty
section Weight
variable {S G I V K : Type} [Fintype S] [Fintype G] [DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Type}
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : I → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : I → Type)
  (Δ D : ∀ _k : K, ∀ i, PhysicalSharedLists Ps J → SharedActiveLabels P (shared i) → A i → G → ℤ)
  (kbig : ∀ _k : K, ∀ i, SharedActiveLabels P (shared i) → A i → ℤ)
  (Vs : S → ℝ) (qedge : K → ℝ)

noncomputable def physicalMixedSmallWeight (tag : Option (V ⊕ K))
    (s : PhysicalMixedWordState (Ps := Ps) (J := J) (ell := ell) (M := M) n B) :
    PhysicalMixedWordEvent n shared B A Δ D tag s → ℝ :=
  match tag with
  | none => fun _ => (Fintype.card (PhysicalPermutations S J ell) : ℝ)⁻¹
  | some (.inl _) => fun _ => 1
  | some (.inr k) => fun e =>
      if physicalSharedPrefix s.1.2 = physicalSharedPrefix e.2.2.1 then
        physicalCompletionMass Vs (fun _ => (∅ : Finset (Fin J))) ell *
        (physicalResidueVertexWeight s.1.2 (Real.sqrt (qedge k)) s.1.1 *
          physicalResidueVertexWeight e.2.2.1 (Real.sqrt (qedge k))
            (physicalTranslateResidues s.1.1
              (kbig k e.1 (productActiveMemorySplit (shared e.1) B s.2).1 e.2.1 *
                (physicalSharedProduct (physicalSharedPrefix s.1.2) : ℕ))))
      else 0

theorem physical_mixed_word_edge_weight_factor
    (ω : ∀ i, SharedActiveLabels P (shared i) → A i → ℝ)
    (μ : ∀ g, P g → ℝ) (qghost : V → ℝ) (ρ : ℝ) (Vb : G → ℝ)
    (k : K) (s : PhysicalMixedWordState (Ps := Ps) (J := J) (ell := ell) (M := M) n B)
    (e : PhysicalMixedWordEdge n shared B A Δ D k s) :
    physicalMixedWordWeight n shared B A Δ D kbig ω μ qghost ρ Vb Vs qedge (some (.inr k)) s e =
      physicalMixedSmallWeight (V := V) n shared B A Δ D kbig Vs qedge (some (.inr k)) s e *
      fullActiveEdgeEventWeight n (shared e.1) B (fun _ => A e.1)
        (Δ k e.1 (physicalSharedPrefix s.1.2)) (D k e.1 (physicalSharedPrefix s.1.2))
        (ω e.1) μ ρ Vb s.2
        (fullActiveFixedAuxEvent n (shared e.1) B
          (Δ k e.1 (physicalSharedPrefix s.1.2)) (D k e.1 (physicalSharedPrefix s.1.2))
          s.2 e.2.1 e.2.2.2) := by
  simp only [physicalMixedWordWeight, physicalMixedSmallWeight, physicalSmallBigPositiveWeight,
    physicalSmallBigFullWeight, fullActiveEdgeEventWeight, fullActiveFixedAuxEvent, one_mul]
  split_ifs <;> ring

end Weight
end Bounty
end

section

/- Partial normalization retains every original finite path and only the original return indicator. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_finite_root_term_partial_unrestricted
    {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    [∀ a : PhysicalPrime P, NeZero a.2.val]
    (groups : Finset (Fin N)) (V : Fin N → ℝ) (patterns : Finset I)
    (C : I → Fin N → Finset (Fin J)) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ)
    (L : PhysicalMarkLists P J ell)
    (p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)
    (hV : ∀ g, 0 < V g)
    (hP : ∀ g a, a ∈ P g → Nat.Prime a)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hk : ∀ j : Fin (n + 1), ∀ g s,
      ¬ (((physicalPathSelectedEquiv patterns C (L, p)).2.2.1 j.castSucc g s).val : ℤ) ∣
        physicalPathSelectedMultiplier C k p j)
    (b : PhysicalPrime P → ℝ)
    (hb : ∀ a : PhysicalPrime P, a.1 ∈ groups →
      b a = 1 - (∑ j ∈ range (n + 2), (1 - physicalEndpointSchedule q (n + 1) j)) / a.2.val)
    (hb0 : ∀ a : PhysicalPrime P, a.1 ∈ groups → b a ≠ 0) :
    (physicalStateMass V J ell : ℂ) * physicalFiniteReturnScalar V patterns C ζ k K n L p *
      (physicalFiniteVertexExpectation C q k n L p : ℂ) =
    if physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p) (n + 1) (n + 1) = 0 then
      (physicalGroupPathMass V groupsᶜ
        (fun j => C (finitePathLabels p j).2.2.1.val) ell (n + 1) : ℂ) *
        physicalMemoryWalkScalar V patterns C ζ K (finitePathLabels p) (finitePathMarks L p) (n + 1) *
        (poolPathResidueExpectation (fun a : PhysicalPrime P => a.2.val)
          (physicalPrimeGroups P groupsᶜ) (range (n + 2))
          (fun a => (range (n + 2)).filter (fun j => a ∈ physicalMarkedPrimes (finitePathMarks L p j)))
          (fun a j => -(physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p)
            (n + 1) j : ZMod a.2.val))
          (fun j => 1 - physicalEndpointSchedule q (n + 1) j) : ℝ) *
        (∏ a ∈ physicalPrimeGroups P groups, b a : ℝ) *
        (∏ a ∈ physicalPrimeGroups P groups,
          ghostPhaseRunHistory (fun j => decide (a ∈ physicalMarkedPrimes (finitePathMarks L p j)))
            (fun j => -(physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p)
              (n + 1) j : ZMod a.2.val))
            (fun j => 1 - physicalEndpointSchedule q (n + 1) j)
            ((a.2.val : ℝ) * b a)⁻¹ (V a.1) (n + 1) : ℝ)
    else 0 := by
  by_cases ho : physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p) (n + 1) (n + 1) = 0
  · rw [if_pos ho]
    by_cases hs : physicalFiniteReturnScalar V patterns C ζ k K n L p = 0
    · have hbare : physicalBareWalkScalar V patterns C ζ K
          (finitePathLabels p) (finitePathMarks L p) (n + 1) = 0 := by
