open Finset
/-- An injective physical slot list visits each active group label exactly once. -/
theorem physical_group_slot_product_eq_active {G : Type*} {P : G → Finset ℕ}
    {J ell : ℕ} (L : PhysicalMarkLists P J ell) (g : G) (β : ↥(P g) → ℝ) :
    (∏ s : PhysicalSlots J ell, β (L g s)) =
      ∏ p : ↥(P g), if physicalGroupPhaseActivity L g p then β p else 1 := by
  calc
    _ = ∏ p ∈ ghostPhaseActivitySupport (physicalGroupPhaseActivity L g), β p := by
      rw [physical_group_phase_activity_support_eq_image, prod_image (L g).injective.injOn]
    _ = _ := prod_filter (fun p => physicalGroupPhaseActivity L g p = true) β

/-- The actual tilted initial slot product is the initial active-label product. -/
theorem physical_group_initial_tilt_eq_active {G : Type*} {P : G → Finset ℕ}
    {J ell : ℕ} (L : PhysicalMarkLists P J ell) (g : G)
    (β : ↥(P g) → ℝ) (V : ℝ) :
    (∏ s : PhysicalSlots J ell, β (L g s) / V) =
      ∏ p : ↥(P g), if physicalGroupPhaseActivity L g p then β p / V else 1 :=
  physical_group_slot_product_eq_active L g (fun p => β p / V)

/-- There are J+ell initial physical slots, each carrying one inverse V. -/
theorem physical_group_initial_tilt_eq_inv_pow {G : Type*} {P : G → Finset ℕ}
    {J ell : ℕ} (L : PhysicalMarkLists P J ell) (g : G)
    (β : ↥(P g) → ℝ) (V : ℝ) :
    (∏ s : PhysicalSlots J ell, β (L g s) / V) =
      (V⁻¹) ^ (J + ell) *
        ∏ p : ↥(P g), if physicalGroupPhaseActivity L g p then β p else 1 := by
  rw [prod_div_distrib]
  simp only [prod_const, card_univ, Fintype.card_sum, Fintype.card_fin]
  rw [div_eq_mul_inv, inv_pow, physical_group_slot_product_eq_active, mul_comm]

/-- Active-label form of the same initial inverse-power normalization. -/
theorem physical_group_active_tilt_eq_inv_pow {G : Type*} {P : G → Finset ℕ}
    {J ell : ℕ} (L : PhysicalMarkLists P J ell) (g : G)
    (β : ↥(P g) → ℝ) (V : ℝ) :
    (∏ p : ↥(P g), if physicalGroupPhaseActivity L g p then β p / V else 1) =
      (V⁻¹) ^ (J + ell) *
        ∏ p : ↥(P g), if physicalGroupPhaseActivity L g p then β p else 1 := by
  rw [← physical_group_initial_tilt_eq_active, physical_group_initial_tilt_eq_inv_pow]

/-- Run normalization is a change to the initial parameter only. The beta
parameter in later kernels may stay unchanged. This includes both inactive
vacua and pending states, not just the supported initial active state. -/
theorem ghost_phase_run_initial_eq_tilted {R : Type*} (a : Bool)
    (β V : ℝ) (z : GhostPhaseState R) :
    ghostPhaseRunInitial a β V z = ghostPhaseInitial a (β / V) z := by
  cases a <;> cases z <;>
    simp [ghostPhaseRunInitial, ghostPhaseInitial, div_eq_mul_inv, mul_comm]
end

