section

/- The full-cell constant cancellation for the actual prime proxy with a Mellin weight. -/

open Finset Filter

namespace Bounty

theorem prime_proxy_mellin_full_cell_bound {L S Y v : ℝ} (hL : 0 < L) (hY : 0 < Y)
    (hR : 0 < (roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (Real.sqrt L))).card)
    (hproxy : ∀ n : ℕ, primeCellProxy L S Y n ≤ 1) :
    ‖∑ n ∈ Ioc ⌊Y⌋₊ ⌊Real.exp (L^(-S))*Y⌋₊,
      (((if n.Prime then 1 else 0 : ℝ)-primeCellProxy L S Y n : ℝ) : ℂ)*
        harmonicMellinWeight v n‖ ≤
      ((1+|v|)*(Real.exp (L^(-S))*Y-Y)/Y^2)*
        ((Ioc ⌊Y⌋₊ ⌊Real.exp (L^(-S))*Y⌋₊).card : ℝ) := by
  classical
  let F := Ioc ⌊Y⌋₊ ⌊Real.exp (L^(-S))*Y⌋₊
  let a := fun n : ℕ => (((if n.Prime then 1 else 0 : ℝ)-primeCellProxy L S Y n : ℝ) : ℂ)
  have hlen : 0 ≤ Real.exp (L^(-S))*Y-Y := by
    have hh : 1 ≤ Real.exp (L^(-S)) := Real.one_le_exp (by positivity)
    nlinarith
  have hzero : (∑ n ∈ F, a n) = 0 := by
    have hz := prime_cell_proxy_full_cell_zero_sum hR
    dsimp [F, a]
    exact_mod_cast hz
  have ha : ∀ n ∈ F, ‖a n‖ ≤ 1 := by
    intro n _
    have hlo := prime_cell_proxy_nonneg L S Y n
    have hup := hproxy n
    dsimp [a]
    rw [Complex.norm_real, Real.norm_eq_abs]
    split <;> rw [abs_le] <;> constructor <;> linarith
  apply zero_sum_bounded_weighted_variation F a (fun n => harmonicMellinWeight v n)
    (harmonicMellinWeight v Y) (by positivity) hzero ha
  intro n hn
  have hYn : Y ≤ (n : ℝ) := (Nat.lt_of_floor_lt (mem_Ioc.mp hn).1).le
  have hnB : (n : ℝ) ≤ Real.exp (L^(-S))*Y :=
    (Nat.cast_le.mpr (mem_Ioc.mp hn).2).trans (Nat.floor_le (by positivity))
  apply (harmonic_mellin_weight_variation_lower_scale (v := v) hY le_rfl hYn).trans
  exact div_le_div_of_nonneg_right
    (mul_le_mul_of_nonneg_left (sub_le_sub_right hnB Y) (by positivity)) (sq_nonneg Y)

end Bounty
end

section

/- Uniform nonprincipal Mellin cancellation for an actual prime proxy on a truncated cell. -/

open Finset Filter

namespace Bounty

theorem eventually_prime_proxy_cell_mellin_power_bound {a T : ℝ}
    (ha : 0 < a) (hT : 0 ≤ T) (S Bsave : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ Y Z : ℝ, Real.exp (a*L) ≤ Y → Real.exp (a*L) ≤ Z →
      ∀ (r : ℕ) [NeZero r] (χ : DirichletCharacter ℂ r), χ ≠ 1 → (r : ℝ) ≤ L^T →
      ∀ v : ℝ, |v| ≤ L^T → ∀ m n : ℕ, m ≤ n → Y ≤ (m+1 : ℕ) → (n : ℝ) ≤ 2*Y →
        ⌊Z⌋₊ ≤ m → n ≤ ⌊Real.exp (L^(-S))*Z⌋₊ →
        ‖∑ i ∈ Ioc m n, (primeCellProxy L S Z i : ℂ)*
            harmonicMellinWeight v i*χ (i : ZMod r)‖ ≤ L^(-Bsave) := by
  obtain ⟨C, _, hcoeff⟩ := exists_prime_cell_proxy_bound ha
  filter_upwards [eventually_rough_interval_mellin_power_bound ha hT Bsave, hcoeff S]
    with L hrough hco
  intro Y Z hY hZ r hr χ hχ hrT v hv m n hmn hYm hn hZm hnZ
  have hc := hco Z hZ
  have hraw := hrough Y hY r χ hχ hrT v hv m n hmn hYm hn
  have hid : (∑ i ∈ Ioc m n, (primeCellProxy L S Z i : ℂ)*
      harmonicMellinWeight v i*χ (i : ZMod r)) =
      (primeCellProxyCoefficient L S Z : ℂ)*
        ∑ i ∈ (Ioc m n).filter (fun i : ℕ =>
          ∀ p ∈ i.primeFactors, Real.exp (Real.sqrt L) < (p : ℝ)),
          harmonicMellinWeight v i*χ (i : ZMod r) := by
    rw [mul_sum, sum_filter]
    apply sum_congr rfl
    intro i hi
    have hiI : i ∈ Ioc ⌊Z⌋₊ ⌊Real.exp (L^(-S))*Z⌋₊ :=
      mem_Ioc.mpr ⟨hZm.trans_lt (mem_Ioc.mp hi).1, (mem_Ioc.mp hi).2.trans hnZ⟩
    by_cases hp : ∀ p ∈ i.primeFactors, Real.exp (Real.sqrt L) < (p : ℝ)
    · have hiR : i ∈ roughBand Z (Real.exp (L^(-S))*Z) (Real.exp (Real.sqrt L)) :=
        mem_filter.mpr ⟨hiI, hp⟩
      simp only [primeCellProxy, if_pos hiR, if_pos hp, mul_assoc]
    · have hiR : i ∉ roughBand Z (Real.exp (L^(-S))*Z) (Real.exp (Real.sqrt L)) :=
        fun hh => hp (mem_filter.mp hh).2
      simp only [primeCellProxy, if_neg hiR, if_neg hp, Complex.ofReal_zero, zero_mul]
  rw [hid, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hc.1]
  exact (mul_le_mul hc.2.1 hraw (norm_nonneg _) zero_le_one).trans_eq (one_mul _)

end Bounty
end

