section

/- The Cauchy energy with exact diagonal and off-diagonal factors. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

noncomputable def typeIIDiagonalEnergy (E N M H : Finset ℕ) (η : ℕ → ℕ → ℝ)
    (α aH : ℕ → ℂ) : ℝ :=
  ∑ e∈E, ∑ n∈N, η e n*(∑ v∈M ×ˢ H, ‖typeIIEquationTerm α aH e n v‖^2)

noncomputable def typeIIOffDiagonalEnergy (E N M H : Finset ℕ) (η : ℕ → ℕ → ℝ)
    (α aH : ℕ → ℂ) : ℝ :=
  ∑ e∈E, ∑ n∈N, η e n*(∑ v∈M ×ˢ H,
    ∑ w∈(M ×ˢ H).filter (fun w => v.1≠w.1),
      (typeIIEquationTerm α aH e n v * conj (typeIIEquationTerm α aH e n w)).re)

theorem typeII_energy_split (E N M H : Finset ℕ) (η : ℕ → ℕ → ℝ)
    (α aH : ℕ → ℂ) (hE : ∀ e∈E, 0<e) :
    (∑ e∈E, ∑ n∈N, η e n*‖typeIIInnerSum M H α aH e n‖^2) =
      typeIIDiagonalEnergy E N M H η α aH+typeIIOffDiagonalEnergy E N M H η α aH := by
  unfold typeIIDiagonalEnergy typeIIOffDiagonalEnergy
  rw [← sum_add_distrib]
  apply sum_congr rfl
  intro e he
  rw [← sum_add_distrib]
  apply sum_congr rfl
  intro n hn
  rw [typeII_inner_norm_sq_split M H α aH (hE e he), mul_add]

theorem typeII_cauchy_diagonal_offdiagonal (E N M H : Finset ℕ)
    (aE β α aH : ℕ → ℂ) (η : ℕ → ℕ → ℝ)
    (hE : ∀ e∈E, 0<e) (hη : ∀ e∈E, ∀ n∈N, 1≤η e n) :
    ‖∑ e∈E, ∑ n∈N, aE e*β n*typeIIInnerSum M H α aH e n‖^2 ≤
      ((∑ e∈E, ‖aE e‖^2)*(∑ n∈N, ‖β n‖^2))*
        (typeIIDiagonalEnergy E N M H η α aH+typeIIOffDiagonalEnergy E N M H η α aH) := by
  rw [← typeII_energy_split E N M H η α aH hE]
  exact typeII_cauchy_majorant E N M H aE β α aH η hη

theorem typeII_diagonal_energy_bound (E N M H : Finset ℕ) (X : ℕ)
    (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ) {A B C : ℝ}
    (hC : 0≤C)
    (hE : ∀ e∈E, 0<e) (hH : ∀ h∈H, 0<h)
    (hM : ∀ m∈M, 0 < m) (hN : ∀ n∈N, 0 < n)
    (hX : ∀ m∈M, ∀ n∈N, m*n≤X)
    (hη : ∀ e∈E, ∀ n∈N, 0≤η e n ∧ η e n≤C)
    (hα : ∀ m∈M, ‖α m‖≤A)
    (haH : ∀ h∈H, ‖aH h‖≤B*(h.divisors.card : ℝ)) :
    typeIIDiagonalEnergy E N M H η α aH ≤
      C*A^2*B^2*(2*(X : ℝ)*(1+Real.log X)^15) := by
  classical
  let t : ℕ → ℕ → ℕ → ℕ → ℝ := fun e n m h =>
    if m*n=2*e*h+1 then (h.divisors.card : ℝ)^2 else 0
  have hpoint (e : ℕ) (he : e∈E) (n : ℕ) (hn : n∈N)
      (m : ℕ) (hm : m∈M) (h : ℕ) (hh : h∈H) :
      η e n*‖typeIIEquationTerm α aH e n (m,h)‖^2 ≤ C*A^2*B^2*t e n m h := by
    by_cases heq : m*n=2*e*h+1
    · simp only [typeIIEquationTerm, heq, if_pos, norm_mul, mul_pow, t]
      have ha := pow_le_pow_left₀ (norm_nonneg (α m)) (hα m hm) 2
      have hb := pow_le_pow_left₀ (norm_nonneg (aH h)) (haH h hh) 2
      have hp := mul_le_mul ha hb (sq_nonneg _) (sq_nonneg A)
      have hηp := mul_le_mul (hη e he n hn).2 hp (by positivity) hC
      nlinarith [hηp]
    · simp [typeIIEquationTerm, heq, t]
  have hsum : typeIIDiagonalEnergy E N M H η α aH ≤
      C*A^2*B^2*(∑ e∈E, ∑ n∈N, ∑ m∈M, ∑ h∈H, t e n m h) := by
    unfold typeIIDiagonalEnergy
    simp only [sum_product, mul_sum]
    apply sum_le_sum
    intro e he
    apply sum_le_sum
    intro n hn
    apply sum_le_sum
    intro m hm
    apply sum_le_sum
    intro h hh
    exact hpoint e he n hn m hm h hh
  have hswap : (∑ e∈E, ∑ n∈N, ∑ m∈M, ∑ h∈H, t e n m h) =
      ∑ m∈M, ∑ n∈N, ∑ z∈(E ×ˢ H).filter (fun z => m*n=2*z.1*z.2+1),
        (z.2.divisors.card : ℝ)^2 := by
    simp only [sum_filter, sum_product]
    change (∑ e∈E, ∑ n∈N, ∑ m∈M, ∑ h∈H, t e n m h) =
      ∑ m∈M, ∑ n∈N, ∑ e∈E, ∑ h∈H, t e n m h
    calc
      _ = ∑ e∈E, ∑ m∈M, ∑ n∈N, ∑ h∈H, t e n m h :=
        sum_congr rfl (fun e he => sum_comm)
      _ = ∑ m∈M, ∑ e∈E, ∑ n∈N, ∑ h∈H, t e n m h := sum_comm
      _ = _ := sum_congr rfl (fun m hm => sum_comm)
  rw [hswap] at hsum
  exact hsum.trans (mul_le_mul_of_nonneg_left
    (typeII_diagonal_divisor_moment E H M N X hE hH hM hN hX) (by positivity))

theorem typeII_cauchy_uniform_coefficients (E N M H : Finset ℕ)
    (aE β α aH : ℕ → ℂ) (η : ℕ → ℕ → ℝ) {A B : ℝ}
    (hE : ∀ e∈E, 0<e) (hη : ∀ e∈E, ∀ n∈N, 1≤η e n)
    (haE : ∀ e∈E, ‖aE e‖≤A) (hβ : ∀ n∈N, ‖β n‖≤B) :
    ‖∑ e∈E, ∑ n∈N, aE e*β n*typeIIInnerSum M H α aH e n‖^2 ≤
      ((E.card : ℝ)*(N.card : ℝ)*A^2*B^2)*
        (typeIIDiagonalEnergy E N M H η α aH+typeIIOffDiagonalEnergy E N M H η α aH) := by
  have hfirst : (∑ e∈E, ‖aE e‖^2) ≤ (E.card : ℝ)*A^2 := by
    calc
      _ ≤ ∑ _e∈E, A^2 := sum_le_sum (fun e he =>
        pow_le_pow_left₀ (norm_nonneg _) (haE e he) 2)
      _ = _ := by simp only [sum_const,nsmul_eq_mul]
  have hsecond : (∑ n∈N, ‖β n‖^2) ≤ (N.card : ℝ)*B^2 := by
    calc
      _ ≤ ∑ _n∈N, B^2 := sum_le_sum (fun n hn =>
        pow_le_pow_left₀ (norm_nonneg _) (hβ n hn) 2)
      _ = _ := by simp only [sum_const,nsmul_eq_mul]
  have henergy : 0≤typeIIDiagonalEnergy E N M H η α aH+
      typeIIOffDiagonalEnergy E N M H η α aH := by
    rw [← typeII_energy_split E N M H η α aH hE]
    exact sum_nonneg (fun e he => sum_nonneg (fun n hn =>
      mul_nonneg ((by norm_num : (0 : ℝ)≤1).trans (hη e he n hn)) (sq_nonneg _)))
  apply (typeII_cauchy_diagonal_offdiagonal E N M H aE β α aH η hE hη).trans
  apply mul_le_mul_of_nonneg_right _ henergy
  have h := mul_le_mul hfirst hsecond (by positivity) (by positivity)
  convert h using 1; ring

end Bounty
end

section

/- Restore the whole signed forest expansion with a single rank cutoff. -/

open Finset Classical Filter

namespace Bounty

theorem eventually_birthForest_two_regime_power_saving
    {a c C E G Cv Ca M Ch : ℝ}
    (ha : 0 < a) (hc : 0 < c) (hC : 0 ≤ C) (hE : 0 ≤ E)
    (hM : 0 ≤ M) (hD : 0 ≤ G + Ca + M) (hgain : E + Cv + 2 ≤ G) :
    ∀ᶠ L : ℝ in atTop, ∀ N m : ℕ, L ^ a ≤ (N : ℝ) →
      ∀ b H A ε : ℝ, L ^ c ≤ b → (m : ℝ) ≤ L ^ M →
        0 ≤ H → H ≤ L ^ Ch → 0 ≤ A → A ≤ L ^ (C * ((N : ℝ) + 1)) →
        0 ≤ ε → (m : ℝ) ^ 2 * ε ≤ Real.exp (-b) →
        ∀ F : BirthForestCode m → ℂ,
          let r := Nat.ceil (((2 * C + (E + 1) + 1) * N * Real.log L) / b)
          (∀ code, birthForestRank code < r →
            ‖F code‖ ≤ H * L ^ ((-G + Cv) * N + Cv +
              2 * birthForestRank code * (G + Ca))) →
          (∀ code, r ≤ birthForestRank code → ‖F code‖ ≤ A * ε ^ birthForestRank code) →
          ‖∑ code : BirthForestCode m, (-1 : ℂ) ^ birthForestRank code * F code‖ ≤
            L ^ (-(E * N)) := by
  have hE1 : 0 ≤ E + 1 := by linarith
  have hgain1 : E + 1 + Cv + 1 ≤ G := by linarith
  filter_upwards [eventually_ge_atTop (2 : ℝ),
    (tendsto_rpow_atTop hc).eventually_ge_atTop (Real.log 2),
    eventually_birthForest_low_rank_power_saving ha hc hC hE1 hM hD hgain1]
    with L hL hlog hlow
  intro N m hN b H A ε hb hm hH hHb hA hAb hε hεb F
  dsimp only
  intro hF hhigh
  let r := Nat.ceil (((2 * C + (E + 1) + 1) * N * Real.log L) / b)
  have hL1 : 1 ≤ L := by linarith
  have hL0 : 0 < L := by linarith
  have hNr : (0 : ℝ) < N := (Real.rpow_pos_of_pos hL0 a).trans_le hN
  have hN1 : 1 ≤ N := by
    have hp : 0 < N := by exact_mod_cast hNr
    omega
  have hb2 : Real.log 2 ≤ b := hlog.trans hb
  have hδ0 : 0 ≤ (m : ℝ) ^ 2 * ε := by positivity
  have hδ2 : (m : ℝ) ^ 2 * ε ≤ 1 / 2 := by
    calc
      _ ≤ Real.exp (-b) := hεb
      _ ≤ Real.exp (-Real.log 2) := Real.exp_le_exp.mpr (by linarith)
      _ = 1 / 2 := by rw [Real.exp_neg, Real.exp_log (by norm_num : (0 : ℝ) < 2)]; norm_num
  have htail := (birthForest_rank_tail_norm_le F r hA hε (by linarith) hhigh).trans
    (forest_rank_cutoff_tail (E := E + 1) N hL hC hb2 hN1 hAb hδ0 hεb)
  have hhead := hlow N m hN b H hb hm hH hHb F hF
  rw [birthForest_rank_split _ r]
  calc
    _ ≤ 2 * L ^ (-((E + 1) * N)) := (norm_add_le _ _).trans (by linarith)
    _ ≤ L ^ (N : ℝ) * L ^ (-((E + 1) * N)) := by
      apply mul_le_mul_of_nonneg_right _ (Real.rpow_pos_of_pos hL0 _).le
      calc
        2 ≤ L := hL
        _ = L ^ (1 : ℝ) := (Real.rpow_one _).symm
        _ ≤ L ^ (N : ℝ) := Real.rpow_le_rpow_of_exponent_le hL1 (by exact_mod_cast hN1)
    _ = L ^ (-(E * N)) := by
      rw [← Real.rpow_add hL0]
      congr 1
      ring

end Bounty
end

section

/- Independent small and big active-slot averaging on the genuine mixed
state. Both choices remain in the explicit finite sum. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def physicalSmallBigJointAverage
    {S G : Type*} [Fintype S] [DecidableEq S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {P Z : G → Type*} {J ell : ℕ} {M : G → ℕ} {B : ℕ}
    (F : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ) :=
  physicalSmallBigAverage (fun s => fullActiveAverage (fun x => F (s.1, x)) s.2)

theorem physical_small_big_joint_average_eq_sum
    {S G : Type*} [Fintype S] [DecidableEq S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {P Z : G → Type*} {J ell : ℕ} {M : G → ℕ} {B : ℕ}
    (F : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ)
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B)) :
    physicalSmallBigJointAverage F s =
      ∑ e : PhysicalPermutations S J ell × FullActiveSlotPermutations M,
        (((Fintype.card (PhysicalPermutations S J ell) : ℝ)⁻¹ *
          fullActivePermutationWeight M e.2 : ℝ) : ℂ) *
        F ((s.1.1, physicalPermuteLabels e.1 s.1.2), fullActivePermutation e.2 s.2) := by
  simp only [physicalSmallBigJointAverage, physicalSmallBigAverage, fullActiveAverage,
    Fintype.sum_prod_type, Complex.ofReal_mul, Complex.ofReal_inv,
    Complex.ofReal_natCast, mul_sum, mul_assoc]
  rfl

theorem physical_small_big_joint_average_memory_symmetric
    {S G : Type*} [Fintype S] [DecidableEq S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {P Z : G → Type*} {J ell : ℕ} {M : G → ℕ} {B : ℕ}
    (F : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ)
    (hF : ∀ s, ProductMemorySymmetric (fun x => F (s, x))) :
    ∀ s, ProductMemorySymmetric (fun x => physicalSmallBigJointAverage F (s, x)) := by
  apply physical_small_big_average_memory_symmetric
  intro s
  exact fullActiveAverage_symmetric (fun x => F (s, x)) (hF s)

theorem physical_small_big_joint_average_energy_le
    {S G : Type*} [Fintype S] [dS : DecidableEq S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} [∀ p : PhysicalPrime Ps, NeZero p.2.val]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    {J ell : ℕ} {M : G → ℕ} {B : ℕ}
    (Vs : S → ℝ) (hVs : ∀ s, 0 < Vs s) (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hν : ∀ g z, 0 ≤ ν g z)
    (F : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ) :
    physicalSmallBigEnergy Vs (productMemoryWeight μ ν) (physicalSmallBigJointAverage F) ≤
      physicalSmallBigEnergy Vs (productMemoryWeight μ ν) F := by
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  apply (physical_small_big_average_energy_le Vs hVs (productMemoryWeight μ ν)
    (productMemoryWeight_nonneg μ ν hμ hν) _).trans
  have h := physical_small_big_fiber_energy_le Vs hVs (productMemoryWeight μ ν)
    F (fun s => fullActiveAverage (fun x => F (s.1, x)) s.2) 1
    (fun s => by simpa only [one_mul] using fullActiveAverage_energy_le μ ν hμ hν (fun x => F (s, x)))
  simpa only [one_mul] using h

end Bounty
end

section

/- Uniform compact bounds for the actual candidate transition arguments. -/

open Finset Filter Real

namespace Bounty

noncomputable def candidateAllocationRadius (r : ℕ) : ℝ := 3*(r : ℝ)+10

noncomputable def candidateAllocationArgument (c L : ℝ) (r jStar : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) (R : ℝ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (i : Fin ((candidateQIndices c L).card*r)) : ℝ :=
  (allocationPrefixResidual (fun k => log (candidateAllocationValue c L r jStar x k)) R take i -
    log (candidateAllocationValue c L r jStar x i))/(c*L/2^(candidateAllocationOrder c L r i).1.val)

theorem candidate_allocation_arguments_bounded {c L : ℝ} (hc : 0 < c) (hL : 0 < L)
    (hlog : 1 ≤ log L) (hlarge : 20*log L ≤ c*L) (hsmall : c ≤ 20*log L)
    {r jStar : ℕ} (hr : 6 ≤ r) (x : ∀ slot, candidateQSlotChoices c L r jStar slot)
    {R : ℝ} (hR : 0 ≤ R)
    (hcap : R ≤ smoothAllocationInventory _
      (fun i => log (candidateAllocationValue c L r jStar x i))
      (candidateAllocationActive c L r jStar)+88*log L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hweight : 0 < candidateAllocationWeight c L r jStar x R take)
    (i : Fin ((candidateQIndices c L).card*r)) :
    candidateAllocationArgument c L r jStar x R take i ∈
      Set.Icc (-candidateAllocationRadius r) (candidateAllocationRadius r) := by
  have hp := smooth_allocation_prefix_invariant _
    (fun k => log (candidateAllocationValue c L r jStar x k))
    (fun k => c*L/2^(candidateAllocationOrder c L r k).1.val)
    (candidateAllocationActive c L r jStar) R (88*log L) take
    (fun k => by positivity) hR hcap
    (candidate_allocation_room hc hL (zero_lt_one.trans_le hlog) hr x) hweight i
  have hsuffix := candidate_allocation_suffix_inventory_le (mul_nonneg hc.le hL.le) r jStar x i
  have hscale := ((candidateQIndices_geometry hc hL hlog hlarge hsmall).2
    (candidateAllocationOrder c L r i).1.val (candidateAllocationOrder c L r i).1.property).1
  have hv := candidate_Q_slot_log_bounds c L r jStar (candidateAllocationOrder c L r i) (x _).property
  have hvhi : log (candidateAllocationValue c L r jStar x i) ≤
      (6/5 : ℝ)*(c*L/2^(candidateAllocationOrder c L r i).1.val) := by
    simpa only [candidateAllocationValue, mul_div_assoc] using hv.2
  have hvlo : 0 ≤ log (candidateAllocationValue c L r jStar x i) := by
    exact (by positivity : (0 : ℝ) ≤ c*L/2^(candidateAllocationOrder c L r i).1.val).trans hv.1.le
  have hs : 0 < c*L/2^(candidateAllocationOrder c L r i).1.val := by positivity
  have hrs : 0 ≤ (r : ℝ)*(c*L/2^(candidateAllocationOrder c L r i).1.val) := by positivity
  unfold candidateAllocationArgument candidateAllocationRadius
  constructor
  · apply (le_div_iff₀ hs).mpr
    nlinarith
  · apply (div_le_iff₀ hs).mpr
    nlinarith

theorem eventually_candidate_allocation_arguments_bounded {c : ℝ} (hc : 0 < c)
    {r : ℕ} (hr : 6 ≤ r) :
    ∀ᶠ L : ℝ in atTop, ∀ (jStar : ℕ) (x : ∀ slot, candidateQSlotChoices c L r jStar slot)
      (R : ℝ) (take : Fin ((candidateQIndices c L).card*r) → Bool),
      0 ≤ R → R ≤ smoothAllocationInventory _
        (fun i => log (candidateAllocationValue c L r jStar x i))
        (candidateAllocationActive c L r jStar)+88*log L →
      0 < candidateAllocationWeight c L r jStar x R take →
      ∀ i, candidateAllocationArgument c L r jStar x R take i ∈
        Set.Icc (-candidateAllocationRadius r) (candidateAllocationRadius r) := by
  filter_upwards [eventually_candidateQIndices_parameters hc] with L hL
  intro jStar x R take hR hcap hw i
  exact candidate_allocation_arguments_bounded hc hL.1 hL.2.1 hL.2.2.1 hL.2.2.2
    hr x hR hcap take hw i

end Bounty
end

section

open MeasureTheory

namespace Bounty

theorem typeII_four_parameter_norm_le (q a b c : ℝ) :
    ‖(![q, a, b, c] : Fin 4 → ℝ)‖ ≤ |q| + |a| + |b| + |c| := by
  apply (pi_norm_le_iff_of_nonneg (by positivity)).mpr
  intro i
  fin_cases i <;> simp <;>
    linarith [abs_nonneg q, abs_nonneg a, abs_nonneg b, abs_nonneg c]

theorem typeII_e_majorant_log_scale_eq_one {L t : ℝ} (hL : 0 < L)
    (ht : t ∈ Set.Icc ((L ^ 88)⁻¹) 1) :
    typeIIEMajorant (L ^ 88) t = 1 := by
  apply typeII_e_majorant_eq_one _ ht.2
  have hp : 0 < L ^ 88 := pow_pos hL _
  have hb := mul_le_mul_of_nonneg_left ht.1 hp.le
  simpa only [mul_inv_cancel₀ hp.ne'] using hb

theorem typeII_pulled_fourier_moment_explicit_parameters {A : ℝ} (hA : 0 ≤ A) (M : ℕ) :
    ∃ (d : ℕ) (C : ℝ), 0 ≤ C ∧ ∀ q a b c : ℝ,
      (∫ ξ : EuclideanSpace ℝ (Fin 3), ‖ξ‖ ^ M * ‖typeIIPulledFourier A q a b c ξ‖) ≤
        C * (1 + |q| + |a| + |b| + |c|) ^ d := by
  obtain ⟨d, C, hC, hb⟩ := typeII_pulled_fourier_moment_polynomial hA M
  refine ⟨d, C, hC, ?_⟩
  intro q a b c
  have h := hb (![q, a, b, c] : Fin 4 → ℝ)
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at h
  apply h.trans
  apply mul_le_mul_of_nonneg_left _ hC
  apply pow_le_pow_left₀ (by positivity)
  linarith [typeII_four_parameter_norm_le q a b c]

theorem typeII_pulled_fourier_log_scale_truncation {A : ℝ} (hA : 0 ≤ A) (M : ℕ) :
    ∃ (d : ℕ) (C : ℝ), 0 < C ∧ ∀ L a b c R : ℝ, 0 < R →
      ∀ t : EuclideanSpace ℝ (Fin 3),
        ‖(typeIIPulledCutoff A (L ^ 88) a b c t : ℂ) -
            ∫ ξ in {ξ : EuclideanSpace ℝ (Fin 3) | ‖ξ‖ ≤ R},
              typeIIPulledFourierIntegrand A (L ^ 88) a b c t ξ‖ ≤
          C * (1 + L ^ 88 + |a| + |b| + |c|) ^ d * R ^ (-(M : ℝ)) := by
  obtain ⟨d, C, hC, hb⟩ := typeII_pulled_fourier_truncation_polynomial hA M
  refine ⟨d, C, hC, ?_⟩
  intro L a b c R hR t
  have h := hb (![L ^ 88, a, b, c] : Fin 4 → ℝ) R hR t
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at h
  apply h.trans
  apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg hR.le _)
  apply mul_le_mul_of_nonneg_left _ hC.le
  apply pow_le_pow_left₀ (by positivity)
  have hn := typeII_four_parameter_norm_le (L ^ 88) a b c
  rw [abs_of_nonneg (by positivity : 0 ≤ L ^ 88)] at hn
  linarith

end Bounty
end

section

open Filter MeasureTheory

namespace Bounty

theorem parameter_weight_le_power {P : Type*} [NormedAddCommGroup P]
    {p : P} {L a : ℝ} (hL : 1 ≤ L) (ha : 0 ≤ a) (hp : ‖p‖ ≤ L ^ a) (d : ℕ) :
    (1 + ‖p‖) ^ d ≤ 2 ^ d * L ^ (a * d) := by
  have hone : 1 ≤ L ^ a := Real.one_le_rpow hL ha
  calc
    _ ≤ (2 * L ^ a) ^ d := pow_le_pow_left₀ (by positivity) (by linarith) d
    _ = 2 ^ d * (L ^ a) ^ d := mul_pow _ _ _
    _ = 2 ^ d * L ^ (a * d) := by rw [← Real.rpow_natCast (L ^ a) d, ← Real.rpow_mul (by linarith : 0 ≤ L)]

theorem typeII_pulled_fourier_polynomial_l1_cost {A a : ℝ} (hA : 0 ≤ A) (ha : 0 ≤ a) :
    ∃ B : ℝ, 0 < B ∧ ∀ᶠ L : ℝ in atTop, ∀ p : Fin 4 → ℝ, ‖p‖ ≤ L ^ a →
      (∫ ξ : EuclideanSpace ℝ (Fin 3),
        ‖typeIIPulledFourier A (p 0) (p 1) (p 2) (p 3) ξ‖) ≤ L ^ B := by
  obtain ⟨d, C, hC, hb⟩ := typeII_pulled_fourier_l1_polynomial hA
  refine ⟨a * d + 1, by positivity, ?_⟩
  filter_upwards [eventually_ge_atTop (max 1 (C * 2 ^ d))] with L hL
  have hL1 : 1 ≤ L := (le_max_left _ _).trans hL
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL1
  have hCL : C * 2 ^ d ≤ L := (le_max_right _ _).trans hL
  intro p hp
  calc
    _ ≤ C * (1 + ‖p‖) ^ d := hb p
    _ ≤ C * (2 ^ d * L ^ (a * d)) := mul_le_mul_of_nonneg_left (parameter_weight_le_power hL1 ha hp d) hC
    _ = (C * 2 ^ d) * L ^ (a * d) := by ring
    _ ≤ L * L ^ (a * d) := mul_le_mul_of_nonneg_right hCL (Real.rpow_nonneg hL0.le _)
    _ = L ^ (a * d + 1) := by rw [Real.rpow_add hL0, Real.rpow_one]; ring

theorem typeII_pulled_fourier_exists_power_cutoff {A a D : ℝ}
    (hA : 0 ≤ A) (ha : 0 ≤ a) (hD : 0 ≤ D) :
    ∃ B : ℝ, 0 < B ∧ ∀ᶠ L : ℝ in atTop, ∀ p : Fin 4 → ℝ, ‖p‖ ≤ L ^ a →
      ∀ t : EuclideanSpace ℝ (Fin 3),
        ‖(typeIIPulledCutoff A (p 0) (p 1) (p 2) (p 3) t : ℂ) -
            ∫ ξ in {ξ : EuclideanSpace ℝ (Fin 3) | ‖ξ‖ ≤ L ^ B},
              typeIIPulledFourierIntegrand A (p 0) (p 1) (p 2) (p 3) t ξ‖ ≤ L ^ (-D) := by
  obtain ⟨d, C, hC, hb⟩ := typeII_pulled_fourier_truncation_polynomial hA 1
  let B : ℝ := a * d + D + 1
  refine ⟨B, by dsimp [B]; positivity, ?_⟩
  filter_upwards [eventually_ge_atTop (max 1 (C * 2 ^ d))] with L hL
  have hL1 : 1 ≤ L := (le_max_left _ _).trans hL
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL1
  have hCL : C * 2 ^ d ≤ L := (le_max_right _ _).trans hL
  intro p hp t
  have hpower : 0 ≤ (L ^ B) ^ (-(1 : ℝ)) := Real.rpow_nonneg (Real.rpow_nonneg hL0.le _) _
  calc
    _ ≤ C * (1 + ‖p‖) ^ d * (L ^ B) ^ (-(1 : ℝ)) := by
      simpa only [Nat.cast_one] using hb p (L ^ B) (Real.rpow_pos_of_pos hL0 B) t
    _ ≤ C * (2 ^ d * L ^ (a * d)) * (L ^ B) ^ (-(1 : ℝ)) :=
      mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left (parameter_weight_le_power hL1 ha hp d) hC.le) hpower
    _ = (C * 2 ^ d) * (L ^ (a * d) * (L ^ B) ^ (-(1 : ℝ))) := by ring
    _ ≤ L * (L ^ (a * d) * (L ^ B) ^ (-(1 : ℝ))) :=
      mul_le_mul_of_nonneg_right hCL (mul_nonneg (Real.rpow_nonneg hL0.le _) hpower)
    _ = L ^ (-D) := by
      rw [← Real.rpow_mul hL0.le, mul_neg_one, ← Real.rpow_add hL0]
      conv_lhs => lhs; rw [← Real.rpow_one L]
      rw [← Real.rpow_add hL0]
      congr 1
      dsimp [B]
      ring

end Bounty
end

section

/- Uniform candidate-weighted mass bounds on the exact boundary layers. -/

open Finset Filter Real

namespace Bounty

theorem exists_candidate_boundary_divisor_test_bound {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1) (A D : ℝ) :
    ∃ B : ℝ, 1 ≤ B ∧ ∀ᶠ L : ℝ in atTop, ∀ (jStar : ℕ) (F : ℕ → ℕ → ℂ),
      (∀ u ∈ typeIIBoundaryWindow (exp L) (L^(-B)),
        ∀ m ∈ (2*u+1).divisors, ‖F u m‖ ≤ L^A) →
      (∑ u ∈ typeIIBoundaryWindow (exp L) (L^(-B)),
        candidateCoefficient c L q r jStar u *
          ∑ m ∈ (2*u+1).divisors, ‖F u m‖) ≤ exp L * L^(-D) := by
  obtain ⟨K, hK, hcoef⟩ := exists_candidate_coefficient_divisor_bound hc hr hq0 hq1
  let B := 2*max (D+K+A) 0+18
  have hB : 1 ≤ B := by dsimp [B]; linarith [le_max_right (D+K+A) 0]
  have hBD : 2*(D+K+A)+17 ≤ B := by dsimp [B]; linarith [le_max_left (D+K+A) 0]
  refine ⟨B, hB, ?_⟩
  filter_upwards [hcoef, eventually_typeII_boundary_divisor_mass B (D+K+A) hB hBD,
    eventually_boundary_scale B hB] with L hcoeff hmass hscale
  intro jStar F hF
  have hL0 : 0 < L := zero_lt_one.trans_le hscale.1
  have hE : 1 ≤ exp L := one_le_exp hL0.le
  have hδ : 0 ≤ L^(-B) := rpow_nonneg hL0.le _
  have hsum : (∑ u ∈ typeIIBoundaryWindow (exp L) (L^(-B)),
      candidateCoefficient c L q r jStar u * ∑ m ∈ (2*u+1).divisors, ‖F u m‖) ≤
      L^(K+A) * ∑ u ∈ typeIIBoundaryWindow (exp L) (L^(-B)),
        (u.divisors.card : ℝ) * ((2*u+1).divisors.card : ℝ) := by
    rw [mul_sum]
    apply sum_le_sum
    intro u hu
    have hu0 : u ≠ 0 := Nat.ne_of_gt
      (mem_typeII_boundary_window_bounds hE hδ hscale.2.1 hu).1
    let P := (candidatePIndices c L).biUnion (candidatePBand (c*L))
    have hdiv : primePoolFreePart P u ∣ u :=
      ⟨primePoolPart P u, by simpa only [Nat.mul_comm] using
        (primePoolPart_mul_primePoolFreePart P u).symm⟩
    have hcard : ((primePoolFreePart P u).divisors.card : ℝ) ≤ (u.divisors.card : ℝ) := by
      exact_mod_cast card_le_card (Nat.divisors_subset_of_dvd hu0 hdiv)
    have hcU : candidateCoefficient c L q r jStar u ≤ L^K*(u.divisors.card : ℝ) :=
      (hcoeff jStar u).2.trans (mul_le_mul_of_nonneg_left hcard (rpow_nonneg hL0.le _))
    have hinner : (∑ m ∈ (2*u+1).divisors, ‖F u m‖) ≤
        ((2*u+1).divisors.card : ℝ)*L^A := by
      calc
        _ ≤ ∑ _m ∈ (2*u+1).divisors, L^A := sum_le_sum (fun m hm => hF u hu m hm)
        _ = _ := by simp
    calc
      _ ≤ (L^K*(u.divisors.card : ℝ))*(((2*u+1).divisors.card : ℝ)*L^A) :=
        mul_le_mul hcU hinner (sum_nonneg (fun _ _ => norm_nonneg _)) (by positivity)
      _ = _ := by rw [rpow_add hL0]; ring
  calc
    _ ≤ L^(K+A) * ∑ u ∈ typeIIBoundaryWindow (exp L) (L^(-B)),
        (u.divisors.card : ℝ) * ((2*u+1).divisors.card : ℝ) := hsum
    _ ≤ L^(K+A) * (exp L*L^(-(D+K+A))) :=
      mul_le_mul_of_nonneg_left hmass (rpow_nonneg hL0.le _)
    _ = exp L*L^(-D) := by
      rw [mul_left_comm, ← rpow_add hL0]
      congr 2
      ring

theorem exists_candidate_boundary_factorization_bound {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1) (A D : ℝ) :
    ∃ B : ℝ, 1 ≤ B ∧ ∀ᶠ L : ℝ in atTop, ∀ (jStar : ℕ) (α β : ℕ → ℂ),
      (∀ m, ‖α m‖ ≤ L^A) → (∀ n, ‖β n‖ ≤ L^A) →
      (∑ u ∈ typeIIBoundaryWindow (exp L) (L^(-B)),
        candidateCoefficient c L q r jStar u *
          ∑ m ∈ (2*u+1).divisors, ‖α m‖ * ‖β ((2*u+1)/m)‖) ≤ exp L * L^(-D) := by
  obtain ⟨B, hB, h⟩ := exists_candidate_boundary_divisor_test_bound hc hr hq0 hq1 (2*A) D
  refine ⟨B, hB, ?_⟩
  filter_upwards [h, eventually_gt_atTop (0 : ℝ)] with L hL hL0
  intro jStar α β hα hβ
  have ht := hL jStar (fun u m => α m * β ((2*u+1)/m)) (by
    intro u hu m hm
    rw [norm_mul, show 2*A = A+A by ring, rpow_add hL0]
    exact mul_le_mul (hα m) (hβ _) (norm_nonneg _) (rpow_nonneg hL0.le _))
  simpa only [norm_mul] using ht

end Bounty
end

section

/- The free-label exclusion is bounded on multiples, with both endpoint sequences retained. -/

open Finset

namespace Bounty

section Endpoints

variable (Q : Finset ℕ) (α β γ α' β' γ' : ℕ → ℂ)
  {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
  (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
  (hα' : ∀ m, ‖α' m‖ ≤ A) (hβ' : ∀ p, ‖β' p‖ ≤ B) (hγ' : ∀ r, ‖γ' r‖ ≤ C)
  (S : Finset ℤ) (δ : ℤ) (d N : ℕ) (hd : d ∈ Nat.factoredNumbers Q)
  (hδ : (d : ℤ) ∣ δ) (hdiv : ∀ n ∈ S, (d : ℤ) ∣ n)
  (hS : ∀ n ∈ S, 0 ≤ n ∧ n ≤ (N : ℤ))
  (hS' : ∀ n ∈ S, 0 ≤ n + δ ∧ n + δ ≤ (N : ℤ))

include hA hB hC hα hβ hγ hα' hβ' hγ' hd hδ hdiv hS hS'

theorem invariant_triple_endpoint_cross_multiples :
    (∑ n ∈ S, ‖invariantTripleEndpoint Q α β γ n.natAbs‖ *
      ‖invariantTripleEndpoint Q α' β' γ' (n + δ).natAbs‖) ≤
      (A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15 / d := by
  have hf := invariant_triple_endpoint_int_divisible_energy Q α β γ hA hB hC hα hβ hγ
    S d N hd (fun n hn => Int.natCast_dvd.mp (hdiv n hn)) hS
  have hg := invariant_triple_endpoint_shifted_divisible_energy Q α' β' γ'
    hA hB hC hα' hβ' hγ' S δ d N hd hδ hdiv hS'
  have hsum := Real.sum_mul_le_sqrt_mul_sqrt S
    (fun n => ‖invariantTripleEndpoint Q α β γ n.natAbs‖)
    (fun n => ‖invariantTripleEndpoint Q α' β' γ' (n + δ).natAbs‖)
  apply hsum.trans
  calc
    _ ≤ Real.sqrt ((A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15 / d) *
        Real.sqrt ((A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15 / d) :=
      mul_le_mul (Real.sqrt_le_sqrt hf) (Real.sqrt_le_sqrt hg) (by positivity) (by positivity)
    _ = _ := Real.mul_self_sqrt (by positivity)

theorem invariant_triple_endpoint_harmonic_multiples
    {Y K : ℝ} (hY : 0 < Y) (hK : 0 ≤ K) (hYlow : ∀ n ∈ S, Y ≤ (n : ℝ))
    (w : ℤ → ℂ) (hw : ∀ n ∈ S, ‖w n‖ ≤ K) :
    ‖∑ n ∈ S, (w n / (n : ℂ)) *
      star (invariantTripleEndpoint Q α β γ n.natAbs) *
      invariantTripleEndpoint Q α' β' γ' (n + δ).natAbs‖ ≤
      K / Y * ((A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15 / d) := by
  have hcross := invariant_triple_endpoint_cross_multiples Q α β γ α' β' γ'
    hA hB hC hα hβ hγ hα' hβ' hγ' S δ d N hd hδ hdiv hS hS'
  calc
    _ ≤ ∑ n ∈ S, ‖(w n / (n : ℂ)) *
        star (invariantTripleEndpoint Q α β γ n.natAbs) *
        invariantTripleEndpoint Q α' β' γ' (n + δ).natAbs‖ := norm_sum_le _ _
    _ ≤ ∑ n ∈ S, (K / Y) * (‖invariantTripleEndpoint Q α β γ n.natAbs‖ *
        ‖invariantTripleEndpoint Q α' β' γ' (n + δ).natAbs‖) := by
      apply sum_le_sum
      intro n hn
      have hn0 : (0 : ℝ) < n := hY.trans_le (hYlow n hn)
      have hnC : ‖(n : ℂ)‖ = (n : ℝ) := by
        rw [← Complex.ofReal_intCast, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hn0]
      rw [norm_mul, norm_mul, norm_div, norm_star, hnC]
      have hquot : ‖w n‖ / (n : ℝ) ≤ K / Y :=
        div_le_div₀ hK (hw n hn) hY (hYlow n hn)
      nlinarith [mul_le_mul_of_nonneg_right hquot
        (mul_nonneg (norm_nonneg (invariantTripleEndpoint Q α β γ n.natAbs))
          (norm_nonneg (invariantTripleEndpoint Q α' β' γ' (n + δ).natAbs)))]
    _ = K / Y * ∑ n ∈ S, ‖invariantTripleEndpoint Q α β γ n.natAbs‖ *
        ‖invariantTripleEndpoint Q α' β' γ' (n + δ).natAbs‖ := (mul_sum ..).symm
    _ ≤ _ := mul_le_mul_of_nonneg_left hcross (div_nonneg hK hY.le)

end Endpoints

end Bounty
end

section

/- The literal root-weighted arithmetic edge sum, before Mellin separation. -/

open Finset

namespace Bounty

noncomputable def physicalMellinRootCorrelation
    {G I : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (patterns : Finset I) (C : I → G → Finset (Fin J))
    (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (positions : Finset ℤ) (f g : ℤ → ℂ) (Ψ : ℝ → ℂ) (Z : ℝ) : ℂ := by
  classical
  exact (physicalStateMass V J ell : ℂ) *
    ∑ x ∈ physicalCutoff P J ell positions, ∑ y ∈ physicalCutoff P J ell positions,
    ∑ i ∈ patterns, ∑ aux : PhysicalAuxLabels P (C i),
      if y.1 = x.1 + k i * (physicalD (C i) x.2.val aux : ℕ) then
        Ψ ((x.1 : ℝ) / (Z * physicalD (C i) x.2.val aux)) * (x.1 : ℂ)⁻¹ *
        (starRingEnd ℂ) (f x.1) * physicalBarePatternScalar V (C i) (ζ i) (K i) aux x.2.val y.2.val *
        g y.1 * ((physicalVertexWeight x.2.val q x.1 * physicalVertexWeight y.2.val q y.1 : ℝ) : ℂ)
      else 0

theorem physical_mellin_root_as_atoms
    {G I : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (patterns : Finset I) (C : I → G → Finset (Fin J))
    (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (positions : Finset ℤ) (f g : ℤ → ℂ) (Ψ : ℝ → ℂ) (Z : ℝ) :
    physicalMellinRootCorrelation V patterns C q ζ k K positions f g Ψ Z =
      (physicalStateMass V J ell : ℂ) *
        ∑ a : PhysicalMellinAtom P J ell patterns C positions,
          physicalMellinAtomCoefficient V patterns C q ζ k K positions f g a *
            Ψ (physicalMellinAtomArgument Z a) := by
  classical
  unfold physicalMellinRootCorrelation
  apply congrArg (fun z : ℂ => (physicalStateMass V J ell : ℂ) * z)
  let T := fun (x y : PhysicalState P J ell) (i : I) (aux : PhysicalAuxLabels P (C i)) =>
    (if y.1 = x.1 + k i * (physicalD (C i) x.2.val aux : ℕ) then
      (x.1 : ℂ)⁻¹ * (starRingEnd ℂ) (f x.1) *
      physicalBarePatternScalar V (C i) (ζ i) (K i) aux x.2.val y.2.val * g y.1 *
      ((physicalVertexWeight x.2.val q x.1 * physicalVertexWeight y.2.val q y.1 : ℝ) : ℂ)
    else 0) * Ψ ((x.1 : ℝ) / (Z * physicalD (C i) x.2.val aux))
  have hs : (∑ a : PhysicalMellinAtom P J ell patterns C positions,
      physicalMellinAtomCoefficient V patterns C q ζ k K positions f g a *
        Ψ (physicalMellinAtomArgument Z a)) =
      ∑ x ∈ physicalCutoff P J ell positions, ∑ y ∈ physicalCutoff P J ell positions,
        ∑ i ∈ patterns, ∑ aux : PhysicalAuxLabels P (C i), T x y i aux :=
    physical_mellin_atom_sum patterns C positions T
  rw [hs]
  apply sum_congr rfl
  intro x _
  apply sum_congr rfl
  intro y _
  apply sum_congr rfl
  intro i _
  apply sum_congr rfl
  intro aux _
  dsimp only [T]
  split_ifs <;> ring

end Bounty
end

section

/- Exact finite character expansion of the original physical Hilbert pairing. -/

open Finset

namespace Bounty

theorem physical_mellin_pairing_atoms
    {G I : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (hP : ∀ g p, p ∈ P g → 0 < p)
    (V : G → ℝ) (hV : ∀ g, 0 < V g) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (positions : Finset ℤ) (f g : ℤ → ℂ)
    (hsource : ∀ n ∈ positions, f n ≠ 0 → 0 < n)
    (X Z v : ℝ) (hZ : Z ≠ 0) :
    inner ℂ (physicalEndpointVector P V J ell q positions (physicalMellinSource X Z v f))
      (physicalHilbertOperator V patterns C q (fun i => ζ i - v) k K positions
        (physicalEndpointVector P V J ell q positions g)) =
      (X : ℂ) * (physicalStateMass V J ell : ℂ) *
        ∑ a : PhysicalMellinAtom P J ell patterns C positions,
          physicalMellinAtomCoefficient V patterns C q ζ k K positions f g a *
            physicalMellinPhase v (physicalMellinAtomArgument Z a) := by
  classical
  let T := fun (x y : PhysicalState P J ell) (i : I) (aux : PhysicalAuxLabels P (C i)) =>
    (if y.1 = x.1 + k i * (physicalD (C i) x.2.val aux : ℕ) then
      (x.1 : ℂ)⁻¹ * (starRingEnd ℂ) (f x.1) *
      physicalBarePatternScalar V (C i) (ζ i) (K i) aux x.2.val y.2.val * g y.1 *
      ((physicalVertexWeight x.2.val q x.1 * physicalVertexWeight y.2.val q y.1 : ℝ) : ℂ)
    else 0) * physicalMellinPhase v ((x.1 : ℝ) / (Z * physicalD (C i) x.2.val aux))
  have hs : (∑ a : PhysicalMellinAtom P J ell patterns C positions,
      physicalMellinAtomCoefficient V patterns C q ζ k K positions f g a *
        physicalMellinPhase v (physicalMellinAtomArgument Z a)) =
      ∑ x ∈ physicalCutoff P J ell positions, ∑ y ∈ physicalCutoff P J ell positions,
        ∑ i ∈ patterns, ∑ aux : PhysicalAuxLabels P (C i), T x y i aux := by
    exact physical_mellin_atom_sum patterns C positions T
  rw [hs, physical_endpoint_pairing_eq_bare V hV patterns C hq]
  simp_rw [mul_sum]
  apply sum_congr rfl
  intro x hx
  apply sum_congr rfl
  intro y _
  apply sum_congr rfl
  intro i _
  apply sum_congr rfl
  intro aux _
  dsimp only [T]
  split_ifs with ht
  · by_cases hf : f x.1 = 0
    · simp only [physical_mellin_source_zero X Z v f x.1 hf, hf, map_zero, zero_mul, mul_zero]
    · have hn : x.1 ≠ 0 := ne_of_gt
        (hsource x.1 ((mem_physical_cutoff P J ell positions x).mp hx) hf)
      rw [physical_mellin_source_edge V (C i) (ζ i) v X Z hZ (K i) aux x.2.val y.2.val
        (ne_of_gt (physical_D_pos (C i) x.2.val aux hP)) f x.1 hn]
      ring
  · simp only [mul_zero, zero_mul]

end Bounty
end

section

/- Mellin modulation preserves endpoint energy; the dyadic source weight contracts it. -/

open Finset

namespace Bounty

theorem physical_mellin_source_norm (X Z v : ℝ) (f : ℤ → ℂ) (n : ℤ) :
    ‖physicalMellinSource X Z v f n‖ = |X / (n : ℝ)| * ‖f n‖ := by
  simp only [physicalMellinSource, norm_mul, physical_mellin_phase_norm, mul_one,
    Complex.norm_real, Real.norm_eq_abs]

theorem physical_mellin_endpoint_norm {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (V : G → ℝ) (hV : ∀ g, 0 < V g) (J ell : ℕ)
    {q : ℝ} (hq : 0 ≤ q) (positions : Finset ℤ) (X Z v : ℝ) (f : ℤ → ℂ) :
    ‖physicalEndpointVector P V J ell q positions (physicalMellinSource X Z v f)‖ =
      ‖physicalEndpointVector P V J ell q positions (fun n => ((X / (n : ℝ) : ℝ) : ℂ) * f n)‖ := by
  have he : ‖physicalEndpointVector P V J ell q positions (physicalMellinSource X Z v f)‖ ^ 2 =
      ‖physicalEndpointVector P V J ell q positions (fun n => ((X / (n : ℝ) : ℝ) : ℂ) * f n)‖ ^ 2 := by
    rw [physical_endpoint_vector_norm_sq P V hV J ell hq,
      physical_endpoint_vector_norm_sq P V hV J ell hq]
    simp only [physical_mellin_source_norm, norm_mul, Complex.norm_real, Real.norm_eq_abs]
  exact (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp he

theorem physical_mellin_endpoint_norm_le {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (V : G → ℝ) (hV : ∀ g, 0 < V g) (J ell : ℕ)
    {q : ℝ} (hq : 0 ≤ q) (positions : Finset ℤ) (X Z v : ℝ) (hX : 0 < X) (f : ℤ → ℂ)
    (hsource : ∀ n ∈ positions, f n ≠ 0 → X ≤ (n : ℝ)) :
    ‖physicalEndpointVector P V J ell q positions (physicalMellinSource X Z v f)‖ ≤
      ‖physicalEndpointVector P V J ell q positions f‖ := by
  have he : ‖physicalEndpointVector P V J ell q positions (physicalMellinSource X Z v f)‖ ^ 2 ≤
      ‖physicalEndpointVector P V J ell q positions f‖ ^ 2 := by
    rw [physical_endpoint_vector_norm_sq P V hV J ell hq,
      physical_endpoint_vector_norm_sq P V hV J ell hq]
    apply sum_le_sum
    intro n hn
    have hnorm : ‖physicalMellinSource X Z v f n‖ ≤ ‖f n‖ := by
      by_cases hf : f n = 0
      · simp only [physical_mellin_source_zero X Z v f n hf, hf, norm_zero, le_refl]
      · have hn' := hsource n hn hf
        have hn0 : 0 < (n : ℝ) := hX.trans_le hn'
        rw [physical_mellin_source_norm, abs_of_nonneg (div_nonneg hX.le hn0.le)]
        exact mul_le_of_le_one_left (norm_nonneg _) ((div_le_one hn0).mpr hn')
    apply mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) hnorm 2)
    exact marked_divisor_weight_nonneg univ P hq V (fun _ => J + ell) (fun g _ => (hV g).le) n
  exact (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mp he

end Bounty
end

section

/- Fourier moments and uniform truncation for the actual logarithmic window. -/

open MeasureTheory

namespace Bounty

theorem typeII_window_fourier_moment_polynomial (M : ℕ) :
    ∃ (d : ℕ) (C : ℝ), 0 ≤ C ∧ ∀ r : ℝ,
      (∫ ξ : ℝ, ‖ξ‖ ^ M * ‖typeIIWindowFourier r ξ‖) ≤ C * (1 + |r|) ^ d := by
  obtain ⟨R, hR, hs⟩ := typeII_window_support_radius
  exact fourier_domain_moment_polynomial_of_fixed_support typeIIWindowLogSchwartz
    (fun r => 1 + |r|) (fun r => by linarith [abs_nonneg r]) R hR hs
    typeII_window_derivative_polynomial_bound M

theorem typeII_window_fourier_l1_polynomial :
    ∃ (d : ℕ) (C : ℝ), 0 ≤ C ∧ ∀ r : ℝ,
      (∫ ξ : ℝ, ‖typeIIWindowFourier r ξ‖) ≤ C * (1 + |r|) ^ d := by
  simpa only [pow_zero, one_mul] using typeII_window_fourier_moment_polynomial 0

theorem typeII_window_fourier_tail_polynomial (M : ℕ) :
    ∃ (d : ℕ) (C : ℝ), 0 < C ∧ ∀ r R : ℝ, 0 < R →
      (∫ ξ in {ξ : ℝ | R < ‖ξ‖}, ‖typeIIWindowFourier r ξ‖) ≤
        C * (1 + |r|) ^ d * R ^ (-(M : ℝ)) := by
  obtain ⟨d, C, hC, hb⟩ := typeII_window_fourier_moment_polynomial M
  refine ⟨d, C + 1, by linarith, ?_⟩
  intro r R hR
  calc
    _ ≤ (∫ ξ : ℝ, ‖ξ‖^M * ‖typeIIWindowFourier r ξ‖) / R^M :=
      schwartz_norm_tail_le_moment _ M hR
    _ ≤ (C * (1 + |r|)^d) / R^M := div_le_div_of_nonneg_right (hb r) (pow_nonneg hR.le M)
    _ ≤ ((C + 1) * (1 + |r|)^d) / R^M :=
      div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right (by linarith) (by positivity))
        (pow_nonneg hR.le M)
    _ = _ := by rw [Real.rpow_neg hR.le, Real.rpow_natCast, div_eq_mul_inv]

noncomputable def typeIIWindowFourierIntegrand (r s ξ : ℝ) : ℂ :=
  Complex.exp (((2 * Real.pi * ξ * s : ℝ) : ℂ) * Complex.I) * typeIIWindowFourier r ξ

theorem typeII_window_fourier_integrand_norm (r s ξ : ℝ) :
    ‖typeIIWindowFourierIntegrand r s ξ‖ = ‖typeIIWindowFourier r ξ‖ := by
  rw [typeIIWindowFourierIntegrand, norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]

theorem typeII_window_fourier_integrand_integrable (r s : ℝ) :
    Integrable (typeIIWindowFourierIntegrand r s) := by
  have hc : Continuous (typeIIWindowFourierIntegrand r s) := by
    unfold typeIIWindowFourierIntegrand
    apply Continuous.mul
    · fun_prop
    · exact (typeIIWindowFourier r).continuous
  apply (typeII_window_fourier_integrable r).norm.mono' hc.aestronglyMeasurable
  exact Filter.Eventually.of_forall (fun ξ => (typeII_window_fourier_integrand_norm r s ξ).le)

theorem typeII_window_fourier_truncation_le_tail (r R s : ℝ) :
    ‖(typeIIWindowLogCutoff r s : ℂ) -
        ∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ R}, typeIIWindowFourierIntegrand r s ξ‖ ≤
      ∫ ξ in {ξ : ℝ | R < ‖ξ‖}, ‖typeIIWindowFourier r ξ‖ := by
  have hs : MeasurableSet {ξ : ℝ | ‖ξ‖ ≤ R} :=
    (isClosed_le continuous_norm continuous_const).measurableSet
  have heq : {ξ : ℝ | ‖ξ‖ ≤ R}ᶜ = {ξ : ℝ | R < ‖ξ‖} := by ext ξ; simp
  rw [typeII_window_fourier_inversion]
  change ‖(∫ ξ : ℝ, typeIIWindowFourierIntegrand r s ξ) - _‖ ≤ _
  rw [← setIntegral_compl hs (typeII_window_fourier_integrand_integrable r s), heq]
  apply (norm_integral_le_integral_norm _).trans
  exact le_of_eq (integral_congr_ae (Filter.Eventually.of_forall (fun ξ =>
    typeII_window_fourier_integrand_norm r s ξ)))

theorem typeII_window_fourier_truncation_polynomial (M : ℕ) :
    ∃ (d : ℕ) (C : ℝ), 0 < C ∧ ∀ r R : ℝ, 0 < R → ∀ s : ℝ,
      ‖(typeIIWindowLogCutoff r s : ℂ) -
          ∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ R}, typeIIWindowFourierIntegrand r s ξ‖ ≤
        C * (1 + |r|) ^ d * R ^ (-(M : ℝ)) := by
  obtain ⟨d, C, hC, hb⟩ := typeII_window_fourier_tail_polynomial M
  exact ⟨d, C, hC, fun r R hR s =>
    (typeII_window_fourier_truncation_le_tail r R s).trans (hb r R hR)⟩

end Bounty
end

section

/- Absolute finite test mass controls a relative complex coefficient error. -/

open Finset

namespace Bounty

theorem norm_fiber_coefficient_error_le (T : Finset ℕ) (fibers : ℕ → Finset ℕ)
    (a : ℕ → ℝ) (f g : ℕ → ℂ) (F : ℕ → ℕ → ℂ) {err : ℝ}
    (herr : 0 ≤ err) (ha : ∀ u ∈ T, 0 ≤ a u)
    (hfg : ∀ u ∈ T, ‖f u-g u‖ ≤ err*a u) :
    ‖(∑ u ∈ T, f u*∑ m ∈ fibers u, F u m) -
        ∑ u ∈ T, g u*∑ m ∈ fibers u, F u m‖ ≤
      err*(∑ u ∈ T, a u*∑ m ∈ fibers u, ‖F u m‖) := by
  rw [← sum_sub_distrib]
  apply (norm_sum_le _ _).trans
  rw [mul_sum]
  apply sum_le_sum
  intro u hu
  rw [← sub_mul, norm_mul]
  calc
    _ ≤ (err*a u)*(∑ m ∈ fibers u, ‖F u m‖) :=
      mul_le_mul (hfg u hu) (norm_sum_le _ _) (norm_nonneg _) (mul_nonneg herr (ha u hu))
    _ = _ := by ring

end Bounty
end

section

/- The original initial-avoidance and birth-distinctness gates have a single forest expansion on the common address space. -/

open Finset Classical
namespace Bounty
section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ) (steps : List (Option (J ⊕ K)))

noncomputable def fullMixedCommonIndexedPerformed
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x)
    (i : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps))) : Prop :=
  fullMixedCommonBirthPerformed n S B A Δ D steps x p (fullMixedCommonBirthOrder M B steps i)

noncomputable def fullMixedCommonIndexedValue (encode : ((g : Fin N) × P g) → ℤ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x)
    (i : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps))) : ℤ :=
  ((fullMixedCommonBirthLabel n S B A Δ D steps x p (fullMixedCommonBirthOrder M B steps i)).map encode).getD 0

variable [∀ g, DecidableEq (P g)]

theorem full_mixed_common_path_forest_expansion {Ω : Type*}
    (paths : Finset Ω)
    (x : Ω → ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : ∀ ω, FullPermutationMixedPath n S B A Δ D steps (x ω))
    (hx : ∀ ω ∈ paths, FullActiveInjective (x ω))
    (encode : ((g : Fin N) × P g) → ℤ) (hencode : Function.Injective encode)
    (w : Ω → ℂ) :
    (∑ ω ∈ paths,
      (if ∀ a z, fullMixedPathBirthLabel n S B A Δ D steps (x ω) (p ω) a = some z →
        z.2 ∉ fullActiveInitialLedger (x ω) z.1 then (1 : ℂ) else 0) *
      (if ∀ a b z, fullMixedPathBirthLabel n S B A Δ D steps (x ω) (p ω) a = some z →
        fullMixedPathBirthLabel n S B A Δ D steps (x ω) (p ω) b = some z → a = b then (1 : ℂ) else 0) * w ω) =
    ∑ code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)),
      (-1 : ℂ) ^ birthForestRank code * birthForestPathSum paths w
        (fun ω => fullMixedCommonIndexedPerformed n S B A Δ D steps (x ω) (p ω))
        (fun ω => fullMixedCommonIndexedValue n S B A Δ D steps encode (x ω) (p ω)) code := by
  have h := initial_birth_path_forest_expansion paths (fullMixedCommonBirthOrder M B steps)
    encode hencode (fun ω => fullMixedCommonInitialPrime (x ω))
    (fun ω => fullMixedCommonPathBirthLabel n S B A Δ D steps (x ω) (p ω)) w
    (fun ω hω => full_mixed_common_initial_injective (x ω) (hx ω hω))
  change _ = ∑ code, (-1 : ℂ) ^ birthForestRank code * birthForestPathSum paths w
    (fun ω => initialBirthIndexedPerformed (fullMixedCommonBirthOrder M B steps)
      (fullMixedCommonInitialPrime (x ω)) (fullMixedCommonPathBirthLabel n S B A Δ D steps (x ω) (p ω)))
    (fun ω => initialBirthIndexedValue (fullMixedCommonBirthOrder M B steps) encode
      (fullMixedCommonInitialPrime (x ω)) (fullMixedCommonPathBirthLabel n S B A Δ D steps (x ω) (p ω))) code
  rw [← h]
  apply sum_congr rfl
  intro ω _
  rw [full_mixed_common_initial_avoidance_iff, full_mixed_common_path_distinct_iff]
  split_ifs <;> rfl

end Full
end Bounty
end

section

/- Small-mark removal with a coefficient depending on the other divisor pools. -/

open Finset

namespace Bounty

theorem marked_prime_peel_mul_invariant {G : Type*} [DecidableEq G]
    (groups : Finset G) (P : G → Finset ℕ) (q : ℝ) (V : G → ℝ) (t : G → ℕ)
    (g : G) (k : ℕ) (b f : ℕ → ℂ) (n : ℕ)
    (hb : ∀ p ∈ P g, p ∣ n → b (n / p) = b n) :
    markedPrimePeel groups P q V t g k (fun m => b m * f m) n =
      b n * markedPrimePeel groups P q V t g k f n := by
  classical
  unfold markedPrimePeel
  calc
    _ = (1 / (V g : ℂ)) * ∑ p ∈ P g, b n *
        (if p ∣ n then
          (markedDivisorWeight groups P q V (Function.update t g k) ((n / p : ℕ) : ℤ) : ℂ) *
            f (n / p) else 0) := by
      congr 1
      apply sum_congr rfl
      intro p hp
      by_cases hpn : p ∣ n
      · simp only [if_pos hpn]
        rw [hb p hp hpn]
        ring
      · simp only [if_neg hpn, mul_zero]
    _ = _ := by rw [← mul_sum]; ring

theorem invariant_marked_coefficient_peel_error_energy
    {G : Type*} [DecidableEq G] (groups : Finset G) (P : G → Finset ℕ)
    {q v : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v)
    (V : G → ℝ) (t : G → ℕ) (T : ℕ)
    (hV : ∀ g ∈ groups, v ≤ V g) (ht : ∀ g ∈ groups, t g ≤ T)
    (hprime : ∀ g ∈ groups, ∀ p ∈ P g, p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (g : G) (hg : g ∈ groups) (k : ℕ) (htg : t g = k + 1)
    (Q : Finset ℕ) (hQ : P g ⊆ Q) (α β γ : ℕ → ℂ)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (S : Finset ℕ) (N : ℕ) (hS : ∀ n ∈ S, 0 < n ∧ n ≤ N)
    (b : ℕ → ℂ) {H : ℝ} (hb : ∀ n ∈ S, ‖b n‖ ≤ H)
    (hinv : ∀ n ∈ S, ∀ p ∈ P g, p ∣ n → b (n / p) = b n) :
    (∑ n ∈ S, ‖(markedDivisorWeight groups P q V t (n : ℤ) : ℂ) *
        (b n * invariantTripleEndpoint Q α β γ n) -
      markedPrimePeel groups P q V t g k (fun m => b m * invariantTripleEndpoint Q α β γ m) n‖ ^ 2) ≤
      H ^ 2 * (((markedDivisorBound q v T) ^ groups.card * (1 + 2 * Real.log N / v)) ^ 2 *
        (((A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15) *
          ∑ p ∈ P g, 1 / (p : ℝ) ^ 2)) := by
  calc
    _ ≤ ∑ n ∈ S, H ^ 2 *
        ‖(markedDivisorWeight groups P q V t (n : ℤ) : ℂ) *
            invariantTripleEndpoint Q α β γ n -
          markedPrimePeel groups P q V t g k (invariantTripleEndpoint Q α β γ) n‖ ^ 2 := by
      apply sum_le_sum
      intro n hn
      rw [marked_prime_peel_mul_invariant groups P q V t g k b _ n (hinv n hn)]
      rw [show (markedDivisorWeight groups P q V t (n : ℤ) : ℂ) *
            (b n * invariantTripleEndpoint Q α β γ n) -
          b n * markedPrimePeel groups P q V t g k (invariantTripleEndpoint Q α β γ) n =
        b n * ((markedDivisorWeight groups P q V t (n : ℤ) : ℂ) *
            invariantTripleEndpoint Q α β γ n -
          markedPrimePeel groups P q V t g k (invariantTripleEndpoint Q α β γ) n) by ring]
      rw [norm_mul, mul_pow]
      exact mul_le_mul_of_nonneg_right
        (pow_le_pow_left₀ (norm_nonneg _) (hb n hn) 2) (sq_nonneg _)
    _ = H ^ 2 * ∑ n ∈ S,
        ‖(markedDivisorWeight groups P q V t (n : ℤ) : ℂ) *
            invariantTripleEndpoint Q α β γ n -
          markedPrimePeel groups P q V t g k (invariantTripleEndpoint Q α β γ) n‖ ^ 2 :=
      (mul_sum ..).symm
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (invariant_marked_prime_peel_error_energy groups P hq0 hq1 hv V t T hV ht hprime hdis
        g hg k htg Q hQ α β γ hA hB hC hα hβ hγ S N hS) (sq_nonneg H)

end Bounty
end

section

/- The actual retained candidate coefficient satisfies the post-Cauchy absolute cross bound. -/

open Finset Filter Real

namespace Bounty

theorem exists_candidate_retained_absolute_cross_bound {c q : ℝ}
    (hc : 0 < c) (hq0 : 0 ≤ q) (hq1 : q < 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ L : ℝ in atTop, ∀ (r jStar : ℕ)
      (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
      (take : Fin ((candidateQIndices c L).card*r) → Bool),
      take ((candidateAllocationOrder c L r).symm
        (candidateRoughSlot c L r jStar hr hj)) = false →
      ∀ (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ),
      (∀ slot p, p ∈ candidateQSlotChoices c L r jStar slot → ‖twist slot p‖ ≤ 1) →
      ∀ (A : ℝ) (M H : Finset ℕ) (α : ℕ → ℂ), (∀ m ∈ M, ‖α m‖ ≤ L^A) →
      ∀ (S : Finset ℤ) (k : ℤ) (N : ℕ),
      (∀ z ∈ S, 0 < z ∧ 0 < z+k) → (∀ z ∈ S, z ≤ N ∧ z+k ≤ N) →
      (∑ z ∈ S,
        factorizationAbsoluteMass M H α
          (candidateRetainedComplexCoefficient c L q r jStar take twist) z.toNat *
        factorizationAbsoluteMass M H α
          (candidateRetainedComplexCoefficient c L q r jStar take twist) (z+k).toNat) ≤
        L^(2*(A+C))*(N : ℝ)*(1+log N)^15 := by
  obtain ⟨C,hC,hbound⟩ := exists_candidate_retained_divisor_bound hc hq0 hq1
  refine ⟨C,hC,?_⟩
  filter_upwards [hbound, eventually_gt_atTop (0 : ℝ)] with L hbound hL
  intro r jStar hr hj take hkeep twist htwist A M H α hα S k N hpos hN
  have h := factorization_absolute_signed_cross_moment S k N M H α
    (candidateRetainedComplexCoefficient c L q r jStar take twist)
    (A := L^A) (B := L^C) (by positivity) (by positivity) hα
    (fun h _ hh => hbound r jStar hr hj take hkeep twist htwist h hh) hpos hN
  have hp : (L^A*L^C)^2 = L^(2*(A+C)) := by
    rw [show 2*(A+C) = (A+C)*(2 : ℕ) by push_cast; ring,
      rpow_mul_natCast hL.le, rpow_add hL]
  simpa only [hp] using h

end Bounty
end

section

/- Plancherel majorization of actual local finite Fourier energy. -/

open Finset MeasureTheory
open scoped FourierTransform

namespace Bounty

theorem local_additive_inverse_fourier (S : Finset ℕ) (a : ℕ → ℂ)
    {H : ℝ} (hH : 0 < H) (β : ℝ) :
    𝓕⁻ (localAdditiveSchwartz S a H hH) β =
      (H:ℂ) * 𝓕 localMellinKernelSchwartz (H*β) * localAdditivePolynomial S a β := by
  have hi (n : ℕ) : Integrable (fun v : ℝ => a n *
      (Complex.exp (((2*Real.pi*β*v:ℝ):ℂ)*Complex.I) * localMellinKernelSchwartz (((n:ℝ)-v)/H))) := by
    have hc : Continuous (fun v : ℝ => a n *
        (Complex.exp (((2*Real.pi*β*v:ℝ):ℂ)*Complex.I) * localMellinKernelSchwartz (((n:ℝ)-v)/H))) := by
      fun_prop
    apply hc.integrable_of_hasCompactSupport
    exact ((local_kernel_translate_compact (n:ℝ) hH).mul_left).mul_left
  have hform : 𝓕⁻ (localAdditiveSchwartz S a H hH) β =
      ∫ v : ℝ, ∑ n ∈ S, a n * (Complex.exp (((2*Real.pi*β*v:ℝ):ℂ)*Complex.I) *
        localMellinKernelSchwartz (((n:ℝ)-v)/H)) := by
    rw [SchwartzMap.fourierInv_coe, Real.fourierInv_eq']
    apply integral_congr_ae
    filter_upwards [] with v
    change Complex.exp (((2*Real.pi*inner ℝ v β:ℝ):ℂ)*Complex.I) *
      localAdditiveConvolution S a H v = _
    simp only [RCLike.inner_apply, starRingEnd_apply, star_trivial, localAdditiveConvolution, mul_sum]
    apply sum_congr rfl
    intro n hn
    have he : (2*Real.pi*(β*v):ℝ) = 2*Real.pi*β*v := by ring
    simp only [he]
    ring
  rw [hform, integral_finsetSum S (fun n _ => hi n)]
  simp_rw [integral_const_mul, local_kernel_translate_inverse_fourier _ _ hH]
  rw [localAdditivePolynomial, mul_sum]
  apply sum_congr rfl
  intro n hn
  push_cast
  ring

theorem local_fourier_energy_le_convolution (S : Finset ℕ) (a : ℕ → ℂ)
    {H : ℝ} (hH : 0 < H) :
    (∫ β in {β : ℝ | |β| ≤ 1/H}, ‖localAdditivePolynomial S a β‖^2) ≤
      (4 / H^2) * ∫ v : ℝ, ‖localAdditiveConvolution S a H v‖^2 := by
  let f := localAdditiveSchwartz S a H hH
  have hsq : Integrable (fun β : ℝ => ‖𝓕⁻ f β‖^2) :=
    (memLp_two_iff_integrable_sq_norm (𝓕⁻ f).continuous.aestronglyMeasurable).mp ((𝓕⁻ f).memLp 2)
  have hpoint (β : ℝ) (hβ : |β| ≤ 1/H) :
      ‖localAdditivePolynomial S a β‖^2 ≤ (4/H^2)*‖𝓕⁻ f β‖^2 := by
    have hb : |H*β| ≤ 1 := by
      rw [abs_mul, abs_of_pos hH]
      exact (mul_le_mul_of_nonneg_left hβ hH.le).trans_eq (by field_simp)
    have hk := local_mellin_kernel_fourier_lower hb
    have hn : ‖𝓕⁻ f β‖ = H * ‖𝓕 localMellinKernelSchwartz (H*β)‖ *
        ‖localAdditivePolynomial S a β‖ := by
      rw [local_additive_inverse_fourier S a hH β, norm_mul, norm_mul,
        Complex.norm_real, Real.norm_eq_abs, abs_of_pos hH]
    have hmul : H * ‖localAdditivePolynomial S a β‖ ≤ 2*‖𝓕⁻ f β‖ := by
      rw [hn]
      nlinarith [mul_nonneg hH.le (norm_nonneg (localAdditivePolynomial S a β)),
        mul_nonneg (show 0 ≤ 2*‖𝓕 localMellinKernelSchwartz (H*β)‖-1 by linarith)
          (mul_nonneg hH.le (norm_nonneg (localAdditivePolynomial S a β)))]
    have hs := pow_le_pow_left₀ (mul_nonneg hH.le (norm_nonneg _)) hmul 2
    rw [mul_pow, mul_pow] at hs
    rw [div_mul_eq_mul_div]
    apply (le_div_iff₀ (sq_pos_of_pos hH)).mpr
    nlinarith
  have hset : MeasurableSet {β : ℝ | |β| ≤ 1/H} :=
    (isClosed_le continuous_abs continuous_const).measurableSet
  have hp : (∫ β in {β : ℝ | |β| ≤ 1/H}, ‖localAdditivePolynomial S a β‖^2) ≤
      (4/H^2) * ∫ β : ℝ, ‖𝓕⁻ f β‖^2 := by
    calc
      _ ≤ ∫ β in {β : ℝ | |β| ≤ 1/H}, (4/H^2)*‖𝓕⁻ f β‖^2 := by
        apply integral_mono_of_nonneg (Filter.Eventually.of_forall (fun β => sq_nonneg _))
          ((hsq.const_mul _).integrableOn)
        filter_upwards [ae_restrict_mem hset] with β hβ
        exact hpoint β hβ
      _ = (4/H^2)*∫ β in {β : ℝ | |β| ≤ 1/H}, ‖𝓕⁻ f β‖^2 := integral_const_mul _ _
      _ ≤ _ := mul_le_mul_of_nonneg_left (setIntegral_le_integral hsq
        (Filter.Eventually.of_forall (fun β => sq_nonneg _))) (by positivity)
  have hpl := SchwartzMap.integral_norm_sq_fourier (𝓕⁻ f)
  rw [FourierTransform.fourier_fourierInv_eq] at hpl
  exact hp.trans_eq (by rw [← hpl]; rfl)

end Bounty
end

section

/- The inward cutoff permits enlarging the summation domain before Mellin inversion. -/

open Finset Real

namespace Bounty

theorem typeII_window_smooth_nat_support {x δ : ℝ} (hx : 0 < x) (hδ : 0 < δ)
    (u : ℕ) (hu : typeIIWindowSmooth δ ((u : ℝ)/x) ≠ 0) :
    u ∈ arithmeticProductWindow 1 x := by
  have hh := typeII_window_smooth_support hδ hu
  apply (mem_arithmeticProductWindow_iff one_ne_zero x).mpr
  simpa only [one_mul] using
    And.intro ((lt_div_iff₀ hx).mp hh.1) (((div_lt_iff₀ hx).mp hh.2).le)

theorem typeII_smooth_sum_restrict {x δ : ℝ} (hx : 0 < x) (hδ : 0 < δ)
    (S : Finset ℕ) (hS : arithmeticProductWindow 1 x ⊆ S) (a G : ℕ → ℂ) :
    (∑ u ∈ S, a u * (typeIIWindowSmooth δ ((u : ℝ)/x) : ℂ) * G u) =
      ∑ u ∈ arithmeticProductWindow 1 x,
        a u * (typeIIWindowSmooth δ ((u : ℝ)/x) : ℂ) * G u := by
  symm
  apply sum_subset hS
  intro u hu hnot
  have hz : typeIIWindowSmooth δ ((u : ℝ)/x) = 0 := by
    by_contra hn
    exact hnot (typeII_window_smooth_nat_support hx hδ u hn)
  simp only [hz, Complex.ofReal_zero, mul_zero, zero_mul]

theorem typeII_smooth_divisor_sum_restrict {L B : ℝ} (hL : 0 < L)
    (a : ℕ → ℂ) (F : ℕ → ℕ → ℂ) :
    (∑ u ∈ candidateWindowBox L,
      a u * (typeIIWindowSmooth (L^(-B)) ((u : ℝ)/exp L) : ℂ) *
        ∑ m ∈ (2*u+1).divisors, F u m) =
      ∑ u ∈ arithmeticProductWindow 1 (exp L),
        a u * ∑ m ∈ (2*u+1).divisors,
          (typeIIWindowSmooth (L^(-B)) ((u : ℝ)/exp L) : ℂ) * F u m := by
  rw [typeII_smooth_sum_restrict (exp_pos L) (rpow_pos_of_pos hL _)
    _ (arithmetic_window_subset_candidate_window_box L)]
  simp only [← mul_sum, mul_assoc]

end Bounty
end

section

/- Exact big-active projection identities on the genuine mixed measure.
Only big permutations commute with the endpoint gates; the small-tail gate
is kept inside the small-conditioning map. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def physicalSmallBigBigAverage
    {S G : Type*} [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {P Z : G → Type*} {J ell : ℕ} {M : G → ℕ} {B : ℕ}
    (F : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ)
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B)) : ℂ :=
  fullActiveAverage (fun x => F (s.1, x)) s.2

theorem physical_small_big_big_average_self_adjoint
    {S G : Type*} [Fintype S] [DecidableEq S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} [∀ p : PhysicalPrime Ps, NeZero p.2.val]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    {J ell : ℕ} {M : G → ℕ} {B : ℕ}
    (Vs : S → ℝ) (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (f h : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ) :
    (∑ s, (physicalSmallBigMeasure Vs (productMemoryWeight μ ν) s : ℂ) *
      (starRingEnd ℂ) (f s) * physicalSmallBigBigAverage h s) =
      ∑ s, (physicalSmallBigMeasure Vs (productMemoryWeight μ ν) s : ℂ) *
        (starRingEnd ℂ) (physicalSmallBigBigAverage f s) * h s := by
  conv_lhs => rw [Fintype.sum_prod_type]
  conv_rhs => rw [Fintype.sum_prod_type]
  apply sum_congr rfl
  intro s _
  by_cases hs : physicalResidueMarksValid s.1 s.2
  · simpa only [physicalSmallBigMeasure, hs, if_true, physicalSmallBigBigAverage,
      Complex.ofReal_mul, mul_sum, mul_assoc] using
      congrArg (fun z : ℂ => (physicalStateMass Vs J ell : ℂ) * z)
        (fullActiveAverage_self_adjoint μ ν (fun x => f (s, x)) (fun x => h (s, x)))
  · simp only [physicalSmallBigMeasure, hs, if_false, Complex.ofReal_zero,
      zero_mul, sum_const_zero]

theorem physical_small_big_condition_big_average
    {S G : Type*} [Fintype S] [DecidableEq S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {P Z : G → Type*} {J ell : ℕ} {M : G → ℕ} {B : ℕ}
    (Vs : S → ℝ) (q : ℝ)
    (f : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ)
    (d : PhysicalSharedLists Ps J) (x) (r : PhysicalResidues Ps) :
    physicalSmallBigCondition Vs q (physicalSmallBigBigAverage f) d x r =
      fullActiveAverage (fun y => physicalSmallBigCondition Vs q f d y r) x := by
  exact physical_small_condition_full_active_average Vs q r d (fun y L => f ((r, L), y)) x

theorem physical_small_big_gate_big_average
    {S G : Type*} [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {P Z : G → Type*} {J ell : ℕ} {M : G → ℕ} {B : ℕ}
    (gate f : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ)
    (hg : ∀ s (τ : FullActiveSlotPermutations M),
      gate (s.1, fullActivePermutation τ s.2) = gate s)
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B)) :
    gate s * physicalSmallBigBigAverage f s =
      physicalSmallBigBigAverage (fun y => gate y * f y) s := by
  simp only [physicalSmallBigBigAverage, fullActiveAverage, hg, mul_sum]
  apply sum_congr rfl
  intro τ _
  ring

theorem clean_mixed_big_active_injective_permutation
    {S G : Type*} {Ps : S → Finset ℕ} {P Z : G → Type*}
    {J ell B : ℕ} {M : G → ℕ}
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B))
    (τ : FullActiveSlotPermutations M) :
    CleanMixedBigActiveInjective (s.1, fullActivePermutation τ s.2) ↔
      CleanMixedBigActiveInjective s := by
  constructor
  · intro h g a b hab
    have he := h g (a₁ := (τ g).symm a) (a₂ := (τ g).symm b)
    have he' : (τ g).symm a = (τ g).symm b := he (by
      change (s.2 g).1 (τ g ((τ g).symm a)) = (s.2 g).1 (τ g ((τ g).symm b))
      simpa only [Equiv.apply_symm_apply] using hab)
    exact (τ g).symm.injective he'
  · intro h g
    exact (h g).comp (τ g).injective

theorem clean_mixed_source_gate_big_permutation
    {S G : Type*} {Ps : S → Finset ℕ} {P Z : G → Type*}
    {J ell B : ℕ} {M : G → ℕ}
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B))
    (τ : FullActiveSlotPermutations M) :
    cleanMixedSourceGate (s.1, fullActivePermutation τ s.2) = cleanMixedSourceGate s := by
  simp only [cleanMixedSourceGate, clean_mixed_big_active_injective_permutation]

theorem clean_mixed_target_gate_big_permutation
    {S G : Type*} {Ps : S → Finset ℕ} {P Z : G → Type*}
    {J ell B : ℕ} {M : G → ℕ} (Fs : ∀ s, Finset (Ps s))
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B))
    (τ : FullActiveSlotPermutations M) :
    cleanMixedTargetGate Fs (s.1, fullActivePermutation τ s.2) = cleanMixedTargetGate Fs s := by
  simp only [cleanMixedTargetGate, clean_mixed_big_active_injective_permutation]

end Bounty
end

section

open MeasureTheory
open scoped FourierTransform

namespace Bounty

noncomputable def localMellinTransform (h : ℝ) (g : ℝ → ℂ) (u : ℝ) : ℂ :=
  (Real.exp (-u) : ℂ) * ∫ t : ℝ, Complex.exp (((-t*u:ℝ):ℂ)*Complex.I) *
    𝓕 localMellinKernelSchwartz (Real.exp (-u)*(h*t)/(2*Real.pi)) * g t

theorem local_mellin_amplitude_joint_continuous (j : ℕ) :
    Continuous (Function.uncurry (localMellinAmplitude j)) := by
  have hr := (typeII_smooth_rho_contDiff 2).continuous
  have hK := (𝓕 localMellinKernelSchwartz).continuous
  have hw : Continuous (fun p : ℝ × ℝ => (1+p.1^2)^((j:ℝ)/4)) :=
    (by fun_prop : Continuous (fun p : ℝ × ℝ => 1+p.1^2)).rpow_const
      (fun p => Or.inl (by positivity))
  unfold localMellinAmplitude Function.uncurry
  fun_prop

theorem local_mellin_amplitude_weight_cancel (j : ℕ) (h t u : ℝ) :
    localMellinAmplitude (4*j) (h*t) u * (mellinDecayWeight j h t : ℂ) =
      ((typeIISmoothRho 2 u * Real.exp (-u) : ℝ) : ℂ) *
        𝓕 localMellinKernelSchwartz (Real.exp (-u)*(h*t)/(2*Real.pi)) := by
  have he : (((4*j:ℕ):ℝ)/4) = (j:ℝ) := by push_cast; ring
  simp only [localMellinAmplitude, he, Real.rpow_natCast, mellinDecayWeight,
    Complex.ofReal_inv]
  rw [mul_assoc, mul_inv_cancel₀ (by exact_mod_cast (ne_of_gt (pow_pos (by positivity : 0 < 1+(h*t)^2) j))), mul_one]

theorem local_mellin_transform_weighted_representation (j : ℕ) (h : ℝ)
    (g : ℝ → ℂ) (u : ℝ) :
    (typeIISmoothRho 2 u : ℂ) * localMellinTransform h g u =
      ∫ t : ℝ, Complex.exp (((-t*u:ℝ):ℂ)*Complex.I) *
        localMellinAmplitude (4*j) (h*t) u * ((mellinDecayWeight j h t : ℂ) * g t) := by
  unfold localMellinTransform
  rw [← integral_const_mul, ← integral_const_mul]
  apply integral_congr_ae
  filter_upwards [] with t
  have hc := local_mellin_amplitude_weight_cancel j h t u
  rw [Complex.ofReal_mul] at hc
  linear_combination -Complex.exp (((-t*u:ℝ):ℂ)*Complex.I) * g t * hc

theorem local_mellin_rho_one_on_log_dyad {u : ℝ}
    (hu : u ∈ Set.Icc (Real.log (1/2:ℝ)) (Real.log 3)) :
    typeIISmoothRho 2 u = 1 := by
  apply typeII_smooth_rho_eq_one
  have h2 := Real.log_le_sub_one_of_pos (by norm_num : (0:ℝ) < 2)
  have h3 := Real.log_le_sub_one_of_pos (by norm_num : (0:ℝ) < 3)
  have hh : Real.log (1/2:ℝ) = -Real.log 2 := by rw [one_div, Real.log_inv]
  constructor <;> linarith [hu.1, hu.2]

end Bounty
end

section

/- On original paths with injective initial active labels, every compatible selected child is owned by a later event. -/

namespace Bounty
section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ) (steps : List (Option (J ⊕ K)))
  (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
  (p : FullPermutationMixedPath n S B A Δ D steps x)

theorem full_mixed_common_initial_label_injOn (hx : FullActiveInjective x) :
    Set.InjOn
      (fun i => fullMixedCommonBirthLabel n S B A Δ D steps x p (fullMixedCommonBirthOrder M B steps i))
      {i | fullMixedCommonIndexStage M B steps i = 0} := by
  intro i hi j hj he
  obtain ⟨a, ha⟩ := (full_mixed_common_index_stage_zero_iff M B steps i).mp hi
  obtain ⟨b, hb⟩ := (full_mixed_common_index_stage_zero_iff M B steps j).mp hj
  dsimp only at he
  rw [ha, hb, full_mixed_common_initial_label, full_mixed_common_initial_label] at he
  have hab := full_mixed_common_initial_injective x hx (Option.some.inj he)
  apply (fullMixedCommonBirthOrder M B steps).injective
  rw [ha, hb, hab]

theorem full_mixed_common_compatible_initial_child_none (hx : FullActiveInjective x)
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))
    (hcompat : birthForestCompatible
      (fun i => fullMixedCommonBirthPerformed n S B A Δ D steps x p (fullMixedCommonBirthOrder M B steps i))
      (fun i => fullMixedCommonBirthLabel n S B A Δ D steps x p (fullMixedCommonBirthOrder M B steps i)) code) :
    ∀ i, fullMixedCommonIndexStage M B steps i = 0 → code i = none := by
  apply birth_forest_no_child_in_injective_prefix code _ _ _ _
    (full_mixed_common_initial_label_injOn n S B A Δ D steps x p hx) hcompat
  intro i j hij hj
  have h := full_mixed_common_index_stage_monotone M B steps hij.le
  rw [hj] at h
  exact le_antisymm h (Fin.zero_le _)

end Full
end Bounty
end

section

/- Absolute-frequency and large-frequency bounds in the direct exponential convention. -/

open Finset

namespace Bounty

theorem logarithmic_unit_phase_eq (t x : ℝ) :
    realUnitPhase ((t/(2*Real.pi))*Real.log x) =
      Complex.exp (((t*Real.log x : ℝ) : ℂ)*Complex.I) := by
  unfold realUnitPhase
  congr 2
  field_simp

theorem logarithmic_second_derivative_positive (t U : ℝ) {a b : ℕ}
    (ht : 0 < t) (hU : 1 ≤ U) (hab : a ≤ b)
    (ha : U ≤ (a : ℝ)) (hb : (b : ℝ) ≤ 2*U) :
    ‖∑ n ∈ Icc a b, Complex.exp (((t*Real.log (n : ℝ) : ℝ) : ℂ)*Complex.I)‖ ≤
      108*(Real.sqrt t+U/Real.sqrt t) := by
  let c := t/(2*Real.pi)
  have hc : 0 < c := by dsimp [c]; positivity
  have hct : c ≤ t := div_le_self ht.le (by linarith [Real.pi_gt_three])
  have hsct := Real.sqrt_le_sqrt hct
  have hsc : 0 < Real.sqrt c := Real.sqrt_pos.mpr hc
  have hst : 0 < Real.sqrt t := Real.sqrt_pos.mpr ht
  have heq : 2*Real.pi*c = t := by dsimp [c]; field_simp
  have ht9 : t ≤ 9*c := by
    have := mul_le_mul_of_nonneg_right (show 2*Real.pi ≤ 9 by linarith [Real.pi_lt_four]) hc.le
    nlinarith
  have hroot : Real.sqrt t ≤ 3*Real.sqrt c := by
    nlinarith [Real.sq_sqrt ht.le,Real.sq_sqrt hc.le]
  have hquot : U/Real.sqrt c ≤ 3*(U/Real.sqrt t) := by
    rw [← mul_div_assoc]
    apply (div_le_div_iff₀ hsc hst).mpr
    have := mul_le_mul_of_nonneg_left hroot (show 0 ≤ U by linarith)
    nlinarith
  have h := positive_logarithmic_second_derivative c U hc hU hab ha hb
  change ‖∑ n ∈ Icc a b, realUnitPhase ((t/(2*Real.pi))*Real.log n)‖ ≤ _ at h
  simp_rw [logarithmic_unit_phase_eq] at h
  have hq0 : 0 ≤ U/Real.sqrt t := by positivity
  nlinarith

theorem norm_logarithmic_phase_neg (S : Finset ℕ) (t : ℝ) :
    ‖∑ n ∈ S, Complex.exp ((((-t)*Real.log (n : ℝ) : ℝ) : ℂ)*Complex.I)‖ =
      ‖∑ n ∈ S, Complex.exp (((t*Real.log (n : ℝ) : ℝ) : ℂ)*Complex.I)‖ := by
  have hn (n : ℕ) : ((-t)/(2*Real.pi))*Real.log n = -((t/(2*Real.pi))*Real.log n) := by ring
  simp_rw [← logarithmic_unit_phase_eq,hn]
  exact norm_sum_real_unit_phase_neg S (fun n => (t/(2*Real.pi))*Real.log n)

theorem logarithmic_second_derivative_bound (t U : ℝ) {a b : ℕ}
    (ht : t ≠ 0) (hU : 1 ≤ U) (hab : a ≤ b)
    (ha : U ≤ (a : ℝ)) (hb : (b : ℝ) ≤ 2*U) :
    ‖∑ n ∈ Icc a b, Complex.exp (((t*Real.log (n : ℝ) : ℝ) : ℂ)*Complex.I)‖ ≤
      108*(Real.sqrt |t|+U/Real.sqrt |t|) := by
  rcases lt_or_gt_of_ne ht with hneg | hpos
  · have h := logarithmic_second_derivative_positive (-t) U (by linarith) hU hab ha hb
    rw [norm_logarithmic_phase_neg] at h
    simpa only [abs_of_neg hneg] using h
  · simpa only [abs_of_pos hpos] using logarithmic_second_derivative_positive t U hpos hU hab ha hb

theorem logarithmic_second_derivative_large (t U Y : ℝ) {a b : ℕ}
    (hU : 1 ≤ U) (hab : a ≤ b) (ha : U ≤ (a : ℝ)) (hb : (b : ℝ) ≤ 2*U)
    (hUt : U ≤ |t|) (htY : |t| ≤ Y) :
    ‖∑ n ∈ Icc a b, Complex.exp (((t*Real.log (n : ℝ) : ℝ) : ℂ)*Complex.I)‖ ≤
      216*Real.sqrt Y := by
  have htpos : 0 < |t| := by linarith
  have hs : 0 < Real.sqrt |t| := Real.sqrt_pos.mpr htpos
  have hquot : U/Real.sqrt |t| ≤ Real.sqrt |t| := by
    apply (div_le_iff₀ hs).mpr
    nlinarith [Real.sq_sqrt htpos.le]
  have h := logarithmic_second_derivative_bound t U (abs_pos.mp htpos) hU hab ha hb
  have hsY := Real.sqrt_le_sqrt htY
  nlinarith

end Bounty
end

section

/- Quantitative cancellation of a logarithmic phase below its first aliasing frequency. -/

open Finset

namespace Bounty

theorem logarithmic_first_derivative_positive (a b : ℤ) (V t : ℝ)
    (ha : 0 < (a : ℝ)) (haV : (a : ℝ) ≤ V) (hbV : (b : ℝ)+1 ≤ V)
    (ht : 0 < t) (htmax : t ≤ Real.pi*(a : ℝ)) :
    ‖∑ n ∈ Icc a b, Complex.exp ((t*Real.log (n : ℝ) : ℝ)*Complex.I)‖ ≤
      4*Real.pi*V/t := by
  let c := t/(2*Real.pi)
  let δ := c/V
  have hV : 0 < V := ha.trans_le haV
  have hc : 0 < c := div_pos ht (by positivity)
  have hcmax : c ≤ (a : ℝ)/2 := by
    dsimp [c]
    apply (div_le_iff₀ (by positivity : 0 < 2*Real.pi)).mpr
    nlinarith
  have hd : 0 < δ := div_pos hc hV
  have hdhalf : δ ≤ 1/2 := (div_le_iff₀ hV).mpr (by linarith)
  have hf (x : ℝ) (hx : x ∈ Set.Icc (a : ℝ) ((b : ℝ)+1)) :
      HasDerivAt (fun x => c*Real.log x) (c/x) x := by
    have hxp : 0 < x := ha.trans_le hx.1
    simpa only [div_eq_mul_inv] using (Real.hasDerivAt_log hxp.ne').const_mul c
  have hbound (x : ℝ) (hx : x ∈ Set.Icc (a : ℝ) ((b : ℝ)+1)) :
      (0 : ℝ)+δ ≤ c/x ∧ c/x ≤ (0 : ℝ)+1-δ := by
    have hxp : 0 < x := ha.trans_le hx.1
    constructor
    · simpa only [zero_add] using div_le_div_of_nonneg_left hc.le hxp (hx.2.trans hbV)
    · have hcx : c/x ≤ 1/2 := (div_le_iff₀ hxp).mpr (by linarith [hx.1])
      linarith
  have hm : AntitoneOn (fun x : ℝ => c/x) (Set.Icc (a : ℝ) ((b : ℝ)+1)) := by
    intro x hx y hy hxy
    exact div_le_div_of_nonneg_left hc.le (ha.trans_le hx.1) hxy
  have hh := first_derivative_test (fun x => c*Real.log x) (fun x => c/x)
    a b 0 hd hdhalf hf (by simpa only [Int.cast_zero] using hbound) (Or.inr hm)
  have he (n : ℤ) : realUnitPhase (c*Real.log (n : ℝ)) =
      Complex.exp ((t*Real.log (n : ℝ) : ℝ)*Complex.I) := by
    unfold realUnitPhase
    congr 2
    dsimp [c]
    field_simp
  simp_rw [he] at hh
  calc
    _ ≤ 2/δ := hh
    _ = 4*Real.pi*V/t := by dsimp [δ,c]; field_simp <;> ring

end Bounty
end

section

/- Explicit counts for all unit intervals meeting the actual exceptional
prime-polynomial set. The coefficient, sampling, and mean-square bounds
are proved upstream; no exceptional-count or operator-bound premise remains. -/

open Finset
open scoped Classical

namespace Bounty

theorem prime_exceptional_intervals_count_bound (s : Finset ℕ)
    (hs : ∀ p ∈ s, Nat.Prime p) (P Y R η : ℝ) (b : s → ℂ)
    (hP : 1 ≤ P) (hY : 1 ≤ Y) (hR : 0 ≤ R) (hRY : R ≤ Y) (hη : 0 < η)
    (hband : ∀ p ∈ s, P ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2 * P)
    (hb : ∀ p : s, ‖b p‖ ≤ 1) :
    ((primeExceptionalIntervals s b η R).card : ℝ) ≤
      512 * Y * (1 + Real.log Y) ^ 2 * (primeMomentDegree Y P).factorial *
        ((2 / P) / η ^ 2) ^ primeMomentDegree Y P := by
  let j := primeMomentDegree Y P
  have hN : 1 ≤ ⌈Y⌉₊ := by
    have : (1 : ℝ) ≤ (⌈Y⌉₊ : ℝ) := hY.trans (Nat.le_ceil Y)
    exact_mod_cast this
  have hPN : (2 * P) ^ j ≤ (⌈Y⌉₊ : ℝ) :=
    (prime_moment_degree_power_bounds hY (by linarith)).1.trans (Nat.le_ceil Y)
  have hm := prime_exceptional_intervals_moment_bound s hs P 1 b hP zero_le_one
    hband hb j ⌈Y⌉₊ hN hPN η R hη
  norm_num only [one_pow, mul_one] at hm
  have hv := prime_moment_sampling_overhead_le Y R hY hR hRY
  have hz : 0 ≤ (j.factorial : ℝ) * (2 / P) ^ j := by
    have : 0 ≤ P := zero_le_one.trans hP
    positivity
  have hm' : ((primeExceptionalIntervals s b η R).card : ℝ) * (η ^ j) ^ 2 ≤
      (3 * (1 + 2 * (1 + Real.log (⌈Y⌉₊ : ℝ))) *
        ((2 * (⌈R⌉₊ : ℝ) + 3) + 4 * (⌈Y⌉₊ : ℝ) * (1 + Real.log (⌈Y⌉₊ : ℝ)))) *
          ((j.factorial : ℝ) * (2 / P) ^ j) := by
    convert hm using 1
    ring
  have hnum := hm'.trans (mul_le_mul_of_nonneg_right hv hz)
  have hnum' : ((primeExceptionalIntervals s b η R).card : ℝ) * (η ^ j) ^ 2 ≤
      (512 * Y * (1 + Real.log Y) ^ 2 * (j.factorial : ℝ)) * (2 / P) ^ j :=
    hnum.trans_eq (by ring)
  exact prime_moment_remove_threshold j hη hnum'

theorem prime_exceptional_intervals_rpow_count_bound (s : Finset ℕ)
    (hs : ∀ p ∈ s, Nat.Prime p) (P Y R L A : ℝ) (b : s → ℂ)
    (hP : 1 ≤ P) (hY : 1 ≤ Y) (hR : 0 ≤ R) (hRY : R ≤ Y) (hL : 0 < L)
    (hband : ∀ p ∈ s, P ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2 * P)
    (hb : ∀ p : s, ‖b p‖ ≤ 1) :
    ((primeExceptionalIntervals s b (L ^ (-A)) R).card : ℝ) ≤
      512 * Y * (1 + Real.log Y) ^ 2 * (primeMomentDegree Y P).factorial *
        (2 * L ^ (2 * A) / P) ^ primeMomentDegree Y P := by
  have h := prime_exceptional_intervals_count_bound s hs P Y R (L ^ (-A)) b hP hY hR hRY
    (Real.rpow_pos_of_pos hL _) hband hb
  rwa [prime_moment_rpow_threshold_ratio P A hL] at h

theorem prime_exceptional_intervals_subexponential_bound (s : Finset ℕ)
    (hs : ∀ p ∈ s, Nat.Prime p) (coeff : s → ℂ)
    {a beta c A L Y P R : ℝ}
    (ha0 : 0 ≤ a) (ha1 : a ≤ 1) (hc : 0 ≤ c) (hA : 0 ≤ A)
    (hL : Real.exp 1 ≤ L) (hY : 1 ≤ Y) (hlogY : Real.log Y ≤ c * L)
    (hPlo : Real.exp (L ^ a) / 2 ≤ P) (hPhi : P ≤ Real.exp (L ^ beta))
    (hR : 0 ≤ R) (hRY : R ≤ Y)
    (hband : ∀ p ∈ s, P ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2 * P)
    (hcoeff : ∀ p : s, ‖coeff p‖ ≤ 1) :
    ((primeExceptionalIntervals s coeff (L ^ (-A)) R).card : ℝ) ≤
      Real.exp (primeMomentActualExponent c A *
        (L ^ beta + L ^ (1 - a) * Real.log L)) := by
  have hL0 : 0 < L := (Real.exp_pos 1).trans_le hL
  have hL1 : 1 ≤ L := (Real.one_le_exp (by norm_num : (0 : ℝ) ≤ 1)).trans hL
  have hLa : 1 ≤ L ^ a := Real.one_le_rpow hL1 ha0
  have hE : 2 ≤ Real.exp (L ^ a) := by
    have htwo : (2 : ℝ) ≤ Real.exp 1 := by linarith [Real.add_one_le_exp (1 : ℝ)]
    exact htwo.trans (Real.exp_le_exp.mpr hLa)
  have hP : 1 ≤ P := by linarith
  have hcount := prime_exceptional_intervals_rpow_count_bound s hs P Y R L A coeff
    hP hY hR hRY hL0 hband hcoeff
  exact prime_moment_actual_budget_le_exp ha0 ha1 hc hA hL hY hlogY hPlo hPhi hcount

end Bounty
end

section

/- First derivative cancellation for the actual logarithmic phase on an arithmetic progression. -/

open Finset

namespace Bounty

theorem affine_logarithmic_first_positive (A B : ℤ) (q a N C t : ℝ)
    (hq : 0 < q) (hN : 0 < N) (hC : 1 ≤ C)
    (hlo : q*N ≤ q*(A : ℝ)+a) (hhi : q*((B : ℝ)+1)+a ≤ C*q*N)
    (ht : 0 < t) (htmax : t ≤ Real.pi*N) :
    ‖∑ y ∈ Icc A B, Complex.exp (((t*Real.log (q*(y : ℝ)+a) : ℝ) : ℂ)*Complex.I)‖ ≤
      4*Real.pi*C*N/t := by
  let c := t/(2*Real.pi)
  let δ := c/(C*N)
  have hc : 0 < c := by dsimp [c]; positivity
  have hC0 : 0 < C := by linarith
  have hcmax : c ≤ N/2 := by
    dsimp [c]
    apply (div_le_iff₀ (by positivity : 0 < 2*Real.pi)).mpr
    nlinarith
  have hδ : 0 < δ := by dsimp [δ]; positivity
  have hδhalf : δ ≤ 1/2 := by
    dsimp [δ]
    apply (div_le_iff₀ (mul_pos hC0 hN)).mpr
    nlinarith [mul_le_mul_of_nonneg_right hC hN.le]
  have hscale (x : ℝ) (hx : x ∈ Set.Icc (A : ℝ) ((B : ℝ)+1)) :
      q*N ≤ q*x+a ∧ q*x+a ≤ C*q*N := by
    have h1 := mul_le_mul_of_nonneg_left hx.1 hq.le
    have h2 := mul_le_mul_of_nonneg_left hx.2 hq.le
    constructor <;> linarith
  have hf (x : ℝ) (hx : x ∈ Set.Icc (A : ℝ) ((B : ℝ)+1)) :
      HasDerivAt (fun x => c*Real.log (q*x+a)) (c*q/(q*x+a)) x := by
    have hpos : 0 < q*x+a := (mul_pos hq hN).trans_le (hscale x hx).1
    have hlin : HasDerivAt (fun x => q*x+a) q x := by
      simpa only [mul_one,id_eq] using ((hasDerivAt_id x).const_mul q).add_const a
    have hd := (hlin.log hpos.ne').const_mul c
    have heq : c*(q/(q*x+a)) = c*q/(q*x+a) := by ring
    rw [heq] at hd
    exact hd
  have hband (x : ℝ) (hx : x ∈ Set.Icc (A : ℝ) ((B : ℝ)+1)) :
      (0 : ℝ)+δ ≤ c*q/(q*x+a) ∧ c*q/(q*x+a) ≤ (0 : ℝ)+1-δ := by
    have hpos : 0 < q*x+a := (mul_pos hq hN).trans_le (hscale x hx).1
    constructor
    · simp only [zero_add]
      apply (le_div_iff₀ hpos).mpr
      have hs := mul_le_mul_of_nonneg_left (hscale x hx).2 hδ.le
      have heq : δ*(C*q*N)=c*q := by dsimp [δ]; field_simp <;> ring
      exact hs.trans_eq heq
    · have hd : c*q/(q*x+a) ≤ 1/2 := by
        apply (div_le_iff₀ hpos).mpr
        nlinarith [(hscale x hx).1,mul_le_mul_of_nonneg_right hcmax hq.le]
      linarith
  have hm : AntitoneOn (fun x => c*q/(q*x+a)) (Set.Icc (A : ℝ) ((B : ℝ)+1)) := by
    intro x hx y hy hxy
    have hpos : 0 < q*x+a := (mul_pos hq hN).trans_le (hscale x hx).1
    exact div_le_div_of_nonneg_left (mul_nonneg hc.le hq.le) hpos
      (add_le_add (mul_le_mul_of_nonneg_left hxy hq.le) le_rfl)
  have h := first_derivative_test (fun x => c*Real.log (q*x+a))
    (fun x => c*q/(q*x+a)) A B 0 hδ hδhalf hf
    (by simpa only [Int.cast_zero] using hband) (Or.inr hm)
  have he (y : ℤ) : realUnitPhase (c*Real.log (q*(y : ℝ)+a)) =
      Complex.exp (((t*Real.log (q*(y : ℝ)+a) : ℝ) : ℂ)*Complex.I) := by
    unfold realUnitPhase
    congr 2
    dsimp [c]
    field_simp
  simp_rw [he] at h
  calc
    _ ≤ 2/δ := h
    _ = _ := by dsimp [δ,c]; field_simp <;> ring

theorem affine_logarithmic_first_bound (A B : ℤ) (q a N C t : ℝ)
    (hq : 0 < q) (hN : 0 < N) (hC : 1 ≤ C)
    (hlo : q*N ≤ q*(A : ℝ)+a) (hhi : q*((B : ℝ)+1)+a ≤ C*q*N)
    (ht : t ≠ 0) (htmax : |t| ≤ Real.pi*N) :
    ‖∑ y ∈ Icc A B, Complex.exp (((t*Real.log (q*(y : ℝ)+a) : ℝ) : ℂ)*Complex.I)‖ ≤
      4*Real.pi*C*N/|t| := by
  rcases lt_or_gt_of_ne ht with hneg | hpos
  · have h := affine_logarithmic_first_positive A B q a N C (-t) hq hN hC hlo hhi
      (by linarith) (by simpa only [abs_of_neg hneg] using htmax)
    simp only [neg_mul] at h
    rw [norm_sum_exp_phase_neg] at h
    simpa only [abs_of_neg hneg] using h
  · exact (affine_logarithmic_first_positive A B q a N C t hq hN hC hlo hhi hpos
      (by simpa only [abs_of_pos hpos] using htmax)).trans_eq (by rw [abs_of_pos hpos])

end Bounty
end

section

open Finset

namespace Bounty

theorem real_unit_phase_mixed_div_two_pi
    (hs : List ℝ) (f : ℝ → ℝ) (x : ℝ) :
    realUnitPhase (mixedForwardDifference hs (fun y => f y / (2*Real.pi)) x) =
      Complex.exp ((mixedForwardDifference hs f x : ℂ)*Complex.I) := by
  have hf : (fun y => f y / (2*Real.pi)) = (fun y => (2*Real.pi)⁻¹ * f y) := by
    funext y; ring
  rw [hf, mixed_forward_difference_const_mul]
  unfold realUnitPhase
  congr 1
  push_cast
  field_simp
  <;> ring

theorem mixed_logarithmic_exp_sum_bound
    (hs : List ℝ) (q a u lo hi : ℝ) (l r : ℕ)
    (hq : 0 < q) (hu : u ≠ 0) (hlr : l ≤ r)
    (hhs : ∀ h ∈ hs, 0 < h) (hlo : 0 < lo) (hlohi : lo ≤ hi)
    (hbox : ∀ x ∈ Set.Icc (l:ℝ) ((r:ℝ)+1),
      lo ≤ x+a/q ∧ x+a/q+hs.sum ≤ hi) :
    let d := hs.length+2
    let lam := hs.prod * |u/(2*Real.pi)| * ((hs.length+1).factorial:ℝ) / hi^d
    let A := (hi/lo)^d
    ‖∑ n ∈ Icc l r, Complex.exp
      ((mixedForwardDifference hs (fun y => u * Real.log (q*y+a)) (n:ℝ) : ℂ)*Complex.I)‖ ≤
      6*(A*((r:ℝ)-l+1)*Real.sqrt lam+2/Real.sqrt lam) := by
  have hne : u/(2*Real.pi) ≠ 0 := div_ne_zero hu (by positivity)
  have hb := mixed_logarithmic_sum_bound hs q a (u/(2*Real.pi)) lo hi l r
    hq hne hlr hhs hlo hlohi hbox
  have hf : (fun y => u/(2*Real.pi)*Real.log (q*y+a)) =
      (fun y => (u*Real.log (q*y+a))/(2*Real.pi)) := by funext y; ring
  rw [hf] at hb
  simpa only [real_unit_phase_mixed_div_two_pi] using hb

end Bounty
end

section

/- Positive damping gives an explicit, bounded loss for the retained overlap branch. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_shared_primes_card {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) :
    (physicalSharedPrimes C L).card = ∑ g : G, (J - (C g).card) := by
  rw [physicalSharedPrimes, card_map]
  have he : (univ.filter (fun a : Σ _g : G, PhysicalSlots J ell =>
      a.2 ∈ physicalSharedSlots (C a.1))) = univ.sigma (fun g => physicalSharedSlots (C g)) := by
    ext a
    simp only [mem_filter, mem_univ, true_and, mem_sigma]
  rw [he, card_sigma]
  simp only [physical_shared_slots_card]

theorem physical_shared_overlap_count {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (q : ℝ) (w : ℤ) :
    physicalSharedOverlap C L q w =
      q ^ ((physicalSharedPrimes C L).filter (fun p => (p.2.val : ℤ) ∣ w)).card := by
  simp only [physicalSharedOverlap, prod_ite, prod_const, one_pow, mul_one]

theorem physical_shared_overlap_lower {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) {q : ℝ} (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (w : ℤ) :
    q ^ (∑ g : G, (J - (C g).card)) ≤ physicalSharedOverlap C L q w := by
  rw [physical_shared_overlap_count, ← physical_shared_primes_card C L]
  exact pow_le_pow_of_le_one hq0 hq1 (card_filter_le _ _)

theorem physical_shared_vertex_overlap_bound {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) {q : ℝ}
    (hq0 : 0 < q) (hq1 : q ≤ 1) (w : ℤ) :
    physicalVertexWeight L q ((physicalSharedFactor C L : ℤ) * w) ≤
      physicalUnsharedVertex C L q w / q ^ (∑ g : G, (J - (C g).card)) := by
  have hn : 0 ≤ physicalVertexWeight L q ((physicalSharedFactor C L : ℤ) * w) := by
    unfold physicalVertexWeight
    split_ifs
    · exact prod_nonneg (fun g _ => pow_nonneg hq0.le _)
    · exact le_rfl
  apply (le_div_iff₀ (pow_pos hq0 _)).mpr
  calc
    _ ≤ physicalVertexWeight L q ((physicalSharedFactor C L : ℤ) * w) *
        physicalSharedOverlap C L q w :=
      mul_le_mul_of_nonneg_left (physical_shared_overlap_lower C L hq0.le hq1 w) hn
    _ = _ := physical_shared_vertex_removal C L hprime hdis q w

theorem physical_shared_vertex_nonzero_iff {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) {q : ℝ}
    (hq0 : 0 < q) (w : ℤ) :
    physicalUnsharedVertex C L q w ≠ 0 ↔
      physicalVertexWeight L q ((physicalSharedFactor C L : ℤ) * w) ≠ 0 := by
  have hp : physicalSharedOverlap C L q w ≠ 0 := by
    rw [physical_shared_overlap_count]
    exact ne_of_gt (pow_pos hq0 _)
  rw [← physical_shared_vertex_removal C L hprime hdis q w]
  exact mul_ne_zero_iff.trans (and_iff_left hp)

theorem physical_shared_vertex_pair_overlap_bound {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L R : PhysicalMarkLists P J ell) (hshared : physicalSharedCompatible C L R)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) {q : ℝ}
    (hq0 : 0 < q) (hq1 : q ≤ 1) (w z : ℤ) :
    physicalVertexWeight L q ((physicalSharedFactor C L : ℤ) * w) *
        physicalVertexWeight R q ((physicalSharedFactor C L : ℤ) * z) ≤
      (physicalUnsharedVertex C L q w * physicalUnsharedVertex C R q z) /
        q ^ (2 * ∑ g : G, (J - (C g).card)) := by
  have hn (T : PhysicalMarkLists P J ell) (n : ℤ) : 0 ≤ physicalVertexWeight T q n := by
    unfold physicalVertexWeight
    split_ifs
    · exact prod_nonneg (fun g _ => pow_nonneg hq0.le _)
    · exact le_rfl
  have ho : q ^ (2 * ∑ g : G, (J - (C g).card)) ≤
      physicalSharedOverlap C L q w * physicalSharedOverlap C L q z := by
    rw [two_mul, pow_add]
    exact mul_le_mul (physical_shared_overlap_lower C L hq0.le hq1 w)
      (physical_shared_overlap_lower C L hq0.le hq1 z) (pow_nonneg hq0.le _)
      ((pow_nonneg hq0.le _).trans (physical_shared_overlap_lower C L hq0.le hq1 w))
  apply (le_div_iff₀ (pow_pos hq0 _)).mpr
  calc
    _ ≤ (physicalVertexWeight L q ((physicalSharedFactor C L : ℤ) * w) *
        physicalVertexWeight R q ((physicalSharedFactor C L : ℤ) * z)) *
        (physicalSharedOverlap C L q w * physicalSharedOverlap C L q z) :=
      mul_le_mul_of_nonneg_left ho (mul_nonneg (hn L _) (hn R _))
    _ = _ := physical_shared_vertex_pair_removal C L R hshared hprime hdis q w z

end Bounty
end

section

/- The residual weight retains an arbitrary bounded cutoff on the complete pool part. -/

open Finset

namespace Bounty

noncomputable def selectedMarkedWeight {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (Q : Finset ℕ) (q : ℝ) (V : G → ℝ)
    (t u : G → ℕ) (big : Finset G)
    (b : GroupMarkedLists (fun g : big => P g.val) (fun g : big => u g.val) → ℂ)
    (κ : ℕ → ℂ) (n : ℕ) : ℂ :=
  κ (primePoolPart Q n) * (markedDivisorWeight univ P q V t (n : ℤ) : ℂ) *
    groupMarkedAverage (fun g : big => P g.val) (fun g : big => u g.val) (n : ℤ) b

theorem selected_marked_weight_mul_free {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (Q : Finset ℕ) (q : ℝ) (V : G → ℝ)
    (t u : G → ℕ) (big : Finset G)
    (b : GroupMarkedLists (fun g : big => P g.val) (fun g : big => u g.val) → ℂ)
    (κ : ℕ → ℂ) (hP : ∀ g, ∀ p ∈ P g, p.Prime) (hPQ : ∀ g, P g ⊆ Q)
    (a d : ℕ) (hd : d ≠ 0) (hfree : Disjoint d.primeFactors Q) :
    selectedMarkedWeight P Q q V t u big b κ (a * d) =
      selectedMarkedWeight P Q q V t u big b κ a := by
  unfold selectedMarkedWeight
  rw [primePoolPart_mul_pool_free Q a d hd hfree,
    marked_divisor_weight_mul_free univ P Q q V t (fun g _ => hP g) (fun g _ => hPQ g) a d hd hfree,
    group_marked_average_mul_free (fun g : big => P g.val) Q (fun g : big => u g.val)
      (fun g => hP g.val) (fun g => hPQ g.val) a d hd hfree b]

theorem selected_marked_weight_norm_le {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (Q : Finset ℕ) {q v : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (V : G → ℝ)
    (t u : G → ℕ) (T : ℕ) (big : Finset G)
    (hV : ∀ g, v ≤ V g) (ht : ∀ g, t g ≤ T)
    (b : GroupMarkedLists (fun g : big => P g.val) (fun g : big => u g.val) → ℂ)
    {H : ℝ} (hH : 0 ≤ H) (hb : ∀ L, ‖b L‖ ≤ H)
    (κ : ℕ → ℂ) (hκ : ∀ d, ‖κ d‖ ≤ 1) (n : ℕ) :
    ‖selectedMarkedWeight P Q q V t u big b κ n‖ ≤
      (markedDivisorBound q v T) ^ Fintype.card G * H := by
  have hw := marked_divisor_weight_le_pow univ P hq0 hq1 hv V t T
    (fun g _ => hV g) (fun g _ => ht g) (n : ℤ)
  have hw0 := marked_divisor_weight_nonneg univ P hq0 V t
    (fun g _ => hv.le.trans (hV g)) (n : ℤ)
  have hb' := group_marked_average_norm_le (fun g : big => P g.val)
    (fun g : big => u g.val) (n : ℤ) b hH (fun L => hb L.val)
  rw [selectedMarkedWeight, norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg hw0]
  calc
    _ ≤ 1 * (markedDivisorWeight univ P q V t (n : ℤ)) * H :=
      mul_le_mul (mul_le_mul_of_nonneg_right (hκ _) hw0) hb'
        (norm_nonneg _) (by positivity)
    _ ≤ _ := by simpa only [one_mul, card_univ] using mul_le_mul_of_nonneg_right hw hH

theorem selected_marked_weight_triple_convolution {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (Q : Finset ℕ) (q : ℝ) (V : G → ℝ)
    (t u : G → ℕ) (big : Finset G)
    (b : GroupMarkedLists (fun g : big => P g.val) (fun g : big => u g.val) → ℂ)
    (κ α β γ : ℕ → ℂ) (hP : ∀ g, ∀ p ∈ P g, p.Prime) (hPQ : ∀ g, P g ⊆ Q)
    (hα : ∀ d, ¬ Disjoint d.primeFactors Q → α d = 0)
    (hβ : ∀ d, ¬ Disjoint d.primeFactors Q → β d = 0)
    {n : ℕ} (hn : n ≠ 0) :
    selectedMarkedWeight P Q q V t u big b κ n * invariantTripleEndpoint Q α β γ n =
      endpointTripleConvolution α β
        (fun r => selectedMarkedWeight P Q q V t u big b κ r * γ (primePoolFreePart Q r)) n :=
  weighted_invariant_triple_convolution Q _ α β γ
    (selected_marked_weight_mul_free P Q q V t u big b κ hP hPQ) hα hβ hn

end Bounty
end

section

/- A cutoff on the complete pool part couples the extracted prime to the residual pool part. -/

open Finset

namespace Bounty

theorem primePoolPart_eq_prime_mul_quotient (Q : Finset ℕ) {p n : ℕ}
    (hp : p.Prime) (hpQ : p ∈ Q) (hn : n ≠ 0) (hpn : p ∣ n) :
    primePoolPart Q n = p * primePoolPart Q (n / p) := by
  have hq : n / p ≠ 0 := by
    intro hz
    have he := Nat.mul_div_cancel' hpn
    rw [hz, mul_zero] at he
    exact hn he.symm
  have hpp : p ∈ Nat.factoredNumbers Q := by
    apply Nat.mem_factoredNumbers_of_primeFactors_subset hp.ne_zero
    intro d hd
    have he : d = p := by simpa only [hp.primeFactors, mem_singleton] using hd
    simpa only [he] using hpQ
  have he := primePoolPart_mul Q hp.ne_zero hq
  rw [Nat.mul_div_cancel' hpn, primePoolPart_eq_self_of_mem hpp] at he
  exact he

theorem prime_peel_cutoff_triple_convolution (S Q : Finset ℕ) (κ δ W α β γ : ℕ → ℂ)
    (hS : ∀ p ∈ S, p.Prime) (hSQ : S ⊆ Q)
    (hW : ∀ a d : ℕ, d ≠ 0 → Disjoint d.primeFactors Q → W (a * d) = W a)
    (hα : ∀ d, ¬ Disjoint d.primeFactors Q → α d = 0)
    (hβ : ∀ d, ¬ Disjoint d.primeFactors Q → β d = 0)
    {n : ℕ} (hn : n ≠ 0) :
    κ (primePoolPart Q n) *
      (∑ p ∈ S, if p ∣ n then δ p *
        (W (n / p) * invariantTripleEndpoint Q α β γ (n / p)) else 0) =
      ∑ p ∈ S, if p ∣ n then δ p * endpointTripleConvolution α β
        (fun r => (κ (p * primePoolPart Q r) * W r) * γ (primePoolFreePart Q r)) (n / p)
        else 0 := by
  classical
  rw [mul_sum]
  apply sum_congr rfl
  intro p hp
  by_cases hpn : p ∣ n
  · rw [if_pos hpn, if_pos hpn]
    have hq : n / p ≠ 0 := by
      intro hz
      have he := Nat.mul_div_cancel' hpn
      rw [hz, mul_zero] at he
      exact hn he.symm
    have h := weighted_invariant_triple_convolution Q
      (fun r => κ (p * primePoolPart Q r) * W r) α β γ
      (fun a d hd hf => by rw [primePoolPart_mul_pool_free Q a d hd hf, hW a d hd hf])
      hα hβ hq
    rw [← h, primePoolPart_eq_prime_mul_quotient Q (hS p hp) (hSQ hp) hn hpn]
    ring
  · rw [if_neg hpn, if_neg hpn, mul_zero]

end Bounty
end

section

/- Absolute coefficient energy for the collapsed four-factor polynomial. -/

open Finset

namespace Bounty

theorem endpoint_four_convolution_square_sum (δ α β γ : ℕ → ℂ) {D A B C : ℝ}
    (hD : 0 ≤ D) (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hδ : ∀ d, ‖δ d‖ ≤ D) (hα : ∀ d, ‖α d‖ ≤ A)
    (hβ : ∀ d, ‖β d‖ ≤ B) (hγ : ∀ d, ‖γ d‖ ≤ C)
    (S : Finset ℕ) (N : ℕ) (hS : ∀ n ∈ S, 0 < n ∧ n ≤ N) :
    (∑ n ∈ S, ‖endpointFourConvolution δ α β γ n‖ ^ 2) ≤
      (D * A * B * C) ^ 2 * ((N : ℝ) * (1 + Real.log N) ^ 15) := by
  have hsub : S ⊆ Ioc 0 N := fun n hn => mem_Ioc.mpr (hS n hn)
  calc
    _ ≤ ∑ n ∈ S, (D * A * B * C) ^ 2 * (((ArithmeticFunction.zeta ^ 4) n : ℕ) : ℝ) ^ 2 := by
      apply sum_le_sum
      intro n _
      simpa only [mul_pow] using pow_le_pow_left₀ (norm_nonneg _)
        (endpoint_four_convolution_zeta_bound δ α β γ hD hA hB hC hδ hα hβ hγ n) 2
    _ = (D * A * B * C) ^ 2 * ∑ n ∈ S, (((ArithmeticFunction.zeta ^ 4) n : ℕ) : ℝ) ^ 2 := by rw [mul_sum]
    _ ≤ (D * A * B * C) ^ 2 * ∑ n ∈ Ioc 0 N, (((ArithmeticFunction.zeta ^ 4) n : ℕ) : ℝ) ^ 2 :=
      mul_le_mul_of_nonneg_left (sum_le_sum_of_subset_of_nonneg hsub (by intros; positivity)) (sq_nonneg _)
    _ ≤ _ := mul_le_mul_of_nonneg_left (zeta_four_square_summatory N) (sq_nonneg _)

theorem endpoint_four_convolution_reciprocal_energy (δ α β γ : ℕ → ℂ) {D A B C U : ℝ}
    (hD : 0 ≤ D) (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C) (hU : 0 < U)
    (hδ : ∀ d, ‖δ d‖ ≤ D) (hα : ∀ d, ‖α d‖ ≤ A)
    (hβ : ∀ d, ‖β d‖ ≤ B) (hγ : ∀ d, ‖γ d‖ ≤ C)
    (S : Finset ℕ) (N : ℕ) (hS : ∀ n ∈ S, 0 < n ∧ n ≤ N)
    (hUS : ∀ n ∈ S, U ≤ (n : ℝ)) :
    (∑ n ∈ S, ‖endpointFourConvolution δ α β γ n / (n : ℂ)‖ ^ 2) ≤
      (D * A * B * C) ^ 2 * ((N : ℝ) * (1 + Real.log N) ^ 15) / U ^ 2 := by
  calc
    _ ≤ ∑ n ∈ S, ‖endpointFourConvolution δ α β γ n‖ ^ 2 / U ^ 2 := by
      apply sum_le_sum
      intro n hn
      rw [norm_div, Complex.norm_natCast, div_pow]
      exact div_le_div_of_nonneg_left (sq_nonneg _) (sq_pos_of_pos hU)
        (pow_le_pow_left₀ hU.le (hUS n hn) 2)
    _ = (∑ n ∈ S, ‖endpointFourConvolution δ α β γ n‖ ^ 2) / U ^ 2 := by rw [sum_div]
    _ ≤ _ := div_le_div_of_nonneg_right
      (endpoint_four_convolution_square_sum δ α β γ hD hA hB hC hδ hα hβ hγ S N hS)
      (sq_nonneg U)

end Bounty
end

section

/- A product of actual finite Mellin factors has a literal dyadic coefficient representation. -/

open Finset

namespace Bounty

theorem endpoint_four_dyadic_representation (S D A B C : Finset ℕ) (δ α β γ : ℕ → ℂ)
    (hD : ∀ d ∈ D, 0 < d) (hA : ∀ a ∈ A, 0 < a)
    (hB : ∀ b ∈ B, 0 < b) (hC : ∀ c ∈ C, 0 < c)
    (hδ : ∀ d, d ∉ D → δ d = 0) (hα : ∀ a, a ∉ A → α a = 0)
    (hβ : ∀ b, b ∉ B → β b = 0) (hγ : ∀ c, c ∉ C → γ c = 0)
    (hS : ∀ d ∈ D, ∀ a ∈ A, ∀ b ∈ B, ∀ c ∈ C, d*a*b*c ∈ S)
    (U : ℝ) (hU : 0 ≤ U) (K : ℕ)
    (hsize : ∀ d ∈ D, ∀ a ∈ A, ∀ b ∈ B, ∀ c ∈ C,
      U < (d*a*b*c : ℕ) ∧ (d*a*b*c : ℕ) ≤ (2 : ℝ)^K*U) (t : ℝ) :
    (∑ d ∈ D, δ d*harmonicMellinWeight t d)*
      (∑ a ∈ A, α a*harmonicMellinWeight t a)*
      (∑ b ∈ B, β b*harmonicMellinWeight t b)*
      (∑ c ∈ C, γ c*harmonicMellinWeight t c) =
      ∑ j : Fin K, ∑ n ∈ Icc (⌊(2 : ℝ)^j.val*U⌋₊+1) ⌊(2 : ℝ)^(j.val+1)*U⌋₊,
        (if n ∈ S then endpointFourConvolution δ α β γ n/(n : ℂ) else 0)*
          Complex.exp (((Real.log (n : ℝ)*t : ℝ) : ℂ)*Complex.I) := by
  rw [← endpoint_four_finite_mellin S D A B C δ α β γ hD hA hB hC hδ hα hβ hγ hS]
  apply finite_mellin_dyadic_representation S _ U hU K
  intro n hn hne
  obtain ⟨d,a,b,c,hd,ha,hb,hc,hdn,han,hbn,hcn,he⟩ :=
    endpoint_four_nonzero_factors δ α β γ hne
  have hdD : d ∈ D := by by_contra hz; exact hdn (hδ d hz)
  have haA : a ∈ A := by by_contra hz; exact han (hα a hz)
  have hbB : b ∈ B := by by_contra hz; exact hbn (hβ b hz)
  have hcC : c ∈ C := by by_contra hz; exact hcn (hγ c hz)
  simpa only [he] using hsize d hdD a haA b hbB c hcC

end Bounty
end

section

/- Exact dyadic representations of the ordinary and sparse mean-square subproducts. -/

open Finset

namespace Bounty

theorem divisor_pair_dyadic_representation (S A B : Finset ℕ) (α β : ℕ → ℂ)
    (hA : ∀ a ∈ A, 0 < a) (hB : ∀ b ∈ B, 0 < b)
    (hα : ∀ a, a ∉ A → α a = 0) (hβ : ∀ b, b ∉ B → β b = 0)
    (hS : ∀ a ∈ A, ∀ b ∈ B, a*b ∈ S) (U : ℝ) (hU : 0 ≤ U) (K : ℕ)
    (hsize : ∀ a ∈ A, ∀ b ∈ B, U < (a*b : ℕ) ∧ (a*b : ℕ) ≤ (2 : ℝ)^K*U) (t : ℝ) :
    (∑ a ∈ A, α a*harmonicMellinWeight t a)*(∑ b ∈ B, β b*harmonicMellinWeight t b) =
      ∑ j : Fin K, ∑ n ∈ Icc (⌊(2 : ℝ)^j.val*U⌋₊+1) ⌊(2 : ℝ)^(j.val+1)*U⌋₊,
        (if n ∈ S then (∑ d ∈ n.divisors, α d*β (n/d))/(n : ℂ) else 0)*
          Complex.exp (((Real.log (n : ℝ)*t : ℝ) : ℂ)*Complex.I) := by
  rw [← divisor_pair_finite_mellin S A B α β hA hB hα hβ hS]
  apply finite_mellin_dyadic_representation S _ U hU K
  intro n hn hne
  obtain ⟨a,b,ha,hb,han,hbn,he⟩ := divisor_pair_nonzero_factors α β hne
  have haA : a ∈ A := by by_contra hz; exact han (hα a hz)
  have hbB : b ∈ B := by by_contra hz; exact hbn (hβ b hz)
  simpa only [he] using hsize a haA b hbB

theorem endpoint_triple_dyadic_representation (S A B C : Finset ℕ) (α β γ : ℕ → ℂ)
    (hA : ∀ a ∈ A, 0 < a) (hB : ∀ b ∈ B, 0 < b) (hC : ∀ c ∈ C, 0 < c)
    (hα : ∀ a, a ∉ A → α a = 0) (hβ : ∀ b, b ∉ B → β b = 0)
    (hγ : ∀ c, c ∉ C → γ c = 0)
    (hS : ∀ a ∈ A, ∀ b ∈ B, ∀ c ∈ C, a*b*c ∈ S) (U : ℝ) (hU : 0 ≤ U) (K : ℕ)
    (hsize : ∀ a ∈ A, ∀ b ∈ B, ∀ c ∈ C,
      U < (a*b*c : ℕ) ∧ (a*b*c : ℕ) ≤ (2 : ℝ)^K*U) (t : ℝ) :
    (∑ a ∈ A, α a*harmonicMellinWeight t a)*
      (∑ b ∈ B, β b*harmonicMellinWeight t b)*(∑ c ∈ C, γ c*harmonicMellinWeight t c) =
      ∑ j : Fin K, ∑ n ∈ Icc (⌊(2 : ℝ)^j.val*U⌋₊+1) ⌊(2 : ℝ)^(j.val+1)*U⌋₊,
        (if n ∈ S then endpointTripleConvolution α β γ n/(n : ℂ) else 0)*
          Complex.exp (((Real.log (n : ℝ)*t : ℝ) : ℂ)*Complex.I) := by
  rw [← endpoint_triple_finite_mellin S A B C α β γ hA hB hC hα hβ hγ hS]
  apply finite_mellin_dyadic_representation S _ U hU K
  intro n hn hne
  obtain ⟨a,b,c,ha,hb,hc,han,hbn,hcn,he⟩ := endpoint_triple_nonzero_factors α β γ hne
  have haA : a ∈ A := by by_contra hz; exact han (hα a hz)
  have hbB : b ∈ B := by by_contra hz; exact hbn (hβ b hz)
  have hcC : c ∈ C := by by_contra hz; exact hcn (hγ c hz)
  simpa only [he] using hsize a haA b hbB c hcC

end Bounty
end

section

/- Actual divisor convolutions satisfy the global T-factor norm budget. -/

open Finset Filter

namespace Bounty

theorem eventually_pair_convolution_mellin_power_norm (c E : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (β γ : ℕ → ℂ) (B C U : ℝ) (S : Finset ℕ) (θ : ℝ → ℕ → ℂ),
      0 ≤ B → 0 ≤ C → 1 ≤ U → Real.log U ≤ c*L → B*C ≤ L^E →
      (∀ n, ‖β n‖ ≤ B) → (∀ n, ‖γ n‖ ≤ C) →
      (∀ n ∈ S, U ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*U) →
      (∀ u n, n ∈ S → ‖θ u n‖ ≤ 1) →
      ∀ u : ℝ, ‖∑ n ∈ S, harmonicMellinWeight u n*
        ((∑ d ∈ n.divisors, β d*γ (n/d))*θ u n)‖ ≤ L^(E+2) := by
  filter_upwards [eventually_twisted_dyadic_mellin_zeta_power_norm c E 1] with L hL
  intro β γ B C U S θ hB hC hU hlog hprod hβ hγ hS hθ u
  have hh := hL S (fun n => ∑ d ∈ n.divisors, β d*γ (n/d)) θ U (B*C)
    hU hlog (mul_nonneg hB hC) hprod hS
    (fun n _ => divisor_pair_convolution_norm_le β γ hB hC hβ hγ n) hθ u
  simpa only [Nat.cast_one, show E+1+1=E+2 by ring] using hh

theorem eventually_triple_convolution_mellin_power_norm (c E : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (α β γ : ℕ → ℂ) (A B C U : ℝ) (S : Finset ℕ) (θ : ℝ → ℕ → ℂ),
      0 ≤ A → 0 ≤ B → 0 ≤ C → 1 ≤ U → Real.log U ≤ c*L → A*B*C ≤ L^E →
      (∀ n, ‖α n‖ ≤ A) → (∀ n, ‖β n‖ ≤ B) → (∀ n, ‖γ n‖ ≤ C) →
      (∀ n ∈ S, U ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*U) →
      (∀ u n, n ∈ S → ‖θ u n‖ ≤ 1) →
      ∀ u : ℝ, ‖∑ n ∈ S, harmonicMellinWeight u n*
        (endpointTripleConvolution α β γ n*θ u n)‖ ≤ L^(E+3) := by
  filter_upwards [eventually_twisted_dyadic_mellin_zeta_power_norm c E 2] with L hL
  intro α β γ A B C U S θ hA hB hC hU hlog hprod hα hβ hγ hS hθ u
  have hh := hL S (endpointTripleConvolution α β γ) θ U (A*B*C)
    hU hlog (mul_nonneg (mul_nonneg hA hB) hC) hprod hS
    (fun n _ => endpoint_triple_convolution_zeta_bound α β γ hA hB hC hα hβ hγ n) hθ u
  simpa only [Nat.cast_ofNat, show E+2+1=E+3 by ring] using hh

theorem eventually_four_convolution_mellin_power_norm (c E : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (δ α β γ : ℕ → ℂ) (D A B C U : ℝ)
      (S : Finset ℕ) (θ : ℝ → ℕ → ℂ),
      0 ≤ D → 0 ≤ A → 0 ≤ B → 0 ≤ C → 1 ≤ U → Real.log U ≤ c*L → D*A*B*C ≤ L^E →
      (∀ n, ‖δ n‖ ≤ D) → (∀ n, ‖α n‖ ≤ A) → (∀ n, ‖β n‖ ≤ B) → (∀ n, ‖γ n‖ ≤ C) →
      (∀ n ∈ S, U ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*U) →
      (∀ u n, n ∈ S → ‖θ u n‖ ≤ 1) →
      ∀ u : ℝ, ‖∑ n ∈ S, harmonicMellinWeight u n*
        (endpointFourConvolution δ α β γ n*θ u n)‖ ≤ L^(E+4) := by
  filter_upwards [eventually_twisted_dyadic_mellin_zeta_power_norm c E 3] with L hL
  intro δ α β γ D A B C U S θ hD hA hB hC hU hlog hprod hδ hα hβ hγ hS hθ u
  have hh := hL S (endpointFourConvolution δ α β γ) θ U (D*A*B*C)
    hU hlog (mul_nonneg (mul_nonneg (mul_nonneg hD hA) hB) hC) hprod hS
    (fun n _ => endpoint_four_convolution_zeta_bound δ α β γ hD hA hB hC hδ hα hβ hγ n) hθ u
  simpa only [Nat.cast_ofNat, show E+3+1=E+4 by ring] using hh

end Bounty
end

section

/- Actual common event labels decoded from fresh draws and ordered ghost
births. Complement slots embed into their original full target slots. -/

open Finset Classical
namespace Bounty

section Edge
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ) (k : K)

noncomputable def commonForestEdgeLabels
    (draw : ∀ g, EdgeDrawObservation (P g) (S k g)ᶜ.card) :
    FullMixedCommonLocalAddress M B (some (Sum.inr (α := J) k)) →
      Option ((g : Fin N) × P g) :=
  optionalBirthExtension (fullMixedCommonLocalEmbedding S B (some (.inr k)))
    (fun ⟨g, i⟩ => if h : i ∈ (draw g).2.1 then none
      else some ⟨g, (draw g).2.2 ⟨i, h⟩⟩)

theorem common_forest_edge_labels_embed
    (draw : ∀ g, EdgeDrawObservation (P g) (S k g)ᶜ.card)
    (g : Fin N) (i : Fin (S k g)ᶜ.card) :
    commonForestEdgeLabels (J := J) S B k draw
      ⟨g, ((S k g)ᶜ.equivFin.symm i).val⟩ =
      if h : i ∈ (draw g).2.1 then none else some ⟨g, (draw g).2.2 ⟨i, h⟩⟩ := by
  have he : fullMixedCommonLocalEmbedding (J := J) S B (some (.inr k)) ⟨g, i⟩ =
      ⟨g, ((S k g)ᶜ.equivFin.symm i).val⟩ := by
    change (⟨g, fullMixedCommonSlotEmbedding S B (some (.inr k)) g i⟩ :
      (g : Fin N) × Fin (M g)) = _
    exact congrArg (fun j : Fin (M g) => (⟨g, j⟩ : (g : Fin N) × Fin (M g)))
      (full_mixed_common_slot_edge (J := J) S B k g i)
  rw [← he]
  unfold commonForestEdgeLabels
  rw [optional_birth_extension_apply]
  dsimp only
  split_ifs <;> first | rfl | contradiction

theorem common_forest_edge_labels_outside
    (draw : ∀ g, EdgeDrawObservation (P g) (S k g)ᶜ.card)
    (a : FullMixedCommonLocalAddress M B (some (Sum.inr (α := J) k)))
    (ha : ¬∃ b, fullMixedCommonLocalEmbedding S B (some (.inr k)) b = a) :
    commonForestEdgeLabels S B k draw a = none :=
  optional_birth_extension_none _ _ _ ha

theorem full_mixed_common_edge_labels_eq_observation
    (n : (g : Fin N) → P g → ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent (J := J) n S B A Δ D (some (.inr k)) s) :
    fullMixedCommonEventBirthLabel n S B A Δ D (some (.inr k)) s e =
      commonForestEdgeLabels S B k
        (fun g => ⟨(e.2 g).1, (e.2 g).2.1, (e.2 g).2.2.2⟩) := by
  funext a
  rw [full_mixed_common_event_label_extension]
  apply congrArg (fun f => optionalBirthExtension
    (fullMixedCommonLocalEmbedding S B (some (.inr k))) f a)
  funext b
  obtain ⟨g, i⟩ := b
  simp only [fullMixedEventBirthLabel, fullMixedEventBornData]
  split_ifs <;> rfl

end Edge

section Ghost
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ) (j : J)

noncomputable def commonForestGhostLabels
    (born : ∀ g, Σ b : Fin (B + 1), Fin b.val → P g) :
    FullMixedCommonLocalAddress M B (some (Sum.inl (β := K) j)) →
      Option ((g : Fin N) × P g) :=
  fun ⟨g, i⟩ => if h : i.val < (born g).1.val then
    some ⟨g, (born g).2 ⟨i.val, h⟩⟩ else none

theorem full_mixed_common_ghost_labels_eq_observation
    (n : (g : Fin N) → P g → ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (some (.inl j)) s) :
    fullMixedCommonEventBirthLabel n S B A Δ D (some (.inl j)) s e =
      commonForestGhostLabels (M := M) B j
        (fun g => ⟨(e.down g).1, fun i => ((e.down g).2.2 i).1⟩) := by
  funext a
  have h := full_mixed_common_event_label_embed n S B A Δ D (some (.inl j)) s e a
  change fullMixedCommonEventBirthLabel n S B A Δ D (some (.inl j)) s e a = _ at h
  rw [h]
  obtain ⟨g, i⟩ := a
  simp only [fullMixedEventBirthLabel, fullMixedEventBornData, commonForestGhostLabels]
  split_ifs <;> rfl

end Ghost
end Bounty
end

section

/- A nonzero original endpoint coefficient supplies the product scales used by the integral. -/

open Filter

namespace Bounty

theorem active_four_convolution_product_scales (δ α β γ : ℕ → ℂ)
    {Y P UQ UM UT : ℝ} (hP : 0 < P) (hQ : 0 < UQ) (hM : 0 < UM) (hT : 0 < UT)
    (hδ : ∀ n, δ n ≠ 0 → P ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*P)
    (hα : ∀ n, α n ≠ 0 → UQ ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*UQ)
    (hβ : ∀ n, β n ≠ 0 → UM ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*UM)
    (hγ : ∀ n, γ n ≠ 0 → UT ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*UT)
    {n : ℕ} (hn : endpointFourConvolution δ α β γ n ≠ 0)
    (hYn : Y ≤ (n : ℝ)) (hnY : (n : ℝ) ≤ 2*Y) :
    Y/(32*P) ≤ UQ*UM*UT/2 ∧ Y/(32*P*UQ) ≤ UM*UT/2 ∧
      UQ*UM*UT ≤ 2*Y/P := by
  obtain ⟨p,q,m,t,_,_,_,_,hp,hq,hm,ht,he⟩ := endpoint_four_nonzero_factors δ α β γ hn
  obtain ⟨hpL,hpU⟩ := hδ p hp
  obtain ⟨hqL,hqU⟩ := hα q hq
  obtain ⟨hmL,hmU⟩ := hβ m hm
  obtain ⟨htL,htU⟩ := hγ t ht
  have hlo : P*UQ*UM*UT ≤ (n : ℝ) := by
    rw [← he]
    push_cast
    gcongr
  have hhi : (n : ℝ) ≤ 16*(P*UQ*UM*UT) := by
    rw [← he]
    push_cast
    calc
      _ ≤ (2*P)*(2*UQ)*(2*UM)*(2*UT) := by gcongr
      _ = _ := by ring
  refine ⟨?_,?_,?_⟩
  · apply (div_le_iff₀ (by positivity : 0 < 32*P)).mpr
    nlinarith only [hYn.trans hhi]
  · apply (div_le_iff₀ (by positivity : 0 < 32*P*UQ)).mpr
    nlinarith only [hYn.trans hhi]
  · apply (le_div_iff₀ hP).mpr
    nlinarith only [hlo.trans hnY]

theorem eventually_active_four_convolution_integral_scales {gamma d eta cLog : ℝ}
    (hgamma : 0 < gamma) (hgammaP : (1/5 : ℝ) < gamma)
    (hd : 0 < d) (heta : eta < (2/5 : ℝ)*d) :
    ∀ᶠ L : ℝ in atTop, ∀ Y P UQ UM UT h R : ℝ,
      0 < Y → 1 ≤ P → 0 < UQ → 0 < UM → 0 < UT → 0 < h →
      d*L ≤ Real.log Y → Real.log Y ≤ cLog*L →
      P ≤ Real.exp (L^(1/5 : ℝ)) → UQ ≤ Real.exp (eta*L) →
      Real.exp (L^gamma) ≤ Y*h → R ≤ 2*L/h →
      ∀ δ α β γ : ℕ → ℂ,
      (∀ n, δ n ≠ 0 → P ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*P) →
      (∀ n, α n ≠ 0 → UQ ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*UQ) →
      (∀ n, β n ≠ 0 → UM ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*UM) →
      (∀ n, γ n ≠ 0 → UT ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*UT) →
      ∀ n : ℕ, endpointFourConvolution δ α β γ n ≠ 0 → Y ≤ (n : ℝ) → (n : ℝ) ≤ 2*Y →
      R ≤ UQ*UM*UT/2 ∧ Y^(3/5 : ℝ) ≤ UM*UT/2 ∧
        Real.log (8*(UQ*UM*UT)) ≤ (cLog+1)*L := by
  filter_upwards [eventually_literal_four_factor_scales (beta := (1/5 : ℝ))
    (Cmean := (32 : ℝ)) (Cres := (32 : ℝ)) hgamma hgammaP (by norm_num) hd heta
      (by norm_num) (by norm_num),
    eventually_ge_atTop (Real.log 16)] with L hscale hL
  intro Y P UQ UM UT h R hY hP hQ hM hT hh hYlo hYhi hPhi hQhi htime hR
    δ α β γ hδ hα hβ hγ n hn hYn hnY
  have hPpos := zero_lt_one.trans_le hP
  obtain ⟨hmean,hres,hprod⟩ := active_four_convolution_product_scales δ α β γ
    hPpos hQ hM hT hδ hα hβ hγ hn hYn hnY
  obtain ⟨hmean',hres'⟩ := hscale Y P UQ UM UT h R hY hPpos hQ hh hYlo hPhi hQhi
    htime hR hmean hres
  refine ⟨hmean',hres',?_⟩
  have hprod' : UQ*UM*UT ≤ 2*Y := hprod.trans ((div_le_self (by positivity) hP))
  have hlog := Real.log_le_log (by positivity : 0 < 8*(UQ*UM*UT))
    (show 8*(UQ*UM*UT) ≤ 16*Y by nlinarith only [hprod'])
  rw [Real.log_mul (by norm_num : (16 : ℝ) ≠ 0) hY.ne'] at hlog
  nlinarith only [hlog,hYhi,hL]

end Bounty
end

section

/- Glue the original lists from one shared embedding and its unshared completion. -/

open Finset
open scoped Classical
namespace Bounty

abbrev PhysicalCutSharedEmbedding {G : Type*} (P : G → Finset ℕ) {J : ℕ}
    (C : G → Finset (Fin J)) := ∀ g, ↥(univ \ C g) ↪ ↥(P g)

abbrev PhysicalCutCompletion {G : Type*} (P : G → Finset ℕ) {J : ℕ}
    (C : G → Finset (Fin J)) (ell : ℕ) (s : PhysicalCutSharedEmbedding P C) :=
  {u : GroupMarkedLists P (fun g => ell + (C g).card) //
    ∀ g, Disjoint (Set.range (s g)) (Set.range (u g))}

noncomputable def physicalCutShared {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (L : PhysicalMarkLists P J ell) : PhysicalCutSharedEmbedding P C :=
  fun g => (physicalCutListEquiv P C ell L g).val.1

noncomputable def physicalCutCompletionOfList {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (L : PhysicalMarkLists P J ell) :
    PhysicalCutCompletion P C ell (physicalCutShared C L) :=
  ⟨fun g => (physicalCutListEquiv P C ell L g).val.2,
    fun g => (physicalCutListEquiv P C ell L g).property⟩

noncomputable def physicalCutGlue {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (s : PhysicalCutSharedEmbedding P C)
    (u : PhysicalCutCompletion P C ell s) : PhysicalMarkLists P J ell :=
  (physicalCutListEquiv P C ell).symm (fun g => ⟨(s g,u.val g),u.property g⟩)

theorem physical_cut_glue_split {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (s : PhysicalCutSharedEmbedding P C)
    (u : PhysicalCutCompletion P C ell s) :
    physicalCutListEquiv P C ell (physicalCutGlue C s u) =
      fun g => ⟨(s g,u.val g),u.property g⟩ :=
  (physicalCutListEquiv P C ell).apply_symm_apply _

theorem physical_cut_glue_shared {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (s : PhysicalCutSharedEmbedding P C)
    (u : PhysicalCutCompletion P C ell s) :
    physicalCutShared C (physicalCutGlue C s u) = s := by
  unfold physicalCutShared
  rw [physical_cut_glue_split]

theorem physical_cut_glue_unshared {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (s : PhysicalCutSharedEmbedding P C)
    (u : PhysicalCutCompletion P C ell s) :
    (fun g => physicalGroupUnsharedEmbedding C (physicalCutGlue C s u) g) = u.val := by
  simp only [← physical_cut_list_unshared, physical_cut_glue_split]

theorem physical_cut_glue_of_list {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (L : PhysicalMarkLists P J ell) :
    physicalCutGlue C (physicalCutShared C L) (physicalCutCompletionOfList C L) = L := by
  apply (physicalCutListEquiv P C ell).injective
  rw [physical_cut_glue_split]
  rfl

theorem physical_cut_shared_compatible_iff {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (L R : PhysicalMarkLists P J ell) :
    physicalSharedCompatible C L R ↔ physicalCutShared C L = physicalCutShared C R := by
  constructor
  · intro h
    funext g
    apply Function.Embedding.ext
    intro j
    exact h g j.val (mem_sdiff.mp j.property).2
  · intro h g j hj
    exact congrArg (fun s : PhysicalCutSharedEmbedding P C => s g ⟨j, mem_sdiff.mpr ⟨mem_univ _, hj⟩⟩) h

end Bounty
end

section

/- The target needs only q=1/2 and arbitrarily large multiplicity. -/

open Finset Filter
namespace Bounty

theorem exists_centered_candidate_parameters_large {δ : ℝ} (hδ : 0 < δ) (rMin : ℕ) :
    ∃ c : ℝ, ∃ r : ℕ, 0 < c ∧ 0 < r ∧ rMin ≤ r ∧
      (11 / 5 : ℝ) * (r : ℝ) * c = 1 ∧ (6 / 5 : ℝ) * c ≤ δ := by
  obtain ⟨r, hrlarge⟩ := exists_nat_gt (max ((rMin : ℝ) + 1) (1 / δ))
  have hrbound : (rMin : ℝ) + 1 < (r : ℝ) := lt_of_le_of_lt (le_max_left _ _) hrlarge
  have hrone : (1 : ℝ) < (r : ℝ) := by linarith [Nat.cast_nonneg (α := ℝ) rMin]
  have hrmin : rMin ≤ r := by exact_mod_cast (show (rMin : ℝ) ≤ (r : ℝ) by linarith)
  have hrpos : (0 : ℝ) < (r : ℝ) := by linarith
  have hr : 0 < r := by exact_mod_cast hrpos
  have hdiv : 1 / δ < (r : ℝ) := lt_of_le_of_lt (le_max_right _ _) hrlarge
  have hmul : 1 < (r : ℝ) * δ := (div_lt_iff₀ hδ).mp hdiv
  let c : ℝ := 5 / (11 * (r : ℝ))
  have hc : 0 < c := by dsimp [c]; positivity
  refine ⟨c, r, hc, hr, hrmin, ?_, ?_⟩
  · dsimp [c]
    field_simp
  · have heq : (6 / 5 : ℝ) * c = 6 / (11 * (r : ℝ)) := by dsimp [c]; ring
    rw [heq]
    apply (div_le_iff₀ (by positivity : (0 : ℝ) < 11 * (r : ℝ))).mpr
    nlinarith

theorem candidate_shifted_prime_mass_supply_of_half_positive_fraction
    (hfraction : ∀ (c : ℝ) (r : ℕ), 0 < c → 6 ≤ r →
      (11 / 5 : ℝ) * (r : ℝ) * c = 1 →
      ∃ J : ℕ, ∀ jStar : ℕ, J < jStar → ∃ σ : ℝ, 0 < σ ∧
        ∀ᶠ L : ℝ in atTop, σ * candidateCoefficientWindowMass c L (1/2) r jStar / L ≤
          ∑ u ∈ (arithmeticProductWindow 1 (Real.exp L)).filter (fun u => (2 * u + 1).Prime),
            candidateCoefficient c L (1/2) r jStar u) :
    CandidateShiftedPrimeMassSupply := by
  intro δ hδ hδsmall
  obtain ⟨c, r, hc, hr, hrlarge, hcenter, hsmall⟩ := exists_centered_candidate_parameters_large hδ 6
  obtain ⟨C, hC, Jbase, hbase⟩ := exists_candidate_mass_fraction_polynomial_lower
    hc hr (by norm_num : (0 : ℝ) ≤ 1/2) (by norm_num : (1/2 : ℝ) < 1) hcenter
  obtain ⟨Jfrac, hfrac⟩ := hfraction c r hc hrlarge hcenter
  let jStar := max Jbase Jfrac + 1
  have hjbase : Jbase < jStar := by dsimp [jStar]; omega
  have hjfrac : Jfrac < jStar := by dsimp [jStar]; omega
  obtain ⟨σ, hσ, hmass⟩ := hfrac jStar hjfrac
  have hpoly := hbase jStar hjbase σ hσ _ hmass
  refine ⟨c, 1/2, C, r, jStar, hc, hr, by norm_num, by norm_num, hsmall, ?_⟩
  filter_upwards [hpoly] with L hL
  refine ⟨(arithmeticProductWindow 1 (Real.exp L)).filter (fun u => (2 * u + 1).Prime),
    filter_subset _ _, ?_, hL⟩
  intro u hu
  exact (mem_filter.mp hu).2


end Bounty
end

section

/- After the small selected data are fixed, the original fixed-edge big
coefficient is independent of every other big edge and mark in the path. -/

open scoped Classical
namespace Bounty

theorem physical_selected_split_fixed_coefficient
    {I G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell n : ℕ}
    (small : G → Prop) (patterns : Finset I) (C : I → G → Finset (Fin J))
    (pattern : Fin n → patterns)
    (ds : PhysicalGroupSelectedData (fun g : {g // small g} => P g.val) ell
      (fun j g => C (pattern j).val g.val))
    (db : PhysicalGroupSelectedData (fun g : {g // ¬small g} => P g.val) ell
      (fun j g => C (pattern j).val g.val))
    (ζ : I → ℝ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (j : Fin n)
    (Lb Rb : PhysicalMarkLists (fun g : {g // ¬small g} => P g.val) J ell)
    (ab : PhysicalAuxLabels (fun g : {g // ¬small g} => P g.val)
      (fun g => C (pattern j).val g.val)) :
    let d := (physicalGroupSelectedSplit small (fun j => C (pattern j).val)).symm (ds, db)
    physicalFixedEdgeBigCoefficient small patterns C ζ K
      (d.2.2.1 j, d.2.2.2 j, ⟨pattern j, d.1 j⟩)
      (d.2.1 j.castSucc) (d.2.1 j.succ) (pattern j).val Lb Rb ab =
    physicalCoupledBigCoefficient small (C (pattern j).val) (ζ (pattern j).val) (K (pattern j).val)
      (physicalPermuteLabels (ds.2.2.1 j) (ds.2.1 j.castSucc))
      (physicalPermuteLabels (ds.2.2.2 j) (ds.2.1 j.succ)) (ds.1 j) Lb Rb ab := by
  dsimp only
  let d := (physicalGroupSelectedSplit small (fun j => C (pattern j).val)).symm (ds, db)
  have hs := congrArg Prod.fst
    ((physicalGroupSelectedSplit small (fun j => C (pattern j).val)).apply_symm_apply (ds, db))
  have hsl (i) : (fun g : {g // small g} => d.2.1 i g.val) = ds.2.1 i :=
    congrArg (fun x => x.2.1 i) hs
  have hss : (fun g : {g // small g} => d.2.2.1 j g.val) = ds.2.2.1 j :=
    congrArg (fun x => x.2.2.1 j) hs
  have hst : (fun g : {g // small g} => d.2.2.2 j g.val) = ds.2.2.2 j :=
    congrArg (fun x => x.2.2.2 j) hs
  have hsa : (fun g : {g // small g} => d.1 j g.val) = ds.1 j :=
    congrArg (fun x => x.1 j) hs
  change physicalFixedEdgeBigCoefficient small patterns C ζ K
    (d.2.2.1 j, d.2.2.2 j, ⟨pattern j, d.1 j⟩)
    (d.2.1 j.castSucc) (d.2.1 j.succ) (pattern j).val Lb Rb ab = _
  simp only [physicalFixedEdgeBigCoefficient]
  rw [physical_permute_group_restrict, physical_permute_group_restrict,
    hss, hst, hsl, hsl, hsa]
  exact dif_pos trivial

end Bounty
end

section

/- The shared-overlap error vanishes to arbitrary power for every subfamily
of the actual candidate prime pools, with the group family varying with L. -/

open Finset Filter
open scoped Classical
namespace Bounty

theorem eventually_candidate_shared_error_decay {c B : ℝ} (hc : 0 < c)
    (hB : 0 ≤ B) (J : ℕ) (E D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (S : Finset ℕ), S ⊆ candidatePIndices c L →
      ∀ (C : S → Finset (Fin J)) (w z : ℕ) (H : ℝ),
      0 < w → 0 < z → Real.log w ≤ B*L → Real.log z ≤ B*L →
      0 ≤ H → H ≤ L^E →
      (∑ g : S, (J - (C g).card : ℕ) *
          (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) /
          ((∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ)) * Real.exp (L^(1/10 : ℝ)))) *
        (H + H / (1/2 : ℝ) ^ (2 * ∑ g : S, (J - (C g).card))) ≤ L^(-D) := by
  obtain ⟨v, A, hv, hA, hinputs⟩ := exists_candidate_shared_error_inputs hc J
  have hB' : 0 ≤ 2 * B / Real.log 2 + J := by positivity
  filter_upwards [hinputs, eventually_physical_shared_error_decay (c := (1/10 : ℝ))
    (by norm_num) hv hA hB' E D, eventually_ge_atTop (1 : ℝ)] with L hinputs hdec hL
  intro S hS C w z H hw hz hwlog hzlog hH hHL
  obtain ⟨hcount, hdata⟩ := hinputs S hS
  have hT : 0 ≤ Real.log w / Real.log 2 + Real.log z / Real.log 2 + J := by
    have hw1 : (1 : ℝ) ≤ w := by exact_mod_cast hw
    have hz1 : (1 : ℝ) ≤ z := by exact_mod_cast hz
    exact add_nonneg (add_nonneg
      (div_nonneg (Real.log_nonneg hw1) (Real.log_nonneg (by norm_num)))
      (div_nonneg (Real.log_nonneg hz1) (Real.log_nonneg (by norm_num)))) (Nat.cast_nonneg J)
  exact hdec S J C (fun g => ∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ))
    (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) H (Real.exp (L^(1/10 : ℝ)))
    (fun g => (hdata g).1) (by simpa only [Fintype.card_coe] using hcount)
    hT (endpoint_shared_log_bound hL hwlog hzlog) hH hHL le_rfl

end Bounty
end

section

/- A common mass floor and polynomial marked-weight envelope for every
subfamily of the actual candidate pools. -/

open Finset Filter
open scoped Classical
namespace Bounty

theorem exists_candidate_marked_error_inputs {c : ℝ} (hc : 0 < c) (T : ℕ) :
    ∃ v E : ℝ, 0 < v ∧ 0 ≤ E ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (S : Finset ℕ), S ⊆ candidatePIndices c L →
        (markedDivisorBound (1/2) v T) ^ Fintype.card S ≤ L^E ∧
        ∀ (g : S), v ≤ ∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ) := by
  obtain ⟨v, A, hv, hA, hinputs⟩ := exists_candidate_shared_error_inputs hc 1
  let B := markedDivisorBound (1/2) v T
  have hB : 1 ≤ B := one_le_markedDivisorBound (1/2) v T
  refine ⟨v, A * Real.log B, hv, mul_nonneg hA (Real.log_nonneg hB), ?_⟩
  filter_upwards [hinputs, eventually_gt_atTop (0 : ℝ)] with L hinputs hL
  intro S hS
  obtain ⟨hcount, hdata⟩ := hinputs S hS
  refine ⟨?_, fun g => (hdata g).1⟩
  have hcard : ((univ : Finset S).card : ℝ) ≤ A * Real.log L := by
    simpa only [one_mul, card_univ, Fintype.card_coe] using hcount
  have hb := group_product_bound_of_log_card (univ : Finset S) (fun _ => B)
    hB hL (fun _ _ => zero_le_one.trans hB) (fun _ _ => le_rfl) hcard
  simpa only [prod_const, card_univ] using hb

end Bounty
end

section

/- The shared-draw error decays uniformly for polynomial endpoint logarithms
on arbitrary subfamilies of the actual candidate pools. -/

open Finset Filter
open scoped Classical
namespace Bounty

theorem eventually_candidate_shared_polynomial_error {c F : ℝ} (hc : 0 < c)
    (hF : 0 ≤ F) (J : ℕ) (E D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (S : Finset ℕ), S ⊆ candidatePIndices c L →
      ∀ (C : S → Finset (Fin J)) (w z : ℕ) (H : ℝ),
      0 < w → 0 < z → Real.log w ≤ L^F → Real.log z ≤ L^F →
      0 ≤ H → H ≤ L^E →
      (∑ g : S, (J - (C g).card : ℕ) *
          (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) /
          ((∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ)) * Real.exp (L^(1/10 : ℝ)))) *
        (H + H / (1/2 : ℝ) ^ (2 * ∑ g : S, (J - (C g).card))) ≤ L^(-D) := by
  obtain ⟨v, A, hv, hA, hinputs⟩ := exists_candidate_shared_error_inputs hc J
  have hB : 0 ≤ 2 / Real.log 2 + (J : ℝ) := by positivity
  filter_upwards [hinputs, eventually_physical_shared_error_polynomial_decay (c := (1/10 : ℝ))
    (by norm_num) hv hA hB E F D, eventually_ge_atTop (1 : ℝ)] with L hinputs hdec hL
  intro S hS C w z H hw hz hwlog hzlog hH hHL
  obtain ⟨hcount, hdata⟩ := hinputs S hS
  have h2 : 0 ≤ Real.log (2 : ℝ) := Real.log_nonneg (by norm_num)
  have hT : 0 ≤ Real.log w / Real.log 2 + Real.log z / Real.log 2 + J := by
    have hw1 : (1 : ℝ) ≤ w := by exact_mod_cast hw
    have hz1 : (1 : ℝ) ≤ z := by exact_mod_cast hz
    exact add_nonneg (add_nonneg (div_nonneg (Real.log_nonneg hw1) h2)
      (div_nonneg (Real.log_nonneg hz1) h2)) (Nat.cast_nonneg J)
  have hTL : Real.log w / Real.log 2 + Real.log z / Real.log 2 + J ≤
      (2 / Real.log 2 + (J : ℝ)) * L^F := by
    have hw' := div_le_div_of_nonneg_right hwlog h2
    have hz' := div_le_div_of_nonneg_right hzlog h2
    have hJ := mul_le_mul_of_nonneg_left (Real.one_le_rpow hL hF) (Nat.cast_nonneg J : (0 : ℝ) ≤ J)
    calc
      _ ≤ L^F / Real.log 2 + L^F / Real.log 2 + (J : ℝ)*L^F := by linarith
      _ = _ := by ring
  exact hdec S J C (fun g => ∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ))
    (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) H (Real.exp (L^(1/10 : ℝ)))
    (fun g => (hdata g).1) (by simpa only [Fintype.card_coe] using hcount)
    hT hTL hH hHL le_rfl

end Bounty
end

section

/- Bounded output values of the four-factor divisor convolution only see bounded positive inputs. -/

open Finset

namespace Bounty

theorem endpoint_four_convolution_truncate (δ α β γ : ℕ → ℂ) {N n : ℕ}
    (hn : n ≤ N) :
    endpointFourConvolution (fun d => if d ∈ Icc 1 N then δ d else 0)
      (fun a => if a ∈ Icc 1 N then α a else 0)
      (fun b => if b ∈ Icc 1 N then β b else 0)
      (fun c => if c ∈ Icc 1 N then γ c else 0) n =
      endpointFourConvolution δ α β γ n := by
  classical
  unfold endpointFourConvolution
  apply sum_congr rfl
  intro d hd
  have hdN : d ∈ Icc 1 N := mem_Icc.mpr
    ⟨Nat.pos_of_mem_divisors hd, (Nat.le_of_dvd (Nat.pos_of_ne_zero (Nat.ne_zero_of_mem_divisors hd)) (Nat.dvd_of_mem_divisors hd)).trans hn⟩
  simp only [if_pos hdN]
  congr 1
  unfold endpointTripleConvolution
  apply sum_congr rfl
  intro a ha
  have hnd : n / d ≤ N := (Nat.div_le_self n d).trans hn
  have haN : a ∈ Icc 1 N := mem_Icc.mpr
    ⟨Nat.pos_of_mem_divisors ha, (Nat.le_of_dvd (Nat.pos_of_ne_zero (Nat.ne_zero_of_mem_divisors ha)) (Nat.dvd_of_mem_divisors ha)).trans hnd⟩
  apply sum_congr rfl
  intro b hb
  have hna : n / d / a ≤ N := (Nat.div_le_self (n / d) a).trans hnd
  have hbN : b ∈ Icc 1 N := mem_Icc.mpr
    ⟨Nat.pos_of_mem_divisors hb, (Nat.le_of_dvd (Nat.pos_of_ne_zero (Nat.ne_zero_of_mem_divisors hb)) (Nat.dvd_of_mem_divisors hb)).trans hna⟩
  have hcpos : 0 < n / d / a / b := Nat.div_pos (Nat.le_of_dvd (Nat.pos_of_ne_zero (Nat.ne_zero_of_mem_divisors hb)) (Nat.dvd_of_mem_divisors hb))
    (Nat.pos_of_mem_divisors hb)
  have hcN : n / d / a / b ∈ Icc 1 N := mem_Icc.mpr
    ⟨hcpos, (Nat.div_le_self (n / d / a) b).trans hna⟩
  simp only [if_pos haN, if_pos hbN, if_pos hcN]

end Bounty
end

section

open MeasureTheory

namespace Bounty

theorem local_mellin_tail_power_saving (A B D : ℝ) :
    ∃ j : ℕ, 2 ≤ j ∧ ∀ (L Y h : ℝ) (S : Finset ℕ) (a : ℕ → ℂ) (N : ℕ),
      16 ≤ L → 0 < Y → 0 < h → h⁻¹ ≤ Y →
      (∀ n ∈ S, 1 ≤ n ∧ n ≤ N) →
      (N:ℝ)*(1+Real.log N) ≤ Y*L^A →
      (∑ n ∈ S, ‖a n‖^2) ≤ Y*L^B →
      (∫ t in {t : ℝ | L/h < |t|},
        (1+|h*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2) ≤
          Y^2*L^(-D) := by
  obtain ⟨M, hM⟩ := exists_nat_ge (max 1 A+B+D+1)
  refine ⟨M+2, by omega, ?_⟩
  intro L Y h S a N hL hY hh hhi hS hN hE
  have hL1 : 1 ≤ L := by linarith
  have hLp : 0 < L := by linarith
  have hR : L/h ≤ Y*L^(max 1 A) := by
    calc
      L/h = L*h⁻¹ := div_eq_mul_inv _ _
      _ ≤ L*Y := mul_le_mul_of_nonneg_left hhi hLp.le
      _ = Y*L^(1:ℝ) := by rw [Real.rpow_one]; ring
      _ ≤ _ := mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_le hL1 (le_max_left _ _)) hY.le
  have hN' : (N:ℝ)*(1+Real.log N) ≤ Y*L^(max 1 A) :=
    hN.trans (mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_le hL1 (le_max_right _ _)) hY.le)
  have hconst : 8*(L/h)+8*(N:ℝ)*(1+Real.log N) ≤ 16*Y*L^(max 1 A) := by nlinarith
  have hprod : (8*(L/h)+8*(N:ℝ)*(1+Real.log N))*(∑ n ∈ S, ‖a n‖^2) ≤
      (16*Y*L^(max 1 A))*(Y*L^B) := by
    exact mul_le_mul hconst hE (Finset.sum_nonneg (fun _ _ => sq_nonneg _)) (by positivity)
  calc
    _ ≤ (8*(L/h)+8*(N:ℝ)*(1+Real.log N))*(∑ n ∈ S, ‖a n‖^2)*L^(-(M:ℝ)) :=
      local_mellin_rapid_tail S a N hS hL1 hh M
    _ ≤ (16*Y*L^(max 1 A))*(Y*L^B)*L^(-(M:ℝ)) :=
      mul_le_mul_of_nonneg_right hprod (Real.rpow_nonneg hLp.le _)
    _ = 16*Y^2*L^(max 1 A+B-(M:ℝ)) := by
      rw [sub_eq_add_neg, Real.rpow_add hLp, Real.rpow_add hLp]
      ring
    _ ≤ L*Y^2*L^(max 1 A+B-(M:ℝ)) := by gcongr
    _ = Y^2*L^(max 1 A+B-(M:ℝ)+1) := by
      rw [Real.rpow_add hLp, Real.rpow_one]
      ring
    _ ≤ Y^2*L^(-D) := by
      apply mul_le_mul_of_nonneg_left _ (sq_nonneg Y)
      exact Real.rpow_le_rpow_of_exponent_le hL1 (by linarith)

end Bounty
end

section

/- Positive integer Fourier sums agree with the local additive polynomial,
including a fixed rational-center modulation of their coefficients. -/

open Finset
namespace Bounty

theorem fourier_real_add (n : ℤ) (c β : ℝ) :
    fourier n ((c+β : ℝ) : AddCircle (1 : ℝ)) =
      fourier n (c : AddCircle (1 : ℝ))*fourier n (β : AddCircle (1 : ℝ)) := by
  simp only [fourier_coe_apply, ← Complex.exp_add]
  congr 1
  push_cast
  ring

theorem finite_fourier_eq_local_additive (S : Finset ℤ) (f : ℤ → ℂ)
    (hS : ∀ n ∈ S, 0 ≤ n) (c β : ℝ) :
    finiteFourierSum S f (c+β) =
      localAdditivePolynomial (S.image Int.natAbs)
        (fun n => f n * fourier (n : ℤ) (c : AddCircle (1 : ℝ))) β := by
  unfold finiteFourierSum localAdditivePolynomial
  rw [sum_image]
  · apply sum_congr rfl
    intro n hn
    dsimp only
    rw [Int.natAbs_of_nonneg (hS n hn), fourier_real_add]
    have he : fourier n (β : AddCircle (1 : ℝ)) =
        Complex.exp (((2*Real.pi*β*n.natAbs : ℝ) : ℂ)*Complex.I) := by
      rw [fourier_coe_apply]
      congr 1
      have hnR : (n.natAbs : ℝ) = (n : ℝ) := by
        simpa only [Int.cast_natCast] using
          congrArg (fun z : ℤ => (z : ℝ)) (Int.natAbs_of_nonneg (hS n hn))
      rw [hnR]
      push_cast
      ring
    rw [he]
    ring
  · intro a ha b hb hab
    have he := congrArg (fun m : ℕ => (m : ℤ)) hab
    simpa only [Int.natAbs_of_nonneg (hS a ha), Int.natAbs_of_nonneg (hS b hb)] using he

end Bounty
end

