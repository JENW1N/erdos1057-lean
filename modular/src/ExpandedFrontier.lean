section

/- Each performed global birth position has exactly the actual sample coordinate at its owning event. -/

namespace Bounty

theorem full_mixed_chronological_coordinate_owner_fiber
    {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K)))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps s)
    (u : Fin steps.length) (i : Fin (Fintype.card (FullMixedBirthAddress S B steps)))
    (hi : fullMixedPathBirthPerformed n S B A Δ D steps s p (fullMixedBirthOrder S B steps i))
    (hu : fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i) = u) :
    let e := finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps s p u
    ∃ c : FullMixedEventBirthCoordinate n S B A Δ D (steps.get u) e.1 e.2,
      (fullMixedChronologicalCoordinateEquiv n S B A Δ D steps s p ⟨u, c⟩).val = i := by
  let E := fullMixedChronologicalCoordinateEquiv n S B A Δ D steps s p
  let c := E.symm ⟨i, hi⟩
  have hc : (E c).val = i := congrArg Subtype.val (E.apply_symm_apply ⟨i, hi⟩)
  have ho := full_mixed_chronological_coordinate_owner n S B A Δ D steps s p c
  change fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps (E c).val) = c.1 at ho
  rw [hc, hu] at ho
  rcases c with ⟨v, c⟩
  change u = v at ho
  subst v
  exact ⟨c, hc⟩

end Bounty
end

section

/- Joint-cap-preserving marked rows for the actual coupled ghost skeletons. -/

open Finset Classical

namespace Bounty

theorem coupled_ghost_marked_length_row_le
    {G : Type*} [Fintype G] [DecidableEq G] {P Z : G → Type*}
    (A D : ∀ g, Z g → ℝ) (hA : ∀ g z, 0 ≤ A g z)
    (ℓ ε : G → ℝ) (v : ℝ) (hℓ : ∀ g, 0 ≤ ℓ g) (hε : ∀ g, 0 ≤ ε g) (hv : 0 ≤ v)
    (hdamp : ∀ g z, A g z * v + |D g z| ≤ v)
    (t : G → ℕ) (B : ℕ) (d : G → ℕ) (s : ProductBoundedOrderedState P Z t B) :
    (∑ sk : CoupledGhostSkeleton t B s, if ∀ g, d g ≤ (sk g).1.val then
      coupledGhostSkeletonAbsMass A D t B s sk *
        v ^ (∑ g, boundedGhostSkeletonOutputCount (t g) B (s g) (sk g).1 (sk g).2) *
        ∏ g, ε g ^ d g * ℓ g ^ ((sk g).1.val - d g) else 0) ≤
      ∏ g, ((ε g * v) ^ d g * Real.exp (ℓ g * v) * v ^ (s g).2.1.val) := by
  let f := fun g (a : Fin (B + 1) × Finset (Fin (s g).2.1.val)) =>
    if d g ≤ a.1.val then boundedGhostSkeletonAbsMass (A g) (D g) (t g) B (s g) a.1 a.2 *
      v ^ boundedGhostSkeletonOutputCount (t g) B (s g) a.1 a.2 *
      ε g ^ d g * ℓ g ^ (a.1.val - d g) else 0
  have hf : ∀ g a, 0 ≤ f g a := by
    intro g a
    dsimp only [f]
    split_ifs
    · exact mul_nonneg (mul_nonneg
        (mul_nonneg (bounded_ghost_skeleton_abs_mass_nonneg _ _ _ _ _ _ _) (pow_nonneg hv _))
        (pow_nonneg (hε g) _)) (pow_nonneg (hℓ g) _)
    · exact le_rfl
  have hrow : ∀ g, ∑ a, f g a ≤ (ε g * v) ^ d g * Real.exp (ℓ g * v) * v ^ (s g).2.1.val := by
    intro g
    simpa only [f, Fintype.sum_prod_type] using
      bounded_ghost_marked_length_row_le (A g) (D g) (hA g) (ℓ g) (ε g) v (hℓ g) (hε g) hv
        (hdamp g) (t g) B (d g) (s g)
  calc
    _ ≤ ∑ sk : CoupledGhostSkeleton t B s, ∏ g, f g (sk g) := by
      apply sum_le_sum
      intro sk _
      by_cases hm : ∀ g, d g ≤ (sk g).1.val
      · simp only [if_pos hm]
        unfold coupledGhostSkeletonAbsMass
        split_ifs
        · have he : ∀ g, f g (sk g) =
              boundedGhostSkeletonAbsMass (A g) (D g) (t g) B (s g) (sk g).1 (sk g).2 *
              v ^ boundedGhostSkeletonOutputCount (t g) B (s g) (sk g).1 (sk g).2 *
              ε g ^ d g * ℓ g ^ ((sk g).1.val - d g) := by
            intro g
            exact if_pos (hm g)
          simp only [he, prod_mul_distrib]
          rw [prod_pow_eq_pow_sum]
          exact (by ring : _ = _).le
        · simp only [zero_mul]
          exact prod_nonneg fun g _ => hf g (sk g)
      · simp only [if_neg hm]
        exact prod_nonneg fun g _ => hf g (sk g)
    _ = ∏ g, ∑ a, f g a := (Fintype.prod_sum f).symm
    _ ≤ _ := prod_le_prod₀ (fun g _ => sum_nonneg fun a _ => hf g a) (fun g _ => hrow g)

end Bounty
end

section

/- The full original auxiliary edge skeleton pays one atom per marked fresh slot. -/

open Finset Classical

namespace Bounty

theorem full_active_edge_marked_length_row_le
    {G : Type*} [Fintype G] [DecidableEq G] {P : G → Type*}
    (n : ∀ g, P g → ℕ) {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : SharedActiveLabels P S → Type*) [∀ c, Fintype (A c)]
    (Δ D : ∀ c, A c → G → ℤ) (ω : ∀ c, A c → ℝ)
    (ρ v vmin : ℝ) (V ℓ ε : G → ℝ)
    (hω : ∀ c a, 0 ≤ ω c a) (hωmass : ∀ c, ∑ a, ω c a ≤ 1)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : ∀ g, vmin ≤ V g) (hℓ : ∀ g, 0 ≤ ℓ g) (hℓ2 : ∀ g, ℓ g ≤ 2) (hε : ∀ g, 0 ≤ ε g)
    (T : ℕ) (ht : ∀ g, (S g)ᶜ.card ≤ T) (d : G → ℕ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    (∑ sk : FullActiveEdgeSkeleton n S B A Δ D s,
      if ∀ g, d g ≤ (S g)ᶜ.card - (sk.2 g).2.1.card then
        fullActiveEdgeSkeletonAbsMass n S B A Δ D ω ρ V s sk *
          v ^ (∑ g, unrestrictedSkeletonOutputCount (n g)
            (Δ (productActiveMemorySplit S B s).1 sk.1 g)
            (D (productActiveMemorySplit S B s).1 sk.1 g)
            (S g)ᶜ.card B ((productActiveMemorySplit S B s).2 g) (sk.2 g)) *
          ∏ g, ε g ^ d g * ℓ g ^ ((S g)ᶜ.card - (sk.2 g).2.1.card - d g)
      else 0) ≤
      (∏ g, ε g ^ d g) * productLengthLyapunov v s *
        unrestrictedEdgeRowBound ρ v vmin T ^ Fintype.card G := by
  let c := (productActiveMemorySplit S B s).1
  let r := (productActiveMemorySplit S B s).2
  let f := fun (a : A c) g (sk : UnrestrictedLocalEdgeSkeleton (n g) (Δ c a g) (D c a g) (S g)ᶜ.card B (r g)) =>
    if d g ≤ (S g)ᶜ.card - sk.2.1.card then
      |unrestrictedBoundedSkeletonMass (n g) (Δ c a g) (D c a g) ρ (V g) (S g)ᶜ.card B (r g)
        sk.1 sk.2.1 sk.2.2| * v ^ unrestrictedSkeletonOutputCount (n g) (Δ c a g) (D c a g)
          (S g)ᶜ.card B (r g) sk * ε g ^ d g * ℓ g ^ ((S g)ᶜ.card - sk.2.1.card - d g) else 0
  have hf : ∀ a g sk, 0 ≤ f a g sk := by
    intro a g sk
    dsimp only [f]
    split_ifs
    · exact mul_nonneg (mul_nonneg (mul_nonneg (abs_nonneg _)
        (pow_nonneg (zero_lt_one.trans hv).le _)) (pow_nonneg (hε g) _)) (pow_nonneg (hℓ g) _)
    · exact le_rfl
  have hrow : ∀ a g, ∑ sk, f a g sk ≤
      ε g ^ d g * v ^ (r g).2.1.val * unrestrictedEdgeRowBound ρ v vmin T := by
    intro a g
    exact unrestricted_bounded_marked_length_row_le (n g) (Δ c a g) (D c a g)
      ρ (V g) v vmin (ℓ g) (ε g) hρ0 hρ1 hv hvmin (hV g) (hℓ g) (hℓ2 g) (hε g)
      (S g)ᶜ.card B T (d g) (ht g) (r g)
  have hprod : ∀ a, (∑ sk : ∀ g, UnrestrictedLocalEdgeSkeleton (n g) (Δ c a g) (D c a g) (S g)ᶜ.card B (r g), ∏ g, f a g (sk g)) ≤
      (∏ g, ε g ^ d g) * productLengthLyapunov v s *
        unrestrictedEdgeRowBound ρ v vmin T ^ Fintype.card G := by
    intro a
    rw [← Fintype.prod_sum (f a)]
    have hh := prod_le_prod₀ (s := univ) (fun g _ => sum_nonneg fun sk _ => hf a g sk) (fun g _ => hrow a g)
    have hr : (∏ g, v ^ (r g).2.1.val) = productLengthLyapunov v s :=
      productLengthLyapunov_split S B v s
    simpa only [prod_mul_distrib, prod_const, card_univ, hr] using hh
  have hnonneg : 0 ≤ (∏ g, ε g ^ d g) * productLengthLyapunov v s *
      unrestrictedEdgeRowBound ρ v vmin T ^ Fintype.card G :=
    mul_nonneg (mul_nonneg (prod_nonneg fun g _ => pow_nonneg (hε g) _)
      (productLengthLyapunov_nonneg (zero_lt_one.trans hv).le s))
      (pow_nonneg (unrestricted_edge_row_bound_nonneg hρ1 (zero_lt_one.trans hv).le T) _)
  rw [Fintype.sum_sigma]
  calc
    _ ≤ ∑ a : A c, ω c a * ∑ sk : ∀ g, UnrestrictedLocalEdgeSkeleton (n g) (Δ c a g) (D c a g) (S g)ᶜ.card B (r g), ∏ g, f a g (sk g) := by
      apply sum_le_sum
      intro a _
      rw [mul_sum]
      apply sum_le_sum
      intro sk _
      by_cases hm : ∀ g, d g ≤ (S g)ᶜ.card - (sk g).2.1.card
      · simp only [if_pos hm]
        unfold fullActiveEdgeSkeletonAbsMass
        dsimp only
        rw [abs_of_nonneg (hω c a)]
        split_ifs
        · have he : ∀ g, f a g (sk g) =
              |unrestrictedBoundedSkeletonMass (n g) (Δ c a g) (D c a g) ρ (V g) (S g)ᶜ.card B (r g)
                (sk g).1 (sk g).2.1 (sk g).2.2| *
              v ^ unrestrictedSkeletonOutputCount (n g) (Δ c a g) (D c a g) (S g)ᶜ.card B (r g) (sk g) *
              ε g ^ d g * ℓ g ^ ((S g)ᶜ.card - (sk g).2.1.card - d g) := fun g => if_pos (hm g)
          simp only [he, prod_mul_distrib]
          rw [prod_pow_eq_pow_sum]
          exact (by ring : _ = _).le
        · simp only [mul_zero, zero_mul]
          exact mul_nonneg (hω c a) (prod_nonneg fun g _ => hf a g (sk g))
      · simp only [if_neg hm]
        exact mul_nonneg (hω c a) (prod_nonneg fun g _ => hf a g (sk g))
    _ ≤ (∑ a : A c, ω c a) * ((∏ g, ε g ^ d g) * productLengthLyapunov v s *
        unrestrictedEdgeRowBound ρ v vmin T ^ Fintype.card G) := by
      rw [sum_mul]
      exact sum_le_sum fun a _ => mul_le_mul_of_nonneg_left (hprod a) (hω c a)
    _ ≤ _ := by simpa only [one_mul] using mul_le_mul_of_nonneg_right (hωmass c) hnonneg

end Bounty
end

section

/- Restricting the original forest preserves the exact selected-child exponent. -/

open Finset Classical

namespace Bounty

theorem grouped_restricted_forest_cost_eq
    {G : Type*} [Fintype G] [DecidableEq G] (I : G → Type*) [∀ g, Fintype (I g)]
    {m N : ℕ} {α : Type*} (ord : Fin m ≃ Sigma I) (f : Sigma I → Fin N)
    (code : BirthForestCode N) (values : Fin N → α) (root atom : G → ℝ) (d : G → ℕ)
    (hd : ∀ g, (univ.filter (fun i : I g => code (f ⟨g, i⟩) ≠ none)).card = d g) :
    (∏ j, match restrictedBirthCode (f ∘ ord) code j with
      | some _ => atom (ord j).1
      | none => match restrictedBirthAnchors (f ∘ ord) code values j with
        | none => root (ord j).1 | some _ => atom (ord j).1) =
      ∏ g, atom g ^ d g * root g ^ (Fintype.card (I g) - d g) := by
  apply grouped_forest_cost_eq I ord (restrictedBirthCode (f ∘ ord) code)
    (restrictedBirthAnchors (f ∘ ord) code values) root atom d
  intro g
  have he : (univ.filter (fun i : I g =>
      restrictedBirthCode (f ∘ ord) code (ord.symm ⟨g, i⟩) ≠ none ∨
      restrictedBirthAnchors (f ∘ ord) code values (ord.symm ⟨g, i⟩) ≠ none)) =
      univ.filter (fun i : I g => code (f ⟨g, i⟩) ≠ none) := by
    ext i
    simp only [mem_filter, mem_univ, true_and, restricted_birth_selected_iff,
      Function.comp_apply]
    exact Iff.of_eq (congrArg (fun k => code (f k) ≠ none) (ord.apply_symm_apply ⟨g, i⟩))
  rw [he]
  exact hd g

end Bounty
end

section

/- Stage constraints retain the global forest and only select children owned by this stage. -/

namespace Bounty

theorem owner_restricted_birth_forest_iff {N m L : ℕ} {α : Type*}
    (embed : Fin m → Fin N) (owner : Fin N → Fin L) (u : Fin L)
    (howner : ∀ j, owner (embed j) = u) (performed : Fin N → Prop)
    (hcover : ∀ i, performed i → owner i = u → i ∈ Set.range embed)
    (code : BirthForestCode N) (values : Fin N → α)
    (hchildren : ∀ i, owner i = u → code i ≠ none → performed i) :
    (∀ i, owner i = u → ∀ p, code i = some p →
      values i = values (birthForestParentEmbedding i p)) ↔
    birthForestEqualValues (restrictedBirthCode embed code) (values ∘ embed) ∧
      birthLabelsAnchored (restrictedBirthAnchors embed code values) (values ∘ embed) := by
  rw [← restricted_birth_forest_iff]
  constructor
  · intro h j p hp
    exact h (embed j) (howner j) p hp
  · intro h i hi p hp
    have hic : code i ≠ none := by rw [hp]; exact Option.some_ne_none _
    obtain ⟨j, rfl⟩ := hcover i (hchildren i hi hic) hi
    exact h j p hp

theorem owner_restricted_birth_forest_past_iff {N m L : ℕ} {α : Type*}
    (embed : Fin m → Fin N) (hstrict : StrictMono embed)
    (owner : Fin N → Fin L) (hmono : Monotone owner) (u : Fin L)
    (howner : ∀ j, owner (embed j) = u) (performed : Fin N → Prop)
    (hcover : ∀ i, performed i → owner i = u → i ∈ Set.range embed)
    (code : BirthForestCode N) (values history : Fin N → α)
    (hchildren : ∀ i, owner i = u → code i ≠ none → performed i)
    (hparents : ∀ j p, code (embed j) = some p →
      performed (birthForestParentEmbedding (embed j) p))
    (hpast : ∀ i, owner i < u → values i = history i) :
    (∀ i, owner i = u → ∀ p, code i = some p →
      values i = values (birthForestParentEmbedding i p)) ↔
    birthForestEqualValues (restrictedBirthCode embed code) (values ∘ embed) ∧
      birthLabelsAnchored (restrictedBirthAnchors embed code history) (values ∘ embed) := by
  rw [owner_restricted_birth_forest_iff embed owner u howner performed hcover code values hchildren]
  rw [restricted_birth_anchors_past_local embed hstrict owner hmono u howner performed hcover
    code hparents values history hpast]

end Bounty
end

section

/- A sharp sieve upper bound on the same shrinking-cell scale as the Buchstab density. -/

open Finset Filter
open scoped Topology

namespace Bounty

theorem logarithmic_cell_normalized_sieve_remainder {a b L S Y : ℝ}
    (hL : 0 < L) (hY : Real.exp (a*L) ≤ Y) (h : ℕ) :
    (Real.exp (b*L))^(4*(h : ℝ)+2)/logarithmicCellCountScale L S Y ≤
      L^(S+1)*Real.exp (-(a-b*(4*(h : ℝ)+2))*L) := by
  have hY0 : 0 < Y := (Real.exp_pos _).trans_le hY
  have hscale := logarithmic_cell_count_scale_pos (S := S) hL hY0
  have hlow : Y*L^(-S)/L ≤ logarithmicCellCountScale L S Y :=
    div_le_div_of_nonneg_right (logarithmic_cell_length_lower hY0.le S) hL.le
  apply (div_le_iff₀ hscale).mpr
  calc
    _ = Real.exp (a*L)*Real.exp (-(a-b*(4*(h : ℝ)+2))*L) := by
      rw [← Real.exp_mul, ← Real.exp_add]
      congr 1
      ring
    _ ≤ Y*Real.exp (-(a-b*(4*(h : ℝ)+2))*L) :=
      mul_le_mul_of_nonneg_right hY (Real.exp_pos _).le
    _ = (L^(S+1)*Real.exp (-(a-b*(4*(h : ℝ)+2))*L))*(Y*L^(-S)/L) := by
      have hp : L^(S+1)*L^(-S) = L := by
        rw [← Real.rpow_add hL, show S+1+-S = 1 by ring, Real.rpow_one]
      have hn : L ≠ 0 := hL.ne'
      field_simp
      nlinarith [hp]
    _ ≤ _ := mul_le_mul_of_nonneg_left hlow (by positivity)

theorem exists_short_cell_rough_density_sieve_upper :
    ∃ K : ℝ, 0 < K ∧ ∀ (a b S : ℝ), 0 < a → 0 < b →
      ∀ h : ℕ, 1 ≤ h → Even h → b*(4*(h : ℝ)+2) < a →
      ∀ ε : ℝ, 0 < ε → ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, Real.exp (a*L) ≤ Y →
        normalizedRoughCellCount L S Y (Real.exp (b*L)) ≤
          (Mertens.primeProductLimitConstant/b)*(1+K*Real.exp (-(h : ℝ)))+ε := by
  obtain ⟨K, hK, hsieve⟩ := exists_real_rough_integer_interval_count
  refine ⟨K, hK, ?_⟩
  intro a b S ha hb h hh heven hlevel ε hε
  have hd : 0 < a-b*(4*(h : ℝ)+2) := by linarith
  have ht0 := tendsto_rpow_mul_exp_neg_mul_atTop_nhds_zero (S+1)
    (a-b*(4*(h : ℝ)+2)) hd
  have ht := ((exponential_prime_avoidance_product_tendsto hb).mul_const
    (1+K*Real.exp (-(h : ℝ)))).add (ht0.const_mul K)
  simp only [mul_zero, add_zero] at ht
  have hev := ht.eventually_lt_const (show
    (Mertens.primeProductLimitConstant/b)*(1+K*Real.exp (-(h : ℝ))) <
      (Mertens.primeProductLimitConstant/b)*(1+K*Real.exp (-(h : ℝ)))+ε by linarith)
  filter_upwards [hev, eventually_gt_atTop (0 : ℝ)] with L hmajor hL
  intro Y hY
  have hY0 : 0 < Y := (Real.exp_pos _).trans_le hY
  have hscale := logarithmic_cell_count_scale_pos (S := S) hL hY0
  let len := Real.exp (L^(-S))*Y-Y
  let V := ∏ p ∈ primeBand 0 (Real.exp (b*L)), (1-1/(p : ℝ))
  have hlen : 0 < len := by
    have hl := logarithmic_cell_length_lower (L := L) hY0.le S
    exact (mul_pos hY0 (Real.rpow_pos_of_pos hL _)).trans_le hl
  have hbase := hsieve hY0.le (show Y ≤ Real.exp (L^(-S))*Y by linarith)
    (Real.one_lt_exp_iff.mpr (mul_pos hb hL)) hh heven
  have hcount : ((roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (b*L))).card : ℝ) ≤
      len*V*(1+K*Real.exp (-(h : ℝ)))+K*(Real.exp (b*L))^(4*(h : ℝ)+2) := by
    change |((roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (b*L))).card : ℝ)-len*V| ≤
      K*(len*V*Real.exp (-(h : ℝ))+(Real.exp (b*L))^(4*(h : ℝ)+2)) at hbase
    have hupper := (le_abs_self _).trans hbase
    nlinarith
  have herror := logarithmic_cell_normalized_sieve_remainder (S := S) (b := b) hL hY h
  calc
    normalizedRoughCellCount L S Y (Real.exp (b*L)) ≤
        (len*V*(1+K*Real.exp (-(h : ℝ)))+K*(Real.exp (b*L))^(4*(h : ℝ)+2))/
          logarithmicCellCountScale L S Y := div_le_div_of_nonneg_right hcount hscale.le
    _ = (L*V)*(1+K*Real.exp (-(h : ℝ)))+
        K*((Real.exp (b*L))^(4*(h : ℝ)+2)/logarithmicCellCountScale L S Y) := by
      unfold logarithmicCellCountScale
      change (len*V*(1+K*Real.exp (-(h : ℝ)))+K*(Real.exp (b*L))^(4*(h : ℝ)+2))/(len/L) =
        (L*V)*(1+K*Real.exp (-(h : ℝ)))+K*((Real.exp (b*L))^(4*(h : ℝ)+2)/(len/L))
      field_simp [hL.ne', hlen.ne'] <;> ring
    _ ≤ (L*V)*(1+K*Real.exp (-(h : ℝ)))+
        K*(L^(S+1)*Real.exp (-(a-b*(4*(h : ℝ)+2))*L)) := by gcongr
    _ ≤ _ := hmajor.le

end Bounty
end

section

/- Concrete omitted-small-label averaging for storage with external residues.
The reverse eligibility estimate uses the step -k, while the literal forward
operator still has displacement -kD and both total-memory cutoffs. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def smallSourceStorageExternalAverage
    {S G R : Type*} [Fintype S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Type*} [∀ g, Fintype (P g)] {J ell : ℕ}
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (labels : PhysicalMarkLists Ps J ell) (D_B : ℕ) (k : ℤ)
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ) (t : G → ℕ) (B : ℕ)
    (τ : (S → Equiv.Perm (PhysicalSlots J ell)) → R ≃ R)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → R → ℂ) :
    ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → R → ℂ := by
  let _ : DecidableEq S := Classical.decEq _
  let _ : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
  exact unrestrictedStorageExternalAverage n
    (fun σ _ => -(k * (smallSourcePermutationDilation labels D_B σ : ℤ)))
    (fun σ _ => (smallSourcePermutationDilation labels D_B σ : ℤ)) μ ρ V t B
    (fun _ => 1 / (Fintype.card (S → Equiv.Perm (PhysicalSlots J ell)) : ℝ)) τ f

theorem small_source_storage_external_energy_le {S G R : Type*} [Fintype S] [Fintype G] [Fintype R] [DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Type*} [∀ g, Fintype (P g)] {J ell : ℕ}
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (labels : PhysicalMarkLists Ps J ell)
    (hP : ∀ g p, p ∈ Ps g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (Ps g) (Ps h)))
    (D_B : ℕ) (k : ℤ) (hp : ∀ g p, (n g p).Prime)
    (hk : ∀ g p, ¬ (n g p : ℤ) ∣ k)
    (hlt : ∀ g p, ∀ A : PrimeOmissionChoices (physicalGroupMarks labels) ell,
      primeOmissionProduct (physicalGroupMarks labels) ell A < n g p)
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ) (t : G → ℕ) (B : ℕ)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, t g ≤ T)
    (τ : (S → Equiv.Perm (PhysicalSlots J ell)) → R ≃ R)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → R → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun state => f state r)) :
    (∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fun state => smallSourceStorageExternalAverage n labels D_B k μ ρ V t B τ f state r)) ≤
      ((B : ℝ) / (((J + ell).choose ell) ^ Fintype.card S : ℕ)) *
        unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
          ∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
            (fun state => f state r) := by
  let _ : DecidableEq S := Classical.decEq _
  let _ : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
  have hπ : ∀ _σ : S → Equiv.Perm (PhysicalSlots J ell),
      0 ≤ 1 / (Fintype.card (S → Equiv.Perm (PhysicalSlots J ell)) : ℝ) := by
    intro σ
    positivity
  have hπmass : (∑ _σ : S → Equiv.Perm (PhysicalSlots J ell),
      1 / (Fintype.card (S → Equiv.Perm (PhysicalSlots J ell)) : ℝ)) ≤ 1 := by
    have hc : (Fintype.card (S → Equiv.Perm (PhysicalSlots J ell)) : ℝ) ≠ 0 := by
      exact_mod_cast Fintype.card_ne_zero
    simp only [sum_const, card_univ, nsmul_eq_mul, one_div, mul_inv_cancel₀ hc, le_refl]
  apply unrestricted_storage_external_average_energy_le n _ _ μ ρ V t B _ τ hπ hπmass
    hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht (by positivity) _ f hf
  intro state hB
  apply uniform_probability_sum_of_card_bound
  have h := small_source_pending_eligible_fraction_le labels hP hdis n state D_B (-k)
    (fun g j => hp g ((state g).2.2 j).1)
    (fun g j hneg => hk g ((state g).2.2 j).1 (dvd_neg.mp hneg))
    (fun g j A => hlt g ((state g).2.2 j).1 A)
  have hh := h.trans (div_le_div_of_nonneg_right (Nat.cast_le.mpr hB) (Nat.cast_nonneg _))
  simpa only [neg_mul, neg_neg] using hh

end Bounty
end

section

/- The full shared-fiber storage transpose includes an arbitrary finite external
coordinate. Its choice-dependent translation is inverted on the reverse side;
the same total-memory cutoffs and auxiliary weights are retained. -/

open Finset Classical

namespace Bounty

section

variable {G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
  {A : SharedActiveLabels P S → Type*} [∀ c, Fintype (A c)]
  (Δ D : ∀ c, A c → G → ℤ) (ω : ∀ c, A c → ℝ)
  (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  {R : Type*} [Fintype R] (τ : ∀ c, A c → R ≃ R)

noncomputable def fullActiveStorageExternal :=
  equivExternalFiberAverage (productActiveMemorySplit S B) ω
    (fun c a => unrestrictedStorageOnlyProduct n (Δ c a) (D c a)
      μ ρ V (fun g => (S g)ᶜ.card) B) τ

noncomputable def fullActiveReversePromotionExternal :=
  equivExternalFiberAverage (productActiveMemorySplit S B) ω
    (fun c a => unrestrictedReversePromotionOnlyProduct n (Δ c a) (D c a)
      μ ρ V (fun g => (S g)ᶜ.card) B) (fun c a => (τ c a).symm)

/-- Exact full-space weighted bilinear identity; no dimension factor or
renormalization of shared or auxiliary coordinates is introduced. -/
theorem full_active_storage_external_pairing
    (hV : ∀ g, V g ≠ 0)
    (f g : ProductBoundedOrderedState P (fun j => UnrestrictedResidueParticle (n j)) M B → R → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun x => f x r))
    (hg : ∀ r, ProductMemorySymmetric (fun x => g x r)) :
    (∑ r, ∑ s, (productMemoryWeight μ (fun j => unrestrictedResidueWeight (μ j)) s : ℂ) *
      f s r * fullActiveStorageExternal n S B Δ D ω μ ρ V τ g s r) =
    ∑ r, ∑ s, (productMemoryWeight μ (fun j => unrestrictedResidueWeight (μ j)) s : ℂ) *
      fullActiveReversePromotionExternal n S B Δ D ω μ ρ V τ f s r * g s r := by
  apply equiv_external_fiber_average_pairing (productActiveMemorySplit S B)
    (productMemoryWeight μ (fun j => unrestrictedResidueWeight (μ j)))
    (sharedActiveWeight S μ) (productMemoryWeight μ (fun j => unrestrictedResidueWeight (μ j)))
    (productActiveMemorySplit_weight_symm S B μ (fun j => unrestrictedResidueWeight (μ j)))
    ω (fun c a => unrestrictedStorageOnlyProduct n (Δ c a) (D c a) μ ρ V
      (fun j => (S j)ᶜ.card) B)
    (fun c a => unrestrictedReversePromotionOnlyProduct n (Δ c a) (D c a) μ ρ V
      (fun j => (S j)ᶜ.card) B) τ f g
  intro c a r q
  exact unrestricted_storage_only_product_pairing n (Δ c a) (D c a) μ ρ V
    (fun j => (S j)ᶜ.card) B hV _ _
    (productActiveMemorySlice_symmetric S B (fun x => f x r) (hf r) c)
    (productActiveMemorySlice_symmetric S B (fun x => g x q) (hg q) c)

/-- A uniform reverse-eligibility estimate on each retained-label fiber gives
an actual full-state storage estimate, without any shared-coordinate loss. -/
theorem full_active_storage_external_energy_le
    (hω : ∀ c a, 0 ≤ ω c a) (hωmass : ∀ c, ∑ a, ω c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, (S g)ᶜ.card ≤ T) {δ : ℝ} (hδ : 0 ≤ δ)
    (hrare : ∀ c, ∀ s : ProductBoundedOrderedState P
        (fun g => UnrestrictedResidueParticle (n g)) (fun g => (S g)ᶜ.card) B,
      productTotalMemory s ≤ B →
      (∑ a, if ∃ g, (unrestrictedResidueEligible (n g) (-Δ c a g) (D c a g) (s g).2.2).Nonempty
        then ω c a else 0) ≤ δ)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → R → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun s => f s r)) :
    (∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fun s => fullActiveStorageExternal n S B Δ D ω μ ρ V τ f s r)) ≤
      δ * unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        ∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
          (fun s => f s r) := by
  simp_rw [finite_energy_equiv_fibers (productActiveMemorySplit S B)
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (sharedActiveWeight S μ) (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productActiveMemorySplit_weight_symm S B μ (fun g => unrestrictedResidueWeight (μ g)))]
  unfold finiteFiberEnergy equivFiberSlice
  dsimp only [fullActiveStorageExternal, equivExternalFiberAverage]
  simp only [Equiv.apply_symm_apply]
  rw [sum_comm, sum_comm (f := fun r c => sharedActiveWeight S μ c *
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fun y => f ((productActiveMemorySplit S B).symm (c,y)) r))]
  simp only [← mul_sum]
  rw [mul_sum]
  apply sum_le_sum
  intro c hc
  calc
    _ ≤ sharedActiveWeight S μ c *
        ((δ * unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G) *
          ∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
            (fun y => f ((productActiveMemorySplit S B).symm (c,y)) r)) := by
      apply mul_le_mul_of_nonneg_left _ (sharedActiveWeight_nonneg S μ hμ c)
      exact unrestricted_storage_external_average_energy_le n (Δ c) (D c) μ ρ V
        (fun g => (S g)ᶜ.card) B (ω c) (τ c) (hω c) (hωmass c)
        hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht hδ (hrare c)
        (fun y r => f ((productActiveMemorySplit S B).symm (c,y)) r)
        (fun r => productActiveMemorySlice_symmetric S B (fun x => f x r) (hf r) c)
    _ = _ := by ring

end

end Bounty
end

section

/- A proved per-auxiliary mixed edge bound. The small coordinates carry
original residue-valid counting mass and the big coordinates carry the
product/factorial memory law. Both small conditioning losses and the actual
full big-event energy bound are discharged here. -/

open Finset
open scoped Classical

namespace Bounty

theorem exists_physical_small_big_full_energy_bound
    {q vs : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hvs : 0 < vs) (ell : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (S G : Type) [Fintype S] [DecidableEq S]
      [Fintype G] [DecidableEq G]
      (Ps : S → Finset ℕ) [∀ p : PhysicalPrime Ps, NeZero p.2.val]
      (P : G → Type) [∀ g, Fintype (P g)] (n : ∀ g, P g → ℕ)
      [∀ g p, NeZero (n g p)] (J : ℕ) (M : G → ℕ)
      (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
      (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
      (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
      (kbig : SharedActiveLabels P shared → ℤ)
      (Vs : S → ℝ), (∀ s, vs ≤ Vs s) →
      ∀ (ζ : ℝ) (aux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))))
        (κ : PhysicalSharedLists Ps J → ℂ) (Hκ : ℝ),
      0 ≤ Hκ → (∀ d, ‖κ d‖ ≤ Hκ) →
      ∀ (v vmin vmax : ℝ), 0 < ρ → ρ < 1 → 1 < v → 0 < vmin →
      (∀ g, vmin ≤ V g) → (∀ g, V g ≤ vmax) →
      (∀ g p, 0 ≤ μ g p) → (∀ g, ∑ p, μ g p ≤ 2) →
      ∀ (T : ℕ), (∀ g, (shared g)ᶜ.card ≤ T) →
      ∀ (Ψ : ∀ d x, PhysicalResidues Ps → PhysicalSmallBigFullEvent n shared B Δ D d x → ℂ)
        (H : ℝ), 0 ≤ H → (∀ d x r e, ‖Ψ d x r e‖ ≤ H) →
      ∀ (F : PhysicalSmallBigState Ps J ell
        (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ),
      (∀ s, ProductMemorySymmetric (fun x => F (s, x))) →
      physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
        (physicalSmallBigAction Vs q ζ aux κ
          (PhysicalSmallBigFullEvent n shared B Δ D)
          (physicalSmallBigFullTarget n shared B Δ D)
          (physicalSmallBigFullCoefficient n shared B Δ D μ ρ V Ψ)
          (fun x => kbig (productActiveMemorySplit shared B x).1) F) ≤
        A ^ (2 * Fintype.card S) * Hκ ^ 2 *
          (H ^ 2 * unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G) *
          physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) F := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_small_big_energy_bound hq0 hq1 hvs ell
  refine ⟨A, hA, ?_⟩
  intro S G _ dS _ dG
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  intro Ps _ P _ n _ J M shared B Δ D μ ρ V kbig Vs hVs ζ aux κ Hκ hHκ hκ
    v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht Ψ H hH hΨ F hF
  exact hbound S
    (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    Ps J Vs hVs ζ (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productMemoryWeight_nonneg μ _ hμ (fun g z => hμ g z.1)) aux κ
    (PhysicalSmallBigFullEvent n shared B Δ D) (physicalSmallBigFullTarget n shared B Δ D)
    (physicalSmallBigFullCoefficient n shared B Δ D μ ρ V Ψ)
    (fun x => kbig (productActiveMemorySplit shared B x).1)
    Hκ (H ^ 2 * unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G) hHκ
    (mul_nonneg (sq_nonneg H) (pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _))
    hκ F (physical_small_big_conditioned_full_prefix_energy_le n shared B Δ D μ ρ V kbig Vs q
      hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht Ψ H hH hΨ F hF)

end Bounty
end

section

/- The nonclean positive event sum splits into events with a promotion and
storage-only events. A bounded complex coefficient is dominated without
changing the event masks, either cutoff, or the external translation. -/

open Finset
open scoped Classical

namespace Bounty

theorem finite_dirty_indicator {G : Type*} (p q : G → Prop) :
    (if ¬ (∀ g, p g ∧ q g) then (1 : ℂ) else 0) =
      (if ∃ g, ¬ q g then 1 else 0) +
        (if (∀ g, q g) ∧ (∃ g, ¬ p g) then 1 else 0) := by
  simp only [← not_forall, forall_and]
  by_cases hp : ∀ g, p g <;> by_cases hq : ∀ g, q g <;> simp [hp, hq]

section

variable {G : Type*} [Fintype G] [dG : DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  (Δ D : G → ℤ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (t : G → ℕ) (B : ℕ)

noncomputable def unrestrictedDirtyOperator
    (phase : UnrestrictedProductPhase n Δ D t B)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ) :=
  unrestrictedCoupledCutoffProductOperator n Δ D μ ρ V t B
    (fun s e => if ¬ (∀ g, (e g).1 = ∅ ∧ (e g).2.1 = ∅) then phase s e else 0) f

omit [∀ g p, NeZero (n g p)] in
theorem unrestricted_dirty_positive_split
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) :
    unrestrictedDirtyOperator n Δ D μ ρ V t B (fun _ _ => 1) f s =
      unrestrictedCoupledCutoffProductOperator n Δ D μ ρ V t B
        (fun _ e => if ∃ g, (e g).2.1.Nonempty then 1 else 0) f s +
      unrestrictedStorageOnlyProduct n Δ D μ ρ V t B f s := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  simp only [unrestrictedDirtyOperator, unrestrictedStorageOnlyProduct,
    unrestricted_coupled_cutoff_eq_joint_event_sum]
  rw [← sum_add_distrib]
  apply sum_congr rfl
  intro e _
  have h := finite_dirty_indicator (fun g => (e g).1 = ∅) (fun g => (e g).2.1 = ∅)
  simp only [Finset.nonempty_iff_ne_empty] 
  rw [← add_mul, ← mul_add]
  apply congrArg (fun z : ℂ => (unrestrictedJointCutoffEventWeight n Δ D μ ρ V t B s e : ℂ) * z *
    f (unrestrictedJointEventTarget n Δ D t B s e))
  convert h using 1 <;> split_ifs <;> rfl

omit [∀ g p, NeZero (n g p)] in
theorem unrestricted_dirty_norm_le_positive_re
    (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ V g) (hμ : ∀ g p, 0 ≤ μ g p)
    (phase : UnrestrictedProductPhase n Δ D t B) (hphase : ∀ s e, ‖phase s e‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) :
    ‖unrestrictedDirtyOperator n Δ D μ ρ V t B phase f s‖ ≤
      (unrestrictedDirtyOperator n Δ D μ ρ V t B (fun _ _ => 1) (complexNormEnvelope f) s).re := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  simp only [unrestrictedDirtyOperator, unrestricted_coupled_cutoff_eq_joint_event_sum,
    complexNormEnvelope]
  have h := finite_masked_event_norm_le_positive_re
    (unrestrictedJointCutoffEventWeight n Δ D μ ρ V t B s)
    (unrestrictedJointCutoffEventWeight_nonneg n Δ D μ V hρ hV hμ t B s)
    (fun e => ¬ (∀ g, (e g).1 = ∅ ∧ (e g).2.1 = ∅)) (phase s)
    (fun e => f (unrestrictedJointEventTarget n Δ D t B s e)) (hphase s)
  convert h using 1 <;> congr 1 <;> apply sum_congr rfl <;> intro e _ <;> split_ifs <;> rfl

end

section

variable {A G R : Type*} [Fintype A] [Fintype G] [Fintype R] [dG : DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  (Δ D : A → G → ℤ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (t : G → ℕ) (B : ℕ) (π : A → ℝ) (τ : A → R ≃ R)

noncomputable def unrestrictedDirtyExternalAverage
    (phase : ∀ a, R → UnrestrictedProductPhase n (Δ a) (D a) t B)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → R → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) (r : R) : ℂ :=
  ∑ a, (π a : ℂ) * unrestrictedDirtyOperator n (Δ a) (D a) μ ρ V t B
    (phase a r) (fun x => f x (τ a r)) s

omit [Fintype R] [∀ g p, NeZero (n g p)] in
theorem unrestricted_dirty_external_positive_split
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → R → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) (r : R) :
    unrestrictedDirtyExternalAverage n Δ D μ ρ V t B π τ (fun _ _ _ _ => 1) f s r =
      unrestrictedPromotionExternalAverage n Δ D μ ρ V t B π τ (fun _ _ _ _ => 1) f s r +
        unrestrictedStorageExternalAverage n Δ D μ ρ V t B π τ f s r := by
  simp only [unrestrictedDirtyExternalAverage, unrestricted_dirty_positive_split, mul_add,
    sum_add_distrib, unrestrictedPromotionExternalAverage, unrestrictedStorageExternalAverage]

omit [Fintype R] [∀ g p, NeZero (n g p)] in
theorem unrestricted_dirty_external_norm_le_positive_re
    (hπ : ∀ a, 0 ≤ π a) (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ V g) (hμ : ∀ g p, 0 ≤ μ g p)
    (phase : ∀ a, R → UnrestrictedProductPhase n (Δ a) (D a) t B)
    (hphase : ∀ a r s e, ‖phase a r s e‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → R → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) (r : R) :
    ‖unrestrictedDirtyExternalAverage n Δ D μ ρ V t B π τ phase f s r‖ ≤
      (unrestrictedDirtyExternalAverage n Δ D μ ρ V t B π τ (fun _ _ _ _ => 1)
        (fun x r => (‖f x r‖ : ℂ)) s r).re := by
  unfold unrestrictedDirtyExternalAverage
  calc
    _ ≤ ∑ a, π a * ‖unrestrictedDirtyOperator n (Δ a) (D a) μ ρ V t B
        (phase a r) (fun x => f x (τ a r)) s‖ := by
      apply (norm_sum_le _ _).trans_eq
      apply sum_congr rfl
      intro a _
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hπ a)]
    _ ≤ ∑ a, π a * (unrestrictedDirtyOperator n (Δ a) (D a) μ ρ V t B
        (fun _ _ => 1) (fun x => (‖f x (τ a r)‖ : ℂ)) s).re := by
      exact sum_le_sum fun a _ => mul_le_mul_of_nonneg_left
        (unrestricted_dirty_norm_le_positive_re n (Δ a) (D a) μ ρ V t B hρ hV hμ
          (phase a r) (hphase a r) (fun x => f x (τ a r)) s) (hπ a)
    _ = _ := by
      rw [Complex.re_sum]
      apply sum_congr rfl
      intro a _
      simp only [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero]

end

end Bounty
end

section

/- Restrict the actual edge labels and retain the full coefficient at its original pattern. -/

open scoped Classical
namespace Bounty
section Edge
variable {G I : Type*} {P : G → Finset ℕ} {J ell : ℕ}
  (small : G → Prop) (patterns : Finset I) (C : I → G → Finset (Fin J))

noncomputable def physicalRestrictedEdge
    (a : PhysicalEdgeLabels P J ell patterns C) :
    PhysicalEdgeLabels (fun g : {g // small g} => P g.val) J ell patterns
      (fun i g => C i g.val) :=
  ⟨(fun g => a.1 g.val), (fun g => a.2.1 g.val), ⟨a.2.2.1, fun g => a.2.2.2 g.val⟩⟩

theorem physical_restricted_edge_pattern (a : PhysicalEdgeLabels P J ell patterns C) :
    (physicalRestrictedEdge small patterns C a).2.2.1 = a.2.2.1 := rfl

variable [Fintype G]

noncomputable def physicalFixedEdgeBigCoefficient (ζ : I → ℝ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (L R : PhysicalMarkLists P J ell)
    (i : I) (Lb Rb : PhysicalMarkLists (fun g : {g // ¬small g} => P g.val) J ell)
    (ab : PhysicalAuxLabels (fun g : {g // ¬small g} => P g.val) (fun g => C i g.val)) : ℂ :=
  if hi : i = a.2.2.1.val then
    physicalCoupledBigCoefficient small (C i) (ζ i) (K i)
      (fun g => physicalPermuteLabels a.1 L g.val)
      (fun g => physicalPermuteLabels a.2.1 R g.val)
      (fun g => (hi.symm ▸ a.2.2.2) g.val) Lb Rb ab
  else 0

theorem physical_fixed_edge_big_coefficient_apply (ζ : I → ℝ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (L R : PhysicalMarkLists P J ell) :
    physicalFixedEdgeBigCoefficient small patterns C ζ K a L R a.2.2.1.val
      (fun g => physicalPermuteLabels a.1 L g.val)
      (fun g => physicalPermuteLabels a.2.1 R g.val) (fun g => a.2.2.2 g.val) =
      K a.2.2.1.val (physicalPermuteLabels a.1 L) (physicalPermuteLabels a.2.1 R) a.2.2.2 *
        physicalPhase (ζ a.2.2.1.val)
          (physicalD (fun g : {g // small g} => C a.2.2.1.val g.val)
            (fun g => physicalPermuteLabels a.1 L g.val) (fun g => a.2.2.2 g.val) *
          physicalD (fun g : {g // ¬small g} => C a.2.2.1.val g.val)
            (fun g => physicalPermuteLabels a.1 L g.val) (fun g => a.2.2.2 g.val)) := by
  simp only [physicalFixedEdgeBigCoefficient]
  exact physical_coupled_big_coefficient_restrict small (C a.2.2.1.val)
    (ζ a.2.2.1.val) (K a.2.2.1.val) a.2.2.2
    (physicalPermuteLabels a.1 L) (physicalPermuteLabels a.2.1 R)

end Edge
end Bounty
end

section

/- Prime-power removal with arbitrary logarithmic savings. -/

open Filter Asymptotics

namespace Bounty

theorem ordinary_sqrt_log_isLittleO (B : ℝ) :
    (fun x : ℝ => 2 * Real.sqrt x * Real.log x) =o[atTop]
      (fun x : ℝ => x * (Real.log x)^(-B)) := by
  have h := (isLittleO_log_rpow_rpow_atTop (B+1)
    (by norm_num : (0 : ℝ) < 1/2)).mul_isBigO
      (isBigO_refl (fun x : ℝ => x^((1 : ℝ)/2) * (Real.log x)^(-B)) atTop)
  have hl : (fun x : ℝ => (Real.log x)^(B+1) *
      (x^((1 : ℝ)/2) * (Real.log x)^(-B))) =ᶠ[atTop]
      (fun x : ℝ => Real.sqrt x * Real.log x) := by
    filter_upwards [eventually_gt_atTop (1 : ℝ)] with x hx
    have hp : (Real.log x)^(B+1) * (Real.log x)^(-B) = Real.log x := by
      rw [← Real.rpow_add (Real.log_pos hx)]
      rw [show B+1 + -B = (1 : ℝ) by ring, Real.rpow_one]
    rw [← Real.sqrt_eq_rpow]
    calc
      _ = Real.sqrt x * ((Real.log x)^(B+1) * (Real.log x)^(-B)) := by ring
      _ = _ := by rw [hp]
  have hr : (fun x : ℝ => x^((1 : ℝ)/2) *
      (x^((1 : ℝ)/2) * (Real.log x)^(-B))) =ᶠ[atTop]
      (fun x : ℝ => x * (Real.log x)^(-B)) := by
    filter_upwards [eventually_gt_atTop (0 : ℝ)] with x hx
    rw [← mul_assoc, ← Real.rpow_add hx]
    norm_num
  simpa only [mul_assoc] using (h.congr' hl hr).const_mul_left 2

theorem ordinary_prime_power_error_isLittleO (B : ℝ) :
    (Chebyshev.psi - Chebyshev.theta) =o[atTop]
      (fun x : ℝ => x * (Real.log x)^(-B)) := by
  have h : (Chebyshev.psi - Chebyshev.theta) =O[atTop]
      (fun x : ℝ => 2 * Real.sqrt x * Real.log x) := by
    apply IsBigO.of_norm_eventuallyLE
    filter_upwards [eventually_ge_atTop (1 : ℝ)] with x hx
    simpa only [Pi.sub_apply, Real.norm_eq_abs] using
      Chebyshev.abs_psi_sub_theta_le_sqrt_mul_log hx
  exact h.trans_isLittleO (ordinary_sqrt_log_isLittleO B)

theorem ordinary_theta_error_isLittleO (B : ℝ) :
    (Chebyshev.theta - id) =o[atTop]
      (fun x : ℝ => x * (Real.log x)^(-B)) := by
  have heq : (Chebyshev.psi - id) - (Chebyshev.psi - Chebyshev.theta) =
      Chebyshev.theta - id := by
    funext x
    simp only [Pi.sub_apply]
    ring
  rw [← heq]
  exact (ordinary_psi_error_isLittleO B).sub (ordinary_prime_power_error_isLittleO B)

theorem eventually_ordinary_theta_log_power_bound (B : ℝ) :
    ∀ᶠ x : ℝ in atTop, |Chebyshev.theta x - x| ≤ x * (Real.log x)^(-B) := by
  filter_upwards [(ordinary_theta_error_isLittleO B).def (by norm_num : (0 : ℝ) < 1),
    eventually_ge_atTop (1 : ℝ)] with x hx hx1
  have hp : 0 ≤ x * (Real.log x)^(-B) := mul_nonneg (by linarith)
    (Real.rpow_nonneg (Real.log_nonneg hx1) _)
  simpa only [Pi.sub_apply, id_eq, Real.norm_eq_abs, one_mul, abs_of_nonneg hp] using hx

theorem eventually_ordinary_theta_uniform_log_power_bound {a : ℝ} (ha : 0 < a) (B : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ x : ℝ, Real.exp (a*L) ≤ x →
      |Chebyshev.theta x - x| ≤ x * (Real.log x)^(-B) := by
  obtain ⟨N, hN⟩ := eventually_atTop.mp (eventually_ordinary_theta_log_power_bound B)
  have hlim : Tendsto (fun L : ℝ => Real.exp (a*L)) atTop atTop :=
    Real.tendsto_exp_atTop.comp (tendsto_id.const_mul_atTop ha)
  filter_upwards [hlim.eventually (eventually_ge_atTop N)] with L hL
  exact fun x hx => hN x (hL.trans hx)

end Bounty
end

section

/- The common Mertens normalization at the preliminary cutoff exp(sqrt L). -/

open Filter Real Finset
open scoped Topology

namespace Bounty

theorem sqrt_prime_avoidance_product_tendsto :
    Tendsto (fun L : ℝ => sqrt L *
      ∏ p ∈ primeBand 0 (exp (sqrt L)), (1-1/(p : ℝ)))
      atTop (𝓝 Mertens.primeProductLimitConstant) := by
  have h := logarithmic_prime_avoidance_product_tendsto.comp
    (tendsto_exp_atTop.comp tendsto_sqrt_atTop)
  simpa only [Function.comp_def, log_exp] using h

theorem eventually_sqrt_normalized_rough_base_error {a ε : ℝ}
    (ha : 0 < a) (hε : 0 < ε) (S : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, exp (a*L) ≤ Y →
      |normalizedRoughCellCount L S Y (exp (sqrt L))/sqrt L-
        Mertens.primeProductLimitConstant| ≤ ε := by
  have hsmall : Tendsto (fun L : ℝ => L^(-(1 : ℝ))) atTop (𝓝 0) :=
    tendsto_rpow_neg_atTop (by norm_num : (0 : ℝ) < 1)
  have hlo := sqrt_prime_avoidance_product_tendsto.mul (hsmall.const_sub 1)
  have hhi := sqrt_prime_avoidance_product_tendsto.mul (hsmall.const_add 1)
  simp only [sub_zero, add_zero, mul_one] at hlo hhi
  filter_upwards [eventually_rough_logarithmic_cell_count ha S 1,
    hlo.eventually_const_lt (show Mertens.primeProductLimitConstant-ε <
      Mertens.primeProductLimitConstant by linarith),
    hhi.eventually_lt_const (show Mertens.primeProductLimitConstant <
      Mertens.primeProductLimitConstant+ε by linarith),
    eventually_gt_atTop (0 : ℝ)] with L hraw hlo hhi hL
  intro Y hY
  have hY0 : 0 < Y := (exp_pos _).trans_le hY
  have hs : 0 < sqrt L := sqrt_pos.2 hL
  have hscale := logarithmic_cell_count_scale_pos (S := S) hL hY0
  let D := logarithmicCellCountScale L S Y*sqrt L
  let t := sqrt L * ∏ p ∈ primeBand 0 (exp (sqrt L)), (1-1/(p : ℝ))
  have hD : 0 < D := mul_pos hscale hs
  have hm : roughLogarithmicCellMainTerm L S Y = D*t := by
    dsimp [D, t, roughLogarithmicCellMainTerm]
    calc
      _ = logarithmicCellCountScale L S Y * (sqrt L*sqrt L) *
          ∏ p ∈ primeBand 0 (exp (sqrt L)), (1-1/(p : ℝ)) := by
        rw [mul_self_sqrt hL.le]
        unfold logarithmicCellCountScale
        field_simp
      _ = _ := by ring
  have hr := hraw Y hY
  rw [hm] at hr
  have hrl := (abs_le.mp hr).1
  have hru := (abs_le.mp hr).2
  change Mertens.primeProductLimitConstant-ε < t*(1-L^(-(1 : ℝ))) at hlo
  change t*(1+L^(-(1 : ℝ))) < Mertens.primeProductLimitConstant+ε at hhi
  unfold normalizedRoughCellCount
  rw [div_div]
  change |((roughBand Y (exp (L^(-S))*Y) (exp (sqrt L))).card : ℝ)/D-
    Mertens.primeProductLimitConstant| ≤ ε
  apply abs_le.mpr
  constructor
  · have hn : D*(t*(1-L^(-(1 : ℝ)))) ≤
        ((roughBand Y (exp (L^(-S))*Y) (exp (sqrt L))).card : ℝ) := by nlinarith
    have hd : t*(1-L^(-(1 : ℝ))) ≤
        ((roughBand Y (exp (L^(-S))*Y) (exp (sqrt L))).card : ℝ)/D := by
      apply (le_div_iff₀ hD).mpr
      nlinarith
    linarith
  · have hn : ((roughBand Y (exp (L^(-S))*Y) (exp (sqrt L))).card : ℝ) ≤
        D*(t*(1+L^(-(1 : ℝ)))) := by nlinarith
    have hd : ((roughBand Y (exp (L^(-S))*Y) (exp (sqrt L))).card : ℝ)/D ≤
        t*(1+L^(-(1 : ℝ))) := by apply (div_le_iff₀ hD).mpr; nlinarith
    linarith

end Bounty
end

section

/- The uniform small-slot average is a contractive projection for the
genuine mixed residue-valid energy. No product small-label law is used. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_small_big_permutation_mul {S X : Type*}
    {P : S → Finset ℕ} {J ell : ℕ} (σ τ : PhysicalPermutations S J ell)
    (x : PhysicalSmallBigState P J ell X) :
    physicalSmallBigPermutation σ (physicalSmallBigPermutation τ x) =
      physicalSmallBigPermutation (τ * σ) x := by
  apply Prod.ext
  · apply Prod.ext
    · rfl
    · funext g
      apply Function.Embedding.ext
      intro j
      rfl
  · rfl

theorem physical_small_big_average_invariant {S X : Type*}
    [Fintype S] [DecidableEq S] {P : S → Finset ℕ} {J ell : ℕ}
    (f : PhysicalSmallBigState P J ell X → ℂ) (τ : PhysicalPermutations S J ell)
    (x : PhysicalSmallBigState P J ell X) :
    physicalSmallBigAverage f (physicalSmallBigPermutation τ x) = physicalSmallBigAverage f x := by
  unfold physicalSmallBigAverage
  simp only [physical_small_big_permutation_mul]
  apply congrArg (fun z : ℂ => (Fintype.card (PhysicalPermutations S J ell) : ℂ)⁻¹ * z)
  exact Equiv.sum_comp (Equiv.mulLeft τ) (fun σ => f (physicalSmallBigPermutation σ x))

theorem physical_small_big_average_idempotent {S X : Type*}
    [Fintype S] [DecidableEq S] {P : S → Finset ℕ} {J ell : ℕ}
    (f : PhysicalSmallBigState P J ell X → ℂ) :
    physicalSmallBigAverage (physicalSmallBigAverage f) = physicalSmallBigAverage f := by
  funext x
  change (Fintype.card (PhysicalPermutations S J ell) : ℂ)⁻¹ *
    (∑ σ : PhysicalPermutations S J ell,
      physicalSmallBigAverage f (physicalSmallBigPermutation σ x)) = _
  simp only [physical_small_big_average_invariant, sum_const, card_univ, nsmul_eq_mul]
  rw [← mul_assoc, inv_mul_cancel₀, one_mul]
  exact_mod_cast (Fintype.card_ne_zero : Fintype.card (PhysicalPermutations S J ell) ≠ 0)

theorem physical_small_big_average_energy_le
    {S X : Type*} [Fintype S] [dS : DecidableEq S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (hV : ∀ s, 0 < V s) (W : X → ℝ) (hW : ∀ x, 0 ≤ W x)
    (f : PhysicalSmallBigState P J ell X → ℂ) :
    physicalSmallBigEnergy V W (physicalSmallBigAverage f) ≤ physicalSmallBigEnergy V W f := by
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  have hc : (Fintype.card (PhysicalPermutations S J ell) : ℝ) ≠ 0 := by
    exact_mod_cast (Fintype.card_ne_zero : Fintype.card (PhysicalPermutations S J ell) ≠ 0)
  have hm : (∑ _σ : PhysicalPermutations S J ell,
      (Fintype.card (PhysicalPermutations S J ell) : ℝ)⁻¹) = 1 := by
    simp only [sum_const, card_univ, nsmul_eq_mul, mul_inv_cancel₀ hc]
  have h := finite_subprobability_average_energy_le
    (fun _σ : PhysicalPermutations S J ell => (Fintype.card (PhysicalPermutations S J ell) : ℝ)⁻¹)
    (physicalSmallBigMeasure V W) (by intro σ; positivity) hm.le
    (physical_small_big_measure_nonneg V hV W hW)
    (fun σ x => f (physicalSmallBigPermutation σ x))
  have he : (fun x => ∑ σ : PhysicalPermutations S J ell,
      (((Fintype.card (PhysicalPermutations S J ell) : ℝ)⁻¹ : ℝ) : ℂ) *
        f (physicalSmallBigPermutation σ x)) = physicalSmallBigAverage f := by
    funext x
    simp only [physicalSmallBigAverage, Complex.ofReal_inv, Complex.ofReal_natCast, mul_sum]
  rw [he] at h
  simp_rw [physical_small_big_energy_eq, physical_small_big_permutation_energy] at h
  rw [← sum_mul, hm, one_mul] at h
  exact h

end Bounty
end

section

/- The literal mixed row vanishes outside its existing source total-memory
cap, independently of all event coefficients and small endpoint data. -/

open Finset Classical

namespace Bounty

theorem physical_small_big_full_zero_above_cap
    {S G : Type*} [Fintype S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
    (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (kbig : SharedActiveLabels P shared → ℤ) (Vs : S → ℝ) (q ζ : ℝ)
    (aux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))))
    (κ : PhysicalSharedLists Ps J → ℂ)
    (Ψ : ∀ d x, PhysicalResidues Ps → PhysicalSmallBigFullEvent n shared B Δ D d x → ℂ)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (hs : ¬ productTotalMemory s.2 ≤ B) :
    physicalSmallBigAction Vs q ζ aux κ (PhysicalSmallBigFullEvent n shared B Δ D)
      (physicalSmallBigFullTarget n shared B Δ D)
      (physicalSmallBigFullCoefficient n shared B Δ D μ ρ V Ψ)
      (fun x => kbig (productActiveMemorySplit shared B x).1) F s = 0 := by
  unfold physicalSmallBigAction
  apply sum_eq_zero
  intro e he
  simp only [physicalSmallBigEventWeight, physicalSmallBigFullCoefficient,
    fullActiveEdgeEventWeight, unrestrictedJointCutoffEventWeight,
    productActiveMemorySplit_total_memory, hs, false_and, if_false,
    mul_zero, Complex.ofReal_zero, zero_mul]

end Bounty
end

section

/- The original small conditioning lifts a proved clean big-fiber estimate
through an exact packed pairing. Endpoint multipliers stay explicit. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_small_big_multiplier_energy_le
    {S X : Type*} [Fintype S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (hV : ∀ s, 0 < V s) (W : X → ℝ) (hW : ∀ x, 0 ≤ W x)
    (g f : PhysicalSmallBigState P J ell X → ℂ) (hg : ∀ s, ‖g s‖ ≤ 1) :
    physicalSmallBigEnergy V W (fun s => g s * f s) ≤ physicalSmallBigEnergy V W f := by
  rw [← physical_small_big_energy_eq, ← physical_small_big_energy_eq]
  apply sum_le_sum
  intro s _
  apply mul_le_mul_of_nonneg_left _ (physical_small_big_measure_nonneg V hV W hW s)
  apply pow_le_pow_left₀ (norm_nonneg _)
  calc
    ‖g s * f s‖ = ‖g s‖ * ‖f s‖ := norm_mul _ _
    _ ≤ 1 * ‖f s‖ := mul_le_mul_of_nonneg_right (hg s) (norm_nonneg _)
    _ = _ := one_mul _

theorem physical_small_big_clean_pairing_energy_le
    {S X : Type*} [Fintype S] [dS : DecidableEq S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (hV : ∀ s, 0 < V s) (q : ℝ) (W : X → ℝ) (hW : ∀ x, 0 ≤ W x)
    (sourceGate targetGate : PhysicalSmallBigState P J ell X → ℂ)
    (hs : ∀ s, ‖sourceGate s‖ ≤ 1) (ht : ∀ s, ‖targetGate s‖ ≤ 1)
    {A M : ℝ} (hA : 0 ≤ A) (_hM : 0 ≤ M)
    (hcondition : ∀ u : PhysicalSmallBigState P J ell X → ℂ,
      physicalSmallBigConditionEnergy W (physicalSmallBigCondition V q u) ≤
        A * physicalSmallBigEnergy V W u)
    (F output : PhysicalSmallBigState P J ell X → ℂ)
    (v : PhysicalSharedLists P J → X → PhysicalResidues P → ℂ)
    (hclean : ∀ d, cleanWeightedNorm W (v d) ≤ M * cleanWeightedNorm W
      (physicalSmallBigCondition V q (fun s => targetGate s * F s) d))
    (hpair : ∀ u : PhysicalSmallBigState P J ell X → ℂ,
      (∑ s, (physicalSmallBigMeasure V W s : ℂ) * (starRingEnd ℂ) (u s) * output s) =
        ∑ d, ∑ r, ∑ x, (W x : ℂ) *
          (starRingEnd ℂ) (physicalSmallBigCondition V q (fun s => sourceGate s * u s) d x r) *
          v d x r) :
    physicalSmallBigEnergy V W output ≤ A ^ 2 * M ^ 2 * physicalSmallBigEnergy V W F := by
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  let Y := PhysicalSharedLists P J × (PhysicalResidues P × X)
  let ν : Y → ℝ := fun y => W y.2.2
  let C : (PhysicalSmallBigState P J ell X → ℂ) → Y → ℂ :=
    fun u y => physicalSmallBigCondition V q (fun s => sourceGate s * u s) y.1 y.2.2 y.2.1
  let w : Y → ℂ := fun y => v y.1 y.2.2 y.2.1
  have hCe (u : PhysicalSmallBigState P J ell X → ℂ) :
      finiteWeightedEnergy ν (C u) =
        physicalSmallBigConditionEnergy W
          (physicalSmallBigCondition V q (fun s => sourceGate s * u s)) := by
    simp only [ν, C, Y, finiteWeightedEnergy, Fintype.sum_prod_type, physicalSmallBigConditionEnergy]
  have hv : finiteWeightedEnergy ν w ≤ M ^ 2 * A *
      finiteWeightedEnergy (physicalSmallBigMeasure V W) F := by
    calc
      _ ≤ M ^ 2 * physicalSmallBigConditionEnergy W
          (physicalSmallBigCondition V q (fun s => targetGate s * F s)) := by
        simp only [ν, w, Y, finiteWeightedEnergy, Fintype.sum_prod_type,
          physicalSmallBigConditionEnergy, mul_sum]
        apply sum_le_sum
        intro d _
        have hd := hclean d
        rw [clean_weighted_norm_eq_external_energy,
          clean_weighted_norm_eq_external_energy] at hd
        have h := pow_le_pow_left₀ (Real.sqrt_nonneg _) hd 2
        rw [mul_pow] at h
        simp only [finiteWeightedEnergy] at h
        rw [Real.sq_sqrt, Real.sq_sqrt] at h
        · simp only [mul_sum] at h
          convert h using 1 <;> congr 2
        all_goals exact sum_nonneg fun r _ => sum_nonneg fun x _ =>
          mul_nonneg (hW x) (sq_nonneg _)
      _ ≤ M ^ 2 * (A * physicalSmallBigEnergy V W (fun s => targetGate s * F s)) :=
        mul_le_mul_of_nonneg_left (hcondition _) (sq_nonneg _)
      _ ≤ M ^ 2 * (A * physicalSmallBigEnergy V W F) :=
        mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_left (physical_small_big_multiplier_energy_le V hV W hW
            targetGate F ht) hA) (sq_nonneg _)
      _ = _ := by rw [physical_small_big_energy_eq]; ring
  have h := finite_conditioned_energy_le (physicalSmallBigMeasure V W) ν
    (physical_small_big_measure_nonneg V hV W hW) (fun y => hW y.2.2)
    C hA (mul_nonneg (sq_nonneg M) hA)
    (fun u => by
      rw [hCe, physical_small_big_energy_eq]
      exact (hcondition _).trans (mul_le_mul_of_nonneg_left
        (physical_small_big_multiplier_energy_le V hV W hW sourceGate u hs) hA))
    F output w hv (fun u => by
      have hp := hpair u
      simp only [ν, C, w, Y, Fintype.sum_prod_type] at hp ⊢
      convert hp using 1 <;> congr 3)
  rw [physical_small_big_energy_eq, physical_small_big_energy_eq] at h
  convert h using 1
  ring

theorem exists_physical_small_big_clean_pairing_energy_bound
    {q v : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (ell : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (S X : Type) [Fintype S] [DecidableEq S] [Fintype X]
      (P : S → Finset ℕ) [∀ p : PhysicalPrime P, NeZero p.2.val]
      (J : ℕ) (V : S → ℝ), (∀ s, v ≤ V s) →
      ∀ (W : X → ℝ), (∀ x, 0 ≤ W x) →
      ∀ (sourceGate targetGate : PhysicalSmallBigState P J ell X → ℂ),
      (∀ s, ‖sourceGate s‖ ≤ 1) → (∀ s, ‖targetGate s‖ ≤ 1) →
      ∀ (M : ℝ), 0 ≤ M →
      ∀ (F output : PhysicalSmallBigState P J ell X → ℂ)
        (w : PhysicalSharedLists P J → X → PhysicalResidues P → ℂ),
      (∀ d, cleanWeightedNorm W (w d) ≤ M * cleanWeightedNorm W
        (physicalSmallBigCondition V q (fun s => targetGate s * F s) d)) →
      (∀ u : PhysicalSmallBigState P J ell X → ℂ,
        (∑ s, (physicalSmallBigMeasure V W s : ℂ) * (starRingEnd ℂ) (u s) * output s) =
          ∑ d, ∑ r, ∑ x, (W x : ℂ) *
            (starRingEnd ℂ) (physicalSmallBigCondition V q (fun s => sourceGate s * u s) d x r) *
            w d x r) →
      physicalSmallBigEnergy V W output ≤
        A ^ (2 * Fintype.card S) * M ^ 2 * physicalSmallBigEnergy V W F := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_small_big_condition_energy_bound hq0 hq1 hv ell
  refine ⟨A, hA, ?_⟩
  intro S X _ dS _
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  intro P _ J V hV W hW sourceGate targetGate hs ht M hM F output w hclean hpair
  have h := physical_small_big_clean_pairing_energy_le V (fun s => hv.trans_le (hV s)) q W hW
    sourceGate targetGate hs ht (pow_nonneg (zero_le_one.trans hA) _) hM
    (hbound S X P J V hV W hW) F output w hclean hpair
  simpa only [← pow_mul, Nat.mul_comm (Fintype.card S) 2] using h

end Bounty
end

section

/- Pay the small-conditioning cost in the clean exponent before choosing
the clean pattern parameters. The big dirty cost is then fixed, and J is
chosen last. These are scalar budgets, not an assertion of a row identity. -/

open Filter
open scoped Topology

namespace Bounty

theorem eventually_candidate_mixed_clean_half_budget
    {s : ℝ} (hs : 0 < s) (A₀ E : ℝ) (hA₀ : 0 ≤ A₀) :
    ∀ᶠ L : ℝ in atTop,
      A₀ ^ (candidateSmallPIndices s L).card *
        L ^ (-(E + candidateMixedRareCostExponent A₀ 1 + 1)) ≤
          (1 / 2 : ℝ) * L ^ (-E) := by
  filter_upwards [eventually_candidate_mixed_conditioning_cost_le hs,
    eventually_ge_atTop (2 : ℝ)] with L hc hL
  have hL0 : 0 < L := by linarith
  have hA := hc A₀ 1 hA₀ zero_le_one
  simp only [one_pow, Real.sqrt_one, mul_one] at hA
  calc
    _ ≤ L ^ candidateMixedRareCostExponent A₀ 1 *
        L ^ (-(E + candidateMixedRareCostExponent A₀ 1 + 1)) :=
      mul_le_mul_of_nonneg_right hA (Real.rpow_nonneg hL0.le _)
    _ = L ^ (-(E + 1)) := by
      rw [← Real.rpow_add hL0]
      congr 1
      ring
    _ ≤ _ := rpow_next_saving_le_half E L hL

theorem exists_candidate_mixed_clean_rare_parameters
    {s : ℝ} (hs : 0 < s) (ell J₀ : ℕ) (hell : 0 < ell)
    (a E A₀ : ℝ) (hA₀ : 0 ≤ A₀) {beta : ℝ} (hbeta : 0 < beta) :
    ∃ (m : ℕ) (D : ℝ), ell ≤ m ∧ 0 ≤ D ∧
      beta * Real.log ((ell : ℝ) ^ ell / (m : ℝ) ^ ell) / 2 ≤
        -(E + candidateMixedRareCostExponent A₀ 1 + 3) ∧
      (m : ℝ) * a * Real.log 3 + E + candidateMixedRareCostExponent A₀ 1 + 3 ≤ D ∧
      ∀ K A : ℝ, 0 ≤ K → ∃ J : ℕ, max m J₀ ≤ J ∧
        ∀ᶠ L : ℝ in atTop,
          let clean := A₀ ^ (candidateSmallPIndices s L).card *
            L ^ (-(E + candidateMixedRareCostExponent A₀ 1 + 1))
          let dirty := 2 * L ^ A *
            (A₀ ^ (candidateSmallPIndices s L).card *
              Real.sqrt (K ^ (candidateBigPIndices s L).card)) *
            Real.sqrt ((⌈L ^ 2⌉₊ : ℝ) /
              (((J + ell).choose ell) ^ (candidateSmallPIndices s L).card : ℕ))
          clean ≤ (1 / 2 : ℝ) * L ^ (-E) ∧
          dirty ≤ (1 / 2 : ℝ) * L ^ (-E) ∧ clean + dirty ≤ L ^ (-E) := by
  obtain ⟨m, D, hm, hD, hgap, hDgap⟩ :=
    exists_repeated_big_clean_parameters ell hell a
      (E + candidateMixedRareCostExponent A₀ 1 + 1) hbeta
  refine ⟨m, D, hm, hD, ?_, ?_, ?_⟩
  · linarith
  · linarith
  · intro K A hK
    obtain ⟨J, hJ, _, hrare⟩ := exists_candidate_mixed_rare_parameter hs ell hell
      (max m J₀) A₀ K A E hA₀ hK
    refine ⟨J, hJ, ?_⟩
    filter_upwards [hrare, eventually_candidate_mixed_clean_half_budget hs A₀ E hA₀]
      with L hr hc
    dsimp only at hr ⊢
    exact ⟨hc, hr.1, by linarith [hr.1]⟩

end Bounty
end

section

/- Concrete endpoint gates on the genuine mixed state. Small forbidden
labels restrict only the target tail; no auxiliary draw is restricted. -/

open Finset
open scoped Classical

namespace Bounty

def CleanMixedBigActiveInjective {S G : Type*} {Ps : S → Finset ℕ}
    {P Z : G → Type*} {J ell B : ℕ} {M : G → ℕ}
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B)) : Prop :=
  ∀ g, Function.Injective (s.2 g).1

noncomputable def cleanMixedSourceGate {S G : Type*} {Ps : S → Finset ℕ}
    {P Z : G → Type*} {J ell B : ℕ} {M : G → ℕ}
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B)) : ℂ :=
  if CleanMixedBigActiveInjective s then 1 else 0

noncomputable def cleanMixedTargetGate {S G : Type*} {Ps : S → Finset ℕ}
    {P Z : G → Type*} {J ell B : ℕ} {M : G → ℕ}
    (Fs : ∀ g, Finset (Ps g))
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B)) : ℂ :=
  if CleanMixedBigActiveInjective s ∧
    (∀ g (j : Fin ell), s.1.2 g (Sum.inr j) ∉ Fs g) then 1 else 0

theorem clean_mixed_big_active_injective_memory
    {S G : Type*} [DecidableEq G] {Ps : S → Finset ℕ}
    {P Z : G → Type*} {J ell B : ℕ} {M : G → ℕ}
    (s : PhysicalBareResidueState Ps J ell) (x : ProductBoundedOrderedState P Z M B)
    (g : G) (τ : Equiv.Perm (Fin (x g).2.1.val)) :
    CleanMixedBigActiveInjective (s, productMemoryPermuteAt x g τ) ↔
      CleanMixedBigActiveInjective (s, x) := by
  have he (j : G) : (productMemoryPermuteAt x g τ j).1 = (x j).1 := by
    by_cases hj : j = g
    · subst j
      simp only [productMemoryPermuteAt, Function.update_self]
    · simp only [productMemoryPermuteAt, Function.update_of_ne hj]
  simp only [CleanMixedBigActiveInjective, he]

theorem clean_mixed_source_gate_norm_le {S G : Type*} {Ps : S → Finset ℕ}
    {P Z : G → Type*} {J ell B : ℕ} {M : G → ℕ}
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B)) :
    ‖cleanMixedSourceGate s‖ ≤ 1 := by
  unfold cleanMixedSourceGate
  split_ifs <;> norm_num

theorem clean_mixed_target_gate_norm_le {S G : Type*} {Ps : S → Finset ℕ}
    {P Z : G → Type*} {J ell B : ℕ} {M : G → ℕ} (Fs : ∀ g, Finset (Ps g))
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B)) :
    ‖cleanMixedTargetGate Fs s‖ ≤ 1 := by
  unfold cleanMixedTargetGate
  split_ifs <;> norm_num

theorem cleanMixedSourceGate_conj {S G : Type*} {Ps : S → Finset ℕ}
    {P Z : G → Type*} {J ell B : ℕ} {M : G → ℕ}
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B)) :
    (starRingEnd ℂ) (cleanMixedSourceGate s) = cleanMixedSourceGate s := by
  unfold cleanMixedSourceGate
  split_ifs <;> simp

theorem cleanMixedTargetGate_conj {S G : Type*} {Ps : S → Finset ℕ}
    {P Z : G → Type*} {J ell B : ℕ} {M : G → ℕ} (Fs : ∀ g, Finset (Ps g))
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B)) :
    (starRingEnd ℂ) (cleanMixedTargetGate Fs s) = cleanMixedTargetGate Fs s := by
  unfold cleanMixedTargetGate
  split_ifs <;> simp

theorem clean_mixed_source_gate_memory
    {S G : Type*} [DecidableEq G] {Ps : S → Finset ℕ}
    {P Z : G → Type*} {J ell B : ℕ} {M : G → ℕ}
    (s : PhysicalBareResidueState Ps J ell) (x : ProductBoundedOrderedState P Z M B)
    (g : G) (τ : Equiv.Perm (Fin (x g).2.1.val)) :
    cleanMixedSourceGate (s, productMemoryPermuteAt x g τ) = cleanMixedSourceGate (s, x) := by
  simp only [cleanMixedSourceGate, clean_mixed_big_active_injective_memory]

theorem clean_mixed_target_gate_memory
    {S G : Type*} [DecidableEq G] {Ps : S → Finset ℕ}
    {P Z : G → Type*} {J ell B : ℕ} {M : G → ℕ} (Fs : ∀ g, Finset (Ps g))
    (s : PhysicalBareResidueState Ps J ell) (x : ProductBoundedOrderedState P Z M B)
    (g : G) (τ : Equiv.Perm (Fin (x g).2.1.val)) :
    cleanMixedTargetGate Fs (s, productMemoryPermuteAt x g τ) = cleanMixedTargetGate Fs (s, x) := by
  simp only [cleanMixedTargetGate, clean_mixed_big_active_injective_memory]

theorem clean_mixed_target_gate_mul_memory_symmetric
    {S G : Type*} [DecidableEq G] {Ps : S → Finset ℕ}
    {P Z : G → Type*} {J ell B : ℕ} {M : G → ℕ} (Fs : ∀ g, Finset (Ps g))
    (f : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ)
    (hf : ∀ s, ProductMemorySymmetric (fun x => f (s, x))) :
    ∀ s, ProductMemorySymmetric (fun x => cleanMixedTargetGate Fs (s, x) * f (s, x)) := by
  intro s x g τ
  dsimp only
  rw [clean_mixed_target_gate_memory]
  exact congrArg (fun z : ℂ => cleanMixedTargetGate Fs (s, x) * z) (hf s x g τ)

theorem clean_mixed_source_gate_mul_memory_symmetric
    {S G : Type*} [DecidableEq G] {Ps : S → Finset ℕ}
    {P Z : G → Type*} {J ell B : ℕ} {M : G → ℕ}
    (f : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ)
    (hf : ∀ s, ProductMemorySymmetric (fun x => f (s, x))) :
    ∀ s, ProductMemorySymmetric (fun x => cleanMixedSourceGate (s, x) * f (s, x)) := by
  intro s x g τ
  dsimp only
  rw [clean_mixed_source_gate_memory]
  exact congrArg (fun z : ℂ => cleanMixedSourceGate (s, x) * z) (hf s x g τ)

end Bounty
end

section

/- Small-slot averaging commutes exactly with a finite scalar-weighted
auxiliary sum. The weights are independent of the mixed state. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_small_big_average_weighted_sum
    {S X Q : Type*} [Fintype S] [dS : DecidableEq S] [Fintype Q]
    {P : S → Finset ℕ} {J ell : ℕ}
    (w : Q → ℂ) (F : Q → PhysicalSmallBigState P J ell X → ℂ) :
    physicalSmallBigAverage (fun s => ∑ a, w a * F a s) =
      fun s => ∑ a, w a * physicalSmallBigAverage (F a) s := by
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  funext s
  simp only [physicalSmallBigAverage, mul_sum]
  rw [sum_comm]
  apply sum_congr rfl
  intro a _
  apply sum_congr rfl
  intro σ _
  ring

end Bounty
end

section

/- Adapters from a positive fraction of candidate mass to shifted-prime mass supply. -/

open Finset Filter

namespace Bounty

theorem exists_candidate_mass_fraction_polynomial_lower {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11 / 5 : ℝ) * (r : ℝ) * c = 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∃ J : ℕ, ∀ jStar : ℕ, J < jStar →
      ∀ σ : ℝ, 0 < σ → ∀ mass : ℝ → ℝ,
        (∀ᶠ L : ℝ in atTop, σ * candidateCoefficientWindowMass c L q r jStar / L ≤ mass L) →
        ∀ᶠ L : ℝ in atTop, Real.exp L * L ^ (-C) ≤ mass L := by
  obtain ⟨C, hC, J, hmass⟩ :=
    exists_candidate_coefficient_mass_polynomial_lower hc hr hq0 hq1 hcenter
  refine ⟨C + 2, by linarith, J, ?_⟩
  intro jStar hj σ hσ mass hfraction
  exact eventually_polynomial_mass_lower_transfer C hσ (hmass jStar hj) hfraction

theorem exists_centered_candidate_parameters {δ : ℝ} (hδ : 0 < δ) :
    ∃ c : ℝ, ∃ r : ℕ, 0 < c ∧ 0 < r ∧
      (11 / 5 : ℝ) * (r : ℝ) * c = 1 ∧ (6 / 5 : ℝ) * c ≤ δ := by
  obtain ⟨r, hrlarge⟩ := exists_nat_gt (max 1 (1 / δ))
  have hrone : (1 : ℝ) < (r : ℝ) := lt_of_le_of_lt (le_max_left _ _) hrlarge
  have hrpos : (0 : ℝ) < (r : ℝ) := by linarith
  have hr : 0 < r := by exact_mod_cast hrpos
  have hdiv : 1 / δ < (r : ℝ) := lt_of_le_of_lt (le_max_right _ _) hrlarge
  have hmul : 1 < (r : ℝ) * δ := (div_lt_iff₀ hδ).mp hdiv
  let c : ℝ := 5 / (11 * (r : ℝ))
  have hc : 0 < c := by dsimp [c]; positivity
  refine ⟨c, r, hc, hr, ?_, ?_⟩
  · dsimp [c]
    field_simp
  · have heq : (6 / 5 : ℝ) * c = 6 / (11 * (r : ℝ)) := by dsimp [c]; ring
    rw [heq]
    apply (div_le_iff₀ (by positivity : (0 : ℝ) < 11 * (r : ℝ))).mpr
    nlinarith

theorem candidate_shifted_prime_mass_supply_of_positive_fraction
    (hfraction : ∀ (c q : ℝ) (r : ℕ), 0 < c → 0 < r → 0 ≤ q → q < 1 →
      (11 / 5 : ℝ) * (r : ℝ) * c = 1 →
      ∃ J : ℕ, ∀ jStar : ℕ, J < jStar → ∃ σ : ℝ, 0 < σ ∧
        ∀ᶠ L : ℝ in atTop, σ * candidateCoefficientWindowMass c L q r jStar / L ≤
          ∑ u ∈ (arithmeticProductWindow 1 (Real.exp L)).filter (fun u => (2 * u + 1).Prime),
            candidateCoefficient c L q r jStar u) :
    CandidateShiftedPrimeMassSupply := by
  intro δ hδ hδsmall
  obtain ⟨c, r, hc, hr, hcenter, hsmall⟩ := exists_centered_candidate_parameters hδ
  obtain ⟨C, hC, Jbase, hbase⟩ := exists_candidate_mass_fraction_polynomial_lower
    hc hr (by norm_num : (0 : ℝ) ≤ 0) (by norm_num : (0 : ℝ) < 1) hcenter
  obtain ⟨Jfrac, hfrac⟩ := hfraction c 0 r hc hr (by norm_num) (by norm_num) hcenter
  let jStar := max Jbase Jfrac + 1
  have hjbase : Jbase < jStar := by dsimp [jStar]; omega
  have hjfrac : Jfrac < jStar := by dsimp [jStar]; omega
  obtain ⟨σ, hσ, hmass⟩ := hfrac jStar hjfrac
  have hpoly := hbase jStar hjbase σ hσ _ hmass
  refine ⟨c, 0, C, r, jStar, hc, hr, by norm_num, by norm_num, hsmall, ?_⟩
  filter_upwards [hpoly] with L hL
  refine ⟨(arithmeticProductWindow 1 (Real.exp L)).filter (fun u => (2 * u + 1).Prime),
    filter_subset _ _, ?_, hL⟩
  intro u hu
  exact (mem_filter.mp hu).2

end Bounty

end

section

/- Absolute logarithmic endpoint bounds, uniform in all physical mark counts. -/

open Finset

namespace Bounty

theorem physical_invariant_endpoint_energy {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (V : G → ℝ) (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (Q : Finset ℕ) (hQ : ∀ g, P g ⊆ Q) (α β γ : ℕ → ℂ)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (J ell : ℕ) {q : ℝ} (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (S : Finset ℤ) (N : ℕ) (hS : ∀ n ∈ S, 0 ≤ n ∧ n ≤ (N : ℤ))
    (f : ℤ → ℂ) (hf : ∀ n ∈ S, ‖f n‖ ≤ ‖invariantTripleEndpoint Q α β γ n.natAbs‖) :
    ‖physicalEndpointVector P V J ell q S f‖ ^ 2 ≤
      (A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15 := by
  classical
  apply physical_endpoint_energy_of_list_bounds P V hV hMass J ell hq0 hq1 S f (by positivity)
  intro L
  calc
    _ ≤ ∑ n ∈ S, if ∀ g s, ((L g s).val : ℤ) ∣ n
        then ‖invariantTripleEndpoint Q α β γ n.natAbs‖ ^ 2 else 0 := by
      apply sum_le_sum
      intro n hn
      split_ifs
      · exact pow_le_pow_left₀ (norm_nonneg _) (hf n hn) 2
      · exact le_rfl
    _ ≤ _ := invariant_triple_endpoint_list_energy P hP hprime Q hQ α β γ
      hA hB hC hα hβ hγ S N hS L

theorem physical_invariant_endpoint_norm {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (V : G → ℝ) (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (Q : Finset ℕ) (hQ : ∀ g, P g ⊆ Q) (α β γ : ℕ → ℂ)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (J ell : ℕ) {q : ℝ} (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (S : Finset ℤ) (N : ℕ) (hS : ∀ n ∈ S, 0 ≤ n ∧ n ≤ (N : ℤ))
    (f : ℤ → ℂ) (hf : ∀ n ∈ S, ‖f n‖ ≤ ‖invariantTripleEndpoint Q α β γ n.natAbs‖) :
    ‖physicalEndpointVector P V J ell q S f‖ ≤
      A * B * C * Real.sqrt N * (1 + Real.log N) ^ 8 := by
  have he := physical_invariant_endpoint_energy P hP hprime V hV hMass Q hQ α β γ
    hA hB hC hα hβ hγ J ell hq0 hq1 S N hS f hf
  have hp : (1 + Real.log N) ^ 15 ≤ (1 + Real.log N) ^ 16 :=
    pow_le_pow_right₀ (by linarith [Real.log_natCast_nonneg N]) (by decide)
  have hs : (A * B * C * Real.sqrt N * (1 + Real.log N) ^ 8) ^ 2 =
      (A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 16 := by
    rw [mul_pow, mul_pow, Real.sq_sqrt (Nat.cast_nonneg N), ← pow_mul]
  apply (sq_le_sq₀ (norm_nonneg _) (by positivity)).mp
  rw [hs]
  exact he.trans (mul_le_mul_of_nonneg_left hp (by positivity))

end Bounty
end

section

/- Divisor bounds for the actual diagonal of the shifted factorization energy. -/

open Finset

namespace Bounty

theorem typeII_diagonal_divisor_fiber (E H : Finset ℕ) (w : ℕ)
    (hE : ∀ e∈E, 0<e) (hH : ∀ h∈H, 0<h) :
    (∑ v ∈ (E ×ˢ H).filter (fun v => 2*v.1*v.2=w),
      (v.2.divisors.card : ℝ)^2) ≤ (w.divisors.card : ℝ)^3 := by
  classical
  let F := (E ×ˢ H).filter (fun v => 2*v.1*v.2=w)
  by_cases hw : w=0
  · subst w
    have hF : F=∅ := by
      apply filter_eq_empty_iff.mpr
      intro v hv heq
      have he := hE v.1 (mem_product.mp hv).1
      have hh := hH v.2 (mem_product.mp hv).2
      nlinarith
    change (∑ v∈F, (v.2.divisors.card : ℝ)^2) ≤ _
    rw [hF, sum_empty]
    positivity
  have hdiv (v : ℕ×ℕ) (hv : v∈F) : v.2∣w := by
    refine ⟨2*v.1, ?_⟩
    have heq := (mem_filter.mp hv).2
    nlinarith
  have hinj : Set.InjOn (fun v : ℕ×ℕ => v.2) (↑F : Set (ℕ×ℕ)) := by
    intro v hv z hz hvz
    apply Prod.ext _ hvz
    have heqv := (mem_filter.mp hv).2
    have heqz := (mem_filter.mp hz).2
    have hh := hH v.2 (mem_product.mp (mem_filter.mp hv).1).2
    change v.2=z.2 at hvz
    nlinarith
  have hsub : F.image Prod.snd ⊆ w.divisors := by
    intro h hh
    obtain ⟨v,hv,rfl⟩ := mem_image.mp hh
    exact Nat.mem_divisors.mpr ⟨hdiv v hv, hw⟩
  change (∑ v∈F, (v.2.divisors.card : ℝ)^2) ≤ _
  calc
    _ = ∑ h∈F.image Prod.snd, (h.divisors.card : ℝ)^2 := (sum_image hinj).symm
    _ ≤ ∑ h∈w.divisors, (h.divisors.card : ℝ)^2 :=
      sum_le_sum_of_subset_of_nonneg hsub (fun _ _ _ => sq_nonneg _)
    _ ≤ ∑ _h∈w.divisors, (w.divisors.card : ℝ)^2 := by
      apply sum_le_sum
      intro h hh
      apply pow_le_pow_left₀ (by positivity)
      exact_mod_cast card_le_card (Nat.divisors_subset_of_dvd hw (Nat.mem_divisors.mp hh).1)
    _ = _ := by simp only [sum_const, nsmul_eq_mul]; ring

theorem typeII_diagonal_shifted_fiber (E H : Finset ℕ) (v : ℕ)
    (hE : ∀ e∈E, 0<e) (hH : ∀ h∈H, 0<h) :
    (∑ z ∈ (E ×ˢ H).filter (fun z => v=2*z.1*z.2+1),
      (z.2.divisors.card : ℝ)^2) ≤ ((v-1).divisors.card : ℝ)^3 := by
  have hs : (E ×ˢ H).filter (fun z => v=2*z.1*z.2+1) ⊆
      (E ×ˢ H).filter (fun z => 2*z.1*z.2=v-1) := by
    intro z hz
    refine mem_filter.mpr ⟨(mem_filter.mp hz).1, ?_⟩
    have h := (mem_filter.mp hz).2
    omega
  exact (sum_le_sum_of_subset_of_nonneg hs (fun _ _ _ => sq_nonneg _)).trans
    (typeII_diagonal_divisor_fiber E H (v-1) hE hH)

theorem positive_pair_sum_le_divisor_sum (M N : Finset ℕ) (X : ℕ) (f : ℕ → ℝ)
    (hM : ∀ m∈M, 0 < m) (hN : ∀ n∈N, 0 < n)
    (hX : ∀ m∈M, ∀ n∈N, m*n≤X) (hf : ∀ v, 0≤f v) :
    (∑ m∈M, ∑ n∈N, f (m*n)) ≤
      ∑ v∈Icc 1 X, (v.divisors.card : ℝ)*f v := by
  classical
  let P := M ×ˢ N
  have hmap : ∀ z∈P, z.1*z.2∈Icc 1 X := by
    intro z hz
    obtain ⟨hm,hn⟩ := mem_product.mp hz
    exact mem_Icc.mpr ⟨Nat.mul_pos (hM z.1 hm) (hN z.2 hn),hX z.1 hm z.2 hn⟩
  have hre : (∑ m∈M, ∑ n∈N, f (m*n)) = ∑ z∈P, f (z.1*z.2) := by
    simp only [P, sum_product]
  rw [hre]
  rw [← sum_fiberwise_of_maps_to hmap]
  apply sum_le_sum
  intro v hv
  let F := P.filter (fun z => z.1*z.2=v)
  have hv0 : v≠0 := by have := (mem_Icc.mp hv).1; omega
  have hinj : Set.InjOn (fun z : ℕ×ℕ => z.1) (↑F : Set (ℕ×ℕ)) := by
    intro z hz w hw heq
    apply Prod.ext heq
    have hzv := (mem_filter.mp hz).2
    have hwv := (mem_filter.mp hw).2
    have hz0 := hM z.1 (mem_product.mp (mem_filter.mp hz).1).1
    apply Nat.eq_of_mul_eq_mul_left hz0
    simpa only [heq] using hzv.trans hwv.symm
  have hsub : F.image Prod.fst ⊆ v.divisors := by
    intro m hm
    obtain ⟨z,hz,rfl⟩ := mem_image.mp hm
    exact Nat.mem_divisors.mpr ⟨⟨z.2,(mem_filter.mp hz).2.symm⟩,hv0⟩
  have hc : F.card≤v.divisors.card := by
    rw [← card_image_of_injOn hinj]
    exact card_le_card hsub
  have heq : (∑ z∈F, f (z.1*z.2)) = (F.card : ℝ)*f v := by
    calc
      _ = ∑ _z∈F, f v := sum_congr rfl (fun z hz => congrArg f (mem_filter.mp hz).2)
      _ = _ := by simp only [sum_const,nsmul_eq_mul]
  change (∑ z∈F, f (z.1*z.2)) ≤ _
  rw [heq]
  exact mul_le_mul_of_nonneg_right (by exact_mod_cast hc) (hf v)

theorem typeII_diagonal_divisor_moment (E H M N : Finset ℕ) (X : ℕ)
    (hE : ∀ e∈E, 0<e) (hH : ∀ h∈H, 0<h)
    (hM : ∀ m∈M, 0 < m) (hN : ∀ n∈N, 0 < n)
    (hX : ∀ m∈M, ∀ n∈N, m*n≤X) :
    (∑ m∈M, ∑ n∈N, ∑ z∈(E ×ˢ H).filter (fun z => m*n=2*z.1*z.2+1),
      (z.2.divisors.card : ℝ)^2) ≤ 2*(X : ℝ)*(1+Real.log X)^15 := by
  calc
    _ ≤ ∑ m∈M, ∑ n∈N, ((m*n-1).divisors.card : ℝ)^3 := by
      apply sum_le_sum
      intro m hm
      apply sum_le_sum
      intro n hn
      exact typeII_diagonal_shifted_fiber E H (m*n) hE hH
    _ ≤ ∑ v∈Icc 1 X, (v.divisors.card : ℝ)*((v-1).divisors.card : ℝ)^3 :=
      positive_pair_sum_le_divisor_sum M N X
        (fun v : ℕ => ((v-1).divisors.card : ℝ)^3) hM hN hX (fun _ => by positivity)
    _ ≤ _ := divisor_adjacent_cross_moment X

end Bounty
end

section

/- On the manuscript's good tuples the exact candidate allocation has a K0-independent loss L^88. -/

open Finset Real

namespace Bounty

theorem candidate_allocation_size_range_of_product_bounds {c L E B H : ℝ}
    (hc : 0 < c) (hL : 0 < L) (hlog : 0 < log L) (hE1 : 1 ≤ E)
    {r jStar P : ℕ} (hr : 6 ≤ r) (hj : jStar ∈ candidateQIndices c L)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot)
    (htotal : exp B ≤ (P*orderedSlotProduct (candidateQSlotChoices c L r jStar) x : ℕ))
    (hretained : (P*(x (candidateRoughSlot c L r jStar (by omega) hj)).val : ℕ) ≤ exp H)
    (hE : log E ≤ B-H)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hweight : 0 < candidateAllocationWeight c L r jStar x (log E) take) :
    E/L^88 ≤ (candidateAllocatedFactor c L r jStar x take : ℝ) ∧
      (candidateAllocatedFactor c L r jStar x take : ℝ) ≤ E := by
  apply candidate_allocation_size_range hc hL hlog (zero_lt_one.trans_le hE1) hE1 hr x _ take hweight
  have hi := candidate_allocation_inventory_of_product_bounds c L r jStar P (by omega) hj x B H
    htotal hretained
  linarith

theorem candidate_allocation_good_tuple_range {c L E b : ℝ}
    (hc : 0 < c) (hL : 0 < L) (hlog : 0 < log L) (hb : 0 ≤ b) (hE1 : 1 ≤ E)
    {r jStar P : ℕ} (hr : 6 ≤ r) (hj : jStar ∈ candidateQIndices c L)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot)
    (htotal : exp L ≤ (P*orderedSlotProduct (candidateQSlotChoices c L r jStar) x : ℕ))
    (hretained : (P*(x (candidateRoughSlot c L r jStar (by omega) hj)).val : ℕ) ≤ exp (b/2*L))
    (hE : log E ≤ (1-b)*L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hweight : 0 < candidateAllocationWeight c L r jStar x (log E) take) :
    E/L^88 ≤ (candidateAllocatedFactor c L r jStar x take : ℝ) ∧
      (candidateAllocatedFactor c L r jStar x take : ℝ) ≤ E := by
  apply candidate_allocation_size_range_of_product_bounds hc hL hlog hE1 hr hj x htotal hretained _ take hweight
  nlinarith [mul_nonneg hb hL.le]

end Bounty
