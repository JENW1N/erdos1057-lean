theorem full_mixed_ghost_owner_sample_data (hocc : fullMixedOwnerOccurrence n S B A Δ D steps x p u =
      ⟨s, fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inl j)) htag s ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩)⟩)
    (i : CoupledGhostSampleIndex M B s sk) :
    fullMixedPathBornData n S B A Δ D steps x p (fullMixedBirthOrder S B steps
      (fullMixedGhostOwnerSampleEmbedding S B j steps u htag s sk i)) = some (.inl ⟨i.1, births i⟩) := by
  have h := full_mixed_tagged_owner_born_data n S B A Δ D steps u (some (.inl j)) htag s
    ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩) x p hocc
    (fullMixedBirthCoordinateEquiv n S B A Δ D (some (.inl j)) s ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩) i).val
  exact h.trans (full_mixed_birth_coordinate_data n S B A Δ D (some (.inl j)) s ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩) i)

theorem full_mixed_ghost_owner_sample_label (hocc : fullMixedOwnerOccurrence n S B A Δ D steps x p u =
