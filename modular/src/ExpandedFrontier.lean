      zero_mul, Complex.ofReal_zero, mul_zero]
  · by_contra hn
    apply h
    simp only [physicalSmallBigEventWeight, physicalResidueVertexWeight, if_neg hn,
      mul_zero, Complex.ofReal_zero, zero_mul]

/-- The mixed row has exactly the original small conditioning normalization;
its remaining sum is only over big events at the retained small prefix. -/
theorem physical_small_big_action_bilinear
    {G X : Type*} [Fintype G] [dG : DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (q ζ : ℝ)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (κ : PhysicalSharedLists P J → ℂ)
    (E : PhysicalSharedLists P J → X → Type*) [∀ d x, Fintype (E d x)]
    (target : ∀ d x, E d x → X)
    (a : PhysicalResidues P → ∀ d x, E d x → ℂ) (k : X → ℤ)
    (f : PhysicalMarkLists P J ell → ℂ) (F : PhysicalSmallBigState P J ell X → ℂ)
    (r : PhysicalResidues P) (x : X) :
    let tr := fun d : PhysicalSharedLists P J =>
      physicalTranslateResidues r (k x * (physicalSharedProduct d : ℕ))
