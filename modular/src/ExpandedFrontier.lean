theorem RectangleIntegral.const_smul (f : ℂ → E) (z w c : ℂ) :
    RectangleIntegral (fun s => c • f s) z w = c • RectangleIntegral f z w := by
  simp [RectangleIntegral, HIntegral, VIntegral, smul_add, smul_sub, smul_smul, mul_comm]

theorem RectangleIntegral.const_mul' (f : ℂ → E) (z w c : ℂ) :
    RectangleIntegral' (fun s => c • f s) z w = c • RectangleIntegral' f z w := by
  simp [RectangleIntegral', RectangleIntegral.const_smul, smul_smul]
  ring_nf

theorem RectangleIntegral.translate (f : ℂ → E) (z w p : ℂ) :
    RectangleIntegral (fun s => f (s - p)) z w = RectangleIntegral f (z - p) (w - p) := by
  simp_rw [RectangleIntegral, HIntegral, VIntegral, sub_re, sub_im,
    ← intervalIntegral.integral_comp_sub_right]
  congr <;> ext <;> congr 1 <;> simp [Complex.ext_iff]

theorem RectangleIntegral.translate' (f : ℂ → E) (z w p : ℂ) :
    RectangleIntegral' (fun s => f (s - p)) z w = RectangleIntegral' f (z - p) (w - p) := by
  simp_rw [RectangleIntegral', RectangleIntegral.translate]

lemma Complex.inv_re_add_im : (x + y * I)⁻¹ = (x - I * y) / (x ^ 2 + y ^ 2) := by
  rw [Complex.inv_def, div_eq_mul_inv]
  congr <;> simp [conj_ofReal, normSq] <;> ring

lemma sq_add_sq_ne_zero (hy : y ≠ 0) : x ^ 2 + y ^ 2 ≠ 0 := by
  linarith [sq_nonneg x, sq_pos_iff.mpr hy]

lemma continuous_self_div_sq_add_sq (hy : y ≠ 0) :
    Continuous fun x => x / (x ^ 2 + y ^ 2) :=
  continuous_id.div (continuous_id.pow 2 |>.add continuous_const) (fun _ => sq_add_sq_ne_zero hy)

lemma integral_self_div_sq_add_sq (hy : y ≠ 0) :
    ∫ x in x₁..x₂, x / (x ^ 2 + y ^ 2) =
    Real.log (x₂ ^ 2 + y ^ 2) / 2 - Real.log (x₁ ^ 2 + y ^ 2) / 2 := by
  let f (x : ℝ) : ℝ := Real.log (x ^ 2 + y ^ 2) / 2
  have e1 {x} := HasDerivAt.add_const (y ^ 2) (by simpa using hasDerivAt_pow 2 x)
  have e2 {x} : HasDerivAt f (x / (x ^ 2 + y ^ 2)) x := by
    convert! (e1.log (sq_add_sq_ne_zero hy)).div_const 2 using 1
    field_simp
  have e3 : deriv f = fun x => x / (x ^ 2 + y ^ 2) := funext (fun _ => e2.deriv)
  have e4 : Continuous (deriv f) := by simpa only [e3] using continuous_self_div_sq_add_sq hy
  simp_rw [← e2.deriv]
  exact integral_deriv_eq_sub (fun _ _ => e2.differentiableAt) (e4.intervalIntegrable _ _)

lemma integral_const_div_sq_add_sq (hy : y ≠ 0) :
    ∫ x in x₁..x₂, y / (x ^ 2 + y ^ 2) = Real.arctan (x₂ / y) - Real.arctan (x₁ / y) := by
  nth_rewrite 1 [← div_mul_cancel₀ x₁ hy, ← div_mul_cancel₀ x₂ hy]
  simp_rw [← mul_integral_comp_mul_right, ← intervalIntegral.integral_const_mul,
    ← integral_one_div_one_add_sq]
  exact integral_congr fun x _ => by
    field_simp
    ring

lemma integral_const_div_self_add_im (hy : y ≠ 0) :
    ∫ x : ℝ in x₁..x₂, A / (x + y * I) =
    A * (Real.log (x₂ ^ 2 + y ^ 2) / 2 - Real.log (x₁ ^ 2 + y ^ 2) / 2) -
    A * I * (Real.arctan (x₂ / y) - Real.arctan (x₁ / y)) := by
  have e1 {x : ℝ} : A / (x + y * I) = A * x / (x ^ 2 + y ^ 2) - A * I * y / (x ^ 2 + y ^ 2) := by
    ring_nf
    simp_rw [inv_re_add_im]
    ring
  have e2 : IntervalIntegrable (fun x ↦ A * x / (x ^ 2 + y ^ 2)) volume x₁ x₂ := by
    apply Continuous.intervalIntegrable
    simp_rw [mul_div_assoc]
    norm_cast
    exact continuous_const.mul (continuous_ofReal.comp (continuous_self_div_sq_add_sq hy))
  have e3 : IntervalIntegrable (fun x ↦ A * I * y / (x ^ 2 + y ^ 2)) volume x₁ x₂ := by
    apply Continuous.intervalIntegrable
    refine continuous_const.div (by fun_prop) (fun x => ?_)
    norm_cast
    exact sq_add_sq_ne_zero hy
  simp_rw [integral_congr (fun _ _ => e1), integral_sub e2 e3, mul_div_assoc]
  norm_cast
  simp_rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_ofReal,
    integral_self_div_sq_add_sq hy, integral_const_div_sq_add_sq hy]

lemma integral_const_div_re_add_self (hx : x ≠ 0) :
    ∫ y : ℝ in y₁..y₂, A / (x + y * I) =
    A / I * (Real.log (y₂ ^ 2 + (-x) ^ 2) / 2 - Real.log (y₁ ^ 2 + (-x) ^ 2) / 2) -
    A / I * I * (Real.arctan (y₂ / -x) - Real.arctan (y₁ / -x)) := by
  have l1 {y : ℝ} : A / (x + y * I) = A / I / (y + ↑(-x) * I) := by
    have e1 : x + y * I ≠ 0 := by
      contrapose! hx
      simpa using congr_arg re hx
    have e2 : y + I * ↑(-x) ≠ 0 := by
      contrapose! hx
      simpa using congr_arg im hx
    field_simp [*]
    push_cast
    ring_nf
    simp
  have l2 : -x ≠ 0 := by rwa [neg_ne_zero]
  simp_rw [l1, integral_const_div_self_add_im l2]

lemma ResidueTheoremAtOrigin' {z w c : ℂ}
    (h1 : z.re < 0) (h2 : z.im < 0) (h3 : 0 < w.re) (h4 : 0 < w.im) :
    RectangleIntegral (fun s => c / s) z w = 2 * I * π * c := by
  simp only [RectangleIntegral, HIntegral, VIntegral, smul_eq_mul]
  rw [integral_const_div_re_add_self h1.ne, integral_const_div_re_add_self h3.ne.symm]
  rw [integral_const_div_self_add_im h2.ne, integral_const_div_self_add_im h4.ne.symm]
  have l1 : z.im * w.re⁻¹ = (w.re * z.im⁻¹)⁻¹ := by group
  have l3 := arctan_inv_of_neg <| mul_neg_of_pos_of_neg h3 <| inv_lt_zero.mpr h2
  have l4 : w.im * z.re⁻¹ = (z.re * w.im⁻¹)⁻¹ := by group
  have l6 := arctan_inv_of_neg <| mul_neg_of_neg_of_pos h1 <| inv_pos.mpr h4
  have r1 : z.im * z.re⁻¹ = (z.re * z.im⁻¹)⁻¹ := by group
  have r3 := arctan_inv_of_pos <| mul_pos_of_neg_of_neg h1 <| inv_lt_zero.mpr h2
  have r4 : w.im * w.re⁻¹ = (w.re * w.im⁻¹)⁻¹ := by group
  have r6 := arctan_inv_of_pos <| mul_pos h3 <| inv_pos.mpr h4
  ring_nf
  simp only [one_div, inv_I, mul_neg, neg_mul, I_sq, neg_neg, arctan_neg, ofReal_neg,
    sub_neg_eq_add]
  rw [l1, l3, l4, l6, r1, r3, r4, r6]
  ring_nf
  simp only [I_sq, ofReal_sub, ofReal_mul, ofReal_ofNat, ofReal_div, ofReal_neg, ofReal_one]
  ring_nf

theorem ResidueTheoremInRectangle
    (zRe_le_wRe : z.re ≤ w.re) (zIm_le_wIm : z.im ≤ w.im)
    (pInRectInterior : Rectangle z w ∈ 𝓝 p) :
    RectangleIntegral' (fun s => c / (s - p)) z w = c := by
  simp only [rectangle_mem_nhds_iff, uIoo_of_le zRe_le_wRe, uIoo_of_le zIm_le_wIm,
    mem_reProdIm, mem_Ioo] at pInRectInterior
  rw [RectangleIntegral.translate', RectangleIntegral']
  have : 1 / (2 * ↑π * I) * (2 * I * ↑π * c) = c := by
    field_simp
  rwa [ResidueTheoremAtOrigin']
  all_goals simp [*]

lemma ResidueTheoremAtOrigin :
    RectangleIntegral' (fun s ↦ 1 / s) (-1 - I) (1 + I) = 1 := by
  rw [RectangleIntegral', ResidueTheoremAtOrigin']
  all_goals simp [field]

lemma ResidueTheoremOnRectangleWithSimplePole {f g : ℂ → ℂ} {z w p A : ℂ}
    (zRe_le_wRe : z.re ≤ w.re) (zIm_le_wIm : z.im ≤ w.im)
    (pInRectInterior : Rectangle z w ∈ 𝓝 p) (gHolo : HolomorphicOn g (Rectangle z w))
    (principalPart : Set.EqOn (f - fun s ↦ A / (s - p)) g (Rectangle z w \ {p})) :
    RectangleIntegral' f z w = A := by
  have principalPart' : Set.EqOn f (g + (fun s ↦ A / (s - p))) (Rectangle z w \ {p}) :=
    fun s hs => by rw [Pi.add_apply, ← principalPart hs, Pi.sub_apply, sub_add_cancel]
  have : Set.EqOn f (g + (fun s ↦ A / (s - p))) (RectangleBorder z w) :=
    principalPart'.mono <| Set.subset_sdiff.mpr
      ⟨rectangleBorder_subset_rectangle z w,
        disjoint_singleton_right.mpr
          (not_mem_rectangleBorder_of_rectangle_mem_nhds pInRectInterior)⟩
  rw [RectangleIntegral'_congr this]
  have t1 : RectangleBorderIntegrable g z w :=
    gHolo.rectangleBorderIntegrable
  have t2 : HolomorphicOn (fun s ↦ A / (s - p)) (Rectangle z w \ {p}) := by
    apply DifferentiableOn.mono (t := {p}ᶜ)
    · apply DifferentiableOn.div
      · exact differentiableOn_const _
      · exact DifferentiableOn.sub differentiableOn_id (differentiableOn_const _)
      · exact fun x hx => by
          rw [sub_ne_zero]
          exact hx
    · rintro s ⟨_, hs⟩
      exact hs
  have t3 : RectangleBorderIntegrable (fun s ↦ A / (s - p)) z w :=
    HolomorphicOn.rectangleBorderIntegrable' t2 pInRectInterior
  rw [RectangleIntegral', RectangleBorderIntegrable.add t1 t3, smul_add]
  rw [gHolo.vanishesOnRectangle (by rfl), smul_zero, zero_add]
  exact ResidueTheoremInRectangle zRe_le_wRe zIm_le_wIm pInRectInterior

lemma IsBigO_to_BddAbove {f : ℂ → ℂ} {p : ℂ}
    (f_near_p : f =O[𝓝[≠] p] (1 : ℂ → ℂ)) :
    ∃ U ∈ 𝓝 p, BddAbove (norm ∘ f '' (U \ {p})) := by
  simp only [isBigO_iff, Pi.one_apply, one_mem, CStarRing.norm_of_mem_unitary, mul_one] at f_near_p
  obtain ⟨c, hc⟩ := f_near_p
  dsimp [Filter.Eventually, nhdsWithin] at hc
  rw [mem_inf_principal'] at hc
  obtain ⟨U, hU, ⟨U_is_open, p_in_U⟩⟩ := mem_nhds_iff.mp hc
  use U
  constructor
  · exact IsOpen.mem_nhds U_is_open p_in_U
  · refine bddAbove_def.mpr ?_
    use c
    intro y hy
    simp only [Function.comp_apply, mem_image, Set.mem_sdiff, mem_singleton_iff] at hy
    obtain ⟨x, ⟨x_in_U, x_not_p⟩, fxy⟩ := hy
    rw [← fxy]
    simpa [x_not_p] using hU x_in_U

theorem BddAbove_on_rectangle_of_bdd_near {z w p : ℂ} {f : ℂ → ℂ}
    (f_cont : ContinuousOn f (Rectangle z w \ {p}))
    (f_near_p : f =O[𝓝[≠] p] (1 : ℂ → ℂ)) :
    BddAbove (norm ∘ f '' (Rectangle z w \ {p})) := by
  obtain ⟨V, V_in_nhds, V_prop⟩ := IsBigO_to_BddAbove f_near_p
  rw [mem_nhds_iff] at V_in_nhds
  obtain ⟨W, W_subset, W_open, p_in_W⟩ := V_in_nhds
  set U := Rectangle z w
  have : U \ {p} = (U \ W) ∪ ((U ∩ W) \ {p}) := by
    ext x
    simp only [Set.mem_sdiff, mem_singleton_iff, mem_union, mem_inter_iff]
    constructor
    · intro ⟨xu, x_not_p⟩
      tauto
    · intro h
      rcases h with ⟨h1, h2⟩ | ⟨⟨h1, h2⟩, h3⟩
      · refine ⟨h1, ?_⟩
        intro h
        rw [← h] at p_in_W
        exact h2 p_in_W
      · tauto
  rw [this, image_union]
  apply BddAbove.union
  · apply IsCompact.bddAbove_image
    · apply IsCompact.diff _ W_open
      exact IsCompact.reProdIm isCompact_uIcc isCompact_uIcc
    · apply f_cont.norm.mono
      apply Set.sdiff_subset_sdiff_right
      simpa
  · exact V_prop.mono
      (image_mono <| Set.sdiff_subset_sdiff_left <| subset_trans inter_subset_right W_subset)

theorem ResidueTheoremOnRectangleWithSimplePole' {f : ℂ → ℂ} {z w p A : ℂ}
    (zRe_le_wRe : z.re ≤ w.re) (zIm_le_wIm : z.im ≤ w.im)
    (pInRectInterior : Rectangle z w ∈ 𝓝 p) (fHolo : HolomorphicOn f (Rectangle z w \ {p}))
    (near_p : (f - (fun s ↦ A / (s - p))) =O[𝓝[≠] p] (1 : ℂ → ℂ)) :
    RectangleIntegral' f z w = A := by
  set g := f - (fun s ↦ A / (s - p))
  have gHolo : HolomorphicOn g (Rectangle z w \ {p}) := by
    apply DifferentiableOn.sub fHolo
    intro s hs
    have : s - p ≠ 0 := sub_ne_zero.mpr hs.2
    exact  DifferentiableWithinAt.div (by fun_prop) (by fun_prop) this
  have := BddAbove_on_rectangle_of_bdd_near gHolo.continuousOn near_p
  obtain ⟨h, ⟨hHolo, hEq⟩⟩ := existsDifferentiableOn_of_bddAbove pInRectInterior gHolo this
  exact ResidueTheoremOnRectangleWithSimplePole zRe_le_wRe zIm_le_wIm pInRectInterior hHolo hEq

                                                                                            

                           

                                                                                                

                                                                                         

def HasSimplePolesOn (f : ℂ → ℂ) (s : Set ℂ) : Prop :=
  ∀ z ∈ s, (-1 : ℤ) ≤ meromorphicOrderAt f z

lemma HasSimplePolesOn.mono {f : ℂ → ℂ} {s t : Set ℂ}
    (h : HasSimplePolesOn f t) (hst : s ⊆ t) : HasSimplePolesOn f s := by
  intro z hz
  exact h z (hst hz)

                                                                                  

                                                                                               

                                                                                                

                                   
noncomputable def residue (f : ℂ → ℂ) (z₀ : ℂ) : ℂ :=
  Filter.limUnder (nhdsWithin z₀ {z₀}ᶜ) (fun z ↦ (z - z₀) * f z)

                                                                                               

                                                                                    
noncomputable def sumResiduesIn (f : ℂ → ℂ) (S : Set ℂ) : ℂ :=
  ∑' z : S, residue f z

lemma residue_eq_of_tendsto {f : ℂ → ℂ} {p c : ℂ}
    (h : Filter.Tendsto (fun z ↦ (z - p) * f z) (nhdsWithin p {p}ᶜ) (nhds c)) :
    residue f p = c := by
  unfold residue
  exact h.limUnder_eq

lemma residue_analyticAt_eq_zero {f : ℂ → ℂ} {p : ℂ} (hf : AnalyticAt ℂ f p) :
    residue f p = 0 := by
  apply residue_eq_of_tendsto
  have hsub : Filter.Tendsto (fun z : ℂ ↦ z - p) (nhdsWithin p {p}ᶜ) (nhds 0) :=
    tendsto_sub_nhds_zero_iff.mpr (tendsto_id.mono_left nhdsWithin_le_nhds)
  have hf' : Filter.Tendsto f (nhdsWithin p {p}ᶜ) (nhds (f p)) :=
    hf.continuousAt.continuousWithinAt.tendsto
  simpa using hsub.mul hf'

lemma simplePole_sub_residue_isBigO_one {f : ℂ → ℂ} {p : ℂ}
    (hf : MeromorphicAt f p) (hord : meromorphicOrderAt f p = (-1 : ℤ)) :
    (f - (fun z ↦ residue f p / (z - p))) =O[nhdsWithin p {p}ᶜ] (1 : ℂ → ℂ) := by
  obtain ⟨g, hg_analytic, hg_ne, hg_eq⟩ := (meromorphicOrderAt_eq_int_iff hf).1 hord
  have hres : residue f p = g p :=
    residue_eq_of_tendsto (hg_analytic.continuousAt.continuousWithinAt.tendsto.congr'
      (show (fun z ↦ (z - p) * f z) =ᶠ[nhdsWithin p {p}ᶜ] g from by
        filter_upwards [hg_eq, self_mem_nhdsWithin] with z hz hz_ne
        simp [hz, sub_ne_zero.mpr hz_ne]).symm)
  have hdslope : (fun z ↦ (z - p)⁻¹ * (g z - g p)) =O[nhdsWithin p {p}ᶜ] (1 : ℂ → ℂ) := by
    have hcont : ContinuousAt (dslope g p) p :=
      continuousAt_dslope_same.2 hg_analytic.differentiableAt
    have hbig : dslope g p =O[nhds p] (1 : ℂ → ℂ) :=
      hcont.norm.isBoundedUnder_le.isBigO_one ℂ
    have hbig_ne : dslope g p =O[nhdsWithin p {p}ᶜ] (1 : ℂ → ℂ) :=
      IsBigO.mono hbig inf_le_left
    simpa [slope] using! hbig_ne.congr' (dslope_eventuallyEq_slope_nhdsNE (f := g) (a := p)) .rfl
  refine hdslope.congr' ?_ .rfl
  filter_upwards [hg_eq, self_mem_nhdsWithin] with z hz hz_ne
  simp [hz, hres, div_eq_mul_inv, sub_eq_add_neg]; ring

                                                                                            

private lemma intervalIntegral_congr_ae_of_codiscreteWithin_along_path
    {f g : ℂ → ℂ} {R : Set ℂ}
    (heq : {s : ℂ | f s = g s} ∈ Filter.codiscreteWithin R)
    {a b : ℝ} {p : ℝ → ℂ}
    (hp_an : AnalyticOnNhd ℝ p (Set.uIcc a b))
    (hp_nonconst : ∀ x ∈ Set.uIcc a b, ¬Filter.EventuallyConst p (nhds x))
    (hp_maps : Set.MapsTo p (Set.uIcc a b) R) :
    ∫ x in a..b, f (p x) = ∫ x in a..b, g (p x) := by
  refine intervalIntegral.integral_congr_ae_restrict (μ := volume) ?_
  apply ae_restrict_le_codiscreteWithin measurableSet_uIoc
  change {x : ℝ | f (p x) = g (p x)} ∈ Filter.codiscreteWithin (Set.uIoc a b)
  simpa [Set.preimage] using Filter.codiscreteWithin_mono Set.uIoc_subset_uIcc
    (hp_an.preimage_mem_codiscreteWithin hp_nonconst
      (Filter.codiscreteWithin_mono
        (by intro s hs; rcases hs with ⟨x, hx, rfl⟩; exact hp_maps hx) heq))

                                                                                                 

private lemma meromorphicOrderAt_eq_neg_one_of_simplePole
    {f : ℂ → ℂ} {U : Set ℂ} {p : ℂ}
    (hpU : p ∈ U)
    (hf_simple : HasSimplePolesOn f U)
    (hpneg : meromorphicOrderAt f p < 0) :
    meromorphicOrderAt f p = (-1 : ℤ) := by
  lift meromorphicOrderAt f p to ℤ using hpneg.ne_top with n hn
  have hsimple : (-1 : ℤ) ≤ n := WithTop.coe_le_coe.mp (hn ▸ hf_simple p hpU)
  have hneg : n < 0 := by exact_mod_cast hpneg
  have hn1 : n = -1 := by omega
  simp [hn1]

                                                                                            

private lemma residue_toMeromorphicNFOn_eq_residue
    {f : ℂ → ℂ} {U : Set ℂ} {p : ℂ}
    (hpU : p ∈ U)
    (hf_mero : MeromorphicOn f U)
    (hf_simple : HasSimplePolesOn f U)
    (hpneg : meromorphicOrderAt f p < 0) :
    residue (toMeromorphicNFOn f U) p = residue f p := by
  have hmero : MeromorphicAt f p := hf_mero p hpU
  have h_exists : ∃ c, Filter.Tendsto (fun z : ℂ ↦ (z - p) * f z) (nhdsWithin p ({p}ᶜ)) (nhds c) := by
    have hmul_mero : MeromorphicAt (fun z : ℂ ↦ (z - p) * f z) p :=
      (by fun_prop : MeromorphicAt (fun z : ℂ ↦ z - p) p).mul hmero
    have hmul_nonneg : 0 ≤ meromorphicOrderAt (fun z : ℂ ↦ (z - p) * f z) p := by
      change 0 ≤ meromorphicOrderAt ((fun z ↦ z - p) * f) p
      rw [meromorphicOrderAt_mul (by fun_prop : MeromorphicAt (fun z : ℂ ↦ z - p) p) hmero,
        meromorphicOrderAt_id_sub_const,
        meromorphicOrderAt_eq_neg_one_of_simplePole hpU hf_simple hpneg]
      norm_num
    exact tendsto_nhds_of_meromorphicOrderAt_nonneg hmul_mero hmul_nonneg
  have h_tendsto : Filter.Tendsto (fun z : ℂ ↦ (z - p) * f z) (nhdsWithin p ({p}ᶜ)) (nhds (residue f p)) := by
    simpa [residue] using tendsto_nhds_limUnder h_exists
  have h_eq :
      (fun z ↦ (z - p) * toMeromorphicNFOn f U z) =ᶠ[nhdsWithin p ({p}ᶜ)]
        (fun z ↦ (z - p) * f z) := by
    filter_upwards [hf_mero.toMeromorphicNFOn_eq_self_on_nhdsNE hpU] with z hz
    simp [hz]
  exact residue_eq_of_tendsto
    (h_tendsto.congr' h_eq.symm)

private lemma horizontalPath_not_eventuallyConst (h : ℝ) (x : ℝ) :
    ¬Filter.EventuallyConst (fun r : ℝ ↦ (r : ℂ) + (h : ℂ) * Complex.I) (nhds x) := by
  intro hc
  obtain ⟨c, hc⟩ := Filter.eventuallyConst_iff_exists_eventuallyEq.1 hc
  have hpath : HasDerivAt (fun r : ℝ ↦ (r : ℂ) + (h : ℂ) * Complex.I) 1 x := by
    simpa using (Complex.ofRealCLM.hasDerivAt (x := x)).add_const ((h : ℂ) * Complex.I)
  have hconst : HasDerivAt (fun r : ℝ ↦ (r : ℂ) + (h : ℂ) * Complex.I) 0 x :=
    (hasDerivAt_const x c).congr_of_eventuallyEq hc
  exact one_ne_zero (hpath.unique hconst)

lemma verticalPath_not_eventuallyConst (r : ℝ) (x : ℝ) :
    ¬Filter.EventuallyConst (fun y : ℝ ↦ (r : ℂ) + (y : ℂ) * Complex.I) (nhds x) := by
  intro hc
  obtain ⟨c, hc⟩ := Filter.eventuallyConst_iff_exists_eventuallyEq.1 hc
  have hpath : HasDerivAt (fun y : ℝ ↦ (r : ℂ) + (y : ℂ) * Complex.I) Complex.I x := by
    simpa using ((Complex.ofRealCLM.hasDerivAt (x := x)).mul_const Complex.I).const_add (r : ℂ)
  have hconst : HasDerivAt (fun y : ℝ ↦ (r : ℂ) + (y : ℂ) * Complex.I) 0 x :=
    (hasDerivAt_const x c).congr_of_eventuallyEq hc
  exact Complex.I_ne_zero (hpath.unique hconst)

private lemma HIntegral_congr_codiscreteWithin {f g : ℂ → ℂ} {R : Set ℂ} {a b c : ℝ}
    (h_eq : {s : ℂ | f s = g s} ∈ Filter.codiscreteWithin R)
    (hmaps : ∀ x ∈ Set.uIcc a b, (↑x + ↑c * Complex.I) ∈ R) :
    HIntegral f a b c = HIntegral g a b c := by
  unfold HIntegral
  exact intervalIntegral_congr_ae_of_codiscreteWithin_along_path h_eq
    (by intro x _; exact (Complex.ofRealCLM.analyticAt x).add analyticAt_const)
    (fun x _ ↦ horizontalPath_not_eventuallyConst c x) hmaps

private lemma VIntegral_congr_codiscreteWithin {f g : ℂ → ℂ} {R : Set ℂ} {c a b : ℝ}
    (h_eq : {s : ℂ | f s = g s} ∈ Filter.codiscreteWithin R)
    (hmaps : ∀ y ∈ Set.uIcc a b, (↑c + ↑y * Complex.I) ∈ R) :
    VIntegral f c a b = VIntegral g c a b := by
  unfold VIntegral; simp only [smul_eq_mul]; congr 1
  exact intervalIntegral_congr_ae_of_codiscreteWithin_along_path h_eq
    (by intro y _; exact analyticAt_const.add ((Complex.ofRealCLM.analyticAt y).mul analyticAt_const))
    (fun x _ ↦ verticalPath_not_eventuallyConst c x) hmaps

                                                  
private lemma rectangleIntegral'_toMeromorphicNFOn_eq {f : ℂ → ℂ} {z w : ℂ}
    (f_mero : MeromorphicOn f (Rectangle z w)) :
    RectangleIntegral' f z w = RectangleIntegral' (toMeromorphicNFOn f (Rectangle z w)) z w := by
  classical
  let R : Set ℂ := Rectangle z w
  let fNF : ℂ → ℂ := toMeromorphicNFOn f R
  have h_eq : {s : ℂ | f s = fNF s} ∈ Filter.codiscreteWithin R := by
    simpa [Filter.EventuallyEq, Filter.Eventually, fNF] using
      (toMeromorphicNFOn_eqOn_codiscrete (f := f) (U := R) f_mero)
  have hbot := HIntegral_congr_codiscreteWithin h_eq (by simpa [R] using! mapsTo_rectangle_left_im z w)
  have htop := HIntegral_congr_codiscreteWithin h_eq (by simpa [R] using! mapsTo_rectangle_right_im z w)
  have hright := VIntegral_congr_codiscreteWithin h_eq (by simpa [R] using! mapsTo_rectangle_right_re z w)
  have hleft := VIntegral_congr_codiscreteWithin h_eq (by simpa [R] using! mapsTo_rectangle_left_re z w)
  unfold RectangleIntegral'; congr 1; unfold RectangleIntegral
  rw [hbot, htop, hright, hleft]

private lemma principalPart_meromorphicOn {R : Set ℂ} {polesFin : Finset ℂ} {c : ℂ → ℂ} :
    MeromorphicOn (fun s ↦ ∑ p ∈ polesFin, c p / (s - p)) R := by
  intro x _
  refine MeromorphicAt.fun_sum (G := fun p s ↦ c p / (s - p)) ?_
  intro p _
  exact (analyticAt_const.meromorphicAt.div
    ((analyticAt_id.sub analyticAt_const).meromorphicAt))

private lemma sub_principalPart_analyticAt_of_not_mem_poles
    {f : ℂ → ℂ} {polesFin : Finset ℂ} {x : ℂ}
    (h_nf : MeromorphicNFAt f x)
    (hxnp : x ∉ polesFin)
    (hxneg : 0 ≤ meromorphicOrderAt f x) :
    AnalyticAt ℂ (f - fun s ↦ ∑ p ∈ polesFin, residue f p / (s - p)) x := by
  have h_f_analytic : AnalyticAt ℂ f x :=
    h_nf.meromorphicOrderAt_nonneg_iff_analyticAt.1 hxneg
  have h_principal_analytic : AnalyticAt ℂ (fun s ↦ ∑ p ∈ polesFin, residue f p / (s - p)) x := by
    refine Finset.analyticAt_fun_sum polesFin ?_
    intro p hp
    have hxp : x ≠ p := by
      intro heq
      subst heq
      exact hxnp hp
    have : AnalyticAt ℂ (fun z : ℂ ↦ residue f p / (z - p)) x := by
      fun_prop (disch := exact sub_ne_zero.mpr hxp)
    simpa using this
  exact h_f_analytic.sub h_principal_analytic

private lemma meromorphicOrderAt_sub_principalPart_nonneg
    {f : ℂ → ℂ} {polesFin : Finset ℂ} {p : ℂ}
    (hpFin : p ∈ polesFin)
    (h_mero : MeromorphicAt f p)
    (h_ord : meromorphicOrderAt f p = -1) :
    0 ≤ meromorphicOrderAt (f - fun s ↦ ∑ q ∈ polesFin, residue f q / (s - q)) p := by
  have hcore : (f - fun z ↦ residue f p / (z - p)) =O[nhdsWithin p ({p}ᶜ)] (1 : ℂ → ℂ) := by
    exact simplePole_sub_residue_isBigO_one h_mero h_ord
  let rest : ℂ → ℂ := fun z ↦ ∑ q ∈ polesFin.erase p, residue f q / (z - q)
  have hrest_cont : ContinuousAt rest p := by
    dsimp [rest]
    refine tendsto_finsetSum _ (fun q hq ↦ ?_)
    have hpq : p - q ≠ 0 := sub_ne_zero.mpr (Finset.mem_erase.mp hq).1.symm
    have h_cont : ContinuousAt (fun z : ℂ ↦ residue f q / (z - q)) p := by
      fun_prop (disch := exact hpq)
    exact h_cont
  have hrest : rest =O[nhdsWithin p ({p}ᶜ)] (1 : ℂ → ℂ) := by
    have hbig : rest =O[nhds p] (1 : ℂ → ℂ) :=
      hrest_cont.norm.isBoundedUnder_le.isBigO_one ℂ
    exact IsBigO.mono hbig inf_le_left
  have hraw_big : (f - fun s ↦ ∑ q ∈ polesFin, residue f q / (s - q)) =O[nhdsWithin p ({p}ᶜ)] (1 : ℂ → ℂ) := by
    have htmp : (fun z : ℂ ↦ (f z - residue f p / (z - p)) - rest z) =O[nhdsWithin p ({p}ᶜ)] (1 : ℂ → ℂ) :=
      hcore.sub hrest
    have hdecomp : (f - fun s ↦ ∑ q ∈ polesFin, residue f q / (s - q)) =
        (fun z : ℂ ↦ (f z - residue f p / (z - p)) - rest z) := by
      funext z
      dsimp [rest]
      rw [← Finset.add_sum_erase (s := polesFin) (f := fun q ↦ residue f q / (z - q)) hpFin]
      simp [sub_eq_add_neg, add_assoc, add_comm]
    simpa [hdecomp, rest] using htmp
  by_contra hneg
  have hnorm : Filter.Tendsto (fun z : ℂ ↦ ‖(f - fun s ↦ ∑ q ∈ polesFin, residue f q / (s - q)) z‖) (nhdsWithin p ({p}ᶜ)) Filter.atTop := by
    rw [tendsto_norm_atTop_iff_cobounded]
    exact tendsto_cobounded_of_meromorphicOrderAt_neg (not_le.mp hneg)
  exact (Filter.not_isBoundedUnder_of_tendsto_atTop hnorm) hraw_big.isBoundedUnder_le

private lemma holoPart_holomorphicOn {f : ℂ → ℂ} {z w : ℂ}
    (f_mero : MeromorphicOn f (Rectangle z w))
    (f_simple_poles : HasSimplePolesOn f (Rectangle z w))
    (f_poles_finite : (Rectangle z w ∩ {z | meromorphicOrderAt f z < 0}).Finite) :
    HolomorphicOn (toMeromorphicNFOn (toMeromorphicNFOn f (Rectangle z w) -
      fun s ↦ ∑ p ∈ f_poles_finite.toFinset, residue (toMeromorphicNFOn f (Rectangle z w)) p / (s - p)) (Rectangle z w)) (Rectangle z w) := by
  classical
  let R := Rectangle z w
  let poles := R ∩ {u | meromorphicOrderAt f u < 0}
  let polesFin := f_poles_finite.toFinset
  let fNF := toMeromorphicNFOn f R
  let principalPart := fun s ↦ ∑ p ∈ polesFin, residue fNF p / (s - p)
  let holoPart := toMeromorphicNFOn (fNF - principalPart) R
  have h_fNF_mero : MeromorphicOn fNF R := by
    simpa [fNF] using
      (meromorphicNFOn_toMeromorphicNFOn (f := f) (U := R)).meromorphicOn
  have h_principalPart_mero : MeromorphicOn principalPart R := principalPart_meromorphicOn
  have h_raw_mero : MeromorphicOn (fNF - principalPart) R := h_fNF_mero.sub h_principalPart_mero
  intro x hx
  have h_raw_nonneg : 0 ≤ meromorphicOrderAt (fNF - principalPart) x := by
    by_cases hxp : x ∈ poles
    · have hpFin : x ∈ polesFin := by simpa [polesFin, poles] using hxp
      have hord : meromorphicOrderAt f x = (-1 : ℤ) :=
        meromorphicOrderAt_eq_neg_one_of_simplePole hxp.1 f_simple_poles hxp.2
      have hordNF : meromorphicOrderAt fNF x = (-1 : ℤ) := by
        rw [show meromorphicOrderAt fNF x = meromorphicOrderAt f x by
          simpa [fNF] using
            (meromorphicOrderAt_toMeromorphicNFOn (f := f) (U := R) f_mero hxp.1)]
        exact hord
      exact meromorphicOrderAt_sub_principalPart_nonneg hpFin (h_fNF_mero x hxp.1) hordNF
    · have hxnp : x ∉ polesFin := by
        intro h
        exact hxp (by simpa [polesFin, poles] using h)
      have h_fNF_nonneg : 0 ≤ meromorphicOrderAt fNF x := by
        rw [show meromorphicOrderAt fNF x = meromorphicOrderAt f x by
          simpa [fNF] using
            (meromorphicOrderAt_toMeromorphicNFOn (f := f) (U := R) f_mero hx)]
        exact le_of_not_gt fun hxneg => hxp ⟨hx, hxneg⟩
      have h_fNF_nf : MeromorphicNFAt fNF x := by
        simpa [fNF] using
          (meromorphicNFOn_toMeromorphicNFOn (f := f) (U := R) hx)
      exact (sub_principalPart_analyticAt_of_not_mem_poles h_fNF_nf hxnp h_fNF_nonneg).meromorphicOrderAt_nonneg
  have h_nf : MeromorphicNFAt holoPart x := by
    simpa [holoPart] using
      (meromorphicNFOn_toMeromorphicNFOn (f := fNF - principalPart) (U := R) hx)
  have h_ord :
      meromorphicOrderAt holoPart x = meromorphicOrderAt (fNF - principalPart) x := by
    simpa [holoPart] using
      (meromorphicOrderAt_toMeromorphicNFOn (f := fNF - principalPart) (U := R) h_raw_mero hx)
  exact (h_nf.meromorphicOrderAt_nonneg_iff_analyticAt.1 (h_ord.symm ▸ h_raw_nonneg)).differentiableAt.differentiableWithinAt

                                            
private lemma principalPart_borderIntegrable {f : ℂ → ℂ} {z w : ℂ}
    (f_no_poles_boundary : Disjoint (RectangleBorder z w) {z | meromorphicOrderAt f z < 0})
    (f_poles_finite : (Rectangle z w ∩ {z | meromorphicOrderAt f z < 0}).Finite) :
    RectangleBorderIntegrable (fun s ↦ ∑ p ∈ f_poles_finite.toFinset, residue (toMeromorphicNFOn f (Rectangle z w)) p / (s - p)) z w := by
  classical
  let R := Rectangle z w
  let poles := R ∩ {u | meromorphicOrderAt f u < 0}
  let polesFin := f_poles_finite.toFinset
  let fNF := toMeromorphicNFOn f R
  let principalPart := fun s ↦ ∑ p ∈ polesFin, residue fNF p / (s - p)
  refine ContinuousOn.rectangleBorder_integrable ?_
  refine continuousOn_finsetSum _ ?_
  intro p hp s hs
  have hsp : s ≠ p := fun hsp => Set.disjoint_right.mp f_no_poles_boundary
    ((by simpa [polesFin, poles] using hp : p ∈ poles).2) (hsp ▸ hs)
  have : ContinuousAt (fun z : ℂ ↦ residue fNF p / (z - p)) s := by
    fun_prop (disch := exact sub_ne_zero.mpr hsp)
  exact this.continuousWithinAt

private lemma rectangle_mem_nhds_of_interior {z w p : ℂ}
    (zRe_le_wRe : z.re ≤ w.re) (zIm_le_wIm : z.im ≤ w.im)
    (hpR : p ∈ Rectangle z w) (hpnot : p ∉ RectangleBorder z w) :
    Rectangle z w ∈ nhds p := by
  rw [mem_Rect zRe_le_wRe zIm_le_wIm] at hpR
  have hp_re_left : z.re < p.re :=
    lt_of_le_of_ne hpR.1 fun hEq => hpnot
      (by simp [RectangleBorder, hEq, hpR.2.2.1, hpR.2.2.2, zIm_le_wIm, mem_reProdIm])
  have hp_re_right : p.re < w.re :=
    lt_of_le_of_ne hpR.2.1 fun hEq => hpnot
      (by simp [RectangleBorder, hEq, hpR.2.2.1, hpR.2.2.2, zIm_le_wIm, mem_reProdIm])
  have hp_im_left : z.im < p.im :=
    lt_of_le_of_ne hpR.2.2.1 fun hEq => hpnot
      (by simp [RectangleBorder, hEq, hpR.1, hpR.2.1, zRe_le_wRe, mem_reProdIm])
  have hp_im_right : p.im < w.im :=
    lt_of_le_of_ne hpR.2.2.2 fun hEq => hpnot
      (by simp [RectangleBorder, hEq, hpR.1, hpR.2.1, zRe_le_wRe, mem_reProdIm])
  rw [rectangle_mem_nhds_iff, mem_reProdIm, Set.uIoo_of_le zRe_le_wRe, Set.uIoo_of_le zIm_le_wIm]
  exact ⟨⟨hp_re_left, hp_re_right⟩, ⟨hp_im_left, hp_im_right⟩⟩

private lemma sum_div_rectangleBorderIntegrable {z w : ℂ} {S : Finset ℂ}
    (hS_disjoint : Disjoint (RectangleBorder z w) S) (c : ℂ → ℂ) :
    RectangleBorderIntegrable (fun s ↦ ∑ p ∈ S, c p / (s - p)) z w := by
  refine ContinuousOn.rectangleBorder_integrable ?_
  refine continuousOn_finsetSum _ ?_
  intro p hp s hs
  have hsp : s ≠ p := fun hsp => Set.disjoint_right.mp hS_disjoint hp (hsp ▸ hs)
  have : ContinuousAt (fun z : ℂ ↦ c p / (z - p)) s := by
    fun_prop (disch := exact sub_ne_zero.mpr hsp)
  exact this.continuousWithinAt

                                                                               
private lemma rectangleIntegral'_sum_div_sub {z w : ℂ} (zRe_le_wRe : z.re ≤ w.re) (zIm_le_wIm : z.im ≤ w.im)
    {S : Finset ℂ} (hS_subset : (S : Set ℂ) ⊆ Rectangle z w)
    (hS_disjoint : Disjoint (RectangleBorder z w) S)
    (c : ℂ → ℂ) :
    RectangleIntegral' (fun s ↦ ∑ p ∈ S, c p / (s - p)) z w = ∑ p ∈ S, c p := by
  classical
  have h_partial_border : ∀ (S' : Finset ℂ), S' ⊆ S → RectangleBorderIntegrable (fun s ↦ ∑ p ∈ S', c p / (s - p)) z w := by
    intro S' hS'
    exact sum_div_rectangleBorderIntegrable (Disjoint.mono_right hS' hS_disjoint) c
  have h_term_integral : ∀ {p : ℂ}, p ∈ S → RectangleIntegral' (fun s ↦ c p / (s - p)) z w = c p :=
    fun {p} hp => ResidueTheoremInRectangle zRe_le_wRe zIm_le_wIm
      (rectangle_mem_nhds_of_interior zRe_le_wRe zIm_le_wIm
        (hS_subset hp) (Set.disjoint_right.mp hS_disjoint hp))
  have h_partial_integral :
      ∀ (S' : Finset ℂ), S' ⊆ S →
        RectangleIntegral' (fun s ↦ ∑ p ∈ S', c p / (s - p)) z w =
          ∑ p ∈ S', c p := by
    intro S' hS'
    revert hS'
    refine Finset.induction_on S' ?_ ?_
    · intro _
      simp [RectangleIntegral', RectangleIntegral, HIntegral, VIntegral]
    · intro a S' ha ih hS'
      obtain ⟨haFin, hSsub⟩ := Finset.insert_subset_iff.mp hS'
      have hterm_border :
          RectangleBorderIntegrable (fun s ↦ c a / (s - a)) z w :=
        by simpa using h_partial_border ({a} : Finset ℂ) (Finset.singleton_subset_iff.mpr haFin)
      have hfun :
          (fun s ↦ ∑ p ∈ insert a S', c p / (s - p)) =
            (fun s ↦ c a / (s - a)) +
              (fun s ↦ ∑ p ∈ S', c p / (s - p)) := by
        funext s; simp [Finset.sum_insert, ha]
      have h_add_primed :
          RectangleIntegral' ((fun s ↦ c a / (s - a)) + (fun s ↦ ∑ p ∈ S', c p / (s - p))) z w =
            RectangleIntegral' (fun s ↦ c a / (s - a)) z w +
              RectangleIntegral' (fun s ↦ ∑ p ∈ S', c p / (s - p)) z w := by
        unfold RectangleIntegral'
        rw [RectangleBorderIntegrable.add hterm_border (h_partial_border S' hSsub), smul_add]
      rw [hfun, h_add_primed, h_term_integral haFin, ih hSsub, Finset.sum_insert ha]
  exact h_partial_integral S (by intro p hp; exact hp)

private lemma toMeromorphicNFOn_add_integral {f : ℂ → ℂ} {z w : ℂ}
    (f_mero : MeromorphicOn f (Rectangle z w))
    (f_no_poles_boundary : Disjoint (RectangleBorder z w) {z | meromorphicOrderAt f z < 0})
    (f_poles_finite : (Rectangle z w ∩ {z | meromorphicOrderAt f z < 0}).Finite)
    (f_simple_poles : HasSimplePolesOn f (Rectangle z w)) :
    RectangleIntegral' (toMeromorphicNFOn f (Rectangle z w)) z w =
      RectangleIntegral' (toMeromorphicNFOn (toMeromorphicNFOn f (Rectangle z w) -
        fun s ↦ ∑ p ∈ f_poles_finite.toFinset, residue (toMeromorphicNFOn f (Rectangle z w)) p / (s - p)) (Rectangle z w)) z w +
      RectangleIntegral' (fun s ↦ ∑ p ∈ f_poles_finite.toFinset, residue (toMeromorphicNFOn f (Rectangle z w)) p / (s - p)) z w := by
  let R : Set ℂ := Rectangle z w
  let poles : Set ℂ := R ∩ {u | meromorphicOrderAt f u < 0}
  let polesFin : Finset ℂ := f_poles_finite.toFinset
  let fNF : ℂ → ℂ := toMeromorphicNFOn f R
  let principalPart : ℂ → ℂ := fun s ↦ ∑ p ∈ polesFin, residue fNF p / (s - p)
  let holoPart : ℂ → ℂ := toMeromorphicNFOn (fNF - principalPart) R
  have h_holoPart_border : RectangleBorderIntegrable holoPart z w :=
    (holoPart_holomorphicOn f_mero f_simple_poles f_poles_finite).rectangleBorderIntegrable
  have h_fNF_eq :
      Set.EqOn fNF (holoPart + principalPart) (RectangleBorder z w) := by
    intro s hs
    have hsR : s ∈ R := rectangleBorder_subset_rectangle z w hs
    have hsnp : s ∉ poles := fun hsp => Set.disjoint_right.mp f_no_poles_boundary hsp.2 hs
    have hraw_analytic : AnalyticAt ℂ (fNF - principalPart) s := by
      have h_fNF_nonneg : 0 ≤ meromorphicOrderAt fNF s := by
        rw [show meromorphicOrderAt fNF s = meromorphicOrderAt f s by
          simpa [fNF] using
            (meromorphicOrderAt_toMeromorphicNFOn (f := f) (U := R) f_mero hsR)]
        exact le_of_not_gt fun hsneg => hsnp ⟨hsR, hsneg⟩
      exact sub_principalPart_analyticAt_of_not_mem_poles
        (by simpa [fNF] using meromorphicNFOn_toMeromorphicNFOn (f := f) (U := R) hsR)
        (fun h => hsnp (by simpa [polesFin, poles] using h))
        h_fNF_nonneg
    have hs_eq : holoPart s = (fNF - principalPart) s := by
      rw [show holoPart = toMeromorphicNFOn (fNF - principalPart) R by rfl]
      have h_fNF_mero : MeromorphicOn fNF R := by
        simpa [fNF] using (meromorphicNFOn_toMeromorphicNFOn (f := f) (U := R)).meromorphicOn
      have hf_sub_mero : MeromorphicOn (fNF - principalPart) R :=
        h_fNF_mero.sub principalPart_meromorphicOn
      rw [toMeromorphicNFOn_eq_toMeromorphicNFAt (f := fNF - principalPart) (U := R) hf_sub_mero hsR]
      exact congr_fun (toMeromorphicNFAt_eq_self.2 hraw_analytic.meromorphicNFAt) s
    calc
      fNF s = (fNF - principalPart) s + principalPart s := by simp
      _ = holoPart s + principalPart s := by rw [← hs_eq]
  rw [RectangleIntegral'_congr h_fNF_eq, RectangleIntegral',
    RectangleBorderIntegrable.add h_holoPart_border
      (principalPart_borderIntegrable f_no_poles_boundary f_poles_finite), smul_add]

lemma RectangleIntegral'_eq_sumResiduesIn {f : ℂ → ℂ} {z w : ℂ}
    (zRe_le_wRe : z.re ≤ w.re) (zIm_le_wIm : z.im ≤ w.im)
    (f_mero : MeromorphicOn f (Rectangle z w))
    (f_no_poles_boundary : Disjoint (RectangleBorder z w) {z | meromorphicOrderAt f z < 0})
    (f_poles_finite : (Rectangle z w ∩ {z | meromorphicOrderAt f z < 0}).Finite)
    (f_simple_poles : HasSimplePolesOn f (Rectangle z w)) :
    RectangleIntegral' f z w = sumResiduesIn f (Rectangle z w ∩ {z | meromorphicOrderAt f z < 0}) := by
  let R : Set ℂ := Rectangle z w
  let poles : Set ℂ := R ∩ {u | meromorphicOrderAt f u < 0}
  let polesFin : Finset ℂ := f_poles_finite.toFinset
  let fNF : ℂ → ℂ := toMeromorphicNFOn f R
  let principalPart : ℂ → ℂ := fun s ↦ ∑ p ∈ polesFin, residue fNF p / (s - p)
  let holoPart : ℂ → ℂ := toMeromorphicNFOn (fNF - principalPart) R
  have h_residue_congr : sumResiduesIn f poles = sumResiduesIn fNF poles := by
    rw [sumResiduesIn, sumResiduesIn]
    apply tsum_congr
    intro p
    exact (residue_toMeromorphicNFOn_eq_residue p.2.1 f_mero f_simple_poles p.2.2).symm
  have h_principalPart_integral : RectangleIntegral' principalPart z w = sumResiduesIn fNF poles := by
    have h_sum : RectangleIntegral' principalPart z w = ∑ p ∈ polesFin, residue fNF p := by
      apply rectangleIntegral'_sum_div_sub zRe_le_wRe zIm_le_wIm
      · intro p hp
        dsimp [polesFin, poles, R] at hp
        simp only [Finset.mem_coe, Set.Finite.mem_toFinset] at hp
        exact hp.1
      · exact Disjoint.mono_right (by rw [f_poles_finite.coe_toFinset]; exact Set.inter_subset_right) f_no_poles_boundary
    rw [h_sum]
    have h_eq_poles : poles = ↑polesFin := by
      dsimp [poles, polesFin, R]
      exact f_poles_finite.coe_toFinset.symm
    rw [sumResiduesIn, h_eq_poles,
      tsum_fintype (f := fun p : (polesFin : Set ℂ) => residue fNF p),
      ← Finset.sum_coe_sort polesFin]; rfl
  calc
    RectangleIntegral' f z w = RectangleIntegral' fNF z w := rectangleIntegral'_toMeromorphicNFOn_eq f_mero
    _ = RectangleIntegral' holoPart z w + RectangleIntegral' principalPart z w :=
      toMeromorphicNFOn_add_integral f_mero f_no_poles_boundary f_poles_finite f_simple_poles
    _ = 0 + sumResiduesIn fNF poles := by
      rw [h_principalPart_integral]
      rw [RectangleIntegral',
        (holoPart_holomorphicOn f_mero f_simple_poles f_poles_finite).vanishesOnRectangle subset_rfl]
      simp
    _ = sumResiduesIn fNF poles := by simp
    _ = sumResiduesIn f poles := h_residue_congr.symm

lemma residue_eq_zero_of_not_pole_of_meromorphicAt {F : ℂ → ℂ} {s : ℂ}
    (hs_mero : MeromorphicAt F s) (hs_not_pole : 0 ≤ meromorphicOrderAt F s) :
    residue F s = 0 := by
  apply residue_eq_of_tendsto
  obtain ⟨c, hc⟩ := tendsto_nhds_of_meromorphicOrderAt_nonneg hs_mero hs_not_pole
  have hsub : Filter.Tendsto (fun z : ℂ ↦ z - s) (nhdsWithin s {s}ᶜ) (nhds 0) :=
    tendsto_sub_nhds_zero_iff.mpr (tendsto_id.mono_left nhdsWithin_le_nhds)
  simpa using hsub.mul hc

lemma sumResiduesIn_inter_eq_of_set_eq {F : ℂ → ℂ} {Rn S2 P : Set ℂ}
    (h_set_eq : Rn ∩ P = S2 ∩ P)
    (h_residue_zero : ∀ s ∈ S2, s ∉ P → residue F s = 0) :
    sumResiduesIn F (Rn ∩ P) = sumResiduesIn F S2 := by
  rw [sumResiduesIn, sumResiduesIn, tsum_subtype, tsum_subtype]
  apply tsum_congr
  intro s
  by_cases hs_S2 : s ∈ S2
  · by_cases hs_pole : s ∈ P
    · have hs_rect_pole : s ∈ Rn ∩ P := h_set_eq.symm ▸ ⟨hs_S2, hs_pole⟩
      simp [hs_S2, hs_rect_pole]
    · have hs_not_rect_pole : s ∉ Rn ∩ P := fun hs => hs_pole hs.2
      have hres0 : residue F s = 0 := h_residue_zero s hs_S2 hs_pole
      simp [hs_S2, hs_not_rect_pole, hres0]
  · have hs_not_rect_pole : s ∉ Rn ∩ P := fun hs => hs_S2 (h_set_eq ▸ hs).1
    simp [hs_S2, hs_not_rect_pole]
end

section

/-
# Continuous reciprocal-prime test functions

The fixed-interval reciprocal-prime limit from `MertensPositiveConstant` extends
here to every continuous real test function on a compact interval in `(0, ∞)`.
The proof uses uniform finite partitions and explicit sup-norm error bounds.
No prime number theorem, logarithmic product constant identification, or extra
analytic hypothesis is needed.
-/

namespace Bounty

open Finset Filter Real MeasureTheory
open scoped Topology

theorem prime_band_sum_add_adjacent {M : Type*} [AddCommMonoid M]
    (w : ℕ → M) {A B C : ℝ} (hAB : A ≤ B) (hBC : B ≤ C) :
    (∑ p ∈ primeBand A B, w p) + ∑ p ∈ primeBand B C, w p =
      ∑ p ∈ primeBand A C, w p := by
  classical
  have hu : primeBand A B ∪ primeBand B C = primeBand A C := by
    unfold primeBand
    rw [← filter_union, Ioc_union_Ioc_eq_Ioc (Nat.floor_mono hAB) (Nat.floor_mono hBC)]
  have hd : Disjoint (primeBand A B) (primeBand B C) := by
    exact (Ioc_disjoint_Ioc_of_le (a := ⌊A⌋₊) (d := ⌊C⌋₊) le_rfl).mono
      (filter_subset _ _) (filter_subset _ _)
  rw [← hu, sum_union hd]

theorem sum_prime_bands_adjacent {M : Type*} [AddCommMonoid M]
    (w : ℕ → M) (t : ℕ → ℝ) (ht : Monotone t) (N : ℕ) :
    (∑ i ∈ range N, ∑ p ∈ primeBand (t i) (t (i+1)), w p) =
      ∑ p ∈ primeBand (t 0) (t N), w p := by
  induction N with
  | zero => simp [primeBand]
  | succ N ih =>
    rw [sum_range_succ, ih]
    exact prime_band_sum_add_adjacent w (ht (Nat.zero_le N)) (ht (Nat.le_succ N))

theorem prime_log_coordinate_mem {a b L : ℝ} (hL : 0 < L)
    {p : ℕ} (hp : p ∈ primeBand (exp (a*L)) (exp (b*L))) :
    a < log (p : ℝ)/L ∧ log (p : ℝ)/L ≤ b := by
  obtain ⟨hprime, hlo, hhi⟩ :=
    (mem_primeBand_iff (exp_pos _).le (exp_pos _).le p).mp hp
  have hp0 : (0 : ℝ) < p := by exact_mod_cast hprime.pos
  constructor
  · apply (lt_div_iff₀ hL).mpr
    have h := log_lt_log (exp_pos _) hlo
    simpa only [log_exp] using h
  · apply (div_le_iff₀ hL).mpr
    have h := log_le_log hp0 hhi
    simpa only [log_exp] using h

theorem prime_band_weighted_sample_error (f : ℝ → ℝ)
    {a b L c η : ℝ} (hL : 0 < L)
    (hosc : ∀ t ∈ Set.Icc a b, |f t-c| ≤ η) :
    |(∑ p ∈ primeBand (exp (a*L)) (exp (b*L)), f (log (p : ℝ)/L)/(p : ℝ)) -
      c * primeBandHarmonic (exp (a*L)) (exp (b*L))| ≤
        η * primeBandHarmonic (exp (a*L)) (exp (b*L)) := by
  unfold primeBandHarmonic
  rw [mul_sum, ← sum_sub_distrib]
  calc
    _ ≤ ∑ p ∈ primeBand (exp (a*L)) (exp (b*L)),
        |f (log (p : ℝ)/L)/(p : ℝ)-c*(1/(p : ℝ))| := abs_sum_le_sum_abs _ _
    _ ≤ ∑ p ∈ primeBand (exp (a*L)) (exp (b*L)), η*(1/(p : ℝ)) := by
      apply sum_le_sum
      intro p hp
      have hcoord := prime_log_coordinate_mem hL hp
      have h := hosc _ ⟨hcoord.1.le, hcoord.2⟩
      rw [show f (log (p : ℝ)/L)/(p : ℝ)-c*(1/(p : ℝ)) =
        (f (log (p : ℝ)/L)-c)*(1/(p : ℝ)) by ring, abs_mul,
        abs_of_nonneg (by positivity : 0 ≤ 1/(p : ℝ))]
      exact mul_le_mul_of_nonneg_right h (by positivity)
    _ = _ := (mul_sum ..).symm

noncomputable def reciprocalGrid (a b : ℝ) (N i : ℕ) : ℝ :=
  a + (b-a)*(i : ℝ)/(N : ℝ)

theorem reciprocal_grid_zero (a b : ℝ) (N : ℕ) : reciprocalGrid a b N 0 = a := by
  simp [reciprocalGrid]

theorem reciprocal_grid_end (a b : ℝ) {N : ℕ} (hN : 0 < N) :
    reciprocalGrid a b N N = b := by
  have hNr : (N : ℝ) ≠ 0 := by exact_mod_cast hN.ne'
  simp [reciprocalGrid, hNr]

theorem reciprocal_grid_monotone {a b : ℝ} (hab : a ≤ b) (N : ℕ) :
    Monotone (reciprocalGrid a b N) := by
  intro i j hij
  unfold reciprocalGrid
  exact add_le_add le_rfl
    (div_le_div_of_nonneg_right
      (mul_le_mul_of_nonneg_left (Nat.cast_le.mpr hij) (sub_nonneg.mpr hab))
      (Nat.cast_nonneg N))

theorem reciprocal_grid_step (a b : ℝ) (N i : ℕ) :
    reciprocalGrid a b N (i+1)-reciprocalGrid a b N i = (b-a)/(N : ℝ) := by
  unfold reciprocalGrid
  push_cast
  ring

theorem reciprocal_grid_mem {a b : ℝ} (hab : a ≤ b) {N i : ℕ}
    (hN : 0 < N) (hi : i ≤ N) : reciprocalGrid a b N i ∈ Set.Icc a b := by
  have hm := reciprocal_grid_monotone hab N
  constructor
  · simpa only [reciprocal_grid_zero] using hm (Nat.zero_le i)
  · simpa only [reciprocal_grid_end a b hN] using hm hi

theorem exists_reciprocal_grid_oscillation {a b : ℝ} (hab : a < b)
    (f : ℝ → ℝ) (hf : ContinuousOn f (Set.Icc a b))
    {η : ℝ} (hη : 0 < η) :
    ∃ N : ℕ, 0 < N ∧ ∀ i : ℕ, i < N →
      ∀ x ∈ Set.Icc (reciprocalGrid a b N i) (reciprocalGrid a b N (i+1)),
        |f x-f (reciprocalGrid a b N i)| ≤ η := by
  have hu := isCompact_Icc.uniformContinuousOn_of_continuous hf
  obtain ⟨δ, hδ, hclose⟩ := Metric.uniformContinuousOn_iff_le.mp hu η hη
  obtain ⟨N, hN⟩ := exists_nat_gt ((b-a)/δ)
  have hN0 : 0 < N := by
    have hpos : (0 : ℝ) < N := (div_pos (sub_pos.mpr hab) hδ).trans hN
    exact_mod_cast hpos
  have hNr : (0 : ℝ) < N := by exact_mod_cast hN0
  have hstep : (b-a)/(N : ℝ) ≤ δ := by
    apply (div_le_iff₀ hNr).mpr
    have h := (div_lt_iff₀ hδ).mp hN
    nlinarith
  refine ⟨N, hN0, ?_⟩
  intro i hi x hx
  have hiN := reciprocal_grid_mem hab.le hN0 (Nat.le_of_lt hi)
  have hi1N := reciprocal_grid_mem hab.le hN0 (Nat.succ_le_of_lt hi)
  have hxmem : x ∈ Set.Icc a b := ⟨hiN.1.trans hx.1, hx.2.trans hi1N.2⟩
  have hd : dist x (reciprocalGrid a b N i) ≤ δ := by
    rw [Real.dist_eq, abs_of_nonneg (sub_nonneg.mpr hx.1)]
    calc
      _ ≤ reciprocalGrid a b N (i+1)-reciprocalGrid a b N i := sub_le_sub_right hx.2 _
      _ = (b-a)/(N : ℝ) := reciprocal_grid_step a b N i
      _ ≤ δ := hstep
  simpa only [Real.dist_eq] using hclose x hxmem _ hiN hd

theorem reciprocal_weight_interval_integrable (f : ℝ → ℝ)
    {u v : ℝ} (hu : 0 < u) (huv : u ≤ v)
    (hf : ContinuousOn f (Set.Icc u v)) :
    IntervalIntegrable (fun t => f t/t) volume u v := by
  apply ContinuousOn.intervalIntegrable
  rw [Set.uIcc_of_le huv]
  exact hf.div continuousOn_id (fun t ht => ne_of_gt (hu.trans_le ht.1))

theorem reciprocal_integral_sample_error (f : ℝ → ℝ)
    {a u v c η : ℝ} (ha : 0 < a) (hau : a ≤ u) (huv : u ≤ v)
    (hη : 0 ≤ η) (hf : ContinuousOn f (Set.Icc u v))
    (hosc : ∀ t ∈ Set.Icc u v, |f t-c| ≤ η) :
    |(∫ t in u..v, f t/t) - c*log (v/u)| ≤ (η/a)*(v-u) := by
  have hu : 0 < u := ha.trans_le hau
  have hv : 0 < v := hu.trans_le huv
  have hfint := reciprocal_weight_interval_integrable f hu huv hf
  have hcint := reciprocal_weight_interval_integrable (fun _ => c) hu huv continuousOn_const
  have hcval : (∫ t in u..v, c/t) = c*log (v/u) := by
    simp only [div_eq_mul_inv]
    rw [intervalIntegral.integral_const_mul, integral_inv_of_pos hu hv]
    simp only [div_eq_mul_inv]
  rw [← hcval, ← intervalIntegral.integral_sub hfint hcint]
  have hnorm := intervalIntegral.norm_integral_le_of_norm_le_const
    (a := u) (b := v) (C := η/a) (f := fun t => f t/t-c/t) (by
      intro t ht
      rw [Set.uIoc_of_le huv] at ht
      have ht0 : 0 < t := hu.trans ht.1
      rw [Real.norm_eq_abs, ← sub_div, abs_div, abs_of_pos ht0]
      exact (div_le_div_of_nonneg_right (hosc t ⟨ht.1.le, ht.2⟩) ht0.le).trans
        (div_le_div_of_nonneg_left hη ha (hau.trans ht.1.le)))
  simpa only [Real.norm_eq_abs, abs_of_nonneg (sub_nonneg.mpr huv)] using hnorm

theorem reciprocal_grid_prime_approximation (f : ℝ → ℝ)
    {a b L η : ℝ} (hab : a ≤ b) (hL : 0 < L) {N : ℕ} (hN : 0 < N)
    (hosc : ∀ i : ℕ, i < N →
      ∀ x ∈ Set.Icc (reciprocalGrid a b N i) (reciprocalGrid a b N (i+1)),
        |f x-f (reciprocalGrid a b N i)| ≤ η) :
    |(∑ p ∈ primeBand (exp (a*L)) (exp (b*L)), f (log (p : ℝ)/L)/(p : ℝ)) -
      ∑ i ∈ range N, f (reciprocalGrid a b N i) *
        primeBandHarmonic (exp (reciprocalGrid a b N i*L))
          (exp (reciprocalGrid a b N (i+1)*L))| ≤
        η * primeBandHarmonic (exp (a*L)) (exp (b*L)) := by
  have hm : Monotone (fun i => exp (reciprocalGrid a b N i*L)) := by
    intro i j hij
    exact exp_le_exp.mpr
      (mul_le_mul_of_nonneg_right (reciprocal_grid_monotone hab N hij) hL.le)
  have hsplit (w : ℕ → ℝ) :
      (∑ i ∈ range N, ∑ p ∈ primeBand (exp (reciprocalGrid a b N i*L))
        (exp (reciprocalGrid a b N (i+1)*L)), w p) =
          ∑ p ∈ primeBand (exp (a*L)) (exp (b*L)), w p := by
    simpa only [reciprocal_grid_zero, reciprocal_grid_end a b hN] using
      sum_prime_bands_adjacent w _ hm N
  rw [← hsplit (fun p => f (log (p : ℝ)/L)/(p : ℝ)), ← sum_sub_distrib]
  calc
    _ ≤ ∑ i ∈ range N, |(∑ p ∈ primeBand (exp (reciprocalGrid a b N i*L))
        (exp (reciprocalGrid a b N (i+1)*L)), f (log (p : ℝ)/L)/(p : ℝ)) -
      f (reciprocalGrid a b N i) *
        primeBandHarmonic (exp (reciprocalGrid a b N i*L))
          (exp (reciprocalGrid a b N (i+1)*L))| := abs_sum_le_sum_abs _ _
    _ ≤ ∑ i ∈ range N, η *
        primeBandHarmonic (exp (reciprocalGrid a b N i*L))
          (exp (reciprocalGrid a b N (i+1)*L)) := by
      apply sum_le_sum
      intro i hi
      exact prime_band_weighted_sample_error f hL (hosc i (mem_range.mp hi))
    _ = _ := by
      rw [← mul_sum]
      congr 1
      exact hsplit (fun p => 1/(p : ℝ))

theorem sum_range_adjacent_real_difference (t : ℕ → ℝ) (N : ℕ) :
    (∑ i ∈ range N, (t (i+1)-t i)) = t N-t 0 := by
  induction N with
  | zero => simp
  | succ N ih => rw [sum_range_succ, ih]; ring

theorem reciprocal_grid_integral_approximation (f : ℝ → ℝ)
    {a b η : ℝ} (ha : 0 < a) (hab : a ≤ b) (hη : 0 ≤ η)
    (hf : ContinuousOn f (Set.Icc a b)) {N : ℕ} (hN : 0 < N)
    (hosc : ∀ i : ℕ, i < N →
      ∀ x ∈ Set.Icc (reciprocalGrid a b N i) (reciprocalGrid a b N (i+1)),
        |f x-f (reciprocalGrid a b N i)| ≤ η) :
    |(∫ t in a..b, f t/t) -
      ∑ i ∈ range N, f (reciprocalGrid a b N i) *
        log (reciprocalGrid a b N (i+1)/reciprocalGrid a b N i)| ≤
      (η/a)*(b-a) := by
  have hm := reciprocal_grid_monotone hab N
  have hcell (i : ℕ) (hi : i < N) :
      ContinuousOn f (Set.Icc (reciprocalGrid a b N i) (reciprocalGrid a b N (i+1))) := by
    apply hf.mono
    intro x hx
    exact ⟨(reciprocal_grid_mem hab hN hi.le).1.trans hx.1,
      hx.2.trans (reciprocal_grid_mem hab hN (Nat.succ_le_of_lt hi)).2⟩
  have hint (i : ℕ) (hi : i < N) :
      IntervalIntegrable (fun t => f t/t) volume
        (reciprocalGrid a b N i) (reciprocalGrid a b N (i+1)) := by
    exact reciprocal_weight_interval_integrable f
      (ha.trans_le (reciprocal_grid_mem hab hN hi.le).1)
      (hm (Nat.le_succ i)) (hcell i hi)
  have hsplit : (∑ i ∈ range N, ∫ t in reciprocalGrid a b N i..
      reciprocalGrid a b N (i+1), f t/t) = ∫ t in a..b, f t/t := by
    simpa only [reciprocal_grid_zero, reciprocal_grid_end a b hN] using
      intervalIntegral.sum_integral_adjacent_intervals hint
  rw [← hsplit, ← sum_sub_distrib]
  calc
    _ ≤ ∑ i ∈ range N, |(∫ t in reciprocalGrid a b N i..
        reciprocalGrid a b N (i+1), f t/t) -
      f (reciprocalGrid a b N i) *
        log (reciprocalGrid a b N (i+1)/reciprocalGrid a b N i)| := abs_sum_le_sum_abs _ _
    _ ≤ ∑ i ∈ range N, (η/a)*(reciprocalGrid a b N (i+1)-reciprocalGrid a b N i) := by
      apply sum_le_sum
      intro i hi
      exact reciprocal_integral_sample_error f ha
        (reciprocal_grid_mem hab hN (mem_range.mp hi).le).1
        (hm (Nat.le_succ i)) hη (hcell i (mem_range.mp hi)) (hosc i (mem_range.mp hi))
    _ = _ := by
      rw [← mul_sum, sum_range_adjacent_real_difference, reciprocal_grid_zero,
        reciprocal_grid_end a b hN]

theorem reciprocal_grid_sample_tendsto (f : ℝ → ℝ)
    {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) {N : ℕ} (hN : 0 < N) :
    Tendsto
      (fun L : ℝ => ∑ i ∈ range N, f (reciprocalGrid a b N i) *
        primeBandHarmonic (exp (reciprocalGrid a b N i*L))
          (exp (reciprocalGrid a b N (i+1)*L))) atTop
      (nhds (∑ i ∈ range N, f (reciprocalGrid a b N i) *
        log (reciprocalGrid a b N (i+1)/reciprocalGrid a b N i))) := by
  apply tendsto_finsetSum
  intro i hi
  exact (exponential_prime_band_harmonic_tendsto
    (ha.trans_le (reciprocal_grid_mem hab hN (mem_range.mp hi).le).1)
    (reciprocal_grid_monotone hab N (Nat.le_succ i))).const_mul _

theorem exponential_prime_weighted_reciprocal_tendsto
    {a b : ℝ} (ha : 0 < a) (hab : a < b) (f : ℝ → ℝ)
    (hf : ContinuousOn f (Set.Icc a b)) :
    Tendsto
      (fun L : ℝ => ∑ p ∈ primeBand (exp (a*L)) (exp (b*L)),
        f (log (p : ℝ)/L)/(p : ℝ)) atTop
      (nhds (∫ t in a..b, f t/t)) := by
  rw [Metric.tendsto_nhds]
  intro ε hε
  let B : ℝ := (|log (b/a)|+1)+(b-a)/a+1
  have hB : 0 < B := by
    dsimp [B]
    positivity
  let η : ℝ := ε/(4*B)
  have hη : 0 < η := by dsimp [η]; positivity
  obtain ⟨N, hN, hosc⟩ := exists_reciprocal_grid_oscillation hab f hf hη
  let A : ℝ → ℝ := fun L => ∑ i ∈ range N, f (reciprocalGrid a b N i) *
    primeBandHarmonic (exp (reciprocalGrid a b N i*L))
      (exp (reciprocalGrid a b N (i+1)*L))
  let J : ℝ := ∑ i ∈ range N, f (reciprocalGrid a b N i) *
    log (reciprocalGrid a b N (i+1)/reciprocalGrid a b N i)
  have hA : Tendsto A atTop (nhds J) :=
    reciprocal_grid_sample_tendsto f ha hab.le hN
  have hmass := (exponential_prime_band_harmonic_tendsto ha hab.le).eventually_lt_const
    (show log (b/a) < |log (b/a)|+1 by linarith [le_abs_self (log (b/a))])
  have hsamp := Metric.tendsto_nhds.mp hA (ε/2) (by positivity)
  have hint : |(∫ t in a..b, f t/t)-J| ≤ (η/a)*(b-a) :=
    reciprocal_grid_integral_approximation f ha hab.le hη.le hf hN hosc
  have hbudget : η*(|log (b/a)|+1)+(η/a)*(b-a) ≤ ε/4 := by
    have heq : η*B = ε/4 := by dsimp [η]; field_simp
    calc
      _ = η*(B-1) := by dsimp [B]; ring
      _ ≤ η*B := mul_le_mul_of_nonneg_left (by linarith) hη.le
      _ = ε/4 := heq
  filter_upwards [eventually_gt_atTop (0 : ℝ), hmass, hsamp] with L hL hm hs
  rw [Real.dist_eq] at hs ⊢
  have hp : |(∑ p ∈ primeBand (exp (a*L)) (exp (b*L)),
      f (log (p : ℝ)/L)/(p : ℝ))-A L| ≤ η*(|log (b/a)|+1) := by
    exact (reciprocal_grid_prime_approximation f hab.le hL hN hosc).trans
      (mul_le_mul_of_nonneg_left hm.le hη.le)
  have hi : |J-(∫ t in a..b, f t/t)| ≤ (η/a)*(b-a) := by
    simpa only [abs_sub_comm] using hint
  have htri := abs_sub_le (∑ p ∈ primeBand (exp (a*L)) (exp (b*L)),
    f (log (p : ℝ)/L)/(p : ℝ)) (A L) (∫ t in a..b, f t/t)
  have htri' := abs_sub_le (A L) J (∫ t in a..b, f t/t)
  linarith

end Bounty

/- Public declaration closure audit. -/
end

section

/- Joint continuity of finite-depth and stable Buchstab densities. -/

open Filter
open scoped Topology

namespace Bounty

theorem buchstab_depth_density_continuous (n : ℕ) :
    ContinuousOn (fun p : ℝ × ℝ => buchstabDepthDensity n p.1 p.2)
      {p | 0 < p.1 ∧ 0 < p.2} := by
  let P := {p : ℝ × ℝ // 0 < p.1 ∧ 0 < p.2}
  suffices h : Continuous (fun p : P => buchstabDepthDensity n p.val.1 p.val.2) from
    continuousOn_iff_continuous_domRestrict.mpr h
  induction n with
  | zero =>
    exact continuous_const.div (continuous_subtype_val.snd) (fun p => p.property.2.ne')
  | succ n ih =>
    let f : P → ℝ → ℝ := fun p t =>
      buchstabDepthDensity n (max p.val.1 t) (max (p.val.2/2) (p.val.2-t)) / max p.val.1 t
    let g : P × ℝ → P := fun q => ⟨(max q.1.val.1 q.2, max (q.1.val.2/2) (q.1.val.2-q.2)),
      lt_of_lt_of_le q.1.property.1 (le_max_left _ _),
      lt_of_lt_of_le (half_pos q.1.property.2) (le_max_left _ _)⟩
    have hg : Continuous g := by dsimp only [g, P]; fun_prop
    have hnum := ih.comp hg
    have hf : Continuous f.uncurry := by
      exact hnum.div (by dsimp only [P]; fun_prop) (fun q =>
        (lt_of_lt_of_le q.1.property.1 (le_max_left _ _)).ne')
    have hhi : Continuous (fun p : P => ∫ t in (0 : ℝ)..max p.val.1 (p.val.2/2), f p t) :=
      intervalIntegral.continuous_parametric_intervalIntegral_of_continuous hf (by fun_prop)
    have hlo : Continuous (fun p : P => ∫ t in (0 : ℝ)..p.val.1, f p t) :=
      intervalIntegral.continuous_parametric_intervalIntegral_of_continuous hf (by fun_prop)
    have hrecip : Continuous (fun p : P => 1/p.val.2) :=
      continuous_const.div (continuous_subtype_val.snd) (fun p : P => p.property.2.ne')
    have hall := hrecip.add (hhi.sub hlo)
    apply hall.congr
    intro p
    dsimp only [Pi.add_apply, Pi.sub_apply]
    rw [intervalIntegral.integral_interval_sub_left
      ((hf.uncurry_left p).intervalIntegrable _ _)
      ((hf.uncurry_left p).intervalIntegrable _ _)]
    change 1/p.val.2 + (∫ t in p.val.1..max p.val.1 (p.val.2/2), f p t) =
      1/p.val.2 + (∫ t in p.val.1..max p.val.1 (p.val.2/2),
        buchstabDepthDensity n t (p.val.2-t)/t)
    congr 1
    by_cases hhalf : p.val.2/2 ≤ p.val.1
    · simp only [max_eq_left hhalf, intervalIntegral.integral_same]
    · have hhalf' : p.val.1 ≤ p.val.2/2 := (lt_of_not_ge hhalf).le
      rw [max_eq_right hhalf']
      apply intervalIntegral.integral_congr
      intro t ht
      have htb := Set.mem_Icc.mp (by simpa only [Set.uIcc_of_le hhalf'] using ht)
      have htlast : p.val.2/2 ≤ p.val.2-t := by linarith [htb.2]
      simp only [f, max_eq_right htb.1, max_eq_right htlast]

theorem buchstab_density_continuous :
    ContinuousOn (fun p : ℝ × ℝ => buchstabDensity p.1 p.2)
      {p | 0 < p.1 ∧ 0 < p.2} := by
  have hU : IsOpen {p : ℝ × ℝ | 0 < p.1 ∧ 0 < p.2} :=
    (isOpen_lt continuous_const continuous_fst).inter (isOpen_lt continuous_const continuous_snd)
  apply hU.continuousOn_iff.mpr
  intro p hp
  let n := ⌊p.2/p.1⌋₊+1
  have hn : p.2 < ((n : ℝ)+2)*p.1 := by
    have hb := buchstab_density_depth_bound (w := p.2) hp.1
    dsimp [n]
    push_cast
    nlinarith [hp.1]
  have hV : IsOpen {q : ℝ × ℝ | 0 < q.1 ∧ q.2 < ((n : ℝ)+2)*q.1} :=
    (isOpen_lt continuous_const continuous_fst).inter
      (isOpen_lt continuous_snd (continuous_const.mul continuous_fst))
  have hloc : ∀ᶠ q : ℝ × ℝ in 𝓝 p, 0 < q.1 ∧ q.2 < ((n : ℝ)+2)*q.1 :=
    hV.mem_nhds ⟨hp.1, hn⟩
  have hc := (buchstab_depth_density_continuous n).continuousAt (hU.mem_nhds hp)
  apply hc.congr
  filter_upwards [hloc] with q hq
  exact buchstab_depth_density_eq_density hq.1 n hq.2.le

end Bounty
end

section

/- Pointwise domination keeps an arbitrary event mask while removing a
bounded complex coefficient. Nonnegative event weights are retained. -/

open Finset
open scoped Classical

namespace Bounty

theorem finite_masked_event_norm_le_positive_re {E : Type*} [Fintype E]
    (w : E → ℝ) (hw : ∀ e, 0 ≤ w e) (mask : E → Prop)
    (phase f : E → ℂ) (hphase : ∀ e, ‖phase e‖ ≤ 1) :
    ‖∑ e, (w e : ℂ) * (if mask e then phase e else 0) * f e‖ ≤
      (∑ e, (w e : ℂ) * (if mask e then 1 else 0) * (‖f e‖ : ℂ)).re := by
  have he : (∑ e, (w e : ℂ) * (if mask e then 1 else 0) * (‖f e‖ : ℂ)).re =
      ∑ e, if mask e then w e * ‖f e‖ else 0 := by
    rw [Complex.re_sum]
    apply sum_congr rfl
    intro e _
    split_ifs <;> simp
  rw [he]
  apply (norm_sum_le _ _).trans
  apply sum_le_sum
  intro e _
  by_cases hm : mask e
  · simp only [if_pos hm, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hw e)]
    exact (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (hphase e) (hw e))
      (norm_nonneg (f e))).trans_eq (by rw [mul_one])
  · simp only [if_neg hm, mul_zero, zero_mul, norm_zero, le_refl]

theorem finite_weighted_energy_add_le_two {X : Type*} [Fintype X]
    (w : X → ℝ) (hw : ∀ x, 0 ≤ w x) (f g : X → ℂ) :
    finiteWeightedEnergy w (fun x => f x + g x) ≤
      2 * (finiteWeightedEnergy w f + finiteWeightedEnergy w g) := by
  calc
    _ ≤ ∑ x, w x * (2 * (‖f x‖ ^ 2 + ‖g x‖ ^ 2)) := by
      apply sum_le_sum
      intro x _
      apply mul_le_mul_of_nonneg_left _ (hw x)
      have hnorm := (sq_le_sq₀ (norm_nonneg (f x + g x))
        (add_nonneg (norm_nonneg (f x)) (norm_nonneg (g x)))).mpr (norm_add_le (f x) (g x))
      nlinarith [sq_nonneg (‖f x‖ - ‖g x‖)]
    _ = _ := by
      simp only [finiteWeightedEnergy, mul_add, mul_sum]
      rw [← sum_add_distrib]
      apply sum_congr rfl
      intro x _
      ring

theorem finite_external_energy_domination_add {X R : Type*} [Fintype X] [Fintype R]
    (w : X → ℝ) (hw : ∀ x, 0 ≤ w x) (f F P S : X → R → ℂ) (K : ℝ)
    (hdom : ∀ x r, ‖F x r‖ ≤ ‖P x r + S x r‖)
    (hP : (∑ r, finiteWeightedEnergy w (fun x => P x r)) ≤
      K * ∑ r, finiteWeightedEnergy w (fun x => f x r))
    (hS : (∑ r, finiteWeightedEnergy w (fun x => S x r)) ≤
      K * ∑ r, finiteWeightedEnergy w (fun x => f x r)) :
    (∑ r, finiteWeightedEnergy w (fun x => F x r)) ≤
      4 * K * ∑ r, finiteWeightedEnergy w (fun x => f x r) := by
  calc
    _ ≤ ∑ r, 2 * (finiteWeightedEnergy w (fun x => P x r) +
        finiteWeightedEnergy w (fun x => S x r)) := by
      apply sum_le_sum
      intro r _
      exact (finiteWeightedEnergy_le_of_norm_le w hw _ _ (fun x => hdom x r)).trans
        (finite_weighted_energy_add_le_two w hw _ _)
    _ = 2 * ((∑ r, finiteWeightedEnergy w (fun x => P x r)) +
        ∑ r, finiteWeightedEnergy w (fun x => S x r)) := by
      rw [← mul_sum, sum_add_distrib]
    _ ≤ 2 * ((K * ∑ r, finiteWeightedEnergy w (fun x => f x r)) +
        K * ∑ r, finiteWeightedEnergy w (fun x => f x r)) :=
      mul_le_mul_of_nonneg_left (add_le_add hP hS) (by norm_num)
    _ = _ := by ring

end Bounty
end

section

/- Read-only history observables on the existing dependent paths, without enlarging their state space. -/

namespace Bounty

universe u v w z

section History
variable {K : Type u} {X : Type v} {H : Type z} (E : K → X → Type w)
    (target : ∀ k x, E k x → X)
    (update : ∀ (_t : ℕ) k x, E k x → H → H)

def finiteEventPathHistoryAt : ∀ (_t : ℕ) (steps : List K) (x : X),
    FiniteEventPath E target steps x → H → ℕ → H
  | _, _, _, _, h, 0 => h
  | _, [], _, _, h, _ + 1 => h
  | t, k :: ks, x, ⟨e, p⟩, h, i + 1 =>
      finiteEventPathHistoryAt (t + 1) ks (target k x e) p (update t k x e h) i

theorem finite_event_path_history_at_zero (t : ℕ) (steps : List K) (x : X)
    (p : FiniteEventPath E target steps x) (h : H) :
    finiteEventPathHistoryAt E target update t steps x p h 0 = h := rfl

theorem finite_event_path_history_at_succ (t : ℕ) (steps : List K) (x : X)
    (p : FiniteEventPath E target steps x) (h : H) (i : Fin steps.length) :
    finiteEventPathHistoryAt E target update t steps x p h (i.val + 1) =
      let e := finiteEventPathOccurrence E target steps x p i
      update (t + i.val) (steps.get i) e.1 e.2
        (finiteEventPathHistoryAt E target update t steps x p h i.val) := by
  induction steps generalizing t x h with
  | nil => exact Fin.elim0 i
  | cons k ks ih =>
    rcases p with ⟨e, p⟩
    refine Fin.cases ?_ (fun j => ?_) i
    · rfl
    · change finiteEventPathHistoryAt E target update (t + 1) ks (target k x e) p
        (update t k x e h) (j.val + 1) =
        update (t + (j.val + 1)) (ks.get j)
          (finiteEventPathOccurrence E target ks (target k x e) p j).1
          (finiteEventPathOccurrence E target ks (target k x e) p j).2
          (finiteEventPathHistoryAt E target update (t + 1) ks (target k x e) p
            (update t k x e h) j.val)
      simpa only [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm]
        using ih (t + 1) (target k x e) p (update t k x e h) j

end History
end Bounty
end

section

/- Cartesian selected data split by physical groups; the cut sequence stays fixed. -/

open scoped Classical
namespace Bounty

abbrev PhysicalGroupSelectedData {G : Type*} {J n : ℕ} (P : G → Finset ℕ) (ell : ℕ)
    (C : Fin n → G → Finset (Fin J)) :=
  (∀ j, PhysicalAuxLabels P (C j)) × (Fin (n + 1) → PhysicalMarkLists P J ell) ×
    (Fin n → PhysicalPermutations G J ell) × (Fin n → PhysicalPermutations G J ell)

def pairedSequenceEquiv {A : Type*} {B C : A → Type*} :
    (∀ a, B a × C a) ≃ (∀ a, B a) × (∀ a, C a) where
  toFun f := (fun a => (f a).1, fun a => (f a).2)
  invFun f a := (f.1 a, f.2 a)
  left_inv f := by funext a; exact Prod.eta (f a)
  right_inv f := rfl

noncomputable def physicalGroupSelectedSplit
    {G : Type*} {P : G → Finset ℕ} {J ell n : ℕ}
    (small : G → Prop) (C : Fin n → G → Finset (Fin J)) :
    PhysicalGroupSelectedData P ell C ≃
      PhysicalGroupSelectedData (fun g : {g // small g} => P g.val) ell
        (fun j g => C j g.val) ×
      PhysicalGroupSelectedData (fun g : {g // ¬small g} => P g.val) ell
        (fun j g => C j g.val) :=
  (Equiv.prodCongr
    ((Equiv.piCongrRight fun j => physicalAuxGroupSplit small P J (C j)).trans pairedSequenceEquiv)
    (Equiv.prodCongr
      ((Equiv.piCongrRight fun _ : Fin (n + 1) => physicalMarkGroupSplit small P J ell).trans pairedSequenceEquiv)
      (Equiv.prodCongr
        ((Equiv.piCongrRight fun _ : Fin n => physicalPermutationGroupSplit small J ell).trans pairedSequenceEquiv)
        ((Equiv.piCongrRight fun _ : Fin n => physicalPermutationGroupSplit small J ell).trans pairedSequenceEquiv)))).trans
  { toFun := fun x =>
      ((x.1.1, x.2.1.1, x.2.2.1.1, x.2.2.2.1),
        (x.1.2, x.2.1.2, x.2.2.1.2, x.2.2.2.2))
    invFun := fun x =>
      ((x.1.1, x.2.1), (x.1.2.1, x.2.2.1),
        (x.1.2.2.1, x.2.2.2.1), (x.1.2.2.2, x.2.2.2.2))
    left_inv := by rintro ⟨⟨_, _⟩, ⟨_, _⟩, ⟨_, _⟩, ⟨_, _⟩⟩; rfl
    right_inv := by rintro ⟨⟨_, _, _, _⟩, ⟨_, _, _, _⟩⟩; rfl }

theorem physical_group_selected_split_small
    {G : Type*} {P : G → Finset ℕ} {J ell n : ℕ}
    (small : G → Prop) (C : Fin n → G → Finset (Fin J))
    (d : PhysicalGroupSelectedData P ell C) :
    (physicalGroupSelectedSplit small C d).1 =
      ((fun j (g : {g : G // small g}) => d.1 j g.val), (fun j (g : {g : G // small g}) => d.2.1 j g.val),
        (fun j (g : {g : G // small g}) => d.2.2.1 j g.val), (fun j (g : {g : G // small g}) => d.2.2.2 j g.val)) := rfl

theorem physical_group_selected_split_big
    {G : Type*} {P : G → Finset ℕ} {J ell n : ℕ}
    (small : G → Prop) (C : Fin n → G → Finset (Fin J))
    (d : PhysicalGroupSelectedData P ell C) :
    (physicalGroupSelectedSplit small C d).2 =
      ((fun j (g : {g : G // ¬small g}) => d.1 j g.val), (fun j (g : {g : G // ¬small g}) => d.2.1 j g.val),
        (fun j (g : {g : G // ¬small g}) => d.2.2.1 j g.val), (fun j (g : {g : G // ¬small g}) => d.2.2.2 j g.val)) := rfl

end Bounty
end

section

/- Exact endpoint energy in the original physical counting measure. -/

open scoped BigOperators InnerProductSpace

namespace Bounty

theorem physical_damping_square {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (J ell : ℕ) {q : ℝ} (hq : 0 ≤ q) (n : ℤ) :
    physicalDamping P J ell q n ^ 2 =
      ∏ g, q ^ (physicalOmega P g n - (J + ell)) := by
  unfold physicalDamping
  rw [← Finset.prod_pow]
  apply Finset.prod_congr rfl
  intro g _
  rw [← Real.rpow_natCast q (physicalOmega P g n - (J + ell)),
    ← Real.rpow_natCast _ 2, ← Real.rpow_mul hq]
  congr 1
  norm_num

theorem physical_fiber_damped_mass {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (V : G → ℝ) (J ell : ℕ) {q : ℝ} (hq : 0 ≤ q) (n : ℤ) :
    physicalStateMass V J ell * (Nat.card (PhysicalMarksAt P J ell n) : ℝ) *
      physicalDamping P J ell q n ^ 2 =
      uniformMarkedDivisorWeight Finset.univ P q V (J + ell) n := by
  classical
  rw [physical_marks_fiber_card, Nat.cast_prod,
    physical_damping_square P J ell hq]
  unfold physicalStateMass uniformMarkedDivisorWeight markedDivisorWeight markedDivisorFactor
  rw [← Finset.prod_mul_distrib, ← Finset.prod_mul_distrib]
  apply Finset.prod_congr rfl
  intro g _
  ring

noncomputable def physicalEndpointVector {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (V : G → ℝ) (J ell : ℕ) (q : ℝ)
    (positions : Finset ℤ) (f : ℤ → ℂ) :
    EuclideanSpace ℂ (physicalCutoff P J ell positions) :=
  finitePositionVector (fun x : physicalCutoff P J ell positions => x.val.1)
    (physicalStateMass V J ell) (fun n => f n * (physicalDamping P J ell q n : ℂ))

theorem physical_endpoint_vector_norm_sq {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (J ell : ℕ) {q : ℝ} (hq : 0 ≤ q) (positions : Finset ℤ) (f : ℤ → ℂ) :
    ‖physicalEndpointVector P V J ell q positions f‖ ^ 2 =
      ∑ n ∈ positions, uniformMarkedDivisorWeight Finset.univ P q V (J + ell) n *
        ‖f n‖ ^ 2 := by
  classical
  rw [physicalEndpointVector, finite_position_vector_norm_sq _
    (physical_state_mass_pos V hV J ell).le]
  have hs := Finset.sum_coe_sort (physicalCutoff P J ell positions)
    (fun x : PhysicalState P J ell => ‖f x.1 * (physicalDamping P J ell q x.1 : ℂ)‖ ^ 2)
  rw [hs, physical_cutoff_sum, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro n _
  have hd : 0 ≤ physicalDamping P J ell q n :=
    Finset.prod_nonneg (fun g _ => Real.rpow_nonneg hq _)
  simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul,
    norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hd, mul_pow]
  calc
    _ = (physicalStateMass V J ell * (Fintype.card (PhysicalMarksAt P J ell n) : ℝ) *
        physicalDamping P J ell q n ^ 2) * ‖f n‖ ^ 2 := by ring
    _ = _ := by rw [← Nat.card_eq_fintype_card, physical_fiber_damped_mass P V J ell hq]

theorem physical_endpoint_vector_fiber_sum {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (V : G → ℝ) (J ell : ℕ) (q : ℝ)
    (positions starts : Finset ℤ) (f : ℤ → ℂ)
    (hf : ∀ n ∈ positions, n ∉ starts → f n = 0) :
    physicalEndpointVector P V J ell q positions f =
      ∑ n ∈ starts, (f n * (physicalDamping P J ell q n : ℂ)) •
        finiteFiberVector (fun x : physicalCutoff P J ell positions => x.val.1)
          (physicalStateMass V J ell) n := by
  apply finite_position_vector_fiber_sum
  intro x hx
  rw [hf x.val.1 ((mem_physical_cutoff P J ell positions x.val).mp x.property) hx, zero_mul]

end Bounty
end

section

/- Mark-independent endpoint tests remove the two slot averages exactly. -/

open scoped BigOperators InnerProductSpace

namespace Bounty

theorem physical_symmetrize_position_sum {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (J ell : ℕ) (positions : Finset ℤ)
    (f : ℤ → ℂ) (h : PhysicalState P J ell → ℂ) :
    (∑ x ∈ physicalCutoff P J ell positions, f x.1 * physicalSymmetrize h x) =
      ∑ x ∈ physicalCutoff P J ell positions, f x.1 * h x := by
  classical
  let N : ℂ := Fintype.card (PhysicalPermutations G J ell)
  have hN : N ≠ 0 := by dsimp [N]; exact_mod_cast Fintype.card_ne_zero
  calc
    _ = N⁻¹ * ∑ σ : PhysicalPermutations G J ell,
        ∑ x ∈ physicalCutoff P J ell positions, f x.1 * h (physicalPermutationEquiv σ x) := by
      unfold physicalSymmetrize
      change (∑ x ∈ physicalCutoff P J ell positions, f x.1 *
        (N⁻¹ * ∑ σ : PhysicalPermutations G J ell, h (physicalPermutationEquiv σ x))) = _
      simp only [Finset.mul_sum]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro σ _
      apply Finset.sum_congr rfl
      intro x _
      ring
    _ = N⁻¹ * ∑ _σ : PhysicalPermutations G J ell,
        ∑ x ∈ physicalCutoff P J ell positions, f x.1 * h x := by
      congr 1
      apply Finset.sum_congr rfl
      intro σ _
      exact physical_permutation_sum P J ell positions σ (fun x => f x.1 * h x)
    _ = _ := by
      simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
      change N⁻¹ * (N * _) = _
      rw [← mul_assoc, inv_mul_cancel₀ hN, one_mul]

theorem physical_position_symmetric_pairing {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (J ell : ℕ) (positions : Finset ℤ)
    (K : PhysicalState P J ell → PhysicalState P J ell → ℂ) (f g : ℤ → ℂ) :
    (∑ x ∈ physicalCutoff P J ell positions, ∑ y ∈ physicalCutoff P J ell positions,
      f x.1 * physicalSymmetricKernel K x y * g y.1) =
      ∑ x ∈ physicalCutoff P J ell positions, ∑ y ∈ physicalCutoff P J ell positions,
        f x.1 * K x y * g y.1 := by
  classical
  rw [Finset.sum_comm]
  calc
    _ = ∑ y ∈ physicalCutoff P J ell positions,
        (∑ x ∈ physicalCutoff P J ell positions, f x.1 * physicalSymmetrize (K x) y) * g y.1 := by
      apply Finset.sum_congr rfl
      intro y _
      rw [← Finset.sum_mul]
      congr 1
      exact physical_symmetrize_position_sum P J ell positions f
        (fun x => physicalSymmetrize (K x) y)
    _ = ∑ x ∈ physicalCutoff P J ell positions,
        f x.1 * ∑ y ∈ physicalCutoff P J ell positions, g y.1 * physicalSymmetrize (K x) y := by
      simp only [Finset.sum_mul, Finset.mul_sum]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro x _
      apply Finset.sum_congr rfl
      intro y _
      ring
    _ = ∑ x ∈ physicalCutoff P J ell positions,
        f x.1 * ∑ y ∈ physicalCutoff P J ell positions, g y.1 * K x y := by
      simp only [physical_symmetrize_position_sum]
    _ = _ := by
      simp only [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro x _
      apply Finset.sum_congr rfl
      intro y _
      ring

theorem physical_position_kernel_pairing {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (J ell : ℕ) (positions : Finset ℤ)
    (K : PhysicalState P J ell → PhysicalState P J ell → ℂ) (f g : ℤ → ℂ) :
    inner ℂ
      (finitePositionVector (fun x : physicalCutoff P J ell positions => x.val.1)
        (physicalStateMass V J ell) f)
      (finiteKernelOperator (fun x y : physicalCutoff P J ell positions =>
        physicalSymmetricKernel K x.val y.val)
        (finitePositionVector (fun x : physicalCutoff P J ell positions => x.val.1)
          (physicalStateMass V J ell) g)) =
      (physicalStateMass V J ell : ℂ) *
        ∑ x ∈ physicalCutoff P J ell positions, ∑ y ∈ physicalCutoff P J ell positions,
          (starRingEnd ℂ) (f x.1) * K x y * g y.1 := by
  rw [finite_position_vector_kernel_pairing _ (physical_state_mass_pos V hV J ell).le]
  congr 1
  calc
    _ = ∑ x : physicalCutoff P J ell positions,
        ∑ y ∈ physicalCutoff P J ell positions,
          (starRingEnd ℂ) (f x.val.1) * physicalSymmetricKernel K x.val y * g y.1 := by
      apply Finset.sum_congr rfl
      intro x _
      exact Finset.sum_coe_sort (physicalCutoff P J ell positions)
        (fun y : PhysicalState P J ell =>
          (starRingEnd ℂ) (f x.val.1) * physicalSymmetricKernel K x.val y * g y.1)
    _ = ∑ x ∈ physicalCutoff P J ell positions,
        ∑ y ∈ physicalCutoff P J ell positions,
          (starRingEnd ℂ) (f x.1) * physicalSymmetricKernel K x y * g y.1 :=
      Finset.sum_coe_sort (physicalCutoff P J ell positions)
        (fun x : PhysicalState P J ell => ∑ y ∈ physicalCutoff P J ell positions,
          (starRingEnd ℂ) (f x.1) * physicalSymmetricKernel K x y * g y.1)
    _ = _ := physical_position_symmetric_pairing P J ell positions K
      (fun n => (starRingEnd ℂ) (f n)) g

end Bounty
end

section

/- Congruence, signed quotient reconstruction, and uniqueness of both variables. -/

namespace Bounty

theorem typeII_signed_modulus_dvd (k a : ℤ) : 2 * |k| ∣ a ↔ 2 * k ∣ a := by
  have habs : |2 * k| = 2 * |k| := by rw [abs_mul]; norm_num
  rw [← habs, abs_dvd]

theorem typeII_determinant_congruence {m m' e k : ℤ}
    (he : m' - m = 2 * e * k) :
    Int.ModEq (2 * |k|) m m' := by
  apply Int.modEq_iff_dvd.mpr
  apply (typeII_signed_modulus_dvd k _).mpr
  exact ⟨e, by linear_combination he⟩

theorem typeII_determinant_e_quotient {m m' e k : ℤ} (hk : k ≠ 0)
    (he : m' - m = 2 * e * k) : (m' - m) / (2 * k) = e := by
  rw [he, show 2 * e * k = e * (2 * k) by ring]
  exact Int.mul_ediv_cancel e (mul_ne_zero (by norm_num) hk)

theorem typeII_determinant_n_quotient {m e h n : ℤ} (hm : m ≠ 0)
    (hn : m * n = 2 * e * h + 1) : (2 * e * h + 1) / m = n := by
  rw [← hn]
  exact Int.mul_ediv_cancel_left n hm

theorem typeII_determinant_from_congruence {m m' h h' k : ℤ}
    (hm : 0 < m) (hh : 0 ≤ h) (hk : k ≠ 0) (hc : IsCoprime m k)
    (hd : m * h' - m' * h = k) (hmod : Int.ModEq (2 * |k|) m m')
    (hpos : 0 < (m' - m) / (2 * k)) :
    ∃! en : ℤ × ℤ, 0 < en.1 ∧ 0 < en.2 ∧
      m * en.2 = 2 * en.1 * h + 1 ∧ m' * en.2 = 2 * en.1 * h' + 1 ∧
      m' - m = 2 * en.1 * k ∧ h' - h = k * en.2 := by
  let e := (m' - m) / (2 * k)
  have hdiv : 2 * k ∣ m' - m :=
    (typeII_signed_modulus_dvd k _).mp (Int.modEq_iff_dvd.mp hmod)
  have he : m' - m = 2 * e * k := by
    have heq := Int.ediv_mul_cancel hdiv
    dsimp only [e]
    linear_combination -heq
  obtain ⟨n, hn, huniq⟩ :=
    typeII_determinant_reconstruct_positive hm hpos hh hc hd he
  refine ⟨(e, n), ⟨hpos, hn.1, hn.2.1, hn.2.2.1, he, hn.2.2.2⟩, ?_⟩
  rintro ⟨e', n'⟩ hp
  have he' : e' = e := (typeII_determinant_e_quotient hk hp.2.2.2.2.1).symm
  have hn' : n' = n := by
    apply huniq
    simpa only [he'] using
      And.intro hp.2.1 (And.intro hp.2.2.1 (And.intro hp.2.2.2.1 hp.2.2.2.2.2))
  exact Prod.ext he' hn'

theorem typeII_determinant_converse_needs_coprimality :
    (3 : ℤ) * 6 - 15 * 1 = 3 ∧ Int.ModEq (2 * |(3 : ℤ)|) 3 15 ∧
      0 < ((15 : ℤ) - 3) / (2 * 3) ∧
      ¬ ∃ n : ℤ, 3 * n = 2 * 2 * 1 + 1 := by
  norm_num [Int.ModEq]
  omega

end Bounty
end

section

/- Multiplying by group-prime factors preserves the literal invariant endpoint. -/

namespace Bounty

theorem prime_pool_free_part_mul_supported {P : Finset ℕ} {a : ℕ}
    (ha : a ∈ Nat.factoredNumbers P) (n : ℕ) :
    primePoolFreePart P (a * n) = primePoolFreePart P n := by
  by_cases hn : n = 0
  · subst n
    simp only [mul_zero]
  · have he : a * n = (a * primePoolPart P n) * primePoolFreePart P n := by
      rw [mul_assoc, primePoolPart_mul_primePoolFreePart]
    rw [he, primePoolFreePart_mul_of_free
      (Nat.mul_mem_factoredNumbers ha (primePoolPart_mem_factoredNumbers P n))
      (primePoolFreePart_ne_zero P hn) (primePoolFreePart_primeFactors_disjoint P n)]

theorem invariant_triple_endpoint_mul_supported {P : Finset ℕ} {a : ℕ}
    (ha : a ∈ Nat.factoredNumbers P) (α β γ : ℕ → ℂ) (n : ℕ) :
    invariantTripleEndpoint P α β γ (a * n) = invariantTripleEndpoint P α β γ n := by
  unfold invariantTripleEndpoint
  rw [prime_pool_free_part_mul_supported ha]

end Bounty
end

section

/- Rough support gives a subexponential pointwise bound even for an unrestricted residual factor. -/

open Finset

namespace Bounty

theorem endpoint_triple_convolution_rough_sum (W : ℝ) (α β γ : ℕ → ℂ)
    (hα : ∀ m, ¬ (∀ p : ℕ, p ∈ m.primeFactors → W ≤ (p : ℝ)) → α m = 0)
    (hβ : ∀ m, ¬ (∀ p : ℕ, p ∈ m.primeFactors → W ≤ (p : ℝ)) → β m = 0)
    (n : ℕ) :
    endpointTripleConvolution α β γ n =
      ∑ m ∈ roughDivisors W n, ∑ p ∈ roughDivisors W (n / m),
        α m * β p * γ (n / m / p) := by
  classical
  unfold endpointTripleConvolution roughDivisors
  rw [sum_filter]
  apply sum_congr rfl
  intro m _
  by_cases hm : ∀ p : ℕ, p ∈ m.primeFactors → W ≤ (p : ℝ)
  · rw [if_pos hm, sum_filter]
    apply sum_congr rfl
    intro p _
    by_cases hp : ∀ r : ℕ, r ∈ p.primeFactors → W ≤ (r : ℝ)
    · rw [if_pos hp]
    · rw [if_neg hp, hβ p hp, mul_zero, zero_mul]
  · rw [if_neg hm, hα m hm]
    simp only [zero_mul, sum_const_zero]

theorem endpoint_triple_convolution_rough_norm (W : ℝ) (α β γ : ℕ → ℂ)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (hαrough : ∀ m, ¬ (∀ p : ℕ, p ∈ m.primeFactors → W ≤ (p : ℝ)) → α m = 0)
    (hβrough : ∀ m, ¬ (∀ p : ℕ, p ∈ m.primeFactors → W ≤ (p : ℝ)) → β m = 0)
    (n : ℕ) :
    ‖endpointTripleConvolution α β γ n‖ ≤ A * B * C * ((roughDivisors W n).card : ℝ) ^ 2 := by
  classical
  rw [endpoint_triple_convolution_rough_sum W α β γ hαrough hβrough]
  have hABC : 0 ≤ A * B * C := mul_nonneg (mul_nonneg hA hB) hC
  calc
    _ ≤ ∑ m ∈ roughDivisors W n, ∑ p ∈ roughDivisors W (n / m),
        ‖α m * β p * γ (n / m / p)‖ :=
      (norm_sum_le _ _).trans (sum_le_sum (fun m _ => norm_sum_le _ _))
    _ ≤ ∑ m ∈ roughDivisors W n, ∑ _p ∈ roughDivisors W (n / m), A * B * C := by
      apply sum_le_sum
      intro m _
      apply sum_le_sum
      intro p _
      rw [norm_mul, norm_mul]
      exact mul_le_mul (mul_le_mul (hα m) (hβ p) (norm_nonneg _) hA)
        (hγ _) (norm_nonneg _) (mul_nonneg hA hB)
    _ ≤ ∑ _m ∈ roughDivisors W n, ((roughDivisors W n).card : ℝ) * (A * B * C) := by
      apply sum_le_sum
      intro m hm
      simp only [sum_const, nsmul_eq_mul]
      apply mul_le_mul_of_nonneg_right _ hABC
      have hm' := (mem_filter.mp hm).1
      have hsub : roughDivisors W (n / m) ⊆ roughDivisors W n := by
        intro p hp
        exact mem_filter.mpr ⟨Nat.divisors_subset_of_dvd (Nat.ne_zero_of_mem_divisors hm')
          (Nat.div_dvd_of_dvd (Nat.dvd_of_mem_divisors hm')) (mem_filter.mp hp).1,
          (mem_filter.mp hp).2⟩
      exact_mod_cast card_le_card hsub
    _ = _ := by simp only [sum_const, nsmul_eq_mul]; ring

theorem endpoint_triple_convolution_rough_exp {W : ℝ} (hW : 1 < W)
    (α β γ : ℕ → ℂ) {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (hαrough : ∀ m, ¬ (∀ p : ℕ, p ∈ m.primeFactors → W ≤ (p : ℝ)) → α m = 0)
    (hβrough : ∀ m, ¬ (∀ p : ℕ, p ∈ m.primeFactors → W ≤ (p : ℝ)) → β m = 0)
    {n : ℕ} (hn : n ≠ 0) :
    ‖endpointTripleConvolution α β γ n‖ ≤
      A * B * C * Real.exp (2 * (Real.log 2 * Real.log n / Real.log W)) := by
  have hb := endpoint_triple_convolution_rough_norm W α β γ hA hB hC hα hβ hγ hαrough hβrough n
  have hc := roughDivisors_card_le_exp_log hW hn
  calc
    _ ≤ A * B * C * ((roughDivisors W n).card : ℝ) ^ 2 := hb
    _ ≤ A * B * C * (Real.exp (Real.log 2 * Real.log n / Real.log W)) ^ 2 := by gcongr
    _ = _ := by rw [← Real.exp_nat_mul]; norm_num

end Bounty
end

section

/- Elementary harmonic bounds for fixed Dirichlet powers of the zeta sequence. -/

open Finset ArithmeticFunction

namespace Bounty

noncomputable def divisorHarmonic (N : ℕ) : ℝ := ∑ n ∈ Ioc 0 N, (n : ℝ)⁻¹

theorem divisor_harmonic_nonneg (N : ℕ) : 0 ≤ divisorHarmonic N := by
  unfold divisorHarmonic
  positivity

theorem divisor_harmonic_mono {M N : ℕ} (hMN : M ≤ N) :
    divisorHarmonic M ≤ divisorHarmonic N := by
  unfold divisorHarmonic
  apply sum_le_sum_of_subset_of_nonneg
  · exact Ioc_subset_Ioc le_rfl hMN
  · intro n _ _
    positivity

theorem divisor_harmonic_log_bound (N : ℕ) : divisorHarmonic N ≤ 1 + Real.log N := by
  have hs : Ioc 0 N = Icc 1 N := by ext n; simp only [mem_Ioc, mem_Icc]; omega
  have heq : divisorHarmonic N = (harmonic N : ℝ) := by
    simp only [divisorHarmonic, harmonic_eq_sum_Icc, Rat.cast_sum, Rat.cast_inv,
      Rat.cast_natCast, hs]
  rw [heq]
  exact harmonic_le_one_add_log N

theorem divisor_zeta_sum_step (r N : ℕ) :
    (∑ n ∈ Ioc 0 N, ((ArithmeticFunction.zeta ^ (r + 2)) n : ℝ)) =
      ∑ d ∈ Ioc 0 N, ∑ n ∈ Ioc 0 (N / d),
        ((ArithmeticFunction.zeta ^ (r + 1)) n : ℝ) := by
  have heq := ArithmeticFunction.sum_Ioc_mul_eq_sum_sum
    ArithmeticFunction.zeta (ArithmeticFunction.zeta ^ (r + 1)) N
  rw [← pow_succ'] at heq
  have heq' := congrArg (fun n : ℕ => (n : ℝ)) heq
  simp only [Nat.cast_sum, Nat.cast_mul] at heq'
  rw [heq']
  apply sum_congr rfl
  intro d hd
  rw [ArithmeticFunction.zeta_apply_ne (Nat.ne_of_gt (mem_Ioc.mp hd).1), Nat.cast_one,
    one_mul]

theorem divisor_zeta_summatory_bound (r N : ℕ) :
    (∑ n ∈ Ioc 0 N, ((ArithmeticFunction.zeta ^ (r + 1)) n : ℝ)) ≤
      (N : ℝ) * divisorHarmonic N ^ r := by
  induction r generalizing N with
  | zero =>
    simp only [zero_add, pow_one, pow_zero, mul_one, ← Nat.cast_sum,
      ArithmeticFunction.sum_Ioc_zeta, le_refl]
  | succ r ih =>
    rw [show r + 1 + 1 = r + 2 by omega, divisor_zeta_sum_step]
    calc
      _ ≤ ∑ d ∈ Ioc 0 N, (N / d : ℕ) * divisorHarmonic (N / d) ^ r :=
        sum_le_sum (fun d _ => ih (N / d))
      _ ≤ ∑ d ∈ Ioc 0 N, ((N : ℝ) / d) * divisorHarmonic N ^ r := by
        apply sum_le_sum
        intro d hd
        apply mul_le_mul
        · exact Nat.cast_div_le
        · exact pow_le_pow_left₀ (divisor_harmonic_nonneg _) (divisor_harmonic_mono (Nat.div_le_self _ _)) _
        · exact pow_nonneg (divisor_harmonic_nonneg _) _
        · positivity
      _ = (N : ℝ) * divisorHarmonic N ^ (r + 1) := by
        simp only [div_eq_mul_inv, ← sum_mul, ← mul_sum, divisorHarmonic, pow_succ]
        ring

end Bounty
end

section

/- Actual candidate Q-slot allocation in increasing band order, preserving its factorial normalization. -/

open Finset Real

namespace Bounty

noncomputable def candidateAllocationOrder (c L : ℝ) (r : ℕ) :
    Fin ((candidateQIndices c L).card*r) ≃ (candidateQIndices c L) × Fin r :=
  finProdFinEquiv.symm.trans (Equiv.prodCongr
    ((candidateQIndices c L).orderIsoOfFin rfl).toEquiv (Equiv.refl _))

noncomputable def candidateAllocationValue (c L : ℝ) (r jStar : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot)
    (i : Fin ((candidateQIndices c L).card*r)) : ℕ :=
  (x (candidateAllocationOrder c L r i)).val

noncomputable def candidateAllocationActive (c L : ℝ) (r jStar : ℕ)
    (i : Fin ((candidateQIndices c L).card*r)) : Bool :=
  decide (¬((candidateAllocationOrder c L r i).1.val=jStar ∧
    (candidateAllocationOrder c L r i).2.val=0))

noncomputable def candidateAllocationWeight (c L : ℝ) (r jStar : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) (R : ℝ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) : ℝ :=
  smoothAllocationWeight _ (fun i => log (candidateAllocationValue c L r jStar x i))
    (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val)
    (candidateAllocationActive c L r jStar) R take

noncomputable def candidateAllocatedFactor (c L : ℝ) (r jStar : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) : ℕ :=
  ∏ i, if take i then candidateAllocationValue c L r jStar x i else 1

noncomputable def candidateRetainedFactor (c L : ℝ) (r jStar P : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) : ℕ :=
  P * ∏ i, if take i then 1 else candidateAllocationValue c L r jStar x i

theorem candidate_allocation_total_mass (c L : ℝ) (r jStar : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) (R : ℝ) :
    (∑ take, candidateAllocationWeight c L r jStar x R take) = 1 :=
  smooth_allocation_total_mass _ _ _ _ _

theorem candidate_allocation_weight_nonneg (c L : ℝ) (r jStar : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) (R : ℝ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) :
    0 ≤ candidateAllocationWeight c L r jStar x R take :=
  smooth_allocation_weight_nonneg _ _ _ _ _ _

theorem candidate_allocation_value_pos (c L : ℝ) (r jStar : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot)
    (i : Fin ((candidateQIndices c L).card*r)) : 0 < candidateAllocationValue c L r jStar x i :=
  Nat.pos_of_ne_zero (candidate_Q_slot_nonzero c L r jStar _ (x _).property)

theorem candidate_allocation_product (c L : ℝ) (r jStar : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) :
    (∏ i, candidateAllocationValue c L r jStar x i) =
      orderedSlotProduct (candidateQSlotChoices c L r jStar) x := by
  exact Fintype.prod_equiv (candidateAllocationOrder c L r) _ _ (fun _ => rfl)

theorem candidate_allocation_factorization (c L : ℝ) (r jStar P : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) :
    candidateAllocatedFactor c L r jStar x take*candidateRetainedFactor c L r jStar P x take =
      P*orderedSlotProduct (candidateQSlotChoices c L r jStar) x := by
  unfold candidateAllocatedFactor candidateRetainedFactor
  rw [mul_left_comm, ← prod_mul_distrib]
  congr 1
  rw [← candidate_allocation_product c L r jStar x]
  apply prod_congr rfl
  intro i hi
  cases take i <;> simp

theorem candidate_group_factor_retained (c L : ℝ) (r jStar P : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) :
    P ∣ candidateRetainedFactor c L r jStar P x take := dvd_mul_right _ _

theorem candidate_rough_slot_retained (c L : ℝ) (r jStar P : ℕ)
    (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) (R : ℝ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hweight : 0 < candidateAllocationWeight c L r jStar x R take) :
    (x (candidateRoughSlot c L r jStar hr hj)).val ∣
      candidateRetainedFactor c L r jStar P x take := by
  let i := (candidateAllocationOrder c L r).symm (candidateRoughSlot c L r jStar hr hj)
  have he : candidateAllocationOrder c L r i = candidateRoughSlot c L r jStar hr hj :=
    Equiv.apply_symm_apply _ _
  have ha : candidateAllocationActive c L r jStar i = false := by
    simp only [candidateAllocationActive, he, candidateRoughSlot, not_true_eq_false, decide_false,
      and_self]
  have ht := smooth_allocation_inactive_not_taken _ _ _ _ _ _ hweight i ha
  have hd := Finset.dvd_prod_of_mem
    (fun j => if take j then 1 else candidateAllocationValue c L r jStar x j) (mem_univ i)
  have heval : candidateAllocationValue c L r jStar x i =
      (x (candidateRoughSlot c L r jStar hr hj)).val :=
    congrArg (fun slot => (x slot).val) he
  rw [ht] at hd
  simp only [Bool.false_eq_true, if_false] at hd
  rw [heval] at hd
  exact hd.trans (dvd_mul_left _ _)

theorem candidate_Q_weight_allocation_identity (c L : ℝ) (r jStar n : ℕ) (R : ℝ) :
    candidateQWeight c L r jStar n =
      ∑ x : ∀ slot, candidateQSlotChoices c L r jStar slot,
        ∑ take : Fin ((candidateQIndices c L).card*r) → Bool,
          if orderedSlotProduct (candidateQSlotChoices c L r jStar) x = n
          then candidateAllocationWeight c L r jStar x R take /
            ((r.factorial : ℝ)^(candidateQIndices c L).card) else 0 := by
  exact ordered_slot_weight_partition _ _ _
    (fun x take => candidateAllocationWeight c L r jStar x R take)
    (fun x => candidate_allocation_total_mass c L r jStar x R)

end Bounty
end

section

/- Deterministic residual bounds on positive smooth allocation branches. -/

open Finset Real

namespace Bounty

noncomputable def smoothAllocationInventory (n : ℕ) (v : Fin n → ℝ) (active : Fin n → Bool) : ℝ :=
  ∑ i, if active i then v i else 0

noncomputable def smoothAllocationResidual (n : ℕ) (v : Fin n → ℝ)
    (R : ℝ) (take : Fin n → Bool) : ℝ := R-∑ i, if take i then v i else 0

def SmoothAllocationRoom : (n : ℕ) → (Fin n → ℝ) → (Fin n → ℝ) → (Fin n → Bool) → ℝ → Prop
  | 0, _, _, _, _ => True
  | n+1, v, s, active, A =>
    (active 0 = true → v 0+s 0 ≤ smoothAllocationInventory n (Fin.tail v) (Fin.tail active)+A) ∧
    SmoothAllocationRoom n (Fin.tail v) (Fin.tail s) (Fin.tail active) A

theorem smooth_allocation_residual_step (n : ℕ) (v : Fin (n+1) → ℝ)
    (R : ℝ) (take : Fin (n+1) → Bool) :
    smoothAllocationResidual (n+1) v R take =
      smoothAllocationResidual n (Fin.tail v) (R-if take 0 then v 0 else 0) (Fin.tail take) := by
  rw [Fin.tail_def, Fin.tail_def]
  unfold smoothAllocationResidual
  rw [Fin.sum_univ_succ, sub_sub]

theorem smooth_allocation_terminal_residual (n : ℕ) (v s : Fin n → ℝ)
    (active : Fin n → Bool) (R A : ℝ) (take : Fin n → Bool)
    (hs : ∀ i, 0 < s i) (hR : 0 ≤ R)
    (hcap : R ≤ smoothAllocationInventory n v active+A)
    (hroom : SmoothAllocationRoom n v s active A)
    (hweight : 0 < smoothAllocationWeight n v s active R take) :
    0 ≤ smoothAllocationResidual n v R take ∧ smoothAllocationResidual n v R take ≤ A := by
  induction n generalizing R with
  | zero => simpa [smoothAllocationResidual,smoothAllocationInventory] using And.intro hR hcap
  | succ n ih =>
    obtain ⟨hhead,htail⟩ := smooth_allocation_positive_factors hweight
    have hnext : 0 ≤ R-(if take 0 then v 0 else 0) ∧
        R-(if take 0 then v 0 else 0) ≤ smoothAllocationInventory n (Fin.tail v) (Fin.tail active)+A := by
      cases ha : active 0 <;> cases ht : take 0
      · have hh : R ≤ smoothAllocationInventory n (Fin.tail v) (Fin.tail active)+A := by
          rw [Fin.tail_def, Fin.tail_def]
          unfold smoothAllocationInventory at *
          simpa only [Fin.sum_univ_succ, ha, Bool.false_eq_true, if_false, zero_add] using hcap
        simpa only [ht, Bool.false_eq_true, if_false, sub_zero] using And.intro hR hh
      · simp only [smoothSlotTransition, smoothSlotTakeProbability, ha, ht,
          Bool.false_eq_true, if_false, if_true] at hhead
        linarith
      · have hh := smooth_slot_skip_requires_room (hs 0) (by simpa only [ha,ht] using hhead)
        have hr := hroom.1 ha
        simp only [Bool.false_eq_true, if_false, sub_zero]
        exact ⟨hR, (le_of_lt hh).trans hr⟩
      · have hh := smooth_slot_take_requires_room (hs 0) (by simpa only [ht] using hhead)
        have hc : R ≤ v 0+smoothAllocationInventory n (Fin.tail v) (Fin.tail active)+A := by
          rw [Fin.tail_def, Fin.tail_def]
          unfold smoothAllocationInventory at *
          simpa only [Fin.sum_univ_succ, ha, if_true] using hcap
        simp only [if_true]
        constructor <;> linarith
    rw [smooth_allocation_residual_step]
    exact ih (Fin.tail v) (Fin.tail s) (Fin.tail active) _ (Fin.tail take)
      (fun i => hs i.succ) hnext.1 hnext.2 hroom.2 htail

noncomputable def allocationNaturalProduct {n : ℕ} (p : Fin n → ℕ) (take : Fin n → Bool) : ℕ :=
  ∏ i, if take i then p i else 1

theorem allocation_natural_product_exp_log {n : ℕ} (p : Fin n → ℕ)
    (hp : ∀ i, 0 < p i) (take : Fin n → Bool) :
    exp (∑ i, if take i then log (p i : ℝ) else 0) = (allocationNaturalProduct p take : ℝ) := by
  rw [exp_sum]
  unfold allocationNaturalProduct
  push_cast
  apply prod_congr rfl
  intro i hi
  cases take i <;> simp [exp_log (Nat.cast_pos.mpr (hp i))]

theorem smooth_allocation_product_range {n : ℕ} (p : Fin n → ℕ) (hp : ∀ i, 0 < p i)
    (s : Fin n → ℝ) (active : Fin n → Bool) (R A : ℝ) (take : Fin n → Bool)
    (hs : ∀ i, 0 < s i) (hR : 0 ≤ R)
    (hcap : R ≤ smoothAllocationInventory n (fun i => log (p i : ℝ)) active+A)
    (hroom : SmoothAllocationRoom n (fun i => log (p i : ℝ)) s active A)
    (hweight : 0 < smoothAllocationWeight n (fun i => log (p i : ℝ)) s active R take) :
    exp (R-A) ≤ (allocationNaturalProduct p take : ℝ) ∧
      (allocationNaturalProduct p take : ℝ) ≤ exp R := by
  obtain ⟨hlo,hhi⟩ := smooth_allocation_terminal_residual n (fun i => log (p i : ℝ))
    s active R A take hs hR hcap hroom hweight
  unfold smoothAllocationResidual at hlo hhi
  rw [← allocation_natural_product_exp_log p hp take]
  constructor <;> apply exp_le_exp.mpr <;> linarith

end Bounty
end

section

/- Exact decomposition and overlap energy for position-dependent vectors. -/

open scoped BigOperators InnerProductSpace

namespace Bounty

theorem position_block_vector_sum {X : Type*} [Fintype X]
    (position : X → ℤ) (mass : ℝ) (S : Finset ℤ) (H : ℤ) (f : ℤ → ℂ)
    (hf : ∀ x, position x ∉ S → f (position x) = 0) :
    (∑ j ∈ S.image (fun n => n / H),
      finitePositionVector position mass (integerBlockMask id H j f)) =
      finitePositionVector position mass f := by
  classical
  ext x
  simp only [WithLp.ofLp_sum, Finset.sum_apply]
  change (∑ j ∈ S.image (fun n => n / H),
    (Real.sqrt mass : ℂ) * integerBlockMask id H j f (position x)) =
    (Real.sqrt mass : ℂ) * f (position x)
  rw [← Finset.mul_sum]
  by_cases hx : position x ∈ S
  · congr 1
    simpa only [id_eq] using sum_integerBlockMask_eq S id H f hx
  · simp [integerBlockMask, hf x hx]

theorem position_block_energy_sum {X : Type*} [Fintype X]
    (position : X → ℤ) {mass : ℝ} (hmass : 0 ≤ mass)
    (S : Finset ℤ) (H : ℤ) (f : ℤ → ℂ)
    (hf : ∀ x, position x ∉ S → f (position x) = 0) :
    (∑ j ∈ S.image (fun n => n / H),
      ‖finitePositionVector position mass (integerBlockMask id H j f)‖ ^ 2) =
      ‖finitePositionVector position mass f‖ ^ 2 := by
  classical
  simp only [finite_position_vector_norm_sq position hmass, ← Finset.mul_sum]
  congr 1
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro x _
  by_cases hx : position x ∈ S
  · have ht := sum_integerBlockMask_eq S id H (fun n => ‖f n‖ ^ 2) hx
    convert ht using 1
    apply Finset.sum_congr rfl
    intro j _
    by_cases hj : position x / H = j <;> simp [integerBlockMask, hj]
  · simp [integerBlockMask, hf x hx]

theorem position_near_block_energy_sum {X : Type*} [Fintype X]
    (position : X → ℤ) {mass : ℝ} (hmass : 0 ≤ mass)
    (J : Finset ℤ) (H : ℤ) (g : ℤ → ℂ) :
    (∑ j ∈ J, ‖finitePositionVector position mass (integerBlockNearMask id H j g)‖ ^ 2) ≤
      3 * ‖finitePositionVector position mass g‖ ^ 2 := by
  classical
  simp only [finite_position_vector_norm_sq position hmass]
  have h := sum_integerBlockNear_sq_norm_le Finset.univ J position H
    (fun _ => mass) (fun x => g (position x)) (fun _ _ => hmass)
  simpa only [Finset.mul_sum, integerBlockNearMask, id_eq] using h

end Bounty
end

section

/- The same cutoff consumes a vanishing fraction of a polynomially long path. -/

open Filter

namespace Bounty

theorem forest_rank_cutoff_ratio_le {K L b : ℝ} (hK : 0 ≤ K) (hL : 1 ≤ L)
    (hb : 0 < b) (N : ℕ) (hN : 0 < N) :
    (Nat.ceil (K * N * Real.log L / b) : ℝ) / N ≤
      K * Real.log L / b + 1 / N := by
  have hNr : (0 : ℝ) < N := by exact_mod_cast hN
  have hlog : 0 ≤ Real.log L := Real.log_nonneg hL
  have hceil := (Nat.ceil_lt_add_one (show 0 ≤ K * N * Real.log L / b by positivity)).le
  calc
    _ ≤ (K * N * Real.log L / b + 1) / N := div_le_div_of_nonneg_right hceil hNr.le
    _ = _ := by field_simp

theorem eventually_forest_rank_cutoff_small {a c ε K : ℝ}
    (ha : 0 < a) (hc : 0 < c) (hε : 0 < ε) (hK : 0 ≤ K) :
    ∀ᶠ L : ℝ in atTop, ∀ N : ℕ, L ^ a ≤ (N : ℝ) →
      ∀ b : ℝ, L ^ c ≤ b →
        (Nat.ceil (K * N * Real.log L / b) : ℝ) / N ≤ ε := by
  filter_upwards [eventually_ge_atTop (1 : ℝ),
    eventually_mul_rpow_log_add_le_rpow (a := 0) hc hc (half_pos hε) K 0,
    eventually_mul_rpow_log_add_le_rpow (a := 0) ha ha (half_pos hε) 0 1] with L hL hlog hunit
  simp only [Real.rpow_zero, mul_one, add_zero, zero_mul, zero_add] at hlog hunit
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL
  intro N hN b hb
  have hNr : (0 : ℝ) < N := (Real.rpow_pos_of_pos hL0 a).trans_le hN
  have hb0 : 0 < b := (Real.rpow_pos_of_pos hL0 c).trans_le hb
  have hr := forest_rank_cutoff_ratio_le hK hL hb0 N (by exact_mod_cast hNr)
  have hp : K * Real.log L / b ≤ ε / 2 := by
    apply (div_le_iff₀ hb0).mpr
    exact hlog.trans (mul_le_mul_of_nonneg_left hb (half_pos hε).le)
  have hn : 1 / (N : ℝ) ≤ ε / 2 := by
    apply (div_le_iff₀ hNr).mpr
    exact hunit.trans (mul_le_mul_of_nonneg_left hN (half_pos hε).le)
  linarith

end Bounty
end

section

/- L1 bounds and uniform rapid Fourier truncation for the explicit cutoff pair. -/

open MeasureTheory

namespace Bounty

theorem typeII_cutoff_fourier_l1_bound (A : ℝ) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ active : Bool,
      (∫ ξ : ℝ, ‖typeIICutoffFourier A active ξ‖) ≤ C := by
  let I₀ : ℝ := ∫ ξ : ℝ, ‖typeIICutoffFourier A false ξ‖
  let I₁ : ℝ := ∫ ξ : ℝ, ‖typeIICutoffFourier A true ξ‖
  have h₀ : 0 ≤ I₀ := integral_nonneg (fun _ => norm_nonneg _)
  have h₁ : 0 ≤ I₁ := integral_nonneg (fun _ => norm_nonneg _)
  refine ⟨1 + I₀ + I₁, by linarith, ?_⟩
  intro active
  cases active
  · change I₀ ≤ 1 + I₀ + I₁
    linarith
  · change I₁ ≤ 1 + I₀ + I₁
    linarith

theorem typeII_cutoff_fourier_rapid_tail (A : ℝ) (M : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ active : Bool, ∀ R : ℝ, 1 ≤ R →
      (∫ ξ in {ξ : ℝ | R < ‖ξ‖}, ‖typeIICutoffFourier A active ξ‖) ≤
        C * R ^ (-(M : ℝ)) := by
  obtain ⟨C₀, h₀, hb₀⟩ := schwartz_norm_rapid_tail (typeIICutoffFourier A false) M
  obtain ⟨C₁, h₁, hb₁⟩ := schwartz_norm_rapid_tail (typeIICutoffFourier A true) M
  refine ⟨C₀ + C₁, add_pos h₀ h₁, ?_⟩
  intro active R hR
  have hp : 0 ≤ R ^ (-(M : ℝ)) := Real.rpow_nonneg (by linarith) _
  cases active
  · exact (hb₀ R hR).trans (mul_le_mul_of_nonneg_right (by linarith) hp)
  · exact (hb₁ R hR).trans (mul_le_mul_of_nonneg_right (by linarith) hp)

noncomputable def typeIICutoffFourierIntegrand (A : ℝ) (active : Bool) (t ξ : ℝ) : ℂ :=
  Complex.exp ((2 * Real.pi * ξ * t : ℝ) * Complex.I) * typeIICutoffFourier A active ξ

theorem typeII_cutoff_fourier_integrand_norm (A t ξ : ℝ) (active : Bool) :
    ‖typeIICutoffFourierIntegrand A active t ξ‖ = ‖typeIICutoffFourier A active ξ‖ := by
  rw [typeIICutoffFourierIntegrand, norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]

theorem typeII_cutoff_fourier_integrand_integrable (A t : ℝ) (active : Bool) :
    Integrable (typeIICutoffFourierIntegrand A active t) := by
  have hc : Continuous (typeIICutoffFourierIntegrand A active t) := by
    unfold typeIICutoffFourierIntegrand
    apply Continuous.mul
    · fun_prop
    · exact (typeIICutoffFourier A active).continuous
  apply (typeII_cutoff_fourier_integrable A active).norm.mono' hc.aestronglyMeasurable
  exact Filter.Eventually.of_forall (fun ξ => (typeII_cutoff_fourier_integrand_norm A t ξ active).le)

theorem typeII_cutoff_fourier_truncation_le_tail (A t R : ℝ) (active : Bool) :
    ‖(typeIISmoothCutoff A active t : ℂ) -
        ∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ R}, typeIICutoffFourierIntegrand A active t ξ‖ ≤
      ∫ ξ in {ξ : ℝ | R < ‖ξ‖}, ‖typeIICutoffFourier A active ξ‖ := by
  have hs : MeasurableSet {ξ : ℝ | ‖ξ‖ ≤ R} :=
    (isClosed_le continuous_norm continuous_const).measurableSet
  have heq : {ξ : ℝ | ‖ξ‖ ≤ R}ᶜ = {ξ : ℝ | R < ‖ξ‖} := by
    ext ξ
    simp
  rw [typeII_cutoff_fourier_inversion]
  change ‖(∫ ξ : ℝ, typeIICutoffFourierIntegrand A active t ξ) - _‖ ≤ _
  rw [← setIntegral_compl hs (typeII_cutoff_fourier_integrand_integrable A t active), heq]
  apply (norm_integral_le_integral_norm _).trans
  apply le_of_eq
  exact integral_congr_ae (Filter.Eventually.of_forall (fun ξ =>
    typeII_cutoff_fourier_integrand_norm A t ξ active))

theorem typeII_cutoff_fourier_rapid_truncation (A : ℝ) (M : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ active : Bool, ∀ R : ℝ, 1 ≤ R → ∀ t : ℝ,
      ‖(typeIISmoothCutoff A active t : ℂ) -
          ∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ R}, typeIICutoffFourierIntegrand A active t ξ‖ ≤
        C * R ^ (-(M : ℝ)) := by
  obtain ⟨C, hC, hb⟩ := typeII_cutoff_fourier_rapid_tail A M
  exact ⟨C, hC, fun active R hR t =>
    (typeII_cutoff_fourier_truncation_le_tail A t R active).trans (hb active R hR)⟩

theorem typeII_transition_fourier_rapid_truncation (A : ℝ) (M : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ active : Bool, ∀ R : ℝ, 1 ≤ R →
      ∀ t ∈ Set.Icc (-A) A,
      ‖((if active then Real.smoothTransition t else 1 - Real.smoothTransition t : ℝ) : ℂ) -
          ∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ R}, typeIICutoffFourierIntegrand A active t ξ‖ ≤
        C * R ^ (-(M : ℝ)) := by
  obtain ⟨C, hC, hb⟩ := typeII_cutoff_fourier_rapid_truncation A M
  refine ⟨C, hC, ?_⟩
  intro active R hR t ht
  simpa only [typeII_smooth_cutoff_eq_transition active ht] using hb active R hR t

end Bounty
end

section

/- Exact separation of labelled, independently twisted slots. -/

open Finset

namespace Bounty

noncomputable def orderedSlotComplexWeight {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (twist : I → ℕ → ℂ) (n : ℕ) : ℂ :=
  ∑ x : ∀ i, choices i, if orderedSlotProduct choices x = n
    then ∏ i, twist i (x i).val else 0

noncomputable def orderedSlotProductSupport {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) : Finset ℕ :=
  univ.image (orderedSlotProduct choices)

theorem ordered_slot_complex_weight_support {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (twist : I → ℕ → ℂ) {n : ℕ}
    (hn : n ∉ orderedSlotProductSupport choices) : orderedSlotComplexWeight choices twist n = 0 := by
  classical
  apply sum_eq_zero
  intro x _
  exact if_neg (fun h => hn (mem_image.mpr ⟨x, mem_univ _, h⟩))

theorem ordered_slot_complex_fiber_test {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (twist : I → ℕ → ℂ) (F : ℕ → ℂ) :
    (∑ n ∈ orderedSlotProductSupport choices, orderedSlotComplexWeight choices twist n * F n) =
      ∑ x : ∀ i, choices i, (∏ i, twist i (x i).val) * F (orderedSlotProduct choices x) := by
  classical
  simp only [orderedSlotComplexWeight, sum_mul]
  rw [sum_comm]
  apply sum_congr rfl
  intro x _
  have hx : orderedSlotProduct choices x ∈ orderedSlotProductSupport choices :=
    mem_image.mpr ⟨x, mem_univ _, rfl⟩
  simp only [ite_mul, zero_mul]
  simp [hx]

theorem ordered_slot_twisted_split_test {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (take : I → Prop) [DecidablePred take]
    (twist : I → ℕ → ℂ) (F : ℕ → ℂ) :
    (∑ x : ∀ i, choices i, (∏ i, twist i (x i).val) * F (orderedSlotProduct choices x)) =
      ∑ e ∈ orderedSlotProductSupport (fun i : {i // take i} => choices i.val),
      ∑ h ∈ orderedSlotProductSupport (fun i : {i // ¬take i} => choices i.val),
        orderedSlotComplexWeight (fun i : {i // take i} => choices i.val)
          (fun i => twist i.val) e *
        orderedSlotComplexWeight (fun i : {i // ¬take i} => choices i.val)
          (fun i => twist i.val) h * F (e*h) := by
  classical
  have htuple :
      (∑ x : ∀ i, choices i, (∏ i, twist i (x i).val) * F (orderedSlotProduct choices x)) =
      ∑ x : ∀ i : {i // take i}, choices i.val,
      ∑ y : ∀ i : {i // ¬take i}, choices i.val,
        (∏ i, twist i.val (x i).val) * (∏ i, twist i.val (y i).val) *
          F (orderedSlotProduct _ x * orderedSlotProduct _ y) := by
    let f : (∀ i : {i // take i}, choices i.val) ×
        (∀ i : {i // ¬take i}, choices i.val) → ℂ := fun z =>
      (∏ i, twist i.val (z.1 i).val) * (∏ i, twist i.val (z.2 i).val) *
        F (orderedSlotProduct _ z.1 * orderedSlotProduct _ z.2)
    calc
      _ = ∑ z, f z := by
        apply Fintype.sum_equiv (Equiv.piEquivPiSubtypeProd take (fun i => choices i))
        intro x
        simp only [f, Equiv.piEquivPiSubtypeProd_apply, orderedSlotProduct]
        rw [Fintype.prod_subtype_mul_prod_subtype take (fun i => twist i (x i).val),
          Fintype.prod_subtype_mul_prod_subtype take (fun i => (x i).val)]
      _ = _ := Fintype.sum_prod_type f
  rw [htuple]
  symm
  calc
    _ = ∑ e ∈ orderedSlotProductSupport (fun i : {i // take i} => choices i.val),
        orderedSlotComplexWeight (fun i : {i // take i} => choices i.val) (fun i => twist i.val) e *
        ∑ y : ∀ i : {i // ¬take i}, choices i.val,
          (∏ i, twist i.val (y i).val) * F (e * orderedSlotProduct _ y) := by
      apply sum_congr rfl
      intro e _
      simp_rw [mul_assoc]
      rw [← mul_sum, ordered_slot_complex_fiber_test]
    _ = _ := by
      rw [ordered_slot_complex_fiber_test]
      apply sum_congr rfl
      intro x _
      rw [mul_sum]
      apply sum_congr rfl
      intro y _
      ring

theorem ordered_slot_complex_convolution {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (take : I → Prop) [DecidablePred take]
    (twist : I → ℕ → ℂ) (n : ℕ) :
    orderedSlotComplexWeight choices twist n =
      ∑ e ∈ orderedSlotProductSupport (fun i : {i // take i} => choices i.val),
      ∑ h ∈ orderedSlotProductSupport (fun i : {i // ¬take i} => choices i.val),
        if e*h=n then
          orderedSlotComplexWeight (fun i : {i // take i} => choices i.val) (fun i => twist i.val) e *
          orderedSlotComplexWeight (fun i : {i // ¬take i} => choices i.val) (fun i => twist i.val) h
        else 0 := by
  have h := ordered_slot_twisted_split_test choices take twist (fun t => if t=n then 1 else 0)
  simpa only [orderedSlotComplexWeight, mul_ite, mul_one, mul_zero] using h

theorem ordered_slot_twisted_single_split {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (twist : I → ℕ → ℂ) (i : I) (F : ℕ → ℂ) :
    (∑ x : ∀ j, choices j, (∏ j, twist j (x j).val) * F (orderedSlotProduct choices x)) =
      ∑ p : choices i,
      ∑ q ∈ orderedSlotProductSupport (fun j : {j : I // j ≠ i} => choices j.val),
        twist i p.val *
          orderedSlotComplexWeight (fun j : {j : I // j ≠ i} => choices j.val)
            (fun j => twist j.val) q * F (p.val*q) := by
  classical
  let f : choices i × (∀ j : {j : I // j ≠ i}, choices j.val) → ℂ := fun z =>
    twist i z.1.val * (∏ j, twist j.val (z.2 j).val) *
      F (z.1.val * orderedSlotProduct _ z.2)
  calc
    _ = ∑ z, f z := by
      apply Fintype.sum_equiv (Equiv.piSplitAt i (fun j => choices j))
      intro x
      simp only [f, Equiv.piSplitAt_apply]
      rw [ordered_slot_product_split choices i x,
        Fintype.prod_eq_mul_prod_subtype_ne (fun j => twist j (x j).val) i]
    _ = ∑ p : choices i, ∑ y : ∀ j : {j : I // j ≠ i}, choices j.val,
        twist i p.val * (∏ j, twist j.val (y j).val) *
          F (p.val * orderedSlotProduct _ y) := Fintype.sum_prod_type f
    _ = _ := by
      apply sum_congr rfl
      intro p _
      simp_rw [mul_assoc]
      rw [← mul_sum, ← mul_sum, ordered_slot_complex_fiber_test]

theorem ordered_slot_complex_single_convolution {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (twist : I → ℕ → ℂ) (i : I) (n : ℕ) :
    orderedSlotComplexWeight choices twist n =
      ∑ p : choices i,
      ∑ q ∈ orderedSlotProductSupport (fun j : {j : I // j ≠ i} => choices j.val),
        if p.val*q=n then twist i p.val *
          orderedSlotComplexWeight (fun j : {j : I // j ≠ i} => choices j.val)
            (fun j => twist j.val) q else 0 := by
  have h := ordered_slot_twisted_single_split choices twist i (fun t => if t=n then 1 else 0)
  simpa only [orderedSlotComplexWeight, mul_ite, mul_one, mul_zero] using h


end Bounty
end

section

/- Pure candidate Q-slot subsets retain the original factorial normalization. -/

open Finset

namespace Bounty

theorem candidate_Q_subset_group_card_le {I : Type*} [Fintype I]
    {c L : ℝ} {r : ℕ}
    (emb : I → (candidateQIndices c L) × Fin r) (hemb : Function.Injective emb)
    (j : candidateQIndices c L) :
    Fintype.card {i : I // (emb i).1 = j} ≤ r := by
  let f : {i : I // (emb i).1 = j} → Fin r := fun i => (emb i.val).2
  have hf : Function.Injective f := by
    intro i k hik
    apply Subtype.ext
    apply hemb
    exact Prod.ext (i.property.trans k.property.symm) hik
  simpa only [Fintype.card_fin] using Fintype.card_le_of_injective f hf

theorem candidate_Q_subset_factorial_product_le {I : Type*} [Fintype I]
    {c L : ℝ} {r : ℕ}
    (emb : I → (candidateQIndices c L) × Fin r) (hemb : Function.Injective emb) :
    (∏ j : candidateQIndices c L, ((Fintype.card {i : I // (emb i).1 = j}).factorial : ℝ)) ≤
      (r.factorial : ℝ) ^ (candidateQIndices c L).card := by
  calc
    _ ≤ ∏ _j : candidateQIndices c L, (r.factorial : ℝ) := by
      apply prod_le_prod₀
      · intro j _
        positivity
      · intro j _
        exact_mod_cast Nat.factorial_le (candidate_Q_subset_group_card_le emb hemb j)
    _ = _ := by simp

theorem norm_candidate_Q_pure_subset_fiber_le {I : Type*} [Fintype I] [DecidableEq I]
    {c L : ℝ} {r jStar : ℕ} (hcL : 0 ≤ c * L) (hr : 0 < r)
    (hj : jStar ∈ candidateQIndices c L)
    (emb : I → (candidateQIndices c L) × Fin r)
    (hpure : ∀ i, emb i ≠ candidateRoughSlot c L r jStar hr hj)
    (twist : I → ℕ → ℂ)
    (htwist : ∀ i p, p ∈ candidateQSlotChoices c L r jStar (emb i) → ‖twist i p‖ ≤ 1)
    (n : ℕ) :
    ‖∑ a : ∀ i, candidateQSlotChoices c L r jStar (emb i),
      if orderedSlotProduct (fun i => candidateQSlotChoices c L r jStar (emb i)) a = n
      then ∏ i, twist i (a i).val else 0‖ ≤
      ∏ j : candidateQIndices c L, ((Fintype.card {i : I // (emb i).1 = j}).factorial : ℝ) := by
  classical
  let choices := fun i => candidateQSlotChoices c L r jStar (emb i)
  let x (a : ∀ i, choices i) (i : I) : ℕ := (a i).val
  have hxinj : Function.Injective x := by
    intro a b hab
    funext i
    exact Subtype.ext (congrFun hab i)
  have hx : ∀ (a : ∀ i, choices i) i, x a i ∈ candidateQBand (c * L) (emb i).1.val := by
    intro a i
    have ha : x a i ∈ choices i := (a i).property
    dsimp only [choices] at ha
    rw [candidate_Q_choices_eq_single_rough c L r jStar hr hj] at ha
    simpa only [if_neg (hpure i)] using ha
  have hw : ∀ a : ∀ i, choices i, ‖∏ i, twist i (a i).val‖ ≤ 1 := by
    intro a
    rw [norm_prod]
    exact prod_le_one₀ (fun i _ => norm_nonneg _) (fun i _ => htwist i _ (a i).property)
  exact norm_labelled_prime_product_fiber_sum_le
    (fun i => (emb i).1) (fun j => candidateQBand (c * L) j.val)
    (fun _ _ hp => (mem_filter.mp hp).2) (candidate_Q_group_disjoint hcL)
    x hxinj hx (fun a => ∏ i, twist i (a i).val) hw n

theorem norm_candidate_Q_pure_subset_fiber_le_factorial_pow {I : Type*} [Fintype I] [DecidableEq I]
    {c L : ℝ} {r jStar : ℕ} (hcL : 0 ≤ c * L) (hr : 0 < r)
    (hj : jStar ∈ candidateQIndices c L)
    (emb : I → (candidateQIndices c L) × Fin r) (hemb : Function.Injective emb)
    (hpure : ∀ i, emb i ≠ candidateRoughSlot c L r jStar hr hj)
    (twist : I → ℕ → ℂ)
    (htwist : ∀ i p, p ∈ candidateQSlotChoices c L r jStar (emb i) → ‖twist i p‖ ≤ 1)
    (n : ℕ) :
    ‖∑ a : ∀ i, candidateQSlotChoices c L r jStar (emb i),
      if orderedSlotProduct (fun i => candidateQSlotChoices c L r jStar (emb i)) a = n
      then ∏ i, twist i (a i).val else 0‖ ≤
      (r.factorial : ℝ) ^ (candidateQIndices c L).card :=
  (norm_candidate_Q_pure_subset_fiber_le hcL hr hj emb hpure twist htwist n).trans
    (candidate_Q_subset_factorial_product_le emb hemb)

theorem norm_candidate_Q_pure_subset_fiber_normalized_le_one {I : Type*} [Fintype I] [DecidableEq I]
    {c L : ℝ} {r jStar : ℕ} (hcL : 0 ≤ c * L) (hr : 0 < r)
    (hj : jStar ∈ candidateQIndices c L)
    (emb : I → (candidateQIndices c L) × Fin r) (hemb : Function.Injective emb)
    (hpure : ∀ i, emb i ≠ candidateRoughSlot c L r jStar hr hj)
    (twist : I → ℕ → ℂ)
    (htwist : ∀ i p, p ∈ candidateQSlotChoices c L r jStar (emb i) → ‖twist i p‖ ≤ 1)
    (n : ℕ) :
    ‖(∑ a : ∀ i, candidateQSlotChoices c L r jStar (emb i),
      if orderedSlotProduct (fun i => candidateQSlotChoices c L r jStar (emb i)) a = n
      then ∏ i, twist i (a i).val else 0) /
      (((r.factorial : ℝ) ^ (candidateQIndices c L).card : ℝ) : ℂ)‖ ≤ 1 := by
  have hpos : 0 < (r.factorial : ℝ) ^ (candidateQIndices c L).card := by positivity
  rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hpos]
  exact (div_le_one hpos).mpr
    (norm_candidate_Q_pure_subset_fiber_le_factorial_pow hcL hr hj emb hemb hpure twist htwist n)


end Bounty
end

section

/- Polynomial Schwartz bounds transfer to polynomial Fourier L1 moments. -/

open Finset MeasureTheory
open scoped FourierTransform

namespace Bounty

theorem fourier_seminorm_polynomial {I : Type*}
    (f : I → SchwartzMap (EuclideanSpace ℝ (Fin 3)) ℂ) (w : I → ℝ)
    (hw : ∀ p, 1 ≤ w p)
    (hsemi : ∀ k n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p, SchwartzMap.seminorm ℂ k n (f p) ≤ C*(w p)^d) :
    ∀ k n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p, SchwartzMap.seminorm ℂ k n (𝓕 (f p)) ≤ C*(w p)^d := by
  intro k n
  let T := FourierTransform.fourierCLM ℂ (SchwartzMap (EuclideanSpace ℝ (Fin 3)) ℂ)
  let q := (SchwartzMap.seminorm ℂ k n).comp T.toLinearMap
  have hq : Continuous q :=
    ((schwartz_withSeminorms ℂ (EuclideanSpace ℝ (Fin 3)) ℂ).continuous_seminorm (k,n)).comp T.continuous
  exact continuous_schwartz_seminorm_polynomial f w hw hsemi q hq

theorem fourier_moment_polynomial_of_seminorm_bounds {I : Type*}
    (f : I → SchwartzMap (EuclideanSpace ℝ (Fin 3)) ℂ) (w : I → ℝ)
    (hw : ∀ p, 1 ≤ w p)
    (hsemi : ∀ k n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p, SchwartzMap.seminorm ℂ k n (f p) ≤ C*(w p)^d)
    (M : ℕ) :
    ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ p,
      (∫ ξ : EuclideanSpace ℝ (Fin 3), ‖ξ‖^M*‖𝓕 (f p) ξ‖) ≤ C*(w p)^d := by
  let N := (volume : Measure (EuclideanSpace ℝ (Fin 3))).integrablePower
  let B : ℝ := 2^N*(∫ ξ : EuclideanSpace ℝ (Fin 3), (1+‖ξ‖)^(-(N : ℝ)))
  have hB : 0 ≤ B := by
    apply mul_nonneg (by positivity)
    exact integral_nonneg (fun ξ => Real.rpow_nonneg (by positivity) _)
  obtain ⟨d0,C0,hC0,h0⟩ := fourier_seminorm_polynomial f w hw hsemi 0 0
  obtain ⟨d1,C1,hC1,h1⟩ := fourier_seminorm_polynomial f w hw hsemi (M+N) 0
  refine ⟨d0+d1,B*(C0+C1),mul_nonneg hB (add_nonneg hC0 hC1),?_⟩
  intro p
  have h0' : SchwartzMap.seminorm ℂ 0 0 (𝓕 (f p)) ≤ C0*(w p)^(d0+d1) :=
    (h0 p).trans (mul_le_mul_of_nonneg_left
      (pow_le_pow_right₀ (hw p) (Nat.le_add_right d0 d1)) hC0)
  have h1' : SchwartzMap.seminorm ℂ (M+N) 0 (𝓕 (f p)) ≤ C1*(w p)^(d0+d1) :=
    (h1 p).trans (mul_le_mul_of_nonneg_left
      (pow_le_pow_right₀ (hw p) (Nat.le_add_left d1 d0)) hC1)
  have hi := (𝓕 (f p)).integral_pow_mul_iteratedFDeriv_le ℂ volume M 0
  simp only [norm_iteratedFDeriv_zero] at hi
  calc
    _ ≤ B*(SchwartzMap.seminorm ℂ 0 0 (𝓕 (f p)) +
        SchwartzMap.seminorm ℂ (M+N) 0 (𝓕 (f p))) := hi
    _ ≤ B*(C0*(w p)^(d0+d1)+C1*(w p)^(d0+d1)) :=
      mul_le_mul_of_nonneg_left (add_le_add h0' h1') hB
    _ = _ := by ring

theorem fourier_moment_polynomial_of_fixed_support {I : Type*}
    (f : I → SchwartzMap (EuclideanSpace ℝ (Fin 3)) ℂ) (w : I → ℝ)
    (hw : ∀ p, 1 ≤ w p) (R : ℝ) (hR : 0 ≤ R)
    (hsupport : ∀ p, tsupport (f p) ⊆ Metric.closedBall 0 R)
    (hderiv : ∀ n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p x, ‖iteratedFDeriv ℝ n (f p) x‖ ≤ C*(w p)^d)
    (M : ℕ) :
    ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ p,
      (∫ ξ : EuclideanSpace ℝ (Fin 3), ‖ξ‖^M*‖𝓕 (f p) ξ‖) ≤ C*(w p)^d :=
  fourier_moment_polynomial_of_seminorm_bounds f w hw
    (schwartz_seminorm_polynomial_of_fixed_support f w hw R hR hsupport hderiv) M

theorem fourier_L1_polynomial_of_fixed_support {I : Type*}
    (f : I → SchwartzMap (EuclideanSpace ℝ (Fin 3)) ℂ) (w : I → ℝ)
    (hw : ∀ p, 1 ≤ w p) (R : ℝ) (hR : 0 ≤ R)
    (hsupport : ∀ p, tsupport (f p) ⊆ Metric.closedBall 0 R)
    (hderiv : ∀ n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p x, ‖iteratedFDeriv ℝ n (f p) x‖ ≤ C*(w p)^d) :
    ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ p,
      (∫ ξ : EuclideanSpace ℝ (Fin 3), ‖𝓕 (f p) ξ‖) ≤ C*(w p)^d := by
  simpa only [pow_zero, one_mul] using
    fourier_moment_polynomial_of_fixed_support f w hw R hR hsupport hderiv 0

end Bounty
end

section

/- Unit Mellin phases and exact separation at the two product endpoints. -/

open scoped ComplexConjugate

namespace Bounty

noncomputable def typeIIPhase (t : ℝ) (n : ℕ) : ℂ :=
  Complex.exp (Complex.I * ((t * Real.log (n : ℝ) : ℝ) : ℂ))

theorem typeIIPhase_zero (n : ℕ) : typeIIPhase 0 n = 1 := by
  simp [typeIIPhase]

theorem typeIIPhase_one (t : ℝ) : typeIIPhase t 1 = 1 := by
  simp [typeIIPhase]

theorem typeIIPhase_add (s t : ℝ) (n : ℕ) :
    typeIIPhase (s + t) n = typeIIPhase s n * typeIIPhase t n := by
  unfold typeIIPhase
  rw [← Complex.exp_add]
  congr 1
  push_cast
  ring

theorem typeIIPhase_mul (t : ℝ) {m n : ℕ} (hm : 0 < m) (hn : 0 < n) :
    typeIIPhase t (m * n) = typeIIPhase t m * typeIIPhase t n := by
  unfold typeIIPhase
  rw [Nat.cast_mul, Real.log_mul (Nat.cast_ne_zero.mpr hm.ne') (Nat.cast_ne_zero.mpr hn.ne'),
    ← Complex.exp_add]
  congr 1
  push_cast
  ring

theorem typeIIPhase_conj (t : ℝ) (n : ℕ) :
    conj (typeIIPhase t n) = typeIIPhase (-t) n := by
  unfold typeIIPhase
  rw [← Complex.exp_conj, map_mul, Complex.conj_I, Complex.conj_ofReal]
  congr 1
  push_cast
  ring

theorem typeIIPhase_norm (t : ℝ) (n : ℕ) : ‖typeIIPhase t n‖ = 1 :=
  Complex.norm_exp_I_mul_ofReal _

theorem typeIIPhase_mul_conj (t : ℝ) (n : ℕ) :
    typeIIPhase t n * conj (typeIIPhase t n) = 1 := by
  rw [typeIIPhase_conj, ← typeIIPhase_add, add_neg_cancel, typeIIPhase_zero]

theorem typeIIPhase_eq_cpow (t : ℝ) {n : ℕ} (hn : 0 < n) :
    typeIIPhase t n = (n : ℂ) ^ ((t : ℂ) * Complex.I) := by
  have hnC : (n : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hn.ne'
  rw [Complex.cpow_def_of_ne_zero hnC]
  have hlog : Complex.log (n : ℂ) = (Real.log (n : ℝ) : ℂ) := by
    exact (Complex.ofReal_log (Nat.cast_nonneg n)).symm
  rw [hlog]
  unfold typeIIPhase
  congr 1
  push_cast
  ring

theorem typeIIPhase_div_nat_eq_harmonicMellinWeight (t : ℝ) (n : ℕ) :
    typeIIPhase t n / (n : ℂ) = harmonicMellinWeight t (n : ℝ) := by
  simp only [typeIIPhase, harmonicMellinWeight, Complex.ofReal_natCast]

/-- With endpoints `m' * h` and `m * h'`, the residual phase separates exactly. -/
theorem typeIIPhase_endpoint_factorization (ξ₁ ξ₂ ξ₃ ρ : ℝ)
    {m m' h h' : ℕ} (hm : 0 < m) (hm' : 0 < m') (hh : 0 < h) (hh' : 0 < h') :
    typeIIPhase ξ₁ m * typeIIPhase ξ₂ m' * typeIIPhase ξ₃ (m' * h) *
        typeIIPhase ρ h * conj (typeIIPhase ρ h') =
      typeIIPhase (ρ + ξ₃) (m' * h) * typeIIPhase (-ρ) (m * h') *
        conj (typeIIPhase (ρ - ξ₂) m') * typeIIPhase (ξ₁ + ρ) m := by
  rw [typeIIPhase_conj, typeIIPhase_conj]
  simp only [typeIIPhase, Nat.cast_mul,
    Real.log_mul (Nat.cast_ne_zero.mpr hm'.ne') (Nat.cast_ne_zero.mpr hh.ne'),
    Real.log_mul (Nat.cast_ne_zero.mpr hm.ne') (Nat.cast_ne_zero.mpr hh'.ne'),
    ← Complex.exp_add]
  congr 1
  push_cast
  ring

theorem typeIIPhase_endpoint_factorization_of_eq (ξ₁ ξ₂ ξ₃ ρ : ℝ)
    {m m' h h' z w : ℕ} (hm : 0 < m) (hm' : 0 < m') (hh : 0 < h) (hh' : 0 < h')
    (hz : z = m' * h) (hw : w = m * h') :
    typeIIPhase ξ₁ m * typeIIPhase ξ₂ m' * typeIIPhase ξ₃ z *
        typeIIPhase ρ h * conj (typeIIPhase ρ h') =
      typeIIPhase (ρ + ξ₃) z * typeIIPhase (-ρ) w *
        conj (typeIIPhase (ρ - ξ₂) m') * typeIIPhase (ξ₁ + ρ) m := by
  subst z w
  exact typeIIPhase_endpoint_factorization ξ₁ ξ₂ ξ₃ ρ hm hm' hh hh'


end Bounty
end

section

/- Exact finite support masks for the divisor-based three-factor endpoint. -/

open Finset

namespace Bounty

theorem finite_triple_sum_eq_endpointTripleConvolution
    (M R C : Finset ℕ) (f g c : ℕ → ℂ) {n : ℕ} (hn : 0 < n) :
    (∑ m ∈ M, ∑ p ∈ R, ∑ r ∈ C,
      if m * p * r = n then f m * g p * c r else 0) =
      endpointTripleConvolution
        (fun m => if m ∈ M then f m else 0)
        (fun p => if p ∈ R then g p else 0)
        (fun r => if r ∈ C then c r else 0) n := by
  classical
  unfold endpointTripleConvolution
  apply sum_congr_of_eq_on_inter
  · intro m _ hm
    apply sum_eq_zero
    intro p _
    apply sum_eq_zero
    intro r _
    apply if_neg
    intro heq
    apply hm
    exact Nat.mem_divisors.mpr ⟨⟨p * r, by simpa only [mul_assoc] using heq.symm⟩, hn.ne'⟩
  · intro m _ hm
    simp only [if_neg hm, zero_mul, sum_const_zero]
  · intro m hmM hmD
    have hmpos : 0 < m := Nat.pos_of_mem_divisors hmD
    have hmdvd : m ∣ n := Nat.dvd_of_mem_divisors hmD
    have hmprod : m * (n / m) = n := Nat.mul_div_cancel' hmdvd
    have hnmpos : 0 < n / m := by
      apply Nat.pos_of_ne_zero
      intro hz
      rw [hz, mul_zero] at hmprod
      exact hn.ne' hmprod.symm
    simp only [if_pos hmM]
    apply sum_congr_of_eq_on_inter
    · intro p _ hp
      apply sum_eq_zero
      intro r _
      apply if_neg
      intro heq
      apply hp
      have hquot : n / m = p * r :=
        Nat.div_eq_of_eq_mul_right hmpos (by simpa only [mul_assoc] using heq.symm)
      exact Nat.mem_divisors.mpr ⟨⟨r, hquot⟩, hnmpos.ne'⟩
    · intro p _ hp
      simp only [if_neg hp, mul_zero, zero_mul]
    · intro p hpR hpD
      have hppos : 0 < p := Nat.pos_of_mem_divisors hpD
      have hpdvd : p ∣ n / m := Nat.dvd_of_mem_divisors hpD
      have hpprod : p * (n / m / p) = n / m := Nat.mul_div_cancel' hpdvd
      have heq (r : ℕ) : m * p * r = n ↔ r = n / m / p := by
        constructor
        · intro h
          have hquot : n / m = p * r :=
            Nat.div_eq_of_eq_mul_right hmpos (by simpa only [mul_assoc] using h.symm)
          exact (Nat.div_eq_of_eq_mul_right hppos hquot).symm
        · intro h
          rw [h, mul_assoc, hpprod, hmprod]
      simp only [heq, if_pos hpR]
      rw [sum_ite_eq']
      split_ifs <;> simp

theorem finite_triple_sum_eq_endpointTripleConvolution_of_nonzero_support
    (M R C : Finset ℕ) (f g c : ℕ → ℂ)
    (hM : 0 ∉ M) (hR : 0 ∉ R) (hC : 0 ∉ C) (n : ℕ) :
    (∑ m ∈ M, ∑ p ∈ R, ∑ r ∈ C,
      if m * p * r = n then f m * g p * c r else 0) =
      endpointTripleConvolution
        (fun m => if m ∈ M then f m else 0)
        (fun p => if p ∈ R then g p else 0)
        (fun r => if r ∈ C then c r else 0) n := by
  classical
  by_cases hn : n = 0
  · subst n
    rw [endpointTripleConvolution, Nat.divisors_zero, sum_empty]
    apply sum_eq_zero
    intro m hm
    apply sum_eq_zero
    intro p hp
    apply sum_eq_zero
    intro r hr
    exact if_neg (mul_ne_zero (mul_ne_zero (ne_of_mem_of_not_mem hm hM)
      (ne_of_mem_of_not_mem hp hR)) (ne_of_mem_of_not_mem hr hC))
  · exact finite_triple_sum_eq_endpointTripleConvolution M R C f g c (Nat.pos_of_ne_zero hn)


end Bounty
end

section

/- A common forest expansion absorbs root-dependent initial avoidance into initial birth addresses. -/

open Finset Classical

namespace Bounty

def initialBirthIndexedPerformed {I J α : Type*} {m : ℕ} (e : Fin m ≃ I ⊕ J)
    (initial : I → α) (birth : J → Option α) (i : Fin m) : Prop :=
  (initialAndBirthLabels initial birth (e i)).isSome = true

def initialBirthIndexedValue {I J α : Type*} {m : ℕ} (e : Fin m ≃ I ⊕ J)
    (encode : α → ℤ) (initial : I → α) (birth : J → Option α) (i : Fin m) : ℤ :=
  ((initialAndBirthLabels initial birth (e i)).map encode).getD 0

theorem initial_birth_indexed_distinct_iff {I J α : Type*} {m : ℕ}
    (e : Fin m ≃ I ⊕ J) (encode : α → ℤ) (hencode : Function.Injective encode)
    (initial : I → α) (birth : J → Option α) :
    birthValuesDistinct (initialBirthIndexedPerformed e initial birth)
      (initialBirthIndexedValue e encode initial birth) ↔
      Function.Injective initial ∧
        (∀ a b z, birth a = some z → birth b = some z → a = b) ∧
        (∀ i j, birth j ≠ some (initial i)) := by
  change birthValuesDistinct
    (fun i => (initialAndBirthLabels initial birth (e i)).isSome = true)
    (fun i => ((initialAndBirthLabels initial birth (e i)).map encode).getD 0) ↔ _
  rw [birth_values_distinct_option_equiv_iff e _ _ (fun _ => Iff.rfl) encode hencode,
    optional_label_injOn_iff_same_some _ _ (fun _ => Iff.rfl)]
  exact initial_birth_distinctness_iff initial birth

theorem initial_birth_path_forest_expansion {Ω I J α : Type*} {m : ℕ}
    (paths : Finset Ω) (e : Fin m ≃ I ⊕ J) (encode : α → ℤ)
    (hencode : Function.Injective encode) (initial : Ω → I → α)
    (birth : Ω → J → Option α) (w : Ω → ℂ)
    (hinitial : ∀ ω ∈ paths, Function.Injective (initial ω)) :
    (∑ ω ∈ paths,
      (if ∀ i j, birth ω j ≠ some (initial ω i) then (1 : ℂ) else 0) *
      (if ∀ a b z, birth ω a = some z → birth ω b = some z → a = b then (1 : ℂ) else 0) * w ω) =
      ∑ code : BirthForestCode m, (-1 : ℂ) ^ birthForestRank code *
        birthForestPathSum paths w
          (fun ω => initialBirthIndexedPerformed e (initial ω) (birth ω))
          (fun ω => initialBirthIndexedValue e encode (initial ω) (birth ω)) code := by
  rw [← distinct_birth_path_expansion]
  unfold distinctBirthPathSum
  apply sum_congr rfl
  intro ω hω
  rw [initial_birth_indexed_distinct_iff e encode hencode]
  by_cases hd : ∀ a b z, birth ω a = some z → birth ω b = some z → a = b <;>
    by_cases ha : ∀ i j, birth ω j ≠ some (initial ω i) <;>
    simp [hinitial ω hω, hd, ha]

end Bounty
end

section

/- Joint and full-state dilation congruence preserves both joint caps. -/

open Finset
namespace Bounty
section Joint
variable {G : Type*} {P : G → Type*}
  (n : ∀ g, P g → ℕ) (Δ D D' : G → ℤ)
  (hD : ∀ g p, ((n g p : ℤ) ∣ D g ↔ (n g p : ℤ) ∣ D' g))
  (t : G → ℕ) (B : ℕ)

def unrestrictedJointDilationEventEquiv
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) :
    UnrestrictedJointEvent n Δ D t B s ≃ UnrestrictedJointEvent n Δ D' t B s :=
  Equiv.piCongrRight (fun g => unrestrictedDilationEventEquiv (n g) (Δ g) (D g) (D' g) (hD g) (s g))

theorem unrestricted_joint_dilation_target
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B)
    (e : UnrestrictedJointEvent n Δ D t B s) :
    unrestrictedJointEventTarget n Δ D' t B s (unrestrictedJointDilationEventEquiv n Δ D D' hD t B s e) =
      unrestrictedJointEventTarget n Δ D t B s e := by
  funext g
  exact unrestricted_dilation_event_target (n g) (Δ g) (D g) (D' g) (hD g) (s g) (e g)

theorem unrestricted_joint_dilation_weight [Fintype G]
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B)
    (e : UnrestrictedJointEvent n Δ D t B s) :
    unrestrictedJointCutoffEventWeight n Δ D' μ ρ V t B s
      (unrestrictedJointDilationEventEquiv n Δ D D' hD t B s e) =
    unrestrictedJointCutoffEventWeight n Δ D μ ρ V t B s e := by
  unfold unrestrictedJointCutoffEventWeight
  rw [unrestricted_joint_dilation_target]
  split_ifs
  · apply prod_congr rfl
    intro g _
    exact unrestricted_dilation_event_weight (n g) (Δ g) (D g) (D' g) (hD g) (μ g) ρ (V g) (s g) (e g)
  · rfl

end Joint
end Bounty
end

section

/- Polynomial Schwartz bounds transfer to polynomial Fourier L1 moments. -/

open Finset MeasureTheory
open scoped FourierTransform

namespace Bounty

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]

theorem fourier_domain_seminorm_polynomial {I : Type*}
    (f : I → SchwartzMap E ℂ) (w : I → ℝ)
    (hw : ∀ p, 1 ≤ w p)
    (hsemi : ∀ k n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p, SchwartzMap.seminorm ℂ k n (f p) ≤ C*(w p)^d) :
    ∀ k n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p, SchwartzMap.seminorm ℂ k n (𝓕 (f p)) ≤ C*(w p)^d := by
  intro k n
  let T := FourierTransform.fourierCLM ℂ (SchwartzMap E ℂ)
  let q := (SchwartzMap.seminorm ℂ k n).comp T.toLinearMap
  have hq : Continuous q :=
    ((schwartz_withSeminorms ℂ E ℂ).continuous_seminorm (k,n)).comp T.continuous
  exact continuous_schwartz_domain_seminorm_polynomial f w hw hsemi q hq

theorem fourier_domain_moment_polynomial_of_seminorm_bounds {I : Type*}
    (f : I → SchwartzMap E ℂ) (w : I → ℝ)
    (hw : ∀ p, 1 ≤ w p)
    (hsemi : ∀ k n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p, SchwartzMap.seminorm ℂ k n (f p) ≤ C*(w p)^d)
    (M : ℕ) :
    ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ p,
      (∫ ξ : E, ‖ξ‖^M*‖𝓕 (f p) ξ‖) ≤ C*(w p)^d := by
  let N := (volume : Measure E).integrablePower
  let B : ℝ := 2^N*(∫ ξ : E, (1+‖ξ‖)^(-(N : ℝ)))
  have hB : 0 ≤ B := by
    apply mul_nonneg (by positivity)
    exact integral_nonneg (fun ξ => Real.rpow_nonneg (by positivity) _)
  obtain ⟨d0,C0,hC0,h0⟩ := fourier_domain_seminorm_polynomial f w hw hsemi 0 0
  obtain ⟨d1,C1,hC1,h1⟩ := fourier_domain_seminorm_polynomial f w hw hsemi (M+N) 0
  refine ⟨d0+d1,B*(C0+C1),mul_nonneg hB (add_nonneg hC0 hC1),?_⟩
  intro p
  have h0' : SchwartzMap.seminorm ℂ 0 0 (𝓕 (f p)) ≤ C0*(w p)^(d0+d1) :=
    (h0 p).trans (mul_le_mul_of_nonneg_left
      (pow_le_pow_right₀ (hw p) (Nat.le_add_right d0 d1)) hC0)
  have h1' : SchwartzMap.seminorm ℂ (M+N) 0 (𝓕 (f p)) ≤ C1*(w p)^(d0+d1) :=
    (h1 p).trans (mul_le_mul_of_nonneg_left
      (pow_le_pow_right₀ (hw p) (Nat.le_add_left d1 d0)) hC1)
  have hi := (𝓕 (f p)).integral_pow_mul_iteratedFDeriv_le ℂ volume M 0
  simp only [norm_iteratedFDeriv_zero] at hi
  calc
    _ ≤ B*(SchwartzMap.seminorm ℂ 0 0 (𝓕 (f p)) +
        SchwartzMap.seminorm ℂ (M+N) 0 (𝓕 (f p))) := hi
    _ ≤ B*(C0*(w p)^(d0+d1)+C1*(w p)^(d0+d1)) :=
      mul_le_mul_of_nonneg_left (add_le_add h0' h1') hB
    _ = _ := by ring

theorem fourier_domain_moment_polynomial_of_fixed_support {I : Type*}
    (f : I → SchwartzMap E ℂ) (w : I → ℝ)
    (hw : ∀ p, 1 ≤ w p) (R : ℝ) (hR : 0 ≤ R)
    (hsupport : ∀ p, tsupport (f p) ⊆ Metric.closedBall 0 R)
    (hderiv : ∀ n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p x, ‖iteratedFDeriv ℝ n (f p) x‖ ≤ C*(w p)^d)
    (M : ℕ) :
    ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ p,
      (∫ ξ : E, ‖ξ‖^M*‖𝓕 (f p) ξ‖) ≤ C*(w p)^d :=
  fourier_domain_moment_polynomial_of_seminorm_bounds f w hw
    (schwartz_domain_seminorm_polynomial_of_fixed_support f w hw R hR hsupport hderiv) M

theorem fourier_domain_L1_polynomial_of_fixed_support {I : Type*}
    (f : I → SchwartzMap E ℂ) (w : I → ℝ)
    (hw : ∀ p, 1 ≤ w p) (R : ℝ) (hR : 0 ≤ R)
    (hsupport : ∀ p, tsupport (f p) ⊆ Metric.closedBall 0 R)
    (hderiv : ∀ n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p x, ‖iteratedFDeriv ℝ n (f p) x‖ ≤ C*(w p)^d) :
    ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ p,
      (∫ ξ : E, ‖𝓕 (f p) ξ‖) ≤ C*(w p)^d := by
  simpa only [pow_zero, one_mul] using
    fourier_domain_moment_polynomial_of_fixed_support f w hw R hR hsupport hderiv 0

end Bounty
end

section

/- Exact removal of a designated ordered mark, with no additional factorial or damping factor. -/

open Finset

namespace Bounty

theorem marked_divisor_factor_peel (q V : ℝ) (omega t : ℕ) :
    markedDivisorFactor q V omega (t + 1) =
      (omega : ℝ) / V * markedDivisorFactor q V (omega - 1) t := by
  cases omega with
  | zero => simp [markedDivisorFactor]
  | succ omega =>
    simp only [markedDivisorFactor, Nat.succ_descFactorial_succ,
      Nat.add_sub_add_right, Nat.add_sub_cancel_right, Nat.cast_mul, pow_succ,
      div_eq_mul_inv, mul_inv_rev]
    ring

theorem marked_divisor_factor_remove_prime {G : Type*}
    (P : G → Finset ℕ) (g : G) (hP : ∀ p ∈ P g, p.Prime)
    (q V : ℝ) (n t : ℕ) (hsq : ∀ p ∈ P g, ¬ p ^ 2 ∣ n) :
    markedDivisorFactor q V (physicalOmega P g (n : ℤ)) (t + 1) =
      (1 / V) * ∑ p ∈ P g, if p ∣ n then
        markedDivisorFactor q V (physicalOmega P g ((n / p : ℕ) : ℤ)) t else 0 := by
  classical
  rw [← sum_filter]
  have heq : ∑ p ∈ (P g).filter (fun p => p ∣ n),
      markedDivisorFactor q V (physicalOmega P g ((n / p : ℕ) : ℤ)) t =
      (physicalOmega P g (n : ℤ) : ℝ) *
        markedDivisorFactor q V (physicalOmega P g (n : ℤ) - 1) t := by
    calc
      _ = ∑ _p ∈ (P g).filter (fun p => p ∣ n),
          markedDivisorFactor q V (physicalOmega P g (n : ℤ) - 1) t := by
        apply sum_congr rfl
        intro p hp
        rw [physical_omega_div_simple_prime P g hP (mem_filter.mp hp).1
          (mem_filter.mp hp).2 (hsq p (mem_filter.mp hp).1)]
      _ = _ := by simp [physicalOmega, physicalDivisorPool, Int.natCast_dvd_natCast]
  rw [heq, marked_divisor_factor_peel]
  ring

theorem marked_divisor_factor_remove_prime_weighted {G : Type*}
    (P : G → Finset ℕ) (g : G) (hP : ∀ p ∈ P g, p.Prime)
    (q V : ℝ) (n t : ℕ) (hsq : ∀ p ∈ P g, ¬ p ^ 2 ∣ n)
    (f : ℕ → ℂ) (hf : ∀ p ∈ P g, p ∣ n → f (n / p) = f n) :
    (markedDivisorFactor q V (physicalOmega P g (n : ℤ)) (t + 1) : ℂ) * f n =
      (1 / (V : ℂ)) * ∑ p ∈ P g, if p ∣ n then
        (markedDivisorFactor q V (physicalOmega P g ((n / p : ℕ) : ℤ)) t : ℂ) * f (n / p)
        else 0 := by
  classical
  rw [marked_divisor_factor_remove_prime P g hP q V n t hsq]
  push_cast
  rw [mul_assoc, sum_mul]
  congr 1
  apply sum_congr rfl
  intro p hp
  by_cases hpn : p ∣ n
  · simp only [if_pos hpn, hf p hp hpn]
  · simp only [if_neg hpn, Complex.ofReal_zero, zero_mul]

end Bounty
end

section

/- A common initial-and-event birth allocation independent of every shared-slot pattern. -/

namespace Bounty
section Common
variable {J K : Type*} {N : ℕ} (M : Fin N → ℕ) (B : ℕ)

def fullMixedCommonCapacity : Option (J ⊕ K) → Fin N → ℕ
  | none, _ => 0
  | some (.inl _), _ => B
  | some (.inr _), g => M g

abbrev FullMixedCommonInitialAddress := (g : Fin N) × Fin (M g)

abbrev FullMixedCommonLocalAddress (tag : Option (J ⊕ K)) :=
  (g : Fin N) × Fin (fullMixedCommonCapacity M B tag g)

abbrev FullMixedCommonStepAddress (steps : List (Option (J ⊕ K))) :=
  (i : Fin steps.length) × FullMixedCommonLocalAddress M B (steps.get i)

abbrev FullMixedCommonBirthAddress (steps : List (Option (J ⊕ K))) :=
  FullMixedCommonInitialAddress M ⊕ FullMixedCommonStepAddress M B steps

def fullMixedCommonOwner (steps : List (Option (J ⊕ K))) :
    FullMixedCommonBirthAddress M B steps → Option (Fin steps.length)
  | .inl _ => none
  | .inr a => some a.1

theorem full_mixed_common_birth_card (steps : List (Option (J ⊕ K))) :
    Fintype.card (FullMixedCommonBirthAddress M B steps) =
      (∑ g, M g) + ∑ i : Fin steps.length, ∑ g, fullMixedCommonCapacity M B (steps.get i) g := by
  simp only [FullMixedCommonBirthAddress, FullMixedCommonInitialAddress, FullMixedCommonStepAddress,
    FullMixedCommonLocalAddress, Fintype.card_sum, Fintype.card_sigma, Fintype.card_fin]

theorem full_mixed_common_capacity_le (T : ℕ) (hM : ∀ g, M g ≤ T)
    (tag : Option (J ⊕ K)) (g : Fin N) : fullMixedCommonCapacity M B tag g ≤ max B T := by
  cases tag with
  | none => exact Nat.zero_le _
  | some tag =>
    cases tag with
    | inl j => exact le_max_left _ _
    | inr k => exact (hM g).trans (le_max_right _ _)

theorem full_mixed_common_birth_card_le (T : ℕ) (hM : ∀ g, M g ≤ T)
    (steps : List (Option (J ⊕ K))) :
    Fintype.card (FullMixedCommonBirthAddress M B steps) ≤
      N * T + steps.length * (N * max B T) := by
  rw [full_mixed_common_birth_card]
  apply add_le_add
  · calc
      (∑ g, M g) ≤ ∑ _g : Fin N, T := Finset.sum_le_sum (fun g _ => hM g)
      _ = N * T := by simp
  · calc
      (∑ i : Fin steps.length, ∑ g, fullMixedCommonCapacity M B (steps.get i) g) ≤
          ∑ _i : Fin steps.length, ∑ _g : Fin N, max B T := by
        exact Finset.sum_le_sum (fun i _ => Finset.sum_le_sum
          (fun g _ => full_mixed_common_capacity_le M B T hM (steps.get i) g))
      _ = steps.length * (N * max B T) := by simp

end Common
end Bounty
end

section

/- Optional-label extension commutes with owner-indexed sums and preserves performed status. -/

open Classical
namespace Bounty

theorem optional_birth_extension_performed_iff {A B Z : Type*} (e : A ↪ B)
    (label : A → Option Z) (b : B) :
    (optionalBirthExtension e label b).isSome = true ↔
      ∃ a, e a = b ∧ (label a).isSome = true := by
  constructor
  · intro h
    by_cases hb : ∃ a, e a = b
    · obtain ⟨a, rfl⟩ := hb
      exact ⟨a, rfl, by simpa only [optional_birth_extension_apply] using h⟩
    · rw [optional_birth_extension_none e label b hb] at h
      cases h
  · rintro ⟨a, rfl, ha⟩
    simpa only [optional_birth_extension_apply] using ha

theorem optional_birth_extension_sigma {I Z : Type*} {A B : I → Type*}
    (e : ∀ i, A i ↪ B i) (label : (i : I) × A i → Option Z) (i : I) (b : B i) :
    optionalBirthExtension (Function.Embedding.sigmaMap (Function.Embedding.refl I) e) label ⟨i, b⟩ =
      optionalBirthExtension (e i) (fun a => label ⟨i, a⟩) b := by
  by_cases hb : ∃ a, e i a = b
  · obtain ⟨a, rfl⟩ := hb
    exact (optional_birth_extension_apply
      (Function.Embedding.sigmaMap (Function.Embedding.refl I) e) label ⟨i, a⟩).trans
      (optional_birth_extension_apply (e i) (fun a => label ⟨i, a⟩) a).symm
  · have hg : ¬∃ a, Function.Embedding.sigmaMap (Function.Embedding.refl I) e a = ⟨i, b⟩ := by
      rintro ⟨⟨j, a⟩, ha⟩
      have hj : j = i := congrArg Sigma.fst ha
      subst j
      change (⟨i, e i a⟩ : (j : I) × B j) = ⟨i, b⟩ at ha
      apply hb
      exact ⟨a, by simpa using ha⟩
    rw [optional_birth_extension_none _ _ _ hg, optional_birth_extension_none _ _ _ hb]

end Bounty
end

section

/- An actual nonnegative normalized smooth kernel for local Fourier energy. -/

open MeasureTheory Set
open scoped ContDiff FourierTransform NNReal

namespace Bounty

noncomputable def localMellinKernelBase (x : ℝ) : ℝ :=
  typeIISmoothRho 1 ((16 * Real.pi + 1) * x)

theorem local_mellin_kernel_base_contDiff : ContDiff ℝ ∞ localMellinKernelBase := by
  have h := typeII_smooth_rho_contDiff 1
  unfold localMellinKernelBase
  fun_prop

theorem local_mellin_kernel_base_support {x : ℝ}
    (hx : 2 / (16 * Real.pi + 1) < |x|) : localMellinKernelBase x = 0 := by
  apply typeII_smooth_rho_eq_zero
  intro hx'
  have ha : |(16 * Real.pi + 1) * x| ≤ 2 := by
    exact abs_le.mpr ⟨by linarith [hx'.1], by linarith [hx'.2]⟩
  rw [abs_mul, abs_of_pos (by positivity : 0 < 16 * Real.pi + 1)] at ha
  have hb := (div_lt_iff₀ (by positivity : 0 < 16 * Real.pi + 1)).mp hx
  nlinarith

theorem local_mellin_kernel_base_compact : HasCompactSupport localMellinKernelBase := by
  apply HasCompactSupport.intro (isCompact_Icc : IsCompact
    (Icc (-(2 / (16 * Real.pi + 1))) (2 / (16 * Real.pi + 1))))
  intro x hx
  apply local_mellin_kernel_base_support
  exact lt_of_not_ge (fun h => hx (abs_le.mp h))

theorem local_mellin_kernel_base_nonneg (x : ℝ) : 0 ≤ localMellinKernelBase x :=
  (typeII_smooth_rho_bounds _ _).1

theorem local_mellin_kernel_base_zero : localMellinKernelBase 0 = 1 := by
  apply typeII_smooth_rho_eq_one
  simp

theorem local_mellin_kernel_base_integral_pos : 0 < ∫ x, localMellinKernelBase x :=
  local_mellin_kernel_base_contDiff.continuous.integral_pos_of_hasCompactSupport_nonneg_nonzero
    local_mellin_kernel_base_compact local_mellin_kernel_base_nonneg
    (by rw [local_mellin_kernel_base_zero]; norm_num)

noncomputable def localMellinKernel (x : ℝ) : ℝ :=
  localMellinKernelBase x / ∫ y, localMellinKernelBase y

theorem local_mellin_kernel_contDiff : ContDiff ℝ ∞ localMellinKernel :=
  local_mellin_kernel_base_contDiff.div_const _

theorem local_mellin_kernel_compact : HasCompactSupport localMellinKernel := by
  unfold localMellinKernel
  simp only [div_eq_mul_inv]
  exact local_mellin_kernel_base_compact.mul_right

theorem local_mellin_kernel_nonneg (x : ℝ) : 0 ≤ localMellinKernel x :=
  div_nonneg (local_mellin_kernel_base_nonneg x) local_mellin_kernel_base_integral_pos.le

theorem local_mellin_kernel_integral : (∫ x, localMellinKernel x) = 1 := by
  unfold localMellinKernel
  simp only [div_eq_mul_inv]
  rw [integral_mul_const, mul_inv_cancel₀ local_mellin_kernel_base_integral_pos.ne']

theorem local_mellin_kernel_support {x : ℝ}
    (hx : 2 / (16 * Real.pi + 1) < |x|) : localMellinKernel x = 0 := by
  rw [localMellinKernel, local_mellin_kernel_base_support hx, zero_div]

noncomputable def localMellinKernelSchwartz : SchwartzMap ℝ ℂ :=
  (local_mellin_kernel_compact.comp_left (g := fun x : ℝ => (x : ℂ)) (by simp)).toSchwartzMap
    (Complex.ofRealCLM.contDiff.comp local_mellin_kernel_contDiff)

theorem local_mellin_kernel_lipschitz : ∃ C : ℝ≥0, LipschitzWith C localMellinKernelSchwartz :=
  ContDiff.lipschitzWith_of_hasCompactSupport
    (local_mellin_kernel_compact.comp_left (g := fun x : ℝ => (x : ℂ)) (by simp))
    (Complex.ofRealCLM.contDiff.comp local_mellin_kernel_contDiff) (by simp)

end Bounty
end

section

/- Weighted marked sums are exactly the unweighted mass times their conditional list average. -/

open Finset

namespace Bounty

noncomputable def groupMarkedAverage {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (t : G → ℕ) (n : ℤ) (b : GroupMarkedLists P t → ℂ) : ℂ := by
  classical
  exact (Fintype.card (GroupMarkedListsAt P t n) : ℂ)⁻¹ *
    ∑ L : GroupMarkedListsAt P t n, b L.val

noncomputable def weightedGroupMarkedSum {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (q : ℝ) (V : G → ℝ) (t : G → ℕ) (n : ℤ)
    (b : GroupMarkedLists P t → ℂ) : ℂ := by
  classical
  exact ((∏ g, q ^ (physicalOmega P g n - t g) / V g ^ t g : ℝ) : ℂ) *
    ∑ L : GroupMarkedListsAt P t n, b L.val

theorem weighted_group_marked_sum_eq_average {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (q : ℝ) (V : G → ℝ) (t : G → ℕ) (n : ℤ)
    (b : GroupMarkedLists P t → ℂ) :
    weightedGroupMarkedSum P q V t n b =
      (markedDivisorWeight univ P q V t n : ℂ) * groupMarkedAverage P t n b := by
  classical
  rw [marked_divisor_weight_eq_fiber_mass, Nat.card_eq_fintype_card]
  unfold weightedGroupMarkedSum groupMarkedAverage
  by_cases hzero : Fintype.card (GroupMarkedListsAt P t n) = 0
  · let : IsEmpty (GroupMarkedListsAt P t n) := Fintype.card_eq_zero_iff.mp hzero
    simp only [Fintype.sum_empty, mul_zero]
  · have hne : (Fintype.card (GroupMarkedListsAt P t n) : ℂ) ≠ 0 := by exact_mod_cast hzero
    push_cast
    field_simp

theorem group_marked_average_norm_le {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (t : G → ℕ) (n : ℤ) (b : GroupMarkedLists P t → ℂ)
    {H : ℝ} (hH : 0 ≤ H) (hb : ∀ L : GroupMarkedListsAt P t n, ‖b L.val‖ ≤ H) :
    ‖groupMarkedAverage P t n b‖ ≤ H := by
  classical
  by_cases hz : Fintype.card (GroupMarkedListsAt P t n) = 0
  · simp only [groupMarkedAverage, hz, Nat.cast_zero, inv_zero, zero_mul, norm_zero]
    exact hH
  · have hne : (Fintype.card (GroupMarkedListsAt P t n) : ℝ) ≠ 0 := by exact_mod_cast hz
    unfold groupMarkedAverage
    rw [norm_mul, norm_inv, Complex.norm_natCast]
    calc
      _ ≤ (Fintype.card (GroupMarkedListsAt P t n) : ℝ)⁻¹ *
          ∑ _L : GroupMarkedListsAt P t n, H := by
        apply mul_le_mul_of_nonneg_left _ (by positivity)
        exact (norm_sum_le _ _).trans (sum_le_sum (fun L _ => hb L))
      _ = H := by rw [sum_const, card_univ, nsmul_eq_mul, ← mul_assoc, inv_mul_cancel₀ hne, one_mul]

theorem weighted_group_marked_sum_norm_le {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {q : ℝ} (hq : 0 ≤ q) (V : G → ℝ)
    (hV : ∀ g, 0 ≤ V g) (t : G → ℕ) (n : ℤ) (b : GroupMarkedLists P t → ℂ)
    {H : ℝ} (hH : 0 ≤ H) (hb : ∀ L : GroupMarkedListsAt P t n, ‖b L.val‖ ≤ H) :
    ‖weightedGroupMarkedSum P q V t n b‖ ≤
      markedDivisorWeight univ P q V t n * H := by
  have hW := marked_divisor_weight_nonneg univ P hq V t (fun g _ => hV g) n
  rw [weighted_group_marked_sum_eq_average, norm_mul, Complex.norm_real,
    Real.norm_eq_abs, abs_of_nonneg hW]
  exact mul_le_mul_of_nonneg_left (group_marked_average_norm_le P t n b hH hb) hW

end Bounty
end

section

/- Uniform weighted bounds through two derivatives on a fixed logarithmic interval. -/

open Real

namespace Bounty

theorem exponential_profile_weighted_bounds (g f : SchwartzMap ℝ ℂ) (j : ℕ) (R : ℝ) :
    ∃ C₀ C₁ C₂ : ℝ, 0 ≤ C₀ ∧ 0 ≤ C₁ ∧ 0 ≤ C₂ ∧
      ∀ v u : ℝ, u ∈ Set.Icc (-R) R →
        (1+v^2)^((j : ℝ)/4)*‖exponentialProfile g f v u‖ ≤ C₀ ∧
        (1+v^2)^((j : ℝ)/4)*‖exponentialProfileFirst g f v u‖ ≤ C₁ ∧
        (1+v^2)^((j : ℝ)/4)*‖exponentialProfileSecond g f v u‖ ≤ C₂ := by
  let a := exp (-R)/(2*Real.pi)
  have ha : 0 < a := by dsimp [a]; positivity
  obtain ⟨B₀,hB₀,hf₀⟩ := schwartz_scaled_polynomial_weight_bound f j 0 ha
  obtain ⟨B₁,hB₁,hf₁⟩ := schwartz_scaled_polynomial_weight_bound (SchwartzMap.derivCLM ℂ ℂ f) j 1 ha
  obtain ⟨B₂,hB₂,hf₂⟩ := schwartz_scaled_polynomial_weight_bound
    (SchwartzMap.derivCLM ℂ ℂ (SchwartzMap.derivCLM ℂ ℂ f)) j 2 ha
  let G₀ := SchwartzMap.seminorm ℂ 0 0 g
  let G₁ := SchwartzMap.seminorm ℂ 0 0 (SchwartzMap.derivCLM ℂ ℂ g)
  let G₂ := SchwartzMap.seminorm ℂ 0 0 (SchwartzMap.derivCLM ℂ ℂ (SchwartzMap.derivCLM ℂ ℂ g))
  have hG₀ : 0 ≤ G₀ := by dsimp [G₀]; positivity
  have hG₁ : 0 ≤ G₁ := by dsimp [G₁]; positivity
  have hG₂ : 0 ≤ G₂ := by dsimp [G₂]; positivity
  refine ⟨G₀*B₀,G₁*B₀+G₀*B₁,G₂*B₀+(G₀+2*G₁)*B₁+G₀*B₂,
    by positivity,by positivity,by positivity,?_⟩
  intro v u hu
  let W := (1+v^2)^((j : ℝ)/4)
  let x := exponentialProfileArgument v u
  have hW : 0 ≤ W := by dsimp [W]; positivity
  have ht : a ≤ exp (-u)/(2*Real.pi) :=
    div_le_div_of_nonneg_right (exp_le_exp.mpr (neg_le_neg hu.2)) (by positivity)
  have hx : exp (-u)/(2*Real.pi)*v = x := by dsimp [x,exponentialProfileArgument]; ring
  have hb₀ : W*‖f x‖ ≤ B₀ := by simpa only [hx,pow_zero,mul_one] using hf₀ _ ht v
  have hb₁ : W* |x| *‖deriv f x‖ ≤ B₁ := by
    simpa only [hx,pow_one,SchwartzMap.derivCLM_apply] using hf₁ _ ht v
  have hb₂ : W* |x|^2*‖deriv (deriv f) x‖ ≤ B₂ := by
    have hh := hf₂ _ ht v
    rw [hx] at hh
    exact hh
  have hg₀ : ‖g u‖ ≤ G₀ := SchwartzMap.norm_le_seminorm ℂ g u
  have hg₁ : ‖deriv g u‖ ≤ G₁ := SchwartzMap.norm_le_seminorm ℂ (SchwartzMap.derivCLM ℂ ℂ g) u
  have hg₂ : ‖deriv (deriv g) u‖ ≤ G₂ :=
    SchwartzMap.norm_le_seminorm ℂ (SchwartzMap.derivCLM ℂ ℂ (SchwartzMap.derivCLM ℂ ℂ g)) u
  have hgc : ‖g u-2*deriv g u‖ ≤ G₀+2*G₁ := by
    calc
      _ ≤ ‖g u‖+‖(2 : ℂ)*deriv g u‖ := norm_sub_le _ _
      _ ≤ _ := by rw [norm_mul]; norm_num only [Complex.norm_ofNat]; gcongr
  refine ⟨?_,?_,?_⟩
  · change W*‖g u*f x‖ ≤ _
    rw [norm_mul]
    calc
      _ = ‖g u‖*(W*‖f x‖) := by ring
      _ ≤ _ := mul_le_mul hg₀ hb₀ (by positivity) hG₀
  · change W*‖deriv g u*f x-g u*(x : ℂ)*deriv f x‖ ≤ _
    calc
      _ ≤ W*(‖deriv g u*f x‖+‖g u*(x : ℂ)*deriv f x‖) :=
        mul_le_mul_of_nonneg_left (norm_sub_le _ _) hW
      _ = ‖deriv g u‖*(W*‖f x‖)+‖g u‖*(W* |x| *‖deriv f x‖) := by
        simp only [norm_mul,Complex.norm_real,Real.norm_eq_abs]; ring
      _ ≤ _ := add_le_add (mul_le_mul hg₁ hb₀ (by positivity) hG₁)
        (mul_le_mul hg₀ hb₁ (by positivity) hG₀)
  · change W*‖deriv (deriv g) u*f x+(g u-2*deriv g u)*(x : ℂ)*deriv f x+
      g u*(x : ℂ)^2*deriv (deriv f) x‖ ≤ _
    calc
      _ ≤ W*(‖deriv (deriv g) u*f x‖+‖(g u-2*deriv g u)*(x : ℂ)*deriv f x‖+
          ‖g u*(x : ℂ)^2*deriv (deriv f) x‖) :=
        mul_le_mul_of_nonneg_left ((norm_add_le _ _).trans
          (add_le_add (norm_add_le _ _) le_rfl)) hW
      _ = ‖deriv (deriv g) u‖*(W*‖f x‖)+‖g u-2*deriv g u‖*(W* |x| *‖deriv f x‖)+
          ‖g u‖*(W* |x|^2*‖deriv (deriv f) x‖) := by
        simp only [norm_mul,norm_pow,Complex.norm_real,Real.norm_eq_abs]; ring
      _ ≤ _ := add_le_add (add_le_add (mul_le_mul hg₂ hb₀ (by positivity) hG₂)
        (mul_le_mul hgc hb₁ (by positivity) (by positivity)))
        (mul_le_mul hg₀ hb₂ (by positivity) hG₀)

end Bounty
end

section

open MeasureTheory
open scoped ComplexConjugate

namespace Bounty

theorem squared_integral_eq_product_integral {f : ℝ → ℂ} (hf : Integrable f) :
    ‖∫ t : ℝ, f t‖^2 =
      ∫ p : ℝ × ℝ, (f p.1 * conj (f p.2)).re ∂(volume.prod volume) := by
  have hfc : Integrable (fun t => conj (f t)) := by
    apply hf.norm.mono'
    · exact Complex.continuous_conj.comp_aestronglyMeasurable hf.aestronglyMeasurable
    · filter_upwards [] with t
      simp only [Complex.norm_conj, le_refl]
  have hr := integral_re (hf.mul_prod hfc)
  change (∫ p : ℝ × ℝ, (f p.1 * conj (f p.2)).re ∂(volume.prod volume)) = _ at hr
  rw [hr, integral_prod_mul f (fun t => conj (f t)), integral_conj]
  change ‖∫ t : ℝ, f t‖^2 = ((∫ t : ℝ, f t) * conj (∫ t : ℝ, f t)).re
  rw [Complex.mul_conj, Complex.ofReal_re, Complex.normSq_eq_norm_sq]

theorem bounded_amplitude_integrable_slice
    {A : ℝ → ℝ → ℂ} {f : ℝ → ℂ} {M : ℝ}
    (hA : Continuous (Function.uncurry A)) (hf : Continuous f)
    (hfi : Integrable f) (hAb : ∀ u t, ‖A u t‖ ≤ M) (u : ℝ) :
    Integrable (fun t : ℝ => A u t * f t) := by
  apply (hfi.norm.const_mul M).mono' (by fun_prop)
  filter_upwards [] with t
  rw [norm_mul]
  exact mul_le_mul_of_nonneg_right (hAb u t) (norm_nonneg _)

theorem bounded_amplitude_energy_integrable
    (μ : Measure ℝ) [IsFiniteMeasure μ]
    {A : ℝ → ℝ → ℂ} {f : ℝ → ℂ} {M : ℝ}
    (hA : Continuous (Function.uncurry A)) (hf : Continuous f)
    (hfi : Integrable f) (hM : 0 ≤ M) (hAb : ∀ u t, ‖A u t‖ ≤ M) :
    Integrable (fun u : ℝ => ‖∫ t : ℝ, A u t * f t‖^2) μ := by
  have hc : Continuous (fun p : ℝ × ℝ => A p.1 p.2 * f p.2) := by fun_prop
  have hm : StronglyMeasurable (fun u : ℝ => ∫ t : ℝ, A u t * f t) :=
    hc.stronglyMeasurable.integral_prod_right'
  apply (integrable_const ((M * ∫ t : ℝ, ‖f t‖)^2)).mono'
  · exact (hm.norm.pow 2).aestronglyMeasurable
  · filter_upwards [] with u
    rw [Real.norm_of_nonneg (sq_nonneg _)]
    have hn : ‖∫ t : ℝ, A u t * f t‖ ≤ M * ∫ t : ℝ, ‖f t‖ := by
      rw [← integral_const_mul]
      apply norm_integral_le_of_norm_le (hfi.norm.const_mul M)
      filter_upwards [] with t
      rw [norm_mul]
      exact mul_le_mul_of_nonneg_right (hAb u t) (norm_nonneg _)
    exact pow_le_pow_left₀ (norm_nonneg _) hn 2

theorem bounded_amplitude_gram_energy
    (μ : Measure ℝ) [IsFiniteMeasure μ]
    {A : ℝ → ℝ → ℂ} {f : ℝ → ℂ} {M : ℝ}
    (hA : Continuous (Function.uncurry A)) (hf : Continuous f)
    (hfi : Integrable f) (hM : 0 ≤ M) (hAb : ∀ u t, ‖A u t‖ ≤ M) :
    Integrable (fun p : ℝ × ℝ =>
      ((∫ u : ℝ, A u p.1 * conj (A u p.2) ∂μ) *
        (f p.1 * conj (f p.2))).re) (volume.prod volume) ∧
    (∫ u : ℝ, ‖∫ t : ℝ, A u t * f t‖^2 ∂μ) =
      ∫ p : ℝ × ℝ,
        ((∫ u : ℝ, A u p.1 * conj (A u p.2) ∂μ) *
          (f p.1 * conj (f p.2))).re ∂(volume.prod volume) := by
  let B : ℝ → (ℝ × ℝ) → ℂ := fun u p =>
    (A u p.1 * conj (A u p.2)) * (f p.1 * conj (f p.2))
  have hBc : Continuous (Function.uncurry B) := by
    dsimp [B]
    fun_prop
  have hBb (u : ℝ) (p : ℝ × ℝ) : ‖B u p‖ ≤ M^2 * (‖f p.1‖ * ‖f p.2‖) := by
    dsimp [B]
    simp only [norm_mul, Complex.norm_conj]
    have hprod := mul_le_mul (hAb u p.1) (hAb u p.2) (norm_nonneg _) hM
    calc
      _ ≤ (M*M) * (‖f p.1‖ * ‖f p.2‖) :=
        mul_le_mul_of_nonneg_right hprod (mul_nonneg (norm_nonneg _) (norm_nonneg _))
      _ = _ := by ring
  have hBi : Integrable (Function.uncurry B) (μ.prod (volume.prod volume)) := by
    apply (((hfi.norm.mul_prod hfi.norm).const_mul (M^2)).comp_snd μ).mono'
      hBc.aestronglyMeasurable
    filter_upwards [] with p
    exact hBb p.1 p.2
  have hBui (p : ℝ × ℝ) : Integrable (fun u : ℝ => B u p) μ := by
    apply (integrable_const (M^2 * (‖f p.1‖ * ‖f p.2‖))).mono' (by fun_prop)
    filter_upwards [] with u
    exact hBb u p
  have hstart (u : ℝ) : ‖∫ t : ℝ, A u t * f t‖^2 =
      ∫ p : ℝ × ℝ, (B u p).re ∂(volume.prod volume) := by
    rw [squared_integral_eq_product_integral
      (bounded_amplitude_integrable_slice hA hf hfi hAb u)]
    apply integral_congr_ae
    filter_upwards [] with p
    dsimp [B]
    congr 1
    simp only [map_mul]
    ring
  have hfinish (p : ℝ × ℝ) : (∫ u : ℝ, (B u p).re ∂μ) =
      ((∫ u : ℝ, A u p.1 * conj (A u p.2) ∂μ) *
        (f p.1 * conj (f p.2))).re := by
    have hr := integral_re (hBui p)
    change (∫ u : ℝ, (B u p).re ∂μ) = _ at hr
    rw [hr]
    dsimp [B]
    rw [integral_mul_const]
  refine ⟨?_, ?_⟩
  · exact hBi.re.integral_prod_right.congr (Filter.Eventually.of_forall hfinish)
  calc
    _ = ∫ u : ℝ, ∫ p : ℝ × ℝ, (B u p).re ∂(volume.prod volume) ∂μ := by
      apply integral_congr_ae
      filter_upwards [] with u
      exact hstart u
    _ = ∫ p : ℝ × ℝ, ∫ u : ℝ, (B u p).re ∂μ ∂(volume.prod volume) :=
      integral_integral_swap hBi.re
    _ = _ := by
      apply integral_congr_ae
      filter_upwards [] with p
      exact hfinish p

theorem bounded_amplitude_energy_le_of_gram
    (μ : Measure ℝ) [IsFiniteMeasure μ]
    {A : ℝ → ℝ → ℂ} {f : ℝ → ℂ} {M : ℝ} {K : ℝ → ℝ}
    (hA : Continuous (Function.uncurry A)) (hf : Continuous f)
    (hfi : Integrable f) (hf2 : Integrable (fun t => ‖f t‖^2))
    (hM : 0 ≤ M) (hAb : ∀ u t, ‖A u t‖ ≤ M)
    (hK : Continuous K) (hKi : Integrable K)
    (hK0 : ∀ t, 0 ≤ K t) (hKe : ∀ t, K (-t) = K t)
    (hGram : ∀ t r, ‖∫ u : ℝ, A u t * conj (A u r) ∂μ‖ ≤ K (t-r)) :
    (∫ u : ℝ, ‖∫ t : ℝ, A u t * f t‖^2 ∂μ) ≤
      (∫ t : ℝ, K t) * ∫ t : ℝ, ‖f t‖^2 := by
  obtain ⟨hGramInt, hEq⟩ := bounded_amplitude_gram_energy μ hA hf hfi hM hAb
  rw [hEq]
  obtain ⟨hcross, hbound⟩ := schur_quadratic_bound hK hKi hK0 hKe hf hf2
  apply le_trans ?_ hbound
  apply integral_mono hGramInt hcross
  intro p
  calc
      _ ≤ ‖(∫ u : ℝ, A u p.1 * conj (A u p.2) ∂μ) *
          (f p.1 * conj (f p.2))‖ := Complex.re_le_norm _
      _ ≤ _ := by
        simp only [norm_mul, Complex.norm_conj]
        have := mul_le_mul_of_nonneg_right (hGram p.1 p.2)
          (mul_nonneg (norm_nonneg (f p.1)) (norm_nonneg (f p.2)))
        simpa only [mul_assoc] using this

end Bounty
end

section

/- A forest compatible with an injective initial prefix has no selected child in that prefix. -/

namespace Bounty

theorem birth_forest_no_child_in_injective_prefix {m : ℕ} {α : Type*}
    (code : BirthForestCode m) (performed initial : Fin m → Prop) (label : Fin m → α)
    (hdown : ∀ i j, i < j → initial j → initial i)
    (hinj : Set.InjOn label {i | initial i})
    (hcompat : birthForestCompatible performed label code) :
    ∀ j, initial j → code j = none := by
  intro j hj
  cases hc : code j with
  | none => rfl
  | some i =>
    have h := hcompat j
    rw [hc] at h
    have hlt : birthForestParentEmbedding j i < j := i.isLt
    have he := hinj (hdown _ _ hlt hj) hj h.2.2
    exact False.elim ((ne_of_lt hlt) he)

theorem birth_forest_initial_stage_trivial {m L : ℕ} {α : Type*}
    (owner : Fin m → Fin (L + 1)) (code : BirthForestCode m)
    (hcode : ∀ i, owner i = 0 → code i = none) (values : Fin m → Option α) :
    birthForestStageCondition owner 0 values code := by
  intro i hi
  rw [hcode i hi]
  trivial

end Bounty
end

section

open scoped BigOperators ComplexConjugate
open MeasureTheory

namespace Bounty

theorem interval_gram_norm_symm (u v : ℝ → ℂ) (a b : ℝ) :
    ‖∫ t in a..b, u t * conj (v t)‖ = ‖∫ t in a..b, v t * conj (u t)‖ := by
  rw [← Complex.norm_conj (∫ t in a..b, v t * conj (u t)),
    ← intervalIntegral.intervalIntegral_conj]
  congr 1
  apply intervalIntegral.integral_congr
  intro t _
  simp only [map_mul, starRingEnd_self_apply]
  ring

theorem interval_finite_gram_row_bound {ι : Type*} (s : Finset ι)
    (u : ι → ℝ → ℂ) (c : ι → ℂ) (a b B : ℝ)
    (hu : ∀ i ∈ s, Continuous (u i))
    (hrow : ∀ i ∈ s, (∑ j ∈ s, ‖∫ t in a..b, u i t * conj (u j t)‖) ≤ B) :
    (∫ t in a..b, ‖∑ i ∈ s, c i * u i t‖ ^ 2) ≤ B * ∑ i ∈ s, ‖c i‖ ^ 2 := by
  let K (i j : ι) : ℂ := ∫ t in a..b, u i t * conj (u j t)
  have hterm (i j : ι) :
      2 * (c i * conj (c j) * K i j).re ≤
        ‖c i‖ ^ 2 * ‖K i j‖ + ‖c j‖ ^ 2 * ‖K i j‖ := by
    have hre := Complex.re_le_norm (c i * conj (c j) * K i j)
    simp only [norm_mul, Complex.norm_conj] at hre
    nlinarith [mul_nonneg (sq_nonneg (‖c i‖ - ‖c j‖)) (norm_nonneg (K i j))]
  have hs := Finset.sum_le_sum (fun i (_ : i ∈ s) =>
    Finset.sum_le_sum (fun j (_ : j ∈ s) => hterm i j))
  have hswap : (∑ i ∈ s, ∑ j ∈ s, ‖c j‖ ^ 2 * ‖K i j‖) =
      ∑ i ∈ s, ‖c i‖ ^ 2 * ∑ j ∈ s, ‖K i j‖ := by
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro i _
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _
    rw [show ‖K j i‖ = ‖K i j‖ from interval_gram_norm_symm (u j) (u i) a b]
  simp only [Finset.sum_add_distrib] at hs
  simp_rw [← Finset.mul_sum] at hs
  rw [hswap] at hs
  have hm : (∑ i ∈ s, ∑ j ∈ s, (c i * conj (c j) * K i j).re) ≤
      ∑ i ∈ s, ‖c i‖ ^ 2 * ∑ j ∈ s, ‖K i j‖ := by linarith
  rw [interval_finite_gram_energy s u c a b hu]
  calc
    _ ≤ ∑ i ∈ s, ‖c i‖ ^ 2 * ∑ j ∈ s, ‖K i j‖ := hm
    _ ≤ ∑ i ∈ s, ‖c i‖ ^ 2 * B := Finset.sum_le_sum (fun i hi =>
      mul_le_mul_of_nonneg_left (hrow i hi) (sq_nonneg _))
    _ = _ := by rw [← Finset.sum_mul, mul_comm]

end Bounty
end

section

open scoped BigOperators ComplexConjugate
open MeasureTheory

namespace Bounty

theorem exponential_phase_gram (v w t : ℝ) :
    Complex.exp ((v * t : ℝ) * Complex.I) *
      conj (Complex.exp ((w * t : ℝ) * Complex.I)) =
      Complex.exp (((v - w) * t : ℝ) * Complex.I) := by
  rw [← Complex.exp_conj, ← Complex.exp_add]
  congr 1
  simp only [map_mul, Complex.conj_ofReal, Complex.conj_I]
  push_cast
  ring

theorem logarithmic_gram_off_diagonal {m n N : ℕ}
    (hm : 0 < m) (hn : m < n) (hnN : n ≤ N) (a b : ℝ) :
    ‖∫ t in a..b, Complex.exp ((Real.log (m : ℝ) * t : ℝ) * Complex.I) *
      conj (Complex.exp ((Real.log (n : ℝ) * t : ℝ) * Complex.I))‖ ≤
      2 * (N : ℝ) * ((n - m : ℕ) : ℝ)⁻¹ := by
  have hm0 : (0 : ℝ) < m := by exact_mod_cast hm
  have hmn : (m : ℝ) < n := by exact_mod_cast hn
  have hn0 : (0 : ℝ) < n := hm0.trans hmn
  have hN0 : (0 : ℝ) < N := hn0.trans_le (by exact_mod_cast hnN)
  have hlog : Real.log (m : ℝ) < Real.log (n : ℝ) := Real.strictMonoOn_log hm0 hn0 hmn
  have hgap := logarithmic_gap_lower hm0 hmn (show (n : ℝ) ≤ N by exact_mod_cast hnN)
  simp_rw [exponential_phase_gram]
  apply (oscillatory_interval_norm_le (sub_ne_zero.mpr hlog.ne)).trans
  rw [abs_of_neg (sub_neg.mpr hlog), neg_sub]
  have hdiff : (0 : ℝ) < n - m := sub_pos.mpr hmn
  calc
    2 / (Real.log (n : ℝ) - Real.log (m : ℝ)) ≤ 2 / (((n : ℝ) - m) / N) :=
      div_le_div_of_nonneg_left (by norm_num) (div_pos hdiff hN0) hgap
    _ = 2 * (N : ℝ) * ((n - m : ℕ) : ℝ)⁻¹ := by
      rw [Nat.cast_sub hn.le]
      field_simp

end Bounty
end

section

open Finset
open scoped ComplexConjugate

namespace Bounty

noncomputable def finiteShiftCorrelation (S : Finset ℤ) (f : ℤ → ℂ) (h : ℤ) : ℂ :=
  ∑ n ∈ S, f (n+h) * conj (f n)

theorem finite_shift_correlation_gram (S X : Finset ℤ) (f : ℤ → ℂ) (h k : ℤ)
    (hsupport : ∀ n, n ∉ S → f n = 0)
    (hcover : ∀ n ∈ S, n-k ∈ X) :
    (∑ x ∈ X, f (x+h) * conj (f (x+k))) = finiteShiftCorrelation S f (h-k) := by
  let g : ℤ → ℂ := fun n => f (n+(h-k)) * conj (f n)
  have hg : ∀ n, n ∉ S → g n = 0 := by
    intro n hn
    dsimp [g]
    rw [hsupport n hn, map_zero, mul_zero]
  have he := finite_translate_sum_eq S X g k hg hcover
  calc
    _ = ∑ x ∈ X, g (x+k) := by
      apply sum_congr rfl
      intro x hx
      dsimp [g]
      rw [show x+k+(h-k) = x+h by omega]
    _ = _ := he

theorem finite_shift_correlation_conj (S : Finset ℤ) (f : ℤ → ℂ) (h : ℤ)
    (hsupport : ∀ n, n ∉ S → f n = 0) :
    conj (finiteShiftCorrelation S f h) = finiteShiftCorrelation S f (-h) := by
  classical
  let X := S ∪ S.image (fun n => n-h)
  let g : ℤ → ℂ := fun n => f (n-h) * conj (f n)
  have hg : ∀ n, n ∉ S → g n = 0 := by
    intro n hn
    dsimp [g]
    rw [hsupport n hn, map_zero, mul_zero]
  have hcover (n : ℤ) (hn : n ∈ S) : n-h ∈ X :=
    mem_union_right S (mem_image.mpr ⟨n, hn, rfl⟩)
  have he := finite_translate_sum_eq S X g h hg hcover
  calc
    _ = ∑ n ∈ S, f n * conj (f (n+h)) := by
      simp only [finiteShiftCorrelation, map_sum, map_mul, starRingEnd_self_apply]
      apply sum_congr rfl
      intro n hn
      ring
    _ = ∑ n ∈ X, f n * conj (f (n+h)) := by
      apply sum_subset (subset_union_left : S ⊆ X)
      intro n hn hnS
      rw [hsupport n hnS, zero_mul]
    _ = ∑ n ∈ X, g (n+h) := by
      apply sum_congr rfl
      intro n hn
      dsimp [g]
      rw [add_sub_cancel_right]
    _ = ∑ n ∈ S, g n := he
    _ = _ := by simp only [g, finiteShiftCorrelation, sub_eq_add_neg]

theorem finite_shift_correlation_norm_neg (S : Finset ℤ) (f : ℤ → ℂ) (h : ℤ)
    (hsupport : ∀ n, n ∉ S → f n = 0) :
    ‖finiteShiftCorrelation S f (-h)‖ = ‖finiteShiftCorrelation S f h‖ := by
  rw [← finite_shift_correlation_conj S f h hsupport, Complex.norm_conj]

theorem finite_shift_correlation_zero_re (S : Finset ℤ) (f : ℤ → ℂ) :
    (finiteShiftCorrelation S f 0).re = ∑ n ∈ S, ‖f n‖^2 := by
  simp only [finiteShiftCorrelation, add_zero, Complex.mul_conj, Complex.re_sum,
    Complex.ofReal_re, Complex.normSq_eq_norm_sq]

theorem finite_translate_cauchy_correlation (S H X : Finset ℤ) (f : ℤ → ℂ)
    (hsupport : ∀ n, n ∉ S → f n = 0)
    (hcover : ∀ n ∈ S, ∀ h ∈ H, n-h ∈ X) :
    (H.card : ℝ)^2 * ‖∑ n ∈ S, f n‖^2 ≤
      (X.card : ℝ) * ∑ h ∈ H, ∑ k ∈ H, (finiteShiftCorrelation S f (h-k)).re := by
  apply (finite_translate_cauchy_gram S H X f hsupport hcover).trans_eq
  congr 1
  apply sum_congr rfl
  intro h hh
  apply sum_congr rfl
  intro k hk
  rw [finite_shift_correlation_gram S X f h k hsupport (fun n hn => hcover n hn k hk)]

end Bounty
end

