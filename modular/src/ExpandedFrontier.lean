variable {I J K G : Type*} [Fintype G] [DecidableEq G]
  (P : G → Finset ℕ) (V : G → ℝ) (baseline : ∀ g, P g → ℝ)
  (hpositive : ∀ g (p : P g), 0 < p.val)
  (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
  (hbaseline : ∀ g p, 1 / 2 ≤ baseline g p ∧ baseline g p ≤ 1)
  {M : G → ℕ} (S : I → K → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : ∀ i k, SharedActiveLabels (fun g => P g) (S i k) → Type*)
  [∀ i k c, Fintype (A i k c)]
  (Δ D : ∀ i k c, A i k c → G → ℤ) (ω : ∀ i k c, A i k c → ℝ)
