section Events
variable {P : Type*} [Fintype P] [DecidableEq P] {R : P → Type*}
  [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)] {a b : P → Bool}

noncomputable def globalBirthAmbientMemoryTarget (step : GlobalBirthRawStep (R := R) a b)
    (q : FiniteOrderedTuple (Σ p, R p)) (e : GlobalBirthAmbientEvent step q) :
    FiniteOrderedTuple (Σ p, R p) :=
  (globalBirthAmbientEventTarget step (∅, q) e).2

noncomputable def globalBirthAmbientLedgerUpdate (step : GlobalBirthRawStep (R := R) a b)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p)) (e : GlobalBirthAmbientEvent step q) : Finset P :=
  (globalBirthAmbientEventTarget step (H, q) e).1

theorem global_birth_ambient_target_pair (step : GlobalBirthRawStep (R := R) a b)
    (s : GlobalBirthHistoryState R) (e : GlobalBirthAmbientEvent step s.2) :
    globalBirthAmbientEventTarget step s e =
      (globalBirthAmbientLedgerUpdate step s.1 s.2 e, globalBirthAmbientMemoryTarget step s.2 e) := by
  cases step <;> rfl

end Events

section Paths
variable {P : Type*} [Fintype P] [DecidableEq P] {R : P → Type*}
  [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)]
  (a : ℕ → P → Bool) (steps : ∀ i, GlobalBirthRawStep (R := R) (a i) (a (i + 1)))

abbrev GlobalBirthMemoryEventPath (n : ℕ) (q : FiniteOrderedTuple (Σ p, R p)) :=
  FiniteEventPath (fun i => GlobalBirthAmbientEvent (steps i))
    (fun i => globalBirthAmbientMemoryTarget (steps i)) (List.range n) q

noncomputable def globalBirthMemoryPathAllowed (n : ℕ) (H : Finset P)
    (q : FiniteOrderedTuple (Σ p, R p)) (p : GlobalBirthMemoryEventPath a steps n q) : Prop :=
  finiteEventPathAllowed (fun i s => GlobalBirthAmbientEvent (steps i) s.2)
    (finiteLedgerEventTarget (fun i => GlobalBirthAmbientEvent (steps i))
      (fun i => globalBirthAmbientMemoryTarget (steps i))
      (fun i => globalBirthAmbientLedgerUpdate (steps i)))
    (fun i => globalBirthAmbientEventAllowed (steps i)) (List.range n) (H, q)
    ((finiteLedgerEventPathEquiv (fun i => GlobalBirthAmbientEvent (steps i))
      (fun i => globalBirthAmbientMemoryTarget (steps i))
      (fun i => globalBirthAmbientLedgerUpdate (steps i)) (List.range n) H q).symm p)

/-- The exact raw history is a sum on memory-only trajectories. All ledger
dependence is inside one pulled-back acceptance predicate. Signed weights,
event order, birth factorials and the terminal memory are unchanged. -/
theorem global_birth_raw_history_memory_paths (n : ℕ)
    (F : FiniteOrderedTuple (Σ p, R p) → ℂ) (H : Finset P)
    (q : FiniteOrderedTuple (Σ p, R p)) :
    let _ : ∀ i q, Fintype (GlobalBirthAmbientEvent (steps i) q) :=
      fun i q => globalBirthAmbientEventFintype (steps i) q
    globalBirthRawHistory a steps n (fun _ q => F q) H q =
      finiteEventPathAction (fun i => GlobalBirthAmbientEvent (steps i))
        (fun i => globalBirthAmbientMemoryTarget (steps i))
        (fun i => globalBirthAmbientEventWeight (steps i)) (List.range n)
        (fun q p => if globalBirthMemoryPathAllowed a steps n H q p then 1 else 0) F q := by
  let _ : ∀ i q, Fintype (GlobalBirthAmbientEvent (steps i) q) :=
    fun i q => globalBirthAmbientEventFintype (steps i) q
  let E := fun i => GlobalBirthAmbientEvent (steps i)
  let target := fun i => globalBirthAmbientMemoryTarget (steps i)
  let update := fun i => globalBirthAmbientLedgerUpdate (steps i)
  let allowed := fun i => globalBirthAmbientEventAllowed (steps i)
  let weight := fun i => globalBirthAmbientEventWeight (steps i)
  have hr : globalBirthHistoryRawRow a steps =
      finiteLocalEventAction (fun i s => E i s.2)
        (fun i s e => if allowed i s e then weight i s.2 e else 0)
        (finiteLedgerEventTarget E target update) := by
    funext i G s
    unfold globalBirthHistoryRawRow finiteLocalEventAction
    rw [global_birth_raw_step_ambient_event_sum]
    apply sum_congr rfl
    intro e _
    rw [global_birth_ambient_target_pair]
    rfl
  have he : globalBirthRawHistory a steps n (fun _ q => F q) H q =
      finiteEventPathAction (fun i s => E i s.2)
        (finiteLedgerEventTarget E target update)
        (fun i s e => if allowed i s e then weight i s.2 e else 0)
        (List.range n) (fun _ _ => 1) (fun s => F s.2) (H, q) := by
    unfold globalBirthRawHistory
    rw [hr, finite_row_composition_eq_event_paths, finite_event_path_action_one]
  rw [he, finite_event_path_action_restrict]
  change finiteEventPathAction (fun i s => E i s.2)
      (finiteLedgerEventTarget E target update) (fun i s => weight i s.2)
      (List.range n)
      (fun s p => if finiteEventPathAllowed (fun i s => E i s.2)
        (finiteLedgerEventTarget E target update) allowed (List.range n) s p then 1 else 0)
      (fun s => F s.2) (H, q) = _
  exact finite_ledger_event_path_action_memory E target update weight (List.range n) _ F H q

end Paths
end

section
open Finset Classical
theorem physical_ghost_retention_nonneg {P : Type*} (n : P → ℕ)
    {q ρ : ℝ} (hq : 0 ≤ q) (z : UnrestrictedResidueParticle n) :
    0 ≤ physicalGhostRetention n q ρ z := by
  unfold physicalGhostRetention
  split_ifs
  · exact div_nonneg hq (sq_nonneg _)
  · exact zero_le_one

theorem physical_absolute_joint_ghost_action_eq
    {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] (μ : ∀ g, P g → ℝ)
    (q ρ : ℝ) (V : G → ℝ) (t : G → ℕ) (B : ℕ)
    (hq : 0 ≤ q) (hμ : ∀ g p, 0 ≤ μ g p)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) :
    (∑ e : CoupledGhostEvent t B s,
      ((|coupledGhostJointEventWeight
        (fun g => physicalGhostRetention (n g) q ρ)
        (fun g => physicalGhostTermination (n g) q ρ)
        (fun g => physicalGhostBirth (n g) q ρ (V g))
        (fun g => unrestrictedResidueWeight (μ g)) t B s e| : ℝ) : ℂ) *
        f (coupledGhostJointEventTarget t B s e)) =
      physicalAbsoluteGhostCutoffProductOperator n μ q ρ V t B univ f s := by
  simp_rw [coupledGhostJointEventWeight_abs
    (fun g => physicalGhostRetention (n g) q ρ)
    (fun g => physicalGhostTermination (n g) q ρ)
    (fun g => physicalGhostBirth (n g) q ρ (V g))
    (fun g => unrestrictedResidueWeight (μ g))
    (fun g z => physical_ghost_retention_nonneg (n g) hq z) (fun g z => hμ g z.1) t B s]
  have he := coupled_ghost_cutoff_eq_joint_event_sum
    (fun g => physicalGhostRetention (n g) q ρ)
    (fun g z => |physicalGhostTermination (n g) q ρ z|)
    (fun g z => |physicalGhostBirth (n g) q ρ (V g) z|)
    (fun g => unrestrictedResidueWeight (μ g)) t B (fun _ _ => 1) f s
  simp only [mul_one] at he
  refine Eq.trans ?_ (congrFun (coupled_ghost_cutoff_one_eq_coordinate_action
    (fun g => physicalGhostRetention (n g) q ρ)
    (fun g z => |physicalGhostTermination (n g) q ρ z|)
    (fun g z => |physicalGhostBirth (n g) q ρ (V g) z|)
    (fun g => unrestrictedResidueWeight (μ g)) t B f) s)
  refine Eq.trans ?_ he.symm
  apply sum_congr
  · ext e
    simp only [mem_univ]
  · intro e _
    rfl

theorem physical_absolute_ghost_cutoff_symmetric
    {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] (μ : ∀ g, P g → ℝ)
    (q ρ : ℝ) (V : G → ℝ) (t : G → ℕ) (B : ℕ) (groups : Finset G)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric (physicalAbsoluteGhostCutoffProductOperator n μ q ρ V t B groups f) := by
  apply product_memory_cutoff_sandwich_symmetric
  · intro g h hh
    exact bounded_ordered_ghost_symmetric _ _ _ _ (t g) B h hh
  · exact hf
end

section
open scoped BigOperators Classical
theorem prime_tuple_log_cell_correlation_bound (hZ : PrimitiveZeroFreeHalfPlane) :
    ∃ C : ℝ, 0 < C ∧ ∀ (q r : ℕ), 0 < q → 0 < r →
      ∀ (χ : DirichletCharacter ℂ q) (ψ : DirichletCharacter ℂ r),
      χ.IsPrimitive → ψ.IsPrimitive →
      (⟨q, χ⟩ : (n : ℕ) × DirichletCharacter ℂ n) ≠ ⟨r, ψ⟩ →
      ∀ {I : Type*} [Fintype I] [DecidableEq I],
      ∀ (P : I → Finset ℕ) (V : I → ℝ) (i : I),
      (∀ j, 0 < V j) → (∀ j p, p ∈ P j → 0 < p) →
      (∀ j, ∑ p ∈ P j, 1 / (p : ℝ) = V j) →
      ∀ a b : ℝ, P i = primeBand a b → 2 ≤ a → 0 ≤ b →
      ∀ h : ℝ, 0 < h → ∀ d : ℤ,
        ‖∑ x : (∀ j, P j),
          if upperLogCell h (Real.log (∏ j, (x j).val : ℕ)) = d then
            (finiteProductWeight (physicalLabelLaw V) x : ℂ) *
              χ ((∏ j, (x j).val : ℕ) : ZMod q) *
              star (ψ ((∏ j, (x j).val : ℕ) : ZMod r)) else 0‖ ≤
            (C / V i) * a ^ (-(1 : ℝ) / 32) * (1 + Real.log (q * r : ℕ) / Real.log a) := by
  obtain ⟨C, hC, hbound⟩ := prime_tuple_cell_correlation_bound hZ
  refine ⟨C, hC, ?_⟩
  intro q r hq hr χ ψ hχ hψ hne I _ _ P V i hV hp hmass a b hPi ha hb h hh d
  let U := Real.exp (((d : ℝ) - 1) * h)
  let W := Real.exp ((d : ℝ) * h)
  have hbnd := hbound q r hq hr χ ψ hχ hψ hne P V i hV hp hmass a b hPi ha hb U W
    (Real.exp_pos _).le (Real.exp_pos _).le
  have heq (x : ∀ j, P j) :
      (if upperLogCell h (Real.log (∏ j, (x j).val : ℕ)) = d then
        (finiteProductWeight (physicalLabelLaw V) x : ℂ) *
          χ ((∏ j, (x j).val : ℕ) : ZMod q) *
          star (ψ ((∏ j, (x j).val : ℕ) : ZMod r)) else 0) =
      (finiteProductWeight (physicalLabelLaw V) x : ℂ) *
        (if U < ((∏ j, (x j).val : ℕ) : ℝ) ∧ ((∏ j, (x j).val : ℕ) : ℝ) ≤ W
        then χ ((∏ j, (x j).val : ℕ) : ZMod q) *
          star (ψ ((∏ j, (x j).val : ℕ) : ZMod r)) else 0) := by
    have hn : 0 < ∏ j, (x j).val := Finset.prod_pos (fun j _ => hp j _ (x j).property)
    simp only [upper_log_cell_nat_eq_iff hh hn]
    change (if U < _ ∧ _ ≤ W then _ else _) = _
    split_ifs <;> simp only [mul_assoc, mul_zero]
  rw [Finset.sum_congr rfl (fun x _ => heq x)]
  exact hbnd
end

