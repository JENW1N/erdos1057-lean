section

/- Group the unchanged fine tag schedule into visits and projected edges. -/

namespace Bounty

section Schedule
variable {X V : Type*} {n : ℕ}
  (row : Option (Fin (n + 1) ⊕ Fin n) → (X → V) → X → V)

noncomputable def finitePhysicalProjectedRow (i : ℕ) (F : X → V) : X → V :=
  if hi : i < 2 * n + 1 then
    if h0 : i % 2 = 0 then row (some (.inl ⟨i / 2, by omega⟩)) F
    else row none (row (some (.inr ⟨i / 2, by omega⟩)) (row none F))
  else F

theorem finite_physical_projected_row_visit (j : Fin (n + 1)) (F : X → V) :
    finitePhysicalProjectedRow row (2 * j.val) F = row (some (.inl j)) F := by
  have hi : 2 * j.val < 2 * n + 1 := by omega
  have he (h : 2 * j.val / 2 < n + 1) : (⟨2 * j.val / 2, h⟩ : Fin (n + 1)) = j :=
    Fin.ext (show 2 * j.val / 2 = j.val from by omega)
  have h0 : (2 * j.val) % 2 = 0 := by omega
  simp only [finitePhysicalProjectedRow, dif_pos hi, dif_pos h0, he]

theorem finite_physical_projected_row_edge (j : Fin n) (F : X → V) :
    finitePhysicalProjectedRow row (2 * j.val + 1) F =
      row none (row (some (.inr j)) (row none F)) := by
  have hi : 2 * j.val + 1 < 2 * n + 1 := by omega
  have ho : (2 * j.val + 1) % 2 ≠ 0 := by omega
  have he (h : (2 * j.val + 1) / 2 < n) : (⟨(2 * j.val + 1) / 2, h⟩ : Fin n) = j :=
    Fin.ext (show (2 * j.val + 1) / 2 = j.val from by omega)
  simp only [finitePhysicalProjectedRow, dif_pos hi, dif_neg ho, he]

theorem finite_physical_fine_grouped_eq (i : ℕ) (hi : i < 2 * n + 1) (F : X → V) :
    finiteRowGrouped (S := fun _ => X) (fun j => row (physicalSelectedFineTag n j))
      visitThreeBlockLength i F = finitePhysicalProjectedRow row i F := by
  by_cases h0 : i % 2 = 0
  · let j : Fin (n + 1) := ⟨i / 2, by omega⟩
    have hj : i = 2 * j.val := by dsimp [j]; omega
    rw [hj, finite_physical_projected_row_visit]
    unfold finiteRowGrouped
    rw [visit_three_block_cut_even, visit_three_block_length_even, finite_row_segment_one,
      physical_fine_tag_visit]
  · let j : Fin n := ⟨i / 2, by omega⟩
    have hj : i = 2 * j.val + 1 := by dsimp [j]; omega
    rw [hj, finite_physical_projected_row_edge]
    unfold finiteRowGrouped
    rw [visit_three_block_cut_odd, visit_three_block_length_odd, finite_row_segment_three]
    simp only [Nat.add_assoc, Nat.reduceAdd, physical_fine_tag_source_permutation,
      physical_fine_tag_edge, physical_fine_tag_target_permutation]

theorem finite_physical_fine_eq_projected (F : X → V) :
    finiteRowComposition (S := fun _ => X)
      (fun i => row (physicalSelectedFineTag n i)) (4 * n + 1) F =
      finiteRowComposition (S := fun _ => X) (finitePhysicalProjectedRow row) (2 * n + 1) F := by
  rw [← finite_row_visit_three_grouping_constant]
  apply finite_row_composition_congr_before
  intro i hi K
  exact finite_physical_fine_grouped_eq row i hi K

end Schedule
end Bounty
end

section

/- Quantitative positive subtraction after choosing the sieve depth and cutoff. -/

namespace Bounty

open Filter Real
open scoped Topology

theorem exists_small_cutoff_even_sieve_parameter
    {A bMax level ε : ℝ} (hbMax : 0 < bMax) (hlevel : 0 < level) (hε : 0 < ε) :
    ∃ b : ℝ, ∃ h : ℕ, 0 < b ∧ b < bMax ∧ 1 ≤ h ∧ Even h ∧
      b*(4*(h : ℝ)+2) < level ∧ (A/b)*exp (-(h : ℝ)) < ε := by
  let m : ℝ := min bMax level
  have hm : 0 < m := lt_min hbMax hlevel
  have ht1 : Tendsto (fun x : ℝ => x*exp (-x)) atTop (nhds 0) := by
    simpa only [rpow_one, neg_one_mul] using
      tendsto_rpow_mul_exp_neg_mul_atTop_nhds_zero 1 1 (by norm_num)
  have ht : Tendsto (fun x : ℝ => (2*A/m)*(4*x+2)*exp (-x)) atTop (nhds 0) := by
    have hh := ((ht1.const_mul 4).add
      (tendsto_exp_neg_atTop_nhds_zero.const_mul 2)).const_mul (2*A/m)
    convert hh using 1
    · ext x
      ring
    · simp
  obtain ⟨H,hH⟩ := eventually_atTop.mp (ht.eventually_lt_const hε)
  obtain ⟨n,hn⟩ := exists_nat_gt (max (H/2) 1)
  let h : ℕ := 2*n
  have hn1 : (1 : ℝ) < n := (le_max_right _ _).trans_lt hn
  have hnNat : 1 < n := by exact_mod_cast hn1
  have hh1 : 1 ≤ h := by dsimp [h]; omega
  have hhreal : (h : ℝ) = 2*(n : ℝ) := by dsimp [h]; push_cast; ring
  have hhH : H ≤ (h : ℝ) := by
    have hnH := (le_max_left (H/2) 1).trans_lt hn
    rw [hhreal]
    linarith
  have hhsmall := hH (h : ℝ) hhH
  let b : ℝ := m/(2*(4*(h : ℝ)+2))
  have hfac : 0 < 4*(h : ℝ)+2 := by positivity
  have hden : 0 < 2*(4*(h : ℝ)+2) := by positivity
  have hb : 0 < b := by dsimp [b]; positivity
  refine ⟨b,h,hb,?_,hh1,?_,?_,?_⟩
  · have hbm : b < m := by
      dsimp [b]
      apply (div_lt_iff₀ hden).mpr
      have hhn : (0 : ℝ) ≤ h := Nat.cast_nonneg _
      nlinarith
    exact hbm.trans_le (min_le_left _ _)
  · exact ⟨n,by dsimp [h]; omega⟩
  · have heq : b*(4*(h : ℝ)+2) = m/2 := by
      dsimp [b]
      field_simp
    rw [heq]
    have hmlevel : m ≤ level := min_le_right _ _
    linarith
  · have heq : (A/b)*exp (-(h : ℝ)) = (2*A/m)*(4*(h : ℝ)+2)*exp (-(h : ℝ)) := by
      dsimp [b]
      field_simp
    rw [heq]
    exact hhsmall

theorem exists_positive_buchstab_subtraction
    (Kpre : ℝ) {bMax : ℝ} (hbMax : 0 < bMax) :
    ∃ b : ℝ, ∃ h : ℕ, 0 < b ∧ b < bMax ∧ 1 ≤ h ∧ Even h ∧
      b*(4*(h : ℝ)+2) < 1/2 ∧
      (3/4 : ℝ) <
        (Mertens.primeProductLimitConstant/b)*(1-Kpre*exp (-(h : ℝ))) -
          (buchstabDensity b 1-1) := by
  obtain ⟨Kupper,hKupper,hupper⟩ := exists_buchstab_density_sieve_upper
  obtain ⟨b,h,hb,hbMax',hh,heven,hlevel,herror⟩ :=
    exists_small_cutoff_even_sieve_parameter
      (A := Mertens.primeProductLimitConstant*(Kpre+Kupper))
      hbMax (show (0 : ℝ)<1/2 by norm_num) (show (0 : ℝ)<1/4 by norm_num)
  refine ⟨b,h,hb,hbMax',hh,heven,hlevel,?_⟩
  have hD := hupper b hb h hh heven (by linarith)
  have heq : (Mertens.primeProductLimitConstant/b)*(Kpre+Kupper)*exp (-(h : ℝ)) =
      (Mertens.primeProductLimitConstant*(Kpre+Kupper)/b)*exp (-(h : ℝ)) := by ring
  rw [← heq] at herror
  nlinarith

end Bounty

/- Public declaration closure audit. -/
end

section

/- Fixed-bin bounds for the actual cofactor proxy on constant-factor product support. -/

open Real Filter
open scoped Topology

namespace Bounty

theorem eventually_cofactor_rough_test_coefficient_upper
    {γ a v cLo cHi S M ε : ℝ} (hγ : 0 < γ) (ha : 0 < a) (_hav : a ≤ v)
    (hv : v < 1-γ) (hcLo : 0 < cLo) (hcHi : 0 < cHi) (hS : 0 ≤ S)
    (hM : ∀ α ∈ Set.Icc a v, buchstabDensity γ (1-α) ≤ M) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ p m : ℕ,
      p ∈ primeBand (exp (a*L)) (exp (v*L)) → 0 < m →
      cLo*exp L ≤ (p : ℝ)*(m : ℝ) → (p : ℝ)*(m : ℝ) ≤ cHi*exp L →
      roughTestCellProxyCoefficient γ L S
        (logarithmicCellBase (L^(-S)) (logarithmicCellIndex (L^(-S)) m)) ≤
          (M+ε)/(Mertens.primeProductLimitConstant*sqrt L) := by
  let g := (1-v-γ)/2
  let w₀ := (1-v+γ)/2
  have hg : 0 < g := by dsimp [g]; linarith
  have hw₀ : 0 < w₀ := by dsimp [w₀]; linarith
  have hc : ContinuousOn (fun w : ℝ => buchstabDensity γ w) (Set.Icc w₀ 2) := by
    apply buchstab_density_continuous.comp
      (show ContinuousOn (fun w : ℝ => (γ,w)) (Set.Icc w₀ 2) by fun_prop)
    intro w hw
    exact ⟨hγ, hw₀.trans_le hw.1⟩
  obtain ⟨δ, hδ, hclose⟩ := Metric.uniformContinuousOn_iff_le.mp
    (isCompact_Icc.uniformContinuousOn_of_continuous hc) (ε/2) (by positivity)
  let C := |log cLo|+|log cHi|+1
  let η := min δ (min g 1)
  have hC : 0 < C := by dsimp [C]; positivity
  have hη : 0 < η := lt_min hδ (lt_min hg zero_lt_one)
  have hηδ : η ≤ δ := min_le_left _ _
  have hηg : η ≤ g := (min_le_right _ _).trans (min_le_left _ _)
  have hη1 : η ≤ 1 := (min_le_right _ _).trans (min_le_right _ _)
  filter_upwards [eventually_rough_test_proxy_coefficient_upper
      (a := w₀) (b := 2) (γ₀ := γ) (gap := g) hS hw₀ hγ hg (show 0 < ε/2 by positivity),
    eventually_ge_atTop (C/η), eventually_ge_atTop (1 : ℝ)] with L hbound hlarge hL1
  intro p m hp hm hlo hhi
  have hL : 0 < L := zero_lt_one.trans_le hL1
  have hsmall : C/L ≤ η := by
    apply (div_le_iff₀ hL).mpr
    have hh := (div_le_iff₀ hη).mp hlarge
    nlinarith
  let α := log (p : ℝ)/L
  let w := (logarithmicCellIndex (L^(-S)) m : ℝ)*L^(-S)/L
  obtain ⟨hαa,hαv⟩ := prime_band_logarithmic_exponent_bounds hL hp
  have hp0 : 0 < p := ((mem_primeBand_iff (exp_pos _).le (exp_pos _).le p).mp hp).1.pos
  have hdist : |w-(1-α)| ≤ η :=
    (cofactor_logarithmic_cell_distance hL1 hS hcLo hcHi hp0 hm hlo hhi).trans hsmall
  have hparts := abs_le.mp hdist
  have hwlo : w₀ ≤ w := by dsimp [w₀, g] at *; linarith
  have hwhi : w ≤ 2 := by dsimp [α] at *; linarith
  have hwgap : g ≤ w-γ := by dsimp [w₀, g] at *; linarith
  have href : 1-α ∈ Set.Icc w₀ 2 := by
    dsimp [w₀, α]
    constructor <;> linarith
  have hcont := hclose w ⟨hwlo,hwhi⟩ (1-α) href
    (by simpa only [Real.dist_eq] using hdist.trans hηδ)
  rw [Real.dist_eq] at hcont
  have hdensity : buchstabDensity γ w ≤ M+ε/2 := by
    have hh := (abs_le.mp hcont).2
    have hm := hM α ⟨hαa,hαv⟩
    linarith
  have hb := hbound w γ hwlo hwhi le_rfl hwgap
  have hbase : exp (w*L) = logarithmicCellBase (L^(-S)) (logarithmicCellIndex (L^(-S)) m) := by
    unfold logarithmicCellBase
    dsimp [w]
    rw [div_mul_cancel₀ _ hL.ne']
  rw [hbase] at hb
  apply hb.trans
  apply div_le_div_of_nonneg_right _ (mul_nonneg Mertens.prime_product_limit_constant_pos.le (sqrt_nonneg L))
  linarith

theorem eventually_cofactor_rough_test_proxy_upper
    {γ a v cLo cHi S M ε : ℝ} (hγ : 0 < γ) (ha : 0 < a) (hav : a ≤ v)
    (hv : v < 1-γ) (hcLo : 0 < cLo) (hcHi : 0 < cHi) (hS : 0 ≤ S)
    (hM : ∀ α ∈ Set.Icc a v, buchstabDensity γ (1-α) ≤ M) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ p m : ℕ,
      p ∈ primeBand (exp (a*L)) (exp (v*L)) → 0 < m →
      cLo*exp L ≤ (p : ℝ)*(m : ℝ) → (p : ℝ)*(m : ℝ) ≤ cHi*exp L →
      roughTestLogarithmicProxy γ L S m ≤
        (M+ε)/(Mertens.primeProductLimitConstant*sqrt L) := by
  filter_upwards [eventually_cofactor_rough_test_coefficient_upper hγ ha hav hv hcLo hcHi hS hM hε]
    with L hL
  intro p m hp hm hlo hhi
  have hb := hL p m hp hm hlo hhi
  unfold roughTestLogarithmicProxy roughTestCellProxy
  split
  · exact hb
  · apply le_trans _ hb
    unfold roughTestCellProxyCoefficient
    positivity

end Bounty
end

section

/- Unbalanced proxy upper bounds with the sharp square-root sieve constant canceled explicitly. -/

open Finset Filter

namespace Bounty

theorem sqrt_proxy_mass_product {K L : ℝ} (hK : 0 < K) (hL : 0 < L)
    (R M H ε X : ℝ) :
    (M / (K * Real.sqrt L)) * ((R * K * H + ε) * X / Real.sqrt L) =
      (R * M * H + M * ε / K) * X / L := by
  have hs : 0 < Real.sqrt L := Real.sqrt_pos.mpr hL
  calc
    _ = (M * (R * K * H + ε) * X) / (K * (Real.sqrt L) ^ 2) := by field_simp
    _ = _ := by rw [Real.sq_sqrt hL.le]; field_simp

theorem proxy_mass_error_budget {K M ε : ℝ} (hK : 0 < K) (hM : 0 ≤ M) (hε : 0 < ε) :
    let δ := ε * K / (M + 1)
    0 < δ ∧ M * δ / K ≤ ε := by
  have hM1 : 0 < M + 1 := by linarith
  refine ⟨div_pos (mul_pos hε hK) hM1, ?_⟩
  have heq : M * (ε * K / (M + 1)) / K = ε * (M / (M + 1)) := by field_simp
  rw [heq]
  exact mul_le_of_le_one_right hε.le ((div_le_one hM1).mpr (by linarith))

theorem exists_candidate_unbalanced_proxy_upper
    (hZ : PrimitiveZeroFreeHalfPlane) {c q a v : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11 / 5 : ℝ) * (r : ℝ) * c = 1)
    (ha : 0 < a) (hav : a ≤ v) (hvhalf : v < 1 / 2) :
    ∃ J : ℕ, ∀ jStar : ℕ, J < jStar → ∀ M : ℝ, 0 ≤ M → ∀ ε : ℝ, 0 < ε →
      ∀ᶠ L : ℝ in atTop, ∀ (F : Finset (ℕ × ℕ)) (f : ℕ → ℝ) (u : ℕ × ℕ → ℕ),
        (∀ w ∈ F, u w ∈ arithmeticProductWindow 1 (Real.exp L) ∧
          w.1 ∈ primeBand (Real.exp (a * L)) (Real.exp (v * L)) ∧ w.1 * w.2 = 2 * u w + 1) →
        (∀ w ∈ F, 0 ≤ f w.2 ∧ f w.2 ≤ M / (Mertens.primeProductLimitConstant * Real.sqrt L)) →
        (∀ w ∈ F, f w.2 ≠ 0 → ∀ p ∈ w.2.primeFactors, Real.exp (Real.sqrt L) < (p : ℝ)) →
        (∑ w ∈ F, candidateCoefficient c L q r jStar (u w) * f w.2) ≤
          (shiftedSieveRatioConstant * M * Real.log (v / a) + ε) *
            candidateCoefficientWindowMass c L q r jStar / L := by
  obtain ⟨J, hJ⟩ := exists_candidate_prime_band_sqrt_rough_mass_density_upper
    hZ hc hr hq0 hq1 hcenter ha hav hvhalf
  refine ⟨J, ?_⟩
  intro jStar hj M hM ε hε
  let K := Mertens.primeProductLimitConstant
  have hK : 0 < K := Mertens.prime_product_limit_constant_pos
  let δ := ε * K / (M + 1)
  have hδ : 0 < δ ∧ M * δ / K ≤ ε := proxy_mass_error_budget hK hM hε
  filter_upwards [hJ jStar hj δ hδ.1, eventually_rough_test_proxy_cutoff ha,
    eventually_gt_atTop (0 : ℝ)] with L hmass hcut hL
  intro F f u hdata hf hrough
  have hs : 0 < Real.sqrt L := Real.sqrt_pos.mpr hL
  have hC : 0 ≤ M / (K * Real.sqrt L) := div_nonneg hM (mul_pos hK hs).le
  have hbridge := candidate_prime_factor_proxy_bound (c := c) r jStar hq0 (Real.exp_nonneg _)
    (Real.exp_nonneg _) (Real.exp_le_exp.mpr hcut) hC F f u hdata hf hrough
  have hX : 0 ≤ candidateCoefficientWindowMass c L q r jStar := by
    apply sum_nonneg
    intro n hn
    exact candidate_coefficient_nonneg c L hq0 r jStar n
  calc
    _ ≤ (M / (K * Real.sqrt L)) * candidatePrimeBandRoughMass c L q r jStar
        (Real.exp (a * L)) (Real.exp (v * L)) (Real.exp (Real.sqrt L)) := hbridge
    _ ≤ (M / (K * Real.sqrt L)) *
        ((shiftedSieveRatioConstant * K * Real.log (v / a) + δ) *
          candidateCoefficientWindowMass c L q r jStar / Real.sqrt L) :=
      mul_le_mul_of_nonneg_left hmass hC
    _ = (shiftedSieveRatioConstant * M * Real.log (v / a) + M * δ / K) *
          candidateCoefficientWindowMass c L q r jStar / L :=
      sqrt_proxy_mass_product hK hL _ _ _ _ _
    _ ≤ _ := div_le_div_of_nonneg_right
      (mul_le_mul_of_nonneg_right (add_le_add le_rfl hδ.2) hX) hL.le

theorem exists_candidate_unbalanced_rough_logarithmic_proxy_upper
    (hZ : PrimitiveZeroFreeHalfPlane) {c q a v : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11 / 5 : ℝ) * (r : ℝ) * c = 1)
    (ha : 0 < a) (hav : a ≤ v) (hvhalf : v < 1 / 2) :
    ∃ J : ℕ, ∀ jStar : ℕ, J < jStar → ∀ M : ℝ, 0 ≤ M → ∀ ε : ℝ, 0 < ε →
      ∀ᶠ L : ℝ in atTop, ∀ (γ S : ℝ) (F : Finset (ℕ × ℕ)) (u : ℕ × ℕ → ℕ),
        (∀ w ∈ F, u w ∈ arithmeticProductWindow 1 (Real.exp L) ∧
          w.1 ∈ primeBand (Real.exp (a * L)) (Real.exp (v * L)) ∧ w.1 * w.2 = 2 * u w + 1) →
        (∀ w ∈ F, roughTestCellProxyCoefficient γ L S
          (logarithmicCellBase (L ^ (-S)) (logarithmicCellIndex (L ^ (-S)) w.2)) ≤
            M / (Mertens.primeProductLimitConstant * Real.sqrt L)) →
        (∑ w ∈ F, candidateCoefficient c L q r jStar (u w) * roughTestLogarithmicProxy γ L S w.2) ≤
          (shiftedSieveRatioConstant * M * Real.log (v / a) + ε) *
            candidateCoefficientWindowMass c L q r jStar / L := by
  obtain ⟨J, hJ⟩ := exists_candidate_unbalanced_proxy_upper hZ hc hr hq0 hq1 hcenter ha hav hvhalf
  refine ⟨J, ?_⟩
  intro jStar hj M hM ε hε
  filter_upwards [hJ jStar hj M hM ε hε, eventually_gt_atTop (0 : ℝ)] with L hbound hL
  intro γ S F u hdata hcoef
  apply hbound F (roughTestLogarithmicProxy γ L S) u hdata
  · intro w hw
    refine ⟨rough_test_logarithmic_proxy_nonneg γ L S w.2, ?_⟩
    exact rough_test_logarithmic_proxy_le_coefficient
      (div_nonneg hM (mul_pos Mertens.prime_product_limit_constant_pos (Real.sqrt_pos.mpr hL)).le)
      (hcoef w hw)
  · intro w hw hne
    exact rough_test_logarithmic_proxy_support hne

end Bounty

end

section

/- Uniform Lyapunov rows for an original owner, paying one common atom bound per selected child. -/

open Finset Classical

namespace Bounty

section Owner
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
    [∀ g, DecidableEq (P g)] {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
    (Δ D : ∀ k c, A k c → Fin N → ℤ) (ω : ∀ k c, A k c → ℝ)
    (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ v vmin : ℝ) (V η : Fin N → ℝ) (β : ℝ)
    (steps : List (Option (J ⊕ K)))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))

theorem full_mixed_uniform_forest_row_le
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hη : ∀ g, 0 ≤ η g) (hμatom : ∀ g p, μ g p ≤ η g)
    (hβ : 0 ≤ β)
    (hghostAtom : ∀ j g, (|(1 - q j) * V g / ρ| * η g) * v ≤ β)
    (hedgeAtom : ∀ g, η g ≤ β)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : ∀ g, vmin ≤ V g)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (t : ℕ) (tag : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P)) :
    let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
    (∑ e : FullPermutationMixedEvent n S B A Δ D tag s,
      |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V tag s e| *
        fullMixedForestHistoryGain n S B A Δ D steps code t tag s e history *
        productLengthLyapunov v (fullPermutationMixedEventTarget n S B A Δ D tag s e)) ≤
      fullMixedForestRowFactor S B steps code μ q ρ v vmin V T β t tag * productLengthLyapunov v s := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
  have hnonneg : 0 ≤ fullMixedForestRowFactor S B steps code μ q ρ v vmin V T β t tag *
      productLengthLyapunov v s := mul_nonneg
    (full_mixed_forest_row_factor_nonneg S B steps code μ q ρ v vmin V T β hβ hρ1 (zero_lt_one.trans hv).le t tag)
    (productLengthLyapunov_nonneg (zero_lt_one.trans hv).le s)
  by_cases htlen : t < steps.length
  · by_cases htag : steps.get ⟨t, htlen⟩ = tag
    · have hb := full_mixed_owner_stage_row_le n S B A Δ D ω μ q ρ v vmin V η β steps code
        hω hωmass hμ hmass hη hμatom hghostAtom hedgeAtom hq0 hq1 hρ0 hρ1 hv hvmin hV hD T ht
        ⟨t, htlen⟩ tag htag s history
      simpa only [fullMixedForestRowFactor, fullMixedSelectedAt, dif_pos htlen] using hb
    · have hz : ∀ e : FullPermutationMixedEvent n S B A Δ D tag s,
          fullMixedForestHistoryGain n S B A Δ D steps code t tag s e history = 0 := by
        intro e
        unfold fullMixedForestHistoryGain
        rw [dif_pos htlen, if_neg htag]
      simpa only [hz, mul_zero, zero_mul, sum_const_zero] using hnonneg
  · have hz : ∀ e : FullPermutationMixedEvent n S B A Δ D tag s,
        fullMixedForestHistoryGain n S B A Δ D steps code t tag s e history = 0 := by
      intro e
      unfold fullMixedForestHistoryGain
      rw [dif_neg htlen]
    simpa only [hz, mul_zero, zero_mul, sum_const_zero] using hnonneg

end Owner
end Bounty
end

