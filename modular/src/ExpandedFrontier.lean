section

/- The literal full clean-event sum, including its auxiliary draw and both
total-memory cutoffs, equals the fresh-target integral. Memory symmetry is
retained as an explicit hypothesis for the continuation. -/

open Finset
open scoped Classical

namespace Bounty

theorem full_active_clean_event_sum {G : Type*} [Fintype G] [dG : DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] {M : G → ℕ}
    (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : SharedActiveLabels P S → Type*) [∀ c, Fintype (A c)]
    (Δ D : ∀ c, A c → G → ℤ)
    (ω : ∀ c, A c → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (θ : ∀ c, A c → (∀ g, Fin (S g)ᶜ.card → P g) → ℂ)
    (f : ∀ c, A c → ProductBoundedOrderedState P
      (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ∀ c a, ProductMemorySymmetric (f c a))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    let c := (productActiveMemorySplit S B x).1
    let s := (productActiveMemorySplit S B x).2
    (∑ e : FullActiveEdgeEvent n S B A Δ D x,
      (fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V x e : ℂ) *
        (if ∀ g, (e.2 g).1 = ∅ ∧ (e.2 g).2.1 = ∅ then
          θ c e.1 (fun g =>
            (unrestrictedJointEventTarget n (Δ c e.1) (D c e.1)
              (fun g => (S g)ᶜ.card) B s e.2 g).1) else 0) *
        f c e.1 (fullActiveEdgeEventTarget n S B A Δ D x e)) =
      if productTotalMemory x ≤ B then
        ∑ a : A c, (ω c a : ℂ) *
          (∏ g, (unrestrictedBoundedCleanFactor (n g) (Δ c a g) ρ (s g) : ℂ)) *
          ∑ target : (∀ g, Fin (S g)ᶜ.card → P g),
            ((∏ g, ∏ j, μ g (target g j) : ℝ) : ℂ) * θ c a target *
              f c a ((productActiveMemorySplit S B).symm (c,
                fun g => unrestrictedBoundedCleanTarget (n g) (Δ c a g) (s g) (target g)))
      else 0 := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  intro c s
  let F := fun a : A c => equivFiberSlice (productActiveMemorySplit S B) (f c a) c
  have hF (a : A c) : ProductMemorySymmetric (F a) :=
    productActiveMemorySlice_symmetric S B (f c a) (hf c a) c
  have hrow (a : A c) := unrestricted_joint_clean_event_phase_sum n (Δ c a) (D c a)
    μ ρ V (fun g => (S g)ᶜ.card) B (θ c a) (F a) (hF a) s
  simp only [mul_assoc] at hrow
  have htotal : productTotalMemory s = productTotalMemory x :=
    productActiveMemorySplit_total_memory S B x
  rw [Fintype.sum_sigma]
  simp only [fullActiveEdgeEventWeight, fullActiveEdgeEventTarget, Complex.ofReal_mul]
  change (∑ a : A c, ∑ e : UnrestrictedJointEvent n (Δ c a) (D c a)
      (fun g => (S g)ᶜ.card) B s,
      (ω c a : ℂ) * (unrestrictedJointCutoffEventWeight n (Δ c a) (D c a)
        μ ρ V (fun g => (S g)ᶜ.card) B s e : ℂ) *
        (if ∀ g, (e g).1 = ∅ ∧ (e g).2.1 = ∅ then θ c a
          (fun g => (unrestrictedJointEventTarget n (Δ c a) (D c a)
            (fun g => (S g)ᶜ.card) B s e g).1) else 0) *
        F a (unrestrictedJointEventTarget n (Δ c a) (D c a)
          (fun g => (S g)ᶜ.card) B s e)) = _
  simp only [mul_assoc, ← mul_sum]
  simp_rw [hrow]
  rw [htotal]
  split_ifs
  · apply sum_congr rfl
    intro a _
    simp only [F, equivFiberSlice, Complex.ofReal_prod]
    apply congrArg (fun z : ℂ => (ω c a : ℂ) *
      ((∏ g, (unrestrictedBoundedCleanFactor (n g) (Δ c a g) ρ (s g) : ℂ)) * z))
    apply sum_congr
    · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
    · intro target _
      rfl
  · simp only [mul_zero, sum_const_zero]

end Bounty
end

section

/- Pinned-prime kernels for one complete original ghost step, with its actual continuation. -/

open Finset Classical

namespace Bounty

section Ghost
variable {G : Type*} [Fintype G] [DecidableEq G] {P : G → Type*}
    [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (μ : ∀ g, P g → ℝ) (q ρ : ℝ) (V : G → ℝ) (t : G → ℕ) (B : ℕ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B)
    (sk : CoupledGhostSkeleton t B s) (i : CoupledGhostSampleIndex t B s sk) (p : P i.1)
    (F : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℝ)

noncomputable def fullGhostPinnedBirthKernel : ℝ :=
  coupledGhostSkeletonAbsMass (fun g => physicalGhostRetention (n g) q ρ)
    (fun g => physicalGhostTermination (n g) q ρ) t B s sk *
  ∑ rest : (j : {j : CoupledGhostSampleIndex t B s sk // j ≠ i}) →
      UnrestrictedResidueParticle (n j.1.1),
    (∏ j, physicalGhostBirthAtom (n j.1.1) (μ j.1.1) q ρ (V j.1.1) (rest j)) *
      F (coupledGhostJointEventTarget t B s ((coupledGhostSkeletonEquiv t B s).symm
        ⟨sk, birthCoordinateInsert (fun j => UnrestrictedResidueParticle (n j.1)) i
          (unrestrictedResidueSeed (n i.1) p) rest⟩))

theorem full_ghost_pinned_birth_kernel_nonneg (hμ : ∀ g p, 0 ≤ μ g p)
    (hF : ∀ x, 0 ≤ F x) :
    0 ≤ fullGhostPinnedBirthKernel n μ q ρ V t B s sk i p F := by
  apply mul_nonneg (coupled_ghost_skeleton_abs_mass_nonneg _ _ _ _ _ _)
  apply sum_nonneg
  intro rest _
  exact mul_nonneg (prod_nonneg fun j _ =>
    physical_ghost_birth_atom_nonneg _ _ _ _ _ (hμ _) _) (hF _)

theorem coupled_physical_ghost_pinned_kernel_eq [DecidableEq (P i.1)] (hμ : ∀ g p, 0 ≤ μ g p) :
    (∑ births : CoupledGhostSamples t B s sk, if (births i).1 = p then
      |coupledGhostJointEventWeight
        (fun g => physicalGhostRetention (n g) q ρ)
        (fun g => physicalGhostTermination (n g) q ρ)
        (fun g => physicalGhostBirth (n g) q ρ (V g))
        (fun g => unrestrictedResidueWeight (μ g)) t B s
        ((coupledGhostSkeletonEquiv t B s).symm ⟨sk, births⟩)| *
      F (coupledGhostJointEventTarget t B s
        ((coupledGhostSkeletonEquiv t B s).symm ⟨sk, births⟩)) else 0) =
      (|(1 - q) * V i.1 / ρ| * μ i.1 p) *
        fullGhostPinnedBirthKernel n μ q ρ V t B s sk i p F := by
  unfold fullGhostPinnedBirthKernel
  simp_rw [coupled_ghost_skeleton_weight_factor
    (fun g => physicalGhostRetention (n g) q ρ)
    (fun g => physicalGhostTermination (n g) q ρ)
    (fun g => physicalGhostBirth (n g) q ρ (V g))
    (fun g => unrestrictedResidueWeight (μ g))
    (fun g (z : UnrestrictedResidueParticle (n g)) => hμ g z.1) t B s sk]
  change (∑ births : CoupledGhostSamples t B s sk, if (births i).1 = p then
    (_ * ∏ j, physicalGhostBirthAtom (n j.1) (μ j.1) q ρ (V j.1) (births j)) *
      F (coupledGhostJointEventTarget t B s
        ((coupledGhostSkeletonEquiv t B s).symm ⟨sk, births⟩)) else 0) = _
  rw [selected_coordinate_kernel_sum]
  exact physical_ghost_birth_atom_weighted_sum (n i.1) (μ i.1) q ρ (V i.1) p _

theorem coupled_physical_ghost_pinned_kernel_le [DecidableEq (P i.1)] (hμ : ∀ g p, 0 ≤ μ g p)
    (hF : ∀ x, 0 ≤ F x) {ε : ℝ} (hatom : |(1 - q) * V i.1 / ρ| * μ i.1 p ≤ ε) :
    (∑ births : CoupledGhostSamples t B s sk, if (births i).1 = p then
      |coupledGhostJointEventWeight
        (fun g => physicalGhostRetention (n g) q ρ)
        (fun g => physicalGhostTermination (n g) q ρ)
        (fun g => physicalGhostBirth (n g) q ρ (V g))
        (fun g => unrestrictedResidueWeight (μ g)) t B s
        ((coupledGhostSkeletonEquiv t B s).symm ⟨sk, births⟩)| *
      F (coupledGhostJointEventTarget t B s
        ((coupledGhostSkeletonEquiv t B s).symm ⟨sk, births⟩)) else 0) ≤
      ε * fullGhostPinnedBirthKernel n μ q ρ V t B s sk i p F := by
  rw [coupled_physical_ghost_pinned_kernel_eq n μ q ρ V t B s sk i p F hμ]
  exact mul_le_mul_of_nonneg_right hatom
    (full_ghost_pinned_birth_kernel_nonneg n μ q ρ V t B s sk i p F hμ hF)

end Ghost

end Bounty
end

section

/- Original sampled coordinates are exactly the performed positions in the fixed chronological order. -/

namespace Bounty

section Paths
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
    (n : ∀ g, P g → ℕ) {M : Fin N → ℕ}
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K)))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x)

abbrev FullMixedPathBirthCoordinate :=
  (i : Fin steps.length) ×
    let e := finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x p i
    FullMixedEventBirthCoordinate n S B A Δ D (steps.get i) e.1 e.2

noncomputable def fullMixedPathBirthCoordinateEquiv :
    FullMixedPathBirthCoordinate n S B A Δ D steps x p ≃
      {a : FullMixedBirthAddress S B steps //
        fullMixedPathBirthPerformed n S B A Δ D steps x p a} where
  toFun c :=
    let e := finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x p c.1
    let a := fullMixedBirthCoordinateEquiv n S B A Δ D (steps.get c.1) e.1 e.2 c.2
    ⟨⟨c.1, a.val⟩, a.property⟩
  invFun a :=
    let e := finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x p a.val.1
    ⟨a.val.1, (fullMixedBirthCoordinateEquiv n S B A Δ D
      (steps.get a.val.1) e.1 e.2).symm ⟨a.val.2, a.property⟩⟩
  left_inv c := by
    rcases c with ⟨i, c⟩
    let e := finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x p i
    let f := fullMixedBirthCoordinateEquiv n S B A Δ D (steps.get i) e.1 e.2
    change (⟨i, f.symm (f c)⟩ : FullMixedPathBirthCoordinate n S B A Δ D steps x p) = ⟨i, c⟩
    rw [Equiv.symm_apply_apply]
  right_inv a := by
    rcases a with ⟨⟨i, a⟩, ha⟩
    simp only [Equiv.apply_symm_apply]

noncomputable def fullMixedPerformedOrderEquiv :
    {a : FullMixedBirthAddress S B steps //
      fullMixedPathBirthPerformed n S B A Δ D steps x p a} ≃
    {i : Fin (Fintype.card (FullMixedBirthAddress S B steps)) //
      fullMixedPathBirthPerformed n S B A Δ D steps x p (fullMixedBirthOrder S B steps i)} where
  toFun a := ⟨(fullMixedBirthOrder S B steps).symm a.val, by
    simpa only [Equiv.apply_symm_apply] using a.property⟩
  invFun i := ⟨fullMixedBirthOrder S B steps i.val, i.property⟩
  left_inv a := Subtype.ext ((fullMixedBirthOrder S B steps).apply_symm_apply a.val)
  right_inv i := Subtype.ext ((fullMixedBirthOrder S B steps).symm_apply_apply i.val)

noncomputable def fullMixedChronologicalCoordinateEquiv :=
  (fullMixedPathBirthCoordinateEquiv n S B A Δ D steps x p).trans
    (fullMixedPerformedOrderEquiv n S B A Δ D steps x p)

theorem full_mixed_chronological_coordinate_owner
    (c : FullMixedPathBirthCoordinate n S B A Δ D steps x p) :
    fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps
      (fullMixedChronologicalCoordinateEquiv n S B A Δ D steps x p c).val) = c.1 := by
  simp only [fullMixedChronologicalCoordinateEquiv, Equiv.trans_apply,
    fullMixedPerformedOrderEquiv, Equiv.coe_fn_mk, Equiv.apply_symm_apply]
  rfl

theorem full_mixed_chronological_coordinate_data
    (c : FullMixedPathBirthCoordinate n S B A Δ D steps x p) :
    fullMixedPathBornData n S B A Δ D steps x p (fullMixedBirthOrder S B steps
      (fullMixedChronologicalCoordinateEquiv n S B A Δ D steps x p c).val) =
      let e := finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
        (fullPermutationMixedEventTarget n S B A Δ D) steps x p c.1
      some (fullMixedBirthCoordinateData n S B A Δ D (steps.get c.1) e.1 e.2 c.2) := by
  simp only [fullMixedChronologicalCoordinateEquiv, Equiv.trans_apply,
    fullMixedPerformedOrderEquiv, Equiv.coe_fn_mk, Equiv.apply_symm_apply]
  exact full_mixed_birth_coordinate_data n S B A Δ D _ _ _ c.2

theorem full_mixed_chronological_coordinate_label
    (c : FullMixedPathBirthCoordinate n S B A Δ D steps x p) :
    fullMixedPathBirthLabel n S B A Δ D steps x p (fullMixedBirthOrder S B steps
      (fullMixedChronologicalCoordinateEquiv n S B A Δ D steps x p c).val) =
      let e := finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
        (fullPermutationMixedEventTarget n S B A Δ D) steps x p c.1
      some (fullMixedBornPrime n
        (fullMixedBirthCoordinateData n S B A Δ D (steps.get c.1) e.1 e.2 c.2)) := by
  unfold fullMixedPathBirthLabel
  rw [full_mixed_chronological_coordinate_data]
  rfl

theorem full_mixed_coordinate_index_lt_of_owner_lt
    (a b : FullMixedPathBirthCoordinate n S B A Δ D steps x p) (hab : a.1 < b.1) :
    (fullMixedChronologicalCoordinateEquiv n S B A Δ D steps x p a).val <
      (fullMixedChronologicalCoordinateEquiv n S B A Δ D steps x p b).val := by
  apply lt_of_not_ge
  intro h
  have hm := full_mixed_birth_order_owner_monotone S B steps h
  simp only [full_mixed_chronological_coordinate_owner] at hm
  exact (not_le_of_gt hab) hm

end Paths

end Bounty
end

section

/- The actual physical schedule discharges the edge hypothesis of birth factorization. -/

open scoped Classical
namespace Bounty
section Physical
variable {I K : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

theorem physical_full_schedule_birth_factor (j : K) (H : (g : Fin N) → Finset ↥(P g))
    (x : PhysicalFullBoundedState P J ell B) (e : PhysicalFullEdgeEvent (C j) (k j) x) :
    physicalFullGlobalEdgePhase (C j) (k j) H (ω j) (fun g p => β g p / V g) ρ V x e =
      (if FullMixedLocalBirthAvoids (J := I) (fun g (p : {p // p ∈ P g}) => Subtype.val p) (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B (fun j (_ : SharedActiveLabels (fun g => {p // p ∈ P g}) ((fun j g => physicalFullSharedIndices (ell := ell) (C j g)) j)) => PhysicalAuxLabels P (C j)) (fun j => physicalFullEdgeDelta (ell := ell) (C j) (k j)) (fun j => physicalFullEdgeD (ell := ell) (C j)) H (some (.inr j)) x e ∧
          FullMixedLocalBirthDistinct (J := I) (fun g (p : {p // p ∈ P g}) => Subtype.val p) (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B (fun j (_ : SharedActiveLabels (fun g => {p // p ∈ P g}) ((fun j g => physicalFullSharedIndices (ell := ell) (C j g)) j)) => PhysicalAuxLabels P (C j)) (fun j => physicalFullEdgeDelta (ell := ell) (C j) (k j)) (fun j => physicalFullEdgeD (ell := ell) (C j)) (some (.inr j)) x e
        then 1 else 0) *
      physicalFullGlobalEdgePhase (C j) (k j) (fun _ => ∅) (ω j)
        (fun g p => β g p / V g) ρ V x e := by
  have ha := full_mixed_edge_birth_avoids_iff (J := I) (fun g (p : {p // p ∈ P g}) => Subtype.val p) (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B (fun j (_ : SharedActiveLabels (fun g => {p // p ∈ P g}) ((fun j g => physicalFullSharedIndices (ell := ell) (C j g)) j)) => PhysicalAuxLabels P (C j)) (fun j => physicalFullEdgeDelta (ell := ell) (C j) (k j)) (fun j => physicalFullEdgeD (ell := ell) (C j)) j H x e
  have hd := full_mixed_edge_birth_distinct_iff (J := I) (fun g (p : {p // p ∈ P g}) => Subtype.val p) (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B (fun j (_ : SharedActiveLabels (fun g => {p // p ∈ P g}) ((fun j g => physicalFullSharedIndices (ell := ell) (C j g)) j)) => PhysicalAuxLabels P (C j)) (fun j => physicalFullEdgeDelta (ell := ell) (C j) (k j)) (fun j => physicalFullEdgeD (ell := ell) (C j)) j x e
  simpa only [ha, hd] using
    physical_full_global_birth_factor (C j) (k j) H (ω j)
      (fun g p => β g p / V g) ρ V x e

end Physical
end Bounty
end

section

/- Uniform length-weighted rows for the original joint and full auxiliary edge events. -/

open Finset Classical

namespace Bounty

theorem unrestricted_edge_row_bound_nonneg {ρ v vmin : ℝ} (hρ : ρ < 1)
    (hv : 0 ≤ v) (T : ℕ) : 0 ≤ unrestrictedEdgeRowBound ρ v vmin T := by
  unfold unrestrictedEdgeRowBound unrestrictedEdgeChoiceBound
  exact mul_nonneg (by positivity)
    (mul_nonneg (mul_nonneg (unrestrictedEdgeDampingBound_nonneg hρ T) (pow_nonneg hv _))
      (by positivity))

theorem unrestricted_joint_length_row_le {G : Type*} [Fintype G]
    {P : G → Type*} [∀ g, Fintype (P g)] (n : ∀ g, P g → ℕ)
    (Δ D : G → ℤ) (μ : ∀ g, P g → ℝ) {ρ v vmin : ℝ} (V : G → ℝ)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : ∀ g, vmin ≤ V g) (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (t : G → ℕ) (B T : ℕ) (ht : ∀ g, t g ≤ T)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) :
    (∑ e : UnrestrictedJointEvent n Δ D t B s,
      |unrestrictedJointCutoffEventWeight n Δ D μ ρ V t B s e| *
        productLengthLyapunov v (unrestrictedJointEventTarget n Δ D t B s e)) ≤
      productLengthLyapunov v s * unrestrictedEdgeRowBound ρ v vmin T ^ Fintype.card G := by
  have h := finite_product_gated_row_le
    (fun g => unrestrictedBoundedEventWeight (n g) (Δ g) (D g) (μ g) ρ (V g) (t g) B (s g))
    (fun g e => v ^ (unrestrictedBoundedEventTarget (n g) (Δ g) (D g) (t g) B (s g) e).2.1.val)
    (fun _ _ => pow_nonneg (zero_lt_one.trans hv).le _)
    (fun g => v ^ (s g).2.1.val * unrestrictedEdgeRowBound ρ v vmin T)
    (fun g => unrestricted_bounded_length_row_le (n g) (Δ g) (D g) (μ g)
      hρ0 hρ1 hv hvmin (hV g) (hμ g) (hmass g) (t g) B T (ht g) (s g))
    (fun e => productTotalMemory s ≤ B ∧
      productTotalMemory (unrestrictedJointEventTarget n Δ D t B s e) ≤ B)
  simpa only [unrestrictedJointCutoffEventWeight, unrestrictedJointEventTarget,
    productLengthLyapunov, prod_mul_distrib, prod_const, card_univ] using h

theorem full_active_edge_length_row_le {G : Type*} [Fintype G]
    {P : G → Type*} [∀ g, Fintype (P g)] (n : ∀ g, P g → ℕ)
    {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : SharedActiveLabels P S → Type*) [∀ c, Fintype (A c)]
    (Δ D : ∀ c, A c → G → ℤ) (ω : ∀ c, A c → ℝ)
    (μ : ∀ g, P g → ℝ) {ρ v vmin : ℝ} (V : G → ℝ)
    (hω : ∀ c a, 0 ≤ ω c a) (hωmass : ∀ c, ∑ a, ω c a ≤ 1)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : ∀ g, vmin ≤ V g) (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, (S g)ᶜ.card ≤ T)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    (∑ e : FullActiveEdgeEvent n S B A Δ D s, |fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V s e| *
      productLengthLyapunov v (fullActiveEdgeEventTarget n S B A Δ D s e)) ≤
      productLengthLyapunov v s * unrestrictedEdgeRowBound ρ v vmin T ^ Fintype.card G := by
  let c := (productActiveMemorySplit S B s).1
  let r := (productActiveMemorySplit S B s).2
  have hL : 0 ≤ productLengthLyapunov v s * unrestrictedEdgeRowBound ρ v vmin T ^ Fintype.card G :=
    mul_nonneg (productLengthLyapunov_nonneg (zero_lt_one.trans hv).le s)
      (pow_nonneg (unrestricted_edge_row_bound_nonneg hρ1 (zero_lt_one.trans hv).le T) _)
  rw [Fintype.sum_sigma]
  simp only [fullActiveEdgeEventWeight, abs_mul, fullActiveEdgeEventTarget,
    productLengthLyapunov_reassemble, abs_of_nonneg (hω _ _), mul_assoc, ← mul_sum]
  calc
    _ ≤ ∑ a : A c, ω c a *
        (productLengthLyapunov v r * unrestrictedEdgeRowBound ρ v vmin T ^ Fintype.card G) := by
      apply sum_le_sum
      intro a _
      exact mul_le_mul_of_nonneg_left
        (unrestricted_joint_length_row_le n (Δ c a) (D c a) μ V hρ0 hρ1 hv hvmin hV hμ hmass
          (fun g => (S g)ᶜ.card) B T ht r) (hω c a)
    _ = (∑ a : A c, ω c a) *
        (productLengthLyapunov v s * unrestrictedEdgeRowBound ρ v vmin T ^ Fintype.card G) := by
      rw [← sum_mul, productLengthLyapunov_split]
    _ ≤ _ := by simpa only [one_mul] using mul_le_mul_of_nonneg_right (hωmass c) hL

end Bounty
end

section

/- The actual physical ghost coefficients satisfy the length-weighted row estimate. -/

open Finset Classical

namespace Bounty

theorem physical_ghost_length_damping {P : Type*} (n : P → ℕ) (q ρ v : ℝ)
    (hq1 : q ≤ 1) (hρ : 0 < ρ) (hv : 0 < v)
    (hD : q / ρ ^ 2 + ((1 - q) / ρ) / v ≤ 1) (z : UnrestrictedResidueParticle n) :
    physicalGhostRetention n q ρ z * v + |physicalGhostTermination n q ρ z| ≤ v := by
  have hd : 0 ≤ (1 - q) / ρ := div_nonneg (sub_nonneg.mpr hq1) hρ.le
  unfold physicalGhostRetention physicalGhostTermination
  split_ifs
  · rw [abs_neg, abs_of_nonneg hd]
    have h := mul_le_mul_of_nonneg_right hD hv.le
    rwa [add_mul, div_mul_cancel₀ _ hv.ne', one_mul] at h
  · simp

theorem physical_bounded_ghost_length_row_le {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (q ρ V v : ℝ)
    (hμ : ∀ p, 0 ≤ μ p) (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (hρ : 0 < ρ) (hv : 0 < v)
    (hD : q / ρ ^ 2 + ((1 - q) / ρ) / v ≤ 1)
    (t B : ℕ) (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B) :
    (∑ e : BoundedGhostEvent t B s,
      |boundedGhostEventWeight (physicalGhostRetention n q ρ) (physicalGhostTermination n q ρ)
        (physicalGhostBirth n q ρ V) (unrestrictedResidueWeight μ) t B s e| *
          v ^ (boundedGhostEventTarget t B s e).2.1.val) ≤
      Real.exp ((|(1 - q) * V / ρ| * ∑ p, μ p) * v) * v ^ s.2.1.val := by
  have hA : ∀ z, 0 ≤ physicalGhostRetention n q ρ z := by
    intro z
    unfold physicalGhostRetention
    split_ifs
    · exact div_nonneg hq0 (sq_nonneg _)
    · exact zero_le_one
  have h := bounded_ghost_length_row_le
    (physicalGhostRetention n q ρ) (physicalGhostTermination n q ρ) (physicalGhostBirth n q ρ V)
    (unrestrictedResidueWeight μ) v hA (fun z => hμ z.1) hv.le
    (physical_ghost_length_damping n q ρ v hq1 hρ hv hD) t B s
  change _ ≤ Real.exp ((∑ z, physicalGhostBirthAtom n μ q ρ V z) * v) * v ^ s.2.1.val at h
  rw [physical_ghost_birth_atom_total] at h
  exact h

theorem coupled_physical_ghost_length_row_le {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (μ : ∀ g, P g → ℝ) (q ρ v : ℝ) (V : G → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (hρ : 0 < ρ) (hv : 0 < v)
    (hD : q / ρ ^ 2 + ((1 - q) / ρ) / v ≤ 1)
    (t : G → ℕ) (B : ℕ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) :
    (∑ e : CoupledGhostEvent t B s,
      |coupledGhostJointEventWeight (fun g => physicalGhostRetention (n g) q ρ)
        (fun g => physicalGhostTermination (n g) q ρ) (fun g => physicalGhostBirth (n g) q ρ (V g))
        (fun g => unrestrictedResidueWeight (μ g)) t B s e| *
          productLengthLyapunov v (coupledGhostJointEventTarget t B s e)) ≤
      (∏ g, Real.exp ((|(1 - q) * V g / ρ| * ∑ p, μ g p) * v)) * productLengthLyapunov v s := by
  have h := finite_product_gated_row_le
    (fun g => boundedGhostEventWeight (physicalGhostRetention (n g) q ρ)
      (physicalGhostTermination (n g) q ρ) (physicalGhostBirth (n g) q ρ (V g))
      (unrestrictedResidueWeight (μ g)) (t g) B (s g))
    (fun g e => v ^ (boundedGhostEventTarget (t g) B (s g) e).2.1.val)
    (fun _ _ => pow_nonneg hv.le _)
    (fun g => Real.exp ((|(1 - q) * V g / ρ| * ∑ p, μ g p) * v) * v ^ (s g).2.1.val)
    (fun g => physical_bounded_ghost_length_row_le (n g) (μ g) q ρ (V g) v
      (hμ g) hq0 hq1 hρ hv hD (t g) B (s g))
    (fun e => productTotalMemory s ≤ B ∧ productTotalMemory (coupledGhostJointEventTarget t B s e) ≤ B)
  simpa only [coupledGhostJointEventWeight, coupledGhostJointEventTarget,
    productLengthLyapunov, prod_mul_distrib] using h

end Bounty
end

section

/- Pinning current birth primes leaves the length potential unchanged at a fixed original skeleton. -/

open Finset

namespace Bounty

theorem productLengthLyapunov_ghost_skeleton {G : Type*} [Fintype G]
    {P Z : G → Type*} (t : G → ℕ) (B : ℕ) (v : ℝ)
    (s : ProductBoundedOrderedState P Z t B) (sk : CoupledGhostSkeleton t B s)
    (births : CoupledGhostSamples t B s sk) :
    productLengthLyapunov v (coupledGhostJointEventTarget t B s
      ((coupledGhostSkeletonEquiv t B s).symm ⟨sk, births⟩)) =
      v ^ (∑ g, boundedGhostSkeletonOutputCount (t g) B (s g) (sk g).1 (sk g).2) := by
  rw [productLengthLyapunov_eq_total, coupled_ghost_skeleton_target_memory]

theorem productLengthLyapunov_ghost_samples_independent {G : Type*} [Fintype G]
    {P Z : G → Type*} (t : G → ℕ) (B : ℕ) (v : ℝ)
    (s : ProductBoundedOrderedState P Z t B) (sk : CoupledGhostSkeleton t B s)
    (births other : CoupledGhostSamples t B s sk) :
    productLengthLyapunov v (coupledGhostJointEventTarget t B s
      ((coupledGhostSkeletonEquiv t B s).symm ⟨sk, births⟩)) =
    productLengthLyapunov v (coupledGhostJointEventTarget t B s
      ((coupledGhostSkeletonEquiv t B s).symm ⟨sk, other⟩)) := by
  rw [productLengthLyapunov_ghost_skeleton, productLengthLyapunov_ghost_skeleton]

theorem productLengthLyapunov_edge_skeleton {G : Type*} [Fintype G]
    {P : G → Type*} (n : ∀ g, P g → ℕ) {M : G → ℕ}
    (S : ∀ g, Finset (Fin (M g))) (B : ℕ) (A : SharedActiveLabels P S → Type*)
    (Δ D : ∀ c, A c → G → ℤ) (v : ℝ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (sk : FullActiveEdgeSkeleton n S B A Δ D s) (fresh : FullActiveEdgeSamples n S B A Δ D s sk) :
    productLengthLyapunov v (fullActiveEdgeEventTarget n S B A Δ D s
      ((fullActiveEdgeSkeletonEquiv n S B A Δ D s).symm ⟨sk, fresh⟩)) =
      v ^ (∑ g, unrestrictedSkeletonOutputCount (n g)
        (Δ (productActiveMemorySplit S B s).1 sk.1 g)
        (D (productActiveMemorySplit S B s).1 sk.1 g)
        (S g)ᶜ.card B ((productActiveMemorySplit S B s).2 g) (sk.2 g)) := by
  unfold fullActiveEdgeEventTarget
  rw [productLengthLyapunov_reassemble, productLengthLyapunov_eq_total]
  rcases sk with ⟨a, sk⟩
  exact congrArg (fun m : ℕ => v ^ m)
    (full_active_edge_skeleton_target_memory n S B A Δ D s ⟨a, sk⟩ fresh)

theorem productLengthLyapunov_edge_samples_independent {G : Type*} [Fintype G]
    {P : G → Type*} (n : ∀ g, P g → ℕ) {M : G → ℕ}
    (S : ∀ g, Finset (Fin (M g))) (B : ℕ) (A : SharedActiveLabels P S → Type*)
    (Δ D : ∀ c, A c → G → ℤ) (v : ℝ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (sk : FullActiveEdgeSkeleton n S B A Δ D s)
    (fresh other : FullActiveEdgeSamples n S B A Δ D s sk) :
    productLengthLyapunov v (fullActiveEdgeEventTarget n S B A Δ D s
      ((fullActiveEdgeSkeletonEquiv n S B A Δ D s).symm ⟨sk, fresh⟩)) =
    productLengthLyapunov v (fullActiveEdgeEventTarget n S B A Δ D s
      ((fullActiveEdgeSkeletonEquiv n S B A Δ D s).symm ⟨sk, other⟩)) := by
  rw [productLengthLyapunov_edge_skeleton, productLengthLyapunov_edge_skeleton]

end Bounty
end

section

/- The fixed initial ledger costs only a rare fresh-target perturbation.
Auxiliary draws are untouched. Endpoint permutation averages contract the
same full product norm, with no shared-fiber dimension factor. -/

open Finset
open scoped Classical

namespace Bounty

theorem clean_initial_birth_kernel_norm_le {G : Type*}
    {P : G → Finset ℕ} {J ell : ℕ} (F : ∀ g, Finset (P g)) (C : G → Finset (Fin J))
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (B : ℝ) (hB : 0 ≤ B) (hK : ∀ x y a, ‖K x y a‖ ≤ B)
    (x y : RepeatedBigLists P J ell) (a : PhysicalAuxLabels P C) :
    ‖cleanInitialBirthKernel F C K x y a‖ ≤ B := by
  unfold cleanInitialBirthKernel
  split_ifs
  · exact hK x y a
  · simpa only [norm_zero] using hB

theorem repeated_big_initial_birth_unbanned_error {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (F : ∀ g, Finset (P g))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (B : ℝ) (hB : 0 ≤ B) (hK : ∀ x y a, ‖K x y a‖ ≤ B)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (f : RepeatedBigLists P J ell → ℂ) :
    cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
      (repeatedBigUnbannedRowAction V C ζ K f -
        repeatedBigUnbannedRowAction V C ζ (cleanInitialBirthKernel F C K) f) ≤
      (B * Real.sqrt (repeatedBigInitialForbiddenProbability (ell := ell) V C F Pmin)) *
        cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f := by
  have h := repeated_big_unbanned_target_mask_norm V C hV hMass ζ K B hB hK
    (repeatedBigFreshHits F C) (repeatedBigInitialForbiddenProbability (ell := ell) V C F Pmin)
    (repeatedBigInitialForbiddenProbability_nonneg (ell := ell) V C F (fun g => (hV g).le) hPmin.le)
    (fun x => by
      apply le_of_eq_of_le _ (repeated_big_initial_forbidden_target_mass_le V C F hV hMass hPmin hp x)
      apply sum_congr
      · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
      · intro y _
        by_cases hc : repeatedBigSharedCompatible C x y <;> simp only [hc, ↓reduceIte, zero_mul]) f
  have he : repeatedBigUnbannedRowAction V C ζ K f -
      repeatedBigUnbannedRowAction V C ζ (cleanInitialBirthKernel F C K) f =
      repeatedBigUnbannedRowAction V C ζ
        (fun x y a => if repeatedBigFreshHits F C y then K x y a else 0) f := by
    funext x
    simp only [Pi.sub_apply, repeatedBigUnbannedRowAction]
    rw [← sum_sub_distrib]
    apply sum_congr rfl
    intro y _
    rw [← sub_mul, ← sum_sub_distrib]
    congr 1
    apply sum_congr rfl
    intro a _
    by_cases ha : cleanInitialBirthAllowed F C y <;>
      simp [repeatedBigUnbannedKernel, cleanInitialBirthKernel,
        repeated_big_fresh_hits_iff_not_allowed, ha]
  rw [he]
  exact h

theorem repeated_big_initial_birth_projected_error {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (F : ∀ g, Finset (P g))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (B : ℝ) (hB : 0 ≤ B) (hK : ∀ x y a, ‖K x y a‖ ≤ B)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (f : RepeatedBigLists P J ell → ℂ) :
    cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
      (repeatedBigSymmetrizeLinear
        (repeatedBigUnbannedRowAction V C ζ K (repeatedBigSymmetrizeLinear f) -
          repeatedBigUnbannedRowAction V C ζ (cleanInitialBirthKernel F C K)
            (repeatedBigSymmetrizeLinear f))) ≤
      (B * Real.sqrt (repeatedBigInitialForbiddenProbability (ell := ell) V C F Pmin)) *
        cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f := by
  have hw := repeated_big_untilted_active_mass_nonneg (P := P) (J := J) (ell := ell) V (fun g => (hV g).le)
  exact (repeated_big_symmetrize_norm_le _ hw (repeated_big_active_mass_permutation V _) _).trans
    ((repeated_big_initial_birth_unbanned_error V C F hV hMass ζ K B hB hK hPmin hp
      (repeatedBigSymmetrizeLinear f)).trans
      (mul_le_mul_of_nonneg_left
        (repeated_big_symmetrize_norm_le _ hw (repeated_big_active_mass_permutation V _) f)
        (mul_nonneg hB (Real.sqrt_nonneg _))))

theorem repeated_big_initial_birth_family_error {I G : Type*} [Fintype I] [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : I → G → Finset (Fin J))
    (F : ∀ g, Finset (P g))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (ζ : ℝ)
    (K : ∀ i, RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (c : I → ℂ) (B : I → ℝ) (hB : ∀ i, 0 ≤ B i)
    (hK : ∀ i x y a, ‖K i x y a‖ ≤ B i)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (f : RepeatedBigLists P J ell → ℂ) :
    cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
      (repeatedBigSymmetrizeLinear (∑ i, c i •
        (repeatedBigUnbannedRowAction V (C i) ζ (K i) f -
          repeatedBigUnbannedRowAction V (C i) ζ (cleanInitialBirthKernel F (C i) (K i)) f))) ≤
      (∑ i, ‖c i‖ * (B i * Real.sqrt
        (repeatedBigInitialForbiddenProbability (ell := ell) V (C i) F Pmin))) *
        cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f := by
  have hw := repeated_big_untilted_active_mass_nonneg (P := P) (J := J) (ell := ell) V
    (fun g => (hV g).le)
  apply (repeated_big_symmetrize_norm_le _ hw
    (repeated_big_active_mass_permutation V _) _).trans
  apply (clean_active_norm_sum_le _ hw _ _).trans
  calc
    _ ≤ ∑ i, ‖c i‖ * ((B i * Real.sqrt
        (repeatedBigInitialForbiddenProbability (ell := ell) V (C i) F Pmin)) *
        cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f) := by
      apply sum_le_sum
      intro i _
      rw [clean_active_norm_smul _ hw]
      exact mul_le_mul_of_nonneg_left
        (repeated_big_initial_birth_unbanned_error V (C i) F hV hMass ζ (K i)
          (B i) (hB i) (hK i) hPmin hp f) (norm_nonneg _)
    _ = _ := by
      rw [sum_mul]
      apply sum_congr rfl
      intro i _
      ring

theorem repeated_big_initial_birth_masked_family_norm {I G : Type*} [Fintype I] [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : I → G → Finset (Fin J))
    (F : ∀ g, Finset (P g))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (ζ : ℝ)
    (K : ∀ i, RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (c : I → ℂ) (B : I → ℝ) (hB : ∀ i, 0 ≤ B i)
    (hK : ∀ i x y a, ‖K i x y a‖ ≤ B i)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (M : ℝ) (f : RepeatedBigLists P J ell → ℂ)
    (hideal : cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
      (repeatedBigSymmetrizeLinear (∑ i, c i •
        repeatedBigUnbannedRowAction V (C i) ζ (K i) f)) ≤
        M * cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f) :
    cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
      (repeatedBigSymmetrizeLinear (∑ i, c i •
        repeatedBigUnbannedRowAction V (C i) ζ (cleanInitialBirthKernel F (C i) (K i)) f)) ≤
      (M + ∑ i, ‖c i‖ * (B i * Real.sqrt
        (repeatedBigInitialForbiddenProbability (ell := ell) V (C i) F Pmin))) *
        cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f := by
  have hw := repeated_big_untilted_active_mass_nonneg (P := P) (J := J) (ell := ell) V
    (fun g => (hV g).le)
  have he : (∑ i, c i •
        repeatedBigUnbannedRowAction V (C i) ζ (cleanInitialBirthKernel F (C i) (K i)) f) =
      (∑ i, c i • repeatedBigUnbannedRowAction V (C i) ζ (K i) f) -
      (∑ i, c i • (repeatedBigUnbannedRowAction V (C i) ζ (K i) f -
        repeatedBigUnbannedRowAction V (C i) ζ (cleanInitialBirthKernel F (C i) (K i)) f)) := by
    simp only [smul_sub, sum_sub_distrib, sub_sub_cancel]
  rw [he, map_sub]
  exact (clean_active_norm_sub_le _ hw _ _).trans
    ((add_le_add hideal (repeated_big_initial_birth_family_error V C F hV hMass ζ K c B hB hK
      hPmin hp f)).trans_eq (by ring))

theorem repeated_big_initial_birth_masked_ideal {I G : Type*} [Fintype I] [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : I → G → Finset (Fin J))
    (F : ∀ g, Finset (P g))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (ζ : ℝ)
    (K : ∀ i, RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (c : I → ℂ) (B : I → ℝ) (hB : ∀ i, 0 ≤ B i)
    (hK : ∀ i x y a, ‖K i x y a‖ ≤ B i)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (M : ℝ)
    (hideal : ∀ (Θ : ℝ) (f : RepeatedBigLists P J ell → ℂ), f ∈ repeatedBigSymmetricSubspace →
      cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
        (repeatedBigSymmetrizeLinear (fun source => ∑ target,
          (∑ i, ∑ aux, c i * repeatedBigUnbannedKernel V (fun _ _ => 1) (C i) ζ (K i) aux source target *
            physicalReturnPhase Θ (repeatedBigD (C i) source aux)) * f target)) ≤
          M * cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f)
    (Θ : ℝ) (f : RepeatedBigLists P J ell → ℂ) (hf : f ∈ repeatedBigSymmetricSubspace) :
    cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
      (repeatedBigSymmetrizeLinear (fun source => ∑ target,
        (∑ i, ∑ aux, c i * repeatedBigUnbannedKernel V (fun _ _ => 1) (C i) ζ
          (cleanInitialBirthKernel F (C i) (K i)) aux source target *
          physicalReturnPhase Θ (repeatedBigD (C i) source aux)) * f target)) ≤
      (M + ∑ i, ‖c i‖ * (B i * Real.sqrt
        (repeatedBigInitialForbiddenProbability (ell := ell) V (C i) F Pmin))) *
        cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f := by
  let H := fun i x y a => K i x y a * physicalReturnPhase Θ (repeatedBigD (C i) x a)
  have hH : ∀ i x y a, ‖H i x y a‖ ≤ B i := by
    intro i x y a
    simpa only [H, norm_mul, physicalReturnPhase_norm, mul_one] using hK i x y a
  have hi : cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
      (repeatedBigSymmetrizeLinear (∑ i, c i •
        repeatedBigUnbannedRowAction V (C i) ζ (H i) f)) ≤
      M * cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f := by
    rw [show H = (fun i x y a => K i x y a * physicalReturnPhase Θ (repeatedBigD (C i) x a)) from rfl,
      repeated_big_unbanned_phase_pattern_row]
    exact hideal Θ f hf
  have hm : (fun i => cleanInitialBirthKernel F (C i) (H i)) =
      fun i x y a => cleanInitialBirthKernel F (C i) (K i) x y a *
        physicalReturnPhase Θ (repeatedBigD (C i) x a) := by
    funext i x y a
    simp only [cleanInitialBirthKernel, H]
    split_ifs <;> simp
  have h := repeated_big_initial_birth_masked_family_norm V C F hV hMass ζ H c B hB hH
    hPmin hp M f hi
  simp_rw [show ∀ i, cleanInitialBirthKernel F (C i) (H i) =
      (fun x y a => cleanInitialBirthKernel F (C i) (K i) x y a *
        physicalReturnPhase Θ (repeatedBigD (C i) x a)) from fun i => congrFun hm i] at h
  rw [repeated_big_unbanned_phase_pattern_row] at h
  exact h

end Bounty
end

