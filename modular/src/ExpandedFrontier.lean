      (fun h => candidateRemainingComplexCoefficient c L r jStar take twist (primePoolFreePart P h))
      ρ ξ₁ ξ₂ ξ₃ z w =
      typeIIPhase (ρ+ξ₃) z * typeIIPhase (-ρ) w * conj (F₀ z) * G₀ w *
        (candidateRetainedCutoffWeight c L q S z:ℂ) * (candidateRetainedCutoffWeight c L q S w:ℂ) := by
  classical
  filter_upwards [eventually_candidate_retained_cutoff_support hc] with L hcut
  intro q r jStar hr hj S hS take hkeep twist σ hphase M α modulus χ ρ ξ₁ ξ₂ ξ₃ z w hz hw hM hfree hα
  dsimp only
  let P := (candidatePIndices c L).biUnion (candidatePBand (c*L))
  let H := candidateRetainedAllocationSupport c L r jStar S take
  let W : ℕ → ℝ := fun n => markedDivisorWeight (candidatePIndices c L)
    (candidatePBand (c*L)) q (fun j => ∑ p ∈ candidatePBand (c*L) j, 1/(p:ℝ)) (fun _ => 1) (n:ℤ)
  let B : ℕ → ℂ := fun h => candidateRemainingComplexCoefficient c L r jStar take twist (primePoolFreePart P h)
  let C := candidateResidualPrimeSupport c L r jStar hr hj take hkeep
  let cr := candidateResidualPrimeCoefficient c L r jStar hr hj take hkeep twist
  have hH : ∀ h ∈ H, 0 < h := fun h hh =>
    candidate_retained_allocation_support_pos c L r jStar S take
      (fun p hp => Nat.pos_of_ne_zero (Nat.ne_zero_of_mem_factoredNumbers (hS p hp))) hh
  have heq (h : ℕ) (hh : h ∈ H) :
      typeIISeparatedH W B ρ h = typeIISeparatedH (candidateRetainedCutoffWeight c L q S) B ρ h := by
    have he := hcut q r jStar S hS take twist h
    rw [if_pos hh, candidate_retained_cutoff_coefficient_eq_weight] at he
    have he' : (candidateRetainedCutoffWeight c L q S h:ℂ)*B h = (W h:ℂ)*B h := he
    simpa only [typeIISeparatedH, mul_assoc] using congrArg (fun x : ℂ => typeIIPhase ρ h*x) he'.symm
  have hcross : typeIICrossPairCoefficient M H (fun m => α m * χ (m : ZMod modulus)) W B ρ ξ₁ ξ₂ ξ₃ z w =
      typeIICrossPairCoefficient M H (fun m => α m * χ (m : ZMod modulus))
        (candidateRetainedCutoffWeight c L q S) B ρ ξ₁ ξ₂ ξ₃ z w := by
    unfold typeIICrossPairCoefficient
    apply sum_congr rfl
    intro m hm
    apply sum_congr rfl
    intro h' hh'
    apply sum_congr rfl
    intro m' hm'
    apply sum_congr rfl
    intro h hh
    rw [heq h hh, heq h' hh']
  have hB : B = fun h => typeIIRoughConvolution (candidateRoughBand c L jStar) C σ cr (primePoolFreePart P h) := by
    funext h
    exact candidate_remaining_eq_typeIIRoughConvolution c L r jStar hr hj take hkeep twist σ hphase _
  change typeIICrossPairCoefficient M H (fun m => α m * χ (m : ZMod modulus)) W B ρ ξ₁ ξ₂ ξ₃ z w = _
  rw [hcross, hB]
  rw [typeII_cross_pair_eq_invariant_of_weighted_support P M H (candidateRoughBand c L jStar) C
    (fun m => α m * χ (m : ZMod modulus)) cr (candidateRetainedCutoffWeight c L q S)
    ρ σ ξ₁ ξ₂ ξ₃ hz hw hM hH hfree
    (fun m hm h hh => candidate_retained_cutoff_weight_mul_free_left c L q S (hM m hm).ne' hh.ne' (hfree m hm))
    (by
      intro h hh hn
      have hBh := congrFun hB h
      rw [← hBh]
      exact (candidate_retained_cutoff_coefficient_eq_weight c L q r jStar S take twist h).symm.trans
        (candidate_retained_cutoff_coefficient_eq_zero_of_not_mem c L q r jStar S take twist hn))]
  have hαχ : ∀ m, m ∉ M → α m * χ (m : ZMod modulus)=0 := by
    intro m hm
    rw [hα m hm, zero_mul]
  have hcr : ∀ s, s ∉ C → cr s=0 := fun s hs =>
    candidate_residual_prime_coefficient_eq_zero_of_not_mem c L r jStar hr hj take hkeep twist hs
  rw [typeII_invariant_endpoint_unmask_coefficients P M (candidateRoughBand c L jStar) C _ cr (ρ-ξ₂) σ hαχ hcr z,
    typeII_invariant_endpoint_unmask_coefficients P M (candidateRoughBand c L jStar) C _ cr (ξ₁+ρ) σ hαχ hcr w]

end Bounty
end

section

/- The return Fourier multiplier is part of the original local coefficient. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def physicalLocalFourierCoefficient
    {G I : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    (C : I → G → Finset (Fin J)) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ) (θ : ℝ)
    (t : ℕ) (i : I) (L R : PhysicalMarkLists P J ell) (a : PhysicalAuxLabels P (C i)) : ℂ :=
  K t i L R a * physicalReturnPhase θ (k t i * (physicalD (C i) L a : ℤ))

theorem physical_memory_labeled_local_fourier
    {G I : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (patterns : Finset I) (C : I → G → Finset (Fin J))
    (ζ : I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ)
    (θ : ℝ) (t : ℕ) (a : PhysicalEdgeLabels P J ell patterns C)
    (L R : PhysicalMarkLists P J ell) :
    physicalMemoryLabeledScalar V patterns C ζ (physicalLocalFourierCoefficient C k K θ t) a L R =
      physicalMemoryLabeledScalar V patterns C ζ (K t) a L R *
        physicalReturnPhase θ (physicalBareStep C (k t) a L) := by
  unfold physicalMemoryLabeledScalar physicalLocalFourierCoefficient physicalBareStep
  split_ifs <;> ring

theorem physical_memory_fourier_as_local_coefficient
    {I : Type*} {N J ell : ℕ} {P : Fin N → Finset ℕ}
    (V : Fin N → ℝ) (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (edges : ℕ) (θ : ℝ) :
    physicalMemoryFourierWalkScalar V patterns C ζ k K a L edges θ =
      physicalMemoryWalkScalar V patterns C ζ
        (physicalLocalFourierCoefficient C k K θ) a L edges := by
  simp only [physicalMemoryFourierWalkScalar, physicalMemoryWalkScalar,
    physical_memory_labeled_local_fourier]

theorem physical_group_fourier_fixed_path_factor
    {I : Type*} {N J ell : ℕ} {P : Fin N → Finset ℕ}
    (small : Finset (Fin N)) (V : Fin N → ℝ) (patterns : Finset I)
    (C : I → Fin N → Finset (Fin J)) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (edges : ℕ) (θ : ℝ) :
    (physicalGroupPathMass V small (fun j => C (a j).2.2.1.val) ell edges : ℂ) *
      physicalMemoryFourierWalkScalar V patterns C ζ k K a L edges θ =
    (physicalStateMass (fun g : ↥small => V g.val) J ell : ℂ) *
      physicalBareWalkScalar (fun g : ↥small => V g.val) patterns
        (fun i g => C i g.val) (fun _ _ => 0) (fun _ _ _ _ _ => 1)
        (fun j => physicalRestrictedEdge (fun g => g ∈ small) patterns C (a j))
        (fun j g => L j g.val) edges *
      ∏ j ∈ range edges, physicalMemoryLabeledScalar (fun g : {g // g ∉ small} => V g.val)
        patterns (fun i g => C i g.val) (fun _ => 0)
        (physicalFixedEdgeBigCoefficient (fun g => g ∈ small) patterns C
          (ζ (edges - 1 - j)) (physicalLocalFourierCoefficient C k K θ (edges - 1 - j))
          (a j) (L j) (L (j + 1)))
        (physicalRestrictedEdge (fun g => g ∉ small) patterns C (a j))
        (fun g => L j g.val) (fun g => L (j + 1) g.val) := by
  rw [physical_memory_fourier_as_local_coefficient]
  exact physical_group_fixed_path_factor small V patterns C ζ
    (physicalLocalFourierCoefficient C k K θ) a L edges

end Bounty
end

section

/- The actual rough discrepancy coefficient supplies the low factor and its size bound. -/

open Finset Filter

namespace Bounty

noncomputable def ambientRoughMellinCoefficient (γ L S a v ν : ℝ)
    {q : ℕ} (χ : DirichletCharacter ℂ q) (n : ℕ) : ℂ :=
  (ambientRoughIntervalTypeIIAlpha γ L S a v n : ℂ)*χ (n : ZMod q)*
    (n : ℂ)^((ν : ℂ)*Complex.I)

theorem ambient_rough_mellin_polynomial_eq (γ L S a v ν u : ℝ)
    {q : ℕ} (χ : DirichletCharacter ℂ q) (lo hi : ℕ) :
    (∑ n ∈ Ioc lo hi, ambientRoughMellinCoefficient γ L S a v ν χ n*harmonicMellinWeight u n) =
      ∑ n ∈ Ioc lo hi, (ambientRoughIntervalTypeIIAlpha γ L S a v n : ℂ)*
        harmonicMellinWeight (u+ν) n*χ (n : ZMod q) := by
  apply sum_congr rfl
  intro n hn
  have hnpos : 0 < (n : ℝ) := by exact_mod_cast (Nat.zero_le lo).trans_lt (mem_Ioc.mp hn).1
  rw [← harmonic_mellin_weight_cpow_shift u ν hnpos]
  unfold ambientRoughMellinCoefficient
  push_cast
  ring

theorem eventually_ambient_rough_mellin_low_factor
    (hZ : PrimitiveZeroFreeHalfPlane) {γ vMax S B0 Cmod Sfreq B : ℝ}
    (hγ : 0 < γ) (hv : vMax < 1) (hS : 0 ≤ S) (hB0 : 0 ≤ B0)
    (hprecision : max (max B0 Sfreq) Cmod+B+5 ≤ S) :
    ∀ᶠ L : ℝ in atTop, ∀ a v : ℝ, v ≤ vMax →
      ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q), (q : ℝ) ≤ L^Cmod →
      ∀ ν : ℝ, |ν| ≤ L^Sfreq →
        (∀ n : ℕ, 0 < n → ‖ambientRoughMellinCoefficient γ L S a v ν χ n‖ ≤ 1) ∧
        ∀ u : ℝ, |u| ≤ L^B0 → ∀ lo hi : ℕ,
          ‖∑ n ∈ Ioc lo hi, ambientRoughMellinCoefficient γ L S a v ν χ n*
            harmonicMellinWeight u n‖ ≤ L^(-B) := by
  filter_upwards [eventually_ambient_rough_uniform_shift_discrepancy hZ hγ hv hS hB0 hprecision,
    eventually_rough_typeII_restriction_properties hγ] with L hlow hbound
  intro a v hv' q hqInst χ hq ν hν
  constructor
  · intro n hn
    have halpha : ‖(ambientRoughIntervalTypeIIAlpha γ L S a v n : ℂ)‖ ≤ 1 := by
      simpa only [Complex.norm_real,Real.norm_eq_abs,ambientRoughIntervalTypeIIAlpha] using
        (hbound S (ambientRoughCofactorRange L a v) n).1
    have hphase : ‖(n : ℂ)^((ν : ℂ)*Complex.I)‖ = 1 := by
      rw [show (n : ℂ) = ((n : ℝ) : ℂ) by simp,
        Complex.norm_cpow_eq_rpow_re_of_pos (Nat.cast_pos.mpr hn)]
      simp
    unfold ambientRoughMellinCoefficient
    rw [norm_mul,norm_mul,hphase,mul_one]
    exact (mul_le_mul halpha (χ.norm_le_one _) (norm_nonneg _) zero_le_one).trans_eq (mul_one 1)
  · intro u hu lo hi
    rw [ambient_rough_mellin_polynomial_eq]
    exact hlow a v hv' q χ hq u ν hu hν lo hi

end Bounty
end

section

/- The actual prime discrepancy coefficient supplies the low factor and its size bound. -/

open Finset Filter

namespace Bounty

noncomputable def ambientPrimeMellinCoefficient (κ L S ν : ℝ)
    {q : ℕ} (χ : DirichletCharacter ℂ q) (n : ℕ) : ℂ :=
  (ambientPrimeTypeIIAlpha κ L S n : ℂ)*χ (n : ZMod q)*
    (n : ℂ)^((ν : ℂ)*Complex.I)

theorem ambient_prime_mellin_polynomial_eq (κ L S ν u : ℝ)
    {q : ℕ} (χ : DirichletCharacter ℂ q) (lo hi : ℕ) :
    (∑ n ∈ Ioc lo hi, ambientPrimeMellinCoefficient κ L S ν χ n*harmonicMellinWeight u n) =
      ∑ n ∈ Ioc lo hi, (ambientPrimeTypeIIAlpha κ L S n : ℂ)*
        harmonicMellinWeight (u+ν) n*χ (n : ZMod q) := by
  apply sum_congr rfl
  intro n hn
  have hnpos : 0 < (n : ℝ) := by exact_mod_cast (Nat.zero_le lo).trans_lt (mem_Ioc.mp hn).1
  rw [← harmonic_mellin_weight_cpow_shift u ν hnpos]
  unfold ambientPrimeMellinCoefficient
  push_cast
  ring

theorem eventually_ambient_prime_mellin_low_factor
    (hZ : PrimitiveZeroFreeHalfPlane) {S B0 Cmod Sfreq B : ℝ}
    (hS : 0 ≤ S) (hB0 : 0 ≤ B0)
    (hprecision : max (max B0 Sfreq) Cmod+B+5 ≤ S) :
    ∀ᶠ L : ℝ in atTop, ∀ κ : ℝ, 0 ≤ κ → κ ≤ 1/50 →
      ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q), (q : ℝ) ≤ L^Cmod →
      ∀ ν : ℝ, |ν| ≤ L^Sfreq →
        (∀ n : ℕ, 0 < n → ‖ambientPrimeMellinCoefficient κ L S ν χ n‖ ≤ 1) ∧
        ∀ u : ℝ, |u| ≤ L^B0 → ∀ lo hi : ℕ,
          ‖∑ n ∈ Ioc lo hi, ambientPrimeMellinCoefficient κ L S ν χ n*
            harmonicMellinWeight u n‖ ≤ L^(-B) := by
  filter_upwards [eventually_ambient_prime_uniform_shift_discrepancy hZ hS hB0 hprecision,
    eventually_balanced_typeII_coefficient_properties S hS] with L hlow hbound
  intro κ hκ hκmax q hqInst χ hq ν hν
  constructor
  · intro n hn
    have halpha : ‖(ambientPrimeTypeIIAlpha κ L S n : ℂ)‖ ≤ 1 := by
      simpa only [Complex.norm_real,Real.norm_eq_abs] using
        (hbound κ hκ hκmax n).1
    have hphase : ‖(n : ℂ)^((ν : ℂ)*Complex.I)‖ = 1 := by
      rw [show (n : ℂ) = ((n : ℝ) : ℂ) by simp,
        Complex.norm_cpow_eq_rpow_re_of_pos (Nat.cast_pos.mpr hn)]
      simp
    unfold ambientPrimeMellinCoefficient
    rw [norm_mul,norm_mul,hphase,mul_one]
    exact (mul_le_mul halpha (χ.norm_le_one _) (norm_nonneg _) zero_le_one).trans_eq (mul_one 1)
  · intro u hu lo hi
    rw [ambient_prime_mellin_polynomial_eq]
    exact hlow κ hκ hκmax q χ hq u ν hu hν lo hi

end Bounty
end

section

/- The precise remaining ambient weighted replacement statement and its prime-mass consequence. -/

open Finset Filter
namespace Bounty

/-- This is an explicit analytic hypothesis, not an assertion that replacement has been proved. -/
def CandidateFixedSlotAmbientReplacement : Prop :=
  ∀ (c q : ℝ) (r : ℕ), 0<c → 0<r → 0≤q → q<1 →
    (11/5:ℝ)*(r:ℝ)*c=1 →
    ∀ (κ b : ℝ) (N : ℕ), 0<κ → κ≤1/50 → 0<b → b<1/2-κ → 0<N →
      ∃ J : ℕ, ∀ jStar : ℕ, J<jStar → ∃ S : ℝ, 0≤S ∧ ∀ᶠ L : ℝ in atTop,
        |ambientBuchstabMeshError (arithmeticProductWindow 1 (Real.exp L))
          (candidateCoefficient c L q r jStar) b (1/2-κ) κ L S N| ≤
            ((N:ℝ)+1)*candidateCoefficientWindowMass c L q r jStar*L^(-2:ℝ)

theorem candidate_shifted_prime_fraction_of_fixed_slot_error_bound
    (hZ : PrimitiveZeroFreeHalfPlane)
    {c q : ℝ} {r : ℕ} (hc : 0<c) (hr : 0<r) (hq0 : 0≤q) (hq1 : q<1)
    (hcenter : (11/5:ℝ)*(r:ℝ)*c=1)
    (hR : ∀ (κ b : ℝ) (N : ℕ), 0<κ → κ≤1/50 → 0<b → b<1/2-κ → 0<N →
      ∃ J : ℕ, ∀ jStar : ℕ, J<jStar → ∃ S : ℝ, 0≤S ∧ ∀ᶠ L : ℝ in atTop,
        |ambientBuchstabMeshError (arithmeticProductWindow 1 (Real.exp L))
          (candidateCoefficient c L q r jStar) b (1/2-κ) κ L S N| ≤
            ((N:ℝ)+1)*candidateCoefficientWindowMass c L q r jStar*L^(-2:ℝ)) :
    ∃ J : ℕ, ∀ jStar : ℕ, J<jStar → ∀ᶠ L : ℝ in atTop,
      (shiftedSieveRatioConstant/4)*candidateCoefficientWindowMass c L q r jStar/L ≤
        ∑ u ∈ (arithmeticProductWindow 1 (Real.exp L)).filter (fun u => (2*u+1).Prime),
          candidateCoefficient c L q r jStar u := by
  classical
  obtain ⟨κ,qCut,b,h,N,M,hκ,hκmax,hqCut,hqCut0,hqCuthalf,hb,hbq,hh,heven,hlevel,hN,hbins,hmesh,hgap⟩ :=
    exists_candidate_positive_proxy_gap_uniform_precision hZ hc hr hq0 hq1 hcenter
  subst qCut
  obtain ⟨Jerr,herr⟩ := hR κ b N hκ hκmax hb hbq hN
  obtain ⟨Jgap,hgapAll⟩ := hgap
  refine ⟨max Jerr Jgap,?_⟩
  intro jStar hj
  have hjerr := lt_of_le_of_lt (le_max_left Jerr Jgap) hj
  have hjgap := lt_of_le_of_lt (le_max_right Jerr Jgap) hj
  obtain ⟨S,hS,herrS⟩ := herr jStar hjerr
  have hratio : 0<shiftedSieveRatioConstant :=
    lt_of_lt_of_le zero_lt_one shifted_sieve_ratio_constant_bounds.1
  filter_upwards [herrS,hgapAll S hS jStar hjgap,
    eventually_shifted_ambient_mesh_prime_lower hκ hκmax hbq.le hN,
    eventually_gt_atTop (0:ℝ),eventually_ge_atTop (12*((N:ℝ)+1)/shiftedSieveRatioConstant)]
    with L herror hpositive hlower hL hLbig
  let T := arithmeticProductWindow 1 (Real.exp L)
  let μ := candidateCoefficient c L q r jStar
  let X := candidateCoefficientWindowMass c L q r jStar
  let F : Fin N → Finset (ℕ×ℕ) := fun i => shiftedPrimeBandPairs T
    (Real.exp (reciprocalGrid b (1/2-κ) N (i:ℕ)*L))
    (Real.exp (reciprocalGrid b (1/2-κ) N ((i:ℕ)+1)*L))
  let B := shiftedBalancedPairs T κ L
  have hμ : ∀u∈T,0≤μ u := fun u _ => candidate_coefficient_nonneg c L hq0 r jStar u
  have hX : 0≤X := sum_nonneg hμ
  have hpos := hpositive F (fun _ => shiftedPairIndex) B shiftedPairIndex
    (fun i v hv => shifted_prime_band_pair_data T _ _ hv)
    (fun v hv => by
      have hd := shifted_balanced_pair_data T κ L hv
      exact ⟨hd.2.1,hd.1,hd.2.2⟩)
  have hlo := hlower μ S hμ
  let E := ambientBuchstabMeshError T μ b (1/2-κ) κ L S N
  let U := ambientBuchstabUnbalancedProxy T μ b (1/2-κ) L S N
  let BP := ambientBuchstabBalancedProxy T μ κ L S
  let R := candidateShiftedRoughMass c L q r jStar (Real.exp (b*L))
  change (shiftedSieveRatioConstant/3)*X/L ≤ R-U-BP at hpos
  change R-U-BP-E ≤ ∑ u∈(shiftedRoughSet T (Real.exp (b*L))).filter
    (fun u=>(2*u+1).Prime),μ u at hlo
  have hscalar : ((N:ℝ)+1)*L^(-2:ℝ) ≤ (shiftedSieveRatioConstant/12)/L := by
    rw [Real.rpow_neg hL.le,Real.rpow_two,← div_eq_mul_inv]
    have hbig := (div_le_iff₀ hratio).mp hLbig
    apply (div_le_iff₀ (sq_pos_of_pos hL)).mpr
    have heq : ((shiftedSieveRatioConstant/12)/L)*L^2=shiftedSieveRatioConstant*L/12 := by
      field_simp
    rw [heq]
    linarith
  have hE : E ≤ (shiftedSieveRatioConstant/12)*X/L := by
    have he := (le_abs_self E).trans herror
    have hh := mul_le_mul_of_nonneg_left hscalar hX
    calc
      E ≤ ((N:ℝ)+1)*X*L^(-2:ℝ) := he
      _ = X*(((N:ℝ)+1)*L^(-2:ℝ)) := by ring
      _ ≤ X*((shiftedSieveRatioConstant/12)/L) := hh
      _ = _ := by ring
  have hprime : (shiftedSieveRatioConstant/4)*X/L ≤
      ∑ u∈(shiftedRoughSet T (Real.exp (b*L))).filter (fun u=>(2*u+1).Prime),μ u := by
    have heq : (shiftedSieveRatioConstant/4)*X/L=
      (shiftedSieveRatioConstant/3)*X/L-(shiftedSieveRatioConstant/12)*X/L := by ring
    rw [heq]
    linarith
  apply hprime.trans
  apply sum_le_sum_of_subset_of_nonneg
  · intro u hu
    exact mem_filter.mpr ⟨(mem_shifted_rough_set_iff T _ u).mp (mem_filter.mp hu).1 |>.1,
      (mem_filter.mp hu).2⟩
  · intro u hu hnot
    exact hμ u (mem_filter.mp hu).1


theorem candidate_shifted_prime_fraction_of_fixed_slot_ambient_replacement
    (hZ : PrimitiveZeroFreeHalfPlane) (hR : CandidateFixedSlotAmbientReplacement)
    {c q : ℝ} {r : ℕ} (hc : 0<c) (hr : 0<r) (hq0 : 0≤q) (hq1 : q<1)
    (hcenter : (11/5:ℝ)*(r:ℝ)*c=1) :
    ∃ J : ℕ, ∀ jStar : ℕ, J<jStar → ∀ᶠ L : ℝ in atTop,
      (shiftedSieveRatioConstant/4)*candidateCoefficientWindowMass c L q r jStar/L ≤
        ∑ u ∈ (arithmeticProductWindow 1 (Real.exp L)).filter (fun u => (2*u+1).Prime),
          candidateCoefficient c L q r jStar u :=
  candidate_shifted_prime_fraction_of_fixed_slot_error_bound hZ hc hr hq0 hq1 hcenter
    (hR c q r hc hr hq0 hq1 hcenter)


theorem candidate_fixed_slot_replacement_of_ambient_replacement
    (hR : CandidateAmbientReplacement) : CandidateFixedSlotAmbientReplacement := by
  intro c q r hc hr hq0 hq1 hcenter κ b N hκ hκmax hb hbq hN
  obtain ⟨S, hS, J, hJ⟩ := hR c q r hc hr hq0 hq1 hcenter κ b N hκ hκmax hb hbq hN
  exact ⟨J, fun j hj => ⟨S, hS, hJ j hj⟩⟩

end Bounty
end

section

/- Summing the original dyadic blocks preserves any prescribed logarithmic saving. -/

open Finset Filter
namespace Bounty

theorem eventually_original_bilinear_block_assembly (D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ μ α β : ℕ → ℝ,
      (∀ i ∈ dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊),
        ∀ j ∈ dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊),
        let B := shiftedTypeIIBilinear (arithmeticProductWindow 1 (Real.exp L)) μ
          (typeIIRestrict (dyadicNatBucket (Icc 1 ⌊33*Real.exp L⌋₊) i) α)
          (typeIIRestrict (dyadicNatBucket (Icc 1 ⌊33*Real.exp L⌋₊) j) β)
        B ≠ 0 → |B| ≤ Real.exp L * L^(-(D+4))) →
      |shiftedTypeIIBilinear (arithmeticProductWindow 1 (Real.exp L)) μ α β| ≤
        Real.exp L * L^(-D) := by
  filter_upwards [eventually_original_dyadic_count,eventually_gt_atTop (0 : ℝ)]
    with L hcount hL
  intro μ α β hblocks
  rw [shifted_typeII_bilinear_eq_dyadic_restrictions _ _ _ _ _
    (fun _ hu => shifted_wide_window_nat_factor_bound hL.le hu)]
  have hsum := abs_double_sum_le_card_sq (dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊))
    (fun i j => shiftedTypeIIBilinear (arithmeticProductWindow 1 (Real.exp L)) μ
      (typeIIRestrict (dyadicNatBucket (Icc 1 ⌊33*Real.exp L⌋₊) i) α)
      (typeIIRestrict (dyadicNatBucket (Icc 1 ⌊33*Real.exp L⌋₊) j) β))
    (by positivity : 0 ≤ Real.exp L * L^(-(D+4))) hblocks
  have hsq : (((dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊)).card : ℝ))^2 ≤ L^4 := by
    nlinarith [Nat.cast_nonneg (α := ℝ) (dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊)).card]
  apply hsum.trans
  calc
    _ ≤ L^4 * (Real.exp L * L^(-(D+4))) :=
      mul_le_mul_of_nonneg_right hsq (by positivity)
    _ = Real.exp L * (L^(4 : ℝ) * L^(-(D+4))) := by rw [Real.rpow_ofNat]; ring
    _ = Real.exp L * L^(-D) := by rw [← Real.rpow_add hL]; congr 2; ring

end Bounty
end

section

/- The path-dependent small factor is a deterministic residue ledger on the
original planned big path, with the original local small edge weights. -/

open scoped Classical
namespace Bounty
section Ledger
variable {S G I V K : Type} [Fintype S]
  {Ps : S → Finset ℕ} {P : G → Type}
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : I → ∀ g, Finset (Fin (M g))) (B : ℕ) (A : I → Type)
  (Δ D : ∀ _k : K, ∀ i, PhysicalSharedLists Ps J → SharedActiveLabels P (shared i) → A i → G → ℤ)

abbrev PhysicalPlannedResidueEvent :=
  FullPermutationMixedEvent (J := V) n
    (fun key : PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K) => shared key.2.1) B
    (fun key _ => A key.2.1)
    (fun key c a => Δ key.1 key.2.1 (physicalSharedPrefix key.2.2.1) c a)
    (fun key c a => D key.1 key.2.1 (physicalSharedPrefix key.2.2.1) c a)

noncomputable abbrev physicalPlannedResidueTarget :=
  fullPermutationMixedEventTarget (J := V) n
    (fun key : PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K) => shared key.2.1) B
    (fun key _ => A key.2.1)
    (fun key c a => Δ key.1 key.2.1 (physicalSharedPrefix key.2.2.1) c a)
    (fun key c a => D key.1 key.2.1 (physicalSharedPrefix key.2.2.1) c a)

variable (kbig : ∀ _k : K, ∀ i, SharedActiveLabels P (shared i) → A i → ℤ)

noncomputable def physicalPlannedSmallUpdate
    (tag : Option (V ⊕ PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K)))
    (r : PhysicalResidues Ps)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    PhysicalPlannedResidueEvent n shared B A Δ D tag x → PhysicalResidues Ps :=
  match tag with
  | none => fun _ => r
  | some (.inl _) => fun _ => r
  | some (.inr key) => fun e => physicalTranslateResidues r
      (kbig key.1 key.2.1 (productActiveMemorySplit (shared key.2.1) B x).1 e.1 *
        (physicalSharedProduct (physicalSharedPrefix key.2.2.1) : ℕ))

variable (Vs : S → ℝ) (qedge : K → ℝ)

noncomputable def physicalPlannedSmallPhase
    (tag : Option (V ⊕ PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K)))
    (r : PhysicalResidues Ps)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    PhysicalPlannedResidueEvent n shared B A Δ D tag x → ℂ :=
  match tag with
  | none => fun _ => ((Fintype.card (PhysicalPermutations S J ell) : ℝ)⁻¹ : ℂ)
  | some (.inl _) => fun _ => 1
  | some (.inr key) => fun e =>
      if physicalSharedPrefix key.2.2.1 = physicalSharedPrefix key.2.2.2 then
        ((physicalCompletionMass Vs (fun _ => (∅ : Finset (Fin J))) ell *
          (physicalResidueVertexWeight key.2.2.1 (Real.sqrt (qedge key.1)) r *
            physicalResidueVertexWeight key.2.2.2 (Real.sqrt (qedge key.1))
              (physicalPlannedSmallUpdate n shared B A Δ D kbig (some (.inr key)) r x e)) : ℝ) : ℂ)
      else 0

theorem physical_mixed_plan_small_factor_eq_ledger
    (ks : List (Option (V ⊕ K))) (r : PhysicalResidues Ps) (L : PhysicalMarkLists Ps J ell)
    (pl : PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) ks)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : PhysicalMixedPlannedBigPath n shared B A Δ D ks L pl x) :
    (physicalMixedPlanSmallFactor n shared B A Δ D kbig Vs qedge ks r L pl x p : ℂ) =
      deterministicLedgerPhase (PhysicalPlannedResidueEvent n shared B A Δ D)
        (physicalPlannedResidueTarget n shared B A Δ D)
        (physicalPlannedSmallUpdate n shared B A Δ D kbig)
        (physicalPlannedSmallPhase n shared B A Δ D kbig Vs qedge)
        (physicalMixedBigSteps ks L pl) r x p := by
  induction ks generalizing r L x with
  | nil => rfl
  | cons tag ks ih =>
    cases tag with
    | none =>
      rcases pl with ⟨σ, pl⟩
      rcases p with ⟨⟨τ⟩, p⟩
      simp only [physicalMixedPlanSmallFactor, physicalMixedPathPack, finiteEventPathWeight,
        physicalMixedSmallWeight, physicalMixedBigSteps, deterministicLedgerPhase,
        physicalPlannedSmallUpdate, physicalPlannedSmallPhase, Complex.ofReal_mul] at ih ⊢
      simpa only [Complex.ofReal_inv, physicalMixedWordTarget, physicalPlannedResidueTarget,
        fullPermutationMixedEventTarget] using
        congrArg (((Fintype.card (PhysicalPermutations S J ell) : ℝ)⁻¹ : ℂ) * ·)
          (ih r (physicalPermuteLabels σ L) pl (fullActivePermutation τ x) p)
    | some tag =>
      cases tag with
      | inl j =>
        rcases p with ⟨⟨e⟩, p⟩
        simp only [physicalMixedPlanSmallFactor, physicalMixedPathPack, finiteEventPathWeight,
          physicalMixedSmallWeight, physicalMixedBigSteps, deterministicLedgerPhase,
          physicalPlannedSmallUpdate, physicalPlannedSmallPhase, one_mul] at ih ⊢
        exact ih r L pl (coupledGhostJointEventTarget M B x e) p
      | inr k =>
        rcases pl with ⟨⟨i, R⟩, pl⟩
        rcases p with ⟨⟨a, e⟩, p⟩
        simp only [physicalMixedPlanSmallFactor, physicalMixedPathPack, finiteEventPathWeight,
          physicalMixedSmallWeight, physicalMixedBigSteps, deterministicLedgerPhase,
          physicalPlannedSmallUpdate, physicalPlannedSmallPhase, Complex.ofReal_mul] at ih ⊢
        erw [ih]
        split_ifs <;> simp only [Complex.ofReal_mul, Complex.ofReal_zero, zero_mul]
        rfl

end Ledger
end Bounty
end

section

/- Both replacement errors decay on the actual original candidate harmonic support. -/

open Filter Finset Real
open scoped Classical
namespace Bounty

theorem eventually_candidate_harmonic_replacement_decay {c b K : ℝ}
    (hc : 0 < c) (hb : 0 < b) (hK : 0 ≤ K) (J ell : ℕ) (Cenv E D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (groups : Finset ℕ), groups ⊆ candidatePIndices c L →
      ∀ (probes : groups → Finset (Fin J)) (r t : Finset groups) (hrt : Disjoint r t)
        (Q : ℕ) (h ξ : ℝ), 0 < ξ →
      ∀ (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
        (aux : PhysicalAuxLabels (fun g : groups => candidatePBand (c*L) g.val)
          (repeatedBigPrimePatternCut probes r t i)),
      repeatedBigPrimePatternBound probes r t Q ξ i ≤ L^E →
      ∀ (a a' : ℝ) (pool : Finset ℕ), (∀ g : groups, candidatePBand (c*L) g.val ⊆ pool) →
      ∀ (α β γ α' β' γ' : ℕ → ℂ),
      (∀ n, ‖α n‖ ≤ L^Cenv) → (∀ n, ‖β n‖ ≤ L^Cenv) → (∀ n, ‖γ n‖ ≤ L^Cenv) →
      (∀ n, ‖α' n‖ ≤ L^Cenv) → (∀ n, ‖β' n‖ ≤ L^Cenv) → (∀ n, ‖γ' n‖ ≤ L^Cenv) →
      ∀ U V : ℝ, exp (b*L) ≤ U → U ≤ exp L → exp (b*L) ≤ V → V ≤ exp L →
      ∀ k ∈ Icc (-(typeIIAdmissibleDeterminantBound L K : ℤ)) (typeIIAdmissibleDeterminantBound L K : ℤ),
      ∀ j ∈ range (typeIISmoothDyadicCount L),
      ‖physicalPositiveHarmonicDifference (fun g : groups => candidatePBand (c*L) g.val)
        (fun g => ∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ)) probes r t hrt Q h ξ i aux
        a a' (typeIISmoothDyadicScale U V (U*L^(-K)) j) k pool α β γ α' β' γ'‖ ≤ L^(-D) := by
  obtain ⟨v, m, hv, hm, hmarked⟩ := exists_candidate_marked_error_inputs hc (ell+J)
  obtain ⟨v', Aslot, _, hAslot, hslots⟩ := exists_candidate_shared_error_inputs hc J
  obtain ⟨v'', vmax, _, _, hpoolData⟩ := exists_candidate_P_pool_bounds hc
  let T : ℝ := 2*m+6*Cenv+31
  filter_upwards [hmarked, hslots, hpoolData,
    eventually_actual_candidate_harmonic_parameters hc hb hK hAslot (by norm_num : (0 : ℝ) < 1),
    eventually_candidate_shared_polynomial_error hc (by norm_num : (0 : ℝ) ≤ 2) J E (D+T+1),
    eventually_candidate_free_error_decay hc J (T+E+1) (D+1),
    eventually_ge_atTop (5 : ℝ)] with L hmL hslotL hpL hparam hsharedL hfreeL hL
  intro groups hgroups probes r t hrt Q h ξ hξ i aux hHbound a a' pool hpool
    α β γ α' β' γ' hα hβ hγ hα' hβ' hγ' U V hUlo hUhi hVlo hVhi k hk j hj
  let P := fun g : groups => candidatePBand (c*L) g.val
  let mass := fun g : groups => ∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ)
  let cut := repeatedBigPrimePatternCut probes r t i
  let d := physicalFreeFactor cut aux
  let Z := typeIISmoothDyadicScale U V (U*L^(-K)) j
  let Y := Z*(d : ℝ)/2
  let N := ⌈3*Z*(d : ℝ)⌉₊
  let energy := 2*((N : ℝ)/Y)*(1+log N)^15
  let M := (markedDivisorBound (1/2) v (ell+J))^Fintype.card groups
  let H := repeatedBigPrimePatternBound probes r t Q ξ i
  let common := M*M*(L^Cenv*L^Cenv*L^Cenv)^2*energy
  have hL0 : 0 < L := by linarith
  have hL2 : 2 ≤ L := by linarith
  have hcnt : (J*Fintype.card groups : ℕ) ≤ Aslot*log L := by
    simpa only [Fintype.card_coe] using (hslotL groups hgroups).1
  have hh := hparam groups (fun g => ⟨g.val, hgroups g.property⟩) J cut aux hcnt
    U V hUlo hUhi hVlo hVhi k hk j hj
  obtain ⟨hZ, hkZ, hprod, hcut, hY, hYlo, _, _, _, he, hNlog, hs⟩ := hh
  have hprime : ∀ g p, p ∈ P g → p.Prime := by
    intro g p hpg
    exact ((hpL.2.2.2.2.2 g.val (hgroups g.property)).2.2 p hpg).1
  have hdis : Pairwise (fun g g' => Disjoint (P g) (P g')) := by
    intro g g' hne
    exact hpL.2.2.2.2.1 (by intro heq; exact hne (Subtype.ext heq))
  have hmass : ∀ g, v ≤ mass g := (hmL groups hgroups).2
  have hM : M ≤ L^m := (hmL groups hgroups).1
  have hM0 : 0 ≤ M := pow_nonneg (zero_le_one.trans (one_le_markedDivisorBound (1/2) v (ell+J))) _
  have hH0 : 0 ≤ H := repeated_big_prime_pattern_bound_nonneg probes r t Q ξ i
  have henergy0 : 0 ≤ energy := by
    have hlog0 : 0 ≤ log (N : ℝ) := Real.log_natCast_nonneg N
    dsimp only [energy]
    positivity
  have hc0 : 0 ≤ common := mul_nonneg (mul_nonneg (mul_nonneg hM0 hM0) (sq_nonneg _)) henergy0
  have hcBound : common ≤ L^T := harmonic_error_power_envelope hL0 hM0 hM henergy0 he
  have hfreeBound := hfreeL groups hgroups cut aux (2*common*H)
    (mul_nonneg (mul_nonneg (by norm_num) hc0) hH0)
    (harmonic_free_error_power_envelope hL2 hc0 hcBound hH0 hHbound)
  have hNpower : log (N : ℝ) ≤ L^(2 : ℝ) := by
    calc
      _ ≤ 5*L := by simpa only [show (4 : ℝ)+1=5 by norm_num] using hNlog
      _ ≤ L*L := mul_le_mul_of_nonneg_right hL hL0.le
      _ = _ := by norm_num [pow_two]
  have hsmall : ∀ n ∈ harmonicPositiveSupport Z k d,
      (∑ g : groups, (J-(cut g).card : ℕ) *
        (log n.natAbs/log 2 + log (n+k*(d : ℤ)).natAbs/log 2 + J) /
          (mass g*exp (L^(1/10 : ℝ)))) *
        (H+H/(1/2 : ℝ)^(2*∑ g : groups, (J-(cut g).card))) ≤ L^(-(D+T+1)) := by
    intro n hn
    have hn0 : 0 < n := (mem_harmonic_positive_support hn).1
    have hn' := hs n hn
    have hwInterval : 0 ≤ n ∧ n ≤ (N : ℤ) := hn'.1
    have hzInterval : 0 < n+k*(d : ℤ) ∧ n+k*(d : ℤ) ≤ (N : ℤ) := hn'.2.1
    have hw : 0 < n.natAbs := Int.natAbs_pos.mpr hn0.ne'
    have hz : 0 < (n+k*(d : ℤ)).natAbs := Int.natAbs_pos.mpr hn'.2.1.1.ne'
    have hwN : n.natAbs ≤ N := by omega
    have hzN : (n+k*(d : ℤ)).natAbs ≤ N := by omega
    have hlogw : log (n.natAbs : ℝ) ≤ L^(2 : ℝ) := by
      exact (log_le_log (show (0 : ℝ) < n.natAbs by exact_mod_cast hw)
        (show (n.natAbs : ℝ) ≤ (N : ℝ) by exact_mod_cast hwN)).trans hNpower
    have hlogz : log ((n+k*(d : ℤ)).natAbs : ℝ) ≤ L^(2 : ℝ) := by
      exact (log_le_log (show (0 : ℝ) < (n+k*(d : ℤ)).natAbs by exact_mod_cast hz)
        (show ((n+k*(d : ℤ)).natAbs : ℝ) ≤ (N : ℝ) by exact_mod_cast hzN)).trans hNpower
    exact hsharedL groups hgroups cut _ _ H hw hz hlogw hlogz hH0 hHbound
  have hbound := physical_positive_harmonic_replacement_error P mass probes hprime hdis hv hmass
    (fun _ => rfl) r t hrt Q h ξ hξ i aux a a' hZ k hkZ (exp_pos _)
    (rpow_nonneg hL0.le (-(D+T+1)))
    (fun g p => ((hpL.2.2.2.2.2 g.val (hgroups g.property)).2.2 p.val p.property).2.1.le)
    pool hpool α β γ α' β' γ' (rpow_nonneg hL0.le Cenv) (rpow_nonneg hL0.le Cenv)
    (rpow_nonneg hL0.le Cenv) hα hβ hγ hα' hβ' hγ' hsmall
  apply hbound.trans
  have hsharedBound := harmonic_error_decay_absorb (D := D) hL0 hcBound
  have hsum := add_le_add hsharedBound hfreeBound
  have heq : -(D+1) = -D-1 := by ring
  rw [heq] at hsum
  apply (le_trans ?_ (hsum.trans (harmonic_two_errors_absorb (D := D) hL2)))
  dsimp only [common, energy, M, H, N, Y, Z, d, cut]
  ring_nf
  exact le_refl _

end Bounty
end

section

/- Selected endpoint peeling has arbitrary power saving on the original candidate harmonic ranges. -/

open Filter Finset Real
open scoped Classical
namespace Bounty

theorem eventually_candidate_selected_harmonic_peel_decay {c b K : ℝ}
    (hc : 0 < c) (hb : 0 < b) (hK : 0 ≤ K) (J ell : ℕ) (Cb Ce D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (groups : Finset ℕ), groups ⊆ candidatePIndices c L →
      ∀ (cut : groups → Finset (Fin J))
        (aux : PhysicalAuxLabels (fun g : groups => candidatePBand (c*L) g.val) cut)
        (big : Finset groups) (g : groups) (κ : ℕ),
      ell+(cut g).card = κ+1 → g ∉ big →
      ∀ (b₀ b₁ : GroupMarkedLists (fun j : big => candidatePBand (c*L) j.val.val)
          (fun j : big => ell+(cut j.val).card) → ℂ),
      (∀ l, ‖b₀ l‖ ≤ L^Cb) → (∀ l, ‖b₁ l‖ ≤ L^Cb) →
      ∀ (pool : Finset ℕ), (∀ j : groups, candidatePBand (c*L) j.val ⊆ pool) →
      ∀ (α₀ β₀ γ₀ α₁ β₁ γ₁ : ℕ → ℂ),
      (∀ n, ¬ Disjoint n.primeFactors pool → α₀ n = 0) →
      (∀ n, ¬ Disjoint n.primeFactors pool → β₀ n = 0) →
      (∀ n, ¬ Disjoint n.primeFactors pool → α₁ n = 0) →
      (∀ n, ¬ Disjoint n.primeFactors pool → β₁ n = 0) →
      (∀ n, ‖α₀ n‖ ≤ L^Ce) → (∀ n, ‖β₀ n‖ ≤ L^Ce) → (∀ n, ‖γ₀ n‖ ≤ L^Ce) →
      (∀ n, ‖α₁ n‖ ≤ L^Ce) → (∀ n, ‖β₁ n‖ ≤ L^Ce) → (∀ n, ‖γ₁ n‖ ≤ L^Ce) →
      ∀ U V : ℝ, exp (b*L) ≤ U → U ≤ exp L → exp (b*L) ≤ V → V ≤ exp L →
      ∀ k ∈ Icc (-(typeIIAdmissibleDeterminantBound L K : ℤ)) (typeIIAdmissibleDeterminantBound L K : ℤ),
      ∀ j ∈ range (typeIISmoothDyadicCount L),
      let P := fun g : groups => candidatePBand (c*L) g.val
      let mass := fun g : groups => ∑ p ∈ P g, 1/(p : ℝ)
      let marks := fun g : groups => ell+(cut g).card
      let Z := typeIISmoothDyadicScale U V (U*L^(-K)) j
      let d := physicalFreeFactor cut aux
      let S := harmonicPositiveSupport Z k d
      let δ : ℤ := k*(d : ℤ)
      ∀ θ : ℤ → ℂ, (∀ n ∈ S, ‖θ n‖ ≤ 2) →
      ‖(∑ n ∈ S, (θ n/(n : ℂ)) *
          star (selectedMarkedEndpoint P (1/2) mass marks big b₀ pool α₀ β₀ γ₀ n.natAbs) *
          selectedMarkedEndpoint P (1/2) mass marks big b₁ pool α₁ β₁ γ₁ (n+δ).natAbs) -
        (∑ n ∈ S, (θ n/(n : ℂ)) *
          star (selectedPeeledEndpoint P (1/2) mass marks g κ big b₀ pool α₀ β₀ γ₀ n.natAbs) *
          selectedPeeledEndpoint P (1/2) mass marks g κ big b₁ pool α₁ β₁ γ₁ (n+δ).natAbs)‖ ≤ L^(-D) := by
  obtain ⟨v, m, hv, _, hmarked⟩ := exists_candidate_marked_error_inputs hc (ell+J)
  obtain ⟨_, Aslot, _, hAslot, hslots⟩ := exists_candidate_shared_error_inputs hc J
  obtain ⟨_, vmax, _, _, hpoolData⟩ := exists_candidate_P_pool_bounds hc
  let T := 2*m+2*Cb+6*Ce+32
  let B := max 0 (D+T)
  filter_upwards [hmarked, hslots, hpoolData,
    eventually_actual_candidate_harmonic_parameters hc hb hK hAslot (by norm_num : (0 : ℝ) < 1),
    eventually_weighted_reciprocal_squares_le (by norm_num : (0 : ℝ) < 1/10) 5 (2*B),
    eventually_ge_atTop (max 3 (max (1+10/v) vmax))]
    with L hmarkL hslotL hpoolL hparam hsquare hL
  intro groups hgroups cut aux big g κ hκ hg b₀ b₁ hb₀ hb₁ pool hpool
    α₀ β₀ γ₀ α₁ β₁ γ₁ hα₀free hβ₀free hα₁free hβ₁free
    hα₀ hβ₀ hγ₀ hα₁ hβ₁ hγ₁ U V hUlo hUhi hVlo hVhi k hk j hj
  dsimp only
  intro θ hθ
  let P := fun g : groups => candidatePBand (c*L) g.val
  let mass := fun g : groups => ∑ p ∈ P g, 1/(p : ℝ)
  let marks := fun g : groups => ell+(cut g).card
  let Z := typeIISmoothDyadicScale U V (U*L^(-K)) j
  let d := physicalFreeFactor cut aux
  let S := harmonicPositiveSupport Z k d
  let δ : ℤ := k*(d : ℤ)
  let Y := Z*(d : ℝ)/2
  let N := ⌈3*Z*(d : ℝ)⌉₊
  let M := (markedDivisorBound (1/2) v (ell+J))^Fintype.card groups
  let H := L^Cb
  let coeff := L^Ce*L^Ce*L^Ce
  let E := (M*H)^2*(coeff^2*(N : ℝ)*(1+log (N : ℝ))^15)
  let err := H^2*((M*(1+2*log (N : ℝ)/v))^2*
    ((coeff^2*(N : ℝ)*(1+log (N : ℝ))^15)*∑ p ∈ P g, 1/(p : ℝ)^2))
  let energy := 2*((N : ℝ)/Y)*(1+log (N : ℝ))^15
  let cost := 3*(M*H)^2*coeff^2*energy
  have hL3 : 3 ≤ L := (le_max_left _ _).trans hL
  have hL1 : 1 ≤ L := by linarith
  have hL0 : 0 < L := by linarith
  have hcoef : 1+10/v ≤ L := (le_trans (le_max_left _ _) (le_max_right _ _)).trans hL
  have hvmax : vmax ≤ L := (le_trans (le_max_right _ _) (le_max_right _ _)).trans hL
  have hcnt : ((J*Fintype.card groups : ℕ) : ℝ) ≤ Aslot*log L := by
    simpa only [Fintype.card_coe] using (hslotL groups hgroups).1
  obtain ⟨hZ, _, _, _, hY, _, _, _, _, he, hNlog, hs⟩ :=
    hparam groups (fun g => ⟨g.val, hgroups g.property⟩) J cut aux hcnt
      U V hUlo hUhi hVlo hVhi k hk j hj
  have hprime : ∀ j p, p ∈ P j → p.Prime := by
    intro j p hp
    exact ((hpoolL.2.2.2.2.2 j.val (hgroups j.property)).2.2 p hp).1
  have hdis : Pairwise (fun j j' => Disjoint (P j) (P j')) := by
    intro j j' hne
    exact hpoolL.2.2.2.2.1 (by intro heq; exact hne (Subtype.ext heq))
  have hmass : ∀ j, v ≤ mass j := (hmarkL groups hgroups).2
  have hM : M ≤ L^m := (hmarkL groups hgroups).1
  have hM0 : 0 ≤ M := pow_nonneg (zero_le_one.trans (one_le_markedDivisorBound (1/2) v (ell+J))) _
  have hlog0 : 0 ≤ log (N : ℝ) := log_natCast_nonneg N
  have hE0 : 0 ≤ E := by dsimp only [E]; positivity
  have he0 : 0 ≤ energy := by dsimp only [energy]; positivity
  have hlog5 : log (N : ℝ) ≤ 5*L := by
    simpa only [show (4 : ℝ)+1=5 by norm_num] using hNlog
  have hlogpow := selected_peel_log_factor_power hv hL1 hcoef hlog0 hlog5
  have hmassUpper : mass g ≤ L := ((hpoolL.2.2.2.2.2 g.val (hgroups g.property)).2.1).trans hvmax
  have hsqMass : (1+2*log (N : ℝ)/v)^2 * (∑ p ∈ P g, 1/(p : ℝ)) ≤ L^(5 : ℝ) := by
    calc
      _ ≤ L^(4 : ℝ)*L := mul_le_mul hlogpow hmassUpper (by positivity) (rpow_nonneg hL0.le _)
      _ = _ := by norm_num [pow_succ]
  have hsq := hsquare (P g) ((1+2*log (N : ℝ)/v)^2) (sq_nonneg _) hsqMass
    (fun p hp => ((hpoolL.2.2.2.2.2 g.val (hgroups g.property)).2.2 p hp).2.1.le)
  have hrel : err ≤ E*(L^(-B))^2 := by
    calc
      _ = E*((1+2*log (N : ℝ)/v)^2*∑ p ∈ P g, 1/(p : ℝ)^2) := by
        dsimp only [err, E]; ring
      _ ≤ E*L^(-(2*B)) := mul_le_mul_of_nonneg_left hsq hE0
      _ = _ := by rw [← rpow_mul_natCast hL0.le]; congr 2; norm_num; ring
  have hε0 : 0 ≤ L^(-B) := rpow_nonneg hL0.le _
  have hε1 : L^(-B) ≤ 1 := by
    calc
      _ ≤ L^(0 : ℝ) := rpow_le_rpow_of_exponent_le hL1 (neg_nonpos.mpr (le_max_left _ _))
      _ = 1 := rpow_zero L
  have hcost : cost ≤ L^T := selected_peel_harmonic_power hL3 hM0 hM he0 he
  have hS : ∀ n ∈ S, 0 < n ∧ n ≤ (N : ℤ) := by
    intro n hn
    exact ⟨(mem_harmonic_positive_support hn).1, (hs n hn).1.2⟩
  have hshift : ∀ n ∈ S, 0 < n+δ ∧ n+δ ≤ (N : ℤ) := fun n hn => (hs n hn).2.1
  have hbound := selected_harmonic_peel_replacement P (by norm_num : (0 : ℝ) ≤ 1/2)
    (by norm_num : (1/2 : ℝ) < 1) hv mass marks (ell+J) hmass
    (fun j => Nat.add_le_add_left (by simpa only [Fintype.card_fin] using card_le_univ (cut j)) ell)
    hprime hdis g κ hκ big hg b₀ b₁ (rpow_nonneg hL0.le Cb) hb₀ hb₁
    pool hpool α₀ β₀ γ₀ α₁ β₁ γ₁ hα₀free hβ₀free hα₁free hβ₁free
    (rpow_nonneg hL0.le Ce) (rpow_nonneg hL0.le Ce) (rpow_nonneg hL0.le Ce)
    hα₀ hβ₀ hγ₀ hα₁ hβ₁ hγ₁ S δ N θ hY (by norm_num : (0 : ℝ) ≤ 2)
    hS hshift (fun n hn => (hs n hn).2.2.1) hθ
  apply hbound.trans
  change (2/Y)*(sqrt err*sqrt E+sqrt (2*(E+err))*sqrt err) ≤ L^(-D)
  calc
    _ ≤ (2/Y)*(3*E*L^(-B)) := mul_le_mul_of_nonneg_left
      (harmonic_replacement_error_envelope hE0 hε0 hε1 hrel) (div_nonneg (by norm_num) hY.le)
    _ = cost*L^(-B) := by
      dsimp only [cost, energy, E]
      simp only [div_eq_mul_inv]
      ring
    _ ≤ L^(-D) := selected_peel_decay_absorb hL1 hcost D

end Bounty
end

section

/- The original candidate data supplies uniform parameters for the common logarithmic-cell scale. -/

open Filter Finset Real

namespace Bounty

theorem harmonic_common_product_scale_parameters {Z H d b L : ℝ}
    (hZ : 0 < Z) (hH : 0 < H) (hHd : H ≤ d) (hdH : d ≤ exp 2*H)
    (hlo : exp (b*L) ≤ Z*d/2) (hlog : log (Z*d/2) ≤ 5*L)
    (hL : log 2 ≤ L) (hbL : 2 ≤ b*L) :
    2*exp (b*L)/exp 2 ≤ Z*H ∧ 1 ≤ Z*H ∧ log (Z*H) ≤ 6*L := by
  have hY : 0 < Z*H := mul_pos hZ hH
  have hOld : 0 < Z*d/2 := (exp_pos _).trans_le hlo
  have hupper : Z*H ≤ Z*d := mul_le_mul_of_nonneg_left hHd hZ.le
  have hcompare : Z*d ≤ exp 2*(Z*H) := by
    have h := mul_le_mul_of_nonneg_left hdH hZ.le
    nlinarith
  have hlower : 2*exp (b*L)/exp 2 ≤ Z*H := by
    apply (div_le_iff₀ (exp_pos (2 : ℝ))).mpr
    nlinarith
  refine ⟨hlower,?_,?_⟩
  · have he : exp 2 ≤ exp (b*L) := exp_le_exp.mpr hbL
    have hm : 1*exp 2 ≤ (Z*H)*exp 2 := by nlinarith
    exact (mul_le_mul_iff_left₀ (exp_pos (2 : ℝ))).mp (by simpa only [mul_comm] using hm)
  · have heq : Z*d = 2*(Z*d/2) := by ring
    have hl : log (Z*d) = log 2+log (Z*d/2) := by
      calc
        log (Z*d) = log (2*(Z*d/2)) := congrArg log heq
        _ = log 2+log (Z*d/2) := log_mul (by norm_num) hOld.ne'
    have hm := log_le_log hY hupper
    rw [hl] at hm
    linarith

theorem eventually_candidate_harmonic_common_scale {c b K : ℝ}
    (hc : 0 < c) (hb : 0 < b) (hK : 0 ≤ K) (J : ℕ) :
    ∀ᶠ L : ℝ in atTop, ∀ (groups : Finset ℕ), groups ⊆ candidatePIndices c L →
      ∀ (cut : groups → Finset (Fin J))
        (aux : PhysicalAuxLabels (fun g : groups => candidatePBand (c*L) g.val) cut),
      ∀ U V : ℝ, exp (b*L) ≤ U → U ≤ exp L → exp (b*L) ≤ V → V ≤ exp L →
      ∀ k ∈ Icc (-(typeIIAdmissibleDeterminantBound L K : ℤ))
        (typeIIAdmissibleDeterminantBound L K : ℤ),
      ∀ j ∈ range (typeIISmoothDyadicCount L),
      ∀ (h : ℝ) (D_A D_B : ℕ) (i_A i_B : ℤ),
      0 < h → h ≤ 1 → 0 < D_A → 0 < D_B → physicalFreeFactor cut aux = D_A*D_B →
      upperLogCell h (log D_A) = i_A → upperLogCell h (log D_B) = i_B →
      let Z := typeIISmoothDyadicScale U V (U*L^(-K)) j
      let H := harmonicCellProductScale h i_A i_B
      let Y := Z*H
      2*exp (b*L)/exp 2 ≤ Y ∧ 1 ≤ Y ∧ log Y ≤ 6*L ∧
        |(k : ℝ)| ≤ Z/4 ∧ (physicalFreeFactor cut aux : ℝ) ≤ exp L := by
  obtain ⟨v,A,_hv,hA,hslots⟩ := exists_candidate_shared_error_inputs hc J
  filter_upwards [hslots,
    eventually_actual_candidate_harmonic_parameters hc hb hK hA (by norm_num : (0 : ℝ) < 1),
    eventually_typeII_original_harmonic_shift_small hb hK,
    eventually_ge_atTop (max (log 2) (2/b))] with L hslotsL hparam hshift hL
  intro groups hgroups cut aux U V hUlo hUhi hVlo hVhi k hk j hj
    h D_A D_B i_A i_B hh hh1 hDA hDB hd hcA hcB
  dsimp only
  have hcnt : ((J*Fintype.card groups : ℕ) : ℝ) ≤ A*log L := by
    simpa only [Fintype.card_coe] using (hslotsL groups hgroups).1
  have hp := hparam groups (fun g => ⟨g.val,hgroups g.property⟩) J cut aux hcnt
    U V hUlo hUhi hVlo hVhi k hk j hj
  obtain ⟨hZ,_,_,_,_hOld,hOldLower,_,hOldLog,hdsmall,_,_,_⟩ := hp
  have hcell := harmonic_cell_product_bounds hh hh1 hDA hDB hcA hcB
  have hHd : harmonicCellProductScale h i_A i_B ≤ (physicalFreeFactor cut aux : ℝ) := by
    rw [hd]
    exact hcell.1.le
  have hdH : (physicalFreeFactor cut aux : ℝ) ≤ exp 2*harmonicCellProductScale h i_A i_B := by
    rw [hd]
    exact hcell.2
  have hlog : log (typeIISmoothDyadicScale U V (U*L^(-K)) j *
      (physicalFreeFactor cut aux : ℝ)/2) ≤ 5*L := by
    simpa only [show (4 : ℝ)+1=5 by norm_num] using hOldLog
  have hLlog : log 2 ≤ L := (le_max_left _ _).trans hL
  have hbL : 2 ≤ b*L := by
    have ht := (div_le_iff₀ hb).mp ((le_max_right _ _).trans hL)
    nlinarith
  obtain ⟨hlow,hunit,hlogY⟩ := harmonic_common_product_scale_parameters hZ
    (harmonic_cell_product_scale_pos h i_A i_B) hHd hdH hOldLower hlog hLlog hbL
  refine ⟨hlow,hunit,hlogY,hshift U V hUlo hUhi hVlo hVhi k hk j hj,?_⟩
  simpa only [one_mul] using hdsmall

end Bounty
end

section

/- Integrability and explicit frequency tails for the original normalized common-cell pairing. -/

open Finset MeasureTheory

namespace Bounty

theorem harmonic_cell_normalized_integrand_eq {Y Z : ℝ} (hY : 0 < Y)
    (hZ : Z ≠ 0) {d : ℕ} (hd : d ≠ 0) (a b : ℝ) (δ : ℤ)
    (F G : ℤ → ℂ) (v : ℝ) :
    (Y : ℂ)⁻¹ * (harmonicLogFourier v * physicalPhase (-(a+b+2*Real.pi*v)) d *
      harmonicCellPairing Y Z a b (2*Real.pi*v) δ F G) =
      harmonicLogFourier v * ∑ n ∈ harmonicCommonSupport Y,
        harmonicCellCoefficient Y a b d δ F G n *
          physicalMellinPhase (2*Real.pi*v) ((n : ℝ)/(Z*(d : ℝ))) := by
  simp only [harmonicCellPairing, mul_sum]
  apply sum_congr rfl
  intro n hn
  have hn0 : n ≠ 0 := (harmonic_common_support_positive hY hn).ne'
  have hp := physical_mellin_phased_edge_normalized Y Z a b (2*Real.pi*v) d n (n+δ)
    (fun m => (harmonicCommonCutoff ((m : ℝ)/Y) : ℂ)*F m)
    (fun m => (harmonicCommonCutoff ((m : ℝ)/Y) : ℂ)*G m)
    hY.ne' hZ hd hn0
  dsimp only [harmonicCellSource, harmonicCellTarget, harmonicCellCoefficient]
  calc
    _ = harmonicLogFourier v *
        ((Y : ℂ)⁻¹ * physicalPhase (-(a+b+2*Real.pi*v)) d *
          star (physicalMellinSource Y Z (2*Real.pi*v)
            (fun m => physicalPhase (-a) m.natAbs *
              ((harmonicCommonCutoff ((m : ℝ)/Y) : ℂ)*F m)) n) *
          (physicalPhase b (n+δ).natAbs *
            ((harmonicCommonCutoff (((n+δ : ℤ) : ℝ)/Y) : ℂ)*G (n+δ)))) := by ring
    _ = _ := by rw [hp]; ring

theorem harmonic_cell_normalized_integrable {Y Z : ℝ} (hY : 0 < Y)
    (hZ : Z ≠ 0) {d : ℕ} (hd : d ≠ 0) (a b : ℝ) (δ : ℤ) (F G : ℤ → ℂ) :
    Integrable (fun v : ℝ => (Y : ℂ)⁻¹ *
      (harmonicLogFourier v * physicalPhase (-(a+b+2*Real.pi*v)) d *
        harmonicCellPairing Y Z a b (2*Real.pi*v) δ F G)) := by
  have hi := finite_mellin_sum_integrable (harmonicCommonSupport Y) harmonicLogFourier
    (fun v => 2*Real.pi*v) harmonic_log_fourier_integrable (by fun_prop)
    (harmonicCellCoefficient Y a b d δ F G) (fun n => (n : ℝ)/(Z*(d : ℝ)))
  exact hi.congr (Filter.Eventually.of_forall (fun v =>
    (harmonic_cell_normalized_integrand_eq hY hZ hd a b δ F G v).symm))

theorem harmonic_cell_weighted_pairing_integrable {Y Z : ℝ} (hY : 0 < Y)
    (hZ : Z ≠ 0) {d : ℕ} (hd : d ≠ 0) (a b : ℝ) (δ : ℤ) (F G : ℤ → ℂ) :
    Integrable (fun v : ℝ => harmonicLogFourier v * physicalPhase (-(a+b+2*Real.pi*v)) d *
      harmonicCellPairing Y Z a b (2*Real.pi*v) δ F G) := by
  have hYc : (Y : ℂ) ≠ 0 := by exact_mod_cast hY.ne'
  have hi := (harmonic_cell_normalized_integrable hY hZ hd a b δ F G).const_mul (Y : ℂ)
  simpa only [← mul_assoc, mul_inv_cancel₀ hYc, one_mul] using hi

theorem harmonic_cell_normalized_integrand_norm {Y Z : ℝ} (hY : 0 < Y)
    (hZ : Z ≠ 0) {d : ℕ} (hd : d ≠ 0) (a b : ℝ) (δ : ℤ)
    (F G : ℤ → ℂ) (v : ℝ) :
    ‖(Y : ℂ)⁻¹ * (harmonicLogFourier v * physicalPhase (-(a+b+2*Real.pi*v)) d *
      harmonicCellPairing Y Z a b (2*Real.pi*v) δ F G)‖ ≤
      ‖harmonicLogFourier v‖ *
        ∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellCoefficient Y a b d δ F G n‖ := by
  rw [harmonic_cell_normalized_integrand_eq hY hZ hd a b δ F G v, norm_mul]
  apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
  apply (norm_sum_le _ _).trans
  simp only [norm_mul, physical_mellin_phase_norm, mul_one, le_refl]

theorem harmonic_cell_pairing_truncation {Y Z : ℝ} (hY : 0 < Y)
    (hZ : Z ≠ 0) {d : ℕ} (hd : d ≠ 0) (a b : ℝ) (δ : ℤ)
    (F G : ℤ → ℂ) (R : ℝ) :
    ‖(Y : ℂ)⁻¹ * (∫ v : ℝ, harmonicLogFourier v * physicalPhase (-(a+b+2*Real.pi*v)) d *
        harmonicCellPairing Y Z a b (2*Real.pi*v) δ F G) -
      (Y : ℂ)⁻¹ * (∫ v in {v : ℝ | ‖v‖ ≤ R},
        harmonicLogFourier v * physicalPhase (-(a+b+2*Real.pi*v)) d *
          harmonicCellPairing Y Z a b (2*Real.pi*v) δ F G)‖ ≤
      (∫ v in {v : ℝ | R < ‖v‖}, ‖harmonicLogFourier v‖) *
        ∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellCoefficient Y a b d δ F G n‖ := by
  have hs : MeasurableSet {v : ℝ | ‖v‖ ≤ R} :=
    (isClosed_le continuous_norm continuous_const).measurableSet
  have heq : {v : ℝ | ‖v‖ ≤ R}ᶜ = {v : ℝ | R < ‖v‖} := by ext v; simp
  rw [← integral_const_mul, ← integral_const_mul,
    ← setIntegral_compl hs (harmonic_cell_normalized_integrable hY hZ hd a b δ F G), heq]
  calc
    _ ≤ ∫ v in {v : ℝ | R < ‖v‖}, ‖harmonicLogFourier v‖ *
        (∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellCoefficient Y a b d δ F G n‖) :=
      norm_integral_le_of_norm_le ((harmonic_log_fourier_integrable.norm.mul_const _).integrableOn)
        (Filter.Eventually.of_forall (harmonic_cell_normalized_integrand_norm hY hZ hd a b δ F G))
    _ = _ := integral_mul_const _ _

theorem harmonic_cell_sum_mellin_truncation {Z H : ℝ} (hZ : 0 < Z) (hH : 0 < H)
    {d : ℕ} (hHd : H ≤ (d : ℝ)) (hdH : (d : ℝ) ≤ Real.exp 2*H)
    {k : ℤ} (hk : |(k : ℝ)| ≤ Z/4) (a b : ℝ) (F G : ℤ → ℂ) (R : ℝ) :
    ‖physicalPhase (-(a+b)) d *
      (∑ n ∈ harmonicPositiveSupport Z k d,
        ((typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) : ℂ)/(n : ℂ))*
          physicalPhase a n.natAbs*physicalPhase b (n+k*(d : ℤ)).natAbs*
          star (F n)*G (n+k*(d : ℤ))) -
      ((Z*H : ℝ) : ℂ)⁻¹ * (∫ v in {v : ℝ | ‖v‖ ≤ R},
        harmonicLogFourier v*physicalPhase (-(a+b+2*Real.pi*v)) d*
          harmonicCellPairing (Z*H) Z a b (2*Real.pi*v) (k*(d : ℤ)) F G)‖ ≤
      (∫ v in {v : ℝ | R < ‖v‖}, ‖harmonicLogFourier v‖) *
        ∑ n ∈ harmonicCommonSupport (Z*H),
          ‖harmonicCellCoefficient (Z*H) a b d (k*(d : ℤ)) F G n‖ := by
  have hd : d ≠ 0 := by
    have hdr : (0 : ℝ) < d := hH.trans_le hHd
    exact_mod_cast hdr.ne'
  rw [harmonic_cell_sum_eq_mellin hZ hH hHd hdH hk a b F G]
  exact harmonic_cell_pairing_truncation (mul_pos hZ hH) hZ.ne' hd a b (k*(d : ℤ)) F G R

theorem harmonic_cell_pairing_truncation_energy {Y Z : ℝ} (hY : 0 < Y)
    (hZ : Z ≠ 0) {d : ℕ} (hd : d ≠ 0) (a b : ℝ) (δ : ℤ)
    (F G : ℤ → ℂ) (R : ℝ) :
    ‖(Y : ℂ)⁻¹ * (∫ v : ℝ, harmonicLogFourier v * physicalPhase (-(a+b+2*Real.pi*v)) d *
        harmonicCellPairing Y Z a b (2*Real.pi*v) δ F G) -
      (Y : ℂ)⁻¹ * (∫ v in {v : ℝ | ‖v‖ ≤ R},
        harmonicLogFourier v * physicalPhase (-(a+b+2*Real.pi*v)) d *
          harmonicCellPairing Y Z a b (2*Real.pi*v) δ F G)‖ ≤
      (∫ v in {v : ℝ | R < ‖v‖}, ‖harmonicLogFourier v‖) *
        ((8/Y) * Real.sqrt (∑ n ∈ harmonicCommonSupport Y,
          ‖(harmonicCommonCutoff ((n : ℝ)/Y) : ℂ)*F n‖^2) *
        Real.sqrt (∑ n ∈ harmonicCommonSupport Y,
          ‖(harmonicCommonCutoff (((n+δ : ℤ) : ℝ)/Y) : ℂ)*G (n+δ)‖^2)) := by
  exact (harmonic_cell_pairing_truncation hY hZ hd a b δ F G R).trans
    (mul_le_mul_of_nonneg_left (harmonic_cell_coefficient_mass_le_energy hY a b d δ F G)
      (integral_nonneg (fun _ => norm_nonneg _)))

theorem harmonic_cell_sum_mellin_truncation_energy {Z H : ℝ} (hZ : 0 < Z) (hH : 0 < H)
    {d : ℕ} (hHd : H ≤ (d : ℝ)) (hdH : (d : ℝ) ≤ Real.exp 2*H)
    {k : ℤ} (hk : |(k : ℝ)| ≤ Z/4) (a b : ℝ) (F G : ℤ → ℂ) (R : ℝ) :
    ‖physicalPhase (-(a+b)) d *
      (∑ n ∈ harmonicPositiveSupport Z k d,
        ((typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) : ℂ)/(n : ℂ))*
          physicalPhase a n.natAbs*physicalPhase b (n+k*(d : ℤ)).natAbs*
          star (F n)*G (n+k*(d : ℤ))) -
      ((Z*H : ℝ) : ℂ)⁻¹ * (∫ v in {v : ℝ | ‖v‖ ≤ R},
        harmonicLogFourier v*physicalPhase (-(a+b+2*Real.pi*v)) d*
          harmonicCellPairing (Z*H) Z a b (2*Real.pi*v) (k*(d : ℤ)) F G)‖ ≤
      (∫ v in {v : ℝ | R < ‖v‖}, ‖harmonicLogFourier v‖) *
        ((8/(Z*H)) * Real.sqrt (∑ n ∈ harmonicCommonSupport (Z*H),
          ‖(harmonicCommonCutoff ((n : ℝ)/(Z*H)) : ℂ)*F n‖^2) *
        Real.sqrt (∑ n ∈ harmonicCommonSupport (Z*H),
          ‖(harmonicCommonCutoff (((n+k*(d : ℤ) : ℤ) : ℝ)/(Z*H)) : ℂ)*G (n+k*(d : ℤ))‖^2)) := by
  exact (harmonic_cell_sum_mellin_truncation hZ hH hHd hdH hk a b F G R).trans
    (mul_le_mul_of_nonneg_left
      (harmonic_cell_coefficient_mass_le_energy (mul_pos hZ hH) a b d (k*(d : ℤ)) F G)
      (integral_nonneg (fun _ => norm_nonneg _)))

end Bounty
end

section

/- Polynomial common-cutoff energies for the literal candidate selected and peeled endpoints. -/

open Filter Finset Real

namespace Bounty

theorem exists_candidate_harmonic_cutoff_energy {c : ℝ} (hc : 0 < c)
    (J ell : ℕ) (Cb Ce : ℝ) :
    ∃ T : ℝ, ∀ᶠ L : ℝ in atTop,
      ∀ (groups : Finset ℕ), groups ⊆ candidatePIndices c L →
      ∀ (cut : groups → Finset (Fin J)) (big : Finset groups) (g : groups) (κ : ℕ),
      ell+(cut g).card = κ+1 → g ∉ big →
      ∀ (b₀ b₁ : GroupMarkedLists (fun j : big => candidatePBand (c*L) j.val.val)
          (fun j : big => ell+(cut j.val).card) → ℂ),
      (∀ l, ‖b₀ l‖ ≤ L^Cb) → (∀ l, ‖b₁ l‖ ≤ L^Cb) →
      ∀ (pool : Finset ℕ), (∀ j : groups, candidatePBand (c*L) j.val ⊆ pool) →
      ∀ (α₀ β₀ γ₀ α₁ β₁ γ₁ : ℕ → ℂ),
      (∀ n, ¬ Disjoint n.primeFactors pool → α₀ n = 0) →
      (∀ n, ¬ Disjoint n.primeFactors pool → β₀ n = 0) →
      (∀ n, ¬ Disjoint n.primeFactors pool → α₁ n = 0) →
      (∀ n, ¬ Disjoint n.primeFactors pool → β₁ n = 0) →
      (∀ n, ‖α₀ n‖ ≤ L^Ce) → (∀ n, ‖β₀ n‖ ≤ L^Ce) → (∀ n, ‖γ₀ n‖ ≤ L^Ce) →
      (∀ n, ‖α₁ n‖ ≤ L^Ce) → (∀ n, ‖β₁ n‖ ≤ L^Ce) → (∀ n, ‖γ₁ n‖ ≤ L^Ce) →
      ∀ Y : ℝ, 1 ≤ Y → log Y ≤ 6*L → ∀ δ : ℤ,
      let P := fun j : groups => candidatePBand (c*L) j.val
      let mass := fun j : groups => ∑ p ∈ P j, 1/(p : ℝ)
      let marks := fun j : groups => ell+(cut j).card
      let energy := fun (F : ℕ → ℂ) (s : ℤ) =>
        ∑ n ∈ harmonicCommonSupport Y,
          ‖(harmonicCommonCutoff (((n+s : ℤ) : ℝ)/Y) : ℂ)*F (n+s).natAbs‖^2
      ((8/Y)*sqrt (energy (selectedMarkedEndpoint P (1/2) mass marks big b₀ pool α₀ β₀ γ₀) 0)*
        sqrt (energy (selectedMarkedEndpoint P (1/2) mass marks big b₁ pool α₁ β₁ γ₁) δ) ≤ L^T) ∧
      ((8/Y)*sqrt (energy (selectedPeeledEndpoint P (1/2) mass marks g κ big b₀ pool α₀ β₀ γ₀) 0)*
        sqrt (energy (selectedPeeledEndpoint P (1/2) mass marks g κ big b₁ pool α₁ β₁ γ₁) δ) ≤ L^T) := by
  classical
  obtain ⟨v,m,hv,_hm,hmarked⟩ := exists_candidate_marked_error_inputs hc (ell+J)
  obtain ⟨_,vmax,_,_,hpoolData⟩ := exists_candidate_P_pool_bounds hc
  refine ⟨2*m+2*Cb+6*Ce+32,?_⟩
  filter_upwards [hmarked,hpoolData,eventually_harmonic_common_energy_polynomial,
    eventually_weighted_reciprocal_squares_le (by norm_num : (0 : ℝ) < 1/10) 5 0,
    eventually_ge_atTop (max (3 : ℝ) (max (log 5+2) (max (1+14/v) vmax)))]
    with L hmarkL hpoolL hscalar hsquare hL
  intro groups hgroups cut big g κ hκ hg b₀ b₁ hb₀ hb₁ pool hpool
    α₀ β₀ γ₀ α₁ β₁ γ₁ hα₀free hβ₀free hα₁free hβ₁free
    hα₀ hβ₀ hγ₀ hα₁ hβ₁ hγ₁ Y hY hlogY δ
  dsimp only
  let P := fun j : groups => candidatePBand (c*L) j.val
  let mass := fun j : groups => ∑ p ∈ P j, 1/(p : ℝ)
  let marks := fun j : groups => ell+(cut j).card
  let N := ⌈4*exp 2*Y⌉₊
  let M := (markedDivisorBound (1/2) v (ell+J))^Fintype.card groups
  let E := (M*L^Cb)^2*((L^Ce*L^Ce*L^Ce)^2*(N : ℝ)*(1+log (N : ℝ))^15)
  let energy := 2*((N : ℝ)/(Y/8))*(1+log (N : ℝ))^15
  have hL3 : 3 ≤ L := (le_max_left _ _).trans hL
  have hL1 : 1 ≤ L := by linarith
  have hL0 : 0 < L := by linarith
  have hY0 : 0 < Y := zero_lt_one.trans_le hY
  have hlogc : log 5+2 ≤ L :=
    ((le_max_left _ _).trans (le_max_right _ _)).trans hL
  have hcoef : 1+14/v ≤ L :=
    ((le_max_left _ _).trans ((le_max_right _ _).trans (le_max_right _ _))).trans hL
  have hvmax : vmax ≤ L :=
    ((le_max_right _ _).trans ((le_max_right _ _).trans (le_max_right _ _))).trans hL
  have hmass : ∀ j, v ≤ mass j := (hmarkL groups hgroups).2
  have hM : M ≤ L^m := (hmarkL groups hgroups).1
  have hM0 : 0 ≤ M := pow_nonneg (zero_le_one.trans (one_le_markedDivisorBound (1/2) v (ell+J))) _
  have hlog0 : 0 ≤ log (N : ℝ) := log_natCast_nonneg N
  have hE0 : 0 ≤ E := by dsimp only [E]; positivity
  have he0 : 0 ≤ energy := by dsimp only [energy]; positivity
  have he : energy ≤ L^(31 : ℝ) := hscalar Y hY hlogY
  have hlogN : log (N : ℝ) ≤ 7*L := by
    have h := (harmonic_common_window_ceiling_bounds hY).2.2
    dsimp only [N]
    linarith
  have hfactor : (1+2*log (N : ℝ)/v)^2 ≤ L^(4 : ℝ) := by
    have hz : 1+2*log (N : ℝ)/v ≤ L*L := by
      calc
        _ ≤ 1+2*(7*L)/v := by gcongr
        _ = 1+(14/v)*L := by ring
        _ ≤ L+(14/v)*L := add_le_add hL1 le_rfl
        _ = (1+14/v)*L := by ring
        _ ≤ L*L := mul_le_mul_of_nonneg_right hcoef hL0.le
    calc
      _ ≤ (L*L)^2 := pow_le_pow_left₀ (by positivity) hz 2
