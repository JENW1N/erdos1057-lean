open Finset Classical
theorem finite_local_event_compose_sum {I K : Type*} [DecidableEq I]
    {X : I → Type*} (E : ∀ i, X i → Type*) [∀ i x, Fintype (E i x)]
    (weight : ∀ i x, E i x → ℝ) (target : ∀ i x, E i x → X i)
    (is : List I) (s : Finset K) (f : K → (∀ i, X i) → ℂ) (x : ∀ i, X i) :
    finiteCoordinateCompose (finiteLocalEventAction E weight target) is
      (fun y => ∑ k ∈ s, f k y) x =
    ∑ k ∈ s, finiteCoordinateCompose (finiteLocalEventAction E weight target) is (f k) x := by
  induction is generalizing x with
  | nil => rfl
  | cons i is ih =>
    simp only [finiteCoordinateCompose, finite_coordinate_lift_eq_update,
      finiteLocalEventAction]
    simp_rw [ih, mul_sum]
    rw [sum_comm]

theorem finite_local_event_compose_const_mul {I : Type*} [DecidableEq I]
    {X : I → Type*} (E : ∀ i, X i → Type*) [∀ i x, Fintype (E i x)]
    (weight : ∀ i x, E i x → ℝ) (target : ∀ i x, E i x → X i)
    (is : List I) (c : ℂ) (f : (∀ i, X i) → ℂ) (x : ∀ i, X i) :
    finiteCoordinateCompose (finiteLocalEventAction E weight target) is (fun y => c * f y) x =
      c * finiteCoordinateCompose (finiteLocalEventAction E weight target) is f x := by
  induction is generalizing x with
  | nil => rfl
  | cons i is ih =>
    simp only [finiteCoordinateCompose, finite_coordinate_lift_eq_update,
      finiteLocalEventAction]
    simp_rw [ih, ← mul_assoc, mul_comm _ c, mul_assoc]
    rw [mul_sum]

theorem finite_local_event_lift_prod {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} (E : ∀ i, X i → Type*) [∀ i x, Fintype (E i x)]
    (weight : ∀ i x, E i x → ℝ) (target : ∀ i x, E i x → X i)
    (i : I) (φ : ∀ i, X i → ℂ) (x : ∀ i, X i) :
    finiteCoordinateLift i (finiteLocalEventAction E weight target i)
      (fun y => ∏ j, φ j (y j)) x =
    ∏ j, if j = i then finiteLocalEventAction E weight target j (φ j) (x j)
      else φ j (x j) := by
  rw [finite_coordinate_lift_eq_update, Fintype.prod_eq_mul_prod_compl i]
  simp only [ite_true]
  have hprod (y : X i) : (∏ j, φ j (Function.update x i y j)) =
      φ i y * ∏ j ∈ {i}ᶜ, φ j (x j) := by
    rw [Fintype.prod_eq_mul_prod_compl i]
    simp only [Function.update_self]
    congr 1
    apply prod_congr rfl
    intro j hj
    exact congrArg (φ j) (Function.update_of_ne (by simpa using hj) _ _)
  have hrest : (∏ j ∈ {i}ᶜ,
      if j = i then finiteLocalEventAction E weight target j (φ j) (x j)
      else φ j (x j)) = ∏ j ∈ {i}ᶜ, φ j (x j) := by
    apply prod_congr rfl
    intro j hj
    exact if_neg (by simpa using hj)
  rw [hrest]
  simp only [finiteLocalEventAction, hprod, ← mul_assoc, sum_mul]

theorem finite_local_event_compose_prod {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} (E : ∀ i, X i → Type*) [∀ i x, Fintype (E i x)]
    (weight : ∀ i x, E i x → ℝ) (target : ∀ i x, E i x → X i)
    (is : List I) (his : is.Nodup) (φ : ∀ i, X i → ℂ) (x : ∀ i, X i) :
    finiteCoordinateCompose (finiteLocalEventAction E weight target) is
      (fun y => ∏ j, φ j (y j)) x =
    ∏ j, if j ∈ is then finiteLocalEventAction E weight target j (φ j) (x j)
      else φ j (x j) := by
  induction is generalizing x with
  | nil => simp [finiteCoordinateCompose]
  | cons i is ih =>
    have hi : i ∉ is := (List.nodup_cons.mp his).1
    have htail : is.Nodup := (List.nodup_cons.mp his).2
    simp only [finiteCoordinateCompose]
    have hfun : finiteCoordinateCompose (finiteLocalEventAction E weight target) is
        (fun y => ∏ j, φ j (y j)) =
        fun y => ∏ j, (if j ∈ is then finiteLocalEventAction E weight target j (φ j)
          else φ j) (y j) := by
      funext y
      simpa only [ite_apply] using ih htail y
    rw [hfun, finite_local_event_lift_prod]
    apply prod_congr rfl
    intro j hj
    by_cases hji : j = i
    · subst j
      simp [hi]
    · simp [hji, ite_apply]

theorem finite_local_event_finset_sum {I K : Type*} [DecidableEq I]
    {X : I → Type*} (E : ∀ i, X i → Type*) [∀ i x, Fintype (E i x)]
    (weight : ∀ i x, E i x → ℝ) (target : ∀ i x, E i x → X i)
    (s : Finset I) (u : Finset K) (f : K → (∀ i, X i) → ℂ) (x : ∀ i, X i) :
    finiteCoordinateFinsetAction (finiteLocalEventAction E weight target) s
      (fun y => ∑ k ∈ u, f k y) x =
    ∑ k ∈ u, finiteCoordinateFinsetAction (finiteLocalEventAction E weight target) s (f k) x :=
  finite_local_event_compose_sum E weight target s.toList u f x

theorem finite_local_event_finset_const_mul {I : Type*} [DecidableEq I]
    {X : I → Type*} (E : ∀ i, X i → Type*) [∀ i x, Fintype (E i x)]
    (weight : ∀ i x, E i x → ℝ) (target : ∀ i x, E i x → X i)
    (s : Finset I) (c : ℂ) (f : (∀ i, X i) → ℂ) (x : ∀ i, X i) :
    finiteCoordinateFinsetAction (finiteLocalEventAction E weight target) s (fun y => c * f y) x =
      c * finiteCoordinateFinsetAction (finiteLocalEventAction E weight target) s f x :=
  finite_local_event_compose_const_mul E weight target s.toList c f x

theorem finite_local_event_finset_prod {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} (E : ∀ i, X i → Type*) [∀ i x, Fintype (E i x)]
    (weight : ∀ i x, E i x → ℝ) (target : ∀ i x, E i x → X i)
    (s : Finset I) (φ : ∀ i, X i → ℂ) (x : ∀ i, X i) :
    finiteCoordinateFinsetAction (finiteLocalEventAction E weight target) s
      (fun y => ∏ j, φ j (y j)) x =
    ∏ j, if j ∈ s then finiteLocalEventAction E weight target j (φ j) (x j)
      else φ j (x j) := by
  simpa only [finiteCoordinateFinsetAction, mem_toList] using
    finite_local_event_compose_prod E weight target s.toList s.nodup_toList φ x

theorem finite_local_event_univ_prod {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} (E : ∀ i, X i → Type*) [∀ i x, Fintype (E i x)]
    (weight : ∀ i x, E i x → ℝ) (target : ∀ i x, E i x → X i)
    (φ : ∀ i, X i → ℂ) (x : ∀ i, X i) :
    finiteCoordinateFinsetAction (finiteLocalEventAction E weight target) univ
      (fun y => ∏ j, φ j (y j)) x =
    ∏ j, finiteLocalEventAction E weight target j (φ j) (x j) := by
  simpa only [mem_univ, ite_true] using
    finite_local_event_finset_prod E weight target univ φ x
end

