section

/- Elementary bounds for repeated prime factors in a rough interval. -/

open Finset Filter

namespace Bounty

theorem large_square_divisor_card_le {N : ℕ} {z : ℝ} (hz : 0 < z)
    (F : Finset ℕ) (hF : F ⊆ Ioc 0 N)
    (hsquare : ∀ n ∈ F, ∃ p : ℕ, z < (p : ℝ) ∧ p ^ 2 ∣ n) :
    (F.card : ℝ) ≤ 2 * (N : ℝ) / z := by
  classical
  let P := Ioo ⌊z⌋₊ (N + 1)
  let M := fun p : ℕ => (Ioc 0 N).filter (fun n => p ^ 2 ∣ n)
  have hsub : F ⊆ P.biUnion M := by
    intro n hn
    obtain ⟨p, hpz, hpn⟩ := hsquare n hn
    have hnI := mem_Ioc.mp (hF hn)
    have hpN : p ≤ N := (Nat.le_self_pow (by norm_num) p).trans
      ((Nat.le_of_dvd hnI.1 hpn).trans hnI.2)
    exact mem_biUnion.mpr ⟨p,
      mem_Ioo.mpr ⟨(Nat.floor_lt hz.le).mpr hpz, by omega⟩,
      mem_filter.mpr ⟨hF hn, hpn⟩⟩
  calc
    (F.card : ℝ) ≤ ((P.biUnion M).card : ℝ) := by exact_mod_cast card_le_card hsub
    _ ≤ ∑ p ∈ P, ((M p).card : ℝ) := by exact_mod_cast card_biUnion_le
    _ ≤ ∑ p ∈ P, (N : ℝ) / (p : ℝ) ^ 2 := by
      apply sum_le_sum
      intro p hp
      dsimp only [M]
      rw [Nat.Ioc_filter_dvd_card_eq_div]
      simpa only [Nat.cast_pow] using (Nat.cast_div_le (m := N) (n := p ^ 2) :
        ((N / p ^ 2 : ℕ) : ℝ) ≤ (N : ℝ) / (p ^ 2 : ℕ))
    _ = (N : ℝ) * ∑ p ∈ P, ((p : ℝ) ^ 2)⁻¹ := by
      simp only [div_eq_mul_inv, mul_sum]
    _ ≤ (N : ℝ) * (2 / ((⌊z⌋₊ : ℝ) + 1)) := by
      exact mul_le_mul_of_nonneg_left (sum_Ioo_inv_sq_le ⌊z⌋₊ (N + 1)) (Nat.cast_nonneg _)
    _ ≤ 2 * (N : ℝ) / z := by
      have hdiv : 2 / ((⌊z⌋₊ : ℝ) + 1) ≤ 2 / z :=
        div_le_div_of_nonneg_left (by norm_num) hz (Nat.lt_floor_add_one z).le
      have hmul := mul_le_mul_of_nonneg_left hdiv (Nat.cast_nonneg N)
      calc
        _ ≤ (N : ℝ) * (2 / z) := hmul
        _ = 2 * (N : ℝ) / z := by ring

theorem rough_band_nonsquarefree_card_le {A B z : ℝ} (hB : 0 ≤ B) (hz : 0 < z) :
    (((roughBand A B z).filter (fun n => ¬ Squarefree n)).card : ℝ) ≤ 2 * B / z := by
  classical
  let F := (roughBand A B z).filter (fun n => ¬ Squarefree n)
  have hF : F ⊆ Ioc 0 ⌊B⌋₊ := by
    intro n hn
    have hnR := (mem_filter.mp hn).1
    have hnI := mem_Icc.mp (roughBand_subset_Icc A B z hnR)
    exact mem_Ioc.mpr ⟨hnI.1, hnI.2⟩
  have hsquare : ∀ n ∈ F, ∃ p : ℕ, z < (p : ℝ) ∧ p ^ 2 ∣ n := by
    intro n hn
    obtain ⟨hnR, hnsq⟩ := mem_filter.mp hn
    rw [Nat.squarefree_iff_prime_squarefree] at hnsq
    push Not at hnsq
    obtain ⟨p, hp, hpn⟩ := hnsq
    have hpn' : p ∣ n := dvd_trans (dvd_mul_right p p) hpn
    have hpF := hp.mem_primeFactors hpn' (roughBand_pos hnR).ne'
    have hpz := (mem_filter.mp hnR).2 p hpF
    exact ⟨p, hpz, by simpa only [pow_two] using hpn⟩
  apply (large_square_divisor_card_le hz F hF hsquare).trans
  exact div_le_div_of_nonneg_right
    (mul_le_mul_of_nonneg_left (Nat.floor_le hB) (by norm_num)) hz.le

theorem rough_logarithmic_cell_nonsquarefree_card_le {γ L S Y : ℝ}
    (hL : 1 ≤ L) (hS : 0 ≤ S) (hY : 0 ≤ Y) :
    (((roughBand Y (Real.exp (L ^ (-S)) * Y) (Real.exp (γ * L))).filter
      (fun n => ¬ Squarefree n)).card : ℝ) ≤
        6 * Y * Real.exp (-γ * L) := by
  have hδ : L ^ (-S) ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos hL (neg_nonpos.mpr hS)
  have he : Real.exp (L ^ (-S)) ≤ 3 :=
    (Real.exp_le_exp.mpr hδ).trans (by linarith [Real.exp_one_lt_d9])
  have hb := rough_band_nonsquarefree_card_le (A := Y) (B := Real.exp (L ^ (-S)) * Y)
    (mul_nonneg (Real.exp_nonneg _) hY) (Real.exp_pos (γ * L))
  apply hb.trans
  have hb' : 2 * (Real.exp (L ^ (-S)) * Y) ≤ 6 * Y := by nlinarith
  have hdiv := div_le_div_of_nonneg_right hb' (Real.exp_nonneg (γ * L))
  simpa only [neg_mul, Real.exp_neg, div_eq_mul_inv] using hdiv

theorem eventually_rough_logarithmic_cell_nonsquarefree_power_bound
    {γ₀ : ℝ} (hγ₀ : 0 < γ₀) (Bsave : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ γ : ℝ, γ₀ ≤ γ → ∀ S : ℝ, 0 ≤ S →
      ∀ Y : ℝ, 0 ≤ Y →
      (((roughBand Y (Real.exp (L ^ (-S)) * Y) (Real.exp (γ * L))).filter
        (fun n => ¬ Squarefree n)).card : ℝ) ≤ L ^ (-Bsave) * Y := by
  filter_upwards [eventually_linear_exponential_profile_le_rpow hγ₀ hγ₀ 6 0 Bsave,
    eventually_ge_atTop (1 : ℝ)] with L hdecay hL
  intro γ hγ S hS Y hY
  have hmono : Real.exp (-γ * L) ≤ Real.exp (-γ₀ * L) := by
    apply Real.exp_le_exp.mpr
    nlinarith
  calc
    _ ≤ 6 * Y * Real.exp (-γ * L) :=
      rough_logarithmic_cell_nonsquarefree_card_le hL hS hY
    _ ≤ 6 * Y * Real.exp (-γ₀ * L) :=
      mul_le_mul_of_nonneg_left hmono (by positivity)
    _ = (6 * Real.exp (-γ₀ * L)) * Y := by ring
    _ ≤ L ^ (-Bsave) * Y := by
      apply mul_le_mul_of_nonneg_right _ hY
      simpa only [zero_mul, zero_add, add_zero] using hdecay

theorem rough_band_squarefree_count_error (A B z : ℝ) :
    |((roughBand A B z).card : ℝ) -
      (((roughBand A B z).filter Squarefree).card : ℝ)| =
        (((roughBand A B z).filter (fun n => ¬ Squarefree n)).card : ℝ) := by
  classical
  have hcard : (((roughBand A B z).filter Squarefree).card : ℝ) +
      (((roughBand A B z).filter (fun n => ¬ Squarefree n)).card : ℝ) =
        ((roughBand A B z).card : ℝ) := by
    exact_mod_cast (card_filter_add_card_filter_not (s := roughBand A B z) Squarefree)
  rw [← hcard, add_sub_cancel_left, abs_of_nonneg (Nat.cast_nonneg _)]

theorem eventually_rough_logarithmic_cell_squarefree_count_error
    {γ₀ S : ℝ} (hγ₀ : 0 < γ₀) (hS : 0 ≤ S) (Bsave : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ γ : ℝ, γ₀ ≤ γ → ∀ Y : ℝ, 0 ≤ Y →
      |((roughBand Y (Real.exp (L ^ (-S)) * Y) (Real.exp (γ * L))).card : ℝ) -
        (((roughBand Y (Real.exp (L ^ (-S)) * Y) (Real.exp (γ * L))).filter
          Squarefree).card : ℝ)| ≤
        L ^ (-Bsave) * ((Real.exp (L ^ (-S)) * Y - Y) / L) := by
  filter_upwards [eventually_rough_logarithmic_cell_nonsquarefree_power_bound
    hγ₀ (Bsave + S + 1), eventually_gt_atTop (0 : ℝ)] with L hcount hL
  intro γ hγ Y hY
  rw [rough_band_squarefree_count_error]
  calc
    _ ≤ L ^ (-(Bsave + S + 1)) * Y := hcount γ hγ S hS Y hY
    _ = L ^ (-Bsave) * (L ^ (-S) * Y / L) := by
      rw [show -(Bsave + S + 1) = (-Bsave + -S) - 1 by ring,
        Real.rpow_sub hL, Real.rpow_add hL, Real.rpow_one]
      ring
    _ ≤ L ^ (-Bsave) * ((Real.exp (L ^ (-S)) * Y - Y) / L) := by
      apply mul_le_mul_of_nonneg_left _ (Real.rpow_nonneg hL.le _)
      apply div_le_div_of_nonneg_right _ hL.le
      have he := Real.add_one_le_exp (L ^ (-S))
      nlinarith

end Bounty



end

section

/- The original ledger rows form a full projected edge without altering the ledger update. -/

open Finset
namespace Bounty
universe uJ uK uP uA
section Full
variable {J : Type uJ} {K : Type uK} {N : ℕ} {P : Fin N → Type uP}
  [∀ g, DecidableEq (P g)] [∀ g, Fintype (P g)]
  (n : (g : Fin N) → P g → ℕ) [∀ g p, NeZero (n g p)] {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type uA) [∀ k c, Fintype (A k c)]
  (Δ D : ∀ k c, A k c → Fin N → ℤ)
  (edgePhase : ∀ k, ((g : Fin N) → Finset (P g)) →
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) →
    FullActiveEdgeEvent n (S k) B (A k) (Δ k) (D k) x → ℂ)
  (ω : ∀ k c, A k c → ℝ) (μ : (g : Fin N) → P g → ℝ)
  (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

theorem full_mixed_ledger_edge_event_sum (k : K)
    (F : FullMixedLedgerState n (M := M) B → ℂ)
    (s : FullMixedLedgerState n (M := M) B) :
    fullMixedLedgerRow n S B A Δ D edgePhase ω μ q ρ V (some (.inr k)) F s =
      ∑ e : FullActiveEdgeEvent n (S k) B (A k) (Δ k) (D k) s.2,
        (fullActiveEdgeEventWeight n (S k) B (A k) (Δ k) (D k) (ω k) μ ρ V s.2 e : ℂ) *
          edgePhase k s.1 s.2 e * F (fullMixedLedgerTarget (J := J) n S B A Δ D (some (.inr k)) s e) := by
  unfold fullMixedLedgerRow finiteLocalPhasedRow
  apply sum_congr
  · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
  · intro e _
    rfl

theorem full_mixed_ledger_three_rows (k : K)
    (F : FullMixedLedgerState n (M := M) B → ℂ)
    (s : FullMixedLedgerState n (M := M) B) :
    fullMixedLedgerRow n S B A Δ D edgePhase ω μ q ρ V none
      (fullMixedLedgerRow n S B A Δ D edgePhase ω μ q ρ V (some (.inr k))
        (fullMixedLedgerRow n S B A Δ D edgePhase ω μ q ρ V none F)) s =
      fullActiveAverage (fun x =>
        fullMixedLedgerRow n S B A Δ D edgePhase ω μ q ρ V (some (.inr k))
          (fun t => fullActiveAverage (fun y => F (t.1, y)) t.2) (s.1, x)) s.2 := by
  rw [full_mixed_ledger_row_permutation]
  have hperm : fullMixedLedgerRow n S B A Δ D edgePhase ω μ q ρ V none F =
      fun t => fullActiveAverage (fun y => F (t.1, y)) t.2 := by
    funext t
    exact full_mixed_ledger_row_permutation n S B A Δ D edgePhase ω μ q ρ V F t
  rw [hperm]

end Full
end Bounty
end

section

/- The empty-memory sector is an exact positive part of the full finite
ordered-memory measure. This also applies to one active residue label. -/

open Finset Classical

namespace Bounty

theorem bounded_ordered_empty_one_energy_le {P Z : Type*}
    [Fintype P] [Fintype Z] (μ : P → ℝ) (ν : Z → ℝ)
    (hμ : ∀ p, 0 ≤ μ p) (hν : ∀ z, 0 ≤ ν z) (B : ℕ)
    (F : BoundedOrderedState P Z 1 B → ℂ) :
    (∑ p, μ p * ‖F (fun _ : Fin 1 => p, ⟨0, Fin.elim0⟩)‖ ^ 2) ≤
      finiteWeightedEnergy (boundedOrderedStateWeight μ ν) F := by
  let e : P → BoundedOrderedState P Z 1 B :=
    fun p => (fun _ : Fin 1 => p, ⟨0, Fin.elim0⟩)
  have hi : Function.Injective e := by
    intro p q h
    exact congrArg (fun s : BoundedOrderedState P Z 1 B => s.1 0) h
  have hw (p : P) : boundedOrderedStateWeight μ ν (e p) = μ p := by
    change (∏ _i : Fin 1, μ p) * ((∏ j : Fin 0, ν (Fin.elim0 j)) / (Nat.factorial 0 : ℝ)) = μ p
    simp
  calc
    _ = ∑ s ∈ (univ : Finset P).image e, boundedOrderedStateWeight μ ν s * ‖F s‖ ^ 2 := by
      rw [sum_image hi.injOn]
      simp only [hw, e]
    _ ≤ _ := sum_le_sum_of_subset_of_nonneg (subset_univ _)
      (fun s _ _ => mul_nonneg (boundedOrderedStateWeight_nonneg μ ν hμ hν s) (sq_nonneg _))

theorem unrestricted_empty_one_energy_le {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ)
    (hμ : ∀ p, 0 ≤ μ p) (B : ℕ)
    (F : BoundedOrderedState P (UnrestrictedResidueParticle n) 1 B → ℂ) :
    (∑ p, μ p * ‖F (fun _ : Fin 1 => p, ⟨0, Fin.elim0⟩)‖ ^ 2) ≤
      finiteWeightedEnergy (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ)) F := by
  exact bounded_ordered_empty_one_energy_le μ (unrestrictedResidueWeight μ)
    hμ (fun z => hμ z.1) B F

end Bounty
end

section

/- The actual candidate prime ranges discharge the arithmetic hypotheses
for uniform small-group omission averaging. Source lists remain injective,
and no shared small-group product is conditioned on before the average. -/

open Finset Filter
open scoped Classical Topology

namespace Bounty

noncomputable def candidateOmissionPools (s L : ℝ) :
    ↥(candidatePIndices s L) → Finset ℕ :=
  fun g => candidatePBand (s * L) g.val

noncomputable def candidateOmissionSmallGroups (s L : ℝ) :
    Finset ↥(candidatePIndices s L) :=
  univ.filter (fun g => g.val ∈ candidateSmallPIndices s L)

noncomputable def candidateOmissionCut {J : ℕ} (s L : ℝ)
    (C : ↥(candidatePIndices s L) → Finset (Fin J))
    (g : ↥(candidatePIndices s L)) : Finset (Fin J) :=
  if g.val ∈ candidateSmallPIndices s L then ∅ else C g

theorem candidate_omission_small_groups_mem (s L : ℝ)
    (g : ↥(candidatePIndices s L)) :
    g ∈ candidateOmissionSmallGroups s L ↔ g.val ∈ candidateSmallPIndices s L := by
  simp only [candidateOmissionSmallGroups, mem_filter, mem_univ, true_and]

theorem candidate_omission_small_groups_card (s L : ℝ) :
    (candidateOmissionSmallGroups s L).card = (candidateSmallPIndices s L).card := by
  apply card_bij (fun g _ => g.val)
  · intro g hg
    exact (candidate_omission_small_groups_mem s L g).mp hg
  · intro g hg h hh he
    exact Subtype.ext he
  · intro j hj
    refine ⟨⟨j, mem_union_left _ hj⟩, ?_, rfl⟩
    exact (candidate_omission_small_groups_mem s L _).mpr hj

theorem candidate_omission_cut_small {J : ℕ} (s L : ℝ)
    (C : ↥(candidatePIndices s L) → Finset (Fin J))
    (g : ↥(candidatePIndices s L)) (hg : g ∈ candidateOmissionSmallGroups s L) :
    candidateOmissionCut s L C g = ∅ := by
  exact if_pos ((candidate_omission_small_groups_mem s L g).mp hg)

theorem eventually_candidate_omission_bounds {s : ℝ} (hs : 0 < s)
    (ell : ℕ) (C₂ : ℝ) :
    ∀ᶠ L : ℝ in atTop,
      (Real.exp (L ^ (1/5 : ℝ))) ^ (ell * (candidateSmallPIndices s L).card) <
        Real.exp (L ^ (3/10 : ℝ)) ∧
      L ^ C₂ < Real.exp (L ^ (3/10 : ℝ)) ∧
      (∀ j ∈ candidateSmallPIndices s L, ∀ p ∈ candidatePBand (s * L) j,
        (p : ℝ) ≤ Real.exp (L ^ (1/5 : ℝ))) ∧
      (∀ j ∈ candidateBigPIndices s L, ∀ p ∈ candidatePBand (s * L) j,
        Nat.Prime p ∧ Real.exp (L ^ (3/10 : ℝ)) < (p : ℝ)) ∧
      (∀ j ∈ candidatePIndices s L, ∀ p ∈ candidatePBand (s * L) j, Nat.Prime p) ∧
      Pairwise (fun i j : ℕ => Disjoint (candidatePBand (s * L) i)
        (candidatePBand (s * L) j)) := by
  obtain ⟨vs, Vs, _, _, hsmall⟩ := eventually_candidate_P_groups
    (α := (1/10 : ℝ)) (β := (1/5 : ℝ)) hs (by norm_num) (by norm_num) (by norm_num)
  obtain ⟨vb, Vb, _, _, hbig⟩ := eventually_candidate_P_groups
    (α := (3/10 : ℝ)) (β := (2/5 : ℝ)) hs (by norm_num) (by norm_num) (by norm_num)
  filter_upwards [hsmall, hbig,
    eventually_small_omission_power_lt (show (1/5 : ℝ) < 3/10 by norm_num)
      ell (1 / (5 * Real.log 2)),
    eventually_log_times_rpow_lt (show (0 : ℝ) < 3/10 by norm_num) C₂,
    eventually_gt_atTop (0 : ℝ)] with L hsL hbL hpower hstep hL
  have hcard : ((candidateSmallPIndices s L).card : ℝ) ≤
      (1 / (5 * Real.log 2)) * Real.log L := by
    have hc := hsL.2.1
    change ((candidateSmallPIndices s L).card : ℝ) ≤ _ at hc
    rw [show 2 * ((1/5 : ℝ) - 1/10) / Real.log 2 = 1 / (5 * Real.log 2) by ring] at hc
    exact hc
  refine ⟨hpower _ hcard, ?_, ?_, ?_, ?_, hsL.2.2.1⟩
  · rw [Real.rpow_def_of_pos hL]
    apply Real.exp_lt_exp.mpr
    simpa only [Real.rpow_zero, mul_one, mul_comm] using hstep
  · intro j hj p hp
    exact ((hsL.2.2.2 j hj).2.2 p hp).2.2
  · intro j hj p hp
    exact ⟨((hbL.2.2.2 j hj).2.2 p hp).1, ((hbL.2.2.2 j hj).2.2 p hp).2.1⟩
  · intro j hj p hp
    rcases mem_union.mp hj with hj | hj
    · exact ((hsL.2.2.2 j hj).2.2 p hp).1
    · exact ((hbL.2.2.2 j hj).2.2 p hp).1

theorem eventually_candidate_physical_omission_arithmetic {s : ℝ} (hs : 0 < s)
    (ell : ℕ) (C₂ : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ J : ℕ,
      ∀ labels : PhysicalMarkLists (candidateOmissionPools s L) J ell,
      ∀ p ∈ (candidateBigPIndices s L).biUnion (candidatePBand (s * L)),
      ∀ k : ℤ, k ≠ 0 → (k.natAbs : ℝ) ≤ L ^ C₂ →
      ¬ (p : ℤ) ∣ k ∧
        ∀ σ : ↥(candidateOmissionSmallGroups s L) → Equiv.Perm (PhysicalSlots J ell),
          primeOmissionProduct (physicalSmallSourcePools (candidateOmissionSmallGroups s L) labels) ell
            (physicalSmallOmissions (candidateOmissionSmallGroups s L) labels
              (physicalExtendSmallPermutations (candidateOmissionSmallGroups s L) σ)) < p := by
  filter_upwards [eventually_candidate_omission_bounds hs ell C₂] with L hL
  intro J labels p hp k hk hkbound
  obtain ⟨j, hj, hpj⟩ := mem_biUnion.mp hp
  have hpLower := (hL.2.2.2.1 j hj p hpj).2
  refine ⟨physical_pending_step_not_dvd_of_bounds (Int.natAbs_pos.mpr hk)
    (hkbound.trans_lt hL.2.1) hpLower.le, ?_⟩
  intro σ
  apply physical_small_omission_lt_of_bounds (candidateOmissionSmallGroups s L) labels
    (H := Real.exp (L ^ (1/5 : ℝ))) (P₀ := Real.exp (L ^ (3/10 : ℝ)))
    _ _ p hpLower.le σ
  · intro g hg q hq
    exact hL.2.2.1 g.val ((candidate_omission_small_groups_mem s L g).mp hg) q hq
  · simpa only [candidate_omission_small_groups_card] using hL.1

theorem eventually_candidate_physical_eligible_fraction_le {Particle : Type*}
    {s : ℝ} (hs : 0 < s) (ell : ℕ) (C₂ : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ J : ℕ,
      ∀ C : ↥(candidatePIndices s L) → Finset (Fin J),
      ∀ labels : PhysicalMarkLists (candidateOmissionPools s L) J ell,
      ∀ aux : PhysicalAuxLabels (candidateOmissionPools s L) (candidateOmissionCut s L C),
      ∀ pending : Finset Particle,
      ∀ p : Particle → ↥((candidateBigPIndices s L).biUnion (candidatePBand (s * L))),
      ∀ r : ∀ z, ZMod (p z).val,
      ∀ k : ℤ, k ≠ 0 → (k.natAbs : ℝ) ≤ L ^ C₂ →
      letI : DecidableEq ↥(candidateOmissionSmallGroups s L) := Classical.decEq _
      letI : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
      ((univ.filter (fun σ : ↥(candidateOmissionSmallGroups s L) → Equiv.Perm (PhysicalSlots J ell) =>
          ∃ z ∈ pending,
            ¬ (p z).val ∣ physicalD (candidateOmissionCut s L C)
              (physicalPermuteLabels (physicalExtendSmallPermutations (candidateOmissionSmallGroups s L) σ) labels) aux ∧
            r z + (k : ZMod (p z).val) *
              (physicalD (candidateOmissionCut s L C)
                (physicalPermuteLabels (physicalExtendSmallPermutations (candidateOmissionSmallGroups s L) σ) labels) aux :
                ZMod (p z).val) = 0)).card : ℝ) /
          (Fintype.card (↥(candidateOmissionSmallGroups s L) → Equiv.Perm (PhysicalSlots J ell)) : ℝ) ≤
        (pending.card : ℝ) / (((J + ell).choose ell) ^ (candidateSmallPIndices s L).card : ℕ) := by
  filter_upwards [eventually_candidate_omission_bounds hs ell C₂,
    eventually_candidate_physical_omission_arithmetic hs ell C₂] with L hL harith
  intro J C labels aux pending p r k hk hkbound
  let : DecidableEq ↥(candidateOmissionSmallGroups s L) := Classical.decEq _
  let : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
  have hp : ∀ z, ((p z).val).Prime := by
    intro z
    obtain ⟨j, hj, hpj⟩ := mem_biUnion.mp (p z).property
    exact (hL.2.2.2.1 j hj (p z).val hpj).1
  have hP : ∀ g q, q ∈ candidateOmissionPools s L g → q.Prime := by
    intro g q hq
    exact hL.2.2.2.2.1 g.val g.property q hq
  have hdis : Pairwise (fun g h : ↥(candidatePIndices s L) =>
      Disjoint (candidateOmissionPools s L g) (candidateOmissionPools s L h)) := by
    intro g h hne
    exact hL.2.2.2.2.2 (fun he => hne (Subtype.ext he))
  have h := physical_small_permutation_eligible_fraction_le
    (candidateOmissionSmallGroups s L) (candidateOmissionCut s L C) labels aux
    (candidate_omission_cut_small s L C) hP hdis pending (fun z => (p z).val) hp r k
    (fun z _ => (harith J labels (p z).val (p z).property k hk hkbound).1)
    (fun z _ σ => (harith J labels (p z).val (p z).property k hk hkbound).2 σ)
  simpa only [candidate_omission_small_groups_card] using h

theorem eventually_candidate_small_source_omission_arithmetic {s : ℝ} (hs : 0 < s)
    (ell : ℕ) (C₂ : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ J : ℕ,
      ∀ labels : PhysicalMarkLists
        (fun g : ↥(candidateSmallPIndices s L) => candidatePBand (s * L) g.val) J ell,
      ∀ p ∈ (candidateBigPIndices s L).biUnion (candidatePBand (s * L)),
      ∀ k : ℤ, k ≠ 0 → (k.natAbs : ℝ) ≤ L ^ C₂ →
      ¬ (p : ℤ) ∣ k ∧
        ∀ A : PrimeOmissionChoices (physicalGroupMarks labels) ell,
          primeOmissionProduct (physicalGroupMarks labels) ell A < p := by
  filter_upwards [eventually_candidate_omission_bounds hs ell C₂] with L hL
  intro J labels p hp k hk hkbound
  obtain ⟨j, hj, hpj⟩ := mem_biUnion.mp hp
  have hpLower := (hL.2.2.2.1 j hj p hpj).2
  refine ⟨physical_pending_step_not_dvd_of_bounds (Int.natAbs_pos.mpr hk)
    (hkbound.trans_lt hL.2.1) hpLower.le, ?_⟩
  intro A
  have hbound := prime_omission_product_real_le_pow (physicalGroupMarks labels) ell
    (fun g q hq => hL.2.2.1 g.val g.property q (physical_group_marks_subset labels g hq)) A
  rw [Fintype.card_coe] at hbound
  exact_mod_cast (hbound.trans_lt hL.1).trans hpLower

theorem eventually_candidate_small_source_eligible_card_le {Particle : Type*}
    {s : ℝ} (hs : 0 < s) (ell : ℕ) (C₂ : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ J : ℕ,
      ∀ labels : PhysicalMarkLists
        (fun g : ↥(candidateSmallPIndices s L) => candidatePBand (s * L) g.val) J ell,
      ∀ D_B : ℕ, ∀ pending : Finset Particle,
      ∀ p : Particle → ↥((candidateBigPIndices s L).biUnion (candidatePBand (s * L))),
      ∀ r : ∀ z, ZMod (p z).val,
      ∀ k : ℤ, k ≠ 0 → (k.natAbs : ℝ) ≤ L ^ C₂ →
      (rareOmissionChoices (univ : Finset (PrimeOmissionChoices (physicalGroupMarks labels) ell)) pending
        (fun z A => ¬ (p z).val ∣ primeOmissionDilation (physicalGroupMarks labels) ell D_B A ∧
          r z + (k : ZMod (p z).val) *
            (primeOmissionDilation (physicalGroupMarks labels) ell D_B A : ZMod (p z).val) = 0)).card ≤
        pending.card := by
  filter_upwards [eventually_candidate_omission_bounds hs ell C₂,
    eventually_candidate_small_source_omission_arithmetic hs ell C₂] with L hL harith
  intro J labels D_B pending p r k hk hkbound
  have hS : ∀ g q, q ∈ physicalGroupMarks labels g → q.Prime := by
    intro g q hq
    exact hL.2.2.2.2.1 g.val (mem_union_left _ g.property) q
      (physical_group_marks_subset labels g hq)
  have hdis : Pairwise (fun g h => Disjoint (physicalGroupMarks labels g)
      (physicalGroupMarks labels h)) := by
    intro g h hne
    exact (hL.2.2.2.2.2 (fun he => hne (Subtype.ext he))).mono
      (physical_group_marks_subset labels g) (physical_group_marks_subset labels h)
  have hp : ∀ z, ((p z).val).Prime := by
    intro z
    obtain ⟨j, hj, hpj⟩ := mem_biUnion.mp (p z).property
    exact (hL.2.2.2.1 j hj (p z).val hpj).1
  have h := prime_omission_eligible_choices_card_le (physicalGroupMarks labels) ell hS hdis
    D_B pending (fun z => (p z).val) hp r k
    (fun z _ => (harith J labels (p z).val (p z).property k hk hkbound).1)
    (fun z _ A => (harith J labels (p z).val (p z).property k hk hkbound).2 A)
  convert h using 1
  apply congrArg Finset.card
  unfold rareOmissionChoices
  congr 1
  exact congrArg (fun inst : Fintype (PrimeOmissionChoices (physicalGroupMarks labels) ell) =>
    @Finset.univ _ inst) (Subsingleton.elim _ _)

theorem candidate_small_source_omission_choices_card (s L : ℝ) (J ell : ℕ)
    (labels : PhysicalMarkLists
      (fun g : ↥(candidateSmallPIndices s L) => candidatePBand (s * L) g.val) J ell) :
    Fintype.card (PrimeOmissionChoices (physicalGroupMarks labels) ell) =
      ((J + ell).choose ell) ^ (candidateSmallPIndices s L).card := by
  have h := prime_omission_choices_card_uniform (physicalGroupMarks labels) ell (J + ell)
    (physical_group_marks_card labels)
  rw [Fintype.card_coe] at h
  convert h using 1
  exact congrArg (fun inst : Fintype (PrimeOmissionChoices (physicalGroupMarks labels) ell) =>
    @Fintype.card _ inst) (Subsingleton.elim _ _)

theorem eventually_candidate_small_big_indices_disjoint {s : ℝ} (hs : 0 < s) :
    ∀ᶠ L : ℝ in atTop, Disjoint (candidateSmallPIndices s L) (candidateBigPIndices s L) := by
  obtain ⟨vb, Vb, hvb, _, hbig⟩ := eventually_candidate_P_groups
    (α := (3/10 : ℝ)) (β := (2/5 : ℝ)) hs (by norm_num) (by norm_num) (by norm_num)
  filter_upwards [hbig, eventually_candidate_omission_bounds hs 0 0,
    eventually_ge_atTop (1 : ℝ)] with L hb hL hOne
  apply disjoint_left.mpr
  intro j hjs hjb
  have hne : (candidatePBand (s * L) j).Nonempty := by
    apply nonempty_iff_ne_empty.mpr
    intro he
    have hv := (hb.2.2.2 j hjb).1
    rw [he, sum_empty] at hv
    exact (not_le_of_gt hvb) hv
  obtain ⟨p, hp⟩ := hne
  have hsUpper := hL.2.2.1 j hjs p hp
  have hbLower := (hL.2.2.2.1 j hjb p hp).2
  have horder : Real.exp (L ^ (1/5 : ℝ)) ≤ Real.exp (L ^ (3/10 : ℝ)) :=
    Real.exp_le_exp.mpr (Real.rpow_le_rpow_of_exponent_le hOne (by norm_num))
  exact (not_lt_of_ge (hsUpper.trans horder)) hbLower

theorem candidate_omission_cut_big {s L : ℝ} {J : ℕ}
    (hdis : Disjoint (candidateSmallPIndices s L) (candidateBigPIndices s L))
    (C : ↥(candidatePIndices s L) → Finset (Fin J))
    (g : ↥(candidatePIndices s L)) (hg : g.val ∈ candidateBigPIndices s L) :
    candidateOmissionCut s L C g = C g := by
  apply if_neg
  exact fun hs => disjoint_left.mp hdis hs hg

end Bounty
end

section

/- Literal promotion events require an eligible old memory index. This
support statement retains all event weights and both total-memory cutoffs.
It can be combined with small-source omission rarity before averaging those
source permutations; no fixed-displacement rarity is asserted. -/

open Finset
open scoped Classical

namespace Bounty

theorem unrestricted_promoting_event_eligible {P : Type*}
    (n : P → ℕ) (Δ D : ℤ) (t B : ℕ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (e : UnrestrictedBoundedEvent n Δ D t B s) (hp : e.2.1 ≠ ∅) :
    (unrestrictedResidueEligible n Δ D s.2.2).Nonempty := by
  obtain ⟨i, hi⟩ := Finset.nonempty_iff_ne_empty.mpr hp
  exact ⟨(e.2.2.1 ⟨i, hi⟩).val, (e.2.2.1 ⟨i, hi⟩).property⟩

theorem unrestricted_promoting_event_old_index {P : Type*}
    (n : P → ℕ) (Δ D : ℤ) (t B : ℕ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (e : UnrestrictedBoundedEvent n Δ D t B s) (hp : e.2.1 ≠ ∅) :
    ∃ j : Fin s.2.1.val,
      (s.2.2 j).2 = (Δ : ZMod (n (s.2.2 j).1)) ∧ ¬ (n (s.2.2 j).1 : ℤ) ∣ D := by
  obtain ⟨j, hj⟩ := unrestricted_promoting_event_eligible n Δ D t B s e hp
  exact ⟨j, (mem_unrestrictedResidueEligible n Δ D s.2.2 j).mp hj⟩

theorem unrestricted_promoting_operator_zero {P : Type*} [Fintype P]
    (n : P → ℕ) (Δ D : ℤ) (μ : P → ℝ) (ρ V : ℝ) (t B : ℕ)
    (phase : UnrestrictedBoundedPhase n Δ D t B)
    (f : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (hno : ¬ (unrestrictedResidueEligible n Δ D s.2.2).Nonempty) :
    unrestrictedBoundedOperator n Δ D μ ρ V t B
      (fun s stores promotions e fresh =>
        if promotions = ∅ then 0 else phase s stores promotions e fresh) f s = 0 := by
  rw [unrestricted_bounded_operator_eq_event_sum]
  apply sum_eq_zero
  intro e _
  have hp : e.2.1 = ∅ := by
    by_contra hp
    exact hno (unrestricted_promoting_event_eligible n Δ D t B s e hp)
  simp only [hp, if_true, mul_zero, zero_mul]

theorem unrestricted_joint_promoting_operator_zero
    {G : Type*} [Fintype G] {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) (Δ D : G → ℤ) (μ : ∀ g, P g → ℝ)
    (ρ : ℝ) (V : G → ℝ) (t : G → ℕ) (B : ℕ)
    (phase : UnrestrictedProductPhase n Δ D t B)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B)
    (hno : ¬ ∃ g, (unrestrictedResidueEligible (n g) (Δ g) (D g) (s g).2.2).Nonempty) :
    unrestrictedCoupledCutoffProductOperator n Δ D μ ρ V t B
      (fun s e => if ∃ g, (e g).2.1.Nonempty then phase s e else 0) f s = 0 := by
  rw [unrestricted_coupled_cutoff_eq_joint_event_sum]
  apply sum_eq_zero
  intro e _
  have hp : ¬ ∃ g, (e g).2.1.Nonempty := by
    rintro ⟨g, hg⟩
    exact hno ⟨g, unrestricted_promoting_event_eligible (n g) (Δ g) (D g) (t g) B (s g) (e g) hg.ne_empty⟩
  simp only [if_neg hp, mul_zero, zero_mul]

theorem unrestricted_joint_promoting_operator_support
    {G : Type*} [Fintype G] {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) (Δ D : G → ℤ) (μ : ∀ g, P g → ℝ)
    (ρ : ℝ) (V : G → ℝ) (t : G → ℕ) (B : ℕ)
    (phase : UnrestrictedProductPhase n Δ D t B)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B)
    (h : unrestrictedCoupledCutoffProductOperator n Δ D μ ρ V t B
      (fun s e => if ∃ g, (e g).2.1.Nonempty then phase s e else 0) f s ≠ 0) :
    ∃ g, (unrestrictedResidueEligible (n g) (Δ g) (D g) (s g).2.2).Nonempty := by
  by_contra hno
  exact h (unrestricted_joint_promoting_operator_zero n Δ D μ ρ V t B phase f s hno)

/-- Match the minus-displacement convention to the congruence in the
physical small-omission counting theorem. Repeated indices remain distinct. -/
theorem unrestricted_eligible_physical_congruence {P : Type*} {N : ℕ}
    (n : P → ℕ) (k : ℤ) (D : ℕ) (old : Fin N → UnrestrictedResidueParticle n) :
    (unrestrictedResidueEligible n (-(k * (D : ℤ))) D old).Nonempty ↔
      ∃ j : Fin N, ¬ n (old j).1 ∣ D ∧
        (old j).2 + (k : ZMod (n (old j).1)) * (D : ZMod (n (old j).1)) = 0 := by
  simp only [Finset.Nonempty, mem_unrestrictedResidueEligible, Int.cast_neg, Int.cast_mul,
    Int.cast_natCast, Int.natCast_dvd_natCast, eq_neg_iff_add_eq_zero]
  exact exists_congr fun _ => and_comm

end Bounty
end

section

/- A source-dependent sparse support improves an average of already
bounded operations. The support restriction is used before the energy
integral; no row-independent exceptional set is assumed. -/

open Finset
open scoped Classical

namespace Bounty

theorem finite_sparse_average_sq_le {A : Type*} [Fintype A]
    (π : A → ℝ) (hπ : ∀ a, 0 ≤ π a) (bad : A → Prop)
    (F : A → ℂ) (hzero : ∀ a, ¬ bad a → F a = 0)
    {δ : ℝ} (hδ : 0 ≤ δ) (hmass : (∑ a, if bad a then π a else 0) ≤ δ) :
    ‖∑ a, (π a : ℂ) * F a‖ ^ 2 ≤ δ * ∑ a, π a * ‖F a‖ ^ 2 := by
  let q : A → ℝ := fun a => if bad a then π a else 0
  have hq : ∀ a, 0 ≤ q a := by
    intro a
    dsimp only [q]
    split_ifs
    · exact hπ a
    · exact le_rfl
  have he : (∑ a, (π a : ℂ) * F a) = ∑ a, (q a : ℂ) * F a := by
    apply sum_congr rfl
    intro a _
    by_cases ha : bad a
    · simp only [q, if_pos ha]
    · simp only [q, if_neg ha, hzero a ha, mul_zero]
  rw [he]
  apply (finite_weighted_sum_cauchy univ q (fun a _ => hq a) F).trans
  apply mul_le_mul hmass _ _ hδ
  · apply sum_le_sum
    intro a _
    apply mul_le_mul_of_nonneg_right _ (sq_nonneg _)
    dsimp only [q]
    split_ifs
    · exact le_rfl
    · exact hπ a
  · exact sum_nonneg fun a _ => mul_nonneg (hq a) (sq_nonneg _)

theorem finite_sparse_average_energy_le {A X : Type*} [Fintype A] [Fintype X]
    (π : A → ℝ) (hπ : ∀ a, 0 ≤ π a) (hπmass : ∑ a, π a ≤ 1)
    (w : X → ℝ) (hw : ∀ x, 0 ≤ w x)
    (bad : A → X → Prop) (F : A → X → ℂ)
    (hzero : ∀ a x, ¬ bad a x → F a x = 0)
    {δ K : ℝ} (hδ : 0 ≤ δ) (hK : 0 ≤ K)
    (hmass : ∀ x, (∑ a, if bad a x then π a else 0) ≤ δ)
    (f : X → ℂ) (hF : ∀ a, finiteWeightedEnergy w (F a) ≤ K * finiteWeightedEnergy w f) :
    finiteWeightedEnergy w (fun x => ∑ a, (π a : ℂ) * F a x) ≤
      δ * K * finiteWeightedEnergy w f := by
  have hE : 0 ≤ finiteWeightedEnergy w f :=
    sum_nonneg fun x _ => mul_nonneg (hw x) (sq_nonneg _)
  calc
    _ ≤ ∑ x, w x * (δ * ∑ a, π a * ‖F a x‖ ^ 2) :=
      sum_le_sum fun x _ => mul_le_mul_of_nonneg_left
        (finite_sparse_average_sq_le π hπ (fun a => bad a x) (fun a => F a x)
          (fun a => hzero a x) hδ (hmass x)) (hw x)
    _ = δ * ∑ a, π a * finiteWeightedEnergy w (F a) := by
      simp only [finiteWeightedEnergy, mul_sum]
      rw [sum_comm]
      apply sum_congr rfl
      intro a _
      apply sum_congr rfl
      intro x _
      ring
    _ ≤ δ * ∑ a, π a * (K * finiteWeightedEnergy w f) :=
      mul_le_mul_of_nonneg_left (sum_le_sum fun a _ =>
        mul_le_mul_of_nonneg_left (hF a) (hπ a)) hδ
    _ = δ * ((∑ a, π a) * (K * finiteWeightedEnergy w f)) := by rw [sum_mul]
    _ ≤ δ * (1 * (K * finiteWeightedEnergy w f)) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_right hπmass (mul_nonneg hK hE)) hδ
    _ = _ := by ring

end Bounty
end

section

/- Exact transfer masks in the factorial-measure adjoint. A storage mask
becomes a promotion mask after reversal. Both endpoint caps are retained,
and the reverse promotion/storage normalization is explicit. -/

open Finset Classical

namespace Bounty

/-- Arbitrary coefficients depending only on the two active slot subsets
are transported by interchanging the subsets. -/
theorem unrestricted_weighted_bounded_action_pairing_reverse {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ D : ℤ) (ρ : ℝ)
    {V : ℝ} (hV : V ≠ 0) (t Bsrc Btgt : ℕ)
    (w : Finset (Fin t) → Finset (Fin t) → ℂ)
    (F H : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (hF : ∀ source, OrderedTupleSymmetric (F source))
    (hH : ∀ target, OrderedTupleSymmetric (H target)) :
    (∑ N ∈ range (Bsrc + 1),
      unrestrictedWeightedActionLevelPairing n μ Δ D ρ V t N Btgt w F H) =
    ∑ M ∈ range (Btgt + 1),
      unrestrictedWeightedActionLevelPairing n μ (-Δ) D ρ V t M Bsrc
        (fun S T => ((V ^ T.card / V ^ S.card : ℝ) : ℂ) * w T S) H F := by
  simp_rw [unrestricted_weighted_action_level_pairing_slots]
  rw [unrestricted_three_sum_rotate, unrestricted_three_sum_rotate]
  conv_rhs => rw [sum_comm]
  apply sum_congr rfl
  intro S hS
  apply sum_congr rfl
  intro T hT
  conv_lhs => rw [← mul_sum]
  conv_rhs => rw [← mul_sum]
  have hc : (((V ^ S.card / V ^ T.card : ℝ) : ℂ) * w S T) *
      ((1 / V ^ S.card : ℝ) : ℂ) = w S T * ((1 / V ^ T.card : ℝ) : ℂ) := by
    have hr : ((V ^ S.card / V ^ T.card : ℝ) : ℂ) *
        ((1 / V ^ S.card : ℝ) : ℂ) = ((1 / V ^ T.card : ℝ) : ℂ) := by
      rw [← Complex.ofReal_mul]
      congr 1
      field_simp
    calc
      _ = w S T * (((V ^ S.card / V ^ T.card : ℝ) : ℂ) *
          ((1 / V ^ S.card : ℝ) : ℂ)) := by ring
      _ = _ := by rw [hr]
  conv_rhs => rw [hc]
  apply congrArg (fun z : ℂ => (w S T * ((1 / V ^ T.card : ℝ) : ℂ)) * z)
  have hr := unrestricted_fixed_slot_bounded_reverse n μ Δ D t Bsrc Btgt S T
    (unrestrictedDampedPair n ρ F H)
    (unrestricted_damped_pair_source_symmetric n ρ F H hF)
    (unrestricted_damped_pair_target_symmetric n ρ F H hH)
  refine hr.trans ?_
  apply sum_congr rfl
  intro M hM
  apply congrArg (unrestrictedFixedSlotPairing n μ (-Δ) D t M T S)
  funext target source Y X
  split_ifs
  · unfold unrestrictedDampedPair
    push_cast
    ring
  · rfl

/-- Literal bounded-state masked adjoint, with independently chosen source
and target caps. No positivity or normalization of the label law is needed. -/
theorem unrestricted_bounded_masked_pairing_reverse {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ D : ℤ) (ρ : ℝ)
    {V : ℝ} (hV : V ≠ 0) (t Bsrc Btgt : ℕ)
    (w : Finset (Fin t) → Finset (Fin t) → ℂ)
    (F H : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (hF : ∀ source, OrderedTupleSymmetric (F source))
    (hH : ∀ target, OrderedTupleSymmetric (H target)) :
    (∑ s : BoundedOrderedState P (UnrestrictedResidueParticle n) t Bsrc,
      (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s : ℂ) *
        F s.1 (boundedOrderedTupleToFinite s.2) *
        unrestrictedResidueEdgeAction n Δ D s.1 s.2.2 μ ρ V Btgt
          (fun S T _ _ => w S T) H) =
    ∑ s : BoundedOrderedState P (UnrestrictedResidueParticle n) t Btgt,
      (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s : ℂ) *
        unrestrictedResidueEdgeAction n (-Δ) D s.1 s.2.2 μ ρ V Bsrc
          (fun S T _ _ => ((V ^ T.card / V ^ S.card : ℝ) : ℂ) * w T S) F *
        H s.1 (boundedOrderedTupleToFinite s.2) := by
  let A (source : Fin t → P) (q : FiniteOrderedTuple (UnrestrictedResidueParticle n)) : ℂ :=
    unrestrictedResidueEdgeAction n Δ D source q.2 μ ρ V Btgt (fun S T _ _ => w S T) H
  let R (source : Fin t → P) (q : FiniteOrderedTuple (UnrestrictedResidueParticle n)) : ℂ :=
    unrestrictedResidueEdgeAction n (-Δ) D source q.2 μ ρ V Bsrc
      (fun S T _ _ => ((V ^ T.card / V ^ S.card : ℝ) : ℂ) * w T S) F
  have hl := bounded_ordered_pairing_levels μ (unrestrictedResidueWeight μ) t Bsrc F A
  have hr := bounded_ordered_pairing_levels μ (unrestrictedResidueWeight μ) t Btgt H R
  calc
    _ = ∑ N ∈ range (Bsrc + 1),
        unrestrictedWeightedActionLevelPairing n μ Δ D ρ V t N Btgt w F H := hl
    _ = ∑ M ∈ range (Btgt + 1),
        unrestrictedWeightedActionLevelPairing n μ (-Δ) D ρ V t M Bsrc
          (fun S T => ((V ^ T.card / V ^ S.card : ℝ) : ℂ) * w T S) H F :=
      unrestricted_weighted_bounded_action_pairing_reverse n μ Δ D ρ hV t Bsrc Btgt w F H hF hH
    _ = ∑ s : BoundedOrderedState P (UnrestrictedResidueParticle n) t Btgt,
        (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s : ℂ) *
          H s.1 (boundedOrderedTupleToFinite s.2) * R s.1 (boundedOrderedTupleToFinite s.2) := hr.symm
    _ = _ := by
      apply sum_congr rfl
      intro s hs
      change (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s : ℂ) *
          H s.1 (boundedOrderedTupleToFinite s.2) * R s.1 (boundedOrderedTupleToFinite s.2) =
        (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s : ℂ) *
          R s.1 (boundedOrderedTupleToFinite s.2) * H s.1 (boundedOrderedTupleToFinite s.2)
      ring

/-- The storage-only half of the disjoint dirty partition reverses to a
promotion event with no storage. -/
theorem unrestricted_storage_only_pairing_reverse {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ D : ℤ) (ρ : ℝ)
    {V : ℝ} (hV : V ≠ 0) (t Bsrc Btgt : ℕ)
    (F H : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (hF : ∀ source, OrderedTupleSymmetric (F source))
    (hH : ∀ target, OrderedTupleSymmetric (H target)) :
    (∑ s : BoundedOrderedState P (UnrestrictedResidueParticle n) t Bsrc,
      (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s : ℂ) *
        F s.1 (boundedOrderedTupleToFinite s.2) *
        unrestrictedResidueEdgeAction n Δ D s.1 s.2.2 μ ρ V Btgt
          (fun S T _ _ => if T = ∅ ∧ S ≠ ∅ then 1 else 0) H) =
    ∑ s : BoundedOrderedState P (UnrestrictedResidueParticle n) t Btgt,
      (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s : ℂ) *
        unrestrictedResidueEdgeAction n (-Δ) D s.1 s.2.2 μ ρ V Bsrc
          (fun S T _ _ => ((V ^ T.card / V ^ S.card : ℝ) : ℂ) *
            (if S = ∅ ∧ T ≠ ∅ then 1 else 0)) F *
        H s.1 (boundedOrderedTupleToFinite s.2) :=
  unrestricted_bounded_masked_pairing_reverse n μ Δ D ρ hV t Bsrc Btgt
    (fun S T => if T = ∅ ∧ S ≠ ∅ then 1 else 0) F H hF hH

/-- The finite operator with a source-independent active-subset coefficient. -/
noncomputable def unrestrictedSlotOperator {P : Type*} [Fintype P]
    (n : P → ℕ) (Δ D : ℤ) (μ : P → ℝ) (ρ V : ℝ) (t B : ℕ)
    (w : Finset (Fin t) → Finset (Fin t) → ℂ) :=
  unrestrictedBoundedOperator n Δ D μ ρ V t B (fun _ S T _ _ => w S T)

theorem unrestricted_slot_operator_symmetric {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (Δ D : ℤ) (μ : P → ℝ)
    (ρ V : ℝ) (t B : ℕ) (w : Finset (Fin t) → Finset (Fin t) → ℂ)
    (f : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
    (hf : BoundedOrderedSymmetric f) :
    BoundedOrderedSymmetric (unrestrictedSlotOperator n Δ D μ ρ V t B w f) := by
  intro active N old τ
  unfold unrestrictedSlotOperator unrestrictedBoundedOperator unrestrictedBoundedAction
    unrestrictedResidueEdgeAction
  dsimp only
  rw [unrestricted_residue_eligible_perm]
  apply unrestricted_edge_action_perm
  · intros; rfl
  · exact (boundedOrderedZeroExtension_symmetric_iff f).mpr hf

/-- The finite operator version of masked duality. The tests need only be
symmetric on the bounded state space. -/
theorem unrestricted_slot_operator_pairing_reverse {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (Δ D : ℤ) (μ : P → ℝ) (ρ : ℝ)
    {V : ℝ} (hV : V ≠ 0) (t B : ℕ)
    (w : Finset (Fin t) → Finset (Fin t) → ℂ)
    (f g : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
    (hf : BoundedOrderedSymmetric f) (hg : BoundedOrderedSymmetric g) :
    (∑ s, (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s : ℂ) * f s *
      unrestrictedSlotOperator n Δ D μ ρ V t B w g s) =
    ∑ s, (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s : ℂ) *
      unrestrictedSlotOperator n (-Δ) D μ ρ V t B
        (fun S T => ((V ^ T.card / V ^ S.card : ℝ) : ℂ) * w T S) f s * g s := by
  have h := unrestricted_bounded_masked_pairing_reverse n μ Δ D ρ hV t B B w
    (boundedOrderedZeroExtension f) (boundedOrderedZeroExtension g)
    ((boundedOrderedZeroExtension_symmetric_iff f).mpr hf)
    ((boundedOrderedZeroExtension_symmetric_iff g).mpr hg)
  simpa only [boundedOrderedZeroExtension_apply, unrestrictedSlotOperator,
    unrestrictedBoundedOperator, unrestrictedBoundedAction] using h

/-- An arbitrary finite weighted choice of slot operators. The displacement,
storage divisor and slot coefficient may all depend on the choice. -/
noncomputable def unrestrictedSlotAverage {Ω P : Type*} [Fintype Ω] [Fintype P]
    (n : P → ℕ) (Δ D : Ω → ℤ) (μ : P → ℝ) (ρ V : ℝ) (t B : ℕ)
    (α : Ω → ℂ) (w : Ω → Finset (Fin t) → Finset (Fin t) → ℂ)
    (f : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B) : ℂ :=
  ∑ a, α a * unrestrictedSlotOperator n (Δ a) (D a) μ ρ V t B (w a) f s

theorem unrestricted_slot_average_symmetric {Ω P : Type*} [Fintype Ω] [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (Δ D : Ω → ℤ) (μ : P → ℝ)
    (ρ V : ℝ) (t B : ℕ) (α : Ω → ℂ)
    (w : Ω → Finset (Fin t) → Finset (Fin t) → ℂ)
    (f : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
    (hf : BoundedOrderedSymmetric f) :
    BoundedOrderedSymmetric (unrestrictedSlotAverage n Δ D μ ρ V t B α w f) := by
  intro active N q τ
  apply sum_congr rfl
  intro a ha
  rw [unrestricted_slot_operator_symmetric n (Δ a) (D a) μ ρ V t B (w a) f hf active N q τ]

/-- Averaging does not change the exact transpose. The same choice and weight
appear in the reverse operator, with displacement negated. -/
theorem unrestricted_slot_average_pairing_reverse {Ω P : Type*} [Fintype Ω] [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (Δ D : Ω → ℤ) (μ : P → ℝ) (ρ : ℝ)
    {V : ℝ} (hV : V ≠ 0) (t B : ℕ) (α : Ω → ℂ)
    (w : Ω → Finset (Fin t) → Finset (Fin t) → ℂ)
    (f g : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
    (hf : BoundedOrderedSymmetric f) (hg : BoundedOrderedSymmetric g) :
    (∑ s, (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s : ℂ) * f s *
      unrestrictedSlotAverage n Δ D μ ρ V t B α w g s) =
    ∑ s, (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s : ℂ) *
      unrestrictedSlotAverage n (fun a => -Δ a) D μ ρ V t B α
        (fun a S T => ((V ^ T.card / V ^ S.card : ℝ) : ℂ) * w a T S) f s * g s := by
  unfold unrestrictedSlotAverage
  simp_rw [mul_sum, sum_mul]
  rw [sum_comm, sum_comm (s := (univ : Finset (BoundedOrderedState P
    (UnrestrictedResidueParticle n) t B)))]
  apply sum_congr rfl
  intro a ha
  have h := congrArg (fun z : ℂ => α a * z)
    (unrestricted_slot_operator_pairing_reverse n (Δ a) (D a) μ ρ hV t B (w a) f g hf hg)
  simpa only [mul_sum, mul_assoc, mul_comm, mul_left_comm] using h

end Bounty
end

section

/- Exact insertion of the average over a selected set of active groups.
This keeps the selected source permutations inside an arbitrary intervening
operator. Groups outside the selected set and all pending memories stay
fixed. No injectivity of active label lists or covariance of the operator is
required. -/

open Finset
open scoped Classical

namespace Bounty

abbrev FullActiveGroupPermutations {G : Type*} (M : G → ℕ) (groups : Finset G) :=
  ∀ g : groups, Equiv.Perm (Fin (M g.val))

noncomputable def fullActiveExtendGroupPermutation {G : Type*}
    {M : G → ℕ} (groups : Finset G) (σ : FullActiveGroupPermutations M groups) :
    FullActiveSlotPermutations M :=
  fun g => if hg : g ∈ groups then σ ⟨g, hg⟩ else Equiv.refl _

theorem fullActiveExtendGroupPermutation_outside {G : Type*}
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ}
    (groups : Finset G) (σ : FullActiveGroupPermutations M groups)
    (x : ProductBoundedOrderedState P Z M B) (g : G) (hg : g ∉ groups) :
    fullActivePermutation (fullActiveExtendGroupPermutation groups σ) x g = x g := by
  change ((x g).1 ∘ fullActiveExtendGroupPermutation groups σ g, (x g).2) = x g
  simp only [fullActiveExtendGroupPermutation, dif_neg hg, Equiv.coe_refl, Function.comp_id]

theorem fullActiveExtendGroupPermutation_inside {G : Type*}
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ}
    (groups : Finset G) (σ : FullActiveGroupPermutations M groups)
    (x : ProductBoundedOrderedState P Z M B) (g : groups) :
    fullActivePermutation (fullActiveExtendGroupPermutation groups σ) x g.val =
      ((x g.val).1 ∘ σ g, (x g.val).2) := by
  change ((x g.val).1 ∘ fullActiveExtendGroupPermutation groups σ g.val, (x g.val).2) = _
  simp only [fullActiveExtendGroupPermutation, dif_pos g.property]

noncomputable def fullActiveGroupAverage {G : Type*} [Fintype G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ}
    (groups : Finset G) (f : ProductBoundedOrderedState P Z M B → ℂ)
    (x : ProductBoundedOrderedState P Z M B) : ℂ :=
  (Fintype.card (FullActiveGroupPermutations M groups) : ℂ)⁻¹ *
    ∑ σ : FullActiveGroupPermutations M groups,
      f (fullActivePermutation (fullActiveExtendGroupPermutation groups σ) x)

theorem fullActiveGroupAverage_fullActiveAverage {G : Type*} [Fintype G] [dG : DecidableEq G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ}
    (groups : Finset G) (f : ProductBoundedOrderedState P Z M B → ℂ) :
    fullActiveGroupAverage groups (fullActiveAverage f) = fullActiveAverage f := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  funext x
  unfold fullActiveGroupAverage
  simp only [fullActiveAverage_invariant, sum_const, card_univ, nsmul_eq_mul]
  rw [← mul_assoc, inv_mul_cancel₀ (Nat.cast_ne_zero.mpr Fintype.card_ne_zero), one_mul]

theorem fullActiveAverage_fullActiveGroupAverage {G : Type*} [Fintype G] [dG : DecidableEq G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ}
    (groups : Finset G) (f : ProductBoundedOrderedState P Z M B → ℂ) :
    fullActiveAverage (fullActiveGroupAverage groups f) = fullActiveAverage f := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  funext x
  have h : fullActiveAverage (fullActiveGroupAverage groups f) x =
      (Fintype.card (FullActiveGroupPermutations M groups) : ℂ)⁻¹ *
        ∑ σ : FullActiveGroupPermutations M groups,
          fullActiveAverage (fun y => f (fullActivePermutation
            (fullActiveExtendGroupPermutation groups σ) y)) x := by
    unfold fullActiveAverage fullActiveGroupAverage
    simp only [mul_sum]
    rw [sum_comm]
    apply sum_congr rfl
    intro σ _
    apply sum_congr rfl
    intro τ _
    ring
  erw [h]
  simp only [fullActiveAverage_absorb_input_permutation, sum_const, card_univ, nsmul_eq_mul]
  rw [← mul_assoc, inv_mul_cancel₀ (Nat.cast_ne_zero.mpr Fintype.card_ne_zero), one_mul]
  rfl

/-- The small-group source average can be kept inside the full outer
projection, where eligibility remains visible for a sparse-average bound. -/
theorem fullActiveAverage_group_source_insertion
    {G : Type*} [Fintype G] [dG : DecidableEq G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ}
    (groups : Finset G)
    (T : (ProductBoundedOrderedState P Z M B → ℂ) →
      ProductBoundedOrderedState P Z M B → ℂ)
    (f : ProductBoundedOrderedState P Z M B → ℂ) :
    fullActiveAverage (T (fullActiveAverage f)) =
      fullActiveAverage (fullActiveGroupAverage groups
        (T (fullActiveGroupAverage groups (fullActiveAverage f)))) := by
  rw [fullActiveGroupAverage_fullActiveAverage, fullActiveAverage_fullActiveGroupAverage]

end Bounty
end

section

/- Exact spectator factorization for the mixed model with injective small
mark lists and unrestricted big-group pending memory. These identities do
not identify that model with the unrestricted all-group memory model.
At each fixed small prefix and auxiliary draw, event coefficients and
big-state targets are independent of the small completion being summed.
The small target residue may be chosen separately for each auxiliary draw. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_small_condition_weighted_sum
    {G E : Type*} [Fintype G] [DecidableEq G] [Fintype E]
    {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (q : ℝ) (r : PhysicalResidues P) (d : PhysicalSharedLists P J)
    (a : E → ℂ) (f : E → PhysicalMarkLists P J ell → ℂ) :
    physicalSmallCondition V q r d (fun L => ∑ e, a e * f e L) =
      ∑ e, a e * physicalSmallCondition V q r d (f e) := by
  simp only [physical_small_condition_eq_vertex_sum, mul_sum]
  rw [sum_comm]
  apply sum_congr rfl
  intro L _
  by_cases h : physicalSharedPrefix L = d
  · simp only [if_pos h, mul_sum]
    apply sum_congr rfl
    intro e _
    ring
  · simp only [if_neg h, mul_zero, sum_const_zero]

/-- Actual big-group event weights, retrievals, phases, and both total-memory
caps commute with small conditioning when they are fixed before the small
completion is summed. No symmetry or positivity is needed for this identity. -/
theorem physical_small_condition_coupled_big_events
    {S G : Type*} [Fintype S] [DecidableEq S] [Fintype G]
    {Ps : S → Finset ℕ} {J ell : ℕ}
    (Vs : S → ℝ) (q : ℝ) (r : PhysicalResidues Ps) (d : PhysicalSharedLists Ps J)
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) (Δ D : G → ℤ) (μ : ∀ g, P g → ℝ)
    (ρ : ℝ) (V : G → ℝ) (t : G → ℕ) (B : ℕ)
    (phase : UnrestrictedProductPhase n Δ D t B)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B →
      PhysicalMarkLists Ps J ell → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) :
    physicalSmallCondition Vs q r d (fun L =>
      unrestrictedCoupledCutoffProductOperator n Δ D μ ρ V t B phase (fun y => f y L) x) =
      unrestrictedCoupledCutoffProductOperator n Δ D μ ρ V t B phase
        (fun y => physicalSmallCondition Vs q r d (f y)) x := by
  simp only [unrestricted_coupled_cutoff_eq_joint_event_sum]
  exact physical_small_condition_weighted_sum Vs q r d
    (fun e => (unrestrictedJointCutoffEventWeight n Δ D μ ρ V t B x e : ℂ) * phase x e)
    (fun e => f (unrestrictedJointEventTarget n Δ D t B x e))

/-- The existing physical small-group bilinear factorization with a finite
big-event continuation kept explicit. The index type may depend on the
retained small prefix; its weights may also depend on the translated small
residue. This is applied separately for each fixed auxiliary draw. -/
theorem physical_small_bilinear_events_with_prefix
    {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (q ζ : ℝ) (k : ℤ) (r : PhysicalResidues P)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (κ : PhysicalSharedLists P J → ℂ)
    (E : PhysicalSharedLists P J → Type*) [∀ d, Fintype (E d)]
    (a : ∀ d, PhysicalResidues P → E d → ℂ)
    (f : PhysicalMarkLists P J ell → ℂ)
    (g : ∀ d, E d → PhysicalResidues P → PhysicalMarkLists P J ell → ℂ) :
    let tr := fun d : PhysicalSharedLists P J =>
      physicalTranslateResidues r (k * (physicalSharedProduct d : ℕ))
    (∑ L, ∑ R, (physicalStateMass V J ell : ℂ) * (starRingEnd ℂ) (f L) *
      physicalBarePatternScalar V (fun _ => (∅ : Finset (Fin J))) ζ
        (fun L _ _ => κ (physicalSharedPrefix L)) aux L R *
      ((physicalResidueVertexWeight L (Real.sqrt q) r *
        physicalResidueVertexWeight R (Real.sqrt q) (tr (physicalSharedPrefix L)) : ℝ) : ℂ) *
      (∑ e : E (physicalSharedPrefix L),
        a (physicalSharedPrefix L) (tr (physicalSharedPrefix L)) e *
          g (physicalSharedPrefix L) e (tr (physicalSharedPrefix L)) R)) =
    ∑ d, (starRingEnd ℂ) (physicalSmallCondition V q r d f) *
      (κ d * physicalPhase ζ (physicalSharedProduct d)) *
      (∑ e : E d, a d (tr d) e * physicalSmallCondition V q (tr d) d (g d e (tr d))) := by
  intro tr
  rw [physical_small_bilinear_factorization_with_prefix V hV q ζ k r aux κ f
    (fun d s R => ∑ e : E d, a d s e * g d e s R)]
  apply sum_congr rfl
  intro d _
  rw [physical_small_condition_weighted_sum]

/-- The full big-active-slot projection also commutes with the small
conditioning map. This retains the adjacent active averages in the mixed
operator factorization. -/
theorem physical_small_condition_full_active_average
    {S G : Type*} [Fintype S] [DecidableEq S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {J ell : ℕ}
    (Vs : S → ℝ) (q : ℝ) (r : PhysicalResidues Ps) (d : PhysicalSharedLists Ps J)
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ}
    (f : ProductBoundedOrderedState P Z M B → PhysicalMarkLists Ps J ell → ℂ)
    (x : ProductBoundedOrderedState P Z M B) :
    physicalSmallCondition Vs q r d (fun L => fullActiveAverage (fun y => f y L) x) =
      fullActiveAverage (fun y => physicalSmallCondition Vs q r d (f y)) x := by
  unfold fullActiveAverage
  exact physical_small_condition_weighted_sum Vs q r d
    (fun τ => (fullActivePermutationWeight M τ : ℂ))
    (fun τ => f (fullActivePermutation τ x))

end Bounty
end

section

/- Uniform small-source permutation rarity with an arbitrary fixed big
factor. Only the small source lists are injective; the big factor may come
from repeated active labels, and pending particle indices may repeat values. -/

open Finset
open scoped Classical

namespace Bounty

def smallSourcePrimeOmissions {S : Type*} {P : S → Finset ℕ} {J ell : ℕ}
    (labels : PhysicalMarkLists P J ell)
    (A : GroupedOmissionSubsets S (PhysicalSlots J ell) ell) :
    PrimeOmissionChoices (physicalGroupMarks labels) ell :=
  fun g => ⟨(A g).val.map (physicalGroupMarkEmbedding labels g),
    mem_powersetCard.mpr ⟨map_subset_map.mpr (mem_powersetCard.mp (A g).property).1,
      by simpa only [card_map] using (mem_powersetCard.mp (A g).property).2⟩⟩

theorem small_source_prime_omissions_injective {S : Type*}
    {P : S → Finset ℕ} {J ell : ℕ} (labels : PhysicalMarkLists P J ell) :
    Function.Injective (smallSourcePrimeOmissions labels) := by
  intro A B h
  funext g
  apply Subtype.ext
  apply map_injective (physicalGroupMarkEmbedding labels g)
  exact congrArg Subtype.val (congrFun h g)

noncomputable def smallSourcePermutationDilation {S : Type*} [Fintype S]
    {P : S → Finset ℕ} {J ell : ℕ} (labels : PhysicalMarkLists P J ell)
    (D_B : ℕ) (σ : S → Equiv.Perm (PhysicalSlots J ell)) : ℕ :=
  D_B * ∏ g, ∏ j : Fin J, (labels g (σ g (Sum.inl j))).val

theorem small_source_permutation_dilation_eq {S : Type*} [Fintype S]
    {P : S → Finset ℕ} {J ell : ℕ} (labels : PhysicalMarkLists P J ell)
    (D_B : ℕ) (σ : S → Equiv.Perm (PhysicalSlots J ell)) :
    smallSourcePermutationDilation labels D_B σ =
      primeOmissionDilation (physicalGroupMarks labels) ell D_B
        (smallSourcePrimeOmissions labels
          (groupedPermutedOmissions (physicalOmissionSlots J ell)
            (physical_omission_slots_card J ell) σ)) := by
  unfold smallSourcePermutationDilation primeOmissionDilation primeRetainedProduct
  congr 1
  apply prod_congr rfl
  intro g _
  have he : (smallSourcePrimeOmissions labels
      (groupedPermutedOmissions (physicalOmissionSlots J ell)
        (physical_omission_slots_card J ell) σ) g).val =
      physicalLastMarks (physicalPermuteLabels σ labels) g := by
    simp only [smallSourcePrimeOmissions, groupedPermutedOmissions, permutedOmissionSubset,
      physicalOmissionSlots, physicalLastMarks, map_map]
    congr 1
  rw [he, ← physical_group_marks_permute σ labels g, physical_group_marks_sdiff_last]
  simp only [physicalFirstMarks, prod_map, Function.Embedding.trans_apply,
    Function.Embedding.inl_apply, physicalGroupMarkEmbedding, physicalPermuteLabels]
  rfl

theorem small_source_permutation_eligible_fraction_le {S Particle : Type*}
    [Fintype S] {P : S → Finset ℕ} {J ell : ℕ}
    (labels : PhysicalMarkLists P J ell)
    (hP : ∀ g p, p ∈ P g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (D_B : ℕ) (pending : Finset Particle) (p : Particle → ℕ)
    (hp : ∀ z, (p z).Prime) (r : ∀ z, ZMod (p z)) (k : ℤ)
    (hk : ∀ z ∈ pending, ¬ (p z : ℤ) ∣ k)
    (hlt : ∀ z ∈ pending, ∀ A : PrimeOmissionChoices (physicalGroupMarks labels) ell,
      primeOmissionProduct (physicalGroupMarks labels) ell A < p z) :
    letI : DecidableEq S := Classical.decEq _
    letI : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
    ((univ.filter (fun σ : S → Equiv.Perm (PhysicalSlots J ell) =>
        ∃ z ∈ pending, ¬ p z ∣ smallSourcePermutationDilation labels D_B σ ∧
          r z + (k : ZMod (p z)) * (smallSourcePermutationDilation labels D_B σ : ZMod (p z)) = 0)).card : ℝ) /
        (Fintype.card (S → Equiv.Perm (PhysicalSlots J ell)) : ℝ) ≤
      (pending.card : ℝ) / (((J + ell).choose ell) ^ Fintype.card S : ℕ) := by
  let _ : DecidableEq S := Classical.decEq _
  let _ : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
  let U := fun A : GroupedOmissionSubsets S (PhysicalSlots J ell) ell =>
    primeOmissionProduct (physicalGroupMarks labels) ell (smallSourcePrimeOmissions labels A)
  let D := fun A : GroupedOmissionSubsets S (PhysicalSlots J ell) ell =>
    primeOmissionDilation (physicalGroupMarks labels) ell D_B (smallSourcePrimeOmissions labels A)
  let bad := rareOmissionChoices univ pending
    (fun z A => ¬ p z ∣ D A ∧ r z + (k : ZMod (p z)) * (D A : ZMod (p z)) = 0)
  have hU : Function.Injective U :=
    (prime_omission_product_injective (physicalGroupMarks labels) ell
      (fun g q hq => hP g q (physical_group_marks_subset labels g hq))
      (fun g h hne => (hdis hne).mono (physical_group_marks_subset labels g)
        (physical_group_marks_subset labels h))).comp (small_source_prime_omissions_injective labels)
  have hbad : bad.card ≤ pending.card :=
    modular_eligible_omission_card_le univ pending U hU p hp (fun _ => D)
      (fun _ => D_B * primeFullProduct (physicalGroupMarks labels))
      (fun _ A => prime_omission_mul_dilation_eq (physicalGroupMarks labels) ell D_B
        (smallSourcePrimeOmissions labels A)) r k hk
      (fun z hz A => hlt z hz (smallSourcePrimeOmissions labels A))
  have hevent (σ : S → Equiv.Perm (PhysicalSlots J ell)) :
      groupedPermutedOmissions (physicalOmissionSlots J ell) (physical_omission_slots_card J ell) σ ∈ bad ↔
      ∃ z ∈ pending, ¬ p z ∣ smallSourcePermutationDilation labels D_B σ ∧
        r z + (k : ZMod (p z)) * (smallSourcePermutationDilation labels D_B σ : ZMod (p z)) = 0 := by
    simp only [bad, rareOmissionChoices, mem_filter, mem_univ, true_and, D,
      ← small_source_permutation_dilation_eq]
  have h := grouped_uniform_bad_omission_fraction_le (physicalOmissionSlots J ell)
    (physical_omission_slots_card J ell) bad pending.card hbad
  have hslots : Fintype.card (PhysicalSlots J ell) = J + ell := by
    simp only [PhysicalSlots, Fintype.card_sum, Fintype.card_fin]
  rw [hslots] at h
  simpa only [hevent] using h

end Bounty
end

section

/- Exact bilinear transposition under the product factorial memory law.
Coordinate transposes reverse composition order, while independent local
event sums do not depend on the order of distinct coordinates. -/

open Finset Classical

namespace Bounty

theorem finite_coordinate_compose_append {I : Type*} [DecidableEq I]
    {X : I → Type*} (A : ∀ i, (X i → ℂ) → X i → ℂ) (is js : List I)
    (f : (∀ i, X i) → ℂ) :
    finiteCoordinateCompose A (is ++ js) f =
      finiteCoordinateCompose A is (finiteCoordinateCompose A js f) := by
  induction is with
  | nil => rfl
  | cons i is ih => simp only [List.cons_append, finiteCoordinateCompose, ih]

theorem finite_product_bilinear_split {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ) (i : I)
    (f g : (∀ i, X i) → ℂ) :
    (∑ x, (finiteProductWeight μ x : ℂ) * f x * g x) =
      ∑ z : (∀ j : {j : I // j ≠ i}, X j.val),
        ((∏ j, μ j.val (z j) : ℝ) : ℂ) *
          ∑ y : X i, (μ i y : ℂ) * f ((Equiv.piSplitAt i X).symm (y, z)) *
            g ((Equiv.piSplitAt i X).symm (y, z)) := by
  let E := Equiv.piSplitAt i X
  rw [← E.symm.sum_comp, Fintype.sum_prod_type, sum_comm]
  apply sum_congr rfl
  intro z hz
  rw [mul_sum]
  apply sum_congr rfl
  intro y hy
  rw [finite_product_weight_split μ i]
  have hE := E.apply_symm_apply (y, z)
  have hfirst : E.symm (y, z) i = y := congrArg Prod.fst hE
  have hrest : (fun j : {j : I // j ≠ i} => E.symm (y, z) j.val) = z :=
    congrArg Prod.snd hE
  have hprod : (∏ j : {j : I // j ≠ i}, μ j.val (E.symm (y, z) j.val)) =
      ∏ j, μ j.val (z j) := congrArg (fun q => ∏ j, μ j.val (q j)) hrest
  rw [hfirst, hprod, Complex.ofReal_mul]
  ring

theorem product_memory_pi_slice_symmetric {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ} (i : G)
    (f : ProductBoundedOrderedState P Z t B → ℂ) (hf : ProductMemorySymmetric f)
    (z : ∀ j : {j : G // j ≠ i}, BoundedOrderedState (P j.val) (Z j.val) (t j.val) B) :
    BoundedOrderedSymmetric (fun y => f ((Equiv.piSplitAt i
      (fun j => BoundedOrderedState (P j) (Z j) (t j) B)).symm (y, z))) := by
  intro active N q τ
  let E := Equiv.piSplitAt i (fun j => BoundedOrderedState (P j) (Z j) (t j) B)
  let x := E.symm ((active, ⟨N, q⟩), z)
  have hx : x i = (active, ⟨N, q⟩) := congrArg Prod.fst (E.apply_symm_apply _)
  have hp : BoundedMemoryPermutationRelation (x i) (active, ⟨N, q ∘ τ⟩) := by
    rw [hx]
    exact ⟨τ, rfl⟩
  have h := (product_memory_symmetric_iff_coordinate f).mp hf i x _ hp
  have he : Function.update x i (active, ⟨N, q ∘ τ⟩) =
      E.symm ((active, ⟨N, q ∘ τ⟩), z) := by
    rw [← finite_split_replace_eq_update]
    simp only [x, E, Equiv.apply_symm_apply]
  rw [he] at h
  exact h

theorem product_memory_coordinate_pairing {G : Type*} [Fintype G] [dG : DecidableEq G]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    {t : G → ℕ} {B : ℕ} (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ) (i : G)
    (A R : (BoundedOrderedState (P i) (Z i) (t i) B → ℂ) →
      BoundedOrderedState (P i) (Z i) (t i) B → ℂ)
    (hpair : ∀ f g, BoundedOrderedSymmetric f → BoundedOrderedSymmetric g →
      (∑ x, (boundedOrderedStateWeight (μ i) (ν i) x : ℂ) * f x * A g x) =
        ∑ x, (boundedOrderedStateWeight (μ i) (ν i) x : ℂ) * R f x * g x)
    (f g : ProductBoundedOrderedState P Z t B → ℂ)
    (hf : ProductMemorySymmetric f) (hg : ProductMemorySymmetric g) :
    (∑ x, (productMemoryWeight μ ν x : ℂ) * f x * finiteCoordinateLift i A g x) =
      ∑ x, (productMemoryWeight μ ν x : ℂ) * finiteCoordinateLift i R f x * g x := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  change (∑ x, (finiteProductWeight (fun j => boundedOrderedStateWeight (μ j) (ν j)) x : ℂ) *
    f x * finiteCoordinateLift i A g x) =
      ∑ x, (finiteProductWeight (fun j => boundedOrderedStateWeight (μ j) (ν j)) x : ℂ) *
        finiteCoordinateLift i R f x * g x
  rw [finite_product_bilinear_split (fun j => boundedOrderedStateWeight (μ j) (ν j)) i,
    finite_product_bilinear_split (fun j => boundedOrderedStateWeight (μ j) (ν j)) i]
  apply sum_congr rfl
  intro z hz
  congr 1
  simp only [finite_coordinate_lift_split]
  have hp := hpair _ _ (product_memory_pi_slice_symmetric i f hf z)
    (product_memory_pi_slice_symmetric i g hg z)
  refine Eq.trans ?_ (Eq.trans hp ?_)
  all_goals
    apply sum_congr
    · exact congrArg (fun inst : Fintype _ => @Finset.univ _ inst) (Subsingleton.elim _ _)
    · intro x hx; rfl

theorem product_memory_compose_pairing_reverse {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    {t : G → ℕ} {B : ℕ} (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (A R : ∀ i, (BoundedOrderedState (P i) (Z i) (t i) B → ℂ) →
      BoundedOrderedState (P i) (Z i) (t i) B → ℂ)
    (hA : ∀ i f, BoundedOrderedSymmetric f → BoundedOrderedSymmetric (A i f))
    (hR : ∀ i f, BoundedOrderedSymmetric f → BoundedOrderedSymmetric (R i f))
    (hpair : ∀ i f g, BoundedOrderedSymmetric f → BoundedOrderedSymmetric g →
      (∑ x, (boundedOrderedStateWeight (μ i) (ν i) x : ℂ) * f x * A i g x) =
        ∑ x, (boundedOrderedStateWeight (μ i) (ν i) x : ℂ) * R i f x * g x)
    (is : List G) (f g : ProductBoundedOrderedState P Z t B → ℂ)
    (hf : ProductMemorySymmetric f) (hg : ProductMemorySymmetric g) :
    (∑ x, (productMemoryWeight μ ν x : ℂ) * f x * finiteCoordinateCompose A is g x) =
      ∑ x, (productMemoryWeight μ ν x : ℂ) * finiteCoordinateCompose R is.reverse f x * g x := by
  induction is generalizing f with
  | nil => rfl
  | cons i is ih =>
    change (∑ x, (productMemoryWeight μ ν x : ℂ) * f x *
      finiteCoordinateLift i (A i) (finiteCoordinateCompose A is g) x) = _
    rw [product_memory_coordinate_pairing μ ν i (A i) (R i) (hpair i) f
      (finiteCoordinateCompose A is g) hf (product_memory_compose_symmetric A hA is g hg)]
    have hf' : ProductMemorySymmetric (finiteCoordinateLift i (R i) f) :=
      product_memory_compose_symmetric R hR [i] f hf
    rw [ih _ hf']
    simp only [List.reverse_cons, finite_coordinate_compose_append, finiteCoordinateCompose]

/-- Reversing a list of distinct independent local event actions does not
alter its operator, including for signed event weights. -/
theorem finite_local_event_compose_reverse {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)]
    (E : ∀ i, X i → Type*) [∀ i x, Fintype (E i x)]
    (weight : ∀ i x, E i x → ℝ) (target : ∀ i x, E i x → X i)
    (is : List I) (his : is.Nodup) (f : (∀ i, X i) → ℂ) :
    finiteCoordinateCompose (finiteLocalEventAction E weight target) is.reverse f =
      finiteCoordinateCompose (finiteLocalEventAction E weight target) is f := by
  have hf : f = fun z => ∑ y : (∀ i, X i),
      f y * ∏ i, (if z i = y i then (1 : ℂ) else 0) :=
    funext (finite_product_delta_expansion f)
  rw [hf]
  funext x
  simp only [finite_local_event_compose_sum, finite_local_event_compose_const_mul]
  apply sum_congr rfl
  intro y hy
  rw [finite_local_event_compose_prod E weight target is.reverse (List.nodup_reverse.mpr his)
      (fun i a => if a = y i then (1 : ℂ) else 0) x,
    finite_local_event_compose_prod E weight target is his
      (fun i a => if a = y i then (1 : ℂ) else 0) x]
  simp only [List.mem_reverse]

end Bounty
