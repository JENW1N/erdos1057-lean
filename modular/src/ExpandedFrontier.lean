section

/- A nonnegative real majorant for a finite complex weighted sum. -/

open Finset
open scoped Classical
namespace Bounty

theorem finite_weighted_norm_le_real_majorant {S : Type*} [Fintype S]
    (μ : S → ℝ) (hμ : ∀ s, 0 ≤ μ s) (F : S → ℂ) (B : S → ℝ)
    (hB : ∀ s, ‖F s‖ ≤ B s) :
    ‖∑ s, (μ s : ℂ) * F s‖ ≤ (∑ s, (μ s : ℂ) * (B s : ℂ)).re := by
  calc
    _ ≤ ∑ s, ‖(μ s : ℂ) * F s‖ := norm_sum_le _ _
    _ ≤ ∑ s, μ s * B s := by
      apply sum_le_sum
      intro s _
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hμ s)]
      exact mul_le_mul_of_nonneg_left (hB s) (hμ s)
    _ = _ := by
      simp only [Complex.re_sum, Complex.mul_re, Complex.ofReal_re,
        Complex.ofReal_im, zero_mul, sub_zero]

theorem finite_weighted_norm_le_majorant_norm {S : Type*} [Fintype S]
    (μ : S → ℝ) (hμ : ∀ s, 0 ≤ μ s) (F : S → ℂ) (B : S → ℝ)
    (hB : ∀ s, ‖F s‖ ≤ B s) :
    ‖∑ s, (μ s : ℂ) * F s‖ ≤ ‖∑ s, (μ s : ℂ) * (B s : ℂ)‖ :=
  (finite_weighted_norm_le_real_majorant μ hμ F B hB).trans (Complex.re_le_norm _)

end Bounty
end

section

/- The exact normalized full-vertex compatible pair functional. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def physicalFullPairCorrelation {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {J ell : ℕ} (C : G → Finset (Fin J))
    (V : G → ℝ) (q : ℝ) (w z : ℕ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → ℂ) : ℂ :=
  ∑ L : PhysicalMarkLists P J ell, ∑ R : PhysicalMarkLists P J ell,
    if physicalSharedCompatible C L R then
      ((physicalStateMass V J ell * physicalCompletionMass V C ell /
        (physicalSharedFactor C L : ℝ) : ℝ) : ℂ) *
      (((physicalVertexWeight L q ((physicalSharedFactor C L : ℤ) * (w : ℤ)) *
        physicalVertexWeight R q ((physicalSharedFactor C L : ℤ) * (z : ℤ)) : ℝ) : ℂ) * K L R)
    else 0

theorem physical_full_pair_congr {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {J ell : ℕ} (C : G → Finset (Fin J))
    (V : G → ℝ) (q : ℝ) (w z : ℕ)
    (F K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → ℂ)
    (h : ∀ L R, physicalSharedCompatible C L R → F L R = K L R) :
    physicalFullPairCorrelation P C V q w z F = physicalFullPairCorrelation P C V q w z K := by
  unfold physicalFullPairCorrelation
  apply sum_congr rfl
  intro L _
  apply sum_congr rfl
  intro R _
  by_cases hc : physicalSharedCompatible C L R
  · rw [if_pos hc, if_pos hc, h L R hc]
  · rw [if_neg hc, if_neg hc]

theorem physical_full_pair_add {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {J ell : ℕ} (C : G → Finset (Fin J))
    (V : G → ℝ) (q : ℝ) (w z : ℕ)
    (F K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → ℂ) :
    physicalFullPairCorrelation P C V q w z (fun L R => F L R + K L R) =
      physicalFullPairCorrelation P C V q w z F + physicalFullPairCorrelation P C V q w z K := by
  unfold physicalFullPairCorrelation
  rw [← sum_add_distrib]
  apply sum_congr rfl
  intro L _
  rw [← sum_add_distrib]
  apply sum_congr rfl
  intro R _
  by_cases hc : physicalSharedCompatible C L R
  · simp only [if_pos hc, mul_add]
  · simp only [if_neg hc, zero_add]

end Bounty
end

section

/- The actual unshared coefficient separates the auxiliary draws from selected
endpoint marks, using only retained cells and the original characters. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_prime_cell_expansion
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (Q : ℕ) (h : ℝ) (keptA keptB : Finset ℤ)
    (S : Finset G) (hA : ∀ i ∈ A, i.1 ∈ S) (hB : ∀ i ∈ B, i.1 ∈ S)
    (u v : GroupMarkedLists P (fun g => ell + (repeatedBigAuxCut A B g).card))
    (aux : PhysicalAuxLabels P (repeatedBigAuxCut A B)) :
    let PA := fun i : A => P i.val.1
    let PB := fun i : B => P i.val.1
    let VA := fun i : A => V i.val.1
    let VB := fun i : B => V i.val.1
    let a := fun d => ((1 / finiteCellMass (finiteProductWeight (physicalLabelLaw (P := PA) VA))
      (fun z => upperLogCell h (Real.log (∏ i, (z i).val : ℕ))) d : ℝ) : ℂ)
    let b := fun e => ((1 / finiteCellMass (finiteProductWeight (physicalLabelLaw (P := PB) VB))
      (fun z => upperLogCell h (Real.log (∏ i, (z i).val : ℕ))) e : ℝ) : ℂ)
    let split := repeatedBigAuxSplitEquiv P A B hU hAB aux
    physicalUnsharedPrimeCoefficient P V A B hU hAB Q h keptA keptB u v aux =
      ∑ d ∈ keptA, ∑ χ : BoundedPrimitiveCharacter Q,
        ∑ e ∈ keptB, ∑ ψ : BoundedPrimitiveCharacter Q,
          (a d*b e) *
            ((starRingEnd ℂ) (primeProductCellCharacter PA h d χ split.1) *
              (starRingEnd ℂ) (primeProductCellCharacter PB h e ψ split.2)) *
            (primeProductCellCharacter PB h e ψ
                (physicalSelectedPrimeRestriction A B B subset_union_right S hB (fun g : S => u g.val)) *
              primeProductCellCharacter PA h d χ
                (physicalSelectedPrimeRestriction A B A subset_union_left S hA (fun g : S => v g.val))) := by
  dsimp only
  exact prime_ideal_kernel_pair_cell_expansion
    (fun i : A => P i.val.1) (fun i => V i.val.1)
    (fun i : B => P i.val.1) (fun i => V i.val.1) Q h keptA keptB
    (repeatedBigAuxSplitEquiv P A B hU hAB aux).1
    (physicalPrimeUnsharedRestriction A B A subset_union_left v)
    (repeatedBigAuxSplitEquiv P A B hU hAB aux).2
    (physicalPrimeUnsharedRestriction A B B subset_union_right u)

end Bounty
end

section

/- Finite separated kernel expansions pass through the original weighted
marked averages, including empty complementary fibers. -/

open Finset
open scoped Classical
namespace Bounty

theorem group_marked_average_sum {G I : Type*} [Fintype G]
    (P : G → Finset ℕ) (t : G → ℕ) (n : ℤ) (s : Finset I)
    (b : I → GroupMarkedLists P t → ℂ) :
    groupMarkedAverage P t n (fun u => ∑ i ∈ s, b i u) =
      ∑ i ∈ s, groupMarkedAverage P t n (b i) := by
  unfold groupMarkedAverage
  rw [sum_comm, mul_sum]

theorem weighted_marked_pair_finite_expansion {G I : Type*} [Fintype G]
    (P : G → Finset ℕ) (q : ℝ) (V : G → ℝ) (t : G → ℕ) (w z : ℤ)
    (big : Finset G) (s : Finset I) (c : I → ℂ)
    (a b : I → GroupMarkedLists (fun g : big => P g.val) (fun g : big => t g.val) → ℂ) :
    let W := fun n => markedDivisorWeight univ P q V t n
    ((W w*W z : ℝ) : ℂ) * groupMarkedAverage P t w (fun u =>
      groupMarkedAverage P t z (fun v =>
        ∑ i ∈ s, c i * (a i (fun g : big => u g.val) * b i (fun g : big => v g.val)))) =
      ∑ i ∈ s, c i *
        (((W w : ℂ) * groupMarkedAverage (fun g : big => P g.val) (fun g : big => t g.val) w (a i)) *
          ((W z : ℂ) * groupMarkedAverage (fun g : big => P g.val) (fun g : big => t g.val) z (b i))) := by
  dsimp only
  simp_rw [group_marked_average_sum]
  rw [mul_sum]
  apply sum_congr rfl
  intro i _
  simp_rw [group_marked_average_mul_left]
  rw [group_marked_average_mul_right]
  have he := weighted_group_marked_pair_restrict P q V t w z big (a i) (b i)
  dsimp only at he
  rw [group_marked_pair_average_separate] at he
  calc
    _ = c i * (((markedDivisorWeight univ P q V t w *
        markedDivisorWeight univ P q V t z : ℝ) : ℂ) *
      (groupMarkedAverage P t w (fun u => a i (fun g : big => u g.val)) *
        groupMarkedAverage P t z (fun v => b i (fun g : big => v g.val)))) := by ring
    _ = _ := by rw [he]

end Bounty
end

section

/- The exact rational box has the cubic denominator cost of its complete character family. -/

open Finset MeasureTheory

namespace Bounty

theorem rational_box_kernel_energy_le {r : ℕ} (hr : 0 < r) (k : ℤ)
    (D A B C : Finset ℕ) (δ α β γ : ℕ → ℂ) (H : ℝ → ℕ → ℂ)
    (hD : ∀ d ∈ D, d.Coprime r) (hA : ∀ a ∈ A, a.Coprime r)
    (hB : ∀ b ∈ B, b.Coprime r) (hH : ∀ n, Continuous (fun t => H t n))
    (a b E : ℝ) (hE : 0 ≤ E)
    (henergy : ∀ d ∈ r.divisors, ∀ ψ : AddChar (Additive (ZMod (r/d))ˣ) ℂ,
      (∫ t in Set.Icc a b, ‖fourBoxKernelSum D A B C
        (fun n => δ n*unitAddCharDirichlet ψ (n : ZMod (r/d)))
        (fun n => α n*unitAddCharDirichlet ψ (n : ZMod (r/d)))
        (fun n => β n*unitAddCharDirichlet ψ (n : ZMod (r/d)))
        (fun n => γ n*rationalResidualGcdMultiplier r d ψ n) (H t)‖^2) ≤ E) :
    (∫ t in Set.Icc a b, ‖rationalFourBoxKernelSum r k D A B C δ α β γ (H t)‖^2) ≤
      (r : ℝ)^3*E := by
  obtain ⟨c,hc,hcard,he⟩ := rational_four_factor_full_gcd_kernel_expansion
    hr (le_refl r) k D A B C hD hA hB
  have hpoint (t : ℝ) : rationalFourBoxKernelSum r k D A B C δ α β γ (H t) =
      ∑ d ∈ r.divisors, ∑ ψ, c d ψ * fourBoxKernelSum D A B C
        (fun n => δ n*unitAddCharDirichlet ψ (n : ZMod (r/d)))
        (fun n => α n*unitAddCharDirichlet ψ (n : ZMod (r/d)))
        (fun n => β n*unitAddCharDirichlet ψ (n : ZMod (r/d)))
        (fun n => γ n*rationalResidualGcdMultiplier r d ψ n) (H t) := by
    simpa only [rationalFourBoxKernelSum,fourBoxKernelSum,Nat.cast_mul,mul_assoc] using he δ α β γ (H t)
  have h := rational_gcd_character_family_energy_le r r c
    (fun d ψ t => fourBoxKernelSum D A B C
      (fun n => δ n*unitAddCharDirichlet ψ (n : ZMod (r/d)))
      (fun n => α n*unitAddCharDirichlet ψ (n : ZMod (r/d)))
      (fun n => β n*unitAddCharDirichlet ψ (n : ZMod (r/d)))
      (fun n => γ n*rationalResidualGcdMultiplier r d ψ n) (H t)) a b E hE
    (fun _ _ _ => (continuous_four_box_kernel_sum D A B C _ _ _ _ H hH).continuousOn)
    henergy (hc.trans hcard)
  simpa only [← hpoint] using h

theorem rational_harmonic_box_energy_le {r : ℕ} (hr : 0 < r) (k : ℤ)
    (D A B C : Finset ℕ) (δ α β γ : ℕ → ℂ)
    (hD : ∀ d ∈ D, d.Coprime r) (hA : ∀ a ∈ A, a.Coprime r)
    (hB : ∀ b ∈ B, b.Coprime r)
    (hDpos : ∀ d ∈ D, 0 < d) (hApos : ∀ a ∈ A, 0 < a)
    (hBpos : ∀ b ∈ B, 0 < b) (hCpos : ∀ c ∈ C, 0 < c)
    (a b E w : ℝ) (hE : 0 ≤ E)
    (henergy : ∀ d ∈ r.divisors, ∀ ψ : AddChar (Additive (ZMod (r/d))ˣ) ℂ,
      (∫ t in Set.Icc a b,
        ‖(∑ n ∈ D, (δ n*unitAddCharDirichlet ψ (n : ZMod (r/d)))*harmonicMellinWeight (t+w) n)*
          (∑ n ∈ A, (α n*unitAddCharDirichlet ψ (n : ZMod (r/d)))*harmonicMellinWeight (t+w) n)*
          (∑ n ∈ B, (β n*unitAddCharDirichlet ψ (n : ZMod (r/d)))*harmonicMellinWeight (t+w) n)*
          (∑ n ∈ C, (γ n*rationalResidualGcdMultiplier r d ψ n)*harmonicMellinWeight (t+w) n)‖^2) ≤ E) :
    (∫ t in Set.Icc a b, ‖rationalFourBoxKernelSum r k D A B C δ α β γ
      (fun n => harmonicMellinWeight (t+w) n)‖^2) ≤ (r : ℝ)^3*E := by
  apply rational_box_kernel_energy_le hr k D A B C δ α β γ
    (fun t n => harmonicMellinWeight (t+w) n) hD hA hB
    (fun _ => by unfold harmonicMellinWeight; fun_prop) a b E hE
  intro d hd ψ
  simpa only [four_box_kernel_harmonic_eq D A B C hDpos hApos hBpos hCpos] using henergy d hd ψ

end Bounty
end

section

/- The selected fixed physical path is exactly the original joint raw history, with all scalar factors retained. -/

open Finset
open scoped Classical
namespace Bounty

section ResiduePath
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (ζ : ∀ p : PhysicalPrime P, ZMod p.2.val)
  (hmarks : ∀ j : Fin (n + 1), ∀ p ∈ physicalMarkedPrimes (L j),
    ζ p = -(a j : ZMod p.2.val))
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ) (η : Fin N → Fin (n + 1) → ℝ)
  (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0) (B : ℕ)

variable
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)

theorem physical_selected_coarse_raw_history
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    physicalMarkRawExtension
      (finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
        (physicalSelectedCoarseRow (B := B) C aux k L σ τ β V ρ hV ω retention) (2 * n + 1) F)
      (L 0) =
      fun s => (∏ i ∈ range (2 * n + 1), physicalSelectedCoarseScalar C aux L σ ω i) *
        globalBirthJointRawHistory (fun i g => physicalGroupBareAtomicActivity L g i)
          (physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β
            (fun _ j => 1 - retention j) V (fun _ => ρ) hV B)
          (fun _ => B) (2 * n + 1) (physicalMarkRawExtension F (L (Fin.last n))) s := by
  rw [physical_selected_coarse_composition C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk
    β V ρ hV B ω retention F]
  exact global_birth_joint_raw_history_weighted
    (fun i g => physicalGroupBareAtomicActivity L g i)
    (physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β
      (fun _ j => 1 - retention j) V (fun _ => ρ) hV B)
    (fun _ => B) (physicalSelectedCoarseScalar C aux L σ ω) (2 * n + 1) _

theorem physical_selected_fixed_path_eq_original :
    finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
      (physicalSelectedCoarseRow (B := B) C aux k L σ τ β V ρ hV ω retention)
      (2 * n + 1) physicalEmptyMemoryTerminal (physicalInitialMarkState B (L 0)) =
      (∏ i ∈ range (2 * n + 1), physicalSelectedCoarseScalar C aux L σ ω i) *
        physicalJointResidueRawHistory C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β
          (fun _ j => 1 - retention j) V (fun _ => ρ) hV B := by
  have h := congrFun (physical_selected_coarse_raw_history C aux k L a σ τ hstep ζ hmarks
    hlist hP hdis hk β V ρ hV B ω retention (physicalEmptyMemoryTerminal (B := B)))
    (physicalMarkRawReadout (physicalInitialMarkState B (L 0)))
  have hext := physical_mark_extension_roundtrip
    (finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
      (physicalSelectedCoarseRow (B := B) C aux k L σ τ β V ρ hV ω retention)
      (2 * n + 1) physicalEmptyMemoryTerminal) (physicalInitialMarkState B (L 0))
  change physicalMarkRawExtension _ (L 0) _ = _ at hext
  rw [hext, physical_empty_memory_terminal_extension, physical_initial_mark_state_readout] at h
  exact h

end ResiduePath
end Bounty
end

section

/- The actual selected four-row physical schedule groups exactly into the
previously defined visit/edge-block schedule, with arbitrary terminal tests. -/

open scoped Classical

namespace Bounty

section Grouping
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (k : Fin n → ℤ) (β : (g : Fin N) → ↥(P g) → ℝ)
  (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)

theorem physical_selected_fine_three_rows (j : Fin n)
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    physicalSelectedFineRow C aux L σ τ k β V ρ hV ω retention (4 * j.val + 1)
      (physicalSelectedFineRow C aux L σ τ k β V ρ hV ω retention (4 * j.val + 2)
        (physicalSelectedFineRow C aux L σ τ k β V ρ hV ω retention (4 * j.val + 3) F)) =
      physicalSelectedStateEdgeBlock C k ω β retention ρ V hV j (aux j) (σ j) (τ j)
        (L j.succ) F := by
  rw [physical_selected_fine_row_source_permutation, physical_selected_fine_row_edge,
    physical_selected_fine_row_target_permutation]
  unfold physicalSelectedStateEdgeBlock
  apply congrArg (physicalObservedMarkRow C k ω β retention ρ V hV none)
  funext o t
  split_ifs with ho
  · apply congrArg (fun K => physicalObservedMarkRow C k ω β retention ρ V hV (some (.inr j)) K t)
    funext p u
    split_ifs with hp
    · apply congrArg (fun K => physicalObservedMarkRow C k ω β retention ρ V hV none K u)
      funext q v
      split_ifs <;> rfl
    · rfl
  · rfl

theorem physical_selected_fine_grouped_visit (j : Fin (n + 1))
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    finiteRowGrouped (S := fun _ => PhysicalBoundedMarkState P J ell B)
      (physicalSelectedFineRow C aux L σ τ k β V ρ hV ω retention)
      visitThreeBlockLength (2 * j.val) F =
      physicalSelectedCoarseRow C aux k L σ τ β V ρ hV ω retention (2 * j.val) F := by
  unfold finiteRowGrouped
  rw [visit_three_block_cut_even, visit_three_block_length_even, finite_row_segment_one,
    physical_selected_fine_row_visit, physical_selected_coarse_row_even]

theorem physical_selected_fine_grouped_edge (j : Fin n)
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    finiteRowGrouped (S := fun _ => PhysicalBoundedMarkState P J ell B)
      (physicalSelectedFineRow C aux L σ τ k β V ρ hV ω retention)
      visitThreeBlockLength (2 * j.val + 1) F =
      physicalSelectedCoarseRow C aux k L σ τ β V ρ hV ω retention (2 * j.val + 1) F := by
  unfold finiteRowGrouped
  rw [visit_three_block_cut_odd, visit_three_block_length_odd, finite_row_segment_three]
  simp only [Nat.add_assoc, Nat.reduceAdd]
  rw [physical_selected_fine_three_rows, physical_selected_coarse_row_odd]

theorem physical_selected_fine_grouped_eq_coarse (i : ℕ) (hi : i < 2 * n + 1)
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    finiteRowGrouped (S := fun _ => PhysicalBoundedMarkState P J ell B)
      (physicalSelectedFineRow C aux L σ τ k β V ρ hV ω retention)
      visitThreeBlockLength i F =
      physicalSelectedCoarseRow C aux k L σ τ β V ρ hV ω retention i F := by
  by_cases h0 : i % 2 = 0
  · let j : Fin (n + 1) := ⟨i / 2, by omega⟩
    have hj : 2 * j.val = i := by dsimp [j]; omega
    have he := physical_selected_fine_grouped_visit C aux L σ τ k β V ρ hV ω retention j F
    simpa only [hj] using he
  · let j : Fin n := ⟨i / 2, by omega⟩
    have hj : 2 * j.val + 1 = i := by dsimp [j]; omega
    have he := physical_selected_fine_grouped_edge C aux L σ τ k β V ρ hV ω retention j F
    simpa only [hj] using he

theorem physical_selected_fine_composition_eq_coarse
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
      (physicalSelectedFineRow C aux L σ τ k β V ρ hV ω retention) (4 * n + 1) F =
      finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
        (physicalSelectedCoarseRow C aux k L σ τ β V ρ hV ω retention) (2 * n + 1) F := by
  rw [← finite_row_visit_three_grouping_constant]
  apply finite_row_composition_congr_before
  intro i hi K
  exact physical_selected_fine_grouped_eq_coarse C aux L σ τ k β V ρ hV ω retention i hi K

end Grouping
end Bounty
end

section

/- Fixed physical fine-row selections become one bounded predicate on the
chronological record of encoded states and original observations. -/

open scoped Classical

namespace Bounty

section Predicate
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (cut : ℕ → Fin N → Finset (Fin J))

noncomputable def physicalSelectedFineEncodedTest (i : ℕ)
    (o : PhysicalMarkObservation P ell C)
    (y : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B) : Prop :=
  ∃ t : PhysicalBoundedMarkState P J ell B,
    physicalBoundedMarkEncode (cut (i + 1)) t = y ∧
      physicalSelectedFineTest C aux L σ τ i o t

noncomputable def physicalSelectedFineTraceTest (i : ℕ)
    (r : PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C) : Prop :=
  physicalSelectedFineEncodedTest C aux L σ τ cut i r.2.1 r.2.2

noncomputable def physicalSelectedFineRecordMask (steps : ℕ)
    (r : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C)) : ℂ :=
  if List.Forall₂ (physicalSelectedFineTraceTest C aux L σ τ cut) (List.range steps) r
    then 1 else 0

theorem physical_selected_fine_encoded_test_iff (i : ℕ)
    (o : PhysicalMarkObservation P ell C) (t : PhysicalBoundedMarkState P J ell B) :
    physicalSelectedFineEncodedTest C aux L σ τ cut i o
      (physicalBoundedMarkEncode (cut (i + 1)) t) ↔ physicalSelectedFineTest C aux L σ τ i o t := by
  constructor
  · rintro ⟨u, hu, htest⟩
    have he : u = t := physical_bounded_mark_encode_injective (cut (i + 1)) hu
    simpa only [he] using htest
  · intro htest
    exact ⟨t, rfl, htest⟩

theorem physical_selected_fine_trace_test_iff (i : ℕ)
    (o : PhysicalMarkObservation P ell C) (s t : PhysicalBoundedMarkState P J ell B) :
    physicalSelectedFineTraceTest C aux L σ τ cut i
      (physicalBoundedMarkEncode (cut i) s, o, physicalBoundedMarkEncode (cut (i + 1)) t) ↔
      physicalSelectedFineTest C aux L σ τ i o t :=
  physical_selected_fine_encoded_test_iff C aux L σ τ cut i o t

theorem physical_selected_fine_encoded_test_decode (i : ℕ)
    (o : PhysicalMarkObservation P ell C)
    (y : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (hy : FullActiveInjective y.2) :
    physicalSelectedFineEncodedTest C aux L σ τ cut i o y ↔
      physicalSelectedFineTest C aux L σ τ i o (physicalBoundedMarkDecode (cut (i + 1)) y hy) := by
  have he := physical_selected_fine_encoded_test_iff C aux L σ τ cut i o
    (physicalBoundedMarkDecode (cut (i + 1)) y hy)
  simpa only [physical_bounded_mark_encode_decode] using he

theorem physical_selected_fine_encoded_test_injective (i : ℕ)
    (o : PhysicalMarkObservation P ell C)
    (y : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (h : physicalSelectedFineEncodedTest C aux L σ τ cut i o y) :
    FullActiveInjective y.2 := by
  obtain ⟨t, rfl, _⟩ := h
  exact physical_bounded_mark_encode_full_injective (cut (i + 1)) t

theorem physical_selected_fine_record_mask_norm (steps : ℕ)
    (r : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C)) :
    ‖physicalSelectedFineRecordMask C aux L σ τ cut steps r‖ ≤ 1 := by
  unfold physicalSelectedFineRecordMask
  split_ifs <;> simp

end Predicate
end Bounty
end

section

/- A concrete full-state coordinate schedule for the selected fine rows.
Visits use empty shared coordinates; both sides of each edge use its C_j. -/

namespace Bounty

noncomputable def physicalSelectedFineCut {N J n : ℕ}
    (C : Fin n → Fin N → Finset (Fin J)) (i : ℕ) : Fin N → Finset (Fin J) :=
  if hj : i / 4 < n then
    if 2 ≤ i % 4 then C ⟨i / 4, hj⟩ else fun _ => ∅
  else fun _ => ∅

theorem physical_selected_fine_cut_encoding {N J n : ℕ}
    (C : Fin n → Fin N → Finset (Fin J)) (i : ℕ) :
    PhysicalMarkRowEncoding C (physicalSelectedFineTag n i)
      (physicalSelectedFineCut C i) (physicalSelectedFineCut C (i + 1)) := by
  by_cases hi : i < 4 * n + 1
  · by_cases h0 : i % 4 = 0
    · have hcur : ¬ 2 ≤ i % 4 := by omega
      have hnext : ¬ 2 ≤ (i + 1) % 4 := by omega
      simp only [physicalSelectedFineTag, dif_pos hi, dif_pos h0, PhysicalMarkRowEncoding]
      unfold physicalSelectedFineCut
      split_ifs <;> simp_all
    · by_cases h2 : i % 4 = 2
      · have hj : i / 4 < n := by omega
        have hj' : (i + 1) / 4 < n := by omega
        have hd : (i + 1) / 4 = i / 4 := by omega
        have hm : 2 ≤ (i + 1) % 4 := by omega
        simp only [physicalSelectedFineTag, dif_pos hi,
          PhysicalMarkRowEncoding, physicalSelectedFineCut, dif_pos hj, dif_pos hj',
          h2, le_refl, if_true, if_pos hm]
        constructor
        · rfl
        · exact congrArg C (Fin.ext hd)
      · simp only [physicalSelectedFineTag, dif_pos hi, dif_neg h0, dif_neg h2,
          PhysicalMarkRowEncoding]
  · simp only [physicalSelectedFineTag, dif_neg hi, PhysicalMarkRowEncoding]

end Bounty
end

section

/- The exact energy factor of the actual selected physical schedule. -/

namespace Bounty

theorem physical_selected_fine_energy_factor
    (ρ v vmin vmax : ℝ) (T N n i : ℕ) (hi : i < 4 * n + 1) :
    fullPermutationMixedStepEnergy ρ v vmin vmax T N (physicalSelectedFineTag n i) =
      if i % 4 = 0 then physicalGhostUniformEnergyBound ρ vmax v ^ N
      else if i % 4 = 2 then unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ N
      else 1 := by
  unfold physicalSelectedFineTag
  rw [dif_pos hi]
  split_ifs <;> rfl

theorem physical_selected_fine_energy_product
    (ρ v vmin vmax : ℝ) (T N n : ℕ) :
    (((List.range (4 * n + 1)).map (physicalSelectedFineTag n)).map
      (fullPermutationMixedStepEnergy ρ v vmin vmax T N)).prod =
      physicalGhostUniformEnergyBound ρ vmax v ^ (N * (n + 1)) *
      unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ (N * n) := by
  rw [List.map_map]
  have hmap : (List.range (4 * n + 1)).map
      (fullPermutationMixedStepEnergy ρ v vmin vmax T N ∘ physicalSelectedFineTag n) =
      (List.range (4 * n + 1)).map
        (fun i => if i % 4 = 0 then physicalGhostUniformEnergyBound ρ vmax v ^ N
          else if i % 4 = 2 then unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ N
          else 1) := by
    apply List.map_congr_left
    intro i hi
    exact physical_selected_fine_energy_factor ρ v vmin vmax T N n i
      (List.mem_range.mp hi)
  rw [hmap, four_phase_list_product]
  simp only [one_pow, mul_one, pow_mul]

end Bounty
end

section

/- The first selected visit forces the prescribed initial mark list,
independently of every later row, continuation and pending-memory state. -/

open scoped Classical

namespace Bounty

theorem finite_row_composition_zero_of_first {S : ℕ → Type*} {V : Type*} [Zero V]
    (row : ∀ i, (S (i + 1) → V) → S i → V) (s : S 0)
    (hzero : ∀ F, row 0 F s = 0) (n : ℕ) (F : S (n + 1) → V) :
    finiteRowComposition row (n + 1) F s = 0 := by
  induction n with
  | zero => exact hzero F
  | succ n ih => exact ih (row (n + 1) F)

section Visit
variable {I K : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (retention : I → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
  (hV : ∀ g, V g ≠ 0)

theorem physical_observed_selected_visit_zero_of_marks (j : I)
    (R : PhysicalMarkLists P J ell) (F : PhysicalBoundedMarkState P J ell B → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) (hs : s.1 ≠ R) :
    physicalObservedMarkRow C k ω β retention ρ V hV (some (.inl j))
      (fun o t => if o = .inr none ∧ t.1 = R then F t else 0) s = 0 := by
  unfold physicalObservedMarkRow
  dsimp only
  conv_lhs =>
    arg 4
    equals (fun _ => 0) =>
      funext u
      unfold physicalMarkRawExtension
      split_ifs <;> simp_all
  conv_lhs =>
    arg 4
    equals (fun _ => (0 : ℂ) * 0) =>
      funext u
      simp only [zero_mul]
  rw [global_birth_joint_cut_raw_row_mul, zero_mul]

end Visit

section Support
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (k : Fin n → ℤ) (β : (g : Fin N) → ↥(P g) → ℝ)
  (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)

theorem physical_selected_fine_zero_of_initial_marks
    (F : PhysicalBoundedMarkState P J ell B → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) (hs : s.1 ≠ L 0) :
    finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
      (physicalSelectedFineRow C aux L σ τ k β V ρ hV ω retention) (4 * n + 1) F s = 0 := by
  apply finite_row_composition_zero_of_first
  intro G
  have hrow := physical_selected_fine_row_visit C aux L σ τ k β V ρ hV ω retention
    (0 : Fin (n + 1)) G
  simp only [Fin.val_zero, mul_zero] at hrow
  rw [hrow]
  exact physical_observed_selected_visit_zero_of_marks C k ω β retention ρ V hV 0 (L 0) G s hs

theorem physical_selected_fine_initial_mark_indicator
    (F : PhysicalBoundedMarkState P J ell B → ℂ) (M : PhysicalMarkLists P J ell) :
    finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
      (physicalSelectedFineRow C aux L σ τ k β V ρ hV ω retention) (4 * n + 1) F
      (physicalInitialMarkState B M) =
    if M = L 0 then
      finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
        (physicalSelectedFineRow C aux L σ τ k β V ρ hV ω retention) (4 * n + 1) F
        (physicalInitialMarkState B (L 0)) else 0 := by
  by_cases hM : M = L 0
  · subst M
    rw [if_pos rfl]
  · rw [if_neg hM]
    exact physical_selected_fine_zero_of_initial_marks C aux L σ τ k β V ρ hV ω retention
      F (physicalInitialMarkState B M) hM

end Support
end Bounty
end

section

/- Exact selectors used to recover the prescribed labels and draws from a chronological record. -/

open scoped Classical
namespace Bounty
section Fine
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)

theorem physical_selected_fine_test_visit (j : Fin (n + 1))
    (o : PhysicalMarkObservation P ell C) (t : PhysicalBoundedMarkState P J ell B) :
    physicalSelectedFineTest C aux L σ τ (4 * j.val) o t ↔
      o = .inr none ∧ t.1 = L j := by
  have hj := j.isLt
  have hi : 4 * j.val < 4 * n + 1 := by omega
  have h0 : (4 * j.val) % 4 = 0 := by omega
  have hd : (4 * j.val) / 4 = j.val := by omega
  have he (h : (4 * j.val) / 4 < n + 1) : (⟨(4 * j.val) / 4, h⟩ : Fin (n + 1)) = j := Fin.ext hd
  simp only [physicalSelectedFineTest,
    dif_pos hi, dif_pos h0, he]

theorem physical_selected_fine_test_source_permutation (j : Fin n)
    (o : PhysicalMarkObservation P ell C) (t : PhysicalBoundedMarkState P J ell B) :
    physicalSelectedFineTest C aux L σ τ (4 * j.val + 1) o t ↔
      o = .inl (σ j) := by
  have hj := j.isLt
  have hi : 4 * j.val + 1 < 4 * n + 1 := by omega
  have h0 : ¬ (4 * j.val + 1) % 4 = 0 := by omega
  have h1 : (4 * j.val + 1) % 4 = 1 := by omega
  have h2 : ¬ (4 * j.val + 1) % 4 = 2 := by omega
  have hd : (4 * j.val + 1) / 4 = j.val := by omega
  have he (h : (4 * j.val + 1) / 4 < n) : (⟨(4 * j.val + 1) / 4, h⟩ : Fin n) = j := Fin.ext hd
  simp only [physicalSelectedFineTest,
    dif_pos hi, dif_neg h0, if_pos h1, he]

theorem physical_selected_fine_test_edge (j : Fin n)
    (o : PhysicalMarkObservation P ell C) (t : PhysicalBoundedMarkState P J ell B) :
    physicalSelectedFineTest C aux L σ τ (4 * j.val + 2) o t ↔
      o = .inr (some ⟨j, aux j⟩) ∧ t.1 = physicalPermuteLabels (τ j) (L j.succ) := by
  have hj := j.isLt
  have hi : 4 * j.val + 2 < 4 * n + 1 := by omega
  have h0 : ¬ (4 * j.val + 2) % 4 = 0 := by omega
  have h1 : ¬ (4 * j.val + 2) % 4 = 1 := by omega
  have h2 : (4 * j.val + 2) % 4 = 2 := by omega
  have hd : (4 * j.val + 2) / 4 = j.val := by omega
  have he (h : (4 * j.val + 2) / 4 < n) : (⟨(4 * j.val + 2) / 4, h⟩ : Fin n) = j := Fin.ext hd
  simp only [physicalSelectedFineTest,
    dif_pos hi, dif_neg h0, if_neg h1, if_pos h2, he]
  have haux (h : (4 * j.val + 2) / 4 < n) :
      (⟨⟨(4 * j.val + 2) / 4, h⟩, aux ⟨(4 * j.val + 2) / 4, h⟩⟩ :
        Σ j : Fin n, PhysicalAuxLabels P (C j)) = ⟨j, aux j⟩ :=
    congrArg (fun j : Fin n => (⟨j, aux j⟩ : Σ j : Fin n, PhysicalAuxLabels P (C j))) (he h)
  simp only [haux]

theorem physical_selected_fine_test_target_permutation (j : Fin n)
    (o : PhysicalMarkObservation P ell C) (t : PhysicalBoundedMarkState P J ell B) :
    physicalSelectedFineTest C aux L σ τ (4 * j.val + 3) o t ↔
      o = .inl (physicalInversePermutations (τ j)) := by
  have hj := j.isLt
  have hi : 4 * j.val + 3 < 4 * n + 1 := by omega
  have h0 : ¬ (4 * j.val + 3) % 4 = 0 := by omega
  have h1 : ¬ (4 * j.val + 3) % 4 = 1 := by omega
  have h2 : ¬ (4 * j.val + 3) % 4 = 2 := by omega
  have hd : (4 * j.val + 3) / 4 = j.val := by omega
  have he (h : (4 * j.val + 3) / 4 < n) : (⟨(4 * j.val + 3) / 4, h⟩ : Fin n) = j := Fin.ext hd
  simp only [physicalSelectedFineTest,
    dif_pos hi, dif_neg h0, if_neg h1, if_neg h2, he]

end Fine
end Bounty
end

section

/- Explicit finite tilt and collision budgets for the actual prime-pattern
family. Only the already defined physical perturbation error is estimated. -/

open Finset
open scoped Classical

namespace Bounty

theorem repeated_big_pattern_lifespan_card_le {G : Type*} [Fintype G]
    {J ell m : ℕ} (C : G → Finset (Fin J)) (hC : ∀ g, (C g).card ≤ m) :
    2 * ∑ g, (ell + (C g).card) ≤ 2 * Fintype.card G * (ell + m) := by
  calc
    _ ≤ 2 * ∑ _g : G, (ell + m) :=
      Nat.mul_le_mul_left 2 (sum_le_sum (fun g _ => Nat.add_le_add_left (hC g) ell))
    _ = _ := by simp [Nat.mul_assoc]

theorem repeated_big_prime_pattern_small_of_uniform {G : Type*}
    [Fintype G] [DecidableEq G] {J ell m : ℕ}
    (probes : G → Finset (Fin J)) (r t : Finset G) (hp : ∀ g, (probes g).card ≤ m)
    {T Pmin : ℝ} (hT : 0 ≤ T) (hPmin : 0 < Pmin)
    (hsmall : ((2 * Fintype.card G * (ell + m) : ℕ) : ℝ) * T / Pmin ≤ 1 / 2)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t) :
    ((2 * ∑ g, (ell + (repeatedBigPrimePatternCut probes r t i g).card) : ℕ) : ℝ) *
      T / Pmin ≤ 1 / 2 := by
  apply le_trans _ hsmall
  apply div_le_div_of_nonneg_right _ hPmin.le
  apply mul_le_mul_of_nonneg_right _ hT
  exact_mod_cast repeated_big_pattern_lifespan_card_le (ell := ell)
    (repeatedBigPrimePatternCut probes r t i)
    (repeated_big_prime_pattern_cut_card_le probes r t hp i)

theorem repeated_big_pattern_error_le_uniform {G : Type*} [Fintype G]
    {J ell m : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hC : ∀ g, (C g).card ≤ m) {v T Pmin B : ℝ}
    (hv : 0 < v) (hV : ∀ g, v ≤ V g) (hT : 0 ≤ T)
    (hPmin : 0 < Pmin) (hB : 0 ≤ B) :
    repeatedBigPatternError (ell := ell) V C T Pmin B ≤
      B * (((2 * Fintype.card G * (ell + m) : ℕ) : ℝ) * T / Pmin +
        (Fintype.card G : ℝ) * ((m : ℝ) * (2 * (J + ell : ℕ))) / (v * Pmin)) := by
  unfold repeatedBigPatternError
  apply mul_le_mul_of_nonneg_left _ hB
  apply add_le_add
  · apply div_le_div_of_nonneg_right _ hPmin.le
    apply mul_le_mul_of_nonneg_right _ hT
    exact_mod_cast repeated_big_pattern_lifespan_card_le (ell := ell) C hC
  · calc
      _ ≤ ∑ _g : G, (m : ℝ) * (2 * (J + ell : ℕ)) / (v * Pmin) := by
        apply sum_le_sum
        intro g hg
        calc
          _ ≤ (m : ℝ) * (2 * (J + ell : ℕ)) / (V g * Pmin) := by
            apply div_le_div_of_nonneg_right _ (mul_nonneg (hv.trans_le (hV g)).le hPmin.le)
            apply mul_le_mul_of_nonneg_right _ (by positivity)
            exact_mod_cast hC g
          _ ≤ _ := div_le_div_of_nonneg_left (by positivity) (mul_pos hv hPmin)
            (mul_le_mul_of_nonneg_right (hV g) hPmin.le)
      _ = _ := by simp only [sum_const, card_univ, nsmul_eq_mul]; ring

theorem repeated_big_prime_pattern_bound_sum_le {G : Type*} [DecidableEq G]
    {J ell m : ℕ} (probes : G → Finset (Fin J)) (r t : Finset G)
    (hp : ∀ g, (probes g).card ≤ m) (Q : ℕ) (ξ : ℝ) :
    (∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      repeatedBigPrimePatternBound probes r t Q ξ i) ≤
      1 + (2 : ℝ) ^ (m * (r.card + t.card)) * ((Q * Q : ℕ) / ξ) ^ 2 := by
  rw [Fintype.sum_sum_type]
  simp only [repeatedBigPrimePatternBound, sum_const, card_univ, nsmul_eq_mul,
    Fintype.card_unit, Nat.cast_one, mul_one]
  apply add_le_add le_rfl
  apply mul_le_mul_of_nonneg_right _ (sq_nonneg _)
  exact_mod_cast repeated_big_prime_pattern_pair_card_le (ell := ell) probes r t hp

theorem repeated_big_prime_pattern_error_sum_le {G : Type*}
    [Fintype G] [DecidableEq G] {J ell m : ℕ}
    (V : G → ℝ) (probes : G → Finset (Fin J)) (r t : Finset G)
    (hp : ∀ g, (probes g).card ≤ m) (Q : ℕ) (ξ : ℝ)
    {v T Pmin : ℝ} (hv : 0 < v) (hV : ∀ g, v ≤ V g)
    (hT : 0 ≤ T) (hPmin : 0 < Pmin) :
    (∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      ‖repeatedBigPrimePatternWeight probes r t i‖ *
        repeatedBigPatternError (ell := ell) V (repeatedBigPrimePatternCut probes r t i)
          T Pmin (repeatedBigPrimePatternBound probes r t Q ξ i)) ≤
      (1 + (2 : ℝ) ^ (m * (r.card + t.card)) * ((Q * Q : ℕ) / ξ) ^ 2) *
        (((2 * Fintype.card G * (ell + m) : ℕ) : ℝ) * T / Pmin +
          (Fintype.card G : ℝ) * ((m : ℝ) * (2 * (J + ell : ℕ))) / (v * Pmin)) := by
  simp only [repeated_big_prime_pattern_weight_norm, one_mul]
  calc
    _ ≤ ∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
        repeatedBigPrimePatternBound probes r t Q ξ i *
          (((2 * Fintype.card G * (ell + m) : ℕ) : ℝ) * T / Pmin +
            (Fintype.card G : ℝ) * ((m : ℝ) * (2 * (J + ell : ℕ))) / (v * Pmin)) := by
      apply sum_le_sum
      intro i hi
      exact repeated_big_pattern_error_le_uniform V (repeatedBigPrimePatternCut probes r t i)
        (repeated_big_prime_pattern_cut_card_le probes r t hp i) hv hV hT hPmin
        (repeated_big_prime_pattern_bound_nonneg probes r t Q ξ i)
    _ = _ := by rw [← sum_mul]
    _ ≤ _ := mul_le_mul_of_nonneg_right
      (repeated_big_prime_pattern_bound_sum_le (ell := ell) probes r t hp Q ξ) (by positivity)

theorem repeated_big_prime_pattern_error_sum_le_groups {G : Type*}
    [Fintype G] [DecidableEq G] {J ell m : ℕ}
    (V : G → ℝ) (probes : G → Finset (Fin J)) (r t : Finset G) (hrt : Disjoint r t)
    (hp : ∀ g, (probes g).card ≤ m) (Q : ℕ) (ξ : ℝ)
    {v T Pmin : ℝ} (hv : 0 < v) (hV : ∀ g, v ≤ V g)
    (hT : 0 ≤ T) (hPmin : 0 < Pmin) :
    (∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      ‖repeatedBigPrimePatternWeight probes r t i‖ *
        repeatedBigPatternError (ell := ell) V (repeatedBigPrimePatternCut probes r t i)
          T Pmin (repeatedBigPrimePatternBound probes r t Q ξ i)) ≤
      (1 + (2 : ℝ) ^ (m * Fintype.card G) * ((Q * Q : ℕ) / ξ) ^ 2) *
        (((2 * Fintype.card G * (ell + m) : ℕ) : ℝ) * T / Pmin +
          (Fintype.card G : ℝ) * ((m : ℝ) * (2 * (J + ell : ℕ))) / (v * Pmin)) := by
  apply (repeated_big_prime_pattern_error_sum_le V probes r t hp Q ξ hv hV hT hPmin).trans
  apply mul_le_mul_of_nonneg_right _ (by positivity)
  apply add_le_add le_rfl
  apply mul_le_mul_of_nonneg_right _ (sq_nonneg _)
  apply pow_le_pow_right₀ (by norm_num : (1 : ℝ) ≤ 2)
  apply Nat.mul_le_mul_left
  rw [← card_union_of_disjoint hrt]
  exact card_le_univ _

end Bounty
end

section

/- Elementary side conditions for the exact prime-kernel parameter chain and
its two disjoint collections of mapped probe slots. -/

open Finset Filter

namespace Bounty

/-- All six parameters in the actual prime-kernel construction are nonnegative.
The fiber factor is at least one for every `v` and `m`. -/
theorem repeated_big_prime_kernel_exponents_nonneg
    (s z a v D ε : ℝ) (m : ℕ)
    (hs : 0 ≤ s) (hz : 0 ≤ z) (ha : 0 ≤ a) (hD : 0 ≤ D) (hε : 0 ≤ ε) :
    let κ := a * Real.log (primeFiberFactorBound v m)
    let s' := s + ε
    let A₀ := D + 2 * (s' + 1)
    let q := 2 * κ + (s' + 1) + 2 * A₀ + 3
    let w := 4 * q + max z q + A₀ + 2
    let x := (s' + w + 2) + 2 * A₀ + 2
    0 ≤ κ ∧ 0 ≤ s' ∧ 0 ≤ A₀ ∧ 0 ≤ q ∧ 0 ≤ w ∧ 0 ≤ x := by
  intro κ s' A₀ q w x
  have hk : 0 ≤ κ := mul_nonneg ha (Real.log_nonneg (one_le_primeFiberFactorBound v m))
  have hs' : 0 ≤ s' := add_nonneg hs hε
  have hA : 0 ≤ A₀ := by dsimp [A₀]; positivity
  have hq : 0 ≤ q := by dsimp [q]; positivity
  have hmz : 0 ≤ max z q := hz.trans (le_max_left _ _)
  have hw : 0 ≤ w := add_nonneg (add_nonneg (add_nonneg
    (mul_nonneg (by norm_num) hq) hmz) hA) (by norm_num)
  have hx : 0 ≤ x := by dsimp [x]; positivity
  exact ⟨hk, hs', hA, hq, hw, hx⟩

/-- Disjoint blocks use at most `m` mapped probes per group in total. -/
theorem repeated_big_prime_mapped_probe_card_le {G : Type*}
    [Fintype G] [DecidableEq G] {J ell m : ℕ}
    (probes : G → Finset (Fin J)) (r t : Finset G) (hrt : Disjoint r t)
    (hp : ∀ g, (probes g).card ≤ m) :
    (r.sigma (fun g => (probes g).map (Function.Embedding.inl (β := Fin ell)))).card +
      (t.sigma (fun g => (probes g).map (Function.Embedding.inl (β := Fin ell)))).card ≤
        m * Fintype.card G := by
  have hcard : r.card + t.card ≤ Fintype.card G := by
    rw [← card_union_of_disjoint hrt]
    exact card_le_univ _
  calc
    _ ≤ m * r.card + m * t.card := Nat.add_le_add
      (repeated_big_prime_probe_sigma_card_le (ell := ell) probes r hp)
      (repeated_big_prime_probe_sigma_card_le (ell := ell) probes t hp)
    _ = m * (r.card + t.card) := by ring
    _ ≤ _ := Nat.mul_le_mul_left m hcard

/-- Polynomially many visits leave a positive baseline at every prime above
the exponential lower cutoff. The threshold is uniform in both cutoffs. -/
theorem eventually_repeated_big_baseline_pos {c tau : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ T P : ℝ,
      0 ≤ T → T ≤ L ^ tau → Real.exp (L ^ c) ≤ P →
      T / P ≤ 1 / 2 ∧ ∀ p : ℝ, P ≤ p → 0 < 1 - T / p := by
  filter_upwards [eventually_exp_neg_rpow_mul_rpow_le hc
    (show (0 : ℝ) < 1 by norm_num) tau 1, eventually_ge_atTop (2 : ℝ)]
    with L hsmall hL
  intro T P hT0 hT hP
  have hP0 : 0 < P := lt_of_lt_of_le (Real.exp_pos _) hP
  have hratio : T / P ≤ 1 / 2 := by
    calc
      _ ≤ L ^ tau / Real.exp (L ^ c) := div_le_div₀
        (Real.rpow_nonneg (by linarith) tau) hT (Real.exp_pos _) hP
      _ = Real.exp (-1 * L ^ c) * L ^ tau := by
        simp only [neg_mul, one_mul, Real.exp_neg]
        ring
      _ ≤ L ^ (-(1 : ℝ)) := hsmall
      _ ≤ 1 / 2 := by
        rw [Real.rpow_neg_one, inv_eq_one_div]
        exact one_div_le_one_div_of_le (by norm_num) hL
  refine ⟨hratio, ?_⟩
  intro p hp
  have hratio' : T / p ≤ 1 / 2 :=
    (div_le_div_of_nonneg_left hT0 hP0 hp).trans hratio
  linarith

end Bounty
end

section

/- The mask average equals the actual power weight on shifted prime divisibility. -/

open Finset Filter
open scoped Topology

namespace Bounty

theorem odd_masked_pair_box_filter (a b c d m : ℕ) (W z : ℝ) (P S : Finset ℕ)
    (hP : P ⊆ primeBand 0 z) (hPm : ∀ p ∈ P, ¬p ∣ m) (hP2 : 2 ∉ P) (hS : S ⊆ P) :
    oddMaskedPairBox a b c d m W z S =
      (oddMaskedPairBox a b c d m W z P).filter (fun v => pairShiftedPrimeSet P v ⊆ S) := by
  classical
  apply Finset.ext
  intro v
  rw [mem_filter]
  simp only [oddMaskedPairBox, mem_filter]
  change _ ↔ _ ∧ P.filter (fun p => (v.1*v.2) % p = 1 % p) ⊆ S
  constructor
  · rintro ⟨hbase, hrough, hban⟩
    refine ⟨⟨hbase, hrough, ?_⟩, ?_⟩
    · intro p hp hp2 hpm hpP
      exact hban p hp hp2 hpm (fun hpS => hpP (hS hpS))
    · intro p hp
      obtain ⟨hpP, hpone⟩ := mem_filter.mp hp
      by_contra hpS
      exact hban p (hP hpP) (fun he => hP2 (he ▸ hpP)) (hPm p hpP) hpS hpone
  · rintro ⟨⟨hbase, hrough, hban⟩, hforced⟩
    refine ⟨hbase, hrough, ?_⟩
    intro p hp hp2 hpm hpS hpone
    by_cases hpP : p ∈ P
    · exact hpS (hforced (mem_filter.mpr ⟨hpP, hpone⟩))
    · exact hban p hp hp2 hpm hpP hpone

theorem odd_masked_pair_average_eq_power_weight (a b c d m : ℕ) (W z q : ℝ)
    (P : Finset ℕ) (hP : P ⊆ primeBand 0 z) (hPm : ∀ p ∈ P, ¬p ∣ m) (hP2 : 2 ∉ P) :
    (∑ S ∈ P.powerset, bernoulliSubsetWeight q P S *
      ((oddMaskedPairBox a b c d m W z S).card : ℝ)) =
      ∑ v ∈ oddMaskedPairBox a b c d m W z P, q^(pairShiftedPrimeSet P v).card := by
  classical
  calc
    _ = ∑ S ∈ P.powerset, ∑ v ∈ oddMaskedPairBox a b c d m W z P,
        if pairShiftedPrimeSet P v ⊆ S then bernoulliSubsetWeight q P S else 0 := by
      apply sum_congr rfl
      intro S hS
      rw [odd_masked_pair_box_filter a b c d m W z P S hP hPm hP2 (mem_powerset.mp hS)]
      have hc : (((oddMaskedPairBox a b c d m W z P).filter
          (fun v => pairShiftedPrimeSet P v ⊆ S)).card : ℝ) =
          ∑ v ∈ oddMaskedPairBox a b c d m W z P,
            if pairShiftedPrimeSet P v ⊆ S then (1 : ℝ) else 0 := by simp
      rw [hc, mul_sum]
      apply sum_congr rfl
      intro v _
      split_ifs <;> simp
    _ = ∑ v ∈ oddMaskedPairBox a b c d m W z P,
        ∑ S ∈ P.powerset, if pairShiftedPrimeSet P v ⊆ S then bernoulliSubsetWeight q P S else 0 :=
      sum_comm
    _ = _ := by
      apply sum_congr rfl
      intro v _
      exact bernoulli_mask_contains P (pairShiftedPrimeSet P v) (filter_subset _ _) q

theorem odd_masked_pair_average_eq_divisor_weight (a b c d m : ℕ) (W z q : ℝ)
    (P : Finset ℕ) (hP : P ⊆ primeBand 0 z) (hPm : ∀ p ∈ P, ¬p ∣ m) (hP2 : 2 ∉ P) :
    (∑ S ∈ P.powerset, bernoulliSubsetWeight q P S *
      ((oddMaskedPairBox a b c d m W z S).card : ℝ)) =
      ∑ v ∈ oddMaskedPairBox a b c d m W z P, q^((P.filter (fun p => p ∣ v.1*v.2-1)).card) := by
  rw [odd_masked_pair_average_eq_power_weight a b c d m W z q P hP hPm hP2]
  apply sum_congr rfl
  intro v hv
  have hbase := (mem_filter.mp hv).1
  simp only [pairSieveBaseBox, Finset.product_eq_sprod, mem_filter, mem_product, mem_Ioc] at hbase
  have hx : 0 < v.1 := lt_of_le_of_lt (Nat.zero_le a) hbase.1.1.1
  have hy : 0 < v.2 := lt_of_le_of_lt (Nat.zero_le c) hbase.1.2.1
  rw [pair_shifted_prime_set_eq_divisors P v (Nat.succ_le_of_lt (mul_pos hx hy))]

theorem exists_candidate_odd_shifted_divisor_pair_bound :
    ∃ K : ℝ, 0 < K ∧ ∀ (γ q : ℝ), 0 < γ → 0 ≤ q → q ≤ 1 →
      ∀ᶠ L : ℝ in atTop, ∀ (a b c d m : ℕ) [NeZero m] (W z : ℝ) (P : Finset ℕ),
        (m : ℝ) ≤ Real.exp L → (∀ p ∈ m.primeFactors, L^2 ≤ (p : ℝ)) →
        a ≤ b → c ≤ d → 0 ≤ W → W ≤ z → 1 < z →
        P ⊆ (candidatePIndices γ L).biUnion (candidatePBand (γ*L)) →
        P ⊆ primeBand 0 z → (∀ p ∈ P, ¬p ∣ m) → 2 ∉ P →
        (∑ v ∈ oddMaskedPairBox a b c d m W z P,
          q^((P.filter (fun p => p ∣ v.1*v.2-1)).card)) ≤
          K * (((b : ℝ)-a)*((d : ℝ)-c)/(m : ℝ)) *
            (∏ p ∈ primeBand 0 W, (1 - 1/(p : ℝ)))^2 *
            (∏ p ∈ primeBand 0 z, (1 - 1/(p : ℝ))) *
            candidateOneMarkedHarmonicMass γ L q +
          ((m : ℝ)*(z^(10 : ℝ))^3 + (((b : ℝ)-a)+((d : ℝ)-c))*(z^(10 : ℝ))^2) := by
  obtain ⟨K, hK, hb⟩ := exists_candidate_odd_masked_pair_bound
  refine ⟨K, hK, ?_⟩
  intro γ q hγ hq0 hq1
  filter_upwards [hb γ q hγ hq0 hq1] with L h
  intro a b c d m hm W z P hmL hmin hab hcd hW hWz hz hP hPz hPm hP2
  rw [← odd_masked_pair_average_eq_divisor_weight a b c d m W z q P hPz hPm hP2]
  exact h a b c d m W z P hmL hmin hab hcd hW hWz hz hP

end Bounty
end

section

/- The exact original physical mark history starts at its actual empty-memory initial state. -/

open Finset
open scoped Classical
namespace Bounty
section Physical
variable {I K : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g, ∀ p : ↥(P g), NeZero p.val]
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (retention : I → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

variable (tags : ℕ → Option (I ⊕ K)) (cut : ℕ → Fin N → Finset (Fin J)) (steps : ℕ)
  (initialTrace : FullMixedLedgerState (fun g (p : {p // p ∈ P g}) => Subtype.val p) (M := fun _ => J + ell) B →
    List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C))
  (Φ : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C) →
    FullMixedLedgerState (fun g (p : {p // p ∈ P g}) => Subtype.val p) (M := fun _ => J + ell) B → ℂ)
  (f : PhysicalFullBoundedState P J ell B → ℂ)

theorem physical_initial_recorded_mark_scalar_paths
    (hV : ∀ g, V g ≠ 0)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hencode : ∀ i, PhysicalMarkRowEncoding C (tags i) (cut i) (cut (i + 1)))
    (L : PhysicalMarkLists P J ell) :
    let x := physicalFullMemoryState (cut 0) L (fun g => fullEmptyBoundedMemory
      (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B)
