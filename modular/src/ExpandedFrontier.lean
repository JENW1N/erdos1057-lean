/- Actual retained candidate cross-sums admit a uniform power frequency cutoff. -/

open Finset MeasureTheory Filter
open scoped ComplexConjugate

namespace Bounty

theorem exists_candidate_smooth_cross_fourier_truncation
    {c q K₀ Cz A D : ℝ} (hc : 0 < c) (hq0 : 0 ≤ q) (hq1 : q < 1) (hCz : 0 ≤ Cz) :
    ∃ F : ℝ, 0 < F ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (r jStar : ℕ) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
        (take : Fin ((candidateQIndices c L).card*r) → Bool),
      take ((candidateAllocationOrder c L r).symm
        (candidateRoughSlot c L r jStar hr hj)) = false →
      ∀ (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ),
      (∀ slot p, p ∈ candidateQSlotChoices c L r jStar slot → ‖twist slot p‖ ≤ 1) →
      ∀ (U V E Z : ℝ) (k : ℤ), 0 < U → 0 < V → 1 ≤ Z → k ≠ 0 →
        E = U * L^(-K₀) → 1 ≤ U*V → Z ≤ 24*U^2*V*L^88/E →
        Real.log Z ≤ Cz*L → |(k:ℝ)| ≤ Z →
      ∀ (M H Zs : Finset ℕ) (α : ℕ → ℂ) (ρ : ℝ)
        (χ : DirichletCharacter ℂ (2*k.natAbs)),
        (∀ m ∈ M, (m:ℝ) ∈ Set.Icc U (2*U)) → (∀ m ∈ M, ‖α m‖ ≤ L^A) →
        (∀ z ∈ Zs, 0 < z ∧ 0 < (z:ℤ)+k) → (∀ z ∈ Zs, (z:ℝ) ≤ 2*Z) →
      let aH : ℕ → ℂ := fun h => typeIIPhase ρ h *
        candidateRetainedComplexCoefficient c L q r jStar take twist h
      Integrable (typeIICrossCharacterFourierIntegrand 1 L U V E Z k M H Zs
        typeIISmoothDyadic α aH χ) ∧
      ‖(∑ y ∈ typeIICrossSlice M H Zs k, (typeIISmoothDyadic ((y.1.2:ℝ)/Z) : ℂ) *
          typeIIRealShiftWeight
            (fun e n => typeIIEMajorant (L^88) (e/E) * typeIINMajorant (n/V)) α aH y *
            χ (y.2.1.1 : ZMod (2*k.natAbs)) * conj (χ (y.2.2.1 : ZMod (2*k.natAbs)))) -
        ∫ ξ in {ξ : EuclideanSpace ℝ (Fin 3) | ‖ξ‖ ≤ L^F},
          typeIICrossCharacterFourierIntegrand 1 L U V E Z k M H Zs
            typeIISmoothDyadic α aH χ ξ‖ ≤ Z * L^(-D) := by
  obtain ⟨C, hC, hmass⟩ := exists_candidate_cross_character_localized_bound hc hq0 hq1 hCz
  let T : ℝ := max 0 (D + (2*(A+C)+16))
  have hT : 0 ≤ T := le_max_left _ _
  obtain ⟨F, hF, htruncate⟩ := eventually_typeII_smooth_dyadic_character_truncation
    (K₀ := K₀) hT
  refine ⟨F, hF, ?_⟩
  filter_upwards [hmass, htruncate, eventually_ge_atTop (1:ℝ)] with L hmass htruncate hL
  intro r jStar hr hj take hkeep twist htwist U V E Z k hU hV hZ hk hE hUV hZupper
    hZlog hksize M H Zs α ρ χ hM hα hpos hloc
  dsimp only
  let aH : ℕ → ℂ := fun h => typeIIPhase ρ h *
    candidateRetainedComplexCoefficient c L q r jStar take twist h
  have hZ0 : 0 < Z := zero_lt_one.trans_le hZ
  have hMpos : ∀ m ∈ M, 0 < m := by
    intro m hm
    exact_mod_cast hU.trans_le (hM m hm).1
  have hψ : ∀ z ∈ Zs, |typeIISmoothDyadic ((z:ℝ)/Z)| ≤ 1 := by
    intro z hz
    rw [abs_of_nonneg (typeII_smooth_dyadic_bounds _).1]
    exact (typeII_smooth_dyadic_bounds _).2
  have hbound := hmass r jStar hr hj take hkeep twist htwist A ρ M H Zs α hMpos hα
    k Z typeIISmoothDyadic χ hk hψ hpos hZ hZlog hloc hksize
  have ht := htruncate U V E Z k hU hV hZ0 hk hE hUV hZupper M H Zs α aH χ hM
  refine ⟨ht.1, ht.2.trans ?_⟩
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  calc
    _ ≤ L^(-T) * (Z * L^(2*(A+C)+16)) :=
      mul_le_mul_of_nonneg_left hbound (Real.rpow_nonneg hL0.le _)
    _ = Z * L^(-T + (2*(A+C)+16)) := by
      rw [Real.rpow_add hL0 (-T) (2*(A+C)+16)]
      ring
    _ ≤ Z * L^(-D) := by
      apply mul_le_mul_of_nonneg_left _ hZ0.le
      apply Real.rpow_le_rpow_of_exponent_le hL
      have hTD : D + (2*(A+C)+16) ≤ T := le_max_right _ _
      linarith

end Bounty
end

section

/- Explicit propagation of box errors through both finite sums and the character normalization. -/

open Finset MeasureTheory

namespace Bounty

theorem typeII_energy_fourier_difference_le
    (L U V E : ℝ) (B : ℕ) (M H : Finset ℕ) (α aH : ℕ → ℂ)
    (T₁ T₂ : Set (EuclideanSpace ℝ (Fin 3))) {ε : ℝ}
    (hε : 0 ≤ ε)
    (hZ : ∀ j ∈ range (typeIISmoothDyadicCount L), 0 ≤ typeIISmoothDyadicScale U V E j)
    (herror : ∀ k ∈ Icc (-(B:ℤ)) B, k ≠ 0 →
      ∀ j ∈ range (typeIISmoothDyadicCount L),
      ∀ χ : DirichletCharacter ℂ (2*k.natAbs),
      let M₀ := M.filter (fun m => α m ≠ 0)
      let Zs := Icc 0 (M₀.sup id * H.sup id)
      ‖(∫ ξ in T₁, typeIICrossCharacterFourierIntegrand 1 L U V E
          (typeIISmoothDyadicScale U V E j) k M₀ H Zs typeIISmoothDyadic α aH χ ξ) -
        ∫ ξ in T₂, typeIICrossCharacterFourierIntegrand 1 L U V E
          (typeIISmoothDyadicScale U V E j) k M₀ H Zs typeIISmoothDyadic α aH χ ξ‖ ≤
        typeIISmoothDyadicScale U V E j * ε) :
    ‖typeIIEnergyFourierIntegral L U V E B M H α aH T₁ -
      typeIIEnergyFourierIntegral L U V E B M H α aH T₂‖ ≤
      (2*(B:ℝ)) * (∑ j ∈ range (typeIISmoothDyadicCount L), typeIISmoothDyadicScale U V E j) * ε := by
  classical
  unfold typeIIEnergyFourierIntegral typeIIDyadicCharacterIntegral
  rw [mul_assoc]
  apply normalized_character_signed_interval_error_le B _ _
    (mul_nonneg (sum_nonneg hZ) hε)
  intro k hk hk0 χ
  rw [sum_mul]
  apply finite_complex_sum_error_le
  intro j hj
  exact herror k hk hk0 j hj χ

theorem typeII_energy_fourier_norm_le
    (L U V E : ℝ) (B : ℕ) (M H : Finset ℕ) (α aH : ℕ → ℂ)
    (T : Set (EuclideanSpace ℝ (Fin 3))) {R : ℝ}
    (hR : 0 ≤ R)
    (hZ : ∀ j ∈ range (typeIISmoothDyadicCount L), 0 ≤ typeIISmoothDyadicScale U V E j)
    (hbound : ∀ k ∈ Icc (-(B:ℤ)) B, k ≠ 0 →
      ∀ j ∈ range (typeIISmoothDyadicCount L),
      ∀ χ : DirichletCharacter ℂ (2*k.natAbs),
      let M₀ := M.filter (fun m => α m ≠ 0)
      let Zs := Icc 0 (M₀.sup id * H.sup id)
      ‖∫ ξ in T, typeIICrossCharacterFourierIntegrand 1 L U V E
          (typeIISmoothDyadicScale U V E j) k M₀ H Zs typeIISmoothDyadic α aH χ ξ‖ ≤
        typeIISmoothDyadicScale U V E j * R) :
    ‖typeIIEnergyFourierIntegral L U V E B M H α aH T‖ ≤
      (2*(B:ℝ)) * (∑ j ∈ range (typeIISmoothDyadicCount L), typeIISmoothDyadicScale U V E j) * R := by
  classical
  have h := typeII_energy_fourier_difference_le L U V E B M H α aH T ∅ hR hZ
    (by simpa only [Measure.restrict_empty, integral_zero_measure, sub_zero] using hbound)
  simpa [typeIIEnergyFourierIntegral, typeIIDyadicCharacterIntegral,
    normalizedCharacterAverage] using h

end Bounty
end

section

/- Actual exponential scale ranges imply the determinant and spatial scale conditions. -/

open Finset Filter Real

namespace Bounty

noncomputable def typeIIAdmissibleDeterminantBound (L K : ℝ) : ℕ :=
  ⌈2*L^(K+88)⌉₊

theorem typeII_admissible_determinant_bound {L K U E : ℝ}
    (hL : 0 < L) (hU : 0 < U) (hE : E = U*L^(-K)) :
    (2*U)/(2*(E/(2*L^88))) ≤ (typeIIAdmissibleDeterminantBound L K : ℝ) := by
  have hp : L^K ≠ 0 := (rpow_pos_of_pos hL K).ne'
  calc
    _ = 2*L^(K+88) := by
      rw [hE, rpow_add hL, rpow_neg hL.le]
      norm_num
      field_simp
    _ ≤ _ := Nat.le_ceil _

private theorem determinant_bound_le_three_rpow {L K : ℝ}
    (hL : 1 ≤ L) (hK : 0 ≤ K) :
    (typeIIAdmissibleDeterminantBound L K : ℝ) ≤ 3*L^(K+88) := by
  have hp : 1 ≤ L^(K+88) := one_le_rpow hL (by linarith)
  have hceil := Nat.ceil_lt_add_one (show 0 ≤ 2*L^(K+88) by positivity)
  change (⌈2*L^(K+88)⌉₊ : ℝ) ≤ _
  linarith

theorem eventually_typeII_actual_dyadic_geometry {b K : ℝ}
    (hb : 0 < b) (hK : 0 ≤ K) :
    ∀ᶠ L : ℝ in atTop, ∀ U V E : ℝ,
      exp (b*L) ≤ U → U ≤ exp L → exp (b*L) ≤ V → V ≤ exp L →
      E = U*L^(-K) →
      0 < U ∧ 0 < V ∧ 0 < E ∧ 4 ≤ U*V ∧ log (U*V) ≤ 2*L ∧
      (2*U)/(2*(E/(2*L^88))) ≤ (typeIIAdmissibleDeterminantBound L K : ℝ) ∧
      max 1 (typeIIAdmissibleDeterminantBound L K : ℝ) ≤ typeIISmoothDyadicScale U V E 0 ∧
      log (24*U^2*V*L^88/E) ≤ 3*L ∧
      (typeIIAdmissibleDeterminantBound L K : ℝ) ≤ exp (sqrt L) ∧ 2 ≤ exp (sqrt L) := by
  have hgrowth := eventually_mul_rpow_log_add_le_rpow
    (a := (0:ℝ)) (b := (1:ℝ)) (c := 2*b)
    (by norm_num) (by norm_num) (by positivity) 88 (log 48)
  have hlogcost := eventually_mul_rpow_log_add_le_rpow
    (a := (0:ℝ)) (b := (1:ℝ)) (c := (1:ℝ))
    (by norm_num) (by norm_num) (by norm_num) (K+88) (log 24)
  have hsqrtcost := eventually_mul_rpow_log_add_le_rpow
    (a := (0:ℝ)) (b := (1/2:ℝ)) (c := (1:ℝ))
    (by norm_num) (by norm_num) (by norm_num) (K+88) (log 3)
  filter_upwards [hgrowth, hlogcost, hsqrtcost, eventually_ge_atTop (1:ℝ)]
    with L hgrowth hlogcost hsqrtcost hL
  simp only [rpow_zero, rpow_one, mul_one, one_mul, ← sqrt_eq_rpow] at hgrowth hlogcost hsqrtcost
  intro U V E hUlo hUhi hVlo hVhi hE
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hU : 0 < U := (exp_pos _).trans_le hUlo
  have hV : 0 < V := (exp_pos _).trans_le hVlo
  have hE0 : 0 < E := by rw [hE]; positivity
  have hpK : 0 < L^K := rpow_pos_of_pos hL0 K
  have hp88 : 1 ≤ L^88 := one_le_pow₀ hL
  have hp : 1 ≤ L^(K+88) := one_le_rpow hL (by linarith)
  have hUVlower : 48*L^88 ≤ U*V := by
    have hl : log (48*L^88) ≤ (2*b)*L := by
      rw [log_mul (by norm_num) (by positivity), log_pow]
      norm_num
      linarith
    calc
      _ = exp (log (48*L^88)) := (exp_log (by positivity)).symm
      _ ≤ exp ((2*b)*L) := exp_le_exp.mpr hl
      _ = exp (b*L)*exp (b*L) := by rw [← exp_add]; congr 1; ring
      _ ≤ U*V := mul_le_mul hUlo hVlo (exp_pos _).le hU.le
  have hUV : 4 ≤ U*V := by nlinarith
  have hlogU : log U ≤ L := by simpa only [log_exp] using log_le_log hU hUhi
  have hlogV : log V ≤ L := by simpa only [log_exp] using log_le_log hV hVhi
  have hlogUV : log (U*V) ≤ 2*L := by rw [log_mul hU.ne' hV.ne']; linarith
  have hB := determinant_bound_le_three_rpow hL hK
  have hscale : max 1 (typeIIAdmissibleDeterminantBound L K : ℝ) ≤
      typeIISmoothDyadicScale U V E 0 := by
    have heq : typeIISmoothDyadicScale U V E 0 = U*V*L^K/16 := by
      simp only [typeIISmoothDyadicScale, pow_zero, mul_one]
      rw [hE, rpow_neg hL0.le]
      field_simp
    rw [heq]
    calc
      _ ≤ 3*L^(K+88) := max_le (by linarith) hB
      _ = (48*L^88)*L^K/16 := by rw [rpow_add hL0]; norm_num; ring
      _ ≤ U*V*L^K/16 := div_le_div_of_nonneg_right
        (mul_le_mul_of_nonneg_right hUVlower hpK.le) (by norm_num)
  have hupper : 24*U^2*V*L^88/E = 24*U*V*L^(K+88) := by
    rw [hE, rpow_add hL0, rpow_neg hL0.le]
    norm_num
    field_simp
  have hlogupper : log (24*U^2*V*L^88/E) ≤ 3*L := by
    rw [hupper, log_mul (by positivity) (by positivity),
      log_mul (by positivity) hV.ne', log_mul (by norm_num) hU.ne', log_rpow hL0]
    linarith
  have hBrough : (typeIIAdmissibleDeterminantBound L K : ℝ) ≤ exp (sqrt L) := by
    apply hB.trans
    have hl : log (3*L^(K+88)) ≤ sqrt L := by
      rw [log_mul (by norm_num) (by positivity), log_rpow hL0]
      linarith
    calc
      _ = exp (log (3*L^(K+88))) := (exp_log (by positivity)).symm
      _ ≤ _ := exp_le_exp.mpr hl
  have hrough : 2 ≤ exp (sqrt L) := by
    have hsqrt : 1 ≤ sqrt L := one_le_sqrt.mpr hL
    linarith [add_one_le_exp (sqrt L)]
  exact ⟨hU, hV, hE0, hUV, hlogUV, typeII_admissible_determinant_bound hL0 hU hE,
    hscale, hlogupper, hBrough, hrough⟩


end Bounty
end

section

/- Uniform Lyapunov rows for an original owner, paying one common atom bound per selected child. -/

open Finset Classical

namespace Bounty

section Owner
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
    [∀ g, DecidableEq (P g)] {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
    (Δ D : ∀ k c, A k c → Fin N → ℤ) (ω : ∀ k c, A k c → ℝ)
    (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ v vmin : ℝ) (V η : Fin N → ℝ) (β : ℝ)
    (steps : List (Option (J ⊕ K)))
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))

theorem full_mixed_common_uniform_forest_row_le
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hη : ∀ g, 0 ≤ η g) (hμatom : ∀ g p, μ g p ≤ η g)
    (hβ : 0 ≤ β)
    (hghostAtom : ∀ j g, (|(1 - q j) * V g / ρ| * η g) * v ≤ β)
    (hedgeAtom : ∀ g, η g ≤ β)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : ∀ g, vmin ≤ V g)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (t : ℕ) (tag : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P)) :
    let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
    (∑ e : FullPermutationMixedEvent n S B A Δ D tag s,
      |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V tag s e| *
        fullMixedCommonForestHistoryGain n S B A Δ D steps code t tag s e history *
        productLengthLyapunov v (fullPermutationMixedEventTarget n S B A Δ D tag s e)) ≤
      fullMixedCommonForestRowFactor M B steps code μ q ρ v vmin V T β t tag * productLengthLyapunov v s := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
  have hnonneg : 0 ≤ fullMixedCommonForestRowFactor M B steps code μ q ρ v vmin V T β t tag *
      productLengthLyapunov v s := mul_nonneg
    (full_mixed_common_forest_row_factor_nonneg M B steps code μ q ρ v vmin V T β hβ hρ1 (zero_lt_one.trans hv).le t tag)
    (productLengthLyapunov_nonneg (zero_lt_one.trans hv).le s)
  by_cases htlen : t < steps.length
  · by_cases htag : steps.get ⟨t, htlen⟩ = tag
    · have hb := full_mixed_common_owner_stage_row_le n S B A Δ D ω μ q ρ v vmin V η β steps code
        hω hωmass hμ hmass hη hμatom hghostAtom hedgeAtom hq0 hq1 hρ0 hρ1 hv hvmin hV hD T ht
        ⟨t, htlen⟩ tag htag s history
      simpa only [fullMixedCommonForestRowFactor, fullMixedCommonSelectedAt, dif_pos htlen] using hb
    · have hz : ∀ e : FullPermutationMixedEvent n S B A Δ D tag s,
          fullMixedCommonForestHistoryGain n S B A Δ D steps code t tag s e history = 0 := by
        intro e
        unfold fullMixedCommonForestHistoryGain
        rw [dif_pos htlen, if_neg htag]
      simpa only [hz, mul_zero, zero_mul, sum_const_zero] using hnonneg
  · have hz : ∀ e : FullPermutationMixedEvent n S B A Δ D tag s,
        fullMixedCommonForestHistoryGain n S B A Δ D steps code t tag s e history = 0 := by
      intro e
      unfold fullMixedCommonForestHistoryGain
      rw [dif_neg htlen]
    simpa only [hz, mul_zero, zero_mul, sum_const_zero] using hnonneg

end Owner
end Bounty
end

section

/- The original finite P cutoff may be enlarged exponentially on its unchanged spatial test. -/

open Finset Filter MeasureTheory

namespace Bounty

theorem eventually_sixteen_exp_add_one_le_exp {C : ℝ} (hC : 1 < C) :
    ∀ᶠ L : ℝ in atTop, 16*Real.exp L+1 ≤ Real.exp (C*L) := by
  filter_upwards [eventually_const_mul_exp_le_exp hC 17,eventually_ge_atTop (0 : ℝ)] with L hL hL0
  simp only [one_mul] at hL
  have he : 1 ≤ Real.exp L := Real.one_le_exp hL0
  linarith

theorem eventually_original_retained_Psupport_enlarge {c C : ℝ} (hc : 0 < c) (hC : 1 < C) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ) (R E : ℝ)
      (S : Finset ℕ) (G : ℕ → ℂ), (∀ u ∈ S, (u : ℝ) ≤ 16*Real.exp L) →
      ∀ (take : Fin ((candidateQIndices c L).card*r) → Bool)
        (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ),
      candidateRetainedAllocationIntegrand c L q r jStar R
        (candidateSmallPSet c L (16*Real.exp L+1)) take (candidateBoxFiniteTest L E S G) ξ =
      candidateRetainedAllocationIntegrand c L q r jStar R
        (candidateSmallPSet c L (Real.exp (C*L))) take (candidateBoxFiniteTest L E S G) ξ := by
  filter_upwards [eventually_candidate_retained_finite_test_enlarge hc,
    eventually_sixteen_exp_add_one_le_exp hC] with L henlarge hcut
  intro q r jStar R E S G hS take ξ
  have hh := henlarge q r jStar R E (16*Real.exp L) (Real.exp (C*L)-1) S G
    (by linarith) hS take ξ
  simpa only [sub_add_cancel] using hh

theorem eventually_original_retained_Psupport_integral_enlarge {c C : ℝ}
    (hc : 0 < c) (hC : 1 < C) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ) (R E T : ℝ)
      (S : Finset ℕ) (G : ℕ → ℂ), (∀ u ∈ S, (u : ℝ) ≤ 16*Real.exp L) →
      ∀ take : Fin ((candidateQIndices c L).card*r) → Bool,
      (∫ ξ, candidateRetainedAllocationIntegrand c L q r jStar R
        (candidateSmallPSet c L (16*Real.exp L+1)) take (candidateBoxFiniteTest L E S G) ξ
        ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) T) =
      ∫ ξ, candidateRetainedAllocationIntegrand c L q r jStar R
        (candidateSmallPSet c L (Real.exp (C*L))) take (candidateBoxFiniteTest L E S G) ξ
        ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) T := by
  filter_upwards [eventually_original_retained_Psupport_enlarge hc hC] with L heq
  intro q r jStar R E T S G hS take
  exact integral_congr_ae (Filter.Eventually.of_forall (heq q r jStar R E S G hS take))

end Bounty
end

section

/- Actual common forest edge phases leave untouched rows unchanged. For
affected rows their signed projected norm and memory symmetry are proved
from the prime family and the decoded event multiplier. -/

open Finset Classical
namespace Bounty

theorem physical_mixed_common_forest_event_untouched
    {I K S : Type} [Fintype S] {N J ell B : ℕ}
    {Ps : S → Finset ℕ} {P : Fin N → Finset ℕ}
    (C : Fin N → Finset (Fin J)) (k : ℤ) (steps : List (Option (I ⊕ K)))
    (code : BirthForestCode
      (Fintype.card (FullMixedCommonBirthAddress (fun _ : Fin N => J + ell) B steps)))
    (θ : (Fin (Fintype.card (FullMixedCommonBirthAddress (fun _ : Fin N => J + ell) B steps)) ×
      Fin (Fintype.card (FullMixedCommonBirthAddress (fun _ : Fin N => J + ell) B steps))) → ℝ)
    (encode : ((g : Fin N) × P g) → ℤ)
    (i : Fin steps.length) (tag : K) (hi : steps.get i = some (.inr tag))
    (hu : some i ∉ commonForestAffectedOperations (fun _ : Fin N => J + ell) B steps code)
    (a : PhysicalAuxLabels P C)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B))
    (e : PhysicalMixedCoefficientEvent C k a s) :
    physicalMixedCommonForestEventPhase C k steps code θ encode i tag hi a s e = 1 :=
  common_forest_observed_multiplier_eq_one _ _ _ _ _ _ _ _ hu

theorem physical_mixed_common_forest_action_untouched
    {I K S : Type} [Fintype S] [DecidableEq S] {N J ell B : ℕ}
    {Ps : S → Finset ℕ} {P : Fin N → Finset ℕ}
    (steps : List (Option (I ⊕ K)))
    (code : BirthForestCode
      (Fintype.card (FullMixedCommonBirthAddress (fun _ : Fin N => J + ell) B steps)))
    (θ : (Fin (Fintype.card (FullMixedCommonBirthAddress (fun _ : Fin N => J + ell) B steps)) ×
      Fin (Fintype.card (FullMixedCommonBirthAddress (fun _ : Fin N => J + ell) B steps))) → ℝ)
    (encode : ((g : Fin N) × P g) → ℤ)
    (i : Fin steps.length) (tag : K) (hi : steps.get i = some (.inr tag))
    (hu : some i ∉ commonForestAffectedOperations (fun _ : Fin N => J + ell) B steps code)
    (V : Fin N → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ) (Vs : S → ℝ) (q : ℝ)
    (probes : Fin N → Finset (Fin J)) (r t : Finset (Fin N)) (hrt : Disjoint r t)
    (Q : ℕ) (h ξ ζ η : ℝ) (k : ℤ) (initial : ∀ g, Finset (P g)) (Fs : ∀ g, Finset (Ps g))
    (f : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ) :
    physicalSmallBigJointAverage
      (physicalMixedPrimePatternAction V baseline ρ Vs q probes r t hrt Q h ξ k initial
        (fun c a y e => physicalMixedFullResidualPhase (repeatedBigPrimePatternCut probes r t c) ζ η k
          cleanMixedSourceGate (cleanMixedTargetGate Fs) a y e *
          physicalMixedCommonForestEventPhase (repeatedBigPrimePatternCut probes r t c) k
            steps code θ encode i tag hi a y e)
        (physicalSmallBigJointAverage f)) =
    physicalSmallBigJointAverage
      (physicalMixedPrimePatternAction V baseline ρ Vs q probes r t hrt Q h ξ k initial
        (fun c => physicalMixedFullResidualPhase (repeatedBigPrimePatternCut probes r t c) ζ η k
          cleanMixedSourceGate (cleanMixedTargetGate Fs)) (physicalSmallBigJointAverage f)) := by
  simp_rw [physical_mixed_common_forest_event_untouched _ _ steps code θ encode i tag hi hu, mul_one]

theorem exists_physical_mixed_common_forest_projected_bound
    {q vs : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hvs : 0 < vs) (ell : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (I K S : Type) [Fintype S] [DecidableEq S]
      (N : ℕ) (Ps : S → Finset ℕ) [∀ p : PhysicalPrime Ps, NeZero p.2.val]
      (P : Fin N → Finset ℕ) [∀ g (p : P g), NeZero p.val] (J B m : ℕ)
      (steps : List (Option (I ⊕ K)))
      (code : BirthForestCode
        (Fintype.card (FullMixedCommonBirthAddress (fun _ : Fin N => J + ell) B steps)))
      (θ : (Fin (Fintype.card (FullMixedCommonBirthAddress (fun _ : Fin N => J + ell) B steps)) ×
        Fin (Fintype.card (FullMixedCommonBirthAddress (fun _ : Fin N => J + ell) B steps))) → ℝ)
      (encode : ((g : Fin N) × P g) → ℤ)
      (i : Fin steps.length) (tag : K) (hi : steps.get i = some (.inr tag))
      (V : Fin N → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ) (Vs : S → ℝ)
      (probes : Fin N → Finset (Fin J)) (r t : Finset (Fin N)) (hrt : Disjoint r t),
      (∀ g, (probes g).card ≤ m) → ∀ (Q : ℕ) (h ξ ζ η : ℝ), 0 < ξ →
      ∀ (k : ℤ) (initial : ∀ g, Finset (P g)) (Fs : ∀ g, Finset (Ps g)),
      (∀ s, vs ≤ Vs s) → (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) →
      (∀ g p, 1 / 2 ≤ baseline g p ∧ baseline g p ≤ 1) →
      ∀ (v vmin vmax : ℝ), 0 < ρ → ρ < 1 → 1 < v → 0 < vmin →
      (∀ g, vmin ≤ V g) → (∀ g, V g ≤ vmax) →
      ∀ f : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ,
      (∀ s, ProductMemorySymmetric (fun x => f (s,x))) →
      let μ := fun g => tiltedPhysicalBirthLaw V g (baseline g)
      let W := productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))
      let F := physicalSmallBigJointAverage
        (physicalMixedPrimePatternAction V baseline ρ Vs q probes r t hrt Q h ξ k initial
          (fun c a y e => physicalMixedFullResidualPhase (repeatedBigPrimePatternCut probes r t c) ζ η k
            cleanMixedSourceGate (cleanMixedTargetGate Fs) a y e *
            physicalMixedCommonForestEventPhase (repeatedBigPrimePatternCut probes r t c) k
              steps code θ encode i tag hi a y e) (physicalSmallBigJointAverage f))
      (∀ s, ProductMemorySymmetric (fun x => F (s,x))) ∧
      cleanActiveNorm (physicalSmallBigMeasure Vs W) F ≤
        repeatedBigFamilyEnvelope N m Q ξ * A ^ Fintype.card S *
          Real.sqrt (unrestrictedEdgeEnergyBound ρ v vmin vmax (ell + m) ^ N) *
            cleanActiveNorm (physicalSmallBigMeasure Vs W) f := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_mixed_prime_pattern_projected_norm_bound hq0 hq1 hvs ell
  refine ⟨A, hA, ?_⟩
  intro I K S _ _ N Ps _ P _ J B m steps code θ encode i tag hi V baseline ρ Vs probes r t hrt
    hp Q h ξ ζ η hξ k initial Fs hVs hMass hbaseline v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi f hf μ W F
  refine ⟨physical_mixed_common_forest_prime_projected_memory_symmetric steps code θ encode i tag hi
    V baseline ρ Vs q probes r t hrt Q h ξ ζ η k initial Fs f hf, ?_⟩
  simpa only [Fintype.card_fin] using hbound S (Fin N) Ps P J B m V baseline ρ Vs probes r t hrt
    hp Q h ξ hξ k initial hVs hMass hbaseline v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi
    (fun c a y e => physicalMixedFullResidualPhase (repeatedBigPrimePatternCut probes r t c) ζ η k
      cleanMixedSourceGate (cleanMixedTargetGate Fs) a y e *
      physicalMixedCommonForestEventPhase (repeatedBigPrimePatternCut probes r t c) k
        steps code θ encode i tag hi a y e)
    (fun c a y e => physical_mixed_common_forest_residual_norm_le_one steps code θ encode i tag hi
      (repeatedBigPrimePatternCut probes r t c) ζ η k Fs a y e) f hf

end Bounty
