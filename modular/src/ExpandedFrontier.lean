    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hq0 : ∀ i j, 0 ≤ q i j) (hqmax : ∀ i j, q i j ≤ qmax)
    (T : ℕ) (ht : ∀ i k g, (S i k g)ᶜ.card ≤ T)
    {L R : ℝ} (hL : 1 ≤ L) (hR : 0 ≤ R)
    (hgroups : (Fintype.card G : ℝ) ≤ R * Real.log L)
    (steps : I → List (Option (J ⊕ K)))
    (allowed : ∀ i s, FullPermutationMixedPath (fun g (p : P g) => p.val)
      (S i) B (A i) (Δ i) (D i) (steps i) s → Prop)
    (phase : ∀ i s, FullPermutationMixedPath (fun g (p : P g) => p.val)
      (S i) B (A i) (Δ i) (D i) (steps i) s → ℂ)
    (coeffBound : I → ℝ) (hcoeffBound : ∀ i, 0 ≤ coeffBound i)
    (hphase : ∀ i s p, ‖phase i s p‖ ≤ coeffBound i)
    (patterns : Finset I)
    (N : ℕ) (hlength : ∀ i ∈ patterns, ((steps i).filterMap id).length ≤ N)
    {H : ℝ} (hH : ∑ i ∈ patterns, coeffBound i ≤ H)
    (f : ProductBoundedOrderedState (fun g => P g)
      (fun g => UnrestrictedResidueParticle (fun p : P g => p.val)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    let _ : ∀ g (p : P g), NeZero p.val := fun g p => ⟨Nat.ne_of_gt (hpositive g p)⟩
    let ρ := physicalGhostRhoChoice qmax
    let v := physicalGhostWeightChoice qmax vmax
    finiteWeightedEnergy
      (productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (baseline g))
        (fun g => unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g (baseline g))))
      (fun s => ∑ i ∈ patterns,
        fullPermutationMixedPathAction (fun g (p : P g) => p.val) (S i) B (A i) (Δ i) (D i) (ω i)
          (fun g => tiltedPhysicalBirthLaw V g (baseline g)) (q i) ρ V (steps i)
          (fun x p => if allowed i x p then phase i x p else 0) f s) ≤
    H ^ 2 * L ^ ((N : ℝ) * R * Real.log (mixedMemoryUniformEnergy ρ v vmin vmax T)) *
      finiteWeightedEnergy
        (productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (baseline g))
          (fun g => unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g (baseline g)))) f := by
  let _ : ∀ g (p : P g), NeZero p.val := fun g p => ⟨Nat.ne_of_gt (hpositive g p)⟩
  obtain ⟨hρ0, hρ1, hgap, hv, hthreshold, hconditions⟩ :=
    physical_ghost_parameter_choice (Vmax := vmax) hqmax0 hqmax1
  apply tilted_full_pattern_bounded_phase_energy_le_rpow P V baseline hpositive hMass hbaseline
    S B A Δ D ω q hω hωmass hρ0 hρ1 hv hvmin hVlo hVhi hq0
    (fun i j => (hqmax i j).trans hqmax1.le) _ _ T ht hL hR hgroups
    steps allowed phase coeffBound hcoeffBound hphase patterns N hlength hH f hf
  · intro i j
    simpa only [one_mul, mul_one] using
      (physical_ghost_scaled_damping_lt_one (hq0 i j) (hqmax i j) hgap hρ0 hρ1 hthreshold
        (a := 1) (W := 1) (by norm_num) zero_le_one (le_max_left 1 vmax)).le
  · intro i j g
    exact (hconditions (q i j) (V g) (hq0 i j) (hqmax i j)
      (hvmin.trans_le (hVlo g)).le (hVhi g)).2.1

