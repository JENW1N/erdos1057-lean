section

/- Integrate the conditional retained harmonic estimate over the actual frequency boxes. -/

open Finset Filter MeasureTheory Real

namespace Bounty

theorem exists_candidate_finite_mixed_bound_of_harmonic {c b A D Bwin : ℝ}
    (hc : 0 < c) (hb : 0 < b) (hBwin : 0 ≤ Bwin) {r : ℕ} (hr : 6 ≤ r) :
    ∃ Kmin : ℝ, 0 < Kmin ∧ ∀ K : ℝ, Kmin ≤ K →
      ∃ Q F : ℝ, 0 < Q ∧ 0 < F ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (jStar : ℕ), jStar ∈ candidateQIndices c L →
      ∀ (U V T : ℝ) (M N : Finset ℕ) (α β : ℕ → ℂ),
      exp (b*L) ≤ U → U ≤ exp L → exp (b*L) ≤ V → V ≤ exp L →
      2*U*V ≤ 17*exp L →
      (∀ m ∈ M, (m:ℝ) ∈ Set.Icc U (2*U)) →
      (∀ n ∈ N, (n:ℝ) ∈ Set.Icc V (2*V)) →
      (∀ m, m ∉ M → α m = 0) → (∀ n, n ∉ N → β n = 0) →
      (∀ m ∈ M, ‖α m‖ ≤ L^A) → (∀ n ∈ N, ‖β n‖ ≤ L^A) →
      (∀ m ∈ M, α m ≠ 0 → ∀ p ∈ m.primeFactors, exp (sqrt L) < (p:ℝ)) →
      (∀ ν : ℝ, ‖ν‖ ≤ T →
        ∀ take : Fin ((candidateQIndices c L).card*r) → Bool,
        (∀ i, candidateAllocationActive c L r jStar i = false → take i = false) →
        ∀ ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ,
        (∀ i, ‖ξ i‖ ≤ L) →
        ∀ k ∈ Icc (-(typeIIAdmissibleDeterminantBound L K:ℤ)) (typeIIAdmissibleDeterminantBound L K),
        k ≠ 0 → ∀ j ∈ range (typeIISmoothDyadicCount L),
        ∀ χ : DirichletCharacter ℂ (2*k.natAbs), ∀ ζ : EuclideanSpace ℝ (Fin 3), ‖ζ‖ ≤ L^F →
        ‖candidateB0HarmonicCorrelation c L (1/2) r jStar
          (candidateSmallPSet c L (17*exp L+1)) take
          (candidateAllocationFourierTwist c L r jStar take ξ) ν
          (typeIISmoothDyadicScale U V (U*L^(-K)) j) k M α χ ζ‖ ≤ L^(-Q)) →
      ‖∫ ν in {ν : ℝ | ‖ν‖ ≤ T},
        candidateFiniteMixedMellinIntegrand c L (1/2) r jStar (U*L^(-K)) Bwin 17
          (Icc 1 ⌊17*exp L⌋₊) (fun u m => α m*β ((2*u+1)/m)) ν‖ ≤ exp L*L^(-D) := by
  classical
  obtain ⟨Cf, hCf, hvariation⟩ := exists_candidate_mixed_fourier_variation_bound hc hBwin r
  obtain ⟨Kmin, hKmin, hpoint⟩ :=
    exists_candidate_B0_bound_of_harmonic (A := A) (D := 2*(D+Cf+2)) hc hb hr
  refine ⟨Kmin, hKmin, ?_⟩
  intro K hK
  obtain ⟨Q, F, hQ, hF, hpoint⟩ := hpoint K hK
  refine ⟨Q, F, hQ, hF, ?_⟩
  filter_upwards [hpoint, hvariation, eventually_ge_atTop (17:ℝ)] with L hpoint hvariation hL
  intro jStar hj U V T M N α β hUlo hUhi hVlo hVhi hcoarse
    hM hN hαsupport hβsupport hα hβ hrough hcorr
  have hL0 : 0 < L := by linarith
  have hU : 0 < U := (exp_pos _).trans_le hUlo
  have hV : 0 < V := (exp_pos _).trans_le hVlo
  have hscalar : 0 ≤ 2*U*V*L^(-(2*(D+Cf+2))/2) := by positivity
  have hi := candidate_finite_mixed_mellin_norm_le_box_variation
    c L (1/2) r jStar (U*L^(-K)) Bwin 17 (Icc 1 ⌊17*exp L⌋₊)
    (fun u m => α m*β ((2*u+1)/m)) T hscalar (by
      intro ν hν take htake ξ hξ
      have hinactive : candidateAllocationActive c L r jStar
          ((candidateAllocationOrder c L r).symm
            (candidateRoughSlot c L r jStar (by omega) hj)) = false := by
        simp only [candidateAllocationActive, Equiv.apply_symm_apply, candidateRoughSlot,
          and_self, not_true_eq_false, decide_false]
      have hs := hpoint jStar hj take (htake _ hinactive) ξ ν 17 U V
        hUlo hUhi hVlo hVhi hcoarse
        (candidateSmallPSet c L (17*exp L+1)) M N α β
        (fun p hp => Nat.pos_of_ne_zero (candidate_small_P_set_nonzero hp))
        hM hN hαsupport hβsupport hα hβ hrough (hcorr ν hν take htake ξ hξ)
      simpa only [candidateFiniteCoarseMellinTest, typeIIMellinPhase] using hs)
  have hexp : -(2*(D+Cf+2))/2+Cf = -D-2 := by ring
  have hpow : L^(-D-2)*L^(2 : ℝ) = L^(-D) := by
    rw [← rpow_add hL0]
    congr 1
    ring
  have h17 : (17:ℝ) ≤ L^(2 : ℝ) := by
    rw [rpow_two]
    nlinarith
  calc
    _ ≤ (2*U*V*L^(-(2*(D+Cf+2))/2))*
        candidateMixedFourierVariation c L r jStar Bwin L T := hi
    _ ≤ (2*U*V*L^(-(2*(D+Cf+2))/2))*L^Cf :=
      mul_le_mul_of_nonneg_left (hvariation jStar L T) hscalar
    _ = (2*U*V)*L^(-D-2) := by
      rw [mul_assoc, ← rpow_add hL0, hexp]
    _ ≤ (17*exp L)*L^(-D-2) :=
      mul_le_mul_of_nonneg_right hcoarse (rpow_nonneg hL0.le _)
    _ ≤ (L^2*exp L)*L^(-D-2) :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right h17 (exp_pos L).le)
        (rpow_nonneg hL0.le _)
    _ = exp L*L^(-D) := by
      rw [← hpow]
      ring


end Bounty
