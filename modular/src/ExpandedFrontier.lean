section

/- Common forest stage factors at the original ghost, edge, and birth-free permutation events. -/

open Classical Finset
namespace Bounty
section Gain
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K)))
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))

theorem full_mixed_common_forest_history_gain_tagged (u : Fin steps.length)
    (tag : Option (J ⊕ K)) (htag : steps.get u = tag)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag s)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P)) :
    fullMixedCommonForestHistoryGain n S B A Δ D steps code u.val tag s e history =
      if birthForestStageCondition (fullMixedCommonIndexStage M B steps) u.succ
        (fullMixedCommonHistoryWrite n S B A Δ D steps u s
          (fullMixedTaggedOwnerEvent n S B A Δ D steps u tag htag s e) history) code then 1 else 0 := by
  subst tag
  exact full_mixed_common_forest_history_gain_owner n S B A Δ D steps code u s e history

theorem full_mixed_common_none_owner_empty (u : Fin steps.length) (htag : steps.get u = none)
    (i : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps))) :
    fullMixedCommonIndexStage M B steps i ≠ u.succ := by
  intro hi
  obtain ⟨a, _⟩ := (full_mixed_common_index_stage_succ_iff M B steps u i).mp hi
  have hempty : ∀ a : FullMixedCommonLocalAddress M B (steps.get u), False := by
    rw [htag]
    intro a
    exact Fin.elim0 a.2
  exact hempty a

theorem full_mixed_common_none_selected_count (u : Fin steps.length) (htag : steps.get u = none)
    (g : Fin N) : fullMixedCommonSelectedCount M B steps code u g = 0 := by
  apply card_eq_zero.mpr
  apply filter_eq_empty_iff.mpr
  intro i _ hi
  exact full_mixed_common_none_owner_empty B steps u htag i hi.1

theorem full_mixed_common_forest_history_gain_none (u : Fin steps.length) (htag : steps.get u = none)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D none s)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P)) :
    fullMixedCommonForestHistoryGain n S B A Δ D steps code u.val none s e history = 1 := by
  rw [full_mixed_common_forest_history_gain_tagged n S B A Δ D steps code u none htag]
  apply if_pos
  intro i hi
  exact False.elim (full_mixed_common_none_owner_empty B steps u htag i hi)
end Gain
end Bounty
