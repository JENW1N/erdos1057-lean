theorem circle_rational_norm_ge {a : ℤ} {r : ℕ} (hr : 0 < r)
    (hdiv : ¬(r : ℤ) ∣ a) :
    1 / (r : ℝ) ≤ ‖(((a : ℝ) / (r : ℝ) : ℝ) : UnitAddCircle)‖ := by
  have hrR : (0 : ℝ) < r := by exact_mod_cast hr
  let k : ℤ := round ((a : ℝ) / r)
  have hn : a - k * r ≠ 0 := by
    intro h
    apply hdiv
    refine ⟨k, ?_⟩
    linarith
  have hnR : (1 : ℝ) ≤ |((a - k * r : ℤ) : ℝ)| := by
    exact_mod_cast (show (1 : ℤ) ≤ |a - k * r| by
      have hp : (0 : ℤ) < |a - k * r| := abs_pos.mpr hn
      omega)
  rw [UnitAddCircle.norm_eq]
  change 1 / (r : ℝ) ≤ |(a : ℝ) / r - k|
  have he : ((a - k * r : ℤ) : ℝ) = ((a : ℝ) / r - k) * r := by
    push_cast
    field_simp
  rw [he, abs_mul, abs_of_pos hrR] at hnR
  exact (div_le_iff₀ hrR).mpr hnR

theorem circle_perturbation_lower (x e : ℝ) :
    ‖(x : UnitAddCircle)‖ - |e| ≤ ‖((x + e : ℝ) : UnitAddCircle)‖ := by
  have ht := norm_sub_le (x + e : UnitAddCircle) (e : UnitAddCircle)
  have he : ‖(e : UnitAddCircle)‖ ≤ |e| := by
    simpa only [Real.norm_eq_abs] using
      (QuotientAddGroup.norm_mk_le_norm (m := e) (S := AddSubgroup.zmultiples (1 : ℝ)))
  have heq : (x + e : UnitAddCircle) - (e : UnitAddCircle) = (x : UnitAddCircle) := by
    abel
  rw [heq] at ht
  rw [AddCircle.coe_add]
  linarith

theorem rational_perturbed_phase_separation {u h : ℤ} {r : ℕ}
    (hr : 0 < r) (hdiv : ¬(r : ℤ) ∣ u * h)
    {β : ℝ} (hβ : |β| ≤ 1 / (r : ℝ) ^ 2)
    (hh : |(h : ℝ)| ≤ (r : ℝ) / 2) :
    1 / (2 * (r : ℝ)) ≤
      ‖((((u : ℝ) / r + β) * h : ℝ) : UnitAddCircle)‖ := by
  have hrR : (0 : ℝ) < r := by exact_mod_cast hr
  have he : |β * (h : ℝ)| ≤ 1 / (2 * (r : ℝ)) := by
    rw [abs_mul]
    calc
      _ ≤ (1 / (r : ℝ) ^ 2) * ((r : ℝ) / 2) :=
        mul_le_mul hβ hh (abs_nonneg _) (by positivity)
      _ = _ := by field_simp
  have hrat := circle_rational_norm_ge hr hdiv
  have hp := circle_perturbation_lower (((u * h : ℤ) : ℝ) / r) (β * h)
  have ha : ((u : ℝ) / r + β) * h = ((u * h : ℤ) : ℝ) / r + β * h := by
    push_cast
    ring
  rw [ha]
  have hc : 1 / (r : ℝ) - 1 / (2 * (r : ℝ)) = 1 / (2 * (r : ℝ)) := by
    field_simp
    ring
  linarith

theorem coprime_rational_phase_separation {u h : ℤ} {r : ℕ}
    (hr : 0 < r) (hcop : (r : ℤ).gcd u = 1) (hh0 : h ≠ 0)
    {β : ℝ} (hβ : |β| ≤ 1 / (r : ℝ) ^ 2)
    (hh : |(h : ℝ)| ≤ (r : ℝ) / 2) :
    1 / (2 * (r : ℝ)) ≤
      ‖((((u : ℝ) / r + β) * h : ℝ) : UnitAddCircle)‖ := by
  apply rational_perturbed_phase_separation hr _ hβ hh
  intro hdiv
  have hd : (r : ℤ) ∣ h := Int.dvd_of_dvd_mul_right_of_gcd_one hdiv hcop
  have ha : (r : ℤ) ≤ |h| := Int.le_of_dvd (abs_pos.mpr hh0) ((dvd_abs _ _).mpr hd)
  have hrR : (0 : ℝ) < r := by exact_mod_cast hr
  have haR : (r : ℝ) ≤ |(h : ℝ)| := by exact_mod_cast ha
  linarith
end

