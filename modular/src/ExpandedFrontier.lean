section

/- Original determinant and Fourier ranges imply the polynomial integral parameter bounds. -/

open Finset Filter
namespace Bounty

theorem eventually_original_harmonic_modulus_bound {K : ℝ} (hK : 0 ≤ K) :
    ∀ᶠ L : ℝ in atTop, ∀ k ∈ Icc
      (-(typeIIAdmissibleDeterminantBound L K : ℤ)) (typeIIAdmissibleDeterminantBound L K : ℤ),
      ((2*k.natAbs : ℕ) : ℝ) ≤ L^(K+89) := by
  filter_upwards [eventually_ge_atTop (6 : ℝ)] with L hL
  intro k hk
  have hL1 : 1 ≤ L := by linarith
  have hL0 : 0 < L := by linarith
  have hkNat : k.natAbs ≤ typeIIAdmissibleDeterminantBound L K := by
    have hh := mem_Icc.mp hk
    omega
  have hB := determinant_bound_le_three_rpow_public hL1 hK
  calc
    _ = 2*(k.natAbs : ℝ) := by push_cast; rfl
    _ ≤ 2*(3*L^(K+88)) := mul_le_mul_of_nonneg_left ((Nat.cast_le.mpr hkNat).trans hB) (by norm_num)
    _ = 6*L^(K+88) := by ring
    _ ≤ L*L^(K+88) := mul_le_mul_of_nonneg_right hL (by positivity)
    _ = L^(K+89) := by
      conv_lhs => lhs; rw [← Real.rpow_one L]
      rw [← Real.rpow_add hL0]
      congr 1
      ring

theorem eventually_original_endpoint_phase_bounds (T F : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (ν : ℝ) (ζ : EuclideanSpace ℝ (Fin 3)),
      ‖ν‖ ≤ L^T → ‖ζ‖ ≤ L^F →
      |2*Real.pi*ν| ≤ L^(max T F+1) ∧
      ∀ i : Fin 3,
        |2*Real.pi*ν+2*Real.pi*ζ i| ≤ L^(max T F+1) ∧
        |2*Real.pi*ν-2*Real.pi*ζ i| ≤ L^(max T F+1) := by
  filter_upwards [eventually_ge_atTop (max 1 (4*Real.pi))] with L hL
  intro ν ζ hν hζ
  have hL1 : 1 ≤ L := (le_max_left _ _).trans hL
  have hL0 : 0 < L := zero_lt_one.trans_le hL1
  have hLpi : 4*Real.pi ≤ L := (le_max_right _ _).trans hL
  have hν' : |ν| ≤ L^(max T F) := by
    have hn : |ν| ≤ L^T := by simpa only [Real.norm_eq_abs] using hν
    exact hn.trans (Real.rpow_le_rpow_of_exponent_le hL1 (le_max_left _ _))
  have hζ' (i : Fin 3) : |ζ i| ≤ L^(max T F) := by
    have hz : |ζ i| ≤ ‖ζ‖ := by simpa only [Real.norm_eq_abs] using PiLp.norm_apply_le ζ i
    exact hz.trans (hζ.trans (Real.rpow_le_rpow_of_exponent_le hL1 (le_max_right _ _)))
  have hpi : 0 ≤ 2*Real.pi := by positivity
  have hcap : (4*Real.pi)*L^(max T F) ≤ L^(max T F+1) := by
    calc
      _ ≤ L*L^(max T F) := mul_le_mul_of_nonneg_right hLpi (by positivity)
      _ = _ := by rw [Real.rpow_add hL0,Real.rpow_one]; ring
  have hνbound : |2*Real.pi*ν| ≤ (2*Real.pi)*L^(max T F) := by
    rw [abs_mul,abs_of_nonneg hpi]
    exact mul_le_mul_of_nonneg_left hν' hpi
  refine ⟨(hνbound.trans ?_).trans hcap, ?_⟩
  · exact mul_le_mul_of_nonneg_right (by linarith [Real.pi_pos]) (by positivity)
  · intro i
    have hzbound : |2*Real.pi*ζ i| ≤ (2*Real.pi)*L^(max T F) := by
      rw [abs_mul,abs_of_nonneg hpi]
      exact mul_le_mul_of_nonneg_left (hζ' i) hpi
    constructor
    · exact ((abs_add_le _ _).trans (by linarith [hνbound,hzbound])).trans hcap
    · exact ((abs_sub _ _).trans (by linarith [hνbound,hzbound])).trans hcap

end Bounty
end

section

/- A group-uniform threshold for the actual harmonic energy prefactor. -/

open Filter Finset
open scoped Classical
namespace Bounty

theorem eventually_physical_harmonic_energy_polynomial {A s : ℝ}
    (hA : 0 ≤ A) (hs : 0 ≤ s) :
    ∀ᶠ L : ℝ in atTop, ∀ (G : Type*) [Fintype G] (P : G → Finset ℕ) (J : ℕ)
      (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C),
      (∀ g p, p ∈ P g → p.Prime) →
      (∀ g p, p ∈ P g → Real.log (p : ℝ) ≤ L^s) →
      (J*Fintype.card G : ℕ) ≤ A*Real.log L →
      ∀ Z : ℝ, 0 < Z → 1 ≤ Z*(physicalFreeFactor C aux : ℝ) →
      3*Z < Real.exp (4*L) →
      2*((⌈3*Z*(physicalFreeFactor C aux : ℝ)⌉₊ : ℝ)/(Z*(physicalFreeFactor C aux : ℝ)/2))*
        (1+Real.log (⌈3*Z*(physicalFreeFactor C aux : ℝ)⌉₊ : ℝ))^15 ≤
        L^(15*(max 1 s+1)+1) := by
  filter_upwards [eventually_ge_atTop (1 : ℝ),
    eventually_ge_atTop (16*(5+Real.log 4+A)^15)] with L hL hcost
  intro G _ P J C aux hprime hplog hslots Z hZ hprod hcut
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hp : ∀ g p, p ∈ P g → (p : ℝ) ≤ Real.exp (L^s) := by
    intro g p hp
    apply (Real.log_le_iff_le_exp (by exact_mod_cast (hprime g p hp).pos)).mp
    exact hplog g p hp
  have hlog := physical_harmonic_log_bound_of_original_cutoff C aux hprime
    (Real.rpow_nonneg hL0.le _) hZ hp hprod hcut
  have hslot : L^s*((J*Fintype.card G : ℕ) : ℝ) ≤ A*L^s*Real.log L := by
    simpa only [mul_assoc, mul_left_comm] using
      mul_le_mul_of_nonneg_left hslots (Real.rpow_nonneg hL0.le s)
  have hlog' : Real.log (⌈3*Z*(physicalFreeFactor C aux : ℝ)⌉₊ : ℝ) ≤
      Real.log 4+4*L+A*L^s*Real.log L := by linarith
  have hN : 1 ≤ (⌈3*Z*(physicalFreeFactor C aux : ℝ)⌉₊ : ℝ) := by
    have hh : 1 ≤ 3*Z*(physicalFreeFactor C aux : ℝ) := by nlinarith [hprod]
    exact hh.trans (Nat.le_ceil _)
  have hr : (⌈3*Z*(physicalFreeFactor C aux : ℝ)⌉₊ : ℝ)/(Z*(physicalFreeFactor C aux : ℝ)/2) ≤ 8 := by
    simpa only [mul_assoc] using (harmonic_ceiling_scale_bounds hprod).2.1
  exact harmonic_energy_scalar_polynomial hA hs hL hcost hN hr hlog'

end Bounty
end

section

/- The total logarithmic cost of subexponential prime labels is sublinear. -/

open Filter
namespace Bounty

theorem eventually_scaled_log_sublinear {A s ε : ℝ}
    (hA : 0 ≤ A) (hs : s < 1) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, A*L^s*Real.log L ≤ ε*L := by
  have hsmall := ((isLittleO_log_rpow_atTop (sub_pos.mpr hs)).const_mul_left A).bound hε
  filter_upwards [hsmall, eventually_ge_atTop (1 : ℝ)] with L hb hL
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hn : A*Real.log L ≤ ε*L^(1-s) := by
    simpa only [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hA (Real.log_nonneg hL)),
      abs_of_nonneg (Real.rpow_nonneg hL0.le (1-s))] using hb
  calc
    _ = L^s*(A*Real.log L) := by ring
    _ ≤ L^s*(ε*L^(1-s)) := mul_le_mul_of_nonneg_left hn (Real.rpow_nonneg hL0.le s)
    _ = ε*(L^s*L^(1-s)) := by ring
    _ = ε*L := by
      rw [← Real.rpow_add hL0]
      have he : s+(1-s) = (1 : ℝ) := by ring
      rw [he, Real.rpow_one]

end Bounty
end

section

/- The complete original small walk and vertex factor is an exact product
of local bare edge factors and the two translated endpoint weights. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_small_vertex_walk_edges
    {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    (groups : Finset (Fin N)) (patterns : Finset I)
    (C : I → Fin N → Finset (Fin J)) (V : Fin N → ℝ)
    {q : ℝ} (hq : 0 ≤ q) (k : ℕ → I → ℤ)
    (L : PhysicalMarkLists P J ell)
    (p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)
    (r : PhysicalGroupResidues P groups) :
    physicalBareWalkScalar (fun g : ↥groups => V g.val) patterns
      (fun i g => C i g.val) (fun _ _ => 0) (fun _ _ _ _ _ => 1)
      (fun j => physicalRestrictedEdge (fun g => g ∈ groups) patterns C (finitePathLabels p j))
      (fun j g => finitePathMarks L p j g.val) (n + 1) *
      (physicalGroupFiniteVertexWeight groups C q k L p r : ℂ) =
    ∏ j : Fin (n + 1),
      physicalBareLabeledScalar (fun g : ↥groups => V g.val) patterns
        (fun i g => C i g.val) (fun _ => 0) (fun _ _ _ _ => 1)
        (physicalRestrictedEdge (fun g => g ∈ groups) patterns C (p j).1)
        (fun g => finitePathMarks L p j.val g.val)
        (fun g => finitePathMarks L p (j.val + 1) g.val) *
      ((physicalResidueVertexWeight
          (fun g : ↥groups => physicalPermuteLabels (p j).1.1
            (finitePathMarks L p j.val) g.val) (Real.sqrt q)
          (physicalTranslateResidues (physicalGroupResidueVector r)
            (physicalPathSelectedOffset C k L p j.castSucc)) *
        physicalResidueVertexWeight
          (fun g : ↥groups => physicalPermuteLabels (p j).1.2.1
            (finitePathMarks L p (j.val + 1)) g.val) (Real.sqrt q)
          (physicalTranslateResidues (physicalGroupResidueVector r)
            (physicalPathSelectedOffset C k L p j.succ)) : ℝ) : ℂ) := by
  rw [physical_group_finite_vertex_weight_edges groups C hq k L p r]
  rw [Complex.ofReal_prod, physicalBareWalkScalar, ← Fin.prod_univ_eq_prod_range,
    ← Finset.prod_mul_distrib]
  apply prod_congr rfl
  intro j _
  simp only [finitePathLabels, dif_pos j.isLt]

end Bounty
end

section

/- The chronological record recovers every original big-edge displacement
and thus any function of the cumulative selected offsets. -/

open Finset
open scoped Classical
namespace Bounty
section Record
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (cut : ℕ → Fin N → Finset (Fin J))

noncomputable def physicalActiveDisplacement (j : Fin n)
    (s : (g : Fin N) → Fin (J + ell) → ↥(P g)) (a : PhysicalAuxLabels P (C j)) : ℤ :=
  if hs : ∀ g, Function.Injective (s g) then
    k j * (physicalD (C j) (physicalActiveMarkLabels (cut (4 * j.val + 2)) s hs) a : ℤ)
  else 0

noncomputable def physicalObservedDisplacement (j : Fin n)
    (o : PhysicalMarkObservation P ell C)
    (s : (g : Fin N) → Fin (J + ell) → ↥(P g)) : ℤ :=
  if h : ∃ a : PhysicalAuxLabels P (C j), o = .inr (some ⟨j, a⟩) then
    physicalActiveDisplacement C k cut j s h.choose
  else 0

noncomputable def physicalRecordDisplacement
    (r : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C)) (j : Fin n) : ℤ :=
  match r[4 * j.val + 1]?, r[4 * j.val + 2]? with
  | some s, some t => physicalObservedDisplacement C k cut j t.2.1
      (fun g => (s.2.2.2 g).1)
  | _, _ => 0

theorem physical_observed_displacement_aux (j : Fin n) (a : PhysicalAuxLabels P (C j))
    (s : (g : Fin N) → Fin (J + ell) → ↥(P g)) :
    physicalObservedDisplacement C k cut j (.inr (some ⟨j, a⟩)) s =
      physicalActiveDisplacement C k cut j s a := by
  have h : ∃ b : PhysicalAuxLabels P (C j),
      (Sum.inr (some ⟨j, a⟩) : PhysicalMarkObservation P ell C) = .inr (some ⟨j, b⟩) := ⟨a, rfl⟩
  unfold physicalObservedDisplacement
  rw [dif_pos h]
  have he : h.choose = a := by
    exact (eq_of_heq (Sigma.mk.inj_iff.mp (Option.some.inj (Sum.inr.inj h.choose_spec))).2).symm
  rw [he]

theorem physical_active_displacement_encode (j : Fin n)
    (L : PhysicalMarkLists P J ell) (a : PhysicalAuxLabels P (C j)) :
    physicalActiveDisplacement C k cut j
      (fun g i => L g (physicalFullSlotIndex (cut (4 * j.val + 2) g) i)) a =
      k j * (physicalD (C j) L a : ℤ) := by
  have hL : ∀ g, Function.Injective
      (fun i => L g (physicalFullSlotIndex (cut (4 * j.val + 2) g) i)) :=
    fun g => (L g).injective.comp (physicalFullSlotIndex (cut (4 * j.val + 2) g)).injective
  simp only [physicalActiveDisplacement, dif_pos hL, physical_active_mark_labels_encode]

theorem physical_record_displacement_decoded
    (o : ℕ → PhysicalMarkObservation P ell C)
    (t : ℕ → PhysicalBoundedMarkState P J ell B)
    (r : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C))
    (hlen : r.length = 4 * n + 1)
    (ho : ∀ (i : ℕ) (hi : i < r.length), (r.get ⟨i, hi⟩).2.1 = o i)
    (ht : ∀ (i : ℕ) (hi : i < r.length), (r.get ⟨i, hi⟩).2.2 =
      physicalBoundedMarkEncode (cut (i + 1)) (t i))
    (a : ∀ j, PhysicalAuxLabels P (C j))
    (ha : ∀ j, o (4 * j.val + 2) = .inr (some ⟨j, a j⟩)) (j : Fin n) :
    physicalRecordDisplacement C k cut r j =
      k j * (physicalD (C j) (t (4 * j.val + 1)).1 (a j) : ℤ) := by
  have h1 : 4 * j.val + 1 < r.length := by omega
  have h2 : 4 * j.val + 2 < r.length := by omega
  unfold physicalRecordDisplacement
  rw [List.getElem?_eq_getElem h1, List.getElem?_eq_getElem h2]
  change physicalObservedDisplacement C k cut j (r.get ⟨_, h2⟩).2.1
    (fun g => ((r.get ⟨_, h1⟩).2.2.2 g).1) = _
  rw [ho _ h2, ha j, physical_observed_displacement_aux, ht _ h1]
  exact physical_active_displacement_encode C k cut j _ _

theorem physical_coherent_selected_cumulative_offset
    (o : ℕ → PhysicalMarkObservation P ell C)
    (t : ℕ → PhysicalBoundedMarkState P J ell B)
    (r : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C))
    (h : PhysicalFineHistoryCoherent C o t) (hlen : r.length = 4 * n + 1)
    (ho : ∀ (i : ℕ) (hi : i < r.length), (r.get ⟨i, hi⟩).2.1 = o i)
    (ht : ∀ (i : ℕ) (hi : i < r.length), (r.get ⟨i, hi⟩).2.2 =
      physicalBoundedMarkEncode (cut (i + 1)) (t i))
    (d : PhysicalSelectedData P ell C) (hd : physicalSelectedDataTest C d o t) :
    physicalSelectedCumulativeOffset C k d = Fin.partialSum (physicalRecordDisplacement C k cut r) := by
  unfold physicalSelectedCumulativeOffset
  congr 1
  funext j
  have ha : ∀ j, o (4 * j.val + 2) = .inr (some ⟨j, d.1 j⟩) :=
    fun j => (((physical_selected_data_test_iff_four C d o t).mp hd).2.2.1 j).1
  rw [physical_record_displacement_decoded C k cut o t r hlen ho ht d.1 ha j,
    physical_coherent_selected_source_marks C o t h d hd j]

theorem physical_coherent_record_offset_phase
    [Fintype (PhysicalSelectedData P ell C)]
    (W : (Fin (n + 1) → ℤ) → ℂ)
    (o : ℕ → PhysicalMarkObservation P ell C)
    (t : ℕ → PhysicalBoundedMarkState P J ell B)
    (r : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C))
    (h : PhysicalFineHistoryCoherent C o t) (hlen : r.length = 4 * n + 1)
    (ho : ∀ (i : ℕ) (hi : i < r.length), (r.get ⟨i, hi⟩).2.1 = o i)
    (ht : ∀ (i : ℕ) (hi : i < r.length), (r.get ⟨i, hi⟩).2.2 =
      physicalBoundedMarkEncode (cut (i + 1)) (t i)) :
    physicalSelectedDataRecordPhase C cut univ
        (fun d => W (physicalSelectedCumulativeOffset C k d)) r =
      W (Fin.partialSum (physicalRecordDisplacement C k cut r)) := by
  obtain ⟨d, hd, _⟩ := physical_coherent_fine_history_has_selection C o t h
  have htest := (physical_selected_record_iff_decoded C cut o t r hlen ho ht d).mpr hd
  rw [physical_selected_record_phase_at C cut univ r
    (fun d => W (physicalSelectedCumulativeOffset C k d)) d (mem_univ _) htest,
    physical_coherent_selected_cumulative_offset C k cut o t r h hlen ho ht d hd]

end Record
end Bounty
end

section

/- Endpoint phases preserve the exact harmonic cutoff norm. -/

namespace Bounty

theorem physical_phase_star (a : ℝ) (n : ℕ) :
    star (physicalPhase a n) = physicalPhase (-a) n :=
  (physical_phase_reverse a n).symm

noncomputable def physicalPhasedHarmonicCutoff (a b Z : ℝ) (k : ℤ) (d : ℕ) (n : ℤ) : ℂ :=
  (typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) : ℂ) *
    physicalPhase a n.natAbs * physicalPhase b (n+k*(d : ℤ)).natAbs

theorem physical_phased_harmonic_cutoff_norm (a b Z : ℝ) (k : ℤ) (d : ℕ) (n : ℤ) :
    ‖physicalPhasedHarmonicCutoff a b Z k d n‖ =
      ‖(typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) : ℂ)‖ := by
  simp only [physicalPhasedHarmonicCutoff, norm_mul, physical_phase_norm, mul_one]

theorem physical_phased_harmonic_cutoff_bound (a b Z : ℝ) (k : ℤ) (d : ℕ) (n : ℤ) :
    ‖physicalPhasedHarmonicCutoff a b Z k d n‖ ≤ 2 := by
  rw [physical_phased_harmonic_cutoff_norm, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (typeII_harmonic_dyadic_bounds _).1]
  exact (typeII_harmonic_dyadic_bounds _).2

theorem physical_harmonic_global_phase_norm {G : Type*} [DecidableEq G]
    {J ell : ℕ} (probes : G → Finset (Fin J)) (r t : Finset G)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t) (a b : ℝ) (d : ℕ) :
    ‖repeatedBigPrimePatternWeight probes r t i * physicalPhase (-(a+b)) d‖ = 1 := by
  rw [norm_mul, repeated_big_prime_pattern_weight_norm, physical_phase_norm, mul_one]

end Bounty
end

section

/- Uniform tail control for the exactly separated harmonic cutoff. -/

open Finset MeasureTheory Filter Real
namespace Bounty

theorem harmonic_separated_integrand_norm (S : Finset ℤ) (Z : ℝ) (d : ℕ)
    (c : ℤ → ℂ) (v : ℝ) :
    ‖harmonicLogFourier v*physicalPhase (-(2*Real.pi*v)) d*
      ∑ n ∈ S, c n*physicalMellinPhase (2*Real.pi*v) ((n : ℝ)/Z)‖ ≤
      ‖harmonicLogFourier v‖ * ∑ n ∈ S, ‖c n‖ := by
  rw [norm_mul, norm_mul, physical_phase_norm, mul_one]
  apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
  apply (norm_sum_le _ _).trans
  simp only [norm_mul, physical_mellin_phase_norm, mul_one, le_refl]

theorem harmonic_separated_mellin_truncation {S : Finset ℤ} {Z : ℝ} {d : ℕ}
    (hZ : 0 < Z) (hd : 0 < d) (hn : ∀ n ∈ S, 0 < n) (c : ℤ → ℂ) (R : ℝ) :
    ‖(∑ n ∈ S, (typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) : ℂ)*c n) -
      ∫ v in {v : ℝ | ‖v‖ ≤ R}, harmonicLogFourier v*physicalPhase (-(2*Real.pi*v)) d*
        ∑ n ∈ S, c n*physicalMellinPhase (2*Real.pi*v) ((n : ℝ)/Z)‖ ≤
      (∫ v in {v : ℝ | R < ‖v‖}, ‖harmonicLogFourier v‖) * ∑ n ∈ S, ‖c n‖ := by
  have hs : MeasurableSet {v : ℝ | ‖v‖ ≤ R} :=
    (isClosed_le continuous_norm continuous_const).measurableSet
  have heq : {v : ℝ | ‖v‖ ≤ R}ᶜ = {v : ℝ | R < ‖v‖} := by ext v; simp
  rw [harmonic_sum_eq_separated_mellin hZ hd hn c,
    ← setIntegral_compl hs (harmonic_separated_mellin_integrable hZ.ne' hd.ne'
      (fun n h => (hn n h).ne') c), heq]
  calc
    _ ≤ ∫ v in {v : ℝ | R < ‖v‖}, ‖harmonicLogFourier v‖*(∑ n ∈ S, ‖c n‖) :=
      norm_integral_le_of_norm_le
        ((harmonic_log_fourier_integrable.norm.mul_const _).integrableOn)
        (Filter.Eventually.of_forall (harmonic_separated_integrand_norm S Z d c))
    _ = _ := integral_mul_const _ _

theorem eventually_harmonic_mellin_tail_power {r : ℝ} (hr : 0 < r) (C D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ B : ℝ, 0 ≤ B → B ≤ L^C →
      (∫ v in {v : ℝ | L^r < ‖v‖}, ‖harmonicLogFourier v‖)*B ≤ L^(-D) := by
  obtain ⟨M, hM⟩ := exists_nat_gt ((C+D+1)/r)
  have hMr : C+D+1 < r*(M : ℝ) := by
    have hh := (div_lt_iff₀ hr).mp hM
    simpa only [mul_comm] using hh
  obtain ⟨K, hK, htail⟩ := harmonic_log_fourier_rapid_tail M
  filter_upwards [eventually_ge_atTop (max 1 K)] with L hL
  have hL1 : 1 ≤ L := (le_max_left _ _).trans hL
  have hKL : K ≤ L := (le_max_right _ _).trans hL
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL1
  intro B hB hBC
  calc
    _ ≤ (K*(L^r)^(-(M : ℝ)))*L^C :=
      mul_le_mul (htail (L^r) (one_le_rpow hL1 hr.le)) hBC hB (by positivity)
    _ ≤ (L*(L^r)^(-(M : ℝ)))*L^C := by gcongr
    _ = L^(1-r*(M : ℝ)+C) := by
      nth_rw 1 [← rpow_one L]
      rw [← rpow_mul hL0.le, ← rpow_add hL0, ← rpow_add hL0]
      congr 1
      ring
    _ ≤ L^(-D) := rpow_le_rpow_of_exponent_le hL1 (by linarith)

end Bounty
end

section

/- The actual common cutoff localizes every shifted endpoint to positive natural indices. -/

open Finset Real

namespace Bounty

theorem harmonic_common_cutoff_energy_le {Y : ℝ} (hY : 0 < Y)
    (S : Finset ℤ) (δ : ℤ) (F : ℕ → ℂ) :
    (∑ n ∈ S, ‖(harmonicCommonCutoff (((n+δ : ℤ) : ℝ)/Y) : ℂ)*F (n+δ).natAbs‖^2) ≤
      ∑ m ∈ Icc 1 ⌈4*exp 2*Y⌉₊, ‖F m‖^2 := by
  classical
  let T := S.filter (fun n => harmonicCommonCutoff (((n+δ : ℤ) : ℝ)/Y) ≠ 0)
  have hpos : ∀ n ∈ T, 0 < n+δ ∧ n+δ ≤ (⌈4*exp 2*Y⌉₊ : ℤ) := by
    intro n hn
    have hs := harmonic_common_cutoff_scaled_support hY (mem_filter.mp hn).2
    have hl : (0 : ℝ) < (n+δ : ℤ) := (div_pos hY (by norm_num)).trans hs.1
    have hu : ((n+δ : ℤ) : ℝ) ≤ (⌈4*exp 2*Y⌉₊ : ℝ) := hs.2.le.trans (Nat.le_ceil _)
    exact ⟨by exact_mod_cast hl, by exact_mod_cast hu⟩
  calc
    _ = ∑ n ∈ T, ‖(harmonicCommonCutoff (((n+δ : ℤ) : ℝ)/Y) : ℂ)*F (n+δ).natAbs‖^2 := by
      symm
      apply sum_subset (filter_subset _ _)
      intro n hn hnt
      have hz : harmonicCommonCutoff (((n+δ : ℤ) : ℝ)/Y) = 0 := by
        by_contra hne
        exact hnt (mem_filter.mpr ⟨hn,hne⟩)
      simp only [hz, Complex.ofReal_zero, zero_mul, norm_zero, zero_pow (by decide : 2 ≠ 0)]
    _ ≤ ∑ n ∈ T, ‖F (n+δ).natAbs‖^2 := by
      apply sum_le_sum
      intro n hn
      have hc := harmonic_common_cutoff_bounds (((n+δ : ℤ) : ℝ)/Y)
      have hb : ‖(harmonicCommonCutoff (((n+δ : ℤ) : ℝ)/Y) : ℂ)*F (n+δ).natAbs‖ ≤
          ‖F (n+δ).natAbs‖ := by
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hc.1]
        exact mul_le_of_le_one_left (norm_nonneg _) hc.2
      exact pow_le_pow_left₀ (norm_nonneg _) hb 2
    _ = ∑ m ∈ T.image (fun n => (n+δ).natAbs), ‖F m‖^2 :=
      sum_shift_natAbs T δ (fun m => ‖F m‖^2) (fun n hn => (hpos n hn).1.le)
    _ ≤ _ := by
      apply sum_le_sum_of_subset_of_nonneg
      · intro m hm
        have h := shifted_natAbs_image_bounds T δ ⌈4*exp 2*Y⌉₊ hpos m hm
        exact mem_Icc.mpr ⟨h.1,h.2⟩
      · intro m hm hnot
        exact sq_nonneg _

end Bounty
end

section

/- Exact logarithmic Mellin representation and uniform tails for the harmonic source cutoff. -/

open MeasureTheory
namespace Bounty

theorem harmonic_source_cutoff_mellin_representation {t : ℝ} (ht : 0 < t) :
    ((harmonicCommonCutoff t / t : ℝ) : ℂ) = ∫ v : ℝ,
      harmonicSourceLogFourier v*physicalMellinPhase (2*Real.pi*v) t := by
  have he := harmonic_source_log_fourier_inversion (Real.log t)
  simp only [harmonicSourceLogCutoff, Real.exp_log ht] at he
  rw [he]
  apply integral_congr_ae
  exact Filter.Eventually.of_forall (fun v => mul_comm _ _)

theorem harmonic_source_cutoff_mellin_integrable (t : ℝ) :
    Integrable (fun v : ℝ => harmonicSourceLogFourier v*physicalMellinPhase (2*Real.pi*v) t) :=
  physical_mellin_phase_integrable harmonicSourceLogFourier (fun v => 2*Real.pi*v)
    harmonic_source_log_fourier_integrable (by fun_prop) t

theorem harmonic_source_cutoff_mellin_truncation {t : ℝ} (ht : 0 < t) (R : ℝ) :
    ‖((harmonicCommonCutoff t / t : ℝ) : ℂ) -
      ∫ v in {v : ℝ | ‖v‖ ≤ R},
        harmonicSourceLogFourier v*physicalMellinPhase (2*Real.pi*v) t‖ ≤
      ∫ v in {v : ℝ | R < ‖v‖}, ‖harmonicSourceLogFourier v‖ := by
  have hs : MeasurableSet {v : ℝ | ‖v‖ ≤ R} :=
    (isClosed_le continuous_norm continuous_const).measurableSet
  have heq : {v : ℝ | ‖v‖ ≤ R}ᶜ = {v : ℝ | R < ‖v‖} := by ext v; simp
  rw [harmonic_source_cutoff_mellin_representation ht,
    ← setIntegral_compl hs (harmonic_source_cutoff_mellin_integrable t), heq]
  apply (norm_integral_le_integral_norm _).trans
  apply le_of_eq
  apply integral_congr_ae
  exact Filter.Eventually.of_forall (fun v => by
    dsimp only
    rw [norm_mul, physical_mellin_phase_norm, mul_one])

theorem harmonic_source_cutoff_mellin_rapid_truncation (M : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ R : ℝ, 1 ≤ R → ∀ t : ℝ, 0 < t →
      ‖((harmonicCommonCutoff t / t : ℝ) : ℂ) -
        ∫ v in {v : ℝ | ‖v‖ ≤ R},
          harmonicSourceLogFourier v*physicalMellinPhase (2*Real.pi*v) t‖ ≤
            C*R^(-(M : ℝ)) := by
  obtain ⟨C, hC, hb⟩ := harmonic_source_log_fourier_rapid_tail M
  exact ⟨C, hC, fun R hR t ht =>
    (harmonic_source_cutoff_mellin_truncation ht R).trans (hb R hR)⟩

end Bounty
end

section

/- Exact natural-number coordinates for the original common window. -/

open Finset
namespace Bounty

theorem mem_harmonic_common_natural_support {Y : ℝ} (hY : 0 < Y) {n : ℕ} :
    n ∈ (harmonicCommonSupport Y).image Int.natAbs ↔
      Y/8 ≤ (n : ℝ) ∧ (n : ℝ) ≤ 4*Real.exp 2*Y := by
  constructor
  · intro hn
    obtain ⟨m,hm,rfl⟩ := mem_image.mp hn
    have hmp := harmonic_common_support_positive hY hm
    have he : (m.natAbs : ℝ) = (m : ℝ) := by
      simpa only [Int.cast_natCast] using
        congrArg (fun z : ℤ => (z : ℝ)) (Int.natAbs_of_nonneg hmp.le)
    rw [he]
    exact mem_harmonic_common_support.mp hm
  · intro hn
    refine mem_image.mpr ⟨(n : ℤ), ?_, ?_⟩
    · apply mem_harmonic_common_support.mpr
      simpa only [Int.cast_natCast] using hn
    · simp only [Int.natAbs_natCast]

theorem harmonic_common_natural_support_bound {Y : ℝ} (hY : 0 < Y)
    {n : ℕ} (hn : n ∈ (harmonicCommonSupport Y).image Int.natAbs) :
    0 < n ∧ n ≤ ⌈4*Real.exp 2*Y⌉₊ := by
  have hs := (mem_harmonic_common_natural_support hY).mp hn
  constructor
  · have hp : (0 : ℝ) < n := lt_of_lt_of_le (by positivity : 0 < Y/8) hs.1
    exact_mod_cast hp
  · have hb := hs.2.trans (Nat.le_ceil (4*Real.exp 2*Y))
    exact_mod_cast hb

theorem harmonic_common_cutoff_zero_outside_natural {Y : ℝ} (hY : 0 < Y)
    {n : ℕ} (hn : n ∉ (harmonicCommonSupport Y).image Int.natAbs) :
    harmonicCommonCutoff ((n : ℝ)/Y) = 0 := by
  by_contra hne
  have hs := harmonic_common_cutoff_scaled_support hY hne
  exact hn ((mem_harmonic_common_natural_support hY).mpr ⟨hs.1.le,hs.2.le⟩)

theorem harmonic_common_natural_sum {E : Type*} [AddCommMonoid E]
    {Y : ℝ} (hY : 0 < Y) (f : ℕ → E) :
    (∑ n ∈ harmonicCommonSupport Y, f n.natAbs) =
      ∑ n ∈ (harmonicCommonSupport Y).image Int.natAbs, f n := by
  symm
  apply sum_image
  intro a ha b hb hab
  have he := congrArg (fun n : ℕ => (n : ℤ)) hab
  simpa only [Int.natAbs_of_nonneg (harmonic_common_support_positive hY ha).le,
    Int.natAbs_of_nonneg (harmonic_common_support_positive hY hb).le] using he

end Bounty
end

