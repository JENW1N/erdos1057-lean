section

/- The exact original forest indicator is a causal product along the same original mixed path. -/

open Finset Classical

namespace Bounty

section Factor
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K)))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))

noncomputable def fullMixedForestHistoryGain (t : ℕ) (tag : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag s)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P)) : ℝ :=
  if ht : t < steps.length then
    if steps.get ⟨t, ht⟩ = tag then
      if birthForestStageCondition
        (fun i => fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i)) ⟨t, ht⟩
        (fullMixedStepHistoryUpdate n S B A Δ D steps t tag s e history) code then 1 else 0
    else 0
  else 0

theorem full_mixed_forest_history_gain_nonneg (t : ℕ) (tag : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag s)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P)) :
    0 ≤ fullMixedForestHistoryGain n S B A Δ D steps code t tag s e history := by
  unfold fullMixedForestHistoryGain
  split_ifs <;> norm_num

theorem full_mixed_forest_history_gain_owner (u : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (steps.get u) s)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P)) :
    fullMixedForestHistoryGain n S B A Δ D steps code u.val (steps.get u) s e history =
      if birthForestStageCondition
        (fun i => fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i)) u
        (fullMixedBirthHistoryWrite n S B A Δ D steps u s e history) code then 1 else 0 := by
  unfold fullMixedForestHistoryGain
  rw [dif_pos u.isLt, if_pos rfl, full_mixed_step_history_update_owner]

theorem full_mixed_forest_history_factor
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps s)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P)) :
    finiteEventHistoryFactor (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D)
      (fullMixedStepHistoryUpdate n S B A Δ D steps)
      (fullMixedForestHistoryGain n S B A Δ D steps code) 0 steps s p history =
    if birthForestCompatible
      (fun i => fullMixedPathBirthPerformed n S B A Δ D steps s p (fullMixedBirthOrder S B steps i))
      (fun i => fullMixedPathBirthLabel n S B A Δ D steps s p (fullMixedBirthOrder S B steps i)) code
      then 1 else 0 := by
  rw [finite_event_history_factor_eq_prod]
  trans (∏ u : Fin steps.length,
    if birthForestStageCondition
      (fun i => fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i)) u
      (fullMixedPathBirthHistory n S B A Δ D steps s p history (u.val + 1)) code then (1 : ℝ) else 0)
  · apply prod_congr rfl
    intro u _
    dsimp only
    rw [Nat.zero_add,
      full_mixed_path_history_at n S B A Δ D steps s p history u.val (Nat.le_of_lt u.isLt),
      full_mixed_forest_history_gain_owner,
      full_mixed_path_birth_history_write]
  · rw [prod_condition_indicators]
    simp only [← full_mixed_forest_compatible_iff_history_stages n S B A Δ D steps s p history code]

end Factor
end Bounty
end

section

/- The actual ghost and edge sample sums split by fixed skeleton support without altering the continuation. -/

open Finset Classical

namespace Bounty

section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)] {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K))) (u : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))

section Ghost
variable [∀ g p, NeZero (n g p)] (j : J) (htag : steps.get u = some (.inl j)) (sk : CoupledGhostSkeleton M B s)

theorem full_mixed_ghost_skeleton_stage_sum (F : CoupledGhostSamples M B s sk → ℝ) :
    let embed := fun i => (fullMixedGhostOwnerSampleEmbedding S B j steps u htag s sk) ((fullMixedGhostOwnerSampleOrder S B j steps u htag s sk) i)
    let owner := fun i => fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i)
    let values := fun births => fullMixedBirthHistoryWrite n S B A Δ D steps u s
      (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inl j)) htag s ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩)) history
    let localValues := fun births i => (⟨(fullMixedGhostOwnerSampleOrder S B j steps u htag s sk i).1, (births (fullMixedGhostOwnerSampleOrder S B j steps u htag s sk i)).1⟩ : Sigma P)
    (∑ births : CoupledGhostSamples M B s sk,
      if birthForestStageCondition owner u (values births) code then F births else 0) =
      if birthForestStageSupport owner u (ownerSampleSupport embed owner u history) code then
        ∑ births : CoupledGhostSamples M B s sk,
          if birthForestEqualValues (restrictedBirthCode embed code) (localValues births) ∧
            birthLabelsAnchored (fun i => (restrictedBirthAnchors embed code history i).join) (localValues births)
          then F births else 0
      else 0 := by
  dsimp only
  have h := owner_sample_stage_sum (fun i => (fullMixedGhostOwnerSampleEmbedding S B j steps u htag s sk) ((fullMixedGhostOwnerSampleOrder S B j steps u htag s sk) i))
    (full_mixed_ghost_owner_sample_strictMono S B j steps u htag s sk)
    (fun i => fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i))
    (full_mixed_birth_order_owner_monotone S B steps) u
    (fun i => full_mixed_ghost_owner_sample_owner S B j steps u htag s sk (fullMixedGhostOwnerSampleOrder S B j steps u htag s sk i))
    code (fun births => fullMixedBirthHistoryWrite n S B A Δ D steps u s
      (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inl j)) htag s ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩)) history)
    history (fun births i => (⟨(fullMixedGhostOwnerSampleOrder S B j steps u htag s sk i).1, (births (fullMixedGhostOwnerSampleOrder S B j steps u htag s sk i)).1⟩ : Sigma P))
    (by
      intro births i
      constructor
      · intro hi
        obtain ⟨c, hc⟩ := (full_mixed_ghost_history_sample_coverage n S B A Δ D steps u s history
          j htag sk births i).mp hi
        refine ⟨(fullMixedGhostOwnerSampleOrder S B j steps u htag s sk).symm c, ?_⟩
        dsimp only
        rw [Equiv.apply_symm_apply]
        exact hc
      · rintro ⟨i, rfl⟩
        exact (full_mixed_ghost_history_sample_coverage n S B A Δ D steps u s history
          j htag sk births _).mpr ⟨(fullMixedGhostOwnerSampleOrder S B j steps u htag s sk) i, rfl⟩)
    (fun births i hi => full_mixed_birth_history_write_other n S B A Δ D steps u s _ history i hi)
    (fun births i => full_mixed_ghost_history_sample_label n S B A Δ D steps u s history
      j htag sk births (fullMixedGhostOwnerSampleOrder S B j steps u htag s sk i)) F
  convert h using 1
  split_ifs
  · apply sum_congr rfl
    intro z _
    split_ifs <;> rfl
  · rfl


end Ghost

section Edge
variable (k : K) (htag : steps.get u = some (.inr k)) (sk : FullActiveEdgeSkeleton n (S k) B (A k) (Δ k) (D k) s)

theorem full_mixed_edge_skeleton_stage_sum (F : FullActiveEdgeSamples n (S k) B (A k) (Δ k) (D k) s sk → ℝ) :
    let embed := fun i => (fullMixedEdgeOwnerSampleEmbedding n S B k steps u htag (A k) (Δ k) (D k) s sk) ((fullMixedEdgeOwnerSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk) i)
    let owner := fun i => fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i)
    let values := fun fresh => fullMixedBirthHistoryWrite n S B A Δ D steps u s
      (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inr k)) htag s ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm ⟨sk, fresh⟩)) history
    let localValues := fun fresh i => (⟨(fullMixedEdgeOwnerSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk i).1, fresh (fullMixedEdgeOwnerSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk i)⟩ : Sigma P)
    (∑ fresh : FullActiveEdgeSamples n (S k) B (A k) (Δ k) (D k) s sk,
      if birthForestStageCondition owner u (values fresh) code then F fresh else 0) =
      if birthForestStageSupport owner u (ownerSampleSupport embed owner u history) code then
        ∑ fresh : FullActiveEdgeSamples n (S k) B (A k) (Δ k) (D k) s sk,
          if birthForestEqualValues (restrictedBirthCode embed code) (localValues fresh) ∧
            birthLabelsAnchored (fun i => (restrictedBirthAnchors embed code history i).join) (localValues fresh)
          then F fresh else 0
      else 0 := by
  dsimp only
  have h := owner_sample_stage_sum (fun i => (fullMixedEdgeOwnerSampleEmbedding n S B k steps u htag (A k) (Δ k) (D k) s sk) ((fullMixedEdgeOwnerSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk) i))
    (full_mixed_edge_owner_sample_strictMono n S B k steps u htag (A k) (Δ k) (D k) s sk)
    (fun i => fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i))
    (full_mixed_birth_order_owner_monotone S B steps) u
    (fun i => full_mixed_edge_owner_sample_owner n S B k steps u htag (A k) (Δ k) (D k) s sk (fullMixedEdgeOwnerSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk i))
    code (fun fresh => fullMixedBirthHistoryWrite n S B A Δ D steps u s
      (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inr k)) htag s ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm ⟨sk, fresh⟩)) history)
    history (fun fresh i => (⟨(fullMixedEdgeOwnerSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk i).1, fresh (fullMixedEdgeOwnerSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk i)⟩ : Sigma P))
    (by
      intro fresh i
      constructor
      · intro hi
        obtain ⟨c, hc⟩ := (full_mixed_edge_history_sample_coverage n S B A Δ D steps u s history
          k htag sk fresh i).mp hi
        refine ⟨(fullMixedEdgeOwnerSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk).symm c, ?_⟩
        dsimp only
        rw [Equiv.apply_symm_apply]
        exact hc
      · rintro ⟨i, rfl⟩
        exact (full_mixed_edge_history_sample_coverage n S B A Δ D steps u s history
          k htag sk fresh _).mpr ⟨(fullMixedEdgeOwnerSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk) i, rfl⟩)
    (fun fresh i hi => full_mixed_birth_history_write_other n S B A Δ D steps u s _ history i hi)
    (fun fresh i => full_mixed_edge_history_sample_label n S B A Δ D steps u s history
      k htag sk fresh (fullMixedEdgeOwnerSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk i)) F
  convert h using 1
  split_ifs
  · apply sum_congr rfl
    intro z _
    split_ifs <;> rfl
  · rfl


end Edge

end Full
end Bounty
end

section

/- Uniform normalized cofactor bounds for the finite Buchstab induction. -/

namespace Bounty

open Finset Filter Real MeasureTheory
open scoped Topology

theorem exists_normalized_rough_cell_bound {a γ₀ : ℝ}
    (ha : 0 < a) (hγ₀ : 0 < γ₀) :
    ∃ C : ℝ, 0 < C ∧ ∀ S : ℝ, ∀ᶠ L : ℝ in atTop,
      ∀ γ w : ℝ, γ₀ ≤ γ → a ≤ w →
        0 ≤ normalizedRoughCellCount L S (exp (w*L)) (exp (γ*L)) ∧
        normalizedRoughCellCount L S (exp (w*L)) (exp (γ*L)) ≤ C := by
  obtain ⟨C, hC, hbound⟩ := exists_exponential_rough_logarithmic_cell_upper ha hγ₀
  refine ⟨C, hC, fun S => ?_⟩
  filter_upwards [hbound S, eventually_gt_atTop (0 : ℝ)] with L hboundL hL
  intro γ w hγ hw
  refine ⟨normalized_rough_cell_count_nonneg hL (exp_pos _), ?_⟩
  unfold normalizedRoughCellCount
  apply (div_le_iff₀ (logarithmic_cell_count_scale_pos hL (exp_pos _))).mpr
  have hb := hboundL γ hγ (exp (w*L))
    (exp_le_exp.mpr (mul_le_mul_of_nonneg_right hw hL.le))
  simpa only [logarithmicCellCountScale, mul_div_assoc] using hb

theorem prime_band_reciprocal_weight_error (f g : ℕ → ℝ)
    {A B δ : ℝ} (hfg : ∀ p ∈ primeBand A B, |f p-g p| ≤ δ) :
    |(∑ p ∈ primeBand A B, f p/(p : ℝ)) -
      (∑ p ∈ primeBand A B, g p/(p : ℝ))| ≤ δ*primeBandHarmonic A B := by
  rw [← sum_sub_distrib]
  calc
    _ ≤ ∑ p ∈ primeBand A B, |f p/(p : ℝ)-g p/(p : ℝ)| := abs_sum_le_sum_abs _ _
    _ ≤ ∑ p ∈ primeBand A B, δ*(1/(p : ℝ)) := by
      apply sum_le_sum
      intro p hp
      rw [← sub_div, abs_div, abs_of_nonneg (show (0 : ℝ) ≤ (p : ℝ) from Nat.cast_nonneg p)]
      convert div_le_div_of_nonneg_right (hfg p hp) (Nat.cast_nonneg p) using 1; ring
    _ = _ := by unfold primeBandHarmonic; rw [mul_sum]

theorem prime_band_reciprocal_weight_bound (f : ℕ → ℝ)
    {A B C : ℝ} (hf : ∀ p ∈ primeBand A B, |f p| ≤ C) :
    |∑ p ∈ primeBand A B, f p/(p : ℝ)| ≤ C*primeBandHarmonic A B := by
  simpa only [sub_zero, zero_div, sum_const_zero] using
    prime_band_reciprocal_weight_error f (fun _ => 0) (by simpa only [sub_zero] using hf)

def UniformRoughDepthApprox (n : ℕ) (S : ℝ) : Prop :=
  ∀ a b γ₀ gap : ℝ, 0 < a → 0 < γ₀ → 0 < gap →
    ∀ ε : ℝ, 0 < ε → ∀ᶠ L : ℝ in atTop,
      ∀ w γ : ℝ, a ≤ w → w ≤ b → γ₀ ≤ γ → gap ≤ w-γ →
        w+L^(-S)/L ≤ ((n : ℝ)+2)*γ →
        |normalizedRoughCellCount L S (exp (w*L)) (exp (γ*L))-
          buchstabDepthDensity n γ w| ≤ ε

theorem uniform_rough_depth_cofactor_pointwise {n : ℕ} {S : ℝ}
    (hprev : UniformRoughDepthApprox n S)
    {a b γ₀ η τ : ℝ} (ha : 0 < a) (hγ₀ : 0 < γ₀) (hη : 0 < η) (hτ : 0 < τ) :
    ∀ᶠ L : ℝ in atTop, ∀ w γ α : ℝ,
      a ≤ w → w ≤ b → γ₀ ≤ γ → γ ≤ α → α ≤ w/2-η →
      w+L^(-S)/L ≤ ((n : ℝ)+3)*γ →
      |normalizedRoughCellCount L S (exp ((w-α)*L)) (exp (α*L))-
        buchstabDepthExtendedKernel n w α| ≤ τ := by
  filter_upwards [hprev (a/2) b γ₀ (2*η) (half_pos ha) hγ₀ (by positivity) τ hτ]
    with L hL
  intro w γ α haw hwb hγ hγα hα htop
  obtain ⟨hwlo,hwhi,hαlo,hgap,hdepth⟩ :=
    buchstab_good_cofactor_domain n hη.le haw hwb hγ hγα hα htop
  rw [buchstab_depth_extended_kernel_eq n (by linarith)]
  exact hL (w-α) α hwlo (by linarith) hαlo hgap hdepth

theorem prime_band_reciprocal_split_error (f g : ℕ → ℝ)
    {A B C D τ U V : ℝ} (hAB : A ≤ B) (hBC : B ≤ C) (hCD : C ≤ D)
    (hgood : ∀ p ∈ primeBand A B, |f p-g p| ≤ τ)
    (hf : ∀ p ∈ primeBand B D, |f p| ≤ U)
    (hg : ∀ p ∈ primeBand B C, |g p| ≤ V) :
    |(∑ p ∈ primeBand A D, f p/(p : ℝ)) -
      (∑ p ∈ primeBand A C, g p/(p : ℝ))| ≤
      τ*primeBandHarmonic A B+U*primeBandHarmonic B D+V*primeBandHarmonic B C := by
  have heqf := prime_band_sum_add_adjacent (fun p => f p/(p : ℝ)) hAB (hBC.trans hCD)
  have heqg := prime_band_sum_add_adjacent (fun p => g p/(p : ℝ)) hAB hBC
  have hmain := prime_band_reciprocal_weight_error f g hgood
  have htailf := prime_band_reciprocal_weight_bound f hf
  have htailg := prime_band_reciprocal_weight_bound g hg
  rw [← heqf, ← heqg]
  have htri := abs_add_le
    ((∑ p ∈ primeBand A B, f p/(p : ℝ))-(∑ p ∈ primeBand A B, g p/(p : ℝ)))
    ((∑ p ∈ primeBand B D, f p/(p : ℝ))-(∑ p ∈ primeBand B C, g p/(p : ℝ)))
  have htri' := abs_sub (∑ p ∈ primeBand B D, f p/(p : ℝ))
    (∑ p ∈ primeBand B C, g p/(p : ℝ))
  have heq : (∑ p ∈ primeBand A B, f p/(p : ℝ))+
      (∑ p ∈ primeBand B D, f p/(p : ℝ))-
      ((∑ p ∈ primeBand A B, g p/(p : ℝ))+(∑ p ∈ primeBand B C, g p/(p : ℝ))) =
      ((∑ p ∈ primeBand A B, f p/(p : ℝ))-(∑ p ∈ primeBand A B, g p/(p : ℝ)))+
      ((∑ p ∈ primeBand B D, f p/(p : ℝ))-(∑ p ∈ primeBand B C, g p/(p : ℝ))) := by ring
  rw [heq]
  linarith

theorem prime_band_eq_empty_of_upper_le {A B : ℝ} (hBA : B ≤ A) :
    primeBand A B = ∅ := by
  simp only [primeBand, Ioc_eq_empty_of_le (Nat.floor_mono hBA), filter_empty]

theorem logarithmic_cell_sqrt_exp (w S : ℝ) {L : ℝ} (hL : L ≠ 0) :
    sqrt (exp (L^(-S))*exp (w*L)) = exp (((w+L^(-S)/L)/2)*L) := by
  have heq : exp (L^(-S))*exp (w*L) = (exp (((w+L^(-S)/L)/2)*L))^2 := by
    rw [pow_two, ← exp_add, ← exp_add]
    congr 1
    field_simp
    ring
  rw [heq, sqrt_sq (exp_pos _).le]

end Bounty

/- Public declaration closure audit. -/
end

section

/- Candidate-prime arithmetic supplies reverse eligibility rarity for the
literal mixed storage operator with both small-slot averages. The small
measure is the original residue-valid measure, and big labels may repeat. -/

open Finset Filter
open scoped Classical Topology

namespace Bounty

theorem uniform_indicator_probability_fintype_eq {T : Type*}
    (fa fb : Fintype T) (P : T → Prop) :
    (∑ t ∈ fa.elems, if P t then 1 / (@Fintype.card T fa : ℝ) else 0) =
      ∑ t ∈ fb.elems, if P t then 1 / (@Fintype.card T fb : ℝ) else 0 := by
  cases Subsingleton.elim fa fb
  rfl

theorem eventually_candidate_mixed_storage_energy_le
    {q vs scale : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hvs : 0 < vs) (hscale : 0 < scale)
    (ell : ℕ) (C₂ : ℝ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ᶠ L : ℝ in atTop,
      letI : DecidableEq (CandidateSmallGroup scale L) := Classical.decEq _
      letI : DecidableEq (CandidateBigGroup scale L) := Classical.decEq _
      letI : ∀ p : PhysicalPrime (candidateSmallPool scale L), NeZero p.2.val :=
        candidateSmallPrimeNeZero scale L
      letI : ∀ g p, NeZero (candidateBigModulus scale L g p) := candidateBigModulusNeZero scale L
      ∀ J B : ℕ,
      letI : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
      ∀ M : CandidateBigGroup scale L → ℕ,
      ∀ shared : ∀ g, Finset (Fin (M g)),
      ∀ D_B : SharedActiveLabels (CandidateBigLabel scale L) shared → ℕ,
      ∀ k : ℤ, k ≠ 0 → (k.natAbs : ℝ) ≤ L ^ C₂ →
      ∀ Vs : CandidateSmallGroup scale L → ℝ, (∀ g, vs ≤ Vs g) →
      ∀ aux : PhysicalAuxLabels (candidateSmallPool scale L) (fun _ => (∅ : Finset (Fin J))),
      ∀ μ : ∀ g, CandidateBigLabel scale L g → ℝ, ∀ ρ : ℝ,
      ∀ V : CandidateBigGroup scale L → ℝ,
      ∀ v vmin vmax : ℝ, 0 < ρ → ρ < 1 → 1 < v → 0 < vmin →
      (∀ g, vmin ≤ V g) → (∀ g, V g ≤ vmax) →
      (∀ g p, 0 ≤ μ g p) → (∀ g, ∑ p, μ g p ≤ 2) →
      ∀ T : ℕ, (∀ g, (shared g)ᶜ.card ≤ T) →
      ∀ F : PhysicalSmallBigState (candidateSmallPool scale L) J ell
        (ProductBoundedOrderedState (CandidateBigLabel scale L)
          (fun g => UnrestrictedResidueParticle (candidateBigModulus scale L g)) M B) → ℂ,
      (∀ s, ProductMemorySymmetric (fun x => F (s, x))) →
      physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
        (physicalSmallBigAverage (physicalSmallBigStorageAction (candidateBigModulus scale L) shared B
          (fun d c _ => -(k * (D_B c * physicalSharedProduct d : ℕ)))
          (fun d c _ => (D_B c * physicalSharedProduct d : ℕ)) μ ρ V
          (fun c => k * D_B c) Vs q aux (physicalSmallBigAverage F))) ≤
      ((B : ℝ) / (((J + ell).choose ell) ^ (candidateSmallPIndices scale L).card : ℕ)) *
        (A ^ (2 * (candidateSmallPIndices scale L).card) *
          unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ (candidateBigPIndices scale L).card) *
        physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) F := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_small_big_storage_sandwich_energy_bound hq0 hq1 hvs ell
  refine ⟨A, hA, ?_⟩
  filter_upwards [eventually_candidate_mixed_reverse_eligibility_probability_le hscale ell C₂] with L hL
  let _ : DecidableEq (CandidateSmallGroup scale L) := Classical.decEq _
  let _ : DecidableEq (CandidateBigGroup scale L) := Classical.decEq _
  let _ : ∀ p : PhysicalPrime (candidateSmallPool scale L), NeZero p.2.val := candidateSmallPrimeNeZero scale L
  let _ : ∀ g p, NeZero (candidateBigModulus scale L g p) := candidateBigModulusNeZero scale L
  intro J B
  let _ : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
  intro M shared D_B k hk hkbound Vs hVs aux μ ρ V v vmin vmax hρ0 hρ1 hv hvmin
    hVlo hVhi hμ hmass T ht F hF
  have h := hbound (CandidateSmallGroup scale L) (CandidateBigGroup scale L)
    (candidateSmallPool scale L) (CandidateBigLabel scale L) (candidateBigModulus scale L)
    J M shared B
    (fun d c _ => -(k * (D_B c * physicalSharedProduct d : ℕ)))
    (fun d c _ => (D_B c * physicalSharedProduct d : ℕ)) μ ρ V (fun c => k * D_B c)
    Vs hVs aux v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht
    ((B : ℝ) / (((J + ell).choose ell) ^ (candidateSmallPIndices scale L).card : ℕ))
    (div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _))
    (by
      intro s hs
      have hh := hL J B M shared D_B k hk hkbound s hs
      refine le_trans (le_of_eq ?_) hh
      exact uniform_indicator_probability_fintype_eq _ _ _) F hF
  simpa only [CandidateSmallGroup, CandidateBigGroup, Fintype.card_coe] using h

end Bounty
end

section

/- The original mixed divisor is unchanged when only the big groups are reindexed. -/

open scoped Classical
namespace Bounty

section ReindexShared
variable {G H : Type*} [Fintype G] [Fintype H] {P : G → Finset ℕ} {J ell : ℕ}
  (e : G ≃ H) (C : G → Finset (Fin J))

theorem physical_full_shared_D_group_reindex
    (c : SharedActiveLabels (fun g => ↥(P g))
      (fun g => physicalFullSharedIndices (ell := ell) (C g)))
    (aux : PhysicalAuxLabels P C) :
    physicalFullSharedD (fun h => C (e.symm h)) (fun h => c (e.symm h))
      (physicalAuxGroupReindex e P J C aux) = physicalFullSharedD C c aux := by
  exact e.symm.prod_comp (fun g => (∏ i, (c g i).val) * ∏ j : C g, (aux g j).val)

end ReindexShared

section Encoded
variable {G H : Type*} [Fintype G] [Fintype H]
  {P : G → Finset ℕ} {J ell B : ℕ}
  (small : G → Prop) (e : {g : G // ¬small g} ≃ H)
  (C : G → Finset (Fin J)) (hC : ∀ g, small g → C g = ∅)
  (aux : PhysicalAuxLabels P C) (L : PhysicalMarkLists P J ell)
  {Z : H → Type*} (q : ∀ h, BoundedOrderedTuple (Z h) B)

include hC in
theorem physical_mixed_shared_D_reindexed :
    physicalMixedSharedD (fun h => C (e.symm h).val)
      (physicalSharedPrefix (fun g : {g // small g} => L g.val))
      (productActiveMemorySplit (fun h => physicalFullSharedIndices (C (e.symm h).val)) B
        (physicalFullMemoryState (fun h => C (e.symm h).val)
          (physicalMarkGroupReindex e (fun g => P g.val) J ell (fun g => L g.val)) q)).1
      (physicalAuxGroupReindex e (fun g => P g.val) J (fun g => C g.val) (fun g => aux g.val)) =
      physicalD C L aux := by
  rw [physical_mixed_shared_D_at_state]
  rw [physical_D_group_reindex e (fun g : {g // ¬small g} => C g.val)
    (fun g => aux g.val) (fun g => L g.val)]
  symm
  rw [physical_D_group_split small C aux L,
    physical_D_empty_cut (fun g : {g // small g} => C g.val)
      (fun g => hC g.val g.property)]

include hC in
theorem physical_mixed_parameters_reindexed (k : ℤ) (g : H) :
    let Cb := fun h => C (e.symm h).val
    let d := physicalSharedPrefix (fun g : {g // small g} => L g.val)
    let c := (productActiveMemorySplit (fun h => physicalFullSharedIndices (Cb h)) B
      (physicalFullMemoryState Cb
        (physicalMarkGroupReindex e (fun g => P g.val) J ell (fun g => L g.val)) q)).1
    let ab := physicalAuxGroupReindex e (fun g => P g.val) J (fun g => C g.val) (fun g => aux g.val)
    physicalMixedEdgeD Cb d c ab g = (physicalD C L aux : ℕ) ∧
      physicalMixedEdgeDelta Cb k d c ab g = -k * (physicalD C L aux : ℕ) ∧
      physicalMixedBigStep Cb k c ab * (physicalSharedProduct d : ℕ) =
        k * (physicalD C L aux : ℕ) := by
  dsimp only
  have h := physical_mixed_shared_D_reindexed small e C hC aux L q
  constructor
  · exact congrArg (fun D : ℕ => (D : ℤ)) h
  constructor
  · change -k * (physicalMixedSharedD _ _ _ _ : ℕ) = _
    rw [h]
  · rw [physical_mixed_step_times_small, h]

end Encoded
end Bounty
end

