theorem physical_unshared_prime_kernel_separable {G : Type*} [Fintype G] [DecidableEq G]
    {J ell : ℕ} (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ) (hξ : 0 < ξ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i)) :
    let kept := fun U : Finset (RepeatedBigFlatIndex G J ell) =>
      primeProductRetainedCells (fun j : U => P j.val.1) (fun j => V j.val.1) h ξ
    ∃ f g : GroupMarkedLists P (fun j => ell + (repeatedBigPrimePatternCut probes r t i j).card) → ℂ,
      (∀ u v, physicalUnsharedPrimePatternKernel P V probes r t hrt Q h kept i u v aux = f u * g v) ∧
      (∀ u, ‖f u‖ ≤ 1 + (Q * Q : ℕ) / ξ) ∧
      (∀ v, ‖g v‖ ≤ 1 + (Q * Q : ℕ) / ξ) := by
  intro kept
  cases i with
  | inl x =>
    refine ⟨fun _ => 1, fun _ => 1, ?_, ?_, ?_⟩
    · intro u v
      simp only [physicalUnsharedPrimePatternKernel, mul_one]
    · intro u
      rw [norm_one]
      have : 0 ≤ (Q * Q : ℕ) / ξ := div_nonneg (Nat.cast_nonneg _) hξ.le
      linarith
    · intro v
      rw [norm_one]
      have : 0 ≤ (Q * Q : ℕ) / ξ := div_nonneg (Nat.cast_nonneg _) hξ.le
      linarith
  | inr ab =>
    let hv := repeated_big_prime_pattern_pair_valid probes r t hrt ab
    let hU := repeated_big_active_pair_avoids_tail hv.1 hv.2.1
    let split := repeatedBigAuxSplitEquiv P ab.1.val ab.2.val hU hv.2.2 aux
    let f := fun u => primeProductIdealKernel (fun j : ab.2.val => P j.val.1)
      (fun j => V j.val.1) Q h (kept ab.2.val) split.2
      (physicalPrimeUnsharedRestriction ab.1.val ab.2.val ab.2.val subset_union_right u)
    let g := fun v => primeProductIdealKernel (fun j : ab.1.val => P j.val.1)
      (fun j => V j.val.1) Q h (kept ab.1.val) split.1
      (physicalPrimeUnsharedRestriction ab.1.val ab.2.val ab.1.val subset_union_left v)
    refine ⟨f, g, ?_, ?_, ?_⟩
    · intro u v
      exact mul_comm _ _
    · intro u
      exact (prime_ideal_kernel_norm_le _ _ Q h _ hξ
        (fun _ hd => prime_product_retained_cell_mass _ _ h ξ hd) _ _).trans (by linarith)
    · intro v
      exact (prime_ideal_kernel_norm_le _ _ Q h _ hξ
        (fun _ hd => prime_product_retained_cell_mass _ _ h ξ hd) _ _).trans (by linarith)

end Bounty
