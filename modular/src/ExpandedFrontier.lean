section

/- The actual candidate truncation estimate on the original finite spatial support. -/

open Finset MeasureTheory Filter
open scoped ComplexConjugate

namespace Bounty

theorem exists_candidate_smooth_cross_fourier_truncation_full_support
    {c q K₀ Cz A D : ℝ} (hc : 0 < c) (hq0 : 0 ≤ q) (hq1 : q < 1) (hCz : 0 ≤ Cz) :
    ∃ F : ℝ, 0 < F ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (r jStar : ℕ) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
        (take : Fin ((candidateQIndices c L).card*r) → Bool),
      take ((candidateAllocationOrder c L r).symm
        (candidateRoughSlot c L r jStar hr hj)) = false →
      ∀ (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ),
      (∀ slot p, p ∈ candidateQSlotChoices c L r jStar slot → ‖twist slot p‖ ≤ 1) →
      ∀ (U V E Z : ℝ) (k : ℤ), 0 < U → 0 < V → 1 ≤ Z → k ≠ 0 →
        E = U * L^(-K₀) → 1 ≤ U*V → Z ≤ 24*U^2*V*L^88/E →
        Real.log Z ≤ Cz*L → |(k:ℝ)| ≤ Z →
      ∀ (M H Zs : Finset ℕ) (α : ℕ → ℂ) (ρ : ℝ)
        (χ : DirichletCharacter ℂ (2*k.natAbs)),
        (∀ m ∈ M, (m:ℝ) ∈ Set.Icc U (2*U)) → (∀ m ∈ M, ‖α m‖ ≤ L^A) →
        (∀ h ∈ H, 0 < h) →
      let aH : ℕ → ℂ := fun h => typeIIPhase ρ h *
        candidateRetainedComplexCoefficient c L q r jStar take twist h
      Integrable (typeIICrossCharacterFourierIntegrand 1 L U V E Z k M H Zs
        typeIISmoothDyadic α aH χ) ∧
      ‖(∑ y ∈ typeIICrossSlice M H Zs k, (typeIISmoothDyadic ((y.1.2:ℝ)/Z) : ℂ) *
          typeIIRealShiftWeight
            (fun e n => typeIIEMajorant (L^88) (e/E) * typeIINMajorant (n/V)) α aH y *
            χ (y.2.1.1 : ZMod (2*k.natAbs)) * conj (χ (y.2.2.1 : ZMod (2*k.natAbs)))) -
        ∫ ξ in {ξ : EuclideanSpace ℝ (Fin 3) | ‖ξ‖ ≤ L^F},
          typeIICrossCharacterFourierIntegrand 1 L U V E Z k M H Zs
            typeIISmoothDyadic α aH χ ξ‖ ≤ Z * L^(-D) := by
  classical
  obtain ⟨F, hF, htruncate⟩ := exists_candidate_smooth_cross_fourier_truncation
    (K₀ := K₀) (A := A) (D := D) hc hq0 hq1 hCz
  refine ⟨F, hF, ?_⟩
  filter_upwards [htruncate] with L htruncate
  intro r jStar hr hj take hkeep twist htwist U V E Z k hU hV hZ hk hE hUV hZupper
    hZlog hksize M H Zs α ρ χ hM hα hH
  let aH : ℕ → ℂ := fun h => typeIIPhase ρ h *
    candidateRetainedComplexCoefficient c L q r jStar take twist h
  have hZ0 : 0 < Z := zero_lt_one.trans_le hZ
  have ht := htruncate r jStar hr hj take hkeep twist htwist U V E Z k hU hV hZ hk
    hE hUV hZupper hZlog hksize M H (typeIIActiveCrossZ Z k Zs) α ρ χ hM hα
    (fun z hz => ⟨(mem_filter.mp hz).2.1, (mem_filter.mp hz).2.2.1⟩)
    (fun z hz => (mem_filter.mp hz).2.2.2)
  have heq := typeII_smooth_cross_fourier_active_support 1 L U V E Z k M H Zs α aH χ hZ0 hH
  refine ⟨ht.1.congr (Eventually.of_forall (fun ξ => (heq ξ).symm)), ?_⟩
  have hsum := typeII_smooth_cross_sum_active_support M H Zs k Z
    (fun y => typeIIRealShiftWeight
        (fun e n => typeIIEMajorant (L^88) (e/E) * typeIINMajorant (n/V)) α aH y *
        χ (y.2.1.1 : ZMod (2*k.natAbs)) * conj (χ (y.2.2.1 : ZMod (2*k.natAbs)))) hZ0 hH
  simp only [← mul_assoc] at hsum
  change ‖_ - ∫ ξ in {ξ : EuclideanSpace ℝ (Fin 3) | ‖ξ‖ ≤ L^F},
    typeIICrossCharacterFourierIntegrand 1 L U V E Z k M H Zs typeIISmoothDyadic α aH χ ξ‖ ≤ _
  rw [hsum, integral_congr_ae (Eventually.of_forall heq)]
  exact ht.2

end Bounty
end

section

/- A transparent final algebraic reduction to the literal frequency-restricted cross integrals. -/

open Finset MeasureTheory

namespace Bounty

theorem typeII_majorant_energy_le_of_truncated_integrals
    (M H : Finset ℕ) (α aH : ℕ → ℂ) {L U V E W R ε : ℝ} {B : ℕ}
    (T : Set (EuclideanSpace ℝ (Fin 3)))
    (hL : 0 < L) (hU : 0 < U) (hV : 0 < V) (hE : 0 < E) (hUV : 4 ≤ U*V)
    (hM : ∀ m ∈ M, (m:ℝ) ∈ Set.Icc U (2*U))
    (hB : (2*U) / (2*(E/(2*L^88))) ≤ B) (hBW : (B:ℝ) ≤ W) (hW : 2 ≤ W)
    (hrough : ∀ m ∈ M, α m ≠ 0 → ∀ p ∈ m.primeFactors, W < (p:ℝ))
    (hR : 0 ≤ R)
    (herror : ‖typeIIEnergyFourierIntegral L U V E B M H α aH Set.univ -
      typeIIEnergyFourierIntegral L U V E B M H α aH T‖ ≤ ε)
    (hcorrelation : ∀ k ∈ Icc (-(B:ℤ)) B, k ≠ 0 →
      ∀ j ∈ range (typeIISmoothDyadicCount L),
      ∀ χ : DirichletCharacter ℂ (2*k.natAbs),
      let M₀ := M.filter (fun m => α m ≠ 0)
      let Zs := Icc 0 (M₀.sup id * H.sup id)
      ‖∫ ξ in T, typeIICrossCharacterFourierIntegrand 1 L U V E
          (typeIISmoothDyadicScale U V E j) k M₀ H Zs typeIISmoothDyadic α aH χ ξ‖ ≤
        typeIISmoothDyadicScale U V E j * R) :
    typeIIOffDiagonalEnergy (Icc ⌈E/(2*L^88)⌉₊ ⌊2*E⌋₊)
      (Icc ⌈V/2⌉₊ ⌊3*V⌋₊) M H
      (fun e n => typeIIEMajorant (L^88) ((e:ℝ)/E) * typeIINMajorant ((n:ℝ)/V)) α aH ≤
      (2*(B:ℝ)) * (∑ j ∈ range (typeIISmoothDyadicCount L), typeIISmoothDyadicScale U V E j) * R + ε := by
  rw [typeII_majorant_energy_eq_dyadic_fourier M H α aH hL hU hV hE hUV hM hB hBW hW hrough]
  have hb := typeII_energy_fourier_norm_le L U V E B M H α aH T hR
    (fun j _ => (typeII_smooth_dyadic_scale_pos hU hV hE j).le) hcorrelation
  have ht := norm_sub_le_norm_sub_add_norm_sub
    (typeIIEnergyFourierIntegral L U V E B M H α aH Set.univ)
    (typeIIEnergyFourierIntegral L U V E B M H α aH T) 0
  simp only [sub_zero] at ht
  exact (Complex.re_le_norm _).trans (by linarith)

end Bounty
end

section

/- The full Cauchy factor times the finite dyadic truncation error has arbitrary saving. -/

open Finset Real

namespace Bounty

theorem typeII_actual_dyadic_error_saving {L K aE A D T U V E : ℝ}
    (hL : 576 ≤ L) (hK : 0 ≤ K) (hU : 0 < U) (hV : 0 < V)
    (hE : E = U*L^(-K)) (hT : D+K+2*aE+2*A+177 ≤ T) :
    (2*E*V*(L^aE)^2*(L^A)^2) *
      ((2*(typeIIAdmissibleDeterminantBound L K : ℝ)) *
        (∑ j ∈ range (typeIISmoothDyadicCount L), typeIISmoothDyadicScale U V E j) * L^(-T)) ≤
      (U*V)^2*L^(-D) := by
  have hL1 : 1 ≤ L := by linarith
  have hL0 : 0 < L := by linarith
  have hE0 : 0 < E := by rw [hE]; positivity
  have hp : 1 ≤ L^(K+88) := one_le_rpow hL1 (by linarith)
  have hceil := Nat.ceil_lt_add_one (show 0 ≤ 2*L^(K+88) by positivity)
  have hB : (typeIIAdmissibleDeterminantBound L K : ℝ) ≤ 3*L^(K+88) := by
    change (⌈2*L^(K+88)⌉₊ : ℝ) ≤ _
    linarith
  have hsum := typeII_smooth_dyadic_scale_sum_le hL1 hU hV hE0
  let s : ℝ := (K+88)+88+aE*2+A*2+(-T)
  calc
    _ ≤ (2*E*V*(L^aE)^2*(L^A)^2) *
        ((2*(3*L^(K+88))) * (48*U^2*V*L^88/E) * L^(-T)) := by
      gcongr
      exact sum_nonneg (fun j _ => (typeII_smooth_dyadic_scale_pos hU hV hE0 j).le)
    _ = 576*(U*V)^2*L^s := by
      have hs (a : ℝ) : L^(a*2) = (L^a)^2 := by
        simpa only [Nat.cast_ofNat] using rpow_mul_natCast hL0.le a 2
      simp only [s, rpow_add hL0, hs, rpow_ofNat]
      field_simp
      ring
    _ ≤ L*(U*V)^2*L^s := by
      gcongr
    _ = (U*V)^2*L^(1+s) := by
      rw [rpow_add hL0 1 s, rpow_one]
      ring
    _ ≤ (U*V)^2*L^(-D) := by
      apply mul_le_mul_of_nonneg_left _ (sq_nonneg _)
      apply rpow_le_rpow_of_exponent_le hL1
      dsimp only [s]
      linarith


end Bounty
end

section

/- Uniform Lyapunov rows for an original owner, paying one common atom bound per selected child. -/

open Finset Classical

namespace Bounty

section Owner
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
    [∀ g, DecidableEq (P g)] {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
    (Δ D : ∀ k c, A k c → Fin N → ℤ) (ω : ∀ k c, A k c → ℝ)
    (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ v vmin : ℝ) (V η : Fin N → ℝ) (β : ℝ)
    (steps : List (Option (J ⊕ K)))
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))

theorem full_mixed_common_original_forest_bound_of_no_initial_child
    (hcode : ∀ i, fullMixedCommonIndexStage M B steps i = 0 → code i = none)
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hη : ∀ g, 0 ≤ η g) (hμatom : ∀ g p, μ g p ≤ η g)
    (hβ : 0 ≤ β)
    (hghostAtom : ∀ j g, (|(1 - q j) * V g / ρ| * η g) * v ≤ β)
    (hedgeAtom : ∀ g, η g ≤ β)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : ∀ g, vmin ≤ V g)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P))
    (F : FullPermutationMixedPath n S B A Δ D steps s → ℝ)
    {L : ℝ} (hL : 0 ≤ L)
    (hF : ∀ p, F p ≤ L * productLengthLyapunov v (finiteEventPathTerminal
      (FullPermutationMixedEvent n S B A Δ D) (fullPermutationMixedEventTarget n S B A Δ D) steps s p)) :
    fullMixedPathAbsIntegral n S B A Δ D ω μ q ρ V steps s
      (fun p => if birthForestCompatible
        (fun i => fullMixedCommonBirthPerformed n S B A Δ D steps s p (fullMixedCommonBirthOrder M B steps i))
        (fun i => fullMixedCommonBirthLabel n S B A Δ D steps s p (fullMixedCommonBirthOrder M B steps i)) code
        then F p else 0) ≤
      (β ^ birthForestRank code * ∏ u : Fin steps.length, fullMixedLengthRowFactor μ q ρ v vmin V T (steps.get u)) *
        (L * productLengthLyapunov v s) := by
  have hb := full_mixed_common_forest_path_integral_le_history_rows n S B A Δ D ω μ q ρ V steps code hcode
    (productLengthLyapunov v) (fullMixedCommonForestRowFactor M B steps code μ q ρ v vmin V T β)
    (full_mixed_common_forest_row_factor_nonneg M B steps code μ q ρ v vmin V T β hβ hρ1 (zero_lt_one.trans hv).le)
    (fun t tag s history => full_mixed_common_uniform_forest_row_le n S B A Δ D ω μ q ρ v vmin V η β steps code
      hω hωmass hμ hmass hη hμatom hβ hghostAtom hedgeAtom hq0 hq1 hρ0 hρ1 hv hvmin hV hD T ht t tag s history)
    s history F hL hF
  rw [full_mixed_common_forest_row_factor_product M B steps code μ q ρ v vmin V T β hcode] at hb
  exact hb

theorem full_mixed_common_original_forest_bound
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hη : ∀ g, 0 ≤ η g) (hμatom : ∀ g p, μ g p ≤ η g)
    (hβ : 0 ≤ β)
    (hghostAtom : ∀ j g, (|(1 - q j) * V g / ρ| * η g) * v ≤ β)
    (hedgeAtom : ∀ g, η g ≤ β)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : ∀ g, vmin ≤ V g)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (hs : FullActiveInjective s)
    (F : FullPermutationMixedPath n S B A Δ D steps s → ℝ)
    {L : ℝ} (hL : 0 ≤ L)
    (hF : ∀ p, F p ≤ L * productLengthLyapunov v (finiteEventPathTerminal
      (FullPermutationMixedEvent n S B A Δ D) (fullPermutationMixedEventTarget n S B A Δ D) steps s p)) :
    fullMixedPathAbsIntegral n S B A Δ D ω μ q ρ V steps s
      (fun p => if birthForestCompatible
        (fun i => fullMixedCommonBirthPerformed n S B A Δ D steps s p (fullMixedCommonBirthOrder M B steps i))
        (fun i => fullMixedCommonBirthLabel n S B A Δ D steps s p (fullMixedCommonBirthOrder M B steps i)) code
        then F p else 0) ≤
      (β ^ birthForestRank code * ∏ u : Fin steps.length, fullMixedLengthRowFactor μ q ρ v vmin V T (steps.get u)) *
        (L * productLengthLyapunov v s) := by
  by_cases hc : ∀ i, fullMixedCommonIndexStage M B steps i = 0 → code i = none
  · exact full_mixed_common_original_forest_bound_of_no_initial_child n S B A Δ D ω μ q ρ v vmin V η β steps code hc
      hω hωmass hμ hmass hη hμatom hβ hghostAtom hedgeAtom hq0 hq1 hρ0 hρ1 hv hvmin hV hD T ht s
      (fun _ => none) F hL hF
  · have hfalse : ∀ p : FullPermutationMixedPath n S B A Δ D steps s,
        ¬birthForestCompatible
          (fun i => fullMixedCommonBirthPerformed n S B A Δ D steps s p (fullMixedCommonBirthOrder M B steps i))
          (fun i => fullMixedCommonBirthLabel n S B A Δ D steps s p (fullMixedCommonBirthOrder M B steps i)) code := by
      intro p hp
      exact hc (full_mixed_common_compatible_initial_child_none n S B A Δ D steps s p hs code hp)
    simp only [if_neg (hfalse _)]
    have hz : fullMixedPathAbsIntegral n S B A Δ D ω μ q ρ V steps s (fun _ => 0) = 0 := by
      unfold fullMixedPathAbsIntegral finiteEventPathIntegral
      simp only [mul_zero, sum_const_zero]
    rw [hz]
    exact mul_nonneg
      (mul_nonneg (pow_nonneg hβ _) (prod_nonneg fun u _ =>
