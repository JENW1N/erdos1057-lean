variable {E G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  (Δ D : E → G → ℤ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (t : G → ℕ) (B : ℕ) (groups : Finset G)

noncomputable def unrestrictedPositiveEdgeList
    (edges : List E)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ) :=
  finiteOperatorListAction
    (fun e => unrestrictedCutoffProductOperator n (Δ e) (D e) μ ρ V t B
      (fun _ _ _ _ _ _ => 1) groups) edges f

theorem unrestricted_positive_edge_list_symmetric
    (edges : List E)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric (unrestrictedPositiveEdgeList n Δ D μ ρ V t B groups edges f) := by
  apply finite_operator_list_preserves ProductMemorySymmetric
  · intro e q hq
    exact unrestricted_positive_cutoff_product_symmetric n (Δ e) (D e) μ ρ V t B groups q hq
  · exact hf

theorem unrestricted_positive_edge_list_energy_le
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, t g ≤ T) (edges : List E)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (unrestrictedPositiveEdgeList n Δ D μ ρ V t B groups edges f) ≤
      (unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ groups.card) ^ edges.length *
        finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  apply finite_operator_list_uniform_energy_le
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) ProductMemorySymmetric
    (fun e => unrestrictedCutoffProductOperator n (Δ e) (D e) μ ρ V t B
      (fun _ _ _ _ _ _ => 1) groups)
  · intro e q hq
    exact unrestricted_positive_cutoff_product_symmetric n (Δ e) (D e) μ ρ V t B groups q hq
  · exact pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _
  · intro e q hq
    exact unrestricted_cutoff_product_energy_le n (Δ e) (D e) μ ρ V t B
      hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht (fun _ _ _ _ _ _ => 1)
      (by intros; simp) groups q hq
  · exact hf

end
