include hP hdis hk hb hb0

theorem physical_root_residue_model_capped_normalization (B : ℕ)
    (hB : Fintype.card (PhysicalPrime P) ≤ B) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
