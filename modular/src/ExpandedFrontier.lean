  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (retention : I → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
  (hV : ∀ g, V g ≠ 0)

theorem physical_observed_mark_row_intertwines
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (tag : Option (I ⊕ K)) (before after : Fin N → Finset (Fin J))
    (hencode : PhysicalMarkRowEncoding C tag before after)
    (F : PhysicalMarkObservation P ell C →
      FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) :
    physicalObservedMarkRow C k ω β retention ρ V hV tag
      (fun o => F o ∘ physicalBoundedMarkEncode after) s =
    physicalFullObservedRow C k ω β retention ρ V before after tag F
      (physicalBoundedMarkEncode before s) := by
  cases tag with
  | none =>
    rw [physical_full_observed_permutation_row]
    exact physical_full_transition_phase_reindex before after s.1 s.2.2
      (fun σ x => F (.inl σ) (s.2.1, x))
  | some tag =>
    cases tag with
    | inl j =>
      change before = after at hencode
      subst after
      rw [physical_full_observed_ghost_row]
      exact physical_full_global_ghost_row C k ω β retention ρ V j before s.1 s.2.1 s.2.2
        (fun g => physicalGroupPhaseActivity s.1 g) hV (F (.inr none))
    | inr j =>
      change before = C j ∧ after = C j at hencode
      rcases hencode with ⟨rfl, rfl⟩
      refine (physical_full_all_endpoints_edge_observed_continuation (C j) (k j)
        s.1 s.2.1 s.2.2 hP hdis β ρ V (ω j)
        (fun aux => F (.inr (some ⟨j, aux⟩)))).trans ?_
      unfold physicalFullObservedRow fullMixedObservedRow
      apply sum_congr
      · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
      · intro e _
        change _ = _ * physicalFullGlobalEdgePhase (C j) (k j) s.2.1 (ω j)
          (fun g p => β g p / V g) ρ V (physicalFullMemoryState (C j) s.1 s.2.2) e * _
        rw [physical_full_global_edge_phase_encode]
        rfl

end Physical
