/- Nonzero actual physical local phases preserve the physical injective active state. -/

open Finset
open scoped Classical
namespace Bounty
section Edge
variable {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin N → Finset (Fin J)) (k : ℤ)
  (H : (g : Fin N) → Finset ↥(P g))
  (ω : ∀ _c : SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C g)), PhysicalAuxLabels P C → ℝ)
  (μ : (g : Fin N) → ↥(P g) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

theorem physical_endpoint_phase_target_injective
    (L : PhysicalMarkLists P J ell)
    (q : (g : Fin N) → BoundedOrderedTuple
      (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B)
    (e : PhysicalFullEdgeEvent C k (physicalFullMemoryState C L q))
    (hp : physicalFullEndpointPhase C k L H q ω μ ρ V e ≠ 0) :
    FullActiveInjective (fullActiveEdgeEventTarget (fun g (p : ↥(P g)) => p.val)
      (fun g => physicalFullSharedIndices (C g)) B (fun _ => PhysicalAuxLabels P C)
      (physicalFullEdgeDelta C k) (physicalFullEdgeD C) (physicalFullMemoryState C L q) e) := by
  have hw : fullActiveEdgeEventWeight (fun g (p : ↥(P g)) => p.val)
      (fun g => physicalFullSharedIndices (C g)) B (fun _ => PhysicalAuxLabels P C)
      (physicalFullEdgeDelta C k) (physicalFullEdgeD C) ω μ ρ V
      (physicalFullMemoryState C L q) e ≠ 0 := by
    intro h
    apply hp
    simp only [physicalFullEndpointPhase, if_pos h]
  have hsum : (∑ R : PhysicalMarkLists P J ell, physicalFullEdgePhase C k L R H q e) ≠ 0 := by
    simpa only [physicalFullEndpointPhase, if_neg hw] using hp
  obtain ⟨R, _, hR⟩ := exists_ne_zero_of_sum_ne_zero hsum
  rw [physical_full_edge_target_of_nonzero C k L R H q ω μ ρ V e hw hR]
  exact physical_full_state_injective C R _

theorem physical_global_phase_target_injective
    (x : PhysicalFullBoundedState P J ell B) (e : PhysicalFullEdgeEvent C k x)
    (hp : physicalFullGlobalEdgePhase C k H ω μ ρ V x e ≠ 0) :
    FullActiveInjective (fullActiveEdgeEventTarget (fun g (p : ↥(P g)) => p.val)
      (fun g => physicalFullSharedIndices (C g)) B (fun _ => PhysicalAuxLabels P C)
      (physicalFullEdgeDelta C k) (physicalFullEdgeD C) x e) := by
  have hx : FullActiveInjective x := by
    by_contra hn
    apply hp
    simp only [physicalFullGlobalEdgePhase, dif_neg hn]
  have hencoded (L : PhysicalMarkLists P J ell)
      (q : (g : Fin N) → BoundedOrderedTuple
        (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B)
      (e : PhysicalFullEdgeEvent C k (physicalFullMemoryState C L q))
      (he : physicalFullGlobalEdgePhase C k H ω μ ρ V (physicalFullMemoryState C L q) e ≠ 0) :
      FullActiveInjective (fullActiveEdgeEventTarget (fun g (p : ↥(P g)) => p.val)
        (fun g => physicalFullSharedIndices (C g)) B (fun _ => PhysicalAuxLabels P C)
        (physicalFullEdgeDelta C k) (physicalFullEdgeD C) (physicalFullMemoryState C L q) e) := by
    rw [physical_full_global_edge_phase_encode] at he
    exact physical_endpoint_phase_target_injective C k H ω μ ρ V L q e he
  have h := hencoded (physicalFullStateLabels C x hx) (fun g => (x g).2)
  rw [physical_full_state_encode_labels C x hx] at h
  exact h e hp

end Edge
section Physical
variable {I K : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

theorem physical_local_phase_target_injective (tag : Option (I ⊕ K))
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (e : PhysicalFullLedgerEvent C k tag s)
    (hs : FullActiveInjective s.2)
    (hp : physicalFullLedgerEventPhase C k ω β ρ V tag s e ≠ 0) :
    FullActiveInjective (physicalFullLedgerEventTarget C k tag s e).2 := by
  cases tag with
  | none =>
    intro g
    exact (hs g).comp (e.down g).injective
  | some tag =>
    cases tag with
    | inl i =>
      intro g
      change Function.Injective ((fullPermutationMixedEventTarget _ _ _ _ _ _
        (some (.inl i)) s.2 e g).1)
      rw [fullPermutationMixedEventTarget_ghost_active]
      exact hs g
    | inr j =>
      exact physical_global_phase_target_injective (C j) (k j) s.1 (ω j)
        (fun g p => β g p / V g) ρ V s.2 e hp

end Physical
end Bounty
