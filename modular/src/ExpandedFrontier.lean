/- The chronological small residue phase is a phase on the original full
path. Bookkeeping-ledger removal preserves its entire displacement history. -/

open scoped Classical
namespace Bounty
section Original
variable {S : Type} [Fintype S] {Ps : S → Finset ℕ}
  {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (cut : ℕ → Fin N → Finset (Fin J))
  (Cs : Fin n → S → Finset (Fin J)) (Vs : S → ℝ) (q : ℝ)
  (ds : PhysicalGroupSelectedData Ps ell Cs)

noncomputable def physicalFullSmallUpdate
    (tag : Option (Fin (n + 1) ⊕ Fin n)) (r : PhysicalResidues Ps)
    (x : PhysicalFullBoundedState P J ell B)
    (e : PhysicalFullLedgerEvent C k tag (fullActiveInitialLedger x, x)) : PhysicalResidues Ps :=
  physicalSelectedSmallLocalUpdate C k cut tag r (fullActiveInitialLedger x, x) e

noncomputable def physicalFullSmallPhase
    (tag : Option (Fin (n + 1) ⊕ Fin n)) (r : PhysicalResidues Ps)
    (x : PhysicalFullBoundedState P J ell B)
    (e : PhysicalFullLedgerEvent C k tag (fullActiveInitialLedger x, x)) : ℂ :=
  physicalSelectedSmallLocalPhase C k cut Cs Vs q ds tag r (fullActiveInitialLedger x, x) e

omit [Fintype S] in
theorem physical_small_update_forgets_ledger
    (tag : Option (Fin (n + 1) ⊕ Fin n)) (r : PhysicalResidues Ps)
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (e : PhysicalFullLedgerEvent C k tag s) :
    physicalSelectedSmallLocalUpdate C k cut tag r s e =
      physicalFullSmallUpdate C k cut tag r s.2 e := by
  cases tag with
  | none => rfl
  | some tag => cases tag <;> rfl

theorem physical_small_phase_forgets_ledger
    (tag : Option (Fin (n + 1) ⊕ Fin n)) (r : PhysicalResidues Ps)
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (e : PhysicalFullLedgerEvent C k tag s) :
    physicalSelectedSmallLocalPhase C k cut Cs Vs q ds tag r s e =
      physicalFullSmallPhase C k cut Cs Vs q ds tag r s.2 e := by
  cases tag with
  | none => rfl
  | some tag => cases tag <;> rfl

theorem physical_original_small_ledger
    (r : PhysicalResidues Ps) (x : PhysicalFullBoundedState P J ell B)
    (p : FullPermutationMixedPath (fun g (p : ↥(P g)) => p.val)
      (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j))
      ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)) x) :
    deterministicLedgerPhase
        (FullPermutationMixedEvent (fun g (p : ↥(P g)) => p.val)
          (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
          (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j)))
        (fullPermutationMixedEventTarget (fun g (p : ↥(P g)) => p.val)
          (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
          (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j)))
        (physicalFullSmallUpdate C k cut) (physicalFullSmallPhase C k cut Cs Vs q ds)
        ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)) r x p =
      physicalSelectedSmallWeight Cs Vs q r
        (Fin.partialSum (physicalRecordDisplacement C k cut (physicalOriginalFineRecord C k cut x p))) ds := by
  let E := FullPermutationMixedEvent (J := Fin (n + 1)) (fun g (p : ↥(P g)) => p.val)
    (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
    (fun j => physicalFullEdgeDelta (ell := ell) (C j) (k j)) (fun j => physicalFullEdgeD (ell := ell) (C j))
  let target := fullPermutationMixedEventTarget (J := Fin (n + 1)) (fun g (p : ↥(P g)) => p.val)
    (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
    (fun j => physicalFullEdgeDelta (ell := ell) (C j) (k j)) (fun j => physicalFullEdgeD (ell := ell) (C j))
  let history := fullMixedLedgerUpdate (J := Fin (n + 1)) (fun g (p : ↥(P g)) => p.val)
    (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
    (fun j => physicalFullEdgeDelta (ell := ell) (C j) (k j)) (fun j => physicalFullEdgeD (ell := ell) (C j))
  let steps := (List.range (4 * n + 1)).map (physicalSelectedFineTag n)
  let lift := (finiteLedgerEventPathEquiv E target history steps (fullActiveInitialLedger x) x).symm p
  let pos := (finiteEventPathMapEquiv (PhysicalFullLedgerEvent C k) (physicalFullLedgerEventTarget C k)
    (physicalSelectedFineTag n) (List.range (4 * n + 1)) (fullActiveInitialLedger x, x)).symm lift
  have hpos := physical_record_small_ledger C k cut Cs Vs q ds r (fullActiveInitialLedger x, x) pos
  dsimp only at hpos
  have hu (tag) : physicalSelectedSmallLocalUpdate (P := P) (ell := ell) (Ps := Ps) (B := B) C k cut tag =
      (fun r s e => physicalFullSmallUpdate C k cut tag r s.2 e) := by
    funext r s e
    exact physical_small_update_forgets_ledger C k cut tag r s e
  have hφ (tag) : physicalSelectedSmallLocalPhase (P := P) (B := B) C k cut Cs Vs q ds tag =
      (fun r s e => physicalFullSmallPhase C k cut Cs Vs q ds tag r s.2 e) := by
    funext r s e
    exact physical_small_phase_forgets_ledger C k cut Cs Vs q ds tag r s e
  simp_rw [hu, hφ] at hpos
  have hmap := deterministic_ledger_phase_map (PhysicalFullLedgerEvent C k)
    (physicalFullLedgerEventTarget C k)
    (fun tag r s e => physicalFullSmallUpdate C k cut tag r s.2 e)
    (fun tag r s e => physicalFullSmallPhase C k cut Cs Vs q ds tag r s.2 e)
    (physicalSelectedFineTag n) (List.range (4 * n + 1)) r (fullActiveInitialLedger x, x) pos
  have hforget := deterministic_ledger_phase_forget E target history
    (physicalFullSmallUpdate C k cut) (physicalFullSmallPhase C k cut Cs Vs q ds)
    steps (fullActiveInitialLedger x) r x lift
  simp only [pos] at hmap
  erw [Equiv.apply_symm_apply] at hmap
  simp only [lift, Equiv.apply_symm_apply] at hforget
  exact hforget.symm.trans (hmap.symm.trans hpos)

end Original
end Bounty
