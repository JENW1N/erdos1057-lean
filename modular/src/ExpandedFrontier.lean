    apply sum_congr rfl
    intro n hn
    rw [ambient_prime_original_phase_coefficient κM L S ν χM
      ((Nat.zero_le lo).trans_lt (mem_Ioc.mp hn).1)]
  have hPeq (u : ℝ) := prime_reciprocal_polynomial_eq_harmonic_sum s
    (fun n : ℕ => (1/(((∑ p ∈ candidatePBand (c*L) g, 1/(p : ℝ)) : ℝ) : ℂ))*
