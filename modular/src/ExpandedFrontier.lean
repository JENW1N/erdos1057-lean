section Owner
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
    [∀ g, DecidableEq (P g)] {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
    (Δ D : ∀ k c, A k c → Fin N → ℤ) (ω : ∀ k c, A k c → ℝ)
    (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ v vmin : ℝ) (V η : Fin N → ℝ) (β : ℝ)
    (steps : List (Option (J ⊕ K)))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))

theorem full_mixed_original_forest_bound
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hη : ∀ g, 0 ≤ η g) (hμatom : ∀ g p, μ g p ≤ η g)
    (hβ : 0 ≤ β)
    (hghostAtom : ∀ j g, (|(1 - q j) * V g / ρ| * η g) * v ≤ β)
    (hedgeAtom : ∀ g, η g ≤ β)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : ∀ g, vmin ≤ V g)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P))
    (F : FullPermutationMixedPath n S B A Δ D steps s → ℝ)
    {L : ℝ} (hL : 0 ≤ L)
    (hF : ∀ p, F p ≤ L * productLengthLyapunov v (finiteEventPathTerminal
      (FullPermutationMixedEvent n S B A Δ D) (fullPermutationMixedEventTarget n S B A Δ D) steps s p)) :
    fullMixedPathAbsIntegral n S B A Δ D ω μ q ρ V steps s
      (fun p => if birthForestCompatible
        (fun i => fullMixedPathBirthPerformed n S B A Δ D steps s p (fullMixedBirthOrder S B steps i))
        (fun i => fullMixedPathBirthLabel n S B A Δ D steps s p (fullMixedBirthOrder S B steps i)) code
        then F p else 0) ≤
      (β ^ birthForestRank code * ∏ u : Fin steps.length, fullMixedLengthRowFactor μ q ρ v vmin V T (steps.get u)) *
        (L * productLengthLyapunov v s) := by
  have hb := full_mixed_forest_path_integral_le_history_rows n S B A Δ D ω μ q ρ V steps code
    (productLengthLyapunov v) (fullMixedForestRowFactor S B steps code μ q ρ v vmin V T β)
    (full_mixed_forest_row_factor_nonneg S B steps code μ q ρ v vmin V T β hβ hρ1 (zero_lt_one.trans hv).le)
    (fun t tag s history => full_mixed_uniform_forest_row_le n S B A Δ D ω μ q ρ v vmin V η β steps code
      hω hωmass hμ hmass hη hμatom hβ hghostAtom hedgeAtom hq0 hq1 hρ0 hρ1 hv hvmin hV hD T ht t tag s history)
    s history F hL hF
  rw [full_mixed_forest_row_factor_product] at hb
  exact hb

