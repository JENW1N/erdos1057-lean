section

/- Actual exceptional-set energy from the proved logarithmic sparse estimate. -/

open Finset Set MeasureTheory

namespace Bounty

theorem prime_exceptional_integral_logarithmic_bound (s : Finset ℕ)
    (coeff : s → ℂ) (η R : ℝ) (a b N : ℕ) (c : ℕ → ℂ) {U V : ℝ}
    (hU : 1 ≤ U) (ha : U ≤ (a : ℝ)) (hb : (b : ℝ) ≤ 2 * U)
    (hwidth : 2 * (⌈R⌉₊ : ℝ) + 2 ≤ N)
    (hcard : ((primeExceptionalIntervals s coeff η R).card : ℝ) *
      (216 * Real.sqrt N) ≤ U)
    (henergy : (∑ n ∈ Finset.Icc a b, ‖c n‖ ^ 2) ≤ V / U) :
    (∫ t in primeExceptionalTimes s coeff η R,
      ‖∑ n ∈ Finset.Icc a b, c n *
        Complex.exp ((Real.log (n : ℝ) * t : ℝ) * Complex.I)‖ ^ 2) ≤
      (72 * Real.pi * (1 + 2 * (1 + Real.log N)) + 1) * V := by
  have hsub : primeExceptionalIntervals s coeff η R ⊆
      Finset.Icc (-(⌈R⌉₊ : ℤ) - 1) (⌈R⌉₊ : ℤ) := by
    intro j hj
    exact ((mem_occupiedUnitIntervals _ _ _).mp hj).1
  apply (prime_exceptional_integral_le_unit_suprema s coeff η R _ (by fun_prop)).trans
  apply logarithmic_sparse_interval_energy_bound (primeExceptionalIntervals s coeff η R)
    a b c N (l := -(⌈R⌉₊ : ℝ) - 1) (r := (⌈R⌉₊ : ℝ) + 1) hU ha hb
  · intro j hj
    exact (prime_exceptional_window_bounds R j (hsub hj)).1
  · intro j hj
    have hh := (prime_exceptional_window_bounds R j (hsub hj)).2
    linarith
  · linarith
  · exact hcard
  · exact henergy

end Bounty
end

section

/- The proven progression estimate applies to every residue class of an actual divisor interval. -/

open Finset Filter

namespace Bounty

theorem exists_divisor_residue_logarithmic_bound (τ : ℝ) (hτ : 0 < τ) :
    ∃ δ D N0 : ℝ, 0 < δ ∧ 0 < D ∧ 1 ≤ N0 ∧
      ∀ (Y x u : ℝ) (a b d q : ℕ) [NeZero q] (r : ZMod q),
      0 < d → Y ≤ (a : ℝ)+1 → (b : ℝ) ≤ 2*Y →
      N0 ≤ Y/((d : ℝ)*(q : ℝ)) →
      1 ≤ x → x^(τ/2) ≤ Y/((d : ℝ)*(q : ℝ)) → u ≠ 0 → |u| ≤ x^2 →
      ‖∑ n ∈ (Ioc (a/d) (b/d)).filter (fun n : ℕ => (n : ZMod q) = r),
        Complex.exp (((u*Real.log ((n : ℝ)*(d : ℝ)) : ℝ) : ℂ)*Complex.I)‖ ≤
        D*(Y/((d : ℝ)*(q : ℝ)))*(1/|u|+(Y/((d : ℝ)*(q : ℝ)))^(-δ)) := by
  obtain ⟨δ,D,hδ,hD,hphase⟩ := eventually_long_affine_logarithmic_phase τ 3 hτ (by norm_num)
  obtain ⟨N0,hN0⟩ := eventually_atTop.mp hphase
  refine ⟨δ,D,max 1 N0,hδ,hD,le_max_left _ _,?_⟩
  intro Y x u a b d q hqInst r hd hYa hbY hN hx hxN hu hux
  have hdR : 0 < (d : ℝ) := by exact_mod_cast hd
  have hqNat : 0 < q := Nat.pos_of_ne_zero (NeZero.ne q)
  have hqR : 0 < (q : ℝ) := by exact_mod_cast hqNat
  have hprod : 0 < (d : ℝ)*(q : ℝ) := mul_pos hdR hqR
  have hN1 : 1 ≤ Y/((d : ℝ)*(q : ℝ)) := (le_max_left _ _).trans hN
  have hscale : (d : ℝ)*(q : ℝ) ≤ Y := by
    have hh := (le_div_iff₀ hprod).mp hN1
    simpa only [one_mul] using hh
  let l : ℤ := (((a/d : ℕ) : ℤ)-(r.val : ℤ))/(q : ℤ)+1
  let v : ℤ := (((b/d : ℕ) : ℤ)-(r.val : ℤ))/(q : ℤ)
  have hgeometry := progression_real_scale (a : ℤ) (b : ℤ) (d : ℤ) (q : ℤ) (r.val : ℤ)
    (by exact_mod_cast hd) (by exact_mod_cast hqNat)
    (by simpa only [Int.cast_natCast] using hYa)
    (by simpa only [Int.cast_natCast] using hbY)
    (by simpa only [Int.cast_natCast] using hscale)
  have hoffset : (d : ℝ)*(r.val : ℝ)/((d : ℝ)*(q : ℝ)) = (r.val : ℝ)/(q : ℝ) := by
    field_simp
  have hgeom : Y/((d : ℝ)*(q : ℝ)) ≤ (l : ℝ)+(r.val : ℝ)/(q : ℝ) ∧
      (v : ℝ)+1+(r.val : ℝ)/(q : ℝ) ≤ 3*(Y/((d : ℝ)*(q : ℝ))) := by
    simpa only [l,v,Int.natCast_ediv,Int.cast_natCast] using hgeometry
  have hb := hN0 (Y/((d : ℝ)*(q : ℝ))) ((le_max_right _ _).trans hN)
    x ((d : ℝ)*(q : ℝ)) ((d : ℝ)*(r.val : ℝ)) u l v hx hxN hprod hu hux
    (by simpa only [hoffset] using hgeom.1) (by simpa only [hoffset] using hgeom.2)
  have he := natural_residue_interval_sum (a/d) (b/d) r
    (fun z : ℤ => Complex.exp (((u*Real.log ((z : ℝ)*(d : ℝ)) : ℝ) : ℂ)*Complex.I))
  simp only [Int.cast_natCast] at he
  rw [he]
  convert hb using 1
  congr 1
  apply sum_congr rfl
  intro n hn
  congr 3
  push_cast
  ring_nf

end Bounty
end

