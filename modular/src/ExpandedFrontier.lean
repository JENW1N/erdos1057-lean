      physicalSmallBigAction V q ζ aux κ E target a k F ((r, L), x)) =
    ∑ d, (starRingEnd ℂ) (physicalSmallCondition V q r d f) *
      (κ d * physicalPhase ζ (physicalSharedProduct d)) *
      (∑ e : E d x, a r d x e * physicalSmallCondition V q (tr d) d
        (fun R => F ((tr d, R), target d x e))) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  intro tr
  have h := physical_small_bilinear_events_with_prefix V hV q ζ (k x) r aux κ
    (fun d => E d x) (fun d _ e => a r d x e) f
    (fun d e s R => F ((s, R), target d x e))
  change _ = _ at h
  erw [← h]
  apply sum_congr rfl
  intro L _
  simp only [physicalSmallBigAction, Fintype.sum_prod_type, physicalSmallBigEventWeight,
    physicalSmallBigTarget, mul_sum]
  apply sum_congr rfl
  intro R _
  apply sum_congr rfl
  intro e _
  ring

