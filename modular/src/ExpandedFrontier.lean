section

/- Principal-character Mellin discrepancy for the actual global prime proxy. -/

open Finset Filter

namespace Bounty

theorem eventually_prime_proxy_mellin_difference_bound {a S T Bsave : ℝ}
    (ha : 0 < a) (hS : 0 ≤ S) (hT : 0 ≤ T) (hprecision : T+Bsave+2 ≤ S) :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, Real.exp (a*L) ≤ Y →
      ∀ v : ℝ, |v| ≤ L^T → ∀ m n : ℕ, m ≤ n → Y ≤ (m+1 : ℕ) → (n : ℝ) ≤ 2*Y →
        ‖∑ i ∈ Ioc m n,
          (((if i.Prime then 1 else 0 : ℝ)-primeLogarithmicProxy L S i : ℝ) : ℂ)*
            harmonicMellinWeight v i‖ ≤ L^(-Bsave) := by
  filter_upwards [eventually_prime_logarithmic_proxy_prefix_bound ha hS,
    eventually_linear_exponential_profile_le_rpow ha ha 20 0 (Bsave+T),
    eventually_ge_atTop (10 : ℝ)] with L hpref hprofile hL10
  have hL : 0 < L := by linarith
  have hL1 : 1 ≤ L := by linarith
  intro Y hY v hv m n hmn hYm hn
  have hY0 : 0 < Y := (Real.exp_pos _).trans_le hY
  by_cases heq : m = n
  · subst n
    simp only [Ioc_self, sum_empty, norm_zero]
    positivity
  have hmn' : m < n := lt_of_le_of_ne hmn heq
  let g := fun i : ℕ => (((if i.Prime then 1 else 0 : ℝ)-primeLogarithmicProxy L S i : ℝ) : ℂ)
  have hh := norm_harmonic_mellin_interval_sum_le g hY0 hmn' hYm hn
    (v := v) (B := 8*L^(-S)*Y+2) (by positivity)
    (fun i hi => hpref Y hY m i hYm ((Nat.cast_le.mpr (mem_Icc.mp hi).2).trans hn))
  have hpow : 1 ≤ L^T := Real.one_le_rpow hL1 hT
  have hgain : 3+2*|v| ≤ 5*L^T := by nlinarith
  have hfirst : 40*L^T*L^(-S) ≤ L^(-Bsave)/2 := by
    have hcomp : L^(T-S) ≤ L^(-Bsave)/L^2 := by
      rw [show L^(-Bsave)/L^2 = L^(-Bsave+(-2)) by
        rw [Real.rpow_add hL, Real.rpow_neg hL.le]
        norm_num
        ring]
      apply Real.rpow_le_rpow_of_exponent_le hL1
      linarith
    calc
      _ = 40*L^(T-S) := by rw [sub_eq_add_neg, Real.rpow_add hL]; ring
      _ ≤ 40*(L^(-Bsave)/L^2) := mul_le_mul_of_nonneg_left hcomp (by norm_num)
      _ ≤ L^(-Bsave)/2 := by
        have hC : (40 : ℝ)/L^2 ≤ 1/2 := by
          apply (div_le_iff₀ (by positivity : (0 : ℝ) < L^2)).mpr
          nlinarith
        calc
          _ = (40/L^2)*L^(-Bsave) := by ring
          _ ≤ (1/2)*L^(-Bsave) := mul_le_mul_of_nonneg_right hC (by positivity)
          _ = _ := by ring
  have hsecond : 10*L^T/Y ≤ L^(-Bsave)/2 := by
    simp only [zero_mul, add_zero] at hprofile
    have hrecip : 1/Y ≤ Real.exp (-a*L) := by
      have hh := one_div_le_one_div_of_le (Real.exp_pos (a*L)) hY
      simpa only [one_div, Real.exp_neg, neg_mul] using hh
    calc
      _ = (L^T/2)*(20*(1/Y)) := by ring
      _ ≤ (L^T/2)*(20*Real.exp (-a*L)) := by gcongr
      _ ≤ (L^T/2)*L^(-(Bsave+T)) := mul_le_mul_of_nonneg_left hprofile (by positivity)
      _ = L^(-Bsave)/2 := by
        rw [div_mul_eq_mul_div, ← Real.rpow_add hL]
        congr 2
        ring
  calc
    _ = ‖∑ i ∈ Ioc m n, harmonicMellinWeight v i*g i‖ := by
      congr 1
      apply sum_congr rfl
      intro i _
      exact mul_comm _ _
    _ ≤ ((3+2*|v|)/Y)*(8*L^(-S)*Y+2) := hh
    _ ≤ ((5*L^T)/Y)*(8*L^(-S)*Y+2) := by gcongr
    _ = 40*L^T*L^(-S)+10*L^T/Y := by field_simp; ring
    _ ≤ L^(-Bsave)/2+L^(-Bsave)/2 := add_le_add hfirst hsecond
    _ = L^(-Bsave) := by ring

end Bounty
end

section

/- Exact physical history normalization under adjacent common-mark compatibility.
No global residue assignment is supplied; all original local rows and cutoffs remain. -/

open Finset
open scoped Classical
namespace Bounty

section ResiduePath
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (hcompat : ∀ j : Fin n, ∀ g s t,
    ((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val =
      ((physicalPermuteLabels (τ j) (L j.succ)) g t).val →
    (((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val : ℤ) ∣
      k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ) (η : Fin N → Fin (n + 1) → ℝ)
  (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0) (B : ℕ)

variable
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)

include hstep in
theorem physical_selected_adjacent_edge_block (j : Fin n)
    (F : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) (hs : s.1 = L j.castSucc) :
    physicalSelectedEdgeBlock C k ω β retention ρ V hV j (aux j) (σ j) (τ j) (L j.succ) F s =
      (((Fintype.card (PhysicalPermutations (Fin N) J ell) : ℝ)⁻¹ : ℂ) ^ 2) *
        (ω j (productActiveMemorySplit (fun g => physicalFullSharedIndices (C j g)) B
          (physicalFullMemoryState (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) s.2.2)).1
          (aux j) : ℂ) *
      globalBirthJointCutRawRow
        (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β η V
          (fun _ => ρ) hV B (2 * j.val + 1)) B B F (physicalMarkRawReadout s) := by
  rw [physical_selected_edge_block_eq, hs, if_pos (hlist j)]
  rw [physical_joint_adjacent_edge_literal_tensor C aux k L a σ τ hstep hcompat hlist hP hdis hk β η V ρ hV B]

theorem physical_selected_adjacent_visit (j : Fin (n + 1))
    (F : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) :
    physicalObservedMarkRow C k ω β retention ρ V hV (some (.inl j))
      (fun o t => if o = .inr none ∧ t.1 = (L j) then F (physicalMarkRawReadout t) else 0)
      (L j, s.2) =
      globalBirthJointCutRawRow
        (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β
          (fun _ i => 1 - retention i) V (fun _ => ρ) hV B (2 * j.val))
        B B F (physicalMarkRawReadout s) := by
  have hv := physical_observed_selected_visit C k ω β retention ρ V hV j F (L j, s.2)
  have hr := physical_joint_adjacent_visit_literal_tensor C aux k L a σ τ hcompat hlist
    hP hdis hk β (fun _ i => 1 - retention i) V ρ hV B j
    (fun g => physicalGroupPhaseActivity (L j) g) F (physicalMarkRawReadout s)
  convert hv.trans hr.symm using 1
  congr 1
  funext o t
  split_ifs <;> rfl

include hstep in
theorem physical_selected_adjacent_state_edge_block (j : Fin n)
    (F : PhysicalBoundedMarkState P J ell B → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) (hs : s.1 = L j.castSucc) :
    physicalSelectedStateEdgeBlock C k ω β retention ρ V hV j (aux j) (σ j) (τ j) (L j.succ) F s =
      (((Fintype.card (PhysicalPermutations (Fin N) J ell) : ℝ)⁻¹ : ℂ) ^ 2) *
        (ω j (productActiveMemorySplit (fun g => physicalFullSharedIndices (C j g)) B
          (physicalFullMemoryState (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) s.2.2)).1
          (aux j) : ℂ) *
      globalBirthJointCutRawRow
        (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β η V
          (fun _ => ρ) hV B (2 * j.val + 1)) B B
        (physicalMarkRawExtension F (L j.succ)) (physicalMarkRawReadout s) := by
  rw [physical_selected_state_edge_block_readout]
  exact physical_selected_adjacent_edge_block C aux k L a σ τ hstep hcompat hlist hP hdis hk
    β η V ρ hV B ω retention j (physicalMarkRawExtension F (L j.succ)) s hs

theorem physical_selected_adjacent_state_visit (j : Fin (n + 1))
    (F : PhysicalBoundedMarkState P J ell B → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) :
    physicalObservedMarkRow C k ω β retention ρ V hV (some (.inl j))
      (fun o t => if o = .inr none ∧ t.1 = L j then F t else 0) (L j, s.2) =
      globalBirthJointCutRawRow
        (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β
          (fun _ i => 1 - retention i) V (fun _ => ρ) hV B (2 * j.val))
        B B (physicalMarkRawExtension F (L j)) (physicalMarkRawReadout s) := by
  have hv := physical_observed_selected_state_visit C k ω β retention ρ V hV j F (L j, s.2)
  have hr := physical_joint_adjacent_visit_literal_tensor C aux k L a σ τ hcompat hlist
    hP hdis hk β (fun _ i => 1 - retention i) V ρ hV B j
    (fun g => physicalGroupPhaseActivity (L j) g)
    (physicalMarkRawExtension F (L j)) (physicalMarkRawReadout s)
  convert hv.trans hr.symm using 1
  congr 1
  funext o t
  split_ifs <;> rfl

end ResiduePath
end Bounty
