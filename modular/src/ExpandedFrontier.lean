/- Empty small cuts reduce only the small factor; the big coefficient remains fully coupled. -/

open Finset
open scoped Classical
namespace Bounty

section Empty
variable {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
  (V : G → ℝ) (C : G → Finset (Fin J)) (hC : ∀ g, C g = ∅)
  (a : PhysicalAuxLabels P C) (L R : PhysicalMarkLists P J ell)

include hC in
theorem physical_bare_neutral_empty_cut :
    physicalBarePatternScalar V C 0 (fun _ _ _ => 1) a L R =
      if physicalSharedPrefix L = physicalSharedPrefix R then ((∏ g, 1 / (V g) ^ ell : ℝ) : ℂ) else 0 := by
  have hCe : C = fun _ => ∅ := funext hC
  subst C
  simpa only [physicalCompletionMass, card_empty, Nat.add_zero, mul_one,
    physical_phase_zero_frequency] using
    (physical_bare_empty_prefix V 0 a (fun _ => 1) L R)

include hC in
theorem physical_D_empty_cut : physicalD C L a = physicalSharedProduct (physicalSharedPrefix L) := by
  have hCe : C = fun _ => ∅ := funext hC
  subst C
  exact physical_D_empty a L

end Empty

section Groups
variable {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
  (small : G → Prop) (C : G → Finset (Fin J))
  (hC : ∀ g, small g → C g = ∅) (ζ : ℝ)
  (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)

include hC in
theorem physical_coupled_big_coefficient_small_empty
    (Ls Rs : PhysicalMarkLists (fun g : {g // small g} => P g.val) J ell)
    (aSmall : PhysicalAuxLabels (fun g : {g // small g} => P g.val) (fun g => C g.val))
    (Lb Rb : PhysicalMarkLists (fun g : {g // ¬small g} => P g.val) J ell)
    (aBig : PhysicalAuxLabels (fun g : {g // ¬small g} => P g.val) (fun g => C g.val)) :
    physicalCoupledBigCoefficient small C ζ K Ls Rs aSmall Lb Rb aBig =
      K ((physicalMarkGroupSplit small P J ell).symm (Ls, Lb))
        ((physicalMarkGroupSplit small P J ell).symm (Rs, Rb))
        ((physicalAuxGroupSplit small P J C).symm (aSmall, aBig)) *
      physicalPhase ζ (physicalSharedProduct (physicalSharedPrefix Ls) *
        physicalD (fun g : {g // ¬small g} => C g.val) Lb aBig) := by
  unfold physicalCoupledBigCoefficient
  rw [physical_D_empty_cut (fun g : {g // small g} => C g.val)
    (fun g => hC g.val g.property) aSmall Ls]

include hC in
theorem physical_bare_pattern_small_big_factor (V : G → ℝ)
    (a : PhysicalAuxLabels P C) (L R : PhysicalMarkLists P J ell) :
    physicalBarePatternScalar V C ζ K a L R =
      (if physicalSharedPrefix (fun g : {g // small g} => L g.val) =
          physicalSharedPrefix (fun g : {g // small g} => R g.val)
        then ((∏ g : {g // small g}, 1 / (V g.val) ^ ell : ℝ) : ℂ) else 0) *
      physicalBarePatternScalar (fun g : {g // ¬small g} => V g.val) (fun g => C g.val)
        0 (physicalCoupledBigCoefficient small C ζ K
          (fun g => L g.val) (fun g => R g.val) (fun g => a g.val))
        (fun g => a g.val) (fun g => L g.val) (fun g => R g.val) := by
  rw [physical_bare_pattern_group_factor small C ζ K V a L R,
    physical_bare_neutral_empty_cut (fun g : {g // small g} => V g.val)
      (fun g => C g.val) (fun g => hC g.val g.property)]

end Groups
end Bounty
