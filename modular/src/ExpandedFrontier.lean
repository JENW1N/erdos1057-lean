/- Pulling a small-coordinate history into the original big path phase
preserves its modulus bound in the physical parameter range. -/

open Finset
open scoped Classical
namespace Bounty
section Bounds
variable {S G I V K : Type} [Fintype S]
  {Ps : S → Finset ℕ} {P : G → Type}
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : I → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : I → Type)
  (Δ D : ∀ _k : K, ∀ i, PhysicalSharedLists Ps J → SharedActiveLabels P (shared i) → A i → G → ℤ)
  (kbig : ∀ _k : K, ∀ i, SharedActiveLabels P (shared i) → A i → ℤ)
  (Vs : S → ℝ) (qedge : K → ℝ) (hV : ∀ g, 1 ≤ Vs g) (hq : ∀ k, qedge k ≤ 1)

include hV hq in
theorem physical_mixed_plan_small_factor_mem_unit_interval (ks : List (Option (V ⊕ K)))
    (r : PhysicalResidues Ps) L
    (pl : PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) ks) x
    (p : PhysicalMixedPlannedBigPath n shared B A Δ D ks L pl x) :
    0 ≤ physicalMixedPlanSmallFactor n shared B A Δ D kbig Vs qedge ks r L pl x p ∧
      physicalMixedPlanSmallFactor n shared B A Δ D kbig Vs qedge ks r L pl x p ≤ 1 := by
  have hall : ∀ ks s (p : FiniteEventPath (PhysicalMixedWordEvent (V := V) (ell := ell) n shared B A Δ D)
      (physicalMixedWordTarget n shared B A Δ D kbig) ks s),
      0 ≤ finiteEventPathWeight _ _ (physicalMixedSmallWeight n shared B A Δ D kbig Vs qedge) ks s p ∧
      finiteEventPathWeight _ _ (physicalMixedSmallWeight n shared B A Δ D kbig Vs qedge) ks s p ≤ 1 := by
    intro ks
    induction ks with
    | nil => intro s p; exact ⟨zero_le_one, le_rfl⟩
    | cons tag ks ih =>
      intro s p
      rcases p with ⟨e, p⟩
      have he := physical_mixed_small_weight_mem_unit_interval n shared B A Δ D kbig Vs qedge hV hq tag s e
      have ht := ih _ p
      exact ⟨mul_nonneg he.1 ht.1, mul_le_one₀ he.2 ht.1 ht.2⟩
  exact hall ks ((r, L), x) (physicalMixedPathPack n shared B A Δ D kbig ks r L x ⟨pl, p⟩)

include hV hq in
theorem physical_mixed_plan_phase_norm_le (ks : List (Option (V ⊕ K)))
    (r : PhysicalResidues Ps) L
    (pl : PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) ks) x
    (p : PhysicalMixedPlannedBigPath n shared B A Δ D ks L pl x) (z : ℂ) :
    ‖(physicalMixedPlanSmallFactor n shared B A Δ D kbig Vs qedge ks r L pl x p : ℂ) * z‖ ≤ ‖z‖ := by
  have h := physical_mixed_plan_small_factor_mem_unit_interval n shared B A Δ D kbig Vs qedge hV hq ks r L pl x p
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg h.1]
  exact mul_le_of_le_one_left (norm_nonneg z) h.2

end Bounds
end Bounty
