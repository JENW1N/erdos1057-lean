    FullPermutationMixedEvent n S B A Δ D i s.2) (fullMixedLedgerTarget n S B A Δ D)
    (fun i s => fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V i s.2) steps phase F

theorem full_mixed_ledger_path_action_eq (steps : List (Option (J ⊕ K)))
    (initial : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B →
      (g : Fin N) → Finset (P g))
    (phase : ∀ s, FullMixedLedgerPath n S B A Δ D steps s → ℂ)
    (F : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ) :
    (fun x => fullMixedLedgerPathAction n S B A Δ D ω μ q ρ V steps phase
      (fun s => F s.2) (initial x, x)) =
    fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps
      (fullMixedLedgerInducedPhase n S B A Δ D steps initial phase) F := by
  let _ : ∀ (i : Option (J ⊕ K)) x, Fintype (FullPermutationMixedEvent n S B A Δ D i x) :=
    fullPermutationMixedEventFintype n S B A Δ D
  exact finite_initial_ledger_path_action (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) (fullMixedLedgerUpdate n S B A Δ D)
    steps initial (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V) phase F

theorem full_mixed_ledger_rows_eq (steps : List (Option (J ⊕ K)))
    (initial : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B →
      (g : Fin N) → Finset (P g))
    (edgePhase : ∀ k, ((g : Fin N) → Finset (P g)) →
      (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) →
      FullActiveEdgeEvent n (S k) B (A k) (Δ k) (D k) x → ℂ)
    (F : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ) :
    (fun x => finiteOperatorListAction (fullMixedLedgerRow n S B A Δ D edgePhase ω μ q ρ V)
      steps (fun s => F s.2) (initial x, x)) =
    fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps
      (fullMixedLedgerInducedPhase n S B A Δ D steps initial
        (finiteEventLocalPhase (fun i (s : FullMixedLedgerState n (M := M) B) =>
          FullPermutationMixedEvent n S B A Δ D i s.2) (fullMixedLedgerTarget n S B A Δ D)
          (fullMixedLedgerPhase n S B A Δ D edgePhase) steps)) F := by
  let _ : ∀ (i : Option (J ⊕ K)) x, Fintype (FullPermutationMixedEvent n S B A Δ D i x) :=
    fullPermutationMixedEventFintype n S B A Δ D
  exact finite_initial_ledger_phased_rows (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) (fullMixedLedgerUpdate n S B A Δ D)
    steps initial (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V)
    (fullMixedLedgerPhase n S B A Δ D edgePhase) F

