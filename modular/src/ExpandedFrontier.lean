theorem circle_geometric_translated_sum_le {ι : Type*} [Fintype ι]
    (θ : ι → ℝ) (N : ℕ) {r : ℕ} (hr : 0 < r)
    (hsep : ∀ i j, i ≠ j →
      1 / (2 * (r : ℝ)) ≤ ‖((θ i - θ j : ℝ) : UnitAddCircle)‖)
    (base : ℝ) :
    (∑ i, circleGeometricBound N (θ i - base)) ≤
      2 * (N : ℝ) + 2 * (r : ℝ) * (1 + Real.log r) := by
  apply circle_geometric_finite_sum_le Finset.univ (fun i => θ i - base) N hr
  intro i hi j hj hne
  have he : (θ i - base) - (θ j - base) = θ i - θ j := by ring
  rw [he]
  exact hsep i j hne

theorem circle_bilinear_norm_sq_le_of_separated {Y : Type*} [Fintype Y]
    (θ : Y → ℝ) (a N : ℕ) (c : Fin N → ℂ) (b : Y → ℂ)
    {r : ℕ} (hr : 0 < r)
    (hsep : ∀ i j, i ≠ j →
      1 / (2 * (r : ℝ)) ≤ ‖((θ i - θ j : ℝ) : UnitAddCircle)‖) :
    ‖∑ n : Fin N, ∑ y, c n * b y *
      (Complex.exp (Complex.I * (2 * Real.pi * θ y : ℝ))) ^ (a + n.val)‖ ^ 2 ≤
      (2 * (N : ℝ) + 2 * (r : ℝ) * (1 + Real.log r)) *
        (∑ n : Fin N, ‖c n‖ ^ 2) * ∑ y, ‖b y‖ ^ 2 := by
  apply circle_bilinear_norm_sq_le θ a N c b
  intro y
  exact circle_geometric_translated_sum_le θ N hr hsep (θ y)
end

