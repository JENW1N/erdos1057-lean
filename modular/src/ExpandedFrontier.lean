section

/- Three-variable Fourier expansion of the actual finite character cross-slice. -/

open Finset MeasureTheory
open scoped ComplexConjugate

namespace Bounty

noncomputable def typeIICrossCharacterAmplitude {d : ℕ} (χ : DirichletCharacter ℂ d)
    (α aH : ℕ → ℂ) (y : TypeIIShiftIndex) : ℂ :=
  α y.2.1.1 * conj (α y.2.2.1) * aH y.2.1.2 * conj (aH y.2.2.2) *
    χ (y.2.1.1 : ZMod d) * conj (χ (y.2.2.1 : ZMod d))

noncomputable def typeIICrossCharacterFourierIntegrand (A L U V E Z : ℝ) (k : ℤ)
    (M H Zs : Finset ℕ) (ψ : ℝ → ℝ) (α aH : ℕ → ℂ)
    (χ : DirichletCharacter ℂ (2*k.natAbs)) (ξ : EuclideanSpace ℝ (Fin 3)) : ℂ :=
  typeIIFiniteCrossFourierIntegrand A L U V E Z k (typeIICrossSlice M H Zs k)
    (fun y => (ψ ((y.1.2:ℝ)/Z) : ℂ) * typeIICrossCharacterAmplitude χ α aH y) ξ

theorem typeII_character_cross_slice_fourier_integral
    (A L U V E Z : ℝ) (k : ℤ) (M H Zs : Finset ℕ) (ψ : ℝ → ℝ) (α aH : ℕ → ℂ)
    (χ : DirichletCharacter ℂ (2*k.natAbs))
    (hU : 0 < U) (hV : 0 < V) (hZ : 0 < Z) (hk : k ≠ 0)
    (hM : ∀ m ∈ M, 0 < m)
    (hlocal : ∀ y ∈ typeIICrossSlice M H Zs k, ψ ((y.1.2:ℝ)/Z) ≠ 0 →
      0 < y.1.2 ∧ ∀ i,
        typeIILogCoordinates ![(y.2.1.1:ℝ),(y.2.2.1:ℝ),(y.1.2:ℝ)] ![U,U,Z] i ∈ Set.Icc (-A) A) :
    Integrable (typeIICrossCharacterFourierIntegrand A L U V E Z k M H Zs ψ α aH χ) ∧
      (∑ y ∈ typeIICrossSlice M H Zs k, (ψ ((y.1.2:ℝ)/Z) : ℂ) *
        typeIIRealShiftWeight
          (fun e n => typeIIEMajorant (L^88) (e/E) * typeIINMajorant (n/V)) α aH y *
          χ (y.2.1.1 : ZMod (2*k.natAbs)) * conj (χ (y.2.2.1 : ZMod (2*k.natAbs)))) =
        ∫ ξ : EuclideanSpace ℝ (Fin 3),
          typeIICrossCharacterFourierIntegrand A L U V E Z k M H Zs ψ α aH χ ξ := by
  classical
  have h := finite_typeII_majorant_fourier_integral A L U V E Z k (typeIICrossSlice M H Zs k)
    (fun y => (ψ ((y.1.2:ℝ)/Z) : ℂ) * typeIICrossCharacterAmplitude χ α aH y)
    hU hV hZ hk (by
      intro y hy hω
      have hψ : ψ ((y.1.2:ℝ)/Z) ≠ 0 := by
        intro hz
        apply hω
        simp only [hz, Complex.ofReal_zero, zero_mul]
      obtain ⟨hz, hbox⟩ := hlocal y hy hψ
      obtain ⟨hks, hpairs⟩ := mem_product.mp (mem_filter.mp hy).1
      obtain ⟨hv, hw⟩ := mem_product.mp hpairs
      exact ⟨mem_singleton.mp (mem_product.mp hks).1,
        hM _ (mem_product.mp hv).1, hM _ (mem_product.mp hw).1, hz, hbox⟩)
  refine ⟨h.1, ?_⟩
  change _ = ∫ ξ : EuclideanSpace ℝ (Fin 3),
    typeIIFiniteCrossFourierIntegrand A L U V E Z k (typeIICrossSlice M H Zs k)
      (fun y => (ψ ((y.1.2:ℝ)/Z) : ℂ) * typeIICrossCharacterAmplitude χ α aH y) ξ
  rw [← h.2]
  apply sum_congr rfl
  intro y hy
  unfold typeIIRealShiftWeight typeIICrossCharacterAmplitude
  ring

theorem typeII_smooth_dyadic_character_cross_fourier_integral
    (L U V E Z : ℝ) (k : ℤ) (M H Zs : Finset ℕ) (α aH : ℕ → ℂ)
    (χ : DirichletCharacter ℂ (2*k.natAbs))
    (hU : 0 < U) (hV : 0 < V) (hZ : 0 < Z) (hk : k ≠ 0)
    (hM : ∀ m ∈ M, (m:ℝ) ∈ Set.Icc U (2*U)) :
    Integrable (typeIICrossCharacterFourierIntegrand 1 L U V E Z k M H Zs typeIISmoothDyadic α aH χ) ∧
      (∑ y ∈ typeIICrossSlice M H Zs k, (typeIISmoothDyadic ((y.1.2:ℝ)/Z) : ℂ) *
        typeIIRealShiftWeight
          (fun e n => typeIIEMajorant (L^88) (e/E) * typeIINMajorant (n/V)) α aH y *
          χ (y.2.1.1 : ZMod (2*k.natAbs)) * conj (χ (y.2.2.1 : ZMod (2*k.natAbs)))) =
        ∫ ξ : EuclideanSpace ℝ (Fin 3),
          typeIICrossCharacterFourierIntegrand 1 L U V E Z k M H Zs typeIISmoothDyadic α aH χ ξ := by
  classical
  apply typeII_character_cross_slice_fourier_integral 1 L U V E Z k M H Zs
    typeIISmoothDyadic α aH χ hU hV hZ hk
  · intro m hm
    exact_mod_cast hU.trans_le (hM m hm).1
  · intro y hy hψ
    obtain ⟨_, hpairs⟩ := mem_product.mp (mem_filter.mp hy).1
    obtain ⟨hv, hw⟩ := mem_product.mp hpairs
    have hl := typeII_smooth_cross_log_box hU hZ (hM _ (mem_product.mp hv).1)
      (hM _ (mem_product.mp hw).1) hψ
    exact ⟨by exact_mod_cast hl.1, hl.2.2⟩

end Bounty
end

section

/- Exact conversion of each smooth spatial correlation to harmonic normalization. -/

open Finset
open scoped ContDiff

namespace Bounty

noncomputable def typeIIHarmonicDyadic (t : ℝ) : ℝ := t * typeIISmoothDyadic t

theorem typeII_harmonic_dyadic_contDiff : ContDiff ℝ ∞ typeIIHarmonicDyadic :=
  contDiff_id.mul typeII_smooth_dyadic_contDiff

theorem typeII_harmonic_dyadic_hasCompactSupport : HasCompactSupport typeIIHarmonicDyadic := by
  apply HasCompactSupport.intro (K := Set.Icc (1 / 2) 2) isCompact_Icc
  intro t ht
  have hzero : typeIISmoothDyadic t = 0 := by
    by_contra hn
    have hs := typeII_smooth_dyadic_support hn
    exact ht ⟨hs.1.le, hs.2.le⟩
  simp [typeIIHarmonicDyadic, hzero]

theorem typeII_harmonic_dyadic_bounds (t : ℝ) :
    0 ≤ typeIIHarmonicDyadic t ∧ typeIIHarmonicDyadic t ≤ 2 := by
  by_cases hzero : typeIISmoothDyadic t = 0
  · simp [typeIIHarmonicDyadic, hzero]
  · have hs := typeII_smooth_dyadic_support hzero
    have hb := typeII_smooth_dyadic_bounds t
    have ht : 0 ≤ t := by linarith [hs.1]
    exact ⟨mul_nonneg ht hb.1, (mul_le_of_le_one_right ht hb.2).trans hs.2.le⟩

theorem typeII_finite_harmonic_normalization (S : Finset ℕ) {Z : ℝ} (hZ : 0 < Z)
    (ψ : ℝ → ℝ) (f : ℕ → ℂ) (hS : ∀ z ∈ S, 0 < z) :
    (∑ z ∈ S, (ψ ((z : ℝ) / Z) : ℂ) * f z) =
      (Z : ℂ) * ∑ z ∈ S,
        ((((z : ℝ) / Z) * ψ ((z : ℝ) / Z) / (z : ℝ) : ℝ) : ℂ) * f z := by
  rw [mul_sum]
  apply sum_congr rfl
  intro z hz
  have hz0 : (z : ℝ) ≠ 0 := by exact_mod_cast (hS z hz).ne'
  have hid : Z * (((z : ℝ) / Z) * ψ ((z : ℝ) / Z) / (z : ℝ)) =
      ψ ((z : ℝ) / Z) := by field_simp
  rw [← mul_assoc, ← Complex.ofReal_mul, hid]

theorem typeII_smooth_harmonic_norm (S : Finset ℕ) {Z : ℝ} (hZ : 0 < Z)
    (f : ℕ → ℂ) (hS : ∀ z ∈ S, 0 < z) :
    ‖∑ z ∈ S, (typeIISmoothDyadic ((z : ℝ) / Z) : ℂ) * f z‖ =
      Z * ‖∑ z ∈ S, ((typeIIHarmonicDyadic ((z : ℝ) / Z) / (z : ℝ) : ℝ) : ℂ) * f z‖ := by
  rw [typeII_finite_harmonic_normalization S hZ typeIISmoothDyadic f hS, norm_mul,
    Complex.norm_real, Real.norm_eq_abs, abs_of_pos hZ]
  rfl

end Bounty
end

section

/- Original sharp candidate sums reduce to actual truncated Mellin and allocation integrals. -/

open Finset Filter MeasureTheory Real

namespace Bounty

theorem exists_candidate_original_mixed_mellin_reduction {c b q : ℝ}
    (hc : 0 < c) (hb : 0 < b) (hq0 : 0 ≤ q) (hq1 : q < 1) {r : ℕ} (hr : 6 ≤ r) :
    ∃ J : ℕ, ∀ jStar : ℕ, J < jStar → ∀ A D : ℝ,
      ∃ B : ℝ, 1 ≤ B ∧ ∃ K : ℝ, 0 < K ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (E : ℝ) (F : ℕ → ℕ → ℂ),
        1 ≤ E → log E ≤ (1-b)*L →
        (∀ u, ∀ m ∈ (2*u+1).divisors, ‖F u m‖ ≤ L^A) →
        (∀ u ∈ arithmeticProductWindow 1 (exp L), ∀ m ∈ (2*u+1).divisors,
          ¬(∀ p ∈ m.primeFactors, exp (sqrt L) ≤ (p : ℝ)) → F u m = 0) →
        Integrable (candidateMixedMellinIntegrand c L q r jStar E B F) ∧
        ‖(∑ u ∈ arithmeticProductWindow 1 (exp L),
            (candidateCoefficient c L q r jStar u : ℂ)*∑ m ∈ (2*u+1).divisors, F u m) -
          (∫ ν in {ν : ℝ | ‖ν‖ ≤ L^K},
            candidateMixedMellinIntegrand c L q r jStar E B F ν)‖ ≤ exp L*L^(-D) := by
  obtain ⟨J,hJ⟩ := exists_candidate_original_box_mellin_reduction hc hb hq0 hq1 hr
  refine ⟨J,fun jStar hj A D => ?_⟩
  obtain ⟨B,hB,K,hK,hbound⟩ := hJ jStar hj A D
  refine ⟨B,hB,K,hK,?_⟩
  filter_upwards [hbound, eventually_candidate_mixed_mellin_integrand_eq hc] with L hL heq
  intro E F hE hlogE hF hsupp
  have h := hL E F hE hlogE hF hsupp
  have he : candidateBoxWindowMellinIntegrand c L q r jStar E B F =
      candidateMixedMellinIntegrand c L q r jStar E B F :=
    funext (heq q r jStar E B F)
  rwa [he] at h

end Bounty
end

section

/- The clean part of the literal full coefficient row is exactly the
gated clean row. The initial mask tests new births only; the residual phase
uses the actual physical source and target labels for every event. -/

open Finset
open scoped Classical

namespace Bounty

section

variable {S G : Type} [Fintype S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}

noncomputable def physicalMixedFullResidualPhase
    (C : G → Finset (Fin J)) (ζ θ : ℝ) (k : ℤ)
    (sourceGate targetGate : PhysicalSmallBigState Ps J ell
      (CleanFullMemoryState P J ell B) → ℂ)
    (a : PhysicalAuxLabels P C)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B))
    (e : PhysicalMixedCoefficientEvent C k a s) : ℂ :=
  let source := physicalMixedRepeatedLabels C s.2
  let targetState := physicalMixedCoefficientTarget C k a s e
  let target := physicalMixedRepeatedLabels C targetState.2
  let d := physicalSharedPrefix s.1.2
  let cp := (productActiveMemorySplit (fun g => physicalFullSharedIndices (ell := ell) (C g)) B s.2).1
  if repeatedBigAuxAvoids C a source ∧ repeatedBigAuxAvoids C a target then
    (starRingEnd ℂ) (sourceGate s) *
      physicalPhase ζ (physicalMixedSharedD C d cp a) *
      physicalReturnPhase θ (physicalMixedBigStep C k cp a * (physicalSharedProduct d : ℕ)) *
      targetGate targetState
  else 0

theorem physical_mixed_clean_coefficient_action_eq_gated
    (initial : ∀ g, Finset (P g)) (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (ζ θ ρ : ℝ) (k : ℤ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (Vs : S → ℝ) (q : ℝ)
    (sourceGate targetGate f : PhysicalSmallBigState Ps J ell
      (CleanFullMemoryState P J ell B) → ℂ)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B)) :
    physicalMixedCoefficientAction C k V b ρ Vs q initial
      (fun a y e => if ∀ g, (e.2.2 g).1 = ∅ ∧ (e.2.2 g).2.1 = ∅ then
        K (physicalMixedRepeatedLabels C y.2)
          (physicalMixedRepeatedLabels C (physicalMixedCoefficientTarget C k a y e).2) a *
          physicalMixedFullResidualPhase C ζ θ k sourceGate targetGate a y e else 0) f s =
      physicalMixedGatedCleanAction initial V b C ζ θ ρ k K Vs q sourceGate targetGate f s := by
  unfold physicalMixedCoefficientAction physicalMixedGatedCleanAction
  apply sum_congr rfl
  intro a _
  congr 1
  apply congrArg (fun phase => physicalSmallBigFullPhasedAction
    (fun g (p : P g) => p.val) (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
    (fun d c => physicalMixedEdgeDelta C k d c a)
    (fun d c => physicalMixedEdgeD C d c a)
    (fun g => tiltedPhysicalBirthLaw V g (b g)) ρ V
    (fun c => physicalMixedBigStep C k c a) Vs q phase f s)
  funext y e
  unfold physicalSmallBigEndpointPhase physicalSmallBigCleanInitialPhase
  dsimp only
  rw [physical_mixed_clean_prefix_phase_eq_labels]
  unfold physicalMixedFullResidualPhase physicalMixedCoefficientTarget physicalSmallBigTarget
  dsimp only
  by_cases hi : ∀ g i, (e.2.2 g).2.2.2 i ∉ initial g
  · by_cases hc : ∀ g, (e.2.2 g).1 = ∅ ∧ (e.2.2 g).2.1 = ∅
    · rw [if_pos hi, if_pos hc, if_pos (And.intro hc hi)]
      split_ifs <;> ring
    · rw [if_pos hi, if_neg hc, if_neg (fun h => hc h.1)]
      simp only [mul_zero, zero_mul]
  · rw [if_neg hi, if_neg (fun h => hi h.2)]
    simp only [mul_zero, zero_mul]

end

end Bounty
end

section

/- Exact complementary event masks for the actual mixed coefficient and
signed prime family; the fixed initial exclusion remains inside the row. -/

open Finset
open scoped Classical
namespace Bounty
section
variable {S G : Type} [Fintype S] [Fintype G] [DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}

noncomputable def physicalMixedCleanPhase (C : G → Finset (Fin J)) (k : ℤ)
    (Ψ : ∀ a (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B)),
      PhysicalMixedCoefficientEvent C k a s → ℂ)
    (a : PhysicalAuxLabels P C)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B))
    (e : PhysicalMixedCoefficientEvent C k a s) : ℂ :=
  if ∀ g, (e.2.2 g).1 = ∅ ∧ (e.2.2 g).2.1 = ∅ then Ψ a s e else 0

theorem physical_mixed_coefficient_clean_dirty
    (C : G → Finset (Fin J)) (k : ℤ)
    (V : G → ℝ) (b : ∀ g, P g → ℝ) (ρ : ℝ) (Vs : S → ℝ) (q : ℝ)
    (initial : ∀ g, Finset (P g))
    (Ψ : ∀ a (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B)),
      PhysicalMixedCoefficientEvent C k a s → ℂ)
    (f : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ) :
    physicalMixedCoefficientAction C k V b ρ Vs q initial Ψ f =
      physicalMixedCoefficientAction C k V b ρ Vs q initial (physicalMixedCleanPhase C k Ψ) f +
      physicalMixedCoefficientAction C k V b ρ Vs q initial (physicalMixedDirtyPhase C k Ψ) f := by
  funext s
  simp only [physicalMixedCoefficientAction, physicalSmallBigFullPhasedAction,
    physicalSmallBigPhasedAction, Pi.add_apply, mul_sum, ← sum_add_distrib]
  apply sum_congr rfl
  intro a _
  apply sum_congr rfl
  intro e _
  unfold physicalMixedCleanPhase physicalMixedDirtyPhase
  split_ifs <;> ring

theorem physical_mixed_prime_family_clean_dirty
    (V : G → ℝ) (b : ∀ g, P g → ℝ) (ρ : ℝ) (Vs : S → ℝ) (q : ℝ)
    (probes : G → Finset (Fin J)) (r t : Finset G) (hrt : Disjoint r t)
    (Q : ℕ) (h ξ : ℝ) (k : ℤ) (initial : ∀ g, Finset (P g))
    (φ : ∀ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      ∀ a (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B)),
        PhysicalMixedCoefficientEvent (repeatedBigPrimePatternCut probes r t i) k a s → ℂ)
    (f : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ) :
    physicalMixedPrimePatternAction V b ρ Vs q probes r t hrt Q h ξ k initial φ f =
      physicalMixedPrimePatternAction V b ρ Vs q probes r t hrt Q h ξ k initial
        (fun i => physicalMixedCleanPhase (repeatedBigPrimePatternCut probes r t i) k (φ i)) f +
      physicalMixedPrimePatternAction V b ρ Vs q probes r t hrt Q h ξ k initial
        (fun i => physicalMixedDirtyPhase (repeatedBigPrimePatternCut probes r t i) k (φ i)) f := by
  unfold physicalMixedPrimePatternAction
  rw [← sum_add_distrib]
  apply sum_congr rfl
  intro i _
  refine (physical_mixed_coefficient_clean_dirty
    (repeatedBigPrimePatternCut probes r t i) k V b ρ Vs q initial _ f).trans ?_
  apply congrArg₂ (fun x y : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ => x + y)
  all_goals
    apply congrArg (fun Ψ => physicalMixedCoefficientAction
      (repeatedBigPrimePatternCut probes r t i) k V b ρ Vs q initial Ψ f)
    funext a y e
  · unfold physicalMixedCleanPhase
    split_ifs <;> simp_all
  · unfold physicalMixedDirtyPhase
    split_ifs <;> simp_all

theorem physical_small_big_joint_average_add [DecidableEq S]
    (f g : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ) :
    physicalSmallBigJointAverage (f + g) = physicalSmallBigJointAverage f + physicalSmallBigJointAverage g := by
  funext s
  simp only [physical_small_big_joint_average_eq_sum, Pi.add_apply, mul_add, sum_add_distrib]

end
end Bounty
end

section

/- The actual candidate dirty row in the same two-sided joint projection
as the signed prime family. No auxiliary or local norm premise remains. -/

open Finset Filter
open scoped Classical Topology
namespace Bounty

theorem eventually_candidate_physical_mixed_dirty_projected_norm_le
    {q vs scale : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hvs : 0 < vs) (hscale : 0 < scale)
    (ell : ℕ) (C₂ : ℝ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ᶠ L : ℝ in atTop,
      letI : DecidableEq (CandidateSmallGroup scale L) := Classical.decEq _
      letI : DecidableEq (CandidateBigGroup scale L) := Classical.decEq _
      letI : ∀ p : PhysicalPrime (candidateSmallPool scale L), NeZero p.2.val :=
        candidateSmallPrimeNeZero scale L
      letI : ∀ g p, NeZero (candidateBigModulus scale L g p) := candidateBigModulusNeZero scale L
      letI : ∀ (g : CandidateBigGroup scale L) (p : CandidateBigLabel scale L g), NeZero p.val :=
        fun g p => candidateBigModulusNeZero scale L g p
      ∀ J B : ℕ,
      letI : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
      ∀ (C : CandidateBigGroup scale L → Finset (Fin J)) (k : ℤ),
      k ≠ 0 → (k.natAbs : ℝ) ≤ L ^ C₂ →
      ∀ Vs : CandidateSmallGroup scale L → ℝ, (∀ g, vs ≤ Vs g) →
      ∀ (V : CandidateBigGroup scale L → ℝ)
        (baseline : ∀ g, CandidateBigLabel scale L g → ℝ) (ρ v vmin vmax : ℝ),
      0 < ρ → ρ < 1 → 1 < v → 0 < vmin →
      (∀ g, vmin ≤ V g) → (∀ g, V g ≤ vmax) →
      (∀ g : CandidateBigGroup scale L, ∑ p ∈ candidatePBand (scale * L) g.val, 1 / (p : ℝ) = V g) →
      (∀ g p, 1 / 2 ≤ baseline g p ∧ baseline g p ≤ 1) →
      ∀ T : ℕ, (∀ g, ell + (C g).card ≤ T) →
      ∀ (initial : ∀ g, Finset (CandidateBigLabel scale L g))
        (Ψ : ∀ a (s : PhysicalSmallBigState (candidateSmallPool scale L) J ell
          (CleanFullMemoryState (fun g : CandidateBigGroup scale L => candidatePBand (scale * L) g.val) J ell B)),
          PhysicalMixedCoefficientEvent C k a s → ℂ),
      (∀ a s e, ‖Ψ a s e‖ ≤ 1) →
      ∀ f : PhysicalSmallBigState (candidateSmallPool scale L) J ell
        (CleanFullMemoryState (fun g : CandidateBigGroup scale L => candidatePBand (scale * L) g.val) J ell B) → ℂ,
      (∀ s, ProductMemorySymmetric (fun x => f (s,x))) →
      let μ := fun g => tiltedPhysicalBirthLaw
        (P := fun g : CandidateBigGroup scale L => candidatePBand (scale * L) g.val) V g (baseline g)
      let W := productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))
      cleanActiveNorm (physicalSmallBigMeasure Vs W)
        (physicalSmallBigJointAverage (physicalMixedCoefficientAction C k V baseline ρ Vs q initial
          (physicalMixedDirtyPhase C k Ψ) (physicalSmallBigJointAverage f))) ≤
      2 * Real.sqrt ((B : ℝ) / (((J + ell).choose ell) ^ (candidateSmallPIndices scale L).card : ℕ)) *
        A ^ (candidateSmallPIndices scale L).card *
        Real.sqrt (unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ (candidateBigPIndices scale L).card) *
        cleanActiveNorm (physicalSmallBigMeasure Vs W) f := by
  obtain ⟨A, hA, hbound⟩ := eventually_candidate_physical_mixed_dirty_energy_le hq0 hq1 hvs hscale ell C₂
  refine ⟨A, hA, ?_⟩
  filter_upwards [hbound] with L hL
  let _ : DecidableEq (CandidateSmallGroup scale L) := Classical.decEq _
  let _ : DecidableEq (CandidateBigGroup scale L) := Classical.decEq _
  let _ : ∀ p : PhysicalPrime (candidateSmallPool scale L), NeZero p.2.val := candidateSmallPrimeNeZero scale L
  let _ : ∀ g p, NeZero (candidateBigModulus scale L g p) := candidateBigModulusNeZero scale L
  let _ : ∀ (g : CandidateBigGroup scale L) (p : CandidateBigLabel scale L g), NeZero p.val :=
    fun g p => candidateBigModulusNeZero scale L g p
  intro J B
  let _ : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
  intro C k hk hkbound Vs hVs V baseline ρ v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi
    hMass hbaseline T ht initial Ψ hΨ f hf μ W
  have hVs0 : ∀ g, 0 < Vs g := fun g => hvs.trans_le (hVs g)
  have hV : ∀ g, 0 < V g := fun g => hvmin.trans_le (hVlo g)
  have hμ : ∀ g p, 0 ≤ μ g p := fun g p =>
    tiltedPhysicalBirthLaw_nonneg (P := fun g : CandidateBigGroup scale L => candidatePBand (scale * L) g.val) V g (baseline g) (hV g).le
      (fun p => (by norm_num : (0 : ℝ) ≤ 1/2).trans (hbaseline g p).1) p
  let fb := physicalSmallBigBigAverage f
  have hfb : ∀ s, ProductMemorySymmetric (fun x => fb (s,x)) :=
    fun s => fullActiveAverage_symmetric (fun x => f (s,x)) (hf s)
  let Φ := fun a s (e : PhysicalMixedCoefficientEvent C k a s) =>
    if ∀ g i, (e.2.2 g).2.2.2 i ∉ initial g then Ψ a s e else 0
  have hΦ : ∀ a s e, ‖Φ a s e‖ ≤ 1 := by
    intro a s e
    dsimp only [Φ]
    split_ifs
    · exact hΨ a s e
    · simp only [norm_zero, zero_le_one]
  have hc := hL J B C k hk hkbound Vs hVs V baseline ρ v vmin vmax
    hρ0 hρ1 hv hvmin hVlo hVhi hMass hbaseline T ht Φ hΦ fb hfb
  let u := physicalMixedCoefficientAction C k V baseline ρ Vs q initial
    (physicalMixedDirtyPhase C k Ψ) (physicalSmallBigJointAverage f)
  have he : physicalSmallBigEnergy Vs W (physicalSmallBigAverage u) ≤
      4 * ((B : ℝ) / (((J + ell).choose ell) ^ (candidateSmallPIndices scale L).card : ℕ)) *
        (A ^ (2 * (candidateSmallPIndices scale L).card) *
          unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ (candidateBigPIndices scale L).card) *
        physicalSmallBigEnergy Vs W fb := by
    dsimp only [u]
    rw [physical_mixed_dirty_coefficient_action_eq]
    exact hc
  have hin : physicalSmallBigEnergy Vs W fb ≤ physicalSmallBigEnergy Vs W f := by
    convert physical_small_big_big_average_energy_le Vs hVs0 μ
      (fun g => unrestrictedResidueWeight (μ g)) hμ (fun g z => hμ g z.1) f using 1
  have hout : physicalSmallBigEnergy Vs W (physicalSmallBigJointAverage u) ≤
      physicalSmallBigEnergy Vs W (physicalSmallBigAverage u) := by
    rw [physical_small_big_joint_average_eq_big_small]
    convert physical_small_big_big_average_energy_le Vs hVs0 μ
      (fun g => unrestrictedResidueWeight (μ g)) hμ (fun g z => hμ g z.1)
      (physicalSmallBigAverage u) using 1
  let δ : ℝ := (B : ℝ) / (((J + ell).choose ell) ^ (candidateSmallPIndices scale L).card : ℕ)
  let K : ℝ := unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ (candidateBigPIndices scale L).card
  have hδ : 0 ≤ δ := div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _)
  have hK : 0 ≤ K := pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _
  have hcoef : 0 ≤ 4 * δ * (A ^ (2 * (candidateSmallPIndices scale L).card) * K) :=
    mul_nonneg (mul_nonneg (by norm_num) hδ)
      (mul_nonneg (pow_nonneg (zero_le_one.trans hA) _) hK)
  have henergy := hout.trans (he.trans (mul_le_mul_of_nonneg_left hin hcoef))
  have hp : (A ^ (candidateSmallPIndices scale L).card) ^ 2 =
      A ^ (2 * (candidateSmallPIndices scale L).card) := by rw [← pow_mul, Nat.mul_comm]
  have hcoefeq : (2 * Real.sqrt δ * A ^ (candidateSmallPIndices scale L).card) ^ 2 * K =
      4 * δ * (A ^ (2 * (candidateSmallPIndices scale L).card) * K) := by
    rw [mul_pow, mul_pow, hp, Real.sq_sqrt hδ]
    ring
  apply physical_small_big_norm_le_of_energy Vs W
    (2 * Real.sqrt δ * A ^ (candidateSmallPIndices scale L).card) K
    (mul_nonneg (mul_nonneg (by norm_num) (Real.sqrt_nonneg _))
      (pow_nonneg (zero_le_one.trans hA) _)) hK f _
  rw [hcoefeq]
  convert henergy using 1

end Bounty
end

section

/- Finite triangle and scalar normalization for the actual signed dirty
prime family. The candidate theorem discharges the single-row hypothesis. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_mixed_prime_dirty_norm_of_rows
    {S G : Type} [Fintype S] [DecidableEq S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ}
    [∀ p : PhysicalPrime Ps, NeZero p.2.val] [∀ g (p : P g), NeZero p.val]
    {J ell B m : ℕ}
    (V : G → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ) (Vs : S → ℝ) (q : ℝ)
    (probes : G → Finset (Fin J)) (r t : Finset G) (hrt : Disjoint r t)
    (hp : ∀ g, (probes g).card ≤ m) (Q : ℕ) (h ξ : ℝ) (hξ : 0 < ξ) (k : ℤ)
    (initial : ∀ g, Finset (P g))
    (φ : ∀ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      ∀ a (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B)),
      PhysicalMixedCoefficientEvent (repeatedBigPrimePatternCut probes r t i) k a s → ℂ)
    (hφ : ∀ i a s e, ‖φ i a s e‖ ≤ 1)
    (w : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℝ)
    (hw : ∀ s, 0 ≤ w s) (cost : ℝ) (hcost : 0 ≤ cost)
    (f : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ)
    (hrow : ∀ (C : G → Finset (Fin J)), (∀ g, (C g).card ≤ m) →
      ∀ Ψ : ∀ a (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B)),
        PhysicalMixedCoefficientEvent C k a s → ℂ,
      (∀ a s e, ‖Ψ a s e‖ ≤ 1) →
      cleanActiveNorm w (physicalSmallBigJointAverage
        (physicalMixedCoefficientAction C k V baseline ρ Vs q initial
          (physicalMixedDirtyPhase C k Ψ) (physicalSmallBigJointAverage f))) ≤
        cost * cleanActiveNorm w f) :
    cleanActiveNorm w (physicalSmallBigJointAverage (physicalMixedPrimePatternAction
      V baseline ρ Vs q probes r t hrt Q h ξ k initial
      (fun i => physicalMixedDirtyPhase (repeatedBigPrimePatternCut probes r t i) k (φ i))
      (physicalSmallBigJointAverage f))) ≤
      repeatedBigFamilyEnvelope (Fintype.card G) m Q ξ * cost * cleanActiveNorm w f := by
  let C := repeatedBigPrimePatternCut (ell := ell) probes r t
  let kept := fun U : Finset (RepeatedBigFlatIndex G J ell) => primeProductRetainedCells
    (fun j : U => P j.val.1) (fun j => V j.val.1) h ξ
  let K := repeatedBigPrimePatternKernel P V probes r t hrt Q h kept
  let b := repeatedBigPrimePatternBound (ell := ell) probes r t Q ξ
  let Ψ := fun i a s (e : PhysicalMixedCoefficientEvent (B := B) (C i) k a s) =>
    repeatedBigPrimePatternWeight probes r t i * K i
      (physicalMixedRepeatedLabels (C i) s.2)
      (physicalMixedRepeatedLabels (C i) (physicalMixedCoefficientTarget (C i) k a s e).2) a * φ i a s e
  have hb : ∀ i, 0 ≤ b i := repeated_big_prime_pattern_bound_nonneg probes r t Q ξ
  have hΨ : ∀ i a s e, ‖Ψ i a s e‖ ≤ b i := by
    intro i a s e
    dsimp only [Ψ]
    rw [norm_mul, norm_mul, repeated_big_prime_pattern_weight_norm, one_mul]
    exact (mul_le_mul_of_nonneg_right
      (repeated_big_prime_pattern_kernel_norm_le P V probes r t hrt Q h ξ hξ i _ _ a)
      (norm_nonneg _)).trans ((mul_le_mul_of_nonneg_left (hφ i a s e) (hb i)).trans_eq (mul_one _))
  have hsum : ∑ i, b i ≤ repeatedBigFamilyEnvelope (Fintype.card G) m Q ξ := by
    apply (repeated_big_prime_pattern_bound_sum_le (ell := ell) probes r t hp Q ξ).trans
    apply add_le_add le_rfl
    apply mul_le_mul_of_nonneg_right _ (sq_nonneg _)
    apply pow_le_pow_right₀ (by norm_num : (1 : ℝ) ≤ 2)
    apply Nat.mul_le_mul_left
    rw [← card_union_of_disjoint hrt]
    exact card_le_univ _
  let u := fun i => physicalSmallBigJointAverage (physicalMixedCoefficientAction (C i) k V baseline ρ Vs q initial
    (physicalMixedDirtyPhase (C i) k (Ψ i)) (physicalSmallBigJointAverage f))
  have hu (i) : cleanActiveNorm w (u i) ≤
      b i * cost * cleanActiveNorm w f := by
    let ψ := fun a s e => Ψ i a s e / (b i : ℂ)
    have hψ : ∀ a s e, ‖ψ a s e‖ ≤ 1 := fun a s e => norm_div_real_bound_le_one (hb i) (hΨ i a s e)
    have hh := hrow (C i)
      (fun g => repeated_big_prime_pattern_cut_card_le probes r t hp i g) ψ hψ
    have hpdiv : (fun a s e => physicalMixedDirtyPhase (C i) k (Ψ i) a s e / (b i : ℂ)) =
        physicalMixedDirtyPhase (C i) k ψ := by
      funext a s e
      unfold physicalMixedDirtyPhase
      split_ifs <;> simp only [ψ, zero_div]
    have he := physical_mixed_coefficient_phase_normalize (C i) k V baseline ρ Vs q initial
      (physicalMixedDirtyPhase (C i) k (Ψ i)) (physicalSmallBigJointAverage f) (b i)
      (physical_mixed_dirty_phase_norm_le (C i) k (Ψ i) (hb i) (hΨ i))
    rw [hpdiv] at he
    have heq : u i = (b i : ℂ) • physicalSmallBigJointAverage
        (physicalMixedCoefficientAction (C i) k V baseline ρ Vs q initial
          (physicalMixedDirtyPhase (C i) k ψ) (physicalSmallBigJointAverage f)) := by
      dsimp only [u]
      rw [he, physical_small_big_joint_average_smul]
    rw [heq, clean_active_norm_smul _ hw]
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hb i)]
    convert mul_le_mul_of_nonneg_left hh (hb i) using 1 <;> first | ring | rfl
  have heq : physicalSmallBigJointAverage (physicalMixedPrimePatternAction V baseline ρ Vs q
      probes r t hrt Q h ξ k initial (fun i => physicalMixedDirtyPhase (C i) k (φ i))
      (physicalSmallBigJointAverage f)) = ∑ i, u i := by
    rw [physicalMixedPrimePatternAction, physical_small_big_joint_average_sum]
    apply sum_congr rfl
    intro i _
    congr 2
    funext a s e
    unfold physicalMixedDirtyPhase
    split_ifs <;> first | rfl | simp only [mul_zero]
  calc
    _ = cleanActiveNorm w (∑ i, u i) := by congr 1
    _ ≤ ∑ i, cleanActiveNorm w (u i) := clean_active_norm_sum_le _ hw univ u
    _ ≤ ∑ i, b i * cost * cleanActiveNorm w f := sum_le_sum fun i _ => hu i
    _ = (∑ i, b i) * cost * cleanActiveNorm w f := by rw [sum_mul, sum_mul]
    _ ≤ _ := mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hsum hcost) (Real.sqrt_nonneg _)


end Bounty
end

section

/- Original sharp candidate sums reduce to actual truncated Mellin and allocation integrals. -/

open Finset Filter MeasureTheory Real

namespace Bounty

theorem exists_candidate_original_finite_mixed_mellin_reduction {c b q : ℝ}
    (hc : 0 < c) (hb : 0 < b) (hq0 : 0 ≤ q) (hq1 : q < 1) (R : ℝ) (hR : 1 ≤ R) {r : ℕ} (hr : 6 ≤ r) :
    ∃ J : ℕ, ∀ jStar : ℕ, J < jStar → ∀ A D : ℝ,
      ∃ B : ℝ, 1 ≤ B ∧ ∃ K : ℝ, 0 < K ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (E : ℝ) (S : Finset ℕ) (F : ℕ → ℕ → ℂ),
        (∀ u ∈ S, 0 < u ∧ (u : ℝ) ≤ R*exp L) →
        arithmeticProductWindow 1 (exp L) ⊆ S →
        1 ≤ E → log E ≤ (1-b)*L →
        (∀ u, ∀ m ∈ (2*u+1).divisors, ‖F u m‖ ≤ L^A) →
        (∀ u ∈ arithmeticProductWindow 1 (exp L), ∀ m ∈ (2*u+1).divisors,
          ¬(∀ p ∈ m.primeFactors, exp (sqrt L) ≤ (p : ℝ)) → F u m = 0) →
        Integrable (candidateFiniteMixedMellinIntegrand c L q r jStar E B R S F) ∧
        ‖(∑ u ∈ arithmeticProductWindow 1 (exp L),
            (candidateCoefficient c L q r jStar u : ℂ)*∑ m ∈ (2*u+1).divisors, F u m) -
          (∫ ν in {ν : ℝ | ‖ν‖ ≤ L^K},
            candidateFiniteMixedMellinIntegrand c L q r jStar E B R S F ν)‖ ≤ exp L*L^(-D) := by
  obtain ⟨J,hJ⟩ := exists_candidate_original_finite_mellin_reduction hc hb hq0 hq1 R hR hr
  refine ⟨J,fun jStar hj A D => ?_⟩
  obtain ⟨B,hB,K,hK,hbound⟩ := hJ jStar hj A D
  refine ⟨B,hB,K,hK,?_⟩
  filter_upwards [hbound, eventually_candidate_finite_mixed_mellin_eq hc] with L hL heq
  intro E S F hS hSW hE hlogE hF hsupp
  have h := hL E S F hS hSW hE hlogE hF hsupp
  have he : candidateFiniteMellinIntegrand c L q r jStar E B S F =
      candidateFiniteMixedMellinIntegrand c L q r jStar E B R S F :=
    funext (heq q r jStar E B R S F hS)
  rwa [he] at h

end Bounty
end

section

/- The actual normalized retained allocation integrand is a Type II sum on explicit finite supports. -/

open Finset

namespace Bounty

noncomputable def candidateB0TakenSupport (c L : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) (X : ℝ) : Finset ℕ :=
  (orderedSlotProductSupport
    (fun slot : CandidateTakenSlot c L r take => candidateQSlotChoices c L r jStar slot.val)).filter
      (fun e : ℕ => X/L^88 ≤ (e : ℝ) ∧ (e : ℝ) ≤ X)

noncomputable def candidateB0TakenCoefficient (c L : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (ν : ℝ) (e : ℕ) : ℂ :=
  candidateTakenComplexCoefficient c L r jStar take twist e*typeIIMellinPhase ν e

noncomputable def candidateB0RetainedCoefficient (c L q : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (ν : ℝ) (h : ℕ) : ℂ :=
  candidateRetainedComplexCoefficient c L q r jStar take twist h*typeIIMellinPhase ν h

theorem candidate_taken_product_support_pos (c L : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) {e : ℕ}
    (he : e ∈ orderedSlotProductSupport
      (fun slot : CandidateTakenSlot c L r take => candidateQSlotChoices c L r jStar slot.val)) : 0 < e := by
  classical
  obtain ⟨x,hx,rfl⟩ := mem_image.mp he
  apply Nat.pos_of_ne_zero
  exact prod_ne_zero_iff.mpr (fun slot _ => candidate_Q_slot_nonzero c L r jStar slot.val (x slot).property)

theorem candidate_retained_allocation_support_pos (c L : ℝ) (r jStar : ℕ) (P : Finset ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) (hP : ∀ p ∈ P, 0 < p) {h : ℕ}
    (hh : h ∈ candidateRetainedAllocationSupport c L r jStar P take) : 0 < h := by
  classical
  obtain ⟨⟨p,n⟩,hpn,rfl⟩ := mem_image.mp hh
  obtain ⟨hp,hn⟩ := mem_product.mp hpn
  apply Nat.mul_pos (hP p hp)
  obtain ⟨x,hx,rfl⟩ := mem_image.mp hn
  apply Nat.pos_of_ne_zero
  exact prod_ne_zero_iff.mpr (fun slot _ => candidate_Q_slot_nonzero c L r jStar slot.val (x slot).property)

theorem candidate_B0_coefficient_norms (c L q : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (ν : ℝ) {n : ℕ} (hn : 0 < n) :
    ‖candidateB0TakenCoefficient c L r jStar take twist ν n‖ =
      ‖candidateTakenComplexCoefficient c L r jStar take twist n‖ ∧
    ‖candidateB0RetainedCoefficient c L q r jStar take twist ν n‖ =
      ‖candidateRetainedComplexCoefficient c L q r jStar take twist n‖ := by
  simp only [candidateB0TakenCoefficient,candidateB0RetainedCoefficient,norm_mul,
    typeII_mellin_phase_norm ν hn,mul_one,and_self]

theorem candidate_retained_box_typeII (c L q : ℝ) (r jStar : ℕ)
    (P M N : Finset ℕ) (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ)
    (X ν R U V : ℝ) (α β : ℕ → ℂ)
    (hP : ∀ p ∈ P, 0 < p) (hU : 0 ≤ U) (hV : 0 ≤ V)
    (hM : ∀ m ∈ M, (m : ℝ) ≤ 2*U) (hN : ∀ n ∈ N, (n : ℝ) ≤ 2*V)
    (hR : 2*U*V ≤ R*Real.exp L)
    (hα : ∀ m, m ∉ M → α m = 0) (hβ : ∀ n, n ∉ N → β n = 0) :
    candidateRetainedAllocationIntegrand c L q r jStar (Real.log X) P take
      (candidateBoxFiniteTest L X (Icc 1 ⌊R*Real.exp L⌋₊)
        (fun u => typeIIMellinPhase ν u*∑ m ∈ (2*u+1).divisors, α m*β ((2*u+1)/m))) ξ =
      candidateAllocationFourierScalar c L r jStar (Real.log X) ξ *
        (∑ e ∈ candidateB0TakenSupport c L r jStar take X, ∑ n ∈ N,
          candidateB0TakenCoefficient c L r jStar take
            (candidateAllocationFourierTwist c L r jStar take ξ) ν e * β n *
          typeIIInnerSum M (candidateRetainedAllocationSupport c L r jStar P take) α
            (candidateB0RetainedCoefficient c L q r jStar take
              (candidateAllocationFourierTwist c L r jStar take ξ) ν) e n) *
      activeAllocationFourierWeight (candidateAllocationRadius r)
        (candidateAllocationActive c L r jStar) take ξ := by
  unfold candidateRetainedAllocationIntegrand candidateB0TakenSupport
    candidateB0TakenCoefficient candidateB0RetainedCoefficient
  apply congrArg (fun z : ℂ =>
    candidateAllocationFourierScalar c L r jStar (Real.log X) ξ * z *
      activeAllocationFourierWeight (candidateAllocationRadius r)
        (candidateAllocationActive c L r jStar) take ξ)
  apply finite_mellin_divisor_typeII_compatible _ M N _ _ _ α β _ L X ν hα hβ
  intro e he hr n hn m hm h hh heq
  exact typeII_equation_coarse_bounds (candidate_taken_product_support_pos c L r jStar take he)
    (candidate_retained_allocation_support_pos c L r jStar P take hP hh)
    hU hV (hM m hm) (hN n hn) hR heq

end Bounty
end

