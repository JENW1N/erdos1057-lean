open Finset
open scoped Classical
theorem global_birth_edge_output_coherent {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] {N t : ℕ}
    (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (source target : Fin t ↪ P)
    (hsource : univ.image source = ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt)
    (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
    (old : (j : Fin N) → R (f.val j))
    (eligible : Finset (Fin N)) (stores : Finset (Fin t))
    (event : FixedTargetEdgeEvent (Fin t) (Fin N) P eligible)
    (hv : GlobalBirthEdgeEventValid (ghostPhaseBornSupport w) f.val target event) :
    GlobalBirthMemoryCoherent (ghostPhaseActivitySupport atgt)
      (ghostPhaseBornSupport w ∪ univ.image target)
      (unrestrictedEdgeOutput source (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
        (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) stores event.1 event.2.1) := by
  have hH : univ.image f.val ⊆ ghostPhaseBornSupport w := by
    rw [distinct_ordered_support_image f]
    exact ghost_phase_pending_subset_born w
  have hfixed := global_birth_event_implies_fixed_target (ghostPhaseBornSupport w)
    f.val target hH event hv
  rcases event with ⟨U, e, fresh⟩
  have hU := fixed_target_edge_event_slots f.val target ⟨U, e, fresh⟩ hfixed
  change U = distinctPromotedTargetSlots f.val target at hU
  subst U
  have hm := fixed_target_edge_event_matches f.val target _ hfixed
  have he := distinct_phase_event_selected atgt asrc w hw f target htarget eligible e hm
  have hsrc : ∀ j, asrc (source j) = true ∧ atgt (source j) = false := by
    intro j
    have hj : source j ∈ univ.image source := mem_image.mpr ⟨j, mem_univ _, rfl⟩
    rw [hsource] at hj
    simpa [ghostPhaseActivitySupport] using hj
  have hs := distinct_unrestricted_storage_allowed source stores atgt asrc
    (fun j => (hsrc j).1) (fun j _ => (hsrc j).2)
  have hz := global_birth_memory_coherent_of_snapshot
    (fun p => ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p)
      (distinctUnrestrictedStorageChoice source stores p) (w p))
    (unrestrictedEdgeOutput source (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
      (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) stores _ e)
    (distinct_unrestricted_output_label_injective source stores _ atgt asrc delta w hw
      (fun j => (hsrc j).1) (fun j _ => (hsrc j).2) f old e)
    (distinct_unrestricted_output_support source stores _ atgt asrc delta w hw
      (fun j => (hsrc j).1) (fun j _ => (hsrc j).2) f old e he)
  rw [ghost_phase_selected_moving_active_support atgt asrc _ delta w hw hs,
    ghost_phase_selected_moving_born_support atgt asrc _ delta w hw hs] at hz
  simpa only [htarget, global_birth_new_run_update atgt asrc w hw] using hz
end

section
open Finset
open scoped Classical
/-- Actual old-index ghost visit with an arbitrary raw snapshot continuation.
The only denominator is the new-batch factorial; output cutoff is literal length. -/
noncomputable def globalBirthGhostVisitRawRow {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, DecidableEq (R p)] {N : ℕ}
    (h : (p : P) → R p) (β : P → ℝ) (η V ρ : ℝ) (cap : ℕ)
    (H : Finset P) (old : Fin N → Σ p, R p)
    (G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ) : ℂ :=
  ∑ T ∈ (globalBirthVisitZeroIndices h old).powerset,
    ∑ b ∈ range ((univ \ H).card + 1), ∑ f : Fin b ↪ ↥((univ : Finset P) \ H),
      ((((-η / ρ) ^ T.card * ((1 - η) / ρ ^ 2) ^ (globalBirthVisitZeroIndices h old \ T).card) *
        ((-η * V / ρ) ^ b * (∏ j, β (f j).val / V)) / (b.factorial : ℝ) : ℝ) : ℂ) *
      (if (retainedBirthTuple old (univ \ T) (fun j => ⟨(f j).val, h (f j).val⟩)).1 ≤ cap then
        G (H ∪ globalVisitBirthRange (univ \ H) f)
          (retainedBirthTuple old (univ \ T) (fun j => ⟨(f j).val, h (f j).val⟩)) else 0)

/-- The earlier phase-test row is an exact specialization of the raw operator. -/
theorem global_birth_visit_raw_row_specialize {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, DecidableEq (R p)] {N : ℕ}
    (h : (p : P) → R p) (β : P → ℝ) (η V ρ : ℝ) (cap : ℕ)
    (active H : Finset P) (old : Fin N → Σ p, R p)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) :
    globalBirthGhostVisitRawRow h β η V ρ cap H old
      (fun H' q' => symmetricPhaseReadout (globalBirthMemoryBase active H') F q') =
      globalBirthGhostVisitIndexRow h β η V ρ cap active H old F := rfl

/-- Every literal raw event sends a coherent input to coherent output,
including events whose signed coefficient happens to vanish. -/
theorem global_birth_visit_raw_output_coherent {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, DecidableEq (R p)]
    (a : P → Bool) (h : (p : P) → R p)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent (ghostPhaseActivitySupport a) H q)
    (T : Finset (Fin q.1)) (hT : T ⊆ globalBirthVisitZeroIndices h q.2)
    {b : ℕ} (f : Fin b ↪ ↥((univ : Finset P) \ H)) :
    GlobalBirthMemoryCoherent (ghostPhaseActivitySupport a)
      (H ∪ globalVisitBirthRange (univ \ H) f)
      (retainedBirthTuple q.2 (univ \ T) (fun j => ⟨(f j).val, h (f j).val⟩)) := by
  have hd : T.image (fun j => (q.2 j).1) ⊆ globalBirthVisitZeros h q.2 := by
    rw [global_birth_visit_zero_labels]
    exact image_subset_image hT
  have hf : Function.Injective (fun j => (f j).val) := by
    intro j k hjk
    exact f.injective (Subtype.ext hjk)
  have hc := coherent_global_birth_visit_output a h H q hq
    (T.image (fun j => (q.2 j).1)) (globalVisitBirthRange (univ \ H) f) hd
    (global_visit_birth_range_subset _ f) (fun j => (f j).val) hf
    (global_visit_birth_range_image _ f)
  rw [global_birth_visit_index_output h q.2 hq.label_injective T] at hc
  exact hc

/-- Equality of continuations is needed only on coherent, cutoff-supported
output snapshots. This is the induction interface for consecutive raw rows. -/
theorem global_birth_visit_raw_row_congr {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, DecidableEq (R p)]
    (a : P → Bool) (h : (p : P) → R p) (β : P → ℝ) (η V ρ : ℝ) (cap : ℕ)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent (ghostPhaseActivitySupport a) H q)
    (G K : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ)
    (hGK : ∀ H' q', GlobalBirthMemoryCoherent (ghostPhaseActivitySupport a) H' q' →
      q'.1 ≤ cap → G H' q' = K H' q') :
    globalBirthGhostVisitRawRow h β η V ρ cap H q.2 G =
      globalBirthGhostVisitRawRow h β η V ρ cap H q.2 K := by
  unfold globalBirthGhostVisitRawRow
  apply sum_congr rfl
  intro T hT
  apply sum_congr rfl
  intro b _
  apply sum_congr rfl
  intro f _
  congr 1
  split_ifs with hc
  · exact hGK _ _ (global_birth_visit_raw_output_coherent a h H q hq T
      (mem_powerset.mp hT) f) hc
  · rfl

/-- Raw-row intertwining on coherent inputs. An arbitrary continuation that
agrees with a phase test on coherent bounded outputs gives the exact phase row. -/
theorem coherent_global_birth_visit_raw_row {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    (a : P → Bool) (h : (p : P) → R p) (β : P → ℝ)
    (η V ρ : ℝ) (hV : V ≠ 0) (cap : ℕ)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent (ghostPhaseActivitySupport a) H q)
    (G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ)
    (hG : ∀ H' q', GlobalBirthMemoryCoherent (ghostPhaseActivitySupport a) H' q' →
      q'.1 ≤ cap → G H' q' = F (globalBirthMemoryReadout (ghostPhaseActivitySupport a) H' q')) :
    globalBirthGhostVisitRawRow h β η V ρ cap H q.2 G =
      ∑ z, ((∏ p, ghostPhaseDampedVisit (a p) (h p) η (β p) ρ (z p)
        (globalBirthMemoryReadout (ghostPhaseActivitySupport a) H q p) : ℝ) : ℂ) *
        (if (ghostPhasePendingSupport z).card ≤ cap then F z else 0) := by
  calc
    _ = globalBirthGhostVisitRawRow h β η V ρ cap H q.2
        (fun H' q' => symmetricPhaseReadout
          (globalBirthMemoryBase (ghostPhaseActivitySupport a) H') F q') := by
      apply global_birth_visit_raw_row_congr a h β η V ρ cap H q hq
      intro H' q' hq' hcap
      rw [hG H' q' hq' hcap, global_birth_coherent_symmetric_readout _ H' q' hq' F]
    _ = _ := by
      rw [global_birth_visit_raw_row_specialize]
      exact coherent_global_birth_visit_row a h β η V ρ hV cap H q hq F
end

section
open Finset
open scoped Classical
noncomputable def globalBirthEdgeRawRow {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] {N t : ℕ}
    (source target : Fin t ↪ P) (delta : (p : P) → R p)
    (H : Finset P) (old : Fin N → Σ p, R p) (eligible : Finset (Fin N))
    (β : P → ℝ) (ρ V : ℝ) (cap : ℕ)
    (G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ) : ℂ :=
  unrestrictedEdgeAction source old Sigma.fst (fun p => ⟨p, 0⟩)
    (unrestrictedPhaseTransport delta) (fun z => z.2 = 0)
    (fun p => β p / V) ρ V eligible cap
    (fun _stores promotions e fresh =>
      if unrestrictedEdgeTarget old Sigma.fst promotions e fresh = target ∧
        (∀ s, fresh s ∉ H) then 1 else 0)
    (fun target' q' => G (H ∪ univ.image target') q')

theorem coherent_global_birth_edge_raw_output {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] {t : ℕ}
    (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent (ghostPhaseActivitySupport asrc) H q)
    (source target : Fin t ↪ P)
    (hsource : univ.image source = ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt)
    (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    (eligible : Finset (Fin q.1)) (stores promotions : Finset (Fin t))
    (e : promotions ↪ eligible) (fresh : UnrestrictedFreshLabels P promotions)
    (hv : unrestrictedEdgeTarget q.2 Sigma.fst promotions e fresh = target ∧
      (∀ s, fresh s ∉ H)) :
    GlobalBirthMemoryCoherent (ghostPhaseActivitySupport atgt)
      (H ∪ univ.image (unrestrictedEdgeTarget q.2 Sigma.fst promotions e fresh))
      (unrestrictedEdgeOutput source q.2 (fun p => ⟨p, 0⟩)
        (unrestrictedPhaseTransport delta) stores promotions e) := by
  let w := globalBirthMemoryReadout (ghostPhaseActivitySupport asrc) H q
  let f := globalBirthCoherentSupport (ghostPhaseActivitySupport asrc) H q hq
  have hw := global_birth_coherent_readout_mask asrc H q hq
  have hborn : ghostPhaseBornSupport w = H :=
    global_birth_coherent_readout_born_support (ghostPhaseActivitySupport asrc) H q hq
  have heq : (fun j => (⟨f.val j, (q.2 j).2⟩ : Σ p, R p)) = q.2 := by
    funext j
    rfl
  have hvalid : GlobalBirthEdgeEventValid (ghostPhaseBornSupport w) f.val target
      ⟨promotions, e, fresh⟩ := by
    rw [hborn]
    exact hv
  have hc := global_birth_edge_output_coherent atgt asrc delta w hw source target
    hsource htarget f (fun j => (q.2 j).2) eligible stores ⟨promotions, e, fresh⟩ hvalid
  simpa only [hborn, heq, hv.1] using hc

/-- Continuations need agree only on coherent outputs within the actual cutoff. -/
theorem global_birth_edge_raw_row_congr {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] {t : ℕ}
    (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent (ghostPhaseActivitySupport asrc) H q)
    (source target : Fin t ↪ P)
    (hsource : univ.image source = ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt)
    (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    (eligible : Finset (Fin q.1)) (β : P → ℝ) (ρ V : ℝ) (cap : ℕ)
    (G K : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ)
    (hGK : ∀ H' q', GlobalBirthMemoryCoherent (ghostPhaseActivitySupport atgt) H' q' →
      q'.1 ≤ cap → G H' q' = K H' q') :
    globalBirthEdgeRawRow source target delta H q.2 eligible β ρ V cap G =
      globalBirthEdgeRawRow source target delta H q.2 eligible β ρ V cap K := by
  unfold globalBirthEdgeRawRow unrestrictedEdgeAction
  apply sum_congr rfl
  intro stores _
  apply sum_congr rfl
  intro promotions _
  apply sum_congr rfl
  intro e _
  apply sum_congr rfl
  intro fresh _
  by_cases hv : unrestrictedEdgeTarget q.2 Sigma.fst promotions e fresh = target ∧
      (∀ s, fresh s ∉ H)
  · simp only [if_pos hv, mul_one]
    congr 1
    split_ifs with hc
    · exact hGK _ _ (coherent_global_birth_edge_raw_output atgt asrc delta H q hq
        source target hsource htarget eligible stores promotions e fresh hv) hc
    · rfl
  · simp only [if_neg hv, mul_zero, zero_mul]

/-- Exact raw-row intertwining on every coherent source, including incompatible
sources. Shared active hits and the exact old-hit eligibility rule are explicit. -/
theorem coherent_global_birth_edge_raw_row {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    {t : ℕ} (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (hshared : ∀ p, atgt p = true ∧ asrc p = true → delta p = 0)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent (ghostPhaseActivitySupport asrc) H q)
    (source target : Fin t ↪ P)
    (hsource : univ.image source = ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt)
    (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    (eligible : Finset (Fin q.1))
    (heligible : ∀ j, j ∈ eligible ↔ (q.2 j).2 = delta (q.2 j).1)
    (β : P → ℝ) (ρ V : ℝ) (cap : ℕ)
    (G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ)
    (hG : ∀ H' q', GlobalBirthMemoryCoherent (ghostPhaseActivitySupport atgt) H' q' →
      q'.1 ≤ cap → G H' q' = F (globalBirthMemoryReadout (ghostPhaseActivitySupport atgt) H' q')) :
    globalBirthEdgeRawRow source target delta H q.2 eligible β ρ V cap G =
      ∑ z, ((∏ p, (if atgt p && !(asrc p) then V⁻¹ else 1) *
        ghostPhaseDampedMovingEdge (atgt p) (asrc p) (delta p) (β p) ρ ρ (z p)
          (globalBirthMemoryReadout (ghostPhaseActivitySupport asrc) H q p) : ℝ) : ℂ) *
        (if (ghostPhasePendingSupport z).card ≤ cap then F z else 0) := by
  calc
    _ = globalBirthEdgeRawRow source target delta H q.2 eligible β ρ V cap
        (fun H' q' => symmetricPhaseReadout
          (globalBirthMemoryBase (ghostPhaseActivitySupport atgt) H') F q') := by
      apply global_birth_edge_raw_row_congr atgt asrc delta H q hq source target
        hsource htarget eligible β ρ V cap
      intro H' q' hq' hcap
      rw [hG H' q' hq' hcap, global_birth_coherent_symmetric_readout _ H' q' hq' F]
    _ = _ := by
      have he := coherent_complete_global_birth_edge_row atgt asrc delta hshared H q hq
        source target hsource htarget eligible heligible β ρ V cap F
      refine Eq.trans ?_ he
      unfold globalBirthEdgeRawRow
      congr 1
      funext stores promotions e fresh
      by_cases hv : unrestrictedEdgeTarget q.2 Sigma.fst promotions e fresh = target ∧
          (∀ s, fresh s ∉ H)
      · rw [if_pos hv, if_pos (show GlobalBirthEdgeEventValid H
          (globalBirthCoherentSupport (ghostPhaseActivitySupport asrc) H q hq).val target
          ⟨promotions, e, fresh⟩ from hv)]
      · rw [if_neg hv, if_neg (show ¬GlobalBirthEdgeEventValid H
          (globalBirthCoherentSupport (ghostPhaseActivitySupport asrc) H q hq).val target
          ⟨promotions, e, fresh⟩ from hv)]
end

section
open Finset
/-- A literal visit preserves the activity mask. A literal edge has fixed
source/target slot enumerations and the physical shared-hit constraint. -/
inductive GlobalBirthRawStep {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] : (P → Bool) → (P → Bool) → Type _
  | visit {a : P → Bool} (h : (p : P) → R p) (β : P → ℝ)
      (η V ρ : ℝ) (hV : V ≠ 0) (cap : Nat) : GlobalBirthRawStep (R := R) a a
  | edge {a b : P → Bool} (delta : (p : P) → R p)
      (hshared : ∀ p, b p = true ∧ a p = true → delta p = 0)
      {t : Nat} (source target : Fin t ↪ P)
      (hsource : univ.image source = ghostPhaseActivitySupport a \ ghostPhaseActivitySupport b)
      (htarget : univ.image target = ghostPhaseNewRunSet b a)
      (β : P → ℝ) (ρ V : ℝ) (cap : Nat) : GlobalBirthRawStep (R := R) a b

/-- The cutoff is physical step data and is independent of the input memory. -/
def globalBirthRawStepCap {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] {a b : P → Bool}
    (step : GlobalBirthRawStep (R := R) a b) : Nat :=
  match step with
  | .visit _ _ _ _ _ _ cap => cap
  | .edge _ _ _ _ _ _ _ _ _ cap => cap

/-- Eligible promotion positions are exactly the old particles hitting the
target frame. No extra compatibility or matching witness is supplied. -/
noncomputable def globalBirthRawHitIndices {P : Type*} {R : P → Type*}
    [∀ p, DecidableEq (R p)] (delta : (p : P) → R p)
    (q : FiniteOrderedTuple (Σ p, R p)) : Finset (Fin q.1) :=
  univ.filter (fun j => (q.2 j).2 = delta (q.2 j).1)

theorem global_birth_raw_hit_indices_mem {P : Type*} {R : P → Type*}
    [∀ p, DecidableEq (R p)] (delta : (p : P) → R p)
    (q : FiniteOrderedTuple (Σ p, R p)) (j : Fin q.1) :
    j ∈ globalBirthRawHitIndices delta q ↔ (q.2 j).2 = delta (q.2 j).1 := by
  simp only [globalBirthRawHitIndices, mem_filter, mem_univ, true_and]

/-- The actual event row accepts an arbitrary continuation on the updated
birth ledger and literal ordered memory. It contains no phase readout. -/
noncomputable def globalBirthRawStepRow {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)]
    {a b : P → Bool} (step : GlobalBirthRawStep (R := R) a b)
    (G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p)) : ℂ :=
  match step with
  | .visit h β η V ρ _ cap => globalBirthGhostVisitRawRow h β η V ρ cap H q.2 G
  | .edge delta _ source target _ _ β ρ V cap =>
      globalBirthEdgeRawRow source target delta H q.2 (globalBirthRawHitIndices delta q)
        β ρ V cap G

/-- The exact finite tensor phase row, with the same output cutoff. Visit
coefficients and normalized moving-edge coefficients keep their signs. -/
noncomputable def globalBirthRawStepPhaseRow {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)]
    [∀ p, DecidableEq (R p)] {a b : P → Bool}
    (step : GlobalBirthRawStep (R := R) a b)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ)
    (w : (p : P) → GhostPhaseState (R p)) : ℂ := by
  classical
  cases step with
  | visit h β η V ρ hV cap =>
      exact ∑ z, ((∏ p, ghostPhaseDampedVisit (a p) (h p) η (β p) ρ (z p) (w p) : ℝ) : ℂ) *
        (if (ghostPhasePendingSupport z).card ≤ cap then F z else 0)
  | edge delta hshared source target hsource htarget β ρ V cap =>
      exact ∑ z, ((∏ p, (if b p && !(a p) then V⁻¹ else 1) *
        ghostPhaseDampedMovingEdge (b p) (a p) (delta p) (β p) ρ ρ (z p) (w p) : ℝ) : ℂ) *
        (if (ghostPhasePendingSupport z).card ≤ cap then F z else 0)

/-- Actual raw rows depend only on the continuation on coherent outputs
inside the step's output cap. This is sufficient to substitute suffix rows. -/
theorem global_birth_raw_step_row_congr {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)]
    {a b : P → Bool} (step : GlobalBirthRawStep (R := R) a b)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent (ghostPhaseActivitySupport a) H q)
    (G K : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ)
    (hGK : ∀ H' q', GlobalBirthMemoryCoherent (ghostPhaseActivitySupport b) H' q' →
      q'.1 ≤ globalBirthRawStepCap step → G H' q' = K H' q') :
    globalBirthRawStepRow step G H q = globalBirthRawStepRow step K H q := by
  cases step with
  | visit h β η V ρ hV cap =>
      exact global_birth_visit_raw_row_congr a h β η V ρ cap H q hq G K hGK
  | edge delta hshared source target hsource htarget β ρ V cap =>
      exact global_birth_edge_raw_row_congr b a delta H q hq source target hsource htarget
        (globalBirthRawHitIndices delta q) β ρ V cap G K hGK

/-- Every actual chronological step intertwines with its exact finite phase
row. The continuation hypothesis is needed only on coherent bounded outputs;
no compatibility or eligible-promotion existence hypothesis is hidden here. -/
theorem global_birth_raw_step_intertwines {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)]
    [∀ p, DecidableEq (R p)] {a b : P → Bool}
    (step : GlobalBirthRawStep (R := R) a b)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent (ghostPhaseActivitySupport a) H q)
    (G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ)
    (hG : ∀ H' q', GlobalBirthMemoryCoherent (ghostPhaseActivitySupport b) H' q' →
      q'.1 ≤ globalBirthRawStepCap step →
        G H' q' = F (globalBirthMemoryReadout (ghostPhaseActivitySupport b) H' q')) :
    globalBirthRawStepRow step G H q = globalBirthRawStepPhaseRow step F
      (globalBirthMemoryReadout (ghostPhaseActivitySupport a) H q) := by
  cases step with
  | visit h β η V ρ hV cap =>
      exact coherent_global_birth_visit_raw_row a h β η V ρ hV cap H q hq G F hG
  | edge delta hshared source target hsource htarget β ρ V cap =>
      exact coherent_global_birth_edge_raw_row b a delta hshared H q hq source target
        hsource htarget (globalBirthRawHitIndices delta q)
        (global_birth_raw_hit_indices_mem delta q) β ρ V cap G F hG
end

section
open Finset
abbrev GlobalBirthHistoryState {P : Type*} (R : P → Type*) :=
  Finset P × FiniteOrderedTuple (Σ p, R p)

section History

variable {P : Type*} [Fintype P] [DecidableEq P] {R : P → Type*}
  [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
  (a : ℕ → P → Bool) (steps : ∀ i, GlobalBirthRawStep (R := R) (a i) (a (i + 1)))

/-- The genuine snapshot row at a cut, packaged for chronological composition. -/
noncomputable def globalBirthHistoryRawRow (i : ℕ)
    (G : GlobalBirthHistoryState R → ℂ) (s : GlobalBirthHistoryState R) : ℂ :=
  globalBirthRawStepRow (steps i) (fun H q => G (H, q)) s.1 s.2

/-- The corresponding genuine finite phase-kernel row, including its cutoff. -/
noncomputable def globalBirthHistoryPhaseRow (i : ℕ)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ)
    (w : (p : P) → GhostPhaseState (R p)) : ℂ :=
  globalBirthRawStepPhaseRow (steps i) F w

/-- Pull a raw terminal continuation through the actual rows in time order. -/
noncomputable def globalBirthRawHistory (n : ℕ)
    (G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p)) : ℂ :=
  finiteRowComposition (S := fun _ => GlobalBirthHistoryState R)
    (globalBirthHistoryRawRow a steps) n
    (fun s => G s.1 s.2) (H, q)

/-- Pull a terminal phase test through precisely the same step sequence. -/
noncomputable def globalBirthPhaseHistory (n : ℕ)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ)
    (w : (p : P) → GhostPhaseState (R p)) : ℂ :=
  finiteRowComposition (S := fun _ => (p : P) → GhostPhaseState (R p))
    (globalBirthHistoryPhaseRow a steps) n F w

/-- Actual visit/edge histories intertwine on every coherent initial snapshot.
This uses the proved numerical row identities of each actual step, not an
assumed abstract row equality. Intermediate cutoffs stay inside those rows. -/
theorem global_birth_raw_history_intertwines (n : ℕ)
    (G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ)
    (hterminal : ∀ H' q', GlobalBirthMemoryCoherent (ghostPhaseActivitySupport (a n)) H' q' →
      G H' q' = F (globalBirthMemoryReadout (ghostPhaseActivitySupport (a n)) H' q'))
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent (ghostPhaseActivitySupport (a 0)) H q) :
    globalBirthRawHistory a steps n G H q =
      globalBirthPhaseHistory a steps n F
        (globalBirthMemoryReadout (ghostPhaseActivitySupport (a 0)) H q) := by
  induction n generalizing G F with
  | zero => exact hterminal H q hq
  | succ n ih =>
      change globalBirthRawHistory a steps n (globalBirthRawStepRow (steps n) G) H q =
        globalBirthPhaseHistory a steps n (globalBirthRawStepPhaseRow (steps n) F)
          (globalBirthMemoryReadout (ghostPhaseActivitySupport (a 0)) H q)
      apply ih
      intro H' q' hq'
      exact global_birth_raw_step_intertwines (steps n) H' q' hq' G F
        (fun H'' q'' hq'' _ => hterminal H'' q'' hq'')

/-- In particular, the ordinary terminal readout gives an exact history
identity without any additional terminal symmetry or boundedness premise. -/
theorem global_birth_raw_history_readout (n : ℕ)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent (ghostPhaseActivitySupport (a 0)) H q) :
    globalBirthRawHistory a steps n
      (fun H' q' => F (globalBirthMemoryReadout (ghostPhaseActivitySupport (a n)) H' q')) H q =
      globalBirthPhaseHistory a steps n F
        (globalBirthMemoryReadout (ghostPhaseActivitySupport (a 0)) H q) :=
  global_birth_raw_history_intertwines a steps n _ F (fun _ _ _ => rfl) H q hq

end History
end

section

theorem primePoolPart_mul_of_free {P : Finset ℕ} {p n : ℕ}
    (hp : p ∈ Nat.factoredNumbers P) (hn : n ≠ 0)
    (hfree : Disjoint n.primeFactors P) : primePoolPart P (p * n) = p := by
  exact primePoolPart_mul_of_disjoint hfree.symm hp
    (Nat.mem_factoredNumbers_of_primeFactors_subset hn (fun _ h => h))

theorem primePoolFreePart_mul_of_free {P : Finset ℕ} {p n : ℕ}
    (hp : p ∈ Nat.factoredNumbers P) (hn : n ≠ 0)
    (hfree : Disjoint n.primeFactors P) : primePoolFreePart P (p * n) = n := by
  exact primePoolFreePart_mul_of_disjoint hfree.symm hp
    (Nat.mem_factoredNumbers_of_primeFactors_subset hn (fun _ h => h))

theorem supported_free_product_unique {P : Finset ℕ} {p₁ n₁ p₂ n₂ : ℕ}
    (hp₁ : p₁ ∈ Nat.factoredNumbers P) (hn₁ : n₁ ≠ 0)
    (hfree₁ : Disjoint n₁.primeFactors P)
    (hp₂ : p₂ ∈ Nat.factoredNumbers P) (hn₂ : n₂ ≠ 0)
    (hfree₂ : Disjoint n₂.primeFactors P) (hmul : p₁ * n₁ = p₂ * n₂) :
    p₁ = p₂ ∧ n₁ = n₂ := by
  have hpart := congrArg (primePoolPart P) hmul
  have hfree := congrArg (primePoolFreePart P) hmul
  rw [primePoolPart_mul_of_free hp₁ hn₁ hfree₁,
    primePoolPart_mul_of_free hp₂ hn₂ hfree₂] at hpart
  rw [primePoolFreePart_mul_of_free hp₁ hn₁ hfree₁,
    primePoolFreePart_mul_of_free hp₂ hn₂ hfree₂] at hfree
  exact ⟨hpart, hfree⟩

theorem supported_free_product_injective (P : Finset ℕ) :
    Function.Injective (fun z : Nat.factoredNumbers P ×
      {n : ℕ // n ≠ 0 ∧ Disjoint n.primeFactors P} => z.1.val * z.2.val) := by
  intro x y hxy
  obtain ⟨hp, hn⟩ := supported_free_product_unique
    x.1.property x.2.property.1 x.2.property.2
    y.1.property y.2.property.1 y.2.property.2 hxy
  exact Prod.ext (Subtype.ext hp) (Subtype.ext hn)
end

section
open Filter
open scoped Topology
theorem exists_candidate_ordinary_mass_polynomial_lower {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∃ J : ℕ, ∀ jStar : ℕ, J < jStar →
      ∀ᶠ L : ℝ in atTop,
        Real.exp L * L^(-C) ≤ candidateOrdinaryWindowMass c L q r jStar := by
  obtain ⟨K, hK, J, hmass⟩ := exists_candidate_ordinary_window_mass_lower hc hr hq0 hq1 hcenter
  obtain ⟨D, hD, hQ⟩ := exists_candidate_Q_harmonic_polynomial_bounds hc r
  refine ⟨D + 2, by linarith, J, ?_⟩
  intro jStar hj
  filter_upwards [hmass, hQ jStar,
    eventually_candidate_one_marked_mass_ge_one hc hq0 hq1.le,
    eventually_gt_atTop (0 : ℝ), eventually_ge_atTop (1 / K)] with L hm hq hp hL hlarge
  have hInv : 1 / L ≤ K := by
    apply (div_le_iff₀ hL).mpr
    have h := (div_le_iff₀ hK).mp hlarge
    linarith
  have hQ0 : 0 ≤ candidateQHarmonicMass c L r jStar :=
    (Real.rpow_pos_of_pos hL (-D)).le.trans hq.1
  have hsmall : (1 / L) * (Real.exp L / L) * L^(-D) ≤
      K * (Real.exp L / L) * candidateOneMarkedHarmonicMass c L q *
        candidateQHarmonicMass c L r jStar := by
    calc
      _ ≤ K * (Real.exp L / L) * L^(-D) :=
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hInv (by positivity)) (by positivity)
      _ ≤ K * (Real.exp L / L) * candidateQHarmonicMass c L r jStar :=
        mul_le_mul_of_nonneg_left hq.1 (by positivity)
      _ = (K * (Real.exp L / L) * 1) * candidateQHarmonicMass c L r jStar := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hp (by positivity)) hQ0
  have heq : Real.exp L * L^(-(D + 2)) = (1 / L) * (Real.exp L / L) * L^(-D) := by
    rw [show -(D + 2) = (-D + (-1)) + (-1) by ring,
      Real.rpow_add hL, Real.rpow_add hL, Real.rpow_neg_one]
    ring
  exact heq.le.trans (hsmall.trans (hm jStar hj))
end

section
open Finset
private theorem prod_mem_factored_pool {I : Type*} (S : Finset I) (P : Finset ℕ)
    (v : I → ℕ) (hv : ∀ i ∈ S, v i ∈ Nat.factoredNumbers P) :
    (∏ i ∈ S, v i) ∈ Nat.factoredNumbers P := by
  classical
  induction S using Finset.induction_on with
  | empty => simp [Nat.mem_factoredNumbers]
  | @insert i S hi ih =>
    rw [prod_insert hi]
    exact Nat.mul_mem_factoredNumbers (hv i (mem_insert_self _ _))
      (ih (fun j hj => hv j (mem_insert_of_mem hj)))

private theorem primePoolPart_prod {I : Type*} (S : Finset I) (P : Finset ℕ)
    (v : I → ℕ) (hv : ∀ i ∈ S, v i ≠ 0) :
    primePoolPart P (∏ i ∈ S, v i) = ∏ i ∈ S, primePoolPart P (v i) := by
  classical
  induction S using Finset.induction_on with
  | empty => simp [primePoolPart, Finsupp.filter_zero]
  | @insert i S hi ih =>
    rw [prod_insert hi, prod_insert hi, primePoolPart_mul P (hv i (mem_insert_self _ _))
      (prod_ne_zero_iff.mpr (fun j hj => hv j (mem_insert_of_mem hj))),
      ih (fun j hj => hv j (mem_insert_of_mem hj))]

private theorem primePoolPart_group_prod {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h))) (v : G → ℕ)
    (hv : ∀ g, v g ∈ Nat.factoredNumbers (P g)) (g : G) :
    primePoolPart (P g) (∏ h, v h) = v g := by
  classical
  rw [primePoolPart_prod univ (P g) v (fun h _ => (hv h).1)]
  calc
    (∏ h, primePoolPart (P g) (v h)) = primePoolPart (P g) (v g) := by
      apply prod_eq_single g
      · intro h _ hne
        exact primePoolPart_eq_one_of_disjoint (hdisj (Ne.symm hne)) (hv h)
      · simp
    _ = v g := primePoolPart_eq_self_of_mem (hv g)

private theorem prime_tuple_prod_mem {k : ℕ} (P : Finset ℕ) (x : Fin k → ℕ)
    (hprime : ∀ p ∈ P, p.Prime) (hx : ∀ i, x i ∈ P) :
    (∏ i, x i) ∈ Nat.factoredNumbers P := by
  apply prod_mem_factored_pool
  intro i _
  apply Nat.mem_factoredNumbers'.mpr
  intro p hp hpi
  have heq := (Nat.prime_dvd_prime_iff_eq hp (hprime _ (hx i))).mp hpi
  simpa only [heq] using hx i

/-- Equal full products determine the ordered prime list in each group up to permutation.
Repeated primes remain repeated; no injectivity condition on slot values is used. -/
theorem prime_group_lists_perm_of_prod_eq {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (k : G → ℕ)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h)))
    (x y : ∀ g, Fin (k g) → ℕ)
    (hx : ∀ g i, x g i ∈ P g) (hy : ∀ g i, y g i ∈ P g)
    (hprod : (∏ g, ∏ i, x g i) = ∏ g, ∏ i, y g i) (g : G) :
    (List.ofFn (x g)).Perm (List.ofFn (y g)) := by
  have heq : (∏ i, x g i) = ∏ i, y g i := by
    rw [← primePoolPart_group_prod P hdisj (fun h => ∏ i, x h i)
      (fun h => prime_tuple_prod_mem (P h) (x h) (hprime h) (hx h)) g,
      ← primePoolPart_group_prod P hdisj (fun h => ∏ i, y h i)
      (fun h => prime_tuple_prod_mem (P h) (y h) (hprime h) (hy h)) g, hprod]
  apply perm_of_prod_eq_prod
  · simpa only [List.prod_ofFn] using heq
  · exact List.forall_mem_ofFn_iff.mpr (fun i => (hprime g _ (hx g i)).prime)
  · exact List.forall_mem_ofFn_iff.mpr (fun i => (hprime g _ (hy g i)).prime)

/-- Any finite injectively represented family of grouped ordered slots has at most
`∏ g, (k g)!` members in a fixed product fiber. Repeated slot values are permitted. -/
theorem card_prime_group_product_fiber {G Ω : Type*} [Fintype G] [Fintype Ω]
    (P : G → Finset ℕ) (k : G → ℕ)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h)))
    (x : Ω → ∀ g, Fin (k g) → ℕ) (hxinj : Function.Injective x)
    (hx : ∀ a g i, x a g i ∈ P g) (n : ℕ) :
    Nat.card {a : Ω // (∏ g, ∏ i, x a g i) = n} ≤ ∏ g, (k g).factorial := by
  classical
  let F := {a : Ω // (∏ g, ∏ i, x a g i) = n}
  change Nat.card F ≤ _
  by_cases hF : Nonempty F
  · obtain ⟨a0⟩ := hF
    let target (g : G) := (List.ofFn (x a0.val g)).permutations.toFinset
    let f : F → ∀ g, target g := fun a g => ⟨List.ofFn (x a.val g), by
      apply List.mem_toFinset.mpr
      apply List.mem_permutations.mpr
      exact prime_group_lists_perm_of_prod_eq P k hprime hdisj (x a.val) (x a0.val)
        (hx a.val) (hx a0.val) (a.property.trans a0.property.symm) g⟩
    have hfinj : Function.Injective f := by
      intro a b hab
      apply Subtype.ext
      apply hxinj
      funext g
      apply List.ofFn_injective
      exact congrArg Subtype.val (congrFun hab g)
    rw [Nat.card_eq_fintype_card]
    calc
      Fintype.card F ≤ Fintype.card (∀ g, target g) := Fintype.card_le_of_injective f hfinj
      _ = ∏ g, (target g).card := by simp only [Fintype.card_pi, Fintype.card_coe]
      _ ≤ ∏ g, (k g).factorial := by
        apply prod_le_prod'
        intro g _
        simpa only [target, List.length_permutations, List.length_ofFn] using
          List.toFinset_card_le (List.ofFn (x a0.val g)).permutations
  · rw [Nat.card_eq_fintype_card, Fintype.card_eq_zero_iff.mpr (not_nonempty_iff.mp hF)]
    exact Nat.zero_le _

/-- The direct product fiber bound for all ordered choices in each prime group. -/
theorem card_ordered_prime_group_product_fiber {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (k : G → ℕ)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h))) (n : ℕ) :
    Nat.card {x : ∀ g, Fin (k g) → P g // (∏ g, ∏ i, (x g i).val) = n} ≤
      ∏ g, (k g).factorial := by
  classical
  have hinj : Function.Injective (fun x : ∀ g, Fin (k g) → P g =>
      fun g i => (x g i).val) := by
    intro x y h
    funext g i
    apply Subtype.ext
    exact congrFun (congrFun h g) i
  exact card_prime_group_product_fiber P k hprime hdisj
    (fun x : ∀ g, Fin (k g) → P g => fun g i => (x g i).val)
    hinj (fun x g i => (x g i).property) n

/-- Constant reciprocal weight on a product fiber, with arbitrary finite slot restrictions. -/
theorem prime_group_product_fiber_harmonic_bound {G Ω : Type*} [Fintype G] [Fintype Ω]
    (P : G → Finset ℕ) (k : G → ℕ)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h)))
    (x : Ω → ∀ g, Fin (k g) → ℕ) (hxinj : Function.Injective x)
    (hx : ∀ a g i, x a g i ∈ P g) (V : G → ℝ)
    (hV : ∀ g, 0 ≤ V g) (n : ℕ) :
    ((Nat.card {a : Ω // (∏ g, ∏ i, x a g i) = n} : ℝ) / (n : ℝ)) /
      (∏ g, (V g)^(k g)) ≤
        (1 / (n : ℝ)) * ∏ g, ((k g).factorial : ℝ) / (V g)^(k g) := by
  have hcard : (Nat.card {a : Ω // (∏ g, ∏ i, x a g i) = n} : ℝ) ≤
      ∏ g, ((k g).factorial : ℝ) := by
    exact_mod_cast card_prime_group_product_fiber P k hprime hdisj x hxinj hx n
  calc
    _ ≤ ((∏ g, ((k g).factorial : ℝ)) / (n : ℝ)) / (∏ g, (V g)^(k g)) :=
      div_le_div_of_nonneg_right (div_le_div_of_nonneg_right hcard (Nat.cast_nonneg n))
        (prod_nonneg (fun g _ => pow_nonneg (hV g) _))
    _ = _ := by rw [prod_div_distrib]; ring

/-- The normalized product of slot reciprocals is constant on each product fiber. -/
theorem prime_group_slot_reciprocal_identity {G : Type*} [Fintype G]
    (k : G → ℕ) (x : ∀ g, Fin (k g) → ℕ) (V : G → ℝ) :
    (∏ g, ∏ i, (1 / (x g i : ℝ)) / V g) =
      (1 / ((∏ g, ∏ i, x g i : ℕ) : ℝ)) / (∏ g, (V g)^(k g)) := by
  simp only [div_eq_mul_inv, one_mul, prod_mul_distrib, prod_inv_distrib,
    prod_const, Finset.card_univ, Fintype.card_fin, Nat.cast_prod]

/-- The harmonic atom bound in the form needed for finite weighted fibers. -/
theorem prime_group_slot_harmonic_atom_bound {G Ω : Type*} [Fintype G] [Fintype Ω]
    (P : G → Finset ℕ) (k : G → ℕ)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h)))
    (x : Ω → ∀ g, Fin (k g) → ℕ) (hxinj : Function.Injective x)
    (hx : ∀ a g i, x a g i ∈ P g) (V : G → ℝ)
    (hV : ∀ g, 0 ≤ V g) (n : ℕ) :
    (∑ a : Ω, if (∏ g, ∏ i, x a g i) = n then
      (∏ g, ∏ i, (1 / (x a g i : ℝ)) / V g) else 0) ≤
        (1 / (n : ℝ)) * ∏ g, ((k g).factorial : ℝ) / (V g)^(k g) := by
  classical
  have heq : (∑ a : Ω, if (∏ g, ∏ i, x a g i) = n then
      (∏ g, ∏ i, (1 / (x a g i : ℝ)) / V g) else 0) =
      ((Nat.card {a : Ω // (∏ g, ∏ i, x a g i) = n} : ℝ) / (n : ℝ)) /
        (∏ g, (V g)^(k g)) := by
    simp_rw [prime_group_slot_reciprocal_identity]
    have ht : ∀ a : Ω,
        (if (∏ g, ∏ i, x a g i) = n then
          (1 / ((∏ g, ∏ i, x a g i : ℕ) : ℝ)) / (∏ g, (V g)^(k g)) else 0) =
        (if (∏ g, ∏ i, x a g i) = n then
          (1 / (n : ℝ)) / (∏ g, (V g)^(k g)) else 0) := by
      intro a
      split_ifs with h
      · rw [h]
      · rfl
    simp_rw [ht]
    simp [Nat.card_eq_fintype_card, Fintype.card_subtype, ← sum_filter, div_eq_mul_inv, mul_assoc]
  rw [heq]
  exact prime_group_product_fiber_harmonic_bound P k hprime hdisj x hxinj hx V hV n
end

section
open Finset
noncomputable def primeFiberFactorBound (v : ℝ) (m : ℕ) : ℝ :=
  (m.factorial : ℝ) * (max 1 (1 / v))^m

theorem one_le_primeFiberFactorBound (v : ℝ) (m : ℕ) :
    1 ≤ primeFiberFactorBound v m := by
  have hfac : (1 : ℝ) ≤ m.factorial := by
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr (Nat.factorial_ne_zero m)
  have hpow : (1 : ℝ) ≤ (max 1 (1 / v))^m := one_le_pow₀ (le_max_left _ _)
  simpa only [one_mul, primeFiberFactorBound] using
    mul_le_mul hfac hpow (by norm_num) (by positivity)

theorem prime_fiber_factor_le_bound {v V : ℝ} (hv : 0 < v) (hV : v ≤ V)
    {k m : ℕ} (hk : k ≤ m) :
    (k.factorial : ℝ) / V^k ≤ primeFiberFactorBound v m := by
  have hVpos : 0 < V := hv.trans_le hV
  have hinv : 1 / V ≤ max 1 (1 / v) :=
    (one_div_le_one_div_of_le hv hV).trans (le_max_right _ _)
  have hpow : (1 / V)^k ≤ (max 1 (1 / v))^m :=
    (pow_le_pow_left₀ (by positivity) hinv k).trans
      (pow_le_pow_right₀ (le_max_left _ _) hk)
  have hfac : (k.factorial : ℝ) ≤ m.factorial := by exact_mod_cast Nat.factorial_le hk
  calc
    _ = (k.factorial : ℝ) * (1 / V)^k := by rw [one_div_pow]; ring
    _ ≤ primeFiberFactorBound v m := mul_le_mul hfac hpow (by positivity) (by positivity)

theorem prime_fiber_factor_product_le_rpow {G : Type*} (groups : Finset G)
    (V : G → ℝ) (k : G → ℕ) (m : ℕ) {v L D : ℝ} (hv : 0 < v) (hL : 0 < L)
    (hV : ∀ g ∈ groups, v ≤ V g) (hk : ∀ g ∈ groups, k g ≤ m)
    (hcard : (groups.card : ℝ) ≤ D * Real.log L) :
    (∏ g ∈ groups, ((k g).factorial : ℝ) / (V g)^(k g)) ≤
      L^(D * Real.log (primeFiberFactorBound v m)) := by
  exact group_product_bound_of_log_card groups
    (fun g => ((k g).factorial : ℝ) / (V g)^(k g))
    (one_le_primeFiberFactorBound v m) hL
    (fun g hg => div_nonneg (Nat.cast_nonneg _) (pow_nonneg (hv.le.trans (hV g hg)) _))
    (fun g hg => prime_fiber_factor_le_bound hv (hV g hg) (hk g hg)) hcard

theorem prime_fiber_factor_fintype_product_le_rpow {G : Type*} [Fintype G]
    (V : G → ℝ) (k : G → ℕ) (m : ℕ) {v L D : ℝ} (hv : 0 < v) (hL : 0 < L)
    (hV : ∀ g, v ≤ V g) (hk : ∀ g, k g ≤ m)
    (hcard : (Fintype.card G : ℝ) ≤ D * Real.log L) :
    (∏ g, ((k g).factorial : ℝ) / (V g)^(k g)) ≤
      L^(D * Real.log (primeFiberFactorBound v m)) := by
  exact prime_fiber_factor_product_le_rpow univ V k m hv hL
    (fun g _ => hV g) (fun g _ => hk g) (by simpa only [card_univ] using hcard)
end

section
open Finset
open scoped Classical
def ghostPhaseInitialState {P : Type*} {R : P → Type*}
    (a : P → Bool) (p : P) : GhostPhaseState (R p) :=
  if a p then none else some none

theorem ghost_phase_initial_point_mass {R : Type*} [DecidableEq R]
    (a : Bool) (β : ℝ) (z : GhostPhaseState R) :
    ghostPhaseInitial a β z =
      if z = (if a then none else some none) then (if a then β else 1) else 0 := by
  cases a <;> rcases z with _ | (_ | (_ | r)) <;>
    simp [ghostPhaseInitial, ghostFiniteInitial]

theorem ghost_phase_initial_tensor_point_mass {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, DecidableEq (R p)]
    (a : P → Bool) (β : P → ℝ) (z : (p : P) → GhostPhaseState (R p)) :
    (∏ p, ghostPhaseInitial (a p) (β p) (z p)) =
      if z = ghostPhaseInitialState a then (∏ p, if a p then β p else 1) else 0 := by
  by_cases hz : z = ghostPhaseInitialState a
  · subst z
    simp only [ghost_phase_initial_point_mass, ghostPhaseInitialState]
    simp only [ite_true]
  · rw [if_neg hz]
    obtain ⟨p, hp⟩ := Function.ne_iff.mp hz
    apply prod_eq_zero (mem_univ p)
    rw [ghost_phase_initial_point_mass]
    exact if_neg hp

theorem ghost_phase_initial_tensor_sum {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    (a : P → Bool) (β : P → ℝ)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) :
    (∑ z, ((∏ p, ghostPhaseInitial (a p) (β p) (z p) : ℝ) : ℂ) * F z) =
      ((∏ p, if a p then β p else 1 : ℝ) : ℂ) * F (ghostPhaseInitialState a) := by
  simp only [ghost_phase_initial_tensor_point_mass]
  rw [sum_eq_single (ghostPhaseInitialState a)]
  · simp only [ite_true]
  · intro z _ hz
    simp only [if_neg hz, Complex.ofReal_zero, zero_mul]
  · simp
end

section
open Finset
open scoped Classical
/-- The literal ordered memory with no particles. -/
def globalBirthEmptyMemory {P : Type*} {R : P → Type*} :
    FiniteOrderedTuple (Σ p, R p) := ⟨0, Fin.elim0⟩

/-- Empty memory and a ledger equal to the active labels are coherent. -/
theorem global_birth_empty_memory_coherent {P : Type*} [DecidableEq P]
    {R : P → Type*} (active : Finset P) :
    GlobalBirthMemoryCoherent active active (globalBirthEmptyMemory (R := R)) := by
  refine ⟨?_, ?_, ?_, Subset.rfl⟩
  · intro i
    exact Fin.elim0 i
  · intro p hp
    obtain ⟨j, _, _⟩ := mem_image.mp hp
    exact Fin.elim0 j
  · apply disjoint_left.mpr
    intro p hp _
    obtain ⟨j, _, _⟩ := mem_image.mp hp
    exact Fin.elim0 j

/-- Reading the empty initial memory gives active tags on the initial active
set and unborn tags everywhere else, with no completed or pending labels. -/
theorem global_birth_empty_memory_readout {P : Type*} [DecidableEq P]
    {R : P → Type*} (active : Finset P) :
    globalBirthMemoryReadout active active (globalBirthEmptyMemory (R := R)) =
      fun p => if p ∈ active then none else some none := by
  funext p
  rw [global_birth_memory_readout_off_labels active active _ p (by simp [globalBirthEmptyMemory])]
  by_cases hp : p ∈ active <;> simp [globalBirthMemoryBase, hp]

/-- Boolean-activity form of the usual initial phase snapshot. -/
theorem global_birth_initial_phase {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (a : P → Bool) :
    globalBirthMemoryReadout (ghostPhaseActivitySupport a) (ghostPhaseActivitySupport a)
        (globalBirthEmptyMemory (R := R)) =
      fun p => if a p then none else some none := by
  rw [global_birth_empty_memory_readout]
  funext p
  simp [ghostPhaseActivitySupport]

/-- On a valid phase tag the terminal test rejects exactly pending memory. -/
theorem ghost_phase_terminal_eq_pending_indicator {R : Type*}
    (a : Bool) (z : GhostPhaseState R) (hz : z.isSome = !a) :
    ghostPhaseTerminal a z = if ∃ r, z = some (some (some r)) then 0 else 1 := by
  classical
  cases a <;> rcases z with _ | (_ | (_ | r)) <;>
    simp_all [ghostPhaseTerminal, ghostFiniteTerminal]

/-- The actual tensor terminal test is one exactly when the literal coherent
ordered memory is empty. It imposes no requirement that the born ledger be empty. -/
theorem global_birth_coherent_terminal_tensor {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (a : P → Bool) (H : Finset P)
    (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent (ghostPhaseActivitySupport a) H q) :
    (∏ p, ghostPhaseTerminal (a p)
      (globalBirthMemoryReadout (ghostPhaseActivitySupport a) H q p)) =
      if q.1 = 0 then 1 else 0 := by
  classical
  have hm := global_birth_coherent_readout_mask a H q hq
  by_cases hn : q.1 = 0
  · rw [if_pos hn]
    apply prod_eq_one
    intro p _
    have hp : p ∉ ghostPhasePendingSupport
        (globalBirthMemoryReadout (ghostPhaseActivitySupport a) H q) := by
      rw [global_birth_coherent_readout_pending_support _ H q hq]
      intro hp
      obtain ⟨j, _, _⟩ := mem_image.mp hp
      exact Nat.not_lt_zero j.val (j.isLt.trans_eq hn)
    have hnp : ¬ ∃ r, globalBirthMemoryReadout (ghostPhaseActivitySupport a) H q p =
        some (some (some r)) := by
      simpa only [ghostPhasePendingSupport, mem_filter, mem_univ, true_and] using hp
    rw [ghost_phase_terminal_eq_pending_indicator _ _ (hm p), if_neg hnp]
  · rw [if_neg hn]
    let j : Fin q.1 := ⟨0, Nat.pos_of_ne_zero hn⟩
    apply prod_eq_zero (mem_univ (q.2 j).1)
    rw [global_birth_coherent_readout_particle _ H q hq j]
    cases a (q.2 j).1 <;> simp [ghostPhaseTerminal, ghostFiniteTerminal]

/-- Exact actual-history boundary identity, from the empty initial memory to
the empty-memory terminal indicator. The phase side uses the actual tensor
terminal test, and every intermediate step retains its own cutoff. -/
theorem global_birth_raw_history_empty_boundary {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    (a : Nat → P → Bool)
    (steps : ∀ i, GlobalBirthRawStep (R := R) (a i) (a (i + 1))) (n : Nat) :
    globalBirthRawHistory a steps n (fun _ q => if q.1 = 0 then 1 else 0)
      (ghostPhaseActivitySupport (a 0)) (globalBirthEmptyMemory (R := R)) =
      globalBirthPhaseHistory a steps n
        (fun z => ((∏ p, ghostPhaseTerminal (a n p) (z p) : ℝ) : ℂ))
        (fun p => if a 0 p then none else some none) := by
  have he := global_birth_raw_history_intertwines a steps n
    (fun _ q => if q.1 = 0 then (1 : ℂ) else 0)
    (fun z => ((∏ p, ghostPhaseTerminal (a n p) (z p) : ℝ) : ℂ))
    (by
      intro H q hq
      rw [global_birth_coherent_terminal_tensor (a n) H q hq]
      split_ifs <;> rfl)
    (ghostPhaseActivitySupport (a 0)) (globalBirthEmptyMemory (R := R))
    (global_birth_empty_memory_coherent _)
  rw [global_birth_initial_phase] at he
  exact he
end

section
open Finset
/-- Pull a test backwards across one kernel whose first state is the output. -/
noncomputable def finiteKernelPullback {X 𝕜 : Type*} [Fintype X] [Semiring 𝕜]
    (K : ℕ → X → X → 𝕜) (i : ℕ) (F : X → 𝕜) (w : X) : 𝕜 :=
  ∑ z, K i z w * F z

/-- Pairing an initial weight with chronological row composition is exactly
pairing the terminal test with forward kernel evolution. -/
theorem finite_row_composition_path_pairing {X 𝕜 : Type*}
    [Fintype X] [CommSemiring 𝕜]
    (K : ℕ → X → X → 𝕜) (initial F : X → 𝕜) (n : ℕ) :
    (∑ w, initial w *
      finiteRowComposition (S := fun _ => X) (finiteKernelPullback K) n F w) =
      ∑ z, F z * finitePathAction K initial n z := by
  induction n generalizing F with
  | zero => simp [finiteRowComposition, finitePathAction, mul_comm]
  | succ n ih =>
      rw [finite_row_composition_succ, ih]
      simp only [finiteKernelPullback, finitePathAction, sum_mul, mul_sum]
      rw [sum_comm]
      apply sum_congr rfl
      intro z _
      apply sum_congr rfl
      intro w _
      ac_rfl

/-- The same chronological composition is the sum of every complete state
trace, with both its initial weight and terminal test retained. -/
theorem finite_row_composition_trace_pairing {X 𝕜 : Type*}
    [Fintype X] [CommSemiring 𝕜]
    (K : ℕ → X → X → 𝕜) (initial F : X → 𝕜) (n : ℕ) :
    (∑ w, initial w *
      finiteRowComposition (S := fun _ => X) (finiteKernelPullback K) n F w) =
      ∑ x : Fin (n + 1) → X,
        F (x (Fin.last n)) * finiteChronologicalPrefix K initial n x := by
  rw [finite_row_composition_path_pairing]
  exact (finite_chronological_trace_expansion K initial F n).symm

/-- A fixed initial state is represented by its delta weight, with no
normalizing factor or state-space cardinality. -/
theorem finite_row_composition_path_at {X 𝕜 : Type*}
    [Fintype X] [DecidableEq X] [CommSemiring 𝕜]
    (K : ℕ → X → X → 𝕜) (F : X → 𝕜) (n : ℕ) (w : X) :
    finiteRowComposition (S := fun _ => X) (finiteKernelPullback K) n F w =
      ∑ z, F z * finitePathAction K (fun x => if x = w then 1 else 0) n z := by
  simpa only [ite_mul, one_mul, zero_mul, sum_ite_eq', mem_univ, if_true] using
    finite_row_composition_path_pairing K (fun x => if x = w then 1 else 0) F n

/-- Exact full-trace expansion at a fixed initial state. The delta at cut
zero forces the trace to start at that state. -/
theorem finite_row_composition_trace_at {X 𝕜 : Type*}
    [Fintype X] [DecidableEq X] [CommSemiring 𝕜]
    (K : ℕ → X → X → 𝕜) (F : X → 𝕜) (n : ℕ) (w : X) :
    finiteRowComposition (S := fun _ => X) (finiteKernelPullback K) n F w =
      ∑ x : Fin (n + 1) → X, F (x (Fin.last n)) *
        finiteChronologicalPrefix K (fun z => if z = w then 1 else 0) n x := by
  rw [finite_row_composition_path_at]
  exact (finite_chronological_trace_expansion K (fun z => if z = w then 1 else 0) F n).symm
end

section

open Finset
open scoped Classical

/-- The exact marginal of one auxiliary group under the physical product law. -/
theorem physical_auxiliary_group_marginal {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (g : G) (F : (C g → P g) → ℝ) :
    (∑ aux : PhysicalAuxLabels P C, physicalAuxMass V C aux * F (aux g)) =
      ∑ a : C g → P g, cleanAuxiliaryWeight (physicalLabelLaw V g) a * F a := by
  let factors (i : G) (a : C i → P i) : ℝ :=
    (∏ j, physicalLabelLaw V i (a j)) * (if h : i = g then F (h ▸ a) else 1)
  have hprod (aux : PhysicalAuxLabels P C) :
      physicalAuxMass V C aux * F (aux g) = ∏ i, factors i (aux i) := by
    simp only [factors, prod_mul_distrib, physicalAuxMass]
    congr 1
    rw [prod_eq_single g]
    · simp
    · intro i hi hig
      simp only [dif_neg hig]
    · simp
  simp_rw [hprod]
  rw [← Fintype.prod_sum factors, prod_eq_single g]
  · simp only [factors, ↓reduceDIte, cleanAuxiliaryWeight]
  · intro i hi hig
    simp only [factors, dif_neg hig, mul_one]
    rw [← Fintype.prod_sum (fun (_j : C i) (q : P i) => physicalLabelLaw V i q)]
    simp only [physical_label_law_sum V i (hV i) (hMass i), prod_const_one]
  · simp

theorem repeated_big_auxiliary_ban_failure_iff {G : Type*}
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (source target : RepeatedBigLists P J ell) (aux : PhysicalAuxLabels P C) :
    ¬(repeatedBigAuxAvoids C aux source ∧ repeatedBigAuxAvoids C aux target) ↔
      ∃ g, cleanAuxiliaryCollision (source g) (target g) (aux g) := by
  constructor
  · intro h
    by_contra hn
    apply h
    constructor
    · intro g j s he
      exact hn ⟨g, j, Or.inl ⟨s, he⟩⟩
    · intro g j s he
      exact hn ⟨g, j, Or.inr ⟨s, he⟩⟩
  · rintro ⟨g, j, ⟨s, hs⟩ | ⟨s, hs⟩⟩ ⟨h1, h2⟩
    · exact h1 g j s hs
    · exact h2 g j s hs

/-- A uniform collision estimate for both endpoints, with all group laws and
all auxiliary coordinates integrated exactly. Repeated labels are allowed. -/
theorem repeated_big_auxiliary_collision_mass_le {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (source target : RepeatedBigLists P J ell) {Pmin : ℝ} (hPmin : 0 < Pmin)
    (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ)) :
    (∑ aux : PhysicalAuxLabels P C, physicalAuxMass V C aux *
      (if ¬(repeatedBigAuxAvoids C aux source ∧ repeatedBigAuxAvoids C aux target) then 1 else 0)) ≤
      ∑ g, (C g).card * (2 * (J + ell : ℕ)) / (V g * Pmin) := by
  simp_rw [repeated_big_auxiliary_ban_failure_iff]
  calc
    _ ≤ ∑ g, ∑ aux : PhysicalAuxLabels P C, physicalAuxMass V C aux *
        (if cleanAuxiliaryCollision (source g) (target g) (aux g) then 1 else 0) :=
      clean_weighted_exists_le_sum _ (fun a => physical_aux_mass_nonneg V C (fun g => (hV g).le) a) _
    _ = ∑ g, ∑ a : C g → P g, cleanAuxiliaryWeight (physicalLabelLaw V g) a *
        (if cleanAuxiliaryCollision (source g) (target g) a then 1 else 0) := by
      apply sum_congr rfl
      intro g hg
      exact physical_auxiliary_group_marginal V C hV hMass g
        (fun a => if cleanAuxiliaryCollision (source g) (target g) a then 1 else 0)
    _ ≤ _ := by
      apply sum_le_sum
      intro g hg
      have h := clean_auxiliary_collision_mass_le (A := ↥(C g)) (physicalLabelLaw V g)
        (physical_label_law_nonneg V (fun g => (hV g).le) g)
        (physical_label_law_sum V g (hV g) (hMass g)) (source g) (target g)
        (1 / (V g * Pmin)) (fun p => physical_label_law_atom_le V g (hV g) hPmin p (hp g p))
      apply h.trans_eq
      simp only [PhysicalSlots, Fintype.card_coe, Fintype.card_sum, Fintype.card_fin, Nat.cast_add]
      ring
end

section

/-- The two half-open conventions differ by at most their two endpoint terms. -/
theorem reciprocal_prime_endpoint_difference_le {q : ℕ}
    (χ : DirichletCharacter ℂ q) {x y : ℝ} (hx : 0 < x) (hxy : x ≤ y) :
    ‖(∑ p ∈ (Finset.Ico ⌈x⌉₊ ⌈y⌉₊).filter Nat.Prime,
        (1 / (p : ℝ)) • χ (p : ZMod q)) -
      (∑ p ∈ (Finset.Ioc ⌊x⌋₊ ⌊y⌋₊).filter Nat.Prime,
        (1 / (p : ℝ)) • χ (p : ZMod q))‖ ≤ 2 / x := by
  classical
  let S := (Finset.Ico ⌈x⌉₊ ⌈y⌉₊).filter Nat.Prime
  let T := (Finset.Ioc ⌊x⌋₊ ⌊y⌋₊).filter Nat.Prime
  let f : ℕ → ℂ := fun p => (1 / (p : ℝ)) • χ (p : ZMod q)
  have hy : 0 ≤ y := hx.le.trans hxy
  have hS : ∀ p, p ∈ S ↔ p.Prime ∧ x ≤ (p : ℝ) ∧ (p : ℝ) < y := by
    intro p
    simp only [S, Finset.mem_filter, Finset.mem_Ico, Nat.ceil_le, Nat.lt_ceil]
    tauto
  have hT : ∀ p, p ∈ T ↔ p.Prime ∧ x < (p : ℝ) ∧ (p : ℝ) ≤ y := by
    intro p
    simp only [T, Finset.mem_filter, Finset.mem_Ioc, Nat.floor_lt hx.le, Nat.le_floor_iff hy]
    tauto
  have hleft : ∀ p ∈ S \ T, (p : ℝ) = x := by
    intro p hp
    obtain ⟨hpS, hpT⟩ := Finset.mem_sdiff.mp hp
    obtain ⟨hprime, hxp, hpy⟩ := (hS p).mp hpS
    apply le_antisymm _ hxp
    by_contra hpx
    exact hpT ((hT p).mpr ⟨hprime, lt_of_not_ge hpx, hpy.le⟩)
  have hright : ∀ p ∈ T \ S, (p : ℝ) = y := by
    intro p hp
    obtain ⟨hpT, hpS⟩ := Finset.mem_sdiff.mp hp
    obtain ⟨hprime, hxp, hpy⟩ := (hT p).mp hpT
    apply le_antisymm hpy
    by_contra hyp
    exact hpS ((hS p).mpr ⟨hprime, hxp.le, lt_of_not_ge hyp⟩)
  have hcardL : (S \ T).card ≤ 1 := Finset.card_le_one.mpr (by
    intro a ha b hb
    exact Nat.cast_injective ((hleft a ha).trans (hleft b hb).symm))
  have hcardR : (T \ S).card ≤ 1 := Finset.card_le_one.mpr (by
    intro a ha b hb
    exact Nat.cast_injective ((hright a ha).trans (hright b hb).symm))
  have hf : ∀ p : ℕ, x ≤ (p : ℝ) → ‖f p‖ ≤ 1 / x := by
    intro p hxp
    have hp : 0 < (p : ℝ) := hx.trans_le hxp
    dsimp only [f]
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (by positivity : 0 ≤ 1 / (p : ℝ))]
    calc
      _ ≤ (1 / (p : ℝ)) * 1 := mul_le_mul_of_nonneg_left (χ.norm_le_one _) (by positivity)
      _ = 1 / (p : ℝ) := mul_one _
      _ ≤ 1 / x := one_div_le_one_div_of_le hx hxp
  have hsum : ∀ U : Finset ℕ, U.card ≤ 1 → (∀ p ∈ U, x ≤ (p : ℝ)) →
      ‖∑ p ∈ U, f p‖ ≤ 1 / x := by
    intro U hc hu
    calc
      _ ≤ ∑ p ∈ U, ‖f p‖ := norm_sum_le _ _
      _ ≤ ∑ p ∈ U, (1 / x) := Finset.sum_le_sum (fun p hp => hf p (hu p hp))
      _ = (U.card : ℝ) * (1 / x) := by simp
      _ ≤ 1 * (1 / x) := mul_le_mul_of_nonneg_right (by exact_mod_cast hc) (by positivity)
      _ = 1 / x := one_mul _
  change ‖(∑ p ∈ S, f p) - ∑ p ∈ T, f p‖ ≤ 2 / x
  rw [← Finset.sum_sdiff_sub_sum_sdiff]
  calc
    _ ≤ ‖∑ p ∈ S \ T, f p‖ + ‖∑ p ∈ T \ S, f p‖ := norm_sub_le _ _
    _ ≤ 1 / x + 1 / x := add_le_add
      (hsum _ hcardL (fun p hp => (hleft p hp).ge))
      (hsum _ hcardR (fun p hp => hxy.trans (hright p hp).ge))
    _ = 2 / x := by ring

/-- The endpoint correction is smaller than the same lower-endpoint profile. -/
theorem reciprocal_prime_endpoint_error_absorbed {q x : ℝ}
    (hq : 1 ≤ q) (hx : 2 ≤ x) :
    2 / x ≤ 2 * x ^ (-(1 : ℝ) / 32) * (1 + Real.log q / Real.log x) := by
  have hx1 : 1 ≤ x := by linarith
  have hp : 1 / x ≤ x ^ (-(1 : ℝ) / 32) := by
    simpa only [Real.rpow_neg_one, one_div] using
      (Real.rpow_le_rpow_of_exponent_le hx1 (by norm_num : (-1 : ℝ) ≤ -(1 : ℝ) / 32))
  have hlq : 0 ≤ Real.log q := Real.log_nonneg hq
  have hlx : 0 ≤ Real.log x := Real.log_nonneg hx1
  have hratio : 1 ≤ 1 + Real.log q / Real.log x := le_add_of_nonneg_right (div_nonneg hlq hlx)
  have hpow : 0 ≤ x ^ (-(1 : ℝ) / 32) := Real.rpow_nonneg (by linarith) _
  have hh := mul_le_mul_of_nonneg_left hratio hpow
  have he : 2 / x = 2 * (1 / x) := by ring
  rw [he]
  nlinarith

/-- The same uniform power-saving estimate for the real convention `[x,y)`. -/
theorem reciprocal_prime_closed_open_bound_of_zero_free
    (hZ : PrimitiveZeroFreeHalfPlane) :
    ∃ C : ℝ, 0 < C ∧ ∀ (q : ℕ), 0 < q →
      ∀ χ : DirichletCharacter ℂ q, χ ≠ 1 →
        ∀ x y : ℝ, 2 ≤ x → x ≤ y →
          ‖∑ p ∈ (Finset.Ico ⌈x⌉₊ ⌈y⌉₊).filter Nat.Prime,
            (1 / (p : ℝ)) • χ (p : ZMod q)‖ ≤
            C * x ^ (-(1 : ℝ) / 32) * (1 + Real.log q / Real.log x) := by
  obtain ⟨C, hC, hbound⟩ := reciprocal_prime_interval_bound_of_zero_free hZ
  refine ⟨C + 2, by positivity, ?_⟩
  intro q hq χ hχ x y hx hxy
  have hb := hbound q hq χ hχ x y hx hxy
  have he := (reciprocal_prime_endpoint_difference_le χ (by linarith : 0 < x) hxy).trans
    (reciprocal_prime_endpoint_error_absorbed (q := (q : ℝ)) (by exact_mod_cast hq) hx)
  have hh := norm_le_norm_sub_add
    (∑ p ∈ (Finset.Ico ⌈x⌉₊ ⌈y⌉₊).filter Nat.Prime, (1 / (p : ℝ)) • χ (p : ZMod q))
    (∑ p ∈ (Finset.Ioc ⌊x⌋₊ ⌊y⌋₊).filter Nat.Prime, (1 / (p : ℝ)) • χ (p : ZMod q))
  nlinarith
end

section

theorem primitive_changeLevel_eq_implies_sigma_eq {q r m : ℕ} [NeZero m]
    (χ : DirichletCharacter ℂ q) (ψ : DirichletCharacter ℂ r)
    (hχ : χ.IsPrimitive) (hψ : ψ.IsPrimitive) (hq : q ∣ m) (hr : r ∣ m)
    (he : χ.changeLevel hq = ψ.changeLevel hr) :
    (⟨q, χ⟩ : (n : ℕ) × DirichletCharacter ℂ n) = ⟨r, ψ⟩ := by
  have hqr : q = r := by
    have hc := congrArg DirichletCharacter.conductor he
    rw [DirichletCharacter.conductor_changeLevel, DirichletCharacter.conductor_changeLevel,
      hχ, hψ] at hc
    exact hc
  subst r
  have he' : χ = ψ := DirichletCharacter.changeLevel_injective hq he
  subst ψ
  rfl

theorem primitive_changeLevel_star_mul_ne_one {q r m : ℕ} [NeZero m]
    (χ : DirichletCharacter ℂ q) (ψ : DirichletCharacter ℂ r)
    (hχ : χ.IsPrimitive) (hψ : ψ.IsPrimitive) (hq : q ∣ m) (hr : r ∣ m)
    (hne : (⟨q, χ⟩ : (n : ℕ) × DirichletCharacter ℂ n) ≠ ⟨r, ψ⟩) :
    star (χ.changeLevel hq) * ψ.changeLevel hr ≠ 1 := by
  intro he
  rw [MulChar.star_eq_inv] at he
  apply hne
  apply primitive_changeLevel_eq_implies_sigma_eq χ ψ hχ hψ hq hr
  exact inv_mul_eq_one.mp he

theorem primitive_changeLevel_mul_star_ne_one {q r m : ℕ} [NeZero m]
    (χ : DirichletCharacter ℂ q) (ψ : DirichletCharacter ℂ r)
    (hχ : χ.IsPrimitive) (hψ : ψ.IsPrimitive) (hq : q ∣ m) (hr : r ∣ m)
    (hne : (⟨q, χ⟩ : (n : ℕ) × DirichletCharacter ℂ n) ≠ ⟨r, ψ⟩) :
    χ.changeLevel hq * star (ψ.changeLevel hr) ≠ 1 := by
  intro he
  rw [MulChar.star_eq_inv] at he
  apply hne
  apply primitive_changeLevel_eq_implies_sigma_eq χ ψ hχ hψ hq hr
  exact mul_inv_eq_one.mp he

theorem primitive_complex_character_eq_of_changeLevel_eq
    (χ ψ : OAI.Ostmann.PrimitiveComplexCharacter) {m : ℕ} [NeZero m]
    (hq : χ.modulus ∣ m) (hr : ψ.modulus ∣ m)
    (he : χ.character.changeLevel hq = ψ.character.changeLevel hr) : χ = ψ := by
  cases χ with
  | mk q hq0 χ hχ hnχ =>
    cases ψ with
    | mk r hr0 ψ hψ hnψ =>
      dsimp at hq hr he
      have hs := primitive_changeLevel_eq_implies_sigma_eq χ ψ hχ hψ hq hr he
      have hqr : q = r := congrArg Sigma.fst hs
      subst r
      have he' : χ = ψ := DirichletCharacter.changeLevel_injective hq he
      subst ψ
      rfl

theorem primitive_complex_character_star_mul_ne_one
    (χ ψ : OAI.Ostmann.PrimitiveComplexCharacter) (hne : χ ≠ ψ)
    {m : ℕ} [NeZero m] (hq : χ.modulus ∣ m) (hr : ψ.modulus ∣ m) :
    star (χ.character.changeLevel hq) * ψ.character.changeLevel hr ≠ 1 := by
  intro he
  rw [MulChar.star_eq_inv] at he
  exact hne (primitive_complex_character_eq_of_changeLevel_eq χ ψ hq hr
    (inv_mul_eq_one.mp he))

theorem primitive_complex_character_mul_star_ne_one
    (χ ψ : OAI.Ostmann.PrimitiveComplexCharacter) (hne : χ ≠ ψ)
    {m : ℕ} [NeZero m] (hq : χ.modulus ∣ m) (hr : ψ.modulus ∣ m) :
    χ.character.changeLevel hq * star (ψ.character.changeLevel hr) ≠ 1 := by
  intro he
  rw [MulChar.star_eq_inv] at he
  exact hne (primitive_complex_character_eq_of_changeLevel_eq χ ψ hq hr
    (mul_inv_eq_one.mp he))

theorem primitive_product_level_star_mul_ne_one {q r : ℕ}
    (χ : DirichletCharacter ℂ q) (ψ : DirichletCharacter ℂ r)
    (hq : 0 < q) (hr : 0 < r) (hχ : χ.IsPrimitive) (hψ : ψ.IsPrimitive)
    (hne : (⟨q, χ⟩ : (n : ℕ) × DirichletCharacter ℂ n) ≠ ⟨r, ψ⟩) :
    star (χ.changeLevel (Nat.dvd_mul_right q r)) *
      ψ.changeLevel (Nat.dvd_mul_left r q) ≠ 1 := by
  let : NeZero (q * r) := ⟨Nat.mul_ne_zero hq.ne' hr.ne'⟩
  exact primitive_changeLevel_star_mul_ne_one χ ψ hχ hψ _ _ hne

theorem primitive_product_level_mul_star_ne_one {q r : ℕ}
    (χ : DirichletCharacter ℂ q) (ψ : DirichletCharacter ℂ r)
    (hq : 0 < q) (hr : 0 < r) (hχ : χ.IsPrimitive) (hψ : ψ.IsPrimitive)
    (hne : (⟨q, χ⟩ : (n : ℕ) × DirichletCharacter ℂ n) ≠ ⟨r, ψ⟩) :
    χ.changeLevel (Nat.dvd_mul_right q r) *
      star (ψ.changeLevel (Nat.dvd_mul_left r q)) ≠ 1 := by
  let : NeZero (q * r) := ⟨Nat.mul_ne_zero hq.ne' hr.ne'⟩
  exact primitive_changeLevel_mul_star_ne_one χ ψ hχ hψ _ _ hne

/-- Evaluation commutes with the product lift even at integers not coprime to
either modulus: the corresponding original character factor is already zero. -/
theorem product_level_mul_star_int_apply {q r : ℕ}
    (χ : DirichletCharacter ℂ q) (ψ : DirichletCharacter ℂ r) (a : ℤ) :
    (χ.changeLevel (Nat.dvd_mul_right q r) *
      star (ψ.changeLevel (Nat.dvd_mul_left r q))) (a : ZMod (q * r)) =
      χ (a : ZMod q) * star (ψ (a : ZMod r)) := by
  rw [MulChar.mul_apply, MulChar.star_apply]
  by_cases ha : IsCoprime a ((q * r : ℕ) : ℤ)
  · rw [DirichletCharacter.changeLevel_eq_cast_of_dvd' χ _ ha,
      DirichletCharacter.changeLevel_eq_cast_of_dvd' ψ _ ha]
  · have hz := (χ.changeLevel (Nat.dvd_mul_right q r)).apply_eq_zero_iff a |>.mpr ha
    rw [hz, zero_mul]
    have hh : ¬ (IsCoprime a (q : ℤ) ∧ IsCoprime a (r : ℤ)) := by
      simpa only [Nat.cast_mul, IsCoprime.mul_right_iff] using ha
    rcases not_and_or.mp hh with hqa | hra
    · rw [(χ.apply_eq_zero_iff a).mpr hqa, zero_mul]
    · rw [(ψ.apply_eq_zero_iff a).mpr hra, star_zero, mul_zero]

theorem product_level_star_mul_int_apply {q r : ℕ}
    (χ : DirichletCharacter ℂ q) (ψ : DirichletCharacter ℂ r) (a : ℤ) :
    (star (χ.changeLevel (Nat.dvd_mul_right q r)) *
      ψ.changeLevel (Nat.dvd_mul_left r q)) (a : ZMod (q * r)) =
      star (χ (a : ZMod q)) * ψ (a : ZMod r) := by
  rw [MulChar.mul_apply, MulChar.star_apply]
  by_cases ha : IsCoprime a ((q * r : ℕ) : ℤ)
  · rw [DirichletCharacter.changeLevel_eq_cast_of_dvd' χ _ ha,
      DirichletCharacter.changeLevel_eq_cast_of_dvd' ψ _ ha]
  · have hz := (χ.changeLevel (Nat.dvd_mul_right q r)).apply_eq_zero_iff a |>.mpr ha
    rw [hz, star_zero, zero_mul]
    have hh : ¬ (IsCoprime a (q : ℤ) ∧ IsCoprime a (r : ℤ)) := by
      simpa only [Nat.cast_mul, IsCoprime.mul_right_iff] using ha
    rcases not_and_or.mp hh with hqa | hra
    · rw [(χ.apply_eq_zero_iff a).mpr hqa, star_zero, zero_mul]
    · rw [(ψ.apply_eq_zero_iff a).mpr hra, mul_zero]

theorem product_level_mul_star_nat_apply {q r : ℕ}
    (χ : DirichletCharacter ℂ q) (ψ : DirichletCharacter ℂ r) (a : ℕ) :
    (χ.changeLevel (Nat.dvd_mul_right q r) *
      star (ψ.changeLevel (Nat.dvd_mul_left r q))) (a : ZMod (q * r)) =
      χ (a : ZMod q) * star (ψ (a : ZMod r)) := by
  simpa only [Int.cast_natCast] using product_level_mul_star_int_apply χ ψ (a : ℤ)

theorem product_level_star_mul_nat_apply {q r : ℕ}
    (χ : DirichletCharacter ℂ q) (ψ : DirichletCharacter ℂ r) (a : ℕ) :
    (star (χ.changeLevel (Nat.dvd_mul_right q r)) *
      ψ.changeLevel (Nat.dvd_mul_left r q)) (a : ZMod (q * r)) =
      star (χ (a : ZMod q)) * ψ (a : ZMod r) := by
  simpa only [Int.cast_natCast] using product_level_star_mul_int_apply χ ψ (a : ℤ)
end

section
open Finset Classical
noncomputable def complexNormEnvelope {X : Type*} (f : X → ℂ) : X → ℂ :=
  fun x => (‖f x‖ : ℂ)

theorem complexNormEnvelope_norm {X : Type*} (f : X → ℂ) (x : X) :
    ‖complexNormEnvelope f x‖ = ‖f x‖ := by
  simp [complexNormEnvelope]

theorem complexNormEnvelope_energy {X : Type*} [Fintype X] (μ : X → ℝ) (f : X → ℂ) :
    finiteWeightedEnergy μ (complexNormEnvelope f) = finiteWeightedEnergy μ f := by
  unfold finiteWeightedEnergy
  simp only [complexNormEnvelope_norm]

theorem complexNormEnvelope_memory_symmetric {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (f : ProductBoundedOrderedState P Z t B → ℂ) (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric (complexNormEnvelope f) := by
  intro x g τ
  unfold complexNormEnvelope
  rw [hf x g τ]

theorem finiteWeightedEnergy_le_of_norm_le {X : Type*} [Fintype X]
    (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (f g : X → ℂ)
    (h : ∀ x, ‖f x‖ ≤ ‖g x‖) : finiteWeightedEnergy μ f ≤ finiteWeightedEnergy μ g := by
  apply sum_le_sum
  intro x _
  exact mul_le_mul_of_nonneg_left
    ((sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mpr (h x)) (hμ x)

/-- A globally coupled action may be estimated by a positive product action
on the norm envelope; no factorization of its phase is assumed. -/
theorem finiteWeightedEnergy_le_of_envelope_domination {X : Type*} [Fintype X]
    (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (f output : X → ℂ)
    (positive : (X → ℂ) → X → ℂ) (C : ℝ)
    (hdom : ∀ x, ‖output x‖ ≤ ‖positive (complexNormEnvelope f) x‖)
    (hbound : finiteWeightedEnergy μ (positive (complexNormEnvelope f)) ≤
      C * finiteWeightedEnergy μ (complexNormEnvelope f)) :
    finiteWeightedEnergy μ output ≤ C * finiteWeightedEnergy μ f := by
  calc
    _ ≤ finiteWeightedEnergy μ (positive (complexNormEnvelope f)) :=
      finiteWeightedEnergy_le_of_norm_le μ hμ output _ hdom
    _ ≤ C * finiteWeightedEnergy μ (complexNormEnvelope f) := hbound
    _ = _ := by rw [complexNormEnvelope_energy]
end

section
open Finset Classical
abbrev UnrestrictedBoundedEvent {P : Type*} (n : P → ℕ) (Δ D : ℤ) (t B : ℕ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B) :=
  Σ _stores : Finset (Fin t), Σ promotions : Finset (Fin t),
    (promotions ↪ ↥(unrestrictedResidueEligible n Δ D s.2.2)) ×
      UnrestrictedFreshLabels P promotions

noncomputable def unrestrictedBoundedEventTarget {P : Type*} (n : P → ℕ) (Δ D : ℤ)
    (t B : ℕ) (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (e : UnrestrictedBoundedEvent n Δ D t B s) :
    BoundedOrderedState P (UnrestrictedResidueParticle n) t B :=
  let q := unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
    (unrestrictedResidueTransport n Δ) e.1 e.2.1 e.2.2.1
  if h : q.1 ≤ B then
    (unrestrictedEdgeTarget s.2.2 Sigma.fst e.2.1 e.2.2.1 e.2.2.2,
      ⟨⟨q.1, Nat.lt_succ_of_le h⟩, q.2⟩)
  else s

noncomputable def unrestrictedBoundedEventWeight {P : Type*} (n : P → ℕ) (Δ D : ℤ)
    (μ : P → ℝ) (ρ V : ℝ) (t B : ℕ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (e : UnrestrictedBoundedEvent n Δ D t B s) : ℝ :=
  if unrestrictedResidueStorageAllowed n D s.1 e.1 ∧
      (unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
        (unrestrictedResidueTransport n Δ) e.1 e.2.1 e.2.2.1).1 ≤ B then
    unrestrictedEdgeEventMass s.1 s.2.2 (unrestrictedResidueSeed n)
      (unrestrictedResidueTransport n Δ) unrestrictedResidueHit μ ρ V
      e.1 e.2.1 e.2.2.1 e.2.2.2
  else 0

theorem unrestrictedBoundedEventWeight_nonneg {P : Type*} (n : P → ℕ) (Δ D : ℤ)
    (μ : P → ℝ) {ρ V : ℝ} (hρ : 0 ≤ ρ) (hV : 0 ≤ V) (hμ : ∀ p, 0 ≤ μ p)
    (t B : ℕ) (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (e : UnrestrictedBoundedEvent n Δ D t B s) :
    0 ≤ unrestrictedBoundedEventWeight n Δ D μ ρ V t B s e := by
  unfold unrestrictedBoundedEventWeight
  split_ifs
  · exact unrestrictedEdgeEventMass_nonneg _ _ _ _ _ μ hρ hV hμ _ _ _ _
  · exact le_rfl

theorem unrestricted_bounded_operator_eq_event_sum {P : Type*} [Fintype P]
    (n : P → ℕ) (Δ D : ℤ) (μ : P → ℝ) (ρ V : ℝ) (t B : ℕ)
    (phase : UnrestrictedBoundedPhase n Δ D t B)
    (f : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B) :
    unrestrictedBoundedOperator n Δ D μ ρ V t B phase f s =
    ∑ e : UnrestrictedBoundedEvent n Δ D t B s,
      (unrestrictedBoundedEventWeight n Δ D μ ρ V t B s e : ℂ) *
        phase s e.1 e.2.1 e.2.2.1 e.2.2.2 *
          f (unrestrictedBoundedEventTarget n Δ D t B s e) := by
  unfold unrestrictedBoundedOperator unrestrictedBoundedAction unrestrictedResidueEdgeAction
    unrestrictedEdgeAction
  rw [Fintype.sum_sigma]
  apply sum_congr rfl
  intro stores _
  rw [Fintype.sum_sigma]
  apply sum_congr rfl
  intro promotions _
  rw [Fintype.sum_prod_type]
  apply sum_congr rfl
  intro e _
  apply sum_congr rfl
  intro fresh _
  by_cases hs : unrestrictedResidueStorageAllowed n D s.1 stores
  · by_cases hq : (unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
        (unrestrictedResidueTransport n Δ) stores promotions e).1 ≤ B
    · simp [unrestrictedBoundedEventWeight, unrestrictedBoundedEventTarget, hs, hq,
        boundedOrderedZeroExtension]
    · simp [unrestrictedBoundedEventWeight, unrestrictedBoundedEventTarget, hs, hq]
  · simp [unrestrictedBoundedEventWeight, hs]
end

section
open Finset Classical
noncomputable def finiteLocalEventAction {I : Type*} {X : I → Type*}
    (E : ∀ i, X i → Type*) [∀ i x, Fintype (E i x)]
    (weight : ∀ i x, E i x → ℝ) (target : ∀ i x, E i x → X i)
    (i : I) (f : X i → ℂ) (x : X i) : ℂ :=
  ∑ e : E i x, (weight i x e : ℂ) * f (target i x e)

noncomputable def finiteProductEventAction {I : Type*} [Fintype I]
    {X : I → Type*} (E : ∀ i, X i → Type*) [∀ i x, Fintype (E i x)]
    (weight : ∀ i x, E i x → ℝ) (target : ∀ i x, E i x → X i)
    (phase : ∀ x : (∀ i, X i), (∀ i, E i (x i)) → ℂ)
    (f : (∀ i, X i) → ℂ) (x : ∀ i, X i) : ℂ :=
  ∑ e : (∀ i, E i (x i)), ((∏ i, weight i (x i) (e i) : ℝ) : ℂ) *
    phase x e * f (fun i => target i (x i) (e i))

noncomputable def finiteProductEventPositive {I : Type*} [Fintype I]
    {X : I → Type*} (E : ∀ i, X i → Type*) [∀ i x, Fintype (E i x)]
    (weight : ∀ i x, E i x → ℝ) (target : ∀ i x, E i x → X i)
    (f : (∀ i, X i) → ℝ) (x : ∀ i, X i) : ℝ :=
  ∑ e : (∀ i, E i (x i)), (∏ i, weight i (x i) (e i)) *
    f (fun i => target i (x i) (e i))

theorem finite_product_event_positive_cast {I : Type*} [Fintype I]
    {X : I → Type*} (E : ∀ i, X i → Type*) [∀ i x, Fintype (E i x)]
    (weight : ∀ i x, E i x → ℝ) (target : ∀ i x, E i x → X i)
    (f : (∀ i, X i) → ℝ) (x : ∀ i, X i) :
    (finiteProductEventPositive E weight target f x : ℂ) =
      finiteProductEventAction E weight target (fun _ _ => 1) (fun y => (f y : ℂ)) x := by
  simp only [finiteProductEventPositive, finiteProductEventAction,
    Complex.ofReal_sum, Complex.ofReal_mul, mul_one]

/-- A globally coupled phase is dominated by the simultaneous positive event
operator. No product decomposition of the phase is assumed. -/
theorem finite_product_event_norm_le {I : Type*} [Fintype I]
    {X : I → Type*} (E : ∀ i, X i → Type*) [∀ i x, Fintype (E i x)]
    (weight : ∀ i x, E i x → ℝ) (target : ∀ i x, E i x → X i)
    (hweight : ∀ i x e, 0 ≤ weight i x e)
    (phase : ∀ x : (∀ i, X i), (∀ i, E i (x i)) → ℂ)
    (hphase : ∀ x e, ‖phase x e‖ ≤ 1) (f : (∀ i, X i) → ℂ) (x : ∀ i, X i) :
    ‖finiteProductEventAction E weight target phase f x‖ ≤
      finiteProductEventPositive E weight target (fun y => ‖f y‖) x := by
  unfold finiteProductEventAction finiteProductEventPositive
  refine (norm_sum_le _ _).trans (sum_le_sum fun e _ => ?_)
  have hw : 0 ≤ ∏ i, weight i (x i) (e i) := prod_nonneg fun i _ => hweight i _ _
  rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hw]
  calc
    _ ≤ ((∏ i, weight i (x i) (e i)) * 1) * ‖f (fun i => target i (x i) (e i))‖ :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (hphase x e) hw) (norm_nonneg _)
    _ = _ := by rw [mul_one]

theorem finite_product_event_norm_le_positive_re {I : Type*} [Fintype I]
    {X : I → Type*} (E : ∀ i, X i → Type*) [∀ i x, Fintype (E i x)]
    (weight : ∀ i x, E i x → ℝ) (target : ∀ i x, E i x → X i)
    (hweight : ∀ i x e, 0 ≤ weight i x e)
    (phase : ∀ x : (∀ i, X i), (∀ i, E i (x i)) → ℂ)
    (hphase : ∀ x e, ‖phase x e‖ ≤ 1) (f : (∀ i, X i) → ℂ) (x : ∀ i, X i) :
    ‖finiteProductEventAction E weight target phase f x‖ ≤
      (finiteProductEventAction E weight target (fun _ _ => 1)
        (fun y => (‖f y‖ : ℂ)) x).re := by
  rw [← finite_product_event_positive_cast, Complex.ofReal_re]
  exact finite_product_event_norm_le E weight target hweight phase hphase f x
end

section
open Finset Classical
theorem product_symmetric_finset_energy_le {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    {t : G → ℕ} {B : ℕ} (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hν : ∀ g z, 0 ≤ ν g z)
    (A : ∀ g, (BoundedOrderedState (P g) (Z g) (t g) B → ℂ) →
      BoundedOrderedState (P g) (Z g) (t g) B → ℂ)
    (C : G → ℝ) (hC : ∀ g, 0 ≤ C g)
    (hA : ∀ g f, BoundedOrderedSymmetric f →
      finiteWeightedEnergy (boundedOrderedStateWeight (μ g) (ν g)) (A g f) ≤
        C g * finiteWeightedEnergy (boundedOrderedStateWeight (μ g) (ν g)) f)
    (groups : Finset G) (f : ProductBoundedOrderedState P Z t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    (∑ x : ProductBoundedOrderedState P Z t B,
      productMemoryWeight μ ν x * ‖finiteCoordinateFinsetAction A groups f x‖ ^ 2) ≤
      (∏ g ∈ groups, C g) *
        ∑ x : ProductBoundedOrderedState P Z t B, productMemoryWeight μ ν x * ‖f x‖ ^ 2 := by
  have hprojected (g : G) (q : BoundedOrderedState (P g) (Z g) (t g) B → ℂ) :
      finiteWeightedEnergy (boundedOrderedStateWeight (μ g) (ν g))
          (A g (boundedMemorySymmetrize q)) ≤
        C g * finiteWeightedEnergy (boundedOrderedStateWeight (μ g) (ν g)) q :=
    boundedMemorySymmetrize_transfer_energy_le (μ g) (ν g) (hμ g) (hν g) (hC g)
      (A g) (hA g) q
  have h := finite_coordinate_finset_energy_le
    (fun g => boundedOrderedStateWeight (μ g) (ν g))
    (fun g x => boundedOrderedStateWeight_nonneg (μ g) (ν g) (hμ g) (hν g) x)
    (fun g q => A g (boundedMemorySymmetrize q)) C hC hprojected groups f
  rw [product_memory_projected_finset_eq A groups f hf] at h
  exact h

theorem product_symmetric_cutoff_sandwich_energy_le
    {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    {t : G → ℕ} {B : ℕ} (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hν : ∀ g z, 0 ≤ ν g z)
    (A : ∀ g, (BoundedOrderedState (P g) (Z g) (t g) B → ℂ) →
      BoundedOrderedState (P g) (Z g) (t g) B → ℂ)
    (C : G → ℝ) (hC : ∀ g, 0 ≤ C g)
    (hA : ∀ g f, BoundedOrderedSymmetric f →
      finiteWeightedEnergy (boundedOrderedStateWeight (μ g) (ν g)) (A g f) ≤
        C g * finiteWeightedEnergy (boundedOrderedStateWeight (μ g) (ν g)) f)
    (groups : Finset G) (f : ProductBoundedOrderedState P Z t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    (∑ x : ProductBoundedOrderedState P Z t B,
      productMemoryWeight μ ν x *
        ‖productMemoryCutoff (finiteCoordinateFinsetAction A groups (productMemoryCutoff f)) x‖ ^ 2) ≤
      (∏ g ∈ groups, C g) *
        ∑ x : ProductBoundedOrderedState P Z t B, productMemoryWeight μ ν x * ‖f x‖ ^ 2 := by
  calc
    _ ≤ ∑ x : ProductBoundedOrderedState P Z t B, productMemoryWeight μ ν x *
        ‖finiteCoordinateFinsetAction A groups (productMemoryCutoff f) x‖ ^ 2 :=
      productMemoryCutoff_energy_le μ ν hμ hν _
    _ ≤ (∏ g ∈ groups, C g) *
        ∑ x : ProductBoundedOrderedState P Z t B,
          productMemoryWeight μ ν x * ‖productMemoryCutoff f x‖ ^ 2 :=
      product_symmetric_finset_energy_le μ ν hμ hν A C hC hA groups
        (productMemoryCutoff f) (productMemoryCutoff_symmetric f hf)
    _ ≤ _ := mul_le_mul_of_nonneg_left (productMemoryCutoff_energy_le μ ν hμ hν f)
      (prod_nonneg fun g _ => hC g)
end

section
open Finset Classical
theorem finite_coordinate_lift_preserves_own {I : Type*} [DecidableEq I]
    {X : I → Type*} (i : I) (R : X i → X i → Prop)
    (A : (X i → ℂ) → X i → ℂ)
    (hA : ∀ q, FiniteLocalInvariant R q → FiniteLocalInvariant R (A q))
    (f : (∀ j, X j) → ℂ) (hf : FiniteCoordinateInvariant i R f) :
    FiniteCoordinateInvariant i R (finiteCoordinateLift i A f) := by
  intro x y hxy
  simp only [finite_coordinate_lift_eq_update, Function.update_self, Function.update_idem]
  exact hA _ (finite_coordinate_invariant_slice i R f hf x) (x i) y hxy

theorem finite_coordinate_lift_preserves_all {I : Type*} [DecidableEq I]
    {X : I → Type*} (R : ∀ i, X i → X i → Prop) (j : I)
    (A : (X j → ℂ) → X j → ℂ)
    (hA : ∀ q, FiniteLocalInvariant (R j) q → FiniteLocalInvariant (R j) (A q))
    (f : (∀ i, X i) → ℂ) (hf : ∀ i, FiniteCoordinateInvariant i (R i) f) :
    ∀ i, FiniteCoordinateInvariant i (R i) (finiteCoordinateLift j A f) := by
  intro i
  by_cases hij : i = j
  · subst i
    exact finite_coordinate_lift_preserves_own j (R j) A hA f (hf j)
  · exact finite_coordinate_lift_preserves_other i j hij (R i) A f (hf i)

theorem finite_coordinate_compose_preserves_all {I : Type*} [DecidableEq I]
    {X : I → Type*} (R : ∀ i, X i → X i → Prop)
    (A : ∀ i, (X i → ℂ) → X i → ℂ)
    (hA : ∀ i q, FiniteLocalInvariant (R i) q → FiniteLocalInvariant (R i) (A i q))
    (is : List I) (f : (∀ i, X i) → ℂ) (hf : ∀ i, FiniteCoordinateInvariant i (R i) f) :
    ∀ i, FiniteCoordinateInvariant i (R i) (finiteCoordinateCompose A is f) := by
  induction is with
  | nil => exact hf
  | cons j js ih =>
    exact finite_coordinate_lift_preserves_all R j (A j) (hA j)
      (finiteCoordinateCompose A js f) ih

theorem product_memory_compose_symmetric {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (A : ∀ g, (BoundedOrderedState (P g) (Z g) (t g) B → ℂ) →
      BoundedOrderedState (P g) (Z g) (t g) B → ℂ)
    (hA : ∀ g q, BoundedOrderedSymmetric q → BoundedOrderedSymmetric (A g q))
    (is : List G) (f : ProductBoundedOrderedState P Z t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric (finiteCoordinateCompose A is f) := by
  apply (product_memory_symmetric_iff_coordinate _).mpr
  apply finite_coordinate_compose_preserves_all
    (fun g => BoundedMemoryPermutationRelation (P := P g) (Z := Z g) (t := t g) (B := B)) A
  · intro g q hq
    exact (finite_local_memory_invariant_iff _).mpr
      (hA g q ((finite_local_memory_invariant_iff q).mp hq))
  · exact (product_memory_symmetric_iff_coordinate f).mp hf

theorem product_memory_finset_symmetric {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (A : ∀ g, (BoundedOrderedState (P g) (Z g) (t g) B → ℂ) →
      BoundedOrderedState (P g) (Z g) (t g) B → ℂ)
    (hA : ∀ g q, BoundedOrderedSymmetric q → BoundedOrderedSymmetric (A g q))
    (groups : Finset G) (f : ProductBoundedOrderedState P Z t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric (finiteCoordinateFinsetAction A groups f) :=
  product_memory_compose_symmetric A hA groups.toList f hf

theorem product_memory_cutoff_sandwich_symmetric
    {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (A : ∀ g, (BoundedOrderedState (P g) (Z g) (t g) B → ℂ) →
      BoundedOrderedState (P g) (Z g) (t g) B → ℂ)
    (hA : ∀ g q, BoundedOrderedSymmetric q → BoundedOrderedSymmetric (A g q))
    (groups : Finset G) (f : ProductBoundedOrderedState P Z t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric
      (productMemoryCutoff (finiteCoordinateFinsetAction A groups (productMemoryCutoff f))) :=
  productMemoryCutoff_symmetric _ (product_memory_finset_symmetric A hA groups
    (productMemoryCutoff f) (productMemoryCutoff_symmetric f hf))
end

section

noncomputable def finiteOperatorListAction {E X : Type*}
    (A : E → (X → ℂ) → X → ℂ) : List E → (X → ℂ) → X → ℂ
  | [], f => f
  | e :: es, f => A e (finiteOperatorListAction A es f)

theorem finite_operator_list_preserves {E X : Type*}
    (S : (X → ℂ) → Prop) (A : E → (X → ℂ) → X → ℂ)
    (hA : ∀ e f, S f → S (A e f)) (es : List E) (f : X → ℂ) (hf : S f) :
    S (finiteOperatorListAction A es f) := by
  induction es with
  | nil => exact hf
  | cons e es ih => exact hA e _ ih

theorem finite_operator_list_energy_le {E X : Type*} [Fintype X]
    (μ : X → ℝ) (S : (X → ℂ) → Prop) (A : E → (X → ℂ) → X → ℂ)
    (hS : ∀ e f, S f → S (A e f)) (C : E → ℝ) (hC : ∀ e, 0 ≤ C e)
    (hA : ∀ e f, S f → finiteWeightedEnergy μ (A e f) ≤ C e * finiteWeightedEnergy μ f)
    (es : List E) (f : X → ℂ) (hf : S f) :
    finiteWeightedEnergy μ (finiteOperatorListAction A es f) ≤
      (es.map C).prod * finiteWeightedEnergy μ f := by
  induction es with
  | nil => simp [finiteOperatorListAction]
  | cons e es ih =>
    calc
      _ ≤ C e * finiteWeightedEnergy μ (finiteOperatorListAction A es f) :=
        hA e _ (finite_operator_list_preserves S A hS es f hf)
      _ ≤ C e * ((es.map C).prod * finiteWeightedEnergy μ f) :=
        mul_le_mul_of_nonneg_left ih (hC e)
      _ = _ := by simp only [List.map_cons, List.prod_cons, mul_assoc]

theorem finite_operator_list_uniform_energy_le {E X : Type*} [Fintype X]
    (μ : X → ℝ) (S : (X → ℂ) → Prop) (A : E → (X → ℂ) → X → ℂ)
    (hS : ∀ e f, S f → S (A e f)) {C : ℝ} (hC : 0 ≤ C)
    (hA : ∀ e f, S f → finiteWeightedEnergy μ (A e f) ≤ C * finiteWeightedEnergy μ f)
    (es : List E) (f : X → ℂ) (hf : S f) :
    finiteWeightedEnergy μ (finiteOperatorListAction A es f) ≤
      C ^ es.length * finiteWeightedEnergy μ f := by
  simpa using finite_operator_list_energy_le μ S A hS (fun _ => C) (fun _ => hC) hA es f hf
end

section
open Finset Classical
/-- Transfer a uniform per-group energy loss to a polynomial loss. Taking
`max 1 C` also covers constants smaller than one and empty group sets. -/
theorem group_energy_bound_of_log_card {G : Type*} (groups : Finset G)
    {C L K Eout Ein : ℝ} (hC : 0 ≤ C) (hL : 0 < L) (hEin : 0 ≤ Ein)
    (hcard : (groups.card : ℝ) ≤ K * Real.log L)
    (henergy : Eout ≤ C ^ groups.card * Ein) :
    Eout ≤ L ^ (K * Real.log (max 1 C)) * Ein := by
  have hpower : C ^ groups.card ≤ L ^ (K * Real.log (max 1 C)) := by
    simpa only [prod_const] using group_product_bound_of_log_card groups (fun _ => C)
      (le_max_left 1 C) hL (fun _ _ => hC) (fun _ _ => le_max_right 1 C) hcard
  exact henergy.trans (mul_le_mul_of_nonneg_right hpower hEin)

/-- The physical total-memory-cutoff product has a polynomial energy loss
whenever the number of processed groups has the stated logarithmic bound. -/
theorem physical_unrestricted_cutoff_product_energy_le_rpow
    {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (V : G → ℝ) (baseline : ∀ g, P g → ℝ)
    (hpositive : ∀ g (p : P g), 0 < p.val)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (hbaseline : ∀ g p, 1 / 2 ≤ baseline g p ∧ baseline g p ≤ 1)
    (Δ D : G → ℤ) {ρ v vmin vmax : ℝ}
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (t : G → ℕ) (B T : ℕ) (ht : ∀ g, t g ≤ T)
    (phase : ∀ g, UnrestrictedBoundedPhase (fun p : P g => p.val) (Δ g) (D g) (t g) B)
    (hphase : ∀ g s stores promotions e fresh, ‖phase g s stores promotions e fresh‖ ≤ 1)
    (groups : Finset G) {L K : ℝ} (hL : 0 < L)
    (hcard : (groups.card : ℝ) ≤ K * Real.log L)
    (f : ProductBoundedOrderedState (fun g => P g)
      (fun g => UnrestrictedResidueParticle (fun p : P g => p.val)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    let _ : ∀ g (p : P g), NeZero p.val := fun g p => ⟨Nat.ne_of_gt (hpositive g p)⟩
    finiteWeightedEnergy
      (productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (baseline g))
        (fun g => unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g (baseline g))))
      (unrestrictedCutoffProductOperator (fun g (p : P g) => p.val) Δ D
        (fun g => tiltedPhysicalBirthLaw V g (baseline g)) ρ V t B phase groups f) ≤
      L ^ (K * Real.log (max 1 (unrestrictedEdgeEnergyBound ρ v vmin vmax T))) *
        finiteWeightedEnergy
          (productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (baseline g))
            (fun g => unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g (baseline g)))) f := by
  let _ : ∀ g (p : P g), NeZero p.val := fun g p => ⟨Nat.ne_of_gt (hpositive g p)⟩
  have he := physical_unrestricted_cutoff_product_energy_le P V baseline hpositive hMass
    hbaseline Δ D hρ0 hρ1 hv hvmin hVlo hVhi t B T ht phase hphase groups f hf
  apply group_energy_bound_of_log_card groups
    (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) hL _ hcard he
  apply sum_nonneg
  intro s hs
  apply mul_nonneg _ (sq_nonneg _)
  exact (physical_product_memory_weight_pos P V baseline
    (fun g => hvmin.trans_le (hVlo g)) hpositive
    (fun g p => lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1 / 2) (hbaseline g p).1)
    t B s).le
end

section
open Finset Classical
noncomputable def finiteFiberEnergy {C : Type*} [Fintype C]
    {X : C → Type*} [∀ c, Fintype (X c)]
    (κ : C → ℝ) (μ : ∀ c, X c → ℝ) (f : ∀ c, X c → ℂ) : ℝ :=
  ∑ c, κ c * finiteWeightedEnergy (μ c) (f c)

noncomputable def finiteFiberAverage {C : Type*} {A X : C → Type*}
    [∀ c, Fintype (A c)] (ν : ∀ c, A c → ℝ)
    (T : ∀ c, A c → (X c → ℂ) → X c → ℂ)
    (f : ∀ c, X c → ℂ) (c : C) (x : X c) : ℂ :=
  ∑ a, (ν c a : ℂ) * T c a (f c) x

theorem finite_fiber_energy_eq_sigma {C : Type*} [Fintype C]
    {X : C → Type*} [∀ c, Fintype (X c)]
    (κ : C → ℝ) (μ : ∀ c, X c → ℝ) (f : ∀ c, X c → ℂ) :
    finiteFiberEnergy κ μ f =
      finiteWeightedEnergy (fun z : Sigma X => κ z.1 * μ z.1 z.2)
        (fun z => f z.1 z.2) := by
  simp only [finiteFiberEnergy, finiteWeightedEnergy, Fintype.sum_sigma,
    mul_sum, mul_assoc]

/-- Averaging under a subprobability law contracts the average squared norm. -/
theorem finite_subprobability_average_energy_le {A X : Type*}
    [Fintype A] [Fintype X] (ν : A → ℝ) (μ : X → ℝ)
    (hν : ∀ a, 0 ≤ ν a) (hνmass : ∑ a, ν a ≤ 1) (hμ : ∀ x, 0 ≤ μ x)
    (F : A → X → ℂ) :
    finiteWeightedEnergy μ (fun x => ∑ a, (ν a : ℂ) * F a x) ≤
      ∑ a, ν a * finiteWeightedEnergy μ (F a) := by
  have hpoint (x : X) : ‖∑ a, (ν a : ℂ) * F a x‖ ^ 2 ≤
      ∑ a, ν a * ‖F a x‖ ^ 2 := by
    calc
      _ ≤ (∑ a, ν a) * ∑ a, ν a * ‖F a x‖ ^ 2 :=
        finite_weighted_sum_cauchy univ ν (fun a _ => hν a) (fun a => F a x)
      _ ≤ 1 * ∑ a, ν a * ‖F a x‖ ^ 2 :=
        mul_le_mul_of_nonneg_right hνmass
          (sum_nonneg fun a _ => mul_nonneg (hν a) (sq_nonneg _))
      _ = _ := one_mul _
  unfold finiteWeightedEnergy
  calc
    _ ≤ ∑ x, μ x * ∑ a, ν a * ‖F a x‖ ^ 2 :=
      sum_le_sum fun x _ => mul_le_mul_of_nonneg_left (hpoint x) (hμ x)
    _ = ∑ a, ν a * ∑ x, μ x * ‖F a x‖ ^ 2 := by
      simp only [mul_sum]
      rw [sum_comm]
      apply sum_congr rfl
      intro a _
      apply sum_congr rfl
      intro x _
      ring

/-- A uniform bound on each auxiliary action lifts without any factor counting
the retained parameter fibers. The bound is needed only for the input slices. -/
theorem finite_fiber_average_energy_le {C : Type*} [Fintype C]
    {A X : C → Type*} [∀ c, Fintype (A c)] [∀ c, Fintype (X c)]
    (κ : C → ℝ) (μ : ∀ c, X c → ℝ) (ν : ∀ c, A c → ℝ)
    (hκ : ∀ c, 0 ≤ κ c) (hμ : ∀ c x, 0 ≤ μ c x)
    (hν : ∀ c a, 0 ≤ ν c a) (hνmass : ∀ c, ∑ a, ν c a ≤ 1)
    (T : ∀ c, A c → (X c → ℂ) → X c → ℂ)
    (f : ∀ c, X c → ℂ) {K : ℝ} (hK : 0 ≤ K)
    (hT : ∀ c a, finiteWeightedEnergy (μ c) (T c a (f c)) ≤
      K * finiteWeightedEnergy (μ c) (f c)) :
    finiteFiberEnergy κ μ (finiteFiberAverage ν T f) ≤ K * finiteFiberEnergy κ μ f := by
  have hlocal (c : C) : finiteWeightedEnergy (μ c) (finiteFiberAverage ν T f c) ≤
      K * finiteWeightedEnergy (μ c) (f c) := by
    calc
      _ ≤ ∑ a, ν c a * finiteWeightedEnergy (μ c) (T c a (f c)) :=
        finite_subprobability_average_energy_le (ν c) (μ c) (hν c) (hνmass c)
          (hμ c) (fun a => T c a (f c))
      _ ≤ ∑ a, ν c a * (K * finiteWeightedEnergy (μ c) (f c)) :=
        sum_le_sum fun a _ => mul_le_mul_of_nonneg_left (hT c a) (hν c a)
      _ = (∑ a, ν c a) * (K * finiteWeightedEnergy (μ c) (f c)) := (sum_mul ..).symm
      _ ≤ 1 * (K * finiteWeightedEnergy (μ c) (f c)) :=
        mul_le_mul_of_nonneg_right (hνmass c)
          (mul_nonneg hK (sum_nonneg fun x _ => mul_nonneg (hμ c x) (sq_nonneg _)))
      _ = _ := one_mul _
  unfold finiteFiberEnergy
  rw [mul_sum]
  apply sum_le_sum
  intro c _
  calc
    _ ≤ κ c * (K * finiteWeightedEnergy (μ c) (f c)) :=
      mul_le_mul_of_nonneg_left (hlocal c) (hκ c)
    _ = _ := by ring
end

section
open scoped BigOperators
theorem unit_geometric_sum_norm_le_length (z : ℂ) (hz : ‖z‖ = 1) (N : ℕ) :
    ‖∑ n ∈ Finset.range N, z ^ n‖ ≤ N := by
  calc
    _ ≤ ∑ n ∈ Finset.range N, ‖z ^ n‖ := norm_sum_le _ _
    _ = N := by simp [norm_pow, hz]

theorem unit_geometric_sum_norm_mul_chord_le (z : ℂ) (hz : ‖z‖ = 1) (N : ℕ) :
    ‖∑ n ∈ Finset.range N, z ^ n‖ * ‖z - 1‖ ≤ 2 := by
  calc
    _ = ‖(∑ n ∈ Finset.range N, z ^ n) * (z - 1)‖ := (norm_mul _ _).symm
    _ = ‖z ^ N - 1‖ := by rw [geom_sum_mul]
    _ ≤ ‖z ^ N‖ + ‖(1 : ℂ)‖ := norm_sub_le _ _
    _ = 2 := by simpa only [norm_pow, hz, one_pow, norm_one] using (show (1:ℝ)+1=2 by norm_num)

theorem unit_geometric_sum_norm_le_min (z : ℂ) (hz : ‖z‖ = 1)
    (hne : z ≠ 1) (N : ℕ) :
    ‖∑ n ∈ Finset.range N, z ^ n‖ ≤ min (N : ℝ) (2 / ‖z - 1‖) := by
  refine le_min (unit_geometric_sum_norm_le_length z hz N) ?_
  exact (le_div_iff₀ (norm_pos_iff.mpr (sub_ne_zero.mpr hne))).mpr
    (unit_geometric_sum_norm_mul_chord_le z hz N)

theorem unit_geometric_interval_norm_le_min (z : ℂ) (hz : ‖z‖ = 1)
    (hne : z ≠ 1) (a N : ℕ) :
    ‖∑ n ∈ Finset.range N, z ^ (a + n)‖ ≤ min (N : ℝ) (2 / ‖z - 1‖) := by
  simp_rw [pow_add]
  rw [← Finset.mul_sum, norm_mul, norm_pow, hz, one_pow, one_mul]
  exact unit_geometric_sum_norm_le_min z hz hne N
end

section
open scoped BigOperators InnerProductSpace
theorem finite_matrix_gram_energy_le {X Y : Type*} [Fintype X] [Fintype Y]
    (K : X → Y → ℂ) (b : Y → ℂ) {B : ℝ}
    (hrow : ∀ y, (∑ z, ‖∑ x, (starRingEnd ℂ) (K x y) * K x z‖) ≤ B) :
    (∑ x, ‖∑ y, K x y * b y‖ ^ 2) ≤ B * ∑ y, ‖b y‖ ^ 2 := by
  let u : Y → EuclideanSpace ℂ X := fun y => finiteMeasureVector (fun _ => 1) (fun x => K x y)
  have hg := finite_gram_row_norm_sq u b (fun y => by
    simpa only [u, finite_measure_vector_inner _ (fun _ => zero_le_one),
      Complex.ofReal_one, one_mul] using hrow y)
  have hu : (∑ y, b y • u y) =
      finiteMeasureVector (fun _ => 1) (fun x => ∑ y, K x y * b y) := by
    apply PiLp.ext
    intro x
    simp only [u, WithLp.ofLp_sum, Finset.sum_apply, PiLp.smul_apply,
      finite_measure_vector_apply, Real.sqrt_one, Complex.ofReal_one, one_mul,
      smul_eq_mul]
    apply Finset.sum_congr rfl
    intro y _
    exact mul_comm _ _
  rw [hu, finite_measure_vector_norm_sq _ (fun _ => zero_le_one)] at hg
  simpa only [one_mul] using hg

theorem finite_bilinear_gram_norm_sq_le {X Y : Type*} [Fintype X] [Fintype Y]
    (K : X → Y → ℂ) (a : X → ℂ) (b : Y → ℂ) {B : ℝ}
    (hrow : ∀ y, (∑ z, ‖∑ x, (starRingEnd ℂ) (K x y) * K x z‖) ≤ B) :
    ‖∑ x, ∑ y, a x * b y * K x y‖ ^ 2 ≤
      B * (∑ x, ‖a x‖ ^ 2) * ∑ y, ‖b y‖ ^ 2 := by
  let f : X → ℂ := fun x => ∑ y, K x y * b y
  let u := finiteMeasureVector (fun _ : X => 1) (fun x => (starRingEnd ℂ) (a x))
  let v := finiteMeasureVector (fun _ : X => 1) f
  have hi : inner ℂ u v = ∑ x, ∑ y, a x * b y * K x y := by
    rw [finite_measure_vector_inner _ (fun _ => zero_le_one)]
    simp only [Complex.ofReal_one, one_mul, RingHomCompTriple.comp_apply,
      RingHom.id_apply, f, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro x _
    apply Finset.sum_congr rfl
    intro y _
    ring
  have hc : ‖inner ℂ u v‖ ^ 2 ≤ ‖u‖ ^ 2 * ‖v‖ ^ 2 := by
    simpa only [mul_pow] using
      (sq_le_sq₀ (norm_nonneg _) (mul_nonneg (norm_nonneg _) (norm_nonneg _))).mpr
        (norm_inner_le_norm u v)
  rw [hi] at hc
  have hu : ‖u‖ ^ 2 = ∑ x, ‖a x‖ ^ 2 := by
    simp only [u, finite_measure_vector_norm_sq _ (fun _ => zero_le_one),
      Complex.norm_conj, one_mul]
  have hv : ‖v‖ ^ 2 = ∑ x, ‖f x‖ ^ 2 := by
    simp only [v, finite_measure_vector_norm_sq _ (fun _ => zero_le_one), one_mul]
  rw [hu, hv] at hc
  have hg := finite_matrix_gram_energy_le K b hrow
  calc
    _ ≤ (∑ x, ‖a x‖ ^ 2) * ∑ x, ‖f x‖ ^ 2 := hc
    _ ≤ (∑ x, ‖a x‖ ^ 2) * (B * ∑ y, ‖b y‖ ^ 2) :=
      mul_le_mul_of_nonneg_left hg (Finset.sum_nonneg (fun _ _ => sq_nonneg _))
    _ = _ := by ring
end

section
open Finset Filter
open scoped Topology
theorem eventually_candidate_P_pool_below_rough_cutoff {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ p ∈ (candidatePIndices c L).biUnion (candidatePBand (c * L)),
      (p : ℝ) ≤ Real.exp (Real.sqrt L) := by
  obtain ⟨v, V, _, _, hpool⟩ := exists_candidate_P_pool_bounds hc
  filter_upwards [hpool] with L hL
  intro p hp
  obtain ⟨j, hj, hpj⟩ := mem_biUnion.mp hp
  have hu := ((hL.2.2.2.2.2 j hj).2.2 p hpj).2.2
  refine hu.trans (Real.exp_le_exp.mpr ?_)
  rw [Real.sqrt_eq_rpow]
  exact Real.rpow_le_rpow_of_exponent_le hL.1 (by norm_num)

theorem candidate_Q_slot_primeFactors_disjoint {c L : ℝ} {r jStar : ℕ}
    (hcL : 0 ≤ c * L)
    (hpool : ∀ p ∈ (candidatePIndices c L).biUnion (candidatePBand (c * L)),
      (p : ℝ) ≤ Real.exp (Real.sqrt L))
    (slot : (candidateQIndices c L) × Fin r) {n : ℕ}
    (hn : n ∈ candidateQSlotChoices c L r jStar slot) :
    Disjoint n.primeFactors ((candidatePIndices c L).biUnion (candidatePBand (c * L))) := by
  apply disjoint_left.mpr
  intro p hp hP
  simp only [candidateQSlotChoices] at hn
  split_ifs at hn with hs
  · exact (not_lt_of_ge (hpool p hP)) ((mem_filter.mp hn).2 p hp)
  · have hnPrime : n.Prime := (mem_filter.mp hn).2
    have hpPrime := Nat.mem_primeFactors.mp hp
    have hpn : p = n := ((Nat.dvd_prime hnPrime).mp hpPrime.2.1).resolve_left hpPrime.1.ne_one
    subst p
    obtain ⟨j, _, hnj⟩ := mem_biUnion.mp hP
    exact disjoint_left.mp (disjoint_candidatePBand_candidateQBand hcL j slot.1.val) hnj hn

theorem candidate_Q_tuple_primeFactors_disjoint {c L : ℝ} {r jStar : ℕ}
    (hcL : 0 ≤ c * L)
    (hpool : ∀ p ∈ (candidatePIndices c L).biUnion (candidatePBand (c * L)),
      (p : ℝ) ≤ Real.exp (Real.sqrt L))
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) :
    Disjoint (orderedSlotProduct (candidateQSlotChoices c L r jStar) x).primeFactors
      ((candidatePIndices c L).biUnion (candidatePBand (c * L))) := by
  classical
  apply disjoint_left.mpr
  intro p hp hP
  obtain ⟨hpp, hpdvd, _⟩ := Nat.mem_primeFactors.mp hp
  obtain ⟨slot, _, hpslot⟩ := ((Nat.prime_iff.mp hpp).dvd_finsetProd_iff (fun slot => (x slot).val)).mp hpdvd
  have hmem : p ∈ (x slot).val.primeFactors := Nat.mem_primeFactors.mpr
    ⟨hpp, hpslot, candidate_Q_slot_nonzero c L r jStar slot (x slot).property⟩
  exact disjoint_left.mp (candidate_Q_slot_primeFactors_disjoint hcL hpool slot (x slot).property) hmem hP

theorem ordered_slot_weight_ne_zero_support {I : Type*} [Fintype I]
    (choices : I → Finset ℕ) (N : ℝ) {n : ℕ} (hn : orderedSlotWeight choices N n ≠ 0) :
    ∃ x : ∀ i, choices i, orderedSlotProduct choices x = n := by
  classical
  by_contra h
  push Not at h
  apply hn
  unfold orderedSlotWeight
  exact sum_eq_zero (fun x _ => if_neg (h x))

theorem eventually_candidate_Q_weight_free_support {c : ℝ} (hc : 0 < c) (r : ℕ) :
    ∀ᶠ L : ℝ in atTop, ∀ jStar n : ℕ, candidateQWeight c L r jStar n ≠ 0 →
      n ≠ 0 ∧ Disjoint n.primeFactors ((candidatePIndices c L).biUnion (candidatePBand (c * L))) := by
  filter_upwards [eventually_candidate_P_pool_below_rough_cutoff hc,
    eventually_ge_atTop (0 : ℝ)] with L hp hL
  intro jStar n hn
  obtain ⟨x, hx⟩ := ordered_slot_weight_ne_zero_support _ _ hn
  refine ⟨?_, ?_⟩
  · rw [← hx]
    exact prod_ne_zero_iff.mpr (fun slot _ => candidate_Q_slot_nonzero c L r jStar slot (x slot).property)
  · rw [← hx]
    exact candidate_Q_tuple_primeFactors_disjoint (mul_nonneg hc.le hL) hp x
end

section
open Finset
theorem supported_free_window_convolution_le (P S : Finset ℕ)
    (a b W : ℕ → ℝ) (X : ℝ)
    (hS : ∀ p ∈ S, p ∈ Nat.factoredNumbers P)
    (hb : ∀ n, b n ≠ 0 → n ≠ 0 ∧ Disjoint n.primeFactors P)
    (hW : ∀ u ∈ arithmeticProductWindow 1 X, 0 ≤ W u)
    (hprod : ∀ p ∈ S, ∀ n, b n ≠ 0 → W (p * n) = a p * b n) :
    (∑ p ∈ S, a p * ∑ n ∈ arithmeticProductWindow p X, b n) ≤
      ∑ u ∈ arithmeticProductWindow 1 X, W u := by
  classical
  let T : Finset (Σ _p : ℕ, ℕ) :=
    S.sigma (fun p => (arithmeticProductWindow p X).filter (fun n => b n ≠ 0))
  let f : (Σ _p : ℕ, ℕ) → ℕ := fun z => z.1 * z.2
  have hinj : Set.InjOn f T := by
    intro x hx y hy hxy
    have hx' := mem_sigma.mp hx
    have hy' := mem_sigma.mp hy
    have hbx := hb x.2 (mem_filter.mp hx'.2).2
    have hby := hb y.2 (mem_filter.mp hy'.2).2
    obtain ⟨hp, hn⟩ := supported_free_product_unique
      (hS x.1 hx'.1) hbx.1 hbx.2 (hS y.1 hy'.1) hby.1 hby.2 hxy
    exact Sigma.ext hp (heq_of_eq hn)
  have hsubset : T.image f ⊆ arithmeticProductWindow 1 X := by
    intro u hu
    obtain ⟨z, hz, rfl⟩ := mem_image.mp hu
    have hz' := mem_sigma.mp hz
    have hwindow := (mem_filter.mp hz'.2).1
    have hp0 := Nat.ne_zero_of_mem_factoredNumbers (hS z.1 hz'.1)
    have hrange := (mem_arithmeticProductWindow_iff hp0 X).mp hwindow
    apply (mem_arithmeticProductWindow_iff one_ne_zero X).mpr
    simpa only [one_mul, f] using hrange
  calc
    _ = ∑ z ∈ T, W (f z) := by
      dsimp only [T, f]
      rw [sum_sigma]
      apply sum_congr rfl
      intro p hp
      rw [← sum_filter_ne_zero (arithmeticProductWindow p X), mul_sum]
      apply sum_congr rfl
      intro n hn
      exact (hprod p hp n (mem_filter.mp hn).2).symm
    _ = ∑ u ∈ T.image f, W u := (sum_image hinj).symm
    _ ≤ _ := sum_le_sum_of_subset_of_nonneg hsubset (fun u hu _ => hW u hu)
end

section
open Finset
theorem prime_group_slot_harmonic_atom_rpow {G Ω : Type*} [Fintype G] [Fintype Ω]
    (P : G → Finset ℕ) (k : G → ℕ)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h)))
    (x : Ω → ∀ g, Fin (k g) → ℕ) (hxinj : Function.Injective x)
    (hx : ∀ a g i, x a g i ∈ P g) (V : G → ℝ) (m : ℕ)
    {v L D : ℝ} (hv : 0 < v) (hL : 0 < L)
    (hV : ∀ g, v ≤ V g) (hk : ∀ g, k g ≤ m)
    (hcard : (Fintype.card G : ℝ) ≤ D * Real.log L) (n : ℕ) :
    (∑ a : Ω, if (∏ g, ∏ i, x a g i) = n then
      (∏ g, ∏ i, (1 / (x a g i : ℝ)) / V g) else 0) ≤
      L^(D * Real.log (primeFiberFactorBound v m)) / (n : ℝ) := by
  calc
    _ ≤ (1 / (n : ℝ)) * ∏ g, ((k g).factorial : ℝ) / (V g)^(k g) :=
      prime_group_slot_harmonic_atom_bound P k hprime hdisj x hxinj hx V
        (fun g => hv.le.trans (hV g)) n
    _ ≤ (1 / (n : ℝ)) * L^(D * Real.log (primeFiberFactorBound v m)) :=
      mul_le_mul_of_nonneg_left
        (prime_fiber_factor_fintype_product_le_rpow V k m hv hL hV hk hcard) (by positivity)
    _ = _ := by ring
end

