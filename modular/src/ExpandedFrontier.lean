      physicalMellinPhase (-2 * Real.pi * u) Y *
        harmonicMellinWeight (s + 2 * Real.pi * u) x := by
  simp only [box_weight_eq_phase_div]
  calc
    _ = (physicalMellinPhase s x *
        physicalMellinPhase (2 * Real.pi * u) (x / Y)) / (x : ℂ) := by ring
    _ = _ := by rw [normalized_box_phase_ratio hY hx]; ring

theorem harmonic_normalized_four_box_integrable (Y s : ℝ) (D A B C : Finset ℕ)
    (δ α β γ : ℕ → ℂ)
    (hD : ∀ d ∈ D, 0 < d) (hA : ∀ a ∈ A, 0 < a)
    (hB : ∀ b ∈ B, 0 < b) (hC : ∀ c ∈ C, 0 < c) :
    Integrable (fun u : ℝ => harmonicWindowLogFourier u *
      physicalMellinPhase (-2 * Real.pi * u) Y *
        ((∑ d ∈ D, δ d * harmonicMellinWeight (s + 2 * Real.pi * u) d) *
          (∑ a ∈ A, α a * harmonicMellinWeight (s + 2 * Real.pi * u) a) *
          (∑ b ∈ B, β b * harmonicMellinWeight (s + 2 * Real.pi * u) b) *
          (∑ c ∈ C, γ c * harmonicMellinWeight (s + 2 * Real.pi * u) c))) := by
  have hi := finite_mellin_sum_integrable (D ×ˢ (A ×ˢ (B ×ˢ C)))
    (fun u => harmonicWindowLogFourier u * physicalMellinPhase (-2 * Real.pi * u) Y)
    (fun u => s + 2 * Real.pi * u)
    (physical_mellin_phase_integrable harmonicWindowLogFourier
      (fun u => -2 * Real.pi * u) harmonic_window_log_fourier_integrable (by fun_prop) Y)
    (by fun_prop)
    (fun q => (δ q.1 * α q.2.1 * β q.2.2.1 * γ q.2.2.2) /
      (((q.1*q.2.1*q.2.2.1*q.2.2.2 : ℕ) : ℝ) : ℂ))
    (fun q => ((q.1*q.2.1*q.2.2.1*q.2.2.2 : ℕ) : ℝ))
  apply hi.congr
  filter_upwards [] with u
  simp only [sum_product]
  rw [← harmonic_mellin_four_factor_box D A B C hD hA hB hC δ α β γ]
  congr 1
  apply sum_congr rfl
  intro d _
  apply sum_congr rfl
  intro a _
  apply sum_congr rfl
  intro b _
  apply sum_congr rfl
  intro c _
  rw [box_weight_eq_phase_div]
  ring

theorem harmonic_normalized_four_box_mellin {Y : ℝ} (hY : 0 < Y) (s : ℝ)
    (D A B C : Finset ℕ) (δ α β γ : ℕ → ℂ)
    (hD : ∀ d ∈ D, 0 < d) (hA : ∀ a ∈ A, 0 < a)
    (hB : ∀ b ∈ B, 0 < b) (hC : ∀ c ∈ C, 0 < c) :
    (∑ d ∈ D, ∑ a ∈ A, ∑ b ∈ B, ∑ c ∈ C,
      (δ d * α a * β b * γ c) *
        ((harmonicCommonCutoff (((d*a*b*c : ℕ) : ℝ) / Y) /
          ((d*a*b*c : ℕ) : ℝ) : ℝ) : ℂ) *
        physicalMellinPhase s ((d*a*b*c : ℕ) : ℝ)) =
      ∫ u : ℝ, harmonicWindowLogFourier u * physicalMellinPhase (-2 * Real.pi * u) Y *
        ((∑ d ∈ D, δ d * harmonicMellinWeight (s + 2 * Real.pi * u) d) *
          (∑ a ∈ A, α a * harmonicMellinWeight (s + 2 * Real.pi * u) a) *
          (∑ b ∈ B, β b * harmonicMellinWeight (s + 2 * Real.pi * u) b) *
          (∑ c ∈ C, γ c * harmonicMellinWeight (s + 2 * Real.pi * u) c)) := by
  let K := D ×ˢ (A ×ˢ (B ×ˢ C))
  let m : ℕ × ℕ × ℕ × ℕ → ℝ := fun q => ((q.1*q.2.1*q.2.2.1*q.2.2.2 : ℕ) : ℝ)
  let f : ℕ × ℕ × ℕ × ℕ → ℂ := fun q => δ q.1 * α q.2.1 * β q.2.2.1 * γ q.2.2.2
  have hm : ∀ q ∈ K, 0 < m q := by
    intro q hq
    obtain ⟨hd, ha, hb, hc⟩ := by simpa only [K, mem_product] using hq
    dsimp only [m]
    exact_mod_cast mul_pos (mul_pos (mul_pos (hD q.1 hd) (hA q.2.1 ha))
      (hB q.2.2.1 hb)) (hC q.2.2.2 hc)
  have hrep := finite_mellin_sum_representation K harmonicWindowLogFourier
    (fun u => 2 * Real.pi * u) harmonic_window_log_fourier_integrable (by fun_prop)
    (fun q => f q * harmonicMellinWeight s (m q)) (fun q => m q / Y)
    (fun x => (harmonicCommonCutoff x : ℂ)) (by
      intro q hq _
      exact harmonic_window_cutoff_mellin_representation (div_pos (hm q hq) hY))
  calc
    _ = ∑ q ∈ K, (f q * harmonicMellinWeight s (m q)) *
        (harmonicCommonCutoff (m q / Y) : ℂ) := by
      dsimp only [K, f, m]
      simp only [sum_product]
      apply sum_congr rfl
      intro d _
      apply sum_congr rfl
      intro a _
      apply sum_congr rfl
      intro b _
      apply sum_congr rfl
      intro c _
      rw [box_weight_eq_phase_div, Complex.ofReal_div]
      ring
    _ = ∫ u : ℝ, harmonicWindowLogFourier u * ∑ q ∈ K,
        (f q * harmonicMellinWeight s (m q)) *
          physicalMellinPhase (2 * Real.pi * u) (m q / Y) := hrep
    _ = _ := by
      apply integral_congr_ae
      filter_upwards [] with u
