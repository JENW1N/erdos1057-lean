section

/- Exact ghost-birth counts and memory growth for paths with moving small states. -/
open Finset Classical
namespace Bounty
section
variable {H K S G : Type} {Ps : S → Finset ℕ} {P : G → Type}
  [Fintype S] [Fintype G]
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : K → ∀ g, Finset (Fin (M g))) (B : ℕ) (A : K → Type)
  (Δ D : ∀ k, PhysicalSharedLists Ps J → SharedActiveLabels P (shared k) → A k → G → ℤ)
  (kbig : ∀ k, SharedActiveLabels P (shared k) → A k → ℤ)

def physicalSmallBigEventBirthCount :
    ∀ (tag : Option (H ⊕ K)) (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)),
      PhysicalSmallBigPathEvent n shared B A Δ D tag s → ℕ
  | none, _, _ => 0
  | some (.inl _), _, e => ∑ g, (e g).1.val
  | some (.inr _), _, _ => 0

noncomputable def physicalSmallBigPathBirthCount (steps : List (Option (H ⊕ K)))
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (p : PhysicalSmallBigPath (ell := ell) n shared B A Δ D kbig steps s) : ℕ :=
  finiteEventPathCount (PhysicalSmallBigPathEvent n shared B A Δ D)
    (physicalSmallBigPathEventTarget n shared B A Δ D kbig)
    (physicalSmallBigEventBirthCount n shared B A Δ D) steps s p

theorem physical_small_big_event_memory_le (T : ℕ) (ht : ∀ k g, (shared k g)ᶜ.card ≤ T)
    (tag : Option (H ⊕ K))
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (e : PhysicalSmallBigPathEvent n shared B A Δ D tag s) :
    productTotalMemory (physicalSmallBigPathEventTarget n shared B A Δ D kbig tag s e).2 ≤
      productTotalMemory s.2 + physicalSmallBigEventBirthCount n shared B A Δ D tag s e +
        fullMemoryEdgeIndicator tag * (T * Fintype.card G) := by
  cases tag with
  | none =>
    simpa only [physicalSmallBigPathEventTarget, physicalSmallBigEventBirthCount,
      fullMemoryEdgeIndicator, Nat.add_zero, Nat.zero_mul] using
      (fullActivePermutation_total_memory e.2 s.2).le
  | some tag =>
    cases tag with
    | inl j =>
      exact (coupledGhostJointEventTarget_memory_le M B s.2 e).trans (by simp only
        [physicalSmallBigEventBirthCount, fullMemoryEdgeIndicator, Nat.zero_mul, Nat.add_zero, le_refl])
    | inr k =>
      have he := fullActiveEdgeEventTarget_memory_le n shared B (fun k _ => A k)
        (fun k => Δ k (physicalSharedPrefix s.1.2))
        (fun k => D k (physicalSharedPrefix s.1.2)) k s.2 e.2
      have hc : (∑ g, (shared k g)ᶜ.card) ≤ T * Fintype.card G := by
        calc
          _ ≤ ∑ _g : G, T := sum_le_sum fun g _ => ht k g
          _ = _ := by simp only [sum_const, card_univ, smul_eq_mul, mul_comm]
      exact he.trans (by simpa only [physicalSmallBigEventBirthCount, fullMemoryEdgeIndicator,
        Nat.add_zero, Nat.one_mul] using Nat.add_le_add_left hc (productTotalMemory s.2))

theorem physical_small_big_path_peak_le (T : ℕ) (ht : ∀ k g, (shared k g)ᶜ.card ≤ T)
    (steps : List (Option (H ⊕ K)))
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (p : PhysicalSmallBigPath (ell := ell) n shared B A Δ D kbig steps s) :
    physicalSmallBigPathPeak n shared B A Δ D kbig steps s p ≤
      productTotalMemory s.2 + physicalSmallBigPathBirthCount n shared B A Δ D kbig steps s p +
        fullMemoryEdgeCount steps * (T * Fintype.card G) := by
  induction steps generalizing s with
  | nil =>
    simp only [physicalSmallBigPathPeak, finiteEventPathMaximum, physicalSmallBigPathBirthCount,
      finiteEventPathCount, fullMemoryEdgeCount, List.map_nil, List.sum_nil,
      Nat.add_zero, Nat.zero_mul, le_refl]
  | cons tag steps ih =>
    rcases p with ⟨e, p⟩
    have he := physical_small_big_event_memory_le n shared B A Δ D kbig T ht tag s e
    have hp := ih (physicalSmallBigPathEventTarget n shared B A Δ D kbig tag s e) p
    change max (productTotalMemory s.2)
      (physicalSmallBigPathPeak n shared B A Δ D kbig steps _ p) ≤
        productTotalMemory s.2 +
          (physicalSmallBigEventBirthCount n shared B A Δ D tag s e +
            physicalSmallBigPathBirthCount n shared B A Δ D kbig steps _ p) +
          (fullMemoryEdgeIndicator tag + fullMemoryEdgeCount steps) * (T * Fintype.card G)
    rw [add_mul]
    omega

theorem physical_small_big_path_exceeds_implies_births
    (T : ℕ) (ht : ∀ k g, (shared k g)ᶜ.card ≤ T)
    (steps : List (Option (H ⊕ K)))
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (p : PhysicalSmallBigPath (ell := ell) n shared B A Δ D kbig steps s) (threshold : ℕ)
    (hlarge : threshold < physicalSmallBigPathPeak n shared B A Δ D kbig steps s p) :
    threshold + 1 - productTotalMemory s.2 - fullMemoryEdgeCount steps * (T * Fintype.card G) ≤
      physicalSmallBigPathBirthCount n shared B A Δ D kbig steps s p := by
  have he := physical_small_big_path_peak_le n shared B A Δ D kbig T ht steps s p
  omega
end
end Bounty
end

