/- Empty-memory terminal and initial states for fixed selected physical paths. -/

open scoped Classical

namespace Bounty

noncomputable def physicalEmptyMemoryTerminal
    {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (s : PhysicalBoundedMarkState P J ell B) : ℂ :=
  if ∀ g, (s.2.2 g).1.val = 0 then 1 else 0

theorem physical_empty_memory_terminal_extension
    {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (R : PhysicalMarkLists P J ell) :
    physicalMarkRawExtension (B := B) physicalEmptyMemoryTerminal R =
      fun s => if ∀ g, (s g).2.1 = 0 then (1 : ℂ) else 0 := by
  apply physical_mark_raw_extension_eq_of_total_cutoff
  · intro s hs
    have hn : ¬ ∀ g, (s g).2.1 = 0 := by
      intro h
      have hz : globalBirthJointLength s = 0 := by
        simp only [globalBirthJointLength, h, Finset.sum_const_zero]
      omega
    exact if_neg hn
  · intro s _
    rfl

noncomputable def physicalInitialMarkState
    {N J ell : ℕ} {P : Fin N → Finset ℕ} (B : ℕ)
    (R : PhysicalMarkLists P J ell) : PhysicalBoundedMarkState P J ell B :=
  (R, (fun g => ghostPhaseActivitySupport (physicalGroupPhaseActivity R g)),
    fun _ => ⟨⟨0, Nat.zero_lt_succ B⟩, Fin.elim0⟩)

theorem physical_initial_mark_state_readout
    {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
    (L : Fin (n + 1) → PhysicalMarkLists P J ell) :
    physicalMarkRawReadout (physicalInitialMarkState B (L 0)) =
      globalBirthJointInitial (fun g => physicalGroupBareAtomicActivity L g 0) := by
  funext g
  simp only [physicalMarkRawReadout, physicalInitialMarkState, globalBirthJointInitial,
    physical_group_bare_atomic_activity_initial]
  rfl

end Bounty
end

section

/- Exact pair-sieve moments indexed by squarefree moduli and a summed lattice error. -/

open Finset

namespace Bounty

noncomputable def pairSieveRemainder (A B C D m : ℕ) (rough banned : ℕ → Bool)
    (d : ℕ) : ℝ :=
  ((pairSieveIntersection A B C D m d.primeFactors rough banned).card : ℝ) -
    (((B : ℝ)-A)*((D : ℝ)-C)*(m.totient : ℝ)/(m : ℝ)^2) *
      ∏ p ∈ d.primeFactors, pairSieveDensity p (rough p) (banned p)

theorem pair_sieve_exact_moment (A B C D m : ℕ) (rough banned : ℕ → Bool)
    (S : Finset ℕ) (hS : ∀ p ∈ S, p.Prime) :
    ((pairSieveIntersection A B C D m S rough banned).card : ℝ) =
      (((B : ℝ)-A)*((D : ℝ)-C)*(m.totient : ℝ)/(m : ℝ)^2) *
        (∏ p ∈ S, pairSieveDensity p (rough p) (banned p)) +
      pairSieveRemainder A B C D m rough banned (∏ p ∈ S, p) := by
  simp only [pairSieveRemainder, Nat.primeFactors_prod hS]
  ring

theorem pair_sieve_remainder_bound (A B C D m d : ℕ) [NeZero m]
    (rough banned : ℕ → Bool) (hAB : A ≤ B) (hCD : C ≤ D)
    (hd : Squarefree d) (hdm : ∀ p ∈ d.primeFactors, ¬p ∣ m) :
    |pairSieveRemainder A B C D m rough banned d| ≤
      (m : ℝ)*(d : ℝ)^2 + (((B : ℝ)-A)+((D : ℝ)-C))*(d : ℝ) := by
  have hb := actual_pair_sieve_intersection_error A B C D m hAB hCD d.primeFactors
    rough banned (fun p hp => (Nat.mem_primeFactors.mp hp).1) hdm
  simpa only [pairSieveRemainder, Nat.prod_primeFactors_of_squarefree hd] using hb

theorem pair_sieve_remainder_sum_le (A B C D m : ℕ) [NeZero m]
    (rough banned : ℕ → Bool) (hAB : A ≤ B) (hCD : C ≤ D)
    (P : Finset ℕ) (hP : ∀ p ∈ P, p.Prime) (hPm : ∀ p ∈ P, ¬p ∣ m)
    (R : ℝ) (hR : 0 ≤ R) :
    (∑ d ∈ blockSieveModuli P R, |pairSieveRemainder A B C D m rough banned d|) ≤
      (m : ℝ)*R^3 + (((B : ℝ)-A)+((D : ℝ)-C))*R^2 := by
  have hprod : (∏ p ∈ P, p) ≠ 0 := ne_of_gt (prod_pos (fun p hp => (hP p hp).pos))
  have hX : 0 ≤ ((B : ℝ)-A)+((D : ℝ)-C) := add_nonneg
    (sub_nonneg.mpr (Nat.cast_le.mpr hAB)) (sub_nonneg.mpr (Nat.cast_le.mpr hCD))
  have hb (d : ℕ) (hd : d ∈ blockSieveModuli P R) :
      |pairSieveRemainder A B C D m rough banned d| ≤
        (m : ℝ)*R^2 + (((B : ℝ)-A)+((D : ℝ)-C))*R := by
    obtain ⟨hd0, hdR, hdsf, hdprod⟩ := block_sieve_modulus_properties P hP R hd
    have hsub : d.primeFactors ⊆ P := by
      rw [← Nat.primeFactors_prod hP]
      exact Nat.primeFactors_mono hdprod hprod
    apply (pair_sieve_remainder_bound A B C D m d rough banned hAB hCD hdsf
      (fun p hp => hPm p (hsub hp))).trans
    exact add_le_add (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (Nat.cast_nonneg d) hdR 2)
      (Nat.cast_nonneg m)) (mul_le_mul_of_nonneg_left hdR hX)
  have hcard : ((blockSieveModuli P R).card : ℝ) ≤ R := by
    calc
      _ ≤ ((Icc 1 ⌊R⌋₊).card : ℝ) := by
        exact_mod_cast card_le_card (filter_subset (fun d => d ∣ ∏ p ∈ P, p) (Icc 1 ⌊R⌋₊))
      _ = (⌊R⌋₊ : ℝ) := by simp
      _ ≤ R := Nat.floor_le hR
  calc
    _ ≤ ∑ _d ∈ blockSieveModuli P R,
        ((m : ℝ)*R^2 + (((B : ℝ)-A)+((D : ℝ)-C))*R) := sum_le_sum hb
    _ = ((blockSieveModuli P R).card : ℝ) *
        ((m : ℝ)*R^2 + (((B : ℝ)-A)+((D : ℝ)-C))*R) := by simp only [sum_const, nsmul_eq_mul]
    _ ≤ R * ((m : ℝ)*R^2 + (((B : ℝ)-A)+((D : ℝ)-C))*R) :=
      mul_le_mul_of_nonneg_right hcard (by positivity)
    _ = _ := by ring

end Bounty
end

section

/- Exact freshness equivalence retains the original within-event distinctness condition. -/

open scoped Classical
namespace Bounty
section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
  [∀ g, DecidableEq (P g)] (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ)
  (ω : ∀ k c, A k c → ℝ) (μ : (g : Fin N) → P g → ℝ)
  (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

theorem full_mixed_birth_freshness_iff (steps : List (Option (J ⊕ K)))
    (x : FullMixedLedgerState n (M := M) B)
    (p : FullMixedLedgerPath n S B A Δ D steps x)
    (hx : FullMixedLedgerCovers n B x)
    (hp : finiteEventPathWeight
      (fun tag (s : FullMixedLedgerState n (M := M) B) =>
        FullPermutationMixedEvent n S B A Δ D tag s.2)
      (fullMixedLedgerTarget n S B A Δ D)
      (fun tag s => fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V tag s.2)
      steps x p ≠ 0) :
    ((∀ (a : FullMixedBirthAddress S B steps) (z : (g : Fin N) × P g),
        fullMixedLedgerPathBirthLabel n S B A Δ D steps x p a = some z →
        z.2 ∉ (finiteEventPathOccurrence
          (fun tag (s : FullMixedLedgerState n (M := M) B) =>
            FullPermutationMixedEvent n S B A Δ D tag s.2)
          (fullMixedLedgerTarget n S B A Δ D) steps x p a.1).1.1 z.1) ∧
      (∀ (a b : FullMixedBirthAddress S B steps) z, a.1.val = b.1.val →
        fullMixedLedgerPathBirthLabel n S B A Δ D steps x p a = some z →
        fullMixedLedgerPathBirthLabel n S B A Δ D steps x p b = some z → a = b)) ↔
    ((∀ (a : FullMixedBirthAddress S B steps) (z : (g : Fin N) × P g),
        fullMixedLedgerPathBirthLabel n S B A Δ D steps x p a = some z → z.2 ∉ x.1 z.1) ∧
      (∀ (a b : FullMixedBirthAddress S B steps) z,
        fullMixedLedgerPathBirthLabel n S B A Δ D steps x p a = some z →
        fullMixedLedgerPathBirthLabel n S B A Δ D steps x p b = some z → a = b)) := by
  have h := birth_ledger_freshness_iff
    (fun a : FullMixedBirthAddress S B steps => a.1.val)
    (fullMixedLedgerPathBirthLabel n S B A Δ D steps x p)
    (fullMixedLedgerTaggedImage n B x)
    (fun a => fullMixedLedgerTaggedImage n B (finiteEventPathOccurrence
      (fun tag (s : FullMixedLedgerState n (M := M) B) =>
        FullPermutationMixedEvent n S B A Δ D tag s.2)
      (fullMixedLedgerTarget n S B A Δ D) steps x p a.1).1)
    (fun a z => by
      rw [mem_full_mixed_ledger_tagged, mem_full_mixed_ledger_tagged]
      exact full_mixed_ledger_mem_before n S B A Δ D ω μ q ρ V steps x p hx hp a.1 z.1 z.2)
  simpa only [mem_full_mixed_ledger_tagged] using h

end Full
end Bounty
