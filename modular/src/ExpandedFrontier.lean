  subst tag
  exact ⟨_, rfl, physical_encoded_permutation_marks C k before after s e L R hs ht⟩

theorem physical_encoded_observation_ghost (j : I) (htag : tag = some (.inl j)) :
    physicalFullEventObservation C k before after tag s e = .inr none := by
  subst tag
  rfl

theorem physical_encoded_observation_edge (j : K) (htag : tag = some (.inr j)) :
    ∃ a : PhysicalAuxLabels P (C j),
      physicalFullEventObservation C k before after tag s e = .inr (some ⟨j, a⟩) := by
  subst tag
  exact ⟨e.1, rfl⟩

theorem physical_encoded_ghost_mark_step (j : I) (htag : tag = some (.inl j))
    (hcut : before = after) (L R : PhysicalBoundedMarkState P J ell B)
    (hs : physicalBoundedMarkEncode before L = s)
    (ht : physicalBoundedMarkEncode after R = physicalFullLedgerEventTarget C k tag s e) :
    R.1 = L.1 := by
  subst tag
  subst after
  exact physical_encoded_ghost_marks C k before j s e L R hs ht

end Physical
end Bounty
