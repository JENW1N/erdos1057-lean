/- Exact exponential extraction for any whole-path mask forcing births. -/
open Finset Classical
namespace Bounty
section
variable {H K S G : Type} {Ps : S → Finset ℕ} {P : G → Type}
  [Fintype S] [Fintype G] [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] {J ell : ℕ} {M : G → ℕ}
  (shared : K → ∀ g, Finset (Fin (M g))) (B : ℕ) (A : K → Type) [∀ k, Fintype (A k)]
  (Δ D : ∀ k, PhysicalSharedLists Ps J → SharedActiveLabels P (shared k) → A k → G → ℤ)
  (kbig : ∀ k, SharedActiveLabels P (shared k) → A k → ℤ)
  (ω : ∀ k, A k → ℝ) (μ : ∀ g, P g → ℝ)
  (qghost : H → ℝ) (ρ : ℝ) (V : G → ℝ) (Vs : S → ℝ) (qsmall : ℝ)
  (steps : List (Option (H ⊕ K)))
  (allowed : ∀ s, PhysicalSmallBigPath (ell := ell) n shared B A Δ D kbig steps s → Prop)
  (phase : ∀ s, PhysicalSmallBigPath (ell := ell) n shared B A Δ D kbig steps s → ℂ)

theorem physical_small_big_birth_tail_action (a : ℝ) (ha : 0 < a) (r : ℕ)
    (hallowed : ∀ s p, allowed s p → r ≤ physicalSmallBigPathBirthCount n shared B A Δ D kbig steps s p)
    (f : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)) :
    physicalSmallBigPathAction n shared B A Δ D kbig ω μ qghost ρ V Vs qsmall steps
        (fun s p => if allowed s p then phase s p else 0) f s =
      (((a ^ r)⁻¹ : ℝ) : ℂ) *
        physicalSmallBigPathVaryingGhostAction n shared B A Δ D kbig ω μ qghost ρ
          V (fun g => a * V g) Vs qsmall steps
          (fun s p => countTailPhase a r (physicalSmallBigPathBirthCount n shared B A Δ D kbig steps s p)
            (if allowed s p then phase s p else 0)) f s := by
  let _ : ∀ (tag : Option (H ⊕ K)) s,
      Fintype (PhysicalSmallBigPathEvent (H := H) (ell := ell) n shared B A Δ D tag s) :=
    physicalSmallBigPathEventFintype n shared B A Δ D
  have he := finite_event_path_counted_tail_eq
    (PhysicalSmallBigPathEvent (H := H) (ell := ell) n shared B A Δ D)
    (physicalSmallBigPathEventTarget n shared B A Δ D kbig)
    (physicalSmallBigPathEventWeight n shared B A Δ D kbig ω μ qghost ρ V Vs qsmall)
    (physicalSmallBigPathVaryingGhostWeight n shared B A Δ D kbig ω μ qghost ρ
      V (fun g => a * V g) Vs qsmall)
    steps (physicalSmallBigPathBirthCount n shared B A Δ D kbig steps) ha
    (physical_small_big_ghost_scale_path n shared B A Δ D kbig ω μ qghost ρ V Vs qsmall a steps)
    r (fun s p => if allowed s p then phase s p else 0) f s
  have hphase : (fun s p => if r ≤ physicalSmallBigPathBirthCount n shared B A Δ D kbig steps s p
      then (if allowed s p then phase s p else 0) else 0) =
      (fun s p => if allowed s p then phase s p else 0) := by
    funext s p
    by_cases h : allowed s p
    · simp only [h, if_true, hallowed s p h]
    · simp only [h, if_false, ite_self]
  rw [hphase] at he
  exact he

omit [∀ g, Fintype (P g)] [∀ g p, NeZero (n g p)] [∀ k, Fintype (A k)] in
theorem physical_small_big_birth_tail_phase_norm (a : ℝ) (ha : 1 ≤ a) (r : ℕ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1)
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (p : PhysicalSmallBigPath (ell := ell) n shared B A Δ D kbig steps s) :
    ‖countTailPhase a r (physicalSmallBigPathBirthCount n shared B A Δ D kbig steps s p)
      (if allowed s p then phase s p else 0)‖ ≤ 1 := by
  apply countTailPhase_norm_le_one ha
  split_ifs
  · exact hphase s p
  · simp only [norm_zero, zero_le_one]
end
end Bounty
