section

/- The small-state vacuum pairing of the actual large-minus-small cap
trajectory is controlled by the ghost-birth tail. The initial zero-memory
mask disappears inside the pairing because the vacuum vanishes elsewhere. -/

open Finset Classical

namespace Bounty

theorem fullMemoryVacuum_mul_zero_memory_mask {G : Type*} [Fintype G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ}
    (F : ProductBoundedOrderedState P Z M B → ℂ)
    (s : ProductBoundedOrderedState P Z M B) :
    fullMemoryVacuum s * (if productTotalMemory s ≤ 0 then F s else 0) =
      fullMemoryVacuum s * F s := by
  by_cases hs : ∀ g, (s g).2.1.val = 0
  · have ht : productTotalMemory s = 0 := by simp [productTotalMemory, hs]
    simp only [ht, le_refl, if_true]
  · simp only [fullMemoryVacuum, if_neg hs, zero_mul]

theorem full_memory_vacuum_pairing_zero_memory_mask
    {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    {M : G → ℕ} {B : ℕ} (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (F : ProductBoundedOrderedState P Z M B → ℂ) :
    (∑ s, (productMemoryWeight μ ν s : ℂ) * fullMemoryVacuum s *
      (if productTotalMemory s ≤ 0 then F s else 0)) =
    ∑ s, (productMemoryWeight μ ν s : ℂ) * fullMemoryVacuum s * F s := by
  apply sum_congr rfl
  intro s _
  rw [mul_assoc, fullMemoryVacuum_mul_zero_memory_mask, ← mul_assoc]

section

variable {J K G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  {M : G → ℕ} (S : K → ∀ g, Finset (Fin (M g)))
  (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
  (Δ D : ∀ k c, A k c → G → ℤ)
  {b B : ℕ} (h : b ≤ B)
  (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)

theorem full_permutation_mixed_cap_vacuum_pairing_le
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 < μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (hC : ∀ j g, q j / ρ ^ 2 + ((1 - q j) * (2 * V g) / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (steps : List (Option (J ⊕ K)))
    (phase : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1) :
    ‖∑ s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b,
      (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)) s : ℂ) *
        fullMemoryVacuum s *
          (fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps phase
              fullMemoryVacuum (productStateCapEmbed h s) -
            fullPermutationMixedPathAction n S b A Δ D ω μ q ρ V steps
              (fullPermutationMixedCapPhase n S A Δ D h ω μ q ρ V steps phase)
              fullMemoryVacuum s)‖ ^ 2 ≤
      ((2 : ℝ) ^ (b + 1 - fullMemoryEdgeCount steps * (T * Fintype.card G)))⁻¹ ^ 2 *
        (steps.map (fullDoubledGhostStepEnergy ρ v vmin vmax T (Fintype.card G))).prod *
        (∏ g, (∑ p, μ g p) ^ M g) ^ 2 := by
  let F : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b → ℂ :=
    fun s => fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps phase
        fullMemoryVacuum (productStateCapEmbed h s) -
      fullPermutationMixedPathAction n S b A Δ D ω μ q ρ V steps
        (fullPermutationMixedCapPhase n S A Δ D h ω μ q ρ V steps phase) fullMemoryVacuum s
  have hvac (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b) :
      fullMemoryVacuum (productStateCapEmbed h x) = fullMemoryVacuum x := rfl
  have he := full_permutation_mixed_cap_difference_energy_le n S A Δ D h ω μ q ρ V
    hω hωmass hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass hq0 hq1 hD hC T ht steps
    0 (Nat.zero_le _) phase hphase fullMemoryVacuum fullMemoryVacuum_symmetric
  simp only [hvac, Nat.sub_zero] at he
  have hE : finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fun s => if productTotalMemory s ≤ 0 then F s else 0) ≤
      (((2 : ℝ) ^ (b + 1 - fullMemoryEdgeCount steps * (T * Fintype.card G)))⁻¹ ^ 2 *
        (steps.map (fullDoubledGhostStepEnergy ρ v vmin vmax T (Fintype.card G))).prod) *
        finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
          (fullMemoryVacuum (P := P) (Z := fun g => UnrestrictedResidueParticle (n g)) (M := M) (B := b)) := by
    rw [fullMemoryVacuum_energy] at he ⊢
    exact he
  have hp := full_memory_vacuum_pairing_le_of_energy μ (fun g => unrestrictedResidueWeight (μ g))
    (fun g p => (hμ g p).le) (fun g z => (hμ g z.1).le) M b
    (fun s => if productTotalMemory s ≤ 0 then F s else 0) hE
  rw [full_memory_vacuum_pairing_zero_memory_mask] at hp
  exact hp

end

end Bounty
