               (Ps := fun s : ↥groupsᶜ => P s.val) (P := fun g : Fin M => P (e.symm g).val)
               (J := J) (ell := ell)
               (fun (s : ↥groupsᶜ) => hP s.val) (fun (g : Fin M) => hP (e.symm g).val)
