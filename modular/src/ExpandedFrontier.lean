section

/- Uniform localized absolute mass for the actual retained candidate cross-sum. -/

open Finset Filter Real

namespace Bounty

theorem exists_candidate_cross_character_localized_bound {c q Cz : ℝ}
    (hc : 0 < c) (hq0 : 0 ≤ q) (hq1 : q < 1) (hCz : 0 ≤ Cz) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ L : ℝ in atTop, ∀ (r jStar : ℕ)
      (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
      (take : Fin ((candidateQIndices c L).card*r) → Bool),
      take ((candidateAllocationOrder c L r).symm
        (candidateRoughSlot c L r jStar hr hj)) = false →
      ∀ (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ),
      (∀ slot p, p ∈ candidateQSlotChoices c L r jStar slot → ‖twist slot p‖ ≤ 1) →
      ∀ (A ρ : ℝ) (M H Zs : Finset ℕ) (α : ℕ → ℂ),
      (∀ m ∈ M, 0 < m) → (∀ m ∈ M, ‖α m‖ ≤ L^A) →
      ∀ (k : ℤ) (Z : ℝ) (ψ : ℝ → ℝ) (χ : DirichletCharacter ℂ (2*k.natAbs)),
      k ≠ 0 → (∀ z ∈ Zs, |ψ ((z:ℝ)/Z)| ≤ 1) →
      (∀ z ∈ Zs, 0 < z ∧ 0 < (z:ℤ)+k) →
      1 ≤ Z → log Z ≤ Cz*L → (∀ z ∈ Zs, (z:ℝ) ≤ 2*Z) → |(k:ℝ)| ≤ Z →
      (∑ y ∈ typeIICrossSlice M H Zs k,
        ‖(ψ ((y.1.2:ℝ)/Z) : ℂ) * typeIICrossCharacterAmplitude χ α
          (fun h => typeIIPhase ρ h * candidateRetainedComplexCoefficient c L q r jStar take twist h) y‖) ≤
        Z * L^(2*(A+C)+16) := by
  obtain ⟨C, hC, hbound⟩ := exists_candidate_retained_divisor_bound hc hq0 hq1
  refine ⟨C, hC, ?_⟩
  filter_upwards [hbound, eventually_localized_divisor_moment_cost hCz,
    eventually_gt_atTop (0 : ℝ)] with L hret hcost hL
  intro r jStar hr hj take hkeep twist htwist A ρ M H Zs α hM hα k Z ψ χ hk hψ hpos hZ hZlog hloc hksize
  let aH : ℕ → ℂ := fun h => typeIIPhase ρ h *
    candidateRetainedComplexCoefficient c L q r jStar take twist h
  let N : ℕ := ⌈3*Z⌉₊
  have haH : ∀ h ∈ H, h ≠ 0 → ‖aH h‖ ≤ L^C*(h.divisors.card : ℝ) := by
    intro h hh hh0
    dsimp only [aH]
    rw [norm_mul, typeIIPhase_norm, one_mul]
    exact hret r jStar hr hj take hkeep twist htwist h hh0
  have hN : ∀ z ∈ Zs, z ≤ N ∧ ((z:ℤ)+k).toNat ≤ N := by
    intro z hz
    have hceil : 3*Z ≤ (N:ℝ) := Nat.le_ceil _
    have hzR := hloc z hz
    have hkR := (abs_le.mp hksize).2
    constructor
    · exact_mod_cast (show (z:ℝ) ≤ (N:ℝ) by linarith)
    · have hzi : (z:ℤ)+k ≤ (N:ℤ) := by
        exact_mod_cast (show (((z:ℤ)+k:ℤ):ℝ) ≤ (N:ℝ) by push_cast; linarith)
      omega
  have hmoment := factorization_absolute_cross_moment Zs (fun z => z)
    (fun z => ((z:ℤ)+k).toNat) N M H α aH
    (A := L^A) (B := L^C) (by positivity) (by positivity) hα haH
    (by intro x hx y hy hxy; exact hxy)
    (by
      intro x hx y hy hxy
      have hx0 := (hpos x hx).2
      have hy0 := (hpos y hy).2
      change ((x:ℤ)+k).toNat = ((y:ℤ)+k).toNat at hxy
      omega)
    (fun z hz => Nat.ne_of_gt (hpos z hz).1)
    (by intro z hz; have := (hpos z hz).2; omega)
    (fun z hz => (hN z hz).1) (fun z hz => (hN z hz).2)
  have hpower : (L^A*L^C)^2 = L^(2*(A+C)) := by
    rw [show 2*(A+C) = (A+C)*(2:ℕ) by push_cast; ring,
      rpow_mul_natCast hL.le, rpow_add hL]
  calc
    _ ≤ ∑ z ∈ Zs, factorizationAbsoluteMass M H α aH z *
        factorizationAbsoluteMass M H α aH ((z:ℤ)+k).toNat :=
      typeII_cross_character_absolute_mass_le M H Zs k Z ψ α aH χ hM hk hψ hpos
    _ ≤ (L^A*L^C)^2*(N:ℝ)*(1+log (N:ℝ))^15 := hmoment
    _ = L^(2*(A+C))*((N:ℝ)*(1+log (N:ℝ))^15) := by rw [hpower]; ring
    _ ≤ L^(2*(A+C))*(Z*L^(16:ℝ)) :=
      mul_le_mul_of_nonneg_left (hcost Z hZ hZlog) (rpow_nonneg hL.le _)
    _ = Z*L^(2*(A+C)+16) := by rw [rpow_add hL]; ring


end Bounty
end

section

/- Exact normalized dyadic Fourier representation of the original off-diagonal energy. -/

open Finset MeasureTheory

namespace Bounty

noncomputable def typeIIDyadicCharacterIntegral (L U V E : ℝ) (k : ℤ)
    (M H Zs : Finset ℕ) (α aH : ℕ → ℂ) (T : Set (EuclideanSpace ℝ (Fin 3))) : ℂ :=
  normalizedCharacterAverage (2*k.natAbs) (fun χ =>
    ∑ j ∈ range (typeIISmoothDyadicCount L), ∫ ξ in T,
      typeIICrossCharacterFourierIntegrand 1 L U V E (typeIISmoothDyadicScale U V E j) k
        M H Zs typeIISmoothDyadic α aH χ ξ)

theorem typeII_dyadic_character_integral_zero (L U V E : ℝ)
    (M H Zs : Finset ℕ) (α aH : ℕ → ℂ) (T : Set (EuclideanSpace ℝ (Fin 3))) :
    typeIIDyadicCharacterIntegral L U V E 0 M H Zs α aH T = 0 := by
  simp [typeIIDyadicCharacterIntegral, normalizedCharacterAverage]

theorem typeII_real_character_slice_eq_dyadic_integral
    (L U V E : ℝ) (k : ℤ) (M H Zs : Finset ℕ) (α aH : ℕ → ℂ)
    (hL : 0 < L) (hU : 0 < U) (hV : 0 < V) (hE : 0 < E)
    (hUV : 4 ≤ U*V) (hM : ∀ m ∈ M, (m:ℝ) ∈ Set.Icc U (2*U)) :
    typeIIRealCharacterSlice M H Zs k
      (fun e n => typeIIEMajorant (L^88) (e/E) * typeIINMajorant (n/V)) α aH =
      typeIIDyadicCharacterIntegral L U V E k M H Zs α aH Set.univ := by
  classical
  by_cases hk : k = 0
  · subst k
    simp [typeIIRealCharacterSlice, typeII_dyadic_character_integral_zero]
  rw [typeIIRealCharacterSlice, dif_neg hk]
  unfold typeIIRealCharacterAverage typeIIDyadicCharacterIntegral normalizedCharacterAverage
  apply congrArg (fun z : ℂ => (1 / ((2*k.natAbs).totient : ℂ)) * z)
  apply sum_congr rfl
  intro χ hχ
  simpa only [Measure.restrict_univ] using
    typeII_majorant_character_dyadic_fourier L U V E k M H Zs α aH χ hL hU hV hE hUV hk hM

noncomputable def typeIIEnergyFourierIntegral (L U V E : ℝ) (B : ℕ)
    (M H : Finset ℕ) (α aH : ℕ → ℂ) (T : Set (EuclideanSpace ℝ (Fin 3))) : ℂ := by
  classical
  let M₀ := M.filter (fun m => α m ≠ 0)
  let Zs := Icc 0 (M₀.sup id * H.sup id)
  exact ∑ k ∈ Icc (-(B:ℤ)) B,
    typeIIDyadicCharacterIntegral L U V E k M₀ H Zs α aH T

theorem typeII_majorant_energy_eq_dyadic_fourier
    (M H : Finset ℕ) (α aH : ℕ → ℂ) {L U V E W : ℝ} {B : ℕ}
    (hL : 0 < L) (hU : 0 < U) (hV : 0 < V) (hE : 0 < E) (hUV : 4 ≤ U*V)
    (hM : ∀ m ∈ M, (m:ℝ) ∈ Set.Icc U (2*U))
    (hB : (2*U) / (2*(E/(2*L^88))) ≤ B) (hBW : (B:ℝ) ≤ W) (hW : 2 ≤ W)
    (hrough : ∀ m ∈ M, α m ≠ 0 → ∀ p ∈ m.primeFactors, W < (p:ℝ)) :
    typeIIOffDiagonalEnergy (Icc ⌈E/(2*L^88)⌉₊ ⌊2*E⌋₊)
      (Icc ⌈V/2⌉₊ ⌊3*V⌋₊) M H
      (fun e n => typeIIEMajorant (L^88) ((e:ℝ)/E) * typeIINMajorant ((n:ℝ)/V)) α aH =
      (typeIIEnergyFourierIntegral L U V E B M H α aH Set.univ).re := by
  classical
  rw [typeII_majorant_off_diagonal_bounded M H α aH hL hE hV
    (fun m hm => by exact_mod_cast hU.trans_le (hM m hm).1)
    (fun m hm => (hM m hm).2) hB hBW hW hrough]
  unfold typeIIEnergyFourierIntegral
  rw [Complex.re_sum]
  apply sum_congr rfl
  intro k hk
  rw [typeII_real_character_slice_eq_dyadic_integral L U V E k _ H _ α aH
    hL hU hV hE hUV (fun m hm => hM m (mem_filter.mp hm).1)]

end Bounty
end

section

/- Exact scale bounds for the finite smooth dyadic partition. -/

open Finset Filter Real

namespace Bounty

private theorem dyadic_ceil_power_le {x : ℝ} (hx : 1 ≤ x) :
    (2:ℝ)^⌈logb 2 x⌉₊ ≤ 2*x := by
  have hx0 : 0 < x := zero_lt_one.trans_le hx
  have ht : 0 ≤ logb 2 x := logb_nonneg (by norm_num) hx
  calc
    (2:ℝ)^⌈logb 2 x⌉₊ = (2:ℝ)^(⌈logb 2 x⌉₊:ℝ) := (rpow_natCast _ _).symm
    _ ≤ (2:ℝ)^(logb 2 x+1) := rpow_le_rpow_of_exponent_le (by norm_num)
      (Nat.ceil_lt_add_one ht).le
    _ = 2*x := by
      rw [rpow_add (by norm_num : (0:ℝ)<2), rpow_one,
        rpow_logb (by norm_num : (0:ℝ)<2) (by norm_num : (2:ℝ)≠1) hx0]
      ring

theorem typeII_smooth_dyadic_scale_mono_zero {U V E : ℝ}
    (hU : 0 < U) (hV : 0 < V) (hE : 0 < E) (j : ℕ) :
    typeIISmoothDyadicScale U V E 0 ≤ typeIISmoothDyadicScale U V E j := by
  unfold typeIISmoothDyadicScale
  simpa only [pow_zero, mul_one] using mul_le_mul_of_nonneg_left
    (one_le_pow₀ (show (1:ℝ)≤2 by norm_num) : (1:ℝ)≤2^j)
    (show 0 ≤ U^2*V/(16*E) by positivity)

theorem typeII_smooth_dyadic_scale_le {L U V E : ℝ} {j : ℕ}
    (hL : 1 ≤ L) (hU : 0 < U) (hV : 0 < V) (hE : 0 < E)
    (hj : j < typeIISmoothDyadicCount L) :
    typeIISmoothDyadicScale U V E j ≤ 24*U^2*V*L^88/E := by
  have hpow : 1 ≤ L^88 := one_le_pow₀ hL
  have hp := dyadic_ceil_power_le (show (1:ℝ)≤192*L^88 by linarith)
  have hj' : j ≤ ⌈logb 2 (192*L^88)⌉₊ := by
    unfold typeIISmoothDyadicCount at hj
    omega
  have hbase : 0 ≤ U^2*V/(16*E) := by positivity
  calc
    _ ≤ (U^2*V/(16*E))*((2:ℝ)^⌈logb 2 (192*L^88)⌉₊) :=
      mul_le_mul_of_nonneg_left (pow_le_pow_right₀ (by norm_num) hj') hbase
    _ ≤ (U^2*V/(16*E))*(2*(192*L^88)) := mul_le_mul_of_nonneg_left hp hbase
    _ = 24*U^2*V*L^88/E := by field_simp; ring

theorem typeII_smooth_dyadic_scale_sum_le {L U V E : ℝ}
    (hL : 1 ≤ L) (hU : 0 < U) (hV : 0 < V) (hE : 0 < E) :
    (∑ j ∈ range (typeIISmoothDyadicCount L), typeIISmoothDyadicScale U V E j) ≤
      48*U^2*V*L^88/E := by
  let n : ℕ := ⌈logb 2 (192*L^88)⌉₊
  have hbase : 0 ≤ U^2*V/(16*E) := by positivity
  have hn : n < typeIISmoothDyadicCount L := Nat.lt_succ_self n
  calc
    _ = (U^2*V/(16*E))*((2:ℝ)^(n+1)-1) := by
      simp only [typeIISmoothDyadicScale, ← mul_sum, typeIISmoothDyadicCount]
      rw [geom_sum_eq (by norm_num : (2:ℝ)≠1)]
      norm_num [n]
    _ ≤ (U^2*V/(16*E))*(2*(2:ℝ)^n) :=
      mul_le_mul_of_nonneg_left (by rw [pow_succ]; linarith) hbase
    _ = 2*typeIISmoothDyadicScale U V E n := by unfold typeIISmoothDyadicScale; ring
    _ ≤ 2*(24*U^2*V*L^88/E) := mul_le_mul_of_nonneg_left
      (typeII_smooth_dyadic_scale_le hL hU hV hE hn) (by norm_num)
    _ = 48*U^2*V*L^88/E := by ring

theorem eventually_typeII_smooth_dyadic_count_le_square :
    ∀ᶠ L : ℝ in atTop, (typeIISmoothDyadicCount L:ℝ) ≤ L^2 := by
  simpa only [typeIISmoothDyadicCount] using eventually_typeII_dyadic_count_le_square


end Bounty
end

section

/- The full-box B0 identity feeds directly into the actual smooth Cauchy energy. -/

open Finset

namespace Bounty

theorem candidate_retained_box_smooth_cauchy
    (c L : ℝ) (r jStar : ℕ) (P M N : Finset ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ)
    (E ν R U V AE AN : ℝ) (α β : ℕ → ℂ)
    (hL : 0 < L) (hE : 0 < E) (hU : 0 < U) (hV : 0 < V)
    (hP : ∀ p ∈ P, 0 < p) (hM : ∀ m ∈ M, (m:ℝ) ≤ 2*U)
    (hN : ∀ n ∈ N, V ≤ (n:ℝ) ∧ (n:ℝ) ≤ 2*V)
    (hR : 2*U*V ≤ R*Real.exp L)
    (hα : ∀ m, m ∉ M → α m=0) (hβ : ∀ n, n ∉ N → β n=0)
    (haE : ∀ e ∈ candidateB0TakenSupport c L r jStar take E,
      ‖candidateB0TakenCoefficient c L r jStar take
        (candidateAllocationFourierTwist c L r jStar take ξ) ν e‖ ≤ AE)
    (hβbound : ∀ n ∈ N, ‖β n‖ ≤ AN) :
    let H := candidateRetainedAllocationSupport c L r jStar P take
    let aH := candidateB0RetainedCoefficient c L (1/2) r jStar take
      (candidateAllocationFourierTwist c L r jStar take ξ) ν
    let EF := Icc ⌈E/(2*L^88)⌉₊ ⌊2*E⌋₊
    let NF := Icc ⌈V/2⌉₊ ⌊3*V⌋₊
    let η := fun e n : ℕ => typeIIEMajorant (L^88) ((e:ℝ)/E) * typeIINMajorant ((n:ℝ)/V)
    ‖candidateRetainedAllocationIntegrand c L (1/2) r jStar (Real.log E) P take
      (candidateBoxFiniteTest L E (Icc 1 ⌊R*Real.exp L⌋₊)
        (fun u => typeIIMellinPhase ν u * ∑ m ∈ (2*u+1).divisors, α m*β ((2*u+1)/m))) ξ‖^2 ≤
      ‖activeAllocationFourierWeight (candidateAllocationRadius r)
        (candidateAllocationActive c L r jStar) take ξ‖^2 *
      ((2*E*V*AE^2*AN^2) *
        (typeIIDiagonalEnergy EF NF M H η α aH + typeIIOffDiagonalEnergy EF NF M H η α aH)) := by
  dsimp only
  rw [candidate_retained_box_typeII c L (1/2) r jStar P M N take ξ E ν R U V α β
    hP hU.le hV.le hM (fun n hn => (hN n hn).2) hR hα hβ,
    norm_mul, norm_mul, candidate_allocation_fourier_scalar_norm, one_mul, mul_pow]
  have hc := typeII_actual_smooth_cauchy (candidateB0TakenSupport c L r jStar take E) N M
    (candidateRetainedAllocationSupport c L r jStar P take)
    (candidateB0TakenCoefficient c L r jStar take
      (candidateAllocationFourierTwist c L r jStar take ξ) ν) β α
    (candidateB0RetainedCoefficient c L (1/2) r jStar take
      (candidateAllocationFourierTwist c L r jStar take ξ) ν)
    hL hE hV (fun e he => (mem_filter.mp he).2) hN haE hβbound
  exact (mul_le_mul_of_nonneg_right hc (sq_nonneg _)).trans_eq (mul_comm _ _)

end Bounty
end

section

/- Uniform Lyapunov rows for an original owner, paying one common atom bound per selected child. -/

open Finset Classical

namespace Bounty

section Owner
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
    [∀ g, DecidableEq (P g)] {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
    (Δ D : ∀ k c, A k c → Fin N → ℤ) (ω : ∀ k c, A k c → ℝ)
    (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ v vmin : ℝ) (V η : Fin N → ℝ) (β : ℝ)
    (steps : List (Option (J ⊕ K)))
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))

theorem full_mixed_common_owner_stage_row_le
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hη : ∀ g, 0 ≤ η g) (hμatom : ∀ g p, μ g p ≤ η g)
    (hghostAtom : ∀ j g, (|(1 - q j) * V g / ρ| * η g) * v ≤ β)
    (hedgeAtom : ∀ g, η g ≤ β)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : ∀ g, vmin ≤ V g)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (u : Fin steps.length) (tag : Option (J ⊕ K)) (htag : steps.get u = tag)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P)) :
    let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
    (∑ e : FullPermutationMixedEvent n S B A Δ D tag s,
      |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V tag s e| *
        fullMixedCommonForestHistoryGain n S B A Δ D steps code u.val tag s e history *
        productLengthLyapunov v (fullPermutationMixedEventTarget n S B A Δ D tag s e)) ≤
      (β ^ (∑ g, fullMixedCommonSelectedCount M B steps code u g) *
        fullMixedLengthRowFactor μ q ρ v vmin V T tag) * productLengthLyapunov v s := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
  have hv0 := (zero_lt_one.trans hv).le
  have hH := productLengthLyapunov_nonneg hv0 s
  cases tag with
  | none =>
    simp_rw [full_mixed_common_forest_history_gain_none n S B A Δ D steps code u htag, mul_one]
    simp only [full_mixed_common_none_selected_count B steps code u htag, sum_const_zero, pow_zero, one_mul]
    exact full_permutation_mixed_length_row_le n S B A Δ D ω μ q ρ v vmin V
      hω hωmass hμ hmass hq0 hq1 hρ0 hρ1 hv hvmin hV hD T ht none s
  | some tag =>
    cases tag with
    | inl j =>
      have hb := full_mixed_common_ghost_original_stage_le n S B A Δ D ω μ q ρ v V steps u s history code j htag
        η hη hμ hμatom (zero_lt_one.trans hv) (hq0 j) (hq1 j) hρ0 (hD j)
      have hp := finite_prod_pow_le_common_power
        (fun g => (|(1 - q j) * V g / ρ| * η g) * v)
        (fullMixedCommonSelectedCount M B steps code u) β
        (fun g => mul_nonneg (mul_nonneg (abs_nonneg _) (hη g)) hv0) (hghostAtom j)
      exact hb.trans (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right hp (prod_nonneg fun _ _ => (Real.exp_pos _).le)) hH)
    | inr k =>
      have hb := full_mixed_common_edge_original_stage_le n S B A Δ D ω μ q ρ v V steps u s history code k htag
        η hη hμ hμatom hv (hω k) (hωmass k) vmin hρ0 hρ1 hvmin hV hmass T (ht k)
      have hp := finite_prod_pow_le_common_power η (fullMixedCommonSelectedCount M B steps code u) β hη hedgeAtom
      have hh := hb.trans (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hp hH)
        (pow_nonneg (unrestricted_edge_row_bound_nonneg hρ1 hv0 T) N))
      simpa only [fullMixedLengthRowFactor, Fintype.card_fin, mul_assoc, mul_left_comm, mul_comm] using hh

end Owner
end Bounty
end

section

/- The original memory coefficient and complete selected history agree, including zero rows. -/

open Finset
open scoped Classical
namespace Bounty

section Coefficient
variable {I : Type*} {N J ell r : ℕ} {P : Fin N → Finset ℕ}
  (V : Fin N → ℝ) (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
  (ζ : ℕ → I → ℝ)
  (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
    PhysicalAuxLabels P (C i) → ℂ)
  (pattern : Fin (r + 1) → patterns)
  (d : PhysicalSelectedData P ell (fun j => C (pattern j).val))

theorem physical_selected_memory_walk_unrestricted :
    physicalMemoryWalkScalar V patterns C ζ K
      (finitePathLabels ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d⟩).2)
      (finitePathMarks ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d⟩).1
        ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d⟩).2) (r + 1) =
    (if ∀ j : Fin (r + 1), physicalListAdmissible (C (pattern j).val) (d.1 j)
      (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc))
      (physicalPermuteLabels (d.2.2.2 j) (d.2.1 j.succ)) then (1 : ℂ) else 0) *
    (∏ i ∈ range (2 * (r + 1) + 1), physicalSelectedCoarseScalar (fun j => C (pattern j).val)
      d.1 d.2.1 d.2.2.1 (fun j _ a => physicalAuxMass V (C (pattern j).val) a) i) *
    physicalSelectedCoefficient (fun j => C (pattern j).val)
      (fun j => ζ ((r + 1) - 1 - j.val) (pattern j).val)
      (fun j => K ((r + 1) - 1 - j.val) (pattern j).val) d := by
  by_cases hlist : ∀ j : Fin (r + 1), physicalListAdmissible (C (pattern j).val) (d.1 j)
    (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc))
    (physicalPermuteLabels (d.2.2.2 j) (d.2.1 j.succ))
  · simp only [if_pos hlist, one_mul]
    exact physical_selected_memory_walk_scalar_factor V patterns C ζ K pattern d hlist
  · rw [if_neg hlist, zero_mul, zero_mul]
    push Not at hlist
    obtain ⟨j, hj⟩ := hlist
    rw [physicalMemoryWalkScalar, ← Fin.prod_univ_eq_prod_range]
    apply Finset.prod_eq_zero (mem_univ j)
    have hs := congrFun (physical_selected_inverse_finite_path_marks patterns C pattern d) j.castSucc
    have ht := congrFun (physical_selected_inverse_finite_path_marks patterns C pattern d) j.succ
    dsimp only [Fin.val_castSucc, Fin.val_succ] at hs ht
    rw [hs, ht]
