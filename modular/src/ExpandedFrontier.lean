theorem eventually_physical_free_factor_subexponential {A s ε : ℝ}
    (hA : 0 ≤ A) (hs : s < 1) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ (G : Type*) [Fintype G] (P : G → Finset ℕ)
      (J : ℕ) (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C),
      (∀ g p, p ∈ P g → (p : ℝ) ≤ Real.exp (L^s)) →
      (J*Fintype.card G : ℕ) ≤ A*Real.log L →
      (physicalFreeFactor C aux : ℝ) ≤ Real.exp (ε*L) := by
  filter_upwards [eventually_scaled_log_sublinear hA hs hε,
    eventually_ge_atTop (0 : ℝ)] with L hb hL
  intro G _ P J C aux hp hslots
  apply (physical_free_factor_exp_bound C aux (Real.rpow_nonneg hL s) hp).trans
  apply Real.exp_le_exp.mpr
  have hslot : L^s*((J*Fintype.card G : ℕ) : ℝ) ≤ A*L^s*Real.log L := by
    simpa only [mul_assoc, mul_left_comm] using
      mul_le_mul_of_nonneg_left hslots (Real.rpow_nonneg hL s)
  exact hslot.trans hb

