section

/- Large least-prime factors force prime cofactors in the balanced pair window. -/

namespace Bounty

open Finset Filter Real
open scoped Topology

theorem cofactor_prime_of_product_lt_cube {p m : ℕ}
    (hp : p.Prime) (hpm : p ≤ m)
    (hrough : ∀ q ∈ m.primeFactors, p ≤ q) (hprod : p*m < p^3) : m.Prime := by
  have hm0 : 0 < m := hp.pos.trans_le hpm
  have hm1 : m ≠ 1 := by have hh := hp.two_le.trans hpm; omega
  have hmin : p ≤ m.minFac := hrough m.minFac
    (Nat.mem_primeFactors.mpr ⟨Nat.minFac_prime hm1,Nat.minFac_dvd m,hm0.ne'⟩)
  by_contra hmprime
  have hsq : p^2 ≤ m := (Nat.pow_le_pow_left hmin 2).trans (Nat.minFac_sq_le_self hm0 hmprime)
  have hcube : p^3 ≤ p*m := calc
    p^3 = p*(p^2) := by ring
    _ ≤ p*m := Nat.mul_le_mul_left p hsq
  exact (not_lt_of_ge hcube) hprod

theorem eventually_large_least_factor_balanced_prime {κ : ℝ}
    (hκ : 0 < κ) (hκmax : κ ≤ 1/50) :
    ∀ᶠ L : ℝ in atTop, ∀ p m : ℕ, p.Prime → p ≤ m →
      (∀ q ∈ m.primeFactors, p ≤ q) →
      exp (((1/2 : ℝ)-κ)*L) ≤ (p : ℝ) →
      exp L ≤ ((p*m : ℕ) : ℝ) → ((p*m : ℕ) : ℝ) ≤ 33*exp L →
      m.Prime ∧ balancedPairWindow κ L (p,m) := by
  have hgap : 0 < (1/2 : ℝ)-3*κ := by linarith
  have htκ : Tendsto (fun L : ℝ => exp (κ*L)) atTop atTop :=
    tendsto_exp_atTop.comp (tendsto_id.const_mul_atTop hκ)
  have htc : Tendsto (fun L : ℝ => exp (((1/2 : ℝ)-3*κ)*L)) atTop atTop :=
    tendsto_exp_atTop.comp (tendsto_id.const_mul_atTop hgap)
  filter_upwards [eventually_gt_atTop (0 : ℝ), htκ.eventually_ge_atTop 33,
    htc.eventually_gt_atTop 33] with L hL hκL hcL
  intro p m hp hpm hrough hpLo hprodLo hprodHi
  have hp0 : (0 : ℝ) < p := Nat.cast_pos.mpr hp.pos
  have hm0 : (0 : ℝ) ≤ m := Nat.cast_nonneg _
  have hpmR : (p : ℝ) ≤ m := Nat.cast_le.mpr hpm
  have hprodR : (p : ℝ)*(m : ℝ) ≤ 33*exp L := by exact_mod_cast hprodHi
  have hcubeR : ((p*m : ℕ) : ℝ) < (p : ℝ)^3 := calc
    _ ≤ 33*exp L := hprodHi
    _ < exp (((1/2 : ℝ)-3*κ)*L)*exp L := mul_lt_mul_of_pos_right hcL (exp_pos _)
    _ = (exp (((1/2 : ℝ)-κ)*L))^3 := by
      rw [← exp_add, ← exp_nat_mul]
      congr 1
      ring
    _ ≤ (p : ℝ)^3 := by gcongr
  have hcube : p*m < p^3 := by exact_mod_cast hcubeR
  have hmprime := cofactor_prime_of_product_lt_cube hp hpm hrough hcube
  have hmUp : (m : ℝ) ≤ exp (((1/2 : ℝ)+2*κ)*L) := by
    apply (mul_le_mul_iff_right₀ (exp_pos (((1/2 : ℝ)-κ)*L))).mp
    calc
      exp (((1/2 : ℝ)-κ)*L)*(m : ℝ) ≤ (p : ℝ)*(m : ℝ) :=
        mul_le_mul_of_nonneg_right hpLo hm0
      _ ≤ 33*exp L := hprodR
      _ ≤ exp (κ*L)*exp L := mul_le_mul_of_nonneg_right hκL (exp_pos _).le
      _ = exp (((1/2 : ℝ)-κ)*L)*exp (((1/2 : ℝ)+2*κ)*L) := by
        rw [← exp_add, ← exp_add]
        congr 1
        ring
  have hpLower : exp (((1/2 : ℝ)-2*κ)*L) ≤ (p : ℝ) :=
    (exp_le_exp.mpr (mul_le_mul_of_nonneg_right (by linarith) hL.le)).trans hpLo
  exact ⟨hmprime,hpLower,hpmR.trans hmUp,hpLower.trans hpmR,hmUp,hprodLo,hprodHi⟩

theorem arithmetic_product_window_one_pos (L : ℝ) {u : ℕ}
    (hu : u ∈ arithmeticProductWindow 1 (exp L)) : 0 < u := by
  have hh := ((mem_arithmeticProductWindow_iff (by norm_num : (1 : ℕ) ≠ 0) (exp L)).mp hu).1
  simp only [one_mul] at hh
  exact Nat.cast_pos.mp ((exp_pos L).trans hh)

theorem shifted_buchstab_pair_arithmetic_window_bounds {L z : ℝ} (hL : 0 ≤ L)
    {v : ℕ × ℕ} (hv : v ∈ shiftedBuchstabPairs (arithmeticProductWindow 1 (exp L)) z) :
    2*exp L < ((v.1*v.2 : ℕ) : ℝ) ∧ ((v.1*v.2 : ℕ) : ℝ) ≤ 33*exp L := by
  obtain ⟨hp,hpm,hidx,hprod,hz,hrough⟩ := shifted_buchstab_pair_properties
    (arithmeticProductWindow 1 (exp L)) z (fun u hu => arithmetic_product_window_one_pos L hu) hv
  have hrange := (mem_arithmeticProductWindow_iff (by norm_num : (1 : ℕ) ≠ 0) (exp L)).mp hidx
  simp only [one_mul] at hrange
  have hprodR : ((v.1*v.2 : ℕ) : ℝ) = 2*(shiftedPairIndex v : ℝ)+1 := by exact_mod_cast hprod
  have he : 1 ≤ exp L := one_le_exp hL
  constructor <;> linarith

theorem eventually_shifted_buchstab_balanced_prime {κ : ℝ}
    (hκ : 0 < κ) (hκmax : κ ≤ 1/50) :
    ∀ᶠ L : ℝ in atTop, ∀ z : ℝ, ∀ v ∈ shiftedBuchstabPairs (arithmeticProductWindow 1 (exp L)) z,
      exp (((1/2 : ℝ)-κ)*L) ≤ (v.1 : ℝ) →
      v.2.Prime ∧ balancedPairWindow κ L v := by
  filter_upwards [eventually_large_least_factor_balanced_prime hκ hκmax,
    eventually_ge_atTop (0 : ℝ)] with L hbal hL
  intro z v hv hlo
  obtain ⟨hp,hpm,hidx,hprod,hz,hrough⟩ := shifted_buchstab_pair_properties
    (arithmeticProductWindow 1 (exp L)) z (fun u hu => arithmetic_product_window_one_pos L hu) hv
  obtain ⟨hloProd,hhiProd⟩ := shifted_buchstab_pair_arithmetic_window_bounds hL hv
  exact hbal v.1 v.2 hp hpm hrough hlo (by linarith [exp_pos L]) hhiProd

end Bounty

/- Public declaration closure audit. -/
end

