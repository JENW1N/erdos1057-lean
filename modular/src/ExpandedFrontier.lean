theorem finite_flatten_tail_energy_le {G : Type*} [Fintype G] [DecidableEq G]
    {I X : G → Type*} [∀ g, Fintype (I g)] [∀ g, DecidableEq (I g)]
    [∀ g, Fintype (X g)]
    (μ : ∀ g, X g → ℝ) (hμ : ∀ g x, 0 ≤ μ g x) (hmass : ∀ g, ∑ x, μ g x = 1)
    (B : ∀ g, Finset (I g)) (f : (∀ g, I g → X g) → ℂ) :
    finiteWeightedEnergy (finiteProductWeight (fun a : Sigma I => μ a.1))
        (finiteCoordinateComponent (fun a : Sigma I => μ a.1) ∅
          (Finset.univ.sigma B).toList (finiteGroupFlattenFunction f)) ≤
      finiteWeightedEnergy
        (finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g))) f := by
  have h := finite_coordinate_averaging_energy_le
    (fun a : Sigma I => μ a.1) (fun a x => hμ a.1 x) (fun a => hmass a.1)
    (Finset.univ.sigma B) (finiteGroupFlattenFunction f)
  have heq : finiteWeightedEnergy (finiteProductWeight (fun a : Sigma I => μ a.1))
      (finiteGroupFlattenFunction f) =
      finiteWeightedEnergy
        (finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g))) f := by
    convert finite_group_flatten_energy μ f using 1 <;> congr 1 <;> exact Subsingleton.elim _ _
  exact h.trans_eq heq

theorem finite_flatten_tail_norm_le {G : Type*} [Fintype G] [DecidableEq G]
    {I X : G → Type*} [∀ g, Fintype (I g)] [∀ g, DecidableEq (I g)]
    [∀ g, Fintype (X g)]
    (μ : ∀ g, X g → ℝ) (hμ : ∀ g x, 0 ≤ μ g x) (hmass : ∀ g, ∑ x, μ g x = 1)
    (B : ∀ g, Finset (I g)) (f : (∀ g, I g → X g) → ℂ) :
    Real.sqrt (finiteWeightedEnergy (finiteProductWeight (fun a : Sigma I => μ a.1))
        (finiteCoordinateComponent (fun a : Sigma I => μ a.1) ∅
          (Finset.univ.sigma B).toList (finiteGroupFlattenFunction f))) ≤
      Real.sqrt (finiteWeightedEnergy
        (finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g))) f) :=
  Real.sqrt_le_sqrt (finite_flatten_tail_energy_le μ hμ hmass B f)
end

