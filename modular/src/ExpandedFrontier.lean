        (z (Fin.last (2 * n + 1)) p) : ℝ) : ℂ) *
      (((∏ p, ghostPhaseRunInitial (physicalGroupPhaseActivity (x 0).2.val g p)
        (β p) V (z 0 p) : ℝ) : ℂ) *
        ∏ j : Fin (2 * n + 1), globalBirthRawStepKernel
          (physicalGroupPermutedFiniteStep C aux k x σ τ hadm hP hdis g hk β η V ρ hV cap j.val)
          (z j.succ) (z j.castSucc)) := by
  have h := global_birth_weighted_empty_history_product (physicalGroupAtomicActivity x g)
    (physicalGroupPermutedFiniteStep C aux k x σ τ hadm hP hdis g hk β η V ρ hV cap)
    (fun p => β p / V) (2 * n + 1)
  simpa only [physicalGroupPermutedFiniteRawHistory, physical_group_atomic_activity_initial,
    physical_group_atomic_activity_terminal, physical_group_initial_tilt_eq_active,
    ghost_phase_run_initial_eq_tilted] using h

end PhysicalPath
end

section
open Finset
open scoped Classical
section PhysicalPath
variable {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell n : ℕ}
  (C : Fin n → G → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations G J ell)
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hcompat : ∀ j : Fin n, ∀ g s t,
    ((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val =
      ((physicalPermuteLabels (τ j) (L j.succ)) g t).val →
    (((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val : ℤ) ∣
      k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ)) (g : G)
  (hk : ∀ j : Fin n, ∀ s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : ↥(P g) → ℝ) (η : Fin (n + 1) → ℝ) (V ρ : ℝ) (hV : V ≠ 0) (cap : ℕ)

/-- The activity at each actual vertex of the finite physical path. -/
def physicalGroupBareFiniteActivity (j : Fin (n + 1)) : ↥(P g) → Bool :=
  physicalGroupPhaseActivity (L j) g

/-- All visits use the zero hit in their own moving frame. -/
noncomputable def physicalGroupBareFiniteVisit (j : Fin (n + 1)) :
    GlobalBirthRawStep (R := fun p : ↥(P g) => ZMod p.val)
      (physicalGroupBareFiniteActivity L g j) (physicalGroupBareFiniteActivity L g j) :=
  physicalGroupRawVisit (L j) g β (η j) V ρ hV cap

/-- Each edge uses its start offset and actual permuted unshared slot lists. -/
noncomputable def physicalGroupBareFiniteEdge (j : Fin n) :
    GlobalBirthRawStep (R := fun p : ↥(P g) => ZMod p.val)
      (physicalGroupBareFiniteActivity L g j.castSucc) (physicalGroupBareFiniteActivity L g j.succ) :=
  physicalGroupPermutedBareRawEdge (C j) (aux j) (k j)
    (L j.castSucc) (L j.succ) (a j.castSucc) (σ j) (τ j)
    (hlist j) hP hdis (hcompat j) g (hk j) β ρ V cap

/-- The extended atomic activity is used only through cut 2*n+1. -/
def physicalGroupBareAtomicActivity (i : ℕ) : ↥(P g) → Bool :=
  globalBirthFiniteActivity (physicalGroupBareFiniteActivity L g) (i / 2)

/-- Interleave n+1 physical visits with precisely n physical edges. -/
noncomputable def physicalGroupBareFiniteStep (i : ℕ) :
    GlobalBirthRawStep (R := fun p : ↥(P g) => ZMod p.val)
      (physicalGroupBareAtomicActivity L g i) (physicalGroupBareAtomicActivity L g (i + 1)) :=
  globalBirthFiniteAlternatingStep (physicalGroupBareFiniteActivity L g)
    (physicalGroupBareFiniteVisit L g β η V ρ hV cap)
    (physicalGroupBareFiniteEdge C aux k L a σ τ hlist hP hdis hcompat g hk β V ρ cap) i

omit [Fintype G] in
theorem physical_group_bare_atomic_activity_initial :
    physicalGroupBareAtomicActivity L g 0 = physicalGroupPhaseActivity (L 0) g := by
  simpa only [physicalGroupBareAtomicActivity, Nat.zero_div, physicalGroupBareFiniteActivity, Fin.val_zero] using
    (global_birth_finite_activity_at (physicalGroupBareFiniteActivity L g) (0 : Fin (n + 1)))

omit [Fintype G] in
theorem physical_group_bare_atomic_activity_terminal :
    physicalGroupBareAtomicActivity L g (2 * n + 1) =
      physicalGroupPhaseActivity (L (Fin.last n)) g := by
  unfold physicalGroupBareAtomicActivity
  rw [show (2 * n + 1) / 2 = n by omega]
  exact global_birth_finite_activity_tail (physicalGroupBareFiniteActivity L g) n le_rfl

theorem physical_group_bare_finite_visit_row (j : Fin (n + 1))
    (F : Finset ↥(P g) → FiniteOrderedTuple (Σ p : ↥(P g), ZMod p.val) → ℂ)
    (H : Finset ↥(P g)) (q : FiniteOrderedTuple (Σ p : ↥(P g), ZMod p.val)) :
    globalBirthRawStepRow
      (physicalGroupBareFiniteStep C aux k L a σ τ hlist hP hdis hcompat g hk β η V ρ hV cap (2 * j.val)) F H q =
      globalBirthGhostVisitRawRow (fun _ => 0) β (η j) V ρ cap H q.2 F := by
  exact global_birth_finite_alternating_row_even (physicalGroupBareFiniteActivity L g)
    (physicalGroupBareFiniteVisit L g β η V ρ hV cap)
    (physicalGroupBareFiniteEdge C aux k L a σ τ hlist hP hdis hcompat g hk β V ρ cap) j F H q

theorem physical_group_bare_finite_edge_row (j : Fin n)
    (F : Finset ↥(P g) → FiniteOrderedTuple (Σ p : ↥(P g), ZMod p.val) → ℂ)
    (H : Finset ↥(P g)) (q : FiniteOrderedTuple (Σ p : ↥(P g), ZMod p.val)) :
    globalBirthRawStepRow
      (physicalGroupBareFiniteStep C aux k L a σ τ hlist hP hdis hcompat g hk β η V ρ hV cap (2 * j.val + 1)) F H q =
      globalBirthRawStepRow
        (physicalGroupPermutedBareRawEdge (C j) (aux j) (k j)
          (L j.castSucc) (L j.succ) (a j.castSucc) (σ j) (τ j)
          (hlist j) hP hdis (hcompat j) g (hk j) β ρ V cap) F H q :=
  global_birth_finite_alternating_row_odd (physicalGroupBareFiniteActivity L g)
    (physicalGroupBareFiniteVisit L g β η V ρ hV cap)
    (physicalGroupBareFiniteEdge C aux k L a σ τ hlist hP hdis hcompat g hk β V ρ cap) j F H q

variable [∀ p : ↥(P g), NeZero p.val]

/-- The literal finite physical-group memory history starts with no pending
memory and ends with the same condition, retaining its full born ledger. -/
noncomputable def physicalGroupBareFiniteRawHistory : ℂ :=
  globalBirthRawHistory (physicalGroupBareAtomicActivity L g)
    (physicalGroupBareFiniteStep C aux k L a σ τ hlist hP hdis hcompat g hk β η V ρ hV cap) (2 * n + 1)
    (fun _ q => if q.1 = 0 then 1 else 0)
    (ghostPhaseActivitySupport (physicalGroupBareAtomicActivity L g 0))
    (globalBirthEmptyMemory (R := fun p : ↥(P g) => ZMod p.val))

/-- Exact full trace of a finite physical path. Source/target slot equations,
shared residue compatibility and the visit-edge schedule are now supplied by
physical data; they are not separate phase-history hypotheses. -/
theorem physical_group_bare_finite_raw_history_trace :
    ((∏ p, if physicalGroupBareAtomicActivity L g 0 p then β p else 1 : ℝ) : ℂ) *
      physicalGroupBareFiniteRawHistory C aux k L a σ τ hlist hP hdis hcompat g hk β η V ρ hV cap =
    ∑ z : Fin (2 * n + 2) → (p : ↥(P g)) → GhostPhaseState (ZMod p.val),
      ((∏ p, ghostPhaseTerminal (physicalGroupBareAtomicActivity L g (2 * n + 1) p)
        (z (Fin.last (2 * n + 1)) p) : ℝ) : ℂ) *
      (((∏ p, ghostPhaseInitial (physicalGroupBareAtomicActivity L g 0 p) (β p) (z 0 p) : ℝ) : ℂ) *
        ∏ j : Fin (2 * n + 1), globalBirthRawStepKernel
          (physicalGroupBareFiniteStep C aux k L a σ τ hlist hP hdis hcompat g hk β η V ρ hV cap j.val)
          (z j.succ) (z j.castSucc)) :=
  global_birth_weighted_empty_history_product (physicalGroupBareAtomicActivity L g)
    (physicalGroupBareFiniteStep C aux k L a σ τ hlist hP hdis hcompat g hk β η V ρ hV cap) β (2 * n + 1)

/-- The fully normalized initial/terminal trace for one physical prime group.
Both endpoint permutations remain in the edge data. The initial slot measure
is exactly beta/V on each of the J+ell slots, with no extra normalization. -/
theorem physical_group_bare_normalized_history_trace :
    ((∏ s : PhysicalSlots J ell, β ((L 0) g s) / V : ℝ) : ℂ) *
      physicalGroupBareFiniteRawHistory C aux k L a σ τ hlist hP hdis hcompat g hk β η V ρ hV cap =
    ∑ z : Fin (2 * n + 2) → (p : ↥(P g)) → GhostPhaseState (ZMod p.val),
      ((∏ p, ghostPhaseTerminal (physicalGroupPhaseActivity (L (Fin.last n)) g p)
        (z (Fin.last (2 * n + 1)) p) : ℝ) : ℂ) *
      (((∏ p, ghostPhaseRunInitial (physicalGroupPhaseActivity (L 0) g p)
        (β p) V (z 0 p) : ℝ) : ℂ) *
        ∏ j : Fin (2 * n + 1), globalBirthRawStepKernel
          (physicalGroupBareFiniteStep C aux k L a σ τ hlist hP hdis hcompat g hk β η V ρ hV cap j.val)
          (z j.succ) (z j.castSucc)) := by
  have h := global_birth_weighted_empty_history_product (physicalGroupBareAtomicActivity L g)
    (physicalGroupBareFiniteStep C aux k L a σ τ hlist hP hdis hcompat g hk β η V ρ hV cap)
    (fun p => β p / V) (2 * n + 1)
  simpa only [physicalGroupBareFiniteRawHistory, physical_group_bare_atomic_activity_initial,
    physical_group_bare_atomic_activity_terminal, physical_group_initial_tilt_eq_active,
    ghost_phase_run_initial_eq_tilted] using h

end PhysicalPath
end

section
open Finset Filter
open scoped Topology
/-- For any positive smoothness exponent, the explicit candidate has large
weighted mass, subexponential pointwise size, controlled prime factors, and
large nonzero support. This does not assert primality of the shifted values. -/
theorem exists_wide_candidate_construction {δ q : ℝ} (hδ : 0 < δ)
    (hq0 : 0 ≤ q) (hq1 : q < 1) :
    ∃ r : ℕ, ∃ c C : ℝ, ∃ J : ℕ,
      0 < r ∧ 0 < c ∧ 0 ≤ C ∧ (11/5 : ℝ) * (r : ℝ) * c = 1 ∧ (6/5 : ℝ) * c ≤ δ ∧
      ∀ jStar : ℕ, J < jStar → ∀ eps : ℝ, 0 < eps → ∀ᶠ L : ℝ in atTop,
        1 ≤ L ∧
        Real.exp L * L^(-C) ≤ candidateCoefficientWindowMass c L q r jStar ∧
        (∀ u : ℕ, 0 ≤ candidateCoefficient c L q r jStar u) ∧
        (∀ u : ℕ, (u : ℝ) ≤ 16 * Real.exp L →
          candidateCoefficient c L q r jStar u ≤ Real.exp ((2 * Real.log 2 + 1) * Real.sqrt L)) ∧
        (∀ u : ℕ, candidateCoefficient c L q r jStar u ≠ 0 →
          ∀ p ∈ u.primeFactors, L^20 < (p : ℝ) ∧ (p : ℝ) ≤ Real.exp (δ * L)) ∧
        Real.exp ((1 - eps) * L) ≤ (candidateCoefficientSupport c L q r jStar).card := by
  obtain ⟨r, c, hr, hc, hcenter, hsmall⟩ := exists_candidate_scale_for_prime_bound hδ
  obtain ⟨C, hC, J₁, hmass⟩ := exists_candidate_coefficient_mass_polynomial_lower hc hr hq0 hq1 hcenter
  obtain ⟨J₂, hcount⟩ := exists_candidate_support_card_lower hc hr hq0 hq1 hcenter
  refine ⟨r, c, C, max J₁ J₂, hr, hc, hC, hcenter, hsmall, ?_⟩
  intro jStar hj eps heps
  have hj₁ : J₁ < jStar := lt_of_le_of_lt (le_max_left _ _) hj
  have hj₂ : J₂ < jStar := lt_of_le_of_lt (le_max_right _ _) hj
  filter_upwards [hmass jStar hj₁, hcount jStar hj₂ eps heps,
    eventually_candidate_coefficient_le_exp_sqrt hc hr hq0 hq1,
    eventually_candidate_coefficient_primeFactors_range hc hsmall,
    eventually_ge_atTop (1 : ℝ)] with L hm hn hp hs hL
  exact ⟨hL, hm, fun u => candidate_coefficient_nonneg c L hq0 r jStar u,
    hp jStar, hs q r jStar, hn⟩
end

section
open Finset
open scoped Classical
theorem physical_marked_primes_permute {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (σ : PhysicalPermutations G J ell)
    (L : PhysicalMarkLists P J ell) :
    physicalMarkedPrimes (physicalPermuteLabels σ L) = physicalMarkedPrimes L := by
  ext p
  simp only [mem_physical_marked_primes, physical_group_marks_permute]

section ResiduePath
variable {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell n : ℕ}
  (C : Fin n → G → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations G J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (ζ : ∀ p : PhysicalPrime P, ZMod p.2.val)
  (hmarks : ∀ j : Fin (n + 1), ∀ p ∈ physicalMarkedPrimes (L j),
    ζ p = -(a j : ZMod p.2.val))

include hstep hmarks in
theorem physical_group_residue_path_compatibility (j : Fin n) :
    ∀ g s t,
    ((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val =
      ((physicalPermuteLabels (τ j) (L j.succ)) g t).val →
    (((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val : ℤ) ∣
      k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ) := by
  apply physical_bare_step_compatibility_of_residues (C j) (aux j) (k j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)) ζ (a j.castSucc)
  · simpa only [physical_marked_primes_permute] using hmarks j.castSucc
  · simpa only [physical_marked_primes_permute, ← hstep j] using hmarks j.succ

variable
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (g : G)
  (hk : ∀ j : Fin n, ∀ s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : ↥(P g) → ℝ) (η : Fin (n + 1) → ℝ) (V ρ : ℝ) (hV : V ≠ 0) (cap : ℕ)

noncomputable def physicalGroupResidueFiniteStep (i : ℕ) :
    GlobalBirthRawStep (R := fun p : ↥(P g) => ZMod p.val)
      (physicalGroupBareAtomicActivity L g i) (physicalGroupBareAtomicActivity L g (i + 1)) :=
  physicalGroupBareFiniteStep C aux k L a σ τ hlist hP hdis
    (physical_group_residue_path_compatibility C aux k L a σ τ hstep ζ hmarks)
    g hk β η V ρ hV cap i

theorem physical_group_residue_finite_visit_row (j : Fin (n + 1))
    (F : Finset ↥(P g) → FiniteOrderedTuple (Σ p : ↥(P g), ZMod p.val) → ℂ)
    (H : Finset ↥(P g)) (q : FiniteOrderedTuple (Σ p : ↥(P g), ZMod p.val)) :
    globalBirthRawStepRow
      (physicalGroupResidueFiniteStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis
        g hk β η V ρ hV cap (2 * j.val)) F H q =
    globalBirthGhostVisitRawRow (fun _ => 0) β (η j) V ρ cap H q.2 F :=
  physical_group_bare_finite_visit_row C aux k L a σ τ hlist hP hdis
    (physical_group_residue_path_compatibility C aux k L a σ τ hstep ζ hmarks)
    g hk β η V ρ hV cap j F H q

/-- The moving displacement is exactly the difference between adjacent
offsets of the same residue path. Both endpoint permutations are retained. -/
theorem physical_group_residue_finite_edge_row (j : Fin n)
    (F : Finset ↥(P g) → FiniteOrderedTuple (Σ p : ↥(P g), ZMod p.val) → ℂ)
    (H : Finset ↥(P g)) (q : FiniteOrderedTuple (Σ p : ↥(P g), ZMod p.val)) :
    globalBirthRawStepRow
      (physicalGroupResidueFiniteStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis
        g hk β η V ρ hV cap (2 * j.val + 1)) F H q =
    globalBirthEdgeRawRow
      (physicalGroupUnsharedEmbedding (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) g)
      (physicalGroupUnsharedEmbedding (C j) (physicalPermuteLabels (τ j) (L j.succ)) g)
      (physicalGroupPhaseDelta (a j.castSucc) (a j.succ) g) H q.2
      (globalBirthRawHitIndices (physicalGroupPhaseDelta (a j.castSucc) (a j.succ) g) q)
      β ρ V cap F := by
  unfold physicalGroupResidueFiniteStep
  rw [physical_group_bare_finite_edge_row, physical_group_permuted_bare_raw_edge_row, ← hstep j]

variable [∀ p : ↥(P g), NeZero p.val]

noncomputable def physicalGroupResidueFiniteRawHistory : ℂ :=
  physicalGroupBareFiniteRawHistory C aux k L a σ τ hlist hP hdis
    (physical_group_residue_path_compatibility C aux k L a σ τ hstep ζ hmarks)
    g hk β η V ρ hV cap

/-- The normalized exact trace needs an independent residue assignment,
not a simultaneous integer realization of all its coordinates. -/
theorem physical_group_residue_normalized_history_trace :
    ((∏ s : PhysicalSlots J ell, β (L 0 g s) / V : ℝ) : ℂ) *
      physicalGroupResidueFiniteRawHistory C aux k L a σ τ hstep ζ hmarks hlist hP hdis
        g hk β η V ρ hV cap =
    ∑ z : Fin (2 * n + 2) → (p : ↥(P g)) → GhostPhaseState (ZMod p.val),
      ((∏ p, ghostPhaseTerminal (physicalGroupPhaseActivity (L (Fin.last n)) g p)
        (z (Fin.last (2 * n + 1)) p) : ℝ) : ℂ) *
      (((∏ p, ghostPhaseRunInitial (physicalGroupPhaseActivity (L 0) g p)
        (β p) V (z 0 p) : ℝ) : ℂ) *
        ∏ j : Fin (2 * n + 1), globalBirthRawStepKernel
          (physicalGroupResidueFiniteStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis
            g hk β η V ρ hV cap j.val) (z j.succ) (z j.castSucc)) :=
  physical_group_bare_normalized_history_trace C aux k L a σ τ hlist hP hdis
    (physical_group_residue_path_compatibility C aux k L a σ τ hstep ζ hmarks)
    g hk β η V ρ hV cap

end ResiduePath
end

section
open Finset
open scoped Classical
noncomputable def repeatedBigDensityMap {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (b : ∀ g, P g → ℝ) :
    (RepeatedBigLists P J ell → ℂ) →ₗ[ℂ] (RepeatedBigLists P J ell → ℂ) where
  toFun f L := (Real.sqrt (cleanActiveDensity b L) : ℂ) * f L
  map_add' f g := by ext L; exact mul_add _ _ _
  map_smul' a f := by ext L; change _ * (a * _) = a * (_ * _); ring

noncomputable def repeatedBigDensityInverse {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (b : ∀ g, P g → ℝ) :
    (RepeatedBigLists P J ell → ℂ) →ₗ[ℂ] (RepeatedBigLists P J ell → ℂ) where
  toFun f L := f L / (Real.sqrt (cleanActiveDensity b L) : ℂ)
  map_add' f g := by ext L; exact add_div _ _ _
  map_smul' a f := by ext L; change (a * _) / _ = a * (_ / _); ring

theorem repeated_big_density_sqrt_ne_zero {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (b : ∀ g, P g → ℝ)
    (hb : ∀ g p, 0 < b g p) (L : RepeatedBigLists P J ell) :
    (Real.sqrt (cleanActiveDensity b L) : ℂ) ≠ 0 := by
  exact_mod_cast (Real.sqrt_pos.mpr (clean_active_density_pos b hb L)).ne'

theorem repeated_big_density_inverse_map {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (b : ∀ g, P g → ℝ)
    (hb : ∀ g p, 0 < b g p) (f : RepeatedBigLists P J ell → ℂ) :
    repeatedBigDensityInverse b (repeatedBigDensityMap b f) = f := by
  ext L
  change ((Real.sqrt (cleanActiveDensity b L) : ℂ) * f L) /
    (Real.sqrt (cleanActiveDensity b L) : ℂ) = f L
  exact mul_div_cancel_left₀ _ (repeated_big_density_sqrt_ne_zero b hb L)

theorem repeated_big_density_map_inverse {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (b : ∀ g, P g → ℝ)
    (hb : ∀ g p, 0 < b g p) (f : RepeatedBigLists P J ell → ℂ) :
    repeatedBigDensityMap b (repeatedBigDensityInverse b f) = f := by
  ext L
  change (Real.sqrt (cleanActiveDensity b L) : ℂ) *
    (f L / (Real.sqrt (cleanActiveDensity b L) : ℂ)) = f L
  exact mul_div_cancel₀ _ (repeated_big_density_sqrt_ne_zero b hb L)

noncomputable def repeatedBigDensityEquiv {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (b : ∀ g, P g → ℝ)
    (hb : ∀ g p, 0 < b g p) :
    (RepeatedBigLists P J ell → ℂ) ≃ₗ[ℂ] (RepeatedBigLists P J ell → ℂ) where
  toLinearMap := repeatedBigDensityMap b
  invFun := repeatedBigDensityInverse b
  left_inv := repeated_big_density_inverse_map b hb
  right_inv := repeated_big_density_map_inverse b hb

theorem repeated_big_active_mass_density {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (L : RepeatedBigLists P J ell) :
    repeatedBigActiveMass V b L =
      repeatedBigActiveMass V (fun _ _ => 1) L * cleanActiveDensity b L := by
  unfold repeatedBigActiveMass cleanActiveDensity
  rw [← prod_mul_distrib]
  apply prod_congr rfl
  intro g _
  simpa only [tiltedPhysicalBirthLaw, div_one] using
    physical_tilted_birth_product_eq V (fun _ : PhysicalSlots J ell => g) b (L g)

theorem repeated_big_density_energy {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (hb : ∀ g p, 0 ≤ b g p) (f : RepeatedBigLists P J ell → ℂ) :
    (∑ L, repeatedBigActiveMass V (fun _ _ => 1) L * ‖repeatedBigDensityMap b f L‖ ^ 2) =
      ∑ L, repeatedBigActiveMass V b L * ‖f L‖ ^ 2 := by
  apply sum_congr rfl
  intro L _
  have hd : 0 ≤ cleanActiveDensity b L := by
    exact prod_nonneg fun g _ => prod_nonneg fun s _ => one_div_nonneg.mpr (hb g (L g s))
  change repeatedBigActiveMass V (fun _ _ => 1) L *
      ‖(Real.sqrt (cleanActiveDensity b L) : ℂ) * f L‖ ^ 2 = _
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (Real.sqrt_nonneg _), mul_pow, Real.sq_sqrt hd,
    repeated_big_active_mass_density V b L]
  ring

theorem repeated_big_density_norm {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (hb : ∀ g p, 0 ≤ b g p) (f : RepeatedBigLists P J ell → ℂ) :
    cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) (repeatedBigDensityMap b f) =
      cleanActiveNorm (repeatedBigActiveMass V b) f :=
  congrArg Real.sqrt (repeated_big_density_energy V b hb f)

theorem repeated_big_density_inverse_norm {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (hb : ∀ g p, 0 < b g p) (f : RepeatedBigLists P J ell → ℂ) :
    cleanActiveNorm (repeatedBigActiveMass V b) (repeatedBigDensityInverse b f) =
      cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f := by
  rw [← repeated_big_density_norm V b (fun g p => (hb g p).le),
    repeated_big_density_map_inverse b hb]

theorem repeated_big_density_map_symmetrize {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (b : ∀ g, P g → ℝ)
    (f : RepeatedBigLists P J ell → ℂ) :
    repeatedBigDensityMap b (repeatedBigSymmetrizeLinear f) =
      repeatedBigSymmetrizeLinear (repeatedBigDensityMap b f) :=
  (repeated_big_symmetrize_density_mul b f).symm

theorem repeated_big_density_inverse_symmetrize {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (b : ∀ g, P g → ℝ)
    (f : RepeatedBigLists P J ell → ℂ) :
    repeatedBigDensityInverse b (repeatedBigSymmetrizeLinear f) =
      repeatedBigSymmetrizeLinear (repeatedBigDensityInverse b f) := by
  have h := repeated_big_symmetrize_mul
    (fun L : RepeatedBigLists P J ell => (Real.sqrt (cleanActiveDensity b L) : ℂ)⁻¹)
    (by intro σ L; rw [clean_active_density_permutation]) f
  simpa only [repeatedBigDensityInverse, LinearMap.coe_mk, AddHom.coe_mk,
    div_eq_mul_inv, mul_comm] using h.symm

theorem repeated_big_density_map_mem {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (b : ∀ g, P g → ℝ)
    (f : RepeatedBigLists P J ell → ℂ) (hf : f ∈ repeatedBigSymmetricSubspace) :
    repeatedBigDensityMap b f ∈ repeatedBigSymmetricSubspace := by
  intro σ L
  change (Real.sqrt (cleanActiveDensity b (repeatedBigPermutationEquiv σ L)) : ℂ) *
    f (repeatedBigPermutationEquiv σ L) = (Real.sqrt (cleanActiveDensity b L) : ℂ) * f L
  rw [clean_active_density_permutation, hf σ L]

theorem repeated_big_density_inverse_mem {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (b : ∀ g, P g → ℝ)
    (f : RepeatedBigLists P J ell → ℂ) (hf : f ∈ repeatedBigSymmetricSubspace) :
    repeatedBigDensityInverse b f ∈ repeatedBigSymmetricSubspace := by
  intro σ L
  change f (repeatedBigPermutationEquiv σ L) /
    (Real.sqrt (cleanActiveDensity b (repeatedBigPermutationEquiv σ L)) : ℂ) =
    f L / (Real.sqrt (cleanActiveDensity b L) : ℂ)
  rw [clean_active_density_permutation, hf σ L]

/-- The same change of measure is exact after adjoining any finite residue space. -/
theorem repeated_big_density_weighted_norm {G R : Type*} [Fintype G] [Fintype R]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (hb : ∀ g p, 0 ≤ b g p) (f : RepeatedBigLists P J ell → R → ℂ) :
    cleanWeightedNorm (repeatedBigActiveMass V (fun _ _ => 1))
        (fun L r => repeatedBigDensityMap b (fun L' => f L' r) L) =
      cleanWeightedNorm (repeatedBigActiveMass V b) f := by
  unfold cleanWeightedNorm
  congr 1
  simp_rw [mul_sum]
  rw [sum_comm]
  conv_rhs => rw [sum_comm]
  apply sum_congr rfl
  intro r _
  exact repeated_big_density_energy V b hb (fun L => f L r)

theorem repeated_big_density_inverse_weighted_norm {G R : Type*} [Fintype G] [Fintype R]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (hb : ∀ g p, 0 < b g p) (f : RepeatedBigLists P J ell → R → ℂ) :
    cleanWeightedNorm (repeatedBigActiveMass V b)
        (fun L r => repeatedBigDensityInverse b (fun L' => f L' r) L) =
      cleanWeightedNorm (repeatedBigActiveMass V (fun _ _ => 1)) f := by
  rw [← repeated_big_density_weighted_norm V b (fun g p => (hb g p).le)]
  congr 1
  funext L r
  exact congrFun (repeated_big_density_map_inverse b hb (fun L' => f L' r)) L
end

section

open Finset
open scoped Classical

noncomputable def cleanActiveEmbedding {X : Type*} [Fintype X] (w : X → ℝ) :
    (X → ℂ) →ₗ[ℂ] EuclideanSpace ℂ X where
  toFun f := WithLp.toLp 2 (fun x => (Real.sqrt (w x) : ℂ) * f x)
  map_add' f g := by ext x; exact mul_add _ _ _
  map_smul' c f := by ext x; change _ * (c * _) = c * (_ * _); ring

theorem clean_active_embedding_norm {X : Type*} [Fintype X] (w : X → ℝ)
    (hw : ∀ x, 0 ≤ w x) (f : X → ℂ) :
    ‖cleanActiveEmbedding w f‖ = cleanActiveNorm w f := by
  rw [EuclideanSpace.norm_eq]
  congr 1
  apply sum_congr rfl
  intro x _
  change ‖(Real.sqrt (w x) : ℂ) * f x‖ ^ 2 = w x * ‖f x‖ ^ 2
  rw [norm_mul, mul_pow, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (Real.sqrt_nonneg _), Real.sq_sqrt (hw x)]

theorem clean_active_norm_add_le {X : Type*} [Fintype X] (w : X → ℝ)
    (hw : ∀ x, 0 ≤ w x) (f g : X → ℂ) :
    cleanActiveNorm w (f + g) ≤ cleanActiveNorm w f + cleanActiveNorm w g := by
  simp only [← clean_active_embedding_norm w hw, map_add]
  exact norm_add_le _ _

theorem clean_active_norm_sub_le {X : Type*} [Fintype X] (w : X → ℝ)
    (hw : ∀ x, 0 ≤ w x) (f g : X → ℂ) :
    cleanActiveNorm w (f - g) ≤ cleanActiveNorm w f + cleanActiveNorm w g := by
  simp only [← clean_active_embedding_norm w hw, map_sub]
  exact norm_sub_le _ _

theorem clean_active_norm_sum_le {X I : Type*} [Fintype X] (w : X → ℝ)
    (hw : ∀ x, 0 ≤ w x) (s : Finset I) (f : I → X → ℂ) :
    cleanActiveNorm w (∑ i ∈ s, f i) ≤ ∑ i ∈ s, cleanActiveNorm w (f i) := by
  simp only [← clean_active_embedding_norm w hw, map_sum]
  exact norm_sum_le _ _

theorem clean_active_norm_smul {X : Type*} [Fintype X] (w : X → ℝ)
    (hw : ∀ x, 0 ≤ w x) (c : ℂ) (f : X → ℂ) :
    cleanActiveNorm w (c • f) = ‖c‖ * cleanActiveNorm w f := by
  simp only [← clean_active_embedding_norm w hw, map_smul, norm_smul]
end

section
open Finset Filter
open scoped Topology
/-- A restricted product window always lies in its full prime band. -/
theorem primeProductWindow_subset_primeBand {P : Finset ℕ} {R X : ℝ}
    (hP : ∀ p ∈ P, p.Prime) (hR : 0 < R) (hX : 0 < X) :
    primeProductWindow P R X ⊆ primeBand (X / R) (16 * (X / R)) := by
  intro p hp
  obtain ⟨hpP, hlo, hhi⟩ := mem_filter.mp hp
  apply (mem_primeBand_iff (by positivity) (by positivity) p).mpr
  refine ⟨hP p hpP, (div_lt_iff₀ hR).mpr hlo, ?_⟩
  simpa only [mul_div_assoc] using (le_div_iff₀ hR).mpr hhi

/-- A harmonic bound on the full prime band bounds the restricted window's cardinality. -/
theorem primeProductWindow_card_upper_from_harmonic {P : Finset ℕ} {R X H : ℝ}
    (hP : ∀ p ∈ P, p.Prime) (hR : 0 < R) (hX : 0 < X)
    (hH : primeBandHarmonic (X / R) (16 * (X / R)) ≤ H) :
    ((primeProductWindow P R X).card : ℝ) ≤ 16 * (X / R) * H := by
  have hA : 0 < X / R := div_pos hX hR
  have hB : 0 < 16 * (X / R) := by positivity
  calc
    ((primeProductWindow P R X).card : ℝ) ≤
        ((primeBand (X / R) (16 * (X / R))).card : ℝ) := by
      exact_mod_cast card_le_card (primeProductWindow_subset_primeBand hP hR hX)
    _ ≤ H * (16 * (X / R)) :=
      (div_le_iff₀ hB).mp ((primeBandHarmonic_card_bounds hA (by linarith)).1.trans hH)
    _ = 16 * (X / R) * H := by ring

/-- A nonempty restricted Q-zero window determines the required logarithmic range. -/
theorem candidate_free_prime_log_bounds_of_nonempty {c L R : ℝ} (hR : 0 < R)
    (hne : (primeProductWindow (candidateQBand (c * L) 0) R (Real.exp L)).Nonempty) :
    c * L - Real.log 16 ≤ Real.log (Real.exp L / R) ∧
      Real.log (Real.exp L / R) ≤ (6 / 5 : ℝ) * c * L := by
  obtain ⟨q, hq⟩ := hne
  obtain ⟨hqP, hqlo, hqhi⟩ := mem_filter.mp hq
  have hband : q.Prime ∧ Real.exp (c * L) < (q : ℝ) ∧
      (q : ℝ) ≤ Real.exp ((6 / 5 : ℝ) * c * L) := by
    simpa only [candidateQBand, mem_dyadicPrimeBand_iff, pow_zero, div_one, one_mul,
      mul_assoc] using hqP
  have hY : 0 < Real.exp L / R := div_pos (Real.exp_pos L) hR
  have hYq : Real.exp L / R < (q : ℝ) := (div_lt_iff₀ hR).mpr hqlo
  have hqY : (q : ℝ) ≤ 16 * (Real.exp L / R) := by
    simpa only [mul_div_assoc] using (le_div_iff₀ hR).mpr hqhi
  constructor
  · have hlog := Real.log_le_log (Real.exp_pos (c * L)) (hband.2.1.le.trans hqY)
    rw [Real.log_exp, Real.log_mul (by norm_num : (16 : ℝ) ≠ 0) hY.ne'] at hlog
    linarith
  · simpa only [Real.log_exp] using Real.log_le_log hY (hYq.le.trans hband.2.2)

/-- Uniformly over every positive remaining factor, the free-prime count is O_c(exp(L)/(R L)). -/
theorem eventually_candidate_free_prime_card_upper {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ R : ℝ, 0 < R →
      ((primeProductWindow (candidateQBand (c * L) 0) R (Real.exp L)).card : ℝ) ≤
        (512 * (Real.log 4 + 1) / c) * Real.exp L / (R * L) := by
  have ha : 0 < c / 2 := by positivity
  have hab : c / 2 ≤ (6 / 5 : ℝ) * c := by linarith
  filter_upwards [eventually_uniform_wide_prime_log_window ha hab,
    eventually_gt_atTop (0 : ℝ), eventually_ge_atTop ((2 * Real.log 16) / c)] with L hwide hL hlarge
  intro R hR
  by_cases hne : (primeProductWindow (candidateQBand (c * L) 0) R (Real.exp L)).Nonempty
  · obtain ⟨hlo, hhi⟩ := candidate_free_prime_log_bounds_of_nonempty hR hne
    have hthreshold : 2 * Real.log 16 ≤ L * c := (div_le_iff₀ hc).mp hlarge
    have hlo' : (c / 2) * L ≤ Real.log (Real.exp L / R) := by nlinarith
    have hH := (hwide (Real.log (Real.exp L / R)) hlo' hhi).2
    have hH' : primeBandHarmonic (Real.exp L / R) (16 * (Real.exp L / R)) ≤
        ((16 * (Real.log 4 + 1)) / (c / 2)) / L := by
      simpa only [Real.exp_add, Real.exp_log (div_pos (Real.exp_pos L) hR),
        Real.exp_log (by norm_num : (0 : ℝ) < 16), mul_comm (Real.exp L / R) 16] using hH
    have hb := primeProductWindow_card_upper_from_harmonic
      (P := candidateQBand (c * L) 0)
      (fun p hp => (mem_filter.mp hp).2) hR (Real.exp_pos L) hH'
    convert hb using 1
    ring
  · rw [not_nonempty_iff_eq_empty.mp hne, card_empty, Nat.cast_zero]
    positivity
end

section
open Finset Filter
noncomputable def candidateQRestChoices (c L : ℝ) (r jStar : ℕ) (hr : 0 < r)
    (slot : {slot : (candidateQIndices c L) × Fin r // slot ≠ candidateFreeSlot c L r hr}) : Finset ℕ :=
  candidateQSlotChoices c L r jStar slot.val

noncomputable def candidateQRestHarmonicMass (c L : ℝ) (r jStar : ℕ) (hr : 0 < r) : ℝ :=
  ∑' n : ℕ,
    orderedSlotWeight (candidateQRestChoices c L r jStar hr)
      ((r.factorial : ℝ)^(candidateQIndices c L).card) n / (n : ℝ)

theorem candidate_Q_free_choice (c L : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : 0 < jStar) :
    candidateQSlotChoices c L r jStar (candidateFreeSlot c L r hr) = candidateQBand (c * L) 0 := by
  have hnot : (0 : ℕ) ≠ jStar := Nat.ne_of_lt hj
  simp only [candidateQSlotChoices, candidateFreeSlot, hnot, false_and, if_false]

theorem candidate_Q_harmonic_mass_free_factor (c L : ℝ) (r jStar : ℕ)
    (hr : 0 < r) (hj : 0 < jStar) :
    candidateQHarmonicMass c L r jStar =
      (∑ p ∈ candidateQBand (c * L) 0, 1 / (p : ℝ)) *
        candidateQRestHarmonicMass c L r jStar hr := by
  have h := ordered_slot_harmonic_split (candidateQSlotChoices c L r jStar)
    (candidateFreeSlot c L r hr) ((r.factorial : ℝ)^(candidateQIndices c L).card)
  rw [candidate_Q_free_choice c L r jStar hr hj] at h
  exact h

theorem candidate_Q_rest_harmonic_nonneg (c L : ℝ) (r jStar : ℕ) (hr : 0 < r) :
    0 ≤ candidateQRestHarmonicMass c L r jStar hr := by
  apply tsum_nonneg
  intro n
  exact div_nonneg (ordered_slot_weight_nonneg _ (by positivity) n) (Nat.cast_nonneg n)

theorem candidate_Q_rest_harmonic_eq_tuple_sum (c L : ℝ) (r jStar : ℕ) (hr : 0 < r) :
    candidateQRestHarmonicMass c L r jStar hr =
      ∑ x : ∀ slot, candidateQRestChoices c L r jStar hr slot,
        (1 / (orderedSlotProduct (candidateQRestChoices c L r jStar hr) x : ℝ)) /
          ((r.factorial : ℝ)^(candidateQIndices c L).card) :=
  ordered_slot_harmonic_eq_tuple_sum _ _

theorem exists_candidate_Q_rest_harmonic_upper {c : ℝ} (hc : 0 < c)
    (r : ℕ) (hr : 0 < r) :
    ∃ V : ℝ, 0 < V ∧ ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, 0 < jStar →
      candidateQRestHarmonicMass c L r jStar hr ≤ V * candidateQHarmonicMass c L r jStar := by
  obtain ⟨v, V, hv, hV, hband⟩ := exists_candidateQBands_bounds hc
  refine ⟨1 / v, by positivity, ?_⟩
  filter_upwards [hband] with L hb
  intro jStar hj
  have hzero : 0 ∈ candidateQIndices c L := by simp [candidateQIndices]
  have hlower := (hb.2.2 0 hzero).2.2.1
  have h := mul_le_mul_of_nonneg_right hlower
    (candidate_Q_rest_harmonic_nonneg c L r jStar hr)
  rw [← candidate_Q_harmonic_mass_free_factor c L r jStar hr hj] at h
  calc
    _ ≤ candidateQHarmonicMass c L r jStar / v :=
      (le_div_iff₀ hv).mpr (by simpa only [mul_comm v] using h)
    _ = _ := by ring
end

section
open Finset
theorem supported_free_window_convolution_eq (P S : Finset ℕ)
    (a b W : ℕ → ℝ) (X : ℝ)
    (hS : ∀ p ∈ S, p ∈ Nat.factoredNumbers P)
    (hb : ∀ n, b n ≠ 0 → n ≠ 0 ∧ Disjoint n.primeFactors P)
    (hprod : ∀ p ∈ S, ∀ n, b n ≠ 0 → W (p * n) = a p * b n)
    (hcovered : ∀ u ∈ arithmeticProductWindow 1 X, W u ≠ 0 →
      ∃ p ∈ S, ∃ n ∈ arithmeticProductWindow p X, b n ≠ 0 ∧ p * n = u) :
    (∑ p ∈ S, a p * ∑ n ∈ arithmeticProductWindow p X, b n) =
      ∑ u ∈ arithmeticProductWindow 1 X, W u := by
  classical
  let T : Finset (Σ _p : ℕ, ℕ) :=
    S.sigma (fun p => (arithmeticProductWindow p X).filter (fun n => b n ≠ 0))
  let f : (Σ _p : ℕ, ℕ) → ℕ := fun z => z.1 * z.2
  have hinj : Set.InjOn f T := by
    intro x hx y hy hxy
    have hx' := mem_sigma.mp hx
    have hy' := mem_sigma.mp hy
    have hbx := hb x.2 (mem_filter.mp hx'.2).2
    have hby := hb y.2 (mem_filter.mp hy'.2).2
    obtain ⟨hp, hn⟩ := supported_free_product_unique
      (hS x.1 hx'.1) hbx.1 hbx.2 (hS y.1 hy'.1) hby.1 hby.2 hxy
    exact Sigma.ext hp (heq_of_eq hn)
  have hsubset : T.image f ⊆ arithmeticProductWindow 1 X := by
    intro u hu
    obtain ⟨z, hz, rfl⟩ := mem_image.mp hu
    have hz' := mem_sigma.mp hz
    have hwindow := (mem_filter.mp hz'.2).1
    have hp0 := Nat.ne_zero_of_mem_factoredNumbers (hS z.1 hz'.1)
    have hrange := (mem_arithmeticProductWindow_iff hp0 X).mp hwindow
    apply (mem_arithmeticProductWindow_iff one_ne_zero X).mpr
    simpa only [one_mul, f] using hrange
  calc
    _ = ∑ z ∈ T, W (f z) := by
      dsimp only [T, f]
      rw [sum_sigma]
      apply sum_congr rfl
      intro p hp
      rw [← sum_filter_ne_zero (arithmeticProductWindow p X), mul_sum]
      apply sum_congr rfl
      intro n hn
      exact (hprod p hp n (mem_filter.mp hn).2).symm
    _ = ∑ u ∈ T.image f, W u := (sum_image hinj).symm
    _ = _ := by
      apply sum_subset hsubset
      intro u hu hnot
      by_contra hWu
      obtain ⟨p, hp, n, hn, hbn, hpn⟩ := hcovered u hu hWu
      apply hnot
      exact mem_image.mpr ⟨⟨p, n⟩, mem_sigma.mpr ⟨hp, mem_filter.mpr ⟨hn, hbn⟩⟩, hpn⟩
end

section
open Finset
theorem indexed_free_prime_mass_upper {T : Type*} [Fintype T]
    (S P : Finset ℕ) (W : ℕ → ℝ) (R : T → ℕ) (N X H : ℝ)
    (hN : 0 ≤ N) (hW : ∀ n ∈ S, 0 ≤ W n)
    (hcount : ∀ n ∈ S, ∀ t : T,
      ((primeProductWindow P ((n * R t : ℕ) : ℝ) X).card : ℝ) ≤
        (X / ((n * R t : ℕ) : ℝ)) * H) :
    (∑ n ∈ S, ∑ t : T,
      (W n / N) * ((primeProductWindow P ((n * R t : ℕ) : ℝ) X).card : ℝ)) ≤
      X * H * (∑ n ∈ S, W n / (n : ℝ)) *
        (∑ t : T, (1 / (R t : ℝ)) / N) := by
  classical
  calc
    _ ≤ ∑ n ∈ S, ∑ t : T,
        (W n / N) * ((X / ((n * R t : ℕ) : ℝ)) * H) := by
      apply sum_le_sum
      intro n hn
      apply sum_le_sum
      intro t _
      exact mul_le_mul_of_nonneg_left (hcount n hn t) (div_nonneg (hW n hn) hN)
    _ = _ := by
      symm
      simp only [mul_sum, sum_mul]
      rw [sum_comm]
      apply sum_congr rfl
      intro n _
      apply sum_congr rfl
      intro t _
      simp only [Nat.cast_mul, div_eq_mul_inv, mul_inv]
      ring

/-- The harmonic small-factor version keeps the free slot's factorial normalization. -/
theorem indexed_free_prime_mass_upper_harmonic {T : Type*} [Fintype T]
    (S P : Finset ℕ) (h : ℕ → ℝ) (R : T → ℕ) (N X H : ℝ)
    (hN : 0 ≤ N) (hS : ∀ n ∈ S, n ≠ 0) (hh : ∀ n ∈ S, 0 ≤ h n)
    (hcount : ∀ n ∈ S, ∀ t : T,
      ((primeProductWindow P ((n * R t : ℕ) : ℝ) X).card : ℝ) ≤
        (X / ((n * R t : ℕ) : ℝ)) * H) :
    (∑ n ∈ S, ∑ t : T,
      (((n : ℝ) * h n) / N) *
        ((primeProductWindow P ((n * R t : ℕ) : ℝ) X).card : ℝ)) ≤
      X * H * (∑ n ∈ S, h n) * (∑ t : T, (1 / (R t : ℝ)) / N) := by
  have he : (∑ n ∈ S, ((n : ℝ) * h n) / (n : ℝ)) = ∑ n ∈ S, h n := by
    apply sum_congr rfl
    intro n hn
    have hn0 : (n : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (hS n hn)
    exact mul_div_cancel_left₀ (h n) hn0
  have hb := indexed_free_prime_mass_upper S P (fun n => (n : ℝ) * h n) R N X H hN
    (fun n hn => mul_nonneg (Nat.cast_nonneg n) (hh n hn)) hcount
  rwa [he] at hb
end

section
open Finset Filter
open scoped Topology
theorem exists_candidate_P_harmonic_log_upper {c : ℝ} (hc : 0 < c) :
    ∃ D : ℝ, 0 ≤ D ∧ ∀ᶠ L : ℝ in atTop,
      candidatePHarmonicMass c L ≤ D * Real.log L := by
  obtain ⟨v, V, hv, hV, hpool⟩ := exists_candidate_P_pool_bounds hc
  refine ⟨(2 / (5 * Real.log 2)) * V, by positivity, ?_⟩
  filter_upwards [hpool] with L hp
  calc
    _ ≤ ∑ _j ∈ candidatePIndices c L, V :=
      sum_le_sum (fun j hj => (hp.2.2.2.2.2 j hj).2.1)
    _ = ((candidatePIndices c L).card : ℝ) * V := by simp
    _ ≤ ((2 / (5 * Real.log 2)) * Real.log L) * V :=
      mul_le_mul_of_nonneg_right hp.2.2.2.1 hV.le
    _ = _ := by ring

theorem exists_candidate_one_marked_harmonic_polynomial_upper {c q : ℝ}
    (hc : 0 < c) (hq0 : 0 ≤ q) (hq1 : q ≤ 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ L : ℝ in atTop,
      candidateOneMarkedHarmonicMass c L q ≤ L^C := by
  obtain ⟨D, hD, hbound⟩ := exists_candidate_P_harmonic_log_upper hc
  have hratio := (tendsto_candidate_one_marked_harmonic_ratio hc hq0 hq1).eventually_le_const
    (show (1 : ℝ) < 2 by norm_num)
  refine ⟨q * D + 1, by positivity, ?_⟩
  filter_upwards [hbound, hratio, eventually_ge_atTop (2 : ℝ)] with L hp hr hL
  have hL0 : 0 < L := by linarith
  have hmass := (div_le_iff₀ (Real.exp_pos _)).mp hr
  have hexp : Real.exp (q * candidatePHarmonicMass c L) ≤ L^(q * D) := by
    rw [Real.rpow_def_of_pos hL0]
    apply Real.exp_le_exp.mpr
    calc
      _ ≤ q * (D * Real.log L) := mul_le_mul_of_nonneg_left hp hq0
      _ = _ := by ring
  calc
    _ ≤ 2 * Real.exp (q * candidatePHarmonicMass c L) := hmass
    _ ≤ 2 * L^(q * D) := mul_le_mul_of_nonneg_left hexp (by norm_num)
    _ ≤ L * L^(q * D) := mul_le_mul_of_nonneg_right hL (Real.rpow_nonneg hL0.le _)
    _ = L^(q * D + 1) := by rw [Real.rpow_add hL0, Real.rpow_one]; ring
end

section
open Finset
open scoped Classical
section Events
variable {P : Type*} [Fintype P] [DecidableEq P] {R : P → Type*}
  [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)] {a b : P → Bool}

def GlobalBirthRawEvent (step : GlobalBirthRawStep (R := R) a b)
    (s : GlobalBirthHistoryState R) : Type _ :=
  match step with
  | .visit h _ _ _ _ _ _ =>
      Σ _T : ↥((globalBirthVisitZeroIndices h s.2.2).powerset),
        Σ m : ↥(range (((univ : Finset P) \ s.1).card + 1)),
          Fin m.val ↪ ↥((univ : Finset P) \ s.1)
  | .edge (t := t) delta _ _ _ _ _ _ _ _ _ =>
      Finset (Fin t) × FixedTargetEdgeEvent (Fin t) (Fin s.2.1) P
        (globalBirthRawHitIndices delta s.2)

noncomputable abbrev globalBirthRawEventFintype
    (step : GlobalBirthRawStep (R := R) a b) (s : GlobalBirthHistoryState R) :
    Fintype (GlobalBirthRawEvent step s) := by
  cases step <;> unfold GlobalBirthRawEvent <;> infer_instance

noncomputable def globalBirthRawEventTarget (step : GlobalBirthRawStep (R := R) a b)
    (s : GlobalBirthHistoryState R) : GlobalBirthRawEvent step s → GlobalBirthHistoryState R :=
  match step with
  | .visit h _ _ _ _ _ _ => fun e =>
      (s.1 ∪ globalVisitBirthRange (univ \ s.1) e.2.2,
        retainedBirthTuple s.2.2 (univ \ e.1.val)
          (fun j => ⟨(e.2.2 j).val, h (e.2.2 j).val⟩))
  | .edge delta _ source _ _ _ _ _ _ _ => fun e =>
      (s.1 ∪ univ.image (unrestrictedEdgeTarget s.2.2 Sigma.fst e.2.1 e.2.2.1 e.2.2.2),
        unrestrictedEdgeOutput source s.2.2 (fun p => ⟨p, 0⟩)
          (unrestrictedPhaseTransport delta) e.1 e.2.1 e.2.2.1)

noncomputable def globalBirthRawEventWeight (step : GlobalBirthRawStep (R := R) a b)
    (s : GlobalBirthHistoryState R) : GlobalBirthRawEvent step s → ℝ :=
  match step with
  | .visit h β η V ρ _ _ => fun e =>
      (((-η / ρ) ^ e.1.val.card *
        ((1 - η) / ρ ^ 2) ^ (globalBirthVisitZeroIndices h s.2.2 \ e.1.val).card) *
        ((-η * V / ρ) ^ e.2.1.val * (∏ j, β (e.2.2 j).val / V))) /
          (e.2.1.val.factorial : ℝ)
  | .edge delta _ source _ _ _ β ρ V _ => fun e =>
      unrestrictedEdgeEventMass source s.2.2 (fun p => ⟨p, 0⟩)
        (unrestrictedPhaseTransport delta) (fun z => z.2 = 0) (fun p => β p / V)
        ρ V e.1 e.2.1 e.2.2.1 e.2.2.2

def globalBirthRawEventAllowed (step : GlobalBirthRawStep (R := R) a b)
    (s : GlobalBirthHistoryState R) : GlobalBirthRawEvent step s → Prop :=
  match step with
  | .visit h _ _ _ _ _ cap => fun e =>
      (retainedBirthTuple s.2.2 (univ \ e.1.val)
        (fun j => ⟨(e.2.2 j).val, h (e.2.2 j).val⟩)).1 ≤ cap
  | .edge delta _ source target _ _ _ _ _ cap => fun e =>
      (unrestrictedEdgeTarget s.2.2 Sigma.fst e.2.1 e.2.2.1 e.2.2.2 = target ∧
        ∀ j, e.2.2.2 j ∉ s.1) ∧
      (unrestrictedEdgeOutput source s.2.2 (fun p => ⟨p, 0⟩)
        (unrestrictedPhaseTransport delta) e.1 e.2.1 e.2.2.1).1 ≤ cap

noncomputable def globalBirthRawEventMass (step : GlobalBirthRawStep (R := R) a b)
    (s : GlobalBirthHistoryState R) (e : GlobalBirthRawEvent step s) : ℝ :=
  if globalBirthRawEventAllowed step s e then globalBirthRawEventWeight step s e else 0

theorem global_birth_raw_step_event_sum (step : GlobalBirthRawStep (R := R) a b)
    (s : GlobalBirthHistoryState R) (F : GlobalBirthHistoryState R → ℂ) :
    let _ := globalBirthRawEventFintype step s
    globalBirthRawStepRow step (fun H q => F (H, q)) s.1 s.2 =
      ∑ e : GlobalBirthRawEvent step s,
        (globalBirthRawEventMass step s e : ℂ) * F (globalBirthRawEventTarget step s e) := by
  cases step with
  | visit h β η V ρ hV cap =>
      simp only [GlobalBirthRawEvent, Fintype.sum_sigma,
        globalBirthRawStepRow, globalBirthGhostVisitRawRow, globalBirthRawEventMass,
        globalBirthRawEventAllowed, globalBirthRawEventWeight, globalBirthRawEventTarget]
      rw [← sum_coe_sort (globalBirthVisitZeroIndices h s.2.2).powerset]
      apply sum_congr rfl
      intro T hT
      rw [← sum_coe_sort (range (((univ : Finset P) \ s.1).card + 1))]
      apply sum_congr rfl
      intro m hm
      apply sum_congr rfl
      intro f _
      split_ifs <;> simp
  | edge delta hshared source target hsource htarget β ρ V cap =>
      simp only [GlobalBirthRawEvent, Fintype.sum_prod_type,
        Fintype.sum_sigma, globalBirthRawStepRow, globalBirthEdgeRawRow, unrestrictedEdgeAction,
        globalBirthRawEventMass, globalBirthRawEventAllowed,
        globalBirthRawEventWeight, globalBirthRawEventTarget]
      apply sum_congr rfl
      intro stores _
      apply sum_congr rfl
      intro promotions _
      apply sum_congr rfl
      intro e _
      apply sum_congr rfl
      intro fresh _
      split_ifs <;> simp_all

theorem global_birth_raw_event_coherent (step : GlobalBirthRawStep (R := R) a b)
    (s : GlobalBirthHistoryState R)
    (hs : GlobalBirthMemoryCoherent (ghostPhaseActivitySupport a) s.1 s.2)
    (e : GlobalBirthRawEvent step s) (he : globalBirthRawEventAllowed step s e) :
    GlobalBirthMemoryCoherent (ghostPhaseActivitySupport b)
      (globalBirthRawEventTarget step s e).1 (globalBirthRawEventTarget step s e).2 := by
  cases step with
  | visit h β η V ρ hV cap =>
      exact global_birth_visit_raw_output_coherent a h s.1 s.2 hs e.1.val
        (mem_powerset.mp e.1.property) e.2.2
  | edge delta hshared source target hsource htarget β ρ V cap =>
      exact coherent_global_birth_edge_raw_output b a delta s.1 s.2 hs source target
        hsource htarget (globalBirthRawHitIndices delta s.2) e.1 e.2.1 e.2.2.1 e.2.2.2 he.1

end Events
end

