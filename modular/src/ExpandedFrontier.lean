section

/- Uniform additive-frequency comparison from the actual major and minor arc estimates. -/

open scoped BigOperators Classical

universe u

namespace Bounty

theorem prime_all_frequency_dyadic_pairing (hZ : PrimitiveZeroFreeHalfPlane) :
    ∃ CM CE : ℝ, 0 < CM ∧ 0 < CE ∧
    ∀ L q κ t n x w z d B : ℝ,
    512 ≤ L → 0 ≤ q → 0 ≤ t → 0 ≤ d →
    2 * κ + t + 2 * B + 3 ≤ q →
    n + 2 * B + 2 ≤ x → 4 * q + max z q + B + 2 ≤ w → q + B + 2 ≤ d →
    ∀ Q : ℕ, Q = ⌊L ^ q⌋₊ → 0 < Q →
    ∀ {I J : Type u} [Fintype I] [DecidableEq I] [Fintype J] [DecidableEq J],
    ∀ (P : I → Finset ℕ) (V : I → ℝ) (i : I)
      (R : J → Finset ℕ) (W : J → ℝ) (j : J),
    (∀ k, 0 < V k) → (∀ k, 0 < W k) →
    (∀ k p, p ∈ P k → p.Prime ∧ Q < p) →
    (∀ k p, p ∈ R k → p.Prime ∧ Q < p) →
    (∀ k, ∑ p ∈ P k, 1 / (p : ℝ) = V k) →
    (∀ k, ∑ p ∈ R k, 1 / (p : ℝ) = W k) →
    ∀ a b a' b' : ℝ, P i = primeBand a b → R j = primeBand a' b' →
    2 ≤ a → 0 ≤ b → 2 ≤ a' → 0 ≤ b' →
    ∀ h ξ : ℝ, 0 < h → h ≤ Real.log 2 → 0 < ξ → h ≤ L ^ (-w) → ξ ≤ L ^ (-x) →
    (Q * Q - 1 : ℕ) * (((CE / V i) * a ^ (-(1 : ℝ) / 32) *
      (1 + Real.log (Q * Q : ℕ) / Real.log a)) / ξ) ≤ 1 →
    (Q * Q - 1 : ℕ) * (((CE / W j) * a' ^ (-(1 : ℝ) / 32) *
      (1 + Real.log (Q * Q : ℕ) / Real.log a')) / ξ) ≤ 1 →
    primeKernelError CM Q (V i) a ξ ≤ L ^ (-d) →
    primeKernelError CM Q (W j) a' ξ ≤ L ^ (-d) →
    (((finiteOccupiedCells (fun v : (∀ k, P k) =>
        upperLogCell h (Real.log (∏ k, (v k).val : ℕ)))).card +
      (finiteOccupiedCells (fun v : (∀ k, R k) =>
        upperLogCell h (Real.log (∏ k, (v k).val : ℕ)))).card : ℕ) : ℝ) ≤ L ^ n →
    ∀ U T : ℕ, L ^ q ≤ (U : ℝ) → L ^ q ≤ (T : ℝ) →
    Real.log ((U : ℝ) * T) ≤ L ^ t →
    ∀ (f : (∀ k, P k) → ℂ) (g : (∀ k, R k) → ℂ),
    (∀ v, f v ≠ 0 → U ≤ (∏ k, (v k).val : ℕ) ∧ (∏ k, (v k).val : ℕ) < 2 * U) →
    (∀ v, g v ≠ 0 → T ≤ (∏ k, (v k).val : ℕ) ∧ (∏ k, (v k).val : ℕ) < 2 * T) →
    ∀ C D : ℝ, 0 ≤ C → 0 ≤ D → C ≤ L ^ κ → D ≤ L ^ κ →
    (∀ m : ℕ, (∑ v ∈ Finset.univ.filter (fun v : (∀ k, P k) => (∏ k, (v k).val : ℕ) = m),
      finiteProductWeight (physicalLabelLaw V) v) ≤ C / (m : ℝ)) →
    (∀ m : ℕ, (∑ v ∈ Finset.univ.filter (fun v : (∀ k, R k) => (∏ k, (v k).val : ℕ) = m),
      finiteProductWeight (physicalLabelLaw W) v) ≤ D / (m : ℝ)) →
    ∀ α ζ : ℝ, |ζ| ≤ L ^ z →
    let μ := finiteProductWeight (physicalLabelLaw (P := P) V)
    let ν := finiteProductWeight (physicalLabelLaw (P := R) W)
    let KA := primeProductIdealKernel P V Q h (primeProductRetainedCells P V h ξ)
    let KB := primeProductIdealKernel R W Q h (primeProductRetainedCells R W h ξ)
    let phase := fun (v : ∀ k, P k) (s : ∀ k, R k) => Complex.exp (Complex.I *
      (ζ * Real.log (((∏ k, (v k).val : ℕ) : ℝ) * (∏ k, (s k).val : ℕ)) +
        2 * Real.pi * (α * (((∏ k, (v k).val : ℕ) : ℝ) * (∏ k, (s k).val : ℕ))) : ℝ))
    ‖∑ v, ∑ s, ((μ v * ν s : ℝ) : ℂ) *
      ((phase v s - finiteTwoKernelAverage μ ν KA KB v s phase) * f v * g s)‖ ≤
      L ^ (-B) * Real.sqrt ((∑ v, μ v * ‖f v‖ ^ 2) * ∑ s, ν s * ‖g s‖ ^ 2) := by
  obtain ⟨CM, hCM, hmajor⟩ := prime_major_arc_dyadic_pairing.{u} hZ
  obtain ⟨CE, hCE, hminor⟩ := prime_minor_arc_dyadic_pairing.{u} hZ
  refine ⟨CM, CE, hCM, hCE, ?_⟩
  intro L q κ t n x w z d B hL hq ht hd hparam hxp hwp hdp Q hQfloor hQ
    I J _ _ _ _ P V i R W j hV hW hP hR hVP hWR a b a' b' hPi hRj ha hb ha' hb'
    h ξ hh hh2 hξ hhb hξb hsmallP hsmallR hεP hεR hcells U T hUb hTb hlog
    f g hf hg C D hC hD hCb hDb hμatom hνatom α ζ hζ
  have hL0 : 0 < L := by linarith
  have hL1 : 1 ≤ L := by linarith
  have hU0 : (0 : ℝ) < U := (Real.rpow_pos_of_pos hL0 q).trans_le hUb
  have hT0 : (0 : ℝ) < T := (Real.rpow_pos_of_pos hL0 q).trans_le hTb
  have hU : 0 < U := by exact_mod_cast hU0
  have hT : 0 < T := by exact_mod_cast hT0
  obtain ⟨u, r, β, hr, hcop, hα, hβ, hscale, hratio, hcase⟩ :=
    polynomial_dirichlet_dichotomy α L q U T hL1 hq hUb hTb
  rw [hα]
  rcases hcase with hmajorr | hminorr
  · have hrQ : r ≤ Q := by simpa only [hQfloor] using hmajorr
    have hpair := hmajor Q hQ P V i R W j hV hW hP hR hVP hWR
      a b a' b' hPi hRj ha hb ha' hb' h ξ hh hh2 hξ U T hU0.le hT0.le f g
      (fun v hv => ⟨by exact_mod_cast (hf v hv).1, by exact_mod_cast (hf v hv).2.le⟩)
      (fun v hv => ⟨by exact_mod_cast (hg v hv).1, by exact_mod_cast (hg v hv).2.le⟩)
      r hr hrQ u ζ β
    apply hpair.trans
    apply mul_le_mul_of_nonneg_right _ (Real.sqrt_nonneg _)
    have hQb : (Q : ℝ) ≤ L ^ q := by
      rw [hQfloor]
      exact Nat.floor_le (Real.rpow_pos_of_pos hL0 q).le
    have hnum := major_arc_coefficient_small hL (Nat.cast_nonneg Q) (by positivity)
      hξ.le hh.le (abs_nonneg ζ) (mul_nonneg (abs_nonneg β) (mul_pos hU0 hT0).le)
      (prime_kernel_error_nonneg hCM.le (hV i).le ha hξ.le hQ)
      (prime_kernel_error_nonneg hCM.le (hW j).le ha' hξ.le hQ) hq hd
      hQb hcells hξb hhb hζ hscale hεP hεR hxp hwp hdp
    convert hnum using 1 <;> first | rfl | (push_cast; ring)
  · have hpair := hminor Q hQ P V i R W j hV hW hP hR hVP hWR
      a b a' b' hPi hRj ha hb ha' hb' h ξ hh hh2 hξ hsmallP hsmallR
      U T hU hT f g hf hg C D hC hD hμatom hνatom r hr u hcop β hβ ζ
    apply hpair.trans
    apply mul_le_mul_of_nonneg_right _ (Real.sqrt_nonneg _)
    exact minor_arc_uniform_factor_le hL hC hD ht hq hparam hCb hDb
      hUb hTb hminorr.le hratio hlog

end Bounty
end

section

/- Increasing a memory cap commutes with the full/reduced active-state
split, its reassembly, and permutations of active or pending coordinates. -/

namespace Bounty

theorem activeMemorySplit_capEmbed {P Z : Type*} {M b B : ℕ}
    (S : Finset (Fin M)) (h : b ≤ B) (x : BoundedOrderedState P Z M b) :
    activeMemorySplit S B (boundedStateCapEmbed h x) =
      ((activeMemorySplit S b x).1, boundedStateCapEmbed h (activeMemorySplit S b x).2) := rfl

theorem activeMemorySplit_symm_capEmbed {P Z : Type*} {M b B : ℕ}
    (S : Finset (Fin M)) (h : b ≤ B) (c : Fin S.card → P)
    (y : BoundedOrderedState P Z Sᶜ.card b) :
    (activeMemorySplit S B).symm (c, boundedStateCapEmbed h y) =
      boundedStateCapEmbed h ((activeMemorySplit S b).symm (c, y)) := rfl

theorem productActiveMemorySplit_capEmbed_shared {G : Type*}
    {P Z : G → Type*} {M : G → ℕ} {b B : ℕ}
    (S : ∀ g, Finset (Fin (M g))) (h : b ≤ B)
    (x : ProductBoundedOrderedState P Z M b) :
    (productActiveMemorySplit S B (productStateCapEmbed h x)).1 =
      (productActiveMemorySplit S b x).1 := rfl

theorem productActiveMemorySplit_capEmbed_reduced {G : Type*}
    {P Z : G → Type*} {M : G → ℕ} {b B : ℕ}
    (S : ∀ g, Finset (Fin (M g))) (h : b ≤ B)
    (x : ProductBoundedOrderedState P Z M b) :
    (productActiveMemorySplit S B (productStateCapEmbed h x)).2 =
      productStateCapEmbed h (productActiveMemorySplit S b x).2 := rfl

theorem productActiveMemorySplit_capEmbed {G : Type*}
    {P Z : G → Type*} {M : G → ℕ} {b B : ℕ}
    (S : ∀ g, Finset (Fin (M g))) (h : b ≤ B)
    (x : ProductBoundedOrderedState P Z M b) :
    productActiveMemorySplit S B (productStateCapEmbed h x) =
      ((productActiveMemorySplit S b x).1,
        productStateCapEmbed h (productActiveMemorySplit S b x).2) := rfl

theorem productActiveMemorySplit_symm_capEmbed {G : Type*}
    {P Z : G → Type*} {M : G → ℕ} {b B : ℕ}
    (S : ∀ g, Finset (Fin (M g))) (h : b ≤ B) (c : SharedActiveLabels P S)
    (y : ProductBoundedOrderedState P Z (fun g => (S g)ᶜ.card) b) :
    (productActiveMemorySplit S B).symm (c, productStateCapEmbed h y) =
      productStateCapEmbed h ((productActiveMemorySplit S b).symm (c, y)) := rfl

theorem fullActivePermutation_capEmbed {G : Type*}
    {P Z : G → Type*} {M : G → ℕ} {b B : ℕ}
    (h : b ≤ B) (τ : FullActiveSlotPermutations M)
    (x : ProductBoundedOrderedState P Z M b) :
    fullActivePermutation τ (productStateCapEmbed h x) =
      productStateCapEmbed h (fullActivePermutation τ x) := rfl

theorem productMemoryPermuteAt_capEmbed {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {M : G → ℕ} {b B : ℕ}
    (h : b ≤ B) (x : ProductBoundedOrderedState P Z M b) (g : G)
    (τ : Equiv.Perm (Fin (x g).2.1.val)) :
    productMemoryPermuteAt (productStateCapEmbed h x) g τ =
      productStateCapEmbed h (productMemoryPermuteAt x g τ) := by
  funext k
  by_cases hkg : k = g
  · subst k
    change (productMemoryPermuteAt (productStateCapEmbed h x) g τ) g =
      boundedStateCapEmbed h ((productMemoryPermuteAt x g τ) g)
    simp only [productMemoryPermuteAt, Function.update_self]
    rfl
  · change (productMemoryPermuteAt (productStateCapEmbed h x) g τ) k =
      boundedStateCapEmbed h ((productMemoryPermuteAt x g τ) k)
    simp only [productMemoryPermuteAt, Function.update_of_ne hkg]
    rfl

theorem productStateCapEmbed_symmetric {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {M : G → ℕ} {b B : ℕ} {Y : Type*}
    (h : b ≤ B) (f : ProductBoundedOrderedState P Z M B → Y)
    (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric (fun x => f (productStateCapEmbed h x)) := by
  intro x g τ
  change f (productStateCapEmbed h (productMemoryPermuteAt x g τ)) =
    f (productStateCapEmbed h x)
  rw [← productMemoryPermuteAt_capEmbed]
  exact hf (productStateCapEmbed h x) g τ

end Bounty
end

section

/- Exact signed ghost-event transport between two memory caps.
Only supported events are used for target compatibility; invalid raw outputs
carry zero weight even when their fallback target has small memory. -/

open Finset Classical

namespace Bounty

section

variable {P Z : Type*} {t b B : ℕ} (h : b ≤ B)

def boundedGhostEventCapEmbed (s : BoundedOrderedState P Z t b)
    (e : BoundedGhostEvent t b s) :
    BoundedGhostEvent t B (boundedStateCapEmbed h s) :=
  ⟨⟨e.1.val, lt_of_lt_of_le e.1.isLt (Nat.add_le_add_right h 1)⟩, e.2⟩

theorem boundedGhostEventCapEmbed_injective (s : BoundedOrderedState P Z t b) :
    Function.Injective (boundedGhostEventCapEmbed h s) := by
  intro e f hef
  rcases e with ⟨⟨k, hk⟩, e⟩
  rcases f with ⟨⟨l, hl⟩, f⟩
  have hkl : k = l := congrArg (fun x => x.1.val) hef
  subst l
  have hef' : e = f := by
    exact eq_of_heq (Sigma.mk.inj_iff.mp hef).2
  subst f
  rfl

theorem boundedGhostEventCapEmbed_target (s : BoundedOrderedState P Z t b)
    (e : BoundedGhostEvent t b s) (he : e.2.1.card + e.1.val ≤ b) :
    boundedGhostEventTarget t B (boundedStateCapEmbed h s) (boundedGhostEventCapEmbed h s e) =
      boundedStateCapEmbed h (boundedGhostEventTarget t b s e) := by
  have heB := he.trans h
  unfold boundedGhostEventTarget
  rw [dif_pos (show (retainedBirthTuple (boundedStateCapEmbed h s).2.2
      (boundedGhostEventCapEmbed h s e).2.1 (boundedGhostEventCapEmbed h s e).2.2).1 ≤ B from heB)]
  rw [dif_pos (show (retainedBirthTuple s.2.2 e.2.1 e.2.2).1 ≤ b from he)]
  rfl

theorem boundedGhostEventWeight_valid (A D C ν : Z → ℝ)
    (s : BoundedOrderedState P Z t b) (e : BoundedGhostEvent t b s)
    (he : boundedGhostEventWeight A D C ν t b s e ≠ 0) :
    e.2.1.card + e.1.val ≤ b := by
  by_contra hbad
  exact he (by simp [boundedGhostEventWeight, hbad])

theorem boundedGhostEventCapEmbed_target_of_ne_zero (A D C ν : Z → ℝ)
    (s : BoundedOrderedState P Z t b) (e : BoundedGhostEvent t b s)
    (he : boundedGhostEventWeight A D C ν t b s e ≠ 0) :
    boundedGhostEventTarget t B (boundedStateCapEmbed h s) (boundedGhostEventCapEmbed h s e) =
      boundedStateCapEmbed h (boundedGhostEventTarget t b s e) := by
  exact boundedGhostEventCapEmbed_target h s e (boundedGhostEventWeight_valid A D C ν s e he)

theorem boundedGhostEventCapEmbed_weight (A D C ν : Z → ℝ)
    (s : BoundedOrderedState P Z t b) (e : BoundedGhostEvent t b s) :
    boundedGhostEventWeight A D C ν t b s e =
      if (boundedGhostEventTarget t B (boundedStateCapEmbed h s)
          (boundedGhostEventCapEmbed h s e)).2.1.val ≤ b then
        boundedGhostEventWeight A D C ν t B (boundedStateCapEmbed h s)
          (boundedGhostEventCapEmbed h s e)
      else 0 := by
  by_cases he : e.2.1.card + e.1.val ≤ b
  · have heB := he.trans h
    simp [boundedGhostEventWeight, boundedGhostEventTarget, retainedBirthTuple,
      boundedGhostEventCapEmbed, boundedStateCapEmbed, boundedMemoryCapEmbed, he, heB]
    rfl
  · by_cases heB : e.2.1.card + e.1.val ≤ B
    · simp [boundedGhostEventWeight, boundedGhostEventTarget, retainedBirthTuple,
        boundedGhostEventCapEmbed, boundedStateCapEmbed, boundedMemoryCapEmbed, he, heB]
    · simp only [boundedGhostEventWeight, boundedGhostEventCapEmbed,
        boundedStateCapEmbed, boundedMemoryCapEmbed, he, heB, ite_false, ite_self]

theorem boundedGhostEventCapEmbed_surjective_of_ne_zero (A D C ν : Z → ℝ)
    (s : BoundedOrderedState P Z t b)
    (e : BoundedGhostEvent t B (boundedStateCapEmbed h s))
    (hw : boundedGhostEventWeight A D C ν t B (boundedStateCapEmbed h s) e ≠ 0)
    (ht : (boundedGhostEventTarget t B (boundedStateCapEmbed h s) e).2.1.val ≤ b) :
    ∃ d : BoundedGhostEvent t b s, boundedGhostEventCapEmbed h s d = e := by
  have hv := boundedGhostEventWeight_valid A D C ν (boundedStateCapEmbed h s) e hw
  have ht' : e.2.1.card + e.1.val ≤ b := by
    unfold boundedGhostEventTarget at ht
    rw [dif_pos (show (retainedBirthTuple (boundedStateCapEmbed h s).2.2 e.2.1 e.2.2).1 ≤ B from hv)] at ht
    exact ht
  have hb : e.1.val < b + 1 := by omega
  exact ⟨⟨⟨e.1.val, hb⟩, e.2⟩, rfl⟩

theorem boundedGhostEventCapEmbed_support (A D C ν : Z → ℝ)
    (s : BoundedOrderedState P Z t b) (e : BoundedGhostEvent t b s) :
    boundedGhostEventWeight A D C ν t b s e ≠ 0 ↔
      boundedGhostEventWeight A D C ν t B (boundedStateCapEmbed h s)
        (boundedGhostEventCapEmbed h s e) ≠ 0 ∧
      (boundedGhostEventTarget t B (boundedStateCapEmbed h s)
        (boundedGhostEventCapEmbed h s e)).2.1.val ≤ b := by
  rw [boundedGhostEventCapEmbed_weight h A D C ν s e]
  split_ifs <;> simp_all

theorem boundedGhostEventCapEmbed_weight_of_ne_zero (A D C ν : Z → ℝ)
    (s : BoundedOrderedState P Z t b) (e : BoundedGhostEvent t b s)
    (he : boundedGhostEventWeight A D C ν t b s e ≠ 0) :
    boundedGhostEventWeight A D C ν t B (boundedStateCapEmbed h s)
      (boundedGhostEventCapEmbed h s e) = boundedGhostEventWeight A D C ν t b s e := by
  have ht := ((boundedGhostEventCapEmbed_support h A D C ν s e).mp he).2
  exact ((boundedGhostEventCapEmbed_weight h A D C ν s e).trans (if_pos ht)).symm

noncomputable def boundedGhostEventCapSupportEquiv (A D C ν : Z → ℝ)
    (s : BoundedOrderedState P Z t b) :
    {e : BoundedGhostEvent t b s // boundedGhostEventWeight A D C ν t b s e ≠ 0} ≃
    {e : BoundedGhostEvent t B (boundedStateCapEmbed h s) //
      boundedGhostEventWeight A D C ν t B (boundedStateCapEmbed h s) e ≠ 0 ∧
      (boundedGhostEventTarget t B (boundedStateCapEmbed h s) e).2.1.val ≤ b} :=
  Equiv.ofBijective (fun e => ⟨boundedGhostEventCapEmbed h s e.val,
    (boundedGhostEventCapEmbed_support h A D C ν s e.val).mp e.property⟩) ⟨by
      intro e f hef
      apply Subtype.ext
      exact boundedGhostEventCapEmbed_injective h s (congrArg Subtype.val hef), by
    intro e
    obtain ⟨d, hd⟩ := boundedGhostEventCapEmbed_surjective_of_ne_zero h A D C ν s e.val
      e.property.1 e.property.2
    have hs := (boundedGhostEventCapEmbed_support h A D C ν s d).mpr (by simpa only [hd] using e.property)
    exact ⟨⟨d, hs⟩, Subtype.ext hd⟩⟩

theorem bounded_ghost_event_cap_sum [Fintype Z] (A D C ν : Z → ℝ)
    (s : BoundedOrderedState P Z t b)
    (F : BoundedGhostEvent t B (boundedStateCapEmbed h s) → ℂ) :
    (∑ e : BoundedGhostEvent t b s,
      (boundedGhostEventWeight A D C ν t b s e : ℂ) * F (boundedGhostEventCapEmbed h s e)) =
    ∑ e : BoundedGhostEvent t B (boundedStateCapEmbed h s),
      if (boundedGhostEventTarget t B (boundedStateCapEmbed h s) e).2.1.val ≤ b then
        (boundedGhostEventWeight A D C ν t B (boundedStateCapEmbed h s) e : ℂ) * F e
      else 0 := by
  apply Fintype.sum_of_injective (boundedGhostEventCapEmbed h s)
    (boundedGhostEventCapEmbed_injective h s)
  · intro e he
    by_cases ht : (boundedGhostEventTarget t B (boundedStateCapEmbed h s) e).2.1.val ≤ b
    · have hw : boundedGhostEventWeight A D C ν t B (boundedStateCapEmbed h s) e = 0 := by
        by_contra hw
        exact he (boundedGhostEventCapEmbed_surjective_of_ne_zero h A D C ν s e hw ht)
      simp [ht, hw]
    · simp [ht]
  · intro e
    rw [boundedGhostEventCapEmbed_weight h A D C ν s e]
    split_ifs <;> simp

end

end Bounty
end

section

/- Exact transport of bounded edge events between memory capacities.
The choices do not depend on the cap. Targets commute on supported small
events; invalid large targets are handled through their zero coefficient. -/

open Finset Classical

namespace Bounty

def unrestrictedBoundedEventCapEquiv {P : Type*} (n : P → ℕ) (Δ D : ℤ) (t : ℕ)
    {b B : ℕ} (h : b ≤ B) (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t b) :
    UnrestrictedBoundedEvent n Δ D t b s ≃
      UnrestrictedBoundedEvent n Δ D t B (boundedStateCapEmbed h s) := Equiv.refl _

theorem unrestrictedBoundedEventCapEquiv_apply {P : Type*} (n : P → ℕ) (Δ D : ℤ) (t : ℕ)
    {b B : ℕ} (h : b ≤ B) (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t b)
    (e : UnrestrictedBoundedEvent n Δ D t b s) :
    unrestrictedBoundedEventCapEquiv n Δ D t h s e = e := rfl

theorem unrestrictedBoundedEventTarget_cap_of_output_le {P : Type*} (n : P → ℕ)
    (Δ D : ℤ) (t : ℕ) {b B : ℕ} (h : b ≤ B)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t b)
    (e : UnrestrictedBoundedEvent n Δ D t b s)
    (hout : (unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
      (unrestrictedResidueTransport n Δ) e.1 e.2.1 e.2.2.1).1 ≤ b) :
    boundedStateCapEmbed h (unrestrictedBoundedEventTarget n Δ D t b s e) =
      unrestrictedBoundedEventTarget n Δ D t B (boundedStateCapEmbed h s)
        (unrestrictedBoundedEventCapEquiv n Δ D t h s e) := by
  rw [unrestrictedBoundedEventCapEquiv_apply]
  dsimp only [unrestrictedBoundedEventTarget, boundedStateCapEmbed, boundedMemoryCapEmbed]
  rw [dif_pos hout, dif_pos (hout.trans h)]

theorem unrestrictedBoundedEventTarget_cap_of_weight_ne_zero {P : Type*} (n : P → ℕ)
    (Δ D : ℤ) (μ : P → ℝ) (ρ V : ℝ) (t : ℕ) {b B : ℕ} (h : b ≤ B)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t b)
    (e : UnrestrictedBoundedEvent n Δ D t b s)
    (hw : unrestrictedBoundedEventWeight n Δ D μ ρ V t b s e ≠ 0) :
    boundedStateCapEmbed h (unrestrictedBoundedEventTarget n Δ D t b s e) =
      unrestrictedBoundedEventTarget n Δ D t B (boundedStateCapEmbed h s)
        (unrestrictedBoundedEventCapEquiv n Δ D t h s e) := by
  apply unrestrictedBoundedEventTarget_cap_of_output_le n Δ D t h s e
  by_contra hout
  exact hw (by simp only [unrestrictedBoundedEventWeight, hout, and_false, if_false])

theorem unrestrictedBoundedEventWeight_cap {P : Type*} (n : P → ℕ)
    (Δ D : ℤ) (μ : P → ℝ) (ρ V : ℝ) (t : ℕ) {b B : ℕ} (h : b ≤ B)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t b)
    (e : UnrestrictedBoundedEvent n Δ D t b s) :
    unrestrictedBoundedEventWeight n Δ D μ ρ V t b s e =
      if (unrestrictedBoundedEventTarget n Δ D t B (boundedStateCapEmbed h s)
          (unrestrictedBoundedEventCapEquiv n Δ D t h s e)).2.1.val ≤ b
      then unrestrictedBoundedEventWeight n Δ D μ ρ V t B (boundedStateCapEmbed h s)
        (unrestrictedBoundedEventCapEquiv n Δ D t h s e)
      else 0 := by
  simp only [unrestrictedBoundedEventCapEquiv_apply]
  dsimp only [unrestrictedBoundedEventWeight, unrestrictedBoundedEventTarget,
    boundedStateCapEmbed, boundedMemoryCapEmbed]
  by_cases hb : (unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
      (unrestrictedResidueTransport n Δ) e.1 e.2.1 e.2.2.1).1 ≤ b
  · have hB := hb.trans h
    simp only [hb, hB, and_true, dif_pos, if_pos]
  · by_cases hB : (unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
        (unrestrictedResidueTransport n Δ) e.1 e.2.1 e.2.2.1).1 ≤ B
    · simp only [hb, hB, and_false, and_true, dif_pos, if_false]
    · simp only [hb, hB, and_false, if_false, ite_self]

theorem unrestrictedBoundedEvent_cap_term {P : Type*} (n : P → ℕ)
    (Δ D : ℤ) (μ : P → ℝ) (ρ V : ℝ) (t : ℕ) {b B : ℕ} (h : b ≤ B)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t b)
    (F : UnrestrictedBoundedEvent n Δ D t B (boundedStateCapEmbed h s) →
      BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
    (e : UnrestrictedBoundedEvent n Δ D t b s) :
    (unrestrictedBoundedEventWeight n Δ D μ ρ V t b s e : ℂ) *
      F (unrestrictedBoundedEventCapEquiv n Δ D t h s e)
        (boundedStateCapEmbed h (unrestrictedBoundedEventTarget n Δ D t b s e)) =
      if (unrestrictedBoundedEventTarget n Δ D t B (boundedStateCapEmbed h s)
          (unrestrictedBoundedEventCapEquiv n Δ D t h s e)).2.1.val ≤ b
      then (unrestrictedBoundedEventWeight n Δ D μ ρ V t B (boundedStateCapEmbed h s)
          (unrestrictedBoundedEventCapEquiv n Δ D t h s e) : ℂ) *
        F (unrestrictedBoundedEventCapEquiv n Δ D t h s e)
          (unrestrictedBoundedEventTarget n Δ D t B (boundedStateCapEmbed h s)
            (unrestrictedBoundedEventCapEquiv n Δ D t h s e))
      else 0 := by
  have hw := unrestrictedBoundedEventWeight_cap n Δ D μ ρ V t h s e
  by_cases hz : unrestrictedBoundedEventWeight n Δ D μ ρ V t b s e = 0
  · rw [hz] at hw
    simp only [hz, Complex.ofReal_zero, zero_mul]
    split_ifs at hw ⊢ with hc
    · rw [← hw]
      simp only [Complex.ofReal_zero, zero_mul]
    · rfl
  · rw [unrestrictedBoundedEventTarget_cap_of_weight_ne_zero n Δ D μ ρ V t h s e hz, hw]
    split_ifs <;> simp only [Complex.ofReal_zero, zero_mul]

theorem unrestrictedBoundedEvent_cap_sum {P : Type*} [Fintype P] (n : P → ℕ)
    (Δ D : ℤ) (μ : P → ℝ) (ρ V : ℝ) (t : ℕ) {b B : ℕ} (h : b ≤ B)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t b)
    (F : UnrestrictedBoundedEvent n Δ D t B (boundedStateCapEmbed h s) →
      BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ) :
    (∑ e : UnrestrictedBoundedEvent n Δ D t b s,
      (unrestrictedBoundedEventWeight n Δ D μ ρ V t b s e : ℂ) *
        F (unrestrictedBoundedEventCapEquiv n Δ D t h s e)
          (boundedStateCapEmbed h (unrestrictedBoundedEventTarget n Δ D t b s e))) =
      ∑ e : UnrestrictedBoundedEvent n Δ D t B (boundedStateCapEmbed h s),
        if (unrestrictedBoundedEventTarget n Δ D t B (boundedStateCapEmbed h s) e).2.1.val ≤ b
        then (unrestrictedBoundedEventWeight n Δ D μ ρ V t B (boundedStateCapEmbed h s) e : ℂ) *
          F e (unrestrictedBoundedEventTarget n Δ D t B (boundedStateCapEmbed h s) e)
        else 0 := by
  simp_rw [unrestrictedBoundedEvent_cap_term]
  rfl

end Bounty
end

section

/- Zero-weight events can be removed before transporting paths. This keeps
arbitrary event-dependent phases while avoiding constraints on fallback targets. -/

open Finset Classical

namespace Bounty

universe uK uX uE

abbrev FiniteNonzeroEvent {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (w : ∀ k x, E k x → ℝ) (k : K) (x : X) :=
  {a : E k x // w k x a ≠ 0}

def finiteNonzeroTarget {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X)
    (w : ∀ k x, E k x → ℝ) (k : K) (x : X) (a : FiniteNonzeroEvent E w k x) : X :=
  t k x a.val

def finiteNonzeroPathForget {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ) :
    ∀ ks x, FiniteEventPath (FiniteNonzeroEvent E w) (finiteNonzeroTarget E t w) ks x →
      FiniteEventPath E t ks x
  | [], _, _ => PUnit.unit
  | _ :: ks, _, ⟨a, p⟩ => ⟨a.val, finiteNonzeroPathForget E t w ks _ p⟩

def finiteNonzeroPathLift {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ) :
    ∀ ks x (p : FiniteEventPath E t ks x), finiteEventPathWeight E t w ks x p ≠ 0 →
      FiniteEventPath (FiniteNonzeroEvent E w) (finiteNonzeroTarget E t w) ks x
  | [], _, _, _ => PUnit.unit
  | k :: ks, x, ⟨a, p⟩, h =>
      ⟨⟨a, (mul_ne_zero_iff.mp h).1⟩,
        finiteNonzeroPathLift E t w ks (t k x a) p (mul_ne_zero_iff.mp h).2⟩

theorem finite_nonzero_path_forget_lift {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (ks : List K) (x : X) (p : FiniteEventPath E t ks x)
    (h : finiteEventPathWeight E t w ks x p ≠ 0) :
    finiteNonzeroPathForget E t w ks x (finiteNonzeroPathLift E t w ks x p h) = p := by
  induction ks generalizing x with
  | nil => cases p; rfl
  | cons k ks ih =>
    rcases p with ⟨a, p⟩
    change (⟨a, finiteNonzeroPathForget E t w ks _ (finiteNonzeroPathLift E t w ks _ p _)⟩ :
      FiniteEventPath E t (k :: ks) x) = ⟨a, p⟩
    rw [ih]

theorem finite_nonzero_path_weight {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (ks : List K) (x : X)
    (p : FiniteEventPath (FiniteNonzeroEvent E w) (finiteNonzeroTarget E t w) ks x) :
    finiteEventPathWeight E t w ks x (finiteNonzeroPathForget E t w ks x p) =
      finiteEventPathWeight (FiniteNonzeroEvent E w) (finiteNonzeroTarget E t w)
        (fun k x a => w k x a.val) ks x p := by
  induction ks generalizing x with
  | nil => rfl
  | cons k ks ih =>
    rcases p with ⟨a, p⟩
    exact congrArg (w k x a.val * ·) (ih _ p)

theorem finite_nonzero_path_weight_ne_zero {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (ks : List K) (x : X)
    (p : FiniteEventPath (FiniteNonzeroEvent E w) (finiteNonzeroTarget E t w) ks x) :
    finiteEventPathWeight E t w ks x (finiteNonzeroPathForget E t w ks x p) ≠ 0 := by
  induction ks generalizing x with
  | nil => exact one_ne_zero
  | cons k ks ih =>
    rcases p with ⟨a, p⟩
    exact mul_ne_zero a.property (ih _ p)

theorem finite_nonzero_path_terminal {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (ks : List K) (x : X)
    (p : FiniteEventPath (FiniteNonzeroEvent E w) (finiteNonzeroTarget E t w) ks x) :
    finiteEventPathTerminal E t ks x (finiteNonzeroPathForget E t w ks x p) =
      finiteEventPathTerminal (FiniteNonzeroEvent E w) (finiteNonzeroTarget E t w) ks x p := by
  induction ks generalizing x with
  | nil => rfl
  | cons k ks ih =>
    rcases p with ⟨a, p⟩
    exact ih _ p

theorem finite_nonzero_path_lift_forget {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (ks : List K) (x : X)
    (p : FiniteEventPath (FiniteNonzeroEvent E w) (finiteNonzeroTarget E t w) ks x) :
    finiteNonzeroPathLift E t w ks x (finiteNonzeroPathForget E t w ks x p)
      (finite_nonzero_path_weight_ne_zero E t w ks x p) = p := by
  induction ks generalizing x with
  | nil => cases p; rfl
  | cons k ks ih =>
    rcases p with ⟨a, p⟩
    change (⟨a, finiteNonzeroPathLift E t w ks _ (finiteNonzeroPathForget E t w ks _ p) _⟩ :
      FiniteEventPath (FiniteNonzeroEvent E w) (finiteNonzeroTarget E t w) (k :: ks) x) = ⟨a, p⟩
    rw [ih]

def finiteNonzeroPathEquiv {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (ks : List K) (x : X) :
    FiniteEventPath (FiniteNonzeroEvent E w) (finiteNonzeroTarget E t w) ks x ≃
      {p : FiniteEventPath E t ks x // finiteEventPathWeight E t w ks x p ≠ 0} where
  toFun p := ⟨finiteNonzeroPathForget E t w ks x p, finite_nonzero_path_weight_ne_zero E t w ks x p⟩
  invFun p := finiteNonzeroPathLift E t w ks x p.val p.property
  left_inv := finite_nonzero_path_lift_forget E t w ks x
  right_inv p := Subtype.ext (finite_nonzero_path_forget_lift E t w ks x p.val p.property)

end Bounty
end

section

/- Path transport needs event equivalences only on an invariant set of states. -/

open Finset Classical

namespace Bounty

universe uK uX uY uE uF

def finiteInvariantPathEquiv {K : Type uK} {X : Type uX} {Y : Type uY}
    (E : K → X → Type uE) (F : K → Y → Type uF)
    (t : ∀ k x, E k x → X) (u : ∀ k y, F k y → Y)
    (e : X → Y) (P : X → Prop)
    (closed : ∀ k x, P x → ∀ a, P (t k x a))
    (δ : ∀ k x, P x → E k x ≃ F k (e x))
    (ht : ∀ k x (hx : P x) a, e (t k x a) = u k (e x) (δ k x hx a)) :
    ∀ ks x, P x → FiniteEventPath E t ks x ≃ FiniteEventPath F u ks (e x)
  | [], _, _ => Equiv.punitEquivPUnit
  | k :: ks, x, hx => Equiv.sigmaCongr (δ k x hx) (fun a =>
      (finiteInvariantPathEquiv E F t u e P closed δ ht ks (t k x a) (closed k x hx a)).trans
        (Equiv.cast (congrArg (FiniteEventPath F u ks) (ht k x hx a))))

theorem finite_invariant_path_equiv_terminal {K : Type uK} {X : Type uX} {Y : Type uY}
    (E : K → X → Type uE) (F : K → Y → Type uF)
    (t : ∀ k x, E k x → X) (u : ∀ k y, F k y → Y)
    (e : X → Y) (P : X → Prop)
    (closed : ∀ k x, P x → ∀ a, P (t k x a))
    (δ : ∀ k x, P x → E k x ≃ F k (e x))
    (ht : ∀ k x (hx : P x) a, e (t k x a) = u k (e x) (δ k x hx a))
    (ks : List K) (x : X) (hx : P x) (p : FiniteEventPath E t ks x) :
    finiteEventPathTerminal F u ks (e x) (finiteInvariantPathEquiv E F t u e P closed δ ht ks x hx p) =
      e (finiteEventPathTerminal E t ks x p) := by
  induction ks generalizing x with
  | nil => rfl
  | cons k ks ih =>
    rcases p with ⟨a, p⟩
    change finiteEventPathTerminal F u ks _
      (cast (congrArg (FiniteEventPath F u ks) (ht k x hx a))
        (finiteInvariantPathEquiv E F t u e P closed δ ht ks (t k x a) (closed k x hx a) p)) = _
    rw [finite_event_path_terminal_cast F u ks (ht k x hx a)]
    exact ih _ (closed k x hx a) p

theorem finite_invariant_path_equiv_weight {K : Type uK} {X : Type uX} {Y : Type uY}
    (E : K → X → Type uE) (F : K → Y → Type uF)
    (t : ∀ k x, E k x → X) (u : ∀ k y, F k y → Y)
    (e : X → Y) (P : X → Prop)
    (closed : ∀ k x, P x → ∀ a, P (t k x a))
    (δ : ∀ k x, P x → E k x ≃ F k (e x))
    (ht : ∀ k x (hx : P x) a, e (t k x a) = u k (e x) (δ k x hx a))
    (w : ∀ k x, E k x → ℝ) (v : ∀ k y, F k y → ℝ)
    (hw : ∀ k x (hx : P x) a, v k (e x) (δ k x hx a) = w k x a)
    (ks : List K) (x : X) (hx : P x) (p : FiniteEventPath E t ks x) :
    finiteEventPathWeight F u v ks (e x) (finiteInvariantPathEquiv E F t u e P closed δ ht ks x hx p) =
      finiteEventPathWeight E t w ks x p := by
  induction ks generalizing x with
  | nil => rfl
  | cons k ks ih =>
    rcases p with ⟨a, p⟩
    change v k (e x) (δ k x hx a) * finiteEventPathWeight F u v ks _
      (cast (congrArg (FiniteEventPath F u ks) (ht k x hx a))
        (finiteInvariantPathEquiv E F t u e P closed δ ht ks (t k x a) (closed k x hx a) p)) = _
    rw [hw, finite_event_path_weight_cast F u v ks (ht k x hx a), ih]
    rfl

theorem finite_invariant_path_action_equiv {K : Type uK} {X : Type uX} {Y : Type uY}
    (E : K → X → Type uE) (F : K → Y → Type uF)
    [∀ k x, Fintype (E k x)] [∀ k y, Fintype (F k y)]
    (t : ∀ k x, E k x → X) (u : ∀ k y, F k y → Y)
    (e : X → Y) (P : X → Prop)
    (closed : ∀ k x, P x → ∀ a, P (t k x a))
    (δ : ∀ k x, P x → E k x ≃ F k (e x))
    (ht : ∀ k x (hx : P x) a, e (t k x a) = u k (e x) (δ k x hx a))
    (w : ∀ k x, E k x → ℝ) (v : ∀ k y, F k y → ℝ)
    (hw : ∀ k x (hx : P x) a, v k (e x) (δ k x hx a) = w k x a)
    (ks : List K) (phase : ∀ y, FiniteEventPath F u ks y → ℂ)
    (f : Y → ℂ) (x : X) (hx : P x) :
    finiteEventPathAction E t w ks
        (fun x p => if hx : P x then phase (e x) (finiteInvariantPathEquiv E F t u e P closed δ ht ks x hx p) else 0) (fun x => f (e x)) x =
      finiteEventPathAction F u v ks phase f (e x) := by
  let _ := finiteEventPathFintype E t ks x
  let _ := finiteEventPathFintype F u ks (e x)
  have h := Equiv.sum_comp (finiteInvariantPathEquiv E F t u e P closed δ ht ks x hx)
    (fun p => (finiteEventPathWeight F u v ks (e x) p : ℂ) * phase (e x) p *
      f (finiteEventPathTerminal F u ks (e x) p))
  simpa only [finiteEventPathAction, dif_pos hx, finite_invariant_path_equiv_weight E F t u e P closed δ ht w v hw,
    finite_invariant_path_equiv_terminal E F t u e P closed δ ht] using h

end Bounty
end

section

/- Exact selection of event paths by an arbitrary predicate on each event. -/

open Finset Classical

namespace Bounty

universe uK uX uE

abbrev FiniteSelectedEvent {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (Q : ∀ k x, E k x → Prop) (k : K) (x : X) :=
  {a : E k x // Q k x a}

def finiteSelectedTarget {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X)
    (Q : ∀ k x, E k x → Prop) (k : K) (x : X) (a : FiniteSelectedEvent E Q k x) : X :=
  t k x a.val

def FiniteEventPathSelected {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X) (Q : ∀ k x, E k x → Prop) :
    ∀ ks x, FiniteEventPath E t ks x → Prop
  | [], _, _ => True
  | k :: ks, x, ⟨a, p⟩ => Q k x a ∧ FiniteEventPathSelected E t Q ks (t k x a) p

def finiteSelectedPathForget {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X) (Q : ∀ k x, E k x → Prop) :
    ∀ ks x, FiniteEventPath (FiniteSelectedEvent E Q) (finiteSelectedTarget E t Q) ks x →
      FiniteEventPath E t ks x
  | [], _, _ => PUnit.unit
  | _ :: ks, _, ⟨a, p⟩ => ⟨a.val, finiteSelectedPathForget E t Q ks _ p⟩

def finiteSelectedPathLift {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X) (Q : ∀ k x, E k x → Prop) :
    ∀ ks x (p : FiniteEventPath E t ks x), FiniteEventPathSelected E t Q ks x p →
      FiniteEventPath (FiniteSelectedEvent E Q) (finiteSelectedTarget E t Q) ks x
  | [], _, _, _ => PUnit.unit
  | k :: ks, x, ⟨a, p⟩, h =>
      ⟨⟨a, h.1⟩,
        finiteSelectedPathLift E t Q ks (t k x a) p h.2⟩

theorem finite_selected_path_forget_lift {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X) (Q : ∀ k x, E k x → Prop)
    (ks : List K) (x : X) (p : FiniteEventPath E t ks x)
    (h : FiniteEventPathSelected E t Q ks x p) :
    finiteSelectedPathForget E t Q ks x (finiteSelectedPathLift E t Q ks x p h) = p := by
  induction ks generalizing x with
  | nil => cases p; rfl
  | cons k ks ih =>
    rcases p with ⟨a, p⟩
    change (⟨a, finiteSelectedPathForget E t Q ks _ (finiteSelectedPathLift E t Q ks _ p _)⟩ :
      FiniteEventPath E t (k :: ks) x) = ⟨a, p⟩
    rw [ih]

theorem finite_selected_path_weight {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X) (Q : ∀ k x, E k x → Prop)
    (w : ∀ k x, E k x → ℝ) (ks : List K) (x : X)
    (p : FiniteEventPath (FiniteSelectedEvent E Q) (finiteSelectedTarget E t Q) ks x) :
    finiteEventPathWeight E t w ks x (finiteSelectedPathForget E t Q ks x p) =
      finiteEventPathWeight (FiniteSelectedEvent E Q) (finiteSelectedTarget E t Q)
        (fun k x a => w k x a.val) ks x p := by
  induction ks generalizing x with
  | nil => rfl
  | cons k ks ih =>
    rcases p with ⟨a, p⟩
    exact congrArg (w k x a.val * ·) (ih _ p)

theorem finite_selected_path_selected {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X) (Q : ∀ k x, E k x → Prop)
    (ks : List K) (x : X)
    (p : FiniteEventPath (FiniteSelectedEvent E Q) (finiteSelectedTarget E t Q) ks x) :
    FiniteEventPathSelected E t Q ks x (finiteSelectedPathForget E t Q ks x p) := by
  induction ks generalizing x with
  | nil => trivial
  | cons k ks ih =>
    rcases p with ⟨a, p⟩
    exact ⟨a.property, ih _ p⟩

theorem finite_selected_path_terminal {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X) (Q : ∀ k x, E k x → Prop)
    (ks : List K) (x : X)
    (p : FiniteEventPath (FiniteSelectedEvent E Q) (finiteSelectedTarget E t Q) ks x) :
    finiteEventPathTerminal E t ks x (finiteSelectedPathForget E t Q ks x p) =
      finiteEventPathTerminal (FiniteSelectedEvent E Q) (finiteSelectedTarget E t Q) ks x p := by
  induction ks generalizing x with
  | nil => rfl
  | cons k ks ih =>
    rcases p with ⟨a, p⟩
    exact ih _ p

theorem finite_selected_path_lift_forget {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X) (Q : ∀ k x, E k x → Prop)
    (ks : List K) (x : X)
    (p : FiniteEventPath (FiniteSelectedEvent E Q) (finiteSelectedTarget E t Q) ks x) :
    finiteSelectedPathLift E t Q ks x (finiteSelectedPathForget E t Q ks x p)
      (finite_selected_path_selected E t Q ks x p) = p := by
  induction ks generalizing x with
  | nil => cases p; rfl
  | cons k ks ih =>
    rcases p with ⟨a, p⟩
    change (⟨a, finiteSelectedPathLift E t Q ks _ (finiteSelectedPathForget E t Q ks _ p) _⟩ :
      FiniteEventPath (FiniteSelectedEvent E Q) (finiteSelectedTarget E t Q) (k :: ks) x) = ⟨a, p⟩
    rw [ih]

def finiteSelectedPathEquiv {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X) (Q : ∀ k x, E k x → Prop)
    (ks : List K) (x : X) :
    FiniteEventPath (FiniteSelectedEvent E Q) (finiteSelectedTarget E t Q) ks x ≃
      {p : FiniteEventPath E t ks x // FiniteEventPathSelected E t Q ks x p} where
  toFun p := ⟨finiteSelectedPathForget E t Q ks x p, finite_selected_path_selected E t Q ks x p⟩
  invFun p := finiteSelectedPathLift E t Q ks x p.val p.property
  left_inv := finite_selected_path_lift_forget E t Q ks x
  right_inv p := Subtype.ext (finite_selected_path_forget_lift E t Q ks x p.val p.property)

end Bounty
end

section

/- Increasing the per-group memory cap embeds the old finite measure
without changing any mass. Pullback decreases energy, and extension by
zero outside the image preserves it exactly. -/

open Finset Classical

namespace Bounty

section

variable {G : Type*} [Fintype G] [DecidableEq G] {P Z : G → Type*}
  [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)] {M : G → ℕ} {b B : ℕ}
  (h : b ≤ B) (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)

theorem product_cap_pullback_energy_eq_image
    (F : ProductBoundedOrderedState P Z M B → ℂ) :
    finiteWeightedEnergy (productMemoryWeight μ ν) (fun x => F (productStateCapEmbed h x)) =
      ∑ y ∈ (univ : Finset (ProductBoundedOrderedState P Z M b)).image (productStateCapEmbed h),
        productMemoryWeight μ ν y * ‖F y‖ ^ 2 := by
  rw [sum_image (productStateCapEmbed_injective h).injOn]
  rfl

theorem product_cap_pullback_energy_le
    (hμ : ∀ g p, 0 ≤ μ g p) (hν : ∀ g z, 0 ≤ ν g z)
    (F : ProductBoundedOrderedState P Z M B → ℂ) :
    finiteWeightedEnergy (productMemoryWeight μ ν) (fun x => F (productStateCapEmbed h x)) ≤
      finiteWeightedEnergy (productMemoryWeight μ ν) F := by
  rw [product_cap_pullback_energy_eq_image]
  exact sum_le_sum_of_subset_of_nonneg (subset_univ _)
    (fun y _ _ => mul_nonneg (productMemoryWeight_nonneg μ ν hμ hν y) (sq_nonneg _))

theorem product_cap_cutoff_pullback_energy_le
    (hμ : ∀ g p, 0 ≤ μ g p) (hν : ∀ g z, 0 ≤ ν g z)
    (F : ProductBoundedOrderedState P Z M B → ℂ) :
    finiteWeightedEnergy (productMemoryWeight μ ν)
        (productMemoryCutoff (fun x => F (productStateCapEmbed h x))) ≤
      finiteWeightedEnergy (productMemoryWeight μ ν) F :=
  (productMemoryCutoff_energy_le μ ν hμ hν _).trans
    (product_cap_pullback_energy_le h μ ν hμ hν F)

noncomputable def productCapZeroExtension
    (f : ProductBoundedOrderedState P Z M b → ℂ) :
    ProductBoundedOrderedState P Z M B → ℂ :=
  Function.extend (productStateCapEmbed h) f 0

omit [Fintype G] [DecidableEq G] [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)] in
theorem productCapZeroExtension_apply
    (f : ProductBoundedOrderedState P Z M b → ℂ)
    (x : ProductBoundedOrderedState P Z M b) :
    productCapZeroExtension h f (productStateCapEmbed h x) = f x :=
  (productStateCapEmbed_injective h).extend_apply f 0 x

theorem product_cap_zero_extension_energy
    (f : ProductBoundedOrderedState P Z M b → ℂ) :
    finiteWeightedEnergy (productMemoryWeight μ ν) (productCapZeroExtension h f) =
      finiteWeightedEnergy (productMemoryWeight μ ν) f := by
  have hi : (univ : Finset (ProductBoundedOrderedState P Z M b)).image
      (productStateCapEmbed h) ⊆ univ := subset_univ _
  unfold finiteWeightedEnergy
  rw [← sum_subset hi (fun y _ hy => ?_)]
  · rw [sum_image (productStateCapEmbed_injective h).injOn]
    simp only [productCapZeroExtension_apply, productStateCapEmbed_weight]
  · have hy' : ¬ ∃ x, productStateCapEmbed h x = y := by
      intro hx
      obtain ⟨x, hx⟩ := hx
      exact hy (mem_image.mpr ⟨x, mem_univ x, hx⟩)
    rw [productCapZeroExtension, Function.extend_apply' (f := productStateCapEmbed h) f
      (0 : ProductBoundedOrderedState P Z M B → ℂ) y hy']
    simp only [Pi.zero_apply, norm_zero, zero_pow (by decide : 2 ≠ 0), mul_zero]

end

end Bounty
end

section

/- Exact prime convolution of the candidate coefficient with its normalized Q-zero remainder. -/

open Finset Filter

namespace Bounty

theorem candidate_Q_zero_prime_outside_pool {c L : ℝ} (hcL : 0 ≤ c * L)
    {p : ℕ} (hp : p ∈ candidateQBand (c * L) 0) :
    p.Prime ∧ p ∉ (candidatePIndices c L).biUnion (candidatePBand (c * L)) := by
  refine ⟨((mem_dyadicPrimeBand_iff (c * L) 1 (6/5) 0 p).mp hp).1, ?_⟩
  intro hP
  obtain ⟨j, _, hpj⟩ := mem_biUnion.mp hP
  exact disjoint_left.mp (disjoint_candidatePBand_candidateQBand hcL j 0) hpj hp

theorem candidate_marked_weight_div_Q_zero {c L : ℝ} (hcL : 0 ≤ c * L)
    (q : ℝ) {p u : ℕ} (hp : p ∈ candidateQBand (c * L) 0) (hpu : p ∣ u) :
    markedDivisorWeight (candidatePIndices c L) (candidatePBand (c * L)) q
      (fun j => ∑ a ∈ candidatePBand (c * L) j, 1 / (a : ℝ)) (fun _ => 1) ((u / p : ℕ) : ℤ) =
    markedDivisorWeight (candidatePIndices c L) (candidatePBand (c * L)) q
      (fun j => ∑ a ∈ candidatePBand (c * L) j, 1 / (a : ℝ)) (fun _ => 1) (u : ℤ) := by
  obtain ⟨hpp, hpP⟩ := candidate_Q_zero_prime_outside_pool hcL hp
  have hfree : Disjoint p.primeFactors
      ((candidatePIndices c L).biUnion (candidatePBand (c * L))) := by
    simpa only [hpp.primeFactors, disjoint_singleton_left] using hpP
  have h := candidate_marked_weight_mul_of_free c L q hpp.ne_zero hfree (u / p)
  rw [Nat.div_mul_cancel hpu] at h
  exact h.symm

theorem candidate_coefficient_remainder_convolution {c L : ℝ} (hcL : 0 ≤ c * L)
    (q : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : 0 < jStar)
    {u : ℕ} (hu : u ≠ 0) :
    candidateCoefficient c L q r jStar u =
      ∑ p ∈ (candidateQBand (c * L) 0).filter (fun p => p ∣ u),
        candidateRemainderCoefficient c L q r jStar hr (u / p) := by
  classical
  unfold candidateCoefficient
  rw [candidate_Q_weight_rest_divisor_split c L r jStar hr hj, sum_mul, sum_filter]
  apply sum_congr rfl
  intro p hp
  obtain ⟨hpp, hpP⟩ := candidate_Q_zero_prime_outside_pool hcL hp
  have hdiv := @prime_dvd_primePoolFreePart_iff
    ((candidatePIndices c L).biUnion (candidatePBand (c * L))) p u hpp hpP
  by_cases hpu : p ∣ u
  · rw [if_pos (hdiv.mpr hpu), if_pos hpu]
    unfold candidateRemainderCoefficient
    rw [primePoolFreePart_div_prime_of_not_mem hpp hpP hu hpu,
      candidate_marked_weight_div_Q_zero hcL q hp hpu]
  · rw [if_neg (fun h => hpu (hdiv.mp h)), if_neg hpu, zero_mul]

theorem candidate_Q_rest_weight_zero_at_zero (c L : ℝ) (r jStar : ℕ) (hr : 0 < r) :
    candidateQRestWeight c L r jStar hr 0 = 0 := by
  classical
  unfold candidateQRestWeight orderedSlotWeight
  apply sum_eq_zero
  intro x _
  apply if_neg
  change (∏ slot, (x slot).val) ≠ 0
  apply prod_ne_zero_iff.mpr
  intro slot _
  exact candidate_Q_slot_nonzero c L r jStar slot.val (x slot).property

theorem candidate_remainder_coefficient_zero_at_zero (c L q : ℝ)
    (r jStar : ℕ) (hr : 0 < r) :
    candidateRemainderCoefficient c L q r jStar hr 0 = 0 := by
  unfold candidateRemainderCoefficient primePoolFreePart
  rw [Nat.zero_div, candidate_Q_rest_weight_zero_at_zero, zero_mul]

theorem candidate_coefficient_remainder_convolution_all {c L : ℝ} (hcL : 0 ≤ c * L)
    (q : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : 0 < jStar) (u : ℕ) :
    candidateCoefficient c L q r jStar u =
      ∑ p ∈ (candidateQBand (c * L) 0).filter (fun p => p ∣ u),
        candidateRemainderCoefficient c L q r jStar hr (u / p) := by
  by_cases hu : u = 0
  · subst u
    have hz : candidateCoefficient c L q r jStar 0 = 0 := by
      unfold candidateCoefficient primePoolFreePart
      rw [Nat.zero_div, candidate_Q_weight_zero_at_zero, zero_mul]
    rw [hz]
    symm
    exact sum_eq_zero (fun p _ => by
      rw [Nat.zero_div, candidate_remainder_coefficient_zero_at_zero])
  · exact candidate_coefficient_remainder_convolution hcL q r jStar hr hj hu

theorem eventually_candidate_coefficient_remainder_convolution {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ) (hr : 0 < r),
      0 < jStar → ∀ u : ℕ,
      candidateCoefficient c L q r jStar u =
        ∑ p ∈ (candidateQBand (c * L) 0).filter (fun p => p ∣ u),
          candidateRemainderCoefficient c L q r jStar hr (u / p) := by
  filter_upwards [eventually_ge_atTop (0 : ℝ)] with L hL
  intro q r jStar hr hj u
  exact candidate_coefficient_remainder_convolution_all (mul_nonneg hc.le hL) q r jStar hr hj u

end Bounty
end

section

/- Fixed distribution levels below one half absorb subexponential coefficient losses. -/

open Filter

namespace Bounty

theorem eventually_large_sieve_profile_decay {a eta theta K C : ℝ}
    (ha : 0 < a) (heta : 0 < eta) (htheta : theta < 1 / 2)
    (hK : 0 ≤ K) (hC : 0 ≤ C) (D B : ℝ) :
    ∀ᶠ L : ℝ in atTop,
      (L ^ D * Real.exp (K * Real.sqrt L)) *
        (C * Real.exp ((1 - eta) * L) +
          2 * C * Real.exp ((1 - a / 2) * L) +
            Real.sqrt C * Real.exp ((theta + 1 / 2) * L)) ≤
        Real.exp L * L ^ (-B) := by
  have h1 := eventually_exp_neg_rpow_mul_rpow_mul_exp_sqrt_le
    (by norm_num : (1/2 : ℝ) < 1) heta hK D (B + 1)
  have h2 := eventually_exp_neg_rpow_mul_rpow_mul_exp_sqrt_le
    (by norm_num : (1/2 : ℝ) < 1) (half_pos ha) hK D (B + 1)
  have h3 := eventually_exp_neg_rpow_mul_rpow_mul_exp_sqrt_le
    (by norm_num : (1/2 : ℝ) < 1) (sub_pos.mpr htheta) hK D (B + 1)
  filter_upwards [h1, h2, h3, eventually_ge_atTop (3 * C + Real.sqrt C),
    eventually_gt_atTop (0 : ℝ)] with L h1 h2 h3 hCL hL
  simp only [Real.rpow_one] at h1 h2 h3
  have he (d : ℝ) : Real.exp ((1 - d) * L) = Real.exp L * Real.exp (-d * L) := by
    rw [← Real.exp_add]
    congr 1
    ring
  have hsum := add_le_add
    (add_le_add (mul_le_mul_of_nonneg_left h1 hC)
      (mul_le_mul_of_nonneg_left h2 (mul_nonneg (by norm_num : (0 : ℝ) ≤ 2) hC)))
    (mul_le_mul_of_nonneg_left h3 (Real.sqrt_nonneg C))
  have hcoeff : (3 * C + Real.sqrt C) * L ^ (-(B + 1)) ≤ L ^ (-B) := by
    calc
      _ ≤ L * L ^ (-(B + 1)) :=
        mul_le_mul_of_nonneg_right hCL (Real.rpow_nonneg hL.le _)
      _ = _ := by
        nth_rw 1 [← Real.rpow_one L]
        rw [← Real.rpow_add hL]
        congr 1
        ring
  calc
    _ = Real.exp L *
        (C * ((Real.exp (-eta * L) * L ^ D) * Real.exp (K * Real.sqrt L)) +
          (2 * C) * ((Real.exp (-(a / 2) * L) * L ^ D) * Real.exp (K * Real.sqrt L)) +
          Real.sqrt C * ((Real.exp (-(1 / 2 - theta) * L) * L ^ D) *
            Real.exp (K * Real.sqrt L))) := by
      rw [he eta, he (a / 2), show theta + 1 / 2 = 1 - (1 / 2 - theta) by ring,
        he (1 / 2 - theta)]
      ring
    _ ≤ Real.exp L * ((3 * C + Real.sqrt C) * L ^ (-(B + 1))) := by
      apply mul_le_mul_of_nonneg_left _ (Real.exp_nonneg L)
      convert hsum using 1; ring
    _ ≤ _ := mul_le_mul_of_nonneg_left hcoeff (Real.exp_nonneg L)

theorem eventually_large_sieve_subexponential_energy_bound {a eta theta K C : ℝ}
    (ha : 0 < a) (heta : 0 < eta) (htheta : theta < 1 / 2)
    (hK : 0 ≤ K) (hC : 0 ≤ C) (D B : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ P U R E F : ℝ,
      Real.exp (a * L) ≤ P → Real.exp (a * L) ≤ U →
      P * U ≤ C * Real.exp L →
      Real.exp (eta * L) ≤ R → R ≤ Real.exp (theta * L) →
      0 ≤ F → E ≤ P * Real.exp (K * Real.sqrt L) →
      F ≤ U * Real.exp (K * Real.sqrt L) →
      (L ^ D / R) * Real.sqrt ((P + R ^ 2) * (U + R ^ 2) * E * F) ≤
        Real.exp L * L ^ (-B) := by
  filter_upwards [eventually_large_sieve_profile_decay ha heta htheta hK hC D B,
    eventually_gt_atTop (0 : ℝ)] with L hdecay hL
  intro P U R E F hP hU hPU hRlo hRhi hF hEP hFU
  have hP0 : 0 ≤ P := (Real.exp_pos _).le.trans hP
  have hU0 : 0 ≤ U := (Real.exp_pos _).le.trans hU
  have hR0 : 0 < R := (Real.exp_pos _).trans_le hRlo
  calc
    _ ≤ (L ^ D / R) * (Real.exp (K * Real.sqrt L) *
        Real.sqrt ((P + R ^ 2) * (U + R ^ 2) * P * U)) :=
      mul_le_mul_of_nonneg_left
        (large_sieve_energy_factor hP0 hU0 hF (Real.exp_nonneg _) hEP hFU)
        (div_nonneg (Real.rpow_nonneg hL.le _) hR0.le)
    _ = (L ^ D * Real.exp (K * Real.sqrt L)) *
        (Real.sqrt ((P + R ^ 2) * (U + R ^ 2) * P * U) / R) := by ring
    _ ≤ (L ^ D * Real.exp (K * Real.sqrt L)) *
        (C * Real.exp ((1 - eta) * L) +
          2 * C * Real.exp ((1 - a / 2) * L) +
            Real.sqrt C * Real.exp ((theta + 1 / 2) * L)) :=
      mul_le_mul_of_nonneg_left
        (large_sieve_exponential_ranges hC hP hU hPU hRlo hRhi) (by positivity)
    _ ≤ _ := hdecay

end Bounty
end

section

/- A finite dyadic prefix covers each positive support with logarithmic cost. -/

open Finset Filter

namespace Bounty

theorem finite_nat_dyadic_prefix {U : ℝ} (hU : 1 ≤ U)
    (T : Finset ℕ) (hT : ∀ n ∈ T, (n : ℝ) ≤ U) :
    T ⊆ range (2 ^ (⌊U⌋₊.log2 + 1)) ∧
      ∀ n ∈ range (2 ^ (⌊U⌋₊.log2 + 1)), (n : ℝ) ≤ 2*U := by
  have hfloor : 0 < ⌊U⌋₊ := Nat.floor_pos.mpr hU
  obtain ⟨hlower, hupper⟩ := (Nat.log2_eq_iff hfloor.ne').mp (rfl : ⌊U⌋₊.log2 = ⌊U⌋₊.log2)
  have hpow : 2 ^ (⌊U⌋₊.log2 + 1) ≤ 2*⌊U⌋₊ := by
    rw [pow_succ]
    omega
  constructor
  · intro n hn
    apply mem_range.mpr
    exact (Nat.le_floor (hT n hn)).trans_lt hupper
  · intro n hn
    have hnle : n ≤ 2*⌊U⌋₊ := (mem_range.mp hn).le.trans hpow
    have hcast : (n : ℝ) ≤ 2*(⌊U⌋₊ : ℝ) := by exact_mod_cast hnle
    exact hcast.trans (mul_le_mul_of_nonneg_left (Nat.floor_le (zero_le_one.trans hU)) (by norm_num))

theorem eventually_window_dyadic_prefix_cost :
    ∀ᶠ L : ℝ in atTop, ∀ U : ℝ, 1 ≤ U → U ≤ 32*Real.exp L →
      (⌊U⌋₊.log2 + 1 + 1 : ℝ) ≤ L^2 := by
  filter_upwards [eventually_ge_atTop (1 : ℝ), eventually_ge_atTop (Real.log 32),
    eventually_ge_atTop (2/Real.log 2 + 2)] with L hL h32 hcost
  intro U hU hUL
  have hfloor : 0 < (⌊U⌋₊ : ℝ) := by exact_mod_cast (Nat.floor_pos.mpr hU)
  have hfl : (⌊U⌋₊ : ℝ) ≤ 32*Real.exp L :=
    (Nat.floor_le (zero_le_one.trans hU)).trans hUL
  have hlog : Real.log (⌊U⌋₊ : ℝ) ≤ 2*L := by
    have h := Real.log_le_log hfloor hfl
    rw [Real.log_mul (by norm_num : (32 : ℝ) ≠ 0) (Real.exp_ne_zero L), Real.log_exp] at h
    linarith
  have htwo : 0 < Real.log 2 := Real.log_pos (by norm_num)
  calc
    _ ≤ Real.log (⌊U⌋₊ : ℝ)/Real.log 2 + 2 := by
      have h := dyadic_log_count_le_log ⌊U⌋₊
      linarith
    _ ≤ 2*L/Real.log 2 + 2 := by
      exact add_le_add (div_le_div_of_nonneg_right hlog htwo.le) le_rfl
    _ ≤ 2*L/Real.log 2 + 2*L := by linarith
    _ = (2/Real.log 2 + 2)*L := by ring
    _ ≤ L^2 := by nlinarith

theorem window_dyadic_prefactor_le {L R : ℝ} (K : ℕ)
    (hR : 0 < R) (hK : (K + 1 : ℝ) ≤ L^2)
    (hL : 4*(6 + 8*Real.pi) ≤ L) :
    2*(K + 1 : ℝ)*((6 + 8*Real.pi)/(R/2)) ≤ L^3/R := by
  have hpi : 0 ≤ 4*(6 + 8*Real.pi) := by positivity
  calc
    _ = (4*(6 + 8*Real.pi)*(K + 1 : ℝ))/R := by ring
    _ ≤ (4*(6 + 8*Real.pi)*L^2)/R := by
      exact div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hK hpi) hR.le
    _ ≤ (L*L^2)/R := by
      exact div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right hL (sq_nonneg L)) hR.le
    _ = _ := by ring

end Bounty

end

