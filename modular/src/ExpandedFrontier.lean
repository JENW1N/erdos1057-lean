section ResiduePath
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (ζ : ∀ p : PhysicalPrime P, ZMod p.2.val)
  (hmarks : ∀ j : Fin (n + 1), ∀ p ∈ physicalMarkedPrimes (L j),
    ζ p = -(a j : ZMod p.2.val))

variable
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ) (η : Fin N → Fin (n + 1) → ℝ)
  (V ρ : Fin N → ℝ) (hV : ∀ g, V g ≠ 0) (cap : ℕ)



variable [∀ g, ∀ p : ↥(P g), NeZero p.val]

theorem physical_joint_residue_visit_bounded_events (j : Fin (n + 1))
    (t : Fin N → ℕ)
    (F : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ)
    (s : BoundedGhostJointLedgerState (fun g (p : ↥(P g)) => p.val) t cap) :
    globalBirthJointCutRawRow
      (physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β η V ρ hV cap (2 * j.val)) cap cap F
      (boundedGhostJointDecode (fun g (p : ↥(P g)) => p.val) t cap s) =
    ∑ e : CoupledGhostEvent t cap (fun g => (s g).2),
      (coupledGhostJointEventWeight
        (fun g => physicalGhostRetention (fun p : ↥(P g) => p.val) (1 - η g j) (ρ g))
        (fun g => physicalGhostTermination (fun p : ↥(P g) => p.val) (1 - η g j) (ρ g))
        (fun g => physicalGhostBirth (fun p : ↥(P g) => p.val) (1 - η g j) (ρ g) (V g))
        (fun g => unrestrictedResidueWeight (fun p => β g p / V g))
        t cap (fun g => (s g).2) e : ℂ) *
      (if boundedGhostJointFresh (fun g (p : ↥(P g)) => p.val) t cap s e then 1 else 0) *
        F (boundedGhostJointDecode (fun g (p : ↥(P g)) => p.val) t cap (boundedGhostJointTarget (fun g (p : ↥(P g)) => p.val) t cap s e)) := by
  let step := fun g => GlobalBirthRawStep.visit
    (a := physicalGroupBareAtomicActivity L g (2 * j.val))
    (fun p : ↥(P g) => (0 : ZMod p.val)) (β g) (η g j) (V g) (ρ g) (hV g) cap
  have he :
      (fun g (K : GlobalBirthHistoryState (fun p : ↥(P g) => ZMod p.val) → ℂ)
        (u : GlobalBirthHistoryState (fun p : ↥(P g) => ZMod p.val)) =>
        globalBirthRawStepRow
          (physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β η V ρ hV cap (2 * j.val) g)
          (fun H q => K (H, q)) u.1 u.2) =
      (fun g (K : GlobalBirthHistoryState (fun p : ↥(P g) => ZMod p.val) → ℂ)
        (u : GlobalBirthHistoryState (fun p : ↥(P g) => ZMod p.val)) =>
        globalBirthRawStepRow (step g) (fun H q => K (H, q)) u.1 u.2) := by
    funext g K u
    exact physical_group_residue_finite_visit_row C aux k L a σ τ hstep ζ hmarks
      hlist hP hdis g (fun j => hk j g) (β g) (η g) (V g) (ρ g) (hV g) cap j
      (fun H q => K (H, q)) u.1 u.2
  have hh : globalBirthJointCutRawRow
      (physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β η V ρ hV cap (2 * j.val)) cap cap F =
      globalBirthJointCutRawRow step cap cap F := by
    unfold globalBirthJointCutRawRow globalBirthJointRawRow
    rw [he]
  rw [hh]
  exact global_birth_joint_visit_bounded_events (fun g (p : ↥(P g)) => p.val) β (fun g => η g j)
    V ρ t cap (fun g => physicalGroupBareAtomicActivity L g (2 * j.val)) hV F s

end ResiduePath
