theorem exists_candidate_coefficient_divisor_bound {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ L : ℝ in atTop, ∀ jStar u : ℕ,
      0 ≤ candidateCoefficient c L q r jStar u ∧
      candidateCoefficient c L q r jStar u ≤ L^C *
        ((primePoolFreePart ((candidatePIndices c L).biUnion (candidatePBand (c * L))) u).divisors.card : ℝ) := by
  obtain ⟨C, hC, hW⟩ := exists_candidate_marked_weight_rpow_bound hc hq0 hq1
  refine ⟨C, hC, ?_⟩
  filter_upwards [hW, eventually_candidate_Q_weight_le_divisors hc hr] with L hw hq
  intro jStar u
  refine ⟨candidate_coefficient_nonneg c L hq0 r jStar u, ?_⟩
  unfold candidateCoefficient
  let n := primePoolFreePart ((candidatePIndices c L).biUnion (candidatePBand (c * L))) u
  have h := mul_le_mul (hq jStar n) (hw (u : ℤ)).2 (hw (u : ℤ)).1 (Nat.cast_nonneg _)
  simpa only [mul_comm] using h

theorem eventually_candidate_coefficient_le_exp_sqrt {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1) :
    ∀ᶠ L : ℝ in atTop, ∀ jStar u : ℕ, (u : ℝ) ≤ 16 * Real.exp L →
      candidateCoefficient c L q r jStar u ≤ Real.exp ((2 * Real.log 2 + 1) * Real.sqrt L) := by
  filter_upwards [eventually_candidate_Q_weight_le_exp_sqrt hc hr,
    eventually_candidate_marked_multiplier_bound hc hq0 hq1 (2 * Real.log 2)] with L hq hW
  intro jStar u hu
  let n := primePoolFreePart ((candidatePIndices c L).biUnion (candidatePBand (c * L))) u
  have hn : (n : ℝ) ≤ 16 * Real.exp L := by
    have hnu : n ≤ u := Nat.div_le_self _ _
    exact (by exact_mod_cast hnu : (n : ℝ) ≤ (u : ℝ)).trans hu
  exact hW (u : ℤ) (candidateQWeight c L r jStar n)
    (candidate_Q_weight_nonneg c L r jStar n) (hq jStar n hn)
end

