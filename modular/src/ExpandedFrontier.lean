    (L : PhysicalMarkLists P J ell)
    (p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) : ℂ :=
  (((physicalStateMass (fun g : ↥groupsᶜ => V g.val) J ell *
