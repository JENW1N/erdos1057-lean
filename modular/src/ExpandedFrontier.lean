namespace Bounty
section Weight
variable {S G I V K : Type} [Fintype S]
  {Ps : S → Finset ℕ} {P : G → Type}
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : I → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : I → Type)
  (Δ D : ∀ _k : K, ∀ i, PhysicalSharedLists Ps J → SharedActiveLabels P (shared i) → A i → G → ℤ)
  (kbig : ∀ _k : K, ∀ i, SharedActiveLabels P (shared i) → A i → ℤ)
  (Vs : S → ℝ) (qedge : K → ℝ)

theorem physical_mixed_small_weight_bare
    (k : K) (s : PhysicalMixedWordState (Ps := Ps) (J := J) (ell := ell) (M := M) n B)
    (e : PhysicalMixedWordEdge n shared B A Δ D k s)
    (aSmall : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J)))) :
    (physicalMixedSmallWeight (V := V) n shared B A Δ D kbig Vs qedge (some (.inr k)) s e : ℂ) =
      physicalBarePatternScalar Vs (fun _ => (∅ : Finset (Fin J))) 0
        (fun _ _ _ => 1) aSmall s.1.2 e.2.2.1 *
      ((physicalResidueVertexWeight s.1.2 (Real.sqrt (qedge k)) s.1.1 *
        physicalResidueVertexWeight e.2.2.1 (Real.sqrt (qedge k))
          (physicalTranslateResidues s.1.1
            (kbig k e.1 (productActiveMemorySplit (shared e.1) B s.2).1 e.2.1 *
              (physicalSharedProduct (physicalSharedPrefix s.1.2) : ℕ))) : ℝ) : ℂ) := by
  rw [physical_bare_empty_prefix Vs 0 aSmall (fun _ => 1)]
  simp only [physical_phase_zero_frequency, mul_one, physicalMixedSmallWeight]
  split_ifs <;> simp only [Complex.ofReal_mul, Complex.ofReal_zero, zero_mul]

