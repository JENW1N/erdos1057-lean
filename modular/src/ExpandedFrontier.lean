open Finset
open scoped ComplexConjugate

namespace Bounty

theorem finite_shift_correlation_zero_norm (S : Finset ℤ) (f : ℤ → ℂ) :
    ‖finiteShiftCorrelation S f 0‖ = ∑ n ∈ S, ‖f n‖^2 := by
  simp only [finiteShiftCorrelation, add_zero, Complex.mul_conj,
    Complex.normSq_eq_norm_sq, ← Complex.ofReal_sum]
  rw [Complex.norm_real, Real.norm_of_nonneg (sum_nonneg (fun n hn => sq_nonneg _))]

theorem integer_interval_van_der_corput (a b H : ℤ) (f : ℤ → ℂ)
    (hab : a ≤ b) (hH : 1 ≤ H)
    (hsupport : ∀ n, n ∉ Icc a b → f n = 0) :
    (H:ℝ) * ‖∑ n ∈ Icc a b, f n‖^2 ≤
      ((b-a+H:ℤ):ℝ) * ((∑ n ∈ Icc a b, ‖f n‖^2) +
        2 * ∑ d ∈ Icc (1:ℤ) (H-1), ‖finiteShiftCorrelation (Icc a b) f d‖) := by
  let S := Icc a b
  let V := Icc (0:ℤ) (H-1)
  let X := Icc (a-H+1) b
  have hcover (n : ℤ) (hn : n ∈ S) (h : ℤ) (hh : h ∈ V) : n-h ∈ X := by
    have hn' := mem_Icc.mp hn
    have hh' := mem_Icc.mp hh
    apply mem_Icc.mpr
    omega
  have hc := finite_translate_cauchy_correlation S V X f hsupport hcover
  have hcardV : (V.card:ℝ) = (H:ℝ) := by
    have hv := Int.card_Icc_of_le (a := 0) (b := H-1) (by omega)
    simp only [sub_add_cancel, sub_zero] at hv
    exact_mod_cast hv
  have hcardX : (X.card:ℝ) = ((b-a+H:ℤ):ℝ) := by
    have hx := Int.card_Icc_of_le (a := a-H+1) (b := b) (by omega)
    have hr : b+1-(a-H+1) = b-a+H := by ring
    rw [hr] at hx
    exact_mod_cast hx
  rw [hcardV, hcardX] at hc
  have hr : (∑ h ∈ V, ∑ k ∈ V, (finiteShiftCorrelation S f (h-k)).re) ≤
      ∑ h ∈ V, ∑ k ∈ V, ‖finiteShiftCorrelation S f (h-k)‖ := by
    apply sum_le_sum
    intro h hh
    apply sum_le_sum
    intro k hk
    exact Complex.re_le_norm _
  have ht := toeplitz_integer_interval_sum_bound
    (fun d => ‖finiteShiftCorrelation S f d‖) (H-1) (by omega)
    (fun d => norm_nonneg _) (fun d => finite_shift_correlation_norm_neg S f d hsupport)
  simp only [sub_add_cancel, finite_shift_correlation_zero_norm] at ht
  have hX0 : (0:ℝ) ≤ ((b-a+H:ℤ):ℝ) := by exact_mod_cast (by omega : 0 ≤ b-a+H)
  have hall := hc.trans (mul_le_mul_of_nonneg_left (hr.trans ht) hX0)
  have hH0 : (0:ℝ) < (H:ℝ) := by exact_mod_cast (by omega : 0 < H)
  apply (mul_le_mul_iff_right₀ hH0).mp
  dsimp only [S] at hall
  nlinarith only [hall]

theorem integer_interval_van_der_corput_unit (a b H : ℤ) (f : ℤ → ℂ)
    (hab : a ≤ b) (hH : 1 ≤ H) (hHN : H ≤ b-a+1)
    (hsupport : ∀ n, n ∉ Icc a b → f n = 0)
    (hf : ∀ n ∈ Icc a b, ‖f n‖ ≤ 1) :
    ‖∑ n ∈ Icc a b, f n‖^2 ≤
      2*((b-a+1:ℤ):ℝ)^2/(H:ℝ) +
      (4*((b-a+1:ℤ):ℝ)/(H:ℝ)) *
        ∑ d ∈ Icc (1:ℤ) (H-1), ‖finiteShiftCorrelation (Icc a b) f d‖ := by
  have hv := integer_interval_van_der_corput a b H f hab hH hsupport
  have he : (∑ n ∈ Icc a b, ‖f n‖^2) ≤ ((b-a+1:ℤ):ℝ) := by
    calc
      _ ≤ ∑ _n ∈ Icc a b, (1:ℝ) := by
        apply sum_le_sum
        intro n hn
        nlinarith [norm_nonneg (f n), hf n hn]
      _ = _ := by
        rw [sum_const, nsmul_eq_mul, mul_one]
        have hc := Int.card_Icc_of_le (a := a) (b := b) (by omega)
        have hh : b+1-a = b-a+1 := by ring
        rw [hh] at hc
        exact_mod_cast hc
  have hN : (0:ℝ) ≤ ((b-a+1:ℤ):ℝ) := by exact_mod_cast (by omega : 0 ≤ b-a+1)
  have hX : (0:ℝ) ≤ ((b-a+H:ℤ):ℝ) := by exact_mod_cast (by omega : 0 ≤ b-a+H)
  have hXle : ((b-a+H:ℤ):ℝ) ≤ 2*((b-a+1:ℤ):ℝ) := by exact_mod_cast (by omega : b-a+H ≤ 2*(b-a+1))
  have hs : 0 ≤ ∑ d ∈ Icc (1:ℤ) (H-1), ‖finiteShiftCorrelation (Icc a b) f d‖ :=
    sum_nonneg (fun d hd => norm_nonneg _)
  have hb := hv.trans (mul_le_mul hXle (add_le_add he le_rfl) (by positivity) (by positivity))
  have hH0 : (0:ℝ) < (H:ℝ) := by exact_mod_cast (by omega : 0 < H)
  rw [div_mul_eq_mul_div, ← add_div]
  apply (le_div_iff₀ hH0).mpr
  nlinarith only [hb]

end Bounty
end

section

/- A finite Kusmin-Landau bound for monotone increments in a single unit band. -/

open Finset

namespace Bounty

theorem discrete_unit_phase_sum_bound (u : ℕ → ℂ) (φ : ℕ → ℝ) (N : ℕ)
    {δ : ℝ} (hδ : 0 < δ) (hδhalf : δ ≤ 1/2)
    (hu : ∀ n ≤ N, ‖u n‖ ≤ 1)
    (hstep : ∀ n < N, u (n+1) = u n * Complex.exp (((2*Real.pi*φ n : ℝ) : ℂ)*Complex.I))
    (hφ : ∀ n < N, δ ≤ φ n ∧ φ n ≤ 1-δ)
    (hmono : MonotoneOn φ (Set.Iio N) ∨ AntitoneOn φ (Set.Iio N)) :
    ‖∑ n ∈ range N, u n‖ ≤ 2/δ := by
  by_cases hN : N = 0
  · subst N
    simp only [range_zero, sum_empty, norm_zero]
    positivity
  have hNp : 0 < N := Nat.pos_of_ne_zero hN
  let clamp : ℕ → ℕ := fun n => min n (N-1)
  let w : ℕ → ℂ := fun n => phaseReciprocalKernel (2*Real.pi*φ (clamp n))
  have hclamp (n : ℕ) : clamp n < N := by
    have := Nat.min_le_right n (N-1)
    dsimp [clamp]
    omega
  have hc_eq (n : ℕ) (hn : n < N) : clamp n = n := by
    dsimp [clamp]
    exact min_eq_left (by omega)
  have hφmem (n : ℕ) : φ (clamp n) ∈ Set.Ioo (0 : ℝ) 1 := by
    have hh := hφ (clamp n) (hclamp n)
    constructor <;> linarith
  have hw : ∀ n < N, w n*(u n-u (n+1)) = u n := by
    intro n hn
    dsimp only [w]
    rw [hc_eq n hn,hstep n hn]
    calc
      _ = (phaseReciprocalKernel (2*Real.pi*φ n) *
          (1-Complex.exp (((2*Real.pi*φ n : ℝ) : ℂ)*Complex.I))) * u n := by ring
      _ = u n := by
        rw [phase_reciprocal_unit_mul (by simpa only [hc_eq n hn] using hφmem n),one_mul]
  have hre : ∀ n ≤ N, (w n).re = (w 0).re := by
    intro n hn
    simp only [w,phase_reciprocal_kernel_re]
  have hcm (n : ℕ) : clamp n ≤ clamp (n+1) := min_le_min_right _ (Nat.le_succ n)
  have him : (∀ n < N, (w n).im ≤ (w (n+1)).im) ∨
      (∀ n < N, (w (n+1)).im ≤ (w n).im) := by
    rcases hmono with hm | hm
    · right
      intro n hn
      exact antitoneOn_unit_phase_reciprocal_im (hφmem n) (hφmem (n+1))
        (hm (hclamp n) (hclamp (n+1)) (hcm n))
    · left
      intro n hn
      exact antitoneOn_unit_phase_reciprocal_im (hφmem (n+1)) (hφmem n)
        (hm (hclamp n) (hclamp (n+1)) (hcm n))
  have hn (n : ℕ) : ‖w n‖ ≤ 1/(2*δ) :=
    norm_phase_reciprocal_unit_band hδ hδhalf (hφ (clamp n) (hclamp n))
  calc
    _ ≤ 2*(‖w 0‖+‖w N‖) := monotone_reciprocal_sum_bound u w N hw hu hre him
    _ ≤ 2*(1/(2*δ)+1/(2*δ)) := mul_le_mul_of_nonneg_left (add_le_add (hn 0) (hn N)) (by norm_num)
    _ = 2/δ := by ring

end Bounty
end

section

/- Square-root optimization of the finite slope partition. -/

open Finset

namespace Bounty

theorem discrete_second_derivative_from_first {a b : ℕ} {d : ℕ → ℝ} {z : ℕ → ℂ}
    {lam A C : ℝ} (hab : a ≤ b) (hlam : 0 < lam) (hA : 1 ≤ A) (hC : 0 ≤ C)
    (hsep : ∀ i ∈ Icc a b, ∀ j ∈ Icc a b, i ≤ j →
      lam*((j : ℝ)-i) ≤ d j-d i ∧ d j-d i ≤ A*lam*((j : ℝ)-i))
    (hz : ∀ n ∈ Icc a b, ‖z n‖ ≤ 1)
    (hfirst : ∀ δ : ℝ, 0 < δ → δ ≤ 1/2 →
      ∀ l r : ℕ, ∀ k : ℤ, a ≤ l → r ≤ b → l ≤ r →
      (∀ n ∈ Icc l r, (k : ℝ)+δ ≤ d n ∧ d n ≤ k+1-δ) →
      ‖∑ n ∈ Icc l r, z n‖ ≤ C/δ) :
    ‖∑ n ∈ Icc a b, z n‖ ≤
      (C+4)*(A*((b : ℝ)-a+1)*Real.sqrt lam+2/Real.sqrt lam) := by
  have hs : 0 < Real.sqrt lam := Real.sqrt_pos.mpr hlam
  have hsq : (Real.sqrt lam)^2 = lam := Real.sq_sqrt hlam.le
  have habR : (a : ℝ) ≤ b := by exact_mod_cast hab
  have hN : 0 ≤ (b : ℝ)-a+1 := by linarith
  have hA0 : 0 ≤ A := by linarith
  have hmono : MonotoneOn d (Set.Icc a b) := by
    intro i hi j hj hij
    have h := (hsep i (mem_Icc.mpr hi) j (mem_Icc.mpr hj) hij).1
    have hijR : (i : ℝ) ≤ j := by exact_mod_cast hij
    nlinarith
  by_cases hsmall : lam ≤ 1/4
  · have hsHalf : Real.sqrt lam ≤ 1/2 := by nlinarith
    have hsOne : Real.sqrt lam ≤ 1 := by linarith
    have he := discrete_slope_partition_bound hab hlam hs hC hmono
      (fun i hi j hj hij => (hsep i hi j hj hij).1) hz
      (hfirst (Real.sqrt lam) hs hsHalf)
    have hdiv : Real.sqrt lam/lam = 1/Real.sqrt lam := by
      apply (div_eq_div_iff (ne_of_gt hlam) (ne_of_gt hs)).mpr
      nlinarith
    have hone : (1 : ℝ) ≤ 1/Real.sqrt lam := (le_div_iff₀ hs).mpr (by linarith)
    have hcost : C/Real.sqrt lam+2*(Real.sqrt lam/lam+1) ≤ (C+4)/Real.sqrt lam := by
      rw [hdiv]
      calc
        _ ≤ C/Real.sqrt lam+2*(1/Real.sqrt lam+1/Real.sqrt lam) := by linarith
        _ = _ := by ring
    have hrange : d b-d a+2 ≤ A*lam*((b : ℝ)-a+1)+2 := by
      have h := (hsep a (mem_Icc.mpr ⟨le_rfl,hab⟩) b (mem_Icc.mpr ⟨hab,le_rfl⟩) hab).2
      nlinarith
    have heq : (A*lam*((b : ℝ)-a+1)+2)*((C+4)/Real.sqrt lam) =
        (C+4)*(A*((b : ℝ)-a+1)*Real.sqrt lam+2/Real.sqrt lam) := by
      field_simp
      rw [hsq]
      ring
    exact he.trans ((mul_le_mul hrange hcost (by positivity) (by positivity)).trans_eq heq)
  · have hsHalf : 1/2 ≤ Real.sqrt lam := by nlinarith
    have hcard : ((Icc a b).card : ℝ) = (b : ℝ)-a+1 := by
      rw [Nat.card_Icc,Nat.cast_sub (show a ≤ b+1 by omega)]
      push_cast
      ring
    have hsum : ‖∑ n ∈ Icc a b, z n‖ ≤ (b : ℝ)-a+1 := by
      calc
        _ ≤ ∑ n ∈ Icc a b, ‖z n‖ := norm_sum_le _ _
        _ ≤ ∑ n ∈ Icc a b, (1 : ℝ) := sum_le_sum hz
        _ = _ := by simpa using hcard
    have hmain : (b : ℝ)-a+1 ≤ (C+4)*(A*((b : ℝ)-a+1)*Real.sqrt lam) := by
      have h1 : (b : ℝ)-a+1 ≤ A*((b : ℝ)-a+1) := by nlinarith
      have h2 : A*((b : ℝ)-a+1)/2 ≤ A*((b : ℝ)-a+1)*Real.sqrt lam := by nlinarith
      have h3 : 0 ≤ A*((b : ℝ)-a+1)*Real.sqrt lam := by positivity
      nlinarith
    have htail : 0 ≤ (C+4)*(2/Real.sqrt lam) := by positivity
    nlinarith

end Bounty
end

section

/- Exact expansion into the grouped integer coefficients for the logarithmic
exponentials used in the Dirichlet mean-square integral. -/

open Finset
open scoped Classical
namespace Bounty

theorem prime_tuple_log_product (P : Finset ℕ) (hP : ∀ p ∈ P, Nat.Prime p)
    (j : ℕ) (a : Fin j → P) :
    Real.log (primeTupleProduct P j a : ℝ) = ∑ r, Real.log ((a r).val : ℝ) := by
  unfold primeTupleProduct
  rw [Nat.cast_prod]
  exact Real.log_prod (fun r _ => Nat.cast_ne_zero.mpr (hP (a r).val (a r).property).pos.ne')

theorem prime_tuple_exp_log_product (P : Finset ℕ) (hP : ∀ p ∈ P, Nat.Prime p)
    (j : ℕ) (a : Fin j → P) (t : ℝ) :
    Complex.exp (((Real.log (primeTupleProduct P j a : ℝ) * t : ℝ) : ℂ) * Complex.I) =
      ∏ r, Complex.exp (((Real.log ((a r).val : ℝ) * t : ℝ) : ℂ) * Complex.I) := by
  rw [prime_tuple_log_product P hP j a]
  simp only [sum_mul, Complex.ofReal_sum, Complex.exp_sum]

theorem prime_polynomial_power_exp_log (P : Finset ℕ) (hP : ∀ p ∈ P, Nat.Prime p)
    (w : P → ℂ) (j : ℕ) (t : ℝ) :
    (∑ p : P, w p * Complex.exp (((Real.log (p.val : ℝ) * t : ℝ) : ℂ) * Complex.I)) ^ j =
      ∑ n ∈ primePolynomialSupport P j, primePolynomialCoefficient P w j n *
        Complex.exp (((Real.log (n : ℝ) * t : ℝ) : ℂ) * Complex.I) := by
  rw [Fintype.sum_pow, prime_polynomial_coefficients_sum_mul]
  apply sum_congr rfl
  intro a _
  rw [prod_mul_distrib, prime_tuple_exp_log_product P hP j a t]

end Bounty
end

section

/- Elementary coefficient energy in a dyadic integer interval. No prime-counting
estimate is used; repeated entries remain permitted in the tuple bound. -/

namespace Bounty

open Finset

theorem nat_dyadic_card_le (s : Finset ℕ) (P : ℝ) (hP : 1 ≤ P)
    (hband : ∀ p ∈ s, P ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2 * P) :
    (s.card : ℝ) ≤ 2 * P := by
  have hs : s ⊆ Finset.Icc 1 ⌊2 * P⌋₊ := by
    intro p hp
    apply Finset.mem_Icc.mpr
    constructor
    · exact_mod_cast hP.trans (hband p hp).1
    · exact Nat.le_floor (hband p hp).2
  have hc : s.card ≤ ⌊2 * P⌋₊ := by
    simpa using Finset.card_le_card hs
  exact (Nat.cast_le.mpr hc).trans (Nat.floor_le (by linarith))

theorem prime_dyadic_coefficient_energy_le (s : Finset ℕ) (P B : ℝ)
    (b : ℕ → ℂ) (hP : 1 ≤ P) (hB : 0 ≤ B)
    (hband : ∀ p ∈ s, P ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2 * P)
    (hb : ∀ p ∈ s, ‖b p‖ ≤ B) :
    (∑ p ∈ s, ‖b p / (p : ℂ)‖ ^ 2) ≤ 2 * B ^ 2 / P := by
  have hPpos : 0 < P := by linarith
  have hterm : ∀ p ∈ s, ‖b p / (p : ℂ)‖ ^ 2 ≤ (B / P) ^ 2 := by
    intro p hp
    have hnorm : ‖b p / (p : ℂ)‖ ≤ B / P := by
      rw [norm_div, Complex.norm_natCast]
      exact div_le_div₀ hB (hb p hp) hPpos (hband p hp).1
    exact (sq_le_sq₀ (norm_nonneg _) (div_nonneg hB hPpos.le)).mpr hnorm
  calc
    (∑ p ∈ s, ‖b p / (p : ℂ)‖ ^ 2) ≤ ∑ _p ∈ s, (B / P) ^ 2 :=
      Finset.sum_le_sum hterm
    _ = (s.card : ℝ) * (B / P) ^ 2 := by simp
    _ ≤ (2 * P) * (B / P) ^ 2 :=
      mul_le_mul_of_nonneg_right (nat_dyadic_card_le s P hP hband) (sq_nonneg _)
    _ = 2 * B ^ 2 / P := by field_simp

theorem prime_dyadic_reciprocal_energy_le (s : Finset ℕ) (P B : ℝ)
    (b : s → ℂ) (hP : 1 ≤ P) (hB : 0 ≤ B)
    (hband : ∀ p ∈ s, P ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2 * P)
    (hb : ∀ p : s, ‖b p‖ ≤ B) :
    (∑ p : s, ‖b p‖ ^ 2 / (p.val : ℝ) ^ 2) ≤ 2 * B ^ 2 / P := by
  classical
  let b' : ℕ → ℂ := fun p => if hp : p ∈ s then b ⟨p, hp⟩ else 0
  have hb' : ∀ p ∈ s, ‖b' p‖ ≤ B := by
    intro p hp
    simpa only [b', dif_pos hp] using hb ⟨p, hp⟩
  have h := prime_dyadic_coefficient_energy_le s P B b' hP hB hband hb'
  rw [← Finset.sum_coe_sort] at h
  simpa [norm_div, Complex.norm_natCast, div_pow, b'] using h

theorem dyadic_prime_tuple_product_pos (s : Finset ℕ)
    (hs : ∀ p ∈ s, Nat.Prime p) (j : ℕ) (a : Fin j → s) :
    0 < primeTupleProduct s j a := by
  exact Finset.prod_pos fun r _ => (hs _ (a r).property).pos

theorem prime_tuple_product_real_le (s : Finset ℕ) (U : ℝ)
    (hbound : ∀ p ∈ s, (p : ℝ) ≤ U) (j : ℕ) (a : Fin j → s) :
    (primeTupleProduct s j a : ℝ) ≤ U ^ j := by
  calc
    (primeTupleProduct s j a : ℝ) = ∏ r, ((a r).val : ℝ) := by
      simp only [primeTupleProduct, Nat.cast_prod]
    _ ≤ ∏ _r : Fin j, U :=
      Finset.prod_le_prod₀ (fun _ _ => Nat.cast_nonneg _) (fun r _ => hbound _ (a r).property)
    _ = U ^ j := by simp

theorem prime_polynomial_support_real_le (s : Finset ℕ) (U : ℝ)
    (hbound : ∀ p ∈ s, (p : ℝ) ≤ U) (j n : ℕ)
    (hn : n ∈ primePolynomialSupport s j) : (n : ℝ) ≤ U ^ j := by
  obtain ⟨a, _, rfl⟩ := Finset.mem_image.mp hn
  exact prime_tuple_product_real_le s U hbound j a

theorem prime_dyadic_polynomial_coefficients_energy_le (s : Finset ℕ)
    (hs : ∀ p ∈ s, Nat.Prime p) (P B : ℝ) (b : s → ℂ)
    (hP : 1 ≤ P) (hB : 0 ≤ B)
    (hband : ∀ p ∈ s, P ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2 * P)
    (hb : ∀ p : s, ‖b p‖ ≤ B) (j : ℕ) :
    (∑ n ∈ primePolynomialSupport s j,
      ‖primePolynomialCoefficient s (fun p => b p / (p.val : ℂ)) j n‖ ^ 2) ≤
      (j.factorial : ℝ) * (2 * B ^ 2 / P) ^ j := by
  calc
    _ ≤ (j.factorial : ℝ) * (∑ p : s, ‖b p‖ ^ 2 / (p.val : ℝ) ^ 2) ^ j :=
      prime_polynomial_reciprocal_coefficients_sq_le_factorial s hs b j
    _ ≤ (j.factorial : ℝ) * (2 * B ^ 2 / P) ^ j := by
      gcongr
      exact prime_dyadic_reciprocal_energy_le s P B b hP hB hband hb

end Bounty
end

section

/- The explicit Sobolev-sampling prefactor and threshold loss fit the
fixed-parameter prime-moment exponential estimate. -/

namespace Bounty

noncomputable def primeMomentActualExponent (c A : ℝ) : ℝ :=
  primeMomentExceptionalExponent c (512 * (c + 1) ^ 2) (max 2 (2 * A))

theorem prime_moment_actual_exponent_one_le {c A : ℝ} (hc : 0 ≤ c) (hA : 0 ≤ A) :
    1 ≤ primeMomentActualExponent c A := by
  apply prime_moment_exceptional_exponent_one_le hc
  · nlinarith [sq_nonneg c]
  · exact (mul_nonneg (by norm_num) hA).trans (le_max_right _ _)

theorem prime_moment_actual_budget_le_exp {N L Y P a b c A : ℝ}
    (ha0 : 0 ≤ a) (ha1 : a ≤ 1) (hc : 0 ≤ c) (hA : 0 ≤ A)
    (hL : Real.exp 1 ≤ L) (hY : 1 ≤ Y) (hlogY : Real.log Y ≤ c * L)
    (hPlo : Real.exp (L ^ a) / 2 ≤ P) (hPhi : P ≤ Real.exp (L ^ b))
    (hN : N ≤ 512 * Y * (1 + Real.log Y) ^ 2 * (primeMomentDegree Y P).factorial *
      (2 * L ^ (2 * A) / P) ^ primeMomentDegree Y P) :
    N ≤ Real.exp (primeMomentActualExponent c A * (L ^ b + L ^ (1 - a) * Real.log L)) := by
  let C : ℝ := 512 * (c + 1) ^ 2
  let d : ℝ := max 2 (2 * A)
  have hC : 1 ≤ C := by dsimp only [C]; nlinarith [sq_nonneg c]
  have hC2 : 2 ≤ C := by dsimp only [C]; nlinarith [sq_nonneg c]
  have hC0 : 0 ≤ C := zero_le_one.trans hC
  have hd : 0 ≤ d := (mul_nonneg (by norm_num) hA).trans (le_max_right _ _)
  have hL0 : 0 < L := (Real.exp_pos 1).trans_le hL
  have hL1 : 1 ≤ L := (Real.one_le_exp (by norm_num : (0 : ℝ) ≤ 1)).trans hL
  have hP0 : 0 < P := (div_pos (Real.exp_pos _) (by norm_num : (0 : ℝ) < 2)).trans_le hPlo
  have hY0 : 0 ≤ Y := zero_le_one.trans hY
  have hlog0 : 0 ≤ Real.log Y := Real.log_nonneg hY
  have hlog : 1 + Real.log Y ≤ (c + 1) * L := by nlinarith only [hlogY, hL1]
  have hsq := pow_le_pow_left₀ (by linarith : 0 ≤ 1 + Real.log Y) hlog 2
  have hpref : 512 * (1 + Real.log Y) ^ 2 ≤ C * L ^ d := by
    calc
      _ ≤ 512 * ((c + 1) * L) ^ 2 := mul_le_mul_of_nonneg_left hsq (by norm_num)
      _ = C * L ^ (2 : ℝ) := by rw [Real.rpow_two]; dsimp only [C]; ring
      _ ≤ C * L ^ d := mul_le_mul_of_nonneg_left
        (Real.rpow_le_rpow_of_exponent_le hL1 (le_max_left _ _)) hC0
  have hthreshold : 2 * L ^ (2 * A) ≤ C * L ^ d :=
    mul_le_mul hC2 (Real.rpow_le_rpow_of_exponent_le hL1 (le_max_right _ _))
      (Real.rpow_nonneg hL0.le _) hC0
  have hratio : 2 * L ^ (2 * A) / P ≤ C * L ^ d / P :=
    div_le_div_of_nonneg_right hthreshold hP0.le
  have hraw : 512 * Y * (1 + Real.log Y) ^ 2 * (primeMomentDegree Y P).factorial *
      (2 * L ^ (2 * A) / P) ^ primeMomentDegree Y P ≤
      (C * L ^ d) * Y * (primeMomentDegree Y P).factorial *
        ((C * L ^ d) / P) ^ primeMomentDegree Y P := by
    calc
      _ = (512 * (1 + Real.log Y) ^ 2) * Y * (primeMomentDegree Y P).factorial *
          (2 * L ^ (2 * A) / P) ^ primeMomentDegree Y P := by ring
      _ ≤ _ := by gcongr
  exact prime_moment_exceptional_budget_le_exp ha0 ha1 hc hC hd hL hY hlogY hPlo hPhi (hN.trans hraw)

end Bounty
end

section

/- Finite separated sampling estimates for exponential polynomials. -/

open scoped BigOperators ComplexConjugate

namespace Bounty

theorem sparse_exponential_polynomial_energy {I X : Type*} [Fintype I] [Fintype X]
    (x : I → ℝ) (w : X → ℝ) (c : X → ℂ) (N : ℕ) {U E : ℝ}
    (hU : 0 ≤ U) (hE : 0 ≤ E)
    (hsep : ∀ i j, i ≠ j → 1 ≤ |x i - x j|)
    (hspan : ∀ i j, |x i - x j| ≤ N)
    (hkernel : ∀ z : ℝ, |z| ≤ N →
      ‖∑ n, Complex.exp ((w n * z : ℝ) * Complex.I)‖ ≤ U / (1 + |z|) + E) :
    (∑ i, ‖∑ n, c n * Complex.exp ((w n * x i : ℝ) * Complex.I)‖ ^ 2) ≤
      (U * (1 + 2 * (1 + Real.log N)) + (Fintype.card I : ℝ) * E) *
        ∑ n, ‖c n‖ ^ 2 := by
  have hB : 0 ≤ U * (1 + 2 * (1 + Real.log N)) + (Fintype.card I : ℝ) * E := by
    have := Real.log_natCast_nonneg N
    positivity
  have hphase (i j : I) (n : X) :
      Complex.exp ((w n * x i : ℝ) * Complex.I) *
        conj (Complex.exp ((w n * x j : ℝ) * Complex.I)) =
        Complex.exp ((w n * (x i - x j) : ℝ) * Complex.I) := by
    simpa only [mul_comm] using exponential_phase_gram (x i) (x j) (w n)
  have hrow (i : I) : (∑ j, ‖∑ n,
      Complex.exp ((w n * x i : ℝ) * Complex.I) *
        conj (Complex.exp ((w n * x j : ℝ) * Complex.I))‖) ≤
      U * (1 + 2 * (1 + Real.log N)) + (Fintype.card I : ℝ) * E := by
    simp_rw [hphase]
    calc
      _ ≤ ∑ j, (U / (1 + |x i - x j|) + E) :=
        Finset.sum_le_sum (fun j _ => hkernel (x i - x j) (hspan i j))
      _ = U * (∑ j, (1 + |x i - x j|)⁻¹) + (Fintype.card I : ℝ) * E := by
        simp only [div_eq_mul_inv, Finset.sum_add_distrib, ← Finset.mul_sum,
          Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
      _ ≤ _ := by
        exact add_le_add (mul_le_mul_of_nonneg_left
          (separated_reciprocal_row_bound Finset.univ x N i (Finset.mem_univ i)
            (fun j _ k _ hjk => hsep j k hjk) (fun j _ => hspan i j)) hU) le_rfl
  simpa only [mul_comm] using finite_row_gram_energy_le
    (fun i n => Complex.exp ((w n * x i : ℝ) * Complex.I)) c hB hrow

end Bounty
end

section

open Set

namespace Bounty

theorem mixed_logarithmic_difference_successor_formula
    (hs : List ℝ) (u c : ℝ) (k : ℕ) (x : ℝ)
    (hhs : ∀ h ∈ hs, 0 ≤ h) (hx : 0 < x+c) :
    ∃ y ∈ Icc x (x+hs.sum),
      mixedForwardDifference hs (logarithmicDerivativeChain u c (k+1)) x =
        (hs.prod * (u * (-1:ℝ)^(k+hs.length)) * ((k+hs.length).factorial:ℝ)) /
          (y+c)^(k+hs.length+1) := by
  obtain ⟨y, hy, hyeq⟩ := mixed_logarithmic_difference_mean_value hs u c (k+1) x hhs hx
  refine ⟨y, hy, ?_⟩
  have hk : k+1+hs.length = (k+hs.length)+1 := by omega
  rw [hyeq, hk, logarithmicDerivativeChain]
  ring

theorem mixed_logarithmic_difference_abs_bounds
    (hs : List ℝ) (u c : ℝ) (k : ℕ) (x : ℝ)
    (hhs : ∀ h ∈ hs, 0 ≤ h) (hx : 0 < x+c) :
    (hs.prod * |u| * ((k+hs.length).factorial:ℝ)) /
        (x+c+hs.sum)^(k+hs.length+1) ≤
      |mixedForwardDifference hs (logarithmicDerivativeChain u c (k+1)) x| ∧
    |mixedForwardDifference hs (logarithmicDerivativeChain u c (k+1)) x| ≤
      (hs.prod * |u| * ((k+hs.length).factorial:ℝ)) /
        (x+c)^(k+hs.length+1) := by
  obtain ⟨y, hy, hyeq⟩ := mixed_logarithmic_difference_successor_formula hs u c k x hhs hx
  have hypos : 0 < y+c := by linarith [hy.1]
  have hprod : 0 ≤ hs.prod := List.prod_nonneg hhs
  have habs : |mixedForwardDifference hs (logarithmicDerivativeChain u c (k+1)) x| =
      (hs.prod * |u| * ((k+hs.length).factorial:ℝ)) /
        (y+c)^(k+hs.length+1) := by
    rw [hyeq]
    simp [abs_div, abs_mul, abs_pow, abs_of_nonneg hprod, abs_of_pos hypos]
  rw [habs]
  have hn : 0 ≤ hs.prod * |u| * ((k+hs.length).factorial:ℝ) := by positivity
  constructor
  · apply div_le_div_of_nonneg_left hn (by positivity)
    apply pow_le_pow_left₀ (le_of_lt hypos)
    linarith [hy.2]
  · apply div_le_div_of_nonneg_left hn (by positivity)
    apply pow_le_pow_left₀ (le_of_lt hx)
    linarith [hy.1]

theorem mixed_logarithmic_difference_nonneg
    (hs : List ℝ) (u c : ℝ) (k : ℕ) (x : ℝ)
    (hhs : ∀ h ∈ hs, 0 ≤ h) (hx : 0 < x+c)
    (hsign : 0 ≤ u * (-1:ℝ)^(k+hs.length)) :
    0 ≤ mixedForwardDifference hs (logarithmicDerivativeChain u c (k+1)) x := by
  obtain ⟨y, hy, hyeq⟩ := mixed_logarithmic_difference_successor_formula hs u c k x hhs hx
  rw [hyeq]
  have hypos : 0 < y+c := by linarith [hy.1]
  have hprod : 0 ≤ hs.prod := List.prod_nonneg hhs
  positivity

theorem mixed_logarithmic_difference_nonpos
    (hs : List ℝ) (u c : ℝ) (k : ℕ) (x : ℝ)
    (hhs : ∀ h ∈ hs, 0 ≤ h) (hx : 0 < x+c)
    (hsign : u * (-1:ℝ)^(k+hs.length) ≤ 0) :
    mixedForwardDifference hs (logarithmicDerivativeChain u c (k+1)) x ≤ 0 := by
  obtain ⟨y, hy, hyeq⟩ := mixed_logarithmic_difference_successor_formula hs u c k x hhs hx
  rw [hyeq]
  have hypos : 0 < y+c := by linarith [hy.1]
  have hprod : 0 ≤ hs.prod := List.prod_nonneg hhs
  apply div_nonpos_of_nonpos_of_nonneg
  · exact mul_nonpos_of_nonpos_of_nonneg (mul_nonpos_of_nonneg_of_nonpos hprod hsign)
      (Nat.cast_nonneg _)
  · positivity

end Bounty
end

section

/- Explicit power savings after the scalar differencing iteration. -/

namespace Bounty

theorem van_der_corput_scalar_power_saving (H B C N θ : ℝ) (m : ℕ)
    (hN : 1 ≤ N) (hθ : 0 ≤ θ) (hC : 1 ≤ C)
    (hH : 2/H ≤ C*N^(-θ)) (hB : B ≤ C*N^(-θ)) :
    vanDerCorputScalarBound H B m ≤ 5^m*C*N^(-(θ/(2:ℝ)^m)) := by
  have hNp : 0 < N := lt_of_lt_of_le (by norm_num) hN
  have hη0 : 0 ≤ N^(-θ) := Real.rpow_nonneg hNp.le _
  have hη1 : N^(-θ) ≤ 1 := by
    have hh := Real.rpow_le_rpow_of_exponent_le hN (show -θ ≤ 0 by linarith)
    simpa only [Real.rpow_zero] using hh
  have h := van_der_corput_scalar_le_rpow H B C (N^(-θ)) m hη0 hη1 hC hH hB
  rw [← Real.rpow_mul hNp.le] at h
  convert h using 1 <;> congr 2 <;> ring

theorem inverse_floor_power_le (N θ : ℝ) (hN : 0 < N) (hpow : 2 ≤ N^θ) :
    2/(Nat.floor (N^θ) : ℝ) ≤ 4*N^(-θ) := by
  have hf := Nat.lt_floor_add_one (N^θ)
  have hfp : 0 < (Nat.floor (N^θ) : ℝ) := by linarith
  rw [Real.rpow_neg hN.le]
  change 2/(Nat.floor (N^θ) : ℝ) ≤ 4/(N^θ)
  apply (div_le_div_iff₀ hfp (Real.rpow_pos_of_pos hN _)).mpr
  linarith

theorem van_der_corput_floor_power_saving (B C N θ : ℝ) (m : ℕ)
    (hN : 1 ≤ N) (hθ : 0 ≤ θ) (hC : 4 ≤ C) (hpow : 2 ≤ N^θ)
    (hB : B ≤ C*N^(-θ)) :
    vanDerCorputScalarBound (Nat.floor (N^θ) : ℝ) B m ≤
      5^m*C*N^(-(θ/(2:ℝ)^m)) := by
  apply van_der_corput_scalar_power_saving _ _ _ _ _ _ hN hθ (by linarith) _ hB
  exact (inverse_floor_power_le N θ (by linarith) hpow).trans
    (mul_le_mul_of_nonneg_right hC (Real.rpow_nonneg (by linarith) _))

end Bounty
end

section

/- Quantitative removal of shared-draw restrictions for a coefficient independent
of every shared coordinate. -/

open Finset
open scoped Classical

namespace Bounty

def physicalSharedDrawGood {G : Type*} {P : G → Finset ℕ} {J : ℕ}
    (C : G → Finset (Fin J)) (T : ∀ g, Finset (P g))
    (s : PhysicalAuxLabels P (fun g => univ \ C g)) : Prop :=
  ∀ g, (∀ j, s g j ∉ T g) ∧ Function.Injective (s g)

theorem physical_shared_group_bad_mass {G : Type*}
    {P : G → Finset ℕ} {J : ℕ} (V : G → ℝ) (C : G → Finset (Fin J)) (g : G)
    (hV : 0 < V g) (hMass : ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (T : Finset (P g)) {Pmin : ℝ} (hPmin : 0 < Pmin)
    (hp : ∀ p : P g, Pmin ≤ (p.val : ℝ)) :
    (∑ s : (univ \ C g : Finset (Fin J)) → P g,
      cleanAuxiliaryWeight (physicalLabelLaw V g) s *
        (if (∃ j, s j ∈ T) ∨ ¬Function.Injective s then 1 else 0)) ≤
      (J - (C g).card : ℕ) * (T.card + (J - (C g).card : ℕ)) / (V g * Pmin) := by
  calc
    _ = ∑ s : (univ \ C g : Finset (Fin J)) → P g,
        cleanAuxiliaryBadWeight (physicalLabelLaw V g) T s := by
      apply sum_congr rfl
      intro s _
      unfold cleanAuxiliaryBadWeight
      by_cases hb : (∃ j, s j ∈ T) ∨ ¬Function.Injective s
      · simp only [if_pos hb]
      · simp only [if_neg hb]
    _ ≤ (Fintype.card ↥(univ \ C g) : ℝ) *
        (T.card + Fintype.card ↥(univ \ C g)) * (1 / (V g * Pmin)) :=
      clean_auxiliary_bad_weight_le (physicalLabelLaw V g)
        (fun p => div_nonneg zero_le_one (mul_nonneg hV.le (Nat.cast_nonneg p.val)))
        (physical_label_law_sum V g hV hMass) T (1 / (V g * Pmin))
        (div_nonneg zero_le_one (mul_pos hV hPmin).le)
        (fun p => physical_label_law_atom_le V g hV hPmin p (hp p))
    _ = _ := by
      simp only [Fintype.card_coe, card_sdiff_of_subset (subset_univ _), card_univ, Fintype.card_fin]
      ring

theorem physical_shared_draw_bad_mass {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (T : ∀ g, Finset (P g)) {Pmin : ℝ} (hPmin : 0 < Pmin)
    (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ)) :
    (∑ s : PhysicalAuxLabels P (fun g => univ \ C g),
      physicalAuxMass V (fun g => univ \ C g) s *
        (if ¬physicalSharedDrawGood C T s then 1 else 0)) ≤
      ∑ g, (J - (C g).card : ℕ) * ((T g).card + (J - (C g).card : ℕ)) /
        (V g * Pmin) := by
  have he (s : PhysicalAuxLabels P (fun g => univ \ C g)) :
      ¬physicalSharedDrawGood C T s ↔
        ∃ g, (∃ j, s g j ∈ T g) ∨ ¬Function.Injective (s g) := by
    simp only [physicalSharedDrawGood, not_forall, not_and_or, not_not]
  simp_rw [he]
  calc
    _ ≤ ∑ g, ∑ s : PhysicalAuxLabels P (fun g => univ \ C g),
        physicalAuxMass V (fun g => univ \ C g) s *
          (if (∃ j, s g j ∈ T g) ∨ ¬Function.Injective (s g) then 1 else 0) := by
      rw [sum_comm]
      apply sum_le_sum
      intro s _
      have hn := physical_aux_mass_nonneg V (fun g => univ \ C g) (fun g => (hV g).le) s
      by_cases hb : ∃ g, (∃ j, s g j ∈ T g) ∨ ¬Function.Injective (s g)
      · obtain ⟨g, hg⟩ := hb
        rw [if_pos ⟨g, hg⟩, mul_one]
        calc
          _ = physicalAuxMass V (fun g => univ \ C g) s *
              (if (∃ j, s g j ∈ T g) ∨ ¬Function.Injective (s g) then 1 else 0) := by
                rw [if_pos hg, mul_one]
          _ ≤ _ := by
            have hnn : ∀ i ∈ (univ : Finset G), 0 ≤ physicalAuxMass V (fun g => univ \ C g) s *
                (if (∃ j, s i j ∈ T i) ∨ ¬Function.Injective (s i) then 1 else 0) := by
              intro i _
              exact mul_nonneg hn (by split_ifs <;> norm_num)
            exact single_le_sum hnn (mem_univ g)
      · rw [if_neg hb, mul_zero]
        apply sum_nonneg
        intro g _
        exact mul_nonneg hn (by split_ifs <;> norm_num)
    _ = ∑ g, ∑ s : (univ \ C g : Finset (Fin J)) → P g,
        cleanAuxiliaryWeight (physicalLabelLaw V g) s *
          (if (∃ j, s j ∈ T g) ∨ ¬Function.Injective s then 1 else 0) := by
      apply sum_congr rfl
      intro g _
      exact physical_auxiliary_group_marginal V (fun g => univ \ C g) hV hMass g
        (fun s => if (∃ j, s j ∈ T g) ∨ ¬Function.Injective s then 1 else 0)
    _ ≤ _ := by
      apply sum_le_sum
      intro g _
      exact physical_shared_group_bad_mass V C g (hV g) (hMass g) (T g) hPmin (hp g)

theorem physical_shared_draw_endpoint_bad_mass {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (aux : PhysicalAuxLabels P C) {w z : ℕ} (hw : 0 < w) (hz : 0 < z)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ)) :
    (∑ s : PhysicalAuxLabels P (fun g => univ \ C g),
      physicalAuxMass V (fun g => univ \ C g) s *
        (if ¬physicalSharedDrawGood C (fun g => physicalSharedForbidden C aux g w z) s
          then 1 else 0)) ≤
      ∑ g, (J - (C g).card : ℕ) *
        (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) / (V g * Pmin) := by
  refine (physical_shared_draw_bad_mass V C hV hMass _ hPmin hp).trans ?_
  apply sum_le_sum
  intro g _
  apply div_le_div_of_nonneg_right _ (mul_pos (hV g) hPmin).le
  apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
  have hc : (C g).card ≤ J := (card_le_card (subset_univ _)).trans_eq (by simp)
  have he : ((C g).card : ℝ) + (J - (C g).card : ℕ) = J := by
    have hn : (C g).card + (J - (C g).card) = J := by omega
    exact_mod_cast hn
  linarith [physical_shared_forbidden_log_card C aux g hw hz]

end Bounty
end

section

/- Pool-invariant weights can be moved entirely to the residual convolution factor. -/

open Finset

namespace Bounty

theorem weighted_free_divisor_convolution (P : Finset ℕ) (W α γ : ℕ → ℂ)
    (hW : ∀ a b : ℕ, b ≠ 0 → Disjoint b.primeFactors P → W (a * b) = W a)
    (hα : ∀ d : ℕ, ¬ Disjoint d.primeFactors P → α d = 0)
    {n : ℕ} (hn : n ≠ 0) :
    W n * (∑ d ∈ (primePoolFreePart P n).divisors, α d * γ (primePoolFreePart P n / d)) =
      ∑ d ∈ n.divisors, α d * (W (n / d) * γ (primePoolFreePart P (n / d))) := by
  classical
  calc
    _ = ∑ d ∈ (primePoolFreePart P n).divisors,
        α d * (W (n / d) * γ (primePoolFreePart P (n / d))) := by
      rw [mul_sum]
      apply sum_congr rfl
      intro d hd
      obtain ⟨hdn, hfree⟩ := (dvd_primePoolFreePart_iff P hn).mp (Nat.mem_divisors.mp hd).1
      rw [invariant_pool_free_divisor_weight P W hW hn hdn hfree,
        primePoolFreePart_div_of_free P hn hdn hfree]
      ring
    _ = ∑ d ∈ n.divisors.filter (fun d => Disjoint d.primeFactors P),
        α d * (W (n / d) * γ (primePoolFreePart P (n / d))) := by
      rw [divisors_primePoolFreePart P hn]
    _ = _ := by
      rw [sum_filter]
      apply sum_congr rfl
      intro d _
      by_cases hd : Disjoint d.primeFactors P
      · rw [if_pos hd]
      · rw [if_neg hd, hα d hd, zero_mul]

theorem weighted_invariant_triple_convolution (P : Finset ℕ) (W α β γ : ℕ → ℂ)
    (hW : ∀ a b : ℕ, b ≠ 0 → Disjoint b.primeFactors P → W (a * b) = W a)
    (hα : ∀ d : ℕ, ¬ Disjoint d.primeFactors P → α d = 0)
    (hβ : ∀ d : ℕ, ¬ Disjoint d.primeFactors P → β d = 0)
    {n : ℕ} (hn : n ≠ 0) :
    W n * invariantTripleEndpoint P α β γ n =
      endpointTripleConvolution α β (fun r => W r * γ (primePoolFreePart P r)) n := by
  have hfirst := weighted_free_divisor_convolution P W α
    (fun k => ∑ d ∈ k.divisors, β d * γ (k / d)) hW hα hn
  have hlocal (m : ℕ) (hm : m ∈ n.divisors) :=
    weighted_free_divisor_convolution P W β γ hW hβ
      (show n / m ≠ 0 by
        intro h
        have he := Nat.mul_div_cancel' (Nat.mem_divisors.mp hm).1
        rw [h, mul_zero] at he
        exact hn he.symm)
  calc
    _ = W n * (∑ m ∈ (primePoolFreePart P n).divisors,
        α m * (∑ d ∈ (primePoolFreePart P n / m).divisors,
          β d * γ (primePoolFreePart P n / m / d))) := by
      simp only [invariantTripleEndpoint, endpointTripleConvolution, mul_sum, mul_assoc]
    _ = ∑ m ∈ n.divisors, α m * (W (n / m) *
        (∑ d ∈ (primePoolFreePart P (n / m)).divisors,
          β d * γ (primePoolFreePart P (n / m) / d))) := hfirst
    _ = _ := by
      unfold endpointTripleConvolution
      apply sum_congr rfl
      intro m hm
      rw [hlocal m hm, mul_sum]
      apply sum_congr rfl
      intro d _
      ring

end Bounty
end

section

/- The square of the fourfold divisor count is bounded by a sixteenfold divisor count. -/

open Finset

namespace Bounty

theorem square_bound_of_scaled_recurrences {a b c d x y z : ℕ}
    (hx : 0 < x) (hy : y ^ 2 ≤ z * x) (hab : a * y = b * x)
    (hcd : c * z = d * x) (hac : a ^ 2 ≤ c) : b ^ 2 ≤ d := by
  have hh : x ^ 2 * b ^ 2 ≤ x ^ 2 * d := by
    calc
      _ = a ^ 2 * y ^ 2 := by nlinarith only [congrArg (fun n : ℕ => n ^ 2) hab]
      _ ≤ a ^ 2 * (z * x) := Nat.mul_le_mul_left _ hy
      _ ≤ c * (z * x) := Nat.mul_le_mul_right _ hac
      _ = _ := by nlinarith only [congrArg (fun n : ℕ => n * x) hcd]
  exact Nat.le_of_mul_le_mul_left hh (Nat.pow_pos hx)

theorem choose_three_square_le_choose_fifteen (a : ℕ) :
    (a + 3).choose 3 ^ 2 ≤ (a + 15).choose 15 := by
  induction a with
  | zero => norm_num
  | succ a ih =>
    have h3 := Nat.choose_mul_succ_eq (a + 3) 3
    have h15 := Nat.choose_mul_succ_eq (a + 15) 15
    rw [show a + 3 + 1 - 3 = a + 1 by omega] at h3
    rw [show a + 15 + 1 - 15 = a + 1 by omega] at h15
    have h3' : (a + 3).choose 3 * (a + 4) = (a + 4).choose 3 * (a + 1) := by
      simpa only [Nat.add_assoc, Nat.reduceAdd] using h3
    have h15' : (a + 15).choose 15 * (a + 16) = (a + 16).choose 15 * (a + 1) := by
      simpa only [Nat.add_assoc, Nat.reduceAdd] using h15
    have hp : (a + 4) ^ 2 ≤ (a + 16) * (a + 1) := by nlinarith
    have hres := square_bound_of_scaled_recurrences (by omega : 0 < a + 1) hp h3' h15' ih
    simpa only [Nat.succ_eq_add_one, Nat.add_assoc] using hres

theorem zeta_four_square_le_zeta_sixteen (n : ℕ) :
    ((ArithmeticFunction.zeta ^ 4) n) ^ 2 ≤ (ArithmeticFunction.zeta ^ 16) n := by
  by_cases hn : n = 0
  · simp [hn]
  rw [(ArithmeticFunction.isMultiplicative_zeta.pow (k := 4)).multiplicative_factorization _ hn,
    (ArithmeticFunction.isMultiplicative_zeta.pow (k := 16)).multiplicative_factorization _ hn]
  simp only [Finsupp.prod, ← Finset.prod_pow]
  apply Finset.prod_le_prod'
  intro p hp
  have hp' := Nat.prime_of_mem_primeFactors hp
  rw [show 4 = 3 + 1 by omega, show 16 = 15 + 1 by omega,
    divisor_zeta_power_prime_pow 3 _ hp', divisor_zeta_power_prime_pow 15 _ hp']
  exact choose_three_square_le_choose_fifteen _

theorem zeta_four_square_summatory (N : ℕ) :
    (∑ n ∈ Ioc 0 N, (((ArithmeticFunction.zeta ^ 4) n : ℕ) : ℝ) ^ 2) ≤
      (N : ℝ) * (1 + Real.log N) ^ 15 := by
  calc
    _ ≤ ∑ n ∈ Ioc 0 N, ((ArithmeticFunction.zeta ^ 16) n : ℝ) := by
      apply sum_le_sum
      intro n _
      exact_mod_cast zeta_four_square_le_zeta_sixteen n
    _ ≤ (N : ℝ) * divisorHarmonic N ^ 15 := by
      simpa only [Nat.reduceAdd] using divisor_zeta_summatory_bound 15 N
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (pow_le_pow_left₀ (divisor_harmonic_nonneg N) (divisor_harmonic_log_bound N) 15)
      (Nat.cast_nonneg N)

end Bounty
end

section

/- The coefficient family is uniform over every residual in the same gcd slice. -/

open scoped BigOperators Classical

namespace Bounty

theorem rational_four_factor_gcd_slice_expansion {r Q d : ℕ}
    (hr : 0 < r) (hrQ : r ≤ Q) (hd : 0 < d) (hdr : d ∣ r) (u : ℤ) :
    ∃ c : AddChar (Additive (ZMod (r / d))ˣ) ℂ → ℂ,
      (∑ ψ, ‖c ψ‖) ≤ Real.sqrt (Q : ℝ) ∧
      ∀ m a p n : ℕ, m.Coprime r → a.Coprime r → p.Coprime r → n.gcd r = d →
        (∑ ψ, c ψ * unitAddCharDirichlet ψ (m : ZMod (r / d)) *
          unitAddCharDirichlet ψ (a : ZMod (r / d)) * unitAddCharDirichlet ψ (p : ZMod (r / d)) *
          unitAddCharDirichlet ψ ((n / d : ℕ) : ZMod (r / d))) =
          Complex.exp (Complex.I * (2 * Real.pi * ((u : ℝ) / r * (m * a * p * n)) : ℝ)) := by
  have hq : 0 < r / d := Nat.div_pos (Nat.le_of_dvd hr hdr) hd
  have hqr : r / d ∣ r := Nat.div_dvd_of_dvd hdr
  obtain ⟨c, hc, he⟩ := rational_four_factor_unit_expansion hq
    ((Nat.div_le_self _ _).trans hrQ) u
  refine ⟨c, hc, ?_⟩
  intro m a p n hm ha hp hnd
  have hv : (n / d).Coprime (r / d) := by
    rw [← hnd]
    exact Nat.coprime_div_gcd_div_gcd (hnd.symm ▸ hd)
  have hdn : d ∣ n := hnd ▸ Nat.gcd_dvd_left n r
  rw [he m a p (n / d) (hm.of_dvd_right hqr) (ha.of_dvd_right hqr)
    (hp.of_dvd_right hqr) hv]
  exact (rational_four_factor_phase_cancel hd hq
    (Nat.mul_div_cancel' hdr) (Nat.mul_div_cancel' hdn) u m a p).symm

end Bounty
end

section

/- The normalized Mellin polynomial of a finite four-factor box separates exactly. -/

open Finset

namespace Bounty

theorem harmonic_mellin_weight_four_factors (t : ℝ) {m a p n : ℕ}
    (hm : 0 < m) (ha : 0 < a) (hp : 0 < p) (hn : 0 < n) :
    harmonicMellinWeight t ((m * a * p * n : ℕ) : ℝ) =
      harmonicMellinWeight t m * harmonicMellinWeight t a *
        harmonicMellinWeight t p * harmonicMellinWeight t n := by
  simp only [Nat.cast_mul]
  rw [harmonic_mellin_weight_mul t (by positivity) (by positivity),
    harmonic_mellin_weight_mul t (by positivity) (by positivity),
    harmonic_mellin_weight_mul t (by positivity) (by positivity)]

theorem harmonic_mellin_four_factor_box (M A P N : Finset ℕ)
    (hM : ∀ m ∈ M, 0 < m) (hA : ∀ a ∈ A, 0 < a)
    (hP : ∀ p ∈ P, 0 < p) (hN : ∀ n ∈ N, 0 < n)
    (α δ β γ : ℕ → ℂ) (t : ℝ) :
    (∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P, ∑ n ∈ N,
      (α m * δ a * β p * γ n) * harmonicMellinWeight t ((m * a * p * n : ℕ) : ℝ)) =
      (∑ m ∈ M, α m * harmonicMellinWeight t m) *
      (∑ a ∈ A, δ a * harmonicMellinWeight t a) *
      (∑ p ∈ P, β p * harmonicMellinWeight t p) *
      (∑ n ∈ N, γ n * harmonicMellinWeight t n) := by
  calc
    _ = ∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P, ∑ n ∈ N,
        (α m * harmonicMellinWeight t m) * (δ a * harmonicMellinWeight t a) *
          (β p * harmonicMellinWeight t p) * (γ n * harmonicMellinWeight t n) := by
      apply sum_congr rfl
      intro m hm
      apply sum_congr rfl
      intro a ha
      apply sum_congr rfl
      intro p hp
      apply sum_congr rfl
      intro n hn
      rw [harmonic_mellin_weight_four_factors t (hM m hm) (hA a ha) (hP p hp) (hN n hn)]
      ring
    _ = _ := by
      simp only [← mul_sum, ← sum_mul]

end Bounty
end

section

/- Exact Mellin factorization for the two subproducts used in mean-square bounds. -/

open Finset

namespace Bounty

theorem divisor_pair_finite_mellin (S A B : Finset ℕ) (α β : ℕ → ℂ)
    (hA : ∀ a ∈ A, 0 < a) (hB : ∀ b ∈ B, 0 < b)
    (hα : ∀ a, a ∉ A → α a = 0) (hβ : ∀ b, b ∉ B → β b = 0)
    (hS : ∀ a ∈ A, ∀ b ∈ B, a*b ∈ S) (t : ℝ) :
    (∑ n ∈ S, (∑ d ∈ n.divisors, α d*β (n/d))*harmonicMellinWeight t n) =
      (∑ a ∈ A, α a*harmonicMellinWeight t a)*(∑ b ∈ B, β b*harmonicMellinWeight t b) := by
  rw [finite_divisor_convolution_transform S A B α β _ hA hB hα hβ hS]
  calc
    _ = ∑ a ∈ A, ∑ b ∈ B, (α a*harmonicMellinWeight t a)*(β b*harmonicMellinWeight t b) := by
      apply sum_congr rfl
      intro a ha
      apply sum_congr rfl
      intro b hb
      rw [Nat.cast_mul,harmonic_mellin_weight_mul t (by exact_mod_cast hA a ha) (by exact_mod_cast hB b hb)]
      ring
    _ = _ := by simp only [← mul_sum,← sum_mul]

theorem endpoint_triple_finite_mellin (S A B C : Finset ℕ) (α β γ : ℕ → ℂ)
    (hA : ∀ a ∈ A, 0 < a) (hB : ∀ b ∈ B, 0 < b) (hC : ∀ c ∈ C, 0 < c)
    (hα : ∀ a, a ∉ A → α a = 0) (hβ : ∀ b, b ∉ B → β b = 0)
    (hγ : ∀ c, c ∉ C → γ c = 0)
    (hS : ∀ a ∈ A, ∀ b ∈ B, ∀ c ∈ C, a*b*c ∈ S) (t : ℝ) :
    (∑ n ∈ S, endpointTripleConvolution α β γ n*harmonicMellinWeight t n) =
      (∑ a ∈ A, α a*harmonicMellinWeight t a)*
      (∑ b ∈ B, β b*harmonicMellinWeight t b)*(∑ c ∈ C, γ c*harmonicMellinWeight t c) := by
  rw [endpoint_triple_finite_transform S A B C α β γ _ hA hB hC hα hβ hγ hS]
  calc
    _ = ∑ a ∈ A, ∑ b ∈ B, ∑ c ∈ C,
        (α a*harmonicMellinWeight t a)*(β b*harmonicMellinWeight t b)*(γ c*harmonicMellinWeight t c) := by
      apply sum_congr rfl
      intro a ha
      apply sum_congr rfl
      intro b hb
      apply sum_congr rfl
      intro c hc
      have ha0 : 0 < (a : ℝ) := by exact_mod_cast hA a ha
      have hb0 : 0 < (b : ℝ) := by exact_mod_cast hB b hb
      have hc0 : 0 < (c : ℝ) := by exact_mod_cast hC c hc
      simp only [Nat.cast_mul]
      rw [harmonic_mellin_weight_mul t (mul_pos ha0 hb0) hc0,harmonic_mellin_weight_mul t ha0 hb0]
      ring
    _ = _ := by simp only [← mul_sum,← sum_mul]

end Bounty
end

section

/- Uniform-in-frequency bounds for finite harmonic Mellin polynomials. -/

open Finset

namespace Bounty

theorem finite_mellin_norm_le_mass (S : Finset ℕ) (f : ℕ → ℂ) (u U : ℝ)
    (hU : 0 < U) (hS : ∀ n ∈ S, U ≤ (n : ℝ)) :
    ‖∑ n ∈ S, harmonicMellinWeight u n * f n‖ ≤ (∑ n ∈ S, ‖f n‖) / U := by
  calc
    _ ≤ ∑ n ∈ S, ‖harmonicMellinWeight u n * f n‖ := norm_sum_le _ _
    _ ≤ ∑ n ∈ S, (1 / U) * ‖f n‖ := by
      apply sum_le_sum
      intro n hn
      rw [norm_mul, norm_harmonic_mellin_weight u (hU.trans_le (hS n hn))]
      exact mul_le_mul_of_nonneg_right (one_div_le_one_div_of_le hU (hS n hn)) (norm_nonneg _)
    _ = _ := by rw [← mul_sum]; ring

theorem divisor_harmonic_floor_le_log {X : ℝ} (hX : 1 ≤ X) :
    divisorHarmonic ⌊X⌋₊ ≤ 1 + Real.log X := by
  have hs : Ioc 0 ⌊X⌋₊ = Icc 1 ⌊X⌋₊ := by ext n; simp only [mem_Ioc, mem_Icc]; omega
  have he : divisorHarmonic ⌊X⌋₊ = (harmonic ⌊X⌋₊ : ℝ) := by
    simp only [divisorHarmonic, harmonic_eq_sum_Icc, Rat.cast_sum, Rat.cast_inv,
      Rat.cast_natCast, hs]
  rw [he]
  exact harmonic_floor_le_one_add_log X hX

theorem finite_dyadic_mellin_zeta_norm (S : Finset ℕ) (f : ℕ → ℂ)
    (u U B : ℝ) (k : ℕ) (hU : 1 ≤ U) (hB : 0 ≤ B)
    (hS : ∀ n ∈ S, U ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*U)
    (hf : ∀ n ∈ S, ‖f n‖ ≤ B * ((ArithmeticFunction.zeta^(k+1)) n : ℝ)) :
    ‖∑ n ∈ S, harmonicMellinWeight u n * f n‖ ≤
      2*B*(1+Real.log (2*U))^k := by
  have hUpos : 0 < U := by linarith
  have hsub : S ⊆ Ioc 0 ⌊2*U⌋₊ := by
    intro n hn
    exact mem_Ioc.mpr ⟨by exact_mod_cast hUpos.trans_le (hS n hn).1,
      Nat.le_floor (hS n hn).2⟩
  have hmass : (∑ n ∈ S, ‖f n‖) ≤ B*(2*U)*(1+Real.log (2*U))^k := by
    calc
      _ ≤ ∑ n ∈ S, B*((ArithmeticFunction.zeta^(k+1)) n : ℝ) := sum_le_sum hf
      _ = B*(∑ n ∈ S, ((ArithmeticFunction.zeta^(k+1)) n : ℝ)) := (mul_sum _ _ _).symm
      _ ≤ B*(∑ n ∈ Ioc 0 ⌊2*U⌋₊, ((ArithmeticFunction.zeta^(k+1)) n : ℝ)) := by
        apply mul_le_mul_of_nonneg_left _ hB
        exact sum_le_sum_of_subset_of_nonneg hsub (by intros; positivity)
      _ ≤ B*((⌊2*U⌋₊ : ℝ)*divisorHarmonic ⌊2*U⌋₊^k) :=
        mul_le_mul_of_nonneg_left (divisor_zeta_summatory_bound k _) hB
      _ ≤ B*((2*U)*(1+Real.log (2*U))^k) := by
        apply mul_le_mul_of_nonneg_left _ hB
        exact mul_le_mul (Nat.floor_le (by linarith))
          (pow_le_pow_left₀ (divisor_harmonic_nonneg _)
            (divisor_harmonic_floor_le_log (by linarith : 1 ≤ 2*U)) k)
          (pow_nonneg (divisor_harmonic_nonneg _) k) (by linarith)
      _ = _ := by ring
  calc
    _ ≤ (∑ n ∈ S, ‖f n‖)/U := finite_mellin_norm_le_mass S f u U hUpos (fun n hn => (hS n hn).1)
    _ ≤ (B*(2*U)*(1+Real.log (2*U))^k)/U := div_le_div_of_nonneg_right hmass hUpos.le
    _ = _ := by field_simp

end Bounty
end

section

/- Uniform numerical bounds for the shared-draw error and the half-density
overlap loss, without assumptions on the individual cut. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_shared_count_le {G : Type*} [Fintype G] {J : ℕ}
    (C : G → Finset (Fin J)) :
    (∑ g : G, (J - (C g).card)) ≤ J * Fintype.card G := by
  calc
    _ ≤ ∑ _g : G, J := sum_le_sum (fun _ _ => Nat.sub_le _ _)
    _ = _ := by simp only [sum_const, card_univ, smul_eq_mul, mul_comm]

theorem physical_shared_error_uniform_bound {G : Type*} [Fintype G] {J : ℕ}
    (C : G → Finset (Fin J)) (V : G → ℝ)
    {v Pmin T : ℝ} (hv : 0 < v) (hPmin : 0 < Pmin) (hT : 0 ≤ T)
    (hV : ∀ g, v ≤ V g) :
    (∑ g : G, (J - (C g).card : ℕ) * T / (V g * Pmin)) ≤
      (Fintype.card G : ℝ) * J * T / (v * Pmin) := by
  calc
    _ ≤ ∑ _g : G, (J : ℝ) * T / (v * Pmin) := by
      apply sum_le_sum
      intro g _
      apply div_le_div₀ (mul_nonneg (Nat.cast_nonneg _) hT)
        (mul_le_mul_of_nonneg_right (by exact_mod_cast Nat.sub_le J (C g).card) hT)
        (mul_pos hv hPmin)
        (mul_le_mul_of_nonneg_right (hV g) hPmin.le)
    _ = _ := by simp only [sum_const, card_univ, nsmul_eq_mul]; ring

theorem physical_shared_half_overlap_bound {G : Type*} [Fintype G] {J : ℕ}
    (C : G → Finset (Fin J)) {H : ℝ} (hH : 0 ≤ H) :
    H + H / (1 / 2 : ℝ) ^ (2 * ∑ g : G, (J - (C g).card)) ≤
      2 * H * (4 : ℝ) ^ (J * Fintype.card G) := by
  have hp : (4 : ℝ) ^ (∑ g : G, (J - (C g).card)) ≤ 4 ^ (J * Fintype.card G) :=
    pow_le_pow_right₀ (by norm_num) (physical_shared_count_le C)
  have h1 : (1 : ℝ) ≤ 4 ^ (J * Fintype.card G) := one_le_pow₀ (by norm_num)
  have he : H / (1 / 2 : ℝ) ^ (2 * ∑ g : G, (J - (C g).card)) =
      H * 4 ^ (∑ g : G, (J - (C g).card)) := by
    simp only [one_div, inv_pow, div_inv_eq_mul, pow_mul]
    norm_num
  rw [he]
  nlinarith [mul_le_mul_of_nonneg_left hp hH, mul_le_mul_of_nonneg_left h1 hH]

end Bounty
end

section

/- Explicit energy budgets control the replacement of a harmonic endpoint pair. -/

open Finset
namespace Bounty

theorem finite_replacement_energy {ι : Type*} (S : Finset ι) (f f' : ι → ℂ) :
    (∑ n ∈ S, ‖f' n‖ ^ 2) ≤
      2 * ((∑ n ∈ S, ‖f n‖ ^ 2) + ∑ n ∈ S, ‖f n - f' n‖ ^ 2) := by
  calc
    _ ≤ ∑ n ∈ S, 2 * (‖f n‖ ^ 2 + ‖f n - f' n‖ ^ 2) := by
      apply sum_le_sum
      intro n _
      have hn : ‖f' n‖ ≤ ‖f n‖ + ‖f n - f' n‖ := by
        calc
          _ = ‖f n - (f n - f' n)‖ := by congr 1; ring
          _ ≤ _ := norm_sub_le _ _
      have hs := pow_le_pow_left₀ (norm_nonneg _) hn 2
      nlinarith [sq_nonneg (‖f n‖ - ‖f n - f' n‖)]
    _ = _ := by rw [← mul_sum, sum_add_distrib]

theorem finite_harmonic_replacement_energy_bound
    (S : Finset ℤ) (θ f g f' g' : ℤ → ℂ)
    {Y K E D : ℝ} (hY : 0 < Y) (hK : 0 ≤ K)
    (hYlow : ∀ n ∈ S, Y ≤ (n : ℝ)) (hθ : ∀ n ∈ S, ‖θ n‖ ≤ K)
    (hf : (∑ n ∈ S, ‖f n‖ ^ 2) ≤ E)
    (hg : (∑ n ∈ S, ‖g n‖ ^ 2) ≤ E)
    (hff : (∑ n ∈ S, ‖f n - f' n‖ ^ 2) ≤ D)
    (hgg : (∑ n ∈ S, ‖g n - g' n‖ ^ 2) ≤ D) :
    ‖(∑ n ∈ S, (θ n / (n : ℂ)) * (starRingEnd ℂ) (f n) * g n) -
      (∑ n ∈ S, (θ n / (n : ℂ)) * (starRingEnd ℂ) (f' n) * g' n)‖ ≤
      (K/Y) * (Real.sqrt D * Real.sqrt E + Real.sqrt (2*(E+D)) * Real.sqrt D) := by
  apply (finite_harmonic_endpoint_replacement S θ f g f' g' hY hK hYlow hθ).trans
  apply mul_le_mul_of_nonneg_left _ (div_nonneg hK hY.le)
  apply add_le_add
  · exact mul_le_mul (Real.sqrt_le_sqrt hff) (Real.sqrt_le_sqrt hg)
      (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)
  · have hf' := (finite_replacement_energy S f f').trans
      (mul_le_mul_of_nonneg_left (add_le_add hf hff) (by norm_num : (0 : ℝ) ≤ 2))
    exact mul_le_mul (Real.sqrt_le_sqrt hf') (Real.sqrt_le_sqrt hgg)
      (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)

end Bounty
end

section

/- A prescribed ledger sequence with the actual event updates gives the
exact local phase product on the original dependent path. -/

open Finset
namespace Bounty
section Product
variable {K L X : Type*} (E : K → X → Type*)
  (target : ∀ k x, E k x → X) (update : ∀ k, L → (x : X) → E k x → L)
  (phase : ∀ k, L → (x : X) → E k x → ℂ)

theorem deterministic_ledger_phase_eq_product
    (ks : List K) (x : X) (p : FiniteEventPath E target ks x)
    (l : Fin (ks.length + 1) → L)
    (hstep : ∀ i : Fin ks.length,
      update (ks.get i) (l i.castSucc)
        (finiteEventPathOccurrence E target ks x p i).1
        (finiteEventPathOccurrence E target ks x p i).2 = l i.succ) :
    deterministicLedgerPhase E target update phase ks (l 0) x p =
      ∏ i : Fin ks.length, phase (ks.get i) (l i.castSucc)
        (finiteEventPathOccurrence E target ks x p i).1
        (finiteEventPathOccurrence E target ks x p i).2 := by
  induction ks generalizing x with
  | nil => simp only [deterministicLedgerPhase, List.length_nil, Fin.prod_univ_zero]
  | cons k ks ih =>
    rcases p with ⟨e, p⟩
    have h0 : update k (l 0) x e = l (Fin.succ 0) := hstep 0
    have ht := ih (target k x e) p (fun i => l i.succ) (fun i => hstep i.succ)
    calc
      _ = phase k (l 0) x e *
          deterministicLedgerPhase E target update phase ks (l (Fin.succ 0)) (target k x e) p := by
        rw [deterministicLedgerPhase, h0]
      _ = phase k (l 0) x e *
          ∏ i : Fin ks.length, phase (ks.get i) (l i.castSucc.succ)
            (finiteEventPathOccurrence E target ks (target k x e) p i).1
            (finiteEventPathOccurrence E target ks (target k x e) p i).2 := congrArg (phase k (l 0) x e * ·) ht
      _ = _ := (Fin.prod_univ_succ (fun i : Fin (ks.length + 1) =>
        phase ((k :: ks).get i) (l i.castSucc)
          (finiteEventPathOccurrence E target (k :: ks) x ⟨e, p⟩ i).1
          (finiteEventPathOccurrence E target (k :: ks) x ⟨e, p⟩ i).2)).symm

theorem deterministic_ledger_terminal_eq_last
    (ks : List K) (x : X) (p : FiniteEventPath E target ks x)
    (l : Fin (ks.length + 1) → L)
    (hstep : ∀ i : Fin ks.length,
      update (ks.get i) (l i.castSucc)
        (finiteEventPathOccurrence E target ks x p i).1
        (finiteEventPathOccurrence E target ks x p i).2 = l i.succ) :
    finiteEventPathLedger E target update ks (l 0) x p = l (Fin.last ks.length) := by
  induction ks generalizing x with
  | nil => rfl
  | cons k ks ih =>
    rcases p with ⟨e, p⟩
    have h0 : update k (l 0) x e = l (Fin.succ 0) := hstep 0
    rw [finiteEventPathLedger, h0]
    exact ih (target k x e) p (fun i => l i.succ) (fun i => hstep i.succ)

end Product
end Bounty
end

section

/- Explicit coefficient cost and support of the finite cell expansion. -/

open Finset
open scoped Classical
namespace Bounty

theorem prime_cell_coefficient_norm {I : Type*} [Fintype I]
    (P : I → Finset ℕ) (V : I → ℝ) (h : ℝ) (d : ℤ) {ξ : ℝ} (hξ : 0 < ξ)
    (hd : ξ ≤ finiteCellMass (finiteProductWeight (physicalLabelLaw (P := P) V))
      (fun z => upperLogCell h (Real.log (∏ i, (z i).val : ℕ))) d) :
    ‖((1 / finiteCellMass (finiteProductWeight (physicalLabelLaw (P := P) V))
      (fun z => upperLogCell h (Real.log (∏ i, (z i).val : ℕ))) d : ℝ) : ℂ)‖ ≤ 1/ξ := by
  rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos (one_div_pos.mpr (hξ.trans_le hd))]
  exact one_div_le_one_div_of_le hξ hd

theorem prime_cell_expansion_cost {I : Type*} [Fintype I]
    (P : I → Finset ℕ) (V : I → ℝ) (Q : ℕ) (h : ℝ) (kept : Finset ℤ)
    {ξ : ℝ} (hξ : 0 < ξ)
    (hkept : ∀ d ∈ kept, ξ ≤ finiteCellMass (finiteProductWeight (physicalLabelLaw (P := P) V))
      (fun z => upperLogCell h (Real.log (∏ i, (z i).val : ℕ))) d) :
    (∑ d ∈ kept, ∑ _χ : BoundedPrimitiveCharacter Q,
      ‖((1 / finiteCellMass (finiteProductWeight (physicalLabelLaw (P := P) V))
        (fun z => upperLogCell h (Real.log (∏ i, (z i).val : ℕ))) d : ℝ) : ℂ)‖) ≤
      (kept.card : ℝ) * (Q * Q : ℕ) / ξ := by
  calc
    _ ≤ ∑ _d ∈ kept, ∑ _χ : BoundedPrimitiveCharacter Q, 1/ξ := by
      apply sum_le_sum
      intro d hd
      exact sum_le_sum (fun _ _ => prime_cell_coefficient_norm P V h d hξ (hkept d hd))
    _ = (kept.card : ℝ) * (Fintype.card (BoundedPrimitiveCharacter Q) : ℝ) / ξ := by
      simp only [sum_const, card_univ, nsmul_eq_mul]
      ring
    _ ≤ _ := div_le_div_of_nonneg_right
      (mul_le_mul_of_nonneg_left (Nat.cast_le.mpr (bounded_primitive_character_card_le Q))
        (Nat.cast_nonneg _)) hξ.le

theorem prime_cell_character_mem {I : Type*} [Fintype I]
    (P : I → Finset ℕ) (h : ℝ) (d : ℤ) {Q : ℕ} (χ : BoundedPrimitiveCharacter Q)
    (x : ∀ i, P i) (hx : primeProductCellCharacter P h d χ x ≠ 0) :
    upperLogCell h (Real.log (∏ i, (x i).val : ℕ)) = d := by
  by_contra he
  exact hx (by simp only [primeProductCellCharacter, if_neg he])

end Bounty
end

section

/- Each term separates both free-product variables from the two endpoints. -/

open Finset
open scoped Classical
namespace Bounty

theorem prime_ideal_kernel_pair_cell_expansion
    {I J : Type*} [Fintype I] [DecidableEq I] [Fintype J] [DecidableEq J]
    (P : I → Finset ℕ) (V : I → ℝ) (R : J → Finset ℕ) (W : J → ℝ)
    (Q : ℕ) (h : ℝ) (keptP keptR : Finset ℤ)
    (x u : ∀ i, P i) (y v : ∀ j, R j) :
    let a := fun d => ((1 / finiteCellMass (finiteProductWeight (physicalLabelLaw (P := P) V))
      (fun z => upperLogCell h (Real.log (∏ i, (z i).val : ℕ))) d : ℝ) : ℂ)
    let b := fun e => ((1 / finiteCellMass (finiteProductWeight (physicalLabelLaw (P := R) W))
      (fun z => upperLogCell h (Real.log (∏ j, (z j).val : ℕ))) e : ℝ) : ℂ)
    primeProductIdealKernel P V Q h keptP x u * primeProductIdealKernel R W Q h keptR y v =
      ∑ d ∈ keptP, ∑ χ : BoundedPrimitiveCharacter Q,
        ∑ e ∈ keptR, ∑ ψ : BoundedPrimitiveCharacter Q,
          (a d*b e) *
            ((starRingEnd ℂ) (primeProductCellCharacter P h d χ x) *
              (starRingEnd ℂ) (primeProductCellCharacter R h e ψ y)) *
            (primeProductCellCharacter R h e ψ v * primeProductCellCharacter P h d χ u) := by
  dsimp only
  rw [prime_ideal_kernel_cell_expansion, prime_ideal_kernel_cell_expansion]
  simp only [sum_mul]
  simp only [mul_sum]
  apply sum_congr rfl
  intro d _
  apply sum_congr rfl
  intro χ _
  apply sum_congr rfl
  intro e _
  apply sum_congr rfl
  intro ψ _
  ring

end Bounty
end

section

/- Two deterministic phases agree when their local updates agree on the
states supported by the original nonzero path phase. -/

namespace Bounty

theorem deterministic_ledger_phase_eq_on_support
    {K L X : Type*} (E : K → X → Type*) (target : ∀ k x, E k x → X)
    (supportPhase : ∀ k x, E k x → ℂ) (Q : X → Prop)
    (hQ : ∀ k x e, Q x → supportPhase k x e ≠ 0 → Q (target k x e))
    (u v : ∀ k, L → (x : X) → E k x → L)
    (hu : ∀ k l x e, Q x → supportPhase k x e ≠ 0 → u k l x e = v k l x e)
    (f g : ∀ k, L → (x : X) → E k x → ℂ)
    (hf : ∀ k l x e, Q x → supportPhase k x e ≠ 0 → f k l x e = g k l x e)
    (ks : List K) (l : L) (x : X) (p : FiniteEventPath E target ks x)
    (hx : Q x) (hp : finiteEventLocalPhase E target supportPhase ks x p ≠ 0) :
    deterministicLedgerPhase E target u f ks l x p =
      deterministicLedgerPhase E target v g ks l x p := by
  induction ks generalizing l x with
  | nil => rfl
  | cons k ks ih =>
    rcases p with ⟨e, p⟩
    change supportPhase k x e * finiteEventLocalPhase E target supportPhase ks (target k x e) p ≠ 0 at hp
    obtain ⟨he, hp⟩ := mul_ne_zero_iff.mp hp
    change f k l x e * deterministicLedgerPhase E target u f ks (u k l x e) (target k x e) p =
      g k l x e * deterministicLedgerPhase E target v g ks (v k l x e) (target k x e) p
    rw [hf k l x e hx he, hu k l x e hx he, ih _ _ _ (hQ k x e hx he) hp]

end Bounty
end

section

/- Parseval turns the total energy terms into exact coefficient sums.
Only the first endpoint needs a major-arc energy estimate. -/

open Finset MeasureTheory
open scoped ComplexConjugate
namespace Bounty

theorem finite_fourier_major_energy
    (S T : Finset ℤ) (f g : ℤ → ℂ) (m : ℝ → ℂ) (hmcont : Continuous m)
    (B : Set ℝ) (hB : MeasurableSet B) {ε : ℝ} (hε : 0 ≤ ε)
    (hm : ∀ x, ‖m x‖ ≤ 1) (hminor : ∀ x, x ∉ B → ‖m x‖ ≤ ε) :
    ‖∫ x in (0 : ℝ)..1, conj (finiteFourierSum S f x)*finiteFourierSum T g x*m x‖ ≤
      Real.sqrt (ε^2*(∑ n ∈ S, ‖f n‖^2) +
        ∫ x in B ∩ Set.Ioc 0 1, ‖finiteFourierSum S f x‖^2) *
      Real.sqrt (∑ n ∈ T, ‖g n‖^2) := by
  have hmem (u : ℝ → ℂ) (hu : Continuous u) :
      MemLp u 2 (volume.restrict (Set.Ioc (0 : ℝ) 1)) := by
    apply (memLp_two_iff_integrable_sq_norm hu.aestronglyMeasurable).mpr
    exact (hu.norm.pow 2).integrableOn_Ioc
  have hf := continuous_finiteFourierSum S f
  have hg := continuous_finiteFourierSum T g
  have hp := multiplier_pairing_major_energy (volume.restrict (Set.Ioc (0 : ℝ) 1))
    (finiteFourierSum S f) (finiteFourierSum T g) m B hB hε hm hminor
    (hmem _ hf) (hmem _ hg) (hmem _ (hmcont.star.mul hf))
  have heF : (∫ x in Set.Ioc (0 : ℝ) 1, ‖finiteFourierSum S f x‖^2) =
      ∑ n ∈ S, ‖f n‖^2 := by
    rw [← intervalIntegral.integral_of_le zero_le_one, finiteFourierSum_energy_one]
  have heG : (∫ x in Set.Ioc (0 : ℝ) 1, ‖finiteFourierSum T g x‖^2) =
      ∑ n ∈ T, ‖g n‖^2 := by
    rw [← intervalIntegral.integral_of_le zero_le_one, finiteFourierSum_energy_one]
  rw [Measure.restrict_restrict hB, heF, heG] at hp
  simpa only [intervalIntegral.integral_of_le zero_le_one] using hp

end Bounty
end

section

/- Major arcs for -k*theta have rational centers and a common width;
their numerators are bounded on the unit interval. -/

namespace Bounty

theorem product_major_arc_geometry {k : ℤ} {L q U V θ : ℝ}
    (hk : k ≠ 0) (hU : 0 < U) (hV : 0 < V) (hscale : L^q ≤ U*V)
    (hθ : θ ∈ Set.Icc (0 : ℝ) 1) (hmajor : θ ∈ productMajorArcSet k L q U V) :
    ∃ (u : ℤ) (r : ℕ), 0 < r ∧ r ≤ ⌊L^q⌋₊ ∧
      |(u : ℝ)| ≤ (r : ℝ)*(|(k : ℝ)|+1) ∧
      |θ - (-(u : ℝ)/((k : ℝ)*r))| ≤ L^q/(|(k : ℝ)| * (U*V)) := by
  obtain ⟨u, r, hr, hrb, hclose⟩ := hmajor
  have hr0 : (0 : ℝ) < r := by exact_mod_cast hr
  have hk0 : (k : ℝ) ≠ 0 := by exact_mod_cast hk
  have hUV := mul_pos hU hV
  have he : |(-k : ℝ)*θ-(u : ℝ)/r| ≤ 1 := by
    apply le_of_mul_le_mul_right _ hUV
    simpa only [one_mul] using hclose.trans hscale
  have hθabs : |θ| ≤ 1 := by rw [abs_of_nonneg hθ.1]; exact hθ.2
  have hn : |(u : ℝ)/r| ≤ |(k : ℝ)|+1 := by
    calc
      _ = |(-k : ℝ)*θ - ((-k : ℝ)*θ-(u : ℝ)/r)| := by congr 1; ring
      _ ≤ |(-k : ℝ)*θ| + |(-k : ℝ)*θ-(u : ℝ)/r| := abs_sub _ _
      _ ≤ |(k : ℝ)| * 1+1 := by
        rw [abs_mul, abs_neg]
        exact add_le_add (mul_le_mul_of_nonneg_left hθabs (abs_nonneg _)) he
      _ = _ := by ring
  refine ⟨u, r, hr, hrb, ?_, ?_⟩
  · rw [abs_div, abs_of_pos hr0] at hn
    have hz := (div_le_iff₀ hr0).mp hn
    nlinarith
  · have heq : (-k : ℝ)*θ-(u : ℝ)/r =
        (-k : ℝ)*(θ - (-(u : ℝ)/((k : ℝ)*r))) := by
      field_simp
      ring
    rw [heq, abs_mul, abs_neg] at hclose
    apply (le_div_iff₀ (mul_pos (abs_pos.mpr hk0) hUV)).mpr
    nlinarith

theorem product_major_arc_finite_cover {k : ℤ} {L q U V θ : ℝ}
    (hk : k ≠ 0) (hU : 0 < U) (hV : 0 < V) (hscale : L^q ≤ U*V)
    (hθ : θ ∈ Set.Icc (0 : ℝ) 1) (hmajor : θ ∈ productMajorArcSet k L q U V) :
    ∃ (r : ℕ) (u : ℤ), r ∈ Finset.Icc 1 ⌊L^q⌋₊ ∧
      u ∈ Finset.Icc (-((⌊L^q⌋₊*(k.natAbs+1) : ℕ) : ℤ))
        ((⌊L^q⌋₊*(k.natAbs+1) : ℕ) : ℤ) ∧
      |θ - (-(u : ℝ)/((k : ℝ)*r))| ≤ L^q/(|(k : ℝ)| * (U*V)) := by
  obtain ⟨u, r, hr, hrb, hu, hclose⟩ := product_major_arc_geometry hk hU hV hscale hθ hmajor
  have hrR : (r : ℝ) ≤ (⌊L^q⌋₊ : ℝ) := by exact_mod_cast hrb
  have hkabs : (k.natAbs : ℝ) = |(k : ℝ)| := by
    calc
      (k.natAbs : ℝ) = ((k.natAbs : ℤ) : ℝ) := by simp only [Int.cast_natCast]
      _ = ((|k| : ℤ) : ℝ) := congrArg (fun z : ℤ => (z : ℝ)) (Int.natCast_natAbs k)
      _ = |(k : ℝ)| := Int.cast_abs
  have huR : |(u : ℝ)| ≤ (⌊L^q⌋₊*(k.natAbs+1) : ℕ) := by
    calc
      _ ≤ (r : ℝ)*(|(k : ℝ)|+1) := hu
      _ ≤ (⌊L^q⌋₊ : ℝ)*(|(k : ℝ)|+1) :=
        mul_le_mul_of_nonneg_right hrR (by positivity)
      _ = _ := by push_cast; rw [hkabs]
  refine ⟨r, u, Finset.mem_Icc.mpr ⟨hr, hrb⟩, Finset.mem_Icc.mpr ⟨?_, ?_⟩, hclose⟩
  · exact_mod_cast (abs_le.mp huR).1
  · apply (Int.cast_le (R := ℝ)).mp
    simpa only [Int.cast_natCast] using (abs_le.mp huR).2

end Bounty
end

section

/- A retained four-dimensional dyadic box has comparable product size
at every point, even beyond the original output-support boundary. -/

open Finset
namespace Bounty

theorem four_dyadic_product_bounds (D A B C : Finset ℕ)
    (hD : ∀ n ∈ D, 0 < n) (hA : ∀ n ∈ A, 0 < n)
    (hB : ∀ n ∈ B, 0 < n) (hC : ∀ n ∈ C, 0 < n)
    {i j k l d a b c : ℕ} (hd : d ∈ dyadicNatBucket D i)
    (ha : a ∈ dyadicNatBucket A j) (hb : b ∈ dyadicNatBucket B k)
    (hc : c ∈ dyadicNatBucket C l) :
    let X := (2 : ℝ)^i * 2^j * 2^k * 2^l
    X ≤ (d*a*b*c : ℕ) ∧ ((d*a*b*c : ℕ) : ℝ) ≤ 16*X := by
  obtain ⟨hdl, hdu⟩ := dyadicNatBucket_bounds D hD hd
  obtain ⟨hal, hau⟩ := dyadicNatBucket_bounds A hA ha
  obtain ⟨hbl, hbu⟩ := dyadicNatBucket_bounds B hB hb
  obtain ⟨hcl, hcu⟩ := dyadicNatBucket_bounds C hC hc
  have hlo : 2^i*2^j*2^k*2^l ≤ d*a*b*c :=
    Nat.mul_le_mul (Nat.mul_le_mul (Nat.mul_le_mul hdl hal) hbl) hcl
  have hhi : d*a*b*c ≤ 16*(2^i*2^j*2^k*2^l) := by
    calc
      _ ≤ 2^(i+1)*2^(j+1)*2^(k+1)*2^(l+1) :=
        Nat.mul_le_mul (Nat.mul_le_mul (Nat.mul_le_mul hdu.le hau.le) hbu.le) hcu.le
      _ = _ := by simp only [pow_succ]; ring
  constructor
  · exact_mod_cast hlo
  · exact_mod_cast hhi

theorem retained_four_dyadic_scale (S D A B C : Finset ℕ)
    (hD : ∀ n ∈ D, 0 < n) (hA : ∀ n ∈ A, 0 < n)
    (hB : ∀ n ∈ B, 0 < n) (hC : ∀ n ∈ C, 0 < n)
    {U V : ℝ} (hS : ∀ n ∈ S, U ≤ (n : ℝ) ∧ (n : ℝ) ≤ V)
    {i j k l : ℕ}
    (hbox : ∃ d ∈ dyadicNatBucket D i, ∃ a ∈ dyadicNatBucket A j,
      ∃ b ∈ dyadicNatBucket B k, ∃ c ∈ dyadicNatBucket C l, d*a*b*c ∈ S) :
    let X := (2 : ℝ)^i * 2^j * 2^k * 2^l
    U/16 ≤ X ∧ X ≤ V := by
  obtain ⟨d,hd,a,ha,b,hb,c,hc,hm⟩ := hbox
  have hp := four_dyadic_product_bounds D A B C hD hA hB hC hd ha hb hc
  have hs := hS _ hm
  dsimp only at hp ⊢
  constructor <;> linarith [hp.1, hp.2, hs.1, hs.2]

theorem retained_four_dyadic_product_bounds (S D A B C : Finset ℕ)
    (hD : ∀ n ∈ D, 0 < n) (hA : ∀ n ∈ A, 0 < n)
    (hB : ∀ n ∈ B, 0 < n) (hC : ∀ n ∈ C, 0 < n)
    {U V : ℝ} (hS : ∀ n ∈ S, U ≤ (n : ℝ) ∧ (n : ℝ) ≤ V)
    {i j k l : ℕ}
    (hbox : ∃ d ∈ dyadicNatBucket D i, ∃ a ∈ dyadicNatBucket A j,
      ∃ b ∈ dyadicNatBucket B k, ∃ c ∈ dyadicNatBucket C l, d*a*b*c ∈ S)
    {d a b c : ℕ} (hd : d ∈ dyadicNatBucket D i) (ha : a ∈ dyadicNatBucket A j)
    (hb : b ∈ dyadicNatBucket B k) (hc : c ∈ dyadicNatBucket C l) :
    U/16 ≤ ((d*a*b*c : ℕ) : ℝ) ∧ ((d*a*b*c : ℕ) : ℝ) ≤ 16*V := by
  have hs := retained_four_dyadic_scale S D A B C hD hA hB hC hS hbox
  have hp := four_dyadic_product_bounds D A B C hD hA hB hC hd ha hb hc
  dsimp only at hs hp
  constructor <;> linarith [hs.1, hs.2, hp.1, hp.2]

end Bounty
end

section

open MeasureTheory

namespace Bounty

theorem weighted_mean_tail_bound (F : ℝ → ℝ) (hF : Continuous F)
    (hF0 : ∀ t, 0 ≤ F t) {L h A B : ℝ} (hL : 1 ≤ L) (hh : 0 < h)
    (hB : 0 ≤ B) (M : ℕ)
    (hwi : Integrable (fun t : ℝ => (1+|h*t|)^(-((M+2:ℕ):ℝ))*F t))
    (hmean : ∀ T : ℝ, 0 < T → (∫ t in Set.Icc (-T) T, F t) ≤ A*T+B) :
    (∫ t in {t : ℝ | L/h < |t|}, (1+|h*t|)^(-((M+2:ℕ):ℝ))*F t) ≤
      (4*A*(L/h)+2*B)*L^(-(M:ℝ)) := by
  let f : ℝ → ℝ := fun t => (1+|h*t|)^(-((M+2:ℕ):ℝ))*F t
  have hLp : 0 < L := lt_of_lt_of_le zero_lt_one hL
  have hR : 0 < L/h := div_pos hLp hh
  have hf0 : ∀ t, 0 ≤ f t := fun t => mul_nonneg (Real.rpow_nonneg (by positivity) _) (hF0 t)
  have hsumm : Summable (fun n : ℕ => ∫ t in dyadicAbsShell (L/h) n, f t) :=
    (hasSum_integral_iUnion (dyadic_abs_shell_measurable (L/h))
      (dyadic_abs_shell_disjoint hR) hwi.integrableOn).summable
  have hgeo : HasSum (fun n : ℕ => (1/2:ℝ)^n) 2 := by
    have hg := hasSum_geometric_of_norm_lt_one (by norm_num : ‖(1/2:ℝ)‖<1)
    norm_num at hg
    exact hg
  have hbound (n : ℕ) : (∫ t in dyadicAbsShell (L/h) n, f t) ≤
      (L^(-(M:ℝ))*(2*A*(L/h)+B))*(1/2:ℝ)^n := by
    let T : ℝ := (2:ℝ)^(n+1)*(L/h)
    have hT : 0 < T := by dsimp [T]; positivity
    have hsub : dyadicAbsShell (L/h) n ⊆ Set.Icc (-T) T := by
      intro t ht
      exact abs_le.1 ht.2.le
    have hFi : IntegrableOn F (Set.Icc (-T) T) := hF.integrableOn_Icc
    have hbase : (∫ t in dyadicAbsShell (L/h) n, f t) ≤
        (L^(-(M:ℝ))*(1/4:ℝ)^n)*(A*T+B) := by
      calc
        _ ≤ ∫ t in dyadicAbsShell (L/h) n, (L^(-(M:ℝ))*(1/4:ℝ)^n)*F t := by
          apply setIntegral_mono_on hwi.integrableOn ((hFi.mono_set hsub).const_mul _)
            (dyadic_abs_shell_measurable (L/h) n)
          intro t ht
          exact mul_le_mul_of_nonneg_right (dyadic_decay_weight_le hL hh n M ht) (hF0 t)
        _ = (L^(-(M:ℝ))*(1/4:ℝ)^n)*(∫ t in dyadicAbsShell (L/h) n, F t) := integral_const_mul _ _
        _ ≤ (L^(-(M:ℝ))*(1/4:ℝ)^n)*(∫ t in Set.Icc (-T) T, F t) := by
          apply mul_le_mul_of_nonneg_left _ (by positivity)
          exact setIntegral_mono_set hFi (Filter.Eventually.of_forall hF0) (Filter.Eventually.of_forall hsub)
        _ ≤ _ := mul_le_mul_of_nonneg_left (hmean T hT) (by positivity)
    have heq : (1/4:ℝ)^n*(2:ℝ)^(n+1) = 2*(1/2:ℝ)^n := by
      rw [pow_succ]
      calc
        _ = ((1/4:ℝ)*2)^n*2 := by rw [mul_pow]; ring
        _ = _ := by norm_num; ring
    have hquarter : (1/4:ℝ)^n ≤ (1/2:ℝ)^n := pow_le_pow_left₀ (by norm_num) (by norm_num) n
    calc
      _ ≤ (L^(-(M:ℝ))*(1/4:ℝ)^n)*(A*T+B) := hbase
      _ = L^(-(M:ℝ))*(2*A*(L/h)*(1/2:ℝ)^n+B*(1/4:ℝ)^n) := by
        dsimp [T]
        calc
          _ = L^(-(M:ℝ))*(A*(L/h)*((1/4:ℝ)^n*2^(n+1))+B*(1/4:ℝ)^n) := by ring
          _ = _ := by rw [heq]; ring
      _ ≤ L^(-(M:ℝ))*(2*A*(L/h)*(1/2:ℝ)^n+B*(1/2:ℝ)^n) := by
        gcongr
      _ = _ := by ring
  calc
    _ ≤ ∫ t in {t : ℝ | L/h ≤ |t|}, f t := by
      exact setIntegral_mono_set hwi.integrableOn (Filter.Eventually.of_forall hf0)
        (Filter.Eventually.of_forall (fun t (ht : L/h < |t|) => ht.le))
    _ = ∑' n : ℕ, ∫ t in dyadicAbsShell (L/h) n, f t := integral_dyadic_abs_shells hR hwi
    _ ≤ ∑' n : ℕ, (L^(-(M:ℝ))*(2*A*(L/h)+B))*(1/2:ℝ)^n :=
      hsumm.tsum_le_tsum hbound (hgeo.summable.mul_left _)
    _ = _ := by rw [tsum_mul_left, hgeo.tsum_eq]; ring

end Bounty
end

section

/- A single rational major region contains all active product dyad regions. -/

open MeasureTheory
namespace Bounty

theorem product_major_arc_cell_subset {L q U V HA HB : ℝ}
    (hL : 4 ≤ L) (hscale : HA*HB ≤ 4*(U*V)) (k : ℤ) :
    productMajorArcSet k L q U V ⊆ productMajorArcSet k L (q+1) HA HB := by
  intro θ hθ
  obtain ⟨u,r,hr,hrq,hθ⟩ := hθ
  have hL0 : 0 < L := by linarith
  have hpow : L^q ≤ L^(q+1) :=
    Real.rpow_le_rpow_of_exponent_le (by linarith) (by linarith)
  refine ⟨u,r,hr,hrq.trans (Nat.floor_mono hpow), ?_⟩
  calc
    _ ≤ |(-k : ℝ)*θ-(u : ℝ)/r| * (4*(U*V)) :=
      mul_le_mul_of_nonneg_left hscale (abs_nonneg _)
    _ = 4*(|(-k : ℝ)*θ-(u : ℝ)/r| *(U*V)) := by ring
    _ ≤ 4*L^q := mul_le_mul_of_nonneg_left hθ (by norm_num)
    _ ≤ L*L^q := mul_le_mul_of_nonneg_right hL (Real.rpow_nonneg hL0.le q)
    _ = L^(q+1) := by rw [Real.rpow_add hL0, Real.rpow_one]; ring

end Bounty
end

section

/- Integration of translated averages with almost-everywhere shifted energy bounds. -/

open MeasureTheory

namespace Bounty

theorem integrated_translate_average_square_ae
    (μ ν : Measure ℝ) [IsFiniteMeasure μ] [SFinite ν]
    {κ P : ℝ → ℂ} {M B : ℝ} (c : ℝ)
    (hκc : Continuous κ) (hκi : Integrable κ ν)
    (hP : Continuous P) (hM : 0 ≤ M) (hPM : ∀ s, ‖P s‖ ≤ M)
    (hB : ∀ᵐ u ∂ν, (∫ s, ‖P (s+c*u)‖^2 ∂μ) ≤ B) :
    Integrable (fun s => ‖∫ u, κ u * P (s+c*u) ∂ν‖^2) μ ∧
    (∫ s, ‖∫ u, κ u * P (s+c*u) ∂ν‖^2 ∂μ) ≤
      (∫ u, ‖κ u‖ ∂ν)^2 * B := by
  let A := ∫ u, ‖κ u‖ ∂ν
  have hA : 0 ≤ A := integral_nonneg (fun u => norm_nonneg _)
  have hc : Continuous (fun p : ℝ × ℝ => κ p.2 * P (p.1+c*p.2)) := by fun_prop
  have hm : StronglyMeasurable (fun s => ∫ u, κ u * P (s+c*u) ∂ν) :=
    hc.stronglyMeasurable.integral_prod_right'
  have hEb (s : ℝ) : ‖∫ u, κ u * P (s+c*u) ∂ν‖ ≤ A*M := by
    change _ ≤ (∫ u, ‖κ u‖ ∂ν)*M
    rw [← integral_mul_const]
    apply norm_integral_le_of_norm_le (hκi.norm.mul_const M)
    filter_upwards [] with u
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (hPM _) (norm_nonneg _)
  have hEi : Integrable (fun s => ‖∫ u, κ u * P (s+c*u) ∂ν‖^2) μ := by
    apply (integrable_const ((A*M)^2)).mono' (hm.norm.pow 2).aestronglyMeasurable
    filter_upwards [] with s
    change ‖‖∫ u, κ u * P (s+c*u) ∂ν‖^2‖ ≤ (A*M)^2
    rw [Real.norm_of_nonneg (sq_nonneg _)]
    exact pow_le_pow_left₀ (norm_nonneg _) (hEb s) 2
  have hQc : Continuous (fun p : ℝ × ℝ => ‖κ p.2‖ * ‖P (p.1+c*p.2)‖^2) := by fun_prop
  have hQi : Integrable (fun p : ℝ × ℝ => ‖κ p.2‖ * ‖P (p.1+c*p.2)‖^2)
      (μ.prod ν) := by
    apply ((hκi.norm.mul_const (M^2)).comp_snd μ).mono' hQc.aestronglyMeasurable
    filter_upwards [] with p
    rw [Real.norm_of_nonneg (mul_nonneg (norm_nonneg _) (sq_nonneg _))]
    exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) (hPM _) 2) (norm_nonneg _)
  have hpoint (s : ℝ) : ‖∫ u, κ u * P (s+c*u) ∂ν‖^2 ≤
      A * ∫ u, ‖κ u‖ * ‖P (s+c*u)‖^2 ∂ν :=
    (bounded_weighted_integral_square hκi (by fun_prop) hM (fun u => hPM _)).2
  refine ⟨hEi, ?_⟩
  calc
    _ ≤ ∫ s, A * (∫ u, ‖κ u‖ * ‖P (s+c*u)‖^2 ∂ν) ∂μ :=
      integral_mono hEi (hQi.integral_prod_left.const_mul A) hpoint
    _ = A * ∫ u, (∫ s, ‖κ u‖ * ‖P (s+c*u)‖^2 ∂μ) ∂ν := by
      rw [integral_const_mul, integral_integral_swap hQi]
    _ ≤ A * ∫ u, ‖κ u‖ * B ∂ν := by
      apply mul_le_mul_of_nonneg_left _ hA
      apply integral_mono_ae hQi.integral_prod_right (hκi.norm.mul_const B)
      filter_upwards [hB] with u hu
      change (∫ s, ‖κ u‖ * ‖P (s+c*u)‖^2 ∂μ) ≤ ‖κ u‖ * B
      rw [integral_const_mul]
      exact mul_le_mul_of_nonneg_left hu (norm_nonneg _)
    _ = _ := by rw [integral_mul_const]; dsimp [A]; ring

end Bounty
end

section

/- The actual Q-zero prime character factor, with the product window retained. -/

open Finset Filter

namespace Bounty

theorem candidate_Q_zero_character_window_split (c L : ℝ) (r jStar : ℕ)
    (hr : 0 < r) (hj : 0 < jStar) (S : Finset ℕ) {d : ℕ}
    (χ : DirichletCharacter ℂ d) (h : ℕ) (G : ℕ → ℂ) :
    (∑ n ∈ S.filter (fun n => n.Coprime h),
      (candidateQWeight c L r jStar n : ℂ) * χ (n : ZMod d) * G n) =
      (1 / (((r.factorial : ℝ)^(candidateQIndices c L).card) : ℂ)) *
        ∑ y : ∀ slot, candidateQRestChoices c L r jStar hr slot,
          if (orderedSlotProduct (candidateQRestChoices c L r jStar hr) y).Coprime h then
            χ (orderedSlotProduct (candidateQRestChoices c L r jStar hr) y : ZMod d) *
              ∑ p ∈ ((candidateQBand (c*L) 0).filter (fun p =>
                p * orderedSlotProduct (candidateQRestChoices c L r jStar hr) y ∈ S)).filter
                  (fun p => p.Coprime h),
                χ (p : ZMod d) * G (p * orderedSlotProduct (candidateQRestChoices c L r jStar hr) y)
          else 0 := by
  classical
  rw [show (∑ n ∈ S.filter (fun n => n.Coprime h),
      (candidateQWeight c L r jStar n : ℂ) * χ (n : ZMod d) * G n) =
      ∑ n ∈ S.filter (fun n => n.Coprime h),
        (candidateQWeight c L r jStar n : ℂ) * (χ (n : ZMod d) * G n) by
      apply sum_congr rfl; intro n _; ring]
  rw [candidate_Q_zero_complex_window_split c L r jStar hr hj]
  rw [sum_comm, mul_sum]
  apply sum_congr rfl
  intro y _
  by_cases hR : (orderedSlotProduct (candidateQRestChoices c L r jStar hr) y).Coprime h
  · rw [if_pos hR]
    simp only [sum_filter, mul_sum]
    apply sum_congr rfl
    intro p _
    by_cases hp : p.Coprime h
    · by_cases hS : p * orderedSlotProduct (candidateQRestChoices c L r jStar hr) y ∈ S
      · have hm : p * orderedSlotProduct (candidateQRestChoices c L r jStar hr) y ∈
            S.filter (fun n => n.Coprime h) :=
          mem_filter.mpr ⟨hS, Nat.coprime_mul_iff_left.mpr ⟨hp, hR⟩⟩
        rw [if_pos hm, if_pos hp, if_pos hS]
        simp only [Nat.cast_mul, map_mul]
        ring
      · have hm : p * orderedSlotProduct (candidateQRestChoices c L r jStar hr) y ∉
            S.filter (fun n => n.Coprime h) := fun hm => hS (mem_filter.mp hm).1
        rw [if_neg hm, if_neg hS]
        simp
    · have hm : p * orderedSlotProduct (candidateQRestChoices c L r jStar hr) y ∉
          S.filter (fun n => n.Coprime h) := fun hm =>
        hp (Nat.coprime_mul_iff_left.mp (mem_filter.mp hm).2).1
      rw [if_neg hm, if_neg hp]
      simp
  · rw [if_neg hR, mul_zero]
    apply sum_eq_zero
    intro p _
    have hm : p * orderedSlotProduct (candidateQRestChoices c L r jStar hr) y ∉
          S.filter (fun n => n.Coprime h) := fun hm =>
        hR (Nat.coprime_mul_iff_left.mp (mem_filter.mp hm).2).2
    exact if_neg hm

end Bounty

end

section

/- Signed asymmetric comparison bounds for the actual averaged, coupled group tests. -/

namespace Bounty

open Finset
open scoped Classical

noncomputable def finiteGroupedTailTest {G : Type*} [Fintype G] [DecidableEq G]
    {I X : G → Type*} [∀ g, DecidableEq (I g)] [∀ g, Fintype (X g)]
    (μ : ∀ g, X g → ℝ) (tails : ∀ g, Finset (I g))
    (f : (∀ g, I g → X g) → ℂ) : (∀ a : Sigma I, X a.1) → ℂ :=
  finiteCoordinateComponent (fun a : Sigma I => μ a.1) ∅ (univ.sigma tails).toList
    (finiteGroupFlattenFunction f)

theorem finite_asymmetric_grouped_block_bound {G : Type*} [Fintype G] [DecidableEq G]
    {I X : G → Type*} [∀ g, Fintype (I g)] [∀ g, DecidableEq (I g)] [∀ g, Fintype (X g)]
    (μ : ∀ g, X g → ℝ) (hμ : ∀ g x, 0 ≤ μ g x) (hmass : ∀ g, ∑ x, μ g x = 1)
    (hμnz : ∀ g x, μ g x ≠ 0)
    (probes tails : ∀ g, Finset (I g)) (hpt : ∀ g, Disjoint (probes g) (tails g))
    (m ell : ℕ) (hm : 0 < m) (hp : ∀ g, (probes g).card = m) (ht : ∀ g, (tails g).card = ell)
    (s t : Finset G) (hst : Disjoint s t) (active : Finset (Sigma I))
    (k : (∀ a : Sigma I, X a.1) → ℂ) (hk : ∀ x, ‖k x‖ ≤ 1)
    (F : ∀ A B : Finset (Sigma I), (∀ i : ↥(active \ (A ∪ B)), X i.val.1) →
      (∀ i : A, X i.val.1) → (∀ i : B, X i.val.1) → ℂ)
    (f g : (∀ g, I g → X g) → ℂ)
    (hf : ∀ a, finiteGroupSlotSymmetric a f) (hg : ∀ a, finiteGroupSlotSymmetric a g)
    (ε : ℝ) (hε : 0 ≤ ε)
    (herr : ∀ S ∈ (s.sigma probes).powerset, ∀ T ∈ (t.sigma probes).powerset,
      ∀ A ∈ cleanNonemptySubsets (s.sigma probes \ S),
      ∀ B ∈ cleanNonemptySubsets (t.sigma probes \ T),
        ‖cleanKernelPairing (finiteProductWeight (fun a : Sigma I => μ a.1))
            (finiteAsymmetricComparisonKernel (fun a : Sigma I => μ a.1) active F A B)
            (finiteCoordinateComponent (fun a : Sigma I => μ a.1) S (s.sigma probes).toList
              (finiteGroupedTailTest μ tails f))
            (finiteCoordinateComponent (fun a : Sigma I => μ a.1) T (t.sigma probes).toList
              (finiteGroupedTailTest μ tails g)) -
          cleanRawPairing (finiteProductWeight (fun a : Sigma I => μ a.1)) k
            (finiteCoordinateComponent (fun a : Sigma I => μ a.1) S (s.sigma probes).toList
              (finiteGroupedTailTest μ tails f))
            (finiteCoordinateComponent (fun a : Sigma I => μ a.1) T (t.sigma probes).toList
              (finiteGroupedTailTest μ tails g))‖ ≤
        ε * Real.sqrt (finiteWeightedEnergy (finiteProductWeight (fun a : Sigma I => μ a.1))
          (finiteCoordinateComponent (fun a : Sigma I => μ a.1) S (s.sigma probes).toList
            (finiteGroupedTailTest μ tails f))) *
          Real.sqrt (finiteWeightedEnergy (finiteProductWeight (fun a : Sigma I => μ a.1))
            (finiteCoordinateComponent (fun a : Sigma I => μ a.1) T (t.sigma probes).toList
              (finiteGroupedTailTest μ tails g)))) :
    ‖cleanRawPairing (finiteProductWeight (fun a : Sigma I => μ a.1)) k
        (finiteGroupedTailTest μ tails f) (finiteGroupedTailTest μ tails g) -
      ∑ A ∈ cleanNonemptySubsets (s.sigma probes), ∑ B ∈ cleanNonemptySubsets (t.sigma probes),
        (-1 : ℂ) ^ (A.card + B.card) *
          cleanKernelPairing (finiteProductWeight (fun a : Sigma I => μ a.1))
            (finiteAsymmetricComparisonKernel (fun a : Sigma I => μ a.1) active F A B)
            (finiteGroupedTailTest μ tails f) (finiteGroupedTailTest μ tails g)‖ ≤
      (Real.sqrt (((ell : ℝ) ^ ell / (m : ℝ) ^ ell) ^ s.card) +
        Real.sqrt (((ell : ℝ) ^ ell / (m : ℝ) ^ ell) ^ t.card) +
        (3 : ℝ) ^ ((s.sigma probes).card + (t.sigma probes).card) * ε) *
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight
          (fun g => finiteProductWeight (fun _ : I g => μ g))) f) *
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight
          (fun g => finiteProductWeight (fun _ : I g => μ g))) g) := by
  have hUV : Disjoint (s.sigma probes) (t.sigma probes) := by
    apply disjoint_left.mpr
    intro a ha hb
    exact disjoint_left.mp hst (mem_sigma.mp ha).1 (mem_sigma.mp hb).1
  exact finite_asymmetric_signed_block_envelope (fun a : Sigma I => μ a.1)
    (fun a x => hμ a.1 x) (fun a => hmass a.1) active (s.sigma probes) (t.sigma probes)
    hUV (fun a x => hμnz a.1 x) k hk F (finiteGroupedTailTest μ tails f)
    (finiteGroupedTailTest μ tails g) _ _ _ _
    (finite_flatten_tail_norm_le μ hμ hmass tails f)
    (finite_flatten_tail_norm_le μ hμ hmass tails g)
    (finite_flatten_probe_tail_norm μ hμ hmass probes tails hpt m ell hm hp ht s f hf)
    (finite_flatten_probe_tail_norm μ hμ hmass probes tails hpt m ell hm hp ht t g hg)
    ε hε herr

end Bounty
end

section

/- The physical edge with every target list and auxiliary draw is one
unified full-state row. Its globally extended phase is bounded everywhere. -/

open Finset
open scoped Classical
namespace Bounty

section Physical
variable {I K : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g, ∀ p : ↥(P g), NeZero p.val]
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (retention : I → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

noncomputable def physicalFullLedgerRow : Option (I ⊕ K) →
    (FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ) →
    FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ :=
  fullMixedLedgerRow (fun g (p : ↥(P g)) => p.val)
    (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
    (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j))
    (fun j H x e => physicalFullGlobalEdgePhase (C j) (k j) H (ω j)
      (fun g p => β g p / V g) ρ V x e) ω (fun g p => β g p / V g) retention ρ V

theorem physical_full_global_edge_row (j : K)
    (L : PhysicalMarkLists P J ell) (H : (g : Fin N) → Finset ↥(P g))
    (q : (g : Fin N) → BoundedOrderedTuple
      (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (F : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ) :
    physicalFullLedgerRow C k ω β retention ρ V (some (.inr j)) F
      (H, physicalFullMemoryState (C j) L q) =
    ∑ R : PhysicalMarkLists P J ell, ∑ aux : PhysicalAuxLabels P (C j),
      (ω j (productActiveMemorySplit (fun g => physicalFullSharedIndices (C j g)) B
        (physicalFullMemoryState (C j) L q)).1 aux : ℂ) *
      if physicalListAdmissible (C j) aux L R then
        jointRawTensorCutoff B (physicalFullEdgeRawRow (B := B) (C j) (k j) L R β ρ V aux)
          (physicalFullContinuation (C j) R F)
          (fun g => (H g, boundedOrderedTupleToFinite (q g))) else 0 := by
  symm
  refine (physical_full_all_endpoints_edge_continuation (C j) (k j) L H q hP hdis β ρ V (ω j) F).trans ?_
  unfold physicalFullLedgerRow fullMixedLedgerRow finiteLocalPhasedRow
  apply sum_congr
  · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
  · intro e _
    change _ = _ * physicalFullGlobalEdgePhase (C j) (k j) H (ω j)
      (fun g p => β g p / V g) ρ V (physicalFullMemoryState (C j) L q) e * _
    rw [physical_full_global_edge_phase_encode]
    rfl

theorem physical_full_global_permutation_row
    (F : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ)
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B) :
    physicalFullLedgerRow C k ω β retention ρ V none F s =
      fullActiveAverage (fun x => F (s.1, x)) s.2 :=
  full_mixed_ledger_row_permutation _ _ _ _ _ _ _ _ _ _ _ _ F s

end Physical
end Bounty
end

section

/- The full active edge has the same auxiliary draw and ordered event
choices at both memory caps. Its exact weighted transport keeps arbitrary
event-dependent tests and both total-memory restrictions. -/

open Finset Classical

namespace Bounty

section

variable {G : Type*} {P : G → Type*} (n : ∀ g, P g → ℕ) {M : G → ℕ}
  (S : ∀ g, Finset (Fin (M g)))
  (A : SharedActiveLabels P S → Type*) (Δ D : ∀ c, A c → G → ℤ)
  {b B : ℕ} (h : b ≤ B)
  (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b)

def fullActiveEdgeEventCapEquiv : FullActiveEdgeEvent n S b A Δ D s ≃
    FullActiveEdgeEvent n S B A Δ D (productStateCapEmbed h s) := Equiv.refl _

theorem fullActiveEdgeEventCapEquiv_apply (e : FullActiveEdgeEvent n S b A Δ D s) :
    fullActiveEdgeEventCapEquiv n S A Δ D h s e = e := rfl

theorem fullActiveEdgeEventTarget_cap_of_weight_ne_zero [Fintype G]
    (ω : ∀ c, A c → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (e : FullActiveEdgeEvent n S b A Δ D s)
    (hw : fullActiveEdgeEventWeight n S b A Δ D ω μ ρ V s e ≠ 0) :
    productStateCapEmbed h (fullActiveEdgeEventTarget n S b A Δ D s e) =
      fullActiveEdgeEventTarget n S B A Δ D (productStateCapEmbed h s)
        (fullActiveEdgeEventCapEquiv n S A Δ D h s e) := by
  unfold fullActiveEdgeEventWeight at hw
  have he := unrestrictedJointEventTarget_cap_of_weight_ne_zero n
    (Δ (productActiveMemorySplit S b s).1 e.1) (D (productActiveMemorySplit S b s).1 e.1)
    μ ρ V (fun g => (S g)ᶜ.card) h (productActiveMemorySplit S b s).2 e.2
    (mul_ne_zero_iff.mp hw).2
  exact congrArg (fun y => (productActiveMemorySplit S B).symm
    ((productActiveMemorySplit S b s).1, y)) he

theorem fullActiveEdgeEventWeight_cap [Fintype G]
    (ω : ∀ c, A c → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (hs : productTotalMemory s ≤ b) (e : FullActiveEdgeEvent n S b A Δ D s) :
    fullActiveEdgeEventWeight n S b A Δ D ω μ ρ V s e =
      if productTotalMemory (fullActiveEdgeEventTarget n S B A Δ D (productStateCapEmbed h s)
          (fullActiveEdgeEventCapEquiv n S A Δ D h s e)) ≤ b
      then fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V (productStateCapEmbed h s)
        (fullActiveEdgeEventCapEquiv n S A Δ D h s e)
      else 0 := by
  have hs' : productTotalMemory (productActiveMemorySplit S b s).2 ≤ b := by
    rwa [productActiveMemorySplit_total_memory]
  have hw := unrestrictedJointCutoffEventWeight_cap n
    (Δ (productActiveMemorySplit S b s).1 e.1) (D (productActiveMemorySplit S b s).1 e.1)
    μ ρ V (fun g => (S g)ᶜ.card) h (productActiveMemorySplit S b s).2 hs' e.2
  have hm := congrArg (fun z : ℝ => ω (productActiveMemorySplit S b s).1 e.1 * z) hw
  rw [fullActiveEdgeEventTarget_total]
  simp only [mul_ite, mul_zero] at hm
  exact hm

theorem fullActiveEdgeEvent_cap_term [Fintype G]
    (ω : ∀ c, A c → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (hs : productTotalMemory s ≤ b)
    (F : FullActiveEdgeEvent n S B A Δ D (productStateCapEmbed h s) →
      ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (e : FullActiveEdgeEvent n S b A Δ D s) :
    (fullActiveEdgeEventWeight n S b A Δ D ω μ ρ V s e : ℂ) *
      F (fullActiveEdgeEventCapEquiv n S A Δ D h s e)
        (productStateCapEmbed h (fullActiveEdgeEventTarget n S b A Δ D s e)) =
      if productTotalMemory (fullActiveEdgeEventTarget n S B A Δ D (productStateCapEmbed h s)
          (fullActiveEdgeEventCapEquiv n S A Δ D h s e)) ≤ b
      then (fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V (productStateCapEmbed h s)
          (fullActiveEdgeEventCapEquiv n S A Δ D h s e) : ℂ) *
        F (fullActiveEdgeEventCapEquiv n S A Δ D h s e)
          (fullActiveEdgeEventTarget n S B A Δ D (productStateCapEmbed h s)
            (fullActiveEdgeEventCapEquiv n S A Δ D h s e))
      else 0 := by
  have hw := fullActiveEdgeEventWeight_cap n S A Δ D h s ω μ ρ V hs e
  by_cases hz : fullActiveEdgeEventWeight n S b A Δ D ω μ ρ V s e = 0
  · rw [hz] at hw
    simp only [hz, Complex.ofReal_zero, zero_mul]
    split_ifs at hw ⊢ with hc
    · rw [← hw]
      simp only [Complex.ofReal_zero, zero_mul]
    · rfl
  · rw [fullActiveEdgeEventTarget_cap_of_weight_ne_zero n S A Δ D h s ω μ ρ V e hz, hw]
    split_ifs <;> simp only [Complex.ofReal_zero, zero_mul]

theorem fullActiveEdgeEvent_cap_sum [Fintype G] [∀ g, Fintype (P g)]
    [∀ g p, NeZero (n g p)] [∀ c, Fintype (A c)]
    (ω : ∀ c, A c → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (hs : productTotalMemory s ≤ b)
    (F : FullActiveEdgeEvent n S B A Δ D (productStateCapEmbed h s) →
      ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ) :
    (∑ e : FullActiveEdgeEvent n S b A Δ D s,
      (fullActiveEdgeEventWeight n S b A Δ D ω μ ρ V s e : ℂ) *
        F (fullActiveEdgeEventCapEquiv n S A Δ D h s e)
          (productStateCapEmbed h (fullActiveEdgeEventTarget n S b A Δ D s e))) =
      ∑ e : FullActiveEdgeEvent n S B A Δ D (productStateCapEmbed h s),
        if productTotalMemory (fullActiveEdgeEventTarget n S B A Δ D (productStateCapEmbed h s) e) ≤ b
        then (fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V (productStateCapEmbed h s) e : ℂ) *
          F e (fullActiveEdgeEventTarget n S B A Δ D (productStateCapEmbed h s) e)
        else 0 := by
  simp_rw [fullActiveEdgeEvent_cap_term n S A Δ D h s ω μ ρ V hs]
  rfl

end

end Bounty
end

section

/- Exact phased path transport from nonzero source events to selected target
 events, requiring the event bijections only on a preserved source invariant. -/

open Finset Classical

namespace Bounty

universe uK uX uY uE uF

noncomputable def finiteSupportedPathPhase {K : Type uK} {X : Type uX} {Y : Type uY}
    (E : K → X → Type uE) (F : K → Y → Type uF)
    (t : ∀ k x, E k x → X) (u : ∀ k y, F k y → Y)
    (w : ∀ k x, E k x → ℝ) (Q : ∀ k y, F k y → Prop)
    (e : X → Y) (P : X → Prop)
    (closed : ∀ k x, P x → ∀ a : FiniteNonzeroEvent E w k x, P (t k x a.val))
    (δ : ∀ k x, P x → FiniteNonzeroEvent E w k x ≃ FiniteSelectedEvent F Q k (e x))
    (ht : ∀ k x (hx : P x) a, e (t k x a.val) = u k (e x) (δ k x hx a).val)
    (ks : List K) (phase : ∀ y, FiniteEventPath F u ks y → ℂ)
    (x : X) (p : FiniteEventPath E t ks x) : ℂ :=
  if hx : P x then if hp : finiteEventPathWeight E t w ks x p ≠ 0 then
    phase (e x) (finiteSelectedPathForget F u Q ks (e x)
      (finiteInvariantPathEquiv (FiniteNonzeroEvent E w) (FiniteSelectedEvent F Q)
        (finiteNonzeroTarget E t w) (finiteSelectedTarget F u Q) e P closed δ ht ks x hx
        (finiteNonzeroPathLift E t w ks x p hp)))
  else 0 else 0

theorem finite_supported_path_phase_norm_le {K : Type uK} {X : Type uX} {Y : Type uY}
    (E : K → X → Type uE) (F : K → Y → Type uF)
    (t : ∀ k x, E k x → X) (u : ∀ k y, F k y → Y)
    (w : ∀ k x, E k x → ℝ) (Q : ∀ k y, F k y → Prop)
    (e : X → Y) (P : X → Prop)
    (closed : ∀ k x, P x → ∀ a : FiniteNonzeroEvent E w k x, P (t k x a.val))
    (δ : ∀ k x, P x → FiniteNonzeroEvent E w k x ≃ FiniteSelectedEvent F Q k (e x))
    (ht : ∀ k x (hx : P x) a, e (t k x a.val) = u k (e x) (δ k x hx a).val)
    (ks : List K) (phase : ∀ y, FiniteEventPath F u ks y → ℂ)
    (hphase : ∀ y p, ‖phase y p‖ ≤ 1) (x : X) (p : FiniteEventPath E t ks x) :
    ‖finiteSupportedPathPhase E F t u w Q e P closed δ ht ks phase x p‖ ≤ 1 := by
  unfold finiteSupportedPathPhase
  split_ifs
  · exact hphase _ _
  all_goals simp

theorem finite_supported_path_action_transport {K : Type uK} {X : Type uX} {Y : Type uY}
    (E : K → X → Type uE) (F : K → Y → Type uF)
    [∀ k x, Fintype (E k x)] [∀ k y, Fintype (F k y)]
    (t : ∀ k x, E k x → X) (u : ∀ k y, F k y → Y)
    (w : ∀ k x, E k x → ℝ) (v : ∀ k y, F k y → ℝ)
    (Q : ∀ k y, F k y → Prop) (e : X → Y) (P : X → Prop)
    (closed : ∀ k x, P x → ∀ a : FiniteNonzeroEvent E w k x, P (t k x a.val))
    (δ : ∀ k x, P x → FiniteNonzeroEvent E w k x ≃ FiniteSelectedEvent F Q k (e x))
    (ht : ∀ k x (hx : P x) a, e (t k x a.val) = u k (e x) (δ k x hx a).val)
    (hw : ∀ k x (hx : P x) a, v k (e x) (δ k x hx a).val = w k x a.val)
    (ks : List K) (phase : ∀ y, FiniteEventPath F u ks y → ℂ)
    (f : Y → ℂ) (x : X) (hx : P x) :
    finiteEventPathAction E t w ks
        (finiteSupportedPathPhase E F t u w Q e P closed δ ht ks phase) (fun x => f (e x)) x =
      finiteEventPathAction F u v ks
        (fun y p => if FiniteEventPathSelected F u Q ks y p then phase y p else 0) f (e x) := by
  let _ : ∀ k x, Fintype (FiniteNonzeroEvent E w k x) := finiteNonzeroEventFintype E w
  let _ : ∀ k y, Fintype (FiniteSelectedEvent F Q k y) := finiteSelectedEventFintype F Q
  rw [finite_event_path_action_nonzero, finite_event_path_action_selected]
  have h := finite_invariant_path_action_equiv (FiniteNonzeroEvent E w) (FiniteSelectedEvent F Q)
    (finiteNonzeroTarget E t w) (finiteSelectedTarget F u Q) e P closed δ ht
    (fun k x a => w k x a.val) (fun k y a => v k y a.val) hw ks
    (fun y p => phase y (finiteSelectedPathForget F u Q ks y p)) f x hx
  convert h using 1
  unfold finiteEventPathAction
  apply Finset.sum_congr rfl
  intro p _
  simp only [finiteSupportedPathPhase, dif_pos hx,
    dif_pos (finite_nonzero_path_weight_ne_zero E t w ks x p), finite_nonzero_path_lift_forget]

end Bounty
end

section

/- An exact local-event representation of a path-maximum mask. Selecting
nonzero event weights removes only zero summands, so arbitrary signed real
weights and arbitrary complex phases are allowed. The initial state is
assumed to satisfy the same height bound as subsequent states. -/

open Finset Classical

namespace Bounty

universe uK uX uE

def finiteSafeEventPredicate {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X)
    (w : ∀ k x, E k x → ℝ) (height : X → ℕ) (b : ℕ)
    (k : K) (x : X) (a : E k x) : Prop :=
  w k x a ≠ 0 ∧ height (t k x a) ≤ b

theorem finite_event_path_initial_le_maximum {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X) (height : X → ℕ)
    (ks : List K) (x : X) (p : FiniteEventPath E t ks x) :
    height x ≤ finiteEventPathMaximum E t height ks x p := by
  cases ks with
  | nil => exact le_rfl
  | cons k ks =>
    rcases p with ⟨a, p⟩
    exact le_max_left _ _

theorem finite_safe_path_selected_iff {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X)
    (w : ∀ k x, E k x → ℝ) (height : X → ℕ) (b : ℕ)
    (ks : List K) (x : X) (hx : height x ≤ b) (p : FiniteEventPath E t ks x) :
    FiniteEventPathSelected E t (finiteSafeEventPredicate E t w height b) ks x p ↔
      finiteEventPathWeight E t w ks x p ≠ 0 ∧
        finiteEventPathMaximum E t height ks x p ≤ b := by
  induction ks generalizing x with
  | nil => simp only [FiniteEventPathSelected, finiteEventPathWeight, finiteEventPathMaximum,
      ne_eq, one_ne_zero, not_false_eq_true, true_and, hx]
  | cons k ks ih =>
    rcases p with ⟨a, p⟩
    change ((w k x a ≠ 0 ∧ height (t k x a) ≤ b) ∧
      FiniteEventPathSelected E t (finiteSafeEventPredicate E t w height b) ks (t k x a) p) ↔
      w k x a * finiteEventPathWeight E t w ks (t k x a) p ≠ 0 ∧
        max (height x) (finiteEventPathMaximum E t height ks (t k x a) p) ≤ b
    constructor
    · rintro ⟨⟨ha, hy⟩, hp⟩
      obtain ⟨hw, hm⟩ := (ih (t k x a) hy p).mp hp
      exact ⟨mul_ne_zero ha hw, max_le hx hm⟩
    · rintro ⟨hw, hm⟩
      have htail := (max_le_iff.mp hm).2
      have hy := (finite_event_path_initial_le_maximum E t height ks (t k x a) p).trans htail
      exact ⟨⟨(mul_ne_zero_iff.mp hw).1, hy⟩,
        (ih (t k x a) hy p).mpr ⟨(mul_ne_zero_iff.mp hw).2, htail⟩⟩

/-- Masking by the full path maximum is exactly the action over events
whose weight is nonzero and whose target height remains at most b. -/
theorem finite_event_path_action_safe {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) [∀ k x, Fintype (E k x)]
    (t : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (height : X → ℕ) (b : ℕ) (ks : List K)
    (phase : ∀ x, FiniteEventPath E t ks x → ℂ) (f : X → ℂ)
    (x : X) (hx : height x ≤ b) :
    let Q := finiteSafeEventPredicate E t w height b
    let _ : ∀ k x, Fintype (FiniteSelectedEvent E Q k x) := finiteSelectedEventFintype E Q
    finiteEventPathAction E t w ks
        (fun x p => if finiteEventPathMaximum E t height ks x p ≤ b then phase x p else 0) f x =
      finiteEventPathAction (FiniteSelectedEvent E Q) (finiteSelectedTarget E t Q)
        (fun k x a => w k x a.val) ks
        (fun x p => phase x (finiteSelectedPathForget E t Q ks x p)) f x := by
  let Q := finiteSafeEventPredicate E t w height b
  let _ : ∀ k x, Fintype (FiniteSelectedEvent E Q k x) := finiteSelectedEventFintype E Q
  refine Eq.trans ?_ (finite_event_path_action_selected E t Q w ks phase f x)
  unfold finiteEventPathAction
  apply sum_congr rfl
  intro p _
  change (finiteEventPathWeight E t w ks x p : ℂ) *
      (if finiteEventPathMaximum E t height ks x p ≤ b then phase x p else 0) *
        f (finiteEventPathTerminal E t ks x p) =
    (finiteEventPathWeight E t w ks x p : ℂ) *
      (if FiniteEventPathSelected E t (finiteSafeEventPredicate E t w height b) ks x p
        then phase x p else 0) * f (finiteEventPathTerminal E t ks x p)
  rw [finite_safe_path_selected_iff E t w height b ks x hx p]
  by_cases hw : finiteEventPathWeight E t w ks x p = 0
  · simp only [hw, Complex.ofReal_zero, zero_mul]
  · simp only [hw, ne_eq, not_false_eq_true, true_and]

end Bounty
end

section

/- The primitive bilinear large sieve with an arbitrary finite dyadic prefix cutoff. -/

open Finset

namespace Bounty

theorem sum_nat_image_intCast {E : Type*} [AddCommMonoid E]
    (S : Finset ℕ) (f : ℤ → E) :
    (∑ z ∈ S.image (fun n : ℕ => (n : ℤ)), f z) = ∑ n ∈ S, f (n : ℤ) :=
  sum_image (fun _ _ _ _ h => Int.ofNat.inj h)

theorem multiplicative_large_sieve_bilinear_nat (Q : Finset ℕ) {D R N M : ℝ}
    (hD : 0 < D) (hR : 1 ≤ R)
    (hQD : ∀ q ∈ Q, D ≤ (q : ℝ)) (hQR : ∀ q ∈ Q, (q : ℝ) ≤ R)
    (S T : Finset ℕ) (a b : ℕ → ℂ) (hN : 0 ≤ N) (hM : 0 ≤ M)
    (hS : ∀ n ∈ S, (n : ℝ) ≤ N) (hT : ∀ n ∈ T, (n : ℝ) ≤ M) :
    (∑ q ∈ Q, 1 / (q.totient : ℝ) * ∑ χ ∈ primitiveCharacters q,
      ‖∑ n ∈ S, a n * χ (n : ZMod q)‖ * ‖∑ n ∈ T, b n * χ (n : ZMod q)‖) ≤
      ((6 + 8 * Real.pi) / D) * Real.sqrt ((N + R ^ 2) * (M + R ^ 2) *
        (∑ n ∈ S, ‖a n‖ ^ 2) * ∑ n ∈ T, ‖b n‖ ^ 2) := by
  have hS' : ∀ z ∈ S.image (fun n : ℕ => (n : ℤ)), |(z : ℝ)| ≤ N := by
    intro z hz
    obtain ⟨n, hn, rfl⟩ := mem_image.mp hz
    simpa only [Int.cast_natCast, abs_of_nonneg (show (0 : ℝ) ≤ n from Nat.cast_nonneg n)] using hS n hn
  have hT' : ∀ z ∈ T.image (fun n : ℕ => (n : ℤ)), |(z : ℝ)| ≤ M := by
    intro z hz
    obtain ⟨n, hn, rfl⟩ := mem_image.mp hz
    simpa only [Int.cast_natCast, abs_of_nonneg (show (0 : ℝ) ≤ n from Nat.cast_nonneg n)] using hT n hn
  have h := multiplicative_large_sieve_bilinear_conductors Q hD hR hQD hQR
    (S.image (fun n : ℕ => (n : ℤ))) (T.image (fun n : ℕ => (n : ℤ)))
    (fun z => a z.toNat) (fun z => b z.toNat) hN hM hS' hT'
  simpa only [sum_nat_image_intCast, Int.toNat_natCast, Int.cast_natCast] using h

noncomputable def primitiveCharacterBlockNorm (Q : Finset ℕ)
    (F : (q : ℕ) → DirichletCharacter ℂ q → ℂ) : ℝ :=
  ∑ q ∈ Q, 1 / (q.totient : ℝ) * ∑ χ ∈ primitiveCharacters q, ‖F q χ‖

theorem primitiveCharacterBlockNorm_zero (Q : Finset ℕ) :
    primitiveCharacterBlockNorm Q 0 = 0 := by
  simp [primitiveCharacterBlockNorm]

theorem primitiveCharacterBlockNorm_add_le (Q : Finset ℕ)
    (F G : (q : ℕ) → DirichletCharacter ℂ q → ℂ) :
    primitiveCharacterBlockNorm Q (F + G) ≤
      primitiveCharacterBlockNorm Q F + primitiveCharacterBlockNorm Q G := by
  unfold primitiveCharacterBlockNorm
  rw [← sum_add_distrib]
  apply sum_le_sum
  intro q hq
  rw [← mul_add, ← sum_add_distrib]
  apply mul_le_mul_of_nonneg_left _ (by positivity)
  apply sum_le_sum
  intro χ hχ
  exact norm_add_le (F q χ) (G q χ)

theorem character_rectangle_factor (A B : Finset ℕ) (a b : ℕ → ℂ)
    (q : ℕ) (χ : DirichletCharacter ℂ q) :
    (∑ m ∈ A, ∑ n ∈ B, a m * b n * χ ((m * n : ℕ) : ZMod q)) =
      (∑ m ∈ A, a m * χ (m : ZMod q)) * ∑ n ∈ B, b n * χ (n : ZMod q) := by
  rw [sum_mul]
  apply sum_congr rfl
  intro m hm
  rw [mul_sum]
  apply sum_congr rfl
  intro n hn
  rw [Nat.cast_mul, map_mul]
  ring

theorem multiplicative_large_sieve_dyadic_prefix (Q : Finset ℕ) {D R N V : ℝ}
    (hD : 0 < D) (hR : 1 ≤ R)
    (hQD : ∀ q ∈ Q, D ≤ (q : ℝ)) (hQR : ∀ q ∈ Q, (q : ℝ) ≤ R)
    (K : ℕ) (S : Finset ℕ) (κ : ℕ → ℕ) (hκ : ∀ m ∈ S, κ m ≤ 2 ^ K)
    (a b : ℕ → ℂ) (hN : 0 ≤ N) (hV : 0 ≤ V)
    (hS : ∀ m ∈ S, (m : ℝ) ≤ N) (hcol : ∀ n ∈ range (2 ^ K), (n : ℝ) ≤ V) :
    (∑ q ∈ Q, 1 / (q.totient : ℝ) * ∑ χ ∈ primitiveCharacters q,
      ‖∑ m ∈ S, ∑ n ∈ range (κ m), a m * b n * χ ((m * n : ℕ) : ZMod q)‖) ≤
      (K + 1 : ℝ) * ((6 + 8 * Real.pi) / D) *
        Real.sqrt ((N + R ^ 2) * (V + R ^ 2) *
          (∑ m ∈ S, ‖a m‖ ^ 2) * ∑ n ∈ range (2 ^ K), ‖b n‖ ^ 2) := by
  let F : ℕ → ℕ → (q : ℕ) → DirichletCharacter ℂ q → ℂ :=
    fun m n q χ => a m * b n * χ ((m * n : ℕ) : ZMod q)
  have hfactor : 0 ≤ (N + R ^ 2) * (V + R ^ 2) := by positivity
  have hrect : ∀ A ⊆ S, ∀ B ⊆ range (2 ^ K),
      primitiveCharacterBlockNorm Q (∑ m ∈ A, ∑ n ∈ B, F m n) ≤
        (((6 + 8 * Real.pi) / D) * Real.sqrt ((N + R ^ 2) * (V + R ^ 2))) *
          Real.sqrt ((∑ m ∈ A, ‖a m‖ ^ 2) * ∑ n ∈ B, ‖b n‖ ^ 2) := by
    intro A hA B hB
    have h := multiplicative_large_sieve_bilinear_nat Q hD hR hQD hQR A B a b hN hV
      (fun m hm => hS m (hA hm)) (fun n hn => hcol n (hB hn))
    have heq : (N + R ^ 2) * (V + R ^ 2) *
        (∑ m ∈ A, ‖a m‖ ^ 2) * (∑ n ∈ B, ‖b n‖ ^ 2) =
        ((N + R ^ 2) * (V + R ^ 2)) *
          ((∑ m ∈ A, ‖a m‖ ^ 2) * ∑ n ∈ B, ‖b n‖ ^ 2) := by ring
    rw [heq, Real.sqrt_mul hfactor] at h
    simp only [primitiveCharacterBlockNorm, Finset.sum_apply, F]
    simp_rw [character_rectangle_factor, norm_mul]
    simpa only [mul_assoc] using h
  have h := dyadic_prefix_subadditive_bound K S κ hκ
    (fun m => ‖a m‖ ^ 2) (fun n => ‖b n‖ ^ 2)
    (fun m => sq_nonneg _) (fun n => sq_nonneg _) F
    (primitiveCharacterBlockNorm Q) (primitiveCharacterBlockNorm_zero Q)
    (primitiveCharacterBlockNorm_add_le Q) (by positivity) hrect
  have heq : (N + R ^ 2) * (V + R ^ 2) *
      (∑ m ∈ S, ‖a m‖ ^ 2) * (∑ n ∈ range (2 ^ K), ‖b n‖ ^ 2) =
      ((N + R ^ 2) * (V + R ^ 2)) *
        ((∑ m ∈ S, ‖a m‖ ^ 2) * ∑ n ∈ range (2 ^ K), ‖b n‖ ^ 2) := by ring
  rw [heq, Real.sqrt_mul hfactor]
  simpa only [primitiveCharacterBlockNorm, Finset.sum_apply, F, mul_assoc] using h


end Bounty
end

section

/- The exact candidate prime-remainder convolution in the original product window. -/

open Finset Filter

namespace Bounty

theorem arithmetic_product_window_mul_image {p : ℕ} (hp : p ≠ 0) (X : ℝ) :
    (arithmeticProductWindow p X).image (fun n => p * n) =
      (arithmeticProductWindow 1 X).filter (fun u => p ∣ u) := by
  classical
  ext u
  constructor
  · intro hu
    obtain ⟨n, hn, rfl⟩ := mem_image.mp hu
    apply mem_filter.mpr
    refine ⟨?_, dvd_mul_right p n⟩
    apply (mem_arithmeticProductWindow_iff one_ne_zero X).mpr
    simpa only [one_mul] using (mem_arithmeticProductWindow_iff hp X).mp hn
  · intro hu
    obtain ⟨hu, hpu⟩ := mem_filter.mp hu
    refine mem_image.mpr ⟨u / p, ?_, Nat.mul_div_cancel' hpu⟩
    apply (mem_arithmeticProductWindow_iff hp X).mpr
    rw [Nat.mul_div_cancel' hpu]
    simpa only [one_mul] using (mem_arithmeticProductWindow_iff one_ne_zero X).mp hu

theorem arithmetic_product_window_divisor_test {p : ℕ} (hp : p ≠ 0) (X : ℝ)
    (b G : ℕ → ℂ) :
    (∑ u ∈ (arithmeticProductWindow 1 X).filter (fun u => p ∣ u), b (u / p) * G u) =
      ∑ n ∈ arithmeticProductWindow p X, b n * G (p * n) := by
  classical
  rw [← arithmetic_product_window_mul_image hp X, sum_image]
  · apply sum_congr rfl
    intro n _
    rw [Nat.mul_div_cancel_left n (Nat.pos_of_ne_zero hp)]
  · intro n _ m _ hnm
    exact Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero hp) hnm

theorem finite_divisor_convolution_window_test (P : Finset ℕ) (A b : ℕ → ℝ)
    (X : ℝ) (hp : ∀ p ∈ P, p ≠ 0)
    (hA : ∀ u ∈ arithmeticProductWindow 1 X,
      A u = ∑ p ∈ P.filter (fun p => p ∣ u), b (u / p)) (G : ℕ → ℂ) :
    (∑ u ∈ arithmeticProductWindow 1 X, (A u : ℂ) * G u) =
      ∑ p ∈ P, ∑ n ∈ arithmeticProductWindow p X, (b n : ℂ) * G (p * n) := by
  classical
  calc
    _ = ∑ u ∈ arithmeticProductWindow 1 X,
        ∑ p ∈ P, if p ∣ u then (b (u / p) : ℂ) * G u else 0 := by
      apply sum_congr rfl
      intro u hu
      rw [hA u hu, Complex.ofReal_sum, sum_mul, sum_filter]
    _ = ∑ p ∈ P, ∑ u ∈ arithmeticProductWindow 1 X,
        if p ∣ u then (b (u / p) : ℂ) * G u else 0 := sum_comm
    _ = _ := by
      apply sum_congr rfl
      intro p hpP
      rw [← sum_filter]
      exact arithmetic_product_window_divisor_test (hp p hpP) X (fun n => (b n : ℂ)) G

theorem candidate_prime_remainder_complex_window {c L : ℝ} (hcL : 0 ≤ c * L)
    (q : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : 0 < jStar) (G : ℕ → ℂ) :
    (∑ u ∈ arithmeticProductWindow 1 (Real.exp L),
      (candidateCoefficient c L q r jStar u : ℂ) * G u) =
      ∑ p ∈ candidateQBand (c * L) 0, ∑ n ∈ arithmeticProductWindow p (Real.exp L),
        (candidateRemainderCoefficient c L q r jStar hr n : ℂ) * G (p * n) := by
  apply finite_divisor_convolution_window_test
  · intro p hp
    exact (candidate_Q_zero_prime_outside_pool hcL hp).1.ne_zero
  · intro u _
    exact candidate_coefficient_remainder_convolution_all hcL q r jStar hr hj u

theorem candidate_prime_remainder_character_window {c L : ℝ} (hcL : 0 ≤ c * L)
    (q : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : 0 < jStar)
    {d : ℕ} (χ : DirichletCharacter ℂ d) (h : ℕ) (G : ℕ → ℂ) :
    (∑ u ∈ (arithmeticProductWindow 1 (Real.exp L)).filter (fun u => u.Coprime h),
      (candidateCoefficient c L q r jStar u : ℂ) * χ (u : ZMod d) * G u) =
      ∑ p ∈ (candidateQBand (c * L) 0).filter (fun p => p.Coprime h),
        ∑ n ∈ (arithmeticProductWindow p (Real.exp L)).filter (fun n => n.Coprime h),
          (candidateRemainderCoefficient c L q r jStar hr n : ℂ) *
            χ (p : ZMod d) * χ (n : ZMod d) * G (p * n) := by
  classical
  calc
    _ = ∑ u ∈ arithmeticProductWindow 1 (Real.exp L),
        (candidateCoefficient c L q r jStar u : ℂ) *
          (if u.Coprime h then χ (u : ZMod d) * G u else 0) := by
      rw [sum_filter]
      apply sum_congr rfl
      intro u _
      split_ifs <;> simp [mul_assoc]
    _ = ∑ p ∈ candidateQBand (c * L) 0,
        (1 : ℂ) * ∑ n ∈ arithmeticProductWindow p (Real.exp L),
          (candidateRemainderCoefficient c L q r jStar hr n : ℂ) *
            (if (p*n).Coprime h then χ (p*n : ZMod d) * G (p*n) else 0) := by
      simpa only [one_mul, Nat.cast_mul] using
        candidate_prime_remainder_complex_window hcL q r jStar hr hj
          (fun u => if u.Coprime h then χ (u : ZMod d) * G u else 0)
    _ = ∑ p ∈ (candidateQBand (c * L) 0).filter (fun p => p.Coprime h),
        (1 : ℂ) * χ (p : ZMod d) *
          ∑ n ∈ (arithmeticProductWindow p (Real.exp L)).filter (fun n => n.Coprime h),
            (candidateRemainderCoefficient c L q r jStar hr n : ℂ) *
              χ (n : ZMod d) * G (p*n) := by
      simpa only [Complex.ofReal_one] using
        complex_character_coprime_convolution (candidateQBand (c * L) 0)
          (fun p => arithmeticProductWindow p (Real.exp L)) (fun _ => 1)
          (candidateRemainderCoefficient c L q r jStar hr) G χ h
    _ = _ := by
      apply sum_congr rfl
      intro p _
      rw [one_mul, mul_sum]
      apply sum_congr rfl
      intro n _
      ring

theorem candidate_prime_remainder_character_sum {c L : ℝ} (hcL : 0 ≤ c * L)
    (q : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : 0 < jStar)
    {d : ℕ} (χ : DirichletCharacter ℂ d) (h : ℕ) :
    (∑ u ∈ (arithmeticProductWindow 1 (Real.exp L)).filter (fun u => u.Coprime h),
      (candidateCoefficient c L q r jStar u : ℂ) * χ (u : ZMod d)) =
      ∑ p ∈ (candidateQBand (c * L) 0).filter (fun p => p.Coprime h),
        ∑ n ∈ (arithmeticProductWindow p (Real.exp L)).filter (fun n => n.Coprime h),
          (candidateRemainderCoefficient c L q r jStar hr n : ℂ) *
            χ (p : ZMod d) * χ (n : ZMod d) := by
  simpa only [mul_one] using
    candidate_prime_remainder_character_window hcL q r jStar hr hj χ h (fun _ => 1)

theorem candidate_prime_remainder_character_cutoff {c L : ℝ} (hcL : 0 ≤ c * L)
    (q : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : 0 < jStar)
    {d : ℕ} (χ : DirichletCharacter ℂ d) (h : ℕ) (G : ℕ → ℂ) :
    (∑ u ∈ (arithmeticProductWindow 1 (Real.exp L)).filter (fun u => u.Coprime h),
      (candidateCoefficient c L q r jStar u : ℂ) * χ (u : ZMod d) * G u) =
      ∑ p ∈ (candidateQBand (c * L) 0).filter (fun p => p.Coprime h),
        ∑ n ∈ (Iic ⌊16 * Real.exp L⌋₊).filter (fun n => n.Coprime h),
          if Real.exp L < (p * n : ℕ) ∧ (p * n : ℕ) ≤ 16 * Real.exp L then
            (candidateRemainderCoefficient c L q r jStar hr n : ℂ) *
              χ (p : ZMod d) * χ (n : ZMod d) * G (p * n)
          else 0 := by
  classical
  rw [candidate_prime_remainder_character_window hcL q r jStar hr hj χ h G]
  apply sum_congr rfl
  intro p _
  simp only [arithmeticProductWindow]
  rw [← sum_filter, filter_comm]

theorem candidate_prime_remainder_character_cutoff_sum {c L : ℝ}
    (hcL : 0 ≤ c * L) (q : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : 0 < jStar)
    {d : ℕ} (χ : DirichletCharacter ℂ d) (h : ℕ) :
    (∑ u ∈ (arithmeticProductWindow 1 (Real.exp L)).filter (fun u => u.Coprime h),
      (candidateCoefficient c L q r jStar u : ℂ) * χ (u : ZMod d)) =
      ∑ p ∈ (candidateQBand (c * L) 0).filter (fun p => p.Coprime h),
        ∑ n ∈ (Iic ⌊16 * Real.exp L⌋₊).filter (fun n => n.Coprime h),
          if Real.exp L < (p * n : ℕ) ∧ (p * n : ℕ) ≤ 16 * Real.exp L then
            (candidateRemainderCoefficient c L q r jStar hr n : ℂ) *
              χ (p : ZMod d) * χ (n : ZMod d)
          else 0 := by
  simpa only [mul_one] using
    candidate_prime_remainder_character_cutoff hcL q r jStar hr hj χ h (fun _ => 1)

theorem candidate_prime_remainder_character_masked {c L : ℝ}
    (hcL : 0 ≤ c * L) (q : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : 0 < jStar)
    {d : ℕ} (χ : DirichletCharacter ℂ d) (h : ℕ) :
    (∑ u ∈ (arithmeticProductWindow 1 (Real.exp L)).filter (fun u => u.Coprime h),
      (candidateCoefficient c L q r jStar u : ℂ) * χ (u : ZMod d)) =
      ∑ p ∈ candidateQBand (c * L) 0, ∑ n ∈ Iic ⌊16 * Real.exp L⌋₊,
        if Real.exp L < (p * n : ℕ) ∧ (p * n : ℕ) ≤ 16 * Real.exp L then
          (if p.Coprime h then (1 : ℂ) else 0) *
            (if n.Coprime h then
              (candidateRemainderCoefficient c L q r jStar hr n : ℂ) else 0) *
            χ ((p * n : ℕ) : ZMod d)
        else 0 := by
  classical
  rw [candidate_prime_remainder_character_cutoff_sum hcL q r jStar hr hj χ h]
  simp only [sum_filter]
  apply sum_congr rfl
  intro p _
  by_cases hp : p.Coprime h
  · simp only [if_pos hp, one_mul]
    apply sum_congr rfl
    intro n _
    split_ifs <;> simp_all [Nat.cast_mul, map_mul, mul_assoc]
  · simp only [if_neg hp, zero_mul, ite_self, sum_const_zero]

theorem candidate_prime_remainder_character_positive_cutoff {c L : ℝ}
    (hcL : 0 ≤ c * L) (q : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : 0 < jStar)
    {d : ℕ} (χ : DirichletCharacter ℂ d) (h : ℕ) :
    (∑ u ∈ (arithmeticProductWindow 1 (Real.exp L)).filter (fun u => u.Coprime h),
      (candidateCoefficient c L q r jStar u : ℂ) * χ (u : ZMod d)) =
      ∑ p ∈ candidateQBand (c * L) 0, ∑ n ∈ Icc 1 ⌊16 * Real.exp L⌋₊,
        if Real.exp L < (p * n : ℕ) ∧ (p * n : ℕ) ≤ 16 * Real.exp L then
          (if p.Coprime h then (1 : ℂ) else 0) *
            (if n.Coprime h then
              (candidateRemainderCoefficient c L q r jStar hr n : ℂ) else 0) *
            χ ((p * n : ℕ) : ZMod d)
        else 0 := by
  classical
  rw [candidate_prime_remainder_character_masked hcL q r jStar hr hj χ h]
  apply sum_congr rfl
  intro p _
  symm
  apply sum_subset
  · intro n hn
    exact mem_Iic.mpr (mem_Icc.mp hn).2
  · intro n hn hnnot
    have hnzero : n = 0 := by
      simp only [mem_Iic, mem_Icc, not_and] at hn hnnot
      omega
    subst n
    simp only [Nat.mul_zero, Nat.cast_zero, not_lt.mpr (Real.exp_nonneg L),
      false_and, if_false]

end Bounty
end

section

/- Auxiliary observations survive both the exact full-target continuation
transport and the sum over every physical target list. -/

open Finset
open scoped Classical
namespace Bounty

section Physical
variable {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin N → Finset (Fin J)) (k : ℤ) (L : PhysicalMarkLists P J ell)
  (H : (g : Fin N) → Finset ↥(P g))
  (q : (g : Fin N) → BoundedOrderedTuple
    (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B)
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (β : (g : Fin N) → ↥(P g) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
  (ω : ∀ _c : SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C g)), PhysicalAuxLabels P C → ℝ)
  (F : PhysicalAuxLabels P C → FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ)

include hP hdis

theorem physical_full_fixed_edge_observed_continuation (R : PhysicalMarkLists P J ell) :
    let n := fun g (p : ↥(P g)) => p.val
    let S := fun g => physicalFullSharedIndices (ell := ell) (C g)
    let A := fun _ : SharedActiveLabels (fun g => ↥(P g)) S => PhysicalAuxLabels P C
    let x := physicalFullMemoryState C L q
    let c := (productActiveMemorySplit S B x).1
    (∑ aux : PhysicalAuxLabels P C, (ω c aux : ℂ) *
      if physicalListAdmissible C aux L R then
        jointRawTensorCutoff B (physicalFullEdgeRawRow (B := B) C k L R β ρ V aux)
          (physicalFullContinuation C R (F aux)) (fun g => (H g, boundedOrderedTupleToFinite (q g))) else 0) =
    ∑ e : PhysicalFullEdgeEvent C k x,
      (fullActiveEdgeEventWeight n S B A (physicalFullEdgeDelta C k) (physicalFullEdgeD C)
        ω (fun g p => β g p / V g) ρ V x e : ℂ) * physicalFullEdgePhase C k L R H q e *
      F e.1 (fullEdgeLedgerUpdate n S B A (physicalFullEdgeDelta C k) (physicalFullEdgeD C) H x e,
        fullActiveEdgeEventTarget n S B A (physicalFullEdgeDelta C k) (physicalFullEdgeD C) x e) := by
  have h := physical_full_edge_auxiliary_observed_rows C k L R H q hP hdis β ρ V ω
    (fun aux => physicalFullContinuation C R (F aux))
  refine h.trans ?_
  apply sum_congr rfl
  intro e _
  exact physical_full_edge_continuation_weighted C k L R H q ω (fun g p => β g p / V g) ρ V e (F e.1)

theorem physical_full_all_endpoints_edge_observed_continuation :
    let n := fun g (p : ↥(P g)) => p.val
    let S := fun g => physicalFullSharedIndices (ell := ell) (C g)
    let A := fun _ : SharedActiveLabels (fun g => ↥(P g)) S => PhysicalAuxLabels P C
    let x := physicalFullMemoryState C L q
    let c := (productActiveMemorySplit S B x).1
    (∑ R : PhysicalMarkLists P J ell, ∑ aux : PhysicalAuxLabels P C, (ω c aux : ℂ) *
      if physicalListAdmissible C aux L R then
        jointRawTensorCutoff B (physicalFullEdgeRawRow (B := B) C k L R β ρ V aux)
          (physicalFullContinuation C R (F aux)) (fun g => (H g, boundedOrderedTupleToFinite (q g))) else 0) =
    ∑ e : PhysicalFullEdgeEvent C k x,
      (fullActiveEdgeEventWeight n S B A (physicalFullEdgeDelta C k) (physicalFullEdgeD C)
        ω (fun g p => β g p / V g) ρ V x e : ℂ) *
      physicalFullEndpointPhase C k L H q ω (fun g p => β g p / V g) ρ V e *
      F e.1 (fullEdgeLedgerUpdate n S B A (physicalFullEdgeDelta C k) (physicalFullEdgeD C) H x e,
        fullActiveEdgeEventTarget n S B A (physicalFullEdgeDelta C k) (physicalFullEdgeD C) x e) := by
  dsimp only
  simp_rw [physical_full_fixed_edge_observed_continuation C k L H q hP hdis β ρ V ω F]
  rw [sum_comm]
  apply sum_congr rfl
  intro e _
  rw [← sum_mul, ← physical_full_endpoint_phase_weighted]

end Physical
end Bounty
end

section

/- Exact reduction of the asymmetric full-coordinate pairing to its shared slices. -/

namespace Bounty

open Finset
open scoped Classical

theorem finite_four_asymmetric_pairing_error_le {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)]
    (μ : ∀ i, X i → ℝ) (hμ : ∀ i x, 0 ≤ μ i x) (hmass : ∀ i, ∑ x, μ i x = 1)
    (S A B T : Finset I) (hSA : Disjoint S A) (hSB : Disjoint S B) (hST : Disjoint S T)
    (hAB : Disjoint A B) (hAT : Disjoint A T) (hBT : Disjoint B T)
    (hcover : S ∪ A ∪ B ∪ T = univ)
    (KA : (∀ i : A, X i.1) → (∀ i : A, X i.1) → ℂ)
    (KB : (∀ i : B, X i.1) → (∀ i : B, X i.1) → ℂ)
    (phase : (∀ i : S, X i.1) → (∀ i : A, X i.1) → (∀ i : B, X i.1) → ℂ)
    (f g : (∀ i, X i) → ℂ)
    (F : (∀ i : S, X i.1) → (∀ i : B, X i.1) → ℂ)
    (G : (∀ i : S, X i.1) → (∀ i : A, X i.1) → ℂ)
    (hf : ∀ x, f x = F (finiteCoordinateRestrict S x) (finiteCoordinateRestrict B x))
    (hg : ∀ x, g x = G (finiteCoordinateRestrict S x) (finiteCoordinateRestrict A x))
    (ε : ℝ) (hε : 0 ≤ ε)
    (herr : ∀ c, ‖finiteTwoKernelPairingError
        (finiteProductWeight (fun i : A => μ i.1)) (finiteProductWeight (fun i : B => μ i.1))
        KA KB (phase c) (G c) (fun b => (starRingEnd ℂ) (F c b))‖ ≤
      ε * Real.sqrt (finiteWeightedEnergy (finiteProductWeight (fun i : A => μ i.1)) (G c)) *
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight (fun i : B => μ i.1)) (F c))) :
    ‖cleanRawPairing (finiteProductWeight μ)
        (fun x => phase (finiteCoordinateRestrict S x) (finiteCoordinateRestrict A x)
          (finiteCoordinateRestrict B x)) f g -
      cleanKernelPairing (finiteProductWeight μ)
        (finiteAsymmetricKernel μ S A B (fun c a b => finiteTwoKernelAverage
          (finiteProductWeight (fun i : A => μ i.1)) (finiteProductWeight (fun i : B => μ i.1))
          KA KB a b (phase c))) f g‖ ≤
      ε * Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) f) *
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) g) := by
  let Y := (∀ i : S, X i.1) × (∀ i : A, X i.1) × (∀ i : B, X i.1)
  let Z := ∀ i : T, X i.1
  let E : (∀ i, X i) ≃ Y × Z :=
    (finiteFourPartitionEquiv S A B T hSA hSB hST hAB hAT hBT hcover).trans finiteFourPackEquiv
  let ρ := finiteProductWeight (fun i : S => μ i.1)
  let μA := finiteProductWeight (fun i : A => μ i.1)
  let μB := finiteProductWeight (fun i : B => μ i.1)
  let μT := finiteProductWeight (fun i : T => μ i.1)
  let w : Y → ℝ := fun x => ρ x.1 * μA x.2.1 * μB x.2.2
  let f0 : Y → ℂ := fun x => F x.1 x.2.2
  let g0 : Y → ℂ := fun x => G x.1 x.2.1
  let k0 : Y → ℂ := fun x => phase x.1 x.2.1 x.2.2
  let H := fun c a b => finiteTwoKernelAverage μA μB KA KB a b (phase c)
  let K0 := finiteThreeWayKernel μA μB H
  have hmA : ∑ a, μA a = 1 := finite_product_weight_sum_one _ (fun i => hmass i.1)
  have hmB : ∑ b, μB b = 1 := finite_product_weight_sum_one _ (fun i => hmass i.1)
  have hmT : ∑ t, μT t = 1 := finite_product_weight_sum_one _ (fun i => hmass i.1)
  have hw (p : Y × Z) : finiteProductWeight μ (E.symm p) = w p.1 * μT p.2 := by
    change finiteProductWeight μ (finiteFourPartitionFill S A B T hcover
      p.1.1 p.1.2.1 p.1.2.2 p.2) = _
    rw [finite_product_weight_four_fill μ S A B T hSA hSB hST hAB hAT hBT hcover]
  have hfill (p : Y × Z) : E.symm p =
      finiteFourPartitionFill S A B T hcover p.1.1 p.1.2.1 p.1.2.2 p.2 := rfl
  have hsf (p : Y × Z) : f (E.symm p) = f0 p.1 := by
    rw [hf, hfill, finite_four_partition_fill_s,
      finite_four_partition_fill_b S A B T hcover hSB hAB]
  have hsg (p : Y × Z) : g (E.symm p) = g0 p.1 := by
    rw [hg, hfill, finite_four_partition_fill_s,
      finite_four_partition_fill_a S A B T hcover hSA]
  have hsk (p : Y × Z) : phase (finiteCoordinateRestrict S (E.symm p))
      (finiteCoordinateRestrict A (E.symm p)) (finiteCoordinateRestrict B (E.symm p)) = k0 p.1 := by
    rw [hfill, finite_four_partition_fill_s,
      finite_four_partition_fill_a S A B T hcover hSA,
      finite_four_partition_fill_b S A B T hcover hSB hAB]
  have hsK (p q : Y × Z) : finiteAsymmetricKernel μ S A B H (E.symm p) (E.symm q) =
      (μT q.2 : ℂ) * K0 p.1 q.1 := by
    change finiteAsymmetricKernel μ S A B H
      (finiteFourPartitionFill S A B T hcover p.1.1 p.1.2.1 p.1.2.2 p.2)
      (finiteFourPartitionFill S A B T hcover q.1.1 q.1.2.1 q.1.2.2 q.2) = _
    rw [finite_asymmetric_kernel_four_fill μ S A B T hSA hSB hST hAB hAT hBT hcover]
    dsimp only [K0, μA, μB, μT]
    unfold finiteThreeWayKernel
    split_ifs <;> push_cast <;> ring
  have hr : cleanRawPairing (finiteProductWeight μ)
      (fun x => phase (finiteCoordinateRestrict S x) (finiteCoordinateRestrict A x)
        (finiteCoordinateRestrict B x)) f g = cleanRawPairing w k0 f0 g0 := by
    rw [clean_raw_pairing_equiv E]
    simp only [hw, hsf, hsg, hsk]
    exact finite_independent_tail_raw_pairing w μT hmT k0 f0 g0
  have hc : cleanKernelPairing (finiteProductWeight μ) (finiteAsymmetricKernel μ S A B H) f g =
      cleanKernelPairing w K0 f0 g0 := by
    rw [clean_kernel_pairing_equiv E]
    simp only [hw, hsf, hsg, hsK]
    exact finite_independent_tail_kernel_pairing w μT hmT K0 f0 g0
  have hef : finiteWeightedEnergy (finiteProductWeight μ) f = finiteWeightedEnergy w f0 := by
    rw [finite_weighted_energy_equiv E]
    simp only [hw, hsf]
    exact finite_independent_tail_energy w μT hmT f0
  have heg : finiteWeightedEnergy (finiteProductWeight μ) g = finiteWeightedEnergy w g0 := by
    rw [finite_weighted_energy_equiv E]
    simp only [hw, hsg]
    exact finite_independent_tail_energy w μT hmT g0
  rw [hr, hc, hef, heg]
  exact finite_three_way_pairing_error_le ρ μA μB
    (fun x => prod_nonneg (fun i _ => hμ i.1 (x i)))
    (fun x => prod_nonneg (fun i _ => hμ i.1 (x i)))
    (fun x => prod_nonneg (fun i _ => hμ i.1 (x i)))
    hmA hmB KA KB phase F G ε hε herr

end Bounty
end

section

/- Positive rough-cell denominators and exact finite count-matched proxies. -/

open Finset Filter

namespace Bounty

theorem eventually_rough_logarithmic_cell_count_pos {a : ℝ} (ha : 0 < a) (S : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, Real.exp (a * L) ≤ Y →
      0 < (roughBand Y (Real.exp (L^(-S)) * Y) (Real.exp (Real.sqrt L))).card ∧
      roughLogarithmicCellMainTerm L S Y / 2 ≤
        ((roughBand Y (Real.exp (L^(-S)) * Y) (Real.exp (Real.sqrt L))).card : ℝ) ∧
      ((roughBand Y (Real.exp (L^(-S)) * Y) (Real.exp (Real.sqrt L))).card : ℝ) ≤
        (3/2 : ℝ) * roughLogarithmicCellMainTerm L S Y := by
  filter_upwards [eventually_rough_logarithmic_cell_count ha S 1,
    eventually_ge_atTop (2 : ℝ), eventually_ge_atTop (Real.log 2)]
    with L hcount hL hlog
  intro Y hY
  have hL0 : 0 < L := by linarith
  have hY0 : 0 < Y := (Real.exp_pos _).trans_le hY
  have hC := primeEulerProductUpperConstant_pos
  have hM : 0 < roughLogarithmicCellMainTerm L S Y :=
    (div_pos hY0 (by positivity)).trans_le
      (rough_logarithmic_cell_main_term_lower (by linarith) hlog hY0.le S)
  have hpow : L^(-(1 : ℝ)) ≤ (1/2 : ℝ) := by
    rw [Real.rpow_neg_one]
    simpa only [one_div] using one_div_le_one_div_of_le (by norm_num : (0 : ℝ) < 2) hL
  have h := (hcount Y hY).trans (mul_le_mul_of_nonneg_left hpow hM.le)
  have hb := abs_le.mp h
  have hpos : (0 : ℝ) <
      ((roughBand Y (Real.exp (L^(-S)) * Y) (Real.exp (Real.sqrt L))).card : ℝ) := by
    linarith
  refine ⟨by exact_mod_cast hpos, ?_, ?_⟩ <;> linarith

theorem finite_cell_count_proxy {ι : Type*} (R I : Finset ι) (hI : I ⊆ R)
    (hR : 0 < R.card) :
    0 ≤ (I.card : ℝ) / R.card ∧ (I.card : ℝ) / R.card ≤ 1 ∧
      (∑ _n ∈ R, (I.card : ℝ) / R.card) = (I.card : ℝ) := by
  have hR0 : (0 : ℝ) < R.card := by exact_mod_cast hR
  have hcard : (I.card : ℝ) ≤ R.card := by exact_mod_cast card_le_card hI
  refine ⟨by positivity, (div_le_one hR0).mpr hcard, ?_⟩
  simp only [sum_const, nsmul_eq_mul]
  field_simp

end Bounty
end

section

/- Converting polynomial losses at logarithmic scale to the wide prime supply. -/

open Filter

namespace Bounty

/-- Every sufficiently large logarithmic scale covers every sufficiently large
real scale after exponentiation. -/
theorem wide_smooth_supply_of_exponential_scale
    (hS : ∀ δ : ℝ, 0 < δ → δ < 1 / 4 → ∀ σ : ℝ, 0 < σ →
      ∀ᶠ L : ℝ in atTop, ∃ P : Finset ℕ,
        P ⊆ primeBand (2 * Real.exp L) (33 * Real.exp L) ∧
        Real.exp ((1 - σ) * L) ≤ (P.card : ℝ) ∧
        ∀ p ∈ P, ∀ q : ℕ, q.Prime → q ∣ p - 1 → (q : ℝ) ≤ Real.exp (δ * L)) :
    WideSmoothShiftedPrimeSupply := by
  intro δ hδ hδsmall σ hσ
  filter_upwards [Real.tendsto_log_atTop.eventually (hS δ hδ hδsmall σ hσ),
    eventually_gt_atTop (0 : ℝ)] with x hPx hx
  obtain ⟨P, hP, hcard, hsmooth⟩ := hPx
  rw [Real.exp_log hx] at hP
  refine ⟨P, hP, ?_, ?_⟩
  · calc
      x ^ (1 - σ) = Real.exp ((1 - σ) * Real.log x) := by
        rw [Real.rpow_def_of_pos hx, mul_comm]
      _ ≤ (P.card : ℝ) := hcard
  · intro p hp q hq hdiv
    calc
      (q : ℝ) ≤ Real.exp (δ * Real.log x) := hsmooth p hp q hq hdiv
      _ = x ^ δ := by rw [Real.rpow_def_of_pos hx, mul_comm]

theorem eventually_exp_power_le_exp_mul_rpow (C : ℝ) {σ : ℝ} (hσ : 0 < σ) :
    ∀ᶠ L : ℝ in atTop,
      Real.exp ((1 - σ) * L) ≤ Real.exp L * L ^ (-C) := by
  filter_upwards [eventually_mul_rpow_log_add_le_rpow
    (a := 0) (b := 1) (by norm_num) (by norm_num) hσ C 0,
    eventually_gt_atTop (0 : ℝ)] with L hL hL0
  simp only [Real.rpow_zero, Real.rpow_one, mul_one, add_zero] at hL
  calc
    Real.exp ((1 - σ) * L) ≤ Real.exp (L + Real.log L * (-C)) := by
      apply Real.exp_le_exp.mpr
      nlinarith only [hL]
    _ = Real.exp L * L ^ (-C) := by
      rw [Real.exp_add, Real.rpow_def_of_pos hL0]

/-- A fixed polynomial loss in `L = log x` suffices for every power loss in `x`. -/
theorem wide_smooth_supply_of_logarithmic_polynomial
    (hS : ∀ δ : ℝ, 0 < δ → δ < 1 / 4 → ∃ C : ℝ,
      ∀ᶠ L : ℝ in atTop, ∃ P : Finset ℕ,
        P ⊆ primeBand (2 * Real.exp L) (33 * Real.exp L) ∧
        Real.exp L * L ^ (-C) ≤ (P.card : ℝ) ∧
        ∀ p ∈ P, ∀ q : ℕ, q.Prime → q ∣ p - 1 → (q : ℝ) ≤ Real.exp (δ * L)) :
    WideSmoothShiftedPrimeSupply := by
  intro δ hδ hδsmall σ hσ
  obtain ⟨C, hC⟩ := hS δ hδ hδsmall
  filter_upwards [Real.tendsto_log_atTop.eventually hC,
    Real.tendsto_log_atTop.eventually (eventually_exp_power_le_exp_mul_rpow C hσ),
    eventually_gt_atTop (0 : ℝ)] with x hPx hbound hx
  obtain ⟨P, hP, hcard, hsmooth⟩ := hPx
  rw [Real.exp_log hx] at hP hcard
  refine ⟨P, hP, ?_, ?_⟩
  · calc
      x ^ (1 - σ) = Real.exp ((1 - σ) * Real.log x) := by
        rw [Real.rpow_def_of_pos hx, mul_comm]
      _ ≤ Real.exp (Real.log x) * (Real.log x) ^ (-C) := hbound
      _ ≤ (P.card : ℝ) := by simpa only [Real.exp_log hx] using hcard
  · intro p hp q hq hdiv
    calc
      (q : ℝ) ≤ Real.exp (δ * Real.log x) := hsmooth p hp q hq hdiv
      _ = x ^ δ := by rw [Real.rpow_def_of_pos hx, mul_comm]

end Bounty
end

section

/- Nonprincipal character cancellation from the actual rough residue-class counts. -/

open Finset

namespace Bounty

theorem nonprincipal_character_sum_le_class_errors {r : ℕ} [NeZero r]
    (S : Finset ℕ) (χ : DirichletCharacter ℂ r) (hχ : χ ≠ 1) {M E : ℝ}
    (hE : 0 ≤ E)
    (hclass : ∀ a : ZMod r, IsUnit a →
      |((S.filter (fun n : ℕ => (n : ZMod r) = a)).card : ℝ) - M| ≤ E) :
    ‖∑ n ∈ S, χ (n : ZMod r)‖ ≤ (r : ℝ) * E := by
  classical
  let C : ZMod r → ℝ := fun a => ((S.filter (fun n : ℕ => (n : ZMod r) = a)).card : ℝ)
  have hfiber : (∑ n ∈ S, χ (n : ZMod r)) =
      ∑ a : ZMod r, (C a : ℂ) * χ a := by
    simpa only [C, sum_const, nsmul_eq_mul, Complex.ofReal_natCast] using
      (sum_fiberwise' S (fun n : ℕ => (n : ZMod r)) χ).symm
  have hzero : (∑ a : ZMod r, χ a) = 0 := MulChar.sum_eq_zero_of_ne_one hχ
  have hrepr : (∑ n ∈ S, χ (n : ZMod r)) =
      ∑ a : ZMod r, ((C a - M : ℝ) : ℂ) * χ a := by
    rw [hfiber]
    simp only [Complex.ofReal_sub, sub_mul, sum_sub_distrib, ← mul_sum, hzero,
      mul_zero, sub_zero]
  rw [hrepr]
  calc
    _ ≤ ∑ a : ZMod r, ‖((C a - M : ℝ) : ℂ) * χ a‖ := norm_sum_le _ _
    _ ≤ ∑ _a : ZMod r, E := by
      apply sum_le_sum
      intro a _
      by_cases ha : IsUnit a
      · rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
        exact (mul_le_mul_of_nonneg_left (χ.norm_le_one a) (abs_nonneg _)).trans
          (by simpa only [mul_one] using hclass a ha)
      · rw [MulChar.map_nonunit χ ha, mul_zero, norm_zero]
        exact hE
    _ = (r : ℝ) * E := by simp [ZMod.card]

theorem exists_rough_interval_character_bound :
    ∃ K : ℝ, 0 < K ∧ ∀ (A B r : ℕ) [NeZero r] (χ : DirichletCharacter ℂ r),
      χ ≠ 1 → ∀ {z : ℝ} {h : ℕ}, 1 < z → A ≤ B →
      (∀ p ∈ r.primeFactors, (p : ℝ) ≤ z) → 1 ≤ h → Even h →
      ‖∑ n ∈ (Ioc A B).filter (fun n : ℕ => ∀ p ∈ n.primeFactors, z < (p : ℝ)),
        χ (n : ZMod r)‖ ≤
        (r : ℝ) * ((((B : ℝ) - A) / r.totient) *
          (∏ p ∈ primeBand 0 z, (1 - 1 / (p : ℝ))) * K *
            Real.exp (-(h : ℝ)) + z^(4 * (h : ℝ) + 2)) := by
  obtain ⟨K, hK, hcount⟩ := exists_unit_residue_rough_count
  refine ⟨K, hK, ?_⟩
  intro A B r hr χ hχ z h hz hAB hpf hh heven
  have hrpos : 0 < r := Nat.pos_of_ne_zero (NeZero.ne r)
  have hV : 0 ≤ ∏ p ∈ primeBand 0 z, (1 - 1 / (p : ℝ)) :=
    (finite_prime_avoidance_product_pos _ (fun _ hp => small_prime_pool_prime hp)).le
  apply nonprincipal_character_sum_le_class_errors _ χ hχ
  · have hlen : 0 ≤ (B : ℝ) - A := sub_nonneg.mpr (Nat.cast_le.mpr hAB)
    positivity
  · intro a ha
    have hu : a.val.Coprime r := (ZMod.isUnit_iff_coprime a.val r).mp (by simpa using ha)
    have hbound := hcount A B r a.val hz hAB hrpos hu hpf hh heven
    have hset : ((Ioc A B).filter (fun n : ℕ => ∀ p ∈ n.primeFactors, z < (p : ℝ))).filter
          (fun n : ℕ => (n : ZMod r) = a) =
        (Ioc A B).filter (fun n : ℕ => n % r = a.val % r ∧
          ∀ p ∈ n.primeFactors, z < (p : ℝ)) := by
      rw [filter_filter]
      apply filter_congr
      intro n _
      have hres : (n : ZMod r) = a ↔ n % r = a.val % r := by
        conv_lhs => rhs; rw [← ZMod.natCast_zmod_val a]
        exact ZMod.natCast_eq_natCast_iff' n a.val r
      rw [hres, and_comm]
    simpa only [hset] using hbound

end Bounty
end

section

/- Finite-prime Chinese remainder counting with an arbitrary base modulus. -/

open Finset

namespace Bounty

noncomputable def natPairSieveResidues (m : ℕ) (A : Finset (ℕ × ℕ))
    (P : Finset ℕ) (B : ℕ → Finset (ℕ × ℕ)) : Finset (ℕ × ℕ) := by
  classical
  exact (Finset.product (range (m * ∏ p ∈ P, p)) (range (m * ∏ p ∈ P, p))).filter
    (fun v => (v.1 % m, v.2 % m) ∈ A ∧ ∀ p ∈ P, (v.1 % p, v.2 % p) ∈ B p)

theorem nat_pair_sieve_residues_bounds (m : ℕ) (A : Finset (ℕ × ℕ))
    (P : Finset ℕ) (B : ℕ → Finset (ℕ × ℕ)) {v : ℕ × ℕ}
    (hv : v ∈ natPairSieveResidues m A P B) :
    v.1 < m * ∏ p ∈ P, p ∧ v.2 < m * ∏ p ∈ P, p := by
  have h := (mem_filter.mp hv).1
  simpa only [Finset.product_eq_sprod, mem_product, mem_range] using h

theorem nat_pair_sieve_residues_mod (m : ℕ) (A : Finset (ℕ × ℕ))
    (P : Finset ℕ) (B : ℕ → Finset (ℕ × ℕ)) (hN : 0 < m * ∏ p ∈ P, p)
    (v : ℕ × ℕ) :
    (v.1 % (m * ∏ p ∈ P, p), v.2 % (m * ∏ p ∈ P, p)) ∈ natPairSieveResidues m A P B ↔
      (v.1 % m, v.2 % m) ∈ A ∧ ∀ p ∈ P, (v.1 % p, v.2 % p) ∈ B p := by
  classical
  have hm : m ∣ m * ∏ p ∈ P, p := dvd_mul_right _ _
  have hp : ∀ p ∈ P, p ∣ m * ∏ q ∈ P, q := by
    intro p hp
    exact (dvd_prod_of_mem (fun q : ℕ => q) hp).trans (dvd_mul_left _ _)
  simp only [natPairSieveResidues, mem_filter, Finset.product_eq_sprod, mem_product, mem_range,
    Nat.mod_lt _ hN, and_self, true_and, Nat.mod_mod_of_dvd _ hm]
  apply and_congr_right
  intro _
  apply forall_congr'
  intro p
  apply imp_congr_right
  intro hpP
  rw [Nat.mod_mod_of_dvd _ (hp p hpP), Nat.mod_mod_of_dvd _ (hp p hpP)]

theorem nat_pair_sieve_residues_card (m : ℕ) (hm : 0 < m) (A : Finset (ℕ × ℕ))
    (hA : ∀ v ∈ A, v.1 < m ∧ v.2 < m) (P : Finset ℕ) (B : ℕ → Finset (ℕ × ℕ))
    (hP : ∀ p ∈ P, p.Prime) (hPm : ∀ p ∈ P, ¬p ∣ m)
    (hB : ∀ p ∈ P, ∀ v ∈ B p, v.1 < p ∧ v.2 < p) :
    (natPairSieveResidues m A P B).card = A.card * ∏ p ∈ P, (B p).card := by
  classical
  induction P using Finset.induction_on with
  | empty =>
    have heq : natPairSieveResidues m A ∅ B = A := by
      ext v
      simp only [natPairSieveResidues, prod_empty, mul_one, mem_filter,
        Finset.product_eq_sprod, mem_product, mem_range, notMem_empty, false_implies,
        forall_const, and_true]
      constructor
      · rintro ⟨⟨hv1, hv2⟩, hv⟩
        simpa only [Nat.mod_eq_of_lt hv1, Nat.mod_eq_of_lt hv2, Prod.mk.eta] using hv
      · intro hv
        obtain ⟨hv1, hv2⟩ := hA v hv
        exact ⟨⟨hv1, hv2⟩, by simpa only [Nat.mod_eq_of_lt hv1, Nat.mod_eq_of_lt hv2, Prod.mk.eta] using hv⟩
    simp only [heq, prod_empty, mul_one]
  | @insert p P hpnot ih =>
    have hp := hP p (mem_insert_self _ _)
    have hP' : ∀ q ∈ P, q.Prime := fun q hq => hP q (mem_insert_of_mem hq)
    have hPm' : ∀ q ∈ P, ¬q ∣ m := fun q hq => hPm q (mem_insert_of_mem hq)
    have hB' : ∀ q ∈ P, ∀ v ∈ B q, v.1 < q ∧ v.2 < q :=
      fun q hq => hB q (mem_insert_of_mem hq)
    have hN : 0 < m * ∏ q ∈ P, q := mul_pos hm (prod_pos (fun q hq => (hP' q hq).pos))
    have hmp : m.Coprime p := (hp.coprime_iff_not_dvd.mpr (hPm p (mem_insert_self _ _))).symm
    have hprod : (∏ q ∈ P, q).Coprime p := by
      apply Nat.Coprime.prod_left
      intro q hq
      apply (Nat.coprime_primes (hP' q hq) hp).mpr
      intro heq
      exact hpnot (heq ▸ hq)
    have hcop : (m * ∏ q ∈ P, q).Coprime p := hmp.mul_left hprod
    have hcard := nat_residue_pair_crt_card (m * ∏ q ∈ P, q) p hN hp.pos hcop
      (natPairSieveResidues m A P B) (B p)
      (fun _ hv => nat_pair_sieve_residues_bounds m A P B hv)
      (hB p (mem_insert_self _ _))
    have hperiod : m * ∏ q ∈ insert p P, q = (m * ∏ q ∈ P, q) * p := by
      rw [prod_insert hpnot]
      ring
    have heq : natPairSieveResidues m A (insert p P) B =
        (Finset.product (range ((m * ∏ q ∈ P, q)*p)) (range ((m * ∏ q ∈ P, q)*p))).filter
          (fun v : ℕ × ℕ =>
            (v.1 % (m * ∏ q ∈ P, q), v.2 % (m * ∏ q ∈ P, q)) ∈ natPairSieveResidues m A P B ∧
            (v.1 % p, v.2 % p) ∈ B p) := by
      conv_lhs => unfold natPairSieveResidues
      rw [hperiod]
      apply filter_congr
      intro v _
      rw [nat_pair_sieve_residues_mod m A P B hN v]
      simp only [mem_insert, forall_eq_or_imp]
      tauto
    rw [heq, hcard, ih hP' hPm' hB', prod_insert hpnot]
    ring

end Bounty
end

section

/- A uniform Euler-product bound for the pair sieve with arbitrary local flags. -/

open Finset

namespace Bounty

theorem pair_sieve_local_factor_le {p : ℕ} (hp : 3 ≤ p) (rough banned : Bool) :
    1 - pairSieveDensity p rough banned ≤
      (if rough then (1 - 1/(p : ℝ))^2 else 1) *
      (if banned then (1 - 1/(p : ℝ)) else 1) * (1 + 2/(p : ℝ)^2) := by
  have hpR : (3 : ℝ) ≤ p := Nat.cast_le.mpr hp
  have hp0 : (0 : ℝ) < p := by linarith
  have ha : 0 ≤ 1 - 1/(p : ℝ) := sub_nonneg.mpr ((div_le_one hp0).mpr (by linarith))
  have hc : (1 : ℝ) ≤ 1 + 2/(p : ℝ)^2 := le_add_of_nonneg_right (by positivity)
  cases rough <;> cases banned
  · simpa [pairSieveDensity] using hc
  · simpa using pair_sieve_banned_factor_le hp
  · rw [pair_sieve_unbanned_rough_factor p (by omega)]
    simpa using mul_le_mul_of_nonneg_left hc (sq_nonneg (1 - 1/(p : ℝ)))
  · calc
      _ ≤ (1 - 1/(p : ℝ))^3 := pair_sieve_banned_rough_factor_le hp
      _ = (1 - 1/(p : ℝ))^2 * (1 - 1/(p : ℝ)) := by ring
      _ ≤ _ := by
        simpa using mul_le_mul_of_nonneg_left hc (mul_nonneg (sq_nonneg _) ha)

theorem pair_sieve_euler_product_le (P : Finset ℕ) (hP : ∀ p ∈ P, 3 ≤ p)
    (rough banned : ℕ → Bool) :
    (∏ p ∈ P, (1 - pairSieveDensity p (rough p) (banned p))) ≤
      4 * (∏ p ∈ P.filter (fun p => rough p = true), (1 - 1/(p : ℝ)))^2 *
        (∏ p ∈ P.filter (fun p => banned p = true), (1 - 1/(p : ℝ))) := by
  let a := fun p : ℕ => 1 - 1/(p : ℝ)
  have ha : ∀ p ∈ P, 0 ≤ a p := by
    intro p hp
    have hpR : (3 : ℝ) ≤ p := Nat.cast_le.mpr (hP p hp)
    exact sub_nonneg.mpr ((div_le_one (by linarith)).mpr (by linarith))
  have hbound : (∏ p ∈ P, (1 - pairSieveDensity p (rough p) (banned p))) ≤
      (∏ p ∈ P, (if rough p then (a p)^2 else 1) *
        (if banned p then a p else 1) * (1 + 2/(p : ℝ)^2)) := by
    apply prod_le_prod₀
    · intro p hp
      have hb := (pair_sieve_density_bounds (hP p hp) (rough p) (banned p)).2.1
      linarith
    · intro p hp
      exact pair_sieve_local_factor_le (hP p hp) (rough p) (banned p)
  have hr : (∏ p ∈ P, (if rough p then (a p)^2 else 1)) =
      (∏ p ∈ P.filter (fun p => rough p = true), a p)^2 := by
    rw [← prod_pow, prod_filter]
  have hb : (∏ p ∈ P, (if banned p then a p else 1)) =
      ∏ p ∈ P.filter (fun p => banned p = true), a p := by rw [prod_filter]
  rw [prod_mul_distrib, prod_mul_distrib, hr, hb] at hbound
  have hnonneg : 0 ≤ (∏ p ∈ P.filter (fun p => rough p = true), a p)^2 *
      ∏ p ∈ P.filter (fun p => banned p = true), a p :=
    mul_nonneg (sq_nonneg _) (prod_nonneg (fun p hp => ha p (mem_filter.mp hp).1))
  have hc := finite_pair_euler_correction_le_four P (fun p hp => (by decide : 2 ≤ 3).trans (hP p hp))
  exact hbound.trans ((mul_le_mul_of_nonneg_left hc hnonneg).trans_eq (by ring))

end Bounty
end

section

/- Explicit correction products for primes omitted from the pair sieve. -/

open Finset

namespace Bounty

theorem avoidance_factor_bounds {p : ℕ} (hp : 2 ≤ p) :
    0 < 1 - 1/(p : ℝ) ∧ 1 - 1/(p : ℝ) ≤ 1 := by
  have hpR : (2 : ℝ) ≤ p := Nat.cast_le.mpr hp
  have hp0 : (0 : ℝ) < p := by linarith
  constructor
  · exact sub_pos.mpr ((div_lt_one hp0).mpr (by linarith))
  · exact sub_le_self _ (by positivity)

theorem inverse_avoidance_union_le (P Q : Finset ℕ)
    (hP : ∀ p ∈ P, 2 ≤ p) (hQ : ∀ p ∈ Q, 2 ≤ p) :
    (∏ p ∈ P ∪ Q, (1 - 1/(p : ℝ))⁻¹) ≤
      (∏ p ∈ P, (1 - 1/(p : ℝ))⁻¹) * (∏ p ∈ Q, (1 - 1/(p : ℝ))⁻¹) := by
  have h0 : 0 ≤ ∏ p ∈ P ∪ Q, (1 - 1/(p : ℝ))⁻¹ := by
    apply prod_nonneg
    intro p hp
    have hp2 := (mem_union.mp hp).elim (hP p) (hQ p)
    exact inv_nonneg.mpr (avoidance_factor_bounds hp2).1.le
  have h1 : 1 ≤ ∏ p ∈ P ∩ Q, (1 - 1/(p : ℝ))⁻¹ := by
    apply one_le_prod₀
    intro p hp
    have hb := avoidance_factor_bounds (hP p (mem_inter.mp hp).1)
    exact (one_le_inv₀ hb.1).mpr hb.2
  calc
    _ = (∏ p ∈ P ∪ Q, (1 - 1/(p : ℝ))⁻¹) * 1 := by ring
    _ ≤ (∏ p ∈ P ∪ Q, (1 - 1/(p : ℝ))⁻¹) *
        (∏ p ∈ P ∩ Q, (1 - 1/(p : ℝ))⁻¹) := mul_le_mul_of_nonneg_left h1 h0
    _ = _ := prod_union_inter

theorem inverse_avoidance_insert_two_le (P : Finset ℕ) (hP : ∀ p ∈ P, 2 ≤ p) :
    (∏ p ∈ insert 2 P, (1 - 1/(p : ℝ))⁻¹) ≤
      2 * (∏ p ∈ P, (1 - 1/(p : ℝ))⁻¹) := by
  have h := inverse_avoidance_union_le {2} P (by simp) hP
  norm_num at h
  simpa only [one_div, prod_inv_distrib] using h

theorem finite_avoidance_omission_bound (P Q E : Finset ℕ)
    (hP : ∀ p ∈ P, 2 ≤ p) (hQ : ∀ p ∈ Q, 2 ≤ p) (hE : ∀ p ∈ E, 2 ≤ p)
    (hcover : Q \ E ⊆ P) :
    (∏ p ∈ P, (1 - 1/(p : ℝ))) ≤
      (∏ p ∈ Q, (1 - 1/(p : ℝ))) * (∏ p ∈ E, (1 - 1/(p : ℝ))⁻¹) := by
  let a := fun p : ℕ => 1 - 1/(p : ℝ)
  have hfirst : (∏ p ∈ P, a p) ≤ ∏ p ∈ Q \ E, a p :=
    prod_le_prod_of_subset_of_le_one₀ hcover (fun p hp => (avoidance_factor_bounds (hP p hp)).1.le)
      (fun p hp _ => (avoidance_factor_bounds (hP p hp)).2)
  have hpart : (∏ p ∈ Q \ E, a p) * (∏ p ∈ Q ∩ E, a p) = ∏ p ∈ Q, a p := by
    have hset : Q \ (Q ∩ E) = Q \ E := by ext p; simp
    rw [← hset]
    exact prod_sdiff inter_subset_left
  have hnz : (∏ p ∈ Q ∩ E, a p) ≠ 0 := by
    exact ne_of_gt (prod_pos (fun p hp => (avoidance_factor_bounds (hQ p (mem_inter.mp hp).1)).1))
  have heq : (∏ p ∈ Q \ E, a p) = (∏ p ∈ Q, a p) * (∏ p ∈ Q ∩ E, (a p)⁻¹) := by
    rw [prod_inv_distrib, ← hpart, mul_assoc, mul_inv_cancel₀ hnz, mul_one]
  have hlast : (∏ p ∈ Q ∩ E, (a p)⁻¹) ≤ ∏ p ∈ E, (a p)⁻¹ := by
    apply prod_le_prod_of_subset_of_one_le₀ inter_subset_right
    · intro p hp
      exact inv_nonneg.mpr (avoidance_factor_bounds (hE p (mem_inter.mp hp).2)).1.le
    · intro p hp _
      have hb := avoidance_factor_bounds (hE p hp)
      exact (one_le_inv₀ hb.1).mpr hb.2
  rw [heq] at hfirst
  exact hfirst.trans (mul_le_mul_of_nonneg_left hlast
    (prod_nonneg (fun p hp => (avoidance_factor_bounds (hQ p hp)).1.le)))

end Bounty
end

section

/- Exact auxiliary-draw expansion of the signed prime comparison kernel.
The target fresh law occurs once, while the A and B ideal factors use their
original target and source arguments respectively. -/

open Finset
open scoped Classical

namespace Bounty

theorem prime_asymmetric_comparison_kernel_eq_aux_sum
    {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ) (active : Finset I)
    (Q : ℕ) (h : ℝ) (keptA keptB : Finset I → Finset ℤ) (ζ Θ : ℝ)
    (A B : Finset I) (x y : ∀ i, P i) :
    primeAsymmetricComparisonKernel P V active Q h keptA keptB ζ Θ A B x y =
      if finiteSharedCompatible (active \ (A ∪ B)) x y then
        ∑ d : ∀ i : A, P i.val, ∑ e : ∀ i : B, P i.val,
          ((finiteProductWeight (physicalLabelLaw
              (P := fun i : A => P i.val) (fun i => V i.val)) d *
            finiteProductWeight (physicalLabelLaw
              (P := fun i : B => P i.val) (fun i => V i.val)) e *
            finiteFreshMass (physicalLabelLaw V) (active \ (A ∪ B)) y : ℝ) : ℂ) *
          (primeProductIdealKernel (fun i : A => P i.val) (fun i => V i.val)
              Q h (keptA A) d (finiteCoordinateRestrict A y) *
            primeProductIdealKernel (fun i : B => P i.val) (fun i => V i.val)
              Q h (keptB B) e (finiteCoordinateRestrict B x)) *
          physicalPhase ζ ((∏ i : ↥(active \ (A ∪ B)), (x i.val).val) *
            (∏ i : A, (d i).val) * (∏ i : B, (e i).val)) *
          physicalReturnPhase Θ (((∏ i : ↥(active \ (A ∪ B)), (x i.val).val) *
            (∏ i : A, (d i).val) * (∏ i : B, (e i).val) : ℕ) : ℤ)
      else 0 := by
  unfold primeAsymmetricComparisonKernel finiteAsymmetricComparisonKernel
    finiteAsymmetricKernel
  split_ifs
  · dsimp only
    rw [prime_asymmetric_value_eq_sum]
    simp only [mul_sum]
    apply sum_congr rfl
    intro d _
    apply sum_congr rfl
    intro e _
    simp only [primeTuplePhase, finiteCoordinateRestrict, Complex.ofReal_mul]
    ring
  · rfl

end Bounty
end

section

/- The literal list coefficient for one asymmetric prime-comparison pattern.
Both original auxiliary tuples and the target/source orientation are retained. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def repeatedBigPrimeCoefficient
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (Q : ℕ) (h : ℝ) (keptA keptB : Finset ℤ)
    (source target : RepeatedBigLists P J ell)
    (aux : PhysicalAuxLabels P (repeatedBigAuxCut A B)) : ℂ :=
  primeProductIdealKernel (fun i : A => P i.val.1) (fun i => V i.val.1)
      Q h keptA (repeatedBigAuxSplitEquiv P A B hU hAB aux).1
      (finiteCoordinateRestrict A (repeatedBigFlatEquiv P J ell target)) *
    primeProductIdealKernel (fun i : B => P i.val.1) (fun i => V i.val.1)
      Q h keptB (repeatedBigAuxSplitEquiv P A B hU hAB aux).2
      (finiteCoordinateRestrict B (repeatedBigFlatEquiv P J ell source))

theorem repeated_big_prime_coefficient_split
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (Q : ℕ) (h : ℝ) (keptA keptB : Finset ℤ)
    (source target : RepeatedBigLists P J ell)
    (a : ∀ i : A, P i.val.1) (b : ∀ i : B, P i.val.1) :
    repeatedBigPrimeCoefficient P V A B hU hAB Q h keptA keptB source target
        ((repeatedBigAuxSplitEquiv P A B hU hAB).symm (a, b)) =
      primeProductIdealKernel (fun i : A => P i.val.1) (fun i => V i.val.1)
        Q h keptA a (finiteCoordinateRestrict A (repeatedBigFlatEquiv P J ell target)) *
      primeProductIdealKernel (fun i : B => P i.val.1) (fun i => V i.val.1)
        Q h keptB b (finiteCoordinateRestrict B (repeatedBigFlatEquiv P J ell source)) := by
  simp only [repeatedBigPrimeCoefficient, Equiv.apply_symm_apply]

theorem repeated_big_prime_coefficient_norm_le
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (Q : ℕ) (h : ℝ) (keptA keptB : Finset ℤ)
    {ξ : ℝ} (hξ : 0 < ξ)
    (hkeptA : ∀ d ∈ keptA, ξ ≤ finiteCellMass
      (finiteProductWeight (physicalLabelLaw (P := fun i : A => P i.val.1) (fun i => V i.val.1)))
      (fun x => upperLogCell h (Real.log (∏ i : A, (x i).val : ℕ))) d)
    (hkeptB : ∀ d ∈ keptB, ξ ≤ finiteCellMass
      (finiteProductWeight (physicalLabelLaw (P := fun i : B => P i.val.1) (fun i => V i.val.1)))
      (fun x => upperLogCell h (Real.log (∏ i : B, (x i).val : ℕ))) d)
    (source target : RepeatedBigLists P J ell)
    (aux : PhysicalAuxLabels P (repeatedBigAuxCut A B)) :
    ‖repeatedBigPrimeCoefficient P V A B hU hAB Q h keptA keptB source target aux‖ ≤
      ((Q * Q : ℕ) / ξ) ^ 2 := by
  unfold repeatedBigPrimeCoefficient
  rw [norm_mul, pow_two]
  apply mul_le_mul
    (prime_ideal_kernel_norm_le _ _ Q h keptA hξ hkeptA _ _)
    (prime_ideal_kernel_norm_le _ _ Q h keptB hξ hkeptB _ _)
    (norm_nonneg _)
  positivity

end Bounty
end

section

/- The existing ledger-forgetting equivalence preserves every birth payload. -/

namespace Bounty

theorem full_mixed_ledger_birth_projection
    {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, DecidableEq (P g)]
    (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
    (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K)))
    (H : (g : Fin N) → Finset (P g))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullMixedLedgerPath n S B A Δ D steps (H, x))
    (a : FullMixedBirthAddress S B steps) :
    fullMixedLedgerPathBornData n S B A Δ D steps (H, x) p a =
      fullMixedPathBornData n S B A Δ D steps x
        (finiteLedgerEventPathEquiv (FullPermutationMixedEvent n S B A Δ D)
          (fullPermutationMixedEventTarget n S B A Δ D)
          (fullMixedLedgerUpdate n S B A Δ D) steps H x p) a := by
  have h := finite_ledger_event_path_occurrence (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D)
    (fullMixedLedgerUpdate n S B A Δ D) steps H x p a.1
  exact congrArg
    (fun e => fullMixedEventBornData n S B A Δ D (steps.get a.1) e.1 e.2 a.2) h

end Bounty
end

section

/- The actual path's forest factor at one operation reads only its own event. -/

namespace Bounty

theorem full_mixed_birth_forest_operation_local
    {J K : Type*} {N m : ℕ} {P : Fin N → Type*}
    (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
    (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K)))
    (index : Fin m → FullMixedBirthAddress S B steps)
    (code : BirthForestCode m) (θ : (Fin m × Fin m) → ℝ)
    (value : ((g : Fin N) × P g) → ℤ)
    (x y : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x)
    (q : FullPermutationMixedPath n S B A Δ D steps y)
    (i : Fin steps.length)
    (h : finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x p i =
      finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps y q i) :
    birthForestOperationMultiplier code (fun j => (index j).1) θ
      (fun j => fullMixedPathBirthPerformed n S B A Δ D steps x p (index j))
      (fun j => ((fullMixedPathBirthLabel n S B A Δ D steps x p (index j)).map value).getD 0) i =
    birthForestOperationMultiplier code (fun j => (index j).1) θ
      (fun j => fullMixedPathBirthPerformed n S B A Δ D steps y q (index j))
      (fun j => ((fullMixedPathBirthLabel n S B A Δ D steps y q (index j)).map value).getD 0) i := by
  apply birth_forest_operation_multiplier_congr_on_owner
  · intro j hj
    change (index j).1 = i at hj
    subst i
    apply full_mixed_path_birth_performed_local
    exact h
  · intro j hj
    change (index j).1 = i at hj
    subst i
    have hl := full_mixed_path_birth_label_local n S B A Δ D steps x y p q (index j)
      h
    rw [hl]

end Bounty
end

section

/- Actual microscopic assignment products have the small size required by the pair sieve. -/

open Finset Filter
open scoped Topology

namespace Bounty

theorem eventually_candidate_P_mark_product_small {c η : ℝ} (hc : 0 < c) (hη : 0 < η) :
    ∀ᶠ L : ℝ in atTop, ∀ x : ∀ g : candidatePIndices c L, candidatePBand (c*L) g.val,
      (∏ g, ((x g).val : ℝ)) ≤ Real.exp (η*L) := by
  obtain ⟨v, V, _, _, hpool⟩ := exists_candidate_P_pool_bounds hc
  filter_upwards [hpool, eventually_mul_rpow_log_add_le_rpow (a := (2/5 : ℝ)) (b := 1)
    (by norm_num) (by norm_num) hη (2/(5*Real.log 2)) 0] with L hL hsmall
  have hL0 : 0 ≤ L := zero_le_one.trans hL.1
  intro x
  have hpoint : ∀ g : candidatePIndices c L, ((x g).val : ℝ) ≤ Real.exp (L^(2/5 : ℝ)) :=
    fun g => ((hL.2.2.2.2.2 g.val g.property).2.2 (x g).val (x g).property).2.2
  have hexp : ((candidatePIndices c L).card : ℝ) * L^(2/5 : ℝ) ≤ η*L := by
    have h := mul_le_mul_of_nonneg_right hL.2.2.2.1 (Real.rpow_nonneg hL0 (2/5 : ℝ))
    norm_num only [add_zero, Real.rpow_one] at hsmall
    nlinarith only [h, hsmall]
  calc
    _ ≤ ∏ _g : candidatePIndices c L, Real.exp (L^(2/5 : ℝ)) :=
      Finset.prod_le_prod₀ (fun _ _ => Nat.cast_nonneg _) (fun g _ => hpoint g)
    _ = Real.exp (((candidatePIndices c L).card : ℝ) * L^(2/5 : ℝ)) := by
      rw [← Real.exp_sum]
      simp
    _ ≤ _ := Real.exp_le_exp.mpr hexp

theorem eventually_candidate_micro_assignment_product_bound {c η : ℝ}
    (hc : 0 < c) (hη : 0 < η) (r J : ℕ) :
    ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ,
      ∀ x : ∀ i, candidateMicroAssignmentChoices c L r jStar J i,
        (orderedSlotProduct (candidateMicroAssignmentChoices c L r jStar J) x : ℝ) ≤
          Real.exp ((((12/5 : ℝ)*(r : ℝ)*c/(2 : ℝ)^J)+η)*L) := by
  filter_upwards [eventually_candidate_P_mark_product_small hc hη, eventually_ge_atTop (0 : ℝ)] with L hP hL
  intro jStar x
  let xQ : ∀ i, candidateMicroQSlotChoices c L r jStar J i := fun i => x (Sum.inl i)
  let xP : ∀ g : candidatePIndices c L, candidatePBand (c*L) g.val := fun g => x (Sum.inr g)
  have hQ := candidate_micro_Q_product_upper (mul_nonneg hc.le hL) r jStar J xQ
  have hp := hP xP
  have hsplit : (orderedSlotProduct (candidateMicroAssignmentChoices c L r jStar J) x : ℝ) =
      (orderedSlotProduct (candidateMicroQSlotChoices c L r jStar J) xQ : ℝ) *
        (∏ g, ((xP g).val : ℝ)) := by
    simp only [orderedSlotProduct, Fintype.prod_sum_type, Nat.cast_mul, Nat.cast_prod, xQ, xP]
  rw [hsplit]
  calc
    _ ≤ Real.exp (((12/5 : ℝ)*(r : ℝ)*c/(2 : ℝ)^J)*L) * Real.exp (η*L) :=
      mul_le_mul hQ hp (prod_nonneg (fun _ _ => Nat.cast_nonneg _)) (Real.exp_pos _).le
    _ = _ := by rw [← Real.exp_add]; congr 1; ring

theorem eventually_candidate_micro_assignment_size {c : ℝ} (hc : 0 < c) (r J : ℕ)
    (hJ : (12/5 : ℝ)*(r : ℝ)*c/(2 : ℝ)^J ≤ 1/25) :
    ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ,
      ∀ x : ∀ i, candidateMicroAssignmentChoices c L r jStar J i,
        (orderedSlotProduct (candidateMicroAssignmentChoices c L r jStar J) x : ℝ) ≤
          Real.exp ((1/20 : ℝ)*L) := by
  filter_upwards [eventually_candidate_micro_assignment_product_bound hc (by norm_num : (0 : ℝ)<1/100) r J,
    eventually_ge_atTop (0 : ℝ)] with L hL hpos
  intro jStar x
  apply (hL jStar x).trans
  apply Real.exp_le_exp.mpr
  exact mul_le_mul_of_nonneg_right (by linarith) hpos

end Bounty
end

section

/- A shared-coordinate raw row integrates its normalized fresh coordinates
exactly, and becomes a diagonal pairing after tail averaging. -/

open Finset
open scoped Classical

namespace Bounty

theorem finite_shared_fresh_mass_sum {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hmass : ∀ i, ∑ v, μ i v = 1) (active : Finset I) (x : ∀ i, X i) :
    (∑ y, if finiteSharedCompatible active x y then finiteFreshMass μ active y else 0) = 1 := by
  let a := fun i (v : X i) => if i ∈ active then (if x i = v then (1 : ℝ) else 0) else μ i v
  have he (y : ∀ i, X i) :
      (if finiteSharedCompatible active x y then finiteFreshMass μ active y else 0) =
        ∏ i, a i (y i) := by
    by_cases hxy : finiteSharedCompatible active x y
    · rw [if_pos hxy, ← prod_mul_prod_compl active]
      have ha : (∏ i ∈ active, a i (y i)) = 1 := by
        apply prod_eq_one
        intro i hi
        simp only [a, if_pos hi, if_pos (hxy i hi)]
      rw [ha, one_mul]
      apply prod_congr rfl
      intro i hi
      simp only [a, if_neg (mem_compl.mp hi)]
    · rw [if_neg hxy]
      symm
      obtain ⟨i, hi, hne⟩ : ∃ i ∈ active, x i ≠ y i := by
        simpa only [finiteSharedCompatible, not_forall, exists_prop] using hxy
      apply prod_eq_zero (mem_univ i)
      simp only [a, if_pos hi, if_neg hne]
  simp_rw [he]
  rw [← Fintype.prod_sum]
  apply prod_eq_one
  intro i _
  by_cases hi : i ∈ active
  · simp [a, hi]
  · simpa only [a, if_neg hi] using hmass i

theorem finite_shared_raw_pairing_of_invariant {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hmass : ∀ i, ∑ v, μ i v = 1) (active : Finset I)
    (k f g : (∀ i, X i) → ℂ)
    (hg : ∀ i ∉ active, ∀ x v, g (Function.update x i v) = g x) :
    cleanKernelPairing (finiteProductWeight μ)
        (fun x y => if finiteSharedCompatible active x y then
          (finiteFreshMass μ active y : ℂ) * k x else 0) f g =
      cleanRawPairing (finiteProductWeight μ) k f g := by
  unfold cleanKernelPairing cleanRawPairing
  apply sum_congr rfl
  intro x _
  have hrow := finite_shared_fresh_mass_sum μ hmass active x
  have hrowc : (∑ y, if finiteSharedCompatible active x y then
      (finiteFreshMass μ active y : ℂ) else 0) = 1 := by
    simpa only [Complex.ofReal_sum, apply_ite, Complex.ofReal_zero, Complex.ofReal_one]
      using congrArg Complex.ofReal hrow
  calc
    _ = ((finiteProductWeight μ x : ℂ) * starRingEnd ℂ (f x) * g x * k x) *
        ∑ y, if finiteSharedCompatible active x y then (finiteFreshMass μ active y : ℂ) else 0 := by
      rw [mul_sum]
      apply sum_congr rfl
      intro y _
      dsimp only
      by_cases hxy : finiteSharedCompatible active x y
      · have hgy : g y = g x := finite_function_eq_of_coordinate_invariance active g hg y x
          (fun i hi => (hxy i hi).symm)
        simp only [if_pos hxy, hgy]
        ring
      · simp only [if_neg hxy, mul_zero, zero_mul]
    _ = _ := by rw [hrowc, mul_one]

theorem finite_shared_raw_pairing_tail_average {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hmass : ∀ i, ∑ v, μ i v = 1) (active : Finset I)
    (k f g : (∀ i, X i) → ℂ) :
    cleanKernelPairing (finiteProductWeight μ)
        (fun x y => if finiteSharedCompatible active x y then
          (finiteFreshMass μ active y : ℂ) * k x else 0)
        (finiteCoordinateComponent μ ∅ activeᶜ.toList f)
        (finiteCoordinateComponent μ ∅ activeᶜ.toList g) =
      cleanRawPairing (finiteProductWeight μ) k
        (finiteCoordinateComponent μ ∅ activeᶜ.toList f)
        (finiteCoordinateComponent μ ∅ activeᶜ.toList g) := by
  apply finite_shared_raw_pairing_of_invariant μ hmass
  intro i hi x v
  exact finite_component_missing_invariant μ hmass activeᶜ ∅ i
    (by simp only [sdiff_empty, mem_compl]; exact hi) g x v

end Bounty
end

section

/- The original full paths, indexed by the chronological birth-address equivalence. -/

namespace Bounty

variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
    (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
    (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K)))

noncomputable def fullMixedIndexedBirthOwner
    (i : Fin (Fintype.card (FullMixedBirthAddress S B steps))) : Fin steps.length :=
  fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i)

noncomputable def fullMixedIndexedBirthPerformed
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x)
    (i : Fin (Fintype.card (FullMixedBirthAddress S B steps))) : Prop :=
  fullMixedPathBirthPerformed n S B A Δ D steps x p (fullMixedBirthOrder S B steps i)

noncomputable def fullMixedIndexedBirthValue (encode : ((g : Fin N) × P g) → ℤ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x)
    (i : Fin (Fintype.card (FullMixedBirthAddress S B steps))) : ℤ :=
  ((fullMixedPathBirthLabel n S B A Δ D steps x p
    (fullMixedBirthOrder S B steps i)).map encode).getD 0

theorem full_mixed_indexed_birth_owner_monotone :
    Monotone (fullMixedIndexedBirthOwner S B steps) :=
  full_mixed_birth_order_owner_monotone S B steps

theorem full_mixed_path_birth_performed_iff_label_present
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x)
    (a : FullMixedBirthAddress S B steps) :
    fullMixedPathBirthPerformed n S B A Δ D steps x p a ↔
      (fullMixedPathBirthLabel n S B A Δ D steps x p a).isSome = true := by
  simp only [fullMixedPathBirthPerformed, fullMixedPathBirthLabel, Option.isSome_map]

theorem full_mixed_indexed_birth_distinct_iff
    (encode : ((g : Fin N) × P g) → ℤ) (hencode : Function.Injective encode)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x) :
    birthValuesDistinct (fullMixedIndexedBirthPerformed n S B A Δ D steps x p)
      (fullMixedIndexedBirthValue n S B A Δ D steps encode x p) ↔
      Set.InjOn (fullMixedPathBirthLabel n S B A Δ D steps x p)
        {a | fullMixedPathBirthPerformed n S B A Δ D steps x p a} :=
  birth_values_distinct_option_equiv_iff (fullMixedBirthOrder S B steps)
    (fullMixedPathBirthLabel n S B A Δ D steps x p)
    (fullMixedPathBirthPerformed n S B A Δ D steps x p)
    (full_mixed_path_birth_performed_iff_label_present n S B A Δ D steps x p)
    encode hencode

end Bounty

namespace Bounty

theorem full_mixed_indexed_birth_distinct_iff_same_some
    {J K : Type*} {N : ℕ} {P : Fin N → Type*}
    (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
    (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K)))
    (encode : ((g : Fin N) × P g) → ℤ) (hencode : Function.Injective encode)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x) :
    birthValuesDistinct (fullMixedIndexedBirthPerformed n S B A Δ D steps x p)
      (fullMixedIndexedBirthValue n S B A Δ D steps encode x p) ↔
      ∀ a b z, fullMixedPathBirthLabel n S B A Δ D steps x p a = some z →
        fullMixedPathBirthLabel n S B A Δ D steps x p b = some z → a = b := by
  rw [full_mixed_indexed_birth_distinct_iff n S B A Δ D steps encode hencode x p]
  exact optional_label_injOn_iff_same_some _ _
    (full_mixed_path_birth_performed_iff_label_present n S B A Δ D steps x p)

end Bounty
