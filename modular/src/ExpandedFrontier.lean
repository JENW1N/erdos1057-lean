open scoped BigOperators Classical
theorem finite_projected_probe_tensor_energy {G : Type*} [Fintype G] [DecidableEq G]
    {I X : G → Type*} [∀ g, Fintype (I g)] [∀ g, DecidableEq (I g)] [∀ g, Fintype (X g)]
    (μ : ∀ g, X g → ℝ) (hμ : ∀ g x, 0 ≤ μ g x) (hmass : ∀ g, ∑ x, μ g x = 1)
    (A B : ∀ g, Finset (I g)) (hAB : ∀ g, Disjoint (A g) (B g)) (hm : ∀ g, 0 < (A g).card)
    (s : Finset G) (f : (∀ g, I g → X g) → ℂ) :
    finiteWeightedEnergy (finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g)))
      (finiteCoordinateFinsetAction (fun g v => finiteCoordinateComponent (fun _ : I g => μ g)
        (A g) (A g ∪ B g).toList (finiteSlotSymmetrize v)) s f) ≤
      (∏ g ∈ s, (((B g).card : ℝ) ^ (B g).card / ((A g).card : ℝ) ^ (B g).card)) *
        finiteWeightedEnergy (finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g))) f := by
  apply finite_coordinate_finset_energy_le
    (fun g => finiteProductWeight (fun _ : I g => μ g))
    (fun g x => Finset.prod_nonneg (fun i _ => hμ g (x i)))
    (fun g v => finiteCoordinateComponent (fun _ : I g => μ g)
      (A g) (A g ∪ B g).toList (finiteSlotSymmetrize v))
    (fun g => (((B g).card : ℝ) ^ (B g).card / ((A g).card : ℝ) ^ (B g).card))
    (fun _ => by positivity)
  intro g v
  exact finite_projected_probe_energy (μ g) (hμ g) (hmass g) (A g) (B g) (hAB g) (hm g) v
end

section
open scoped BigOperators Classical
def finiteGroupSlotSymmetric {G : Type*} [DecidableEq G] {I X : G → Type*}
    (g : G) (f : (∀ h, I h → X h) → ℂ) : Prop :=
  ∀ (σ : Equiv.Perm (I g)) x,
    f (Function.update x g (finiteSlotRelabel σ (x g))) = f x

theorem finite_group_section_symmetric {G : Type*} [DecidableEq G] {I X : G → Type*}
    (g : G) (f : (∀ h, I h → X h) → ℂ) (hf : finiteGroupSlotSymmetric g f)
    (x : ∀ h, I h → X h) (σ : Equiv.Perm (I g)) :
    finiteSlotPermute σ (fun y => f (Function.update x g y)) = fun y => f (Function.update x g y) := by
  funext y
  have h := hf σ (Function.update x g y)
  simpa only [Function.update_self, Function.update_idem, finiteSlotPermute] using h

theorem finite_group_symmetrized_lift_eq {G : Type*} [DecidableEq G] {I X : G → Type*}
    [∀ g, Fintype (I g)] [∀ g, DecidableEq (I g)]
    (g : G) (P : ((I g → X g) → ℂ) → (I g → X g) → ℂ)
    (f : (∀ h, I h → X h) → ℂ) (hf : finiteGroupSlotSymmetric g f) :
    finiteCoordinateLift g (fun v => P (finiteSlotSymmetrize v)) f = finiteCoordinateLift g P f := by
  funext x
  rw [finite_coordinate_lift_eq_update, finite_coordinate_lift_eq_update,
    finite_slot_symmetrize_eq_self _ (finite_group_section_symmetric g f hf x)]

theorem finite_group_compose_preserves_symmetry {G : Type*} [DecidableEq G]
    {I X : G → Type*} (g : G)
    (P : ∀ h, ((I h → X h) → ℂ) → (I h → X h) → ℂ)
    (is : List G) (hg : g ∉ is) (f : (∀ h, I h → X h) → ℂ)
    (hf : finiteGroupSlotSymmetric g f) :
    finiteGroupSlotSymmetric g (finiteCoordinateCompose P is f) := by
  intro σ x
  exact finite_coordinate_compose_preserves_invariance g (finiteSlotRelabel σ) P is hg f (hf σ) x

theorem finite_group_symmetrized_compose_eq {G : Type*} [DecidableEq G]
    {I X : G → Type*} [∀ g, Fintype (I g)] [∀ g, DecidableEq (I g)]
    (P : ∀ h, ((I h → X h) → ℂ) → (I h → X h) → ℂ)
    (is : List G) (hnodup : is.Nodup) (f : (∀ h, I h → X h) → ℂ)
    (hf : ∀ g, finiteGroupSlotSymmetric g f) :
    finiteCoordinateCompose (fun g v => P g (finiteSlotSymmetrize v)) is f =
      finiteCoordinateCompose P is f := by
  induction is with
  | nil => rfl
  | cons g is ih =>
    obtain ⟨hg, ht⟩ := List.nodup_cons.mp hnodup
    simp only [finiteCoordinateCompose, ih ht]
    exact finite_group_symmetrized_lift_eq g (P g) _
      (finite_group_compose_preserves_symmetry g P is hg f (hf g))
end

