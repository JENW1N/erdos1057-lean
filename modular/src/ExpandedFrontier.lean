  physicalSmallBigPathEventWeight n shared B A Δ D kbig ω μ qghost ρ
    (match tag with | some (.inl _) => Vghost | _ => Vedge) Vs qsmall tag s e

theorem physical_small_big_varying_ghost_weight_same (tag : Option (H ⊕ K))
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
