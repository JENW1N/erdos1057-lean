/- The original active block estimates imply the exact candidate-relative ambient errors. -/

open Finset Filter
namespace Bounty

theorem exists_candidate_ambient_error_from_blocks {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ)*(r : ℝ)*c = 1) :
    ∃ D : ℝ, 0 ≤ D ∧ ∃ J : ℕ, ∀ jStar : ℕ, J < jStar →
      ∀ᶠ L : ℝ in atTop,
      (∀ γ S a v : ℝ,
      (∀ i ∈ dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊),
        ∀ j ∈ dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊),
        let B := shiftedTypeIIBilinear (arithmeticProductWindow 1 (Real.exp L)) (candidateCoefficient c L q r jStar)
          (typeIIRestrict (dyadicNatBucket (Icc 1 ⌊33*Real.exp L⌋₊) i)
            (ambientRoughIntervalTypeIIAlpha γ L S a v))
          (typeIIRestrict (dyadicNatBucket (Icc 1 ⌊33*Real.exp L⌋₊) j)
            (ambientRoughTypeIIBeta (Real.exp (a*L)) (Real.exp (v*L))))
        B ≠ 0 → |B| ≤ Real.exp L * L^(-D)) →
        |ambientRoughProxyError (arithmeticProductWindow 1 (Real.exp L))
          (candidateCoefficient c L q r jStar) γ L S (Real.exp (a*L)) (Real.exp (v*L))| ≤
            candidateCoefficientWindowMass c L q r jStar*L^(-2 : ℝ)) ∧
      (∀ κ S : ℝ,
      (∀ proxy : Bool, ∀ i ∈ dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊),
        ∀ j ∈ dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊),
        let B := shiftedTypeIIBilinear (arithmeticProductWindow 1 (Real.exp L)) (candidateCoefficient c L q r jStar)
          (typeIIRestrict (dyadicNatBucket (Icc 1 ⌊33*Real.exp L⌋₊) i) (ambientPrimeTypeIIAlpha κ L S))
          (typeIIRestrict (dyadicNatBucket (Icc 1 ⌊33*Real.exp L⌋₊) j)
            (if proxy then ambientProxyTypeIIBeta κ L S else ambientPrimeTypeIIBeta κ L))
        B ≠ 0 → |B| ≤ Real.exp L * L^(-D)) →
        |ambientPrimeProxyError (arithmeticProductWindow 1 (Real.exp L))
          (candidateCoefficient c L q r jStar) κ L S| ≤
            candidateCoefficientWindowMass c L q r jStar*L^(-2 : ℝ)) := by
  obtain ⟨E, hE, J, hmass⟩ := exists_candidate_error_mass_exponent hc hr hq0 hq1 hcenter
  refine ⟨E+5, by linarith, J, ?_⟩
  intro jStar hj
  filter_upwards [hmass jStar hj,eventually_ambient_rough_error_of_active_blocks (E+1),
    eventually_ambient_prime_error_of_active_blocks E,eventually_ge_atTop (1 : ℝ)]
    with L hmass hrough hprime hL
  constructor
  · intro γ S a v hblocks
    apply hmass
    have hb := hrough (candidateCoefficient c L q r jStar) γ S a v
      (by simpa only [show E+1+4=E+5 by ring] using hblocks)
    apply hb.trans
    exact mul_le_mul_of_nonneg_left
      (Real.rpow_le_rpow_of_exponent_le hL (by linarith : -(E+1) ≤ -E)) (Real.exp_pos L).le
  · intro κ S hblocks
    exact hmass _ (hprime (candidateCoefficient c L q r jStar) κ S hblocks)

end Bounty
end

section

/- Exact small-factor transport onto the original effective big path family,
including the inverse path map used by the original action formula. -/

open scoped Classical
namespace Bounty
section Effective
variable {S I V K : Type} [Fintype S] {N J ell : ℕ}
  {Ps : S → Finset ℕ} {P : Fin N → Finset ℕ}
  (C : I → Fin N → Finset (Fin J)) (k : K → I → ℤ) (B : ℕ)

abbrev PhysicalEffectivePlannedBigPath
    (ks : List (Option (V ⊕ K))) (L : PhysicalMarkLists Ps J ell)
    (pl : PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) ks)
    (x : PhysicalFullBoundedState P J ell B) :=
  PhysicalMixedPlannedBigPath (fun g (p : P g) => p.val)
    (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
    (fun i => PhysicalAuxLabels P (C i))
    (fun t i d => physicalFullEdgeDelta (C i) (k t i * (physicalSharedProduct d : ℕ)))
    (fun _ i _ => physicalFullEdgeD (C i)) ks L pl x

noncomputable def physicalEffectivePlanSmallFactor
    (Vs : S → ℝ) (qedge : K → ℝ)
    (ks : List (Option (V ⊕ K))) (r : PhysicalResidues Ps) (L : PhysicalMarkLists Ps J ell)
    (pl : PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) ks)
    (x : PhysicalFullBoundedState P J ell B)
    (p : PhysicalEffectivePlannedBigPath C k B ks L pl x) : ℂ :=
  deterministicLedgerPhase
    (PhysicalPlannedResidueEvent (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i => PhysicalAuxLabels P (C i))
      (fun t i d => physicalFullEdgeDelta (C i) (k t i * (physicalSharedProduct d : ℕ)))
      (fun _ i _ => physicalFullEdgeD (C i)))
    (physicalPlannedResidueTarget (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i => PhysicalAuxLabels P (C i))
      (fun t i d => physicalFullEdgeDelta (C i) (k t i * (physicalSharedProduct d : ℕ)))
      (fun _ i _ => physicalFullEdgeD (C i)))
    (physicalPlannedSmallUpdate (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i => PhysicalAuxLabels P (C i))
      (fun t i d => physicalFullEdgeDelta (C i) (k t i * (physicalSharedProduct d : ℕ)))
      (fun _ i _ => physicalFullEdgeD (C i))
      (fun t i => physicalMixedBigStep (C i) (k t i)))
    (physicalPlannedSmallPhase (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i => PhysicalAuxLabels P (C i))
      (fun t i d => physicalFullEdgeDelta (C i) (k t i * (physicalSharedProduct d : ℕ)))
      (fun _ i _ => physicalFullEdgeD (C i))
      (fun t i => physicalMixedBigStep (C i) (k t i)) Vs qedge)
    (physicalMixedBigSteps ks L pl) r x p

variable (hPs : ∀ s p, p ∈ Ps s → Nat.Prime p)
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : ∀ s g, Disjoint (Ps s) (P g))

theorem physical_mixed_plan_small_factor_effective
    (Vs : S → ℝ) (qedge : K → ℝ)
    (ks : List (Option (V ⊕ K))) (r : PhysicalResidues Ps) (L : PhysicalMarkLists Ps J ell)
    (pl : PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) ks)
    (x : PhysicalFullBoundedState P J ell B)
    (p : PhysicalMixedPlannedBigPath (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i => PhysicalAuxLabels P (C i))
      (fun t i => physicalMixedEdgeDelta (C i) (k t i))
      (fun _ i => physicalMixedEdgeD (C i)) ks L pl x) :
    (physicalMixedPlanSmallFactor (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i => PhysicalAuxLabels P (C i))
      (fun t i => physicalMixedEdgeDelta (C i) (k t i))
      (fun _ i => physicalMixedEdgeD (C i))
      (fun t i => physicalMixedBigStep (C i) (k t i)) Vs qedge ks r L pl x p : ℂ) =
    physicalEffectivePlanSmallFactor C k B Vs qedge ks r L pl x
      (physicalMixedEffectiveBigPathEquiv hPs hP hdis
        (fun key : PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K) => C key.2.1)
        (fun key => physicalSharedPrefix key.2.2.1) (fun key => k key.1 key.2.1) B
        (physicalMixedBigSteps ks L pl) x p) := by
  exact physical_mixed_plan_small_factor_transport (fun g (p : P g) => p.val)
    (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
    (fun i => PhysicalAuxLabels P (C i))
    (fun t i => physicalMixedEdgeDelta (C i) (k t i))
    (fun t i d => physicalFullEdgeDelta (C i) (k t i * (physicalSharedProduct d : ℕ)))
    (fun _ i => physicalMixedEdgeD (C i)) (fun _ i _ => physicalFullEdgeD (C i))
    (fun t i d => funext fun c => funext fun a => funext fun g =>
      physical_mixed_delta_effective_big_step (C i) d (k t i) c a g)
    (fun _ i d c a g p => physical_mixed_dilation_divisibility hPs hP hdis (C i) d c a g p)
    (fun t i => physicalMixedBigStep (C i) (k t i)) Vs qedge ks r L pl x p

theorem physical_mixed_plan_small_factor_effective_pullback
    (Vs : S → ℝ) (qedge : K → ℝ)
    (ks : List (Option (V ⊕ K))) (r : PhysicalResidues Ps) (L : PhysicalMarkLists Ps J ell)
    (pl : PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) ks)
    (x : PhysicalFullBoundedState P J ell B)
    (p : PhysicalEffectivePlannedBigPath C k B ks L pl x) :
    (physicalMixedPlanSmallFactor (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i => PhysicalAuxLabels P (C i))
      (fun t i => physicalMixedEdgeDelta (C i) (k t i))
      (fun _ i => physicalMixedEdgeD (C i))
      (fun t i => physicalMixedBigStep (C i) (k t i)) Vs qedge ks r L pl x
      ((physicalMixedEffectiveBigPathEquiv hPs hP hdis
        (fun key : PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K) => C key.2.1)
        (fun key => physicalSharedPrefix key.2.2.1) (fun key => k key.1 key.2.1) B
        (physicalMixedBigSteps ks L pl) x).symm p) : ℂ) =
    physicalEffectivePlanSmallFactor C k B Vs qedge ks r L pl x p := by
  simpa only [Equiv.apply_symm_apply] using
    physical_mixed_plan_small_factor_effective C k B hPs hP hdis Vs qedge ks r L pl x
      ((physicalMixedEffectiveBigPathEquiv hPs hP hdis
        (fun key : PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K) => C key.2.1)
        (fun key => physicalSharedPrefix key.2.2.1) (fun key => k key.1 key.2.1) B
        (physicalMixedBigSteps ks L pl) x).symm p)

end Effective
end Bounty
