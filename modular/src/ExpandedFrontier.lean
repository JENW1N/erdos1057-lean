/- Candidate prime-band mass with the same sqrt-logarithmic cutoff as the actual proxy. -/

open Finset Filter
open scoped Topology
namespace Bounty

theorem exists_candidate_prime_band_sqrt_rough_mass_estimate (hZ : PrimitiveZeroFreeHalfPlane) :
    ∃ K : ℝ, 0 < K ∧ ∀ (c q a v : ℝ) (r : ℕ),
      0 < c → 0 < r → 0 ≤ q → q < 1 →
      (11/5 : ℝ)*(r : ℝ)*c = 1 →
      0 < a → a ≤ v → v < 1/2 →
      ∃ J : ℕ, ∀ jStar : ℕ, J < jStar → ∀ᶠ L : ℝ in atTop,
        |candidatePrimeBandRoughMass c L q r jStar
            (Real.exp (a*L)) (Real.exp (v*L)) (Real.exp (Real.sqrt L)) -
          candidateCoefficientWindowMass c L q r jStar *
            shiftedPrimeAvoidanceProduct (Real.exp (Real.sqrt L)) *
              (∑ p ∈ primeBand (Real.exp (a*L)) (Real.exp (v*L)),
                1 / ((p : ℝ)-1))| ≤
          candidateCoefficientWindowMass c L q r jStar *
            shiftedPrimeAvoidanceProduct (Real.exp (Real.sqrt L)) *
              (∑ p ∈ primeBand (Real.exp (a*L)) (Real.exp (v*L)),
                1 / ((p : ℝ)-1)) * K * Real.exp (-(roughCellSieveOrder L : ℝ)) +
          candidateCoefficientWindowMass c L q r jStar *
            ((1+16*primeEulerProductUpperConstant)*L^(-18 : ℝ)) := by
  classical
  obtain ⟨K, hK, hsieve⟩ := exists_summed_external_odd_prime_shifted_sieve
  refine ⟨K, hK, ?_⟩
  intro c q a v r hc hr hq0 hq1 hcenter ha hav hvhalf
  let theta : ℝ := (v+1/2)/2
  have htheta : theta < 1/2 := by dsimp [theta]; linarith only [hvhalf]
  have hv : 0 < v := ha.trans_le hav
  have hgap : 0 < theta-v := by dsimp [theta]; linarith only [hvhalf]
  have hmid : v+(theta-v)/2 < theta := by linarith
  have hbase : 0 ≤ v+(theta-v)/2 := by positivity
  obtain ⟨J, hdist⟩ := exists_candidate_relative_typeI_remainder_power_bound
    hZ hc hr hq0 hq1 hcenter htheta (18 : ℝ)
  refine ⟨J, ?_⟩
  intro jStar hj
  filter_upwards [hdist jStar hj, eventually_exp_le_floor_exp hbase hmid,
    eventually_rough_cell_sieve_parameters hgap, eventually_rough_test_proxy_cutoff ha,
    eventually_gt_atTop (0 : ℝ), eventually_ge_atTop (Real.log 2/a)]
    with L hd hscale hpar hcut hL hLa
  let N : ℕ := ⌊Real.exp (theta*L)⌋₊
  let P : Finset ℕ := (primeBand 0 (Real.exp (Real.sqrt L))).erase 2
  let Q : Finset ℕ := primeBand (Real.exp (a*L)) (Real.exp (v*L))
  have hz : 1 < Real.exp (Real.sqrt L) := hpar.2.2.1
  have hP : ∀ p ∈ P, p.Prime := fun p hp => small_prime_pool_prime (mem_of_mem_erase hp)
  have hQ : ∀ p ∈ Q, p.Prime := by
    intro p hp
    exact ((mem_primeBand_iff (Real.exp_pos _).le (Real.exp_pos _).le p).mp hp).1
  have hQlower : ∀ p ∈ Q, Real.exp (a*L) < (p : ℝ) := by
    intro p hp
    exact ((mem_primeBand_iff (Real.exp_pos _).le (Real.exp_pos _).le p).mp hp).2.1
  have hQupper : ∀ p ∈ Q, (p : ℝ) ≤ Real.exp (v*L) := by
    intro p hp
    exact ((mem_primeBand_iff (Real.exp_pos _).le (Real.exp_pos _).le p).mp hp).2.2
  have hQodd : ∀ p ∈ Q, p ≠ 2 := by
    have hexp : 2 ≤ Real.exp (a*L) := by
      rw [← Real.exp_log (by norm_num : (0 : ℝ)<2)]
      apply Real.exp_le_exp.mpr
      have := (div_le_iff₀ ha).mp hLa
      nlinarith only [this]
    intro p hp heq
    have hp' := hQlower p hp
    norm_num [heq] at hp'
    linarith
  have hout : ∀ p ∈ Q, p ∉ P := by
    intro p hp hpP
    have hpmax := small_prime_pool_le (Real.exp_pos (Real.sqrt L)).le (mem_of_mem_erase hpP)
    have hcutexp : Real.exp (Real.sqrt L) ≤ Real.exp (a*L) :=
      Real.exp_le_exp.mpr hcut
    exact (not_lt_of_ge (hpmax.trans hcutexp)) (hQlower p hp)
  have hprodlevel : ∀ p ∈ Q, ∀ d ∈ blockSieveModuli P
      ((Real.exp (Real.sqrt L))^(4*(roughCellSieveOrder L : ℝ)+2)), p*d ≤ N := by
    intro p hp d hd
    have hdmax := (block_sieve_modulus_properties P hP _ hd).2.1
    have hprod : (p : ℝ)*(d : ℝ) ≤ Real.exp ((v+(theta-v)/2)*L) := by
      calc
        _ ≤ Real.exp (v*L)*((Real.exp (Real.sqrt L))^(4*(roughCellSieveOrder L : ℝ)+2)) :=
          mul_le_mul (hQupper p hp) hdmax (Nat.cast_nonneg d) (Real.exp_pos _).le
        _ ≤ Real.exp (v*L)*Real.exp (((theta-v)/2)*L) :=
          mul_le_mul_of_nonneg_left hpar.2.2.2.1 (Real.exp_pos _).le
        _ = _ := by
          rw [← Real.exp_add]
          congr 1
          ring
    exact_mod_cast hprod.trans hscale
  have hs := hsieve P Q (arithmeticProductWindow 1 (Real.exp L))
    (candidateCoefficient c L q r jStar) N hz hpar.1 hpar.2.1 hP
    (fun p hp => (mem_erase.mp hp).1)
    (fun p hp => small_prime_pool_le (Real.exp_pos _).le (mem_of_mem_erase hp))
    hQ hQodd hout (fun u _ => candidate_coefficient_nonneg c L hq0 r jStar u) hprodlevel
  have hmass : (∑ p ∈ Q, ∑ u ∈ (arithmeticProductWindow 1 (Real.exp L)).filter
      (fun u => p ∣ 2*u+1 ∧ ∀ q ∈ P, ¬q ∣ 2*u+1),
      candidateCoefficient c L q r jStar u) =
      candidatePrimeBandRoughMass c L q r jStar
        (Real.exp (a*L)) (Real.exp (v*L)) (Real.exp (Real.sqrt L)) := by
    unfold candidatePrimeBandRoughMass
    apply sum_congr rfl
    intro p hp
    rw [shifted_rough_prime_filter_eq _ (Real.exp_pos _).le]
  rw [hmass] at hs
  have hN : (N : ℝ) ≤ Real.exp (theta*L) := Nat.floor_le (Real.exp_pos _).le
  have herr := hd N hN
  have herr' : (∑ m ∈ oddSquarefreeModuli N,
      |shiftedTotientSieveRemainder (arithmeticProductWindow 1 (Real.exp L))
        (candidateCoefficient c L q r jStar) m|) ≤
      candidateCoefficientWindowMass c L q r jStar *
        ((1+16*primeEulerProductUpperConstant)*L^(-18 : ℝ)) := by
    convert herr using 1 <;> ring
  exact hs.trans (add_le_add le_rfl herr')


end Bounty
end

section

/- Finite injection from unbalanced prime-factor proxy sums into candidate prime-band rough mass. -/

open Finset

namespace Bounty

theorem prime_cofactor_rough_product {W : ℝ} {p m u : ℕ}
    (hp : p.Prime) (hpW : W < (p : ℝ)) (hprod : p * m = 2 * u + 1)
    (hm : ∀ q ∈ m.primeFactors, W < (q : ℝ)) :
    ∀ q ∈ (2 * u + 1).primeFactors, W < (q : ℝ) := by
  have hm0 : m ≠ 0 := by intro hzero; simp only [hzero, mul_zero] at hprod; omega
  rw [← hprod, Nat.primeFactors_mul hp.ne_zero hm0, hp.primeFactors]
  intro q hq
  rcases mem_union.mp hq with hqp | hqm
  · simpa only [mem_singleton.mp hqp] using hpW
  · exact hm q hqm

theorem prime_cofactor_to_shifted_index_injective (F : Finset (ℕ × ℕ))
    (u : ℕ × ℕ → ℕ) (hpos : ∀ v ∈ F, 0 < v.1)
    (hprod : ∀ v ∈ F, v.1 * v.2 = 2 * u v + 1) :
    Set.InjOn (fun v : ℕ × ℕ => (v.1, u v)) F := by
  intro x hx y hy hxy
  have hpair : (x.1, u x) = (y.1, u y) := hxy
  have hp := congrArg (fun z : ℕ × ℕ => z.1) hpair
  have hu := congrArg (fun z : ℕ × ℕ => z.2) hpair
  change x.1 = y.1 at hp
  change u x = u y at hu
  have hmul : x.1 * x.2 = x.1 * y.2 := by rw [hprod x hx, hp, hprod y hy, hu]
  exact Prod.ext hp (Nat.eq_of_mul_eq_mul_left (hpos x hx) hmul)

theorem finite_prime_factor_proxy_bound (T Q : Finset ℕ) (F : Finset (ℕ × ℕ))
    (μ f : ℕ → ℝ) (u : ℕ × ℕ → ℕ) {W C : ℝ} (hC : 0 ≤ C)
    (hμ : ∀ v ∈ T, 0 ≤ μ v)
    (hQ : ∀ p ∈ Q, p.Prime ∧ W < (p : ℝ))
    (hdata : ∀ v ∈ F, u v ∈ T ∧ v.1 ∈ Q ∧ v.1 * v.2 = 2 * u v + 1)
    (hf : ∀ v ∈ F, 0 ≤ f v.2 ∧ f v.2 ≤ C)
    (hrough : ∀ v ∈ F, f v.2 ≠ 0 → ∀ p ∈ v.2.primeFactors, W < (p : ℝ)) :
    (∑ v ∈ F, μ (u v) * f v.2) ≤
      C * ∑ p ∈ Q, ∑ v ∈ (shiftedRoughSet T W).filter (fun v => p ∣ 2 * v + 1), μ v := by
  classical
  let G := F.filter (fun v => f v.2 ≠ 0)
  let H := (Q ×ˢ shiftedRoughSet T W).filter (fun v => v.1 ∣ 2 * v.2 + 1)
  let φ := fun v : ℕ × ℕ => (v.1, u v)
  have hinj : Set.InjOn φ G :=
    (prime_cofactor_to_shifted_index_injective F u
      (fun v hv => (hQ v.1 (hdata v hv).2.1).1.pos)
      (fun v hv => (hdata v hv).2.2)).mono (filter_subset _ _)
  have hmap : G.image φ ⊆ H := by
    intro x hx
    obtain ⟨v, hv, rfl⟩ := mem_image.mp hx
    obtain ⟨hvF, hvf⟩ := mem_filter.mp hv
    obtain ⟨huT, hpQ, hprod⟩ := hdata v hvF
    obtain ⟨hpp, hpW⟩ := hQ v.1 hpQ
    have huR : u v ∈ shiftedRoughSet T W := (mem_shifted_rough_set_iff T W (u v)).mpr
      ⟨huT, prime_cofactor_rough_product hpp hpW hprod (hrough v hvF hvf)⟩
    apply mem_filter.mpr
    refine ⟨mem_product.mpr ⟨hpQ, huR⟩, ?_⟩
    change v.1 ∣ 2 * u v + 1
    rw [← hprod]
    exact dvd_mul_right _ _
  have hsum : (∑ v ∈ F, μ (u v) * f v.2) = ∑ v ∈ G, μ (u v) * f v.2 := by
    symm
    apply sum_subset (filter_subset _ _)
    intro v hv hnot
    have hz : f v.2 = 0 := by
      by_contra hn
      exact hnot (mem_filter.mpr ⟨hv, hn⟩)
    rw [hz, mul_zero]
  have hμsum : (∑ v ∈ G, μ (u v)) ≤ ∑ x ∈ H, μ x.2 := by
    change (∑ v ∈ G, (fun x : ℕ × ℕ => μ x.2) (φ v)) ≤ _
    rw [← sum_image (f := fun x : ℕ × ℕ => μ x.2) hinj]
    apply sum_le_sum_of_subset_of_nonneg hmap
    intro x hx hnot
    have hxR : x.2 ∈ shiftedRoughSet T W := (mem_product.mp (mem_filter.mp hx).1).2
    exact hμ x.2 ((mem_shifted_rough_set_iff T W x.2).mp hxR).1
  have hH : (∑ x ∈ H, μ x.2) =
      ∑ p ∈ Q, ∑ v ∈ (shiftedRoughSet T W).filter (fun v => p ∣ 2 * v + 1), μ v := by
    simp only [H, sum_filter, sum_product]
  rw [hsum]
  calc
    _ ≤ ∑ v ∈ G, μ (u v) * C := by
      apply sum_le_sum
      intro v hv
      have hvF := (mem_filter.mp hv).1
      exact mul_le_mul_of_nonneg_left (hf v hvF).2 (hμ (u v) (hdata v hvF).1)
    _ = C * ∑ v ∈ G, μ (u v) := by rw [← sum_mul, mul_comm]
    _ ≤ C * ∑ x ∈ H, μ x.2 := mul_le_mul_of_nonneg_left hμsum hC
    _ = _ := by rw [hH]

theorem rough_test_logarithmic_proxy_nonneg (γ L S : ℝ) (n : ℕ) :
    0 ≤ roughTestLogarithmicProxy γ L S n :=
  rough_test_cell_proxy_nonneg γ L S
    (logarithmicCellBase (L ^ (-S)) (logarithmicCellIndex (L ^ (-S)) n)) n

theorem rough_test_logarithmic_proxy_le_coefficient {γ L S C : ℝ} (hC : 0 ≤ C) {n : ℕ}
    (hcoef : roughTestCellProxyCoefficient γ L S
      (logarithmicCellBase (L ^ (-S)) (logarithmicCellIndex (L ^ (-S)) n)) ≤ C) :
    roughTestLogarithmicProxy γ L S n ≤ C := by
  unfold roughTestLogarithmicProxy roughTestCellProxy
  split
  · exact hcoef
  · exact hC

theorem rough_test_logarithmic_proxy_support {γ L S : ℝ} {n : ℕ}
    (hn : roughTestLogarithmicProxy γ L S n ≠ 0) :
    ∀ p ∈ n.primeFactors, Real.exp (Real.sqrt L) < (p : ℝ) := by
  have hmem := rough_test_cell_proxy_ne_zero_mem
    (show roughTestCellProxy γ L S
      (logarithmicCellBase (L ^ (-S)) (logarithmicCellIndex (L ^ (-S)) n)) n ≠ 0 from hn)
  exact (mem_filter.mp hmem).2

theorem finite_rough_logarithmic_proxy_bound (T Q : Finset ℕ) (F : Finset (ℕ × ℕ))
    (μ : ℕ → ℝ) (u : ℕ × ℕ → ℕ) {γ L S C : ℝ} (hC : 0 ≤ C)
    (hμ : ∀ v ∈ T, 0 ≤ μ v)
    (hQ : ∀ p ∈ Q, p.Prime ∧ Real.exp (Real.sqrt L) < (p : ℝ))
    (hdata : ∀ v ∈ F, u v ∈ T ∧ v.1 ∈ Q ∧ v.1 * v.2 = 2 * u v + 1)
    (hcoef : ∀ v ∈ F, roughTestCellProxyCoefficient γ L S
      (logarithmicCellBase (L ^ (-S)) (logarithmicCellIndex (L ^ (-S)) v.2)) ≤ C) :
    (∑ v ∈ F, μ (u v) * roughTestLogarithmicProxy γ L S v.2) ≤
      C * ∑ p ∈ Q, ∑ v ∈ (shiftedRoughSet T (Real.exp (Real.sqrt L))).filter
        (fun v => p ∣ 2 * v + 1), μ v := by
  apply finite_prime_factor_proxy_bound T Q F μ (roughTestLogarithmicProxy γ L S) u hC hμ hQ hdata
  · intro v hv
    exact ⟨rough_test_logarithmic_proxy_nonneg γ L S v.2,
      rough_test_logarithmic_proxy_le_coefficient hC (hcoef v hv)⟩
  · intro v hv hne
    exact rough_test_logarithmic_proxy_support hne

theorem candidate_prime_factor_proxy_bound {c L q A B W C : ℝ} (r jStar : ℕ)
    (hq : 0 ≤ q) (hA : 0 ≤ A) (hB : 0 ≤ B) (hWA : W ≤ A) (hC : 0 ≤ C)
    (F : Finset (ℕ × ℕ)) (f : ℕ → ℝ) (u : ℕ × ℕ → ℕ)
    (hdata : ∀ v ∈ F, u v ∈ arithmeticProductWindow 1 (Real.exp L) ∧
      v.1 ∈ primeBand A B ∧ v.1 * v.2 = 2 * u v + 1)
    (hf : ∀ v ∈ F, 0 ≤ f v.2 ∧ f v.2 ≤ C)
    (hrough : ∀ v ∈ F, f v.2 ≠ 0 → ∀ p ∈ v.2.primeFactors, W < (p : ℝ)) :
    (∑ v ∈ F, candidateCoefficient c L q r jStar (u v) * f v.2) ≤
      C * candidatePrimeBandRoughMass c L q r jStar A B W := by
  apply finite_prime_factor_proxy_bound (arithmeticProductWindow 1 (Real.exp L))
    (primeBand A B) F (candidateCoefficient c L q r jStar) f u hC
    (fun n hn => candidate_coefficient_nonneg c L hq r jStar n) _ hdata hf hrough
  intro p hp
  obtain ⟨hpp, hAp, _⟩ := (mem_primeBand_iff hA hB p).mp hp
  exact ⟨hpp, hWA.trans_lt hAp⟩

theorem candidate_rough_logarithmic_proxy_bound {c L q A B C γ S : ℝ} (r jStar : ℕ)
    (hq : 0 ≤ q) (hB : 0 ≤ B) (hWA : Real.exp (Real.sqrt L) ≤ A) (hC : 0 ≤ C)
    (F : Finset (ℕ × ℕ)) (u : ℕ × ℕ → ℕ)
    (hdata : ∀ v ∈ F, u v ∈ arithmeticProductWindow 1 (Real.exp L) ∧
      v.1 ∈ primeBand A B ∧ v.1 * v.2 = 2 * u v + 1)
    (hcoef : ∀ v ∈ F, roughTestCellProxyCoefficient γ L S
      (logarithmicCellBase (L ^ (-S)) (logarithmicCellIndex (L ^ (-S)) v.2)) ≤ C) :
    (∑ v ∈ F, candidateCoefficient c L q r jStar (u v) * roughTestLogarithmicProxy γ L S v.2) ≤
      C * candidatePrimeBandRoughMass c L q r jStar A B (Real.exp (Real.sqrt L)) := by
  apply candidate_prime_factor_proxy_bound r jStar hq ((Real.exp_nonneg _).trans hWA) hB hWA hC
    F (roughTestLogarithmicProxy γ L S) u hdata
  · intro v hv
    exact ⟨rough_test_logarithmic_proxy_nonneg γ L S v.2,
      rough_test_logarithmic_proxy_le_coefficient hC (hcoef v hv)⟩
  · intro v hv hne
    exact rough_test_logarithmic_proxy_support hne

end Bounty


end

section

/- Exact original event rows with the chronological owner indicator. -/

open Finset Classical

namespace Bounty

section Rows
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
    [∀ g, DecidableEq (P g)] {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ v : ℝ) (V : Fin N → ℝ)
    (steps : List (Option (J ⊕ K))) (u : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))

theorem full_mixed_ghost_original_stage_le (j : J) (htag : steps.get u = some (.inl j))
    (η : Fin N → ℝ) (hη : ∀ g, 0 ≤ η g) (hμ : ∀ g p, 0 ≤ μ g p)
    (hμatom : ∀ g p, μ g p ≤ η g) (hv : 0 < v)
    (hq0 : 0 ≤ q j) (hq1 : q j ≤ 1) (hρ : 0 < ρ)
    (hD : q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1) :
    let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
    (∑ e : FullPermutationMixedEvent n S B A Δ D (some (.inl j)) s,
      |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V (some (.inl j)) s e| *
        fullMixedForestHistoryGain n S B A Δ D steps code u.val (some (.inl j)) s e history *
        productLengthLyapunov v (fullPermutationMixedEventTarget n S B A Δ D (some (.inl j)) s e)) ≤
    (∏ g, ((|(1 - q j) * V g / ρ| * η g) * v) ^ fullMixedSelectedCount S B steps code u g) *
      (∏ g, Real.exp ((|(1 - q j) * V g / ρ| * ∑ p, μ g p) * v)) * productLengthLyapunov v s := by
  refine le_trans (le_of_eq (full_mixed_ghost_stage_reindex n S B A Δ D ω μ q ρ v V steps u s history code j htag)) ?_
  exact full_mixed_ghost_all_skeletons_stage_le n S B A Δ D steps u j htag s history code μ (q j) ρ v V η
    hη hμ hμatom hv hq0 hq1 hρ hD

theorem full_mixed_edge_original_stage_le (k : K) (htag : steps.get u = some (.inr k))
    (η : Fin N → ℝ) (hη : ∀ g, 0 ≤ η g) (hμ : ∀ g p, 0 ≤ μ g p)
    (hμatom : ∀ g p, μ g p ≤ η g) (hv : 1 < v)
    (hω : ∀ c a, 0 ≤ ω k c a) (hωmass : ∀ c, ∑ a, ω k c a ≤ 1)
    (vmin : ℝ) (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hvmin : 0 < vmin) (hV : ∀ g, vmin ≤ V g)
    (hmass : ∀ g, ∑ p, μ g p ≤ 2) (T : ℕ) (ht : ∀ g, (S k g)ᶜ.card ≤ T) :
    let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
    (∑ e : FullPermutationMixedEvent n S B A Δ D (some (.inr k)) s,
      |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V (some (.inr k)) s e| *
        fullMixedForestHistoryGain n S B A Δ D steps code u.val (some (.inr k)) s e history *
        productLengthLyapunov v (fullPermutationMixedEventTarget n S B A Δ D (some (.inr k)) s e)) ≤
    (∏ g, η g ^ fullMixedSelectedCount S B steps code u g) * productLengthLyapunov v s *
      unrestrictedEdgeRowBound ρ v vmin T ^ N := by
  refine le_trans (le_of_eq (full_mixed_edge_stage_reindex n S B A Δ D ω μ q ρ v V steps u s history code k htag)) ?_
  exact full_mixed_edge_all_skeletons_stage_le n S B A Δ D steps u k htag s history code (ω k) μ ρ v vmin V η
    hη hμ hμatom hv hω hωmass hρ0 hρ1 hvmin hV hmass T ht

end Rows
end Bounty
end

section

/- Exact normalization of the physical mixed parameters to the big-factor-first
order used by the candidate omission and dirty-energy estimates. -/

namespace Bounty

theorem physical_mixed_edge_D_big_first
    {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (d : PhysicalSharedLists Ps J)
    (c : SharedActiveLabels (fun g => ↥(P g))
      (fun g => physicalFullSharedIndices (ell := ell) (C g)))
    (aux : PhysicalAuxLabels P C) (g : G) :
    physicalMixedEdgeD C d c aux g =
      (physicalFullSharedD C c aux * physicalSharedProduct d : ℕ) := by
  unfold physicalMixedEdgeD physicalMixedSharedD
  rw [Nat.mul_comm]

theorem physical_mixed_edge_delta_big_first
    {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (k : ℤ) (d : PhysicalSharedLists Ps J)
    (c : SharedActiveLabels (fun g => ↥(P g))
      (fun g => physicalFullSharedIndices (ell := ell) (C g)))
    (aux : PhysicalAuxLabels P C) (g : G) :
    physicalMixedEdgeDelta C k d c aux g =
      -(k * (physicalFullSharedD C c aux * physicalSharedProduct d : ℕ)) := by
  rw [physicalMixedEdgeDelta, physical_mixed_edge_D_big_first, neg_mul]

end Bounty
end

section

/- Both adjacent active-slot averages absorb the physical/canonical encoding
change. The initial forbidden sets are fixed throughout the averages. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_mixed_clean_initial_projected_reencode {S G : Type*}
    [Fintype S] [Fintype G] [dG : DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    [∀ g (p : P g), NeZero p.val]
    (initial : ∀ g, Finset (P g)) (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (ζ θ ρ : ℝ) (k : ℤ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : CleanFullMemoryState P J ell B → PhysicalResidues Ps → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun x => f x r))
    (hPs : ∀ s p, p ∈ Ps s → 0 < p) (hP : ∀ g p, p ∈ P g → 0 < p) :
    cleanFullMemoryActiveMap (physicalMixedCleanInitialAction initial V b C ζ θ ρ k K d
      (cleanFullMemoryActiveMap f)) =
    cleanFullMemoryActiveMap (cleanFullMemoryInitialEventAction initial V b C ζ θ ρ k
      (canonicalMixedEdgeD C d) K d (cleanFullMemoryActiveMap f)) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  have hin : (fun y r => cleanFullMemoryActiveMap f
      ((fullActivePermutation (cleanPhysicalSlotChange C)).symm y) r) =
      cleanFullMemoryActiveMap f := by
    funext y r
    exact fullActiveAverage_invariant (fun z => f z r)
      (fun g => (cleanPhysicalSlotChange C g).symm) y
  have hs : ∀ r, ProductMemorySymmetric (fun x => cleanFullMemoryActiveMap f x r) :=
    fun r => fullActiveAverage_symmetric (fun x => f x r) (hf r)
  have he (r : PhysicalResidues Ps) :
      (fun x => physicalMixedCleanInitialAction initial V b C ζ θ ρ k K d
        (cleanFullMemoryActiveMap f) (fullActivePermutation (cleanPhysicalSlotChange C) x) r) =
      (fun x => cleanFullMemoryInitialEventAction initial V b C ζ θ ρ k
        (canonicalMixedEdgeD C d) K d (cleanFullMemoryActiveMap f) x r) := by
    funext x
    have h := physical_mixed_clean_initial_action_reencode initial V b C ζ θ ρ k K d
      (cleanFullMemoryActiveMap f) hs hPs hP x r
    rw [hin] at h
    exact h
  funext x r
  have ha := fullActiveAverage_absorb_input_permutation
    (fun y => physicalMixedCleanInitialAction initial V b C ζ θ ρ k K d
      (cleanFullMemoryActiveMap f) y r) (cleanPhysicalSlotChange C)
  rw [he r] at ha
  exact (congrFun ha x).symm

end Bounty
end

section

/- Isolate the actual retained residual phase without removing initial-ledger avoidance. -/

open Finset Classical
namespace Bounty
section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, DecidableEq (P g)]
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ)
  (edgePhase : ∀ k, ((g : Fin N) → Finset (P g)) →
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) →
    FullActiveEdgeEvent n (S k) B (A k) (Δ k) (D k) x → ℂ)
  (steps : List (Option (J ⊕ K)))
  (initial : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B →
    (g : Fin N) → Finset (P g))

noncomputable def fullMixedResidualPathPhase
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x) : ℂ :=
  (if ∀ (a : FullMixedBirthAddress S B steps) (z : (g : Fin N) × P g),
      fullMixedPathBirthLabel n S B A Δ D steps x p a = some z → z.2 ∉ initial x z.1
    then 1 else 0) *
  finiteEventLocalPhase (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D)
    (fullMixedBirthResidualPhase n S B A Δ D edgePhase) steps x p

theorem full_mixed_residual_path_phase_norm_le
    (hphase : ∀ k x e, ‖edgePhase k (fun _ => ∅) x e‖ ≤ 1)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x) :
    ‖fullMixedResidualPathPhase n S B A Δ D edgePhase steps initial x p‖ ≤ 1 := by
  have hlocal : ∀ tag x e, ‖fullMixedBirthResidualPhase (J := J) n S B A Δ D edgePhase tag x e‖ ≤ 1 := by
    intro tag x e
    cases tag with
    | none => exact le_of_eq (norm_one : ‖(1 : ℂ)‖ = 1)
    | some tag =>
      cases tag with
      | inl j => exact le_of_eq (norm_one : ‖(1 : ℂ)‖ = 1)
      | inr k => exact hphase k x e
  unfold fullMixedResidualPathPhase
  split_ifs
  · simpa only [one_mul] using finite_event_local_phase_norm_le _ _ _ hlocal steps x p
  · simp only [zero_mul, norm_zero, zero_le_one]

theorem full_mixed_residual_weight_factor
    (ω : ∀ k c, A k c → ℝ) (μ : (g : Fin N) → P g → ℝ)
    (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x) :
    fullMixedResidualPathWeight n S B A Δ D edgePhase ω μ q ρ V steps initial x p =
      (finiteEventPathWeight (FullPermutationMixedEvent n S B A Δ D)
        (fullPermutationMixedEventTarget n S B A Δ D)
        (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V) steps x p : ℂ) *
      fullMixedResidualPathPhase n S B A Δ D edgePhase steps initial x p := by
  exact mul_assoc _ _ _

end Full
end Bounty
end

section

/- Bounded character slices for the actual smooth off-diagonal energy. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

noncomputable def typeIIRealCharacterAverage (M H Z : Finset ℕ)
    (k : ℤ) [NeZero (2 * k.natAbs)] (η : ℝ → ℝ → ℝ) (α aH : ℕ → ℂ) : ℂ :=
  (1 / ((2 * k.natAbs).totient : ℂ)) *
    ∑ χ : DirichletCharacter ℂ (2 * k.natAbs),
      ∑ y ∈ typeIICrossSlice M H Z k,
        typeIIRealShiftWeight η α aH y * χ (y.2.1.1 : ZMod (2 * k.natAbs)) *
          conj (χ (y.2.2.1 : ZMod (2 * k.natAbs)))

noncomputable def typeIIRealCharacterSlice (M H Z : Finset ℕ)
    (k : ℤ) (η : ℝ → ℝ → ℝ) (α aH : ℕ → ℂ) : ℂ :=
  if hk : k = 0 then 0 else
    @typeIIRealCharacterAverage M H Z k
      ⟨by simpa only [ne_eq, mul_eq_zero, OfNat.ofNat_ne_zero, false_or,
        Int.natAbs_eq_zero] using hk⟩ η α aH

theorem typeII_smooth_character_slice_eq (E N M H Z : Finset ℕ)
    (k : ℤ) (η : ℝ → ℝ → ℝ) (α aH : ℕ → ℂ)
    {W : ℝ} (hW : 2 ≤ W) (hM : ∀ m ∈ M, 0 < m)
    (hrough : ∀ m ∈ M, ∀ p ∈ m.primeFactors, W < (p : ℝ))
    (hsmall : (k.natAbs : ℝ) ≤ W)
    (hpos : ∀ e n, η e n ≠ 0 → 0 < e)
    (hmem : ∀ e n : ℕ, η e n ≠ 0 → e ∈ E ∧ n ∈ N) :
    (∑ y ∈ typeIIDeterminantDomain E N M H {k} Z,
      typeIIShiftWeight (fun e n => η e n) α aH y) =
      (typeIIRealCharacterSlice M H Z k η α aH).re := by
  classical
  by_cases hk : k = 0
  · subst k
    rw [typeII_zero_determinant_slice]
    simp [typeIIRealCharacterSlice]
  · rw [typeIIRealCharacterSlice, dif_neg hk]
    have hs := @typeII_smooth_determinant_character_sum E N M H Z k
      ⟨by simpa only [ne_eq, mul_eq_zero, OfNat.ofNat_ne_zero, false_or,
        Int.natAbs_eq_zero] using hk⟩ η α aH W hW hM hrough hsmall hpos hmem
    have hr := congrArg Complex.re hs
    simpa only [Complex.re_sum, typeII_shift_complex_weight_re,
      typeIIRealCharacterAverage] using hr

theorem typeII_smooth_off_diagonal_bounded (E N M H : Finset ℕ)
    (η : ℝ → ℝ → ℝ) (α aH : ℕ → ℂ) {Elo U W : ℝ} {B : ℕ}
    (hElo : 0 < Elo) (hE : ∀ e ∈ E, Elo ≤ (e : ℝ))
    (hMpos : ∀ m ∈ M, 0 < m) (hM : ∀ m ∈ M, (m : ℝ) ≤ U)
    (hB : U / (2 * Elo) ≤ B) (hBW : (B : ℝ) ≤ W) (hW : 2 ≤ W)
    (hrough : ∀ m ∈ M, α m ≠ 0 → ∀ p ∈ m.primeFactors, W < (p : ℝ))
    (hpos : ∀ e n, η e n ≠ 0 → 0 < e)
    (hmem : ∀ e n : ℕ, η e n ≠ 0 → e ∈ E ∧ n ∈ N) :
    typeIIOffDiagonalEnergy E N M H (fun e n => η e n) α aH =
      ∑ k ∈ Icc (-(B : ℤ)) B,
        (typeIIRealCharacterSlice (M.filter (fun m => α m ≠ 0)) H
          (Icc 0 ((M.filter (fun m => α m ≠ 0)).sup id * H.sup id)) k η α aH).re := by
  classical
  rw [typeII_off_diagonal_energy_eq_supported_determinant_sum E N M H
    (fun e n => η e n) α aH hElo hE hM hB hBW hrough,
    typeII_determinant_sum_slices]
  apply sum_congr rfl
  intro k hk
  apply typeII_smooth_character_slice_eq _ _ _ _ _ _ _ _ _ hW
  · intro m hm
    exact hMpos m (mem_filter.mp hm).1
  · intro m hm
    exact hrough m (mem_filter.mp hm).1 (mem_filter.mp hm).2
  · have hi : |k| ≤ (B : ℤ) := abs_le.mpr (mem_Icc.mp hk)
    rw [← Int.natCast_natAbs] at hi
    have hr : (k.natAbs : ℝ) ≤ B := by exact_mod_cast hi
    exact hr.trans hBW
  · exact hpos
  · exact hmem

theorem typeII_majorant_off_diagonal_bounded (M H : Finset ℕ) (α aH : ℕ → ℂ)
    {L E V U W : ℝ} {B : ℕ} (hL : 0 < L) (hE : 0 < E) (hV : 0 < V)
    (hMpos : ∀ m ∈ M, 0 < m) (hM : ∀ m ∈ M, (m : ℝ) ≤ U)
    (hB : U / (2 * (E / (2 * L ^ 88))) ≤ B) (hBW : (B : ℝ) ≤ W) (hW : 2 ≤ W)
    (hrough : ∀ m ∈ M, α m ≠ 0 → ∀ p ∈ m.primeFactors, W < (p : ℝ)) :
    typeIIOffDiagonalEnergy (Icc ⌈E / (2 * L ^ 88)⌉₊ ⌊2 * E⌋₊)
      (Icc ⌈V / 2⌉₊ ⌊3 * V⌋₊) M H
      (fun e n => typeIIEMajorant (L ^ 88) ((e : ℝ) / E) *
        typeIINMajorant ((n : ℝ) / V)) α aH =
      ∑ k ∈ Icc (-(B : ℤ)) B,
        (typeIIRealCharacterSlice (M.filter (fun m => α m ≠ 0)) H
          (Icc 0 ((M.filter (fun m => α m ≠ 0)).sup id * H.sup id)) k
          (fun e n => typeIIEMajorant (L ^ 88) (e / E) * typeIINMajorant (n / V)) α aH).re := by
  have hlo : ∀ e ∈ Icc ⌈E / (2 * L ^ 88)⌉₊ ⌊2 * E⌋₊,
      E / (2 * L ^ 88) ≤ (e : ℝ) := by
    intro e he
    exact (Nat.le_ceil _).trans (by exact_mod_cast (mem_Icc.mp he).1)
  apply typeII_smooth_off_diagonal_bounded _ _ M H
    (fun e n => typeIIEMajorant (L ^ 88) (e / E) * typeIINMajorant (n / V)) α aH
    (by positivity) hlo hMpos hM hB hBW hW hrough
  · intro e n hne
    exact (typeII_majorant_real_support hL hE hV hne).1
  · exact typeII_majorant_integer_support hL hE hV

end Bounty
end

section

/- Actual cross-product scale bounds on the support of the smooth majorants. -/

namespace Bounty

theorem typeII_real_cross_equation {m m' h z k : ℝ}
    (hm : m ≠ 0) (hm' : m' ≠ 0) (hk : k ≠ 0) (hz : z = m' * h) :
    m * ((m' - m) * z / (k * m * m') + 1 / m) =
      2 * ((m' - m) / (2 * k)) * h + 1 := by
  rw [hz]
  field_simp

theorem typeII_cross_scale_range {U V E P m m' e n h z : ℝ}
    (hU : 0 < U) (hV : 0 < V) (hE : 0 < E) (hP : 0 < P)
    (hUV : 4 ≤ U * V) (hm : m ∈ Set.Icc U (2 * U))
    (hm' : m' ∈ Set.Icc U (2 * U))
    (he : e ∈ Set.Ioo (E / (2 * P)) (2 * E))
    (hn : n ∈ Set.Ioo (V / 2) (3 * V))
    (heq : m * n = 2 * e * h + 1) (hz : z = m' * h) :
    U ^ 2 * V / (16 * E) < z ∧ z < 12 * U ^ 2 * V * P / E := by
  have hm0 : 0 < m := hU.trans_le hm.1
  have he0 : 0 < e := lt_trans (by positivity) he.1
  have hmnlo : U * V / 2 < m * n := by
    calc
      U * V / 2 = U * (V / 2) := by ring
      _ ≤ m * (V / 2) := mul_le_mul_of_nonneg_right hm.1 (by positivity)
      _ < m * n := mul_lt_mul_of_pos_left hn.1 hm0
  have hmnhi : m * n < 6 * U * V := by
    calc
      m * n < m * (3 * V) := mul_lt_mul_of_pos_left hn.2 hm0
      _ ≤ (2 * U) * (3 * V) := mul_le_mul_of_nonneg_right hm.2 (by positivity)
      _ = 6 * U * V := by ring
  have hehpos : 0 < e * h := by nlinarith
  have hh : 0 < h := (mul_pos_iff_of_pos_left he0).mp hehpos
  have hlo : U * V / 16 < E * h := by
    have hbound := mul_lt_mul_of_pos_right he.2 hh
    nlinarith
  have hhi : E * h < 6 * U * V * P := by
    have helow : E < 2 * P * e := by
      have hh := (div_lt_iff₀ (by positivity : 0 < 2 * P)).mp he.1
      nlinarith
    have hbound := mul_lt_mul_of_pos_right helow hh
    have hproduct := mul_lt_mul_of_pos_right hmnhi hP
    nlinarith [heq]
  have hElow : U ^ 2 * V / 16 < E * z := by
    have ha := mul_lt_mul_of_pos_left hlo hU
    have hb := mul_le_mul_of_nonneg_right hm'.1 (mul_nonneg hE.le hh.le)
    rw [hz]
    nlinarith
  have hEhigh : E * z < 12 * U ^ 2 * V * P := by
    have ha := mul_lt_mul_of_pos_left hhi (by positivity : 0 < 2 * U)
    have hb := mul_le_mul_of_nonneg_right hm'.2 (mul_nonneg hE.le hh.le)
    rw [hz]
    nlinarith
  constructor
  · apply (div_lt_iff₀ (by positivity : 0 < 16 * E)).mpr
    nlinarith
  · apply (lt_div_iff₀ hE).mpr
    nlinarith

theorem typeII_majorant_cross_scale_range {y : TypeIIShiftIndex} {L U V E : ℝ}
    (hL : 0 < L) (hU : 0 < U) (hV : 0 < V) (hE : 0 < E)
    (hUV : 4 ≤ U * V) (hk : y.1.1 ≠ 0)
    (hm : (y.2.1.1 : ℝ) ∈ Set.Icc U (2 * U))
    (hm' : (y.2.2.1 : ℝ) ∈ Set.Icc U (2 * U))
    (hz : y.1.2 = y.2.2.1 * y.2.1.2)
    (hne : typeIIEMajorant (L ^ 88) (typeIIRealE y / E) *
      typeIINMajorant (typeIIRealN y / V) ≠ 0) :
    U ^ 2 * V / (16 * E) < (y.1.2 : ℝ) ∧
      (y.1.2 : ℝ) < 12 * U ^ 2 * V * L ^ 88 / E := by
  obtain ⟨he, he', hn, hn'⟩ := typeII_majorant_real_box hL hE hV hne
  have hzr : (y.1.2 : ℝ) = (y.2.2.1 : ℝ) * y.2.1.2 := by exact_mod_cast hz
  have heq := typeII_real_cross_equation (k := (y.1.1 : ℝ)) (hU.trans_le hm.1).ne'
    (hU.trans_le hm'.1).ne' (by exact_mod_cast hk) hzr
  exact typeII_cross_scale_range hU hV hE (pow_pos hL _) hUV hm hm'
    ⟨he, he'⟩ ⟨hn, hn'⟩ heq hzr

end Bounty
end

section

/- Exact retained coefficient separation for the truncated active-slot integrals. -/

open Finset Filter MeasureTheory

namespace Bounty

theorem candidate_separated_allocation_box_integrable (c L : ℝ) (r jStar : ℕ) (R T : ℝ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) (F : ℕ → ℕ → ℂ) :
    Integrable (candidateSeparatedAllocationIntegrand c L r jStar R take F)
      (activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) T) := by
  have h := (integrable_finsetSum (s := (univ : Finset (∀ slot,
      candidateQSlotChoices c L r jStar slot))) (fun x hx =>
    (active_allocation_box_integrable (candidateAllocationRadius r) R T
      (fun i => Real.log (candidateAllocationValue c L r jStar x i))
      (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val)
      (candidateAllocationActive c L r jStar) take).mul_const
        (F (candidateAllocatedFactor c L r jStar x take)
          (candidateRetainedFactor c L r jStar 1 x take)))).div_const
      (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ)
  exact h.congr (Filter.Eventually.of_forall
    (candidate_separated_allocation_integrand_eq c L r jStar R take F))

theorem candidate_slot_box_integral (c L : ℝ) (r jStar : ℕ) (R T : ℝ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) (F : ℕ → ℕ → ℂ) :
    ((∑ x : ∀ slot, candidateQSlotChoices c L r jStar slot,
      (∫ ξ, activeAllocationFourierIntegrand (candidateAllocationRadius r) R
        (fun i => Real.log (candidateAllocationValue c L r jStar x i))
        (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val)
        (candidateAllocationActive c L r jStar) take ξ
          ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) T) *
      F (candidateAllocatedFactor c L r jStar x take)
        (candidateRetainedFactor c L r jStar 1 x take)) /
      (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ)) =
      ∫ ξ, candidateSeparatedAllocationIntegrand c L r jStar R take F ξ
        ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) T := by
  symm
  calc
    _ = ∫ ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ,
      (∑ x : ∀ slot, candidateQSlotChoices c L r jStar slot,
        activeAllocationFourierIntegrand (candidateAllocationRadius r) R
          (fun i => Real.log (candidateAllocationValue c L r jStar x i))
          (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val)
          (candidateAllocationActive c L r jStar) take ξ *
        F (candidateAllocatedFactor c L r jStar x take)
          (candidateRetainedFactor c L r jStar 1 x take)) /
        (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ)
        ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) T :=
      integral_congr_ae (Filter.Eventually.of_forall (fun ξ =>
        (candidate_separated_allocation_integrand_eq c L r jStar R take F ξ).symm))
    _ = _ := by
      rw [integral_div, integral_finsetSum]
      · simp only [integral_mul_const]
      · intro x hx
        exact (active_allocation_box_integrable _ _ _ _ _ _ _).mul_const _

theorem eventually_candidate_retained_box_integral {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ) (R T : ℝ) (S : Finset ℕ)
      (take : Fin ((candidateQIndices c L).card*r) → Bool),
      (∀ p ∈ S, p ∈ Nat.factoredNumbers
        ((candidatePIndices c L).biUnion (candidatePBand (c*L)))) →
      ∀ F : ℕ → ℕ → ℂ,
      Integrable (candidateRetainedAllocationIntegrand c L q r jStar R S take F)
        (activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) T) ∧
      (∑ p ∈ S, (candidatePWeight c L q p : ℂ) *
        ((∑ x : ∀ slot, candidateQSlotChoices c L r jStar slot,
          (∫ ξ, activeAllocationFourierIntegrand (candidateAllocationRadius r) R
            (fun i => Real.log (candidateAllocationValue c L r jStar x i))
            (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val)
            (candidateAllocationActive c L r jStar) take ξ
              ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) T) *
          F (candidateAllocatedFactor c L r jStar x take)
            (candidateRetainedFactor c L r jStar p x take)) /
          (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ))) =
        ∫ ξ, candidateRetainedAllocationIntegrand c L q r jStar R S take F ξ
          ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) T := by
  filter_upwards [eventually_candidate_retained_allocation_integrand_eq hc] with L heq
  intro q r jStar R T S take hS F
  have hint : Integrable (candidateFullPAllocationIntegrand c L q r jStar R S take F)
      (activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) T) := by
    apply integrable_finsetSum
    intro p hp
    exact (candidate_separated_allocation_box_integrable c L r jStar R T take
      (fun e n => F e (p*n))).const_mul _
  refine ⟨hint.congr (Filter.Eventually.of_forall (heq q r jStar R S take hS F)), ?_⟩
  calc
    _ = ∫ ξ, candidateFullPAllocationIntegrand c L q r jStar R S take F ξ
        ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) T := by
      unfold candidateFullPAllocationIntegrand
      rw [integral_finsetSum]
      · apply sum_congr rfl
        intro p hp
        rw [integral_const_mul]
        congr 1
        simp_rw [candidate_retained_factor_eq_mul_one c L r jStar p]
        exact candidate_slot_box_integral c L r jStar R T take (fun e n => F e (p*n))
      · intro p hp
        exact (candidate_separated_allocation_box_integrable c L r jStar R T take
          (fun e n => F e (p*n))).const_mul _
    _ = _ := integral_congr_ae (Filter.Eventually.of_forall (heq q r jStar R S take hS F))

end Bounty
end

section

/- Remove the original sharp window and truncate the allocation Fourier integrals together. -/

open Finset Filter MeasureTheory Real

namespace Bounty

theorem exists_candidate_original_box_mellin_reduction {c b q : ℝ}
    (hc : 0 < c) (hb : 0 < b) (hq0 : 0 ≤ q) (hq1 : q < 1) {r : ℕ} (hr : 6 ≤ r) :
    ∃ J : ℕ, ∀ jStar : ℕ, J < jStar → ∀ A D : ℝ,
      ∃ B : ℝ, 1 ≤ B ∧ ∃ K : ℝ, 0 < K ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (E : ℝ) (F : ℕ → ℕ → ℂ),
        1 ≤ E → log E ≤ (1-b)*L →
        (∀ u, ∀ m ∈ (2*u+1).divisors, ‖F u m‖ ≤ L^A) →
        (∀ u ∈ arithmeticProductWindow 1 (exp L), ∀ m ∈ (2*u+1).divisors,
          ¬(∀ p ∈ m.primeFactors, exp (sqrt L) ≤ (p : ℝ)) → F u m = 0) →
        Integrable (candidateBoxWindowMellinIntegrand c L q r jStar E B F) ∧
        ‖(∑ u ∈ arithmeticProductWindow 1 (exp L),
            (candidateCoefficient c L q r jStar u : ℂ)*∑ m ∈ (2*u+1).divisors, F u m) -
          (∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ L^K},
            candidateBoxWindowMellinIntegrand c L q r jStar E B F ξ)‖ ≤ exp L*L^(-D) := by
  obtain ⟨J,hJ⟩ := exists_candidate_original_box_reduction hc hb hq0 hq1 hr
  refine ⟨J,fun jStar hj A D => ?_⟩
  have hr0 : 0 < r := by omega
  obtain ⟨B,hB,hsmooth⟩ := exists_candidate_actual_window_smoothing_error_bound
    hc hr0 hq0 hq1 A (D+1)
  obtain ⟨K,hK,htrunc⟩ := exists_candidate_box_smooth_window_truncation_bound
    hc hr0 hq0 hq1 B (by linarith) A (D+1)
  refine ⟨B,hB,K,hK,?_⟩
  filter_upwards [hJ jStar hj A (D+1), hsmooth, htrunc,
    eventually_ge_atTop (3 : ℝ)] with L hboxL hsL htL hL
  intro E F hE hlogE hF hsupp
  have hL0 : 0 < L := by linarith
  let Fψ : ℕ → ℕ → ℂ := fun u m =>
    (typeIIWindowSmooth (L^(-B)) ((u : ℝ)/exp L) : ℂ)*F u m
  have hψF : ∀ u ∈ arithmeticProductWindow 1 (exp L),
      ∀ m ∈ (2*u+1).divisors, ‖Fψ u m‖ ≤ L^A := by
    intro u hu m hm
    dsimp only [Fψ]
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (typeII_window_smooth_bounds _ _).1]
    exact (mul_le_mul_of_nonneg_right (typeII_window_smooth_bounds _ _).2
      (norm_nonneg _)).trans (by simpa only [one_mul] using hF u m hm)
  have hψsupp : ∀ u ∈ arithmeticProductWindow 1 (exp L), ∀ m ∈ (2*u+1).divisors,
      ¬(∀ p ∈ m.primeFactors, exp (sqrt L) ≤ (p : ℝ)) → Fψ u m = 0 := by
    intro u hu m hm hp
    simp only [Fψ, hsupp u hu m hm hp, mul_zero]
  have hs := hsL jStar (candidateWindowBox L) F (arithmetic_window_subset_candidate_window_box L) hF
  have ha := hboxL E Fψ hE hlogE hψF hψsupp
  change ‖(∑ u ∈ arithmeticProductWindow 1 (exp L),
      (candidateCoefficient c L q r jStar u : ℂ) *
        ∑ m ∈ (2*u+1).divisors,
          (typeIIWindowSmooth (L^(-B)) ((u : ℝ)/exp L) : ℂ)*F u m) -
    (∑ u ∈ arithmeticProductWindow 1 (exp L),
      candidateBoxRangeCoefficient c L q r jStar E L u *
        ∑ m ∈ (2*u+1).divisors,
          (typeIIWindowSmooth (L^(-B)) ((u : ℝ)/exp L) : ℂ)*F u m)‖ ≤ _ at ha
  rw [← typeII_smooth_divisor_sum_restrict hL0, ← typeII_smooth_divisor_sum_restrict hL0] at ha
  have ht := htL jStar E F (fun u hu m hm => hF u m hm)
  refine ⟨candidate_box_window_mellin_integrable c L q r jStar E B F, ?_⟩
  let s₁ : ℂ := ∑ u ∈ candidateWindowBox L,
    (candidateCoefficient c L q r jStar u : ℂ) *
      (typeIIWindowSmooth (L^(-B)) ((u : ℝ)/exp L) : ℂ) *
        ∑ m ∈ (2*u+1).divisors, F u m
  let s₂ : ℂ := ∑ u ∈ candidateWindowBox L,
    candidateBoxRangeCoefficient c L q r jStar E L u *
      (typeIIWindowSmooth (L^(-B)) ((u : ℝ)/exp L) : ℂ) *
        ∑ m ∈ (2*u+1).divisors, F u m
  calc
    _ ≤ ‖(∑ u ∈ arithmeticProductWindow 1 (exp L),
          (candidateCoefficient c L q r jStar u : ℂ)*∑ m ∈ (2*u+1).divisors, F u m)-s₁‖ +
        ‖s₁-(∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ L^K},
          candidateBoxWindowMellinIntegrand c L q r jStar E B F ξ)‖ :=
      norm_sub_le_norm_sub_add_norm_sub _ s₁ _
    _ ≤ exp L*L^(-(D+1)) + (‖s₁-s₂‖ +
        ‖s₂-(∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ L^K},
          candidateBoxWindowMellinIntegrand c L q r jStar E B F ξ)‖) :=
      add_le_add hs (norm_sub_le_norm_sub_add_norm_sub _ s₂ _)
    _ ≤ exp L*L^(-(D+1)) + (exp L*L^(-(D+1)) + exp L*L^(-(D+1))) :=
      add_le_add le_rfl (add_le_add ha ht)
    _ = 3*(exp L*L^(-(D+1))) := by ring
    _ ≤ L*(exp L*L^(-(D+1))) := mul_le_mul_of_nonneg_right hL (by positivity)
    _ = exp L*(L^(1:ℝ)*L^(-(D+1))) := by rw [rpow_one]; ring
    _ = exp L*L^(-D) := by rw [← rpow_add hL0]; congr 2; ring

end Bounty
end

section

/- Expand original ledger freshness on common initial and event addresses, retaining the exact dependent paths and all local residual coefficients. -/

open Finset Classical
namespace Bounty
section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, DecidableEq (P g)]
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ)
  (edgePhase : ∀ k, ((g : Fin N) → Finset (P g)) →
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) →
    FullActiveEdgeEvent n (S k) B (A k) (Δ k) (D k) x → ℂ)
  (ω : ∀ k c, A k c → ℝ) (μ : (g : Fin N) → P g → ℝ)
  (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ) (steps : List (Option (J ⊕ K)))

theorem full_mixed_common_ledger_forest_expansion {Ω : Type*}
    (hedge : ∀ k H x e, edgePhase k H x e =
      (if FullMixedLocalBirthAvoids (J := J) n S B A Δ D H (some (.inr k)) x e ∧
          FullMixedLocalBirthDistinct (J := J) n S B A Δ D (some (.inr k)) x e then 1 else 0) *
        edgePhase k (fun _ => ∅) x e)
    (paths : Finset Ω)
    (x : Ω → ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : ∀ a, FullPermutationMixedPath n S B A Δ D steps (x a))
    (hx : ∀ a ∈ paths, FullActiveInjective (x a))
    (hcover : ∀ a ∈ paths, FullMixedLedgerCovers n B (fullActiveInitialLedger (x a), x a))
    (F : Ω → ℂ) (encode : ((g : Fin N) × P g) → ℤ) (hencode : Function.Injective encode) :
    (∑ a ∈ paths, F a *
      (finiteEventPathWeight (FullPermutationMixedEvent n S B A Δ D)
        (fullPermutationMixedEventTarget n S B A Δ D)
        (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V) steps (x a) (p a) : ℂ) *
      fullMixedLedgerInducedPhase n S B A Δ D steps fullActiveInitialLedger
        (finiteEventLocalPhase
          (fun tag (s : FullMixedLedgerState n (M := M) B) =>
            FullPermutationMixedEvent n S B A Δ D tag s.2)
          (fullMixedLedgerTarget n S B A Δ D) (fullMixedLedgerPhase n S B A Δ D edgePhase) steps) (x a) (p a)) =
    ∑ code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)),
      (-1 : ℂ) ^ birthForestRank code * birthForestPathSum paths
        (fun a => F a * fullMixedCommonResidualWeight n S B A Δ D edgePhase ω μ q ρ V steps (x a) (p a))
        (fun a => fullMixedCommonIndexedPerformed n S B A Δ D steps (x a) (p a))
        (fun a => fullMixedCommonIndexedValue n S B A Δ D steps encode (x a) (p a)) code := by
  rw [← full_mixed_common_path_forest_expansion n S B A Δ D steps paths x p hx encode hencode
    (fun a => F a * fullMixedCommonResidualWeight n S B A Δ D edgePhase ω μ q ρ V steps (x a) (p a))]
  apply sum_congr rfl
  intro a ha
  rw [mul_assoc, full_mixed_physical_weighted_phase_factor n S B A Δ D edgePhase hedge
    ω μ q ρ V steps fullActiveInitialLedger (x a) (p a) (hcover a ha)]
  unfold fullMixedCommonResidualWeight
  ring

end Full
end Bounty
end

section

/- A common forest coefficient is an actual original path action with no root-ledger gate left in its residual factor. -/

open Finset Classical
namespace Bounty
section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
  [∀ g, DecidableEq (P g)] (n : (g : Fin N) → P g → ℕ) [∀ g p, NeZero (n g p)]
  {M : Fin N → ℕ} (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
  (Δ D : ∀ k c, A k c → Fin N → ℤ)
  (edgePhase : ∀ k, ((g : Fin N) → Finset (P g)) →
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) →
    FullActiveEdgeEvent n (S k) B (A k) (Δ k) (D k) x → ℂ)
  (ω : ∀ k c, A k c → ℝ) (μ : (g : Fin N) → P g → ℝ)
  (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ) (steps : List (Option (J ⊕ K)))

noncomputable def fullMixedCommonForestAction
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) : ℂ :=
  fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps
    (fun s p => if birthForestCompatible (fullMixedCommonIndexedPerformed n S B A Δ D steps s p)
      (fun i => fullMixedCommonBirthLabel n S B A Δ D steps s p (fullMixedCommonBirthOrder M B steps i)) code
      then finiteEventLocalPhase (FullPermutationMixedEvent n S B A Δ D)
        (fullPermutationMixedEventTarget n S B A Δ D)
        (fullMixedBirthResidualPhase n S B A Δ D edgePhase) steps s p else 0) f x

omit [∀ g, DecidableEq (P g)] in
theorem full_mixed_common_forest_action_eq
    (encode : ((g : Fin N) × P g) → ℤ) (hinj : Function.Injective encode)
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    let _ : ∀ (tag : Option (J ⊕ K)) x, Fintype (FullPermutationMixedEvent n S B A Δ D tag x) :=
      fullPermutationMixedEventFintype n S B A Δ D
    let _ := finiteEventPathFintype (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x
    fullMixedCommonForestAction n S B A Δ D edgePhase ω μ q ρ V steps code f x =
      birthForestPathSum univ
        (fun p => f (finiteEventPathTerminal (FullPermutationMixedEvent n S B A Δ D)
          (fullPermutationMixedEventTarget n S B A Δ D) steps x p) *
          fullMixedCommonResidualWeight n S B A Δ D edgePhase ω μ q ρ V steps x p)
        (fullMixedCommonIndexedPerformed n S B A Δ D steps x)
        (fullMixedCommonIndexedValue n S B A Δ D steps encode x) code := by
  dsimp only
  unfold fullMixedCommonForestAction fullPermutationMixedPathAction finiteEventPathAction birthForestPathSum
  apply sum_congr rfl
  intro p _
  dsimp only
  have he := optional_forest_encoding_iff
    (fullMixedCommonIndexedPerformed n S B A Δ D steps x p)
    (fun i => fullMixedCommonBirthLabel n S B A Δ D steps x p (fullMixedCommonBirthOrder M B steps i))
    (fun _ h => h) encode hinj code
  change birthForestCompatible (fullMixedCommonIndexedPerformed n S B A Δ D steps x p)
    (fullMixedCommonIndexedValue n S B A Δ D steps encode x p) code ↔ _ at he
  rw [he]
  unfold fullMixedCommonResidualWeight
  split_ifs <;> ring

end Full
end Bounty
end

