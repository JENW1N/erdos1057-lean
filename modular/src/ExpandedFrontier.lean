      0 < UM → 1 ≤ UT → 0 ≤ BM → 0 ≤ BT → BM*BT ≤ L^E → BT ≤ L^Et →
      (∀ n ∈ D, ‖α n‖ ≤ BM) → (∀ n ∈ F, ‖γ n‖ ≤ BT) →
      (∀ n ∈ D, UM ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*UM) →
      (∀ n ∈ F, UT ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*UT) →
