    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps))) :
    (fullMixedBirthAffectedOperations S B steps code).card ≤ 2 * birthForestRank code :=
  birthForestAffectedOperations_card_le code (fullMixedIndexedBirthOwner S B steps)

theorem full_mixed_birth_forest_edge_owner_le
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))
    {i j : Fin (Fintype.card (FullMixedBirthAddress S B steps))}
    (h : (i, j) ∈ birthForestEdges code) :
