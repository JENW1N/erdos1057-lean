section

/- Uniform polynomial cost of the actual diagonal cutoff moment. -/

open Finset Filter Real

namespace Bounty

theorem eventually_typeII_diagonal_moment_cost {C : ℝ} (hC : 0 ≤ C) :
    ∀ᶠ L : ℝ in atTop, ∀ X : ℝ, 1 ≤ X → log X ≤ C*L →
      2*(⌊6*X⌋₊ : ℝ)*(1+log (⌊6*X⌋₊ : ℝ))^15 ≤ X*L^(16 : ℝ) := by
  filter_upwards [eventually_ge_atTop (1 : ℝ),
    eventually_ge_atTop (12*(1+C+log 6)^15 : ℝ)] with L hL hK
  intro X hX hlogX
  have hX0 : 0 < X := by linarith
  have hNpos : (0 : ℝ) < ⌊6*X⌋₊ := by
    exact_mod_cast (Nat.floor_pos.mpr (show 1 ≤ 6*X by linarith))
  have hNle : (⌊6*X⌋₊ : ℝ) ≤ 6*X := Nat.floor_le (by positivity)
  have h6 : 0 ≤ log 6 := log_nonneg (by norm_num)
  have hlog : 1+log (⌊6*X⌋₊ : ℝ) ≤ (1+C+log 6)*L := by
    have hh := log_le_log hNpos hNle
    rw [log_mul (by norm_num : (6 : ℝ) ≠ 0) hX0.ne'] at hh
    nlinarith
  calc
    _ ≤ (12*X)*((1+C+log 6)*L)^15 :=
      mul_le_mul (by linarith) (pow_le_pow_left₀ (by positivity) hlog 15)
        (by positivity) (by positivity)
    _ = (12*(1+C+log 6)^15)*X*L^15 := by rw [mul_pow]; ring
    _ ≤ L*X*L^15 := mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right hK hX0.le) (pow_nonneg (by linarith) _)
    _ = X*L^(16 : ℝ) := by norm_num only [rpow_ofNat]; ring

end Bounty
end

section

/- Apply the proved Mellin cutoff to the actual candidate test on its coarse finite support. -/

open Finset Filter MeasureTheory Real

namespace Bounty

noncomputable def candidateFiniteMellinIntegrand (c L q : ℝ) (r jStar : ℕ)
    (E B : ℝ) (S : Finset ℕ) (F : ℕ → ℕ → ℂ) (ξ : ℝ) : ℂ :=
  finiteWindowMellinIntegrand L B (S)
    (candidateBoxRangeCoefficient c L q r jStar E L)
    (fun u => ∑ m ∈ (2*u+1).divisors, F u m) ξ

theorem candidate_finite_mellin_integrable (c L q : ℝ) (r jStar : ℕ)
    (E B : ℝ) (S : Finset ℕ) (F : ℕ → ℕ → ℂ) (hS : ∀ u ∈ S, 0 < u) :
    Integrable (candidateFiniteMellinIntegrand c L q r jStar E B S F) := by
  apply finite_window_mellin_integrable
  intro u hu
  exact hS u hu

theorem exists_candidate_finite_smooth_mellin_bound {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (R : ℝ) (hR : 1 ≤ R) (B : ℝ) (hB : 0 ≤ B) (A D : ℝ) :
    ∃ K : ℝ, 0 < K ∧ ∀ᶠ L : ℝ in atTop, ∀ (jStar : ℕ) (E : ℝ) (S : Finset ℕ) (F : ℕ → ℕ → ℂ),
      (∀ u ∈ S, 0 < u ∧ (u : ℝ) ≤ R*exp L) →
      (∀ u ∈ S, ∀ m ∈ (2*u+1).divisors, ‖F u m‖ ≤ L^A) →
      ‖(∑ u ∈ S, candidateBoxRangeCoefficient c L q r jStar E L u *
          (typeIIWindowSmooth (L^(-B)) ((u:ℝ)/exp L) : ℂ) *
          (∑ m ∈ (2*u+1).divisors, F u m)) -
        (∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ L^K}, candidateFiniteMellinIntegrand c L q r jStar E B S F ξ)‖ ≤
          exp L * L^(-D) := by
  obtain ⟨C, hC, hmass⟩ := exists_candidate_finite_test_absolute_bound hc hr hq0 hq1 R hR A
  let precision := C+max D 0+1
  have hprecision : 0 ≤ precision := by dsimp [precision]; positivity
  obtain ⟨K, hK, hcut⟩ := typeII_window_mellin_power_cutoff hB hprecision
  refine ⟨K, hK, ?_⟩
  filter_upwards [hmass, hcut, eventually_candidate_box_norm_bound hc r,
    eventually_ge_atTop (2 : ℝ)] with L hmassL hcutL hnorm hL
  intro jStar E S F hS hF
  have hL0 : 0 < L := by linarith
  have hfinite := finite_window_mellin_error_le L B (S)
    (candidateBoxRangeCoefficient c L q r jStar E L)
    (fun u => ∑ m ∈ (2*u+1).divisors, F u m)
    (fun u => (typeIIWindowSmooth (L^(-B)) ((u:ℝ)/exp L) : ℂ))
    (fun u hu => (hS u hu).1)
    {ξ : ℝ | ‖ξ‖ ≤ L^K} (L^(-precision)) (by
      intro u hu
      have hup : (0 : ℝ) < u := by exact_mod_cast (hS u hu).1
      simpa only [mul_one, Complex.ofReal_natCast, Complex.ofReal_one, Complex.one_cpow,
        candidateWindowMellinKernel] using
        hcutL (u:ℝ) 1 (exp L) hup (by norm_num) (exp_pos L))
  change ‖(∑ u ∈ S, _ ) -
    (∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ L^K}, candidateFiniteMellinIntegrand c L q r jStar E B S F ξ)‖ ≤ _ at hfinite
  have hweights : (∑ u ∈ S,
      ‖candidateBoxRangeCoefficient c L q r jStar E L u‖ * ‖∑ m ∈ (2*u+1).divisors, F u m‖) ≤
      2*(exp L * L^C) := by
    calc
      _ ≤ ∑ u ∈ S,
          2*(candidateCoefficient c L q r jStar u * ∑ m ∈ (2*u+1).divisors, ‖F u m‖) := by
        apply sum_le_sum
        intro u hu
        have hh := mul_le_mul (hnorm q hq0 jStar E u) (norm_sum_le (2*u+1).divisors (fun m => F u m))
          (norm_nonneg (∑ m ∈ (2*u+1).divisors, F u m)) (mul_nonneg (by norm_num) (candidate_coefficient_nonneg c L hq0 r jStar u))
        simpa only [mul_assoc] using hh
      _ = 2*(∑ u ∈ S,
          candidateCoefficient c L q r jStar u * ∑ m ∈ (2*u+1).divisors, ‖F u m‖) :=
        (mul_sum ..).symm
      _ ≤ _ := mul_le_mul_of_nonneg_left (hmassL jStar S F hS hF) (by norm_num)
  apply hfinite.trans
  calc
    _ ≤ L^(-precision)*(2*(exp L*L^C)) :=
      mul_le_mul_of_nonneg_left hweights (rpow_nonneg hL0.le _)
    _ ≤ L^(-precision)*(L*(exp L*L^C)) :=
      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hL (by positivity)) (by positivity)
    _ = exp L*(L^(-precision)*(L^(1:ℝ)*L^C)) := by rw [rpow_one]; ring
    _ = exp L*L^(-max D 0) := by
      rw [← rpow_add hL0, ← rpow_add hL0]
      congr 2
      dsimp [precision]
      ring
    _ ≤ exp L*L^(-D) := mul_le_mul_of_nonneg_left
      (rpow_le_rpow_of_exponent_le (by linarith) (neg_le_neg (le_max_left _ _))) (exp_pos _).le

end Bounty
end

section

/- Order the actual independent samples by their common global addresses, retaining their original owner and group. -/

namespace Bounty
section Ghost
variable {J K : Type*} {N : ℕ} {P Z : Fin N → Type*} {M : Fin N → ℕ}
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ) (j : J)
    (steps : List (Option (J ⊕ K))) (u : Fin steps.length) (htag : steps.get u = some (.inl j))
    (s : ProductBoundedOrderedState P Z M B) (sk : CoupledGhostSkeleton M B s)

noncomputable def fullMixedCommonGhostSampleEmbedding :
    CoupledGhostSampleIndex M B s sk ↪ Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) :=
  (fullMixedGhostOwnerSampleEmbedding S B j steps u htag s sk).trans
    (fullMixedCommonOldIndexEmbedding S B steps)

noncomputable def fullMixedCommonGhostSampleOrder :
    Fin (Fintype.card (CoupledGhostSampleIndex M B s sk)) ≃ CoupledGhostSampleIndex M B s sk :=
  finiteEmbeddedOrder (fullMixedCommonGhostSampleEmbedding S B j steps u htag s sk)

theorem full_mixed_common_ghost_sample_strictMono :
    StrictMono (fun i => fullMixedCommonGhostSampleEmbedding S B j steps u htag s sk
      (fullMixedCommonGhostSampleOrder S B j steps u htag s sk i)) :=
  finite_embedded_order_strictMono _

theorem full_mixed_common_ghost_sample_owner (i : CoupledGhostSampleIndex M B s sk) :
    fullMixedCommonIndexStage M B steps (fullMixedCommonGhostSampleEmbedding S B j steps u htag s sk i) = u.succ := by
  change fullMixedCommonIndexStage M B steps (fullMixedCommonOldIndexEmbedding S B steps
    (fullMixedGhostOwnerSampleEmbedding S B j steps u htag s sk i)) = _
  rw [full_mixed_common_old_index_stage, full_mixed_ghost_owner_sample_owner]

theorem full_mixed_common_ghost_sample_group (i : CoupledGhostSampleIndex M B s sk) :
    fullMixedCommonBirthGroup M B steps (fullMixedCommonBirthOrder M B steps
      (fullMixedCommonGhostSampleEmbedding S B j steps u htag s sk i)) = i.1 := by
  change fullMixedCommonBirthGroup M B steps (fullMixedCommonBirthOrder M B steps
    (fullMixedCommonOldIndexEmbedding S B steps (fullMixedGhostOwnerSampleEmbedding S B j steps u htag s sk i))) = _
  rw [full_mixed_common_old_index_group, full_mixed_ghost_owner_sample_group]

end Ghost

section Edge
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ) (k : K)
    (steps : List (Option (J ⊕ K))) (u : Fin steps.length) (htag : steps.get u = some (.inr k))
    (A : SharedActiveLabels P (S k) → Type*) (Δ D : ∀ c, A c → Fin N → ℤ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (sk : FullActiveEdgeSkeleton n (S k) B A Δ D s)

noncomputable def fullMixedCommonEdgeSampleEmbedding :
    FullActiveEdgeSampleIndex n (S k) B A Δ D s sk ↪ Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) :=
  (fullMixedEdgeOwnerSampleEmbedding n S B k steps u htag A Δ D s sk).trans
    (fullMixedCommonOldIndexEmbedding S B steps)

noncomputable def fullMixedCommonEdgeSampleOrder :
    Fin (Fintype.card (FullActiveEdgeSampleIndex n (S k) B A Δ D s sk)) ≃
      FullActiveEdgeSampleIndex n (S k) B A Δ D s sk :=
  finiteEmbeddedOrder (fullMixedCommonEdgeSampleEmbedding n S B k steps u htag A Δ D s sk)

theorem full_mixed_common_edge_sample_strictMono :
    StrictMono (fun i => fullMixedCommonEdgeSampleEmbedding n S B k steps u htag A Δ D s sk
      (fullMixedCommonEdgeSampleOrder n S B k steps u htag A Δ D s sk i)) :=
  finite_embedded_order_strictMono _

theorem full_mixed_common_edge_sample_owner (i : FullActiveEdgeSampleIndex n (S k) B A Δ D s sk) :
    fullMixedCommonIndexStage M B steps (fullMixedCommonEdgeSampleEmbedding n S B k steps u htag A Δ D s sk i) = u.succ := by
  change fullMixedCommonIndexStage M B steps (fullMixedCommonOldIndexEmbedding S B steps
    (fullMixedEdgeOwnerSampleEmbedding n S B k steps u htag A Δ D s sk i)) = _
  rw [full_mixed_common_old_index_stage, full_mixed_edge_owner_sample_owner]

theorem full_mixed_common_edge_sample_group (i : FullActiveEdgeSampleIndex n (S k) B A Δ D s sk) :
    fullMixedCommonBirthGroup M B steps (fullMixedCommonBirthOrder M B steps
      (fullMixedCommonEdgeSampleEmbedding n S B k steps u htag A Δ D s sk i)) = i.1 := by
  change fullMixedCommonBirthGroup M B steps (fullMixedCommonBirthOrder M B steps
    (fullMixedCommonOldIndexEmbedding S B steps (fullMixedEdgeOwnerSampleEmbedding n S B k steps u htag A Δ D s sk i))) = _
