/- The untouched edge row is the full original residual edge row, with initial avoidance. -/

open Finset Classical
namespace Bounty

theorem full_mixed_untouched_edge_row
    {J K : Type*} {N : ℕ} {P : Fin N → Type*}
    [∀ g, Fintype (P g)] [∀ g, DecidableEq (P g)]
    (n : (g : Fin N) → P g → ℕ) [∀ g p, NeZero (n g p)]
    {M : Fin N → ℕ} (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (ω : ∀ k c, A k c → ℝ) (μ : (g : Fin N) → P g → ℝ)
    (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (steps : List (Option (J ⊕ K)))
    (edgePhase : ∀ k, ((g : Fin N) → Finset (P g)) →
      (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) →
      FullActiveEdgeEvent n (S k) B (A k) (Δ k) (D k) s → ℂ)
    (initial : (g : Fin N) → Finset (P g))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))
    (θ : (Fin (Fintype.card (FullMixedBirthAddress S B steps)) ×
      Fin (Fintype.card (FullMixedBirthAddress S B steps))) → ℝ)
    (encode : ((g : Fin N) × P g) → ℤ) (i : Fin steps.length)
    (hi : i ∉ fullMixedBirthAffectedOperations S B steps code)
    (k : K) (htag : steps.get i = some (.inr k))
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    fullMixedForestStageRow n S B A Δ D ω μ q ρ V steps
      (fullMixedBirthResidualPhase n S B A Δ D edgePhase) initial code θ encode i f s =
    ∑ e : FullActiveEdgeEvent n (S k) B (A k) (Δ k) (D k) s,
      (fullActiveEdgeEventWeight n (S k) B (A k) (Δ k) (D k) (ω k) μ ρ V s e : ℂ) *
      (edgePhase k (fun _ => ∅) s e *
        (if FullMixedLocalBirthAvoids (J := J) n S B A Δ D initial (some (.inr k)) s e
          then 1 else 0)) *
      f (fullActiveEdgeEventTarget n (S k) B (A k) (Δ k) (D k) s e) := by
  rw [full_mixed_untouched_stage_row n S B A Δ D ω μ q ρ V steps
    (fullMixedBirthResidualPhase n S B A Δ D edgePhase) initial code θ encode i hi]
  generalize ht : steps.get i = tag
  have ht' : tag = some (.inr k) := ht.symm.trans htag
  clear ht
  subst tag
  dsimp only [fullMixedBirthResidualPhase, fullPermutationMixedEventWeight,
    fullMixedMemoryEventWeight, fullPermutationMixedEventTarget, fullMixedMemoryEventTarget]
  apply sum_congr
  · exact congrArg (fun h : Fintype _ => @Finset.univ _ h) (Subsingleton.elim _ _)
  · intro e _
    rfl

end Bounty
