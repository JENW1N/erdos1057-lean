open Finset
theorem sieve_weight_harmonic_tsum_eq (P : Finset ℕ) (D : ℝ) (lam : ℕ → ℝ)
    (hsupport : ∀ d, lam d ≠ 0 → 0 < d ∧ (d : ℝ) ≤ D ∧ d ∣ ∏ p ∈ P, p) :
    (∑' d : ℕ, |lam d| / (d : ℝ)) = ∑ d ∈ blockSieveModuli P D, |lam d| / (d : ℝ) := by
  apply tsum_eq_sum
  intro d hd
  have hzero : lam d = 0 := by
    by_contra hn
    obtain ⟨hd0, hdD, hdP⟩ := hsupport d hn
    exact hd (mem_filter.mpr ⟨mem_Icc.mpr ⟨hd0, Nat.le_floor hdD⟩, hdP⟩)
  simp only [hzero, abs_zero, zero_div]

theorem exists_rough_integer_polynomial :
    ∃ K : ℝ, 0 < K ∧ ∀ {z : ℝ}, 1 < z → ∀ h : ℕ, 1 ≤ h → Even h →
      ∃ lam : ℕ → ℝ,
        (∀ d, |lam d| ≤ 1) ∧
        (∀ d, lam d ≠ 0 → 0 < d ∧ (d : ℝ) ≤ z^(4 * (h : ℝ) + 2) ∧
          Squarefree d ∧ d ∣ ∏ p ∈ primeBand 0 z, p) ∧
        (∀ n : ℕ, n ≠ 0 → 0 ≤ ∑ d ∈ n.divisors, lam d ∧
          (if ∀ p ∈ n.primeFactors, z < (p : ℝ) then (1 : ℝ) else 0) ≤
            ∑ d ∈ n.divisors, lam d) ∧
        (∑' d : ℕ, |lam d| / (d : ℝ)) ≤ K * Real.log (2 * z) ∧
        ∀ a b : ℝ, 0 ≤ a → a ≤ b →
          let M := (∑ n ∈ Ioc ⌊a⌋₊ ⌊b⌋₊, ∑ d ∈ n.divisors, lam d) -
            ((roughBand a b z).card : ℝ)
          0 ≤ M ∧ M ≤ K * ((b - a) * Real.exp (-(h : ℝ)) + z^(4 * (h : ℝ) + 2)) := by
  obtain ⟨K, hK, hweights⟩ := exists_rough_integer_divisor_weights
  let C := K + primeEulerProductUpperConstant + 1
  have hC : 0 < C := by dsimp [C]; linarith [primeEulerProductUpperConstant_pos]
  refine ⟨C, hC, ?_⟩
  intro z hz h hh heven
  obtain ⟨lam, habs, hsupport, hpoint, hharm, hover⟩ := hweights hz h hh heven
  refine ⟨lam, habs, hsupport, hpoint, ?_, ?_⟩
  · rw [sieve_weight_harmonic_tsum_eq (primeBand 0 z) (z^(4 * (h : ℝ) + 2)) lam
      (fun d hd => ⟨(hsupport d hd).1, (hsupport d hd).2.1, (hsupport d hd).2.2.2⟩)]
    apply hharm.trans
    apply (finite_prime_euler_product_le_log (primeBand 0 z)
      (fun _ hp => small_prime_pool_prime hp) hz.le
      (fun _ hp => small_prime_pool_le (zero_lt_one.trans hz).le hp)).trans
    apply mul_le_mul_of_nonneg_right
    · dsimp [C]
      linarith
    · exact Real.log_nonneg (by linarith)
  · intro a b ha hab
    have hr := real_interval_rough_overcount lam hz.le hK.le hover ha hab
    dsimp only at hr ⊢
    refine ⟨hr.1, hr.2.trans ?_⟩
    apply mul_le_mul_of_nonneg_right
    · dsimp [C]
      linarith [primeEulerProductUpperConstant_pos]
    · exact add_nonneg (mul_nonneg (sub_nonneg.mpr hab) (Real.exp_pos _).le)
        (Real.rpow_nonneg (zero_lt_one.trans hz).le _)
end

