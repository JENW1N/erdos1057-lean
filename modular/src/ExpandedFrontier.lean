section

/- The localized cross-product scale satisfies the actual Fourier parameter envelope. -/

namespace Bounty

theorem typeII_localized_scale_ratio {L U V E Z K₀ : ℝ}
    (hL : 24 ≤ L) (hU : 0 < U) (hV : 0 < V)
    (hE : E = U * L ^ (-K₀))
    (hZ : Z ≤ 24 * U ^ 2 * V * L ^ 88 / E) :
    Z / (U * V) ≤ L ^ (K₀ + 89) := by
  have hL0 : 0 < L := by linarith
  have hp : L ^ K₀ ≠ 0 := (Real.rpow_pos_of_pos hL0 K₀).ne'
  have heq : (24 * U ^ 2 * V * L ^ 88 / E) / (U * V) =
      24 * L ^ (K₀ + 88) := by
    rw [hE, Real.rpow_neg hL0.le, Real.rpow_add hL0]
    norm_num
    field_simp
  have hratio := div_le_div_of_nonneg_right hZ (mul_pos hU hV).le
  rw [heq] at hratio
  have hshift : L ^ (K₀ + 89) = L ^ (K₀ + 88) * L := by
    rw [show K₀ + 89 = (K₀ + 88) + 1 by ring, Real.rpow_add hL0, Real.rpow_one]
  rw [hshift]
  exact hratio.trans (by nlinarith [Real.rpow_pos_of_pos hL0 (K₀ + 88)])

theorem typeII_localized_parameter_envelope {L U V E Z K₀ : ℝ} {k : ℤ}
    (hL : 24 ≤ L) (hU : 0 < U) (hV : 0 < V) (hZ0 : 0 ≤ Z) (hk : k ≠ 0)
    (hE : E = U * L ^ (-K₀)) (hUV : 1 ≤ U * V)
    (hZ : Z ≤ 24 * U ^ 2 * V * L ^ 88 / E) :
    ‖typeIIScaleParameters L U V E Z k‖ ≤
      L ^ typeIIScaleEnvelopeExponent K₀ (K₀ + 89) := by
  exact typeII_scale_parameter_envelope (by linarith) hU hV hZ0 hk hE hUV
    (typeII_localized_scale_ratio hL hU hV hE hZ)

end Bounty
end

section

/- A smooth dyadic partition, preserving the exterior spatial cutoff. -/

open Finset
open scoped ContDiff

namespace Bounty

noncomputable def typeIISmoothDyadic (t : ℝ) : ℝ :=
  Real.smoothTransition (2 * t - 1) - Real.smoothTransition (t - 1)

theorem typeII_smooth_dyadic_contDiff : ContDiff ℝ ∞ typeIISmoothDyadic := by
  unfold typeIISmoothDyadic
  fun_prop

theorem typeII_smooth_dyadic_zero {t : ℝ} (ht : t ≤ 1 / 2 ∨ 2 ≤ t) :
    typeIISmoothDyadic t = 0 := by
  unfold typeIISmoothDyadic
  rcases ht with ht | ht
  · rw [Real.smoothTransition.zero_of_nonpos (by linarith),
      Real.smoothTransition.zero_of_nonpos (by linarith), sub_self]
  · rw [Real.smoothTransition.one_of_one_le (by linarith),
      Real.smoothTransition.one_of_one_le (by linarith), sub_self]

theorem typeII_smooth_dyadic_bounds (t : ℝ) :
    0 ≤ typeIISmoothDyadic t ∧ typeIISmoothDyadic t ≤ 1 := by
  by_cases ht : t ≤ 1 / 2
  · rw [typeII_smooth_dyadic_zero (Or.inl ht)]
    norm_num
  · have hp : Real.smoothTransition (t - 1) ≤ Real.smoothTransition (2 * t - 1) :=
      Real.smoothTransition.monotone (by linarith)
    unfold typeIISmoothDyadic
    constructor
    · linarith
    · linarith [Real.smoothTransition.le_one (2 * t - 1), Real.smoothTransition.nonneg (t - 1)]

theorem typeII_smooth_dyadic_support {t : ℝ} (ht : typeIISmoothDyadic t ≠ 0) :
    t ∈ Set.Ioo (1 / 2) 2 := by
  constructor
  · by_contra h
    exact ht (typeII_smooth_dyadic_zero (Or.inl (le_of_not_gt h)))
  · by_contra h
    exact ht (typeII_smooth_dyadic_zero (Or.inr (le_of_not_gt h)))

theorem typeII_smooth_dyadic_telescope (x : ℝ) (N : ℕ) :
    ∑ j ∈ range (N + 1), typeIISmoothDyadic (x / 2 ^ j) =
      Real.smoothTransition (2 * x - 1) - Real.smoothTransition (x / 2 ^ N - 1) := by
  induction N with
  | zero => simp [typeIISmoothDyadic]
  | succ N ih =>
    rw [sum_range_succ, ih, typeIISmoothDyadic]
    have heq : 2 * (x / (2 : ℝ) ^ (N + 1)) = x / 2 ^ N := by
      rw [pow_succ]
      ring
    rw [heq]
    ring

theorem typeII_smooth_dyadic_partition {x : ℝ} {N : ℕ}
    (hx : 1 ≤ x) (hN : x ≤ (2 : ℝ) ^ N) :
    ∑ j ∈ range (N + 1), typeIISmoothDyadic (x / 2 ^ j) = 1 := by
  rw [typeII_smooth_dyadic_telescope]
  have hdiv : x / (2 : ℝ) ^ N ≤ 1 := (div_le_one (by positivity)).mpr hN
  rw [Real.smoothTransition.one_of_one_le (by linarith),
    Real.smoothTransition.zero_of_nonpos (by linarith)]
  norm_num

theorem typeII_smooth_dyadic_partition_log {x R : ℝ}
    (hx : 1 ≤ x) (hR : x ≤ R) :
    ∑ j ∈ range (⌈Real.logb 2 R⌉₊ + 1), typeIISmoothDyadic (x / 2 ^ j) = 1 := by
  apply typeII_smooth_dyadic_partition hx
  apply hR.trans
  rw [← Real.rpow_natCast]
  apply (Real.logb_le_iff_le_rpow (by norm_num) (zero_lt_one.trans_le (hx.trans hR))).mp
  exact Nat.le_ceil _

theorem typeII_smooth_dyadic_log_box {t : ℝ} (ht : typeIISmoothDyadic t ≠ 0) :
    Real.log t ∈ Set.Icc (-1) 1 := by
  have hs := typeII_smooth_dyadic_support ht
  have ht0 : 0 < t := by linarith [hs.1]
  have hu := Real.log_le_sub_one_of_pos ht0
  have hinv : 0 < t⁻¹ := inv_pos.mpr ht0
  have hinvlt : t⁻¹ < 2 := by
    rw [inv_eq_one_div]
    apply (div_lt_iff₀ ht0).mpr
    linarith [hs.1]
  have hl := Real.log_le_sub_one_of_pos hinv
  rw [Real.log_inv] at hl
  constructor <;> linarith [hs.2]

end Bounty
end

section

/- The original candidate test is reduced directly to the actual retained box integrals. -/

open Finset Filter MeasureTheory Real

namespace Bounty

theorem exists_candidate_original_retained_box_reduction {c b q : ℝ}
    (hc : 0 < c) (hb : 0 < b) (hq0 : 0 ≤ q) (hq1 : q < 1) {r : ℕ} (hr : 6 ≤ r) :
    ∃ J : ℕ, ∀ jStar : ℕ, J < jStar → ∀ A D : ℝ,
      ∀ᶠ L : ℝ in atTop, ∀ (E : ℝ) (F : ℕ → ℕ → ℂ),
        1 ≤ E → log E ≤ (1-b)*L →
        (∀ u ∈ arithmeticProductWindow 1 (exp L), ∀ m ∈ (2*u+1).divisors, ‖F u m‖ ≤ L^A) →
        (∀ u ∈ arithmeticProductWindow 1 (exp L), ∀ m ∈ (2*u+1).divisors,
          ¬(∀ p ∈ m.primeFactors, exp (sqrt L) ≤ (p : ℝ)) → F u m = 0) →
        ‖(∑ u ∈ arithmeticProductWindow 1 (exp L),
            (candidateCoefficient c L q r jStar u : ℂ)*∑ m ∈ (2*u+1).divisors, F u m) -
          ∑ take ∈ (univ : Finset (Fin ((candidateQIndices c L).card*r) → Bool)).filter
            (fun take => ∀ i, candidateAllocationActive c L r jStar i = false → take i = false),
            ∫ ξ, candidateRetainedAllocationIntegrand c L q r jStar (log E)
              (candidateSmallPSet c L (16*exp L+1)) take
              (candidateBoxArithmeticTest L E (fun u => ∑ m ∈ (2*u+1).divisors, F u m)) ξ
              ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) L‖ ≤
          exp L*L^(-D) := by
  obtain ⟨J,hJ⟩ := exists_candidate_original_box_reduction hc hb hq0 hq1 hr
  refine ⟨J,fun jStar hj A D => ?_⟩
  filter_upwards [hJ jStar hj A D, eventually_candidate_box_retained_integrals hc] with L hL heq
  intro E F hE hlogE hF hsupp
  rw [← heq q r jStar E L (fun u => ∑ m ∈ (2*u+1).divisors, F u m)]
  exact hL E F hE hlogE hF hsupp

end Bounty
end

section

/- The full box coefficient is the sum of the actual truncated retained integrals. -/

open Finset Filter MeasureTheory

namespace Bounty

noncomputable def candidateBoxFiniteTest (L E : ℝ) (S : Finset ℕ) (G : ℕ → ℂ) (e h : ℕ) : ℂ :=
  if (E/L^88 ≤ (e : ℝ) ∧ (e : ℝ) ≤ E) ∧ e*h ∈ S
  then G (e*h) else 0

theorem candidate_box_single_P_finite_patterns (c L : ℝ) (r jStar p : ℕ) (E R : ℝ) (S : Finset ℕ) (G : ℕ → ℂ) :
    (∑ x : ∀ slot, candidateQSlotChoices c L r jStar slot,
      candidateBoxRangeAllocationMass c L r jStar x E R *
        (if p*orderedSlotProduct (candidateQSlotChoices c L r jStar) x ∈ S
          then G (p*orderedSlotProduct (candidateQSlotChoices c L r jStar) x) else 0) /
          (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ)) =
    ∑ take ∈ (univ : Finset (Fin ((candidateQIndices c L).card*r) → Bool)).filter
      (fun take => ∀ i, candidateAllocationActive c L r jStar i = false → take i = false),
      (∑ x : ∀ slot, candidateQSlotChoices c L r jStar slot,
        (∫ ξ, activeAllocationFourierIntegrand (candidateAllocationRadius r) (Real.log E)
          (fun i => Real.log (candidateAllocationValue c L r jStar x i))
          (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val)
          (candidateAllocationActive c L r jStar) take ξ
            ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) R) *
        candidateBoxFiniteTest L E S G (candidateAllocatedFactor c L r jStar x take)
          (candidateRetainedFactor c L r jStar p x take)) /
          (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ) := by
  classical
  unfold candidateBoxRangeAllocationMass
  rw [sum_filter]
  simp only [sum_mul, sum_div]
  rw [sum_comm]
  apply sum_congr rfl
  intro take ht
  by_cases hk : ∀ i, candidateAllocationActive c L r jStar i = false → take i = false
  · have hkeq : (∀ i, candidateAllocationActive c L r jStar i = false → take i = false) = True :=
      propext (iff_true_intro hk)
    simp only [hkeq, true_and, if_true]
    apply sum_congr rfl
    intro x hx
    simp only [candidateBoxFiniteTest, candidate_allocation_factorization]
    by_cases he : E/L^88 ≤ (candidateAllocatedFactor c L r jStar x take : ℝ) ∧
      (candidateAllocatedFactor c L r jStar x take : ℝ) ≤ E
    · by_cases hw : p*orderedSlotProduct (candidateQSlotChoices c L r jStar) x ∈
        S
      · simp only [he, hw, and_self, if_true]
      · simp only [he, hw, true_and, if_false, mul_zero, zero_div]
    · simp only [he, false_and, if_false, zero_mul, mul_zero, zero_div]
  · simp only [hk, false_and, if_false, zero_mul, zero_div, sum_const_zero]

theorem eventually_candidate_box_finite_retained_integrals {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ) (E R X : ℝ) (S : Finset ℕ) (G : ℕ → ℂ),
      (∀ u ∈ S, 0 < u ∧ (u : ℝ) ≤ X) →
      (∑ u ∈ S,
        candidateBoxRangeCoefficient c L q r jStar E R u*G u) =
      ∑ take ∈ (univ : Finset (Fin ((candidateQIndices c L).card*r) → Bool)).filter
        (fun take => ∀ i, candidateAllocationActive c L r jStar i = false → take i = false),
        ∫ ξ, candidateRetainedAllocationIntegrand c L q r jStar (Real.log E)
          (candidateSmallPSet c L (X+1)) take (candidateBoxFiniteTest L E S G) ξ
          ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) R := by
  classical
  filter_upwards [eventually_candidate_box_finite_convolution hc,
    eventually_candidate_retained_box_integral hc] with L hconv hint
  intro q r jStar E R X S G hS
  rw [hconv q r jStar E R X S G hS]
  simp_rw [candidate_box_Q_test, candidate_box_single_P_finite_patterns, mul_sum]
  rw [sum_comm]
  apply sum_congr rfl
  intro take ht
  exact (hint q r jStar (Real.log E) R _ take (fun p hp =>
    ((mem_candidateSmallPSet_iff c L _ p).mp hp).2) (candidateBoxFiniteTest L E S G)).2

end Bounty
end

section

/- The actual signed family of clean mixed rows factors through the two
canonical big projections. No norm estimate or assumed pairing is used.
The initial forbidden sets stay fixed, and both endpoint gates stay inside
small conditioning in their original order. -/

open Finset
open scoped Classical

namespace Bounty

section

variable {I S G : Type*} [Fintype I] [Fintype S] [Fintype G]
    [DecidableEq S] [DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    [∀ p : PhysicalPrime Ps, NeZero p.2.val] [∀ g (p : P g), NeZero p.val]

noncomputable def physicalMixedGatedCleanPatternAction
    (initial : ∀ g, Finset (P g)) (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : I → G → Finset (Fin J)) (ζ θ ρ : ℝ) (k : ℤ)
    (K : ∀ i, RepeatedBigLists P J ell → RepeatedBigLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ)
    (Vs : S → ℝ) (q : ℝ)
    (sourceGate targetGate f : PhysicalSmallBigState Ps J ell
      (CleanFullMemoryState P J ell B) → ℂ)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B)) : ℂ :=
  ∑ i, physicalMixedGatedCleanAction initial V b (C i) ζ θ ρ k (K i)
    Vs q sourceGate targetGate f s

theorem physical_mixed_gated_clean_pattern_pairing
    (initial : ∀ g, Finset (P g)) (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : I → G → Finset (Fin J)) (ζ θ ρ : ℝ) (k : ℤ)
    (K : ∀ i, RepeatedBigLists P J ell → RepeatedBigLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ)
    (Vs : S → ℝ) (hVs : ∀ s, 0 < Vs s) (q : ℝ)
    (W : CleanFullMemoryState P J ell B → ℝ)
    (smallAux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))))
    (sourceGate targetGate u f : PhysicalSmallBigState Ps J ell
      (CleanFullMemoryState P J ell B) → ℂ) :
    (∑ s, (physicalSmallBigMeasure Vs W s : ℂ) * (starRingEnd ℂ) (u s) *
      physicalMixedGatedCleanPatternAction initial V b C ζ θ ρ k K Vs q
        sourceGate targetGate f s) =
      ∑ d, ∑ r, ∑ x, (W x : ℂ) *
        (starRingEnd ℂ) (physicalSmallBigCondition Vs q (fun s => sourceGate s * u s) d x r) *
        (∑ i, physicalMixedCleanInitialAction initial V b (C i) ζ θ ρ k (K i) d
          (physicalSmallBigCondition Vs q (fun s => targetGate s * f s) d) x r) := by
  simp only [physicalMixedGatedCleanPatternAction, mul_sum]
  rw [sum_comm]
  simp_rw [physical_mixed_gated_clean_pairing initial V b _ ζ θ ρ k _
    Vs hVs q W smallAux sourceGate targetGate u f]
  rw [sum_comm]
  apply sum_congr rfl
  intro d _
  rw [sum_comm]
  apply sum_congr rfl
  intro r _
  exact sum_comm

omit [DecidableEq S] [∀ p : PhysicalPrime Ps, NeZero p.2.val] in
theorem physical_mixed_clean_pattern_projected_reencode
    (initial : ∀ g, Finset (P g)) (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : I → G → Finset (Fin J)) (ζ θ ρ : ℝ) (k : ℤ)
    (K : ∀ i, RepeatedBigLists P J ell → RepeatedBigLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : CleanFullMemoryState P J ell B → PhysicalResidues Ps → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun x => f x r))
    (hPs : ∀ s p, p ∈ Ps s → 0 < p) (hP : ∀ g p, p ∈ P g → 0 < p) :
    cleanFullMemoryActiveMap (fun x r =>
      ∑ i, physicalMixedCleanInitialAction initial V b (C i) ζ θ ρ k (K i) d
        (cleanFullMemoryActiveMap f) x r) =
    cleanFullMemoryActiveMap (cleanFullMemoryInitialPatternEventAction initial V b C ζ θ ρ k
      (fun i => canonicalMixedEdgeD (C i) d) K d (cleanFullMemoryActiveMap f)) := by
  funext x r
  have hs (F : I → CleanFullMemoryState P J ell B → PhysicalResidues Ps → ℂ) :
      cleanFullMemoryActiveMap (fun y rs => ∑ i, F i y rs) x r =
        ∑ i, cleanFullMemoryActiveMap (F i) x r := by
    simp only [cleanFullMemoryActiveMap, fullActiveAverage, mul_sum]
    exact sum_comm
  rw [hs]
  change _ = cleanFullMemoryActiveMap (fun y rs =>
    ∑ i, cleanFullMemoryInitialEventAction initial V b (C i) ζ θ ρ k
      (canonicalMixedEdgeD (C i) d) (K i) d (cleanFullMemoryActiveMap f) y rs) x r
  rw [hs]
  apply sum_congr rfl
  intro i _
  exact congrFun (congrFun (physical_mixed_clean_initial_projected_reencode initial V b
    (C i) ζ θ ρ k (K i) d f hf hPs hP) x) r

end

end Bounty
end

section

/- The signed raw-minus-comparison prime family on the genuine mixed state.
Both endpoint slot averages, the original auxiliary law, and the fixed
fresh-birth initial exclusion remain in the actual operator. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_small_big_joint_average_sum
    {I S G : Type*} [Fintype I] [Fintype S] [DecidableEq S]
    [Fintype G] [DecidableEq G] {Ps : S → Finset ℕ} {P Z : G → Type*}
    {J ell B : ℕ} {M : G → ℕ}
    (F : I → PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ) :
    physicalSmallBigJointAverage (∑ i, F i) = ∑ i, physicalSmallBigJointAverage (F i) := by
  funext s
  rw [physical_small_big_joint_average_eq_sum]
  simp only [Finset.sum_apply, mul_sum]
  rw [sum_comm]
  apply sum_congr rfl
  intro i _
  exact (physical_small_big_joint_average_eq_sum (F i) s).symm

section
variable {S G : Type} [Fintype S] [Fintype G] [DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}

noncomputable def physicalMixedRepeatedLabels (C : G → Finset (Fin J))
    (x : CleanFullMemoryState P J ell B) : RepeatedBigLists P J ell :=
  fun g j => (x g).1 ((physicalFullSlotIndex (C g)).symm j)

noncomputable def physicalMixedCoefficientTarget (C : G → Finset (Fin J)) (k : ℤ)
    (a : PhysicalAuxLabels P C)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B))
    (e : PhysicalMixedCoefficientEvent C k a s) :
    PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) :=
  physicalSmallBigTarget (PhysicalSmallBigFullEvent (fun g (p : P g) => p.val)
    (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
    (fun d c g => physicalMixedEdgeDelta C k d c a g)
    (fun d c g => physicalMixedEdgeD C d c a g))
    (physicalSmallBigFullTarget (fun g (p : P g) => p.val)
      (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
      (fun d c g => physicalMixedEdgeDelta C k d c a g)
      (fun d c g => physicalMixedEdgeD C d c a g))
    (fun x => physicalMixedBigStep C k
      (productActiveMemorySplit (fun g => physicalFullSharedIndices (ell := ell) (C g)) B x).1 a) s e

noncomputable def physicalMixedPrimePatternAction
    (V : G → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ) (Vs : S → ℝ) (q : ℝ)
    (probes : G → Finset (Fin J)) (r t : Finset G) (hrt : Disjoint r t)
    (Q : ℕ) (h ξ : ℝ) (k : ℤ) (initial : ∀ g, Finset (P g))
    (φ : ∀ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      ∀ a (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B)),
        PhysicalMixedCoefficientEvent (repeatedBigPrimePatternCut probes r t i) k a s → ℂ)
    (f : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ) :=
  let kept := fun U : Finset (RepeatedBigFlatIndex G J ell) => primeProductRetainedCells
    (fun j : U => P j.val.1) (fun j => V j.val.1) h ξ
  ∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
    physicalMixedCoefficientAction (repeatedBigPrimePatternCut probes r t i) k V baseline ρ Vs q initial
      (fun a s e => repeatedBigPrimePatternWeight probes r t i *
        repeatedBigPrimePatternKernel P V probes r t hrt Q h kept i
          (physicalMixedRepeatedLabels (repeatedBigPrimePatternCut probes r t i) s.2)
          (physicalMixedRepeatedLabels (repeatedBigPrimePatternCut probes r t i)
            (physicalMixedCoefficientTarget (repeatedBigPrimePatternCut probes r t i) k a s e).2) a *
        φ i a s e) f
end

theorem exists_physical_mixed_prime_pattern_projected_norm_bound
    {q vs : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hvs : 0 < vs) (ell : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (S G : Type) [Fintype S] [DecidableEq S]
      [Fintype G] [DecidableEq G] (Ps : S → Finset ℕ)
      [∀ p : PhysicalPrime Ps, NeZero p.2.val] (P : G → Finset ℕ)
      [∀ g (p : P g), NeZero p.val] (J B m : ℕ)
      (V : G → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ) (Vs : S → ℝ)
      (probes : G → Finset (Fin J)) (r t : Finset G) (hrt : Disjoint r t),
      (∀ g, (probes g).card ≤ m) → ∀ (Q : ℕ) (h ξ : ℝ), 0 < ξ →
      ∀ (k : ℤ) (initial : ∀ g, Finset (P g)), (∀ s, vs ≤ Vs s) →
      (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) →
      (∀ g p, 1 / 2 ≤ baseline g p ∧ baseline g p ≤ 1) →
      ∀ (v vmin vmax : ℝ), 0 < ρ → ρ < 1 → 1 < v → 0 < vmin →
      (∀ g, vmin ≤ V g) → (∀ g, V g ≤ vmax) →
      ∀ (φ : ∀ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
        ∀ a (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B)),
          PhysicalMixedCoefficientEvent (repeatedBigPrimePatternCut probes r t i) k a s → ℂ),
      (∀ i a s e, ‖φ i a s e‖ ≤ 1) →
      ∀ f : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ,
      (∀ s, ProductMemorySymmetric (fun x => f (s,x))) →
      let μ := fun g => tiltedPhysicalBirthLaw V g (baseline g)
      let W := productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))
      cleanActiveNorm (physicalSmallBigMeasure Vs W)
        (physicalSmallBigJointAverage (physicalMixedPrimePatternAction V baseline ρ Vs q
          probes r t hrt Q h ξ k initial φ (physicalSmallBigJointAverage f))) ≤
      repeatedBigFamilyEnvelope (Fintype.card G) m Q ξ * A ^ Fintype.card S *
        Real.sqrt (unrestrictedEdgeEnergyBound ρ v vmin vmax (ell + m) ^ Fintype.card G) *
          cleanActiveNorm (physicalSmallBigMeasure Vs W) f := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_mixed_coefficient_projected_norm_bound hq0 hq1 hvs ell
  refine ⟨A, hA, ?_⟩
  intro S G _ dS _ dG
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  intro Ps _ P _ J B m V baseline ρ Vs probes r t hrt hp Q h ξ hξ k initial hVs hMass hbaseline
    v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi φ hφ f hf μ W
  let C := repeatedBigPrimePatternCut (ell := ell) probes r t
  let kept := fun U : Finset (RepeatedBigFlatIndex G J ell) => primeProductRetainedCells
    (fun j : U => P j.val.1) (fun j => V j.val.1) h ξ
  let K := repeatedBigPrimePatternKernel P V probes r t hrt Q h kept
  let b := repeatedBigPrimePatternBound (ell := ell) probes r t Q ξ
  let Ψ := fun i a s (e : PhysicalMixedCoefficientEvent (B := B) (C i) k a s) =>
    repeatedBigPrimePatternWeight probes r t i * K i
      (physicalMixedRepeatedLabels (C i) s.2)
      (physicalMixedRepeatedLabels (C i) (physicalMixedCoefficientTarget (C i) k a s e).2) a * φ i a s e
  have hb : ∀ i, 0 ≤ b i := repeated_big_prime_pattern_bound_nonneg probes r t Q ξ
  have hΨ : ∀ i a s e, ‖Ψ i a s e‖ ≤ b i := by
    intro i a s e
    dsimp only [Ψ]
    rw [norm_mul, norm_mul, repeated_big_prime_pattern_weight_norm, one_mul]
    exact (mul_le_mul_of_nonneg_right
      (repeated_big_prime_pattern_kernel_norm_le P V probes r t hrt Q h ξ hξ i _ _ a)
      (norm_nonneg _)).trans ((mul_le_mul_of_nonneg_left (hφ i a s e) (hb i)).trans_eq (mul_one _))
  have hsum : ∑ i, b i ≤ repeatedBigFamilyEnvelope (Fintype.card G) m Q ξ := by
    apply (repeated_big_prime_pattern_bound_sum_le (ell := ell) probes r t hp Q ξ).trans
    apply add_le_add le_rfl
    apply mul_le_mul_of_nonneg_right _ (sq_nonneg _)
    apply pow_le_pow_right₀ (by norm_num : (1 : ℝ) ≤ 2)
    apply Nat.mul_le_mul_left
    rw [← card_union_of_disjoint hrt]
    exact card_le_univ _
  have hμ : ∀ g p, 0 ≤ μ g p := fun g p =>
    tiltedPhysicalBirthLaw_nonneg V g (baseline g) (hvmin.trans_le (hVlo g)).le
      (fun p => (by norm_num : (0 : ℝ) ≤ 1/2).trans (hbaseline g p).1) p
  have hW : ∀ x, 0 ≤ W x := productMemoryWeight_nonneg μ _ hμ (fun g z => hμ g z.1)
  let u := fun i => physicalSmallBigJointAverage
    (physicalMixedCoefficientAction (C i) k V baseline ρ Vs q initial (Ψ i)
      (physicalSmallBigJointAverage f))
  have heq : physicalSmallBigJointAverage (physicalMixedPrimePatternAction V baseline ρ Vs q
      probes r t hrt Q h ξ k initial φ (physicalSmallBigJointAverage f)) = ∑ i, u i :=
    physical_small_big_joint_average_sum _
  calc
    _ = cleanActiveNorm (physicalSmallBigMeasure Vs W) (∑ i, u i) := by
      congr 1
    _ ≤ ∑ i, cleanActiveNorm (physicalSmallBigMeasure Vs W) (u i) :=
      clean_active_norm_sum_le _
        (physical_small_big_measure_nonneg Vs (fun s => hvs.trans_le (hVs s)) W hW) univ u
    _ ≤ ∑ i, b i * A ^ Fintype.card S *
        Real.sqrt (unrestrictedEdgeEnergyBound ρ v vmin vmax (ell + m) ^ Fintype.card G) *
        cleanActiveNorm (physicalSmallBigMeasure Vs W) f := by
      apply sum_le_sum
      intro i _
      exact hbound S G Ps P J B (C i) k V baseline ρ Vs initial hVs hMass hbaseline
        v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi (ell+m)
        (fun g => Nat.add_le_add_left (repeated_big_prime_pattern_cut_card_le probes r t hp i g) ell)
        (Ψ i) (b i) (hb i) (hΨ i) f hf
    _ = (∑ i, b i) * A ^ Fintype.card S *
        Real.sqrt (unrestrictedEdgeEnergyBound ρ v vmin vmax (ell + m) ^ Fintype.card G) *
        cleanActiveNorm (physicalSmallBigMeasure Vs W) f := by rw [sum_mul, sum_mul, sum_mul]
    _ ≤ _ := mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right hsum (pow_nonneg (zero_le_one.trans hA) _))
        (Real.sqrt_nonneg _)) (Real.sqrt_nonneg _)

end Bounty
end

section

/- The actual auxiliary-averaged mixed coefficient row preserves pending
symmetry when its signed phase observes the two active endpoints and the
store, promotion-slot and fresh-label data. The fixed initial exclusion is
applied to fresh births before the original auxiliary sum. -/

open Finset Classical
namespace Bounty

section
variable {S G : Type} [Fintype S] [Fintype G] [dG : DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Finset ℕ}
  [∀ g (p : P g), NeZero p.val] {J ell B : ℕ}
  (C : G → Finset (Fin J)) (k : ℤ)

noncomputable def physicalMixedCoefficientReindex
    (a : PhysicalAuxLabels P C)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B))
    (τ : ∀ g, Equiv.Perm (Fin (s.2 g).2.1.val)) :=
  physicalSmallBigEventMemoryReindex (fun g (p : P g) => p.val)
    (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
    (fun d c g => physicalMixedEdgeDelta C k d c a g)
    (fun d c g => physicalMixedEdgeD C d c a g) s τ

noncomputable def physicalMixedCoefficientObservablePhase
    (a : PhysicalAuxLabels P C)
    (Φ : PhysicalBareResidueState Ps J ell → PhysicalBareResidueState Ps J ell →
      (∀ g, Fin (J + ell) → P g) → (∀ g, Fin (J + ell) → P g) →
      (∀ g, EdgeDrawObservation (P g) (physicalFullSharedIndices (ell := ell) (C g))ᶜ.card) → ℂ) :=
  physicalSmallBigObservablePhase (fun g (p : P g) => p.val)
    (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
    (fun d c g => physicalMixedEdgeDelta C k d c a g)
    (fun d c g => physicalMixedEdgeD C d c a g)
    (fun c => physicalMixedBigStep C k c a) Φ

omit dG in
theorem physical_mixed_coefficient_observable_reindex
    (a : PhysicalAuxLabels P C)
    (Φ : PhysicalBareResidueState Ps J ell → PhysicalBareResidueState Ps J ell →
      (∀ g, Fin (J + ell) → P g) → (∀ g, Fin (J + ell) → P g) →
      (∀ g, EdgeDrawObservation (P g) (physicalFullSharedIndices (ell := ell) (C g))ᶜ.card) → ℂ)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B))
    (τ : ∀ g, Equiv.Perm (Fin (s.2 g).2.1.val)) (e : PhysicalMixedCoefficientEvent C k a s) :
    physicalMixedCoefficientObservablePhase C k a Φ (s.1, productMemoryReindex s.2 τ)
      (physicalMixedCoefficientReindex C k a s τ e) =
      physicalMixedCoefficientObservablePhase C k a Φ s e :=
  physical_small_big_observable_phase_reindex _ _ B _ _ _ Φ s τ e

theorem physical_mixed_coefficient_signed_memory_symmetric
    (V : G → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ) (Vs : S → ℝ) (q : ℝ)
    (initial : ∀ g, Finset (P g))
    (Ψ : ∀ a (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B)),
      PhysicalMixedCoefficientEvent C k a s → ℂ)
    (hΨ : ∀ a (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B))
      (τ : ∀ g, Equiv.Perm (Fin (s.2 g).2.1.val)) (e : PhysicalMixedCoefficientEvent C k a s),
      Ψ a (s.1, productMemoryReindex s.2 τ) (physicalMixedCoefficientReindex C k a s τ e) = Ψ a s e)
    (f : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ)
    (hf : ∀ s, ProductMemorySymmetric (fun x => f (s,x))) :
    ∀ s, ProductMemorySymmetric (fun x =>
      physicalMixedCoefficientAction C k V baseline ρ Vs q initial Ψ f (s,x)) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  intro s x g τ
  unfold physicalMixedCoefficientAction
  apply sum_congr rfl
  intro a _
  apply congrArg (fun z : ℂ => (physicalAuxMass V C a : ℂ) * z)
  have hphase : ∀ (y : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B))
      (σ : ∀ h, Equiv.Perm (Fin (y.2 h).2.1.val)) (e : PhysicalMixedCoefficientEvent C k a y),
      (if ∀ h i, ((physicalMixedCoefficientReindex C k a y σ e).2.2 h).2.2.2 i ∉ initial h then
        Ψ a (y.1, productMemoryReindex y.2 σ) (physicalMixedCoefficientReindex C k a y σ e) else 0) =
      (if ∀ h i, (e.2.2 h).2.2.2 i ∉ initial h then Ψ a y e else 0) := by
    intro y σ e
    change (if ∀ h i, (e.2.2 h).2.2.2 i ∉ initial h then
        Ψ a (y.1, productMemoryReindex y.2 σ) (physicalMixedCoefficientReindex C k a y σ e) else 0) = _
    rw [hΨ a y σ e]
  exact physical_small_big_full_signed_memory_symmetric _ _ B _ _ _ ρ V _ Vs q _ hphase f hf s x g τ

theorem physical_mixed_coefficient_observable_memory_symmetric
    (V : G → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ) (Vs : S → ℝ) (q : ℝ)
    (initial : ∀ g, Finset (P g))
    (Φ : PhysicalAuxLabels P C →
      PhysicalBareResidueState Ps J ell → PhysicalBareResidueState Ps J ell →
      (∀ g, Fin (J + ell) → P g) → (∀ g, Fin (J + ell) → P g) →
      (∀ g, EdgeDrawObservation (P g) (physicalFullSharedIndices (ell := ell) (C g))ᶜ.card) → ℂ)
    (f : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ)
    (hf : ∀ s, ProductMemorySymmetric (fun x => f (s,x))) :
    ∀ s, ProductMemorySymmetric (fun x => physicalMixedCoefficientAction C k V baseline ρ Vs q initial
      (fun a => physicalMixedCoefficientObservablePhase C k a (Φ a)) f (s,x)) :=
  physical_mixed_coefficient_signed_memory_symmetric C k V baseline ρ Vs q initial _
    (fun a => physical_mixed_coefficient_observable_reindex C k a (Φ a)) f hf

theorem physical_mixed_coefficient_observable_projected_memory_symmetric [DecidableEq S]
    (V : G → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ) (Vs : S → ℝ) (q : ℝ)
    (initial : ∀ g, Finset (P g))
    (Φ : PhysicalAuxLabels P C →
      PhysicalBareResidueState Ps J ell → PhysicalBareResidueState Ps J ell →
      (∀ g, Fin (J + ell) → P g) → (∀ g, Fin (J + ell) → P g) →
      (∀ g, EdgeDrawObservation (P g) (physicalFullSharedIndices (ell := ell) (C g))ᶜ.card) → ℂ)
    (f : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ)
    (hf : ∀ s, ProductMemorySymmetric (fun x => f (s,x))) :
    ∀ s, ProductMemorySymmetric (fun x => physicalSmallBigJointAverage
      (physicalMixedCoefficientAction C k V baseline ρ Vs q initial
        (fun a => physicalMixedCoefficientObservablePhase C k a (Φ a))
        (physicalSmallBigJointAverage f)) (s,x)) :=
  physical_small_big_joint_average_memory_symmetric _
    (physical_mixed_coefficient_observable_memory_symmetric C k V baseline ρ Vs q initial Φ _
      (physical_small_big_joint_average_memory_symmetric f hf))

end
end Bounty
end

section

/- Exact scalar normalization for the actual auxiliary-averaged mixed row.
The fixed initial exclusion remains inside every event coefficient. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_small_big_joint_average_smul
    {S G : Type*} [Fintype S] [DecidableEq S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {P Z : G → Type*} {J ell B : ℕ} {M : G → ℕ}
    (c : ℂ) (f : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ) :
    physicalSmallBigJointAverage (c • f) = c • physicalSmallBigJointAverage f := by
  funext s
  simp only [physical_small_big_joint_average_eq_sum, Pi.smul_apply, smul_eq_mul, mul_sum]
  apply sum_congr rfl
  intro e _
  ring

section
variable {S G : Type} [Fintype S] [Fintype G] [DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
  (C : G → Finset (Fin J)) (k : ℤ)
  (V : G → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ) (Vs : S → ℝ) (q : ℝ)
  (initial : ∀ g, Finset (P g))
  (Ψ : ∀ a (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B)),
    PhysicalMixedCoefficientEvent C k a s → ℂ)
  (f : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ)

theorem physical_mixed_coefficient_phase_mul (c : ℂ) :
    physicalMixedCoefficientAction C k V baseline ρ Vs q initial
      (fun a s e => c * Ψ a s e) f =
      c • physicalMixedCoefficientAction C k V baseline ρ Vs q initial Ψ f := by
  funext s
  simp only [physicalMixedCoefficientAction, physicalSmallBigFullPhasedAction,
    physicalSmallBigPhasedAction, Pi.smul_apply, smul_eq_mul, mul_sum]
  apply sum_congr rfl
  intro a _
  apply sum_congr rfl
  intro e _
  split_ifs <;> ring

theorem physical_mixed_coefficient_phase_normalize (c : ℝ)
    (hΨ : ∀ a s e, ‖Ψ a s e‖ ≤ c) :
    physicalMixedCoefficientAction C k V baseline ρ Vs q initial Ψ f =
      (c : ℂ) • physicalMixedCoefficientAction C k V baseline ρ Vs q initial
        (fun a s e => Ψ a s e / (c : ℂ)) f := by
  rw [← physical_mixed_coefficient_phase_mul]
  congr 1
  funext a s e
  exact (real_bound_mul_div_eq (hΨ a s e)).symm
end
end Bounty
end

section

/- The actual ghost and edge sample sums split by fixed skeleton support without altering the continuation. -/

open Finset Classical

namespace Bounty

section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)] {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K))) (u : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P))
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))

section Ghost
variable [∀ g p, NeZero (n g p)] (j : J) (htag : steps.get u = some (.inl j)) (sk : CoupledGhostSkeleton M B s)

theorem full_mixed_common_ghost_skeleton_stage_sum (F : CoupledGhostSamples M B s sk → ℝ) :
    let embed := fun i => (fullMixedCommonGhostSampleEmbedding S B j steps u htag s sk) ((fullMixedCommonGhostSampleOrder S B j steps u htag s sk) i)
    let owner := fullMixedCommonIndexStage M B steps
    let values := fun births => fullMixedCommonHistoryWrite n S B A Δ D steps u s
      (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inl j)) htag s ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩)) history
    let localValues := fun births i => (⟨(fullMixedCommonGhostSampleOrder S B j steps u htag s sk i).1, (births (fullMixedCommonGhostSampleOrder S B j steps u htag s sk i)).1⟩ : Sigma P)
    (∑ births : CoupledGhostSamples M B s sk,
      if birthForestStageCondition owner u.succ (values births) code then F births else 0) =
      if birthForestStageSupport owner u.succ (ownerSampleSupport embed owner u.succ history) code then
        ∑ births : CoupledGhostSamples M B s sk,
          if birthForestEqualValues (restrictedBirthCode embed code) (localValues births) ∧
            birthLabelsAnchored (fun i => (restrictedBirthAnchors embed code history i).join) (localValues births)
          then F births else 0
      else 0 := by
  dsimp only
  have h := owner_sample_stage_sum (fun i => (fullMixedCommonGhostSampleEmbedding S B j steps u htag s sk) ((fullMixedCommonGhostSampleOrder S B j steps u htag s sk) i))
    (full_mixed_common_ghost_sample_strictMono S B j steps u htag s sk)
    (fullMixedCommonIndexStage M B steps)
    (full_mixed_common_index_stage_monotone M B steps) u.succ
    (fun i => full_mixed_common_ghost_sample_owner S B j steps u htag s sk (fullMixedCommonGhostSampleOrder S B j steps u htag s sk i))
    code (fun births => fullMixedCommonHistoryWrite n S B A Δ D steps u s
      (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inl j)) htag s ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩)) history)
    history (fun births i => (⟨(fullMixedCommonGhostSampleOrder S B j steps u htag s sk i).1, (births (fullMixedCommonGhostSampleOrder S B j steps u htag s sk i)).1⟩ : Sigma P))
    (by
      intro births i
      constructor
      · intro hi
        obtain ⟨c, hc⟩ := (full_mixed_common_ghost_history_sample_coverage n S B A Δ D steps u s history
          j htag sk births i).mp hi
        refine ⟨(fullMixedCommonGhostSampleOrder S B j steps u htag s sk).symm c, ?_⟩
        dsimp only
        rw [Equiv.apply_symm_apply]
        exact hc
      · rintro ⟨i, rfl⟩
        exact (full_mixed_common_ghost_history_sample_coverage n S B A Δ D steps u s history
          j htag sk births _).mpr ⟨(fullMixedCommonGhostSampleOrder S B j steps u htag s sk) i, rfl⟩)
    (fun births i hi => full_mixed_common_history_write_other n S B A Δ D steps u s _ history i (full_mixed_common_history_owner_ne M B steps u i hi))
    (fun births i => full_mixed_common_ghost_history_sample_label n S B A Δ D steps u s history
      j htag sk births (fullMixedCommonGhostSampleOrder S B j steps u htag s sk i)) F
  convert h using 1
  split_ifs
  · apply sum_congr rfl
    intro z _
    split_ifs <;> rfl
  · rfl


end Ghost

section Edge
variable (k : K) (htag : steps.get u = some (.inr k)) (sk : FullActiveEdgeSkeleton n (S k) B (A k) (Δ k) (D k) s)

theorem full_mixed_common_edge_skeleton_stage_sum (F : FullActiveEdgeSamples n (S k) B (A k) (Δ k) (D k) s sk → ℝ) :
    let embed := fun i => (fullMixedCommonEdgeSampleEmbedding n S B k steps u htag (A k) (Δ k) (D k) s sk) ((fullMixedCommonEdgeSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk) i)
    let owner := fullMixedCommonIndexStage M B steps
    let values := fun fresh => fullMixedCommonHistoryWrite n S B A Δ D steps u s
      (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inr k)) htag s ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm ⟨sk, fresh⟩)) history
    let localValues := fun fresh i => (⟨(fullMixedCommonEdgeSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk i).1, fresh (fullMixedCommonEdgeSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk i)⟩ : Sigma P)
    (∑ fresh : FullActiveEdgeSamples n (S k) B (A k) (Δ k) (D k) s sk,
      if birthForestStageCondition owner u.succ (values fresh) code then F fresh else 0) =
      if birthForestStageSupport owner u.succ (ownerSampleSupport embed owner u.succ history) code then
        ∑ fresh : FullActiveEdgeSamples n (S k) B (A k) (Δ k) (D k) s sk,
          if birthForestEqualValues (restrictedBirthCode embed code) (localValues fresh) ∧
            birthLabelsAnchored (fun i => (restrictedBirthAnchors embed code history i).join) (localValues fresh)
          then F fresh else 0
      else 0 := by
  dsimp only
  have h := owner_sample_stage_sum (fun i => (fullMixedCommonEdgeSampleEmbedding n S B k steps u htag (A k) (Δ k) (D k) s sk) ((fullMixedCommonEdgeSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk) i))
    (full_mixed_common_edge_sample_strictMono n S B k steps u htag (A k) (Δ k) (D k) s sk)
    (fullMixedCommonIndexStage M B steps)
    (full_mixed_common_index_stage_monotone M B steps) u.succ
    (fun i => full_mixed_common_edge_sample_owner n S B k steps u htag (A k) (Δ k) (D k) s sk (fullMixedCommonEdgeSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk i))
    code (fun fresh => fullMixedCommonHistoryWrite n S B A Δ D steps u s
      (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inr k)) htag s ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm ⟨sk, fresh⟩)) history)
    history (fun fresh i => (⟨(fullMixedCommonEdgeSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk i).1, fresh (fullMixedCommonEdgeSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk i)⟩ : Sigma P))
    (by
      intro fresh i
      constructor
      · intro hi
        obtain ⟨c, hc⟩ := (full_mixed_common_edge_history_sample_coverage n S B A Δ D steps u s history
          k htag sk fresh i).mp hi
        refine ⟨(fullMixedCommonEdgeSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk).symm c, ?_⟩
        dsimp only
        rw [Equiv.apply_symm_apply]
        exact hc
      · rintro ⟨i, rfl⟩
        exact (full_mixed_common_edge_history_sample_coverage n S B A Δ D steps u s history
          k htag sk fresh _).mpr ⟨(fullMixedCommonEdgeSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk) i, rfl⟩)
    (fun fresh i hi => full_mixed_common_history_write_other n S B A Δ D steps u s _ history i (full_mixed_common_history_owner_ne M B steps u i hi))
    (fun fresh i => full_mixed_common_edge_history_sample_label n S B A Δ D steps u s history
      k htag sk fresh (fullMixedCommonEdgeSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk i)) F
  convert h using 1
  split_ifs
  · apply sum_congr rfl
    intro z _
    split_ifs <;> rfl
  · rfl


end Edge

end Full
end Bounty
end

section

/- Exact original event rows with the chronological owner indicator. -/

open Finset Classical

namespace Bounty

section Reindex
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
    {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ v : ℝ) (V : Fin N → ℝ)
    (steps : List (Option (J ⊕ K))) (u : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P))
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))

theorem full_mixed_common_ghost_stage_reindex (j : J) (htag : steps.get u = some (.inl j)) :
    let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
    (∑ e : FullPermutationMixedEvent n S B A Δ D (some (.inl j)) s,
      |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V (some (.inl j)) s e| *
        fullMixedCommonForestHistoryGain n S B A Δ D steps code u.val (some (.inl j)) s e history *
        productLengthLyapunov v (fullPermutationMixedEventTarget n S B A Δ D (some (.inl j)) s e)) =
    ∑ sk : CoupledGhostSkeleton M B s, ∑ z : CoupledGhostSamples M B s sk,
      if birthForestStageCondition
        (fullMixedCommonIndexStage M B steps) u.succ
        (fullMixedCommonHistoryWrite n S B A Δ D steps u s
          (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inl j)) htag s ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, z⟩)) history) code then
        |coupledGhostJointEventWeight
          (fun g => physicalGhostRetention (n g) (q j) ρ)
          (fun g => physicalGhostTermination (n g) (q j) ρ)
          (fun g => physicalGhostBirth (n g) (q j) ρ (V g))
          (fun g => unrestrictedResidueWeight (μ g)) M B s
          ((coupledGhostSkeletonEquiv M B s).symm ⟨sk, z⟩)| * productLengthLyapunov v (coupledGhostJointEventTarget M B s ((coupledGhostSkeletonEquiv M B s).symm ⟨sk, z⟩))
      else 0 := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
  have he := ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm.sum_comp (fun e =>
    |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V (some (.inl j)) s e| *
      fullMixedCommonForestHistoryGain n S B A Δ D steps code u.val (some (.inl j)) s e history *
      productLengthLyapunov v (fullPermutationMixedEventTarget n S B A Δ D (some (.inl j)) s e))).symm
  rw [Fintype.sum_sigma] at he
  refine he.trans ?_
  apply sum_congr rfl
  intro sk _
  apply sum_congr rfl
  intro z _
  rw [full_mixed_common_forest_history_gain_tagged n S B A Δ D steps code u (some (.inl j)) htag,
    full_permutation_ghost_skeleton_weight, full_permutation_ghost_skeleton_target]
  split_ifs <;> simp only [mul_one, mul_zero, zero_mul]

theorem full_mixed_common_edge_stage_reindex (k : K) (htag : steps.get u = some (.inr k)) :
    let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
    (∑ e : FullPermutationMixedEvent n S B A Δ D (some (.inr k)) s,
      |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V (some (.inr k)) s e| *
        fullMixedCommonForestHistoryGain n S B A Δ D steps code u.val (some (.inr k)) s e history *
        productLengthLyapunov v (fullPermutationMixedEventTarget n S B A Δ D (some (.inr k)) s e)) =
    ∑ sk : FullActiveEdgeSkeleton n (S k) B (A k) (Δ k) (D k) s, ∑ z : FullActiveEdgeSamples n (S k) B (A k) (Δ k) (D k) s sk,
      if birthForestStageCondition
        (fullMixedCommonIndexStage M B steps) u.succ
        (fullMixedCommonHistoryWrite n S B A Δ D steps u s
          (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inr k)) htag s ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm ⟨sk, z⟩)) history) code then
        |fullActiveEdgeEventWeight n (S k) B (A k) (Δ k) (D k) (ω k) μ ρ V s ((fullActiveEdgeSkeletonEquiv n (S k) B (A k) (Δ k) (D k) s).symm ⟨sk, z⟩)| * productLengthLyapunov v (fullActiveEdgeEventTarget n (S k) B (A k) (Δ k) (D k) s ((fullActiveEdgeSkeletonEquiv n (S k) B (A k) (Δ k) (D k) s).symm ⟨sk, z⟩))
      else 0 := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
  have he := ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm.sum_comp (fun e =>
    |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V (some (.inr k)) s e| *
      fullMixedCommonForestHistoryGain n S B A Δ D steps code u.val (some (.inr k)) s e history *
      productLengthLyapunov v (fullPermutationMixedEventTarget n S B A Δ D (some (.inr k)) s e))).symm
  rw [Fintype.sum_sigma] at he
  refine he.trans ?_
  apply sum_congr rfl
  intro sk _
  apply sum_congr rfl
  intro z _
  rw [full_mixed_common_forest_history_gain_tagged n S B A Δ D steps code u (some (.inr k)) htag,
    full_permutation_edge_skeleton_weight, full_permutation_edge_skeleton_target]
  split_ifs <;> simp only [mul_one, mul_zero, zero_mul]

end Reindex
end Bounty
end

section

/- Exact selected-event exponents and Lyapunov factors for seeded common birth histories. -/

open Finset Classical
namespace Bounty

section Factor
variable {J K : Type*} {N : ℕ} (M : Fin N → ℕ) (B : ℕ) (steps : List (Option (J ⊕ K)))
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))

noncomputable def fullMixedCommonSelectedAt (t : ℕ) : ℕ :=
  if ht : t < steps.length then ∑ g, fullMixedCommonSelectedCount M B steps code ⟨t, ht⟩ g else 0

theorem full_mixed_common_selected_at_owner (u : Fin steps.length) :
    fullMixedCommonSelectedAt M B steps code u.val = ∑ g, fullMixedCommonSelectedCount M B steps code u g := by
  unfold fullMixedCommonSelectedAt
  rw [dif_pos u.isLt]

theorem full_mixed_common_selected_at_sum
    (hcode : ∀ i, fullMixedCommonIndexStage M B steps i = 0 → code i = none) :
    (∑ u : Fin steps.length, fullMixedCommonSelectedAt M B steps code u.val) = birthForestRank code := by
  simp only [full_mixed_common_selected_at_owner]
  exact full_mixed_common_selected_count_sum M B steps code hcode

variable {P : Fin N → Type*} [∀ g, Fintype (P g)]
    (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ v vmin : ℝ) (V : Fin N → ℝ) (T : ℕ) (β : ℝ)

noncomputable def fullMixedCommonForestRowFactor (t : ℕ) (tag : Option (J ⊕ K)) : ℝ :=
  β ^ fullMixedCommonSelectedAt M B steps code t * fullMixedLengthRowFactor μ q ρ v vmin V T tag

theorem full_mixed_common_forest_row_factor_nonneg
    (hβ : 0 ≤ β) (hρ : ρ < 1) (hv : 0 ≤ v) (t : ℕ) (tag : Option (J ⊕ K)) :
    0 ≤ fullMixedCommonForestRowFactor M B steps code μ q ρ v vmin V T β t tag :=
  mul_nonneg (pow_nonneg hβ _)
    (fullMixedLengthRowFactor_nonneg μ q ρ v vmin V T hρ hv tag)

theorem full_mixed_common_forest_row_factor_product
    (hcode : ∀ i, fullMixedCommonIndexStage M B steps i = 0 → code i = none) :
    finiteEventIndexedProduct (fullMixedCommonForestRowFactor M B steps code μ q ρ v vmin V T β) 0 steps =
      β ^ birthForestRank code * ∏ u : Fin steps.length, fullMixedLengthRowFactor μ q ρ v vmin V T (steps.get u) := by
  rw [finite_event_indexed_product_eq_prod]
  simp only [Nat.zero_add, fullMixedCommonForestRowFactor, prod_mul_distrib,
    prod_pow_eq_pow_sum, full_mixed_common_selected_at_sum M B steps code hcode]

end Factor
end Bounty
end

section

/- Arbitrary logarithmic savings for all characters at large Mellin frequencies. -/

open Finset Filter

namespace Bounty

theorem eventually_long_rough_harmonic_power_bound {a : ℝ} (ha : 0 < a)
    (T Bsave : ℝ) :
    ∃ B0 : ℝ, 0 < B0 ∧ ∀ᶠ L : ℝ in atTop,
      ∀ Y : ℝ, Real.exp (a*L) ≤ Y →
      ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q), (q : ℝ) ≤ L^T →
      ∀ u : ℝ, L^B0 ≤ |u| → |u| ≤ (Real.exp L)^2 →
      ∀ m n : ℕ, m ≤ n → Y ≤ (m : ℝ)+1 → (n : ℝ) ≤ 2*Y →
        ‖∑ i ∈ (Ioc m n).filter (fun i : ℕ =>
          ∀ p ∈ i.primeFactors, Real.exp (Real.sqrt L) < (p : ℝ)),
            harmonicMellinWeight u i*χ (i : ZMod q)‖ ≤ L^(-Bsave) := by
  obtain ⟨δ,C,K,N0,hδ,hC,hK,hN0,hraw⟩ := exists_rough_harmonic_phase_bound a ha
  refine ⟨max 1 (Bsave+2),lt_of_lt_of_le zero_lt_one (le_max_left _ _),?_⟩
  have hfirst := eventually_exp_neg_rpow_mul_rpow_le
    (by norm_num : (0 : ℝ) < 1/8) (by norm_num : (0 : ℝ) < 1) 0 (Bsave+1)
  have hsecond := eventually_exp_neg_rpow_mul_rpow_le
    (by norm_num : (0 : ℝ) < 1) (half_pos ha) 0 (Bsave+1)
  have hthird := eventually_exp_neg_rpow_mul_rpow_le
    (by norm_num : (0 : ℝ) < 1) (show 0 < a*δ/2 by positivity) 1 (Bsave+1)
  filter_upwards [eventually_rough_cell_sieve_parameters ha,
    eventually_long_rough_sieve_scales ha T N0,hfirst,hsecond,hthird,
    eventually_ge_atTop (3*K*(3+4*C)),eventually_ge_atTop (1 : ℝ)]
    with L hpar hscale he1 he2 he3 hconstant hL
  intro Y hY q hqInst χ hqT u hu huX m n hmn hYm hnY
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hq : 0 < (q : ℝ) := by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne q)
  obtain ⟨hthreshold,hN,hlevel,hlog⟩ := hscale Y (q : ℝ) hY hq hqT
  have hu0 : 0 < |u| := (Real.rpow_pos_of_pos hL0 _).trans_le hu
  have hune : u ≠ 0 := abs_pos.mp hu0
  have hx : 1 ≤ Real.exp L := Real.one_le_exp hL0.le
  have hb := hraw (Real.exp (Real.sqrt L)) (roughCellSieveOrder L)
    hpar.2.2.1 hpar.1 hpar.2.1 Y (Real.exp L) u m n q χ hmn hYm hnY
    hthreshold hx hN hune huX
  let Z : ℝ := (Real.exp (Real.sqrt L))^(4*(roughCellSieveOrder L : ℝ)+2)
  let N : ℝ := Y/(Z*(q : ℝ))
  have hN' : Real.exp ((a/2)*L) ≤ N := by
    simpa only [N,Z,← Real.exp_mul,mul_comm L] using hN
  have hNpos : 0 < N := (Real.exp_pos _).trans_le hN'
  have hNpow : N^(-δ) ≤ Real.exp (-(a*δ/2)*L) := by
    have hp := Real.rpow_le_rpow_of_nonpos (Real.exp_pos _) hN' (neg_nonpos.mpr hδ.le)
    apply hp.trans_eq
    rw [← Real.exp_mul]
    congr 1
    ring
  simp only [neg_one_mul,Real.rpow_zero,mul_one] at he1
  simp only [Real.rpow_one,Real.rpow_zero,mul_one] at he2
  simp only [Real.rpow_one] at he3
  have huLower : L^(Bsave+2) ≤ |u| :=
    (Real.rpow_le_rpow_of_exponent_le hL (le_max_right _ _)).trans hu
  have huInv : 1/|u| ≤ L^(-(Bsave+2)) := by
    have hi := one_div_le_one_div_of_le (Real.rpow_pos_of_pos hL0 _) huLower
    simpa only [one_div,Real.rpow_neg hL0.le] using hi
  have hp1 : L*(1/|u|) ≤ L^(-(Bsave+1)) := by
    apply (mul_le_mul_of_nonneg_left huInv hL0.le).trans_eq
    nth_rw 1 [← Real.rpow_one L]
    rw [← Real.rpow_add hL0]
    congr 1
    ring
  have hp2 : L*N^(-δ) ≤ L^(-(Bsave+1)) :=
    (mul_le_mul_of_nonneg_left hNpow hL0.le).trans (by simpa only [mul_comm] using he3)
  have hosc : C*Real.log (2*Real.exp (Real.sqrt L))*(1/|u|+N^(-δ)) ≤
      (4*C)*L^(-(Bsave+1)) := by
    calc
      _ ≤ C*(2*L)*(1/|u|+N^(-δ)) := by
        apply mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hlog hC.le)
        positivity
      _ = (2*C)*(L*(1/|u|)+L*N^(-δ)) := by ring
      _ ≤ (2*C)*(L^(-(Bsave+1))+L^(-(Bsave+1))) :=
        mul_le_mul_of_nonneg_left (add_le_add hp1 hp2) (by positivity)
      _ = _ := by ring
  have heOrder : Real.exp (-(roughCellSieveOrder L : ℝ)) ≤ L^(-(Bsave+1)) :=
    hpar.2.2.2.2.trans he1
  have heLevel : Z/Y ≤ L^(-(Bsave+1)) := hlevel.trans he2
  calc
    _ ≤ 3*K*(2*Real.exp (-(roughCellSieveOrder L : ℝ))+Z/Y+
        C*Real.log (2*Real.exp (Real.sqrt L))*(1/|u|+N^(-δ))) := hb
    _ ≤ 3*K*((3+4*C)*L^(-(Bsave+1))) := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      nlinarith
    _ = (3*K*(3+4*C))*L^(-(Bsave+1)) := by ring
    _ ≤ L*L^(-(Bsave+1)) := mul_le_mul_of_nonneg_right hconstant (by positivity)
    _ = L^(-Bsave) := by
      nth_rw 1 [← Real.rpow_one L]
      rw [← Real.rpow_add hL0]
      congr 1
      ring

end Bounty
end

section

/- Literal logarithmic phases and the original finite pattern family preserve
the direct unshared prime-kernel bounds, without shared-completion premises. -/

open Finset Classical
namespace Bounty

section Envelope
variable {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
  (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
  (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ) (hξ : 0 < ξ)

include hξ

theorem physical_unshared_prime_three_phase_norm_le
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (u v : GroupMarkedLists P (fun g => ell + (repeatedBigPrimePatternCut probes r t i g).card))
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
    (a b c : ℝ) (w z d : ℕ) :
    let kept := fun U : Finset (RepeatedBigFlatIndex G J ell) =>
      primeProductRetainedCells (fun j : U => P j.val.1) (fun j => V j.val.1) h ξ
    ‖(repeatedBigPrimePatternWeight probes r t i *
      physicalUnsharedPrimePatternKernel P V probes r t hrt Q h kept i u v aux) *
        physicalPhase a w * physicalPhase b z * physicalPhase c d‖ ≤
      repeatedBigPrimePatternBound probes r t Q ξ i := by
  intro kept
  simpa only [norm_mul, physical_phase_norm, mul_one] using
    physical_unshared_weighted_prime_pattern_norm_le P V probes r t hrt Q h ξ hξ i u v aux

theorem physical_unshared_weighted_prime_family_norm_sum_le
    {m : ℕ} (hp : ∀ g, (probes g).card ≤ m)
    (u v : ∀ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      GroupMarkedLists P (fun g => ell + (repeatedBigPrimePatternCut probes r t i g).card))
    (aux : ∀ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i)) :
    let kept := fun U : Finset (RepeatedBigFlatIndex G J ell) =>
      primeProductRetainedCells (fun j : U => P j.val.1) (fun j => V j.val.1) h ξ
    (∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      ‖repeatedBigPrimePatternWeight probes r t i *
        physicalUnsharedPrimePatternKernel P V probes r t hrt Q h kept i (u i) (v i) (aux i)‖) ≤
      1 + (2 : ℝ) ^ (m * (r.card + t.card)) * ((Q * Q : ℕ) / ξ) ^ 2 := by
  intro kept
  exact (sum_le_sum (fun i _ => physical_unshared_weighted_prime_pattern_norm_le
    P V probes r t hrt Q h ξ hξ i (u i) (v i) (aux i))).trans
      (repeated_big_prime_pattern_bound_sum_le probes r t hp Q ξ)

theorem physical_unshared_prime_phased_family_norm_le
    {m : ℕ} (hp : ∀ g, (probes g).card ≤ m)
    (u v : ∀ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      GroupMarkedLists P (fun g => ell + (repeatedBigPrimePatternCut probes r t i g).card))
    (aux : ∀ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
    (a b c : RepeatedBigPrimePatternIndex (ell := ell) probes r t → ℝ)
    (w z d : RepeatedBigPrimePatternIndex (ell := ell) probes r t → ℕ) :
    let kept := fun U : Finset (RepeatedBigFlatIndex G J ell) =>
      primeProductRetainedCells (fun j : U => P j.val.1) (fun j => V j.val.1) h ξ
    ‖∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      (repeatedBigPrimePatternWeight probes r t i *
        physicalUnsharedPrimePatternKernel P V probes r t hrt Q h kept i (u i) (v i) (aux i)) *
          physicalPhase (a i) (w i) * physicalPhase (b i) (z i) * physicalPhase (c i) (d i)‖ ≤
      1 + (2 : ℝ) ^ (m * (r.card + t.card)) * ((Q * Q : ℕ) / ξ) ^ 2 := by
  intro kept
  apply (norm_sum_le _ _).trans
  simpa only [norm_mul, physical_phase_norm, mul_one] using
    physical_unshared_weighted_prime_family_norm_sum_le P V probes r t hrt Q h ξ hξ hp u v aux

end Envelope
end Bounty
end

section

/- The complementary original full-vertex pair sum is controlled by the
proved bad-draw probability and the exact shared-overlap loss. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_bad_original_pair_norm_le {G : Type*} [Fintype G] [dG : DecidableEq G]
    (P : G → Finset ℕ) {J ell : ℕ} (C : G → Finset (Fin J))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    {q : ℝ} (hq0 : 0 < q) (hq1 : q ≤ 1)
    (aux : PhysicalAuxLabels P C) {w z : ℕ} (hw : 0 < w) (hz : 0 < z)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → ℂ)
    {H : ℝ} (hH : 0 ≤ H) (hK : ∀ L R, physicalSharedCompatible C L R → ‖K L R‖ ≤ H) :
    ‖∑ L : PhysicalMarkLists P J ell, ∑ R : PhysicalMarkLists P J ell,
      if physicalSharedCompatible C L R then
        ((physicalStateMass V J ell * physicalCompletionMass V C ell /
          (physicalSharedFactor C L : ℝ) : ℝ) : ℂ) *
        (if ¬(∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z) then
          ((physicalVertexWeight L q ((physicalSharedFactor C L : ℤ) * (w : ℤ)) *
            physicalVertexWeight R q ((physicalSharedFactor C L : ℤ) * (z : ℤ)) : ℝ) : ℂ) * K L R
        else 0)
      else 0‖ ≤
      (markedDivisorWeight univ P q V (fun g => ell + (C g).card) (w : ℤ) *
        markedDivisorWeight univ P q V (fun g => ell + (C g).card) (z : ℤ)) *
      ((∑ g, (J - (C g).card : ℕ) *
          (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) / (V g * Pmin)) *
        (H / q ^ (2 * ∑ g : G, (J - (C g).card)))) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  let B : ℝ := H / q ^ (2 * ∑ g : G, (J - (C g).card))
  let δ : ℝ := ∑ g, (J - (C g).card : ℕ) *
    (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) / (V g * Pmin)
  let β : GroupMarkedLists P (fun g => ell + (C g).card) →
      GroupMarkedLists P (fun g => ell + (C g).card) →
      PhysicalAuxLabels P (fun g => univ \ C g) → ℂ :=
    fun _ _ s => if ¬(∀ g j, s g j ∉ physicalSharedForbidden C aux g w z) then (B : ℂ) else 0
  let M : ℂ := groupMarkedAverage P (fun g => ell + (C g).card) (w : ℤ) (fun u =>
    groupMarkedAverage P (fun g => ell + (C g).card) (z : ℤ) (fun v =>
      ∑ s : PhysicalAuxLabels P (fun g => univ \ C g),
        if physicalRawCutGood C u v s then
          (physicalAuxMass V (fun g => univ \ C g) s : ℂ) * β u v s else 0))
  have hB0 : 0 ≤ B := div_nonneg hH (pow_nonneg hq0.le _)
  have hδ0 : 0 ≤ δ := physical_shared_error_factor_nonneg C V (fun g => (hV g).le) hw hz hPmin.le
  have hM : ‖M‖ ≤ δ * B := by
    apply group_marked_pair_average_norm_le P (fun g => ell + (C g).card) (w : ℤ) (z : ℤ)
      _ (mul_nonneg hδ0 hB0)
    intro u v
    have hh := physical_bad_cut_mean_norm_le V C hV hMass u.val v.val aux hw hz hPmin hp
      (fun _ => (B : ℂ)) hB0 (fun _ _ => by
        simp only [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hB0, le_refl])
    convert hh using 1
    congr 1
    apply sum_congr rfl
    intro s _
    by_cases hc : physicalRawCutGood C u.val v.val s
    · by_cases ha : ∀ g j, s g j ∉ physicalSharedForbidden C aux g w z
      · have hn : ¬(physicalRawCutGood C u.val v.val s ∧
            ¬(∀ g j, s g j ∉ physicalSharedForbidden C aux g w z)) := fun h => h.2 ha
        simp only [β, if_pos hc, if_neg (not_not.mpr ha), if_neg hn, mul_zero]
      · simp only [β, if_pos hc, if_pos ha, if_pos (And.intro hc ha)]
    · have hn : ¬(physicalRawCutGood C u.val v.val s ∧
          ¬(∀ g j, s g j ∉ physicalSharedForbidden C aux g w z)) := fun h => hc h.1
      simp only [if_neg hc, if_neg hn]
  have he : (∑ L : PhysicalMarkLists P J ell, ∑ R : PhysicalMarkLists P J ell,
      if physicalSharedCompatible C L R then
        ((physicalStateMass V J ell * physicalCompletionMass V C ell /
          (physicalSharedFactor C L : ℝ) : ℝ) : ℂ) *
        ((physicalUnsharedVertex C L q (w : ℤ) * physicalUnsharedVertex C R q (z : ℤ)) *
          B * (if ¬(∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z)
            then 1 else 0) : ℝ) else 0) =
      (markedDivisorWeight univ P q V (fun g => ell + (C g).card) (w : ℤ) : ℂ) *
      (markedDivisorWeight univ P q V (fun g => ell + (C g).card) (z : ℤ) : ℂ) * M := by
    convert physical_stripped_pair_sum_eq_marked_averages P C V q (w : ℤ) (z : ℤ) β using 1
    apply sum_congr rfl
    intro L _
    apply sum_congr rfl
    intro R _
    by_cases hc : physicalSharedCompatible C L R
    · simp only [if_pos hc]
      by_cases ha : ∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z
      · simp only [β, if_neg (not_not.mpr ha), mul_zero, Complex.ofReal_zero]
      · simp only [β, if_pos ha, mul_one, Complex.ofReal_mul]
    · simp only [if_neg hc]
  have hWw := marked_divisor_weight_nonneg univ P hq0.le V (fun g => ell + (C g).card)
    (fun g _ => (hV g).le) (w : ℤ)
  have hWz := marked_divisor_weight_nonneg univ P hq0.le V (fun g => ell + (C g).card)
    (fun g _ => (hV g).le) (z : ℤ)
  refine (physical_pair_sum_norm_le_from_bound P C V hV
    (fun L R => if ¬(∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z) then
      ((physicalVertexWeight L q ((physicalSharedFactor C L : ℤ) * (w : ℤ)) *
        physicalVertexWeight R q ((physicalSharedFactor C L : ℤ) * (z : ℤ)) : ℝ) : ℂ) * K L R else 0)
    (fun L R => (physicalUnsharedVertex C L q (w : ℤ) * physicalUnsharedVertex C R q (z : ℤ)) *
      B * (if ¬(∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z) then 1 else 0))
    (fun L R hLR => physical_bad_vertex_coefficient_norm_le C L R hLR hprime hdis hq0 hq1
      (w : ℤ) (z : ℤ)
      (¬(∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z))
      (K L R) (hK L R hLR))).trans ?_
  rw [he, norm_mul, norm_mul, Complex.norm_real, Complex.norm_real,
    Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg hWw, abs_of_nonneg hWz]
  exact mul_le_mul_of_nonneg_left hM (mul_nonneg hWw hWz)

end Bounty
end

section

/- The good original full-vertex contribution approximates the unconditioned
marked-list average with the proved shared-exclusion loss. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_good_pair_comparison {G : Type*} [Fintype G] [dG : DecidableEq G]
    (P : G → Finset ℕ) {J ell : ℕ} (C : G → Finset (Fin J))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    {q : ℝ} (hq : 0 ≤ q) (aux : PhysicalAuxLabels P C)
    {w z : ℕ} (hw : 0 < w) (hz : 0 < z)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (b : GroupMarkedLists P (fun g => ell + (C g).card) →
      GroupMarkedLists P (fun g => ell + (C g).card) → ℂ)
    {H : ℝ} (hH : 0 ≤ H)
    (hb : ∀ (u : GroupMarkedListsAt P (fun g => ell + (C g).card) (w : ℤ))
      (v : GroupMarkedListsAt P (fun g => ell + (C g).card) (z : ℤ)), ‖b u.val v.val‖ ≤ H) :
    ‖physicalFullPairCorrelation P C V q w z
        (fun L R => if ∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z then
          b (physicalGroupUnsharedEmbedding C L) (physicalGroupUnsharedEmbedding C R) else 0) -
      (markedDivisorWeight univ P q V (fun g => ell + (C g).card) (w : ℤ) : ℂ) *
      (markedDivisorWeight univ P q V (fun g => ell + (C g).card) (z : ℤ) : ℂ) *
      groupMarkedAverage P (fun g => ell + (C g).card) (w : ℤ) (fun u =>
        groupMarkedAverage P (fun g => ell + (C g).card) (z : ℤ) (b u))‖ ≤
      (markedDivisorWeight univ P q V (fun g => ell + (C g).card) (w : ℤ) *
        markedDivisorWeight univ P q V (fun g => ell + (C g).card) (z : ℤ)) *
      ((∑ g, (J - (C g).card : ℕ) *
        (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) / (V g * Pmin)) * H) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  have he := physical_good_original_pair_sum_eq_marked_averages P C hprime hdis V q aux hw hz b
  have hh := physical_cut_shared_pair_average_error C hprime V hV hMass aux hw hz hPmin hp b hH hb
  have hWw := marked_divisor_weight_nonneg univ P hq V (fun g => ell + (C g).card)
    (fun g _ => (hV g).le) (w : ℤ)
  have hWz := marked_divisor_weight_nonneg univ P hq V (fun g => ell + (C g).card)
    (fun g _ => (hV g).le) (z : ℤ)
  unfold physicalFullPairCorrelation
  simp only [mul_ite, mul_zero] at he ⊢
  rw [he, ← mul_sub, norm_mul, norm_mul, Complex.norm_real, Complex.norm_real,
    Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg hWw, abs_of_nonneg hWz]
  exact mul_le_mul_of_nonneg_left hh (mul_nonneg hWw hWz)

end Bounty
end

section

/- The original auxiliary probability weights and the finite prime-pattern
family preserve explicit error bounds. Coincident free labels are retained. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_auxiliary_error_average {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1/(p : ℝ) = V g)
    (F : PhysicalAuxLabels P C → ℂ) {B : ℝ} (hF : ∀ aux, ‖F aux‖ ≤ B) :
    ‖∑ aux : PhysicalAuxLabels P C, (physicalAuxMass V C aux : ℂ) * F aux‖ ≤ B := by
  calc
    _ ≤ ∑ aux : PhysicalAuxLabels P C, ‖(physicalAuxMass V C aux : ℂ) * F aux‖ := norm_sum_le _ _
    _ ≤ ∑ aux : PhysicalAuxLabels P C, physicalAuxMass V C aux * B := by
      apply sum_le_sum
      intro aux _
      have hm := physical_aux_mass_nonneg V C (fun g => (hV g).le) aux
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hm]
      exact mul_le_mul_of_nonneg_left (hF aux) hm
    _ = B := by rw [← sum_mul, physical_aux_mass_sum V C hV hMass, one_mul]

theorem physical_prime_pattern_error_sum {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell m : ℕ} (V : G → ℝ)
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1/(p : ℝ) = V g)
    (probes : G → Finset (Fin J)) (r t : Finset G) (hp : ∀ g, (probes g).card ≤ m)
    (Q : ℕ) (ξ : ℝ) {D : ℝ} (hD : 0 ≤ D)
    (F : ∀ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i) → ℂ)
    (hF : ∀ i aux, ‖F i aux‖ ≤ D * repeatedBigPrimePatternBound probes r t Q ξ i) :
    ‖∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      ∑ aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i),
        (physicalAuxMass V (repeatedBigPrimePatternCut probes r t i) aux : ℂ) * F i aux‖ ≤
      D * (1 + (2 : ℝ) ^ (m * (r.card + t.card)) * ((Q * Q : ℕ) / ξ)^2) := by
  apply (norm_sum_le _ _).trans
  calc
    _ ≤ ∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
        D * repeatedBigPrimePatternBound probes r t Q ξ i := by
      apply sum_le_sum
      intro i _
      exact physical_auxiliary_error_average V _ hV hMass (F i) (hF i)
    _ = D * ∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
        repeatedBigPrimePatternBound probes r t Q ξ i := (mul_sum ..).symm
    _ ≤ _ := mul_le_mul_of_nonneg_left (repeated_big_prime_pattern_bound_sum_le probes r t hp Q ξ) hD

end Bounty
end

section

/- The original fixed root equals a full-pair sum with literal cutoff guards. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_fixed_root_full_pair_guarded
    {G : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (V : G → ℝ) (C : G → Finset (Fin J)) (q a b : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (positions W : Finset ℤ)
    (hW : ∀ L : PhysicalMarkLists P J ell, ∀ n ∈ positions,
      n / physicalSharedFactor C L ∈ W)
    (f g : ℤ → ℂ) (Ψ : ℝ → ℂ) (Z : ℝ)
    (hf : ∀ (L : PhysicalMarkLists P J ell) w,
      f ((physicalSharedFactor C L : ℤ) * w) = f w)
    (hg : ∀ (L : PhysicalMarkLists P J ell) w,
      g ((physicalSharedFactor C L : ℤ) * w) = g w) :
    physicalFixedRootCorrelation V C q (-(a+b)) k K aux positions
      (fun n => physicalPhase (-a) n.natAbs * f n)
      (fun n => physicalPhase b n.natAbs * g n) Ψ Z =
    (physicalAuxMass V C aux : ℂ) * ∑ w ∈ W,
      (Ψ ((w : ℝ) / (Z * physicalFreeFactor C aux)) * (w : ℂ)⁻¹ *
        (starRingEnd ℂ) (f w) * g (w + k * (physicalFreeFactor C aux : ℕ))) *
      physicalFullPairCorrelation P C V q w.natAbs
        (w + k * (physicalFreeFactor C aux : ℕ)).natAbs (fun L R =>
          if (physicalSharedFactor C L : ℤ) * w ∈ positions ∧
              (physicalSharedFactor C L : ℤ) *
                (w + k * (physicalFreeFactor C aux : ℕ)) ∈ positions then
            physicalPhasedPairCoefficient C K aux a b w.natAbs
              (w + k * (physicalFreeFactor C aux : ℕ)).natAbs L R
          else 0) := by
  rw [physical_fixed_root_reindex_guarded hdis hprime V C q (-(a+b)) k K aux positions W hW]
  conv_lhs =>
    arg 2
    arg 2
    ext L
    rw [sum_comm]
  conv_lhs => arg 2; rw [sum_comm]
  rw [mul_sum, mul_sum]
  apply sum_congr rfl
  intro w _
  simpa only [mul_assoc] using
    physical_scaled_root_sum_full_pair hprime V C q a b k K aux positions w f g Ψ Z hf hg

end Bounty
end

section

/- The literal auxiliary prime set, including repeated draws only once,
supports the endpoint divisibility exclusions. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def physicalFreePrimeSet {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J : ℕ} (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C) : Finset ℕ :=
  univ.biUnion (fun g => univ.image (fun j : C g => (aux g j).val))

theorem physical_mem_free_prime_set {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J : ℕ} (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C) (p : ℕ) :
    p ∈ physicalFreePrimeSet C aux ↔ ∃ g j, (aux g j).val = p := by
  simp only [physicalFreePrimeSet, mem_biUnion, mem_univ, true_and, mem_image]

theorem physical_free_prime_set_card {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J : ℕ} (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C) :
    (physicalFreePrimeSet C aux).card ≤ ∑ g : G, (C g).card := by
  apply card_biUnion_le.trans
  apply sum_le_sum
  intro g _
  exact card_image_le.trans_eq (by simp)

theorem physical_free_prime_set_mem_pool {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J : ℕ} (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    {Q : Finset ℕ} (hQ : ∀ g, P g ⊆ Q) {p : ℕ} (hp : p ∈ physicalFreePrimeSet C aux) : p ∈ Q := by
  obtain ⟨g, j, rfl⟩ := (physical_mem_free_prime_set C aux p).mp hp
  exact hQ g (aux g j).property

theorem physical_free_label_dvd_factor {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J : ℕ} (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (g : G) (j : C g) : (aux g j).val ∣ physicalFreeFactor C aux := by
  apply dvd_trans (dvd_prod_of_mem (fun j : C g => (aux g j).val) (mem_univ j))
  exact dvd_prod_of_mem (fun g => ∏ j : C g, (aux g j).val) (mem_univ g)

theorem physical_free_prime_set_dvd_step {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J : ℕ} (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (k : ℤ) {p : ℕ} (hp : p ∈ physicalFreePrimeSet C aux) :
    (p : ℤ) ∣ k * (physicalFreeFactor C aux : ℕ) := by
  obtain ⟨g, j, rfl⟩ := (physical_mem_free_prime_set C aux p).mp hp
  apply dvd_mul_of_dvd_right
  exact_mod_cast physical_free_label_dvd_factor C aux g j

end Bounty
end

section

/- Arbitrary fixed exponential frequency radii, with the original roughness cutoff.
Adapted from LongRoughHarmonicDecay, LongRoughBandDecay, and ShiftedLongRoughBand.
The only analytic change is the raw scale choice x = exp(CRadius * L), tau = a / CRadius. -/

open Finset Filter

namespace Bounty

theorem eventually_long_rough_harmonic_power_bound_radius {a CRadius : ℝ}
    (ha : 0 < a) (hRadius : 0 < CRadius) (T Bsave : ℝ) :
    ∃ B0 : ℝ, 0 < B0 ∧ ∀ᶠ L : ℝ in atTop,
      ∀ Y : ℝ, Real.exp (a*L) ≤ Y →
      ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q), (q : ℝ) ≤ L^T →
      ∀ u : ℝ, L^B0 ≤ |u| → |u| ≤ (Real.exp (CRadius*L))^2 →
      ∀ m n : ℕ, m ≤ n → Y ≤ (m : ℝ)+1 → (n : ℝ) ≤ 2*Y →
        ‖∑ i ∈ (Ioc m n).filter (fun i : ℕ =>
          ∀ p ∈ i.primeFactors, Real.exp (Real.sqrt L) < (p : ℝ)),
            harmonicMellinWeight u i*χ (i : ZMod q)‖ ≤ L^(-Bsave) := by
  obtain ⟨δ,C,K,N0,hδ,hC,hK,hN0,hraw⟩ := exists_rough_harmonic_phase_bound (a/CRadius) (div_pos ha hRadius)
  refine ⟨max 1 (Bsave+2),lt_of_lt_of_le zero_lt_one (le_max_left _ _),?_⟩
  have hfirst := eventually_exp_neg_rpow_mul_rpow_le
    (by norm_num : (0 : ℝ) < 1/8) (by norm_num : (0 : ℝ) < 1) 0 (Bsave+1)
  have hsecond := eventually_exp_neg_rpow_mul_rpow_le
    (by norm_num : (0 : ℝ) < 1) (half_pos ha) 0 (Bsave+1)
  have hthird := eventually_exp_neg_rpow_mul_rpow_le
    (by norm_num : (0 : ℝ) < 1) (show 0 < a*δ/2 by positivity) 1 (Bsave+1)
  filter_upwards [eventually_rough_cell_sieve_parameters ha,
    eventually_long_rough_sieve_scales ha T N0,hfirst,hsecond,hthird,
    eventually_ge_atTop (3*K*(3+4*C)),eventually_ge_atTop (1 : ℝ)]
    with L hpar hscale he1 he2 he3 hconstant hL
  intro Y hY q hqInst χ hqT u hu huX m n hmn hYm hnY
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hq : 0 < (q : ℝ) := by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne q)
  obtain ⟨hthreshold,hN,hlevel,hlog⟩ := hscale Y (q : ℝ) hY hq hqT
  have hu0 : 0 < |u| := (Real.rpow_pos_of_pos hL0 _).trans_le hu
  have hune : u ≠ 0 := abs_pos.mp hu0
  have hx : 1 ≤ Real.exp (CRadius*L) := Real.one_le_exp (mul_nonneg hRadius.le hL0.le)
  have hscaleEq : (Real.exp (CRadius*L))^(a/CRadius/2) = (Real.exp L)^(a/2) := by
    rw [← Real.exp_mul, ← Real.exp_mul]
    congr 1
    field_simp
  have hscaled := hscaleEq.le.trans hN
  have hb := hraw (Real.exp (Real.sqrt L)) (roughCellSieveOrder L)
    hpar.2.2.1 hpar.1 hpar.2.1 Y (Real.exp (CRadius*L)) u m n q χ hmn hYm hnY
    hthreshold hx hscaled hune huX
  let Z : ℝ := (Real.exp (Real.sqrt L))^(4*(roughCellSieveOrder L : ℝ)+2)
  let N : ℝ := Y/(Z*(q : ℝ))
  have hN' : Real.exp ((a/2)*L) ≤ N := by
    simpa only [N,Z,← Real.exp_mul,mul_comm L] using hN
  have hNpos : 0 < N := (Real.exp_pos _).trans_le hN'
  have hNpow : N^(-δ) ≤ Real.exp (-(a*δ/2)*L) := by
    have hp := Real.rpow_le_rpow_of_nonpos (Real.exp_pos _) hN' (neg_nonpos.mpr hδ.le)
    apply hp.trans_eq
    rw [← Real.exp_mul]
    congr 1
    ring
  simp only [neg_one_mul,Real.rpow_zero,mul_one] at he1
  simp only [Real.rpow_one,Real.rpow_zero,mul_one] at he2
  simp only [Real.rpow_one] at he3
  have huLower : L^(Bsave+2) ≤ |u| :=
    (Real.rpow_le_rpow_of_exponent_le hL (le_max_right _ _)).trans hu
  have huInv : 1/|u| ≤ L^(-(Bsave+2)) := by
    have hi := one_div_le_one_div_of_le (Real.rpow_pos_of_pos hL0 _) huLower
    simpa only [one_div,Real.rpow_neg hL0.le] using hi
  have hp1 : L*(1/|u|) ≤ L^(-(Bsave+1)) := by
    apply (mul_le_mul_of_nonneg_left huInv hL0.le).trans_eq
    nth_rw 1 [← Real.rpow_one L]
    rw [← Real.rpow_add hL0]
    congr 1
    ring
  have hp2 : L*N^(-δ) ≤ L^(-(Bsave+1)) :=
    (mul_le_mul_of_nonneg_left hNpow hL0.le).trans (by simpa only [mul_comm] using he3)
  have hosc : C*Real.log (2*Real.exp (Real.sqrt L))*(1/|u|+N^(-δ)) ≤
      (4*C)*L^(-(Bsave+1)) := by
    calc
      _ ≤ C*(2*L)*(1/|u|+N^(-δ)) := by
        apply mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hlog hC.le)
        positivity
      _ = (2*C)*(L*(1/|u|)+L*N^(-δ)) := by ring
      _ ≤ (2*C)*(L^(-(Bsave+1))+L^(-(Bsave+1))) :=
        mul_le_mul_of_nonneg_left (add_le_add hp1 hp2) (by positivity)
      _ = _ := by ring
  have heOrder : Real.exp (-(roughCellSieveOrder L : ℝ)) ≤ L^(-(Bsave+1)) :=
    hpar.2.2.2.2.trans he1
  have heLevel : Z/Y ≤ L^(-(Bsave+1)) := hlevel.trans he2
  calc
    _ ≤ 3*K*(2*Real.exp (-(roughCellSieveOrder L : ℝ))+Z/Y+
        C*Real.log (2*Real.exp (Real.sqrt L))*(1/|u|+N^(-δ))) := hb
    _ ≤ 3*K*((3+4*C)*L^(-(Bsave+1))) := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      nlinarith
    _ = (3*K*(3+4*C))*L^(-(Bsave+1)) := by ring
    _ ≤ L*L^(-(Bsave+1)) := mul_le_mul_of_nonneg_right hconstant (by positivity)
    _ = L^(-Bsave) := by
      nth_rw 1 [← Real.rpow_one L]
      rw [← Real.rpow_add hL0]
      congr 1
      ring

theorem eventually_long_roughBand_harmonic_power_bound_radius {a CRadius : ℝ}
    (ha : 0 < a) (hRadius : 0 < CRadius) (T Bsave : ℝ) :
    ∃ B0 : ℝ, 0 < B0 ∧ ∀ᶠ L : ℝ in atTop,
      ∀ Y : ℝ, Real.exp (a*L) ≤ Y →
      ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q), (q : ℝ) ≤ L^T →
      ∀ u : ℝ, L^B0 ≤ |u| → |u| ≤ (Real.exp (CRadius*L))^2 →
      ∀ A B : ℝ, Y ≤ A → A ≤ B → B ≤ 2*Y →
        ‖∑ i ∈ roughBand A B (Real.exp (Real.sqrt L)),
            harmonicMellinWeight u i*χ (i : ZMod q)‖ ≤ L^(-Bsave) := by
  obtain ⟨B0,hB0,hbound⟩ := eventually_long_rough_harmonic_power_bound_radius ha hRadius T Bsave
  refine ⟨B0,hB0,?_⟩
  filter_upwards [hbound] with L hL
  intro Y hY q hqInst χ hqT u hu huX A B hYA hAB hBY
  have hA : 0 ≤ A := ((Real.exp_pos _).trans_le (hY.trans hYA)).le
  have hB : 0 ≤ B := hA.trans hAB
  exact hL Y hY q χ hqT u hu huX ⌊A⌋₊ ⌊B⌋₊ (Nat.floor_le_floor hAB)
    (hYA.trans (Nat.lt_floor_add_one A).le) ((Nat.floor_le hB).trans hBY)

theorem eventually_long_roughBand_shifted_power_bound_radius {a CRadius : ℝ}
    (ha : 0 < a) (hRadius : 0 < CRadius) (T S Bsave : ℝ) :
    ∃ B0 : ℝ, 0 < B0 ∧ ∀ᶠ L : ℝ in atTop,
      ∀ Y : ℝ, Real.exp (a*L) ≤ Y →
      ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q), (q : ℝ) ≤ L^T →
      ∀ t σ : ℝ, L^B0 ≤ |t| → |t| ≤ Real.exp (CRadius*L) → |σ| ≤ L^S →
      ∀ A B : ℝ, Y ≤ A → A ≤ B → B ≤ 2*Y →
        ‖∑ i ∈ roughBand A B (Real.exp (Real.sqrt L)),
            harmonicMellinWeight (t+σ) i*χ (i : ZMod q)‖ ≤ L^(-Bsave) := by
  obtain ⟨Braw,hBraw,hraw⟩ := eventually_long_roughBand_harmonic_power_bound_radius ha hRadius T Bsave
  let M := max Braw S
  have hM : 0 < M := hBraw.trans_le (le_max_left _ _)
  refine ⟨M+1,by linarith,?_⟩
  have hshift := eventually_exp_neg_rpow_mul_rpow_le
    (by norm_num : (0 : ℝ) < 1) hRadius S 0
  have hlarge := (Real.tendsto_exp_atTop.comp
    (tendsto_id.const_mul_atTop hRadius)).eventually_ge_atTop (2 : ℝ)
  filter_upwards [hraw,hshift,hlarge,eventually_ge_atTop (2 : ℝ)]
    with L hbound hshiftL heLarge hL2
  intro Y hY q hqInst χ hqT t σ htlow htup hσ A B hYA hAB hBY
  have hL : 1 ≤ L := by linarith
  have hL0 : 0 < L := by linarith
  have hshift' : L^S ≤ Real.exp (CRadius*L) := by
    simp only [Real.rpow_one,neg_mul,neg_zero,Real.rpow_zero] at hshiftL
    have hm := mul_le_mul_of_nonneg_left hshiftL (Real.exp_pos (CRadius*L)).le
    have he : Real.exp (CRadius*L)*Real.exp (-(CRadius*L)) = 1 := by
      rw [← Real.exp_add,add_neg_cancel,Real.exp_zero]
    simpa only [← mul_assoc,he,one_mul,mul_one] using hm
  have hσM : |σ| ≤ L^M := hσ.trans
    (Real.rpow_le_rpow_of_exponent_le hL (le_max_right _ _))
  have htM : 2*L^M ≤ |t| := by
    calc
      _ ≤ L*L^M := mul_le_mul_of_nonneg_right hL2 (by positivity)
      _ = L^(M+1) := by rw [Real.rpow_add hL0,Real.rpow_one]; ring
      _ ≤ |t| := htlow
  have htri : |t| ≤ |t+σ|+|σ| := by
    have hh := abs_add_le (t+σ) (-σ)
    simpa only [add_neg_cancel_right,abs_neg] using hh
  have hulow : L^Braw ≤ |t+σ| := by
    have hp : L^Braw ≤ L^M := Real.rpow_le_rpow_of_exponent_le hL (le_max_left _ _)
    linarith
  have huexp : |t+σ| ≤ (Real.exp (CRadius*L))^2 := by
    have he : 2 ≤ Real.exp (CRadius*L) := heLarge
    have hh := abs_add_le t σ
    have hs := hσ.trans hshift'
    nlinarith
  exact hbound Y hY q χ hqT (t+σ) hulow huexp A B hYA hAB hBY

end Bounty
end

section

/- Exact transport of the fixed selected fine schedule to the original
physical observed rows with one bounded full-record terminal predicate. -/

open scoped Classical

namespace Bounty

section History
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g, ∀ p : ↥(P g), NeZero p.val]
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (k : Fin n → ℤ) (β : (g : Fin N) → ↥(P g) → ℝ)
  (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (cut : ℕ → Fin N → Finset (Fin J))
  (hencode : ∀ i, PhysicalMarkRowEncoding C (physicalSelectedFineTag n i) (cut i) (cut (i + 1)))

include hP hdis hencode

theorem physical_selected_fine_row_intertwines (i : ℕ)
    (F : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) :
    physicalSelectedFineRow C aux L σ τ k β V ρ hV ω retention i
      (F ∘ physicalBoundedMarkEncode (cut (i + 1))) s =
    physicalSelectedFineFullRow C aux L σ τ k β V ρ ω retention cut i F
      (physicalBoundedMarkEncode (cut i) s) := by
  unfold physicalSelectedFineRow physicalSelectedFineFullRow
  rw [← physical_observed_mark_row_intertwines C k ω β retention ρ V hV hP hdis
    (physicalSelectedFineTag n i) (cut i) (cut (i + 1)) (hencode i)
    (fun o y => if physicalSelectedFineEncodedTest C aux L σ τ cut i o y then F y else 0) s]
  apply congrArg (fun K => physicalObservedMarkRow C k ω β retention ρ V hV (physicalSelectedFineTag n i) K s)
  funext o t
  simp only [Function.comp_apply,
    physical_selected_fine_encoded_test_iff C aux L σ τ cut i o t]

theorem physical_selected_fine_history_intertwines (steps : ℕ)
    (F : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ) :
    finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
      (physicalSelectedFineRow C aux L σ τ k β V ρ hV ω retention) steps
      (F ∘ physicalBoundedMarkEncode (cut steps)) =
    finiteRowComposition (S := fun _ =>
      FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
      (physicalSelectedFineFullRow C aux L σ τ k β V ρ ω retention cut) steps F ∘
        physicalBoundedMarkEncode (cut 0) := by
  apply finite_row_composition_intertwines
  intro i F
  funext s
  exact physical_selected_fine_row_intertwines C aux L σ τ k β V ρ hV ω retention
    hP hdis cut hencode i F s

theorem physical_selected_fine_history_eq_recorded (steps : ℕ)
    (F : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) :
    finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
      (physicalSelectedFineRow C aux L σ τ k β V ρ hV ω retention) steps
      (F ∘ physicalBoundedMarkEncode (cut steps)) s =
    finiteRowComposition (S := fun _ =>
      List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C) × PhysicalBoundedMarkState P J ell B)
      (fun i => physicalRecordedMarkRow C k ω β retention ρ V hV
        (physicalSelectedFineTag n i) (cut i) (cut (i + 1)) (physicalFullTraceAppend C)) steps
      ((fun r => physicalSelectedFineRecordMask C aux L σ τ cut steps r.1 * F r.2) ∘
        Prod.map id (physicalBoundedMarkEncode (cut steps))) ([], s) := by
  rw [physical_selected_fine_history_intertwines C aux L σ τ k β V ρ hV ω retention
    hP hdis cut hencode steps F]
  rw [physical_recorded_mark_history_intertwines C k ω β retention ρ V hV hP hdis
    (physicalSelectedFineTag n) cut hencode (fun _ => physicalFullTraceAppend C) steps]
  exact (physical_selected_full_record_eq_local C aux L σ τ k β V ρ ω retention cut steps F
    (physicalBoundedMarkEncode (cut 0) s)).symm

end History
end Bounty
end

section

/- The empty-memory physical boundary is supported on exactly the prescribed
initial marks, with the original history and all row scalars preserved. -/

open Finset
open scoped Classical
namespace Bounty

section ResiduePath
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (ζ : ∀ p : PhysicalPrime P, ZMod p.2.val)
  (hmarks : ∀ j : Fin (n + 1), ∀ p ∈ physicalMarkedPrimes (L j),
    ζ p = -(a j : ZMod p.2.val))
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ) (η : Fin N → Fin (n + 1) → ℝ)
  (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0) (B : ℕ)

variable
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)

theorem physical_selected_fine_initial_mark_eq_original
    (M : PhysicalMarkLists P J ell) :
    finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
      (physicalSelectedFineRow (B := B) C aux L σ τ k β V ρ hV ω retention)
      (4 * n + 1) physicalEmptyMemoryTerminal (physicalInitialMarkState B M) =
    if M = L 0 then
      (∏ i ∈ range (2 * n + 1), physicalSelectedCoarseScalar C aux L σ ω i) *
        physicalJointResidueRawHistory C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β
          (fun _ j => 1 - retention j) V (fun _ => ρ) hV B else 0 := by
  rw [physical_selected_fine_initial_mark_indicator]
  rw [physical_selected_fine_path_eq_original C aux k L a σ τ hstep ζ hmarks hlist
    hP hdis hk β V ρ hV B ω retention]

end ResiduePath
end Bounty
end

section

/- Prescribed physical paths form disjoint selectors on chronological records. -/

open Finset
open scoped Classical
namespace Bounty

abbrev PhysicalSelectedData {N J n : ℕ} (P : Fin N → Finset ℕ) (ell : ℕ)
    (C : Fin n → Fin N → Finset (Fin J)) :=
  (∀ j, PhysicalAuxLabels P (C j)) × (Fin (n + 1) → PhysicalMarkLists P J ell) ×
    (Fin n → PhysicalPermutations (Fin N) J ell) ×
    (Fin n → PhysicalPermutations (Fin N) J ell)

section Fine
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J))

noncomputable def physicalSelectedDataTest (d : PhysicalSelectedData P ell C)
    (o : ℕ → PhysicalMarkObservation P ell C)
    (t : ℕ → PhysicalBoundedMarkState P J ell B) : Prop :=
  ∀ i < 4 * n + 1, physicalSelectedFineTest C d.1 d.2.1 d.2.2.1 d.2.2.2 i (o i) (t i)

theorem physical_selected_data_unique {d e : PhysicalSelectedData P ell C}
    (o : ℕ → PhysicalMarkObservation P ell C)
    (t : ℕ → PhysicalBoundedMarkState P J ell B)
    (hd : physicalSelectedDataTest C d o t) (he : physicalSelectedDataTest C e o t) : d = e := by
  obtain ⟨ha, hL, hσ, hτ⟩ := physical_selected_fine_data_unique C o t hd he
  exact Prod.ext ha (Prod.ext hL (Prod.ext hσ hτ))

theorem physical_selected_data_phase_norm_le_one
    (S : Finset (PhysicalSelectedData P ell C))
    (w : PhysicalSelectedData P ell C → ℂ)
    (o : ℕ → PhysicalMarkObservation P ell C)
    (t : ℕ → PhysicalBoundedMarkState P J ell B)
    (hw : ∀ d ∈ S, physicalSelectedDataTest C d o t → ‖w d‖ ≤ 1) :
    ‖∑ d ∈ S, if physicalSelectedDataTest C d o t then w d else 0‖ ≤ 1 := by
  exact finite_disjoint_phase_norm_le_one S (fun d => physicalSelectedDataTest C d o t) w
    (fun _ _ _ _ hd he => physical_selected_data_unique C o t hd he) hw

end Fine
end Bounty
end

section

/- Arbitrary power decay for the actual projected clean prime row on
positive logarithmic blocks, including its density and collision errors. -/

open Finset Filter
open scoped Classical

namespace Bounty

theorem eventually_repeated_big_prime_clean_power_bound
    (hZ : PrimitiveZeroFreeHalfPlane) (c s z a v D ε E beta tau : ℝ)
    (m J ell : ℕ)
    (hc : 0 < c) (hs : 0 ≤ s) (hz : 0 ≤ z) (ha : 0 ≤ a)
    (hv : 0 < v) (hD : 0 ≤ D) (hε : 0 < ε) (htau : 0 ≤ tau)
    (hell : 0 < ell) (hml : ell ≤ m)
    (hgap : beta * Real.log ((ell : ℝ) ^ ell / (m : ℝ) ^ ell) / 2 ≤ -(E + 2))
    (hDgap : (m : ℝ) * a * Real.log 3 + E + 2 ≤ D) :
    let κ := a * Real.log (primeFiberFactorBound v m)
    let s' := s + ε
    let A₀ := D + 2 * (s' + 1)
    let q := 2 * κ + (s' + 1) + 2 * A₀ + 3
    let w := 4 * q + max z q + A₀ + 2
    let x := (s' + w + 2) + 2 * A₀ + 2
    ∀ᶠ L : ℝ in atTop,
    let Q := ⌊L ^ q⌋₊
    let h := L ^ (-w)
    let ξ := L ^ (-x)
    ∀ {G : Type} [Fintype G] [DecidableEq G],
    ∀ (P : G → Finset ℕ) (V : G → ℝ),
    Pairwise (fun g h => Disjoint (P g) (P h)) →
    (∀ g p, p ∈ P g → p.Prime ∧ Q < p) →
    (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) →
    (∀ g, v ≤ V g) →
    (∀ g p, p ∈ P g → Real.log p ≤ L ^ s) →
    (Fintype.card G : ℝ) ≤ a * Real.log L →
    (∀ g, ∃ a b : ℝ, P g = primeBand a b ∧ Real.exp (L ^ c) ≤ a ∧ 0 ≤ b) →
    ∀ probes : G → Finset (Fin J), (∀ g, (probes g).card = m) →
    ∀ r t : Finset G, ∀ hrt : Disjoint r t,
    beta * Real.log L ≤ (r.card : ℝ) → beta * Real.log L ≤ (t.card : ℝ) →
    ∀ ζ θ : ℝ, |ζ| ≤ L ^ z →
    let kept := fun U : Finset (RepeatedBigFlatIndex G J ell) => primeProductRetainedCells
      (fun i : U => P i.1.1) (fun i => V i.1.1) h ξ
    let C := repeatedBigPrimePatternCut (ell := ell) probes r t
    let K := repeatedBigPrimePatternKernel P V probes r t hrt Q h kept
    let weights := repeatedBigPrimePatternWeight (ell := ell) probes r t
    ∀ (b : ∀ g, P g → ℝ),
    ∀ T Pmin : ℝ, 0 ≤ T → T ≤ L ^ tau → Real.exp (L ^ c) ≤ Pmin →
    (∀ g (p : P g), Pmin ≤ (p.val : ℝ)) →
    (∀ g (p : P g), b g p = 1 - T / (p.val : ℝ)) →
    ∀ (S : Type) [Fintype S] (Ps : S → Finset ℕ) (N : G → ℕ) (k : ℤ)
      (p : FixedOrderedMemoryLabels P N),
    ∀ [∀ q : PhysicalPrime Ps, NeZero q.2.val] [∀ g j, NeZero (p g j).val],
    ∀ (d : PhysicalSharedLists Ps J)
      (f : RepeatedBigLists P J ell → (PhysicalResidues Ps × FixedOrderedResidues p) → ℂ),
    cleanWeightedNorm (repeatedBigActiveMass V b)
      (cleanActiveMap repeatedBigSymmetrizeLinear
        (cleanHybridPatternCoreAction V b C ζ θ k p
          (fun i source target aux => weights i * K i source target aux) d
          (cleanActiveMap repeatedBigSymmetrizeLinear f))) ≤
      L ^ (-E) * cleanWeightedNorm (repeatedBigActiveMass V b) f := by
  intro κ s' A₀ q w x
  have hm : 0 < m := hell.trans_le hml
  have hexp := repeated_big_prime_kernel_exponents_nonneg s z a v D ε m hs hz ha hD hε.le
  have hq : 0 ≤ q := hexp.2.2.2.1
  have hx : 0 ≤ x := hexp.2.2.2.2.2
  filter_upwards [eventually_repeated_big_prime_clean_norm_le
      hZ c s z a v D ε m hc hs hz ha hv hD hε hm,
    eventually_repeated_big_prime_pattern_error_small m J ell ha hq hx htau hv hc (E + 1),
    eventually_repeated_big_baseline_pos (tau := tau) hc,
    eventually_ge_atTop (3 : ℝ)] with L hnorm herr hbaseline hL
  intro Q h ξ G _ dG
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  intro P V hdisj hP hmass hV hlog hcard hband probes hp r t hrt hr ht
    ζ θ hζ kept C K weights b T Pmin hT hTmax hPminexp hpmin hb
    S _ Ps N k p _ _ d f
  have hL0 : 0 < L := by linarith
  have hPmin : 0 < Pmin := (Real.exp_pos _).trans_le hPminexp
  have hbpos : ∀ g p, 0 < b g p := by
    intro g p
    rw [hb g p]
    exact (hbaseline T Pmin hT hTmax hPminexp).2 p.val (hpmin g p)
  have hp' : ∀ g, (probes g).card ≤ m := fun g => (hp g).le
  obtain ⟨hsmall, herr'⟩ := herr V probes r t Q ξ T Pmin hrt hp' hcard hV
    (Nat.floor_le (Real.rpow_nonneg hL0.le _)) le_rfl hT hTmax hPminexp
  have hsmall' := repeated_big_prime_pattern_small_of_uniform
    probes r t hp' hT hPmin hsmall
  have hbase := hnorm J ell P V hdisj hP hmass hV hlog hcard hband probes hp r t hrt
    ζ θ hζ b hbpos T Pmin hT hPmin hpmin hb hsmall' S Ps N k p d f
  have htheta : 0 < (ell : ℝ) ^ ell / (m : ℝ) ^ ell := by positivity
  have htheta1 : (ell : ℝ) ^ ell / (m : ℝ) ^ ell ≤ 1 := by
    apply (div_le_one (by positivity)).mpr
    exact pow_le_pow_left₀ (Nat.cast_nonneg _) (by exact_mod_cast hml) ell
  have hM := repeated_big_positive_block_bound (E := E + 1) (D := D) m (Fintype.card G) r.card t.card
    ((r.sigma (fun g => (probes g).map (Function.Embedding.inl (β := Fin ell)))).card +
      (t.sigma (fun g => (probes g).map (Function.Embedding.inl (β := Fin ell)))).card)
    hL htheta htheta1 hr ht hcard
    (repeated_big_prime_mapped_probe_card_le probes r t hrt hp')
    (by linarith [hgap]) (by linarith [hDgap])
  have herr'' : (∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      repeatedBigPatternError (ell := ell) V (C i) T Pmin
        (repeatedBigPrimePatternBound probes r t Q ξ i)) ≤ L ^ (-(E + 1)) := by
    apply le_trans _ herr'
    apply sum_le_sum
    intro i _
    rw [repeated_big_prime_pattern_weight_norm, one_mul]
    exact le_rfl
  have hsum : L ^ (-(E + 1)) + L ^ (-(E + 1)) ≤ L ^ (-E) := by
    rw [show -(E + 1) = -E - 1 by ring, Real.rpow_sub hL0, Real.rpow_one]
    have hpw := Real.rpow_pos_of_pos hL0 (-E)
    have hdiv : L ^ (-E) / L * L = L ^ (-E) := div_mul_cancel₀ _ hL0.ne'
    apply (mul_le_mul_iff_left₀ hL0).mp
    nlinarith
  apply hbase.trans
  apply mul_le_mul_of_nonneg_right _ (Real.sqrt_nonneg _)
  exact (add_le_add hM herr'').trans hsum

end Bounty
end

section

/- Explicit exponential saving in the assignment-summed pair lattice error. -/

namespace Bounty

theorem pair_lattice_error_scale {L θ X Y : ℝ} (hL : 0 ≤ L)
    (hθ : 10*θ ≤ 1/20) (hX : X ≤ Real.exp ((27/50 : ℝ)*L))
    (hY : Y ≤ Real.exp ((27/50 : ℝ)*L)) :
    ((Real.exp (θ*L))^(10 : ℝ))^3 * (Real.exp ((1/20 : ℝ)*L))^2 +
      (X+Y)*((Real.exp (θ*L))^(10 : ℝ))^2 * Real.exp ((1/20 : ℝ)*L) ≤
        3*Real.exp ((69/100 : ℝ)*L) := by
  have hz : (Real.exp (θ*L))^(10 : ℝ) = Real.exp (10*θ*L) := by
    rw [← Real.exp_mul]
    congr 1
    ring
  have hfirst : ((Real.exp (θ*L))^(10 : ℝ))^3 * (Real.exp ((1/20 : ℝ)*L))^2 =
      Real.exp ((30*θ+1/10)*L) := by
    rw [hz, pow_succ, pow_two, pow_two]
    simp only [← Real.exp_add]
    congr 1
    ring
  have hsecond : ((Real.exp (θ*L))^(10 : ℝ))^2 * Real.exp ((1/20 : ℝ)*L) =
      Real.exp ((20*θ+1/20)*L) := by
    rw [hz, pow_two]
    simp only [← Real.exp_add]
    congr 1
    ring
  have h1 : Real.exp ((30*θ+1/10)*L) ≤ Real.exp ((69/100 : ℝ)*L) := by
    apply Real.exp_le_exp.mpr
    apply mul_le_mul_of_nonneg_right _ hL
    linarith
  have h2 : (X+Y)*Real.exp ((20*θ+1/20)*L) ≤ 2*Real.exp ((69/100 : ℝ)*L) := by
    calc
      _ ≤ (2*Real.exp ((27/50 : ℝ)*L))*Real.exp ((20*θ+1/20)*L) :=
        mul_le_mul_of_nonneg_right (by linarith) (Real.exp_pos _).le
      _ = 2*Real.exp ((20*θ+59/100)*L) := by
        rw [mul_assoc, ← Real.exp_add]
        congr 2
        ring
      _ ≤ _ := mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr
        (mul_le_mul_of_nonneg_right (by linarith) hL)) (by norm_num)
  rw [hfirst, mul_assoc (X+Y), hsecond]
  linarith

theorem eventually_pair_lattice_profile_small (C D : ℝ) :
    ∀ᶠ L : ℝ in Filter.atTop,
      C*L*Real.exp (-(31/100 : ℝ)*L) ≤ L^(-D) := by
  filter_upwards [eventually_linear_exponential_profile_le_rpow
    (by norm_num : (0 : ℝ) < 31/100) (by norm_num : (0 : ℝ) < 31/100) 0 C D] with L hL
  simpa only [zero_mul, zero_add] using hL

end Bounty
end

