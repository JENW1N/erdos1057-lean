open Finset Classical
section

variable {K G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  (Δ D : K → G → ℤ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (t : G → ℕ) (B : ℕ)

abbrev UnrestrictedEventPath (edges : List K)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) :=
  FiniteEventPath (fun k => UnrestrictedJointEvent n (Δ k) (D k) t B)
    (fun k => unrestrictedJointEventTarget n (Δ k) (D k) t B) edges s

noncomputable def unrestrictedEventPathAction (edges : List K)
    (phase : ∀ s, UnrestrictedEventPath n Δ D t B edges s → ℂ)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ) :=
  finiteEventPathAction (fun k => UnrestrictedJointEvent n (Δ k) (D k) t B)
    (fun k => unrestrictedJointEventTarget n (Δ k) (D k) t B)
    (fun k => unrestrictedJointCutoffEventWeight n (Δ k) (D k) μ ρ V t B)
    edges phase f

theorem unrestricted_joint_actions_eq_positive :
    finiteLocalEventAction (fun k => UnrestrictedJointEvent n (Δ k) (D k) t B)
      (fun k => unrestrictedJointCutoffEventWeight n (Δ k) (D k) μ ρ V t B)
      (fun k => unrestrictedJointEventTarget n (Δ k) (D k) t B) =
    fun k => unrestrictedCutoffProductOperator n (Δ k) (D k) μ ρ V t B
      (fun _ _ _ _ _ _ => 1) univ := by
  funext k f s
  calc
    _ = unrestrictedCoupledCutoffProductOperator n (Δ k) (D k) μ ρ V t B
        (fun _ _ => 1) f s := by
      have h := unrestricted_coupled_cutoff_eq_joint_event_sum n (Δ k) (D k) μ ρ V t B
        (fun _ _ => 1) f s
      simp only [mul_one] at h
      refine Eq.trans ?_ h.symm
      apply sum_congr
      · ext e
        simp only [mem_univ]
      · intro e _
        rfl
    _ = _ := congrFun (unrestricted_coupled_positive_cutoff_eq_product n (Δ k) (D k)
      μ ρ V t B f) s

theorem unrestricted_event_path_one_eq_positive_list (edges : List K)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ) :
    unrestrictedEventPathAction n Δ D μ ρ V t B edges (fun _ _ => 1) f =
      unrestrictedPositiveEdgeList n Δ D μ ρ V t B univ edges f := by
  unfold unrestrictedEventPathAction
  rw [finite_event_path_action_one, finite_event_path_positive_eq_list,
    unrestricted_joint_actions_eq_positive]
  rfl

theorem unrestricted_event_path_norm_le_positive_list
    (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ V g) (hμ : ∀ g p, 0 ≤ μ g p)
    (edges : List K) (phase : ∀ s, UnrestrictedEventPath n Δ D t B edges s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) :
    ‖unrestrictedEventPathAction n Δ D μ ρ V t B edges phase f s‖ ≤
      (unrestrictedPositiveEdgeList n Δ D μ ρ V t B univ edges (complexNormEnvelope f) s).re := by
  have h := finite_event_path_norm_le_list_re
    (fun k => UnrestrictedJointEvent n (Δ k) (D k) t B)
    (fun k => unrestrictedJointEventTarget n (Δ k) (D k) t B)
    (fun k => unrestrictedJointCutoffEventWeight n (Δ k) (D k) μ ρ V t B)
    (fun k => unrestrictedJointCutoffEventWeight_nonneg n (Δ k) (D k) μ V hρ hV hμ t B)
    edges phase hphase f s
  rw [unrestricted_joint_actions_eq_positive] at h
  exact h

theorem unrestricted_event_path_energy_le
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, t g ≤ T)
    (edges : List K) (phase : ∀ s, UnrestrictedEventPath n Δ D t B edges s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (unrestrictedEventPathAction n Δ D μ ρ V t B edges phase f) ≤
      (unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G) ^ edges.length *
        finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  apply finiteWeightedEnergy_le_of_envelope_domination
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productMemoryWeight_nonneg μ (fun g => unrestrictedResidueWeight (μ g))
      hμ (fun g z => hμ g z.1)) f _
    (unrestrictedPositiveEdgeList n Δ D μ ρ V t B univ edges)
  · intro s
    exact (unrestricted_event_path_norm_le_positive_list n Δ D μ ρ V t B hρ0.le
      (fun g => (hvmin.trans_le (hVlo g)).le) hμ edges phase hphase f s).trans
        (Complex.re_le_norm _)
  · simpa only [card_univ] using unrestricted_positive_edge_list_energy_le n Δ D μ ρ V t B univ
      hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht edges
      (complexNormEnvelope f) (complexNormEnvelope_memory_symmetric f hf)

/-- An arbitrary ledger or history exclusion is a single mask on complete
trajectories. It does not require symmetry of any masked intermediate output. -/
theorem unrestricted_event_path_mask_energy_le
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, t g ≤ T)
    (edges : List K) (allowed : ∀ s, UnrestrictedEventPath n Δ D t B edges s → Prop)
    (phase : ∀ s, UnrestrictedEventPath n Δ D t B edges s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (unrestrictedEventPathAction n Δ D μ ρ V t B edges
        (fun s p => if allowed s p then phase s p else 0) f) ≤
      (unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G) ^ edges.length *
        finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  apply unrestricted_event_path_energy_le n Δ D μ ρ V t B hρ0 hρ1 hv hvmin
    hVlo hVhi hμ hmass T ht edges _ _ f hf
  intro s p
  split_ifs
  · exact hphase s p
  · simp

end
