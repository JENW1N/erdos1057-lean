/-- The complete transfer theorem from smooth prime supply and ambient cancellation.
The two hypotheses have not been proved by this file. -/
theorem target_of_analytic_inputs (hS : SmoothShiftedPrimeSupply)
    (hC : AmbientPrimeCancellation) : fcTypeOfName% "Erdos1057.erdos_1057" := by
  apply target_of_power_prime_reservoirs
  intro δ hδ hδsmall σ hσ
  exact powerPrimeReservoir_of_analytic_inputs hS hC hδ hδsmall hσ

/-- A uniform conventional prime-character estimate and the smooth shifted-prime
supply imply the exact target. These remain explicit assumptions, not axioms. -/
theorem target_of_smooth_primes_and_uniform_character_estimate
    (hS : SmoothShiftedPrimeSupply) (hC : UniformPrimeCharacterEstimate) :
    fcTypeOfName% "Erdos1057.erdos_1057" :=
  target_of_analytic_inputs hS (ambientPrimeCancellation_of_uniform_estimate hC)
end

