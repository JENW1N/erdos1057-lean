/- The original selected prime peel has exactly the residual used by the analytic application. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

theorem marked_divisor_weight_subtype {G : Type*} (groups : Finset G)
    (P : G → Finset ℕ) (q : ℝ) (V : G → ℝ) (t : G → ℕ) (n : ℤ) :
    markedDivisorWeight univ (fun g : groups => P g.val) q
      (fun g => V g.val) (fun g => t g.val) n = markedDivisorWeight groups P q V t n := by
  exact prod_coe_sort groups (fun g => markedDivisorFactor q (V g) (physicalOmega P g n) (t g))

theorem candidate_selected_prime_peel_eq_four_convolution
    (c L q : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm
      (candidateRoughSlot c L r jStar hr hj)) = false)
    (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ)
    (t u : candidatePIndices c L → ℕ) (g : candidatePIndices c L) (k : ℕ)
    (big : Finset (candidatePIndices c L))
    (b : GroupMarkedLists (fun g : big => candidatePBand (c*L) g.val.val)
      (fun g : big => u g.val) → ℂ) (α β : ℕ → ℂ)
    (hα : ∀ n, ¬ Disjoint n.primeFactors ((candidatePIndices c L).biUnion (candidatePBand (c*L))) → α n = 0)
    (hβ : ∀ n, ¬ Disjoint n.primeFactors ((candidatePIndices c L).biUnion (candidatePBand (c*L))) → β n = 0)
    {n : ℕ} (hn : n ≠ 0) :
    markedPrimePeel univ (fun g : candidatePIndices c L => candidatePBand (c*L) g.val) q
      (fun g => ∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ)) t g k
      (fun m => groupMarkedAverage (fun g : big => candidatePBand (c*L) g.val.val)
        (fun g : big => u g.val) (m : ℤ) b *
        invariantTripleEndpoint ((candidatePIndices c L).biUnion (candidatePBand (c*L))) α β
          (fun s => conj (candidateResidualPrimeCoefficient c L r jStar hr hj take hkeep
            (candidateAllocationFourierTwist c L r jStar take ξ) s)) m) n =
    endpointFourConvolution
      (fun p => if p ∈ candidatePBand (c*L) g.val
        then 1/(((∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ)) : ℝ) : ℂ) else 0) α β
      (candidateSelectedResidualCoefficient c L q r jStar hr hj take hkeep ξ
        (Function.update t g k) u big b (fun _ => 1) (fun _ => 1)) n := by
  classical
  have h := selected_marked_prime_peel_four_convolution
    (fun g : candidatePIndices c L => candidatePBand (c*L) g.val)
    ((candidatePIndices c L).biUnion (candidatePBand (c*L))) q
    (fun g => ∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ)) t u g k big b α β
    (fun s => conj (candidateResidualPrimeCoefficient c L r jStar hr hj take hkeep
      (candidateAllocationFourierTwist c L r jStar take ξ) s))
    (by
      intro g p hp
      exact ((mem_dyadicPrimeBand_iff (c*L) (3/2) (9/5) g.val p).mp hp).1)
    (by
      intro g p hp
      exact mem_biUnion.mpr ⟨g.val,g.property,hp⟩) hα hβ hn
  rw [h]
  congr 1
  funext z
  simp only [candidateSelectedResidualCoefficient,mul_one]

end Bounty
