    (fun d => physicalRootPlanSmallWeight groups patterns C hC V q k r pl
      ((physicalSelectedGroupReindex e (fun g => P g.val)
        (fun j (g : {g // g ∉ groupsᶜ}) =>
          C (physicalRootSmallPlanPattern groups patterns C hC pl j).val g.val)).symm d)) x hx path
  have hs := physical_root_weighted_mixed_small_factor groups e patterns C hC k pl hPs hPb hdis
    V hq r ω β retention ρ cut hencode x hx path
  exact hc.trans (congrArg (fun z => z * finiteEventLocalPhase
