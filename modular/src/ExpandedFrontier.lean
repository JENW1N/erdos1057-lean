/- The original reconstructed path has exactly the fixed-small-plan local
big coefficient for every possible big source, target, and auxiliary draw. -/

open scoped Classical
namespace Bounty

theorem physical_root_plan_fixed_edge_coefficient
    {I : Type} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    (groups : Finset (Fin N)) (patterns : Finset I)
    (C : I → Fin N → Finset (Fin J))
    (hC : ∀ i : patterns, ∀ g : ↥groupsᶜ, C i.val g.val = ∅)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ) (θ : ℝ)
    (p : PhysicalRootSmallPlan (P := P) (J := J) (ell := ell) (n := n) groups patterns)
    (db : PhysicalRootSmallPlanBigData groups patterns C hC p) (j : Fin (n + 1))
    (Lb Rb : PhysicalMarkLists (fun g : {g // g ∉ groupsᶜ} => P g.val) J ell)
    (ab : PhysicalAuxLabels (fun g : {g // g ∉ groupsᶜ} => P g.val)
      (fun g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val g.val)) :
    let old := physicalRootSmallPlanPath groups patterns C hC p db
    physicalFixedEdgeBigCoefficient (fun g => g ∈ groupsᶜ) patterns C (ζ (n - j.val))
      (physicalLocalFourierCoefficient C k K θ (n - j.val))
      (finitePathLabels old.2 j.val) (finitePathMarks old.1 old.2 j.val)
      (finitePathMarks old.1 old.2 (j.val + 1))
      (physicalRootSmallPlanPattern groups patterns C hC p j).val Lb Rb ab =
    physicalRootPlanBigCoefficient groups patterns C hC ζ k K θ p j Lb Rb ab := by
  let d := (physicalGroupSelectedSplit (fun g => g ∈ groupsᶜ)
    (fun j => C (physicalRootSmallPlanPattern groups patterns C hC p j).val)).symm
      (physicalRootSmallPlanSmallData groups patterns C hC p, db)
  have hm := physical_selected_inverse_finite_path_marks patterns C
    (physicalRootSmallPlanPattern groups patterns C hC p) d
  have hs := congrFun hm j.castSucc
  have ht := congrFun hm j.succ
  dsimp only [Fin.val_castSucc, Fin.val_succ] at hs ht
  dsimp only
  rw [physical_root_small_plan_path_selected]
  rw [hs, ht]
  simp only [finitePathLabels, dif_pos j.isLt, physical_path_selected_inverse_step]
  exact physical_selected_split_fixed_coefficient (fun g => g ∈ groupsᶜ) patterns C
    (physicalRootSmallPlanPattern groups patterns C hC p)
    (physicalRootSmallPlanSmallData groups patterns C hC p) db (ζ (n - j.val))
    (physicalLocalFourierCoefficient C k K θ (n - j.val)) j Lb Rb ab

end Bounty
