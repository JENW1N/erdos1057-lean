    (hx : FullMixedLedgerCovers n B (initial x, x))
    (paths : Finset (FullPermutationMixedPath n S B A Δ D steps x))
    (F : FullPermutationMixedPath n S B A Δ D steps x → ℂ)
    (encode : ((g : Fin N) × P g) → ℤ) (hencode : Function.Injective encode) :
    (∑ p ∈ paths, F p *
      (finiteEventPathWeight (FullPermutationMixedEvent n S B A Δ D)
        (fullPermutationMixedEventTarget n S B A Δ D)
        (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V) steps x p : ℂ) *
