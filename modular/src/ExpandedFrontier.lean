/- Enlarging the finite P range preserves each original spatially supported integrand. -/

open Finset Filter

namespace Bounty

theorem candidate_small_P_set_mono (c L : ℝ) {X Y : ℝ} (hXY : X ≤ Y) :
    candidateSmallPSet c L X ⊆ candidateSmallPSet c L Y := by
  intro p hp
  obtain ⟨hpX,hpool⟩ := (mem_candidateSmallPSet_iff c L X p).mp hp
  exact (mem_candidateSmallPSet_iff c L Y p).mpr ⟨hpX.trans_le hXY,hpool⟩

theorem candidate_full_P_finite_test_enlarge (c L q : ℝ) (r jStar : ℕ) (R E X Y : ℝ)
    (S : Finset ℕ) (G : ℕ → ℂ) (hXY : X ≤ Y) (hS : ∀ u ∈ S, (u : ℝ) ≤ X)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ) :
    candidateFullPAllocationIntegrand c L q r jStar R (candidateSmallPSet c L (X+1))
      take (candidateBoxFiniteTest L E S G) ξ =
    candidateFullPAllocationIntegrand c L q r jStar R (candidateSmallPSet c L (Y+1))
      take (candidateBoxFiniteTest L E S G) ξ := by
  classical
  unfold candidateFullPAllocationIntegrand
  apply sum_subset (candidate_small_P_set_mono c L (by linarith : X+1 ≤ Y+1))
  intro p hpY hpX
  have hpnot : ¬ (p : ℝ) < X+1 := by
    intro hh
    exact hpX ((mem_candidateSmallPSet_iff c L (X+1) p).mpr
      ⟨hh,((mem_candidateSmallPSet_iff c L (Y+1) p).mp hpY).2⟩)
  have hp : X < (p : ℝ) := by linarith [le_of_not_gt hpnot]
  rw [candidate_separated_finite_test_large_P c L r jStar R E X S G hS take p hp ξ,mul_zero]

theorem eventually_candidate_retained_finite_test_enlarge {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ) (R E X Y : ℝ)
      (S : Finset ℕ) (G : ℕ → ℂ), X ≤ Y → (∀ u ∈ S, (u : ℝ) ≤ X) →
      ∀ (take : Fin ((candidateQIndices c L).card*r) → Bool)
        (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ),
      candidateRetainedAllocationIntegrand c L q r jStar R (candidateSmallPSet c L (X+1))
        take (candidateBoxFiniteTest L E S G) ξ =
      candidateRetainedAllocationIntegrand c L q r jStar R (candidateSmallPSet c L (Y+1))
        take (candidateBoxFiniteTest L E S G) ξ := by
  filter_upwards [eventually_candidate_retained_allocation_integrand_eq hc] with L heq
  intro q r jStar R E X Y S G hXY hS take ξ
  rw [← heq q r jStar R (candidateSmallPSet c L (X+1)) take
    (fun p hp => ((mem_candidateSmallPSet_iff c L (X+1) p).mp hp).2) _ ξ,
    ← heq q r jStar R (candidateSmallPSet c L (Y+1)) take
    (fun p hp => ((mem_candidateSmallPSet_iff c L (Y+1) p).mp hp).2) _ ξ]
  exact candidate_full_P_finite_test_enlarge c L q r jStar R E X Y S G hXY hS take ξ

end Bounty
