section

/- Every row is the actual signed ghost row, the two permutation averages,
or the sum of actual mixed full actions over one pattern and one auxiliary. -/

open Finset
open scoped Classical
namespace Bounty
section Paths
variable {S G I V K : Type} [Fintype S] [Fintype G] [DecidableEq G]
  [Fintype I] {Ps : S → Finset ℕ} {P : G → Type} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] {J ell : ℕ} {M : G → ℕ}
  (shared : I → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : I → Type) [∀ i, Fintype (A i)]
  (Δ D : ∀ _k : K, ∀ i, PhysicalSharedLists Ps J → SharedActiveLabels P (shared i) → A i → G → ℤ)
  (kbig : ∀ _k : K, ∀ i, SharedActiveLabels P (shared i) → A i → ℤ)
  (ω : ∀ i, SharedActiveLabels P (shared i) → A i → ℝ)
  (μ : ∀ g, P g → ℝ) (qghost : V → ℝ) (ρ : ℝ) (Vb : G → ℝ)
  (Vs : S → ℝ) (qedge : K → ℝ)
  (phase : ∀ tag s, PhysicalMixedWordEvent (ell := ell) n shared B A Δ D tag s → ℂ)


noncomputable def physicalMixedWordPathAction (steps : List (Option (V ⊕ K)))
    (pathPhase : ∀ s, FiniteEventPath (PhysicalMixedWordEvent (ell := ell) n shared B A Δ D)
      (physicalMixedWordTarget n shared B A Δ D kbig) steps s → ℂ)
    (F : PhysicalMixedWordState (Ps := Ps) (J := J) (ell := ell) (M := M) n B → ℂ) :=
  let _ : ∀ tag s, Fintype (PhysicalMixedWordEvent (V := V) (ell := ell) n shared B A Δ D tag s) :=
    physicalMixedWordEventFintype n shared B A Δ D
  finiteEventPathAction (PhysicalMixedWordEvent (ell := ell) n shared B A Δ D)
    (physicalMixedWordTarget n shared B A Δ D kbig)
    (physicalMixedWordWeight n shared B A Δ D kbig ω μ qghost ρ Vb Vs qedge) steps pathPhase F

theorem physical_mixed_word_eq_paths (steps : List (Option (V ⊕ K)))
    (F : PhysicalMixedWordState (Ps := Ps) (J := J) (ell := ell) (M := M) n B → ℂ) :
    finiteOperatorListAction
      (physicalMixedWordRow n shared B A Δ D kbig ω μ qghost ρ Vb Vs qedge phase) steps F =
    physicalMixedWordPathAction n shared B A Δ D kbig ω μ qghost ρ Vb Vs qedge steps
      (finiteEventLocalPhase (PhysicalMixedWordEvent (ell := ell) n shared B A Δ D)
        (physicalMixedWordTarget n shared B A Δ D kbig) phase steps) F := by
  let _ : ∀ tag s, Fintype (PhysicalMixedWordEvent (V := V) (ell := ell) n shared B A Δ D tag s) :=
    physicalMixedWordEventFintype n shared B A Δ D
  exact finite_phased_rows_eq_event_paths _ _ _ _ steps F

end Paths
end Bounty
end

section

/- Exact packing into small-coordinate choices and original full big paths.
No pattern, auxiliary, permutation, or zero-weight event is removed. -/

open Finset
open scoped Classical
namespace Bounty
section Packing
variable {S G I V K : Type} [Fintype S]
  {Ps : S → Finset ℕ} {P : G → Type}
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : I → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : I → Type)
  (Δ D : ∀ _k : K, ∀ i, PhysicalSharedLists Ps J → SharedActiveLabels P (shared i) → A i → G → ℤ)
  (kbig : ∀ _k : K, ∀ i, SharedActiveLabels P (shared i) → A i → ℤ)

noncomputable def physicalMixedPathUnpack : ∀ ks r L x,
    FiniteEventPath (PhysicalMixedWordEvent (V := V) (ell := ell) n shared B A Δ D)
      (physicalMixedWordTarget n shared B A Δ D kbig) ks ((r, L), x) →
    Σ pl : PhysicalMixedSmallPlan (I := I) ks, PhysicalMixedPlannedBigPath n shared B A Δ D ks L pl x
  | [], _, _, _, _ => ⟨PUnit.unit, PUnit.unit⟩
  | none :: ks, r, L, x, ⟨⟨σ, τ⟩, p⟩ =>
      let z := physicalMixedPathUnpack ks r (physicalPermuteLabels σ L) (fullActivePermutation τ x) p
      ⟨(σ, z.1), ⟨ULift.up τ, z.2⟩⟩
  | some (.inl _) :: ks, r, L, x, ⟨e, p⟩ =>
      let z := physicalMixedPathUnpack ks r L (coupledGhostJointEventTarget M B x e) p
      ⟨z.1, ⟨ULift.up e, z.2⟩⟩
  | some (.inr k) :: ks, r, L, x, ⟨⟨i, a, ⟨R, ⟨_, e⟩⟩⟩, p⟩ =>
      let z := physicalMixedPathUnpack ks
        (physicalTranslateResidues r (kbig k i (productActiveMemorySplit (shared i) B x).1 a *
          (physicalSharedProduct (physicalSharedPrefix L) : ℕ))) R
        (fullActiveEdgeEventTarget n (shared i) B (fun _ => A i)
          (Δ k i (physicalSharedPrefix L)) (D k i (physicalSharedPrefix L)) x ⟨a, e⟩) p
      ⟨((i, R), z.1), ⟨⟨a, e⟩, z.2⟩⟩

noncomputable def physicalMixedPathPack : ∀ ks r L x,
    (Σ pl : PhysicalMixedSmallPlan (I := I) ks, PhysicalMixedPlannedBigPath n shared B A Δ D ks L pl x) →
    FiniteEventPath (PhysicalMixedWordEvent (V := V) (ell := ell) n shared B A Δ D)
      (physicalMixedWordTarget n shared B A Δ D kbig) ks ((r, L), x)
  | [], _, _, _, _ => PUnit.unit
  | none :: ks, r, L, x, ⟨(σ, pl), ⟨τ, p⟩⟩ =>
      ⟨(σ, τ.down), physicalMixedPathPack ks r (physicalPermuteLabels σ L)
        (fullActivePermutation τ.down x) ⟨pl, p⟩⟩
  | some (.inl _) :: ks, r, L, x, ⟨pl, ⟨e, p⟩⟩ =>
      ⟨e.down, physicalMixedPathPack ks r L
        (coupledGhostJointEventTarget M B x e.down) ⟨pl, p⟩⟩
  | some (.inr k) :: ks, r, L, x, ⟨((i, R), pl), ⟨⟨a, e⟩, p⟩⟩ =>
      ⟨⟨i, a, (R, ⟨(), e⟩)⟩, physicalMixedPathPack ks
        (physicalTranslateResidues r (kbig k i (productActiveMemorySplit (shared i) B x).1 a *
          (physicalSharedProduct (physicalSharedPrefix L) : ℕ))) R
        (fullActiveEdgeEventTarget n (shared i) B (fun _ => A i)
          (Δ k i (physicalSharedPrefix L)) (D k i (physicalSharedPrefix L)) x ⟨a, e⟩) ⟨pl, p⟩⟩

theorem physical_mixed_path_pack_unpack (ks : List (Option (V ⊕ K))) r L x
    (p : FiniteEventPath (PhysicalMixedWordEvent (ell := ell) n shared B A Δ D)
      (physicalMixedWordTarget n shared B A Δ D kbig) ks ((r, L), x)) :
    physicalMixedPathPack n shared B A Δ D kbig ks r L x
      (physicalMixedPathUnpack n shared B A Δ D kbig ks r L x p) = p := by
  induction ks generalizing r L x with
  | nil => cases p; rfl
  | cons tag ks ih =>
    cases tag with
    | none =>
      rcases p with ⟨⟨σ, τ⟩, p⟩
      simp only [physicalMixedPathUnpack, physicalMixedPathPack]
      erw [Sigma.eta, ih]
    | some tag =>
      cases tag with
      | inl j =>
        rcases p with ⟨e, p⟩
        simp only [physicalMixedPathUnpack, physicalMixedPathPack]
        erw [Sigma.eta, ih]
      | inr k =>
        rcases p with ⟨⟨i, a, R, u, e⟩, p⟩
        cases u
        simp only [physicalMixedPathUnpack, physicalMixedPathPack]
        erw [Sigma.eta, ih]

theorem physical_mixed_path_unpack_pack (ks : List (Option (V ⊕ K))) r L x
    (z : Σ pl : PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) ks,
      PhysicalMixedPlannedBigPath n shared B A Δ D ks L pl x) :
    physicalMixedPathUnpack n shared B A Δ D kbig ks r L x
      (physicalMixedPathPack n shared B A Δ D kbig ks r L x z) = z := by
  induction ks generalizing r L x with
  | nil => rcases z with ⟨⟨⟩, ⟨⟩⟩; rfl
  | cons tag ks ih =>
    cases tag with
    | none =>
      rcases z with ⟨⟨σ, pl⟩, ⟨⟨τ⟩, p⟩⟩
      simp only [physicalMixedPathPack, physicalMixedPathUnpack]
      rw [ih]
    | some tag =>
      cases tag with
      | inl j =>
        rcases z with ⟨pl, ⟨⟨e⟩, p⟩⟩
        simp only [physicalMixedPathPack, physicalMixedPathUnpack]
        rw [ih]
      | inr k =>
        rcases z with ⟨⟨⟨i, R⟩, pl⟩, ⟨⟨a, e⟩, p⟩⟩
        simp only [physicalMixedPathPack, physicalMixedPathUnpack]
        rw [ih]

noncomputable def physicalMixedPathPackingEquiv (ks : List (Option (V ⊕ K))) r L x :
    FiniteEventPath (PhysicalMixedWordEvent (ell := ell) n shared B A Δ D)
      (physicalMixedWordTarget n shared B A Δ D kbig) ks ((r, L), x) ≃
    Σ pl : PhysicalMixedSmallPlan (I := I) ks, PhysicalMixedPlannedBigPath n shared B A Δ D ks L pl x where
  toFun := physicalMixedPathUnpack n shared B A Δ D kbig ks r L x
  invFun := physicalMixedPathPack n shared B A Δ D kbig ks r L x
  left_inv := physical_mixed_path_pack_unpack n shared B A Δ D kbig ks r L x
  right_inv := physical_mixed_path_unpack_pack n shared B A Δ D kbig ks r L x

end Packing
end Bounty
end

section

/- Packing preserves the original chronological tags and number of steps. -/

namespace Bounty
section Schedule
variable {S I V K : Type} {Ps : S → Finset ℕ} {J ell : ℕ}

theorem physical_mixed_big_steps_tags (ks : List (Option (V ⊕ K)))
    (L : PhysicalMarkLists Ps J ell)
    (pl : PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) ks) :
    (physicalMixedBigSteps ks L pl).map
      (Option.map (Sum.map id (fun key => key.1))) = ks := by
  induction ks generalizing L with
  | nil => rfl
  | cons tag ks ih =>
    cases tag with
    | none =>
      rcases pl with ⟨σ, pl⟩
      simpa only [physicalMixedBigSteps, List.map_cons, Option.map_none] using
        congrArg (none :: ·) (ih (physicalPermuteLabels σ L) pl)
    | some tag =>
      cases tag with
      | inl j =>
        simpa only [physicalMixedBigSteps, List.map_cons, Option.map_some, Sum.map_inl, id_eq] using
          congrArg (some (.inl j) :: ·) (ih L pl)
      | inr k =>
        rcases pl with ⟨⟨i, R⟩, pl⟩
        simpa only [physicalMixedBigSteps, List.map_cons, Option.map_some, Sum.map_inr] using
          congrArg (some (.inr k) :: ·) (ih R pl)

theorem physical_mixed_big_steps_length (ks : List (Option (V ⊕ K)))
    (L : PhysicalMarkLists Ps J ell)
    (pl : PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) ks) :
    (physicalMixedBigSteps ks L pl).length = ks.length := by
  simpa only [List.length_map] using congrArg List.length (physical_mixed_big_steps_tags ks L pl)

end Schedule
end Bounty
end

section

/- Small scalar factors have modulus at most one in the physical range. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_completion_mass_mem_unit_interval {S : Type} [Fintype S]
    {J : ℕ} (V : S → ℝ) (C : S → Finset (Fin J)) (ell : ℕ) (hV : ∀ g, 1 ≤ V g) :
    0 ≤ physicalCompletionMass V C ell ∧ physicalCompletionMass V C ell ≤ 1 := by
  constructor
  · exact le_of_lt (physical_completion_mass_pos V C ell (fun g => lt_of_lt_of_le zero_lt_one (hV g)))
  · apply prod_le_one₀
    · intro g _
      exact div_nonneg zero_le_one (pow_nonneg (le_trans zero_le_one (hV g)) _)
    · intro g _
      exact (div_le_one (pow_pos (lt_of_lt_of_le zero_lt_one (hV g)) _)).mpr (one_le_pow₀ (hV g))

theorem physical_residue_vertex_mem_unit_interval {S : Type} [Fintype S]
    {P : S → Finset ℕ} {J ell : ℕ} (L : PhysicalMarkLists P J ell)
    (q : ℝ) (r : PhysicalResidues P) (hq0 : 0 ≤ q) (hq1 : q ≤ 1) :
    0 ≤ physicalResidueVertexWeight L q r ∧ physicalResidueVertexWeight L q r ≤ 1 := by
  unfold physicalResidueVertexWeight
  split_ifs
  · exact ⟨prod_nonneg (fun _ _ => pow_nonneg hq0 _),
      prod_le_one₀ (fun _ _ => pow_nonneg hq0 _) (fun _ _ => pow_le_one₀ hq0 hq1)⟩
  · exact ⟨le_rfl, zero_le_one⟩

section Small
variable {S G I V K : Type} [Fintype S]
  {Ps : S → Finset ℕ} {P : G → Type}
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : I → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : I → Type)
  (Δ D : ∀ _k : K, ∀ i, PhysicalSharedLists Ps J → SharedActiveLabels P (shared i) → A i → G → ℤ)
  (kbig : ∀ _k : K, ∀ i, SharedActiveLabels P (shared i) → A i → ℤ)
  (Vs : S → ℝ) (qedge : K → ℝ) (hV : ∀ g, 1 ≤ Vs g) (hq : ∀ k, qedge k ≤ 1)

include hV hq in
theorem physical_mixed_small_weight_mem_unit_interval (tag : Option (V ⊕ K))
    (s : PhysicalMixedWordState (Ps := Ps) (J := J) (ell := ell) (M := M) n B)
    (e : PhysicalMixedWordEvent n shared B A Δ D tag s) :
    0 ≤ physicalMixedSmallWeight n shared B A Δ D kbig Vs qedge tag s e ∧
      physicalMixedSmallWeight n shared B A Δ D kbig Vs qedge tag s e ≤ 1 := by
  cases tag with
  | none =>
    change 0 ≤ (Fintype.card (PhysicalPermutations S J ell) : ℝ)⁻¹ ∧
      (Fintype.card (PhysicalPermutations S J ell) : ℝ)⁻¹ ≤ 1
    constructor
    · positivity
    · apply inv_le_one_of_one_le₀
      exact_mod_cast Fintype.card_pos (α := PhysicalPermutations S J ell)
  | some tag =>
    cases tag with
    | inl j => exact ⟨zero_le_one, le_rfl⟩
    | inr k =>
      dsimp only [physicalMixedSmallWeight]
      split_ifs
      · have hm := physical_completion_mass_mem_unit_interval Vs (fun _ => (∅ : Finset (Fin J))) ell hV
        have hs := physical_residue_vertex_mem_unit_interval s.1.2 (Real.sqrt (qedge k)) s.1.1
          (Real.sqrt_nonneg _) (Real.sqrt_le_one.mpr (hq k))
        have ht := physical_residue_vertex_mem_unit_interval e.2.2.1 (Real.sqrt (qedge k))
          (physicalTranslateResidues s.1.1
            (kbig k e.1 (productActiveMemorySplit (shared e.1) B s.2).1 e.2.1 *
              (physicalSharedProduct (physicalSharedPrefix s.1.2) : ℕ)))
          (Real.sqrt_nonneg _) (Real.sqrt_le_one.mpr (hq k))
        exact ⟨mul_nonneg hm.1 (mul_nonneg hs.1 ht.1),
          mul_le_one₀ hm.2 (mul_nonneg hs.1 ht.1) (mul_le_one₀ hs.2 ht.1 ht.2)⟩
      · exact ⟨le_rfl, zero_le_one⟩

end Small
end Bounty
end

section

/- The actual discrepant ambient coefficients are positive-indexed and free of the candidate group pool. -/

open Finset Filter

namespace Bounty

theorem eventually_ambient_rough_endpoint_group_free {c γ : ℝ}
    (hc : 0 < c) (hγ : 0 < γ) :
    ∀ᶠ L : ℝ in atTop, ∀ S a v : ℝ, ∀ m : ℕ,
      ambientRoughIntervalTypeIIAlpha γ L S a v m ≠ 0 →
      0 < m ∧ Disjoint m.primeFactors
        ((candidatePIndices c L).biUnion (candidatePBand (c*L))) := by
  filter_upwards [eventually_candidate_P_pool_below_rough_cutoff hc,
    eventually_ambient_rough_interval_typeII_properties hγ] with L hpool hrough
  intro S a v m hm
  obtain ⟨hmem, hprimes⟩ := (hrough S a v m).2 hm
  refine ⟨?_, prime_factors_disjoint_of_rough hpool hprimes⟩
  exact (mem_Icc.mp (mem_filter.mp hmem).1).1

theorem eventually_ambient_prime_endpoint_group_free {c : ℝ}
    (hc : 0 < c) (S : ℝ) (hS : 0 ≤ S) :
    ∀ᶠ L : ℝ in atTop, ∀ κ : ℝ, 0 ≤ κ → κ ≤ 1/50 → ∀ m : ℕ,
      ambientPrimeTypeIIAlpha κ L S m ≠ 0 →
      0 < m ∧ Disjoint m.primeFactors
        ((candidatePIndices c L).biUnion (candidatePBand (c*L))) := by
  filter_upwards [eventually_candidate_P_pool_below_rough_cutoff hc,
    eventually_balanced_typeII_coefficient_properties S hS] with L hpool hprime
  intro κ hκ hκmax m hm
  obtain ⟨hmem, hprimes⟩ := (hprime κ hκ hκmax m).2.2.2 hm
  refine ⟨?_, prime_factors_disjoint_of_rough hpool hprimes⟩
  exact (mem_Icc.mp (mem_filter.mp hmem).1).1


end Bounty
end

section

/- Every original root summand with explicit small residues, capped big memory, and its exact return indicator. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_finite_root_term_mixed_unrestricted
    {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    [∀ a : PhysicalPrime P, NeZero a.2.val]
    (groups : Finset (Fin N)) (V : Fin N → ℝ) (patterns : Finset I)
    (C : I → Fin N → Finset (Fin J)) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ)
    (L : PhysicalMarkLists P J ell)
    (p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)
    (hV : ∀ g, 0 < V g)
    (hP : ∀ g a, a ∈ P g → Nat.Prime a)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hk : ∀ j : Fin (n + 1), ∀ g s,
      ¬ (((physicalPathSelectedEquiv patterns C (L, p)).2.2.1 j.castSucc g s).val : ℤ) ∣
        physicalPathSelectedMultiplier C k p j)
    (b : PhysicalPrime P → ℝ)
    (hb : ∀ a : PhysicalPrime P, a.1 ∈ groups →
      b a = 1 - (∑ j ∈ range (n + 2), (1 - physicalEndpointSchedule q (n + 1) j)) / a.2.val)
    (hb0 : ∀ a : PhysicalPrime P, a.1 ∈ groups → b a ≠ 0)
    (B : ℕ) (hB : (physicalPrimeGroups P groups).card ≤ B) :
    (physicalStateMass V J ell : ℂ) * physicalFiniteReturnScalar V patterns C ζ k K n L p *
      (physicalFiniteVertexExpectation C q k n L p : ℂ) =
    (∏ a ∈ physicalPrimeGroups P groups, b a : ℝ) *
      ∑ r : PhysicalGroupResidues P groupsᶜ,
        (∏ a : ↥(physicalPrimeGroups P groupsᶜ), 1 / (a.val.2.val : ℝ)) *
        (if physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p) (n + 1) (n + 1) = 0 then
          (((physicalStateMass (fun g : ↥groupsᶜ => V g.val) J ell *
          ∏ j ∈ range (n + 1), physicalCompletionMass (fun g : ↥groupsᶜ => V g.val)
            (fun g => C (finitePathLabels p j).2.2.1.val g.val) ell : ℝ) : ℂ) *
          physicalMemoryWalkScalar V patterns C ζ K (finitePathLabels p) (finitePathMarks L p) (n + 1) *
          physicalGroupFiniteVertexWeight groupsᶜ C q k L p r *
          physicalGroupFiniteCappedHistory groups C q k
            (fun a => ((a.2.val : ℝ) * b a)⁻¹) V B L p) else 0) := by
  rw [physical_finite_root_term_partial_unrestricted
    groups V patterns C q ζ k K L p hV hP hdis hk b hb hb0]
  by_cases ho : physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p) (n + 1) (n + 1) = 0
  · simp only [if_pos ho]
    rw [← physical_group_residue_vertex_pool_expectation groupsᶜ hdis hP]
    rw [← physical_group_finite_path_capped_eq_run_product groups C k L p
      (fun j => 1 - physicalEndpointSchedule q (n + 1) j)
      (fun a => ((a.2.val : ℝ) * b a)⁻¹) V B hB]
    rw [physical_group_path_mass_restriction]
    simp only [physicalGroupFiniteVertexWeight, physicalGroupFiniteCappedHistory,
      Complex.ofReal_sum, Complex.ofReal_mul, mul_sum, sum_mul]
    apply sum_congr rfl
    intro r _
    ring
  · simp only [if_neg ho, mul_zero, sum_const_zero]

end Bounty
end

section

/- Exact packing of each ghost/permutation/edge/permutation block. -/

namespace Bounty

variable {S I V K : Type} {Ps : S → Finset ℕ} {J ell : ℕ}

def physicalBlockFineSteps (bs : List (V × K)) (last : V) : List (Option (V ⊕ K)) :=
  bs.flatMap (fun b => [some (.inl b.1), none, some (.inr b.2), none]) ++
    [some (.inl last)]

abbrev PhysicalSmallBlockData (Ps : S → Finset ℕ) (J ell : ℕ) (I : Type) :=
  I × PhysicalMarkLists Ps J ell × PhysicalPermutations S J ell × PhysicalPermutations S J ell

def physicalSmallBlockPlanPack (last : V) : ∀ bs : List (V × K),
    (Fin bs.length → PhysicalSmallBlockData Ps J ell I) →
    PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I)
      (physicalBlockFineSteps bs last)
  | [], _ => PUnit.unit
  | _ :: bs, d =>
    ((d 0).2.2.1, (((d 0).1, physicalPermuteLabels (d 0).2.2.2 (d 0).2.1),
      (physicalInversePermutations (d 0).2.2.2,
        physicalSmallBlockPlanPack last bs (fun j => d j.succ))))

noncomputable def physicalSmallBlockPlanUnpack (last : V) : ∀ bs : List (V × K),
    PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I)
      (physicalBlockFineSteps bs last) →
    (Fin bs.length → PhysicalSmallBlockData Ps J ell I)
  | [], _ => Fin.elim0
  | _ :: bs, p => Fin.cons
    (p.2.1.1, physicalPermuteLabels p.2.2.1 p.2.1.2, p.1,
      physicalInversePermutations p.2.2.1)
    (physicalSmallBlockPlanUnpack last bs p.2.2.2)

theorem physical_small_block_plan_unpack_pack (last : V) (bs : List (V × K))
    (d : Fin bs.length → PhysicalSmallBlockData Ps J ell I) :
    physicalSmallBlockPlanUnpack last bs (physicalSmallBlockPlanPack last bs d) = d := by
  induction bs with
  | nil => funext j; exact Fin.elim0 j
  | cons b bs ih =>
    funext j
    refine Fin.cases ?_ (fun i => ?_) j
    · simp only [physicalSmallBlockPlanUnpack, physicalSmallBlockPlanPack, Fin.cons_zero,
        physical_permute_inverse]
      rfl
    · exact congrFun (ih (d := fun j => d j.succ)) i

theorem physical_small_block_plan_pack_unpack (last : V) (bs : List (V × K))
    (p : PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I)
      (physicalBlockFineSteps bs last)) :
    physicalSmallBlockPlanPack last bs (physicalSmallBlockPlanUnpack last bs p) = p := by
  induction bs with
  | nil => change (PUnit.unit : PUnit) = p; exact Subsingleton.elim _ _
  | cons b bs ih =>
    rcases p with ⟨σ, ⟨i, R⟩, κ, p⟩
    simp only [physicalSmallBlockPlanPack, physicalSmallBlockPlanUnpack, Fin.cons_zero,
      Fin.cons_succ, physical_permute_inverse]
    change (σ, ((i, R), (κ, physicalSmallBlockPlanPack last bs
      (physicalSmallBlockPlanUnpack last bs p)))) = _
    exact congrArg (fun q => (σ, ((i, R), (κ, q)))) (ih p)

noncomputable def physicalSmallBlockPlanEquiv (last : V) (bs : List (V × K)) :
    (Fin bs.length → PhysicalSmallBlockData Ps J ell I) ≃
    PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I)
      (physicalBlockFineSteps bs last) where
  toFun := physicalSmallBlockPlanPack last bs
  invFun := physicalSmallBlockPlanUnpack last bs
  left_inv := physical_small_block_plan_unpack_pack last bs
  right_inv := physical_small_block_plan_pack_unpack last bs

end Bounty
end

section

/- The original B0 off-diagonal energy with every dyadic geometry condition discharged. -/

open Finset Filter MeasureTheory

namespace Bounty

theorem exists_actual_B0_energy_reduction {c b A D : ℝ}
    (hc : 0 < c) (hb : 0 < b) {r : ℕ} (hr : 6 ≤ r) (K : ℝ) (hK : 0 ≤ K) :
    ∃ F : ℝ, 0 < F ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (jStar : ℕ) (hj : jStar ∈ candidateQIndices c L)
        (take : Fin ((candidateQIndices c L).card*r) → Bool),
      take ((candidateAllocationOrder c L r).symm
        (candidateRoughSlot c L r jStar (by omega) hj)) = false →
      ∀ (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ) (ν U V : ℝ),
      Real.exp (b*L) ≤ U → U ≤ Real.exp L → Real.exp (b*L) ≤ V → V ≤ Real.exp L →
      ∀ (M H : Finset ℕ) (α : ℕ → ℂ),
      (∀ m ∈ M, (m:ℝ) ∈ Set.Icc U (2*U)) → (∀ m ∈ M, ‖α m‖ ≤ L^A) →
      (∀ h ∈ H, 0 < h) →
      (∀ m ∈ M, α m ≠ 0 → ∀ p ∈ m.primeFactors, Real.exp (Real.sqrt L) < (p:ℝ)) →
      let E := U*L^(-K)
      let B := typeIIAdmissibleDeterminantBound L K
      let aH := candidateB0RetainedCoefficient c L (1/2) r jStar take
        (candidateAllocationFourierTwist c L r jStar take ξ) ν
      |typeIIOffDiagonalEnergy (Icc ⌈E/(2*L^88)⌉₊ ⌊2*E⌋₊)
          (Icc ⌈V/2⌉₊ ⌊3*V⌋₊) M H
          (fun e n => typeIIEMajorant (L^88) ((e:ℝ)/E) * typeIINMajorant ((n:ℝ)/V)) α aH -
        (typeIIEnergyFourierIntegral L U V E B M H α aH
          {ζ : EuclideanSpace ℝ (Fin 3) | ‖ζ‖ ≤ L^F}).re| ≤
        (2*(B:ℝ)) * (∑ j ∈ range (typeIISmoothDyadicCount L), typeIISmoothDyadicScale U V E j) * L^(-D) := by
  obtain ⟨F, hF, hred⟩ := exists_candidate_original_energy_fourier_reduction
    (q := (1/2:ℝ)) (K₀ := K) (Cz := 3) (A := A) (D := D) hc
      (by norm_num) (by norm_num) (by norm_num)
  refine ⟨F, hF, ?_⟩
  filter_upwards [hred, eventually_typeII_actual_dyadic_geometry hb hK] with L hred hgeo
  intro jStar hj take hkeep ξ ν U V hUlo hUhi hVlo hVhi M H α hM hα hH hrough
  obtain ⟨hU, hV, hE, hUV, hlogUV, hB, hZmin, hZlog, hBW, hW⟩ :=
    hgeo U V (U*L^(-K)) hUlo hUhi hVlo hVhi rfl
  have htwist : ∀ slot p, p ∈ candidateQSlotChoices c L r jStar slot →
      ‖candidateAllocationFourierTwist c L r jStar take ξ slot p‖ ≤ 1 := by
    intro slot p hp
    exact (candidate_allocation_fourier_twist_norm c L r jStar take ξ slot
      (Nat.pos_of_ne_zero (candidate_Q_slot_nonzero c L r jStar slot hp))).le
  have h := hred r jStar (by omega) hj take hkeep _ htwist U V (U*L^(-K))
    (Real.exp (Real.sqrt L)) (typeIIAdmissibleDeterminantBound L K) hU hV rfl hUV
    hZmin hZlog M H α (2*Real.pi*ν) hM hα hH hB hBW hW hrough
  dsimp only at h ⊢
  rw [← candidate_B0_retained_eq_phase c L (1/2) r jStar take
    (candidateAllocationFourierTwist c L r jStar take ξ) ν] at h
  exact h

end Bounty
