namespace Bounty

theorem real_weighted_marked_source_conjugation {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (t : G → ℕ) (n : ℤ)
    (b : GroupMarkedLists P t → ℂ) (W : ℝ) (F : ℂ) :
    star ((W : ℂ) * groupMarkedAverage P t n (fun u => star (b u)) * F) =
      (W : ℂ) * groupMarkedAverage P t n b * star F := by
  rw [group_marked_average_star]
  simp [mul_comm, mul_assoc]

end Bounty
