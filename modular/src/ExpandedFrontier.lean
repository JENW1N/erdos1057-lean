open scoped BigOperators Classical
theorem finite_probability_gram_diagonal {X : Type*} [Fintype X]
    (μ : X → ℝ) (hmass : ∑ x, μ x = 1) (ψ : X → ℂ)
    (hunit : ∀ x, μ x ≠ 0 → ‖ψ x‖ = 1) :
    (∑ x, (μ x : ℂ) * (starRingEnd ℂ) (ψ x) * ψ x) = 1 := by
  calc
    _ = ∑ x, (μ x : ℂ) := by
      apply Finset.sum_congr rfl
      intro x _
      by_cases hx : μ x = 0
      · simp only [hx, Complex.ofReal_zero, zero_mul]
      · rw [mul_assoc, Complex.conj_mul', hunit x hx]
        simp
    _ = 1 := by rw [← Complex.ofReal_sum, hmass, Complex.ofReal_one]

theorem finite_measure_frame_reverse_pairing {X I : Type*} [Fintype X] [Fintype I]
    (μ : X → ℝ) (ψ : I → X → ℂ) (k : I) (y : X) :
    (∑ x, (μ x : ℂ) * finiteMeasureFrameKernel ψ x y * (starRingEnd ℂ) (ψ k x)) =
      ∑ i, (∑ x, (μ x : ℂ) * (starRingEnd ℂ) (ψ k x) * ψ i x) * (starRingEnd ℂ) (ψ i y) := by
  unfold finiteMeasureFrameKernel
  simp_rw [Finset.mul_sum, Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro x _
  ring

theorem finite_probability_frame_reproduction {X I : Type*} [Fintype X] [Fintype I]
    (μ : X → ℝ) (hmass : ∑ x, μ x = 1) (ψ : I → X → ℂ)
    (hunit : ∀ i x, μ x ≠ 0 → ‖ψ i x‖ = 1)
    {ε : ℝ} (hε : 0 ≤ ε)
    (hoff : ∀ i j, i ≠ j →
      ‖∑ x, (μ x : ℂ) * (starRingEnd ℂ) (ψ i x) * ψ j x‖ ≤ ε)
    (k : I) (y : X) (hy : ∀ i, ‖ψ i y‖ ≤ 1) :
    ‖(∑ x, (μ x : ℂ) * finiteMeasureFrameKernel ψ x y * (starRingEnd ℂ) (ψ k x)) -
      (starRingEnd ℂ) (ψ k y)‖ ≤ (Fintype.card I - 1 : ℕ) * ε := by
  rw [finite_measure_frame_reverse_pairing,
    ← Finset.sum_erase_add _ _ (Finset.mem_univ k),
    finite_probability_gram_diagonal μ hmass (ψ k) (hunit k), one_mul, add_sub_cancel_right]
  calc
    _ ≤ ∑ i ∈ Finset.univ.erase k,
        ‖(∑ x, (μ x : ℂ) * (starRingEnd ℂ) (ψ k x) * ψ i x) * (starRingEnd ℂ) (ψ i y)‖ := norm_sum_le _ _
    _ ≤ ∑ _i ∈ Finset.univ.erase k, ε := by
      apply Finset.sum_le_sum
      intro i hi
      rw [norm_mul, Complex.norm_conj]
      simpa only [mul_one] using mul_le_mul (hoff k i (Finset.ne_of_mem_erase hi).symm)
        (hy i) (norm_nonneg _) hε
    _ = _ := by simp
end

