/- The actual signed prime-family dirty contribution, with both small and
big endpoint projections, the original auxiliary law, and a fixed initial
fresh-birth gate. The coefficient budget is proved from the prime family. -/

open Finset Filter
open scoped Classical Topology
namespace Bounty

theorem eventually_candidate_physical_mixed_prime_dirty_norm_le
    {q vs scale : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hvs : 0 < vs) (hscale : 0 < scale)
    (ell : ℕ) (C₂ : ℝ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ᶠ L : ℝ in atTop,
      letI : DecidableEq (CandidateSmallGroup scale L) := Classical.decEq _
      letI : DecidableEq (CandidateBigGroup scale L) := Classical.decEq _
      letI : ∀ p : PhysicalPrime (candidateSmallPool scale L), NeZero p.2.val :=
        candidateSmallPrimeNeZero scale L
      letI : ∀ g p, NeZero (candidateBigModulus scale L g p) := candidateBigModulusNeZero scale L
      letI : ∀ (g : CandidateBigGroup scale L) (p : CandidateBigLabel scale L g), NeZero p.val :=
        fun g p => candidateBigModulusNeZero scale L g p
      ∀ J B m : ℕ,
      letI : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
      ∀ (probes : CandidateBigGroup scale L → Finset (Fin J))
        (r t : Finset (CandidateBigGroup scale L)) (hrt : Disjoint r t),
      (∀ g, (probes g).card ≤ m) →
      ∀ (Q : ℕ) (h ξ : ℝ), 0 < ξ → ∀ k : ℤ, k ≠ 0 → (k.natAbs : ℝ) ≤ L ^ C₂ →
      ∀ Vs : CandidateSmallGroup scale L → ℝ, (∀ g, vs ≤ Vs g) →
      ∀ (V : CandidateBigGroup scale L → ℝ)
        (baseline : ∀ g, CandidateBigLabel scale L g → ℝ) (ρ v vmin vmax : ℝ),
      0 < ρ → ρ < 1 → 1 < v → 0 < vmin →
      (∀ g, vmin ≤ V g) → (∀ g, V g ≤ vmax) →
      (∀ g : CandidateBigGroup scale L, ∑ p ∈ candidatePBand (scale * L) g.val, 1 / (p : ℝ) = V g) →
      (∀ g p, 1 / 2 ≤ baseline g p ∧ baseline g p ≤ 1) →
      ∀ (initial : ∀ g, Finset (CandidateBigLabel scale L g))
        (φ : ∀ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
          ∀ a (s : PhysicalSmallBigState (candidateSmallPool scale L) J ell
            (CleanFullMemoryState (fun g : CandidateBigGroup scale L => candidatePBand (scale * L) g.val) J ell B)),
            PhysicalMixedCoefficientEvent (repeatedBigPrimePatternCut probes r t i) k a s → ℂ),
      (∀ i a s e, ‖φ i a s e‖ ≤ 1) →
      ∀ f : PhysicalSmallBigState (candidateSmallPool scale L) J ell
        (CleanFullMemoryState (fun g : CandidateBigGroup scale L => candidatePBand (scale * L) g.val) J ell B) → ℂ,
      (∀ s, ProductMemorySymmetric (fun x => f (s,x))) →
      let μ := fun g => tiltedPhysicalBirthLaw
        (P := fun g : CandidateBigGroup scale L => candidatePBand (scale * L) g.val) V g (baseline g)
      let W := productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))
      cleanActiveNorm (physicalSmallBigMeasure Vs W)
        (physicalSmallBigJointAverage (physicalMixedPrimePatternAction V baseline ρ Vs q
          probes r t hrt Q h ξ k initial
          (fun i => physicalMixedDirtyPhase (repeatedBigPrimePatternCut probes r t i) k (φ i))
          (physicalSmallBigJointAverage f))) ≤
      repeatedBigFamilyEnvelope (candidateBigPIndices scale L).card m Q ξ *
        (2 * Real.sqrt ((B : ℝ) / (((J + ell).choose ell) ^ (candidateSmallPIndices scale L).card : ℕ)) *
          A ^ (candidateSmallPIndices scale L).card *
          Real.sqrt (unrestrictedEdgeEnergyBound ρ v vmin vmax (ell + m) ^ (candidateBigPIndices scale L).card)) *
        cleanActiveNorm (physicalSmallBigMeasure Vs W) f := by
  obtain ⟨A, hA, hbound⟩ := eventually_candidate_physical_mixed_dirty_projected_norm_le
    hq0 hq1 hvs hscale ell C₂
  refine ⟨A, hA, ?_⟩
  filter_upwards [hbound] with L hL
  let _ : DecidableEq (CandidateSmallGroup scale L) := Classical.decEq _
  let _ : DecidableEq (CandidateBigGroup scale L) := Classical.decEq _
  let _ : ∀ p : PhysicalPrime (candidateSmallPool scale L), NeZero p.2.val := candidateSmallPrimeNeZero scale L
  let _ : ∀ g p, NeZero (candidateBigModulus scale L g p) := candidateBigModulusNeZero scale L
  let _ : ∀ (g : CandidateBigGroup scale L) (p : CandidateBigLabel scale L g), NeZero p.val :=
    fun g p => candidateBigModulusNeZero scale L g p
  intro J B m
  let _ : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
  intro probes r t hrt hp Q h ξ hξ k hk hkbound Vs hVs V baseline ρ v vmin vmax
    hρ0 hρ1 hv hvmin hVlo hVhi hMass hbaseline initial φ hφ f hf μ W
  let P := fun g : CandidateBigGroup scale L => candidatePBand (scale * L) g.val
  have hμ : ∀ g p, 0 ≤ μ g p := fun g p =>
    tiltedPhysicalBirthLaw_nonneg (P := P) V g (baseline g) (hvmin.trans_le (hVlo g)).le
      (fun p => (by norm_num : (0 : ℝ) ≤ 1/2).trans (hbaseline g p).1) p
  have hW : ∀ x, 0 ≤ W x := productMemoryWeight_nonneg μ _ hμ (fun g z => hμ g z.1)
  have hw := physical_small_big_measure_nonneg (P := candidateSmallPool scale L)
    (J := J) (ell := ell) Vs (fun s => hvs.trans_le (hVs s)) W hW
  let cost := 2 * Real.sqrt ((B : ℝ) / (((J + ell).choose ell) ^ (candidateSmallPIndices scale L).card : ℕ)) *
    A ^ (candidateSmallPIndices scale L).card *
    Real.sqrt (unrestrictedEdgeEnergyBound ρ v vmin vmax (ell + m) ^ (candidateBigPIndices scale L).card)
  have hcost : 0 ≤ cost := mul_nonneg
    (mul_nonneg (mul_nonneg (by norm_num) (Real.sqrt_nonneg _)) (pow_nonneg (zero_le_one.trans hA) _))
    (Real.sqrt_nonneg _)
  have hfinal := physical_mixed_prime_dirty_norm_of_rows V baseline ρ Vs q probes r t hrt hp
    Q h ξ hξ k initial φ hφ (physicalSmallBigMeasure Vs W) hw cost hcost f
    (fun C hC Ψ hΨ => hL J B C k hk hkbound Vs hVs V baseline ρ v vmin vmax
      hρ0 hρ1 hv hvmin hVlo hVhi hMass hbaseline (ell+m)
      (fun g => Nat.add_le_add_left (hC g) ell) initial Ψ hΨ f hf)
  simpa only [Fintype.card_coe] using hfinal

end Bounty
end

section

/- The concrete residual physical phase is an active-endpoint observable.
Its two Fourier factors have modulus one, and its auxiliary avoidance gate
can only decrease the norm. The actual injectivity and small-tail endpoint
gates preserve pending symmetry without commuting through slot averages. -/

open Finset Classical
namespace Bounty

section
variable {S G : Type} [Fintype S] [Fintype G] [DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}

omit [DecidableEq G] in
theorem physical_mixed_full_residual_phase_norm_le
    (C : G → Finset (Fin J)) (ζ θ : ℝ) (k : ℤ)
    (sourceGate targetGate : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ)
    (hs : ∀ s, ‖sourceGate s‖ ≤ 1) (ht : ∀ s, ‖targetGate s‖ ≤ 1)
    (a : PhysicalAuxLabels P C)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B))
    (e : PhysicalMixedCoefficientEvent C k a s) :
    ‖physicalMixedFullResidualPhase C ζ θ k sourceGate targetGate a s e‖ ≤ 1 := by
  unfold physicalMixedFullResidualPhase
  dsimp only
  split_ifs
  · have hc : ‖(starRingEnd ℂ) (sourceGate s)‖ ≤ 1 := by
      change ‖star (sourceGate s)‖ ≤ 1
      simpa only [norm_star] using hs s
    simpa only [norm_mul, physical_phase_norm, physicalReturnPhase_norm, mul_one] using
      mul_le_mul hc (ht (physicalMixedCoefficientTarget C k a s e)) (norm_nonneg _) zero_le_one
  · simp only [norm_zero, zero_le_one]

noncomputable def physicalMixedResidualObservable
    (C : G → Finset (Fin J)) (ζ θ : ℝ) (k : ℤ)
    (sourceGate targetGate : PhysicalBareResidueState Ps J ell → (∀ g, Fin (J + ell) → P g) → ℂ)
    (a : PhysicalAuxLabels P C)
    (s t : PhysicalBareResidueState Ps J ell)
    (x y : ∀ g, Fin (J + ell) → P g)
    (_draw : ∀ g, EdgeDrawObservation (P g) (physicalFullSharedIndices (ell := ell) (C g))ᶜ.card) : ℂ :=
  let source := fun g j => x g ((physicalFullSlotIndex (C g)).symm j)
  let target := fun g j => y g ((physicalFullSlotIndex (C g)).symm j)
  let d := physicalSharedPrefix s.2
  let cp := fun g => (activeTupleSplit (physicalFullSharedIndices (ell := ell) (C g)) (x g)).1
  if repeatedBigAuxAvoids C a source ∧ repeatedBigAuxAvoids C a target then
    (starRingEnd ℂ) (sourceGate s x) *
      physicalPhase ζ (physicalMixedSharedD C d cp a) *
      physicalReturnPhase θ (physicalMixedBigStep C k cp a * (physicalSharedProduct d : ℕ)) *
      targetGate t y
  else 0

variable [∀ g (p : P g), NeZero p.val]

omit [DecidableEq G] [∀ g (p : P g), NeZero p.val] in
theorem physical_mixed_full_residual_eq_observable
    (C : G → Finset (Fin J)) (ζ θ : ℝ) (k : ℤ)
    (sourceGate targetGate : PhysicalBareResidueState Ps J ell → (∀ g, Fin (J + ell) → P g) → ℂ)
    (a : PhysicalAuxLabels P C)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B))
    (e : PhysicalMixedCoefficientEvent C k a s) :
    physicalMixedFullResidualPhase C ζ θ k
      (fun z => sourceGate z.1 (fun g => (z.2 g).1))
      (fun z => targetGate z.1 (fun g => (z.2 g).1)) a s e =
      physicalMixedCoefficientObservablePhase C k a
        (physicalMixedResidualObservable C ζ θ k sourceGate targetGate a) s e := rfl

omit [DecidableEq G] in
theorem physical_mixed_concrete_residual_reindex
    (C : G → Finset (Fin J)) (ζ θ : ℝ) (k : ℤ) (Fs : ∀ g, Finset (Ps g))
    (a : PhysicalAuxLabels P C)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B))
    (τ : ∀ g, Equiv.Perm (Fin (s.2 g).2.1.val)) (e : PhysicalMixedCoefficientEvent C k a s) :
    physicalMixedFullResidualPhase C ζ θ k cleanMixedSourceGate (cleanMixedTargetGate Fs) a
      (s.1, productMemoryReindex s.2 τ) (physicalMixedCoefficientReindex C k a s τ e) =
      physicalMixedFullResidualPhase C ζ θ k cleanMixedSourceGate (cleanMixedTargetGate Fs) a s e := by
  let gs := fun (_ : PhysicalBareResidueState Ps J ell) (x : ∀ g, Fin (J + ell) → P g) =>
    (if ∀ g, Function.Injective (x g) then (1 : ℂ) else 0)
  let gt := fun (t : PhysicalBareResidueState Ps J ell) (y : ∀ g, Fin (J + ell) → P g) =>
    (if (∀ g, Function.Injective (y g)) ∧ (∀ g (j : Fin ell), t.2 g (Sum.inr j) ∉ Fs g)
      then (1 : ℂ) else 0)
  have hs : (cleanMixedSourceGate : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ) =
      fun z => gs z.1 (fun g => (z.2 g).1) := by
    funext z
    simp only [cleanMixedSourceGate, CleanMixedBigActiveInjective, gs]
    split_ifs with h
    · exact if_pos h
    · exact if_neg h
  have ht : (cleanMixedTargetGate Fs : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ) =
      fun z => gt z.1 (fun g => (z.2 g).1) := by
    funext z
    simp only [cleanMixedTargetGate, CleanMixedBigActiveInjective, gt]
    split_ifs with h
    · exact if_pos h
    · exact if_neg h
  rw [hs, ht]
  rw [physical_mixed_full_residual_eq_observable, physical_mixed_full_residual_eq_observable]
  exact physical_mixed_coefficient_observable_reindex C k a
    (physicalMixedResidualObservable C ζ θ k gs gt a) s τ e

omit [DecidableEq G] [∀ g (p : P g), NeZero p.val] in
theorem physical_mixed_concrete_residual_norm_le
    (C : G → Finset (Fin J)) (ζ θ : ℝ) (k : ℤ) (Fs : ∀ g, Finset (Ps g))
    (a : PhysicalAuxLabels P C)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B))
    (e : PhysicalMixedCoefficientEvent C k a s) :
    ‖physicalMixedFullResidualPhase C ζ θ k cleanMixedSourceGate (cleanMixedTargetGate Fs) a s e‖ ≤ 1 :=
  physical_mixed_full_residual_phase_norm_le C ζ θ k _ _ clean_mixed_source_gate_norm_le
    (clean_mixed_target_gate_norm_le Fs) a s e

omit [DecidableEq G] [∀ g (p : P g), NeZero p.val] in
theorem physical_mixed_concrete_residual_mul_norm_le
    (C : G → Finset (Fin J)) (ζ θ : ℝ) (k : ℤ) (Fs : ∀ g, Finset (Ps g))
    (a : PhysicalAuxLabels P C)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B))
    (e : PhysicalMixedCoefficientEvent C k a s) (z : ℂ) (hz : ‖z‖ ≤ 1) :
    ‖physicalMixedFullResidualPhase C ζ θ k cleanMixedSourceGate (cleanMixedTargetGate Fs) a s e * z‖ ≤ 1 := by
  rw [norm_mul]
  exact (mul_le_mul (physical_mixed_concrete_residual_norm_le C ζ θ k Fs a s e) hz
    (norm_nonneg z) zero_le_one).trans_eq (one_mul 1)

variable [DecidableEq S]

theorem physical_mixed_concrete_coefficient_projected_memory_symmetric
    (C : G → Finset (Fin J)) (ζ θ : ℝ) (k : ℤ)
    (V : G → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ) (Vs : S → ℝ) (q : ℝ)
    (initial : ∀ g, Finset (P g)) (Fs : ∀ g, Finset (Ps g))
    (f : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ)
    (hf : ∀ s, ProductMemorySymmetric (fun x => f (s,x))) :
    ∀ s, ProductMemorySymmetric (fun x => physicalSmallBigJointAverage
      (physicalMixedCoefficientAction C k V baseline ρ Vs q initial
        (physicalMixedFullResidualPhase C ζ θ k cleanMixedSourceGate (cleanMixedTargetGate Fs))
        (physicalSmallBigJointAverage f)) (s,x)) :=
  physical_small_big_joint_average_memory_symmetric _
    (physical_mixed_coefficient_signed_memory_symmetric C k V baseline ρ Vs q initial _
      (physical_mixed_concrete_residual_reindex C ζ θ k Fs) _
      (physical_small_big_joint_average_memory_symmetric f hf))

theorem physical_mixed_concrete_prime_projected_memory_symmetric
    (V : G → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ) (Vs : S → ℝ) (q : ℝ)
    (probes : G → Finset (Fin J)) (r t : Finset G) (hrt : Disjoint r t)
    (Q : ℕ) (h ξ ζ θ : ℝ) (k : ℤ) (initial : ∀ g, Finset (P g)) (Fs : ∀ g, Finset (Ps g))
    (f : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ)
    (hf : ∀ s, ProductMemorySymmetric (fun x => f (s,x))) :
    ∀ s, ProductMemorySymmetric (fun x => physicalSmallBigJointAverage
      (physicalMixedPrimePatternAction V baseline ρ Vs q probes r t hrt Q h ξ k initial
        (fun i => physicalMixedFullResidualPhase (repeatedBigPrimePatternCut probes r t i) ζ θ k
          cleanMixedSourceGate (cleanMixedTargetGate Fs))
        (physicalSmallBigJointAverage f)) (s,x)) :=
  physical_small_big_joint_average_memory_symmetric _
    (physical_mixed_prime_signed_memory_symmetric V baseline ρ Vs q probes r t hrt Q h ξ k initial _
      (fun i => physical_mixed_concrete_residual_reindex (repeatedBigPrimePatternCut probes r t i) ζ θ k Fs) _
      (physical_small_big_joint_average_memory_symmetric f hf))

theorem physical_mixed_concrete_prime_birth_projected_memory_symmetric
    (V : G → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ) (Vs : S → ℝ) (q : ℝ)
    (probes : G → Finset (Fin J)) (r t : Finset G) (hrt : Disjoint r t)
    (Q : ℕ) (h ξ ζ θ : ℝ) (k : ℤ) (initial : ∀ g, Finset (P g)) (Fs : ∀ g, Finset (Ps g))
    (Φ : ∀ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i) →
      PhysicalBareResidueState Ps J ell → PhysicalBareResidueState Ps J ell →
      (∀ g, Fin (J + ell) → P g) → (∀ g, Fin (J + ell) → P g) →
      (∀ g, EdgeDrawObservation (P g)
        (physicalFullSharedIndices (ell := ell) (repeatedBigPrimePatternCut probes r t i g))ᶜ.card) → ℂ)
    (f : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ)
    (hf : ∀ s, ProductMemorySymmetric (fun x => f (s,x))) :
    ∀ s, ProductMemorySymmetric (fun x => physicalSmallBigJointAverage
      (physicalMixedPrimePatternAction V baseline ρ Vs q probes r t hrt Q h ξ k initial
        (fun i a y e => physicalMixedFullResidualPhase (repeatedBigPrimePatternCut probes r t i) ζ θ k
          cleanMixedSourceGate (cleanMixedTargetGate Fs) a y e *
          physicalMixedCoefficientObservablePhase (repeatedBigPrimePatternCut probes r t i) k a (Φ i a) y e)
        (physicalSmallBigJointAverage f)) (s,x)) := by
  apply physical_small_big_joint_average_memory_symmetric
  apply physical_mixed_prime_signed_memory_symmetric
  · intro i a y σ e
    exact congrArg₂ (fun u v : ℂ => u * v)
      (physical_mixed_concrete_residual_reindex _ ζ θ k Fs a y σ e)
      (physical_mixed_coefficient_observable_reindex _ k a (Φ i a) y σ e)
  · exact physical_small_big_joint_average_memory_symmetric f hf

end
end Bounty
end

section

/- Power truncation of a fixed character slice, with the smooth spatial weight outside. -/

open Finset MeasureTheory Filter
open scoped ComplexConjugate

namespace Bounty

theorem eventually_typeII_smooth_dyadic_character_truncation {K₀ D : ℝ} (hD : 0 ≤ D) :
    ∃ F : ℝ, 0 < F ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (U V E Z : ℝ) (k : ℤ), 0 < U → 0 < V → 0 < Z → k ≠ 0 →
        E = U * L^(-K₀) → 1 ≤ U*V → Z ≤ 24*U^2*V*L^88/E →
      ∀ (M H Zs : Finset ℕ) (α aH : ℕ → ℂ)
        (χ : DirichletCharacter ℂ (2*k.natAbs)),
        (∀ m ∈ M, (m:ℝ) ∈ Set.Icc U (2*U)) →
      Integrable (typeIICrossCharacterFourierIntegrand 1 L U V E Z k M H Zs
        typeIISmoothDyadic α aH χ) ∧
      ‖(∑ y ∈ typeIICrossSlice M H Zs k, (typeIISmoothDyadic ((y.1.2:ℝ)/Z) : ℂ) *
          typeIIRealShiftWeight
            (fun e n => typeIIEMajorant (L^88) (e/E) * typeIINMajorant (n/V)) α aH y *
            χ (y.2.1.1 : ZMod (2*k.natAbs)) * conj (χ (y.2.2.1 : ZMod (2*k.natAbs)))) -
        ∫ ξ in {ξ : EuclideanSpace ℝ (Fin 3) | ‖ξ‖ ≤ L^F},
          typeIICrossCharacterFourierIntegrand 1 L U V E Z k M H Zs
            typeIISmoothDyadic α aH χ ξ‖ ≤
        L^(-D) * ∑ y ∈ typeIICrossSlice M H Zs k,
          ‖(typeIISmoothDyadic ((y.1.2:ℝ)/Z) : ℂ) * typeIICrossCharacterAmplitude χ α aH y‖ := by
  classical
  obtain ⟨F, hF, hfinite⟩ := eventually_finite_typeII_localized_fourier_truncation
    (A := 1) (K₀ := K₀) (by norm_num) hD
  refine ⟨F, hF, ?_⟩
  filter_upwards [hfinite] with L hfinite
  intro U V E Z k hU hV hZ hk hE hUV hZupper M H Zs α aH χ hM
  refine ⟨(typeII_smooth_dyadic_character_cross_fourier_integral
    L U V E Z k M H Zs α aH χ hU hV hZ hk hM).1, ?_⟩
  let ω : TypeIIShiftIndex → ℂ := fun y =>
    (typeIISmoothDyadic ((y.1.2:ℝ)/Z) : ℂ) * typeIICrossCharacterAmplitude χ α aH y
  have hgeometry : ∀ y ∈ typeIICrossSlice M H Zs k, ω y ≠ 0 → y.1.1 = k ∧
      0 < y.2.1.1 ∧ 0 < y.2.2.1 ∧ 0 < y.1.2 ∧
      ∀ i, typeIILogCoordinates ![(y.2.1.1:ℝ),(y.2.2.1:ℝ),(y.1.2:ℝ)] ![U,U,Z] i ∈
        Set.Icc (-1) 1 := by
    intro y hy hω
    have hψ : typeIISmoothDyadic ((y.1.2:ℝ)/Z) ≠ 0 := by
      intro hzero
      apply hω
      simp only [ω, hzero, Complex.ofReal_zero, zero_mul]
    obtain ⟨hks, hpairs⟩ := mem_product.mp (mem_filter.mp hy).1
    obtain ⟨hv, hw⟩ := mem_product.mp hpairs
    have hm := hM _ (mem_product.mp hv).1
    have hm' := hM _ (mem_product.mp hw).1
    have hbox := typeII_smooth_cross_log_box hU hZ hm hm' hψ
    refine ⟨mem_singleton.mp (mem_product.mp hks).1, ?_, ?_, ?_, hbox.2.2⟩
    · exact_mod_cast hU.trans_le hm.1
    · exact_mod_cast hU.trans_le hm'.1
    · exact_mod_cast hbox.1
  have h := hfinite U V E Z k hU hV hZ hk hE hUV hZupper
    (typeIICrossSlice M H Zs k) ω hgeometry
  have hsum :
      (∑ y ∈ typeIICrossSlice M H Zs k, (typeIISmoothDyadic ((y.1.2:ℝ)/Z) : ℂ) *
          typeIIRealShiftWeight
            (fun e n => typeIIEMajorant (L^88) (e/E) * typeIINMajorant (n/V)) α aH y *
            χ (y.2.1.1 : ZMod (2*k.natAbs)) * conj (χ (y.2.2.1 : ZMod (2*k.natAbs)))) =
        ∑ y ∈ typeIICrossSlice M H Zs k,
          ω y * ((typeIIEMajorant (L^88) (typeIIRealE y/E) *
            typeIINMajorant (typeIIRealN y/V) : ℝ):ℂ) := by
    apply sum_congr rfl
    intro y hy
    unfold ω typeIIRealShiftWeight typeIICrossCharacterAmplitude
    ring
  rw [hsum]
  exact h

end Bounty
end

section

/- Absolute character cross-sums retain the two exact factorization masks. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

theorem typeII_cross_character_amplitude_norm_le {d : ℕ}
    (χ : DirichletCharacter ℂ d) (α aH : ℕ → ℂ) (y : TypeIIShiftIndex) :
    ‖typeIICrossCharacterAmplitude χ α aH y‖ ≤
      ‖α y.2.1.1 * aH y.2.2.2‖ * ‖α y.2.2.1 * aH y.2.1.2‖ := by
  unfold typeIICrossCharacterAmplitude
  simp only [norm_mul, Complex.norm_conj]
  calc
    _ ≤ (‖α y.2.1.1‖ * ‖α y.2.2.1‖ * ‖aH y.2.1.2‖ * ‖aH y.2.2.2‖) * 1 * 1 :=
      mul_le_mul (mul_le_mul_of_nonneg_left (χ.norm_le_one _) (by positivity))
        (χ.norm_le_one _) (norm_nonneg _) (by positivity)
    _ = _ := by ring

theorem factorization_absolute_mass_product_eq_cross_sum
    (M H : Finset ℕ) (α aH : ℕ → ℂ) (z w : ℕ) :
    factorizationAbsoluteMass M H α aH z * factorizationAbsoluteMass M H α aH w =
      ∑ m ∈ M, ∑ h' ∈ H, ∑ m' ∈ M, ∑ h ∈ H,
        if m'*h=z ∧ m*h'=w then ‖α m * aH h'‖ * ‖α m' * aH h‖ else 0 := by
  classical
  rw [mul_comm (factorizationAbsoluteMass M H α aH z)]
  simp only [factorizationAbsoluteMass, sum_filter, sum_product]
  simp_rw [sum_mul]
  simp_rw [mul_sum]
  apply sum_congr rfl
  intro m hm
  apply sum_congr rfl
  intro h' hh'
  apply sum_congr rfl
  intro m' hm'
  apply sum_congr rfl
  intro h hh
  by_cases hz : m'*h=z <;> by_cases hw : m*h'=w <;>
    simp only [hz, hw, and_self, and_true, and_false, if_true, if_false,
      mul_zero, zero_mul]

theorem typeII_cross_character_absolute_mass_le
    (M H Zs : Finset ℕ) (k : ℤ) (Z : ℝ) (ψ : ℝ → ℝ) (α aH : ℕ → ℂ)
    (χ : DirichletCharacter ℂ (2*k.natAbs))
    (hM : ∀ m ∈ M, 0 < m) (hk : k ≠ 0)
    (hψ : ∀ z ∈ Zs, |ψ ((z:ℝ)/Z)| ≤ 1)
    (hpos : ∀ z ∈ Zs, 0 < z ∧ 0 < (z:ℤ)+k) :
    (∑ y ∈ typeIICrossSlice M H Zs k,
      ‖(ψ ((y.1.2:ℝ)/Z) : ℂ) * typeIICrossCharacterAmplitude χ α aH y‖) ≤
      ∑ z ∈ Zs, factorizationAbsoluteMass M H α aH z *
        factorizationAbsoluteMass M H α aH ((z:ℤ)+k).toNat := by
  classical
  have hcastif (p : Prop) [Decidable p] (a b : ℝ) :
      ((if p then a else b : ℝ) : ℂ) = if p then (a:ℂ) else (b:ℂ) := by
    split_ifs <;> rfl
  have hreindex :
      (∑ y ∈ typeIICrossSlice M H Zs k,
        ‖(ψ ((y.1.2:ℝ)/Z) : ℂ) * typeIICrossCharacterAmplitude χ α aH y‖) =
      ∑ z ∈ Zs, ∑ m ∈ M, ∑ h' ∈ H, ∑ m' ∈ M, ∑ h ∈ H,
        if m'*h=z ∧ (z:ℤ)+k=(m:ℤ)*h' then
          ‖(ψ ((z:ℝ)/Z) : ℂ) * typeIICrossCharacterAmplitude χ α aH
            ((k,z),((m,h),(m',h')))‖ else 0 := by
    apply Complex.ofReal_injective
    simp only [Complex.ofReal_sum, hcastif, Complex.ofReal_zero]
    exact typeII_cross_slice_sum_reindex M H Zs k
      (fun y => (‖(ψ ((y.1.2:ℝ)/Z) : ℂ) * typeIICrossCharacterAmplitude χ α aH y‖ : ℂ)) hM hk
  rw [hreindex]
  apply sum_le_sum
  intro z hz
  rw [factorization_absolute_mass_product_eq_cross_sum]
  apply sum_le_sum
  intro m hm
  apply sum_le_sum
  intro h' hh'
  apply sum_le_sum
  intro m' hm'
  apply sum_le_sum
  intro h hh
  have hcross : ((z:ℤ)+k=(m:ℤ)*h') ↔ m*h'=((z:ℤ)+k).toNat := by
    have hcast : (((z:ℤ)+k).toNat : ℤ) = (z:ℤ)+k :=
      Int.toNat_of_nonneg (hpos z hz).2.le
    constructor
    · intro heq
      have hh : (((z:ℤ)+k).toNat : ℤ) = ((m*h' : ℕ):ℤ) := by
        simpa only [Int.natCast_mul] using hcast.trans heq
      exact (Int.ofNat_inj.mp hh).symm
    · intro heq
      have hh := congrArg (fun n : ℕ => (n:ℤ)) heq
      simpa only [Int.natCast_mul, hcast] using hh.symm
  simp only [hcross]
  split_ifs
  · rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
    calc
      _ ≤ 1 * ‖typeIICrossCharacterAmplitude χ α aH ((k,z),((m,h),(m',h')))‖ :=
        mul_le_mul_of_nonneg_right (hψ z hz) (norm_nonneg _)
      _ ≤ _ := by
        simpa only [one_mul] using
          typeII_cross_character_amplitude_norm_le χ α aH ((k,z),((m,h),(m',h')))
  · exact le_rfl


end Bounty
end

section

/- Exact removal of inactive spatial indices, preserving both factorization masks. -/

open Finset MeasureTheory

namespace Bounty

noncomputable def typeIIActiveCrossZ (Z : ℝ) (k : ℤ) (Zs : Finset ℕ) : Finset ℕ := by
  classical
  exact Zs.filter (fun z => 0 < z ∧ 0 < (z:ℤ)+k ∧ (z:ℝ) ≤ 2*Z)

theorem typeII_smooth_cross_sum_active_support
    (M H Zs : Finset ℕ) (k : ℤ) (Z : ℝ) (F : TypeIIShiftIndex → ℂ)
    (hZ : 0 < Z) (hH : ∀ h ∈ H, 0 < h) :
    (∑ y ∈ typeIICrossSlice M H Zs k,
      (typeIISmoothDyadic ((y.1.2:ℝ)/Z):ℂ) * F y) =
    ∑ y ∈ typeIICrossSlice M H (typeIIActiveCrossZ Z k Zs) k,
      (typeIISmoothDyadic ((y.1.2:ℝ)/Z):ℂ) * F y := by
  classical
  have hsub : typeIICrossSlice M H (typeIIActiveCrossZ Z k Zs) k ⊆
      typeIICrossSlice M H Zs k := by
    intro y hy
    obtain ⟨hprod, hc⟩ := mem_filter.mp hy
    obtain ⟨hks, hpairs⟩ := mem_product.mp hprod
    obtain ⟨hk, hz⟩ := mem_product.mp hks
    exact mem_filter.mpr ⟨mem_product.mpr ⟨mem_product.mpr
      ⟨hk, (mem_filter.mp hz).1⟩, hpairs⟩, hc⟩
  symm
  apply sum_subset hsub
  intro y hy hnot
  by_cases hψ : typeIISmoothDyadic ((y.1.2:ℝ)/Z) = 0
  · simp [hψ]
  exfalso
  apply hnot
  obtain ⟨hprod, hc⟩ := mem_filter.mp hy
  obtain ⟨hks, hpairs⟩ := mem_product.mp hprod
  obtain ⟨hyk, hyz⟩ := mem_product.mp hks
  obtain ⟨hleft, hright⟩ := mem_product.mp hpairs
  have hkp : y.1.1 = k := mem_singleton.mp hyk
  have hψs := typeII_smooth_dyadic_support hψ
  have hz0 : 0 < y.1.2 := by
    have hh := (lt_div_iff₀ hZ).mp hψs.1
    have hzR : (0:ℝ) < (y.1.2:ℝ) := by linarith
    exact_mod_cast hzR
  have hzupper : (y.1.2:ℝ) ≤ 2*Z := ((div_lt_iff₀ hZ).mp hψs.2).le
  have hw0 : 0 < (y.1.2:ℤ)+k := by
    obtain ⟨hm, _, _, hcross⟩ := hc
    rw [hkp] at hcross
    rw [hcross]
    apply mul_pos
    · exact_mod_cast hm
    · exact_mod_cast hH _ (mem_product.mp hright).2
  exact mem_filter.mpr ⟨mem_product.mpr ⟨mem_product.mpr
    ⟨hyk, mem_filter.mpr ⟨hyz, hz0, hw0, hzupper⟩⟩, hpairs⟩, hc⟩

theorem typeII_smooth_cross_fourier_active_support
    (A L U V E Z : ℝ) (k : ℤ) (M H Zs : Finset ℕ) (α aH : ℕ → ℂ)
    (χ : DirichletCharacter ℂ (2*k.natAbs))
    (hZ : 0 < Z) (hH : ∀ h ∈ H, 0 < h) (ξ : EuclideanSpace ℝ (Fin 3)) :
    typeIICrossCharacterFourierIntegrand A L U V E Z k M H Zs typeIISmoothDyadic α aH χ ξ =
      typeIICrossCharacterFourierIntegrand A L U V E Z k M H
        (typeIIActiveCrossZ Z k Zs) typeIISmoothDyadic α aH χ ξ := by
  unfold typeIICrossCharacterFourierIntegrand typeIIFiniteCrossFourierIntegrand
  simp only [mul_assoc]
  rw [typeII_smooth_cross_sum_active_support M H Zs k Z
    (fun y => typeIICrossCharacterAmplitude χ α aH y * typeIICrossFourierPowers y ξ) hZ hH]

end Bounty
end

section

/- Exact smooth spatial partition of every actual majorant character slice. -/

open Finset MeasureTheory
open scoped ComplexConjugate

namespace Bounty

noncomputable def typeIISmoothDyadicCount (L : ℝ) : ℕ :=
  ⌈Real.logb 2 (192 * L^88)⌉₊ + 1

noncomputable def typeIISmoothDyadicScale (U V E : ℝ) (j : ℕ) : ℝ :=
  U^2 * V / (16*E) * 2^j

theorem typeII_smooth_dyadic_scale_pos {U V E : ℝ}
    (hU : 0 < U) (hV : 0 < V) (hE : 0 < E) (j : ℕ) :
    0 < typeIISmoothDyadicScale U V E j := by
  unfold typeIISmoothDyadicScale
  positivity

theorem typeII_majorant_character_dyadic_partition
    (L U V E : ℝ) (k : ℤ) (M H Zs : Finset ℕ) (α aH : ℕ → ℂ)
    (χ : DirichletCharacter ℂ (2*k.natAbs))
    (hL : 0 < L) (hU : 0 < U) (hV : 0 < V) (hE : 0 < E)
    (hUV : 4 ≤ U*V) (hM : ∀ m ∈ M, (m:ℝ) ∈ Set.Icc U (2*U)) :
    (∑ y ∈ typeIICrossSlice M H Zs k,
      typeIIRealShiftWeight
        (fun e n => typeIIEMajorant (L^88) (e/E) * typeIINMajorant (n/V)) α aH y *
        χ (y.2.1.1 : ZMod (2*k.natAbs)) * conj (χ (y.2.2.1 : ZMod (2*k.natAbs)))) =
    ∑ j ∈ range (typeIISmoothDyadicCount L),
      ∑ y ∈ typeIICrossSlice M H Zs k,
        (typeIISmoothDyadic ((y.1.2:ℝ)/typeIISmoothDyadicScale U V E j) : ℂ) *
          typeIIRealShiftWeight
            (fun e n => typeIIEMajorant (L^88) (e/E) * typeIINMajorant (n/V)) α aH y *
            χ (y.2.1.1 : ZMod (2*k.natAbs)) * conj (χ (y.2.2.1 : ZMod (2*k.natAbs))) := by
  classical
  rw [sum_comm]
  apply sum_congr rfl
  intro y hy
  by_cases hη : typeIIEMajorant (L^88) (typeIIRealE y/E) *
      typeIINMajorant (typeIIRealN y/V) = 0
  · simp [typeIIRealShiftWeight, hη]
  obtain ⟨hprod, hc⟩ := mem_filter.mp hy
  obtain ⟨_, hpairs⟩ := mem_product.mp hprod
  obtain ⟨hv, hw⟩ := mem_product.mp hpairs
  have hp := typeII_majorant_smooth_partition hL hU hV hE hUV hc.2.1
    (hM _ (mem_product.mp hv).1) (hM _ (mem_product.mp hw).1) hc.2.2.1 hη
  have hpc : (∑ j ∈ range (typeIISmoothDyadicCount L),
      (typeIISmoothDyadic ((y.1.2:ℝ)/typeIISmoothDyadicScale U V E j) : ℂ)) = 1 := by
    rw [← Complex.ofReal_sum]
    simpa only [typeIISmoothDyadicCount, typeIISmoothDyadicScale, Complex.ofReal_one] using
      congrArg (fun x : ℝ => (x:ℂ)) hp
  simp only [← sum_mul, hpc, one_mul]

theorem typeII_majorant_character_dyadic_fourier
    (L U V E : ℝ) (k : ℤ) (M H Zs : Finset ℕ) (α aH : ℕ → ℂ)
    (χ : DirichletCharacter ℂ (2*k.natAbs))
    (hL : 0 < L) (hU : 0 < U) (hV : 0 < V) (hE : 0 < E)
    (hUV : 4 ≤ U*V) (hk : k ≠ 0)
    (hM : ∀ m ∈ M, (m:ℝ) ∈ Set.Icc U (2*U)) :
    (∑ y ∈ typeIICrossSlice M H Zs k,
      typeIIRealShiftWeight
        (fun e n => typeIIEMajorant (L^88) (e/E) * typeIINMajorant (n/V)) α aH y *
        χ (y.2.1.1 : ZMod (2*k.natAbs)) * conj (χ (y.2.2.1 : ZMod (2*k.natAbs)))) =
    ∑ j ∈ range (typeIISmoothDyadicCount L),
      ∫ ξ : EuclideanSpace ℝ (Fin 3),
        typeIICrossCharacterFourierIntegrand 1 L U V E (typeIISmoothDyadicScale U V E j) k
          M H Zs typeIISmoothDyadic α aH χ ξ := by
  rw [typeII_majorant_character_dyadic_partition L U V E k M H Zs α aH χ hL hU hV hE hUV hM]
  apply sum_congr rfl
  intro j hj
  exact (typeII_smooth_dyadic_character_cross_fourier_integral L U V E
    (typeIISmoothDyadicScale U V E j) k M H Zs α aH χ hU hV
    (typeII_smooth_dyadic_scale_pos hU hV hE j) hk hM).2

end Bounty
end

section

/- Actual B0 coefficients have polynomial bounds before choosing the allocation gap. -/

open Finset Filter

namespace Bounty

theorem candidate_remaining_coefficient_zero (c L : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) :
    candidateRemainingComplexCoefficient c L r jStar take twist 0 = 0 := by
  classical
  unfold candidateRemainingComplexCoefficient
  apply div_eq_zero_iff.mpr
  left
  unfold orderedSlotComplexWeight
  apply sum_eq_zero
  intro x hx
  have hn : orderedSlotProduct
      (fun slot : CandidateRemainingSlot c L r take => candidateQSlotChoices c L r jStar slot.val) x ≠ 0 := by
    apply prod_ne_zero_iff.mpr
    intro slot hslot
    exact candidate_Q_slot_nonzero c L r jStar slot.val (x slot).property
  simp only [hn, if_false]

theorem candidate_retained_coefficient_zero (c L q : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) :
    candidateRetainedComplexCoefficient c L q r jStar take twist 0 = 0 := by
  simp only [candidateRetainedComplexCoefficient, primePoolFreePart, Nat.zero_div,
    candidate_remaining_coefficient_zero, mul_zero]

theorem candidate_B0_retained_eq_phase (c L q : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (ν : ℝ) :
    candidateB0RetainedCoefficient c L q r jStar take twist ν =
      fun h => typeIIPhase (2*Real.pi*ν) h * candidateRetainedComplexCoefficient c L q r jStar take twist h := by
  funext h
  by_cases hh : h = 0
  · subst h
    simp [candidateB0RetainedCoefficient, candidate_retained_coefficient_zero]
  · rw [candidateB0RetainedCoefficient, typeIIPhase_eq_cpow _ (Nat.pos_of_ne_zero hh)]
    exact mul_comm _ _

theorem exists_candidate_B0_polynomial_bounds {c : ℝ} (hc : 0 < c) {r : ℕ} (hr : 6 ≤ r) :
    ∃ aE aH : ℝ, 0 ≤ aE ∧ 0 ≤ aH ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (jStar : ℕ) (hj : jStar ∈ candidateQIndices c L)
        (take : Fin ((candidateQIndices c L).card*r) → Bool),
      take ((candidateAllocationOrder c L r).symm
        (candidateRoughSlot c L r jStar (by omega) hj)) = false →
      ∀ (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ) (ν : ℝ),
      (∀ e : ℕ, 0 < e → ‖candidateB0TakenCoefficient c L r jStar take
        (candidateAllocationFourierTwist c L r jStar take ξ) ν e‖ ≤ L^aE) ∧
      (∀ h : ℕ, 0 < h → ‖candidateB0RetainedCoefficient c L (1/2) r jStar take
        (candidateAllocationFourierTwist c L r jStar take ξ) ν h‖ ≤ L^aH*(h.divisors.card:ℝ)) := by
  have hr0 : 0 < r := by omega
  obtain ⟨aE, haE, htake⟩ := exists_candidate_separated_coefficients_polynomial_bound hc hr0
  obtain ⟨aH, haH, hret⟩ := exists_candidate_retained_divisor_bound
    (q := (1/2:ℝ)) hc (by norm_num) (by norm_num)
  refine ⟨aE, aH, haE, haH, ?_⟩
  filter_upwards [htake, hret] with L htake hret
  intro jStar hj take hkeep ξ ν
  have htwist : ∀ slot p, p ∈ candidateQSlotChoices c L r jStar slot →
      ‖candidateAllocationFourierTwist c L r jStar take ξ slot p‖ ≤ 1 := by
    intro slot p hp
    exact (candidate_allocation_fourier_twist_norm c L r jStar take ξ slot
      (Nat.pos_of_ne_zero (candidate_Q_slot_nonzero c L r jStar slot hp))).le
  constructor
  · intro e he
    rw [(candidate_B0_coefficient_norms c L (1/2) r jStar take _ ν he).1]
    exact (htake jStar hj take hkeep _ htwist).1 e
  · intro h hh
    rw [(candidate_B0_coefficient_norms c L (1/2) r jStar take _ ν hh).2]
    exact hret r jStar hr0 hj take hkeep _ htwist h hh.ne'

end Bounty
end

section

/- Exact original event rows with the chronological owner indicator. -/

open Finset Classical

namespace Bounty

section Rows
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
    [∀ g, DecidableEq (P g)] {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ v : ℝ) (V : Fin N → ℝ)
    (steps : List (Option (J ⊕ K))) (u : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P))
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))

theorem full_mixed_common_ghost_original_stage_le (j : J) (htag : steps.get u = some (.inl j))
    (η : Fin N → ℝ) (hη : ∀ g, 0 ≤ η g) (hμ : ∀ g p, 0 ≤ μ g p)
    (hμatom : ∀ g p, μ g p ≤ η g) (hv : 0 < v)
    (hq0 : 0 ≤ q j) (hq1 : q j ≤ 1) (hρ : 0 < ρ)
    (hD : q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1) :
    let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
    (∑ e : FullPermutationMixedEvent n S B A Δ D (some (.inl j)) s,
      |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V (some (.inl j)) s e| *
        fullMixedCommonForestHistoryGain n S B A Δ D steps code u.val (some (.inl j)) s e history *
        productLengthLyapunov v (fullPermutationMixedEventTarget n S B A Δ D (some (.inl j)) s e)) ≤
    (∏ g, ((|(1 - q j) * V g / ρ| * η g) * v) ^ fullMixedCommonSelectedCount M B steps code u g) *
      (∏ g, Real.exp ((|(1 - q j) * V g / ρ| * ∑ p, μ g p) * v)) * productLengthLyapunov v s := by
  refine le_trans (le_of_eq (full_mixed_common_ghost_stage_reindex n S B A Δ D ω μ q ρ v V steps u s history code j htag)) ?_
  exact full_mixed_common_ghost_all_skeletons_stage_le n S B A Δ D steps u j htag s history code μ (q j) ρ v V η
    hη hμ hμatom hv hq0 hq1 hρ hD

theorem full_mixed_common_edge_original_stage_le (k : K) (htag : steps.get u = some (.inr k))
    (η : Fin N → ℝ) (hη : ∀ g, 0 ≤ η g) (hμ : ∀ g p, 0 ≤ μ g p)
    (hμatom : ∀ g p, μ g p ≤ η g) (hv : 1 < v)
    (hω : ∀ c a, 0 ≤ ω k c a) (hωmass : ∀ c, ∑ a, ω k c a ≤ 1)
    (vmin : ℝ) (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hvmin : 0 < vmin) (hV : ∀ g, vmin ≤ V g)
    (hmass : ∀ g, ∑ p, μ g p ≤ 2) (T : ℕ) (ht : ∀ g, (S k g)ᶜ.card ≤ T) :
    let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
    (∑ e : FullPermutationMixedEvent n S B A Δ D (some (.inr k)) s,
      |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V (some (.inr k)) s e| *
        fullMixedCommonForestHistoryGain n S B A Δ D steps code u.val (some (.inr k)) s e history *
        productLengthLyapunov v (fullPermutationMixedEventTarget n S B A Δ D (some (.inr k)) s e)) ≤
    (∏ g, η g ^ fullMixedCommonSelectedCount M B steps code u g) * productLengthLyapunov v s *
      unrestrictedEdgeRowBound ρ v vmin T ^ N := by
  refine le_trans (le_of_eq (full_mixed_common_edge_stage_reindex n S B A Δ D ω μ q ρ v V steps u s history code k htag)) ?_
  exact full_mixed_common_edge_all_skeletons_stage_le n S B A Δ D steps u k htag s history code (ω k) μ ρ v vmin V η
    hη hμ hμatom hv hω hωmass hρ0 hρ1 hvmin hV hmass T ht

end Rows
end Bounty
end

section

/- Restrict the B0 hypothesis to the actual allocation frequency box. -/

open Finset MeasureTheory Real

namespace Bounty

theorem active_allocation_box_ae_support {N : ℕ} (active : Fin N → Bool) (R : ℝ) :
    ∀ᵐ ξ ∂activeAllocationBoxMeasure active R, ∀ i, ‖ξ i‖ ≤ R := by
  unfold activeAllocationBoxMeasure
  exact Filter.eventually_all.2 (fun i =>
    (Measure.tendsto_eval_ae_ae
      (μ := fun _ : ActiveAllocationIndex active =>
        volume.restrict {x : ℝ | ‖x‖ ≤ R}) (i := i)).eventually
      (ae_restrict_mem ((isClosed_le continuous_norm continuous_const).measurableSet)))

theorem candidate_finite_mixed_mellin_norm_le_box_variation
    (c L q : ℝ) (r jStar : ℕ) (E B R : ℝ) (S : Finset ℕ)
    (F : ℕ → ℕ → ℂ) (T : ℝ) {Q : ℝ} (_hQ : 0 ≤ Q)
    (hbound : ∀ ν : ℝ, ‖ν‖ ≤ T →
      ∀ take : Fin ((candidateQIndices c L).card*r) → Bool,
        (∀ i, candidateAllocationActive c L r jStar i = false → take i = false) →
      ∀ ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ,
        (∀ i, ‖ξ i‖ ≤ L) →
        ‖candidateRetainedAllocationIntegrand c L q r jStar (log E)
          (candidateSmallPSet c L (R*exp L+1)) take
          (candidateFiniteCoarseMellinTest L E S ν F) ξ‖ ≤
        Q*‖activeAllocationFourierWeight (candidateAllocationRadius r)
          (candidateAllocationActive c L r jStar) take ξ‖) :
    ‖∫ ν in {ν : ℝ | ‖ν‖ ≤ T},
      candidateFiniteMixedMellinIntegrand c L q r jStar E B R S F ν‖ ≤
      Q*candidateMixedFourierVariation c L r jStar B L T := by
  classical
  let patterns := (univ : Finset (Fin ((candidateQIndices c L).card*r) → Bool)).filter
    (fun take => ∀ i, candidateAllocationActive c L r jStar i = false → take i = false)
  let C : ℝ := ∑ take ∈ patterns,
    ∫ ξ, ‖activeAllocationFourierWeight (candidateAllocationRadius r)
      (candidateAllocationActive c L r jStar) take ξ‖
      ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) L
  have hinner (ν : ℝ) (hν : ‖ν‖ ≤ T) (take : Fin ((candidateQIndices c L).card*r) → Bool)
      (htake : take ∈ patterns) :
      ‖∫ ξ, candidateRetainedAllocationIntegrand c L q r jStar (log E)
          (candidateSmallPSet c L (R*exp L+1)) take
          (candidateFiniteCoarseMellinTest L E S ν F) ξ
          ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) L‖ ≤
        Q * ∫ ξ, ‖activeAllocationFourierWeight (candidateAllocationRadius r)
          (candidateAllocationActive c L r jStar) take ξ‖
          ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) L := by
    calc
      _ ≤ ∫ ξ, Q*‖activeAllocationFourierWeight (candidateAllocationRadius r)
          (candidateAllocationActive c L r jStar) take ξ‖
          ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) L :=
        norm_integral_le_of_norm_le
          ((active_allocation_box_weight_integrable (candidateAllocationRadius r) L
            (candidateAllocationActive c L r jStar) take).norm.const_mul Q)
          (by
            filter_upwards [active_allocation_box_ae_support
              (candidateAllocationActive c L r jStar) L] with ξ hξ
            exact hbound ν hν take (mem_filter.mp htake).2 ξ hξ)
      _ = _ := integral_const_mul Q _
  have hsum (ν : ℝ) (hν : ‖ν‖ ≤ T) :
      ‖∑ take ∈ patterns, ∫ ξ,
        candidateRetainedAllocationIntegrand c L q r jStar (log E)
          (candidateSmallPSet c L (R*exp L+1)) take
          (candidateFiniteCoarseMellinTest L E S ν F) ξ
          ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) L‖ ≤ Q*C := by
    calc
      _ ≤ ∑ take ∈ patterns, ‖∫ ξ,
          candidateRetainedAllocationIntegrand c L q r jStar (log E)
            (candidateSmallPSet c L (R*exp L+1)) take
            (candidateFiniteCoarseMellinTest L E S ν F) ξ
            ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) L‖ :=
        norm_sum_le _ _
      _ ≤ ∑ take ∈ patterns, Q * ∫ ξ,
          ‖activeAllocationFourierWeight (candidateAllocationRadius r)
            (candidateAllocationActive c L r jStar) take ξ‖
          ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) L :=
        sum_le_sum (fun take htake => hinner ν hν take htake)
      _ = Q*C := (mul_sum ..).symm
  have hphase (ν : ℝ) :
      ‖(exp L : ℂ)^(-((2*Real.pi*ν : ℝ) : ℂ)*Complex.I)‖ = 1 := by
    rw [Complex.norm_cpow_eq_rpow_re_of_pos (exp_pos L)]
    simp
  have hT : MeasurableSet {ν : ℝ | ‖ν‖ ≤ T} :=
    (isClosed_le continuous_norm continuous_const).measurableSet
  have hdom : ∀ᵐ ν ∂volume.restrict {ν : ℝ | ‖ν‖ ≤ T},
      ‖candidateFiniteMixedMellinIntegrand c L q r jStar E B R S F ν‖ ≤
        ‖typeIIWindowFourier (L^B) ν‖*(Q*C) := by
    filter_upwards [ae_restrict_mem hT] with ν hν
    unfold candidateFiniteMixedMellinIntegrand
    rw [norm_mul, norm_mul, hphase, one_mul]
    exact mul_le_mul_of_nonneg_left (hsum ν hν) (norm_nonneg _)
  calc
    _ ≤ ∫ ν in {ν : ℝ | ‖ν‖ ≤ T}, ‖typeIIWindowFourier (L^B) ν‖*(Q*C) :=
      norm_integral_le_of_norm_le
        (((typeII_window_fourier_integrable (L^B)).norm).mul_const (Q*C)).integrableOn hdom
    _ = (∫ ν in {ν : ℝ | ‖ν‖ ≤ T}, ‖typeIIWindowFourier (L^B) ν‖)*(Q*C) :=
      integral_mul_const _ _
    _ = Q*candidateMixedFourierVariation c L r jStar B L T := by
      dsimp only [candidateMixedFourierVariation, C, patterns]
      ring


end Bounty
end

section

/- The selected edge displacement splits across precisely the original groups. -/

open scoped Classical
namespace Bounty

theorem physical_selected_group_D_split
    {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell n : ℕ}
    (small : G → Prop) (C : Fin n → G → Finset (Fin J))
    (d : PhysicalGroupSelectedData P ell C) (j : Fin n) :
    physicalD (C j) (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc)) (d.1 j) =
      physicalD (fun g : {g // small g} => C j g.val)
        (physicalPermuteLabels ((physicalGroupSelectedSplit small C d).1.2.2.1 j)
          ((physicalGroupSelectedSplit small C d).1.2.1 j.castSucc))
        ((physicalGroupSelectedSplit small C d).1.1 j) *
      physicalD (fun g : {g // ¬small g} => C j g.val)
        (physicalPermuteLabels ((physicalGroupSelectedSplit small C d).2.2.2.1 j)
          ((physicalGroupSelectedSplit small C d).2.2.1 j.castSucc))
        ((physicalGroupSelectedSplit small C d).2.1 j) := by
  simpa only [physical_group_selected_split_small, physical_group_selected_split_big,
    ← physical_permute_group_restrict] using
    (physical_D_group_split small (C j) (d.1 j)
      (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc)))

theorem physical_selected_group_inverse_D
    {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell n : ℕ}
    (small : G → Prop) (C : Fin n → G → Finset (Fin J))
    (ds : PhysicalGroupSelectedData (fun g : {g // small g} => P g.val) ell (fun j g => C j g.val))
    (db : PhysicalGroupSelectedData (fun g : {g // ¬small g} => P g.val) ell (fun j g => C j g.val))
    (j : Fin n) :
    let d := (physicalGroupSelectedSplit small C).symm (ds, db)
    physicalD (C j) (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc)) (d.1 j) =
      physicalD (fun g : {g // small g} => C j g.val)
        (physicalPermuteLabels (ds.2.2.1 j) (ds.2.1 j.castSucc)) (ds.1 j) *
      physicalD (fun g : {g // ¬small g} => C j g.val)
        (physicalPermuteLabels (db.2.2.1 j) (db.2.1 j.castSucc)) (db.1 j) := by
  have h := physical_selected_group_D_split small C
    ((physicalGroupSelectedSplit small C).symm (ds, db)) j
  rw [Equiv.apply_symm_apply] at h
  exact h

theorem physical_selected_group_reindexed_D
    {G : Type*} [Fintype G] {M J ell n : ℕ} (e : G ≃ Fin M) (P : G → Finset ℕ)
    (C : Fin n → G → Finset (Fin J)) (d : PhysicalGroupSelectedData P ell C) (j : Fin n) :
    let dn := physicalSelectedGroupReindex e P C d
    physicalD (fun h => C j (e.symm h))
      (physicalPermuteLabels (dn.2.2.1 j) (dn.2.1 j.castSucc)) (dn.1 j) =
    physicalD (C j) (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc)) (d.1 j) := by
  exact physical_D_group_reindex e (C j) (d.1 j)
    (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc))

end Bounty
end

section

/- The proved all-character rough-band theorem discharges the high-frequency
premise of the actual four-factor integral estimate. -/

open Filter Finset Set MeasureTheory

namespace Bounty

theorem exists_long_rough_four_factor_integral_decay
    {a beta c d Bcoeff A As H Cmean Cres kmean kres q t aLong : ℝ}
    (ha : 0 < a) (ha1 : a ≤ 1) (hbeta : beta < 1) (hc : 0 ≤ c) (hd : 0 < d)
    (hBcoeff : 1 ≤ Bcoeff) (hAs0 : 0 ≤ As) (haLong : 0 < aLong)
    (hAs : A + (Cmean + 2 + 2 * kmean) + 1 ≤ 2 * As)
    (hH : A + 2 + (Cres + 2 + 2 * kres) + 1 ≤ 2 * H) (Tmod Sshift : ℝ) :
    ∃ B0 : ℝ, 0 < B0 ∧ ∀ Bsave : ℝ,
      A + B0 + 2 + 2 * q + 2 * t + 1 ≤ 2 * Bsave →
    ∀ᶠ L : ℝ in atTop, ∀ (s : Finset ℕ), (∀ p ∈ s, Nat.Prime p) →
      ∀ (coeff : s → ℂ) (Y P R : ℝ),
      1 ≤ Y → d * L ≤ Real.log Y → Real.log Y ≤ c * L →
      Real.exp (L ^ a) / 2 ≤ P → P ≤ Real.exp (L ^ beta) →
      0 ≤ R → R ≤ Y → R ≤ Real.exp L →
      (∀ p ∈ s, P ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2 * P) →
      (∀ p : s, ‖coeff p‖ ≤ Bcoeff) →
      ∀ (Q M T : ℝ → ℂ), Continuous M → Continuous T →
      ∀ (Ylong Alo Blo σ : ℝ) (r : ℕ) [NeZero r] (χ : DirichletCharacter ℂ r),
      Real.exp (aLong * L) ≤ Ylong → Ylong ≤ Alo → Alo ≤ Blo → Blo ≤ 2 * Ylong →
      (r : ℝ) ≤ L ^ Tmod → |σ| ≤ L ^ Sshift →
      (∀ u, Q u = ∑ i ∈ roughBand Alo Blo (Real.exp (Real.sqrt L)),
        harmonicMellinWeight (u + σ) i * χ (i : ZMod r)) →
      (∀ u ∈ Set.Icc (-R) R, ‖Q u‖ ≤ L ^ q) →
      (∀ u ∈ Set.Icc (-R) R, ‖T u‖ ≤ L ^ t) →
      (∀ u ∈ Set.Icc (-R) R, |u| ≤ L ^ B0 → ‖M u‖ ≤ L ^ (-Bsave)) →
      ∀ (Km Kr : ℕ) (lom him : Fin Km → ℕ) (lor hir : Fin Kr → ℕ)
        (wm : Fin Km → ℕ → ℂ) (wr : Fin Kr → ℕ → ℂ)
        (Um : Fin Km → ℝ) (Ur : Fin Kr → ℝ),
      (Km : ℝ) ≤ L ^ kmean → (Kr : ℝ) ≤ L ^ kres →
      (∀ j, 1 ≤ Um j ∧ R ≤ Um j ∧ Real.log (Um j) ≤ c * L ∧
        Um j ≤ (lom j : ℝ) ∧ (him j : ℝ) ≤ 2 * Um j ∧
        (∑ n ∈ Finset.Icc (lom j) (him j), ‖wm j n‖ ^ 2) ≤ L ^ Cmean / Um j) →
      (∀ j, Y ^ (3 / 5 : ℝ) ≤ Ur j ∧ Ur j ≤ (lor j : ℝ) ∧
        (hir j : ℝ) ≤ 2 * Ur j ∧
        (∑ n ∈ Finset.Icc (lor j) (hir j), ‖wr j n‖ ^ 2) ≤ L ^ Cres / Ur j) →
      (∀ u, Q u * M u * T u = ∑ j : Fin Km, ∑ n ∈ Finset.Icc (lom j) (him j),
        wm j n * Complex.exp ((Real.log (n : ℝ) * u : ℝ) * Complex.I)) →
      (∀ u, M u * T u = ∑ j : Fin Kr, ∑ n ∈ Finset.Icc (lor j) (hir j),
        wr j n * Complex.exp ((Real.log (n : ℝ) * u : ℝ) * Complex.I)) →
      (∫ u in Set.Icc (-R) R, ‖primeReciprocalPolynomial s coeff u * Q u * M u * T u‖ ^ 2)
        ≤ L ^ (-A) := by
  obtain ⟨B0, hB0, hhigh⟩ := eventually_long_roughBand_shifted_power_bound haLong Tmod Sshift H
  refine ⟨B0, hB0, ?_⟩
  intro Bsave hBsave
  filter_upwards [hhigh, eventually_prime_four_factor_integral_decay
    ha ha1 hbeta hc hd hBcoeff hAs0 hAs hH hBsave] with L hrough hmain
  intro s hs coeff Y P R hY hloglo hloghi hPlo hPhi hR hRY hRexp hband hcoeff
    Q M T hM hT Ylong Alo Blo σ r hr χ hYlong hAlo hAB hBlo hmod hσ hQeq
    hQbound hTbound hlow Km Kr lom him lor hir wm wr Um Ur hKm hKr hmdata hrdata hmrep hrrep
  have hQ : Continuous Q := by
    have hh : Continuous (fun u => ∑ i ∈ roughBand Alo Blo (Real.exp (Real.sqrt L)),
        harmonicMellinWeight (u + σ) i * χ (i : ZMod r)) := by
      unfold harmonicMellinWeight
      fun_prop
    exact hh.congr (fun u => (hQeq u).symm)
  apply hmain s hs coeff Y P R hY hloglo hloghi hPlo hPhi hR hRY hband hcoeff
    Q M T hQ hM hT hQbound hTbound _ hlow Km Kr lom him lor hir wm wr Um Ur
    hKm hKr hmdata hrdata hmrep hrrep
  intro u hu hlarge
  rw [hQeq u]
  exact hrough Ylong hYlong r χ hmod u σ hlarge.le ((abs_le.mpr hu).trans hRexp)
    hσ Alo Blo hAlo hAB hBlo

end Bounty
end

section

/- The original spatial test vanishes on every newly added sufficiently large P factor. -/

open Finset

namespace Bounty

theorem candidate_box_finite_test_large_P (L E X : ℝ) (S : Finset ℕ) (G : ℕ → ℂ)
    (hS : ∀ u ∈ S, (u : ℝ) ≤ X) (e p n : ℕ) (he : 0 < e) (hn : 0 < n)
    (hp : X < (p : ℝ)) : candidateBoxFiniteTest L E S G e (p*n) = 0 := by
  have hmul : p ≤ e*(p*n) := by
    calc
      p = p*1 := by ring
      _ ≤ p*(e*n) := Nat.mul_le_mul_left p (Nat.mul_pos he hn)
      _ = _ := by ring
  have hnot : e*(p*n) ∉ S := by
    intro hm
    have hbound := hS _ hm
    have hmR : (p : ℝ) ≤ (e*(p*n) : ℕ) := by exact_mod_cast hmul
    linarith
  unfold candidateBoxFiniteTest
  exact if_neg (fun h => hnot h.2)

theorem candidate_separated_finite_test_large_P (c L : ℝ) (r jStar : ℕ) (R E X : ℝ)
    (S : Finset ℕ) (G : ℕ → ℂ) (hS : ∀ u ∈ S, (u : ℝ) ≤ X)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) (p : ℕ) (hp : X < (p : ℝ))
    (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ) :
    candidateSeparatedAllocationIntegrand c L r jStar R take
      (fun e n => candidateBoxFiniteTest L E S G e (p*n)) ξ = 0 := by
  classical
  unfold candidateSeparatedAllocationIntegrand
  have hz : (∑ e ∈ orderedSlotProductSupport
      (fun slot : CandidateTakenSlot c L r take => candidateQSlotChoices c L r jStar slot.val),
      ∑ n ∈ orderedSlotProductSupport
        (fun slot : CandidateRemainingSlot c L r take => candidateQSlotChoices c L r jStar slot.val),
      candidateTakenComplexCoefficient c L r jStar take
        (candidateAllocationFourierTwist c L r jStar take ξ) e *
      candidateRemainingComplexCoefficient c L r jStar take
        (candidateAllocationFourierTwist c L r jStar take ξ) n *
      candidateBoxFiniteTest L E S G e (p*n)) = 0 := by
    apply sum_eq_zero
    intro e he
    apply sum_eq_zero
    intro n hn
    have hepos := candidate_taken_product_support_pos c L r jStar take he
    have hnpos : 0 < n := by
      obtain ⟨x,hx,rfl⟩ := mem_image.mp hn
      apply Nat.pos_of_ne_zero
      exact prod_ne_zero_iff.mpr (fun slot _ =>
        candidate_Q_slot_nonzero c L r jStar slot.val (x slot).property)
    rw [candidate_box_finite_test_large_P L E X S G hS e p n hepos hnpos hp,mul_zero]
  rw [hz,mul_zero,zero_mul]

end Bounty
end

section

/- High-frequency cancellation with the actual allocation twist and two character factors. -/

open Finset Filter

namespace Bounty

theorem eventually_allocation_rough_product_character_decay {c a : ℝ}
    (hc : 0 < c) (ha : 0 < a) (r : ℕ) (T1 T2 F G Bsave : ℝ) :
    ∃ B0 : ℝ, 0 < B0 ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (jStar : ℕ) (take : Fin ((candidateQIndices c L).card*r) → Bool)
        (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ),
      (∀ i, |ξ i| ≤ L^F) →
      ∀ (slot : (candidateQIndices c L) × Fin r) (Y : ℝ), Real.exp (a*L) ≤ Y →
      ∀ (q m : ℕ) [NeZero q] [NeZero m]
        (χ : DirichletCharacter ℂ q) (ψ : DirichletCharacter ℂ m),
      (q : ℝ) ≤ L^T1 → (m : ℝ) ≤ L^T2 →
      ∀ u ν : ℝ, L^B0 ≤ |u| → |u| ≤ Real.exp L → |ν| ≤ L^G →
      ∀ A B : ℝ, Y ≤ A → A ≤ B → B ≤ 2*Y →
        ‖∑ n ∈ roughBand A B (Real.exp (Real.sqrt L)),
          harmonicMellinWeight (u+ν) n*candidateAllocationFourierTwist c L r jStar take ξ slot n*
            χ (n : ZMod q)*ψ (n : ZMod m)‖ ≤ L^(-Bsave) := by
  obtain ⟨B0,hB0,hhigh⟩ := eventually_long_roughBand_shifted_power_bound ha
    (T1+T2) (max G (F+1)+1) Bsave
  refine ⟨B0,hB0,?_⟩
  filter_upwards [hhigh,eventually_candidate_allocation_frequency_power_bound hc r F,
    eventually_add_frequency_power_bound G (F+1),eventually_gt_atTop (0 : ℝ)]
    with L hh hfreq hadd hL
  intro jStar take ξ hξ slot Y hY q m hqInst hmInst χ ψ hq hm u ν hu huX hν A B hYA hAB hBY
  let σ := orderedSlotFrequency (fun i => if take i then 1 else 0)
    (activeAllocationFrequencyInput (candidateAllocationActive c L r jStar)
      (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val) ξ)
    ((candidateAllocationOrder c L r).symm slot)
  have hσ : |σ| ≤ L^(F+1) := hfreq jStar take ξ hξ slot
  have hsum := hh Y hY (q*m)
    (χ.changeLevel (Nat.dvd_mul_right q m)*ψ.changeLevel (Nat.dvd_mul_left m q))
    (product_modulus_power_bound hL hq hm) u (ν+σ) hu huX (hadd ν σ hν hσ) A B hYA hAB hBY
  have heq : (∑ n ∈ roughBand A B (Real.exp (Real.sqrt L)),
      harmonicMellinWeight (u+ν) n*candidateAllocationFourierTwist c L r jStar take ξ slot n*
        χ (n : ZMod q)*ψ (n : ZMod m)) =
      ∑ n ∈ roughBand A B (Real.exp (Real.sqrt L)),
        harmonicMellinWeight (u+(ν+σ)) n*
          (χ.changeLevel (Nat.dvd_mul_right q m)*ψ.changeLevel (Nat.dvd_mul_left m q))
            (n : ZMod (q*m)) := by
    apply sum_congr rfl
    intro n hn
    rw [candidate_allocation_twist_mellin_shift c L r jStar take ξ slot (u+ν) (roughBand_pos hn),
      product_level_characters_nat_apply]
    simp only [σ,add_assoc,mul_assoc]
  rw [heq]
  exact hsum

end Bounty
