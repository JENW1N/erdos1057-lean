/- Repeated physical labels agree with the canonical source extraction and
with reassembly from any reduced target. These identities do not require
clean or supported events and therefore include invalid-target fallbacks. -/

open Finset
open scoped Classical

namespace Bounty

section

variable {G : Type} {P : G → Finset ℕ} {J ell B : ℕ}

theorem physical_mixed_repeated_labels_canonical
    (C : G → Finset (Fin J)) (x : CleanFullMemoryState P J ell B) :
    (cleanFullMemoryEquiv P J ell B
      ((fullActivePermutation (cleanPhysicalSlotChange C)).symm x)).2.2.1 =
      physicalMixedRepeatedLabels C x := by
  funext g j
  change (x g).1 ((physicalFullSlotIndex (C g)).symm
    (finSumFinEquiv.symm (finSumFinEquiv j))) = _
  rw [Equiv.symm_apply_apply]
  rfl

theorem physical_mixed_repeated_labels_reassemble
    (C : G → Finset (Fin J)) (x : CleanFullMemoryState P J ell B)
    (y : ProductBoundedOrderedState (fun g => ↥(P g))
      (fun g => UnrestrictedResidueParticle (fun p : P g => p.val))
      (fun g => (physicalFullSharedIndices (ell := ell) (C g))ᶜ.card) B) :
    physicalMixedRepeatedLabels C
      ((productActiveMemorySplit (fun g => physicalFullSharedIndices (ell := ell) (C g)) B).symm
        ((productActiveMemorySplit (fun g => physicalFullSharedIndices (ell := ell) (C g)) B x).1, y)) =
      repeatedBigFill C (physicalMixedRepeatedLabels C x)
        (cleanFullFreshEquiv P C (physicalCleanFreshEquiv (fun g => ↥(P g)) C
          (fun g => (y g).1))) := by
  let z := (fullActivePermutation (cleanPhysicalSlotChange C)).symm x
  let N := fun g => (y g).2.1
  let p := fun g j => ((y g).2.2 j).1
  let r := fun g j => ((y g).2.2 j).2
  let source := (cleanFullMemoryEquiv P J ell B z).2.2.1
  let fresh := physicalCleanFreshEquiv (fun g => ↥(P g)) C (fun g => (y g).1)
  have hs : (productActiveMemorySplit (cleanFullSharedSlots C) B
      (cleanFullMemoryState N p source r)).1 =
      (productActiveMemorySplit (cleanFullSharedSlots C) B z).1 := by
    funext g i
    change (z g).1 (finSumFinEquiv (finSumFinEquiv.symm _)) = _
    rw [Equiv.apply_symm_apply]
    rfl
  have hc := cleanFullMemoryState_reassemble_fill C N p source r fresh
  rw [hs] at hc
  have hp := physical_clean_reassemble_fresh C z (fun g => (y g).2) (fun g => (y g).1)
  have hz : fullActivePermutation (cleanPhysicalSlotChange C) z = x :=
    Equiv.apply_symm_apply _ _
  rw [hz] at hp
  change _ = fullActivePermutation (cleanPhysicalSlotChange C)
    ((productActiveMemorySplit (cleanFullSharedSlots C) B).symm
      ((productActiveMemorySplit (cleanFullSharedSlots C) B z).1,
        fun g => (fresh g, (⟨N g, fun j => ⟨p g j, r g j⟩⟩ :
          BoundedOrderedTuple (UnrestrictedResidueParticle (fun p : P g => p.val)) B)))) at hp
  rw [hc] at hp
  rw [hp, clean_full_memory_physical_encoding]
  have hsource : source = physicalMixedRepeatedLabels C x :=
    physical_mixed_repeated_labels_canonical C x
  rw [hsource]
  funext g j
  change repeatedBigFill C (physicalMixedRepeatedLabels C x)
    (cleanFullFreshEquiv P C fresh) g
    (physicalFullSlotIndex (C g) ((physicalFullSlotIndex (C g)).symm j)) = _
  rw [Equiv.apply_symm_apply]

end

theorem physical_mixed_repeated_labels_event_target
    {S G : Type} [Fintype S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    (C : G → Finset (Fin J)) (k : ℤ) (a : PhysicalAuxLabels P C)
    (d : PhysicalSharedLists Ps J) (x : CleanFullMemoryState P J ell B)
    (e : PhysicalSmallBigFullEvent (fun g (p : P g) => p.val)
      (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
      (fun d c => physicalMixedEdgeDelta C k d c a)
      (fun d c => physicalMixedEdgeD C d c a) d x) :
    physicalMixedRepeatedLabels C
      (physicalSmallBigFullTarget (fun g (p : P g) => p.val)
        (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
        (fun d c => physicalMixedEdgeDelta C k d c a)
        (fun d c => physicalMixedEdgeD C d c a) d x e) =
      repeatedBigFill C (physicalMixedRepeatedLabels C x)
        (cleanFullFreshEquiv P C (physicalCleanFreshEquiv (fun g => ↥(P g)) C (fun g =>
          (unrestrictedJointEventTarget (fun g (p : P g) => p.val)
            (physicalMixedEdgeDelta C k d
              (productActiveMemorySplit (fun g => physicalFullSharedIndices (ell := ell) (C g)) B x).1 a)
            (physicalMixedEdgeD C d
              (productActiveMemorySplit (fun g => physicalFullSharedIndices (ell := ell) (C g)) B x).1 a)
            (fun g => (physicalFullSharedIndices (ell := ell) (C g))ᶜ.card) B
            (productActiveMemorySplit (fun g => physicalFullSharedIndices (ell := ell) (C g)) B x).2
            e.2 g).1))) :=
  physical_mixed_repeated_labels_reassemble C x _

theorem physical_mixed_clean_prefix_phase_eq_labels
    {S G : Type} [Fintype S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    (C : G → Finset (Fin J)) (ζ θ : ℝ) (k : ℤ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (a : PhysicalAuxLabels P C) (d : PhysicalSharedLists Ps J)
    (x : CleanFullMemoryState P J ell B) (r : PhysicalResidues Ps)
    (e : PhysicalSmallBigFullEvent (fun g (p : P g) => p.val)
      (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
      (fun d c => physicalMixedEdgeDelta C k d c a)
      (fun d c => physicalMixedEdgeD C d c a) d x) :
    let source := physicalMixedRepeatedLabels C x
    let target := physicalMixedRepeatedLabels C
      (physicalSmallBigFullTarget (fun g (p : P g) => p.val)
        (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
        (fun d c => physicalMixedEdgeDelta C k d c a)
        (fun d c => physicalMixedEdgeD C d c a) d x e)
    let cp := (productActiveMemorySplit (fun g => physicalFullSharedIndices (ell := ell) (C g)) B x).1
    physicalMixedCleanPrefixPhase C ζ θ k K a d x r e =
      if repeatedBigAuxAvoids C a source ∧ repeatedBigAuxAvoids C a target then
        K source target a * physicalPhase ζ (physicalMixedSharedD C d cp a) *
          physicalReturnPhase θ (physicalMixedBigStep C k cp a * (physicalSharedProduct d : ℕ))
      else 0 := by
  dsimp only
  unfold physicalMixedCleanPrefixPhase
  rw [physical_mixed_repeated_labels_canonical]
  dsimp only
  rw [← physical_mixed_repeated_labels_event_target C k a d x e]

end Bounty
end

