/- Coherent continuation substitution for the original simultaneous rows. -/

namespace Bounty

theorem global_birth_joint_cut_raw_row_congr
    {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)] [∀ g, DecidableEq (P g)]
    {R : (g : Fin N) → P g → Type*} [∀ g p, AddGroup (R g p)]
    [∀ g p, Fintype (R g p)] [∀ g p, DecidableEq (R g p)]
    {a b : (g : Fin N) → P g → Bool}
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (inputCap outputCap : ℕ)
    (F G : GlobalBirthJointState R → ℂ)
    (hFG : ∀ s, GlobalBirthJointCoherent b s → F s = G s)
    (s : GlobalBirthJointState R) (hs : GlobalBirthJointCoherent a s) :
    globalBirthJointCutRawRow step inputCap outputCap F s =
      globalBirthJointCutRawRow step inputCap outputCap G s := by
  unfold globalBirthJointCutRawRow globalBirthJointRawCutoff
  split_ifs
  · unfold globalBirthJointRawRow
    apply fin_tensor_row_intertwines_on N _ _ (fun _ x => x) (fun _ x => x)
      (fun g t => GlobalBirthMemoryCoherent (ghostPhaseActivitySupport (a g)) t.1 t.2)
      (fun g t => GlobalBirthMemoryCoherent (ghostPhaseActivitySupport (b g)) t.1 t.2)
    · intro g t ht K L hKL
      exact global_birth_raw_step_row_congr (step g) t.1 t.2 ht _ _
        (fun H q hq _ => hKL (H, q) hq)
    · intro t ht
      unfold globalBirthJointRawCutoff
      split_ifs
      · exact hFG t ht
      · rfl
    · exact hs
  · rfl

end Bounty
end

