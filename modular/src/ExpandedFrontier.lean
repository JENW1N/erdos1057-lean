/- The actual fixed-forest operation multiplier as a function of its local birth labels. -/

open Finset Classical
namespace Bounty
section Local
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
    (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
    (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K)))

noncomputable def fullMixedLocalIndexedLabels (i : Fin steps.length)
    (labels : FullMixedLocalBirthAddress S B (steps.get i) → Option ((g : Fin N) × P g))
    (j : Fin (Fintype.card (FullMixedBirthAddress S B steps))) : Option ((g : Fin N) × P g) :=
  if h : (fullMixedBirthOrder S B steps j).1 = i then
    labels (h ▸ (fullMixedBirthOrder S B steps j).2) else none

noncomputable def fullMixedLocalForestFactor
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))
    (θ : (Fin (Fintype.card (FullMixedBirthAddress S B steps)) ×
      Fin (Fintype.card (FullMixedBirthAddress S B steps))) → ℝ)
    (encode : ((g : Fin N) × P g) → ℤ) (i : Fin steps.length)
    (labels : FullMixedLocalBirthAddress S B (steps.get i) → Option ((g : Fin N) × P g)) : ℂ :=
  birthForestOperationMultiplier code (fullMixedIndexedBirthOwner S B steps) θ
    (fun j => (fullMixedLocalIndexedLabels S B steps i labels j).isSome = true)
    (fun j => ((fullMixedLocalIndexedLabels S B steps i labels j).map encode).getD 0) i

theorem full_mixed_local_forest_factor_eq
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))
    (θ : (Fin (Fintype.card (FullMixedBirthAddress S B steps)) ×
      Fin (Fintype.card (FullMixedBirthAddress S B steps))) → ℝ)
    (encode : ((g : Fin N) × P g) → ℤ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x) (i : Fin steps.length) :
    let e := finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x p i
    fullMixedLocalForestFactor S B steps code θ encode i
      (fullMixedEventBirthLabel n S B A Δ D (steps.get i) e.1 e.2) =
      fullMixedBirthOperationMultiplier n S B A Δ D steps code θ encode x p i := by
  dsimp only
  unfold fullMixedLocalForestFactor fullMixedBirthOperationMultiplier
  apply birth_forest_operation_multiplier_congr_on_owner
  · intro j hj
    change (fullMixedBirthOrder S B steps j).1 = i at hj
    subst i
    unfold fullMixedLocalIndexedLabels fullMixedIndexedBirthPerformed
    rw [dif_pos rfl, full_mixed_path_birth_performed_iff_label_present]
    rfl
  · intro j hj
    change (fullMixedBirthOrder S B steps j).1 = i at hj
    subst i
    unfold fullMixedLocalIndexedLabels fullMixedIndexedBirthValue
    rw [dif_pos rfl]
    rfl

end Local
end Bounty
