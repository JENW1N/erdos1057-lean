      (weights : G → ℝ) (I : Type) (patterns : Finset I)
      (slots : I → G → Finset (Fin J)) (bounds : I → ℝ)
      (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
      (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (slots i) → ℂ)
      (r N : ℕ) (z : ℤ),
      r + 1 = 2 * Nat.ceil (T^a) →
      Pairwise (fun g h => Disjoint (P g) (P h)) →
      (∀ g p, p ∈ P g → p.Prime) →
      (Fintype.card G : ℝ) ≤ C * Real.log T →
      (∀ g, v ≤ weights g) →
      (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = weights g) →
      (∀ g, weights g ≤ V) →
      (∀ g p, p ∈ P g → Real.exp (T^c) ≤ (p : ℝ)) →
      (∀ g p, p ∈ P g → (p : ℝ) ≤ Real.exp (T^d)) →
      (∀ i ∈ patterns, ∀ g, (slots i g).card ≤ m) →
      (∀ i ∈ patterns, 0 ≤ bounds i) → (∑ i ∈ patterns, bounds i) ≤ T^B →
      (∀ j i, i ∈ patterns → ∀ L R aux, ‖K j i L R aux‖ ≤ bounds i) →
      0 < N → γ * T ≤ Real.log (N : ℝ) →
      ‖physicalCanonicalRootMoment weights patterns slots q ζ k K (Ico z (z + N)) r -
        physicalRootResidueModel weights patterns slots q ζ k K r‖ ≤
        Real.exp (-E * (r + 1) * Real.log T)  := by
  filter_upwards [eventually_physical_root_replacement ha hc hd had hC hV hv hE hγ hB hq0 hq1 J ell m]
    with T hreplace
  intro G _ _ P _ weights I patterns slots bounds ζ k K r N z hlen hP hprime hs hlow
    hMass hupper hmin hmax hslots hbounds hsum hK hN hNb
  exact hreplace G P weights I patterns slots bounds ζ k K r
    (physicalTimeStepBound P J ell patterns slots k (r + 1)) N z
    hlen hP hprime hs hlow hMass hupper hmin hmax hslots hbounds hsum hK
    (fun _ hj => physical_operator_step_bound_le_time P J ell patterns slots k hj) hN hNb
end

section
open Finset
open scoped BigOperators Classical
/-- In a finite set of primes, prime divisibility detects membership. -/
theorem prime_dvd_finset_prod_iff_mem (s : Finset ℕ)
    (hs : ∀ q ∈ s, Nat.Prime q) {p : ℕ} (hp : Nat.Prime p) :
    p ∣ ∏ q ∈ s, q ↔ p ∈ s := by
  constructor
  · intro hd
    obtain ⟨q, hq, hpq⟩ := (hp.prime.dvd_finsetProd_iff _).mp hd
    have he : p = q := ((Nat.dvd_prime (hs q hq)).mp hpq).resolve_left hp.ne_one
    exact he ▸ hq
  · intro hp
    exact dvd_prod_of_mem (fun q => q) hp

/-- A finite set of distinct primes is determined by its product. -/
theorem prime_finset_prod_eq_iff {s t : Finset ℕ}
    (hs : ∀ p ∈ s, Nat.Prime p) (ht : ∀ p ∈ t, Nat.Prime p) :
    (∏ p ∈ s, p) = (∏ p ∈ t, p) ↔ s = t := by
  constructor
  · intro he
    ext p
    constructor
    · intro hp
      have hd := (prime_dvd_finset_prod_iff_mem s hs (hs p hp)).mpr hp
      rw [he] at hd
      exact (prime_dvd_finset_prod_iff_mem t ht (hs p hp)).mp hd
    · intro hp
      have hd := (prime_dvd_finset_prod_iff_mem t ht (ht p hp)).mpr hp
      rw [← he] at hd
      exact (prime_dvd_finset_prod_iff_mem s hs (ht p hp)).mp hd
  · rintro rfl
    rfl

/-- Products are injective on all subsets of a fixed finite prime pool. -/
theorem prime_subset_prod_injective (S : Finset ℕ)
    (hS : ∀ p ∈ S, Nat.Prime p) :
    Set.InjOn (fun s : Finset ℕ => ∏ p ∈ s, p) {s | s ⊆ S} := by
  intro s hs t ht he
  exact (prime_finset_prod_eq_iff (fun p hp => hS p (hs hp))
    (fun p hp => hS p (ht hp))).mp he

/-- In disjoint prime groups, divisibility of the full product detects
membership in the unique group containing the prime. -/
theorem grouped_prime_dvd_prod_iff_mem {G : Type*} [Fintype G]
    (S : G → Finset ℕ) (hS : ∀ g p, p ∈ S g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (S g) (S h)))
    (A : G → Finset ℕ) (hA : ∀ g, A g ⊆ S g)
    (g : G) {p : ℕ} (hp : p ∈ S g) :
    p ∣ (∏ h, ∏ q ∈ A h, q) ↔ p ∈ A g := by
  constructor
  · intro hd
    obtain ⟨h, _, hdh⟩ := ((hS g p hp).prime.dvd_finsetProd_iff _).mp hd
    have hmem : p ∈ A h :=
      (prime_dvd_finset_prod_iff_mem (A h) (fun q hq => hS h q (hA h hq))
        (hS g p hp)).mp hdh
    have hgh : g = h := by
      by_contra hne
      exact (disjoint_left.mp (hdis hne)) hp (hA h hmem)
    subst h
    exact hmem
  · intro hpA
    exact dvd_trans (dvd_prod_of_mem (fun q => q) hpA)
      (dvd_prod_of_mem (fun h => ∏ q ∈ A h, q) (mem_univ g))

/-- The product over disjoint prime groups determines every chosen subset. -/
theorem grouped_prime_subset_prod_eq_iff {G : Type*} [Fintype G]
    (S : G → Finset ℕ) (hS : ∀ g p, p ∈ S g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (S g) (S h)))
    {A B : G → Finset ℕ} (hA : ∀ g, A g ⊆ S g) (hB : ∀ g, B g ⊆ S g) :
    (∏ g, ∏ p ∈ A g, p) = (∏ g, ∏ p ∈ B g, p) ↔ A = B := by
  constructor
  · intro he
    funext g
    ext p
    constructor
    · intro hp
      have hd := (grouped_prime_dvd_prod_iff_mem S hS hdis A hA g (hA g hp)).mpr hp
      rw [he] at hd
      exact (grouped_prime_dvd_prod_iff_mem S hS hdis B hB g (hA g hp)).mp hd
    · intro hp
      have hd := (grouped_prime_dvd_prod_iff_mem S hS hdis B hB g (hB g hp)).mpr hp
      rw [← he] at hd
      exact (grouped_prime_dvd_prod_iff_mem S hS hdis A hA g (hB g hp)).mp hd
  · rintro rfl
    rfl

/-- An omission choice selects an `ell`-element subset from every group. -/
abbrev PrimeOmissionChoices {G : Type*} (S : G → Finset ℕ) (ell : ℕ) :=
  ∀ g, ↥((S g).powersetCard ell)

/-- The positive integer formed by all omitted labels. -/
noncomputable def primeOmissionProduct {G : Type*} [Fintype G]
    (S : G → Finset ℕ) (ell : ℕ) (A : PrimeOmissionChoices S ell) : ℕ :=
  ∏ g, ∏ p ∈ (A g).val, p

/-- The independent groupwise choices have exactly the binomial product
cardinality, including the case where no omission choice exists. -/
theorem prime_omission_choices_card {G : Type*} [Fintype G]
    (S : G → Finset ℕ) (ell : ℕ) :
    Fintype.card (PrimeOmissionChoices S ell) = ∏ g, (S g).card.choose ell := by
  simp only [PrimeOmissionChoices, Fintype.card_pi, Fintype.card_coe, card_powersetCard]

/-- Every omission product is positive, including the empty product. -/
theorem prime_omission_product_pos {G : Type*} [Fintype G]
    (S : G → Finset ℕ) (ell : ℕ) (hS : ∀ g p, p ∈ S g → Nat.Prime p)
    (A : PrimeOmissionChoices S ell) : 0 < primeOmissionProduct S ell A := by
  apply prod_pos
  intro g _
  apply prod_pos
  intro p hp
  exact (hS g p ((mem_powersetCard.mp (A g).property).1 hp)).pos

/-- Distinct tuples of omitted subsets give distinct natural products. -/
theorem prime_omission_product_injective {G : Type*} [Fintype G]
    (S : G → Finset ℕ) (ell : ℕ) (hS : ∀ g p, p ∈ S g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (S g) (S h))) :
    Function.Injective (primeOmissionProduct S ell) := by
  intro A B he
  have hAB : (fun g => (A g).val) = (fun g => (B g).val) :=
    (grouped_prime_subset_prod_eq_iff S hS hdis
      (fun g => (mem_powersetCard.mp (A g).property).1)
      (fun g => (mem_powersetCard.mp (B g).property).1)).mp he
  funext g
  exact Subtype.ext (congrFun hAB g)

/-- Casting omission products to integers preserves their injectivity. -/
theorem prime_omission_int_product_injective {G : Type*} [Fintype G]
    (S : G → Finset ℕ) (ell : ℕ) (hS : ∀ g p, p ∈ S g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (S g) (S h))) :
    Function.Injective (fun A : PrimeOmissionChoices S ell =>
      (primeOmissionProduct S ell A : ℤ)) := by
  intro A B he
  exact prime_omission_product_injective S ell hS hdis (Int.natCast_inj.mp he)

/-- Natural numbers strictly below a modulus have distinct residue casts. -/
theorem natCast_zmod_inj_of_lt {p a b : ℕ} (ha : a < p) (hb : b < p)
    (he : (a : ZMod p) = (b : ZMod p)) : a = b := by
  have hv := congrArg ZMod.val he
  simpa only [ZMod.val_natCast_of_lt ha, ZMod.val_natCast_of_lt hb] using hv

/-- Distinct omission choices remain distinct modulo `p` if every product
is less than `p`. Primality of the modulus is not needed for this step. -/
theorem prime_omission_zmod_product_injective {G : Type*} [Fintype G]
    (S : G → Finset ℕ) (ell : ℕ) (hS : ∀ g p, p ∈ S g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (S g) (S h))) (p : ℕ)
    (hbound : ∀ A : PrimeOmissionChoices S ell, primeOmissionProduct S ell A < p) :
    Function.Injective (fun A : PrimeOmissionChoices S ell =>
      (primeOmissionProduct S ell A : ZMod p)) := by
  intro A B he
  exact prime_omission_product_injective S ell hS hdis
    (natCast_zmod_inj_of_lt (hbound A) (hbound B) he)

/-- The number of distinct natural omission products is exactly the
number of omission choices. -/
theorem prime_omission_products_card {G : Type*} [Fintype G]
    (S : G → Finset ℕ) (ell : ℕ) (hS : ∀ g p, p ∈ S g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (S g) (S h))) :
    (univ.image (primeOmissionProduct S ell)).card = ∏ g, (S g).card.choose ell := by
  rw [card_image_of_injective _ (prime_omission_product_injective S ell hS hdis), card_univ]
  exact prime_omission_choices_card S ell

/-- The bounded residue products also have exactly the binomial product
cardinality. -/
theorem prime_omission_zmod_products_card {G : Type*} [Fintype G]
    (S : G → Finset ℕ) (ell : ℕ) (hS : ∀ g p, p ∈ S g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (S g) (S h))) (p : ℕ)
    (hbound : ∀ A : PrimeOmissionChoices S ell, primeOmissionProduct S ell A < p) :
    (univ.image (fun A : PrimeOmissionChoices S ell =>
      (primeOmissionProduct S ell A : ZMod p))).card = ∏ g, (S g).card.choose ell := by
  rw [card_image_of_injective _ (prime_omission_zmod_product_injective S ell hS hdis p hbound),
    card_univ]
  exact prime_omission_choices_card S ell
end

section
open Finset
/-- A nonzero multiple of the inverse distinguishes all elements of a
field, including zero under the totalized inverse convention. -/
theorem reciprocal_affine_injective {K : Type*} [Field K] (r a : K) (ha : a ≠ 0) :
    Function.Injective (fun u : K => r + a / u) := by
  intro u v huv
  apply inv_injective
  apply mul_left_cancel₀ ha
  exact add_left_cancel (by simpa only [div_eq_mul_inv] using huv)

/-- If omission products are distinct in the residue field, a particle's
promotion congruence can hold for at most one choice. -/
theorem omission_congruence_unique {Ω K : Type*} [Field K]
    (U : Ω → K) (hU : Function.Injective U) (r a : K) (ha : a ≠ 0)
    {c d : Ω} (hc : r + a / U c = 0) (hd : r + a / U d = 0) : c = d :=
  hU (reciprocal_affine_injective r a ha (hc.trans hd.symm))

/-- Casts of distinct small natural omission products remain distinct. -/
theorem omission_natCast_injective {Ω : Type*} (p : ℕ) (U : Ω → ℕ)
    (hU : Function.Injective U) (hlt : ∀ c, U c < p) :
    Function.Injective (fun c => (U c : ZMod p)) := by
  intro c d he
  apply hU
  have h := (ZMod.natCast_eq_natCast_iff' (U c) (U d) p).mp he
  simpa only [Nat.mod_eq_of_lt (hlt c), Nat.mod_eq_of_lt (hlt d)] using h

/-- An omission is rare when at least one pending particle admits it. -/
noncomputable def rareOmissionChoices {Ω Particle : Type*}
    (choices : Finset Ω) (pending : Finset Particle) (allows : Particle → Ω → Prop) : Finset Ω := by
  classical
  exact choices.filter (fun c => ∃ z ∈ pending, allows z c)

/-- The union of at most one admissible omission per pending particle has
cardinality at most the number of pending particles. -/
theorem rare_omission_choices_card_le {Ω Particle : Type*}
    (choices : Finset Ω) (pending : Finset Particle) (allows : Particle → Ω → Prop)
    (hunique : ∀ z ∈ pending, ∀ c ∈ choices, ∀ d ∈ choices,
      allows z c → allows z d → c = d) :
    (rareOmissionChoices choices pending allows).card ≤ pending.card := by
  classical
  have he : rareOmissionChoices choices pending allows =
      pending.biUnion (fun z => choices.filter (allows z)) := by
    ext c
    simp only [rareOmissionChoices, mem_filter, mem_biUnion]
    aesop
  rw [he]
  calc
    _ ≤ ∑ z ∈ pending, (choices.filter (allows z)).card := card_biUnion_le
    _ ≤ ∑ _z ∈ pending, 1 := by
      apply sum_le_sum
      intro z hz
      apply card_le_one.mpr
      intro c hc d hd
      exact hunique z hz c (mem_filter.mp hc).1 d (mem_filter.mp hd).1
        (mem_filter.mp hc).2 (mem_filter.mp hd).2
    _ = pending.card := by simp

/-- The fraction of uniformly sampled omissions permitting a transfer is
bounded by the pending-particle budget divided by the number of choices. -/
theorem rare_omission_fraction_le {Ω Particle : Type*}
    (choices : Finset Ω) (pending : Finset Particle) (allows : Particle → Ω → Prop)
    (hunique : ∀ z ∈ pending, ∀ c ∈ choices, ∀ d ∈ choices,
      allows z c → allows z d → c = d) {B : ℕ} (hB : pending.card ≤ B) :
    ((rareOmissionChoices choices pending allows).card : ℝ) / choices.card ≤
      (B : ℝ) / choices.card := by
  apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg _)
  exact_mod_cast (rare_omission_choices_card_le choices pending allows hunique).trans hB

/-- The promotion congruence after solving the exact product factorization
of the full and omitted small-prime labels. -/
theorem omission_quotient_congruence {K : Type*} [Field K]
    (r a F U D : K) (hU : U ≠ 0) (hfactor : U * D = F) :
    (r + a * D = 0) ↔ r + (a * F) / U = 0 := by
  have hD : D = F / U := by
    apply (eq_div_iff hU).mpr
    simpa only [mul_comm] using hfactor
  rw [hD, mul_div_assoc]

/-- An equivalent uniqueness argument works directly with complementary
products. Eligibility supplies nonvanishing of the dilation, so no global
assumption about the full product is needed. -/
theorem complementary_omission_unique {Ω K : Type*} [Field K]
    (U D : Ω → K) (hU : Function.Injective U) (F r k : K) (hk : k ≠ 0)
    (hfactor : ∀ c, U c * D c = F) {c d : Ω}
    (hDc : D c ≠ 0) (hc : r + k * D c = 0) (hd : r + k * D d = 0) : c = d := by
  have hD : D c = D d := mul_left_cancel₀ hk (add_left_cancel (hc.trans hd.symm))
  apply hU
  apply mul_right_cancel₀ hDc
  calc
    U c * D c = F := hfactor c
    _ = U d * D d := (hfactor d).symm
    _ = U d * D c := by rw [hD]

/-- A modular version of the actual eligible-promotion test. The fixed
product relation may include the already conditioned big-prime factor. -/
theorem modular_complementary_omission_unique {Ω : Type*} {p : ℕ}
    (hp : p.Prime) (U D : Ω → ℕ) (hU : Function.Injective U)
    (hlt : ∀ c, U c < p) (F : ℕ) (hfactor : ∀ c, U c * D c = F)
    (r : ZMod p) (k : ℤ) (hk : ¬ (p : ℤ) ∣ k) {c d : Ω}
    (hDc : ¬ p ∣ D c)
    (hc : r + (k : ZMod p) * (D c : ZMod p) = 0)
    (hd : r + (k : ZMod p) * (D d : ZMod p) = 0) : c = d := by
  have : Fact p.Prime := ⟨hp⟩
  apply complementary_omission_unique
    (fun c => (U c : ZMod p)) (fun c => (D c : ZMod p))
    (omission_natCast_injective p U hU hlt) (F : ZMod p) r (k : ZMod p)
    ((ZMod.intCast_zmod_eq_zero_iff_dvd k p).not.mpr hk)
    (fun c => by rw [← Nat.cast_mul, hfactor c])
    ((ZMod.natCast_eq_zero_iff (D c) p).not.mpr hDc) hc hd

/-- In the physical promotion test, nondivisibility of the dilation is
part of eligibility. Even with that condition included, at most one
omission choice is available per pending particle. -/
theorem modular_eligible_omission_card_le {Ω Particle : Type*}
    (choices : Finset Ω) (pending : Finset Particle) (U : Ω → ℕ)
    (hU : Function.Injective U) (p : Particle → ℕ) (hp : ∀ z, (p z).Prime)
    (D : Particle → Ω → ℕ) (F : Particle → ℕ)
    (hfactor : ∀ z c, U c * D z c = F z)
    (r : ∀ z, ZMod (p z)) (k : ℤ) (hk : ∀ z ∈ pending, ¬ (p z : ℤ) ∣ k)
    (hlt : ∀ z ∈ pending, ∀ c, U c < p z) :
    (rareOmissionChoices choices pending
      (fun z c => ¬ p z ∣ D z c ∧ r z + (k : ZMod (p z)) * (D z c : ZMod (p z)) = 0)).card ≤
      pending.card := by
  apply rare_omission_choices_card_le
  intro z hz c hc d hd hcz hdz
  exact modular_complementary_omission_unique (hp z) U (D z) hU (hlt z hz)
    (F z) (hfactor z) (r z) k (hk z hz) hcz.1 hcz.2 hdz.2

/-- Concrete modular promotion congruences give the rare-choice count.
The prime and coefficient may depend on the pending particle. -/
theorem modular_rare_omission_card_le {Ω Particle : Type*}
    (choices : Finset Ω) (pending : Finset Particle) (U : Ω → ℕ)
    (hU : Function.Injective U) (p : Particle → ℕ)
    (hp : ∀ z, (p z).Prime) (r a : ∀ z, ZMod (p z))
    (ha : ∀ z ∈ pending, a z ≠ 0)
    (hlt : ∀ z ∈ pending, ∀ c, U c < p z) :
    (rareOmissionChoices choices pending
      (fun z c => r z + a z * (U c : ZMod (p z))⁻¹ = 0)).card ≤ pending.card := by
  apply rare_omission_choices_card_le
  intro z hz c hc d hd hcz hdz
  have : Fact (p z).Prime := ⟨hp z⟩
  exact omission_congruence_unique (fun c => (U c : ZMod (p z)))
    (omission_natCast_injective (p z) U hU (hlt z hz)) (r z) (a z) (ha z hz) (by simpa only [div_eq_mul_inv] using hcz)
    (by simpa only [div_eq_mul_inv] using hdz)
end

section
open Finset
open scoped BigOperators Classical
/-- The product of all labels in the source groups. -/
noncomputable def primeFullProduct {G : Type*} [Fintype G]
    (S : G → Finset ℕ) : ℕ := ∏ g, ∏ p ∈ S g, p

/-- The product of source labels retained after the omission choice. -/
noncomputable def primeRetainedProduct {G : Type*} [Fintype G]
    (S : G → Finset ℕ) (ell : ℕ) (A : PrimeOmissionChoices S ell) : ℕ :=
  ∏ g, ∏ p ∈ S g \ (A g).val, p

/-- The dilation with a fixed factor from the already conditioned groups. -/
noncomputable def primeOmissionDilation {G : Type*} [Fintype G]
    (S : G → Finset ℕ) (ell D_B : ℕ) (A : PrimeOmissionChoices S ell) : ℕ :=
  D_B * primeRetainedProduct S ell A

/-- Omitted and retained factors partition the full product. This identity
needs only the subset condition and does not assume primality. -/
theorem prime_omission_mul_retained_eq_full {G : Type*} [Fintype G]
    (S : G → Finset ℕ) (ell : ℕ) (A : PrimeOmissionChoices S ell) :
    primeOmissionProduct S ell A * primeRetainedProduct S ell A = primeFullProduct S := by
  unfold primeOmissionProduct primeRetainedProduct primeFullProduct
  rw [← prod_mul_distrib]
  apply prod_congr rfl
  intro g _
  rw [mul_comm]
  exact prod_sdiff (mem_powersetCard.mp (A g).property).1

/-- Multiplying each dilation by its omitted product gives the same
constant, including the fixed conditioned factor. -/
theorem prime_omission_mul_dilation_eq {G : Type*} [Fintype G]
    (S : G → Finset ℕ) (ell D_B : ℕ) (A : PrimeOmissionChoices S ell) :
    primeOmissionProduct S ell A * primeOmissionDilation S ell D_B A =
      D_B * primeFullProduct S := by
  unfold primeOmissionDilation
  rw [mul_left_comm, prime_omission_mul_retained_eq_full]

/-- Retaining any subset of prime labels gives a positive product. -/
theorem prime_retained_product_pos {G : Type*} [Fintype G]
    (S : G → Finset ℕ) (ell : ℕ) (hS : ∀ g p, p ∈ S g → Nat.Prime p)
    (A : PrimeOmissionChoices S ell) : 0 < primeRetainedProduct S ell A := by
  apply prod_pos
  intro g _
  apply prod_pos
  intro p hp
  exact (hS g p (mem_sdiff.mp hp).1).pos

/-- With equally sized groups, the independent omission count is a power
of a single binomial coefficient. -/
theorem prime_omission_choices_card_uniform {G : Type*} [Fintype G]
    (S : G → Finset ℕ) (ell M : ℕ) (hcard : ∀ g, (S g).card = M) :
    Fintype.card (PrimeOmissionChoices S ell) = (M.choose ell) ^ Fintype.card G := by
  rw [prime_omission_choices_card]
  simp only [hcard, prod_const, card_univ]

/-- Omission choices exist whenever every group contains enough labels. -/
theorem prime_omission_choices_nonempty {G : Type*} [Fintype G]
    (S : G → Finset ℕ) (ell : ℕ) (hell : ∀ g, ell ≤ (S g).card) :
    Nonempty (PrimeOmissionChoices S ell) := by
  apply Fintype.card_pos_iff.mp
  rw [prime_omission_choices_card]
  exact prod_pos (fun g _ => Nat.choose_pos (hell g))

/-- In particular, equally sized groups admit omissions when `ell ≤ M`. -/
theorem prime_omission_choices_nonempty_uniform {G : Type*} [Fintype G]
    (S : G → Finset ℕ) (ell M : ℕ) (hcard : ∀ g, (S g).card = M) (hell : ell ≤ M) :
    Nonempty (PrimeOmissionChoices S ell) :=
  prime_omission_choices_nonempty S ell (fun g => by rw [hcard]; exact hell)

/-- For actual complementary prime products, each eligible pending
particle permits at most one omission choice. Consequently the number of
choices permitting any eligible promotion is at most the particle count. -/
theorem prime_omission_eligible_choices_card_le {G Particle : Type*} [Fintype G]
    (S : G → Finset ℕ) (ell : ℕ) (hS : ∀ g p, p ∈ S g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (S g) (S h)))
    (D_B : ℕ) (pending : Finset Particle) (p : Particle → ℕ)
    (hp : ∀ z, (p z).Prime) (r : ∀ z, ZMod (p z)) (k : ℤ)
    (hk : ∀ z ∈ pending, ¬ (p z : ℤ) ∣ k)
    (hlt : ∀ z ∈ pending, ∀ A : PrimeOmissionChoices S ell,
      primeOmissionProduct S ell A < p z) :
    (rareOmissionChoices (univ : Finset (PrimeOmissionChoices S ell)) pending
      (fun z A => ¬ p z ∣ primeOmissionDilation S ell D_B A ∧
        r z + (k : ZMod (p z)) * (primeOmissionDilation S ell D_B A : ZMod (p z)) = 0)).card ≤
      pending.card := by
  exact modular_eligible_omission_card_le univ pending (primeOmissionProduct S ell)
    (prime_omission_product_injective S ell hS hdis) p hp
    (fun _ => primeOmissionDilation S ell D_B) (fun _ => D_B * primeFullProduct S)
    (fun _ A => prime_omission_mul_dilation_eq S ell D_B A) r k hk hlt
end

section
open Finset
/-- Uniform average of a finite family of complex transition kernels. -/
noncomputable def rareTransferAverage {Ω ι : Type*} (choices : Finset Ω)
    (K : Ω → ι → ι → ℂ) (i j : ι) : ℂ :=
  (choices.card : ℂ)⁻¹ * ∑ a ∈ choices, K a i j

/-- Scalar version of the sparse-choice bound, allowing arbitrary nonnegative
weights on the target index. The exceptional set is a subset of the choices. -/
theorem sparse_choice_average_weighted_bound {Ω ι : Type*}
    (choices bad : Finset Ω) (s : Finset ι) (K : Ω → ι → ℂ) (w : ι → ℝ)
    (hw : ∀ j ∈ s, 0 ≤ w j) (hbad : bad ⊆ choices)
    {B : ℕ} (hcard : bad.card ≤ B) {M : ℝ} (hM : 0 ≤ M)
    (hrow : ∀ a ∈ choices, (∑ j ∈ s, ‖K a j‖ * w j) ≤ M)
    (hzero : ∀ a ∈ choices, a ∉ bad → ∀ j ∈ s, K a j = 0) :
    (∑ j ∈ s, ‖(choices.card : ℂ)⁻¹ * ∑ a ∈ choices, K a j‖ * w j) ≤
      M * B / choices.card := by
  classical
  have hn : 0 ≤ (choices.card : ℝ)⁻¹ := inv_nonneg.mpr (Nat.cast_nonneg _)
  have hnorm (j : ι) :
      ‖(choices.card : ℂ)⁻¹ * ∑ a ∈ choices, K a j‖ ≤
        (choices.card : ℝ)⁻¹ * ∑ a ∈ choices, ‖K a j‖ := by
    rw [norm_mul, norm_inv, Complex.norm_natCast]
    exact mul_le_mul_of_nonneg_left (norm_sum_le _ _) hn
  calc
    (∑ j ∈ s, ‖(choices.card : ℂ)⁻¹ * ∑ a ∈ choices, K a j‖ * w j) ≤
        ∑ j ∈ s, ((choices.card : ℝ)⁻¹ * ∑ a ∈ choices, ‖K a j‖) * w j :=
      sum_le_sum fun j hj => mul_le_mul_of_nonneg_right (hnorm j) (hw j hj)
    _ = (choices.card : ℝ)⁻¹ * ∑ a ∈ choices, ∑ j ∈ s, ‖K a j‖ * w j := by
      simp_rw [mul_assoc, sum_mul, mul_sum]
      rw [sum_comm]
    _ = (choices.card : ℝ)⁻¹ * ∑ a ∈ bad, ∑ j ∈ s, ‖K a j‖ * w j := by
      congr 1
      symm
      apply sum_subset hbad
      intro a ha hnot
      apply sum_eq_zero
      intro j hj
      simp [hzero a ha hnot j hj]
    _ ≤ (choices.card : ℝ)⁻¹ * ((bad.card : ℝ) * M) := by
      apply mul_le_mul_of_nonneg_left _ hn
      calc
        (∑ a ∈ bad, ∑ j ∈ s, ‖K a j‖ * w j) ≤ ∑ _a ∈ bad, M :=
          sum_le_sum fun a ha => hrow a (hbad ha)
        _ = (bad.card : ℝ) * M := by simp
    _ ≤ (choices.card : ℝ)⁻¹ * ((B : ℝ) * M) :=
      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right (by exact_mod_cast hcard) hM) hn
    _ = M * B / choices.card := by ring

/-- At most B choices can leave each source; averaging improves the weighted
row constant from C to C * B / number of choices. -/
theorem rare_transfer_average_row {Ω ι : Type*}
    (choices : Finset Ω) (s : Finset ι) (K : Ω → ι → ι → ℂ)
    (v : ι → ℝ) (hv : ∀ i ∈ s, 0 ≤ v i) (bad : ι → Finset Ω)
    (hbad : ∀ i ∈ s, bad i ⊆ choices) {B : ℕ}
    (hcard : ∀ i ∈ s, (bad i).card ≤ B) {C : ℝ} (hC : 0 ≤ C)
    (hrow : ∀ a ∈ choices, ∀ i ∈ s, (∑ j ∈ s, ‖K a i j‖ * v j) ≤ C * v i)
    (hzero : ∀ i ∈ s, ∀ a ∈ choices, a ∉ bad i → ∀ j ∈ s, K a i j = 0) :
    ∀ i ∈ s, (∑ j ∈ s, ‖rareTransferAverage choices K i j‖ * v j) ≤
      (C * B / choices.card) * v i := by
  intro i hi
  have h := sparse_choice_average_weighted_bound choices (bad i) s (fun a j => K a i j) v
    hv (hbad i hi) (hcard i hi) (mul_nonneg hC (hv i hi))
    (fun a ha => hrow a ha i hi) (hzero i hi)
  simpa only [rareTransferAverage, mul_div_assoc, mul_assoc, mul_left_comm, mul_comm] using h

/-- Ordinary weighted column bounds survive averaging. -/
theorem rare_transfer_average_column {Ω ι : Type*}
    (choices : Finset Ω) (hchoices : choices.Nonempty) (s : Finset ι)
    (K : Ω → ι → ι → ℂ) (μ v : ι → ℝ)
    (hμ : ∀ i ∈ s, 0 ≤ μ i) (hv : ∀ i ∈ s, 0 ≤ v i) {C : ℝ} (hC : 0 ≤ C)
    (hcol : ∀ a ∈ choices, ∀ j ∈ s,
      (∑ i ∈ s, μ i * ‖K a i j‖ * v i) ≤ C * μ j * v j) :
    ∀ j ∈ s, (∑ i ∈ s, μ i * ‖rareTransferAverage choices K i j‖ * v i) ≤
      C * μ j * v j := by
  intro j hj
  have h := sparse_choice_average_weighted_bound choices choices s (fun a i => K a i j)
    (fun i => μ i * v i) (fun i hi => mul_nonneg (hμ i hi) (hv i hi))
    (Subset.refl _) (le_refl choices.card) (mul_nonneg (mul_nonneg hC (hμ j hj)) (hv j hj))
    (fun a ha => by simpa only [mul_assoc, mul_left_comm, mul_comm] using hcol a ha j hj)
    (fun a ha hnot => (hnot ha).elim)
  have hn : (choices.card : ℝ) ≠ 0 := by exact_mod_cast hchoices.card_pos.ne'
  rw [mul_div_cancel_right₀ _ hn] at h
  simpa only [rareTransferAverage, mul_assoc, mul_left_comm, mul_comm] using h

/-- Sparse-choice row bound plus an averaged weighted column bound gives
operator gain C * sqrt(B / number of choices). -/
theorem rare_transfer_schur_norm {Ω ι : Type*}
    (choices : Finset Ω) (s : Finset ι) (K : Ω → ι → ι → ℂ)
    (μ v : ι → ℝ) (hμ : ∀ i ∈ s, 0 ≤ μ i) (hv : ∀ i ∈ s, 0 < v i)
    (bad : ι → Finset Ω) (hbad : ∀ i ∈ s, bad i ⊆ choices) {B : ℕ}
    (hcard : ∀ i ∈ s, (bad i).card ≤ B) {C : ℝ} (hC : 0 ≤ C)
    (hrow : ∀ a ∈ choices, ∀ i ∈ s, (∑ j ∈ s, ‖K a i j‖ * v j) ≤ C * v i)
    (hzero : ∀ i ∈ s, ∀ a ∈ choices, a ∉ bad i → ∀ j ∈ s, K a i j = 0)
    (hcol : ∀ j ∈ s, (∑ i ∈ s, μ i * ‖rareTransferAverage choices K i j‖ * v i) ≤
      C * μ j * v j) (f : ι → ℂ) :
    Real.sqrt (∑ i ∈ s, μ i * ‖∑ j ∈ s, rareTransferAverage choices K i j * f j‖ ^ 2) ≤
      (C * Real.sqrt ((B : ℝ) / choices.card)) * Real.sqrt (∑ j ∈ s, μ j * ‖f j‖ ^ 2) := by
  have hrow' := rare_transfer_average_row choices s K v (fun i hi => (hv i hi).le)
    bad hbad hcard hC hrow hzero
  have hgain : Real.sqrt ((C * B / choices.card) * C) =
      C * Real.sqrt ((B : ℝ) / choices.card) := by
    rw [show (C * B / choices.card) * C = C ^ 2 * ((B : ℝ) / choices.card) by ring,
      Real.sqrt_mul (sq_nonneg C), Real.sqrt_sq hC]
  simpa only [hgain] using
    finite_weighted_schur_transition_norm s μ v (rareTransferAverage choices K) hμ hv
      (div_nonneg (mul_nonneg hC (Nat.cast_nonneg _)) (Nat.cast_nonneg _)) hC hrow' hcol f

/-- A convenient form requiring only per-choice row and column estimates. -/
theorem rare_transfer_schur_norm_of_choice_columns {Ω ι : Type*}
    (choices : Finset Ω) (hchoices : choices.Nonempty) (s : Finset ι)
    (K : Ω → ι → ι → ℂ) (μ v : ι → ℝ)
    (hμ : ∀ i ∈ s, 0 ≤ μ i) (hv : ∀ i ∈ s, 0 < v i)
    (bad : ι → Finset Ω) (hbad : ∀ i ∈ s, bad i ⊆ choices) {B : ℕ}
    (hcard : ∀ i ∈ s, (bad i).card ≤ B) {C : ℝ} (hC : 0 ≤ C)
    (hrow : ∀ a ∈ choices, ∀ i ∈ s, (∑ j ∈ s, ‖K a i j‖ * v j) ≤ C * v i)
    (hzero : ∀ i ∈ s, ∀ a ∈ choices, a ∉ bad i → ∀ j ∈ s, K a i j = 0)
    (hcol : ∀ a ∈ choices, ∀ j ∈ s,
      (∑ i ∈ s, μ i * ‖K a i j‖ * v i) ≤ C * μ j * v j) (f : ι → ℂ) :
    Real.sqrt (∑ i ∈ s, μ i * ‖∑ j ∈ s, rareTransferAverage choices K i j * f j‖ ^ 2) ≤
      (C * Real.sqrt ((B : ℝ) / choices.card)) * Real.sqrt (∑ j ∈ s, μ j * ‖f j‖ ^ 2) := by
  exact rare_transfer_schur_norm choices s K μ v hμ hv bad hbad hcard hC hrow hzero
    (rare_transfer_average_column choices hchoices s K μ v hμ (fun i hi => (hv i hi).le) hC hcol) f

/-- Promotion and storage kernels can carry their improved Schur constants
on opposite sides. Their sum has at most twice the common square-root gain. -/
theorem finite_weighted_schur_opposite_sum_norm {ι : Type*} (s : Finset ι)
    (μ v : ι → ℝ) (K L : ι → ι → ℂ)
    (hμ : ∀ i ∈ s, 0 ≤ μ i) (hv : ∀ i ∈ s, 0 < v i)
    {C δ : ℝ} (hC : 0 ≤ C) (hδ : 0 ≤ δ)
    (hKrow : ∀ i ∈ s, (∑ j ∈ s, ‖K i j‖ * v j) ≤ (C * δ) * v i)
    (hKcol : ∀ j ∈ s, (∑ i ∈ s, μ i * ‖K i j‖ * v i) ≤ C * μ j * v j)
    (hLrow : ∀ i ∈ s, (∑ j ∈ s, ‖L i j‖ * v j) ≤ C * v i)
    (hLcol : ∀ j ∈ s, (∑ i ∈ s, μ i * ‖L i j‖ * v i) ≤ (C * δ) * μ j * v j)
    (f : ι → ℂ) :
    Real.sqrt (∑ i ∈ s, μ i * ‖∑ j ∈ s, (K i j + L i j) * f j‖ ^ 2) ≤
      (2 * C * Real.sqrt δ) * Real.sqrt (∑ j ∈ s, μ j * ‖f j‖ ^ 2) := by
  have hK := finite_weighted_schur_transition s μ v K hμ hv hKrow hKcol f
  have hL := finite_weighted_schur_transition s μ v L hμ hv hLrow hLcol f
  have hadd (x y : ℂ) : ‖x + y‖ ^ 2 ≤ 2 * ‖x‖ ^ 2 + 2 * ‖y‖ ^ 2 := by
    have hh : ‖x + y‖ ^ 2 ≤ (‖x‖ + ‖y‖) ^ 2 :=
      (sq_le_sq₀ (norm_nonneg _) (add_nonneg (norm_nonneg _) (norm_nonneg _))).mpr
        (norm_add_le x y)
    nlinarith [sq_nonneg (‖x‖ - ‖y‖)]
  have hsq : (∑ i ∈ s, μ i * ‖∑ j ∈ s, (K i j + L i j) * f j‖ ^ 2) ≤
      (4 * C ^ 2 * δ) * ∑ j ∈ s, μ j * ‖f j‖ ^ 2 := by
    calc
      (∑ i ∈ s, μ i * ‖∑ j ∈ s, (K i j + L i j) * f j‖ ^ 2) ≤
          ∑ i ∈ s, μ i * (2 * ‖∑ j ∈ s, K i j * f j‖ ^ 2 +
            2 * ‖∑ j ∈ s, L i j * f j‖ ^ 2) := by
        apply sum_le_sum
        intro i hi
        apply mul_le_mul_of_nonneg_left _ (hμ i hi)
        simpa only [add_mul, sum_add_distrib] using
          hadd (∑ j ∈ s, K i j * f j) (∑ j ∈ s, L i j * f j)
      _ = 2 * (∑ i ∈ s, μ i * ‖∑ j ∈ s, K i j * f j‖ ^ 2) +
          2 * (∑ i ∈ s, μ i * ‖∑ j ∈ s, L i j * f j‖ ^ 2) := by
        rw [mul_sum, mul_sum, ← sum_add_distrib]
        apply sum_congr rfl
        intro i hi
        ring
      _ ≤ (4 * C ^ 2 * δ) * ∑ j ∈ s, μ j * ‖f j‖ ^ 2 := by nlinarith
  have hfactor : Real.sqrt (4 * C ^ 2 * δ) = 2 * C * Real.sqrt δ := by
    rw [show 4 * C ^ 2 * δ = (2 * C) ^ 2 * δ by ring,
      Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq (mul_nonneg (by norm_num) hC)]
  have hconst : 0 ≤ 4 * C ^ 2 * δ := mul_nonneg (mul_nonneg (by norm_num) (sq_nonneg C)) hδ
  simpa only [Real.sqrt_mul hconst, hfactor] using Real.sqrt_le_sqrt hsq
end

section
open Finset
/-- A fixed source's choices permitting an eligible promotion. -/
noncomputable def eligibleOmissionChoices {Ω Particle : Type*}
    (choices : Finset Ω) (pending : Finset Particle)
    (p : Particle → ℕ) (D : Particle → Ω → ℕ)
    (r : ∀ z, ZMod (p z)) (k : ℤ) : Finset Ω :=
  rareOmissionChoices choices pending (fun z c =>
    ¬ p z ∣ D z c ∧ r z + (k : ZMod (p z)) * (D z c : ZMod (p z)) = 0)

theorem eligible_omission_choices_subset {Ω Particle : Type*}
    (choices : Finset Ω) (pending : Finset Particle)
    (p : Particle → ℕ) (D : Particle → Ω → ℕ)
    (r : ∀ z, ZMod (p z)) (k : ℤ) :
    eligibleOmissionChoices choices pending p D r k ⊆ choices := by
  classical
  intro c hc
  simp only [eligibleOmissionChoices, rareOmissionChoices, mem_filter] at hc
  exact hc.1

/-- A promotion kernel supported on its actual modular eligibility test
has the square-root rare-transfer gain. The ambient finite state space,
pending labels, and full products can vary with the source. -/
theorem eligible_omission_schur_norm {Ω Particle ι : Type*}
    (choices : Finset Ω) (states : Finset ι) (K : Ω → ι → ι → ℂ)
    (μ v : ι → ℝ) (hμ : ∀ i ∈ states, 0 ≤ μ i) (hv : ∀ i ∈ states, 0 < v i)
    (pending : ι → Finset Particle) (U : ι → Ω → ℕ)
    (p : ι → Particle → ℕ) (D : ι → Particle → Ω → ℕ) (F : ι → Particle → ℕ)
    (r : ∀ i z, ZMod (p i z)) (k : ι → ℤ)
    (hinj : ∀ i ∈ states, Function.Injective (U i))
    (hprime : ∀ i ∈ states, ∀ z, (p i z).Prime)
    (hfactor : ∀ i ∈ states, ∀ z c, U i c * D i z c = F i z)
    (hk : ∀ i ∈ states, ∀ z ∈ pending i, ¬ (p i z : ℤ) ∣ k i)
    (hsmall : ∀ i ∈ states, ∀ z ∈ pending i, ∀ c, U i c < p i z)
    {B : ℕ} (hB : ∀ i ∈ states, (pending i).card ≤ B)
    {C : ℝ} (hC : 0 ≤ C)
    (hrow : ∀ c ∈ choices, ∀ i ∈ states,
      (∑ j ∈ states, ‖K c i j‖ * v j) ≤ C * v i)
    (hsupport : ∀ i ∈ states, ∀ c ∈ choices, ∀ j ∈ states, K c i j ≠ 0 →
      ∃ z ∈ pending i, ¬ p i z ∣ D i z c ∧
        r i z + (k i : ZMod (p i z)) * (D i z c : ZMod (p i z)) = 0)
    (hcol : ∀ j ∈ states,
      (∑ i ∈ states, μ i * ‖rareTransferAverage choices K i j‖ * v i) ≤ C * μ j * v j)
    (f : ι → ℂ) :
    Real.sqrt (∑ i ∈ states,
      μ i * ‖∑ j ∈ states, rareTransferAverage choices K i j * f j‖ ^ 2) ≤
      (C * Real.sqrt ((B : ℝ) / choices.card)) *
        Real.sqrt (∑ j ∈ states, μ j * ‖f j‖ ^ 2) := by
  classical
  apply rare_transfer_schur_norm choices states K μ v hμ hv
    (fun i => eligibleOmissionChoices choices (pending i) (p i) (D i) (r i) (k i))
    (fun i _ => eligible_omission_choices_subset choices (pending i) (p i) (D i) (r i) (k i))
    (fun i hi => (modular_eligible_omission_card_le choices (pending i) (U i)
      (hinj i hi) (p i) (hprime i hi) (D i) (F i) (hfactor i hi) (r i) (k i)
      (hk i hi) (hsmall i hi)).trans (hB i hi)) hC hrow _ hcol f
  intro i hi c hc hnot j hj
  by_contra hnonzero
  apply hnot
  simp only [eligibleOmissionChoices, rareOmissionChoices, mem_filter]
  exact ⟨hc, hsupport i hi c hc j hj hnonzero⟩
end

section
open Finset
open scoped Classical
/-- A common bound on the source labels bounds every omission product. -/
theorem prime_omission_product_le_pow {G : Type*} [Fintype G]
    (S : G → Finset ℕ) (ell H : ℕ) (hH : ∀ g p, p ∈ S g → p ≤ H)
    (A : PrimeOmissionChoices S ell) :
    primeOmissionProduct S ell A ≤ H ^ (ell * Fintype.card G) := by
  calc
    primeOmissionProduct S ell A ≤ ∏ g : G, H ^ ell := by
      apply prod_le_prod'
      intro g hg
      have h := prod_le_prod' (fun p (hp : p ∈ (A g).val) =>
        hH g p ((mem_powersetCard.mp (A g).property).1 hp))
      simpa only [prod_const, (mem_powersetCard.mp (A g).property).2] using h
    _ = H ^ (ell * Fintype.card G) := by
      rw [prod_const, card_univ, ← pow_mul]

/-- The support of a conditioned promotion row can only use omissions
that solve one pending particle's eligible congruence. Uniform averaging
therefore improves its row cost by B divided by the exact choice count. -/
theorem prime_omission_transfer_row {G Particle ι : Type*} [Fintype G]
    (S : G → Finset ℕ) (ell : ℕ) (hS : ∀ g p, p ∈ S g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (S g) (S h)))
    (D_B : ℕ) (pending : Finset Particle) (p : Particle → ℕ)
    (hp : ∀ z, (p z).Prime) (r : ∀ z, ZMod (p z)) (k : ℤ)
    (hk : ∀ z ∈ pending, ¬ (p z : ℤ) ∣ k)
    (hlt : ∀ z ∈ pending, ∀ A : PrimeOmissionChoices S ell,
      primeOmissionProduct S ell A < p z)
    (targets : Finset ι) (K : PrimeOmissionChoices S ell → ι → ℂ)
    (w : ι → ℝ) (hw : ∀ j ∈ targets, 0 ≤ w j)
    {B : ℕ} (hB : pending.card ≤ B) {M : ℝ} (hM : 0 ≤ M)
    (hrow : ∀ A, (∑ j ∈ targets, ‖K A j‖ * w j) ≤ M)
    (hsupport : ∀ A j, j ∈ targets → K A j ≠ 0 →
      ∃ z ∈ pending, ¬ p z ∣ primeOmissionDilation S ell D_B A ∧
        r z + (k : ZMod (p z)) * (primeOmissionDilation S ell D_B A : ZMod (p z)) = 0) :
    (∑ j ∈ targets,
      ‖(Fintype.card (PrimeOmissionChoices S ell) : ℂ)⁻¹ *
        ∑ A : PrimeOmissionChoices S ell, K A j‖ * w j) ≤
      M * B / (∏ g, (S g).card.choose ell : ℕ) := by
  classical
  let allows : Particle → PrimeOmissionChoices S ell → Prop := fun z A =>
    ¬ p z ∣ primeOmissionDilation S ell D_B A ∧
      r z + (k : ZMod (p z)) * (primeOmissionDilation S ell D_B A : ZMod (p z)) = 0
  let bad := rareOmissionChoices univ pending allows
  have hbad : bad ⊆ (univ : Finset (PrimeOmissionChoices S ell)) := subset_univ _
  have hcard : bad.card ≤ B :=
    (prime_omission_eligible_choices_card_le S ell hS hdis D_B pending p hp r k hk hlt).trans hB
  have hzero : ∀ A ∈ (univ : Finset (PrimeOmissionChoices S ell)),
      A ∉ bad → ∀ j ∈ targets, K A j = 0 := by
    intro A hA hnot j hj
    by_contra hne
    apply hnot
    simp only [bad, rareOmissionChoices, mem_filter, mem_univ, true_and]
    exact hsupport A j hj hne
  have h := sparse_choice_average_weighted_bound univ bad targets K w hw hbad hcard hM
    (fun A _ => hrow A) hzero
  simpa only [card_univ, prime_omission_choices_card] using h
end

section
open Filter
open scoped Topology
/-- For positive omission size, the binomial choice count grows at least
linearly in the number of retained slots. -/
theorem succ_le_choose_add (ell J : ℕ) (hell : 0 < ell) :
    J + 1 ≤ (J + ell).choose ell := by
  calc
    J + 1 = (J + 1).choose J := (Nat.choose_succ_self_right J).symm
    _ ≤ (J + ell).choose J := Nat.choose_le_choose J (by omega)
    _ = (J + ell).choose ell := Nat.choose_symm_add

/-- With positive fixed omission size, the choice count tends to infinity. -/
theorem tendsto_choose_add_atTop (ell : ℕ) (hell : 0 < ell) :
    Tendsto (fun J : ℕ => (J + ell).choose ell) atTop atTop := by
  apply tendsto_atTop_mono (fun J => (Nat.le_succ J).trans (succ_le_choose_add ell J hell))
  exact tendsto_id

/-- The logarithm of the choice count also tends to infinity with `J`. -/
theorem tendsto_log_choose_add_atTop (ell : ℕ) (hell : 0 < ell) :
    Tendsto (fun J : ℕ => Real.log (((J + ell).choose ell : ℕ) : ℝ)) atTop atTop := by
  exact Real.tendsto_log_atTop.comp
    ((tendsto_natCast_atTop_atTop : Tendsto (fun n : ℕ => (n : ℝ)) atTop atTop).comp
      (tendsto_choose_add_atTop ell hell))

/-- The logarithmic choice count exceeds any prescribed real threshold. -/
theorem exists_log_choose_add_gt (ell : ℕ) (hell : 0 < ell) (K : ℝ) :
    ∃ J : ℕ, K < Real.log (((J + ell).choose ell : ℕ) : ℝ) :=
  ((tendsto_log_choose_add_atTop ell hell).eventually_gt_atTop K).exists

/-- The threshold can be achieved together with any previous lower bound
on `J`, so this choice is compatible with other fixed-parameter conditions. -/
theorem exists_log_choose_add_gt_ge (ell : ℕ) (hell : 0 < ell) (K : ℝ) (J₀ : ℕ) :
    ∃ J : ℕ, J₀ ≤ J ∧ K < Real.log (((J + ell).choose ell : ℕ) : ℝ) :=
  ((eventually_ge_atTop J₀).and
    ((tendsto_log_choose_add_atTop ell hell).eventually_gt_atTop K)).exists

/-- A fixed `J` supplies the logarithmic gain needed by rare transfer. -/
theorem exists_fixed_rare_transfer_gain (ell : ℕ) (hell : 0 < ell)
    (c₀ A G : ℝ) (hc₀ : 0 < c₀) :
    ∃ J : ℕ, (c₀ / 2) * Real.log (((J + ell).choose ell : ℕ) : ℝ) > A + G + 3 := by
  obtain ⟨J, hJ⟩ := exists_log_choose_add_gt ell hell ((A + G + 3) / (c₀ / 2))
  refine ⟨J, ?_⟩
  have hc : 0 < c₀ / 2 := div_pos hc₀ (by norm_num)
  simpa only [mul_comm] using (div_lt_iff₀ hc).mp hJ

/-- A gap of at least two in the real exponents already absorbs the
factor four at every scale `L ≥ 2`. -/
theorem two_mul_rpow_le_half_rpow_of_gap (a b L : ℝ)
    (hgap : a + 2 ≤ b) (hL : 2 ≤ L) :
    2 * L ^ a ≤ (1 / 2 : ℝ) * L ^ b := by
  have hLpos : 0 < L := by linarith
  have hLone : 1 ≤ L := by linarith
  have hmono : L ^ a ≤ L ^ (b - 2) :=
    Real.rpow_le_rpow_of_exponent_le hLone (by linarith)
  have hsq : 4 ≤ L ^ (2 : ℝ) := by
    rw [Real.rpow_two]
    nlinarith
  have hsqpos : 0 < L ^ (2 : ℝ) := Real.rpow_pos_of_pos hLpos _
  have hcoef : 2 / L ^ (2 : ℝ) ≤ (1 / 2 : ℝ) := by
    apply (div_le_iff₀ hsqpos).mpr
    linarith
  calc
    2 * L ^ a ≤ 2 * L ^ (b - 2) := mul_le_mul_of_nonneg_left hmono (by norm_num)
    _ = (2 / L ^ (2 : ℝ)) * L ^ b := by rw [Real.rpow_sub hLpos]; ring
    _ ≤ (1 / 2 : ℝ) * L ^ b :=
      mul_le_mul_of_nonneg_right hcoef (Real.rpow_nonneg hLpos.le _)

/-- The chosen logarithmic gain gives the requested rare-transfer bound
uniformly at every real scale at least two. -/
theorem rare_transfer_decay_of_gain (ell J : ℕ) (c₀ A G L : ℝ)
    (hgain : (c₀ / 2) * Real.log (((J + ell).choose ell : ℕ) : ℝ) > A + G + 3)
    (hL : 2 ≤ L) :
    2 * L ^ (A + 1 - (c₀ / 2) * Real.log (((J + ell).choose ell : ℕ) : ℝ)) ≤
      (1 / 2 : ℝ) * L ^ (-G) :=
  two_mul_rpow_le_half_rpow_of_gap _ _ _ (by linarith) hL

/-- Quantifier order for rare transfer: first choose a fixed `J`, then let
the real scale `L` tend to infinity. -/
theorem exists_fixed_rare_transfer_decay (ell : ℕ) (hell : 0 < ell)
    (c₀ A G : ℝ) (hc₀ : 0 < c₀) :
    ∃ J : ℕ,
      (c₀ / 2) * Real.log (((J + ell).choose ell : ℕ) : ℝ) > A + G + 3 ∧
      ∀ᶠ L : ℝ in atTop,
        2 * L ^ (A + 1 - (c₀ / 2) * Real.log (((J + ell).choose ell : ℕ) : ℝ)) ≤
          (1 / 2 : ℝ) * L ^ (-G) := by
  obtain ⟨J, hJ⟩ := exists_fixed_rare_transfer_gain ell hell c₀ A G hc₀
  refine ⟨J, hJ, ?_⟩
  filter_upwards [eventually_ge_atTop (2 : ℝ)] with L hL
  exact rare_transfer_decay_of_gain ell J c₀ A G L hJ hL
end

section
open Finset
open scoped BigOperators Classical
/-- A map of finite types with equally sized fibres carries the uniform
average to the uniform average. -/
theorem uniform_average_of_equal_fiber_card {Ω T : Type*}
    [Fintype Ω] [Nonempty Ω] [Fintype T] [DecidableEq T] (q : Ω → T)
    (hcard : ∀ t u : T, Fintype.card {a : Ω // q a = t} = Fintype.card {a : Ω // q a = u})
    (f : T → ℝ) :
    (∑ a : Ω, f (q a)) / (Fintype.card Ω : ℝ) =
      (∑ t : T, f t) / (Fintype.card T : ℝ) := by
  let a₀ : Ω := Classical.choice inferInstance
  let m : ℕ := Fintype.card {a : Ω // q a = q a₀}
  have hm : ∀ t : T, Fintype.card {a : Ω // q a = t} = m := fun t => hcard t (q a₀)
  have hmpos : 0 < m := by
    apply Fintype.card_pos_iff.mpr
    exact ⟨⟨a₀, rfl⟩⟩
  have hmne : (m : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hmpos)
  have hsum : ∀ f : T → ℝ, (∑ a : Ω, f (q a)) = (m : ℝ) * ∑ t : T, f t := by
    intro f
    rw [← Fintype.sum_fiberwise' q f]
    simp only [sum_const, card_univ, hm, nsmul_eq_mul]
    rw [← mul_sum]
  have htotal : (Fintype.card Ω : ℝ) = (m : ℝ) * (Fintype.card T : ℝ) := by
    simpa only [sum_const, card_univ, nsmul_eq_mul, mul_one] using hsum (fun _ => 1)
  rw [hsum f, htotal]
  exact mul_div_mul_left _ _ hmne

/-- All possible fixed-cardinality omissions from a finite type. -/
abbrev UniformOmissionSubsets (α : Type*) [Fintype α] (ell : ℕ) :=
  ↥((univ : Finset α).powersetCard ell)

/-- Permuting a fixed set of slots produces a fixed-cardinality omission. -/
def permutedOmissionSubset {α : Type*} [Fintype α] {ell : ℕ}
    (s : Finset α) (hs : s.card = ell) (σ : Equiv.Perm α) : UniformOmissionSubsets α ell :=
  ⟨s.map σ.toEmbedding, mem_powersetCard.mpr ⟨subset_univ _, by simpa only [card_map] using hs⟩⟩

/-- The number of possible omissions is the binomial choice count. -/
theorem uniform_omission_subsets_card (α : Type*) [Fintype α] (ell : ℕ) :
    Fintype.card (UniformOmissionSubsets α ell) = (Fintype.card α).choose ell := by
  simp only [UniformOmissionSubsets, Fintype.card_coe, card_powersetCard, card_univ]

/-- Every omission of the required cardinality is induced by a permutation. -/
theorem permuted_omission_subset_surjective {α : Type*} [Fintype α] {ell : ℕ}
    (s : Finset α) (hs : s.card = ell) :
    Function.Surjective (permutedOmissionSubset s hs) := by
  intro t
  obtain ⟨σ, hσ⟩ := Equiv.Perm.exists_map_finset_eq s t.val
    (hs.trans (mem_powersetCard.mp t.property).2.symm)
  exact ⟨σ, Subtype.ext hσ⟩

/-- Composition with a permutation taking `t` to `u` bijects the two
fibres of the omission map. -/
theorem permuted_omission_fiber_card_eq {α : Type*} [Fintype α] {ell : ℕ}
    (s : Finset α) (hs : s.card = ell) (t u : UniformOmissionSubsets α ell) :
    Fintype.card {σ : Equiv.Perm α // permutedOmissionSubset s hs σ = t} =
      Fintype.card {σ : Equiv.Perm α // permutedOmissionSubset s hs σ = u} := by
  obtain ⟨τ, hτ⟩ := Equiv.Perm.exists_map_finset_eq t.val u.val
    ((mem_powersetCard.mp t.property).2.trans (mem_powersetCard.mp u.property).2.symm)
  apply Fintype.card_congr
  refine Equiv.subtypeEquiv (Equiv.mulLeft τ) ?_
  intro σ
  constructor
  · intro hσ
    apply Subtype.ext
    have hv : s.map σ.toEmbedding = t.val := congrArg Subtype.val hσ
    change s.map (τ * σ).toEmbedding = u.val
    calc
      s.map (τ * σ).toEmbedding = (s.map σ.toEmbedding).map τ.toEmbedding := by
        rw [map_map]
        rfl
      _ = u.val := by rw [hv, hτ]
  · intro hσ
    apply Subtype.ext
    apply (map_injective τ.toEmbedding)
    have hv : s.map (τ * σ).toEmbedding = u.val := congrArg Subtype.val hσ
    change (s.map σ.toEmbedding).map τ.toEmbedding = t.val.map τ.toEmbedding
    rw [hτ, map_map]
    exact hv

/-- Uniform permutation averaging is exactly uniform omission averaging. -/
theorem uniform_permutation_omission_average {α : Type*} [Fintype α] {ell : ℕ}
    (s : Finset α) (hs : s.card = ell) (f : UniformOmissionSubsets α ell → ℝ) :
    (∑ σ : Equiv.Perm α, f (permutedOmissionSubset s hs σ)) /
        (Fintype.card (Equiv.Perm α) : ℝ) =
      (∑ t : UniformOmissionSubsets α ell, f t) / ((Fintype.card α).choose ell : ℝ) := by
  have h := uniform_average_of_equal_fiber_card
    (Ω := Equiv.Perm α) (T := UniformOmissionSubsets α ell) (permutedOmissionSubset s hs)
    (fun t u => permuted_omission_fiber_card_eq s hs t u) f
  simpa only [uniform_omission_subsets_card] using h

/-- The exact fraction of permutations whose omitted subset is bad. -/
theorem uniform_permutation_bad_omission_fraction {α : Type*} [Fintype α] {ell : ℕ}
    (s : Finset α) (hs : s.card = ell) (bad : Finset (UniformOmissionSubsets α ell)) :
    ((univ.filter (fun σ : Equiv.Perm α => permutedOmissionSubset s hs σ ∈ bad)).card : ℝ) /
        (Fintype.card (Equiv.Perm α) : ℝ) =
      (bad.card : ℝ) / ((Fintype.card α).choose ell : ℝ) := by
  have h := uniform_permutation_omission_average s hs (fun t => if t ∈ bad then 1 else 0)
  simpa only [sum_boole, filter_mem_eq_inter, univ_inter] using h

/-- A bad-subset count transfers directly to the uniform permutation law. -/
theorem uniform_permutation_bad_omission_fraction_le {α : Type*} [Fintype α] {ell : ℕ}
    (s : Finset α) (hs : s.card = ell) (bad : Finset (UniformOmissionSubsets α ell))
    (B : ℕ) (hbad : bad.card ≤ B) :
    ((univ.filter (fun σ : Equiv.Perm α => permutedOmissionSubset s hs σ ∈ bad)).card : ℝ) /
        (Fintype.card (Equiv.Perm α) : ℝ) ≤
      (B : ℝ) / ((Fintype.card α).choose ell : ℝ) := by
  rw [uniform_permutation_bad_omission_fraction]
  exact div_le_div_of_nonneg_right (by exact_mod_cast hbad) (Nat.cast_nonneg _)
end

section
open Finset
open scoped BigOperators Classical
/-- A fibre of a pointwise map is the product of its coordinate fibres. -/
def pointwiseMapFiberEquiv {G Ω T : Type*} (q : Ω → T) (t : G → T) :
    {a : G → Ω // (fun g => q (a g)) = t} ≃ (∀ g, {a : Ω // q a = t g}) where
  toFun a g := ⟨a.val g, congrFun a.property g⟩
  invFun a := ⟨fun g => (a g).val, funext (fun g => (a g).property)⟩
  left_inv a := by
    apply Subtype.ext
    rfl
  right_inv a := by
    funext g
    rfl

/-- Coordinate fibre sizes multiply for a finite pointwise map. -/
theorem pointwise_map_fiber_card {G Ω T : Type*}
    [Fintype G] [Fintype Ω] [DecidableEq T] (q : Ω → T) (t : G → T) :
    Fintype.card {a : G → Ω // (fun g => q (a g)) = t} =
      ∏ g, Fintype.card {a : Ω // q a = t g} := by
  rw [← Fintype.card_pi]
  exact Fintype.card_congr (pointwiseMapFiberEquiv q t)

/-- Equal coordinate fibres give equal fibres on arbitrary tuples. -/
theorem pointwise_map_fiber_card_eq {G Ω T : Type*}
    [Fintype G] [Fintype Ω] [DecidableEq T] (q : Ω → T)
    (hcard : ∀ t u : T, Fintype.card {a : Ω // q a = t} = Fintype.card {a : Ω // q a = u})
    (t u : G → T) :
    Fintype.card {a : G → Ω // (fun g => q (a g)) = t} =
      Fintype.card {a : G → Ω // (fun g => q (a g)) = u} := by
  rw [pointwise_map_fiber_card, pointwise_map_fiber_card]
  exact prod_congr rfl (fun g _ => hcard (t g) (u g))

/-- The uniform pointwise pushforward identity holds for every function
of the full output tuple, with no separability assumption. -/
theorem uniform_pointwise_average_of_equal_fiber_card {G Ω T : Type*}
    [Fintype G] [Fintype Ω] [Nonempty Ω] [Fintype T] [DecidableEq T]
    (q : Ω → T)
    (hcard : ∀ t u : T, Fintype.card {a : Ω // q a = t} = Fintype.card {a : Ω // q a = u})
    (f : (G → T) → ℝ) :
    (∑ a : G → Ω, f (fun g => q (a g))) / (Fintype.card (G → Ω) : ℝ) =
      (∑ t : G → T, f t) / ((Fintype.card T) ^ Fintype.card G : ℕ) := by
  have h := uniform_average_of_equal_fiber_card
    (Ω := G → Ω) (T := G → T) (fun a g => q (a g))
    (fun t u => pointwise_map_fiber_card_eq q hcard t u) f
  simpa only [Fintype.card_pi, prod_const, card_univ] using h

/-- A simultaneous omission choice in every group. -/
abbrev GroupedOmissionSubsets (G α : Type*) [Fintype α] (ell : ℕ) :=
  G → UniformOmissionSubsets α ell

/-- Independent permutations act on the fixed omission slots groupwise. -/
def groupedPermutedOmissions {G α : Type*} [Fintype α] {ell : ℕ}
    (s : Finset α) (hs : s.card = ell) (σ : G → Equiv.Perm α) :
    GroupedOmissionSubsets G α ell := fun g => permutedOmissionSubset s hs (σ g)

/-- The number of simultaneous omission tuples is the binomial count
raised to the number of groups. -/
theorem grouped_omission_subsets_card (G α : Type*) [Fintype G] [Fintype α] (ell : ℕ) :
    Fintype.card (GroupedOmissionSubsets G α ell) =
      ((Fintype.card α).choose ell) ^ Fintype.card G := by
  simp only [GroupedOmissionSubsets, Fintype.card_pi, uniform_omission_subsets_card,
    prod_const, card_univ]

/-- The exact joint averaging identity for independent group permutations. -/
theorem grouped_uniform_omission_average {G α : Type*} [Fintype G] [Fintype α] {ell : ℕ}
    (s : Finset α) (hs : s.card = ell) (f : GroupedOmissionSubsets G α ell → ℝ) :
    (∑ σ : G → Equiv.Perm α, f (groupedPermutedOmissions s hs σ)) /
        (Fintype.card (G → Equiv.Perm α) : ℝ) =
      (∑ t : GroupedOmissionSubsets G α ell, f t) /
        (((Fintype.card α).choose ell) ^ Fintype.card G : ℕ) := by
  unfold groupedPermutedOmissions
  have h := uniform_pointwise_average_of_equal_fiber_card
    (G := G) (Ω := Equiv.Perm α) (T := UniformOmissionSubsets α ell)
    (permutedOmissionSubset s hs) (fun t u => permuted_omission_fiber_card_eq s hs t u) f
  simpa only [uniform_omission_subsets_card] using h

/-- The bad-omission fraction remains exact for arbitrary joint bad sets. -/
theorem grouped_uniform_bad_omission_fraction {G α : Type*} [Fintype G] [Fintype α] {ell : ℕ}
    (s : Finset α) (hs : s.card = ell) (bad : Finset (GroupedOmissionSubsets G α ell)) :
    ((univ.filter (fun σ : G → Equiv.Perm α => groupedPermutedOmissions s hs σ ∈ bad)).card : ℝ) /
        (Fintype.card (G → Equiv.Perm α) : ℝ) =
      (bad.card : ℝ) / (((Fintype.card α).choose ell) ^ Fintype.card G : ℕ) := by
  have h := grouped_uniform_omission_average s hs (fun t => if t ∈ bad then 1 else 0)
  simpa only [sum_boole, filter_mem_eq_inter, univ_inter] using h

/-- Any joint bad-set cardinality bound therefore transfers to the actual
uniform law on independent groupwise permutations. -/
theorem grouped_uniform_bad_omission_fraction_le {G α : Type*} [Fintype G] [Fintype α] {ell : ℕ}
    (s : Finset α) (hs : s.card = ell) (bad : Finset (GroupedOmissionSubsets G α ell))
    (B : ℕ) (hbad : bad.card ≤ B) :
    ((univ.filter (fun σ : G → Equiv.Perm α => groupedPermutedOmissions s hs σ ∈ bad)).card : ℝ) /
        (Fintype.card (G → Equiv.Perm α) : ℝ) ≤
      (B : ℝ) / (((Fintype.card α).choose ell) ^ Fintype.card G : ℕ) := by
  rw [grouped_uniform_bad_omission_fraction]
  exact div_le_div_of_nonneg_right (by exact_mod_cast hbad) (Nat.cast_nonneg _)
end

section
open Filter
open scoped Topology
theorem integral_one_div_mul_log {A B : ℝ} (hA : 1 < A) (hAB : A ≤ B) :
    (∫ x in A..B, 1 / (x * Real.log x)) = Real.log (Real.log B) - Real.log (Real.log A) := by
  simpa only [one_div, mul_inv, div_eq_mul_inv, one_mul] using
    integral_inv_div_log hA (hA.trans_le hAB)

theorem integral_one_div_mul_log_exp {t lam : ℝ} (ht : 0 < t) (hlam : 1 ≤ lam) :
    (∫ x in Real.exp t..Real.exp (lam * t), 1 / (x * Real.log x)) = Real.log lam := by
  rw [integral_one_div_mul_log (Real.one_lt_exp_iff.mpr ht)
    (Real.exp_le_exp.mpr (le_mul_of_one_le_left ht.le hlam)), Real.log_exp, Real.log_exp,
    Real.log_mul (by positivity) ht.ne']
  ring

theorem prime_counting_lower_constant_pos : 0 < Real.log 2 / 2 := by positivity

theorem prime_counting_upper_constant_pos : 0 < Real.log 4 + 1 := by positivity

theorem eventually_primeCounting_chebyshev_bounds :
    ∀ᶠ x : ℝ in atTop,
      (Real.log 2 / 2) * x / Real.log x ≤ (Nat.primeCounting ⌊x⌋₊ : ℝ) ∧
      (Nat.primeCounting ⌊x⌋₊ : ℝ) ≤ (Real.log 4 + 1) * x / Real.log x := by
  have hlog : Tendsto (fun x : ℝ => Real.log (x + 2) / x) atTop (𝓝 0) := by
    simpa only [Function.comp_def, id_eq, pow_one, one_mul, add_neg_cancel_right] using
      (Real.tendsto_pow_log_div_mul_add_atTop 1 (-2) 1 one_ne_zero).comp
        (tendsto_atTop_add_const_right atTop (2 : ℝ) tendsto_id)
  have hsmall : ∀ᶠ x : ℝ in atTop, Real.log (x + 2) / x < Real.log 2 / 4 :=
    hlog.eventually_lt_const (by positivity)
  filter_upwards [hsmall, eventually_ge_atTop (4 : ℝ),
    Chebyshev.eventually_primeCounting_le (show (0 : ℝ) < 1 by norm_num)] with x hx hx4 hupper
  refine ⟨?_, hupper⟩
  have hx0 : 0 < x := by linarith
  have hx1 : 1 < x := by linarith
  have hlog2 : 0 < Real.log 2 := by positivity
  have hsmall' := (div_lt_iff₀ hx0).mp hx
  apply le_trans ?_ (Chebyshev.pi_ge' hx1)
  apply div_le_div_of_nonneg_right _ (Real.log_pos hx1).le
  nlinarith
end

section
open Finset MeasureTheory
open Filter
open scoped Topology
noncomputable def primeBand (A B : ℝ) : Finset ℕ :=
  (Ioc ⌊A⌋₊ ⌊B⌋₊).filter Nat.Prime

noncomputable def primeBandHarmonic (A B : ℝ) : ℝ :=
  ∑ p ∈ primeBand A B, 1 / (p : ℝ)

noncomputable def primeCountingReal (x : ℝ) : ℝ :=
  (Nat.primeCounting ⌊x⌋₊ : ℝ)

theorem mem_primeBand_iff {A B : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (p : ℕ) :
    p ∈ primeBand A B ↔ p.Prime ∧ A < (p : ℝ) ∧ (p : ℝ) ≤ B := by
  simp only [primeBand, mem_filter, mem_Ioc, Nat.floor_lt hA, Nat.le_floor_iff hB]
  tauto

theorem primeCountingReal_eq_sum (x : ℝ) :
    primeCountingReal x = ∑ n ∈ Icc 0 ⌊x⌋₊, if n.Prime then (1 : ℝ) else 0 := by
  rw [sum_boole]
  simp only [primeCountingReal, Nat.primeCounting, Nat.primeCounting',
    Nat.count_eq_card_filter_range, Nat.range_succ_eq_Icc_zero]

theorem primeBandHarmonic_nonneg (A B : ℝ) : 0 ≤ primeBandHarmonic A B := by
  exact sum_nonneg (fun _ _ => by positivity)

theorem primeCountingReal_nonneg (x : ℝ) : 0 ≤ primeCountingReal x := by
  exact Nat.cast_nonneg _

theorem prime_counting_quotient_intervalIntegrable {A B : ℝ} (hA : 0 < A) (hAB : A ≤ B) :
    IntervalIntegrable (fun t => primeCountingReal t / t^2) volume A B := by
  rw [intervalIntegrable_iff_integrableOn_Icc_of_le hAB]
  have hg : IntegrableOn (fun t : ℝ => (t^2)⁻¹) (Set.Icc A B) := by
    apply ContinuousOn.integrableOn_Icc
    intro t ht
    have ht0 : t ≠ 0 := ne_of_gt (hA.trans_le ht.1)
    have ht2 : t^2 ≠ 0 := pow_ne_zero 2 ht0
    fun_prop
  have h := integrableOn_mul_sum_Icc (fun n => if n.Prime then (1 : ℝ) else 0) hA.le hg (m := 0)
  simpa only [← primeCountingReal_eq_sum, div_eq_mul_inv, mul_comm] using h

/-- Exact partial summation on a real prime interval. -/
theorem primeBandHarmonic_eq_abel {A B : ℝ} (hA : 0 < A) (hAB : A ≤ B) :
    primeBandHarmonic A B = primeCountingReal B / B - primeCountingReal A / A +
      ∫ t in A..B, primeCountingReal t / t^2 := by
  let c : ℕ → ℝ := fun n => if n.Prime then 1 else 0
  have hc (x : ℝ) : (∑ n ∈ Icc 0 ⌊x⌋₊, c n) = primeCountingReal x :=
    (primeCountingReal_eq_sum x).symm
  have hd : ∀ t ∈ Set.Icc A B, DifferentiableAt ℝ (fun t : ℝ => t⁻¹) t := by
    intro t ht
    have ht0 : t ≠ 0 := ne_of_gt (hA.trans_le ht.1)
    fun_prop
  have hi : IntegrableOn (deriv (fun t : ℝ => t⁻¹)) (Set.Icc A B) := by
    simp only [deriv_inv']
    apply ContinuousOn.integrableOn_Icc
    intro t ht
    have ht0 : t ≠ 0 := ne_of_gt (hA.trans_le ht.1)
    have ht2 : t^2 ≠ 0 := pow_ne_zero 2 ht0
    fun_prop
  have hs := sum_mul_eq_sub_sub_integral_mul c hA.le hAB hd hi
  have hl : (∑ n ∈ Ioc ⌊A⌋₊ ⌊B⌋₊, (n : ℝ)⁻¹ * c n) = primeBandHarmonic A B := by
    simp only [primeBandHarmonic, primeBand, sum_filter, c, mul_ite, mul_one, mul_zero, one_div]
  have he : (fun t : ℝ => deriv (fun t : ℝ => t⁻¹) t * ∑ n ∈ Icc 0 ⌊t⌋₊, c n) =
      (fun t => -(primeCountingReal t / t^2)) := by
    funext t
    rw [deriv_inv, hc]
    ring
  rw [hl, hc, hc, he, integral_neg, ← intervalIntegral.integral_of_le hAB, sub_neg_eq_add] at hs
  simpa only [div_eq_mul_inv, mul_comm] using hs

/-- Uniform prime-counting bounds give reciprocal prime mass bounds, retaining
only the two endpoint errors and one elementary logarithmic integral. -/
theorem primeBandHarmonic_bounds_of_counting {A B a b : ℝ}
    (hA : 1 < A) (hAB : A ≤ B)
    (hlower : ∀ t ∈ Set.Icc A B, a * t / Real.log t ≤ primeCountingReal t)
    (hupper : ∀ t ∈ Set.Icc A B, primeCountingReal t ≤ b * t / Real.log t) :
    a * (∫ t in A..B, 1 / (t * Real.log t)) - b / Real.log A ≤ primeBandHarmonic A B ∧
      primeBandHarmonic A B ≤
        b * (∫ t in A..B, 1 / (t * Real.log t)) + b / Real.log B := by
  have hA0 : 0 < A := lt_trans zero_lt_one hA
  have hB0 : 0 < B := hA0.trans_le hAB
  have hlogint : IntervalIntegrable (fun t : ℝ => 1 / (t * Real.log t)) volume A B := by
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le hAB]
    apply ContinuousOn.integrableOn_Icc
    intro t ht
    have ht1 : 1 < t := hA.trans_le ht.1
    have ht0 : t ≠ 0 := ne_of_gt (lt_trans zero_lt_one ht1)
    have hlog0 : Real.log t ≠ 0 := ne_of_gt (Real.log_pos ht1)
    have hprod0 : t * Real.log t ≠ 0 := mul_ne_zero ht0 hlog0
    fun_prop
  have hpiint := prime_counting_quotient_intervalIntegrable hA0 hAB
  have hloint :
      a * (∫ t in A..B, 1 / (t * Real.log t)) ≤
        ∫ t in A..B, primeCountingReal t / t^2 := by
    rw [← intervalIntegral.integral_const_mul]
    apply intervalIntegral.integral_mono_on hAB (hlogint.const_mul a) hpiint
    intro t ht
    have ht0 : t ≠ 0 := ne_of_gt (hA0.trans_le ht.1)
    have he : a * (1 / (t * Real.log t)) = (a * t / Real.log t) / t^2 := by
      field_simp
    rw [he]
    exact div_le_div_of_nonneg_right (hlower t ht) (sq_nonneg t)
  have hupint :
      (∫ t in A..B, primeCountingReal t / t^2) ≤
        b * (∫ t in A..B, 1 / (t * Real.log t)) := by
    rw [← intervalIntegral.integral_const_mul]
    apply intervalIntegral.integral_mono_on hAB hpiint (hlogint.const_mul b)
    intro t ht
    have ht0 : t ≠ 0 := ne_of_gt (hA0.trans_le ht.1)
    have he : b * (1 / (t * Real.log t)) = (b * t / Real.log t) / t^2 := by
      field_simp
    rw [he]
    exact div_le_div_of_nonneg_right (hupper t ht) (sq_nonneg t)
  have hleft : primeCountingReal A / A ≤ b / Real.log A := by
    apply (div_le_iff₀ hA0).mpr
    calc
      primeCountingReal A ≤ b * A / Real.log A := hupper A ⟨le_rfl, hAB⟩
      _ = (b / Real.log A) * A := by ring
  have hright : primeCountingReal B / B ≤ b / Real.log B := by
    apply (div_le_iff₀ hB0).mpr
    calc
      primeCountingReal B ≤ b * B / Real.log B := hupper B ⟨hAB, le_rfl⟩
      _ = (b / Real.log B) * B := by ring
  have hleft0 : 0 ≤ primeCountingReal A / A := div_nonneg (primeCountingReal_nonneg A) hA0.le
  have hright0 : 0 ≤ primeCountingReal B / B := div_nonneg (primeCountingReal_nonneg B) hB0.le
  rw [primeBandHarmonic_eq_abel hA0 hAB]
  constructor <;> linarith

theorem primeBandHarmonic_exp_bounds_of_counting {t lam a b : ℝ}
    (ht : 0 < t) (hlam : 1 ≤ lam)
    (hlower : ∀ u ∈ Set.Icc (Real.exp t) (Real.exp (lam * t)),
      a * u / Real.log u ≤ primeCountingReal u)
    (hupper : ∀ u ∈ Set.Icc (Real.exp t) (Real.exp (lam * t)),
      primeCountingReal u ≤ b * u / Real.log u) :
    a * Real.log lam - b / t ≤ primeBandHarmonic (Real.exp t) (Real.exp (lam * t)) ∧
      primeBandHarmonic (Real.exp t) (Real.exp (lam * t)) ≤
        b * Real.log lam + b / (lam * t) := by
  have h := primeBandHarmonic_bounds_of_counting (Real.one_lt_exp_iff.mpr ht)
    (Real.exp_le_exp.mpr (le_mul_of_one_le_left ht.le hlam)) hlower hupper
  simpa only [integral_one_div_mul_log_exp ht hlam, Real.log_exp] using h

/-- Positive two-sided Chebyshev constants already suffice for uniform
reciprocal prime mass in every fixed-ratio logarithmic band. -/
theorem eventually_primeBandHarmonic_bounds_of_counting {a b lam : ℝ}
    (ha : 0 < a) (hb : 0 < b) (hlam : 1 < lam)
    (hcount : ∀ᶠ u : ℝ in atTop,
      a * u / Real.log u ≤ primeCountingReal u ∧
        primeCountingReal u ≤ b * u / Real.log u) :
    ∀ᶠ t : ℝ in atTop,
      a * Real.log lam / 2 ≤ primeBandHarmonic (Real.exp t) (Real.exp (lam * t)) ∧
        primeBandHarmonic (Real.exp t) (Real.exp (lam * t)) ≤ 2 * b * Real.log lam := by
  obtain ⟨u0, hu0⟩ := eventually_atTop.1 hcount
  have hlog : 0 < Real.log lam := Real.log_pos hlam
  filter_upwards [eventually_ge_atTop (1 : ℝ), eventually_ge_atTop u0,
    eventually_ge_atTop (2 * b / (a * Real.log lam)),
    eventually_ge_atTop (1 / Real.log lam)] with t ht1 htu htl hth
  have ht : 0 < t := zero_lt_one.trans_le ht1
  have hu : u0 ≤ Real.exp t := htu.trans (by linarith [Real.add_one_le_exp t])
  have hband := primeBandHarmonic_exp_bounds_of_counting ht hlam.le
    (fun u hmem => (hu0 u (hu.trans hmem.1)).1)
    (fun u hmem => (hu0 u (hu.trans hmem.1)).2)
  have hlo : b / t ≤ a * Real.log lam / 2 := by
    have h := (div_le_iff₀ (mul_pos ha hlog)).mp htl
    apply (div_le_iff₀ ht).mpr
    nlinarith
  have hhi : b / (lam * t) ≤ b * Real.log lam := by
    have h := (div_le_iff₀ hlog).mp hth
    have hlt : t ≤ lam * t := le_mul_of_one_le_left ht.le hlam.le
    have hh : 1 ≤ Real.log lam * (lam * t) := by nlinarith
    apply (div_le_iff₀ (mul_pos (zero_lt_one.trans hlam) ht)).mpr
    nlinarith [mul_nonneg hb.le (sub_nonneg.mpr hh)]
  constructor <;> linarith [hband.1, hband.2]

/-- The required fixed-ratio prime-band bounds are unconditional consequences
of the elementary Chebyshev estimates. -/
theorem eventually_primeBandHarmonic_bounds {lam : ℝ} (hlam : 1 < lam) :
    ∀ᶠ t : ℝ in atTop,
      (Real.log 2 / 2) * Real.log lam / 2 ≤
        primeBandHarmonic (Real.exp t) (Real.exp (lam * t)) ∧
      primeBandHarmonic (Real.exp t) (Real.exp (lam * t)) ≤
        2 * (Real.log 4 + 1) * Real.log lam := by
  apply eventually_primeBandHarmonic_bounds_of_counting
    prime_counting_lower_constant_pos prime_counting_upper_constant_pos hlam
  exact eventually_primeCounting_chebyshev_bounds

theorem exists_primeBandHarmonic_bounds {lam : ℝ} (hlam : 1 < lam) :
    ∃ vmin vmax : ℝ, 0 < vmin ∧ 0 < vmax ∧ ∀ᶠ t : ℝ in atTop,
      vmin ≤ primeBandHarmonic (Real.exp t) (Real.exp (lam * t)) ∧
        primeBandHarmonic (Real.exp t) (Real.exp (lam * t)) ≤ vmax := by
  refine ⟨(Real.log 2 / 2) * Real.log lam / 2,
    2 * (Real.log 4 + 1) * Real.log lam, ?_, ?_, eventually_primeBandHarmonic_bounds hlam⟩
  · exact div_pos (mul_pos prime_counting_lower_constant_pos (Real.log_pos hlam)) (by norm_num)
  · exact mul_pos (mul_pos (by norm_num) prime_counting_upper_constant_pos) (Real.log_pos hlam)

theorem exists_primeBandHarmonic_threshold {lam : ℝ} (hlam : 1 < lam) :
    ∃ vmin vmax t0 : ℝ, 0 < vmin ∧ 0 < vmax ∧ 0 < t0 ∧
      ∀ t : ℝ, t0 ≤ t →
        vmin ≤ primeBandHarmonic (Real.exp t) (Real.exp (lam * t)) ∧
          primeBandHarmonic (Real.exp t) (Real.exp (lam * t)) ≤ vmax := by
  obtain ⟨vmin, vmax, hvmin, hvmax, hevent⟩ := exists_primeBandHarmonic_bounds hlam
  obtain ⟨t0, ht0⟩ := eventually_atTop.1 hevent
  refine ⟨vmin, vmax, max 1 t0, hvmin, hvmax,
    zero_lt_one.trans_le (le_max_left _ _), ?_⟩
  intro t ht
  exact ht0 t ((le_max_right _ _).trans ht)
end

section
open Finset
theorem primeBand_subset_of_bounds {A B C D : ℝ}
    (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C) (hD : 0 ≤ D)
    (hCA : C ≤ A) (hBD : B ≤ D) : primeBand A B ⊆ primeBand C D := by
  intro p hp
  obtain ⟨hp, hAp, hpB⟩ := (mem_primeBand_iff hA hB p).mp hp
  exact (mem_primeBand_iff hC hD p).mpr ⟨hp, hCA.trans_lt hAp, hpB.trans hBD⟩

theorem disjoint_primeBand_of_le {A B C D : ℝ}
    (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C) (hD : 0 ≤ D)
    (hBC : B ≤ C) : Disjoint (primeBand A B) (primeBand C D) := by
  apply disjoint_left.mpr
  intro p hp hq
  have hpB := ((mem_primeBand_iff hA hB p).mp hp).2.2
  have hCp := ((mem_primeBand_iff hC hD p).mp hq).2.1
  exact (not_lt_of_ge (hpB.trans hBC)) hCp

noncomputable def dyadicPrimeBand (s lower upper : ℝ) (j : ℕ) : Finset ℕ :=
  primeBand (Real.exp (lower * s / 2^j)) (Real.exp (upper * s / 2^j))

theorem mem_dyadicPrimeBand_iff (s lower upper : ℝ) (j p : ℕ) :
    p ∈ dyadicPrimeBand s lower upper j ↔
      p.Prime ∧ Real.exp (lower * s / 2^j) < (p : ℝ) ∧
        (p : ℝ) ≤ Real.exp (upper * s / 2^j) := by
  exact mem_primeBand_iff (Real.exp_pos _).le (Real.exp_pos _).le p

theorem dyadic_band_endpoint_le {s lower upper : ℝ} {i j : ℕ}
    (hs : 0 ≤ s) (hlower : 0 ≤ lower) (hgap : upper ≤ 2 * lower) (hij : i < j) :
    upper * s / 2^j ≤ lower * s / 2^i := by
  apply (div_le_div_iff₀ (by positivity : (0 : ℝ) < 2^j)
    (by positivity : (0 : ℝ) < 2^i)).mpr
  have hp : (2 : ℝ)^(i+1) ≤ 2^j := pow_le_pow_right₀ (by norm_num) hij
  have hmul := mul_le_mul_of_nonneg_left hp (mul_nonneg hlower hs)
  have hbound := mul_le_mul_of_nonneg_right hgap (mul_nonneg hs (by positivity : (0 : ℝ) ≤ 2^i))
  rw [pow_succ] at hmul
  nlinarith

theorem disjoint_dyadicPrimeBand_of_lt {s lower upper : ℝ} {i j : ℕ}
    (hs : 0 ≤ s) (hlower : 0 ≤ lower) (hgap : upper ≤ 2 * lower) (hij : i < j) :
    Disjoint (dyadicPrimeBand s lower upper i) (dyadicPrimeBand s lower upper j) := by
  apply Disjoint.symm
  apply disjoint_primeBand_of_le (Real.exp_pos _).le (Real.exp_pos _).le
    (Real.exp_pos _).le (Real.exp_pos _).le
  exact Real.exp_le_exp.mpr (dyadic_band_endpoint_le hs hlower hgap hij)

theorem pairwise_disjoint_dyadicPrimeBand {s lower upper : ℝ}
    (hs : 0 ≤ s) (hlower : 0 ≤ lower) (hgap : upper ≤ 2 * lower) :
    Pairwise (fun i j : ℕ => Disjoint (dyadicPrimeBand s lower upper i)
      (dyadicPrimeBand s lower upper j)) := by
  intro i j hij
  rcases lt_or_gt_of_ne hij with hij | hji
  · exact disjoint_dyadicPrimeBand_of_lt hs hlower hgap hij
  · exact (disjoint_dyadicPrimeBand_of_lt hs hlower hgap hji).symm

theorem dyadicPrimeBand_subset_of_bounds {s lower upper lower' upper' : ℝ} (j : ℕ)
    (hs : 0 ≤ s) (hlower : lower' ≤ lower) (hupper : upper ≤ upper') :
    dyadicPrimeBand s lower upper j ⊆ dyadicPrimeBand s lower' upper' j := by
  apply primeBand_subset_of_bounds (Real.exp_pos _).le (Real.exp_pos _).le
    (Real.exp_pos _).le (Real.exp_pos _).le
  · apply Real.exp_le_exp.mpr
    exact div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right hlower hs) (by positivity)
  · apply Real.exp_le_exp.mpr
    exact div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right hupper hs) (by positivity)

theorem disjoint_dyadicPrimeBand_of_separated {s a b c d : ℝ} (j : ℕ)
    (hs : 0 ≤ s) (hbc : b ≤ c) :
    Disjoint (dyadicPrimeBand s a b j) (dyadicPrimeBand s c d j) := by
  apply disjoint_primeBand_of_le (Real.exp_pos _).le (Real.exp_pos _).le
    (Real.exp_pos _).le (Real.exp_pos _).le
  apply Real.exp_le_exp.mpr
  exact div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right hbc hs) (by positivity)

noncomputable def candidateQBand (s : ℝ) (j : ℕ) : Finset ℕ :=
  dyadicPrimeBand s 1 (6/5) j

noncomputable def candidatePBand (s : ℝ) (j : ℕ) : Finset ℕ :=
  dyadicPrimeBand s (3/2) (9/5) j

noncomputable def candidatePrimeBand (s : ℝ) (a : ℕ × Bool) : Finset ℕ :=
  if a.2 then candidatePBand s a.1 else candidateQBand s a.1

theorem candidatePrimeBand_subset_outer {s : ℝ} (hs : 0 ≤ s) (a : ℕ × Bool) :
    candidatePrimeBand s a ⊆ dyadicPrimeBand s 1 (9/5) a.1 := by
  rcases a with ⟨j, u⟩
  cases u <;> simp only [candidatePrimeBand, Bool.false_eq_true, ↓reduceIte,
    candidateQBand, candidatePBand]
  · exact dyadicPrimeBand_subset_of_bounds j hs (by norm_num) (by norm_num)
  · exact dyadicPrimeBand_subset_of_bounds j hs (by norm_num) (by norm_num)

theorem pairwise_disjoint_candidatePrimeBand {s : ℝ} (hs : 0 ≤ s) :
    Pairwise (fun a b : ℕ × Bool => Disjoint (candidatePrimeBand s a)
      (candidatePrimeBand s b)) := by
  intro a b hab
  by_cases h : a.1 = b.1
  · rcases a with ⟨i, u⟩
    rcases b with ⟨j, v⟩
    simp only at h
    subst j
    cases u <;> cases v
    · exact (hab rfl).elim
    · exact disjoint_dyadicPrimeBand_of_separated i hs (by norm_num)
    · exact (disjoint_dyadicPrimeBand_of_separated i hs (by norm_num : (6/5 : ℝ) ≤ 3/2)).symm
    · exact (hab rfl).elim
  · exact (pairwise_disjoint_dyadicPrimeBand hs (by norm_num) (by norm_num : (9/5 : ℝ) ≤ 2*1) h).mono
      (candidatePrimeBand_subset_outer hs a) (candidatePrimeBand_subset_outer hs b)

theorem disjoint_candidatePBand_candidateQBand {s : ℝ} (hs : 0 ≤ s) (i j : ℕ) :
    Disjoint (candidatePBand s i) (candidateQBand s j) := by
  exact pairwise_disjoint_candidatePrimeBand hs
    (show (i, true) ≠ (j, false) by intro h; cases Prod.mk.inj h |>.2)

theorem disjoint_candidate_prime_pools {s : ℝ} (hs : 0 ≤ s) (I J : Finset ℕ) :
    Disjoint (I.biUnion (candidatePBand s)) (J.biUnion (candidateQBand s)) := by
  apply disjoint_left.mpr
  intro p hp hq
  obtain ⟨i, _, hpi⟩ := mem_biUnion.mp hp
  obtain ⟨j, _, hpj⟩ := mem_biUnion.mp hq
  exact disjoint_left.mp (disjoint_candidatePBand_candidateQBand hs i j) hpi hpj

theorem dyadicPrimeBand_prime_range {s lower upper A B : ℝ} {j p : ℕ}
    (hp : p ∈ dyadicPrimeBand s lower upper j)
    (hA : A ≤ lower * s / 2^j) (hB : upper * s / 2^j ≤ B) :
    p.Prime ∧ Real.exp A < (p : ℝ) ∧ (p : ℝ) ≤ Real.exp B := by
  obtain ⟨hp, hl, hu⟩ := (mem_dyadicPrimeBand_iff s lower upper j p).mp hp
  exact ⟨hp, (Real.exp_le_exp.mpr hA).trans_lt hl, hu.trans (Real.exp_le_exp.mpr hB)⟩

theorem dyadicPrimeBand_eq_log_ratio (s lower upper : ℝ) (j : ℕ) (hlower : lower ≠ 0) :
    dyadicPrimeBand s lower upper j =
      primeBand (Real.exp (lower * s / 2^j))
        (Real.exp ((upper / lower) * (lower * s / 2^j))) := by
  have h : (upper / lower) * (lower * s / 2^j) = upper * s / 2^j := by
    field_simp
  rw [h]
  rfl

theorem dyadicPrimeBand_harmonic_eq_log_ratio (s lower upper : ℝ) (j : ℕ)
    (hlower : lower ≠ 0) :
    (∑ p ∈ dyadicPrimeBand s lower upper j, 1 / (p : ℝ)) =
      primeBandHarmonic (Real.exp (lower * s / 2^j))
        (Real.exp ((upper / lower) * (lower * s / 2^j))) := by
  rw [dyadicPrimeBand_eq_log_ratio s lower upper j hlower]
  rfl
end

section
open Finset
noncomputable def dyadicGroupIndices (s lower upper A B : ℝ) : Finset ℕ :=
  Icc (Nat.ceil (Real.log (upper * s / B) / Real.log 2))
    (Nat.floor (Real.log (lower * s / A) / Real.log 2))

theorem dyadic_scale_bounds_of_log_bounds {s lower upper A B : ℝ} {j : ℕ}
    (hs : 0 < s) (hlower : 0 < lower) (hupper : 0 < upper)
    (hA : 0 < A) (hB : 0 < B)
    (hjLower : Real.log (upper * s / B) / Real.log 2 ≤ j)
    (hjUpper : (j : ℝ) ≤ Real.log (lower * s / A) / Real.log 2) :
    A ≤ lower * s / 2^j ∧ upper * s / 2^j ≤ B := by
  have htwo : (0 : ℝ) < Real.log 2 := Real.log_pos (by norm_num)
  have hp : (0 : ℝ) < 2^j := by positivity
  have hupper' := (div_le_iff₀ htwo).mp hjLower
  have hlower' := (le_div_iff₀ htwo).mp hjUpper
  rw [← Real.log_pow] at hupper' hlower'
  have hu := (Real.log_le_log_iff (by positivity : 0 < upper * s / B) hp).mp hupper'
  have hl := (Real.log_le_log_iff hp (by positivity : 0 < lower * s / A)).mp hlower'
  constructor
  · apply (le_div_iff₀ hp).mpr
    simpa only [mul_comm] using (le_div_iff₀ hA).mp hl
  · apply (div_le_iff₀ hp).mpr
    simpa only [mul_comm] using (div_le_iff₀ hB).mp hu

theorem dyadic_scale_bounds_of_mem {s lower upper A B : ℝ} {j : ℕ}
    (hs : 0 < s) (hlower : 0 < lower) (hupper : 0 < upper)
    (hA : 0 < A) (hB : 0 < B)
    (hNonneg : 0 ≤ Real.log (lower * s / A) / Real.log 2)
    (hj : j ∈ dyadicGroupIndices s lower upper A B) :
    A ≤ lower * s / 2^j ∧ upper * s / 2^j ≤ B := by
  obtain ⟨hjLower, hjUpper⟩ := mem_Icc.mp hj
  exact dyadic_scale_bounds_of_log_bounds hs hlower hupper hA hB
    (Nat.ceil_le.mp hjLower) ((Nat.le_floor_iff hNonneg).mp hjUpper)

theorem dyadicPrimeBand_prime_range_of_index {s lower upper A B : ℝ} {j p : ℕ}
    (hs : 0 < s) (hlower : 0 < lower) (hupper : 0 < upper)
    (hA : 0 < A) (hB : 0 < B)
    (hNonneg : 0 ≤ Real.log (lower * s / A) / Real.log 2)
    (hj : j ∈ dyadicGroupIndices s lower upper A B)
    (hp : p ∈ dyadicPrimeBand s lower upper j) :
    p.Prime ∧ Real.exp A < (p : ℝ) ∧ (p : ℝ) ≤ Real.exp B := by
  obtain ⟨hl, hu⟩ := dyadic_scale_bounds_of_mem hs hlower hupper hA hB hNonneg hj
  exact dyadicPrimeBand_prime_range hp hl hu
end

section
open Filter Finset
open scoped Topology
/-- Rounding the endpoints of a nonnegative real interval changes its
natural-index count from its length by at most one. -/
theorem nat_ceil_floor_Icc_card_bounds {u v : ℝ} (hu : 0 ≤ u) (huv : u ≤ v) :
    v - u - 1 ≤ ((Icc (Nat.ceil u) (Nat.floor v)).card : ℝ) ∧
      ((Icc (Nat.ceil u) (Nat.floor v)).card : ℝ) ≤ v - u + 1 := by
  have hc := Nat.le_ceil u
  have hc' := Nat.ceil_lt_add_one hu
  have hf := Nat.floor_le (hu.trans huv)
  have hf' := Nat.lt_floor_add_one v
  have hsub : Nat.ceil u ≤ Nat.floor v + 1 :=
    (Nat.ceil_le).mpr (by exact_mod_cast huv.trans hf'.le)
  rw [Nat.card_Icc, Nat.cast_sub hsub, Nat.cast_add, Nat.cast_one]
  constructor <;> linarith

theorem nat_ceil_floor_Icc_card_error {u v : ℝ} (hu : 0 ≤ u) (huv : u ≤ v) :
    |((Icc (Nat.ceil u) (Nat.floor v)).card : ℝ) - (v - u)| ≤ 1 := by
  obtain ⟨hlo, hhi⟩ := nat_ceil_floor_Icc_card_bounds hu huv
  exact abs_le.mpr ⟨by linarith, by linarith⟩

/-- Any positive logarithmic gap yields a number of natural indices
comparable to log L; fixed endpoint offsets only affect the threshold. -/
theorem eventually_log_affine_index_count {A B : ℝ}
    (hA : 0 < A) (hAB : A < B) (a b : ℝ) :
    ∀ᶠ L : ℝ in atTop,
      ((B - A) / 2) * Real.log L ≤
          ((Icc (Nat.ceil (A * Real.log L + a))
            (Nat.floor (B * Real.log L + b))).card : ℝ) ∧
      ((Icc (Nat.ceil (A * Real.log L + a))
            (Nat.floor (B * Real.log L + b))).card : ℝ) ≤
          (2 * (B - A)) * Real.log L := by
  have hleft : Tendsto (fun L : ℝ => A * Real.log L) atTop atTop :=
    Tendsto.const_mul_atTop hA Real.tendsto_log_atTop
  have hgap : Tendsto (fun L : ℝ => (B - A) * Real.log L) atTop atTop :=
    Tendsto.const_mul_atTop (sub_pos.mpr hAB) Real.tendsto_log_atTop
  filter_upwards [hleft.eventually (eventually_ge_atTop (-a)),
    hgap.eventually (eventually_ge_atTop (2 * (|b - a| + 1)))] with L hl hg
  have habs₁ := le_abs_self (b - a)
  have habs₂ := neg_abs_le (b - a)
  have hu : 0 ≤ A * Real.log L + a := by linarith
  have huv : A * Real.log L + a ≤ B * Real.log L + b := by nlinarith
  obtain ⟨hlo, hhi⟩ := nat_ceil_floor_Icc_card_bounds hu huv
  constructor <;> nlinarith

/-- The endpoint index of a geometric scale is affine in log L. -/
theorem geometric_log_index_eq {c s L : ℝ} (hc : 0 < c) (hs : 0 < s)
    (hL : 0 < L) (γ : ℝ) :
    Real.log (c * (s * L) / L^γ) / Real.log 2 =
      ((1 - γ) / Real.log 2) * Real.log L + Real.log (c * s) / Real.log 2 := by
  have hp : c * (s * L) = (c * s) * L := by ring
  rw [hp, Real.log_div (by positivity) (by positivity),
    Real.log_mul (by positivity) (by positivity), Real.log_rpow hL]
  ring

/-- The dyadic index interval for a power band contains a positive
constant times log L indices and at most a constant times log L indices. -/
theorem eventually_geometric_log_index_count {α β s c₃ c₄ : ℝ}
    (hαβ : α < β) (hβ : β < 1) (hs : 0 < s) (hc₃ : 0 < c₃) (hc₄ : 0 < c₄) :
    ∀ᶠ L : ℝ in atTop,
      ((β - α) / (2 * Real.log 2)) * Real.log L ≤
          ((Icc (Nat.ceil (Real.log (c₄ * (s * L) / L^β) / Real.log 2))
            (Nat.floor (Real.log (c₃ * (s * L) / L^α) / Real.log 2))).card : ℝ) ∧
      ((Icc (Nat.ceil (Real.log (c₄ * (s * L) / L^β) / Real.log 2))
            (Nat.floor (Real.log (c₃ * (s * L) / L^α) / Real.log 2))).card : ℝ) ≤
          (2 * (β - α) / Real.log 2) * Real.log L := by
  have hlog : 0 < Real.log (2 : ℝ) := Real.log_pos (by norm_num)
  have hA : 0 < (1 - β) / Real.log 2 := div_pos (by linarith) hlog
  have hAB : (1 - β) / Real.log 2 < (1 - α) / Real.log 2 :=
    (div_lt_div_iff_of_pos_right hlog).mpr (by linarith)
  have hcount := eventually_log_affine_index_count hA hAB
    (Real.log (c₄ * s) / Real.log 2) (Real.log (c₃ * s) / Real.log 2)
  filter_upwards [hcount, eventually_gt_atTop (0 : ℝ)] with L hcount hL
  rw [geometric_log_index_eq hc₄ hs hL β, geometric_log_index_eq hc₃ hs hL α]
  have hlo : ((1 - α) / Real.log 2 - (1 - β) / Real.log 2) / 2 =
      (β - α) / (2 * Real.log 2) := by ring
  have hhi : 2 * ((1 - α) / Real.log 2 - (1 - β) / Real.log 2) =
      2 * (β - α) / Real.log 2 := by ring
  simpa only [hlo, hhi] using hcount

/-- Both real endpoints of the dyadic index interval are eventually
nonnegative, so natural floor and ceiling implement the real inequalities. -/
theorem eventually_geometric_log_indices_nonneg {α β s c₃ c₄ : ℝ}
    (hαβ : α < β) (hβ : β < 1) (hs : 0 < s) (hc₃ : 0 < c₃) (hc₄ : 0 < c₄) :
    ∀ᶠ L : ℝ in atTop,
      0 ≤ Real.log (c₄ * (s * L) / L^β) / Real.log 2 ∧
      0 ≤ Real.log (c₃ * (s * L) / L^α) / Real.log 2 := by
  have hlog : 0 < Real.log (2 : ℝ) := Real.log_pos (by norm_num)
  have hA : 0 < (1 - β) / Real.log 2 := div_pos (by linarith) hlog
  have hB : 0 < (1 - α) / Real.log 2 := div_pos (by linarith) hlog
  have htA : Tendsto (fun L : ℝ => ((1 - β) / Real.log 2) * Real.log L) atTop atTop :=
    Tendsto.const_mul_atTop hA Real.tendsto_log_atTop
  have htB : Tendsto (fun L : ℝ => ((1 - α) / Real.log 2) * Real.log L) atTop atTop :=
    Tendsto.const_mul_atTop hB Real.tendsto_log_atTop
  filter_upwards [htA.eventually (eventually_ge_atTop (-(Real.log (c₄ * s) / Real.log 2))),
    htB.eventually (eventually_ge_atTop (-(Real.log (c₃ * s) / Real.log 2))),
    eventually_gt_atTop (0 : ℝ)] with L hA' hB' hL
  rw [geometric_log_index_eq hc₄ hs hL β, geometric_log_index_eq hc₃ hs hL α]
  constructor <;> linarith
end

section
open Filter Finset
noncomputable def powerRangePrimeIndices (s lower upper α β L : ℝ) : Finset ℕ :=
  dyadicGroupIndices (s * L) lower upper (L^α) (L^β)

theorem eventually_concrete_dyadic_prime_groups {s lower upper α β : ℝ}
    (hs : 0 < s) (hlower : 0 < lower) (hlu : lower < upper)
    (hgap : upper ≤ 2 * lower) (hα : 0 < α) (hαβ : α < β) (hβ : β < 1) :
    ∃ v V : ℝ, 0 < v ∧ 0 < V ∧ ∀ᶠ L : ℝ in atTop,
      ((β - α) / (2 * Real.log 2)) * Real.log L ≤
        ((powerRangePrimeIndices s lower upper α β L).card : ℝ) ∧
      ((powerRangePrimeIndices s lower upper α β L).card : ℝ) ≤
        (2 * (β - α) / Real.log 2) * Real.log L ∧
      Pairwise (fun i j : ℕ => Disjoint (dyadicPrimeBand (s * L) lower upper i)
        (dyadicPrimeBand (s * L) lower upper j)) ∧
      ∀ j ∈ powerRangePrimeIndices s lower upper α β L,
        (v ≤ ∑ p ∈ dyadicPrimeBand (s * L) lower upper j, 1 / (p : ℝ)) ∧
        (∑ p ∈ dyadicPrimeBand (s * L) lower upper j, 1 / (p : ℝ)) ≤ V ∧
        ∀ p ∈ dyadicPrimeBand (s * L) lower upper j,
          p.Prime ∧ Real.exp (L^α) < (p : ℝ) ∧ (p : ℝ) ≤ Real.exp (L^β) := by
  have hupper : 0 < upper := hlower.trans hlu
  have hlam : 1 < upper / lower := (one_lt_div hlower).mpr hlu
  obtain ⟨v, V, t0, hv, hV, _, ht0⟩ := exists_primeBandHarmonic_threshold hlam
  refine ⟨v, V, hv, hV, ?_⟩
  filter_upwards [eventually_geometric_log_index_count hαβ hβ hs hlower hupper,
    eventually_geometric_log_indices_nonneg hαβ hβ hs hlower hupper,
    (tendsto_rpow_atTop hα).eventually (eventually_ge_atTop t0),
    eventually_gt_atTop (0 : ℝ)] with L hcard hind ht hL
  refine ⟨hcard.1, hcard.2,
    pairwise_disjoint_dyadicPrimeBand (mul_pos hs hL).le hlower.le hgap, ?_⟩
  intro j hj
  have hA : 0 < L^α := Real.rpow_pos_of_pos hL α
  have hB : 0 < L^β := Real.rpow_pos_of_pos hL β
  obtain ⟨hlo, hhi⟩ := dyadic_scale_bounds_of_mem (mul_pos hs hL) hlower hupper hA hB hind.2 hj
  have hmass := ht0 (lower * (s * L) / 2^j) (ht.trans hlo)
  rw [← dyadicPrimeBand_harmonic_eq_log_ratio (s * L) lower upper j hlower.ne'] at hmass
  refine ⟨hmass.1, hmass.2, ?_⟩
  intro p hp
  exact dyadicPrimeBand_prime_range hp hlo hhi

theorem eventually_candidate_P_groups {s α β : ℝ}
    (hs : 0 < s) (hα : 0 < α) (hαβ : α < β) (hβ : β < 1) :
    ∃ v V : ℝ, 0 < v ∧ 0 < V ∧ ∀ᶠ L : ℝ in atTop,
      ((β - α) / (2 * Real.log 2)) * Real.log L ≤
        ((powerRangePrimeIndices s (3/2) (9/5) α β L).card : ℝ) ∧
      ((powerRangePrimeIndices s (3/2) (9/5) α β L).card : ℝ) ≤
        (2 * (β - α) / Real.log 2) * Real.log L ∧
      Pairwise (fun i j : ℕ => Disjoint (candidatePBand (s * L) i)
        (candidatePBand (s * L) j)) ∧
      ∀ j ∈ powerRangePrimeIndices s (3/2) (9/5) α β L,
        (v ≤ ∑ p ∈ candidatePBand (s * L) j, 1 / (p : ℝ)) ∧
        (∑ p ∈ candidatePBand (s * L) j, 1 / (p : ℝ)) ≤ V ∧
        ∀ p ∈ candidatePBand (s * L) j,
          p.Prime ∧ Real.exp (L^α) < (p : ℝ) ∧ (p : ℝ) ≤ Real.exp (L^β) := by
  exact eventually_concrete_dyadic_prime_groups hs (by norm_num) (by norm_num)
    (by norm_num) hα hαβ hβ
end

section
open Finset Filter
open scoped Topology
noncomputable def candidateQIndices (c L : ℝ) : Finset ℕ :=
  Icc 0 ⌊Real.log (c * L / (20 * Real.log L)) / Real.log 2⌋₊

theorem candidateQIndices_geometry {c L : ℝ} (hc : 0 < c) (hL : 0 < L)
    (hlog : 1 ≤ Real.log L) (hlarge : 20 * Real.log L ≤ c * L)
    (hsmall : c ≤ 20 * Real.log L) :
    ((candidateQIndices c L).card : ℝ) ≤ (1 / Real.log 2 + 1) * Real.log L ∧
      ∀ j ∈ candidateQIndices c L,
        20 * Real.log L ≤ c * L / 2^j ∧
          (6/5 : ℝ) * (c * L) / 2^j ≤ (6/5 : ℝ) * c * L := by
  have hlog0 : 0 < Real.log L := zero_lt_one.trans_le hlog
  have hlog2 : 0 < Real.log 2 := by positivity
  have hden : 0 < 20 * Real.log L := by positivity
  let z := c * L / (20 * Real.log L)
  have hz1 : 1 ≤ z := (one_le_div hden).mpr hlarge
  have hz0 : 0 < z := zero_lt_one.trans_le hz1
  have hf0 : 0 ≤ Real.log z / Real.log 2 := div_nonneg (Real.log_nonneg hz1) hlog2.le
  have hzL : z ≤ L := by
    apply (div_le_iff₀ hden).mpr
    nlinarith [mul_le_mul_of_nonneg_right hsmall hL.le]
  constructor
  · have hf : Real.log z / Real.log 2 ≤ Real.log L / Real.log 2 :=
      div_le_div_of_nonneg_right (Real.log_le_log hz0 hzL) hlog2.le
    have hfloor := Nat.floor_le hf0
    have hcard : ((candidateQIndices c L).card : ℝ) = (⌊Real.log z / Real.log 2⌋₊ : ℝ) + 1 := by
      simp [candidateQIndices, z, Nat.card_Icc]
    rw [hcard]
    calc
      _ ≤ Real.log L / Real.log 2 + 1 := by linarith
      _ ≤ Real.log L / Real.log 2 + Real.log L := by linarith
      _ = _ := by ring
  · intro j hj
    have hj' : (j : ℝ) ≤ Real.log z / Real.log 2 :=
      (Nat.le_floor_iff hf0).mp (mem_Icc.mp hj).2
    have hp : (2 : ℝ)^j ≤ z := by
      apply (Real.log_le_log_iff (by positivity) hz0).mp
      rw [Real.log_pow]
      exact (le_div_iff₀ hlog2).mp hj'
    have hp0 : (0 : ℝ) < 2^j := by positivity
    constructor
    · apply (le_div_iff₀ hp0).mpr
      have hh := (le_div_iff₀ hden).mp hp
      nlinarith
    · have hp1 : (1 : ℝ) ≤ 2^j := one_le_pow₀ (by norm_num)
      apply (div_le_iff₀ hp0).mpr
      nlinarith [mul_le_mul_of_nonneg_left hp1 (show 0 ≤ (6/5 : ℝ) * c * L by positivity)]

theorem eventually_candidateQIndices_parameters {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, 0 < L ∧ 1 ≤ Real.log L ∧
      20 * Real.log L ≤ c * L ∧ c ≤ 20 * Real.log L := by
  have hlogdiv : Tendsto (fun L : ℝ => Real.log L / L) atTop (𝓝 0) := by
    simpa using Real.tendsto_pow_log_div_mul_add_atTop 1 0 1 one_ne_zero
  filter_upwards [eventually_gt_atTop (0 : ℝ),
    Real.tendsto_log_atTop.eventually (eventually_ge_atTop (1 : ℝ)),
    Real.tendsto_log_atTop.eventually (eventually_ge_atTop (c / 20)),
    hlogdiv.eventually_lt_const (show 0 < c / 20 by positivity)] with L hL hlog hcL hratio
  refine ⟨hL, hlog, ?_, ?_⟩
  · have hh := (div_lt_iff₀ hL).mp hratio
    nlinarith
  · linarith

theorem eventually_candidateQIndices_geometry {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop,
      ((candidateQIndices c L).card : ℝ) ≤ (1 / Real.log 2 + 1) * Real.log L ∧
      ∀ j ∈ candidateQIndices c L,
        20 * Real.log L ≤ c * L / 2^j ∧
          (6/5 : ℝ) * (c * L) / 2^j ≤ (6/5 : ℝ) * c * L := by
  filter_upwards [eventually_candidateQIndices_parameters hc] with L h
  exact candidateQIndices_geometry hc h.1 h.2.1 h.2.2.1 h.2.2.2

/-- The fixed-width Q bands have a positive uniform harmonic mass, while
their number and endpoints satisfy the required logarithmic bounds. -/
theorem exists_candidateQBands_bounds {c : ℝ} (hc : 0 < c) :
    ∃ vmin vmax : ℝ, 0 < vmin ∧ 0 < vmax ∧ ∀ᶠ L : ℝ in atTop,
      0 < L ∧
      ((candidateQIndices c L).card : ℝ) ≤ (1 / Real.log 2 + 1) * Real.log L ∧
      ∀ j ∈ candidateQIndices c L,
        20 * Real.log L ≤ c * L / 2^j ∧
        (6/5 : ℝ) * (c * L) / 2^j ≤ (6/5 : ℝ) * c * L ∧
        vmin ≤ (∑ p ∈ candidateQBand (c * L) j, 1 / (p : ℝ)) ∧
          (∑ p ∈ candidateQBand (c * L) j, 1 / (p : ℝ)) ≤ vmax := by
  obtain ⟨vmin, vmax, t0, hvmin, hvmax, ht0, hmass⟩ :=
    exists_primeBandHarmonic_threshold (show (1 : ℝ) < 6/5 by norm_num)
  refine ⟨vmin, vmax, hvmin, hvmax, ?_⟩
  filter_upwards [eventually_candidateQIndices_parameters hc,
    Real.tendsto_log_atTop.eventually (eventually_ge_atTop (t0 / 20))] with L h hthreshold
  obtain ⟨hcard, hends⟩ := candidateQIndices_geometry hc h.1 h.2.1 h.2.2.1 h.2.2.2
  refine ⟨h.1, hcard, ?_⟩
  intro j hj
  obtain ⟨hlo, hhi⟩ := hends j hj
  refine ⟨hlo, hhi, ?_⟩
  have ht : t0 ≤ c * L / 2^j := by linarith
  have hm := hmass (c * L / 2^j) ht
  have he : (∑ p ∈ candidateQBand (c * L) j, 1 / (p : ℝ)) =
      primeBandHarmonic (Real.exp (c * L / 2^j))
        (Real.exp ((6/5 : ℝ) * (c * L / 2^j))) := by
    simpa only [candidateQBand, one_mul, div_one] using
      dyadicPrimeBand_harmonic_eq_log_ratio (c * L) 1 (6/5) j one_ne_zero
  rwa [he]
end

section
open Filter Finset
noncomputable def candidateSmallPIndices (s L : ℝ) : Finset ℕ :=
  powerRangePrimeIndices s (3/2) (9/5) (1/10) (1/5) L

noncomputable def candidateBigPIndices (s L : ℝ) : Finset ℕ :=
  powerRangePrimeIndices s (3/2) (9/5) (3/10) (2/5) L

noncomputable def candidatePIndices (s L : ℝ) : Finset ℕ :=
  candidateSmallPIndices s L ∪ candidateBigPIndices s L

/-- Small and big index families retain their individual logarithmic lower
bounds. Their union has a common positive bounded reciprocal-prime mass,
the required global prime range, and pairwise disjoint groups. -/
theorem exists_candidate_P_pool_bounds {s : ℝ} (hs : 0 < s) :
    ∃ v V : ℝ, 0 < v ∧ 0 < V ∧ ∀ᶠ L : ℝ in atTop,
      1 ≤ L ∧
      (1 / (20 * Real.log 2)) * Real.log L ≤ ((candidateSmallPIndices s L).card : ℝ) ∧
      (1 / (20 * Real.log 2)) * Real.log L ≤ ((candidateBigPIndices s L).card : ℝ) ∧
      ((candidatePIndices s L).card : ℝ) ≤ (2 / (5 * Real.log 2)) * Real.log L ∧
      Pairwise (fun i j : ℕ => Disjoint (candidatePBand (s * L) i)
        (candidatePBand (s * L) j)) ∧
      ∀ j ∈ candidatePIndices s L,
        (v ≤ ∑ p ∈ candidatePBand (s * L) j, 1 / (p : ℝ)) ∧
        (∑ p ∈ candidatePBand (s * L) j, 1 / (p : ℝ)) ≤ V ∧
        ∀ p ∈ candidatePBand (s * L) j,
          p.Prime ∧ Real.exp (L^(1/10 : ℝ)) < (p : ℝ) ∧
            (p : ℝ) ≤ Real.exp (L^(2/5 : ℝ)) := by
  obtain ⟨v₁, V₁, hv₁, hV₁, hsmall⟩ :=
    eventually_candidate_P_groups (α := (1/10 : ℝ)) (β := (1/5 : ℝ))
      hs (by norm_num) (by norm_num) (by norm_num)
  obtain ⟨v₂, V₂, hv₂, hV₂, hbig⟩ :=
    eventually_candidate_P_groups (α := (3/10 : ℝ)) (β := (2/5 : ℝ))
      hs (by norm_num) (by norm_num) (by norm_num)
  refine ⟨min v₁ v₂, max V₁ V₂, lt_min hv₁ hv₂, hV₁.trans_le (le_max_left _ _), ?_⟩
  filter_upwards [hsmall, hbig, eventually_ge_atTop (1 : ℝ)] with L hsmall hbig hL
  rcases hsmall with ⟨hslo, hshi, hpair, hsdata⟩
  rcases hbig with ⟨hblo, hbhi, _, hbdata⟩
  have hlo : ((1/5 : ℝ) - 1/10) / (2 * Real.log 2) = 1 / (20 * Real.log 2) := by ring
  have hlo' : ((2/5 : ℝ) - 3/10) / (2 * Real.log 2) = 1 / (20 * Real.log 2) := by ring
  have hhi : 2 * ((1/5 : ℝ) - 1/10) / Real.log 2 = 1 / (5 * Real.log 2) := by ring
  have hhi' : 2 * ((2/5 : ℝ) - 3/10) / Real.log 2 = 1 / (5 * Real.log 2) := by ring
  rw [hlo] at hslo
  rw [hlo'] at hblo
  rw [hhi] at hshi
  rw [hhi'] at hbhi
  refine ⟨hL, hslo, hblo, ?_, hpair, ?_⟩
  · have hcard : ((candidatePIndices s L).card : ℝ) ≤
        ((candidateSmallPIndices s L).card : ℝ) + ((candidateBigPIndices s L).card : ℝ) := by
      exact_mod_cast (card_union_le (candidateSmallPIndices s L) (candidateBigPIndices s L))
    change ((candidateSmallPIndices s L).card : ℝ) ≤ _ at hshi
    change ((candidateBigPIndices s L).card : ℝ) ≤ _ at hbhi
    calc
      _ ≤ ((candidateSmallPIndices s L).card : ℝ) + ((candidateBigPIndices s L).card : ℝ) := hcard
      _ ≤ (1 / (5 * Real.log 2)) * Real.log L + (1 / (5 * Real.log 2)) * Real.log L :=
        add_le_add hshi hbhi
      _ = _ := by ring
  · intro j hj
    rcases mem_union.mp hj with hj | hj
    · obtain ⟨hv, hV, hp⟩ := hsdata j hj
      refine ⟨(min_le_left _ _).trans hv, hV.trans (le_max_left _ _), ?_⟩
      intro p hpj
      obtain ⟨hpp, hpl, hpu⟩ := hp p hpj
      exact ⟨hpp, hpl, hpu.trans (Real.exp_le_exp.mpr
        (Real.rpow_le_rpow_of_exponent_le hL (by norm_num)))⟩
    · obtain ⟨hv, hV, hp⟩ := hbdata j hj
      refine ⟨(min_le_right _ _).trans hv, hV.trans (le_max_right _ _), ?_⟩
      intro p hpj
      obtain ⟨hpp, hpl, hpu⟩ := hp p hpj
      exact ⟨hpp, (Real.exp_le_exp.mpr
        (Real.rpow_le_rpow_of_exponent_le hL (by norm_num))).trans_lt hpl, hpu⟩
end

section
open Finset
/-- Birth j either starts a component or chooses one parent strictly before j. -/
abbrev BirthForestCode (n : ℕ) := ∀ j : Fin n, Option (Fin j.val)

/-- Regard an earlier birth as an index in the full birth list. -/
def birthForestParentEmbedding {n : ℕ} (j : Fin n) : Fin j.val ↪ Fin n where
  toFun p := ⟨p.val, p.isLt.trans j.isLt⟩
  inj' := by
    intro p q h
    exact Fin.ext (congrArg (fun x : Fin n => x.val) h)

/-- The directed links (parent, child) selected by a birth code. -/
def birthForestEdges {n : ℕ} (code : BirthForestCode n) : Finset (Fin n × Fin n) :=
  univ.filter fun e => (code e.2).map (birthForestParentEmbedding e.2) = some e.1

theorem mem_birthForestEdges {n : ℕ} (code : BirthForestCode n) (p j : Fin n) :
    (p, j) ∈ birthForestEdges code ↔
      (code j).map (birthForestParentEmbedding j) = some p := by
  simp [birthForestEdges]

/-- Every edge points strictly forward in the birth order. -/
theorem birthForestEdges_parent_lt {n : ℕ} (code : BirthForestCode n) {p j : Fin n}
    (h : (p, j) ∈ birthForestEdges code) : p.val < j.val := by
  rw [mem_birthForestEdges] at h
  cases hc : code j with
  | none => simp [hc] at h
  | some q =>
    have he : birthForestParentEmbedding j q = p := by simpa [hc] using h
    rw [← he]
    exact q.isLt

/-- The edge set remembers every parent choice, including the no-parent choice. -/
theorem birthForestEdges_injective {n : ℕ} :
    Function.Injective (@birthForestEdges n) := by
  intro c d h
  funext j
  apply Option.map_injective (birthForestParentEmbedding j).injective
  apply Option.ext
  intro p
  simpa only [mem_birthForestEdges] using
    (show (p, j) ∈ birthForestEdges c ↔ (p, j) ∈ birthForestEdges d from by rw [h])

/-- Rank is the number of parent links. -/
def birthForestRank {n : ℕ} (code : BirthForestCode n) : ℕ :=
  (birthForestEdges code).card

/-- Two selected edges with the same child have the same parent. -/
theorem birthForestEdges_child_injective {n : ℕ} (code : BirthForestCode n) :
    Set.InjOn Prod.snd (birthForestEdges code : Set (Fin n × Fin n)) := by
  rintro ⟨p, j⟩ hp ⟨q, k⟩ hq hjk
  change j = k at hjk
  subst k
  have hp' := (mem_birthForestEdges code p j).mp hp
  have hq' := (mem_birthForestEdges code q j).mp hq
  exact Prod.ext (Option.some.inj (hp'.symm.trans hq')) rfl

/-- Children incident to a parent link are precisely the `some` entries. -/
theorem birthForestEdges_image_snd {n : ℕ} (code : BirthForestCode n) :
    (birthForestEdges code).image Prod.snd = univ.filter (fun j => (code j).isSome) := by
  ext j
  simp only [mem_image, mem_filter, mem_univ, true_and]
  constructor
  · rintro ⟨⟨p, k⟩, hp, hkj⟩
    change k = j at hkj
    subst k
    have h := Option.isSome_of_eq_some ((mem_birthForestEdges code p j).mp hp)
    simpa only [Option.isSome_map] using h
  · intro hj
    obtain ⟨p, hp⟩ := Option.isSome_iff_exists.mp hj
    refine ⟨(birthForestParentEmbedding j p, j), ?_, rfl⟩
    simp [mem_birthForestEdges, hp]

/-- Graph rank agrees with the count of nonempty parent choices. -/
theorem birthForestRank_eq_card_isSome {n : ℕ} (code : BirthForestCode n) :
    birthForestRank code = (univ.filter (fun j => (code j).isSome)).card := by
  rw [birthForestRank, ← birthForestEdges_image_snd code]
  exact (card_image_of_injOn (birthForestEdges_child_injective code)).symm

/-- The local rank sum used in product expansions equals graph rank. -/
theorem birthForestRank_eq_sum {n : ℕ} (code : BirthForestCode n) :
    birthForestRank code = ∑ j : Fin n, (match code j with | none => 0 | some _ => 1) := by
  rw [birthForestRank_eq_card_isSome, card_eq_sum_ones, sum_filter]
  apply sum_congr rfl
  intro j hj
  cases code j <;> simp

/-- Births incident to at least one parent link. -/
def birthForestTouched {n : ℕ} (code : BirthForestCode n) : Finset (Fin n) :=
  (birthForestEdges code).image Prod.fst ∪ (birthForestEdges code).image Prod.snd

theorem birthForestTouched_card_le {n : ℕ} (code : BirthForestCode n) :
    (birthForestTouched code).card ≤ 2 * birthForestRank code := by
  calc
    (birthForestTouched code).card ≤
        ((birthForestEdges code).image Prod.fst).card +
          ((birthForestEdges code).image Prod.snd).card := card_union_le _ _
    _ ≤ (birthForestEdges code).card + (birthForestEdges code).card :=
      Nat.add_le_add (card_image_le) (card_image_le)
    _ = 2 * birthForestRank code := by simp [birthForestRank, two_mul]

/-- All codes with exactly r parent links. -/
def birthForestCodesOfRank (n r : ℕ) : Finset (BirthForestCode n) :=
  univ.filter fun code => birthForestRank code = r

/-- Fixed-rank birth codes inject into r-element subsets of all ordered pairs. -/
def birthForestRankEmbedding (n r : ℕ) :
    {code : BirthForestCode n // birthForestRank code = r} ↪
      {edges : Finset (Fin n × Fin n) // edges ∈ powersetCard r univ} where
  toFun code := ⟨birthForestEdges code.val, mem_powersetCard.mpr
    ⟨subset_univ _, code.property⟩⟩
  inj' := by
    intro c d h
    apply Subtype.ext
    exact birthForestEdges_injective (congrArg Subtype.val h)

/-- The powerset bound before replacing the binomial coefficient by a power. -/
theorem birthForestCodesOfRank_card_le_choose (n r : ℕ) :
    (birthForestCodesOfRank n r).card ≤ (n * n).choose r := by
  have hsubset : (birthForestCodesOfRank n r).image birthForestEdges ⊆
      powersetCard r (univ : Finset (Fin n × Fin n)) := by
    intro edges he
    obtain ⟨code, hc, rfl⟩ := mem_image.mp he
    exact mem_powersetCard.mpr ⟨subset_univ _, (mem_filter.mp hc).2⟩
  calc
    (birthForestCodesOfRank n r).card =
        ((birthForestCodesOfRank n r).image birthForestEdges).card :=
      (card_image_of_injective _ birthForestEdges_injective).symm
    _ ≤ (powersetCard r (univ : Finset (Fin n × Fin n))).card := card_le_card hsubset
    _ = (n * n).choose r := by simp

/-- There are at most n^(2r) rank-r birth codes, including n=0 and r=0. -/
theorem birthForestCodesOfRank_card_le_pow (n r : ℕ) :
    (birthForestCodesOfRank n r).card ≤ n ^ (2 * r) := by
  calc
    (birthForestCodesOfRank n r).card ≤ (n * n).choose r :=
      birthForestCodesOfRank_card_le_choose n r
    _ ≤ (n * n) ^ r := Nat.choose_le_pow _ _
    _ = n ^ (2 * r) := by rw [← pow_two, ← pow_mul]

/-- The same count using the subtype of fixed-rank codes. -/
theorem birthForestRank_card_le_pow (n r : ℕ) :
    Fintype.card {code : BirthForestCode n // birthForestRank code = r} ≤ n ^ (2 * r) := by
  simpa only [Fintype.card_subtype, birthForestCodesOfRank] using
    birthForestCodesOfRank_card_le_pow n r
end

section
open Finset Classical
/-- Only addresses at which a birth is performed participate in distinctness. -/
def birthValuesDistinct {n : ℕ} {α : Type*}
    (performed : Fin n → Prop) (f : Fin n → α) : Prop :=
  Set.InjOn f {i | performed i}

/-- Number of earlier performed addresses with the same value. -/
noncomputable def earlierBirthCollisionSum {n : ℕ} {α : Type*}
    (performed : Fin n → Prop) (f : Fin n → α) (j : Fin n) : ℤ := by
  classical
  exact ∑ i : Fin n, if i < j ∧ performed i ∧ performed j ∧ f i = f j then 1 else 0

/-- For distinct performed values every earlier-collision count vanishes. -/
theorem earlierBirthCollisionSum_eq_zero {n : ℕ} {α : Type*}
    (performed : Fin n → Prop) (f : Fin n → α)
    (h : birthValuesDistinct performed f) (j : Fin n) :
    earlierBirthCollisionSum performed f j = 0 := by
  classical
  apply sum_eq_zero
  intro i _
  have hn : ¬ (i < j ∧ performed i ∧ performed j ∧ f i = f j) := by
    rintro ⟨hij, hi, hj, hf⟩
    exact (ne_of_lt hij) (h hi hj hf)
  exact if_neg hn

/-- If distinctness fails, the first repeated address has exactly one
earlier performed address of its value. -/
theorem exists_earlierBirthCollisionSum_eq_one {n : ℕ} {α : Type*}
    (performed : Fin n → Prop) (f : Fin n → α)
    (h : ¬ birthValuesDistinct performed f) :
    ∃ j, earlierBirthCollisionSum performed f j = 1 := by
  classical
  let bad : Finset (Fin n) := univ.filter (fun j =>
    ∃ i, i < j ∧ performed i ∧ performed j ∧ f i = f j)
  have hbad : bad.Nonempty := by
    have hn : ¬ ∀ i j, performed i → performed j → f i = f j → i = j := by
      intro hh
      exact h (fun _ hi _ hj hf => hh _ _ hi hj hf)
    push Not at hn
    obtain ⟨i, j, hi, hj, hf, hne⟩ := hn
    rcases lt_or_gt_of_ne hne with hij | hji
    · exact ⟨j, mem_filter.mpr ⟨mem_univ _, i, hij, hi, hj, hf⟩⟩
    · exact ⟨i, mem_filter.mpr ⟨mem_univ _, j, hji, hj, hi, hf.symm⟩⟩
  let j := bad.min' hbad
  have hjmem : j ∈ bad := min'_mem bad hbad
  obtain ⟨i, hij, hpi, hpj, hfij⟩ := (mem_filter.mp hjmem).2
  have hminimal : ∀ k ∈ bad, j ≤ k := fun k hk => min'_le bad k hk
  have hsingle : ∀ k, (k < j ∧ performed k ∧ performed j ∧ f k = f j) ↔ k = i := by
    intro k
    constructor
    · rintro ⟨hkj, hpk, _, hfkj⟩
      rcases lt_trichotomy k i with hki | hki | hik
      · have himem : i ∈ bad := mem_filter.mpr
          ⟨mem_univ _, k, hki, hpk, hpi, hfkj.trans hfij.symm⟩
        exact False.elim ((not_lt_of_ge (hminimal i himem)) hij)
      · exact hki
      · have hkmem : k ∈ bad := mem_filter.mpr
          ⟨mem_univ _, i, hik, hpi, hpk, hfij.trans hfkj.symm⟩
        exact False.elim ((not_lt_of_ge (hminimal k hkmem)) hkj)
    · rintro rfl
      exact ⟨hij, hpi, hpj, hfij⟩
  refine ⟨j, ?_⟩
  simp only [earlierBirthCollisionSum, hsingle, sum_ite_eq', mem_univ, if_true]

/-- Exact global distinctness indicator as a product of chronological local
collision factors. No probabilistic independence assumption is involved. -/
theorem distinct_birth_product {n : ℕ} {α : Type*}
    (performed : Fin n → Prop) (f : Fin n → α) :
    (if birthValuesDistinct performed f then (1 : ℤ) else 0) =
      ∏ j : Fin n, (1 - earlierBirthCollisionSum performed f j) := by
  classical
  by_cases h : birthValuesDistinct performed f
  · simp only [if_pos h, earlierBirthCollisionSum_eq_zero performed f h,
      sub_zero, prod_const_one]
  · obtain ⟨j, hj⟩ := exists_earlierBirthCollisionSum_eq_one performed f h
    rw [if_neg h]
    exact (prod_eq_zero (mem_univ j) (by rw [hj, sub_self])).symm

/-- Summing over earlier addresses is summing over the parent's smaller
finite index type. -/
theorem sum_birthForestParents {n : ℕ} (j : Fin n) (F : Fin n → ℤ) :
    (∑ i : Fin n, if i < j then F i else 0) =
      ∑ i : Fin j.val, F (birthForestParentEmbedding j i) := by
  have he : (univ : Finset (Fin n)).filter (fun i => i < j) =
      (univ : Finset (Fin j.val)).map (birthForestParentEmbedding j) := by
    ext i
    simp only [mem_filter, mem_univ, true_and, mem_map]
    constructor
    · intro hij
      exact ⟨⟨i.val, hij⟩, Fin.ext rfl⟩
    · rintro ⟨k, rfl⟩
      exact k.isLt
  rw [← sum_filter, he, sum_map]

/-- A parent choice is admissible exactly when both births are performed
and have the same value; the empty choice imposes no condition. -/
def birthForestChoiceCompatible {n : ℕ} {α : Type*}
    (performed : Fin n → Prop) (f : Fin n → α)
    (j : Fin n) : Option (Fin j.val) → Prop
  | none => True
  | some i => performed (birthForestParentEmbedding j i) ∧ performed j ∧
      f (birthForestParentEmbedding j i) = f j

def birthForestCompatible {n : ℕ} {α : Type*}
    (performed : Fin n → Prop) (f : Fin n → α) (code : BirthForestCode n) : Prop :=
  ∀ j, birthForestChoiceCompatible performed f j (code j)

/-- Signed local factor for a chronological parent choice. -/
noncomputable def birthForestChoiceWeight {n : ℕ} {α : Type*}
    (performed : Fin n → Prop) (f : Fin n → α)
    (j : Fin n) : Option (Fin j.val) → ℤ
  | none => 1
  | some i => if birthForestChoiceCompatible performed f j (some i) then -1 else 0

/-- One chronological collision factor is the sum over all its parent choices. -/
theorem birthForestChoiceWeight_sum {n : ℕ} {α : Type*}
    (performed : Fin n → Prop) (f : Fin n → α) (j : Fin n) :
    (∑ p : Option (Fin j.val), birthForestChoiceWeight performed f j p) =
      1 - earlierBirthCollisionSum performed f j := by
  rw [Fintype.sum_option]
  simp only [birthForestChoiceWeight]
  have he : earlierBirthCollisionSum performed f j =
      ∑ i : Fin j.val, if birthForestChoiceCompatible performed f j (some i) then 1 else 0 := by
    unfold earlierBirthCollisionSum
    simp only [ite_and]
    rw [sum_birthForestParents]
    apply sum_congr rfl
    intro i _
    by_cases hi : performed (birthForestParentEmbedding j i) <;>
      by_cases hj : performed j <;>
      by_cases hf : f (birthForestParentEmbedding j i) = f j <;>
      simp [birthForestChoiceCompatible, hi, hj, hf]
  rw [he]
  have hn : (∑ i : Fin j.val,
      if birthForestChoiceCompatible performed f j (some i) then (-1 : ℤ) else 0) =
      -(∑ i : Fin j.val,
        if birthForestChoiceCompatible performed f j (some i) then (1 : ℤ) else 0) := by
    rw [← sum_neg_distrib]
    apply sum_congr rfl
    intro i _
    split_ifs <;> rfl
  rw [hn]
  rfl

/-- The signed weight of one parent code is its sign times the conjunction
of all selected chronological equality constraints. -/
theorem birthForestChoiceWeight_prod {n : ℕ} {α : Type*}
    (performed : Fin n → Prop) (f : Fin n → α) (code : BirthForestCode n) :
    (∏ j, birthForestChoiceWeight performed f j (code j)) =
      (-1 : ℤ) ^ birthForestRank code *
        (if birthForestCompatible performed f code then 1 else 0) := by
  have hlocal : ∀ j, birthForestChoiceWeight performed f j (code j) =
      (-1 : ℤ) ^ (match code j with | none => 0 | some _ => 1) *
        (if birthForestChoiceCompatible performed f j (code j) then 1 else 0) := by
    intro j
    cases code j with
    | none => simp [birthForestChoiceWeight, birthForestChoiceCompatible]
    | some i =>
      by_cases h : birthForestChoiceCompatible performed f j (some i) <;>
        simp [birthForestChoiceWeight, h]
  simp_rw [hlocal]
  rw [prod_mul_distrib, prod_pow_eq_pow_sum, birthForestRank_eq_sum code]
  congr 1
  rw [Fintype.prod_boole]
  by_cases h : birthForestCompatible performed f code
  · have hh : ∀ i, birthForestChoiceCompatible performed f i (code i) := h
    rw [if_pos hh, if_pos h]
  · have hh : ¬ ∀ i, birthForestChoiceCompatible performed f i (code i) := h
    rw [if_neg hh, if_neg h]

/-- Exact distinctness expansion indexed by chronological forests. Each
selected parent link contributes one sign and one dependent birth. -/
theorem distinct_birth_forest_expansion {n : ℕ} {α : Type*}
    (performed : Fin n → Prop) (f : Fin n → α) :
    (if birthValuesDistinct performed f then (1 : ℤ) else 0) =
      ∑ code : BirthForestCode n, (-1 : ℤ) ^ birthForestRank code *
        (if birthForestCompatible performed f code then 1 else 0) := by
  rw [distinct_birth_product]
  simp_rw [← birthForestChoiceWeight_sum performed f]
  rw [Fintype.prod_sum]
  apply sum_congr rfl
  intro code _
  exact birthForestChoiceWeight_prod performed f code

/-- The same exact expansion in any ring, including real and complex path
coefficient rings. -/
theorem distinct_birth_forest_expansion_ring {R : Type*} [Ring R]
    {n : ℕ} {α : Type*} (performed : Fin n → Prop) (f : Fin n → α) :
    (if birthValuesDistinct performed f then (1 : R) else 0) =
      ∑ code : BirthForestCode n, (-1 : R) ^ birthForestRank code *
        (if birthForestCompatible performed f code then 1 else 0) := by
  have h := congrArg (fun z : ℤ => (z : R)) (distinct_birth_forest_expansion performed f)
  push_cast at h
  exact h

/-- Forest compatibility imposes exactly the performed-birth and equal-value
conditions along its selected parent links. -/
theorem birthForestCompatible_iff_edges {n : ℕ} {α : Type*}
    (performed : Fin n → Prop) (f : Fin n → α) (code : BirthForestCode n) :
    birthForestCompatible performed f code ↔
      ∀ i j, (i, j) ∈ birthForestEdges code →
        performed i ∧ performed j ∧ f i = f j := by
  constructor
  · intro h i j hij
    have hj := h j
    rw [mem_birthForestEdges] at hij
    cases hc : code j with
    | none => simp [hc] at hij
    | some p =>
      have he : birthForestParentEmbedding j p = i := by simpa [hc] using hij
      simpa only [hc, birthForestChoiceCompatible, he] using hj
  · intro h j
    cases hc : code j with
    | none => trivial
    | some p =>
      exact h (birthForestParentEmbedding j p) j (by simp [mem_birthForestEdges, hc])
end

section
open Finset Classical
/-- There is at most one parent link for each potential birth address. -/
theorem birthForestRank_le_addresses {n : ℕ} (code : BirthForestCode n) :
    birthForestRank code ≤ n := by
  rw [birthForestRank_eq_card_isSome]
  exact (card_filter_le _ _).trans (by simp)

/-- Signed weights of paths whose performed birth values are all distinct. -/
noncomputable def distinctBirthPathSum {Ω α : Type*} {n : ℕ}
    (paths : Finset Ω) (w : Ω → ℂ) (performed : Ω → Fin n → Prop)
    (f : Ω → Fin n → α) : ℂ :=
  ∑ ω ∈ paths, if birthValuesDistinct (performed ω) (f ω) then w ω else 0

/-- Signed weights of paths satisfying one chronological forest of equality
and performed-birth constraints. -/
noncomputable def birthForestPathSum {Ω α : Type*} {n : ℕ}
    (paths : Finset Ω) (w : Ω → ℂ) (performed : Ω → Fin n → Prop)
    (f : Ω → Fin n → α) (code : BirthForestCode n) : ℂ :=
  ∑ ω ∈ paths, if birthForestCompatible (performed ω) (f ω) code then w ω else 0

/-- The exact global restoration identity for arbitrary finite complex path
weights and path-dependent performed addresses. -/
theorem distinct_birth_path_expansion {Ω α : Type*} {n : ℕ}
    (paths : Finset Ω) (w : Ω → ℂ) (performed : Ω → Fin n → Prop)
    (f : Ω → Fin n → α) :
    distinctBirthPathSum paths w performed f =
      ∑ code : BirthForestCode n, (-1 : ℂ) ^ birthForestRank code *
        birthForestPathSum paths w performed f code := by
  have hpoint : ∀ ω, (if birthValuesDistinct (performed ω) (f ω) then w ω else 0) =
      ∑ code : BirthForestCode n, (-1 : ℂ) ^ birthForestRank code *
        (if birthForestCompatible (performed ω) (f ω) code then w ω else 0) := by
    intro ω
    have h := congrArg (fun z : ℂ => z * w ω)
      (distinct_birth_forest_expansion_ring (R := ℂ) (performed ω) (f ω))
    simpa only [sum_mul, mul_assoc, ite_mul, one_mul, zero_mul] using h
  unfold distinctBirthPathSum birthForestPathSum
  simp_rw [hpoint]
  rw [sum_comm]
  apply sum_congr rfl
  intro code _
  rw [mul_sum]

/-- Group any scalar rank envelope by the finite forest rank. -/
theorem sum_birthForestRank_envelope (n : ℕ) (B : ℕ → ℝ) :
    (∑ code : BirthForestCode n, B (birthForestRank code)) =
      ∑ r ∈ range (n + 1), (birthForestCodesOfRank n r).card * B r := by
  have hmem : ∀ code ∈ (univ : Finset (BirthForestCode n)),
      birthForestRank code ∈ range (n + 1) := by
    intro code _
    exact mem_range.mpr (Nat.lt_succ_of_le (birthForestRank_le_addresses code))
  have h := sum_fiberwise_of_maps_to' hmem B
  simpa only [birthForestCodesOfRank, sum_const, nsmul_eq_mul] using h.symm

/-- Rankwise bounds on constrained signed sums restore global distinctness.
The actual number of forest codes at each rank is retained. -/
theorem distinct_birth_path_norm_le_rank_card {Ω α : Type*} {n : ℕ}
    (paths : Finset Ω) (w : Ω → ℂ) (performed : Ω → Fin n → Prop)
    (f : Ω → Fin n → α) (B : ℕ → ℝ)
    (hB : ∀ code : BirthForestCode n,
      ‖birthForestPathSum paths w performed f code‖ ≤ B (birthForestRank code)) :
    ‖distinctBirthPathSum paths w performed f‖ ≤
      ∑ r ∈ range (n + 1), (birthForestCodesOfRank n r).card * B r := by
  rw [distinct_birth_path_expansion]
  calc
    ‖∑ code : BirthForestCode n, (-1 : ℂ) ^ birthForestRank code *
        birthForestPathSum paths w performed f code‖ ≤
      ∑ code : BirthForestCode n, ‖(-1 : ℂ) ^ birthForestRank code *
        birthForestPathSum paths w performed f code‖ := norm_sum_le _ _
    _ = ∑ code : BirthForestCode n, ‖birthForestPathSum paths w performed f code‖ := by
      simp only [norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
    _ ≤ ∑ code : BirthForestCode n, B (birthForestRank code) :=
      sum_le_sum (fun code _ => hB code)
    _ = _ := sum_birthForestRank_envelope n B

/-- The uniform n^(2r) forest count gives an explicit global restoration
bound without assuming any of the needed constrained path estimates. -/
theorem distinct_birth_path_norm_le_rank_power {Ω α : Type*} {n : ℕ}
    (paths : Finset Ω) (w : Ω → ℂ) (performed : Ω → Fin n → Prop)
    (f : Ω → Fin n → α) (B : ℕ → ℝ)
    (hB0 : ∀ r ∈ range (n + 1), 0 ≤ B r)
    (hB : ∀ code : BirthForestCode n,
      ‖birthForestPathSum paths w performed f code‖ ≤ B (birthForestRank code)) :
    ‖distinctBirthPathSum paths w performed f‖ ≤
      ∑ r ∈ range (n + 1), (n : ℝ) ^ (2 * r) * B r := by
  apply (distinct_birth_path_norm_le_rank_card paths w performed f B hB).trans
  apply sum_le_sum
  intro r hr
  apply mul_le_mul_of_nonneg_right _ (hB0 r hr)
  exact_mod_cast birthForestCodesOfRank_card_le_pow n r
end

section
open Finset Classical
/-- The restriction of a birth code to its first n entries. -/
def birthForestCodeInit {n : ℕ} (code : BirthForestCode (n + 1)) : BirthForestCode n :=
  fun j => code j.castSucc

theorem birthForestParentEmbedding_castSucc {n : ℕ} (j : Fin n) (p : Fin j.val) :
    birthForestParentEmbedding j.castSucc p = (birthForestParentEmbedding j p).castSucc := rfl

theorem birthForestParentEmbedding_last {n : ℕ} (p : Fin n) :
    birthForestParentEmbedding (Fin.last n) p = p.castSucc := rfl

theorem birthForestRank_le {n : ℕ} (code : BirthForestCode n) : birthForestRank code ≤ n := by
  rw [birthForestRank_eq_card_isSome]
  exact (card_filter_le _ _).trans (by simp)

theorem birthForestRank_init {n : ℕ} (code : BirthForestCode (n + 1)) :
    birthForestRank code = birthForestRank (birthForestCodeInit code) +
      (match code (Fin.last n) with | none => 0 | some _ => 1) := by
  rw [birthForestRank_eq_sum, Fin.sum_univ_castSucc, birthForestRank_eq_sum]
  congr 1
  · apply sum_congr rfl
    intro j hj
    unfold birthForestCodeInit
    cases code j.castSucc <;> rfl
  · cases code (Fin.last n) <;> rfl

/-- All selected parent equalities hold for this assignment of birth values. -/
def birthForestEqualValues {n : ℕ} {α : Type*} (code : BirthForestCode n)
    (f : Fin n → α) : Prop :=
  ∀ (j : Fin n) (p : Fin j.val), code j = some p →
    f j = f (birthForestParentEmbedding j p)

/-- One birth's weight, set to zero if its selected parent equality fails. -/
noncomputable def birthForestLocalFactor {n : ℕ} {α : Type*}
    (code : BirthForestCode n) (w : Fin n → α → ℝ) (f : Fin n → α) (j : Fin n) : ℝ := by
  classical
  exact match code j with
    | none => w j (f j)
    | some p => if f j = f (birthForestParentEmbedding j p) then w j (f j) else 0

noncomputable def birthForestAssignmentMass {n : ℕ} {α : Type*}
    (code : BirthForestCode n) (w : Fin n → α → ℝ) (f : Fin n → α) : ℝ :=
  ∏ j, birthForestLocalFactor code w f j

noncomputable def birthForestMass {n : ℕ} {α : Type*} [Fintype α]
    (code : BirthForestCode n) (w : Fin n → α → ℝ) : ℝ :=
  ∑ f : Fin n → α, birthForestAssignmentMass code w f

theorem birthForestAssignmentMass_nonneg {n : ℕ} {α : Type*}
    (code : BirthForestCode n) (w : Fin n → α → ℝ)
    (hw : ∀ j a, 0 ≤ w j a) (f : Fin n → α) :
    0 ≤ birthForestAssignmentMass code w f := by
  apply prod_nonneg
  intro j hj
  unfold birthForestLocalFactor
  split
  · exact hw _ _
  · split_ifs <;> simp_all

/-- Splitting off the last birth never changes any earlier local factor. -/
theorem birthForestAssignmentMass_snoc {n : ℕ} {α : Type*}
    (code : BirthForestCode (n + 1)) (w : Fin (n + 1) → α → ℝ)
    (f : Fin n → α) (a : α) :
    birthForestAssignmentMass code w (Fin.snoc f a) =
      birthForestAssignmentMass (birthForestCodeInit code) (fun j => w j.castSucc) f *
        (match code (Fin.last n) with
        | none => w (Fin.last n) a
        | some p => if a = f p then w (Fin.last n) a else 0) := by
  classical
  unfold birthForestAssignmentMass
  rw [Fin.prod_univ_castSucc]
  congr 1
  · apply prod_congr rfl
    intro j hj
    unfold birthForestLocalFactor birthForestCodeInit
    cases hc : code j.castSucc with
    | none => simp
    | some p =>
      dsimp only
      rw [show birthForestParentEmbedding j.castSucc p =
        (birthForestParentEmbedding j p).castSucc from rfl]
      simp
  · unfold birthForestLocalFactor
    cases hc : code (Fin.last n) with
    | none => simp
    | some p =>
      dsimp only
      rw [show birthForestParentEmbedding (Fin.last n) p = p.castSucc from rfl]
      simp

/-- Exact chronological summation identity. -/
theorem birthForestMass_last {n : ℕ} {α : Type*} [Fintype α]
    (code : BirthForestCode (n + 1)) (w : Fin (n + 1) → α → ℝ) :
    birthForestMass code w =
      match code (Fin.last n) with
      | none => birthForestMass (birthForestCodeInit code) (fun j => w j.castSucc) *
          ∑ a, w (Fin.last n) a
      | some p => ∑ f : Fin n → α,
          birthForestAssignmentMass (birthForestCodeInit code) (fun j => w j.castSucc) f *
            w (Fin.last n) (f p) := by
  classical
  unfold birthForestMass
  rw [← (Fin.snocEquiv (fun _ : Fin (n + 1) => α)).sum_comp]
  rw [Fintype.sum_prod_type, sum_comm]
  change (∑ f : Fin n → α, ∑ a : α, birthForestAssignmentMass code w (Fin.snoc f a)) = _
  simp only [birthForestAssignmentMass_snoc]
  cases hc : code (Fin.last n) with
  | none => simp [← mul_sum, ← sum_mul]
  | some p => simp

/-- Every selected parent link saves a total-mass factor and instead costs one
atom bound, because the parent value is fixed before the child is summed. -/
theorem birthForestMass_le {n : ℕ} {α : Type*} [Fintype α]
    (code : BirthForestCode n) (w : Fin n → α → ℝ)
    {M ε : ℝ} (hM : 0 ≤ M) (hε : 0 ≤ ε)
    (hw : ∀ j a, 0 ≤ w j a)
    (hsum : ∀ j, (∑ a, w j a) ≤ M) (hatom : ∀ j a, w j a ≤ ε) :
    birthForestMass code w ≤ ε ^ birthForestRank code * M ^ (n - birthForestRank code) := by
  induction n with
  | zero =>
    have hr : birthForestRank code = 0 := Nat.eq_zero_of_le_zero (birthForestRank_le code)
    simp [birthForestMass, birthForestAssignmentMass, hr]
  | succ n ih =>
    have hprev := ih (birthForestCodeInit code) (fun j => w j.castSucc)
      (fun j a => hw j.castSucc a) (fun j => hsum j.castSucc) (fun j a => hatom j.castSucc a)
    have hr := birthForestRank_init code
    have hrle := birthForestRank_le (birthForestCodeInit code)
    rw [birthForestMass_last]
    cases hc : code (Fin.last n) with
    | none =>
      simp only [hc, Nat.add_zero] at hr ⊢
      rw [hr]
      have hm0 : 0 ≤ birthForestMass (birthForestCodeInit code) (fun j => w j.castSucc) :=
        sum_nonneg fun f _ => birthForestAssignmentMass_nonneg _ _ (fun j a => hw j.castSucc a) f
      calc
        birthForestMass (birthForestCodeInit code) (fun j => w j.castSucc) *
            (∑ a, w (Fin.last n) a) ≤
          birthForestMass (birthForestCodeInit code) (fun j => w j.castSucc) * M :=
            mul_le_mul_of_nonneg_left (hsum _) hm0
        _ ≤ (ε ^ birthForestRank (birthForestCodeInit code) *
            M ^ (n - birthForestRank (birthForestCodeInit code))) * M :=
          mul_le_mul_of_nonneg_right hprev hM
        _ = ε ^ birthForestRank (birthForestCodeInit code) *
            M ^ (n + 1 - birthForestRank (birthForestCodeInit code)) := by
          rw [show n + 1 - birthForestRank (birthForestCodeInit code) =
            (n - birthForestRank (birthForestCodeInit code)) + 1 by omega, pow_succ]
          ring
    | some p =>
      simp only [hc] at hr ⊢
      rw [hr]
      calc
        (∑ f : Fin n → α, birthForestAssignmentMass (birthForestCodeInit code)
            (fun j => w j.castSucc) f * w (Fin.last n) (f p)) ≤
          ∑ f : Fin n → α, birthForestAssignmentMass (birthForestCodeInit code)
            (fun j => w j.castSucc) f * ε := by
          apply sum_le_sum
          intro f hf
          exact mul_le_mul_of_nonneg_left (hatom _ _)
            (birthForestAssignmentMass_nonneg _ _ (fun j a => hw j.castSucc a) f)
        _ = birthForestMass (birthForestCodeInit code) (fun j => w j.castSucc) * ε :=
          (sum_mul _ _ _).symm
        _ ≤ (ε ^ birthForestRank (birthForestCodeInit code) *
            M ^ (n - birthForestRank (birthForestCodeInit code))) * ε :=
          mul_le_mul_of_nonneg_right hprev hε
        _ = ε ^ (birthForestRank (birthForestCodeInit code) + 1) *
            M ^ (n + 1 - (birthForestRank (birthForestCodeInit code) + 1)) := by
          rw [pow_succ]
          simp only [Nat.add_sub_add_right]
          ring

/-- The local product is exactly the usual product of weights restricted to
assignments satisfying all forest equalities. -/
theorem birthForestAssignmentMass_eq {n : ℕ} {α : Type*}
    (code : BirthForestCode n) (w : Fin n → α → ℝ) (f : Fin n → α) :
    birthForestAssignmentMass code w f =
      if birthForestEqualValues code f then ∏ j, w j (f j) else 0 := by
  classical
  by_cases h : birthForestEqualValues code f
  · rw [if_pos h]
    apply prod_congr rfl
    intro j hj
    unfold birthForestLocalFactor
    cases hc : code j with
    | none => rfl
    | some p => simp [h j p hc]
  · rw [if_neg h]
    unfold birthForestEqualValues at h
    push Not at h
    obtain ⟨j, p, hc, hneq⟩ := h
    apply prod_eq_zero (mem_univ j)
    simp [birthForestLocalFactor, hc, hneq]

/-- The forest mass as a filtered finite sum, without auxiliary local factors. -/
theorem birthForestMass_eq_sum {n : ℕ} {α : Type*} [Fintype α]
    (code : BirthForestCode n) (w : Fin n → α → ℝ) :
    birthForestMass code w =
      ∑ f : Fin n → α with birthForestEqualValues code f, ∏ j, w j (f j) := by
  unfold birthForestMass
  simp_rw [birthForestAssignmentMass_eq]
  rw [sum_filter]

/-- Weighted mass of all assignments obeying every selected parent equality. -/
theorem birthForest_sum_le {n : ℕ} {α : Type*} [Fintype α]
    (code : BirthForestCode n) (w : Fin n → α → ℝ)
    {M ε : ℝ} (hM : 0 ≤ M) (hε : 0 ≤ ε)
    (hw : ∀ j a, 0 ≤ w j a)
    (hsum : ∀ j, (∑ a, w j a) ≤ M) (hatom : ∀ j a, w j a ≤ ε) :
    (∑ f : Fin n → α with birthForestEqualValues code f, ∏ j, w j (f j)) ≤
      ε ^ birthForestRank code * M ^ (n - birthForestRank code) := by
  rw [← birthForestMass_eq_sum]
  exact birthForestMass_le code w hM hε hw hsum hatom
end

section
open Finset Classical
/-- All values strictly before a specified birth. -/
def birthForestHistory {n : ℕ} {α : Type*} (f : Fin n → α) (j : Fin n) : Fin j.val → α :=
  fun p => f (birthForestParentEmbedding j p)

theorem birthForestHistory_snoc_castSucc {n : ℕ} {α : Type*}
    (f : Fin n → α) (a : α) (j : Fin n) :
    birthForestHistory (Fin.snoc f a) j.castSucc = birthForestHistory f j := by
  funext p
  unfold birthForestHistory
  rw [birthForestParentEmbedding_castSucc, Fin.snoc_castSucc]

theorem birthForestHistory_snoc_last {n : ℕ} {α : Type*} (f : Fin n → α) (a : α) :
    birthForestHistory (Fin.snoc f a) (Fin.last n) = f := by
  funext p
  unfold birthForestHistory
  rw [birthForestParentEmbedding_last, Fin.snoc_castSucc]

/-- A conditional weight may depend on every earlier birth value. -/
abbrev BirthForestCausalWeights (n : ℕ) (α : Type*) :=
  ∀ j : Fin n, (Fin j.val → α) → α → ℝ

noncomputable def birthForestCausalAssignmentMass {n : ℕ} {α : Type*}
    (code : BirthForestCode n) (w : BirthForestCausalWeights n α) (f : Fin n → α) : ℝ :=
  birthForestAssignmentMass code (fun j a => w j (birthForestHistory f j) a) f

noncomputable def birthForestCausalMass {n : ℕ} {α : Type*} [Fintype α]
    (code : BirthForestCode n) (w : BirthForestCausalWeights n α) : ℝ :=
  ∑ f : Fin n → α, birthForestCausalAssignmentMass code w f

theorem birthForestCausalAssignmentMass_nonneg {n : ℕ} {α : Type*}
    (code : BirthForestCode n) (w : BirthForestCausalWeights n α)
    (hw : ∀ j h a, 0 ≤ w j h a) (f : Fin n → α) :
    0 ≤ birthForestCausalAssignmentMass code w f :=
  birthForestAssignmentMass_nonneg code _ (fun j a => hw j _ a) f

/-- The last birth cannot affect any earlier conditional weight. -/
theorem birthForestCausalAssignmentMass_snoc {n : ℕ} {α : Type*}
    (code : BirthForestCode (n + 1)) (w : BirthForestCausalWeights (n + 1) α)
    (f : Fin n → α) (a : α) :
    birthForestCausalAssignmentMass code w (Fin.snoc f a) =
      birthForestCausalAssignmentMass (birthForestCodeInit code) (fun j => w j.castSucc) f *
        (match code (Fin.last n) with
        | none => w (Fin.last n) f a
        | some p => if a = f p then w (Fin.last n) f a else 0) := by
  unfold birthForestCausalAssignmentMass
  rw [birthForestAssignmentMass_snoc]
  cases code (Fin.last n) <;>
    simp only [birthForestHistory_snoc_castSucc, birthForestHistory_snoc_last]

/-- Exact conditional summation over the last birth. -/
theorem birthForestCausalMass_last {n : ℕ} {α : Type*} [Fintype α]
    (code : BirthForestCode (n + 1)) (w : BirthForestCausalWeights (n + 1) α) :
    birthForestCausalMass code w =
      match code (Fin.last n) with
      | none => ∑ f : Fin n → α,
          birthForestCausalAssignmentMass (birthForestCodeInit code) (fun j => w j.castSucc) f *
            ∑ a, w (Fin.last n) f a
      | some p => ∑ f : Fin n → α,
          birthForestCausalAssignmentMass (birthForestCodeInit code) (fun j => w j.castSucc) f *
            w (Fin.last n) f (f p) := by
  unfold birthForestCausalMass
  rw [← (Fin.snocEquiv (fun _ : Fin (n + 1) => α)).sum_comp]
  rw [Fintype.sum_prod_type, sum_comm]
  change (∑ f : Fin n → α, ∑ a : α, birthForestCausalAssignmentMass code w (Fin.snoc f a)) = _
  simp only [birthForestCausalAssignmentMass_snoc]
  cases code (Fin.last n) with
  | none => simp [← mul_sum]
  | some p => simp

/-- One chronological integration costs at most M for a root or ε for a child,
uniformly over all retained earlier values. -/
theorem birthForestCausalMass_step_le {n : ℕ} {α : Type*} [Fintype α]
    (code : BirthForestCode (n + 1)) (w : BirthForestCausalWeights (n + 1) α)
    {M ε : ℝ} (hw : ∀ j h a, 0 ≤ w j h a)
    (hsum : ∀ j h, (∑ a, w j h a) ≤ M) (hatom : ∀ j h a, w j h a ≤ ε) :
    birthForestCausalMass code w ≤
      birthForestCausalMass (birthForestCodeInit code) (fun j => w j.castSucc) *
        (match code (Fin.last n) with | none => M | some _ => ε) := by
  rw [birthForestCausalMass_last]
  cases code (Fin.last n) with
  | none =>
    dsimp only
    rw [birthForestCausalMass, sum_mul]
    apply sum_le_sum
    intro f hf
    exact mul_le_mul_of_nonneg_left (hsum _ _)
      (birthForestCausalAssignmentMass_nonneg _ _ (fun j h a => hw j.castSucc h a) f)
  | some p =>
    dsimp only
    rw [birthForestCausalMass, sum_mul]
    apply sum_le_sum
    intro f hf
    exact mul_le_mul_of_nonneg_left (hatom _ _ _)
      (birthForestCausalAssignmentMass_nonneg _ _ (fun j h a => hw j.castSucc h a) f)

/-- Chronological forest integration with arbitrary causal conditional weights. -/
theorem birthForestCausalMass_le {n : ℕ} {α : Type*} [Fintype α]
    (code : BirthForestCode n) (w : BirthForestCausalWeights n α)
    {M ε : ℝ} (hM : 0 ≤ M) (hε : 0 ≤ ε)
    (hw : ∀ j h a, 0 ≤ w j h a)
    (hsum : ∀ j h, (∑ a, w j h a) ≤ M) (hatom : ∀ j h a, w j h a ≤ ε) :
    birthForestCausalMass code w ≤ ε ^ birthForestRank code * M ^ (n - birthForestRank code) := by
  induction n with
  | zero =>
    have hr : birthForestRank code = 0 := Nat.eq_zero_of_le_zero (birthForestRank_le code)
    simp [birthForestCausalMass, birthForestCausalAssignmentMass, birthForestAssignmentMass, hr]
  | succ n ih =>
    have hprev := ih (birthForestCodeInit code) (fun j => w j.castSucc)
      (fun j h a => hw j.castSucc h a) (fun j h => hsum j.castSucc h)
      (fun j h a => hatom j.castSucc h a)
    have hr := birthForestRank_init code
    have hrle := birthForestRank_le (birthForestCodeInit code)
    have hstep := birthForestCausalMass_step_le code w hw hsum hatom
    cases hc : code (Fin.last n) with
    | none =>
      simp only [hc, Nat.add_zero] at hr hstep
      rw [hr]
      calc
        birthForestCausalMass code w ≤
            birthForestCausalMass (birthForestCodeInit code) (fun j => w j.castSucc) * M := hstep
        _ ≤ (ε ^ birthForestRank (birthForestCodeInit code) *
            M ^ (n - birthForestRank (birthForestCodeInit code))) * M :=
          mul_le_mul_of_nonneg_right hprev hM
        _ = ε ^ birthForestRank (birthForestCodeInit code) *
            M ^ (n + 1 - birthForestRank (birthForestCodeInit code)) := by
          rw [show n + 1 - birthForestRank (birthForestCodeInit code) =
            (n - birthForestRank (birthForestCodeInit code)) + 1 by omega, pow_succ]
          ring
    | some p =>
      simp only [hc] at hr hstep
      rw [hr]
      calc
        birthForestCausalMass code w ≤
            birthForestCausalMass (birthForestCodeInit code) (fun j => w j.castSucc) * ε := hstep
        _ ≤ (ε ^ birthForestRank (birthForestCodeInit code) *
            M ^ (n - birthForestRank (birthForestCodeInit code))) * ε :=
          mul_le_mul_of_nonneg_right hprev hε
        _ = ε ^ (birthForestRank (birthForestCodeInit code) + 1) *
            M ^ (n + 1 - (birthForestRank (birthForestCodeInit code) + 1)) := by
          rw [pow_succ]
          simp only [Nat.add_sub_add_right]
          ring

/-- Causal mass is exactly the filtered product of the conditional weights. -/
theorem birthForestCausalMass_eq_sum {n : ℕ} {α : Type*} [Fintype α]
    (code : BirthForestCode n) (w : BirthForestCausalWeights n α) :
    birthForestCausalMass code w =
      ∑ f : Fin n → α with birthForestEqualValues code f,
        ∏ j, w j (birthForestHistory f j) (f j) := by
  unfold birthForestCausalMass birthForestCausalAssignmentMass
  simp_rw [birthForestAssignmentMass_eq]
  rw [sum_filter]

/-- Explicit finite conditional forest sum bound. -/
theorem birthForest_causal_sum_le {n : ℕ} {α : Type*} [Fintype α]
    (code : BirthForestCode n) (w : BirthForestCausalWeights n α)
    {M ε : ℝ} (hM : 0 ≤ M) (hε : 0 ≤ ε)
    (hw : ∀ j h a, 0 ≤ w j h a)
    (hsum : ∀ j h, (∑ a, w j h a) ≤ M) (hatom : ∀ j h a, w j h a ≤ ε) :
    (∑ f : Fin n → α with birthForestEqualValues code f,
      ∏ j, w j (birthForestHistory f j) (f j)) ≤
        ε ^ birthForestRank code * M ^ (n - birthForestRank code) := by
  rw [← birthForestCausalMass_eq_sum]
  exact birthForestCausalMass_le code w hM hε hw hsum hatom

/-- Performed-birth compatibility includes every selected equality. -/
theorem birthForestCompatible_equalValues {n : ℕ} {α : Type*}
    (performed : Fin n → Prop) (f : Fin n → α) (code : BirthForestCode n)
    (h : birthForestCompatible performed f code) : birthForestEqualValues code f := by
  intro j p hp
  have hj := h j
  rw [hp] at hj
  exact hj.2.2.symm

/-- Additional performed flags can depend arbitrarily on the assignment:
they only restrict the nonnegative sum, so the causal forest bound still holds. -/
theorem birthForest_performed_causal_sum_le {n : ℕ} {α : Type*} [Fintype α]
    (code : BirthForestCode n) (performed : (Fin n → α) → Fin n → Prop)
    (w : BirthForestCausalWeights n α)
    {M ε : ℝ} (hM : 0 ≤ M) (hε : 0 ≤ ε)
    (hw : ∀ j h a, 0 ≤ w j h a)
    (hsum : ∀ j h, (∑ a, w j h a) ≤ M) (hatom : ∀ j h a, w j h a ≤ ε) :
    (∑ f : Fin n → α with birthForestCompatible (performed f) f code,
      ∏ j, w j (birthForestHistory f j) (f j)) ≤
        ε ^ birthForestRank code * M ^ (n - birthForestRank code) := by
  calc
    (∑ f : Fin n → α with birthForestCompatible (performed f) f code,
        ∏ j, w j (birthForestHistory f j) (f j)) ≤
      ∑ f : Fin n → α with birthForestEqualValues code f,
        ∏ j, w j (birthForestHistory f j) (f j) := by
          apply sum_le_sum_of_subset_of_nonneg
          · intro f hf
            exact mem_filter.mpr ⟨mem_univ _,
              birthForestCompatible_equalValues (performed f) f code (mem_filter.mp hf).2⟩
          · intro f hf hnot
            exact prod_nonneg fun j hj => hw j _ _
    _ ≤ ε ^ birthForestRank code * M ^ (n - birthForestRank code) :=
      birthForest_causal_sum_le code w hM hε hw hsum hatom

/-- The performed-birth version with independent per-birth weights. -/
theorem birthForest_performed_sum_le {n : ℕ} {α : Type*} [Fintype α]
    (code : BirthForestCode n) (performed : (Fin n → α) → Fin n → Prop)
    (w : Fin n → α → ℝ) {M ε : ℝ} (hM : 0 ≤ M) (hε : 0 ≤ ε)
    (hw : ∀ j a, 0 ≤ w j a)
    (hsum : ∀ j, (∑ a, w j a) ≤ M) (hatom : ∀ j a, w j a ≤ ε) :
    (∑ f : Fin n → α with birthForestCompatible (performed f) f code,
      ∏ j, w j (f j)) ≤ ε ^ birthForestRank code * M ^ (n - birthForestRank code) := by
  exact birthForest_performed_causal_sum_le code performed (fun j _ a => w j a)
    hM hε (fun j _ a => hw j a) (fun j _ => hsum j) (fun j _ a => hatom j a)
end

section
open Finset MeasureTheory
open scoped BigOperators
/-- Net frequency at a vertex: incoming frequencies minus outgoing ones. -/
noncomputable def birthEdgeLocalFrequency {n : ℕ}
    (E : Finset (Fin n × Fin n)) (θ : (Fin n × Fin n) → ℝ) (j : Fin n) : ℝ :=
  (∑ e ∈ E with e.2 = j, θ e) - ∑ e ∈ E with e.1 = j, θ e

/-- Net frequency at one birth of a forest code. -/
noncomputable def birthForestLocalFrequency {n : ℕ} (code : BirthForestCode n)
    (θ : (Fin n × Fin n) → ℝ) (j : Fin n) : ℝ :=
  birthEdgeLocalFrequency (birthForestEdges code) θ j

/-- Collecting a weighted edge sum by its endpoint. -/
theorem birth_edge_incidence_sum {V E : Type*} [Fintype V] [DecidableEq V]
    (edges : Finset E) (endpoint : E → V) (θ : E → ℝ) (f : V → ℝ) :
    (∑ j : V, (∑ e ∈ edges with endpoint e = j, θ e) * f j) =
      ∑ e ∈ edges, θ e * f (endpoint e) := by
  simp only [sum_mul, sum_filter]
  rw [sum_comm]
  simp

/-- The edge differences pair with precisely the net vertex frequencies. -/
theorem birth_edge_frequency_pairing {n : ℕ} (E : Finset (Fin n × Fin n))
    (θ : (Fin n × Fin n) → ℝ) (f : Fin n → ℝ) :
    (∑ e ∈ E, θ e * (f e.2 - f e.1)) =
      ∑ j : Fin n, birthEdgeLocalFrequency E θ j * f j := by
  simp only [birthEdgeLocalFrequency, sub_mul, mul_sub, sum_sub_distrib]
  rw [birth_edge_incidence_sum, birth_edge_incidence_sum]

/-- Products of phases are exponentials of the corresponding weighted sum. -/
theorem physicalReturnPhase_weighted_product {E : Type*} (edges : Finset E)
    (θ : E → ℝ) (f : E → ℤ) :
    (∏ e ∈ edges, physicalReturnPhase (θ e) (f e)) =
      Complex.exp (2 * (Real.pi : ℂ) * Complex.I *
        ((∑ e ∈ edges, θ e * (f e : ℝ) : ℝ) : ℂ)) := by
  simp only [physicalReturnPhase, ← Complex.exp_sum]
  congr 1
  push_cast
  rw [mul_sum]
  apply sum_congr rfl
  intro e _
  ring

/-- The product of edge phases factors into one local phase per vertex. -/
theorem birth_edge_phases_eq_vertex_phases {n : ℕ} (E : Finset (Fin n × Fin n))
    (θ : (Fin n × Fin n) → ℝ) (f : Fin n → ℤ) :
    (∏ e ∈ E, physicalReturnPhase (θ e) (f e.2 - f e.1)) =
      ∏ j : Fin n, physicalReturnPhase (birthEdgeLocalFrequency E θ j) (f j) := by
  rw [physicalReturnPhase_weighted_product, physicalReturnPhase_weighted_product]
  have h := birth_edge_frequency_pairing E θ (fun j => (f j : ℝ))
  exact congrArg (fun a : ℝ => Complex.exp (2 * (Real.pi : ℂ) * Complex.I * (a : ℂ)))
    (by simpa only [Int.cast_sub] using h)

/-- The edge-to-birth phase factorization for a forest code. -/
theorem birth_forest_phases_eq_local_phases {n : ℕ} (code : BirthForestCode n)
    (θ : (Fin n × Fin n) → ℝ) (f : Fin n → ℤ) :
    (∏ e ∈ birthForestEdges code, physicalReturnPhase (θ e) (f e.2 - f e.1)) =
      ∏ j : Fin n, physicalReturnPhase (birthForestLocalFrequency code θ j) (f j) :=
  birth_edge_phases_eq_vertex_phases (birthForestEdges code) θ f

/-- An untouched birth has no incoming or outgoing frequency. -/
theorem birthForestLocalFrequency_eq_zero_of_not_touched {n : ℕ}
    (code : BirthForestCode n) (θ : (Fin n × Fin n) → ℝ) (j : Fin n)
    (hj : j ∉ birthForestTouched code) : birthForestLocalFrequency code θ j = 0 := by
  have hp : ∀ e ∈ birthForestEdges code, e.1 ≠ j := by
    intro e he hej
    exact hj (mem_union.mpr (Or.inl (mem_image.mpr ⟨e, he, hej⟩)))
  have hc : ∀ e ∈ birthForestEdges code, e.2 ≠ j := by
    intro e he hej
    exact hj (mem_union.mpr (Or.inr (mem_image.mpr ⟨e, he, hej⟩)))
  have hpempty : (birthForestEdges code).filter (fun e => e.1 = j) = ∅ :=
    filter_eq_empty_iff.mpr hp
  have hcempty : (birthForestEdges code).filter (fun e => e.2 = j) = ∅ :=
    filter_eq_empty_iff.mpr hc
  simp only [birthForestLocalFrequency, birthEdgeLocalFrequency, hpempty, hcempty,
    sum_empty, sub_self]

/-- A zero frequency gives the constant unit phase. -/
theorem physicalReturnPhase_frequency_zero (h : ℤ) : physicalReturnPhase 0 h = 1 := by
  simp [physicalReturnPhase]

/-- The phase at an untouched birth is identically one. -/
theorem birth_forest_phase_eq_one_of_not_touched {n : ℕ}
    (code : BirthForestCode n) (θ : (Fin n × Fin n) → ℝ) (f : Fin n → ℤ) (j : Fin n)
    (hj : j ∉ birthForestTouched code) :
    physicalReturnPhase (birthForestLocalFrequency code θ j) (f j) = 1 := by
  rw [birthForestLocalFrequency_eq_zero_of_not_touched code θ j hj,
    physicalReturnPhase_frequency_zero]

/-- Nonzero local frequencies can occur only at touched births. -/
theorem birth_forest_frequency_support_subset {n : ℕ} (code : BirthForestCode n)
    (θ : (Fin n × Fin n) → ℝ) :
    (univ.filter (fun j => birthForestLocalFrequency code θ j ≠ 0)) ⊆ birthForestTouched code := by
  intro j hj
  by_contra hnot
  exact (mem_filter.mp hj).2 (birthForestLocalFrequency_eq_zero_of_not_touched code θ j hnot)

/-- At most twice the forest rank many births carry nonzero frequency. -/
theorem birth_forest_frequency_support_card_le {n : ℕ} (code : BirthForestCode n)
    (θ : (Fin n × Fin n) → ℝ) :
    (univ.filter (fun j => birthForestLocalFrequency code θ j ≠ 0)).card ≤
      2 * birthForestRank code :=
  (card_le_card (birth_forest_frequency_support_subset code θ)).trans
    (birthForestTouched_card_le code)

/-- Every real-frequency Fourier phase has norm one. -/
theorem physicalReturnPhase_norm (θ : ℝ) (h : ℤ) : ‖physicalReturnPhase θ h‖ = 1 := by
  simp [physicalReturnPhase, Complex.norm_exp, Complex.mul_re, Complex.mul_im]

/-- In particular, collecting edge phases preserves the unit local bound. -/
theorem birth_forest_local_phase_norm {n : ℕ} (code : BirthForestCode n)
    (θ : (Fin n × Fin n) → ℝ) (f : Fin n → ℤ) (j : Fin n) :
    ‖physicalReturnPhase (birthForestLocalFrequency code θ j) (f j)‖ = 1 :=
  physicalReturnPhase_norm _ _

/-- Exact equality constraints are the product of their one-dimensional
Fourier integrals. No multidimensional integration is used here. -/
theorem birth_edge_equalities_fourier {n : ℕ} (E : Finset (Fin n × Fin n)) (f : Fin n → ℤ) :
    (if ∀ e ∈ E, f e.2 = f e.1 then (1 : ℂ) else 0) =
      ∏ e ∈ E, ∫ t : ℝ in (0 : ℝ)..1, physicalReturnPhase t (f e.2 - f e.1) := by
  simp_rw [physicalReturnPhase_integral, sub_eq_zero]
  rw [Finset.prod_boole]
  split_ifs <;> rfl

/-- The same exact Fourier representation for all selected forest edges. -/
theorem birth_forest_equalities_fourier {n : ℕ} (code : BirthForestCode n) (f : Fin n → ℤ) :
    (if ∀ e ∈ birthForestEdges code, f e.2 = f e.1 then (1 : ℂ) else 0) =
      ∏ e ∈ birthForestEdges code,
        ∫ t : ℝ in (0 : ℝ)..1, physicalReturnPhase t (f e.2 - f e.1) :=
  birth_edge_equalities_fourier (birthForestEdges code) f

/-- Each integrated equality factor has norm at most one. -/
theorem physicalReturnPhase_integral_norm_le_one (h : ℤ) :
    ‖∫ t : ℝ in (0 : ℝ)..1, physicalReturnPhase t h‖ ≤ 1 := by
  rw [physicalReturnPhase_integral]
  split_ifs <;> norm_num
end

section
open Finset Classical
/-- Split a finite forest expansion at any rank threshold. -/
theorem birthForest_rank_split {M : Type*} [AddCommMonoid M] {n : ℕ}
    (F : BirthForestCode n → M) (r₀ : ℕ) :
    (∑ code : BirthForestCode n, F code) =
      (∑ code ∈ univ.filter (fun code => birthForestRank code < r₀), F code) +
        ∑ code ∈ univ.filter (fun code => r₀ ≤ birthForestRank code), F code := by
  simpa only [not_lt] using
    (sum_filter_add_sum_filter_not univ (fun code => birthForestRank code < r₀) F).symm

/-- Group a high-rank scalar envelope by its exact rank multiplicity. -/
theorem sum_birthForestRank_tail (n r₀ : ℕ) (B : ℕ → ℝ) :
    (∑ code ∈ (univ : Finset (BirthForestCode n)).filter
        (fun code => r₀ ≤ birthForestRank code), B (birthForestRank code)) =
      ∑ r ∈ Ico r₀ (n + 1), (birthForestCodesOfRank n r).card * B r := by
  rw [sum_filter, sum_birthForestRank_envelope n (fun r => if r₀ ≤ r then B r else 0)]
  simp_rw [mul_ite, mul_zero]
  rw [← sum_filter]
  congr 1
  ext r
  simp only [mem_filter, mem_range, mem_Ico, and_comm]

/-- A geometric point-mass gain per independent equality beats the number
of forest constraints. The bound includes n=0 and arbitrary thresholds. -/
theorem birthForest_rank_tail_norm_le {n : ℕ} (F : BirthForestCode n → ℂ)
    (r₀ : ℕ) {H ε : ℝ} (hH : 0 ≤ H) (hε : 0 ≤ ε)
    (hδ : (n : ℝ) ^ 2 * ε < 1)
    (hF : ∀ code, r₀ ≤ birthForestRank code →
      ‖F code‖ ≤ H * ε ^ birthForestRank code) :
    ‖∑ code ∈ (univ : Finset (BirthForestCode n)).filter
        (fun code => r₀ ≤ birthForestRank code),
      (-1 : ℂ) ^ birthForestRank code * F code‖ ≤
      H * ((n : ℝ) ^ 2 * ε) ^ r₀ / (1 - (n : ℝ) ^ 2 * ε) := by
  have hδ0 : 0 ≤ (n : ℝ) ^ 2 * ε := mul_nonneg (sq_nonneg _) hε
  calc
    ‖∑ code ∈ (univ : Finset (BirthForestCode n)).filter
        (fun code => r₀ ≤ birthForestRank code),
      (-1 : ℂ) ^ birthForestRank code * F code‖ ≤
        ∑ code ∈ (univ : Finset (BirthForestCode n)).filter
          (fun code => r₀ ≤ birthForestRank code),
          ‖(-1 : ℂ) ^ birthForestRank code * F code‖ := norm_sum_le _ _
    _ = ∑ code ∈ (univ : Finset (BirthForestCode n)).filter
          (fun code => r₀ ≤ birthForestRank code), ‖F code‖ := by
      simp only [norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
    _ ≤ ∑ code ∈ (univ : Finset (BirthForestCode n)).filter
          (fun code => r₀ ≤ birthForestRank code), H * ε ^ birthForestRank code :=
      sum_le_sum (fun code hc => hF code (mem_filter.mp hc).2)
    _ = ∑ r ∈ Ico r₀ (n + 1), (birthForestCodesOfRank n r).card * (H * ε ^ r) :=
      sum_birthForestRank_tail n r₀ (fun r => H * ε ^ r)
    _ ≤ ∑ r ∈ Ico r₀ (n + 1), H * ((n : ℝ) ^ 2 * ε) ^ r := by
      apply sum_le_sum
      intro r _
      have hc : ((birthForestCodesOfRank n r).card : ℝ) ≤ (n : ℝ) ^ (2 * r) := by
        exact_mod_cast birthForestCodesOfRank_card_le_pow n r
      calc
        ((birthForestCodesOfRank n r).card : ℝ) * (H * ε ^ r) ≤
            (n : ℝ) ^ (2 * r) * (H * ε ^ r) :=
          mul_le_mul_of_nonneg_right hc (mul_nonneg hH (pow_nonneg hε r))
        _ = H * ((n : ℝ) ^ 2 * ε) ^ r := by
          rw [mul_pow, pow_mul]
          ring
    _ = H * ∑ r ∈ Ico r₀ (n + 1), ((n : ℝ) ^ 2 * ε) ^ r := (mul_sum _ _ _).symm
    _ ≤ H * (((n : ℝ) ^ 2 * ε) ^ r₀ / (1 - (n : ℝ) ^ 2 * ε)) :=
      mul_le_mul_of_nonneg_left (geom_sum_Ico_le_of_lt_one hδ0 hδ) hH
    _ = H * ((n : ℝ) ^ 2 * ε) ^ r₀ / (1 - (n : ℝ) ^ 2 * ε) := by rw [mul_div_assoc]
end

section
open Finset Classical
/-- The causal mass proof needs atom bounds only at addresses which actually
choose a parent. Root addresses require only the total-mass bound. -/
theorem birthForestCausalMass_le_of_edge_atom {n : ℕ} {α : Type*} [Fintype α]
    (code : BirthForestCode n) (w : BirthForestCausalWeights n α)
    {M ε : ℝ} (hM : 0 ≤ M) (hε : 0 ≤ ε)
    (hw : ∀ j h a, 0 ≤ w j h a)
    (hsum : ∀ j h, (∑ a, w j h a) ≤ M)
    (hatom : ∀ j p, code j = some p → ∀ h a, w j h a ≤ ε) :
    birthForestCausalMass code w ≤ ε ^ birthForestRank code * M ^ (n - birthForestRank code) := by
  induction n with
  | zero =>
    have hr : birthForestRank code = 0 := Nat.eq_zero_of_le_zero (birthForestRank_le code)
    simp [birthForestCausalMass, birthForestCausalAssignmentMass, birthForestAssignmentMass, hr]
  | succ n ih =>
    have hprev := ih (birthForestCodeInit code) (fun j => w j.castSucc)
      (fun j h a => hw j.castSucc h a) (fun j h => hsum j.castSucc h)
      (fun j p hp h a => hatom j.castSucc p hp h a)
    have hr := birthForestRank_init code
    have hrle := birthForestRank_le (birthForestCodeInit code)
    rw [birthForestCausalMass_last]
    cases hc : code (Fin.last n) with
    | none =>
      simp only [hc, Nat.add_zero] at hr ⊢
      rw [hr]
      calc
        (∑ f : Fin n → α, birthForestCausalAssignmentMass (birthForestCodeInit code)
            (fun j => w j.castSucc) f * ∑ a, w (Fin.last n) f a) ≤
          ∑ f : Fin n → α, birthForestCausalAssignmentMass (birthForestCodeInit code)
            (fun j => w j.castSucc) f * M := by
          apply sum_le_sum
          intro f hf
          exact mul_le_mul_of_nonneg_left (hsum _ _)
            (birthForestCausalAssignmentMass_nonneg _ _ (fun j h a => hw j.castSucc h a) f)
        _ = birthForestCausalMass (birthForestCodeInit code) (fun j => w j.castSucc) * M :=
          (sum_mul _ _ _).symm
        _ ≤ (ε ^ birthForestRank (birthForestCodeInit code) *
            M ^ (n - birthForestRank (birthForestCodeInit code))) * M :=
          mul_le_mul_of_nonneg_right hprev hM
        _ = ε ^ birthForestRank (birthForestCodeInit code) *
            M ^ (n + 1 - birthForestRank (birthForestCodeInit code)) := by
          rw [show n + 1 - birthForestRank (birthForestCodeInit code) =
            (n - birthForestRank (birthForestCodeInit code)) + 1 by omega, pow_succ]
          ring
    | some p =>
      simp only [hc] at hr ⊢
      rw [hr]
      calc
        (∑ f : Fin n → α, birthForestCausalAssignmentMass (birthForestCodeInit code)
            (fun j => w j.castSucc) f * w (Fin.last n) f (f p)) ≤
          ∑ f : Fin n → α, birthForestCausalAssignmentMass (birthForestCodeInit code)
            (fun j => w j.castSucc) f * ε := by
          apply sum_le_sum
          intro f hf
          exact mul_le_mul_of_nonneg_left (hatom (Fin.last n) p hc f (f p))
            (birthForestCausalAssignmentMass_nonneg _ _ (fun j h a => hw j.castSucc h a) f)
        _ = birthForestCausalMass (birthForestCodeInit code) (fun j => w j.castSucc) * ε :=
          (sum_mul _ _ _).symm
        _ ≤ (ε ^ birthForestRank (birthForestCodeInit code) *
            M ^ (n - birthForestRank (birthForestCodeInit code))) * ε :=
          mul_le_mul_of_nonneg_right hprev hε
        _ = ε ^ (birthForestRank (birthForestCodeInit code) + 1) *
            M ^ (n + 1 - (birthForestRank (birthForestCodeInit code) + 1)) := by
          rw [pow_succ]
          simp only [Nat.add_sub_add_right]
          ring

/-- A selected child cannot be inactive. Root weights are unchanged. -/
noncomputable def birthForestOptionalWeights {n : ℕ} {α : Type*}
    (code : BirthForestCode n) (w : BirthForestCausalWeights n (Option α)) :
    BirthForestCausalWeights n (Option α) :=
  fun j h a => match code j, a with
    | some _, none => 0
    | _, _ => w j h a

theorem birthForestOptionalWeights_nonneg {n : ℕ} {α : Type*}
    (code : BirthForestCode n) (w : BirthForestCausalWeights n (Option α))
    (hw : ∀ j h a, 0 ≤ w j h a) :
    ∀ j h a, 0 ≤ birthForestOptionalWeights code w j h a := by
  intro j h a
  unfold birthForestOptionalWeights
  cases code j <;> cases a <;> simp [hw]

theorem birthForestOptionalWeights_le {n : ℕ} {α : Type*}
    (code : BirthForestCode n) (w : BirthForestCausalWeights n (Option α))
    (hw : ∀ j h a, 0 ≤ w j h a) :
    ∀ j h a, birthForestOptionalWeights code w j h a ≤ w j h a := by
  intro j h a
  unfold birthForestOptionalWeights
  cases code j <;> cases a <;> simp [hw]

/-- Pruning inactive child weights enforces precisely the performed=isSome
forest constraints; a parent of an active equal-valued child is also active. -/
theorem birthForestOptionalWeights_assignment_eq {n : ℕ} {α : Type*}
    (code : BirthForestCode n) (w : BirthForestCausalWeights n (Option α))
    (f : Fin n → Option α) :
    birthForestCausalAssignmentMass code (birthForestOptionalWeights code w) f =
      if birthForestCompatible (fun j => (f j).isSome) f code then
        ∏ j, w j (birthForestHistory f j) (f j) else 0 := by
  unfold birthForestCausalAssignmentMass
  rw [birthForestAssignmentMass_eq]
  by_cases h : birthForestCompatible (fun j => (f j).isSome) f code
  · rw [if_pos h, if_pos (birthForestCompatible_equalValues _ _ _ h)]
    apply prod_congr rfl
    intro j hj
    cases hc : code j with
    | none => simp [birthForestOptionalWeights, hc]
    | some p =>
      have hj' := h j
      rw [hc] at hj'
      have hactive : (f j).isSome := hj'.2.1
      cases hf : f j with
      | none => simp [hf] at hactive
      | some a => simp [birthForestOptionalWeights, hc]
  · rw [if_neg h]
    by_cases he : birthForestEqualValues code f
    · rw [if_pos he]
      have hbad : ∃ (j : Fin n) (p : Fin j.val), code j = some p ∧ f j = none := by
        by_contra hno
        push Not at hno
        apply h
        intro j
        cases hc : code j with
        | none => trivial
        | some p =>
          have heq := he j p hc
          have ha : (f j).isSome := Option.ne_none_iff_isSome.mp (hno j p hc)
          exact ⟨by simpa only [← heq] using ha, ha, heq.symm⟩
      obtain ⟨j, p, hc, hf⟩ := hbad
      apply prod_eq_zero (mem_univ j)
      simp [birthForestOptionalWeights, hc, hf]
    · rw [if_neg he]

theorem birthForestOptionalWeights_mass_eq_sum {n : ℕ} {α : Type*} [Fintype α]
    (code : BirthForestCode n) (w : BirthForestCausalWeights n (Option α)) :
    birthForestCausalMass code (birthForestOptionalWeights code w) =
      ∑ f : Fin n → Option α with birthForestCompatible (fun j => (f j).isSome) f code,
        ∏ j, w j (birthForestHistory f j) (f j) := by
  unfold birthForestCausalMass
  simp_rw [birthForestOptionalWeights_assignment_eq]
  rw [sum_filter]

/-- Optional chronological forest bound. The inactive atom `none` is constrained
only by the total mass M; the small bound ε is required solely for active atoms.
Selected edges require both endpoint births to be active and have equal values. -/
theorem birthForest_optional_causal_sum_le {n : ℕ} {α : Type*} [Fintype α]
    (code : BirthForestCode n) (w : BirthForestCausalWeights n (Option α))
    {M ε : ℝ} (hM : 0 ≤ M) (hε : 0 ≤ ε)
    (hw : ∀ j h a, 0 ≤ w j h a)
    (hsum : ∀ j h, (∑ a, w j h a) ≤ M)
    (hactive : ∀ j h (a : α), w j h (some a) ≤ ε) :
    (∑ f : Fin n → Option α with birthForestCompatible (fun j => (f j).isSome) f code,
      ∏ j, w j (birthForestHistory f j) (f j)) ≤
        ε ^ birthForestRank code * M ^ (n - birthForestRank code) := by
  rw [← birthForestOptionalWeights_mass_eq_sum]
  apply birthForestCausalMass_le_of_edge_atom code _ hM hε
    (birthForestOptionalWeights_nonneg code w hw)
  · intro j h
    exact (sum_le_sum (fun a _ => birthForestOptionalWeights_le code w hw j h a)).trans (hsum j h)
  · intro j p hp h a
    cases a with
    | none => simpa [birthForestOptionalWeights, hp] using hε
    | some a => simpa [birthForestOptionalWeights, hp] using hactive j h a
end

section

noncomputable def tiltedPhysicalBirthLaw {G : Type*} {P : G → Finset ℕ}
    (V : G → ℝ) (g : G) (b : P g → ℝ) (p : P g) : ℝ :=
  physicalLabelLaw V g p / b p

theorem tiltedPhysicalBirthLaw_nonneg {G : Type*} {P : G → Finset ℕ}
    (V : G → ℝ) (g : G) (b : P g → ℝ) (hV : 0 ≤ V g)
    (hb : ∀ p, 0 ≤ b p) (p : P g) : 0 ≤ tiltedPhysicalBirthLaw V g b p := by
  exact div_nonneg (div_nonneg zero_le_one
    (mul_nonneg hV (Nat.cast_nonneg p.val))) (hb p)

theorem tiltedPhysicalBirthLaw_sum_bounds {G : Type*} {P : G → Finset ℕ}
    (V : G → ℝ) (g : G) (b : P g → ℝ) (hV : 0 < V g)
    (hMass : ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (hb : ∀ p, 1 / 2 ≤ b p ∧ b p ≤ 1) :
    1 ≤ ∑ p : P g, tiltedPhysicalBirthLaw V g b p ∧
      (∑ p : P g, tiltedPhysicalBirthLaw V g b p) ≤ 2 :=
  memory_tilted_physical_label_mass V g b hV hMass hb

/-- A lower bound for the prime labels gives a uniform fresh-atom bound. -/
theorem tiltedPhysicalBirthLaw_atom_le {G : Type*} {P : G → Finset ℕ}
    (V : G → ℝ) (g : G) (b : P g → ℝ) (hV : 0 < V g)
    {P₀ : ℝ} (hP₀ : 0 < P₀) (p : P g) (hp : P₀ ≤ (p.val : ℝ))
    (hb : 1 / 2 ≤ b p) :
    tiltedPhysicalBirthLaw V g b p ≤ 2 / (V g * P₀) := by
  have hb0 : 0 < b p := by linarith
  have hden : 0 < V g * (P₀ / 2) := mul_pos hV (by positivity)
  have hmul : P₀ / 2 ≤ (p.val : ℝ) * b p := by
    calc
      P₀ / 2 = P₀ * (1 / 2) := by ring
      _ ≤ (p.val : ℝ) * b p := mul_le_mul hp hb (by norm_num) (le_trans hP₀.le hp)
  calc
    tiltedPhysicalBirthLaw V g b p = 1 / (V g * ((p.val : ℝ) * b p)) := by
      unfold tiltedPhysicalBirthLaw physicalLabelLaw
      rw [div_div, mul_assoc]
    _ ≤ 1 / (V g * (P₀ / 2)) :=
      one_div_le_one_div_of_le hden (mul_le_mul_of_nonneg_left hmul hV.le)
    _ = 2 / (V g * P₀) := by ring

/-- The ghost birth's factor V cancels the label-law normalization. -/
theorem tiltedPhysicalBirthLaw_scaled_atom_le {G : Type*} {P : G → Finset ℕ}
    (V : G → ℝ) (g : G) (b : P g → ℝ) (hV : 0 < V g)
    {P₀ : ℝ} (hP₀ : 0 < P₀) (p : P g) (hp : P₀ ≤ (p.val : ℝ))
    (hb : 1 / 2 ≤ b p) :
    V g * tiltedPhysicalBirthLaw V g b p ≤ 2 / P₀ := by
  calc
    _ ≤ V g * (2 / (V g * P₀)) :=
      mul_le_mul_of_nonneg_left (tiltedPhysicalBirthLaw_atom_le V g b hV hP₀ p hp hb) hV.le
    _ = _ := by field_simp
end

section
open Finset Classical
noncomputable def orderedPinnedBirthMass {α : Type*} [Fintype α] {n : ℕ}
    (μ : α → ℝ) (pins : Finset (Fin n)) (target : Fin n → α) : ℝ :=
  ∑ f : Fin n → α with ∀ j ∈ pins, f j = target j, ∏ j, μ (f j)

/-- Pinned ordered integration is an exact product of atoms and total masses. -/
theorem orderedPinnedBirthMass_eq {α : Type*} [Fintype α] {n : ℕ}
    (μ : α → ℝ) (pins : Finset (Fin n)) (target : Fin n → α) :
    orderedPinnedBirthMass μ pins target =
      ∏ j : Fin n, if j ∈ pins then μ (target j) else ∑ a, μ a := by
  have hprod (f : Fin n → α) :
      (if ∀ j ∈ pins, f j = target j then ∏ j, μ (f j) else 0) =
        ∏ j, if j ∈ pins → f j = target j then μ (f j) else 0 := by
    rw [Fintype.prod_ite_zero]
    split_ifs <;> rfl
  unfold orderedPinnedBirthMass
  rw [sum_filter]
  simp_rw [hprod]
  rw [← Fintype.prod_sum (fun (j : Fin n) (a : α) =>
    if j ∈ pins → a = target j then μ a else 0)]
  apply prod_congr rfl
  intro j _
  by_cases hj : j ∈ pins <;> simp [hj]

theorem orderedPinnedBirthMass_nonneg {α : Type*} [Fintype α] {n : ℕ}
    (μ : α → ℝ) (pins : Finset (Fin n)) (target : Fin n → α)
    (hμ : ∀ a, 0 ≤ μ a) : 0 ≤ orderedPinnedBirthMass μ pins target := by
  exact sum_nonneg fun f _ => prod_nonneg fun j _ => hμ (f j)

/-- Each prescribed coordinate pays one atom rather than a full fresh mass. -/
theorem orderedPinnedBirthMass_le {α : Type*} [Fintype α] {n : ℕ}
    (μ : α → ℝ) (pins : Finset (Fin n)) (target : Fin n → α)
    {M ε : ℝ} (hμ : ∀ a, 0 ≤ μ a) (hsum : (∑ a, μ a) ≤ M)
    (hatom : ∀ a, μ a ≤ ε) :
    orderedPinnedBirthMass μ pins target ≤ ε ^ pins.card * M ^ (n - pins.card) := by
  rw [orderedPinnedBirthMass_eq]
  calc
    _ ≤ ∏ j : Fin n, if j ∈ pins then ε else M := by
      apply prod_le_prod₀
      · intro j _
        split_ifs
        · exact hμ _
        · exact sum_nonneg (fun a _ => hμ a)
      · intro j _
        split_ifs
        · exact hatom _
        · exact hsum
    _ = ε ^ pins.card * M ^ (n - pins.card) := by
      rw [prod_ite]
      simp [filter_not, card_sdiff]

/-- The factorial removes the batch-length growth even after d coordinates
have been prescribed. No extra binomial multiplicity is needed for fixed pins. -/
theorem ordered_pinned_batch_sum_le_exp (B d : ℕ) {c M ε : ℝ}
    (hc : 0 ≤ c) (hM : 0 ≤ M) (hε : 0 ≤ ε) :
    (∑ n ∈ Ico d (B + 1),
      c ^ n * (ε ^ d * M ^ (n - d)) / (n.factorial : ℝ)) ≤
      (c * ε) ^ d * Real.exp (c * M) := by
  calc
    _ ≤ ∑ n ∈ Ico d (B + 1),
        (c * ε) ^ d * ((c * M) ^ (n - d) / ((n - d).factorial : ℝ)) := by
      apply sum_le_sum
      intro n hn
      have hd : d ≤ n := (mem_Ico.mp hn).1
      have hfac : (((n - d).factorial : ℕ) : ℝ) ≤ (n.factorial : ℝ) := by
        exact_mod_cast Nat.factorial_le (Nat.sub_le n d)
      have heq : c ^ n * (ε ^ d * M ^ (n - d)) =
          (c * ε) ^ d * (c * M) ^ (n - d) := by
        have hcn : c ^ n = c ^ d * c ^ (n - d) := by
          rw [← pow_add, Nat.add_sub_of_le hd]
        rw [mul_pow, mul_pow, hcn]
        ring
      rw [heq, ← mul_div_assoc]
      exact div_le_div_of_nonneg_left (by positivity) (by positivity) hfac
    _ = (c * ε) ^ d *
        ∑ k ∈ range (B + 1 - d), (c * M) ^ k / (k.factorial : ℝ) := by
      rw [sum_Ico_eq_sum_range]
      simp only [Nat.add_sub_cancel_left, ← mul_sum]
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (Real.sum_le_exp_of_nonneg (mul_nonneg hc hM) _) (pow_nonneg (mul_nonneg hc hε) d)

/-- Ordered ghost batches retain their factorial normalization. The bound is
uniform in the cutoff and in the prescribed values of the pinned births. -/
theorem ordered_pinned_birth_batches_le {α : Type*} [Fintype α]
    (μ : α → ℝ) (B d : ℕ) (pins : ∀ n, Finset (Fin n))
    (target : ∀ n, Fin n → α) {c M ε : ℝ}
    (hc : 0 ≤ c) (hM : 0 ≤ M) (hε : 0 ≤ ε)
    (hμ : ∀ a, 0 ≤ μ a) (hsum : (∑ a, μ a) ≤ M) (hatom : ∀ a, μ a ≤ ε)
    (hcard : ∀ n ∈ Ico d (B + 1), (pins n).card = d) :
    (∑ n ∈ Ico d (B + 1), c ^ n * orderedPinnedBirthMass μ (pins n) (target n) /
      (n.factorial : ℝ)) ≤ (c * ε) ^ d * Real.exp (c * M) := by
  apply le_trans _ (ordered_pinned_batch_sum_le_exp B d hc hM hε)
  apply sum_le_sum
  intro n hn
  apply div_le_div_of_nonneg_right _ (by positivity)
  apply mul_le_mul_of_nonneg_left _ (pow_nonneg hc n)
  simpa only [hcard n hn] using orderedPinnedBirthMass_le μ (pins n) (target n) hμ hsum hatom

/-- The same factorial envelope for an arbitrary exclusive upper cutoff. -/
theorem ordered_pinned_batch_Ico_sum_le_exp (N d : ℕ) {c M ε : ℝ}
    (hc : 0 ≤ c) (hM : 0 ≤ M) (hε : 0 ≤ ε) :
    (∑ n ∈ Ico d N,
      c ^ n * (ε ^ d * M ^ (n - d)) / (n.factorial : ℝ)) ≤
      (c * ε) ^ d * Real.exp (c * M) := by
  cases N with
  | zero => simp only [Ico_eq_empty_of_le (Nat.zero_le d), sum_empty]; positivity
  | succ B => exact ordered_pinned_batch_sum_le_exp B d hc hM hε
end

section
open Finset Classical
noncomputable def ghostPinnedKernel (A D C M ε : ℝ) (d n m : ℕ) : ℝ :=
  ∑ k ∈ range (min n m + 1), if d ≤ m - k then
    (n.choose k : ℝ) * A ^ k * D ^ (n - k) *
      C ^ (m - k) * (ε ^ d * M ^ (m - k - d)) /
        ((m - k).factorial : ℝ) else 0

/-- Separate retained particles from the constrained fresh batch. -/
theorem ghostPinnedKernel_row_sum (A D C M ε v : ℝ) (d n B : ℕ) :
    (∑ m ∈ range (B + 1), ghostPinnedKernel A D C M ε d n m * v ^ m) =
      ∑ k ∈ range (n + 1),
        ((n.choose k : ℝ) * A ^ k * D ^ (n - k) * v ^ k) *
          ∑ b ∈ Ico d (B + 1 - k),
            (C * v) ^ b * (ε ^ d * M ^ (b - d)) / (b.factorial : ℝ) := by
  calc
    _ = ∑ m ∈ range (B + 1), ∑ k ∈ range (min n m + 1),
        ((n.choose k : ℝ) * A ^ k * D ^ (n - k) * v ^ k) *
          (if d ≤ m - k then (C * v) ^ (m - k) *
            (ε ^ d * M ^ (m - k - d)) / ((m - k).factorial : ℝ) else 0) := by
      apply sum_congr rfl
      intro m hm
      rw [ghostPinnedKernel, sum_mul]
      apply sum_congr rfl
      intro k hk
      have hkm : k ≤ m := (Nat.le_min.mp (Nat.le_of_lt_succ (mem_range.mp hk))).2
      have hv : v ^ m = v ^ k * v ^ (m - k) := by
        rw [← pow_add, Nat.add_sub_of_le hkm]
      split_ifs
      · rw [hv, mul_pow]
        ring
      · simp only [zero_mul, mul_zero]
    _ = ∑ k ∈ range (n + 1), ∑ b ∈ range (B + 1 - k),
        ((n.choose k : ℝ) * A ^ k * D ^ (n - k) * v ^ k) *
          (if d ≤ b then (C * v) ^ b * (ε ^ d * M ^ (b - d)) /
            (b.factorial : ℝ) else 0) :=
      ghost_triangular_sum (fun k b =>
        ((n.choose k : ℝ) * A ^ k * D ^ (n - k) * v ^ k) *
          (if d ≤ b then (C * v) ^ b * (ε ^ d * M ^ (b - d)) /
            (b.factorial : ℝ) else 0)) n B
    _ = _ := by
      apply sum_congr rfl
      intro k hk
      rw [← mul_sum, ← sum_filter]
      congr 2
      ext b
      simp only [mem_filter, mem_range, mem_Ico, and_comm]

/-- The constrained ghost row gains one C*v*ε factor per prescribed birth,
uniformly over the occupancy cutoff. -/
theorem ghostPinnedKernel_row_le (A D C M ε v : ℝ) (d n B : ℕ)
    (hA : 0 ≤ A) (hD : 0 ≤ D) (hC : 0 ≤ C)
    (hM : 0 ≤ M) (hε : 0 ≤ ε) (hv : 0 ≤ v) :
    (∑ m ∈ range (B + 1), ghostPinnedKernel A D C M ε d n m * v ^ m) ≤
      ((C * v * ε) ^ d * Real.exp (C * v * M)) * (A * v + D) ^ n := by
  rw [ghostPinnedKernel_row_sum]
  calc
    _ ≤ ∑ k ∈ range (n + 1),
        ((n.choose k : ℝ) * A ^ k * D ^ (n - k) * v ^ k) *
          ((C * v * ε) ^ d * Real.exp (C * v * M)) := by
      apply sum_le_sum
      intro k hk
      apply mul_le_mul_of_nonneg_left
      · exact ordered_pinned_batch_Ico_sum_le_exp (B + 1 - k) d
          (mul_nonneg hC hv) hM hε
      · positivity
    _ = _ := by
      rw [add_pow, mul_sum]
      apply sum_congr rfl
      intro k hk
      rw [mul_pow]
      ring

/-- The ordinary ghost damping removes the dependence on source occupancy;
the prescribed-birth saving remains intact. -/
theorem ghostPinnedKernel_row_le_of_damping (A D C M ε v : ℝ) (d n B : ℕ)
    (hA : 0 ≤ A) (hD : 0 ≤ D) (hC : 0 ≤ C)
    (hM : 0 ≤ M) (hε : 0 ≤ ε) (hv : 0 < v) (hdamp : A + D / v ≤ 1) :
    (∑ m ∈ range (B + 1), ghostPinnedKernel A D C M ε d n m * v ^ m) ≤
      ((C * v * ε) ^ d * Real.exp (C * v * M)) * v ^ n := by
  apply (ghostPinnedKernel_row_le A D C M ε v d n B hA hD hC hM hε hv.le).trans
  apply mul_le_mul_of_nonneg_left _ (by positivity)
  apply pow_le_pow_left₀ (by positivity)
  have h : (A + D / v) * v ≤ v := by
    simpa only [one_mul] using mul_le_mul_of_nonneg_right hdamp hv.le
  calc
    A * v + D = (A + D / v) * v := by field_simp
    _ ≤ v := h
end

section
open Finset Classical
/-- Reindex an entire ordered assignment by a permutation. -/
def birthAssignmentPermutation {α : Type*} {n : ℕ} (σ : Equiv.Perm (Fin n)) :
    (Fin n → α) ≃ (Fin n → α) where
  toFun f := fun j => f (σ j)
  invFun f := fun j => f (σ.symm j)
  left_inv f := by funext j; simp
  right_inv f := by funext j; simp

noncomputable def birthPermutationAverage {α : Type*} {n : ℕ}
    (φ : (Fin n → α) → ℂ) (f : Fin n → α) : ℂ :=
  (Fintype.card (Equiv.Perm (Fin n)) : ℂ)⁻¹ *
    ∑ σ : Equiv.Perm (Fin n), φ (fun j => f (σ j))

/-- Permuting inputs does not change their averaged local multiplier. -/
theorem birthPermutationAverage_invariant {α : Type*} {n : ℕ}
    (φ : (Fin n → α) → ℂ) (f : Fin n → α) (τ : Equiv.Perm (Fin n)) :
    birthPermutationAverage φ (fun j => f (τ j)) = birthPermutationAverage φ f := by
  unfold birthPermutationAverage
  congr 1
  exact Equiv.sum_comp (Equiv.mulLeft τ) (fun σ : Equiv.Perm (Fin n) => φ (fun j => f (σ j)))

/-- Averaging preserves a unit bound, including on all numerical diagonals. -/
theorem birthPermutationAverage_norm_le_one {α : Type*} {n : ℕ}
    (φ : (Fin n → α) → ℂ) (hφ : ∀ f, ‖φ f‖ ≤ 1) (f : Fin n → α) :
    ‖birthPermutationAverage φ f‖ ≤ 1 := by
  have hcard : (0 : ℝ) < Fintype.card (Equiv.Perm (Fin n)) := by
    exact_mod_cast Fintype.card_pos
  unfold birthPermutationAverage
  rw [norm_mul, norm_inv, Complex.norm_natCast]
  calc
    _ ≤ (Fintype.card (Equiv.Perm (Fin n)) : ℝ)⁻¹ *
        ∑ σ : Equiv.Perm (Fin n), ‖φ (fun j => f (σ j))‖ :=
      mul_le_mul_of_nonneg_left (norm_sum_le _ _) (inv_nonneg.mpr hcard.le)
    _ ≤ (Fintype.card (Equiv.Perm (Fin n)) : ℝ)⁻¹ *
        ∑ _σ : Equiv.Perm (Fin n), (1 : ℝ) :=
      mul_le_mul_of_nonneg_left (sum_le_sum fun σ _ => hφ _) (inv_nonneg.mpr hcard.le)
    _ = 1 := by simp [ne_of_gt hcard]

/-- A symmetric finite weight allows a change of variables in the multiplier. -/
theorem symmetric_birth_sum_permutation {α : Type*} [Fintype α] {n : ℕ}
    (W φ : (Fin n → α) → ℂ)
    (hW : ∀ f (σ : Equiv.Perm (Fin n)), W (fun j => f (σ j)) = W f)
    (σ : Equiv.Perm (Fin n)) :
    (∑ f : Fin n → α, W f * φ (fun j => f (σ j))) =
      ∑ f : Fin n → α, W f * φ f := by
  have h := (birthAssignmentPermutation (α := α) σ).sum_comp (fun f => W f * φ f)
  simpa only [birthAssignmentPermutation, Equiv.coe_fn_mk, hW] using h

/-- The full weighted integral is unchanged by symmetrizing a local multiplier. -/
theorem symmetric_birth_sum_average {α : Type*} [Fintype α] {n : ℕ}
    (W φ : (Fin n → α) → ℂ)
    (hW : ∀ f (σ : Equiv.Perm (Fin n)), W (fun j => f (σ j)) = W f) :
    (∑ f : Fin n → α, W f * birthPermutationAverage φ f) =
      ∑ f : Fin n → α, W f * φ f := by
  have hc : (Fintype.card (Equiv.Perm (Fin n)) : ℂ) ≠ 0 := by
    exact_mod_cast Fintype.card_ne_zero
  unfold birthPermutationAverage
  calc
    _ = (Fintype.card (Equiv.Perm (Fin n)) : ℂ)⁻¹ *
        ∑ f : Fin n → α, ∑ σ : Equiv.Perm (Fin n), W f * φ (fun j => f (σ j)) := by
      simp only [mul_sum]
      apply sum_congr rfl
      intro f _
      apply sum_congr rfl
      intro σ _
      ring
    _ = (Fintype.card (Equiv.Perm (Fin n)) : ℂ)⁻¹ *
        ∑ σ : Equiv.Perm (Fin n), ∑ f : Fin n → α, W f * φ (fun j => f (σ j)) := by
      rw [sum_comm]
    _ = (Fintype.card (Equiv.Perm (Fin n)) : ℂ)⁻¹ *
        ∑ _σ : Equiv.Perm (Fin n), ∑ f : Fin n → α, W f * φ f := by
      simp_rw [symmetric_birth_sum_permutation W φ hW]
    _ = _ := by
      simp only [sum_const, card_univ, nsmul_eq_mul]
      rw [← mul_assoc, inv_mul_cancel₀ hc, one_mul]

/-- Product birth laws are symmetric even when the assignment repeats values. -/
theorem birth_product_weight_permutation {α : Type*} {n : ℕ}
    (μ : α → ℂ) (f : Fin n → α) (σ : Equiv.Perm (Fin n)) :
    (∏ j, μ (f (σ j))) = ∏ j, μ (f j) := Equiv.prod_comp σ (fun j => μ (f j))

/-- Any remaining symmetric integrand can be included along with the product
measure. The external factorial divisor is unchanged by this identity. -/
theorem ordered_birth_integral_symmetrize {α : Type*} [Fintype α] {n : ℕ}
    (μ : α → ℂ) (H φ : (Fin n → α) → ℂ)
    (hH : ∀ f (σ : Equiv.Perm (Fin n)), H (fun j => f (σ j)) = H f) :
    (∑ f : Fin n → α, ((∏ j, μ (f j)) * H f) * birthPermutationAverage φ f) =
      ∑ f : Fin n → α, ((∏ j, μ (f j)) * H f) * φ f := by
  apply symmetric_birth_sum_average
  intro f σ
  rw [birth_product_weight_permutation, hH]
end

section
open Finset
/-- The canonical kernel first factors through `A`, then `G`, then `B`. -/
noncomputable def finiteCompressionKernel {C S R : Type*} [Fintype S] [Semiring R]
    (A : ℕ → C → S → R) (B : ℕ → S → C → R) (G : ℕ → S → S → R)
    (j : ℕ) (x y : C) : R :=
  ∑ z, ∑ w, A j x z * G j z w * B j w y

/-- The compressed transition joins `G (j+1)`, `B (j+1)`, and `A j`. -/
noncomputable def finiteCompressionStep {C S R : Type*}
    [Fintype C] [Fintype S] [Semiring R]
    (A : ℕ → C → S → R) (B : ℕ → S → C → R) (G : ℕ → S → S → R)
    (j : ℕ) (z w : S) : R :=
  ∑ u, ∑ c, G (j + 1) z u * B (j + 1) u c * A j c w

/-- The initial compressed vector is `G 0` followed by `B 0` and the
canonical initial vector. -/
noncomputable def finiteCompressionInitial {C S R : Type*}
    [Fintype C] [Fintype S] [Semiring R]
    (B : ℕ → S → C → R) (G : ℕ → S → S → R) (f : C → R) (z : S) : R :=
  ∑ w, ∑ c, G 0 z w * B 0 w c * f c

/-- Reassociate one factored kernel action without changing scalar order. -/
theorem finite_compression_kernel_action {C S R : Type*}
    [Fintype C] [Fintype S] [Semiring R]
    (A : ℕ → C → S → R) (B : ℕ → S → C → R) (G : ℕ → S → S → R)
    (v : C → R) (j : ℕ) (x : C) :
    (∑ y, finiteCompressionKernel A B G j x y * v y) =
      ∑ z, A j x z * (∑ w, ∑ y, G j z w * B j w y * v y) := by
  simp only [finiteCompressionKernel, sum_mul, mul_sum, mul_assoc]
  rw [sum_comm]
  apply sum_congr rfl
  intro z _
  exact sum_comm

/-- Iterating the canonical `A j * G j * B j` kernels compresses to a
single final `A n`, the phase transitions `G (j+1) * B (j+1) * A j`,
and the initial vector `G 0 * B 0 * f`. -/
theorem finite_path_action_compress {C S R : Type*}
    [Fintype C] [Fintype S] [Semiring R]
    (A : ℕ → C → S → R) (B : ℕ → S → C → R) (G : ℕ → S → S → R)
    (f : C → R) (n : ℕ) (x : C) :
    finitePathAction (finiteCompressionKernel A B G) f (n + 1) x =
      ∑ z, A n x z * finitePathAction (finiteCompressionStep A B G)
        (finiteCompressionInitial B G f) n z := by
  induction n generalizing x with
  | zero =>
    change (∑ y, finiteCompressionKernel A B G 0 x y * f y) =
      ∑ z, A 0 x z * finiteCompressionInitial B G f z
    exact finite_compression_kernel_action A B G f 0 x
  | succ n ih =>
    rw [finitePathAction, finite_compression_kernel_action]
    apply sum_congr rfl
    intro z _
    congr 1
    simp_rw [ih]
    simp only [finitePathAction, finiteCompressionStep, sum_mul, mul_sum, mul_assoc]
    symm
    rw [sum_comm]
    apply sum_congr rfl
    intro u _
    exact sum_comm

/-- A weighted canonical boundary compresses into the final rectangular
factor. This is the finite boundary-pairing version of path compression. -/
theorem finite_path_action_compress_weighted {C S R : Type*}
    [Fintype C] [Fintype S] [Semiring R]
    (A : ℕ → C → S → R) (B : ℕ → S → C → R) (G : ℕ → S → S → R)
    (f q : C → R) (n : ℕ) :
    (∑ x, q x * finitePathAction (finiteCompressionKernel A B G) f (n + 1) x) =
      ∑ z, (∑ x, q x * A n x z) *
        finitePathAction (finiteCompressionStep A B G)
          (finiteCompressionInitial B G f) n z := by
  simp only [finite_path_action_compress, mul_sum, sum_mul, mul_assoc]
  exact sum_comm
end

section
open Finset
/-- Time-dependent diagonal conjugation telescopes through the full path. -/
theorem finite_path_action_diagonal_gauge {X 𝕜 : Type*} [Fintype X] [Field 𝕜]
    (K : ℕ → X → X → 𝕜) (d : ℕ → X → 𝕜)
    (hd : ∀ j x, d j x ≠ 0) (f : X → 𝕜) (n : ℕ) (x : X) :
    finitePathAction (fun j x y => (d (j + 1) x)⁻¹ * K j x y * d j y)
      (fun x => (d 0 x)⁻¹ * f x) n x =
      (d n x)⁻¹ * finitePathAction K f n x := by
  induction n generalizing x with
  | zero => rfl
  | succ n ih =>
      simp only [finitePathAction, ih, mul_sum]
      apply sum_congr rfl
      intro y hy
      field_simp [hd]

/-- If both boundary tests live where the corresponding diagonal is one,
the paired matrix evolution is unchanged by the diagonal gauge. -/
theorem finite_path_action_diagonal_gauge_pairing
    {X 𝕜 : Type*} [Fintype X] [Field 𝕜]
    (K : ℕ → X → X → 𝕜) (d : ℕ → X → 𝕜)
    (hd : ∀ j x, d j x ≠ 0) (f q : X → 𝕜) (n : ℕ)
    (hf : ∀ x, f x ≠ 0 → d 0 x = 1)
    (hq : ∀ x, q x ≠ 0 → d n x = 1) :
    (∑ x, q x * finitePathAction
      (fun j x y => (d (j + 1) x)⁻¹ * K j x y * d j y) f n x) =
      ∑ x, q x * finitePathAction K f n x := by
  have hinit : f = fun x => (d 0 x)⁻¹ * f x := by
    funext x
    by_cases hx : f x = 0
    · simp [hx]
    · simp [hf x hx]
  conv_lhs => rw [hinit]
  simp_rw [finite_path_action_diagonal_gauge K d hd]
  apply sum_congr rfl
  intro x hx
  by_cases hqx : q x = 0
  · simp [hqx]
  · simp [hq x hqx]

/-- A normalized visit followed, on its right, by a normalized incoming edge
is exactly the diagonal gauge of their unnormalized composition. -/
theorem diagonal_visit_edge_composition
    {X 𝕜 : Type*} [Fintype X] [Field 𝕜]
    (G E : X → X → 𝕜) (dnext dprev : X → 𝕜)
    (hdnext : ∀ x, dnext x ≠ 0) (x y : X) :
    (∑ z, (G x z / (dnext x * dnext z)) *
      (dnext z * E z y * dprev y)) =
      (dnext x)⁻¹ * (∑ z, G x z * E z y) * dprev y := by
  rw [mul_sum, sum_mul]
  apply sum_congr rfl
  intro z hz
  field_simp [hdnext]

/-- Normalizing the first visit leaves only its output diagonal when the
initial vector is supported on states with diagonal one. -/
theorem diagonal_initial_visit
    {X 𝕜 : Type*} [Fintype X] [Field 𝕜]
    (G : X → X → 𝕜) (d f : X → 𝕜) (hd : ∀ x, d x ≠ 0)
    (hf : ∀ x, f x ≠ 0 → d x = 1) (x : X) :
    (∑ y, (G x y / (d x * d y)) * f y) =
      (d x)⁻¹ * ∑ y, G x y * f y := by
  rw [mul_sum]
  apply sum_congr rfl
  intro y hy
  by_cases hfy : f y = 0
  · simp [hfy]
  · rw [hf y hfy]
    field_simp [hd]

/-- The whole alternating evolution `G_n E_(n-1) ... E_0 G_0` has only
the final inverse diagonal after all normalized interior factors cancel. -/
theorem alternating_visit_edge_diagonal_gauge
    {X 𝕜 : Type*} [Fintype X] [Field 𝕜]
    (G E : ℕ → X → X → 𝕜) (d : ℕ → X → 𝕜)
    (hd : ∀ j x, d j x ≠ 0) (f : X → 𝕜)
    (hf : ∀ x, f x ≠ 0 → d 0 x = 1) (n : ℕ) (x : X) :
    finitePathAction
      (fun j x y => ∑ z, (G (j + 1) x z / (d (j + 1) x * d (j + 1) z)) *
        (d (j + 1) z * E j z y * d j y))
      (fun x => ∑ y, (G 0 x y / (d 0 x * d 0 y)) * f y) n x =
      (d n x)⁻¹ * finitePathAction
        (fun j x y => ∑ z, G (j + 1) x z * E j z y)
        (fun x => ∑ y, G 0 x y * f y) n x := by
  simp_rw [diagonal_visit_edge_composition _ _ _ _ (hd _),
    diagonal_initial_visit _ _ _ (hd 0) hf]
  exact finite_path_action_diagonal_gauge _ d hd _ n x

/-- With vacuum boundary tests, the paired alternating visit/edge product
is invariant under the auxiliary diagonal normalization. -/
theorem alternating_visit_edge_diagonal_pairing
    {X 𝕜 : Type*} [Fintype X] [Field 𝕜]
    (G E : ℕ → X → X → 𝕜) (d : ℕ → X → 𝕜)
    (hd : ∀ j x, d j x ≠ 0) (f q : X → 𝕜) (n : ℕ)
    (hf : ∀ x, f x ≠ 0 → d 0 x = 1)
    (hq : ∀ x, q x ≠ 0 → d n x = 1) :
    (∑ x, q x * finitePathAction
      (fun j x y => ∑ z, (G (j + 1) x z / (d (j + 1) x * d (j + 1) z)) *
        (d (j + 1) z * E j z y * d j y))
      (fun x => ∑ y, (G 0 x y / (d 0 x * d 0 y)) * f y) n x) =
      ∑ x, q x * finitePathAction
        (fun j x y => ∑ z, G (j + 1) x z * E j z y)
        (fun x => ∑ y, G 0 x y * f y) n x := by
  simp_rw [alternating_visit_edge_diagonal_gauge G E d hd f hf]
  apply sum_congr rfl
  intro x hx
  by_cases hqx : q x = 0
  · simp [hqx]
  · simp [hq x hqx]
end

section
open Finset
abbrev GhostPhaseState (R : Type*) := Option (GhostFiniteState R)

/-- Gather an unborn or matching pending lifespan into an active visit. -/
noncomputable def ghostActiveInput {R : Type*} [DecidableEq R]
    (h : R) (β : ℝ) : GhostFiniteState R → ℝ
  | none => β
  | some none => 0
  | some (some r) => if r = h then 1 else 0

/-- Scatter an active visit to a completed or matching pending lifespan. -/
noncomputable def ghostActiveOutput {R : Type*} [DecidableEq R]
    (h : R) : GhostFiniteState R → ℝ
  | none => 0
  | some none => 1
  | some (some r) => if r = h then 1 else 0

noncomputable def ghostPhaseGather {R : Type*} [DecidableEq R]
    (a : Bool) (h : R) (β : ℝ) : GhostPhaseState R → GhostFiniteState R → ℝ :=
  if a then fun z y => match z with
    | none => ghostActiveInput h β y
    | some _ => 0
  else fun z y => match z with
    | none => 0
    | some c => if c = y then 1 else 0

noncomputable def ghostPhaseScatter {R : Type*} [DecidableEq R]
    (a : Bool) (h : R) : GhostFiniteState R → GhostPhaseState R → ℝ :=
  if a then fun x z => match z with
    | none => ghostActiveOutput h x
    | some _ => 0
  else fun x z => match z with
    | none => 0
    | some c => if x = c then 1 else 0

noncomputable def ghostPhaseVisit {R : Type*} [DecidableEq R]
    (a : Bool) (h : R) (η β : ℝ) : GhostPhaseState R → GhostPhaseState R → ℝ :=
  if a then fun z w => match z, w with
    | none, none => 1
    | _, _ => 0
  else fun z w => match z, w with
    | some x, some y => ghostFiniteKernel h η β x y
    | _, _ => 0

/-- The edge joins a source scatter to the following target gather. -/
noncomputable def ghostPhaseEdge {R : Type*} [Fintype R] [DecidableEq R]
    (aTarget aSource : Bool) (hTarget hSource : R) (β : ℝ)
    (z w : GhostPhaseState R) : ℝ :=
  ∑ c : GhostFiniteState R,
    ghostPhaseGather aTarget hTarget β z c * ghostPhaseScatter aSource hSource c w

/-- An active canonical transition has rank one. -/
theorem ghost_active_kernel_factor {R : Type*} [DecidableEq R]
    (h : R) (η β : ℝ) (x y : GhostFiniteState R) :
    activeGhostFiniteKernel true h η β x y =
      ghostActiveOutput h x * ghostActiveInput h β y := by
  rcases x with _ | (_ | r) <;> rcases y with _ | (_ | s) <;>
    simp [activeGhostFiniteKernel, ghostActiveOutput, ghostActiveInput]
  split <;> simp_all
  tauto

/-- Exact factorization through active or inactive phase memory. -/
theorem ghost_phase_kernel_factorization {R : Type*} [Fintype R] [DecidableEq R]
    (a : Bool) (h : R) (η β : ℝ) (x y : GhostFiniteState R) :
    activeGhostFiniteKernel a h η β x y =
      ∑ z : GhostPhaseState R, ∑ w : GhostPhaseState R,
        ghostPhaseScatter a h x z * ghostPhaseVisit a h η β z w *
          ghostPhaseGather a h β w y := by
  cases a
  · simp [ghostPhaseScatter, ghostPhaseVisit, ghostPhaseGather,
      activeGhostFiniteKernel, ite_mul, mul_ite]
  · simp [ghostPhaseScatter, ghostPhaseVisit, ghostPhaseGather,
      ghost_active_kernel_factor]

/-- Consecutive active visits require equal hit residues, with no new birth cost. -/
theorem ghost_phase_edge_active_active {R : Type*} [Fintype R] [DecidableEq R]
    (hTarget hSource : R) (β : ℝ) :
    ghostPhaseEdge true true hTarget hSource β none none =
      if hSource = hTarget then 1 else 0 := by
  simp [ghostPhaseEdge, ghostPhaseGather, ghostPhaseScatter,
    ghostActiveInput, ghostActiveOutput, mul_ite, eq_comm]

/-- Leaving an active phase scatters to canonical inactive memory. -/
theorem ghost_phase_edge_inactive_active {R : Type*} [Fintype R] [DecidableEq R]
    (hTarget hSource : R) (β : ℝ) (x : GhostFiniteState R) :
    ghostPhaseEdge false true hTarget hSource β (some x) none =
      ghostActiveOutput hSource x := by
  simp [ghostPhaseEdge, ghostPhaseGather, ghostPhaseScatter, ite_mul]

/-- Entering an active phase gathers canonical inactive memory. -/
theorem ghost_phase_edge_active_inactive {R : Type*} [Fintype R] [DecidableEq R]
    (hTarget hSource : R) (β : ℝ) (y : GhostFiniteState R) :
    ghostPhaseEdge true false hTarget hSource β none (some y) =
      ghostActiveInput hTarget β y := by
  simp [ghostPhaseEdge, ghostPhaseGather, ghostPhaseScatter, mul_ite]

/-- Consecutive inactive phases carry canonical memory without changing it. -/
theorem ghost_phase_edge_inactive_inactive {R : Type*} [Fintype R] [DecidableEq R]
    (hTarget hSource : R) (β : ℝ) (x y : GhostFiniteState R) :
    ghostPhaseEdge false false hTarget hSource β (some x) (some y) =
      if x = y then 1 else 0 := by
  simp [ghostPhaseEdge, ghostPhaseGather, ghostPhaseScatter]

/-- The target phase must agree with its activity flag. -/
theorem ghost_phase_edge_target_support {R : Type*} [Fintype R] [DecidableEq R]
    (aSource : Bool) (hTarget hSource : R) (β : ℝ)
    (x : GhostFiniteState R) (w : GhostPhaseState R) :
    ghostPhaseEdge true aSource hTarget hSource β (some x) w = 0 ∧
      ghostPhaseEdge false aSource hTarget hSource β none w = 0 := by
  simp [ghostPhaseEdge, ghostPhaseGather]

/-- The source phase must agree with its activity flag. -/
theorem ghost_phase_edge_source_support {R : Type*} [Fintype R] [DecidableEq R]
    (aTarget : Bool) (hTarget hSource : R) (β : ℝ)
    (z : GhostPhaseState R) (y : GhostFiniteState R) :
    ghostPhaseEdge aTarget true hTarget hSource β z (some y) = 0 ∧
      ghostPhaseEdge aTarget false hTarget hSource β z none = 0 := by
  simp [ghostPhaseEdge, ghostPhaseScatter]
end

section
open Finset
def ghostPhaseMask {I : Type*} {R : I → Type*} (a : I → Bool)
    (x : (i : I) → Option (GhostFiniteState (R i))) : Prop :=
  ∀ i, (x i).isSome = !(a i)

noncomputable def ghostPhaseAssemble {I : Type*} {R : I → Type*} (a : I → Bool)
    (x : (i : {i : I // a i = false}) → GhostFiniteState (R i.val)) :
    (i : I) → Option (GhostFiniteState (R i)) :=
  fun i => if hi : a i = false then some (x ⟨i, hi⟩) else none

theorem ghost_phase_assemble_valid {I : Type*} {R : I → Type*} (a : I → Bool)
    (x : (i : {i : I // a i = false}) → GhostFiniteState (R i.val)) :
    ghostPhaseMask a (ghostPhaseAssemble a x) := by
  intro i
  cases hi : a i <;> simp [ghostPhaseAssemble, hi]

theorem ghost_phase_assemble_injective {I : Type*} {R : I → Type*} (a : I → Bool) :
    Function.Injective (@ghostPhaseAssemble I R a) := by
  intro x y h
  funext i
  have he := congrFun h i.val
  simpa only [ghostPhaseAssemble, dif_pos i.property, Option.some.injEq] using he

theorem ghost_phase_valid_inactive {I : Type*} {R : I → Type*} (a : I → Bool)
    (x : (i : I) → Option (GhostFiniteState (R i))) (hx : ghostPhaseMask a x)
    (i : {i : I // a i = false}) : ∃ y, x i.val = some y := by
  have h := hx i.val
  rw [i.property] at h
  cases he : x i.val with
  | none => simp [he] at h
  | some y => exact ⟨y, rfl⟩

noncomputable def ghostPhaseExtract {I : Type*} {R : I → Type*} (a : I → Bool)
    (x : {x : (i : I) → Option (GhostFiniteState (R i)) // ghostPhaseMask a x}) :
    (i : {i : I // a i = false}) → GhostFiniteState (R i.val) :=
  fun i => Classical.choose (ghost_phase_valid_inactive a x.val x.property i)

theorem ghost_phase_assemble_extract {I : Type*} {R : I → Type*} (a : I → Bool)
    (x : {x : (i : I) → Option (GhostFiniteState (R i)) // ghostPhaseMask a x}) :
    ghostPhaseAssemble a (ghostPhaseExtract a x) = x.val := by
  funext i
  by_cases hi : a i = false
  · simp only [ghostPhaseAssemble, dif_pos hi, ghostPhaseExtract]
    exact (Classical.choose_spec (ghost_phase_valid_inactive a x.val x.property ⟨i, hi⟩)).symm
  · simp only [ghostPhaseAssemble, dif_neg hi]
    have ht : a i = true := Bool.eq_true_of_not_eq_false hi
    have hx := x.property i
    rw [ht] at hx
    cases he : x.val i <;> simp_all

noncomputable def ghostPhaseConfigurationEquiv {I : Type*} {R : I → Type*} (a : I → Bool) :
    ((i : {i : I // a i = false}) → GhostFiniteState (R i.val)) ≃
      {x : (i : I) → Option (GhostFiniteState (R i)) // ghostPhaseMask a x} where
  toFun x := ⟨ghostPhaseAssemble a x, ghost_phase_assemble_valid a x⟩
  invFun := ghostPhaseExtract a
  left_inv x := ghost_phase_assemble_injective a (ghost_phase_assemble_extract a
    ⟨ghostPhaseAssemble a x, ghost_phase_assemble_valid a x⟩)
  right_inv x := Subtype.ext (ghost_phase_assemble_extract a x)

/-- A supported phase-state sum has coordinates only at inactive primes. -/
theorem ghost_phase_sum_inactive {I M : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, Fintype (R i)] [AddCommMonoid M]
    (a : I → Bool) (F : ((i : I) → Option (GhostFiniteState (R i))) → M)
    (hF : ∀ x, ¬ ghostPhaseMask a x → F x = 0) :
    (∑ x, F x) = ∑ x : (i : {i : I // a i = false}) → GhostFiniteState (R i.val),
      F (ghostPhaseAssemble a x) := by
  classical
  have hz : (∑ x : {x : (i : I) → Option (GhostFiniteState (R i)) //
      ¬ ghostPhaseMask a x}, F x.val) = 0 := by
    apply sum_eq_zero
    intro x _
    exact hF x.val x.property
  have hs := Fintype.sum_subtype_add_sum_subtype (ghostPhaseMask a) F
  rw [hz, add_zero] at hs
  calc
    _ = ∑ x : {x : (i : I) → Option (GhostFiniteState (R i)) //
        ghostPhaseMask a x}, F x.val := hs.symm
    _ = _ := ((ghostPhaseConfigurationEquiv a).sum_comp (fun x => F x.val)).symm

/-- The active labels are excluded before ordering the remaining pending
coordinates. Complement flags still distinguish unborn from completed primes. -/
theorem ghost_phase_sum_ordered_pending {I 𝕜 : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, Fintype (R i)] [Field 𝕜] [CharZero 𝕜]
    (a : I → Bool) (F : ((i : I) → Option (GhostFiniteState (R i))) → 𝕜)
    (hF : ∀ x, ¬ ghostPhaseMask a x → F x = 0) :
    (∑ x, F x) =
      ∑ S : Finset {i : I // a i = false},
        ∑ c : {i : {i : I // a i = false} // i ∉ S} → Bool,
          (∑ e : Fin (Fintype.card S) ≃ S,
            ∑ r : (j : Fin (Fintype.card S)) → R (e j).val.val,
              F (ghostPhaseAssemble a (ghostConfigurationAssemble
                ⟨S, Equiv.piCongrLeft (fun i : S => R i.val.val) e r, c⟩))) /
            ((Fintype.card S).factorial : 𝕜) := by
  classical
  rw [ghost_phase_sum_inactive a F hF]
  exact ghost_configuration_sum_ordered_alive (R := fun i : {i : I // a i = false} => R i.val)
    (fun x => F (ghostPhaseAssemble a x))
end

section

/-- The local diagonal whose neighboring factors supply the endpoint rho
factors and the two rho factors at an internal pending hit. -/
noncomputable def ghostPhaseDiagonal {R : Type*} [DecidableEq R]
    (hit : R) (ρ : ℝ) : GhostPhaseState R → ℝ
  | some (some (some r)) => if r = hit then ρ else 1
  | _ => 1

theorem ghostPhaseDiagonal_ne_zero {R : Type*} [DecidableEq R]
    (hit : R) {ρ : ℝ} (hρ : ρ ≠ 0) (x : Option (GhostFiniteState R)) :
    ghostPhaseDiagonal hit ρ x ≠ 0 := by
  rcases x with _ | (_ | (_ | r))
  · exact one_ne_zero
  · exact one_ne_zero
  · exact one_ne_zero
  · simp only [ghostPhaseDiagonal]
    split
    · exact hρ
    · exact one_ne_zero

theorem ghostPhaseDiagonal_active {R : Type*} [DecidableEq R] (hit : R) (ρ : ℝ) :
    ghostPhaseDiagonal hit ρ none = 1 := rfl

theorem ghostPhaseDiagonal_unborn {R : Type*} [DecidableEq R] (hit : R) (ρ : ℝ) :
    ghostPhaseDiagonal hit ρ (some none) = 1 := rfl

theorem ghostPhaseDiagonal_completed {R : Type*} [DecidableEq R] (hit : R) (ρ : ℝ) :
    ghostPhaseDiagonal hit ρ (some (some none)) = 1 := rfl

theorem ghostPhaseDiagonal_pending_hit {R : Type*} [DecidableEq R] (hit : R) (ρ : ℝ) :
    ghostPhaseDiagonal hit ρ (some (some (some hit))) = ρ := by
  simp only [ghostPhaseDiagonal, if_true]

theorem ghostPhaseDiagonal_pending_miss {R : Type*} [DecidableEq R]
    (hit r : R) (ρ : ℝ) (hr : r ≠ hit) :
    ghostPhaseDiagonal hit ρ (some (some (some r))) = 1 := by
  simp only [ghostPhaseDiagonal, if_neg hr]

/-- The visit normalization matching the adjacent diagonal edge factors. -/
noncomputable def ghostPhaseDampedVisit {R : Type*} [DecidableEq R]
    (a : Bool) (hit : R) (η β ρ : ℝ) (z w : GhostPhaseState R) : ℝ :=
  ghostPhaseVisit a hit η β z w /
    (ghostPhaseDiagonal hit ρ z * ghostPhaseDiagonal hit ρ w)

/-- A birth at the required hit pays one reciprocal rho factor. -/
theorem ghost_phase_damped_visit_birth {R : Type*} [DecidableEq R]
    (hit : R) (η β ρ : ℝ) :
    ghostPhaseDampedVisit false hit η β ρ (some (some (some hit))) (some none) =
      -β * η / ρ := by
  simp [ghostPhaseDampedVisit, ghostPhaseVisit, ghostFiniteKernel, ghostPhaseDiagonal]

/-- Termination at the required hit pays one reciprocal rho factor. -/
theorem ghost_phase_damped_visit_termination {R : Type*} [DecidableEq R]
    (hit : R) (η β ρ : ℝ) :
    ghostPhaseDampedVisit false hit η β ρ (some (some none))
      (some (some (some hit))) = -η / ρ := by
  simp [ghostPhaseDampedVisit, ghostPhaseVisit, ghostFiniteKernel, ghostPhaseDiagonal]

/-- Continuing through an inactive hit pays the two reciprocal rho factors. -/
theorem ghost_phase_damped_visit_continuation_hit {R : Type*} [DecidableEq R]
    (hit : R) (η β ρ : ℝ) :
    ghostPhaseDampedVisit false hit η β ρ (some (some (some hit)))
      (some (some (some hit))) = (1 - η) / ρ ^ 2 := by
  simp [ghostPhaseDampedVisit, ghostPhaseVisit, ghostFiniteKernel,
    ghostPhaseDiagonal, pow_two]

/-- A pending particle that does not hit is unaffected by the visit. -/
theorem ghost_phase_damped_visit_continuation_miss {R : Type*} [DecidableEq R]
    (hit r : R) (η β ρ : ℝ) (hr : r ≠ hit) :
    ghostPhaseDampedVisit false hit η β ρ (some (some (some r)))
      (some (some (some r))) = 1 := by
  simp [ghostPhaseDampedVisit, ghostPhaseVisit, ghostFiniteKernel,
    ghostPhaseDiagonal, hr]

/-- The active visit has no rho factors. -/
theorem ghost_phase_damped_visit_active {R : Type*} [DecidableEq R]
    (hit : R) (η β ρ : ℝ) :
    ghostPhaseDampedVisit true hit η β ρ none none = 1 := by
  simp [ghostPhaseDampedVisit, ghostPhaseVisit, ghostPhaseDiagonal]

/-- The unborn state retains its identity coefficient. -/
theorem ghost_phase_damped_visit_unborn {R : Type*} [DecidableEq R]
    (hit : R) (η β ρ : ℝ) :
    ghostPhaseDampedVisit false hit η β ρ (some none) (some none) = 1 := by
  simp [ghostPhaseDampedVisit, ghostPhaseVisit, ghostFiniteKernel, ghostPhaseDiagonal]

/-- Completed lifespans retain their identity coefficient. -/
theorem ghost_phase_damped_visit_completed {R : Type*} [DecidableEq R]
    (hit : R) (η β ρ : ℝ) :
    ghostPhaseDampedVisit false hit η β ρ (some (some none)) (some (some none)) = 1 := by
  simp [ghostPhaseDampedVisit, ghostPhaseVisit, ghostFiniteKernel, ghostPhaseDiagonal]
end

section

/-- Multiply the phase edge by the target and source diagonals, in the
output-row/input-column convention. -/
noncomputable def ghostPhaseDampedEdge {R : Type*} [Fintype R] [DecidableEq R]
    (aTarget aSource : Bool) (hTarget hSource : R) (β ρTarget ρSource : ℝ)
    (z w : GhostPhaseState R) : ℝ :=
  ghostPhaseDiagonal hTarget ρTarget z *
    ghostPhaseEdge aTarget aSource hTarget hSource β z w *
      ghostPhaseDiagonal hSource ρSource w

/-- Shared active continuation checks the two hits, without any rho factor. -/
theorem ghost_phase_damped_edge_active_active
    {R : Type*} [Fintype R] [DecidableEq R]
    (hTarget hSource : R) (β ρTarget ρSource : ℝ) :
    ghostPhaseDampedEdge true true hTarget hSource β ρTarget ρSource none none =
      if hSource = hTarget then 1 else 0 := by
  simp [ghostPhaseDampedEdge, ghost_phase_edge_active_active, ghostPhaseDiagonal]

/-- Leaving an active phase either drops the lifespan or stores it at the
source hit. A stored particle is damped only if it also hits at the target. -/
theorem ghost_phase_damped_edge_inactive_active
    {R : Type*} [Fintype R] [DecidableEq R]
    (hTarget hSource : R) (β ρTarget ρSource : ℝ) (x : GhostFiniteState R) :
    ghostPhaseDampedEdge false true hTarget hSource β ρTarget ρSource (some x) none =
      match x with
      | none => 0
      | some none => 1
      | some (some r) => if r = hSource then (if r = hTarget then ρTarget else 1) else 0 := by
  rcases x with _ | (_ | r) <;>
    simp [ghostPhaseDampedEdge, ghost_phase_edge_inactive_active,
      ghostActiveOutput, ghostPhaseDiagonal, mul_ite]

/-- Entering an active phase either starts a fresh lifespan with coefficient
beta or promotes an old pending particle that hits at the target. Promotion
retains source damping precisely when that particle also hit at the source. -/
theorem ghost_phase_damped_edge_active_inactive
    {R : Type*} [Fintype R] [DecidableEq R]
    (hTarget hSource : R) (β ρTarget ρSource : ℝ) (y : GhostFiniteState R) :
    ghostPhaseDampedEdge true false hTarget hSource β ρTarget ρSource none (some y) =
      match y with
      | none => β
      | some none => 0
      | some (some r) => if r = hTarget then (if r = hSource then ρSource else 1) else 0 := by
  rcases y with _ | (_ | r) <;>
    simp [ghostPhaseDampedEdge, ghost_phase_edge_active_inactive,
      ghostActiveInput, ghostPhaseDiagonal, ite_mul]
  by_cases ht : r = hTarget <;> by_cases hs : r = hSource <;> simp [ht, hs]

/-- Between two inactive phases, the canonical state is retained. Pending
particles receive the target and source damping factors independently. -/
theorem ghost_phase_damped_edge_inactive_inactive
    {R : Type*} [Fintype R] [DecidableEq R]
    (hTarget hSource : R) (β ρTarget ρSource : ℝ) (x y : GhostFiniteState R) :
    ghostPhaseDampedEdge false false hTarget hSource β ρTarget ρSource (some x) (some y) =
      match x, y with
      | none, none => 1
      | some none, some none => 1
      | some (some r), some (some s) =>
          if r = s then
            (if r = hTarget then ρTarget else 1) * (if r = hSource then ρSource else 1)
          else 0
      | _, _ => 0 := by
  rcases x with _ | (_ | r) <;> rcases y with _ | (_ | s) <;>
    simp [ghostPhaseDampedEdge, ghost_phase_edge_inactive_inactive, ghostPhaseDiagonal]
  by_cases hrs : r = s
  · subst s
    simp
  · simp [hrs]

/-- The fresh active birth cost is unaffected by the edge diagonals. -/
theorem ghost_phase_damped_edge_fresh
    {R : Type*} [Fintype R] [DecidableEq R]
    (hTarget hSource : R) (β ρTarget ρSource : ℝ) :
    ghostPhaseDampedEdge true false hTarget hSource β ρTarget ρSource none (some none) = β := by
  exact ghost_phase_damped_edge_active_inactive hTarget hSource β ρTarget ρSource none

/-- Dropping an active lifespan has coefficient one. -/
theorem ghost_phase_damped_edge_drop
    {R : Type*} [Fintype R] [DecidableEq R]
    (hTarget hSource : R) (β ρTarget ρSource : ℝ) :
    ghostPhaseDampedEdge false true hTarget hSource β ρTarget ρSource (some (some none)) none =
      1 := by
  exact ghost_phase_damped_edge_inactive_active hTarget hSource β ρTarget ρSource (some none)

/-- Storage at the source anchor receives target damping when the hits agree. -/
theorem ghost_phase_damped_edge_store
    {R : Type*} [Fintype R] [DecidableEq R]
    (hTarget hSource : R) (β ρTarget ρSource : ℝ) :
    ghostPhaseDampedEdge false true hTarget hSource β ρTarget ρSource
      (some (some (some hSource))) none =
      if hSource = hTarget then ρTarget else 1 := by
  simpa using ghost_phase_damped_edge_inactive_active hTarget hSource β ρTarget ρSource
    (some (some hSource))

/-- Promotion at the target anchor retains source damping when the hits agree. -/
theorem ghost_phase_damped_edge_promote
    {R : Type*} [Fintype R] [DecidableEq R]
    (hTarget hSource : R) (β ρTarget ρSource : ℝ) :
    ghostPhaseDampedEdge true false hTarget hSource β ρTarget ρSource
      none (some (some (some hTarget))) =
      if hTarget = hSource then ρSource else 1 := by
  simpa using ghost_phase_damped_edge_active_inactive hTarget hSource β ρTarget ρSource
    (some (some hTarget))

/-- Target phase support is preserved by the diagonal multiplication. -/
theorem ghost_phase_damped_edge_target_support
    {R : Type*} [Fintype R] [DecidableEq R]
    (aSource : Bool) (hTarget hSource : R) (β ρTarget ρSource : ℝ)
    (x : GhostFiniteState R) (w : GhostPhaseState R) :
    ghostPhaseDampedEdge true aSource hTarget hSource β ρTarget ρSource (some x) w = 0 ∧
      ghostPhaseDampedEdge false aSource hTarget hSource β ρTarget ρSource none w = 0 := by
  have h := ghost_phase_edge_target_support aSource hTarget hSource β x w
  simp only [ghostPhaseDampedEdge, h.1, h.2, mul_zero, zero_mul, and_self]

/-- Source phase support is preserved by the diagonal multiplication. -/
theorem ghost_phase_damped_edge_source_support
    {R : Type*} [Fintype R] [DecidableEq R]
    (aTarget : Bool) (hTarget hSource : R) (β ρTarget ρSource : ℝ)
    (z : GhostPhaseState R) (y : GhostFiniteState R) :
    ghostPhaseDampedEdge aTarget true hTarget hSource β ρTarget ρSource z (some y) = 0 ∧
      ghostPhaseDampedEdge aTarget false hTarget hSource β ρTarget ρSource z none = 0 := by
  have h := ghost_phase_edge_source_support aTarget hTarget hSource β z y
  simp only [ghostPhaseDampedEdge, h.1, h.2, mul_zero, zero_mul, and_self]
end

section
open Finset
def ghostFiniteTerminal {R : Type*} : GhostFiniteState R → ℝ
  | none => 1
  | some none => 1
  | some (some _) => 0

noncomputable def ghostPhaseInitial {R : Type*} (a : Bool) (β : ℝ) :
    GhostPhaseState R → ℝ :=
  if a then fun z => match z with
    | none => β
    | some _ => 0
  else fun z => match z with
    | none => 0
    | some c => ghostFiniteInitial c

def ghostPhaseTerminal {R : Type*} (a : Bool) : GhostPhaseState R → ℝ :=
  if a then fun z => match z with
    | none => 1
    | some _ => 0
  else fun z => match z with
    | none => 0
    | some c => ghostFiniteTerminal c

theorem ghost_phase_gather_initial {R : Type*} [Fintype R] [DecidableEq R]
    (a : Bool) (h : R) (β : ℝ) (z : GhostPhaseState R) :
    (∑ c, ghostPhaseGather a h β z c * ghostFiniteInitial c) =
      ghostPhaseInitial a β z := by
  cases a <;> cases z <;>
    simp [ghostPhaseGather, ghostPhaseInitial, ghostActiveInput, ghostFiniteInitial]

theorem ghost_phase_scatter_terminal {R : Type*} [Fintype R] [DecidableEq R]
    (a : Bool) (h : R) (z : GhostPhaseState R) :
    (∑ c, ghostFiniteTerminal c * ghostPhaseScatter a h c z) =
      ghostPhaseTerminal a z := by
  cases a <;> cases z <;>
    simp [ghostPhaseScatter, ghostPhaseTerminal, ghostActiveOutput,
      ghostFiniteTerminal, mul_ite]

noncomputable def ghostPhaseHistory {R : Type*} [Fintype R] [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (n : ℕ) : ℝ :=
  ∑ x, ghostPhaseTerminal (a n) x * finitePathAction
    (fun j x y => ∑ z, ghostPhaseVisit (a (j + 1)) (h (j + 1)) (η (j + 1)) β x z *
      ghostPhaseEdge (a (j + 1)) (a j) (h (j + 1)) (h j) β z y)
    (fun x => ∑ y, ghostPhaseVisit (a 0) (h 0) (η 0) β x y *
      ghostPhaseInitial (a 0) β y) n x

/-- The phase history is exactly the canonical vacuum after all `n+1` visits. -/
theorem ghost_phase_history_eq_vacuum {R : Type*} [Fintype R] [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (n : ℕ) :
    ghostPhaseHistory a h η β n =
      (activeGhostRun a h η β (n + 1)).unborn +
      (activeGhostRun a h η β (n + 1)).completed := by
  let A := fun j => ghostPhaseScatter (a j) (h j)
  let B := fun j => ghostPhaseGather (a j) (h j) β
  let G := fun j => ghostPhaseVisit (a j) (h j) (η j) β
  have hK : finiteCompressionKernel A B G =
      (fun j => activeGhostFiniteKernel (a j) (h j) (η j) β) := by
    funext j x y
    exact (ghost_phase_kernel_factorization (a j) (h j) (η j) β x y).symm
  have hE : finiteCompressionStep A B G =
      (fun j x y => ∑ z, G (j + 1) x z *
        ghostPhaseEdge (a (j + 1)) (a j) (h (j + 1)) (h j) β z y) := by
    funext j x y
    simp only [finiteCompressionStep, ghostPhaseEdge, mul_sum, mul_assoc, A, B]
  have hI : finiteCompressionInitial B G ghostFiniteInitial =
      (fun x => ∑ y, G 0 x y * ghostPhaseInitial (a 0) β y) := by
    funext x
    simp only [finiteCompressionInitial, B]
    simp_rw [mul_assoc, ← mul_sum, ghost_phase_gather_initial]
  have hc := finite_path_action_compress_weighted A B G
    ghostFiniteInitial ghostFiniteTerminal n
  rw [hK, hE, hI] at hc
  simp_rw [A, ghost_phase_scatter_terminal] at hc
  have hv : (∑ x, ghostFiniteTerminal x *
      finitePathAction (fun j => activeGhostFiniteKernel (a j) (h j) (η j) β)
        ghostFiniteInitial (n + 1) x) =
      (activeGhostRun a h η β (n + 1)).unborn +
      (activeGhostRun a h η β (n + 1)).completed := by
    simp only [active_ghost_finite_action_eq_vector, ghostFiniteTerminal,
      Fintype.sum_option, activeGhostFiniteVector, one_mul, zero_mul,
      sum_const_zero, add_zero]
  rw [hv] at hc
  exact hc.symm

/-- This is the exact normalized active-residue expectation, including
single global births and the full active/inactive pattern. -/
theorem ghost_phase_history_residue_identity {R : Type*}
    [Fintype R] [DecidableEq R] [Nonempty R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (n : ℕ) (b : ℝ)
    (hb : b = 1 - (∑ j ∈ range (n + 1), η j) / Fintype.card R)
    (hb0 : b ≠ 0) :
    b * ghostPhaseHistory a h η ((Fintype.card R : ℝ) * b)⁻¹ n =
      (∑ r : R, activeResidueWeight (range (n + 1))
        ((range (n + 1)).filter (fun j => a j = true)) h η r) / Fintype.card R := by
  rw [ghost_phase_history_eq_vacuum,
    activeGhost_vacuum_identity a h η (n + 1) b hb hb0]
  simp_rw [activeGhost_product_eq_weight]
  exact mul_div_cancel₀ _ hb0
end

section
open Finset
section Local
variable {R : Type*} [DecidableEq R]

theorem ghost_phase_gather_invalid (a : Bool) (h : R) (β : ℝ)
    (z : GhostPhaseState R) (y : GhostFiniteState R) (hz : z.isSome ≠ !a) :
    ghostPhaseGather a h β z y = 0 := by
  cases a <;> cases z <;> simp_all [ghostPhaseGather]

theorem ghost_phase_scatter_invalid (a : Bool) (h : R)
    (x : GhostFiniteState R) (z : GhostPhaseState R) (hz : z.isSome ≠ !a) :
    ghostPhaseScatter a h x z = 0 := by
  cases a <;> cases z <;> simp_all [ghostPhaseScatter]

theorem ghost_phase_visit_left_invalid (a : Bool) (h : R) (η β : ℝ)
    (z w : GhostPhaseState R) (hz : z.isSome ≠ !a) :
    ghostPhaseVisit a h η β z w = 0 := by
  cases a <;> cases z <;> cases w <;> simp_all [ghostPhaseVisit]

theorem ghost_phase_visit_right_invalid (a : Bool) (h : R) (η β : ℝ)
    (z w : GhostPhaseState R) (hw : w.isSome ≠ !a) :
    ghostPhaseVisit a h η β z w = 0 := by
  cases a <;> cases z <;> cases w <;> simp_all [ghostPhaseVisit]

theorem ghost_phase_edge_left_invalid [Fintype R] (atgt asrc : Bool)
    (htgt hsrc : R) (β : ℝ) (z w : GhostPhaseState R) (hz : z.isSome ≠ !atgt) :
    ghostPhaseEdge atgt asrc htgt hsrc β z w = 0 := by
  unfold ghostPhaseEdge
  apply sum_eq_zero
  intro c _
  rw [ghost_phase_gather_invalid atgt htgt β z c hz, zero_mul]

theorem ghost_phase_edge_right_invalid [Fintype R] (atgt asrc : Bool)
    (htgt hsrc : R) (β : ℝ) (z w : GhostPhaseState R) (hw : w.isSome ≠ !asrc) :
    ghostPhaseEdge atgt asrc htgt hsrc β z w = 0 := by
  unfold ghostPhaseEdge
  apply sum_eq_zero
  intro c _
  rw [ghost_phase_scatter_invalid asrc hsrc c w hw, mul_zero]

end Local

/-- A single incompatible coordinate annihilates a supported tensor product. -/
theorem ghost_phase_prod_invalid {I M : Type*} [Fintype I] [CommMonoidWithZero M]
    {R : I → Type*} (a : I → Bool) (z : (i : I) → GhostPhaseState (R i))
    (f : I → M) (hf : ∀ i, (z i).isSome ≠ !(a i) → f i = 0)
    (hz : ¬ ghostPhaseMask a z) : (∏ i, f i) = 0 := by
  classical
  obtain ⟨i, hi⟩ : ∃ i, (z i).isSome ≠ !(a i) := by
    simpa only [ghostPhaseMask, not_forall] using hz
  exact prod_eq_zero (mem_univ i) (hf i hi)

section Tensor
variable {I : Type*} [Fintype I] {R : I → Type*} [∀ i, DecidableEq (R i)]

theorem ghost_phase_prod_gather_invalid (a : I → Bool) (h : (i : I) → R i)
    (β : I → ℝ) (z : (i : I) → GhostPhaseState (R i))
    (y : (i : I) → GhostFiniteState (R i)) (hz : ¬ ghostPhaseMask a z) :
    (∏ i, ghostPhaseGather (a i) (h i) (β i) (z i) (y i)) = 0 :=
  ghost_phase_prod_invalid a z _
    (fun _i hi => ghost_phase_gather_invalid _ _ _ _ _ hi) hz

theorem ghost_phase_prod_scatter_invalid (a : I → Bool) (h : (i : I) → R i)
    (x : (i : I) → GhostFiniteState (R i))
    (z : (i : I) → GhostPhaseState (R i)) (hz : ¬ ghostPhaseMask a z) :
    (∏ i, ghostPhaseScatter (a i) (h i) (x i) (z i)) = 0 :=
  ghost_phase_prod_invalid a z _
    (fun _i hi => ghost_phase_scatter_invalid _ _ _ _ hi) hz

theorem ghost_phase_prod_visit_left_invalid (a : I → Bool) (h : (i : I) → R i)
    (η β : I → ℝ) (z w : (i : I) → GhostPhaseState (R i))
    (hz : ¬ ghostPhaseMask a z) :
    (∏ i, ghostPhaseVisit (a i) (h i) (η i) (β i) (z i) (w i)) = 0 :=
  ghost_phase_prod_invalid a z _
    (fun _i hi => ghost_phase_visit_left_invalid _ _ _ _ _ _ hi) hz

theorem ghost_phase_prod_visit_right_invalid (a : I → Bool) (h : (i : I) → R i)
    (η β : I → ℝ) (z w : (i : I) → GhostPhaseState (R i))
    (hw : ¬ ghostPhaseMask a w) :
    (∏ i, ghostPhaseVisit (a i) (h i) (η i) (β i) (z i) (w i)) = 0 :=
  ghost_phase_prod_invalid a w _
    (fun _i hi => ghost_phase_visit_right_invalid _ _ _ _ _ _ hi) hw

theorem ghost_phase_prod_edge_left_invalid [∀ i, Fintype (R i)]
    (atgt asrc : I → Bool) (htgt hsrc : (i : I) → R i) (β : I → ℝ)
    (z w : (i : I) → GhostPhaseState (R i)) (hz : ¬ ghostPhaseMask atgt z) :
    (∏ i, ghostPhaseEdge (atgt i) (asrc i) (htgt i) (hsrc i) (β i) (z i) (w i)) = 0 :=
  ghost_phase_prod_invalid atgt z _
    (fun _i hi => ghost_phase_edge_left_invalid _ _ _ _ _ _ _ hi) hz

theorem ghost_phase_prod_edge_right_invalid [∀ i, Fintype (R i)]
    (atgt asrc : I → Bool) (htgt hsrc : (i : I) → R i) (β : I → ℝ)
    (z w : (i : I) → GhostPhaseState (R i)) (hw : ¬ ghostPhaseMask asrc w) :
    (∏ i, ghostPhaseEdge (atgt i) (asrc i) (htgt i) (hsrc i) (β i) (z i) (w i)) = 0 :=
  ghost_phase_prod_invalid asrc w _
    (fun _i hi => ghost_phase_edge_right_invalid _ _ _ _ _ _ _ hi) hw

end Tensor

/-- Package the already-proved ordered pending sum, for use by concrete kernels. -/
noncomputable def ghostPhaseOrderedPendingSum {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, Fintype (R i)] (a : I → Bool)
    (F : ((i : I) → GhostPhaseState (R i)) → ℝ) : ℝ :=
  ∑ S : Finset {i : I // a i = false},
    ∑ c : {i : {i : I // a i = false} // i ∉ S} → Bool,
      (∑ e : Fin (Fintype.card S) ≃ S,
        ∑ r : (j : Fin (Fintype.card S)) → R (e j).val.val,
          F (ghostPhaseAssemble a (ghostConfigurationAssemble
            ⟨S, Equiv.piCongrLeft (fun i : S => R i.val.val) e r, c⟩))) /
        ((Fintype.card S).factorial : ℝ)

/-- A valid phase configuration can be pending only at an inactive index. -/
theorem ghost_phase_pending_inactive {I : Type*} {R : I → Type*}
    (a : I → Bool) (z : (i : I) → GhostPhaseState (R i))
    (hz : ghostPhaseMask a z) (i : I) (r : R i)
    (hr : z i = some (some (some r))) : a i = false := by
  have hi := hz i
  rw [hr] at hi
  cases ha : a i <;> simp_all

section Weighted
variable {I : Type*} [Fintype I] [DecidableEq I] {R : I → Type*}
variable [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]

/-- The output of a tensor visit may be summed over ordered inactive pending memory. -/
theorem ghost_phase_visit_weighted_left_ordered (a : I → Bool) (h : (i : I) → R i)
    (η β : I → ℝ) (w : (i : I) → GhostPhaseState (R i))
    (F : ((i : I) → GhostPhaseState (R i)) → ℝ) :
    (∑ z, (∏ i, ghostPhaseVisit (a i) (h i) (η i) (β i) (z i) (w i)) * F z) =
      ghostPhaseOrderedPendingSum a
        (fun z => (∏ i, ghostPhaseVisit (a i) (h i) (η i) (β i) (z i) (w i)) * F z) := by
  apply ghost_phase_sum_ordered_pending
  intro z hz
  rw [ghost_phase_prod_visit_left_invalid a h η β z w hz, zero_mul]

/-- The input of a tensor visit has the same automatic mask support. -/
theorem ghost_phase_visit_weighted_right_ordered (a : I → Bool) (h : (i : I) → R i)
    (η β : I → ℝ) (z : (i : I) → GhostPhaseState (R i))
    (F : ((i : I) → GhostPhaseState (R i)) → ℝ) :
    (∑ w, (∏ i, ghostPhaseVisit (a i) (h i) (η i) (β i) (z i) (w i)) * F w) =
      ghostPhaseOrderedPendingSum a
        (fun w => (∏ i, ghostPhaseVisit (a i) (h i) (η i) (β i) (z i) (w i)) * F w) := by
  apply ghost_phase_sum_ordered_pending
  intro w hw
  rw [ghost_phase_prod_visit_right_invalid a h η β z w hw, zero_mul]

/-- Edge output memory is ordered only over target-inactive indices. -/
theorem ghost_phase_edge_weighted_left_ordered (atgt asrc : I → Bool)
    (htgt hsrc : (i : I) → R i) (β : I → ℝ) (w : (i : I) → GhostPhaseState (R i))
    (F : ((i : I) → GhostPhaseState (R i)) → ℝ) :
    (∑ z, (∏ i, ghostPhaseEdge (atgt i) (asrc i) (htgt i) (hsrc i) (β i) (z i) (w i)) * F z) =
      ghostPhaseOrderedPendingSum atgt
        (fun z => (∏ i, ghostPhaseEdge (atgt i) (asrc i) (htgt i) (hsrc i) (β i) (z i) (w i)) * F z) := by
  apply ghost_phase_sum_ordered_pending
  intro z hz
  rw [ghost_phase_prod_edge_left_invalid atgt asrc htgt hsrc β z w hz, zero_mul]

/-- Edge input memory is ordered only over source-inactive indices. -/
theorem ghost_phase_edge_weighted_right_ordered (atgt asrc : I → Bool)
    (htgt hsrc : (i : I) → R i) (β : I → ℝ) (z : (i : I) → GhostPhaseState (R i))
    (F : ((i : I) → GhostPhaseState (R i)) → ℝ) :
    (∑ w, (∏ i, ghostPhaseEdge (atgt i) (asrc i) (htgt i) (hsrc i) (β i) (z i) (w i)) * F w) =
      ghostPhaseOrderedPendingSum asrc
        (fun w => (∏ i, ghostPhaseEdge (atgt i) (asrc i) (htgt i) (hsrc i) (β i) (z i) (w i)) * F w) := by
  apply ghost_phase_sum_ordered_pending
  intro w hw
  rw [ghost_phase_prod_edge_right_invalid atgt asrc htgt hsrc β z w hw, zero_mul]

end Weighted
end

section
open Finset
noncomputable def alternatingTensorPairing {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] {𝕜 : Type*} [CommSemiring 𝕜]
    (G E : ℕ → (i : I) → X i → X i → 𝕜)
    (f q : (i : I) → X i → 𝕜) (n : ℕ) : 𝕜 :=
  ∑ x : (i : I) → X i, (∏ i, q i (x i)) * finitePathAction
    (fun j (x y : (i : I) → X i) =>
      ∑ z : (i : I) → X i, (∏ i, G (j + 1) i (x i) (z i)) *
        ∏ i, E j i (z i) (y i))
    (fun x => ∑ y : (i : I) → X i, (∏ i, G 0 i (x i) (y i)) *
      ∏ i, f i (y i)) n x

theorem alternating_tensor_pairing_factor {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] {𝕜 : Type*} [CommSemiring 𝕜]
    (G E : ℕ → (i : I) → X i → X i → 𝕜)
    (f q : (i : I) → X i → 𝕜) (n : ℕ) :
    alternatingTensorPairing G E f q n =
      ∏ i, ∑ x : X i, q i x * finitePathAction
        (fun j x y => ∑ z, G (j + 1) i x z * E j i z y)
        (fun x => ∑ y, G 0 i x y * f i y) n x := by
  classical
  unfold alternatingTensorPairing
  have hstep : (fun j (x y : (i : I) → X i) =>
      ∑ z : (i : I) → X i, (∏ i, G (j + 1) i (x i) (z i)) *
        ∏ i, E j i (z i) (y i)) =
      (fun j (x y : (i : I) → X i) =>
        ∏ i, ∑ z, G (j + 1) i (x i) z * E j i z (y i)) := by
    funext j x y
    simp_rw [← prod_mul_distrib]
    exact (Fintype.prod_sum (fun i z => G (j + 1) i (x i) z * E j i z (y i))).symm
  have hinit : (fun x : (i : I) → X i =>
      ∑ y : (i : I) → X i, (∏ i, G 0 i (x i) (y i)) * ∏ i, f i (y i)) =
      (fun x : (i : I) → X i => ∏ i, ∑ y, G 0 i (x i) y * f i y) := by
    funext x
    simp_rw [← prod_mul_distrib]
    exact (Fintype.prod_sum (fun i y => G 0 i (x i) y * f i y)).symm
  rw [hstep, hinit]
  simp_rw [finite_path_action_tensor
    (fun j i x y => ∑ z, G (j + 1) i x z * E j i z y)
    (fun i x => ∑ y, G 0 i x y * f i y)]
  simp only [← prod_mul_distrib]
  exact (Fintype.prod_sum (fun i x => q i x * finitePathAction
    (fun j x y => ∑ z, G (j + 1) i x z * E j i z y)
    (fun x => ∑ y, G 0 i x y * f i y) n x)).symm

noncomputable def ghostPhaseTensorHistory {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (a : I → ℕ → Bool) (h : (i : I) → ℕ → R i) (η : I → ℕ → ℝ)
    (β : I → ℝ) (n : ℕ) : ℝ :=
  alternatingTensorPairing
    (fun j i => ghostPhaseVisit (a i j) (h i j) (η i j) (β i))
    (fun j i => ghostPhaseEdge (a i (j + 1)) (a i j)
      (h i (j + 1)) (h i j) (β i))
    (fun i => ghostPhaseInitial (a i 0) (β i))
    (fun i => ghostPhaseTerminal (a i n)) n

theorem ghost_phase_tensor_history_factor {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (a : I → ℕ → Bool) (h : (i : I) → ℕ → R i) (η : I → ℕ → ℝ)
    (β : I → ℝ) (n : ℕ) :
    ghostPhaseTensorHistory a h η β n =
      ∏ i, ghostPhaseHistory (a i) (h i) (η i) (β i) n := by
  exact alternating_tensor_pairing_factor _ _ _ _ n

theorem ghost_phase_tensor_history_eq_vacuum {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (a : I → ℕ → Bool) (h : (i : I) → ℕ → R i) (η : I → ℕ → ℝ)
    (β : I → ℝ) (n : ℕ) :
    ghostPhaseTensorHistory a h η β n = activeGhostTensorVacuum a h η β (n + 1) := by
  rw [ghost_phase_tensor_history_factor, active_ghost_tensor_vacuum_factor]
  simp_rw [ghost_phase_history_eq_vacuum]

theorem pool_path_residue_eq_phase_history {I : Type*} [Fintype I] [DecidableEq I]
    (m : I → ℕ) [∀ i, NeZero (m i)] (a : I → ℕ → Bool)
    (h : (i : I) → ℕ → ZMod (m i)) (η : ℕ → ℝ) (n : ℕ) (b : I → ℝ)
    (hb : ∀ i, b i = 1 - (∑ j ∈ range (n + 1), η j) / m i)
    (hb0 : ∀ i, b i ≠ 0) :
    poolPathResidueExpectation m univ (range (n + 1))
      (fun i => (range (n + 1)).filter (fun j => a i j = true)) h η =
      (∏ i, b i) * ghostPhaseTensorHistory a h (fun _ => η)
        (fun i => ((m i : ℝ) * b i)⁻¹) n := by
  rw [ghost_phase_tensor_history_eq_vacuum]
  exact pool_path_residue_eq_memory m a h η (n + 1) b hb hb0
end

section
open Finset
/-- The initial phase test never starts with an inactive pending particle. -/
theorem ghost_phase_initial_diagonal_one {R : Type*} [DecidableEq R]
    (a : Bool) (hit : R) (β ρ : ℝ) (z : GhostPhaseState R)
    (hz : ghostPhaseInitial a β z ≠ 0) :
    ghostPhaseDiagonal hit ρ z = 1 := by
  cases a <;> rcases z with _ | (_ | (_ | r)) <;>
    simp_all [ghostPhaseInitial, ghostFiniteInitial, ghostPhaseDiagonal]

/-- The terminal phase test excludes all inactive pending particles. -/
theorem ghost_phase_terminal_diagonal_one {R : Type*} [DecidableEq R]
    (a : Bool) (hit : R) (ρ : ℝ) (z : GhostPhaseState R)
    (hz : ghostPhaseTerminal a z ≠ 0) :
    ghostPhaseDiagonal hit ρ z = 1 := by
  cases a <;> rcases z with _ | (_ | (_ | r)) <;>
    simp_all [ghostPhaseTerminal, ghostFiniteTerminal, ghostPhaseDiagonal]

/-- The alternating phase history with the actual rho-normalized visits and
the matching damped edges. There are n edges and n+1 visits. -/
noncomputable def ghostPhaseDampedHistory {R : Type*} [Fintype R] [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (ρ : ℕ → ℝ) (n : ℕ) : ℝ :=
  ∑ x, ghostPhaseTerminal (a n) x * finitePathAction
    (fun j x y => ∑ z,
      ghostPhaseDampedVisit (a (j + 1)) (h (j + 1)) (η (j + 1)) β (ρ (j + 1)) x z *
        ghostPhaseDampedEdge (a (j + 1)) (a j) (h (j + 1)) (h j)
          β (ρ (j + 1)) (ρ j) z y)
    (fun x => ∑ y, ghostPhaseDampedVisit (a 0) (h 0) (η 0) β (ρ 0) x y *
      ghostPhaseInitial (a 0) β y) n x

/-- Every interior rho factor cancels, and the vacuum boundary leaves no
uncanceled factor. Nonzero rho values may vary from visit to visit. -/
theorem ghost_phase_damped_history_eq_history {R : Type*}
    [Fintype R] [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (ρ : ℕ → ℝ)
    (hρ : ∀ j, ρ j ≠ 0) (n : ℕ) :
    ghostPhaseDampedHistory a h η β ρ n = ghostPhaseHistory a h η β n := by
  unfold ghostPhaseDampedHistory ghostPhaseHistory
  simpa only [ghostPhaseDampedVisit, ghostPhaseDampedEdge] using
    alternating_visit_edge_diagonal_pairing
      (fun j => ghostPhaseVisit (a j) (h j) (η j) β)
      (fun j => ghostPhaseEdge (a (j + 1)) (a j) (h (j + 1)) (h j) β)
      (fun j => ghostPhaseDiagonal (h j) (ρ j))
      (fun j x => ghostPhaseDiagonal_ne_zero (h j) (hρ j) x)
      (ghostPhaseInitial (a 0) β) (ghostPhaseTerminal (a n)) n
      (fun x hx => ghost_phase_initial_diagonal_one (a 0) (h 0) β (ρ 0) x hx)
      (fun x hx => ghost_phase_terminal_diagonal_one (a n) (h n) (ρ n) x hx)

/-- The damped phase history still equals the canonical irreversible vacuum. -/
theorem ghost_phase_damped_history_eq_vacuum {R : Type*}
    [Fintype R] [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (ρ : ℕ → ℝ)
    (hρ : ∀ j, ρ j ≠ 0) (n : ℕ) :
    ghostPhaseDampedHistory a h η β ρ n =
      (activeGhostRun a h η β (n + 1)).unborn +
        (activeGhostRun a h η β (n + 1)).completed := by
  rw [ghost_phase_damped_history_eq_history a h η β ρ hρ n]
  exact ghost_phase_history_eq_vacuum a h η β n

/-- The actual rho-normalized phase operators give the exact active-residue
expectation after extracting the common baseline, with n+1 visits. -/
theorem ghost_phase_damped_history_residue_identity {R : Type*}
    [Fintype R] [DecidableEq R] [Nonempty R]
    (a : ℕ → Bool) (h : ℕ → R) (η ρ : ℕ → ℝ)
    (hρ : ∀ j, ρ j ≠ 0) (n : ℕ) (b : ℝ)
    (hb : b = 1 - (∑ j ∈ range (n + 1), η j) / Fintype.card R)
    (hb0 : b ≠ 0) :
    b * ghostPhaseDampedHistory a h η ((Fintype.card R : ℝ) * b)⁻¹ ρ n =
      (∑ r : R, activeResidueWeight (range (n + 1))
        ((range (n + 1)).filter (fun j => a j = true)) h η r) / Fintype.card R := by
  rw [ghost_phase_damped_history_eq_history a h η _ ρ hρ n]
  exact ghost_phase_history_residue_identity a h η n b hb hb0
end

section
open Finset
/-- The normalized tensor history, with the phase initial and terminal tests. -/
noncomputable def ghostPhaseDampedTensorHistory {I : Type*}
    [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (a : I → ℕ → Bool) (h : (i : I) → ℕ → R i) (η : I → ℕ → ℝ)
    (β : I → ℝ) (ρ : I → ℕ → ℝ) (n : ℕ) : ℝ :=
  alternatingTensorPairing
    (fun j i => ghostPhaseDampedVisit (a i j) (h i j) (η i j) (β i) (ρ i j))
    (fun j i => ghostPhaseDampedEdge (a i (j + 1)) (a i j)
      (h i (j + 1)) (h i j) (β i) (ρ i (j + 1)) (ρ i j))
    (fun i => ghostPhaseInitial (a i 0) (β i))
    (fun i => ghostPhaseTerminal (a i n)) n

/-- Finite tensor factorization holds for the actual normalized operators. -/
theorem ghost_phase_damped_tensor_history_factor {I : Type*}
    [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (a : I → ℕ → Bool) (h : (i : I) → ℕ → R i) (η : I → ℕ → ℝ)
    (β : I → ℝ) (ρ : I → ℕ → ℝ) (n : ℕ) :
    ghostPhaseDampedTensorHistory a h η β ρ n =
      ∏ i, ghostPhaseDampedHistory (a i) (h i) (η i) (β i) (ρ i) n := by
  exact alternating_tensor_pairing_factor _ _ _ _ n

/-- All local rho normalizations cancel in the complete tensor history. -/
theorem ghost_phase_damped_tensor_history_eq_history {I : Type*}
    [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (a : I → ℕ → Bool) (h : (i : I) → ℕ → R i) (η : I → ℕ → ℝ)
    (β : I → ℝ) (ρ : I → ℕ → ℝ) (hρ : ∀ i j, ρ i j ≠ 0) (n : ℕ) :
    ghostPhaseDampedTensorHistory a h η β ρ n = ghostPhaseTensorHistory a h η β n := by
  rw [ghost_phase_damped_tensor_history_factor, ghost_phase_tensor_history_factor]
  apply prod_congr rfl
  intro i hi
  exact ghost_phase_damped_history_eq_history (a i) (h i) (η i) (β i) (ρ i) (hρ i) n

/-- The normalized tensor history is the canonical irreversible vacuum. -/
theorem ghost_phase_damped_tensor_history_eq_vacuum {I : Type*}
    [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (a : I → ℕ → Bool) (h : (i : I) → ℕ → R i) (η : I → ℕ → ℝ)
    (β : I → ℝ) (ρ : I → ℕ → ℝ) (hρ : ∀ i j, ρ i j ≠ 0) (n : ℕ) :
    ghostPhaseDampedTensorHistory a h η β ρ n =
      activeGhostTensorVacuum a h η β (n + 1) := by
  rw [ghost_phase_damped_tensor_history_eq_history a h η β ρ hρ n]
  exact ghost_phase_tensor_history_eq_vacuum a h η β n

/-- The independent-prime residue expression is exactly the damped phase
tensor history after extracting the common baselines. -/
theorem pool_path_residue_eq_damped_phase_history {I : Type*}
    [Fintype I] [DecidableEq I]
    (m : I → ℕ) [∀ i, NeZero (m i)] (a : I → ℕ → Bool)
    (h : (i : I) → ℕ → ZMod (m i)) (η : ℕ → ℝ)
    (ρ : I → ℕ → ℝ) (hρ : ∀ i j, ρ i j ≠ 0) (n : ℕ) (b : I → ℝ)
    (hb : ∀ i, b i = 1 - (∑ j ∈ range (n + 1), η j) / m i)
    (hb0 : ∀ i, b i ≠ 0) :
    poolPathResidueExpectation m univ (range (n + 1))
      (fun i => (range (n + 1)).filter (fun j => a i j = true)) h η =
      (∏ i, b i) * ghostPhaseDampedTensorHistory a h (fun _ => η)
        (fun i => ((m i : ℝ) * b i)⁻¹) ρ n := by
  rw [ghost_phase_damped_tensor_history_eq_history a h (fun _ => η) _ ρ hρ n]
  exact pool_path_residue_eq_phase_history m a h η n b hb hb0

/-- The physical marked-prime path has the same exact representation using
the actual damped tensor visits and edges, including all n+1 visits. -/
theorem physical_path_residue_eq_damped_phase_history
    {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (labels : ℕ → PhysicalMarkLists P J ell) (offset : ℕ → ℤ)
    (q : ℕ → ℝ) (ρ : PhysicalPrime P → ℕ → ℝ)
    (hρ : ∀ p j, ρ p j ≠ 0) (n : ℕ) (b : PhysicalPrime P → ℝ)
    (hb : ∀ p, b p = 1 - (∑ j ∈ range (n + 1), (1 - q j)) / p.2.val)
    (hb0 : ∀ p, b p ≠ 0) :
    poolPathResidueExpectation (fun p : PhysicalPrime P => p.2.val) univ (range (n + 1))
      (fun p => (range (n + 1)).filter (fun j => p ∈ physicalMarkedPrimes (labels j)))
      (fun p j => -(offset j : ZMod p.2.val)) (fun j => 1 - q j) =
      (∏ p, b p) * ghostPhaseDampedTensorHistory
        (fun p j => decide (p ∈ physicalMarkedPrimes (labels j)))
        (fun p j => -(offset j : ZMod p.2.val)) (fun _ j => 1 - q j)
        (fun p => ((p.2.val : ℝ) * b p)⁻¹) ρ n := by
  rw [ghost_phase_damped_tensor_history_eq_vacuum _ _ _ _ ρ hρ n]
  exact physical_path_residue_eq_memory labels offset q (n + 1) b hb hb0
end

section
open Finset
/-- The number of active runs among visits `0,...,n`. -/
def ghostPhaseRunCount (a : ℕ → Bool) : ℕ → ℕ
  | 0 => if a 0 then 1 else 0
  | n + 1 => ghostPhaseRunCount a n + if a (n + 1) && !(a n) then 1 else 0

/-- An initial active slot starts one active run. -/
noncomputable def ghostPhaseRunInitial {R : Type*} (a : Bool) (β V : ℝ)
    (x : GhostPhaseState R) : ℝ :=
  (if a then V⁻¹ else 1) * ghostPhaseInitial a β x

/-- Only an inactive-to-active entry starts a new run across an edge. -/
noncomputable def ghostPhaseRunEdge {R : Type*} [Fintype R] [DecidableEq R]
    (aTarget aSource : Bool) (hTarget hSource : R) (β V : ℝ)
    (x y : GhostPhaseState R) : ℝ :=
  (if aTarget && !aSource then V⁻¹ else 1) *
    ghostPhaseEdge aTarget aSource hTarget hSource β x y

/-- The alternating phase history with the group factor charged at exactly
the start of each active run. The terminal test is unchanged. -/
noncomputable def ghostPhaseRunHistory {R : Type*} [Fintype R] [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β V : ℝ) (n : ℕ) : ℝ :=
  ∑ x, ghostPhaseTerminal (a n) x * finitePathAction
    (fun j x y => ∑ z, ghostPhaseVisit (a (j + 1)) (h (j + 1)) (η (j + 1)) β x z *
      ghostPhaseRunEdge (a (j + 1)) (a j) (h (j + 1)) (h j) β V z y)
    (fun x => ∑ y, ghostPhaseVisit (a 0) (h 0) (η 0) β x y *
      ghostPhaseRunInitial (a 0) β V y) n x

/-- Initial activity has the required fresh-label mass `beta / V`. -/
theorem ghost_phase_run_initial_active {R : Type*} (β V : ℝ) :
    ghostPhaseRunInitial true β V (none : GhostPhaseState R) = β / V := by
  simp [ghostPhaseRunInitial, ghostPhaseInitial, div_eq_mul_inv, mul_comm]

/-- Fresh active entries pay `beta / V`, the modified prime measure. -/
theorem ghost_phase_run_edge_fresh {R : Type*} [Fintype R] [DecidableEq R]
    (hTarget hSource : R) (β V : ℝ) :
    ghostPhaseRunEdge true false hTarget hSource β V none (some none) = β / V := by
  simp [ghostPhaseRunEdge, ghost_phase_edge_active_inactive, ghostActiveInput,
    div_eq_mul_inv, mul_comm]

/-- A promotion pays `1 / V` and no additional reciprocal-prime factor. -/
theorem ghost_phase_run_edge_promotion {R : Type*} [Fintype R] [DecidableEq R]
    (hTarget hSource r : R) (β V : ℝ) :
    ghostPhaseRunEdge true false hTarget hSource β V none
      (some (some (some r))) = if r = hTarget then V⁻¹ else 0 := by
  simp [ghostPhaseRunEdge, ghost_phase_edge_active_inactive, ghostActiveInput]

/-- Shared activity receives no new run charge. -/
theorem ghost_phase_run_edge_shared {R : Type*} [Fintype R] [DecidableEq R]
    (hTarget hSource : R) (β V : ℝ) :
    ghostPhaseRunEdge true true hTarget hSource β V none none =
      if hSource = hTarget then 1 else 0 := by
  simp [ghostPhaseRunEdge, ghost_phase_edge_active_active]

/-- The full normalized alternating history differs by exactly one group
factor per active run, including the initial run and excluding the terminal test. -/
theorem ghost_phase_run_history_eq {R : Type*} [Fintype R] [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β V : ℝ) (n : ℕ) :
    ghostPhaseRunHistory a h η β V n =
      (V⁻¹) ^ ghostPhaseRunCount a n * ghostPhaseHistory a h η β n := by
  let K := fun j (x y : GhostPhaseState R) =>
    ∑ z, ghostPhaseVisit (a (j + 1)) (h (j + 1)) (η (j + 1)) β x z *
      ghostPhaseEdge (a (j + 1)) (a j) (h (j + 1)) (h j) β z y
  let f := fun x : GhostPhaseState R =>
    ∑ y, ghostPhaseVisit (a 0) (h 0) (η 0) β x y * ghostPhaseInitial (a 0) β y
  let c := fun j => if a (j + 1) && !(a j) then V⁻¹ else 1
  let d := if a 0 then V⁻¹ else 1
  have hK : (fun j (x y : GhostPhaseState R) =>
      ∑ z, ghostPhaseVisit (a (j + 1)) (h (j + 1)) (η (j + 1)) β x z *
        ghostPhaseRunEdge (a (j + 1)) (a j) (h (j + 1)) (h j) β V z y) =
      (fun j x y => c j * K j x y) := by
    funext j x y
    simp only [ghostPhaseRunEdge, K, c, mul_sum]
    apply sum_congr rfl
    intro z _
    ring
  have hf : (fun x : GhostPhaseState R =>
      ∑ y, ghostPhaseVisit (a 0) (h 0) (η 0) β x y * ghostPhaseRunInitial (a 0) β V y) =
      (fun x => d * f x) := by
    funext x
    simp only [ghostPhaseRunInitial, d, f, mul_sum]
    apply sum_congr rfl
    intro y _
    ring
  have hc (j : ℕ) : c j * (V⁻¹) ^ ghostPhaseRunCount a j =
      (V⁻¹) ^ ghostPhaseRunCount a (j + 1) := by
    simp only [ghostPhaseRunCount, pow_add, c]
    cases a (j + 1) <;> cases a j <;> simp [mul_comm]
  have haction (m : ℕ) (x : GhostPhaseState R) :
      finitePathAction (fun j x y => c j * K j x y) (fun x => d * f x) m x =
        (V⁻¹) ^ ghostPhaseRunCount a m * finitePathAction K f m x := by
    induction m generalizing x with
    | zero =>
      simp only [finitePathAction, ghostPhaseRunCount, d]
      cases a 0 <;> simp
    | succ m ih =>
      simp only [finitePathAction, ih]
      calc
        _ = (c m * (V⁻¹) ^ ghostPhaseRunCount a m) *
            (∑ y, K m x y * finitePathAction K f m y) := by
          rw [mul_sum]
          apply sum_congr rfl
          intro y _
          ring
        _ = _ := by rw [hc]
  unfold ghostPhaseRunHistory
  rw [hK, hf]
  simp_rw [haction]
  change (∑ x, ghostPhaseTerminal (a n) x *
      ((V⁻¹) ^ ghostPhaseRunCount a n * finitePathAction K f n x)) =
    (V⁻¹) ^ ghostPhaseRunCount a n *
      (∑ x, ghostPhaseTerminal (a n) x * finitePathAction K f n x)
  rw [mul_sum]
  apply sum_congr rfl
  intro x _
  ring

/-- Restoring the baseline gives the original residue expectation with
the required `V^(-number of active runs)` mark normalization. -/
theorem ghost_phase_run_history_residue_identity {R : Type*}
    [Fintype R] [DecidableEq R] [Nonempty R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (V : ℝ) (n : ℕ) (b : ℝ)
    (hb : b = 1 - (∑ j ∈ range (n + 1), η j) / Fintype.card R)
    (hb0 : b ≠ 0) :
    b * ghostPhaseRunHistory a h η ((Fintype.card R : ℝ) * b)⁻¹ V n =
      (V⁻¹) ^ ghostPhaseRunCount a n *
        ((∑ r : R, activeResidueWeight (range (n + 1))
          ((range (n + 1)).filter (fun j => a j = true)) h η r) / Fintype.card R) := by
  rw [ghost_phase_run_history_eq, ← mul_assoc, mul_comm b, mul_assoc]
  rw [ghost_phase_history_residue_identity a h η n b hb hb0]
end

section
open Finset
/-- Lifecycle rank: unborn is zero, active/pending is one, completed is two. -/
def ghostPhaseRank {R : Type*} : GhostPhaseState R → ℕ
  | none => 1
  | some none => 0
  | some (some none) => 2
  | some (some (some _)) => 1

theorem ghost_phase_rank_zero_iff {R : Type*} (z : GhostPhaseState R) :
    ghostPhaseRank z = 0 ↔ z = some none := by
  rcases z with _ | (_ | (_ | r)) <;> simp [ghostPhaseRank]

theorem ghost_phase_rank_two_iff {R : Type*} (z : GhostPhaseState R) :
    ghostPhaseRank z = 2 ↔ z = some (some none) := by
  rcases z with _ | (_ | (_ | r)) <;> simp [ghostPhaseRank]

theorem ghost_phase_rank_le_two {R : Type*} (z : GhostPhaseState R) :
    ghostPhaseRank z ≤ 2 := by
  rcases z with _ | (_ | (_ | r)) <;> simp [ghostPhaseRank]

/-- Every nonzero visit coefficient moves forwards in the lifecycle. -/
theorem ghost_phase_visit_rank_mono {R : Type*} [DecidableEq R]
    (a : Bool) (h : R) (η β : ℝ) (z w : GhostPhaseState R)
    (hn : ghostPhaseVisit a h η β z w ≠ 0) : ghostPhaseRank w ≤ ghostPhaseRank z := by
  cases a <;> rcases z with _ | (_ | (_ | r)) <;>
    rcases w with _ | (_ | (_ | s)) <;>
      simp_all [ghostPhaseVisit, ghostFiniteKernel, ghostPhaseRank]

/-- Every nonzero edge coefficient also moves forwards in the lifecycle. -/
theorem ghost_phase_edge_rank_mono {R : Type*} [Fintype R] [DecidableEq R]
    (atgt asrc : Bool) (htgt hsrc : R) (β : ℝ) (z w : GhostPhaseState R)
    (hn : ghostPhaseEdge atgt asrc htgt hsrc β z w ≠ 0) :
    ghostPhaseRank w ≤ ghostPhaseRank z := by
  cases atgt <;> cases asrc <;> rcases z with _ | (_ | (_ | r)) <;>
    rcases w with _ | (_ | (_ | s)) <;>
      simp_all [ghostPhaseEdge, ghostPhaseGather, ghostPhaseScatter,
        ghostActiveInput, ghostActiveOutput, ghostPhaseRank]

/-- Completed memory cannot re-enter an active or pending phase through a visit. -/
theorem ghost_phase_visit_done_absorbing {R : Type*} [DecidableEq R]
    (a : Bool) (h : R) (η β : ℝ) (z : GhostPhaseState R)
    (hn : ghostPhaseVisit a h η β z (some (some none)) ≠ 0) :
    z = some (some none) := by
  apply (ghost_phase_rank_two_iff z).1
  have hm := ghost_phase_visit_rank_mono a h η β z (some (some none)) hn
  have hb := ghost_phase_rank_le_two z
  simpa only [ghostPhaseRank] using Nat.le_antisymm hb hm

/-- Completed memory cannot re-enter an active or pending phase through an edge. -/
theorem ghost_phase_edge_done_absorbing {R : Type*} [Fintype R] [DecidableEq R]
    (atgt asrc : Bool) (htgt hsrc : R) (β : ℝ) (z : GhostPhaseState R)
    (hn : ghostPhaseEdge atgt asrc htgt hsrc β z (some (some none)) ≠ 0) :
    z = some (some none) := by
  apply (ghost_phase_rank_two_iff z).1
  have hm := ghost_phase_edge_rank_mono atgt asrc htgt hsrc β z (some (some none)) hn
  have hb := ghost_phase_rank_le_two z
  simpa only [ghostPhaseRank] using Nat.le_antisymm hb hm

/-- A finite sequence of forward lifecycle moves is monotone between any two times. -/
theorem ghost_phase_path_rank_mono {R : Type*} (q : ℕ → GhostPhaseState R) (n : ℕ)
    (hs : ∀ j < n, ghostPhaseRank (q j) ≤ ghostPhaseRank (q (j + 1))) :
    ∀ i j, i ≤ j → j ≤ n → ghostPhaseRank (q i) ≤ ghostPhaseRank (q j) := by
  intro i j
  induction j with
  | zero =>
    intro hij _
    have : i = 0 := by omega
    subst i
    exact le_rfl
  | succ j ih =>
    intro hij hjn
    by_cases hij' : i ≤ j
    · exact le_trans (ih hij' (by omega)) (hs j (by omega))
    · have : i = j + 1 := by omega
      subst i
      exact le_rfl

/-- After a fresh birth, no later state can be unborn again. -/
theorem ghost_phase_path_no_unborn_recovery {R : Type*}
    (q : ℕ → GhostPhaseState R) (n : ℕ)
    (hs : ∀ j < n, ghostPhaseRank (q j) ≤ ghostPhaseRank (q (j + 1)))
    (i j : ℕ) (hij : i ≤ j) (hjn : j ≤ n) (hi : q i ≠ some none) :
    q j ≠ some none := by
  intro hj
  have hm := ghost_phase_path_rank_mono q n hs i j hij hjn
  have hr : ghostPhaseRank (q i) ≠ 0 := by
    exact fun hzero => hi ((ghost_phase_rank_zero_iff (q i)).1 hzero)
  rw [hj] at hm
  change ghostPhaseRank (q i) ≤ 0 at hm
  exact hr (Nat.eq_zero_of_le_zero hm)

/-- The explicit set of fresh unborn-to-born transitions has at most one member. -/
theorem ghost_phase_at_most_one_birth {R : Type*} [DecidableEq R]
    (q : ℕ → GhostPhaseState R) (n : ℕ)
    (hs : ∀ j < n, ghostPhaseRank (q j) ≤ ghostPhaseRank (q (j + 1))) :
    ((range n).filter (fun j => q j = some none ∧ q (j + 1) ≠ some none)).card ≤ 1 := by
  apply card_le_one.2
  intro i hi j hj
  simp only [mem_filter, mem_range] at hi hj
  by_contra hij
  rcases lt_or_gt_of_ne hij with hij | hji
  · exact ghost_phase_path_no_unborn_recovery q n hs (i + 1) j
      (by omega) (by omega) hi.2.2 hj.2.1
  · exact ghost_phase_path_no_unborn_recovery q n hs (j + 1) i
      (by omega) (by omega) hj.2.2 hi.2.1

/-- An actual nonzero finite path product, with any ordered mixture of visits
and edges, has at most one fresh birth. No sign or positivity assumption is used. -/
theorem ghost_phase_nonzero_path_distinct_birth {R : Type*} [Fintype R] [DecidableEq R]
    (isVisit atgt asrc : ℕ → Bool) (htgt hsrc : ℕ → R) (η β : ℕ → ℝ)
    (q : ℕ → GhostPhaseState R) (n : ℕ)
    (hn : (∏ j ∈ range n,
      (if isVisit j then ghostPhaseVisit (atgt j) (htgt j) (η j) (β j) (q (j + 1)) (q j)
       else ghostPhaseEdge (atgt j) (asrc j) (htgt j) (hsrc j) (β j)
         (q (j + 1)) (q j))) ≠ 0) :
    ((range n).filter (fun j => q j = some none ∧ q (j + 1) ≠ some none)).card ≤ 1 := by
  apply ghost_phase_at_most_one_birth q n
  intro j hj
  have hjn := (prod_ne_zero_iff.mp hn) j (mem_range.mpr hj)
  cases hv : isVisit j
  · simp only [hv, Bool.false_eq_true, ↓reduceIte] at hjn
    exact ghost_phase_edge_rank_mono _ _ _ _ _ _ _ hjn
  · simp only [hv, ↓reduceIte] at hjn
    exact ghost_phase_visit_rank_mono _ _ _ _ _ _ hjn

/-- A path with more than one fresh birth has exactly zero coefficient. -/
theorem ghost_phase_repeated_birth_path_zero {R : Type*} [Fintype R] [DecidableEq R]
    (isVisit atgt asrc : ℕ → Bool) (htgt hsrc : ℕ → R) (η β : ℕ → ℝ)
    (q : ℕ → GhostPhaseState R) (n : ℕ)
    (hb : 1 < ((range n).filter
      (fun j => q j = some none ∧ q (j + 1) ≠ some none)).card) :
    (∏ j ∈ range n,
      (if isVisit j then ghostPhaseVisit (atgt j) (htgt j) (η j) (β j) (q (j + 1)) (q j)
       else ghostPhaseEdge (atgt j) (asrc j) (htgt j) (hsrc j) (β j)
         (q (j + 1)) (q j))) = 0 := by
  by_contra hn
  have hle := ghost_phase_nonzero_path_distinct_birth isVisit atgt asrc htgt hsrc η β q n hn
  omega

/-- Every prime coordinate in a nonzero tensor history has at most one fresh
birth over the entire history. This is a property of the numerical path product. -/
theorem ghost_phase_nonzero_tensor_path_distinct_birth {I : Type*} [Fintype I]
    {R : I → Type*} [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (isVisit : ℕ → Bool) (atgt asrc : ℕ → I → Bool)
    (htgt hsrc : ℕ → (i : I) → R i) (η β : ℕ → I → ℝ)
    (q : ℕ → (i : I) → GhostPhaseState (R i)) (n : ℕ)
    (hn : (∏ j ∈ range n, ∏ i,
      (if isVisit j then ghostPhaseVisit (atgt j i) (htgt j i) (η j i) (β j i)
          (q (j + 1) i) (q j i)
       else ghostPhaseEdge (atgt j i) (asrc j i) (htgt j i) (hsrc j i) (β j i)
         (q (j + 1) i) (q j i))) ≠ 0) (i : I) :
    ((range n).filter (fun j => q j i = some none ∧ q (j + 1) i ≠ some none)).card ≤ 1 := by
  apply ghost_phase_nonzero_path_distinct_birth isVisit
    (fun j => atgt j i) (fun j => asrc j i) (fun j => htgt j i) (fun j => hsrc j i)
    (fun j => η j i) (fun j => β j i) (fun j => q j i) n
  apply prod_ne_zero_iff.mpr
  intro j hj
  exact (prod_ne_zero_iff.mp ((prod_ne_zero_iff.mp hn) j hj)) i (mem_univ i)
end

section

/-- Shift inactive pending residues, fixing the active phase and both vacua. -/
def ghostPhaseShift {R : Type*} [AddGroup R] (t : R) :
    GhostPhaseState R ≃ GhostPhaseState R :=
  Equiv.optionCongr (ghostMemoryShift t)

theorem ghostPhaseShift_active {R : Type*} [AddGroup R] (t : R) :
    ghostPhaseShift t (none : GhostPhaseState R) = none := rfl

theorem ghostPhaseShift_unborn {R : Type*} [AddGroup R] (t : R) :
    ghostPhaseShift t (some none : GhostPhaseState R) = some none := rfl

theorem ghostPhaseShift_completed {R : Type*} [AddGroup R] (t : R) :
    ghostPhaseShift t (some (some none) : GhostPhaseState R) = some (some none) := rfl

theorem ghostPhaseShift_pending {R : Type*} [AddGroup R] (t r : R) :
    ghostPhaseShift t (some (some (some r))) = some (some (some (r - t))) := rfl

theorem ghostPhaseShift_add {R : Type*} [AddGroup R]
    (t u : R) (x : GhostPhaseState R) :
    ghostPhaseShift (t + u) x = ghostPhaseShift t (ghostPhaseShift u x) := by
  cases x with
  | none => rfl
  | some x =>
      change some (ghostMemoryShift (t + u) x) =
        some (ghostMemoryShift t (ghostMemoryShift u x))
      rw [ghostMemoryShift_add]

theorem ghostPhaseShift_symm {R : Type*} [AddGroup R]
    (t : R) (x : GhostPhaseState R) :
    (ghostPhaseShift t).symm x = ghostPhaseShift (-t) x := by
  cases x with
  | none => rfl
  | some x =>
      change some ((ghostMemoryShift t).symm x) = some (ghostMemoryShift (-t) x)
      rw [ghostMemoryShift_symm]

/-- Simultaneous translation preserves the gather operation. -/
theorem ghost_phase_gather_translation {R : Type*} [AddGroup R] [DecidableEq R]
    (a : Bool) (h t : R) (β : ℝ) (z : GhostPhaseState R) (c : GhostFiniteState R) :
    ghostPhaseGather a h β z c =
      ghostPhaseGather a (h - t) β (ghostPhaseShift t z) (ghostMemoryShift t c) := by
  cases a <;> rcases z with _ | (_ | (_ | r)) <;> rcases c with _ | (_ | s) <;>
    simp [ghostPhaseGather, ghostActiveInput, ghostPhaseShift, ghostMemoryShift]

/-- Simultaneous translation preserves the scatter operation. -/
theorem ghost_phase_scatter_translation {R : Type*} [AddGroup R] [DecidableEq R]
    (a : Bool) (h t : R) (c : GhostFiniteState R) (z : GhostPhaseState R) :
    ghostPhaseScatter a h c z =
      ghostPhaseScatter a (h - t) (ghostMemoryShift t c) (ghostPhaseShift t z) := by
  cases a <;> rcases z with _ | (_ | (_ | r)) <;> rcases c with _ | (_ | s) <;>
    simp [ghostPhaseScatter, ghostActiveOutput, ghostPhaseShift, ghostMemoryShift]

/-- Simultaneous translation preserves the actual phase visit. -/
theorem ghost_phase_visit_translation {R : Type*} [AddGroup R] [DecidableEq R]
    (a : Bool) (h t : R) (η β : ℝ) (x y : GhostPhaseState R) :
    ghostPhaseVisit a h η β x y =
      ghostPhaseVisit a (h - t) η β (ghostPhaseShift t x) (ghostPhaseShift t y) := by
  cases a <;> rcases x with _ | (_ | (_ | r)) <;> rcases y with _ | (_ | (_ | s)) <;>
    simp [ghostPhaseVisit, ghostFiniteKernel, ghostPhaseShift, ghostMemoryShift]

/-- An edge is unchanged when both endpoint hit residues and both endpoint
phase states are translated by the same frame. -/
theorem ghost_phase_edge_translation {R : Type*}
    [AddGroup R] [Fintype R] [DecidableEq R]
    (aTarget aSource : Bool) (hTarget hSource t : R) (β : ℝ)
    (x y : GhostPhaseState R) :
    ghostPhaseEdge aTarget aSource hTarget hSource β x y =
      ghostPhaseEdge aTarget aSource (hTarget - t) (hSource - t) β
        (ghostPhaseShift t x) (ghostPhaseShift t y) := by
  unfold ghostPhaseEdge
  calc
    _ = ∑ c, ghostPhaseGather aTarget (hTarget - t) β
          (ghostPhaseShift t x) (ghostMemoryShift t c) *
        ghostPhaseScatter aSource (hSource - t)
          (ghostMemoryShift t c) (ghostPhaseShift t y) := by
      apply Finset.sum_congr rfl
      intro c hc
      rw [ghost_phase_gather_translation aTarget hTarget t,
        ghost_phase_scatter_translation aSource hSource t]
    _ = _ := (ghostMemoryShift t).sum_comp
      (fun c => ghostPhaseGather aTarget (hTarget - t) β (ghostPhaseShift t x) c *
        ghostPhaseScatter aSource (hSource - t) c (ghostPhaseShift t y))

/-- The rho diagonal is covariant under the same translation. -/
theorem ghost_phase_diagonal_translation {R : Type*} [AddGroup R] [DecidableEq R]
    (h t : R) (ρ : ℝ) (x : GhostPhaseState R) :
    ghostPhaseDiagonal h ρ x = ghostPhaseDiagonal (h - t) ρ (ghostPhaseShift t x) := by
  rcases x with _ | (_ | (_ | r)) <;>
    simp [ghostPhaseDiagonal, ghostPhaseShift, ghostMemoryShift]

theorem ghost_phase_damped_visit_translation {R : Type*} [AddGroup R] [DecidableEq R]
    (a : Bool) (h t : R) (η β ρ : ℝ) (x y : GhostPhaseState R) :
    ghostPhaseDampedVisit a h η β ρ x y =
      ghostPhaseDampedVisit a (h - t) η β ρ (ghostPhaseShift t x) (ghostPhaseShift t y) := by
  unfold ghostPhaseDampedVisit
  rw [ghost_phase_visit_translation a h t, ghost_phase_diagonal_translation h t ρ x,
    ghost_phase_diagonal_translation h t ρ y]

theorem ghost_phase_damped_edge_translation {R : Type*}
    [AddGroup R] [Fintype R] [DecidableEq R]
    (aTarget aSource : Bool) (hTarget hSource t : R) (β ρTarget ρSource : ℝ)
    (x y : GhostPhaseState R) :
    ghostPhaseDampedEdge aTarget aSource hTarget hSource β ρTarget ρSource x y =
      ghostPhaseDampedEdge aTarget aSource (hTarget - t) (hSource - t) β ρTarget ρSource
        (ghostPhaseShift t x) (ghostPhaseShift t y) := by
  unfold ghostPhaseDampedEdge
  rw [ghost_phase_edge_translation aTarget aSource hTarget hSource t,
    ghost_phase_diagonal_translation hTarget t ρTarget x,
    ghost_phase_diagonal_translation hSource t ρSource y]

/-- A visit expressed in its own frame has hit residue zero. -/
theorem ghost_phase_visit_relative_zero {R : Type*} [AddGroup R] [DecidableEq R]
    (a : Bool) (h : R) (η β : ℝ) (x y : GhostPhaseState R) :
    ghostPhaseVisit a h η β ((ghostPhaseShift h).symm x) ((ghostPhaseShift h).symm y) =
      ghostPhaseVisit a 0 η β x y := by
  rw [ghost_phase_visit_translation a h h]
  simp only [sub_self, Equiv.apply_symm_apply]

theorem ghost_phase_diagonal_relative_zero {R : Type*} [AddGroup R] [DecidableEq R]
    (h : R) (ρ : ℝ) (x : GhostPhaseState R) :
    ghostPhaseDiagonal h ρ ((ghostPhaseShift h).symm x) = ghostPhaseDiagonal 0 ρ x := by
  rw [ghost_phase_diagonal_translation h h]
  simp only [sub_self, Equiv.apply_symm_apply]

theorem ghost_phase_damped_visit_relative_zero {R : Type*} [AddGroup R] [DecidableEq R]
    (a : Bool) (h : R) (η β ρ : ℝ) (x y : GhostPhaseState R) :
    ghostPhaseDampedVisit a h η β ρ ((ghostPhaseShift h).symm x) ((ghostPhaseShift h).symm y) =
      ghostPhaseDampedVisit a 0 η β ρ x y := by
  rw [ghost_phase_damped_visit_translation a h h]
  simp only [sub_self, Equiv.apply_symm_apply]

/-- The source-frame pending coordinate is translated into the target frame
by r -> r-delta. In that frame the two hit residues are zero and -delta. -/
noncomputable def ghostPhaseMovingEdge {R : Type*}
    [AddGroup R] [Fintype R] [DecidableEq R]
    (aTarget aSource : Bool) (delta : R) (β : ℝ) (x y : GhostPhaseState R) : ℝ :=
  ghostPhaseEdge aTarget aSource 0 (-delta) β x (ghostPhaseShift delta y)

theorem ghost_phase_edge_conjugation {R : Type*}
    [AddGroup R] [Fintype R] [DecidableEq R]
    (aTarget aSource : Bool) (hTarget hSource : R) (β : ℝ) (x y : GhostPhaseState R) :
    ghostPhaseEdge aTarget aSource hTarget hSource β
      ((ghostPhaseShift hTarget).symm x) ((ghostPhaseShift hSource).symm y) =
      ghostPhaseMovingEdge aTarget aSource (hTarget - hSource) β x y := by
  rw [ghost_phase_edge_translation aTarget aSource hTarget hSource hTarget,
    Equiv.apply_symm_apply, ghostPhaseShift_symm, ← ghostPhaseShift_add]
  simp only [ghostPhaseMovingEdge, sub_self, sub_eq_add_neg, neg_add_rev, neg_neg]

/-- In local frames each endpoint damping tests residue zero in that
endpoint's own coordinate system. -/
noncomputable def ghostPhaseDampedMovingEdge {R : Type*}
    [AddGroup R] [Fintype R] [DecidableEq R]
    (aTarget aSource : Bool) (delta : R) (β ρTarget ρSource : ℝ)
    (x y : GhostPhaseState R) : ℝ :=
  ghostPhaseDiagonal 0 ρTarget x * ghostPhaseMovingEdge aTarget aSource delta β x y *
    ghostPhaseDiagonal 0 ρSource y

/-- Equivalently, shift the input to the target frame before evaluating the
damped edge whose source hit is minus delta in that frame. -/
theorem ghost_phase_damped_moving_edge_eq_shifted {R : Type*}
    [AddGroup R] [Fintype R] [DecidableEq R]
    (aTarget aSource : Bool) (delta : R) (β ρTarget ρSource : ℝ)
    (x y : GhostPhaseState R) :
    ghostPhaseDampedMovingEdge aTarget aSource delta β ρTarget ρSource x y =
      ghostPhaseDampedEdge aTarget aSource 0 (-delta) β ρTarget ρSource
        x (ghostPhaseShift delta y) := by
  unfold ghostPhaseDampedMovingEdge ghostPhaseDampedEdge ghostPhaseMovingEdge
  rw [ghost_phase_diagonal_translation 0 delta ρSource y]
  simp only [zero_sub]

theorem ghost_phase_damped_edge_conjugation {R : Type*}
    [AddGroup R] [Fintype R] [DecidableEq R]
    (aTarget aSource : Bool) (hTarget hSource : R) (β ρTarget ρSource : ℝ)
    (x y : GhostPhaseState R) :
    ghostPhaseDampedEdge aTarget aSource hTarget hSource β ρTarget ρSource
      ((ghostPhaseShift hTarget).symm x) ((ghostPhaseShift hSource).symm y) =
      ghostPhaseDampedMovingEdge aTarget aSource (hTarget - hSource) β ρTarget ρSource x y := by
  unfold ghostPhaseDampedEdge ghostPhaseDampedMovingEdge
  rw [ghost_phase_edge_conjugation,
    ghost_phase_diagonal_relative_zero, ghost_phase_diagonal_relative_zero]

/-- Shared activity requires zero frame displacement. -/
theorem ghost_phase_moving_edge_active_active {R : Type*}
    [AddGroup R] [Fintype R] [DecidableEq R] (delta : R) (β : ℝ) :
    ghostPhaseMovingEdge true true delta β none none =
      if delta = 0 then 1 else 0 := by
  rw [ghostPhaseMovingEdge, ghostPhaseShift_active, ghost_phase_edge_active_active]
  simp only [neg_eq_zero]

/-- Storage is born at source residue zero and arrives at target residue
minus delta. Dropping an active particle instead completes its lifespan. -/
theorem ghost_phase_moving_edge_inactive_active {R : Type*}
    [AddGroup R] [Fintype R] [DecidableEq R]
    (delta : R) (β : ℝ) (x : GhostFiniteState R) :
    ghostPhaseMovingEdge false true delta β (some x) none =
      match x with
      | none => 0
      | some none => 1
      | some (some r) => if r = -delta then 1 else 0 := by
  rw [ghostPhaseMovingEdge, ghostPhaseShift_active, ghost_phase_edge_inactive_active]
  rcases x with _ | (_ | r) <;> rfl

/-- Promotion checks target residue zero: the source-frame pending residue
must equal delta. Fresh active births retain their single beta factor. -/
theorem ghost_phase_moving_edge_active_inactive {R : Type*}
    [AddGroup R] [Fintype R] [DecidableEq R]
    (delta : R) (β : ℝ) (y : GhostFiniteState R) :
    ghostPhaseMovingEdge true false delta β none (some y) =
      match y with
      | none => β
      | some none => 0
      | some (some r) => if r = delta then 1 else 0 := by
  change ghostPhaseEdge true false 0 (-delta) β none (some (ghostMemoryShift delta y)) = _
  rw [ghost_phase_edge_active_inactive]
  rcases y with _ | (_ | r) <;>
    simp [ghostActiveInput, ghostMemoryShift, sub_eq_zero]

/-- Inactive memory is transported by the frame displacement. -/
theorem ghost_phase_moving_edge_inactive_inactive {R : Type*}
    [AddGroup R] [Fintype R] [DecidableEq R]
    (delta : R) (β : ℝ) (x y : GhostFiniteState R) :
    ghostPhaseMovingEdge false false delta β (some x) (some y) =
      if x = ghostMemoryShift delta y then 1 else 0 := by
  exact ghost_phase_edge_inactive_inactive 0 (-delta) β x (ghostMemoryShift delta y)

theorem ghost_phase_moving_edge_pending {R : Type*}
    [AddGroup R] [Fintype R] [DecidableEq R] (delta r s : R) (β : ℝ) :
    ghostPhaseMovingEdge false false delta β
      (some (some (some r))) (some (some (some s))) =
      if r = s - delta then 1 else 0 := by
  simpa only [ghostMemoryShift_pending, Option.some.injEq] using
    ghost_phase_moving_edge_inactive_inactive delta β (some (some r)) (some (some s))

theorem ghost_phase_moving_edge_store {R : Type*}
    [AddGroup R] [Fintype R] [DecidableEq R] (delta : R) (β : ℝ) :
    ghostPhaseMovingEdge false true delta β (some (some (some (-delta)))) none = 1 := by
  simp only [ghost_phase_moving_edge_inactive_active, if_true]

theorem ghost_phase_moving_edge_promote {R : Type*}
    [AddGroup R] [Fintype R] [DecidableEq R] (delta : R) (β : ℝ) :
    ghostPhaseMovingEdge true false delta β none (some (some (some delta))) = 1 := by
  simp only [ghost_phase_moving_edge_active_inactive, if_true]

/-- Newly stored memory receives target rho only when it arrives at zero. -/
theorem ghost_phase_damped_moving_edge_store {R : Type*}
    [AddGroup R] [Fintype R] [DecidableEq R]
    (delta : R) (β ρTarget ρSource : ℝ) :
    ghostPhaseDampedMovingEdge false true delta β ρTarget ρSource
      (some (some (some (-delta)))) none =
      if delta = 0 then ρTarget else 1 := by
  simp only [ghostPhaseDampedMovingEdge, ghost_phase_moving_edge_store,
    ghostPhaseDiagonal, mul_one, neg_eq_zero]

/-- A promoted particle retains source rho only when its source residue is zero. -/
theorem ghost_phase_damped_moving_edge_promote {R : Type*}
    [AddGroup R] [Fintype R] [DecidableEq R]
    (delta : R) (β ρTarget ρSource : ℝ) :
    ghostPhaseDampedMovingEdge true false delta β ρTarget ρSource
      none (some (some (some delta))) =
      if delta = 0 then ρSource else 1 := by
  simp only [ghostPhaseDampedMovingEdge, ghost_phase_moving_edge_promote,
    ghostPhaseDiagonal, one_mul]

/-- Pending transport carries the two endpoint zero-hit damping factors. -/
theorem ghost_phase_damped_moving_edge_pending {R : Type*}
    [AddGroup R] [Fintype R] [DecidableEq R]
    (delta r s : R) (β ρTarget ρSource : ℝ) :
    ghostPhaseDampedMovingEdge false false delta β ρTarget ρSource
      (some (some (some r))) (some (some (some s))) =
      if r = s - delta then
        (if r = 0 then ρTarget else 1) * (if s = 0 then ρSource else 1)
      else 0 := by
  simp only [ghostPhaseDampedMovingEdge, ghost_phase_moving_edge_pending, ghostPhaseDiagonal]
  by_cases hrs : r = s - delta <;> simp [hrs]
end

section
open Finset
/-- The recursive phase count equals the set-membership active-run count. -/
theorem ghost_phase_run_count_eq_active_run_count {α : Type*} [DecidableEq α]
    (A : ℕ → Finset α) (n : ℕ) (p : α) :
    ghostPhaseRunCount (fun j => decide (p ∈ A j)) n = activeRunCount A n p := by
  induction n with
  | zero => simp [ghostPhaseRunCount, activeRunCount]
  | succ n ih =>
    rw [ghostPhaseRunCount, ih]
    simp only [activeRunCount]
    rw [sum_range_succ]
    simp [mem_sdiff, Nat.add_assoc]

/-- Tagged prime activity and the corresponding group's marks count the
same runs, including the initial visit. -/
theorem physical_phase_run_count {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (L : ℕ → PhysicalMarkLists P J ell) (n : ℕ) (p : PhysicalPrime P) :
    ghostPhaseRunCount (fun j => decide (p ∈ physicalMarkedPrimes (L j))) n =
      activeRunCount (fun j => physicalGroupMarks (L j) p.1) n p.2.val := by
  simp_rw [mem_physical_marked_primes]
  exact ghost_phase_run_count_eq_active_run_count _ n p.2.val

/-- Product over the tagged prime pool equals the original grouped product
of inverse group masses charged once per physical active run. -/
theorem physical_phase_run_weights_grouped {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (L : ℕ → PhysicalMarkLists P J ell) (n : ℕ) :
    (∏ p : PhysicalPrime P, (V p.1)⁻¹ ^
      ghostPhaseRunCount (fun j => decide (p ∈ physicalMarkedPrimes (L j))) n) =
      ∏ g, ∏ p ∈ P g,
        (1 / V g) ^ activeRunCount (fun j => physicalGroupMarks (L j) g) n p := by
  simp_rw [physical_phase_run_count]
  rw [Fintype.prod_sigma]
  apply prod_congr rfl
  intro g _
  simpa only [one_div] using
    (prod_coe_sort (P g)
      (fun p => (V g)⁻¹ ^ activeRunCount (fun j => physicalGroupMarks (L j) g) n p))

/-- Once each edge's number of new marks is known, the product of normalized
phase histories absorbs exactly the initial physical mass and all completion
masses. The residue and birth parameters themselves are unchanged. -/
theorem physical_phase_run_history_eq_of_counts {G : Type*}
    [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    {R : PhysicalPrime P → Type*} [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    (V : G → ℝ) (L : ℕ → PhysicalMarkLists P J ell)
    (C : ℕ → G → Finset (Fin J)) (n : ℕ)
    (h : (p : PhysicalPrime P) → ℕ → R p) (η : PhysicalPrime P → ℕ → ℝ)
    (β : PhysicalPrime P → ℝ)
    (hnew : ∀ j < n, ∀ g,
      (physicalGroupMarks (L (j + 1)) g \ physicalGroupMarks (L j) g).card =
        ell + (C j g).card) :
    (∏ p : PhysicalPrime P,
      ghostPhaseRunHistory (fun j => decide (p ∈ physicalMarkedPrimes (L j)))
        (h p) (η p) (β p) (V p.1) n) =
      (physicalStateMass V J ell *
        (∏ j ∈ range n, physicalCompletionMass V (C j) ell)) *
      ghostPhaseTensorHistory (fun p j => decide (p ∈ physicalMarkedPrimes (L j)))
        h η β n := by
  simp_rw [ghost_phase_run_history_eq]
  rw [prod_mul_distrib, physical_phase_run_weights_grouped,
    ← physical_path_run_normalization_of_counts V L C n hnew,
    ghost_phase_tensor_history_factor]

/-- A supported physical bare path has exactly the phase normalization
given by its initial state mass and its edge completion masses. -/
theorem physical_bare_phase_run_history_eq {G : Type*}
    [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    {R : PhysicalPrime P → Type*} [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    (V : G → ℝ) (L : ℕ → PhysicalMarkLists P J ell)
    (C : ℕ → G → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
    (k : ℕ → ℤ) (σ τ : ℕ → PhysicalPermutations G J ell) (n : ℕ)
    (h : (p : PhysicalPrime P) → ℕ → R p) (η : PhysicalPrime P → ℕ → ℝ)
    (β : PhysicalPrime P → ℝ)
    (hlist : ∀ j < n, physicalListAdmissible (C j) (aux j)
      (physicalPermuteLabels (σ j) (L j)) (physicalPermuteLabels (τ j) (L (j + 1))))
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hcompat : ∀ j < n, ∀ g s t,
      ((physicalPermuteLabels (σ j) (L j)) g s).val =
        ((physicalPermuteLabels (τ j) (L (j + 1))) g t).val →
      (((physicalPermuteLabels (σ j) (L j)) g s).val : ℤ) ∣
        k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j)) (aux j) : ℤ))
    (hk : ∀ j < n, ∀ g s, ¬ (((L j) g s).val : ℤ) ∣ k j) :
    (∏ p : PhysicalPrime P,
      ghostPhaseRunHistory (fun j => decide (p ∈ physicalMarkedPrimes (L j)))
        (h p) (η p) (β p) (V p.1) n) =
      (physicalStateMass V J ell *
        (∏ j ∈ range n, physicalCompletionMass V (C j) ell)) *
      ghostPhaseTensorHistory (fun p j => decide (p ∈ physicalMarkedPrimes (L j)))
        h η β n := by
  simp_rw [ghost_phase_run_history_eq]
  rw [prod_mul_distrib, physical_phase_run_weights_grouped,
    ← physical_bare_path_run_normalization V L C aux k σ τ n hlist hP hdis hcompat hk,
    ghost_phase_tensor_history_factor]
end

section
open Finset
/-- A product of retain-or-move kernels is exactly the sum over all choices
of which coordinates move. The test function need not factor across coordinates,
and the retained and moved values may coincide. -/
theorem finite_binary_kernel_expansion {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] [∀ i, DecidableEq (X i)]
    {R : Type*} [CommSemiring R]
    (x u : (i : I) → X i) (a b : I → R) (F : ((i : I) → X i) → R) :
    (∑ y : (i : I) → X i,
      (∏ i, (a i * (if y i = x i then 1 else 0) +
        b i * (if y i = u i then 1 else 0))) * F y) =
      ∑ c : I → Bool, (∏ i, if c i then b i else a i) *
        F (fun i => if c i then u i else x i) := by
  classical
  have hlocal (i : I) (y : X i) :
      a i * (if y = x i then 1 else 0) + b i * (if y = u i then 1 else 0) =
        ∑ c : Bool, if y = (if c then u i else x i) then (if c then b i else a i)
          else 0 := by
    simp [mul_ite, add_comm]
  have hcollapse (v : (i : I) → X i) (w : I → R) :
      (∑ y : (i : I) → X i, (∏ i, if y i = v i then w i else 0) * F y) =
        (∏ i, w i) * F v := by
    simp_rw [Fintype.prod_ite_zero, ← funext_iff]
    simp
  calc
    _ = ∑ y : (i : I) → X i,
        (∏ i, ∑ c : Bool,
          if y i = (if c then u i else x i) then (if c then b i else a i) else 0) *
          F y := by
      simp_rw [hlocal]
    _ = ∑ y : (i : I) → X i,
        (∑ c : I → Bool, ∏ i,
          if y i = (if c i then u i else x i) then (if c i then b i else a i) else 0) *
          F y := by
      simp_rw [Fintype.prod_sum]
    _ = ∑ c : I → Bool, ∑ y : (i : I) → X i,
        (∏ i, if y i = (if c i then u i else x i) then (if c i then b i else a i)
          else 0) * F y := by
      simp only [sum_mul]
      exact sum_comm
    _ = _ := by
      apply sum_congr rfl
      intro c _
      exact hcollapse (fun i => if c i then u i else x i)
        (fun i => if c i then b i else a i)
end

section
open Finset
def ghostPhaseEndpoint {R : Type*} (h : R) : GhostPhaseState R → GhostPhaseState R
  | some none => some (some (some h))
  | some (some (some _)) => some (some none)
  | z => z

noncomputable def ghostPhaseRetain {R : Type*} [DecidableEq R]
    (a : Bool) (h : R) (η ρ : ℝ) (z : GhostPhaseState R) : ℝ :=
  ghostPhaseDampedVisit a h η 0 ρ z z

noncomputable def ghostPhaseEndpointWeight {R : Type*} [DecidableEq R]
    (a : Bool) (h : R) (η β ρ : ℝ) : GhostPhaseState R → ℝ :=
  if a then fun _ => 0 else fun z => match z with
    | some none => -β * η / ρ
    | some (some (some r)) => if r = h then -η / ρ else 0
    | _ => 0

theorem ghost_phase_visit_two_choices {R : Type*} [DecidableEq R]
    (a : Bool) (h : R) (η β ρ : ℝ) (x y : GhostPhaseState R) :
    ghostPhaseDampedVisit a h η β ρ x y =
      ghostPhaseRetain a h η ρ y * (if x = y then 1 else 0) +
      ghostPhaseEndpointWeight a h η β ρ y *
        (if x = ghostPhaseEndpoint h y then 1 else 0) := by
  cases a <;> rcases x with _ | (_ | (_ | r)) <;>
    rcases y with _ | (_ | (_ | s)) <;>
    simp [ghostPhaseRetain, ghostPhaseDampedVisit, ghostPhaseVisit, ghostFiniteKernel,
      ghostPhaseDiagonal, ghostPhaseEndpointWeight, ghostPhaseEndpoint]
  all_goals split_ifs <;> simp_all

theorem ghost_phase_visit_row_two_choices {R : Type*} [Fintype R] [DecidableEq R]
    (a : Bool) (h : R) (η β ρ : ℝ) (y : GhostPhaseState R)
    (F : GhostPhaseState R → ℝ) :
    (∑ x, ghostPhaseDampedVisit a h η β ρ x y * F x) =
      ghostPhaseRetain a h η ρ y * F y +
      ghostPhaseEndpointWeight a h η β ρ y * F (ghostPhaseEndpoint h y) := by
  simp_rw [ghost_phase_visit_two_choices]
  simp [add_mul, sum_add_distrib, mul_ite]

/-- The full visit row is a sum over independent retain/endpoint choices,
even when the continuation test couples all prime coordinates. -/
theorem ghost_phase_tensor_visit_choices {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (a : I → Bool) (h : (i : I) → R i) (η β ρ : I → ℝ)
    (y : (i : I) → GhostPhaseState (R i))
    (F : ((i : I) → GhostPhaseState (R i)) → ℝ) :
    (∑ x, (∏ i, ghostPhaseDampedVisit (a i) (h i) (η i) (β i) (ρ i)
      (x i) (y i)) * F x) =
      ∑ c : I → Bool,
        (∏ i, if c i then ghostPhaseEndpointWeight (a i) (h i) (η i) (β i) (ρ i) (y i)
          else ghostPhaseRetain (a i) (h i) (η i) (ρ i) (y i)) *
        F (fun i => if c i then ghostPhaseEndpoint (h i) (y i) else y i) := by
  simp_rw [ghost_phase_visit_two_choices]
  exact finite_binary_kernel_expansion y (fun i => ghostPhaseEndpoint (h i) (y i))
    (fun i => ghostPhaseRetain (a i) (h i) (η i) (ρ i) (y i))
    (fun i => ghostPhaseEndpointWeight (a i) (h i) (η i) (β i) (ρ i) (y i)) F

theorem ghost_phase_endpoint_weight_support {R : Type*} [DecidableEq R]
    (a : Bool) (h : R) (η β ρ : ℝ) (y : GhostPhaseState R)
    (hy : ghostPhaseEndpointWeight a h η β ρ y ≠ 0) :
    a = false ∧ (y = some none ∨ y = some (some (some h))) := by
  cases a <;> rcases y with _ | (_ | (_ | r)) <;>
    simp_all [ghostPhaseEndpointWeight]
end

section

theorem finite_weighted_power_le {ι : Type*} [Fintype ι]
    (w l : ι → ℝ) (hw : ∀ i, 0 ≤ w i) (hl : ∀ i, 0 ≤ l i)
    {R : ℕ} (hR : 1 ≤ R) :
    (∑ i, w i * l i) ^ R ≤
      (∑ i, w i) ^ (R - 1) * ∑ i, w i * (l i) ^ R := by
  classical
  obtain ⟨n, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : R ≠ 0)
  let W := ∑ i, w i
  have hW : 0 ≤ W := Finset.sum_nonneg (fun i _ => hw i)
  by_cases hzero : W = 0
  · have hwzero : ∀ i, w i = 0 := by
      intro i
      have hi : w i ≤ W := Finset.single_le_sum (fun j _ => hw j) (Finset.mem_univ i)
      exact le_antisymm (hzero ▸ hi) (hw i)
    simp [hwzero]
  · have hWpos : 0 < W := lt_of_le_of_ne hW (Ne.symm hzero)
    have hj := (convexOn_pow (𝕜 := ℝ) (n + 1)).map_centerMass_le
      (t := Finset.univ) (w := w) (p := l)
      (fun i _ => hw i) hWpos (fun i _ => hl i)
    simp only [Finset.centerMass, smul_eq_mul, Function.comp_apply] at hj
    change (W⁻¹ * ∑ i, w i * l i) ^ (n + 1) ≤
      W⁻¹ * ∑ i, w i * l i ^ (n + 1) at hj
    have hm := mul_le_mul_of_nonneg_left hj (pow_nonneg hW (n + 1))
    have hc : W ^ (n + 1) * W⁻¹ ^ (n + 1) = 1 := by
      rw [← mul_pow, mul_inv_cancel₀ hzero, one_pow]
    rw [mul_pow, ← mul_assoc, hc, one_mul] at hm
    simpa only [Nat.succ_sub_one, pow_succ, mul_assoc, mul_inv_cancel_left₀ hzero, W] using hm
end

section
open scoped BigOperators InnerProductSpace
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
  [FiniteDimensional ℂ E]

theorem spectral_coordinates_pow (T : E →ₗ[ℂ] E) (hT : T.IsSymmetric)
    (R : ℕ) (f : E) (i : Fin (Module.finrank ℂ E)) :
    (hT.eigenvectorBasis rfl).repr ((T ^ R) f) i =
      (hT.eigenvalues rfl i : ℂ) ^ R * (hT.eigenvectorBasis rfl).repr f i := by
  induction R with
  | zero => simp
  | succ R ih =>
    rw [pow_succ', Module.End.mul_apply,
      hT.eigenvectorBasis_apply_self_apply rfl, ih, pow_succ']
    simp only [RCLike.ofReal_eq_complex_ofReal, mul_assoc]

theorem spectral_moment_eq_sum (T : E →ₗ[ℂ] E) (hT : T.IsSymmetric)
    (R : ℕ) (f : E) :
    (inner ℂ f ((T ^ R) f)).re =
      ∑ i, ‖inner ℂ (hT.eigenvectorBasis rfl i) f‖ ^ 2 *
        (hT.eigenvalues rfl i) ^ R := by
  rw [← (hT.eigenvectorBasis rfl).sum_inner_mul_inner f ((T ^ R) f), Complex.re_sum]
  apply Finset.sum_congr rfl
  intro i _
  have hi := spectral_coordinates_pow T hT R f i
  simp only [OrthonormalBasis.repr_apply_apply] at hi
  rw [hi]
  rw [show (inner ℂ f (hT.eigenvectorBasis rfl i)) *
      ((hT.eigenvalues rfl i : ℂ) ^ R * inner ℂ (hT.eigenvectorBasis rfl i) f) =
      (hT.eigenvalues rfl i : ℂ) ^ R *
      (inner ℂ f (hT.eigenvectorBasis rfl i) *
      inner ℂ (hT.eigenvectorBasis rfl i) f) by ring]
  rw [← inner_conj_symm f (hT.eigenvectorBasis rfl i), RCLike.conj_mul]
  simp only [RCLike.ofReal_eq_complex_ofReal, ← Complex.ofReal_pow, ← Complex.ofReal_mul, Complex.ofReal_re]
  ring
end

section
open scoped BigOperators InnerProductSpace
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
  [FiniteDimensional ℂ E]

theorem positive_spectral_moment_power (T : E →ₗ[ℂ] E) (hT : T.IsSymmetric)
    (hpos : ∀ f : E, 0 ≤ (inner ℂ f (T f)).re) (f : E) {R : ℕ} (hR : 1 ≤ R) :
    (inner ℂ f (T f)).re ^ R ≤
      ‖f‖ ^ (2 * (R - 1)) * (inner ℂ f ((T ^ R) f)).re := by
  have hl (i : Fin (Module.finrank ℂ E)) : 0 ≤ hT.eigenvalues rfl i :=
    eigenvalue_nonneg_of_nonneg (hT.hasEigenvalue_eigenvalues rfl i) hpos
  have h := finite_weighted_power_le
    (fun i => ‖inner ℂ (hT.eigenvectorBasis rfl i) f‖ ^ 2)
    (hT.eigenvalues rfl) (fun _ => sq_nonneg _) hl hR
  rw [(hT.eigenvectorBasis rfl).sum_sq_norm_inner_right,
    ← spectral_moment_eq_sum T hT R f, ← pow_mul] at h
  have hfirst := spectral_moment_eq_sum T hT 1 f
  simp only [pow_one] at hfirst
  rwa [← hfirst] at h

theorem positive_spectral_moment_nonneg (T : E →ₗ[ℂ] E) (hT : T.IsSymmetric)
    (hpos : ∀ f : E, 0 ≤ (inner ℂ f (T f)).re) (R : ℕ) (f : E) :
    0 ≤ (inner ℂ f ((T ^ R) f)).re := by
  rw [spectral_moment_eq_sum T hT R f]
  apply Finset.sum_nonneg
  intro i _
  apply mul_nonneg (sq_nonneg _)
  exact pow_nonneg
    (eigenvalue_nonneg_of_nonneg (hT.hasEigenvalue_eigenvalues rfl i) hpos) R

theorem finite_pairing_moment_power (A : E →ₗ[ℂ] E) (f g : E) {R : ℕ} (hR : 1 ≤ R) :
    ‖inner ℂ f (A g)‖ ^ (2 * R) ≤
      ‖g‖ ^ (2 * R) * ‖f‖ ^ (2 * (R - 1)) *
        (inner ℂ f (((A * A.adjoint) ^ R) f)).re := by
  have hsym : (A * A.adjoint).IsSymmetric :=
    LinearMap.isSymmetric_self_comp_adjoint A
  have hpos (v : E) : 0 ≤ (inner ℂ v ((A * A.adjoint) v)).re := by
    rw [Module.End.mul_apply, ← LinearMap.adjoint_inner_left]
    exact inner_self_nonneg (𝕜 := ℂ) (x := A.adjoint v)
  have hmoment := positive_spectral_moment_power (A * A.adjoint) hsym hpos f hR
  have hinner : (inner ℂ f ((A * A.adjoint) f)).re = ‖A.adjoint f‖ ^ 2 := by
    rw [Module.End.mul_apply, ← LinearMap.adjoint_inner_left, inner_self_eq_norm_sq_to_K]
    norm_cast
  rw [hinner, ← pow_mul] at hmoment
  have hcs : ‖inner ℂ f (A g)‖ ≤ ‖A.adjoint f‖ * ‖g‖ := by
    rw [← LinearMap.adjoint_inner_left]
    exact norm_inner_le_norm _ _
  calc
    ‖inner ℂ f (A g)‖ ^ (2 * R) ≤ (‖A.adjoint f‖ * ‖g‖) ^ (2 * R) :=
      pow_le_pow_left₀ (norm_nonneg _) hcs _
    _ = ‖g‖ ^ (2 * R) * ‖A.adjoint f‖ ^ (2 * R) := by rw [mul_pow, mul_comm]
    _ ≤ ‖g‖ ^ (2 * R) *
        (‖f‖ ^ (2 * (R - 1)) * (inner ℂ f (((A * A.adjoint) ^ R) f)).re) :=
      mul_le_mul_of_nonneg_left hmoment (pow_nonneg (norm_nonneg _) _)
    _ = _ := by ring

theorem finite_pairing_moment (A : E →ₗ[ℂ] E) (f g : E) {R : ℕ} (hR : 1 ≤ R) :
    ‖inner ℂ f (A g)‖ ≤
      ‖g‖ * ‖f‖ ^ (1 - 1 / (R : ℝ)) *
        (inner ℂ f (((A * A.adjoint) ^ R) f)).re ^ (1 / (2 * (R : ℝ))) := by
  have hN : 2 * R ≠ 0 := by omega
  have hRzero : (R : ℝ) ≠ 0 := by exact_mod_cast (by omega : R ≠ 0)
  have hpos (v : E) : 0 ≤ (inner ℂ v ((A * A.adjoint) v)).re := by
    rw [Module.End.mul_apply, ← LinearMap.adjoint_inner_left]
    exact inner_self_nonneg (𝕜 := ℂ) (x := A.adjoint v)
  have hmpos := positive_spectral_moment_nonneg (A * A.adjoint)
    (LinearMap.isSymmetric_self_comp_adjoint A) hpos R f
  have h := Real.rpow_le_rpow (pow_nonneg (norm_nonneg (inner ℂ f (A g))) (2 * R))
    (finite_pairing_moment_power A f g hR)
    (show 0 ≤ (((2 * R : ℕ) : ℝ)⁻¹) by positivity)
  rw [Real.pow_rpow_inv_natCast (norm_nonneg _) hN,
    Real.mul_rpow (mul_nonneg (pow_nonneg (norm_nonneg _) _)
      (pow_nonneg (norm_nonneg _) _)) hmpos,
    Real.mul_rpow (pow_nonneg (norm_nonneg _) _) (pow_nonneg (norm_nonneg _) _),
    Real.pow_rpow_inv_natCast (norm_nonneg _) hN] at h
  have hexp : ((2 * (R - 1) : ℕ) : ℝ) * (((2 * R : ℕ) : ℝ)⁻¹) =
      1 - 1 / (R : ℝ) := by
    rw [Nat.cast_mul, Nat.cast_mul, Nat.cast_sub hR]
    push_cast
    field_simp
  have hf : (‖f‖ ^ (2 * (R - 1))) ^ (((2 * R : ℕ) : ℝ)⁻¹) =
      ‖f‖ ^ (1 - 1 / (R : ℝ)) := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _), hexp]
  rw [hf] at h
  simpa only [Nat.cast_mul, Nat.cast_ofNat, one_div] using h
end

section
open Finset
/-- The completely multiplicative real power of a natural number. -/
noncomputable def natRealRpowHom (s : ℝ) : ℕ →* ℝ where
  toFun n := (n : ℝ) ^ s
  map_one' := by simp
  map_mul' m n := by
    simp only [Nat.cast_mul]
    exact Real.mul_rpow (Nat.cast_nonneg m) (Nat.cast_nonneg n)

/-- A finite set of permitted primes gives a convergent Euler product for every positive exponent. -/
theorem smooth_rpow_summable_and_sum (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) {s : ℝ} (hs : 0 < s) :
    Summable (fun n : Nat.factoredNumbers P => (n.val : ℝ) ^ (-s)) ∧
      (∑' n : Nat.factoredNumbers P, (n.val : ℝ) ^ (-s)) =
        ∏ p ∈ P, (1 - (p : ℝ) ^ (-s))⁻¹ := by
  have hp : ∀ {p : ℕ}, p.Prime → ‖natRealRpowHom (-s) p‖ < 1 := by
    intro p hp
    change ‖(p : ℝ) ^ (-s)‖ < 1
    rw [Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg (Nat.cast_nonneg p) _)]
    exact Real.rpow_lt_one_of_one_lt_of_neg (by exact_mod_cast hp.one_lt) (by linarith)
  obtain ⟨hsum, hval⟩ :=
    EulerProduct.summable_and_hasSum_factoredNumbers_prod_filter_prime_geometric hp P
  have heq : P.filter Nat.Prime = P := filter_eq_self.mpr hP
  constructor
  · simpa only [natRealRpowHom, MonoidHom.coe_mk, OneHom.coe_mk, Real.norm_eq_abs,
      abs_of_nonneg (Real.rpow_nonneg (Nat.cast_nonneg _) _)] using hsum
  · simpa only [natRealRpowHom, MonoidHom.coe_mk, OneHom.coe_mk, heq] using hval.tsum_eq

/-- Rewrite the geometric factor in a form suited to an exponential product estimate. -/
theorem smooth_geometric_factor {p s : ℝ} (hp : 1 < p) (hs : 0 < s) :
    (1 - p ^ (-s))⁻¹ = 1 + 1 / (p ^ s - 1) := by
  have hps : 1 < p ^ s := Real.one_lt_rpow hp hs
  rw [Real.rpow_neg (by linarith)]
  have h0 : p ^ s ≠ 0 := ne_of_gt (by linarith)
  have h1 : p ^ s - 1 ≠ 0 := ne_of_gt (by linarith)
  field_simp [h0, h1]
  ring

/-- Local geometric-factor bounds control the entire finite-prime Euler product. -/
theorem smooth_rpow_sum_le_exp (P : Finset ℕ) (hP : ∀ p ∈ P, p.Prime)
    {s K : ℝ} (hs : 0 < s)
    (hlocal : ∀ p ∈ P, 1 / ((p : ℝ) ^ s - 1) ≤ K / (p : ℝ)) :
    (∑' n : Nat.factoredNumbers P, (n.val : ℝ) ^ (-s)) ≤
      Real.exp (K * ∑ p ∈ P, 1 / (p : ℝ)) := by
  rw [(smooth_rpow_summable_and_sum P hP hs).2]
  have hnonneg (p : ℕ) (hp : p ∈ P) : 0 ≤ (1 - (p : ℝ) ^ (-s))⁻¹ := by
    rw [smooth_geometric_factor (by exact_mod_cast (hP p hp).one_lt) hs]
    have := Real.one_lt_rpow (by exact_mod_cast (hP p hp).one_lt : (1:ℝ) < p) hs
    positivity
  calc
    (∏ p ∈ P, (1 - (p : ℝ) ^ (-s))⁻¹) ≤ ∏ p ∈ P, Real.exp (K / (p : ℝ)) := by
      apply prod_le_prod₀ hnonneg
      intro p hp
      rw [smooth_geometric_factor (by exact_mod_cast (hP p hp).one_lt) hs]
      have h1 := hlocal p hp
      have h2 := Real.add_one_le_exp (K / (p : ℝ))
      linarith
    _ = Real.exp (K * ∑ p ∈ P, 1 / (p : ℝ)) := by
      rw [← Real.exp_sum]
      congr 1
      simp only [mul_sum, mul_one_div]

/-- The positive-exponent Markov inequality for an individual weighted term. -/
theorem weighted_reciprocal_le_tilt {n X theta w M : ℝ}
    (hX : 0 < X) (hn : X ≤ n) (htheta : 0 ≤ theta)
    (hw : 0 ≤ w) (hwM : w ≤ M) :
    w / n ≤ (M * X ^ (-theta)) * n ^ (-(1 - theta)) := by
  have hn0 : 0 < n := hX.trans_le hn
  have hM : 0 ≤ M := hw.trans hwM
  have hpow : n ^ (-theta) ≤ X ^ (-theta) :=
    Real.rpow_le_rpow_of_nonpos hX hn (by linarith)
  have hid : n ^ (-theta) * n ^ (-(1-theta)) = n⁻¹ := by
    rw [← Real.rpow_add hn0]
    have he : -theta + -(1-theta) = (-1 : ℝ) := by ring
    rw [he, Real.rpow_neg_one]
  calc
    w / n ≤ M / n := div_le_div_of_nonneg_right hwM hn0.le
    _ = (M * n ^ (-theta)) * n ^ (-(1-theta)) := by rw [mul_assoc, hid, div_eq_mul_inv]
    _ ≤ (M * X ^ (-theta)) * n ^ (-(1-theta)) := by gcongr

/-- A cutoff term, indexed by the positive integers with prime factors in `P`. -/
noncomputable def weightedSmoothTailTerm (P : Finset ℕ) (W : ℕ → ℝ) (X : ℝ)
    (n : Nat.factoredNumbers P) : ℝ :=
  if X ≤ (n.val : ℝ) then W n.val / (n.val : ℝ) else 0

/-- Bounded nonnegative weights preserve convergence of the tilted smooth tail. -/
theorem weighted_smooth_tail_summable (P : Finset ℕ) (hP : ∀ p ∈ P, p.Prime)
    (W : ℕ → ℝ) {M X theta : ℝ} (hM : 0 ≤ M) (hX : 0 < X)
    (htheta0 : 0 ≤ theta) (htheta1 : theta < 1)
    (hw0 : ∀ n ∈ Nat.factoredNumbers P, 0 ≤ W n)
    (hwM : ∀ n ∈ Nat.factoredNumbers P, W n ≤ M) :
    Summable (weightedSmoothTailTerm P W X) := by
  apply Summable.of_nonneg_of_le (f := fun n : Nat.factoredNumbers P =>
    (M * X ^ (-theta)) * (n.val : ℝ) ^ (-(1-theta)))
  · intro n
    unfold weightedSmoothTailTerm
    have hw := hw0 n.val n.property
    split_ifs <;> positivity
  · intro n
    unfold weightedSmoothTailTerm
    split_ifs with hn
    · exact weighted_reciprocal_le_tilt hX hn htheta0 (hw0 n.val n.property) (hwM n.val n.property)
    · positivity
  · exact (smooth_rpow_summable_and_sum P hP (by linarith : 0 < 1-theta)).1.mul_left _

/-- The weighted smooth tail is exponentially controlled by its local prime factors. -/
theorem weighted_smooth_tail_le (P : Finset ℕ) (hP : ∀ p ∈ P, p.Prime)
    (W : ℕ → ℝ) {M X theta K : ℝ} (hM : 0 ≤ M) (hX : 0 < X)
    (htheta0 : 0 ≤ theta) (htheta1 : theta < 1)
    (hw0 : ∀ n ∈ Nat.factoredNumbers P, 0 ≤ W n)
    (hwM : ∀ n ∈ Nat.factoredNumbers P, W n ≤ M)
    (hlocal : ∀ p ∈ P, 1 / ((p : ℝ) ^ (1-theta) - 1) ≤ K / (p : ℝ)) :
    (∑' n : Nat.factoredNumbers P, weightedSmoothTailTerm P W X n) ≤
      (M * X ^ (-theta)) * Real.exp (K * ∑ p ∈ P, 1 / (p : ℝ)) := by
  have hsum := weighted_smooth_tail_summable P hP W hM hX htheta0 htheta1 hw0 hwM
  calc
    (∑' n : Nat.factoredNumbers P, weightedSmoothTailTerm P W X n) ≤
        ∑' n : Nat.factoredNumbers P, (M * X ^ (-theta)) * (n.val : ℝ) ^ (-(1-theta)) := by
      apply hsum.tsum_le_tsum
      · intro n
        unfold weightedSmoothTailTerm
        split_ifs with hn
        · exact weighted_reciprocal_le_tilt hX hn htheta0 (hw0 n.val n.property) (hwM n.val n.property)
        · positivity
      · exact (smooth_rpow_summable_and_sum P hP (by linarith : 0 < 1-theta)).1.mul_left _
    _ = (M * X ^ (-theta)) * (∑' n : Nat.factoredNumbers P, (n.val : ℝ) ^ (-(1-theta))) := tsum_mul_left
    _ ≤ (M * X ^ (-theta)) * Real.exp (K * ∑ p ∈ P, 1 / (p : ℝ)) := by
      exact mul_le_mul_of_nonneg_left (smooth_rpow_sum_le_exp P hP (by linarith) hlocal) (by positivity)

/-- A finite-subset version needs bounds on the weights only inside the selected tail. -/
theorem sum_weighted_smooth_tail_le (P S : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) (W : ℕ → ℝ) {M X theta K : ℝ}
    (hM : 0 ≤ M) (hX : 0 < X) (htheta0 : 0 ≤ theta) (htheta1 : theta < 1)
    (hS : ∀ n ∈ S, n ∈ Nat.factoredNumbers P)
    (hcutoff : ∀ n ∈ S, X ≤ (n : ℝ))
    (hw0 : ∀ n ∈ S, 0 ≤ W n) (hwM : ∀ n ∈ S, W n ≤ M)
    (hlocal : ∀ p ∈ P, 1 / ((p : ℝ) ^ (1-theta) - 1) ≤ K / (p : ℝ)) :
    (∑ n ∈ S, W n / (n : ℝ)) ≤
      (M * X ^ (-theta)) * Real.exp (K * ∑ p ∈ P, 1 / (p : ℝ)) := by
  classical
  have hfinite : (∑ n ∈ S, (n : ℝ) ^ (-(1-theta))) ≤
      ∑' n : Nat.factoredNumbers P, (n.val : ℝ) ^ (-(1-theta)) := by
    rw [← sum_subtype_of_mem (fun n : ℕ => (n : ℝ) ^ (-(1-theta))) hS]
    apply (smooth_rpow_summable_and_sum P hP (by linarith : 0 < 1-theta)).1.sum_le_tsum
    intro n hn
    exact Real.rpow_nonneg (Nat.cast_nonneg _) _
  calc
    (∑ n ∈ S, W n / (n : ℝ)) ≤
        ∑ n ∈ S, (M * X ^ (-theta)) * (n : ℝ) ^ (-(1-theta)) := by
      exact sum_le_sum (fun n hn => weighted_reciprocal_le_tilt hX (hcutoff n hn)
        htheta0 (hw0 n hn) (hwM n hn))
    _ = (M * X ^ (-theta)) * ∑ n ∈ S, (n : ℝ) ^ (-(1-theta)) := (mul_sum ..).symm
    _ ≤ (M * X ^ (-theta)) * (∑' n : Nat.factoredNumbers P, (n.val : ℝ) ^ (-(1-theta))) :=
      mul_le_mul_of_nonneg_left hfinite (by positivity)
    _ ≤ (M * X ^ (-theta)) * Real.exp (K * ∑ p ∈ P, 1 / (p : ℝ)) :=
      mul_le_mul_of_nonneg_left (smooth_rpow_sum_le_exp P hP (by linarith) hlocal) (by positivity)

/-- Exponential cutoffs display the gain from tilting directly in the exponent. -/
theorem weighted_smooth_tail_le_exp_cutoff (P : Finset ℕ) (hP : ∀ p ∈ P, p.Prime)
    (W : ℕ → ℝ) {M x theta K : ℝ} (hM : 0 ≤ M)
    (htheta0 : 0 ≤ theta) (htheta1 : theta < 1)
    (hw0 : ∀ n ∈ Nat.factoredNumbers P, 0 ≤ W n)
    (hwM : ∀ n ∈ Nat.factoredNumbers P, W n ≤ M)
    (hlocal : ∀ p ∈ P, 1 / ((p : ℝ) ^ (1-theta) - 1) ≤ K / (p : ℝ)) :
    (∑' n : Nat.factoredNumbers P, weightedSmoothTailTerm P W (Real.exp x) n) ≤
      M * Real.exp (K * (∑ p ∈ P, 1 / (p : ℝ)) - theta * x) := by
  convert weighted_smooth_tail_le P hP W hM (Real.exp_pos x) htheta0 htheta1 hw0 hwM hlocal using 1
  rw [← Real.exp_mul, mul_assoc, ← Real.exp_add]
  congr 2
  ring
end

section
open Filter
open scoped Topology
theorem prime_tilt_geometric_factor_bound {p theta A : ℝ}
    (hp : 0 < p) (hlog : theta * Real.log p ≤ A) (hlarge : 2 * Real.exp A ≤ p) :
    0 ≤ 1 / (p^(1 - theta) - 1) ∧
      1 / (p^(1 - theta) - 1) ≤ 2 * Real.exp A / p := by
  have htpos : 0 < p^theta := Real.rpow_pos_of_pos hp theta
  have hrpos : 0 < p^(1 - theta) := Real.rpow_pos_of_pos hp (1 - theta)
  have htbound : p^theta ≤ Real.exp A := by
    rw [Real.rpow_def_of_pos hp]
    exact Real.exp_le_exp.mpr (by simpa only [mul_comm] using hlog)
  have hprod : p^(1 - theta) * p^theta = p := by
    rw [Real.rpow_sub hp, Real.rpow_one, div_mul_cancel₀ _ htpos.ne']
  have hpbound : p ≤ Real.exp A * p^(1 - theta) := by
    nlinarith [mul_le_mul_of_nonneg_left htbound hrpos.le]
  have hexp : 0 < Real.exp A := Real.exp_pos A
  have hr : 2 ≤ p^(1 - theta) := by nlinarith
  have hden : 0 < p^(1 - theta) - 1 := by linarith
  refine ⟨by positivity, ?_⟩
  apply (div_le_div_iff₀ hden hp).mpr
  nlinarith

/-- A tilt of size `sigma / L^d` is uniformly controlled throughout an
exponential window whose lower logarithmic endpoint tends to infinity. -/
theorem eventually_prime_tilt_factor_bounds {c d sigma : ℝ}
    (hc : 0 < c) (hd : 0 < d) (hsigma : 0 < sigma) :
    ∀ᶠ L : ℝ in atTop, 0 < L ∧ 0 < sigma / L^d ∧ sigma / L^d < 1 ∧
      ∀ p : ℝ, Real.exp (L^c) ≤ p → p ≤ Real.exp (L^d) →
        0 ≤ 1 / (p^(1 - sigma / L^d) - 1) ∧
          1 / (p^(1 - sigma / L^d) - 1) ≤ 2 * Real.exp sigma / p := by
  have hlower : Tendsto (fun L : ℝ => Real.exp (L^c)) atTop atTop :=
    Real.tendsto_exp_atTop.comp (tendsto_rpow_atTop hc)
  filter_upwards [eventually_gt_atTop (0 : ℝ),
    (tendsto_rpow_atTop hd).eventually (eventually_gt_atTop sigma),
    hlower.eventually (eventually_ge_atTop (2 * Real.exp sigma))] with L hL hpow hlarge
  have hpow0 : 0 < L^d := Real.rpow_pos_of_pos hL d
  have htheta : 0 < sigma / L^d := div_pos hsigma hpow0
  refine ⟨hL, htheta, (div_lt_one hpow0).mpr hpow, ?_⟩
  intro p hlo hhi
  have hp : 0 < p := (Real.exp_pos _).trans_le hlo
  have hlogp : Real.log p ≤ L^d := by
    simpa only [Real.log_exp] using Real.log_le_log hp hhi
  have hlog : sigma / L^d * Real.log p ≤ sigma := by
    calc
      _ ≤ sigma / L^d * L^d := mul_le_mul_of_nonneg_left hlogp htheta.le
      _ = sigma := div_mul_cancel₀ _ hpow0.ne'
  exact prime_tilt_geometric_factor_bound hp hlog (hlarge.trans hlo)
end

section
open Finset
noncomputable def markedDivisorFactor (q V : ℝ) (omega t : ℕ) : ℝ :=
  ((omega.descFactorial t : ℝ) * q^(omega - t)) / V^t

noncomputable def markedDivisorWeight {G : Type*} (groups : Finset G)
    (P : G → Finset ℕ) (q : ℝ) (V : G → ℝ) (t : G → ℕ) (n : ℤ) : ℝ :=
  ∏ g ∈ groups, markedDivisorFactor q (V g) (physicalOmega P g n) (t g)

/-- W_ell is the special case with ell ordered marks in every group. -/
noncomputable def uniformMarkedDivisorWeight {G : Type*} (groups : Finset G)
    (P : G → Finset ℕ) (q : ℝ) (V : G → ℝ) (ell : ℕ) (n : ℤ) : ℝ :=
  markedDivisorWeight groups P q V (fun _ => ell) n

noncomputable def markedDivisorBound (q v : ℝ) (T : ℕ) : ℝ :=
  max 1 (((T.factorial : ℝ) * (max 1 (1 / v))^T) / (1 - q)^(T + 1))

theorem one_le_markedDivisorBound (q v : ℝ) (T : ℕ) :
    1 ≤ markedDivisorBound q v T := le_max_left _ _

theorem marked_divisor_factor_zero_of_lt (q V : ℝ) {omega t : ℕ} (h : omega < t) :
    markedDivisorFactor q V omega t = 0 := by
  simp only [markedDivisorFactor, Nat.descFactorial_of_lt h, Nat.cast_zero, zero_mul, zero_div]

theorem marked_divisor_factor_nonneg {q V : ℝ} (hq : 0 ≤ q) (hV : 0 ≤ V)
    (omega t : ℕ) : 0 ≤ markedDivisorFactor q V omega t := by
  unfold markedDivisorFactor
  positivity

theorem marked_divisor_factor_le_bound {q v V : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (hV : v ≤ V)
    (T omega t : ℕ) (ht : t ≤ T) :
    markedDivisorFactor q V omega t ≤ markedDivisorBound q v T := by
  by_cases hto : t ≤ omega
  · have he := uniform_damped_descFactorial_bound hq0 hq1 hv hV T (omega - t) t ht
    have hsum : omega - t + t = omega := Nat.sub_add_cancel hto
    rw [hsum] at he
    exact he.trans (le_max_right _ _)
  · rw [marked_divisor_factor_zero_of_lt q V (Nat.lt_of_not_ge hto)]
    exact zero_le_one.trans (one_le_markedDivisorBound q v T)

theorem marked_divisor_weight_nonneg {G : Type*} (groups : Finset G)
    (P : G → Finset ℕ) {q : ℝ} (hq : 0 ≤ q) (V : G → ℝ) (t : G → ℕ)
    (hV : ∀ g ∈ groups, 0 ≤ V g) (n : ℤ) :
    0 ≤ markedDivisorWeight groups P q V t n := by
  exact prod_nonneg (fun g hg => marked_divisor_factor_nonneg hq (hV g hg) _ _)

theorem marked_divisor_weight_zero_of_lt {G : Type*} (groups : Finset G)
    (P : G → Finset ℕ) (q : ℝ) (V : G → ℝ) (t : G → ℕ) (n : ℤ)
    {g : G} (hg : g ∈ groups) (hgt : physicalOmega P g n < t g) :
    markedDivisorWeight groups P q V t n = 0 := by
  exact prod_eq_zero hg (marked_divisor_factor_zero_of_lt q (V g) hgt)

/-- This is exactly the manuscript's global-exponent formula, interpreted
with zero weight whenever a group has no admissible ordered mark list. -/
theorem marked_divisor_weight_global_formula {G : Type*} (groups : Finset G)
    (P : G → Finset ℕ) (q : ℝ) (V : G → ℝ) (t : G → ℕ) (n : ℤ) :
    markedDivisorWeight groups P q V t n =
      q^((∑ g ∈ groups, physicalOmega P g n) - ∑ g ∈ groups, t g) *
        ∏ g ∈ groups, ((physicalOmega P g n).descFactorial (t g) : ℝ) / (V g)^(t g) := by
  classical
  by_cases ht : ∀ g ∈ groups, t g ≤ physicalOmega P g n
  · have he : ∀ g,
        markedDivisorFactor q (V g) (physicalOmega P g n) (t g) =
          q^(physicalOmega P g n - t g) *
            (((physicalOmega P g n).descFactorial (t g) : ℝ) / (V g)^(t g)) := by
      intro g
      unfold markedDivisorFactor
      ring
    simp only [markedDivisorWeight, he, prod_mul_distrib, prod_pow_eq_pow_sum,
      sum_tsub_distrib groups ht]
  · push Not at ht
    obtain ⟨g, hg, hgt⟩ := ht
    rw [marked_divisor_weight_zero_of_lt groups P q V t n hg hgt]
    have hz : (∏ g ∈ groups,
        ((physicalOmega P g n).descFactorial (t g) : ℝ) / (V g)^(t g)) = 0 := by
      apply prod_eq_zero hg
      simp only [Nat.descFactorial_of_lt hgt, Nat.cast_zero, zero_div]
    rw [hz, mul_zero]

/-- The uniform bound is independent of n, the prime groups, and the
mark counts, once every mark count is at most T and every mass is at least v. -/
theorem marked_divisor_weight_le_pow {G : Type*} (groups : Finset G)
    (P : G → Finset ℕ) {q v : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v)
    (V : G → ℝ) (t : G → ℕ) (T : ℕ)
    (hV : ∀ g ∈ groups, v ≤ V g) (ht : ∀ g ∈ groups, t g ≤ T) (n : ℤ) :
    markedDivisorWeight groups P q V t n ≤ (markedDivisorBound q v T)^groups.card := by
  calc
    _ ≤ ∏ _g ∈ groups, markedDivisorBound q v T := by
      exact prod_le_prod₀
        (fun g hg => marked_divisor_factor_nonneg hq0 (hv.le.trans (hV g hg)) _ _)
        (fun g hg => marked_divisor_factor_le_bound hq0 hq1 hv (hV g hg) T _ _ (ht g hg))
    _ = _ := by simp

/-- Logarithmically many groups give the polynomial supremum bound
claimed for the unweighted W_t in Section 04. -/
theorem marked_divisor_weight_le_rpow {G : Type*} (groups : Finset G)
    (P : G → Finset ℕ) {q v L K : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v)
    (hL : 0 < L) (V : G → ℝ) (t : G → ℕ) (T : ℕ)
    (hV : ∀ g ∈ groups, v ≤ V g) (ht : ∀ g ∈ groups, t g ≤ T)
    (hcard : (groups.card : ℝ) ≤ K * Real.log L) (n : ℤ) :
    markedDivisorWeight groups P q V t n ≤ L^(K * Real.log (markedDivisorBound q v T)) := by
  exact group_product_bound_of_log_card groups
    (fun g => markedDivisorFactor q (V g) (physicalOmega P g n) (t g))
    (one_le_markedDivisorBound q v T) hL
    (fun g hg => marked_divisor_factor_nonneg hq0 (hv.le.trans (hV g hg)) _ _)
    (fun g hg => marked_divisor_factor_le_bound hq0 hq1 hv (hV g hg) T _ _ (ht g hg)) hcard
end

section
open Filter
theorem exponential_cutoff_tilt_identity {L : ℝ} (hL : 0 < L) (κ σ d : ℝ) :
    (Real.exp (κ * L)) ^ (-(σ / L^d)) = Real.exp (-(κ * σ) * L^(1-d)) := by
  rw [← Real.exp_mul, Real.rpow_sub hL, Real.rpow_one]
  congr 1
  ring

theorem tilted_tail_bound_to_power {L M S T K H D κ σ d : ℝ}
    (hL : 0 < L) (hK : 0 ≤ K)
    (hML : M ≤ L^D) (hS : S ≤ H * Real.log L)
    (hT : T ≤ M * (Real.exp (κ * L)) ^ (-(σ / L^d)) * Real.exp (K * S)) :
    T ≤ Real.exp (-(κ * σ) * L^(1-d)) * L^(D + K * H) := by
  rw [exponential_cutoff_tilt_identity hL] at hT
  have hm : Real.exp (K * S) ≤ L^(K * H) := by
    rw [Real.rpow_def_of_pos hL]
    apply Real.exp_le_exp.mpr
    nlinarith [mul_le_mul_of_nonneg_left hS hK]
  apply hT.trans
  calc
    M * Real.exp (-(κ * σ) * L^(1-d)) * Real.exp (K * S) ≤
        L^D * Real.exp (-(κ * σ) * L^(1-d)) * L^(K * H) := by
      exact mul_le_mul (mul_le_mul_of_nonneg_right hML (Real.exp_pos _).le)
        hm (Real.exp_pos _).le (mul_nonneg (Real.rpow_pos_of_pos hL D).le (Real.exp_pos _).le)
    _ = Real.exp (-(κ * σ) * L^(1-d)) * L^(D + K * H) := by
      rw [Real.rpow_add hL]
      ring

theorem eventually_exp_neg_rpow_mul_rpow_le {b c : ℝ}
    (hb : 0 < b) (hc : 0 < c) (D A : ℝ) :
    ∀ᶠ L : ℝ in atTop, Real.exp (-c * L^b) * L^D ≤ L^(-A) := by
  filter_upwards [eventually_mul_rpow_log_add_le_rpow (a := 0) hb hb hc (D + A) 0,
    eventually_gt_atTop (0 : ℝ)] with L h hL
  simp only [Real.rpow_zero, mul_one, add_zero] at h
  rw [Real.rpow_def_of_pos hL D, Real.rpow_def_of_pos hL (-A), ← Real.exp_add]
  apply Real.exp_le_exp.mpr
  nlinarith

theorem eventually_weighted_smooth_tail_bound {c d σ : ℝ}
    (hc : 0 < c) (hd : 0 < d) (hσ : 0 < σ) (κ H D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (P : Finset ℕ) (W : ℕ → ℝ),
      (∀ p ∈ P, p.Prime) →
      (∀ p ∈ P, Real.exp (L^c) ≤ (p : ℝ)) →
      (∀ p ∈ P, (p : ℝ) ≤ Real.exp (L^d)) →
      (∑ p ∈ P, 1 / (p : ℝ)) ≤ H * Real.log L →
      (∀ n ∈ Nat.factoredNumbers P, 0 ≤ W n) →
      (∀ n ∈ Nat.factoredNumbers P, W n ≤ L^D) →
      (∑' n : Nat.factoredNumbers P, weightedSmoothTailTerm P W (Real.exp (κ * L)) n) ≤
        Real.exp (-(κ * σ) * L^(1-d)) * L^(D + 2 * Real.exp σ * H) := by
  filter_upwards [eventually_prime_tilt_factor_bounds hc hd hσ] with L hL
  intro P W hP hmin hmax hmass hw0 hwM
  have hlocal : ∀ p ∈ P, 1 / ((p : ℝ)^(1 - σ / L^d) - 1) ≤
      (2 * Real.exp σ) / (p : ℝ) := by
    intro p hp
    exact (hL.2.2.2 (p : ℝ) (hmin p hp) (hmax p hp)).2
  have htail := weighted_smooth_tail_le P hP W
    (Real.rpow_pos_of_pos hL.1 D).le (Real.exp_pos (κ * L)) hL.2.1.le hL.2.2.1 hw0 hwM hlocal
  exact tilted_tail_bound_to_power hL.1 (by positivity) le_rfl hmass htail

theorem eventually_weighted_smooth_tail_power_saving {c d σ κ : ℝ}
    (hc : 0 < c) (hd : 0 < d) (hd1 : d < 1) (hσ : 0 < σ) (hκ : 0 < κ)
    (H D A : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (P : Finset ℕ) (W : ℕ → ℝ),
      (∀ p ∈ P, p.Prime) →
      (∀ p ∈ P, Real.exp (L^c) ≤ (p : ℝ)) →
      (∀ p ∈ P, (p : ℝ) ≤ Real.exp (L^d)) →
      (∑ p ∈ P, 1 / (p : ℝ)) ≤ H * Real.log L →
      (∀ n ∈ Nat.factoredNumbers P, 0 ≤ W n) →
      (∀ n ∈ Nat.factoredNumbers P, W n ≤ L^D) →
      (∑' n : Nat.factoredNumbers P, weightedSmoothTailTerm P W (Real.exp (κ * L)) n) ≤ L^(-A) := by
  filter_upwards [eventually_weighted_smooth_tail_bound hc hd hσ κ H D,
    eventually_exp_neg_rpow_mul_rpow_le (sub_pos.mpr hd1) (mul_pos hκ hσ)
      (D + 2 * Real.exp σ * H) A] with L htail hbound
  intro P W hP hmin hmax hmass hw0 hwM
  exact (htail P W hP hmin hmax hmass hw0 hwM).trans hbound

theorem eventually_exp_neg_rpow_mul_rpow_mul_exp_sqrt_le {b c K : ℝ}
    (hb : (1/2 : ℝ) < b) (hc : 0 < c) (hK : 0 ≤ K) (D A : ℝ) :
    ∀ᶠ L : ℝ in atTop,
      (Real.exp (-c * L^b) * L^D) * Real.exp (K * Real.sqrt L) ≤ L^(-A) := by
  have hb0 : 0 < b := lt_trans (by norm_num) hb
  have hc2 : 0 < c / 2 := by positivity
  filter_upwards [eventually_mul_rpow_log_add_le_rpow (a := 0) hb0 hb0 hc2 (D + A) 0,
    eventually_mul_rpow_log_add_le_rpow hb0 hb hc2 K 0,
    Real.tendsto_log_atTop.eventually (eventually_ge_atTop (1 : ℝ)),
    eventually_gt_atTop (0 : ℝ)] with L hpoly hsqrt hlog hL
  simp only [Real.rpow_zero, mul_one, add_zero] at hpoly
  simp only [add_zero] at hsqrt
  have hKsqrt : K * Real.sqrt L ≤ K * L^(1/2 : ℝ) * Real.log L := by
    rw [Real.sqrt_eq_rpow]
    exact le_mul_of_one_le_right (mul_nonneg hK (Real.rpow_nonneg hL.le _)) hlog
  rw [Real.rpow_def_of_pos hL D, Real.rpow_def_of_pos hL (-A),
    ← Real.exp_add, ← Real.exp_add]
  apply Real.exp_le_exp.mpr
  nlinarith
end

section
open Filter Finset
noncomputable def markedSmoothTail {G : Type*} [DecidableEq G]
    (groups : Finset G) (P : G → Finset ℕ) (q : ℝ) (mass : G → ℝ)
    (t : G → ℕ) (X : ℝ) : ℝ :=
  ∑' n : Nat.factoredNumbers (groups.biUnion P),
    weightedSmoothTailTerm (groups.biUnion P)
      (fun m : ℕ => markedDivisorWeight groups P q mass t (m : ℤ)) X n

/-- A logarithmic group count and bounded group harmonic mass bound the
harmonic mass of the full smooth-prime pool. -/
theorem marked_prime_pool_harmonic_bound {G : Type*} [DecidableEq G]
    (groups : Finset G) (P : G → Finset ℕ)
    (hdisj : (groups : Set G).PairwiseDisjoint P) {V C L : ℝ} (hV : 0 ≤ V)
    (hmass : ∀ g ∈ groups, (∑ p ∈ P g, 1 / (p : ℝ)) ≤ V)
    (hcard : (groups.card : ℝ) ≤ C * Real.log L) :
    (∑ p ∈ groups.biUnion P, 1 / (p : ℝ)) ≤ (C * V) * Real.log L := by
  calc
    _ ≤ (groups.card : ℝ) * V := prime_group_harmonic_bound groups P hdisj V hmass
    _ ≤ (C * Real.log L) * V := mul_le_mul_of_nonneg_right hcard hV
    _ = _ := by ring

/-- The actual marked weight has an exponentially small reciprocal tail.
The polynomial loss depends only on the fixed group parameters. -/
theorem eventually_marked_smooth_tail_bound {q v V c d σ : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (hV : 0 ≤ V)
    (hc : 0 < c) (hd : 0 < d) (hσ : 0 < σ) (κ C : ℝ) (T : ℕ) :
    ∀ᶠ L : ℝ in atTop, ∀ (G : Type*) [DecidableEq G]
      (groups : Finset G) (P : G → Finset ℕ) (mass : G → ℝ) (t : G → ℕ),
      (groups : Set G).PairwiseDisjoint P →
      (∀ g ∈ groups, ∀ p ∈ P g, p.Prime) →
      (∀ g ∈ groups, ∀ p ∈ P g, Real.exp (L^c) ≤ (p : ℝ)) →
      (∀ g ∈ groups, ∀ p ∈ P g, (p : ℝ) ≤ Real.exp (L^d)) →
      (∀ g ∈ groups, (∑ p ∈ P g, 1 / (p : ℝ)) ≤ V) →
      (∀ g ∈ groups, v ≤ mass g) →
      (∀ g ∈ groups, t g ≤ T) →
      (groups.card : ℝ) ≤ C * Real.log L →
      markedSmoothTail groups P q mass t (Real.exp (κ * L)) ≤
        Real.exp (-(κ * σ) * L^(1-d)) *
          L^(C * Real.log (markedDivisorBound q v T) + 2 * Real.exp σ * (C * V)) := by
  filter_upwards [eventually_weighted_smooth_tail_bound hc hd hσ κ (C * V)
    (C * Real.log (markedDivisorBound q v T)), eventually_gt_atTop (0 : ℝ)] with L htail hL
  intro G _ groups P mass t hdisj hprime hmin hmax hmass hnorm ht hcard
  apply htail (groups.biUnion P) (fun m : ℕ => markedDivisorWeight groups P q mass t (m : ℤ))
  · intro p hp
    obtain ⟨g, hg, hpg⟩ := mem_biUnion.mp hp
    exact hprime g hg p hpg
  · intro p hp
    obtain ⟨g, hg, hpg⟩ := mem_biUnion.mp hp
    exact hmin g hg p hpg
  · intro p hp
    obtain ⟨g, hg, hpg⟩ := mem_biUnion.mp hp
    exact hmax g hg p hpg
  · exact marked_prime_pool_harmonic_bound groups P hdisj hV hmass hcard
  · intro n _
    exact marked_divisor_weight_nonneg groups P hq0 mass t
      (fun g hg => hv.le.trans (hnorm g hg)) (n : ℤ)
  · intro n _
    exact marked_divisor_weight_le_rpow groups P hq0 hq1 hv hL mass t T hnorm ht hcard (n : ℤ)

/-- When the maximum prime exponent is below one, the marked tail beats
every fixed power of L. The threshold is uniform over all finite group data. -/
theorem eventually_marked_smooth_tail_power_saving {q v V c d σ κ : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (hV : 0 ≤ V)
    (hc : 0 < c) (hd : 0 < d) (hd1 : d < 1) (hσ : 0 < σ) (hκ : 0 < κ)
    (C : ℝ) (T : ℕ) (A : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (G : Type*) [DecidableEq G]
      (groups : Finset G) (P : G → Finset ℕ) (mass : G → ℝ) (t : G → ℕ),
      (groups : Set G).PairwiseDisjoint P →
      (∀ g ∈ groups, ∀ p ∈ P g, p.Prime) →
      (∀ g ∈ groups, ∀ p ∈ P g, Real.exp (L^c) ≤ (p : ℝ)) →
      (∀ g ∈ groups, ∀ p ∈ P g, (p : ℝ) ≤ Real.exp (L^d)) →
      (∀ g ∈ groups, (∑ p ∈ P g, 1 / (p : ℝ)) ≤ V) →
      (∀ g ∈ groups, v ≤ mass g) →
      (∀ g ∈ groups, t g ≤ T) →
      (groups.card : ℝ) ≤ C * Real.log L →
      markedSmoothTail groups P q mass t (Real.exp (κ * L)) ≤ L^(-A) := by
  filter_upwards [eventually_marked_smooth_tail_bound hq0 hq1 hv hV hc hd hσ κ C T,
    eventually_exp_neg_rpow_mul_rpow_le (sub_pos.mpr hd1) (mul_pos hκ hσ)
      (C * Real.log (markedDivisorBound q v T) + 2 * Real.exp σ * (C * V)) A] with L htail hdecay
  intro G _ groups P mass t hdisj hprime hmin hmax hmass hnorm ht hcard
  exact (htail G groups P mass t hdisj hprime hmin hmax hmass hnorm ht hcard).trans hdecay
end

section
open Filter Finset
noncomputable def candidateMarkedSmoothTail (s L q : ℝ) (ell : ℕ) (X : ℝ) : ℝ :=
  markedSmoothTail (candidatePIndices s L) (candidatePBand (s * L)) q
    (fun j => ∑ p ∈ candidatePBand (s * L) j, 1 / (p : ℝ)) (fun _ => ell) X

/-- The concrete small and big P-pools have an exponentially decaying
marked reciprocal tail, with only a fixed polynomial loss. -/
theorem exists_candidate_marked_smooth_tail_exp_bound {s q κ : ℝ}
    (hs : 0 < s) (hq0 : 0 ≤ q) (hq1 : q < 1) (ell : ℕ) :
    ∃ D : ℝ, ∀ᶠ L : ℝ in atTop,
      candidateMarkedSmoothTail s L q ell (Real.exp (κ * L)) ≤
        Real.exp (-κ * L^(3/5 : ℝ)) * L^D := by
  obtain ⟨v, V, hv, hV, hpool⟩ := exists_candidate_P_pool_bounds hs
  let C : ℝ := 2 / (5 * Real.log 2)
  refine ⟨C * Real.log (markedDivisorBound q v ell) + 2 * Real.exp 1 * (C * V), ?_⟩
  filter_upwards [hpool,
    eventually_marked_smooth_tail_bound (c := (1/10 : ℝ)) (d := (2/5 : ℝ)) (σ := 1)
      hq0 hq1 hv hV.le (by norm_num) (by norm_num) (by norm_num) κ C ell] with L hp ht
  rcases hp with ⟨_, _, _, hcard, hpair, hdata⟩
  have hdisj : (candidatePIndices s L : Set ℕ).PairwiseDisjoint (candidatePBand (s * L)) := by
    intro i _ j _ hij
    exact hpair hij
  have htail := ht ℕ (candidatePIndices s L) (candidatePBand (s * L))
    (fun j => ∑ p ∈ candidatePBand (s * L) j, 1 / (p : ℝ)) (fun _ => ell) hdisj
    (fun j hj p hp => ((hdata j hj).2.2 p hp).1)
    (fun j hj p hp => ((hdata j hj).2.2 p hp).2.1.le)
    (fun j hj p hp => ((hdata j hj).2.2 p hp).2.2)
    (fun j hj => (hdata j hj).2.1) (fun j hj => (hdata j hj).1)
    (fun _ _ => le_rfl) hcard
  norm_num only [mul_one, show (1 : ℝ) - 2/5 = 3/5 by norm_num] at htail
  exact htail

/-- No abstract supply hypothesis remains: the actual marked candidate
tail beyond `exp (κ L)` beats every fixed power. -/
theorem eventually_candidate_marked_smooth_tail_power_saving {s q κ : ℝ}
    (hs : 0 < s) (hq0 : 0 ≤ q) (hq1 : q < 1) (hκ : 0 < κ) (ell : ℕ) (A : ℝ) :
    ∀ᶠ L : ℝ in atTop,
      candidateMarkedSmoothTail s L q ell (Real.exp (κ * L)) ≤ L^(-A) := by
  obtain ⟨D, htail⟩ := exists_candidate_marked_smooth_tail_exp_bound (κ := κ) hs hq0 hq1 ell
  filter_upwards [htail,
    eventually_exp_neg_rpow_mul_rpow_le (by norm_num : (0 : ℝ) < 3/5) hκ D A]
    with L ht hdecay
  exact ht.trans hdecay

/-- The concrete marked tail still beats every power after multiplication
by any fixed nonnegative exponential square-root loss. -/
theorem eventually_candidate_marked_smooth_tail_sqrt_loss {s q κ K : ℝ}
    (hs : 0 < s) (hq0 : 0 ≤ q) (hq1 : q < 1) (hκ : 0 < κ)
    (hK : 0 ≤ K) (ell : ℕ) (A : ℝ) :
    ∀ᶠ L : ℝ in atTop,
      candidateMarkedSmoothTail s L q ell (Real.exp (κ * L)) *
        Real.exp (K * Real.sqrt L) ≤ L^(-A) := by
  obtain ⟨D, htail⟩ := exists_candidate_marked_smooth_tail_exp_bound (κ := κ) hs hq0 hq1 ell
  filter_upwards [htail,
    eventually_exp_neg_rpow_mul_rpow_mul_exp_sqrt_le
      (by norm_num : (1/2 : ℝ) < 3/5) hκ hK D A] with L ht hdecay
  exact (mul_le_mul_of_nonneg_right ht (Real.exp_pos _).le).trans hdecay
end

section
open Finset
/-- The complete prime-power part supported in the selected pool. -/
noncomputable def primePoolPart (P : Finset ℕ) (n : ℕ) : ℕ :=
  (n.factorization.filter (fun p => p ∈ P)).prod (fun p k => p ^ k)

/-- The complementary part. This convention also gives `primePoolFreePart P 0 = 0`. -/
noncomputable def primePoolFreePart (P : Finset ℕ) (n : ℕ) : ℕ :=
  n / primePoolPart P n

private theorem pool_factorization_filter_le (P : Finset ℕ) (n : ℕ) :
    n.factorization.filter (fun p => p ∈ P) ≤ n.factorization := by
  intro p
  by_cases hp : p ∈ P <;> simp [hp]

/-- No primality assumption on the pool is needed: factorization already discards nonprimes. -/
theorem primePoolPart_dvd (P : Finset ℕ) (n : ℕ) : primePoolPart P n ∣ n :=
  Nat.prod_pow_dvd_of_le_factorization (pool_factorization_filter_le P n)

theorem primePoolPart_ne_zero (P : Finset ℕ) (n : ℕ) : primePoolPart P n ≠ 0 := by
  apply Finsupp.prod_ne_zero_iff.mpr
  intro p hp
  have hp' : p ∈ n.primeFactors := (mem_filter.mp hp).1
  exact pow_ne_zero _ (Nat.prime_of_mem_primeFactors hp').ne_zero

/-- The manuscript decomposition holds also at zero. -/
theorem primePoolPart_mul_primePoolFreePart (P : Finset ℕ) (n : ℕ) :
    primePoolPart P n * primePoolFreePart P n = n :=
  Nat.mul_div_cancel' (primePoolPart_dvd P n)

theorem factorization_primePoolPart (P : Finset ℕ) (n : ℕ) :
    (primePoolPart P n).factorization = n.factorization.filter (fun p => p ∈ P) :=
  Nat.factorization_prod_pow_eq_self_of_le_factorization (pool_factorization_filter_le P n)

theorem factorization_primePoolFreePart (P : Finset ℕ) (n : ℕ) :
    (primePoolFreePart P n).factorization = n.factorization.filter (fun p => p ∉ P) := by
  rw [primePoolFreePart, Nat.factorization_div (primePoolPart_dvd P n), factorization_primePoolPart]
  ext p
  by_cases hp : p ∈ P <;> simp [hp]

/-- The extracted part is supported on the pool, including when the input is zero. -/
theorem primePoolPart_mem_factoredNumbers (P : Finset ℕ) (n : ℕ) :
    primePoolPart P n ∈ Nat.factoredNumbers P := by
  apply Nat.mem_factoredNumbers_of_primeFactors_subset (primePoolPart_ne_zero P n)
  intro p hp
  rw [← Nat.support_factorization, factorization_primePoolPart, Finsupp.support_filter] at hp
  exact (mem_filter.mp hp).2

/-- The literal manuscript condition `n_* = 1` is exactly finite-prime support. -/
theorem mem_factoredNumbers_iff_primePoolFreePart_eq_one (P : Finset ℕ) (n : ℕ) :
    n ∈ Nat.factoredNumbers P ↔ primePoolFreePart P n = 1 := by
  constructor
  · intro hn
    have hn0 := Nat.ne_zero_of_mem_factoredNumbers hn
    have hsupport := Nat.primeFactors_subset_of_mem_factoredNumbers hn
    have hf : n.factorization.filter (fun p => p ∈ P) = n.factorization := by
      apply (Finsupp.filter_eq_self_iff _ _).mpr
      intro p hp
      exact hsupport (Finsupp.mem_support_iff.mpr hp)
    have heq : primePoolPart P n = n := by
      rw [primePoolPart, hf, Nat.prod_factorization_pow_eq_self hn0]
    rw [primePoolFreePart, heq, Nat.div_self (Nat.pos_of_ne_zero hn0)]
  · intro hn
    have heq := primePoolPart_mul_primePoolFreePart P n
    rw [hn, mul_one] at heq
    exact heq ▸ primePoolPart_mem_factoredNumbers P n

theorem primePoolFreePart_ne_zero (P : Finset ℕ) {n : ℕ} (hn : n ≠ 0) :
    primePoolFreePart P n ≠ 0 := by
  intro h
  have heq := primePoolPart_mul_primePoolFreePart P n
  rw [h, mul_zero] at heq
  exact hn heq.symm

/-- The complement contains no prime from the selected pool. -/
theorem primePoolFreePart_primeFactors_disjoint (P : Finset ℕ) (n : ℕ) :
    Disjoint (primePoolFreePart P n).primeFactors P := by
  apply disjoint_left.mpr
  intro p hp hpP
  rw [← Nat.support_factorization, factorization_primePoolFreePart, Finsupp.support_filter] at hp
  exact (mem_filter.mp hp).2 hpP

/-- An explicit prime-power product for the extracted part. -/
theorem primePoolPart_eq_prod (P : Finset ℕ) (n : ℕ) :
    primePoolPart P n = ∏ p ∈ P, p ^ n.factorization p := by
  unfold primePoolPart
  rw [Finsupp.prod_of_support_subset _ (s := P) (by
    intro p hp
    exact (mem_filter.mp hp).2) _ (by intros; simp)]
  apply prod_congr rfl
  intro p hp
  simp [hp]

/-- For a positive integer, the quotient is precisely the product of prime powers outside the pool. -/
theorem primePoolFreePart_eq_prod (P : Finset ℕ) {n : ℕ} (hn : n ≠ 0) :
    primePoolFreePart P n =
      (n.factorization.filter (fun p => p ∉ P)).prod (fun p k => p ^ k) := by
  apply Nat.div_eq_of_eq_mul_left (Nat.pos_of_ne_zero (primePoolPart_ne_zero P n))
  rw [mul_comm]
  exact (Finsupp.prod_filter_mul_prod_filter_not (fun p => p ∈ P) n.factorization
    (fun p k => p ^ k)).trans (Nat.prod_factorization_pow_eq_self hn) |>.symm

/-- Reindex the analytic tail by the manuscript's literal group-free-part condition. -/
theorem weighted_smooth_tail_eq_free_part_sum (P : Finset ℕ) (W : ℕ → ℝ) (X : ℝ) :
    (∑' n : Nat.factoredNumbers P, weightedSmoothTailTerm P W X n) =
      ∑' n : {n : ℕ // primePoolFreePart P n = 1},
        if X ≤ (n.val : ℝ) then W n.val / (n.val : ℝ) else 0 := by
  let e : Nat.factoredNumbers P ≃ {n : ℕ // primePoolFreePart P n = 1} :=
    { toFun := fun n => ⟨n.val, (mem_factoredNumbers_iff_primePoolFreePart_eq_one P n.val).mp n.property⟩
      invFun := fun n => ⟨n.val, (mem_factoredNumbers_iff_primePoolFreePart_eq_one P n.val).mpr n.property⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  exact e.tsum_eq (fun n => if X ≤ (n.val : ℝ) then W n.val / (n.val : ℝ) else 0)
end

section
open Finset
/-- Visible trace: active stays `none`; unborn and completed both become
inactive-empty `some none`; a pending residue is retained. -/
def ghostPhaseForgetFlags {R : Type*} : GhostPhaseState R → Option (Option R)
  | none => none
  | some none => some none
  | some (some none) => some none
  | some (some (some r)) => some (some r)

theorem ghost_phase_visible_live_iff {R : Type*} (z : GhostPhaseState R) :
    ghostPhaseForgetFlags z ≠ some none ↔ ghostPhaseRank z = 1 := by
  rcases z with _ | (_ | (_ | r)) <;> simp [ghostPhaseForgetFlags, ghostPhaseRank]

theorem ghost_phase_visit_rank_step {R : Type*} [DecidableEq R]
    (a : Bool) (h : R) (η β : ℝ) (z w : GhostPhaseState R)
    (hn : ghostPhaseVisit a h η β z w ≠ 0) :
    ghostPhaseRank z ≤ ghostPhaseRank w + 1 := by
  cases a <;> rcases z with _ | (_ | (_ | r)) <;>
    rcases w with _ | (_ | (_ | s)) <;>
      simp_all [ghostPhaseVisit, ghostFiniteKernel, ghostPhaseRank]

theorem ghost_phase_edge_rank_step {R : Type*} [Fintype R] [DecidableEq R]
    (atgt asrc : Bool) (htgt hsrc : R) (β : ℝ) (z w : GhostPhaseState R)
    (hn : ghostPhaseEdge atgt asrc htgt hsrc β z w ≠ 0) :
    ghostPhaseRank z ≤ ghostPhaseRank w + 1 := by
  cases atgt <;> cases asrc <;> rcases z with _ | (_ | (_ | r)) <;>
    rcases w with _ | (_ | (_ | s)) <;>
      simp_all [ghostPhaseEdge, ghostPhaseGather, ghostPhaseScatter,
        ghostActiveInput, ghostActiveOutput, ghostPhaseRank]

theorem ghost_phase_initial_rank_le_one {R : Type*} (a : Bool) (β : ℝ)
    (z : GhostPhaseState R) (hn : ghostPhaseInitial a β z ≠ 0) : ghostPhaseRank z ≤ 1 := by
  cases a <;> rcases z with _ | (_ | (_ | r)) <;>
    simp_all [ghostPhaseInitial, ghostFiniteInitial, ghostPhaseRank]

/-- Reaching completed rank requires an earlier visible live state. -/
theorem ghost_phase_done_has_earlier_live {R : Type*} (q : ℕ → GhostPhaseState R)
    (n : ℕ) (h0 : ghostPhaseRank (q 0) ≤ 1)
    (hs : ∀ j < n, ghostPhaseRank (q (j + 1)) ≤ ghostPhaseRank (q j) + 1) :
    ∀ j ≤ n, ghostPhaseRank (q j) = 2 → ∃ i < j, ghostPhaseRank (q i) = 1 := by
  intro j
  induction j with
  | zero => intro _ hj; omega
  | succ j ih =>
    intro hjn hj
    have hstep := hs j (by omega)
    have hbound := ghost_phase_rank_le_two (q j)
    by_cases hlive : ghostPhaseRank (q j) = 1
    · exact ⟨j, by omega, hlive⟩
    · have hdone : ghostPhaseRank (q j) = 2 := by omega
      obtain ⟨i, hi, hir⟩ := ih (by omega) hdone
      exact ⟨i, by omega, hir⟩

/-- At an inactive-empty cut, its flag is unborn precisely when the visible
trace has never been active or pending at any previous cut. -/
theorem ghost_phase_empty_flag_reconstruction {R : Type*}
    (q : ℕ → GhostPhaseState R) (n : ℕ) (h0 : ghostPhaseRank (q 0) ≤ 1)
    (hm : ∀ j < n, ghostPhaseRank (q j) ≤ ghostPhaseRank (q (j + 1)))
    (hs : ∀ j < n, ghostPhaseRank (q (j + 1)) ≤ ghostPhaseRank (q j) + 1)
    (j : ℕ) (hjn : j ≤ n) (he : ghostPhaseForgetFlags (q j) = some none) :
    q j = some none ↔ ∀ i < j, ghostPhaseForgetFlags (q i) = some none := by
  constructor
  · intro hU i hij
    have hle := ghost_phase_path_rank_mono q n hm i j (by omega) hjn
    rw [hU] at hle
    change ghostPhaseRank (q i) ≤ 0 at hle
    have hir := (ghost_phase_rank_zero_iff (q i)).1 (Nat.eq_zero_of_le_zero hle)
    rw [hir]
    rfl
  · intro hall
    have hnDone : q j ≠ some (some none) := by
      intro hD
      have hr : ghostPhaseRank (q j) = 2 := by rw [hD]; rfl
      obtain ⟨i, hi, hir⟩ := ghost_phase_done_has_earlier_live q n h0 hs j hjn hr
      have hne := (ghost_phase_visible_live_iff (q i)).2 hir
      exact hne (hall i hi)
    rcases hq : q j with _ | (_ | (_ | r)) <;>
      simp_all [ghostPhaseForgetFlags]

/-- Equality of the visible traces forces equality of all hidden U/D flags. -/
theorem ghost_phase_projected_path_unique {R : Type*}
    (q q' : ℕ → GhostPhaseState R) (n : ℕ)
    (h0 : ghostPhaseRank (q 0) ≤ 1) (h0' : ghostPhaseRank (q' 0) ≤ 1)
    (hm : ∀ j < n, ghostPhaseRank (q j) ≤ ghostPhaseRank (q (j + 1)))
    (hm' : ∀ j < n, ghostPhaseRank (q' j) ≤ ghostPhaseRank (q' (j + 1)))
    (hs : ∀ j < n, ghostPhaseRank (q (j + 1)) ≤ ghostPhaseRank (q j) + 1)
    (hs' : ∀ j < n, ghostPhaseRank (q' (j + 1)) ≤ ghostPhaseRank (q' j) + 1)
    (hp : ∀ j ≤ n, ghostPhaseForgetFlags (q j) = ghostPhaseForgetFlags (q' j)) :
    ∀ j ≤ n, q j = q' j := by
  intro j hj
  have heq := hp j hj
  have hflag : q j = some none ↔ q' j = some none := by
    by_cases he : ghostPhaseForgetFlags (q j) = some none
    · have he' : ghostPhaseForgetFlags (q' j) = some none := heq.symm.trans he
      rw [ghost_phase_empty_flag_reconstruction q n h0 hm hs j hj he,
        ghost_phase_empty_flag_reconstruction q' n h0' hm' hs' j hj he']
      constructor <;> intro hall i hi
      · rw [← hp i (by omega)]; exact hall i hi
      · rw [hp i (by omega)]; exact hall i hi
    · have hn : q j ≠ some none := by intro h; rw [h] at he; exact he rfl
      have hn' : q' j ≠ some none := by intro h; rw [h] at heq; exact he heq
      simp [hn, hn']
  rcases hq : q j with _ | (_ | (_ | r)) <;>
    rcases hq' : q' j with _ | (_ | (_ | s)) <;>
      simp_all [ghostPhaseForgetFlags]

/-- Starting live permits no later fresh unborn-to-born transition. -/
theorem ghost_phase_live_initial_no_fresh_birth {R : Type*} [DecidableEq R]
    (q : ℕ → GhostPhaseState R) (n : ℕ) (h0 : q 0 ≠ some none)
    (hm : ∀ j < n, ghostPhaseRank (q j) ≤ ghostPhaseRank (q (j + 1))) :
    ((range n).filter (fun j => q j = some none ∧ q (j + 1) ≠ some none)).card = 0 := by
  apply card_eq_zero.mpr
  apply filter_eq_empty_iff.mpr
  intro j hj hb
  exact ghost_phase_path_no_unborn_recovery q n hm 0 j (Nat.zero_le j)
    (Nat.le_of_lt (mem_range.mp hj)) h0 hb.1

/-- The initial active slot counts as the unique birth; it cannot be followed
by another fresh transition. Inactive starts have the usual one-birth bound. -/
theorem ghost_phase_total_birth_count_le_one {R : Type*} [DecidableEq R]
    (q : ℕ → GhostPhaseState R) (n : ℕ) (a0 : Bool) (β0 : ℝ)
    (hinit : ghostPhaseInitial a0 β0 (q 0) ≠ 0)
    (hm : ∀ j < n, ghostPhaseRank (q j) ≤ ghostPhaseRank (q (j + 1))) :
    (if a0 then 1 else 0) +
      ((range n).filter (fun j => q j = some none ∧ q (j + 1) ≠ some none)).card ≤ 1 := by
  cases ha : a0
  · simpa only [ha, Bool.false_eq_true, ↓reduceIte, zero_add] using
      ghost_phase_at_most_one_birth q n hm
  · have hU : q 0 ≠ some none := by
      intro hU
      simp [ha, hU, ghostPhaseInitial] at hinit
    rw [ghost_phase_live_initial_no_fresh_birth q n hU hm]
    simp

/-- An atomic actual phase transition, selected from a visit or an edge. -/
noncomputable def ghostPhaseMixedStep {R : Type*} [Fintype R] [DecidableEq R]
    (isVisit atgt asrc : Bool) (htgt hsrc : R) (η β : ℝ)
    (z w : GhostPhaseState R) : ℝ :=
  if isVisit then ghostPhaseVisit atgt htgt η β z w
  else ghostPhaseEdge atgt asrc htgt hsrc β z w

/-- A complete atomic history coefficient, including its initial and terminal tests. -/
noncomputable def ghostPhaseTraceWeight {R : Type*} [Fintype R] [DecidableEq R]
    (isVisit atgt asrc : ℕ → Bool) (htgt hsrc : ℕ → R) (η β : ℕ → ℝ)
    (a0 : Bool) (β0 : ℝ) (an : Bool) (q : ℕ → GhostPhaseState R) (n : ℕ) : ℝ :=
  ghostPhaseInitial a0 β0 (q 0) *
    (∏ j ∈ range n, ghostPhaseMixedStep (isVisit j) (atgt j) (asrc j)
      (htgt j) (hsrc j) (η j) (β j) (q (j + 1)) (q j)) *
    ghostPhaseTerminal an (q n)

/-- Numerical support of a complete history supplies all lifecycle hypotheses. -/
theorem ghost_phase_trace_lifecycle {R : Type*} [Fintype R] [DecidableEq R]
    (isVisit atgt asrc : ℕ → Bool) (htgt hsrc : ℕ → R) (η β : ℕ → ℝ)
    (a0 : Bool) (β0 : ℝ) (an : Bool) (q : ℕ → GhostPhaseState R) (n : ℕ)
    (hn : ghostPhaseTraceWeight isVisit atgt asrc htgt hsrc η β a0 β0 an q n ≠ 0) :
    ghostPhaseInitial a0 β0 (q 0) ≠ 0 ∧
      ∀ j < n, ghostPhaseRank (q j) ≤ ghostPhaseRank (q (j + 1)) ∧
        ghostPhaseRank (q (j + 1)) ≤ ghostPhaseRank (q j) + 1 := by
  have hparts := mul_ne_zero_iff.mp (mul_ne_zero_iff.mp hn).1
  refine ⟨hparts.1, ?_⟩
  intro j hj
  have hstep := (prod_ne_zero_iff.mp hparts.2) j (mem_range.mpr hj)
  cases hv : isVisit j
  · simp only [ghostPhaseMixedStep, hv, Bool.false_eq_true, ↓reduceIte] at hstep
    exact ⟨ghost_phase_edge_rank_mono _ _ _ _ _ _ _ hstep,
      ghost_phase_edge_rank_step _ _ _ _ _ _ _ hstep⟩
  · simp only [ghostPhaseMixedStep, hv, ↓reduceIte] at hstep
    exact ⟨ghost_phase_visit_rank_mono _ _ _ _ _ _ hstep,
      ghost_phase_visit_rank_step _ _ _ _ _ _ hstep⟩

/-- Two nonzero complete actual histories with the same visible trace have
identical unborn/completed flags at every cut. No flag multiplicity remains. -/
theorem ghost_phase_nonzero_trace_flags_unique {R : Type*} [Fintype R] [DecidableEq R]
    (isVisit atgt asrc : ℕ → Bool) (htgt hsrc : ℕ → R) (η β : ℕ → ℝ)
    (a0 : Bool) (β0 : ℝ) (an : Bool) (q q' : ℕ → GhostPhaseState R) (n : ℕ)
    (hn : ghostPhaseTraceWeight isVisit atgt asrc htgt hsrc η β a0 β0 an q n ≠ 0)
    (hn' : ghostPhaseTraceWeight isVisit atgt asrc htgt hsrc η β a0 β0 an q' n ≠ 0)
    (hp : ∀ j ≤ n, ghostPhaseForgetFlags (q j) = ghostPhaseForgetFlags (q' j)) :
    ∀ j ≤ n, q j = q' j := by
  have hq := ghost_phase_trace_lifecycle isVisit atgt asrc htgt hsrc η β a0 β0 an q n hn
  have hq' := ghost_phase_trace_lifecycle isVisit atgt asrc htgt hsrc η β a0 β0 an q' n hn'
  exact ghost_phase_projected_path_unique q q' n
    (ghost_phase_initial_rank_le_one a0 β0 (q 0) hq.1)
    (ghost_phase_initial_rank_le_one a0 β0 (q' 0) hq'.1)
    (fun j hj => (hq.2 j hj).1) (fun j hj => (hq'.2 j hj).1)
    (fun j hj => (hq.2 j hj).2) (fun j hj => (hq'.2 j hj).2) hp

/-- Nonzero complete histories have at most one total birth per coordinate,
including a birth in an initial active slot. -/
theorem ghost_phase_nonzero_trace_total_births {R : Type*} [Fintype R] [DecidableEq R]
    (isVisit atgt asrc : ℕ → Bool) (htgt hsrc : ℕ → R) (η β : ℕ → ℝ)
    (a0 : Bool) (β0 : ℝ) (an : Bool) (q : ℕ → GhostPhaseState R) (n : ℕ)
    (hn : ghostPhaseTraceWeight isVisit atgt asrc htgt hsrc η β a0 β0 an q n ≠ 0) :
    (if a0 then 1 else 0) +
      ((range n).filter (fun j => q j = some none ∧ q (j + 1) ≠ some none)).card ≤ 1 := by
  have hq := ghost_phase_trace_lifecycle isVisit atgt asrc htgt hsrc η β a0 β0 an q n hn
  exact ghost_phase_total_birth_count_le_one q n a0 β0 hq.1 (fun j hj => (hq.2 j hj).1)
end

section
open Finset
def finiteChronologicalPrefix {X 𝕜 : Type*} [CommMonoid 𝕜]
    (K : ℕ → X → X → 𝕜) (f : X → 𝕜) (n : ℕ) (x : Fin (n + 1) → X) : 𝕜 :=
  f (x 0) * ∏ j : Fin n, K j.val (x j.succ) (x j.castSucc)

theorem finite_chronological_prefix_snoc {X 𝕜 : Type*} [CommMonoid 𝕜]
    (K : ℕ → X → X → 𝕜) (f : X → 𝕜) (n : ℕ)
    (x : Fin (n + 1) → X) (z : X) :
    finiteChronologicalPrefix K f (n + 1) (Fin.snoc x z) =
      K n z (x (Fin.last n)) * finiteChronologicalPrefix K f n x := by
  unfold finiteChronologicalPrefix
  rw [Fin.prod_univ_castSucc]
  simp only [Fin.val_castSucc, Fin.succ_castSucc, Fin.snoc_castSucc,
    Fin.val_last, Fin.succ_last, Fin.snoc_last]
  have hzero : (Fin.snoc (α := fun _ : Fin (n + 2) => X) x z) 0 = x 0 := by
    exact Fin.snoc_castSucc (α := fun _ : Fin (n + 2) => X) z x 0
  rw [hzero]
  ac_rfl

/-- Sum over all chronological states, with both boundary tests, is exactly
the finite matrix pairing. Every intermediate cut is retained explicitly. -/
theorem finite_chronological_trace_expansion {X 𝕜 : Type*}
    [Fintype X] [CommSemiring 𝕜]
    (K : ℕ → X → X → 𝕜) (f q : X → 𝕜) (n : ℕ) :
    (∑ x : Fin (n + 1) → X, q (x (Fin.last n)) * finiteChronologicalPrefix K f n x) =
      ∑ z, q z * finitePathAction K f n z := by
  classical
  induction n generalizing q with
  | zero =>
    rw [← (Fin.snocEquiv (fun _ : Fin 1 => X)).sum_comp]
    simp [finiteChronologicalPrefix, finitePathAction, Fin.snocEquiv,
      Fin.snoc_zero, Fintype.sum_prod_type]
  | succ n ih =>
    rw [← (Fin.snocEquiv (fun _ : Fin (n + 2) => X)).sum_comp]
    simp only [Fintype.sum_prod_type, Fin.snocEquiv, Equiv.coe_fn_mk,
      Fin.snoc_last, finite_chronological_prefix_snoc]
    simp_rw [← mul_assoc, mul_assoc (q _) (K n _ _) _, ← mul_sum, ih]
    rfl

/-- Interleave visits G_0,G_1,... and edges E_0,E_1,... in chronological order. -/
noncomputable def finiteAlternatingKernel {X 𝕜 : Type*}
    (G E : ℕ → X → X → 𝕜) (j : ℕ) : X → X → 𝕜 :=
  if j % 2 = 0 then G (j / 2) else E (j / 2)

theorem finite_alternating_kernel_even {X 𝕜 : Type*}
    (G E : ℕ → X → X → 𝕜) (j : ℕ) :
    finiteAlternatingKernel G E (2 * j) = G j := by
  simp [finiteAlternatingKernel]

theorem finite_alternating_kernel_odd {X 𝕜 : Type*}
    (G E : ℕ → X → X → 𝕜) (j : ℕ) :
    finiteAlternatingKernel G E (2 * j + 1) = E j := by
  simp [finiteAlternatingKernel, Nat.add_div]

theorem finite_alternating_action {X 𝕜 : Type*} [Fintype X] [CommSemiring 𝕜]
    (G E : ℕ → X → X → 𝕜) (f : X → 𝕜) (n : ℕ) (x : X) :
    finitePathAction (finiteAlternatingKernel G E) f (2 * n + 1) x =
      finitePathAction (fun j x y => ∑ z, G (j + 1) x z * E j z y)
        (fun x => ∑ y, G 0 x y * f y) n x := by
  induction n generalizing x with
  | zero => simp [finitePathAction, finiteAlternatingKernel]
  | succ n ih =>
    have hstep (y : X) :
        finitePathAction (finiteAlternatingKernel G E) f (2 * n + 1 + 1) y =
          ∑ z, E n y z * finitePathAction
            (fun j x y => ∑ z, G (j + 1) x z * E j z y)
            (fun x => ∑ y, G 0 x y * f y) n z := by
      rw [finitePathAction, finite_alternating_kernel_odd]
      simp only [ih]
    have hn : 2 * (n + 1) + 1 = (2 * n + 1) + 1 + 1 := by omega
    rw [hn, finitePathAction]
    have he : 2 * n + 1 + 1 = 2 * (n + 1) := by omega
    rw [show finiteAlternatingKernel G E (2 * n + 1 + 1) = G (n + 1) by
      rw [he, finite_alternating_kernel_even]]
    simp_rw [hstep]
    rw [finitePathAction]
    simp only [sum_mul, mul_sum, mul_assoc]
    rw [sum_comm]
end

section
open Finset
/-- Extend a finite trace constantly after its final cut. -/
def ghostPhaseFiniteTraceExtend {R : Type*} {n : ℕ}
    (x : Fin (n + 1) → GhostPhaseState R) (j : ℕ) : GhostPhaseState R :=
  x ⟨min j n, Nat.lt_succ_of_le (Nat.min_le_right j n)⟩

theorem ghost_phase_finite_extend_at {R : Type*} {n : ℕ}
    (x : Fin (n + 1) → GhostPhaseState R) (j : Fin (n + 1)) :
    ghostPhaseFiniteTraceExtend x j = x j := by
  unfold ghostPhaseFiniteTraceExtend
  have hj : (j : ℕ) ≤ n := Nat.le_of_lt_succ j.isLt
  congr 1
  apply Fin.ext
  exact Nat.min_eq_left hj

theorem ghost_phase_finite_extend_input {R : Type*} {n : ℕ}
    (x : Fin (n + 1) → GhostPhaseState R) (j : Fin n) :
    ghostPhaseFiniteTraceExtend x j = x j.castSucc :=
  ghost_phase_finite_extend_at x j.castSucc

theorem ghost_phase_finite_extend_output {R : Type*} {n : ℕ}
    (x : Fin (n + 1) → GhostPhaseState R) (j : Fin n) :
    ghostPhaseFiniteTraceExtend x (j + 1) = x j.succ :=
  ghost_phase_finite_extend_at x j.succ

/-- Complete finite trace weight, with all transitions indexed directly by `Fin n`. -/
noncomputable def ghostPhaseFiniteTraceWeight {R : Type*} [Fintype R] [DecidableEq R]
    (isVisit atgt asrc : ℕ → Bool) (htgt hsrc : ℕ → R) (η β : ℕ → ℝ)
    (a0 : Bool) (β0 : ℝ) (an : Bool) {n : ℕ}
    (x : Fin (n + 1) → GhostPhaseState R) : ℝ :=
  ghostPhaseInitial a0 β0 (x 0) *
    (∏ j : Fin n, ghostPhaseMixedStep (isVisit j) (atgt j) (asrc j)
      (htgt j) (hsrc j) (η j) (β j) (x j.succ) (x j.castSucc)) *
    ghostPhaseTerminal an (x (Fin.last n))

/-- The finite definition is exactly the previously verified actual trace coefficient. -/
theorem ghost_phase_finite_trace_weight_eq {R : Type*} [Fintype R] [DecidableEq R]
    (isVisit atgt asrc : ℕ → Bool) (htgt hsrc : ℕ → R) (η β : ℕ → ℝ)
    (a0 : Bool) (β0 : ℝ) (an : Bool) {n : ℕ}
    (x : Fin (n + 1) → GhostPhaseState R) :
    ghostPhaseFiniteTraceWeight isVisit atgt asrc htgt hsrc η β a0 β0 an x =
      ghostPhaseTraceWeight isVisit atgt asrc htgt hsrc η β a0 β0 an
        (ghostPhaseFiniteTraceExtend x) n := by
  have hp : (∏ j : Fin n, ghostPhaseMixedStep (isVisit j) (atgt j) (asrc j)
      (htgt j) (hsrc j) (η j) (β j) (x j.succ) (x j.castSucc)) =
      ∏ j ∈ range n, ghostPhaseMixedStep (isVisit j) (atgt j) (asrc j)
        (htgt j) (hsrc j) (η j) (β j)
        (ghostPhaseFiniteTraceExtend x (j + 1)) (ghostPhaseFiniteTraceExtend x j) := by
    rw [← Fin.prod_univ_eq_prod_range]
    apply prod_congr rfl
    intro j _
    rw [ghost_phase_finite_extend_input, ghost_phase_finite_extend_output]
  simp only [ghostPhaseFiniteTraceWeight, ghostPhaseTraceWeight, hp]
  rw [show ghostPhaseFiniteTraceExtend x 0 = x 0 from ghost_phase_finite_extend_at x 0,
    show ghostPhaseFiniteTraceExtend x n = x (Fin.last n) from
      ghost_phase_finite_extend_at x (Fin.last n)]

/-- Equality of finite visible traces determines every hidden flag on nonzero support. -/
theorem ghost_phase_finite_trace_flags_unique {R : Type*} [Fintype R] [DecidableEq R]
    (isVisit atgt asrc : ℕ → Bool) (htgt hsrc : ℕ → R) (η β : ℕ → ℝ)
    (a0 : Bool) (β0 : ℝ) (an : Bool) {n : ℕ}
    (x y : Fin (n + 1) → GhostPhaseState R)
    (hx : ghostPhaseFiniteTraceWeight isVisit atgt asrc htgt hsrc η β a0 β0 an x ≠ 0)
    (hy : ghostPhaseFiniteTraceWeight isVisit atgt asrc htgt hsrc η β a0 β0 an y ≠ 0)
    (hp : (fun j => ghostPhaseForgetFlags (x j)) = (fun j => ghostPhaseForgetFlags (y j))) :
    x = y := by
  rw [ghost_phase_finite_trace_weight_eq] at hx hy
  have hnat := ghost_phase_nonzero_trace_flags_unique isVisit atgt asrc htgt hsrc η β
    a0 β0 an (ghostPhaseFiniteTraceExtend x) (ghostPhaseFiniteTraceExtend y) n hx hy
    (fun j _ => congrFun hp ⟨min j n, Nat.lt_succ_of_le (Nat.min_le_right j n)⟩)
  funext j
  have hj := hnat j (Nat.le_of_lt_succ j.isLt)
  simpa only [ghost_phase_finite_extend_at] using hj

/-- Forgetting U/D flags is injective on the finite nonzero-weight support. -/
theorem ghost_phase_finite_visible_injective {R : Type*} [Fintype R] [DecidableEq R]
    (isVisit atgt asrc : ℕ → Bool) (htgt hsrc : ℕ → R) (η β : ℕ → ℝ)
    (a0 : Bool) (β0 : ℝ) (an : Bool) (n : ℕ) :
    Function.Injective (fun x : {x : Fin (n + 1) → GhostPhaseState R //
      ghostPhaseFiniteTraceWeight isVisit atgt asrc htgt hsrc η β a0 β0 an x ≠ 0} =>
        fun j => ghostPhaseForgetFlags (x.val j)) := by
  intro x y hp
  apply Subtype.ext
  exact ghost_phase_finite_trace_flags_unique isVisit atgt asrc htgt hsrc η β
    a0 β0 an x.val y.val x.property y.property hp

/-- The finite fresh-birth set has exactly the extended trace's birth count. -/
theorem ghost_phase_finite_birth_count_eq {R : Type*} [DecidableEq R] {n : ℕ}
    (x : Fin (n + 1) → GhostPhaseState R) :
    ((univ : Finset (Fin n)).filter
      (fun j => x j.castSucc = some none ∧ x j.succ ≠ some none)).card =
      ((range n).filter (fun j => ghostPhaseFiniteTraceExtend x j = some none ∧
        ghostPhaseFiniteTraceExtend x (j + 1) ≠ some none)).card := by
  simp only [card_eq_sum_ones, sum_filter]
  rw [← Fin.sum_univ_eq_sum_range]
  apply sum_congr rfl
  intro j _
  rw [ghost_phase_finite_extend_input, ghost_phase_finite_extend_output]

/-- A finite supported history has at most one birth in total, including an
initial active slot. -/
theorem ghost_phase_finite_total_births {R : Type*} [Fintype R] [DecidableEq R]
    (isVisit atgt asrc : ℕ → Bool) (htgt hsrc : ℕ → R) (η β : ℕ → ℝ)
    (a0 : Bool) (β0 : ℝ) (an : Bool) {n : ℕ}
    (x : Fin (n + 1) → GhostPhaseState R)
    (hx : ghostPhaseFiniteTraceWeight isVisit atgt asrc htgt hsrc η β a0 β0 an x ≠ 0) :
    (if a0 then 1 else 0) + ((univ : Finset (Fin n)).filter
      (fun j => x j.castSucc = some none ∧ x j.succ ≠ some none)).card ≤ 1 := by
  rw [ghost_phase_finite_birth_count_eq]
  rw [ghost_phase_finite_trace_weight_eq] at hx
  exact ghost_phase_nonzero_trace_total_births isVisit atgt asrc htgt hsrc η β
    a0 β0 an (ghostPhaseFiniteTraceExtend x) n hx
end

section
open Finset
/-- Sum of the direct finite weights equals finite matrix evolution, for any
fixed chronological mixture of the actual phase visit and edge kernels. -/
theorem ghost_phase_finite_trace_action {R : Type*} [Fintype R] [DecidableEq R]
    (isVisit atgt asrc : ℕ → Bool) (htgt hsrc : ℕ → R) (η β : ℕ → ℝ)
    (a0 : Bool) (β0 : ℝ) (an : Bool) (n : ℕ) :
    (∑ x : Fin (n + 1) → GhostPhaseState R,
      ghostPhaseFiniteTraceWeight isVisit atgt asrc htgt hsrc η β a0 β0 an x) =
      ∑ z, ghostPhaseTerminal an z *
        finitePathAction (fun j => ghostPhaseMixedStep (isVisit j) (atgt j) (asrc j)
          (htgt j) (hsrc j) (η j) (β j)) (ghostPhaseInitial a0 β0) n z := by
  calc
    _ = ∑ x : Fin (n + 1) → GhostPhaseState R,
        ghostPhaseTerminal an (x (Fin.last n)) *
          finiteChronologicalPrefix
            (fun j => ghostPhaseMixedStep (isVisit j) (atgt j) (asrc j)
              (htgt j) (hsrc j) (η j) (β j)) (ghostPhaseInitial a0 β0) n x := by
      apply sum_congr rfl
      intro x _
      exact mul_comm _ _
    _ = _ := finite_chronological_trace_expansion _ _ _ n
end

section
open Finset
noncomputable def ghostPhaseChronologicalWeight {R : Type*}
    [Fintype R] [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (n : ℕ)
    (x : Fin ((2 * n + 1) + 1) → GhostPhaseState R) : ℝ :=
  ghostPhaseFiniteTraceWeight (fun j => decide (j % 2 = 0))
    (fun j => if j % 2 = 0 then a (j / 2) else a (j / 2 + 1))
    (fun j => a (j / 2))
    (fun j => if j % 2 = 0 then h (j / 2) else h (j / 2 + 1))
    (fun j => h (j / 2)) (fun j => η (j / 2)) (fun _ => β)
    (a 0) β (a n) x

theorem ghost_phase_chronological_kernel {R : Type*}
    [Fintype R] [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (j : ℕ) :
    ghostPhaseMixedStep (decide (j % 2 = 0))
      (if j % 2 = 0 then a (j / 2) else a (j / 2 + 1)) (a (j / 2))
      (if j % 2 = 0 then h (j / 2) else h (j / 2 + 1)) (h (j / 2))
      (η (j / 2)) β =
    finiteAlternatingKernel
      (fun i => ghostPhaseVisit (a i) (h i) (η i) β)
      (fun i => ghostPhaseEdge (a (i + 1)) (a i) (h (i + 1)) (h i) β) j := by
  funext z w
  by_cases hj : j % 2 = 0 <;> simp [ghostPhaseMixedStep, finiteAlternatingKernel, hj]

theorem ghost_phase_chronological_sum {R : Type*} [Fintype R] [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (n : ℕ) :
    (∑ x, ghostPhaseChronologicalWeight a h η β n x) = ghostPhaseHistory a h η β n := by
  let G := fun i => ghostPhaseVisit (a i) (h i) (η i) β
  let E := fun i => ghostPhaseEdge (a (i + 1)) (a i) (h (i + 1)) (h i) β
  have hw (x : Fin ((2 * n + 1) + 1) → GhostPhaseState R) :
      ghostPhaseChronologicalWeight a h η β n x =
      ghostPhaseTerminal (a n) (x (Fin.last (2 * n + 1))) *
        finiteChronologicalPrefix (finiteAlternatingKernel G E)
          (ghostPhaseInitial (a 0) β) (2 * n + 1) x := by
    simp only [ghostPhaseChronologicalWeight, ghostPhaseFiniteTraceWeight,
      ghost_phase_chronological_kernel, finiteChronologicalPrefix, G, E]
    ring
  simp_rw [hw]
  rw [finite_chronological_trace_expansion]
  simp_rw [finite_alternating_action]
  rfl

/-- The finite sum contains only one supported hidden-flag lift of any
visible active/pending trace. -/
theorem ghost_phase_chronological_flags_unique {R : Type*}
    [Fintype R] [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (n : ℕ)
    (x y : Fin ((2 * n + 1) + 1) → GhostPhaseState R)
    (hx : ghostPhaseChronologicalWeight a h η β n x ≠ 0)
    (hy : ghostPhaseChronologicalWeight a h η β n y ≠ 0)
    (hp : (fun j => ghostPhaseForgetFlags (x j)) = (fun j => ghostPhaseForgetFlags (y j))) :
    x = y := by
  exact ghost_phase_finite_trace_flags_unique _ _ _ _ _ _ _ _ _ _ x y hx hy hp

/-- Count every actual birth, including initial activity, in the fully
expanded alternating history. -/
theorem ghost_phase_chronological_total_births {R : Type*}
    [Fintype R] [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (n : ℕ)
    (x : Fin ((2 * n + 1) + 1) → GhostPhaseState R)
    (hx : ghostPhaseChronologicalWeight a h η β n x ≠ 0) :
    (if a 0 then 1 else 0) + ((univ : Finset (Fin (2 * n + 1))).filter
      (fun j => x j.castSucc = some none ∧ x j.succ ≠ some none)).card ≤ 1 := by
  exact ghost_phase_finite_total_births _ _ _ _ _ _ _ _ _ _ x hx
end

section
open Finset
/-- A Boolean endpoint decision is its finite set of selected coordinates. -/
noncomputable def ghostChoiceFinsetEquiv {I : Type*} [Fintype I] [DecidableEq I] :
    (I → Bool) ≃ Finset I where
  toFun c := univ.filter (fun i => c i = true)
  invFun S i := decide (i ∈ S)
  left_inv c := by funext i; simp
  right_inv S := by ext i; simp

/-- Reindex endpoint decisions as subsets, retaining zero-weight valid choices. -/
theorem ghost_choice_sum_subsets {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} (y u : (i : I) → X i) (r w : I → ℝ)
    (Q : Finset I) (hw : ∀ i, i ∉ Q → w i = 0)
    (F : ((i : I) → X i) → ℝ) :
    (∑ c : I → Bool, (∏ i, if c i then w i else r i) *
      F (fun i => if c i then u i else y i)) =
      ∑ S ∈ Q.powerset, (∏ i, if i ∈ S then w i else r i) *
        F (fun i => if i ∈ S then u i else y i) := by
  classical
  have he := ghostChoiceFinsetEquiv.symm.sum_comp
    (fun c : I → Bool => (∏ i, if c i then w i else r i) *
      F (fun i => if c i then u i else y i))
  have hall : (∑ c : I → Bool, (∏ i, if c i then w i else r i) *
      F (fun i => if c i then u i else y i)) =
      ∑ S : Finset I, (∏ i, if i ∈ S then w i else r i) *
        F (fun i => if i ∈ S then u i else y i) := by
    simpa only [ghostChoiceFinsetEquiv, Equiv.symm_mk, Equiv.coe_fn_mk,
      decide_eq_true_eq] using he.symm
  rw [hall]
  symm
  apply sum_subset (subset_univ _)
  intro S hS hnot
  have hnot' : ¬ S ⊆ Q := by simpa only [mem_powerset] using hnot
  obtain ⟨i, hi, hiQ⟩ := not_subset.mp hnot'
  have hp : (∏ j, if j ∈ S then w j else r j) = 0 := by
    apply prod_eq_zero (mem_univ i)
    simp only [if_pos hi, hw i hiQ]
  rw [hp, zero_mul]

/-- Subsets of two disjoint eligible event sets are exactly independent
subsets of each set. -/
theorem ghost_sum_powerset_disjoint_union {I : Type*} [DecidableEq I]
    (D U : Finset I) (hDU : Disjoint D U) (F : Finset I → ℝ) :
    (∑ S ∈ (D ∪ U).powerset, F S) =
      ∑ A ∈ D.powerset, ∑ B ∈ U.powerset, F (A ∪ B) := by
  classical
  rw [← sum_product D.powerset U.powerset (fun p => F (p.1 ∪ p.2))]
  symm
  apply sum_bij (fun p _ => p.1 ∪ p.2)
  · intro p hp
    simp only [mem_product, mem_powerset] at hp ⊢
    exact union_subset (hp.1.trans subset_union_left) (hp.2.trans subset_union_right)
  · intro p hp q hq hpq
    simp only [mem_product, mem_powerset] at hp hq
    have hdis := disjoint_left.mp hDU
    apply Prod.ext <;> ext i
    · have hu : i ∈ p.1 ∪ p.2 ↔ i ∈ q.1 ∪ q.2 := by rw [hpq]
      simp only [mem_union] at hu
      constructor
      · intro hip
        rcases hu.mp (Or.inl hip) with hiq | hiq
        · exact hiq
        · exact (hdis (hp.1 hip) (hq.2 hiq)).elim
      · intro hiq
        rcases hu.mpr (Or.inl hiq) with hip | hip
        · exact hip
        · exact (hdis (hq.1 hiq) (hp.2 hip)).elim
    · have hu : i ∈ p.1 ∪ p.2 ↔ i ∈ q.1 ∪ q.2 := by rw [hpq]
      simp only [mem_union] at hu
      constructor
      · intro hip
        rcases hu.mp (Or.inr hip) with hiq | hiq
        · exact (hdis (hq.1 hiq) (hp.2 hip)).elim
        · exact hiq
      · intro hiq
        rcases hu.mpr (Or.inr hiq) with hip | hip
        · exact (hdis (hp.1 hip) (hq.2 hiq)).elim
        · exact hip
  · intro S hS
    have hsub := mem_powerset.mp hS
    refine ⟨(S ∩ D, S ∩ U), ?_, ?_⟩
    · simp only [mem_product, mem_powerset]
      exact ⟨inter_subset_right, inter_subset_right⟩
    · ext i
      have hs : i ∈ S → i ∈ D ∨ i ∈ U := fun hi => mem_union.mp (hsub hi)
      simp only [mem_union, mem_inter]
      aesop
  · intro p hp
    rfl

/-- Inactive pending coordinates eligible to terminate at the current hit. -/
noncomputable def ghostVisitDeaths {I : Type*} [Fintype I]
    {R : I → Type*} [∀ i, DecidableEq (R i)]
    (a : I → Bool) (h : (i : I) → R i) (y : (i : I) → GhostPhaseState (R i)) : Finset I := by
  classical
  exact univ.filter (fun i => a i = false ∧ y i = some (some (some (h i))))

/-- Inactive unborn coordinates eligible to begin a new ghost lifespan. -/
noncomputable def ghostVisitBirths {I : Type*} [Fintype I]
    {R : I → Type*} (a : I → Bool) (y : (i : I) → GhostPhaseState (R i)) : Finset I := by
  classical
  exact univ.filter (fun i => a i = false ∧ y i = some none)

theorem ghost_visit_eligible_disjoint {I : Type*} [Fintype I]
    {R : I → Type*} [∀ i, DecidableEq (R i)]
    (a : I → Bool) (h : (i : I) → R i) (y : (i : I) → GhostPhaseState (R i)) :
    Disjoint (ghostVisitDeaths a h y) (ghostVisitBirths a y) := by
  classical
  apply disjoint_left.mpr
  intro i hiD hiU
  simp only [ghostVisitDeaths, ghostVisitBirths, mem_filter, mem_univ, true_and] at hiD hiU
  rw [hiD.2] at hiU
  simp at hiU

theorem ghost_visit_endpoint_zero_outside {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, DecidableEq (R i)]
    (a : I → Bool) (h : (i : I) → R i) (η β ρ : I → ℝ)
    (y : (i : I) → GhostPhaseState (R i)) (i : I)
    (hi : i ∉ ghostVisitDeaths a h y ∪ ghostVisitBirths a y) :
    ghostPhaseEndpointWeight (a i) (h i) (η i) (β i) (ρ i) (y i) = 0 := by
  by_contra hn
  obtain ⟨ha, hy⟩ := ghost_phase_endpoint_weight_support (a i) (h i) (η i) (β i) (ρ i) (y i) hn
  apply hi
  simp only [ghostVisitDeaths, ghostVisitBirths, mem_union, mem_filter, mem_univ, true_and]
  rcases hy with hy | hy
  · exact Or.inr ⟨ha, hy⟩
  · exact Or.inl ⟨ha, hy⟩

/-- Apply the selected terminations and births to the original input state.
The valid event sets are disjoint, so a newly born particle cannot terminate. -/
noncomputable def ghostVisitBatchOutput {I : Type*} [DecidableEq I]
    {R : I → Type*} (h : (i : I) → R i) (y : (i : I) → GhostPhaseState (R i))
    (A B : Finset I) : (i : I) → GhostPhaseState (R i) :=
  fun i => if i ∈ A then some (some none)
    else if i ∈ B then some (some (some (h i))) else y i

/-- On a valid phase state, only an inactive pending hit has nontrivial
retention weight. -/
theorem ghost_phase_retain_valid {R : Type*} [DecidableEq R]
    (a : Bool) (h : R) (η ρ : ℝ) (y : GhostPhaseState R)
    (hy : y.isSome = !a) :
    ghostPhaseRetain a h η ρ y =
      if a = false ∧ y = some (some (some h)) then (1 - η) / ρ ^ 2 else 1 := by
  cases a <;> rcases y with _ | (_ | (_ | r)) <;>
    simp_all [ghostPhaseRetain, ghostPhaseDampedVisit, ghostPhaseVisit,
      ghostFiniteKernel, ghostPhaseDiagonal, pow_two]
  split_ifs <;> simp_all

theorem ghost_visit_retain_eq {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, DecidableEq (R i)]
    (a : I → Bool) (h : (i : I) → R i) (η ρ : I → ℝ)
    (y : (i : I) → GhostPhaseState (R i)) (hy : ghostPhaseMask a y) (i : I) :
    ghostPhaseRetain (a i) (h i) (η i) (ρ i) (y i) =
      if i ∈ ghostVisitDeaths a h y then (1 - η i) / (ρ i) ^ 2 else 1 := by
  simpa only [ghostVisitDeaths, mem_filter, mem_univ, true_and] using
    ghost_phase_retain_valid (a i) (h i) (η i) (ρ i) (y i) (hy i)

/-- The simultaneous endpoint choices agree with the explicit death/birth update. -/
theorem ghost_visit_batch_output_eq {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, DecidableEq (R i)]
    (a : I → Bool) (h : (i : I) → R i) (y : (i : I) → GhostPhaseState (R i))
    (A B : Finset I) (hA : A ⊆ ghostVisitDeaths a h y) (hB : B ⊆ ghostVisitBirths a y) :
    (fun i => if i ∈ A ∪ B then ghostPhaseEndpoint (h i) (y i) else y i) =
      ghostVisitBatchOutput h y A B := by
  funext i
  by_cases hiA : i ∈ A
  · have hi := hA hiA
    simp only [ghostVisitDeaths, mem_filter, mem_univ, true_and] at hi
    simp [ghostVisitBatchOutput, hiA, hi.2, ghostPhaseEndpoint]
  · by_cases hiB : i ∈ B
    · have hi := hB hiB
      simp only [ghostVisitBirths, mem_filter, mem_univ, true_and] at hi
      simp [ghostVisitBatchOutput, hiA, hiB, hi.2, ghostPhaseEndpoint]
    · simp [ghostVisitBatchOutput, hiA, hiB]

/-- Each terminated particle, surviving hit, and newly born particle pays
its coefficient once. There is no ambient-memory factorial in this weight. -/
noncomputable def ghostVisitBatchWeight {I : Type*} [DecidableEq I]
    (D A B : Finset I) (η β ρ : I → ℝ) : ℝ :=
  (∏ i ∈ A, -η i / ρ i) * (∏ i ∈ D \ A, (1 - η i) / (ρ i) ^ 2) *
    ∏ i ∈ B, -β i * η i / ρ i

theorem ghost_visit_batch_weight_eq {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, DecidableEq (R i)]
    (a : I → Bool) (h : (i : I) → R i) (η β ρ : I → ℝ)
    (y : (i : I) → GhostPhaseState (R i)) (hy : ghostPhaseMask a y)
    (A B : Finset I) (hA : A ⊆ ghostVisitDeaths a h y) (hB : B ⊆ ghostVisitBirths a y) :
    (∏ i, if i ∈ A ∪ B then ghostPhaseEndpointWeight (a i) (h i) (η i) (β i) (ρ i) (y i)
      else ghostPhaseRetain (a i) (h i) (η i) (ρ i) (y i)) =
      ghostVisitBatchWeight (ghostVisitDeaths a h y) A B η β ρ := by
  classical
  have hdis := disjoint_left.mp (ghost_visit_eligible_disjoint a h y)
  have hp (i : I) :
      (if i ∈ A ∪ B then ghostPhaseEndpointWeight (a i) (h i) (η i) (β i) (ρ i) (y i)
        else ghostPhaseRetain (a i) (h i) (η i) (ρ i) (y i)) =
      (if i ∈ A then -η i / ρ i else 1) *
        (if i ∈ ghostVisitDeaths a h y \ A then (1 - η i) / (ρ i) ^ 2 else 1) *
        (if i ∈ B then -β i * η i / ρ i else 1) := by
    by_cases hiA : i ∈ A
    · have hiD := hA hiA
      have hiB : i ∉ B := fun hi => hdis hiD (hB hi)
      have hi := hiD
      simp only [ghostVisitDeaths, mem_filter, mem_univ, true_and] at hi
      simp [hiA, hiB, hi.1, hi.2, ghostPhaseEndpointWeight]
    · by_cases hiB : i ∈ B
      · have hiU := hB hiB
        have hiD : i ∉ ghostVisitDeaths a h y := fun hi => hdis hi hiU
        have hi := hiU
        simp only [ghostVisitBirths, mem_filter, mem_univ, true_and] at hi
        simp [hiA, hiB, hiD, hi.1, hi.2, ghostPhaseEndpointWeight]
      · simp [hiA, hiB, ghost_visit_retain_eq a h η ρ y hy i]
  simp_rw [hp]
  simp only [prod_mul_distrib, Fintype.prod_ite_mem, ghostVisitBatchWeight]

/-- Exact chronological transition expansion into eligible termination and
birth subsets. Even when their coefficients vanish, the valid choices remain
in the indexing sets. The test can couple every output coordinate. -/
theorem ghost_phase_transition_batches {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (a : I → Bool) (h : (i : I) → R i) (η β ρ : I → ℝ)
    (y : (i : I) → GhostPhaseState (R i)) (hy : ghostPhaseMask a y)
    (F : ((i : I) → GhostPhaseState (R i)) → ℝ) :
    (∑ x, (∏ i, ghostPhaseDampedVisit (a i) (h i) (η i) (β i) (ρ i) (x i) (y i)) * F x) =
      ∑ A ∈ (ghostVisitDeaths a h y).powerset,
        ∑ B ∈ (ghostVisitBirths a y).powerset,
          ghostVisitBatchWeight (ghostVisitDeaths a h y) A B η β ρ *
            F (ghostVisitBatchOutput h y A B) := by
  classical
  rw [ghost_phase_tensor_visit_choices]
  rw [ghost_choice_sum_subsets y (fun i => ghostPhaseEndpoint (h i) (y i))
    (fun i => ghostPhaseRetain (a i) (h i) (η i) (ρ i) (y i))
    (fun i => ghostPhaseEndpointWeight (a i) (h i) (η i) (β i) (ρ i) (y i))
    (ghostVisitDeaths a h y ∪ ghostVisitBirths a y)
    (ghost_visit_endpoint_zero_outside a h η β ρ y) F]
  rw [ghost_sum_powerset_disjoint_union _ _ (ghost_visit_eligible_disjoint a h y)]
  apply sum_congr rfl
  intro A hA
  apply sum_congr rfl
  intro B hB
  rw [ghost_visit_batch_weight_eq a h η β ρ y hy A B (mem_powerset.mp hA) (mem_powerset.mp hB),
    ghost_visit_batch_output_eq a h y A B (mem_powerset.mp hA) (mem_powerset.mp hB)]

/-- Ordering a fixed distinct birth batch gives precisely its factorial
multiplicity, even when the common continuation test or birth weights vanish. -/
theorem ghost_ordered_birth_batch {I : Type*} [DecidableEq I]
    (B : Finset I) (η β ρ : I → ℝ) (t : ℝ) :
    (∑ e : Fin (Fintype.card B) ≃ B,
      (∏ j, -β (e j).val * η (e j).val / ρ (e j).val) * t) /
        ((Fintype.card B).factorial : ℝ) =
      (∏ i ∈ B, -β i * η i / ρ i) * t := by
  classical
  have hb : (∑ e : Fin (Fintype.card B) ≃ B,
      ∏ j, -β (e j).val * η (e j).val / ρ (e j).val) /
        ((Fintype.card B).factorial : ℝ) =
      ∏ i ∈ B, -β i * η i / ρ i := by
    have he := distinct_batch_factorial_normalization (Fintype.equivFin B).symm
      (fun i : B => -β i.val * η i.val / ρ i.val)
    calc
      _ = ∏ i : B, -β i.val * η i.val / ρ i.val := by
        simpa only [Fintype.card_fin] using he
      _ = _ := prod_coe_sort B (fun i => -β i * η i / ρ i)
  rw [← sum_mul]
  calc
    _ = ((∑ e : Fin (Fintype.card B) ≃ B,
        ∏ j, -β (e j).val * η (e j).val / ρ (e j).val) /
          ((Fintype.card B).factorial : ℝ)) * t := by ring
    _ = _ := by rw [hb]

/-- Exact chronological transition formula with a termination subset and
an ordered distinct-birth batch. The sole factorial belongs to the new birth
batch; no factorial is inserted again for the existing pending memory. -/
theorem ghost_phase_transition_ordered_births {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (a : I → Bool) (h : (i : I) → R i) (η β ρ : I → ℝ)
    (y : (i : I) → GhostPhaseState (R i)) (hy : ghostPhaseMask a y)
    (F : ((i : I) → GhostPhaseState (R i)) → ℝ) :
    (∑ x, (∏ i, ghostPhaseDampedVisit (a i) (h i) (η i) (β i) (ρ i) (x i) (y i)) * F x) =
      ∑ A ∈ (ghostVisitDeaths a h y).powerset,
        ∑ B ∈ (ghostVisitBirths a y).powerset,
          ((∏ i ∈ A, -η i / ρ i) *
            (∏ i ∈ ghostVisitDeaths a h y \ A, (1 - η i) / (ρ i) ^ 2)) *
          ((∑ e : Fin (Fintype.card B) ≃ B,
            (∏ j, -β (e j).val * η (e j).val / ρ (e j).val) *
              F (ghostVisitBatchOutput h y A B)) /
            ((Fintype.card B).factorial : ℝ)) := by
  rw [ghost_phase_transition_batches a h η β ρ y hy F]
  apply sum_congr rfl
  intro A hA
  apply sum_congr rfl
  intro B hB
  rw [ghost_ordered_birth_batch]
  simp only [ghostVisitBatchWeight, mul_assoc]
end

section
open Finset
/-- The deterministic outcome, or the drop outcome when leaving an active phase. -/
def ghostPhaseEdgeBaseTarget {R : Type*} (atgt asrc : Bool)
    (w : GhostPhaseState R) : GhostPhaseState R :=
  match atgt, asrc with
  | true, _ => none
  | false, true => some (some none)
  | false, false => w

/-- The alternative outcome stores the outgoing active lifespan at its source hit. -/
def ghostPhaseEdgeStoreTarget {R : Type*} (hsrc : R) : GhostPhaseState R :=
  some (some (some hsrc))

/-- Primary edge coefficient: shared active compatibility, drop, promotion,
or deterministic retention, with every applicable rho factor. -/
noncomputable def ghostPhaseEdgeBaseWeight {R : Type*} [DecidableEq R]
    (atgt asrc : Bool) (htgt hsrc : R) (β ρtgt ρsrc : ℝ)
    (w : GhostPhaseState R) : ℝ :=
  match atgt, asrc, w with
  | true, true, none => if hsrc = htgt then 1 else 0
  | false, true, none => 1
  | true, false, some c => ghostActiveInput htgt β c * ghostPhaseDiagonal hsrc ρsrc (some c)
  | false, false, some c =>
      ghostPhaseDiagonal htgt ρtgt (some c) * ghostPhaseDiagonal hsrc ρsrc (some c)
  | _, _, _ => 0

/-- Storage is possible only from a supported active input to an inactive target. -/
noncomputable def ghostPhaseEdgeStoreWeight {R : Type*} [DecidableEq R]
    (atgt asrc : Bool) (htgt hsrc : R) (ρtgt : ℝ) (w : GhostPhaseState R) : ℝ :=
  match atgt, asrc, w with
  | false, true, none => if hsrc = htgt then ρtgt else 1
  | _, _, _ => 0

/-- The damped edge has exactly the primary and storage outcomes. Unsupported
input phases contribute zero to both coefficients. -/
theorem ghost_phase_damped_edge_sparse {R : Type*} [Fintype R] [DecidableEq R]
    (atgt asrc : Bool) (htgt hsrc : R) (β ρtgt ρsrc : ℝ)
    (z w : GhostPhaseState R) :
    ghostPhaseDampedEdge atgt asrc htgt hsrc β ρtgt ρsrc z w =
      ghostPhaseEdgeBaseWeight atgt asrc htgt hsrc β ρtgt ρsrc w *
        (if z = ghostPhaseEdgeBaseTarget atgt asrc w then 1 else 0) +
      ghostPhaseEdgeStoreWeight atgt asrc htgt hsrc ρtgt w *
        (if z = ghostPhaseEdgeStoreTarget hsrc then 1 else 0) := by
  cases atgt <;> cases asrc <;>
    rcases z with _ | (_ | (_ | r)) <;> rcases w with _ | (_ | (_ | s)) <;>
      simp [ghostPhaseDampedEdge, ghostPhaseEdge, ghostPhaseGather, ghostPhaseScatter,
        ghostActiveInput, ghostActiveOutput, ghostPhaseDiagonal,
        ghostPhaseEdgeBaseWeight, ghostPhaseEdgeStoreWeight,
        ghostPhaseEdgeBaseTarget, ghostPhaseEdgeStoreTarget]
  all_goals split <;> simp_all

/-- A storage coefficient can be nonzero only at an actual active-to-inactive edge. -/
theorem ghost_phase_edge_store_supported {R : Type*} [DecidableEq R]
    (atgt asrc : Bool) (htgt hsrc : R) (ρtgt : ℝ) (w : GhostPhaseState R)
    (hn : ghostPhaseEdgeStoreWeight atgt asrc htgt hsrc ρtgt w ≠ 0) :
    atgt = false ∧ asrc = true ∧ w = none := by
  cases atgt <;> cases asrc <;> cases w <;> simp_all [ghostPhaseEdgeStoreWeight]

/-- Incompatible source phases annihilate both local outcome coefficients. -/
theorem ghost_phase_edge_outcomes_invalid {R : Type*} [DecidableEq R]
    (atgt asrc : Bool) (htgt hsrc : R) (β ρtgt ρsrc : ℝ)
    (w : GhostPhaseState R) (hw : w.isSome ≠ !asrc) :
    ghostPhaseEdgeBaseWeight atgt asrc htgt hsrc β ρtgt ρsrc w = 0 ∧
      ghostPhaseEdgeStoreWeight atgt asrc htgt hsrc ρtgt w = 0 := by
  cases atgt <;> cases asrc <;> cases w <;>
    simp_all [ghostPhaseEdgeBaseWeight, ghostPhaseEdgeStoreWeight]

/-- The local fixed-input action retains an arbitrary test function. -/
theorem ghost_phase_edge_action_expansion {R : Type*} [Fintype R] [DecidableEq R]
    (atgt asrc : Bool) (htgt hsrc : R) (β ρtgt ρsrc : ℝ)
    (w : GhostPhaseState R) (F : GhostPhaseState R → ℝ) :
    (∑ z, ghostPhaseDampedEdge atgt asrc htgt hsrc β ρtgt ρsrc z w * F z) =
      ghostPhaseEdgeBaseWeight atgt asrc htgt hsrc β ρtgt ρsrc w *
        F (ghostPhaseEdgeBaseTarget atgt asrc w) +
      ghostPhaseEdgeStoreWeight atgt asrc htgt hsrc ρtgt w *
        F (ghostPhaseEdgeStoreTarget hsrc) := by
  simp_rw [ghost_phase_damped_edge_sparse]
  simp [add_mul, sum_add_distrib, mul_ite, ite_mul]

/-- For fixed physical labels and fixed input memory, the full tensor edge acts
by a sum over storage choices. The test function may couple all prime coordinates. -/
theorem ghost_phase_tensor_edge_action_expansion {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (atgt asrc : I → Bool) (htgt hsrc : (i : I) → R i) (β ρtgt ρsrc : I → ℝ)
    (w : (i : I) → GhostPhaseState (R i))
    (F : ((i : I) → GhostPhaseState (R i)) → ℝ) :
    (∑ z : (i : I) → GhostPhaseState (R i),
      (∏ i, ghostPhaseDampedEdge (atgt i) (asrc i) (htgt i) (hsrc i)
        (β i) (ρtgt i) (ρsrc i) (z i) (w i)) * F z) =
      ∑ c : I → Bool,
        (∏ i, if c i then ghostPhaseEdgeStoreWeight (atgt i) (asrc i) (htgt i) (hsrc i)
            (ρtgt i) (w i)
          else ghostPhaseEdgeBaseWeight (atgt i) (asrc i) (htgt i) (hsrc i)
            (β i) (ρtgt i) (ρsrc i) (w i)) *
        F (fun i => if c i then ghostPhaseEdgeStoreTarget (hsrc i)
          else ghostPhaseEdgeBaseTarget (atgt i) (asrc i) (w i)) := by
  simp_rw [ghost_phase_damped_edge_sparse]
  exact finite_binary_kernel_expansion
    (fun i => ghostPhaseEdgeBaseTarget (atgt i) (asrc i) (w i))
    (fun i => ghostPhaseEdgeStoreTarget (hsrc i))
    (fun i => ghostPhaseEdgeBaseWeight (atgt i) (asrc i) (htgt i) (hsrc i)
      (β i) (ρtgt i) (ρsrc i) (w i))
    (fun i => ghostPhaseEdgeStoreWeight (atgt i) (asrc i) (htgt i) (hsrc i)
      (ρtgt i) (w i)) F

/-- Every nonzero tensor choice stores only coordinates leaving an active source. -/
theorem ghost_phase_tensor_storage_supported {I : Type*} [Fintype I]
    {R : I → Type*} [∀ i, DecidableEq (R i)]
    (atgt asrc : I → Bool) (htgt hsrc : (i : I) → R i) (β ρtgt ρsrc : I → ℝ)
    (w : (i : I) → GhostPhaseState (R i)) (c : I → Bool)
    (hn : (∏ i, if c i then ghostPhaseEdgeStoreWeight (atgt i) (asrc i) (htgt i) (hsrc i)
        (ρtgt i) (w i)
      else ghostPhaseEdgeBaseWeight (atgt i) (asrc i) (htgt i) (hsrc i)
        (β i) (ρtgt i) (ρsrc i) (w i)) ≠ 0) (i : I) (hc : c i = true) :
    atgt i = false ∧ asrc i = true ∧ w i = none := by
  have hi := (prod_ne_zero_iff.mp hn) i (mem_univ i)
  simp only [hc, ↓reduceIte] at hi
  exact ghost_phase_edge_store_supported _ _ _ _ _ _ hi
end

section
open Finset
/-- Choose the old index of each required target label. Distinct target labels
make this map injective even before uniqueness of the old labels is used. -/
noncomputable def distinctPromotionEmbedding {S J P : Type*}
    (f : J → P) (t : S → P) (ht : Function.Injective t)
    (hin : ∀ s, ∃ j, f j = t s) : S ↪ J where
  toFun s := Classical.choose (hin s)
  inj' := by
    intro s r hsr
    apply ht
    exact (Classical.choose_spec (hin s)).symm.trans
      ((congrArg f hsr).trans (Classical.choose_spec (hin r)))

theorem distinct_promotion_embedding_spec {S J P : Type*}
    (f : J → P) (t : S → P) (ht : Function.Injective t)
    (hin : ∀ s, ∃ j, f j = t s) (s : S) :
    f (distinctPromotionEmbedding f t ht hin s) = t s :=
  Classical.choose_spec (hin s)

/-- Distinct old labels force every matching injection to be the chosen one. -/
theorem distinct_promotion_embedding_unique {S J P : Type*}
    (f : J → P) (t : S → P) (hf : Function.Injective f) (ht : Function.Injective t)
    (hin : ∀ s, ∃ j, f j = t s) (e : S ↪ J)
    (he : ∀ s, f (e s) = t s) : e = distinctPromotionEmbedding f t ht hin := by
  ext s
  exact hf ((he s).trans (distinct_promotion_embedding_spec f t ht hin s).symm)

theorem existsUnique_distinct_promotion_embedding {S J P : Type*}
    (f : J → P) (t : S → P) (hf : Function.Injective f) (ht : Function.Injective t)
    (hin : ∀ s, ∃ j, f j = t s) :
    ∃! e : S ↪ J, ∀ s, f (e s) = t s := by
  refine ⟨distinctPromotionEmbedding f t ht hin,
    distinct_promotion_embedding_spec f t ht hin, ?_⟩
  intro e he
  exact distinct_promotion_embedding_unique f t hf ht hin e he

/-- All injections of the selected ordered slots whose labels match. -/
noncomputable def matchingPromotionEmbeddings {S J P : Type*}
    [Fintype S] [Fintype J] (f : J → P) (t : S → P) : Finset (S ↪ J) := by
  classical
  exact univ.filter (fun e => ∀ s, f (e s) = t s)

theorem matching_promotion_embeddings_eq_singleton {S J P : Type*}
    [Fintype S] [Fintype J]
    (f : J → P) (t : S → P) (hf : Function.Injective f) (ht : Function.Injective t)
    (hin : ∀ s, ∃ j, f j = t s) :
    matchingPromotionEmbeddings f t = {distinctPromotionEmbedding f t ht hin} := by
  classical
  ext e
  simp only [matchingPromotionEmbeddings, mem_filter, mem_univ, true_and, mem_singleton]
  constructor
  · exact distinct_promotion_embedding_unique f t hf ht hin e
  · intro he
    rw [he]
    exact distinct_promotion_embedding_spec f t ht hin

/-- The ordered matching choices have cardinality one, not a factorial. -/
theorem matching_promotion_embeddings_card {S J P : Type*}
    [Fintype S] [Fintype J]
    (f : J → P) (t : S → P) (hf : Function.Injective f) (ht : Function.Injective t)
    (hin : ∀ s, ∃ j, f j = t s) :
    (matchingPromotionEmbeddings f t).card = 1 := by
  rw [matching_promotion_embeddings_eq_singleton f t hf ht hin]
  exact card_singleton _

/-- Any coupled test of the promotion injection sums to its single matching
value. No division by the number or factorial of selected slots is present. -/
theorem sum_matching_promotion_embeddings {S J P M : Type*}
    [Fintype S] [Fintype J] [AddCommMonoid M]
    (f : J → P) (t : S → P) (hf : Function.Injective f) (ht : Function.Injective t)
    (hin : ∀ s, ∃ j, f j = t s) (F : (S ↪ J) → M) :
    (∑ e ∈ matchingPromotionEmbeddings f t, F e) =
      F (distinctPromotionEmbedding f t ht hin) := by
  rw [matching_promotion_embeddings_eq_singleton f t hf ht hin, sum_singleton]

/-- Removing the matching old indices removes exactly the required labels. -/
theorem distinct_promotion_remaining_labels {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq J] [DecidableEq P]
    (f : J → P) (t : S → P) (hf : Function.Injective f) (ht : Function.Injective t)
    (hin : ∀ s, ∃ j, f j = t s) :
    (univ \ univ.image (distinctPromotionEmbedding f t ht hin)).image f =
      univ.image f \ univ.image t := by
  rw [image_sdiff _ _ hf, image_image]
  congr 1
  apply image_congr
  intro s _
  exact distinct_promotion_embedding_spec f t ht hin s

/-- A coupled function of promoted labels and the remaining numerical
support also has one contribution, with the support reconstructed exactly. -/
theorem sum_matching_promotion_labels_remaining {S J P M : Type*}
    [Fintype S] [Fintype J] [DecidableEq J] [DecidableEq P] [AddCommMonoid M]
    (f : J → P) (t : S → P) (hf : Function.Injective f) (ht : Function.Injective t)
    (hin : ∀ s, ∃ j, f j = t s) (F : (S → P) → Finset P → M) :
    (∑ e ∈ matchingPromotionEmbeddings f t,
      F (fun s => f (e s)) ((univ \ univ.image e).image f)) =
      F t (univ.image f \ univ.image t) := by
  rw [sum_matching_promotion_embeddings f t hf ht hin]
  rw [distinct_promotion_remaining_labels f t hf ht hin]
  congr 1
  funext s
  exact distinct_promotion_embedding_spec f t ht hin s

/-- If fresh labels are disjoint from the old labels, even an injection
into old-or-fresh indices that matches the target labels must use the unique
old matching injection throughout. -/
theorem matching_promotion_uses_old_indices {S J K P : Type*}
    (f : J → P) (g : K → P) (t : S → P)
    (hf : Function.Injective f) (ht : Function.Injective t)
    (hin : ∀ s, ∃ j, f j = t s) (hdis : ∀ j k, f j ≠ g k)
    (e : S ↪ J ⊕ K) (he : ∀ s, Sum.elim f g (e s) = t s) :
    e = (distinctPromotionEmbedding f t ht hin).trans Function.Embedding.inl := by
  ext s
  change e s = Sum.inl (distinctPromotionEmbedding f t ht hin s)
  cases hes : e s with
  | inl j =>
    apply congrArg Sum.inl
    apply hf
    have hj : f j = t s := by simpa only [hes, Sum.elim_inl] using he s
    exact hj.trans (distinct_promotion_embedding_spec f t ht hin s).symm
  | inr k =>
    obtain ⟨j, hj⟩ := hin s
    have hk : g k = t s := by simpa only [hes, Sum.elim_inr] using he s
    exact (hdis j k (hj.trans hk.symm)).elim
end

section
open Finset Classical
noncomputable def birthForestAffectedOperations {n : ℕ} {Op : Type*}
    (code : BirthForestCode n) (operation : Fin n → Op) : Finset Op :=
  (birthForestTouched code).image operation

theorem birthForestAffectedOperations_card_le {n : ℕ} {Op : Type*}
    (code : BirthForestCode n) (operation : Fin n → Op) :
    (birthForestAffectedOperations code operation).card ≤ 2 * birthForestRank code :=
  card_image_le.trans (birthForestTouched_card_le code)

/-- The full multiplier local to an operation includes both the performed
birth tests and the Fourier phases. -/
noncomputable def birthForestOperationMultiplier {n : ℕ} {Op : Type*}
    (code : BirthForestCode n) (operation : Fin n → Op)
    (θ : (Fin n × Fin n) → ℝ) (performed : Fin n → Prop)
    (f : Fin n → ℤ) (o : Op) : ℂ :=
  ∏ j ∈ univ.filter (fun j => operation j = o),
    if j ∈ birthForestTouched code → performed j then
      physicalReturnPhase (birthForestLocalFrequency code θ j) (f j) else 0

theorem birthForestOperationMultiplier_norm_le_one {n : ℕ} {Op : Type*}
    (code : BirthForestCode n) (operation : Fin n → Op)
    (θ : (Fin n × Fin n) → ℝ) (performed : Fin n → Prop)
    (f : Fin n → ℤ) (o : Op) :
    ‖birthForestOperationMultiplier code operation θ performed f o‖ ≤ 1 := by
  unfold birthForestOperationMultiplier
  rw [norm_prod]
  apply prod_le_one₀ (fun j _ => norm_nonneg _)
  intro j _
  split_ifs
  · rw [physicalReturnPhase_norm]
  · simp

/-- An operation with no touched birth is exactly unchanged. -/
theorem birthForestOperationMultiplier_eq_one {n : ℕ} {Op : Type*}
    (code : BirthForestCode n) (operation : Fin n → Op)
    (θ : (Fin n × Fin n) → ℝ) (performed : Fin n → Prop)
    (f : Fin n → ℤ) (o : Op)
    (ho : o ∉ birthForestAffectedOperations code operation) :
    birthForestOperationMultiplier code operation θ performed f o = 1 := by
  apply prod_eq_one
  intro j hj
  have heq : operation j = o := (mem_filter.mp hj).2
  have hjnot : j ∉ birthForestTouched code := by
    intro h
    exact ho (mem_image.mpr ⟨j, h, heq⟩)
  rw [if_pos (fun h => False.elim (hjnot h))]
  exact birth_forest_phase_eq_one_of_not_touched code θ f j hjnot

/-- Grouping by operation preserves the exact full performed-and-phase
multiplier on a path. This identity does not assert operator contractivity. -/
theorem birthForestOperationMultiplier_product {n : ℕ} {Op : Type*} [Fintype Op]
    (code : BirthForestCode n) (operation : Fin n → Op)
    (θ : (Fin n × Fin n) → ℝ) (performed : Fin n → Prop)
    (f : Fin n → ℤ) :
    (∏ o : Op, birthForestOperationMultiplier code operation θ performed f o) =
      if ∀ j ∈ birthForestTouched code, performed j then
        ∏ j : Fin n, physicalReturnPhase (birthForestLocalFrequency code θ j) (f j) else 0 := by
  classical
  unfold birthForestOperationMultiplier
  rw [prod_fiberwise univ operation (fun j =>
    if j ∈ birthForestTouched code → performed j then
      physicalReturnPhase (birthForestLocalFrequency code θ j) (f j) else 0)]
  rw [Fintype.prod_ite_zero]
  split_ifs <;> rfl

/-- Performed constraints at all edge endpoints are exactly the performed
constraints at the union of touched birth addresses. -/
theorem birthForestTouched_performed_iff {n : ℕ}
    (code : BirthForestCode n) (performed : Fin n → Prop) :
    (∀ j ∈ birthForestTouched code, performed j) ↔
      ∀ e ∈ birthForestEdges code, performed e.1 ∧ performed e.2 := by
  constructor
  · intro h e he
    exact ⟨h e.1 (mem_union.mpr (Or.inl (mem_image.mpr ⟨e, he, rfl⟩))),
      h e.2 (mem_union.mpr (Or.inr (mem_image.mpr ⟨e, he, rfl⟩)))⟩
  · intro h j hj
    rcases mem_union.mp hj with hj | hj
    · obtain ⟨e, he, rfl⟩ := mem_image.mp hj
      exact (h e he).1
    · obtain ⟨e, he, rfl⟩ := mem_image.mp hj
      exact (h e he).2
end

section
open Finset Classical
noncomputable def causalBirthProductMass {n : ℕ} {α : Type*} [Fintype α]
    (w : BirthForestCausalWeights n α) : ℝ :=
  ∑ f : Fin n → α, ∏ j, w j (birthForestHistory f j) (f j)

/-- Exact splitting of a causal product at its last coordinate. -/
theorem causalBirthProduct_snoc {n : ℕ} {α : Type*}
    (w : BirthForestCausalWeights (n + 1) α) (f : Fin n → α) (a : α) :
    (∏ j, w j (birthForestHistory (Fin.snoc f a) j) ((Fin.snoc f a : Fin (n + 1) → α) j)) =
      (∏ j : Fin n, w j.castSucc (birthForestHistory f j) (f j)) * w (Fin.last n) f a := by
  rw [Fin.prod_univ_castSucc]
  simp_rw [birthForestHistory_snoc_castSucc, Fin.snoc_castSucc,
    birthForestHistory_snoc_last, Fin.snoc_last]

theorem causalBirthProductMass_last {n : ℕ} {α : Type*} [Fintype α]
    (w : BirthForestCausalWeights (n + 1) α) :
    causalBirthProductMass w =
      ∑ f : Fin n → α, (∏ j : Fin n, w j.castSucc (birthForestHistory f j) (f j)) *
        ∑ a, w (Fin.last n) f a := by
  unfold causalBirthProductMass
  rw [← (Fin.snocEquiv (fun _ : Fin (n + 1) => α)).sum_comp,
    Fintype.sum_prod_type, sum_comm]
  change (∑ f : Fin n → α, ∑ a : α,
    ∏ j, w j (birthForestHistory (Fin.snoc f a) j) ((Fin.snoc f a : Fin (n + 1) → α) j)) = _
  simp_rw [causalBirthProduct_snoc, ← mul_sum]

/-- Uniform conditional sum bounds multiply even when each local weight
depends on all earlier values. The bound may vary with the coordinate. -/
theorem causalBirthProductMass_le {n : ℕ} {α : Type*} [Fintype α]
    (w : BirthForestCausalWeights n α) (b : Fin n → ℝ)
    (hw : ∀ j h a, 0 ≤ w j h a) (hb : ∀ j, 0 ≤ b j)
    (hsum : ∀ j h, (∑ a, w j h a) ≤ b j) :
    causalBirthProductMass w ≤ ∏ j, b j := by
  induction n with
  | zero => simp [causalBirthProductMass]
  | succ n ih =>
    have hprev := ih (fun j => w j.castSucc) (fun j => b j.castSucc)
      (fun j h a => hw j.castSucc h a) (fun j => hb j.castSucc)
      (fun j h => hsum j.castSucc h)
    rw [causalBirthProductMass_last, Fin.prod_univ_castSucc]
    calc
      (∑ f : Fin n → α, (∏ j : Fin n, w j.castSucc (birthForestHistory f j) (f j)) *
          ∑ a, w (Fin.last n) f a) ≤
        ∑ f : Fin n → α, (∏ j : Fin n, w j.castSucc (birthForestHistory f j) (f j)) *
          b (Fin.last n) := by
        apply sum_le_sum
        intro f hf
        exact mul_le_mul_of_nonneg_left (hsum _ _) (prod_nonneg fun j hj => hw _ _ _)
      _ = causalBirthProductMass (fun j => w j.castSucc) * b (Fin.last n) :=
        (sum_mul _ _ _).symm
      _ ≤ (∏ j : Fin n, b j.castSucc) * b (Fin.last n) :=
        mul_le_mul_of_nonneg_right hprev (hb _)

/-- A prescribed pin may refer to an external value or any function of the past. -/
abbrev CausalBirthPinTargets (n : ℕ) (α : Type*) :=
  ∀ j : Fin n, (Fin j.val → α) → α

noncomputable def causalPinnedBirthWeights {n : ℕ} {α : Type*}
    (pins : Finset (Fin n)) (target : CausalBirthPinTargets n α)
    (w : BirthForestCausalWeights n α) : BirthForestCausalWeights n α :=
  fun j h a => if j ∈ pins → a = target j h then w j h a else 0

noncomputable def orderedCausalPinnedBirthMass {n : ℕ} {α : Type*} [Fintype α]
    (w : BirthForestCausalWeights n α) (pins : Finset (Fin n))
    (target : CausalBirthPinTargets n α) : ℝ :=
  ∑ f : Fin n → α with ∀ j ∈ pins, f j = target j (birthForestHistory f j),
    ∏ j, w j (birthForestHistory f j) (f j)

/-- Gating each pinned coordinate is exactly the global causal pin constraint. -/
theorem orderedCausalPinnedBirthMass_eq {n : ℕ} {α : Type*} [Fintype α]
    (w : BirthForestCausalWeights n α) (pins : Finset (Fin n))
    (target : CausalBirthPinTargets n α) :
    orderedCausalPinnedBirthMass w pins target =
      causalBirthProductMass (causalPinnedBirthWeights pins target w) := by
  unfold orderedCausalPinnedBirthMass causalBirthProductMass causalPinnedBirthWeights
  rw [sum_filter]
  apply sum_congr rfl
  intro f hf
  rw [Fintype.prod_ite_zero]
  split_ifs <;> rfl

/-- Each fixed pinned coordinate pays one conditional atom bound, even when
its target is a function of earlier values within the same ordered batch. -/
theorem orderedCausalPinnedBirthMass_le {n : ℕ} {α : Type*} [Fintype α]
    (w : BirthForestCausalWeights n α) (pins : Finset (Fin n))
    (target : CausalBirthPinTargets n α)
    {M ε : ℝ} (hM : 0 ≤ M) (hε : 0 ≤ ε)
    (hw : ∀ j h a, 0 ≤ w j h a)
    (hsum : ∀ j h, (∑ a, w j h a) ≤ M) (hatom : ∀ j h a, w j h a ≤ ε) :
    orderedCausalPinnedBirthMass w pins target ≤ ε ^ pins.card * M ^ (n - pins.card) := by
  rw [orderedCausalPinnedBirthMass_eq]
  calc
    causalBirthProductMass (causalPinnedBirthWeights pins target w) ≤
        ∏ j : Fin n, if j ∈ pins then ε else M := by
      apply causalBirthProductMass_le
      · intro j h a
        unfold causalPinnedBirthWeights
        split_ifs
        · exact hw _ _ _
        · exact le_rfl
      · intro j
        split_ifs
        · exact hε
        · exact hM
      · intro j h
        by_cases hj : j ∈ pins
        · simpa [causalPinnedBirthWeights, hj] using hatom j h (target j h)
        · simpa [causalPinnedBirthWeights, hj] using hsum j h
    _ = ε ^ pins.card * M ^ (n - pins.card) := by
      rw [prod_ite]
      simp [filter_not, card_sdiff]

/-- Factorial summation remains uniform in the batch cutoff for causal pin
targets and causal weights. Pins are prescribed, so no binomial factor occurs. -/
theorem ordered_causal_pinned_birth_batches_le {α : Type*} [Fintype α]
    (B d : ℕ) (w : ∀ n, BirthForestCausalWeights n α)
    (pins : ∀ n, Finset (Fin n)) (target : ∀ n, CausalBirthPinTargets n α)
    {c M ε : ℝ} (hc : 0 ≤ c) (hM : 0 ≤ M) (hε : 0 ≤ ε)
    (hw : ∀ n j h a, 0 ≤ w n j h a)
    (hsum : ∀ n j h, (∑ a, w n j h a) ≤ M)
    (hatom : ∀ n j h a, w n j h a ≤ ε)
    (hcard : ∀ n ∈ Ico d (B + 1), (pins n).card = d) :
    (∑ n ∈ Ico d (B + 1),
      c ^ n * orderedCausalPinnedBirthMass (w n) (pins n) (target n) / (n.factorial : ℝ)) ≤
        (c * ε) ^ d * Real.exp (c * M) := by
  apply le_trans _ (ordered_pinned_batch_sum_le_exp B d hc hM hε)
  apply sum_le_sum
  intro n hn
  apply div_le_div_of_nonneg_right _ (by positivity)
  apply mul_le_mul_of_nonneg_left _ (pow_nonneg hc n)
  simpa only [hcard n hn] using
    orderedCausalPinnedBirthMass_le (w n) (pins n) (target n) hM hε (hw n) (hsum n) (hatom n)
end

section
open Finset Classical
/-- An ordered product in a normed ring is bounded by the commutative product
of its scalar norms. No commutativity of the operator ring is assumed. -/
theorem norm_ordered_fin_product_le {R : Type*} [NormedRing R] [NormOneClass R]
    {N : ℕ} (E : Fin N → R) :
    ‖(List.ofFn E).prod‖ ≤ ∏ j, ‖E j‖ := by
  simpa only [List.map_ofFn, List.prod_ofFn, Function.comp_def] using
    List.norm_prod_le (List.ofFn E)

/-- The exact scalar cost of using A on a finite set of bad edges and q
elsewhere, written as the baseline q^N times the relative loss per bad edge. -/
theorem edge_scalar_product_eq {N : ℕ} (bad : Finset (Fin N)) {q A : ℝ} (hq : q ≠ 0) :
    (∏ j : Fin N, if j ∈ bad then A else q) = q ^ N * (A / q) ^ bad.card := by
  have hp (j : Fin N) : (if j ∈ bad then A else q) =
      q * (if j ∈ bad then A / q else 1) := by
    split_ifs <;> field_simp
  simp_rw [hp]
  rw [prod_mul_distrib, prod_ite]
  simp [div_pow]

/-- Scalar edge bound retaining the exact number of affected edges. -/
theorem edge_norm_product_le {R : Type*} [NormedRing R] {N : ℕ}
    (E : Fin N → R) (bad : Finset (Fin N)) {q A : ℝ} (hq : 0 < q)
    (hE : ∀ j, ‖E j‖ ≤ if j ∈ bad then A else q) :
    (∏ j, ‖E j‖) ≤ q ^ N * (A / q) ^ bad.card := by
  rw [← edge_scalar_product_eq bad hq.ne']
  exact prod_le_prod₀ (fun j _ => norm_nonneg _) (fun j _ => hE j)

/-- Increasing the bad-edge count is safe when the exceptional bound A
is at least the ordinary contraction bound q. -/
theorem edge_norm_product_le_rank {R : Type*} [NormedRing R] {N : ℕ}
    (E : Fin N → R) (bad : Finset (Fin N)) (r : ℕ)
    {q A : ℝ} (hq : 0 < q) (hA : q ≤ A) (hbad : bad.card ≤ 2 * r)
    (hE : ∀ j, ‖E j‖ ≤ if j ∈ bad then A else q) :
    (∏ j, ‖E j‖) ≤ q ^ N * (A / q) ^ (2 * r) := by
  apply (edge_norm_product_le E bad hq hE).trans
  apply mul_le_mul_of_nonneg_left _ (pow_nonneg hq.le N)
  exact pow_le_pow_right₀ ((le_div_iff₀ hq).mpr (by simpa only [one_mul] using hA)) hbad

/-- Interleaving visit operators and edge operators in increasing time:
G₀ E₀ G₁ E₁ ... E_(N-1) G_N. The list product preserves this exact order. -/
theorem norm_interleaved_birth_product_le {R : Type*} [NormedRing R] [NormOneClass R]
    {N : ℕ} (E : Fin N → R) (G : Fin (N + 1) → R)
    {M : ℝ} (hM : 0 ≤ M) (hG : ∀ j, ‖G j‖ ≤ M) :
    ‖G 0 * (List.ofFn (fun j : Fin N => E j * G j.succ)).prod‖ ≤
      M ^ (N + 1) * ∏ j, ‖E j‖ := by
  have hp : (∏ j : Fin N, ‖E j * G j.succ‖) ≤ ∏ j : Fin N, ‖E j‖ * M := by
    apply prod_le_prod₀ (fun j _ => norm_nonneg _)
    intro j hj
    exact (norm_mul_le _ _).trans (mul_le_mul_of_nonneg_left (hG _) (norm_nonneg _))
  calc
    ‖G 0 * (List.ofFn (fun j : Fin N => E j * G j.succ)).prod‖ ≤
        ‖G 0‖ * ‖(List.ofFn (fun j : Fin N => E j * G j.succ)).prod‖ := norm_mul_le _ _
    _ ≤ ‖G 0‖ * ∏ j : Fin N, ‖E j * G j.succ‖ :=
      mul_le_mul_of_nonneg_left (norm_ordered_fin_product_le _) (norm_nonneg _)
    _ ≤ ‖G 0‖ * ∏ j : Fin N, ‖E j‖ * M :=
      mul_le_mul_of_nonneg_left hp (norm_nonneg _)
    _ ≤ M * ∏ j : Fin N, ‖E j‖ * M :=
      mul_le_mul_of_nonneg_right (hG 0) (prod_nonneg fun j _ => mul_nonneg (norm_nonneg _) hM)
    _ = M ^ (N + 1) * ∏ j, ‖E j‖ := by
      rw [prod_mul_distrib]
      simp only [prod_const, card_univ, Fintype.card_fin, pow_succ]
      ring

/-- At most 2r exceptional edges lose their ordinary signed contraction. -/
theorem norm_low_rank_birth_product_le {R : Type*} [NormedRing R] [NormOneClass R]
    {N : ℕ} (E : Fin N → R) (G : Fin (N + 1) → R)
    (bad : Finset (Fin N)) (r : ℕ) {q A M : ℝ}
    (hq : 0 < q) (hA : q ≤ A) (hM : 0 ≤ M) (hbad : bad.card ≤ 2 * r)
    (hG : ∀ j, ‖G j‖ ≤ M) (hE : ∀ j, ‖E j‖ ≤ if j ∈ bad then A else q) :
    ‖G 0 * (List.ofFn (fun j : Fin N => E j * G j.succ)).prod‖ ≤
      M ^ (N + 1) * q ^ N * (A / q) ^ (2 * r) := by
  apply (norm_interleaved_birth_product_le E G hM hG).trans
  simpa only [mul_assoc] using
    mul_le_mul_of_nonneg_left (edge_norm_product_le_rank E bad r hq hA hbad hE)
      (pow_nonneg hM (N + 1))

/-- Deduplicated affected edge indices. `none` allows initial or ghost births
to have no edge index, and several birth addresses may map to one edge. -/
noncomputable def birthForestAffectedEdges {n N : ℕ} (code : BirthForestCode n)
    (edgeOf : Fin n → Option (Fin N)) : Finset (Fin N) :=
  (birthForestTouched code).biUnion (fun j => (edgeOf j).toFinset)

theorem mem_birthForestAffectedEdges {n N : ℕ} (code : BirthForestCode n)
    (edgeOf : Fin n → Option (Fin N)) (e : Fin N) :
    e ∈ birthForestAffectedEdges code edgeOf ↔
      ∃ j ∈ birthForestTouched code, edgeOf j = some e := by
  simp [birthForestAffectedEdges, Option.mem_toFinset]

/-- Edge losses are counted by touched births, even when local phase
frequencies cancel and only the performed-birth restriction remains. -/
theorem birthForestAffectedEdges_card_le {n N : ℕ} (code : BirthForestCode n)
    (edgeOf : Fin n → Option (Fin N)) :
    (birthForestAffectedEdges code edgeOf).card ≤ 2 * birthForestRank code := by
  apply le_trans _ (birthForestTouched_card_le code)
  calc
    (birthForestAffectedEdges code edgeOf).card ≤
        ∑ j ∈ birthForestTouched code, ((edgeOf j).toFinset).card := card_biUnion_le
    _ ≤ ∑ _j ∈ birthForestTouched code, 1 := by
      apply sum_le_sum
      intro j hj
      cases edgeOf j <;> simp
    _ = (birthForestTouched code).card := by simp

/-- Low-rank propagation using the actual touched-address edge image. -/
theorem birthForest_low_rank_product_le {R : Type*} [NormedRing R] [NormOneClass R]
    {n N : ℕ} (code : BirthForestCode n) (edgeOf : Fin n → Option (Fin N))
    (E : Fin N → R) (G : Fin (N + 1) → R) {q A M : ℝ}
    (hq : 0 < q) (hA : q ≤ A) (hM : 0 ≤ M)
    (hG : ∀ j, ‖G j‖ ≤ M)
    (hE : ∀ j, ‖E j‖ ≤ if j ∈ birthForestAffectedEdges code edgeOf then A else q) :
    ‖G 0 * (List.ofFn (fun j : Fin N => E j * G j.succ)).prod‖ ≤
      M ^ (N + 1) * q ^ N * (A / q) ^ (2 * birthForestRank code) :=
  norm_low_rank_birth_product_le E G (birthForestAffectedEdges code edgeOf) _ hq hA hM
    (birthForestAffectedEdges_card_le code edgeOf) hG hE
end

section
open Finset Classical MeasureTheory
noncomputable def birthFourierIntervalMeasure : Measure ℝ :=
  volume.restrict (Set.Ioc (0 : ℝ) 1)

theorem birthFourierIntervalMeasure_probability :
    IsProbabilityMeasure birthFourierIntervalMeasure := by
  constructor
  simp [birthFourierIntervalMeasure]

noncomputable def birthFourierCubeMeasure (ι : Type*) [Fintype ι] : Measure (ι → ℝ) :=
  Measure.pi (fun _ : ι => birthFourierIntervalMeasure)

theorem birthFourierCubeMeasure_probability (ι : Type*) [Fintype ι] :
    IsProbabilityMeasure (birthFourierCubeMeasure ι) := by
  let _ : IsProbabilityMeasure birthFourierIntervalMeasure := birthFourierIntervalMeasure_probability
  unfold birthFourierCubeMeasure
  infer_instance

theorem birth_fourier_interval_phase_integrable (h : ℤ) :
    Integrable (fun t => physicalReturnPhase t h) birthFourierIntervalMeasure := by
  exact (intervalIntegrable_iff_integrableOn_Ioc_of_le (by norm_num : (0 : ℝ) ≤ 1)).mp
    (physicalReturnPhase_intervalIntegrable h 0 1)

theorem birth_fourier_interval_phase_integral (h : ℤ) :
    (∫ t, physicalReturnPhase t h ∂birthFourierIntervalMeasure) = if h = 0 then 1 else 0 := by
  change (∫ t in Set.Ioc (0 : ℝ) 1, physicalReturnPhase t h) = _
  rw [← intervalIntegral.integral_of_le (by norm_num : (0 : ℝ) ≤ 1), physicalReturnPhase_integral]

theorem birth_fourier_cube_phase_integrable {ι : Type*} [Fintype ι] (h : ι → ℤ) :
    Integrable (fun θ : ι → ℝ => ∏ i, physicalReturnPhase (θ i) (h i))
      (birthFourierCubeMeasure ι) := by
  let _ : IsProbabilityMeasure birthFourierIntervalMeasure := birthFourierIntervalMeasure_probability
  exact Integrable.fintype_prod (fun i => birth_fourier_interval_phase_integrable (h i))

theorem birth_fourier_cube_phase_integral {ι : Type*} [Fintype ι] (h : ι → ℤ) :
    (∫ θ : ι → ℝ, ∏ i, physicalReturnPhase (θ i) (h i) ∂birthFourierCubeMeasure ι) =
      if ∀ i, h i = 0 then 1 else 0 := by
  let _ : IsProbabilityMeasure birthFourierIntervalMeasure := birthFourierIntervalMeasure_probability
  unfold birthFourierCubeMeasure
  rw [integral_fintype_prod_eq_prod (fun (i : ι) (t : ℝ) => physicalReturnPhase t (h i))]
  simp_rw [birth_fourier_interval_phase_integral]
  exact Fintype.prod_boole

/-- Product Fourier integration extracts simultaneous integer equalities
from any finite complex path sum. -/
theorem birth_fourier_finite_sum_integral {Ω ι : Type*} [Fintype ι]
    (paths : Finset Ω) (w : Ω → ℂ) (h : Ω → ι → ℤ) :
    (∫ θ : ι → ℝ, ∑ ω ∈ paths, w ω * ∏ i, physicalReturnPhase (θ i) (h ω i)
      ∂birthFourierCubeMeasure ι) =
      ∑ ω ∈ paths, if ∀ i, h ω i = 0 then w ω else 0 := by
  rw [integral_finsetSum]
  · apply sum_congr rfl
    intro ω _
    rw [integral_const_mul, birth_fourier_cube_phase_integral]
    split_ifs <;> simp
  · intro ω _
    exact (birth_fourier_cube_phase_integrable (h ω)).const_mul (w ω)

/-- A uniform bound on a finite Fourier sum passes to its simultaneous
zero-frequency coefficient with no loss. -/
theorem birth_fourier_finite_sum_bound {Ω ι : Type*} [Fintype ι]
    (paths : Finset Ω) (w : Ω → ℂ) (h : Ω → ι → ℤ) {B : ℝ}
    (hB : ∀ θ : ι → ℝ,
      ‖∑ ω ∈ paths, w ω * ∏ i, physicalReturnPhase (θ i) (h ω i)‖ ≤ B) :
    ‖∑ ω ∈ paths, if ∀ i, h ω i = 0 then w ω else 0‖ ≤ B := by
  let _ : IsProbabilityMeasure (birthFourierCubeMeasure ι) := birthFourierCubeMeasure_probability ι
  rw [← birth_fourier_finite_sum_integral paths w h]
  simpa using norm_integral_le_of_norm_le_const (μ := birthFourierCubeMeasure ι)
    (Filter.Eventually.of_forall hB)

/-- Unselected edge coordinates carry zero displacement and therefore the
constant unit phase in the full product cube. -/
def birthForestEdgeDifference {n : ℕ} (code : BirthForestCode n)
    (f : Fin n → ℤ) (e : Fin n × Fin n) : ℤ :=
  if e ∈ birthForestEdges code then f e.2 - f e.1 else 0

theorem birthForestEdgeDifference_zero_iff {n : ℕ} (code : BirthForestCode n)
    (f : Fin n → ℤ) :
    (∀ e, birthForestEdgeDifference code f e = 0) ↔
      ∀ e ∈ birthForestEdges code, f e.2 = f e.1 := by
  constructor
  · intro h e he
    simpa only [birthForestEdgeDifference, if_pos he, sub_eq_zero] using h e
  · intro h e
    by_cases he : e ∈ birthForestEdges code
    · simp only [birthForestEdgeDifference, if_pos he, h e he, sub_self]
    · simp only [birthForestEdgeDifference, if_neg he]

theorem birthForestEdgeDifference_phase_product {n : ℕ} (code : BirthForestCode n)
    (f : Fin n → ℤ) (θ : (Fin n × Fin n) → ℝ) :
    (∏ e, physicalReturnPhase (θ e) (birthForestEdgeDifference code f e)) =
      ∏ j, physicalReturnPhase (birthForestLocalFrequency code θ j) (f j) := by
  calc
    _ = ∏ e ∈ birthForestEdges code, physicalReturnPhase (θ e) (f e.2 - f e.1) := by
      simp only [birthForestEdgeDifference, apply_ite, physicalReturnPhase_zero, prod_ite_mem_eq]
    _ = _ := birth_forest_phases_eq_local_phases code θ f

/-- Performed masks remain attached to every touched birth, including when
the incident Fourier frequencies cancel at that birth. -/
theorem birthForestCompatible_iff_touched_equalities {n : ℕ}
    (code : BirthForestCode n) (performed : Fin n → Prop) (f : Fin n → ℤ) :
    birthForestCompatible performed f code ↔
      (∀ j ∈ birthForestTouched code, performed j) ∧
        ∀ e ∈ birthForestEdges code, f e.2 = f e.1 := by
  rw [birthForestCompatible_iff_edges, birthForestTouched_performed_iff]
  constructor
  · intro h
    exact ⟨fun e he => ⟨(h e.1 e.2 he).1, (h e.1 e.2 he).2.1⟩,
      fun e he => (h e.1 e.2 he).2.2.symm⟩
  · rintro ⟨hp, hf⟩ i j hij
    exact ⟨(hp (i, j) hij).1, (hp (i, j) hij).2, (hf (i, j) hij).symm⟩

/-- Product Fourier integration equals the complete forest-constrained
finite path sum, including every performed-birth test. -/
theorem birthForestPathSum_fourier_integral {Ω : Type*} {n : ℕ}
    (paths : Finset Ω) (w : Ω → ℂ) (performed : Ω → Fin n → Prop)
    (f : Ω → Fin n → ℤ) (code : BirthForestCode n) :
    (∫ θ : (Fin n × Fin n) → ℝ,
      ∑ ω ∈ paths, if ∀ j ∈ birthForestTouched code, performed ω j then
        w ω * ∏ j, physicalReturnPhase (birthForestLocalFrequency code θ j) (f ω j) else 0
      ∂birthFourierCubeMeasure (Fin n × Fin n)) =
      birthForestPathSum paths w performed f code := by
  let w' : Ω → ℂ := fun ω =>
    if ∀ j ∈ birthForestTouched code, performed ω j then w ω else 0
  have hphase : ∀ θ, (∑ ω ∈ paths, w' ω *
      ∏ e, physicalReturnPhase (θ e) (birthForestEdgeDifference code (f ω) e)) =
      ∑ ω ∈ paths, if ∀ j ∈ birthForestTouched code, performed ω j then
        w ω * ∏ j, physicalReturnPhase (birthForestLocalFrequency code θ j) (f ω j) else 0 := by
    intro θ
    apply sum_congr rfl
    intro ω _
    rw [birthForestEdgeDifference_phase_product]
    simp only [w', ite_mul, zero_mul]
  rw [← show (fun θ => ∑ ω ∈ paths, w' ω *
      ∏ e, physicalReturnPhase (θ e) (birthForestEdgeDifference code (f ω) e)) =
      (fun θ => ∑ ω ∈ paths, if ∀ j ∈ birthForestTouched code, performed ω j then
        w ω * ∏ j, physicalReturnPhase (birthForestLocalFrequency code θ j) (f ω j) else 0)
      from funext hphase]
  rw [birth_fourier_finite_sum_integral]
  unfold birthForestPathSum
  apply sum_congr rfl
  intro ω _
  by_cases hp : ∀ j ∈ birthForestTouched code, performed ω j
  · by_cases he : ∀ e ∈ birthForestEdges code, f ω e.2 = f ω e.1
    · have hc := (birthForestCompatible_iff_touched_equalities code (performed ω) (f ω)).mpr ⟨hp, he⟩
      have hz := (birthForestEdgeDifference_zero_iff code (f ω)).mpr he
      simp only [if_pos hz, if_pos hc, w', if_pos hp]
    · have hc : ¬ birthForestCompatible (performed ω) (f ω) code :=
        fun hc => he ((birthForestCompatible_iff_touched_equalities code (performed ω) (f ω)).mp hc).2
      have hz : ¬ ∀ e, birthForestEdgeDifference code (f ω) e = 0 :=
        fun hz => he ((birthForestEdgeDifference_zero_iff code (f ω)).mp hz)
      simp only [if_neg hz, if_neg hc]
  · have hc : ¬ birthForestCompatible (performed ω) (f ω) code :=
      fun hc => hp ((birthForestCompatible_iff_touched_equalities code (performed ω) (f ω)).mp hc).1
    simp only [w', if_neg hp, hc, if_false, ite_self]

/-- A uniform bound for the locally twisted path sum implies the same bound
for the forest-constrained sum, without a loss depending on its rank. -/
theorem birthForestPathSum_norm_le_of_fourier_bound {Ω : Type*} {n : ℕ}
    (paths : Finset Ω) (w : Ω → ℂ) (performed : Ω → Fin n → Prop)
    (f : Ω → Fin n → ℤ) (code : BirthForestCode n) {B : ℝ}
    (hB : ∀ θ : (Fin n × Fin n) → ℝ,
      ‖∑ ω ∈ paths, if ∀ j ∈ birthForestTouched code, performed ω j then
        w ω * ∏ j, physicalReturnPhase (birthForestLocalFrequency code θ j) (f ω j) else 0‖ ≤ B) :
    ‖birthForestPathSum paths w performed f code‖ ≤ B := by
  let _ : IsProbabilityMeasure (birthFourierCubeMeasure (Fin n × Fin n)) :=
    birthFourierCubeMeasure_probability (Fin n × Fin n)
  rw [← birthForestPathSum_fourier_integral paths w performed f code]
  simpa using norm_integral_le_of_norm_le_const
    (μ := birthFourierCubeMeasure (Fin n × Fin n)) (Filter.Eventually.of_forall hB)
end

section
open Finset Classical
theorem sum_birthForestRank_head (n r₀ : ℕ) (B : ℕ → ℝ) :
    (∑ code ∈ (univ : Finset (BirthForestCode n)).filter
        (fun code => birthForestRank code < r₀), B (birthForestRank code)) =
      ∑ r ∈ range r₀, (birthForestCodesOfRank n r).card * B r := by
  have hmem : ∀ code ∈ (univ : Finset (BirthForestCode n)).filter
      (fun code => birthForestRank code < r₀), birthForestRank code ∈ range r₀ := by
    intro code hc
    exact mem_range.mpr (mem_filter.mp hc).2
  rw [← sum_fiberwise_of_maps_to' hmem B]
  apply sum_congr rfl
  intro r hr
  have he : ((univ : Finset (BirthForestCode n)).filter
      (fun code => birthForestRank code < r₀)).filter (fun code => birthForestRank code = r) =
      birthForestCodesOfRank n r := by
    ext code
    simp only [mem_filter, mem_univ, true_and, birthForestCodesOfRank]
    exact ⟨fun h => h.2, fun h => ⟨h ▸ mem_range.mp hr, h⟩⟩
  rw [he, sum_const, nsmul_eq_mul]

theorem birthForest_rank_head_norm_le {n : ℕ} (F : BirthForestCode n → ℂ)
    (r₀ : ℕ) (B : ℕ → ℝ) (hB : ∀ r ∈ range r₀, 0 ≤ B r)
    (hF : ∀ code, birthForestRank code < r₀ → ‖F code‖ ≤ B (birthForestRank code)) :
    ‖∑ code ∈ (univ : Finset (BirthForestCode n)).filter
        (fun code => birthForestRank code < r₀),
      (-1 : ℂ) ^ birthForestRank code * F code‖ ≤
      ∑ r ∈ range r₀, (n : ℝ) ^ (2 * r) * B r := by
  calc
    _ ≤ ∑ code ∈ (univ : Finset (BirthForestCode n)).filter
        (fun code => birthForestRank code < r₀), ‖F code‖ := by
      simpa only [norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
        using norm_sum_le ((univ : Finset (BirthForestCode n)).filter
          (fun code => birthForestRank code < r₀))
          (fun code => (-1 : ℂ) ^ birthForestRank code * F code)
    _ ≤ ∑ code ∈ (univ : Finset (BirthForestCode n)).filter
        (fun code => birthForestRank code < r₀), B (birthForestRank code) :=
      sum_le_sum (fun code hc => hF code (mem_filter.mp hc).2)
    _ = ∑ r ∈ range r₀, (birthForestCodesOfRank n r).card * B r :=
      sum_birthForestRank_head n r₀ B
    _ ≤ _ := by
      apply sum_le_sum
      intro r hr
      apply mul_le_mul_of_nonneg_right _ (hB r hr)
      exact_mod_cast birthForestCodesOfRank_card_le_pow n r

/-- A deliberately simple finite head bound, valid without assuming its
geometric ratio is less than one. -/
theorem birthForest_rank_head_geometric_bound {n : ℕ} (F : BirthForestCode n → ℂ)
    (r₀ : ℕ) {H a : ℝ} (hH : 0 ≤ H) (ha : 0 ≤ a)
    (hF : ∀ code, birthForestRank code < r₀ →
      ‖F code‖ ≤ H * a ^ birthForestRank code) :
    ‖∑ code ∈ (univ : Finset (BirthForestCode n)).filter
        (fun code => birthForestRank code < r₀),
      (-1 : ℂ) ^ birthForestRank code * F code‖ ≤
      H * r₀ * (max 1 ((n : ℝ) ^ 2 * a)) ^ r₀ := by
  apply (birthForest_rank_head_norm_le F r₀ (fun r => H * a ^ r)
    (fun r _ => mul_nonneg hH (pow_nonneg ha r)) hF).trans
  have hx : 0 ≤ (n : ℝ) ^ 2 * a := mul_nonneg (sq_nonneg _) ha
  calc
    _ = H * ∑ r ∈ range r₀, ((n : ℝ) ^ 2 * a) ^ r := by
      rw [mul_sum]
      apply sum_congr rfl
      intro r hr
      rw [mul_pow, pow_mul]
      ring
    _ ≤ H * ∑ _r ∈ range r₀, (max 1 ((n : ℝ) ^ 2 * a)) ^ r₀ := by
      apply mul_le_mul_of_nonneg_left _ hH
      apply sum_le_sum
      intro r hr
      exact (pow_le_pow_left₀ hx (le_max_right _ _) r).trans
        (pow_le_pow_right₀ (le_max_left _ _) (Nat.le_of_lt (mem_range.mp hr)))
    _ = _ := by simp [mul_assoc]

/-- The complete forest expansion admits distinct low- and high-rank
estimates, so only the high-rank part needs an absolute point-mass gain. -/
theorem birthForest_two_regime_norm_le {n : ℕ} (F : BirthForestCode n → ℂ)
    (r₀ : ℕ) {Hlow Hhigh a ε : ℝ}
    (hHlow : 0 ≤ Hlow) (hHhigh : 0 ≤ Hhigh) (ha : 0 ≤ a) (hε : 0 ≤ ε)
    (hδ : (n : ℝ) ^ 2 * ε < 1)
    (hlow : ∀ code, birthForestRank code < r₀ →
      ‖F code‖ ≤ Hlow * a ^ birthForestRank code)
    (hhigh : ∀ code, r₀ ≤ birthForestRank code →
      ‖F code‖ ≤ Hhigh * ε ^ birthForestRank code) :
    ‖∑ code : BirthForestCode n, (-1 : ℂ) ^ birthForestRank code * F code‖ ≤
      Hlow * r₀ * (max 1 ((n : ℝ) ^ 2 * a)) ^ r₀ +
        Hhigh * ((n : ℝ) ^ 2 * ε) ^ r₀ / (1 - (n : ℝ) ^ 2 * ε) := by
  rw [birthForest_rank_split _ r₀]
  exact (norm_add_le _ _).trans (add_le_add
    (birthForest_rank_head_geometric_bound F r₀ hHlow ha hlow)
    (birthForest_rank_tail_norm_le F r₀ hHhigh hε hδ hhigh))

/-- Apply the two-regime estimate to the exact global distinct-birth sum. -/
theorem distinct_birth_two_regime_norm_le {Ω α : Type*} {n : ℕ}
    (paths : Finset Ω) (w : Ω → ℂ) (performed : Ω → Fin n → Prop)
    (f : Ω → Fin n → α) (r₀ : ℕ) {Hlow Hhigh a ε : ℝ}
    (hHlow : 0 ≤ Hlow) (hHhigh : 0 ≤ Hhigh) (ha : 0 ≤ a) (hε : 0 ≤ ε)
    (hδ : (n : ℝ) ^ 2 * ε < 1)
    (hlow : ∀ code, birthForestRank code < r₀ →
      ‖birthForestPathSum paths w performed f code‖ ≤ Hlow * a ^ birthForestRank code)
    (hhigh : ∀ code, r₀ ≤ birthForestRank code →
      ‖birthForestPathSum paths w performed f code‖ ≤ Hhigh * ε ^ birthForestRank code) :
    ‖distinctBirthPathSum paths w performed f‖ ≤
      Hlow * r₀ * (max 1 ((n : ℝ) ^ 2 * a)) ^ r₀ +
        Hhigh * ((n : ℝ) ^ 2 * ε) ^ r₀ / (1 - (n : ℝ) ^ 2 * ε) := by
  rw [distinct_birth_path_expansion]
  exact birthForest_two_regime_norm_le _ r₀ hHlow hHhigh ha hε hδ hlow hhigh
end

section
open Finset
open scoped BigOperators Classical
/-- The prime values in the first `J` slots. -/
def physicalFirstMarks {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (labels : PhysicalMarkLists P J ell) (g : G) : Finset ℕ :=
  univ.map (Function.Embedding.inl.trans (physicalGroupMarkEmbedding labels g))

/-- The prime values in the last `ell` slots, which the small-group
dilation omits. -/
def physicalLastMarks {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (labels : PhysicalMarkLists P J ell) (g : G) : Finset ℕ :=
  univ.map (Function.Embedding.inr.trans (physicalGroupMarkEmbedding labels g))

theorem mem_physical_first_marks {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (labels : PhysicalMarkLists P J ell) (g : G) (p : ℕ) :
    p ∈ physicalFirstMarks labels g ↔ ∃ j : Fin J, (labels g (Sum.inl j)).val = p := by
  simp only [physicalFirstMarks, mem_map, mem_univ, true_and]
  rfl

theorem mem_physical_last_marks {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (labels : PhysicalMarkLists P J ell) (g : G) (p : ℕ) :
    p ∈ physicalLastMarks labels g ↔ ∃ j : Fin ell, (labels g (Sum.inr j)).val = p := by
  simp only [physicalLastMarks, mem_map, mem_univ, true_and]
  rfl

theorem physical_first_marks_card {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (labels : PhysicalMarkLists P J ell) (g : G) : (physicalFirstMarks labels g).card = J := by
  simp only [physicalFirstMarks, card_map, card_univ, Fintype.card_fin]

theorem physical_last_marks_card {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (labels : PhysicalMarkLists P J ell) (g : G) : (physicalLastMarks labels g).card = ell := by
  simp only [physicalLastMarks, card_map, card_univ, Fintype.card_fin]

theorem physical_last_marks_subset {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (labels : PhysicalMarkLists P J ell) (g : G) :
    physicalLastMarks labels g ⊆ physicalGroupMarks labels g := by
  intro p hp
  obtain ⟨j, hj⟩ := (mem_physical_last_marks labels g p).mp hp
  exact (mem_physical_group_marks labels g p).mpr ⟨Sum.inr j, hj⟩

/-- Injectivity of the ordered mark list makes the two slot blocks exact
set complements inside the full source set. -/
theorem physical_group_marks_sdiff_last {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (labels : PhysicalMarkLists P J ell) (g : G) :
    physicalGroupMarks labels g \ physicalLastMarks labels g = physicalFirstMarks labels g := by
  ext p
  rw [mem_sdiff, mem_physical_group_marks, mem_physical_first_marks]
  constructor
  · rintro ⟨⟨s, hs⟩, hnot⟩
    cases s with
    | inl j => exact ⟨j, hs⟩
    | inr j => exact False.elim (hnot ((mem_physical_last_marks labels g p).mpr ⟨j, hs⟩))
  · rintro ⟨j, hj⟩
    refine ⟨⟨Sum.inl j, hj⟩, ?_⟩
    intro hp
    obtain ⟨k, hk⟩ := (mem_physical_last_marks labels g p).mp hp
    have he : Sum.inl j = Sum.inr k := (labels g).injective (Subtype.ext (hj.trans hk.symm))
    cases he

/-- An empty small-group resampling pattern contributes exactly the
first-slot product; there are no auxiliary factors in this group. -/
theorem physical_groupD_eq_first_product {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (labels : PhysicalMarkLists P J ell)
    (aux : PhysicalAuxLabels P C) (g : G) (hC : C g = ∅) :
    physicalGroupD C labels aux g = ∏ p ∈ physicalFirstMarks labels g, p := by
  let : IsEmpty ↥(C g) := ⟨fun j => by simpa only [hC, notMem_empty] using j.property⟩
  have haux : (∏ j : C g, (aux g j).val) = 1 := by simp
  rw [physicalGroupD, haux, mul_one]
  simp [hC, physicalFirstMarks, physicalGroupMarkEmbedding]

/-- Fixed source prime sets in the selected small groups. -/
def physicalSmallSourcePools {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (small : Finset G) (labels : PhysicalMarkLists P J ell) : ↥small → Finset ℕ :=
  fun g => physicalGroupMarks labels g.val

theorem physical_small_source_pools_card {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (small : Finset G) (labels : PhysicalMarkLists P J ell) (g : small) :
    (physicalSmallSourcePools small labels g).card = J + ell :=
  physical_group_marks_card labels g.val

theorem physical_small_source_pools_prime {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (small : Finset G) (labels : PhysicalMarkLists P J ell)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p) :
    ∀ g p, p ∈ physicalSmallSourcePools small labels g → Nat.Prime p := by
  intro g p hp
  exact hP g.val p (physical_group_marks_subset labels g.val hp)

theorem physical_small_source_pools_disjoint {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (small : Finset G) (labels : PhysicalMarkLists P J ell)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) :
    Pairwise (fun g h => Disjoint (physicalSmallSourcePools small labels g)
      (physicalSmallSourcePools small labels h)) := by
  intro g h hne
  exact (hdis (show g.val ≠ h.val from fun he => hne (Subtype.ext he))).mono
    (physical_group_marks_subset labels g.val) (physical_group_marks_subset labels h.val)

/-- The last-slot values after permutation, viewed as omissions from the
fixed, unpermuted source sets. -/
def physicalSmallOmissions {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (small : Finset G) (labels : PhysicalMarkLists P J ell)
    (σ : PhysicalPermutations G J ell) : PrimeOmissionChoices (physicalSmallSourcePools small labels) ell :=
  fun g => ⟨physicalLastMarks (physicalPermuteLabels σ labels) g.val, mem_powersetCard.mpr ⟨by
    change physicalLastMarks (physicalPermuteLabels σ labels) g.val ⊆ physicalGroupMarks labels g.val
    rw [← physical_group_marks_permute σ labels g.val]
    exact physical_last_marks_subset _ _, physical_last_marks_card _ _⟩⟩

/-- The retained complement of an actual omission is its permuted first
block, even though its ambient source set remains fixed. -/
theorem physical_small_omission_complement {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (small : Finset G) (labels : PhysicalMarkLists P J ell)
    (σ : PhysicalPermutations G J ell) (g : small) :
    physicalSmallSourcePools small labels g \ (physicalSmallOmissions small labels σ g).val =
      physicalFirstMarks (physicalPermuteLabels σ labels) g.val := by
  change physicalGroupMarks labels g.val \ physicalLastMarks (physicalPermuteLabels σ labels) g.val = _
  rw [← physical_group_marks_permute σ labels g.val]
  exact physical_group_marks_sdiff_last _ _

/-- The retained omission-model product is exactly the product of the
actual physical contributions from the small groups. -/
theorem physical_small_retained_product_eq {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (small : Finset G) (C : G → Finset (Fin J)) (labels : PhysicalMarkLists P J ell)
    (aux : PhysicalAuxLabels P C) (σ : PhysicalPermutations G J ell)
    (hsmall : ∀ g ∈ small, C g = ∅) :
    primeRetainedProduct (physicalSmallSourcePools small labels) ell
        (physicalSmallOmissions small labels σ) =
      ∏ g ∈ small, physicalGroupD C (physicalPermuteLabels σ labels) aux g := by
  unfold primeRetainedProduct
  calc
    (∏ g : small, ∏ p ∈ physicalSmallSourcePools small labels g \
        (physicalSmallOmissions small labels σ g).val, p) =
      ∏ g : small, physicalGroupD C (physicalPermuteLabels σ labels) aux g.val := by
        apply prod_congr rfl
        intro g _
        rw [physical_small_omission_complement,
          physical_groupD_eq_first_product C _ aux g.val (hsmall g.val g.property)]
    _ = ∏ g ∈ small, physicalGroupD C (physicalPermuteLabels σ labels) aux g := prod_coe_sort _ _

/-- The contribution of groups outside the selected small set. -/
noncomputable def physicalBigGroupD {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (small : Finset G) (C : G → Finset (Fin J))
    (labels : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C) : ℕ :=
  ∏ g ∈ univ \ small, physicalGroupD C labels aux g

/-- Exact factorization of the actual physical dilation into its remaining
group factor and the retained small-prime product. -/
theorem physical_D_eq_big_mul_retained {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (small : Finset G) (C : G → Finset (Fin J))
    (labels : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C)
    (σ : PhysicalPermutations G J ell) (hsmall : ∀ g ∈ small, C g = ∅) :
    physicalD C (physicalPermuteLabels σ labels) aux =
      physicalBigGroupD small C (physicalPermuteLabels σ labels) aux *
        primeRetainedProduct (physicalSmallSourcePools small labels) ell
          (physicalSmallOmissions small labels σ) := by
  rw [physical_small_retained_product_eq small C labels aux σ hsmall]
  exact (prod_sdiff (f := fun g => physicalGroupD C (physicalPermuteLabels σ labels) aux g)
    (subset_univ small)).symm

/-- The omitted product times the physical dilation equals the big-group
factor times the full, fixed source-prime product. -/
theorem physical_small_omission_times_D {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (small : Finset G) (C : G → Finset (Fin J))
    (labels : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C)
    (σ : PhysicalPermutations G J ell) (hsmall : ∀ g ∈ small, C g = ∅) :
    primeOmissionProduct (physicalSmallSourcePools small labels) ell
        (physicalSmallOmissions small labels σ) * physicalD C (physicalPermuteLabels σ labels) aux =
      physicalBigGroupD small C (physicalPermuteLabels σ labels) aux *
        primeFullProduct (physicalSmallSourcePools small labels) := by
  rw [physical_D_eq_big_mul_retained small C labels aux σ hsmall, mul_left_comm,
    prime_omission_mul_retained_eq_full]

/-- Fixing the outside permutations fixes the outside physical factor. -/
theorem physical_big_groupD_permute_eq {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (small : Finset G) (C : G → Finset (Fin J))
    (labels : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C)
    (σ : PhysicalPermutations G J ell)
    (hσ : ∀ g, g ∉ small → σ g = Equiv.refl _) :
    physicalBigGroupD small C (physicalPermuteLabels σ labels) aux =
      physicalBigGroupD small C labels aux := by
  apply prod_congr rfl
  intro g hg
  have he : (physicalPermuteLabels σ labels) g = labels g := by
    apply Function.Embedding.ext
    intro s
    change labels g (σ g s) = labels g s
    rw [hσ g (mem_sdiff.mp hg).2]
    rfl
  simp only [physicalGroupD, he]

/-- The fixed-product identity needed for eligible-promotion rarity,
now derived from actual physical labels and the empty small patterns. -/
theorem physical_small_omission_times_D_constant {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (small : Finset G) (C : G → Finset (Fin J))
    (labels : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C)
    (σ : PhysicalPermutations G J ell) (hsmall : ∀ g ∈ small, C g = ∅)
    (hσ : ∀ g, g ∉ small → σ g = Equiv.refl _) :
    primeOmissionProduct (physicalSmallSourcePools small labels) ell
        (physicalSmallOmissions small labels σ) * physicalD C (physicalPermuteLabels σ labels) aux =
      physicalBigGroupD small C labels aux * primeFullProduct (physicalSmallSourcePools small labels) := by
  rw [physical_small_omission_times_D small C labels aux σ hsmall,
    physical_big_groupD_permute_eq small C labels aux σ hσ]

/-- The actual source-prime omission space has the expected uniform count. -/
theorem physical_small_omission_choices_card {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (small : Finset G) (labels : PhysicalMarkLists P J ell) :
    Fintype.card (PrimeOmissionChoices (physicalSmallSourcePools small labels) ell) =
      ((J + ell).choose ell) ^ small.card := by
  rw [Fintype.card_pi]
  simp only [Fintype.card_coe, card_powersetCard, physical_small_source_pools_card,
    prod_const, card_univ]
end

section
open scoped BigOperators InnerProductSpace
theorem finite_gram_norm_sum_sq {ι E : Type*} [Fintype ι]
    [NormedAddCommGroup E] [NormedSpace ℂ E] (c : ι → ℂ) (u : ι → E) :
    ‖∑ i, c i • u i‖ ^ 2 ≤ (∑ i, ‖c i‖ ^ 2) * ∑ i, ‖u i‖ ^ 2 := by
  have htriangle : ‖∑ i, c i • u i‖ ≤ ∑ i, ‖c i‖ * ‖u i‖ := by
    simpa only [norm_smul] using norm_sum_le Finset.univ (fun i => c i • u i)
  exact (pow_le_pow_left₀ (norm_nonneg _) htriangle 2).trans
    (Finset.sum_mul_sq_le_sq_mul_sq Finset.univ (fun i => ‖c i‖) (fun i => ‖u i‖))

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
  [FiniteDimensional ℂ E]

theorem positive_quadratic_gram_bound {ι : Type*} [Fintype ι]
    (T : E →ₗ[ℂ] E) (hT : T.IsSymmetric)
    (hpos : ∀ f : E, 0 ≤ (inner ℂ f (T f)).re) (c : ι → ℂ) (u : ι → E) :
    (inner ℂ (∑ i, c i • u i) (T (∑ i, c i • u i))).re ≤
      (∑ i, ‖c i‖ ^ 2) * ∑ i, (inner ℂ (u i) (T (u i))).re := by
  have hsplit (v : E) : (inner ℂ v (T v)).re =
      ∑ j, ‖inner ℂ (hT.eigenvectorBasis rfl j) v‖ ^ 2 * hT.eigenvalues rfl j := by
    simpa only [pow_one] using spectral_moment_eq_sum T hT 1 v
  have hl (j : Fin (Module.finrank ℂ E)) : 0 ≤ hT.eigenvalues rfl j :=
    eigenvalue_nonneg_of_nonneg (hT.hasEigenvalue_eigenvalues rfl j) hpos
  have hcoord (j : Fin (Module.finrank ℂ E)) :
      ‖inner ℂ (hT.eigenvectorBasis rfl j) (∑ i, c i • u i)‖ ^ 2 ≤
      (∑ i, ‖c i‖ ^ 2) * ∑ i, ‖inner ℂ (hT.eigenvectorBasis rfl j) (u i)‖ ^ 2 := by
    simpa only [inner_sum, inner_smul_right, smul_eq_mul] using
      finite_gram_norm_sum_sq c (fun i => inner ℂ (hT.eigenvectorBasis rfl j) (u i))
  rw [hsplit]
  calc
    _ ≤ ∑ j, ((∑ i, ‖c i‖ ^ 2) *
        ∑ i, ‖inner ℂ (hT.eigenvectorBasis rfl j) (u i)‖ ^ 2) *
          hT.eigenvalues rfl j :=
      Finset.sum_le_sum (fun j _ => mul_le_mul_of_nonneg_right (hcoord j) (hl j))
    _ = (∑ i, ‖c i‖ ^ 2) *
        ∑ i, ∑ j, ‖inner ℂ (hT.eigenvectorBasis rfl j) (u i)‖ ^ 2 *
          hT.eigenvalues rfl j := by
      simp only [mul_assoc]
      rw [← Finset.mul_sum]
      congr 1
      simp only [Finset.sum_mul]
      exact Finset.sum_comm
    _ = _ := by simp only [← hsplit]

theorem gram_power_quadratic_bound {ι : Type*} [Fintype ι]
    (A : E →ₗ[ℂ] E) (R : ℕ) (c : ι → ℂ) (u : ι → E) :
    (inner ℂ (∑ i, c i • u i) (((A * A.adjoint) ^ R) (∑ i, c i • u i))).re ≤
      (∑ i, ‖c i‖ ^ 2) *
        ∑ i, (inner ℂ (u i) (((A * A.adjoint) ^ R) (u i))).re := by
  have hsym : (A * A.adjoint).IsSymmetric := LinearMap.isSymmetric_self_comp_adjoint A
  have hpos (v : E) : 0 ≤ (inner ℂ v ((A * A.adjoint) v)).re := by
    rw [Module.End.mul_apply, ← LinearMap.adjoint_inner_left]
    exact inner_self_nonneg (𝕜 := ℂ) (x := A.adjoint v)
  exact positive_quadratic_gram_bound ((A * A.adjoint) ^ R) (hsym.pow R)
    (positive_spectral_moment_nonneg (A * A.adjoint) hsym hpos R) c u
end

section

open scoped BigOperators

/-- A consecutive integer block of length `H`. -/
def integerBlock (H j : ℤ) : Finset ℤ :=
  Finset.Ico (j * H) ((j + 1) * H)

/-- The block containing `x` and its two adjacent blocks. -/
abbrev integerBlockNear (H j x : ℤ) : Prop :=
  |x / H - j| ≤ 1

/-- Restriction of a function to one position block. -/
noncomputable def integerBlockMask {α E : Type*} [Zero E]
    (pos : α → ℤ) (H j : ℤ) (f : α → E) (x : α) : E :=
  if pos x / H = j then f x else 0

/-- Restriction to a block and its two neighbors. -/
noncomputable def integerBlockNearMask {α E : Type*} [Zero E]
    (pos : α → ℤ) (H j : ℤ) (f : α → E) (x : α) : E :=
  if integerBlockNear H j (pos x) then f x else 0

lemma mem_integerBlock_iff {H j x : ℤ} (hH : 0 < H) :
    x ∈ integerBlock H j ↔ x / H = j := by
  rw [integerBlock, Finset.mem_Ico, Int.ediv_eq_iff_of_pos hH]
  rw [add_mul, one_mul]

lemma integerBlock_card (H j : ℤ) :
    (integerBlock H j).card = H.toNat := by
  rw [integerBlock, Int.card_Ico]
  congr 1
  ring

lemma integerBlock_disjoint {H i j : ℤ} (hH : 0 < H) (hij : i ≠ j) :
    Disjoint (integerBlock H i) (integerBlock H j) := by
  apply Finset.disjoint_left.mpr
  intro x hx hi
  rw [mem_integerBlock_iff hH] at hx hi
  exact hij (hx.symm.trans hi)

lemma integerBlock_filter_card_le (s : Finset ℤ) {H j : ℤ} (hH : 0 < H) :
    (s.filter fun x => x / H = j).card ≤ H.toNat := by
  rw [← integerBlock_card H j]
  apply Finset.card_le_card
  intro x hx
  exact (mem_integerBlock_iff hH).mpr (Finset.mem_filter.mp hx).2

lemma integerBlockNear_of_abs_sub_le {H x y : ℤ} (hH : 0 < H)
    (hxy : |x - y| ≤ H) : integerBlockNear H (x / H) y := by
  have habs := abs_le.mp hxy
  have hl := Int.ediv_le_ediv hH (show x - H ≤ y by omega)
  have hu := Int.ediv_le_ediv hH (show y ≤ x + H by omega)
  rw [Int.sub_ediv_of_dvd x (dvd_refl H), Int.ediv_self (ne_of_gt hH)] at hl
  rw [Int.add_ediv_of_dvd_right (dvd_refl H), Int.ediv_self (ne_of_gt hH)] at hu
  exact abs_le.mpr ⟨by omega, by omega⟩

lemma integerBlockNear_iff {H j x : ℤ} :
    integerBlockNear H j x ↔ x / H - 1 ≤ j ∧ j ≤ x / H + 1 := by
  unfold integerBlockNear
  rw [abs_le]
  omega

lemma integerBlockNear_filter_card_le (J : Finset ℤ) (H x : ℤ) :
    (J.filter fun j => integerBlockNear H j x).card ≤ 3 := by
  have hs : (J.filter fun j => integerBlockNear H j x) ⊆
      Finset.Icc (x / H - 1) (x / H + 1) := by
    intro j hj
    exact Finset.mem_Icc.mpr (integerBlockNear_iff.mp (Finset.mem_filter.mp hj).2)
  calc
    _ ≤ (Finset.Icc (x / H - 1) (x / H + 1)).card := Finset.card_le_card hs
    _ = 3 := by rw [Int.card_Icc]; omega

lemma sum_integerBlock_fibers {α E : Type*} [AddCommMonoid E]
    (s : Finset α) (pos : α → ℤ) (H : ℤ) (f : α → E) :
    ∑ j ∈ s.image (fun x => pos x / H), ∑ x ∈ s with pos x / H = j, f x =
      ∑ x ∈ s, f x := by
  classical
  apply Finset.sum_fiberwise_of_maps_to
  intro x hx
  exact Finset.mem_image_of_mem _ hx

lemma sum_integerBlock_masks {α E : Type*} [AddCommMonoid E]
    (s : Finset α) (pos : α → ℤ) (H : ℤ) (f : α → E) :
    ∑ j ∈ s.image (fun x => pos x / H), ∑ x ∈ s, integerBlockMask pos H j f x =
      ∑ x ∈ s, f x := by
  classical
  simp only [integerBlockMask, ← Finset.sum_filter]
  exact sum_integerBlock_fibers s pos H f

lemma sum_integerBlockNear_weights_le {α : Type*}
    (s : Finset α) (J : Finset ℤ) (pos : α → ℤ) (H : ℤ)
    (w : α → ℝ) (hw : ∀ x ∈ s, 0 ≤ w x) :
    ∑ j ∈ J, ∑ x ∈ s with integerBlockNear H j (pos x), w x ≤
      3 * ∑ x ∈ s, w x := by
  classical
  simp only [Finset.sum_filter]
  rw [Finset.sum_comm, Finset.mul_sum]
  apply Finset.sum_le_sum
  intro x hx
  calc
    (∑ j ∈ J, if integerBlockNear H j (pos x) then w x else 0) =
        ((J.filter fun j => integerBlockNear H j (pos x)).card : ℝ) * w x := by
      rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
    _ ≤ 3 * w x := by
      apply mul_le_mul_of_nonneg_right _ (hw x hx)
      exact_mod_cast integerBlockNear_filter_card_le J H (pos x)

lemma sum_integerBlockNear_sq_norm_le {α E : Type*} [SeminormedAddCommGroup E]
    (s : Finset α) (J : Finset ℤ) (pos : α → ℤ) (H : ℤ)
    (w : α → ℝ) (g : α → E) (hw : ∀ x ∈ s, 0 ≤ w x) :
    ∑ j ∈ J, ∑ x ∈ s, w x * ‖integerBlockNearMask pos H j g x‖ ^ 2 ≤
      3 * ∑ x ∈ s, w x * ‖g x‖ ^ 2 := by
  classical
  convert sum_integerBlockNear_weights_le s J pos H (fun x => w x * ‖g x‖ ^ 2)
    (fun x hx => mul_nonneg (hw x hx) (sq_nonneg _)) using 1
  apply Finset.sum_congr rfl
  intro j hj
  rw [Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro x hx
  by_cases h : integerBlockNear H j (pos x)
  · simp [integerBlockNearMask, h]
  · simp [integerBlockNearMask, h]

lemma integerBlock_kernel_localization {α : Type*}
    (s : Finset α) (pos : α → ℤ) {H : ℤ} (hH : 0 < H)
    (j : ℤ) (K : α → α → ℂ) (f g : α → ℂ)
    (hK : ∀ x ∈ s, ∀ y ∈ s, H < |pos x - pos y| → K x y = 0) :
    (∑ x ∈ s, star (integerBlockMask pos H j f x) *
      ∑ y ∈ s, K x y * g y) =
    ∑ x ∈ s, star (integerBlockMask pos H j f x) *
      ∑ y ∈ s, K x y * integerBlockNearMask pos H j g y := by
  classical
  apply Finset.sum_congr rfl
  intro x hx
  by_cases hblock : pos x / H = j
  · congr 1
    apply Finset.sum_congr rfl
    intro y hy
    by_cases hnear : integerBlockNear H j (pos y)
    · simp [integerBlockNearMask, hnear]
    · have hfar : H < |pos x - pos y| := by
        by_contra h
        apply hnear
        rw [← hblock]
        exact integerBlockNear_of_abs_sub_le hH (le_of_not_gt h)
      simp [integerBlockNearMask, hnear, hK x hx y hy hfar]
  · simp [integerBlockMask, hblock]

lemma sum_integerBlockMask_eq {α E : Type*} [AddCommMonoid E]
    (s : Finset α) (pos : α → ℤ) (H : ℤ) (f : α → E)
    {x : α} (hx : x ∈ s) :
    ∑ j ∈ s.image (fun y => pos y / H), integerBlockMask pos H j f x = f x := by
  classical
  rw [Finset.sum_eq_single (pos x / H)]
  · simp [integerBlockMask]
  · intro j _ hj
    simp [integerBlockMask, Ne.symm hj]
  · intro h
    exact (h (Finset.mem_image_of_mem (fun y => pos y / H) hx)).elim

lemma sum_integerBlock_sq_norm {α E : Type*} [SeminormedAddCommGroup E]
    (s : Finset α) (pos : α → ℤ) (H : ℤ) (w : α → ℝ) (f : α → E) :
    ∑ j ∈ s.image (fun x => pos x / H),
      ∑ x ∈ s, w x * ‖integerBlockMask pos H j f x‖ ^ 2 =
      ∑ x ∈ s, w x * ‖f x‖ ^ 2 := by
  classical
  convert sum_integerBlock_masks s pos H (fun x => w x * ‖f x‖ ^ 2) using 1
  apply Finset.sum_congr rfl
  intro j hj
  apply Finset.sum_congr rfl
  intro x hx
  by_cases h : pos x / H = j <;> simp [integerBlockMask, h]

lemma integerBlock_kernel_pairing {α : Type*}
    (s : Finset α) (pos : α → ℤ) {H : ℤ} (hH : 0 < H)
    (K : α → α → ℂ) (f g : α → ℂ)
    (hK : ∀ x ∈ s, ∀ y ∈ s, H < |pos x - pos y| → K x y = 0) :
    (∑ x ∈ s, star (f x) * ∑ y ∈ s, K x y * g y) =
    ∑ j ∈ s.image (fun x => pos x / H),
      ∑ x ∈ s, star (integerBlockMask pos H j f x) *
        ∑ y ∈ s, K x y * integerBlockNearMask pos H j g y := by
  classical
  calc
    _ = ∑ j ∈ s.image (fun x => pos x / H),
        ∑ x ∈ s, star (integerBlockMask pos H j f x) *
          ∑ y ∈ s, K x y * g y := by
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro x hx
      rw [← Finset.sum_mul, ← star_sum, sum_integerBlockMask_eq s pos H f hx]
    _ = _ := Finset.sum_congr rfl (fun j _ =>
      integerBlock_kernel_localization s pos hH j K f g hK)

lemma integerBlock_kernel_pairing_norm_le {α : Type*}
    (s : Finset α) (pos : α → ℤ) {H : ℤ} (hH : 0 < H)
    (K : α → α → ℂ) (f g : α → ℂ)
    (hK : ∀ x ∈ s, ∀ y ∈ s, H < |pos x - pos y| → K x y = 0) :
    ‖∑ x ∈ s, star (f x) * ∑ y ∈ s, K x y * g y‖ ≤
    ∑ j ∈ s.image (fun x => pos x / H),
      ‖∑ x ∈ s, star (integerBlockMask pos H j f x) *
        ∑ y ∈ s, K x y * integerBlockNearMask pos H j g y‖ := by
  rw [integerBlock_kernel_pairing s pos hH K f g hK]
  exact norm_sum_le _ _

lemma integerBlock_sq_norm_le_card_mul {E : Type*} [SeminormedAddCommGroup E]
    (s : Finset ℤ) {H : ℤ} (hH : 0 < H) (j : ℤ) (f : ℤ → E)
    {M : ℝ} (hM : 0 ≤ M) (hf : ∀ x ∈ s, ‖f x‖ ≤ M) :
    ∑ x ∈ s with x / H = j, ‖f x‖ ^ 2 ≤ (H.toNat : ℝ) * M ^ 2 := by
  calc
    _ ≤ ∑ _x ∈ s with _x / H = j, M ^ 2 := by
      apply Finset.sum_le_sum
      intro x hx
      exact (sq_le_sq₀ (norm_nonneg _) hM).mpr (hf x (Finset.mem_filter.mp hx).1)
    _ = ((s.filter fun x => x / H = j).card : ℝ) * M ^ 2 := by
      rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ _ := mul_le_mul_of_nonneg_right
      (by exact_mod_cast integerBlock_filter_card_le s hH (j := j)) (sq_nonneg M)
end

section
open scoped BigOperators
theorem finite_geometric_sum_le {ι : Type*} [Fintype ι]
    (x y : ι → ℝ) (hx : ∀ i, 0 ≤ x i) (hy : ∀ i, 0 ≤ y i)
    {θ : ℝ} (hθ : 0 < θ) (hθ1 : θ < 1) :
    ∑ i, (x i) ^ θ * (y i) ^ (1 - θ) ≤
      (∑ i, x i) ^ θ * (∑ i, y i) ^ (1 - θ) := by
  have hconj : (1 / θ).HolderConjugate (1 / (1 - θ)) := by
    rw [Real.holderConjugate_iff]
    constructor
    · exact (lt_div_iff₀ hθ).2 (by linarith)
    · simp
  have h := Real.inner_le_Lp_mul_Lq_of_nonneg Finset.univ hconj
    (fun i _ => Real.rpow_nonneg (hx i) θ)
    (fun i _ => Real.rpow_nonneg (hy i) (1 - θ))
  have hxpow (i : ι) : ((x i) ^ θ) ^ (1 / θ) = x i := by
    rw [← Real.rpow_mul (hx i), mul_one_div_cancel hθ.ne', Real.rpow_one]
  have hypow (i : ι) : ((y i) ^ (1 - θ)) ^ (1 / (1 - θ)) = y i := by
    rw [← Real.rpow_mul (hy i), mul_one_div_cancel (by linarith : 1 - θ ≠ 0),
      Real.rpow_one]
  simpa only [hxpow, hypow, one_div_one_div] using h

theorem finite_block_holder {ι : Type*} [Fintype ι]
    (g f d : ι → ℝ) (hg : ∀ i, 0 ≤ g i) (hf : ∀ i, 0 ≤ f i)
    (hd : ∀ i, 0 ≤ d i) {θ : ℝ} (hθ : 0 < θ) (hθ1 : θ < 1) :
    ∑ i, g i * (f i) ^ θ * (d i) ^ ((1 - θ) / 2) ≤
      (∑ i, (g i) ^ 2) ^ (1 / 2 : ℝ) *
      (∑ i, (f i) ^ 2) ^ (θ / 2) * (∑ i, d i) ^ ((1 - θ) / 2) := by
  have hconj : (2 : ℝ).HolderConjugate 2 := by
    rw [Real.holderConjugate_iff]
    norm_num
  have hcs := Real.inner_le_Lp_mul_Lq_of_nonneg Finset.univ hconj
    (fun i _ => hg i)
    (fun i _ => mul_nonneg (Real.rpow_nonneg (hf i) θ)
      (Real.rpow_nonneg (hd i) ((1 - θ) / 2)))
  have hpower (i : ι) : ((f i) ^ θ * (d i) ^ ((1 - θ) / 2)) ^ (2 : ℝ) =
      ((f i) ^ 2) ^ θ * (d i) ^ (1 - θ) := by
    rw [Real.mul_rpow (Real.rpow_nonneg (hf i) θ)
      (Real.rpow_nonneg (hd i) ((1 - θ) / 2)),
      ← Real.rpow_mul (hf i), ← Real.rpow_mul (hd i)]
    rw [show (1 - θ) / 2 * 2 = 1 - θ by ring]
    congr 1
    rw [← Real.rpow_natCast, ← Real.rpow_mul (hf i)]
    congr 1
    ring
  simp only [hpower, Real.rpow_two] at hcs
  have hgeom := finite_geometric_sum_le (fun i => (f i) ^ 2) d
    (fun i => sq_nonneg _) hd hθ hθ1
  have hmono := Real.rpow_le_rpow
    (Finset.sum_nonneg (fun i _ => mul_nonneg (Real.rpow_nonneg (sq_nonneg _) θ)
      (Real.rpow_nonneg (hd i) (1 - θ)))) hgeom (by norm_num : (0 : ℝ) ≤ 1 / 2)
  have hmul := mul_le_mul_of_nonneg_left hmono
    (Real.rpow_nonneg (show 0 ≤ ∑ i, (g i) ^ 2 from
      Finset.sum_nonneg (fun i _ => sq_nonneg (g i))) (1 / 2))
  have hx : 0 ≤ ∑ i, (f i) ^ 2 := Finset.sum_nonneg (fun i _ => sq_nonneg _)
  have hy : 0 ≤ ∑ i, d i := Finset.sum_nonneg (fun i _ => hd i)
  rw [Real.mul_rpow (Real.rpow_nonneg hx θ) (Real.rpow_nonneg hy (1 - θ)),
    ← Real.rpow_mul hx, ← Real.rpow_mul hy] at hmul
  simp only [mul_one_div] at hmul
  simpa only [mul_assoc] using hcs.trans hmul
end

section
open scoped BigOperators InnerProductSpace
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
  [FiniteDimensional ℂ E]

theorem finite_pairing_gram_bound {ι : Type*} [Fintype ι]
    (A : E →ₗ[ℂ] E) (f g : E) (c : ι → ℂ) (u : ι → E)
    (hf : f = ∑ i, c i • u i) {C : ℝ} (hC : ∑ i, ‖c i‖ ^ 2 ≤ C)
    {R : ℕ} (hR : 1 ≤ R) :
    ‖inner ℂ f (A g)‖ ≤
      C ^ (1 / (2 * (R : ℝ))) *
        (‖g‖ * ‖f‖ ^ (1 - 1 / (R : ℝ)) *
          (∑ i, (inner ℂ (u i) (((A * A.adjoint) ^ R) (u i))).re) ^
            (1 / (2 * (R : ℝ)))) := by
  have hsym : (A * A.adjoint).IsSymmetric := LinearMap.isSymmetric_self_comp_adjoint A
  have hpos (v : E) : 0 ≤ (inner ℂ v ((A * A.adjoint) v)).re := by
    rw [Module.End.mul_apply, ← LinearMap.adjoint_inner_left]
    exact inner_self_nonneg (𝕜 := ℂ) (x := A.adjoint v)
  have hmpos (v : E) : 0 ≤ (inner ℂ v (((A * A.adjoint) ^ R) v)).re :=
    positive_spectral_moment_nonneg (A * A.adjoint) hsym hpos R v
  have hd : 0 ≤ ∑ i, (inner ℂ (u i) (((A * A.adjoint) ^ R) (u i))).re :=
    Finset.sum_nonneg (fun i _ => hmpos (u i))
  have hCpos : 0 ≤ C := (Finset.sum_nonneg (fun i _ => sq_nonneg ‖c i‖)).trans hC
  have hm : (inner ℂ f (((A * A.adjoint) ^ R) f)).re ≤
      C * ∑ i, (inner ℂ (u i) (((A * A.adjoint) ^ R) (u i))).re := by
    rw [hf]
    exact (gram_power_quadratic_bound A R c u).trans
      (mul_le_mul_of_nonneg_right hC hd)
  have hp := Real.rpow_le_rpow (hmpos f) hm
    (by positivity : 0 ≤ 1 / (2 * (R : ℝ)))
  rw [Real.mul_rpow hCpos hd] at hp
  calc
    ‖inner ℂ f (A g)‖ ≤ ‖g‖ * ‖f‖ ^ (1 - 1 / (R : ℝ)) *
        (inner ℂ f (((A * A.adjoint) ^ R) f)).re ^ (1 / (2 * (R : ℝ))) :=
      finite_pairing_moment A f g hR
    _ ≤ ‖g‖ * ‖f‖ ^ (1 - 1 / (R : ℝ)) *
        (C ^ (1 / (2 * (R : ℝ))) *
          (∑ i, (inner ℂ (u i) (((A * A.adjoint) ^ R) (u i))).re) ^
            (1 / (2 * (R : ℝ)))) :=
      mul_le_mul_of_nonneg_left hp
        (mul_nonneg (norm_nonneg _) (Real.rpow_nonneg (norm_nonneg _) _))
    _ = _ := by ring

theorem finite_endpoint_block_bound {J ι : Type*} [Fintype J] [Fintype ι]
    (A : E →ₗ[ℂ] E) (f g : J → E) (c : J → ι → ℂ) (u : J → ι → E)
    (hf : ∀ j, f j = ∑ i, c j i • u j i)
    {C : ℝ} (hC : ∀ j, ∑ i, ‖c j i‖ ^ 2 ≤ C)
    {R : ℕ} (hR : 2 ≤ R) :
    ∑ j, ‖inner ℂ (f j) (A (g j))‖ ≤
      C ^ (1 / (2 * (R : ℝ))) *
      (∑ j, ‖g j‖ ^ 2) ^ (1 / 2 : ℝ) *
      (∑ j, ‖f j‖ ^ 2) ^ ((1 - 1 / (R : ℝ)) / 2) *
      (∑ j, ∑ i, (inner ℂ (u j i) (((A * A.adjoint) ^ R) (u j i))).re) ^
        (1 / (2 * (R : ℝ))) := by
  classical
  rcases isEmpty_or_nonempty J with hJ | hJ
  · simp
  · let j₀ : J := Classical.choice hJ
    have hCpos : 0 ≤ C :=
      (Finset.sum_nonneg (fun i _ => sq_nonneg ‖c j₀ i‖)).trans (hC j₀)
    have hsym : (A * A.adjoint).IsSymmetric := LinearMap.isSymmetric_self_comp_adjoint A
    have hpos (v : E) : 0 ≤ (inner ℂ v ((A * A.adjoint) v)).re := by
      rw [Module.End.mul_apply, ← LinearMap.adjoint_inner_left]
      exact inner_self_nonneg (𝕜 := ℂ) (x := A.adjoint v)
    let d : J → ℝ := fun j =>
      ∑ i, (inner ℂ (u j i) (((A * A.adjoint) ^ R) (u j i))).re
    have hd (j : J) : 0 ≤ d j := Finset.sum_nonneg (fun i _ =>
      positive_spectral_moment_nonneg (A * A.adjoint) hsym hpos R (u j i))
    have hRpos : (0 : ℝ) < R := by exact_mod_cast (by omega : 0 < R)
    have hRone : (1 : ℝ) < R := by exact_mod_cast hR
    have hθ : 0 < 1 - 1 / (R : ℝ) := by
      have := (div_lt_one hRpos).2 hRone
      linarith
    have hθ1 : 1 - 1 / (R : ℝ) < 1 := by
      have := one_div_pos.mpr hRpos
      linarith
    have hexp : (1 - (1 - 1 / (R : ℝ))) / 2 = 1 / (2 * (R : ℝ)) := by ring
    have hh := finite_block_holder (fun j => ‖g j‖) (fun j => ‖f j‖) d
      (fun _ => norm_nonneg _) (fun _ => norm_nonneg _) hd hθ hθ1
    rw [hexp] at hh
    calc
      ∑ j, ‖inner ℂ (f j) (A (g j))‖ ≤
          ∑ j, C ^ (1 / (2 * (R : ℝ))) *
            (‖g j‖ * ‖f j‖ ^ (1 - 1 / (R : ℝ)) * (d j) ^ (1 / (2 * (R : ℝ)))) :=
        Finset.sum_le_sum (fun j _ =>
          finite_pairing_gram_bound A (f j) (g j) (c j) (u j) (hf j) (hC j) (by omega))
      _ = C ^ (1 / (2 * (R : ℝ))) *
          ∑ j, ‖g j‖ * ‖f j‖ ^ (1 - 1 / (R : ℝ)) * (d j) ^ (1 / (2 * (R : ℝ))) :=
        (Finset.mul_sum _ _ _).symm
      _ ≤ C ^ (1 / (2 * (R : ℝ))) *
          ((∑ j, ‖g j‖ ^ 2) ^ (1 / 2 : ℝ) *
          (∑ j, ‖f j‖ ^ 2) ^ ((1 - 1 / (R : ℝ)) / 2) *
          (∑ j, d j) ^ (1 / (2 * (R : ℝ)))) :=
        mul_le_mul_of_nonneg_left hh (Real.rpow_nonneg hCpos _)
      _ = _ := by dsimp only [d]; ring
end

section
open Filter
open scoped Topology
theorem moment_root_le_exp_of_log {M R C : ℝ} (hM : 0 < M) (hR : 0 < R)
    (hlog : Real.log M ≤ R * C) : M ^ (1 / R) ≤ Real.exp C := by
  rw [Real.rpow_def_of_pos hM]
  apply Real.exp_le_exp.mpr
  rw [mul_one_div]
  exact (div_le_iff₀ hR).mpr (by nlinarith)

theorem eventually_block_sup_moment_bound {a d C : ℝ}
    (ha : (1 / 2 : ℝ) < a) (hd : d < a) (hC : 0 ≤ C) (D : ℝ) :
    ∀ᶠ T : ℝ in atTop, ∀ H : ℝ, 0 < H →
      Real.log H ≤ D * T ^ d * Real.log T →
      (H * Real.exp (C * Real.sqrt T) ^ 2) ^
        (1 / (2 * (Nat.ceil (T ^ a) : ℝ))) ≤ Real.exp 1 := by
  have ha0 : 0 < a := by linarith
  filter_upwards [eventually_mul_rpow_log_add_le_rpow ha0 hd
      (show (0 : ℝ) < 1 by norm_num) D 0,
    eventually_mul_rpow_log_add_le_rpow ha0 ha
      (show (0 : ℝ) < 1 by norm_num) (2 * C) 0,
    Real.tendsto_log_atTop.eventually_ge_atTop 1,
    eventually_gt_atTop (0 : ℝ)] with T hD hCbound hlogT hT
  intro H hH hlogH
  have hsqrt : Real.sqrt T = T ^ (1 / 2 : ℝ) := Real.sqrt_eq_rpow T
  have hClog : 2 * C * Real.sqrt T ≤ 2 * C * T ^ (1 / 2 : ℝ) * Real.log T := by
    rw [hsqrt]
    exact le_mul_of_one_le_right (by positivity) hlogT
  have hceil : T ^ a ≤ (Nat.ceil (T ^ a) : ℝ) := Nat.le_ceil _
  have hR : 0 < 2 * (Nat.ceil (T ^ a) : ℝ) := by
    have : 0 < T ^ a := Real.rpow_pos_of_pos hT a
    linarith
  apply moment_root_le_exp_of_log (mul_pos hH (sq_pos_of_pos (Real.exp_pos _))) hR
  rw [Real.log_mul hH.ne' (pow_ne_zero 2 (Real.exp_ne_zero _)),
    Real.log_pow, Real.log_exp]
  norm_num only [Nat.cast_ofNat]
  nlinarith
end

section
open scoped BigOperators
theorem physical_symmetric_kernel_conjugate {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (K : PhysicalState P J ell → PhysicalState P J ell → ℂ)
    (x y : PhysicalState P J ell) :
    physicalSymmetricKernel (fun a b => (starRingEnd ℂ) (K a b)) x y =
      (starRingEnd ℂ) (physicalSymmetricKernel K x y) := by
  rw [physical_symmetric_kernel_double_sum, physical_symmetric_kernel_double_sum]
  simp only [map_mul, map_inv₀, Complex.conj_natCast, map_sum]

theorem physical_symmetric_kernel_adjoint {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (K : PhysicalState P J ell → PhysicalState P J ell → ℂ)
    (x y : PhysicalState P J ell) :
    physicalSymmetricKernel (fun a b => (starRingEnd ℂ) (K b a)) x y =
      (starRingEnd ℂ) (physicalSymmetricKernel K y x) := by
  rw [physical_symmetric_kernel_conjugate, physical_symmetric_kernel_transpose]

theorem physical_symmetric_patterns_reverse {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ) (x y : PhysicalState P J ell) :
    physicalSymmetricKernel (fun s t => ∑ i ∈ patterns,
      physicalPatternKernel V (C i) q (-ζ i) (-k i)
        (fun a b f => (starRingEnd ℂ) (K i b a f)) s t) x y =
    (starRingEnd ℂ) (physicalSymmetricKernel (fun s t => ∑ i ∈ patterns,
      physicalPatternKernel V (C i) q (ζ i) (k i) (K i) s t) y x) := by
  have heq : (fun s t => ∑ i ∈ patterns,
      physicalPatternKernel V (C i) q (-ζ i) (-k i)
        (fun a b f => (starRingEnd ℂ) (K i b a f)) s t) =
      (fun s t => (starRingEnd ℂ) (∑ i ∈ patterns,
        physicalPatternKernel V (C i) q (ζ i) (k i) (K i) t s)) := by
    funext s t
    simp only [physical_pattern_reverse, map_sum]
  rw [heq, physical_symmetric_kernel_adjoint]
end

section
open scoped BigOperators ComplexConjugate
noncomputable def finiteKernelOperator {X : Type*} [Fintype X] (K : X → X → ℂ) :
    EuclideanSpace ℂ X →ₗ[ℂ] EuclideanSpace ℂ X := by
  classical
  exact Matrix.toEuclideanLin K

theorem finite_kernel_operator_apply {X : Type*} [Fintype X]
    (K : X → X → ℂ) (v : EuclideanSpace ℂ X) (x : X) :
    finiteKernelOperator K v x = ∑ y, K x y * v y := by
  classical
  rfl

theorem finite_kernel_operator_adjoint {X : Type*} [Fintype X] (K : X → X → ℂ) :
    (finiteKernelOperator K).adjoint = finiteKernelOperator (fun x y => star (K y x)) := by
  classical
  exact (Matrix.toEuclideanLin_conjTranspose_eq_adjoint K).symm

noncomputable def finiteGramAlternatingKernel {X : Type*} (K : X → X → ℂ)
    (j : ℕ) (x y : X) : ℂ :=
  if j % 2 = 0 then star (K y x) else K x y

theorem finite_gram_alternating_kernel_even {X : Type*} (K : X → X → ℂ)
    (r : ℕ) (x y : X) : finiteGramAlternatingKernel K (2 * r) x y = star (K y x) := by
  simp [finiteGramAlternatingKernel]

theorem finite_gram_alternating_kernel_odd {X : Type*} (K : X → X → ℂ)
    (r : ℕ) (x y : X) : finiteGramAlternatingKernel K (2 * r + 1) x y = K x y := by
  simp [finiteGramAlternatingKernel]

theorem finite_alternating_action_eq_gram_power {X : Type*} [Fintype X]
    (K : X → X → ℂ) (terminal : X → ℂ) (R : ℕ) (x : X) :
    finitePathAction (finiteGramAlternatingKernel K) terminal (2 * R) x =
      (((finiteKernelOperator K * (finiteKernelOperator K).adjoint) ^ R)
        (WithLp.toLp 2 terminal)) x := by
  induction R generalizing x with
  | zero => rfl
  | succ R ih =>
    rw [show 2 * (R + 1) = (2 * R + 1) + 1 by omega,
      finitePathAction, pow_succ', Module.End.mul_apply, Module.End.mul_apply,
      finite_kernel_operator_apply]
    apply Finset.sum_congr rfl
    intro y _
    rw [finite_gram_alternating_kernel_odd, finitePathAction,
      finite_kernel_operator_adjoint, finite_kernel_operator_apply]
    congr 1
    apply Finset.sum_congr rfl
    intro z _
    rw [finite_gram_alternating_kernel_even, ih]
    simp only [finite_kernel_operator_adjoint]

theorem finite_cutoff_alternating_action_eq_gram_power {X : Type*}
    (rows : Finset X) (K : X → X → ℂ) (terminal : X → ℂ) (R : ℕ) (x : rows) :
    finiteCutoffAction rows (finiteGramAlternatingKernel K) terminal (2 * R) x.val =
      (((finiteKernelOperator (fun a b : rows => K a.val b.val) *
          (finiteKernelOperator (fun a b : rows => K a.val b.val)).adjoint) ^ R)
        (WithLp.toLp 2 (fun a : rows => terminal a.val))) x := by
  rw [finite_cutoff_action_eq_finite]
  exact finite_alternating_action_eq_gram_power
    (fun a b : rows => K a.val b.val) (fun a : rows => terminal a.val) R x
end

section
open scoped BigOperators InnerProductSpace
variable {X : Type*}

noncomputable def finiteFiberIndicator (position : X → ℤ) (n : ℤ) :
    EuclideanSpace ℂ X :=
  WithLp.toLp 2 (fun x => if position x = n then 1 else 0)

noncomputable def finiteFiberVector (position : X → ℤ) (mass : ℝ) (n : ℤ) :
    EuclideanSpace ℂ X :=
  (Real.sqrt mass : ℂ) • finiteFiberIndicator position n

theorem finiteFiberIndicator_apply (position : X → ℤ) (n : ℤ) (x : X) :
    finiteFiberIndicator position n x = if position x = n then 1 else 0 := rfl

theorem finiteFiberVector_apply (position : X → ℤ) (mass : ℝ) (n : ℤ) (x : X) :
    finiteFiberVector position mass n x =
      if position x = n then (Real.sqrt mass : ℂ) else 0 := by
  simp only [finiteFiberVector, PiLp.smul_apply, smul_eq_mul, finiteFiberIndicator_apply]
  split_ifs <;> simp

variable [Fintype X]

theorem finiteFiberIndicator_inner (position : X → ℤ) (n : ℤ)
    (v : EuclideanSpace ℂ X) :
    inner ℂ (finiteFiberIndicator position n) v =
      ∑ x ∈ Finset.univ.filter (fun x => position x = n), v x := by
  rw [PiLp.inner_apply, Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro x _
  by_cases hx : position x = n <;>
    simp [finiteFiberIndicator_apply, hx]

theorem finiteFiberVector_inner_operator (position : X → ℤ) {mass : ℝ}
    (hmass : 0 ≤ mass) (n : ℤ)
    (T : EuclideanSpace ℂ X →ₗ[ℂ] EuclideanSpace ℂ X) :
    inner ℂ (finiteFiberVector position mass n) (T (finiteFiberVector position mass n)) =
      (mass : ℂ) * ∑ x ∈ Finset.univ.filter (fun x => position x = n),
        T (finiteFiberIndicator position n) x := by
  simp only [finiteFiberVector, map_smul, inner_smul_left, inner_smul_right,
    Complex.conj_ofReal, ← mul_assoc, ← Complex.ofReal_mul, Real.mul_self_sqrt hmass,
    finiteFiberIndicator_inner]

theorem sum_finiteFiberVector_inner_operator (position : X → ℤ) {mass : ℝ}
    (hmass : 0 ≤ mass) (starts : Finset ℤ)
    (T : EuclideanSpace ℂ X →ₗ[ℂ] EuclideanSpace ℂ X) :
    (∑ n ∈ starts, inner ℂ (finiteFiberVector position mass n)
      (T (finiteFiberVector position mass n))) =
      (mass : ℂ) * ∑ n ∈ starts, ∑ x ∈ Finset.univ.filter (fun x => position x = n),
        T (finiteFiberIndicator position n) x := by
  simp only [finiteFiberVector_inner_operator position hmass, Finset.mul_sum]

theorem finiteFiberVector_inner_operator_re (position : X → ℤ) {mass : ℝ}
    (hmass : 0 ≤ mass) (n : ℤ)
    (T : EuclideanSpace ℂ X →ₗ[ℂ] EuclideanSpace ℂ X) :
    (inner ℂ (finiteFiberVector position mass n)
      (T (finiteFiberVector position mass n))).re =
      mass * ∑ x ∈ Finset.univ.filter (fun x => position x = n),
        (T (finiteFiberIndicator position n) x).re := by
  rw [finiteFiberVector_inner_operator position hmass]
  simp only [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero,
    Complex.re_sum]

theorem sum_finiteFiberVector_inner_operator_re (position : X → ℤ) {mass : ℝ}
    (hmass : 0 ≤ mass) (starts : Finset ℤ)
    (T : EuclideanSpace ℂ X →ₗ[ℂ] EuclideanSpace ℂ X) :
    (∑ n ∈ starts, (inner ℂ (finiteFiberVector position mass n)
      (T (finiteFiberVector position mass n))).re) =
      mass * ∑ n ∈ starts, ∑ x ∈ Finset.univ.filter (fun x => position x = n),
        (T (finiteFiberIndicator position n) x).re := by
  simp only [finiteFiberVector_inner_operator_re position hmass, Finset.mul_sum]

theorem finiteFiberVector_norm_sq (position : X → ℤ) {mass : ℝ}
    (hmass : 0 ≤ mass) (n : ℤ) :
    ‖finiteFiberVector position mass n‖ ^ 2 =
      mass * (Finset.univ.filter (fun x => position x = n)).card := by
  have h := finiteFiberVector_inner_operator_re position hmass n
    (LinearMap.id : EuclideanSpace ℂ X →ₗ[ℂ] EuclideanSpace ℂ X)
  have hs : (∑ x ∈ Finset.univ.filter (fun x => position x = n),
      (finiteFiberIndicator position n x).re) =
      (Finset.univ.filter (fun x => position x = n)).card := by
    calc
      _ = ∑ _x ∈ Finset.univ.filter (fun x => position x = n), (1 : ℝ) := by
        apply Finset.sum_congr rfl
        intro x hx
        rw [finiteFiberIndicator_apply, if_pos (Finset.mem_filter.mp hx).2]
        rfl
      _ = _ := by simp
  have hv : (inner ℂ (finiteFiberVector position mass n)
      (finiteFiberVector position mass n)).re = ‖finiteFiberVector position mass n‖ ^ 2 :=
    inner_self_eq_norm_sq (𝕜 := ℂ) _
  simpa only [LinearMap.id_apply, hv, hs] using h
end

section
open scoped BigOperators InnerProductSpace
theorem finite_fiber_gram_eq_return_root {X : Type*} [Fintype X]
    (position : X → ℤ) {mass : ℝ} (hmass : 0 ≤ mass)
    (K : X → X → ℂ) (starts : Finset ℤ) (R : ℕ) :
    (∑ n ∈ starts, inner ℂ (finiteFiberVector position mass n)
      (((finiteKernelOperator K * (finiteKernelOperator K).adjoint) ^ R)
        (finiteFiberVector position mass n))) =
      (mass : ℂ) * ∑ n ∈ starts,
        ∑ x ∈ Finset.univ.filter (fun x => position x = n),
          finitePathAction (finiteGramAlternatingKernel K)
            (fun y => if position y = n then 1 else 0) (2 * R) x := by
  rw [sum_finiteFiberVector_inner_operator position hmass]
  congr 1
  apply Finset.sum_congr rfl
  intro n _
  apply Finset.sum_congr rfl
  intro x _
  exact (finite_alternating_action_eq_gram_power K
    (fun y => if position y = n then 1 else 0) R x).symm

theorem finite_fiber_gram_eq_return_root_re {X : Type*} [Fintype X]
    (position : X → ℤ) {mass : ℝ} (hmass : 0 ≤ mass)
    (K : X → X → ℂ) (starts : Finset ℤ) (R : ℕ) :
    (∑ n ∈ starts, (inner ℂ (finiteFiberVector position mass n)
      (((finiteKernelOperator K * (finiteKernelOperator K).adjoint) ^ R)
        (finiteFiberVector position mass n))).re) =
      mass * ∑ n ∈ starts,
        ∑ x ∈ Finset.univ.filter (fun x => position x = n),
          (finitePathAction (finiteGramAlternatingKernel K)
            (fun y => if position y = n then 1 else 0) (2 * R) x).re := by
  have h := congrArg Complex.re (finite_fiber_gram_eq_return_root position hmass K starts R)
  simpa only [Complex.re_sum, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
    zero_mul, sub_zero] using h

theorem finite_cutoff_fiber_gram_eq_return_root {X : Type*}
    (rows : Finset X) (position : X → ℤ) {mass : ℝ} (hmass : 0 ≤ mass)
    (K : X → X → ℂ) (starts : Finset ℤ) (R : ℕ) :
    (∑ n ∈ starts, inner ℂ (finiteFiberVector (fun x : rows => position x.val) mass n)
      (((finiteKernelOperator (fun a b : rows => K a.val b.val) *
          (finiteKernelOperator (fun a b : rows => K a.val b.val)).adjoint) ^ R)
        (finiteFiberVector (fun x : rows => position x.val) mass n))) =
      (mass : ℂ) * ∑ n ∈ starts, ∑ x ∈ rows.filter (fun x => position x = n),
        finiteCutoffAction rows (finiteGramAlternatingKernel K)
          (fun y => if position y = n then 1 else 0) (2 * R) x := by
  classical
  rw [sum_finiteFiberVector_inner_operator (fun x : rows => position x.val) hmass]
  congr 1
  apply Finset.sum_congr rfl
  intro n _
  rw [Finset.sum_filter, Finset.sum_filter, ← Finset.sum_coe_sort rows]
  apply Finset.sum_congr rfl
  intro x _
  split_ifs with hx
  · exact (finite_cutoff_alternating_action_eq_gram_power rows K
      (fun y => if position y = n then 1 else 0) R x).symm
  · rfl

theorem finite_cutoff_fiber_gram_eq_return_root_re {X : Type*}
    (rows : Finset X) (position : X → ℤ) {mass : ℝ} (hmass : 0 ≤ mass)
    (K : X → X → ℂ) (starts : Finset ℤ) (R : ℕ) :
    (∑ n ∈ starts, (inner ℂ (finiteFiberVector (fun x : rows => position x.val) mass n)
      (((finiteKernelOperator (fun a b : rows => K a.val b.val) *
          (finiteKernelOperator (fun a b : rows => K a.val b.val)).adjoint) ^ R)
        (finiteFiberVector (fun x : rows => position x.val) mass n))).re) =
      mass * ∑ n ∈ starts, ∑ x ∈ rows.filter (fun x => position x = n),
        (finiteCutoffAction rows (finiteGramAlternatingKernel K)
          (fun y => if position y = n then 1 else 0) (2 * R) x).re := by
  have h := congrArg Complex.re
    (finite_cutoff_fiber_gram_eq_return_root rows position hmass K starts R)
  simpa only [Complex.re_sum, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
    zero_mul, sub_zero] using h
end

section

open scoped BigOperators ComplexConjugate

noncomputable def cleanFourierSynthesis {R : Type*} [AddCommGroup R] [Fintype R]
    (c : AddChar R ℂ → ℂ) (r : R) : ℂ :=
  ∑ χ, c χ * χ r

noncomputable def cleanFourierCoefficients {R : Type*} [AddCommGroup R] [Fintype R]
    (f : R → ℂ) (χ : AddChar R ℂ) : ℂ :=
  (AddChar.complexBasis R).repr f χ

noncomputable def cleanTranslatedOperator {X R : Type*} [Fintype X]
    [AddCommGroup R] (K : X → X → ℂ) (δ : X → X → R)
    (f : X → R → ℂ) (x : X) (r : R) : ℂ :=
  ∑ y, K x y * f y (r + δ x y)

noncomputable def cleanFourierBlock {X R : Type*} [Fintype X]
    [AddCommGroup R] (K : X → X → ℂ) (δ : X → X → R)
    (χ : AddChar R ℂ) (v : X → ℂ) (x : X) : ℂ :=
  ∑ y, (K x y * χ (δ x y)) * v y

theorem clean_fourier_synthesis_coefficients {R : Type*} [AddCommGroup R] [Fintype R]
    (f : R → ℂ) (r : R) :
    cleanFourierSynthesis (cleanFourierCoefficients f) r = f r := by
  have h := congr_fun ((AddChar.complexBasis R).sum_repr f) r
  simpa only [cleanFourierSynthesis, cleanFourierCoefficients, AddChar.complexBasis_apply,
    Finset.sum_apply, Pi.smul_apply, smul_eq_mul] using h

theorem clean_character_orthogonality {R : Type*} [AddCommGroup R] [Fintype R]
    (χ ψ : AddChar R ℂ) :
    ∑ r, χ r * conj (ψ r) = if χ = ψ then (Fintype.card R : ℂ) else 0 := by
  classical
  have h := AddChar.sum_eq_ite (χ - ψ)
  simpa only [AddChar.sub_apply, AddChar.map_neg_eq_inv, AddChar.inv_apply_eq_conj,
    sub_eq_zero] using h

theorem clean_fourier_synthesis_pairing {R : Type*} [AddCommGroup R] [Fintype R]
    (c d : AddChar R ℂ → ℂ) :
    ∑ r, cleanFourierSynthesis c r * conj (cleanFourierSynthesis d r) =
      (Fintype.card R : ℂ) * ∑ χ, c χ * conj (d χ) := by
  classical
  simp only [cleanFourierSynthesis, map_sum, map_mul, Fintype.sum_mul_sum]
  calc
    ∑ r, ∑ χ, ∑ ψ, c χ * χ r * (conj (d ψ) * conj (ψ r)) =
        ∑ χ, ∑ ψ, (c χ * conj (d ψ)) * ∑ r, χ r * conj (ψ r) := by
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro χ hχ
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro ψ hψ
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro r hr
      ring
    _ = (Fintype.card R : ℂ) * ∑ χ, c χ * conj (d χ) := by
      simp_rw [clean_character_orthogonality]
      simp only [mul_ite, mul_zero, Finset.sum_ite_eq, Finset.mem_univ, if_true]
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro χ hχ
      ring

theorem clean_fourier_synthesis_energy {R : Type*} [AddCommGroup R] [Fintype R]
    (c : AddChar R ℂ → ℂ) :
    ∑ r, ‖cleanFourierSynthesis c r‖ ^ 2 =
      (Fintype.card R : ℝ) * ∑ χ, ‖c χ‖ ^ 2 := by
  have h := clean_fourier_synthesis_pairing c c
  simp only [Complex.mul_conj, Complex.normSq_eq_norm_sq] at h
  exact_mod_cast h

theorem clean_fourier_translated_synthesis {X R : Type*} [Fintype X]
    [AddCommGroup R] [Fintype R] (K : X → X → ℂ) (δ : X → X → R)
    (c : AddChar R ℂ → X → ℂ) (x : X) (r : R) :
    cleanTranslatedOperator K δ (fun y => cleanFourierSynthesis (fun χ => c χ y)) x r =
      cleanFourierSynthesis (fun χ => cleanFourierBlock K δ χ (c χ) x) r := by
  simp only [cleanTranslatedOperator, cleanFourierBlock, cleanFourierSynthesis,
    AddChar.map_add_eq_mul, Finset.mul_sum, Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro χ hχ
  apply Finset.sum_congr rfl
  intro y hy
  ring

/-- Parseval with an arbitrary weight on the active states. -/
theorem clean_fourier_weighted_energy {X R : Type*} [Fintype X]
    [AddCommGroup R] [Fintype R] (w : X → ℝ) (c : AddChar R ℂ → X → ℂ) :
    ∑ x, w x * ∑ r, ‖cleanFourierSynthesis (fun χ => c χ x) r‖ ^ 2 =
      (Fintype.card R : ℝ) * ∑ χ, ∑ x, w x * ‖c χ x‖ ^ 2 := by
  simp_rw [clean_fourier_synthesis_energy, ← mul_assoc, mul_comm (w _) (Fintype.card R : ℝ), mul_assoc,
    Finset.mul_sum]
  rw [Finset.sum_comm]

/-- The synthesis coefficient is the usual normalized finite Fourier coefficient. -/
theorem clean_fourier_synthesis_coefficient {R : Type*} [AddCommGroup R] [Fintype R]
    (c : AddChar R ℂ → ℂ) (χ : AddChar R ℂ) :
    ∑ r, cleanFourierSynthesis c r * conj (χ r) =
      (Fintype.card R : ℂ) * c χ := by
  classical
  simp only [cleanFourierSynthesis, Finset.sum_mul]
  rw [Finset.sum_comm]
  simp_rw [mul_assoc, ← Finset.mul_sum, clean_character_orthogonality]
  simp only [mul_ite, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, if_true]
  ring

theorem clean_fourier_coefficient_formula {R : Type*} [AddCommGroup R] [Fintype R]
    (f : R → ℂ) (χ : AddChar R ℂ) :
    cleanFourierCoefficients f χ =
      (Fintype.card R : ℂ)⁻¹ * ∑ r, f r * conj (χ r) := by
  have h := clean_fourier_synthesis_coefficient (cleanFourierCoefficients f) χ
  simp only [clean_fourier_synthesis_coefficients] at h
  rw [h, ← mul_assoc, inv_mul_cancel₀ (Nat.cast_ne_zero.mpr Fintype.card_ne_zero), one_mul]

/-- Any linear active-state constraint is preserved by taking residue Fourier coefficients. -/
theorem clean_fourier_coefficients_mem {X R : Type*} [Fintype R] [AddCommGroup R]
    (U : Submodule ℂ (X → ℂ)) (f : X → R → ℂ)
    (hf : ∀ r, (fun x => f x r) ∈ U) (χ : AddChar R ℂ) :
    (fun x => cleanFourierCoefficients (f x) χ) ∈ U := by
  have h : (Fintype.card R : ℂ)⁻¹ •
      (∑ r, conj (χ r) • (fun x => f x r)) ∈ U :=
    U.smul_mem _ (U.sum_mem (fun r _ => U.smul_mem (conj (χ r)) (hf r)))
  convert h using 1
  ext x
  simp only [clean_fourier_coefficient_formula, Pi.smul_apply, Finset.sum_apply,
    smul_eq_mul]
  congr 1
  apply Finset.sum_congr rfl
  intro r hr
  ring

/-- A block estimate on an active-state subspace controls the translated kernel on all
residue-dependent tests whose slices satisfy that same subspace constraint. -/
theorem clean_translated_energy_le_of_fourier_blocks {X R : Type*} [Fintype X]
    [AddCommGroup R] [Fintype R] (w : X → ℝ) (K : X → X → ℂ)
    (δ : X → X → R) (U : Submodule ℂ (X → ℂ)) (C : ℝ)
    (hblock : ∀ (χ : AddChar R ℂ) (v : X → ℂ), v ∈ U →
      ∑ x, w x * ‖cleanFourierBlock K δ χ v x‖ ^ 2 ≤
        C ^ 2 * ∑ x, w x * ‖v x‖ ^ 2)
    (f : X → R → ℂ) (hf : ∀ r, (fun x => f x r) ∈ U) :
    ∑ x, w x * ∑ r, ‖cleanTranslatedOperator K δ f x r‖ ^ 2 ≤
      C ^ 2 * ∑ x, w x * ∑ r, ‖f x r‖ ^ 2 := by
  let c : AddChar R ℂ → X → ℂ := fun χ x => cleanFourierCoefficients (f x) χ
  have hrep : f = fun x => cleanFourierSynthesis (fun χ => c χ x) := by
    funext x r
    exact (clean_fourier_synthesis_coefficients (f x) r).symm
  have hcmem (χ : AddChar R ℂ) : c χ ∈ U := clean_fourier_coefficients_mem U f hf χ
  rw [hrep]
  simp_rw [clean_fourier_translated_synthesis]
  rw [clean_fourier_weighted_energy, clean_fourier_weighted_energy]
  calc
    (Fintype.card R : ℝ) * ∑ χ, ∑ x, w x * ‖cleanFourierBlock K δ χ (c χ) x‖ ^ 2 ≤
        (Fintype.card R : ℝ) * ∑ χ, C ^ 2 * ∑ x, w x * ‖c χ x‖ ^ 2 := by
      apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
      exact Finset.sum_le_sum (fun χ _ => hblock χ (c χ) (hcmem χ))
    _ = C ^ 2 * ((Fintype.card R : ℝ) * ∑ χ, ∑ x, w x * ‖c χ x‖ ^ 2) := by
      rw [← Finset.mul_sum]
      ring

/-- Weighted counting-measure L² norm on active states and residues. -/
noncomputable def cleanWeightedNorm {X R : Type*} [Fintype X] [Fintype R]
    (w : X → ℝ) (f : X → R → ℂ) : ℝ :=
  Real.sqrt (∑ x, w x * ∑ r, ‖f x r‖ ^ 2)

theorem clean_translated_norm_le_of_fourier_blocks {X R : Type*} [Fintype X]
    [AddCommGroup R] [Fintype R] (w : X → ℝ) (K : X → X → ℂ)
    (δ : X → X → R) (U : Submodule ℂ (X → ℂ)) (C : ℝ) (hC : 0 ≤ C)
    (hblock : ∀ (χ : AddChar R ℂ) (v : X → ℂ), v ∈ U →
      ∑ x, w x * ‖cleanFourierBlock K δ χ v x‖ ^ 2 ≤
        C ^ 2 * ∑ x, w x * ‖v x‖ ^ 2)
    (f : X → R → ℂ) (hf : ∀ r, (fun x => f x r) ∈ U) :
    cleanWeightedNorm w (cleanTranslatedOperator K δ f) ≤ C * cleanWeightedNorm w f := by
  have h := Real.sqrt_le_sqrt
    (clean_translated_energy_le_of_fourier_blocks w K δ U C hblock f hf)
  simpa only [cleanWeightedNorm, Real.sqrt_mul (sq_nonneg C), Real.sqrt_sq hC] using h

/-- Fourier coefficients recover every synthesis coefficient. -/
theorem clean_fourier_coefficients_synthesis {R : Type*} [AddCommGroup R] [Fintype R]
    (c : AddChar R ℂ → ℂ) (χ : AddChar R ℂ) :
    cleanFourierCoefficients (cleanFourierSynthesis c) χ = c χ := by
  rw [clean_fourier_coefficient_formula, clean_fourier_synthesis_coefficient,
    ← mul_assoc, inv_mul_cancel₀ (Nat.cast_ne_zero.mpr Fintype.card_ne_zero), one_mul]

/-- The residue Fourier transform diagonalizes all translations, even when the translation
amount depends on both active endpoints. -/
theorem clean_fourier_coefficients_translated {X R : Type*} [Fintype X]
    [AddCommGroup R] [Fintype R] (K : X → X → ℂ) (δ : X → X → R)
    (f : X → R → ℂ) (χ : AddChar R ℂ) (x : X) :
    cleanFourierCoefficients (cleanTranslatedOperator K δ f x) χ =
      cleanFourierBlock K δ χ (fun y => cleanFourierCoefficients (f y) χ) x := by
  let c : AddChar R ℂ → X → ℂ := fun ψ y => cleanFourierCoefficients (f y) ψ
  have hrep : f = fun y => cleanFourierSynthesis (fun ψ => c ψ y) := by
    funext y r
    exact (clean_fourier_synthesis_coefficients (f y) r).symm
  have hop : cleanTranslatedOperator K δ f x =
      cleanFourierSynthesis (fun ψ => cleanFourierBlock K δ ψ (c ψ) x) := by
    rw [hrep]
    funext r
    exact clean_fourier_translated_synthesis K δ c x r
  rw [hop, clean_fourier_coefficients_synthesis]

/-- Weighted L² norm on the active states alone. -/
noncomputable def cleanActiveNorm {X : Type*} [Fintype X]
    (w : X → ℝ) (v : X → ℂ) : ℝ :=
  Real.sqrt (∑ x, w x * ‖v x‖ ^ 2)

theorem clean_active_norm_sq {X : Type*} [Fintype X]
    (w : X → ℝ) (hw : ∀ x, 0 ≤ w x) (v : X → ℂ) :
    cleanActiveNorm w v ^ 2 = ∑ x, w x * ‖v x‖ ^ 2 := by
  apply Real.sq_sqrt
  exact Finset.sum_nonneg (fun x _ => mul_nonneg (hw x) (sq_nonneg _))

theorem clean_translated_norm_le_of_active_norm_blocks {X R : Type*} [Fintype X]
    [AddCommGroup R] [Fintype R] (w : X → ℝ) (hw : ∀ x, 0 ≤ w x)
    (K : X → X → ℂ) (δ : X → X → R) (U : Submodule ℂ (X → ℂ))
    (C : ℝ) (hC : 0 ≤ C)
    (hblock : ∀ (χ : AddChar R ℂ) (v : X → ℂ), v ∈ U →
      cleanActiveNorm w (cleanFourierBlock K δ χ v) ≤ C * cleanActiveNorm w v)
    (f : X → R → ℂ) (hf : ∀ r, (fun x => f x r) ∈ U) :
    cleanWeightedNorm w (cleanTranslatedOperator K δ f) ≤ C * cleanWeightedNorm w f := by
  apply clean_translated_norm_le_of_fourier_blocks w K δ U C hC _ f hf
  intro χ v hv
  have h := hblock χ v hv
  have hs := sq_le_sq₀ (Real.sqrt_nonneg _) (mul_nonneg hC (Real.sqrt_nonneg _)) |>.mpr h
  change cleanActiveNorm w (cleanFourierBlock K δ χ v) ^ 2 ≤
    (C * cleanActiveNorm w v) ^ 2 at hs
  simpa only [mul_pow, clean_active_norm_sq w hw] using hs

/-- Rescaling residue counting measure to normalized Haar measure preserves the bound. -/
theorem clean_translated_normalized_norm_le_of_active_norm_blocks {X R : Type*}
    [Fintype X] [AddCommGroup R] [Fintype R] (w : X → ℝ) (hw : ∀ x, 0 ≤ w x)
    (K : X → X → ℂ) (δ : X → X → R) (U : Submodule ℂ (X → ℂ))
    (C : ℝ) (hC : 0 ≤ C)
    (hblock : ∀ (χ : AddChar R ℂ) (v : X → ℂ), v ∈ U →
      cleanActiveNorm w (cleanFourierBlock K δ χ v) ≤ C * cleanActiveNorm w v)
    (f : X → R → ℂ) (hf : ∀ r, (fun x => f x r) ∈ U) :
    Real.sqrt ((Fintype.card R : ℝ)⁻¹) *
        cleanWeightedNorm w (cleanTranslatedOperator K δ f) ≤
      C * (Real.sqrt ((Fintype.card R : ℝ)⁻¹) * cleanWeightedNorm w f) := by
  have h := mul_le_mul_of_nonneg_left
    (clean_translated_norm_le_of_active_norm_blocks w hw K δ U C hC hblock f hf)
    (Real.sqrt_nonneg ((Fintype.card R : ℝ)⁻¹))
  simpa only [mul_left_comm _ C] using h
end

section
open scoped BigOperators InnerProductSpace
noncomputable def finiteWeightedFunction {X : Type*} (mass : ℝ) (f : X → ℂ) :
    EuclideanSpace ℂ X := (Real.sqrt mass : ℂ) • WithLp.toLp 2 f

theorem finiteWeightedFunction_apply {X : Type*} (mass : ℝ) (f : X → ℂ) (x : X) :
    finiteWeightedFunction mass f x = (Real.sqrt mass : ℂ) * f x := rfl

theorem finiteWeightedFunction_norm_sq {X : Type*} [Fintype X]
    {mass : ℝ} (hmass : 0 ≤ mass) (f : X → ℂ) :
    ‖finiteWeightedFunction mass f‖ ^ 2 = mass * ∑ x, ‖f x‖ ^ 2 := by
  rw [EuclideanSpace.norm_sq_eq, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro x _
  rw [finiteWeightedFunction_apply, norm_mul, mul_pow, Complex.norm_real,
    Real.norm_eq_abs, abs_of_nonneg (Real.sqrt_nonneg _), Real.sq_sqrt hmass]

theorem finiteWeightedFunction_kernel_pairing {X : Type*} [Fintype X]
    {mass : ℝ} (hmass : 0 ≤ mass) (f g : X → ℂ) (K : X → X → ℂ) :
    inner ℂ (finiteWeightedFunction mass f)
      (finiteKernelOperator K (finiteWeightedFunction mass g)) =
      (mass : ℂ) * ∑ x, star (f x) * ∑ y, K x y * g y := by
  have hinner : inner ℂ (WithLp.toLp 2 f)
      (finiteKernelOperator K (WithLp.toLp 2 g)) =
      ∑ x, star (f x) * ∑ y, K x y * g y := by
    rw [PiLp.inner_apply]
    apply Finset.sum_congr rfl
    intro x _
    simp only [RCLike.inner_apply, finite_kernel_operator_apply, Complex.star_def]
    ring
  simp only [finiteWeightedFunction, map_smul, inner_smul_left, inner_smul_right,
    Complex.conj_ofReal, ← mul_assoc, ← Complex.ofReal_mul, Real.mul_self_sqrt hmass,
    hinner]

theorem finiteWeightedFunction_eq_sum_fibers {X : Type*} [Fintype X]
    (position : X → ℤ) (mass : ℝ) (roots : Finset ℤ) (f : ℤ → ℂ) :
    finiteWeightedFunction mass (fun x => if position x ∈ roots then f (position x) else 0) =
      ∑ n ∈ roots, f n • finiteFiberVector position mass n := by
  classical
  apply PiLp.ext
  intro x
  simp only [finiteWeightedFunction_apply, WithLp.ofLp_sum, Finset.sum_apply, PiLp.smul_apply,
    finiteFiberVector_apply, smul_eq_mul]
  by_cases hx : position x ∈ roots
  · rw [if_pos hx, Finset.sum_eq_single (position x)]
    · simp [mul_comm]
    · intro n _ hn
      simp [Ne.symm hn]
    · exact fun h => (h hx).elim
  · rw [if_neg hx, mul_zero]
    symm
    apply Finset.sum_eq_zero
    intro n hn
    have hne : position x ≠ n := by
      intro he
      exact hx (he ▸ hn)
    simp [hne]
end

section
open scoped BigOperators
noncomputable def physicalHilbertOperator {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ) (positions : Finset ℤ) :
    EuclideanSpace ℂ (physicalCutoff P J ell positions) →ₗ[ℂ]
      EuclideanSpace ℂ (physicalCutoff P J ell positions) :=
  finiteKernelOperator (fun x y : physicalCutoff P J ell positions =>
    physicalSymmetricKernel (fun s t => ∑ i ∈ patterns,
      physicalPatternKernel V (C i) q (ζ i) (k i) (K i) s t) x.val y.val)

theorem physical_symmetric_alternating_kernel {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ) :
    (fun j x y => physicalSymmetricKernel (fun s t => ∑ i ∈ patterns,
      physicalPatternKernel V (C i) q
        (if j % 2 = 0 then -ζ i else ζ i) (if j % 2 = 0 then -k i else k i)
        (fun a b aux => if j % 2 = 0 then (starRingEnd ℂ) (K i b a aux) else K i a b aux)
        s t) x y) =
      finiteGramAlternatingKernel (fun x y => physicalSymmetricKernel (fun s t => ∑ i ∈ patterns,
        physicalPatternKernel V (C i) q (ζ i) (k i) (K i) s t) x y) := by
  funext j x y
  unfold finiteGramAlternatingKernel
  by_cases hj : j % 2 = 0
  · simp only [if_pos hj]
    exact physical_symmetric_patterns_reverse V patterns C q ζ k K x y
  · simp only [if_neg hj]
end

section
open Finset Classical
theorem physical_cutoff_fiber_sum_eq_ite {G R : Type*} [Fintype G] [DecidableEq G]
    [AddCommMonoid R] (P : G → Finset ℕ) (J ell : ℕ) (I : Finset ℤ) (n : ℤ)
    (f : PhysicalState P J ell → R) :
    (∑ x ∈ (physicalCutoff P J ell I).filter (fun x => x.1 = n), f x) =
      if n ∈ I then ∑ L : PhysicalMarksAt P J ell n, f ⟨n, L⟩ else 0 := by
  classical
  rw [sum_filter, physical_cutoff_sum]
  have hs (m : ℤ) :
      (∑ L : PhysicalMarksAt P J ell m, if m = n then f ⟨m, L⟩ else 0) =
        if m = n then ∑ L : PhysicalMarksAt P J ell n, f ⟨n, L⟩ else 0 := by
    by_cases hm : m = n
    · subst m
      simp
    · simp [hm]
  simp only [hs]
  simp

theorem physical_cutoff_fiber_sum {G R : Type*} [Fintype G] [DecidableEq G]
    [AddCommMonoid R] (P : G → Finset ℕ) (J ell : ℕ) (I : Finset ℤ) (n : ℤ)
    (hn : n ∈ I) (f : PhysicalState P J ell → R) :
    (∑ x ∈ (physicalCutoff P J ell I).filter (fun x => x.1 = n), f x) =
      ∑ L : PhysicalMarksAt P J ell n, f ⟨n, L⟩ := by
  rw [physical_cutoff_fiber_sum_eq_ite, if_pos hn]

theorem physical_cutoff_subtype_fiber_sum {G R : Type*} [Fintype G] [DecidableEq G]
    [AddCommMonoid R] (P : G → Finset ℕ) (J ell : ℕ) (I : Finset ℤ) (n : ℤ)
    (hn : n ∈ I) (f : ↥(physicalCutoff P J ell I) → R) :
    (∑ x ∈ (univ : Finset ↥(physicalCutoff P J ell I)).filter (fun x => x.val.1 = n),
      f x) =
      ∑ L : PhysicalMarksAt P J ell n,
        f ⟨⟨n, L⟩, (mem_physical_cutoff P J ell I ⟨n, L⟩).mpr hn⟩ := by
  classical
  let F : PhysicalState P J ell → R := fun x =>
    if hx : x ∈ physicalCutoff P J ell I then f ⟨x, hx⟩ else 0
  calc
    _ = ∑ x ∈ (physicalCutoff P J ell I).filter (fun x => x.1 = n), F x := by
      rw [sum_filter, sum_filter]
      have hh := sum_coe_sort (physicalCutoff P J ell I)
        (fun x => if x.1 = n then F x else 0)
      simpa only [F, dif_pos (Subtype.property _)] using hh
    _ = ∑ L : PhysicalMarksAt P J ell n, F ⟨n, L⟩ :=
      physical_cutoff_fiber_sum P J ell I n hn F
    _ = _ := by
      apply sum_congr rfl
      intro L _
      exact dif_pos ((mem_physical_cutoff P J ell I ⟨n, L⟩).mpr hn)

theorem mem_reachable_positions_self {I : Finset ℤ} {n : ℤ}
    (hn : n ∈ I) (radius : ℕ) : n ∈ reachablePositions I radius := by
  exact mem_reachable_positions hn (by simp)
end

section
open scoped BigOperators InnerProductSpace
theorem physical_root_moment_eq_fiber_gram {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (patterns : Finset I) (C : I → G → Finset (Fin J)) (q : ℝ)
    (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ) (starts : Finset ℤ) (R b : ℕ) (hR : 0 < R) :
    let positions := reachablePositions starts (2 * R * b)
    let A := physicalHilbertOperator V patterns C q ζ k K positions
    let u : ℤ → EuclideanSpace ℂ (physicalCutoff P J ell positions) :=
      fun n => finiteFiberVector (fun x : physicalCutoff P J ell positions => x.val.1)
        (physicalStateMass V J ell) n
    physicalRootMoment V patterns C q
      (fun j i => if j % 2 = 0 then -ζ i else ζ i)
      (fun j i => if j % 2 = 0 then -k i else k i)
      (fun j i a c aux => if j % 2 = 0 then (starRingEnd ℂ) (K i c a aux) else K i a c aux)
      starts (2 * R - 1) b =
      (∑ n ∈ starts, inner ℂ (u n) (((A * A.adjoint) ^ R) (u n))) /
        (starts.card : ℂ) := by
  dsimp only
  have hlen : 2 * R - 1 + 1 = 2 * R := by omega
  have hmass := (physical_state_mass_pos V hV J ell).le
  let base : PhysicalState P J ell → PhysicalState P J ell → ℂ :=
    fun x y => physicalSymmetricKernel (fun s t => ∑ i ∈ patterns,
      physicalPatternKernel V (C i) q (ζ i) (k i) (K i) s t) x y
  have hg := finite_cutoff_fiber_gram_eq_return_root
    (physicalCutoff P J ell (reachablePositions starts (2 * R * b)))
    (fun x : PhysicalState P J ell => x.1) hmass base starts R
  have hs : (∑ n ∈ starts,
      ∑ x ∈ (physicalCutoff P J ell (reachablePositions starts (2 * R * b))).filter
        (fun x => x.1 = n),
      finiteCutoffAction (physicalCutoff P J ell (reachablePositions starts (2 * R * b)))
        (finiteGramAlternatingKernel base) (fun y => if y.1 = n then 1 else 0) (2 * R) x) =
      ∑ n ∈ starts, ∑ L : PhysicalMarksAt P J ell n,
      finiteCutoffAction (physicalCutoff P J ell (reachablePositions starts (2 * R * b)))
        (finiteGramAlternatingKernel base) (fun y => if y.1 = n then 1 else 0) (2 * R) ⟨n, L⟩ := by
    apply Finset.sum_congr rfl
    intro n hn
    exact physical_cutoff_fiber_sum P J ell (reachablePositions starts (2 * R * b)) n
      (mem_reachable_positions hn (by simp)) _
  rw [hs] at hg
  unfold physicalRootMoment
  rw [hlen, physical_symmetric_alternating_kernel]
  exact congrArg (fun z : ℂ => z / (starts.card : ℂ)) hg.symm

theorem physical_root_moment_re_eq_fiber_gram {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (patterns : Finset I) (C : I → G → Finset (Fin J)) (q : ℝ)
    (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ) (starts : Finset ℤ) (R b : ℕ) (hR : 0 < R) :
    let positions := reachablePositions starts (2 * R * b)
    let A := physicalHilbertOperator V patterns C q ζ k K positions
    let u : ℤ → EuclideanSpace ℂ (physicalCutoff P J ell positions) :=
      fun n => finiteFiberVector (fun x : physicalCutoff P J ell positions => x.val.1)
        (physicalStateMass V J ell) n
    (physicalRootMoment V patterns C q
      (fun j i => if j % 2 = 0 then -ζ i else ζ i)
      (fun j i => if j % 2 = 0 then -k i else k i)
      (fun j i a c aux => if j % 2 = 0 then (starRingEnd ℂ) (K i c a aux) else K i a c aux)
      starts (2 * R - 1) b).re =
      (∑ n ∈ starts, (inner ℂ (u n) (((A * A.adjoint) ^ R) (u n))).re) /
        (starts.card : ℝ) := by
  dsimp only
  have h := congrArg Complex.re
    (physical_root_moment_eq_fiber_gram V hV patterns C q ζ k K starts R b hR)
  simpa only [← Complex.ofReal_natCast, Complex.div_ofReal_re, Complex.re_sum] using h
end

section
open Finset
noncomputable def primeOccupancyWeight (q : ℝ) (n : ℕ) : ℝ :=
  q^n.primeFactors.card / (n : ℝ)

theorem prime_occupancy_weight_one (q : ℝ) : primeOccupancyWeight q 1 = 1 := by
  simp [primeOccupancyWeight]

theorem prime_occupancy_weight_mul (q : ℝ) {m n : ℕ} (h : m.Coprime n) :
    primeOccupancyWeight q (m * n) = primeOccupancyWeight q m * primeOccupancyWeight q n := by
  simp only [primeOccupancyWeight, h.primeFactors_mul,
    card_union_of_disjoint h.disjoint_primeFactors, pow_add, Nat.cast_mul, mul_div_mul_comm]

theorem norm_prime_occupancy_weight (q : ℝ) (n : ℕ) :
    ‖primeOccupancyWeight q n‖ = primeOccupancyWeight ‖q‖ n := by
  simp [primeOccupancyWeight, norm_div, norm_pow]

theorem prime_occupancy_weight_prime_pow_succ (q : ℝ) {p : ℕ} (hp : p.Prime) (e : ℕ) :
    primeOccupancyWeight q (p^(e + 1)) = q / (p : ℝ)^(e + 1) := by
  simp [primeOccupancyWeight, Nat.primeFactors_prime_pow (Nat.succ_ne_zero e) hp]

theorem hasSum_prime_occupancy_prime_powers (q : ℝ) {p : ℕ} (hp : p.Prime) :
    HasSum (fun e : ℕ => primeOccupancyWeight q (p^e)) (1 + q / ((p : ℝ) - 1)) := by
  have hp1 : (1 : ℝ) < p := by exact_mod_cast hp.one_lt
  have hp0 : (0 : ℝ) < p := by linarith
  have hpinv : (p : ℝ)⁻¹ < 1 := (inv_lt_one₀ hp0).mpr hp1
  have hgeo := hasSum_geometric_of_lt_one (inv_nonneg.mpr hp0.le) hpinv
  have htail : HasSum (fun e : ℕ => primeOccupancyWeight q (p^(e + 1)))
      (q / ((p : ℝ) - 1)) := by
    have he : (fun e : ℕ => primeOccupancyWeight q (p^(e + 1))) =
        (fun e : ℕ => (q / (p : ℝ)) * (p : ℝ)⁻¹^e) := by
      funext e
      rw [prime_occupancy_weight_prime_pow_succ q hp e, pow_succ]
      simp only [div_eq_mul_inv, mul_inv, inv_pow]
      ring
    have hv : (q / (p : ℝ)) * (1 - (p : ℝ)⁻¹)⁻¹ = q / ((p : ℝ) - 1) := by
      field_simp
    rw [he, ← hv]
    exact hgeo.mul_left (q / (p : ℝ))
  have hh := (hasSum_nat_add_iff (f := fun e => primeOccupancyWeight q (p^e)) 1).mp htail
  simpa [prime_occupancy_weight_one, add_comm] using hh

theorem prime_occupancy_prime_powers_summable_norm (q : ℝ) {p : ℕ} (hp : p.Prime) :
    Summable (fun e : ℕ => ‖primeOccupancyWeight q (p^e)‖) := by
  simpa only [norm_prime_occupancy_weight] using
    (hasSum_prime_occupancy_prime_powers ‖q‖ hp).summable

theorem prime_occupancy_summable_and_sum (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) (q : ℝ) :
    Summable (fun n : Nat.factoredNumbers P => ‖primeOccupancyWeight q n.val‖) ∧
      (∑' n : Nat.factoredNumbers P, primeOccupancyWeight q n.val) =
        ∏ p ∈ P, (1 + q / ((p : ℝ) - 1)) := by
  obtain ⟨hsum, hvalue⟩ :=
    EulerProduct.summable_and_hasSum_factoredNumbers_prod_filter_prime_tsum
      (prime_occupancy_weight_one q) (prime_occupancy_weight_mul q)
      (prime_occupancy_prime_powers_summable_norm q) P
  refine ⟨hsum, ?_⟩
  rw [hvalue.tsum_eq, filter_eq_self.mpr hP]
  apply prod_congr rfl
  intro p hp
  exact (hasSum_prime_occupancy_prime_powers q (hP p hp)).tsum_eq

theorem prime_occupancy_euler_product (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) (q : ℝ) :
    (∑' n : Nat.factoredNumbers P, q^n.val.primeFactors.card / (n.val : ℝ)) =
      ∏ p ∈ P, (1 + q / ((p : ℝ) - 1)) :=
  (prime_occupancy_summable_and_sum P hP q).2
end

section
open Finset
theorem prime_euler_log_lower {p q : ℝ} (hp : 1 < p) (hq0 : 0 ≤ q) (hq1 : q ≤ 1) :
    q / p ≤ Real.log (1 + q / (p - 1)) := by
  have hp0 : 0 < p := zero_lt_one.trans hp
  have hden : 0 < p - 1 := sub_pos.mpr hp
  have hsum : 0 < p - 1 + q := by positivity
  have hfactor : 0 < 1 + q / (p - 1) := by positivity
  calc
    q / p ≤ q / (p - 1 + q) :=
      div_le_div_of_nonneg_left hq0 hsum (by linarith)
    _ = 1 - (1 + q / (p - 1))⁻¹ := by field_simp; ring
    _ ≤ _ := Real.one_sub_inv_le_log_of_pos hfactor

theorem prime_euler_product_lower (P : Finset ℕ)
    (hP : ∀ p ∈ P, (1 : ℝ) < p) {q : ℝ} (hq0 : 0 ≤ q) (hq1 : q ≤ 1) :
    Real.exp (q * ∑ p ∈ P, 1 / (p : ℝ)) ≤
      ∏ p ∈ P, (1 + q / ((p : ℝ) - 1)) := by
  rw [mul_sum]
  simp only [mul_one_div]
  rw [Real.exp_sum]
  apply prod_le_prod₀ (fun _ _ => (Real.exp_pos _).le)
  intro p hp
  have hden : 0 < (p : ℝ) - 1 := sub_pos.mpr (hP p hp)
  exact (Real.le_log_iff_exp_le (by positivity)).mp
    (prime_euler_log_lower (hP p hp) hq0 hq1)

theorem prime_euler_factor_upper {p q : ℝ} (hp : 2 ≤ p) (hq1 : q ≤ 1) :
    1 + q / (p - 1) ≤ Real.exp (q / p + 2 / p^2) := by
  have hp0 : 0 < p := by linarith
  have hden : 0 < p - 1 := by linarith
  have he : q / p + 2 / p^2 = (q * p + 2) / p^2 := by field_simp
  have hbound : q / (p - 1) ≤ q / p + 2 / p^2 := by
    rw [he]
    apply (div_le_div_iff₀ hden (sq_pos_of_pos hp0)).mpr
    nlinarith [mul_le_mul_of_nonneg_right hq1 hp0.le]
  have hexp : 1 + q / (p - 1) ≤ Real.exp (q / (p - 1)) := by
    simpa only [add_comm] using Real.add_one_le_exp (q / (p - 1))
  exact hexp.trans (Real.exp_le_exp.mpr hbound)

theorem prime_euler_product_upper (P : Finset ℕ)
    (hP : ∀ p ∈ P, (2 : ℝ) ≤ p) {q : ℝ} (hq0 : 0 ≤ q) (hq1 : q ≤ 1) :
    (∏ p ∈ P, (1 + q / ((p : ℝ) - 1))) ≤
      Real.exp (q * (∑ p ∈ P, 1 / (p : ℝ)) + 2 * (∑ p ∈ P, 1 / (p : ℝ)^2)) := by
  calc
    _ ≤ ∏ p ∈ P, Real.exp (q / (p : ℝ) + 2 / (p : ℝ)^2) := by
      apply prod_le_prod₀
      · intro p hp
        have hden : 0 < (p : ℝ) - 1 := by linarith [hP p hp]
        positivity
      · intro p hp
        exact prime_euler_factor_upper (hP p hp) hq1
    _ = Real.exp (∑ p ∈ P, (q / (p : ℝ) + 2 / (p : ℝ)^2)) := (Real.exp_sum _ _).symm
    _ = _ := by
      congr 1
      simp only [sum_add_distrib, mul_sum, mul_one_div]
end

section
open Finset
/-- Marking one element of a weighted subset is the derivative of the
finite subset generating polynomial. No positivity assumption is needed. -/
theorem finite_marked_subset_sum {α : Type*} [DecidableEq α]
    (P : Finset α) (q : ℝ) (a : α → ℝ) :
    (∑ S ∈ P.powerset, (S.card : ℝ) * q^(S.card - 1) * ∏ p ∈ S, a p) =
      ∑ p ∈ P, a p * ∏ r ∈ P.erase p, (1 + q * a r) := by
  classical
  have he : (fun x : ℝ => ∑ S ∈ P.powerset, x^S.card * ∏ p ∈ S, a p) =
      (fun x : ℝ => ∏ p ∈ P, (1 + x * a p)) := by
    funext x
    simpa only [one_pow, mul_one] using subset_weighted_product_expansion P x 1 a
  have hleft : HasDerivAt
      (fun x : ℝ => ∑ S ∈ P.powerset, x^S.card * ∏ p ∈ S, a p)
      (∑ S ∈ P.powerset, (S.card : ℝ) * q^(S.card - 1) * ∏ p ∈ S, a p) q := by
    exact HasDerivAt.fun_sum (fun S _ => (hasDerivAt_pow S.card q).mul_const _)
  have hlocal : ∀ p ∈ P, HasDerivAt (fun x : ℝ => 1 + x * a p) (a p) q := by
    intro p _
    simpa only [id_eq, one_mul] using ((hasDerivAt_id q).mul_const (a p)).const_add 1
  have hright : HasDerivAt (fun x : ℝ => ∏ p ∈ P, (1 + x * a p))
      (∑ p ∈ P, a p * ∏ r ∈ P.erase p, (1 + q * a r)) q := by
    simpa only [smul_eq_mul, mul_comm] using HasDerivAt.fun_finsetProd hlocal
  rw [he] at hleft
  exact hleft.unique hright

/-- Factor the marked polynomial as its unmarked product times the
sum of individual mark-to-unmarked ratios. -/
theorem finite_marked_subset_factor {α : Type*} (P : Finset α) (q : ℝ) (a : α → ℝ)
    (hn : ∀ p ∈ P, 1 + q * a p ≠ 0) :
    (∑ S ∈ P.powerset, (S.card : ℝ) * q^(S.card - 1) * ∏ p ∈ S, a p) =
      (∏ p ∈ P, (1 + q * a p)) * ∑ p ∈ P, a p / (1 + q * a p) := by
  classical
  rw [finite_marked_subset_sum, mul_sum]
  apply sum_congr rfl
  intro p hp
  rw [← prod_erase_mul P (fun r => 1 + q * a r) hp]
  have hn' : 1 + a p * q ≠ 0 := by simpa only [mul_comm] using hn p hp
  field_simp [hn p hp, hn']

/-- For 0 ≤ q ≤ 1, marking a prime contributes at least its harmonic
mass relative to the unmarked Euler factor. -/
theorem reciprocal_prime_mark_ratio {x q : ℝ} (hx : 1 < x)
    (hq0 : 0 ≤ q) (hq1 : q ≤ 1) :
    1 / x ≤ (1 / (x - 1)) / (1 + q * (1 / (x - 1))) := by
  have hx1 : 0 < x - 1 := sub_pos.mpr hx
  have hden : 0 < x - 1 + q := by linarith
  have hfac : 0 < 1 + q * (1 / (x - 1)) := by positivity
  have he : (1 / (x - 1)) / (1 + q * (1 / (x - 1))) = 1 / (x - 1 + q) := by
    field_simp
  rw [he]
  exact one_div_le_one_div_of_le hden (by linarith)

/-- The normalized one-mark subset expression dominates the unmarked
Euler product when V is the reciprocal-prime mass of the group. -/
theorem finite_marked_prime_subset_lower_bound (P : Finset ℕ)
    (hP : ∀ p ∈ P, 1 < p) {q V : ℝ} (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (hV : 0 < V) (hmass : (∑ p ∈ P, 1 / (p : ℝ)) = V) :
    (∏ p ∈ P, (1 + q / ((p : ℝ) - 1))) ≤
      (∑ S ∈ P.powerset, (S.card : ℝ) * q^(S.card - 1) *
        ∏ p ∈ S, 1 / ((p : ℝ) - 1)) / V := by
  have hpos : ∀ p ∈ P, 0 < 1 + q * (1 / ((p : ℝ) - 1)) := by
    intro p hp
    have hx : (1 : ℝ) < p := by exact_mod_cast hP p hp
    have hx1 : 0 < (p : ℝ) - 1 := sub_pos.mpr hx
    positivity
  have he := finite_marked_subset_factor P q (fun p => 1 / ((p : ℝ) - 1))
    (fun p hp => (hpos p hp).ne')
  rw [he]
  have hsum : V ≤ ∑ p ∈ P, (1 / ((p : ℝ) - 1)) / (1 + q * (1 / ((p : ℝ) - 1))) := by
    rw [← hmass]
    exact sum_le_sum (fun p hp => reciprocal_prime_mark_ratio (by exact_mod_cast hP p hp) hq0 hq1)
  have hprod : 0 ≤ ∏ p ∈ P, (1 + q * (1 / ((p : ℝ) - 1))) :=
    prod_nonneg (fun p hp => (hpos p hp).le)
  simp only [div_eq_mul_inv, one_mul] at *
  rw [← div_eq_mul_inv]
  apply (le_div_iff₀ hV).mpr
  exact mul_le_mul_of_nonneg_left hsum hprod
end

section
open Set
theorem bounded_power_norm_le {y B : ℝ} (hB : 1 ≤ B) (hy : |y| ≤ B)
    {m N : ℕ} (hm : m ≤ N) : ‖y^m‖ ≤ B^N := by
  rw [norm_pow, Real.norm_eq_abs]
  exact (pow_le_pow_left₀ (abs_nonneg y) hy m).trans (pow_le_pow_right₀ hB hm)

theorem summable_bounded_powers {ι : Type*} (a : ι → ℝ)
    (ha : Summable (fun i => ‖a i‖)) (m : ι → ℕ) (N : ℕ)
    (hm : ∀ i, m i ≤ N) (q : ℝ) : Summable (fun i => a i * q^(m i)) := by
  apply (ha.mul_right ((|q| + 1)^N)).of_norm_bounded
  intro i
  rw [norm_mul]
  exact mul_le_mul_of_nonneg_left
    (bounded_power_norm_le (by linarith [abs_nonneg q]) (by linarith) (hm i)) (norm_nonneg _)

theorem bounded_power_derivative_norm_le {a y B : ℝ} (hB : 1 ≤ B) (hy : |y| ≤ B)
    {m N : ℕ} (hm : m ≤ N) :
    ‖a * (m : ℝ) * y^(m - 1)‖ ≤ ‖a‖ * ((N : ℝ) * B^N) := by
  have hm' : (m : ℝ) ≤ N := by exact_mod_cast hm
  have hpow := bounded_power_norm_le hB hy ((Nat.sub_le m 1).trans hm)
  rw [norm_mul, norm_mul, Real.norm_eq_abs (m : ℝ), abs_of_nonneg (Nat.cast_nonneg m)]
  calc
    ‖a‖ * (m : ℝ) * ‖y^(m - 1)‖ ≤ ‖a‖ * (N : ℝ) * B^N :=
      mul_le_mul (mul_le_mul_of_nonneg_left hm' (norm_nonneg _)) hpow
        (norm_nonneg _) (by positivity)
    _ = _ := by ring

theorem summable_bounded_power_derivatives {ι : Type*} (a : ι → ℝ)
    (ha : Summable (fun i => ‖a i‖)) (m : ι → ℕ) (N : ℕ)
    (hm : ∀ i, m i ≤ N) (q : ℝ) :
    Summable (fun i => a i * (m i : ℝ) * q^(m i - 1)) := by
  apply (ha.mul_right ((N : ℝ) * (|q| + 1)^N)).of_norm_bounded
  intro i
  exact bounded_power_derivative_norm_le (by linarith [abs_nonneg q]) (by linarith) (hm i)

/-- The bounded exponent hypothesis supplies a summable derivative majorant
on a neighborhood of every q, including q = 0 and maximum exponent N = 0. -/
theorem hasDerivAt_tsum_bounded_powers {ι : Type*} (a : ι → ℝ)
    (ha : Summable (fun i => ‖a i‖)) (m : ι → ℕ) (N : ℕ)
    (hm : ∀ i, m i ≤ N) (q : ℝ) :
    HasDerivAt (fun x : ℝ => ∑' i, a i * x^(m i))
      (∑' i, a i * (m i : ℝ) * q^(m i - 1)) q := by
  have hB : 1 ≤ |q| + 1 := by linarith [abs_nonneg q]
  have hq : q ∈ Ioo (q - 1) (q + 1) := ⟨by linarith, by linarith⟩
  apply hasDerivAt_tsum_of_isPreconnected
    (ha.mul_right ((N : ℝ) * (|q| + 1)^N)) isOpen_Ioo (convex_Ioo _ _).isPreconnected
    (g := fun i x => a i * x^(m i))
    (g' := fun i x => a i * (m i : ℝ) * x^(m i - 1))
    ?_ ?_ hq (summable_bounded_powers a ha m N hm q) hq
  · intro i x _
    simpa only [mul_assoc] using (hasDerivAt_pow (m i) x).const_mul (a i)
  · intro i x hx
    have hxq : |x - q| < 1 := abs_lt.mpr ⟨by linarith [hx.1], by linarith [hx.2]⟩
    have hxB : |x| ≤ |q| + 1 := by
      have htri := abs_add_le (x - q) q
      have he : x - q + q = x := by ring
      rw [he] at htri
      linarith
    exact bounded_power_derivative_norm_le hB hxB (hm i)

theorem differentiable_tsum_bounded_powers {ι : Type*} (a : ι → ℝ)
    (ha : Summable (fun i => ‖a i‖)) (m : ι → ℕ) (N : ℕ)
    (hm : ∀ i, m i ≤ N) : Differentiable ℝ (fun x : ℝ => ∑' i, a i * x^(m i)) := by
  intro q
  exact (hasDerivAt_tsum_bounded_powers a ha m N hm q).differentiableAt
end

section
open Finset
theorem physical_divisor_pool_eq_primeFactors {G : Type*} (P : G → Finset ℕ) (g : G)
    (hP : ∀ p ∈ P g, p.Prime) {n : ℕ} (hn : n ∈ Nat.factoredNumbers (P g)) :
    physicalDivisorPool P g (n : ℤ) = n.primeFactors := by
  ext p
  simp only [physicalDivisorPool, mem_filter, Nat.mem_primeFactors]
  constructor
  · rintro ⟨hp, hpn⟩
    exact ⟨hP p hp, by exact_mod_cast hpn, Nat.ne_zero_of_mem_factoredNumbers hn⟩
  · rintro ⟨hp, hpn, hn0⟩
    exact ⟨Nat.primeFactors_subset_of_mem_factoredNumbers hn
      (Nat.mem_primeFactors.mpr ⟨hp, hpn, hn0⟩), by exact_mod_cast hpn⟩

theorem physical_omega_eq_primeFactors_card {G : Type*} (P : G → Finset ℕ) (g : G)
    (hP : ∀ p ∈ P g, p.Prime) {n : ℕ} (hn : n ∈ Nat.factoredNumbers (P g)) :
    physicalOmega P g (n : ℤ) = n.primeFactors.card := by
  exact congrArg Finset.card (physical_divisor_pool_eq_primeFactors P g hP hn)

theorem one_marked_divisor_factor_eq (q V : ℝ) (omega : ℕ) :
    markedDivisorFactor q V omega 1 = (omega : ℝ) * q^(omega-1) / V := by
  simp [markedDivisorFactor]

theorem one_marked_physical_factor_eq {G : Type*} (P : G → Finset ℕ) (g : G)
    (hP : ∀ p ∈ P g, p.Prime) {n : ℕ} (hn : n ∈ Nat.factoredNumbers (P g)) (q V : ℝ) :
    markedDivisorFactor q V (physicalOmega P g (n : ℤ)) 1 =
      (n.primeFactors.card : ℝ) * q^(n.primeFactors.card-1) / V := by
  rw [physical_omega_eq_primeFactors_card P g hP hn, one_marked_divisor_factor_eq]
end

section
open Finset
theorem prime_supported_reciprocal_summable (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) :
    Summable (fun n : Nat.factoredNumbers P => 1 / (n.val : ℝ)) := by
  simpa only [neg_mul, Real.rpow_neg_one, one_div] using
    (smooth_rpow_summable_and_sum P hP (show (0 : ℝ) < 1 by norm_num)).1

theorem prime_one_marked_harmonic_summable (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) (q : ℝ) :
    Summable (fun n : Nat.factoredNumbers P =>
      (n.val.primeFactors.card : ℝ) * q^(n.val.primeFactors.card - 1) / (n.val : ℝ)) := by
  have h := summable_bounded_power_derivatives
    (fun n : Nat.factoredNumbers P => 1 / (n.val : ℝ))
    (prime_supported_reciprocal_summable P hP).norm
    (fun n => n.val.primeFactors.card) P.card
    (fun n => card_le_card (Nat.primeFactors_subset_of_mem_factoredNumbers n.property)) q
  convert h using 1
  funext n
  ring

theorem prime_one_marked_harmonic_sum (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) (q : ℝ) :
    (∑' n : Nat.factoredNumbers P,
      (n.val.primeFactors.card : ℝ) * q^(n.val.primeFactors.card - 1) / (n.val : ℝ)) =
      ∑ p ∈ P, (1 / ((p : ℝ) - 1)) *
        ∏ r ∈ P.erase p, (1 + q / ((r : ℝ) - 1)) := by
  classical
  have hd := hasDerivAt_tsum_bounded_powers
    (fun n : Nat.factoredNumbers P => 1 / (n.val : ℝ))
    (prime_supported_reciprocal_summable P hP).norm
    (fun n => n.val.primeFactors.card) P.card
    (fun n => card_le_card (Nat.primeFactors_subset_of_mem_factoredNumbers n.property)) q
  have he : (fun x : ℝ => ∑' n : Nat.factoredNumbers P,
      (1 / (n.val : ℝ)) * x^n.val.primeFactors.card) =
      (fun x => ∏ p ∈ P, (1 + x / ((p : ℝ) - 1))) := by
    funext x
    rw [← prime_occupancy_euler_product P hP x]
    apply tsum_congr
    intro n
    ring
  rw [he] at hd
  have hp : ∀ p ∈ P, HasDerivAt (fun x : ℝ => 1 + x / ((p : ℝ) - 1))
      (1 / ((p : ℝ) - 1)) q := by
    intro p _
    simpa only [id_eq] using ((hasDerivAt_id q).div_const ((p : ℝ) - 1)).const_add 1
  have hd' : HasDerivAt (fun x : ℝ => ∏ p ∈ P, (1 + x / ((p : ℝ) - 1)))
      (∑ p ∈ P, (1 / ((p : ℝ) - 1)) * ∏ r ∈ P.erase p, (1 + q / ((r : ℝ) - 1))) q := by
    simpa only [smul_eq_mul, mul_comm] using HasDerivAt.fun_finsetProd hp
  calc
    _ = ∑' n : Nat.factoredNumbers P,
        (1 / (n.val : ℝ)) * (n.val.primeFactors.card : ℝ) * q^(n.val.primeFactors.card - 1) := by
      apply tsum_congr
      intro n
      ring
    _ = _ := hd.unique hd'

theorem prime_one_marked_harmonic_eq_subset (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) (q : ℝ) :
    (∑' n : Nat.factoredNumbers P,
      (n.val.primeFactors.card : ℝ) * q^(n.val.primeFactors.card - 1) / (n.val : ℝ)) =
      ∑ S ∈ P.powerset, (S.card : ℝ) * q^(S.card - 1) *
        ∏ p ∈ S, 1 / ((p : ℝ) - 1) := by
  rw [prime_one_marked_harmonic_sum P hP q, finite_marked_subset_sum]
  simp only [mul_one_div]

theorem normalized_one_marked_harmonic_lower (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) {q V : ℝ} (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (hV : 0 < V) (hmass : (∑ p ∈ P, 1 / (p : ℝ)) = V) :
    (∏ p ∈ P, (1 + q / ((p : ℝ) - 1))) ≤
      (∑' n : Nat.factoredNumbers P,
        (n.val.primeFactors.card : ℝ) * q^(n.val.primeFactors.card - 1) / (n.val : ℝ)) / V := by
  rw [prime_one_marked_harmonic_eq_subset P hP q]
  exact finite_marked_prime_subset_lower_bound P (fun p hp => (hP p hp).one_lt) hq0 hq1 hV hmass

noncomputable def oneMarkedHarmonicMass (P : Finset ℕ) (q V : ℝ) : ℝ :=
  ∑' n : Nat.factoredNumbers P,
    markedDivisorFactor q V n.val.primeFactors.card 1 / (n.val : ℝ)

theorem one_marked_harmonic_mass_eq_normalized (P : Finset ℕ) (q V : ℝ) :
    oneMarkedHarmonicMass P q V =
      (∑' n : Nat.factoredNumbers P,
        (n.val.primeFactors.card : ℝ) * q^(n.val.primeFactors.card - 1) / (n.val : ℝ)) / V := by
  rw [← tsum_div_const]
  apply tsum_congr
  intro n
  rw [one_marked_divisor_factor_eq]
  ring

theorem one_marked_harmonic_summable (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) (q V : ℝ) :
    Summable (fun n : Nat.factoredNumbers P =>
      markedDivisorFactor q V n.val.primeFactors.card 1 / (n.val : ℝ)) := by
  have h := (prime_one_marked_harmonic_summable P hP q).div_const V
  convert h using 1 <;> try rfl
  funext n
  rw [one_marked_divisor_factor_eq]
  ring

theorem one_marked_harmonic_mass_eq_euler (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) {q V : ℝ} (hq : 0 ≤ q) :
    oneMarkedHarmonicMass P q V =
      ((∏ p ∈ P, (1 + q / ((p : ℝ) - 1))) / V) *
        ∑ p ∈ P, 1 / ((p : ℝ) - 1 + q) := by
  have hp0 (p : ℕ) (hp : p ∈ P) : 0 < (p : ℝ) - 1 := by
    have h : (1 : ℝ) < p := by exact_mod_cast (hP p hp).one_lt
    linarith
  have hfac (p : ℕ) (hp : p ∈ P) : 1 + q * (1 / ((p : ℝ) - 1)) ≠ 0 := by
    have h := hp0 p hp
    positivity
  rw [one_marked_harmonic_mass_eq_normalized, prime_one_marked_harmonic_eq_subset P hP q,
    finite_marked_subset_factor P q (fun p => 1 / ((p : ℝ) - 1)) hfac]
  have he : (∑ p ∈ P, (1 / ((p : ℝ) - 1)) / (1 + q * (1 / ((p : ℝ) - 1)))) =
      ∑ p ∈ P, 1 / ((p : ℝ) - 1 + q) := by
    apply sum_congr rfl
    intro p hp
    have h := hp0 p hp
    have h' : 0 < (p : ℝ) - 1 + q := by linarith
    field_simp
  rw [he]
  simp only [mul_one_div]
  ring

theorem one_marked_harmonic_mass_ge_exp (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) {q V : ℝ} (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (hV : 0 < V) (hmass : (∑ p ∈ P, 1 / (p : ℝ)) = V) :
    Real.exp (q * V) ≤ oneMarkedHarmonicMass P q V := by
  have hprod := prime_euler_product_lower P
    (fun p hp => show (1 : ℝ) < p by exact_mod_cast (hP p hp).one_lt) hq0 hq1
  rw [hmass] at hprod
  rw [one_marked_harmonic_mass_eq_normalized]
  exact hprod.trans (normalized_one_marked_harmonic_lower P hP hq0 hq1 hV hmass)
end

section
open Finset
theorem mul_mem_factoredNumbers_union {P Q : Finset ℕ} {a b : ℕ}
    (ha : a ∈ Nat.factoredNumbers P) (hb : b ∈ Nat.factoredNumbers Q) :
    a * b ∈ Nat.factoredNumbers (P ∪ Q) :=
  Nat.mul_mem_factoredNumbers
    (Nat.factoredNumbers_mono subset_union_left ha)
    (Nat.factoredNumbers_mono subset_union_right hb)

theorem primePoolPart_eq_self_of_mem {P : Finset ℕ} {n : ℕ}
    (hn : n ∈ Nat.factoredNumbers P) : primePoolPart P n = n := by
  have h := primePoolPart_mul_primePoolFreePart P n
  rw [(mem_factoredNumbers_iff_primePoolFreePart_eq_one P n).mp hn, mul_one] at h
  exact h

theorem primePoolPart_eq_one_of_disjoint {P Q : Finset ℕ} (hPQ : Disjoint P Q)
    {n : ℕ} (hn : n ∈ Nat.factoredNumbers Q) : primePoolPart P n = 1 := by
  have hf : n.factorization.filter (fun p => p ∈ P) = 0 := by
    ext p
    by_cases hp : p ∈ P
    · have hfac : n.factorization p = 0 := by
        by_contra h
        exact disjoint_left.mp hPQ hp
          (Nat.primeFactors_subset_of_mem_factoredNumbers hn (Finsupp.mem_support_iff.mpr h))
      simp [hp, hfac]
    · simp [hp]
  simp [primePoolPart, hf]

theorem primePoolPart_mul (P : Finset ℕ) {a b : ℕ} (ha : a ≠ 0) (hb : b ≠ 0) :
    primePoolPart P (a * b) = primePoolPart P a * primePoolPart P b := by
  simp only [primePoolPart_eq_prod, Nat.factorization_mul ha hb, Finsupp.add_apply,
    pow_add, prod_mul_distrib]

theorem primePoolPart_mul_of_disjoint {P Q : Finset ℕ} (hPQ : Disjoint P Q)
    {a b : ℕ} (ha : a ∈ Nat.factoredNumbers P) (hb : b ∈ Nat.factoredNumbers Q) :
    primePoolPart P (a * b) = a := by
  rw [primePoolPart_mul P ha.1 hb.1, primePoolPart_eq_self_of_mem ha,
    primePoolPart_eq_one_of_disjoint hPQ hb, mul_one]

theorem primePoolFreePart_mul_of_disjoint {P Q : Finset ℕ} (hPQ : Disjoint P Q)
    {a b : ℕ} (ha : a ∈ Nat.factoredNumbers P) (hb : b ∈ Nat.factoredNumbers Q) :
    primePoolFreePart P (a * b) = b := by
  rw [primePoolFreePart, primePoolPart_mul_of_disjoint hPQ ha hb]
  exact Nat.mul_div_cancel_left _ (Nat.pos_of_ne_zero ha.1)

/-- The part complementary to P is Q-supported whenever the original number is P-union-Q-supported. -/
theorem primePoolFreePart_mem_of_union {P Q : Finset ℕ} {n : ℕ}
    (hn : n ∈ Nat.factoredNumbers (P ∪ Q)) :
    primePoolFreePart P n ∈ Nat.factoredNumbers Q := by
  apply Nat.mem_factoredNumbers_of_primeFactors_subset (primePoolFreePart_ne_zero P hn.1)
  intro p hp
  rw [← Nat.support_factorization, factorization_primePoolFreePart, Finsupp.support_filter] at hp
  obtain ⟨hfac, hnot⟩ := mem_filter.mp hp
  exact (mem_union.mp (Nat.primeFactors_subset_of_mem_factoredNumbers hn hfac)).resolve_left hnot

/-- Multiplication is a bijection from the two supported factors to their disjoint union. -/
noncomputable def disjointPrimePoolProductEquiv (P Q : Finset ℕ) (hPQ : Disjoint P Q) :
    Nat.factoredNumbers P × Nat.factoredNumbers Q ≃ Nat.factoredNumbers (P ∪ Q) where
  toFun x := ⟨x.1.val * x.2.val, mul_mem_factoredNumbers_union x.1.property x.2.property⟩
  invFun n := (⟨primePoolPart P n.val, primePoolPart_mem_factoredNumbers P n.val⟩,
    ⟨primePoolFreePart P n.val, primePoolFreePart_mem_of_union n.property⟩)
  left_inv x := by
    apply Prod.ext <;> apply Subtype.ext
    · exact primePoolPart_mul_of_disjoint hPQ x.1.property x.2.property
    · exact primePoolFreePart_mul_of_disjoint hPQ x.1.property x.2.property
  right_inv n := Subtype.ext (primePoolPart_mul_primePoolFreePart P n.val)

theorem disjointPrimePoolProductEquiv_apply (P Q : Finset ℕ) (hPQ : Disjoint P Q)
    (x : Nat.factoredNumbers P × Nat.factoredNumbers Q) :
    (disjointPrimePoolProductEquiv P Q hPQ x).val = x.1.val * x.2.val := rfl

theorem disjointPrimePoolProductEquiv_symm_fst (P Q : Finset ℕ) (hPQ : Disjoint P Q)
    (n : Nat.factoredNumbers (P ∪ Q)) :
    ((disjointPrimePoolProductEquiv P Q hPQ).symm n).1.val = primePoolPart P n.val := rfl

theorem disjointPrimePoolProductEquiv_symm_snd (P Q : Finset ℕ) (hPQ : Disjoint P Q)
    (n : Nat.factoredNumbers (P ∪ Q)) :
    ((disjointPrimePoolProductEquiv P Q hPQ).symm n).2.val = primePoolFreePart P n.val := rfl

/-- The complementary factor is equally the restricted Q-prime part. -/
theorem primePoolFreePart_eq_other_part {P Q : Finset ℕ} (hPQ : Disjoint P Q)
    {n : ℕ} (hn : n ∈ Nat.factoredNumbers (P ∪ Q)) :
    primePoolFreePart P n = primePoolPart Q n := by
  conv_rhs => rw [← primePoolPart_mul_primePoolFreePart P n]
  rw [primePoolPart_mul Q (primePoolPart_ne_zero P n) (primePoolFreePart_ne_zero P hn.1),
    primePoolPart_eq_one_of_disjoint hPQ.symm (primePoolPart_mem_factoredNumbers P n),
    primePoolPart_eq_self_of_mem (primePoolFreePart_mem_of_union hn), one_mul]

/-- The two factors have coprime values, as required for multiplicative arithmetic functions. -/
theorem coprime_of_disjoint_factoredNumbers {P Q : Finset ℕ} (hPQ : Disjoint P Q)
    {a b : ℕ} (ha : a ∈ Nat.factoredNumbers P) (hb : b ∈ Nat.factoredNumbers Q) :
    a.Coprime b := by
  apply (Nat.disjoint_primeFactors ha.1 hb.1).mp
  exact hPQ.mono (Nat.primeFactors_subset_of_mem_factoredNumbers ha)
    (Nat.primeFactors_subset_of_mem_factoredNumbers hb)

/-- Reindex any real-valued series over a disjoint prime-pool union. -/
theorem tsum_factoredNumbers_union_eq (P Q : Finset ℕ) (hPQ : Disjoint P Q) (f : ℕ → ℝ) :
    (∑' n : Nat.factoredNumbers (P ∪ Q), f n.val) =
      ∑' x : Nat.factoredNumbers P × Nat.factoredNumbers Q, f (x.1.val * x.2.val) :=
  ((disjointPrimePoolProductEquiv P Q hPQ).tsum_eq (fun n => f n.val)).symm
end

section

theorem summable_factored_union_of_mul (P Q : Finset ℕ) (hPQ : Disjoint P Q)
    (f a b : ℕ → ℝ)
    (ha : Summable (fun n : Nat.factoredNumbers P => a n.val))
    (hb : Summable (fun n : Nat.factoredNumbers Q => b n.val))
    (hmul : ∀ m ∈ Nat.factoredNumbers P, ∀ n ∈ Nat.factoredNumbers Q,
      f (m * n) = a m * b n) :
    Summable (fun n : Nat.factoredNumbers (P ∪ Q) => f n.val) := by
  apply (disjointPrimePoolProductEquiv P Q hPQ).summable_iff.mp
  apply (summable_mul_of_summable_norm ha.norm hb.norm).congr
  intro x
  exact (hmul x.1.val x.1.property x.2.val x.2.property).symm

theorem tsum_factored_union_mul (P Q : Finset ℕ) (hPQ : Disjoint P Q)
    (f a b : ℕ → ℝ)
    (ha : Summable (fun n : Nat.factoredNumbers P => a n.val))
    (hb : Summable (fun n : Nat.factoredNumbers Q => b n.val))
    (hmul : ∀ m ∈ Nat.factoredNumbers P, ∀ n ∈ Nat.factoredNumbers Q,
      f (m * n) = a m * b n) :
    (∑' n : Nat.factoredNumbers (P ∪ Q), f n.val) =
      (∑' n : Nat.factoredNumbers P, a n.val) * ∑' n : Nat.factoredNumbers Q, b n.val := by
  rw [tsum_factoredNumbers_union_eq P Q hPQ f]
  calc
    _ = ∑' x : Nat.factoredNumbers P × Nat.factoredNumbers Q, a x.1.val * b x.2.val := by
      apply tsum_congr
      intro x
      exact hmul x.1.val x.1.property x.2.val x.2.property
    _ = _ := (tsum_mul_tsum_of_summable_norm ha.norm hb.norm).symm
end

section
open Finset
theorem prime_not_dvd_of_disjoint_support {P Q : Finset ℕ}
    (hPQ : Disjoint P Q) {p b : ℕ} (hp : p.Prime) (hpP : p ∈ P)
    (hb : b ∈ Nat.factoredNumbers Q) : ¬ p ∣ b := by
  intro hpb
  exact disjoint_left.mp hPQ hpP
    (Nat.primeFactors_subset_of_mem_factoredNumbers hb
      (Nat.mem_primeFactors.mpr ⟨hp, hpb, Nat.ne_zero_of_mem_factoredNumbers hb⟩))

theorem physical_divisor_pool_mul_disjoint {G : Type*} (P : G → Finset ℕ) (g : G)
    (hP : ∀ p ∈ P g, p.Prime) {Q : Finset ℕ} (hPQ : Disjoint (P g) Q)
    {b : ℕ} (hb : b ∈ Nat.factoredNumbers Q) (a : ℕ) :
    physicalDivisorPool P g ((a * b : ℕ) : ℤ) = physicalDivisorPool P g (a : ℤ) := by
  ext p
  simp only [physicalDivisorPool, mem_filter]
  constructor
  · rintro ⟨hp, hab⟩
    have hab' : p ∣ a * b := by exact_mod_cast hab
    have ha : p ∣ a := ((hP p hp).dvd_mul.mp hab').resolve_right
      (prime_not_dvd_of_disjoint_support hPQ (hP p hp) hp hb)
    exact ⟨hp, by exact_mod_cast ha⟩
  · rintro ⟨hp, ha⟩
    have ha' : p ∣ a := by exact_mod_cast ha
    exact ⟨hp, by exact_mod_cast dvd_mul_of_dvd_left ha' b⟩

theorem physical_omega_mul_disjoint {G : Type*} (P : G → Finset ℕ) (g : G)
    (hP : ∀ p ∈ P g, p.Prime) {Q : Finset ℕ} (hPQ : Disjoint (P g) Q)
    {b : ℕ} (hb : b ∈ Nat.factoredNumbers Q) (a : ℕ) :
    physicalOmega P g ((a * b : ℕ) : ℤ) = physicalOmega P g (a : ℤ) :=
  congrArg Finset.card (physical_divisor_pool_mul_disjoint P g hP hPQ hb a)

theorem marked_divisor_weight_mul_disjoint {G : Type*} (groups : Finset G)
    (P : G → Finset ℕ) (q : ℝ) (mass : G → ℝ) (t : G → ℕ)
    (hP : ∀ g ∈ groups, ∀ p ∈ P g, p.Prime) {Q : Finset ℕ}
    (hPQ : ∀ g ∈ groups, Disjoint (P g) Q)
    {b : ℕ} (hb : b ∈ Nat.factoredNumbers Q) (a : ℕ) :
    markedDivisorWeight groups P q mass t ((a * b : ℕ) : ℤ) =
      markedDivisorWeight groups P q mass t (a : ℤ) := by
  apply prod_congr rfl
  intro g hg
  rw [physical_omega_mul_disjoint P g (hP g hg) (hPQ g hg) hb a]

theorem marked_divisor_weight_union_mul {G : Type*} [DecidableEq G]
    (I J : Finset G) (P : G → Finset ℕ) (q : ℝ) (mass : G → ℝ) (t : G → ℕ)
    (hIJ : Disjoint I J) (hP : ∀ g ∈ I ∪ J, ∀ p ∈ P g, p.Prime)
    (hPQ : ∀ g ∈ I, ∀ h ∈ J, Disjoint (P g) (P h))
    {a b : ℕ} (ha : a ∈ Nat.factoredNumbers (I.biUnion P))
    (hb : b ∈ Nat.factoredNumbers (J.biUnion P)) :
    markedDivisorWeight (I ∪ J) P q mass t ((a * b : ℕ) : ℤ) =
      markedDivisorWeight I P q mass t (a : ℤ) * markedDivisorWeight J P q mass t (b : ℤ) := by
  have hi : markedDivisorWeight I P q mass t ((a * b : ℕ) : ℤ) =
      markedDivisorWeight I P q mass t (a : ℤ) := by
    apply marked_divisor_weight_mul_disjoint I P q mass t
      (fun g hg => hP g (mem_union_left J hg)) _ hb a
    intro g hg
    apply disjoint_left.mpr
    intro p hp hq
    obtain ⟨h, hh, hph⟩ := mem_biUnion.mp hq
    exact disjoint_left.mp (hPQ g hg h hh) hp hph
  have hj : markedDivisorWeight J P q mass t ((a * b : ℕ) : ℤ) =
      markedDivisorWeight J P q mass t (b : ℤ) := by
    rw [Nat.mul_comm a b]
    apply marked_divisor_weight_mul_disjoint J P q mass t
      (fun g hg => hP g (mem_union_right I hg)) _ ha b
    intro h hh
    apply disjoint_left.mpr
    intro p hp hq
    obtain ⟨g, hg, hpg⟩ := mem_biUnion.mp hq
    exact disjoint_left.mp (hPQ g hg h hh) hpg hp
  change (∏ g ∈ I ∪ J, _) = _
  rw [prod_union hIJ]
  exact congrArg₂ (· * ·) hi hj
end

section
open Finset
noncomputable def oneMarkedGroupTerm {G : Type*} (groups : Finset G)
    (P : G → Finset ℕ) (q : ℝ) (mass : G → ℝ) (n : ℕ) : ℝ :=
  markedDivisorWeight groups P q mass (fun _ => 1) (n : ℤ) / (n : ℝ)

theorem one_marked_groups_summable_and_sum {G : Type*} [DecidableEq G]
    (groups : Finset G) (P : G → Finset ℕ)
    (hdisj : (groups : Set G).PairwiseDisjoint P)
    (hP : ∀ g ∈ groups, ∀ p ∈ P g, p.Prime) (q : ℝ) (mass : G → ℝ) :
    Summable (fun n : Nat.factoredNumbers (groups.biUnion P) =>
      oneMarkedGroupTerm groups P q mass n.val) ∧
    (∑' n : Nat.factoredNumbers (groups.biUnion P), oneMarkedGroupTerm groups P q mass n.val) =
      ∏ g ∈ groups, oneMarkedHarmonicMass (P g) q (mass g) := by
  induction groups using Finset.induction_on with
  | empty =>
    simp only [biUnion_empty, oneMarkedGroupTerm,
      markedDivisorWeight, prod_empty]
    constructor
    · simpa only [one_div] using prime_supported_reciprocal_summable ∅ (by simp)
    · simpa only [Real.rpow_neg_one, prod_empty, one_div] using
        (smooth_rpow_summable_and_sum ∅ (by simp) (show (0 : ℝ) < 1 by norm_num)).2
  | @insert g S hg ih =>
    have hdisjS : (S : Set G).PairwiseDisjoint P := by
      intro i hi j hj hij
      exact hdisj (mem_insert_of_mem hi) (mem_insert_of_mem hj) hij
    have hPS : ∀ i ∈ S, ∀ p ∈ P i, p.Prime :=
      fun i hi => hP i (mem_insert_of_mem hi)
    have hPg : ∀ p ∈ P g, p.Prime := hP g (mem_insert_self g S)
    obtain ⟨hrest, hrestsum⟩ := ih hdisjS hPS
    have hcross : ∀ i ∈ ({g} : Finset G), ∀ j ∈ S, Disjoint (P i) (P j) := by
      intro i hi j hj
      have hig := mem_singleton.mp hi
      subst i
      exact hdisj (mem_insert_self g S) (mem_insert_of_mem hj)
        (by intro h; exact hg (h ▸ hj))
    have hPQ : Disjoint (P g) (S.biUnion P) := by
      apply disjoint_left.mpr
      intro p hp hq
      obtain ⟨j, hj, hpj⟩ := mem_biUnion.mp hq
      exact disjoint_left.mp (hcross g (mem_singleton_self g) j hj) hp hpj
    let a : ℕ → ℝ := fun n => markedDivisorFactor q (mass g) n.primeFactors.card 1 / (n : ℝ)
    have ha : Summable (fun n : Nat.factoredNumbers (P g) => a n.val) :=
      one_marked_harmonic_summable (P g) hPg q (mass g)
    have hmul : ∀ m ∈ Nat.factoredNumbers (P g), ∀ n ∈ Nat.factoredNumbers (S.biUnion P),
        oneMarkedGroupTerm (insert g S) P q mass (m * n) =
          a m * oneMarkedGroupTerm S P q mass n := by
      intro m hm n hn
      have hw := marked_divisor_weight_union_mul ({g} : Finset G) S P q mass (fun _ => 1)
        (disjoint_singleton_left.mpr hg)
        (by simpa only [singleton_union] using hP) hcross
        (by simpa only [singleton_biUnion] using hm) hn
      simp only [singleton_union, markedDivisorWeight, prod_singleton] at hw
      rw [physical_omega_eq_primeFactors_card P g hPg hm] at hw
      dsimp only [oneMarkedGroupTerm, markedDivisorWeight, a]
      rw [hw, Nat.cast_mul]
      ring
    constructor
    · rw [biUnion_insert]
      exact summable_factored_union_of_mul (P g) (S.biUnion P) hPQ
          (oneMarkedGroupTerm (insert g S) P q mass) a
          (oneMarkedGroupTerm S P q mass) ha hrest hmul
    · have hsum := tsum_factored_union_mul (P g) (S.biUnion P) hPQ
        (oneMarkedGroupTerm (insert g S) P q mass) a
        (oneMarkedGroupTerm S P q mass) ha hrest hmul
      rw [hrestsum] at hsum
      rw [biUnion_insert, prod_insert hg]
      exact hsum

theorem one_marked_groups_harmonic_lower {G : Type*} [DecidableEq G]
    (groups : Finset G) (P : G → Finset ℕ)
    (hdisj : (groups : Set G).PairwiseDisjoint P)
    (hP : ∀ g ∈ groups, ∀ p ∈ P g, p.Prime)
    {q : ℝ} (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (mass : G → ℝ)
    (hpos : ∀ g ∈ groups, 0 < mass g)
    (hmass : ∀ g ∈ groups, (∑ p ∈ P g, 1 / (p : ℝ)) = mass g) :
    Real.exp (q * ∑ g ∈ groups, mass g) ≤
      ∑' n : Nat.factoredNumbers (groups.biUnion P), oneMarkedGroupTerm groups P q mass n.val := by
  rw [(one_marked_groups_summable_and_sum groups P hdisj hP q mass).2,
    mul_sum, Real.exp_sum]
  exact prod_le_prod₀ (fun _ _ => (Real.exp_pos _).le)
    (fun g hg => one_marked_harmonic_mass_ge_exp (P g) (hP g hg) hq0 hq1 (hpos g hg) (hmass g hg))
end

section
open Finset
theorem reciprocal_square_sum_le (P : Finset ℕ) {Y : ℝ} (hY : 0 < Y)
    (hP : ∀ p ∈ P, Y ≤ (p : ℝ)) :
    (∑ p ∈ P, 1 / (p : ℝ)^2) ≤ (∑ p ∈ P, 1 / (p : ℝ)) / Y := by
  rw [sum_div]
  apply sum_le_sum
  intro p hp
  have hp0 : 0 < (p : ℝ) := hY.trans_le (hP p hp)
  have hmul : Y * (p : ℝ) ≤ (p : ℝ)^2 := by nlinarith [hP p hp]
  calc
    1 / (p : ℝ)^2 ≤ 1 / (Y * (p : ℝ)) := one_div_le_one_div_of_le (mul_pos hY hp0) hmul
    _ = (1 / (p : ℝ)) / Y := by ring

theorem prime_mark_reciprocal_upper {p q Y : ℝ}
    (hY : 2 ≤ Y) (hp : Y ≤ p) (hq : 0 ≤ q) :
    1 / (p - 1 + q) ≤ (1 + 2 / Y) / p := by
  have hY0 : 0 < Y := by linarith
  have hp0 : 0 < p := hY0.trans_le hp
  have hd : 0 < p - 1 + q := by linarith
  apply (div_le_div_iff₀ hd hp0).mpr
  have he : (1 + 2 / Y) * (p - 1 + q) = ((Y + 2) * (p - 1 + q)) / Y := by
    field_simp
  rw [one_mul, he]
  apply (le_div_iff₀ hY0).mpr
  nlinarith [mul_nonneg hY0.le hq]

theorem one_marked_harmonic_mass_upper (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) {q V Y : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (hV : 0 < V) (hY : 2 ≤ Y)
    (hmin : ∀ p ∈ P, Y ≤ (p : ℝ)) (hmass : (∑ p ∈ P, 1 / (p : ℝ)) = V) :
    oneMarkedHarmonicMass P q V ≤ Real.exp (q * V + (2 * V + 2) / Y) := by
  have hY0 : 0 < Y := by linarith
  have hprod : (∏ p ∈ P, (1 + q / ((p : ℝ) - 1))) ≤ Real.exp (q * V + 2 * V / Y) := by
    have h := prime_euler_product_upper P (fun p hp => hY.trans (hmin p hp)) hq0 hq1
    rw [hmass] at h
    apply h.trans
    apply Real.exp_le_exp.mpr
    have hs := reciprocal_square_sum_le P hY0 hmin
    rw [hmass] at hs
    calc
      _ ≤ q * V + 2 * (V / Y) := add_le_add le_rfl
        (mul_le_mul_of_nonneg_left hs (show (0 : ℝ) ≤ 2 by norm_num))
      _ = _ := by ring
  have hsum : (∑ p ∈ P, 1 / ((p : ℝ) - 1 + q)) ≤ (1 + 2 / Y) * V := by
    rw [← hmass, mul_sum]
    apply sum_le_sum
    intro p hp
    simpa only [mul_one_div] using prime_mark_reciprocal_upper hY (hmin p hp) hq0
  have hratio : (∑ p ∈ P, 1 / ((p : ℝ) - 1 + q)) / V ≤ Real.exp (2 / Y) := by
    apply le_trans ((div_le_iff₀ hV).mpr hsum)
    simpa only [add_comm] using Real.add_one_le_exp (2 / Y)
  have hratio0 : 0 ≤ (∑ p ∈ P, 1 / ((p : ℝ) - 1 + q)) / V := by
    apply div_nonneg _ hV.le
    apply sum_nonneg
    intro p hp
    have hd : 0 < (p : ℝ) - 1 + q := by linarith [hmin p hp]
    positivity
  rw [one_marked_harmonic_mass_eq_euler P hP hq0]
  calc
    _ = (∏ p ∈ P, (1 + q / ((p : ℝ) - 1))) *
        ((∑ p ∈ P, 1 / ((p : ℝ) - 1 + q)) / V) := by ring
    _ ≤ Real.exp (q * V + 2 * V / Y) * Real.exp (2 / Y) :=
      mul_le_mul hprod hratio hratio0 (Real.exp_pos _).le
    _ = Real.exp (q * V + (2 * V + 2) / Y) := by
      rw [← Real.exp_add]
      congr 1
      ring

theorem one_marked_groups_harmonic_upper {G : Type*} [DecidableEq G]
    (groups : Finset G) (P : G → Finset ℕ)
    (hdisj : (groups : Set G).PairwiseDisjoint P)
    (hP : ∀ g ∈ groups, ∀ p ∈ P g, p.Prime)
    {q Y V : ℝ} (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (hY : 2 ≤ Y)
    (mass : G → ℝ) (hpos : ∀ g ∈ groups, 0 < mass g)
    (hmax : ∀ g ∈ groups, mass g ≤ V)
    (hmin : ∀ g ∈ groups, ∀ p ∈ P g, Y ≤ (p : ℝ))
    (hmass : ∀ g ∈ groups, (∑ p ∈ P g, 1 / (p : ℝ)) = mass g) :
    (∑' n : Nat.factoredNumbers (groups.biUnion P), oneMarkedGroupTerm groups P q mass n.val) ≤
      Real.exp (q * (∑ g ∈ groups, mass g) + (2 * V + 2) * groups.card / Y) := by
  rw [(one_marked_groups_summable_and_sum groups P hdisj hP q mass).2]
  have hY0 : 0 < Y := by linarith
  calc
    _ ≤ ∏ g ∈ groups, Real.exp (q * mass g + (2 * V + 2) / Y) := by
      apply prod_le_prod₀
      · intro g hg
        exact (Real.exp_pos _).le.trans
          (one_marked_harmonic_mass_ge_exp (P g) (hP g hg) hq0 hq1 (hpos g hg) (hmass g hg))
      · intro g hg
        apply (one_marked_harmonic_mass_upper (P g) (hP g hg) hq0 hq1 (hpos g hg) hY
          (hmin g hg) (hmass g hg)).trans
        apply Real.exp_le_exp.mpr
        exact add_le_add le_rfl (div_le_div_of_nonneg_right (by linarith [hmax g hg]) hY0.le)
    _ = _ := by
      rw [← Real.exp_sum]
      congr 1
      simp only [sum_add_distrib, ← mul_sum, sum_const, nsmul_eq_mul]
      ring

theorem one_marked_groups_relative_bounds {G : Type*} [DecidableEq G]
    (groups : Finset G) (P : G → Finset ℕ)
    (hdisj : (groups : Set G).PairwiseDisjoint P)
    (hP : ∀ g ∈ groups, ∀ p ∈ P g, p.Prime)
    {q Y V : ℝ} (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (hY : 2 ≤ Y)
    (mass : G → ℝ) (hpos : ∀ g ∈ groups, 0 < mass g)
    (hmax : ∀ g ∈ groups, mass g ≤ V)
    (hmin : ∀ g ∈ groups, ∀ p ∈ P g, Y ≤ (p : ℝ))
    (hmass : ∀ g ∈ groups, (∑ p ∈ P g, 1 / (p : ℝ)) = mass g) :
    1 ≤ (∑' n : Nat.factoredNumbers (groups.biUnion P), oneMarkedGroupTerm groups P q mass n.val) /
      Real.exp (q * ∑ g ∈ groups, mass g) ∧
    (∑' n : Nat.factoredNumbers (groups.biUnion P), oneMarkedGroupTerm groups P q mass n.val) /
      Real.exp (q * ∑ g ∈ groups, mass g) ≤ Real.exp ((2 * V + 2) * groups.card / Y) := by
  constructor
  · apply (le_div_iff₀ (Real.exp_pos _)).mpr
    simpa only [one_mul] using
      one_marked_groups_harmonic_lower groups P hdisj hP hq0 hq1 mass hpos hmass
  · apply (div_le_iff₀ (Real.exp_pos _)).mpr
    have h := one_marked_groups_harmonic_upper groups P hdisj hP hq0 hq1 hY mass hpos hmax hmin hmass
    rw [Real.exp_add] at h
    simpa only [mul_comm] using h
end

section
open Filter Finset
open scoped Topology
theorem tendsto_log_div_exp_rpow {c : ℝ} (hc : 0 < c) :
    Tendsto (fun L : ℝ => Real.log L / Real.exp (L^c)) atTop (𝓝 0) := by
  have ht : Tendsto (fun L : ℝ => L / Real.exp (L^c)) atTop (𝓝 0) := by
    simpa only [Real.rpow_one] using tendsto_rpow_div_exp_rpow 1 hc
  apply squeeze_zero' _ _ ht
  · filter_upwards [eventually_ge_atTop (1 : ℝ)] with L hL
    exact div_nonneg (Real.log_nonneg hL) (Real.exp_pos _).le
  · filter_upwards [eventually_gt_atTop (0 : ℝ)] with L hL
    exact div_le_div_of_nonneg_right (by linarith [Real.log_le_sub_one_of_pos hL]) (Real.exp_pos _).le

theorem tendsto_exp_mul_log_div_exp_rpow {c : ℝ} (hc : 0 < c) (K : ℝ) :
    Tendsto (fun L : ℝ => Real.exp (K * Real.log L / Real.exp (L^c))) atTop (𝓝 1) := by
  have ht : Tendsto (fun L : ℝ => K * Real.log L / Real.exp (L^c)) atTop (𝓝 0) := by
    simpa only [mul_div_assoc, mul_zero] using (tendsto_log_div_exp_rpow hc).const_mul K
  simpa only [Real.exp_zero, Function.comp_def] using (Real.continuous_exp.tendsto 0).comp ht

theorem eventually_one_marked_groups_relative_error {c q V ε : ℝ}
    (hc : 0 < c) (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (hV : 0 ≤ V)
    (hε : 0 < ε) (C : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (G : Type*) [DecidableEq G]
      (groups : Finset G) (P : G → Finset ℕ) (mass : G → ℝ),
      (groups : Set G).PairwiseDisjoint P →
      (∀ g ∈ groups, ∀ p ∈ P g, p.Prime) →
      (∀ g ∈ groups, 0 < mass g) →
      (∀ g ∈ groups, mass g ≤ V) →
      (∀ g ∈ groups, ∀ p ∈ P g, Real.exp (L^c) ≤ (p : ℝ)) →
      (∀ g ∈ groups, (∑ p ∈ P g, 1 / (p : ℝ)) = mass g) →
      (groups.card : ℝ) ≤ C * Real.log L →
      |(∑' n : Nat.factoredNumbers (groups.biUnion P), oneMarkedGroupTerm groups P q mass n.val) /
        Real.exp (q * ∑ g ∈ groups, mass g) - 1| ≤ ε := by
  have hexp := (tendsto_exp_mul_log_div_exp_rpow hc ((2 * V + 2) * C)).eventually_le_const
    (show (1 : ℝ) < 1 + ε by linarith)
  filter_upwards [hexp, eventually_ge_atTop (1 : ℝ)] with L he hL
  intro G _ groups P mass hdisj hP hpos hmax hmin hmass hcard
  have hY : 2 ≤ Real.exp (L^c) := by
    have hp := Real.one_le_rpow hL hc.le
    linarith [Real.add_one_le_exp (L^c)]
  obtain ⟨hlo, hhi⟩ := one_marked_groups_relative_bounds groups P hdisj hP hq0 hq1 hY
    mass hpos hmax hmin hmass
  have herr : (2 * V + 2) * groups.card / Real.exp (L^c) ≤
      ((2 * V + 2) * C) * Real.log L / Real.exp (L^c) := by
    calc
      _ ≤ (2 * V + 2) * (C * Real.log L) / Real.exp (L^c) :=
        div_le_div_of_nonneg_right
          (mul_le_mul_of_nonneg_left hcard (by linarith)) (Real.exp_pos _).le
      _ = _ := by ring
  have hupper := hhi.trans ((Real.exp_le_exp.mpr herr).trans he)
  apply abs_le.mpr
  constructor <;> linarith
end

section
open Filter Finset
open scoped Topology
noncomputable def candidatePHarmonicMass (s L : ℝ) : ℝ :=
  ∑ j ∈ candidatePIndices s L, ∑ p ∈ candidatePBand (s * L) j, 1 / (p : ℝ)

noncomputable def candidateOneMarkedHarmonicMass (s L q : ℝ) : ℝ :=
  ∑' n : Nat.factoredNumbers ((candidatePIndices s L).biUnion (candidatePBand (s * L))),
    oneMarkedGroupTerm (candidatePIndices s L) (candidatePBand (s * L)) q
      (fun j => ∑ p ∈ candidatePBand (s * L) j, 1 / (p : ℝ)) n.val

theorem candidate_P_harmonic_mass_nonneg (s L : ℝ) : 0 ≤ candidatePHarmonicMass s L := by
  exact sum_nonneg (fun _ _ => sum_nonneg (fun _ _ => by positivity))

theorem eventually_candidate_one_marked_mass_lower {s q : ℝ}
    (hs : 0 < s) (hq0 : 0 ≤ q) (hq1 : q ≤ 1) :
    ∀ᶠ L : ℝ in atTop,
      Real.exp (q * candidatePHarmonicMass s L) ≤ candidateOneMarkedHarmonicMass s L q := by
  obtain ⟨v, V, hv, _, hpool⟩ := exists_candidate_P_pool_bounds hs
  filter_upwards [hpool] with L hp
  rcases hp with ⟨_, _, _, _, hpair, hdata⟩
  apply one_marked_groups_harmonic_lower (candidatePIndices s L) (candidatePBand (s * L))
    (fun i _ j _ hij => hpair hij) (fun j hj p hp => ((hdata j hj).2.2 p hp).1)
    hq0 hq1
  · exact fun j hj => hv.trans_le (hdata j hj).1
  · exact fun _ _ => rfl

theorem eventually_candidate_one_marked_mass_ge_one {s q : ℝ}
    (hs : 0 < s) (hq0 : 0 ≤ q) (hq1 : q ≤ 1) :
    ∀ᶠ L : ℝ in atTop, 1 ≤ candidateOneMarkedHarmonicMass s L q := by
  filter_upwards [eventually_candidate_one_marked_mass_lower hs hq0 hq1] with L h
  exact (Real.one_le_exp (mul_nonneg hq0 (candidate_P_harmonic_mass_nonneg s L))).trans h

theorem tendsto_candidate_one_marked_harmonic_ratio {s q : ℝ}
    (hs : 0 < s) (hq0 : 0 ≤ q) (hq1 : q ≤ 1) :
    Tendsto (fun L : ℝ => candidateOneMarkedHarmonicMass s L q /
      Real.exp (q * candidatePHarmonicMass s L)) atTop (𝓝 1) := by
  obtain ⟨v, V, hv, hV, hpool⟩ := exists_candidate_P_pool_bounds hs
  apply Metric.tendsto_nhds.mpr
  intro ε hε
  have hε2 : 0 < ε / 2 := by positivity
  filter_upwards [hpool,
    eventually_one_marked_groups_relative_error (c := (1/10 : ℝ))
      (by norm_num) hq0 hq1 hV.le hε2 (2 / (5 * Real.log 2))] with L hp hr
  rcases hp with ⟨_, _, _, hcard, hpair, hdata⟩
  have h := hr ℕ (candidatePIndices s L) (candidatePBand (s * L))
    (fun j => ∑ p ∈ candidatePBand (s * L) j, 1 / (p : ℝ))
    (fun i _ j _ hij => hpair hij) (fun j hj p hp => ((hdata j hj).2.2 p hp).1)
    (fun j hj => hv.trans_le (hdata j hj).1) (fun j hj => (hdata j hj).2.1)
    (fun j hj p hp => ((hdata j hj).2.2 p hp).2.1.le) (fun _ _ => rfl) hcard
  change |candidateOneMarkedHarmonicMass s L q / Real.exp (q * candidatePHarmonicMass s L) - 1| ≤ ε / 2 at h
  rw [Real.dist_eq]
  exact h.trans_lt (by linarith)

theorem candidate_marked_smooth_tail_nonneg (s L q : ℝ) (ell : ℕ) (X : ℝ)
    (hq : 0 ≤ q) : 0 ≤ candidateMarkedSmoothTail s L q ell X := by
  apply tsum_nonneg
  intro n
  unfold weightedSmoothTailTerm
  split_ifs
  · apply div_nonneg
    · exact marked_divisor_weight_nonneg _ _ hq _ _
        (fun _ _ => sum_nonneg (fun _ _ => by positivity)) _
    · exact Nat.cast_nonneg _
  · exact le_rfl

theorem eventually_candidate_relative_marked_tail {s q κ K : ℝ}
    (hs : 0 < s) (hq0 : 0 ≤ q) (hq1 : q < 1) (hκ : 0 < κ)
    (hK : 0 ≤ K) (A : ℝ) :
    ∀ᶠ L : ℝ in atTop,
      (candidateMarkedSmoothTail s L q 1 (Real.exp (κ * L)) * Real.exp (K * Real.sqrt L)) /
        candidateOneMarkedHarmonicMass s L q ≤ L^(-A) := by
  filter_upwards [eventually_candidate_one_marked_mass_ge_one hs hq0 hq1.le,
    eventually_candidate_marked_smooth_tail_sqrt_loss hs hq0 hq1 hκ hK 1 A] with L hmass htail
  exact (div_le_self (mul_nonneg (candidate_marked_smooth_tail_nonneg s L q 1 _ hq0)
    (Real.exp_pos _).le) hmass).trans htail
end

section
open Finset
/-- Sum a finite weight over one fiber of a projection. -/
noncomputable def finiteSupportPushforward {X Y A : Type*} [Fintype X]
    [DecidableEq Y] [AddCommMonoid A] (p : X → Y) (w : X → A) (y : Y) : A :=
  ∑ x, if p x = y then w x else 0

/-- A supported fiber contains exactly its one nonzero weight. -/
theorem finite_support_fiber_eq_single {X Y A : Type*} [Fintype X]
    [DecidableEq Y] [AddCommMonoid A] (p : X → Y) (w : X → A)
    (hp : Function.Injective (fun x : {x : X // w x ≠ 0} => p x.val))
    (x : X) (hx : w x ≠ 0) : finiteSupportPushforward p w (p x) = w x := by
  classical
  unfold finiteSupportPushforward
  rw [sum_eq_single x]
  · simp
  · intro z _ hzx
    by_cases hwz : w z = 0
    · simp [hwz]
    · have hne : p z ≠ p x := by
        intro he
        exact hzx (congrArg Subtype.val (hp (show p (⟨z, hwz⟩ : {z : X // w z ≠ 0}).val =
          p (⟨x, hx⟩ : {z : X // w z ≠ 0}).val from he)))
      simp [hne]
  · simp

/-- There is no cancellation inside any projected fiber. This works for both
real and complex weights, and more generally any normed additive commutative group. -/
theorem finite_support_fiber_norm {X Y A : Type*} [Fintype X]
    [DecidableEq Y] [NormedAddCommGroup A] (p : X → Y) (w : X → A)
    (hp : Function.Injective (fun x : {x : X // w x ≠ 0} => p x.val)) (y : Y) :
    ‖finiteSupportPushforward p w y‖ =
      finiteSupportPushforward p (fun x => ‖w x‖) y := by
  classical
  by_cases hex : ∃ x, p x = y ∧ w x ≠ 0
  · obtain ⟨x, hxy, hx⟩ := hex
    subst y
    rw [finite_support_fiber_eq_single p w hp x hx]
    have hpn : Function.Injective (fun z : {z : X // ‖w z‖ ≠ 0} => p z.val) := by
      intro z t he
      apply Subtype.ext
      have hzt : (⟨z.val, by simpa using z.property⟩ : {x : X // w x ≠ 0}) =
          (⟨t.val, by simpa using t.property⟩ : {x : X // w x ≠ 0}) := hp he
      exact congrArg (fun u : {x : X // w x ≠ 0} => u.val) hzt
    rw [finite_support_fiber_eq_single p (fun x => ‖w x‖) hpn x (by simpa using hx)]
  · have hz : ∀ x, p x = y → w x = 0 := by
      intro x hxy
      by_contra hw
      exact hex ⟨x, hxy, hw⟩
    have hleft : finiteSupportPushforward p w y = 0 := by
      apply sum_eq_zero
      intro x _
      by_cases hxy : p x = y <;> simp [hxy, hz]
    have hright : finiteSupportPushforward p (fun x => ‖w x‖) y = 0 := by
      apply sum_eq_zero
      intro x _
      by_cases hxy : p x = y <;> simp [hxy, hz]
    rw [hleft, hright, norm_zero]

/-- Forgetting an injective-on-support flag leaves the full sum of norms unchanged. -/
theorem finite_support_pushforward_norm_sum {X Y A : Type*} [Fintype X] [Fintype Y]
    [DecidableEq Y] [NormedAddCommGroup A] (p : X → Y) (w : X → A)
    (hp : Function.Injective (fun x : {x : X // w x ≠ 0} => p x.val)) :
    (∑ y, ‖finiteSupportPushforward p w y‖) = ∑ x, ‖w x‖ := by
  simp_rw [finite_support_fiber_norm p w hp]
  unfold finiteSupportPushforward
  rw [sum_comm]
  simp

/-- A coupled test on projected histories can be evaluated before or after
pushforward. Unlike norm preservation, this identity needs no support assumption. -/
theorem finite_support_pushforward_test {X Y A : Type*} [Fintype X] [Fintype Y]
    [DecidableEq Y] [Semiring A] (p : X → Y) (w : X → A) (F : Y → A) :
    (∑ y, finiteSupportPushforward p w y * F y) = ∑ x, w x * F (p x) := by
  unfold finiteSupportPushforward
  simp only [sum_mul]
  rw [sum_comm]
  apply sum_congr rfl
  intro x _
  simp [ite_mul]

/-- The weight of a finite visible history, summed over its possible hidden flags. -/
noncomputable def ghostPhaseVisibleWeight {R : Type*} [Fintype R] [DecidableEq R]
    (isVisit atgt asrc : ℕ → Bool) (htgt hsrc : ℕ → R) (η β : ℕ → ℝ)
    (a0 : Bool) (β0 : ℝ) (an : Bool) {n : ℕ}
    (y : Fin (n + 1) → Option (Option R)) : ℝ :=
  finiteSupportPushforward (fun x j => ghostPhaseForgetFlags (x j))
    (ghostPhaseFiniteTraceWeight isVisit atgt asrc htgt hsrc η β a0 β0 an) y

/-- Each nonzero finite phase trace contributes its coefficient unchanged to
its visible history; no other hidden flag choice contributes there. -/
theorem ghost_phase_visible_fiber_eq {R : Type*} [Fintype R] [DecidableEq R]
    (isVisit atgt asrc : ℕ → Bool) (htgt hsrc : ℕ → R) (η β : ℕ → ℝ)
    (a0 : Bool) (β0 : ℝ) (an : Bool) {n : ℕ}
    (x : Fin (n + 1) → GhostPhaseState R)
    (hx : ghostPhaseFiniteTraceWeight isVisit atgt asrc htgt hsrc η β a0 β0 an x ≠ 0) :
    ghostPhaseVisibleWeight isVisit atgt asrc htgt hsrc η β a0 β0 an
      (fun j => ghostPhaseForgetFlags (x j)) =
      ghostPhaseFiniteTraceWeight isVisit atgt asrc htgt hsrc η β a0 β0 an x :=
  finite_support_fiber_eq_single _ _
    (ghost_phase_finite_visible_injective isVisit atgt asrc htgt hsrc η β a0 β0 an n) x hx

/-- Erasing U/D flags preserves the sum of absolute weights of complete finite
histories. This is stronger than preservation of their signed sum. -/
theorem ghost_phase_visible_absolute_sum {R : Type*} [Fintype R] [DecidableEq R]
    (isVisit atgt asrc : ℕ → Bool) (htgt hsrc : ℕ → R) (η β : ℕ → ℝ)
    (a0 : Bool) (β0 : ℝ) (an : Bool) (n : ℕ) :
    (∑ y : Fin (n + 1) → Option (Option R),
      |ghostPhaseVisibleWeight isVisit atgt asrc htgt hsrc η β a0 β0 an y|) =
      ∑ x : Fin (n + 1) → GhostPhaseState R,
        |ghostPhaseFiniteTraceWeight isVisit atgt asrc htgt hsrc η β a0 β0 an x| := by
  simpa only [ghostPhaseVisibleWeight, Real.norm_eq_abs] using
    finite_support_pushforward_norm_sum
      (fun x : Fin (n + 1) → GhostPhaseState R => fun j => ghostPhaseForgetFlags (x j))
      (ghostPhaseFiniteTraceWeight isVisit atgt asrc htgt hsrc η β a0 β0 an)
      (ghost_phase_finite_visible_injective isVisit atgt asrc htgt hsrc η β a0 β0 an n)

/-- Arbitrarily coupled tests of visible histories obey the exact pushforward identity. -/
theorem ghost_phase_visible_test_sum {R : Type*} [Fintype R] [DecidableEq R]
    (isVisit atgt asrc : ℕ → Bool) (htgt hsrc : ℕ → R) (η β : ℕ → ℝ)
    (a0 : Bool) (β0 : ℝ) (an : Bool) (n : ℕ)
    (F : (Fin (n + 1) → Option (Option R)) → ℝ) :
    (∑ y : Fin (n + 1) → Option (Option R),
      ghostPhaseVisibleWeight isVisit atgt asrc htgt hsrc η β a0 β0 an y * F y) =
      ∑ x : Fin (n + 1) → GhostPhaseState R,
        ghostPhaseFiniteTraceWeight isVisit atgt asrc htgt hsrc η β a0 β0 an x *
          F (fun j => ghostPhaseForgetFlags (x j)) :=
  finite_support_pushforward_test _ _ F
end

section
open Finset
/-- An actual ordered tuple of distinct labels whose image is exactly `S`. -/
abbrev DistinctOrderedSupport (J : Type*) {P : Type*} (S : Finset P) :=
  {f : J ↪ P // ∀ p, p ∈ S ↔ ∃ j, f j = p}

/-- Read an actual distinct tuple as an enumeration of its specified support. -/
noncomputable def distinctOrderedSupportAsEquiv {J P : Type*} {S : Finset P}
    (f : DistinctOrderedSupport J S) : J ≃ S :=
  Equiv.ofBijective
    (fun j => ⟨f.val j, (f.property (f.val j)).2 ⟨j, rfl⟩⟩)
    ⟨by
      intro j k hjk
      exact f.val.injective (congrArg Subtype.val hjk),
     by
      intro p
      obtain ⟨j, hj⟩ := (f.property p.val).1 p.property
      exact ⟨j, Subtype.ext hj⟩⟩

/-- Forget the subtype tag on each label in a support enumeration. -/
def distinctOrderedSupportOfEquiv {J P : Type*} {S : Finset P}
    (e : J ≃ S) : DistinctOrderedSupport J S :=
  ⟨{ toFun := fun j => (e j).val
     inj' := by
       intro j k hjk
       exact e.injective (Subtype.ext hjk) },
   by
    intro p
    constructor
    · intro hp
      obtain ⟨j, hj⟩ := e.surjective ⟨p, hp⟩
      exact ⟨j, congrArg Subtype.val hj⟩
    · rintro ⟨j, rfl⟩
      exact (e j).property⟩

/-- Fixed-support injective tuples and abstract support enumerations are
equivalent, before taking any quotient by the ordering. -/
noncomputable def distinctOrderedSupportEquiv {J P : Type*} (S : Finset P) :
    DistinctOrderedSupport J S ≃ (J ≃ S) where
  toFun := distinctOrderedSupportAsEquiv
  invFun := distinctOrderedSupportOfEquiv
  left_inv f := by
    apply Subtype.ext
    ext j
    rfl
  right_inv e := by
    ext j
    rfl

/-- The same equivalence carries arbitrary dependent residue coordinates.
The right side retains the enumeration as well as the support-indexed residues. -/
noncomputable def distinctOrderedMemoryEquiv {J P : Type*} (S : Finset P)
    (R : P → Type*) :
    (Σ f : DistinctOrderedSupport J S, (j : J) → R (f.val j)) ≃
      (Σ _e : J ≃ S, (p : S) → R p.val) :=
  Equiv.sigmaCongr (distinctOrderedSupportEquiv S)
    (fun f => Equiv.piCongrLeft (fun p : S => R p.val) (distinctOrderedSupportAsEquiv f))

/-- For each actual tuple, summing its residue variables is exactly summing
the support residue variables. The test may couple every residue coordinate. -/
theorem distinct_ordered_memory_residue_sum {J P 𝕜 : Type*}
    [Fintype J] [DecidableEq J] [DecidableEq P] [CommSemiring 𝕜]
    (S : Finset P) (R : P → Type*) [∀ p, Fintype (R p)]
    (w : (p : P) → R p → 𝕜) (F : ((p : S) → R p.val) → 𝕜)
    (f : DistinctOrderedSupport J S) :
    (∑ r : (j : J) → R (f.val j), (∏ j, w (f.val j) (r j)) *
      F (Equiv.piCongrLeft (fun p : S => R p.val) (distinctOrderedSupportAsEquiv f) r)) =
      ∑ r : (p : S) → R p.val, (∏ p, w p.val (r p)) * F r := by
  classical
  let e := distinctOrderedSupportAsEquiv f
  let er := Equiv.piCongrLeft (fun p : S => R p.val) e
  change (∑ r : (j : J) → R (e j).val, (∏ j, w (e j).val (r j)) * F (er r)) = _
  calc
    _ = ∑ r : (j : J) → R (e j).val,
        (∏ p : S, w p.val (er r p)) * F (er r) := by
      apply sum_congr rfl
      intro r _
      congr 1
      simpa only [er, Equiv.piCongrLeft_apply_apply] using
        e.prod_comp (fun p : S => w p.val (er r p))
    _ = _ := er.sum_comp (fun r => (∏ p : S, w p.val (r p)) * F r)

/-- Actual ordered tuples of the same support contribute exactly `|J|!`
copies. Dividing by that factorial gives the support-coordinate integral.
The weight can depend on residues; in particular it can be the prime mass. -/
theorem distinct_ordered_memory_sum_div_factorial {J P 𝕜 : Type*}
    [Fintype J] [DecidableEq J] [Fintype P] [DecidableEq P]
    [Field 𝕜] [CharZero 𝕜]
    (S : Finset P) (e0 : J ≃ S) (R : P → Type*) [∀ p, Fintype (R p)]
    (w : (p : P) → R p → 𝕜) (F : ((p : S) → R p.val) → 𝕜) :
    (∑ f : DistinctOrderedSupport J S,
      ∑ r : (j : J) → R (f.val j), (∏ j, w (f.val j) (r j)) *
        F (Equiv.piCongrLeft (fun p : S => R p.val) (distinctOrderedSupportAsEquiv f) r)) /
      ((Fintype.card J).factorial : 𝕜) =
        ∑ r : (p : S) → R p.val, (∏ p, w p.val (r p)) * F r := by
  classical
  simp_rw [distinct_ordered_memory_residue_sum S R w F]
  rw [sum_const, card_univ, nsmul_eq_mul,
    Fintype.card_congr (distinctOrderedSupportEquiv S), Fintype.card_equiv e0]
  exact mul_div_cancel_left₀ _ (Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _))
end

section
open Finset
/-- Occupancy of the retained positions of an ordered tuple. -/
noncomputable def retainedTupleOccupancy {ι : Type*} [DecidableEq ι] {n : ℕ}
    (p : Fin n → ι) (s : Finset (Fin n)) : ι → ℕ :=
  ∑ j ∈ s, Pi.single (p j) 1

theorem retainedTupleOccupancy_univ {ι : Type*} [DecidableEq ι] {n : ℕ}
    (p : Fin n → ι) : retainedTupleOccupancy p univ = tupleOccupancy p := rfl

/-- Position products can be grouped by the species occupancy of the tuple. -/
theorem tuple_prod_eq_occupancy_prod {ι M : Type*} [Fintype ι] [DecidableEq ι]
    [CommMonoid M] {n : ℕ} (p : Fin n → ι) (z : ι → M) :
    (∏ j, z (p j)) = ∏ i, z i ^ tupleOccupancy p i := by
  rw [← Finset.prod_fiberwise' univ p z]
  simp only [Finset.prod_const, tupleOccupancy_apply]

/-- The retention polynomial, expanded by retained positions and by species. -/
theorem retained_occupancy_generating_identity {ι : Type*} [Fintype ι]
    [DecidableEq ι] {n : ℕ} (p : Fin n → ι) (A D : ι → ℝ) :
    (∑ s ∈ (univ : Finset (Fin n)).powerset,
      AddMonoidAlgebra.single (retainedTupleOccupancy p s)
        ((∏ j ∈ s, A (p j)) * ∏ j ∈ univ \ s, D (p j))) =
    ∑ k ∈ Fintype.piFinset (fun i => range (tupleOccupancy p i + 1)),
      AddMonoidAlgebra.single k
        (∏ i, (Nat.choose (tupleOccupancy p i) (k i) : ℝ) *
          A i ^ k i * D i ^ (tupleOccupancy p i - k i)) := by
  let z : ι → AddMonoidAlgebra ℝ (ι → ℕ) := fun i =>
    AddMonoidAlgebra.single (Pi.single i 1) (A i) +
      AddMonoidAlgebra.single 0 (D i)
  have hpos : (∏ j, z (p j)) =
      ∑ s ∈ (univ : Finset (Fin n)).powerset,
        AddMonoidAlgebra.single (retainedTupleOccupancy p s)
          ((∏ j ∈ s, A (p j)) * ∏ j ∈ univ \ s, D (p j)) := by
    simp only [z, Finset.prod_add, AddMonoidAlgebra.prod_single,
      AddMonoidAlgebra.single_mul_single, Finset.sum_const_zero, add_zero,
      retainedTupleOccupancy]
  have hpow (i : ι) : z i ^ tupleOccupancy p i =
      ∑ k ∈ range (tupleOccupancy p i + 1),
        AddMonoidAlgebra.single (k • Pi.single i 1)
          ((Nat.choose (tupleOccupancy p i) k : ℝ) * A i ^ k *
            D i ^ (tupleOccupancy p i - k)) := by
    rw [show z i = _ from rfl, add_pow]
    apply Finset.sum_congr rfl
    intro k hk
    simp only [AddMonoidAlgebra.single_pow, nsmul_zero,
      AddMonoidAlgebra.single_mul_single, add_zero]
    rw [mul_comm, ← nsmul_eq_mul]
    simp [mul_assoc]
  rw [← hpos, tuple_prod_eq_occupancy_prod p z]
  simp_rw [hpow]
  rw [Finset.prod_univ_sum]
  apply Finset.sum_congr rfl
  intro k hk
  have hexp : (∑ i, k i • Pi.single i (1 : ℕ)) = k := by
    ext i
    simp [Finset.sum_apply, Pi.single_apply]
  simp only [AddMonoidAlgebra.prod_single, hexp]

/-- Group retained index subsets by occupancy. Repeated numerical species are
allowed, and the test is an arbitrary function of the whole retained vector. -/
theorem sum_retained_eq_occupancy {ι : Type*} [Fintype ι] [DecidableEq ι]
    {n : ℕ} (p : Fin n → ι) (A D : ι → ℝ) (F : (ι → ℕ) → ℝ) :
    (∑ s ∈ (univ : Finset (Fin n)).powerset,
      ((∏ j ∈ s, A (p j)) * ∏ j ∈ univ \ s, D (p j)) *
        F (retainedTupleOccupancy p s)) =
    ∑ k ∈ Fintype.piFinset (fun i => range (tupleOccupancy p i + 1)),
      (∏ i, (Nat.choose (tupleOccupancy p i) (k i) : ℝ) *
        A i ^ k i * D i ^ (tupleOccupancy p i - k i)) * F k := by
  let T : AddMonoidAlgebra ℝ (ι → ℕ) →+ ℝ :=
    (Finsupp.liftAddHom (fun k => AddMonoidHom.mulRight (F k))).comp
      AddMonoidAlgebra.coeffAddEquiv.toAddMonoidHom
  have hT (k : ι → ℕ) (r : ℝ) : T (AddMonoidAlgebra.single k r) = r * F k := by
    simp [T]
  have h := congrArg T (retained_occupancy_generating_identity p A D)
  simpa only [map_sum, hT] using h

/-- Retain old positions, then append an ordered birth batch with its `1/b!`
weight. The result is the exact coupled occupancy sum; births may repeat species.
No positivity assumption or factorization of the output test is used. -/
theorem sum_retained_ordered_births_eq_occupancy {ι : Type*} [Fintype ι]
    [DecidableEq ι] {n : ℕ} (p : Fin n → ι) (A D C ν : ι → ℝ)
    (b : ℕ) (F : (ι → ℕ) → ℝ) :
    (∑ s ∈ (univ : Finset (Fin n)).powerset,
      ((∏ j ∈ s, A (p j)) * ∏ j ∈ univ \ s, D (p j)) *
        ((∑ q : Fin b → ι, (∏ j, C (q j) * ν (q j)) *
          F (retainedTupleOccupancy p s + tupleOccupancy q)) /
            (b.factorial : ℝ))) =
    ∑ k ∈ Fintype.piFinset (fun i => range (tupleOccupancy p i + 1)),
      (∏ i, (Nat.choose (tupleOccupancy p i) (k i) : ℝ) *
        A i ^ k i * D i ^ (tupleOccupancy p i - k i)) *
        ∑ l ∈ (univ : Finset ι).piAntidiag b,
          (∏ i, (C i * ν i) ^ l i / ((l i).factorial : ℝ)) * F (k + l) := by
  rw [sum_retained_eq_occupancy p A D (fun k =>
    (∑ q : Fin b → ι, (∏ j, C (q j) * ν (q j)) *
      F (k + tupleOccupancy q)) / (b.factorial : ℝ))]
  apply Finset.sum_congr rfl
  intro k hk
  congr 1
  exact sum_tuple_div_factorial_eq_occupancy (fun i => C i * ν i) b
    (fun l => F (k + l))
end

section
open Finset
/-- All occupancy vectors with total size at most `B`. -/
noncomputable def ghostOccupancyBall {ι : Type*} [Fintype ι] [DecidableEq ι]
    (B : ℕ) : Finset (ι → ℕ) :=
  (range (B + 1)).biUnion (fun b => (univ : Finset ι).piAntidiag b)

theorem mem_ghostOccupancyBall {ι : Type*} [Fintype ι] [DecidableEq ι]
    (B : ℕ) (m : ι → ℕ) : m ∈ ghostOccupancyBall B ↔ (∑ i, m i) ≤ B := by
  classical
  simp only [ghostOccupancyBall, mem_biUnion, mem_range, mem_piAntidiag,
    mem_univ, implies_true, and_true]
  constructor
  · rintro ⟨b, hb, hm⟩
    exact hm ▸ Nat.le_of_lt_succ hb
  · intro hm
    exact ⟨∑ i, m i, by omega, rfl⟩

theorem sum_ghostOccupancyBall {ι : Type*} [Fintype ι] [DecidableEq ι]
    (B : ℕ) (f : (ι → ℕ) → ℝ) :
    (∑ b ∈ range (B + 1), ∑ m ∈ (univ : Finset ι).piAntidiag b, f m) =
      ∑ m ∈ ghostOccupancyBall B, f m := by
  classical
  unfold ghostOccupancyBall
  rw [sum_biUnion]
  intro b hb c hc hbc
  apply disjoint_left.mpr
  intro m hm hn
  exact hbc ((mem_piAntidiag.mp hm).1.symm.trans (mem_piAntidiag.mp hn).1)

/-- Translate births to total output occupancy, preserving the total cutoff. -/
theorem ghost_occupancy_translate_sum {ι : Type*} [Fintype ι] [DecidableEq ι]
    (B : ℕ) (k : ι → ℕ) (f : (ι → ℕ) → ℝ) :
    (∑ l ∈ ghostOccupancyBall B,
      if (∑ i, (k + l) i) ≤ B then f l else 0) =
    ∑ m ∈ ghostOccupancyBall B, if ∀ i, k i ≤ m i then f (m - k) else 0 := by
  classical
  rw [← sum_filter, ← sum_filter]
  apply sum_bij (fun l _ => k + l)
  · intro l hl
    rw [mem_filter] at hl ⊢
    exact ⟨(mem_ghostOccupancyBall B _).mpr hl.2, fun i => Nat.le_add_right _ _⟩
  · intro l hl l' hl' h
    exact add_left_cancel h
  · intro m hm
    rw [mem_filter] at hm
    have hsum : (∑ i, (m - k) i) ≤ B :=
      (sum_le_sum (fun i _ => Nat.sub_le (m i) (k i))).trans
        ((mem_ghostOccupancyBall B m).mp hm.1)
    have heq : k + (m - k) = m := by
      ext i
      exact Nat.add_sub_of_le (hm.2 i)
    refine ⟨m - k, ?_, heq⟩
    exact mem_filter.mpr ⟨(mem_ghostOccupancyBall B _).mpr hsum,
      by simpa only [heq] using (mem_ghostOccupancyBall B m).mp hm.1⟩
  · intro l hl
    congr 1
    ext i
    exact (Nat.add_sub_cancel_left (k i) (l i)).symm

/-- A finite vector version of birth-and-retention triangular reindexing. -/
theorem ghost_occupancy_triangular_sum {ι : Type*} [Fintype ι] [DecidableEq ι]
    (n : ι → ℕ) (B : ℕ) (f : (ι → ℕ) → (ι → ℕ) → ℝ) :
    (∑ k ∈ Fintype.piFinset (fun i => range (n i + 1)),
      ∑ l ∈ ghostOccupancyBall B,
        if (∑ i, (k + l) i) ≤ B then f k l else 0) =
    ∑ m ∈ ghostOccupancyBall B,
      ∑ k ∈ Fintype.piFinset (fun i => range (min (n i) (m i) + 1)),
        f k (m - k) := by
  classical
  simp_rw [ghost_occupancy_translate_sum]
  rw [sum_comm]
  apply sum_congr rfl
  intro m hm
  rw [← sum_filter]
  have hset : (Fintype.piFinset (fun i => range (n i + 1))).filter
      (fun k => ∀ i, k i ≤ m i) =
      Fintype.piFinset (fun i => range (min (n i) (m i) + 1)) := by
    ext k
    simp only [mem_filter, Fintype.mem_piFinset, mem_range, Nat.lt_succ_iff,
      le_min_iff]
    exact forall_and.symm
  rw [hset]

/-- Product coefficient for retaining `k` old particles of each species. -/
noncomputable def ghostRetainedCoefficient {ι : Type*} [Fintype ι]
    (n : ι → ℕ) (A D : ι → ℝ) (k : ι → ℕ) : ℝ :=
  ∏ i, (Nat.choose (n i) (k i) : ℝ) * A i ^ k i * D i ^ (n i - k i)

/-- The ordered-birth factorial measure after grouping by species. -/
noncomputable def ghostBirthCoefficient {ι : Type*} [Fintype ι]
    (C ν : ι → ℝ) (l : ι → ℕ) : ℝ :=
  ∏ i, (C i * ν i) ^ l i / ((l i).factorial : ℝ)

theorem ghost_kernel_product_retained_births {ι : Type*} [Fintype ι]
    [DecidableEq ι] (n m : ι → ℕ) (A D C ν : ι → ℝ) :
    (∏ i, ghostKernel (A i) (D i) (C i) (ν i) (n i) (m i)) =
    ∑ k ∈ Fintype.piFinset (fun i => range (min (n i) (m i) + 1)),
      ghostRetainedCoefficient n A D k * ghostBirthCoefficient C ν (m - k) := by
  simp only [ghostKernel]
  rw [prod_univ_sum]
  apply sum_congr rfl
  intro k hk
  unfold ghostRetainedCoefficient ghostBirthCoefficient
  rw [← prod_mul_distrib]
  apply prod_congr rfl
  intro i hi
  simp only [Pi.sub_apply]
  ring

/-- Exact ordered-particle row with total output occupancy at most `B`.
The birth-length sum only needs `b ≤ B`; rejected outputs have zero test value. -/
theorem ordered_ghost_row_eq_kernel_product {ι : Type*} [Fintype ι]
    [DecidableEq ι] {N : ℕ} (p : Fin N → ι) (A D C ν : ι → ℝ)
    (B : ℕ) (F : (ι → ℕ) → ℝ) :
    (∑ b ∈ range (B + 1), ∑ s ∈ (univ : Finset (Fin N)).powerset,
      ((∏ j ∈ s, A (p j)) * ∏ j ∈ univ \ s, D (p j)) *
        ((∑ q : Fin b → ι, (∏ j, C (q j) * ν (q j)) *
          (if (∑ i, (retainedTupleOccupancy p s + tupleOccupancy q) i) ≤ B then
            F (retainedTupleOccupancy p s + tupleOccupancy q) else 0)) /
              (b.factorial : ℝ))) =
    ∑ m ∈ ghostOccupancyBall B,
      (∏ i, ghostKernel (A i) (D i) (C i) (ν i) (tupleOccupancy p i) (m i)) *
        F m := by
  classical
  calc
    _ = ∑ b ∈ range (B + 1),
        ∑ k ∈ Fintype.piFinset (fun i => range (tupleOccupancy p i + 1)),
          ghostRetainedCoefficient (tupleOccupancy p) A D k *
            ∑ l ∈ (univ : Finset ι).piAntidiag b,
              ghostBirthCoefficient C ν l *
                (if (∑ i, (k + l) i) ≤ B then F (k + l) else 0) := by
      apply sum_congr rfl
      intro b hb
      exact sum_retained_ordered_births_eq_occupancy p A D C ν b
        (fun m => if (∑ i, m i) ≤ B then F m else 0)
    _ = ∑ k ∈ Fintype.piFinset (fun i => range (tupleOccupancy p i + 1)),
        ∑ l ∈ ghostOccupancyBall B,
          if (∑ i, (k + l) i) ≤ B then
            ghostRetainedCoefficient (tupleOccupancy p) A D k *
              ghostBirthCoefficient C ν l * F (k + l) else 0 := by
      rw [sum_comm]
      apply sum_congr rfl
      intro k hk
      simp_rw [mul_sum]
      rw [← sum_ghostOccupancyBall]
      apply sum_congr rfl
      intro b hb
      apply sum_congr rfl
      intro l hl
      split_ifs <;> ring
    _ = ∑ m ∈ ghostOccupancyBall B,
        ∑ k ∈ Fintype.piFinset (fun i => range (min (tupleOccupancy p i) (m i) + 1)),
          ghostRetainedCoefficient (tupleOccupancy p) A D k *
            ghostBirthCoefficient C ν (m - k) * F (k + (m - k)) :=
      ghost_occupancy_triangular_sum (tupleOccupancy p) B _
    _ = _ := by
      apply sum_congr rfl
      intro m hm
      rw [ghost_kernel_product_retained_births, sum_mul]
      apply sum_congr rfl
      intro k hk
      have hkm : k ≤ m := by
        intro i
        have h := (Fintype.mem_piFinset.mp hk) i
        simp only [mem_range, Nat.lt_succ_iff, le_min_iff] at h
        exact h.2
      have heq : k + (m - k) = m := by
        ext i
        exact Nat.add_sub_of_le (hkm i)
      rw [heq]
end

section
open Finset
/-- The actual ordered row, including repeated species and the birth `1/b!`.
Each ordered event is tested only when its total output size is at most `B`. -/
noncomputable def complexOrderedGhostRow {ι : Type*} [Fintype ι] [DecidableEq ι]
    {N : ℕ} (p : Fin N → ι) (A D C ν : ι → ℝ) (B : ℕ)
    (F : (ι → ℕ) → ℂ) : ℂ :=
  ∑ b ∈ range (B + 1), ∑ s ∈ (univ : Finset (Fin N)).powerset,
    ∑ q : Fin b → ι,
      ((((∏ j ∈ s, A (p j)) * ∏ j ∈ univ \ s, D (p j)) *
        (∏ j, C (q j) * ν (q j)) / (b.factorial : ℝ) : ℝ) : ℂ) *
        (if (∑ i, (retainedTupleOccupancy p s + tupleOccupancy q) i) ≤ B then
          F (retainedTupleOccupancy p s + tupleOccupancy q) else 0)

theorem complex_ordered_ghost_row_eq_kernel_product {ι : Type*} [Fintype ι]
    [DecidableEq ι] {N : ℕ} (p : Fin N → ι) (A D C ν : ι → ℝ)
    (B : ℕ) (F : (ι → ℕ) → ℂ) :
    complexOrderedGhostRow p A D C ν B F =
      ∑ m ∈ ghostOccupancyBall B,
        ((∏ i, ghostKernel (A i) (D i) (C i) (ν i) (tupleOccupancy p i) (m i) : ℝ) : ℂ) *
          F m := by
  have hr (f : (ι → ℕ) → ℝ) :
      (∑ b ∈ range (B + 1), ∑ s ∈ (univ : Finset (Fin N)).powerset,
        ∑ q : Fin b → ι,
          (((∏ j ∈ s, A (p j)) * ∏ j ∈ univ \ s, D (p j)) *
            (∏ j, C (q j) * ν (q j)) / (b.factorial : ℝ)) *
            (if (∑ i, (retainedTupleOccupancy p s + tupleOccupancy q) i) ≤ B then
              f (retainedTupleOccupancy p s + tupleOccupancy q) else 0)) =
      ∑ m ∈ ghostOccupancyBall B,
        (∏ i, ghostKernel (A i) (D i) (C i) (ν i) (tupleOccupancy p i) (m i)) * f m := by
    simpa only [sum_div, mul_sum, div_mul_eq_mul_div, mul_div_assoc, mul_assoc] using
      ordered_ghost_row_eq_kernel_product p A D C ν B f
  apply Complex.ext
  · simpa only [complexOrderedGhostRow, Complex.re_sum, Complex.mul_re,
      Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero, apply_ite,
      Complex.zero_re] using hr (fun m => (F m).re)
  · simpa only [complexOrderedGhostRow, Complex.im_sum, Complex.mul_im,
      Complex.ofReal_re, Complex.ofReal_im, zero_mul, add_zero, apply_ite,
      Complex.zero_im] using hr (fun m => (F m).im)

/-- The total-size cutoff inside the existing bounded occupancy state space. -/
noncomputable def ghostBoundedTotalCutoff {ι : Type*} [Fintype ι] [DecidableEq ι]
    (B : ℕ) : Finset (ι → Fin (B + 1)) :=
  univ.filter (fun x => (∑ i, (x i : ℕ)) ≤ B)

/-- Extend a bounded occupancy test by zero outside its coordinate box. -/
noncomputable def ghostBoundedTest {ι : Type*} [Fintype ι] (B : ℕ)
    (f : (ι → Fin (B + 1)) → ℂ) (m : ι → ℕ) : ℂ :=
  if h : ∀ i, m i ≤ B then f (fun i => ⟨m i, Nat.lt_succ_of_le (h i)⟩) else 0

theorem ghostBoundedTest_coe {ι : Type*} [Fintype ι] (B : ℕ)
    (f : (ι → Fin (B + 1)) → ℂ) (x : ι → Fin (B + 1)) :
    ghostBoundedTest B f (fun i => (x i : ℕ)) = f x := by
  unfold ghostBoundedTest
  rw [dif_pos (fun i => Nat.le_of_lt_succ (x i).isLt)]

/-- Natural occupancy vectors in the total-size ball give exactly the same
kernel row as bounded `Fin` occupancies in `ghostMemoryAction`. -/
theorem ghost_nat_row_eq_memory_action {ι : Type*} [Fintype ι] [DecidableEq ι]
    (B : ℕ) (A D C ν : ι → ℝ) (f : (ι → Fin (B + 1)) → ℂ)
    (x : ι → Fin (B + 1)) :
    (∑ m ∈ ghostOccupancyBall B,
      ((∏ i, ghostKernel (A i) (D i) (C i) (ν i) (x i) (m i) : ℝ) : ℂ) *
        ghostBoundedTest B f m) =
      ghostMemoryAction (ghostBoundedTotalCutoff B) A D C ν f x := by
  classical
  symm
  unfold ghostMemoryAction
  apply sum_bij (fun y _ => fun i => (y i : ℕ))
  · intro y hy
    apply (mem_ghostOccupancyBall B _).mpr
    simpa only [ghostBoundedTotalCutoff, mem_filter, mem_univ, true_and] using hy
  · intro y hy z hz heq
    funext i
    exact Fin.ext (congrFun heq i)
  · intro m hm
    have htotal := (mem_ghostOccupancyBall B m).mp hm
    have hbound (i : ι) : m i ≤ B :=
      (single_le_sum (fun j _ => Nat.zero_le (m j)) (mem_univ i)).trans htotal
    let y : ι → Fin (B + 1) := fun i => ⟨m i, Nat.lt_succ_of_le (hbound i)⟩
    refine ⟨y, ?_, rfl⟩
    simpa only [ghostBoundedTotalCutoff, mem_filter, mem_univ, true_and] using htotal
  · intro y hy
    rw [ghostBoundedTest_coe]
    simp only [ghostMemoryKernel, Complex.ofReal_prod]

/-- Any ordered representative of a bounded occupancy gives the existing action. -/
theorem complex_ordered_ghost_row_eq_memory_action {ι : Type*} [Fintype ι]
    [DecidableEq ι] {N : ℕ} (p : Fin N → ι) (B : ℕ) (A D C ν : ι → ℝ)
    (f : (ι → Fin (B + 1)) → ℂ) (x : ι → Fin (B + 1))
    (hp : tupleOccupancy p = fun i => (x i : ℕ)) :
    complexOrderedGhostRow p A D C ν B (ghostBoundedTest B f) =
      ghostMemoryAction (ghostBoundedTotalCutoff B) A D C ν f x := by
  rw [complex_ordered_ghost_row_eq_kernel_product, hp]
  exact ghost_nat_row_eq_memory_action B A D C ν f x

/-- A canonical ordered representative of a bounded occupancy vector. -/
noncomputable def ghostOccupancyTuple {ι : Type*} [Fintype ι] {B : ℕ}
    (x : ι → Fin (B + 1)) :
    Fin (Fintype.card (Σ i, Fin (x i : ℕ))) → ι :=
  fun j => ((Fintype.equivFin (Σ i, Fin (x i : ℕ))).symm j).1

theorem ghostOccupancyTuple_occupancy {ι : Type*} [Fintype ι] [DecidableEq ι]
    {B : ℕ} (x : ι → Fin (B + 1)) :
    tupleOccupancy (ghostOccupancyTuple x) = fun i => (x i : ℕ) := by
  unfold tupleOccupancy ghostOccupancyTuple
  rw [(Fintype.equivFin (Σ i, Fin (x i : ℕ))).symm.sum_comp
    (fun a : Σ i, Fin (x i : ℕ) => (Pi.single a.1 1 : ι → ℕ))]
  rw [Fintype.sum_sigma]
  ext i
  simp [Finset.sum_apply, Pi.single_apply]

/-- The actual ordered row, evaluated on a canonical tuple for each occupancy. -/
noncomputable def complexOrderedGhostAction {ι : Type*} [Fintype ι] [DecidableEq ι]
    (B : ℕ) (A D C ν : ι → ℝ) (f : (ι → Fin (B + 1)) → ℂ)
    (x : ι → Fin (B + 1)) : ℂ :=
  complexOrderedGhostRow (ghostOccupancyTuple x) A D C ν B (ghostBoundedTest B f)

theorem complex_ordered_ghost_action_eq {ι : Type*} [Fintype ι] [DecidableEq ι]
    (B : ℕ) (A D C ν : ι → ℝ) (f : (ι → Fin (B + 1)) → ℂ)
    (x : ι → Fin (B + 1)) :
    complexOrderedGhostAction B A D C ν f x =
      ghostMemoryAction (ghostBoundedTotalCutoff B) A D C ν f x :=
  complex_ordered_ghost_row_eq_memory_action (ghostOccupancyTuple x) B A D C ν f x
    (ghostOccupancyTuple_occupancy x)

/-- The established ghost-memory L2 estimate for the actual ordered row. -/
theorem complex_ordered_ghost_l2_sq_le {ι : Type*} [Fintype ι] [DecidableEq ι]
    (B : ℕ) (A D C ν v : ι → ℝ)
    (hA : ∀ i, 0 ≤ A i) (hν : ∀ i, 0 < ν i) (hv : ∀ i, 0 < v i)
    (hD : ∀ i, A i + |D i| / v i ≤ 1)
    (hC : ∀ i, A i + |C i| / v i ≤ 1)
    (f : (ι → Fin (B + 1)) → ℂ) :
    (∑ x ∈ ghostBoundedTotalCutoff B,
      ghostMemoryWeight ν x * ‖complexOrderedGhostAction B A D C ν f x‖ ^ 2) ≤
      Real.exp (∑ i, (|C i| + |D i|) * ν i * v i) *
        ∑ y ∈ ghostBoundedTotalCutoff B, ghostMemoryWeight ν y * ‖f y‖ ^ 2 := by
  simp_rw [complex_ordered_ghost_action_eq]
  exact ghostMemory_l2_sq_le (ghostBoundedTotalCutoff B) A D C ν v hA hν hv hD hC f
end

section
open Finset
noncomputable def ghostChronologicalBirths {R : Type*} [DecidableEq R]
    (a0 : Bool) {n : ℕ} (x : Fin (n + 1) → GhostPhaseState R) :
    Finset (Option (Fin n)) :=
  (if a0 then {none} else ∅) ∪
    ((univ : Finset (Fin n)).filter
      (fun j => x j.castSucc = some none ∧ x j.succ ≠ some none)).image some

theorem ghost_chronological_births_card {R : Type*} [DecidableEq R]
    (a0 : Bool) {n : ℕ} (x : Fin (n + 1) → GhostPhaseState R) :
    (ghostChronologicalBirths a0 x).card = (if a0 then 1 else 0) +
      ((univ : Finset (Fin n)).filter
        (fun j => x j.castSucc = some none ∧ x j.succ ≠ some none)).card := by
  unfold ghostChronologicalBirths
  have hd : Disjoint (if a0 then ({none} : Finset (Option (Fin n))) else ∅)
      (((univ : Finset (Fin n)).filter
        (fun j => x j.castSucc = some none ∧ x j.succ ≠ some none)).image some) := by
    cases a0 <;> simp
  rw [card_union_of_disjoint hd, card_image_of_injective _ (Option.some_injective (Fin n))]
  cases a0 <;> simp

theorem ghost_chronological_births_card_le_one {R : Type*}
    [Fintype R] [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (n : ℕ)
    (x : Fin ((2 * n + 1) + 1) → GhostPhaseState R)
    (hx : ghostPhaseChronologicalWeight a h η β n x ≠ 0) :
    (ghostChronologicalBirths (a 0) x).card ≤ 1 := by
  rw [ghost_chronological_births_card]
  exact ghost_phase_chronological_total_births a h η β n x hx

/-- Per-coordinate birth uniqueness upgrades to global numerical-prime
distinctness when the coordinate labels are injective. Initial active slots
and later visit/edge births are included in the same address type. -/
theorem ghost_chronological_birth_labels_injective
    {I P : Type*} [Fintype I] {R : I → Type*}
    [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (prime : I → P) (hprime : Function.Injective prime)
    (a : I → ℕ → Bool) (h : (i : I) → ℕ → R i) (η : I → ℕ → ℝ)
    (β : I → ℝ) (n : ℕ)
    (x : (i : I) → Fin ((2 * n + 1) + 1) → GhostPhaseState (R i))
    (hx : (∏ i, ghostPhaseChronologicalWeight (a i) (h i) (η i) (β i) n (x i)) ≠ 0) :
    Set.InjOn (fun e : I × Option (Fin (2 * n + 1)) => prime e.1)
      {e | e.2 ∈ ghostChronologicalBirths (a e.1 0) (x e.1)} := by
  intro e he f hf hef
  have hi : e.1 = f.1 := hprime hef
  rcases e with ⟨i,u⟩
  rcases f with ⟨j,v⟩
  simp only at hi
  subst j
  have hw := (prod_ne_zero_iff.mp hx) i (mem_univ i)
  have hc := ghost_chronological_births_card_le_one (a i) (h i) (η i) (β i) n (x i) hw
  have huv : u = v := (card_le_one.mp hc) u he v hf
  exact Prod.ext rfl huv
end

section
open Finset
noncomputable def ghostChronologicalTensorWeight {I : Type*} [Fintype I]
    {R : I → Type*} [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (a : I → ℕ → Bool) (h : (i : I) → ℕ → R i) (η : I → ℕ → ℝ)
    (β : I → ℝ) (n : ℕ)
    (x : (i : I) → Fin ((2 * n + 1) + 1) → GhostPhaseState (R i)) : ℝ :=
  ∏ i, ghostPhaseChronologicalWeight (a i) (h i) (η i) (β i) n (x i)

theorem ghost_chronological_tensor_sum {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (a : I → ℕ → Bool) (h : (i : I) → ℕ → R i) (η : I → ℕ → ℝ)
    (β : I → ℝ) (n : ℕ) :
    (∑ x, ghostChronologicalTensorWeight a h η β n x) =
      ghostPhaseTensorHistory a h η β n := by
  unfold ghostChronologicalTensorWeight
  rw [← Fintype.prod_sum, ghost_phase_tensor_history_factor]
  simp_rw [ghost_phase_chronological_sum]

/-- Inserting the global numerical distinct-birth condition does not change
the finite trace sum. This condition includes initial active births. -/
theorem ghost_chronological_distinct_tensor_sum
    {I P : Type*} [Fintype I] [DecidableEq I] {R : I → Type*}
    [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (prime : I → P) (hprime : Function.Injective prime)
    (a : I → ℕ → Bool) (h : (i : I) → ℕ → R i) (η : I → ℕ → ℝ)
    (β : I → ℝ) (n : ℕ) :
    (∑ x : (i : I) → Fin ((2 * n + 1) + 1) → GhostPhaseState (R i),
      @ite ℝ (Set.InjOn (fun e : I × Option (Fin (2 * n + 1)) => prime e.1)
        {e | e.2 ∈ ghostChronologicalBirths (a e.1 0) (x e.1)})
        (Classical.propDecidable _) (ghostChronologicalTensorWeight a h η β n x) 0) =
      ghostPhaseTensorHistory a h η β n := by
  classical
  rw [← ghost_chronological_tensor_sum a h η β n]
  apply sum_congr rfl
  intro x _
  by_cases hx : ghostChronologicalTensorWeight a h η β n x = 0
  · simp [hx]
  · rw [if_pos (ghost_chronological_birth_labels_injective prime hprime a h η β n x hx)]

theorem pool_path_residue_eq_chronological_traces
    {I : Type*} [Fintype I] [DecidableEq I]
    (m : I → ℕ) [∀ i, NeZero (m i)] (a : I → ℕ → Bool)
    (h : (i : I) → ℕ → ZMod (m i)) (η : ℕ → ℝ) (n : ℕ) (b : I → ℝ)
    (hb : ∀ i, b i = 1 - (∑ j ∈ range (n + 1), η j) / m i)
    (hb0 : ∀ i, b i ≠ 0) :
    poolPathResidueExpectation m univ (range (n + 1))
      (fun i => (range (n + 1)).filter (fun j => a i j = true)) h η =
      (∏ i, b i) * ∑ x, ghostChronologicalTensorWeight a h (fun _ => η)
        (fun i => ((m i : ℝ) * b i)⁻¹) n x := by
  rw [ghost_chronological_tensor_sum]
  exact pool_path_residue_eq_phase_history m a h η n b hb hb0
end

section
open Finset
noncomputable def distinctBirthRange {P : Type*} {b : ℕ} (f : Fin b ↪ P) : Finset P :=
  univ.map f

theorem distinct_birth_range_equiv {P : Type*} {b : ℕ} (B : Finset P)
    (e : Fin b ≃ B) : distinctBirthRange (distinctOrderedSupportOfEquiv e).val = B := by
  classical
  ext p
  simp only [distinctBirthRange, mem_map, mem_univ, true_and]
  exact ((distinctOrderedSupportOfEquiv e).property p).symm

/-- Classify every actual distinct ordered tuple by its image and enumeration. -/
noncomputable def distinctBirthSupportEquiv (P : Type*) (b : ℕ) :
    (Σ B : Finset P, Fin b ≃ B) ≃ (Fin b ↪ P) :=
  Equiv.ofBijective (fun z => (distinctOrderedSupportOfEquiv z.2).val) (by
    classical
    constructor
    · rintro ⟨B, e⟩ ⟨C, f⟩ h
      change (distinctOrderedSupportOfEquiv e).val = (distinctOrderedSupportOfEquiv f).val at h
      have hBC : B = C := by
        rw [← distinct_birth_range_equiv B e, ← distinct_birth_range_equiv C f, h]
      subst C
      have hef : e = f := by
        ext j
        exact congrArg (fun g : Fin b ↪ P => g j) h
      subst f
      rfl
    · intro f
      let g : DistinctOrderedSupport (Fin b) (distinctBirthRange f) := ⟨f, by
        intro p
        simp only [distinctBirthRange, mem_map, mem_univ, true_and]⟩
      refine ⟨⟨distinctBirthRange f, distinctOrderedSupportAsEquiv g⟩, ?_⟩
      ext j
      rfl)

/-- At a fixed length, the normalized injective-tuple sum selects supports
of exactly that cardinality. -/
theorem distinct_birth_fixed_length_sum {P : Type*} [Fintype P] [DecidableEq P]
    (b : ℕ) (w : P → ℝ) (F : Finset P → ℝ) :
    (∑ f : Fin b ↪ P, (∏ j, w (f j)) * F (distinctBirthRange f)) / (b.factorial : ℝ) =
      ∑ B : Finset P, if B.card = b then (∏ p ∈ B, w p) * F B else 0 := by
  classical
  rw [← (distinctBirthSupportEquiv P b).sum_comp]
  rw [Fintype.sum_sigma, sum_div]
  apply sum_congr rfl
  intro B _
  have hterm (e : Fin b ≃ B) :
      (∏ j, w ((distinctOrderedSupportOfEquiv e).val j)) *
          F (distinctBirthRange (distinctOrderedSupportOfEquiv e).val) =
        (∏ p ∈ B, w p) * F B := by
    rw [distinct_birth_range_equiv]
    congr 1
    calc
      _ = ∏ p : B, w p.val := e.prod_comp (fun p : B => w p.val)
      _ = _ := prod_coe_sort B w
  change (∑ e : Fin b ≃ B,
    (∏ j, w ((distinctOrderedSupportOfEquiv e).val j)) *
      F (distinctBirthRange (distinctOrderedSupportOfEquiv e).val)) / _ = _
  simp_rw [hterm]
  by_cases hB : B.card = b
  · have hcard : Fintype.card (Fin b ≃ B) = b.factorial := by
      have hsz : Fintype.card (Fin b) = Fintype.card B := by simpa using hB.symm
      simpa only [Fintype.card_fin] using Fintype.card_equiv (Fintype.equivOfCardEq hsz)
    simp only [hB, if_true, sum_const, card_univ, nsmul_eq_mul, hcard]
    exact mul_div_cancel_left₀ _ (Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero b))
  · have he : IsEmpty (Fin b ≃ B) := ⟨fun e => hB (by
        simpa only [Fintype.card_coe, Fintype.card_fin] using (Fintype.card_congr e).symm)⟩
    simp [hB]

/-- Sum all actual distinct tuples up to the pool size. The only factorial
is the new-batch factorial, and an arbitrary support-dependent test is retained. -/
theorem distinct_birth_batch_sum {P : Type*} [Fintype P] [DecidableEq P]
    (w : P → ℝ) (F : Finset P → ℝ) :
    (∑ b ∈ range (Fintype.card P + 1),
      (∑ f : Fin b ↪ P, (∏ j, w (f j)) * F (distinctBirthRange f)) / (b.factorial : ℝ)) =
      ∑ B : Finset P, (∏ p ∈ B, w p) * F B := by
  simp_rw [distinct_birth_fixed_length_sum]
  rw [sum_comm]
  apply sum_congr rfl
  intro B _
  have hB : B.card ∈ range (Fintype.card P + 1) := by
    simp only [mem_range]
    exact Nat.lt_succ_of_le (card_le_univ B)
  simp [hB]

/-- The measured birth coefficient cancels the pool mass exactly. -/
theorem distinct_birth_measured_coefficient (η V ρ β : ℝ) (hV : V ≠ 0) :
    (-η * V / ρ) * (β / V) = -β * η / ρ := by
  field_simp

/-- Subsets of a finite subtype are exactly subsets of the original finite pool. -/
theorem distinct_birth_subtype_subsets {P : Type*} [DecidableEq P]
    (U : Finset P) (F : Finset P → ℝ) :
    (∑ B : Finset U, F (B.map (Function.Embedding.subtype (fun p => p ∈ U)))) =
      ∑ B ∈ U.powerset, F B := by
  classical
  apply sum_bij (fun B _ => B.map (Function.Embedding.subtype (fun p => p ∈ U)))
  · intro B _
    apply mem_powerset.mpr
    intro p hp
    exact property_of_mem_map_subtype B hp
  · intro B _ C _ h
    exact map_injective _ h
  · intro B hB
    refine ⟨B.subtype (fun p => p ∈ U), mem_univ _, ?_⟩
    exact subtype_map_of_mem (fun p hp => mem_powerset.mp hB hp)
  · intro B _
    rfl

/-- Actual distinct tuples range over the unborn pool, while the continuation
may depend arbitrarily on their support in the original label type. -/
theorem distinct_birth_pool_sum {P : Type*} [DecidableEq P]
    (U : Finset P) (w : P → ℝ) (F : Finset P → ℝ) :
    (∑ b ∈ range (U.card + 1),
      (∑ f : Fin b ↪ U, (∏ j, w (f j).val) *
        F ((distinctBirthRange f).map (Function.Embedding.subtype (fun p => p ∈ U)))) /
          (b.factorial : ℝ)) =
      ∑ B ∈ U.powerset, (∏ p ∈ B, w p) * F B := by
  classical
  calc
    _ = ∑ B : Finset U, (∏ p ∈ B, w p.val) *
        F (B.map (Function.Embedding.subtype (fun p => p ∈ U))) := by
      simpa only [Fintype.card_coe] using distinct_birth_batch_sum
        (fun p : U => w p.val) (fun B => F (B.map (Function.Embedding.subtype (fun p => p ∈ U))))
    _ = ∑ B : Finset U, (∏ p ∈ B.map (Function.Embedding.subtype (fun p => p ∈ U)), w p) *
        F (B.map (Function.Embedding.subtype (fun p => p ∈ U))) := by
      simp only [prod_map, Function.Embedding.coe_subtype]
    _ = _ := distinct_birth_subtype_subsets U (fun B => (∏ p ∈ B, w p) * F B)

/-- A fixed support enumeration divided by its factorial contributes one copy. -/
theorem distinct_birth_enumeration_normalized {P : Type*} [DecidableEq P]
    (B : Finset P) (w : P → ℝ) (t : ℝ) :
    (∑ e : Fin B.card ≃ B, (∏ j, w (e j).val) * t) / (B.card.factorial : ℝ) =
      (∏ p ∈ B, w p) * t := by
  classical
  let e0 : Fin B.card ≃ B := Fintype.equivOfCardEq (by simp)
  have he := distinct_batch_factorial_normalization e0 (fun p : B => w p.val)
  have hbase : (∑ e : Fin B.card ≃ B, ∏ j, w (e j).val) / (B.card.factorial : ℝ) =
      ∏ p ∈ B, w p := by
    simpa only [Fintype.card_fin, Fintype.card_coe, prod_coe_sort] using he
  rw [← sum_mul]
  calc
    _ = ((∑ e : Fin B.card ≃ B, ∏ j, w (e j).val) / (B.card.factorial : ℝ)) * t := by ring
    _ = _ := by rw [hbase]

/-- The support/enumeration formula is exactly the varying-length actual
injective-tuple formula, with no residual ordering multiplicity. -/
theorem distinct_birth_enumerations_eq_tuples {P : Type*} [DecidableEq P]
    (U : Finset P) (w : P → ℝ) (F : Finset P → ℝ) :
    (∑ B ∈ U.powerset,
      (∑ e : Fin B.card ≃ B, (∏ j, w (e j).val) * F B) / (B.card.factorial : ℝ)) =
    ∑ b ∈ range (U.card + 1),
      (∑ f : Fin b ↪ U, (∏ j, w (f j).val) *
        F ((distinctBirthRange f).map (Function.Embedding.subtype (fun p => p ∈ U)))) /
          (b.factorial : ℝ) := by
  simp_rw [distinct_birth_enumeration_normalized]
  exact (distinct_birth_pool_sum U w F).symm

/-- The common row birth coefficient and the product prime measure agree
with the concrete birth coefficients at every actual ordered tuple. -/
theorem distinct_birth_measured_product {P : Type*} (β : P → ℝ)
    (η V ρ : ℝ) (hV : V ≠ 0) (b : ℕ) (f : Fin b → P) :
    (-η * V / ρ) ^ b * (∏ j, β (f j) / V) = ∏ j, -β (f j) * η / ρ := by
  calc
    _ = ∏ j : Fin b, (-η * V / ρ) * (β (f j) / V) := by
      rw [prod_mul_distrib]
      simp only [prod_const, card_univ, Fintype.card_fin]
    _ = _ := by simp_rw [distinct_birth_measured_coefficient η V ρ _ hV]

/-- Measured varying-length distinct-birth integration equals the concrete
support sum. This retains any coupled continuation as a function of the new support. -/
theorem distinct_birth_measured_pool_sum {P : Type*} [DecidableEq P]
    (U : Finset P) (β : P → ℝ) (η V ρ : ℝ) (hV : V ≠ 0) (F : Finset P → ℝ) :
    (∑ b ∈ range (U.card + 1),
      (∑ f : Fin b ↪ U, ((-η * V / ρ) ^ b * (∏ j, β (f j).val / V)) *
        F ((distinctBirthRange f).map (Function.Embedding.subtype (fun p => p ∈ U)))) /
          (b.factorial : ℝ)) =
      ∑ B ∈ U.powerset, (∏ p ∈ B, -β p * η / ρ) * F B := by
  simp_rw [distinct_birth_measured_product β η V ρ hV]
  exact distinct_birth_pool_sum U (fun p => -β p * η / ρ) F

/-- The actual chronological visit action is the measured distinct-birth
batch integral. Old-memory terminations retain their separate coefficients;
new births are actual injective tuples in the unborn pool at the fixed hit. -/
theorem ghost_phase_transition_measured_births {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (a : I → Bool) (h : (i : I) → R i) (β : I → ℝ) (η V ρ : ℝ) (hV : V ≠ 0)
    (y : (i : I) → GhostPhaseState (R i)) (hy : ghostPhaseMask a y)
    (F : ((i : I) → GhostPhaseState (R i)) → ℝ) :
    (∑ x, (∏ i, ghostPhaseDampedVisit (a i) (h i) η (β i) ρ (x i) (y i)) * F x) =
      ∑ A ∈ (ghostVisitDeaths a h y).powerset,
        ((∏ _i ∈ A, -η / ρ) *
          (∏ _i ∈ ghostVisitDeaths a h y \ A, (1 - η) / ρ ^ 2)) *
        (∑ b ∈ range ((ghostVisitBirths a y).card + 1),
          (∑ f : Fin b ↪ ghostVisitBirths a y,
            ((-η * V / ρ) ^ b * (∏ j, β (f j).val / V)) *
              F (ghostVisitBatchOutput h y A ((distinctBirthRange f).map
                (Function.Embedding.subtype (fun p => p ∈ ghostVisitBirths a y))))) /
            (b.factorial : ℝ)) := by
  rw [ghost_phase_transition_batches a h (fun _ => η) β (fun _ => ρ) y hy F]
  apply sum_congr rfl
  intro A _
  rw [distinct_birth_measured_pool_sum (ghostVisitBirths a y) β η V ρ hV
    (fun B => F (ghostVisitBatchOutput h y A B))]
  simp only [ghostVisitBatchWeight, mul_sum, mul_assoc]
end

section
open Finset
theorem tuple_occupancy_total {I : Type*} [Fintype I] [DecidableEq I]
    {n : ℕ} (p : Fin n → I) : (∑ i, tupleOccupancy p i) = n := by
  simp only [tupleOccupancy, Finset.sum_apply]
  rw [sum_comm]
  simp [Pi.single_apply]

theorem tuple_occupancy_permutation {I : Type*} [DecidableEq I]
    {n : ℕ} (p q : Fin n → I) (hpq : tupleOccupancy p = tupleOccupancy q) :
    ∃ e : Equiv.Perm (Fin n), ∀ j, q (e j) = p j := by
  classical
  have hc (i : I) : Fintype.card {j : Fin n // p j = i} =
      Fintype.card {j : Fin n // q j = i} := by
    simpa only [Fintype.card_subtype, ← tupleOccupancy_apply] using congrFun hpq i
  let e : ∀ i, {j : Fin n // p j = i} ≃ {j : Fin n // q j = i} :=
    fun i => Fintype.equivOfCardEq (hc i)
  exact ⟨Equiv.ofFiberEquiv e, Equiv.ofFiberEquiv_map e⟩

abbrev FiniteOrderedTuple (I : Type*) := Σ n : ℕ, Fin n → I

noncomputable def orderedTupleOccupancy {I : Type*} [DecidableEq I]
    (p : FiniteOrderedTuple I) : I → ℕ := tupleOccupancy p.2

def OrderedTupleSymmetric {I K : Type*} (F : FiniteOrderedTuple I → K) : Prop :=
  ∀ n (p : Fin n → I) (e : Equiv.Perm (Fin n)), F ⟨n, p ∘ e⟩ = F ⟨n, p⟩

theorem symmetric_tuple_equal_on_occupancy {I K : Type*}
    [Fintype I] [DecidableEq I] (F : FiniteOrderedTuple I → K)
    (hF : OrderedTupleSymmetric F) (p q : FiniteOrderedTuple I)
    (hpq : orderedTupleOccupancy p = orderedTupleOccupancy q) : F p = F q := by
  rcases p with ⟨n,p⟩
  rcases q with ⟨m,q⟩
  have hnm : n = m := by
    rw [← tuple_occupancy_total p, ← tuple_occupancy_total q]
    exact congrArg (fun k : I → ℕ => ∑ i, k i) hpq
  subst m
  obtain ⟨e,he⟩ := tuple_occupancy_permutation p q hpq
  have hfun : p = q ∘ e := by funext j; exact (he j).symm
  rw [hfun]
  exact hF n q e

noncomputable def symmetricOccupancyFunction {I K : Type*}
    [DecidableEq I] [Zero K] (F : FiniteOrderedTuple I → K) (k : I → ℕ) : K := by
  classical
  exact if hk : ∃ p : FiniteOrderedTuple I, orderedTupleOccupancy p = k
    then F (Classical.choose hk) else 0

theorem symmetric_occupancy_function_apply {I K : Type*}
    [Fintype I] [DecidableEq I] [Zero K] (F : FiniteOrderedTuple I → K)
    (hF : OrderedTupleSymmetric F) (p : FiniteOrderedTuple I) :
    symmetricOccupancyFunction F (orderedTupleOccupancy p) = F p := by
  classical
  have hp : ∃ q : FiniteOrderedTuple I, orderedTupleOccupancy q = orderedTupleOccupancy p :=
    ⟨p,rfl⟩
  simp only [symmetricOccupancyFunction, dif_pos hp]
  exact symmetric_tuple_equal_on_occupancy F hF _ p (Classical.choose_spec hp)

/-- The factorial memory measure formula applies to any symmetric ordered
test, not only to functions originally supplied in occupancy form. -/
theorem symmetric_ordered_measure_eq_occupancy {I : Type*}
    [Fintype I] [DecidableEq I] (ν : I → ℝ)
    (F : FiniteOrderedTuple I → ℝ) (hF : OrderedTupleSymmetric F) (n : ℕ) :
    (∑ p : Fin n → I, (∏ j, ν (p j)) * F ⟨n,p⟩) / (n.factorial : ℝ) =
      ∑ k ∈ (univ : Finset I).piAntidiag n,
        (∏ i, ν i ^ k i / ((k i).factorial : ℝ)) * symmetricOccupancyFunction F k := by
  have h := sum_tuple_div_factorial_eq_occupancy ν n (symmetricOccupancyFunction F)
  have hp (p : Fin n → I) : symmetricOccupancyFunction F (tupleOccupancy p) = F ⟨n,p⟩ :=
    symmetric_occupancy_function_apply F hF ⟨n,p⟩
  simpa only [hp] using h
end

section
open Finset
theorem symmetric_occupancy_norm_sq {I : Type*} [DecidableEq I]
    (F : FiniteOrderedTuple I → ℂ) (k : I → ℕ) :
    symmetricOccupancyFunction (fun p => ‖F p‖ ^ 2) k =
      ‖symmetricOccupancyFunction F k‖ ^ 2 := by
  classical
  unfold symmetricOccupancyFunction
  split_ifs <;> simp

theorem symmetric_ordered_l2_measure_eq_occupancy {I : Type*}
    [Fintype I] [DecidableEq I] (ν : I → ℝ)
    (F : FiniteOrderedTuple I → ℂ) (hF : OrderedTupleSymmetric F) (n : ℕ) :
    (∑ p : Fin n → I, (∏ j, ν (p j)) * ‖F ⟨n,p⟩‖ ^ 2) / (n.factorial : ℝ) =
      ∑ k ∈ (univ : Finset I).piAntidiag n,
        (∏ i, ν i ^ k i / ((k i).factorial : ℝ)) *
          ‖symmetricOccupancyFunction F k‖ ^ 2 := by
  have hnorm : OrderedTupleSymmetric (fun p => ‖F p‖ ^ 2) := by
    intro m p e
    exact congrArg (fun z : ℂ => ‖z‖ ^ 2) (hF m p e)
  have h := symmetric_ordered_measure_eq_occupancy ν (fun p => ‖F p‖ ^ 2) hnorm n
  simpa only [symmetric_occupancy_norm_sq] using h

theorem symmetric_ordered_l2_cutoff_eq_occupancy {I : Type*}
    [Fintype I] [DecidableEq I] (ν : I → ℝ)
    (F : FiniteOrderedTuple I → ℂ) (hF : OrderedTupleSymmetric F) (B : ℕ) :
    (∑ n ∈ range (B + 1),
      (∑ p : Fin n → I, (∏ j, ν (p j)) * ‖F ⟨n,p⟩‖ ^ 2) / (n.factorial : ℝ)) =
      ∑ k ∈ ghostOccupancyBall (ι := I) B,
        (∏ i, ν i ^ k i / ((k i).factorial : ℝ)) *
          ‖symmetricOccupancyFunction F k‖ ^ 2 := by
  simp_rw [symmetric_ordered_l2_measure_eq_occupancy ν F hF]
  exact sum_ghostOccupancyBall B _

theorem ghost_occupancy_ball_sum_bounded {I M : Type*}
    [Fintype I] [DecidableEq I] [AddCommMonoid M]
    (B : ℕ) (F : (I → ℕ) → M) :
    (∑ m ∈ ghostOccupancyBall B, F m) =
      ∑ x ∈ ghostBoundedTotalCutoff B, F (fun i => (x i : ℕ)) := by
  classical
  symm
  apply sum_bij (fun x _ => fun i => (x i : ℕ))
  · intro x hx
    apply (mem_ghostOccupancyBall B _).mpr
    simpa only [ghostBoundedTotalCutoff, mem_filter, mem_univ, true_and] using hx
  · intro x hx y hy hxy
    funext i
    exact Fin.ext (congrFun hxy i)
  · intro m hm
    have htotal := (mem_ghostOccupancyBall B m).mp hm
    have hbound (i : I) : m i ≤ B :=
      (single_le_sum (fun j _ => Nat.zero_le (m j)) (mem_univ i)).trans htotal
    let x : I → Fin (B + 1) := fun i => ⟨m i, Nat.lt_succ_of_le (hbound i)⟩
    refine ⟨x, ?_, rfl⟩
    simpa only [ghostBoundedTotalCutoff, mem_filter, mem_univ, true_and] using htotal
  · intro x hx
    rfl

/-- The literal symmetric ordered-list norm is exactly the existing bounded
occupancy norm used by the ghost-memory operator theorem. -/
theorem symmetric_ordered_l2_cutoff_eq_bounded {I : Type*}
    [Fintype I] [DecidableEq I] (ν : I → ℝ)
    (F : FiniteOrderedTuple I → ℂ) (hF : OrderedTupleSymmetric F) (B : ℕ) :
    (∑ n ∈ range (B + 1),
      (∑ p : Fin n → I, (∏ j, ν (p j)) * ‖F ⟨n,p⟩‖ ^ 2) / (n.factorial : ℝ)) =
      ∑ x ∈ ghostBoundedTotalCutoff B, ghostMemoryWeight ν x *
        ‖symmetricOccupancyFunction F (fun i => (x i : ℕ))‖ ^ 2 := by
  rw [symmetric_ordered_l2_cutoff_eq_occupancy ν F hF B,
    ghost_occupancy_ball_sum_bounded]
  rfl
end

section
open Finset
/-- Enumerate the retained old indices; the symmetric test makes the choice of
enumeration immaterial. This need not preserve their original order. -/
noncomputable def retainedOrderedTuple {ι : Type*} {N : ℕ} (p : Fin N → ι)
    (s : Finset (Fin N)) : Fin s.card → ι :=
  fun j => p ((s.equivFin.symm j).val)

theorem retained_ordered_tuple_occupancy {ι : Type*} [DecidableEq ι] {N : ℕ}
    (p : Fin N → ι) (s : Finset (Fin N)) :
    tupleOccupancy (retainedOrderedTuple p s) = retainedTupleOccupancy p s := by
  unfold tupleOccupancy retainedOrderedTuple retainedTupleOccupancy
  rw [s.equivFin.symm.sum_comp (fun j : s => (Pi.single (p j.val) 1 : ι → ℕ))]
  exact sum_coe_sort s (fun j => (Pi.single (p j) 1 : ι → ℕ))

theorem tuple_occupancy_append {ι : Type*} [DecidableEq ι] {m n : ℕ}
    (p : Fin m → ι) (q : Fin n → ι) :
    tupleOccupancy (Fin.addCases p q) = tupleOccupancy p + tupleOccupancy q := by
  unfold tupleOccupancy
  rw [Fin.sum_univ_add]
  simp only [Fin.addCases_left, Fin.addCases_right]

/-- The actual output list for one retention-and-birth event. -/
noncomputable def retainedBirthTuple {ι : Type*} {N b : ℕ} (p : Fin N → ι)
    (s : Finset (Fin N)) (q : Fin b → ι) : FiniteOrderedTuple ι :=
  ⟨s.card + b, Fin.addCases (retainedOrderedTuple p s) q⟩

theorem retained_birth_tuple_occupancy {ι : Type*} [DecidableEq ι] {N b : ℕ}
    (p : Fin N → ι) (s : Finset (Fin N)) (q : Fin b → ι) :
    orderedTupleOccupancy (retainedBirthTuple p s q) =
      retainedTupleOccupancy p s + tupleOccupancy q := by
  exact (tuple_occupancy_append (retainedOrderedTuple p s) q).trans
    (congrArg (fun k => k + tupleOccupancy q) (retained_ordered_tuple_occupancy p s))

theorem retained_birth_tuple_total {ι : Type*} [Fintype ι] [DecidableEq ι]
    {N b : ℕ} (p : Fin N → ι) (s : Finset (Fin N)) (q : Fin b → ι) :
    (∑ i, (retainedTupleOccupancy p s + tupleOccupancy q) i) = s.card + b := by
  rw [← retained_birth_tuple_occupancy]
  exact tuple_occupancy_total (retainedBirthTuple p s q).2

theorem symmetric_retained_birth_test {ι : Type*} [Fintype ι] [DecidableEq ι]
    {N b : ℕ} (F : FiniteOrderedTuple ι → ℂ) (hF : OrderedTupleSymmetric F)
    (p : Fin N → ι) (s : Finset (Fin N)) (q : Fin b → ι) :
    F (retainedBirthTuple p s q) =
      symmetricOccupancyFunction F (retainedTupleOccupancy p s + tupleOccupancy q) := by
  rw [← retained_birth_tuple_occupancy]
  exact (symmetric_occupancy_function_apply F hF (retainedBirthTuple p s q)).symm

/-- The literal ordered ghost row. Outputs are retained old entries followed by
the ordered birth batch; the cutoff is their actual list length. -/
noncomputable def symmetricOrderedGhostRow {ι : Type*} [Fintype ι] [DecidableEq ι]
    {N : ℕ} (p : Fin N → ι) (A D C ν : ι → ℝ) (B : ℕ)
    (F : FiniteOrderedTuple ι → ℂ) : ℂ :=
  ∑ b ∈ range (B + 1), ∑ s ∈ (univ : Finset (Fin N)).powerset,
    ∑ q : Fin b → ι,
      ((((∏ j ∈ s, A (p j)) * ∏ j ∈ univ \ s, D (p j)) *
        (∏ j, C (q j) * ν (q j)) / (b.factorial : ℝ) : ℝ) : ℂ) *
        (if s.card + b ≤ B then F (retainedBirthTuple p s q) else 0)

theorem symmetric_ordered_ghost_row_eq_occupancy_row {ι : Type*} [Fintype ι]
    [DecidableEq ι] {N : ℕ} (p : Fin N → ι) (A D C ν : ι → ℝ) (B : ℕ)
    (F : FiniteOrderedTuple ι → ℂ) (hF : OrderedTupleSymmetric F) :
    symmetricOrderedGhostRow p A D C ν B F =
      complexOrderedGhostRow p A D C ν B (symmetricOccupancyFunction F) := by
  unfold symmetricOrderedGhostRow complexOrderedGhostRow
  simp_rw [symmetric_retained_birth_test F hF, retained_birth_tuple_total]

theorem symmetric_ordered_ghost_row_eq_kernel_product {ι : Type*} [Fintype ι]
    [DecidableEq ι] {N : ℕ} (p : Fin N → ι) (A D C ν : ι → ℝ) (B : ℕ)
    (F : FiniteOrderedTuple ι → ℂ) (hF : OrderedTupleSymmetric F) :
    symmetricOrderedGhostRow p A D C ν B F =
      ∑ m ∈ ghostOccupancyBall B,
        ((∏ i, ghostKernel (A i) (D i) (C i) (ν i) (tupleOccupancy p i) (m i) : ℝ) : ℂ) *
          symmetricOccupancyFunction F m := by
  rw [symmetric_ordered_ghost_row_eq_occupancy_row p A D C ν B F hF]
  exact complex_ordered_ghost_row_eq_kernel_product p A D C ν B _

/-- An occupancy test lifted to the bounded state space agrees with its bounded
extension at every output in the total-size ball. -/
theorem ghostBoundedTest_lift_of_total {ι : Type*} [Fintype ι] (B : ℕ)
    (G : (ι → ℕ) → ℂ) (m : ι → ℕ) (hm : (∑ i, m i) ≤ B) :
    ghostBoundedTest B (fun x => G (fun i => (x i : ℕ))) m = G m := by
  have hi (i : ι) : m i ≤ B :=
    (single_le_sum (fun j _ => Nat.zero_le (m j)) (mem_univ i)).trans hm
  unfold ghostBoundedTest
  rw [dif_pos hi]

theorem symmetric_ordered_ghost_row_eq_memory_action {ι : Type*} [Fintype ι]
    [DecidableEq ι] {N : ℕ} (p : Fin N → ι) (A D C ν : ι → ℝ) (B : ℕ)
    (F : FiniteOrderedTuple ι → ℂ) (hF : OrderedTupleSymmetric F)
    (x : ι → Fin (B + 1)) (hp : tupleOccupancy p = fun i => (x i : ℕ)) :
    symmetricOrderedGhostRow p A D C ν B F =
      ghostMemoryAction (ghostBoundedTotalCutoff B) A D C ν
        (fun y => symmetricOccupancyFunction F (fun i => (y i : ℕ))) x := by
  rw [symmetric_ordered_ghost_row_eq_kernel_product p A D C ν B F hF, hp,
    ← ghost_nat_row_eq_memory_action]
  apply sum_congr rfl
  intro m hm
  rw [ghostBoundedTest_lift_of_total B _ m ((mem_ghostOccupancyBall B m).mp hm)]

/-- The row depends on the old ordered tuple only through its occupancy. -/
theorem symmetric_ordered_ghost_row_occupancy_congr {ι : Type*} [Fintype ι]
    [DecidableEq ι] {N M : ℕ} (p : Fin N → ι) (q : Fin M → ι)
    (A D C ν : ι → ℝ) (B : ℕ) (F : FiniteOrderedTuple ι → ℂ)
    (hF : OrderedTupleSymmetric F) (hpq : tupleOccupancy p = tupleOccupancy q) :
    symmetricOrderedGhostRow p A D C ν B F = symmetricOrderedGhostRow q A D C ν B F := by
  rw [symmetric_ordered_ghost_row_eq_kernel_product p A D C ν B F hF,
    symmetric_ordered_ghost_row_eq_kernel_product q A D C ν B F hF, hpq]

/-- The event-level row as a function on all finite ordered input tuples. -/
noncomputable def symmetricOrderedGhostOperator {ι : Type*} [Fintype ι] [DecidableEq ι]
    (A D C ν : ι → ℝ) (B : ℕ) (F : FiniteOrderedTuple ι → ℂ)
    (p : FiniteOrderedTuple ι) : ℂ :=
  symmetricOrderedGhostRow p.2 A D C ν B F

theorem symmetric_ordered_ghost_operator_symmetric {ι : Type*} [Fintype ι]
    [DecidableEq ι] (A D C ν : ι → ℝ) (B : ℕ) (F : FiniteOrderedTuple ι → ℂ)
    (hF : OrderedTupleSymmetric F) :
    OrderedTupleSymmetric (symmetricOrderedGhostOperator A D C ν B F) := by
  intro n p e
  apply symmetric_ordered_ghost_row_occupancy_congr (p ∘ e) p A D C ν B F hF
  exact Equiv.sum_comp e (fun j => (Pi.single (p j) 1 : ι → ℕ))
end

section
open Finset
/-- On bounded occupancies, the descended literal ordered operator is the
existing ghost-memory action on the descended input function. -/
theorem symmetric_ghost_operator_occupancy_action {ι : Type*} [Fintype ι]
    [DecidableEq ι] (A D C ν : ι → ℝ) (B : ℕ)
    (F : FiniteOrderedTuple ι → ℂ) (hF : OrderedTupleSymmetric F)
    (x : ι → Fin (B + 1)) :
    symmetricOccupancyFunction (symmetricOrderedGhostOperator A D C ν B F)
        (fun i => (x i : ℕ)) =
      ghostMemoryAction (ghostBoundedTotalCutoff B) A D C ν
        (fun y => symmetricOccupancyFunction F (fun i => (y i : ℕ))) x := by
  let p : FiniteOrderedTuple ι := ⟨_, ghostOccupancyTuple x⟩
  have hp : orderedTupleOccupancy p = fun i => (x i : ℕ) :=
    ghostOccupancyTuple_occupancy x
  calc
    _ = symmetricOrderedGhostOperator A D C ν B F p := by
      rw [← hp]
      exact symmetric_occupancy_function_apply _
        (symmetric_ordered_ghost_operator_symmetric A D C ν B F hF) p
    _ = _ := symmetric_ordered_ghost_row_eq_memory_action p.2 A D C ν B F hF x hp

/-- The actual symmetric ordered-list ghost operator obeys the ghost Schur
bound. Repetitions are permitted, the cutoff is total list length, and the
factorial denominator is the ordered-list measure on both sides. -/
theorem symmetric_ordered_ghost_l2_sq_le {ι : Type*} [Fintype ι] [DecidableEq ι]
    (A D C ν v : ι → ℝ) (B : ℕ)
    (hA : ∀ i, 0 ≤ A i) (hν : ∀ i, 0 < ν i) (hv : ∀ i, 0 < v i)
    (hD : ∀ i, A i + |D i| / v i ≤ 1)
    (hC : ∀ i, A i + |C i| / v i ≤ 1)
    (F : FiniteOrderedTuple ι → ℂ) (hF : OrderedTupleSymmetric F) :
    (∑ n ∈ range (B + 1),
      (∑ p : Fin n → ι, (∏ j, ν (p j)) *
        ‖symmetricOrderedGhostOperator A D C ν B F ⟨n, p⟩‖ ^ 2) /
          (n.factorial : ℝ)) ≤
      Real.exp (∑ i, (|C i| + |D i|) * ν i * v i) *
        ∑ n ∈ range (B + 1),
          (∑ p : Fin n → ι, (∏ j, ν (p j)) * ‖F ⟨n, p⟩‖ ^ 2) /
            (n.factorial : ℝ) := by
  rw [symmetric_ordered_l2_cutoff_eq_bounded ν _
      (symmetric_ordered_ghost_operator_symmetric A D C ν B F hF) B,
    symmetric_ordered_l2_cutoff_eq_bounded ν F hF B]
  simp_rw [symmetric_ghost_operator_occupancy_action A D C ν B F hF]
  exact ghostMemory_l2_sq_le (ghostBoundedTotalCutoff B) A D C ν v hA hν hv hD hC
    (fun x => symmetricOccupancyFunction F (fun i => (x i : ℕ)))
end

section
open Finset
open scoped BigOperators Classical
/-- The fixed final block of omission slots. -/
def physicalOmissionSlots (J ell : ℕ) : Finset (PhysicalSlots J ell) :=
  univ.map Function.Embedding.inr

theorem physical_omission_slots_card (J ell : ℕ) :
    (physicalOmissionSlots J ell).card = ell := by
  simp only [physicalOmissionSlots, card_map, card_univ, Fintype.card_fin]

/-- Extend independent permutations of the small groups by the identity. -/
noncomputable def physicalExtendSmallPermutations {G : Type*} {J ell : ℕ}
    (small : Finset G) (σ : ↥small → Equiv.Perm (PhysicalSlots J ell)) :
    PhysicalPermutations G J ell :=
  fun g => if hg : g ∈ small then σ ⟨g, hg⟩ else Equiv.refl _

theorem physical_extend_small_permutations_apply {G : Type*} {J ell : ℕ}
    (small : Finset G) (σ : ↥small → Equiv.Perm (PhysicalSlots J ell)) (g : small) :
    physicalExtendSmallPermutations small σ g.val = σ g := by
  simp only [physicalExtendSmallPermutations, dif_pos g.property]

theorem physical_extend_small_permutations_outside {G : Type*} {J ell : ℕ}
    (small : Finset G) (σ : ↥small → Equiv.Perm (PhysicalSlots J ell))
    (g : G) (hg : g ∉ small) :
    physicalExtendSmallPermutations small σ g = Equiv.refl _ := by
  simp only [physicalExtendSmallPermutations, dif_neg hg]

/-- Map each omitted slot subset through its fixed injective source list. -/
def physicalPrimeOmissionsOfSlots {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (small : Finset G) (labels : PhysicalMarkLists P J ell)
    (A : GroupedOmissionSubsets ↥small (PhysicalSlots J ell) ell) :
    PrimeOmissionChoices (physicalSmallSourcePools small labels) ell :=
  fun g => ⟨(A g).val.map (physicalGroupMarkEmbedding labels g.val),
    mem_powersetCard.mpr ⟨
      map_subset_map.mpr (mem_powersetCard.mp (A g).property).1,
      by simpa only [card_map] using (mem_powersetCard.mp (A g).property).2⟩⟩

theorem physical_prime_omissions_of_slots_injective {G : Type*}
    {P : G → Finset ℕ} {J ell : ℕ}
    (small : Finset G) (labels : PhysicalMarkLists P J ell) :
    Function.Injective (physicalPrimeOmissionsOfSlots small labels) := by
  intro A B h
  funext g
  apply Subtype.ext
  apply map_injective (physicalGroupMarkEmbedding labels g.val)
  exact congrArg Subtype.val (congrFun h g)

/-- The concrete permuted last-slot primes are the image of the uniformly
permuted slot subsets. -/
theorem physical_small_omissions_eq_of_slots {G : Type*}
    {P : G → Finset ℕ} {J ell : ℕ}
    (small : Finset G) (labels : PhysicalMarkLists P J ell)
    (σ : ↥small → Equiv.Perm (PhysicalSlots J ell)) :
    physicalSmallOmissions small labels (physicalExtendSmallPermutations small σ) =
      physicalPrimeOmissionsOfSlots small labels
        (groupedPermutedOmissions (physicalOmissionSlots J ell)
          (physical_omission_slots_card J ell) σ) := by
  funext g
  apply Subtype.ext
  change physicalLastMarks
      (physicalPermuteLabels (physicalExtendSmallPermutations small σ) labels) g.val =
    ((physicalOmissionSlots J ell).map (σ g).toEmbedding).map
      (physicalGroupMarkEmbedding labels g.val)
  simp only [physicalLastMarks, physicalOmissionSlots, map_map]
  congr 1
  apply Function.Embedding.ext
  intro j
  change (labels g.val ((physicalExtendSmallPermutations small σ) g.val (Sum.inr j))).val =
    (labels g.val (σ g (Sum.inr j))).val
  rw [physical_extend_small_permutations_apply]

/-- Every tuple of omission slot subsets is induced by independent small
group permutations. -/
theorem physical_grouped_slot_omissions_surjective {G : Type*} {J ell : ℕ}
    (small : Finset G) :
    Function.Surjective
      (groupedPermutedOmissions (G := ↥small) (physicalOmissionSlots J ell)
        (physical_omission_slots_card J ell)) := by
  intro A
  choose σ hσ using fun g =>
    permuted_omission_subset_surjective (physicalOmissionSlots J ell)
      (physical_omission_slots_card J ell) (A g)
  exact ⟨σ, funext hσ⟩

/-- For each slot-subset tuple, the corresponding fixed-big-factor
complementary dilation. -/
noncomputable def physicalSlotOmissionDilation {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (small : Finset G) (C : G → Finset (Fin J)) (labels : PhysicalMarkLists P J ell)
    (aux : PhysicalAuxLabels P C)
    (A : GroupedOmissionSubsets ↥small (PhysicalSlots J ell) ell) : ℕ :=
  primeOmissionDilation (physicalSmallSourcePools small labels) ell
    (physicalBigGroupD small C labels aux) (physicalPrimeOmissionsOfSlots small labels A)

theorem physical_D_extend_eq_slot_dilation {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (small : Finset G) (C : G → Finset (Fin J)) (labels : PhysicalMarkLists P J ell)
    (aux : PhysicalAuxLabels P C) (σ : ↥small → Equiv.Perm (PhysicalSlots J ell))
    (hsmall : ∀ g ∈ small, C g = ∅) :
    physicalD C (physicalPermuteLabels (physicalExtendSmallPermutations small σ) labels) aux =
      physicalSlotOmissionDilation small C labels aux
        (groupedPermutedOmissions (physicalOmissionSlots J ell)
          (physical_omission_slots_card J ell) σ) := by
  rw [physical_D_eq_big_mul_retained small C labels aux _ hsmall,
    physical_big_groupD_permute_eq small C labels aux _
      (physical_extend_small_permutations_outside small σ),
    physical_small_omissions_eq_of_slots]
  rfl

/-- Exact uniform pushforward for arbitrary joint functions of the actual
prime omissions. No independence of the function's coordinates is needed. -/
theorem physical_small_omission_average {G : Type*}
    {P : G → Finset ℕ} {J ell : ℕ}
    (small : Finset G) (labels : PhysicalMarkLists P J ell)
    (f : PrimeOmissionChoices (physicalSmallSourcePools small labels) ell → ℝ) :
    letI : DecidableEq ↥small := Classical.decEq _
    letI : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
    (∑ σ : ↥small → Equiv.Perm (PhysicalSlots J ell),
        f (physicalSmallOmissions small labels (physicalExtendSmallPermutations small σ))) /
        (Fintype.card (↥small → Equiv.Perm (PhysicalSlots J ell)) : ℝ) =
      (∑ A : GroupedOmissionSubsets ↥small (PhysicalSlots J ell) ell,
        f (physicalPrimeOmissionsOfSlots small labels A)) /
        (((J + ell).choose ell) ^ small.card : ℕ) := by
  let _ : DecidableEq ↥small := Classical.decEq _
  let _ : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
  have hslots : Fintype.card (PhysicalSlots J ell) = J + ell := by
    simp only [PhysicalSlots, Fintype.card_sum, Fintype.card_fin]
  have h := grouped_uniform_omission_average (G := ↥small) (physicalOmissionSlots J ell)
    (physical_omission_slots_card J ell) (fun A => f (physicalPrimeOmissionsOfSlots small labels A))
  rw [hslots, show Fintype.card ↥small = small.card from Fintype.card_coe small] at h
  simp_rw [physical_small_omissions_eq_of_slots]
  exact h

/-- Under the omitted-product bound, the fraction of actual independent
small-group permutations making any pending prime eligible is at most the
pending count divided by the number of omission tuples. -/
theorem physical_small_permutation_eligible_fraction_le {G Particle : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (small : Finset G) (C : G → Finset (Fin J)) (labels : PhysicalMarkLists P J ell)
    (aux : PhysicalAuxLabels P C) (hsmall : ∀ g ∈ small, C g = ∅)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (pending : Finset Particle) (p : Particle → ℕ) (hp : ∀ z, (p z).Prime)
    (r : ∀ z, ZMod (p z)) (k : ℤ) (hk : ∀ z ∈ pending, ¬ (p z : ℤ) ∣ k)
    (hlt : ∀ z ∈ pending, ∀ σ : ↥small → Equiv.Perm (PhysicalSlots J ell),
      primeOmissionProduct (physicalSmallSourcePools small labels) ell
        (physicalSmallOmissions small labels (physicalExtendSmallPermutations small σ)) < p z) :
    letI : DecidableEq ↥small := Classical.decEq _
    letI : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
    ((univ.filter (fun σ : ↥small → Equiv.Perm (PhysicalSlots J ell) =>
        ∃ z ∈ pending,
          ¬ p z ∣ physicalD C (physicalPermuteLabels (physicalExtendSmallPermutations small σ) labels) aux ∧
          r z + (k : ZMod (p z)) *
            (physicalD C (physicalPermuteLabels (physicalExtendSmallPermutations small σ) labels) aux :
              ZMod (p z)) = 0)).card : ℝ) /
        (Fintype.card (↥small → Equiv.Perm (PhysicalSlots J ell)) : ℝ) ≤
      (pending.card : ℝ) / (((J + ell).choose ell) ^ small.card : ℕ) := by
  let _ : DecidableEq ↥small := Classical.decEq _
  let _ : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
  let U : GroupedOmissionSubsets ↥small (PhysicalSlots J ell) ell → ℕ :=
    fun A => primeOmissionProduct (physicalSmallSourcePools small labels) ell
      (physicalPrimeOmissionsOfSlots small labels A)
  let D := physicalSlotOmissionDilation small C labels aux
  let bad : Finset (GroupedOmissionSubsets ↥small (PhysicalSlots J ell) ell) :=
    rareOmissionChoices univ pending
      (fun z A => ¬ p z ∣ D A ∧ r z + (k : ZMod (p z)) * (D A : ZMod (p z)) = 0)
  have hU : Function.Injective U :=
    (prime_omission_product_injective (physicalSmallSourcePools small labels) ell
      (physical_small_source_pools_prime small labels hP)
      (physical_small_source_pools_disjoint small labels hdis)).comp
        (physical_prime_omissions_of_slots_injective small labels)
  have hltA : ∀ z ∈ pending, ∀ A, U A < p z := by
    intro z hz A
    obtain ⟨σ, hσ⟩ := physical_grouped_slot_omissions_surjective small A
    have h := hlt z hz σ
    rw [physical_small_omissions_eq_of_slots, hσ] at h
    exact h
  have hfactor : ∀ A, U A * D A =
      physicalBigGroupD small C labels aux * primeFullProduct (physicalSmallSourcePools small labels) := by
    intro A
    exact prime_omission_mul_dilation_eq (physicalSmallSourcePools small labels) ell
      (physicalBigGroupD small C labels aux) (physicalPrimeOmissionsOfSlots small labels A)
  have hbad : bad.card ≤ pending.card :=
    modular_eligible_omission_card_le univ pending U hU p hp (fun _ => D)
      (fun _ => physicalBigGroupD small C labels aux * primeFullProduct (physicalSmallSourcePools small labels))
      (fun _ A => hfactor A) r k hk hltA
  have hevent : ∀ σ : ↥small → Equiv.Perm (PhysicalSlots J ell),
      groupedPermutedOmissions (physicalOmissionSlots J ell) (physical_omission_slots_card J ell) σ ∈ bad ↔
        ∃ z ∈ pending,
          ¬ p z ∣ physicalD C (physicalPermuteLabels (physicalExtendSmallPermutations small σ) labels) aux ∧
          r z + (k : ZMod (p z)) *
            (physicalD C (physicalPermuteLabels (physicalExtendSmallPermutations small σ) labels) aux :
              ZMod (p z)) = 0 := by
    intro σ
    simp only [bad, rareOmissionChoices, mem_filter, mem_univ, true_and, D,
      ← physical_D_extend_eq_slot_dilation small C labels aux σ hsmall]
  have h := grouped_uniform_bad_omission_fraction_le
    (physicalOmissionSlots J ell) (physical_omission_slots_card J ell) bad pending.card hbad
  have hslots : Fintype.card (PhysicalSlots J ell) = J + ell := by
    simp only [PhysicalSlots, Fintype.card_sum, Fintype.card_fin]
  rw [hslots, show Fintype.card ↥small = small.card from Fintype.card_coe small] at h
  simp only [hevent] at h
  exact h
end

section
open Filter Finset
open scoped Topology
theorem eventually_log_times_rpow_lt {a b : ℝ} (hab : a < b) (D : ℝ) :
    ∀ᶠ L : ℝ in atTop, D * L ^ a * Real.log L < L ^ b := by
  have h := ((isLittleO_log_rpow_atTop (sub_pos.mpr hab)).const_mul_left D).bound
    (show (0 : ℝ) < 1 / 2 by norm_num)
  filter_upwards [h, eventually_gt_atTop (0 : ℝ)] with L hL hpos
  have hp : 0 < L ^ (b - a) := Real.rpow_pos_of_pos hpos _
  have ht : D * Real.log L < L ^ (b - a) := by
    have hn : D * Real.log L ≤ ‖D * Real.log L‖ := le_abs_self _
    simp only [Real.norm_eq_abs, abs_of_pos hp] at hL hn
    linarith
  have hm := mul_lt_mul_of_pos_left ht (Real.rpow_pos_of_pos hpos a)
  have he : L ^ a * L ^ (b - a) = L ^ b := by
    rw [← Real.rpow_add hpos]
    congr 1
    ring
  rw [he] at hm
  nlinarith

/-- Products with ell factors from each of logarithmically many small
groups are eventually below the lower endpoint of a separated big group. -/
theorem eventually_small_omission_power_lt {a b : ℝ} (hab : a < b)
    (ell : ℕ) (C : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ s : ℕ, (s : ℝ) ≤ C * Real.log L →
      (Real.exp (L ^ a)) ^ (ell * s) < Real.exp (L ^ b) := by
  filter_upwards [eventually_log_times_rpow_lt hab ((ell : ℝ) * C),
    eventually_gt_atTop (0 : ℝ)] with L hL hpos
  intro s hs
  rw [← Real.exp_nat_mul]
  apply Real.exp_lt_exp.mpr
  have hmul := mul_le_mul_of_nonneg_left hs
    (mul_nonneg (Nat.cast_nonneg ell) (Real.rpow_pos_of_pos hpos a).le)
  push_cast
  calc
    (ell : ℝ) * s * L ^ a ≤ (ell : ℝ) * C * L ^ a * Real.log L := by nlinarith
    _ < L ^ b := hL

/-- A real bound for all source labels bounds their omission product. -/
theorem prime_omission_product_real_le_pow {G : Type*} [Fintype G]
    (S : G → Finset ℕ) (ell : ℕ) {H : ℝ}
    (hlabels : ∀ g p, p ∈ S g → (p : ℝ) ≤ H)
    (A : PrimeOmissionChoices S ell) :
    (primeOmissionProduct S ell A : ℝ) ≤ H ^ (ell * Fintype.card G) := by
  classical
  unfold primeOmissionProduct
  push_cast
  calc
    (∏ g, ∏ p ∈ (A g).val, (p : ℝ)) ≤ ∏ _g : G, H ^ ell := by
      apply Finset.prod_le_prod₀
      · intro g _
        positivity
      · intro g _
        calc
          (∏ p ∈ (A g).val, (p : ℝ)) ≤ ∏ _p ∈ (A g).val, H := by
            apply Finset.prod_le_prod₀
            · intro p _
              exact Nat.cast_nonneg p
            · intro p hp
              exact hlabels g p ((mem_powersetCard.mp (A g).property).1 hp)
          _ = H ^ ell := by rw [prod_const, (mem_powersetCard.mp (A g).property).2]
    _ = H ^ (ell * Fintype.card G) := by
      rw [prod_const, card_univ, ← pow_mul]
end

section
open Finset
open scoped Classical
theorem physical_small_omission_lt_of_bounds {G : Type*}
    {P : G → Finset ℕ} {J ell : ℕ}
    (small : Finset G) (labels : PhysicalMarkLists P J ell)
    {H P₀ : ℝ} (hlabels : ∀ g ∈ small, ∀ p ∈ P g, (p : ℝ) ≤ H)
    (hpower : H ^ (ell * small.card) < P₀) (p : ℕ) (hp : P₀ ≤ (p : ℝ))
    (σ : ↥small → Equiv.Perm (PhysicalSlots J ell)) :
    primeOmissionProduct (physicalSmallSourcePools small labels) ell
      (physicalSmallOmissions small labels (physicalExtendSmallPermutations small σ)) < p := by
  have h := prime_omission_product_real_le_pow (physicalSmallSourcePools small labels) ell
    (fun g q hq => hlabels g.val g.property q (physical_group_marks_subset labels g.val hq))
    (physicalSmallOmissions small labels (physicalExtendSmallPermutations small σ))
  rw [show Fintype.card ↥small = small.card from Fintype.card_coe small] at h
  exact_mod_cast lt_of_le_of_lt h (hpower.trans_le hp)

/-- A real lower endpoint for the big-prime range supplies the nonzero
short-step congruence condition. -/
theorem physical_pending_step_not_dvd_of_bounds {p : ℕ} {k : ℤ} {P₀ : ℝ}
    (hkpos : 0 < k.natAbs) (hstep : (k.natAbs : ℝ) < P₀)
    (hp : P₀ ≤ (p : ℝ)) : ¬ (p : ℤ) ∣ k := by
  apply nat_not_dvd_int_of_natAbs_lt hkpos
  exact_mod_cast hstep.trans_le hp
end

section

open scoped BigOperators ComplexConjugate

/-- A label may change the translation even when both active endpoints are fixed. -/
noncomputable def cleanTranslatedSumOperator {A X R : Type*} [Fintype A] [Fintype X]
    [AddCommGroup R] (K : A → X → X → ℂ) (δ : A → X → X → R)
    (f : X → R → ℂ) (x : X) (r : R) : ℂ :=
  ∑ a, cleanTranslatedOperator (K a) (δ a) f x r

/-- All auxiliary and pattern labels are summed before estimating this block. -/
noncomputable def cleanFourierSumBlock {A X R : Type*} [Fintype A] [Fintype X]
    [AddCommGroup R] (K : A → X → X → ℂ) (δ : A → X → X → R)
    (χ : AddChar R ℂ) (v : X → ℂ) (x : X) : ℂ :=
  ∑ a, cleanFourierBlock (K a) (δ a) χ v x

/-- The summed Fourier block is the finite matrix whose entries retain all phases. -/
theorem clean_fourier_sum_block_matrix {A X R : Type*} [Fintype A] [Fintype X]
    [AddCommGroup R] (K : A → X → X → ℂ) (δ : A → X → X → R)
    (χ : AddChar R ℂ) (v : X → ℂ) (x : X) :
    cleanFourierSumBlock K δ χ v x =
      ∑ y, (∑ a, K a x y * χ (δ a x y)) * v y := by
  simp only [cleanFourierSumBlock, cleanFourierBlock, Finset.sum_mul]
  exact Finset.sum_comm

/-- Fourier synthesis intertwines the full translated label sum with the full block sum. -/
theorem clean_fourier_sum_translated_synthesis {A X R : Type*} [Fintype A] [Fintype X]
    [AddCommGroup R] [Fintype R] (K : A → X → X → ℂ) (δ : A → X → X → R)
    (c : AddChar R ℂ → X → ℂ) (x : X) (r : R) :
    cleanTranslatedSumOperator K δ (fun y => cleanFourierSynthesis (fun χ => c χ y)) x r =
      cleanFourierSynthesis (fun χ => cleanFourierSumBlock K δ χ (c χ) x) r := by
  simp only [cleanTranslatedSumOperator, clean_fourier_translated_synthesis,
    cleanFourierSynthesis, cleanFourierSumBlock, Finset.sum_mul]
  exact Finset.sum_comm

theorem clean_sum_translated_expansion {A X R : Type*} [Fintype A] [Fintype X]
    [AddCommGroup R] [Fintype R] (K : A → X → X → ℂ) (δ : A → X → X → R)
    (f : X → R → ℂ) (x : X) (r : R) :
    cleanTranslatedSumOperator K δ f x r =
      cleanFourierSynthesis
        (fun χ => cleanFourierSumBlock K δ χ (fun y => cleanFourierCoefficients (f y) χ) x) r := by
  let c : AddChar R ℂ → X → ℂ := fun χ y => cleanFourierCoefficients (f y) χ
  have hrep : f = fun y => cleanFourierSynthesis (fun χ => c χ y) := by
    funext y s
    exact (clean_fourier_synthesis_coefficients (f y) s).symm
  calc
    cleanTranslatedSumOperator K δ f x r =
        cleanTranslatedSumOperator K δ (fun y => cleanFourierSynthesis (fun χ => c χ y)) x r :=
      congrArg (fun F => cleanTranslatedSumOperator K δ F x r) hrep
    _ = _ := clean_fourier_sum_translated_synthesis K δ c x r

/-- Exact diagonalization of the label sum; no triangle inequality occurs. -/
theorem clean_fourier_coefficients_sum_translated {A X R : Type*} [Fintype A] [Fintype X]
    [AddCommGroup R] [Fintype R] (K : A → X → X → ℂ) (δ : A → X → X → R)
    (f : X → R → ℂ) (χ : AddChar R ℂ) (x : X) :
    cleanFourierCoefficients (cleanTranslatedSumOperator K δ f x) χ =
      cleanFourierSumBlock K δ χ (fun y => cleanFourierCoefficients (f y) χ) x := by
  have hop : cleanTranslatedSumOperator K δ f x =
      cleanFourierSynthesis
        (fun ψ => cleanFourierSumBlock K δ ψ (fun y => cleanFourierCoefficients (f y) ψ) x) := by
    funext r
    exact clean_sum_translated_expansion K δ f x r
  rw [hop, clean_fourier_coefficients_synthesis]

/-- Exact Parseval identity for the entire translated operator, including all cross terms
between its pattern and auxiliary labels. The active weights may be arbitrary real numbers. -/
theorem clean_sum_translated_weighted_energy {A X R : Type*} [Fintype A] [Fintype X]
    [AddCommGroup R] [Fintype R] (w : X → ℝ) (K : A → X → X → ℂ)
    (δ : A → X → X → R) (f : X → R → ℂ) :
    ∑ x, w x * ∑ r, ‖cleanTranslatedSumOperator K δ f x r‖ ^ 2 =
      (Fintype.card R : ℝ) * ∑ χ, ∑ x,
        w x * ‖cleanFourierSumBlock K δ χ (fun y => cleanFourierCoefficients (f y) χ) x‖ ^ 2 := by
  simp_rw [clean_sum_translated_expansion]
  exact clean_fourier_weighted_energy w _

/-- Only the complete Fourier block needs to be bounded on the active subspace. -/
theorem clean_sum_translated_energy_le_of_fourier_blocks {A X R : Type*}
    [Fintype A] [Fintype X] [AddCommGroup R] [Fintype R]
    (w : X → ℝ) (K : A → X → X → ℂ) (δ : A → X → X → R)
    (U : Submodule ℂ (X → ℂ)) (C : ℝ)
    (hblock : ∀ (χ : AddChar R ℂ) (v : X → ℂ), v ∈ U →
      ∑ x, w x * ‖cleanFourierSumBlock K δ χ v x‖ ^ 2 ≤
        C ^ 2 * ∑ x, w x * ‖v x‖ ^ 2)
    (f : X → R → ℂ) (hf : ∀ r, (fun x => f x r) ∈ U) :
    ∑ x, w x * ∑ r, ‖cleanTranslatedSumOperator K δ f x r‖ ^ 2 ≤
      C ^ 2 * ∑ x, w x * ∑ r, ‖f x r‖ ^ 2 := by
  let c : AddChar R ℂ → X → ℂ := fun χ x => cleanFourierCoefficients (f x) χ
  have hrep : f = fun x => cleanFourierSynthesis (fun χ => c χ x) := by
    funext x r
    exact (clean_fourier_synthesis_coefficients (f x) r).symm
  have hcmem (χ : AddChar R ℂ) : c χ ∈ U := clean_fourier_coefficients_mem U f hf χ
  rw [hrep]
  simp_rw [clean_fourier_sum_translated_synthesis]
  rw [clean_fourier_weighted_energy, clean_fourier_weighted_energy]
  calc
    (Fintype.card R : ℝ) * ∑ χ, ∑ x, w x * ‖cleanFourierSumBlock K δ χ (c χ) x‖ ^ 2 ≤
        (Fintype.card R : ℝ) * ∑ χ, C ^ 2 * ∑ x, w x * ‖c χ x‖ ^ 2 := by
      apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
      exact Finset.sum_le_sum (fun χ _ => hblock χ (c χ) (hcmem χ))
    _ = C ^ 2 * ((Fintype.card R : ℝ) * ∑ χ, ∑ x, w x * ‖c χ x‖ ^ 2) := by
      rw [← Finset.mul_sum]
      ring

theorem clean_sum_translated_norm_le_of_fourier_blocks {A X R : Type*}
    [Fintype A] [Fintype X] [AddCommGroup R] [Fintype R]
    (w : X → ℝ) (K : A → X → X → ℂ) (δ : A → X → X → R)
    (U : Submodule ℂ (X → ℂ)) (C : ℝ) (hC : 0 ≤ C)
    (hblock : ∀ (χ : AddChar R ℂ) (v : X → ℂ), v ∈ U →
      ∑ x, w x * ‖cleanFourierSumBlock K δ χ v x‖ ^ 2 ≤
        C ^ 2 * ∑ x, w x * ‖v x‖ ^ 2)
    (f : X → R → ℂ) (hf : ∀ r, (fun x => f x r) ∈ U) :
    cleanWeightedNorm w (cleanTranslatedSumOperator K δ f) ≤ C * cleanWeightedNorm w f := by
  have h := Real.sqrt_le_sqrt
    (clean_sum_translated_energy_le_of_fourier_blocks w K δ U C hblock f hf)
  simpa only [cleanWeightedNorm, Real.sqrt_mul (sq_nonneg C), Real.sqrt_sq hC] using h

theorem clean_sum_translated_norm_le_of_active_norm_blocks {A X R : Type*}
    [Fintype A] [Fintype X] [AddCommGroup R] [Fintype R]
    (w : X → ℝ) (hw : ∀ x, 0 ≤ w x) (K : A → X → X → ℂ) (δ : A → X → X → R)
    (U : Submodule ℂ (X → ℂ)) (C : ℝ) (hC : 0 ≤ C)
    (hblock : ∀ (χ : AddChar R ℂ) (v : X → ℂ), v ∈ U →
      cleanActiveNorm w (cleanFourierSumBlock K δ χ v) ≤ C * cleanActiveNorm w v)
    (f : X → R → ℂ) (hf : ∀ r, (fun x => f x r) ∈ U) :
    cleanWeightedNorm w (cleanTranslatedSumOperator K δ f) ≤ C * cleanWeightedNorm w f := by
  apply clean_sum_translated_norm_le_of_fourier_blocks w K δ U C hC _ f hf
  intro χ v hv
  have h := hblock χ v hv
  have hs := sq_le_sq₀ (Real.sqrt_nonneg _) (mul_nonneg hC (Real.sqrt_nonneg _)) |>.mpr h
  change cleanActiveNorm w (cleanFourierSumBlock K δ χ v) ^ 2 ≤
    (C * cleanActiveNorm w v) ^ 2 at hs
  simpa only [mul_pow, clean_active_norm_sq w hw] using hs

theorem clean_sum_translated_normalized_norm_le_of_active_norm_blocks {A X R : Type*}
    [Fintype A] [Fintype X] [AddCommGroup R] [Fintype R]
    (w : X → ℝ) (hw : ∀ x, 0 ≤ w x) (K : A → X → X → ℂ) (δ : A → X → X → R)
    (U : Submodule ℂ (X → ℂ)) (C : ℝ) (hC : 0 ≤ C)
    (hblock : ∀ (χ : AddChar R ℂ) (v : X → ℂ), v ∈ U →
      cleanActiveNorm w (cleanFourierSumBlock K δ χ v) ≤ C * cleanActiveNorm w v)
    (f : X → R → ℂ) (hf : ∀ r, (fun x => f x r) ∈ U) :
    Real.sqrt ((Fintype.card R : ℝ)⁻¹) *
        cleanWeightedNorm w (cleanTranslatedSumOperator K δ f) ≤
      C * (Real.sqrt ((Fintype.card R : ℝ)⁻¹) * cleanWeightedNorm w f) := by
  have h := mul_le_mul_of_nonneg_left
    (clean_sum_translated_norm_le_of_active_norm_blocks w hw K δ U C hC hblock f hf)
    (Real.sqrt_nonneg ((Fintype.card R : ℝ)⁻¹))
  simpa only [mul_left_comm _ C] using h
end

section

abbrev PhysicalSharedLists {G : Type*} (P : G → Finset ℕ) (J : ℕ) :=
  ∀ g, Fin J ↪ ↥(P g)

def physicalSharedPrefix {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (L : PhysicalMarkLists P J ell) : PhysicalSharedLists P J :=
  fun g => Function.Embedding.inl.trans (L g)

def physicalResidueSharedValid {G : Type*} {P : G → Finset ℕ} {J : ℕ}
    (r : PhysicalResidues P) (d : PhysicalSharedLists P J) : Prop :=
  ∀ g j, r ⟨g, d g j⟩ = 0

abbrev PhysicalResidueSharedFiber {G : Type*} (P : G → Finset ℕ) (J ell : ℕ)
    (r : PhysicalResidues P) (d : PhysicalSharedLists P J) :=
  {L : PhysicalResidueMarksAt P J ell r // physicalSharedPrefix L.val = d}

theorem physical_shared_prefix_apply {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (L : PhysicalMarkLists P J ell) (g : G) (j : Fin J) :
    physicalSharedPrefix L g j = L g (Sum.inl j) := rfl

theorem physical_shared_prefix_valid {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (r : PhysicalResidues P) (L : PhysicalResidueMarksAt P J ell r) :
    physicalResidueSharedValid r (physicalSharedPrefix L.val) := by
  intro g j
  exact L.property g (Sum.inl j)

theorem physical_shared_fiber_valid {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (r : PhysicalResidues P) (d : PhysicalSharedLists P J)
    (L : PhysicalResidueSharedFiber P J ell r d) : physicalResidueSharedValid r d := by
  rw [← L.property]
  exact physical_shared_prefix_valid r L.val

theorem physical_shared_prefix_eq_iff {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (L : PhysicalMarkLists P J ell) (d : PhysicalSharedLists P J) :
    physicalSharedPrefix L = d ↔ ∀ g j, L g (Sum.inl j) = d g j := by
  constructor
  · intro h g j
    exact congrArg (fun e : PhysicalSharedLists P J => e g j) h
  · intro h
    funext g
    exact Function.Embedding.ext (h g)
end

section
open Finset Classical
abbrev PhysicalResidueZeroLabels {G : Type*} (P : G → Finset ℕ) (g : G)
    (r : PhysicalResidues P) := {p : ↥(P g) // r ⟨g, p⟩ = 0}

theorem physical_residue_divisor_pool_subset {G : Type*} (P : G → Finset ℕ) (g : G)
    (r : PhysicalResidues P) : physicalResidueDivisorPool P g r ⊆ P g := by
  classical
  intro p hp
  rcases mem_image.mp hp with ⟨q, _, rfl⟩
  exact q.property

theorem mem_physical_residue_divisor_pool {G : Type*} (P : G → Finset ℕ) (g : G)
    (r : PhysicalResidues P) (p : ↥(P g)) :
    p.val ∈ physicalResidueDivisorPool P g r ↔ r ⟨g, p⟩ = 0 := by
  classical
  constructor
  · intro hp
    rcases mem_image.mp hp with ⟨q, hq, he⟩
    have hqp : q = p := Subtype.ext he
    subst q
    exact (mem_filter.mp hq).2
  · intro hp
    exact mem_image.mpr ⟨p, mem_filter.mpr ⟨mem_attach _ _, hp⟩, rfl⟩

noncomputable def physicalResidueZeroLabelsEquiv {G : Type*}
    (P : G → Finset ℕ) (g : G) (r : PhysicalResidues P) :
    PhysicalResidueZeroLabels P g r ≃ ↥(physicalResidueDivisorPool P g r) :=
  Equiv.ofBijective
    (fun p => ⟨p.val.val, (mem_physical_residue_divisor_pool P g r p.val).mpr p.property⟩)
    ⟨by
      intro p q hpq
      have he : p.val.val = q.val.val :=
        congrArg (fun z : ↥(physicalResidueDivisorPool P g r) => z.val) hpq
      exact Subtype.ext (Subtype.ext he),
     by
      intro p
      let q : ↥(P g) := ⟨p.val, physical_residue_divisor_pool_subset P g r p.property⟩
      exact ⟨⟨q, (mem_physical_residue_divisor_pool P g r q).mp p.property⟩, rfl⟩⟩

theorem physical_residue_zero_labels_card {G : Type*} (P : G → Finset ℕ) (g : G)
    (r : PhysicalResidues P) :
    Fintype.card (PhysicalResidueZeroLabels P g r) = physicalResidueOmega P g r := by
  rw [Fintype.card_congr (physicalResidueZeroLabelsEquiv P g r), Fintype.card_coe]
  rfl

def physicalResidueMarksEmbedding {G : Type*} (P : G → Finset ℕ) (J ell : ℕ)
    (r : PhysicalResidues P) (L : PhysicalResidueMarksAt P J ell r) (g : G) :
    PhysicalSlots J ell ↪ PhysicalResidueZeroLabels P g r where
  toFun s := ⟨L.val g s, L.property g s⟩
  inj' := by
    intro s t hst
    exact (L.val g).injective (congrArg Subtype.val hst)

theorem physical_residue_marks_embedding_apply {G : Type*} (P : G → Finset ℕ)
    (J ell : ℕ) (r : PhysicalResidues P) (L : PhysicalResidueMarksAt P J ell r)
    (g : G) (s : PhysicalSlots J ell) :
    (physicalResidueMarksEmbedding P J ell r L g s).val = L.val g s := rfl

theorem physical_residue_slots_le_omega {G : Type*} (P : G → Finset ℕ) (J ell : ℕ)
    (r : PhysicalResidues P) (L : PhysicalResidueMarksAt P J ell r) (g : G) :
    J + ell ≤ physicalResidueOmega P g r := by
  have h := Fintype.card_le_of_embedding (physicalResidueMarksEmbedding P J ell r L g)
  simpa only [Fintype.card_sum, Fintype.card_fin, physical_residue_zero_labels_card] using h
end

section
open scoped BigOperators
open Classical
def physicalResidueSharedEmbedding {G : Type*} {P : G → Finset ℕ} {J : ℕ}
    (r : PhysicalResidues P) (d : PhysicalSharedLists P J)
    (hd : physicalResidueSharedValid r d) (g : G) :
    Fin J ↪ PhysicalResidueZeroLabels P g r where
  toFun j := ⟨d g j, hd g j⟩
  inj' _ _ h := (d g).injective (congrArg Subtype.val h)

def physicalResidueSharedFiberEquiv {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (r : PhysicalResidues P) (d : PhysicalSharedLists P J)
    (hd : physicalResidueSharedValid r d) :
    PhysicalResidueSharedFiber P J ell r d ≃
      (∀ g, {f : Fin J ⊕ Fin ell ↪ PhysicalResidueZeroLabels P g r //
        ∀ j, f (Sum.inl j) = physicalResidueSharedEmbedding r d hd g j}) where
  toFun L g := ⟨physicalResidueMarksEmbedding P J ell r L.val g, by
    intro j
    apply Subtype.ext
    exact congrArg (fun e : PhysicalSharedLists P J => e g j) L.property⟩
  invFun f := ⟨⟨(fun g => {
    toFun := fun s => ((f g).val s).val
    inj' := by
      intro s t h
      exact (f g).val.injective (Subtype.ext h) }),
    (fun g s => ((f g).val s).property)⟩, by
      funext g
      apply Function.Embedding.ext
      intro j
      exact congrArg Subtype.val ((f g).property j)⟩
  left_inv L := by
    apply Subtype.ext
    apply Subtype.ext
    funext g
    apply Function.Embedding.ext
    intro s
    rfl
  right_inv f := by
    funext g
    apply Subtype.ext
    apply Function.Embedding.ext
    intro s
    apply Subtype.ext
    rfl

theorem physical_residue_shared_fiber_card {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (J ell : ℕ) (r : PhysicalResidues P) (d : PhysicalSharedLists P J) :
    Nat.card (PhysicalResidueSharedFiber P J ell r d) =
      if physicalResidueSharedValid r d then
        ∏ g, (physicalResidueOmega P g r - J).descFactorial ell else 0 := by
  classical
  by_cases hd : physicalResidueSharedValid r d
  · rw [if_pos hd, Nat.card_congr (physicalResidueSharedFiberEquiv r d hd), Nat.card_pi]
    apply Finset.prod_congr rfl
    intro g _
    rw [shared_completion_card, physical_residue_zero_labels_card, Fintype.card_fin,
      Fintype.card_fin]
  · rw [if_neg hd]
    let _ : IsEmpty (PhysicalResidueSharedFiber P J ell r d) :=
      ⟨fun L => hd (physical_shared_fiber_valid r d L)⟩
    exact Nat.card_of_isEmpty

theorem physical_residue_shared_filter_card {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (J ell : ℕ) (r : PhysicalResidues P) (d : PhysicalSharedLists P J) :
    (Finset.univ.filter (fun L : PhysicalMarkLists P J ell =>
      physicalResidueMarksValid r L ∧ physicalSharedPrefix L = d)).card =
      if physicalResidueSharedValid r d then
        ∏ g, (physicalResidueOmega P g r - J).descFactorial ell else 0 := by
  classical
  have h := physical_residue_shared_fiber_card P J ell r d
  rw [Nat.card_congr (Equiv.subtypeSubtypeEquivSubtypeInter
    (physicalResidueMarksValid r) (fun L => physicalSharedPrefix L = d)),
    Nat.card_eq_fintype_card, Fintype.card_subtype] at h
  exact h
end

section
open scoped BigOperators
theorem norm_sum_sq_le_card_energy {X : Type*} (s : Finset X) (f : X → ℂ) :
    ‖∑ x ∈ s, f x‖ ^ 2 ≤ (s.card : ℝ) * ∑ x ∈ s, ‖f x‖ ^ 2 := by
  simpa using complex_row_weighted_cauchy s (fun _ => 1) f (fun _ => 1)
    (fun _ _ => by norm_num)

theorem fiber_conditioning_energy_bound {X Y : Type*} [Fintype X] [Fintype Y]
    [DecidableEq Y] (π : X → Y) (f : X → ℂ) (c : ℝ) {A : ℝ}
    (hcard : ∀ y, c ^ 2 * ((Finset.univ.filter fun x => π x = y).card : ℝ) ≤ A) :
    (∑ y, ‖(c : ℂ) * ∑ x ∈ Finset.univ.filter (fun x => π x = y), f x‖ ^ 2) ≤
      A * ∑ x, ‖f x‖ ^ 2 := by
  classical
  have hsum : (∑ y, ∑ x ∈ Finset.univ.filter (fun x => π x = y), ‖f x‖ ^ 2) =
      ∑ x, ‖f x‖ ^ 2 := by
    simp only [Finset.sum_filter]
    rw [Finset.sum_comm]
    simp
  calc
    _ = ∑ y, c ^ 2 * ‖∑ x ∈ Finset.univ.filter (fun x => π x = y), f x‖ ^ 2 := by
      apply Finset.sum_congr rfl
      intro y _
      rw [norm_mul, mul_pow, Complex.norm_real, Real.norm_eq_abs, sq_abs]
    _ ≤ ∑ y, c ^ 2 * (((Finset.univ.filter fun x => π x = y).card : ℝ) *
        ∑ x ∈ Finset.univ.filter (fun x => π x = y), ‖f x‖ ^ 2) :=
      Finset.sum_le_sum (fun y _ => mul_le_mul_of_nonneg_left
        (norm_sum_sq_le_card_energy _ f) (sq_nonneg c))
    _ ≤ ∑ y, A * ∑ x ∈ Finset.univ.filter (fun x => π x = y), ‖f x‖ ^ 2 := by
      apply Finset.sum_le_sum
      intro y _
      rw [← mul_assoc]
      exact mul_le_mul_of_nonneg_right (hcard y)
        (Finset.sum_nonneg (fun _ _ => sq_nonneg _))
    _ = _ := by rw [← Finset.mul_sum, hsum]

theorem fiber_conditioning_weighted_energy_bound {X Y : Type*} [Fintype X] [Fintype Y]
    [DecidableEq Y] (π : X → Y) (f : X → ℂ) (c : ℝ) {A mass : ℝ}
    (hcard : ∀ y, c ^ 2 * ((Finset.univ.filter fun x => π x = y).card : ℝ) ≤ A * mass) :
    (∑ y, ‖(c : ℂ) * ∑ x ∈ Finset.univ.filter (fun x => π x = y), f x‖ ^ 2) ≤
      A * ∑ x, mass * ‖f x‖ ^ 2 := by
  have h := fiber_conditioning_energy_bound π f c hcard
  simpa only [← Finset.mul_sum, mul_assoc] using h
end

section
open scoped BigOperators
noncomputable def physicalSmallConditioningScale {G : Type*} [Fintype G]
    (V : G → ℝ) (J ell : ℕ) : ℝ :=
  Real.sqrt (physicalStateMass V J ell *
    physicalCompletionMass V (fun _ => (∅ : Finset (Fin J))) ell)

theorem physical_small_conditioning_scale_sq {G : Type*} [Fintype G]
    (V : G → ℝ) (hV : ∀ g, 0 < V g) (J ell : ℕ) :
    physicalSmallConditioningScale V J ell ^ 2 = physicalStateMass V J ell *
      physicalCompletionMass V (fun _ => (∅ : Finset (Fin J))) ell := by
  apply Real.sq_sqrt
  exact mul_nonneg (physical_state_mass_pos V hV J ell).le
    (physical_completion_mass_pos V _ ell hV).le

theorem exists_small_completion_energy_bound {q v : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (ell : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (G : Type) [Fintype G] (J : ℕ)
      (V : G → ℝ), (∀ g, v ≤ V g) → ∀ omega : G → ℕ,
      (∀ g, J + ell ≤ omega g) →
      physicalCompletionMass V (fun _ => (∅ : Finset (Fin J))) ell *
        (∏ g, q ^ (omega g - (J + ell))) *
        (∏ g, ((omega g - J).descFactorial ell : ℝ)) ≤ A ^ Fintype.card G := by
  let A := max 1 (((ell.factorial : ℝ) * (max 1 (1 / v)) ^ ell) /
    (1 - q) ^ (ell + 1))
  refine ⟨A, le_max_left _ _, ?_⟩
  intro G _ J V hV omega homega
  have hf (g : G) : (((omega g - J).descFactorial ell : ℝ) *
      q ^ (omega g - (J + ell))) / (V g) ^ ell ≤ A := by
    have hsub : omega g - J = (omega g - (J + ell)) + ell := by
      have := homega g
      omega
    rw [hsub]
    exact (uniform_damped_descFactorial_bound hq0 hq1 hv (hV g)
      ell (omega g - (J + ell)) ell le_rfl).trans (le_max_right _ _)
  have heq : physicalCompletionMass V (fun _ => (∅ : Finset (Fin J))) ell *
      (∏ g, q ^ (omega g - (J + ell))) *
      (∏ g, ((omega g - J).descFactorial ell : ℝ)) =
      ∏ g, (((omega g - J).descFactorial ell : ℝ) *
        q ^ (omega g - (J + ell))) / (V g) ^ ell := by
    simp only [physicalCompletionMass, Finset.card_empty, add_zero]
    rw [← Finset.prod_mul_distrib, ← Finset.prod_mul_distrib]
    apply Finset.prod_congr rfl
    intro g _
    ring
  rw [heq]
  calc
    _ ≤ ∏ _g : G, A := by
      apply Finset.prod_le_prod₀
      · intro g _
        exact div_nonneg (mul_nonneg (Nat.cast_nonneg _) (pow_nonneg hq0 _))
          (pow_nonneg (hv.trans_le (hV g)).le _)
      · intro g _
        exact hf g
    _ = _ := by simp

theorem small_conditioning_scale_damping_sq {G : Type*} [Fintype G]
    (V : G → ℝ) (hV : ∀ g, 0 < V g) (J ell : ℕ)
    {q : ℝ} (hq : 0 ≤ q) (omega : G → ℕ) :
    (physicalSmallConditioningScale V J ell *
      ∏ g, (Real.sqrt q) ^ (omega g - (J + ell))) ^ 2 =
      physicalStateMass V J ell *
      physicalCompletionMass V (fun _ => (∅ : Finset (Fin J))) ell *
      ∏ g, q ^ (omega g - (J + ell)) := by
  rw [mul_pow, physical_small_conditioning_scale_sq V hV, ← Finset.prod_pow]
  congr 1
  apply Finset.prod_congr rfl
  intro g _
  rw [← pow_mul, Nat.mul_comm, pow_mul, Real.sq_sqrt hq]
end

section
open scoped BigOperators Classical
noncomputable def physicalSmallCondition {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (q : ℝ)
    (r : PhysicalResidues P) (d : PhysicalSharedLists P J)
    (w : PhysicalMarkLists P J ell → ℂ) : ℂ := by
  classical
  exact ((physicalSmallConditioningScale V J ell *
      ∏ g, (Real.sqrt q) ^ (physicalResidueOmega P g r - (J + ell)) : ℝ) : ℂ) *
    ∑ L ∈ (Finset.univ : Finset (PhysicalResidueMarksAt P J ell r)).filter
      (fun L => physicalSharedPrefix L.val = d), w L.val

theorem exists_physical_small_conditioning_energy_bound {q v : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (ell : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (G : Type) [Fintype G] [DecidableEq G]
      (P : G → Finset ℕ) (J : ℕ) (V : G → ℝ), (∀ g, v ≤ V g) →
      ∀ (r : PhysicalResidues P) (w : PhysicalMarkLists P J ell → ℂ),
      (∑ d : PhysicalSharedLists P J, ‖physicalSmallCondition V q r d w‖ ^ 2) ≤
        A ^ Fintype.card G *
          ∑ L : PhysicalResidueMarksAt P J ell r, physicalStateMass V J ell * ‖w L.val‖ ^ 2 := by
  obtain ⟨A, hA, hbound⟩ := exists_small_completion_energy_bound hq0 hq1 hv ell
  refine ⟨A, hA, ?_⟩
  intro G _ _ P J V hV r w
  classical
  have hVpos (g : G) : 0 < V g := hv.trans_le (hV g)
  have hmass : 0 < physicalStateMass V J ell := physical_state_mass_pos V hVpos J ell
  let amp : ℝ := physicalSmallConditioningScale V J ell *
    ∏ g, (Real.sqrt q) ^ (physicalResidueOmega P g r - (J + ell))
  have hcard (d : PhysicalSharedLists P J) : amp ^ 2 *
      ((Finset.univ.filter (fun L : PhysicalResidueMarksAt P J ell r =>
        physicalSharedPrefix L.val = d)).card : ℝ) ≤
      A ^ Fintype.card G * physicalStateMass V J ell := by
    let S := Finset.univ.filter (fun L : PhysicalResidueMarksAt P J ell r =>
      physicalSharedPrefix L.val = d)
    by_cases hS : S.card = 0
    · change amp ^ 2 * (S.card : ℝ) ≤ _
      rw [hS, Nat.cast_zero, mul_zero]
      exact mul_nonneg (pow_nonneg (zero_le_one.trans hA) _) hmass.le
    · obtain ⟨L, hL⟩ := Finset.card_pos.mp (Nat.pos_of_ne_zero hS)
      have hd : physicalResidueSharedValid r d := by
        rw [← (Finset.mem_filter.mp hL).2]
        exact physical_shared_prefix_valid r L
      have hc := physical_residue_shared_fiber_card P J ell r d
      rw [if_pos hd, Nat.card_eq_fintype_card, Fintype.card_subtype] at hc
      have hcreal : ((Finset.univ.filter (fun L : PhysicalResidueMarksAt P J ell r =>
          physicalSharedPrefix L.val = d)).card : ℝ) =
          ∏ g, ((physicalResidueOmega P g r - J).descFactorial ell : ℝ) := by
        exact_mod_cast hc
      have hb := hbound G J V hV (fun g => physicalResidueOmega P g r)
        (physical_residue_slots_le_omega P J ell r L)
      change (physicalSmallConditioningScale V J ell *
        ∏ g, (Real.sqrt q) ^ (physicalResidueOmega P g r - (J + ell))) ^ 2 * _ ≤ _
      rw [small_conditioning_scale_damping_sq V hVpos J ell hq0, hcreal]
      calc
        _ = physicalStateMass V J ell *
            (physicalCompletionMass V (fun _ => (∅ : Finset (Fin J))) ell *
            (∏ g, q ^ (physicalResidueOmega P g r - (J + ell))) *
            (∏ g, ((physicalResidueOmega P g r - J).descFactorial ell : ℝ))) := by ring
        _ ≤ physicalStateMass V J ell * A ^ Fintype.card G :=
          mul_le_mul_of_nonneg_left hb hmass.le
        _ = _ := mul_comm _ _
  exact fiber_conditioning_weighted_energy_bound
    (fun L : PhysicalResidueMarksAt P J ell r => physicalSharedPrefix L.val)
    (fun L => w L.val) amp hcard
end

section
open scoped BigOperators Classical
theorem physical_small_condition_eq_vertex_sum {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (q : ℝ)
    (r : PhysicalResidues P) (d : PhysicalSharedLists P J)
    (w : PhysicalMarkLists P J ell → ℂ) :
    physicalSmallCondition V q r d w = (physicalSmallConditioningScale V J ell : ℂ) *
      ∑ L : PhysicalMarkLists P J ell, if physicalSharedPrefix L = d then
        (physicalResidueVertexWeight L (Real.sqrt q) r : ℂ) * w L else 0 := by
  classical
  let F : PhysicalMarkLists P J ell → ℂ := fun L => if physicalSharedPrefix L = d then
    (physicalResidueVertexWeight L (Real.sqrt q) r : ℂ) * w L else 0
  have he : (∑ L : PhysicalResidueMarksAt P J ell r, F L.val) = ∑ L, F L := by
    apply (Finset.sum_congr_set {L | physicalResidueMarksValid r L} F
      (fun L => F L.val) (fun _ _ => rfl) ?_).symm
    intro L hL
    change ¬ physicalResidueMarksValid r L at hL
    dsimp [F]
    simp only [physicalResidueVertexWeight, if_neg hL, Complex.ofReal_zero, zero_mul,
      ite_self]
  change physicalSmallCondition V q r d w = _ * ∑ L, F L
  rw [← he]
  unfold physicalSmallCondition
  rw [Complex.ofReal_mul, mul_assoc]
  congr 1
  rw [Finset.sum_filter, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro L _
  dsimp [F]
  simp only [physicalResidueVertexWeight, if_pos L.property]
  split_ifs <;> simp

theorem exists_physical_small_conditioning_weighted_energy_bound {q v : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (ell : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (G : Type) [Fintype G] [DecidableEq G]
      (P : G → Finset ℕ) (J : ℕ) (V : G → ℝ), (∀ g, v ≤ V g) →
      ∀ (T : Type) (s : Finset T) (r : T → PhysicalResidues P) (μ : T → ℝ),
      (∀ t ∈ s, 0 ≤ μ t) → ∀ w : T → PhysicalMarkLists P J ell → ℂ,
      (∑ t ∈ s, μ t * ∑ d : PhysicalSharedLists P J,
        ‖physicalSmallCondition V q (r t) d (w t)‖ ^ 2) ≤
      A ^ Fintype.card G * ∑ t ∈ s, μ t *
        ∑ L : PhysicalResidueMarksAt P J ell (r t), physicalStateMass V J ell * ‖w t L.val‖ ^ 2 := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_small_conditioning_energy_bound hq0 hq1 hv ell
  refine ⟨A, hA, ?_⟩
  intro G _ _ P J V hV T s r μ hμ w
  calc
    _ ≤ ∑ t ∈ s, μ t * (A ^ Fintype.card G *
        ∑ L : PhysicalResidueMarksAt P J ell (r t), physicalStateMass V J ell * ‖w t L.val‖ ^ 2) :=
      Finset.sum_le_sum (fun t ht => mul_le_mul_of_nonneg_left
        (hbound G P J V hV (r t) (w t)) (hμ t ht))
    _ = _ := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro t _
      ring
end

section
open Finset
def distinctSurvivorStorageEmbedding {J K P : Type*}
    (f : J ↪ P) (g : K ↪ P) (T : Finset P)
    (hdis : ∀ j k, f j ≠ g k) : {j : J // f j ∉ T} ⊕ K ↪ P where
  toFun := Sum.elim (fun j => f j.val) g
  inj' := by
    intro x y hxy
    cases x with
    | inl j =>
      cases y with
      | inl l => exact congrArg Sum.inl (Subtype.ext (f.injective hxy))
      | inr k => exact (hdis j.val k hxy).elim
    | inr k =>
      cases y with
      | inl j => exact (hdis j.val k hxy.symm).elim
      | inr l => exact congrArg Sum.inr (g.injective hxy)

theorem distinct_survivor_storage_support {J K P : Type*}
    [Fintype J] [Fintype K] [DecidableEq P]
    (f : J ↪ P) (g : K ↪ P) (T : Finset P)
    (hdis : ∀ j k, f j ≠ g k) :
    univ.image (distinctSurvivorStorageEmbedding f g T hdis) =
      (univ.image f \ T) ∪ univ.image g := by
  ext p
  simp only [mem_image, mem_univ, true_and, mem_union, mem_sdiff]
  constructor
  · rintro ⟨x,hx⟩
    cases x with
    | inl j =>
      change f j.val = p at hx
      exact Or.inl ⟨⟨j.val,hx⟩, hx ▸ j.property⟩
    | inr k => exact Or.inr ⟨k,hx⟩
  · rintro (⟨⟨j,hj⟩,hp⟩ | ⟨k,hk⟩)
    · exact ⟨Sum.inl ⟨j,hj.symm ▸ hp⟩,hj⟩
    · exact ⟨Sum.inr k,hk⟩

noncomputable def distinctSurvivorStorageSupport {J K P : Type*}
    [Fintype J] [Fintype K] [DecidableEq P]
    (f : J ↪ P) (g : K ↪ P) (T : Finset P)
    (hdis : ∀ j k, f j ≠ g k) :
    DistinctOrderedSupport ({j : J // f j ∉ T} ⊕ K) ((univ.image f \ T) ∪ univ.image g) :=
  ⟨distinctSurvivorStorageEmbedding f g T hdis, by
    intro p
    rw [← distinct_survivor_storage_support f g T hdis]
    simp⟩

def distinctSurvivorStorageResidue {J K P : Type*}
    (f : J ↪ P) (g : K ↪ P) (T : Finset P)
    (hdis : ∀ j k, f j ≠ g k) (R : P → Type*)
    (transport : (p : P) → R p → R p)
    (old : (j : J) → R (f j)) (stored : (k : K) → R (g k)) :
    (z : {j : J // f j ∉ T} ⊕ K) → R (distinctSurvivorStorageEmbedding f g T hdis z)
  | Sum.inl j => transport (f j.val) (old j.val)
  | Sum.inr k => stored k

/-- The actual deletion-and-append tuple carries old residues through their
transport and assigns precisely the supplied new anchor to stored particles. -/
theorem distinct_survivor_storage_residue_values {J K P : Type*}
    (f : J ↪ P) (g : K ↪ P) (T : Finset P)
    (hdis : ∀ j k, f j ≠ g k) (R : P → Type*)
    (transport : (p : P) → R p → R p)
    (old : (j : J) → R (f j)) (stored : (k : K) → R (g k)) :
    (∀ j : {j : J // f j ∉ T},
      distinctSurvivorStorageResidue f g T hdis R transport old stored (Sum.inl j) =
        transport (f j.val) (old j.val)) ∧
    (∀ k, distinctSurvivorStorageResidue f g T hdis R transport old stored (Sum.inr k) =
      stored k) := ⟨fun _ => rfl,fun _ => rfl⟩

/-- Reading the output tuple in support coordinates preserves every residue,
so an arbitrary coupled continuation is evaluated at the same memory. -/
theorem distinct_survivor_storage_support_residue {J K P : Type*}
    [Fintype J] [Fintype K] [DecidableEq P]
    (f : J ↪ P) (g : K ↪ P) (T : Finset P)
    (hdis : ∀ j k, f j ≠ g k) (R : P → Type*)
    (transport : (p : P) → R p → R p)
    (old : (j : J) → R (f j)) (stored : (k : K) → R (g k))
    (z : {j : J // f j ∉ T} ⊕ K) :
    let e := distinctOrderedSupportAsEquiv (distinctSurvivorStorageSupport f g T hdis)
    let r := distinctSurvivorStorageResidue f g T hdis R transport old stored
    Equiv.piCongrLeft
      (fun p : ↥((((univ : Finset J).image f) \ T) ∪ (univ : Finset K).image g) => R p.val)
      e r (e z) = r z := by
  exact Equiv.piCongrLeft_apply_apply _ _ _ _
end

section
open Finset
noncomputable def ghostPhasePendingSupport {I : Type*} [Fintype I] {R : I → Type*}
    (w : (i : I) → GhostPhaseState (R i)) : Finset I := by
  classical
  exact univ.filter (fun i => ∃ r, w i = some (some (some r)))

noncomputable def ghostPhaseActivitySupport {I : Type*} [Fintype I]
    (a : I → Bool) : Finset I := univ.filter (fun i => a i = true)

noncomputable def ghostPhaseChoiceSupport {I : Type*} [Fintype I]
    (c : I → Bool) : Finset I := univ.filter (fun i => c i = true)

noncomputable def ghostPhaseFreshSupport {I : Type*} [Fintype I] {R : I → Type*}
    (atgt : I → Bool) (w : (i : I) → GhostPhaseState (R i)) : Finset I := by
  classical
  exact univ.filter (fun i => atgt i = true ∧ w i = some none)

noncomputable def ghostPhasePromotedSupport {I : Type*} [Fintype I] {R : I → Type*}
    (w z : (i : I) → GhostPhaseState (R i)) : Finset I := by
  classical
  exact univ.filter (fun i => (∃ r, w i = some (some (some r))) ∧ z i = none)

def ghostPhaseEdgeChoiceOutput {I : Type*} {R : I → Type*}
    (atgt asrc : I → Bool) (hsrc : (i : I) → R i)
    (w : (i : I) → GhostPhaseState (R i)) (c : I → Bool) :
    (i : I) → GhostPhaseState (R i) :=
  fun i => if c i then ghostPhaseEdgeStoreTarget (hsrc i)
    else ghostPhaseEdgeBaseTarget (atgt i) (asrc i) (w i)

/-- Local support update for an allowed storage choice. -/
theorem ghost_phase_edge_choice_pending_iff {R : Type*}
    (atgt asrc c : Bool) (hsrc : R) (w : GhostPhaseState R)
    (hw : w.isSome = !asrc) (hc : c = true → atgt = false ∧ asrc = true) :
    (∃ r, (if c then ghostPhaseEdgeStoreTarget hsrc else ghostPhaseEdgeBaseTarget atgt asrc w) =
      some (some (some r))) ↔
      ((∃ r, w = some (some (some r))) ∧ atgt = false) ∨ c = true := by
  cases atgt <;> cases asrc <;> cases c <;> rcases w with _ | (_ | (_ | r)) <;>
    simp_all [ghostPhaseEdgeStoreTarget, ghostPhaseEdgeBaseTarget]

/-- Every stored coordinate was source-active and hence was not old pending memory. -/
theorem ghost_phase_storage_disjoint_pending {I : Type*} [Fintype I]
    {R : I → Type*} (atgt asrc c : I → Bool) (w : (i : I) → GhostPhaseState (R i))
    (hw : ghostPhaseMask asrc w)
    (hc : ∀ i, c i = true → atgt i = false ∧ asrc i = true) :
    Disjoint (ghostPhasePendingSupport w) (ghostPhaseChoiceSupport c) := by
  classical
  apply disjoint_left.mpr
  intro i hi hs
  simp only [ghostPhasePendingSupport, ghostPhaseChoiceSupport,
    mem_filter, mem_univ, true_and] at hi hs
  obtain ⟨r, hr⟩ := hi
  have hw' := hw i
  rw [hr, (hc i hs).2] at hw'
  simp at hw'

/-- Storage labels form a subset of source-active but target-inactive labels. -/
theorem ghost_phase_storage_subset {I : Type*} [Fintype I] [DecidableEq I]
    (atgt asrc c : I → Bool)
    (hc : ∀ i, c i = true → atgt i = false ∧ asrc i = true) :
    ghostPhaseChoiceSupport c ⊆ ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt := by
  intro i hi
  simp only [ghostPhaseChoiceSupport, mem_filter, mem_univ, true_and] at hi
  have hs := hc i hi
  simp [ghostPhaseActivitySupport, hs.1, hs.2]

/-- The exact pending support after the chosen edge: delete promoted labels,
then append precisely the stored source-active labels. -/
theorem ghost_phase_edge_choice_support {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} (atgt asrc c : I → Bool) (hsrc : (i : I) → R i)
    (w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask asrc w)
    (hc : ∀ i, c i = true → atgt i = false ∧ asrc i = true) :
    ghostPhasePendingSupport (ghostPhaseEdgeChoiceOutput atgt asrc hsrc w c) =
      (ghostPhasePendingSupport w \ ghostPhaseActivitySupport atgt) ∪
        ghostPhaseChoiceSupport c := by
  classical
  ext i
  simp only [mem_union, mem_sdiff]
  simp only [ghostPhasePendingSupport, ghostPhaseActivitySupport, ghostPhaseChoiceSupport,
    mem_filter, mem_univ, true_and]
  change (∃ r, (if c i then ghostPhaseEdgeStoreTarget (hsrc i)
    else ghostPhaseEdgeBaseTarget (atgt i) (asrc i) (w i)) = some (some (some r))) ↔ _
  rw [ghost_phase_edge_choice_pending_iff (atgt i) (asrc i) (c i) (hsrc i) (w i) (hw i) (hc i)]
  cases atgt i <;> simp

/-- Stored residues are exactly the source hits. -/
theorem ghost_phase_edge_choice_stored {I : Type*} {R : I → Type*}
    (atgt asrc c : I → Bool) (hsrc : (i : I) → R i)
    (w : (i : I) → GhostPhaseState (R i)) (i : I) (hc : c i = true) :
    ghostPhaseEdgeChoiceOutput atgt asrc hsrc w c i = some (some (some (hsrc i))) := by
  simp [ghostPhaseEdgeChoiceOutput, hc, ghostPhaseEdgeStoreTarget]

/-- Surviving old pending residues are retained exactly, with no relabeling. -/
theorem ghost_phase_edge_choice_survivor {I : Type*} {R : I → Type*}
    (atgt asrc c : I → Bool) (hsrc : (i : I) → R i)
    (w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask asrc w)
    (hc : ∀ i, c i = true → atgt i = false ∧ asrc i = true)
    (i : I) (r : R i) (hr : w i = some (some (some r))) (ht : atgt i = false) :
    ghostPhaseEdgeChoiceOutput atgt asrc hsrc w c i = some (some (some r)) := by
  have hs : asrc i = false := by
    have hi := hw i
    rw [hr] at hi
    cases ha : asrc i <;> simp_all
  have hci : c i = false := by
    cases hi : c i
    · rfl
    · have := (hc i hi).2
      simp_all
  simp [ghostPhaseEdgeChoiceOutput, hci, ht, hs, hr, ghostPhaseEdgeBaseTarget]

/-- Target-active coordinates carry the active phase, not pending memory. -/
theorem ghost_phase_edge_choice_active {I : Type*} {R : I → Type*}
    (atgt asrc c : I → Bool) (hsrc : (i : I) → R i)
    (w : (i : I) → GhostPhaseState (R i))
    (hc : ∀ i, c i = true → atgt i = false ∧ asrc i = true)
    (i : I) (ht : atgt i = true) :
    ghostPhaseEdgeChoiceOutput atgt asrc hsrc w c i = none := by
  have hci : c i = false := by
    cases hi : c i
    · rfl
    · have := (hc i hi).1
      simp_all
  simp [ghostPhaseEdgeChoiceOutput, hci, ht, ghostPhaseEdgeBaseTarget]

/-- A pending particle promoted by a nonzero edge must hit the target residue. -/
theorem ghost_phase_edge_promoted_hit {R : Type*} [Fintype R] [DecidableEq R]
    (asrc : Bool) (htgt hsrc r : R) (β ρtgt ρsrc : ℝ) (z : GhostPhaseState R)
    (hn : ghostPhaseDampedEdge true asrc htgt hsrc β ρtgt ρsrc z
      (some (some (some r))) ≠ 0) : asrc = false ∧ z = none ∧ r = htgt := by
  cases asrc <;> rcases z with _ | (_ | (_ | s)) <;>
    simp_all [ghostPhaseDampedEdge, ghostPhaseEdge, ghostPhaseGather, ghostPhaseScatter,
      ghostActiveInput, ghostPhaseDiagonal]
  split_ifs at hn <;> simp_all

/-- A target-only active label absent from old pending memory must start from U;
completed memory cannot be used for a fresh active birth. -/
theorem ghost_phase_edge_fresh_unborn {R : Type*} [Fintype R] [DecidableEq R]
    (htgt hsrc : R) (β ρtgt ρsrc : ℝ) (z w : GhostPhaseState R)
    (hn : ghostPhaseDampedEdge true false htgt hsrc β ρtgt ρsrc z w ≠ 0)
    (hw : ¬ ∃ r, w = some (some (some r))) : w = some none ∧ z = none ∧ β ≠ 0 := by
  rcases z with _ | (_ | (_ | r)) <;> rcases w with _ | (_ | (_ | s)) <;>
    simp_all [ghostPhaseDampedEdge, ghostPhaseEdge, ghostPhaseGather, ghostPhaseScatter,
      ghostActiveInput, ghostPhaseDiagonal]

/-- Nonzero tensor choice weights automatically meet the storage-side conditions
needed for the exact support update. -/
theorem ghost_phase_nonzero_choice_support {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, DecidableEq (R i)]
    (atgt asrc c : I → Bool) (htgt hsrc : (i : I) → R i) (β ρtgt ρsrc : I → ℝ)
    (w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask asrc w)
    (hn : (∏ i, if c i then ghostPhaseEdgeStoreWeight (atgt i) (asrc i) (htgt i) (hsrc i)
        (ρtgt i) (w i) else ghostPhaseEdgeBaseWeight (atgt i) (asrc i) (htgt i) (hsrc i)
        (β i) (ρtgt i) (ρsrc i) (w i)) ≠ 0) :
    ghostPhasePendingSupport (ghostPhaseEdgeChoiceOutput atgt asrc hsrc w c) =
      (ghostPhasePendingSupport w \ ghostPhaseActivitySupport atgt) ∪
        ghostPhaseChoiceSupport c := by
  apply ghost_phase_edge_choice_support atgt asrc c hsrc w hw
  intro i hi
  have hc := ghost_phase_tensor_storage_supported atgt asrc htgt hsrc β ρtgt ρsrc w c hn i hi
  exact ⟨hc.1, hc.2.1⟩

/-- Actual pending-to-active transitions select exactly the intersection of
old pending labels with target-active labels. -/
theorem ghost_phase_promoted_support_eq {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (atgt asrc : I → Bool) (htgt hsrc : (i : I) → R i) (β ρtgt ρsrc : I → ℝ)
    (z w : (i : I) → GhostPhaseState (R i))
    (hn : (∏ i, ghostPhaseDampedEdge (atgt i) (asrc i) (htgt i) (hsrc i)
      (β i) (ρtgt i) (ρsrc i) (z i) (w i)) ≠ 0) :
    ghostPhasePromotedSupport w z = ghostPhasePendingSupport w ∩ ghostPhaseActivitySupport atgt := by
  classical
  ext i
  simp only [ghostPhasePromotedSupport, ghostPhasePendingSupport, ghostPhaseActivitySupport,
    mem_inter, mem_filter, mem_univ, true_and]
  have hi := (prod_ne_zero_iff.mp hn) i (mem_univ i)
  constructor
  · rintro ⟨hP, hz⟩
    refine ⟨hP, ?_⟩
    cases ht : atgt i
    · simp [ht, hz, ghostPhaseDampedEdge, ghostPhaseEdge, ghostPhaseGather] at hi
    · rfl
  · rintro ⟨⟨r, hr⟩, ht⟩
    rw [ht, hr] at hi
    exact ⟨⟨r, hr⟩, (ghost_phase_edge_promoted_hit _ _ _ _ _ _ _ _ hi).2.1⟩

/-- On a nonzero physical tensor edge, fresh labels are exactly the target-active
labels absent from both the source-active set and the old pending support. -/
theorem ghost_phase_fresh_support_eq {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (atgt asrc : I → Bool) (htgt hsrc : (i : I) → R i) (β ρtgt ρsrc : I → ℝ)
    (z w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask asrc w)
    (hn : (∏ i, ghostPhaseDampedEdge (atgt i) (asrc i) (htgt i) (hsrc i)
      (β i) (ρtgt i) (ρsrc i) (z i) (w i)) ≠ 0) :
    ghostPhaseFreshSupport atgt w =
      (ghostPhaseActivitySupport atgt \ ghostPhaseActivitySupport asrc) \ ghostPhasePendingSupport w := by
  classical
  ext i
  simp only [ghostPhaseFreshSupport, ghostPhaseActivitySupport, ghostPhasePendingSupport,
    mem_sdiff, mem_filter, mem_univ, true_and]
  constructor
  · rintro ⟨ht, hU⟩
    have hi := hw i
    rw [hU] at hi
    refine ⟨⟨ht, ?_⟩, ?_⟩
    · cases hs : asrc i <;> simp_all
    · simp [hU]
  · rintro ⟨⟨ht, hs⟩, hP⟩
    have hs' : asrc i = false := by cases hi : asrc i <;> simp_all
    have hi := (prod_ne_zero_iff.mp hn) i (mem_univ i)
    rw [ht, hs'] at hi
    exact ⟨ht, (ghost_phase_edge_fresh_unborn _ _ _ _ _ _ _ hi hP).1⟩
end

section
open Finset
/-- The selected target: transport retained memory, drop an outgoing active
lifespan by default, or store it at target residue `-delta`. -/
noncomputable def ghostPhaseMovingChoiceTarget {R : Type*} [AddGroup R]
    (atgt asrc : Bool) (delta : R) (store : Bool) (w : GhostPhaseState R) :
    GhostPhaseState R :=
  if store then ghostPhaseEdgeStoreTarget (-delta)
  else ghostPhaseEdgeBaseTarget atgt asrc (ghostPhaseShift delta w)

/-- A fresh active lifespan begins exactly at an unborn inactive coordinate. -/
def ghostPhaseEdgeFresh {R : Type*} [DecidableEq R]
    (atgt asrc : Bool) (w : GhostPhaseState R) : Bool :=
  atgt && !asrc && decide (w = some none)

/-- Shared active coordinates require zero displacement; promotions require
the old pending residue to equal the displacement. Completed lifespans cannot
be promoted. Other supported transitions impose no further hit condition. -/
def ghostPhaseMovingEdgeCompatible {R : Type*} [AddGroup R] [DecidableEq R]
    (atgt asrc : Bool) (delta : R) (w : GhostPhaseState R) : Bool :=
  match atgt, asrc, w with
  | true, true, _ => decide (delta = 0)
  | true, false, some none => true
  | true, false, some (some (some r)) => decide (r = delta)
  | true, false, _ => false
  | false, _, _ => true

/-- The compatibility bit expresses precisely shared-hit agreement and the
fresh-or-promoted alternative for every newly active coordinate. -/
theorem ghost_phase_moving_edge_compatible_iff {R : Type*}
    [AddGroup R] [DecidableEq R] (atgt asrc : Bool) (delta : R)
    (w : GhostPhaseState R) (hw : w.isSome = !asrc) :
    ghostPhaseMovingEdgeCompatible atgt asrc delta w = true ↔
      (atgt = true ∧ asrc = true → delta = 0) ∧
        (atgt = true ∧ asrc = false →
          w = some none ∨ w = some (some (some delta))) := by
  cases atgt <;> cases asrc <;> rcases w with _ | (_ | (_ | r)) <;>
    simp_all [ghostPhaseMovingEdgeCompatible]

/-- The actual undamped coefficient at the selected target. Storage may be
chosen only on a source-active, target-inactive coordinate. -/
theorem ghost_phase_moving_choice_coefficient {R : Type*}
    [AddGroup R] [Fintype R] [DecidableEq R]
    (atgt asrc store : Bool) (delta : R) (β : ℝ) (w : GhostPhaseState R)
    (hw : w.isSome = !asrc) (hs : store = true → atgt = false ∧ asrc = true) :
    ghostPhaseMovingEdge atgt asrc delta β
        (ghostPhaseMovingChoiceTarget atgt asrc delta store w) w =
      (if ghostPhaseEdgeFresh atgt asrc w then β else 1) *
        (if ghostPhaseMovingEdgeCompatible atgt asrc delta w then 1 else 0) := by
  cases atgt <;> cases asrc <;> cases store <;>
    rcases w with _ | (_ | (_ | r)) <;>
      simp_all [ghostPhaseMovingChoiceTarget, ghostPhaseEdgeBaseTarget,
        ghostPhaseEdgeStoreTarget, ghostPhaseEdgeFresh, ghostPhaseMovingEdgeCompatible,
        ghostPhaseShift, ghostMemoryShift,
        ghost_phase_moving_edge_active_active, ghost_phase_moving_edge_inactive_active,
        ghost_phase_moving_edge_active_inactive, ghost_phase_moving_edge_inactive_inactive]

/-- Diagonal damping detects exactly pending residue zero. -/
theorem ghost_phase_diagonal_eq_zero_indicator {R : Type*} [Zero R] [DecidableEq R]
    (ρ : ℝ) (w : GhostPhaseState R) :
    ghostPhaseDiagonal 0 ρ w =
      if w = some (some (some 0)) then ρ else 1 := by
  rcases w with _ | (_ | (_ | r)) <;> simp [ghostPhaseDiagonal]

/-- The selected actual damped edge coefficient splits into both endpoint
diagonals, a fresh beta factor, and the explicit compatibility indicator. -/
theorem ghost_phase_damped_moving_choice_coefficient {R : Type*}
    [AddGroup R] [Fintype R] [DecidableEq R]
    (atgt asrc store : Bool) (delta : R) (β ρtgt ρsrc : ℝ) (w : GhostPhaseState R)
    (hw : w.isSome = !asrc) (hs : store = true → atgt = false ∧ asrc = true) :
    ghostPhaseDampedMovingEdge atgt asrc delta β ρtgt ρsrc
        (ghostPhaseMovingChoiceTarget atgt asrc delta store w) w =
      (if w = some (some (some 0)) then ρsrc else 1) *
        (if ghostPhaseMovingChoiceTarget atgt asrc delta store w = some (some (some 0))
          then ρtgt else 1) *
        (if ghostPhaseEdgeFresh atgt asrc w then β else 1) *
        (if ghostPhaseMovingEdgeCompatible atgt asrc delta w then 1 else 0) := by
  rw [ghostPhaseDampedMovingEdge,
    ghost_phase_moving_choice_coefficient atgt asrc store delta β w hw hs]
  simp only [ghost_phase_diagonal_eq_zero_indicator]
  ring

/-- Pending-zero coordinates of a finite phase configuration. -/
noncomputable def ghostPhaseZeroSet {I : Type*} [Fintype I] {R : I → Type*}
    [∀ i, Zero (R i)] [∀ i, DecidableEq (R i)]
    (w : (i : I) → GhostPhaseState (R i)) : Finset I :=
  univ.filter (fun i => w i = some (some (some 0)))

noncomputable def ghostPhaseFreshSet {I : Type*} [Fintype I] {R : I → Type*}
    [∀ i, DecidableEq (R i)] (atgt asrc : I → Bool)
    (w : (i : I) → GhostPhaseState (R i)) : Finset I :=
  univ.filter (fun i => ghostPhaseEdgeFresh (atgt i) (asrc i) (w i))

/-- Source-inactive coordinates entering the target active label. -/
noncomputable def ghostPhaseNewRunSet {I : Type*} [Fintype I]
    (atgt asrc : I → Bool) : Finset I :=
  univ.filter (fun i => atgt i && !(asrc i))

/-- Exact finite coefficient of one supported moving-frame edge choice.
The zero counts include promoted old particles at the source and newly stored
particles at the target. The indicator keeps all shared-hit and promotion
conditions, so zero-weight choices remain represented. -/
theorem ghost_phase_moving_edge_choice_product {I : Type*} [Fintype I]
    {R : I → Type*} [∀ i, AddGroup (R i)] [∀ i, Fintype (R i)]
    [∀ i, DecidableEq (R i)]
    (atgt asrc store : I → Bool) (delta : (i : I) → R i) (β : I → ℝ)
    (ρtgt ρsrc : ℝ) (w : (i : I) → GhostPhaseState (R i))
    (hw : ∀ i, (w i).isSome = !(asrc i))
    (hs : ∀ i, store i = true → atgt i = false ∧ asrc i = true) :
    (∏ i, ghostPhaseDampedMovingEdge (atgt i) (asrc i) (delta i) (β i) ρtgt ρsrc
      (ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i) (store i) (w i)) (w i)) =
      ρsrc ^ (ghostPhaseZeroSet w).card *
        ρtgt ^ (ghostPhaseZeroSet (fun i =>
          ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i) (store i) (w i))).card *
        (∏ i ∈ ghostPhaseFreshSet atgt asrc w, β i) *
        (if ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true
          then 1 else 0) := by
  classical
  have hc : (∏ i, if ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i)
      then (1 : ℝ) else 0) =
      if ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true
        then 1 else 0 := by
    by_cases h : ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true
    · simp [h]
    · rw [if_neg h]
      push Not at h
      obtain ⟨i, hi⟩ := h
      exact prod_eq_zero (mem_univ i) (if_neg hi)
  have hd (v : (i : I) → GhostPhaseState (R i)) (ρ : ℝ) :
      (∏ i, if v i = some (some (some 0)) then ρ else 1) =
        ρ ^ (ghostPhaseZeroSet v).card := by
    unfold ghostPhaseZeroSet
    rw [← prod_filter, prod_const]
  simp_rw [ghost_phase_damped_moving_choice_coefficient _ _ _ _ _ _ _ _ (hw _) (hs _)]
  simp only [prod_mul_distrib, hc]
  rw [hd w ρsrc, hd (fun i =>
    ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i) (store i) (w i)) ρtgt]
  rw [ghostPhaseFreshSet, prod_filter]

/-- If each new active run is explicitly normalized by `V⁻¹`, the same actual
edge coefficient acquires exactly one such factor per entering active index. -/
theorem ghost_phase_run_normalized_edge_choice_product {I : Type*} [Fintype I]
    {R : I → Type*} [∀ i, AddGroup (R i)] [∀ i, Fintype (R i)]
    [∀ i, DecidableEq (R i)]
    (atgt asrc store : I → Bool) (delta : (i : I) → R i) (β : I → ℝ)
    (ρtgt ρsrc V : ℝ) (w : (i : I) → GhostPhaseState (R i))
    (hw : ∀ i, (w i).isSome = !(asrc i))
    (hs : ∀ i, store i = true → atgt i = false ∧ asrc i = true) :
    (∏ i, (if atgt i && !(asrc i) then V⁻¹ else 1) *
      ghostPhaseDampedMovingEdge (atgt i) (asrc i) (delta i) (β i) ρtgt ρsrc
        (ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i) (store i) (w i)) (w i)) =
      ρsrc ^ (ghostPhaseZeroSet w).card *
        ρtgt ^ (ghostPhaseZeroSet (fun i =>
          ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i) (store i) (w i))).card *
        (∏ i ∈ ghostPhaseFreshSet atgt asrc w, β i) *
        (V⁻¹) ^ (ghostPhaseNewRunSet atgt asrc).card *
        (if ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true
          then 1 else 0) := by
  classical
  rw [prod_mul_distrib,
    ghost_phase_moving_edge_choice_product atgt asrc store delta β ρtgt ρsrc w hw hs]
  have hV : (∏ i, if atgt i && !(asrc i) then V⁻¹ else 1) =
      (V⁻¹) ^ (ghostPhaseNewRunSet atgt asrc).card := by
    rw [ghostPhaseNewRunSet, ← prod_const]
    exact (prod_filter _ _).symm
  rw [hV]
  ring
end

section
open Finset
/-- Translation changes neither active/inactive status nor the U/D flags. -/
theorem ghost_phase_shift_isSome {R : Type*} [AddGroup R] (delta : R)
    (w : GhostPhaseState R) : (ghostPhaseShift delta w).isSome = w.isSome := by
  cases w <;> rfl

theorem ghost_phase_shift_pending_iff {R : Type*} [AddGroup R] (delta : R)
    (w : GhostPhaseState R) :
    (∃ r, ghostPhaseShift delta w = some (some (some r))) ↔
      ∃ r, w = some (some (some r)) := by
  rcases w with _ | (_ | (_ | r)) <;>
    simp [ghostPhaseShift_active, ghostPhaseShift_unborn,
      ghostPhaseShift_completed, ghostPhaseShift_pending]

theorem ghost_phase_shift_unborn_iff {R : Type*} [AddGroup R] (delta : R)
    (w : GhostPhaseState R) :
    ghostPhaseShift delta w = some none ↔ w = some none := by
  rcases w with _ | (_ | (_ | r)) <;>
    simp [ghostPhaseShift_active, ghostPhaseShift_unborn,
      ghostPhaseShift_completed, ghostPhaseShift_pending]

/-- Independent frame shifts preserve the pending support. -/
theorem ghost_phase_pending_support_shift {I : Type*} [Fintype I]
    {R : I → Type*} [∀ i, AddGroup (R i)] (delta : (i : I) → R i)
    (w : (i : I) → GhostPhaseState (R i)) :
    ghostPhasePendingSupport (fun i => ghostPhaseShift (delta i) (w i)) =
      ghostPhasePendingSupport w := by
  classical
  ext i
  simp only [ghostPhasePendingSupport, mem_filter, mem_univ, true_and,
    ghost_phase_shift_pending_iff]

theorem ghost_phase_mask_shift {I : Type*} {R : I → Type*}
    [∀ i, AddGroup (R i)] (a : I → Bool) (delta : (i : I) → R i)
    (w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask a w) :
    ghostPhaseMask a (fun i => ghostPhaseShift (delta i) (w i)) := by
  intro i
  rw [ghost_phase_shift_isSome]
  exact hw i

/-- The moving choice is precisely the fixed-frame choice on translated input,
with the source hit at -delta in the target frame. -/
theorem ghost_phase_moving_choice_output_eq {I : Type*} {R : I → Type*}
    [∀ i, AddGroup (R i)] (atgt asrc store : I → Bool) (delta : (i : I) → R i)
    (w : (i : I) → GhostPhaseState (R i)) :
    (fun i => ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i) (store i) (w i)) =
      ghostPhaseEdgeChoiceOutput atgt asrc (fun i => -delta i)
        (fun i => ghostPhaseShift (delta i) (w i)) store := rfl

/-- Moving coordinates have exactly the same delete-and-store support update. -/
theorem ghost_phase_moving_choice_support {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, AddGroup (R i)]
    (atgt asrc store : I → Bool) (delta : (i : I) → R i)
    (w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask asrc w)
    (hs : ∀ i, store i = true → atgt i = false ∧ asrc i = true) :
    ghostPhasePendingSupport
      (fun i => ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i) (store i) (w i)) =
      (ghostPhasePendingSupport w \ ghostPhaseActivitySupport atgt) ∪
        ghostPhaseChoiceSupport store := by
  rw [ghost_phase_moving_choice_output_eq,
    ghost_phase_edge_choice_support atgt asrc store (fun i => -delta i)
      (fun i => ghostPhaseShift (delta i) (w i)) (ghost_phase_mask_shift asrc delta w hw) hs,
    ghost_phase_pending_support_shift]

/-- A stored outgoing active label has target-frame residue -delta. -/
theorem ghost_phase_moving_choice_stored {R : Type*} [AddGroup R]
    (atgt asrc store : Bool) (delta : R) (w : GhostPhaseState R) (hs : store = true) :
    ghostPhaseMovingChoiceTarget atgt asrc delta store w = some (some (some (-delta))) := by
  simp [ghostPhaseMovingChoiceTarget, hs, ghostPhaseEdgeStoreTarget]

/-- A retained old residue r is translated to r-delta. -/
theorem ghost_phase_moving_choice_survivor {I : Type*} {R : I → Type*}
    [∀ i, AddGroup (R i)] (atgt asrc store : I → Bool) (delta : (i : I) → R i)
    (w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask asrc w)
    (hs : ∀ i, store i = true → atgt i = false ∧ asrc i = true)
    (i : I) (r : R i) (hr : w i = some (some (some r))) (ht : atgt i = false) :
    ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i) (store i) (w i) =
      some (some (some (r - delta i))) := by
  have hshift : ghostPhaseShift (delta i) (w i) = some (some (some (r - delta i))) := by
    rw [hr, ghostPhaseShift_pending]
  exact ghost_phase_edge_choice_survivor atgt asrc store (fun i => -delta i)
    (fun i => ghostPhaseShift (delta i) (w i)) (ghost_phase_mask_shift asrc delta w hw)
    hs i (r - delta i) hshift ht

/-- Target-active labels carry the active phase and no pending residue. -/
theorem ghost_phase_moving_choice_active {I : Type*} {R : I → Type*}
    [∀ i, AddGroup (R i)] (atgt asrc store : I → Bool) (delta : (i : I) → R i)
    (w : (i : I) → GhostPhaseState (R i))
    (hs : ∀ i, store i = true → atgt i = false ∧ asrc i = true)
    (i : I) (ht : atgt i = true) :
    ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i) (store i) (w i) = none :=
  ghost_phase_edge_choice_active atgt asrc store (fun i => -delta i)
    (fun i => ghostPhaseShift (delta i) (w i)) hs i ht

/-- A nonzero promotion checks r=delta in the source frame, equivalently
zero residue after transport to the target frame. -/
theorem ghost_phase_moving_promoted_hit {R : Type*} [AddGroup R]
    [Fintype R] [DecidableEq R] (asrc : Bool) (delta r : R)
    (β ρtgt ρsrc : ℝ) (z : GhostPhaseState R)
    (hn : ghostPhaseDampedMovingEdge true asrc delta β ρtgt ρsrc z
      (some (some (some r))) ≠ 0) : asrc = false ∧ z = none ∧ r = delta := by
  rw [ghost_phase_damped_moving_edge_eq_shifted, ghostPhaseShift_pending] at hn
  have h := ghost_phase_edge_promoted_hit asrc 0 (-delta) (r - delta) β ρtgt ρsrc z hn
  exact ⟨h.1, h.2.1, sub_eq_zero.mp h.2.2⟩

/-- Frame changes do not permit completed memory to masquerade as a fresh birth. -/
theorem ghost_phase_moving_fresh_unborn {R : Type*} [AddGroup R]
    [Fintype R] [DecidableEq R] (delta : R) (β ρtgt ρsrc : ℝ)
    (z w : GhostPhaseState R)
    (hn : ghostPhaseDampedMovingEdge true false delta β ρtgt ρsrc z w ≠ 0)
    (hw : ¬ ∃ r, w = some (some (some r))) : w = some none ∧ z = none ∧ β ≠ 0 := by
  rw [ghost_phase_damped_moving_edge_eq_shifted] at hn
  have hw' : ¬ ∃ r, ghostPhaseShift delta w = some (some (some r)) := by
    simpa only [ghost_phase_shift_pending_iff] using hw
  have h := ghost_phase_edge_fresh_unborn 0 (-delta) β ρtgt ρsrc z (ghostPhaseShift delta w) hn hw'
  exact ⟨(ghost_phase_shift_unborn_iff delta w).1 h.1, h.2⟩
end

section
open Finset
/-- Old pending labels entering the target active set are promotions. -/
noncomputable def ghostPhasePromotionSet {I : Type*} [Fintype I] {R : I → Type*}
    (atgt : I → Bool) (w : (i : I) → GhostPhaseState (R i)) : Finset I := by
  classical
  exact ghostPhasePendingSupport w ∩ ghostPhaseActivitySupport atgt

/-- Promotion and fresh birth are disjoint alternatives regardless of coefficients. -/
theorem ghost_phase_promotion_fresh_disjoint {I : Type*} [Fintype I]
    {R : I → Type*} [∀ i, DecidableEq (R i)] (atgt asrc : I → Bool)
    (w : (i : I) → GhostPhaseState (R i)) :
    Disjoint (ghostPhasePromotionSet atgt w) (ghostPhaseFreshSet atgt asrc w) := by
  classical
  apply disjoint_left.mpr
  intro i hp hf
  simp only [ghostPhasePromotionSet, ghostPhasePendingSupport, ghostPhaseActivitySupport,
    mem_inter, mem_filter, mem_univ, true_and] at hp
  obtain ⟨r, hr⟩ := hp.1
  simp [ghostPhaseFreshSet, ghostPhaseEdgeFresh, hr] at hf

/-- A compatible new active run is exactly one old-pending promotion or one
fresh unborn label. Completed labels cannot enter this partition. -/
theorem ghost_phase_new_run_partition {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, AddGroup (R i)] [∀ i, DecidableEq (R i)]
    (atgt asrc : I → Bool) (delta : (i : I) → R i)
    (w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask asrc w)
    (hcompat : ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true) :
    ghostPhaseNewRunSet atgt asrc =
      ghostPhasePromotionSet atgt w ∪ ghostPhaseFreshSet atgt asrc w := by
  classical
  ext i
  have hwi := hw i
  have hci := hcompat i
  cases ht : atgt i <;> cases hs : asrc i <;> rcases he : w i with _ | (_ | (_ | r)) <;>
    simp_all [ghostPhaseNewRunSet, ghostPhasePromotionSet, ghostPhasePendingSupport,
      ghostPhaseActivitySupport, ghostPhaseFreshSet, ghostPhaseEdgeFresh,
      ghostPhaseMovingEdgeCompatible]

/-- The entering-run count splits into promotion count plus fresh count. -/
theorem ghost_phase_new_run_card {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, AddGroup (R i)] [∀ i, DecidableEq (R i)]
    (atgt asrc : I → Bool) (delta : (i : I) → R i)
    (w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask asrc w)
    (hcompat : ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true) :
    (ghostPhaseNewRunSet atgt asrc).card =
      (ghostPhasePromotionSet atgt w).card + (ghostPhaseFreshSet atgt asrc w).card := by
  rw [ghost_phase_new_run_partition atgt asrc delta w hw hcompat,
    card_union_of_disjoint (ghost_phase_promotion_fresh_disjoint atgt asrc w)]

/-- A product of fresh-label masses beta/V pays one inverse V per fresh label. -/
theorem ghost_phase_fresh_measure_product {I : Type*} [Fintype I]
    {R : I → Type*} [∀ i, DecidableEq (R i)] (atgt asrc : I → Bool)
    (w : (i : I) → GhostPhaseState (R i)) (β : I → ℝ) (V : ℝ) :
    (∏ i ∈ ghostPhaseFreshSet atgt asrc w, β i / V) =
      (∏ i ∈ ghostPhaseFreshSet atgt asrc w, β i) *
        (V⁻¹) ^ (ghostPhaseFreshSet atgt asrc w).card := by
  simp only [div_eq_mul_inv, prod_mul_distrib, prod_const]

/-- Exact normalization split, including the zero indicator on incompatible
choices. There is no additional inverse V for fresh labels after beta/V. -/
theorem ghost_phase_new_run_measure_split {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, AddGroup (R i)] [∀ i, DecidableEq (R i)]
    (atgt asrc : I → Bool) (delta : (i : I) → R i) (β : I → ℝ) (V : ℝ)
    (w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask asrc w) :
    (∏ i ∈ ghostPhaseFreshSet atgt asrc w, β i) *
        (V⁻¹) ^ (ghostPhaseNewRunSet atgt asrc).card *
        (if ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true
          then 1 else 0) =
      (V⁻¹) ^ (ghostPhasePromotionSet atgt w).card *
        (∏ i ∈ ghostPhaseFreshSet atgt asrc w, β i / V) *
        (if ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true
          then 1 else 0) := by
  classical
  by_cases hc : ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true
  · rw [if_pos hc, ghost_phase_new_run_card atgt asrc delta w hw hc,
      ghost_phase_fresh_measure_product, pow_add]
    ring
  · simp only [if_neg hc, mul_zero]

/-- The actual edge with explicit all-new-run normalization has only a
promotion-count inverse power after fresh beta/V measures are extracted.
Both endpoint rho factors and the full compatibility indicator are retained. -/
theorem ghost_phase_run_normalized_edge_fresh_measure {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, AddGroup (R i)] [∀ i, Fintype (R i)]
    [∀ i, DecidableEq (R i)]
    (atgt asrc store : I → Bool) (delta : (i : I) → R i) (β : I → ℝ)
    (ρtgt ρsrc V : ℝ) (w : (i : I) → GhostPhaseState (R i))
    (hw : ghostPhaseMask asrc w)
    (hs : ∀ i, store i = true → atgt i = false ∧ asrc i = true) :
    (∏ i, (if atgt i && !(asrc i) then V⁻¹ else 1) *
      ghostPhaseDampedMovingEdge (atgt i) (asrc i) (delta i) (β i) ρtgt ρsrc
        (ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i) (store i) (w i)) (w i)) =
      ρsrc ^ (ghostPhaseZeroSet w).card *
        ρtgt ^ (ghostPhaseZeroSet (fun i =>
          ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i) (store i) (w i))).card *
        (V⁻¹) ^ (ghostPhasePromotionSet atgt w).card *
        (∏ i ∈ ghostPhaseFreshSet atgt asrc w, β i / V) *
        (if ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true
          then 1 else 0) := by
  rw [ghost_phase_run_normalized_edge_choice_product atgt asrc store delta β ρtgt ρsrc V w hw hs]
  have he := ghost_phase_new_run_measure_split atgt asrc delta β V w hw
  calc
    _ = (ρsrc ^ (ghostPhaseZeroSet w).card *
        ρtgt ^ (ghostPhaseZeroSet (fun i =>
          ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i) (store i) (w i))).card) *
        ((∏ i ∈ ghostPhaseFreshSet atgt asrc w, β i) *
          (V⁻¹) ^ (ghostPhaseNewRunSet atgt asrc).card *
          (if ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true
            then 1 else 0)) := by ring
    _ = _ := by rw [he]; ring
end

section
open Finset
/-- An injective labeling reindexes subsets without multiplicity. -/
theorem distinct_slot_subset_sum {J P : Type*} [Fintype J]
    [DecidableEq J] [DecidableEq P] (g : J ↪ P) (F : Finset P → ℝ) :
    (∑ B ∈ (univ.image g).powerset, F B) =
      ∑ S ∈ (univ : Finset J).powerset, F (S.image g) := by
  rw [powerset_image, sum_image]
  intro S _ T _ h
  exact image_injective g.injective h

/-- Only labels leaving the active set have a storage alternative. -/
theorem ghost_phase_tensor_edge_storage_subsets {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (atgt asrc : I → Bool) (htgt hsrc : (i : I) → R i) (β ρtgt ρsrc : I → ℝ)
    (w : (i : I) → GhostPhaseState (R i))
    (F : ((i : I) → GhostPhaseState (R i)) → ℝ) :
    (∑ z, (∏ i, ghostPhaseDampedEdge (atgt i) (asrc i) (htgt i) (hsrc i)
      (β i) (ρtgt i) (ρsrc i) (z i) (w i)) * F z) =
      ∑ B ∈ (ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt).powerset,
        (∏ i, if i ∈ B then ghostPhaseEdgeStoreWeight (atgt i) (asrc i) (htgt i)
            (hsrc i) (ρtgt i) (w i)
          else ghostPhaseEdgeBaseWeight (atgt i) (asrc i) (htgt i) (hsrc i)
            (β i) (ρtgt i) (ρsrc i) (w i)) *
        F (ghostPhaseEdgeChoiceOutput atgt asrc hsrc w (fun i => decide (i ∈ B))) := by
  rw [ghost_phase_tensor_edge_action_expansion]
  unfold ghostPhaseEdgeChoiceOutput
  have hz : ∀ i, i ∉ ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt →
      ghostPhaseEdgeStoreWeight (atgt i) (asrc i) (htgt i) (hsrc i) (ρtgt i) (w i) = 0 := by
    intro i hi
    by_contra hn
    obtain ⟨ht, hs, _⟩ := ghost_phase_edge_store_supported _ _ _ _ _ _ hn
    apply hi
    simp [ghostPhaseActivitySupport, hs, ht]
  simpa only [ghostPhaseEdgeChoiceOutput, decide_eq_true_eq] using
    ghost_choice_sum_subsets
      (fun i => ghostPhaseEdgeBaseTarget (atgt i) (asrc i) (w i))
      (fun i => ghostPhaseEdgeStoreTarget (hsrc i))
      (fun i => ghostPhaseEdgeBaseWeight (atgt i) (asrc i) (htgt i) (hsrc i)
        (β i) (ρtgt i) (ρsrc i) (w i))
      (fun i => ghostPhaseEdgeStoreWeight (atgt i) (asrc i) (htgt i) (hsrc i) (ρtgt i) (w i))
      (ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt) hz F

/-- A supported selected outcome has exactly its binary-expansion coefficient. -/
theorem ghost_phase_edge_selected_weight {R : Type*} [Fintype R] [DecidableEq R]
    (atgt asrc store : Bool) (htgt hsrc : R) (β ρtgt ρsrc : ℝ)
    (w : GhostPhaseState R) (hw : w.isSome = !asrc)
    (hs : store = true → atgt = false ∧ asrc = true) :
    ghostPhaseDampedEdge atgt asrc htgt hsrc β ρtgt ρsrc
      (if store then ghostPhaseEdgeStoreTarget hsrc else ghostPhaseEdgeBaseTarget atgt asrc w) w =
      if store then ghostPhaseEdgeStoreWeight atgt asrc htgt hsrc ρtgt w
        else ghostPhaseEdgeBaseWeight atgt asrc htgt hsrc β ρtgt ρsrc w := by
  rw [ghost_phase_damped_edge_sparse]
  cases atgt <;> cases asrc <;> cases store <;>
    rcases w with _ | (_ | (_ | r)) <;>
    simp_all [ghostPhaseEdgeBaseTarget, ghostPhaseEdgeStoreTarget,
      ghostPhaseEdgeStoreWeight, ghostPhaseEdgeBaseWeight]

/-- The full edge action is the sum of its actual coefficients at the distinct
storage outputs, including compatible choices whose coefficient vanishes. -/
theorem ghost_phase_tensor_edge_storage_actual {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (atgt asrc : I → Bool) (htgt hsrc : (i : I) → R i) (β ρtgt ρsrc : I → ℝ)
    (w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask asrc w)
    (F : ((i : I) → GhostPhaseState (R i)) → ℝ) :
    (∑ z, (∏ i, ghostPhaseDampedEdge (atgt i) (asrc i) (htgt i) (hsrc i)
      (β i) (ρtgt i) (ρsrc i) (z i) (w i)) * F z) =
      ∑ B ∈ (ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt).powerset,
        let z := ghostPhaseEdgeChoiceOutput atgt asrc hsrc w (fun i => decide (i ∈ B))
        (∏ i, ghostPhaseDampedEdge (atgt i) (asrc i) (htgt i) (hsrc i)
          (β i) (ρtgt i) (ρsrc i) (z i) (w i)) * F z := by
  rw [ghost_phase_tensor_edge_storage_subsets]
  apply sum_congr rfl
  intro B hB
  apply congrArg (fun t => t * F (ghostPhaseEdgeChoiceOutput atgt asrc hsrc w
    (fun i => decide (i ∈ B))))
  apply prod_congr rfl
  intro i _
  have hs : decide (i ∈ B) = true → atgt i = false ∧ asrc i = true := by
    intro hi
    have h := mem_powerset.mp hB (of_decide_eq_true hi)
    simpa [ghostPhaseActivitySupport, and_comm] using h
  simpa only [ghostPhaseEdgeChoiceOutput, decide_eq_true_eq] using
    (ghost_phase_edge_selected_weight (atgt i) (asrc i) (decide (i ∈ B))
      (htgt i) (hsrc i) (β i) (ρtgt i) (ρsrc i) (w i) (hw i) hs).symm

/-- Moving-frame storage outputs translate retained residues and store at
minus the displacement; the action still sums once per departing-label subset. -/
theorem ghost_phase_moving_storage_actual {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, AddGroup (R i)] [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (atgt asrc : I → Bool) (delta : (i : I) → R i) (β ρtgt ρsrc : I → ℝ)
    (w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask asrc w)
    (F : ((i : I) → GhostPhaseState (R i)) → ℝ) :
    (∑ z, (∏ i, ghostPhaseDampedMovingEdge (atgt i) (asrc i) (delta i)
      (β i) (ρtgt i) (ρsrc i) (z i) (w i)) * F z) =
      ∑ B ∈ (ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt).powerset,
        let z := fun i => ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i)
          (decide (i ∈ B)) (w i)
        (∏ i, ghostPhaseDampedMovingEdge (atgt i) (asrc i) (delta i)
          (β i) (ρtgt i) (ρsrc i) (z i) (w i)) * F z := by
  simp_rw [ghost_phase_damped_moving_edge_eq_shifted]
  apply ghost_phase_tensor_edge_storage_actual
  intro i
  have h := hw i
  rcases hwi : w i with _ | (_ | (_ | r)) <;>
    simpa [hwi, ghostPhaseShift, ghostMemoryShift] using h

/-- Exact weighted storage expansion in the moving frame. Both endpoint
zero counts refer to the actual memory at that endpoint. -/
theorem ghost_phase_moving_storage_weighted {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, AddGroup (R i)] [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (atgt asrc : I → Bool) (delta : (i : I) → R i) (β : I → ℝ) (ρtgt ρsrc : ℝ)
    (w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask asrc w)
    (F : ((i : I) → GhostPhaseState (R i)) → ℝ) :
    (∑ z, (∏ i, ghostPhaseDampedMovingEdge (atgt i) (asrc i) (delta i)
      (β i) ρtgt ρsrc (z i) (w i)) * F z) =
      ∑ B ∈ (ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt).powerset,
        let z := fun i => ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i)
          (decide (i ∈ B)) (w i)
        (ρsrc ^ (ghostPhaseZeroSet w).card * ρtgt ^ (ghostPhaseZeroSet z).card *
          (∏ i ∈ ghostPhaseFreshSet atgt asrc w, β i) *
          (if ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true
            then 1 else 0)) * F z := by
  rw [ghost_phase_moving_storage_actual atgt asrc delta β (fun _ => ρtgt) (fun _ => ρsrc) w hw F]
  apply sum_congr rfl
  intro B hB
  have hs : ∀ i, decide (i ∈ B) = true → atgt i = false ∧ asrc i = true := by
    intro i hi
    have h := mem_powerset.mp hB (of_decide_eq_true hi)
    simpa [ghostPhaseActivitySupport, and_comm] using h
  dsimp only
  rw [ghost_phase_moving_edge_choice_product atgt asrc (fun i => decide (i ∈ B))
    delta β ρtgt ρsrc w hw hs]

/-- Storage is a subset of the actual ordered departing slots. Injective
physical labels make this a bijective reindexing, so no factorial occurs. -/
theorem ghost_phase_moving_storage_slots {J I : Type*}
    [Fintype J] [DecidableEq J] [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, AddGroup (R i)] [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (atgt asrc : I → Bool) (delta : (i : I) → R i) (β : I → ℝ) (ρtgt ρsrc : ℝ)
    (w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask asrc w)
    (g : J ↪ I)
    (hg : univ.image g = ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt)
    (F : ((i : I) → GhostPhaseState (R i)) → ℝ) :
    (∑ z, (∏ i, ghostPhaseDampedMovingEdge (atgt i) (asrc i) (delta i)
      (β i) ρtgt ρsrc (z i) (w i)) * F z) =
      ∑ S ∈ (univ : Finset J).powerset,
        let z := fun i => ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i)
          (decide (i ∈ S.image g)) (w i)
        (ρsrc ^ (ghostPhaseZeroSet w).card * ρtgt ^ (ghostPhaseZeroSet z).card *
          (∏ i ∈ ghostPhaseFreshSet atgt asrc w, β i) *
          (if ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true
            then 1 else 0)) * F z := by
  rw [ghost_phase_moving_storage_weighted atgt asrc delta β ρtgt ρsrc w hw F,
    ← hg, distinct_slot_subset_sum]
end

section
open Finset
/-- Every old pending index is outside the source-active mask. -/
theorem distinct_phase_old_inactive {J P : Type*} [Fintype P]
    {R : P → Type*} (asrc : P → Bool)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (f : DistinctOrderedSupport J (ghostPhasePendingSupport w)) (j : J) :
    asrc (f.val j) = false := by
  classical
  have hf := (f.property (f.val j)).mpr ⟨j, rfl⟩
  simp only [ghostPhasePendingSupport, mem_filter, mem_univ, true_and] at hf
  obtain ⟨r, hr⟩ := hf
  have hm := hw (f.val j)
  rw [hr] at hm
  cases ha : asrc (f.val j) <;> simp_all

/-- Storage indices were source-active and are target-inactive. -/
theorem distinct_phase_storage_active {K P : Type*} [Fintype P]
    (atgt asrc store : P → Bool)
    (hs : ∀ p, store p = true → atgt p = false ∧ asrc p = true)
    (g : DistinctOrderedSupport K (ghostPhaseChoiceSupport store)) (k : K) :
    atgt (g.val k) = false ∧ asrc (g.val k) = true := by
  have hg := (g.property (g.val k)).mpr ⟨k, rfl⟩
  simp only [ghostPhaseChoiceSupport, mem_filter, mem_univ, true_and] at hg
  exact hs (g.val k) hg

/-- The source phase mask guarantees that old and stored ordered labels
cannot coincide. No additional distinctness hypothesis is needed. -/
theorem distinct_phase_old_storage_disjoint {J K P : Type*} [Fintype P]
    {R : P → Type*} (atgt asrc store : P → Bool)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (hs : ∀ p, store p = true → atgt p = false ∧ asrc p = true)
    (f : DistinctOrderedSupport J (ghostPhasePendingSupport w))
    (g : DistinctOrderedSupport K (ghostPhaseChoiceSupport store)) :
    ∀ j k, f.val j ≠ g.val k := by
  intro j k heq
  have hf := distinct_phase_old_inactive asrc w hw f j
  have hg := (distinct_phase_storage_active atgt asrc store hs g k).2
  rw [heq, hg] at hf
  contradiction

/-- The delete/append embedding enumerates the actual moving output support. -/
theorem distinct_phase_moving_embedding_support {J K P : Type*}
    [Fintype J] [Fintype K] [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)]
    (atgt asrc store : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (hs : ∀ p, store p = true → atgt p = false ∧ asrc p = true)
    (f : DistinctOrderedSupport J (ghostPhasePendingSupport w))
    (g : DistinctOrderedSupport K (ghostPhaseChoiceSupport store))
    (hdis : ∀ j k, f.val j ≠ g.val k) :
    univ.image (distinctSurvivorStorageEmbedding f.val g.val
      (ghostPhaseActivitySupport atgt) hdis) =
      ghostPhasePendingSupport (fun p =>
        ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p) (store p) (w p)) := by
  have hf : univ.image f.val = ghostPhasePendingSupport w := by
    ext p
    simp only [mem_image, mem_univ, true_and]
    exact (f.property p).symm
  have hg : univ.image g.val = ghostPhaseChoiceSupport store := by
    ext p
    simp only [mem_image, mem_univ, true_and]
    exact (g.property p).symm
  rw [distinct_survivor_storage_support, hf, hg]
  exact (ghost_phase_moving_choice_support atgt asrc store delta w hw hs).symm

/-- A distinct ordered enumeration of actual output pending memory, with
surviving old indices first and selected storage indices appended. -/
noncomputable def distinctPhaseMovingSupport {J K P : Type*}
    [Fintype J] [Fintype K] [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)]
    (atgt asrc store : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (hs : ∀ p, store p = true → atgt p = false ∧ asrc p = true)
    (f : DistinctOrderedSupport J (ghostPhasePendingSupport w))
    (g : DistinctOrderedSupport K (ghostPhaseChoiceSupport store)) :
    DistinctOrderedSupport ({j : J // f.val j ∉ ghostPhaseActivitySupport atgt} ⊕ K)
      (ghostPhasePendingSupport (fun p =>
        ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p) (store p) (w p))) :=
  ⟨distinctSurvivorStorageEmbedding f.val g.val (ghostPhaseActivitySupport atgt)
      (distinct_phase_old_storage_disjoint atgt asrc store w hw hs f g), by
    intro p
    rw [← distinct_phase_moving_embedding_support atgt asrc store delta w hw hs f g
      (distinct_phase_old_storage_disjoint atgt asrc store w hw hs f g)]
    simp⟩

/-- The ordered transported/stored residues agree at every actual moving
output coordinate, for any proof of old/storage disjointness. -/
theorem distinct_phase_moving_residue {J K P : Type*} [Fintype P]
    {R : P → Type*} [∀ p, AddGroup (R p)]
    (atgt asrc store : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (hs : ∀ p, store p = true → atgt p = false ∧ asrc p = true)
    (f : DistinctOrderedSupport J (ghostPhasePendingSupport w))
    (g : DistinctOrderedSupport K (ghostPhaseChoiceSupport store))
    (hdis : ∀ j k, f.val j ≠ g.val k)
    (old : (j : J) → R (f.val j))
    (hold : ∀ j, w (f.val j) = some (some (some (old j))))
    (j : {j : J // f.val j ∉ ghostPhaseActivitySupport atgt} ⊕ K) :
    let fout := distinctSurvivorStorageEmbedding f.val g.val
      (ghostPhaseActivitySupport atgt) hdis
    let rout := distinctSurvivorStorageResidue f.val g.val
      (ghostPhaseActivitySupport atgt) hdis R
      (fun p r => r - delta p) old (fun k => -delta (g.val k))
    ghostPhaseMovingChoiceTarget (atgt (fout j)) (asrc (fout j))
      (delta (fout j)) (store (fout j)) (w (fout j)) = some (some (some (rout j))) := by
  cases j with
  | inl j =>
    have ht : atgt (f.val j.val) = false := by
      have hj := j.property
      simp only [ghostPhaseActivitySupport, mem_filter, mem_univ, true_and] at hj
      exact Bool.eq_false_of_not_eq_true hj
    exact ghost_phase_moving_choice_survivor atgt asrc store delta w hw hs
      (f.val j.val) (old j.val) (hold j.val) ht
  | inr k =>
    have hg := (g.property (g.val k)).mpr ⟨k, rfl⟩
    have hk : store (g.val k) = true := by
      simpa only [ghostPhaseChoiceSupport, mem_filter, mem_univ, true_and] using hg
    exact ghost_phase_moving_choice_stored _ _ _ _ _ hk

/-- The automatically constructed actual-support enumeration carries the
same residue tuple, ready for an arbitrary coupled continuation. -/
theorem distinct_phase_moving_support_residue {J K P : Type*}
    [Fintype J] [Fintype K] [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)]
    (atgt asrc store : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (hs : ∀ p, store p = true → atgt p = false ∧ asrc p = true)
    (f : DistinctOrderedSupport J (ghostPhasePendingSupport w))
    (g : DistinctOrderedSupport K (ghostPhaseChoiceSupport store))
    (old : (j : J) → R (f.val j))
    (hold : ∀ j, w (f.val j) = some (some (some (old j))))
    (j : {j : J // f.val j ∉ ghostPhaseActivitySupport atgt} ⊕ K) :
    let fout := distinctPhaseMovingSupport atgt asrc store delta w hw hs f g
    let rout := distinctSurvivorStorageResidue f.val g.val
      (ghostPhaseActivitySupport atgt)
      (distinct_phase_old_storage_disjoint atgt asrc store w hw hs f g) R
      (fun p r => r - delta p) old (fun k => -delta (g.val k))
    ghostPhaseMovingChoiceTarget (atgt (fout.val j)) (asrc (fout.val j))
      (delta (fout.val j)) (store (fout.val j)) (w (fout.val j)) =
      some (some (some (rout j))) :=
  distinct_phase_moving_residue atgt asrc store delta w hw hs f g
    (distinct_phase_old_storage_disjoint atgt asrc store w hw hs f g) old hold j
end

section
open Finset
/-- Number of zero residues in an ordered dependent tuple. -/
noncomputable def orderedResidueZeroCount {J : Type*} [Fintype J]
    {R : J → Type*} [∀ j, Zero (R j)] [∀ j, DecidableEq (R j)]
    (r : (j : J) → R j) : ℕ :=
  (univ.filter (fun j => r j = 0)).card

theorem ordered_zero_count_eq_sum {J : Type*} [Fintype J]
    {R : J → Type*} [∀ j, Zero (R j)] [∀ j, DecidableEq (R j)]
    (r : (j : J) → R j) :
    orderedResidueZeroCount r = ∑ j, if r j = 0 then (1 : ℕ) else 0 := by
  exact (sum_boole (fun j => r j = 0) univ).symm

theorem distinct_ordered_support_image {J P : Type*} [Fintype J] [DecidableEq P]
    {S : Finset P} (f : DistinctOrderedSupport J S) : univ.image f.val = S := by
  ext p
  simp only [mem_image, mem_univ, true_and]
  exact (f.property p).symm

/-- Passing from a distinct tuple to its support coordinates preserves the
zero count exactly, including dependent residue types. -/
theorem distinct_ordered_zero_count_reindex {J P : Type*} [Fintype J]
    [DecidableEq P] {S : Finset P} (f : DistinctOrderedSupport J S)
    (R : P → Type*) [∀ p, Zero (R p)] [∀ p, DecidableEq (R p)]
    (r : (j : J) → R (f.val j)) :
    orderedResidueZeroCount r =
      orderedResidueZeroCount (Equiv.piCongrLeft (fun p : S => R p.val)
        (distinctOrderedSupportAsEquiv f) r) := by
  classical
  let e := distinctOrderedSupportAsEquiv f
  rw [ordered_zero_count_eq_sum, ordered_zero_count_eq_sum]
  have hv (j : J) : Equiv.piCongrLeft (fun p : S => R p.val) e r (e j) = r j :=
    Equiv.piCongrLeft_apply_apply _ _ _ _
  have h := Equiv.sum_comp e (fun p : S =>
    if Equiv.piCongrLeft (fun p : S => R p.val) e r p = 0 then (1 : ℕ) else 0)
  refine Eq.trans (sum_congr rfl (fun j hj => ?_)) h
  by_cases hz : r j = 0 <;> simp [hv, hz] <;> first | rfl | exact hz

/-- A distinct ordered enumeration of actual pending phase coordinates has
the same zero count as the full phase-state zero set. -/
theorem distinct_phase_zero_count {J P : Type*} [Fintype J] [Fintype P]
    [DecidableEq P] {R : P → Type*} [∀ p, Zero (R p)] [∀ p, DecidableEq (R p)]
    {S : Finset P} (f : DistinctOrderedSupport J S)
    (w : (p : P) → GhostPhaseState (R p)) (hs : ghostPhasePendingSupport w = S)
    (r : (j : J) → R (f.val j))
    (hr : ∀ j, w (f.val j) = some (some (some (r j)))) :
    orderedResidueZeroCount r = (ghostPhaseZeroSet w).card := by
  classical
  unfold orderedResidueZeroCount
  apply card_bij (fun j _ => f.val j)
  · intro j hj
    have hj' : r j = 0 := by simpa only [mem_filter, mem_univ, true_and] using hj
    simp only [ghostPhaseZeroSet, mem_filter, mem_univ, true_and, hr j, hj']
  · intro j hj k hk heq
    exact f.val.injective heq
  · intro p hp
    have hz : w p = some (some (some 0)) := by
      simpa only [ghostPhaseZeroSet, mem_filter, mem_univ, true_and] using hp
    have hpS : p ∈ S := by
      rw [← hs]
      simp only [ghostPhasePendingSupport, mem_filter, mem_univ, true_and]
      exact ⟨0, hz⟩
    obtain ⟨j, rfl⟩ := (f.property p).mp hpS
    refine ⟨j, ?_, rfl⟩
    simp only [mem_filter, mem_univ, true_and]
    have h := (hr j).symm.trans hz
    simpa only [Option.some.injEq] using h

/-- Source damping includes zero residues that will be promoted as well as
zero residues that will remain in pending memory. -/
theorem ordered_zero_count_partition {J P : Type*} [Fintype J] [DecidableEq P]
    (f : J ↪ P) (T : Finset P) (R : P → Type*)
    [∀ p, Zero (R p)] [∀ p, DecidableEq (R p)] (old : (j : J) → R (f j)) :
    orderedResidueZeroCount old =
      (univ.filter (fun j => f j ∉ T ∧ old j = 0)).card +
        (univ.filter (fun j => f j ∈ T ∧ old j = 0)).card := by
  classical
  simpa only [orderedResidueZeroCount, filter_filter, not_not, and_comm] using
    (card_filter_add_card_filter_not (s := univ.filter (fun j => old j = 0))
      (fun j => f j ∉ T)).symm

/-- The deletion-and-append output counts transported surviving zeros and
newly stored zeros, with no contribution from the deleted promotion indices. -/
theorem distinct_survivor_storage_zero_count {J K P : Type*}
    [Fintype J] [Fintype K] [DecidableEq P]
    (f : J ↪ P) (g : K ↪ P) (T : Finset P) (hdis : ∀ j k, f j ≠ g k)
    (R : P → Type*) [∀ p, Zero (R p)] [∀ p, DecidableEq (R p)]
    (transport : (p : P) → R p → R p)
    (old : (j : J) → R (f j)) (stored : (k : K) → R (g k)) :
    orderedResidueZeroCount
      (distinctSurvivorStorageResidue f g T hdis R transport old stored) =
      orderedResidueZeroCount (fun j : {j : J // f j ∉ T} =>
        transport (f j.val) (old j.val)) + orderedResidueZeroCount stored := by
  classical
  rw [ordered_zero_count_eq_sum, ordered_zero_count_eq_sum, ordered_zero_count_eq_sum]
  have h := Fintype.sum_sum_type (fun z : {j : J // f j ∉ T} ⊕ K =>
    if distinctSurvivorStorageResidue f g T hdis R transport old stored z = 0
      then (1 : ℕ) else 0)
  exact h

/-- Actual selected moving-edge endpoint counts in ordered-memory coordinates.
The source tuple enumerates all old pending particles; the storage tuple
enumerates exactly the selected outgoing active particles. -/
theorem distinct_moving_edge_zero_counts {J K P : Type*}
    [Fintype J] [Fintype K] [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)]
    (atgt asrc store : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (hs : ∀ p, store p = true → atgt p = false ∧ asrc p = true)
    (f : DistinctOrderedSupport J (ghostPhasePendingSupport w))
    (g : DistinctOrderedSupport K (ghostPhaseChoiceSupport store))
    (old : (j : J) → R (f.val j))
    (hold : ∀ j, w (f.val j) = some (some (some (old j)))) :
    (ghostPhaseZeroSet w).card = orderedResidueZeroCount old ∧
      (ghostPhaseZeroSet (fun p =>
        ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p) (store p) (w p))).card =
        orderedResidueZeroCount
          (fun j : {j : J // f.val j ∉ ghostPhaseActivitySupport atgt} =>
            old j.val - delta (f.val j.val)) +
          orderedResidueZeroCount (fun k => -delta (g.val k)) := by
  classical
  refine ⟨(distinct_phase_zero_count f w rfl old hold).symm, ?_⟩
  have hdis : ∀ j k, f.val j ≠ g.val k := by
    intro j k heq
    have hf := (f.property (f.val j)).mpr ⟨j, rfl⟩
    have hg := (g.property (g.val k)).mpr ⟨k, rfl⟩
    rw [heq] at hf
    exact disjoint_left.mp (ghost_phase_storage_disjoint_pending atgt asrc store w hw hs) hf hg
  let T := ghostPhaseActivitySupport atgt
  let zout := fun p => ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p) (store p) (w p)
  let fout := distinctSurvivorStorageSupport f.val g.val T hdis
  let rout := distinctSurvivorStorageResidue f.val g.val T hdis R
    (fun p r => r - delta p) old (fun k => -delta (g.val k))
  have hsupport : ghostPhasePendingSupport zout =
      (univ.image f.val \ T) ∪ univ.image g.val := by
    rw [distinct_ordered_support_image f, distinct_ordered_support_image g]
    exact ghost_phase_moving_choice_support atgt asrc store delta w hw hs
  have hrout : ∀ j, zout (fout.val j) = some (some (some (rout j))) := by
    intro j
    cases j with
    | inl j =>
      have ht : atgt (f.val j.val) = false := by
        have hj := j.property
        simp only [T, ghostPhaseActivitySupport, mem_filter, mem_univ, true_and] at hj
        exact Bool.eq_false_of_not_eq_true hj
      exact ghost_phase_moving_choice_survivor atgt asrc store delta w hw hs
        (f.val j.val) (old j.val) (hold j.val) ht
    | inr k =>
      have hg := (g.property (g.val k)).mpr ⟨k, rfl⟩
      have hk : store (g.val k) = true := by
        simpa only [ghostPhaseChoiceSupport, mem_filter, mem_univ, true_and] using hg
      exact ghost_phase_moving_choice_stored _ _ _ _ _ hk
  rw [← distinct_phase_zero_count fout zout hsupport rout hrout]
  exact distinct_survivor_storage_zero_count f.val g.val T hdis R
    (fun p r => r - delta p) old (fun k => -delta (g.val k))

/-- The two actual phase rho factors are precisely the ordered endpoint
damping, including old particles subsequently promoted and newly stored ones. -/
theorem distinct_moving_edge_endpoint_damping {J K P : Type*}
    [Fintype J] [Fintype K] [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)]
    (atgt asrc store : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (hs : ∀ p, store p = true → atgt p = false ∧ asrc p = true)
    (f : DistinctOrderedSupport J (ghostPhasePendingSupport w))
    (g : DistinctOrderedSupport K (ghostPhaseChoiceSupport store))
    (old : (j : J) → R (f.val j))
    (hold : ∀ j, w (f.val j) = some (some (some (old j)))) (ρsrc ρtgt : ℝ) :
    ρsrc ^ (ghostPhaseZeroSet w).card *
        ρtgt ^ (ghostPhaseZeroSet (fun p =>
          ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p) (store p) (w p))).card =
      ρsrc ^ orderedResidueZeroCount old *
        ρtgt ^ (orderedResidueZeroCount
          (fun j : {j : J // f.val j ∉ ghostPhaseActivitySupport atgt} =>
            old j.val - delta (f.val j.val)) +
          orderedResidueZeroCount (fun k => -delta (g.val k))) := by
  obtain ⟨hsrc, htgt⟩ := distinct_moving_edge_zero_counts atgt asrc store delta w hw hs f g old hold
  rw [hsrc, htgt]
end

section
open Finset
/-- Exact normalized edge action with both endpoint damping factors and the
fresh-label measure. Compatibility is retained even for zero-weight choices. -/
theorem ghost_phase_measured_edge_storage {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, AddGroup (R i)] [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (atgt asrc : I → Bool) (delta : (i : I) → R i) (β : I → ℝ) (ρtgt ρsrc V : ℝ)
    (w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask asrc w)
    (F : ((i : I) → GhostPhaseState (R i)) → ℝ) :
    (∑ z, (∏ i, (if atgt i && !(asrc i) then V⁻¹ else 1) *
      ghostPhaseDampedMovingEdge (atgt i) (asrc i) (delta i)
        (β i) ρtgt ρsrc (z i) (w i)) * F z) =
      ∑ B ∈ (ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt).powerset,
        let z := fun i => ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i)
          (decide (i ∈ B)) (w i)
        (ρsrc ^ (ghostPhaseZeroSet w).card * ρtgt ^ (ghostPhaseZeroSet z).card *
          (V⁻¹) ^ (ghostPhasePromotionSet atgt w).card *
          (∏ i ∈ ghostPhaseFreshSet atgt asrc w, β i / V) *
          (if ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true
            then 1 else 0)) * F z := by
  let N := ∏ i, if atgt i && !(asrc i) then V⁻¹ else 1
  have hN : (∑ z, (∏ i, (if atgt i && !(asrc i) then V⁻¹ else 1) *
      ghostPhaseDampedMovingEdge (atgt i) (asrc i) (delta i)
        (β i) ρtgt ρsrc (z i) (w i)) * F z) =
      ∑ z, (∏ i, ghostPhaseDampedMovingEdge (atgt i) (asrc i) (delta i)
        (β i) ρtgt ρsrc (z i) (w i)) * (N * F z) := by
    apply sum_congr rfl
    intro z _
    rw [prod_mul_distrib]
    dsimp only [N]
    ring
  rw [hN, ghost_phase_moving_storage_actual atgt asrc delta β (fun _ => ρtgt)
    (fun _ => ρsrc) w hw (fun z => N * F z)]
  apply sum_congr rfl
  intro B hB
  have hs : ∀ i, decide (i ∈ B) = true → atgt i = false ∧ asrc i = true := by
    intro i hi
    have h := mem_powerset.mp hB (of_decide_eq_true hi)
    simpa [ghostPhaseActivitySupport, and_comm] using h
  have hc := ghost_phase_run_normalized_edge_fresh_measure atgt asrc
    (fun i => decide (i ∈ B)) delta β ρtgt ρsrc V w hw hs
  rw [prod_mul_distrib] at hc
  dsimp only
  dsimp only [N]
  rw [← mul_assoc, mul_comm _ (∏ i, if atgt i && !(asrc i) then V⁻¹ else 1), hc]

/-- The same actual edge action indexed by the canonical departing source
slots. The label embedding is injective; storage subsets carry no factorial. -/
theorem ghost_phase_measured_edge_slots {J I : Type*}
    [Fintype J] [DecidableEq J] [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, AddGroup (R i)] [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (atgt asrc : I → Bool) (delta : (i : I) → R i) (β : I → ℝ) (ρtgt ρsrc V : ℝ)
    (w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask asrc w)
    (g : J ↪ I)
    (hg : univ.image g = ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt)
    (F : ((i : I) → GhostPhaseState (R i)) → ℝ) :
    (∑ z, (∏ i, (if atgt i && !(asrc i) then V⁻¹ else 1) *
      ghostPhaseDampedMovingEdge (atgt i) (asrc i) (delta i)
        (β i) ρtgt ρsrc (z i) (w i)) * F z) =
      ∑ S ∈ (univ : Finset J).powerset,
        let z := fun i => ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i)
          (decide (i ∈ S.image g)) (w i)
        (ρsrc ^ (ghostPhaseZeroSet w).card * ρtgt ^ (ghostPhaseZeroSet z).card *
          (V⁻¹) ^ (ghostPhasePromotionSet atgt w).card *
          (∏ i ∈ ghostPhaseFreshSet atgt asrc w, β i / V) *
          (if ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true
            then 1 else 0)) * F z := by
  rw [ghost_phase_measured_edge_storage atgt asrc delta β ρtgt ρsrc V w hw F,
    ← hg, distinct_slot_subset_sum]
end

section
open Finset
/-- A real kernel identity for all real tests extends to complex tests. -/
theorem finite_real_action_complex {X J : Type*} [Fintype X]
    (S : Finset J) (K : X → ℝ) (W : J → ℝ) (out : J → X)
    (h : ∀ f : X → ℝ, (∑ x, K x * f x) = ∑ j ∈ S, W j * f (out j))
    (F : X → ℂ) :
    (∑ x, (K x : ℂ) * F x) = ∑ j ∈ S, (W j : ℂ) * F (out j) := by
  apply Complex.ext
  · simpa using h (fun x => (F x).re)
  · simpa using h (fun x => (F x).im)

/-- Exact normalized edge action against a complex, fully coupled continuation.
Only promotions pay explicit inverse V; fresh labels carry beta/V. -/
theorem ghost_phase_measured_edge_complex {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, AddGroup (R i)] [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (atgt asrc : I → Bool) (delta : (i : I) → R i) (β : I → ℝ) (ρtgt ρsrc V : ℝ)
    (w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask asrc w)
    (F : ((i : I) → GhostPhaseState (R i)) → ℂ) :
    (∑ z, ((∏ i, (if atgt i && !(asrc i) then V⁻¹ else 1) *
      ghostPhaseDampedMovingEdge (atgt i) (asrc i) (delta i)
        (β i) ρtgt ρsrc (z i) (w i) : ℝ) : ℂ) * F z) =
      ∑ B ∈ (ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt).powerset,
        let z := fun i => ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i)
          (decide (i ∈ B)) (w i)
        ((ρsrc ^ (ghostPhaseZeroSet w).card * ρtgt ^ (ghostPhaseZeroSet z).card *
          (V⁻¹) ^ (ghostPhasePromotionSet atgt w).card *
          (∏ i ∈ ghostPhaseFreshSet atgt asrc w, β i / V) *
          (if ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true
            then 1 else 0) : ℝ) : ℂ) * F z := by
  exact finite_real_action_complex _ _ _ _
    (ghost_phase_measured_edge_storage atgt asrc delta β ρtgt ρsrc V w hw) F

/-- Canonical departing-slot form, with the physical complex continuation
and no storage factorial. -/
theorem ghost_phase_measured_edge_complex_slots {J I : Type*}
    [Fintype J] [DecidableEq J] [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, AddGroup (R i)] [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (atgt asrc : I → Bool) (delta : (i : I) → R i) (β : I → ℝ) (ρtgt ρsrc V : ℝ)
    (w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask asrc w)
    (g : J ↪ I)
    (hg : univ.image g = ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt)
    (F : ((i : I) → GhostPhaseState (R i)) → ℂ) :
    (∑ z, ((∏ i, (if atgt i && !(asrc i) then V⁻¹ else 1) *
      ghostPhaseDampedMovingEdge (atgt i) (asrc i) (delta i)
        (β i) ρtgt ρsrc (z i) (w i) : ℝ) : ℂ) * F z) =
      ∑ S ∈ (univ : Finset J).powerset,
        let z := fun i => ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i)
          (decide (i ∈ S.image g)) (w i)
        ((ρsrc ^ (ghostPhaseZeroSet w).card * ρtgt ^ (ghostPhaseZeroSet z).card *
          (V⁻¹) ^ (ghostPhasePromotionSet atgt w).card *
          (∏ i ∈ ghostPhaseFreshSet atgt asrc w, β i / V) *
          (if ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true
            then 1 else 0) : ℝ) : ℂ) * F z := by
  exact finite_real_action_complex _ _ _ _
    (ghost_phase_measured_edge_slots atgt asrc delta β ρtgt ρsrc V w hw g hg) F
end

section
open Finset Classical
/-- Choosing eligible indices is equivalent to an ambient embedding together
with the assertion that every chosen index lies in the eligible set. -/
def promotionIndexEquiv {A J : Type*} (Z : Finset J) :
    (A ↪ ↥Z) ≃ {e : A ↪ J // ∀ a, e a ∈ Z} where
  toFun e := ⟨e.trans ⟨Subtype.val, Subtype.val_injective⟩, fun a => (e a).property⟩
  invFun e := ⟨fun a => ⟨e.val a, e.property a⟩,
    fun _ _ h => e.val.injective (congrArg Subtype.val h)⟩
  left_inv e := by ext a; rfl
  right_inv e := by apply Subtype.ext; ext a; rfl

/-- Exact reindexing into the eligible embedding type. The summand can retain
all information about the old particle indices and their numerical labels. -/
theorem promotionChoice_sum_ambient {A J M : Type*} [Fintype A] [Fintype J]
    [AddCommMonoid M] (Z : Finset J) (F : (A ↪ J) → M) :
    (∑ e : A ↪ ↥Z, F (e.trans ⟨Subtype.val, Subtype.val_injective⟩)) =
      ∑ e : A ↪ J, if ∀ a, e a ∈ Z then F e else 0 := by
  calc
    _ = ∑ e : {e : A ↪ J // ∀ a, e a ∈ Z}, F e.val :=
      (promotionIndexEquiv Z).sum_comp (fun e => F e.val)
    _ = ∑ e ∈ (univ : Finset (A ↪ J)).filter (fun e => ∀ a, e a ∈ Z), F e :=
      (sum_subtype _ (by simp) F).symm
    _ = _ := sum_filter _ _

/-- Distinct specified slots are filled by distinct eligible old indices. -/
theorem promotionChoice_card {A J : Type*} [Fintype A] (Z : Finset J) :
    Fintype.card (A ↪ ↥Z) = Z.card.descFactorial (Fintype.card A) := by
  simpa only [Fintype.card_coe] using
    (Fintype.card_embedding_eq (α := A) (β := ↥Z))

theorem promotionChoice_sum_one {A J : Type*} [Fintype A] (Z : Finset J) :
    (∑ _e : A ↪ ↥Z, (1 : ℝ)) = (Z.card.descFactorial (Fintype.card A) : ℝ) := by
  simp only [sum_const, card_univ, nsmul_eq_mul, mul_one, promotionChoice_card]

/-- Old indices selected by an ordered promotion choice. -/
def promotionSelectedIndices {A J : Type*} [Fintype A] {Z : Finset J}
    (e : A ↪ ↥Z) : Finset J :=
  univ.map (e.trans ⟨Subtype.val, Subtype.val_injective⟩)

theorem promotionSelectedIndices_card {A J : Type*} [Fintype A] {Z : Finset J}
    (e : A ↪ ↥Z) : (promotionSelectedIndices e).card = Fintype.card A := by
  simp only [promotionSelectedIndices, card_map, card_univ]

theorem promotionSelectedIndices_subset {A J : Type*} [Fintype A] {Z : Finset J}
    (e : A ↪ ↥Z) : promotionSelectedIndices e ⊆ Z := by
  intro j hj
  obtain ⟨a, _, rfl⟩ := mem_map.mp hj
  exact (e a).property

theorem promotionSlots_card_le {A J : Type*} [Fintype A] {Z : Finset J}
    (e : A ↪ ↥Z) : Fintype.card A ≤ Z.card := by
  simpa only [Fintype.card_coe] using Fintype.card_le_of_embedding e

/-- Removing a promotion choice leaves exactly the unselected eligible indices. -/
theorem promotionEligibleSurvivors_card {A J : Type*} [Fintype A] [DecidableEq J]
    {Z : Finset J} (e : A ↪ ↥Z) :
    (Z \ promotionSelectedIndices e).card = Z.card - Fintype.card A := by
  rw [card_sdiff_of_subset (promotionSelectedIndices_subset e), promotionSelectedIndices_card]

/-- Total old memory loses one index for each promoted slot, including when
different old indices carry equal numerical particle values. -/
theorem promotionOldSurvivors_card {A J : Type*} [Fintype A] [Fintype J] [DecidableEq J]
    {Z : Finset J} (e : A ↪ ↥Z) :
    ((univ : Finset J) \ promotionSelectedIndices e).card =
      Fintype.card J - Fintype.card A := by
  rw [card_sdiff_of_subset (subset_univ _), promotionSelectedIndices_card, card_univ]

/-- Exact damped mass of all ordered promotion choices. -/
theorem promotionChoice_damped_sum {A J : Type*} [Fintype A] [DecidableEq J]
    (Z : Finset J) (ρ V : ℝ) :
    (∑ e : A ↪ ↥Z, ρ ^ (Z \ promotionSelectedIndices e).card / V ^ Fintype.card A) =
      ((Z.card.descFactorial (Fintype.card A) : ℝ) *
        ρ ^ (Z.card - Fintype.card A)) / V ^ Fintype.card A := by
  simp only [promotionEligibleSurvivors_card, sum_const, card_univ, nsmul_eq_mul,
    promotionChoice_card]
  ring

/-- The promotion count times surviving-zero damping has an explicit bound
independent of the number of old memory indices. -/
theorem promotionChoice_damping_bound {A J : Type*} [Fintype A]
    (Z : Finset J) {ρ : ℝ} (hρ0 : 0 ≤ ρ) (hρ1 : ρ < 1) :
    (Z.card.descFactorial (Fintype.card A) : ℝ) * ρ ^ (Z.card - Fintype.card A) ≤
      ((Fintype.card A).factorial : ℝ) / (1 - ρ) ^ (Fintype.card A + 1) := by
  by_cases ha : Fintype.card A ≤ Z.card
  · have h := damped_descFactorial_bound hρ0 hρ1
      (Z.card - Fintype.card A) (Fintype.card A)
    simpa only [Nat.sub_add_cancel ha] using h
  · have hzero : Z.card.descFactorial (Fintype.card A) = 0 :=
      Nat.descFactorial_eq_zero_iff_lt.mpr (Nat.lt_of_not_ge ha)
    rw [hzero, Nat.cast_zero, zero_mul]
    exact div_nonneg (Nat.cast_nonneg _) (pow_nonneg (sub_pos.mpr hρ1).le _)

/-- A fixed bound on the number of promoted slots yields a uniform normalized
row count, even when no embedding exists because the eligible set is too small. -/
theorem promotionChoice_uniform_damped_sum_bound {A J : Type*}
    [Fintype A] [DecidableEq J] (Z : Finset J) {ρ v V : ℝ}
    (hρ0 : 0 ≤ ρ) (hρ1 : ρ < 1) (hv : 0 < v) (hV : v ≤ V)
    (T : ℕ) (hA : Fintype.card A ≤ T) :
    (∑ e : A ↪ ↥Z, ρ ^ (Z \ promotionSelectedIndices e).card / V ^ Fintype.card A) ≤
      ((T.factorial : ℝ) * (max 1 (1 / v)) ^ T) / (1 - ρ) ^ (T + 1) := by
  rw [promotionChoice_damped_sum]
  by_cases ha : Fintype.card A ≤ Z.card
  · have h := uniform_damped_descFactorial_bound hρ0 hρ1 hv hV
      T (Z.card - Fintype.card A) (Fintype.card A) hA
    simpa only [Nat.sub_add_cancel ha] using h
  · have hzero : Z.card.descFactorial (Fintype.card A) = 0 :=
      Nat.descFactorial_eq_zero_iff_lt.mpr (Nat.lt_of_not_ge ha)
    rw [hzero, Nat.cast_zero, zero_mul, zero_div]
    apply div_nonneg
    · exact mul_nonneg (Nat.cast_nonneg _) (pow_nonneg (le_trans zero_le_one (le_max_left _ _)) _)
    · exact pow_nonneg (sub_pos.mpr hρ1).le _
end

section
open Finset Classical
noncomputable def unrestrictedEdgeDampingBound (ρ vmin : ℝ) (T : ℕ) : ℝ :=
  ((T.factorial : ℝ) * (max 1 (1 / vmin)) ^ T) / (1 - ρ) ^ (T + 1)

noncomputable def unrestrictedEdgeChoiceBound (ρ v vmin : ℝ) (T : ℕ) : ℝ :=
  unrestrictedEdgeDampingBound ρ vmin T * v ^ T * 2 ^ T

noncomputable def unrestrictedEdgeRowBound (ρ v vmin : ℝ) (T : ℕ) : ℝ :=
  4 ^ T * unrestrictedEdgeChoiceBound ρ v vmin T

noncomputable def unrestrictedEdgeReversalBound (vmin vmax : ℝ) (T : ℕ) : ℝ :=
  (max 1 vmax) ^ T * (max 1 (1 / vmin)) ^ T

/-- For a promotions and b stores among t slots: ordered retrieval and remaining
output damping, promotion normalization, Schur weight change, and fresh mass.
The ratio v^b/v^a is exactly the integer-exponent factor v^(b-a). -/
noncomputable def unrestrictedEdgeChoiceCost (ρ v V mass : ℝ) (z t a b : ℕ) : ℝ :=
  (((z.descFactorial a : ℝ) * ρ ^ (z - a)) / V ^ a) *
    (v ^ b / v ^ a) * mass ^ (t - a)

/-- The reversed row has b promotions and a stores, and the original
normalization contributes the additional exact factor V^b/V^a. -/
noncomputable def unrestrictedEdgeReverseChoiceCost (ρ v V mass : ℝ) (z t a b : ℕ) : ℝ :=
  unrestrictedEdgeChoiceCost ρ v V mass z t b a * (V ^ b / V ^ a)

theorem unrestrictedEdgeDampingBound_nonneg {ρ vmin : ℝ} (hρ : ρ < 1) (T : ℕ) :
    0 ≤ unrestrictedEdgeDampingBound ρ vmin T := by
  unfold unrestrictedEdgeDampingBound
  have hd : 0 < 1 - ρ := sub_pos.mpr hρ
  have hm : 0 ≤ max 1 (1 / vmin) := le_trans zero_le_one (le_max_left _ _)
  positivity

theorem unrestrictedEdgeChoiceCost_nonneg {ρ v V mass : ℝ}
    (hρ : 0 ≤ ρ) (hv : 0 ≤ v) (hV : 0 ≤ V) (hmass : 0 ≤ mass)
    (z t a b : ℕ) : 0 ≤ unrestrictedEdgeChoiceCost ρ v V mass z t a b := by
  unfold unrestrictedEdgeChoiceCost
  positivity

/-- Ordered retrievals are controlled uniformly, including the impossible
case z<a, where the descending factorial is zero. -/
theorem unrestricted_edge_damped_retrieval_le {ρ vmin V : ℝ}
    (hρ0 : 0 ≤ ρ) (hρ1 : ρ < 1) (hvmin : 0 < vmin) (hV : vmin ≤ V)
    (T z a : ℕ) (ha : a ≤ T) :
    ((z.descFactorial a : ℝ) * ρ ^ (z - a)) / V ^ a ≤
      unrestrictedEdgeDampingBound ρ vmin T := by
  by_cases haz : a ≤ z
  · have h := uniform_damped_descFactorial_bound hρ0 hρ1 hvmin hV T (z - a) a ha
    simpa only [Nat.sub_add_cancel haz, unrestrictedEdgeDampingBound] using h
  · rw [Nat.descFactorial_of_lt (Nat.lt_of_not_ge haz), Nat.cast_zero, zero_mul, zero_div]
    exact unrestrictedEdgeDampingBound_nonneg hρ1 T

/-- The Schur weight change is uniformly bounded by v^T for a,b≤T. -/
theorem unrestricted_edge_weight_ratio_le {v : ℝ} (hv : 1 < v)
    (T a b : ℕ) (hb : b ≤ T) : v ^ b / v ^ a ≤ v ^ T := by
  have hv0 : 0 ≤ v := (zero_lt_one.trans hv).le
  calc
    v ^ b / v ^ a ≤ v ^ b := div_le_self (pow_nonneg hv0 b) (one_le_pow₀ hv.le)
    _ ≤ v ^ T := pow_le_pow_right₀ hv.le hb

/-- A single fixed pair of transfer-slot subsets costs a constant depending
only on T, ρ, v and the lower mass bound, independently of z and J. -/
theorem unrestricted_edge_choice_cost_le {ρ v vmin V mass : ℝ}
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hV : vmin ≤ V) (hmass0 : 0 ≤ mass) (hmass2 : mass ≤ 2)
    (T z t a b : ℕ) (ht : t ≤ T) (ha : a ≤ t) (hb : b ≤ t) :
    unrestrictedEdgeChoiceCost ρ v V mass z t a b ≤
      unrestrictedEdgeChoiceBound ρ v vmin T := by
  have hv0 : 0 ≤ v := (zero_lt_one.trans hv).le
  have hV0 : 0 ≤ V := (hvmin.trans_le hV).le
  have hD := unrestricted_edge_damped_retrieval_le hρ0.le hρ1 hvmin hV T z a (ha.trans ht)
  have hW := unrestricted_edge_weight_ratio_le hv T a b (hb.trans ht)
  have hF : mass ^ (t - a) ≤ (2 : ℝ) ^ T :=
    (pow_le_pow_left₀ hmass0 hmass2 _).trans
      (pow_le_pow_right₀ (by norm_num) ((Nat.sub_le t a).trans ht))
  unfold unrestrictedEdgeChoiceCost unrestrictedEdgeChoiceBound
  apply mul_le_mul
  · exact mul_le_mul hD hW (div_nonneg (pow_nonneg hv0 _) (pow_nonneg hv0 _))
      (unrestrictedEdgeDampingBound_nonneg hρ1 T)
  · exact hF
  · exact pow_nonneg hmass0 _
  · exact mul_nonneg (unrestrictedEdgeDampingBound_nonneg hρ1 T) (pow_nonneg hv0 _)

/-- Reversal changes the promotion normalization by a bounded factor for
V∈[vmin,vmax], uniformly over a,b≤T. -/
theorem unrestricted_edge_reversal_ratio_le {vmin vmax V : ℝ}
    (hvmin : 0 < vmin) (hVlo : vmin ≤ V) (hVhi : V ≤ vmax)
    (T a b : ℕ) (ha : a ≤ T) (hb : b ≤ T) :
    V ^ b / V ^ a ≤ unrestrictedEdgeReversalBound vmin vmax T := by
  have hV0 : 0 ≤ V := (hvmin.trans_le hVlo).le
  have hp : V ^ b ≤ (max 1 vmax) ^ T :=
    (pow_le_pow_left₀ hV0 (hVhi.trans (le_max_right _ _)) _).trans
      (pow_le_pow_right₀ (le_max_left _ _) hb)
  have hi : (1 / V) ^ a ≤ (max 1 (1 / vmin)) ^ T :=
    (pow_le_pow_left₀ (by positivity)
      ((one_div_le_one_div_of_le hvmin hVlo).trans (le_max_right _ _)) _).trans
      (pow_le_pow_right₀ (le_max_left _ _) ha)
  calc
    V ^ b / V ^ a = V ^ b * (1 / V) ^ a := by rw [one_div_pow]; ring
    _ ≤ (max 1 vmax) ^ T * (max 1 (1 / vmin)) ^ T :=
      mul_le_mul hp hi (by positivity) (by positivity)
    _ = _ := rfl

theorem unrestricted_edge_reverse_choice_cost_le {ρ v vmin vmax V mass : ℝ}
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : vmin ≤ V) (hVhi : V ≤ vmax)
    (hmass0 : 0 ≤ mass) (hmass2 : mass ≤ 2)
    (T z t a b : ℕ) (ht : t ≤ T) (ha : a ≤ t) (hb : b ≤ t) :
    unrestrictedEdgeReverseChoiceCost ρ v V mass z t a b ≤
      unrestrictedEdgeChoiceBound ρ v vmin T * unrestrictedEdgeReversalBound vmin vmax T := by
  unfold unrestrictedEdgeReverseChoiceCost
  apply mul_le_mul
  · exact unrestricted_edge_choice_cost_le hρ0 hρ1 hv hvmin hVlo hmass0 hmass2 T z t b a ht hb ha
  · exact unrestricted_edge_reversal_ratio_le hvmin hVlo hVhi T a b (ha.trans ht) (hb.trans ht)
  · exact div_nonneg (pow_nonneg (hvmin.trans_le hVlo).le _) (pow_nonneg (hvmin.trans_le hVlo).le _)
  · unfold unrestrictedEdgeChoiceBound
    exact mul_nonneg (mul_nonneg (unrestrictedEdgeDampingBound_nonneg hρ1 T)
      (pow_nonneg (zero_lt_one.trans hv).le _)) (by positivity)

/-- Sum over the independently chosen source store subset and target promotion
subset. The eligible old-particle count may even vary with these subsets. -/
noncomputable def unrestrictedEdgeRowCost (ρ v V mass : ℝ) (t : ℕ)
    (eligible : Finset (Fin t) → Finset (Fin t) → ℕ) : ℝ :=
  ∑ stores : Finset (Fin t), ∑ promotions : Finset (Fin t),
    unrestrictedEdgeChoiceCost ρ v V mass (eligible stores promotions) t promotions.card stores.card

noncomputable def unrestrictedEdgeReverseRowCost (ρ v V mass : ℝ) (t : ℕ)
    (eligible : Finset (Fin t) → Finset (Fin t) → ℕ) : ℝ :=
  ∑ stores : Finset (Fin t), ∑ promotions : Finset (Fin t),
    unrestrictedEdgeReverseChoiceCost ρ v V mass (eligible stores promotions) t promotions.card stores.card

/-- There are exactly 4^t pairs of store and promotion subsets. -/
theorem unrestricted_edge_subset_pair_sum (t : ℕ) (C : ℝ) :
    (∑ _stores : Finset (Fin t), ∑ _promotions : Finset (Fin t), C) = (4 : ℝ) ^ t * C := by
  simp only [sum_const, card_univ, Fintype.card_finset, Fintype.card_fin,
    nsmul_eq_mul, Nat.cast_pow, Nat.cast_ofNat]
  rw [← mul_assoc, ← mul_pow]
  norm_num

/-- Explicit scalar weighted row bound for one unrestricted big group. -/
theorem unrestricted_edge_row_cost_le {ρ v vmin V mass : ℝ}
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hV : vmin ≤ V) (hmass0 : 0 ≤ mass) (hmass2 : mass ≤ 2)
    (T t : ℕ) (ht : t ≤ T) (eligible : Finset (Fin t) → Finset (Fin t) → ℕ) :
    unrestrictedEdgeRowCost ρ v V mass t eligible ≤ unrestrictedEdgeRowBound ρ v vmin T := by
  have hC : 0 ≤ unrestrictedEdgeChoiceBound ρ v vmin T := by
    unfold unrestrictedEdgeChoiceBound
    exact mul_nonneg (mul_nonneg (unrestrictedEdgeDampingBound_nonneg hρ1 T)
      (pow_nonneg (zero_lt_one.trans hv).le _)) (by positivity)
  calc
    unrestrictedEdgeRowCost ρ v V mass t eligible ≤
        ∑ _stores : Finset (Fin t), ∑ _promotions : Finset (Fin t),
          unrestrictedEdgeChoiceBound ρ v vmin T := by
      apply sum_le_sum
      intro stores hs
      apply sum_le_sum
      intro promotions hp
      apply unrestricted_edge_choice_cost_le hρ0 hρ1 hv hvmin hV hmass0 hmass2 T _ t _ _ ht
      · exact (card_le_card (subset_univ promotions)).trans (by simp)
      · exact (card_le_card (subset_univ stores)).trans (by simp)
    _ = (4 : ℝ) ^ t * unrestrictedEdgeChoiceBound ρ v vmin T := unrestricted_edge_subset_pair_sum _ _
    _ ≤ (4 : ℝ) ^ T * unrestrictedEdgeChoiceBound ρ v vmin T :=
      mul_le_mul_of_nonneg_right (pow_le_pow_right₀ (by norm_num) ht) hC
    _ = _ := rfl

/-- The scalar reversed row, hence the future column estimate after the
weighted adjoint identity, has the same J-independent bound up to reversal. -/
theorem unrestricted_edge_reverse_row_cost_le {ρ v vmin vmax V mass : ℝ}
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : vmin ≤ V) (hVhi : V ≤ vmax)
    (hmass0 : 0 ≤ mass) (hmass2 : mass ≤ 2)
    (T t : ℕ) (ht : t ≤ T) (eligible : Finset (Fin t) → Finset (Fin t) → ℕ) :
    unrestrictedEdgeReverseRowCost ρ v V mass t eligible ≤
      unrestrictedEdgeRowBound ρ v vmin T * unrestrictedEdgeReversalBound vmin vmax T := by
  have hC : 0 ≤ unrestrictedEdgeChoiceBound ρ v vmin T * unrestrictedEdgeReversalBound vmin vmax T := by
    unfold unrestrictedEdgeChoiceBound unrestrictedEdgeReversalBound
    have hD := unrestrictedEdgeDampingBound_nonneg (vmin := vmin) hρ1 T
    have hv0 := (zero_lt_one.trans hv).le
    have hm1 : 0 ≤ max 1 vmax := le_trans zero_le_one (le_max_left _ _)
    have hm2 : 0 ≤ max 1 (1 / vmin) := le_trans zero_le_one (le_max_left _ _)
    positivity
  calc
    unrestrictedEdgeReverseRowCost ρ v V mass t eligible ≤
        ∑ _stores : Finset (Fin t), ∑ _promotions : Finset (Fin t),
          unrestrictedEdgeChoiceBound ρ v vmin T * unrestrictedEdgeReversalBound vmin vmax T := by
      apply sum_le_sum
      intro stores hs
      apply sum_le_sum
      intro promotions hp
      apply unrestricted_edge_reverse_choice_cost_le hρ0 hρ1 hv hvmin hVlo hVhi
        hmass0 hmass2 T _ t _ _ ht
      · exact (card_le_card (subset_univ promotions)).trans (by simp)
      · exact (card_le_card (subset_univ stores)).trans (by simp)
    _ = (4 : ℝ) ^ t * (unrestrictedEdgeChoiceBound ρ v vmin T *
        unrestrictedEdgeReversalBound vmin vmax T) := unrestricted_edge_subset_pair_sum _ _
    _ ≤ (4 : ℝ) ^ T * (unrestrictedEdgeChoiceBound ρ v vmin T *
        unrestrictedEdgeReversalBound vmin vmax T) :=
      mul_le_mul_of_nonneg_right (pow_le_pow_right₀ (by norm_num) ht) hC
    _ = _ := by unfold unrestrictedEdgeRowBound; ring
end

section
open Finset Classical
abbrev UnrestrictedFreshLabels {I : Type*} (P : Type*) (T : Finset I) :=
  {i : I // i ∉ T} → P

/-- Stitch prescribed promoted values and freely drawn values into one target tuple. -/
noncomputable def unrestrictedTargetLabels {I P : Type*} [DecidableEq I] (T : Finset I)
    (promoted : T → P) (fresh : UnrestrictedFreshLabels P T) : I → P :=
  fun i => if hi : i ∈ T then promoted ⟨i, hi⟩ else fresh ⟨i, hi⟩

theorem unrestrictedTargetLabels_promoted {I P : Type*} [DecidableEq I] (T : Finset I)
    (promoted : T → P) (fresh : UnrestrictedFreshLabels P T) (i : T) :
    unrestrictedTargetLabels T promoted fresh i.val = promoted i := by
  simp [unrestrictedTargetLabels, i.property]

theorem unrestrictedTargetLabels_fresh {I P : Type*} [DecidableEq I] (T : Finset I)
    (promoted : T → P) (fresh : UnrestrictedFreshLabels P T) (i : {i : I // i ∉ T}) :
    unrestrictedTargetLabels T promoted fresh i.val = fresh i := by
  simp [unrestrictedTargetLabels, i.property]

/-- The complementary slots have exactly total-slot-count minus promotion-count entries. -/
theorem unrestricted_fresh_slot_card {I : Type*} [Fintype I] [DecidableEq I] (T : Finset I) :
    Fintype.card {i : I // i ∉ T} = Fintype.card I - T.card := by
  rw [Fintype.card_subtype_compl]
  simp

noncomputable def unrestrictedFreshWeight {I P : Type*} [Fintype I] [DecidableEq I]
    (μ : P → ℝ) (T : Finset I) (fresh : UnrestrictedFreshLabels P T) : ℝ :=
  ∏ i : {i : I // i ∉ T}, μ (fresh i)

theorem unrestrictedFreshWeight_nonneg {I P : Type*} [Fintype I] [DecidableEq I]
    (μ : P → ℝ) (T : Finset I) (hμ : ∀ p, 0 ≤ μ p) (fresh : UnrestrictedFreshLabels P T) :
    0 ≤ unrestrictedFreshWeight μ T fresh :=
  prod_nonneg fun i _ => hμ (fresh i)

/-- The unrestricted product draw has exactly the corresponding power of the total fresh mass. -/
theorem unrestricted_fresh_mass_eq {I P : Type*} [Fintype I] [DecidableEq I] [Fintype P]
    (μ : P → ℝ) (T : Finset I) :
    (∑ fresh : UnrestrictedFreshLabels P T, unrestrictedFreshWeight μ T fresh) =
      (∑ p : P, μ p) ^ (Fintype.card I - T.card) := by
  unfold unrestrictedFreshWeight
  rw [← Fintype.prod_sum]
  simp only [prod_const, card_univ, unrestricted_fresh_slot_card]

theorem unrestricted_fresh_mass_nonneg {I P : Type*} [Fintype I] [DecidableEq I] [Fintype P]
    (μ : P → ℝ) (T : Finset I) (hμ : ∀ p, 0 ≤ μ p) :
    0 ≤ ∑ fresh : UnrestrictedFreshLabels P T, unrestrictedFreshWeight μ T fresh :=
  sum_nonneg fun fresh _ => unrestrictedFreshWeight_nonneg μ T hμ fresh

/-- Applying a pointwise upper bound after target stitching costs exactly the fresh mass. -/
theorem unrestricted_fresh_sum_le {I P : Type*} [Fintype I] [DecidableEq I] [Fintype P]
    (μ : P → ℝ) (T : Finset I) (promoted : T → P) (F : (I → P) → ℝ)
    (hμ : ∀ p, 0 ≤ μ p) {B : ℝ}
    (hF : ∀ fresh : UnrestrictedFreshLabels P T, F (unrestrictedTargetLabels T promoted fresh) ≤ B) :
    (∑ fresh : UnrestrictedFreshLabels P T,
      unrestrictedFreshWeight μ T fresh * F (unrestrictedTargetLabels T promoted fresh)) ≤
        (∑ p : P, μ p) ^ (Fintype.card I - T.card) * B := by
  calc
    (∑ fresh : UnrestrictedFreshLabels P T,
        unrestrictedFreshWeight μ T fresh * F (unrestrictedTargetLabels T promoted fresh)) ≤
      ∑ fresh : UnrestrictedFreshLabels P T, unrestrictedFreshWeight μ T fresh * B :=
        sum_le_sum fun fresh _ => mul_le_mul_of_nonneg_left (hF fresh)
          (unrestrictedFreshWeight_nonneg μ T hμ fresh)
    _ = _ := by rw [← sum_mul, unrestricted_fresh_mass_eq]

/-- Vector-valued weighted action of the fresh draws. The output may be any
real normed space; the only input to F is the complete stitched target tuple. -/
theorem unrestricted_fresh_norm_sum_le {I P E : Type*} [Fintype I] [DecidableEq I] [Fintype P]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (μ : P → ℝ) (T : Finset I) (promoted : T → P) (F : (I → P) → E)
    (hμ : ∀ p, 0 ≤ μ p) {B : ℝ}
    (hF : ∀ fresh : UnrestrictedFreshLabels P T, ‖F (unrestrictedTargetLabels T promoted fresh)‖ ≤ B) :
    ‖∑ fresh : UnrestrictedFreshLabels P T,
      unrestrictedFreshWeight μ T fresh • F (unrestrictedTargetLabels T promoted fresh)‖ ≤
        (∑ p : P, μ p) ^ (Fintype.card I - T.card) * B := by
  calc
    ‖∑ fresh : UnrestrictedFreshLabels P T,
        unrestrictedFreshWeight μ T fresh • F (unrestrictedTargetLabels T promoted fresh)‖ ≤
      ∑ fresh : UnrestrictedFreshLabels P T,
        ‖unrestrictedFreshWeight μ T fresh • F (unrestrictedTargetLabels T promoted fresh)‖ :=
          norm_sum_le _ _
    _ = ∑ fresh : UnrestrictedFreshLabels P T,
        unrestrictedFreshWeight μ T fresh * ‖F (unrestrictedTargetLabels T promoted fresh)‖ := by
      apply sum_congr rfl
      intro fresh hf
      rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (unrestrictedFreshWeight_nonneg μ T hμ fresh)]
    _ ≤ _ := unrestricted_fresh_sum_le μ T promoted (fun target => ‖F target‖) hμ hF

/-- Complex-valued form, matching scalar transition-kernel multiplication. -/
theorem unrestricted_fresh_complex_sum_norm_le {I P : Type*} [Fintype I] [DecidableEq I] [Fintype P]
    (μ : P → ℝ) (T : Finset I) (promoted : T → P) (F : (I → P) → ℂ)
    (hμ : ∀ p, 0 ≤ μ p) {B : ℝ}
    (hF : ∀ fresh : UnrestrictedFreshLabels P T, ‖F (unrestrictedTargetLabels T promoted fresh)‖ ≤ B) :
    ‖∑ fresh : UnrestrictedFreshLabels P T,
      (unrestrictedFreshWeight μ T fresh : ℂ) * F (unrestrictedTargetLabels T promoted fresh)‖ ≤
        (∑ p : P, μ p) ^ (Fintype.card I - T.card) * B := by
  simpa only [Complex.real_smul] using unrestricted_fresh_norm_sum_le μ T promoted F hμ hF
end

section
open Finset Classical
noncomputable def orderedPredicateCount {Z : Type*} (q : FiniteOrderedTuple Z)
    (hit : Z → Prop) : ℕ :=
  ∑ j, if hit (q.2 j) then 1 else 0

theorem orderedPredicateCount_append {Z : Type*} {m n : ℕ}
    (p : Fin m → Z) (q : Fin n → Z) (hit : Z → Prop) :
    orderedPredicateCount ⟨m + n, Fin.addCases p q⟩ hit =
      orderedPredicateCount ⟨m, p⟩ hit + orderedPredicateCount ⟨n, q⟩ hit := by
  unfold orderedPredicateCount
  rw [Fin.sum_univ_add]
  simp only [Fin.addCases_left, Fin.addCases_right]

theorem orderedPredicateCount_retained {Z : Type*} {N : ℕ}
    (p : Fin N → Z) (s : Finset (Fin N)) (hit : Z → Prop) :
    orderedPredicateCount ⟨s.card, retainedOrderedTuple p s⟩ hit =
      (s.filter (fun j => hit (p j))).card := by
  unfold orderedPredicateCount retainedOrderedTuple
  rw [s.equivFin.symm.sum_comp (fun j : s => if hit (p j.val) then 1 else 0)]
  calc
    _ = ∑ j ∈ s, if hit (p j) then 1 else 0 :=
      sum_coe_sort s (fun j => if hit (p j) then 1 else 0)
    _ = _ := by simp

/-- Survivors of a promotion choice are old indices, never newly stored entries. -/
noncomputable def unrestrictedEdgeSurvivors {A : Type*} [Fintype A] {N : ℕ}
    {eligible : Finset (Fin N)} (e : A ↪ ↥eligible) : Finset (Fin N) :=
  univ \ promotionSelectedIndices e

/-- Store the source entries, transport all memory, and remove the selected
old indices. This order is equivalent to transport-then-delete because the
promotion injection only ranges over the original index set. -/
noncomputable def unrestrictedEdgeMemory {A Z : Type*} [Fintype A] {N b : ℕ}
    (old : Fin N → Z) (transport : Z → Z) (stored : Fin b → Z)
    {eligible : Finset (Fin N)} (e : A ↪ ↥eligible) : FiniteOrderedTuple Z :=
  retainedBirthTuple (transport ∘ old) (unrestrictedEdgeSurvivors e) (transport ∘ stored)

theorem unrestrictedEdgeMemory_length {A Z : Type*} [Fintype A] {N b : ℕ}
    (old : Fin N → Z) (transport : Z → Z) (stored : Fin b → Z)
    {eligible : Finset (Fin N)} (e : A ↪ ↥eligible) :
    (unrestrictedEdgeMemory old transport stored e).1 = N - Fintype.card A + b := by
  change (univ \ promotionSelectedIndices e).card + b = _
  rw [promotionOldSurvivors_card]
  simp only [Fintype.card_fin]

/-- Every eligible old particle that is not promoted survives as an output
zero. Newly stored particles can only increase the number of output zeros. -/
theorem unrestrictedEdgeMemory_hit_count_le {A Z : Type*} [Fintype A] {N b : ℕ}
    (old : Fin N → Z) (transport : Z → Z) (stored : Fin b → Z)
    (hit : Z → Prop) {eligible : Finset (Fin N)} (e : A ↪ ↥eligible)
    (heligible : ∀ j ∈ eligible, hit (transport (old j))) :
    eligible.card - Fintype.card A ≤
      orderedPredicateCount (unrestrictedEdgeMemory old transport stored e) hit := by
  rw [← promotionEligibleSurvivors_card e]
  change (eligible \ promotionSelectedIndices e).card ≤
    orderedPredicateCount
      ⟨(unrestrictedEdgeSurvivors e).card + b,
        Fin.addCases (retainedOrderedTuple (transport ∘ old) (unrestrictedEdgeSurvivors e))
          (transport ∘ stored)⟩ hit
  rw [orderedPredicateCount_append, orderedPredicateCount_retained]
  apply (card_le_card ?_).trans (Nat.le_add_right _ _)
  intro j hj
  obtain ⟨hjE, hjN⟩ := mem_sdiff.mp hj
  exact mem_filter.mpr ⟨mem_sdiff.mpr ⟨mem_univ _, hjN⟩, heligible j hjE⟩

theorem unrestrictedEdgeMemory_damping_le {A Z : Type*} [Fintype A] {N b : ℕ}
    (old : Fin N → Z) (transport : Z → Z) (stored : Fin b → Z)
    (hit : Z → Prop) {eligible : Finset (Fin N)} (e : A ↪ ↥eligible)
    (heligible : ∀ j ∈ eligible, hit (transport (old j)))
    {ρ : ℝ} (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1) :
    ρ ^ orderedPredicateCount (unrestrictedEdgeMemory old transport stored e) hit ≤
      ρ ^ (eligible.card - Fintype.card A) :=
  pow_le_pow_of_le_one hρ0 hρ1
    (unrestrictedEdgeMemory_hit_count_le old transport stored hit e heligible)

/-- The literal input and output damping factors admit the old-survivor bound. -/
theorem unrestrictedEdgeMemory_two_damping_le {A Z : Type*} [Fintype A] {N b : ℕ}
    (old : Fin N → Z) (transport : Z → Z) (stored : Fin b → Z)
    (hit : Z → Prop) {eligible : Finset (Fin N)} (e : A ↪ ↥eligible)
    (heligible : ∀ j ∈ eligible, hit (transport (old j)))
    {ρ : ℝ} (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1) :
    ρ ^ orderedPredicateCount ⟨N, old⟩ hit *
        ρ ^ orderedPredicateCount (unrestrictedEdgeMemory old transport stored e) hit ≤
      ρ ^ (eligible.card - Fintype.card A) := by
  have hi : ρ ^ orderedPredicateCount ⟨N, old⟩ hit ≤ 1 := pow_le_one₀ hρ0 hρ1
  calc
    _ ≤ 1 * ρ ^ orderedPredicateCount (unrestrictedEdgeMemory old transport stored e) hit :=
      mul_le_mul_of_nonneg_right hi (pow_nonneg hρ0 _)
    _ ≤ _ := by simpa only [one_mul] using
      unrestrictedEdgeMemory_damping_le old transport stored hit e heligible hρ0 hρ1

/-- Exact change of the geometric memory weight for each individual event. -/
theorem unrestrictedEdgeMemory_weight {A Z : Type*} [Fintype A] {N b : ℕ}
    (old : Fin N → Z) (transport : Z → Z) (stored : Fin b → Z)
    {eligible : Finset (Fin N)} (e : A ↪ ↥eligible) {v : ℝ} (hv : v ≠ 0) :
    v ^ (unrestrictedEdgeMemory old transport stored e).1 =
      v ^ N * (v ^ b / v ^ Fintype.card A) := by
  have ha : Fintype.card A ≤ N := (promotionSlots_card_le e).trans (by
    simpa using card_le_card (subset_univ eligible))
  rw [unrestrictedEdgeMemory_length, pow_add]
  have hn : v ^ N = v ^ (N - Fintype.card A) * v ^ Fintype.card A := by
    rw [← pow_add, Nat.sub_add_cancel ha]
  rw [hn]
  field_simp
end

section
open Finset Classical
/-- The selected old indices and their complement reconstruct every old index. -/
noncomputable def promotionIndexSplit {A J : Type*} (e : A ↪ J) :
    A ⊕ {j : J // j ∉ Set.range e} ≃ J :=
  (Equiv.sumCongr (Equiv.ofInjective e e.injective) (Equiv.refl _)).trans
    (Equiv.sumCompl (fun j => j ∈ Set.range e))

theorem promotionIndexSplit_inl {A J : Type*} (e : A ↪ J) (a : A) :
    promotionIndexSplit e (Sum.inl a) = e a := rfl

theorem promotionIndexSplit_inr {A J : Type*} (e : A ↪ J)
    (j : {j : J // j ∉ Set.range e}) :
    promotionIndexSplit e (Sum.inr j) = j.val := rfl

/-- A tuple splits into the ordered selected values and the survivor values. -/
noncomputable def promotionTupleSplit {A J : Type*} (e : A ↪ J) (Z : Type*) :
    (J → Z) ≃ (A → Z) × ({j : J // j ∉ Set.range e} → Z) :=
  (Equiv.arrowCongr (promotionIndexSplit e).symm (Equiv.refl Z)).trans
    (Equiv.sumArrowEquivProdArrow A {j : J // j ∉ Set.range e} Z)

theorem promotionTupleSplit_selected {A J Z : Type*} (e : A ↪ J) (x : J → Z) (a : A) :
    (promotionTupleSplit e Z x).1 a = x (e a) := rfl

theorem promotionTupleSplit_survivor {A J Z : Type*} (e : A ↪ J) (x : J → Z)
    (j : {j : J // j ∉ Set.range e}) :
    (promotionTupleSplit e Z x).2 j = x j.val := rfl

/-- Product coordinate weights split exactly into selected and surviving factors. -/
theorem promotion_tuple_weight_split {A J Z R : Type*} [Fintype A] [Fintype J]
    [CommMonoid R] (e : A ↪ J) (μ : Z → R) (x : J → Z) :
    (∏ j : J, μ (x j)) =
      (∏ a : A, μ (x (e a))) * ∏ j : {j : J // j ∉ Set.range e}, μ (x j.val) := by
  have h := (promotionIndexSplit e).prod_comp (fun j => μ (x j))
  rw [Fintype.prod_sum_type] at h
  exact h.symm

/-- Weighted summation over all old tuples is weighted summation over their
selected and survivor tuples. No numerical-value injectivity is required. -/
theorem promotion_weighted_tuple_sum {A J Z R : Type*}
    [Fintype A] [Fintype J] [Fintype Z] [CommSemiring R]
    (e : A ↪ J) (μ : Z → R)
    (F : (A → Z) → ({j : J // j ∉ Set.range e} → Z) → R) :
    (∑ x : J → Z, (∏ j : J, μ (x j)) *
      F (fun a => x (e a)) (fun j => x j.val)) =
      ∑ selected : A → Z, ∑ survivors : {j : J // j ∉ Set.range e} → Z,
        ((∏ a : A, μ (selected a)) * ∏ j, μ (survivors j)) * F selected survivors := by
  let G : (A → Z) × ({j : J // j ∉ Set.range e} → Z) → R := fun y =>
    ((∏ a : A, μ (y.1 a)) * ∏ j, μ (y.2 j)) * F y.1 y.2
  calc
    _ = ∑ x : J → Z, G (promotionTupleSplit e Z x) := by
      apply sum_congr rfl
      intro x _
      rw [promotion_tuple_weight_split e μ x]
      rfl
    _ = ∑ y, G y := (promotionTupleSplit e Z).sum_comp G
    _ = _ := Fintype.sum_prod_type G
end

section
open Finset Classical
abbrev UnrestrictedResidueParticle {P : Type*} (n : P → ℕ) := Σ p : P, ZMod (n p)

/-- Move the residue frame by Δ without changing the particle label. -/
def unrestrictedResidueTransport {P : Type*} (n : P → ℕ) (Δ : ℤ) :
    UnrestrictedResidueParticle n ≃ UnrestrictedResidueParticle n where
  toFun z := ⟨z.1, z.2 - (Δ : ZMod (n z.1))⟩
  invFun z := ⟨z.1, z.2 + (Δ : ZMod (n z.1))⟩
  left_inv := by rintro ⟨p, r⟩; simp
  right_inv := by rintro ⟨p, r⟩; simp

theorem unrestrictedResidueTransport_label {P : Type*} (n : P → ℕ) (Δ : ℤ)
    (z : UnrestrictedResidueParticle n) : (unrestrictedResidueTransport n Δ z).1 = z.1 := rfl

theorem unrestrictedResidueTransport_apply {P : Type*} (n : P → ℕ) (Δ : ℤ)
    (p : P) (r : ZMod (n p)) :
    unrestrictedResidueTransport n Δ ⟨p, r⟩ = ⟨p, r - (Δ : ZMod (n p))⟩ := rfl

theorem unrestrictedResidueTransport_zero {P : Type*} (n : P → ℕ)
    (z : UnrestrictedResidueParticle n) : unrestrictedResidueTransport n 0 z = z := by
  rcases z with ⟨p, r⟩
  simp [unrestrictedResidueTransport]

theorem unrestrictedResidueTransport_add {P : Type*} (n : P → ℕ) (Δ Γ : ℤ)
    (z : UnrestrictedResidueParticle n) :
    unrestrictedResidueTransport n (Δ + Γ) z =
      unrestrictedResidueTransport n Γ (unrestrictedResidueTransport n Δ z) := by
  rcases z with ⟨p, r⟩
  simp [unrestrictedResidueTransport, sub_sub, Int.cast_add]

theorem unrestrictedResidueTransport_symm {P : Type*} (n : P → ℕ) (Δ : ℤ) :
    (unrestrictedResidueTransport n Δ).symm = unrestrictedResidueTransport n (-Δ) := by
  apply Equiv.ext
  rintro ⟨p, r⟩
  simp [unrestrictedResidueTransport]

/-- Birth or storage starts a particle at residue zero. -/
def unrestrictedResidueSeed {P : Type*} (n : P → ℕ) (p : P) : UnrestrictedResidueParticle n :=
  ⟨p, 0⟩

def unrestrictedResidueHit {P : Type*} {n : P → ℕ} (z : UnrestrictedResidueParticle n) : Prop :=
  z.2 = 0

theorem unrestrictedResidueSeed_hit {P : Type*} (n : P → ℕ) (p : P) :
    unrestrictedResidueHit (unrestrictedResidueSeed n p) := rfl

theorem unrestrictedResidueTransport_seed {P : Type*} (n : P → ℕ) (Δ : ℤ) (p : P) :
    unrestrictedResidueTransport n Δ (unrestrictedResidueSeed n p) =
      ⟨p, -(Δ : ZMod (n p))⟩ := by
  simp [unrestrictedResidueTransport, unrestrictedResidueSeed]

/-- Under the minus-displacement convention, an old particle hits zero
exactly when its old residue equals the displacement. -/
theorem unrestrictedResidueTransport_hit_iff {P : Type*} (n : P → ℕ) (Δ : ℤ)
    (z : UnrestrictedResidueParticle n) :
    unrestrictedResidueHit (unrestrictedResidueTransport n Δ z) ↔
      z.2 = (Δ : ZMod (n z.1)) := by
  rcases z with ⟨p, r⟩
  change r - (Δ : ZMod (n p)) = 0 ↔ r = (Δ : ZMod (n p))
  exact sub_eq_zero

/-- The particle measure is label mass times counting measure on residues. -/
def unrestrictedResidueWeight {P : Type*} {n : P → ℕ}
    (μ : P → ℝ) (z : UnrestrictedResidueParticle n) : ℝ := μ z.1

theorem unrestrictedResidueWeight_transport {P : Type*} (n : P → ℕ)
    (μ : P → ℝ) (Δ : ℤ) (z : UnrestrictedResidueParticle n) :
    unrestrictedResidueWeight μ (unrestrictedResidueTransport n Δ z) =
      unrestrictedResidueWeight μ z := rfl

/-- Finite counting sums are unchanged by moving the residue frame.
Nonzero moduli are needed only here, to make each residue fiber finite. -/
theorem unrestrictedResidueTransport_sum {P E : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] [AddCommMonoid E]
    (Δ : ℤ) (F : UnrestrictedResidueParticle n → E) :
    (∑ z : UnrestrictedResidueParticle n, F (unrestrictedResidueTransport n Δ z)) = ∑ z, F z :=
  (unrestrictedResidueTransport n Δ).sum_comp F

theorem unrestrictedResidueTransport_weighted_sum {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ : ℤ)
    (F : UnrestrictedResidueParticle n → ℝ) :
    (∑ z : UnrestrictedResidueParticle n,
      unrestrictedResidueWeight μ z * F (unrestrictedResidueTransport n Δ z)) =
        ∑ z, unrestrictedResidueWeight μ z * F z := by
  simpa only [unrestrictedResidueWeight_transport] using
    unrestrictedResidueTransport_sum n Δ (fun z => unrestrictedResidueWeight μ z * F z)

/-- Eligibility retains old particle indices and requires the dilation ban.
Nothing in this definition identifies particles with equal labels or residues. -/
noncomputable def unrestrictedResidueEligible {P : Type*} {N : ℕ}
    (n : P → ℕ) (Δ D : ℤ) (old : Fin N → UnrestrictedResidueParticle n) : Finset (Fin N) :=
  univ.filter fun j => (old j).2 = (Δ : ZMod (n (old j).1)) ∧ ¬ (n (old j).1 : ℤ) ∣ D

theorem mem_unrestrictedResidueEligible {P : Type*} {N : ℕ}
    (n : P → ℕ) (Δ D : ℤ) (old : Fin N → UnrestrictedResidueParticle n) (j : Fin N) :
    j ∈ unrestrictedResidueEligible n Δ D old ↔
      (old j).2 = (Δ : ZMod (n (old j).1)) ∧ ¬ (n (old j).1 : ℤ) ∣ D := by
  simp [unrestrictedResidueEligible]

theorem unrestrictedResidueEligible_iff_hit {P : Type*} {N : ℕ}
    (n : P → ℕ) (Δ D : ℤ) (old : Fin N → UnrestrictedResidueParticle n) (j : Fin N) :
    j ∈ unrestrictedResidueEligible n Δ D old ↔
      unrestrictedResidueHit (unrestrictedResidueTransport n Δ (old j)) ∧
        ¬ (n (old j).1 : ℤ) ∣ D := by
  rw [mem_unrestrictedResidueEligible, unrestrictedResidueTransport_hit_iff]

/-- The precise translated-hit hypothesis consumed by the generic ordered
memory survivor/damping theorems. -/
theorem unrestrictedResidueEligible_translated_hit {P : Type*} {N : ℕ}
    (n : P → ℕ) (Δ D : ℤ) (old : Fin N → UnrestrictedResidueParticle n) :
    ∀ j ∈ unrestrictedResidueEligible n Δ D old,
      unrestrictedResidueHit (unrestrictedResidueTransport n Δ (old j)) := by
  intro j hj
  exact ((unrestrictedResidueEligible_iff_hit n Δ D old j).mp hj).1
end

section
open Finset Classical
noncomputable def unrestrictedStoredTuple {P Z : Type*} {t : ℕ}
    (source : Fin t → P) (seed : P → Z) (stores : Finset (Fin t)) :
    Fin stores.card → Z := retainedOrderedTuple (seed ∘ source) stores

noncomputable def unrestrictedEdgeOutput {P Z : Type*} {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (seed : P → Z) (transport : Z → Z)
    (stores promotions : Finset (Fin t)) {eligible : Finset (Fin N)}
    (e : promotions ↪ ↥eligible) : FiniteOrderedTuple Z :=
  unrestrictedEdgeMemory old transport (unrestrictedStoredTuple source seed stores) e

noncomputable def unrestrictedEdgeTarget {P Z : Type*} {t N : ℕ}
    (old : Fin N → Z) (label : Z → P) (promotions : Finset (Fin t))
    {eligible : Finset (Fin N)} (e : promotions ↪ ↥eligible)
    (fresh : UnrestrictedFreshLabels P promotions) : Fin t → P :=
  unrestrictedTargetLabels promotions (fun i => label (old (e i).val)) fresh

/-- The two damping factors occur on the actual input and output memories. -/
noncomputable def unrestrictedEdgeEventMass {P Z : Type*} {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (seed : P → Z) (transport : Z → Z)
    (hit : Z → Prop) (μ : P → ℝ) (ρ V : ℝ) (stores promotions : Finset (Fin t))
    {eligible : Finset (Fin N)} (e : promotions ↪ ↥eligible)
    (fresh : UnrestrictedFreshLabels P promotions) : ℝ :=
  (ρ ^ orderedPredicateCount ⟨N, old⟩ hit *
    ρ ^ orderedPredicateCount (unrestrictedEdgeOutput source old seed transport stores promotions e) hit /
      V ^ promotions.card) * unrestrictedFreshWeight μ promotions fresh

theorem unrestrictedEdgeEventMass_nonneg {P Z : Type*} {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (seed : P → Z) (transport : Z → Z)
    (hit : Z → Prop) (μ : P → ℝ) {ρ V : ℝ} (hρ : 0 ≤ ρ) (hV : 0 ≤ V)
    (hμ : ∀ p, 0 ≤ μ p) (stores promotions : Finset (Fin t))
    {eligible : Finset (Fin N)} (e : promotions ↪ ↥eligible)
    (fresh : UnrestrictedFreshLabels P promotions) :
    0 ≤ unrestrictedEdgeEventMass source old seed transport hit μ ρ V stores promotions e fresh := by
  unfold unrestrictedEdgeEventMass
  exact mul_nonneg (div_nonneg (mul_nonneg (pow_nonneg hρ _) (pow_nonneg hρ _))
    (pow_nonneg hV _)) (unrestrictedFreshWeight_nonneg μ promotions hμ fresh)

theorem unrestrictedEdgeEventMass_le {P Z : Type*} {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (seed : P → Z) (transport : Z → Z)
    (hit : Z → Prop) (μ : P → ℝ) {ρ V : ℝ} (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1)
    (hV : 0 ≤ V) (hμ : ∀ p, 0 ≤ μ p) (stores promotions : Finset (Fin t))
    {eligible : Finset (Fin N)} (e : promotions ↪ ↥eligible)
    (heligible : ∀ j ∈ eligible, hit (transport (old j)))
    (fresh : UnrestrictedFreshLabels P promotions) :
    unrestrictedEdgeEventMass source old seed transport hit μ ρ V stores promotions e fresh ≤
      (ρ ^ (eligible.card - promotions.card) / V ^ promotions.card) *
        unrestrictedFreshWeight μ promotions fresh := by
  unfold unrestrictedEdgeEventMass unrestrictedEdgeOutput
  apply mul_le_mul_of_nonneg_right _ (unrestrictedFreshWeight_nonneg μ promotions hμ fresh)
  apply div_le_div_of_nonneg_right _ (pow_nonneg hV _)
  simpa only [Fintype.card_coe] using unrestrictedEdgeMemory_two_damping_le old transport
    (unrestrictedStoredTuple source seed stores) hit e heligible hρ0 hρ1

noncomputable def unrestrictedEdgeChoiceRowMass {P Z : Type*} [Fintype P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (seed : P → Z) (transport : Z → Z)
    (hit : Z → Prop) (μ : P → ℝ) (ρ V v : ℝ) (eligible : Finset (Fin N))
    (stores promotions : Finset (Fin t)) : ℝ :=
  ∑ e : promotions ↪ ↥eligible, ∑ fresh : UnrestrictedFreshLabels P promotions,
    unrestrictedEdgeEventMass source old seed transport hit μ ρ V stores promotions e fresh *
      v ^ (unrestrictedEdgeOutput source old seed transport stores promotions e).1

theorem unrestricted_edge_choice_row_mass_le {P Z : Type*} [Fintype P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (seed : P → Z) (transport : Z → Z)
    (hit : Z → Prop) (μ : P → ℝ) {ρ V v : ℝ} (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1)
    (hV : 0 ≤ V) (hv : 0 < v) (hμ : ∀ p, 0 ≤ μ p) (eligible : Finset (Fin N))
    (heligible : ∀ j ∈ eligible, hit (transport (old j)))
    (stores promotions : Finset (Fin t)) :
    unrestrictedEdgeChoiceRowMass source old seed transport hit μ ρ V v eligible stores promotions ≤
      v ^ N * unrestrictedEdgeChoiceCost ρ v V (∑ p, μ p)
        eligible.card t promotions.card stores.card := by
  calc
    _ ≤ ∑ e : promotions ↪ ↥eligible, ∑ fresh : UnrestrictedFreshLabels P promotions,
        (ρ ^ (eligible.card - promotions.card) / V ^ promotions.card) *
          unrestrictedFreshWeight μ promotions fresh *
            (v ^ N * (v ^ stores.card / v ^ promotions.card)) := by
      apply sum_le_sum
      intro e he
      apply sum_le_sum
      intro fresh hf
      have hout : v ^ (unrestrictedEdgeOutput source old seed transport stores promotions e).1 =
          v ^ N * (v ^ stores.card / v ^ promotions.card) := by
        simpa only [unrestrictedEdgeOutput, Fintype.card_coe] using
          unrestrictedEdgeMemory_weight old transport (unrestrictedStoredTuple source seed stores) e
            (ne_of_gt hv)
      rw [← hout]
      exact mul_le_mul_of_nonneg_right
        (unrestrictedEdgeEventMass_le source old seed transport hit μ hρ0 hρ1 hV hμ stores promotions
          e heligible fresh) (pow_nonneg hv.le _)
    _ = _ := by
      simp_rw [← sum_mul, ← mul_sum]
      simp_rw [unrestricted_fresh_mass_eq μ promotions]
      simp only [Fintype.card_fin, sum_const, card_univ, nsmul_eq_mul,
        promotionChoice_card, Fintype.card_coe]
      unfold unrestrictedEdgeChoiceCost
      ring

noncomputable def unrestrictedEdgeRowMass {P Z : Type*} [Fintype P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (seed : P → Z) (transport : Z → Z)
    (hit : Z → Prop) (μ : P → ℝ) (ρ V v : ℝ) (eligible : Finset (Fin N)) : ℝ :=
  ∑ stores : Finset (Fin t), ∑ promotions : Finset (Fin t),
    unrestrictedEdgeChoiceRowMass source old seed transport hit μ ρ V v eligible stores promotions

theorem unrestricted_edge_row_mass_le_cost {P Z : Type*} [Fintype P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (seed : P → Z) (transport : Z → Z)
    (hit : Z → Prop) (μ : P → ℝ) {ρ V v : ℝ} (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1)
    (hV : 0 ≤ V) (hv : 0 < v) (hμ : ∀ p, 0 ≤ μ p) (eligible : Finset (Fin N))
    (heligible : ∀ j ∈ eligible, hit (transport (old j))) :
    unrestrictedEdgeRowMass source old seed transport hit μ ρ V v eligible ≤
      v ^ N * unrestrictedEdgeRowCost ρ v V (∑ p, μ p) t (fun _ _ => eligible.card) := by
  unfold unrestrictedEdgeRowMass unrestrictedEdgeRowCost
  simp_rw [mul_sum]
  apply sum_le_sum
  intro stores hs
  apply sum_le_sum
  intro promotions hp
  exact unrestricted_edge_choice_row_mass_le source old seed transport hit μ hρ0 hρ1 hV hv hμ
    eligible heligible stores promotions

theorem unrestricted_edge_row_mass_le {P Z : Type*} [Fintype P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (seed : P → Z) (transport : Z → Z)
    (hit : Z → Prop) (μ : P → ℝ) {ρ V v vmin : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1)
    (hv : 1 < v) (hvmin : 0 < vmin) (hV : vmin ≤ V) (hμ : ∀ p, 0 ≤ μ p)
    (hmass : ∑ p, μ p ≤ 2) (eligible : Finset (Fin N))
    (heligible : ∀ j ∈ eligible, hit (transport (old j))) (T : ℕ) (ht : t ≤ T) :
    unrestrictedEdgeRowMass source old seed transport hit μ ρ V v eligible ≤
      v ^ N * unrestrictedEdgeRowBound ρ v vmin T := by
  have hv0 : 0 < v := zero_lt_one.trans hv
  exact (unrestricted_edge_row_mass_le_cost source old seed transport hit μ hρ0.le hρ1.le
    (hvmin.trans_le hV).le hv0 hμ eligible heligible).trans
      (mul_le_mul_of_nonneg_left
        (unrestricted_edge_row_cost_le hρ0 hρ1 hv hvmin hV (sum_nonneg fun p _ => hμ p)
          hmass T t ht (fun _ _ => eligible.card)) (pow_nonneg hv0.le _))
end

section
open Finset Classical
noncomputable def unrestrictedEdgeAction {P Z : Type*} [Fintype P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (label : Z → P)
    (seed : P → Z) (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ)
    (ρ V : ℝ) (eligible : Finset (Fin N)) (B : ℕ)
    (phase : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥eligible) → UnrestrictedFreshLabels P promotions → ℂ)
    (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ) : ℂ :=
  ∑ stores : Finset (Fin t), ∑ promotions : Finset (Fin t),
    ∑ e : promotions ↪ ↥eligible, ∑ fresh : UnrestrictedFreshLabels P promotions,
      (unrestrictedEdgeEventMass source old seed transport hit μ ρ V stores promotions e fresh : ℂ) *
        phase stores promotions e fresh *
          (if (unrestrictedEdgeOutput source old seed transport stores promotions e).1 ≤ B then
            F (unrestrictedEdgeTarget old label promotions e fresh)
              (unrestrictedEdgeOutput source old seed transport stores promotions e) else 0)

theorem unrestricted_edge_action_norm_le_row_mass {P Z : Type*} [Fintype P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (label : Z → P)
    (seed : P → Z) (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ)
    {ρ V v C : ℝ} (hρ : 0 ≤ ρ) (hV : 0 ≤ V) (hv : 0 ≤ v) (hC : 0 ≤ C)
    (hμ : ∀ p, 0 ≤ μ p) (eligible : Finset (Fin N)) (B : ℕ)
    (phase : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥eligible) → UnrestrictedFreshLabels P promotions → ℂ)
    (hphase : ∀ stores promotions e fresh, ‖phase stores promotions e fresh‖ ≤ 1)
    (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ)
    (hF : ∀ target memory, memory.1 ≤ B → ‖F target memory‖ ≤ C * v ^ memory.1) :
    ‖unrestrictedEdgeAction source old label seed transport hit μ ρ V eligible B phase F‖ ≤
      C * unrestrictedEdgeRowMass source old seed transport hit μ ρ V v eligible := by
  unfold unrestrictedEdgeAction unrestrictedEdgeRowMass unrestrictedEdgeChoiceRowMass
  simp_rw [mul_sum]
  refine (norm_sum_le _ _).trans (sum_le_sum fun stores _ => ?_)
  refine (norm_sum_le _ _).trans (sum_le_sum fun promotions _ => ?_)
  refine (norm_sum_le _ _).trans (sum_le_sum fun e _ => ?_)
  refine (norm_sum_le _ _).trans (sum_le_sum fun fresh _ => ?_)
  have hm := unrestrictedEdgeEventMass_nonneg source old seed transport hit μ hρ hV hμ
    stores promotions e fresh
  have hf : ‖(if (unrestrictedEdgeOutput source old seed transport stores promotions e).1 ≤ B then
        F (unrestrictedEdgeTarget old label promotions e fresh)
          (unrestrictedEdgeOutput source old seed transport stores promotions e) else 0 : ℂ)‖ ≤
      C * v ^ (unrestrictedEdgeOutput source old seed transport stores promotions e).1 := by
    split_ifs with hout
    · exact hF _ _ hout
    · simpa only [norm_zero] using mul_nonneg hC (pow_nonneg hv _)
  rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hm]
  calc
    _ ≤ (unrestrictedEdgeEventMass source old seed transport hit μ ρ V stores promotions e fresh * 1) *
        (C * v ^ (unrestrictedEdgeOutput source old seed transport stores promotions e).1) :=
      mul_le_mul (mul_le_mul_of_nonneg_left (hphase stores promotions e fresh) hm) hf
        (norm_nonneg _) (by positivity)
    _ = _ := by ring

/-- A cutoff-independent weighted row estimate for the actual event action. -/
theorem unrestricted_edge_action_norm_le {P Z : Type*} [Fintype P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (label : Z → P)
    (seed : P → Z) (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ)
    {ρ V v vmin C : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hV : vmin ≤ V) (hC : 0 ≤ C) (hμ : ∀ p, 0 ≤ μ p)
    (hmass : ∑ p, μ p ≤ 2) (eligible : Finset (Fin N))
    (heligible : ∀ j ∈ eligible, hit (transport (old j))) (B T : ℕ) (ht : t ≤ T)
    (phase : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥eligible) → UnrestrictedFreshLabels P promotions → ℂ)
    (hphase : ∀ stores promotions e fresh, ‖phase stores promotions e fresh‖ ≤ 1)
    (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ)
    (hF : ∀ target memory, memory.1 ≤ B → ‖F target memory‖ ≤ C * v ^ memory.1) :
    ‖unrestrictedEdgeAction source old label seed transport hit μ ρ V eligible B phase F‖ ≤
      C * v ^ N * unrestrictedEdgeRowBound ρ v vmin T := by
  calc
    _ ≤ C * unrestrictedEdgeRowMass source old seed transport hit μ ρ V v eligible :=
      unrestricted_edge_action_norm_le_row_mass source old label seed transport hit μ hρ0.le
        (hvmin.trans_le hV).le (zero_lt_one.trans hv).le hC hμ eligible B phase hphase F hF
    _ ≤ C * (v ^ N * unrestrictedEdgeRowBound ρ v vmin T) :=
      mul_le_mul_of_nonneg_left (unrestricted_edge_row_mass_le source old seed transport hit μ
        hρ0 hρ1 hv hvmin hV hμ hmass eligible heligible T ht) hC
    _ = _ := by ring
end

section
open Finset Classical
def unrestrictedResidueStorageAllowed {P : Type*} {t : ℕ}
    (n : P → ℕ) (D : ℤ) (source : Fin t → P) (stores : Finset (Fin t)) : Prop :=
  ∀ i ∈ stores, ¬ (n (source i) : ℤ) ∣ D

/-- The displacement and dilation are fixed before the target fresh draws.
Storage and promotion both obey the dilation ban; only old indices may be
promoted. A phase can record additional bounded physical multipliers. -/
noncomputable def unrestrictedResidueEdgeAction {P : Type*} [Fintype P] {t N : ℕ}
    (n : P → ℕ) (Δ D : ℤ) (source : Fin t → P)
    (old : Fin N → UnrestrictedResidueParticle n) (μ : P → ℝ)
    (ρ V : ℝ) (B : ℕ)
    (phase : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥(unrestrictedResidueEligible n Δ D old)) →
        UnrestrictedFreshLabels P promotions → ℂ)
    (F : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) : ℂ :=
  unrestrictedEdgeAction source old Sigma.fst (unrestrictedResidueSeed n)
    (unrestrictedResidueTransport n Δ) unrestrictedResidueHit μ ρ V
    (unrestrictedResidueEligible n Δ D old) B
    (fun stores promotions e fresh =>
      if unrestrictedResidueStorageAllowed n D source stores then phase stores promotions e fresh else 0) F

theorem unrestricted_residue_edge_action_norm_le {P : Type*} [Fintype P] {t N : ℕ}
    (n : P → ℕ) (Δ D : ℤ) (source : Fin t → P)
    (old : Fin N → UnrestrictedResidueParticle n) (μ : P → ℝ)
    {ρ V v vmin C : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hV : vmin ≤ V) (hC : 0 ≤ C) (hμ : ∀ p, 0 ≤ μ p)
    (hmass : ∑ p, μ p ≤ 2) (B T : ℕ) (ht : t ≤ T)
    (phase : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥(unrestrictedResidueEligible n Δ D old)) →
        UnrestrictedFreshLabels P promotions → ℂ)
    (hphase : ∀ stores promotions e fresh, ‖phase stores promotions e fresh‖ ≤ 1)
    (F : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (hF : ∀ target memory, memory.1 ≤ B → ‖F target memory‖ ≤ C * v ^ memory.1) :
    ‖unrestrictedResidueEdgeAction n Δ D source old μ ρ V B phase F‖ ≤
      C * v ^ N * unrestrictedEdgeRowBound ρ v vmin T := by
  apply unrestricted_edge_action_norm_le source old Sigma.fst (unrestrictedResidueSeed n)
    (unrestrictedResidueTransport n Δ) unrestrictedResidueHit μ hρ0 hρ1 hv hvmin hV hC hμ hmass
    (unrestrictedResidueEligible n Δ D old) (unrestrictedResidueEligible_translated_hit n Δ D old)
    B T ht _ _ F hF
  intro stores promotions e fresh
  split_ifs
  · exact hphase stores promotions e fresh
  · simp

/-- The actual tilted physical law supplies both nonnegativity and fresh mass
at most two. No extra probabilistic assumption is needed for the row bound. -/
theorem physical_tilted_residue_edge_action_norm_le {G : Type*} {P : G → Finset ℕ}
    (V : G → ℝ) (g : G) (baseline : P g → ℝ)
    (hMass : ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (hbaseline : ∀ p, 1 / 2 ≤ baseline p ∧ baseline p ≤ 1)
    {t N : ℕ} (Δ D : ℤ) (source : Fin t → P g)
    (old : Fin N → UnrestrictedResidueParticle (fun p : P g => p.val))
    {ρ v vmin C : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hV : vmin ≤ V g) (hC : 0 ≤ C)
    (B T : ℕ) (ht : t ≤ T)
    (phase : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥(unrestrictedResidueEligible (fun p : P g => p.val) Δ D old)) →
        UnrestrictedFreshLabels (P g) promotions → ℂ)
    (hphase : ∀ stores promotions e fresh, ‖phase stores promotions e fresh‖ ≤ 1)
    (F : (Fin t → P g) → FiniteOrderedTuple (UnrestrictedResidueParticle (fun p : P g => p.val)) → ℂ)
    (hF : ∀ target memory, memory.1 ≤ B → ‖F target memory‖ ≤ C * v ^ memory.1) :
    ‖unrestrictedResidueEdgeAction (fun p : P g => p.val) Δ D source old
        (tiltedPhysicalBirthLaw V g baseline) ρ (V g) B phase F‖ ≤
      C * v ^ N * unrestrictedEdgeRowBound ρ v vmin T := by
  have hVpos : 0 < V g := hvmin.trans_le hV
  apply unrestricted_residue_edge_action_norm_le _ Δ D source old
    (tiltedPhysicalBirthLaw V g baseline) hρ0 hρ1 hv hvmin hV hC _ _ B T ht phase hphase F hF
  · intro p
    exact tiltedPhysicalBirthLaw_nonneg V g baseline hVpos.le
      (fun q => (by norm_num : (0 : ℝ) ≤ 1 / 2).trans (hbaseline q).1) p
  · exact (tiltedPhysicalBirthLaw_sum_bounds V g baseline hVpos hMass hbaseline).2
end

section
open Finset Classical
/-- Old indices not selected by the ordered retrieval. -/
noncomputable def retrievalSurvivorIndices {a n : ℕ} (e : Fin a ↪ Fin n) :
    Finset (Fin n) := univ \ univ.map e

theorem mem_retrievalSurvivorIndices {a n : ℕ} (e : Fin a ↪ Fin n) (j : Fin n) :
    j ∈ retrievalSurvivorIndices e ↔ j ∉ Set.range e := by
  simp [retrievalSurvivorIndices, Set.mem_range]

theorem retrieval_survivor_card {a n : ℕ} (e : Fin a ↪ Fin n) :
    (retrievalSurvivorIndices e).card = n - a := by
  rw [retrievalSurvivorIndices, card_sdiff_of_subset (subset_univ _)]
  simp

/-- Identify the complement subtype with the existing retained tuple's index set. -/
noncomputable def retrievalSurvivorEquiv {a n : ℕ} (e : Fin a ↪ Fin n) :
    {j : Fin n // j ∉ Set.range e} ≃ Fin (retrievalSurvivorIndices e).card :=
  (Equiv.subtypeEquivRight (fun j => (mem_retrievalSurvivorIndices e j).symm)).trans
    (retrievalSurvivorIndices e).equivFin

theorem retrievalSurvivorEquiv_symm_val {a n : ℕ} (e : Fin a ↪ Fin n)
    (j : Fin (retrievalSurvivorIndices e).card) :
    ((retrievalSurvivorEquiv e).symm j).val =
      (((retrievalSurvivorIndices e).equivFin).symm j).val := rfl

/-- The selected and retained finite coordinates enumerate all old indices. -/
noncomputable def retrievalIndexSplit {a n : ℕ} (e : Fin a ↪ Fin n) :
    Fin a ⊕ Fin (retrievalSurvivorIndices e).card ≃ Fin n :=
  (Equiv.sumCongr (Equiv.refl _) (retrievalSurvivorEquiv e).symm).trans
    (promotionIndexSplit e)

/-- The coordinate split with the retained tuple's precise enumeration. -/
noncomputable def retrievalTupleSplit {a n : ℕ} (e : Fin a ↪ Fin n) (Z : Type*) :
    (Fin n → Z) ≃ (Fin a → Z) × (Fin (retrievalSurvivorIndices e).card → Z) :=
  (Equiv.arrowCongr (retrievalIndexSplit e).symm (Equiv.refl Z)).trans
    (Equiv.sumArrowEquivProdArrow (Fin a) (Fin (retrievalSurvivorIndices e).card) Z)

/-- The product weight splits over selected entries and the retained tuple. -/
theorem ordered_retrieval_weight_split {a n : ℕ} {Z : Type*}
    (e : Fin a ↪ Fin n) (μ : Z → ℝ) (q : Fin n → Z) :
    (∏ j, μ (q j)) = (∏ i, μ (q (e i))) *
      ∏ j, μ (retainedOrderedTuple q (retrievalSurvivorIndices e) j) := by
  have hp := (retrievalIndexSplit e).prod_comp (fun j => μ (q j))
  rw [Fintype.prod_sum_type] at hp
  exact hp.symm

/-- Exact extraction for one injection, initially retaining the survivor-card index. -/
theorem ordered_retrieval_fixed_sum_card {a n : ℕ} {Z : Type*} [Fintype Z]
    (e : Fin a ↪ Fin n) (μ : Z → ℝ)
    (F : (Fin a → Z) → FiniteOrderedTuple Z → ℝ) :
    (∑ q : Fin n → Z, (∏ j, μ (q j)) * F (fun i => q (e i))
      ⟨(retrievalSurvivorIndices e).card,
        retainedOrderedTuple q (retrievalSurvivorIndices e)⟩) =
    ∑ x : Fin a → Z, ∑ u : Fin (retrievalSurvivorIndices e).card → Z,
      ((∏ i, μ (x i)) * ∏ j, μ (u j)) *
        F x ⟨(retrievalSurvivorIndices e).card, u⟩ := by
  let E := retrievalTupleSplit e Z
  let H : (Fin a → Z) × (Fin (retrievalSurvivorIndices e).card → Z) → ℝ :=
    fun v => ((∏ i, μ (v.1 i)) * ∏ j, μ (v.2 j)) *
      F v.1 ⟨(retrievalSurvivorIndices e).card, v.2⟩
  calc
    _ = ∑ q : Fin n → Z, H (E q) := by
      apply sum_congr rfl
      intro q _
      rw [ordered_retrieval_weight_split e μ q]
      rfl
    _ = ∑ v, H v := E.sum_comp H
    _ = _ := Fintype.sum_prod_type H

/-- Fixed ordered retrieval leaves exactly `n-a` survivor coordinates. -/
theorem ordered_retrieval_fixed_sum {a n : ℕ} {Z : Type*} [Fintype Z]
    (e : Fin a ↪ Fin n) (μ : Z → ℝ)
    (F : (Fin a → Z) → FiniteOrderedTuple Z → ℝ) :
    (∑ q : Fin n → Z, (∏ j, μ (q j)) * F (fun i => q (e i))
      ⟨(retrievalSurvivorIndices e).card,
        retainedOrderedTuple q (retrievalSurvivorIndices e)⟩) =
    ∑ x : Fin a → Z, ∑ u : Fin (n - a) → Z,
      ((∏ i, μ (x i)) * ∏ j, μ (u j)) * F x ⟨n - a, u⟩ := by
  rw [ordered_retrieval_fixed_sum_card]
  let H (k : ℕ) := ∑ x : Fin a → Z, ∑ u : Fin k → Z,
    ((∏ i, μ (x i)) * ∏ j, μ (u j)) * F x ⟨k, u⟩
  change H (retrievalSurvivorIndices e).card = H (n - a)
  exact congrArg H (retrieval_survivor_card e)

/-- Summing all ordered retrieval choices gives the descending factorial.
No distinctness of numerical labels or symmetry of the test is required. -/
theorem ordered_retrieval_sum {a n : ℕ} {Z : Type*} [Fintype Z]
    (μ : Z → ℝ) (F : (Fin a → Z) → FiniteOrderedTuple Z → ℝ) :
    (∑ e : Fin a ↪ Fin n, ∑ q : Fin n → Z,
      (∏ j, μ (q j)) * F (fun i => q (e i))
        ⟨(retrievalSurvivorIndices e).card,
          retainedOrderedTuple q (retrievalSurvivorIndices e)⟩) =
    (n.descFactorial a : ℝ) *
      ∑ x : Fin a → Z, ∑ u : Fin (n - a) → Z,
        ((∏ i, μ (x i)) * ∏ j, μ (u j)) * F x ⟨n - a, u⟩ := by
  simp_rw [ordered_retrieval_fixed_sum]
  simp [Fintype.card_embedding_eq, nsmul_eq_mul]

/-- The full old-memory factorial cancels ordered retrieval multiplicity,
leaving exactly the factorial of the surviving old coordinates. -/
theorem ordered_retrieval_normalized_sum {a n : ℕ} {Z : Type*} [Fintype Z]
    (ha : a ≤ n) (μ : Z → ℝ)
    (F : (Fin a → Z) → FiniteOrderedTuple Z → ℝ) :
    (∑ e : Fin a ↪ Fin n, ∑ q : Fin n → Z,
      (∏ j, μ (q j)) * F (fun i => q (e i))
        ⟨(retrievalSurvivorIndices e).card,
          retainedOrderedTuple q (retrievalSurvivorIndices e)⟩) / (n.factorial : ℝ) =
    (1 / ((n - a).factorial : ℝ)) *
      ∑ x : Fin a → Z, ∑ u : Fin (n - a) → Z,
        ((∏ i, μ (x i)) * ∏ j, μ (u j)) * F x ⟨n - a, u⟩ := by
  rw [ordered_retrieval_sum, mul_div_right_comm, ordered_retrieval_factorial ha]
end

section
open Finset Classical
def unrestrictedJointInput {P : Type*} {k a : ℕ} (n : P → ℕ) (Δ : ℤ)
    (u : Fin k → UnrestrictedResidueParticle n) (p : Fin a → P) :
    FiniteOrderedTuple (UnrestrictedResidueParticle n) :=
  ⟨k + a, Fin.addCases u (fun i => ⟨p i, (Δ : ZMod (n (p i)))⟩)⟩

def unrestrictedJointOutput {P : Type*} {k b : ℕ} (n : P → ℕ) (Δ : ℤ)
    (u : Fin k → UnrestrictedResidueParticle n) (s : Fin b → P) :
    FiniteOrderedTuple (UnrestrictedResidueParticle n) :=
  unrestrictedJointInput n (-Δ) (unrestrictedResidueTransport n Δ ∘ u) s

theorem unrestricted_joint_reverse_input {P : Type*} {k b : ℕ} (n : P → ℕ) (Δ : ℤ)
    (u : Fin k → UnrestrictedResidueParticle n) (s : Fin b → P) :
    unrestrictedJointInput n (-Δ) (unrestrictedResidueTransport n Δ ∘ u) s =
      unrestrictedJointOutput n Δ u s := rfl

theorem unrestricted_joint_reverse_output {P : Type*} {k a : ℕ} (n : P → ℕ) (Δ : ℤ)
    (u : Fin k → UnrestrictedResidueParticle n) (p : Fin a → P) :
    unrestrictedJointOutput n (-Δ) (unrestrictedResidueTransport n Δ ∘ u) p =
      unrestrictedJointInput n Δ u p := by
  have hback : unrestrictedResidueTransport n (-Δ) ∘ (unrestrictedResidueTransport n Δ ∘ u) = u := by
    funext j
    change unrestrictedResidueTransport n (-Δ) (unrestrictedResidueTransport n Δ (u j)) = u j
    rw [← unrestrictedResidueTransport_symm]
    exact (unrestrictedResidueTransport n Δ).symm_apply_apply (u j)
  simp only [unrestrictedJointOutput, neg_neg, hback]

noncomputable def unrestrictedJointIntegral {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ : ℤ) (k a b : ℕ)
    (F : (Fin a → P) → (Fin b → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) : ℂ :=
  ∑ u : Fin k → UnrestrictedResidueParticle n, ∑ p : Fin a → P, ∑ s : Fin b → P,
    (((∏ j, unrestrictedResidueWeight μ (u j)) * (∏ i, μ (p i)) * (∏ i, μ (s i)) /
      (k.factorial : ℝ) : ℝ) : ℂ) *
        F p s (unrestrictedJointInput n Δ u p) (unrestrictedJointOutput n Δ u s)

/-- Translation preserves each residue counting measure; swapping promoted
and stored label integrations preserves the remaining product measure. -/
theorem unrestricted_joint_integral_reverse {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ : ℤ) (k a b : ℕ)
    (F : (Fin a → P) → (Fin b → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    unrestrictedJointIntegral n μ Δ k a b F =
      unrestrictedJointIntegral n μ (-Δ) k b a (fun s p Y X => F p s X Y) := by
  let E : (Fin k → UnrestrictedResidueParticle n) ≃ (Fin k → UnrestrictedResidueParticle n) :=
    Equiv.piCongrRight (fun _ => unrestrictedResidueTransport n Δ)
  unfold unrestrictedJointIntegral
  conv_rhs => rw [← E.sum_comp]
  apply sum_congr rfl
  intro u hu
  rw [sum_comm]
  apply sum_congr rfl
  intro s hs
  apply sum_congr rfl
  intro p hp
  have hE : E u = unrestrictedResidueTransport n Δ ∘ u := rfl
  rw [hE, unrestricted_joint_reverse_input, unrestricted_joint_reverse_output]
  simp only [Function.comp_apply, unrestrictedResidueWeight_transport]
  congr 1
  congr 1
  ring

theorem unrestricted_joint_integral_smul {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ : ℤ) (k a b : ℕ)
    (c : ℂ)
    (F : (Fin a → P) → (Fin b → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    unrestrictedJointIntegral n μ Δ k a b (fun p s X Y => c * F p s X Y) =
      c * unrestrictedJointIntegral n μ Δ k a b F := by
  unfold unrestrictedJointIntegral
  simp_rw [mul_sum]
  apply sum_congr rfl
  intro u hu
  apply sum_congr rfl
  intro p hp
  apply sum_congr rfl
  intro s hs
  ring

/-- Keeping the original promotion normalization on reversal is exactly the
forward normalization for b promotions times V^b/V^a. -/
theorem unrestricted_joint_normalized_reverse {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ : ℤ) (k a b : ℕ)
    {V : ℝ} (hV : V ≠ 0)
    (F : (Fin a → P) → (Fin b → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    ((1 / V ^ a : ℝ) : ℂ) * unrestrictedJointIntegral n μ Δ k a b F =
      ((V ^ b / V ^ a : ℝ) : ℂ) * (((1 / V ^ b : ℝ) : ℂ) *
        unrestrictedJointIntegral n μ (-Δ) k b a (fun s p Y X => F p s X Y)) := by
  rw [unrestricted_joint_integral_reverse n μ Δ k a b F]
  have hratio : (1 / V ^ a : ℝ) = (V ^ b / V ^ a) * (1 / V ^ b) := by field_simp
  rw [hratio, Complex.ofReal_mul, mul_assoc]
end

section
open Finset Classical
/-- Exact one-particle selection, with real weights and an arbitrary additive
target carrying real scalar multiplication (in particular, real or complex). -/
theorem unrestricted_residue_selection_sum {P E : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] [AddCommMonoid E] [SMul ℝ E]
    (μ : P → ℝ) (Δ : ℤ) (ban : P → Prop)
    (F : UnrestrictedResidueParticle n → E) :
    (∑ z : UnrestrictedResidueParticle n,
      if unrestrictedResidueHit (unrestrictedResidueTransport n Δ z) ∧ ban z.1
      then unrestrictedResidueWeight μ z • F z else 0) =
      ∑ p : P, if ban p then μ p • F ⟨p, (Δ : ZMod (n p))⟩ else 0 := by
  rw [Fintype.sum_sigma]
  apply Finset.sum_congr rfl
  intro p hp
  simp_rw [unrestrictedResidueTransport_hit_iff]
  by_cases hb : ban p
  · simp only [hb, and_true, if_true, unrestrictedResidueWeight]
    exact Fintype.sum_ite_eq' (Δ : ZMod (n p)) (fun r => μ p • F ⟨p, r⟩)
  · simp [hb]

/-- Joint selection leaves exactly one residue tuple for every label tuple.
The sum is over all label functions, without any distinctness condition. -/
theorem unrestricted_residue_tuple_selection_sum {P E : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] [AddCommMonoid E] [SMul ℝ E]
    (μ : P → ℝ) (Δ : ℤ) (ban : P → Prop) (a : ℕ)
    (F : (Fin a → UnrestrictedResidueParticle n) → E) :
    (∑ q : Fin a → UnrestrictedResidueParticle n,
      if ∀ i, unrestrictedResidueHit (unrestrictedResidueTransport n Δ (q i)) ∧
          ban (q i).1
      then (∏ i, unrestrictedResidueWeight μ (q i)) • F q else 0) =
      ∑ p : Fin a → P, if ∀ i, ban (p i)
        then (∏ i, μ (p i)) • F (fun i => ⟨p i, (Δ : ZMod (n (p i)))⟩)
        else 0 := by
  have hrestore (q : Fin a → UnrestrictedResidueParticle n)
      (hq : ∀ i, unrestrictedResidueHit (unrestrictedResidueTransport n Δ (q i)) ∧
        ban (q i).1) :
      (fun i => (⟨(q i).1, (Δ : ZMod (n (q i).1))⟩ :
        UnrestrictedResidueParticle n)) = q := by
    funext i
    have hi := (unrestrictedResidueTransport_hit_iff n Δ (q i)).mp (hq i).1
    calc
      (⟨(q i).1, (Δ : ZMod (n (q i).1))⟩ : UnrestrictedResidueParticle n) =
          ⟨(q i).1, (q i).2⟩ := congrArg (Sigma.mk (q i).1) hi.symm
      _ = q i := Sigma.eta _
  rw [← Finset.sum_filter, ← Finset.sum_filter]
  apply Finset.sum_bij (fun q _ i => (q i).1)
  · intro q hq
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hq ⊢
    exact fun i => (hq i).2
  · intro q hq q' hq' hqq'
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hq hq'
    rw [← hrestore q hq, ← hrestore q' hq']
    exact congrArg (fun p : Fin a → P => fun i =>
      (⟨p i, (Δ : ZMod (n (p i)))⟩ : UnrestrictedResidueParticle n)) hqq'
  · intro p hp
    refine ⟨fun i => ⟨p i, (Δ : ZMod (n (p i)))⟩, ?_, rfl⟩
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hp ⊢
    intro i
    exact ⟨(unrestrictedResidueTransport_hit_iff n Δ _).mpr rfl, hp i⟩
  · intro q hq
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hq
    change (∏ i, μ (q i).1) • F q =
      (∏ i, μ (q i).1) • F (fun i => ⟨(q i).1, (Δ : ZMod (n (q i).1))⟩)
    rw [hrestore q hq]
end

section
open Finset Classical
/-- Reconstruct the source tuple from its retained and selected coordinates. -/
def retrievalSourceTuple {a : ℕ} {Z : Type*} (x : Fin a → Z)
    (u : FiniteOrderedTuple Z) : FiniteOrderedTuple Z :=
  ⟨u.1 + a, Fin.addCases u.2 x⟩

theorem symmetric_ordered_tuple_reindex {Z K : Type*}
    (H : FiniteOrderedTuple Z → K) (hH : OrderedTupleSymmetric H)
    {m n : ℕ} (q : Fin n → Z) (E : Fin m ≃ Fin n) :
    H ⟨m, q ∘ E⟩ = H ⟨n, q⟩ := by
  have hmn : m = n := by simpa using Fintype.card_congr E
  subst m
  exact hH n q E

/-- Symmetry identifies the original source with retained entries followed by
the selected entries, using the existing retained-tuple enumeration. -/
theorem symmetric_retrieval_source {a n : ℕ} {Z K : Type*}
    (H : FiniteOrderedTuple Z → K) (hH : OrderedTupleSymmetric H)
    (e : Fin a ↪ Fin n) (q : Fin n → Z) :
    H ⟨n, q⟩ = H (retrievalSourceTuple (fun i => q (e i))
      ⟨(retrievalSurvivorIndices e).card,
        retainedOrderedTuple q (retrievalSurvivorIndices e)⟩) := by
  let E : Fin ((retrievalSurvivorIndices e).card + a) ≃ Fin n :=
    (finSumFinEquiv.symm.trans (Equiv.sumComm _ _)).trans (retrievalIndexSplit e)
  have hq : q ∘ E = Fin.addCases
      (retainedOrderedTuple q (retrievalSurvivorIndices e)) (fun i => q (e i)) := by
    funext j
    refine Fin.addCases (fun i => ?_) (fun i => ?_) j
    · simp only [Function.comp_apply, E, Equiv.trans_apply,
        finSumFinEquiv_symm_apply_castAdd, Equiv.sumComm_apply, Fin.addCases_left]
      rfl
    · simp only [Function.comp_apply, E, Equiv.trans_apply,
        finSumFinEquiv_symm_apply_natAdd, Equiv.sumComm_apply, Fin.addCases_right]
      rfl
  have hs := symmetric_ordered_tuple_reindex H hH q E
  rw [hq] at hs
  exact hs.symm

/-- Complex-valued ordered extraction with exact factorial normalization. -/
theorem ordered_retrieval_normalized_sum_complex {a n : ℕ} {Z : Type*} [Fintype Z]
    (ha : a ≤ n) (μ : Z → ℝ)
    (F : (Fin a → Z) → FiniteOrderedTuple Z → ℂ) :
    (∑ e : Fin a ↪ Fin n, ∑ q : Fin n → Z,
      ((∏ j, μ (q j) : ℝ) : ℂ) * F (fun i => q (e i))
        ⟨(retrievalSurvivorIndices e).card,
          retainedOrderedTuple q (retrievalSurvivorIndices e)⟩) /
      ((n.factorial : ℝ) : ℂ) =
    (((1 / ((n - a).factorial : ℝ)) : ℝ) : ℂ) *
      ∑ x : Fin a → Z, ∑ u : Fin (n - a) → Z,
        ((((∏ i, μ (x i)) * ∏ j, μ (u j)) : ℝ) : ℂ) * F x ⟨n - a, u⟩ := by
  apply Complex.ext
  · simpa only [Complex.re_sum, Complex.div_ofReal_re, Complex.mul_re,
      Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero] using
      ordered_retrieval_normalized_sum ha μ (fun x u => (F x u).re)
  · simpa only [Complex.im_sum, Complex.div_ofReal_im, Complex.mul_im,
      Complex.ofReal_re, Complex.ofReal_im, zero_mul, add_zero] using
      ordered_retrieval_normalized_sum ha μ (fun x u => (F x u).im)

/-- A symmetric test of the actual original source can be retained inside
normalized extraction. All selected-label conditions may be included in `F`. -/
theorem ordered_retrieval_source_normalized_sum_complex
    {a n : ℕ} {Z : Type*} [Fintype Z] (ha : a ≤ n) (μ : Z → ℝ)
    (H : FiniteOrderedTuple Z → ℂ) (hH : OrderedTupleSymmetric H)
    (F : (Fin a → Z) → FiniteOrderedTuple Z → ℂ) :
    (∑ e : Fin a ↪ Fin n, ∑ q : Fin n → Z,
      ((∏ j, μ (q j) : ℝ) : ℂ) * (H ⟨n, q⟩ * F (fun i => q (e i))
        ⟨(retrievalSurvivorIndices e).card,
          retainedOrderedTuple q (retrievalSurvivorIndices e)⟩)) /
      ((n.factorial : ℝ) : ℂ) =
    (((1 / ((n - a).factorial : ℝ)) : ℝ) : ℂ) *
      ∑ x : Fin a → Z, ∑ u : Fin (n - a) → Z,
        ((((∏ i, μ (x i)) * ∏ j, μ (u j)) : ℝ) : ℂ) *
          (H (retrievalSourceTuple x ⟨n - a, u⟩) * F x ⟨n - a, u⟩) := by
  rw [← ordered_retrieval_normalized_sum_complex ha μ
    (fun x u => H (retrievalSourceTuple x u) * F x u)]
  congr 1
  apply sum_congr rfl
  intro e _
  apply sum_congr rfl
  intro q _
  rw [symmetric_retrieval_source H hH e q]

/-- The integrand may depend jointly on selected labels, the entire source,
and survivors, provided its source dependence is symmetric. -/
theorem ordered_retrieval_symmetric_normalized_sum_complex
    {a n : ℕ} {Z : Type*} [Fintype Z] (ha : a ≤ n) (μ : Z → ℝ)
    (F : (Fin a → Z) → FiniteOrderedTuple Z → FiniteOrderedTuple Z → ℂ)
    (hF : ∀ x u, OrderedTupleSymmetric (fun source => F x source u)) :
    (∑ e : Fin a ↪ Fin n, ∑ q : Fin n → Z,
      ((∏ j, μ (q j) : ℝ) : ℂ) * F (fun i => q (e i)) ⟨n, q⟩
        ⟨(retrievalSurvivorIndices e).card,
          retainedOrderedTuple q (retrievalSurvivorIndices e)⟩) /
      ((n.factorial : ℝ) : ℂ) =
    (((1 / ((n - a).factorial : ℝ)) : ℝ) : ℂ) *
      ∑ x : Fin a → Z, ∑ u : Fin (n - a) → Z,
        ((((∏ i, μ (x i)) * ∏ j, μ (u j)) : ℝ) : ℂ) *
          F x (retrievalSourceTuple x ⟨n - a, u⟩) ⟨n - a, u⟩ := by
  rw [← ordered_retrieval_normalized_sum_complex ha μ
    (fun x u => F x (retrievalSourceTuple x u) u)]
  congr 1
  apply sum_congr rfl
  intro e _
  apply sum_congr rfl
  intro q _
  congr 1
  exact symmetric_retrieval_source _ (hF _ _) e q
end

section
open Finset Classical
theorem unrestricted_active_weight_split {I P : Type*} [Fintype I] [DecidableEq I]
    (μ : P → ℝ) (S : Finset I) (x : I → P) :
    (∏ i : I, μ (x i)) =
      (∏ i : S, μ (x i)) * unrestrictedFreshWeight μ S (fun i => x i) := by
  let e : S ⊕ {i : I // i ∉ S} ≃ I := Equiv.sumCompl (fun i => i ∈ S)
  have h := e.prod_comp (fun i => μ (x i))
  rw [Fintype.prod_sum_type] at h
  exact h.symm

/-- Splitting the source active product measure into stored and complementary
labels is an exact finite-sum reindexing, valid for real and complex outputs. -/
theorem unrestricted_active_sum_split {I P E : Type*} [Fintype I] [DecidableEq I]
    [Fintype P] [AddCommMonoid E] [SMul ℝ E]
    (μ : P → ℝ) (S : Finset I) (F : (I → P) → E) :
    (∑ x : I → P, (∏ i : I, μ (x i)) • F x) =
      ∑ s : S → P, ∑ d : UnrestrictedFreshLabels P S,
        ((∏ i : S, μ (s i)) * unrestrictedFreshWeight μ S d) •
          F (unrestrictedTargetLabels S s d) := by
  let e := Equiv.piEquivPiSubtypeProd (fun i : I => i ∈ S) (fun _ => P)
  let G : (S → P) × UnrestrictedFreshLabels P S → E := fun y =>
    ((∏ i : S, μ (y.1 i)) * unrestrictedFreshWeight μ S y.2) •
      F (unrestrictedTargetLabels S y.1 y.2)
  have hrestore (x : I → P) :
      unrestrictedTargetLabels S (fun i => x i) (fun i => x i) = x := by
    funext i
    by_cases hi : i ∈ S <;> simp [unrestrictedTargetLabels, hi]
  calc
    _ = ∑ x : I → P, G (e x) := by
      apply Finset.sum_congr rfl
      intro x hx
      change (∏ i : I, μ (x i)) • F x =
        ((∏ i : S, μ (x i)) * unrestrictedFreshWeight μ S (fun i => x i)) •
          F (unrestrictedTargetLabels S (fun i => x i) (fun i => x i))
      rw [unrestricted_active_weight_split μ S x, hrestore x]
    _ = ∑ y, G y := e.sum_comp G
    _ = _ := Fintype.sum_prod_type G

/-- Index stored labels in the canonical finite order used by the ordered
memory operations. The product measure is unchanged by this reindexing. -/
theorem unrestricted_store_sum_equivFin {I P E : Type*} [DecidableEq I]
    [Fintype P] [AddCommMonoid E] [SMul ℝ E]
    (μ : P → ℝ) (S : Finset I) (F : (S → P) → E) :
    (∑ s : S → P, (∏ i : S, μ (s i)) • F s) =
      ∑ s : Fin S.card → P, (∏ i : Fin S.card, μ (s i)) •
        F (fun i => s (S.equivFin i)) := by
  let e := Equiv.arrowCongr S.equivFin (Equiv.refl P)
  calc
    _ = ∑ s : Fin S.card → P, (∏ i : S, μ (e.symm s i)) • F (e.symm s) :=
      (e.symm.sum_comp (fun s => (∏ i : S, μ (s i)) • F s)).symm
    _ = _ := by
      apply Finset.sum_congr rfl
      intro s hs
      change (∏ i : S, μ (s (S.equivFin i))) • F (fun i => s (S.equivFin i)) = _
      rw [S.equivFin.prod_comp (fun i => μ (s i))]
end

section
open Finset Classical
theorem orderedPredicateCount_permutation {Z : Type*} {N : ℕ}
    (q : Fin N → Z) (hit : Z → Prop) (e : Equiv.Perm (Fin N)) :
    orderedPredicateCount ⟨N, q ∘ e⟩ hit = orderedPredicateCount ⟨N, q⟩ hit :=
  Equiv.sum_comp e (fun j => if hit (q j) then 1 else 0)

noncomputable def orderedDampedCutoffTest {Z : Type*} (hit : Z → Prop)
    (ρ : ℝ) (B : ℕ) (F : FiniteOrderedTuple Z → ℂ) (q : FiniteOrderedTuple Z) : ℂ :=
  if q.1 ≤ B then (ρ ^ orderedPredicateCount q hit : ℝ) * F q else 0

theorem orderedDampedCutoffTest_symmetric {Z : Type*} (hit : Z → Prop)
    (ρ : ℝ) (B : ℕ) (F : FiniteOrderedTuple Z → ℂ) (hF : OrderedTupleSymmetric F) :
    OrderedTupleSymmetric (orderedDampedCutoffTest hit ρ B F) := by
  intro N q e
  simp only [orderedDampedCutoffTest, orderedPredicateCount_permutation, hF N q e]
end

section
open Finset
/-- The literal output index splits into a retained old slot or a birth slot. -/
noncomputable def retainedBirthIndexEquiv {N : ℕ} (s : Finset (Fin N)) (b : ℕ) :
    Fin (s.card + b) ≃ (s ⊕ Fin b) :=
  finSumFinEquiv.symm.trans (Equiv.sumCongr s.equivFin.symm (Equiv.refl _))

theorem retained_birth_index_equiv_left {N b : ℕ} (s : Finset (Fin N))
    (j : Fin s.card) :
    retainedBirthIndexEquiv s b (Fin.castAdd b j) = Sum.inl (s.equivFin.symm j) := by
  simp [retainedBirthIndexEquiv]

theorem retained_birth_index_equiv_right {N b : ℕ} (s : Finset (Fin N))
    (j : Fin b) :
    retainedBirthIndexEquiv s b (Fin.natAdd s.card j) = Sum.inr j := by
  simp [retainedBirthIndexEquiv]

/-- Evaluation of the actual tuple under its explicit sum-index equivalence. -/
theorem retained_birth_tuple_apply_index_equiv {ι : Type*} {N b : ℕ}
    (old : Fin N → ι) (s : Finset (Fin N)) (stored : Fin b → ι)
    (j : Fin (s.card + b)) :
    (retainedBirthTuple old s stored).2 j =
      Sum.elim (fun k : s => old k.val) stored (retainedBirthIndexEquiv s b j) := by
  induction j using Fin.addCases with
  | left j =>
    simp [retainedBirthTuple, retainedOrderedTuple, retained_birth_index_equiv_left]
  | right j =>
    simp [retainedBirthTuple, retained_birth_index_equiv_right]

/-- Conversely, a sum-indexed entry is the corresponding literal tuple entry. -/
theorem retained_birth_tuple_apply_index_equiv_symm {ι : Type*} {N b : ℕ}
    (old : Fin N → ι) (s : Finset (Fin N)) (stored : Fin b → ι)
    (j : s ⊕ Fin b) :
    (retainedBirthTuple old s stored).2 ((retainedBirthIndexEquiv s b).symm j) =
      Sum.elim (fun k : s => old k.val) stored j := by
  rw [retained_birth_tuple_apply_index_equiv, Equiv.apply_symm_apply]

/-- Applying any transport or label map commutes with retaining and appending. -/
theorem retained_birth_tuple_map {ι κ : Type*} {N b : ℕ}
    (map : ι → κ) (old : Fin N → ι) (s : Finset (Fin N)) (stored : Fin b → ι) :
    (retainedBirthTuple (map ∘ old) s (map ∘ stored)).2 =
      map ∘ (retainedBirthTuple old s stored).2 := by
  funext j
  change Fin (s.card + b) at j
  change (retainedBirthTuple (map ∘ old) s (map ∘ stored)).2 j =
    map ((retainedBirthTuple old s stored).2 j)
  rw [retained_birth_tuple_apply_index_equiv]
  simp only [Function.comp_apply, retained_birth_tuple_apply_index_equiv]
  cases retainedBirthIndexEquiv s b j <;> rfl

/-- Distinct old entries and distinct appended entries stay distinct when the
retained old entries and appended entries have disjoint labels. -/
theorem retained_birth_tuple_injective {ι : Type*} {N b : ℕ}
    (old : Fin N → ι) (s : Finset (Fin N)) (stored : Fin b → ι)
    (hold : Function.Injective old) (hstored : Function.Injective stored)
    (hdis : ∀ j ∈ s, ∀ k, old j ≠ stored k) :
    Function.Injective (retainedBirthTuple old s stored).2 := by
  have hsum : Function.Injective (Sum.elim (fun k : s => old k.val) stored) := by
    intro x y hxy
    cases x with
    | inl j =>
      cases y with
      | inl k => exact congrArg Sum.inl (Subtype.ext (hold hxy))
      | inr k => exact (hdis j.val j.property k hxy).elim
    | inr j =>
      cases y with
      | inl k => exact (hdis k.val k.property j hxy.symm).elim
      | inr k => exact congrArg Sum.inr (hstored hxy)
  intro i j hij
  apply (retainedBirthIndexEquiv s b).injective
  apply hsum
  exact (retained_birth_tuple_apply_index_equiv old s stored i).symm.trans
    (hij.trans (retained_birth_tuple_apply_index_equiv old s stored j))

/-- In particular, distinctness concerns the numerical labels even when each
entry also carries a residue or other data. -/
theorem retained_birth_tuple_label_injective {ι P : Type*} {N b : ℕ}
    (label : ι → P) (old : Fin N → ι) (s : Finset (Fin N)) (stored : Fin b → ι)
    (hold : Function.Injective (label ∘ old))
    (hstored : Function.Injective (label ∘ stored))
    (hdis : ∀ j ∈ s, ∀ k, label (old j) ≠ label (stored k)) :
    Function.Injective (label ∘ (retainedBirthTuple old s stored).2) := by
  rw [← retained_birth_tuple_map]
  exact retained_birth_tuple_injective (label ∘ old) s (label ∘ stored) hold hstored hdis
end

section
open Finset
/-- Target slots whose label occurs in the old memory. -/
noncomputable def distinctPromotedTargetSlots {S J P : Type*} [Fintype S]
    [Fintype J] [DecidableEq P] (f : J ↪ P) (t : S ↪ P) : Finset S :=
  univ.filter (fun s => t s ∈ univ.image f)

theorem mem_distinctPromotedTargetSlots {S J P : Type*} [Fintype S]
    [Fintype J] [DecidableEq P] (f : J ↪ P) (t : S ↪ P) (s : S) :
    s ∈ distinctPromotedTargetSlots f t ↔ t s ∈ univ.image f := by
  simp only [distinctPromotedTargetSlots, mem_filter, mem_univ, true_and]

/-- Matching promoted slots and genuinely fresh complementary slots determine
the selected target-slot set itself, not merely its matching injection. -/
theorem distinct_promoted_slots_forced {S J P : Type*} [Fintype S]
    [Fintype J] [DecidableEq P] (f : J ↪ P) (t : S ↪ P)
    (U : Finset S) (e : U ↪ J)
    (hmatch : ∀ s : U, f (e s) = t s.val)
    (hfresh : ∀ s, s ∉ U → t s ∉ univ.image f) :
    U = distinctPromotedTargetSlots f t := by
  ext s
  rw [mem_distinctPromotedTargetSlots]
  constructor
  · intro hs
    exact mem_image.mpr ⟨e ⟨s, hs⟩, mem_univ _, hmatch ⟨s, hs⟩⟩
  · intro hs
    by_contra hn
    exact hfresh s hn hs

/-- The old index required by each canonically selected target slot exists. -/
theorem distinct_promoted_slot_has_old {S J P : Type*} [Fintype S]
    [Fintype J] [DecidableEq P] (f : J ↪ P) (t : S ↪ P)
    (s : distinctPromotedTargetSlots f t) : ∃ j, f j = t s.val := by
  obtain ⟨j, hj, he⟩ := mem_image.mp ((mem_distinctPromotedTargetSlots f t s.val).mp s.property)
  exact ⟨j, he⟩

/-- The unique matching old-index injection for the forced target subset. -/
noncomputable def distinctCanonicalPromotion {S J P : Type*} [Fintype S]
    [Fintype J] [DecidableEq P] (f : J ↪ P) (t : S ↪ P) :
    distinctPromotedTargetSlots f t ↪ J :=
  distinctPromotionEmbedding f (fun s : distinctPromotedTargetSlots f t => t s.val)
    (t.injective.comp Subtype.val_injective) (distinct_promoted_slot_has_old f t)

theorem distinct_canonical_promotion_matches {S J P : Type*} [Fintype S]
    [Fintype J] [DecidableEq P] (f : J ↪ P) (t : S ↪ P)
    (s : distinctPromotedTargetSlots f t) :
    f (distinctCanonicalPromotion f t s) = t s.val :=
  distinct_promotion_embedding_spec f (fun s : distinctPromotedTargetSlots f t => t s.val)
    (t.injective.comp Subtype.val_injective) (distinct_promoted_slot_has_old f t) s

/-- A complete promotion event selects a target subset and an injection from
those ordered slots to old particle indices. -/
abbrev DistinctPromotionEvent (S J : Type*) := Σ U : Finset S, U ↪ J

def DistinctPromotionEventValid {S J P : Type*} [Fintype J] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) (event : DistinctPromotionEvent S J) : Prop :=
  (∀ s : event.1, f (event.2 s) = t s.val) ∧
    ∀ s, s ∉ event.1 → t s ∉ univ.image f

noncomputable def distinctCanonicalPromotionEvent {S J P : Type*} [Fintype S]
    [Fintype J] [DecidableEq P] (f : J ↪ P) (t : S ↪ P) :
    DistinctPromotionEvent S J :=
  ⟨distinctPromotedTargetSlots f t, distinctCanonicalPromotion f t⟩

theorem distinct_canonical_promotion_event_valid {S J P : Type*} [Fintype S]
    [Fintype J] [DecidableEq P] (f : J ↪ P) (t : S ↪ P) :
    DistinctPromotionEventValid f t (distinctCanonicalPromotionEvent f t) := by
  refine ⟨distinct_canonical_promotion_matches f t, ?_⟩
  intro s hs
  exact fun hm => hs ((mem_distinctPromotedTargetSlots f t s).mpr hm)

/-- Both the subset and the matching injection are forced. -/
theorem distinct_promotion_event_unique {S J P : Type*} [Fintype S]
    [Fintype J] [DecidableEq P] (f : J ↪ P) (t : S ↪ P)
    (event : DistinctPromotionEvent S J) (he : DistinctPromotionEventValid f t event) :
    event = distinctCanonicalPromotionEvent f t := by
  rcases event with ⟨U, e⟩
  obtain ⟨hm, hf⟩ := he
  have hU := distinct_promoted_slots_forced f t U e hm hf
  subst U
  have heq : e = distinctCanonicalPromotion f t :=
    distinct_promotion_embedding_unique f
      (fun s : distinctPromotedTargetSlots f t => t s.val) f.injective
      (t.injective.comp Subtype.val_injective) (distinct_promoted_slot_has_old f t) e hm
  rw [heq]
  rfl

/-- The selected OLD indices are exactly those whose label occurs anywhere
in the target tuple, independently of how the event was initially described. -/
theorem distinct_promotion_selected_old_indices {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq J] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) (U : Finset S) (e : U ↪ J)
    (hmatch : ∀ s : U, f (e s) = t s.val)
    (hfresh : ∀ s, s ∉ U → t s ∉ univ.image f) :
    univ.image e = univ.filter (fun j => f j ∈ univ.image t) := by
  ext j
  simp only [mem_filter, mem_univ, true_and]
  constructor
  · intro hj
    obtain ⟨s, hs, rfl⟩ := mem_image.mp hj
    exact mem_image.mpr ⟨s.val, mem_univ _, (hmatch s).symm⟩
  · intro hj
    obtain ⟨s, hs, hsj⟩ := mem_image.mp hj
    have hsU : s ∈ U := by
      by_contra hn
      exact hfresh s hn (mem_image.mpr ⟨j, mem_univ _, hsj.symm⟩)
    refine mem_image.mpr ⟨⟨s, hsU⟩, mem_univ _, ?_⟩
    exact f.injective ((hmatch ⟨s, hsU⟩).trans hsj)

/-- The unselected old indices are precisely the old labels absent from the
target tuple, so deletion agrees with the numerical target support. -/
theorem distinct_promotion_remaining_old_indices {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq J] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) (U : Finset S) (e : U ↪ J)
    (hmatch : ∀ s : U, f (e s) = t s.val)
    (hfresh : ∀ s, s ∉ U → t s ∉ univ.image f) :
    univ \ univ.image e = univ.filter (fun j => f j ∉ univ.image t) := by
  rw [distinct_promotion_selected_old_indices f t U e hmatch hfresh]
  ext j
  simp only [mem_sdiff, mem_filter, mem_univ, true_and]

/-- Every promotion event for these fixed distinct labels whose fresh slots
are outside the old label support. Any global-history restriction is separate. -/
noncomputable def distinctPromotionEvents {S J P : Type*} [Fintype S]
    [Fintype J] [DecidableEq P] (f : J ↪ P) (t : S ↪ P) :
    Finset (DistinctPromotionEvent S J) := by
  classical
  exact univ.filter (DistinctPromotionEventValid f t)

theorem distinct_promotion_events_eq_singleton {S J P : Type*} [Fintype S]
    [Fintype J] [DecidableEq P] (f : J ↪ P) (t : S ↪ P) :
    distinctPromotionEvents f t = {distinctCanonicalPromotionEvent f t} := by
  classical
  ext event
  simp only [distinctPromotionEvents, mem_filter, mem_univ, true_and, mem_singleton]
  constructor
  · exact distinct_promotion_event_unique f t event
  · intro he
    rw [he]
    exact distinct_canonical_promotion_event_valid f t

/-- A coupled test of the entire subset-and-injection event has one term.
There is no factorial divisor or extra choice multiplicity. -/
theorem sum_distinct_promotion_events {S J P M : Type*} [Fintype S]
    [Fintype J] [DecidableEq P] [AddCommMonoid M]
    (f : J ↪ P) (t : S ↪ P) (F : DistinctPromotionEvent S J → M) :
    (∑ event ∈ distinctPromotionEvents f t, F event) =
      F (distinctCanonicalPromotionEvent f t) := by
  rw [distinct_promotion_events_eq_singleton, sum_singleton]

/-- Explicit nested enumeration of all target subsets and all old-index
injections collapses to the same single event after the two validity tests. -/
theorem sum_distinct_promotion_subsets_injections {S J P M : Type*}
    [Fintype S] [Fintype J] [DecidableEq S] [DecidableEq P] [AddCommMonoid M]
    (f : J ↪ P) (t : S ↪ P) (F : DistinctPromotionEvent S J → M) :
    (∑ U : Finset S, ∑ e : U ↪ J,
      if (∀ s : U, f (e s) = t s.val) ∧ (∀ s, s ∉ U → t s ∉ univ.image f)
        then F ⟨U, e⟩ else 0) =
        F (distinctCanonicalPromotionEvent f t) := by
  classical
  have h := sum_distinct_promotion_events f t F
  simp only [distinctPromotionEvents, sum_filter, Fintype.sum_sigma,
    DistinctPromotionEventValid] at h
  refine Eq.trans ?_ h
  apply sum_congr rfl
  intro U hU
  apply sum_congr rfl
  intro e he
  exact congrArg (fun d : Decidable ((∀ s : U, f (e s) = t s.val) ∧
    (∀ s, s ∉ U → t s ∉ univ.image f)) => @ite M _ d (F ⟨U, e⟩) 0)
    (Subsingleton.elim _ _)
end

section
open Finset
/-- Matching an eligible promotion event identifies its selected OLD indices
with precisely the old labels occurring in the full target tuple. -/
theorem distinct_eligible_promotion_selected_indices {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq J] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) (U : Finset S) (Z : Finset J) (e : U ↪ Z)
    (hmatch : ∀ s : U, f (e s).val = t s.val)
    (hfresh : ∀ s, s ∉ U → t s ∉ univ.image f) :
    promotionSelectedIndices e = univ.filter (fun j => f j ∈ univ.image t) := by
  rw [promotionSelectedIndices, map_eq_image]
  exact distinct_promotion_selected_old_indices f t U
    (e.trans ⟨Subtype.val, Subtype.val_injective⟩) hmatch hfresh

/-- For the canonical promoted target subset, the fresh-outside-old condition
is automatic, so only matching and eligibility remain as hypotheses. -/
theorem distinct_canonical_eligible_selected_indices {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq J] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) (Z : Finset J)
    (e : distinctPromotedTargetSlots f t ↪ Z)
    (hmatch : ∀ s : distinctPromotedTargetSlots f t, f (e s).val = t s.val) :
    promotionSelectedIndices e = univ.filter (fun j => f j ∈ univ.image t) := by
  apply distinct_eligible_promotion_selected_indices f t _ Z e hmatch
  intro s hs hm
  exact hs ((mem_distinctPromotedTargetSlots f t s).mpr hm)

/-- The unrestricted deletion set therefore leaves exactly the old indices
whose numerical labels are absent from the target tuple. -/
theorem distinct_canonical_eligible_remaining_indices {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq J] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) (Z : Finset J)
    (e : distinctPromotedTargetSlots f t ↪ Z)
    (hmatch : ∀ s : distinctPromotedTargetSlots f t, f (e s).val = t s.val) :
    univ \ promotionSelectedIndices e =
      univ.filter (fun j => f j ∉ univ.image t) := by
  rw [distinct_canonical_eligible_selected_indices f t Z e hmatch]
  ext j
  simp only [mem_sdiff, mem_filter, mem_univ, true_and]

/-- A matching eligible event certifies that every old label required by the
target actually lies in the eligibility set. -/
theorem distinct_canonical_promotion_required_eligible {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq J] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) (Z : Finset J)
    (e : distinctPromotedTargetSlots f t ↪ Z)
    (hmatch : ∀ s : distinctPromotedTargetSlots f t, f (e s).val = t s.val) :
    univ.filter (fun j => f j ∈ univ.image t) ⊆ Z := by
  rw [← distinct_canonical_eligible_selected_indices f t Z e hmatch]
  exact promotionSelectedIndices_subset e
end

section
open Finset
/-- The literal unrestricted memory is evaluated on retained old slots and
appended storage slots by the retained/birth index equivalence. -/
theorem unrestricted_edge_memory_apply_index {A Z : Type*} [Fintype A] {N b : ℕ}
    (old : Fin N → Z) (transport : Z → Z) (stored : Fin b → Z)
    {eligible : Finset (Fin N)} (e : A ↪ ↥eligible)
    (j : Fin (unrestrictedEdgeMemory old transport stored e).1) :
    (unrestrictedEdgeMemory old transport stored e).2 j =
      Sum.elim (fun k : unrestrictedEdgeSurvivors e => transport (old k.val))
        (transport ∘ stored) (retainedBirthIndexEquiv (unrestrictedEdgeSurvivors e) b j) :=
  retained_birth_tuple_apply_index_equiv (transport ∘ old)
    (unrestrictedEdgeSurvivors e) (transport ∘ stored) j

/-- The source-slot version is the same literal index correspondence. -/
theorem unrestricted_edge_output_apply_index {P Z : Type*} {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (seed : P → Z) (transport : Z → Z)
    (stores promotions : Finset (Fin t)) {eligible : Finset (Fin N)}
    (e : promotions ↪ ↥eligible)
    (j : Fin (unrestrictedEdgeOutput source old seed transport stores promotions e).1) :
    (unrestrictedEdgeOutput source old seed transport stores promotions e).2 j =
      Sum.elim (fun k : unrestrictedEdgeSurvivors e => transport (old k.val))
        (transport ∘ unrestrictedStoredTuple source seed stores)
        (retainedBirthIndexEquiv (unrestrictedEdgeSurvivors e) stores.card j) :=
  unrestricted_edge_memory_apply_index old transport
    (unrestrictedStoredTuple source seed stores) e j

/-- Label-preserving transport keeps a distinct, disjoint old/storage tuple
distinct in the literal unrestricted output. -/
theorem unrestricted_edge_memory_label_injective {A Z P : Type*} [Fintype A]
    {N b : ℕ} (label : Z → P) (old : Fin N → Z) (transport : Z → Z)
    (stored : Fin b → Z) {eligible : Finset (Fin N)} (e : A ↪ ↥eligible)
    (htransport : ∀ z, label (transport z) = label z)
    (hold : Function.Injective (label ∘ old))
    (hstored : Function.Injective (label ∘ stored))
    (hdis : ∀ j ∈ unrestrictedEdgeSurvivors e, ∀ k, label (old j) ≠ label (stored k)) :
    Function.Injective (label ∘ (unrestrictedEdgeMemory old transport stored e).2) := by
  apply retained_birth_tuple_label_injective label (transport ∘ old)
    (unrestrictedEdgeSurvivors e) (transport ∘ stored)
  · simpa only [Function.comp_def, htransport] using hold
  · simpa only [Function.comp_def, htransport] using hstored
  · simpa only [Function.comp_apply, htransport] using hdis

/-- Moving-frame transport for particles with dependent residue types. -/
def unrestrictedPhaseTransport {P : Type*} {R : P → Type*}
    [∀ p, AddGroup (R p)] (delta : (p : P) → R p) (z : Σ p, R p) : Σ p, R p :=
  ⟨z.1, z.2 - delta z.1⟩

/-- Selecting precisely target-active old labels identifies unrestricted
survivors with the old-index subtype used by the phase construction. -/
noncomputable def distinctUnrestrictedSurvivorEquiv {A P : Type*} [Fintype A]
    [Fintype P] {N : ℕ} (atgt : P → Bool) (label : Fin N → P)
    {eligible : Finset (Fin N)} (e : A ↪ ↥eligible)
    (he : ∀ j, j ∈ promotionSelectedIndices e ↔ atgt (label j) = true) :
    unrestrictedEdgeSurvivors e ≃ {j : Fin N // label j ∉ ghostPhaseActivitySupport atgt} where
  toFun j := ⟨j.val, by
    have hj := j.property
    simpa only [unrestrictedEdgeSurvivors, mem_sdiff, mem_univ, true_and,
      he, ghostPhaseActivitySupport, mem_filter, mem_univ, true_and] using hj⟩
  invFun j := ⟨j.val, by
    have hj := j.property
    simpa only [unrestrictedEdgeSurvivors, mem_sdiff, mem_univ, true_and,
      he, ghostPhaseActivitySupport, mem_filter, mem_univ, true_and] using hj⟩
  left_inv _ := rfl
  right_inv _ := rfl

/-- Exact order map from the literal output to phase survivor/storage indices. -/
noncomputable def distinctUnrestrictedIndexEquiv {A P : Type*} [Fintype A]
    [Fintype P] {N : ℕ} (atgt : P → Bool) (label : Fin N → P)
    {eligible : Finset (Fin N)} (e : A ↪ ↥eligible)
    (he : ∀ j, j ∈ promotionSelectedIndices e ↔ atgt (label j) = true) (b : ℕ) :
    Fin ((unrestrictedEdgeSurvivors e).card + b) ≃
      ({j : Fin N // label j ∉ ghostPhaseActivitySupport atgt} ⊕ Fin b) :=
  (retainedBirthIndexEquiv (unrestrictedEdgeSurvivors e) b).trans
    (Equiv.sumCongr (distinctUnrestrictedSurvivorEquiv atgt label e he) (Equiv.refl _))

/-- The literal sigma-valued output equals the existing distinct delete/append
embedding and residue tuple, under the explicit index equivalence. -/
theorem distinct_unrestricted_memory_representation {A P : Type*} [Fintype A]
    [Fintype P] {R : P → Type*} [∀ p, AddGroup (R p)] {N b : ℕ}
    (atgt : P → Bool) (delta : (p : P) → R p)
    (f : Fin N ↪ P) (g : Fin b ↪ P) (hdis : ∀ j k, f j ≠ g k)
    (old : (j : Fin N) → R (f j)) {eligible : Finset (Fin N)} (e : A ↪ ↥eligible)
    (he : ∀ j, j ∈ promotionSelectedIndices e ↔ atgt (f j) = true)
    (j : Fin (unrestrictedEdgeMemory (fun j => (⟨f j, old j⟩ : Σ p, R p))
      (unrestrictedPhaseTransport delta) (fun k => ⟨g k, 0⟩) e).1) :
    let k := distinctUnrestrictedIndexEquiv atgt f e he b j
    (unrestrictedEdgeMemory (fun j => (⟨f j, old j⟩ : Σ p, R p))
      (unrestrictedPhaseTransport delta) (fun k => ⟨g k, 0⟩) e).2 j =
      ⟨distinctSurvivorStorageEmbedding f g (ghostPhaseActivitySupport atgt) hdis k,
        distinctSurvivorStorageResidue f g (ghostPhaseActivitySupport atgt) hdis R
          (fun p r => r - delta p) old (fun k => -delta (g k)) k⟩ := by
  dsimp only
  have hidx : distinctUnrestrictedIndexEquiv atgt f e he b j =
      (Equiv.sumCongr (distinctUnrestrictedSurvivorEquiv atgt f e he) (Equiv.refl (Fin b)))
        (retainedBirthIndexEquiv (unrestrictedEdgeSurvivors e) b j) := rfl
  rw [hidx, unrestricted_edge_memory_apply_index]
  generalize hk : retainedBirthIndexEquiv (unrestrictedEdgeSurvivors e) b j = k
  cases k with
  | inl k => rfl
  | inr k =>
    change (⟨g k, 0 - delta (g k)⟩ : Σ p, R p) = ⟨g k, -delta (g k)⟩
    rw [zero_sub]

section PhaseOutput

variable {A P : Type*} [Fintype A] [Fintype P]
  {R : P → Type*} [∀ p, AddGroup (R p)] {N b : ℕ}
  (atgt asrc store : P → Bool) (delta : (p : P) → R p)
  (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
  (hs : ∀ p, store p = true → atgt p = false ∧ asrc p = true)
  (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
  (g : DistinctOrderedSupport (Fin b) (ghostPhaseChoiceSupport store))
  (old : (j : Fin N) → R (f.val j))
  {eligible : Finset (Fin N)} (e : A ↪ ↥eligible)
  (he : ∀ j, j ∈ promotionSelectedIndices e ↔ atgt (f.val j) = true)

include hw hs

/-- The actual unrestricted output has distinct numerical labels. -/
theorem distinct_unrestricted_memory_label_injective :
    Function.Injective (Sigma.fst ∘
      (unrestrictedEdgeMemory (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
        (unrestrictedPhaseTransport delta) (fun k => ⟨g.val k, 0⟩) e).2) := by
  apply unrestricted_edge_memory_label_injective
  · intro z
    rfl
  · exact f.val.injective
  · exact g.val.injective
  · intro j _ k
    exact distinct_phase_old_storage_disjoint atgt asrc store w hw hs f g j k

include he

/-- The image of the literal unrestricted output labels is exactly the pending
support of the selected moving phase output. -/
theorem distinct_unrestricted_memory_support [DecidableEq P] :
    univ.image (fun j =>
      ((unrestrictedEdgeMemory (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
        (unrestrictedPhaseTransport delta) (fun k => ⟨g.val k, 0⟩) e).2 j).1) =
      ghostPhasePendingSupport (fun p =>
        ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p) (store p) (w p)) := by
  classical
  let hdis := distinct_phase_old_storage_disjoint atgt asrc store w hw hs f g
  let emb := distinctSurvivorStorageEmbedding f.val g.val (ghostPhaseActivitySupport atgt) hdis
  let idx := distinctUnrestrictedIndexEquiv atgt f.val e he b
  have hl (j) :
      ((unrestrictedEdgeMemory (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
        (unrestrictedPhaseTransport delta) (fun k => ⟨g.val k, 0⟩) e).2 j).1 = emb (idx j) :=
    congrArg Sigma.fst
      (distinct_unrestricted_memory_representation atgt delta f.val g.val hdis old e he j)
  calc
    _ = univ.image emb := by
      ext p
      simp only [mem_image, mem_univ, true_and]
      constructor
      · rintro ⟨j, hj⟩
        exact ⟨idx j, (hl j).symm.trans hj⟩
      · rintro ⟨k, hk⟩
        exact ⟨idx.symm k, (hl (idx.symm k)).trans (by simpa only [idx.apply_symm_apply] using hk)⟩
    _ = _ := distinct_phase_moving_embedding_support atgt asrc store delta w hw hs f g hdis

/-- Every literal output particle has exactly its label and residue in the
selected moving phase output, including newly stored particles. -/
theorem distinct_unrestricted_memory_particle
    (hold : ∀ j, w (f.val j) = some (some (some (old j))))
    (j : Fin (unrestrictedEdgeMemory (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
      (unrestrictedPhaseTransport delta) (fun k => ⟨g.val k, 0⟩) e).1) :
    let z := (unrestrictedEdgeMemory (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
      (unrestrictedPhaseTransport delta) (fun k => ⟨g.val k, 0⟩) e).2 j
    ghostPhaseMovingChoiceTarget (atgt z.1) (asrc z.1) (delta z.1) (store z.1) (w z.1) =
      some (some (some z.2)) := by
  let hdis := distinct_phase_old_storage_disjoint atgt asrc store w hw hs f g
  have hv := distinct_unrestricted_memory_representation atgt delta f.val g.val hdis old e he j
  dsimp only
  rw [hv]
  exact distinct_phase_moving_residue atgt asrc store delta w hw hs f g hdis old hold
    (distinctUnrestrictedIndexEquiv atgt f.val e he b j)

end PhaseOutput
end

section
open Finset
/-- Enumerate precisely the selected source slots, retaining their literal
`retainedOrderedTuple` enumeration. -/
noncomputable def distinctUnrestrictedStorageEmbedding {P : Type*} {t : ℕ}
    (source : Fin t ↪ P) (stores : Finset (Fin t)) : Fin stores.card ↪ P where
  toFun k := source (stores.equivFin.symm k).val
  inj' := by
    intro i j hij
    apply stores.equivFin.symm.injective
    exact Subtype.ext (source.injective hij)

/-- The phase storage choice determined by selected source slots. -/
def distinctUnrestrictedStorageChoice {P : Type*} [DecidableEq P] {t : ℕ}
    (source : Fin t ↪ P) (stores : Finset (Fin t)) (p : P) : Bool :=
  decide (p ∈ stores.image source)

theorem distinct_unrestricted_storage_choice_support {P : Type*}
    [Fintype P] [DecidableEq P] {t : ℕ}
    (source : Fin t ↪ P) (stores : Finset (Fin t)) :
    ghostPhaseChoiceSupport (distinctUnrestrictedStorageChoice source stores) =
      stores.image source := by
  ext p
  simp [ghostPhaseChoiceSupport, distinctUnrestrictedStorageChoice]

/-- The selected source enumeration is a distinct ordered enumeration of the
corresponding phase storage support. -/
noncomputable def distinctUnrestrictedStorageSupport {P : Type*}
    [Fintype P] [DecidableEq P] {t : ℕ}
    (source : Fin t ↪ P) (stores : Finset (Fin t)) :
    DistinctOrderedSupport (Fin stores.card)
      (ghostPhaseChoiceSupport (distinctUnrestrictedStorageChoice source stores)) :=
  ⟨distinctUnrestrictedStorageEmbedding source stores, by
    intro p
    rw [distinct_unrestricted_storage_choice_support]
    constructor
    · intro hp
      obtain ⟨j, hj, rfl⟩ := mem_image.mp hp
      refine ⟨stores.equivFin ⟨j, hj⟩, ?_⟩
      change source (stores.equivFin.symm (stores.equivFin ⟨j, hj⟩)).val = source j
      rw [Equiv.symm_apply_apply]
    · rintro ⟨k, rfl⟩
      exact mem_image.mpr ⟨(stores.equivFin.symm k).val,
        (stores.equivFin.symm k).property, rfl⟩⟩

/-- Source-active slots that are target-inactive give an allowed phase choice. -/
theorem distinct_unrestricted_storage_allowed {P : Type*} [DecidableEq P] {t : ℕ}
    (source : Fin t ↪ P) (stores : Finset (Fin t)) (atgt asrc : P → Bool)
    (hsource : ∀ j, asrc (source j) = true)
    (hstores : ∀ j ∈ stores, atgt (source j) = false) :
    ∀ p, distinctUnrestrictedStorageChoice source stores p = true →
      atgt p = false ∧ asrc p = true := by
  intro p hp
  have hp' : p ∈ stores.image source := by
    simpa only [distinctUnrestrictedStorageChoice, decide_eq_true_eq] using hp
  obtain ⟨j, hj, rfl⟩ := mem_image.mp hp'
  exact ⟨hstores j hj, hsource j⟩

/-- The actual stored tuple has the canonical labels and zero source residues. -/
theorem distinct_unrestricted_stored_tuple {P : Type*} {R : P → Type*}
    [∀ p, Zero (R p)] {t : ℕ} (source : Fin t ↪ P) (stores : Finset (Fin t)) :
    unrestrictedStoredTuple source (fun p => (⟨p, 0⟩ : Σ p, R p)) stores =
      fun k => ⟨distinctUnrestrictedStorageEmbedding source stores k, 0⟩ := rfl

/-- Exact equality of the source-slot output and the canonical distinct-storage
memory. This can also be used with transports other than moving frames. -/
theorem distinct_unrestricted_output_eq_memory {P : Type*} {R : P → Type*}
    [∀ p, Zero (R p)] {t N : ℕ} (source : Fin t ↪ P)
    (old : Fin N → Σ p, R p) (transport : (Σ p, R p) → Σ p, R p)
    (stores promotions : Finset (Fin t)) {eligible : Finset (Fin N)}
    (e : promotions ↪ ↥eligible) :
    unrestrictedEdgeOutput source old (fun p => ⟨p, 0⟩) transport stores promotions e =
      unrestrictedEdgeMemory old transport
        (fun k => ⟨distinctUnrestrictedStorageEmbedding source stores k, 0⟩) e := rfl

section ActualOutput

variable {P : Type*} [Fintype P] [DecidableEq P]
  {R : P → Type*} [∀ p, AddGroup (R p)] {t N : ℕ}
  (source : Fin t ↪ P) (stores promotions : Finset (Fin t))
  (atgt asrc : P → Bool) (delta : (p : P) → R p)
  (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
  (hsource : ∀ j, asrc (source j) = true)
  (hstores : ∀ j ∈ stores, atgt (source j) = false)
  (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
  (old : (j : Fin N) → R (f.val j))
  {eligible : Finset (Fin N)} (e : promotions ↪ ↥eligible)
  (he : ∀ j, j ∈ promotionSelectedIndices e ↔ atgt (f.val j) = true)

include hw hsource hstores

/-- The actual source-slot output has distinct numerical labels. -/
theorem distinct_unrestricted_output_label_injective :
    Function.Injective (Sigma.fst ∘
      (unrestrictedEdgeOutput source (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
        (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) stores promotions e).2) := by
  exact distinct_unrestricted_memory_label_injective atgt asrc
    (distinctUnrestrictedStorageChoice source stores) delta w hw
    (distinct_unrestricted_storage_allowed source stores atgt asrc hsource hstores)
    f (distinctUnrestrictedStorageSupport source stores) old e

include he

/-- The actual source-slot output enumerates all and only the selected moving
phase output's pending labels. -/
theorem distinct_unrestricted_output_support :
    univ.image (fun j =>
      ((unrestrictedEdgeOutput source (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
        (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) stores promotions e).2 j).1) =
      ghostPhasePendingSupport (fun p => ghostPhaseMovingChoiceTarget (atgt p) (asrc p)
        (delta p) (distinctUnrestrictedStorageChoice source stores p) (w p)) := by
  exact distinct_unrestricted_memory_support atgt asrc
    (distinctUnrestrictedStorageChoice source stores) delta w hw
    (distinct_unrestricted_storage_allowed source stores atgt asrc hsource hstores)
    f (distinctUnrestrictedStorageSupport source stores) old e he

/-- Every actual source-slot output particle agrees with its moving phase
coordinate, including both transported survivors and newly stored labels. -/
theorem distinct_unrestricted_output_particle
    (hold : ∀ j, w (f.val j) = some (some (some (old j))))
    (j : Fin (unrestrictedEdgeOutput source (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
      (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) stores promotions e).1) :
    let z := (unrestrictedEdgeOutput source (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
      (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) stores promotions e).2 j
    ghostPhaseMovingChoiceTarget (atgt z.1) (asrc z.1) (delta z.1)
      (distinctUnrestrictedStorageChoice source stores z.1) (w z.1) =
      some (some (some z.2)) := by
  exact distinct_unrestricted_memory_particle atgt asrc
    (distinctUnrestrictedStorageChoice source stores) delta w hw
    (distinct_unrestricted_storage_allowed source stores atgt asrc hsource hstores)
    f (distinctUnrestrictedStorageSupport source stores) old e he hold j

end ActualOutput
end

section
open Finset
/-- On slots not canonically promoted, use their fixed target label as fresh. -/
noncomputable def distinctCanonicalFresh {S J P : Type*} [Fintype S] [Fintype J]
    [DecidableEq P] (f : J ↪ P) (t : S ↪ P) :
    UnrestrictedFreshLabels P (distinctPromotedTargetSlots f t) :=
  fun s => t s.val

theorem distinct_canonical_fresh_injective {S J P : Type*} [Fintype S] [Fintype J]
    [DecidableEq P] (f : J ↪ P) (t : S ↪ P) :
    Function.Injective (distinctCanonicalFresh f t) := by
  intro s r hsr
  exact Subtype.ext (t.injective hsr)

theorem distinct_canonical_fresh_outside_old {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq P] (f : J ↪ P) (t : S ↪ P)
    (s : {s : S // s ∉ distinctPromotedTargetSlots f t}) :
    distinctCanonicalFresh f t s ∉ univ.image f := by
  intro hs
  exact s.property ((mem_distinctPromotedTargetSlots f t s.val).mpr hs)

/-- The fresh numerical labels are exactly target labels absent from old memory. -/
theorem distinct_canonical_fresh_image {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq S] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) :
    univ.image (distinctCanonicalFresh f t) = univ.image t \ univ.image f := by
  ext p
  simp only [mem_image, mem_univ, true_and, mem_sdiff]
  constructor
  · rintro ⟨s, rfl⟩
    refine ⟨⟨s.val, rfl⟩, ?_⟩
    simpa only [mem_image, mem_univ, true_and] using
      distinct_canonical_fresh_outside_old f t s
  · rintro ⟨⟨s, rfl⟩, hs⟩
    have hn : s ∉ distinctPromotedTargetSlots f t := by
      rw [mem_distinctPromotedTargetSlots]
      simpa only [mem_image, mem_univ, true_and] using hs
    exact ⟨⟨s, hn⟩, rfl⟩

/-- Promoted numerical labels are exactly the overlap of target and old labels. -/
theorem distinct_canonical_promoted_image {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq P] (f : J ↪ P) (t : S ↪ P) :
    univ.image (fun s : distinctPromotedTargetSlots f t => t s.val) =
      univ.image t ∩ univ.image f := by
  ext p
  simp only [mem_image, mem_univ, true_and, mem_inter]
  constructor
  · rintro ⟨s, rfl⟩
    refine ⟨⟨s.val, rfl⟩, ?_⟩
    simpa only [mem_image, mem_univ, true_and] using
      (mem_distinctPromotedTargetSlots f t s.val).mp s.property
  · rintro ⟨⟨s, rfl⟩, hs⟩
    have hp : s ∈ distinctPromotedTargetSlots f t := by
      rw [mem_distinctPromotedTargetSlots]
      simpa only [mem_image, mem_univ, true_and] using hs
    exact ⟨⟨s, hp⟩, rfl⟩

theorem distinct_canonical_promotion_card {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq P] (f : J ↪ P) (t : S ↪ P) :
    (distinctPromotedTargetSlots f t).card = (univ.image t ∩ univ.image f).card := by
  rw [← distinct_canonical_promoted_image f t,
    card_image_of_injective _ (show Function.Injective
      (fun s : distinctPromotedTargetSlots f t => t s.val) from
        fun a b h => Subtype.ext (t.injective h)), card_univ,
    Fintype.card_coe]

theorem distinct_canonical_fresh_card {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq S] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) :
    Fintype.card {s : S // s ∉ distinctPromotedTargetSlots f t} =
      (univ.image t \ univ.image f).card := by
  rw [← distinct_canonical_fresh_image f t,
    card_image_of_injective _ (distinct_canonical_fresh_injective f t), card_univ]

/-- Matching old values on the canonical promotion slots, together with the
fresh restriction on the complement, reconstruct the entire target tuple. -/
theorem distinct_unrestricted_target_labels {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq S] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) (Z : Finset J)
    (e : distinctPromotedTargetSlots f t ↪ Z)
    (hmatch : ∀ s : distinctPromotedTargetSlots f t, f (e s).val = t s.val) :
    unrestrictedTargetLabels (distinctPromotedTargetSlots f t)
      (fun s => f (e s).val) (distinctCanonicalFresh f t) = t := by
  funext s
  by_cases hs : s ∈ distinctPromotedTargetSlots f t
  · simp only [unrestrictedTargetLabels, dif_pos hs]
    exact hmatch ⟨s, hs⟩
  · simp only [unrestrictedTargetLabels, dif_neg hs, distinctCanonicalFresh]

/-- The actual promoted labels read from eligible old indices have exactly
the target/old overlap as their image. -/
theorem distinct_matched_promoted_image {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq P] (f : J ↪ P) (t : S ↪ P)
    (Z : Finset J) (e : distinctPromotedTargetSlots f t ↪ Z)
    (hmatch : ∀ s : distinctPromotedTargetSlots f t, f (e s).val = t s.val) :
    univ.image (fun s => f (e s).val) = univ.image t ∩ univ.image f := by
  have he : (fun s => f (e s).val) = (fun s : distinctPromotedTargetSlots f t => t s.val) :=
    funext hmatch
  rw [he]
  exact distinct_canonical_promoted_image f t

/-- The target tuple generated by the literal unrestricted edge is the given
fixed target, when its old labels and promotion matching agree. -/
theorem distinct_unrestricted_edge_target {P Q : Type*} [DecidableEq P]
    {N n : ℕ} (old : Fin N → Q) (label : Q → P)
    (f : Fin N ↪ P) (hlabel : ∀ j, label (old j) = f j) (t : Fin n ↪ P)
    (eligible : Finset (Fin N)) (e : distinctPromotedTargetSlots f t ↪ eligible)
    (hmatch : ∀ s : distinctPromotedTargetSlots f t, f (e s).val = t s.val) :
    unrestrictedEdgeTarget old label (distinctPromotedTargetSlots f t) e
      (distinctCanonicalFresh f t) = t := by
  unfold unrestrictedEdgeTarget
  have he : (fun s : distinctPromotedTargetSlots f t => label (old (e s).val)) =
      (fun s : distinctPromotedTargetSlots f t => f (e s).val) := by
    funext s
    exact hlabel _
  rw [he]
  exact distinct_unrestricted_target_labels f t eligible e hmatch
end

section
open Finset
/-- A distinct literal particle list representing a phase memory has exactly
the phase memory's number of zero residues. -/
theorem distinct_particle_phase_zero_count {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, Zero (R p)] [∀ p, DecidableEq (R p)]
    (q : FiniteOrderedTuple (Σ p, R p)) (w : (p : P) → GhostPhaseState (R p))
    (hinj : Function.Injective (fun j => (q.2 j).1))
    (hsupport : univ.image (fun j => (q.2 j).1) = ghostPhasePendingSupport w)
    (hvalue : ∀ j, w (q.2 j).1 = some (some (some (q.2 j).2))) :
    orderedPredicateCount q (fun z => z.2 = 0) = (ghostPhaseZeroSet w).card := by
  let f : DistinctOrderedSupport (Fin q.1) (ghostPhasePendingSupport w) :=
    ⟨⟨fun j => (q.2 j).1, hinj⟩, by
      intro p
      rw [← hsupport]
      simp only [mem_image, mem_univ, true_and]
      rfl⟩
  have h := distinct_phase_zero_count f w rfl (fun j => (q.2 j).2) hvalue
  rw [ordered_zero_count_eq_sum] at h
  refine Eq.trans ?_ h
  unfold orderedPredicateCount
  apply sum_congr rfl
  intro j _
  by_cases hz : (q.2 j).2 = 0 <;> simp only [hz, if_true, if_false]

/-- Distinct fresh slots enumerate their label support once. -/
theorem distinct_unrestricted_fresh_weight {I P : Type*}
    [Fintype I] [DecidableEq I] [DecidableEq P]
    (μ : P → ℝ) (T : Finset I) (fresh : UnrestrictedFreshLabels P T)
    (hinj : Function.Injective fresh) (S : Finset P)
    (hS : univ.image fresh = S) :
    unrestrictedFreshWeight μ T fresh = ∏ p ∈ S, μ p := by
  rw [← hS, prod_image]
  · rfl
  · intro i _ j _ hij
    exact hinj hij

/-- The literal unrestricted event mass agrees with the phase endpoint
damping and numerical fresh-label weight on a distinct-label event.
The represented output is the actual unrestrictedEdgeOutput, not a surrogate. -/
theorem distinct_unrestricted_event_mass {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, Zero (R p)] [∀ p, DecidableEq (R p)] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Σ p, R p)
    (seed : P → Σ p, R p) (transport : (Σ p, R p) → Σ p, R p)
    (μ : P → ℝ) (ρ V : ℝ) (stores promotions : Finset (Fin t))
    {eligible : Finset (Fin N)} (e : promotions ↪ ↥eligible)
    (fresh : UnrestrictedFreshLabels P promotions)
    (w z : (p : P) → GhostPhaseState (R p))
    (holdinj : Function.Injective (fun j => (old j).1))
    (houtsinj : Function.Injective (fun j =>
      ((unrestrictedEdgeOutput source old seed transport stores promotions e).2 j).1))
    (holdsupport : univ.image (fun j => (old j).1) = ghostPhasePendingSupport w)
    (houtsupport : univ.image (fun j =>
      ((unrestrictedEdgeOutput source old seed transport stores promotions e).2 j).1) =
        ghostPhasePendingSupport z)
    (holdvalue : ∀ j, w (old j).1 = some (some (some (old j).2)))
    (houtvalue : ∀ j,
      z ((unrestrictedEdgeOutput source old seed transport stores promotions e).2 j).1 =
        some (some (some ((unrestrictedEdgeOutput source old seed transport stores promotions e).2 j).2)))
    (hfresh : Function.Injective fresh) (S : Finset P) (hS : univ.image fresh = S) :
    unrestrictedEdgeEventMass source old seed transport (fun x => x.2 = 0)
      μ ρ V stores promotions e fresh =
        ρ ^ (ghostPhaseZeroSet w).card * ρ ^ (ghostPhaseZeroSet z).card *
          (V⁻¹) ^ promotions.card * ∏ p ∈ S, μ p := by
  unfold unrestrictedEdgeEventMass
  rw [distinct_particle_phase_zero_count ⟨N, old⟩ w holdinj holdsupport holdvalue,
    distinct_particle_phase_zero_count
      (unrestrictedEdgeOutput source old seed transport stores promotions e)
      z houtsinj houtsupport houtvalue,
    distinct_unrestricted_fresh_weight μ promotions fresh hfresh S hS]
  simp only [div_eq_mul_inv, inv_pow]

/-- The phase birth coefficient divided by its group normalization is exactly
the tilted physical label law used by the unrestricted edge. -/
theorem physical_phase_birth_measure {G : Type*} {P : G → Finset ℕ}
    (V : G → ℝ) (g : G) (b : P g → ℝ) (p : P g) :
    (((p.val : ℝ) * b p)⁻¹) / V g = tiltedPhysicalBirthLaw V g b p := by
  simp only [tiltedPhysicalBirthLaw, physicalLabelLaw, div_eq_mul_inv, mul_inv_rev, one_mul]
  ring

/-- No additional reciprocal prime or inverse group mass is inserted when
passing from phase fresh labels to the actual physical fresh integrations. -/
theorem physical_phase_fresh_product {G : Type*} {P : G → Finset ℕ}
    (V : G → ℝ) (g : G) (b : P g → ℝ) (S : Finset (P g)) :
    (∏ p ∈ S, (((p.val : ℝ) * b p)⁻¹) / V g) =
      ∏ p ∈ S, tiltedPhysicalBirthLaw V g b p := by
  apply prod_congr rfl
  intro p _
  exact physical_phase_birth_measure V g b p
end

section
open Finset
theorem distinct_unrestricted_memory_zero_count {A P : Type*}
    [Fintype A] [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)] {N b : ℕ}
    (atgt asrc store : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (hs : ∀ p, store p = true → atgt p = false ∧ asrc p = true)
    (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
    (g : DistinctOrderedSupport (Fin b) (ghostPhaseChoiceSupport store))
    (old : (j : Fin N) → R (f.val j))
    {eligible : Finset (Fin N)} (e : A ↪ ↥eligible)
    (he : ∀ j, j ∈ promotionSelectedIndices e ↔ atgt (f.val j) = true)
    (hold : ∀ j, w (f.val j) = some (some (some (old j)))) :
    orderedPredicateCount
      (unrestrictedEdgeMemory (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
        (unrestrictedPhaseTransport delta) (fun k => ⟨g.val k, 0⟩) e)
      (fun z => z.2 = 0) =
      (ghostPhaseZeroSet (fun p =>
        ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p) (store p) (w p))).card := by
  apply distinct_particle_phase_zero_count
  · exact distinct_unrestricted_memory_label_injective atgt asrc store delta w hw hs f g old e
  · exact distinct_unrestricted_memory_support atgt asrc store delta w hw hs f g old e he
  · exact distinct_unrestricted_memory_particle atgt asrc store delta w hw hs f g old e he hold

/-- Both damping factors of the literal event equal those of the actual
phase edge, including promoted old zeros and newly stored output zeros. -/
theorem distinct_unrestricted_memory_damping {A P : Type*}
    [Fintype A] [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)] {N b : ℕ}
    (atgt asrc store : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (hs : ∀ p, store p = true → atgt p = false ∧ asrc p = true)
    (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
    (g : DistinctOrderedSupport (Fin b) (ghostPhaseChoiceSupport store))
    (old : (j : Fin N) → R (f.val j))
    {eligible : Finset (Fin N)} (e : A ↪ ↥eligible)
    (he : ∀ j, j ∈ promotionSelectedIndices e ↔ atgt (f.val j) = true)
    (hold : ∀ j, w (f.val j) = some (some (some (old j)))) (ρsrc ρtgt : ℝ) :
    ρsrc ^ orderedPredicateCount ⟨N, fun j => (⟨f.val j, old j⟩ : Σ p, R p)⟩
      (fun z => z.2 = 0) *
    ρtgt ^ orderedPredicateCount
      (unrestrictedEdgeMemory (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
        (unrestrictedPhaseTransport delta) (fun k => ⟨g.val k, 0⟩) e)
      (fun z => z.2 = 0) =
    ρsrc ^ (ghostPhaseZeroSet w).card *
      ρtgt ^ (ghostPhaseZeroSet (fun p =>
        ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p) (store p) (w p))).card := by
  rw [distinct_unrestricted_memory_zero_count atgt asrc store delta w hw hs f g old e he hold]
  congr 1
  apply congrArg (fun n : ℕ => ρsrc ^ n)
  apply distinct_particle_phase_zero_count
  · exact f.val.injective
  · exact distinct_ordered_support_image f
  · exact hold
end

section
open Finset
/-- The old labels among entering active slots are precisely promotions. -/
theorem ghost_phase_new_run_pending {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (atgt asrc : P → Bool)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w) :
    ghostPhaseNewRunSet atgt asrc ∩ ghostPhasePendingSupport w =
      ghostPhasePromotionSet atgt w := by
  classical
  ext p
  have hwp := hw p
  cases ht : atgt p <;> cases hs : asrc p <;> rcases hp : w p with _ | (_ | (_ | r)) <;>
    simp_all [ghostPhaseNewRunSet, ghostPhasePromotionSet, ghostPhasePendingSupport,
      ghostPhaseActivitySupport]

/-- The entering active labels outside the old memory are precisely fresh
labels. Compatibility excludes an attempted rebirth of a completed label. -/
theorem ghost_phase_new_run_without_pending {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)]
    (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (hc : ∀ p, ghostPhaseMovingEdgeCompatible (atgt p) (asrc p) (delta p) (w p) = true) :
    ghostPhaseNewRunSet atgt asrc \ ghostPhasePendingSupport w =
      ghostPhaseFreshSet atgt asrc w := by
  classical
  ext p
  have hwp := hw p
  have hcp := hc p
  cases ht : atgt p <;> cases hs : asrc p <;> rcases hp : w p with _ | (_ | (_ | r)) <;>
    simp_all [ghostPhaseNewRunSet, ghostPhasePendingSupport, ghostPhaseFreshSet,
      ghostPhaseEdgeFresh, ghostPhaseMovingEdgeCompatible]
end

section
open Finset
/-- A matching eligible injection selects precisely the target-active old
indices when the target tuple enumerates the newly active labels. -/
theorem distinct_phase_event_selected {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} {N t : ℕ} (atgt asrc : P → Bool)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
    (target : Fin t ↪ P) (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    (eligible : Finset (Fin N)) (e : distinctPromotedTargetSlots f.val target ↪ eligible)
    (hmatch : ∀ s : distinctPromotedTargetSlots f.val target, f.val (e s).val = target s.val) :
    ∀ j, j ∈ promotionSelectedIndices e ↔ atgt (f.val j) = true := by
  rw [distinct_canonical_eligible_selected_indices f.val target eligible e hmatch]
  intro j
  rw [mem_filter, and_iff_right (mem_univ j), htarget]
  have hi := distinct_phase_old_inactive asrc w hw f j
  simp [ghostPhaseNewRunSet, hi]

theorem distinct_phase_event_promotion_card {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} {N t : ℕ} (atgt asrc : P → Bool)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
    (target : Fin t ↪ P) (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc) :
    (distinctPromotedTargetSlots f.val target).card = (ghostPhasePromotionSet atgt w).card := by
  rw [distinct_canonical_promotion_card, htarget, distinct_ordered_support_image f,
    ghost_phase_new_run_pending atgt asrc w hw]

theorem distinct_phase_event_fresh_image {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)] {N t : ℕ}
    (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
    (target : Fin t ↪ P) (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    (hc : ∀ p, ghostPhaseMovingEdgeCompatible (atgt p) (asrc p) (delta p) (w p) = true) :
    univ.image (distinctCanonicalFresh f.val target) = ghostPhaseFreshSet atgt asrc w := by
  rw [distinct_canonical_fresh_image, htarget, distinct_ordered_support_image f,
    ghost_phase_new_run_without_pending atgt asrc delta w hw hc]

/-- On a compatible distinct event, the actual unrestricted event mass equals
the product of actual normalized phase kernels. No output-count or scalar
mass equality is assumed: both follow from the ordered event construction. -/
theorem distinct_unrestricted_phase_event_mass {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    {N t : ℕ} (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (source target : Fin t ↪ P) (stores : Finset (Fin t))
    (hsource : ∀ j, asrc (source j) = true)
    (hstores : ∀ j ∈ stores, atgt (source j) = false)
    (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
    (old : (j : Fin N) → R (f.val j))
    (hold : ∀ j, w (f.val j) = some (some (some (old j))))
    (eligible : Finset (Fin N)) (e : distinctPromotedTargetSlots f.val target ↪ eligible)
    (hmatch : ∀ s : distinctPromotedTargetSlots f.val target, f.val (e s).val = target s.val)
    (hc : ∀ p, ghostPhaseMovingEdgeCompatible (atgt p) (asrc p) (delta p) (w p) = true)
    (β : P → ℝ) (ρ V : ℝ) :
    unrestrictedEdgeEventMass source (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
      (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) (fun z => z.2 = 0)
      (fun p => β p / V) ρ V stores (distinctPromotedTargetSlots f.val target) e
      (distinctCanonicalFresh f.val target) =
        ∏ p, (if atgt p && !(asrc p) then V⁻¹ else 1) *
          ghostPhaseDampedMovingEdge (atgt p) (asrc p) (delta p) (β p) ρ ρ
            (ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p)
              (distinctUnrestrictedStorageChoice source stores p) (w p)) (w p) := by
  have he := distinct_phase_event_selected atgt asrc w hw f target htarget eligible e hmatch
  have hcount := distinct_phase_event_promotion_card atgt asrc w hw f target htarget
  have hfresh := distinct_phase_event_fresh_image atgt asrc delta w hw f target htarget hc
  have hs := distinct_unrestricted_storage_allowed source stores atgt asrc hsource hstores
  have hmass := distinct_unrestricted_event_mass source
    (fun j => (⟨f.val j, old j⟩ : Σ p, R p)) (fun p => ⟨p, 0⟩)
    (unrestrictedPhaseTransport delta) (fun p => β p / V) ρ V stores
    (distinctPromotedTargetSlots f.val target) e (distinctCanonicalFresh f.val target)
    w (fun p => ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p)
      (distinctUnrestrictedStorageChoice source stores p) (w p))
    f.val.injective
    (distinct_unrestricted_output_label_injective source stores _ atgt asrc delta w hw
      hsource hstores f old e)
    (distinct_ordered_support_image f)
    (distinct_unrestricted_output_support source stores _ atgt asrc delta w hw
      hsource hstores f old e he)
    hold
    (distinct_unrestricted_output_particle source stores _ atgt asrc delta w hw
      hsource hstores f old e he hold)
    (distinct_canonical_fresh_injective f.val target) (ghostPhaseFreshSet atgt asrc w) hfresh
  rw [hmass, hcount]
  rw [ghost_phase_run_normalized_edge_fresh_measure atgt asrc
    (distinctUnrestrictedStorageChoice source stores) delta β ρ ρ V w hw hs,
    if_pos hc, mul_one]
end

section
open Finset
/-- The total number of prime factors, counted with multiplicity. -/
noncomputable def primeFactorMultiplicity (n : ℕ) : ℕ :=
  ∑ p ∈ n.primeFactors, n.factorization p

theorem card_divisors_le_two_pow_multiplicity {n : ℕ} (hn : n ≠ 0) :
    n.divisors.card ≤ 2 ^ primeFactorMultiplicity n := by
  rw [Nat.card_divisors hn, primeFactorMultiplicity, ← Finset.prod_pow_eq_pow_sum]
  exact Finset.prod_le_prod₀ (fun _ _ => Nat.zero_le _) (fun p _ =>
    Nat.succ_le_iff.mpr Nat.lt_two_pow_self)

theorem pow_multiplicity_le_of_large_primeFactors {n : ℕ} (hn : n ≠ 0)
    {W : ℝ} (hW : 0 ≤ W) (hlarge : ∀ p ∈ n.primeFactors, W ≤ (p : ℝ)) :
    W ^ primeFactorMultiplicity n ≤ (n : ℝ) := by
  have hnprod : (n : ℝ) = ∏ p ∈ n.primeFactors, (p : ℝ) ^ n.factorization p := by
    exact_mod_cast Nat.prod_primeFactors_pow_factorization hn
  rw [hnprod, primeFactorMultiplicity, ← Finset.prod_pow_eq_pow_sum]
  exact Finset.prod_le_prod₀ (fun _ _ => pow_nonneg hW _) (fun p hp =>
    pow_le_pow_left₀ hW (hlarge p hp) _)

theorem multiplicity_le_log_div_of_large_primeFactors {n : ℕ} (hn : n ≠ 0)
    {W : ℝ} (hW : 1 < W) (hlarge : ∀ p ∈ n.primeFactors, W ≤ (p : ℝ)) :
    (primeFactorMultiplicity n : ℝ) ≤ Real.log n / Real.log W := by
  have hW0 : 0 < W := lt_trans zero_lt_one hW
  have h := Real.log_le_log (pow_pos hW0 _) (pow_multiplicity_le_of_large_primeFactors hn hW0.le hlarge)
  rw [Real.log_pow] at h
  exact (le_div_iff₀ (Real.log_pos hW)).mpr h

theorem card_divisors_le_exp_of_large_primeFactors {n : ℕ} (hn : n ≠ 0)
    {W : ℝ} (hW : 1 < W) (hlarge : ∀ p ∈ n.primeFactors, W ≤ (p : ℝ)) :
    (n.divisors.card : ℝ) ≤ Real.exp (Real.log 2 * Real.log n / Real.log W) := by
  have hm := multiplicity_le_log_div_of_large_primeFactors hn hW hlarge
  have hc : (n.divisors.card : ℝ) ≤ (2 : ℝ) ^ primeFactorMultiplicity n := by
    exact_mod_cast card_divisors_le_two_pow_multiplicity hn
  calc
    _ ≤ (2 : ℝ) ^ primeFactorMultiplicity n := hc
    _ = Real.exp ((primeFactorMultiplicity n : ℝ) * Real.log 2) := by
      rw [Real.exp_nat_mul, Real.exp_log (by norm_num : (0 : ℝ) < 2)]
    _ ≤ Real.exp (Real.log 2 * Real.log n / Real.log W) := by
      apply Real.exp_le_exp.mpr
      have h := mul_le_mul_of_nonneg_left hm (Real.log_pos (by norm_num : (1 : ℝ) < 2)).le
      simpa only [mul_div_assoc, mul_comm (primeFactorMultiplicity n : ℝ) (Real.log 2)] using h

/-- Divisors all of whose prime factors are at least `W`. -/
noncomputable def roughDivisors (W : ℝ) (n : ℕ) : Finset ℕ := by
  classical
  exact n.divisors.filter (fun d => ∀ p ∈ d.primeFactors, W ≤ (p : ℝ))

/-- The full prime-power part of an integer supported on primes at least `W`. -/
noncomputable def roughPrimePart (W : ℝ) (n : ℕ) : ℕ := by
  classical
  exact primePoolPart (n.primeFactors.filter (fun p => W ≤ (p : ℝ))) n

theorem roughPrimePart_ne_zero (W : ℝ) (n : ℕ) : roughPrimePart W n ≠ 0 :=
  primePoolPart_ne_zero _ _

theorem roughPrimePart_dvd (W : ℝ) (n : ℕ) : roughPrimePart W n ∣ n :=
  primePoolPart_dvd _ _

theorem roughPrimePart_primeFactors_large (W : ℝ) (n : ℕ) :
    ∀ p ∈ (roughPrimePart W n).primeFactors, W ≤ (p : ℝ) := by
  classical
  intro p hp
  exact (mem_filter.mp (Nat.primeFactors_subset_of_mem_factoredNumbers
    (primePoolPart_mem_factoredNumbers (n.primeFactors.filter (fun p => W ≤ (p : ℝ))) n) hp)).2

theorem roughDivisors_eq_divisors_roughPrimePart (W : ℝ) {n : ℕ} (hn : n ≠ 0) :
    roughDivisors W n = (roughPrimePart W n).divisors := by
  classical
  ext d
  simp only [roughDivisors, mem_filter, Nat.mem_divisors]
  constructor
  · rintro ⟨⟨hdn, _⟩, hlarge⟩
    have hd0 : d ≠ 0 := by
      intro hd
      subst d
      exact hn (by simpa using hdn)
    refine ⟨(Nat.factorization_le_iff_dvd hd0 (roughPrimePart_ne_zero W n)).mp ?_,
      roughPrimePart_ne_zero W n⟩
    rw [roughPrimePart, factorization_primePoolPart]
    intro p
    by_cases hp : p ∈ n.primeFactors.filter (fun q : ℕ => W ≤ (q : ℝ))
    · rw [Finsupp.filter_apply_pos _ _ hp]
      exact (Nat.factorization_le_iff_dvd hd0 hn).mpr hdn p
    · have hdf : d.factorization p = 0 := by
        apply Finsupp.notMem_support_iff.mp
        intro hpd
        exact hp (mem_filter.mpr ⟨Nat.primeFactors_mono hdn hn hpd, hlarge p hpd⟩)
      rw [Finsupp.filter_apply_neg _ _ hp, hdf]
  · rintro ⟨hd, _⟩
    refine ⟨⟨hd.trans (roughPrimePart_dvd W n), hn⟩, ?_⟩
    intro p hp
    exact roughPrimePart_primeFactors_large W n p
      (Nat.primeFactors_mono hd (roughPrimePart_ne_zero W n) hp)

theorem roughDivisors_card_le_exp_log {W : ℝ} (hW : 1 < W)
    {n : ℕ} (hn : n ≠ 0) :
    ((roughDivisors W n).card : ℝ) ≤ Real.exp (Real.log 2 * Real.log n / Real.log W) := by
  rw [roughDivisors_eq_divisors_roughPrimePart W hn]
  refine (card_divisors_le_exp_of_large_primeFactors (roughPrimePart_ne_zero W n) hW
    (roughPrimePart_primeFactors_large W n)).trans ?_
  apply Real.exp_le_exp.mpr
  apply div_le_div_of_nonneg_right _ (Real.log_pos hW).le
  apply mul_le_mul_of_nonneg_left _ (Real.log_pos (by norm_num : (1 : ℝ) < 2)).le
  apply Real.log_le_log
  · exact_mod_cast Nat.pos_of_ne_zero (roughPrimePart_ne_zero W n)
  · exact_mod_cast Nat.le_of_dvd (Nat.pos_of_ne_zero hn) (roughPrimePart_dvd W n)
end

section
open Finset
theorem roughDivisors_card_le_exp_of_exp_bound {U V : ℝ} (hV : 0 < V)
    {n : ℕ} (hn : n ≠ 0) (hsize : (n : ℝ) ≤ Real.exp U) :
    ((roughDivisors (Real.exp V) n).card : ℝ) ≤ Real.exp (Real.log 2 * U / V) := by
  have h := roughDivisors_card_le_exp_log (W := Real.exp V)
    (by simpa using Real.exp_lt_exp.mpr hV) hn
  rw [Real.log_exp] at h
  refine h.trans (Real.exp_le_exp.mpr ?_)
  apply div_le_div_of_nonneg_right _ hV.le
  apply mul_le_mul_of_nonneg_left _ (Real.log_pos (by norm_num : (1 : ℝ) < 2)).le
  exact (Real.log_le_iff_le_exp (by exact_mod_cast Nat.pos_of_ne_zero hn)).mpr hsize

theorem roughDivisors_card_le_exp_sqrt {L C : ℝ} (hL : 0 < L)
    {n : ℕ} (hn : n ≠ 0) (hsize : (n : ℝ) ≤ Real.exp (C * L)) :
    ((roughDivisors (Real.exp (Real.sqrt L)) n).card : ℝ) ≤
      Real.exp ((C * Real.log 2) * Real.sqrt L) := by
  have h := roughDivisors_card_le_exp_of_exp_bound (Real.sqrt_pos.mpr hL) hn hsize
  have hid : Real.log 2 * (C * L) / Real.sqrt L = (C * Real.log 2) * Real.sqrt L := by
    apply (div_eq_iff (Real.sqrt_pos.mpr hL).ne').mpr
    calc
      _ = (C * Real.log 2) * (Real.sqrt L ^ 2) := by rw [Real.sq_sqrt hL.le]; ring
      _ = _ := by ring
  simpa only [hid] using h

theorem odd_nat_le_exp_twice {L : ℝ} (hL : Real.log 3 ≤ L)
    {u : ℕ} (hu : (u : ℝ) ≤ Real.exp L) :
    ((2 * u + 1 : ℕ) : ℝ) ≤ Real.exp (2 * L) := by
  have he : (3 : ℝ) ≤ Real.exp L :=
    (Real.log_le_iff_le_exp (by norm_num : (0 : ℝ) < 3)).mp hL
  calc
    _ = 2 * (u : ℝ) + 1 := by norm_cast
    _ ≤ 3 * Real.exp L := by linarith
    _ ≤ Real.exp L * Real.exp L := mul_le_mul_of_nonneg_right he (Real.exp_pos _).le
    _ = Real.exp (2 * L) := by rw [← Real.exp_add]; congr 1; ring

theorem odd_roughDivisors_card_le_exp_sqrt {L : ℝ} (hL : Real.log 3 ≤ L)
    {u : ℕ} (hu : (u : ℝ) ≤ Real.exp L) :
    ((roughDivisors (Real.exp (Real.sqrt L)) (2 * u + 1)).card : ℝ) ≤
      Real.exp ((2 * Real.log 2) * Real.sqrt L) := by
  apply roughDivisors_card_le_exp_sqrt
    ((Real.log_pos (by norm_num : (1 : ℝ) < 3)).trans_le hL)
    (by omega : 2 * u + 1 ≠ 0)
  exact odd_nat_le_exp_twice hL hu
end

section
open Filter Finset
open scoped Topology
theorem eventually_candidate_relative_tail_times_roughDivisors {s q κ C : ℝ}
    (hs : 0 < s) (hq0 : 0 ≤ q) (hq1 : q < 1) (hκ : 0 < κ)
    (hC : 0 ≤ C) (A : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ n : ℕ, n ≠ 0 → (n : ℝ) ≤ Real.exp (C * L) →
      (candidateMarkedSmoothTail s L q 1 (Real.exp (κ * L)) *
        ((roughDivisors (Real.exp (Real.sqrt L)) n).card : ℝ)) /
        candidateOneMarkedHarmonicMass s L q ≤ L^(-A) := by
  have hK : 0 ≤ C * Real.log 2 :=
    mul_nonneg hC (Real.log_pos (by norm_num : (1 : ℝ) < 2)).le
  filter_upwards [eventually_candidate_relative_marked_tail hs hq0 hq1 hκ hK A,
    eventually_candidate_one_marked_mass_ge_one hs hq0 hq1.le,
    eventually_gt_atTop (0 : ℝ)] with L ht hm hL
  intro n hn hsize
  have hc := roughDivisors_card_le_exp_sqrt hL hn hsize
  have hnumer := mul_le_mul_of_nonneg_left hc
    (candidate_marked_smooth_tail_nonneg s L q 1 (Real.exp (κ * L)) hq0)
  exact (div_le_div_of_nonneg_right hnumer (le_trans zero_le_one hm)).trans ht

theorem eventually_candidate_relative_tail_times_odd_roughDivisors {s q κ : ℝ}
    (hs : 0 < s) (hq0 : 0 ≤ q) (hq1 : q < 1) (hκ : 0 < κ) (A : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ u : ℕ, (u : ℝ) ≤ Real.exp L →
      (candidateMarkedSmoothTail s L q 1 (Real.exp (κ * L)) *
        ((roughDivisors (Real.exp (Real.sqrt L)) (2 * u + 1)).card : ℝ)) /
        candidateOneMarkedHarmonicMass s L q ≤ L^(-A) := by
  filter_upwards [eventually_candidate_relative_tail_times_roughDivisors hs hq0 hq1 hκ
    (by norm_num : (0 : ℝ) ≤ 2) A, eventually_ge_atTop (Real.log 3)] with L h hL
  intro u hu
  exact h (2 * u + 1) (by omega) (odd_nat_le_exp_twice hL hu)
end

section
open Finset
/-- The natural-number product of one selected value in each ordered slot. -/
noncomputable def orderedSlotProduct {I : Type*} [Fintype I]
    (choices : I → Finset ℕ) (x : ∀ i, choices i) : ℕ := ∏ i, (x i).val

/-- Counting admissible ordered lists, divided by the prescribed normalization. -/
noncomputable def orderedSlotWeight {I : Type*} [Fintype I]
    (choices : I → Finset ℕ) (normalization : ℝ) (n : ℕ) : ℝ := by
  classical
  exact ∑ x : ∀ i, choices i, if orderedSlotProduct choices x = n then 1 / normalization else 0

theorem ordered_slot_weight_nonneg {I : Type*} [Fintype I]
    (choices : I → Finset ℕ) {normalization : ℝ} (hnorm : 0 ≤ normalization) (n : ℕ) :
    0 ≤ orderedSlotWeight choices normalization n := by
  classical
  exact sum_nonneg (fun _ _ => by split_ifs <;> positivity)

theorem ordered_slot_weight_eq_count {I : Type*} [Fintype I]
    (choices : I → Finset ℕ) (normalization : ℝ) (n : ℕ) :
    orderedSlotWeight choices normalization n =
      (Nat.card {x : ∀ i, choices i // orderedSlotProduct choices x = n} : ℝ) /
        normalization := by
  classical
  simp [orderedSlotWeight, Nat.card_eq_fintype_card, Fintype.card_subtype, ← Finset.sum_filter, div_eq_mul_inv]

theorem ordered_slot_harmonic_summable {I : Type*} [Fintype I]
    (choices : I → Finset ℕ) (normalization : ℝ) :
    Summable (fun n : ℕ => orderedSlotWeight choices normalization n / (n : ℝ)) := by
  classical
  simp only [orderedSlotWeight, Finset.sum_div]
  apply summable_sum
  intro x _
  apply (hasSum_single (orderedSlotProduct choices x) ?_).summable
  intro n hn
  simp [Ne.symm hn]

theorem ordered_slot_harmonic_sum {I : Type*} [Fintype I]
    (choices : I → Finset ℕ) (normalization : ℝ) :
    (∑' n : ℕ, orderedSlotWeight choices normalization n / (n : ℝ)) =
      (∏ i, ∑ p ∈ choices i, 1 / (p : ℝ)) / normalization := by
  classical
  simp only [orderedSlotWeight, Finset.sum_div]
  rw [Summable.tsum_finsetSum]
  · have hsingle : ∀ x : ∀ i, choices i,
        (∑' n : ℕ, (if orderedSlotProduct choices x = n then 1 / normalization else 0) /
          (n : ℝ)) = (1 / (orderedSlotProduct choices x : ℝ)) / normalization := by
      intro x
      simp_rw [ite_div, zero_div]
      rw [tsum_ite_eq']
      ring
    simp_rw [hsingle]
    rw [← Finset.sum_div]
    congr 1
    simp_rw [orderedSlotProduct, Nat.cast_prod, one_div, ← Finset.prod_inv_distrib]
    calc
      _ = ∏ i, ∑ p : choices i, (p.val : ℝ)⁻¹ := by
        convert (Fintype.prod_sum (fun i (p : choices i) => (p.val : ℝ)⁻¹)).symm using 1
      _ = _ := prod_congr rfl (fun i _ => Finset.sum_coe_sort (choices i) (fun p => (p : ℝ)⁻¹))
  · intro x _
    apply (hasSum_single (orderedSlotProduct choices x) ?_).summable
    intro n hn
    simp [Ne.symm hn]
end

section
open Finset Filter
open scoped Topology
noncomputable def roughBand (A B W : ℝ) : Finset ℕ := by
  classical
  exact (Ioc ⌊A⌋₊ ⌊B⌋₊).filter (fun n => ∀ p ∈ n.primeFactors, W < (p : ℝ))

noncomputable def roughBandHarmonic (A B W : ℝ) : ℝ :=
  ∑ n ∈ roughBand A B W, 1 / (n : ℝ)

theorem roughBand_pos {A B W : ℝ} {n : ℕ} (hn : n ∈ roughBand A B W) : 0 < n := by
  classical
  exact lt_of_le_of_lt (Nat.zero_le _) (mem_Ioc.mp (mem_filter.mp hn).1).1

theorem roughBand_subset_Icc (A B W : ℝ) : roughBand A B W ⊆ Icc 1 ⌊B⌋₊ := by
  classical
  intro n hn
  exact mem_Icc.mpr ⟨roughBand_pos hn, (mem_Ioc.mp (mem_filter.mp hn).1).2⟩

theorem roughBandHarmonic_nonneg (A B W : ℝ) : 0 ≤ roughBandHarmonic A B W :=
  sum_nonneg (fun _ _ => by positivity)

theorem primeBand_subset_roughBand {A B W : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hW : W ≤ A) : primeBand A B ⊆ roughBand A B W := by
  classical
  intro p hp
  obtain ⟨hpp, hpA, _⟩ := (mem_primeBand_iff hA hB p).mp hp
  refine mem_filter.mpr ⟨(mem_filter.mp hp).1, ?_⟩
  intro q hq
  have hq' := Nat.mem_primeFactors.mp hq
  have hqp : q = p := ((Nat.dvd_prime hpp).mp hq'.2.1).resolve_left hq'.1.ne_one
  simpa only [hqp] using hW.trans_lt hpA

theorem primeBandHarmonic_le_roughBandHarmonic {A B W : ℝ}
    (hA : 0 ≤ A) (hB : 0 ≤ B) (hW : W ≤ A) :
    primeBandHarmonic A B ≤ roughBandHarmonic A B W := by
  apply sum_le_sum_of_subset_of_nonneg (primeBand_subset_roughBand hA hB hW)
  intro n _ _
  positivity

theorem roughBandHarmonic_le_log {A B W : ℝ} (hB : 1 ≤ B) :
    roughBandHarmonic A B W ≤ 1 + Real.log B := by
  have heq : (∑ n ∈ Icc 1 ⌊B⌋₊, 1 / (n : ℝ)) = (harmonic ⌊B⌋₊ : ℝ) := by
    simp only [harmonic_eq_sum_Icc, Rat.cast_sum, Rat.cast_inv, Rat.cast_natCast, one_div]
  calc
    _ ≤ ∑ n ∈ Icc 1 ⌊B⌋₊, 1 / (n : ℝ) :=
      sum_le_sum_of_subset_of_nonneg (roughBand_subset_Icc A B W) (by intros; positivity)
    _ = (harmonic ⌊B⌋₊ : ℝ) := heq
    _ ≤ 1 + Real.log B := harmonic_floor_le_one_add_log B hB

noncomputable def candidateRoughBand (c L : ℝ) (j : ℕ) : Finset ℕ :=
  roughBand (Real.exp (c * L / 2^j)) (Real.exp ((6/5 : ℝ) * c * L / 2^j))
    (Real.exp (Real.sqrt L))

theorem eventually_sqrt_le_dyadic_scale {c : ℝ} (hc : 0 < c) (j : ℕ) :
    ∀ᶠ L : ℝ in atTop, Real.sqrt L ≤ c * L / 2^j := by
  filter_upwards [eventually_ge_atTop (1 : ℝ),
    eventually_ge_atTop (((2 : ℝ)^j / c)^2)] with L hL hlarge
  have hroot := Real.sqrt_le_sqrt hlarge
  rw [Real.sqrt_sq (by positivity : 0 ≤ (2 : ℝ)^j / c)] at hroot
  have hm : (2 : ℝ)^j ≤ Real.sqrt L * c := (div_le_iff₀ hc).mp hroot
  apply (le_div_iff₀ (by positivity : (0 : ℝ) < 2^j)).mpr
  calc
    _ = (2 : ℝ)^j * Real.sqrt L := mul_comm _ _
    _ ≤ (Real.sqrt L * c) * Real.sqrt L := mul_le_mul_of_nonneg_right hm (Real.sqrt_nonneg L)
    _ = c * (Real.sqrt L)^2 := by ring
    _ = c * L := by rw [Real.sq_sqrt (by linarith : 0 ≤ L)]

theorem exists_candidate_rough_slot_harmonic_bounds {c : ℝ} (hc : 0 < c) :
    ∃ v : ℝ, 0 < v ∧ ∀ j : ℕ, ∀ᶠ L : ℝ in atTop,
      v ≤ (∑ n ∈ candidateRoughBand c L j, 1 / (n : ℝ)) ∧
      (∑ n ∈ candidateRoughBand c L j, 1 / (n : ℝ)) ≤ 1 + (6/5 : ℝ) * c * L := by
  obtain ⟨v, V, t0, hv, _, _, hmass⟩ :=
    exists_primeBandHarmonic_threshold (show (1 : ℝ) < 6/5 by norm_num)
  refine ⟨v, hv, ?_⟩
  intro j
  filter_upwards [eventually_sqrt_le_dyadic_scale hc j,
    eventually_ge_atTop (1 : ℝ), eventually_ge_atTop (t0 * (2 : ℝ)^j / c)] with L hsqrt hL ht
  have hscale : t0 ≤ c * L / 2^j := by
    apply (le_div_iff₀ (by positivity : (0 : ℝ) < 2^j)).mpr
    simpa only [mul_comm c L] using (div_le_iff₀ hc).mp ht
  have hL0 : 0 < L := by linarith
  have hB : 1 ≤ Real.exp ((6/5 : ℝ) * c * L / 2^j) := Real.one_le_exp (by positivity)
  have hP : v ≤ primeBandHarmonic (Real.exp (c * L / 2^j))
      (Real.exp ((6/5 : ℝ) * c * L / 2^j)) := by
    convert (hmass (c * L / 2^j) hscale).1 using 1
    congr 2
    ring
  constructor
  · exact hP.trans (primeBandHarmonic_le_roughBandHarmonic (Real.exp_pos _).le
      (Real.exp_pos _).le (Real.exp_le_exp.mpr hsqrt))
  · refine (roughBandHarmonic_le_log hB).trans ?_
    rw [Real.log_exp]
    apply add_le_add le_rfl
    exact div_le_self (by positivity) (one_le_pow₀ (by norm_num : (1 : ℝ) ≤ 2))
end

section
open Finset Filter
open scoped Topology
noncomputable def candidateQSlotChoices (c L : ℝ) (r jStar : ℕ)
    (slot : (candidateQIndices c L) × Fin r) : Finset ℕ :=
  if slot.1.val = jStar ∧ slot.2.val = 0 then candidateRoughBand c L jStar
  else candidateQBand (c * L) slot.1.val

noncomputable def candidateQWeight (c L : ℝ) (r jStar n : ℕ) : ℝ :=
  orderedSlotWeight (candidateQSlotChoices c L r jStar)
    ((r.factorial : ℝ) ^ (candidateQIndices c L).card) n

noncomputable def candidateQHarmonicMass (c L : ℝ) (r jStar : ℕ) : ℝ :=
  ∑' n : ℕ, candidateQWeight c L r jStar n / (n : ℝ)

theorem candidate_Q_weight_nonneg (c L : ℝ) (r jStar n : ℕ) :
    0 ≤ candidateQWeight c L r jStar n :=
  ordered_slot_weight_nonneg _ (by positivity) n

theorem candidate_Q_harmonic_summable (c L : ℝ) (r jStar : ℕ) :
    Summable (fun n : ℕ => candidateQWeight c L r jStar n / (n : ℝ)) :=
  ordered_slot_harmonic_summable _ _

theorem candidate_Q_harmonic_eq_product (c L : ℝ) (r jStar : ℕ) :
    candidateQHarmonicMass c L r jStar =
      (∏ slot : (candidateQIndices c L) × Fin r,
        ∑ p ∈ candidateQSlotChoices c L r jStar slot, 1 / (p : ℝ)) /
          ((r.factorial : ℝ) ^ (candidateQIndices c L).card) :=
  ordered_slot_harmonic_sum _ _

theorem candidate_Q_slot_harmonic_nonneg (c L : ℝ) (r jStar : ℕ)
    (slot : (candidateQIndices c L) × Fin r) :
    0 ≤ ∑ p ∈ candidateQSlotChoices c L r jStar slot, 1 / (p : ℝ) :=
  sum_nonneg (fun _ _ => by positivity)

theorem candidate_Q_slot_nonzero (c L : ℝ) (r jStar : ℕ)
    (slot : (candidateQIndices c L) × Fin r) {n : ℕ}
    (hn : n ∈ candidateQSlotChoices c L r jStar slot) : n ≠ 0 := by
  unfold candidateQSlotChoices at hn
  split_ifs at hn
  · exact (roughBand_pos hn).ne'
  · exact (mem_filter.mp hn).2.ne_zero

theorem candidate_Q_weight_zero_at_zero (c L : ℝ) (r jStar : ℕ) :
    candidateQWeight c L r jStar 0 = 0 := by
  classical
  unfold candidateQWeight orderedSlotWeight
  apply sum_eq_zero
  intro x _
  have hprod : orderedSlotProduct (candidateQSlotChoices c L r jStar) x ≠ 0 := by
    apply Finset.prod_ne_zero_iff.mpr
    intro slot _
    exact candidate_Q_slot_nonzero c L r jStar slot (x slot).property
  exact if_neg hprod

theorem candidate_Q_harmonic_eq_group_product (c L : ℝ) (r jStar : ℕ) :
    candidateQHarmonicMass c L r jStar =
      ∏ j : candidateQIndices c L,
        (∏ k : Fin r, ∑ p ∈ candidateQSlotChoices c L r jStar (j, k), 1 / (p : ℝ)) /
          (r.factorial : ℝ) := by
  classical
  rw [candidate_Q_harmonic_eq_product, Fintype.prod_prod_type]
  simp only [prod_div_distrib, prod_const, card_univ, Fintype.card_coe]
end

section
open Finset
theorem product_le_with_one_exception {I : Type*} [DecidableEq I]
    (s : Finset I) (f : I → ℝ) (P : I → Prop) {V Z : ℝ}
    (hV : 1 ≤ V) (hZ : 1 ≤ Z)
    (hf0 : ∀ i ∈ s, 0 ≤ f i)
    (hsmall : ∀ i ∈ s, ¬P i → f i ≤ V)
    (hlarge : ∀ i ∈ s, P i → f i ≤ Z)
    (hunique : ∀ i ∈ s, ∀ j ∈ s, P i → P j → i = j) :
    (∏ i ∈ s, f i) ≤ Z * V^s.card := by
  classical
  by_cases h : ∃ i ∈ s, P i
  · obtain ⟨a, ha, hPa⟩ := h
    rw [← mul_prod_erase s f ha]
    have hprod : (∏ i ∈ s.erase a, f i) ≤ V^(s.erase a).card := by
      rw [← prod_const]
      apply prod_le_prod₀ (fun i hi => hf0 i (mem_of_mem_erase hi))
      intro i hi
      apply hsmall i (mem_of_mem_erase hi)
      intro hPi
      exact (mem_erase.mp hi).1 (hunique i (mem_of_mem_erase hi) a ha hPi hPa)
    refine (mul_le_mul (hlarge a ha hPa) hprod
      (prod_nonneg (fun i hi => hf0 i (mem_of_mem_erase hi))) (by linarith)).trans ?_
    exact mul_le_mul_of_nonneg_left (pow_le_pow_right₀ hV (card_erase_le)) (by linarith)
  · have hprod : (∏ i ∈ s, f i) ≤ V^s.card := by
      rw [← prod_const]
      exact prod_le_prod₀ hf0 (fun i hi => hsmall i hi (fun hp => h ⟨i, hi, hp⟩))
    exact hprod.trans (le_mul_of_one_le_left (pow_nonneg (by linarith) _) hZ)

theorem product_lower_of_log_card {I : Type*} (s : Finset I) (f : I → ℝ)
    {v L K : ℝ} (hv : 0 < v) (hv1 : v ≤ 1) (hL : 0 < L)
    (hf : ∀ i ∈ s, v ≤ f i) (hcard : (s.card : ℝ) ≤ K * Real.log L) :
    L^(K * Real.log v) ≤ ∏ i ∈ s, f i := by
  have hvlog : Real.log v ≤ 0 := Real.log_nonpos hv.le hv1
  calc
    _ = Real.exp ((K * Real.log L) * Real.log v) := by
      rw [Real.rpow_def_of_pos hL]
      congr 1
      ring
    _ ≤ Real.exp ((s.card : ℝ) * Real.log v) :=
      Real.exp_le_exp.mpr (mul_le_mul_of_nonpos_right hcard hvlog)
    _ = v^s.card := by rw [Real.exp_nat_mul, Real.exp_log hv]
    _ = ∏ _i ∈ s, v := by simp
    _ ≤ ∏ i ∈ s, f i := prod_le_prod₀ (fun _ _ => hv.le) hf
end

section
open Finset Filter
open scoped Topology
theorem candidate_Q_harmonic_lower_of_slot_bounds {c L a v K : ℝ} {r jStar : ℕ}
    (ha : 0 < a) (ha1 : a ≤ 1) (hv : 0 ≤ v) (hL : 0 < L)
    (hav : a ≤ v^r / (r.factorial : ℝ))
    (hslot : ∀ slot : (candidateQIndices c L) × Fin r,
      v ≤ ∑ p ∈ candidateQSlotChoices c L r jStar slot, 1 / (p : ℝ))
    (hcard : ((candidateQIndices c L).card : ℝ) ≤ K * Real.log L) :
    L^(K * Real.log a) ≤ candidateQHarmonicMass c L r jStar := by
  classical
  rw [candidate_Q_harmonic_eq_group_product]
  apply product_lower_of_log_card univ _ ha ha1 hL _ (by simpa using hcard)
  intro j _
  refine hav.trans (div_le_div_of_nonneg_right ?_ (Nat.cast_nonneg _))
  calc
    v^r = ∏ _k : Fin r, v := by simp
    _ ≤ _ := prod_le_prod₀ (fun _ _ => hv) (fun k _ => hslot (j, k))

theorem candidate_Q_harmonic_upper_of_slot_bounds {c L V Z K : ℝ} {r jStar : ℕ}
    (hV : 1 ≤ V) (hZ : 1 ≤ Z) (hL : 0 < L)
    (hsmall : ∀ slot : (candidateQIndices c L) × Fin r,
      ¬(slot.1.val = jStar ∧ slot.2.val = 0) →
      (∑ p ∈ candidateQSlotChoices c L r jStar slot, 1 / (p : ℝ)) ≤ V)
    (hlarge : ∀ slot : (candidateQIndices c L) × Fin r,
      slot.1.val = jStar ∧ slot.2.val = 0 →
      (∑ p ∈ candidateQSlotChoices c L r jStar slot, 1 / (p : ℝ)) ≤ Z)
    (hcard : ((candidateQIndices c L).card : ℝ) ≤ K * Real.log L) :
    candidateQHarmonicMass c L r jStar ≤ Z * L^((r : ℝ) * K * Real.log V) := by
  classical
  rw [candidate_Q_harmonic_eq_product]
  let f : (candidateQIndices c L) × Fin r → ℝ := fun slot =>
    ∑ p ∈ candidateQSlotChoices c L r jStar slot, 1 / (p : ℝ)
  have hf0 : ∀ slot, 0 ≤ f slot := candidate_Q_slot_harmonic_nonneg c L r jStar
  have hnorm : 1 ≤ (r.factorial : ℝ)^(candidateQIndices c L).card :=
    one_le_pow₀ (by exact_mod_cast Nat.factorial_pos r)
  have hprod := product_le_with_one_exception univ f
    (fun slot => slot.1.val = jStar ∧ slot.2.val = 0) hV hZ
    (fun slot _ => hf0 slot) (fun slot _ => hsmall slot) (fun slot _ => hlarge slot) (by
      intro i _ j _ hi hj
      exact Prod.ext (Subtype.ext (hi.1.trans hj.1.symm)) (Fin.ext (hi.2.trans hj.2.symm)))
  have hcardslot : ((univ : Finset ((candidateQIndices c L) × Fin r)).card : ℝ) ≤
      ((r : ℝ) * K) * Real.log L := by
    simp only [card_univ, Fintype.card_prod, Fintype.card_coe, Fintype.card_fin, Nat.cast_mul]
    have h := mul_le_mul_of_nonneg_left hcard (Nat.cast_nonneg r)
    nlinarith only [h]
  have hp := group_product_bound_of_log_card univ (fun _slot : (candidateQIndices c L) × Fin r => V)
    hV hL (fun _ _ => by linarith) (fun _ _ => le_rfl) hcardslot
  simp only [prod_const] at hp
  exact (div_le_self (prod_nonneg (fun slot _ => hf0 slot)) hnorm).trans
    (hprod.trans (mul_le_mul_of_nonneg_left hp (by linarith)))

/-- The exponent is independent of the fixed band containing the rough slot. -/
theorem exists_candidate_Q_harmonic_polynomial_bounds {c : ℝ} (hc : 0 < c) (r : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ jStar : ℕ, ∀ᶠ L : ℝ in atTop,
      L^(-C) ≤ candidateQHarmonicMass c L r jStar ∧
      candidateQHarmonicMass c L r jStar ≤ L^C := by
  obtain ⟨vl, vu, hvl, hvu, hbands⟩ := exists_candidateQBands_bounds hc
  obtain ⟨vr, hvr, hrough⟩ := exists_candidate_rough_slot_harmonic_bounds hc
  let v : ℝ := min vl vr
  let V : ℝ := max 1 vu
  let K : ℝ := 1 / Real.log 2 + 1
  let a : ℝ := min 1 (v^r / (r.factorial : ℝ))
  let D : ℝ := K * Real.log a
  let E : ℝ := (r : ℝ) * K * Real.log V
  let C : ℝ := max (-D) (E + 2)
  have hv : 0 < v := lt_min hvl hvr
  have ha : 0 < a := lt_min zero_lt_one (by positivity)
  have ha1 : a ≤ 1 := min_le_left _ _
  have hV : 1 ≤ V := le_max_left _ _
  have hK : 0 ≤ K := by dsimp [K]; positivity
  have hE : 0 ≤ E := mul_nonneg (mul_nonneg (Nat.cast_nonneg _) hK) (Real.log_nonneg hV)
  have hC0 : 0 ≤ C := (by linarith : 0 ≤ E + 2).trans (le_max_right _ _)
  refine ⟨C, hC0, ?_⟩
  intro jStar
  filter_upwards [hbands, hrough jStar, eventually_ge_atTop (1 : ℝ),
    eventually_ge_atTop (1 + (6/5 : ℝ) * c)] with L hb hr hL hLbig
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hslots : ∀ slot : (candidateQIndices c L) × Fin r,
      v ≤ ∑ p ∈ candidateQSlotChoices c L r jStar slot, 1 / (p : ℝ) := by
    intro slot
    unfold candidateQSlotChoices
    split_ifs
    · exact (min_le_right vl vr).trans hr.1
    · exact (min_le_left vl vr).trans ((hb.2.2 slot.1.val slot.1.property).2.2.1)
  have hlo : L^D ≤ candidateQHarmonicMass c L r jStar :=
    candidate_Q_harmonic_lower_of_slot_bounds ha ha1 hv.le hL0 (min_le_right _ _) hslots hb.2.1
  have hZ : 1 ≤ 1 + (6/5 : ℝ) * c * L := le_add_of_nonneg_right (by positivity)
  have hhi : candidateQHarmonicMass c L r jStar ≤
      (1 + (6/5 : ℝ) * c * L) * L^E := by
    apply candidate_Q_harmonic_upper_of_slot_bounds hV hZ hL0 _ _ hb.2.1
    · intro slot hslot
      rw [candidateQSlotChoices, if_neg hslot]
      exact ((hb.2.2 slot.1.val slot.1.property).2.2.2).trans (le_max_right 1 vu)
    · intro slot hslot
      rw [candidateQSlotChoices, if_pos hslot]
      exact hr.2
  have hZL : 1 + (6/5 : ℝ) * c * L ≤ L^2 := by
    calc
      _ ≤ L * (1 + (6/5 : ℝ) * c) := by nlinarith
      _ ≤ L * L := mul_le_mul_of_nonneg_left hLbig hL0.le
      _ = _ := by ring
  have hpow : (1 + (6/5 : ℝ) * c * L) * L^E ≤ L^(E + 2) := by
    calc
      _ ≤ L^2 * L^E := mul_le_mul_of_nonneg_right hZL (Real.rpow_nonneg hL0.le E)
      _ = L^(E + 2) := by rw [Real.rpow_add hL0, Real.rpow_two]; ring
  constructor
  · refine (Real.rpow_le_rpow_of_exponent_le hL ?_).trans hlo
    have hDC : -D ≤ C := le_max_left _ _
    linarith
  · exact hhi.trans (hpow.trans (Real.rpow_le_rpow_of_exponent_le hL (le_max_right _ _)))
end

section
open Finset Filter
open scoped Topology
theorem primeBand_card_eq_counting_sub {A B : ℝ} (hAB : A ≤ B) :
    ((primeBand A B).card : ℝ) = primeCountingReal B - primeCountingReal A := by
  have hfloor := Nat.floor_le_floor hAB
  have hset : Ioc ⌊A⌋₊ ⌊B⌋₊ = Ico (⌊A⌋₊ + 1) (⌊B⌋₊ + 1) := by
    ext n
    simp only [mem_Ioc, mem_Ico]
    omega
  have hsum := sum_Ico_eq_sub (fun n : ℕ => if n.Prime then (1 : ℝ) else 0)
    (Nat.add_le_add_right hfloor 1)
  rw [← hset] at hsum
  rw [sum_boole] at hsum
  simpa only [primeBand, primeCountingReal_eq_sum, Nat.range_succ_eq_Icc_zero] using hsum

theorem primeBandHarmonic_card_bounds {A B : ℝ} (hA : 0 < A) (hAB : A ≤ B) :
    ((primeBand A B).card : ℝ) / B ≤ primeBandHarmonic A B ∧
      primeBandHarmonic A B ≤ ((primeBand A B).card : ℝ) / A := by
  have hB : 0 < B := hA.trans_le hAB
  have hlow : (∑ _p ∈ primeBand A B, 1 / B) ≤ primeBandHarmonic A B := by
    apply sum_le_sum
    intro p hp
    have hdata := (mem_primeBand_iff hA.le hB.le p).mp hp
    exact one_div_le_one_div_of_le (hA.trans hdata.2.1) hdata.2.2
  have hhigh : primeBandHarmonic A B ≤ ∑ _p ∈ primeBand A B, 1 / A := by
    apply sum_le_sum
    intro p hp
    have hdata := (mem_primeBand_iff hA.le hB.le p).mp hp
    exact one_div_le_one_div_of_le hA hdata.2.1.le
  simpa only [sum_const, nsmul_eq_mul, mul_one_div] using And.intro hlow hhigh

theorem primeBandHarmonic_fixed_ratio_bounds_of_counting {A R a b : ℝ}
    (hA : 1 < A) (hR : 1 ≤ R) (ha : 0 ≤ a) (hb : 0 ≤ b)
    (hlog : Real.log (R * A) ≤ 2 * Real.log A)
    (hlow : a * (R * A) / Real.log (R * A) ≤ primeCountingReal (R * A))
    (hup : primeCountingReal A ≤ b * A / Real.log A)
    (hupR : primeCountingReal (R * A) ≤ b * (R * A) / Real.log (R * A)) :
    (a / 2 - b / R) / Real.log A ≤ primeBandHarmonic A (R * A) ∧
      primeBandHarmonic A (R * A) ≤ R * b / Real.log A := by
  have hA0 : 0 < A := zero_lt_one.trans hA
  have hR0 : 0 < R := zero_lt_one.trans_le hR
  have hAB : A ≤ R * A := le_mul_of_one_le_left hA0.le hR
  have hRA : 1 < R * A := hA.trans_le hAB
  have hlA : 0 < Real.log A := Real.log_pos hA
  have hlRA : 0 < Real.log (R * A) := Real.log_pos hRA
  have hlogs : Real.log A ≤ Real.log (R * A) := Real.log_le_log hA0 hAB
  obtain ⟨hcardlo, hcardhi⟩ := primeBandHarmonic_card_bounds hA0 hAB
  rw [primeBand_card_eq_counting_sub hAB] at hcardlo hcardhi
  constructor
  · have hlow' : a * (R * A) / (2 * Real.log A) ≤ primeCountingReal (R * A) :=
      (div_le_div_of_nonneg_left (by positivity) hlRA hlog).trans hlow
    have hdiff := sub_le_sub hlow' hup
    refine (le_trans ?_ (div_le_div_of_nonneg_right hdiff (by positivity))).trans hcardlo
    have heq : (a / 2 - b / R) / Real.log A =
        (a * (R * A) / (2 * Real.log A) - b * A / Real.log A) / (R * A) := by
      field_simp
    exact heq.le
  · have hdiff : primeCountingReal (R * A) - primeCountingReal A ≤
        b * (R * A) / Real.log A := by
      have h : b * (R * A) / Real.log (R * A) ≤ b * (R * A) / Real.log A :=
        div_le_div_of_nonneg_left (by positivity) hlA hlogs
      have h' := hupR.trans h
      linarith [primeCountingReal_nonneg A]
    refine hcardhi.trans ((div_le_div_of_nonneg_right hdiff hA0.le).trans ?_)
    have heq : (b * (R * A) / Real.log A) / A = R * b / Real.log A := by field_simp
    exact heq.le

theorem wide_prime_window_lower_constant_pos : 0 < (2 * Real.log 2 - 1) / 16 := by
  linarith [Real.log_two_gt_d9]

theorem eventually_wide_prime_window_harmonic_bounds :
    ∀ᶠ y : ℝ in atTop,
      ((2 * Real.log 2 - 1) / 16) / Real.log y ≤ primeBandHarmonic y (16 * y) ∧
      primeBandHarmonic y (16 * y) ≤ (16 * (Real.log 4 + 1)) / Real.log y := by
  obtain ⟨y0, hcount⟩ := eventually_atTop.mp eventually_primeCounting_chebyshev_bounds
  filter_upwards [eventually_ge_atTop y0, eventually_ge_atTop (16 : ℝ)] with y hy0 hy
  have hy1 : 1 < y := by linarith
  have hyle : y ≤ 16 * y := by linarith
  have hcounty := hcount y hy0
  have hcount16 := hcount (16 * y) (hy0.trans hyle)
  have hlog : Real.log (16 * y) ≤ 2 * Real.log y := by
    rw [Real.log_mul (by norm_num : (16 : ℝ) ≠ 0) (by linarith : y ≠ 0)]
    have h := Real.log_le_log (by norm_num : (0 : ℝ) < 16) hy
    linarith
  have h := primeBandHarmonic_fixed_ratio_bounds_of_counting hy1 (by norm_num : (1 : ℝ) ≤ 16)
    prime_counting_lower_constant_pos.le prime_counting_upper_constant_pos.le
    hlog hcount16.1 hcounty.2 hcount16.2
  have hlog4 : Real.log 4 = 2 * Real.log 2 := by
    simpa only [show (2 : ℝ)^2 = 4 by norm_num, Nat.cast_ofNat] using Real.log_pow (2 : ℝ) 2
  have hcoeff : (Real.log 2 / 2) / 2 - (Real.log 4 + 1) / 16 =
      (2 * Real.log 2 - 1) / 16 := by rw [hlog4]; ring
  simpa only [hcoeff] using h

theorem eventually_wide_prime_log_window_harmonic_bounds :
    ∀ᶠ t : ℝ in atTop,
      ((2 * Real.log 2 - 1) / 16) / t ≤
        primeBandHarmonic (Real.exp t) (Real.exp (t + Real.log 16)) ∧
      primeBandHarmonic (Real.exp t) (Real.exp (t + Real.log 16)) ≤
        (16 * (Real.log 4 + 1)) / t := by
  have h := Real.tendsto_exp_atTop.eventually eventually_wide_prime_window_harmonic_bounds
  simpa only [Real.log_exp, Real.exp_add, Real.exp_log (by norm_num : (0 : ℝ) < 16),
    mul_comm (Real.exp _) 16] using h
end

section
open Filter
open scoped Topology
theorem eventually_uniform_wide_prime_log_window {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    ∀ᶠ L : ℝ in atTop, ∀ t : ℝ, a * L ≤ t → t ≤ b * L →
      (((2 * Real.log 2 - 1) / 16) / b) / L ≤
        primeBandHarmonic (Real.exp t) (Real.exp (t + Real.log 16)) ∧
      primeBandHarmonic (Real.exp t) (Real.exp (t + Real.log 16)) ≤
        ((16 * (Real.log 4 + 1)) / a) / L := by
  have hb : 0 < b := ha.trans_le hab
  obtain ⟨t0, ht0⟩ := eventually_atTop.mp eventually_wide_prime_log_window_harmonic_bounds
  filter_upwards [eventually_gt_atTop (0 : ℝ), eventually_ge_atTop (t0 / a)] with L hL hlarge
  intro t hat htb
  have ht : 0 < t := (mul_pos ha hL).trans_le hat
  have hthreshold : t0 ≤ t := by
    have h := (div_le_iff₀ ha).mp hlarge
    nlinarith only [h, hat]
  obtain ⟨hlo, hhi⟩ := ht0 t hthreshold
  constructor
  · have h := div_le_div_of_nonneg_left wide_prime_window_lower_constant_pos.le ht htb
    have hid : (((2 * Real.log 2 - 1) / 16) / b) / L =
        ((2 * Real.log 2 - 1) / 16) / (b * L) := by ring
    rw [hid]
    exact h.trans hlo
  · have h := div_le_div_of_nonneg_left
      (show 0 ≤ 16 * (Real.log 4 + 1) by positivity) (mul_pos ha hL) hat
    have hid : ((16 * (Real.log 4 + 1)) / a) / L =
        (16 * (Real.log 4 + 1)) / (a * L) := by ring
    rw [hid]
    exact hhi.trans h
end

section
open Finset Filter
open scoped Topology
noncomputable def primeProductWindow (P : Finset ℕ) (r X : ℝ) : Finset ℕ :=
  P.filter (fun p => X < (p : ℝ) * r ∧ (p : ℝ) * r ≤ 16 * X)

theorem primeProductWindow_eq_primeBand {P : Finset ℕ} {r X : ℝ}
    (hP : ∀ p ∈ P, p.Prime) (hr : 0 < r) (hX : 0 < X)
    (hsubset : primeBand (X / r) (16 * (X / r)) ⊆ P) :
    primeProductWindow P r X = primeBand (X / r) (16 * (X / r)) := by
  ext p
  rw [primeProductWindow, mem_filter, mem_primeBand_iff (by positivity) (by positivity)]
  constructor
  · rintro ⟨hp, hlo, hhi⟩
    refine ⟨hP p hp, (div_lt_iff₀ hr).mpr hlo, ?_⟩
    simpa only [mul_div_assoc] using (le_div_iff₀ hr).mpr hhi
  · rintro ⟨hpp, hlo, hhi⟩
    have hp : p ∈ primeBand (X / r) (16 * (X / r)) :=
      (mem_primeBand_iff (by positivity) (by positivity) p).mpr ⟨hpp, hlo, hhi⟩
    refine ⟨hsubset hp, (div_lt_iff₀ hr).mp hlo, ?_⟩
    have hhi' : (p : ℝ) ≤ (16 * X) / r := by simpa only [mul_div_assoc] using hhi
    exact (le_div_iff₀ hr).mp hhi'

theorem primeBand_card_ge_lower_endpoint_mul_harmonic {A B : ℝ}
    (hA : 0 < A) (hAB : A ≤ B) :
    A * primeBandHarmonic A B ≤ ((primeBand A B).card : ℝ) := by
  have h := (primeBandHarmonic_card_bounds hA hAB).2
  have h' := (le_div_iff₀ hA).mp h
  simpa only [mul_comm A] using h'

theorem primeProductWindow_card_lower {P : Finset ℕ} {r X H : ℝ}
    (hP : ∀ p ∈ P, p.Prime) (hr : 0 < r) (hX : 0 < X)
    (hsubset : primeBand (X / r) (16 * (X / r)) ⊆ P)
    (hmass : H ≤ primeBandHarmonic (X / r) (16 * (X / r))) :
    (X / r) * H ≤ ((primeProductWindow P r X).card : ℝ) := by
  rw [primeProductWindow_eq_primeBand hP hr hX hsubset]
  refine (mul_le_mul_of_nonneg_left hmass (by positivity)).trans ?_
  exact primeBand_card_ge_lower_endpoint_mul_harmonic (by positivity) (by nlinarith [div_pos hX hr])

theorem eventually_primeProductWindow_card_lower {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    ∀ᶠ L : ℝ in atTop, ∀ (P : Finset ℕ) (r X : ℝ),
      (∀ p ∈ P, p.Prime) → 0 < r → 0 < X →
      primeBand (X / r) (16 * (X / r)) ⊆ P →
      a * L ≤ Real.log (X / r) → Real.log (X / r) ≤ b * L →
      (X / r) * ((((2 * Real.log 2 - 1) / 16) / b) / L) ≤
        ((primeProductWindow P r X).card : ℝ) := by
  filter_upwards [eventually_uniform_wide_prime_log_window ha hab] with L hL
  intro P r X hP hr hX hsubset hlo hhi
  apply primeProductWindow_card_lower hP hr hX hsubset
  have h := (hL (Real.log (X / r)) hlo hhi).1
  simpa only [Real.exp_add, Real.exp_log (div_pos hX hr),
    Real.exp_log (by norm_num : (0 : ℝ) < 16), mul_comm (X / r) 16] using h

/-- A good collection of the remaining factors supplies an ordinary mass lower bound.
The support is explicitly the wider product interval `(X, 16X]`. -/
theorem eventually_weighted_prime_product_mass_lower {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    ∀ᶠ L : ℝ in atTop, ∀ (P rest : Finset ℕ) (W : ℕ → ℝ) (X : ℝ),
      (∀ p ∈ P, p.Prime) → 0 < X →
      (∀ r ∈ rest, 0 < r) → (∀ r ∈ rest, 0 ≤ W r) →
      (∀ r ∈ rest, primeBand (X / r) (16 * (X / r)) ⊆ P) →
      (∀ r ∈ rest, a * L ≤ Real.log (X / r) ∧ Real.log (X / r) ≤ b * L) →
      X * ((((2 * Real.log 2 - 1) / 16) / b) / L) * (∑ r ∈ rest, W r / (r : ℝ)) ≤
        ∑ r ∈ rest, W r * ((primeProductWindow P r X).card : ℝ) := by
  filter_upwards [eventually_primeProductWindow_card_lower ha hab] with L hL
  intro P rest W X hP hX hr hW hsubset hrange
  rw [mul_sum]
  apply sum_le_sum
  intro r hrmem
  have hr0 : (0 : ℝ) < r := by exact_mod_cast hr r hrmem
  have h := mul_le_mul_of_nonneg_left
    (hL P r X hP hr0 hX (hsubset r hrmem) (hrange r hrmem).1 (hrange r hrmem).2) (hW r hrmem)
  convert h using 1
  ring

theorem wide_prime_window_subset_candidateQBand {c L r X : ℝ}
    (hr : 0 < r) (hX : 0 < X)
    (hlo : c * L ≤ Real.log (X / r))
    (hhi : Real.log (X / r) + Real.log 16 ≤ (6/5 : ℝ) * c * L) :
    primeBand (X / r) (16 * (X / r)) ⊆ candidateQBand (c * L) 0 := by
  have hlo' : Real.exp (c * L) ≤ X / r :=
    (Real.exp_le_exp.mpr hlo).trans_eq (Real.exp_log (div_pos hX hr))
  have hhi' : 16 * (X / r) ≤ Real.exp ((6/5 : ℝ) * c * L) := by
    have h := Real.exp_le_exp.mpr hhi
    simpa only [Real.exp_add, Real.exp_log (div_pos hX hr),
      Real.exp_log (by norm_num : (0 : ℝ) < 16), mul_comm (X / r) 16] using h
  simpa only [candidateQBand, dyadicPrimeBand, pow_zero, div_one, one_mul, mul_assoc] using
    primeBand_subset_of_bounds (by positivity : 0 ≤ X / r) (by positivity : 0 ≤ 16 * (X / r))
      (Real.exp_pos (c * L)).le (Real.exp_pos ((6/5 : ℝ) * c * L)).le hlo' hhi'

theorem eventually_candidate_free_prime_mass_lower {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (rest : Finset ℕ) (W : ℕ → ℝ) (X : ℝ),
      0 < X → (∀ r ∈ rest, 0 < r) → (∀ r ∈ rest, 0 ≤ W r) →
      (∀ r ∈ rest, c * L ≤ Real.log (X / r) ∧
        Real.log (X / r) + Real.log 16 ≤ (6/5 : ℝ) * c * L) →
      X * ((((2 * Real.log 2 - 1) / 16) / ((6/5 : ℝ) * c)) / L) *
        (∑ r ∈ rest, W r / (r : ℝ)) ≤
      ∑ r ∈ rest, W r * ((primeProductWindow (candidateQBand (c * L) 0) r X).card : ℝ) := by
  have hcc : c ≤ (6/5 : ℝ) * c := by linarith
  filter_upwards [eventually_weighted_prime_product_mass_lower hc hcc] with L hL
  intro rest W X hX hr hW hrange
  refine hL (candidateQBand (c * L) 0) rest W X ?_ hX hr hW ?_ ?_
  · intro p hp
    exact (mem_filter.mp hp).2
  · intro r hrmem
    exact wide_prime_window_subset_candidateQBand (by exact_mod_cast hr r hrmem) hX
      (hrange r hrmem).1 (hrange r hrmem).2
  · intro r hrmem
    refine ⟨(hrange r hrmem).1, ?_⟩
    have hlog16 : 0 ≤ Real.log 16 := Real.log_nonneg (by norm_num)
    linarith [(hrange r hrmem).2]
end

section
open scoped BigOperators
noncomputable def physicalSharedProduct {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J : ℕ} (d : PhysicalSharedLists P J) : ℕ :=
  ∏ g, ∏ j, (d g j).val

theorem physical_shared_empty_iff {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (L R : PhysicalMarkLists P J ell) :
    physicalSharedCompatible (fun _ => (∅ : Finset (Fin J))) L R ↔
      physicalSharedPrefix L = physicalSharedPrefix R := by
  constructor
  · intro h
    funext g
    apply Function.Embedding.ext
    intro j
    exact h g j (Finset.notMem_empty j)
  · intro h g j _
    exact congrArg (fun d : PhysicalSharedLists P J => d g j) h

theorem physical_aux_avoids_empty {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (L : PhysicalMarkLists P J ell) :
    physicalAuxAvoids (fun _ => (∅ : Finset (Fin J))) aux L := by
  intro g j
  exact False.elim (Finset.notMem_empty j.val j.property)

theorem physical_list_admissible_empty_iff {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (L R : PhysicalMarkLists P J ell) :
    physicalListAdmissible (fun _ => (∅ : Finset (Fin J))) aux L R ↔
      physicalSharedPrefix L = physicalSharedPrefix R := by
  simp only [physicalListAdmissible, physical_aux_avoids_empty, and_true,
    physical_shared_empty_iff]

theorem physical_aux_mass_empty {G : Type*} [Fintype G] {P : G → Finset ℕ} {J : ℕ}
    (V : G → ℝ) (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J)))) :
    physicalAuxMass V (fun _ => (∅ : Finset (Fin J))) aux = 1 := by
  simp [physicalAuxMass]

theorem physical_D_empty {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (L : PhysicalMarkLists P J ell) :
    physicalD (fun _ => (∅ : Finset (Fin J))) L aux =
      physicalSharedProduct (physicalSharedPrefix L) := by
  simp [physicalD, physicalGroupD, physicalSharedProduct, physical_shared_prefix_apply]

theorem physical_bare_empty_prefix {G : Type*} [Fintype G] {P : G → Finset ℕ}
    {J ell : ℕ} (V : G → ℝ) (ζ : ℝ)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (κ : PhysicalSharedLists P J → ℂ) (L R : PhysicalMarkLists P J ell) :
    physicalBarePatternScalar V (fun _ => (∅ : Finset (Fin J))) ζ
      (fun L _ _ => κ (physicalSharedPrefix L)) aux L R =
      if physicalSharedPrefix L = physicalSharedPrefix R then
        (physicalCompletionMass V (fun _ => (∅ : Finset (Fin J))) ell : ℂ) *
          κ (physicalSharedPrefix L) * physicalPhase ζ (physicalSharedProduct (physicalSharedPrefix L))
      else 0 := by
  simp only [physicalBarePatternScalar, physical_list_admissible_empty_iff,
    physical_aux_mass_empty, one_mul, physical_D_empty]
end

section
open scoped BigOperators
theorem finite_fiber_bilinear_sum {X Y : Type*} [Fintype X] [Fintype Y]
    [DecidableEq Y] (π : X → Y) (a : X → ℂ) (b : Y → X → ℂ) (c : Y → ℂ) :
    (∑ d, (∑ x ∈ Finset.univ.filter (fun x => π x = d), a x) * c d *
      (∑ y ∈ Finset.univ.filter (fun y => π y = d), b d y)) =
      ∑ x, ∑ y, if π x = π y then a x * c (π x) * b (π x) y else 0 := by
  classical
  simp only [Finset.sum_filter]
  simp_rw [Finset.sum_mul, Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro x _
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro y _
  calc
    (∑ d, (if π x = d then a x else 0) * c d * (if π y = d then b d y else 0)) =
        ∑ d, if π x = d then (if π y = d then a x * c d * b d y else 0) else 0 := by
      apply Finset.sum_congr rfl
      intro d _
      split_ifs <;> ring
    _ = _ := by simp [eq_comm]
end

section
open scoped BigOperators Classical
theorem physical_small_bilinear_factorization {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (q ζ : ℝ) (k : ℤ) (r : PhysicalResidues P)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (κ : PhysicalSharedLists P J → ℂ)
    (f : PhysicalMarkLists P J ell → ℂ)
    (g : PhysicalResidues P → PhysicalMarkLists P J ell → ℂ) :
    let tr := fun d : PhysicalSharedLists P J =>
      physicalTranslateResidues r (k * (physicalSharedProduct d : ℕ))
    (∑ L, ∑ R, (physicalStateMass V J ell : ℂ) * (starRingEnd ℂ) (f L) *
      physicalBarePatternScalar V (fun _ => (∅ : Finset (Fin J))) ζ
        (fun L _ _ => κ (physicalSharedPrefix L)) aux L R *
      ((physicalResidueVertexWeight L (Real.sqrt q) r *
        physicalResidueVertexWeight R (Real.sqrt q) (tr (physicalSharedPrefix L)) : ℝ) : ℂ) *
      g (tr (physicalSharedPrefix L)) R) =
    ∑ d, (starRingEnd ℂ) (physicalSmallCondition V q r d f) *
      (κ d * physicalPhase ζ (physicalSharedProduct d)) *
      physicalSmallCondition V q (tr d) d (g (tr d)) := by
  classical
  intro tr
  let s : ℂ := physicalSmallConditioningScale V J ell
  let N : ℂ := (physicalStateMass V J ell *
    physicalCompletionMass V (fun _ => (∅ : Finset (Fin J))) ell : ℝ)
  let a : PhysicalMarkLists P J ell → ℂ := fun L =>
    (physicalResidueVertexWeight L (Real.sqrt q) r : ℂ) * (starRingEnd ℂ) (f L)
  let b : PhysicalSharedLists P J → PhysicalMarkLists P J ell → ℂ := fun d R =>
    (physicalResidueVertexWeight R (Real.sqrt q) (tr d) : ℂ) * g (tr d) R
  let c : PhysicalSharedLists P J → ℂ := fun d => κ d * physicalPhase ζ (physicalSharedProduct d)
  have hs : (starRingEnd ℂ) s * s = N := by
    dsimp [s, N]
    rw [Complex.conj_ofReal, ← Complex.ofReal_mul, ← pow_two,
      physical_small_conditioning_scale_sq V hV]
  have hf (d : PhysicalSharedLists P J) :
      (starRingEnd ℂ) (physicalSmallCondition V q r d f) =
        (starRingEnd ℂ) s * ∑ L ∈ Finset.univ.filter (fun L => physicalSharedPrefix L = d), a L := by
    rw [physical_small_condition_eq_vertex_sum, map_mul]
    congr 1
    rw [map_sum, Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro L _
    by_cases h : physicalSharedPrefix L = d
    · simp only [if_pos h, map_mul, Complex.conj_ofReal]
      rfl
    · simp only [if_neg h, map_zero]
  have hg (d : PhysicalSharedLists P J) :
      physicalSmallCondition V q (tr d) d (g (tr d)) =
        s * ∑ R ∈ Finset.univ.filter (fun R => physicalSharedPrefix R = d), b d R := by
    rw [physical_small_condition_eq_vertex_sum, Finset.sum_filter]
  symm
  calc
    _ = N * ∑ d, (∑ L ∈ Finset.univ.filter (fun L => physicalSharedPrefix L = d), a L) * c d *
        (∑ R ∈ Finset.univ.filter (fun R => physicalSharedPrefix R = d), b d R) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro d _
      rw [hf, hg]
      change (starRingEnd ℂ) s * _ * c d * (s * _) = _
      rw [← hs]
      ring
    _ = N * ∑ L, ∑ R, if physicalSharedPrefix L = physicalSharedPrefix R then
        a L * c (physicalSharedPrefix L) * b (physicalSharedPrefix L) R else 0 := by
      rw [finite_fiber_bilinear_sum]
    _ = _ := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro L _
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro R _
      rw [physical_bare_empty_prefix]
      by_cases h : physicalSharedPrefix L = physicalSharedPrefix R
      · simp only [if_pos h]
        dsimp [N, a, b, c]
        push_cast
        ring
      · simp only [if_neg h, mul_zero, zero_mul]
end

section
open scoped BigOperators
theorem finite_bounded_bilinear_sq {X : Type*} (s : Finset X)
    (f g c : X → ℂ) {M : ℝ} (hM : 0 ≤ M) (hc : ∀ x ∈ s, ‖c x‖ ≤ M) :
    ‖∑ x ∈ s, (starRingEnd ℂ) (f x) * c x * g x‖ ^ 2 ≤
      M ^ 2 * (∑ x ∈ s, ‖f x‖ ^ 2) * ∑ x ∈ s, ‖g x‖ ^ 2 := by
  have hn : ‖∑ x ∈ s, (starRingEnd ℂ) (f x) * c x * g x‖ ≤
      M * ∑ x ∈ s, ‖f x‖ * ‖g x‖ := by
    calc
      _ ≤ ∑ x ∈ s, ‖(starRingEnd ℂ) (f x) * c x * g x‖ := norm_sum_le _ _
      _ ≤ ∑ x ∈ s, M * (‖f x‖ * ‖g x‖) := by
        apply Finset.sum_le_sum
        intro x hx
        simp only [norm_mul, Complex.norm_conj]
        nlinarith [mul_le_mul_of_nonneg_left (hc x hx) (mul_nonneg (norm_nonneg (f x))
          (norm_nonneg (g x)))]
      _ = _ := by rw [Finset.mul_sum]
  have hsum : 0 ≤ M * ∑ x ∈ s, ‖f x‖ * ‖g x‖ := by positivity
  calc
    _ ≤ (M * ∑ x ∈ s, ‖f x‖ * ‖g x‖) ^ 2 :=
      (sq_le_sq₀ (norm_nonneg _) hsum).mpr hn
    _ = M ^ 2 * (∑ x ∈ s, ‖f x‖ * ‖g x‖) ^ 2 := mul_pow _ _ _
    _ ≤ M ^ 2 * ((∑ x ∈ s, ‖f x‖ ^ 2) * ∑ x ∈ s, ‖g x‖ ^ 2) :=
      mul_le_mul_of_nonneg_left (Finset.sum_mul_sq_le_sq_mul_sq s _ _) (sq_nonneg M)
    _ = _ := by ring
end

section
open scoped BigOperators Classical
def physicalResidueTranslationEquiv {G : Type*} {P : G → Finset ℕ} (h : ℤ) :
    PhysicalResidues P ≃ PhysicalResidues P where
  toFun r := physicalTranslateResidues r h
  invFun r := physicalTranslateResidues r (-h)
  left_inv r := by dsimp only; rw [physical_translate_residues_add]; simp [physical_translate_residues_zero]
  right_inv r := by dsimp only; rw [physical_translate_residues_add]; simp [physical_translate_residues_zero]

noncomputable def physicalSmallBilinearForm {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val]
    {J ell : ℕ} (V : G → ℝ) (q ζ : ℝ) (k : ℤ)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (κ : PhysicalSharedLists P J → ℂ)
    (f g : PhysicalResidues P → PhysicalMarkLists P J ell → ℂ) : ℂ :=
  ∑ r, ∑ L, ∑ R, (physicalStateMass V J ell : ℂ) * (starRingEnd ℂ) (f r L) *
    physicalBarePatternScalar V (fun _ => (∅ : Finset (Fin J))) ζ
      (fun L _ _ => κ (physicalSharedPrefix L)) aux L R *
    ((physicalResidueVertexWeight L (Real.sqrt q) r * physicalResidueVertexWeight R
      (Real.sqrt q) (physicalTranslateResidues r (k * (physicalSharedProduct (physicalSharedPrefix L) : ℕ))) : ℝ) : ℂ) *
    g (physicalTranslateResidues r (k * (physicalSharedProduct (physicalSharedPrefix L) : ℕ))) R

theorem physical_small_bilinear_form_eq {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val]
    {J ell : ℕ} (V : G → ℝ) (hV : ∀ g, 0 < V g) (q ζ : ℝ) (k : ℤ)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (κ : PhysicalSharedLists P J → ℂ)
    (f g : PhysicalResidues P → PhysicalMarkLists P J ell → ℂ) :
    physicalSmallBilinearForm V q ζ k aux κ f g =
      ∑ d, ∑ r, (starRingEnd ℂ) (physicalSmallCondition V q r d (f r)) *
        (κ d * physicalPhase ζ (physicalSharedProduct d)) *
        physicalSmallCondition V q (physicalTranslateResidues r (k * (physicalSharedProduct d : ℕ)))
          d (g (physicalTranslateResidues r (k * (physicalSharedProduct d : ℕ)))) := by
  unfold physicalSmallBilinearForm
  conv_rhs => rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro r _
  exact physical_small_bilinear_factorization V hV q ζ k r aux κ (f r) g

theorem physical_small_conditioning_translated_energy {G : Type*} [Fintype G]
    [DecidableEq G] {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val]
    {J ell : ℕ} (V : G → ℝ) (q : ℝ) (k : ℤ)
    (g : PhysicalResidues P → PhysicalMarkLists P J ell → ℂ) :
    (∑ d, ∑ r, ‖physicalSmallCondition V q
      (physicalTranslateResidues r (k * (physicalSharedProduct d : ℕ))) d
      (g (physicalTranslateResidues r (k * (physicalSharedProduct d : ℕ))))‖ ^ 2) =
      ∑ r, ∑ d, ‖physicalSmallCondition V q r d (g r)‖ ^ 2 := by
  conv_rhs => rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro d _
  exact (physicalResidueTranslationEquiv (k * (physicalSharedProduct d : ℕ))).sum_comp
    (fun r => ‖physicalSmallCondition V q r d (g r)‖ ^ 2)

theorem exists_physical_small_bilinear_energy_bound {q v : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (ell : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (G : Type) [Fintype G] [DecidableEq G]
      (P : G → Finset ℕ) [∀ p : PhysicalPrime P, NeZero p.2.val]
      (J : ℕ) (V : G → ℝ), (∀ g, v ≤ V g) →
      ∀ (ζ : ℝ) (k : ℤ) (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
        (κ : PhysicalSharedLists P J → ℂ) (M : ℝ), 0 ≤ M → (∀ d, ‖κ d‖ ≤ M) →
      ∀ f g : PhysicalResidues P → PhysicalMarkLists P J ell → ℂ,
      ‖physicalSmallBilinearForm V q ζ k aux κ f g‖ ^ 2 ≤
        (M * A ^ Fintype.card G) ^ 2 *
          (∑ r, ∑ L : PhysicalResidueMarksAt P J ell r, physicalStateMass V J ell * ‖f r L.val‖ ^ 2) *
          (∑ r, ∑ L : PhysicalResidueMarksAt P J ell r, physicalStateMass V J ell * ‖g r L.val‖ ^ 2) := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_small_conditioning_weighted_energy_bound hq0 hq1 hv ell
  refine ⟨A, hA, ?_⟩
  intro G _ _ P _ J V hV ζ k aux κ M hM hκ f g
  have hpos (x : G) : 0 < V x := lt_of_lt_of_le hv (hV x)
  have hf := hbound G P J V hV (PhysicalResidues P) Finset.univ id (fun _ => 1)
    (fun _ _ => by norm_num) f
  have hg := hbound G P J V hV (PhysicalResidues P) Finset.univ id (fun _ => 1)
    (fun _ _ => by norm_num) g
  simp only [id_eq, one_mul] at hf hg
  have hp := finite_bounded_bilinear_sq (Finset.univ : Finset (PhysicalSharedLists P J × PhysicalResidues P))
    (fun x => physicalSmallCondition V q x.2 x.1 (f x.2))
    (fun x => physicalSmallCondition V q
      (physicalTranslateResidues x.2 (k * (physicalSharedProduct x.1 : ℕ))) x.1
      (g (physicalTranslateResidues x.2 (k * (physicalSharedProduct x.1 : ℕ)))))
    (fun x => κ x.1 * physicalPhase ζ (physicalSharedProduct x.1)) hM
    (fun x _ => by simpa only [norm_mul, physical_phase_norm, mul_one] using hκ x.1)
  simp only [Fintype.sum_prod_type] at hp
  rw [← physical_small_bilinear_form_eq V hpos q ζ k aux κ f g,
    physical_small_conditioning_translated_energy] at hp
  rw [Finset.sum_comm] at hf
  have hmul := mul_le_mul hf hg (by positivity)
    (mul_nonneg (pow_nonneg (le_trans zero_le_one hA) _) (by
      apply Finset.sum_nonneg
      intro r _
      apply Finset.sum_nonneg
      intro L _
      exact mul_nonneg (physical_state_mass_pos V hpos J ell).le (sq_nonneg _)))
  calc
    _ ≤ M ^ 2 * ((∑ d, ∑ r, ‖physicalSmallCondition V q r d (f r)‖ ^ 2) *
      (∑ r, ∑ d, ‖physicalSmallCondition V q r d (g r)‖ ^ 2)) := by
      simpa only [mul_assoc] using hp
    _ ≤ M ^ 2 * ((A ^ Fintype.card G * _) * (A ^ Fintype.card G * _)) :=
      mul_le_mul_of_nonneg_left hmul (sq_nonneg M)
    _ = _ := by ring
end

section

/-- Adding real frequencies multiplies the corresponding closure phases. -/
theorem physicalReturnPhase_frequency_add (θ η : ℝ) (n : ℤ) :
    physicalReturnPhase (θ + η) n = physicalReturnPhase θ n * physicalReturnPhase η n := by
  unfold physicalReturnPhase
  rw [← Complex.exp_add]
  congr 1
  push_cast
  ring

/-- A fixed integer factor in the displacement rescales the real frequency. -/
theorem physicalReturnPhase_scale (θ : ℝ) (c n : ℤ) :
    physicalReturnPhase θ (c * n) = physicalReturnPhase (θ * c) n := by
  unfold physicalReturnPhase
  congr 1
  push_cast
  ring

/-- A character restricted to a fixed integer direction has an explicit real frequency.
The frequency depends only on the direction, not on the varying integer multiplier. -/
theorem physical_character_phase {R : Type*} [AddCommGroup R] [Finite R]
    (χ : AddChar R ℂ) (φ : ℤ →+ R) (c n : ℤ) :
    χ (φ (c * n)) =
      physicalReturnPhase ((Complex.arg (χ (φ c))) / (2 * Real.pi)) n := by
  have hunit : Complex.exp ((Complex.arg (χ (φ c)) : ℂ) * Complex.I) = χ (φ c) := by
    simpa only [χ.norm_apply, Complex.ofReal_one, one_mul] using
      Complex.norm_mul_exp_arg_mul_I (χ (φ c))
  have hdir : φ (c * n) = n • φ c := by
    rw [← map_zsmul]
    congr 1
    simp only [zsmul_eq_mul, Int.cast_id, mul_comm]
  rw [hdir, AddChar.map_zsmul_eq_zpow]
  calc
    χ (φ c) ^ n = Complex.exp ((Complex.arg (χ (φ c)) : ℂ) * Complex.I) ^ n :=
      congrArg (fun z : ℂ => z ^ n) hunit.symm
    _ = Complex.exp ((n : ℂ) * ((Complex.arg (χ (φ c)) : ℂ) * Complex.I)) :=
      (Complex.exp_int_mul _ n).symm
    _ = _ := by
      unfold physicalReturnPhase
      congr 1
      push_cast
      field_simp


/-- The character of a translated residue direction and the closure phase form one
real phase. This identity holds for every integer multiplier, including negatives. -/
theorem exists_physical_character_return_frequency {R : Type*}
    [AddCommGroup R] [Finite R] (χ : AddChar R ℂ) (φ : ℤ →+ R) (θ : ℝ) (c : ℤ) :
    ∃ Θ : ℝ, ∀ n : ℤ,
      χ (φ (c * n)) * physicalReturnPhase θ (c * n) = physicalReturnPhase Θ n := by
  refine ⟨Complex.arg (χ (φ c)) / (2 * Real.pi) + θ * c, ?_⟩
  intro n
  rw [physical_character_phase, physicalReturnPhase_scale, physicalReturnPhase_frequency_add]

/-- After fixing the small dilation product, the complete multiplier is a unit scalar
times the big dilation phase at one real frequency, uniformly over all big products. -/
theorem exists_physical_split_multiplier_frequency {R : Type*}
    [AddCommGroup R] [Finite R] (χ : AddChar R ℂ) (φ : ℤ →+ R)
    (ζ θ : ℝ) (k : ℤ) (a : ℕ) (ha : 0 < a) :
    ∃ Θ : ℝ, ∀ b : ℕ, 0 < b →
      physicalPhase ζ (a * b) * χ (φ (k * (a * b : ℕ))) *
          physicalReturnPhase θ (k * (a * b : ℕ)) =
        physicalPhase ζ a * (physicalPhase ζ b * physicalReturnPhase Θ b) := by
  obtain ⟨Θ, hΘ⟩ := exists_physical_character_return_frequency χ φ θ (k * a)
  refine ⟨Θ, ?_⟩
  intro b hb
  rw [physical_phase_mul ζ ha hb]
  have hstep : k * (a * b : ℕ) = (k * (a : ℤ)) * (b : ℤ) := by
    push_cast
    ring
  rw [hstep]
  calc
    physicalPhase ζ a * physicalPhase ζ b * χ (φ (k * a * b)) *
        physicalReturnPhase θ (k * a * b) =
      physicalPhase ζ a * (physicalPhase ζ b *
        (χ (φ (k * a * b)) * physicalReturnPhase θ (k * a * b))) := by ring
    _ = _ := by rw [hΘ]
end

section
open Finset
open scoped Classical
/-- An unrestricted event includes the fresh draw on every unpromoted slot. -/
abbrev FixedTargetEdgeEvent (S J P : Type*) (eligible : Finset J) :=
  Σ U : Finset S, (U ↪ eligible) × UnrestrictedFreshLabels P U

/-- The event generates the specified target, and its fresh draws avoid all
old labels. Further arithmetic or history restrictions remain separate. -/
def FixedTargetEdgeEventValid {S J P : Type*} [Fintype J]
    [DecidableEq S] [DecidableEq P] (f : J ↪ P) (t : S ↪ P)
    {eligible : Finset J} (event : FixedTargetEdgeEvent S J P eligible) : Prop :=
  unrestrictedTargetLabels event.1 (fun s => f (event.2.1 s).val) event.2.2 = t ∧
    ∀ s, event.2.2 s ∉ univ.image f

theorem fixed_target_edge_event_matches {S J P : Type*} [Fintype J]
    [DecidableEq S] [DecidableEq P] (f : J ↪ P) (t : S ↪ P)
    {eligible : Finset J} (event : FixedTargetEdgeEvent S J P eligible)
    (h : FixedTargetEdgeEventValid f t event) (s : event.1) :
    f (event.2.1 s).val = t s.val := by
  have hs := congrFun h.1 s.val
  rw [unrestrictedTargetLabels_promoted] at hs
  exact hs

theorem fixed_target_edge_event_fresh {S J P : Type*} [Fintype J]
    [DecidableEq S] [DecidableEq P] (f : J ↪ P) (t : S ↪ P)
    {eligible : Finset J} (event : FixedTargetEdgeEvent S J P eligible)
    (h : FixedTargetEdgeEventValid f t event) :
    event.2.2 = fun s => t s.val := by
  funext s
  have hs := congrFun h.1 s.val
  rw [unrestrictedTargetLabels_fresh] at hs
  exact hs

theorem fixed_target_edge_event_slots {S J P : Type*} [Fintype S] [Fintype J]
    [DecidableEq S] [DecidableEq P] (f : J ↪ P) (t : S ↪ P)
    {eligible : Finset J} (event : FixedTargetEdgeEvent S J P eligible)
    (h : FixedTargetEdgeEventValid f t event) :
    event.1 = distinctPromotedTargetSlots f t := by
  apply distinct_promoted_slots_forced f t event.1
    (event.2.1.trans ⟨Subtype.val, Subtype.val_injective⟩)
    (fixed_target_edge_event_matches f t event h)
  intro s hs
  have hf := h.2 ⟨s, hs⟩
  rw [fixed_target_edge_event_fresh f t event h] at hf
  exact hf

/-- Once its selected slots are fixed, every matching eligible injection is
the event's injection. Old-label injectivity removes the multiplicity. -/
theorem fixed_target_edge_event_injection_unique {S J P : Type*} [Fintype J]
    [DecidableEq S] [DecidableEq P] (f : J ↪ P) (t : S ↪ P)
    {eligible : Finset J} (event : FixedTargetEdgeEvent S J P eligible)
    (h : FixedTargetEdgeEventValid f t event) (e : event.1 ↪ eligible)
    (he : ∀ s, f (e s).val = t s.val) : event.2.1 = e := by
  ext s
  exact f.injective ((fixed_target_edge_event_matches f t event h s).trans (he s).symm)

noncomputable def fixedTargetCanonicalEvent {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq P] (f : J ↪ P) (t : S ↪ P)
    {eligible : Finset J} (e : distinctPromotedTargetSlots f t ↪ eligible) :
    FixedTargetEdgeEvent S J P eligible :=
  ⟨distinctPromotedTargetSlots f t, e, distinctCanonicalFresh f t⟩

theorem fixed_target_canonical_event_valid {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq S] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) {eligible : Finset J}
    (e : distinctPromotedTargetSlots f t ↪ eligible)
    (he : ∀ s, f (e s).val = t s.val) :
    FixedTargetEdgeEventValid f t (fixedTargetCanonicalEvent f t e) := by
  exact ⟨distinct_unrestricted_target_labels f t eligible e he,
    distinct_canonical_fresh_outside_old f t⟩

/-- This equality includes the dependent selected subset, eligible matching,
and all complementary fresh draws, so no event data are forgotten. -/
theorem fixed_target_edge_event_unique {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq S] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) {eligible : Finset J}
    (e : distinctPromotedTargetSlots f t ↪ eligible)
    (he : ∀ s, f (e s).val = t s.val)
    (event : FixedTargetEdgeEvent S J P eligible)
    (h : FixedTargetEdgeEventValid f t event) :
    event = fixedTargetCanonicalEvent f t e := by
  rcases event with ⟨U, g, fresh⟩
  have hU := fixed_target_edge_event_slots f t ⟨U, g, fresh⟩ h
  change U = distinctPromotedTargetSlots f t at hU
  subst U
  have hg := fixed_target_edge_event_injection_unique f t
    ⟨distinctPromotedTargetSlots f t, g, fresh⟩ h e he
  have hf := fixed_target_edge_event_fresh f t
    ⟨distinctPromotedTargetSlots f t, g, fresh⟩ h
  change g = e at hg
  change fresh = distinctCanonicalFresh f t at hf
  rw [hg, hf]
  rfl

noncomputable def fixedTargetEdgeEvents {S J P : Type*}
    [Fintype S] [Fintype J] [Fintype P] [DecidableEq S] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) (eligible : Finset J) :
    Finset (FixedTargetEdgeEvent S J P eligible) :=
  univ.filter (FixedTargetEdgeEventValid f t)

theorem fixed_target_edge_events_eq_singleton {S J P : Type*}
    [Fintype S] [Fintype J] [Fintype P] [DecidableEq S] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) (eligible : Finset J)
    (e : distinctPromotedTargetSlots f t ↪ eligible)
    (he : ∀ s, f (e s).val = t s.val) :
    fixedTargetEdgeEvents f t eligible = {fixedTargetCanonicalEvent f t e} := by
  ext event
  simp only [fixedTargetEdgeEvents, mem_filter, mem_univ, true_and, mem_singleton]
  constructor
  · exact fixed_target_edge_event_unique f t e he event
  · intro h
    rw [h]
    exact fixed_target_canonical_event_valid f t e he

/-- Arbitrary coupled real, complex, or other additive event tests collapse
once, without a factorial normalization. -/
theorem sum_fixed_target_edge_events {S J P M : Type*}
    [Fintype S] [Fintype J] [Fintype P] [DecidableEq S] [DecidableEq P]
    [AddCommMonoid M] (f : J ↪ P) (t : S ↪ P) (eligible : Finset J)
    (e : distinctPromotedTargetSlots f t ↪ eligible)
    (he : ∀ s, f (e s).val = t s.val)
    (F : FixedTargetEdgeEvent S J P eligible → M) :
    (∑ event ∈ fixedTargetEdgeEvents f t eligible, F event) =
      F (fixedTargetCanonicalEvent f t e) := by
  rw [fixed_target_edge_events_eq_singleton f t eligible e he, sum_singleton]

/-- The literal nested enumeration over subsets, eligible injections, and
fresh tuples has the same one-term value after fixing the distinct target. -/
theorem sum_fixed_target_edge_subsets_injections_fresh {S J P M : Type*}
    [Fintype S] [Fintype J] [Fintype P] [DecidableEq S] [DecidableEq P]
    [AddCommMonoid M] (f : J ↪ P) (t : S ↪ P) (eligible : Finset J)
    (e : distinctPromotedTargetSlots f t ↪ eligible)
    (he : ∀ s, f (e s).val = t s.val)
    (F : FixedTargetEdgeEvent S J P eligible → M) :
    (∑ U : Finset S, ∑ g : U ↪ eligible, ∑ fresh : UnrestrictedFreshLabels P U,
      if FixedTargetEdgeEventValid f t ⟨U, g, fresh⟩ then F ⟨U, g, fresh⟩ else 0) =
      F (fixedTargetCanonicalEvent f t e) := by
  have h := sum_fixed_target_edge_events f t eligible e he F
  simpa only [fixedTargetEdgeEvents, sum_filter, Fintype.sum_sigma,
    Fintype.sum_prod_type] using h
end

section
open Finset
/-- The canonical matching index is an old index required by the target. -/
theorem canonical_promotion_mem_required {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) (s : distinctPromotedTargetSlots f t) :
    distinctCanonicalPromotion f t s ∈ univ.filter (fun j => f j ∈ univ.image t) := by
  exact mem_filter.mpr ⟨mem_univ _, mem_image.mpr
    ⟨s.val, mem_univ _, (distinct_canonical_promotion_matches f t s).symm⟩⟩

/-- Eligibility of the canonical indices is exactly containment of the full
required-old-index set; no required occurrence is lost. -/
theorem canonical_promotion_indices_eligible_iff {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) (eligible : Finset J) :
    (∀ s, distinctCanonicalPromotion f t s ∈ eligible) ↔
      univ.filter (fun j => f j ∈ univ.image t) ⊆ eligible := by
  constructor
  · intro h j hj
    obtain ⟨s, _, hs⟩ := mem_image.mp (mem_filter.mp hj).2
    have hslot : s ∈ distinctPromotedTargetSlots f t := by
      rw [mem_distinctPromotedTargetSlots]
      exact mem_image.mpr ⟨j, mem_univ _, hs.symm⟩
    have heq : distinctCanonicalPromotion f t ⟨s, hslot⟩ = j :=
      f.injective ((distinct_canonical_promotion_matches f t ⟨s, hslot⟩).trans hs)
    simpa only [heq] using h ⟨s, hslot⟩
  · intro h s
    exact h (canonical_promotion_mem_required f t s)

/-- The unique old matching injection, restricted to the eligibility set. -/
noncomputable def canonicalEligiblePromotion {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) (eligible : Finset J)
    (h : univ.filter (fun j => f j ∈ univ.image t) ⊆ eligible) :
    distinctPromotedTargetSlots f t ↪ eligible where
  toFun s := ⟨distinctCanonicalPromotion f t s, h (canonical_promotion_mem_required f t s)⟩
  inj' := by
    intro s r hsr
    exact (distinctCanonicalPromotion f t).injective (congrArg Subtype.val hsr)

theorem canonical_eligible_promotion_val {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) (eligible : Finset J)
    (h : univ.filter (fun j => f j ∈ univ.image t) ⊆ eligible)
    (s : distinctPromotedTargetSlots f t) :
    (canonicalEligiblePromotion f t eligible h s).val = distinctCanonicalPromotion f t s := rfl

theorem canonical_eligible_promotion_matches {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) (eligible : Finset J)
    (h : univ.filter (fun j => f j ∈ univ.image t) ⊆ eligible)
    (s : distinctPromotedTargetSlots f t) :
    f (canonicalEligiblePromotion f t eligible h s).val = t s.val :=
  distinct_canonical_promotion_matches f t s

/-- Any eligible matching injection is the canonical eligible one. -/
theorem canonical_eligible_promotion_unique {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) (eligible : Finset J)
    (h : univ.filter (fun j => f j ∈ univ.image t) ⊆ eligible)
    (e : distinctPromotedTargetSlots f t ↪ eligible)
    (he : ∀ s, f (e s).val = t s.val) :
    e = canonicalEligiblePromotion f t eligible h := by
  ext s
  exact f.injective ((he s).trans (canonical_eligible_promotion_matches f t eligible h s).symm)

/-- Matching eligible injections exist precisely when all required old indices
are eligible. -/
theorem exists_matching_eligible_promotion_iff {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq J] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) (eligible : Finset J) :
    (∃ e : distinctPromotedTargetSlots f t ↪ eligible, ∀ s, f (e s).val = t s.val) ↔
      univ.filter (fun j => f j ∈ univ.image t) ⊆ eligible := by
  constructor
  · rintro ⟨e, he⟩
    exact distinct_canonical_promotion_required_eligible f t eligible e he
  · intro h
    exact ⟨canonicalEligiblePromotion f t eligible h,
      canonical_eligible_promotion_matches f t eligible h⟩

/-- The existence condition also certifies uniqueness, including eligibility
subtype proofs. -/
theorem existsUnique_matching_eligible_promotion_iff {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq J] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) (eligible : Finset J) :
    (∃! e : distinctPromotedTargetSlots f t ↪ eligible, ∀ s, f (e s).val = t s.val) ↔
      univ.filter (fun j => f j ∈ univ.image t) ⊆ eligible := by
  constructor
  · intro h
    exact (exists_matching_eligible_promotion_iff f t eligible).mp h.exists
  · intro h
    exact ⟨canonicalEligiblePromotion f t eligible h,
      canonical_eligible_promotion_matches f t eligible h,
      fun e he => canonical_eligible_promotion_unique f t eligible h e he⟩

/-- One ineligible required old index rules out every eligible matching map. -/
theorem no_matching_eligible_promotion_of_missing {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq J] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) (eligible : Finset J) (j : J)
    (hj : f j ∈ univ.image t) (hne : j ∉ eligible) :
    ¬ ∃ e : distinctPromotedTargetSlots f t ↪ eligible, ∀ s, f (e s).val = t s.val := by
  intro he
  exact hne ((exists_matching_eligible_promotion_iff f t eligible).mp he
    (mem_filter.mpr ⟨mem_univ _, hj⟩))
end

section
open Finset
open scoped Classical
/-- A valid fixed-target event must make every required old index eligible. -/
theorem fixed_target_edge_event_required_eligible {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq S] [DecidableEq J] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) (eligible : Finset J)
    (event : FixedTargetEdgeEvent S J P eligible)
    (h : FixedTargetEdgeEventValid f t event) :
    univ.filter (fun j => f j ∈ univ.image t) ⊆ eligible := by
  rcases event with ⟨U, e, fresh⟩
  have hU := fixed_target_edge_event_slots f t ⟨U, e, fresh⟩ h
  change U = distinctPromotedTargetSlots f t at hU
  subst U
  exact distinct_canonical_promotion_required_eligible f t eligible e
    (fixed_target_edge_event_matches f t ⟨distinctPromotedTargetSlots f t, e, fresh⟩ h)

/-- If any required old index is ineligible, no event generating this target
with genuinely fresh complementary labels can be valid. -/
theorem fixed_target_edge_event_invalid_of_ineligible {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq S] [DecidableEq J] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) (eligible : Finset J)
    (h : ¬ univ.filter (fun j => f j ∈ univ.image t) ⊆ eligible)
    (event : FixedTargetEdgeEvent S J P eligible) :
    ¬ FixedTargetEdgeEventValid f t event :=
  fun he => h (fixed_target_edge_event_required_eligible f t eligible event he)

theorem fixed_target_edge_events_eq_empty_of_ineligible {S J P : Type*}
    [Fintype S] [Fintype J] [Fintype P]
    [DecidableEq S] [DecidableEq J] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) (eligible : Finset J)
    (h : ¬ univ.filter (fun j => f j ∈ univ.image t) ⊆ eligible) :
    fixedTargetEdgeEvents f t eligible = ∅ := by
  classical
  apply eq_empty_iff_forall_notMem.mpr
  intro event he
  simp only [fixedTargetEdgeEvents, mem_filter, mem_univ, true_and] at he
  exact fixed_target_edge_event_invalid_of_ineligible f t eligible h event he

/-- The event set is constructed from eligibility alone, without assuming a
matching eligible injection as an input. -/
theorem fixed_target_edge_events_eq_if {S J P : Type*}
    [Fintype S] [Fintype J] [Fintype P]
    [DecidableEq S] [DecidableEq J] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) (eligible : Finset J) :
    fixedTargetEdgeEvents f t eligible =
      if h : univ.filter (fun j => f j ∈ univ.image t) ⊆ eligible then
        {fixedTargetCanonicalEvent f t (canonicalEligiblePromotion f t eligible h)}
      else ∅ := by
  classical
  split_ifs with h
  · exact fixed_target_edge_events_eq_singleton f t eligible
      (canonicalEligiblePromotion f t eligible h)
      (canonical_eligible_promotion_matches f t eligible h)
  · exact fixed_target_edge_events_eq_empty_of_ineligible f t eligible h

/-- An arbitrary coupled event sum is zero when any required index is absent. -/
theorem sum_fixed_target_edge_events_of_ineligible {S J P M : Type*}
    [Fintype S] [Fintype J] [Fintype P]
    [DecidableEq S] [DecidableEq J] [DecidableEq P] [AddCommMonoid M]
    (f : J ↪ P) (t : S ↪ P) (eligible : Finset J)
    (h : ¬ univ.filter (fun j => f j ∈ univ.image t) ⊆ eligible)
    (F : FixedTargetEdgeEvent S J P eligible → M) :
    (∑ event ∈ fixedTargetEdgeEvents f t eligible, F event) = 0 := by
  rw [fixed_target_edge_events_eq_empty_of_ineligible f t eligible h, sum_empty]

/-- The complete fixed-target event sum, including both success and failure
of eligibility, with no existence hypothesis and no extra multiplicity. -/
theorem sum_fixed_target_edge_events_eq_if {S J P M : Type*}
    [Fintype S] [Fintype J] [Fintype P]
    [DecidableEq S] [DecidableEq J] [DecidableEq P] [AddCommMonoid M]
    (f : J ↪ P) (t : S ↪ P) (eligible : Finset J)
    (F : FixedTargetEdgeEvent S J P eligible → M) :
    (∑ event ∈ fixedTargetEdgeEvents f t eligible, F event) =
      if h : univ.filter (fun j => f j ∈ univ.image t) ⊆ eligible then
        F (fixedTargetCanonicalEvent f t (canonicalEligiblePromotion f t eligible h))
      else 0 := by
  classical
  rw [fixed_target_edge_events_eq_if]
  split_ifs <;> simp only [sum_singleton, sum_empty]

/-- Literal nested subset, eligible-injection, and fresh-draw enumeration with
an explicit zero branch when a required old particle is not eligible. -/
theorem sum_fixed_target_edge_subsets_injections_fresh_eq_if {S J P M : Type*}
    [Fintype S] [Fintype J] [Fintype P]
    [DecidableEq S] [DecidableEq J] [DecidableEq P] [AddCommMonoid M]
    (f : J ↪ P) (t : S ↪ P) (eligible : Finset J)
    (F : FixedTargetEdgeEvent S J P eligible → M) :
    (∑ U : Finset S, ∑ e : U ↪ eligible, ∑ fresh : UnrestrictedFreshLabels P U,
      if FixedTargetEdgeEventValid f t ⟨U, e, fresh⟩ then F ⟨U, e, fresh⟩ else 0) =
      if h : univ.filter (fun j => f j ∈ univ.image t) ⊆ eligible then
        F (fixedTargetCanonicalEvent f t (canonicalEligiblePromotion f t eligible h))
      else 0 := by
  classical
  have h := sum_fixed_target_edge_events_eq_if f t eligible F
  simpa only [fixedTargetEdgeEvents, sum_filter, Fintype.sum_sigma,
    Fintype.sum_prod_type] using h
end

section
open Finset
open scoped Classical
/-- Restricting the actual edge action to one distinct target and fresh labels
outside old memory leaves one promotion/fresh event for each storage subset.
The actual memory cutoff and arbitrary complex event phase are retained. -/
theorem unrestricted_edge_action_fixed_target {P Z : Type*}
    [Fintype P] [DecidableEq P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (label : Z → P)
    (seed : P → Z) (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ)
    (ρ V : ℝ) (eligible : Finset (Fin N)) (B : ℕ)
    (f : Fin N ↪ P) (hlabel : ∀ j, label (old j) = f j) (target : Fin t ↪ P)
    (e : distinctPromotedTargetSlots f target ↪ eligible)
    (hmatch : ∀ s : distinctPromotedTargetSlots f target, f (e s).val = target s.val)
    (phase : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ eligible) → UnrestrictedFreshLabels P promotions → ℂ)
    (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ) :
    unrestrictedEdgeAction source old label seed transport hit μ ρ V eligible B
      (fun stores promotions g fresh =>
        if FixedTargetEdgeEventValid f target ⟨promotions, g, fresh⟩
          then phase stores promotions g fresh else 0) F =
      ∑ stores : Finset (Fin t),
        (unrestrictedEdgeEventMass source old seed transport hit μ ρ V stores
          (distinctPromotedTargetSlots f target) e (distinctCanonicalFresh f target) : ℂ) *
        phase stores (distinctPromotedTargetSlots f target) e (distinctCanonicalFresh f target) *
        (if (unrestrictedEdgeOutput source old seed transport stores
            (distinctPromotedTargetSlots f target) e).1 ≤ B then
          F target (unrestrictedEdgeOutput source old seed transport stores
            (distinctPromotedTargetSlots f target) e) else 0) := by
  classical
  unfold unrestrictedEdgeAction
  apply sum_congr rfl
  intro stores _
  have h := sum_fixed_target_edge_subsets_injections_fresh f target eligible e hmatch
    (fun event : FixedTargetEdgeEvent (Fin t) (Fin N) P eligible =>
      (unrestrictedEdgeEventMass source old seed transport hit μ ρ V stores
        event.1 event.2.1 event.2.2 : ℂ) *
      phase stores event.1 event.2.1 event.2.2 *
      (if (unrestrictedEdgeOutput source old seed transport stores event.1 event.2.1).1 ≤ B then
        F (unrestrictedEdgeTarget old label event.1 event.2.1 event.2.2)
          (unrestrictedEdgeOutput source old seed transport stores event.1 event.2.1) else 0))
  dsimp only [fixedTargetCanonicalEvent] at h
  rw [distinct_unrestricted_edge_target old label f hlabel target eligible e hmatch] at h
  refine Eq.trans ?_ h
  apply sum_congr rfl
  intro U _
  apply sum_congr rfl
  intro g _
  apply sum_congr rfl
  intro fresh _
  by_cases hv : FixedTargetEdgeEventValid f target ⟨U, g, fresh⟩ <;>
    simp only [hv, if_true, if_false, mul_zero, zero_mul]
end

section
open Finset
open scoped Classical
/-- The actual fixed-target restricted action vanishes if a required old
index is ineligible. No condition on the event factor or continuation is needed. -/
theorem unrestricted_edge_action_fixed_target_of_ineligible {P Z : Type*}
    [Fintype P] [DecidableEq P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (label : Z → P)
    (seed : P → Z) (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ)
    (ρ V : ℝ) (eligible : Finset (Fin N)) (B : ℕ)
    (f : Fin N ↪ P) (target : Fin t ↪ P)
    (h : ¬ univ.filter (fun j => f j ∈ univ.image target) ⊆ eligible)
    (phase : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ eligible) → UnrestrictedFreshLabels P promotions → ℂ)
    (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ) :
    unrestrictedEdgeAction source old label seed transport hit μ ρ V eligible B
      (fun stores promotions e fresh =>
        if FixedTargetEdgeEventValid f target ⟨promotions, e, fresh⟩
          then phase stores promotions e fresh else 0) F = 0 := by
  unfold unrestrictedEdgeAction
  apply sum_eq_zero
  intro stores _
  apply sum_eq_zero
  intro promotions _
  apply sum_eq_zero
  intro e _
  apply sum_eq_zero
  intro fresh _
  have hn := fixed_target_edge_event_invalid_of_ineligible f target eligible h
    ⟨promotions, e, fresh⟩
  simp only [if_neg hn, mul_zero, zero_mul]

/-- The actual edge action restricted to a fixed distinct target has a complete
eligibility dichotomy. Its storage sum retains the arbitrary complex event
factor, coupled continuation, and cutoff of the actual output memory. -/
theorem unrestricted_edge_action_fixed_target_eq_if {P Z : Type*}
    [Fintype P] [DecidableEq P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (label : Z → P)
    (seed : P → Z) (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ)
    (ρ V : ℝ) (eligible : Finset (Fin N)) (B : ℕ)
    (f : Fin N ↪ P) (hlabel : ∀ j, label (old j) = f j) (target : Fin t ↪ P)
    (phase : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ eligible) → UnrestrictedFreshLabels P promotions → ℂ)
    (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ) :
    unrestrictedEdgeAction source old label seed transport hit μ ρ V eligible B
      (fun stores promotions e fresh =>
        if FixedTargetEdgeEventValid f target ⟨promotions, e, fresh⟩
          then phase stores promotions e fresh else 0) F =
      if h : univ.filter (fun j => f j ∈ univ.image target) ⊆ eligible then
        let e := canonicalEligiblePromotion f target eligible h
        ∑ stores : Finset (Fin t),
          (unrestrictedEdgeEventMass source old seed transport hit μ ρ V stores
            (distinctPromotedTargetSlots f target) e (distinctCanonicalFresh f target) : ℂ) *
          phase stores (distinctPromotedTargetSlots f target) e (distinctCanonicalFresh f target) *
          (if (unrestrictedEdgeOutput source old seed transport stores
              (distinctPromotedTargetSlots f target) e).1 ≤ B then
            F target (unrestrictedEdgeOutput source old seed transport stores
              (distinctPromotedTargetSlots f target) e) else 0)
      else 0 := by
  split_ifs with h
  · exact unrestricted_edge_action_fixed_target source old label seed transport hit μ ρ V
      eligible B f hlabel target (canonicalEligiblePromotion f target eligible h)
      (canonical_eligible_promotion_matches f target eligible h) phase F
  · exact unrestricted_edge_action_fixed_target_of_ineligible source old label seed transport hit
      μ ρ V eligible B f target h phase F
end

section
open Finset
/-- A particle read at an equal label, with its residue transported through
the label equality. -/
def ghostPhaseParticleReadout {P : Type*} {R : P → Type*}
    (particle : Σ p, R p) (p : P) (h : particle.1 = p) : GhostPhaseState (R p) :=
  h ▸ some (some (some particle.2))

theorem ghost_phase_particle_readout_eq {P : Type*} {R : P → Type*}
    (z : (p : P) → GhostPhaseState (R p)) (particle : Σ p, R p)
    (hp : z particle.1 = some (some (some particle.2)))
    (p : P) (h : particle.1 = p) : ghostPhaseParticleReadout particle p h = z p := by
  cases h
  exact hp.symm

theorem ghost_phase_particle_readout_congr {P : Type*} {R : P → Type*}
    (x y : Σ p, R p) (p : P) (hx : x.1 = p) (hy : y.1 = p) (h : x = y) :
    ghostPhaseParticleReadout x p hx = ghostPhaseParticleReadout y p hy := by
  subst y
  rfl

/-- Prefer a pending particle at each represented label, using the base phase
at all other labels. The choice is harmless whenever all particles agree
with one phase configuration, even without a distinctness hypothesis. -/
noncomputable def ghostPhaseMemoryReadout {P : Type*} {R : P → Type*}
    (base : (p : P) → GhostPhaseState (R p))
    (memory : FiniteOrderedTuple (Σ p, R p)) : (p : P) → GhostPhaseState (R p) := by
  classical
  exact fun p => if h : ∃ j, (memory.2 j).1 = p then
    ghostPhaseParticleReadout (memory.2 h.choose) p h.choose_spec else base p

/-- On a tuple with distinct labels, reading any represented coordinate
returns its specified particle independently of the internal choice. -/
theorem ghost_phase_memory_readout_at {P : Type*} {R : P → Type*}
    (base : (p : P) → GhostPhaseState (R p))
    (memory : FiniteOrderedTuple (Σ p, R p))
    (hinj : Function.Injective (Sigma.fst ∘ memory.2)) (j : Fin memory.1) :
    ghostPhaseMemoryReadout base memory (memory.2 j).1 =
      some (some (some (memory.2 j).2)) := by
  classical
  have h : ∃ k, (memory.2 k).1 = (memory.2 j).1 := ⟨j, rfl⟩
  rw [ghostPhaseMemoryReadout, dif_pos h]
  have hj : h.choose = j := hinj h.choose_spec
  exact ghost_phase_particle_readout_congr (memory.2 h.choose) (memory.2 j)
    (memory.2 j).1 h.choose_spec rfl (congrArg memory.2 hj)

/-- Reindexing a distinct-label memory does not change its readout. No such
claim is made here for duplicate labels carrying conflicting residues. -/
theorem ghost_phase_memory_readout_reindex {P : Type*} {R : P → Type*}
    (base : (p : P) → GhostPhaseState (R p))
    (memory : FiniteOrderedTuple (Σ p, R p))
    (hinj : Function.Injective (Sigma.fst ∘ memory.2))
    {n : ℕ} (e : Fin n ≃ Fin memory.1) :
    ghostPhaseMemoryReadout base ⟨n, memory.2 ∘ e⟩ =
      ghostPhaseMemoryReadout base memory := by
  classical
  funext p
  by_cases h : ∃ j, (memory.2 j).1 = p
  · have hnew : ∃ j : Fin n, ((memory.2 ∘ e) j).1 = p := by
      refine ⟨e.symm h.choose, ?_⟩
      simpa only [Function.comp_apply, e.apply_symm_apply] using h.choose_spec
    rw [ghostPhaseMemoryReadout, dif_pos hnew, ghostPhaseMemoryReadout, dif_pos h]
    apply ghost_phase_particle_readout_congr
    apply congrArg memory.2
    apply hinj
    exact hnew.choose_spec.trans h.choose_spec.symm
  · have hnew' : ¬ ∃ j : Fin n, ((memory.2 ∘ e) j).1 = p := by
      rintro ⟨j, hj⟩
      exact h ⟨e j, hj⟩
    simp only [ghostPhaseMemoryReadout, dif_neg h, dif_neg hnew']

/-- Complete support, particle agreement, and agreement of the base off the
support identify the entire configuration, not only its pending coordinates. -/
theorem ghost_phase_memory_readout_eq {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (base z : (p : P) → GhostPhaseState (R p))
    (memory : FiniteOrderedTuple (Σ p, R p))
    (hsupport : univ.image (fun j => (memory.2 j).1) = ghostPhasePendingSupport z)
    (hparticle : ∀ j, z (memory.2 j).1 = some (some (some (memory.2 j).2)))
    (hbase : ∀ p, p ∉ ghostPhasePendingSupport z → base p = z p) :
    ghostPhaseMemoryReadout base memory = z := by
  classical
  funext p
  by_cases h : ∃ j, (memory.2 j).1 = p
  · rw [ghostPhaseMemoryReadout, dif_pos h]
    exact ghost_phase_particle_readout_eq z (memory.2 h.choose)
      (hparticle h.choose) p h.choose_spec
  · rw [ghostPhaseMemoryReadout, dif_neg h]
    apply hbase p
    rw [← hsupport]
    simpa only [mem_image, mem_univ, true_and] using h

/-- With distinct labels the literal tuple length equals its pending-support
cardinality. This supplies the actual output memory-sector index. -/
theorem ghost_phase_memory_length_eq {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (z : (p : P) → GhostPhaseState (R p))
    (memory : FiniteOrderedTuple (Σ p, R p))
    (hinj : Function.Injective (Sigma.fst ∘ memory.2))
    (hsupport : univ.image (fun j => (memory.2 j).1) = ghostPhasePendingSupport z) :
    memory.1 = (ghostPhasePendingSupport z).card := by
  rw [← hsupport, card_image_of_injective _
    (show Function.Injective (fun j => (memory.2 j).1) from hinj), card_univ,
    Fintype.card_fin]

/-- Away from the selected output's pending support, storage cannot have
occurred, so the edge base already agrees with the selected moving output. -/
theorem ghost_phase_moving_base_eq_outside_pending {P : Type*} [Fintype P]
    {R : P → Type*} [∀ p, AddGroup (R p)] (atgt asrc store : P → Bool)
    (delta : (p : P) → R p) (w : (p : P) → GhostPhaseState (R p))
    (p : P) (hp : p ∉ ghostPhasePendingSupport
      (fun q => ghostPhaseMovingChoiceTarget (atgt q) (asrc q) (delta q) (store q) (w q))) :
    ghostPhaseEdgeBaseTarget (atgt p) (asrc p) (ghostPhaseShift (delta p) (w p)) =
      ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p) (store p) (w p) := by
  classical
  cases hs : store p
  · simp only [ghostPhaseMovingChoiceTarget, Bool.false_eq_true, ↓reduceIte]
  · exfalso
    apply hp
    simp only [ghostPhasePendingSupport, mem_filter, mem_univ, true_and]
    exact ⟨-delta p, ghost_phase_moving_choice_stored _ _ _ _ _ hs⟩

section ActualOutput

variable {P : Type*} [Fintype P] [DecidableEq P]
  {R : P → Type*} [∀ p, AddGroup (R p)] {t N : ℕ}
  (source : Fin t ↪ P) (stores promotions : Finset (Fin t))
  (atgt asrc : P → Bool) (delta : (p : P) → R p)
  (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
  (hsource : ∀ j, asrc (source j) = true)
  (hstores : ∀ j ∈ stores, atgt (source j) = false)
  (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
  (old : (j : Fin N) → R (f.val j))
  {eligible : Finset (Fin N)} (e : promotions ↪ ↥eligible)
  (he : ∀ j, j ∈ promotionSelectedIndices e ↔ atgt (f.val j) = true)

include hw hsource hstores he

/-- Reading the literal retained-and-stored unrestricted edge output over the
moving edge base recovers the entire selected phase output. -/
theorem distinct_unrestricted_output_readout
    (hold : ∀ j, w (f.val j) = some (some (some (old j)))) :
    ghostPhaseMemoryReadout
      (fun p => ghostPhaseEdgeBaseTarget (atgt p) (asrc p) (ghostPhaseShift (delta p) (w p)))
      (unrestrictedEdgeOutput source (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
        (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) stores promotions e) =
      fun p => ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p)
        (distinctUnrestrictedStorageChoice source stores p) (w p) := by
  apply ghost_phase_memory_readout_eq
  · exact distinct_unrestricted_output_support source stores promotions atgt asrc delta w
      hw hsource hstores f old e he
  · exact distinct_unrestricted_output_particle source stores promotions atgt asrc delta w
      hw hsource hstores f old e he hold
  · exact ghost_phase_moving_base_eq_outside_pending atgt asrc
      (distinctUnrestrictedStorageChoice source stores) delta w

/-- The literal unrestricted output lies in precisely the memory sector
indexed by the selected phase output's pending-support cardinality. -/
theorem distinct_unrestricted_output_length :
    (unrestrictedEdgeOutput source (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
      (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) stores promotions e).1 =
      (ghostPhasePendingSupport (fun p => ghostPhaseMovingChoiceTarget (atgt p) (asrc p)
        (delta p) (distinctUnrestrictedStorageChoice source stores p) (w p))).card := by
  apply ghost_phase_memory_length_eq
  · exact distinct_unrestricted_output_label_injective source stores promotions atgt asrc
      delta w hw hsource hstores f old e
  · exact distinct_unrestricted_output_support source stores promotions atgt asrc delta w
      hw hsource hstores f old e he

end ActualOutput
end

section
open Finset
open scoped Classical
theorem unrestricted_fixed_target_phase_coefficients {P : Type*}
    [Fintype P] [DecidableEq P] {R : P → Type*}
    [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    {N t : ℕ} (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (source target : Fin t ↪ P)
    (hsource : ∀ j, asrc (source j) = true)
    (hdepart : ∀ j, atgt (source j) = false)
    (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
    (old : (j : Fin N) → R (f.val j))
    (hold : ∀ j, w (f.val j) = some (some (some (old j))))
    (eligible : Finset (Fin N)) (e : distinctPromotedTargetSlots f.val target ↪ eligible)
    (hmatch : ∀ s : distinctPromotedTargetSlots f.val target, f.val (e s).val = target s.val)
    (hc : ∀ p, ghostPhaseMovingEdgeCompatible (atgt p) (asrc p) (delta p) (w p) = true)
    (β : P → ℝ) (ρ V : ℝ) (B : ℕ)
    (phase : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ eligible) → UnrestrictedFreshLabels P promotions → ℂ)
    (F : (Fin t → P) → FiniteOrderedTuple (Σ p, R p) → ℂ) :
    unrestrictedEdgeAction source (fun j => (⟨f.val j, old j⟩ : Σ p, R p)) Sigma.fst
      (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) (fun z => z.2 = 0)
      (fun p => β p / V) ρ V eligible B
      (fun stores promotions g fresh =>
        if FixedTargetEdgeEventValid f.val target ⟨promotions, g, fresh⟩
          then phase stores promotions g fresh else 0) F =
      ∑ stores : Finset (Fin t),
        ((∏ p, (if atgt p && !(asrc p) then V⁻¹ else 1) *
          ghostPhaseDampedMovingEdge (atgt p) (asrc p) (delta p) (β p) ρ ρ
            (ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p)
              (distinctUnrestrictedStorageChoice source stores p) (w p)) (w p) : ℝ) : ℂ) *
        phase stores (distinctPromotedTargetSlots f.val target) e
          (distinctCanonicalFresh f.val target) *
        (if (unrestrictedEdgeOutput source (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
            (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) stores
            (distinctPromotedTargetSlots f.val target) e).1 ≤ B then
          F target (unrestrictedEdgeOutput source (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
            (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) stores
            (distinctPromotedTargetSlots f.val target) e) else 0) := by
  rw [unrestricted_edge_action_fixed_target source
    (fun j => (⟨f.val j, old j⟩ : Σ p, R p)) Sigma.fst
    (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) (fun z => z.2 = 0)
    (fun p => β p / V) ρ V eligible B f.val (fun _ => rfl) target e hmatch phase F]
  apply sum_congr rfl
  intro stores _
  rw [distinct_unrestricted_phase_event_mass atgt asrc delta w hw source target stores
    hsource (fun j _ => hdepart j) htarget f old hold eligible e hmatch hc β ρ V]
end

section
open Finset
open scoped Classical
theorem distinct_unrestricted_phase_row {P : Type*}
    [Fintype P] [DecidableEq P] {R : P → Type*}
    [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    {N t : ℕ} (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (source target : Fin t ↪ P)
    (hsource : univ.image source = ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt)
    (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
    (old : (j : Fin N) → R (f.val j))
    (hold : ∀ j, w (f.val j) = some (some (some (old j))))
    (eligible : Finset (Fin N)) (e : distinctPromotedTargetSlots f.val target ↪ eligible)
    (hmatch : ∀ s : distinctPromotedTargetSlots f.val target, f.val (e s).val = target s.val)
    (hc : ∀ p, ghostPhaseMovingEdgeCompatible (atgt p) (asrc p) (delta p) (w p) = true)
    (β : P → ℝ) (ρ V : ℝ) (B : ℕ)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) :
    unrestrictedEdgeAction source (fun j => (⟨f.val j, old j⟩ : Σ p, R p)) Sigma.fst
      (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) (fun z => z.2 = 0)
      (fun p => β p / V) ρ V eligible B
      (fun _stores promotions g fresh =>
        if FixedTargetEdgeEventValid f.val target ⟨promotions, g, fresh⟩ then 1 else 0)
      (fun _ q => F (ghostPhaseMemoryReadout
        (fun p => ghostPhaseEdgeBaseTarget (atgt p) (asrc p) (ghostPhaseShift (delta p) (w p))) q)) =
      ∑ z, ((∏ p, (if atgt p && !(asrc p) then V⁻¹ else 1) *
        ghostPhaseDampedMovingEdge (atgt p) (asrc p) (delta p) (β p) ρ ρ (z p) (w p) : ℝ) : ℂ) *
        (if (ghostPhasePendingSupport z).card ≤ B then F z else 0) := by
  have hsrc : ∀ j, asrc (source j) = true ∧ atgt (source j) = false := by
    intro j
    have hj : source j ∈ univ.image source := mem_image.mpr ⟨j, mem_univ _, rfl⟩
    rw [hsource] at hj
    simpa [ghostPhaseActivitySupport] using hj
  have he := distinct_phase_event_selected atgt asrc w hw f target htarget eligible e hmatch
  rw [unrestricted_fixed_target_phase_coefficients atgt asrc delta w hw source target
    (fun j => (hsrc j).1) (fun j => (hsrc j).2) htarget f old hold eligible e hmatch hc β ρ V B
    (fun _ _ _ _ => 1)]
  rw [ghost_phase_measured_edge_complex_slots atgt asrc delta β ρ ρ V w hw source hsource]
  simp only [powerset_univ]
  apply sum_congr rfl
  intro stores _
  simp only [mul_one]
  rw [distinct_unrestricted_output_readout source stores _ atgt asrc delta w hw
    (fun j => (hsrc j).1) (fun j _ => (hsrc j).2) f old e he hold,
    distinct_unrestricted_output_length source stores _ atgt asrc delta w hw
      (fun j => (hsrc j).1) (fun j _ => (hsrc j).2) f old e he]
  rw [ghost_phase_run_normalized_edge_fresh_measure atgt asrc
    (distinctUnrestrictedStorageChoice source stores) delta β ρ ρ V w hw
      (distinct_unrestricted_storage_allowed source stores atgt asrc
        (fun j => (hsrc j).1) (fun j _ => (hsrc j).2))]
  rfl
end

section
open Finset
/-- The tuple contains each pending label of its reconstructed phase exactly
once, with no additional pending labels contributed by the base. -/
def GhostPhaseReadoutSupported {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (base : (p : P) → GhostPhaseState (R p))
    (q : FiniteOrderedTuple (Σ p, R p)) : Prop :=
  Function.Injective (Sigma.fst ∘ q.2) ∧
    univ.image (fun j => (q.2 j).1) = ghostPhasePendingSupport (ghostPhaseMemoryReadout base q)

/-- Read the phase test on complete distinct particle memories, and extend by
zero on all other tuples, including repeated numerical labels. -/
noncomputable def symmetricPhaseReadout {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (base : (p : P) → GhostPhaseState (R p))
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ)
    (q : FiniteOrderedTuple (Σ p, R p)) : ℂ := by
  classical
  exact if GhostPhaseReadoutSupported base q then F (ghostPhaseMemoryReadout base q) else 0

/-- Reindexing a tuple leaves its numerical-label image unchanged. -/
theorem ghost_phase_memory_label_image_reindex {P : Type*} [DecidableEq P]
    {R : P → Type*} (q : FiniteOrderedTuple (Σ p, R p))
    {n : ℕ} (e : Fin n ≃ Fin q.1) :
    univ.image (fun j => ((q.2 ∘ e) j).1) = univ.image (fun j => (q.2 j).1) := by
  ext p
  simp only [mem_image, mem_univ, true_and, Function.comp_apply]
  constructor
  · rintro ⟨j, hj⟩
    exact ⟨e j, hj⟩
  · rintro ⟨j, hj⟩
    exact ⟨e.symm j, by simpa only [e.apply_symm_apply] using hj⟩

/-- Support of the zero extension is invariant under arbitrary finite tuple
reindexings, including when labels are repeated. -/
theorem ghost_phase_readout_supported_reindex {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (base : (p : P) → GhostPhaseState (R p))
    (q : FiniteOrderedTuple (Σ p, R p)) {n : ℕ} (e : Fin n ≃ Fin q.1) :
    GhostPhaseReadoutSupported base ⟨n, q.2 ∘ e⟩ ↔ GhostPhaseReadoutSupported base q := by
  have hinj : Function.Injective (Sigma.fst ∘ (q.2 ∘ e)) ↔
      Function.Injective (Sigma.fst ∘ q.2) := by
    constructor
    · intro h i j hij
      apply e.symm.injective
      apply h
      simpa only [Function.comp_apply, e.apply_symm_apply] using hij
    · intro h i j hij
      exact e.injective (h hij)
  constructor
  · rintro ⟨hi, hs⟩
    have hi' := hinj.mp hi
    refine ⟨hi', ?_⟩
    simpa only [ghost_phase_memory_label_image_reindex q e,
      ghost_phase_memory_readout_reindex base q hi' e] using hs
  · rintro ⟨hi, hs⟩
    refine ⟨hinj.mpr hi, ?_⟩
    simpa only [ghost_phase_memory_label_image_reindex q e,
      ghost_phase_memory_readout_reindex base q hi e] using hs

/-- An arbitrary phase test gives an ordered-tuple symmetric zero extension. -/
theorem symmetric_phase_readout_symmetric {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (base : (p : P) → GhostPhaseState (R p))
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) :
    OrderedTupleSymmetric (symmetricPhaseReadout base F) := by
  classical
  intro n q e
  have hs := ghost_phase_readout_supported_reindex base ⟨n, q⟩ e
  by_cases h : GhostPhaseReadoutSupported base ⟨n, q⟩
  · simp only [symmetricPhaseReadout, if_pos h, if_pos (hs.mpr h),
      ghost_phase_memory_readout_reindex base ⟨n, q⟩ h.1 e]
  · have hn : ¬ GhostPhaseReadoutSupported base ⟨n, q ∘ e⟩ := fun hq => h (hs.mp hq)
    simp only [symmetricPhaseReadout, if_neg h, if_neg hn]

/-- On a complete distinct reconstruction the extension is the original phase
test, not merely a bound on that test. -/
theorem symmetric_phase_readout_eq_of_reconstruction {P : Type*}
    [Fintype P] [DecidableEq P] {R : P → Type*}
    (base z : (p : P) → GhostPhaseState (R p))
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ)
    (q : FiniteOrderedTuple (Σ p, R p))
    (hinj : Function.Injective (Sigma.fst ∘ q.2))
    (hsupport : univ.image (fun j => (q.2 j).1) = ghostPhasePendingSupport z)
    (hread : ghostPhaseMemoryReadout base q = z) :
    symmetricPhaseReadout base F q = F z := by
  classical
  have hs : GhostPhaseReadoutSupported base q := ⟨hinj, by rw [hread]; exact hsupport⟩
  rw [symmetricPhaseReadout, if_pos hs, hread]

/-- The original pending-cardinality weight transfers to literal tuple length.
Unsupported tuples contribute zero, so no positivity or symmetry of F is used. -/
theorem symmetric_phase_readout_norm_le {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (base : (p : P) → GhostPhaseState (R p))
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ)
    (C v : ℝ) (hC : 0 ≤ C) (hv : 0 ≤ v)
    (hF : ∀ z, ‖F z‖ ≤ C * v ^ (ghostPhasePendingSupport z).card)
    (q : FiniteOrderedTuple (Σ p, R p)) :
    ‖symmetricPhaseReadout base F q‖ ≤ C * v ^ q.1 := by
  classical
  by_cases hs : GhostPhaseReadoutSupported base q
  · rw [symmetricPhaseReadout, if_pos hs]
    have hl := ghost_phase_memory_length_eq (ghostPhaseMemoryReadout base q) q hs.1 hs.2
    rw [hl]
    exact hF _
  · rw [symmetricPhaseReadout, if_neg hs, norm_zero]
    exact mul_nonneg hC (pow_nonneg hv _)

section ActualOutput

variable {P : Type*} [Fintype P] [DecidableEq P]
  {R : P → Type*} [∀ p, AddGroup (R p)] {t N : ℕ}
  (source : Fin t ↪ P) (stores promotions : Finset (Fin t))
  (atgt asrc : P → Bool) (delta : (p : P) → R p)
  (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
  (hsource : ∀ j, asrc (source j) = true)
  (hstores : ∀ j ∈ stores, atgt (source j) = false)
  (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
  (old : (j : Fin N) → R (f.val j))
  {eligible : Finset (Fin N)} (e : promotions ↪ ↥eligible)
  (he : ∀ j, j ∈ promotionSelectedIndices e ↔ atgt (f.val j) = true)

include hw hsource hstores he

/-- The symmetric extension agrees exactly with the phase test on every
actual distinct unrestricted output from the moving edge reconstruction. -/
theorem symmetric_phase_readout_distinct_output
    (hold : ∀ j, w (f.val j) = some (some (some (old j))))
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) :
    symmetricPhaseReadout
      (fun p => ghostPhaseEdgeBaseTarget (atgt p) (asrc p) (ghostPhaseShift (delta p) (w p))) F
      (unrestrictedEdgeOutput source (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
        (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) stores promotions e) =
      F (fun p => ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p)
        (distinctUnrestrictedStorageChoice source stores p) (w p)) := by
  apply symmetric_phase_readout_eq_of_reconstruction
  · exact distinct_unrestricted_output_label_injective source stores promotions atgt asrc delta
      w hw hsource hstores f old e
  · exact distinct_unrestricted_output_support source stores promotions atgt asrc delta
      w hw hsource hstores f old e he
  · exact distinct_unrestricted_output_readout source stores promotions atgt asrc delta
      w hw hsource hstores f old e he hold

end ActualOutput
end

section
open Finset
open scoped Classical
theorem distinct_unrestricted_symmetric_phase_row {P : Type*}
    [Fintype P] [DecidableEq P] {R : P → Type*}
    [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    {N t : ℕ} (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (source target : Fin t ↪ P)
    (hsource : univ.image source = ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt)
    (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
    (old : (j : Fin N) → R (f.val j))
    (hold : ∀ j, w (f.val j) = some (some (some (old j))))
    (eligible : Finset (Fin N)) (e : distinctPromotedTargetSlots f.val target ↪ eligible)
    (hmatch : ∀ s : distinctPromotedTargetSlots f.val target, f.val (e s).val = target s.val)
    (hc : ∀ p, ghostPhaseMovingEdgeCompatible (atgt p) (asrc p) (delta p) (w p) = true)
    (β : P → ℝ) (ρ V : ℝ) (B : ℕ)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) :
    unrestrictedEdgeAction source (fun j => (⟨f.val j, old j⟩ : Σ p, R p)) Sigma.fst
      (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) (fun z => z.2 = 0)
      (fun p => β p / V) ρ V eligible B
      (fun _stores promotions g fresh =>
        if FixedTargetEdgeEventValid f.val target ⟨promotions, g, fresh⟩ then 1 else 0)
      (fun _ q => symmetricPhaseReadout
        (fun p => ghostPhaseEdgeBaseTarget (atgt p) (asrc p) (ghostPhaseShift (delta p) (w p))) F q) =
      ∑ z, ((∏ p, (if atgt p && !(asrc p) then V⁻¹ else 1) *
        ghostPhaseDampedMovingEdge (atgt p) (asrc p) (delta p) (β p) ρ ρ (z p) (w p) : ℝ) : ℂ) *
        (if (ghostPhasePendingSupport z).card ≤ B then F z else 0) := by
  have hsrc : ∀ j, asrc (source j) = true ∧ atgt (source j) = false := by
    intro j
    have hj : source j ∈ univ.image source := mem_image.mpr ⟨j, mem_univ _, rfl⟩
    rw [hsource] at hj
    simpa [ghostPhaseActivitySupport] using hj
  have he := distinct_phase_event_selected atgt asrc w hw f target htarget eligible e hmatch
  rw [unrestricted_fixed_target_phase_coefficients atgt asrc delta w hw source target
    (fun j => (hsrc j).1) (fun j => (hsrc j).2) htarget f old hold eligible e hmatch hc β ρ V B
    (fun _ _ _ _ => 1)]
  rw [ghost_phase_measured_edge_complex_slots atgt asrc delta β ρ ρ V w hw source hsource]
  simp only [powerset_univ]
  apply sum_congr rfl
  intro stores _
  simp only [mul_one]
  rw [symmetric_phase_readout_distinct_output source stores _ atgt asrc delta w hw
    (fun j => (hsrc j).1) (fun j _ => (hsrc j).2) f old e he hold F,
    distinct_unrestricted_output_length source stores _ atgt asrc delta w hw
      (fun j => (hsrc j).1) (fun j _ => (hsrc j).2) f old e he]
  rw [ghost_phase_run_normalized_edge_fresh_measure atgt asrc
    (distinctUnrestrictedStorageChoice source stores) delta β ρ ρ V w hw
      (distinct_unrestricted_storage_allowed source stores atgt asrc
        (fun j => (hsrc j).1) (fun j _ => (hsrc j).2))]
  rfl
end

section
open Finset Classical
open scoped ComplexConjugate
/-- The joint weights are real, so conjugation passes through the integral. -/
theorem unrestricted_joint_integral_conj {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ : ℤ) (k a b : ℕ)
    (F : (Fin a → P) → (Fin b → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    conj (unrestrictedJointIntegral n μ Δ k a b F) =
      unrestrictedJointIntegral n μ Δ k a b (fun p s X Y => conj (F p s X Y)) := by
  unfold unrestrictedJointIntegral
  simp only [map_sum, map_mul, Complex.conj_ofReal]

/-- Reversal and conjugation apply to arbitrary complex joint integrands. -/
theorem unrestricted_joint_integral_conj_reverse {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ : ℤ) (k a b : ℕ)
    (F : (Fin a → P) → (Fin b → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    unrestrictedJointIntegral n μ Δ k a b F =
      conj (unrestrictedJointIntegral n μ (-Δ) k b a
        (fun s p Y X => conj (F p s X Y))) := by
  rw [unrestricted_joint_integral_conj]
  simp only [Complex.conj_conj]
  exact unrestricted_joint_integral_reverse n μ Δ k a b F

/-- In a sesquilinear pairing the entire transition coefficient is conjugated
on reversal. The endpoint tests may depend on their respective label tuples. -/
theorem unrestricted_joint_sesquilinear_reverse {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ : ℤ) (k a b : ℕ)
    (f : (Fin a → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (h : (Fin b → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (c : (Fin a → P) → (Fin b → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    unrestrictedJointIntegral n μ Δ k a b
      (fun p s X Y => conj (f p X) * c p s X Y * h s Y) =
      conj (unrestrictedJointIntegral n μ (-Δ) k b a
        (fun s p Y X => conj (h s Y) * conj (c p s X Y) * f p X)) := by
  rw [unrestricted_joint_integral_conj]
  simp only [map_mul, Complex.conj_conj]
  rw [unrestricted_joint_integral_reverse n μ Δ k a b]
  congr 1
  funext s p Y X
  ring

/-- Source and target cutoffs exchange roles together with the endpoint tests. -/
theorem unrestricted_joint_cutoff_sesquilinear_reverse {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ : ℤ) (k a b Bsrc Btgt : ℕ)
    (f : (Fin a → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (h : (Fin b → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (c : (Fin a → P) → (Fin b → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    unrestrictedJointIntegral n μ Δ k a b
      (fun p s X Y => if X.1 ≤ Bsrc ∧ Y.1 ≤ Btgt then
        conj (f p X) * c p s X Y * h s Y else 0) =
      conj (unrestrictedJointIntegral n μ (-Δ) k b a
        (fun s p Y X => if Y.1 ≤ Btgt ∧ X.1 ≤ Bsrc then
          conj (h s Y) * conj (c p s X Y) * f p X else 0)) := by
  rw [unrestricted_joint_integral_conj]
  rw [unrestricted_joint_integral_reverse n μ Δ k a b]
  congr 1
  funext s p Y X
  by_cases hcut : X.1 ≤ Bsrc ∧ Y.1 ≤ Btgt
  · have hrev : Y.1 ≤ Btgt ∧ X.1 ≤ Bsrc := hcut.symm
    simp only [if_pos hcut, if_pos hrev, map_mul, Complex.conj_conj]
    ring
  · have hrev : ¬ (Y.1 ≤ Btgt ∧ X.1 ≤ Bsrc) := fun h => hcut h.symm
    simp only [if_neg hcut, if_neg hrev, map_zero]
end

section
open Finset Classical
/-- The literal ordered output after old-index extraction: translated
survivors followed by translated stored source labels. -/
def unrestrictedRetrievedOutput {P : Type*} {b : ℕ} (n : P → ℕ) (Δ : ℤ)
    (s : Fin b → P) (u : FiniteOrderedTuple (UnrestrictedResidueParticle n)) :
    FiniteOrderedTuple (UnrestrictedResidueParticle n) :=
  unrestrictedJointOutput n Δ u.2 s

theorem unrestricted_edge_memory_eq_retrieved {P : Type*} {N a b : ℕ}
    (n : P → ℕ) (Δ : ℤ) (q : Fin N → UnrestrictedResidueParticle n)
    (s : Fin b → P) {eligible : Finset (Fin N)} (e : Fin a ↪ ↥eligible) :
    unrestrictedEdgeMemory q (unrestrictedResidueTransport n Δ)
        (unrestrictedResidueSeed n ∘ s) e =
      unrestrictedRetrievedOutput n Δ s
        ⟨(unrestrictedEdgeSurvivors e).card,
          retainedOrderedTuple q (unrestrictedEdgeSurvivors e)⟩ := by
  unfold unrestrictedEdgeMemory retainedBirthTuple unrestrictedRetrievedOutput
    unrestrictedJointOutput unrestrictedJointInput
  congr 1
  funext j
  refine Fin.addCases (fun i => ?_) (fun i => ?_) j
  · simp only [Fin.addCases_left]
    rfl
  · simp only [Fin.addCases_right, Function.comp_apply,
      unrestrictedResidueTransport_seed, Int.cast_neg]

/-- Selected residues collapse to one old residue per promoted label. This
is the exact counting-measure identity after factorial retrieval, and permits
arbitrary complex functions of both endpoint memories. -/
theorem unrestricted_extracted_selection_to_joint {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ : ℤ)
    (ban : P → Prop) (k a b : ℕ)
    (F : (Fin a → P) → (Fin b → P) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    (∑ u : Fin k → UnrestrictedResidueParticle n,
      ((∏ j, unrestrictedResidueWeight μ (u j)) / (k.factorial : ℝ)) •
        ∑ x : Fin a → UnrestrictedResidueParticle n,
          if ∀ i, unrestrictedResidueHit (unrestrictedResidueTransport n Δ (x i)) ∧
              ban (x i).1
          then (∏ i, unrestrictedResidueWeight μ (x i)) •
            ∑ s : Fin b → P, (∏ i, μ (s i)) •
              F (fun i => (x i).1) s (retrievalSourceTuple x ⟨k, u⟩)
                (unrestrictedRetrievedOutput n Δ s ⟨k, u⟩)
          else 0) =
      unrestrictedJointIntegral n μ Δ k a b
        (fun p s X Y => if ∀ i, ban (p i) then F p s X Y else 0) := by
  unfold unrestrictedJointIntegral
  apply sum_congr rfl
  intro u hu
  rw [unrestricted_residue_tuple_selection_sum n μ Δ ban a]
  rw [smul_sum]
  apply sum_congr rfl
  intro p hp
  by_cases hban : ∀ i, ban (p i)
  · simp only [if_pos hban, smul_sum, Complex.real_smul]
    apply sum_congr rfl
    intro s hs
    change _ * (_ * (_ * F p s _ _)) = _ * F p s _ _
    rw [← mul_assoc, ← mul_assoc]
    congr 1
    push_cast
    ring
  · simp [hban]


/-- Reindex eligible promotions as all old-index injections with an explicit
translated-hit and dilation indicator. This retains multiplicities of equal
old particles. -/
theorem unrestricted_residue_retrieval_sum {P : Type*} {N a : ℕ}
    (n : P → ℕ) (Δ D : ℤ) (q : Fin N → UnrestrictedResidueParticle n)
    (F : (Fin a → UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    (∑ e : Fin a ↪ ↥(unrestrictedResidueEligible n Δ D q),
      F (fun i => q (e i).val)
        ⟨(unrestrictedEdgeSurvivors e).card,
          retainedOrderedTuple q (unrestrictedEdgeSurvivors e)⟩) =
      ∑ e : Fin a ↪ Fin N,
        if ∀ i, unrestrictedResidueHit (unrestrictedResidueTransport n Δ (q (e i))) ∧
            ¬ (n (q (e i)).1 : ℤ) ∣ D
        then F (fun i => q (e i))
          ⟨(retrievalSurvivorIndices e).card,
            retainedOrderedTuple q (retrievalSurvivorIndices e)⟩ else 0 := by
  have h := promotionChoice_sum_ambient (unrestrictedResidueEligible n Δ D q)
    (fun e : Fin a ↪ Fin N => F (fun i => q (e i))
      ⟨(retrievalSurvivorIndices e).card,
        retainedOrderedTuple q (retrievalSurvivorIndices e)⟩)
  simpa only [unrestrictedEdgeSurvivors, retrievalSurvivorIndices,
    promotionSelectedIndices, unrestrictedResidueEligible_iff_hit,
    Function.Embedding.trans_apply, Function.Embedding.coeFn_mk] using h

/-- Factorial-normalized extraction from the literal eligible-index sum. The
integrand can inspect both endpoint memories, provided the source dependence
is symmetric. -/
theorem unrestricted_residue_retrieval_normalized {P : Type*} [Fintype P]
    {N a : ℕ} (ha : a ≤ N) (n : P → ℕ) [∀ p, NeZero (n p)]
    (μ : P → ℝ) (Δ D : ℤ)
    (F : (Fin a → UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (hF : ∀ x u, OrderedTupleSymmetric (fun X => F x X u)) :
    (∑ q : Fin N → UnrestrictedResidueParticle n,
      ((∏ j, unrestrictedResidueWeight μ (q j) : ℝ) : ℂ) *
        ∑ e : Fin a ↪ ↥(unrestrictedResidueEligible n Δ D q),
          F (fun i => q (e i).val) ⟨N, q⟩
            ⟨(unrestrictedEdgeSurvivors e).card,
              retainedOrderedTuple q (unrestrictedEdgeSurvivors e)⟩) /
        ((N.factorial : ℝ) : ℂ) =
      ((1 / ((N - a).factorial : ℝ) : ℝ) : ℂ) *
        ∑ x : Fin a → UnrestrictedResidueParticle n,
          ∑ u : Fin (N - a) → UnrestrictedResidueParticle n,
            (((∏ i, unrestrictedResidueWeight μ (x i)) *
              ∏ j, unrestrictedResidueWeight μ (u j) : ℝ) : ℂ) *
              if ∀ i, unrestrictedResidueHit (unrestrictedResidueTransport n Δ (x i)) ∧
                  ¬ (n (x i).1 : ℤ) ∣ D
              then F x (retrievalSourceTuple x ⟨N - a, u⟩) ⟨N - a, u⟩ else 0 := by
  let G : (Fin a → UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ := fun x X u =>
    if ∀ i, unrestrictedResidueHit (unrestrictedResidueTransport n Δ (x i)) ∧
        ¬ (n (x i).1 : ℤ) ∣ D then F x X u else 0
  have hG : ∀ x u, OrderedTupleSymmetric (fun X => G x X u) := by
    intro x u m q e
    dsimp only [G]
    split_ifs
    · exact hF x u m q e
    · rfl
  have hnormalize := ordered_retrieval_symmetric_normalized_sum_complex ha
    (unrestrictedResidueWeight μ) G hG
  change _ = _ at hnormalize
  rw [← hnormalize]
  congr 1
  rw [sum_comm]
  apply sum_congr rfl
  intro q hq
  have hs := unrestricted_residue_retrieval_sum n Δ D q (fun x u => F x ⟨N, q⟩ u)
  rw [hs, mul_sum]

/-- The finite ordered transfer block with `a` old promotions and `b`
source labels stored. This is integrated against the full old-memory
factorial measure and the stored active-label product measure. -/
noncomputable def unrestrictedOrderedTransferBlock {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ D : ℤ)
    (N a b : ℕ)
    (F : (Fin a → P) → (Fin b → P) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) : ℂ :=
  (∑ q : Fin N → UnrestrictedResidueParticle n,
    ((∏ j, unrestrictedResidueWeight μ (q j) : ℝ) : ℂ) *
      ∑ e : Fin a ↪ ↥(unrestrictedResidueEligible n Δ D q),
        ∑ s : Fin b → P, ((∏ i, μ (s i) : ℝ) : ℂ) *
          F (fun i => (q (e i).val).1) s ⟨N, q⟩
            (unrestrictedEdgeMemory q (unrestrictedResidueTransport n Δ)
              (unrestrictedResidueSeed n ∘ s) e)) / ((N.factorial : ℝ) : ℂ)

/-- Concrete factorial-weighted ordered promotion/storage events equal the
common-variable integral. The only source hypothesis is permutation symmetry;
target symmetry is not needed for this one-way identification. -/
theorem unrestricted_ordered_transfer_eq_joint {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ D : ℤ)
    {N a : ℕ} (ha : a ≤ N) (b : ℕ)
    (F : (Fin a → P) → (Fin b → P) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (hF : ∀ p s Y, OrderedTupleSymmetric (fun X => F p s X Y)) :
    unrestrictedOrderedTransferBlock n μ Δ D N a b F =
      unrestrictedJointIntegral n μ Δ (N - a) a b
        (fun p s X Y => if ∀ i, ¬ (n (p i) : ℤ) ∣ D then F p s X Y else 0) := by
  let G : (Fin a → UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ := fun x X u =>
    ∑ s : Fin b → P, ((∏ i, μ (s i) : ℝ) : ℂ) *
      F (fun i => (x i).1) s X (unrestrictedRetrievedOutput n Δ s u)
  have hG : ∀ x u, OrderedTupleSymmetric (fun X => G x X u) := by
    intro x u m q e
    apply sum_congr rfl
    intro s hs
    congr 1
    exact hF (fun i => (x i).1) s (unrestrictedRetrievedOutput n Δ s u) m q e
  have hn := unrestricted_residue_retrieval_normalized ha
    n μ Δ D G hG
  unfold unrestrictedOrderedTransferBlock
  simp_rw [unrestricted_edge_memory_eq_retrieved]
  dsimp only [G] at hn
  rw [hn]
  have hsel := unrestricted_extracted_selection_to_joint n μ Δ
    (fun p => ¬ (n p : ℤ) ∣ D) (N - a) a b F
  convert hsel using 1
  rw [sum_comm]
  simp_rw [Complex.real_smul, mul_sum]
  apply sum_congr rfl
  intro u hu
  apply sum_congr rfl
  intro x hx
  by_cases he : ∀ i, unrestrictedResidueHit (unrestrictedResidueTransport n Δ (x i)) ∧
      ¬ (n (x i).1 : ℤ) ∣ D
  · simp only [if_pos he, mul_sum]
    apply sum_congr rfl
    intro s hs
    push_cast
    ring
  · simp only [if_neg he, mul_zero]
  all_goals
    congr 1
    funext p s X Y
    split_ifs <;> rfl

/-- On functions symmetric in both endpoint memories, the actual ordered
transfer block reverses by exchanging promoted/stored counts and negating
displacement. Both directions enforce the same dilation ban. -/
theorem unrestricted_ordered_transfer_reverse {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ D : ℤ)
    (k a b : ℕ)
    (F : (Fin a → P) → (Fin b → P) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (hX : ∀ p s Y, OrderedTupleSymmetric (fun X => F p s X Y))
    (hY : ∀ p s X, OrderedTupleSymmetric (fun Y => F p s X Y)) :
    unrestrictedOrderedTransferBlock n μ Δ D (k + a) a b
      (fun p s X Y => if ∀ i, ¬ (n (s i) : ℤ) ∣ D then F p s X Y else 0) =
    unrestrictedOrderedTransferBlock n μ (-Δ) D (k + b) b a
      (fun s p Y X => if ∀ i, ¬ (n (p i) : ℤ) ∣ D then F p s X Y else 0) := by
  have hforward := unrestricted_ordered_transfer_eq_joint n μ Δ D
    (Nat.le_add_left a k) b
    (fun p s X Y => if ∀ i, ¬ (n (s i) : ℤ) ∣ D then F p s X Y else 0)
    (by
      intro p s Y m q e
      split_ifs
      · exact hX p s Y m q e
      · rfl)
  have hback := unrestricted_ordered_transfer_eq_joint n μ (-Δ) D
    (Nat.le_add_left b k) a
    (fun s p Y X => if ∀ i, ¬ (n (p i) : ℤ) ∣ D then F p s X Y else 0)
    (by
      intro s p X m q e
      split_ifs
      · exact hY p s X m q e
      · rfl)
  simp only [Nat.add_sub_cancel_right] at hforward hback
  rw [hforward, hback, unrestricted_joint_integral_reverse]
  congr 1
  funext s p Y X
  by_cases hp : ∀ i, ¬ (n (p i) : ℤ) ∣ D
  · by_cases hs : ∀ i, ¬ (n (s i) : ℤ) ∣ D
    · simp only [if_pos hp, if_pos hs]
    · simp only [if_pos hp, if_neg hs]
  · by_cases hs : ∀ i, ¬ (n (s i) : ℤ) ∣ D
    · simp only [if_neg hp, if_pos hs]
    · simp only [if_neg hp, if_neg hs]

/-- The forward promotion factor is retained on reversal. Relative to a
reverse edge normalized for `b` promotions, the exact ratio is `V^b/V^a`. -/
theorem unrestricted_ordered_transfer_normalized_reverse {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ D : ℤ)
    (k a b : ℕ) {V : ℝ} (hV : V ≠ 0)
    (F : (Fin a → P) → (Fin b → P) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (hX : ∀ p s Y, OrderedTupleSymmetric (fun X => F p s X Y))
    (hY : ∀ p s X, OrderedTupleSymmetric (fun Y => F p s X Y)) :
    ((1 / V ^ a : ℝ) : ℂ) *
      unrestrictedOrderedTransferBlock n μ Δ D (k + a) a b
        (fun p s X Y => if ∀ i, ¬ (n (s i) : ℤ) ∣ D then F p s X Y else 0) =
    ((V ^ b / V ^ a : ℝ) : ℂ) * (((1 / V ^ b : ℝ) : ℂ) *
      unrestrictedOrderedTransferBlock n μ (-Δ) D (k + b) b a
        (fun s p Y X => if ∀ i, ¬ (n (p i) : ℤ) ∣ D then F p s X Y else 0)) := by
  rw [unrestricted_ordered_transfer_reverse n μ Δ D k a b F hX hY]
  have hratio : (1 / V ^ a : ℝ) = (V ^ b / V ^ a) * (1 / V ^ b) := by
    field_simp
  rw [hratio, Complex.ofReal_mul, mul_assoc]
end

section
open Finset Classical
theorem unrestricted_edge_action_bounded_phase_norm_le_row_mass
    {P Z : Type*} [Fintype P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (label : Z → P)
    (seed : P → Z) (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ)
    {ρ V v C H : ℝ} (hρ : 0 ≤ ρ) (hV : 0 ≤ V) (hv : 0 ≤ v)
    (hC : 0 ≤ C) (hH : 0 ≤ H) (hμ : ∀ p, 0 ≤ μ p)
    (eligible : Finset (Fin N)) (B : ℕ)
    (phase : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥eligible) → UnrestrictedFreshLabels P promotions → ℂ)
    (hphase : ∀ stores promotions e fresh, ‖phase stores promotions e fresh‖ ≤ H)
    (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ)
    (hF : ∀ target memory, memory.1 ≤ B → ‖F target memory‖ ≤ C * v ^ memory.1) :
    ‖unrestrictedEdgeAction source old label seed transport hit μ ρ V eligible B phase F‖ ≤
      (H * C) * unrestrictedEdgeRowMass source old seed transport hit μ ρ V v eligible := by
  unfold unrestrictedEdgeAction unrestrictedEdgeRowMass unrestrictedEdgeChoiceRowMass
  simp_rw [mul_sum]
  refine (norm_sum_le _ _).trans (sum_le_sum fun stores _ => ?_)
  refine (norm_sum_le _ _).trans (sum_le_sum fun promotions _ => ?_)
  refine (norm_sum_le _ _).trans (sum_le_sum fun e _ => ?_)
  refine (norm_sum_le _ _).trans (sum_le_sum fun fresh _ => ?_)
  have hm := unrestrictedEdgeEventMass_nonneg source old seed transport hit μ hρ hV hμ
    stores promotions e fresh
  have hf : ‖(if (unrestrictedEdgeOutput source old seed transport stores promotions e).1 ≤ B then
        F (unrestrictedEdgeTarget old label promotions e fresh)
          (unrestrictedEdgeOutput source old seed transport stores promotions e) else 0 : ℂ)‖ ≤
      C * v ^ (unrestrictedEdgeOutput source old seed transport stores promotions e).1 := by
    split_ifs with hout
    · exact hF _ _ hout
    · simpa only [norm_zero] using mul_nonneg hC (pow_nonneg hv _)
  rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hm]
  calc
    _ ≤ (unrestrictedEdgeEventMass source old seed transport hit μ ρ V stores promotions e fresh * H) *
        (C * v ^ (unrestrictedEdgeOutput source old seed transport stores promotions e).1) :=
      mul_le_mul (mul_le_mul_of_nonneg_left (hphase stores promotions e fresh) hm) hf
        (norm_nonneg _) (mul_nonneg hm hH)
    _ = _ := by ring

/-- Reversing a block interchanges promotion and storage counts. The retained
forward coefficient is implemented by the explicit ratio V^promotions/V^stores. -/
theorem unrestricted_reverse_residue_edge_action_norm_le
    {P : Type*} [Fintype P] {t N : ℕ}
    (n : P → ℕ) (Δ D : ℤ) (source : Fin t → P)
    (old : Fin N → UnrestrictedResidueParticle n) (μ : P → ℝ)
    {ρ V v vmin vmax C : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : vmin ≤ V) (hVhi : V ≤ vmax)
    (hC : 0 ≤ C) (hμ : ∀ p, 0 ≤ μ p) (hmass : ∑ p, μ p ≤ 2)
    (B T : ℕ) (ht : t ≤ T)
    (phase : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥(unrestrictedResidueEligible n Δ D old)) →
        UnrestrictedFreshLabels P promotions → ℂ)
    (hphase : ∀ stores promotions e fresh, ‖phase stores promotions e fresh‖ ≤ 1)
    (F : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (hF : ∀ target memory, memory.1 ≤ B → ‖F target memory‖ ≤ C * v ^ memory.1) :
    ‖unrestrictedResidueEdgeAction n Δ D source old μ ρ V B
        (fun stores promotions e fresh =>
          ((V ^ promotions.card / V ^ stores.card : ℝ) : ℂ) * phase stores promotions e fresh) F‖ ≤
      C * v ^ N * unrestrictedEdgeRowBound ρ v vmin T *
        unrestrictedEdgeReversalBound vmin vmax T := by
  let H := unrestrictedEdgeReversalBound vmin vmax T
  have hH : 0 ≤ H := by
    unfold H unrestrictedEdgeReversalBound
    exact mul_nonneg (pow_nonneg (zero_le_one.trans (le_max_left _ _)) _)
      (pow_nonneg (zero_le_one.trans (le_max_left _ _)) _)
  have hV : 0 ≤ V := (hvmin.trans_le hVlo).le
  have hv0 : 0 ≤ v := (zero_lt_one.trans hv).le
  have hp : ∀ (stores promotions : Finset (Fin t))
      (e : promotions ↪ ↥(unrestrictedResidueEligible n Δ D old))
      (fresh : UnrestrictedFreshLabels P promotions),
      ‖(if unrestrictedResidueStorageAllowed n D source stores then
        ((V ^ promotions.card / V ^ stores.card : ℝ) : ℂ) * phase stores promotions e fresh else 0)‖ ≤ H := by
    intro stores promotions e fresh
    split_ifs
    · rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (div_nonneg (pow_nonneg hV _) (pow_nonneg hV _))]
      calc
        _ ≤ (V ^ promotions.card / V ^ stores.card) * 1 :=
          mul_le_mul_of_nonneg_left (hphase stores promotions e fresh)
            (div_nonneg (pow_nonneg hV _) (pow_nonneg hV _))
        _ ≤ H := by
          rw [mul_one]
          apply unrestricted_edge_reversal_ratio_le hvmin hVlo hVhi T
          · exact ((by simpa using card_le_card (subset_univ stores)) : stores.card ≤ t).trans ht
          · exact ((by simpa using card_le_card (subset_univ promotions)) : promotions.card ≤ t).trans ht
    · simpa only [norm_zero] using hH
  calc
    _ ≤ (H * C) * unrestrictedEdgeRowMass source old (unrestrictedResidueSeed n)
        (unrestrictedResidueTransport n Δ) unrestrictedResidueHit μ ρ V v
          (unrestrictedResidueEligible n Δ D old) :=
      unrestricted_edge_action_bounded_phase_norm_le_row_mass source old Sigma.fst
        (unrestrictedResidueSeed n) (unrestrictedResidueTransport n Δ) unrestrictedResidueHit μ
        hρ0.le hV hv0 hC hH hμ (unrestrictedResidueEligible n Δ D old) B _ hp F hF
    _ ≤ (H * C) * (v ^ N * unrestrictedEdgeRowBound ρ v vmin T) :=
      mul_le_mul_of_nonneg_left
        (unrestricted_edge_row_mass_le source old (unrestrictedResidueSeed n)
          (unrestrictedResidueTransport n Δ) unrestrictedResidueHit μ hρ0 hρ1 hv hvmin hVlo hμ
          hmass (unrestrictedResidueEligible n Δ D old)
          (unrestrictedResidueEligible_translated_hit n Δ D old) T ht) (mul_nonneg hH hC)
    _ = _ := by dsimp [H]; ring
end

section
open Finset Classical
/-- Eligibility for the old tuple `old ∘ τ` is the inverse image under `τ`. -/
def unrestrictedPermutedEligible {N : ℕ} (τ : Equiv.Perm (Fin N))
    (eligible : Finset (Fin N)) : Finset (Fin N) :=
  eligible.map τ.symm.toEmbedding

theorem mem_unrestrictedPermutedEligible {N : ℕ} (τ : Equiv.Perm (Fin N))
    (eligible : Finset (Fin N)) (j : Fin N) :
    j ∈ unrestrictedPermutedEligible τ eligible ↔ τ j ∈ eligible := by
  simp [unrestrictedPermutedEligible]

def unrestrictedEligiblePermEquiv {N : ℕ} (τ : Equiv.Perm (Fin N))
    (eligible : Finset (Fin N)) : eligible ≃ unrestrictedPermutedEligible τ eligible where
  toFun j := ⟨τ.symm j, (mem_unrestrictedPermutedEligible τ eligible _).mpr (by simp)⟩
  invFun j := ⟨τ j, (mem_unrestrictedPermutedEligible τ eligible _).mp j.property⟩
  left_inv j := by ext; simp
  right_inv j := by ext; simp

def unrestrictedPromotionPermEquiv {A : Type*} {N : ℕ} (τ : Equiv.Perm (Fin N))
    (eligible : Finset (Fin N)) :
    (A ↪ ↥eligible) ≃ (A ↪ ↥(unrestrictedPermutedEligible τ eligible)) where
  toFun e := e.trans (unrestrictedEligiblePermEquiv τ eligible).toEmbedding
  invFun e := e.trans (unrestrictedEligiblePermEquiv τ eligible).symm.toEmbedding
  left_inv e := by ext; simp
  right_inv e := by ext; simp

theorem unrestrictedPromotionPermEquiv_val {A : Type*} {N : ℕ}
    (τ : Equiv.Perm (Fin N)) (eligible : Finset (Fin N))
    (e : A ↪ ↥eligible) (a : A) :
    (unrestrictedPromotionPermEquiv τ eligible e a).val = τ.symm (e a).val := rfl

theorem unrestrictedPromotionPermEquiv_selected {A : Type*} [Fintype A] {N : ℕ}
    (τ : Equiv.Perm (Fin N)) (eligible : Finset (Fin N)) (e : A ↪ ↥eligible) :
    promotionSelectedIndices (unrestrictedPromotionPermEquiv τ eligible e) =
      (promotionSelectedIndices e).map τ.symm.toEmbedding := by
  simp only [promotionSelectedIndices, Finset.map_map]
  rfl

theorem unrestrictedPromotionPermEquiv_survivors {A : Type*} [Fintype A] {N : ℕ}
    (τ : Equiv.Perm (Fin N)) (eligible : Finset (Fin N)) (e : A ↪ ↥eligible) :
    unrestrictedEdgeSurvivors (unrestrictedPromotionPermEquiv τ eligible e) =
      (unrestrictedEdgeSurvivors e).map τ.symm.toEmbedding := by
  rw [unrestrictedEdgeSurvivors, unrestrictedPromotionPermEquiv_selected]
  simp [unrestrictedEdgeSurvivors, Finset.map_sdiff]

theorem unrestricted_edge_target_perm {P Z : Type*} {t N : ℕ}
    (old : Fin N → Z) (label : Z → P) (τ : Equiv.Perm (Fin N))
    (promotions : Finset (Fin t)) (eligible : Finset (Fin N))
    (e : promotions ↪ ↥eligible) (fresh : UnrestrictedFreshLabels P promotions) :
    unrestrictedEdgeTarget (old ∘ τ) label promotions
        (unrestrictedPromotionPermEquiv τ eligible e) fresh =
      unrestrictedEdgeTarget old label promotions e fresh := by
  unfold unrestrictedEdgeTarget
  congr 1
  funext i
  simp [Function.comp_apply, unrestrictedPromotionPermEquiv_val]

theorem unrestricted_edge_memory_perm_occupancy {A Z : Type*} [Fintype A]
    [DecidableEq Z] {N b : ℕ} (old : Fin N → Z) (transport : Z → Z)
    (stored : Fin b → Z) (τ : Equiv.Perm (Fin N))
    (eligible : Finset (Fin N)) (e : A ↪ ↥eligible) :
    orderedTupleOccupancy (unrestrictedEdgeMemory (old ∘ τ) transport stored
        (unrestrictedPromotionPermEquiv τ eligible e)) =
      orderedTupleOccupancy (unrestrictedEdgeMemory old transport stored e) := by
  simp only [unrestrictedEdgeMemory, retained_birth_tuple_occupancy]
  rw [unrestrictedPromotionPermEquiv_survivors]
  congr 1
  simp [retainedTupleOccupancy, Finset.sum_map, Function.comp_apply]

theorem unrestricted_edge_memory_perm_symmetric {A Z K : Type*} [Fintype A]
    [Fintype Z] [DecidableEq Z] {N b : ℕ} (old : Fin N → Z) (transport : Z → Z)
    (stored : Fin b → Z) (τ : Equiv.Perm (Fin N))
    (eligible : Finset (Fin N)) (e : A ↪ ↥eligible)
    (F : FiniteOrderedTuple Z → K) (hF : OrderedTupleSymmetric F) :
    F (unrestrictedEdgeMemory (old ∘ τ) transport stored
        (unrestrictedPromotionPermEquiv τ eligible e)) =
      F (unrestrictedEdgeMemory old transport stored e) :=
  symmetric_tuple_equal_on_occupancy F hF _ _
    (unrestricted_edge_memory_perm_occupancy old transport stored τ eligible e)

theorem unrestricted_edge_event_mass_perm {P Z : Type*} [Fintype Z] [DecidableEq Z]
    {t N : ℕ} (source : Fin t → P) (old : Fin N → Z) (seed : P → Z)
    (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ) (ρ V : ℝ)
    (τ : Equiv.Perm (Fin N)) (stores promotions : Finset (Fin t))
    (eligible : Finset (Fin N)) (e : promotions ↪ ↥eligible)
    (fresh : UnrestrictedFreshLabels P promotions) :
    unrestrictedEdgeEventMass source (old ∘ τ) seed transport hit μ ρ V stores promotions
        (unrestrictedPromotionPermEquiv τ eligible e) fresh =
      unrestrictedEdgeEventMass source old seed transport hit μ ρ V stores promotions e fresh := by
  have hc : orderedPredicateCount
        (unrestrictedEdgeMemory (old ∘ τ) transport (unrestrictedStoredTuple source seed stores)
          (unrestrictedPromotionPermEquiv τ eligible e)) hit =
      orderedPredicateCount
        (unrestrictedEdgeMemory old transport (unrestrictedStoredTuple source seed stores) e) hit :=
    unrestricted_edge_memory_perm_symmetric old transport
      (unrestrictedStoredTuple source seed stores) τ eligible e
      (fun q => orderedPredicateCount q hit)
      (fun _ q e' => orderedPredicateCount_permutation q hit e')
  unfold unrestrictedEdgeEventMass unrestrictedEdgeOutput
  rw [orderedPredicateCount_permutation, hc]

/-- The whole finite edge action respects old-index permutation whenever the
phase respects the explicit event correspondence and the output test is symmetric. -/
theorem unrestricted_edge_action_perm {P Z : Type*} [Fintype P] [Fintype Z] [DecidableEq Z]
    {t N : ℕ} (source : Fin t → P) (old : Fin N → Z) (label : Z → P)
    (seed : P → Z) (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ)
    (ρ V : ℝ) (τ : Equiv.Perm (Fin N)) (eligible : Finset (Fin N)) (B : ℕ)
    (phase : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥eligible) → UnrestrictedFreshLabels P promotions → ℂ)
    (phase' : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥(unrestrictedPermutedEligible τ eligible)) →
        UnrestrictedFreshLabels P promotions → ℂ)
    (hphase : ∀ stores promotions e fresh,
      phase' stores promotions (unrestrictedPromotionPermEquiv τ eligible e) fresh =
        phase stores promotions e fresh)
    (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ)
    (hF : ∀ target, OrderedTupleSymmetric (F target)) :
    unrestrictedEdgeAction source (old ∘ τ) label seed transport hit μ ρ V
        (unrestrictedPermutedEligible τ eligible) B phase' F =
      unrestrictedEdgeAction source old label seed transport hit μ ρ V eligible B phase F := by
  unfold unrestrictedEdgeAction
  apply Finset.sum_congr rfl
  intro stores hs
  apply Finset.sum_congr rfl
  intro promotions hp
  rw [← (unrestrictedPromotionPermEquiv (A := ↥promotions) τ eligible).sum_comp]
  apply Finset.sum_congr rfl
  intro e he
  apply Finset.sum_congr rfl
  intro fresh hf
  rw [unrestricted_edge_event_mass_perm, hphase, unrestricted_edge_target_perm]
  have hlength :
      (unrestrictedEdgeOutput source (old ∘ τ) seed transport stores promotions
        (unrestrictedPromotionPermEquiv τ eligible e)).1 =
      (unrestrictedEdgeOutput source old seed transport stores promotions e).1 := by
    simp only [unrestrictedEdgeOutput, unrestrictedEdgeMemory_length]
  rw [hlength]
  congr 2
  exact unrestricted_edge_memory_perm_symmetric old transport
    (unrestrictedStoredTuple source seed stores) τ eligible e _ (hF _)

theorem unrestricted_residue_eligible_perm {P : Type*} {N : ℕ}
    (n : P → ℕ) (Δ D : ℤ) (old : Fin N → UnrestrictedResidueParticle n)
    (τ : Equiv.Perm (Fin N)) :
    unrestrictedResidueEligible n Δ D (old ∘ τ) =
      unrestrictedPermutedEligible τ (unrestrictedResidueEligible n Δ D old) := by
  ext j
  rw [mem_unrestrictedResidueEligible, mem_unrestrictedPermutedEligible,
    mem_unrestrictedResidueEligible]
  rfl

/-- The actual residue edge with phase one sends symmetric memory tests to
symmetric source-memory tests. Storage bans and the total-memory cutoff remain. -/
theorem unrestricted_residue_edge_one_symmetric {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] {t : ℕ} (Δ D : ℤ) (source : Fin t → P)
    (μ : P → ℝ) (ρ V : ℝ) (B : ℕ)
    (F : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (hF : ∀ target, OrderedTupleSymmetric (F target)) :
    OrderedTupleSymmetric (fun old : FiniteOrderedTuple (UnrestrictedResidueParticle n) =>
      unrestrictedResidueEdgeAction n Δ D source old.2 μ ρ V B (fun _ _ _ _ => 1) F) := by
  intro N old τ
  dsimp only
  unfold unrestrictedResidueEdgeAction
  rw [unrestricted_residue_eligible_perm]
  apply unrestricted_edge_action_perm
  · intro stores promotions e fresh
    rfl
  · exact hF
end

section
open Finset
theorem ordered_slot_product_split {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (i : I) (x : ∀ j, choices j) :
    orderedSlotProduct choices x = (x i).val *
      orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) (fun j => x j.val) :=
  Fintype.prod_eq_mul_prod_subtype_ne (fun j => (x j).val) i

theorem ordered_slot_sum_test_split {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (i : I) (F : ℕ → ℝ) :
    (∑ x : ∀ j, choices j, F (orderedSlotProduct choices x)) =
      ∑ p : choices i, ∑ y : ∀ j : {j : I // j ≠ i}, choices j.val,
        F (p.val * orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y) := by
  classical
  let f : choices i × (∀ j : {j : I // j ≠ i}, choices j.val) → ℝ := fun z =>
    F (z.1.val * orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) z.2)
  calc
    _ = ∑ z, f z := by
      apply Fintype.sum_equiv (Equiv.piSplitAt i (fun j => choices j))
      intro x
      simp only [f, Equiv.piSplitAt_apply]
      rw [ordered_slot_product_split choices i x]
    _ = _ := Fintype.sum_prod_type f

theorem ordered_slot_weight_split {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (i : I) (normalization : ℝ) (n : ℕ) :
    orderedSlotWeight choices normalization n =
      ∑ p : choices i, ∑ y : ∀ j : {j : I // j ≠ i}, choices j.val,
        if p.val * orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y = n
        then 1 / normalization else 0 := by
  classical
  unfold orderedSlotWeight
  have h := ordered_slot_sum_test_split choices i (fun m => if m = n then 1 / normalization else 0)
  convert h using 1
  apply Finset.sum_congr
  · ext x
    simp
  · intro x _
    rfl


theorem ordered_slot_harmonic_split {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (i : I) (normalization : ℝ) :
    (∑' n : ℕ, orderedSlotWeight choices normalization n / (n : ℝ)) =
      (∑ p ∈ choices i, 1 / (p : ℝ)) *
        (∑' n : ℕ,
          orderedSlotWeight (fun j : {j : I // j ≠ i} => choices j.val) normalization n / (n : ℝ)) := by
  rw [ordered_slot_harmonic_sum, ordered_slot_harmonic_sum,
    Fintype.prod_eq_mul_prod_subtype_ne (fun j => ∑ p ∈ choices j, 1 / (p : ℝ)) i]
  ring
end

section
open Finset
noncomputable def restrictedSlotChoices {I : Type*} [DecidableEq I]
    (choices restricted : I → Finset ℕ) (E : Finset I) (i : I) : Finset ℕ :=
  if i ∈ E then restricted i else choices i

theorem restricted_slot_harmonic_lower {I : Type*} [Fintype I] [DecidableEq I]
    (choices restricted : I → Finset ℕ) (E : Finset I) {eta normalization : ℝ}
    (heta : 0 ≤ eta) (hnorm : 0 ≤ normalization)
    (hmass : ∀ i ∈ E, eta * (∑ p ∈ choices i, 1 / (p : ℝ)) ≤
      ∑ p ∈ restricted i, 1 / (p : ℝ)) :
    eta^E.card * (∑' n : ℕ, orderedSlotWeight choices normalization n / (n : ℝ)) ≤
      ∑' n : ℕ,
        orderedSlotWeight (restrictedSlotChoices choices restricted E) normalization n / (n : ℝ) := by
  classical
  rw [ordered_slot_harmonic_sum, ordered_slot_harmonic_sum]
  have hprod : eta^E.card * (∏ i, ∑ p ∈ choices i, 1 / (p : ℝ)) ≤
      ∏ i, ∑ p ∈ restrictedSlotChoices choices restricted E i, 1 / (p : ℝ) := by
    have hid : eta^E.card * (∏ i, ∑ p ∈ choices i, 1 / (p : ℝ)) =
        ∏ i, (if i ∈ E then eta else 1) * (∑ p ∈ choices i, 1 / (p : ℝ)) := by
      rw [prod_mul_distrib, prod_ite_mem]
      simp
    rw [hid]
    apply prod_le_prod₀
    · intro i _
      exact mul_nonneg (by split_ifs <;> positivity) (sum_nonneg (fun _ _ => by positivity))
    · intro i _
      by_cases hi : i ∈ E
      · simpa only [restrictedSlotChoices, if_pos hi] using hmass i hi
      · simp only [restrictedSlotChoices, if_neg hi, one_mul, le_refl]
  have h := div_le_div_of_nonneg_right hprod hnorm
  simpa only [mul_div_assoc] using h
end

section
open Finset Filter
open scoped Topology
noncomputable def narrowQBand (s eps : ℝ) (j : ℕ) : Finset ℕ :=
  dyadicPrimeBand s ((11/10 : ℝ) - eps) ((11/10 : ℝ) + eps) j

theorem narrowQBand_subset_candidateQBand {s eps : ℝ} (hs : 0 ≤ s)
    (heps : eps ≤ 1/10) (j : ℕ) : narrowQBand s eps j ⊆ candidateQBand s j := by
  exact dyadicPrimeBand_subset_of_bounds j hs (by linarith) (by linarith)

theorem exists_narrowQBand_harmonic_lower {c eps : ℝ} (hc : 0 < c)
    (heps0 : 0 < eps) (heps1 : eps ≤ 1/10) :
    ∃ v : ℝ, 0 < v ∧ ∀ᶠ L : ℝ in atTop, ∀ j ∈ candidateQIndices c L,
      v ≤ ∑ p ∈ narrowQBand (c * L) eps j, 1 / (p : ℝ) := by
  have ha : 0 < (11/10 : ℝ) - eps := by linarith
  have hab : (11/10 : ℝ) - eps < (11/10 : ℝ) + eps := by linarith
  obtain ⟨v, V, t0, hv, _, _, ht0⟩ :=
    exists_primeBandHarmonic_threshold ((one_lt_div ha).mpr hab)
  refine ⟨v, hv, ?_⟩
  filter_upwards [eventually_candidateQIndices_geometry hc, eventually_gt_atTop (0 : ℝ),
    Real.tendsto_log_atTop.eventually (eventually_ge_atTop (t0 / 20))] with L hg hL ht
  intro j hj
  have hlo := (hg.2 j hj).1
  have hscale : t0 ≤ ((11/10 : ℝ) - eps) * (c * L) / 2^j := by
    have hbase : 0 ≤ c * L / 2^j := by positivity
    have hh : 1 ≤ (11/10 : ℝ) - eps := by linarith
    have hmul := le_mul_of_one_le_left hbase hh
    rw [← mul_div_assoc] at hmul
    linarith
  have h := (ht0 (((11/10 : ℝ) - eps) * (c * L) / 2^j) hscale).1
  rw [← dyadicPrimeBand_harmonic_eq_log_ratio (c * L) ((11/10 : ℝ) - eps)
    ((11/10 : ℝ) + eps) j ha.ne'] at h
  exact h

theorem exists_narrowQBand_harmonic_ratio {c eps : ℝ} (hc : 0 < c)
    (heps0 : 0 < eps) (heps1 : eps ≤ 1/10) :
    ∃ eta : ℝ, 0 < eta ∧ eta ≤ 1 ∧ ∀ᶠ L : ℝ in atTop, ∀ j ∈ candidateQIndices c L,
      eta * (∑ p ∈ candidateQBand (c * L) j, 1 / (p : ℝ)) ≤
        ∑ p ∈ narrowQBand (c * L) eps j, 1 / (p : ℝ) := by
  obtain ⟨v, hv, hnarrow⟩ := exists_narrowQBand_harmonic_lower hc heps0 heps1
  obtain ⟨vl, V, _, hV, hwide⟩ := exists_candidateQBands_bounds hc
  let eta : ℝ := min 1 (v / V)
  have heta : 0 < eta := lt_min zero_lt_one (div_pos hv hV)
  refine ⟨eta, heta, min_le_left _ _, ?_⟩
  filter_upwards [hnarrow, hwide] with L hn hw
  intro j hj
  calc
    eta * (∑ p ∈ candidateQBand (c * L) j, 1 / (p : ℝ)) ≤ eta * V :=
      mul_le_mul_of_nonneg_left ((hw.2.2 j hj).2.2.2) heta.le
    _ ≤ v := (le_div_iff₀ hV).mp (min_le_right _ _)
    _ ≤ _ := hn j hj
end

section
open Finset Filter
open scoped Topology
noncomputable def candidatePrefixSlots (c L : ℝ) (r J : ℕ) :
    Finset ((candidateQIndices c L) × Fin r) := by
  classical
  exact univ.filter (fun slot => slot.1.val ≤ J ∧ ¬(slot.1.val = 0 ∧ slot.2.val = 0))

noncomputable def candidatePrefixChoices (c L eps : ℝ) (r jStar J : ℕ) :
    (candidateQIndices c L) × Fin r → Finset ℕ :=
  restrictedSlotChoices (candidateQSlotChoices c L r jStar)
    (fun slot => narrowQBand (c * L) eps slot.1.val) (candidatePrefixSlots c L r J)

noncomputable def candidatePrefixHarmonicMass (c L eps : ℝ) (r jStar J : ℕ) : ℝ :=
  ∑' n : ℕ,
    orderedSlotWeight (candidatePrefixChoices c L eps r jStar J)
      ((r.factorial : ℝ)^(candidateQIndices c L).card) n / (n : ℝ)

theorem candidatePrefixSlots_card_le (c L : ℝ) (r J : ℕ) :
    (candidatePrefixSlots c L r J).card ≤ (J + 1) * r := by
  classical
  have h := card_le_card_of_injOn (s := candidatePrefixSlots c L r J)
    (t := Icc 0 J ×ˢ (univ : Finset (Fin r)))
    (fun slot => (slot.1.val, slot.2)) (by
      intro slot hslot
      have hJ := (mem_filter.mp hslot).2.1
      exact mem_product.mpr ⟨mem_Icc.mpr ⟨Nat.zero_le _, hJ⟩, mem_univ _⟩) (by
      intro x _ y _ hxy
      exact Prod.ext (Subtype.ext (congrArg (fun z : ℕ × Fin r => z.1) hxy))
        (congrArg (fun z : ℕ × Fin r => z.2) hxy))
  simpa only [card_product, Nat.card_Icc, Nat.sub_zero, card_univ, Fintype.card_fin] using h

theorem candidatePrefixChoices_subset {c L eps : ℝ} (hcL : 0 ≤ c * L)
    (heps : eps ≤ 1/10) {r jStar J : ℕ} (hJ : J < jStar)
    (slot : (candidateQIndices c L) × Fin r) :
    candidatePrefixChoices c L eps r jStar J slot ⊆ candidateQSlotChoices c L r jStar slot := by
  classical
  unfold candidatePrefixChoices restrictedSlotChoices
  split_ifs with hslot
  · have hidx : slot.1.val ≤ J := (mem_filter.mp hslot).2.1
    have hneq : ¬(slot.1.val = jStar ∧ slot.2.val = 0) := by omega
    rw [candidateQSlotChoices, if_neg hneq]
    exact narrowQBand_subset_candidateQBand hcL heps slot.1.val
  · exact subset_rfl

theorem exists_candidate_prefix_harmonic_fraction {c eps : ℝ} (hc : 0 < c)
    (heps0 : 0 < eps) (heps1 : eps ≤ 1/10) (r J : ℕ) :
    ∃ rho : ℝ, 0 < rho ∧ ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, J < jStar →
      rho * candidateQHarmonicMass c L r jStar ≤
        candidatePrefixHarmonicMass c L eps r jStar J := by
  obtain ⟨eta, heta, heta1, hratio⟩ := exists_narrowQBand_harmonic_ratio hc heps0 heps1
  refine ⟨eta^((J + 1) * r), pow_pos heta _, ?_⟩
  filter_upwards [hratio] with L hL
  intro jStar hJ
  have hmass : ∀ slot ∈ candidatePrefixSlots c L r J,
      eta * (∑ p ∈ candidateQSlotChoices c L r jStar slot, 1 / (p : ℝ)) ≤
        ∑ p ∈ narrowQBand (c * L) eps slot.1.val, 1 / (p : ℝ) := by
    intro slot hslot
    have hidx : slot.1.val ≤ J := (mem_filter.mp hslot).2.1
    have hneq : ¬(slot.1.val = jStar ∧ slot.2.val = 0) := by omega
    rw [candidateQSlotChoices, if_neg hneq]
    exact hL slot.1.val slot.1.property
  have h := restricted_slot_harmonic_lower (candidateQSlotChoices c L r jStar)
    (fun slot => narrowQBand (c * L) eps slot.1.val) (candidatePrefixSlots c L r J)
    heta.le (by positivity : 0 ≤ (r.factorial : ℝ)^(candidateQIndices c L).card) hmass
  have hnonneg : 0 ≤ candidateQHarmonicMass c L r jStar := by
    exact tsum_nonneg (fun n => div_nonneg (candidate_Q_weight_nonneg c L r jStar n) (Nat.cast_nonneg n))
  exact (mul_le_mul_of_nonneg_right
    (pow_le_pow_of_le_one heta.le heta1 (candidatePrefixSlots_card_le c L r J)) hnonneg).trans h
end

section
open scoped BigOperators Classical
theorem exists_physical_small_conditioning_log_bound {q v K : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (hK : 0 ≤ K) (ell : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (L : ℝ), 0 < L →
      ∀ (G : Type) [Fintype G] [DecidableEq G],
      (Fintype.card G : ℝ) ≤ K * Real.log L →
      ∀ (P : G → Finset ℕ) (J : ℕ) (V : G → ℝ), (∀ g, v ≤ V g) →
      ∀ (T : Type) (s : Finset T) (r : T → PhysicalResidues P) (μ : T → ℝ),
      (∀ t ∈ s, 0 ≤ μ t) → ∀ w : T → PhysicalMarkLists P J ell → ℂ,
      (∑ t ∈ s, μ t * ∑ d : PhysicalSharedLists P J,
        ‖physicalSmallCondition V q (r t) d (w t)‖ ^ 2) ≤
      L ^ C * ∑ t ∈ s, μ t *
        ∑ x : PhysicalResidueMarksAt P J ell (r t), physicalStateMass V J ell * ‖w t x.val‖ ^ 2 := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_small_conditioning_weighted_energy_bound hq0 hq1 hv ell
  refine ⟨K * Real.log A, mul_nonneg hK (Real.log_nonneg hA), ?_⟩
  intro L hL G _ _ hcard P J V hV T s r μ hμ w
  have hpow : A ^ Fintype.card G ≤ L ^ (K * Real.log A) := by
    simpa only [Finset.prod_const, Finset.card_univ] using
      group_product_bound_of_log_card (Finset.univ : Finset G) (fun _ => A) hA hL
        (fun _ _ => le_trans zero_le_one hA) (fun _ _ => le_rfl)
        (by simpa only [Finset.card_univ] using hcard)
  have hmass : 0 ≤ ∑ t ∈ s, μ t *
      ∑ x : PhysicalResidueMarksAt P J ell (r t), physicalStateMass V J ell * ‖w t x.val‖ ^ 2 := by
    apply Finset.sum_nonneg
    intro t ht
    apply mul_nonneg (hμ t ht)
    apply Finset.sum_nonneg
    intro x _
    exact mul_nonneg (physical_state_mass_pos V (fun g => lt_of_lt_of_le hv (hV g)) J ell).le
      (sq_nonneg _)
  exact (hbound G P J V hV T s r μ hμ w).trans (mul_le_mul_of_nonneg_right hpow hmass)
end

section
open scoped BigOperators Classical
theorem physical_small_bilinear_factorization_with_prefix {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (q ζ : ℝ) (k : ℤ) (r : PhysicalResidues P)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (κ : PhysicalSharedLists P J → ℂ)
    (f : PhysicalMarkLists P J ell → ℂ)
    (g : PhysicalSharedLists P J → PhysicalResidues P → PhysicalMarkLists P J ell → ℂ) :
    let tr := fun d : PhysicalSharedLists P J =>
      physicalTranslateResidues r (k * (physicalSharedProduct d : ℕ))
    (∑ L, ∑ R, (physicalStateMass V J ell : ℂ) * (starRingEnd ℂ) (f L) *
      physicalBarePatternScalar V (fun _ => (∅ : Finset (Fin J))) ζ
        (fun L _ _ => κ (physicalSharedPrefix L)) aux L R *
      ((physicalResidueVertexWeight L (Real.sqrt q) r *
        physicalResidueVertexWeight R (Real.sqrt q) (tr (physicalSharedPrefix L)) : ℝ) : ℂ) *
      g (physicalSharedPrefix L) (tr (physicalSharedPrefix L)) R) =
    ∑ d, (starRingEnd ℂ) (physicalSmallCondition V q r d f) *
      (κ d * physicalPhase ζ (physicalSharedProduct d)) *
      physicalSmallCondition V q (tr d) d (g d (tr d)) := by
  classical
  intro tr
  let s : ℂ := physicalSmallConditioningScale V J ell
  let N : ℂ := (physicalStateMass V J ell *
    physicalCompletionMass V (fun _ => (∅ : Finset (Fin J))) ell : ℝ)
  let a : PhysicalMarkLists P J ell → ℂ := fun L =>
    (physicalResidueVertexWeight L (Real.sqrt q) r : ℂ) * (starRingEnd ℂ) (f L)
  let b : PhysicalSharedLists P J → PhysicalMarkLists P J ell → ℂ := fun d R =>
    (physicalResidueVertexWeight R (Real.sqrt q) (tr d) : ℂ) * g d (tr d) R
  let c : PhysicalSharedLists P J → ℂ := fun d => κ d * physicalPhase ζ (physicalSharedProduct d)
  have hs : (starRingEnd ℂ) s * s = N := by
    dsimp [s, N]
    rw [Complex.conj_ofReal, ← Complex.ofReal_mul, ← pow_two,
      physical_small_conditioning_scale_sq V hV]
  have hf (d : PhysicalSharedLists P J) :
      (starRingEnd ℂ) (physicalSmallCondition V q r d f) =
        (starRingEnd ℂ) s * ∑ L ∈ Finset.univ.filter (fun L => physicalSharedPrefix L = d), a L := by
    rw [physical_small_condition_eq_vertex_sum, map_mul]
    congr 1
    rw [map_sum, Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro L _
    by_cases h : physicalSharedPrefix L = d
    · simp only [if_pos h, map_mul, Complex.conj_ofReal]
      rfl
    · simp only [if_neg h, map_zero]
  have hg (d : PhysicalSharedLists P J) :
      physicalSmallCondition V q (tr d) d (g d (tr d)) =
        s * ∑ R ∈ Finset.univ.filter (fun R => physicalSharedPrefix R = d), b d R := by
    rw [physical_small_condition_eq_vertex_sum, Finset.sum_filter]
  symm
  calc
    _ = N * ∑ d, (∑ L ∈ Finset.univ.filter (fun L => physicalSharedPrefix L = d), a L) * c d *
        (∑ R ∈ Finset.univ.filter (fun R => physicalSharedPrefix R = d), b d R) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro d _
      rw [hf, hg]
      change (starRingEnd ℂ) s * _ * c d * (s * _) = _
      rw [← hs]
      ring
    _ = N * ∑ L, ∑ R, if physicalSharedPrefix L = physicalSharedPrefix R then
        a L * c (physicalSharedPrefix L) * b (physicalSharedPrefix L) R else 0 := by
      rw [finite_fiber_bilinear_sum]
    _ = _ := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro L _
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro R _
      rw [physical_bare_empty_prefix]
      by_cases h : physicalSharedPrefix L = physicalSharedPrefix R
      · simp only [if_pos h]
        dsimp [N, a, b, c]
        push_cast
        ring
      · simp only [if_neg h, mul_zero, zero_mul]
end

section
open Finset Classical
noncomputable def unrestrictedPromotionSlotEquiv {I : Type*} [DecidableEq I] {N : ℕ}
    (T : Finset I) (eligible : Finset (Fin N)) :
    (T ↪ ↥eligible) ≃ (Fin T.card ↪ ↥eligible) :=
  Equiv.embeddingCongr T.equivFin (Equiv.refl _)

theorem unrestrictedPromotionSlotEquiv_apply {I : Type*} [DecidableEq I] {N : ℕ}
    (T : Finset I) (eligible : Finset (Fin N)) (e : T ↪ ↥eligible)
    (i : Fin T.card) :
    unrestrictedPromotionSlotEquiv T eligible e i = e (T.equivFin.symm i) := rfl

theorem unrestrictedPromotionSlotEquiv_selected {I : Type*} [DecidableEq I] {N : ℕ}
    (T : Finset I) (eligible : Finset (Fin N)) (e : T ↪ ↥eligible) :
    promotionSelectedIndices (unrestrictedPromotionSlotEquiv T eligible e) =
      promotionSelectedIndices e := by
  ext j
  simp only [promotionSelectedIndices, mem_map, mem_univ, true_and,
    Function.Embedding.trans_apply, Function.Embedding.coeFn_mk,
    unrestrictedPromotionSlotEquiv_apply]
  constructor
  · rintro ⟨i, hi⟩
    exact ⟨T.equivFin.symm i, hi⟩
  · rintro ⟨i, hi⟩
    exact ⟨T.equivFin i, by simpa using hi⟩

theorem unrestrictedPromotionSlotEquiv_survivors {I : Type*} [DecidableEq I] {N : ℕ}
    (T : Finset I) (eligible : Finset (Fin N)) (e : T ↪ ↥eligible) :
    unrestrictedEdgeSurvivors (unrestrictedPromotionSlotEquiv T eligible e) =
      unrestrictedEdgeSurvivors e := by
  simp only [unrestrictedEdgeSurvivors, unrestrictedPromotionSlotEquiv_selected]

theorem unrestricted_edge_memory_slot_reindex {I Z : Type*} [DecidableEq I] {N b : ℕ}
    (T : Finset I) (eligible : Finset (Fin N)) (e : T ↪ ↥eligible)
    (old : Fin N → Z) (transport : Z → Z) (stored : Fin b → Z) :
    unrestrictedEdgeMemory old transport stored (unrestrictedPromotionSlotEquiv T eligible e) =
      unrestrictedEdgeMemory old transport stored e := by
  simp only [unrestrictedEdgeMemory, unrestrictedPromotionSlotEquiv_survivors]

theorem unrestricted_promotion_slot_sum {I Z E : Type*} [DecidableEq I]
    [AddCommMonoid E] {N b : ℕ} (T : Finset I) (eligible : Finset (Fin N))
    (old : Fin N → Z) (transport : Z → Z) (stored : Fin b → Z)
    (F : (T → Z) → FiniteOrderedTuple Z → E) :
    (∑ e : T ↪ ↥eligible, F (fun i => old (e i).val)
      (unrestrictedEdgeMemory old transport stored e)) =
      ∑ e : Fin T.card ↪ ↥eligible, F (fun i => old (e (T.equivFin i)).val)
        (unrestrictedEdgeMemory old transport stored e) := by
  rw [← (unrestrictedPromotionSlotEquiv T eligible).sum_comp]
  apply sum_congr rfl
  intro e he
  simp only [unrestrictedPromotionSlotEquiv_apply, Equiv.symm_apply_apply,
    unrestricted_edge_memory_slot_reindex]
end

section
open Finset Classical
noncomputable def unrestrictedEdgeSquareMass {P Z : Type*} [Fintype P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (label : Z → P)
    (seed : P → Z) (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ)
    (ρ V v : ℝ) (eligible : Finset (Fin N)) (B : ℕ)
    (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ) : ℝ :=
  ∑ stores : Finset (Fin t), ∑ promotions : Finset (Fin t),
    ∑ e : promotions ↪ ↥eligible, ∑ fresh : UnrestrictedFreshLabels P promotions,
      unrestrictedEdgeEventMass source old seed transport hit μ ρ V stores promotions e fresh *
        (if (unrestrictedEdgeOutput source old seed transport stores promotions e).1 ≤ B then
          ‖F (unrestrictedEdgeTarget old label promotions e fresh)
              (unrestrictedEdgeOutput source old seed transport stores promotions e)‖ ^ 2 /
            v ^ (unrestrictedEdgeOutput source old seed transport stores promotions e).1
        else 0)

theorem unrestricted_edge_square_mass_nonneg {P Z : Type*} [Fintype P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (label : Z → P)
    (seed : P → Z) (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ)
    {ρ V v : ℝ} (hρ : 0 ≤ ρ) (hV : 0 ≤ V) (hv : 0 ≤ v)
    (hμ : ∀ p, 0 ≤ μ p) (eligible : Finset (Fin N)) (B : ℕ)
    (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ) :
    0 ≤ unrestrictedEdgeSquareMass source old label seed transport hit μ ρ V v eligible B F := by
  apply sum_nonneg
  intro stores hs
  apply sum_nonneg
  intro promotions hp
  apply sum_nonneg
  intro e he
  apply sum_nonneg
  intro fresh hf
  apply mul_nonneg (unrestrictedEdgeEventMass_nonneg source old seed transport hit μ
    hρ hV hμ stores promotions e fresh)
  split_ifs
  · exact div_nonneg (sq_nonneg _) (pow_nonneg hv _)
  · exact le_rfl

theorem unrestricted_edge_action_weighted_cauchy {P Z : Type*} [Fintype P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (label : Z → P)
    (seed : P → Z) (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ)
    {ρ V v : ℝ} (hρ : 0 ≤ ρ) (hV : 0 ≤ V) (hv : 0 < v)
    (hμ : ∀ p, 0 ≤ μ p) (eligible : Finset (Fin N)) (B : ℕ)
    (phase : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥eligible) → UnrestrictedFreshLabels P promotions → ℂ)
    (hphase : ∀ stores promotions e fresh, ‖phase stores promotions e fresh‖ ≤ 1)
    (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ) :
    ‖unrestrictedEdgeAction source old label seed transport hit μ ρ V eligible B phase F‖ ^ 2 ≤
      unrestrictedEdgeRowMass source old seed transport hit μ ρ V v eligible *
        unrestrictedEdgeSquareMass source old label seed transport hit μ ρ V v eligible B F := by
  let Q := Σ stores : Finset (Fin t), Σ promotions : Finset (Fin t),
    (promotions ↪ ↥eligible) × UnrestrictedFreshLabels P promotions
  let mass : Q → ℝ := fun q =>
    unrestrictedEdgeEventMass source old seed transport hit μ ρ V q.1 q.2.1 q.2.2.1 q.2.2.2
  let weight : Q → ℝ := fun q =>
    v ^ (unrestrictedEdgeOutput source old seed transport q.1 q.2.1 q.2.2.1).1
  let phaseQ : Q → ℂ := fun q => phase q.1 q.2.1 q.2.2.1 q.2.2.2
  let value : Q → ℂ := fun q =>
    if (unrestrictedEdgeOutput source old seed transport q.1 q.2.1 q.2.2.1).1 ≤ B then
      F (unrestrictedEdgeTarget old label q.2.1 q.2.2.1 q.2.2.2)
        (unrestrictedEdgeOutput source old seed transport q.1 q.2.1 q.2.2.1) else 0
  have hmass (q : Q) : 0 ≤ mass q :=
    unrestrictedEdgeEventMass_nonneg source old seed transport hit μ hρ hV hμ
      q.1 q.2.1 q.2.2.1 q.2.2.2
  have hweight (q : Q) : 0 < weight q := pow_pos hv _
  have hnorm (q : Q) : ‖(mass q : ℂ)‖ = mass q := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hmass q)]
  have hc := complex_row_weighted_cauchy (univ : Finset Q)
    (fun q => (mass q : ℂ)) (fun q => phaseQ q * value q) weight (fun q _ => hweight q)
  simp_rw [hnorm] at hc
  have hvalue (q : Q) : ‖phaseQ q * value q‖ ^ 2 ≤ ‖value q‖ ^ 2 := by
    apply (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mpr
    rw [norm_mul]
    simpa only [one_mul] using mul_le_mul_of_nonneg_right
      (hphase q.1 q.2.1 q.2.2.1 q.2.2.2) (norm_nonneg (value q))
  have hsum : (∑ q : Q, mass q * ‖phaseQ q * value q‖ ^ 2 / weight q) ≤
      ∑ q : Q, mass q * ‖value q‖ ^ 2 / weight q := by
    apply sum_le_sum
    intro q hq
    exact div_le_div_of_nonneg_right
      (mul_le_mul_of_nonneg_left (hvalue q) (hmass q)) (hweight q).le
  have hrow : (∑ q : Q, mass q * weight q) =
      unrestrictedEdgeRowMass source old seed transport hit μ ρ V v eligible := by
    simp only [Q, Fintype.sum_sigma, Fintype.sum_prod_type, mass, weight,
      unrestrictedEdgeRowMass, unrestrictedEdgeChoiceRowMass]
  have haction : (∑ q : Q, (mass q : ℂ) * (phaseQ q * value q)) =
      unrestrictedEdgeAction source old label seed transport hit μ ρ V eligible B phase F := by
    simp only [Q, Fintype.sum_sigma, Fintype.sum_prod_type, mass, phaseQ, value,
      unrestrictedEdgeAction, mul_assoc]
  have hsquare : (∑ q : Q, mass q * ‖value q‖ ^ 2 / weight q) =
      unrestrictedEdgeSquareMass source old label seed transport hit μ ρ V v eligible B F := by
    simp only [Q, Fintype.sum_sigma, Fintype.sum_prod_type, mass, value, weight,
      unrestrictedEdgeSquareMass]
    apply sum_congr rfl
    intro stores hs
    apply sum_congr rfl
    intro promotions hp
    apply sum_congr rfl
    intro e he
    apply sum_congr rfl
    intro fresh hf
    split_ifs <;> simp [mul_div_assoc]
  rw [haction, hrow] at hc
  rw [hsquare] at hsum
  exact hc.trans (mul_le_mul_of_nonneg_left hsum (by
    rw [← hrow]
    exact sum_nonneg fun q _ => mul_nonneg (hmass q) (hweight q).le))

/-- Substitute the explicit cutoff-independent row constant into pointwise
Cauchy. The remaining square mass is the quantity to integrate by adjointness. -/
theorem unrestricted_edge_action_sq_le_row_bound {P Z : Type*} [Fintype P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (label : Z → P)
    (seed : P → Z) (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ)
    {ρ V v vmin : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hV : vmin ≤ V) (hμ : ∀ p, 0 ≤ μ p)
    (hmass : ∑ p, μ p ≤ 2) (eligible : Finset (Fin N))
    (heligible : ∀ j ∈ eligible, hit (transport (old j))) (B T : ℕ) (ht : t ≤ T)
    (phase : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥eligible) → UnrestrictedFreshLabels P promotions → ℂ)
    (hphase : ∀ stores promotions e fresh, ‖phase stores promotions e fresh‖ ≤ 1)
    (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ) :
    ‖unrestrictedEdgeAction source old label seed transport hit μ ρ V eligible B phase F‖ ^ 2 ≤
      (v ^ N * unrestrictedEdgeRowBound ρ v vmin T) *
        unrestrictedEdgeSquareMass source old label seed transport hit μ ρ V v eligible B F := by
  have hv0 : 0 < v := zero_lt_one.trans hv
  have hV0 : 0 ≤ V := (hvmin.trans_le hV).le
  exact (unrestricted_edge_action_weighted_cauchy source old label seed transport hit μ
    hρ0.le hV0 hv0 hμ eligible B phase hphase F).trans
      (mul_le_mul_of_nonneg_right (unrestricted_edge_row_mass_le source old seed transport
        hit μ hρ0 hρ1 hv hvmin hV hμ hmass eligible heligible T ht)
        (unrestricted_edge_square_mass_nonneg source old label seed transport hit μ
          hρ0.le hV0 hv0.le hμ eligible B F))
end

section
open Finset Classical
theorem unrestricted_size_reindex {E : Type*} [AddCommMonoid E]
    (F : ℕ → E) (a b Bsrc Btgt : ℕ) :
    (∑ N ∈ range (Bsrc + 1),
      if a ≤ N ∧ N - a + b ≤ Btgt then F (N - a) else 0) =
      ∑ M ∈ range (Btgt + 1),
        if b ≤ M ∧ M - b + a ≤ Bsrc then F (M - b) else 0 := by
  rw [← sum_filter, ← sum_filter]
  apply sum_bij (fun N _ => N - a + b)
  · intro N hN
    simp only [mem_filter, mem_range] at hN ⊢
    omega
  · intro N hN N' hN' hNN'
    simp only [mem_filter, mem_range] at hN hN'
    omega
  · intro M hM
    simp only [mem_filter, mem_range] at hM
    refine ⟨M - b + a, ?_, ?_⟩
    · simp only [mem_filter, mem_range]
      omega
    · omega
  · intro N hN
    simp

theorem unrestricted_size_reindex_fin {E : Type*} [AddCommMonoid E]
    (F : ℕ → E) (a b Bsrc Btgt : ℕ) :
    (∑ N : Fin (Bsrc + 1),
      if a ≤ N.val ∧ N.val - a + b ≤ Btgt then F (N.val - a) else 0) =
      ∑ M : Fin (Btgt + 1),
        if b ≤ M.val ∧ M.val - b + a ≤ Bsrc then F (M.val - b) else 0 := by
  calc
    _ = ∑ N ∈ range (Bsrc + 1),
        if a ≤ N ∧ N - a + b ≤ Btgt then F (N - a) else 0 :=
      Fin.sum_univ_eq_sum_range _ _
    _ = _ := unrestricted_size_reindex F a b Bsrc Btgt
    _ = _ := (Fin.sum_univ_eq_sum_range _ _).symm

/-- Pointwise reversal of blocks implies reversal of their finite size sums.
Blocks too short to contain the selected slots vanish; normalization factors
may already be included in the two block functions. -/
theorem unrestricted_paired_size_reindex {E : Type*} [AddCommMonoid E]
    (A B : ℕ → E) (a b Bsrc Btgt : ℕ)
    (hA : ∀ N, N < a → A N = 0) (hB : ∀ M, M < b → B M = 0)
    (hAB : ∀ k, A (k + a) = B (k + b)) :
    (∑ N ∈ range (Bsrc + 1), if N - a + b ≤ Btgt then A N else 0) =
      ∑ M ∈ range (Btgt + 1), if M - b + a ≤ Bsrc then B M else 0 := by
  calc
    _ = ∑ N ∈ range (Bsrc + 1),
        if a ≤ N ∧ N - a + b ≤ Btgt then A (N - a + a) else 0 := by
      apply sum_congr rfl
      intro N hN
      by_cases ha : a ≤ N
      · simp only [ha, true_and, Nat.sub_add_cancel ha]
      · simp [ha, hA N (Nat.lt_of_not_ge ha)]
    _ = ∑ M ∈ range (Btgt + 1),
        if b ≤ M ∧ M - b + a ≤ Bsrc then A (M - b + a) else 0 :=
      unrestricted_size_reindex (fun k => A (k + a)) a b Bsrc Btgt
    _ = _ := by
      apply sum_congr rfl
      intro M hM
      by_cases hb : b ≤ M
      · simp only [hb, true_and, hAB, Nat.sub_add_cancel hb]
      · simp [hb, hB M (Nat.lt_of_not_ge hb)]
end

section
open Finset
abbrev BoundedOrderedTuple (Z : Type*) (B : ℕ) :=
  Σ N : Fin (B + 1), Fin N.val → Z

def boundedOrderedTupleToFinite {Z : Type*} {B : ℕ}
    (q : BoundedOrderedTuple Z B) : FiniteOrderedTuple Z :=
  ⟨q.1.val, q.2⟩

theorem boundedOrderedTupleToFinite_length_le {Z : Type*} {B : ℕ}
    (q : BoundedOrderedTuple Z B) : (boundedOrderedTupleToFinite q).1 ≤ B := by
  exact Nat.le_of_lt_succ q.1.isLt

/-- The product particle measure divided by the actual memory factorial. -/
noncomputable def boundedOrderedMemoryWeight {Z : Type*} {B : ℕ}
    (ν : Z → ℝ) (q : BoundedOrderedTuple Z B) : ℝ :=
  (∏ j, ν (q.2 j)) / (q.1.val.factorial : ℝ)

theorem boundedOrderedMemoryWeight_nonneg {Z : Type*} {B : ℕ}
    (ν : Z → ℝ) (hν : ∀ z, 0 ≤ ν z) (q : BoundedOrderedTuple Z B) :
    0 ≤ boundedOrderedMemoryWeight ν q := by
  exact div_nonneg (prod_nonneg fun j _ => hν (q.2 j)) (Nat.cast_nonneg _)

/-- Split integration into memory length and ordered particle coordinates.
The scalar form applies in particular to complex-valued test functions. -/
theorem bounded_ordered_memory_smul_sum {Z E : Type*} [Fintype Z]
    [AddCommMonoid E] [Module ℝ E] (ν : Z → ℝ) (B : ℕ)
    (F : FiniteOrderedTuple Z → E) :
    (∑ q : BoundedOrderedTuple Z B,
      boundedOrderedMemoryWeight ν q • F (boundedOrderedTupleToFinite q)) =
    ∑ N : Fin (B + 1), (1 / (N.val.factorial : ℝ)) •
      ∑ q : Fin N.val → Z, (∏ j, ν (q j)) • F ⟨N.val, q⟩ := by
  rw [Fintype.sum_sigma]
  apply sum_congr rfl
  intro N _
  rw [smul_sum]
  apply sum_congr rfl
  intro q _
  change ((∏ j, ν (q j)) / (N.val.factorial : ℝ)) • F ⟨N.val, q⟩ = _
  rw [smul_smul]
  congr 1
  ring

theorem bounded_ordered_memory_sum {Z : Type*} [Fintype Z]
    (ν : Z → ℝ) (B : ℕ) (F : FiniteOrderedTuple Z → ℝ) :
    (∑ q : BoundedOrderedTuple Z B,
      boundedOrderedMemoryWeight ν q * F (boundedOrderedTupleToFinite q)) =
    ∑ N : Fin (B + 1), (1 / (N.val.factorial : ℝ)) *
      ∑ q : Fin N.val → Z, (∏ j, ν (q j)) * F ⟨N.val, q⟩ := by
  simpa only [smul_eq_mul] using bounded_ordered_memory_smul_sum ν B F

theorem bounded_ordered_memory_complex_sum {Z : Type*} [Fintype Z]
    (ν : Z → ℝ) (B : ℕ) (F : FiniteOrderedTuple Z → ℂ) :
    (∑ q : BoundedOrderedTuple Z B,
      (boundedOrderedMemoryWeight ν q : ℂ) * F (boundedOrderedTupleToFinite q)) =
    ∑ N : Fin (B + 1), ((1 / (N.val.factorial : ℝ) : ℝ) : ℂ) *
      ∑ q : Fin N.val → Z, ((∏ j, ν (q j) : ℝ) : ℂ) * F ⟨N.val, q⟩ := by
  simpa only [Complex.real_smul] using bounded_ordered_memory_smul_sum ν B F

theorem bounded_ordered_memory_smul_sum_range {Z E : Type*} [Fintype Z]
    [AddCommMonoid E] [Module ℝ E] (ν : Z → ℝ) (B : ℕ)
    (F : FiniteOrderedTuple Z → E) :
    (∑ q : BoundedOrderedTuple Z B,
      boundedOrderedMemoryWeight ν q • F (boundedOrderedTupleToFinite q)) =
    ∑ N ∈ range (B + 1), (1 / (N.factorial : ℝ)) •
      ∑ q : Fin N → Z, (∏ j, ν (q j)) • F ⟨N, q⟩ := by
  rw [bounded_ordered_memory_smul_sum]
  exact Fin.sum_univ_eq_sum_range
    (fun N => (1 / (N.factorial : ℝ)) • ∑ q : Fin N → Z, (∏ j, ν (q j)) • F ⟨N, q⟩)
    (B + 1)

abbrev BoundedOrderedState (P Z : Type*) (t B : ℕ) :=
  (Fin t → P) × BoundedOrderedTuple Z B

/-- Active coordinates have product measure; memory has factorial measure. -/
noncomputable def boundedOrderedStateWeight {P Z : Type*} {t B : ℕ}
    (μ : P → ℝ) (ν : Z → ℝ) (s : BoundedOrderedState P Z t B) : ℝ :=
  (∏ i, μ (s.1 i)) * boundedOrderedMemoryWeight ν s.2

theorem boundedOrderedStateWeight_nonneg {P Z : Type*} {t B : ℕ}
    (μ : P → ℝ) (ν : Z → ℝ) (hμ : ∀ p, 0 ≤ μ p) (hν : ∀ z, 0 ≤ ν z)
    (s : BoundedOrderedState P Z t B) : 0 ≤ boundedOrderedStateWeight μ ν s :=
  mul_nonneg (prod_nonneg fun i _ => hμ (s.1 i))
    (boundedOrderedMemoryWeight_nonneg ν hν s.2)

/-- Integrate an active tuple and a bounded ordered memory in coordinates. -/
theorem bounded_ordered_state_smul_sum {P Z E : Type*} [Fintype P] [Fintype Z]
    [AddCommMonoid E] [Module ℝ E] (μ : P → ℝ) (ν : Z → ℝ) (t B : ℕ)
    (F : (Fin t → P) → FiniteOrderedTuple Z → E) :
    (∑ s : BoundedOrderedState P Z t B,
      boundedOrderedStateWeight μ ν s • F s.1 (boundedOrderedTupleToFinite s.2)) =
    ∑ active : Fin t → P, ∑ N : Fin (B + 1), (1 / (N.val.factorial : ℝ)) •
      ∑ q : Fin N.val → Z,
        ((∏ i, μ (active i)) * ∏ j, ν (q j)) • F active ⟨N.val, q⟩ := by
  rw [Fintype.sum_prod_type]
  apply sum_congr rfl
  intro active _
  rw [Fintype.sum_sigma]
  apply sum_congr rfl
  intro N _
  rw [smul_sum]
  apply sum_congr rfl
  intro q _
  change ((∏ i, μ (active i)) * ((∏ j, ν (q j)) / (N.val.factorial : ℝ))) •
    F active ⟨N.val, q⟩ = _
  rw [smul_smul]
  congr 1
  ring

theorem bounded_ordered_state_sum {P Z : Type*} [Fintype P] [Fintype Z]
    (μ : P → ℝ) (ν : Z → ℝ) (t B : ℕ)
    (F : (Fin t → P) → FiniteOrderedTuple Z → ℝ) :
    (∑ s : BoundedOrderedState P Z t B,
      boundedOrderedStateWeight μ ν s * F s.1 (boundedOrderedTupleToFinite s.2)) =
    ∑ active : Fin t → P, ∑ N : Fin (B + 1), (1 / (N.val.factorial : ℝ)) *
      ∑ q : Fin N.val → Z,
        ((∏ i, μ (active i)) * ∏ j, ν (q j)) * F active ⟨N.val, q⟩ := by
  simpa only [smul_eq_mul] using bounded_ordered_state_smul_sum μ ν t B F

theorem bounded_ordered_state_complex_sum {P Z : Type*} [Fintype P] [Fintype Z]
    (μ : P → ℝ) (ν : Z → ℝ) (t B : ℕ)
    (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ) :
    (∑ s : BoundedOrderedState P Z t B,
      (boundedOrderedStateWeight μ ν s : ℂ) * F s.1 (boundedOrderedTupleToFinite s.2)) =
    ∑ active : Fin t → P, ∑ N : Fin (B + 1), ((1 / (N.val.factorial : ℝ) : ℝ) : ℂ) *
      ∑ q : Fin N.val → Z,
        ((((∏ i, μ (active i)) * ∏ j, ν (q j)) : ℝ) : ℂ) * F active ⟨N.val, q⟩ := by
  simpa only [Complex.real_smul] using bounded_ordered_state_smul_sum μ ν t B F

theorem bounded_ordered_state_smul_sum_range {P Z E : Type*} [Fintype P] [Fintype Z]
    [AddCommMonoid E] [Module ℝ E] (μ : P → ℝ) (ν : Z → ℝ) (t B : ℕ)
    (F : (Fin t → P) → FiniteOrderedTuple Z → E) :
    (∑ s : BoundedOrderedState P Z t B,
      boundedOrderedStateWeight μ ν s • F s.1 (boundedOrderedTupleToFinite s.2)) =
    ∑ active : Fin t → P, ∑ N ∈ range (B + 1), (1 / (N.factorial : ℝ)) •
      ∑ q : Fin N → Z,
        ((∏ i, μ (active i)) * ∏ j, ν (q j)) • F active ⟨N, q⟩ := by
  rw [bounded_ordered_state_smul_sum]
  apply sum_congr rfl
  intro active _
  exact Fin.sum_univ_eq_sum_range (fun N => (1 / (N.factorial : ℝ)) •
    ∑ q : Fin N → Z, ((∏ i, μ (active i)) * ∏ j, ν (q j)) • F active ⟨N, q⟩) (B + 1)
end

section
open Finset
/-- Integrate the pointwise bound and transfer its positive term through the
exact weighted pairing. The reverse row estimate cancels the target weight. -/
theorem finite_weighted_energy_of_pairing {I J : Type*} [Fintype I] [Fintype J]
    (μ : I → ℝ) (ν w : J → ℝ) (v A : I → ℝ) (D : J → ℝ)
    (u : I → ℂ) (f : J → ℂ) {R C : ℝ}
    (hμ : ∀ i, 0 ≤ μ i) (hν : ∀ j, 0 ≤ ν j) (hw : ∀ j, 0 < w j)
    (hR : 0 ≤ R)
    (hcauchy : ∀ i, ‖u i‖ ^ 2 ≤ R * v i * A i)
    (hpair : (∑ i, μ i * v i * A i) =
      ∑ j, ν j * D j * (‖f j‖ ^ 2 / w j))
    (hreverse : ∀ j, D j ≤ C * w j) :
    (∑ i, μ i * ‖u i‖ ^ 2) ≤ R * C * ∑ j, ν j * ‖f j‖ ^ 2 := by
  calc
    _ ≤ ∑ i, μ i * (R * v i * A i) :=
      sum_le_sum fun i _ => mul_le_mul_of_nonneg_left (hcauchy i) (hμ i)
    _ = R * ∑ i, μ i * v i * A i := by
      rw [mul_sum]
      apply sum_congr rfl
      intro i hi
      ring
    _ = R * ∑ j, ν j * D j * (‖f j‖ ^ 2 / w j) := by rw [hpair]
    _ ≤ R * ∑ j, ν j * (C * w j) * (‖f j‖ ^ 2 / w j) := by
      apply mul_le_mul_of_nonneg_left _ hR
      apply sum_le_sum
      intro j hj
      exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (hreverse j) (hν j))
        (div_nonneg (sq_nonneg _) (hw j).le)
    _ = _ := by
      simp_rw [mul_sum]
      apply sum_congr rfl
      intro j hj
      have hwj : w j ≠ 0 := (hw j).ne'
      field_simp

/-- Complex pairing form, matching the literal edge action. Only the real
parts of the positive forward and reverse actions enter the energy estimate. -/
theorem finite_weighted_energy_of_complex_pairing {I J : Type*}
    [Fintype I] [Fintype J] (μ : I → ℝ) (ν w : J → ℝ) (v : I → ℝ)
    (A : I → ℂ) (D : J → ℂ) (u : I → ℂ) (f : J → ℂ) {R C : ℝ}
    (hμ : ∀ i, 0 ≤ μ i) (hν : ∀ j, 0 ≤ ν j) (hw : ∀ j, 0 < w j)
    (hR : 0 ≤ R)
    (hcauchy : ∀ i, ‖u i‖ ^ 2 ≤ R * v i * (A i).re)
    (hpair : (∑ i, (μ i : ℂ) * (v i : ℂ) * A i) =
      ∑ j, (ν j : ℂ) * D j * ((‖f j‖ ^ 2 / w j : ℝ) : ℂ))
    (hreverse : ∀ j, (D j).re ≤ C * w j) :
    (∑ i, μ i * ‖u i‖ ^ 2) ≤ R * C * ∑ j, ν j * ‖f j‖ ^ 2 := by
  apply finite_weighted_energy_of_pairing μ ν w v (fun i => (A i).re) (fun j => (D j).re)
    u f hμ hν hw hR hcauchy _ hreverse
  simpa only [Complex.re_sum, Complex.mul_re, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
    mul_zero, zero_mul, add_zero, sub_zero] using congrArg Complex.re hpair

theorem finite_weighted_norm_of_complex_pairing {I J : Type*}
    [Fintype I] [Fintype J] (μ : I → ℝ) (ν w : J → ℝ) (v : I → ℝ)
    (A : I → ℂ) (D : J → ℂ) (u : I → ℂ) (f : J → ℂ) {R C : ℝ}
    (hμ : ∀ i, 0 ≤ μ i) (hν : ∀ j, 0 ≤ ν j) (hw : ∀ j, 0 < w j)
    (hR : 0 ≤ R) (hC : 0 ≤ C)
    (hcauchy : ∀ i, ‖u i‖ ^ 2 ≤ R * v i * (A i).re)
    (hpair : (∑ i, (μ i : ℂ) * (v i : ℂ) * A i) =
      ∑ j, (ν j : ℂ) * D j * ((‖f j‖ ^ 2 / w j : ℝ) : ℂ))
    (hreverse : ∀ j, (D j).re ≤ C * w j) :
    Real.sqrt (∑ i, μ i * ‖u i‖ ^ 2) ≤
      Real.sqrt (R * C) * Real.sqrt (∑ j, ν j * ‖f j‖ ^ 2) := by
  have h := Real.sqrt_le_sqrt (finite_weighted_energy_of_complex_pairing μ ν w v A D u f
    hμ hν hw hR hcauchy hpair hreverse)
  simpa only [Real.sqrt_mul (mul_nonneg hR hC)] using h
end

section

open Finset
open scoped Classical

noncomputable def cleanAuxiliaryWeight {A P : Type*} [Fintype A] [DecidableEq A]
    (μ : P → ℝ) (aux : A → P) : ℝ := ∏ a, μ (aux a)

def cleanAuxiliaryCollision {A S I P : Type*}
    (source : S → P) (target : I → P) (aux : A → P) : Prop :=
  ∃ a, (∃ s, aux a = source s) ∨ (∃ i, aux a = target i)

/-- The marginal at one auxiliary coordinate is exactly its given probability law. -/
theorem clean_auxiliary_coordinate_mass {A P : Type*} [Fintype A] [DecidableEq A] [Fintype P]
    (μ : P → ℝ) (hμ : ∑ p, μ p = 1) (a : A) (p : P) :
    (∑ aux : A → P, cleanAuxiliaryWeight μ aux * (if aux a = p then 1 else 0)) = μ p := by
  have hprod (aux : A → P) :
      cleanAuxiliaryWeight μ aux * (if aux a = p then 1 else 0) =
        ∏ i, μ (aux i) * (if i = a then (if aux i = p then 1 else 0) else 1) := by
    rw [prod_mul_distrib]
    congr 1
    rw [prod_eq_single a]
    · simp
    · intro b hb hba
      simp only [if_neg hba]
    · simp
  simp_rw [hprod]
  rw [← Fintype.prod_sum (fun i (z : P) => μ z *
    (if i = a then (if z = p then 1 else 0) else 1))]
  have hlocal (i : A) :
      (∑ z : P, μ z * (if i = a then (if z = p then 1 else 0) else 1)) =
        if i = a then μ p else 1 := by
    by_cases hi : i = a
    · simp [hi]
    · simp [hi, hμ]
  simp_rw [hlocal]
  rw [prod_eq_single a]
  · simp
  · intro b hb hba
    simp only [if_neg hba]
  · simp

/-- A union bound stated in the same weighted finite-sum convention as the row kernels. -/
theorem clean_weighted_exists_le_sum {Ω J : Type*} [Fintype Ω] [Fintype J]
    (w : Ω → ℝ) (hw : ∀ x, 0 ≤ w x) (event : J → Ω → Prop) :
    (∑ x, w x * (if ∃ j, event j x then 1 else 0)) ≤
      ∑ j, ∑ x, w x * (if event j x then 1 else 0) := by
  rw [sum_comm]
  apply sum_le_sum
  intro x hx
  by_cases he : ∃ j, event j x
  · obtain ⟨j, hj⟩ := he
    rw [if_pos ⟨j, hj⟩, mul_one]
    calc
      w x = w x * (if event j x then 1 else 0) := by rw [if_pos hj, mul_one]
      _ ≤ ∑ i, w x * (if event i x then 1 else 0) := by
        have hnn : ∀ i ∈ (univ : Finset J), 0 ≤ w x * (if event i x then 1 else 0) := by
          intro i hi
          exact mul_nonneg (hw x) (by split_ifs <;> norm_num)
        exact single_le_sum hnn (mem_univ j)
  · rw [if_neg he, mul_zero]
    exact sum_nonneg (fun i _ => mul_nonneg (hw x) (by split_ifs <;> norm_num))

/-- Any fixed finite label list is hit with at most the number of comparisons times
one auxiliary atom. Repeated labels need not be removed from the list. -/
theorem clean_auxiliary_hits_mass_le {A S P : Type*}
    [Fintype A] [DecidableEq A] [Fintype S] [Fintype P]
    (μ : P → ℝ) (hμ0 : ∀ p, 0 ≤ μ p) (hμ : ∑ p, μ p = 1)
    (labels : S → P) (a₀ : ℝ) (hatom : ∀ p, μ p ≤ a₀) :
    (∑ aux : A → P, cleanAuxiliaryWeight μ aux *
      (if ∃ a s, aux a = labels s then 1 else 0)) ≤
        (Fintype.card A : ℝ) * Fintype.card S * a₀ := by
  have he (aux : A → P) : (∃ a s, aux a = labels s) ↔
      ∃ z : A × S, aux z.1 = labels z.2 := by
    constructor
    · rintro ⟨a, s, h⟩
      exact ⟨⟨a, s⟩, h⟩
    · rintro ⟨⟨a, s⟩, h⟩
      exact ⟨a, s, h⟩
  simp_rw [he]
  calc
    _ ≤ ∑ z : A × S, ∑ aux : A → P,
        cleanAuxiliaryWeight μ aux * (if aux z.1 = labels z.2 then 1 else 0) :=
      clean_weighted_exists_le_sum _ (fun aux => prod_nonneg (fun a _ => hμ0 (aux a))) _
    _ = ∑ z : A × S, μ (labels z.2) := by simp_rw [clean_auxiliary_coordinate_mass μ hμ]
    _ ≤ ∑ _z : A × S, a₀ := sum_le_sum (fun z _ => hatom (labels z.2))
    _ = _ := by simp [Fintype.card_prod, mul_assoc]

/-- Auxiliary collisions with either active endpoint obey the same bound. -/
theorem clean_auxiliary_collision_mass_le {A S I P : Type*}
    [Fintype A] [DecidableEq A] [Fintype S] [Fintype I] [Fintype P]
    (μ : P → ℝ) (hμ0 : ∀ p, 0 ≤ μ p) (hμ : ∑ p, μ p = 1)
    (source : S → P) (target : I → P) (a₀ : ℝ) (hatom : ∀ p, μ p ≤ a₀) :
    (∑ aux : A → P, cleanAuxiliaryWeight μ aux *
      (if cleanAuxiliaryCollision source target aux then 1 else 0)) ≤
        (Fintype.card A : ℝ) * (Fintype.card S + Fintype.card I) * a₀ := by
  have he (aux : A → P) : cleanAuxiliaryCollision source target aux ↔
      ∃ a s, aux a = Sum.elim source target s := by
    constructor
    · rintro ⟨a, ⟨s, hs⟩ | ⟨i, hi⟩⟩
      · exact ⟨a, Sum.inl s, hs⟩
      · exact ⟨a, Sum.inr i, hi⟩
    · rintro ⟨a, s | i, h⟩
      · exact ⟨a, Or.inl ⟨s, h⟩⟩
      · exact ⟨a, Or.inr ⟨i, h⟩⟩
  simp_rw [he]
  simpa only [Fintype.card_sum, Nat.cast_add] using
    clean_auxiliary_hits_mass_le μ hμ0 hμ (Sum.elim source target) a₀ hatom

/-- Conditioning on every fresh target tuple proves a uniform bound for the ACTUAL
independent auxiliary/fresh draw, including arbitrary prescribed retained target slots. -/
theorem clean_fresh_collision_mass_le {A S I P : Type*}
    [Fintype A] [DecidableEq A] [Fintype S] [Fintype I] [DecidableEq I] [Fintype P]
    (μ ν : P → ℝ) (hμ0 : ∀ p, 0 ≤ μ p) (hμ : ∑ p, μ p = 1)
    (hν : ∀ p, 0 ≤ ν p) (source : S → P) (T : Finset I) (retained : T → P)
    (a₀ : ℝ) (hatom : ∀ p, μ p ≤ a₀) :
    (∑ fresh : UnrestrictedFreshLabels P T,
      unrestrictedFreshWeight ν T fresh *
        ∑ aux : A → P, cleanAuxiliaryWeight μ aux *
          (if cleanAuxiliaryCollision source (unrestrictedTargetLabels T retained fresh) aux
            then 1 else 0)) ≤
      (∑ p, ν p) ^ (Fintype.card I - T.card) *
        ((Fintype.card A : ℝ) * (Fintype.card S + Fintype.card I) * a₀) := by
  exact unrestricted_fresh_sum_le ν T retained
    (fun target => ∑ aux : A → P, cleanAuxiliaryWeight μ aux *
      (if cleanAuxiliaryCollision source target aux then 1 else 0)) hν
    (fun fresh => clean_auxiliary_collision_mass_le μ hμ0 hμ source
      (unrestrictedTargetLabels T retained fresh) a₀ hatom)

/-- The actual auxiliary law has the reciprocal-prime atom bound, without tilting. -/
theorem physical_label_law_atom_le {G : Type*} {P : G → Finset ℕ}
    (V : G → ℝ) (g : G) (hV : 0 < V g) {P₀ : ℝ} (hP₀ : 0 < P₀)
    (p : P g) (hp : P₀ ≤ (p.val : ℝ)) :
    physicalLabelLaw V g p ≤ 1 / (V g * P₀) := by
  unfold physicalLabelLaw
  exact one_div_le_one_div_of_le (mul_pos hV hP₀)
    (mul_le_mul_of_nonneg_left hp hV.le)

/-- The physical reciprocal-prime auxiliary law and the actual tilted fresh law satisfy
the collision estimate with their exact fresh mass. No normalization of the tilted law
and no distinctness of the two endpoint lists is assumed. -/
theorem physical_tilted_fresh_collision_mass_le {G A S I : Type*}
    [Fintype A] [DecidableEq A] [Fintype S] [Fintype I] [DecidableEq I]
    {P : G → Finset ℕ} (V : G → ℝ) (g : G) (hV : 0 < V g)
    (hMass : ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (b : P g → ℝ) (hb : ∀ p, 0 ≤ b p) {P₀ : ℝ} (hP₀ : 0 < P₀)
    (hP : ∀ p : P g, P₀ ≤ (p.val : ℝ)) (source : S → P g)
    (T : Finset I) (retained : T → P g) :
    (∑ fresh : UnrestrictedFreshLabels (P g) T,
      unrestrictedFreshWeight (tiltedPhysicalBirthLaw V g b) T fresh *
        ∑ aux : A → P g, cleanAuxiliaryWeight (physicalLabelLaw V g) aux *
          (if cleanAuxiliaryCollision source (unrestrictedTargetLabels T retained fresh) aux
            then 1 else 0)) ≤
      (∑ p : P g, tiltedPhysicalBirthLaw V g b p) ^ (Fintype.card I - T.card) *
        ((Fintype.card A : ℝ) * (Fintype.card S + Fintype.card I) * (1 / (V g * P₀))) := by
  apply clean_fresh_collision_mass_le
    (physicalLabelLaw V g) (tiltedPhysicalBirthLaw V g b)
  · intro p
    unfold physicalLabelLaw
    exact div_nonneg zero_le_one (mul_nonneg hV.le (Nat.cast_nonneg p.val))
  · exact physical_label_law_sum V g hV hMass
  · exact fun p => tiltedPhysicalBirthLaw_nonneg V g b hV.le hb p
  · exact fun p => physical_label_law_atom_le V g hV hP₀ p (hP p)
end

section
open Finset
theorem sum_dyadic_reciprocal_Icc (J : ℕ) :
    (∑ j ∈ Icc 0 J, (1 : ℝ) / 2^j) = 2 - 1 / 2^J := by
  rw [← Nat.range_succ_eq_Icc_zero]
  simp_rw [← one_div_pow]
  rw [geom_sum_eq (by norm_num : (1 / (2 : ℝ)) ≠ 1)]
  rw [pow_succ]
  rw [one_div_pow]
  ring

theorem sum_dyadic_reciprocal_Icc_le_two (J : ℕ) :
    (∑ j ∈ Icc 0 J, (1 : ℝ) / 2^j) ≤ 2 := by
  rw [sum_dyadic_reciprocal_Icc]
  have h : (0 : ℝ) ≤ 1 / 2^J := by positivity
  linarith

theorem sum_dyadic_reciprocal_Ioc_le (J N : ℕ) :
    (∑ j ∈ Ioc J N, (1 : ℝ) / 2^j) ≤ 1 / 2^J := by
  have hset : Ioc J N = Ico (J + 1) (N + 1) := by
    ext j
    simp only [mem_Ioc, mem_Ico]
    omega
  rw [hset]
  simp_rw [← one_div_pow]
  have h := geom_sum_Ico_le_of_lt_one (m := J + 1) (n := N + 1)
    (by norm_num : (0 : ℝ) ≤ 1/2) (by norm_num : (1 / (2 : ℝ)) < 1)
  have hid : (1 / (2 : ℝ))^(J + 1) / (1 - 1 / 2) = (1 / 2)^J := by
    rw [pow_succ]
    ring
  rwa [hid] at h

theorem sum_Icc_zero_split {N J : ℕ} (hJN : J ≤ N) (f : ℕ → ℝ) :
    (∑ j ∈ Icc 0 N, f j) = (∑ j ∈ Icc 0 J, f j) + ∑ j ∈ Ioc J N, f j := by
  have hu : Icc 0 N = Icc 0 J ∪ Ioc J N := by
    ext j
    simp only [mem_Icc, mem_Ioc, mem_union]
    omega
  have hd : Disjoint (Icc 0 J) (Ioc J N) := by
    apply disjoint_left.mpr
    intro j hj hk
    have h1 := (mem_Icc.mp hj).2
    have h2 := (mem_Ioc.mp hk).1
    omega
  rw [hu, sum_union hd]

theorem dyadic_prefix_sum_error {J : ℕ} {B eps : ℝ}
    (hB : 0 ≤ B) (heps : 0 ≤ eps) (f : ℕ → ℝ)
    (hprefix : ∀ j ∈ Icc 0 J,
      |f j - (11/10 : ℝ) * B / 2^j| ≤ eps * B / 2^j) :
    |(∑ j ∈ Icc 0 J, f j) - ((11/5 : ℝ) * B - (11/10 : ℝ) * B / 2^J)| ≤
      2 * eps * B := by
  have hm : (∑ j ∈ Icc 0 J, (11/10 : ℝ) * B / 2^j) =
      (11/5 : ℝ) * B - (11/10 : ℝ) * B / 2^J := by
    simp_rw [div_eq_mul_inv]
    rw [← mul_sum]
    have hs : (∑ j ∈ Icc 0 J, ((2 : ℝ)^j)⁻¹) = 2 - 1 / 2^J := by
      simpa only [one_div] using sum_dyadic_reciprocal_Icc J
    rw [hs]
    ring
  rw [← hm, ← sum_sub_distrib]
  refine (abs_sum_le_sum_abs _ _).trans ((sum_le_sum hprefix).trans ?_)
  calc
    (∑ j ∈ Icc 0 J, eps * B / 2^j) = eps * B * (∑ j ∈ Icc 0 J, (1 : ℝ) / 2^j) := by
      rw [mul_sum]
      apply sum_congr rfl
      intros
      ring
    _ ≤ eps * B * 2 := mul_le_mul_of_nonneg_left (sum_dyadic_reciprocal_Icc_le_two J) (mul_nonneg heps hB)
    _ = 2 * eps * B := by ring

theorem dyadic_sum_midpoint_error {N J : ℕ} (hJN : J ≤ N) {B eps : ℝ}
    (hB : 0 ≤ B) (heps : 0 ≤ eps) (f : ℕ → ℝ)
    (hprefix : ∀ j ∈ Icc 0 J,
      |f j - (11/10 : ℝ) * B / 2^j| ≤ eps * B / 2^j)
    (htail : ∀ j ∈ Ioc J N, 0 ≤ f j ∧ f j ≤ (6/5 : ℝ) * B / 2^j) :
    |(∑ j ∈ Icc 0 N, f j) - (11/5 : ℝ) * B| ≤
      2 * eps * B + (6/5 : ℝ) * B / 2^J := by
  have hpre := abs_le.mp (dyadic_prefix_sum_error hB heps f hprefix)
  have htail0 : 0 ≤ ∑ j ∈ Ioc J N, f j := sum_nonneg (fun j hj => (htail j hj).1)
  have htail1 : (∑ j ∈ Ioc J N, f j) ≤ (6/5 : ℝ) * B / 2^J := by
    calc
      _ ≤ ∑ j ∈ Ioc J N, (6/5 : ℝ) * B / 2^j := sum_le_sum (fun j hj => (htail j hj).2)
      _ = (6/5 : ℝ) * B * (∑ j ∈ Ioc J N, (1 : ℝ) / 2^j) := by
        rw [mul_sum]
        apply sum_congr rfl
        intros
        ring
      _ ≤ (6/5 : ℝ) * B * (1 / 2^J) :=
        mul_le_mul_of_nonneg_left (sum_dyadic_reciprocal_Ioc_le J N) (by positivity)
      _ = _ := by ring
  rw [sum_Icc_zero_split hJN]
  apply abs_le.mpr
  have hcompare : (11/10 : ℝ) * B / 2^J ≤ (6/5 : ℝ) * B / 2^J := by
    apply div_le_div_of_nonneg_right _ (by positivity)
    nlinarith
  have hmid : 0 ≤ (11/10 : ℝ) * B / 2^J := by positivity
  constructor <;> linarith
end

section
open Finset Filter
open scoped Topology
theorem mem_candidateQIndices_of_scale {c L : ℝ} {j : ℕ}
    (hlog : 0 < Real.log L)
    (hscale : 20 * Real.log L ≤ c * L / 2^j) : j ∈ candidateQIndices c L := by
  have hd : 0 < 20 * Real.log L := by positivity
  have hp0 : (0 : ℝ) < 2^j := by positivity
  have hpow : (2 : ℝ)^j ≤ c * L / (20 * Real.log L) := by
    apply (le_div_iff₀ hd).mpr
    have h := (le_div_iff₀ hp0).mp hscale
    nlinarith only [h]
  have hz1 : 1 ≤ c * L / (20 * Real.log L) := (one_le_pow₀ (by norm_num : (1 : ℝ) ≤ 2)).trans hpow
  have hz0 : 0 < c * L / (20 * Real.log L) := zero_lt_one.trans_le hz1
  have hf : 0 ≤ Real.log (c * L / (20 * Real.log L)) / Real.log 2 := by
    exact div_nonneg (Real.log_nonneg hz1) (by positivity)
  have hlg := Real.log_le_log hp0 hpow
  rw [Real.log_pow] at hlg
  apply mem_Icc.mpr
  refine ⟨Nat.zero_le _, (Nat.le_floor_iff hf).mpr ?_⟩
  exact (le_div_iff₀ (by positivity : 0 < Real.log 2)).mpr hlg

theorem eventually_fixed_candidateQ_prefix {c : ℝ} (hc : 0 < c) (J : ℕ) :
    ∀ᶠ L : ℝ in atTop, Icc 0 J ⊆ candidateQIndices c L := by
  have hlogdiv : Tendsto (fun L : ℝ => Real.log L / L) atTop (𝓝 0) := by
    simpa using Real.tendsto_pow_log_div_mul_add_atTop 1 0 1 one_ne_zero
  have hsmall := hlogdiv.eventually_le_const
    (show (0 : ℝ) < c / (20 * 2^J) by positivity)
  filter_upwards [hsmall, eventually_gt_atTop (1 : ℝ)] with L hratio hL
  have hL0 : 0 < L := zero_lt_one.trans hL
  have hscale : 20 * Real.log L ≤ c * L / 2^J := by
    apply (le_div_iff₀ (by positivity : (0 : ℝ) < 2^J)).mpr
    have h := (div_le_div_iff₀ hL0 (show (0 : ℝ) < 20 * 2^J by positivity)).mp hratio
    nlinarith only [h]
  have hJ := mem_candidateQIndices_of_scale (Real.log_pos hL) hscale
  intro j hj
  exact mem_Icc.mpr ⟨Nat.zero_le _, (mem_Icc.mp hj).2.trans (mem_Icc.mp hJ).2⟩
end

section
open Finset
theorem roughBand_value_bounds {A B W : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B)
    {n : ℕ} (hn : n ∈ roughBand A B W) : A < (n : ℝ) ∧ (n : ℝ) ≤ B := by
  have h := mem_Ioc.mp (mem_filter.mp hn).1
  exact ⟨(Nat.floor_lt hA).mp h.1, (Nat.le_floor_iff hB).mp h.2⟩

theorem candidate_Q_slot_log_bounds (c L : ℝ) (r jStar : ℕ)
    (slot : (candidateQIndices c L) × Fin r) {n : ℕ}
    (hn : n ∈ candidateQSlotChoices c L r jStar slot) :
    c * L / 2^slot.1.val < Real.log n ∧
      Real.log n ≤ (6/5 : ℝ) * (c * L) / 2^slot.1.val := by
  have hn0 : (0 : ℝ) < n := by
    exact_mod_cast Nat.pos_of_ne_zero (candidate_Q_slot_nonzero c L r jStar slot hn)
  unfold candidateQSlotChoices at hn
  split_ifs at hn with hslot
  · have h := roughBand_value_bounds (Real.exp_pos (c * L / 2^jStar)).le
      (Real.exp_pos ((6/5 : ℝ) * c * L / 2^jStar)).le hn
    rw [hslot.1]
    exact ⟨(Real.lt_log_iff_exp_lt hn0).mpr h.1,
      (Real.log_le_iff_le_exp hn0).mpr (by simpa only [mul_assoc] using h.2)⟩
  · have h := (mem_dyadicPrimeBand_iff (c * L) 1 (6/5) slot.1.val n).mp hn
    exact ⟨(Real.lt_log_iff_exp_lt hn0).mpr (by simpa only [one_mul] using h.2.1),
      (Real.log_le_iff_le_exp hn0).mpr h.2.2⟩

theorem narrowQBand_log_deviation (s eps : ℝ) (j : ℕ) {n : ℕ}
    (hn : n ∈ narrowQBand s eps j) :
    |Real.log n - (11/10 : ℝ) * s / 2^j| ≤ eps * s / 2^j := by
  have h := (mem_dyadicPrimeBand_iff s ((11/10 : ℝ) - eps) ((11/10 : ℝ) + eps) j n).mp hn
  have hn0 : (0 : ℝ) < n := by exact_mod_cast h.1.pos
  have hlo := (Real.lt_log_iff_exp_lt hn0).mpr h.2.1
  have hhi := (Real.log_le_iff_le_exp hn0).mpr h.2.2
  have hloweq : ((11/10 : ℝ) - eps) * s / 2^j = (11/10 : ℝ) * s / 2^j - eps * s / 2^j := by ring
  have hhieq : ((11/10 : ℝ) + eps) * s / 2^j = (11/10 : ℝ) * s / 2^j + eps * s / 2^j := by ring
  rw [hloweq] at hlo
  rw [hhieq] at hhi
  apply abs_le.mpr
  constructor <;> linarith

theorem candidate_prefix_slot_log_deviation {c L eps : ℝ} {r jStar J : ℕ}
    (slot : (candidateQIndices c L) × Fin r)
    (hidx : slot.1.val ≤ J) (hfree : ¬(slot.1.val = 0 ∧ slot.2.val = 0))
    {n : ℕ} (hn : n ∈ candidatePrefixChoices c L eps r jStar J slot) :
    |Real.log n - (11/10 : ℝ) * (c * L) / 2^slot.1.val| ≤
      eps * (c * L) / 2^slot.1.val := by
  classical
  have hm : slot ∈ candidatePrefixSlots c L r J := mem_filter.mpr ⟨mem_univ _, hidx, hfree⟩
  simp only [candidatePrefixChoices, restrictedSlotChoices, if_pos hm] at hn
  exact narrowQBand_log_deviation (c * L) eps slot.1.val hn

theorem candidate_prefix_slot_log_bounds {c L eps : ℝ} (hcL : 0 ≤ c * L)
    (heps : eps ≤ 1/10) {r jStar J : ℕ} (hJ : J < jStar)
    (slot : (candidateQIndices c L) × Fin r) {n : ℕ}
    (hn : n ∈ candidatePrefixChoices c L eps r jStar J slot) :
    0 ≤ Real.log n ∧ Real.log n ≤ (6/5 : ℝ) * (c * L) / 2^slot.1.val := by
  have h := candidate_Q_slot_log_bounds c L r jStar slot
    (candidatePrefixChoices_subset hcL heps hJ slot hn)
  exact ⟨(by positivity : (0 : ℝ) ≤ c * L / 2^slot.1.val).trans h.1.le, h.2⟩
end

section
open Finset
noncomputable def completedSlotLog {I : Type*} [DecidableEq I]
    (x : I → ℕ) (free : I) (midpoint : ℝ) (i : I) : ℝ :=
  if i = free then midpoint else Real.log (x i)

theorem completed_slot_log_sum {I : Type*} [Fintype I] [DecidableEq I]
    (x : I → ℕ) (free : I) (midpoint : ℝ)
    (hx : ∀ i : {i : I // i ≠ free}, x i.val ≠ 0) :
    (∑ i, completedSlotLog x free midpoint i) = midpoint +
      Real.log (∏ i : {i : I // i ≠ free}, (x i.val : ℝ)) := by
  rw [Fintype.sum_eq_add_sum_subtype_ne _ free]
  simp only [completedSlotLog]
  congr 1
  rw [Real.log_prod (fun i _ => by exact_mod_cast hx i)]
  apply sum_congr rfl
  intro i _
  simp only [if_neg i.property]

theorem completed_slot_log_sum_nat_product {I : Type*} [Fintype I] [DecidableEq I]
    (x : I → ℕ) (free : I) (midpoint : ℝ)
    (hx : ∀ i : {i : I // i ≠ free}, x i.val ≠ 0) :
    (∑ i, completedSlotLog x free midpoint i) = midpoint +
      Real.log ((∏ i : {i : I // i ≠ free}, x i.val : ℕ) : ℝ) := by
  simpa only [Nat.cast_prod] using completed_slot_log_sum x free midpoint hx
end

section

open Finset

/-- The product density relative to the untilted active-label law. Lists may repeat labels. -/
noncomputable def cleanActiveDensity {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (b : (g : G) → P g → ℝ)
    (L : (g : G) → PhysicalSlots J ell → P g) : ℝ :=
  ∏ g, ∏ s, 1 / b g (L g s)

noncomputable def cleanSharedDensity {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (b : (g : G) → P g → ℝ)
    (C : G → Finset (Fin J)) (L : (g : G) → PhysicalSlots J ell → P g) : ℝ :=
  ∏ g, ∏ s ∈ physicalSharedSlots (ell := ell) (C g), 1 / b g (L g s)

noncomputable def cleanUnsharedDensity {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (b : (g : G) → P g → ℝ)
    (C : G → Finset (Fin J)) (L : (g : G) → PhysicalSlots J ell → P g) : ℝ :=
  ∏ g, ∏ s ∈ physicalUnsharedSlots (ell := ell) (C g), 1 / b g (L g s)

theorem clean_active_density_split {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (b : (g : G) → P g → ℝ)
    (C : G → Finset (Fin J)) (L : (g : G) → PhysicalSlots J ell → P g) :
    cleanActiveDensity b L = cleanSharedDensity b C L * cleanUnsharedDensity b C L := by
  unfold cleanActiveDensity cleanSharedDensity cleanUnsharedDensity physicalUnsharedSlots
  rw [← prod_mul_distrib]
  apply prod_congr rfl
  intro g hg
  exact (prod_mul_prod_compl _ _).symm

theorem clean_shared_density_eq {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (b : (g : G) → P g → ℝ)
    (C : G → Finset (Fin J)) (source target : (g : G) → PhysicalSlots J ell → P g)
    (hshared : ∀ g j, j ∉ C g → source g (Sum.inl j) = target g (Sum.inl j)) :
    cleanSharedDensity b C source = cleanSharedDensity b C target := by
  apply prod_congr rfl
  intro g hg
  apply prod_congr rfl
  intro s hs
  obtain ⟨j, hj, rfl⟩ := mem_map.mp hs
  change 1 / b g (source g (Sum.inl j)) = 1 / b g (target g (Sum.inl j))
  rw [hshared g j (mem_sdiff.mp hj).2]

theorem clean_active_density_pos {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (b : (g : G) → P g → ℝ)
    (hb : ∀ g p, 0 < b g p) (L : (g : G) → PhysicalSlots J ell → P g) :
    0 < cleanActiveDensity b L :=
  prod_pos (fun g _ => prod_pos (fun s _ => one_div_pos.mpr (hb g (L g s))))

theorem clean_shared_density_pos {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (b : (g : G) → P g → ℝ)
    (hb : ∀ g p, 0 < b g p) (C : G → Finset (Fin J))
    (L : (g : G) → PhysicalSlots J ell → P g) :
    0 < cleanSharedDensity b C L :=
  prod_pos (fun g _ => prod_pos (fun s _ => one_div_pos.mpr (hb g (L g s))))

theorem clean_unshared_density_pos {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (b : (g : G) → P g → ℝ)
    (hb : ∀ g p, 0 < b g p) (C : G → Finset (Fin J))
    (L : (g : G) → PhysicalSlots J ell → P g) :
    0 < cleanUnsharedDensity b C L :=
  prod_pos (fun g _ => prod_pos (fun s _ => one_div_pos.mpr (hb g (L g s))))

/-- Cancellation of a common shared density leaves a geometric mean of the unshared densities. -/
theorem clean_sqrt_shared_cancellation {s u v : ℝ} (hs : 0 < s) (hu : 0 < u) (hv : 0 < v) :
    Real.sqrt (s * u) / Real.sqrt (s * v) * v = Real.sqrt (u * v) := by
  rw [Real.sqrt_mul hs.le, Real.sqrt_mul hs.le, Real.sqrt_mul hu.le]
  have hs0 : Real.sqrt s ≠ 0 := (Real.sqrt_pos.mpr hs).ne'
  have hv0 : Real.sqrt v ≠ 0 := (Real.sqrt_pos.mpr hv).ne'
  field_simp
  nlinarith [Real.sq_sqrt hv.le]

/-- The exact scalar multiplying a clean row after the square-root-density identification.
There are no assumptions about the whole operator or about closeness of the baselines to one. -/
theorem clean_density_conjugation {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (b : (g : G) → P g → ℝ)
    (hb : ∀ g p, 0 < b g p) (C : G → Finset (Fin J))
    (source target : (g : G) → PhysicalSlots J ell → P g)
    (hshared : ∀ g j, j ∉ C g → source g (Sum.inl j) = target g (Sum.inl j)) :
    Real.sqrt (cleanActiveDensity b source) / Real.sqrt (cleanActiveDensity b target) *
        cleanUnsharedDensity b C target =
      Real.sqrt (cleanUnsharedDensity b C source * cleanUnsharedDensity b C target) := by
  rw [clean_active_density_split b C source, clean_active_density_split b C target,
    ← clean_shared_density_eq b C source target hshared]
  exact clean_sqrt_shared_cancellation (clean_shared_density_pos b hb C source)
    (clean_unshared_density_pos b hb C source) (clean_unshared_density_pos b hb C target)

/-- Exact conjugation of an actual physical auxiliary mass times tilted fresh-label
integration. The auxiliary law is identical on both sides. The complex coefficient may
include the phase and all active-list dependent multipliers. -/
theorem clean_physical_fresh_coefficient_conjugation {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : (g : G) → P g → ℝ)
    (hb : ∀ g p, 0 < b g p) (C : G → Finset (Fin J))
    (source target : (g : G) → PhysicalSlots J ell → P g)
    (hshared : ∀ g j, j ∉ C g → source g (Sum.inl j) = target g (Sum.inl j))
    (aux : PhysicalAuxLabels P C) (K : ℂ) :
    ((Real.sqrt (cleanActiveDensity b source) / Real.sqrt (cleanActiveDensity b target) : ℝ) : ℂ) *
        ((physicalAuxMass V C aux *
          ∏ g, ∏ s ∈ physicalUnsharedSlots (ell := ell) (C g),
            tiltedPhysicalBirthLaw V g (b g) (target g s) : ℝ) : ℂ) * K =
      (Real.sqrt (cleanUnsharedDensity b C source * cleanUnsharedDensity b C target) : ℂ) *
        ((physicalAuxMass V C aux *
          ∏ g, ∏ s ∈ physicalUnsharedSlots (ell := ell) (C g),
            physicalLabelLaw V g (target g s) : ℝ) : ℂ) * K := by
  have hmass :
      (∏ g, ∏ s ∈ physicalUnsharedSlots (ell := ell) (C g),
        tiltedPhysicalBirthLaw V g (b g) (target g s)) =
      (∏ g, ∏ s ∈ physicalUnsharedSlots (ell := ell) (C g),
        physicalLabelLaw V g (target g s)) * cleanUnsharedDensity b C target := by
    simp only [tiltedPhysicalBirthLaw, div_eq_mul_inv, prod_mul_distrib,
      cleanUnsharedDensity, one_mul]
  rw [hmass]
  have h := clean_density_conjugation b hb C source target hshared
  have hscalar :
      (Real.sqrt (cleanActiveDensity b source) / Real.sqrt (cleanActiveDensity b target)) *
        (physicalAuxMass V C aux *
          ((∏ g, ∏ s ∈ physicalUnsharedSlots (ell := ell) (C g),
            physicalLabelLaw V g (target g s)) * cleanUnsharedDensity b C target)) =
      Real.sqrt (cleanUnsharedDensity b C source * cleanUnsharedDensity b C target) *
        (physicalAuxMass V C aux *
          (∏ g, ∏ s ∈ physicalUnsharedSlots (ell := ell) (C g),
            physicalLabelLaw V g (target g s))) := by
    linear_combination
      (physicalAuxMass V C aux *
        (∏ g, ∏ s ∈ physicalUnsharedSlots (ell := ell) (C g),
          physicalLabelLaw V g (target g s))) * h
  simpa only [Complex.ofReal_mul] using congrArg (fun x : ℝ => (x : ℂ) * K) hscalar
end

section
open Finset
theorem finite_baseline_product_lower {I : Type*} (S : Finset I) (b ε : I → ℝ)
    (hb0 : ∀ i ∈ S, 0 ≤ b i) (hb1 : ∀ i ∈ S, b i ≤ 1)
    (hε : ∀ i ∈ S, 0 ≤ ε i) (hlo : ∀ i ∈ S, 1 - ε i ≤ b i) :
    1 - ∑ i ∈ S, ε i ≤ ∏ i ∈ S, b i := by
  classical
  induction S using Finset.induction_on with
  | empty => simp
  | @insert i S hi ih =>
    rw [sum_insert hi, prod_insert hi]
    have hSi : ∀ j ∈ S, j ∈ insert i S := fun j hj => mem_insert_of_mem hj
    have hih := ih (fun j hj => hb0 j (hSi j hj))
      (fun j hj => hb1 j (hSi j hj)) (fun j hj => hε j (hSi j hj))
      (fun j hj => hlo j (hSi j hj))
    have hi0 := hb0 i (mem_insert_self i S)
    have hi1 := hb1 i (mem_insert_self i S)
    have hil := hlo i (mem_insert_self i S)
    have hsum : 0 ≤ ∑ j ∈ S, ε j := sum_nonneg (fun j hj => hε j (hSi j hj))
    have hm := mul_le_mul_of_nonneg_left hih hi0
    nlinarith [mul_nonneg (sub_nonneg.mpr hi1) hsum]

theorem finite_inverse_baseline_product_bounds {I : Type*} (S : Finset I) (b ε : I → ℝ)
    (hb0 : ∀ i ∈ S, 0 ≤ b i) (hb1 : ∀ i ∈ S, b i ≤ 1)
    (hε : ∀ i ∈ S, 0 ≤ ε i) (hlo : ∀ i ∈ S, 1 - ε i ≤ b i)
    (hsmall : ∑ i ∈ S, ε i ≤ 1 / 2) :
    1 ≤ ∏ i ∈ S, 1 / b i ∧
      (∏ i ∈ S, 1 / b i) ≤ 1 + 2 * ∑ i ∈ S, ε i := by
  have hs : 0 ≤ ∑ i ∈ S, ε i := sum_nonneg hε
  have hprod := finite_baseline_product_lower S b ε hb0 hb1 hε hlo
  have hp0 : 0 < ∏ i ∈ S, b i := by linarith
  have hp1 : (∏ i ∈ S, b i) ≤ 1 := prod_le_one₀ hb0 hb1
  have heq : (∏ i ∈ S, 1 / b i) = 1 / ∏ i ∈ S, b i := by
    simp only [one_div, prod_inv_distrib]
  rw [heq]
  constructor
  · exact (le_div_iff₀ hp0).mpr (by simpa using hp1)
  · apply (div_le_iff₀ hp0).mpr
    have hm := mul_le_mul_of_nonneg_left hprod (by linarith : 0 ≤ 1 + 2 * ∑ i ∈ S, ε i)
    nlinarith [mul_nonneg hs (show 0 ≤ 1 - 2 * ∑ i ∈ S, ε i by linarith)]

theorem sqrt_density_sub_one_bounds {d E : ℝ} (hE : 0 ≤ E)
    (hd : 1 ≤ d) (hdE : d ≤ 1 + 2 * E) :
    0 ≤ Real.sqrt d - 1 ∧ Real.sqrt d - 1 ≤ E := by
  have hd0 : 0 ≤ d := le_trans zero_le_one hd
  have hs := Real.sq_sqrt hd0
  have hp := Real.sqrt_nonneg d
  constructor
  · nlinarith
  · nlinarith [sq_nonneg E]

theorem finite_inverse_baseline_sqrt_bounds {I : Type*} (S : Finset I) (b ε : I → ℝ)
    (hb0 : ∀ i ∈ S, 0 ≤ b i) (hb1 : ∀ i ∈ S, b i ≤ 1)
    (hε : ∀ i ∈ S, 0 ≤ ε i) (hlo : ∀ i ∈ S, 1 - ε i ≤ b i)
    (hsmall : ∑ i ∈ S, ε i ≤ 1 / 2) :
    0 ≤ Real.sqrt (∏ i ∈ S, 1 / b i) - 1 ∧
      Real.sqrt (∏ i ∈ S, 1 / b i) - 1 ≤ ∑ i ∈ S, ε i := by
  obtain ⟨h1,h2⟩ := finite_inverse_baseline_product_bounds S b ε hb0 hb1 hε hlo hsmall
  exact sqrt_density_sub_one_bounds (sum_nonneg hε) h1 h2

/-- The actual lifespan baseline uses the total damping divided by the label modulus. -/
theorem memory_lifespan_inverse_product_bounds {I : Type*} (S : Finset I) (T p : I → ℝ)
    (hT : ∀ i ∈ S, 0 ≤ T i) (hp : ∀ i ∈ S, 0 < p i)
    (hsmall : ∑ i ∈ S, T i / p i ≤ 1 / 2) :
    1 ≤ ∏ i ∈ S, 1 / (1 - T i / p i) ∧
      (∏ i ∈ S, 1 / (1 - T i / p i)) ≤ 1 + 2 * ∑ i ∈ S, T i / p i := by
  have he (i) (hi : i ∈ S) : 0 ≤ T i / p i := div_nonneg (hT i hi) (hp i hi).le
  have hb0 (i) (hi : i ∈ S) : 0 ≤ 1 - T i / p i := by
    have hle := single_le_sum he hi
    linarith
  exact finite_inverse_baseline_product_bounds S (fun i => 1 - T i / p i)
    (fun i => T i / p i) hb0 (fun i hi => by linarith [he i hi]) he
    (fun _ _ => le_rfl) hsmall

theorem memory_lifespan_inverse_sqrt_bounds {I : Type*} (S : Finset I) (T p : I → ℝ)
    (hT : ∀ i ∈ S, 0 ≤ T i) (hp : ∀ i ∈ S, 0 < p i)
    (hsmall : ∑ i ∈ S, T i / p i ≤ 1 / 2) :
    0 ≤ Real.sqrt (∏ i ∈ S, 1 / (1 - T i / p i)) - 1 ∧
      Real.sqrt (∏ i ∈ S, 1 / (1 - T i / p i)) - 1 ≤ ∑ i ∈ S, T i / p i := by
  obtain ⟨h1, h2⟩ := memory_lifespan_inverse_product_bounds S T p hT hp hsmall
  exact sqrt_density_sub_one_bounds (sum_nonneg (fun i hi => div_nonneg (hT i hi) (hp i hi).le)) h1 h2

/-- A uniform lower label bound gives an explicit loss proportional to the
number of sampled coordinates, allowing the same label at several coordinates. -/
theorem memory_lifespan_uniform_density_bounds {I : Type*} (S : Finset I)
    (p : I → ℝ) {T P₀ : ℝ} (hT : 0 ≤ T) (hP₀ : 0 < P₀)
    (hp : ∀ i ∈ S, P₀ ≤ p i) (hsmall : (S.card : ℝ) * T / P₀ ≤ 1 / 2) :
    (1 ≤ ∏ i ∈ S, 1 / (1 - T / p i) ∧
      (∏ i ∈ S, 1 / (1 - T / p i)) ≤ 1 + 2 * ((S.card : ℝ) * T / P₀)) ∧
    (0 ≤ Real.sqrt (∏ i ∈ S, 1 / (1 - T / p i)) - 1 ∧
      Real.sqrt (∏ i ∈ S, 1 / (1 - T / p i)) - 1 ≤ (S.card : ℝ) * T / P₀) := by
  have hsum : (∑ i ∈ S, T / p i) ≤ (S.card : ℝ) * T / P₀ := by
    calc
      _ ≤ ∑ _i ∈ S, T / P₀ := sum_le_sum (fun i hi => div_le_div_of_nonneg_left hT hP₀ (hp i hi))
      _ = _ := by simp [mul_div_assoc]
  obtain ⟨h1, h2⟩ := memory_lifespan_inverse_product_bounds S (fun _ => T) p
    (fun _ _ => hT) (fun i hi => hP₀.trans_le (hp i hi)) (hsum.trans hsmall)
  obtain ⟨hs1, hs2⟩ := memory_lifespan_inverse_sqrt_bounds S (fun _ => T) p
    (fun _ _ => hT) (fun i hi => hP₀.trans_le (hp i hi)) (hsum.trans hsmall)
  exact ⟨⟨h1, h2.trans (by linarith)⟩, hs1, hs2.trans hsum⟩

/-- Pointwise active-coordinate density for the physical lifespan baseline.
The index set can contain several occurrences of one numerical prime. -/
theorem physical_lifespan_tilt_density_bounds {I G : Type*} [Fintype I]
    {P : G → Finset ℕ} (γ : I → G) (labels : ∀ i, P (γ i))
    (b : ∀ g, P g → ℝ) {T P₀ : ℝ} (hT : 0 ≤ T) (hP₀ : 0 < P₀)
    (hp : ∀ i, P₀ ≤ ((labels i).val : ℝ))
    (hb : ∀ i, b (γ i) (labels i) = 1 - T / ((labels i).val : ℝ))
    (hsmall : (Fintype.card I : ℝ) * T / P₀ ≤ 1 / 2) :
    (1 ≤ ∏ i, 1 / b (γ i) (labels i) ∧
      (∏ i, 1 / b (γ i) (labels i)) ≤ 1 + 2 * ((Fintype.card I : ℝ) * T / P₀)) ∧
    (0 ≤ Real.sqrt (∏ i, 1 / b (γ i) (labels i)) - 1 ∧
      Real.sqrt (∏ i, 1 / b (γ i) (labels i)) - 1 ≤ (Fintype.card I : ℝ) * T / P₀) := by
  simp_rw [hb]
  exact memory_lifespan_uniform_density_bounds univ
    (fun i => ((labels i).val : ℝ)) hT hP₀ (fun i _ => hp i) (by simpa using hsmall)

/-- The square-root density multiplier is pointwise close to the identity. -/
theorem sqrt_density_smul_sub_norm_le {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {d η : ℝ} (hη : 0 ≤ η) (hd : 1 ≤ d)
    (hupper : d ≤ 1 + 2 * η) (v : E) :
    ‖Real.sqrt d • v - v‖ ≤ η * ‖v‖ := by
  obtain ⟨h0, h1⟩ := sqrt_density_sub_one_bounds hη hd hupper
  have heq : Real.sqrt d • v - v = (Real.sqrt d - 1) • v := by rw [sub_smul, one_smul]
  rw [heq, norm_smul, Real.norm_eq_abs, abs_of_nonneg h0]
  exact mul_le_mul_of_nonneg_right h1 (norm_nonneg v)
end

section

/-- Tilting each independent slot multiplies the product law by the product density. -/
theorem physical_tilted_birth_product_eq {I G : Type*} [Fintype I]
    {P : G → Finset ℕ} (V : G → ℝ) (γ : I → G)
    (b : ∀ g, P g → ℝ) (labels : ∀ i, P (γ i)) :
    (∏ i, tiltedPhysicalBirthLaw V (γ i) (b (γ i)) (labels i)) =
      (∏ i, physicalLabelLaw V (γ i) (labels i)) *
        ∏ i, 1 / b (γ i) (labels i) := by
  simp only [tiltedPhysicalBirthLaw, div_eq_mul_inv, one_mul,
    Finset.prod_mul_distrib]

/-- Equivalent denominator form of the independent slot density identity. -/
theorem physical_tilted_birth_product_eq_div {I G : Type*} [Fintype I]
    {P : G → Finset ℕ} (V : G → ℝ) (γ : I → G)
    (b : ∀ g, P g → ℝ) (labels : ∀ i, P (γ i)) :
    (∏ i, tiltedPhysicalBirthLaw V (γ i) (b (γ i)) (labels i)) =
      (∏ i, physicalLabelLaw V (γ i) (labels i)) /
        ∏ i, b (γ i) (labels i) := by
  simp only [tiltedPhysicalBirthLaw, Finset.prod_div_distrib]

theorem physical_tilted_birth_density_nonneg {I G : Type*} [Fintype I]
    {P : G → Finset ℕ} (γ : I → G) (b : ∀ g, P g → ℝ)
    (labels : ∀ i, P (γ i)) (hb : ∀ i, 0 ≤ b (γ i) (labels i)) :
    0 ≤ ∏ i, 1 / b (γ i) (labels i) := by
  exact Finset.prod_nonneg (fun i _ => one_div_nonneg.mpr (hb i))

theorem physical_tilted_birth_density_pos {I G : Type*} [Fintype I]
    {P : G → Finset ℕ} (γ : I → G) (b : ∀ g, P g → ℝ)
    (labels : ∀ i, P (γ i)) (hb : ∀ i, 0 < b (γ i) (labels i)) :
    0 < ∏ i, 1 / b (γ i) (labels i) := by
  exact Finset.prod_pos (fun i _ => one_div_pos.mpr (hb i))

/-- Multiplication by the square-root density moves the density into the energy. -/
theorem weighted_sqrt_density_sq_norm {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] (d : ℝ) (hd : 0 ≤ d) (v : E) :
    ‖Real.sqrt d • v‖ ^ 2 = d * ‖v‖ ^ 2 := by
  rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (Real.sqrt_nonneg _),
    mul_pow, Real.sq_sqrt hd]

/-- Exact pointwise isometry from the tilted product measure to the original law. -/
theorem physical_tilted_birth_sqrt_energy {I G E : Type*} [Fintype I]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    {P : G → Finset ℕ} (V : G → ℝ) (γ : I → G)
    (b : ∀ g, P g → ℝ) (labels : ∀ i, P (γ i))
    (hb : ∀ i, 0 ≤ b (γ i) (labels i)) (v : E) :
    (∏ i, physicalLabelLaw V (γ i) (labels i)) *
        ‖Real.sqrt (∏ i, 1 / b (γ i) (labels i)) • v‖ ^ 2 =
      (∏ i, tiltedPhysicalBirthLaw V (γ i) (b (γ i)) (labels i)) * ‖v‖ ^ 2 := by
  rw [weighted_sqrt_density_sq_norm _
    (physical_tilted_birth_density_nonneg γ b labels hb),
    physical_tilted_birth_product_eq]
  exact (mul_assoc _ _ _).symm

/-- Arbitrary additional finite weights and state-dependent labels preserve the
exact energy identity; labels are not required to be injective. -/
theorem physical_tilted_birth_sum_energy {X I G E : Type*} [Fintype X] [Fintype I]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    {P : G → Finset ℕ} (V : G → ℝ) (γ : I → G)
    (b : ∀ g, P g → ℝ) (labels : X → ∀ i, P (γ i))
    (hb : ∀ x i, 0 ≤ b (γ i) (labels x i)) (w : X → ℝ) (F : X → E) :
    (∑ x, w x * ((∏ i, physicalLabelLaw V (γ i) (labels x i)) *
        ‖Real.sqrt (∏ i, 1 / b (γ i) (labels x i)) • F x‖ ^ 2)) =
      ∑ x, w x * ((∏ i,
        tiltedPhysicalBirthLaw V (γ i) (b (γ i)) (labels x i)) * ‖F x‖ ^ 2) := by
  apply Finset.sum_congr rfl
  intro x _
  rw [physical_tilted_birth_sqrt_energy V γ b (labels x) (hb x)]

/-- The square-root multiplier also preserves mixed complex energies exactly. -/
theorem physical_tilted_birth_inner_energy {I G : Type*} [Fintype I]
    {P : G → Finset ℕ} (V : G → ℝ) (γ : I → G)
    (b : ∀ g, P g → ℝ) (labels : ∀ i, P (γ i))
    (hb : ∀ i, 0 ≤ b (γ i) (labels i)) (u v : ℂ) :
    (((∏ i, physicalLabelLaw V (γ i) (labels i)) : ℝ) : ℂ) *
        (star ((Real.sqrt (∏ i, 1 / b (γ i) (labels i)) : ℂ) * u) *
          ((Real.sqrt (∏ i, 1 / b (γ i) (labels i)) : ℂ) * v)) =
      (((∏ i, tiltedPhysicalBirthLaw V (γ i) (b (γ i)) (labels i)) : ℝ) : ℂ) *
        (star u * v) := by
  rw [physical_tilted_birth_product_eq, Complex.ofReal_mul]
  have hs : ((Real.sqrt (∏ i, 1 / b (γ i) (labels i)) : ℂ) ^ 2) =
      (((∏ i, 1 / b (γ i) (labels i)) : ℝ) : ℂ) := by
    rw [← Complex.ofReal_pow, Real.sq_sqrt
      (physical_tilted_birth_density_nonneg γ b labels hb)]
  simp only [star_mul, Complex.star_def, Complex.conj_ofReal]
  calc
    _ = (((∏ i, physicalLabelLaw V (γ i) (labels i)) : ℝ) : ℂ) *
        (Real.sqrt (∏ i, 1 / b (γ i) (labels i)) : ℂ) ^ 2 *
        (star u * v) := by simp only [Complex.star_def]; ring
    _ = _ := by rw [hs]; rfl
end

section
open Finset
open scoped Classical
/-- The unique promotion map from the empty selected target-slot set. -/
def unrestrictedCleanPromotion (t : ℕ) {N : ℕ} (eligible : Finset (Fin N)) :
    (∅ : Finset (Fin t)) ↪ eligible := Function.Embedding.ofIsEmpty

theorem unrestricted_clean_promotion_unique {t N : ℕ} (eligible : Finset (Fin N))
    (e : (∅ : Finset (Fin t)) ↪ eligible) : e = unrestrictedCleanPromotion t eligible := by
  ext s
  exact (notMem_empty s.val s.property).elim

theorem unrestricted_clean_selected_indices {t N : ℕ} (eligible : Finset (Fin N)) :
    promotionSelectedIndices (unrestrictedCleanPromotion t eligible) = ∅ := by
  apply card_eq_zero.mp
  rw [promotionSelectedIndices_card]
  simp

theorem unrestricted_clean_survivors {t N : ℕ} (eligible : Finset (Fin N)) :
    unrestrictedEdgeSurvivors (unrestrictedCleanPromotion t eligible) = univ := by
  rw [unrestrictedEdgeSurvivors, unrestricted_clean_selected_indices, sdiff_empty]

/-- No promotion removes an old slot, irrespective of numerical label repetitions. -/
noncomputable def unrestrictedCleanSurvivorEquiv (t : ℕ) {N : ℕ}
    (eligible : Finset (Fin N)) :
    unrestrictedEdgeSurvivors (unrestrictedCleanPromotion t eligible) ≃ Fin N where
  toFun j := j.val
  invFun j := ⟨j, by rw [unrestricted_clean_survivors]; exact mem_univ j⟩
  left_inv _ := rfl
  right_inv _ := rfl

/-- The actual retained-and-appended output index, with an empty appended block,
identified with an old slot. It does not assume the retained enumeration is identity. -/
noncomputable def unrestrictedCleanIndexEquiv (t : ℕ) {N : ℕ}
    (eligible : Finset (Fin N)) :
    Fin ((unrestrictedEdgeSurvivors (unrestrictedCleanPromotion t eligible)).card + 0) ≃ Fin N :=
  (retainedBirthIndexEquiv _ 0).trans
    ((Equiv.sumEmpty _ (Fin 0)).trans (unrestrictedCleanSurvivorEquiv t eligible))

/-- Pointwise evaluation of the actual clean output under its index equivalence. -/
theorem unrestricted_clean_output_apply {P Z : Type*} {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (seed : P → Z) (transport : Z → Z)
    (eligible : Finset (Fin N))
    (j : Fin (unrestrictedEdgeOutput source old seed transport ∅ ∅
      (unrestrictedCleanPromotion t eligible)).1) :
    (unrestrictedEdgeOutput source old seed transport ∅ ∅
      (unrestrictedCleanPromotion t eligible)).2 j =
      transport (old (unrestrictedCleanIndexEquiv t eligible j)) := by
  change Fin ((unrestrictedEdgeSurvivors (unrestrictedCleanPromotion t eligible)).card + 0) at j
  change (retainedBirthTuple (transport ∘ old)
    (unrestrictedEdgeSurvivors (unrestrictedCleanPromotion t eligible))
    (transport ∘ unrestrictedStoredTuple source seed ∅)).2 j = _
  refine Eq.trans (retained_birth_tuple_apply_index_equiv (b := 0) (transport ∘ old)
    (unrestrictedEdgeSurvivors (unrestrictedCleanPromotion t eligible))
    (transport ∘ unrestrictedStoredTuple source seed ∅) j) ?_
  have hi : unrestrictedCleanIndexEquiv t eligible j =
      unrestrictedCleanSurvivorEquiv t eligible
        (Equiv.sumEmpty _ (Fin 0)
          (retainedBirthIndexEquiv
            (unrestrictedEdgeSurvivors (unrestrictedCleanPromotion t eligible)) 0 j)) := rfl
  rw [hi]
  generalize hk : retainedBirthIndexEquiv
    (unrestrictedEdgeSurvivors (unrestrictedCleanPromotion t eligible)) 0 j = k
  cases k with
  | inl k => rfl
  | inr k => exact Fin.elim0 k

theorem unrestricted_clean_output_length {P Z : Type*} {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (seed : P → Z) (transport : Z → Z)
    (eligible : Finset (Fin N)) :
    (unrestrictedEdgeOutput source old seed transport ∅ ∅
      (unrestrictedCleanPromotion t eligible)).1 = N := by
  change (unrestrictedEdgeMemory old transport (unrestrictedStoredTuple source seed ∅)
    (unrestrictedCleanPromotion t eligible)).1 = N
  rw [unrestrictedEdgeMemory_length]
  simp

/-- A symmetric tuple test is unchanged by any explicit index equivalence. -/
theorem ordered_tuple_symmetric_of_index_equiv {Z K : Type*}
    (F : FiniteOrderedTuple Z → K) (hF : OrderedTupleSymmetric F)
    (q : FiniteOrderedTuple Z) {N : ℕ} (p : Fin N → Z)
    (e : Fin q.1 ≃ Fin N) (hv : ∀ j, q.2 j = p (e j)) : F q = F ⟨N, p⟩ := by
  rcases q with ⟨n, q⟩
  have hn : n = N := by simpa only [Fintype.card_fin] using Fintype.card_congr e
  subst n
  have hq : q = p ∘ e := funext hv
  change F ⟨N, q⟩ = _
  rw [hq]
  exact hF N p e

/-- A symmetric tuple test only sees the transported old memory. -/
theorem unrestricted_clean_output_symmetric {P Z K : Type*} {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (seed : P → Z) (transport : Z → Z)
    (eligible : Finset (Fin N)) (F : FiniteOrderedTuple Z → K)
    (hF : OrderedTupleSymmetric F) :
    F (unrestrictedEdgeOutput source old seed transport ∅ ∅
      (unrestrictedCleanPromotion t eligible)) = F ⟨N, transport ∘ old⟩ :=
  ordered_tuple_symmetric_of_index_equiv F hF _ (transport ∘ old)
    (unrestrictedCleanIndexEquiv t eligible)
    (unrestricted_clean_output_apply source old seed transport eligible)

/-- Output hit counts include all transported old occurrences, even repeated ones. -/
theorem unrestricted_clean_output_count {P Z : Type*} {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (seed : P → Z) (transport : Z → Z)
    (eligible : Finset (Fin N)) (hit : Z → Prop) :
    orderedPredicateCount (unrestrictedEdgeOutput source old seed transport ∅ ∅
      (unrestrictedCleanPromotion t eligible)) hit =
      orderedPredicateCount ⟨N, transport ∘ old⟩ hit := by
  unfold orderedPredicateCount
  calc
    _ = ∑ j, if hit (transport (old (unrestrictedCleanIndexEquiv t eligible j))) then 1 else 0 := by
      apply sum_congr rfl
      intro j _
      rw [unrestricted_clean_output_apply]
    _ = _ := (unrestrictedCleanIndexEquiv t eligible).sum_comp
      (fun j => if hit (transport (old j)) then (1 : ℕ) else 0)

/-- Empty promotions remove the V denominator entirely. Both actual endpoint
rho counts remain, with no factorial or per-old-particle measure inserted. -/
theorem unrestricted_clean_event_mass {P Z : Type*} {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (seed : P → Z) (transport : Z → Z)
    (hit : Z → Prop) (μ : P → ℝ) (ρ V : ℝ) (eligible : Finset (Fin N))
    (fresh : UnrestrictedFreshLabels P (∅ : Finset (Fin t))) :
    unrestrictedEdgeEventMass source old seed transport hit μ ρ V ∅ ∅
      (unrestrictedCleanPromotion t eligible) fresh =
      (ρ ^ orderedPredicateCount ⟨N, old⟩ hit *
        ρ ^ orderedPredicateCount ⟨N, transport ∘ old⟩ hit) *
        unrestrictedFreshWeight μ ∅ fresh := by
  unfold unrestrictedEdgeEventMass
  rw [unrestricted_clean_output_count]
  simp only [card_empty, pow_zero, div_one]

/-- With no promotions, the fresh slots are every target slot. -/
def unrestrictedCleanFreshSlotEquiv (t : ℕ) :
    {j : Fin t // j ∉ (∅ : Finset (Fin t))} ≃ Fin t where
  toFun j := j.val
  invFun j := ⟨j, notMem_empty j⟩
  left_inv _ := rfl
  right_inv _ := rfl

def unrestrictedCleanFreshEquiv (P : Type*) (t : ℕ) :
    UnrestrictedFreshLabels P (∅ : Finset (Fin t)) ≃ (Fin t → P) where
  toFun fresh j := fresh ((unrestrictedCleanFreshSlotEquiv t).symm j)
  invFun target j := target j.val
  left_inv _ := rfl
  right_inv _ := rfl

theorem unrestricted_clean_target {P Z : Type*} {t N : ℕ}
    (old : Fin N → Z) (label : Z → P) (eligible : Finset (Fin N))
    (fresh : UnrestrictedFreshLabels P (∅ : Finset (Fin t))) :
    unrestrictedEdgeTarget old label ∅ (unrestrictedCleanPromotion t eligible) fresh =
      unrestrictedCleanFreshEquiv P t fresh := by
  funext j
  simp only [unrestrictedEdgeTarget, unrestrictedTargetLabels, notMem_empty]
  rfl

theorem unrestricted_clean_fresh_weight {P : Type*} {t : ℕ} (μ : P → ℝ)
    (fresh : UnrestrictedFreshLabels P (∅ : Finset (Fin t))) :
    unrestrictedFreshWeight μ ∅ fresh =
      ∏ j, μ (unrestrictedCleanFreshEquiv P t fresh j) := by
  exact (unrestrictedCleanFreshSlotEquiv t).prod_comp
    (fun j => μ (unrestrictedCleanFreshEquiv P t fresh j))

/-- Fresh targets remain arbitrary ordered tuples, including repeated labels,
and are integrated against precisely their product weights, with no factorial. -/
theorem unrestricted_clean_fresh_sum {P : Type*} [Fintype P] {t : ℕ}
    (μ : P → ℝ) (G : (Fin t → P) → ℝ) :
    (∑ fresh : UnrestrictedFreshLabels P (∅ : Finset (Fin t)),
      unrestrictedFreshWeight μ ∅ fresh * G (unrestrictedCleanFreshEquiv P t fresh)) =
      ∑ target : Fin t → P, (∏ j, μ (target j)) * G target := by
  simp_rw [unrestricted_clean_fresh_weight]
  exact (unrestrictedCleanFreshEquiv P t).sum_comp (fun target => (∏ j, μ (target j)) * G target)

/-- The exact clean-event target sum separates the two rho counts from the
unrestricted product fresh-label integral. -/
theorem unrestricted_clean_event_sum {P Z : Type*} [Fintype P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (label : Z → P)
    (seed : P → Z) (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ)
    (ρ V : ℝ) (eligible : Finset (Fin N)) (G : (Fin t → P) → ℝ) :
    (∑ fresh : UnrestrictedFreshLabels P (∅ : Finset (Fin t)),
      unrestrictedEdgeEventMass source old seed transport hit μ ρ V ∅ ∅
        (unrestrictedCleanPromotion t eligible) fresh *
        G (unrestrictedEdgeTarget old label ∅ (unrestrictedCleanPromotion t eligible) fresh)) =
      (ρ ^ orderedPredicateCount ⟨N, old⟩ hit *
        ρ ^ orderedPredicateCount ⟨N, transport ∘ old⟩ hit) *
        ∑ target : Fin t → P, (∏ j, μ (target j)) * G target := by
  simp_rw [unrestricted_clean_event_mass, unrestricted_clean_target, mul_assoc]
  rw [← mul_sum, ← mul_sum, unrestricted_clean_fresh_sum]

/-- Complex tests have the same unrestricted product fresh-label integral. -/
theorem unrestricted_clean_fresh_complex_sum {P : Type*} [Fintype P] {t : ℕ}
    (μ : P → ℝ) (G : (Fin t → P) → ℂ) :
    (∑ fresh : UnrestrictedFreshLabels P (∅ : Finset (Fin t)),
      (unrestrictedFreshWeight μ ∅ fresh : ℂ) * G (unrestrictedCleanFreshEquiv P t fresh)) =
      ∑ target : Fin t → P, ((∏ j, μ (target j) : ℝ) : ℂ) * G target := by
  simp_rw [unrestricted_clean_fresh_weight]
  exact (unrestrictedCleanFreshEquiv P t).sum_comp
    (fun target => ((∏ j, μ (target j) : ℝ) : ℂ) * G target)

/-- Exact complex event integral with both real rho factors retained. -/
theorem unrestricted_clean_event_complex_sum {P Z : Type*} [Fintype P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (label : Z → P)
    (seed : P → Z) (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ)
    (ρ V : ℝ) (eligible : Finset (Fin N)) (G : (Fin t → P) → ℂ) :
    (∑ fresh : UnrestrictedFreshLabels P (∅ : Finset (Fin t)),
      (unrestrictedEdgeEventMass source old seed transport hit μ ρ V ∅ ∅
        (unrestrictedCleanPromotion t eligible) fresh : ℂ) *
        G (unrestrictedEdgeTarget old label ∅ (unrestrictedCleanPromotion t eligible) fresh)) =
      ((ρ ^ orderedPredicateCount ⟨N, old⟩ hit *
        ρ ^ orderedPredicateCount ⟨N, transport ∘ old⟩ hit : ℝ) : ℂ) *
        ∑ target : Fin t → P, ((∏ j, μ (target j) : ℝ) : ℂ) * G target := by
  simp_rw [unrestricted_clean_event_mass, unrestricted_clean_target,
    Complex.ofReal_mul, mul_assoc]
  rw [← mul_sum, ← mul_sum, unrestricted_clean_fresh_complex_sum]

/-- A coupled complex continuation symmetric in memory is evaluated on the
transported old tuple inside the full unrestricted target integral. -/
theorem unrestricted_clean_symmetric_continuation {P Z : Type*} [Fintype P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (label : Z → P)
    (seed : P → Z) (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ)
    (ρ V : ℝ) (eligible : Finset (Fin N))
    (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ)
    (hF : ∀ target, OrderedTupleSymmetric (F target)) :
    (∑ fresh : UnrestrictedFreshLabels P (∅ : Finset (Fin t)),
      (unrestrictedEdgeEventMass source old seed transport hit μ ρ V ∅ ∅
        (unrestrictedCleanPromotion t eligible) fresh : ℂ) *
        F (unrestrictedEdgeTarget old label ∅ (unrestrictedCleanPromotion t eligible) fresh)
          (unrestrictedEdgeOutput source old seed transport ∅ ∅
            (unrestrictedCleanPromotion t eligible))) =
      ((ρ ^ orderedPredicateCount ⟨N, old⟩ hit *
        ρ ^ orderedPredicateCount ⟨N, transport ∘ old⟩ hit : ℝ) : ℂ) *
        ∑ target : Fin t → P, ((∏ j, μ (target j) : ℝ) : ℂ) * F target ⟨N, transport ∘ old⟩ := by
  simp_rw [unrestricted_clean_output_symmetric source old seed transport eligible _ (hF _)]
  exact unrestricted_clean_event_complex_sum source old label seed transport hit μ ρ V eligible
    (fun target => F target ⟨N, transport ∘ old⟩)
end

section
open Finset
/-- Fixed prime labels at every ordered memory index, allowing repetitions. -/
abbrev FixedOrderedMemoryLabels {G : Type*} (P : G → Finset ℕ) (N : G → ℕ) :=
  (g : G) → Fin (N g) → P g

/-- Residues are indexed by occurrences, even when their prime labels agree. -/
abbrev FixedOrderedResidues {G : Type*} {P : G → Finset ℕ} {N : G → ℕ}
    (p : FixedOrderedMemoryLabels P N) :=
  (g : G) → (j : Fin (N g)) → ZMod (p g j).val

/-- The common physical integer direction on all fixed residue coordinates. -/
def fixedOrderedResidueDirection {G : Type*} {P : G → Finset ℕ} {N : G → ℕ}
    (p : FixedOrderedMemoryLabels P N) : ℤ →+ FixedOrderedResidues p where
  toFun Δ g j := Δ
  map_zero' := by funext g j; exact Int.cast_zero
  map_add' a b := by funext g j; exact Int.cast_add a b

/-- Physical translation adds Delta; prime labels and lengths are parameters. -/
def fixedOrderedResidueTranslate {G : Type*} {P : G → Finset ℕ} {N : G → ℕ}
    (p : FixedOrderedMemoryLabels P N) (r : FixedOrderedResidues p) (Δ : ℤ) :
    FixedOrderedResidues p := r + fixedOrderedResidueDirection p Δ

theorem fixed_ordered_residue_translate_apply {G : Type*} {P : G → Finset ℕ}
    {N : G → ℕ} (p : FixedOrderedMemoryLabels P N) (r : FixedOrderedResidues p)
    (Δ : ℤ) (g : G) (j : Fin (N g)) :
    fixedOrderedResidueTranslate p r Δ g j = r g j + (Δ : ZMod (p g j).val) := rfl

theorem fixed_ordered_residue_translate_zero {G : Type*} {P : G → Finset ℕ}
    {N : G → ℕ} (p : FixedOrderedMemoryLabels P N) (r : FixedOrderedResidues p) :
    fixedOrderedResidueTranslate p r 0 = r := by
  simp [fixedOrderedResidueTranslate]

theorem fixed_ordered_residue_translate_add {G : Type*} {P : G → Finset ℕ}
    {N : G → ℕ} (p : FixedOrderedMemoryLabels P N) (r : FixedOrderedResidues p)
    (a b : ℤ) :
    fixedOrderedResidueTranslate p (fixedOrderedResidueTranslate p r a) b =
      fixedOrderedResidueTranslate p r (a + b) := by
  simp [fixedOrderedResidueTranslate, add_assoc]

/-- Physical translation is a bijection of the fixed memory residue fiber. -/
def fixedOrderedResidueTranslateEquiv {G : Type*} {P : G → Finset ℕ} {N : G → ℕ}
    (p : FixedOrderedMemoryLabels P N) (Δ : ℤ) :
    FixedOrderedResidues p ≃ FixedOrderedResidues p where
  toFun r := fixedOrderedResidueTranslate p r Δ
  invFun r := fixedOrderedResidueTranslate p r (-Δ)
  left_inv r := by
    change fixedOrderedResidueTranslate p (fixedOrderedResidueTranslate p r Δ) (-Δ) = r
    rw [fixed_ordered_residue_translate_add]
    simp [fixed_ordered_residue_translate_zero]
  right_inv r := by
    change fixedOrderedResidueTranslate p (fixedOrderedResidueTranslate p r (-Δ)) Δ = r
    rw [fixed_ordered_residue_translate_add]
    simp [fixed_ordered_residue_translate_zero]

/-- Finite counting measure on residue occurrences is translation invariant.
The nonzero-modulus assumptions are needed only for this finite sum. -/
theorem fixed_ordered_residue_translate_sum {G M : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {N : G → ℕ} (p : FixedOrderedMemoryLabels P N)
    [∀ g j, NeZero (p g j).val] [AddCommMonoid M]
    (Δ : ℤ) (F : FixedOrderedResidues p → M) :
    (∑ r, F (fixedOrderedResidueTranslate p r Δ)) = ∑ r, F r :=
  (fixedOrderedResidueTranslateEquiv p Δ).sum_comp F

/-- Embed one fixed group fiber into the actual sigma-particle tuple type. -/
def fixedOrderedResidueMemory {G : Type*} {P : G → Finset ℕ} {N : G → ℕ}
    (p : FixedOrderedMemoryLabels P N) (r : FixedOrderedResidues p) (g : G) :
    FiniteOrderedTuple (UnrestrictedResidueParticle (fun q : P g => q.val)) :=
  ⟨N g, fun j => ⟨p g j, r g j⟩⟩

theorem fixed_ordered_residue_memory_length {G : Type*} {P : G → Finset ℕ}
    {N : G → ℕ} (p : FixedOrderedMemoryLabels P N) (r : FixedOrderedResidues p)
    (g : G) : (fixedOrderedResidueMemory p r g).1 = N g := rfl

theorem fixed_ordered_residue_memory_labels {G : Type*} {P : G → Finset ℕ}
    {N : G → ℕ} (p : FixedOrderedMemoryLabels P N) (r : FixedOrderedResidues p)
    (g : G) : (fun j => ((fixedOrderedResidueMemory p r g).2 j).1) = p g := rfl

/-- The sign conversion to the existing unrestricted transport is exact at
every actual ordered particle, without any injectivity assumption. -/
theorem fixed_ordered_residue_memory_transport_apply {G : Type*}
    {P : G → Finset ℕ} {N : G → ℕ}
    (p : FixedOrderedMemoryLabels P N) (r : FixedOrderedResidues p)
    (Δ : ℤ) (g : G) (j : Fin (N g)) :
    (fixedOrderedResidueMemory p (fixedOrderedResidueTranslate p r Δ) g).2 j =
      unrestrictedResidueTransport (fun q : P g => q.val) (-Δ)
        ((fixedOrderedResidueMemory p r g).2 j) := by
  simp only [fixedOrderedResidueMemory, fixed_ordered_residue_translate_apply,
    unrestrictedResidueTransport_apply, Int.cast_neg, sub_neg_eq_add]

/-- Whole-tuple equality keeps exactly the same ordered memory sector. -/
theorem fixed_ordered_residue_memory_transport {G : Type*}
    {P : G → Finset ℕ} {N : G → ℕ}
    (p : FixedOrderedMemoryLabels P N) (r : FixedOrderedResidues p)
    (Δ : ℤ) (g : G) :
    fixedOrderedResidueMemory p (fixedOrderedResidueTranslate p r Δ) g =
      ⟨N g, unrestrictedResidueTransport (fun q : P g => q.val) (-Δ) ∘
        (fixedOrderedResidueMemory p r g).2⟩ := by
  have h := funext (fixed_ordered_residue_memory_transport_apply p r Δ g)
  exact congrArg (fun q => (⟨N g, q⟩ :
    FiniteOrderedTuple (UnrestrictedResidueParticle (fun q : P g => q.val)))) h
end

section
open Finset
open scoped Classical
abbrev RepeatedBigLists {G : Type*} (P : G → Finset ℕ) (J ell : ℕ) :=
  ∀ g, PhysicalSlots J ell → P g

def repeatedBigUnshared {G : Type*} {J ell : ℕ}
    (C : G → Finset (Fin J)) (g : G) : PhysicalSlots J ell → Prop
  | Sum.inl j => j ∈ C g
  | Sum.inr _ => True

abbrev RepeatedBigFresh {G : Type*} (P : G → Finset ℕ) {J : ℕ}
    (C : G → Finset (Fin J)) (ell : ℕ) :=
  ∀ g, {s : PhysicalSlots J ell // repeatedBigUnshared C g s} → P g

def repeatedBigSharedCompatible {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (source target : RepeatedBigLists P J ell) : Prop :=
  ∀ g j, j ∉ C g → source g (Sum.inl j) = target g (Sum.inl j)

noncomputable def repeatedBigFill {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (source : RepeatedBigLists P J ell)
    (fresh : RepeatedBigFresh P C ell) : RepeatedBigLists P J ell := by
  classical
  exact fun g s => if h : repeatedBigUnshared C g s then fresh g ⟨s, h⟩ else source g s

theorem repeated_big_fill_unshared {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (source : RepeatedBigLists P J ell)
    (fresh : RepeatedBigFresh P C ell) (g : G)
    (s : {s : PhysicalSlots J ell // repeatedBigUnshared C g s}) :
    repeatedBigFill C source fresh g s.val = fresh g s := by
  simp [repeatedBigFill, s.property]

theorem repeated_big_fill_shared {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (source : RepeatedBigLists P J ell)
    (fresh : RepeatedBigFresh P C ell) :
    repeatedBigSharedCompatible C source (repeatedBigFill C source fresh) := by
  intro g j hj
  simp [repeatedBigFill, repeatedBigUnshared, hj]

noncomputable def repeatedBigFreshEquiv {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (source : RepeatedBigLists P J ell) :
    RepeatedBigFresh P C ell ≃
      {target : RepeatedBigLists P J ell // repeatedBigSharedCompatible C source target} where
  toFun fresh := ⟨repeatedBigFill C source fresh, repeated_big_fill_shared C source fresh⟩
  invFun target g s := target.val g s.val
  left_inv fresh := by
    funext g s
    exact repeated_big_fill_unshared C source fresh g s
  right_inv target := by
    apply Subtype.ext
    funext g s
    dsimp [repeatedBigFill]
    split_ifs with h
    · rfl
    · cases s with
      | inl j => exact target.property g j h
      | inr j => exact (h trivial).elim

theorem repeated_big_target_sum {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (source : RepeatedBigLists P J ell) {A : Type*} [AddCommMonoid A]
    (F : RepeatedBigLists P J ell → A) :
    (∑ fresh : RepeatedBigFresh P C ell, F (repeatedBigFill C source fresh)) =
      ∑ target : RepeatedBigLists P J ell,
        if repeatedBigSharedCompatible C source target then F target else 0 := by
  classical
  calc
    _ = ∑ target : {target : RepeatedBigLists P J ell //
        repeatedBigSharedCompatible C source target}, F target.val :=
      (repeatedBigFreshEquiv C source).sum_comp (fun target => F target.val)
    _ = _ := by
      rw [← Finset.sum_filter]
      exact Finset.sum_subtype (p := fun target => repeatedBigSharedCompatible C source target)
        (Finset.univ.filter (fun target => repeatedBigSharedCompatible C source target))
        (fun _ => by simp) F |>.symm
end

section
open Finset
theorem finite_conditioned_bilinear_sum {A B C D R : Type*}
    [Fintype A] [Fintype B] [Fintype C] [Fintype D] [CommSemiring R]
    (w : A → R) (f : A → B → C → R) (u : A → D → R)
    (v : A → B → C → D → R)
    (hf : ∀ a b c, f a b c = ∑ d, u a d * v a b c d) :
    (∑ a, ∑ b, ∑ c, w a * f a b c) =
      ∑ d, ∑ a, w a * u a d * ∑ b, ∑ c, v a b c d := by
  simp_rw [hf, mul_sum, ← mul_assoc]
  calc
    _ = ∑ a, ∑ b, ∑ d, ∑ c, w a * u a d * v a b c d := by
      apply sum_congr rfl
      intro a _
      apply sum_congr rfl
      intro b _
      exact sum_comm
    _ = ∑ a, ∑ d, ∑ b, ∑ c, w a * u a d * v a b c d := by
      apply sum_congr rfl
      intro a _
      exact sum_comm
    _ = _ := sum_comm
end

section
open scoped BigOperators InnerProductSpace
theorem finite_gram_row_norm_sq {X E : Type*} [Fintype X]
    [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (u : X → E) (c : X → ℂ) {B : ℝ}
    (hrow : ∀ i, (∑ j, ‖inner ℂ (u i) (u j)‖) ≤ B) :
    ‖∑ i, c i • u i‖ ^ 2 ≤ B * ∑ i, ‖c i‖ ^ 2 := by
  classical
  have he : ‖∑ i, c i • u i‖ ^ 2 =
      ∑ i, ∑ j, (inner ℂ (c i • u i) (c j • u j)).re := by
    rw [norm_sq_eq_re_inner (𝕜 := ℂ)]
    change (inner ℂ (∑ i, c i • u i) (∑ i, c i • u i)).re = _
    simp only [sum_inner, inner_sum, Complex.re_sum]
    exact Finset.sum_comm
  have hp (i j : X) : 2 * (inner ℂ (c i • u i) (c j • u j)).re ≤
      ‖c i‖ ^ 2 * ‖inner ℂ (u i) (u j)‖ + ‖c j‖ ^ 2 * ‖inner ℂ (u i) (u j)‖ := by
    have h := Complex.re_le_norm (inner ℂ (c i • u i) (c j • u j))
    have hn : ‖inner ℂ (c i • u i) (c j • u j)‖ =
        ‖c i‖ * ‖c j‖ * ‖inner ℂ (u i) (u j)‖ := by
      rw [inner_smul_left, inner_smul_right]
      simp only [norm_mul, Complex.norm_conj, mul_assoc]
    rw [hn] at h
    nlinarith [mul_nonneg (sq_nonneg (‖c i‖ - ‖c j‖))
      (norm_nonneg (inner ℂ (u i) (u j)))]
  have hs := Finset.sum_le_sum (fun i (_ : i ∈ (Finset.univ : Finset X)) =>
    Finset.sum_le_sum (fun j (_ : j ∈ (Finset.univ : Finset X)) => hp i j))
  have hswap : (∑ i, ∑ j, ‖c j‖ ^ 2 * ‖inner ℂ (u i) (u j)‖) =
      ∑ i, ‖c i‖ ^ 2 * ∑ j, ‖inner ℂ (u i) (u j)‖ := by
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro i _
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _
    rw [norm_inner_symm (𝕜 := ℂ) (u j) (u i)]
  simp only [Finset.sum_add_distrib] at hs
  simp_rw [← Finset.mul_sum] at hs
  rw [hswap] at hs
  have hmid : ‖∑ i, c i • u i‖ ^ 2 ≤
      ∑ i, ‖c i‖ ^ 2 * ∑ j, ‖inner ℂ (u i) (u j)‖ := by
    rw [he]
    linarith
  calc
    _ ≤ ∑ i, ‖c i‖ ^ 2 * ∑ j, ‖inner ℂ (u i) (u j)‖ := hmid
    _ ≤ ∑ i, ‖c i‖ ^ 2 * B := Finset.sum_le_sum (fun i _ =>
      mul_le_mul_of_nonneg_left (hrow i) (sq_nonneg _))
    _ = _ := by rw [← Finset.sum_mul, mul_comm]

theorem finite_near_orthogonal_norm_sq {X E : Type*} [Fintype X]
    [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (u : X → E) (c : X → ℂ) {ε : ℝ} (_hε : 0 ≤ ε)
    (hdiag : ∀ i, ‖u i‖ ^ 2 ≤ 1)
    (hoff : ∀ i j, i ≠ j → ‖inner ℂ (u i) (u j)‖ ≤ ε) :
    ‖∑ i, c i • u i‖ ^ 2 ≤
      (1 + (Fintype.card X - 1 : ℕ) * ε) * ∑ i, ‖c i‖ ^ 2 := by
  classical
  apply finite_gram_row_norm_sq u c
  intro i
  have hrow : (∑ j, ‖inner ℂ (u i) (u j)‖) ≤
      ∑ j : X, if j = i then 1 else ε := by
    apply Finset.sum_le_sum
    intro j _
    by_cases h : j = i
    · subst j
      have hn : inner ℂ (u i) (u i) = (‖u i‖ : ℂ) ^ 2 :=
        inner_self_eq_norm_sq_to_K (𝕜 := ℂ) (u i)
      rw [hn, norm_pow, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (norm_nonneg _), if_pos rfl]
      exact hdiag i
    · simpa only [if_neg h] using hoff i j (Ne.symm h)
  refine hrow.trans_eq ?_
  rw [← Finset.sum_erase_add _ _ (Finset.mem_univ i)]
  simp only [if_true]
  rw [Finset.sum_congr rfl (fun j hj => if_neg (Finset.ne_of_mem_erase hj))]
  simp [Finset.card_erase_of_mem (Finset.mem_univ i), add_comm]


theorem finite_gram_row_analysis_sq {X E : Type*} [Fintype X]
    [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (u : X → E) {B : ℝ} (hB : 0 ≤ B)
    (hrow : ∀ i, (∑ j, ‖inner ℂ (u i) (u j)‖) ≤ B) (f : E) :
    (∑ i, ‖inner ℂ (u i) f‖ ^ 2) ≤ B * ‖f‖ ^ 2 := by
  let energy : ℝ := ∑ i, ‖inner ℂ (u i) f‖ ^ 2
  let v : E := ∑ i, inner ℂ (u i) f • u i
  have he0 : 0 ≤ energy := Finset.sum_nonneg (fun _ _ => sq_nonneg _)
  have he : (inner ℂ v f).re = energy := by
    dsimp [v, energy]
    rw [sum_inner]
    simp only [Complex.re_sum, inner_smul_left, Complex.conj_mul', ← Complex.ofReal_pow,
      Complex.ofReal_re]
  have hn := finite_gram_row_norm_sq u (fun i => inner ℂ (u i) f) hrow
  change ‖v‖ ^ 2 ≤ B * energy at hn
  have he_le : energy ≤ ‖v‖ * ‖f‖ := by
    rw [← he]
    exact (Complex.re_le_norm _).trans (norm_inner_le_norm _ _)
  have hs : energy ^ 2 ≤ (B * energy) * ‖f‖ ^ 2 := by
    calc
      _ ≤ (‖v‖ * ‖f‖) ^ 2 := (sq_le_sq₀ he0 (by positivity)).mpr he_le
      _ = ‖v‖ ^ 2 * ‖f‖ ^ 2 := mul_pow _ _ _
      _ ≤ _ := mul_le_mul_of_nonneg_right hn (sq_nonneg _)
  change energy ≤ B * ‖f‖ ^ 2
  rcases eq_or_lt_of_le he0 with heq | hpos
  · rw [← heq]
    positivity
  · nlinarith

theorem finite_near_orthogonal_frame_sq {X E : Type*} [Fintype X]
    [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (u : X → E) {ε : ℝ} (hε : 0 ≤ ε)
    (hdiag : ∀ i, ‖u i‖ ^ 2 ≤ 1)
    (hoff : ∀ i j, i ≠ j → ‖inner ℂ (u i) (u j)‖ ≤ ε) (f : E) :
    ‖∑ i, inner ℂ (u i) f • u i‖ ^ 2 ≤
      (1 + (Fintype.card X - 1 : ℕ) * ε) ^ 2 * ‖f‖ ^ 2 := by
  let B : ℝ := 1 + (Fintype.card X - 1 : ℕ) * ε
  have hB : 0 ≤ B := by dsimp [B]; positivity
  have hs (c : X → ℂ) : ‖∑ i, c i • u i‖ ^ 2 ≤ B * ∑ i, ‖c i‖ ^ 2 :=
    finite_near_orthogonal_norm_sq u c hε hdiag hoff
  let energy : ℝ := ∑ i, ‖inner ℂ (u i) f‖ ^ 2
  let v : E := ∑ i, inner ℂ (u i) f • u i
  have he0 : 0 ≤ energy := Finset.sum_nonneg (fun _ _ => sq_nonneg _)
  have he : (inner ℂ v f).re = energy := by
    dsimp [v, energy]
    rw [sum_inner]
    simp only [Complex.re_sum, inner_smul_left, Complex.conj_mul', ← Complex.ofReal_pow,
      Complex.ofReal_re]
  have hn : ‖v‖ ^ 2 ≤ B * energy := hs _
  have he_le : energy ≤ ‖v‖ * ‖f‖ := by
    rw [← he]
    exact (Complex.re_le_norm _).trans (norm_inner_le_norm _ _)
  have hsquare : energy ^ 2 ≤ (B * energy) * ‖f‖ ^ 2 := by
    calc
      _ ≤ (‖v‖ * ‖f‖) ^ 2 := (sq_le_sq₀ he0 (by positivity)).mpr he_le
      _ = ‖v‖ ^ 2 * ‖f‖ ^ 2 := mul_pow _ _ _
      _ ≤ _ := mul_le_mul_of_nonneg_right hn (sq_nonneg _)
  have henergy : energy ≤ B * ‖f‖ ^ 2 := by
    rcases eq_or_lt_of_le he0 with heq | hpos
    · rw [← heq]; positivity
    · nlinarith
  change ‖v‖ ^ 2 ≤ B ^ 2 * ‖f‖ ^ 2
  calc
    _ ≤ B * energy := hn
    _ ≤ B * (B * ‖f‖ ^ 2) := mul_le_mul_of_nonneg_left henergy hB
    _ = _ := by ring


theorem finite_near_orthogonal_frame_norm {X E : Type*} [Fintype X]
    [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (u : X → E) {ε : ℝ} (hε : 0 ≤ ε)
    (hdiag : ∀ i, ‖u i‖ ^ 2 ≤ 1)
    (hoff : ∀ i j, i ≠ j → ‖inner ℂ (u i) (u j)‖ ≤ ε) (f : E) :
    ‖∑ i, inner ℂ (u i) f • u i‖ ≤
      (1 + (Fintype.card X - 1 : ℕ) * ε) * ‖f‖ := by
  apply (sq_le_sq₀ (norm_nonneg _) (by positivity)).mp
  simpa only [mul_pow] using finite_near_orthogonal_frame_sq u hε hdiag hoff f
end

section
open Finset Classical
theorem finite_gated_weighted_cauchy {I : Type*} [Fintype I]
    (a gate w : I → ℝ) (phase f : I → ℂ)
    (ha : ∀ i, 0 ≤ a i) (hgate0 : ∀ i, 0 ≤ gate i) (hgate1 : ∀ i, gate i ≤ 1)
    (hw : ∀ i, 0 < w i) (hphase : ∀ i, ‖phase i‖ ≤ 1) :
    ‖∑ i, (a i : ℂ) * ((gate i : ℂ) * phase i) * f i‖ ^ 2 ≤
      (∑ i, a i * w i) * ∑ i, (a i * gate i) * ‖f i‖ ^ 2 / w i := by
  have hag (i : I) : 0 ≤ a i * gate i := mul_nonneg (ha i) (hgate0 i)
  have hnorm (i : I) : ‖((a i * gate i : ℝ) : ℂ)‖ = a i * gate i := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hag i)]
  have hc := complex_row_weighted_cauchy (univ : Finset I)
    (fun i => ((a i * gate i : ℝ) : ℂ)) (fun i => phase i * f i) w (fun i _ => hw i)
  simp_rw [hnorm] at hc
  have hrow : (∑ i, (a i * gate i) * w i) ≤ ∑ i, a i * w i := by
    apply sum_le_sum
    intro i hi
    exact mul_le_mul_of_nonneg_right
      (by simpa only [mul_one] using mul_le_mul_of_nonneg_left (hgate1 i) (ha i)) (hw i).le
  have hsquare : (∑ i, (a i * gate i) * ‖phase i * f i‖ ^ 2 / w i) ≤
      ∑ i, (a i * gate i) * ‖f i‖ ^ 2 / w i := by
    apply sum_le_sum
    intro i hi
    apply div_le_div_of_nonneg_right _ (hw i).le
    apply mul_le_mul_of_nonneg_left _ (hag i)
    apply (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mpr
    rw [norm_mul]
    simpa only [one_mul] using mul_le_mul_of_nonneg_right (hphase i) (norm_nonneg (f i))
  have hbound := hc.trans (mul_le_mul hrow hsquare
    (sum_nonneg fun i _ => div_nonneg (mul_nonneg (hag i) (sq_nonneg _)) (hw i).le)
    (sum_nonneg fun i _ => mul_nonneg (ha i) (hw i).le))
  simpa only [Complex.ofReal_mul, mul_assoc] using hbound

noncomputable def unrestrictedEdgeGatedSquareMass {P Z : Type*} [Fintype P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (label : Z → P)
    (seed : P → Z) (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ)
    (ρ V v : ℝ) (eligible : Finset (Fin N)) (B : ℕ)
    (gate : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥eligible) → UnrestrictedFreshLabels P promotions → ℝ)
    (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ) : ℝ :=
  ∑ stores : Finset (Fin t), ∑ promotions : Finset (Fin t),
    ∑ e : promotions ↪ ↥eligible, ∑ fresh : UnrestrictedFreshLabels P promotions,
      (unrestrictedEdgeEventMass source old seed transport hit μ ρ V stores promotions e fresh *
        gate stores promotions e fresh) *
        (if (unrestrictedEdgeOutput source old seed transport stores promotions e).1 ≤ B then
          ‖F (unrestrictedEdgeTarget old label promotions e fresh)
              (unrestrictedEdgeOutput source old seed transport stores promotions e)‖ ^ 2 /
            v ^ (unrestrictedEdgeOutput source old seed transport stores promotions e).1
        else 0)

theorem unrestricted_edge_gated_square_mass_nonneg {P Z : Type*} [Fintype P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (label : Z → P)
    (seed : P → Z) (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ)
    {ρ V v : ℝ} (hρ : 0 ≤ ρ) (hV : 0 ≤ V) (hv : 0 ≤ v)
    (hμ : ∀ p, 0 ≤ μ p) (eligible : Finset (Fin N)) (B : ℕ)
    (gate : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥eligible) → UnrestrictedFreshLabels P promotions → ℝ)
    (hgate0 : ∀ stores promotions e fresh, 0 ≤ gate stores promotions e fresh)
    (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ) :
    0 ≤ unrestrictedEdgeGatedSquareMass source old label seed transport hit μ
      ρ V v eligible B gate F := by
  apply sum_nonneg
  intro stores hs
  apply sum_nonneg
  intro promotions hp
  apply sum_nonneg
  intro e he
  apply sum_nonneg
  intro fresh hf
  apply mul_nonneg (mul_nonneg (unrestrictedEdgeEventMass_nonneg source old seed transport hit μ
    hρ hV hμ stores promotions e fresh) (hgate0 stores promotions e fresh))
  split_ifs
  · exact div_nonneg (sq_nonneg _) (pow_nonneg hv _)
  · exact le_rfl

theorem unrestricted_edge_action_gated_cauchy {P Z : Type*} [Fintype P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (label : Z → P)
    (seed : P → Z) (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ)
    {ρ V v : ℝ} (hρ : 0 ≤ ρ) (hV : 0 ≤ V) (hv : 0 < v)
    (hμ : ∀ p, 0 ≤ μ p) (eligible : Finset (Fin N)) (B : ℕ)
    (gate : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥eligible) → UnrestrictedFreshLabels P promotions → ℝ)
    (hgate0 : ∀ stores promotions e fresh, 0 ≤ gate stores promotions e fresh)
    (hgate1 : ∀ stores promotions e fresh, gate stores promotions e fresh ≤ 1)
    (phase : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥eligible) → UnrestrictedFreshLabels P promotions → ℂ)
    (hphase : ∀ stores promotions e fresh, ‖phase stores promotions e fresh‖ ≤ 1)
    (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ) :
    ‖unrestrictedEdgeAction source old label seed transport hit μ ρ V eligible B
        (fun stores promotions e fresh =>
          (gate stores promotions e fresh : ℂ) * phase stores promotions e fresh) F‖ ^ 2 ≤
      unrestrictedEdgeRowMass source old seed transport hit μ ρ V v eligible *
        unrestrictedEdgeGatedSquareMass source old label seed transport hit μ ρ V v eligible B gate F := by
  let Q := Σ stores : Finset (Fin t), Σ promotions : Finset (Fin t),
    (promotions ↪ ↥eligible) × UnrestrictedFreshLabels P promotions
  let mass : Q → ℝ := fun q =>
    unrestrictedEdgeEventMass source old seed transport hit μ ρ V q.1 q.2.1 q.2.2.1 q.2.2.2
  let gateQ : Q → ℝ := fun q => gate q.1 q.2.1 q.2.2.1 q.2.2.2
  let weight : Q → ℝ := fun q =>
    v ^ (unrestrictedEdgeOutput source old seed transport q.1 q.2.1 q.2.2.1).1
  let phaseQ : Q → ℂ := fun q => phase q.1 q.2.1 q.2.2.1 q.2.2.2
  let value : Q → ℂ := fun q =>
    if (unrestrictedEdgeOutput source old seed transport q.1 q.2.1 q.2.2.1).1 ≤ B then
      F (unrestrictedEdgeTarget old label q.2.1 q.2.2.1 q.2.2.2)
        (unrestrictedEdgeOutput source old seed transport q.1 q.2.1 q.2.2.1) else 0
  have hc := finite_gated_weighted_cauchy mass gateQ weight phaseQ value
    (fun q => unrestrictedEdgeEventMass_nonneg source old seed transport hit μ hρ hV hμ
      q.1 q.2.1 q.2.2.1 q.2.2.2)
    (fun q => hgate0 q.1 q.2.1 q.2.2.1 q.2.2.2)
    (fun q => hgate1 q.1 q.2.1 q.2.2.1 q.2.2.2) (fun _ => pow_pos hv _)
    (fun q => hphase q.1 q.2.1 q.2.2.1 q.2.2.2)
  have hsquare : (∑ q : Q, (mass q * gateQ q) * ‖value q‖ ^ 2 / weight q) =
      unrestrictedEdgeGatedSquareMass source old label seed transport hit μ ρ V v eligible B gate F := by
    simp only [Q, Fintype.sum_sigma, Fintype.sum_prod_type, mass, gateQ, value, weight,
      unrestrictedEdgeGatedSquareMass]
    apply sum_congr rfl
    intro stores hs
    apply sum_congr rfl
    intro promotions hp
    apply sum_congr rfl
    intro e he
    apply sum_congr rfl
    intro fresh hf
    split_ifs <;> simp [mul_div_assoc]
  rw [hsquare] at hc
  simpa only [Q, Fintype.sum_sigma, Fintype.sum_prod_type, mass, gateQ, weight, phaseQ, value,
    unrestrictedEdgeAction, unrestrictedEdgeRowMass, unrestrictedEdgeChoiceRowMass] using hc

noncomputable def unrestrictedResidueEdgeSquareMass {P : Type*} [Fintype P] {t N : ℕ}
    (n : P → ℕ) (Δ D : ℤ) (source : Fin t → P)
    (old : Fin N → UnrestrictedResidueParticle n) (μ : P → ℝ)
    (ρ V v : ℝ) (B : ℕ)
    (F : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) : ℝ :=
  unrestrictedEdgeGatedSquareMass source old Sigma.fst (unrestrictedResidueSeed n)
    (unrestrictedResidueTransport n Δ) unrestrictedResidueHit μ ρ V v
    (unrestrictedResidueEligible n Δ D old) B
    (fun stores _ _ _ => if unrestrictedResidueStorageAllowed n D source stores then 1 else 0) F

/-- Physical Cauchy retains the storage ban in its squared contribution. -/
theorem unrestricted_residue_edge_weighted_cauchy {P : Type*} [Fintype P] {t N : ℕ}
    (n : P → ℕ) (Δ D : ℤ) (source : Fin t → P)
    (old : Fin N → UnrestrictedResidueParticle n) (μ : P → ℝ)
    {ρ V v : ℝ} (hρ : 0 ≤ ρ) (hV : 0 ≤ V) (hv : 0 < v)
    (hμ : ∀ p, 0 ≤ μ p) (B : ℕ)
    (phase : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥(unrestrictedResidueEligible n Δ D old)) →
        UnrestrictedFreshLabels P promotions → ℂ)
    (hphase : ∀ stores promotions e fresh, ‖phase stores promotions e fresh‖ ≤ 1)
    (F : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    ‖unrestrictedResidueEdgeAction n Δ D source old μ ρ V B phase F‖ ^ 2 ≤
      unrestrictedEdgeRowMass source old (unrestrictedResidueSeed n)
        (unrestrictedResidueTransport n Δ) unrestrictedResidueHit μ ρ V v
        (unrestrictedResidueEligible n Δ D old) *
          unrestrictedResidueEdgeSquareMass n Δ D source old μ ρ V v B F := by
  have hc := unrestricted_edge_action_gated_cauchy source old Sigma.fst
    (unrestrictedResidueSeed n) (unrestrictedResidueTransport n Δ) unrestrictedResidueHit μ
    hρ hV hv hμ (unrestrictedResidueEligible n Δ D old) B
    (fun stores _ _ _ => if unrestrictedResidueStorageAllowed n D source stores then 1 else 0)
    (by intros; split_ifs <;> norm_num) (by intros; split_ifs <;> norm_num) phase hphase F
  have hgate stores promotions e fresh :
      ((if unrestrictedResidueStorageAllowed n D source stores then 1 else 0 : ℝ) : ℂ) *
        phase stores promotions e fresh =
      if unrestrictedResidueStorageAllowed n D source stores then phase stores promotions e fresh
        else 0 := by
    split_ifs <;> simp
  simpa only [hgate, unrestrictedResidueEdgeAction, unrestrictedResidueEdgeSquareMass] using hc

theorem unrestricted_residue_edge_sq_le_row_bound {P : Type*} [Fintype P] {t N : ℕ}
    (n : P → ℕ) (Δ D : ℤ) (source : Fin t → P)
    (old : Fin N → UnrestrictedResidueParticle n) (μ : P → ℝ)
    {ρ V v vmin : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hV : vmin ≤ V) (hμ : ∀ p, 0 ≤ μ p)
    (hmass : ∑ p, μ p ≤ 2) (B T : ℕ) (ht : t ≤ T)
    (phase : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥(unrestrictedResidueEligible n Δ D old)) →
        UnrestrictedFreshLabels P promotions → ℂ)
    (hphase : ∀ stores promotions e fresh, ‖phase stores promotions e fresh‖ ≤ 1)
    (F : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    ‖unrestrictedResidueEdgeAction n Δ D source old μ ρ V B phase F‖ ^ 2 ≤
      (v ^ N * unrestrictedEdgeRowBound ρ v vmin T) *
        unrestrictedResidueEdgeSquareMass n Δ D source old μ ρ V v B F := by
  have hv0 : 0 < v := zero_lt_one.trans hv
  have hV0 : 0 ≤ V := (hvmin.trans_le hV).le
  exact (unrestricted_residue_edge_weighted_cauchy n Δ D source old μ hρ0.le hV0 hv0
    hμ B phase hphase F).trans (mul_le_mul_of_nonneg_right
      (unrestricted_edge_row_mass_le source old (unrestrictedResidueSeed n)
        (unrestrictedResidueTransport n Δ) unrestrictedResidueHit μ hρ0 hρ1 hv hvmin hV
        hμ hmass (unrestrictedResidueEligible n Δ D old)
        (unrestrictedResidueEligible_translated_hit n Δ D old) T ht)
      (unrestricted_edge_gated_square_mass_nonneg source old Sigma.fst (unrestrictedResidueSeed n)
        (unrestrictedResidueTransport n Δ) unrestrictedResidueHit μ hρ0.le hV0 hv0.le hμ
        (unrestrictedResidueEligible n Δ D old) B _
        (by intros; split_ifs <;> norm_num) F))

/-- The retained-mask square mass is precisely the phase-one physical edge
applied to the divided squared-norm test. This is the interface for adjointness. -/
theorem unrestricted_residue_square_mass_eq_action {P : Type*} [Fintype P] {t N : ℕ}
    (n : P → ℕ) (Δ D : ℤ) (source : Fin t → P)
    (old : Fin N → UnrestrictedResidueParticle n) (μ : P → ℝ)
    (ρ V v : ℝ) (B : ℕ)
    (F : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    (unrestrictedResidueEdgeSquareMass n Δ D source old μ ρ V v B F : ℂ) =
      unrestrictedResidueEdgeAction n Δ D source old μ ρ V B (fun _ _ _ _ => 1)
        (fun target memory => ((‖F target memory‖ ^ 2 / v ^ memory.1 : ℝ) : ℂ)) := by
  unfold unrestrictedResidueEdgeSquareMass unrestrictedEdgeGatedSquareMass
    unrestrictedResidueEdgeAction unrestrictedEdgeAction
  simp only [Complex.ofReal_sum]
  apply sum_congr rfl
  intro stores hs
  apply sum_congr rfl
  intro promotions hp
  apply sum_congr rfl
  intro e he
  apply sum_congr rfl
  intro fresh hf
  split_ifs <;> simp [Complex.ofReal_mul]
end

section
open Finset Classical
open scoped ComplexConjugate
noncomputable def unrestrictedCanonicalStitch {I P : Type*} [DecidableEq I]
    (S : Finset I) (s : Fin S.card → P) (d : UnrestrictedFreshLabels P S) : I → P :=
  unrestrictedTargetLabels S (fun i => s (S.equivFin i)) d

theorem unrestricted_canonical_stored_tuple {P Z : Type*} {t : ℕ}
    (S : Finset (Fin t)) (s : Fin S.card → P)
    (d : UnrestrictedFreshLabels P S) (seed : P → Z) :
    unrestrictedStoredTuple (unrestrictedCanonicalStitch S s d) seed S = seed ∘ s := by
  funext i
  unfold unrestrictedStoredTuple retainedOrderedTuple unrestrictedCanonicalStitch
  simp only [Function.comp_apply, unrestrictedTargetLabels_promoted, Equiv.apply_symm_apply]

theorem unrestricted_canonical_storage_allowed {P : Type*} {t : ℕ}
    (n : P → ℕ) (D : ℤ) (S : Finset (Fin t)) (s : Fin S.card → P)
    (d : UnrestrictedFreshLabels P S) :
    unrestrictedResidueStorageAllowed n D (unrestrictedCanonicalStitch S s d) S ↔
      ∀ i, ¬ (n (s i) : ℤ) ∣ D := by
  constructor
  · intro h i
    have hi := h (S.equivFin.symm i).val (S.equivFin.symm i).property
    simpa only [unrestrictedCanonicalStitch, unrestrictedTargetLabels_promoted,
      Equiv.apply_symm_apply] using hi
  · intro h i hi
    have hs := h (S.equivFin ⟨i, hi⟩)
    simpa only [unrestrictedCanonicalStitch, unrestrictedTargetLabels, dif_pos hi] using hs

/-- The entire active-label product integral splits into a stored ordered
tuple and its complementary source slots. No factorial is introduced. -/
theorem unrestricted_canonical_active_sum {P E : Type*} [Fintype P]
    [AddCommMonoid E] [Module ℝ E] {t : ℕ}
    (μ : P → ℝ) (S : Finset (Fin t)) (F : (Fin t → P) → E) :
    (∑ source : Fin t → P, (∏ i, μ (source i)) • F source) =
      ∑ s : Fin S.card → P, ∑ d : UnrestrictedFreshLabels P S,
        ((∏ i, μ (s i)) * unrestrictedFreshWeight μ S d) •
          F (unrestrictedCanonicalStitch S s d) := by
  rw [unrestricted_active_sum_split μ S F]
  have hstore := unrestricted_store_sum_equivFin μ S
    (fun s : S → P => ∑ d : UnrestrictedFreshLabels P S,
      unrestrictedFreshWeight μ S d • F (unrestrictedTargetLabels S s d))
  simp_rw [smul_sum, smul_smul] at hstore
  exact hstore

/-- Fixed source-storage labels and fixed old memory reduce the literal
promotion-slot sum to the ordered promotion slots of the transfer block. -/
theorem unrestricted_canonical_choice_sum {P : Type*} [Fintype P] {t N : ℕ}
    (n : P → ℕ) (μ : P → ℝ) (Δ D : ℤ) (S T : Finset (Fin t))
    (s : Fin S.card → P) (d : UnrestrictedFreshLabels P S)
    (q : Fin N → UnrestrictedResidueParticle n)
    (F : (Fin t → P) → (Fin t → P) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    (∑ e : T ↪ ↥(unrestrictedResidueEligible n Δ D q),
      ∑ f : UnrestrictedFreshLabels P T, (unrestrictedFreshWeight μ T f : ℂ) *
        if unrestrictedResidueStorageAllowed n D (unrestrictedCanonicalStitch S s d) S then
          F (unrestrictedCanonicalStitch S s d)
            (unrestrictedEdgeTarget q Sigma.fst T e f) ⟨N, q⟩
            (unrestrictedEdgeOutput (unrestrictedCanonicalStitch S s d) q
              (unrestrictedResidueSeed n) (unrestrictedResidueTransport n Δ) S T e)
        else 0) =
    ∑ e : Fin T.card ↪ ↥(unrestrictedResidueEligible n Δ D q),
      ∑ f : UnrestrictedFreshLabels P T, (unrestrictedFreshWeight μ T f : ℂ) *
        if ∀ i, ¬ (n (s i) : ℤ) ∣ D then
          F (unrestrictedCanonicalStitch S s d)
            (unrestrictedCanonicalStitch T (fun i => (q (e i).val).1) f) ⟨N, q⟩
            (unrestrictedEdgeMemory q (unrestrictedResidueTransport n Δ)
              (unrestrictedResidueSeed n ∘ s) e)
        else 0 := by
  simp only [unrestrictedEdgeTarget, unrestrictedEdgeOutput,
    unrestricted_canonical_stored_tuple, unrestricted_canonical_storage_allowed]
  exact unrestricted_promotion_slot_sum T (unrestrictedResidueEligible n Δ D q)
    q (unrestrictedResidueTransport n Δ) (unrestrictedResidueSeed n ∘ s)
    (fun p Y => ∑ f : UnrestrictedFreshLabels P T, (unrestrictedFreshWeight μ T f : ℂ) *
      if ∀ i, ¬ (n (s i) : ℤ) ∣ D then
        F (unrestrictedCanonicalStitch S s d)
          (unrestrictedTargetLabels T (fun i => (p i).1) f) ⟨N, q⟩ Y else 0)

/-- Pairing for one fixed pair of storage/promotion slot subsets. Input
active labels and old memory carry their full product/factorial measure. -/
noncomputable def unrestrictedFixedSlotPairing {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ D : ℤ)
    (t N : ℕ) (S T : Finset (Fin t))
    (F : (Fin t → P) → (Fin t → P) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) : ℂ :=
  (∑ source : Fin t → P, ((∏ i, μ (source i) : ℝ) : ℂ) *
    ∑ q : Fin N → UnrestrictedResidueParticle n,
      ((∏ j, unrestrictedResidueWeight μ (q j) : ℝ) : ℂ) *
      ∑ e : T ↪ ↥(unrestrictedResidueEligible n Δ D q),
      ∑ f : UnrestrictedFreshLabels P T, (unrestrictedFreshWeight μ T f : ℂ) *
        if unrestrictedResidueStorageAllowed n D source S then
          F source (unrestrictedEdgeTarget q Sigma.fst T e f) ⟨N, q⟩
            (unrestrictedEdgeOutput source q (unrestrictedResidueSeed n)
              (unrestrictedResidueTransport n Δ) S T e)
        else 0) / ((N.factorial : ℝ) : ℂ)

/-- Move the two complementary active-label sums outside the dependent
old-memory/promotion sum, while placing stored labels innermost. -/
theorem unrestricted_nested_sum_reorder {A B C E M : Type*} {D : C → Type*}
    [Fintype A] [Fintype B] [Fintype C] [∀ c, Fintype (D c)] [Fintype E]
    [AddCommMonoid M] (f : A → B → (c : C) → D c → E → M) :
    (∑ a, ∑ b, ∑ c, ∑ d : D c, ∑ e, f a b c d e) =
      ∑ b, ∑ e, ∑ c, ∑ d : D c, ∑ a, f a b c d e := by
  rw [sum_comm]
  apply sum_congr rfl
  intro b hb
  calc
    _ = ∑ c, ∑ a, ∑ d : D c, ∑ e, f a b c d e := sum_comm
    _ = ∑ c, ∑ d : D c, ∑ e, ∑ a, f a b c d e := by
      apply sum_congr rfl
      intro c hc
      rw [sum_comm]
      apply sum_congr rfl
      intro d hd
      rw [sum_comm]
    _ = ∑ c, ∑ e, ∑ d : D c, ∑ a, f a b c d e := by
      apply sum_congr rfl
      intro c hc
      rw [sum_comm]
    _ = _ := sum_comm

/-- The full fixed-slot pairing is exactly the ordered transfer block,
integrated over source slots that were discarded and target slots drawn fresh.
This equality requires no memory symmetry. -/
theorem unrestricted_fixed_slot_pairing_decompose {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ D : ℤ)
    (t N : ℕ) (S T : Finset (Fin t))
    (F : (Fin t → P) → (Fin t → P) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    unrestrictedFixedSlotPairing n μ Δ D t N S T F =
      ∑ d : UnrestrictedFreshLabels P S, ∑ f : UnrestrictedFreshLabels P T,
        ((unrestrictedFreshWeight μ S d * unrestrictedFreshWeight μ T f : ℝ) : ℂ) *
          unrestrictedOrderedTransferBlock n μ Δ D N T.card S.card
            (fun p s X Y => if ∀ i, ¬ (n (s i) : ℤ) ∣ D then
              F (unrestrictedCanonicalStitch S s d) (unrestrictedCanonicalStitch T p f) X Y
              else 0) := by
  unfold unrestrictedFixedSlotPairing
  have hs := unrestricted_canonical_active_sum μ S (fun source =>
    ∑ q : Fin N → UnrestrictedResidueParticle n,
      ((∏ j, unrestrictedResidueWeight μ (q j) : ℝ) : ℂ) *
      ∑ e : T ↪ ↥(unrestrictedResidueEligible n Δ D q),
      ∑ f : UnrestrictedFreshLabels P T, (unrestrictedFreshWeight μ T f : ℂ) *
        if unrestrictedResidueStorageAllowed n D source S then
          F source (unrestrictedEdgeTarget q Sigma.fst T e f) ⟨N, q⟩
            (unrestrictedEdgeOutput source q (unrestrictedResidueSeed n)
              (unrestrictedResidueTransport n Δ) S T e)
        else 0)
  simp only [Complex.real_smul] at hs
  rw [hs]
  simp_rw [unrestricted_canonical_choice_sum]
  unfold unrestrictedOrderedTransferBlock
  simp_rw [mul_sum, sum_div, mul_div_assoc]
  rw [unrestricted_nested_sum_reorder]
  apply sum_congr rfl
  intro d hd
  apply sum_congr rfl
  intro f hf
  simp_rw [mul_sum]
  apply sum_congr rfl
  intro q hq
  apply sum_congr rfl
  intro e he
  apply sum_congr rfl
  intro s hs
  push_cast
  ring

/-- Exact reversal of the full fixed-slot edge pairing, including the active
source measure and independent fresh target draws. Both memory arguments
must be symmetric; the two active tuples remain fully ordered. -/
theorem unrestricted_fixed_slot_pairing_reverse {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ D : ℤ)
    (t k : ℕ) (S T : Finset (Fin t))
    (F : (Fin t → P) → (Fin t → P) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (hX : ∀ source target Y, OrderedTupleSymmetric (fun X => F source target X Y))
    (hY : ∀ source target X, OrderedTupleSymmetric (fun Y => F source target X Y)) :
    unrestrictedFixedSlotPairing n μ Δ D t (k + T.card) S T F =
      unrestrictedFixedSlotPairing n μ (-Δ) D t (k + S.card) T S
        (fun target source Y X => F source target X Y) := by
  rw [unrestricted_fixed_slot_pairing_decompose, unrestricted_fixed_slot_pairing_decompose]
  conv_rhs => rw [sum_comm]
  apply sum_congr rfl
  intro d hd
  apply sum_congr rfl
  intro f hf
  rw [mul_comm (unrestrictedFreshWeight μ T f) (unrestrictedFreshWeight μ S d)]
  congr 1
  exact unrestricted_ordered_transfer_reverse n μ Δ D k T.card S.card
    (fun p s X Y => F (unrestrictedCanonicalStitch S s d) (unrestrictedCanonicalStitch T p f) X Y)
    (fun p s Y => hX _ _ Y) (fun p s X => hY _ _ X)

/-- The complete fixed-slot pairing preserves the original promotion
normalization. Its reverse factor differs by exactly `V^|S|/V^|T|`. -/
theorem unrestricted_fixed_slot_normalized_reverse {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ D : ℤ)
    (t k : ℕ) (S T : Finset (Fin t)) {V : ℝ} (hV : V ≠ 0)
    (F : (Fin t → P) → (Fin t → P) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (hX : ∀ source target Y, OrderedTupleSymmetric (fun X => F source target X Y))
    (hY : ∀ source target X, OrderedTupleSymmetric (fun Y => F source target X Y)) :
    ((1 / V ^ T.card : ℝ) : ℂ) *
      unrestrictedFixedSlotPairing n μ Δ D t (k + T.card) S T F =
    ((V ^ S.card / V ^ T.card : ℝ) : ℂ) * (((1 / V ^ S.card : ℝ) : ℂ) *
      unrestrictedFixedSlotPairing n μ (-Δ) D t (k + S.card) T S
        (fun target source Y X => F source target X Y)) := by
  rw [unrestricted_fixed_slot_pairing_reverse n μ Δ D t k S T F hX hY]
  have hratio : (1 / V ^ T.card : ℝ) =
      (V ^ S.card / V ^ T.card) * (1 / V ^ S.card) := by field_simp
  rw [hratio, Complex.ofReal_mul, mul_assoc]

/-- A block with more promoted slots than old indices contributes zero. -/
theorem unrestricted_fixed_slot_pairing_eq_zero_of_lt {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ D : ℤ)
    (t N : ℕ) (S T : Finset (Fin t)) (hN : N < T.card)
    (F : (Fin t → P) → (Fin t → P) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    unrestrictedFixedSlotPairing n μ Δ D t N S T F = 0 := by
  have hempty (q : Fin N → UnrestrictedResidueParticle n) :
      IsEmpty (T ↪ ↥(unrestrictedResidueEligible n Δ D q)) := by
    constructor
    intro e
    have hc : T.card ≤ N := by
      calc
        T.card = Fintype.card T := (Fintype.card_coe T).symm
        _ ≤ (unrestrictedResidueEligible n Δ D q).card := promotionSlots_card_le e
        _ ≤ (univ : Finset (Fin N)).card := card_le_card (subset_univ _)
        _ = N := by simp
    exact (Nat.not_le_of_gt hN) hc
  unfold unrestrictedFixedSlotPairing
  suffices hz : (∑ source : Fin t → P, ((∏ i, μ (source i) : ℝ) : ℂ) *
    ∑ q : Fin N → UnrestrictedResidueParticle n,
      ((∏ j, unrestrictedResidueWeight μ (q j) : ℝ) : ℂ) *
      ∑ e : T ↪ ↥(unrestrictedResidueEligible n Δ D q),
      ∑ f : UnrestrictedFreshLabels P T, (unrestrictedFreshWeight μ T f : ℂ) *
        if unrestrictedResidueStorageAllowed n D source S then
          F source (unrestrictedEdgeTarget q Sigma.fst T e f) ⟨N, q⟩
            (unrestrictedEdgeOutput source q (unrestrictedResidueSeed n)
              (unrestrictedResidueTransport n Δ) S T e)
        else 0) = 0 by rw [hz, zero_div]
  apply sum_eq_zero
  intro source hs
  apply mul_eq_zero_of_right
  apply sum_eq_zero
  intro q hq
  let _ := hempty q
  simp

/-- All product and factorial weights are real, so conjugation acts only on
an arbitrary complex endpoint integrand. -/
theorem unrestricted_fixed_slot_pairing_conj {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ D : ℤ)
    (t N : ℕ) (S T : Finset (Fin t))
    (F : (Fin t → P) → (Fin t → P) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    conj (unrestrictedFixedSlotPairing n μ Δ D t N S T F) =
      unrestrictedFixedSlotPairing n μ Δ D t N S T
        (fun source target X Y => conj (F source target X Y)) := by
  unfold unrestrictedFixedSlotPairing
  simp only [map_div₀, map_sum, map_mul, Complex.conj_ofReal, apply_ite, map_zero]
end

section
open Finset
theorem bounded_ordered_state_smul_sum_range_first {P Z E : Type*}
    [Fintype P] [Fintype Z] [AddCommMonoid E] [Module ℝ E]
    (μ : P → ℝ) (ν : Z → ℝ) (t B : ℕ)
    (F : (Fin t → P) → FiniteOrderedTuple Z → E) :
    (∑ s : BoundedOrderedState P Z t B,
      boundedOrderedStateWeight μ ν s • F s.1 (boundedOrderedTupleToFinite s.2)) =
    ∑ N ∈ range (B + 1), (1 / (N.factorial : ℝ)) •
      ∑ active : Fin t → P, ∑ q : Fin N → Z,
        ((∏ i, μ (active i)) * ∏ j, ν (q j)) • F active ⟨N, q⟩ := by
  rw [bounded_ordered_state_smul_sum_range, sum_comm]
  apply sum_congr rfl
  intro N hN
  rw [smul_sum]

theorem bounded_ordered_state_complex_sum_range_first {P Z : Type*}
    [Fintype P] [Fintype Z] (μ : P → ℝ) (ν : Z → ℝ) (t B : ℕ)
    (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ) :
    (∑ s : BoundedOrderedState P Z t B,
      (boundedOrderedStateWeight μ ν s : ℂ) * F s.1 (boundedOrderedTupleToFinite s.2)) =
    ∑ N ∈ range (B + 1), ((1 / (N.factorial : ℝ) : ℝ) : ℂ) *
      ∑ active : Fin t → P, ∑ q : Fin N → Z,
        ((((∏ i, μ (active i)) * ∏ j, ν (q j)) : ℝ) : ℂ) * F active ⟨N, q⟩ := by
  simpa only [Complex.real_smul] using bounded_ordered_state_smul_sum_range_first μ ν t B F
end

section

def BoundedOrderedSymmetric {P Z K : Type*} {t B : ℕ}
    (f : BoundedOrderedState P Z t B → K) : Prop :=
  ∀ (active : Fin t → P) (N : Fin (B + 1)) (q : Fin N.val → Z)
    (τ : Equiv.Perm (Fin N.val)),
    f (active, ⟨N, q ∘ τ⟩) = f (active, ⟨N, q⟩)

def boundedOrderedZeroExtension {P Z K : Type*} [Zero K] {t B : ℕ}
    (f : BoundedOrderedState P Z t B → K) (active : Fin t → P)
    (q : FiniteOrderedTuple Z) : K :=
  if h : q.1 ≤ B then f (active, ⟨⟨q.1, Nat.lt_succ_of_le h⟩, q.2⟩) else 0

theorem boundedOrderedZeroExtension_of_le {P Z K : Type*} [Zero K] {t B : ℕ}
    (f : BoundedOrderedState P Z t B → K) (active : Fin t → P)
    (q : FiniteOrderedTuple Z) (h : q.1 ≤ B) :
    boundedOrderedZeroExtension f active q =
      f (active, ⟨⟨q.1, Nat.lt_succ_of_le h⟩, q.2⟩) := by
  simp only [boundedOrderedZeroExtension, dif_pos h]

theorem boundedOrderedZeroExtension_apply {P Z K : Type*} [Zero K] {t B : ℕ}
    (f : BoundedOrderedState P Z t B → K) (s : BoundedOrderedState P Z t B) :
    boundedOrderedZeroExtension f s.1 (boundedOrderedTupleToFinite s.2) = f s := by
  rcases s with ⟨active, N, q⟩
  exact boundedOrderedZeroExtension_of_le f active ⟨N.val, q⟩ (Nat.le_of_lt_succ N.isLt)

theorem boundedOrderedZeroExtension_of_gt {P Z K : Type*} [Zero K] {t B : ℕ}
    (f : BoundedOrderedState P Z t B → K) (active : Fin t → P)
    (q : FiniteOrderedTuple Z) (h : B < q.1) :
    boundedOrderedZeroExtension f active q = 0 := by
  simp only [boundedOrderedZeroExtension, dif_neg (Nat.not_le_of_lt h)]

theorem boundedOrderedZeroExtension_symmetric_iff {P Z K : Type*} [Zero K] {t B : ℕ}
    (f : BoundedOrderedState P Z t B → K) :
    (∀ active, OrderedTupleSymmetric (boundedOrderedZeroExtension f active)) ↔
      BoundedOrderedSymmetric f := by
  constructor
  · intro hf active N q τ
    have h := hf active N.val q τ
    change boundedOrderedZeroExtension f active
        (boundedOrderedTupleToFinite (⟨N, q ∘ τ⟩ : BoundedOrderedTuple Z B)) =
      boundedOrderedZeroExtension f active
        (boundedOrderedTupleToFinite (⟨N, q⟩ : BoundedOrderedTuple Z B)) at h
    exact (boundedOrderedZeroExtension_apply f (active, ⟨N, q ∘ τ⟩)).symm.trans
      (h.trans (boundedOrderedZeroExtension_apply f (active, ⟨N, q⟩)))
  · intro hf active N q τ
    by_cases hN : N ≤ B
    · simp only [boundedOrderedZeroExtension, dif_pos hN]
      exact hf active ⟨N, Nat.lt_succ_of_le hN⟩ q τ
    · simp only [boundedOrderedZeroExtension, dif_neg hN]
end

section
open Finset
theorem dyadic_slot_sum_midpoint_error {N J r : ℕ} (hJN : J ≤ N)
    {scale eps : ℝ} (hscale : 0 ≤ scale) (heps : 0 ≤ eps)
    (f : ℕ → Fin r → ℝ)
    (hprefix : ∀ j ∈ Icc 0 J, ∀ k,
      |f j k - (11/10 : ℝ) * scale / 2^j| ≤ eps * scale / 2^j)
    (htail : ∀ j ∈ Ioc J N, ∀ k,
      0 ≤ f j k ∧ f j k ≤ (6/5 : ℝ) * scale / 2^j) :
    |(∑ j ∈ Icc 0 N, ∑ k, f j k) - (11/5 : ℝ) * (r : ℝ) * scale| ≤
      2 * eps * (r : ℝ) * scale + (6/5 : ℝ) * (r : ℝ) * scale / 2^J := by
  have hp : ∀ j ∈ Icc 0 J,
      |(∑ k, f j k) - (11/10 : ℝ) * ((r : ℝ) * scale) / 2^j| ≤
        eps * ((r : ℝ) * scale) / 2^j := by
    intro j hj
    have hid : (∑ k, f j k) - (11/10 : ℝ) * ((r : ℝ) * scale) / 2^j =
        ∑ k, (f j k - (11/10 : ℝ) * scale / 2^j) := by
      rw [sum_sub_distrib]
      simp only [sum_const, card_univ, Fintype.card_fin, nsmul_eq_mul]
      ring
    rw [hid]
    refine (abs_sum_le_sum_abs _ _).trans ((sum_le_sum (fun k _ => hprefix j hj k)).trans_eq ?_)
    simp only [sum_const, card_univ, Fintype.card_fin, nsmul_eq_mul]
    ring
  have ht : ∀ j ∈ Ioc J N,
      0 ≤ (∑ k, f j k) ∧ (∑ k, f j k) ≤ (6/5 : ℝ) * ((r : ℝ) * scale) / 2^j := by
    intro j hj
    refine ⟨sum_nonneg (fun k _ => (htail j hj k).1), ?_⟩
    calc
      _ ≤ ∑ _k : Fin r, (6/5 : ℝ) * scale / 2^j := sum_le_sum (fun k _ => (htail j hj k).2)
      _ = _ := by
        simp only [sum_const, card_univ, Fintype.card_fin, nsmul_eq_mul]
        ring
  have h := dyadic_sum_midpoint_error hJN (mul_nonneg (Nat.cast_nonneg r) hscale) heps
    (fun j => ∑ k, f j k) hp ht
  simpa only [mul_assoc] using h

theorem candidate_midpoint_error_small {N J r : ℕ} (hJN : J ≤ N)
    {c L eps : ℝ} (hcL : 0 ≤ c * L) (heps : 0 ≤ eps)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1)
    (hepsr : eps * (r : ℝ) ≤ 1/400) (hJ : 1000 * (r : ℝ) ≤ 2^J)
    (f : ℕ → Fin r → ℝ)
    (hprefix : ∀ j ∈ Icc 0 J, ∀ k,
      |f j k - (11/10 : ℝ) * (c * L) / 2^j| ≤ eps * (c * L) / 2^j)
    (htail : ∀ j ∈ Ioc J N, ∀ k,
      0 ≤ f j k ∧ f j k ≤ (6/5 : ℝ) * (c * L) / 2^j) :
    |(∑ j ∈ Icc 0 N, ∑ k, f j k) - L| ≤ c * L / 100 := by
  have h := dyadic_slot_sum_midpoint_error hJN hcL heps f hprefix htail
  have hcenteq : (11/5 : ℝ) * (r : ℝ) * (c * L) = L := by nlinarith [congrArg (fun x : ℝ => x * L) hcenter]
  rw [hcenteq] at h
  have hp : 2 * eps * (r : ℝ) * (c * L) ≤ (1/200 : ℝ) * (c * L) := by
    have h := mul_le_mul_of_nonneg_right hepsr hcL
    nlinarith
  have ht : (6/5 : ℝ) * (r : ℝ) * (c * L) / 2^J ≤ (3/2500 : ℝ) * (c * L) := by
    apply (div_le_iff₀ (by positivity : (0 : ℝ) < 2^J)).mpr
    have hmul := mul_le_mul_of_nonneg_right hJ hcL
    nlinarith
  exact h.trans (by nlinarith)

/-- Adding a small P-part still leaves a fixed margin for the free prime. -/
theorem candidate_free_log_window_of_midpoint {c L total rest pLog : ℝ}
    (hmid : |total - L| ≤ c * L / 100)
    (hrest : rest = total - (11/10 : ℝ) * (c * L) + pLog)
    (hp0 : 0 ≤ pLog) (hp1 : pLog ≤ c * L / 100)
    (hlarge : Real.log 16 ≤ c * L / 20) :
    c * L ≤ L - rest ∧ L - rest + Real.log 16 ≤ (6/5 : ℝ) * c * L := by
  have hm := abs_le.mp hmid
  have hlog : 0 < Real.log 16 := Real.log_pos (by norm_num)
  constructor <;> nlinarith
end

section

theorem physical_birth_product_pos {I G : Type*} [Fintype I]
    {P : G → Finset ℕ} (V : G → ℝ) (γ : I → G) (labels : ∀ i, P (γ i))
    (hV : ∀ i, 0 < V (γ i)) (hp : ∀ i, 0 < (labels i).val) :
    0 < ∏ i, physicalLabelLaw V (γ i) (labels i) := by
  apply Finset.prod_pos
  intro i _
  unfold physicalLabelLaw
  exact div_pos zero_lt_one (mul_pos (hV i) (by exact_mod_cast hp i))

/-- The relative product density is exactly the product of inverse baselines. -/
theorem physical_tilted_birth_product_ratio {I G : Type*} [Fintype I]
    {P : G → Finset ℕ} (V : G → ℝ) (γ : I → G) (labels : ∀ i, P (γ i))
    (b : ∀ g, P g → ℝ) (hV : ∀ i, 0 < V (γ i))
    (hp : ∀ i, 0 < (labels i).val) :
    (∏ i, tiltedPhysicalBirthLaw V (γ i) (b (γ i)) (labels i)) /
        (∏ i, physicalLabelLaw V (γ i) (labels i)) =
      ∏ i, 1 / b (γ i) (labels i) := by
  rw [physical_tilted_birth_product_eq]
  have hne := ne_of_gt (physical_birth_product_pos V γ labels hV hp)
  field_simp

/-- Quantitative pointwise excess of the actual tilted product law. -/
theorem physical_lifespan_tilt_product_excess {I G : Type*} [Fintype I]
    {P : G → Finset ℕ} (V : G → ℝ) (γ : I → G) (labels : ∀ i, P (γ i))
    (b : ∀ g, P g → ℝ) (hV : ∀ i, 0 ≤ V (γ i))
    {T P₀ : ℝ} (hT : 0 ≤ T) (hP₀ : 0 < P₀)
    (hp : ∀ i, P₀ ≤ ((labels i).val : ℝ))
    (hb : ∀ i, b (γ i) (labels i) = 1 - T / ((labels i).val : ℝ))
    (hsmall : (Fintype.card I : ℝ) * T / P₀ ≤ 1 / 2) :
    0 ≤ (∏ i, tiltedPhysicalBirthLaw V (γ i) (b (γ i)) (labels i)) -
      (∏ i, physicalLabelLaw V (γ i) (labels i)) ∧
    (∏ i, tiltedPhysicalBirthLaw V (γ i) (b (γ i)) (labels i)) -
      (∏ i, physicalLabelLaw V (γ i) (labels i)) ≤
      (2 * ((Fintype.card I : ℝ) * T / P₀)) * ∏ i, physicalLabelLaw V (γ i) (labels i) := by
  obtain ⟨⟨hlo, hhi⟩, _⟩ := physical_lifespan_tilt_density_bounds γ labels b hT hP₀ hp hb hsmall
  have hw : 0 ≤ ∏ i, physicalLabelLaw V (γ i) (labels i) := by
    apply Finset.prod_nonneg
    intro i _
    exact div_nonneg zero_le_one (mul_nonneg (hV i) (Nat.cast_nonneg _))
  rw [physical_tilted_birth_product_eq]
  constructor
  · nlinarith [mul_le_mul_of_nonneg_left hlo hw]
  · nlinarith [mul_le_mul_of_nonneg_left hhi hw]

/-- The concrete square-root density identification is close to the identity. -/
theorem physical_lifespan_sqrt_density_smul_sub {I G E : Type*} [Fintype I]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    {P : G → Finset ℕ} (γ : I → G) (labels : ∀ i, P (γ i))
    (b : ∀ g, P g → ℝ) {T P₀ : ℝ} (hT : 0 ≤ T) (hP₀ : 0 < P₀)
    (hp : ∀ i, P₀ ≤ ((labels i).val : ℝ))
    (hb : ∀ i, b (γ i) (labels i) = 1 - T / ((labels i).val : ℝ))
    (hsmall : (Fintype.card I : ℝ) * T / P₀ ≤ 1 / 2) (v : E) :
    ‖Real.sqrt (∏ i, 1 / b (γ i) (labels i)) • v - v‖ ≤
      ((Fintype.card I : ℝ) * T / P₀) * ‖v‖ := by
  obtain ⟨⟨hlo, hhi⟩, _⟩ := physical_lifespan_tilt_density_bounds γ labels b hT hP₀ hp hb hsmall
  exact sqrt_density_smul_sub_norm_le (by positivity) hlo hhi v
end

section
open Finset
open scoped Classical
/-- The empty-choice mask extracts precisely the clean event sum from the
actual unrestricted action, including its original output-memory cutoff. -/
theorem unrestricted_edge_action_clean_extract {P Z : Type*} [Fintype P]
    {t N : ℕ} (source : Fin t → P) (old : Fin N → Z) (label : Z → P)
    (seed : P → Z) (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ)
    (ρ V : ℝ) (eligible : Finset (Fin N)) (B : ℕ)
    (θ : (Fin t → P) → ℂ) (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ) :
    unrestrictedEdgeAction source old label seed transport hit μ ρ V eligible B
      (fun stores promotions e fresh =>
        if stores = ∅ ∧ promotions = ∅ then
          θ (unrestrictedEdgeTarget old label promotions e fresh) else 0) F =
      ∑ fresh : UnrestrictedFreshLabels P (∅ : Finset (Fin t)),
        (unrestrictedEdgeEventMass source old seed transport hit μ ρ V ∅ ∅
          (unrestrictedCleanPromotion t eligible) fresh : ℂ) *
        θ (unrestrictedEdgeTarget old label ∅ (unrestrictedCleanPromotion t eligible) fresh) *
        (if (unrestrictedEdgeOutput source old seed transport ∅ ∅
            (unrestrictedCleanPromotion t eligible)).1 ≤ B then
          F (unrestrictedEdgeTarget old label ∅ (unrestrictedCleanPromotion t eligible) fresh)
            (unrestrictedEdgeOutput source old seed transport ∅ ∅
              (unrestrictedCleanPromotion t eligible)) else 0) := by
  unfold unrestrictedEdgeAction
  rw [sum_eq_single ∅]
  · rw [sum_eq_single ∅]
    · rw [sum_eq_single (unrestrictedCleanPromotion t eligible)]
      · simp only [true_and, if_true]
      · intro e _ he
        exact (he (unrestricted_clean_promotion_unique eligible e)).elim
      · intro h
        exact (h (mem_univ _)).elim
    · intro promotions _ hp
      simp only [hp, and_false, if_false, mul_zero, zero_mul, sum_const_zero]
    · intro h
      exact (h (mem_univ _)).elim
  · intro stores _ hs
    simp only [hs, false_and, if_false, mul_zero, zero_mul, sum_const_zero]
  · intro h
    exact (h (mem_univ _)).elim

/-- The clean action is zero above the actual old-memory cutoff, independently
of symmetry or any size bound on the continuation. -/
theorem unrestricted_edge_action_clean_of_cutoff {P Z : Type*} [Fintype P]
    {t N : ℕ} (source : Fin t → P) (old : Fin N → Z) (label : Z → P)
    (seed : P → Z) (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ)
    (ρ V : ℝ) (eligible : Finset (Fin N)) (B : ℕ) (hB : ¬ N ≤ B)
    (θ : (Fin t → P) → ℂ) (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ) :
    unrestrictedEdgeAction source old label seed transport hit μ ρ V eligible B
      (fun stores promotions e fresh =>
        if stores = ∅ ∧ promotions = ∅ then
          θ (unrestrictedEdgeTarget old label promotions e fresh) else 0) F = 0 := by
  rw [unrestricted_edge_action_clean_extract]
  simp only [unrestricted_clean_output_length, if_neg hB, mul_zero, sum_const_zero]

/-- The complete clean part of the actual action on arbitrary repeated ordered
memory. Symmetry is used only to identify the retained-tuple enumeration with
the transported old order. Fresh target labels remain fully unrestricted. -/
theorem unrestricted_edge_action_clean {P Z : Type*} [Fintype P]
    {t N : ℕ} (source : Fin t → P) (old : Fin N → Z) (label : Z → P)
    (seed : P → Z) (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ)
    (ρ V : ℝ) (eligible : Finset (Fin N)) (B : ℕ)
    (θ : (Fin t → P) → ℂ) (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ)
    (hF : ∀ target, OrderedTupleSymmetric (F target)) :
    unrestrictedEdgeAction source old label seed transport hit μ ρ V eligible B
      (fun stores promotions e fresh =>
        if stores = ∅ ∧ promotions = ∅ then
          θ (unrestrictedEdgeTarget old label promotions e fresh) else 0) F =
      if N ≤ B then
        ((ρ ^ orderedPredicateCount ⟨N, old⟩ hit *
          ρ ^ orderedPredicateCount ⟨N, transport ∘ old⟩ hit : ℝ) : ℂ) *
          ∑ target : Fin t → P, ((∏ j, μ (target j) : ℝ) : ℂ) *
            θ target * F target ⟨N, transport ∘ old⟩
      else 0 := by
  by_cases hB : N ≤ B
  · rw [if_pos hB, unrestricted_edge_action_clean_extract]
    simp only [unrestricted_clean_output_length, if_pos hB]
    have hsym : ∀ target, OrderedTupleSymmetric (fun q => θ target * F target q) := by
      intro target n p e
      exact congrArg (fun z : ℂ => θ target * z) (hF target n p e)
    simpa only [mul_assoc] using unrestricted_clean_symmetric_continuation
      source old label seed transport hit μ ρ V eligible
      (fun target q => θ target * F target q) hsym
  · rw [if_neg hB]
    exact unrestricted_edge_action_clean_of_cutoff source old label seed transport hit μ ρ V
      eligible B hB θ F
end

section
open Finset
open scoped Classical
noncomputable def repeatedBigActiveMass {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (source : RepeatedBigLists P J ell) : ℝ :=
  ∏ g, ∏ s, tiltedPhysicalBirthLaw V g (b g) (source g s)

noncomputable def repeatedBigFreshMass {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (fresh : RepeatedBigFresh P C ell) : ℝ :=
  ∏ g, ∏ s, tiltedPhysicalBirthLaw V g (b g) (fresh g s)

noncomputable def repeatedBigTargetMass {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (target : RepeatedBigLists P J ell) : ℝ :=
  ∏ g, ∏ s : {s : PhysicalSlots J ell // repeatedBigUnshared C g s},
    tiltedPhysicalBirthLaw V g (b g) (target g s.val)

theorem repeated_big_fill_mass {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (source : RepeatedBigLists P J ell)
    (fresh : RepeatedBigFresh P C ell) :
    repeatedBigTargetMass V b C (repeatedBigFill C source fresh) =
      repeatedBigFreshMass V b C fresh := by
  unfold repeatedBigTargetMass repeatedBigFreshMass
  simp_rw [repeated_big_fill_unshared]

theorem repeated_big_weighted_target_sum {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (source : RepeatedBigLists P J ell)
    (F : RepeatedBigLists P J ell → ℂ) :
    (∑ fresh : RepeatedBigFresh P C ell,
      (repeatedBigFreshMass V b C fresh : ℂ) * F (repeatedBigFill C source fresh)) =
      ∑ target : RepeatedBigLists P J ell, if repeatedBigSharedCompatible C source target
        then (repeatedBigTargetMass V b C target : ℂ) * F target else 0 := by
  have h := repeated_big_target_sum C source
    (fun target => (repeatedBigTargetMass V b C target : ℂ) * F target)
  simpa only [repeated_big_fill_mass] using h

def repeatedBigAuxAvoids {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (labels : RepeatedBigLists P J ell) : Prop :=
  ∀ g (j : C g) s, aux g j ≠ labels g s

noncomputable def repeatedBigD {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (source : RepeatedBigLists P J ell) (aux : PhysicalAuxLabels P C) : ℕ :=
  ∏ g, ((∏ j ∈ univ \ C g, (source g (Sum.inl j)).val) *
    ∏ j : C g, (aux g j).val)

theorem repeated_big_D_eq_of_shared {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    {source target : RepeatedBigLists P J ell}
    (h : repeatedBigSharedCompatible C source target) (aux : PhysicalAuxLabels P C) :
    repeatedBigD C source aux = repeatedBigD C target aux := by
  unfold repeatedBigD
  apply prod_congr rfl
  intro g _
  congr 1
  apply prod_congr rfl
  intro j hj
  rw [h g j (mem_sdiff.mp hj).2]

theorem repeated_big_D_pos {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (source : RepeatedBigLists P J ell) (aux : PhysicalAuxLabels P C)
    (hP : ∀ g p, p ∈ P g → 0 < p) : 0 < repeatedBigD C source aux := by
  apply prod_pos
  intro g _
  apply mul_pos
  · exact prod_pos (fun j _ => hP g _ (source g (Sum.inl j)).property)
  · exact prod_pos (fun j _ => hP g _ (aux g j).property)

/-- The free-label law is untilted; only fresh active target labels are tilted.
There is no additional completion normalization after those tilted factors. -/
noncomputable def repeatedBigKernel {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (source target : RepeatedBigLists P J ell) : ℂ := by
  classical
  exact if repeatedBigSharedCompatible C source target ∧
      repeatedBigAuxAvoids C aux source ∧ repeatedBigAuxAvoids C aux target then
    ((physicalAuxMass V C aux * repeatedBigTargetMass V b C target : ℝ) : ℂ) *
      K source target aux * physicalPhase ζ (repeatedBigD C source aux) else 0

/-- Explicit fresh integration and the full repeated target-list kernel agree. -/
theorem repeated_big_kernel_row {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (source : RepeatedBigLists P J ell)
    (F : RepeatedBigLists P J ell → ℂ) :
    (∑ fresh : RepeatedBigFresh P C ell,
      if repeatedBigAuxAvoids C aux source ∧
          repeatedBigAuxAvoids C aux (repeatedBigFill C source fresh) then
        ((physicalAuxMass V C aux * repeatedBigFreshMass V b C fresh : ℝ) : ℂ) *
          K source (repeatedBigFill C source fresh) aux *
          physicalPhase ζ (repeatedBigD C source aux) * F (repeatedBigFill C source fresh)
      else 0) =
      ∑ target : RepeatedBigLists P J ell, repeatedBigKernel V b C ζ K aux source target * F target := by
  have h := repeated_big_weighted_target_sum V b C source
    (fun target => if repeatedBigAuxAvoids C aux source ∧ repeatedBigAuxAvoids C aux target
      then (physicalAuxMass V C aux : ℂ) * K source target aux *
        physicalPhase ζ (repeatedBigD C source aux) * F target else 0)
  calc
    _ = _ := ?_
    _ = _ := h
    _ = _ := ?_
  · apply sum_congr rfl
    intro fresh _
    split_ifs <;> push_cast <;> ring
  · apply sum_congr rfl
    intro target _
    unfold repeatedBigKernel
    by_cases hs : repeatedBigSharedCompatible C source target
    · by_cases hb : repeatedBigAuxAvoids C aux source ∧ repeatedBigAuxAvoids C aux target
      · simp only [and_true, hs, hb, if_true]
        push_cast
        ring
      · simp [hs, hb]
    · simp [hs]
end

section
open Finset Classical
abbrev UnrestrictedBoundedPhase {P : Type*} (n : P → ℕ) (Δ D : ℤ) (t B : ℕ) :=
  ∀ s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B,
    ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥(unrestrictedResidueEligible n Δ D s.2.2)) →
        UnrestrictedFreshLabels P promotions → ℂ

noncomputable def unrestrictedBoundedAction {P : Type*} [Fintype P]
    (n : P → ℕ) (Δ D : ℤ) (μ : P → ℝ) (ρ V : ℝ) (t B : ℕ)
    (phase : UnrestrictedBoundedPhase n Δ D t B)
    (F : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B) : ℂ :=
  unrestrictedResidueEdgeAction n Δ D s.1 s.2.2 μ ρ V B (phase s) F

noncomputable def unrestrictedBoundedPositive {P : Type*} [Fintype P]
    (n : P → ℕ) (Δ D : ℤ) (μ : P → ℝ) (ρ V : ℝ) (t B : ℕ)
    (F : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ :=
  unrestrictedBoundedAction n Δ D μ ρ V t B (fun _ _ _ _ _ => 1) F

/-- The reversed displacement is `-Δ`; its ratio retains the original
promotion normalization after exchanging stores and promotions. -/
noncomputable def unrestrictedBoundedReverse {P : Type*} [Fintype P]
    (n : P → ℕ) (Δ D : ℤ) (μ : P → ℝ) (ρ V : ℝ) (t B : ℕ)
    (F : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ :=
  unrestrictedBoundedAction n (-Δ) D μ ρ V t B
    (fun _ stores promotions _ _ => ((V ^ promotions.card / V ^ stores.card : ℝ) : ℂ)) F

/-- Concrete full positive/reverse duality on symmetric memory tests. The
bounded source type and the row cutoff restrict both endpoint memory sizes. -/
def UnrestrictedBoundedDuality {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (Δ D : ℤ) (μ : P → ℝ) (ρ V : ℝ) (t B : ℕ) : Prop :=
  ∀ f g : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ,
    (∀ active, OrderedTupleSymmetric (f active)) →
    (∀ active, OrderedTupleSymmetric (g active)) →
    (∑ s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B,
      (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s : ℂ) *
        f s.1 (boundedOrderedTupleToFinite s.2) *
          unrestrictedBoundedPositive n Δ D μ ρ V t B g s) =
    ∑ s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B,
      (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s : ℂ) *
        unrestrictedBoundedReverse n Δ D μ ρ V t B f s *
          g s.1 (boundedOrderedTupleToFinite s.2)

noncomputable def unrestrictedMemoryWeightTest {P Z : Type*} {t : ℕ}
    (v : ℝ) (_active : Fin t → P) (q : FiniteOrderedTuple Z) : ℂ := (v ^ q.1 : ℝ)

noncomputable def unrestrictedDividedSquareTest {P Z : Type*} {t : ℕ}
    (v : ℝ) (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ)
    (active : Fin t → P) (q : FiniteOrderedTuple Z) : ℂ :=
  ((‖F active q‖ ^ 2 / v ^ q.1 : ℝ) : ℂ)

theorem unrestrictedMemoryWeightTest_symmetric {P Z : Type*} {t : ℕ}
    (v : ℝ) (active : Fin t → P) :
    OrderedTupleSymmetric (unrestrictedMemoryWeightTest (Z := Z) v active) := by
  intro N q e
  rfl

theorem unrestrictedDividedSquareTest_symmetric {P Z : Type*} {t : ℕ}
    (v : ℝ) (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ)
    (hF : ∀ active, OrderedTupleSymmetric (F active)) (active : Fin t → P) :
    OrderedTupleSymmetric (unrestrictedDividedSquareTest v F active) := by
  intro N q e
  unfold unrestrictedDividedSquareTest
  rw [hF active N q e]

theorem unrestricted_bounded_action_cauchy {P : Type*} [Fintype P]
    (n : P → ℕ) (Δ D : ℤ) (μ : P → ℝ)
    {ρ V v vmin : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hV : vmin ≤ V) (hμ : ∀ p, 0 ≤ μ p)
    (hmass : ∑ p, μ p ≤ 2) (t B T : ℕ) (ht : t ≤ T)
    (phase : UnrestrictedBoundedPhase n Δ D t B)
    (hphase : ∀ s stores promotions e fresh, ‖phase s stores promotions e fresh‖ ≤ 1)
    (F : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B) :
    ‖unrestrictedBoundedAction n Δ D μ ρ V t B phase F s‖ ^ 2 ≤
      unrestrictedEdgeRowBound ρ v vmin T * v ^ s.2.1.val *
        (unrestrictedBoundedPositive n Δ D μ ρ V t B
          (unrestrictedDividedSquareTest v F) s).re := by
  have hc := unrestricted_residue_edge_sq_le_row_bound n Δ D s.1 s.2.2 μ
    hρ0 hρ1 hv hvmin hV hμ hmass B T ht (phase s) (hphase s) F
  have heq := congrArg Complex.re
    (unrestricted_residue_square_mass_eq_action n Δ D s.1 s.2.2 μ ρ V v B F)
  have hsquare : unrestrictedResidueEdgeSquareMass n Δ D s.1 s.2.2 μ ρ V v B F =
      (unrestrictedBoundedPositive n Δ D μ ρ V t B
        (unrestrictedDividedSquareTest v F) s).re := by
    change unrestrictedResidueEdgeSquareMass n Δ D s.1 s.2.2 μ ρ V v B F =
      (unrestrictedResidueEdgeAction n Δ D s.1 s.2.2 μ ρ V B (fun _ _ _ _ => 1)
        (fun target memory => ((‖F target memory‖ ^ 2 / v ^ memory.1 : ℝ) : ℂ))).re
    simpa only [Complex.ofReal_re] using heq
  calc
    _ ≤ (v ^ s.2.1.val * unrestrictedEdgeRowBound ρ v vmin T) *
        unrestrictedResidueEdgeSquareMass n Δ D s.1 s.2.2 μ ρ V v B F := hc
    _ = _ := by rw [hsquare]; ring

theorem unrestricted_bounded_reverse_weight_le {P : Type*} [Fintype P]
    (n : P → ℕ) (Δ D : ℤ) (μ : P → ℝ)
    {ρ V v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : vmin ≤ V) (hVhi : V ≤ vmax)
    (hμ : ∀ p, 0 ≤ μ p) (hmass : ∑ p, μ p ≤ 2)
    (t B T : ℕ) (ht : t ≤ T)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B) :
    (unrestrictedBoundedReverse n Δ D μ ρ V t B (unrestrictedMemoryWeightTest v) s).re ≤
      (unrestrictedEdgeRowBound ρ v vmin T * unrestrictedEdgeReversalBound vmin vmax T) *
        v ^ s.2.1.val := by
  have hv0 : 0 ≤ v := (zero_lt_one.trans hv).le
  have hb := unrestricted_reverse_residue_edge_action_norm_le n (-Δ) D s.1 s.2.2 μ
    hρ0 hρ1 hv hvmin hVlo hVhi (C := 1) (by norm_num) hμ hmass B T ht
    (fun _ _ _ _ => 1) (by intros; norm_num) (unrestrictedMemoryWeightTest v)
    (by
      intro active memory _
      simp only [unrestrictedMemoryWeightTest, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (pow_nonneg hv0 _), one_mul, le_refl])
  have hb' : ‖unrestrictedBoundedReverse n Δ D μ ρ V t B
      (unrestrictedMemoryWeightTest v) s‖ ≤
      (unrestrictedEdgeRowBound ρ v vmin T * unrestrictedEdgeReversalBound vmin vmax T) *
        v ^ s.2.1.val := by
    simpa only [unrestrictedBoundedReverse, unrestrictedBoundedAction, mul_one, one_mul,
      mul_assoc, mul_comm, mul_left_comm] using hb
  exact (Complex.re_le_norm _).trans hb'

/-- The literal phase-bounded edge satisfies the finite energy estimate once
its concrete positive/reverse pairing identity has been established. No
symmetry of the phase or of the resulting output function is required. -/
theorem unrestricted_bounded_energy_le_of_duality {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (Δ D : ℤ) (μ : P → ℝ)
    {ρ V v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : vmin ≤ V) (hVhi : V ≤ vmax)
    (hμ : ∀ p, 0 ≤ μ p) (hmass : ∑ p, μ p ≤ 2)
    (t B T : ℕ) (ht : t ≤ T)
    (hduality : UnrestrictedBoundedDuality n Δ D μ ρ V t B)
    (phase : UnrestrictedBoundedPhase n Δ D t B)
    (hphase : ∀ s stores promotions e fresh, ‖phase s stores promotions e fresh‖ ≤ 1)
    (F : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (hF : ∀ active, OrderedTupleSymmetric (F active)) :
    (∑ s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B,
      boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s *
        ‖unrestrictedBoundedAction n Δ D μ ρ V t B phase F s‖ ^ 2) ≤
    (unrestrictedEdgeRowBound ρ v vmin T) ^ 2 * unrestrictedEdgeReversalBound vmin vmax T *
      ∑ s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B,
        boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s *
          ‖F s.1 (boundedOrderedTupleToFinite s.2)‖ ^ 2 := by
  let S := BoundedOrderedState P (UnrestrictedResidueParticle n) t B
  let m : S → ℝ := boundedOrderedStateWeight μ (unrestrictedResidueWeight μ)
  let w : S → ℝ := fun s => v ^ s.2.1.val
  let A : S → ℂ := unrestrictedBoundedPositive n Δ D μ ρ V t B
    (unrestrictedDividedSquareTest v F)
  let E : S → ℂ := unrestrictedBoundedReverse n Δ D μ ρ V t B
    (unrestrictedMemoryWeightTest v)
  let R := unrestrictedEdgeRowBound ρ v vmin T
  let H := unrestrictedEdgeReversalBound vmin vmax T
  have hm : ∀ s, 0 ≤ m s := fun s =>
    boundedOrderedStateWeight_nonneg μ (unrestrictedResidueWeight μ) hμ
      (fun z => hμ z.1) s
  have hw : ∀ s, 0 < w s := fun s => pow_pos (zero_lt_one.trans hv) _
  have hR : 0 ≤ R := by
    unfold R unrestrictedEdgeRowBound unrestrictedEdgeChoiceBound
    have hd := unrestrictedEdgeDampingBound_nonneg (vmin := vmin) hρ1 T
    have hv0 := (zero_lt_one.trans hv).le
    positivity
  have hp := hduality (unrestrictedMemoryWeightTest v) (unrestrictedDividedSquareTest v F)
    (unrestrictedMemoryWeightTest_symmetric v) (unrestrictedDividedSquareTest_symmetric v F hF)
  change (∑ s : S, (m s : ℂ) * (w s : ℂ) * A s) =
    ∑ s : S, (m s : ℂ) * E s *
      ((‖F s.1 (boundedOrderedTupleToFinite s.2)‖ ^ 2 / w s : ℝ) : ℂ) at hp
  have h := finite_weighted_energy_of_complex_pairing m m w w A E
    (unrestrictedBoundedAction n Δ D μ ρ V t B phase F)
    (fun s => F s.1 (boundedOrderedTupleToFinite s.2)) (R := R) (C := R * H)
    hm hm hw hR
    (fun s => unrestricted_bounded_action_cauchy n Δ D μ hρ0 hρ1 hv hvmin hVlo
      hμ hmass t B T ht phase hphase F s) hp
    (fun s => unrestricted_bounded_reverse_weight_le n Δ D μ hρ0 hρ1 hv hvmin hVlo hVhi
      hμ hmass t B T ht s)
  calc
    _ ≤ R * (R * H) * ∑ s : S, m s * ‖F s.1 (boundedOrderedTupleToFinite s.2)‖ ^ 2 := h
    _ = _ := by dsimp only [R, H, m, S]; ring

/-- An actual map on functions on the finite bounded state space. -/
noncomputable def unrestrictedBoundedOperator {P : Type*} [Fintype P]
    (n : P → ℕ) (Δ D : ℤ) (μ : P → ℝ) (ρ V : ℝ) (t B : ℕ)
    (phase : UnrestrictedBoundedPhase n Δ D t B)
    (f : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ) :
    BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ :=
  unrestrictedBoundedAction n Δ D μ ρ V t B phase (boundedOrderedZeroExtension f)

/-- Finite-state version: the input is only defined on the bounded state
space and is symmetric there. The output is allowed to be nonsymmetric. -/
theorem unrestricted_bounded_operator_energy_le_of_duality {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (Δ D : ℤ) (μ : P → ℝ)
    {ρ V v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : vmin ≤ V) (hVhi : V ≤ vmax)
    (hμ : ∀ p, 0 ≤ μ p) (hmass : ∑ p, μ p ≤ 2)
    (t B T : ℕ) (ht : t ≤ T)
    (hduality : UnrestrictedBoundedDuality n Δ D μ ρ V t B)
    (phase : UnrestrictedBoundedPhase n Δ D t B)
    (hphase : ∀ s stores promotions e fresh, ‖phase s stores promotions e fresh‖ ≤ 1)
    (f : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
    (hf : BoundedOrderedSymmetric f) :
    (∑ s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B,
      boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s *
        ‖unrestrictedBoundedOperator n Δ D μ ρ V t B phase f s‖ ^ 2) ≤
    (unrestrictedEdgeRowBound ρ v vmin T) ^ 2 * unrestrictedEdgeReversalBound vmin vmax T *
      ∑ s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B,
        boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s * ‖f s‖ ^ 2 := by
  have h := unrestricted_bounded_energy_le_of_duality n Δ D μ hρ0 hρ1 hv hvmin hVlo hVhi
    hμ hmass t B T ht hduality phase hphase (boundedOrderedZeroExtension f)
    ((boundedOrderedZeroExtension_symmetric_iff f).mpr hf)
  simpa only [unrestrictedBoundedOperator, boundedOrderedZeroExtension_apply] using h
end

section
open Finset Classical
theorem unrestricted_sum_pair_swap {A B C D M : Type*}
    [Fintype A] [Fintype B] [Fintype C] [Fintype D] [AddCommMonoid M]
    (f : A → B → C → D → M) :
    (∑ a, ∑ b, ∑ c, ∑ d, f a b c d) = ∑ c, ∑ d, ∑ a, ∑ b, f a b c d := by
  calc
    _ = ∑ a, ∑ c, ∑ d, ∑ b, f a b c d := by
      apply sum_congr rfl
      intro a ha
      rw [sum_comm]
      apply sum_congr rfl
      intro c hc
      rw [sum_comm]
    _ = _ := by
      rw [sum_comm]
      apply sum_congr rfl
      intro c hc
      rw [sum_comm]

noncomputable def unrestrictedDampedPair {P : Type*} {t : ℕ} (n : P → ℕ)
    (ρ : ℝ)
    (F H : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (source target : Fin t → P)
    (X Y : FiniteOrderedTuple (UnrestrictedResidueParticle n)) : ℂ :=
  ((ρ ^ orderedPredicateCount X unrestrictedResidueHit *
      ρ ^ orderedPredicateCount Y unrestrictedResidueHit : ℝ) : ℂ) * F source X * H target Y

theorem unrestricted_damped_pair_source_symmetric {P : Type*} {t : ℕ}
    (n : P → ℕ) (ρ : ℝ)
    (F H : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (hF : ∀ source, OrderedTupleSymmetric (F source))
    (source target : Fin t → P) (Y : FiniteOrderedTuple (UnrestrictedResidueParticle n)) :
    OrderedTupleSymmetric (fun X => unrestrictedDampedPair n ρ F H source target X Y) := by
  intro N q e
  simp only [unrestrictedDampedPair, orderedPredicateCount_permutation, hF source N q e]

theorem unrestricted_damped_pair_target_symmetric {P : Type*} {t : ℕ}
    (n : P → ℕ) (ρ : ℝ)
    (F H : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (hH : ∀ target, OrderedTupleSymmetric (H target))
    (source target : Fin t → P) (X : FiniteOrderedTuple (UnrestrictedResidueParticle n)) :
    OrderedTupleSymmetric (fun Y => unrestrictedDampedPair n ρ F H source target X Y) := by
  intro N q e
  simp only [unrestrictedDampedPair, orderedPredicateCount_permutation, hH target N q e]

theorem unrestricted_fixed_slot_output_cutoff {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ D : ℤ)
    (t N B : ℕ) (S T : Finset (Fin t))
    (F : (Fin t → P) → (Fin t → P) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    unrestrictedFixedSlotPairing n μ Δ D t N S T
        (fun source target X Y => if Y.1 ≤ B then F source target X Y else 0) =
      if N - T.card + S.card ≤ B then unrestrictedFixedSlotPairing n μ Δ D t N S T F else 0 := by
  unfold unrestrictedFixedSlotPairing
  simp only [unrestrictedEdgeOutput, unrestrictedEdgeMemory_length, Fintype.card_coe]
  split_ifs with h
  · rfl
  · simp

noncomputable def unrestrictedActionLevelPairing {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ D : ℤ) (ρ V : ℝ)
    (t N B : ℕ)
    (F H : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) : ℂ :=
  (∑ source : Fin t → P, ((∏ i, μ (source i) : ℝ) : ℂ) *
    ∑ q : Fin N → UnrestrictedResidueParticle n,
      ((∏ j, unrestrictedResidueWeight μ (q j) : ℝ) : ℂ) * F source ⟨N, q⟩ *
        unrestrictedResidueEdgeAction n Δ D source q μ ρ V B
          (fun _ _ _ _ => 1) H) / ((N.factorial : ℝ) : ℂ)

theorem unrestricted_action_level_pairing_slots {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ D : ℤ) (ρ V : ℝ)
    (t N B : ℕ)
    (F H : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    unrestrictedActionLevelPairing n μ Δ D ρ V t N B F H =
      ∑ S : Finset (Fin t), ∑ T : Finset (Fin t), ((1 / V ^ T.card : ℝ) : ℂ) *
        unrestrictedFixedSlotPairing n μ Δ D t N S T
          (fun source target X Y => if Y.1 ≤ B then
            unrestrictedDampedPair n ρ F H source target X Y else 0) := by
  unfold unrestrictedActionLevelPairing unrestrictedResidueEdgeAction unrestrictedEdgeAction
  simp_rw [mul_sum, sum_div, mul_div_assoc]
  rw [unrestricted_sum_pair_swap]
  apply sum_congr rfl
  intro S hS
  apply sum_congr rfl
  intro T hT
  unfold unrestrictedFixedSlotPairing
  simp_rw [mul_sum, sum_div, mul_div_assoc]
  simp_rw [mul_sum]
  apply sum_congr rfl
  intro source hs
  apply sum_congr rfl
  intro q hq
  apply sum_congr rfl
  intro e he
  apply sum_congr rfl
  intro f hf
  unfold unrestrictedEdgeEventMass unrestrictedDampedPair
  split_ifs <;> push_cast <;> ring

/-- The output cutoff exchanges with the source-size summation exactly. -/
theorem unrestricted_fixed_slot_bounded_reverse {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ D : ℤ)
    (t Bsrc Btgt : ℕ) (S T : Finset (Fin t))
    (F : (Fin t → P) → (Fin t → P) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (hX : ∀ source target Y, OrderedTupleSymmetric (fun X => F source target X Y))
    (hY : ∀ source target X, OrderedTupleSymmetric (fun Y => F source target X Y)) :
    (∑ N ∈ range (Bsrc + 1), unrestrictedFixedSlotPairing n μ Δ D t N S T
      (fun source target X Y => if Y.1 ≤ Btgt then F source target X Y else 0)) =
    ∑ M ∈ range (Btgt + 1), unrestrictedFixedSlotPairing n μ (-Δ) D t M T S
      (fun target source Y X => if X.1 ≤ Bsrc then F source target X Y else 0) := by
  simp_rw [unrestricted_fixed_slot_output_cutoff]
  exact unrestricted_paired_size_reindex
    (fun N => unrestrictedFixedSlotPairing n μ Δ D t N S T F)
    (fun M => unrestrictedFixedSlotPairing n μ (-Δ) D t M T S
      (fun target source Y X => F source target X Y))
    T.card S.card Bsrc Btgt
    (fun N hN => unrestricted_fixed_slot_pairing_eq_zero_of_lt n μ Δ D t N S T hN F)
    (fun M hM => unrestricted_fixed_slot_pairing_eq_zero_of_lt n μ (-Δ) D t M T S hM _)
    (fun k => unrestricted_fixed_slot_pairing_reverse n μ Δ D t k S T F hX hY)

noncomputable def unrestrictedWeightedActionLevelPairing {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ D : ℤ) (ρ V : ℝ)
    (t N B : ℕ) (w : Finset (Fin t) → Finset (Fin t) → ℂ)
    (F H : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) : ℂ :=
  (∑ source : Fin t → P, ((∏ i, μ (source i) : ℝ) : ℂ) *
    ∑ q : Fin N → UnrestrictedResidueParticle n,
      ((∏ j, unrestrictedResidueWeight μ (q j) : ℝ) : ℂ) * F source ⟨N, q⟩ *
        unrestrictedResidueEdgeAction n Δ D source q μ ρ V B
          (fun S T _ _ => w S T) H) / ((N.factorial : ℝ) : ℂ)

theorem unrestricted_weighted_action_level_pairing_slots {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ D : ℤ) (ρ V : ℝ)
    (t N B : ℕ) (w : Finset (Fin t) → Finset (Fin t) → ℂ)
    (F H : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    unrestrictedWeightedActionLevelPairing n μ Δ D ρ V t N B w F H =
      ∑ S : Finset (Fin t), ∑ T : Finset (Fin t), (w S T * ((1 / V ^ T.card : ℝ) : ℂ)) *
        unrestrictedFixedSlotPairing n μ Δ D t N S T
          (fun source target X Y => if Y.1 ≤ B then
            unrestrictedDampedPair n ρ F H source target X Y else 0) := by
  unfold unrestrictedWeightedActionLevelPairing unrestrictedResidueEdgeAction unrestrictedEdgeAction
  simp_rw [mul_sum, sum_div, mul_div_assoc]
  rw [unrestricted_sum_pair_swap]
  apply sum_congr rfl
  intro S hS
  apply sum_congr rfl
  intro T hT
  unfold unrestrictedFixedSlotPairing
  simp_rw [mul_sum, sum_div, mul_div_assoc]
  simp_rw [mul_sum]
  apply sum_congr rfl
  intro source hs
  apply sum_congr rfl
  intro q hq
  apply sum_congr rfl
  intro e he
  apply sum_congr rfl
  intro f hf
  unfold unrestrictedEdgeEventMass unrestrictedDampedPair
  split_ifs <;> push_cast <;> ring

theorem unrestricted_three_sum_rotate {A B C M : Type*}
    [Fintype B] [Fintype C] [AddCommMonoid M] (S : Finset A) (f : A → B → C → M) :
    (∑ a ∈ S, ∑ b, ∑ c, f a b c) = ∑ b, ∑ c, ∑ a ∈ S, f a b c := by
  rw [sum_comm]
  apply sum_congr rfl
  intro b hb
  rw [sum_comm]

/-- Full finite product/factorial-measure duality for the phase-one residue
edge, with both endpoint cutoffs and the exact reversed normalization. -/
theorem unrestricted_bounded_action_pairing_reverse {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ D : ℤ) (ρ : ℝ)
    {V : ℝ} (hV : V ≠ 0) (t Bsrc Btgt : ℕ)
    (F H : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (hF : ∀ source, OrderedTupleSymmetric (F source))
    (hH : ∀ target, OrderedTupleSymmetric (H target)) :
    (∑ N ∈ range (Bsrc + 1), unrestrictedActionLevelPairing n μ Δ D ρ V t N Btgt F H) =
    ∑ M ∈ range (Btgt + 1), unrestrictedWeightedActionLevelPairing n μ (-Δ) D ρ V t M Bsrc
      (fun S T => ((V ^ T.card / V ^ S.card : ℝ) : ℂ)) H F := by
  simp_rw [unrestricted_action_level_pairing_slots,
    unrestricted_weighted_action_level_pairing_slots]
  rw [unrestricted_three_sum_rotate, unrestricted_three_sum_rotate]
  conv_rhs => rw [sum_comm]
  apply sum_congr rfl
  intro S hS
  apply sum_congr rfl
  intro T hT
  conv_lhs => rw [← mul_sum]
  conv_rhs => rw [← mul_sum]
  have hc : ((V ^ S.card / V ^ T.card : ℝ) : ℂ) * ((1 / V ^ S.card : ℝ) : ℂ) =
      ((1 / V ^ T.card : ℝ) : ℂ) := by
    rw [← Complex.ofReal_mul]
    congr 1
    field_simp
  conv_rhs => rw [hc]
  apply congrArg (fun z : ℂ => ((1 / V ^ T.card : ℝ) : ℂ) * z)
  have hreverse := unrestricted_fixed_slot_bounded_reverse n μ Δ D t Bsrc Btgt S T
    (unrestrictedDampedPair n ρ F H)
    (unrestricted_damped_pair_source_symmetric n ρ F H hF)
    (unrestricted_damped_pair_target_symmetric n ρ F H hH)
  refine hreverse.trans ?_
  apply sum_congr rfl
  intro M hM
  apply congrArg (unrestrictedFixedSlotPairing n μ (-Δ) D t M T S)
  funext target source Y X
  split_ifs
  · unfold unrestrictedDampedPair
    push_cast
    ring
  · rfl
end

section
open Finset
noncomputable def candidateQMaxIndex (c L : ℝ) : ℕ :=
  ⌊Real.log (c * L / (20 * Real.log L)) / Real.log 2⌋₊

theorem candidateQIndices_eq_Icc (c L : ℝ) :
    candidateQIndices c L = Icc 0 (candidateQMaxIndex c L) := rfl

noncomputable def candidateFreeSlot (c L : ℝ) (r : ℕ) (hr : 0 < r) :
    (candidateQIndices c L) × Fin r :=
  (⟨0, by simp [candidateQIndices]⟩, ⟨0, hr⟩)

theorem candidate_free_slot_eq_iff (c L : ℝ) (r : ℕ) (hr : 0 < r)
    (slot : (candidateQIndices c L) × Fin r) :
    slot = candidateFreeSlot c L r hr ↔ slot.1.val = 0 ∧ slot.2.val = 0 := by
  simp only [candidateFreeSlot, Prod.ext_iff, Subtype.ext_iff, Fin.ext_iff]

noncomputable def candidateCompletedLogArray (c L : ℝ) (r : ℕ) (hr : 0 < r)
    (x : (candidateQIndices c L) × Fin r → ℕ) (j : ℕ) (k : Fin r) : ℝ := by
  classical
  exact if hj : j ∈ candidateQIndices c L then
    completedSlotLog x (candidateFreeSlot c L r hr) ((11/10 : ℝ) * (c * L)) (⟨j, hj⟩, k)
  else 0

theorem candidate_completed_log_array_sum (c L : ℝ) (r : ℕ) (hr : 0 < r)
    (x : (candidateQIndices c L) × Fin r → ℕ) :
    (∑ j ∈ Icc 0 (candidateQMaxIndex c L), ∑ k, candidateCompletedLogArray c L r hr x j k) =
      ∑ slot, completedSlotLog x (candidateFreeSlot c L r hr) ((11/10 : ℝ) * (c * L)) slot := by
  classical
  rw [← candidateQIndices_eq_Icc]
  rw [← Finset.sum_coe_sort (candidateQIndices c L)
    (fun j => ∑ k, candidateCompletedLogArray c L r hr x j k)]
  rw [Fintype.sum_prod_type]
  apply sum_congr rfl
  intro j _
  apply sum_congr rfl
  intro k _
  simp only [candidateCompletedLogArray, dif_pos j.property]

theorem candidate_completed_log_array_prefix {c L eps : ℝ} {r jStar J : ℕ}
    (hr : 0 < r) (heps : 0 ≤ eps) (hcL : 0 ≤ c * L)
    (hJN : J ≤ candidateQMaxIndex c L)
    (x : (candidateQIndices c L) × Fin r → ℕ)
    (hx : ∀ slot, x slot ∈ candidatePrefixChoices c L eps r jStar J slot) :
    ∀ j ∈ Icc 0 J, ∀ k,
      |candidateCompletedLogArray c L r hr x j k - (11/10 : ℝ) * (c * L) / 2^j| ≤
        eps * (c * L) / 2^j := by
  classical
  intro j hj k
  have hjmem : j ∈ candidateQIndices c L := mem_Icc.mpr
    ⟨Nat.zero_le _, (mem_Icc.mp hj).2.trans hJN⟩
  rw [candidateCompletedLogArray, dif_pos hjmem]
  unfold completedSlotLog
  split_ifs with hfree
  · have hzero : j = 0 := ((candidate_free_slot_eq_iff c L r hr (⟨j, hjmem⟩, k)).mp hfree).1
    subst j
    simp only [pow_zero, div_one, sub_self, abs_zero]
    exact mul_nonneg heps hcL
  · exact candidate_prefix_slot_log_deviation (⟨j, hjmem⟩, k) (mem_Icc.mp hj).2
      (fun h => hfree ((candidate_free_slot_eq_iff c L r hr (⟨j, hjmem⟩, k)).mpr h)) (hx _)

theorem candidate_completed_log_array_tail {c L eps : ℝ} {r jStar J : ℕ}
    (hr : 0 < r) (hcL : 0 ≤ c * L) (heps : eps ≤ 1/10) (hJ : J < jStar)
    (x : (candidateQIndices c L) × Fin r → ℕ)
    (hx : ∀ slot, x slot ∈ candidatePrefixChoices c L eps r jStar J slot) :
    ∀ j ∈ Ioc J (candidateQMaxIndex c L), ∀ k,
      0 ≤ candidateCompletedLogArray c L r hr x j k ∧
        candidateCompletedLogArray c L r hr x j k ≤ (6/5 : ℝ) * (c * L) / 2^j := by
  classical
  intro j hj k
  have hjmem : j ∈ candidateQIndices c L := mem_Icc.mpr ⟨Nat.zero_le _, (mem_Ioc.mp hj).2⟩
  have hfree : (⟨j, hjmem⟩, k) ≠ candidateFreeSlot c L r hr := by
    intro h
    have hz : j = 0 := ((candidate_free_slot_eq_iff c L r hr (⟨j, hjmem⟩, k)).mp h).1
    have hJj := (mem_Ioc.mp hj).1
    omega
  rw [candidateCompletedLogArray, dif_pos hjmem, completedSlotLog, if_neg hfree]
  exact candidate_prefix_slot_log_bounds hcL heps hJ (⟨j, hjmem⟩, k) (hx _)

theorem candidate_completed_midpoint_error {c L eps : ℝ} {r jStar J : ℕ}
    (hr : 0 < r) (hcL : 0 ≤ c * L) (heps0 : 0 ≤ eps) (heps1 : eps ≤ 1/10)
    (hJN : J ≤ candidateQMaxIndex c L) (hJstar : J < jStar)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1)
    (hepsr : eps * (r : ℝ) ≤ 1/400) (hJ : 1000 * (r : ℝ) ≤ 2^J)
    (x : (candidateQIndices c L) × Fin r → ℕ)
    (hx : ∀ slot, x slot ∈ candidatePrefixChoices c L eps r jStar J slot) :
    |(∑ slot, completedSlotLog x (candidateFreeSlot c L r hr) ((11/10 : ℝ) * (c * L)) slot) - L| ≤
      c * L / 100 := by
  rw [← candidate_completed_log_array_sum]
  exact candidate_midpoint_error_small hJN hcL heps0 hcenter hepsr hJ _
    (candidate_completed_log_array_prefix hr heps0 hcL hJN x hx)
    (candidate_completed_log_array_tail hr hcL heps1 hJstar x hx)
end

section
open Finset
open scoped Classical
/-- The actual residue action with empty storage and promotions transports the
whole repeated memory and integrates unrestricted fresh targets. -/
theorem unrestricted_residue_edge_action_clean {P : Type*} [Fintype P] {t N : ℕ}
    (n : P → ℕ) (Δ D : ℤ) (source : Fin t → P)
    (old : Fin N → UnrestrictedResidueParticle n) (μ : P → ℝ)
    (ρ V : ℝ) (B : ℕ) (θ : (Fin t → P) → ℂ)
    (F : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (hF : ∀ target, OrderedTupleSymmetric (F target)) :
    unrestrictedResidueEdgeAction n Δ D source old μ ρ V B
      (fun stores promotions e fresh =>
        if stores = ∅ ∧ promotions = ∅ then
          θ (unrestrictedEdgeTarget old Sigma.fst promotions e fresh) else 0) F =
      if N ≤ B then
        ((ρ ^ orderedPredicateCount ⟨N, old⟩ unrestrictedResidueHit *
          ρ ^ orderedPredicateCount ⟨N, unrestrictedResidueTransport n Δ ∘ old⟩
            unrestrictedResidueHit : ℝ) : ℂ) *
          ∑ target : Fin t → P, ((∏ j, μ (target j) : ℝ) : ℂ) *
            θ target * F target ⟨N, unrestrictedResidueTransport n Δ ∘ old⟩
      else 0 := by
  unfold unrestrictedResidueEdgeAction
  have hmask :
      (fun (stores promotions : Finset (Fin t))
        (e : promotions ↪ unrestrictedResidueEligible n Δ D old)
        (fresh : UnrestrictedFreshLabels P promotions) =>
        if unrestrictedResidueStorageAllowed n D source stores then
          (if stores = ∅ ∧ promotions = ∅ then
            θ (unrestrictedEdgeTarget old Sigma.fst promotions e fresh) else 0) else 0) =
      (fun (stores promotions : Finset (Fin t))
        (e : promotions ↪ unrestrictedResidueEligible n Δ D old)
        (fresh : UnrestrictedFreshLabels P promotions) =>
        if stores = ∅ ∧ promotions = ∅ then
          θ (unrestrictedEdgeTarget old Sigma.fst promotions e fresh) else 0) := by
    funext stores promotions e fresh
    by_cases hs : stores = ∅
    · subst stores
      have hallowed : unrestrictedResidueStorageAllowed n D source ∅ := by
        intro i hi
        exact (notMem_empty i hi).elim
      rw [if_pos hallowed]
    · simp only [hs, false_and, if_false, ite_self]
  rw [hmask]
  exact unrestricted_edge_action_clean source old Sigma.fst (unrestrictedResidueSeed n)
    (unrestrictedResidueTransport n Δ) unrestrictedResidueHit μ ρ V
    (unrestrictedResidueEligible n Δ D old) B θ F hF

/-- Physical tilted label weights specialize the exact clean residue action.
This is an algebraic identity; positivity and baseline bounds are needed only
for subsequent estimates, not for the identity itself. -/
theorem physical_tilted_residue_edge_action_clean {G : Type*} {P : G → Finset ℕ}
    (V : G → ℝ) (g : G) (baseline : P g → ℝ) {t N : ℕ}
    (Δ D : ℤ) (source : Fin t → P g)
    (old : Fin N → UnrestrictedResidueParticle (fun p : P g => p.val))
    (ρ : ℝ) (B : ℕ) (θ : (Fin t → P g) → ℂ)
    (F : (Fin t → P g) →
      FiniteOrderedTuple (UnrestrictedResidueParticle (fun p : P g => p.val)) → ℂ)
    (hF : ∀ target, OrderedTupleSymmetric (F target)) :
    unrestrictedResidueEdgeAction (fun p : P g => p.val) Δ D source old
      (tiltedPhysicalBirthLaw V g baseline) ρ (V g) B
      (fun stores promotions e fresh =>
        if stores = ∅ ∧ promotions = ∅ then
          θ (unrestrictedEdgeTarget old Sigma.fst promotions e fresh) else 0) F =
      if N ≤ B then
        ((ρ ^ orderedPredicateCount ⟨N, old⟩ unrestrictedResidueHit *
          ρ ^ orderedPredicateCount
            ⟨N, unrestrictedResidueTransport (fun p : P g => p.val) Δ ∘ old⟩
            unrestrictedResidueHit : ℝ) : ℂ) *
          ∑ target : Fin t → P g,
            ((∏ j, tiltedPhysicalBirthLaw V g baseline (target j) : ℝ) : ℂ) *
              θ target * F target
                ⟨N, unrestrictedResidueTransport (fun p : P g => p.val) Δ ∘ old⟩
      else 0 :=
  unrestricted_residue_edge_action_clean (fun p : P g => p.val) Δ D source old
    (tiltedPhysicalBirthLaw V g baseline) ρ (V g) B θ F hF
end

section
open Finset Classical
theorem bounded_ordered_pairing_levels {P Z : Type*} [Fintype P] [Fintype Z]
    (μ : P → ℝ) (ν : Z → ℝ) (t B : ℕ)
    (F G : (Fin t → P) → FiniteOrderedTuple Z → ℂ) :
    (∑ s : BoundedOrderedState P Z t B,
      (boundedOrderedStateWeight μ ν s : ℂ) * F s.1 (boundedOrderedTupleToFinite s.2) *
        G s.1 (boundedOrderedTupleToFinite s.2)) =
    ∑ N ∈ range (B + 1),
      (∑ active : Fin t → P, ((∏ i, μ (active i) : ℝ) : ℂ) *
        ∑ q : Fin N → Z, ((∏ j, ν (q j) : ℝ) : ℂ) * F active ⟨N, q⟩ * G active ⟨N, q⟩) /
          ((N.factorial : ℝ) : ℂ) := by
  calc
    _ = ∑ s : BoundedOrderedState P Z t B,
        (boundedOrderedStateWeight μ ν s : ℂ) *
          (F s.1 (boundedOrderedTupleToFinite s.2) * G s.1 (boundedOrderedTupleToFinite s.2)) := by
      apply sum_congr rfl
      intro s hs
      ring
    _ = _ := by
      rw [bounded_ordered_state_complex_sum_range_first μ ν t B (fun a q => F a q * G a q)]
      apply sum_congr rfl
      intro N hN
      simp_rw [mul_sum, sum_div]
      apply sum_congr rfl
      intro active ha
      apply sum_congr rfl
      intro q hq
      push_cast
      ring

/-- The actual positive/reverse action duality, with all slot subsets and all
bounded memory lengths summed. The only algebraic normalization condition is
that the group mass is nonzero. -/
theorem unrestricted_bounded_duality {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (Δ D : ℤ) (μ : P → ℝ) (ρ : ℝ)
    {V : ℝ} (hV : V ≠ 0) (t B : ℕ) :
    UnrestrictedBoundedDuality n Δ D μ ρ V t B := by
  intro F G hF hG
  let A (source : Fin t → P) (q : FiniteOrderedTuple (UnrestrictedResidueParticle n)) : ℂ :=
    unrestrictedResidueEdgeAction n Δ D source q.2 μ ρ V B (fun _ _ _ _ => 1) G
  let R (source : Fin t → P) (q : FiniteOrderedTuple (UnrestrictedResidueParticle n)) : ℂ :=
    unrestrictedResidueEdgeAction n (-Δ) D source q.2 μ ρ V B
      (fun stores promotions _ _ => ((V ^ promotions.card / V ^ stores.card : ℝ) : ℂ)) F
  have hleft := bounded_ordered_pairing_levels μ (unrestrictedResidueWeight μ) t B F A
  have hright := bounded_ordered_pairing_levels μ (unrestrictedResidueWeight μ) t B G R
  calc
    _ = ∑ N ∈ range (B + 1), unrestrictedActionLevelPairing n μ Δ D ρ V t N B F G := hleft
    _ = ∑ N ∈ range (B + 1), unrestrictedWeightedActionLevelPairing n μ (-Δ) D ρ V t N B
        (fun stores promotions => ((V ^ promotions.card / V ^ stores.card : ℝ) : ℂ)) G F :=
      unrestricted_bounded_action_pairing_reverse n μ Δ D ρ hV t B B F G hF hG
    _ = ∑ s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B,
        (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s : ℂ) *
          G s.1 (boundedOrderedTupleToFinite s.2) * R s.1 (boundedOrderedTupleToFinite s.2) := hright.symm
    _ = _ := by
      apply sum_congr rfl
      intro s hs
      change (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s : ℂ) *
          G s.1 (boundedOrderedTupleToFinite s.2) * R s.1 (boundedOrderedTupleToFinite s.2) =
        (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s : ℂ) *
          R s.1 (boundedOrderedTupleToFinite s.2) * G s.1 (boundedOrderedTupleToFinite s.2)
      ring

/-- The actual finite ordered-memory edge satisfies the energy estimate.
There is no remaining duality or column-estimate hypothesis. -/
theorem unrestricted_bounded_operator_energy_le {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (Δ D : ℤ) (μ : P → ℝ)
    {ρ V v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : vmin ≤ V) (hVhi : V ≤ vmax)
    (hμ : ∀ p, 0 ≤ μ p) (hmass : ∑ p, μ p ≤ 2)
    (t B T : ℕ) (ht : t ≤ T)
    (phase : UnrestrictedBoundedPhase n Δ D t B)
    (hphase : ∀ s stores promotions e fresh, ‖phase s stores promotions e fresh‖ ≤ 1)
    (f : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
    (hf : BoundedOrderedSymmetric f) :
    (∑ s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B,
      boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s *
        ‖unrestrictedBoundedOperator n Δ D μ ρ V t B phase f s‖ ^ 2) ≤
    (unrestrictedEdgeRowBound ρ v vmin T) ^ 2 * unrestrictedEdgeReversalBound vmin vmax T *
      ∑ s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B,
        boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s * ‖f s‖ ^ 2 :=
  unrestricted_bounded_operator_energy_le_of_duality n Δ D μ hρ0 hρ1 hv hvmin hVlo hVhi
    hμ hmass t B T ht (unrestricted_bounded_duality n Δ D μ ρ (hvmin.trans_le hVlo).ne' t B)
    phase hphase f hf
end

section
open Finset Filter
open scoped Topology
noncomputable def candidateRestProduct (c L : ℝ) (r : ℕ) (hr : 0 < r)
    (x : (candidateQIndices c L) × Fin r → ℕ) : ℕ :=
  ∏ slot : {slot : (candidateQIndices c L) × Fin r // slot ≠ candidateFreeSlot c L r hr}, x slot.val

theorem candidate_remainder_log_window {c L eps : ℝ} {r jStar J : ℕ}
    (hr : 0 < r) (hcL : 0 ≤ c * L) (heps0 : 0 ≤ eps) (heps1 : eps ≤ 1/10)
    (hJN : J ≤ candidateQMaxIndex c L) (hJstar : J < jStar)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1)
    (hepsr : eps * (r : ℝ) ≤ 1/400) (hJ : 1000 * (r : ℝ) ≤ 2^J)
    (hlarge : Real.log 16 ≤ c * L / 20)
    (x : (candidateQIndices c L) × Fin r → ℕ)
    (hx : ∀ slot, x slot ∈ candidatePrefixChoices c L eps r jStar J slot)
    {p : ℕ} (hp : p ≠ 0) (hpLog : Real.log p ≤ c * L / 100) :
    c * L ≤ Real.log (Real.exp L / ((p * candidateRestProduct c L r hr x : ℕ) : ℝ)) ∧
      Real.log (Real.exp L / ((p * candidateRestProduct c L r hr x : ℕ) : ℝ)) + Real.log 16 ≤
        (6/5 : ℝ) * c * L := by
  classical
  have hx0 : ∀ slot, x slot ≠ 0 := fun slot =>
    candidate_Q_slot_nonzero c L r jStar slot (candidatePrefixChoices_subset hcL heps1 hJstar slot (hx slot))
  have hrest0 : candidateRestProduct c L r hr x ≠ 0 := prod_ne_zero_iff.mpr (fun slot _ => hx0 slot.val)
  have hrestR : (candidateRestProduct c L r hr x : ℝ) ≠ 0 := by exact_mod_cast hrest0
  have hpR : (p : ℝ) ≠ 0 := by exact_mod_cast hp
  have hpLog0 : 0 ≤ Real.log p := Real.log_nonneg (by exact_mod_cast Nat.one_le_iff_ne_zero.mpr hp)
  have hsum := completed_slot_log_sum_nat_product x (candidateFreeSlot c L r hr)
    ((11/10 : ℝ) * (c * L)) (fun slot => hx0 slot.val)
  change (∑ slot, completedSlotLog x (candidateFreeSlot c L r hr) ((11/10 : ℝ) * (c * L)) slot) =
    (11/10 : ℝ) * (c * L) + Real.log (candidateRestProduct c L r hr x) at hsum
  have hmid := candidate_completed_midpoint_error hr hcL heps0 heps1 hJN hJstar hcenter hepsr hJ x hx
  have hwindow := candidate_free_log_window_of_midpoint hmid
    (rest := Real.log (candidateRestProduct c L r hr x) + Real.log p)
    (pLog := Real.log p) (by linarith) hpLog0 hpLog hlarge
  rw [Nat.cast_mul, Real.log_div (Real.exp_pos L).ne' (mul_ne_zero hpR hrestR), Real.log_exp,
    Real.log_mul hpR hrestR]
  simpa only [add_comm (Real.log p) (Real.log (candidateRestProduct c L r hr x))] using hwindow

theorem eventually_candidate_remainder_log_window {c eps : ℝ} {r J : ℕ}
    (hc : 0 < c) (hr : 0 < r) (heps0 : 0 ≤ eps) (heps1 : eps ≤ 1/10)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1)
    (hepsr : eps * (r : ℝ) ≤ 1/400) (hJ : 1000 * (r : ℝ) ≤ 2^J) :
    ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, J < jStar →
      ∀ x : (candidateQIndices c L) × Fin r → ℕ,
      (∀ slot, x slot ∈ candidatePrefixChoices c L eps r jStar J slot) →
      ∀ p : ℕ, p ≠ 0 → Real.log p ≤ c * L / 100 →
      c * L ≤ Real.log (Real.exp L / ((p * candidateRestProduct c L r hr x : ℕ) : ℝ)) ∧
        Real.log (Real.exp L / ((p * candidateRestProduct c L r hr x : ℕ) : ℝ)) + Real.log 16 ≤
          (6/5 : ℝ) * c * L := by
  filter_upwards [eventually_fixed_candidateQ_prefix hc J, eventually_ge_atTop (0 : ℝ),
    eventually_ge_atTop (20 * Real.log 16 / c)] with L hprefix hL hbig
  have hJN : J ≤ candidateQMaxIndex c L := (mem_Icc.mp (hprefix (by simp))).2
  have hlarge : Real.log 16 ≤ c * L / 20 := by
    have h := (div_le_iff₀ hc).mp hbig
    nlinarith
  intro jStar hJstar x hx p hp hpLog
  exact candidate_remainder_log_window hr (mul_nonneg hc.le hL) heps0 heps1 hJN hJstar
    hcenter hepsr hJ hlarge x hx hp hpLog
end

section
open Finset
open scoped Classical
abbrev RepeatedBigUnsharedSlots {G : Type*} {J : ℕ}
    (C : G → Finset (Fin J)) (g : G) (ell : ℕ) :=
  {s : PhysicalSlots J ell // repeatedBigUnshared C g s}

/-- Canonical indexing of the actual unshared-slot subtype. -/
noncomputable def repeatedBigUnsharedIndex {G : Type*} {J ell : ℕ}
    (C : G → Finset (Fin J)) (g : G) :
    Fin (Fintype.card (RepeatedBigUnsharedSlots C g ell)) ≃ RepeatedBigUnsharedSlots C g ell :=
  (Fintype.equivFin _).symm

/-- The literal clean action's source tuple is read from the repeated source
at exactly the canonically indexed unshared slots. -/
noncomputable def repeatedBigUnsharedSource {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (source : RepeatedBigLists P J ell) (g : G) :
    Fin (Fintype.card (RepeatedBigUnsharedSlots C g ell)) → P g :=
  fun j => source g (repeatedBigUnsharedIndex C g j).val

/-- Full ordered target tuples correspond to the group's unshared fresh data. -/
noncomputable def repeatedBigGroupFreshEquiv {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (g : G) :
    (Fin (Fintype.card (RepeatedBigUnsharedSlots C g ell)) → P g) ≃
      (RepeatedBigUnsharedSlots C g ell → P g) where
  toFun target s := target ((repeatedBigUnsharedIndex C g).symm s)
  invFun fresh j := fresh (repeatedBigUnsharedIndex C g j)
  left_inv target := by
    funext j
    simp only [Equiv.symm_apply_apply]
  right_inv fresh := by
    funext s
    simp only [Equiv.apply_symm_apply]

/-- Completing one group's fresh coordinates uses the actual repeatedBigFill;
other groups retain their supplied fresh data. -/
noncomputable def repeatedBigGroupFill {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (source : RepeatedBigLists P J ell)
    (freshBase : RepeatedBigFresh P C ell) (g : G)
    (fresh : RepeatedBigUnsharedSlots C g ell → P g) : RepeatedBigLists P J ell :=
  repeatedBigFill C source (Function.update freshBase g fresh)

theorem repeated_big_group_fill_unshared {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (source : RepeatedBigLists P J ell)
    (freshBase : RepeatedBigFresh P C ell) (g : G)
    (fresh : RepeatedBigUnsharedSlots C g ell → P g)
    (s : RepeatedBigUnsharedSlots C g ell) :
    repeatedBigGroupFill C source freshBase g fresh g s.val = fresh s := by
  rw [repeatedBigGroupFill, repeated_big_fill_unshared]
  simp only [Function.update_self]

/-- Reindexing the tilted fresh product changes neither its factors nor their
multiplicities; fresh labels may repeat. -/
theorem repeated_big_group_fresh_product {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (g : G) (baseline : P g → ℝ) (C : G → Finset (Fin J))
    (target : Fin (Fintype.card (RepeatedBigUnsharedSlots C g ell)) → P g) :
    (∏ j, tiltedPhysicalBirthLaw V g baseline (target j)) =
      ∏ s : RepeatedBigUnsharedSlots C g ell,
        tiltedPhysicalBirthLaw V g baseline (repeatedBigGroupFreshEquiv C g target s) := by
  exact (repeatedBigUnsharedIndex C g).symm.prod_comp
    (fun j => tiltedPhysicalBirthLaw V g baseline (target j)) |>.symm

/-- Exact one-group tilted integral over the actual unshared physical slots,
with an arbitrary coupled complex test and no factorial normalization. -/
theorem repeated_big_group_fresh_sum {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (g : G) (baseline : P g → ℝ) (C : G → Finset (Fin J))
    (H : (RepeatedBigUnsharedSlots C g ell → P g) → ℂ) :
    (∑ target : Fin (Fintype.card (RepeatedBigUnsharedSlots C g ell)) → P g,
      ((∏ j, tiltedPhysicalBirthLaw V g baseline (target j) : ℝ) : ℂ) *
        H (repeatedBigGroupFreshEquiv C g target)) =
      ∑ fresh : RepeatedBigUnsharedSlots C g ell → P g,
        ((∏ s, tiltedPhysicalBirthLaw V g baseline (fresh s) : ℝ) : ℂ) * H fresh := by
  simp_rw [repeated_big_group_fresh_product V g baseline C]
  exact (repeatedBigGroupFreshEquiv C g).sum_comp
    (fun fresh => ((∏ s, tiltedPhysicalBirthLaw V g baseline (fresh s) : ℝ) : ℂ) * H fresh)

/-- The literal physical clean action is the one-group repeated-big fresh
integral. It retains both rho counts, the actual cutoff, arbitrary full-target
multipliers, and a memory-symmetric continuation; no injectivity is assumed. -/
theorem repeated_big_group_clean_action {G : Type*} {P : G → Finset ℕ} {J ell N : ℕ}
    (V : G → ℝ) (g : G) (baseline : P g → ℝ) (C : G → Finset (Fin J))
    (source : RepeatedBigLists P J ell) (freshBase : RepeatedBigFresh P C ell)
    (Δ D : ℤ)
    (old : Fin N → UnrestrictedResidueParticle (fun p : P g => p.val))
    (ρ : ℝ) (B : ℕ) (θ : RepeatedBigLists P J ell → ℂ)
    (F : RepeatedBigLists P J ell →
      FiniteOrderedTuple (UnrestrictedResidueParticle (fun p : P g => p.val)) → ℂ)
    (hF : ∀ target, OrderedTupleSymmetric (F target)) :
    unrestrictedResidueEdgeAction (fun p : P g => p.val) Δ D
      (repeatedBigUnsharedSource C source g) old
      (tiltedPhysicalBirthLaw V g baseline) ρ (V g) B
      (fun stores promotions e fresh =>
        if stores = ∅ ∧ promotions = ∅ then
          θ (repeatedBigGroupFill C source freshBase g
            (repeatedBigGroupFreshEquiv C g
              (unrestrictedEdgeTarget old Sigma.fst promotions e fresh))) else 0)
      (fun target memory => F (repeatedBigGroupFill C source freshBase g
        (repeatedBigGroupFreshEquiv C g target)) memory) =
      if N ≤ B then
        ((ρ ^ orderedPredicateCount ⟨N, old⟩ unrestrictedResidueHit *
          ρ ^ orderedPredicateCount
            ⟨N, unrestrictedResidueTransport (fun p : P g => p.val) Δ ∘ old⟩
            unrestrictedResidueHit : ℝ) : ℂ) *
          ∑ fresh : RepeatedBigUnsharedSlots C g ell → P g,
            ((∏ s, tiltedPhysicalBirthLaw V g baseline (fresh s) : ℝ) : ℂ) *
              θ (repeatedBigGroupFill C source freshBase g fresh) *
              F (repeatedBigGroupFill C source freshBase g fresh)
                ⟨N, unrestrictedResidueTransport (fun p : P g => p.val) Δ ∘ old⟩
      else 0 := by
  have hsym : ∀ target, OrderedTupleSymmetric (fun memory =>
      F (repeatedBigGroupFill C source freshBase g (repeatedBigGroupFreshEquiv C g target)) memory) :=
    fun target => hF _
  rw [physical_tilted_residue_edge_action_clean V g baseline Δ D
    (repeatedBigUnsharedSource C source g) old ρ B
    (fun target => θ (repeatedBigGroupFill C source freshBase g
      (repeatedBigGroupFreshEquiv C g target)))
    (fun target memory => F (repeatedBigGroupFill C source freshBase g
      (repeatedBigGroupFreshEquiv C g target)) memory) hsym]
  split_ifs
  · congr 1
    simpa only [mul_assoc] using repeated_big_group_fresh_sum V g baseline C
      (fun fresh => θ (repeatedBigGroupFill C source freshBase g fresh) *
        F (repeatedBigGroupFill C source freshBase g fresh)
          ⟨N, unrestrictedResidueTransport (fun p : P g => p.val) Δ ∘ old⟩)
  · rfl
end

section
open Finset
open scoped Classical
noncomputable def cleanHybridStep {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ}
    (k : ℤ) (C : G → Finset (Fin J)) (source : RepeatedBigLists Pb J ell)
    (aux : PhysicalAuxLabels Pb C) (d : PhysicalSharedLists Ps J) : ℤ :=
  (k * (repeatedBigD C source aux : ℤ)) * (physicalSharedProduct d : ℤ)

theorem clean_hybrid_step_product {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ}
    (k : ℤ) (C : G → Finset (Fin J)) (source : RepeatedBigLists Pb J ell)
    (aux : PhysicalAuxLabels Pb C) (d : PhysicalSharedLists Ps J) :
    cleanHybridStep k C source aux d =
      k * ((physicalSharedProduct d * repeatedBigD C source aux : ℕ) : ℤ) := by
  unfold cleanHybridStep
  push_cast
  ring

/-- Both endpoint rho weights and each actual output cutoff remain explicit.
A clean edge has the same length at input and output. -/
noncomputable def cleanHybridMemoryFactor {G : Type*} [Fintype G]
    {Pb : G → Finset ℕ} {N : G → ℕ} (ρ : ℝ) (B : G → ℕ)
    (p : FixedOrderedMemoryLabels Pb N) (r : FixedOrderedResidues p) (Δ : ℤ) : ℝ := by
  classical
  exact ∏ g, if N g ≤ B g then
    ρ ^ orderedPredicateCount (fixedOrderedResidueMemory p r g) unrestrictedResidueHit *
      ρ ^ orderedPredicateCount
        (fixedOrderedResidueMemory p (fixedOrderedResidueTranslate p r Δ) g) unrestrictedResidueHit
    else 0

/-- K receives big list coordinates only. Small shared labels affect this
coefficient solely through the common physical displacement. -/
noncomputable def cleanHybridBetweenKernel {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ) (B : G → ℕ) (p : FixedOrderedMemoryLabels Pb N)
    (r : FixedOrderedResidues p)
    (K : RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb C → ℂ)
    (d : PhysicalSharedLists Ps J) (aux : PhysicalAuxLabels Pb C)
    (source target : RepeatedBigLists Pb J ell) : ℂ :=
  repeatedBigKernel Vb b C ζ K aux source target *
    physicalReturnPhase θ (cleanHybridStep k C source aux d) *
    (cleanHybridMemoryFactor ρ B p r (cleanHybridStep k C source aux d) : ℂ)

/-- At fixed big endpoints and free labels, the actual small physical kernel
factors through its two conditioning maps. Pending residues translate by the
same displacement, with their fixed ordered prime lists retained. -/
theorem clean_hybrid_fixed_big_factorization {S G : Type*}
    [Fintype S] [DecidableEq S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vs : S → ℝ) (hVs : ∀ s, 0 < Vs s) (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ)
    (C : G → Finset (Fin J)) (q ζ θ ρ : ℝ) (k : ℤ) (B : G → ℕ)
    (p : FixedOrderedMemoryLabels Pb N) (rs : PhysicalResidues Ps) (rm : FixedOrderedResidues p)
    (auxs : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))))
    (auxb : PhysicalAuxLabels Pb C) (source target : RepeatedBigLists Pb J ell)
    (K : RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb C → ℂ)
    (f : PhysicalMarkLists Ps J ell → ℂ)
    (g : PhysicalResidues Ps → FixedOrderedResidues p → PhysicalMarkLists Ps J ell → ℂ) :
    let step := cleanHybridStep k C source auxb
    let κ := fun d : PhysicalSharedLists Ps J =>
      cleanHybridBetweenKernel Vb b C ζ θ ρ k B p rm K d auxb source target
    (∑ L, ∑ R, (physicalStateMass Vs J ell : ℂ) * (starRingEnd ℂ) (f L) *
      physicalBarePatternScalar Vs (fun _ => (∅ : Finset (Fin J))) ζ
        (fun L _ _ => κ (physicalSharedPrefix L)) auxs L R *
      ((physicalResidueVertexWeight L (Real.sqrt q) rs *
        physicalResidueVertexWeight R (Real.sqrt q)
          (physicalTranslateResidues rs (step (physicalSharedPrefix L))) : ℝ) : ℂ) *
      g (physicalTranslateResidues rs (step (physicalSharedPrefix L)))
        (fixedOrderedResidueTranslate p rm (step (physicalSharedPrefix L))) R) =
    ∑ d, (starRingEnd ℂ) (physicalSmallCondition Vs q rs d f) *
      (κ d * physicalPhase ζ (physicalSharedProduct d)) *
      physicalSmallCondition Vs q (physicalTranslateResidues rs (step d)) d
        (g (physicalTranslateResidues rs (step d)) (fixedOrderedResidueTranslate p rm (step d))) := by
  intro step κ
  exact physical_small_bilinear_factorization_with_prefix Vs hVs q ζ
    (k * (repeatedBigD C source auxb : ℤ)) rs auxs κ f
    (fun d rs R => g rs (fixedOrderedResidueTranslate p rm (step d)) R)
end

section
open Finset Filter
open scoped Topology
theorem exists_candidate_localization_parameters {r : ℕ} (hr : 0 < r) :
    ∃ eps : ℝ, ∃ J : ℕ, 0 < eps ∧ eps ≤ 1/10 ∧
      eps * (r : ℝ) ≤ 1/400 ∧ 1000 * (r : ℝ) ≤ 2^J := by
  have hr0 : (0 : ℝ) < r := by exact_mod_cast hr
  have hr1 : (1 : ℝ) ≤ r := by exact_mod_cast hr
  obtain ⟨J, hJ⟩ := pow_unbounded_of_one_lt (1000 * (r : ℝ)) (by norm_num : (1 : ℝ) < 2)
  refine ⟨1 / (400 * (r : ℝ)), J, by positivity, ?_, ?_, hJ.le⟩
  · apply (div_le_iff₀ (by positivity : 0 < 400 * (r : ℝ))).mpr
    nlinarith
  · have heq : (1 / (400 * (r : ℝ))) * (r : ℝ) = 1/400 := by field_simp
    exact heq.le

/-- Both the positive mass fraction and the remainder localization are uniform in the
later rough-slot band. The ordinary product window remains explicitly `(X,16X]`. -/
theorem exists_positive_candidate_localization_event {c : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1) :
    ∃ eps : ℝ, ∃ J : ℕ, ∃ rho : ℝ, 0 < eps ∧ eps ≤ 1/10 ∧ 0 < rho ∧
      ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, J < jStar →
        rho * candidateQHarmonicMass c L r jStar ≤ candidatePrefixHarmonicMass c L eps r jStar J ∧
        ∀ x : (candidateQIndices c L) × Fin r → ℕ,
          (∀ slot, x slot ∈ candidatePrefixChoices c L eps r jStar J slot) →
          ∀ p : ℕ, p ≠ 0 → Real.log p ≤ c * L / 100 →
            c * L ≤ Real.log (Real.exp L / ((p * candidateRestProduct c L r hr x : ℕ) : ℝ)) ∧
            Real.log (Real.exp L / ((p * candidateRestProduct c L r hr x : ℕ) : ℝ)) + Real.log 16 ≤
              (6/5 : ℝ) * c * L := by
  obtain ⟨eps, J, heps, heps1, hepsr, hJ⟩ := exists_candidate_localization_parameters hr
  obtain ⟨rho, hrho, hmass⟩ := exists_candidate_prefix_harmonic_fraction hc heps heps1 r J
  refine ⟨eps, J, rho, heps, heps1, hrho, ?_⟩
  filter_upwards [hmass, eventually_candidate_remainder_log_window hc hr heps.le heps1
    hcenter hepsr hJ] with L hm hw
  intro jStar hJstar
  exact ⟨hm jStar hJstar, hw jStar hJstar⟩
end

section
open Finset
open scoped Classical
theorem clean_hybrid_shared_product_pos {S : Type*} [Fintype S]
    {Ps : S → Finset ℕ} {J : ℕ} (d : PhysicalSharedLists Ps J)
    (hP : ∀ s p, p ∈ Ps s → 0 < p) : 0 < physicalSharedProduct d := by
  apply prod_pos
  intro s _
  exact prod_pos (fun j _ => hP s _ (d s j).property)

/-- Expansion of the actual conditioned scalar. Auxiliary labels use their
original law, unshared target labels use the tilted law, and D carries one
phase for its full small-times-big product. -/
theorem clean_hybrid_between_expansion {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ) (B : G → ℕ) (p : FixedOrderedMemoryLabels Pb N)
    (r : FixedOrderedResidues p)
    (K : RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb C → ℂ)
    (d : PhysicalSharedLists Ps J) (aux : PhysicalAuxLabels Pb C)
    (source target : RepeatedBigLists Pb J ell)
    (hPs : ∀ s q, q ∈ Ps s → 0 < q) (hPb : ∀ g q, q ∈ Pb g → 0 < q) :
    cleanHybridBetweenKernel Vb b C ζ θ ρ k B p r K d aux source target *
        physicalPhase ζ (physicalSharedProduct d) =
      if repeatedBigSharedCompatible C source target ∧
          repeatedBigAuxAvoids C aux source ∧ repeatedBigAuxAvoids C aux target then
        ((physicalAuxMass Vb C aux * repeatedBigTargetMass Vb b C target *
          cleanHybridMemoryFactor ρ B p r (cleanHybridStep k C source aux d) : ℝ) : ℂ) *
          K source target aux *
          physicalPhase ζ (physicalSharedProduct d * repeatedBigD C source aux) *
          physicalReturnPhase θ (cleanHybridStep k C source aux d)
      else 0 := by
  rw [physical_phase_mul ζ (clean_hybrid_shared_product_pos d hPs)
    (repeated_big_D_pos C source aux hPb)]
  unfold cleanHybridBetweenKernel repeatedBigKernel
  split_ifs
  · push_cast
    ring
  · simp
end

section
open Finset
/-- Input damping counts every old pending zero, including repeated labels. -/
noncomputable def cleanMemoryInputWeight {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {N : G → ℕ} (ρ : ℝ)
    (p : FixedOrderedMemoryLabels P N) (r : FixedOrderedResidues p) : ℝ :=
  ∏ g, ρ ^ orderedPredicateCount (fixedOrderedResidueMemory p r g) unrestrictedResidueHit

/-- Output damping includes the actual groupwise memory-sector cutoff. -/
noncomputable def cleanMemoryOutputWeight {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {N : G → ℕ} (ρ : ℝ) (B : G → ℕ)
    (p : FixedOrderedMemoryLabels P N) (r : FixedOrderedResidues p) : ℝ :=
  ∏ g, if N g ≤ B g then
    ρ ^ orderedPredicateCount (fixedOrderedResidueMemory p r g) unrestrictedResidueHit else 0

/-- The output factor is evaluated at the translated coordinates. No
residue-dependent multiplier needs to remain in the between-test kernel. -/
theorem clean_hybrid_memory_factor_split {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {N : G → ℕ} (ρ : ℝ) (B : G → ℕ)
    (p : FixedOrderedMemoryLabels P N) (r : FixedOrderedResidues p) (Δ : ℤ) :
    cleanHybridMemoryFactor ρ B p r Δ = cleanMemoryInputWeight ρ p r *
      cleanMemoryOutputWeight ρ B p (fixedOrderedResidueTranslate p r Δ) := by
  unfold cleanHybridMemoryFactor cleanMemoryInputWeight cleanMemoryOutputWeight
  rw [← prod_mul_distrib]
  apply prod_congr rfl
  intro g _
  by_cases h : N g ≤ B g <;> simp only [h, if_true, if_false, mul_zero]

theorem clean_memory_input_weight_nonneg {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {N : G → ℕ} {ρ : ℝ} (hρ : 0 ≤ ρ)
    (p : FixedOrderedMemoryLabels P N) (r : FixedOrderedResidues p) :
    0 ≤ cleanMemoryInputWeight ρ p r :=
  prod_nonneg (fun _ _ => pow_nonneg hρ _)

theorem clean_memory_output_weight_nonneg {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {N : G → ℕ} {ρ : ℝ} (hρ : 0 ≤ ρ) (B : G → ℕ)
    (p : FixedOrderedMemoryLabels P N) (r : FixedOrderedResidues p) :
    0 ≤ cleanMemoryOutputWeight ρ B p r := by
  apply prod_nonneg
  intro g _
  split_ifs
  · exact pow_nonneg hρ _
  · exact le_rfl

theorem clean_memory_input_weight_le_one {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {N : G → ℕ} {ρ : ℝ} (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1)
    (p : FixedOrderedMemoryLabels P N) (r : FixedOrderedResidues p) :
    cleanMemoryInputWeight ρ p r ≤ 1 :=
  prod_le_one₀ (fun _ _ => pow_nonneg hρ0 _) (fun _ _ => pow_le_one₀ hρ0 hρ1)

theorem clean_memory_output_weight_le_one {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {N : G → ℕ} {ρ : ℝ} (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1)
    (B : G → ℕ) (p : FixedOrderedMemoryLabels P N) (r : FixedOrderedResidues p) :
    cleanMemoryOutputWeight ρ B p r ≤ 1 := by
  apply prod_le_one₀
  · intro g _
    split_ifs
    · exact pow_nonneg hρ0 _
    · exact le_rfl
  · intro g _
    split_ifs
    · exact pow_le_one₀ hρ0 hρ1
    · exact zero_le_one

theorem clean_hybrid_memory_factor_nonneg {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {N : G → ℕ} {ρ : ℝ} (hρ : 0 ≤ ρ) (B : G → ℕ)
    (p : FixedOrderedMemoryLabels P N) (r : FixedOrderedResidues p) (Δ : ℤ) :
    0 ≤ cleanHybridMemoryFactor ρ B p r Δ := by
  rw [clean_hybrid_memory_factor_split]
  exact mul_nonneg (clean_memory_input_weight_nonneg hρ p r)
    (clean_memory_output_weight_nonneg hρ B p _)

theorem clean_hybrid_memory_factor_le_one {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {N : G → ℕ} {ρ : ℝ} (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1)
    (B : G → ℕ) (p : FixedOrderedMemoryLabels P N) (r : FixedOrderedResidues p) (Δ : ℤ) :
    cleanHybridMemoryFactor ρ B p r Δ ≤ 1 := by
  rw [clean_hybrid_memory_factor_split]
  calc
    _ ≤ 1 * 1 := mul_le_mul (clean_memory_input_weight_le_one hρ0 hρ1 p r)
      (clean_memory_output_weight_le_one hρ0 hρ1 B p _)
      (clean_memory_output_weight_nonneg hρ0 B p _) zero_le_one
    _ = 1 := one_mul 1

/-- Exact complex pairing identity for absorption into the two endpoint
tests. Conjugating the real source weight introduces no extra phase. -/
theorem clean_hybrid_memory_factor_pairing {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {N : G → ℕ} (ρ : ℝ) (B : G → ℕ)
    (p : FixedOrderedMemoryLabels P N) (r : FixedOrderedResidues p) (Δ : ℤ)
    (u K v : ℂ) :
    (starRingEnd ℂ) u * (K * (cleanHybridMemoryFactor ρ B p r Δ : ℂ)) * v =
      (starRingEnd ℂ) ((cleanMemoryInputWeight ρ p r : ℂ) * u) * K *
        ((cleanMemoryOutputWeight ρ B p (fixedOrderedResidueTranslate p r Δ) : ℂ) * v) := by
  rw [clean_hybrid_memory_factor_split, Complex.ofReal_mul, map_mul, Complex.conj_ofReal]
  ring
end

section
open Finset
open scoped Classical
noncomputable def cleanHybridSmallForm {S G : Type*} [Fintype S] [DecidableEq S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vs : S → ℝ) (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ)
    (C : G → Finset (Fin J)) (q ζ θ ρ : ℝ) (k : ℤ) (B : G → ℕ)
    (p : FixedOrderedMemoryLabels Pb N) (rs : PhysicalResidues Ps) (rm : FixedOrderedResidues p)
    (auxs : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))))
    (auxb : PhysicalAuxLabels Pb C) (source target : RepeatedBigLists Pb J ell)
    (K : RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb C → ℂ)
    (f : PhysicalMarkLists Ps J ell → ℂ)
    (g : PhysicalResidues Ps → FixedOrderedResidues p → PhysicalMarkLists Ps J ell → ℂ) : ℂ :=
  let step := cleanHybridStep k C source auxb
  let κ := fun d : PhysicalSharedLists Ps J =>
    cleanHybridBetweenKernel Vb b C ζ θ ρ k B p rm K d auxb source target
  ∑ L, ∑ R, (physicalStateMass Vs J ell : ℂ) * (starRingEnd ℂ) (f L) *
    physicalBarePatternScalar Vs (fun _ => (∅ : Finset (Fin J))) ζ
      (fun L _ _ => κ (physicalSharedPrefix L)) auxs L R *
    ((physicalResidueVertexWeight L (Real.sqrt q) rs *
      physicalResidueVertexWeight R (Real.sqrt q)
        (physicalTranslateResidues rs (step (physicalSharedPrefix L))) : ℝ) : ℂ) *
    g (physicalTranslateResidues rs (step (physicalSharedPrefix L)))
      (fixedOrderedResidueTranslate p rm (step (physicalSharedPrefix L))) R

/-- Big active source labels are integrated against the actual tilted product
law. The auxiliary mass and fresh target law are in the between-kernel. -/
noncomputable def cleanHybridForm {S G : Type*} [Fintype S] [DecidableEq S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vs : S → ℝ) (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ)
    (C : G → Finset (Fin J)) (q ζ θ ρ : ℝ) (k : ℤ) (B : G → ℕ)
    (p : FixedOrderedMemoryLabels Pb N) (rs : PhysicalResidues Ps) (rm : FixedOrderedResidues p)
    (auxs : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))))
    (K : RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb C → ℂ)
    (w₁ w₂ : RepeatedBigLists Pb J ell → PhysicalResidues Ps → FixedOrderedResidues p →
      PhysicalMarkLists Ps J ell → ℂ) : ℂ :=
  ∑ source, ∑ auxb, ∑ target, (repeatedBigActiveMass Vb b source : ℂ) *
    cleanHybridSmallForm Vs Vb b C q ζ θ ρ k B p rs rm auxs auxb source target K
      (w₁ source rs rm) (w₂ target)

/-- Conditioned target action for one fixed small shared prefix. The same
physical displacement translates all small and pending residue coordinates. -/
noncomputable def cleanHybridConditionedTarget {S G : Type*} [Fintype S] [DecidableEq S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vs : S → ℝ) (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ)
    (C : G → Finset (Fin J)) (q ζ θ ρ : ℝ) (k : ℤ) (B : G → ℕ)
    (p : FixedOrderedMemoryLabels Pb N) (rs : PhysicalResidues Ps) (rm : FixedOrderedResidues p)
    (K : RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb C → ℂ)
    (w : RepeatedBigLists Pb J ell → PhysicalResidues Ps → FixedOrderedResidues p →
      PhysicalMarkLists Ps J ell → ℂ)
    (d : PhysicalSharedLists Ps J) (source : RepeatedBigLists Pb J ell) : ℂ :=
  ∑ auxb, ∑ target,
    (cleanHybridBetweenKernel Vb b C ζ θ ρ k B p rm K d auxb source target *
      physicalPhase ζ (physicalSharedProduct d)) *
    physicalSmallCondition Vs q (physicalTranslateResidues rs (cleanHybridStep k C source auxb d)) d
      (w target (physicalTranslateResidues rs (cleanHybridStep k C source auxb d))
        (fixedOrderedResidueTranslate p rm (cleanHybridStep k C source auxb d)))

/-- Exact small conditioning for the clean hybrid form. No operator norm,
Fourier reduction, symmetry assumption, or birth-distinctness claim is hidden
in this finite identity. -/
theorem clean_hybrid_form_conditioning {S G : Type*}
    [Fintype S] [DecidableEq S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vs : S → ℝ) (hVs : ∀ s, 0 < Vs s) (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ)
    (C : G → Finset (Fin J)) (q ζ θ ρ : ℝ) (k : ℤ) (B : G → ℕ)
    (p : FixedOrderedMemoryLabels Pb N) (rs : PhysicalResidues Ps) (rm : FixedOrderedResidues p)
    (auxs : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))))
    (K : RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb C → ℂ)
    (w₁ w₂ : RepeatedBigLists Pb J ell → PhysicalResidues Ps → FixedOrderedResidues p →
      PhysicalMarkLists Ps J ell → ℂ) :
    cleanHybridForm Vs Vb b C q ζ θ ρ k B p rs rm auxs K w₁ w₂ =
      ∑ d, ∑ source, (repeatedBigActiveMass Vb b source : ℂ) *
        (starRingEnd ℂ) (physicalSmallCondition Vs q rs d (w₁ source rs rm)) *
        cleanHybridConditionedTarget Vs Vb b C q ζ θ ρ k B p rs rm K w₂ d source := by
  classical
  refine finite_conditioned_bilinear_sum
    (fun source => (repeatedBigActiveMass Vb b source : ℂ))
    (fun source auxb target => cleanHybridSmallForm Vs Vb b C q ζ θ ρ k B p rs rm
      auxs auxb source target K (w₁ source rs rm) (w₂ target))
    (fun source d => (starRingEnd ℂ) (physicalSmallCondition Vs q rs d (w₁ source rs rm)))
    (fun source auxb target d =>
      (cleanHybridBetweenKernel Vb b C ζ θ ρ k B p rm K d auxb source target *
        physicalPhase ζ (physicalSharedProduct d)) *
      physicalSmallCondition Vs q (physicalTranslateResidues rs (cleanHybridStep k C source auxb d)) d
        (w₂ target (physicalTranslateResidues rs (cleanHybridStep k C source auxb d))
          (fixedOrderedResidueTranslate p rm (cleanHybridStep k C source auxb d)))) ?_
  intro source auxb target
  have h := clean_hybrid_fixed_big_factorization Vs hVs Vb b C q ζ θ ρ k B p rs rm
    auxs auxb source target K (w₁ source rs rm) (w₂ target)
  exact h.trans (sum_congr rfl (fun d _ => mul_assoc _ _ _))
end

section
open scoped BigOperators InnerProductSpace
noncomputable def finiteMeasureVector {X : Type*} (μ : X → ℝ) (f : X → ℂ) :
    EuclideanSpace ℂ X := WithLp.toLp 2 (fun x => (Real.sqrt (μ x) : ℂ) * f x)

theorem finite_measure_vector_apply {X : Type*} (μ : X → ℝ) (f : X → ℂ) (x : X) :
    finiteMeasureVector μ f x = (Real.sqrt (μ x) : ℂ) * f x := rfl

theorem finite_measure_vector_norm_sq {X : Type*} [Fintype X]
    (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (f : X → ℂ) :
    ‖finiteMeasureVector μ f‖ ^ 2 = ∑ x, μ x * ‖f x‖ ^ 2 := by
  rw [EuclideanSpace.norm_sq_eq]
  apply Finset.sum_congr rfl
  intro x _
  rw [finite_measure_vector_apply, norm_mul, mul_pow, Complex.norm_real,
    Real.norm_eq_abs, abs_of_nonneg (Real.sqrt_nonneg _), Real.sq_sqrt (hμ x)]

theorem finite_measure_vector_inner {X : Type*} [Fintype X]
    (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (f g : X → ℂ) :
    inner ℂ (finiteMeasureVector μ f) (finiteMeasureVector μ g) =
      ∑ x, (μ x : ℂ) * (starRingEnd ℂ) (f x) * g x := by
  rw [PiLp.inner_apply]
  apply Finset.sum_congr rfl
  intro x _
  simp only [finite_measure_vector_apply, RCLike.inner_apply, map_mul,
    Complex.conj_ofReal]
  have hs : (Real.sqrt (μ x) : ℂ) * Real.sqrt (μ x) = (μ x : ℂ) := by
    rw [← Complex.ofReal_mul, Real.mul_self_sqrt (hμ x)]
  calc
    _ = ((Real.sqrt (μ x) : ℂ) * Real.sqrt (μ x)) * (starRingEnd ℂ) (f x) * g x := by ring
    _ = _ := by rw [hs]

noncomputable def finiteMeasureFrameKernel {X I : Type*} [Fintype I]
    (ψ : I → X → ℂ) (x y : X) : ℂ :=
  ∑ i, ψ i x * (starRingEnd ℂ) (ψ i y)

noncomputable def finiteMeasureFrameAction {X I : Type*} [Fintype X] [Fintype I]
    (μ : X → ℝ) (ψ : I → X → ℂ) (f : X → ℂ) (x : X) : ℂ :=
  ∑ y, (μ y : ℂ) * finiteMeasureFrameKernel ψ x y * f y

theorem finite_measure_frame_vector {X I : Type*} [Fintype X] [Fintype I]
    (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (ψ : I → X → ℂ) (f : X → ℂ) :
    finiteMeasureVector μ (finiteMeasureFrameAction μ ψ f) =
      ∑ i, inner ℂ (finiteMeasureVector μ (ψ i)) (finiteMeasureVector μ f) •
        finiteMeasureVector μ (ψ i) := by
  apply PiLp.ext
  intro x
  simp only [finite_measure_vector_apply, finiteMeasureFrameAction,
    finiteMeasureFrameKernel, finite_measure_vector_inner μ hμ,
    WithLp.ofLp_sum, Finset.sum_apply, PiLp.smul_apply, smul_eq_mul]
  simp_rw [Finset.mul_sum, Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i _
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro y _
  ring

theorem finite_measure_frame_energy_le {X I : Type*} [Fintype X] [Fintype I]
    (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (ψ : I → X → ℂ) {ε : ℝ} (hε : 0 ≤ ε)
    (hdiag : ∀ i, (∑ x, μ x * ‖ψ i x‖ ^ 2) ≤ 1)
    (hoff : ∀ i j, i ≠ j →
      ‖∑ x, (μ x : ℂ) * (starRingEnd ℂ) (ψ i x) * ψ j x‖ ≤ ε) (f : X → ℂ) :
    (∑ x, μ x * ‖finiteMeasureFrameAction μ ψ f x‖ ^ 2) ≤
      (1 + (Fintype.card I - 1 : ℕ) * ε) ^ 2 * ∑ x, μ x * ‖f x‖ ^ 2 := by
  have h := finite_near_orthogonal_frame_sq (fun i => finiteMeasureVector μ (ψ i)) hε
    (fun i => by simpa only [finite_measure_vector_norm_sq μ hμ] using hdiag i)
    (fun i j hij => by simpa only [finite_measure_vector_inner μ hμ] using hoff i j hij)
    (finiteMeasureVector μ f)
  simpa only [← finite_measure_frame_vector μ hμ, finite_measure_vector_norm_sq μ hμ] using h

theorem finite_probability_frame_energy_le {X I : Type*} [Fintype X] [Fintype I]
    (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (hmass : ∑ x, μ x = 1)
    (ψ : I → X → ℂ) (hunit : ∀ i x, μ x ≠ 0 → ‖ψ i x‖ = 1)
    {ε : ℝ} (hε : 0 ≤ ε)
    (hoff : ∀ i j, i ≠ j →
      ‖∑ x, (μ x : ℂ) * (starRingEnd ℂ) (ψ i x) * ψ j x‖ ≤ ε) (f : X → ℂ) :
    (∑ x, μ x * ‖finiteMeasureFrameAction μ ψ f x‖ ^ 2) ≤
      (1 + (Fintype.card I - 1 : ℕ) * ε) ^ 2 * ∑ x, μ x * ‖f x‖ ^ 2 := by
  apply finite_measure_frame_energy_le μ hμ ψ hε _ hoff f
  intro i
  calc
    _ = ∑ x, μ x := by
      apply Finset.sum_congr rfl
      intro x _
      by_cases hx : μ x = 0
      · simp [hx]
      · rw [hunit i x hx, one_pow, mul_one]
    _ ≤ 1 := hmass.le
end

section
open scoped BigOperators Classical
noncomputable def finiteCellMass {X D : Type*} [Fintype X] [DecidableEq D]
    (μ : X → ℝ) (cell : X → D) (d : D) : ℝ :=
  ∑ x, if cell x = d then μ x else 0

noncomputable def finiteCellLaw {X D : Type*} [Fintype X] [DecidableEq D]
    (μ : X → ℝ) (cell : X → D) (d : D) (x : X) : ℝ :=
  if cell x = d then μ x / finiteCellMass μ cell d else 0

theorem finite_cell_mass_nonneg {X D : Type*} [Fintype X] [DecidableEq D]
    (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (cell : X → D) (d : D) :
    0 ≤ finiteCellMass μ cell d := by
  apply Finset.sum_nonneg
  intro x _
  split_ifs
  · exact hμ x
  · exact le_rfl

theorem finite_cell_law_nonneg {X D : Type*} [Fintype X] [DecidableEq D]
    (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (cell : X → D) (d : D) (x : X) :
    0 ≤ finiteCellLaw μ cell d x := by
  unfold finiteCellLaw
  split_ifs
  · exact div_nonneg (hμ x) (finite_cell_mass_nonneg μ hμ cell d)
  · exact le_rfl

theorem finite_cell_law_mass {X D : Type*} [Fintype X] [DecidableEq D]
    (μ : X → ℝ) (cell : X → D) (d : D) (hd : finiteCellMass μ cell d ≠ 0) :
    (∑ x, finiteCellLaw μ cell d x) = 1 := by
  calc
    _ = (∑ x, if cell x = d then μ x else 0) / finiteCellMass μ cell d := by
      rw [Finset.sum_div]
      apply Finset.sum_congr rfl
      intro x _
      unfold finiteCellLaw
      split_ifs <;> simp
    _ = 1 := div_self hd

theorem finite_cell_expectation_scale {X D : Type*} [Fintype X] [DecidableEq D]
    (μ : X → ℝ) (cell : X → D) (d : D) (hd : finiteCellMass μ cell d ≠ 0)
    (F : X → ℝ) :
    finiteCellMass μ cell d * (∑ x, finiteCellLaw μ cell d x * F x) =
      ∑ x, if cell x = d then μ x * F x else 0 := by
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro x _
  unfold finiteCellLaw
  by_cases hx : cell x = d
  · simp only [if_pos hx]
    field_simp
  · simp only [if_neg hx, mul_zero, zero_mul]

noncomputable def finiteCellFrameAction {X D I : Type*} [Fintype X] [Fintype I]
    [DecidableEq D] (μ : X → ℝ) (cell : X → D) (kept : Finset D)
    (ψ : I → X → ℂ) (f : X → ℂ) (x : X) : ℂ :=
  if cell x ∈ kept then finiteMeasureFrameAction (finiteCellLaw μ cell (cell x)) ψ f x else 0

theorem finite_cell_frame_energy_partition {X D I : Type*} [Fintype X] [Fintype I]
    [DecidableEq D] (μ : X → ℝ) (cell : X → D) (kept : Finset D)
    (ψ : I → X → ℂ) (f : X → ℂ) :
    (∑ x, μ x * ‖finiteCellFrameAction μ cell kept ψ f x‖ ^ 2) =
      ∑ d ∈ kept, ∑ x, if cell x = d then
        μ x * ‖finiteMeasureFrameAction (finiteCellLaw μ cell d) ψ f x‖ ^ 2 else 0 := by
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro x _
  unfold finiteCellFrameAction
  by_cases hx : cell x ∈ kept
  · rw [if_pos hx, Finset.sum_eq_single (cell x)]
    · simp
    · intro d _ hd
      simp [Ne.symm hd]
    · exact fun h => (h hx).elim
  · rw [if_neg hx]
    simp only [norm_zero, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow, mul_zero]
    symm
    apply Finset.sum_eq_zero
    intro d hd
    have he : cell x ≠ d := by intro he; exact hx (he ▸ hd)
    simp [he]

theorem finite_cell_frame_energy_le {X D I : Type*} [Fintype X] [Fintype I]
    [DecidableEq D] (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (cell : X → D) (kept : Finset D)
    (hkept : ∀ d ∈ kept, 0 < finiteCellMass μ cell d)
    (ψ : I → X → ℂ) (hunit : ∀ i x, μ x ≠ 0 → ‖ψ i x‖ = 1)
    {ε : ℝ} (hε : 0 ≤ ε)
    (hoff : ∀ d ∈ kept, ∀ i j, i ≠ j →
      ‖∑ x, (finiteCellLaw μ cell d x : ℂ) * (starRingEnd ℂ) (ψ i x) * ψ j x‖ ≤ ε)
    (f : X → ℂ) :
    (∑ x, μ x * ‖finiteCellFrameAction μ cell kept ψ f x‖ ^ 2) ≤
      (1 + (Fintype.card I - 1 : ℕ) * ε) ^ 2 * ∑ x, μ x * ‖f x‖ ^ 2 := by
  let B : ℝ := (1 + (Fintype.card I - 1 : ℕ) * ε) ^ 2
  have hB : 0 ≤ B := sq_nonneg _
  have hlocal (d : D) (hd : d ∈ kept) :
      (∑ x, if cell x = d then μ x * ‖finiteMeasureFrameAction (finiteCellLaw μ cell d) ψ f x‖ ^ 2 else 0) ≤
      B * ∑ x, if cell x = d then μ x * ‖f x‖ ^ 2 else 0 := by
    have hn : finiteCellMass μ cell d ≠ 0 := (hkept d hd).ne'
    have hc := finite_probability_frame_energy_le (finiteCellLaw μ cell d)
      (finite_cell_law_nonneg μ hμ cell d) (finite_cell_law_mass μ cell d hn) ψ
      (fun i x hx => hunit i x (by
        intro hz
        simp [finiteCellLaw, hz] at hx)) hε (hoff d hd) f
    have hm := mul_le_mul_of_nonneg_left hc (hkept d hd).le
    rw [finite_cell_expectation_scale μ cell d hn] at hm
    calc
      _ ≤ finiteCellMass μ cell d * (B * ∑ x, finiteCellLaw μ cell d x * ‖f x‖ ^ 2) := hm
      _ = B * (finiteCellMass μ cell d * ∑ x, finiteCellLaw μ cell d x * ‖f x‖ ^ 2) := by ring
      _ = _ := by rw [finite_cell_expectation_scale μ cell d hn]
  rw [finite_cell_frame_energy_partition]
  calc
    _ ≤ ∑ d ∈ kept, B * ∑ x, if cell x = d then μ x * ‖f x‖ ^ 2 else 0 :=
      Finset.sum_le_sum hlocal
    _ = B * ∑ x, ∑ d ∈ kept, if cell x = d then μ x * ‖f x‖ ^ 2 else 0 := by
      rw [← Finset.mul_sum, Finset.sum_comm]
    _ ≤ B * ∑ x, μ x * ‖f x‖ ^ 2 := by
      apply mul_le_mul_of_nonneg_left _ hB
      apply Finset.sum_le_sum
      intro x _
      by_cases hx : cell x ∈ kept
      · simp [Finset.sum_ite_eq, hx]
      · simp [Finset.sum_ite_eq, hx, mul_nonneg (hμ x) (sq_nonneg _)]
end

section
open scoped BigOperators Classical
noncomputable def finiteCellFrameKernel {X D I : Type*} [Fintype X] [Fintype I]
    [DecidableEq D] (μ : X → ℝ) (cell : X → D) (kept : Finset D)
    (ψ : I → X → ℂ) (x y : X) : ℂ :=
  if cell x = cell y ∧ cell x ∈ kept then
    ((1 / finiteCellMass μ cell (cell x) : ℝ) : ℂ) * finiteMeasureFrameKernel ψ x y else 0

theorem finite_cell_kernel_action {X D I : Type*} [Fintype X] [Fintype I]
    [DecidableEq D] (μ : X → ℝ) (cell : X → D) (kept : Finset D)
    (ψ : I → X → ℂ) (f : X → ℂ) (x : X) :
    (∑ y, (μ y : ℂ) * finiteCellFrameKernel μ cell kept ψ x y * f y) =
      finiteCellFrameAction μ cell kept ψ f x := by
  unfold finiteCellFrameAction
  by_cases hx : cell x ∈ kept
  · rw [if_pos hx]
    unfold finiteMeasureFrameAction
    apply Finset.sum_congr rfl
    intro y _
    by_cases hxy : cell x = cell y
    · simp only [finiteCellFrameKernel, if_pos (And.intro hxy hx),
        finiteCellLaw, if_pos hxy.symm]
      push_cast
      ring
    · simp only [finiteCellFrameKernel, hxy, false_and, if_false,
        finiteCellLaw, if_neg (Ne.symm hxy), Complex.ofReal_zero, mul_zero, zero_mul]
  · rw [if_neg hx]
    apply Finset.sum_eq_zero
    intro y _
    simp [finiteCellFrameKernel, hx]

theorem finite_cell_kernel_energy_le {X D I : Type*} [Fintype X] [Fintype I]
    [DecidableEq D] (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (cell : X → D) (kept : Finset D)
    (hkept : ∀ d ∈ kept, 0 < finiteCellMass μ cell d)
    (ψ : I → X → ℂ) (hunit : ∀ i x, μ x ≠ 0 → ‖ψ i x‖ = 1)
    {ε : ℝ} (hε : 0 ≤ ε)
    (hoff : ∀ d ∈ kept, ∀ i j, i ≠ j →
      ‖∑ x, (finiteCellLaw μ cell d x : ℂ) * (starRingEnd ℂ) (ψ i x) * ψ j x‖ ≤ ε)
    (f : X → ℂ) :
    (∑ x, μ x * ‖∑ y, (μ y : ℂ) * finiteCellFrameKernel μ cell kept ψ x y * f y‖ ^ 2) ≤
      (1 + (Fintype.card I - 1 : ℕ) * ε) ^ 2 * ∑ x, μ x * ‖f x‖ ^ 2 := by
  simp only [finite_cell_kernel_action]
  exact finite_cell_frame_energy_le μ hμ cell kept hkept ψ hunit hε hoff f

theorem finite_cell_kernel_energy_le_four {X D I : Type*} [Fintype X] [Fintype I]
    [DecidableEq D] (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (cell : X → D) (kept : Finset D)
    (hkept : ∀ d ∈ kept, 0 < finiteCellMass μ cell d)
    (ψ : I → X → ℂ) (hunit : ∀ i x, μ x ≠ 0 → ‖ψ i x‖ = 1)
    {ε : ℝ} (hε : 0 ≤ ε) (hsmall : (Fintype.card I - 1 : ℕ) * ε ≤ 1)
    (hoff : ∀ d ∈ kept, ∀ i j, i ≠ j →
      ‖∑ x, (finiteCellLaw μ cell d x : ℂ) * (starRingEnd ℂ) (ψ i x) * ψ j x‖ ≤ ε)
    (f : X → ℂ) :
    (∑ x, μ x * ‖∑ y, (μ y : ℂ) * finiteCellFrameKernel μ cell kept ψ x y * f y‖ ^ 2) ≤
      4 * ∑ x, μ x * ‖f x‖ ^ 2 := by
  have hb : (1 + (Fintype.card I - 1 : ℕ) * ε) ^ 2 ≤ 4 := by
    have hnonneg : 0 ≤ (Fintype.card I - 1 : ℕ) * ε := by positivity
    nlinarith
  exact (finite_cell_kernel_energy_le μ hμ cell kept hkept ψ hunit hε hoff f).trans
    (mul_le_mul_of_nonneg_right hb (Finset.sum_nonneg (fun x _ => mul_nonneg (hμ x) (sq_nonneg _))))

theorem finite_measure_frame_kernel_norm_le {X I : Type*} [Fintype I]
    (ψ : I → X → ℂ) (hψ : ∀ i x, ‖ψ i x‖ ≤ 1) (x y : X) :
    ‖finiteMeasureFrameKernel ψ x y‖ ≤ Fintype.card I := by
  calc
    _ ≤ ∑ i, ‖ψ i x * (starRingEnd ℂ) (ψ i y)‖ := norm_sum_le _ _
    _ ≤ ∑ _i : I, (1 : ℝ) := by
      apply Finset.sum_le_sum
      intro i _
      rw [norm_mul, Complex.norm_conj]
      exact mul_le_one₀ (hψ i x) (norm_nonneg _) (hψ i y)
    _ = _ := by simp

theorem finite_cell_kernel_norm_le {X D I : Type*} [Fintype X] [Fintype I]
    [DecidableEq D] (μ : X → ℝ) (cell : X → D) (kept : Finset D)
    (ψ : I → X → ℂ) (hψ : ∀ i x, ‖ψ i x‖ ≤ 1)
    {ξ : ℝ} (hξ : 0 < ξ) (hkept : ∀ d ∈ kept, ξ ≤ finiteCellMass μ cell d) (x y : X) :
    ‖finiteCellFrameKernel μ cell kept ψ x y‖ ≤ (Fintype.card I : ℝ) / ξ := by
  unfold finiteCellFrameKernel
  split_ifs with h
  · have hpos := lt_of_lt_of_le hξ (hkept _ h.2)
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (one_div_pos.mpr hpos)]
    calc
      _ ≤ (1 / finiteCellMass μ cell (cell x)) * Fintype.card I :=
        mul_le_mul_of_nonneg_left (finite_measure_frame_kernel_norm_le ψ hψ x y) (by positivity)
      _ = (Fintype.card I : ℝ) / finiteCellMass μ cell (cell x) := by ring
      _ ≤ _ := div_le_div_of_nonneg_left (Nat.cast_nonneg _) hξ (hkept _ h.2)
  · simp only [norm_zero]
    positivity


theorem finite_cell_kernel_conj {X D I : Type*} [Fintype X] [Fintype I]
    [DecidableEq D] (μ : X → ℝ) (cell : X → D) (kept : Finset D)
    (ψ : I → X → ℂ) (x y : X) :
    (starRingEnd ℂ) (finiteCellFrameKernel μ cell kept ψ x y) =
      finiteCellFrameKernel μ cell kept ψ y x := by
  by_cases h : cell x = cell y
  · unfold finiteCellFrameKernel
    rw [h]
    by_cases hy : cell y ∈ kept
    · simp only [eq_self, true_and, if_pos hy, map_mul, Complex.conj_ofReal]
      congr 1
      unfold finiteMeasureFrameKernel
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro i _
      simp only [map_mul, Complex.conj_conj]
      ring
    · simp only [eq_self, true_and, if_neg hy, map_zero]
  · simp only [finiteCellFrameKernel, h, Ne.symm h, false_and, if_false, map_zero]

theorem finite_cell_kernel_abs_row_le {X D I : Type*} [Fintype X] [Fintype I]
    [DecidableEq D] (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (cell : X → D) (kept : Finset D)
    (hkept : ∀ d ∈ kept, 0 < finiteCellMass μ cell d)
    (ψ : I → X → ℂ) (hψ : ∀ i x, ‖ψ i x‖ ≤ 1) (x : X) :
    (∑ y, μ y * ‖finiteCellFrameKernel μ cell kept ψ x y‖) ≤ Fintype.card I := by
  by_cases hx : cell x ∈ kept
  · have hpos := hkept _ hx
    have he (y : X) : μ y * ‖finiteCellFrameKernel μ cell kept ψ x y‖ =
        finiteCellLaw μ cell (cell x) y * ‖finiteMeasureFrameKernel ψ x y‖ := by
      by_cases hxy : cell x = cell y
      · simp only [finiteCellFrameKernel, if_pos (And.intro hxy hx), finiteCellLaw,
          if_pos hxy.symm, norm_mul, Complex.norm_real, Real.norm_eq_abs,
          abs_of_pos (one_div_pos.mpr hpos)]
        ring
      · simp only [finiteCellFrameKernel, hxy, false_and, if_false, finiteCellLaw,
          if_neg (Ne.symm hxy), norm_zero, mul_zero, zero_mul]
    simp_rw [he]
    calc
      _ ≤ ∑ y, finiteCellLaw μ cell (cell x) y * (Fintype.card I : ℝ) :=
        Finset.sum_le_sum (fun y _ => mul_le_mul_of_nonneg_left
          (finite_measure_frame_kernel_norm_le ψ hψ x y) (finite_cell_law_nonneg μ hμ cell _ y))
      _ = Fintype.card I := by
        rw [← Finset.sum_mul, finite_cell_law_mass μ cell _ hpos.ne', one_mul]
  · simp [finiteCellFrameKernel, hx]

theorem finite_cell_kernel_abs_column_le {X D I : Type*} [Fintype X] [Fintype I]
    [DecidableEq D] (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (cell : X → D) (kept : Finset D)
    (hkept : ∀ d ∈ kept, 0 < finiteCellMass μ cell d)
    (ψ : I → X → ℂ) (hψ : ∀ i x, ‖ψ i x‖ ≤ 1) (y : X) :
    (∑ x, μ x * ‖finiteCellFrameKernel μ cell kept ψ x y‖) ≤ Fintype.card I := by
  have hn (x : X) : ‖finiteCellFrameKernel μ cell kept ψ x y‖ =
      ‖finiteCellFrameKernel μ cell kept ψ y x‖ := by
    rw [← finite_cell_kernel_conj μ cell kept ψ y x, Complex.norm_conj]
  simp_rw [hn]
  exact finite_cell_kernel_abs_row_le μ hμ cell kept hkept ψ hψ y
end

section
open scoped BigOperators Classical
theorem finite_cell_gram_scale {X D I : Type*} [Fintype X] [DecidableEq D]
    (μ : X → ℝ) (cell : X → D) (d : D) (ψ : I → X → ℂ) (i j : I) :
    (∑ x, (finiteCellLaw μ cell d x : ℂ) * (starRingEnd ℂ) (ψ i x) * ψ j x) =
      ((1 / finiteCellMass μ cell d : ℝ) : ℂ) *
        ∑ x, if cell x = d then (μ x : ℂ) * (starRingEnd ℂ) (ψ i x) * ψ j x else 0 := by
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro x _
  by_cases hx : cell x = d
  · simp only [finiteCellLaw, if_pos hx]
    push_cast
    ring
  · simp only [finiteCellLaw, if_neg hx, Complex.ofReal_zero, zero_mul, mul_zero]

theorem finite_cell_gram_norm_le {X D I : Type*} [Fintype X] [DecidableEq D]
    (μ : X → ℝ) (cell : X → D) (d : D) (ψ : I → X → ℂ) (i j : I)
    {δ ξ : ℝ} (hδ : 0 ≤ δ) (hξ : 0 < ξ) (hd : ξ ≤ finiteCellMass μ cell d)
    (hraw : ‖∑ x, if cell x = d then (μ x : ℂ) * (starRingEnd ℂ) (ψ i x) * ψ j x else 0‖ ≤ δ) :
    ‖∑ x, (finiteCellLaw μ cell d x : ℂ) * (starRingEnd ℂ) (ψ i x) * ψ j x‖ ≤ δ / ξ := by
  have hpos : 0 < finiteCellMass μ cell d := hξ.trans_le hd
  rw [finite_cell_gram_scale, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos (one_div_pos.mpr hpos)]
  calc
    _ ≤ (1 / finiteCellMass μ cell d) * δ := mul_le_mul_of_nonneg_left hraw (by positivity)
    _ = δ / finiteCellMass μ cell d := by ring
    _ ≤ δ / ξ := div_le_div_of_nonneg_left hδ hξ hd

theorem finite_cell_kernel_energy_of_raw_gram {X D I : Type*} [Fintype X] [Fintype I]
    [DecidableEq D] (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (cell : X → D) (kept : Finset D)
    {δ ξ : ℝ} (hδ : 0 ≤ δ) (hξ : 0 < ξ)
    (hkept : ∀ d ∈ kept, ξ ≤ finiteCellMass μ cell d)
    (ψ : I → X → ℂ) (hunit : ∀ i x, μ x ≠ 0 → ‖ψ i x‖ = 1)
    (hsmall : (Fintype.card I - 1 : ℕ) * (δ / ξ) ≤ 1)
    (hraw : ∀ d ∈ kept, ∀ i j, i ≠ j →
      ‖∑ x, if cell x = d then (μ x : ℂ) * (starRingEnd ℂ) (ψ i x) * ψ j x else 0‖ ≤ δ)
    (f : X → ℂ) :
    (∑ x, μ x * ‖∑ y, (μ y : ℂ) * finiteCellFrameKernel μ cell kept ψ x y * f y‖ ^ 2) ≤
      4 * ∑ x, μ x * ‖f x‖ ^ 2 := by
  apply finite_cell_kernel_energy_le_four μ hμ cell kept
    (fun d hd => hξ.trans_le (hkept d hd)) ψ hunit (div_nonneg hδ hξ.le) hsmall _ f
  intro d hd i j hij
  exact finite_cell_gram_norm_le μ cell d ψ i j hδ hξ (hkept d hd) (hraw d hd i j hij)
end

section
open Filter
open scoped Topology
/-- The quotient of two powers tends to zero when the numerator has lower exponent. -/
theorem tendsto_rpow_div_rpow {a b : ℝ} (hab : a < b) :
    Tendsto (fun y : ℝ => y ^ a / y ^ b) atTop (𝓝 0) := by
  refine (tendsto_rpow_neg_atTop (sub_pos.mpr hab)).congr' ?_
  filter_upwards [eventually_gt_atTop (0 : ℝ)] with y hy
  rw [neg_sub, Real.rpow_sub hy]

/-- A positive higher power eventually absorbs a fixed multiple of a smaller power
and a fixed additive constant. -/
theorem eventually_mul_rpow_add_le_mul_rpow {a b c : ℝ}
    (hb : 0 < b) (hab : a < b) (hc : 0 < c) (D k : ℝ) :
    ∀ᶠ y : ℝ in atTop, D * y ^ a + k ≤ c * y ^ b := by
  have hlim : Tendsto (fun y : ℝ => (D * y ^ a + k) / y ^ b) atTop (𝓝 0) := by
    have h := ((tendsto_rpow_div_rpow hab).const_mul D).add
      ((tendsto_rpow_atTop hb).const_div_atTop k)
    have heq : (fun y : ℝ => (D * y ^ a + k) / y ^ b) =
        (fun y : ℝ => D * (y ^ a / y ^ b) + k / y ^ b) := by
      funext y
      ring
    rw [heq]
    simpa only [mul_zero, zero_add] using h
  filter_upwards [hlim.eventually_le_const hc, eventually_gt_atTop (0 : ℝ)] with y hy hy0
  exact (div_le_iff₀ (Real.rpow_pos_of_pos hy0 b)).mp hy

/-- The Fourier error condition, uniformly for every allowed real cutoff `R`. -/
theorem eventually_fourier_sampling_gap {d r η K : ℝ}
    (hd : 0 ≤ d) (hr : 0 ≤ r) (hgap : 2 * d + 2 * r < η) :
    ∀ᶠ y : ℝ in atTop, ∀ R : ℝ, 0 < R → R ≤ K * y ^ r →
      y ^ d + Real.log 4 ≤ y ^ η / (200 * y ^ d * R ^ 2) := by
  have hη : 0 < η := by linarith
  have hlim := eventually_mul_rpow_add_le_mul_rpow hη hgap
    (show (0 : ℝ) < 1 by norm_num) (200 * (1 + Real.log 4) * K ^ 2) 0
  filter_upwards [hlim, eventually_ge_atTop (1 : ℝ)] with y hy hy1
  have hy0 : 0 < y := lt_of_lt_of_le zero_lt_one hy1
  have hyd : 1 ≤ y ^ d := Real.one_le_rpow hy1 hd
  have hyr : 0 < y ^ r := Real.rpow_pos_of_pos hy0 r
  have hlog : 0 ≤ Real.log 4 := Real.log_nonneg (by norm_num)
  have hadd : y ^ d + Real.log 4 ≤ (1 + Real.log 4) * y ^ d := by
    nlinarith [mul_le_mul_of_nonneg_left hyd hlog]
  intro R hR hbound
  apply (le_div_iff₀ (by positivity : 0 < 200 * y ^ d * R ^ 2)).mpr
  calc
    (y ^ d + Real.log 4) * (200 * y ^ d * R ^ 2) ≤
        ((1 + Real.log 4) * y ^ d) * (200 * y ^ d * (K * y ^ r) ^ 2) := by
      gcongr
    _ = (200 * (1 + Real.log 4) * K ^ 2) * y ^ (2 * d + 2 * r) := by
      rw [Real.rpow_add hy0]
      have heqd : y ^ (2 * d) = (y ^ d) ^ (2 : ℕ) := by
        rw [mul_comm (2 : ℝ) d, Real.rpow_mul hy0.le]
        exact Real.rpow_natCast _ 2
      have heqr : y ^ (2 * r) = (y ^ r) ^ (2 : ℕ) := by
        rw [mul_comm (2 : ℝ) r, Real.rpow_mul hy0.le]
        exact Real.rpow_natCast _ 2
      rw [heqd, heqr]
      ring
    _ ≤ y ^ η := by simpa only [add_zero, one_mul] using hy

/-- The Chernoff exponent eventually absorbs the group-size term. -/
theorem eventually_chernoff_sampling_gap {d η ν : ℝ}
    (hη : 0 < η) (hdη : d < η) (hν : 0 < ν) :
    ∀ᶠ y : ℝ in atTop, y ^ d + Real.log 8 ≤ ν ^ 2 * y ^ η / 4 := by
  have hlim := eventually_mul_rpow_add_le_mul_rpow hη hdη
    (show 0 < ν ^ 2 / 4 by positivity) 1 (Real.log 8)
  filter_upwards [hlim] with y hy
  simpa only [one_mul, div_mul_eq_mul_div] using hy

/-- Any fixed fraction of a positive power eventually exceeds a fixed size. -/
theorem eventually_const_le_mul_rpow {η c : ℝ} (hη : 0 < η) (hc : 0 < c) (m : ℝ) :
    ∀ᶠ y : ℝ in atTop, m ≤ c * y ^ η := by
  filter_upwards [(tendsto_rpow_atTop hη).eventually_ge_atTop (m / c)] with y hy
  simpa only [mul_comm c] using (div_le_iff₀ hc).mp hy

/-- All sampling inequalities hold simultaneously. The Fourier bound is uniform
in the cutoff; no positivity hypothesis on `K` is needed because its bound is
only used for positive `R`. -/
theorem eventually_finite_sampling_feasible {d r η σ ν K : ℝ}
    (hd : 0 ≤ d) (hr : 0 ≤ r) (hgap : 2 * d + 2 * r < η)
    (hησ : η < 1 - σ) (hν0 : 0 < ν) (hν1 : ν < 1) :
    ∀ᶠ y : ℝ in atTop,
      (∀ R : ℝ, 0 < R → R ≤ K * y ^ r →
        y ^ d + Real.log 4 ≤ y ^ η / (200 * y ^ d * R ^ 2)) ∧
      y ^ d + Real.log 8 ≤ ν ^ 2 * y ^ η / 4 ∧
      4 * y ^ η ≤ y ^ (1 - σ) ∧
      2 ≤ (1 - ν) * y ^ η := by
  have hη : 0 < η := by linarith
  have hdη : d < η := by linarith
  have hσ : 0 < 1 - σ := lt_trans hη hησ
  have hsupply := eventually_mul_rpow_add_le_mul_rpow hσ hησ
    (show (0 : ℝ) < 1 by norm_num) 4 0
  filter_upwards [eventually_fourier_sampling_gap hd hr hgap (K := K),
    eventually_chernoff_sampling_gap hη hdη hν0, hsupply,
    eventually_const_le_mul_rpow hη (sub_pos.mpr hν1) 2] with y hF hC hS hm
  exact ⟨hF, hC, by simpa only [add_zero, one_mul] using hS, hm⟩

/-- The group-size contribution is negligible in the entropy exponent. -/
theorem tendsto_rpow_div_rpow_log {d η : ℝ} (hdη : d < η) :
    Tendsto (fun y : ℝ => y ^ d / (y ^ η * Real.log y)) atTop (𝓝 0) := by
  have h := (tendsto_rpow_div_rpow hdη).div_atTop Real.tendsto_log_atTop
  simpa only [div_div] using h
end

section
open Filter
open scoped Topology
/-- Taking logarithms of the finite Bernoulli counting lower bound. -/
theorem log_lower_of_bernoulli_count {C H ρ : ℝ} {k : ℕ}
    (hH : 0 < H) (hρ : 0 < ρ) (hcount : 1 / (2 * H) / ρ ^ k ≤ C) :
    (k : ℝ) * Real.log (1 / ρ) - Real.log (2 * H) ≤ Real.log C := by
  have hbase : 0 < 1 / (2 * H) := by positivity
  have hlog := Real.log_le_log (div_pos hbase (pow_pos hρ k)) hcount
  rw [Real.log_div hbase.ne' (pow_ne_zero k hρ.ne'),
    Real.log_div one_ne_zero (by positivity : 2 * H ≠ 0), Real.log_one,
    Real.log_pow] at hlog
  rw [Real.log_div one_ne_zero hρ.ne', Real.log_one]
  linarith

/-- A generic normalized entropy criterion. The number of choices is controlled
by the retained subset size and reciprocal sampling probability, while group size is negligible. -/
theorem eventual_power_lower_of_entropy_limits
    (C X H ρ t l : ℝ → ℝ) (k : ℝ → ℕ) {a κ d b : ℝ}
    (hpos : ∀ᶠ y in atTop, 0 < X y ∧ 0 < H y ∧ 0 < ρ y ∧ 0 < t y ∧ 0 < l y)
    (hcount : ∀ᶠ y in atTop, 1 / (2 * H y) / ρ y ^ k y ≤ C y)
    (hprob : ∀ᶠ y in atTop, a * l y ≤ Real.log (1 / ρ y))
    (hk : Tendsto (fun y => (k y : ℝ) / t y) atTop (𝓝 κ))
    (hgroup : Tendsto (fun y => Real.log (2 * H y) / (t y * l y)) atTop (𝓝 0))
    (hsize : Tendsto (fun y => Real.log (X y) / (t y * l y)) atTop (𝓝 d))
    (hmargin : b * d < κ * a) :
    ∀ᶠ y in atTop, X y ^ b ≤ C y := by
  have hentropy := ((hk.mul_const a).sub hgroup).sub (hsize.const_mul b)
  have hpositive : 0 < κ * a - 0 - b * d := by linarith
  have hev := hentropy.eventually_const_lt hpositive
  filter_upwards [hpos, hcount, hprob, hev] with y hy hCy hρy he
  obtain ⟨hX, hH, hρ, ht, hl⟩ := hy
  have hC : 0 < C y := lt_of_lt_of_le (by positivity) hCy
  have hlog := log_lower_of_bernoulli_count hH hρ hCy
  have hprob' := mul_le_mul_of_nonneg_left hρy (Nat.cast_nonneg (k y))
  have heq :
      ((k y : ℝ) * (a * l y) - Real.log (2 * H y) - b * Real.log (X y)) /
          (t y * l y) =
        (k y : ℝ) / t y * a - Real.log (2 * H y) / (t y * l y) -
          b * (Real.log (X y) / (t y * l y)) := by
    field_simp
  have hnum : 0 < (k y : ℝ) * (a * l y) - Real.log (2 * H y) - b * Real.log (X y) := by
    apply (div_pos_iff_of_pos_right (mul_pos ht hl)).mp
    rw [heq]
    exact he
  apply (Real.log_le_log_iff (Real.rpow_pos_of_pos hX b) hC).mp
  rw [Real.log_rpow hX]
  linarith

/-- At the Carmichael size scale the logarithmic size has normalized limit `1+ν`. -/
theorem tendsto_log_carmichaelSizeParameter_normalized (η ν : ℝ) :
    Tendsto (fun y => Real.log (carmichaelSizeParameter η ν y) /
      (y ^ η * Real.log y)) atTop (𝓝 (1 + ν)) := by
  have hlog : Tendsto (fun y : ℝ => Real.log 5 / Real.log y) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop Real.tendsto_log_atTop
  have hlim := (hlog.add_const 1).const_mul (1 + ν)
  simp only [zero_add, mul_one] at hlim
  apply hlim.congr'
  filter_upwards [eventually_gt_atTop (1 : ℝ)] with y hy
  have hy0 : 0 < y := by linarith
  have hp : 0 < y ^ η := Real.rpow_pos_of_pos hy0 η
  have hl : 0 < Real.log y := Real.log_pos hy
  unfold carmichaelSizeParameter
  rw [Real.log_rpow (by positivity : 0 < 5 * y),
    Real.log_mul (by norm_num : (5 : ℝ) ≠ 0) hy0.ne']
  field_simp

/-- The floor used for the minimum selected size has the expected normalized limit. -/
theorem tendsto_floor_subset_size_ratio {η ν : ℝ} (hη : 0 < η) (hν : ν ≤ 1) :
    Tendsto (fun y : ℝ => (⌊(1 - ν) * y ^ η⌋₊ : ℝ) / y ^ η)
      atTop (𝓝 (1 - ν)) :=
  (tendsto_nat_floor_mul_div_atTop (sub_nonneg.mpr hν)).comp (tendsto_rpow_atTop hη)

/-- A power-sized reservoir supplies the required reciprocal sampling entropy. -/
theorem log_reciprocal_sampling_lower {y η σ n : ℝ} (hy : 0 < y)
    (hn : y ^ (1 - σ) ≤ n) :
    (1 - η - σ) * Real.log y ≤ Real.log (1 / (y ^ η / n)) := by
  have hnpos : 0 < n := lt_of_lt_of_le (Real.rpow_pos_of_pos hy _) hn
  have htpos : 0 < y ^ η := Real.rpow_pos_of_pos hy _
  have hlog := Real.log_le_log (Real.rpow_pos_of_pos hy _) hn
  rw [Real.log_rpow hy] at hlog
  rw [Real.log_div one_ne_zero (div_ne_zero htpos.ne' hnpos.ne'), Real.log_one,
    Real.log_div htpos.ne' hnpos.ne', Real.log_rpow hy]
  linarith

/-- A fixed factor of two does not affect a negligible normalized logarithmic group size. -/
theorem tendsto_log_two_mul_normalized {η : ℝ} (hη : 0 < η) (H : ℝ → ℝ)
    (hH : ∀ᶠ y in atTop, 0 < H y)
    (hgroup : Tendsto (fun y => Real.log (H y) / (y ^ η * Real.log y)) atTop (𝓝 0)) :
    Tendsto (fun y => Real.log (2 * H y) / (y ^ η * Real.log y)) atTop (𝓝 0) := by
  have hscale : Tendsto (fun y : ℝ => y ^ η * Real.log y) atTop atTop :=
    (tendsto_rpow_atTop hη).atTop_mul_atTop₀ Real.tendsto_log_atTop
  have hc : Tendsto (fun y : ℝ => Real.log 2 / (y ^ η * Real.log y)) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop hscale
  have hlim := hc.add hgroup
  simp only [add_zero] at hlim
  apply hlim.congr'
  filter_upwards [hH] with y hy
  rw [Real.log_mul (by norm_num : (2 : ℝ) ≠ 0) hy.ne', add_div]

/-- A near-linear reservoir and negligible logarithmic group size turn the finite
entropy count into the desired all-large-X density exponent. -/
theorem eventual_carmichael_power_lower_of_entropy {η ν σ ε : ℝ}
    (hη : 0 < η) (hν0 : 0 ≤ ν) (hν1 : ν ≤ 1)
    (hmargin : 1 - ε < ((1 - ν) / (1 + ν)) * (1 - η - σ))
    (n H : ℝ → ℝ) (hH : ∀ᶠ y in atTop, 0 < H y)
    (hn : ∀ᶠ y in atTop, y ^ (1 - σ) ≤ n y)
    (hgroup : Tendsto (fun y => Real.log (H y) / (y ^ η * Real.log y)) atTop (𝓝 0))
    (hcount : ∀ᶠ y in atTop,
      1 / (2 * H y) / (y ^ η / n y) ^ ⌊(1 - ν) * y ^ η⌋₊ ≤
        Erdos1057.carmichaelCounting (carmichaelSizeParameter η ν y)) :
    ∀ᶠ x in atTop, x ^ (1 - ε) ≤ Erdos1057.carmichaelCounting x := by
  apply eventually_of_carmichaelSizeParameter hη.le hν0
  have hpos : ∀ᶠ y : ℝ in atTop,
      0 < carmichaelSizeParameter η ν y ∧ 0 < H y ∧
      0 < y ^ η / n y ∧ 0 < y ^ η ∧ 0 < Real.log y := by
    filter_upwards [hH, hn, eventually_gt_atTop (1 : ℝ)] with y hHy hny hy
    have hy0 : 0 < y := by linarith
    have hnpos : 0 < n y := lt_of_lt_of_le (Real.rpow_pos_of_pos hy0 _) hny
    have htpos : 0 < y ^ η := Real.rpow_pos_of_pos hy0 _
    exact ⟨Real.rpow_pos_of_pos (by positivity) _, hHy, div_pos htpos hnpos,
      htpos, Real.log_pos hy⟩
  have hprob : ∀ᶠ y : ℝ in atTop,
      (1 - η - σ) * Real.log y ≤ Real.log (1 / (y ^ η / n y)) := by
    filter_upwards [hn, eventually_gt_atTop (0 : ℝ)] with y hny hy
    exact log_reciprocal_sampling_lower hy hny
  have hmargin' : (1 - ε) * (1 + ν) < (1 - ν) * (1 - η - σ) := by
    rw [div_mul_eq_mul_div] at hmargin
    exact (lt_div_iff₀ (by linarith : 0 < 1 + ν)).mp hmargin
  exact eventual_power_lower_of_entropy_limits
    (fun y => Erdos1057.carmichaelCounting (carmichaelSizeParameter η ν y))
    (carmichaelSizeParameter η ν) H (fun y => y ^ η / n y)
    (fun y => y ^ η) Real.log (fun y => ⌊(1 - ν) * y ^ η⌋₊)
    hpos hcount hprob (tendsto_floor_subset_size_ratio hη hν1)
    (tendsto_log_two_mul_normalized hη H hH hgroup)
    (tendsto_log_carmichaelSizeParameter_normalized η ν) hmargin'

/-- The exponential-mass form produced by the finite transfer has the same entropy consequence. -/
theorem eventual_carmichael_power_lower_of_exp_entropy {η ν σ ε : ℝ}
    (hη : 0 < η) (hν0 : 0 ≤ ν) (hν1 : ν ≤ 1)
    (hmargin : 1 - ε < ((1 - ν) / (1 + ν)) * (1 - η - σ))
    (n U : ℝ → ℝ) (hn : ∀ᶠ y in atTop, y ^ (1 - σ) ≤ n y)
    (hgroup : Tendsto (fun y => U y / (y ^ η * Real.log y)) atTop (𝓝 0))
    (hcount : ∀ᶠ y in atTop,
      Real.exp (-U y) / 2 * (n y / y ^ η) ^ ⌊(1 - ν) * y ^ η⌋₊ ≤
        Erdos1057.carmichaelCounting (carmichaelSizeParameter η ν y)) :
    ∀ᶠ x in atTop, x ^ (1 - ε) ≤ Erdos1057.carmichaelCounting x := by
  apply eventual_carmichael_power_lower_of_entropy hη hν0 hν1 hmargin n
    (fun y => Real.exp (U y)) (Eventually.of_forall (fun y => Real.exp_pos _)) hn
  · simpa only [Real.log_exp] using hgroup
  · filter_upwards [hcount] with y hy
    convert hy using 1
    rw [Real.exp_neg]
    simp only [div_eq_mul_inv, mul_inv_rev]
    ring_nf
    simp only [inv_inv]
    ring
end

section

/-- The fixed smoothness, subset-size, and concentration parameters can be
chosen with the required separation and with density exponent arbitrarily near one. -/
theorem density_parameters {ε : ℝ} (hε : 0 < ε) :
    ∃ δ η ν : ℝ,
      0 < δ ∧ δ < 1 / 16 ∧ 2 * δ < η ∧ η < 1 ∧
      0 < ν ∧ ν < 1 ∧ 1 - ε < ((1 - ν) / (1 + ν)) * (1 - η) := by
  let e : ℝ := min (ε / 8) (1 / 8)
  have he0 : 0 < e := lt_min (by linarith) (by norm_num)
  have heε : e ≤ ε / 8 := min_le_left _ _
  have he1 : e ≤ 1 / 8 := min_le_right _ _
  refine ⟨e / 4, e, e, by linarith, by linarith, by linarith,
    by linarith, he0, by linarith, ?_⟩
  rw [div_mul_eq_mul_div]
  apply (lt_div_iff₀ (by linarith : 0 < 1 + e)).mpr
  nlinarith
end

section

/-- Choose all four parameters at once with strict margins for modulus size,
reservoir loss, Fourier mixing, and the final entropy exponent. -/
theorem asymptotic_density_parameters {ε : ℝ} (hε : 0 < ε) :
    ∃ δ η ν σ : ℝ,
      0 < δ ∧ δ < 1 / 16 ∧ 0 < σ ∧ 0 < ν ∧ ν < 1 ∧
      2 * δ + 4 * σ < η ∧ η < 1 - σ ∧
      7 / 8 + 2 * δ + 2 * σ < 1 ∧
      1 - ε < ((1 - ν) / (1 + ν)) * (1 - η - 2 * σ) := by
  let e : ℝ := min (ε / 16) (1 / 32)
  have he0 : 0 < e := lt_min (by linarith) (by norm_num)
  have heε : e ≤ ε / 16 := min_le_left _ _
  have he1 : e ≤ 1 / 32 := min_le_right _ _
  refine ⟨e / 8, e, e, e / 16, by linarith, by linarith,
    by linarith, he0, by linarith, by linarith, by linarith, by linarith, ?_⟩
  rw [div_mul_eq_mul_div]
  apply (lt_div_iff₀ (by linarith : 0 < 1 + e)).mpr
  nlinarith
end

section

/-- The pointwise prime and character data sufficient for the counting argument.
This proposition is an input contract, not an assumed theorem. -/
def PowerPrimeReservoir (δ σ y : ℝ) : Prop :=
  ∃ (L : ℕ) (S P : Finset ℕ) (g : ℕ → (ZMod L)ˣ),
    0 < L ∧ P ⊆ S ∧
    (∀ p ∈ S, p.Prime) ∧ (∀ p ∈ S, (p : ℝ) ≤ 5 * y) ∧
    (∀ p ∈ P, p - 1 ∣ L) ∧
    (∀ p ∈ P, (g p : ZMod L) = (p : ZMod L)) ∧
    y ^ (1 - σ) ≤ (P.card : ℝ) ∧
    Real.log (Nat.card ((ZMod L)ˣ) : ℝ) ≤ y ^ (δ + σ) ∧
    (Nat.log 2 (Nat.card ((ZMod L)ˣ)) : ℝ) ≤ y ^ (δ + σ) ∧
    ∀ ξ : (ZMod L)ˣ →* ℂ, ξ ≠ 1 →
      ‖∑ p ∈ S, ξ (g p)‖ ≤ y ^ ((7 : ℝ) / 8 + 2 * δ + σ)
end

section
open Filter
/-- All primes in the ambient interval at a real scale. -/
noncomputable def ambientPrimes (y : ℝ) : Finset ℕ :=
  (Finset.Icc 1 ⌊5 * y⌋₊).filter fun p => p.Prime ∧ 2 * y < (p : ℝ)

theorem mem_ambientPrimes_iff {y : ℝ} (hy : 0 ≤ y) {p : ℕ} :
    p ∈ ambientPrimes y ↔ p.Prime ∧ 2 * y < (p : ℝ) ∧ (p : ℝ) ≤ 5 * y := by
  classical
  simp only [ambientPrimes, Finset.mem_filter, Finset.mem_Icc]
  constructor
  · rintro ⟨⟨_, hpbound⟩, hp, hplower⟩
    exact ⟨hp, hplower, (Nat.le_floor_iff (by positivity)).mp hpbound⟩
  · rintro ⟨hp, hplower, hpbound⟩
    exact ⟨⟨hp.one_le, Nat.le_floor hpbound⟩, hp, hplower⟩

/-- Smooth shifted-prime supply, with every small power loss made explicit.
This is a hypothesis until the underlying analytic theorem is formalized. -/
def SmoothShiftedPrimeSupply : Prop :=
  ∀ δ : ℝ, 0 < δ → δ < 1 / 4 → ∀ σ : ℝ, 0 < σ →
    ∀ᶠ y : ℝ in atTop, ∃ P : Finset ℕ,
      P ⊆ ambientPrimes y ∧ y ^ (1 - σ) ≤ (P.card : ℝ) ∧
      ∀ p ∈ P, ∀ q : ℕ, q.Prime → q ∣ p - 1 → (q : ℝ) ≤ y ^ δ

/-- The required uniform prime-character estimate at large moduli, stated at
the power precision used by the proof. This is a hypothesis, not a theorem. -/
def AmbientPrimeCancellation : Prop :=
  ∀ δ : ℝ, 0 < δ → δ < 1 / 16 → ∀ σ : ℝ, 0 < σ →
    ∀ᶠ y : ℝ in atTop, ∀ L : ℕ, 0 < L →
      Real.log (L : ℝ) ≤ y ^ δ * Real.log (5 * y) →
      ∀ χ : DirichletCharacter ℂ L, χ ≠ 1 →
        ‖∑ p ∈ ambientPrimes y, χ (p : ZMod L)‖ ≤
          y ^ ((7 : ℝ) / 8 + 2 * δ + σ)

/-- A conventional uniform estimate which is sufficient for ambient cancellation.
Its derivation from Dirichlet L-function nonvanishing remains unformalized here. -/
def UniformPrimeCharacterEstimate : Prop :=
  ∃ C : ℝ, 0 < C ∧ ∀ y : ℝ, 2 ≤ y → ∀ L : ℕ, 0 < L →
    ∀ χ : DirichletCharacter ℂ L, χ ≠ 1 →
      ‖∑ p ∈ ambientPrimes y, χ (p : ZMod L)‖ ≤
        C * y ^ ((7 : ℝ) / 8) * (Real.log (5 * (L : ℝ) * y)) ^ 2
end

section
open Filter
open scoped Topology
/-- Any fixed multiple of the modulus logarithm is eventually absorbed by an
arbitrarily small positive increase in its power exponent. -/
theorem eventually_mul_rpow_log_five_mul_le_rpow (δ : ℝ) {σ : ℝ}
    (hσ : 0 < σ) (d : ℝ) :
    ∀ᶠ y : ℝ in atTop, d * y ^ δ * Real.log (5 * y) ≤ y ^ (δ + σ) := by
  filter_upwards [eventually_mul_rpow_log_add_le_rpow (a := 0) (b := σ)
    (c := 1) hσ hσ zero_lt_one d (d * Real.log 5), eventually_gt_atTop (0 : ℝ)]
    with y h hy
  have hlog : d * Real.log (5 * y) ≤ y ^ σ := by
    rw [Real.log_mul (by norm_num) (ne_of_gt hy)]
    simp only [Real.rpow_zero, mul_one, one_mul] at h
    nlinarith
  calc
    d * y ^ δ * Real.log (5 * y) = y ^ δ * (d * Real.log (5 * y)) := by ring
    _ ≤ y ^ δ * y ^ σ := mul_le_mul_of_nonneg_left hlog (Real.rpow_nonneg hy.le _)
    _ = y ^ (δ + σ) := (Real.rpow_add hy δ σ).symm

/-- The threshold is uniform in the natural number whose logarithm is bounded.
The result also holds at `q = 0`, under Mathlib's total logarithm conventions. -/
theorem eventually_log_natLog_le_rpow (δ : ℝ) {σ : ℝ} (hσ : 0 < σ) :
    ∀ᶠ y : ℝ in atTop, ∀ q : ℕ,
      Real.log (q : ℝ) ≤ y ^ δ * Real.log (5 * y) →
      Real.log (q : ℝ) ≤ y ^ (δ + σ) ∧
      (Nat.log 2 q : ℝ) ≤ y ^ (δ + σ) := by
  filter_upwards [eventually_mul_rpow_log_five_mul_le_rpow δ hσ 1,
    eventually_mul_rpow_log_five_mul_le_rpow δ hσ (1 / Real.log 2)] with y hreal hbase
  intro q hlog
  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  refine ⟨hlog.trans (by simpa only [one_mul] using hreal), ?_⟩
  calc
    (Nat.log 2 q : ℝ) ≤ Real.logb 2 (q : ℝ) := by
      simpa using Real.natLog_le_logb q 2
    _ = Real.log (q : ℝ) / Real.log 2 := rfl
    _ ≤ (y ^ δ * Real.log (5 * y)) / Real.log 2 :=
      div_le_div_of_nonneg_right hlog hlog2.le
    _ = (1 / Real.log 2) * y ^ δ * Real.log (5 * y) := by ring
    _ ≤ y ^ (δ + σ) := hbase

theorem log_card_zmod_units_le {L : ℕ} (hL : 0 < L) :
    Real.log (Nat.card (ZMod L)ˣ : ℝ) ≤ Real.log (L : ℝ) := by
  let : NeZero L := ⟨ne_of_gt hL⟩
  apply Real.log_le_log
  · exact_mod_cast (Nat.card_pos (α := (ZMod L)ˣ))
  · exact_mod_cast card_zmod_units_le hL

/-- A single threshold bounds both logarithms of every unit group of every
positive modulus satisfying the smooth-modulus estimate. -/
theorem eventually_unitGroup_log_natLog_le_rpow (δ : ℝ) {σ : ℝ} (hσ : 0 < σ) :
    ∀ᶠ y : ℝ in atTop, ∀ L : ℕ, 0 < L →
      Real.log (L : ℝ) ≤ y ^ δ * Real.log (5 * y) →
      Real.log (Nat.card (ZMod L)ˣ : ℝ) ≤ y ^ (δ + σ) ∧
      (Nat.log 2 (Nat.card (ZMod L)ˣ) : ℝ) ≤ y ^ (δ + σ) := by
  filter_upwards [eventually_log_natLog_le_rpow δ hσ] with y hy
  intro L hL hlog
  exact hy _ ((log_card_zmod_units_le hL).trans hlog)
end

section
open Filter
open scoped Topology
/-- Every positive power eventually dominates any fixed multiple of `log(y)^2`. -/
theorem eventually_mul_log_sq_le_rpow {σ : ℝ} (hσ : 0 < σ) (D : ℝ) :
    ∀ᶠ y : ℝ in atTop, D * (Real.log y) ^ (2 : ℕ) ≤ y ^ σ := by
  have hlog : Tendsto (fun y : ℝ => (Real.log y) ^ (2 : ℕ) / y ^ σ)
      atTop (𝓝 0) := by
    simpa only [Real.rpow_two] using
      (isLittleO_log_rpow_rpow_atTop (2 : ℝ) hσ).tendsto_div_nhds_zero
  have hlim : Tendsto (fun y : ℝ => D * ((Real.log y) ^ (2 : ℕ) / y ^ σ))
      atTop (𝓝 0) := by simpa using hlog.const_mul D
  filter_upwards [hlim.eventually_le_const (show (0 : ℝ) < 1 by norm_num),
    eventually_gt_atTop (0 : ℝ)] with y hy hy0
  have h := (div_le_iff₀ (Real.rpow_pos_of_pos hy0 σ)).mp
    (show D * (Real.log y) ^ (2 : ℕ) / y ^ σ ≤ 1 by simpa only [mul_div_assoc] using hy)
  simpa only [one_mul] using h

/-- The conductor-size logarithm is bounded uniformly under its prescribed
logarithmic size condition. -/
theorem conductor_log_le {y q δ : ℝ} (hy : 5 ≤ y) (hq : 1 ≤ q) (hδ : 0 ≤ δ)
    (hsize : Real.log q ≤ y ^ δ * Real.log (5 * y)) :
    0 ≤ Real.log (5 * q * y) ∧
      Real.log (5 * q * y) ≤ 4 * y ^ δ * Real.log y := by
  have hy0 : 0 < y := by linarith
  have hq0 : 0 < q := by linarith
  have hy1 : 1 ≤ y := by linarith
  have hyd : 1 ≤ y ^ δ := Real.one_le_rpow hy1 hδ
  have hlogy : 0 ≤ Real.log y := Real.log_nonneg hy1
  have hlog5 : Real.log 5 ≤ Real.log y := Real.log_le_log (by norm_num) hy
  have hlog5y : 0 ≤ Real.log (5 * y) := Real.log_nonneg (by linarith)
  have hlog5y' : Real.log (5 * y) ≤ 2 * Real.log y := by
    rw [Real.log_mul (by norm_num) hy0.ne']
    linarith
  have heq : Real.log (5 * q * y) = Real.log q + Real.log (5 * y) := by
    have heq' : 5 * q * y = q * (5 * y) := by ring
    rw [heq', Real.log_mul hq0.ne' (by positivity : 5 * y ≠ 0)]
  constructor
  · rw [heq]
    exact add_nonneg (Real.log_nonneg hq) hlog5y
  · calc
      Real.log (5 * q * y) ≤ (y ^ δ + 1) * Real.log (5 * y) := by
        rw [heq]
        nlinarith
      _ ≤ (2 * y ^ δ) * (2 * Real.log y) := by gcongr; linarith
      _ = 4 * y ^ δ * Real.log y := by ring

/-- A conventional character-sum amplitude becomes a uniform pure-power bound
for all conductors satisfying the logarithmic size estimate. -/
theorem eventually_character_amplitude_bound {δ σ C : ℝ}
    (hδ : 0 ≤ δ) (hσ : 0 < σ) (hC : 0 ≤ C) :
    ∀ᶠ y : ℝ in atTop, ∀ q : ℝ, 1 ≤ q →
      Real.log q ≤ y ^ δ * Real.log (5 * y) →
      C * y ^ ((7 : ℝ) / 8) * (Real.log (5 * q * y)) ^ (2 : ℕ) ≤
        y ^ ((7 : ℝ) / 8 + 2 * δ + σ) := by
  filter_upwards [eventually_mul_log_sq_le_rpow hσ (16 * C),
    eventually_ge_atTop (5 : ℝ)] with y hsmall hy
  have hy0 : 0 < y := by linarith
  have hyd : 0 ≤ y ^ δ := Real.rpow_nonneg hy0.le δ
  have hybase : 0 ≤ y ^ ((7 : ℝ) / 8) := Real.rpow_nonneg hy0.le _
  intro q hq hsize
  obtain ⟨hlog0, hlog⟩ := conductor_log_le hy hq hδ hsize
  have hlogy : 0 ≤ Real.log y := Real.log_nonneg (by linarith)
  have hsq : (Real.log (5 * q * y)) ^ (2 : ℕ) ≤
      (4 * y ^ δ * Real.log y) ^ (2 : ℕ) := by gcongr
  calc
    C * y ^ ((7 : ℝ) / 8) * (Real.log (5 * q * y)) ^ (2 : ℕ) ≤
        C * y ^ ((7 : ℝ) / 8) * (4 * y ^ δ * Real.log y) ^ (2 : ℕ) := by gcongr
    _ = (y ^ ((7 : ℝ) / 8) * (y ^ δ) ^ (2 : ℕ)) *
        (16 * C * (Real.log y) ^ (2 : ℕ)) := by ring
    _ ≤ (y ^ ((7 : ℝ) / 8) * (y ^ δ) ^ (2 : ℕ)) * y ^ σ := by gcongr
    _ = y ^ ((7 : ℝ) / 8 + 2 * δ + σ) := by
      rw [Real.rpow_add hy0, Real.rpow_add hy0]
      have hpow : y ^ (2 * δ) = (y ^ δ) ^ (2 : ℕ) := by
        rw [mul_comm (2 : ℝ) δ, Real.rpow_mul hy0.le]
        exact Real.rpow_natCast _ 2
      rw [hpow]
end

section
open Filter
/-- A conventional uniform prime-character estimate supplies cancellation at the
power precision needed in the finite construction. -/
theorem ambientPrimeCancellation_of_uniform_estimate
    (h : UniformPrimeCharacterEstimate) : AmbientPrimeCancellation := by
  obtain ⟨C, hC, hbound⟩ := h
  intro δ hδ _ σ hσ
  filter_upwards [eventually_character_amplitude_bound hδ.le hσ hC.le,
    eventually_ge_atTop (2 : ℝ)] with y hy hy2
  intro L hL hlog χ hχ
  have hL1 : (1 : ℝ) ≤ L := by exact_mod_cast hL
  exact (hbound y hy2 L hL χ hχ).trans (hy L hL1 hlog)

/-- The smooth-prime supply and ambient character cancellation together provide
all of the pointwise data used by the Carmichael counting construction. -/
theorem powerPrimeReservoir_of_analytic_inputs
    (hS : SmoothShiftedPrimeSupply) (hC : AmbientPrimeCancellation)
    {δ σ : ℝ} (hδ : 0 < δ) (hδsmall : δ < 1 / 16) (hσ : 0 < σ) :
    ∀ᶠ y : ℝ in atTop, PowerPrimeReservoir δ σ y := by
  filter_upwards [hS δ hδ (by linarith) σ hσ, hC δ hδ hδsmall σ hσ,
    eventually_unitGroup_log_natLog_le_rpow δ hσ,
    eventually_ge_atTop (1 : ℝ)] with y hSy hCy hGy hy
  obtain ⟨P, hPS, hPcard, hPsmooth⟩ := hSy
  have hy0 : 0 ≤ y := by linarith
  have hprime : ∀ p ∈ ambientPrimes y, p.Prime := by
    intro p hp
    exact ((mem_ambientPrimes_iff hy0).mp hp).1
  have hinterval : ∀ p ∈ ambientPrimes y, 2 * y < (p : ℝ) ∧ (p : ℝ) ≤ 5 * y := by
    intro p hp
    exact ((mem_ambientPrimes_iff hy0).mp hp).2
  obtain ⟨L, g, hL, hdiv, _, hlog, _, hcompat⟩ :=
    exists_real_smooth_prime_modulus hy (by linarith : δ ≤ 1) P (ambientPrimes y)
      hPS hprime hinterval hPsmooth
  obtain ⟨hGlog, hGnatlog⟩ := hGy L hL hlog
  refine ⟨L, ambientPrimes y, P, g, hL, hPS, hprime,
    (fun p hp => (hinterval p hp).2), hdiv,
    (fun p hp => hcompat p (hPS hp)), hPcard, hGlog, hGnatlog, ?_⟩
  intro ξ hξ
  exact unitCharacter_sum_bound_of_dirichlet (ambientPrimes y) g hcompat
    (hCy L hL hlog) ξ hξ
end

section
open Filter Set
open scoped Topology
theorem carmichaelCounting_nonneg (x : ℝ) :
    0 ≤ Erdos1057.carmichaelCounting x := by
  unfold Erdos1057.carmichaelCounting
  positivity

theorem carmichaelCounting_le {x : ℝ} (hx : 0 ≤ x) :
    Erdos1057.carmichaelCounting x ≤ x := by
  have hsub : {n : ℕ | IsCarmichael n ∧ (n : ℝ) ≤ x} ⊆
      Set.Icc 1 ⌊x⌋₊ := by
    intro n hn
    refine ⟨?_, (Nat.le_floor_iff hx).2 hn.2⟩
    have hn' := hn.1 1 (by omega) (Nat.coprime_one_right n)
    exact Nat.le_of_lt hn'.2.2
  have hcard := Set.ncard_le_ncard hsub (Set.finite_Icc 1 ⌊x⌋₊)
  simp only [Set.ncard_Icc_nat, Nat.add_sub_cancel] at hcard
  exact (Nat.cast_le.mpr hcard).trans (Nat.floor_le hx)

theorem log_ratio_le_one {x : ℝ} (hx : 1 < x) :
    Real.log (Erdos1057.carmichaelCounting x) / Real.log x ≤ 1 := by
  have hx0 : 0 < x := lt_trans zero_lt_one hx
  apply (div_le_iff₀ (Real.log_pos hx)).2
  rw [one_mul]
  by_cases hc : Erdos1057.carmichaelCounting x = 0
  · simpa [hc] using (Real.log_pos hx).le
  · exact Real.log_le_log
      (lt_of_le_of_ne (carmichaelCounting_nonneg x) (Ne.symm hc))
      (carmichaelCounting_le hx0.le)

/-- The lower bound still needed from the number-theoretic argument. -/
def NearLinearLowerBound : Prop :=
  ∀ ε : ℝ, 0 < ε → ∀ᶠ x : ℝ in atTop,
    x ^ (1 - ε) ≤ Erdos1057.carmichaelCounting x

/-- The final analytic step, conditional on a near-linear counting lower bound. -/
theorem counting_limit_of_lower_bound (h : NearLinearLowerBound) :
    Tendsto (fun x : ℝ => Real.log (Erdos1057.carmichaelCounting x) / Real.log x)
      atTop (𝓝 1) := by
  apply tendsto_order.2
  constructor
  · intro a ha
    have he : 0 < (1 - a) / 2 := by linarith
    filter_upwards [h ((1 - a) / 2) he, eventually_gt_atTop (1 : ℝ)] with x hl hx
    have hx0 : 0 < x := lt_trans zero_lt_one hx
    have hr : 0 < x ^ (1 - (1 - a) / 2) := Real.rpow_pos_of_pos hx0 _
    have hlog := Real.log_le_log hr hl
    rw [Real.log_rpow hx0] at hlog
    have hratio : 1 - (1 - a) / 2 ≤
        Real.log (Erdos1057.carmichaelCounting x) / Real.log x :=
      (le_div_iff₀ (Real.log_pos hx)).2 hlog
    linarith
  · intro a ha
    filter_upwards [eventually_gt_atTop (1 : ℝ)] with x hx
    exact lt_of_le_of_lt (log_ratio_le_one hx) ha

theorem lower_bound_of_counting_limit
    (h : Tendsto (fun x : ℝ =>
      Real.log (Erdos1057.carmichaelCounting x) / Real.log x) atTop (𝓝 1)) :
    NearLinearLowerBound := by
  intro ε hε
  have hzero := (tendsto_order.1 h).1 0 zero_lt_one
  have hlower := (tendsto_order.1 h).1 (1 - ε) (by linarith)
  filter_upwards [hzero, hlower, eventually_gt_atTop (1 : ℝ)] with x hz hl hx
  have hx0 : 0 < x := lt_trans zero_lt_one hx
  have hc : 0 < Erdos1057.carmichaelCounting x := by
    have hne : Erdos1057.carmichaelCounting x ≠ 0 := by
      intro heq
      simp [heq] at hz
    exact lt_of_le_of_ne (carmichaelCounting_nonneg x) (Ne.symm hne)
  apply (Real.log_le_log_iff (Real.rpow_pos_of_pos hx0 _) hc).1
  rw [Real.log_rpow hx0]
  exact ((lt_div_iff₀ (Real.log_pos hx)).1 hl).le

theorem counting_limit_iff_lower_bound :
    Tendsto (fun x : ℝ => Real.log (Erdos1057.carmichaelCounting x) / Real.log x)
      atTop (𝓝 1) ↔ NearLinearLowerBound :=
  ⟨lower_bound_of_counting_limit, counting_limit_of_lower_bound⟩

/-- This has an extra hypothesis and is not the unconditional challenge target. -/
theorem target_of_lower_bound (h : NearLinearLowerBound) :
    fcTypeOfName% "Erdos1057.erdos_1057" := by
  exact ⟨fun _ => counting_limit_of_lower_bound h, fun _ => True.intro⟩

theorem target_iff_lower_bound :
    (fcTypeOfName% "Erdos1057.erdos_1057") ↔ NearLinearLowerBound := by
  exact ⟨fun h => lower_bound_of_counting_limit (h.mp True.intro),
    target_of_lower_bound⟩
end

section
open Filter
open scoped Topology
/-- At fixed separated exponents, the finite construction supplies the entropy lower bound. -/
theorem eventually_entropy_bound_of_power_reservoir {δ η ν σ : ℝ}
    (hδ : 0 < δ) (hσ : 0 < σ) (hν0 : 0 < ν) (hν1 : ν < 1)
    (hgap : 2 * δ + 4 * σ < η) (hησ : η < 1 - σ)
    (herror : 7 / 8 + 2 * δ + 2 * σ < 1)
    (hsupply : ∀ᶠ y in atTop, PowerPrimeReservoir δ σ y) :
    ∀ᶠ y in atTop, ∃ n : ℕ,
      y ^ (1 - 2 * σ) ≤ (n : ℝ) ∧
      Real.exp (-y ^ (δ + σ)) / 2 * ((n : ℝ) / y ^ η) ^ ⌊(1 - ν) * y ^ η⌋₊ ≤
        Erdos1057.carmichaelCounting (carmichaelSizeParameter η ν y) := by
  have hη : 0 < η := by linarith
  have hpower : 0 < 1 - σ := by linarith
  have hsmall := eventually_mul_rpow_add_le_mul_rpow
    (a := (7 : ℝ) / 8 + 2 * δ + σ) (b := 1 - σ) hpower
    (by linarith) (by norm_num : (0 : ℝ) < 1) 64 0
  have hfeasible := eventually_finite_sampling_feasible
    (d := δ + σ) (r := σ) (η := η) (σ := σ) (ν := ν) (K := 325)
    (by linarith) hσ.le (by linarith) hησ hν0 hν1
  have htwopower := eventually_const_le_mul_rpow (η := σ) hσ
    (by norm_num : (0 : ℝ) < 1) 2
  filter_upwards [hsupply, hsmall, hfeasible, htwopower,
    eventually_ge_atTop (1 : ℝ)] with y hs hyA hyF hyσ hy1
  have hy0 : 0 < y := lt_of_lt_of_le zero_lt_one hy1
  obtain ⟨L, S, P, g, hLpos, hPS, hprime, hbound, hL, hcompat,
    hN, hlogU, hlogD, hamb⟩ := hs
  let : NeZero L := ⟨hLpos.ne'⟩
  have hNpos : 0 < (P.card : ℝ) :=
    lt_of_lt_of_le (Real.rpow_pos_of_pos hy0 _) hN
  have hNQ : (P.card : ℝ) ≤ S.card := by exact_mod_cast Finset.card_le_card hPS
  have hQbound : (S.card : ℝ) ≤ 5 * y := prime_interval_card_le hy0.le hprime hbound
  have hA : 0 ≤ y ^ ((7 : ℝ) / 8 + 2 * δ + σ) := Real.rpow_nonneg hy0.le _
  have hAN : 64 * y ^ ((7 : ℝ) / 8 + 2 * δ + σ) ≤ P.card := by
    have hAy : 64 * y ^ ((7 : ℝ) / 8 + 2 * δ + σ) ≤ y ^ (1 - σ) := by
      simpa only [add_zero, one_mul] using hyA
    exact hAy.trans hN
  obtain ⟨R, hR, hRlarge, hRsmall, hRbound⟩ := fejer_length_parameters hNpos hNQ hA hAN
  have hRpow : (R : ℝ) ≤ 325 * y ^ σ := by
    calc
      (R : ℝ) ≤ 65 * (S.card : ℝ) / P.card := hRbound
      _ ≤ 65 * (5 * y) / P.card := by gcongr
      _ ≤ 65 * (5 * y) / y ^ (1 - σ) :=
        div_le_div_of_nonneg_left (by positivity) (Real.rpow_pos_of_pos hy0 _) hN
      _ = 325 * (y / y ^ (1 - σ)) := by ring
      _ = 325 * y ^ σ := by
        congr 1
        calc
          y / y ^ (1 - σ) = y ^ (1 : ℝ) / y ^ (1 - σ) := by rw [Real.rpow_one]
          _ = y ^ ((1 : ℝ) - (1 - σ)) := (Real.rpow_sub hy0 1 (1 - σ)).symm
          _ = y ^ σ := by congr 1; ring
  have hD : 1 ≤ y ^ (δ + σ) := Real.one_le_rpow hy1 (by linarith)
  obtain ⟨n, hnlow, hnhigh, hncount⟩ := finite_carmichael_counting_bound
    S P hPS g (fun p hp => hprime p (hPS hp)) hL hcompat
    (by linarith : 1 ≤ 5 * y) (fun p hp => hbound p (hPS hp)) hD hlogD hlogU
    hR hRlarge hRsmall hamb
  have hnnew : y ^ (1 - 2 * σ) ≤ (n : ℝ) := by
    have htwo : 2 ≤ y ^ σ := by simpa only [one_mul] using hyσ
    have hmul := mul_le_mul_of_nonneg_left htwo
      (Real.rpow_nonneg hy0.le (1 - 2 * σ))
    have heq : y ^ (1 - 2 * σ) * y ^ σ = y ^ (1 - σ) := by
      rw [← Real.rpow_add hy0]
      congr 1
      ring
    rw [heq] at hmul
    linarith
  refine ⟨n, hnnew, ?_⟩
  obtain ⟨hfourier, htail, hsampling, hsize⟩ := hyF
  have ht : 0 < y ^ η := Real.rpow_pos_of_pos hy0 _
  have htn : 2 * y ^ η ≤ (n : ℝ) := by linarith
  have hk : (⌊(1 - ν) * y ^ η⌋₊ : ℝ) ≤ (1 - ν) * y ^ η :=
    Nat.floor_le (by positivity)
  exact hncount (y ^ η) ν ⌊(1 - ν) * y ^ η⌋₊ ht htn hν0.le hν1.le hsize hk
    (hfourier R (by exact_mod_cast hR) hRpow) htail

/-- The analytic reservoir contract for every fixed pair of small exponents is
sufficient for the exact Erdős 1057 target. This theorem does not assert that contract. -/
theorem target_of_power_prime_reservoirs
    (hsupply : ∀ δ : ℝ, 0 < δ → δ < 1 / 16 → ∀ σ : ℝ, 0 < σ →
      ∀ᶠ y in atTop, PowerPrimeReservoir δ σ y) :
    fcTypeOfName% "Erdos1057.erdos_1057" := by
  classical
  apply target_of_lower_bound
  intro ε hε
  obtain ⟨δ, η, ν, σ, hδ, hδ16, hσ, hν0, hν1, hgap, hησ, herror, hmargin⟩ :=
    asymptotic_density_parameters hε
  have hη : 0 < η := by linarith
  have hfinite := eventually_entropy_bound_of_power_reservoir hδ hσ hν0 hν1
    hgap hησ herror (hsupply δ hδ hδ16 σ hσ)
  let W : ℝ → ℕ → Prop := fun y n =>
    y ^ (1 - 2 * σ) ≤ (n : ℝ) ∧
      Real.exp (-y ^ (δ + σ)) / 2 * ((n : ℝ) / y ^ η) ^ ⌊(1 - ν) * y ^ η⌋₊ ≤
        Erdos1057.carmichaelCounting (carmichaelSizeParameter η ν y)
  have hW : ∀ᶠ y in atTop, ∃ n : ℕ, W y n := hfinite
  let n : ℝ → ℕ := fun y => Classical.epsilon (W y)
  have hn : ∀ᶠ y in atTop, W y (n y) :=
    hW.mono (fun y hy => Classical.epsilon_spec hy)
  apply eventual_carmichael_power_lower_of_exp_entropy (σ := 2 * σ)
    hη hν0.le hν1.le hmargin (fun y => (n y : ℝ)) (fun y => y ^ (δ + σ))
  · exact hn.mono (fun y hy => hy.1)
  · exact tendsto_rpow_div_rpow_log (by linarith)
  · exact hn.mono (fun y hy => hy.2)
end

