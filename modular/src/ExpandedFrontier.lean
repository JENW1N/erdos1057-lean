/- The exact initial-avoidance and distinctness factors on the original physical path. -/

open scoped Classical
namespace Bounty
section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, DecidableEq (P g)]
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ)
  (edgePhase : ∀ k, ((g : Fin N) → Finset (P g)) →
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) →
    FullActiveEdgeEvent n (S k) B (A k) (Δ k) (D k) x → ℂ)
  (hedge : ∀ k H x e,
    edgePhase k H x e =
      (if FullMixedLocalBirthAvoids (J := J) n S B A Δ D H (some (.inr k)) x e ∧
          FullMixedLocalBirthDistinct (J := J) n S B A Δ D (some (.inr k)) x e then 1 else 0) *
        edgePhase k (fun _ => ∅) x e)
  (ω : ∀ k c, A k c → ℝ) (μ : (g : Fin N) → P g → ℝ)
  (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
  (steps : List (Option (J ⊕ K)))
  (initial : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B →
    (g : Fin N) → Finset (P g))
  (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
  (p : FullPermutationMixedPath n S B A Δ D steps x)

include hedge in
theorem full_mixed_physical_path_phase_factor
    (hx : FullMixedLedgerCovers n B (initial x, x))
    (hp : finiteEventPathWeight (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D)
      (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V) steps x p ≠ 0) :
    fullMixedLedgerInducedPhase n S B A Δ D steps initial
      (finiteEventLocalPhase
        (fun tag (s : FullMixedLedgerState n (M := M) B) =>
          FullPermutationMixedEvent n S B A Δ D tag s.2)
        (fullMixedLedgerTarget n S B A Δ D) (fullMixedLedgerPhase n S B A Δ D edgePhase) steps) x p =
    (if ∀ (a : FullMixedBirthAddress S B steps) (z : (g : Fin N) × P g),
        fullMixedPathBirthLabel n S B A Δ D steps x p a = some z → z.2 ∉ initial x z.1
      then 1 else 0) *
    (if ∀ (a b : FullMixedBirthAddress S B steps) z,
        fullMixedPathBirthLabel n S B A Δ D steps x p a = some z →
        fullMixedPathBirthLabel n S B A Δ D steps x p b = some z → a = b
      then 1 else 0) *
    finiteEventLocalPhase (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D)
      (fullMixedBirthResidualPhase n S B A Δ D edgePhase) steps x p := by
  let lift : FullMixedLedgerPath n S B A Δ D steps (initial x, x) :=
    (finiteLedgerEventPathEquiv (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) (fullMixedLedgerUpdate n S B A Δ D)
    steps (initial x) x).symm p
  have hw := finite_ledger_event_path_weight (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) (fullMixedLedgerUpdate n S B A Δ D)
    (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V) steps (initial x) x lift
  have hlift : finiteEventPathWeight
      (fun tag (s : FullMixedLedgerState n (M := M) B) =>
        FullPermutationMixedEvent n S B A Δ D tag s.2)
      (fullMixedLedgerTarget n S B A Δ D)
      (fun tag s => fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V tag s.2)
      steps (initial x, x) lift ≠ 0 := by
    intro hz
    apply hp
    simpa only [lift, Equiv.apply_symm_apply] using hw.symm.trans hz
  have h := full_mixed_ledger_path_phase_factor n S B A Δ D edgePhase hedge
    ω μ q ρ V steps (initial x, x) lift hx hlift
  have hr := finite_ledger_event_local_phase (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) (fullMixedLedgerUpdate n S B A Δ D)
    (fullMixedBirthResidualPhase n S B A Δ D edgePhase) steps (initial x) x lift
  change finiteEventLocalPhase
    (fun tag (s : FullMixedLedgerState n (M := M) B) =>
      FullPermutationMixedEvent n S B A Δ D tag s.2)
    (fullMixedLedgerTarget n S B A Δ D)
    (fun tag s => fullMixedBirthResidualPhase n S B A Δ D edgePhase tag s.2)
    steps (initial x, x) lift = _ at hr
  rw [hr] at h
  have hb (a : FullMixedBirthAddress S B steps) :
      fullMixedLedgerPathBirthLabel n S B A Δ D steps (initial x, x) lift a =
        fullMixedPathBirthLabel n S B A Δ D steps x p a := by
    simpa only [lift, Equiv.apply_symm_apply] using
      full_mixed_ledger_birth_label_projection n S B A Δ D steps (initial x) x lift a
  change finiteEventLocalPhase _ _ _ steps (initial x, x) lift = _
  simpa only [hb, lift, Equiv.apply_symm_apply] using h

end Full
end Bounty
