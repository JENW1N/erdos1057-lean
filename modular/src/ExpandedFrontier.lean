      (some (.inr k) :: steps) s
      ⟨(fullPermutationEdgeBirthEquiv (J := J) n S B A Δ D s k).symm ⟨sk, fresh⟩, tail⟩ 0 i hi hu
    change FullActiveEdgeSampleIndex n (S k) B (A k) (Δ k) (D k) s sk at c
    exact ⟨c, (full_mixed_edge_head_coordinate n S B A Δ D steps s k sk fresh tail c).symm.trans hc⟩
  · rintro ⟨c, rfl⟩
