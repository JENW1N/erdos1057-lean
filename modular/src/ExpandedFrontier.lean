/- Exact full-P and active-slot separation of the finite-window Mellin integrand. -/

open Finset Filter MeasureTheory Real

namespace Bounty

noncomputable def candidateCoarseMellinTest (L E ν : ℝ) (F : ℕ → ℕ → ℂ) : ℕ → ℕ → ℂ :=
  candidateBoxFiniteTest L E (candidateWindowBox L)
    (fun u => (u : ℂ)^(((2*Real.pi*ν : ℝ) : ℂ)*Complex.I) * ∑ m ∈ (2*u+1).divisors, F u m)

noncomputable def candidateMixedMellinIntegrand (c L q : ℝ) (r jStar : ℕ)
    (E B : ℝ) (F : ℕ → ℕ → ℂ) (ν : ℝ) : ℂ :=
  (exp L : ℂ)^(-((2*Real.pi*ν : ℝ) : ℂ)*Complex.I) * typeIIWindowFourier (L^B) ν *
    ∑ take ∈ (univ : Finset (Fin ((candidateQIndices c L).card*r) → Bool)).filter
      (fun take => ∀ i, candidateAllocationActive c L r jStar i = false → take i = false),
      ∫ ξ, candidateRetainedAllocationIntegrand c L q r jStar (log E)
        (candidateSmallPSet c L (17*exp L+1)) take (candidateCoarseMellinTest L E ν F) ξ
        ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) L

theorem eventually_candidate_mixed_mellin_integrand_eq {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ) (E B : ℝ) (F : ℕ → ℕ → ℂ) (ν : ℝ),
      candidateBoxWindowMellinIntegrand c L q r jStar E B F ν =
        candidateMixedMellinIntegrand c L q r jStar E B F ν := by
  filter_upwards [eventually_candidate_box_finite_retained_integrals hc] with L hL
  intro q r jStar E B F ν
  unfold candidateBoxWindowMellinIntegrand candidateMixedMellinIntegrand candidateCoarseMellinTest
  rw [finite_window_mellin_integrand_separated]
  congr 1
  calc
    _ = ∑ u ∈ candidateWindowBox L, candidateBoxRangeCoefficient c L q r jStar E L u *
        ((u : ℂ)^(((2*Real.pi*ν : ℝ) : ℂ)*Complex.I) * ∑ m ∈ (2*u+1).divisors, F u m) := by
      apply sum_congr rfl
      intro u hu
      exact mul_assoc _ _ _
    _ = _ := hL q r jStar E L (17*exp L) (candidateWindowBox L)
      (fun u => (u : ℂ)^(((2*Real.pi*ν : ℝ) : ℂ)*Complex.I) * ∑ m ∈ (2*u+1).divisors, F u m)
      (fun u hu => mem_candidate_window_box_bounds hu)

theorem eventually_candidate_mixed_mellin_integrable {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ) (E B : ℝ) (F : ℕ → ℕ → ℂ),
      Integrable (candidateMixedMellinIntegrand c L q r jStar E B F) := by
  filter_upwards [eventually_candidate_mixed_mellin_integrand_eq hc] with L hL
  intro q r jStar E B F
  exact (candidate_box_window_mellin_integrable c L q r jStar E B F).congr
    (Filter.Eventually.of_forall (hL q r jStar E B F))

end Bounty
end

