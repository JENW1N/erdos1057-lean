/- The actual globally extended physical edge phase respects memory reindexing. -/

open Finset Classical
namespace Bounty
section Physical
variable {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    [∀ g, ∀ p : ↥(P g), NeZero p.val]
    (C : Fin N → Finset (Fin J)) (k : ℤ)
    (L R : PhysicalMarkLists P J ell) (H : (g : Fin N) → Finset ↥(P g))
    (q : (g : Fin N) → BoundedOrderedTuple
      (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B)
    (τ : ∀ g, Equiv.Perm (Fin (q g).1.val))
    (e : PhysicalFullEdgeEvent C k (physicalFullMemoryState C L q))

omit [∀ g, ∀ p : ↥(P g), NeZero p.val] in
theorem physical_full_edge_phase_reindex :
    physicalFullEdgePhase C k L R H (fun g => ⟨(q g).1, (q g).2 ∘ τ g⟩)
      (fullEdgeMemoryReindex (fun g (p : ↥(P g)) => p.val)
        (fun g => physicalFullSharedIndices (C g)) B (fun _ => PhysicalAuxLabels P C)
        (physicalFullEdgeDelta C k) (physicalFullEdgeD C)
        (physicalFullMemoryState C L q) τ e) = physicalFullEdgePhase C k L R H q e := by
  unfold physicalFullEdgePhase
  change (if physicalListAdmissible C e.1 L R then _ else 0) = _
  split_ifs
  · unfold fullEdgeLedgerPhase
    apply prod_congr rfl
    intro g _
    change (if unrestrictedEdgeTarget ((q g).2 ∘ τ g) Sigma.fst (e.2 g).2.1
        (residuePromotionReindex _ _ _ (q g).2 (τ g) (e.2 g).2.2.1) (e.2 g).2.2.2 = _ ∧ _
      then (1 : ℂ) else 0) = _
    erw [residue_promotion_reindex_target]
    rfl
  · rfl

theorem physical_full_endpoint_phase_reindex
    (ω : ∀ _c : SharedActiveLabels (fun g => ↥(P g))
      (fun g => physicalFullSharedIndices (ell := ell) (C g)), PhysicalAuxLabels P C → ℝ)
    (μ : (g : Fin N) → ↥(P g) → ℝ) (ρ : ℝ) (V : Fin N → ℝ) :
    physicalFullEndpointPhase C k L H (fun g => ⟨(q g).1, (q g).2 ∘ τ g⟩) ω μ ρ V
      (fullEdgeMemoryReindex (fun g (p : ↥(P g)) => p.val)
        (fun g => physicalFullSharedIndices (C g)) B (fun _ => PhysicalAuxLabels P C)
        (physicalFullEdgeDelta C k) (physicalFullEdgeD C)
        (physicalFullMemoryState C L q) τ e) = physicalFullEndpointPhase C k L H q ω μ ρ V e := by
  unfold physicalFullEndpointPhase
  have hw : fullActiveEdgeEventWeight (fun g (p : ↥(P g)) => p.val)
      (fun g => physicalFullSharedIndices (C g)) B (fun _ => PhysicalAuxLabels P C)
      (physicalFullEdgeDelta C k) (physicalFullEdgeD C) ω μ ρ V
      (physicalFullMemoryState C L (fun g => ⟨(q g).1, (q g).2 ∘ τ g⟩))
      (fullEdgeMemoryReindex (fun g (p : ↥(P g)) => p.val)
        (fun g => physicalFullSharedIndices (C g)) B (fun _ => PhysicalAuxLabels P C)
        (physicalFullEdgeDelta C k) (physicalFullEdgeD C)
        (physicalFullMemoryState C L q) τ e) =
      fullActiveEdgeEventWeight (fun g (p : ↥(P g)) => p.val)
        (fun g => physicalFullSharedIndices (C g)) B (fun _ => PhysicalAuxLabels P C)
        (physicalFullEdgeDelta C k) (physicalFullEdgeD C) ω μ ρ V
        (physicalFullMemoryState C L q) e :=
    full_edge_reindex_weight (fun g (p : ↥(P g)) => p.val)
      (fun g => physicalFullSharedIndices (C g)) B (fun _ => PhysicalAuxLabels P C)
      (physicalFullEdgeDelta C k) (physicalFullEdgeD C) (physicalFullMemoryState C L q)
      τ ω μ ρ V e
  rw [hw]
  split_ifs
  · rfl
  · apply sum_congr rfl
    intro R _
    exact physical_full_edge_phase_reindex C k L R H q τ e

end Physical
end Bounty
