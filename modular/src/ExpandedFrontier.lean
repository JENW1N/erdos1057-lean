/- Exact original selected fine normalization with no supplied residue witness.
Locally incompatible edges vanish in both the raw and normalized histories. -/

open Finset
open scoped Classical
namespace Bounty

section ResiduePath
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ) (η : Fin N → Fin (n + 1) → ℝ)
  (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0) (B : ℕ)

variable
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)


variable [∀ g, ∀ p : ↥(P g), NeZero p.val]

include hstep hlist hP hdis hk in
theorem physical_selected_fine_normalization_without_residues (hρ : ρ ≠ 0) :
    ((∏ g, ∏ s : PhysicalSlots J ell, β g (L 0 g s) / V g : ℝ) : ℂ) *
      finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
        (physicalSelectedFineRow (B := B) C aux L σ τ k β V ρ hV ω retention)
        (4 * n + 1) physicalEmptyMemoryTerminal (physicalInitialMarkState B (L 0)) =
    (∏ i ∈ range (2 * n + 1), physicalSelectedCoarseScalar C aux L σ ω i) *
      (ghostPhaseCappedHistory
        (fun p : PhysicalPrime P => fun j =>
          globalBirthFiniteActivity (physicalGroupBareFiniteActivity L p.1) j p.2)
        (fun p => physicalResidueAbsoluteHit a p.1 p.2)
        (fun _ j => 1 - retention (globalBirthFiniteIndex n j))
        (fun p => β p.1 p.2) (fun p => V p.1)
        (fun _ => B) (fun _ => B) n : ℂ) := by
  by_cases hc : ∀ j : Fin n, ∀ g s t,
    ((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val =
      ((physicalPermuteLabels (τ j) (L j.succ)) g t).val →
    (((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val : ℤ) ∣
      k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ)
  · exact physical_selected_fine_adjacent_normalization C aux k L a σ τ hstep hc
      hlist hP hdis hk β V ρ hV B ω retention hρ
  · rw [physical_selected_fine_history_zero_of_bad C aux k L σ τ β V ρ hV ω retention
      hlist hP hdis hk hc physicalEmptyMemoryTerminal,
      physical_capped_history_zero_of_bad C aux k L a σ τ hstep hc]
    simp only [Complex.ofReal_zero, mul_zero]

end ResiduePath
end Bounty
