section

/- The balanced contribution of two actual full-cell prime proxies. -/

open Finset Filter

namespace Bounty

theorem exists_candidate_balanced_prime_proxy_bound {c q a : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ)*(r : ℝ)*c = 1) (ha : 0 < a) :
    ∃ C : ℝ, 0 < C ∧ ∃ J0 : ℕ, ∀ σ : ℝ,
      ∀ᶠ L : ℝ in atTop, ∀ κ : ℝ, 0 ≤ κ → κ ≤ 1/50 →
      ∀ jStar : ℕ, J0 < jStar → ∀ (F : Finset (ℕ × ℕ))
        (u : ℕ × ℕ → ℕ) (Y Z : ℕ → ℝ),
        (∀ v ∈ F, balancedPairWindow κ L v) →
        (∀ v ∈ F, v.1*v.2 = 2*u v+1) →
        (∀ v ∈ F, Real.exp (a*L) ≤ Y v.1 ∧ Real.exp (a*L) ≤ Z v.2) →
        (∑ v ∈ F, candidateCoefficient c L q r jStar (u v)*
          primeCellProxy L σ (Y v.1) v.1*primeCellProxy L σ (Z v.2) v.2) ≤
          C*(κ+1/L)*candidateCoefficientWindowMass c L q r jStar/L := by
  classical
  obtain ⟨Cb, hCb, J0, hbalanced⟩ :=
    exists_candidate_balanced_normalized_pair_bound hc hr hq0 hq1 hcenter
  obtain ⟨Cp, hCp, hproxy⟩ := exists_prime_cell_proxy_uniform_bound ha
  refine ⟨Cp^2*Cb, by positivity, J0, ?_⟩
  intro σ
  filter_upwards [hbalanced, hproxy σ, eventually_gt_atTop (0 : ℝ)] with L hb hp hL
  intro κ hκ hκup jStar hj F u Y Z hwindow hproduct hbase
  let A := fun v : ℕ × ℕ => candidateCoefficient c L q r jStar (u v)
  let f := fun v : ℕ × ℕ => primeCellProxy L σ (Y v.1) v.1
  let g := fun v : ℕ × ℕ => primeCellProxy L σ (Z v.2) v.2
  let V := ∏ p ∈ primeBand 0 (Real.exp (Real.sqrt L)), (1-1/(p : ℝ))
  let T := F.filter (fun v => f v ≠ 0 ∧ g v ≠ 0)
  have hV : 0 < V := finite_prime_avoidance_product_pos _ (fun _ hp => (mem_filter.mp hp).2)
  have hTF : T ⊆ F := filter_subset _ _
  have hrough : ∀ v ∈ T, ∀ p ∈ primeBand 0 (Real.exp (Real.sqrt L)), ¬p ∣ v.1*v.2 := by
    intro v hv p hpm hpd
    have hfg := (mem_filter.mp hv).2
    have hpp : p.Prime := (mem_filter.mp hpm).2
    rcases hpp.dvd_mul.mp hpd with hpx | hpy
    · exact prime_cell_proxy_avoids_small_primes hfg.1 p hpm hpx
    · exact prime_cell_proxy_avoids_small_primes hfg.2 p hpm hpy
  have hsum : (∑ v ∈ F, A v*f v*g v) = ∑ v ∈ T, A v*f v*g v := by
    symm
    apply sum_subset hTF
    intro v hv hnot
    have hh : ¬(f v ≠ 0 ∧ g v ≠ 0) := fun h => hnot (mem_filter.mpr ⟨hv, h⟩)
    by_cases hf : f v = 0
    · simp only [hf, mul_zero, zero_mul]
    · have hg : g v = 0 := by by_contra hg; exact hh ⟨hf, hg⟩
      simp only [hg, mul_zero]
  have hweights := sum_nonneg_pair_coefficient_bound T A f g
    (K := Cp/(L*V)) (by positivity)
    (fun v _ => candidate_coefficient_nonneg c L hq0 r jStar (u v))
    (fun v hv => (hp (Y v.1) (hbase v (hTF hv)).1 v.1).2.2)
    (fun v _ => prime_cell_proxy_nonneg L σ (Z v.2) v.2)
    (fun v hv => (hp (Z v.2) (hbase v (hTF hv)).2 v.2).2.2)
  have hnorm := hb κ hκ hκup jStar hj T u
    (fun v hv => hwindow v (hTF hv)) (fun v hv => hproduct v (hTF hv)) hrough
  change (∑ v ∈ F, A v*f v*g v) ≤ _
  rw [hsum]
  calc
    _ ≤ (Cp/(L*V))^2*(∑ v ∈ T, A v) := hweights
    _ = Cp^2*((∑ v ∈ T, A v)/(L^2*V^2)) := by ring
    _ ≤ Cp^2*(Cb*(κ+1/L)*candidateCoefficientWindowMass c L q r jStar/L) :=
      mul_le_mul_of_nonneg_left hnorm (sq_nonneg Cp)
    _ = _ := by ring

end Bounty
end

