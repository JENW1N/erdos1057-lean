    (tail : FullPermutationMixedPath n S B A Δ D steps
      (fullPermutationMixedEventTarget n S B A Δ D (some (.inl j)) s
        ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩)))

theorem full_mixed_ghost_head_sample_coverage
    (i : Fin (Fintype.card (FullMixedBirthAddress S B (some (.inl j) :: steps)))) :
    (fullMixedPathBirthPerformed n S B A Δ D (some (.inl j) :: steps) s
        ⟨(fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩, tail⟩
