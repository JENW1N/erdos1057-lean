theorem norm_weighted_prime_sum_sub_primitive_le {q : ℕ} (hq : 0 < q)
    (χ : DirichletCharacter ℂ q) (S : Finset ℕ) (hS : ∀ p ∈ S, p.Prime)
    (w : ℕ → ℝ) {W : ℝ} (hW : 0 ≤ W)
    (hw : ∀ p ∈ S, 0 ≤ w p) (hwW : ∀ p ∈ S, w p ≤ W) :
    ‖(∑ p ∈ S, w p • χ (p : ZMod q)) -
      ∑ p ∈ S, w p • χ.primitiveCharacter (p : ZMod χ.conductor)‖ ≤
      W * (q.primeFactors.card : ℝ) := by
  classical
  rw [← Finset.sum_sub_distrib]
  calc
    _ ≤ ∑ p ∈ S, ‖w p • χ (p : ZMod q) -
        w p • χ.primitiveCharacter (p : ZMod χ.conductor)‖ := norm_sum_le _ _
    _ ≤ ∑ p ∈ S, if p ∈ q.primeFactors then W else 0 := by
      apply Finset.sum_le_sum
      intro p hp
      rw [← smul_sub, norm_smul, Real.norm_eq_abs, abs_of_nonneg (hw p hp)]
      have he := primitive_prime_value_error hq χ (hS p hp)
      by_cases hmem : p ∈ q.primeFactors
      · rw [if_pos hmem] at he ⊢
        exact (mul_le_mul_of_nonneg_left he (hw p hp)).trans (by simpa using hwW p hp)
      · rw [if_neg hmem] at he ⊢
        exact (mul_le_mul_of_nonneg_left he (hw p hp)).trans (by simp)
    _ = W * ((S.filter fun p => p ∈ q.primeFactors).card : ℝ) := by
      rw [← Finset.sum_filter]
      simp [mul_comm]
    _ ≤ W * (q.primeFactors.card : ℝ) := by
      apply mul_le_mul_of_nonneg_left _ hW
      exact_mod_cast (Finset.card_le_card (show
        (S.filter fun p => p ∈ q.primeFactors) ⊆ q.primeFactors from
          fun p hp => (Finset.mem_filter.mp hp).2))

theorem norm_reciprocal_prime_sum_sub_primitive_le {q : ℕ} (hq : 0 < q)
    (χ : DirichletCharacter ℂ q) (S : Finset ℕ) (hS : ∀ p ∈ S, p.Prime)
    {a : ℝ} (ha : 0 < a) (haS : ∀ p ∈ S, a ≤ (p : ℝ)) :
    ‖(∑ p ∈ S, (1 / (p : ℝ)) • χ (p : ZMod q)) -
      ∑ p ∈ S, (1 / (p : ℝ)) •
        χ.primitiveCharacter (p : ZMod χ.conductor)‖ ≤
      (q.primeFactors.card : ℝ) / a := by
  calc
    _ ≤ (1 / a) * (q.primeFactors.card : ℝ) :=
      norm_weighted_prime_sum_sub_primitive_le hq χ S hS (fun p => 1 / (p : ℝ))
        (by positivity : 0 ≤ 1 / a) (fun p hp => by positivity)
        (fun p hp => one_div_le_one_div_of_le ha (haS p hp))
    _ = _ := by ring

theorem norm_reciprocal_prime_sum_sub_primitive_le_two_log {q : ℕ} (hq : 0 < q)
    (χ : DirichletCharacter ℂ q) (S : Finset ℕ) (hS : ∀ p ∈ S, p.Prime)
    {a : ℝ} (ha : 0 < a) (haS : ∀ p ∈ S, a ≤ (p : ℝ)) :
    ‖(∑ p ∈ S, (1 / (p : ℝ)) • χ (p : ZMod q)) -
      ∑ p ∈ S, (1 / (p : ℝ)) •
        χ.primitiveCharacter (p : ZMod χ.conductor)‖ ≤
      2 * Real.log q / a := by
  exact (norm_reciprocal_prime_sum_sub_primitive_le hq χ S hS ha haS).trans
    (div_le_div_of_nonneg_right (primeFactors_card_le_two_log hq) ha.le)

theorem reciprocal_prime_induction_error_absorbed {q x : ℝ}
    (hq : 1 ≤ q) (hx : 2 ≤ x) :
    2 * Real.log q / x ≤
      4 * x ^ (-(1 : ℝ) / 32) * (1 + Real.log q / Real.log x) := by
  have hx0 : 0 < x := by linarith
  have hlx : 0 < Real.log x := Real.log_pos (by linarith)
  have hlq : 0 ≤ Real.log q := Real.log_nonneg hq
  have hr : 0 < x ^ (-(1 : ℝ) / 32) := Real.rpow_pos_of_pos hx0 _
  have hp : x ^ ((31 : ℝ) / 32) = x * x ^ (-(1 : ℝ) / 32) := by
    calc
      _ = x ^ ((1 : ℝ) + (-(1 : ℝ) / 32)) := by norm_num
      _ = _ := by rw [Real.rpow_add hx0, Real.rpow_one]
  have hlog : Real.log x ≤ 2 * (x * x ^ (-(1 : ℝ) / 32)) := by
    have hh := Real.log_le_rpow_div hx0.le (by norm_num : (0 : ℝ) < 31 / 32)
    rw [hp] at hh
    have hxp : 0 ≤ x * x ^ (-(1 : ℝ) / 32) := by positivity
    linarith
  have hratio : Real.log x / x ≤ 2 * x ^ (-(1 : ℝ) / 32) :=
    (div_le_iff₀ hx0).mpr (by nlinarith [hlog])
  calc
    2 * Real.log q / x =
        (2 * (Real.log q / Real.log x)) * (Real.log x / x) := by
      field_simp
    _ ≤ (2 * (Real.log q / Real.log x)) * (2 * x ^ (-(1 : ℝ) / 32)) :=
      mul_le_mul_of_nonneg_left hratio (by positivity)
    _ ≤ _ := by nlinarith

theorem norm_reciprocal_prime_sum_sub_primitive_le_decay {q : ℕ} (hq : 0 < q)
    (χ : DirichletCharacter ℂ q) (S : Finset ℕ) (hS : ∀ p ∈ S, p.Prime)
    {a : ℝ} (ha : 2 ≤ a) (haS : ∀ p ∈ S, a ≤ (p : ℝ)) :
    ‖(∑ p ∈ S, (1 / (p : ℝ)) • χ (p : ZMod q)) -
      ∑ p ∈ S, (1 / (p : ℝ)) •
        χ.primitiveCharacter (p : ZMod χ.conductor)‖ ≤
      4 * a ^ (-(1 : ℝ) / 32) * (1 + Real.log q / Real.log a) := by
  exact (norm_reciprocal_prime_sum_sub_primitive_le_two_log hq χ S hS
    (by linarith : 0 < a) haS).trans
      (reciprocal_prime_induction_error_absorbed (by exact_mod_cast hq) ha)
end

