section

/- The complete signed prime family on the original physical full state,
including exact small-residue translation on every auxiliary fiber. The
fixed initial gate only tests fresh births, and all event choices remain. -/

open Finset
open scoped Classical

namespace Bounty

theorem clean_weighted_norm_eq_active_product {X R : Type*} [Fintype X] [Fintype R]
    (w : X → ℝ) (f : X → R → ℂ) :
    cleanWeightedNorm w f = cleanActiveNorm (fun z : X × R => w z.1) (fun z => f z.1 z.2) := by
  unfold cleanWeightedNorm cleanActiveNorm
  rw [Fintype.sum_prod_type]
  simp only [mul_sum]

theorem finite_family_clean_weighted_norm_le {I X R : Type*}
    [Fintype I] [Fintype X] [Fintype R]
    (w : X → ℝ) (hw : ∀ x, 0 ≤ w x) (f : X → R → ℂ) (g : I → X → R → ℂ)
    (b : I → ℝ) (A : ℝ) (hA : 0 ≤ A) {H : ℝ} (hH : ∑ i, b i ≤ H)
    (hg : ∀ i, cleanWeightedNorm w (g i) ≤ b i * A * cleanWeightedNorm w f) :
    cleanWeightedNorm w (∑ i, g i) ≤ H * A * cleanWeightedNorm w f := by
  have ht : cleanWeightedNorm w (∑ i, g i) ≤ ∑ i, cleanWeightedNorm w (g i) := by
    simp only [clean_weighted_norm_eq_active_product]
    have h := clean_active_norm_sum_le (fun z : X × R => w z.1) (fun z => hw z.1) univ
      (fun i z => g i z.1 z.2)
    have he : (fun z : X × R => (∑ i, g i) z.1 z.2) =
        (∑ i, fun z : X × R => g i z.1 z.2) := by
      funext z
      simp only [Finset.sum_apply]
    rw [he]
    exact h
  calc
    _ ≤ ∑ i, cleanWeightedNorm w (g i) := ht
    _ ≤ ∑ i, b i * A * cleanWeightedNorm w f := sum_le_sum fun i _ => hg i
    _ = (∑ i, b i) * A * cleanWeightedNorm w f := by rw [sum_mul, sum_mul]
    _ ≤ _ := mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right hH hA) (Real.sqrt_nonneg _)

noncomputable def physicalPrimeFullSmallPatternAction {S : Type*} (Ps : S → Finset ℕ) {N J ell B : ℕ}
    (P : Fin N → Finset ℕ) [∀ g (p : P g), NeZero p.val]
    (V : Fin N → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ)
    (probes : Fin N → Finset (Fin J)) (r t : Finset (Fin N)) (hrt : Disjoint r t)
    (Q : ℕ) (h xi : ℝ) (k : ℤ) (F : ∀ g, Finset (P g))
    (φ : ∀ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      ∀ x : PhysicalFullBoundedState P J ell B,
      PhysicalResidues Ps → PhysicalFullEdgeEvent (repeatedBigPrimePatternCut probes r t i) k x → ℂ)
    (f : PhysicalFullBoundedState P J ell B → PhysicalResidues Ps → ℂ) : PhysicalFullBoundedState P J ell B → PhysicalResidues Ps → ℂ :=
  let kept := fun U : Finset (RepeatedBigFlatIndex (Fin N) J ell) => primeProductRetainedCells
    (fun j : U => P j.val.1) (fun j => V j.val.1) h xi
  ∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
    physicalFullSmallCoefficientAction Ps (repeatedBigPrimePatternCut probes r t i) k V baseline ρ F
      (fun x rs e => repeatedBigPrimePatternWeight probes r t i *
        repeatedBigPrimePatternKernel P V probes r t hrt Q h kept i
          (physicalFullRepeatedLabels (repeatedBigPrimePatternCut probes r t i) x)
          (physicalFullRepeatedLabels (repeatedBigPrimePatternCut probes r t i)
            (fullActiveEdgeEventTarget (fun g (p : P g) => p.val)
              (fun g => physicalFullSharedIndices (ell := ell) (repeatedBigPrimePatternCut probes r t i g)) B
              (fun _ => PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
              (physicalFullEdgeDelta (repeatedBigPrimePatternCut probes r t i) k)
              (physicalFullEdgeD (repeatedBigPrimePatternCut probes r t i)) x e)) e.1 * φ i x rs e) f

theorem physical_prime_full_small_pattern_projected_norm_le {S : Type*} [Fintype S]
    (Ps : S → Finset ℕ) [∀ p : PhysicalPrime Ps, NeZero p.2.val] {N J ell B m : ℕ}
    (P : Fin N → Finset ℕ) [∀ g (p : P g), NeZero p.val]
    (V : Fin N → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ)
    (probes : Fin N → Finset (Fin J)) (r t : Finset (Fin N)) (hrt : Disjoint r t)
    (hp : ∀ g, (probes g).card ≤ m) (Q : ℕ) (h xi : ℝ) (hxi : 0 < xi)
    (k : ℤ) (F : ∀ g, Finset (P g))
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (hbaseline : ∀ g p, 1 / 2 ≤ baseline g p ∧ baseline g p ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (φ : ∀ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      ∀ x : PhysicalFullBoundedState P J ell B,
      PhysicalResidues Ps → PhysicalFullEdgeEvent (repeatedBigPrimePatternCut probes r t i) k x → ℂ)
    (hφ : ∀ i x rs e, ‖φ i x rs e‖ ≤ 1)
    (f : PhysicalFullBoundedState P J ell B → PhysicalResidues Ps → ℂ) (hf : ∀ rs, ProductMemorySymmetric (fun x => f x rs)) :
    let μ := fun g => tiltedPhysicalBirthLaw V g (baseline g)
    cleanWeightedNorm (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fun x rs => fullActiveAverage (fun y =>
        physicalPrimeFullSmallPatternAction Ps P V baseline ρ probes r t hrt Q h xi k F φ
          (fun z s => fullActiveAverage (fun w => f w s) z) y rs) x) ≤
      repeatedBigFamilyEnvelope N m Q xi *
        Real.sqrt (unrestrictedEdgeEnergyBound ρ v vmin vmax (ell + m) ^ N) *
          cleanWeightedNorm (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  intro μ
  let C := repeatedBigPrimePatternCut (ell := ell) probes r t
  let kept := fun U : Finset (RepeatedBigFlatIndex (Fin N) J ell) => primeProductRetainedCells
    (fun j : U => P j.val.1) (fun j => V j.val.1) h xi
  let K := repeatedBigPrimePatternKernel P V probes r t hrt Q h kept
  let b := repeatedBigPrimePatternBound (ell := ell) probes r t Q xi
  let Ψ := fun i x rs (e : PhysicalFullEdgeEvent (B := B) (C i) k x) =>
    repeatedBigPrimePatternWeight probes r t i * K i (physicalFullRepeatedLabels (C i) x)
      (physicalFullRepeatedLabels (C i) (fullActiveEdgeEventTarget (fun g (p : P g) => p.val)
        (fun g => physicalFullSharedIndices (ell := ell) (C i g)) B
        (fun _ => PhysicalAuxLabels P (C i)) (physicalFullEdgeDelta (C i) k)
        (physicalFullEdgeD (C i)) x e)) e.1 * φ i x rs e
  have hb : ∀ i, 0 ≤ b i := repeated_big_prime_pattern_bound_nonneg probes r t Q xi
  have hΨ : ∀ i x rs e, ‖Ψ i x rs e‖ ≤ b i := by
    intro i x rs e
    dsimp only [Ψ]
    rw [norm_mul, norm_mul, repeated_big_prime_pattern_weight_norm, one_mul]
    exact (mul_le_mul_of_nonneg_right
      (repeated_big_prime_pattern_kernel_norm_le P V probes r t hrt Q h xi hxi i _ _ _)
      (norm_nonneg _)).trans ((mul_le_mul_of_nonneg_left (hφ i x rs e) (hb i)).trans_eq (mul_one _))
  have hsum : ∑ i, b i ≤ repeatedBigFamilyEnvelope N m Q xi := by
    apply (repeated_big_prime_pattern_bound_sum_le (ell := ell) probes r t hp Q xi).trans
    apply add_le_add le_rfl
    apply mul_le_mul_of_nonneg_right _ (sq_nonneg _)
    apply pow_le_pow_right₀ (by norm_num : (1 : ℝ) ≤ 2)
    apply Nat.mul_le_mul_left
    rw [← card_union_of_disjoint hrt]
    exact (card_le_univ _).trans_eq (Fintype.card_fin N)
  have hμ : ∀ g p, 0 ≤ μ g p := by
    intro g p
    exact tiltedPhysicalBirthLaw_nonneg V g (baseline g) (hvmin.trans_le (hVlo g)).le
      (fun p => (by norm_num : (0 : ℝ) ≤ 1/2).trans (hbaseline g p).1) p
  let g := fun i x rs => fullActiveAverage (fun y =>
    physicalFullSmallCoefficientAction Ps (C i) k V baseline ρ F (Ψ i)
      (fun z s => fullActiveAverage (fun w => f w s) z) y rs) x
  have heq : (fun x rs => fullActiveAverage (fun y =>
      physicalPrimeFullSmallPatternAction Ps P V baseline ρ probes r t hrt Q h xi k F φ
        (fun z s => fullActiveAverage (fun w => f w s) z) y rs) x) = ∑ i, g i := by
    funext x rs
    simp only [physicalPrimeFullSmallPatternAction, fullActiveAverage, Finset.sum_apply, mul_sum, g]
    exact sum_comm
  rw [heq]
  apply finite_family_clean_weighted_norm_le _
    (productMemoryWeight_nonneg μ _ hμ (fun g z => hμ g z.1)) f g b
    (Real.sqrt (unrestrictedEdgeEnergyBound ρ v vmin vmax (ell+m) ^ N))
    (Real.sqrt_nonneg _) hsum
  intro i
  exact physical_full_small_coefficient_projected_norm_le Ps (C i) k V baseline ρ F hMass hbaseline
    hρ0 hρ1 hv hvmin hVlo hVhi (ell+m)
    (fun g => Nat.add_le_add_left (repeated_big_prime_pattern_cut_card_le probes r t hp i g) ell)
    (Ψ i) (b i) (hb i) (hΨ i) f hf

theorem physical_prime_full_small_pattern_projected_norm_le_rpow {S : Type*} [Fintype S]
    (Ps : S → Finset ℕ) [∀ p : PhysicalPrime Ps, NeZero p.2.val] {N J ell B m : ℕ}
    (P : Fin N → Finset ℕ) [∀ g (p : P g), NeZero p.val]
    (V : Fin N → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ)
    (probes : Fin N → Finset (Fin J)) (r t : Finset (Fin N)) (hrt : Disjoint r t)
    (hp : ∀ g, (probes g).card ≤ m) (Q : ℕ) (h xi : ℝ) (hxi : 0 < xi)
    (k : ℤ) (F : ∀ g, Finset (P g))
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (hbaseline : ∀ g p, 1 / 2 ≤ baseline g p ∧ baseline g p ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (φ : ∀ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      ∀ x : PhysicalFullBoundedState P J ell B,
      PhysicalResidues Ps → PhysicalFullEdgeEvent (repeatedBigPrimePatternCut probes r t i) k x → ℂ)
    (hφ : ∀ i x rs e, ‖φ i x rs e‖ ≤ 1)
    {L a q x : ℝ} (hL : 2 ≤ L) (ha : 0 ≤ a) (hq : 0 ≤ q) (hx : 0 ≤ x)
    (hgroups : (N : ℝ) ≤ a * Real.log L) (hQ : (Q : ℝ) ≤ L ^ q)
    (hcut : L ^ (-x) ≤ xi)
    (f : PhysicalFullBoundedState P J ell B → PhysicalResidues Ps → ℂ)
    (hf : ∀ rs, ProductMemorySymmetric (fun x => f x rs)) :
    let μ := fun g => tiltedPhysicalBirthLaw V g (baseline g)
    cleanWeightedNorm (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fun z rs => fullActiveAverage (fun y =>
        physicalPrimeFullSmallPatternAction Ps P V baseline ρ probes r t hrt Q h xi k F φ
          (fun w s => fullActiveAverage (fun u => f u s) w) y rs) z) ≤
      L ^ ((m : ℝ) * a * Real.log 2 + 4*q + 2*x +
        (a/2) * Real.log (max 1 (unrestrictedEdgeEnergyBound ρ v vmin vmax (ell+m))) + 1) *
          cleanWeightedNorm (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  intro μ
  apply (physical_prime_full_small_pattern_projected_norm_le Ps P V baseline ρ probes r t hrt hp
    Q h xi hxi k F hMass hbaseline hρ0 hρ1 hv hvmin hVlo hVhi φ hφ f hf).trans
  apply mul_le_mul_of_nonneg_right _ (Real.sqrt_nonneg _)
  exact repeated_big_family_norm_cost_le N m Q hL ha hq hx
    (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax (ell+m)) hgroups hQ hcut

end Bounty
