section

/- The actual projected clean-hybrid row, including tilt and auxiliary
collision bans and initial-ledger avoidance, specialized to the signed prime-comparison family. -/

open Finset Filter
open scoped Classical

namespace Bounty

theorem eventually_repeated_big_prime_initial_clean_norm_le
    (hZ : PrimitiveZeroFreeHalfPlane) (c s z a v D ε : ℝ) (m : ℕ)
    (hc : 0 < c) (hs : 0 ≤ s) (hz : 0 ≤ z) (ha : 0 ≤ a)
    (hv : 0 < v) (hD : 0 ≤ D) (hε : 0 < ε) (hm : 0 < m) :
    let κ := a * Real.log (primeFiberFactorBound v m)
    let s' := s + ε
    let A₀ := D + 2 * (s' + 1)
    let q := 2 * κ + (s' + 1) + 2 * A₀ + 3
    let w := 4 * q + max z q + A₀ + 2
    let x := (s' + w + 2) + 2 * A₀ + 2
    ∀ᶠ L : ℝ in atTop,
    let Q := ⌊L ^ q⌋₊
    let h := L ^ (-w)
    let ξ := L ^ (-x)
    ∀ {G : Type} [Fintype G] [DecidableEq G] (J ell : ℕ),
    ∀ (P : G → Finset ℕ) (V : G → ℝ),
    Pairwise (fun g h => Disjoint (P g) (P h)) →
    (∀ g p, p ∈ P g → p.Prime ∧ Q < p) →
    (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) →
    (∀ g, v ≤ V g) →
    (∀ g p, p ∈ P g → Real.log p ≤ L ^ s) →
    (Fintype.card G : ℝ) ≤ a * Real.log L →
    (∀ g, ∃ a b : ℝ, P g = primeBand a b ∧ Real.exp (L ^ c) ≤ a ∧ 0 ≤ b) →
    ∀ probes : G → Finset (Fin J), (∀ g, (probes g).card = m) →
    ∀ r t : Finset G, ∀ hrt : Disjoint r t,
    ∀ ζ θ : ℝ, |ζ| ≤ L ^ z →
    ∀ F : ∀ g, Finset (P g),
    let slots := fun g => (probes g).map (Function.Embedding.inl (β := Fin ell))
    let kept := fun U : Finset (RepeatedBigFlatIndex G J ell) => primeProductRetainedCells
      (fun i : U => P i.1.1) (fun i => V i.1.1) h ξ
    let C := repeatedBigPrimePatternCut (ell := ell) probes r t
    let K₀ := repeatedBigPrimePatternKernel P V probes r t hrt Q h kept
    let K := fun i => cleanInitialBirthKernel F (C i) (K₀ i)
    let weights := repeatedBigPrimePatternWeight (ell := ell) probes r t
    let bounds := repeatedBigPrimePatternBound (ell := ell) probes r t Q ξ
    ∀ (b : ∀ g, P g → ℝ), (∀ g p, 0 < b g p) →
    ∀ T Pmin : ℝ, 0 ≤ T → 0 < Pmin →
    (∀ g (p : P g), Pmin ≤ (p.val : ℝ)) →
    (∀ g (p : P g), b g p = 1 - T / (p.val : ℝ)) →
    (∀ i, ((2 * ∑ g, (ell + (C i g).card) : ℕ) : ℝ) * T / Pmin ≤ 1 / 2) →
    ∀ (S : Type) [Fintype S] (Ps : S → Finset ℕ) (N : G → ℕ) (k : ℤ)
      (p : FixedOrderedMemoryLabels P N),
    ∀ [∀ q : PhysicalPrime Ps, NeZero q.2.val] [∀ g j, NeZero (p g j).val],
    ∀ (d : PhysicalSharedLists Ps J)
      (f : RepeatedBigLists P J ell → (PhysicalResidues Ps × FixedOrderedResidues p) → ℂ),
    cleanWeightedNorm (repeatedBigActiveMass V b)
      (cleanActiveMap repeatedBigSymmetrizeLinear
        (cleanHybridPatternCoreAction V b C ζ θ k p
          (fun i source target aux => weights i * K i source target aux) d
          (cleanActiveMap repeatedBigSymmetrizeLinear f))) ≤
      (Real.sqrt (((ell : ℝ) ^ ell / (m : ℝ) ^ ell) ^ r.card) +
        Real.sqrt (((ell : ℝ) ^ ell / (m : ℝ) ^ ell) ^ t.card) +
        (3 : ℝ) ^ ((r.sigma slots).card + (t.sigma slots).card) * L ^ (-D) +
        ∑ i, ‖weights i‖ * (bounds i * Real.sqrt
          (repeatedBigInitialForbiddenProbability (ell := ell) V (C i) F Pmin)) +
        ∑ i, repeatedBigPatternError (ell := ell) V (C i) T Pmin (bounds i)) *
        cleanWeightedNorm (repeatedBigActiveMass V b) f := by
  intro κ s' A₀ q w x
  filter_upwards [eventually_repeated_big_prime_pattern_norm_le
    hZ c s z a v D ε m hc hs hz ha hv hD hε hm, eventually_gt_atTop (0 : ℝ)] with L hnorm hL
  intro Q h ξ G _ dG
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  intro J ell P V hdisj hP hmass hV hlog hcard hband
    probes hp r t hrt ζ θ hζ F slots kept C K₀ K weights bounds b hbpos T Pmin hT hPmin
    hpmin hb hsmall S _ Ps N k p _ _ d f
  have hξ : 0 < ξ := Real.rpow_pos_of_pos hL _
  have hbounds : ∀ i, 0 ≤ bounds i :=
    fun i => repeated_big_prime_pattern_bound_nonneg probes r t Q ξ i
  have hK₀ : ∀ i source target aux, ‖K₀ i source target aux‖ ≤ bounds i := by
    intro i source target aux
    exact repeated_big_prime_pattern_kernel_norm_le
      P V probes r t hrt Q h ξ hξ i source target aux
  have hK : ∀ i source target aux, ‖K i source target aux‖ ≤ bounds i := by
    intro i source target aux
    dsimp only [K, cleanInitialBirthKernel]
    split_ifs
    · exact hK₀ i source target aux
    · simpa only [norm_zero] using hbounds i
  let M := Real.sqrt (((ell : ℝ) ^ ell / (m : ℝ) ^ ell) ^ r.card) +
    Real.sqrt (((ell : ℝ) ^ ell / (m : ℝ) ^ ell) ^ t.card) +
    (3 : ℝ) ^ ((r.sigma slots).card + (t.sigma slots).card) * L ^ (-D)
  let Einit := ∑ i, ‖weights i‖ * (bounds i * Real.sqrt
    (repeatedBigInitialForbiddenProbability (ell := ell) V (C i) F Pmin))
  have hM : 0 ≤ M := by dsimp [M]; positivity
  have hEinit : 0 ≤ Einit := sum_nonneg fun i _ =>
    mul_nonneg (norm_nonneg _) (mul_nonneg (hbounds i) (Real.sqrt_nonneg _))
  have hideal : ∀ (Θ : ℝ) (u : RepeatedBigLists P J ell → ℂ),
      u ∈ repeatedBigSymmetricSubspace →
      cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
        (repeatedBigSymmetrizeLinear (fun source => ∑ target,
          (∑ i, ∑ aux, weights i * repeatedBigUnbannedKernel V (fun _ _ => 1)
            (C i) ζ (K₀ i) aux source target *
              physicalReturnPhase Θ (repeatedBigD (C i) source aux)) * u target)) ≤
        M * cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) u := by
    intro Θ u hu
    exact hnorm J ell P V hdisj hP hmass hV hlog hcard hband
      probes hp r t hrt ζ Θ hζ u hu
  have hmasked := repeated_big_initial_birth_masked_ideal V C F
    (fun g => hv.trans_le (hV g)) hmass ζ K₀ weights bounds hbounds hK₀
    hPmin hpmin M hideal
  have hbound := clean_hybrid_symmetric_pattern_norm_le_of_unbanned
    (I := RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (S := S) (G := G) (Ps := Ps) (Pb := P) (J := J) (ell := ell) (N := N)
    V (fun j => hv.trans_le (hV j)) hmass b hbpos C ζ θ k p K weights bounds
    hbounds hK hT hPmin hpmin hb hsmall d
    (M + Einit) (add_nonneg hM hEinit) hmasked f
  refine hbound.trans ?_
  apply mul_le_mul_of_nonneg_right _ (Real.sqrt_nonneg _)
  apply add_le_add le_rfl
  apply sum_le_sum
  intro i _
  rw [show ‖weights i‖ = 1 from repeated_big_prime_pattern_weight_norm probes r t i, one_mul]

end Bounty
end

section

/- Exact physical history normalization under adjacent common-mark compatibility.
No global residue assignment is supplied; all original local rows and cutoffs remain. -/

open Finset
open scoped Classical
namespace Bounty

section ResiduePath
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (hcompat : ∀ j : Fin n, ∀ g s t,
    ((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val =
      ((physicalPermuteLabels (τ j) (L j.succ)) g t).val →
    (((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val : ℤ) ∣
      k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ) (η : Fin N → Fin (n + 1) → ℝ)
  (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0) (B : ℕ)

variable
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)

include hstep in
theorem physical_selected_coarse_adjacent_extension (i : ℕ) (hi : i < 2 * n + 1)
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    physicalMarkRawExtension
      (physicalSelectedCoarseRow (B := B) C aux k L σ τ β V ρ hV ω retention i F)
      (physicalMarkAtCut L i) =
      fun s => physicalSelectedCoarseScalar C aux L σ ω i *
        globalBirthJointCutRawRow
          (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β
            (fun _ j => 1 - retention j) V (fun _ => ρ) hV B i) B B
          (physicalMarkRawExtension F (physicalMarkAtCut L (i + 1))) s := by
  by_cases he : i % 2 = 0
  · let j : Fin (n + 1) := ⟨i / 2, by omega⟩
    have hiEq : i = 2 * j.val := by dsimp [j]; omega
    rw [hiEq, physical_selected_coarse_row_even,
      physical_mark_at_cut_even, physical_mark_at_cut_odd, physical_selected_coarse_scalar_even]
    simp only [one_mul]
    exact physical_selected_adjacent_visit_extension C aux k L a σ τ hcompat
      hlist hP hdis hk β V ρ hV B ω retention j F
  · let j : Fin n := ⟨i / 2, by omega⟩
    have hiEq : i = 2 * j.val + 1 := by dsimp [j]; omega
    have hnext : 2 * j.val + 1 + 1 = 2 * j.succ.val := by simp only [Fin.val_succ]; omega
    have hsource : physicalMarkAtCut L (2 * j.val + 1) = L j.castSucc :=
      physical_mark_at_cut_odd L j.castSucc
    have htarget : physicalMarkAtCut L (2 * j.val + 1 + 1) = L j.succ := by
      rw [hnext, physical_mark_at_cut_even]
    rw [hiEq, physical_selected_coarse_row_odd, hsource, htarget,
      physical_selected_coarse_scalar_odd]
    exact physical_selected_adjacent_edge_extension C aux k L a σ τ hstep hcompat
      hlist hP hdis hk β (fun _ j => 1 - retention j) V ρ hV B ω retention j F

include hstep in
theorem physical_selected_coarse_adjacent_composition
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    physicalMarkRawExtension
      (finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
        (physicalSelectedCoarseRow (B := B) C aux k L σ τ β V ρ hV ω retention) (2 * n + 1) F)
      (L 0) =
      finiteRowComposition (S := fun _ => GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val))
        (fun i G s => physicalSelectedCoarseScalar C aux L σ ω i *
          globalBirthJointCutRawRow
            (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β
              (fun _ j => 1 - retention j) V (fun _ => ρ) hV B i) B B G s)
        (2 * n + 1) (physicalMarkRawExtension F (L (Fin.last n))) := by
  have h := finite_row_composition_test_maps
    (S := fun _ => GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val))
    (T := fun _ => PhysicalBoundedMarkState P J ell B)
    (fun i G s => physicalSelectedCoarseScalar C aux L σ ω i *
      globalBirthJointCutRawRow
        (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β
          (fun _ j => 1 - retention j) V (fun _ => ρ) hV B i) B B G s)
    (physicalSelectedCoarseRow (B := B) C aux k L σ τ β V ρ hV ω retention)
    (fun i G => physicalMarkRawExtension G (physicalMarkAtCut L i)) (2 * n + 1)
    (fun i hi G => physical_selected_coarse_adjacent_extension C aux k L a σ τ hstep hcompat
      hlist hP hdis hk β V ρ hV B ω retention i hi G) F
  have hfirst : physicalMarkAtCut L 0 = L 0 := by
    simpa using physical_mark_at_cut_even L (0 : Fin (n + 1))
  have hlast : physicalMarkAtCut L (2 * n + 1) = L (Fin.last n) := by
    simpa using physical_mark_at_cut_odd L (Fin.last n)
  simpa only [hfirst, hlast] using h

end ResiduePath
end Bounty
end

section

/- Exact Fourier reconstruction of original fixed-forest path sums from complete signed rows. -/

open Finset Classical MeasureTheory
namespace Bounty
section Fourier
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
    [∀ g, Fintype (P g)] [∀ g, DecidableEq (P g)]
    (n : (g : Fin N) → P g → ℕ) [∀ g p, NeZero (n g p)]
    {M : Fin N → ℕ} (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (edgePhase : ∀ k, ((g : Fin N) → Finset (P g)) →
      (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) →
      FullActiveEdgeEvent n (S k) B (A k) (Δ k) (D k) s → ℂ)
    (ω : ∀ k c, A k c → ℝ) (μ : (g : Fin N) → P g → ℝ)
    (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (steps : List (Option (J ⊕ K))) (initial : (g : Fin N) → Finset (P g))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))
    (encode : ((g : Fin N) × P g) → ℤ)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)

theorem full_mixed_forest_rows_eq_weighted_paths
    (θ : (Fin (Fintype.card (FullMixedBirthAddress S B steps)) ×
      Fin (Fintype.card (FullMixedBirthAddress S B steps))) → ℝ) :
    let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
    let _ := finiteEventPathFintype (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x
    finiteOperatorListAction
      (fullMixedForestStageRow n S B A Δ D ω μ q ρ V steps
        (fullMixedBirthResidualPhase n S B A Δ D edgePhase) initial code θ encode)
      (List.finRange steps.length) f x =
      ∑ p : FullPermutationMixedPath n S B A Δ D steps x,
        f (finiteEventPathTerminal (FullPermutationMixedEvent n S B A Δ D)
          (fullPermutationMixedEventTarget n S B A Δ D) steps x p) *
        fullMixedResidualPathWeight n S B A Δ D edgePhase ω μ q ρ V steps (fun _ => initial) x p *
        ∏ i : Fin steps.length, fullMixedBirthOperationMultiplier n S B A Δ D steps code θ encode x p i := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
  let _ := finiteEventPathFintype (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) steps x
  dsimp only
  have heq := congrFun (finite_occurrence_phased_rows_eq_paths
    (FullPermutationMixedEvent n S B A Δ D) (fullPermutationMixedEventTarget n S B A Δ D)
    (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V) steps
    (fullMixedForestStagePhase n S B A Δ D steps
      (fullMixedBirthResidualPhase n S B A Δ D edgePhase) initial code θ encode) f) x
  change finiteOperatorListAction
    (fullMixedForestStageRow n S B A Δ D ω μ q ρ V steps
      (fullMixedBirthResidualPhase n S B A Δ D edgePhase) initial code θ encode)
    (List.finRange steps.length) f x = _ at heq
  rw [heq]
  unfold finiteEventPathAction
  apply sum_congr rfl
  intro p _
  dsimp only
  rw [full_mixed_forest_phase_product]
  unfold fullMixedResidualPathWeight
  dsimp only
  ring_nf

theorem full_mixed_forest_path_sum_eq_fourier_rows :
    let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
    let _ := finiteEventPathFintype (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x
    birthForestPathSum (univ : Finset (FullPermutationMixedPath n S B A Δ D steps x))
      (fun p => f (finiteEventPathTerminal (FullPermutationMixedEvent n S B A Δ D)
          (fullPermutationMixedEventTarget n S B A Δ D) steps x p) *
        fullMixedResidualPathWeight n S B A Δ D edgePhase ω μ q ρ V steps (fun _ => initial) x p)
      (fullMixedIndexedBirthPerformed n S B A Δ D steps x)
      (fullMixedIndexedBirthValue n S B A Δ D steps encode x) code =
      ∫ θ, finiteOperatorListAction
        (fullMixedForestStageRow n S B A Δ D ω μ q ρ V steps
          (fullMixedBirthResidualPhase n S B A Δ D edgePhase) initial code θ encode)
        (List.finRange steps.length) f x
        ∂birthFourierCubeMeasure (Fin (Fintype.card (FullMixedBirthAddress S B steps)) ×
          Fin (Fintype.card (FullMixedBirthAddress S B steps))) := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
  let _ := finiteEventPathFintype (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) steps x
  dsimp only
  rw [← birthForestPathSum_fourier_integral]
  apply integral_congr_ae
  filter_upwards [] with θ
  rw [full_mixed_forest_rows_eq_weighted_paths]
  apply sum_congr rfl
  intro p _
  rw [full_mixed_birth_operation_multiplier_product]
  split_ifs <;> simp

end Fourier
end Bounty
end

section

/- Prescribed marks alone support every selected coarse row, without list admissibility. -/

open Finset Classical
namespace Bounty
section Support
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (β : (g : Fin N) → ↥(P g) → ℝ) (V : Fin N → ℝ) (ρ : ℝ)
  (hV : ∀ g, V g ≠ 0)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)

theorem physical_selected_coarse_marks_congr (i : ℕ) (hi : i < 2 * n + 1)
    (F G : PhysicalBoundedMarkState P J ell B → ℂ)
    (hFG : ∀ t, t.1 = physicalMarkAtCut L (i + 1) → F t = G t)
    (s : PhysicalBoundedMarkState P J ell B) :
    physicalSelectedCoarseRow C aux k L σ τ β V ρ hV ω retention i F s =
      physicalSelectedCoarseRow C aux k L σ τ β V ρ hV ω retention i G s := by
  by_cases he : i % 2 = 0
  · let j : Fin (n + 1) := ⟨i / 2, by omega⟩
    have hij : i = 2 * j.val := by dsimp [j]; omega
    rw [hij] at hFG ⊢
    rw [physical_selected_coarse_row_even, physical_selected_coarse_row_even]
    apply physical_selected_visit_marks_congr C k ω β retention ρ V hV j (L j) F G
    simpa only [physical_mark_at_cut_odd] using hFG
  · let j : Fin n := ⟨i / 2, by omega⟩
    have hij : i = 2 * j.val + 1 := by dsimp [j]; omega
    have hnext : 2 * j.val + 1 + 1 = 2 * j.succ.val := by simp only [Fin.val_succ]; omega
    rw [hij] at hFG ⊢
    rw [physical_selected_coarse_row_odd, physical_selected_coarse_row_odd]
    apply physical_selected_edge_marks_congr C k ω β retention ρ V hV j (aux j)
      (σ j) (τ j) (L j.succ) F G
    simpa only [hnext, physical_mark_at_cut_even] using hFG

theorem physical_selected_coarse_marks_zero (i : ℕ) (hi : i < 2 * n + 1)
    (s : PhysicalBoundedMarkState P J ell B) (hs : s.1 = physicalMarkAtCut L i) :
    physicalSelectedCoarseRow C aux k L σ τ β V ρ hV ω retention i (fun _ => 0) s = 0 := by
  by_cases he : i % 2 = 0
  · let j : Fin (n + 1) := ⟨i / 2, by omega⟩
    have hij : i = 2 * j.val := by dsimp [j]; omega
    rw [hij] at hs ⊢
    rw [physical_selected_coarse_row_even]
    apply physical_selected_visit_zero C k ω β retention ρ V hV j (L j) s
    simpa only [physical_mark_at_cut_even] using hs
  · let j : Fin n := ⟨i / 2, by omega⟩
    have hij : i = 2 * j.val + 1 := by dsimp [j]; omega
    rw [hij, physical_selected_coarse_row_odd]
    exact physical_selected_edge_zero C k ω β retention ρ V hV j (aux j)
      (σ j) (τ j) (L j.succ) s

end Support
end Bounty
end

section

/- Actual uniform rough-number densities on logarithmic cells. -/

namespace Bounty

open Filter Real
open scoped Topology

theorem uniform_rough_depth_approx (n : ℕ) {S : ℝ} (hS : 0 ≤ S) :
    UniformRoughDepthApprox n S := by
  induction n with
  | zero => exact uniform_rough_depth_approx_zero hS
  | succ n ih =>
    exact uniform_rough_depth_approx_succ_of_prime_error hS ih
      (fun a ε ha hε => eventually_normalized_prime_cell_error ha hS hε)

theorem eventually_normalized_rough_buchstab_error
    {S a b γ₀ gap ε : ℝ} (hS : 0 ≤ S) (ha : 0 < a) (hγ₀ : 0 < γ₀)
    (hgap : 0 < gap) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ w γ : ℝ,
      a ≤ w → w ≤ b → γ₀ ≤ γ → gap ≤ w-γ →
      |normalizedRoughCellCount L S (exp (w*L)) (exp (γ*L))-
        buchstabDensity γ w| ≤ ε := by
  obtain ⟨n, hn⟩ := exists_nat_gt ((b+1)/γ₀)
  have htop0 : b+1 ≤ ((n : ℝ)+2)*γ₀ := by
    have hh := (div_lt_iff₀ hγ₀).mp hn
    nlinarith
  filter_upwards [(uniform_rough_depth_approx n hS) a b γ₀ gap ha hγ₀ hgap ε hε,
    eventually_logarithmic_cell_width_div_le hS (show (0:ℝ)<1 by norm_num),
    eventually_gt_atTop (0 : ℝ)] with L hN hδ hL
  intro w γ haw hwb hγ hsep
  have htop : w+L^(-S)/L ≤ ((n : ℝ)+2)*γ := by
    have hm := mul_le_mul_of_nonneg_left hγ (show 0 ≤ (n : ℝ)+2 by positivity)
    linarith
  have hwtop : w ≤ ((n : ℝ)+2)*γ := by
    have hδ0 : 0 ≤ L^(-S)/L := by positivity
    linarith
  have hh := hN w γ haw hwb hγ hsep htop
  rwa [buchstab_depth_density_eq_density (hγ₀.trans_le hγ) n hwtop] at hh

theorem normalized_exponential_rough_cell_tendsto
    {S γ w : ℝ} (hS : 0 ≤ S) (hγ : 0 < γ) (hγw : γ < w) :
    Tendsto (fun L : ℝ => normalizedRoughCellCount L S (exp (w*L)) (exp (γ*L)))
      atTop (nhds (buchstabDensity γ w)) := by
  rw [Metric.tendsto_nhds]
  intro ε hε
  have hh := eventually_normalized_rough_buchstab_error
    (a := w) (b := w) (γ₀ := γ) (gap := w-γ) hS (hγ.trans hγw) hγ
    (sub_pos.mpr hγw) (show 0 < ε/2 by positivity)
  filter_upwards [hh] with L hL
  rw [Real.dist_eq]
  exact (hL w γ le_rfl le_rfl le_rfl le_rfl).trans_lt (by linarith)

end Bounty

