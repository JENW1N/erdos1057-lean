/- Actual normalized auxiliary averages from rational local energy and minor bounds. -/

open Finset MeasureTheory
open scoped Classical ComplexConjugate
namespace Bounty

theorem physical_aux_shift_local_energy_decay
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (k : ℤ)
    (bA : (∀ i : A, P i.val.1) → ℂ) (bB : (∀ i : B, P i.val.1) → ℂ)
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1/(p : ℝ) = V g)
    (hA : ∀ a, ‖bA a‖ ≤ 1) (hB : ∀ b, ‖bB b‖ ≤ 1)
    (S T : Finset ℤ) (f g : ℤ → ℂ) {L q K HA HB Y E D : ℝ}
    (hk : k ≠ 0) (hL : 5 ≤ L) (hq : 0 ≤ q) (hK : 0 ≤ K)
    (hkB : (k.natAbs : ℝ) ≤ L^K) (hHA : 0 < HA) (hHB : 0 < HB)
    (hY : 0 ≤ Y) (hscale : L^q ≤ HA*HB)
    (hf : (∑ n ∈ S, ‖f n‖^2) ≤ Y*L^E)
    (hg : (∑ n ∈ T, ‖g n‖^2) ≤ Y*L^E)
    (hminor : ∀ θ, θ ∉ productMajorArcSet k L q HA HB →
      ‖physicalAuxFourierMultiplier P V A B hU hAB k bA bB θ‖ ≤ L^(-(D+E+1)))
    (hlocal : ∀ (r : ℕ), 0 < r → (r : ℝ) ≤ L^(K+q) → ∀ a : ℤ,
      (∫ x in Set.Icc
        ((a : ℝ)/r-1/(|(k : ℝ)| *(HA*HB)/L^q))
        ((a : ℝ)/r+1/(|(k : ℝ)| *(HA*HB)/L^q)),
        ‖finiteFourierSum S f x‖^2) ≤ Y*L^(-((2*D+E+2)+2*q+K+1))) :
    ‖∑ aux : PhysicalAuxLabels P (repeatedBigAuxCut A B),
      (physicalAuxMass V (repeatedBigAuxCut A B) aux : ℂ)*
        bA (repeatedBigAuxSplitEquiv P A B hU hAB aux).1 *
        bB (repeatedBigAuxSplitEquiv P A B hU hAB aux).2 *
        ∑ n ∈ S, let δ : ℤ := k*(∏ g, ∏ j : repeatedBigAuxCut A B g, (aux g j).val : ℕ)
          if n+δ ∈ T then conj (f n)*g (n+δ) else 0‖ ≤ Y*L^(-D) := by
  have hLp : 0 < L := by linarith
  have hm := product_major_energy_of_rational_local S f hk hL hq hK hkB hHA hHB
    hY hscale hlocal
  exact (physical_aux_shift_major_energy P V A B hU hAB k bA bB hV hMass hA hB
    S T f g (productMajorArcSet k L q HA HB)
    (product_major_arc_set_measurable k L q HA HB)
    (Real.rpow_pos_of_pos hLp _).le hminor).trans
    (major_minor_pairing_decay (by linarith) hY (by positivity) (by positivity)
      (integral_nonneg fun _ => sq_nonneg _) hf hg hm)

end Bounty
