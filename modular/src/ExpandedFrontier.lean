section

/- Finite weighted truncation of the actual three-variable majorant transform. -/

open Finset MeasureTheory Filter

namespace Bounty

theorem finite_typeII_cross_fourier_setIntegral
    (A L U V E Z : ℝ) (k : ℤ) (S : Finset TypeIIShiftIndex)
    (ω : TypeIIShiftIndex → ℂ) (T : Set (EuclideanSpace ℝ (Fin 3)))
    (hU : 0 < U) (hZ : 0 < Z)
    (hpositive : ∀ y ∈ S, ω y ≠ 0 →
      0 < y.2.1.1 ∧ 0 < y.2.2.1 ∧ 0 < y.1.2) :
    (∫ ξ in T, typeIIFiniteCrossFourierIntegrand A L U V E Z k S ω ξ) =
      ∑ y ∈ S, ω y * (∫ ξ in T,
        typeIICrossFourierScale A L U V E Z k ξ * typeIICrossFourierPowers y ξ) := by
  let f : TypeIIShiftIndex → EuclideanSpace ℝ (Fin 3) → ℂ := fun y ξ =>
    ω y * (typeIICrossFourierScale A L U V E Z k ξ * typeIICrossFourierPowers y ξ)
  have hf : ∀ y ∈ S, Integrable (f y) := by
    intro y hy
    by_cases hω : ω y = 0
    · simp only [f, hω, zero_mul]
      exact integrable_zero _ _ _
    · obtain ⟨hm, hm', hz⟩ := hpositive y hy hω
      exact (typeII_cross_fourier_kernel_integrable A L U V E Z k y hU hZ hm hm' hz).const_mul (ω y)
  have heq (ξ : EuclideanSpace ℝ (Fin 3)) :
      typeIIFiniteCrossFourierIntegrand A L U V E Z k S ω ξ = ∑ y ∈ S, f y ξ := by
    simp only [typeIIFiniteCrossFourierIntegrand, mul_sum, f]
    apply sum_congr rfl
    intro y hy
    ring
  calc
    _ = ∫ ξ in T, ∑ y ∈ S, f y ξ := integral_congr_ae (Eventually.of_forall heq)
    _ = ∑ y ∈ S, ∫ ξ in T, f y ξ := integral_finsetSum S (fun y hy => (hf y hy).integrableOn)
    _ = _ := by
      apply sum_congr rfl
      intro y hy
      exact integral_const_mul _ _

theorem finite_typeII_majorant_fourier_truncation_le
    (A L U V E Z : ℝ) (k : ℤ) (S : Finset TypeIIShiftIndex)
    (ω : TypeIIShiftIndex → ℂ) (T : Set (EuclideanSpace ℝ (Fin 3))) (ε : ℝ)
    (hU : 0 < U) (hV : 0 < V) (hZ : 0 < Z) (hk : k ≠ 0)
    (hgeometry : ∀ y ∈ S, ω y ≠ 0 → y.1.1 = k ∧
      0 < y.2.1.1 ∧ 0 < y.2.2.1 ∧ 0 < y.1.2 ∧
      ∀ i, typeIILogCoordinates ![(y.2.1.1:ℝ),(y.2.2.1:ℝ),(y.1.2:ℝ)] ![U,U,Z] i ∈
        Set.Icc (-A) A)
    (hcut : ∀ t : EuclideanSpace ℝ (Fin 3),
      ‖(typeIIPulledCutoff A (L^88) (U/(2*(k:ℝ)*E)) (Z/((k:ℝ)*U*V)) (1/(U*V)) t : ℂ) -
        ∫ ξ in T, typeIIPulledFourierIntegrand A (L^88) (U/(2*(k:ℝ)*E))
          (Z/((k:ℝ)*U*V)) (1/(U*V)) t ξ‖ ≤ ε) :
    ‖(∑ y ∈ S, ω y * ((typeIIEMajorant (L^88) (typeIIRealE y/E) *
        typeIINMajorant (typeIIRealN y/V) : ℝ):ℂ)) -
      ∫ ξ in T, typeIIFiniteCrossFourierIntegrand A L U V E Z k S ω ξ‖ ≤
        ε * ∑ y ∈ S, ‖ω y‖ := by
  rw [finite_typeII_cross_fourier_setIntegral A L U V E Z k S ω T hU hZ
    (fun y hy hω => ⟨(hgeometry y hy hω).2.1, (hgeometry y hy hω).2.2.1,
      (hgeometry y hy hω).2.2.2.1⟩), ← sum_sub_distrib]
  calc
    _ ≤ ∑ y ∈ S, ‖ω y * ((typeIIEMajorant (L^88) (typeIIRealE y/E) *
        typeIINMajorant (typeIIRealN y/V) : ℝ):ℂ) - ω y * (∫ ξ in T,
        typeIICrossFourierScale A L U V E Z k ξ * typeIICrossFourierPowers y ξ)‖ :=
      norm_sum_le _ _
    _ ≤ ∑ y ∈ S, ε * ‖ω y‖ := by
      apply sum_le_sum
      intro y hy
      by_cases hω : ω y = 0
      · simp [hω]
      obtain ⟨hyk, hm, hm', hz, hbox⟩ := hgeometry y hy hω
      have hη := typeII_scale_log_cutoff_eq_majorants (L := L) (E := E)
        (k := (k:ℝ)) (by exact_mod_cast hm) (by exact_mod_cast hm')
        (by exact_mod_cast hz) hU hV hZ (by exact_mod_cast hk) hbox
      have heq : typeIIPulledCutoff A (L^88) (U/(2*(k:ℝ)*E))
          (Z/((k:ℝ)*U*V)) (1/(U*V))
          (typeIILogCoordinates ![(y.2.1.1:ℝ),(y.2.2.1:ℝ),(y.1.2:ℝ)] ![U,U,Z]) =
          typeIIEMajorant (L^88) (typeIIRealE y/E) * typeIINMajorant (typeIIRealN y/V) := by
        simpa only [typeIIRealE, typeIIRealN, hyk] using hη
      have hint : (∫ ξ in T,
          typeIICrossFourierScale A L U V E Z k ξ * typeIICrossFourierPowers y ξ) =
          ∫ ξ in T, typeIIPulledFourierIntegrand A (L^88) (U/(2*(k:ℝ)*E))
            (Z/((k:ℝ)*U*V)) (1/(U*V))
            (typeIILogCoordinates ![(y.2.1.1:ℝ),(y.2.2.1:ℝ),(y.1.2:ℝ)] ![U,U,Z]) ξ :=
        integral_congr_ae (Eventually.of_forall
          (typeII_cross_fourier_kernel_eq A L U V E Z k y hU hZ hm hm' hz))
      rw [← mul_sub, norm_mul, hint, ← heq]
      exact (mul_le_mul_of_nonneg_left (hcut _) (norm_nonneg _)).trans_eq (mul_comm _ _)
    _ = _ := (mul_sum ..).symm

theorem eventually_finite_typeII_localized_fourier_truncation {A K₀ D : ℝ}
    (hA : 0 ≤ A) (hD : 0 ≤ D) :
    ∃ F : ℝ, 0 < F ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (U V E Z : ℝ) (k : ℤ), 0 < U → 0 < V → 0 < Z → k ≠ 0 →
        E = U * L^(-K₀) → 1 ≤ U*V → Z ≤ 24*U^2*V*L^88/E →
      ∀ (S : Finset TypeIIShiftIndex) (ω : TypeIIShiftIndex → ℂ),
        (∀ y ∈ S, ω y ≠ 0 → y.1.1 = k ∧
          0 < y.2.1.1 ∧ 0 < y.2.2.1 ∧ 0 < y.1.2 ∧
          ∀ i, typeIILogCoordinates ![(y.2.1.1:ℝ),(y.2.2.1:ℝ),(y.1.2:ℝ)] ![U,U,Z] i ∈
            Set.Icc (-A) A) →
        ‖(∑ y ∈ S, ω y * ((typeIIEMajorant (L^88) (typeIIRealE y/E) *
          typeIINMajorant (typeIIRealN y/V) : ℝ):ℂ)) -
          ∫ ξ in {ξ : EuclideanSpace ℝ (Fin 3) | ‖ξ‖ ≤ L^F},
            typeIIFiniteCrossFourierIntegrand A L U V E Z k S ω ξ‖ ≤
          L^(-D) * ∑ y ∈ S, ‖ω y‖ := by
  obtain ⟨F, hF, hcut⟩ := typeII_scale_fourier_exists_power_cutoff
    (K₀ := K₀) (Cz := K₀+89) hA hD
  refine ⟨F, hF, ?_⟩
  filter_upwards [hcut, eventually_ge_atTop (24:ℝ)] with L hcut hL
  intro U V E Z k hU hV hZ hk hE hUV hZupper S ω hgeometry
  exact finite_typeII_majorant_fourier_truncation_le A L U V E Z k S ω _ _
    hU hV hZ hk hgeometry (hcut U V E Z k hU hV hZ.le hk hE hUV
      (typeII_localized_scale_ratio hL hU hV hE hZupper))

end Bounty
