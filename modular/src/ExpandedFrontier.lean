section

/- The actual small residue endpoint factors combine into the original
vertex schedule, including zero-weight paths and both slot permutations. -/

open Finset
namespace Bounty

theorem physical_residue_vertex_weight_mul
    {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    (L : PhysicalMarkLists P J ell) (r : PhysicalResidues P) (a b : ℝ) :
    physicalResidueVertexWeight L a r * physicalResidueVertexWeight L b r =
      physicalResidueVertexWeight L (a * b) r := by
  unfold physicalResidueVertexWeight
  split_ifs <;> simp only [mul_pow, prod_mul_distrib, mul_zero]

theorem physical_residue_endpoint_square
    {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    (L : PhysicalMarkLists P J ell) (r : PhysicalResidues P) {q : ℝ} (hq : 0 ≤ q) :
    physicalResidueVertexWeight L (Real.sqrt q) r ^ 2 = physicalResidueVertexWeight L q r := by
  rw [pow_two, physical_residue_vertex_weight_mul, Real.mul_self_sqrt hq]

theorem physical_residue_endpoint_schedule_product
    {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    (L : ℕ → PhysicalMarkLists P J ell) (r : ℕ → PhysicalResidues P)
    {q : ℝ} (hq : 0 ≤ q) (N : ℕ) :
    (∏ j ∈ range (N + 1), physicalResidueVertexWeight (L j) (Real.sqrt q) (r j) *
      physicalResidueVertexWeight (L (j + 1)) (Real.sqrt q) (r (j + 1))) =
    ∏ j ∈ range (N + 2), physicalResidueVertexWeight (L j)
      (physicalEndpointSchedule q (N + 1) j) (r j) := by
  rw [adjacent_endpoint_product, range_product_endpoints]
  simp only [physical_residue_endpoint_square _ _ hq]
  have h0 : physicalEndpointSchedule q (N + 1) 0 = Real.sqrt q := by simp [physicalEndpointSchedule]
  have ht : physicalEndpointSchedule q (N + 1) (N + 1) = Real.sqrt q := by simp [physicalEndpointSchedule]
  rw [h0, ht]
  congr 1
  apply prod_congr rfl
  intro j hj
  have hjN := mem_range.mp hj
  have hne0 : j + 1 ≠ 0 := by omega
  have hnet : j + 1 ≠ N + 1 := by omega
  simp only [physicalEndpointSchedule, hne0, hnet, or_self, if_false]

theorem physical_residue_permuted_endpoint_product
    {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    (L : ℕ → PhysicalMarkLists P J ell) (r : ℕ → PhysicalResidues P)
    (σ τ : ℕ → PhysicalPermutations G J ell) {q : ℝ} (hq : 0 ≤ q) (N : ℕ) :
    (∏ j ∈ range (N + 1),
      physicalResidueVertexWeight (physicalPermuteLabels (σ j) (L j)) (Real.sqrt q) (r j) *
      physicalResidueVertexWeight (physicalPermuteLabels (τ j) (L (j + 1))) (Real.sqrt q) (r (j + 1))) =
    ∏ j ∈ range (N + 2), physicalResidueVertexWeight (L j)
      (physicalEndpointSchedule q (N + 1) j) (r j) := by
  simp only [physical_small_vertex_permutation]
  exact physical_residue_endpoint_schedule_product L r hq N

end Bounty
end

section

/- Arbitrary power saving for the actual shared-draw error, uniformly over
cuts, harmonic masses, logarithmic list lengths, and polynomial endpoint logarithms. -/

open Finset Filter
open scoped Classical
namespace Bounty

theorem eventually_physical_shared_error_polynomial_decay {c v A B : ℝ} (hc : 0 < c) (hv : 0 < v) (hA : 0 ≤ A) (hB : 0 ≤ B)
    (E F D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (G : Type*) [Fintype G] (J : ℕ) (C : G → Finset (Fin J)) (V : G → ℝ)
      (T H Pmin : ℝ),
      (∀ g, v ≤ V g) → (J * Fintype.card G : ℕ) ≤ A * Real.log L →
      0 ≤ T → T ≤ B * L^F → 0 ≤ H → H ≤ L ^ E → Real.exp (L ^ c) ≤ Pmin →
      (∑ g : G, (J - (C g).card : ℕ) * T / (V g * Pmin)) *
        (H + H / (1 / 2 : ℝ) ^ (2 * ∑ g : G, (J - (C g).card))) ≤ L ^ (-D) := by
  let e : ℝ := A * Real.log 4
  let C0 : ℝ := A * B / v
  have hC0 : 0 ≤ C0 := by dsimp only [C0]; positivity
  filter_upwards [eventually_polynomial_div_exp_power hc (2*C0) (1+F+E+e) D,
    eventually_ge_atTop (1 : ℝ)] with L hdec hL
  intro G _ J C V T H Pmin hV hJ hT hTL hH hHL hPmin
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hP0 : 0 < Pmin := (Real.exp_pos _).trans_le hPmin
  have hJL : ((J * Fintype.card G : ℕ) : ℝ) ≤ A * L :=
    hJ.trans (mul_le_mul_of_nonneg_left (Real.log_le_self hL0.le) hA)
  have hδ : (∑ g : G, (J - (C g).card : ℕ) * T / (V g * Pmin)) ≤
      C0 * L^(1+F) / Real.exp (L^c) := by
    calc
      _ ≤ (Fintype.card G : ℝ) * J * T / (v * Pmin) :=
        physical_shared_error_uniform_bound C V hv hP0 hT hV
      _ ≤ (A*L) * (B*L^F) / (v * Real.exp (L^c)) := by
        have hjn : (Fintype.card G : ℝ) * J ≤ A*L := by
          simpa only [Nat.cast_mul, mul_comm] using hJL
        apply div_le_div₀ (by positivity)
          (mul_le_mul hjn hTL hT (by positivity))
          (mul_pos hv (Real.exp_pos _))
          (mul_le_mul_of_nonneg_left hPmin hv.le)
      _ = _ := by
        rw [Real.rpow_add hL0, Real.rpow_one]
        dsimp only [C0]
        field_simp
  have hother : H + H / (1 / 2 : ℝ) ^ (2 * ∑ g : G, (J - (C g).card)) ≤
      2 * L^E * L^e := by
    calc
      _ ≤ 2 * H * (4 : ℝ) ^ (J * Fintype.card G) := physical_shared_half_overlap_bound C hH
      _ ≤ 2 * L^E * L^e :=
        mul_le_mul (mul_le_mul_of_nonneg_left hHL (by norm_num))
          (by simpa only [Nat.mul_one, Nat.cast_one, mul_one] using
            (four_pow_length_le_rpow (n := 1) hL0 hJ)) (by positivity) (by positivity)
  calc
    _ ≤ (C0 * L^(1+F) / Real.exp (L^c)) * (2 * L^E * L^e) :=
      mul_le_mul hδ hother (by positivity) (by positivity)
    _ = (2*C0) * L^(1+F+E+e) / Real.exp (L^c) := by
      simp only [Real.rpow_add hL0]
      ring
    _ ≤ _ := hdec

end Bounty
end

section

/- Read every retained prime coordinate directly from the selected groups.
No completion on the complementary groups is chosen. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def physicalSelectedPrimeRestriction {G : Type*} [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (A B T : Finset (RepeatedBigFlatIndex G J ell)) (hT : T ⊆ A ∪ B)
    (S : Finset G) (hS : ∀ i ∈ T, i.1 ∈ S)
    (u : GroupMarkedLists (fun g : S => P g.val)
      (fun g : S => ell + (repeatedBigAuxCut A B g.val).card)) : ∀ i : T, P i.val.1 :=
  fun i => u ⟨i.val.1, hS i.val i.property⟩
    ((physicalGroupUnsharedIndex (repeatedBigAuxCut A B i.val.1)).symm
      ⟨i.val.2, repeated_big_aux_union_unshared A B i.val (hT i.property)⟩)

theorem physical_selected_prime_restriction_full {G : Type*} [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (A B T : Finset (RepeatedBigFlatIndex G J ell)) (hT : T ⊆ A ∪ B)
    (S : Finset G) (hS : ∀ i ∈ T, i.1 ∈ S)
    (u : GroupMarkedLists P (fun g => ell + (repeatedBigAuxCut A B g).card)) :
    physicalSelectedPrimeRestriction A B T hT S hS (fun g : S => u g.val) =
      physicalPrimeUnsharedRestriction A B T hT u := rfl

end Bounty
end

section

/- Deterministic residue phases along the actual chronological schedule. -/

open Finset
namespace Bounty

theorem deterministic_ledger_phase_map
    {I K L X : Type*} (E : K → X → Type*) (target : ∀ k x, E k x → X)
    (update : ∀ k, L → (x : X) → E k x → L)
    (phase : ∀ k, L → (x : X) → E k x → ℂ)
    (tag : I → K) (ks : List I) (l : L) (x : X)
    (p : FiniteEventPath (fun i => E (tag i)) (fun i => target (tag i)) ks x) :
    deterministicLedgerPhase (fun i => E (tag i)) (fun i => target (tag i))
        (fun i => update (tag i)) (fun i => phase (tag i)) ks l x p =
      deterministicLedgerPhase E target update phase (ks.map tag) l x
        (finiteEventPathMapEquiv E target tag ks x p) := by
  induction ks generalizing l x with
  | nil => rfl
  | cons i ks ih =>
    rcases p with ⟨e, p⟩
    exact congrArg (phase (tag i) l x e * ·)
      (ih (update (tag i) l x e) (target (tag i) x e) p)

theorem deterministic_ledger_schedule_product
    {L X : Type*} (E : ℕ → X → Type*) (target : ∀ i x, E i x → X)
    (update : ∀ i, L → (x : X) → E i x → L)
    (phase : ∀ i, L → (x : X) → E i x → ℂ)
    (m : ℕ) (x : X) (p : FiniteEventPath E target (List.range m) x)
    (l : Fin (m + 1) → L)
    (hstep : ∀ i : Fin m, update i.val (l i.castSucc)
      (finiteScheduleOccurrence E target m x p i).1
      (finiteScheduleOccurrence E target m x p i).2 = l i.succ) :
    deterministicLedgerPhase E target update phase (List.range m) (l 0) x p =
      ∏ i : Fin m, phase i.val (l i.castSucc)
        (finiteScheduleOccurrence E target m x p i).1
        (finiteScheduleOccurrence E target m x p i).2 := by
  let lf : Fin ((List.range m).length + 1) → L :=
    fun i => l ⟨i.val, by simpa only [List.length_range] using i.isLt⟩
  have hs (i : Fin (List.range m).length) :
      update ((List.range m).get i) (lf i.castSucc)
        (finiteEventPathOccurrence E target (List.range m) x p i).1
        (finiteEventPathOccurrence E target (List.range m) x p i).2 = lf i.succ := by
    let j : Fin m := ⟨i.val, by simpa only [List.length_range] using i.isLt⟩
    exact (finite_schedule_occurrence_apply E target
      (fun t y e => update t (lf i.castSucc) y e) m x p j).symm.trans (hstep j)
  have h := deterministic_ledger_phase_eq_product E target update phase (List.range m) x p lf hs
  change deterministicLedgerPhase E target update phase (List.range m) (lf 0) x p = _
  rw [h]
  let F : Fin m → ℂ := fun i => phase i.val (l i.castSucc)
    (finiteScheduleOccurrence E target m x p i).1 (finiteScheduleOccurrence E target m x p i).2
  change _ = ∏ i : Fin m, F i
  rw [← (finCongr (show (List.range m).length = m from List.length_range)).prod_comp F]
  apply prod_congr rfl
  intro i _
  exact (finite_schedule_occurrence_apply E target
    (fun t y e => phase t (lf i.castSucc) y e) m x p
      ((finCongr (show (List.range m).length = m from List.length_range)) i)).symm

end Bounty
end

section

/- The auxiliary multiplier has norm at most one for bounded tests under
the original normalized reciprocal-prime law. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_aux_fourier_norm
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (k : ℤ)
    (bA : (∀ i : A, P i.val.1) → ℂ) (bB : (∀ i : B, P i.val.1) → ℂ)
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (hA : ∀ a, ‖bA a‖ ≤ 1) (hB : ∀ b, ‖bB b‖ ≤ 1) (x : ℝ) :
    ‖physicalAuxFourierMultiplier P V A B hU hAB k bA bB x‖ ≤ 1 := by
  unfold physicalAuxFourierMultiplier
  calc
    _ ≤ ∑ aux : PhysicalAuxLabels P (repeatedBigAuxCut A B),
        ‖(physicalAuxMass V (repeatedBigAuxCut A B) aux : ℂ) *
          bA (repeatedBigAuxSplitEquiv P A B hU hAB aux).1 *
          bB (repeatedBigAuxSplitEquiv P A B hU hAB aux).2 *
          fourier (-(k * (∏ g, ∏ j : repeatedBigAuxCut A B g, (aux g j).val : ℕ)))
            (x : AddCircle (1 : ℝ))‖ := norm_sum_le _ _
    _ ≤ ∑ aux : PhysicalAuxLabels P (repeatedBigAuxCut A B),
        physicalAuxMass V (repeatedBigAuxCut A B) aux := by
      apply sum_le_sum
      intro aux _
      have hμ := physical_aux_mass_nonneg V (repeatedBigAuxCut A B)
        (fun g => (hV g).le) aux
      have hf (n : ℤ) : ‖fourier n (x : AddCircle (1 : ℝ))‖ = 1 := by
        rw [fourier_apply, Circle.norm_coe]
      simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hμ, hf,
        mul_one]
      calc
        _ ≤ physicalAuxMass V (repeatedBigAuxCut A B) aux * 1 * 1 := by
          gcongr
          · exact hA _
          · exact hB _
        _ = _ := by ring
    _ = 1 := physical_aux_mass_sum V (repeatedBigAuxCut A B) hV hMass

end Bounty
end

section

/- The original auxiliary multiplier obeys the supported bilinear estimate
under product-atom bounds. Range assumptions apply only to nonzero tests. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_product_test_energy_le
    {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ)
    (hV : ∀ i, 0 < V i) (hMass : ∀ i, ∑ p ∈ P i, 1 / (p : ℝ) = V i)
    (b : (∀ i, P i) → ℂ) (hb : ∀ x, ‖b x‖ ≤ 1) :
    (∑ x, finiteProductWeight (physicalLabelLaw V) x * ‖b x‖^2) ≤ 1 := by
  calc
    _ ≤ ∑ x, finiteProductWeight (physicalLabelLaw V) x := by
      apply sum_le_sum
      intro x _
      have hw : 0 ≤ finiteProductWeight (physicalLabelLaw V) x :=
        prod_nonneg (fun i _ => physical_label_law_nonneg V (fun i => (hV i).le) i (x i))
      have he : ‖b x‖^2 ≤ 1 := by nlinarith [norm_nonneg (b x), hb x]
      simpa only [mul_one] using mul_le_mul_of_nonneg_left he hw
    _ = 1 := finite_product_weight_sum_one _
      (fun i => physical_label_law_sum V i (hV i) (hMass i))

theorem physical_aux_fourier_dyadic_bound
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (k : ℤ)
    (bA : (∀ i : A, P i.val.1) → ℂ) (bB : (∀ i : B, P i.val.1) → ℂ)
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (hA : ∀ a, ‖bA a‖ ≤ 1) (hB : ∀ b, ‖bB b‖ ≤ 1)
    (U W : ℕ) (hUpos : 0 < U) (hWpos : 0 < W)
    (hArange : ∀ a, bA a ≠ 0 → U ≤ ∏ i : A, (a i).val ∧ (∏ i : A, (a i).val) < 2*U)
    (hBrange : ∀ b, bB b ≠ 0 → W ≤ ∏ i : B, (b i).val ∧ (∏ i : B, (b i).val) < 2*W)
    {C D : ℝ} (hC : 0 ≤ C) (hD : 0 ≤ D)
    (hAtomA : ∀ m : ℕ,
      (∑ a ∈ univ.filter (fun a : (∀ i : A, P i.val.1) => (∏ i : A, (a i).val) = m),
        finiteProductWeight (fun i : A => physicalLabelLaw V i.val.1) a) ≤ C/(m : ℝ))
    (hAtomB : ∀ m : ℕ,
      (∑ b ∈ univ.filter (fun b : (∀ i : B, P i.val.1) => (∏ i : B, (b i).val) = m),
        finiteProductWeight (fun i : B => physicalLabelLaw V i.val.1) b) ≤ D/(m : ℝ))
    (θ : ℝ) {u : ℤ} {r : ℕ} (hr : 0 < r) (hcop : (r : ℤ).gcd u = 1)
    {β : ℝ} (hβ : |β| ≤ 1/(r : ℝ)^2) (hθ : (-k : ℝ)*θ = u/r+β) :
    ‖physicalAuxFourierMultiplier P V A B hU hAB k bA bB θ‖^2 ≤
      6*C*D*(1+Real.log r)*
        (1/(r : ℝ)+1/(U : ℝ)+1/(W : ℝ)+(r : ℝ)/((U : ℝ)*W)) := by
  rw [physical_aux_fourier_split]
  have hAn (a : ∀ i : A, P i.val.1) :
      0 ≤ finiteProductWeight (fun i : A => physicalLabelLaw V i.val.1) a :=
    prod_nonneg (fun i _ => physical_label_law_nonneg V (fun g => (hV g).le) i.val.1 (a i))
  have hBn (b : ∀ i : B, P i.val.1) :
      0 ≤ finiteProductWeight (fun i : B => physicalLabelLaw V i.val.1) b :=
    prod_nonneg (fun i _ => physical_label_law_nonneg V (fun g => (hV g).le) i.val.1 (b i))
  have heA := physical_product_test_energy_le (fun i : A => P i.val.1)
    (fun i : A => V i.val.1) (fun i => hV i.val.1) (fun i => hMass i.val.1) bA hA
  have heB := physical_product_test_energy_le (fun i : B => P i.val.1)
    (fun i : B => V i.val.1) (fun i => hV i.val.1) (fun i => hMass i.val.1) bB hB
  have hb := supported_product_fourier_dyadic_bound
    (fun a : (∀ i : A, P i.val.1) => ∏ i : A, (a i).val)
    (fun b : (∀ i : B, P i.val.1) => ∏ i : B, (b i).val)
    U W hUpos hWpos _ _ hAn hBn bA bB hArange hBrange hC hD hAtomA hAtomB k θ hr hcop hβ hθ
  apply hb.trans
  have hlog : 0 ≤ Real.log (r : ℝ) := Real.log_nonneg (by exact_mod_cast hr)
  have heAn : 0 ≤ ∑ a, finiteProductWeight (fun i : A => physicalLabelLaw V i.val.1) a * ‖bA a‖^2 :=
    sum_nonneg (fun a _ => mul_nonneg (hAn a) (sq_nonneg _))
  have heBn : 0 ≤ ∑ b, finiteProductWeight (fun i : B => physicalLabelLaw V i.val.1) b * ‖bB b‖^2 :=
    sum_nonneg (fun b _ => mul_nonneg (hBn b) (sq_nonneg _))
  calc
    _ ≤ (6*C*D*(1+Real.log r)*
        (1/(r : ℝ)+1/(U : ℝ)+1/(W : ℝ)+(r : ℝ)/((U : ℝ)*W)))*1*1 := by
      gcongr
      · exact heA
      · exact heB
    _ = _ := by ring

end Bounty
end

section

/- Explicit finite arc counts and positive-denominator rational centers. -/

open Finset MeasureTheory
namespace Bounty

theorem rational_major_arc_count (Q N : ℕ) :
    ((Icc 1 Q).card : ℝ) * ((Icc (-(N : ℤ)) (N : ℤ)).card : ℝ) =
      (Q : ℝ)*(2*(N : ℝ)+1) := by
  have hQ : (Icc 1 Q).card = Q := by rw [Nat.card_Icc]; omega
  have hN : (Icc (-(N : ℤ)) (N : ℤ)).card = 2*N+1 := by rw [Int.card_Icc]; omega
  rw [hQ,hN]
  push_cast
  rfl

theorem product_major_energy_uniform_bound (S : Finset ℤ) (f : ℤ → ℂ)
    {k : ℤ} {L q U V E : ℝ} (hk : k ≠ 0) (hU : 0 < U) (hV : 0 < V)
    (hscale : L^q ≤ U*V)
    (hE : ∀ r ∈ Icc 1 ⌊L^q⌋₊,
      ∀ u ∈ Icc (-((⌊L^q⌋₊*(k.natAbs+1) : ℕ) : ℤ))
        ((⌊L^q⌋₊*(k.natAbs+1) : ℕ) : ℤ),
      (∫ x in Set.Icc
        (-(u : ℝ)/((k : ℝ)*r)-L^q/(|(k : ℝ)| *(U*V)))
        (-(u : ℝ)/((k : ℝ)*r)+L^q/(|(k : ℝ)| *(U*V))),
        ‖finiteFourierSum S f x‖^2) ≤ E) :
    (∫ x in productMajorArcSet k L q U V ∩ Set.Ioc 0 1,
      ‖finiteFourierSum S f x‖^2) ≤
      (⌊L^q⌋₊ : ℝ)*(2*((⌊L^q⌋₊*(k.natAbs+1) : ℕ) : ℝ)+1)*E := by
  apply (product_major_energy_cover S f hk hU hV hscale).trans
  calc
    _ ≤ ∑ r ∈ Icc 1 ⌊L^q⌋₊,
      ∑ u ∈ Icc (-((⌊L^q⌋₊*(k.natAbs+1) : ℕ) : ℤ))
        ((⌊L^q⌋₊*(k.natAbs+1) : ℕ) : ℤ), E := by
      apply sum_le_sum
      intro r hr
      apply sum_le_sum
      intro u hu
      exact hE r hr u hu
    _ = _ := by
      simp only [sum_const, nsmul_eq_mul]
      rw [← mul_assoc, rational_major_arc_count]

theorem product_major_center_positive_denominator {k : ℤ} (hk : k ≠ 0)
    (u : ℤ) {r : ℕ} (hr : 0 < r) :
    -(u : ℝ)/((k : ℝ)*r) =
      ((-(k.sign*u) : ℤ) : ℝ)/((k.natAbs*r : ℕ) : ℝ) := by
  have hkR : (k : ℝ) ≠ 0 := by exact_mod_cast hk
  have hrR : (r : ℝ) ≠ 0 := by exact_mod_cast hr.ne'
  have ha : (k.natAbs : ℝ) ≠ 0 := by exact_mod_cast (Int.natAbs_ne_zero.mpr hk)
  have he : (k : ℝ)*(k.sign : ℝ) = (k.natAbs : ℝ) := by
    simpa only [Int.cast_mul, Int.cast_natCast] using
      congrArg (fun z : ℤ => (z : ℝ)) (Int.mul_sign_self k)
  push_cast
  field_simp
  nlinarith only [congrArg (fun x : ℝ => (u : ℝ)*x) he]

end Bounty
end

section

/- One character family works at every Mellin frequency, so the exact
rational expansion can be integrated without changing its coefficients. -/

open Finset
open scoped Classical
namespace Bounty

theorem rational_four_factor_mellin_box_expansion {r Q d : ℕ}
    (hr : 0 < r) (hrQ : r ≤ Q) (hd : 0 < d) (hdr : d ∣ r) (u : ℤ)
    (M A P N : Finset ℕ)
    (hM : ∀ m ∈ M, m.Coprime r) (hA : ∀ a ∈ A, a.Coprime r)
    (hP : ∀ p ∈ P, p.Coprime r) (hN : ∀ n ∈ N, n.gcd r = d)
    (hMp : ∀ m ∈ M, 0 < m) (hAp : ∀ a ∈ A, 0 < a)
    (hPp : ∀ p ∈ P, 0 < p) (hNp : ∀ n ∈ N, 0 < n)
    (α δ β γ : ℕ → ℂ) :
    ∃ c : AddChar (Additive (ZMod (r / d))ˣ) ℂ → ℂ,
      (∑ ψ, ‖c ψ‖) ≤ Real.sqrt (Q : ℝ) ∧ ∀ t : ℝ,
      (∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P, ∑ n ∈ N,
        (α m*δ a*β p*γ n) * harmonicMellinWeight t ((m*a*p*n : ℕ) : ℝ) *
          Complex.exp (Complex.I * (2*Real.pi*((u : ℝ)/r*(m*a*p*n)) : ℝ))) =
        ∑ ψ, c ψ *
          (∑ m ∈ M, (α m*harmonicMellinWeight t m)*unitAddCharDirichlet ψ (m : ZMod (r/d))) *
          (∑ a ∈ A, (δ a*harmonicMellinWeight t a)*unitAddCharDirichlet ψ (a : ZMod (r/d))) *
          (∑ p ∈ P, (β p*harmonicMellinWeight t p)*unitAddCharDirichlet ψ (p : ZMod (r/d))) *
          (∑ n ∈ N, (γ n*harmonicMellinWeight t n)*unitAddCharDirichlet ψ ((n/d : ℕ) : ZMod (r/d))) := by
  obtain ⟨c,hc,he⟩ := rational_four_factor_uniform_box_expansion hr hrQ hd hdr u
    M A P N hM hA hP hN
  refine ⟨c,hc,?_⟩
  intro t
  rw [← he (fun m => α m*harmonicMellinWeight t m)
    (fun a => δ a*harmonicMellinWeight t a) (fun p => β p*harmonicMellinWeight t p)
    (fun n => γ n*harmonicMellinWeight t n)]
  apply sum_congr rfl
  intro m hm
  apply sum_congr rfl
  intro a ha
  apply sum_congr rfl
  intro p hp
  apply sum_congr rfl
  intro n hn
  rw [harmonic_mellin_weight_four_factors t (hMp m hm) (hAp a ha) (hPp p hp) (hNp n hn)]
  ring

end Bounty
end

section

/- Exact finite dyadic decomposition of the original auxiliary multiplier. -/

open Finset
open scoped Classical
namespace Bounty

theorem finite_dyadic_test_norm_le_one {X : Type*} (π : X → ℕ) (f : X → ℂ)
    (hf : ∀ x, ‖f x‖ ≤ 1) (j : ℕ) (x : X) :
    ‖finiteDyadicTest π j f x‖ ≤ 1 := by
  unfold finiteDyadicTest
  split_ifs
  · exact hf x
  · simp

theorem finite_dyadic_card_le_three_mul {X : Type*} [Fintype X]
    (π : X → ℕ) (hπ : ∀ x, 0 < π x) {L : ℝ} (hL : 1 ≤ L)
    (hlog : ∀ x, Real.log (π x) ≤ L) :
    ((finiteDyadicIndices π).card : ℝ) ≤ 3*L := by
  have hb := finite_dyadic_indices_card_le π hπ (zero_le_one.trans hL) hlog
  have hhalf : (1/2 : ℝ) ≤ Real.log 2 := by linarith [Real.log_two_gt_d9]
  have hdiv : L/Real.log 2 ≤ 2*L := by
    apply (div_le_iff₀ (Real.log_pos (by norm_num : (1 : ℝ)<2))).mpr
    nlinarith
  linarith

theorem physical_aux_fourier_dyadic_sum
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (k : ℤ)
    (bA : (∀ i : A, P i.val.1) → ℂ) (bB : (∀ i : B, P i.val.1) → ℂ)
    (θ : ℝ) :
    (∑ i ∈ finiteDyadicIndices (fun a : (∀ i : A, P i.val.1) => ∏ j, (a j).val),
      ∑ j ∈ finiteDyadicIndices (fun b : (∀ i : B, P i.val.1) => ∏ j, (b j).val),
        physicalAuxFourierMultiplier P V A B hU hAB k
          (finiteDyadicTest (fun a => ∏ j, (a j).val) i bA)
          (finiteDyadicTest (fun b => ∏ j, (b j).val) j bB) θ) =
      physicalAuxFourierMultiplier P V A B hU hAB k bA bB θ := by
  simp_rw [physical_aux_fourier_split]
  exact finite_dyadic_pairing_sum _ _ _ _ _ _ _

theorem physical_aux_fourier_zero_left
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (k : ℤ)
    (bA : (∀ i : A, P i.val.1) → ℂ) (bB : (∀ i : B, P i.val.1) → ℂ)
    (hA : ∀ a, bA a = 0) (θ : ℝ) :
    physicalAuxFourierMultiplier P V A B hU hAB k bA bB θ = 0 := by
  simp only [physicalAuxFourierMultiplier, hA, mul_zero, zero_mul, sum_const_zero]

theorem physical_aux_fourier_zero_right
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (k : ℤ)
    (bA : (∀ i : A, P i.val.1) → ℂ) (bB : (∀ i : B, P i.val.1) → ℂ)
    (hB : ∀ b, bB b = 0) (θ : ℝ) :
    physicalAuxFourierMultiplier P V A B hU hAB k bA bB θ = 0 := by
  simp only [physicalAuxFourierMultiplier, hB, mul_zero, zero_mul, sum_const_zero]

end Bounty
