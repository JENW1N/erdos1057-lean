    PhysicalEffectivePlannedBigPath C k B ks a.1 a.2 x ≃
      PhysicalEffectivePlannedBigPath C k B ks b.1 b.2 x :=
  Equiv.cast (congrArg (fun a => PhysicalEffectivePlannedBigPath C k B ks a.1 a.2 x) h)

theorem physical_effective_small_factor_plan_cast
    (Vs : S → ℝ) (qedge : K → ℝ) (r : PhysicalResidues Ps)
    {a b : PhysicalMarkLists Ps J ell ×
      PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) ks}
