    (steps : List (Option (J ⊕ K)))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))

theorem full_mixed_masked_path_norm_le_rank
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hη : ∀ g, 0 ≤ η g) (hμatom : ∀ g p, μ g p ≤ η g)
    (hβ : 0 ≤ β)
    (hghostAtom : ∀ j g, (|(1 - q j) * V g / ρ| * η g) * v ≤ β)
    (hedgeAtom : ∀ g, η g ≤ β)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : ∀ g, vmin ≤ V g)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (phase : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    {L : ℝ} (hL : 0 ≤ L) (hf : ∀ y, ‖f y‖ ≤ L) :
    ‖fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps
      (fun s p => if birthForestCompatible
        (fun i => fullMixedPathBirthPerformed n S B A Δ D steps s p (fullMixedBirthOrder S B steps i))
        (fun i => fullMixedPathBirthLabel n S B A Δ D steps s p (fullMixedBirthOrder S B steps i)) code
        then phase s p else 0) f s‖ ≤
      (β ^ birthForestRank code * (steps.map (fullMixedLengthRowFactor μ q ρ v vmin V T)).prod) *
        (L * productLengthLyapunov v s) := by
  exact (full_mixed_masked_path_norm_le_integral n S B A Δ D ω μ q ρ V steps
    (fun s p => birthForestCompatible
      (fun i => fullMixedPathBirthPerformed n S B A Δ D steps s p (fullMixedBirthOrder S B steps i))
      (fun i => fullMixedPathBirthLabel n S B A Δ D steps s p (fullMixedBirthOrder S B steps i)) code)
    phase hphase f s).trans
    (full_mixed_original_forest_bounded n S B A Δ D ω μ q ρ v vmin V η β steps code
    hω hωmass hμ hmass hη hμatom hβ hghostAtom hedgeAtom hq0 hq1 hρ0 hρ1 hv hvmin hV hD T ht s
      (fun p => ‖f (finiteEventPathTerminal (FullPermutationMixedEvent n S B A Δ D)
        (fullPermutationMixedEventTarget n S B A Δ D) steps s p)‖) hL (fun p => hf _))

theorem full_mixed_empty_masked_path_norm_le_rank
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hη : ∀ g, 0 ≤ η g) (hμatom : ∀ g p, μ g p ≤ η g)
    (hβ : 0 ≤ β)
    (hghostAtom : ∀ j g, (|(1 - q j) * V g / ρ| * η g) * v ≤ β)
    (hedgeAtom : ∀ g, η g ≤ β)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : ∀ g, vmin ≤ V g)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (phase : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    {L : ℝ} (hL : 0 ≤ L) (hf : ∀ y, ‖f y‖ ≤ L)
    (hs : productTotalMemory s = 0) :
    ‖fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps
      (fun s p => if birthForestCompatible
        (fun i => fullMixedPathBirthPerformed n S B A Δ D steps s p (fullMixedBirthOrder S B steps i))
        (fun i => fullMixedPathBirthLabel n S B A Δ D steps s p (fullMixedBirthOrder S B steps i)) code
        then phase s p else 0) f s‖ ≤
      (β ^ birthForestRank code * (steps.map (fullMixedLengthRowFactor μ q ρ v vmin V T)).prod) * L := by
  simpa only [productLengthLyapunov_empty v s hs, mul_one] using
    full_mixed_masked_path_norm_le_rank n S B A Δ D ω μ q ρ v vmin V η β steps code
    hω hωmass hμ hmass hη hμatom hβ hghostAtom hedgeAtom hq0 hq1 hρ0 hρ1 hv hvmin hV hD T ht phase hphase f s hL hf

