/- Exact active-block geometry supplies the coarse range and every original cross-scale input. -/

open Finset Filter
namespace Bounty

theorem eventually_active_coarse_scale_inputs {b K C : ℝ}
    (hb : 0 < b) (hK : 0 ≤ K) (hC : 0 < C) :
    ∀ᶠ L : ℝ in atTop, ∀ (μ α β : ℕ → ℝ) (H i j : ℕ),
      shiftedTypeIIBilinear (arithmeticProductWindow 1 (Real.exp L)) μ
        (typeIIRestrict (dyadicNatBucket (Icc 1 H) i) α)
        (typeIIRestrict (dyadicNatBucket (Icc 1 H) j) β) ≠ 0 →
      let U := originalDyadicBase i
      let V := originalDyadicBase j
      Real.exp (b*L) ≤ U → U ≤ C*Real.exp L →
      Real.exp (b*L) ≤ V → V ≤ C*Real.exp L →
      2*U*V ≤ 66*Real.exp L ∧
      1 ≤ U*L^(-K) ∧ Real.log (U*L^(-K)) ≤ (1-b/2)*L ∧
      ∀ k ∈ Icc (-(typeIIAdmissibleDeterminantBound L K : ℤ)) (typeIIAdmissibleDeterminantBound L K : ℤ),
      ∀ s ∈ range (typeIISmoothDyadicCount L),
      let Z := typeIISmoothDyadicScale U V (U*L^(-K)) s
      0 < Z ∧ Z ≤ 24*U^2*V*L^88/(U*L^(-K)) ∧ |(k : ℝ)| ≤ Z ∧ 3*Z < Real.exp (4*L) := by
  filter_upwards [eventually_fixed_multiple_harmonic_scale_inputs hb hK hC,
    eventually_original_mellin_scale_geometry_range hb hK (by norm_num : (0 : ℝ) < 66),
    eventually_ge_atTop (0 : ℝ)] with L hscale hgeometry hL
  intro μ α β H i j hne
  dsimp only
  intro hUlo hUhi hVlo hVhi
  have hp := (original_active_dyadic_product_bounds hL μ α β H i j hne).2
  have hcoarse : 2*originalDyadicBase i*originalDyadicBase j ≤ 66*Real.exp L := by nlinarith
  have hg := hgeometry _ _ hUlo hVlo hcoarse
  exact ⟨hcoarse,hg.1,hg.2,hscale _ _ hUlo hUhi hVlo hVhi⟩

end Bounty
