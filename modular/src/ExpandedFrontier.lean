/- Uniform Lyapunov rows for an original owner, paying one common atom bound per selected child. -/

open Finset Classical

namespace Bounty

section Owner
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
    [∀ g, DecidableEq (P g)] {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
    (Δ D : ∀ k c, A k c → Fin N → ℤ) (ω : ∀ k c, A k c → ℝ)
    (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ v vmin : ℝ) (V η : Fin N → ℝ) (β : ℝ)
    (steps : List (Option (J ⊕ K)))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))

theorem finite_indexed_list_product {I : Type*} (xs : List I) (f : I → ℝ) :
    (∏ i : Fin xs.length, f (xs.get i)) = (xs.map f).prod := by
  rw [← List.ofFn_getElem_eq_map xs f, List.prod_ofFn]
  rfl

theorem full_mixed_original_forest_bounded
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hη : ∀ g, 0 ≤ η g) (hμatom : ∀ g p, μ g p ≤ η g)
    (hβ : 0 ≤ β)
    (hghostAtom : ∀ j g, (|(1 - q j) * V g / ρ| * η g) * v ≤ β)
    (hedgeAtom : ∀ g, η g ≤ β)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : ∀ g, vmin ≤ V g)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (F : FullPermutationMixedPath n S B A Δ D steps s → ℝ)
    {L : ℝ} (hL : 0 ≤ L) (hF : ∀ p, F p ≤ L) :
    fullMixedPathAbsIntegral n S B A Δ D ω μ q ρ V steps s
      (fun p => if birthForestCompatible
        (fun i => fullMixedPathBirthPerformed n S B A Δ D steps s p (fullMixedBirthOrder S B steps i))
        (fun i => fullMixedPathBirthLabel n S B A Δ D steps s p (fullMixedBirthOrder S B steps i)) code
        then F p else 0) ≤
      (β ^ birthForestRank code * (steps.map (fullMixedLengthRowFactor μ q ρ v vmin V T)).prod) *
        (L * productLengthLyapunov v s) := by
  have hb := full_mixed_original_forest_bound n S B A Δ D ω μ q ρ v vmin V η β steps code
    hω hωmass hμ hmass hη hμatom hβ hghostAtom hedgeAtom hq0 hq1 hρ0 hρ1 hv hvmin hV hD T ht s (fun _ => none) F hL
    (fun p => (hF p).trans (by
      simpa only [mul_one] using
        mul_le_mul_of_nonneg_left (productLengthLyapunov_one_le hv.le _) hL))
  rw [finite_indexed_list_product] at hb
  exact hb

theorem full_mixed_original_forest_mass
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hη : ∀ g, 0 ≤ η g) (hμatom : ∀ g p, μ g p ≤ η g)
    (hβ : 0 ≤ β)
    (hghostAtom : ∀ j g, (|(1 - q j) * V g / ρ| * η g) * v ≤ β)
    (hedgeAtom : ∀ g, η g ≤ β)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : ∀ g, vmin ≤ V g)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
 :
    fullMixedPathAbsIntegral n S B A Δ D ω μ q ρ V steps s
      (fun p => if birthForestCompatible
        (fun i => fullMixedPathBirthPerformed n S B A Δ D steps s p (fullMixedBirthOrder S B steps i))
        (fun i => fullMixedPathBirthLabel n S B A Δ D steps s p (fullMixedBirthOrder S B steps i)) code
        then 1 else 0) ≤
      (β ^ birthForestRank code * (steps.map (fullMixedLengthRowFactor μ q ρ v vmin V T)).prod) *
        productLengthLyapunov v s := by
  simpa only [one_mul] using full_mixed_original_forest_bounded n S B A Δ D ω μ q ρ v vmin V η β steps code
    hω hωmass hμ hmass hη hμatom hβ hghostAtom hedgeAtom hq0 hq1 hρ0 hρ1 hv hvmin hV hD T ht s (fun _ => 1) zero_le_one (fun _ => le_rfl)

theorem full_mixed_empty_original_forest_mass
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hη : ∀ g, 0 ≤ η g) (hμatom : ∀ g p, μ g p ≤ η g)
    (hβ : 0 ≤ β)
    (hghostAtom : ∀ j g, (|(1 - q j) * V g / ρ| * η g) * v ≤ β)
    (hedgeAtom : ∀ g, η g ≤ β)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : ∀ g, vmin ≤ V g)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (hs : productTotalMemory s = 0) :
    fullMixedPathAbsIntegral n S B A Δ D ω μ q ρ V steps s
      (fun p => if birthForestCompatible
        (fun i => fullMixedPathBirthPerformed n S B A Δ D steps s p (fullMixedBirthOrder S B steps i))
        (fun i => fullMixedPathBirthLabel n S B A Δ D steps s p (fullMixedBirthOrder S B steps i)) code
        then 1 else 0) ≤
      β ^ birthForestRank code * (steps.map (fullMixedLengthRowFactor μ q ρ v vmin V T)).prod := by
  simpa only [productLengthLyapunov_empty v s hs, mul_one] using full_mixed_original_forest_mass n S B A Δ D ω μ q ρ v vmin V η β steps code
    hω hωmass hμ hmass hη hμatom hβ hghostAtom hedgeAtom hq0 hq1 hρ0 hρ1 hv hvmin hV hD T ht s

end Owner
