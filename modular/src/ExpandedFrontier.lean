          (physicalGhostTermination (n g) (1 - η g) (ρ g))
          (physicalGhostBirth (n g) (1 - η g) (ρ g) (V g))
          (unrestrictedResidueWeight (fun p => β g p / V g)) (t g) B (s g).2 (e g) : ℂ) *
            (if globalBirthGhostEventFresh (n g) (s g).1 (t g) B (s g).2 (e g) then 1 else 0)) *
          F (boundedGhostJointTarget n t B s e) := by
  unfold boundedGhostJointRow boundedGhostLedgerRow
  rw [fin_tensor_row_events]
  rfl

end Joint
