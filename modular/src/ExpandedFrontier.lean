open Finset Real

namespace Bounty

theorem typeII_finite_smooth_divisor_sum_restrict {L B : ℝ} (hL : 0 < L)
    (S : Finset ℕ) (hS : arithmeticProductWindow 1 (exp L) ⊆ S)
    (a : ℕ → ℂ) (F : ℕ → ℕ → ℂ) :
    (∑ u ∈ S, a u * (typeIIWindowSmooth (L^(-B)) ((u : ℝ)/exp L) : ℂ) *
        ∑ m ∈ (2*u+1).divisors, F u m) =
      ∑ u ∈ arithmeticProductWindow 1 (exp L),
        a u * ∑ m ∈ (2*u+1).divisors,
          (typeIIWindowSmooth (L^(-B)) ((u : ℝ)/exp L) : ℂ) * F u m := by
  rw [typeII_smooth_sum_restrict (exp_pos L) (rpow_pos_of_pos hL _) S hS]
  simp only [← mul_sum, mul_assoc]

