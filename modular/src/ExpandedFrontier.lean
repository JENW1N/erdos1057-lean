open Finset

namespace Bounty

theorem integer_Icc_sum_as_nat_Icc (g : ℤ → ℂ) (a b : ℤ) (hab : a ≤ b) :
    ∑ n ∈ Icc a b, g n = ∑ n ∈ Icc 0 (b-a).toNat, g (a+(n:ℤ)) := by
  symm
  apply sum_bij (fun (n : ℕ) _ => a+(n:ℤ))
  · intro n hn
    have hn' := mem_Icc.mp hn
    rw [mem_Icc]
    omega
  · intro n hn m hm he
    omega
  · intro z hz
    have hz' := mem_Icc.mp hz
    refine ⟨(z-a).toNat, ?_, ?_⟩
    · rw [mem_Icc]
      omega
    · omega
  · intro n hn
    rfl

theorem integer_second_derivative_sum_bound
    {f f' f'' : ℝ → ℝ} {a b : ℤ} {lam A : ℝ}
    (hab : a ≤ b) (hlam : 0 < lam) (hA : 1 ≤ A)
    (hf : ∀ x ∈ Set.Icc (a:ℝ) ((b:ℝ)+1), HasDerivAt f (f' x) x)
    (hf' : ∀ x ∈ Set.Icc (a:ℝ) ((b:ℝ)+1), HasDerivAt f' (f'' x) x)
    (hb : ∀ x ∈ Set.Icc (a:ℝ) ((b:ℝ)+1), lam ≤ f'' x ∧ f'' x ≤ A*lam) :
    ‖∑ n ∈ Icc a b, realUnitPhase (f (n:ℝ))‖ ≤
      6*(A*((b:ℝ)-a+1)*Real.sqrt lam+2/Real.sqrt lam) := by
  have hD : ((b-a).toNat:ℝ) = (b:ℝ)-a := by
    exact_mod_cast Int.toNat_of_nonneg (show 0 ≤ b-a by omega)
  have hm (x : ℝ) (hx : x ∈ Set.Icc (0:ℝ) (((b-a).toNat:ℝ)+1)) :
      (a:ℝ)+x ∈ Set.Icc (a:ℝ) ((b:ℝ)+1) := by
    rw [hD] at hx
    constructor <;> linarith [hx.1,hx.2]
  have hbound := second_derivative_sum_bound
    (f := fun x => f ((a:ℝ)+x)) (f' := fun x => f' ((a:ℝ)+x))
    (f'' := fun x => f'' ((a:ℝ)+x)) (a := 0) (b := (b-a).toNat)
    (Nat.zero_le _) hlam hA
    (fun x hx => by
      simpa only [Function.comp_def, id_eq, mul_one] using
        (hf _ (hm x (by simpa only [Nat.cast_zero] using hx))).comp x ((hasDerivAt_id x).const_add (a:ℝ)))
    (fun x hx => by
      simpa only [Function.comp_def, id_eq, mul_one] using
        (hf' _ (hm x (by simpa only [Nat.cast_zero] using hx))).comp x ((hasDerivAt_id x).const_add (a:ℝ)))
    (fun x hx => hb _ (hm x (by simpa only [Nat.cast_zero] using hx)))
  rw [integer_Icc_sum_as_nat_Icc _ a b hab]
  simpa only [Int.cast_add, Int.cast_natCast, Nat.cast_zero, sub_zero, hD] using hbound

theorem integer_second_derivative_sum_bound_negative
    {f f' f'' : ℝ → ℝ} {a b : ℤ} {lam A : ℝ}
    (hab : a ≤ b) (hlam : 0 < lam) (hA : 1 ≤ A)
    (hf : ∀ x ∈ Set.Icc (a:ℝ) ((b:ℝ)+1), HasDerivAt f (f' x) x)
    (hf' : ∀ x ∈ Set.Icc (a:ℝ) ((b:ℝ)+1), HasDerivAt f' (f'' x) x)
    (hb : ∀ x ∈ Set.Icc (a:ℝ) ((b:ℝ)+1), -A*lam ≤ f'' x ∧ f'' x ≤ -lam) :
    ‖∑ n ∈ Icc a b, realUnitPhase (f (n:ℝ))‖ ≤
      6*(A*((b:ℝ)-a+1)*Real.sqrt lam+2/Real.sqrt lam) := by
  have hD : ((b-a).toNat:ℝ) = (b:ℝ)-a := by
    exact_mod_cast Int.toNat_of_nonneg (show 0 ≤ b-a by omega)
  have hm (x : ℝ) (hx : x ∈ Set.Icc (0:ℝ) (((b-a).toNat:ℝ)+1)) :
      (a:ℝ)+x ∈ Set.Icc (a:ℝ) ((b:ℝ)+1) := by
    rw [hD] at hx
    constructor <;> linarith [hx.1,hx.2]
  have hbound := second_derivative_sum_bound_negative
    (f := fun x => f ((a:ℝ)+x)) (f' := fun x => f' ((a:ℝ)+x))
    (f'' := fun x => f'' ((a:ℝ)+x)) (a := 0) (b := (b-a).toNat)
    (Nat.zero_le _) hlam hA
    (fun x hx => by
      simpa only [Function.comp_def, id_eq, mul_one] using
        (hf _ (hm x (by simpa only [Nat.cast_zero] using hx))).comp x ((hasDerivAt_id x).const_add (a:ℝ)))
    (fun x hx => by
      simpa only [Function.comp_def, id_eq, mul_one] using
        (hf' _ (hm x (by simpa only [Nat.cast_zero] using hx))).comp x ((hasDerivAt_id x).const_add (a:ℝ)))
    (fun x hx => hb _ (hm x (by simpa only [Nat.cast_zero] using hx)))
  rw [integer_Icc_sum_as_nat_Icc _ a b hab]
  simpa only [Int.cast_add, Int.cast_natCast, Nat.cast_zero, sub_zero, hD] using hbound

end Bounty
end

section

/- The exact shared-prime overlap correction to the stripped vertex weight. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def physicalUnsharedVertex {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (q : ℝ) (w : ℤ) : ℝ :=
  finiteMarkedVertex (physicalMarkedPrimes L \ physicalSharedPrimes C L)
    (fun p : PhysicalPrime P => (p.2.val : ℤ) ∣ w) q

noncomputable def physicalSharedOverlap {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (q : ℝ) (w : ℤ) : ℝ :=
  ∏ p ∈ physicalSharedPrimes C L, if (p.2.val : ℤ) ∣ w then q else 1

theorem physical_shared_vertex_removal {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (q : ℝ) (w : ℤ) :
    physicalVertexWeight L q ((physicalSharedFactor C L : ℤ) * w) *
        physicalSharedOverlap C L q w = physicalUnsharedVertex C L q w := by
  rw [physical_vertex_weight_as_finite]
  have h := finite_shared_vertex_removal (physicalMarkedPrimes L) (physicalSharedPrimes C L)
    (fun p : PhysicalPrime P => (p.2.val : ℤ) ∣ w)
    (fun p : PhysicalPrime P => (p.2.val : ℤ) ∣ (physicalSharedFactor C L : ℤ) * w)
    q (physical_shared_primes_subset_marked C L)
    (fun p => physical_prime_dvd_shared_mul C L hprime hdis p w)
  unfold physicalSharedOverlap physicalUnsharedVertex
  convert h using 1
  · congr 1
    apply prod_congr rfl
    intro p _
    split_ifs <;> rfl
  · apply congrArg (fun s => finiteMarkedVertex s
      (fun p : PhysicalPrime P => (p.2.val : ℤ) ∣ w) q)
    ext p
    simp only [mem_sdiff]

theorem physical_shared_overlap_eq_one {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (q : ℝ) (w : ℤ)
    (havoid : ∀ p ∈ physicalSharedPrimes C L, ¬(p.2.val : ℤ) ∣ w) :
    physicalSharedOverlap C L q w = 1 := by
  exact prod_eq_one (fun p hp => if_neg (havoid p hp))

theorem physical_shared_vertex_of_avoids {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (q : ℝ) (w : ℤ)
    (havoid : ∀ p ∈ physicalSharedPrimes C L, ¬(p.2.val : ℤ) ∣ w) :
    physicalVertexWeight L q ((physicalSharedFactor C L : ℤ) * w) =
      physicalUnsharedVertex C L q w := by
  simpa only [physical_shared_overlap_eq_one C L q w havoid, mul_one] using
    physical_shared_vertex_removal C L hprime hdis q w

theorem physical_shared_factor_eq_of_compatible {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    {L R : PhysicalMarkLists P J ell} (hshared : physicalSharedCompatible C L R) :
    physicalSharedFactor C L = physicalSharedFactor C R := by
  apply prod_congr rfl
  intro a _
  rw [hshared a.1 a.2.val (mem_sdiff.mp a.2.property).2]

theorem physical_shared_vertex_pair_removal {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L R : PhysicalMarkLists P J ell) (hshared : physicalSharedCompatible C L R)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (q : ℝ) (w z : ℤ) :
    (physicalVertexWeight L q ((physicalSharedFactor C L : ℤ) * w) *
      physicalVertexWeight R q ((physicalSharedFactor C L : ℤ) * z)) *
      (physicalSharedOverlap C L q w * physicalSharedOverlap C L q z) =
        physicalUnsharedVertex C L q w * physicalUnsharedVertex C R q z := by
  have hR : physicalVertexWeight R q ((physicalSharedFactor C L : ℤ) * z) *
      physicalSharedOverlap C L q z = physicalUnsharedVertex C R q z := by
    rw [physical_shared_factor_eq_of_compatible C hshared]
    simpa only [physicalSharedOverlap, physical_shared_primes_eq_of_compatible C hshared] using
      physical_shared_vertex_removal C R hprime hdis q z
  calc
    _ = (physicalVertexWeight L q ((physicalSharedFactor C L : ℤ) * w) *
          physicalSharedOverlap C L q w) *
        (physicalVertexWeight R q ((physicalSharedFactor C L : ℤ) * z) *
          physicalSharedOverlap C L q z) := by ring
    _ = _ := by rw [physical_shared_vertex_removal C L hprime hdis q w, hR]

theorem physical_shared_normalized_vertex_pair {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (L R : PhysicalMarkLists P J ell) (hshared : physicalSharedCompatible C L R)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (q : ℝ) (w z : ℤ) :
    (physicalStateMass V J ell * physicalCompletionMass V C ell /
      (physicalSharedFactor C L : ℝ)) *
      ((physicalVertexWeight L q ((physicalSharedFactor C L : ℤ) * w) *
        physicalVertexWeight R q ((physicalSharedFactor C L : ℤ) * z)) *
        (physicalSharedOverlap C L q w * physicalSharedOverlap C L q z)) =
      (physicalAuxMass V (fun g => univ \ C g) (physicalSharedAux C L) *
        physicalCompletionMass V C ell ^ 2) *
        (physicalUnsharedVertex C L q w * physicalUnsharedVertex C R q z) := by
  rw [physical_shared_joint_normalization,
    physical_shared_vertex_pair_removal C L R hshared hprime hdis q w z]

end Bounty
end

section

/- Weighted support, rather than closure of all quotients, removes a finite endpoint mask. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

theorem typeII_weighted_direct_endpoint_support
    (M H : Finset ℕ) (A B : ℕ → ℂ) (W : ℕ → ℝ) (t : ℝ) {v : ℕ}
    (hv : 0 < v) (hM : ∀ m ∈ M, 0 < m)
    (hW : ∀ m ∈ M, ∀ h : ℕ, 0 < h → W (m*h)=W h)
    (hsupport : ∀ h : ℕ, 0 < h → h ∉ H → (W h:ℂ)*B h=0) :
    typeIIDirectEndpoint M H A B t v * (W v:ℂ) =
      typeIIDirectEndpoint M (Icc 1 v) A B t v * (W v:ℂ) := by
  classical
  rw [typeII_direct_endpoint_eq_divisor_mask M H A B t v hM,
    typeII_direct_endpoint_eq_divisor_mask M (Icc 1 v) A B t v hM, sum_mul, sum_mul]
  apply sum_congr rfl
  intro m hm
  by_cases hd : m ∣ v
  · have hq := reconstructed_factor_mem_Icc hv hd (le_refl v)
    have hqpos : 0 < v/m := (mem_Icc.mp hq).1
    simp only [hd, true_and, hq, if_true]
    by_cases hh : v/m ∈ H
    · simp only [hh, if_true]
    · simp only [hh, if_false, zero_mul]
      have hWv : W v = W (v/m) := by
        calc
          _ = W (m*(v/m)) := congrArg W (Nat.mul_div_cancel' hd).symm
          _ = _ := hW m hm (v/m) hqpos
      have hz := congrArg (fun z : ℂ => conj z) (hsupport (v/m) hqpos hh)
      simp only [map_mul, Complex.conj_ofReal, map_zero] at hz
      rw [hWv]
      linear_combination -(A m * typeIIPhase t m) * hz
  · simp only [hd, false_and, if_false]

theorem typeII_weighted_rough_endpoint_support
    (P M H R C : Finset ℕ) (A c : ℕ → ℂ) (W : ℕ → ℝ) (t σ : ℝ) {v : ℕ}
    (hv : 0 < v) (hM : ∀ m ∈ M, 0 < m)
    (hfree : ∀ m ∈ M, Disjoint m.primeFactors P)
    (hW : ∀ m ∈ M, ∀ h : ℕ, 0 < h → W (m*h)=W h)
    (hsupport : ∀ h : ℕ, 0 < h → h ∉ H →
      (W h:ℂ)*typeIIRoughConvolution R C σ c (primePoolFreePart P h)=0) :
    typeIIDirectEndpoint M H A
      (fun h => typeIIRoughConvolution R C σ c (primePoolFreePart P h)) t v * (W v:ℂ) =
      typeIIInvariantEndpoint P M R C A c t σ v * (W v:ℂ) := by
  rw [typeII_weighted_direct_endpoint_support M H A _ W t hv hM hW hsupport,
    typeII_direct_rough_endpoint_eq_invariant_of_complete P M (Icc 1 v) R C A c t σ
      hv hM hfree (fun m _ hd => reconstructed_factor_mem_Icc hv hd (le_refl v))]
  rfl

theorem typeII_cross_pair_eq_invariant_of_weighted_support
    (P M H R C : Finset ℕ) (A c : ℕ → ℂ) (W : ℕ → ℝ)
    (ρ σ ξ₁ ξ₂ ξ₃ : ℝ) {z w : ℕ} (hz : 0 < z) (hw : 0 < w)
    (hM : ∀ m ∈ M, 0 < m) (hH : ∀ h ∈ H, 0 < h)
    (hfree : ∀ m ∈ M, Disjoint m.primeFactors P)
    (hW : ∀ m ∈ M, ∀ h : ℕ, 0 < h → W (m*h)=W h)
    (hsupport : ∀ h : ℕ, 0 < h → h ∉ H →
      (W h:ℂ)*typeIIRoughConvolution R C σ c (primePoolFreePart P h)=0) :
    typeIICrossPairCoefficient M H A W
      (fun h => typeIIRoughConvolution R C σ c (primePoolFreePart P h)) ρ ξ₁ ξ₂ ξ₃ z w =
      typeIIPhase (ρ+ξ₃) z * typeIIPhase (-ρ) w *
        conj (typeIIInvariantEndpoint P M R C A c (ρ-ξ₂) σ z) *
        typeIIInvariantEndpoint P M R C A c (ξ₁+ρ) σ w * (W z:ℂ) * (W w:ℂ) := by
  rw [typeII_cross_pair_coefficient_factorization M H A W _ ρ ξ₁ ξ₂ ξ₃ z w hM hH
    (fun m hm h hh => hW m hm h (hH h hh))]
  have hz' := typeII_weighted_rough_endpoint_support P M H R C A c W (ρ-ξ₂) σ hz hM hfree hW hsupport
  have hw' := typeII_weighted_rough_endpoint_support P M H R C A c W (ξ₁+ρ) σ hw hM hfree hW hsupport
  have hzc := congrArg (fun x : ℂ => conj x) hz'
  simp only [map_mul, Complex.conj_ofReal] at hzc
  calc
    _ = (typeIIPhase (ρ+ξ₃) z * typeIIPhase (-ρ) w) *
      (conj (typeIIDirectEndpoint M H A
        (fun h => typeIIRoughConvolution R C σ c (primePoolFreePart P h)) (ρ-ξ₂) z) * (W z:ℂ)) *
      (typeIIDirectEndpoint M H A
        (fun h => typeIIRoughConvolution R C σ c (primePoolFreePart P h)) (ξ₁+ρ) w * (W w:ℂ)) := by ring
    _ = _ := by rw [hzc, hw']; ring

end Bounty
end

section

/- The actual marked coefficients are unchanged by factors outside the prime pool. -/

open Finset

namespace Bounty

theorem physical_divisor_pool_mul_free {G : Type*} (P : G → Finset ℕ)
    (g : G) (Q : Finset ℕ) (hP : ∀ p ∈ P g, p.Prime) (hPQ : P g ⊆ Q)
    (a b : ℕ) (hb : b ≠ 0) (hfree : Disjoint b.primeFactors Q) :
    physicalDivisorPool P g ((a * b : ℕ) : ℤ) = physicalDivisorPool P g (a : ℤ) := by
  exact physical_divisor_pool_mul_disjoint P g hP (hfree.symm.mono_left hPQ)
    (Nat.mem_factoredNumbers_of_primeFactors_subset hb (fun _ h => h)) a

theorem marked_divisor_weight_mul_free {G : Type*} (groups : Finset G)
    (P : G → Finset ℕ) (Q : Finset ℕ) (q : ℝ) (V : G → ℝ) (t : G → ℕ)
    (hP : ∀ g ∈ groups, ∀ p ∈ P g, p.Prime) (hPQ : ∀ g ∈ groups, P g ⊆ Q)
    (a b : ℕ) (hb : b ≠ 0) (hfree : Disjoint b.primeFactors Q) :
    markedDivisorWeight groups P q V t ((a * b : ℕ) : ℤ) =
      markedDivisorWeight groups P q V t (a : ℤ) := by
  unfold markedDivisorWeight
  apply prod_congr rfl
  intro g hg
  simp only [physicalOmega, physical_divisor_pool_mul_free P g Q (hP g hg) (hPQ g hg) a b hb hfree]

theorem group_marked_average_mul_free {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (Q : Finset ℕ) (t : G → ℕ)
    (hP : ∀ g, ∀ p ∈ P g, p.Prime) (hPQ : ∀ g, P g ⊆ Q)
    (a b : ℕ) (hb : b ≠ 0) (hfree : Disjoint b.primeFactors Q)
    (c : GroupMarkedLists P t → ℂ) :
    groupMarkedAverage P t ((a * b : ℕ) : ℤ) c = groupMarkedAverage P t (a : ℤ) c := by
  apply group_marked_average_congr_divisor_pools
  intro g
  exact physical_divisor_pool_mul_free P g Q (hP g) (hPQ g) a b hb hfree

theorem primePoolPart_mul_pool_free (Q : Finset ℕ) (a b : ℕ)
    (hb : b ≠ 0) (hfree : Disjoint b.primeFactors Q) :
    primePoolPart Q (a * b) = primePoolPart Q a := by
  by_cases ha : a = 0
  · simp only [ha, zero_mul]
  · rw [primePoolPart_mul Q ha hb, primePoolPart_eq_one_of_disjoint hfree.symm
      (Nat.mem_factoredNumbers_of_primeFactors_subset hb (fun _ h => h)), mul_one]

end Bounty
end

section

/- A four-factor convolution is majorized by the fourth Dirichlet power of zeta. -/

open Finset

namespace Bounty

theorem divisor_card_eq_zeta_square (n : ℕ) :
    n.divisors.card = (ArithmeticFunction.zeta ^ 2) n := by
  rw [pow_two, ArithmeticFunction.zeta_mul_apply]
  calc
    _ = ∑ _d ∈ n.divisors, (1 : ℕ) := by simp only [sum_const, smul_eq_mul, mul_one]
    _ = _ := by
      apply sum_congr rfl
      intro d hd
      exact (ArithmeticFunction.zeta_apply_ne (Nat.ne_of_gt (Nat.pos_of_mem_divisors hd))).symm

theorem divisor_sum_zeta_norm_le (δ f : ℕ → ℂ) {D B : ℝ}
    (hD : 0 ≤ D) (_hB : 0 ≤ B) (k n : ℕ)
    (hδ : ∀ d, ‖δ d‖ ≤ D)
    (hf : ∀ m, ‖f m‖ ≤ B * ((ArithmeticFunction.zeta ^ k) m : ℝ)) :
    ‖∑ d ∈ n.divisors, δ d * f (n / d)‖ ≤
      D * B * ((ArithmeticFunction.zeta ^ (k + 1)) n : ℝ) := by
  calc
    _ ≤ ∑ d ∈ n.divisors, ‖δ d * f (n / d)‖ := norm_sum_le _ _
    _ ≤ ∑ d ∈ n.divisors, D * (B * ((ArithmeticFunction.zeta ^ k) (n / d) : ℝ)) := by
      apply sum_le_sum
      intro d _
      rw [norm_mul]
      exact mul_le_mul (hδ d) (hf (n / d)) (norm_nonneg _) hD
    _ = D * B * (∑ d ∈ n.divisors, ((ArithmeticFunction.zeta ^ k) d : ℝ)) := by
      rw [← mul_sum, ← mul_sum, Nat.sum_div_divisors n (fun d => ((ArithmeticFunction.zeta ^ k) d : ℝ))]
      ring
    _ = _ := by rw [pow_succ, ArithmeticFunction.mul_zeta_apply, Nat.cast_sum]

theorem divisor_pair_convolution_norm_le (β γ : ℕ → ℂ) {B C : ℝ}
    (hB : 0 ≤ B) (_hC : 0 ≤ C) (hβ : ∀ d, ‖β d‖ ≤ B) (hγ : ∀ d, ‖γ d‖ ≤ C)
    (n : ℕ) :
    ‖∑ d ∈ n.divisors, β d * γ (n / d)‖ ≤
      B * C * ((ArithmeticFunction.zeta ^ 2) n : ℝ) := by
  calc
    _ ≤ ∑ d ∈ n.divisors, ‖β d * γ (n / d)‖ := norm_sum_le _ _
    _ ≤ ∑ _d ∈ n.divisors, B * C := by
      apply sum_le_sum
      intro d _
      rw [norm_mul]
      exact mul_le_mul (hβ d) (hγ (n / d)) (norm_nonneg _) hB
    _ = _ := by rw [sum_const, nsmul_eq_mul, divisor_card_eq_zeta_square]; ring

theorem endpoint_triple_convolution_zeta_bound (α β γ : ℕ → ℂ) {A B C : ℝ}
    (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ d, ‖α d‖ ≤ A) (hβ : ∀ d, ‖β d‖ ≤ B) (hγ : ∀ d, ‖γ d‖ ≤ C)
    (n : ℕ) :
    ‖endpointTripleConvolution α β γ n‖ ≤
      A * B * C * ((ArithmeticFunction.zeta ^ 3) n : ℝ) := by
  have h := divisor_sum_zeta_norm_le α (fun m => ∑ d ∈ m.divisors, β d * γ (m / d))
    hA (mul_nonneg hB hC) 2 n hα (divisor_pair_convolution_norm_le β γ hB hC hβ hγ)
  simpa only [endpointTripleConvolution, mul_sum, ← mul_assoc] using h

theorem endpoint_four_convolution_zeta_bound (δ α β γ : ℕ → ℂ) {D A B C : ℝ}
    (hD : 0 ≤ D) (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hδ : ∀ d, ‖δ d‖ ≤ D) (hα : ∀ d, ‖α d‖ ≤ A)
    (hβ : ∀ d, ‖β d‖ ≤ B) (hγ : ∀ d, ‖γ d‖ ≤ C) (n : ℕ) :
    ‖endpointFourConvolution δ α β γ n‖ ≤
      D * A * B * C * ((ArithmeticFunction.zeta ^ 4) n : ℝ) := by
  have h := divisor_sum_zeta_norm_le δ (endpointTripleConvolution α β γ)
    hD (mul_nonneg (mul_nonneg hA hB) hC) 3 n hδ
    (endpoint_triple_convolution_zeta_bound α β γ hA hB hC hα hβ hγ)
  simpa only [endpointFourConvolution, ← mul_assoc] using h

end Bounty
end

section

/- The actual four-factor divisor convolution equals its finite box transform. -/

open Finset

namespace Bounty

theorem endpoint_four_finite_transform (S D A B C : Finset ℕ) (δ α β γ F : ℕ → ℂ)
    (hD : ∀ d ∈ D, 0 < d) (hA : ∀ a ∈ A, 0 < a)
    (hB : ∀ b ∈ B, 0 < b) (hC : ∀ c ∈ C, 0 < c)
    (hδ : ∀ d, d ∉ D → δ d = 0) (hα : ∀ a, a ∉ A → α a = 0)
    (hβ : ∀ b, b ∉ B → β b = 0) (hγ : ∀ c, c ∉ C → γ c = 0)
    (hS : ∀ d ∈ D, ∀ a ∈ A, ∀ b ∈ B, ∀ c ∈ C, d*a*b*c ∈ S) :
    (∑ n ∈ S, endpointFourConvolution δ α β γ n*F n) =
      ∑ d ∈ D, ∑ a ∈ A, ∑ b ∈ B, ∑ c ∈ C, δ d*α a*β b*γ c*F (d*a*b*c) := by
  classical
  let U := (B ×ˢ C).image (fun bc => bc.1*bc.2)
  let V := (A ×ˢ U).image (fun ar => ar.1*ar.2)
  have hU : ∀ r ∈ U, 0 < r := finite_natural_product_pos B C hB hC
  have hV : ∀ r ∈ V, 0 < r := finite_natural_product_pos A U hA hU
  have hf : ∀ r, r ∉ V → endpointTripleConvolution α β γ r = 0 :=
    endpoint_triple_finite_support A B C α β γ hA hB hC hα hβ hγ
  have hout := finite_divisor_convolution_transform S D V δ
    (endpointTripleConvolution α β γ) F hD hV hδ hf (by
      intro d hd r hr
      obtain ⟨ar,har,rfl⟩ := mem_image.mp hr
      obtain ⟨bc,hbc,hbcEq⟩ := mem_image.mp (mem_product.mp har).2
      rw [← hbcEq]
      simpa only [Nat.mul_assoc] using hS d hd ar.1 (mem_product.mp har).1
        bc.1 (mem_product.mp hbc).1 bc.2 (mem_product.mp hbc).2)
  calc
    _ = ∑ d ∈ D, ∑ r ∈ V, δ d*endpointTripleConvolution α β γ r*F (d*r) := hout
    _ = _ := by
      apply sum_congr rfl
      intro d hd
      have hi := endpoint_triple_finite_transform V A B C α β γ (fun r => F (d*r))
        hA hB hC hα hβ hγ (by
          intro a ha b hb c hc
          apply mem_image.mpr
          refine ⟨(a,b*c),mem_product.mpr ⟨ha,?_⟩,?_⟩
          · exact mem_image.mpr ⟨(b,c),mem_product.mpr ⟨hb,hc⟩,rfl⟩
          · exact (Nat.mul_assoc a b c).symm)
      calc
        _ = δ d*(∑ r ∈ V, endpointTripleConvolution α β γ r*F (d*r)) := by
          rw [mul_sum]
          apply sum_congr rfl
          intro r hr
          ring
        _ = δ d*(∑ a ∈ A, ∑ b ∈ B, ∑ c ∈ C, α a*β b*γ c*F (d*(a*b*c))) :=
          congrArg (fun z => δ d*z) hi
        _ = _ := by simp only [mul_sum,mul_assoc]

theorem endpoint_four_finite_mellin (S D A B C : Finset ℕ) (δ α β γ : ℕ → ℂ)
    (hD : ∀ d ∈ D, 0 < d) (hA : ∀ a ∈ A, 0 < a)
    (hB : ∀ b ∈ B, 0 < b) (hC : ∀ c ∈ C, 0 < c)
    (hδ : ∀ d, d ∉ D → δ d = 0) (hα : ∀ a, a ∉ A → α a = 0)
    (hβ : ∀ b, b ∉ B → β b = 0) (hγ : ∀ c, c ∉ C → γ c = 0)
    (hS : ∀ d ∈ D, ∀ a ∈ A, ∀ b ∈ B, ∀ c ∈ C, d*a*b*c ∈ S) (t : ℝ) :
    (∑ n ∈ S, endpointFourConvolution δ α β γ n*harmonicMellinWeight t n) =
      (∑ d ∈ D, δ d*harmonicMellinWeight t d)*
      (∑ a ∈ A, α a*harmonicMellinWeight t a)*
      (∑ b ∈ B, β b*harmonicMellinWeight t b)*
      (∑ c ∈ C, γ c*harmonicMellinWeight t c) := by
  rw [endpoint_four_finite_transform S D A B C δ α β γ _ hD hA hB hC hδ hα hβ hγ hS]
  exact harmonic_mellin_four_factor_box D A B C hD hA hB hC δ α β γ t

end Bounty
end

section

/- A nonzero coefficient supplies actual supported integer factors. -/

open Finset

namespace Bounty

theorem divisor_pair_nonzero_factors (α β : ℕ → ℂ) {n : ℕ}
    (hn : (∑ d ∈ n.divisors, α d*β (n/d)) ≠ 0) :
    ∃ a b : ℕ, 0 < a ∧ 0 < b ∧ α a ≠ 0 ∧ β b ≠ 0 ∧ a*b = n := by
  obtain ⟨a,ha,hna⟩ := exists_ne_zero_of_sum_ne_zero hn
  have hb : 0 < n/a := Nat.pos_of_ne_zero (by
    intro hz
    have he := Nat.mul_div_cancel' (Nat.dvd_of_mem_divisors ha)
    rw [hz,mul_zero] at he
    exact (Nat.ne_zero_of_mem_divisors ha) he.symm)
  refine ⟨a,n/a,Nat.pos_of_mem_divisors ha,hb,?_,?_,Nat.mul_div_cancel' (Nat.dvd_of_mem_divisors ha)⟩
  · intro hz
    exact hna (by rw [hz,zero_mul])
  · intro hz
    exact hna (by rw [hz,mul_zero])

theorem endpoint_triple_nonzero_factors (α β γ : ℕ → ℂ) {n : ℕ}
    (hn : endpointTripleConvolution α β γ n ≠ 0) :
    ∃ a b c : ℕ, 0 < a ∧ 0 < b ∧ 0 < c ∧ α a ≠ 0 ∧ β b ≠ 0 ∧ γ c ≠ 0 ∧ a*b*c = n := by
  unfold endpointTripleConvolution at hn
  obtain ⟨a,ha,hna⟩ := exists_ne_zero_of_sum_ne_zero hn
  obtain ⟨b,hb,hnab⟩ := exists_ne_zero_of_sum_ne_zero hna
  have ha0 := Nat.pos_of_mem_divisors ha
  have hb0 := Nat.pos_of_mem_divisors hb
  have hc0 : 0 < n/a/b := Nat.pos_of_ne_zero (by
    intro hz
    have he := Nat.mul_div_cancel' (Nat.dvd_of_mem_divisors hb)
    rw [hz,mul_zero] at he
    exact (Nat.ne_zero_of_mem_divisors hb) he.symm)
  have hα : α a ≠ 0 := by intro hz; exact hnab (by rw [hz,zero_mul,zero_mul])
  have hβ : β b ≠ 0 := by intro hz; exact hnab (by rw [hz,mul_zero,zero_mul])
  have hγ : γ (n/a/b) ≠ 0 := by intro hz; exact hnab (by rw [hz,mul_zero])
  refine ⟨a,b,n/a/b,ha0,hb0,hc0,hα,hβ,hγ,?_⟩
  rw [Nat.mul_assoc,Nat.mul_div_cancel' (Nat.dvd_of_mem_divisors hb),
    Nat.mul_div_cancel' (Nat.dvd_of_mem_divisors ha)]

theorem endpoint_four_nonzero_factors (δ α β γ : ℕ → ℂ) {n : ℕ}
    (hn : endpointFourConvolution δ α β γ n ≠ 0) :
    ∃ d a b c : ℕ, 0 < d ∧ 0 < a ∧ 0 < b ∧ 0 < c ∧
      δ d ≠ 0 ∧ α a ≠ 0 ∧ β b ≠ 0 ∧ γ c ≠ 0 ∧ d*a*b*c = n := by
  unfold endpointFourConvolution at hn
  obtain ⟨d,hd,hnd⟩ := exists_ne_zero_of_sum_ne_zero hn
  have hδ : δ d ≠ 0 := by intro hz; exact hnd (by rw [hz,zero_mul])
  have ht : endpointTripleConvolution α β γ (n/d) ≠ 0 := by
    intro hz
    exact hnd (by rw [hz,mul_zero])
  obtain ⟨a,b,c,ha,hb,hc,hα,hβ,hγ,he⟩ := endpoint_triple_nonzero_factors α β γ ht
  refine ⟨d,a,b,c,Nat.pos_of_mem_divisors hd,ha,hb,hc,hδ,hα,hβ,hγ,?_⟩
  calc
    d*a*b*c = d*(a*b*c) := by ring
    _ = d*(n/d) := by rw [he]
    _ = n := Nat.mul_div_cancel' (Nat.dvd_of_mem_divisors hd)

end Bounty
end

section

/- One explicit finite position set covers both endpoints of every original
shared/free shift with quotient in the prescribed finite set. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def physicalShiftedPositionClosure {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {J : ℕ} (C : G → Finset (Fin J)) (ell : ℕ)
    (k : ℤ) (Z : Finset ℤ) : Finset ℤ :=
  physicalScaledPositionClosure P C ell
    (Z ∪ univ.biUnion (fun aux : PhysicalAuxLabels P C =>
      Z.image (fun z => z + k * (physicalFreeFactor C aux : ℕ))))

theorem physical_shifted_position_coverage {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {J ell : ℕ} (C : G → Finset (Fin J)) (k : ℤ)
    (Z : Finset ℤ) (L : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C)
    {z : ℤ} (hz : z ∈ Z) :
    (physicalSharedFactor C L : ℤ) * z ∈ physicalShiftedPositionClosure P C ell k Z ∧
    (physicalSharedFactor C L : ℤ) * z + k * (physicalD C L aux : ℕ) ∈
      physicalShiftedPositionClosure P C ell k Z := by
  constructor
  · exact physical_scaled_position_mem P C _ L (mem_union_left _ hz)
  · have ht : z + k * (physicalFreeFactor C aux : ℕ) ∈
        Z ∪ univ.biUnion (fun a : PhysicalAuxLabels P C =>
          Z.image (fun w => w + k * (physicalFreeFactor C a : ℕ))) :=
      mem_union_right _ (mem_biUnion.mpr ⟨aux, mem_univ _, mem_image.mpr ⟨z, hz, rfl⟩⟩)
    have he : (physicalSharedFactor C L : ℤ) * z + k * (physicalD C L aux : ℕ) =
        (physicalSharedFactor C L : ℤ) * (z + k * (physicalFreeFactor C aux : ℕ)) := by
      rw [physical_D_shared_free, Nat.cast_mul]
      ring
    rw [he]
    exact physical_scaled_position_mem P C _ L ht

theorem physical_shifted_position_sum {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {J ell : ℕ} (C : G → Finset (Fin J)) (k : ℤ)
    (hprime : ∀ g p, p ∈ P g → p.Prime) (Z : Finset ℤ)
    (L : PhysicalMarkLists P J ell) (F : ℤ → ℂ) :
    (∑ n ∈ physicalShiftedPositionClosure P C ell k Z,
      if (physicalSharedFactor C L : ℤ) ∣ n ∧ n / physicalSharedFactor C L ∈ Z
        then F (n / physicalSharedFactor C L) else 0) = ∑ z ∈ Z, F z := by
  apply integer_scaled_position_sum
  · exact_mod_cast (physical_shared_factor_pos C L hprime).ne'
  · intro z hz
    exact physical_scaled_position_mem P C _ L (mem_union_left _ hz)

end Bounty
end

section

/- Split each original injective mark list into its shared and unshared embeddings. -/

open Finset
open scoped Classical
namespace Bounty

abbrev PhysicalCutGroupData (P : Finset ℕ) {J : ℕ} (C : Finset (Fin J)) (ell : ℕ) :=
  {f : (↥(univ \ C) ↪ ↥P) × (Fin (ell+C.card) ↪ ↥P) //
    Disjoint (Set.range f.1) (Set.range f.2)}

noncomputable def physicalCutGroupEquiv (P : Finset ℕ) {J : ℕ}
    (C : Finset (Fin J)) (ell : ℕ) :
    (PhysicalSlots J ell ↪ ↥P) ≃ PhysicalCutGroupData P C ell :=
  (Equiv.embeddingCongr (physicalCutSlotEquiv C).symm (Equiv.refl ↥P)).trans
    Equiv.sumEmbeddingEquivProdEmbeddingDisjoint

noncomputable def physicalCutListEquiv {G : Type*} (P : G → Finset ℕ) {J : ℕ}
    (C : G → Finset (Fin J)) (ell : ℕ) :
    PhysicalMarkLists P J ell ≃ (∀ g, PhysicalCutGroupData (P g) (C g) ell) :=
  Equiv.piCongrRight (fun g => physicalCutGroupEquiv (P g) (C g) ell)

theorem physical_cut_list_shared {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (L : PhysicalMarkLists P J ell) (g : G) :
    ((physicalCutListEquiv P C ell L g).val.1 : ↥(univ \ C g) → ↥(P g)) =
      physicalSharedAux C L g := rfl

theorem physical_cut_list_unshared {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (L : PhysicalMarkLists P J ell) (g : G) :
    (physicalCutListEquiv P C ell L g).val.2 = physicalGroupUnsharedEmbedding C L g := by
  apply Function.Embedding.ext
  intro i
  rfl

theorem physical_cut_list_shared_disjoint {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (L : PhysicalMarkLists P J ell) (g : G) :
    Disjoint (Set.range (physicalSharedAux C L g))
      (Set.range (physicalGroupUnsharedEmbedding C L g)) := by
  have h := (physicalCutListEquiv P C ell L g).property
  simpa only [physical_cut_list_shared, physical_cut_list_unshared] using h

end Bounty
end

section

/- The actual candidate pools supply a common harmonic floor, exponentially
large primes and a logarithmic bound on the total shared-slot count. -/

open Finset Filter
open scoped Classical
namespace Bounty

theorem exists_candidate_shared_error_inputs {c : ℝ} (hc : 0 < c) (J : ℕ) :
    ∃ v A : ℝ, 0 < v ∧ 0 ≤ A ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (S : Finset ℕ), S ⊆ candidatePIndices c L →
        ((J * S.card : ℕ) : ℝ) ≤ A * Real.log L ∧
        ∀ (g : S),
          v ≤ ∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ) ∧
          ∀ p ∈ candidatePBand (c*L) g.val,
            p.Prime ∧ Real.exp (L^(1/10 : ℝ)) ≤ (p : ℝ) := by
  obtain ⟨v, V, hv, _, hpool⟩ := exists_candidate_P_pool_bounds hc
  refine ⟨v, (J : ℝ) * (2 / (5 * Real.log 2)), hv, by positivity, ?_⟩
  filter_upwards [hpool] with L hL
  intro S hS
  refine ⟨?_, ?_⟩
  · have hcard : (S.card : ℝ) ≤ (2 / (5 * Real.log 2)) * Real.log L :=
      (Nat.cast_le.mpr (card_le_card hS)).trans hL.2.2.2.1
    simpa only [Nat.cast_mul, mul_assoc] using mul_le_mul_of_nonneg_left hcard (Nat.cast_nonneg J)
  · intro g
    obtain ⟨hlo, _, hp⟩ := hL.2.2.2.2.2 g.val (hS g.property)
    exact ⟨hlo, fun p hmem => ⟨(hp p hmem).1, (hp p hmem).2.1.le⟩⟩

theorem endpoint_shared_log_bound {L B : ℝ} (hL : 1 ≤ L) {J w z : ℕ}
    (hw : Real.log w ≤ B * L) (hz : Real.log z ≤ B * L) :
    Real.log w / Real.log 2 + Real.log z / Real.log 2 + J ≤
      (2 * B / Real.log 2 + J) * L := by
  have h2 : 0 ≤ Real.log (2 : ℝ) := Real.log_nonneg (by norm_num)
  have hw' := div_le_div_of_nonneg_right hw h2
  have hz' := div_le_div_of_nonneg_right hz h2
  have hJ := mul_le_mul_of_nonneg_left hL (Nat.cast_nonneg J : (0 : ℝ) ≤ J)
  calc
    _ ≤ (B*L)/Real.log 2 + (B*L)/Real.log 2 + (J : ℝ)*L := by linarith
    _ = _ := by ring

end Bounty
end

section

/- Finite multiplication pullback retaining the original position guard. -/

open Finset
open scoped Classical
namespace Bounty

theorem integer_guarded_position_sum {s : ℤ} (hs : s ≠ 0)
    (positions W : Finset ℤ) (F : ℤ → ℂ)
    (hzero : ∀ n ∈ positions, ¬ s ∣ n → F n = 0)
    (hW : ∀ n ∈ positions, s ∣ n → F n ≠ 0 → n / s ∈ W) :
    (∑ n ∈ positions, F n) =
      ∑ w ∈ W, if s * w ∈ positions then F (s * w) else 0 := by
  let A := W.filter (fun w => s * w ∈ positions)
  have hp := integer_scaled_position_sum hs A positions
    (fun w hw => (mem_filter.mp hw).2) (fun w => F (s * w))
  calc
    _ = ∑ n ∈ positions, if s ∣ n ∧ n / s ∈ A then F (s * (n / s)) else 0 := by
      apply sum_congr rfl
      intro n hn
      by_cases hd : s ∣ n
      · rw [Int.mul_ediv_cancel' hd]
        by_cases hf : F n = 0
        · simp only [hf, ite_self]
        · exact (if_pos ⟨hd, mem_filter.mpr ⟨hW n hn hd hf,
            by simpa only [Int.mul_ediv_cancel' hd] using hn⟩⟩).symm
      · rw [if_neg (fun h => hd h.1), hzero n hn hd]
    _ = ∑ w ∈ A, F (s * w) := hp
    _ = _ := by rw [sum_filter]

end Bounty
end

section

/- Positive absolute endpoints on the nonzero support of the original root test. -/

namespace Bounty

theorem invariant_triple_endpoint_zero (P : Finset ℕ) (α β γ : ℕ → ℂ) :
    invariantTripleEndpoint P α β γ 0 = 0 := by
  simp only [invariantTripleEndpoint, primePoolFreePart, Nat.zero_div,
    endpointTripleConvolution, Nat.divisors_zero, Finset.sum_empty]

theorem physical_root_test_positive_endpoints
    (F : ℤ → ℂ) (f g : ℤ → ℂ) (hg : g 0 = 0) (w d : ℤ)
    (h : F w * (w : ℂ)⁻¹ * (starRingEnd ℂ) (f w) * g (w + d) ≠ 0) :
    0 < w.natAbs ∧ 0 < (w + d).natAbs := by
  constructor
  · apply Int.natAbs_pos.mpr
    intro hw
    apply h
    simp only [hw, Int.cast_zero, inv_zero, mul_zero, zero_mul]
  · apply Int.natAbs_pos.mpr
    intro hz
    apply h
    rw [hz, hg, mul_zero]

end Bounty
end

section

/- The positive-integer extension of the actual invariant triple endpoint. -/

open Finset
namespace Bounty

noncomputable def positiveInvariantEndpoint (P : Finset ℕ)
    (α β γ : ℕ → ℂ) (n : ℤ) : ℂ :=
  if 0 < n then invariantTripleEndpoint P α β γ n.natAbs else 0

theorem positive_invariant_endpoint_nonzero (P : Finset ℕ) (α β γ : ℕ → ℂ)
    {n : ℤ} (hn : positiveInvariantEndpoint P α β γ n ≠ 0) : 0 < n := by
  by_contra h
  exact hn (if_neg h)

theorem positive_invariant_endpoint_of_pos (P : Finset ℕ) (α β γ : ℕ → ℂ)
    {n : ℤ} (hn : 0 < n) :
    positiveInvariantEndpoint P α β γ n = invariantTripleEndpoint P α β γ n.toNat := by
  rw [positiveInvariantEndpoint, if_pos hn]
  congr 1
  omega

theorem positive_invariant_endpoint_shared_scale
    {G : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (hprime : ∀ g p, p ∈ P g → p.Prime)
    (α β γ : ℕ → ℂ) (L : PhysicalMarkLists P J ell) (w : ℤ) :
    positiveInvariantEndpoint (univ.biUnion P) α β γ
      ((physicalSharedFactor C L : ℤ) * w) =
    positiveInvariantEndpoint (univ.biUnion P) α β γ w := by
  have hs : 0 < (physicalSharedFactor C L : ℤ) := by
    exact_mod_cast physical_shared_factor_pos C L hprime
  simp only [positiveInvariantEndpoint, mul_pos_iff_of_pos_left hs,
    physical_invariant_endpoint_shared_scale C hprime α β γ L w]

end Bounty
end

section

/- Positive shifted integer supports transport injectively to natural indices. -/

open Finset
namespace Bounty

theorem sum_shift_natAbs (S : Finset ℤ) (δ : ℤ) (F : ℕ → ℝ)
    (hpos : ∀ n ∈ S, 0 ≤ n + δ) :
    (∑ n ∈ S, F (n + δ).natAbs) =
      ∑ m ∈ S.image (fun n => (n + δ).natAbs), F m := by
  rw [sum_image]
  intro a ha b hb hab
  have he := congrArg (fun m : ℕ => (m : ℤ)) hab
  rw [Int.natAbs_of_nonneg (hpos a ha), Int.natAbs_of_nonneg (hpos b hb)] at he
  exact add_right_cancel he

theorem shifted_natAbs_image_bounds (S : Finset ℤ) (δ : ℤ) (N : ℕ)
    (hpos : ∀ n ∈ S, 0 < n + δ ∧ n + δ ≤ (N : ℤ)) :
    ∀ m ∈ S.image (fun n => (n + δ).natAbs), 0 < m ∧ m ≤ N := by
  intro m hm
  obtain ⟨n, hn, rfl⟩ := mem_image.mp hm
  have he : ((n + δ).natAbs : ℤ) = n + δ := Int.natAbs_of_nonneg (hpos n hn).1.le
  constructor
  · exact_mod_cast (show (0 : ℤ) < ((n + δ).natAbs : ℤ) by rw [he]; exact (hpos n hn).1)
  · exact_mod_cast (show ((n + δ).natAbs : ℤ) ≤ N by rw [he]; exact (hpos n hn).2)

end Bounty
end

section

/- The original four-step schedule has one offset increment and two
permutation normalizers per edge. -/

open Finset
namespace Bounty

def fourStepVertex (n : ℕ) (i : Fin (4 * n + 2)) : Fin (n + 1) :=
  ⟨(i.val + 1) / 4, by have := i.isLt; omega⟩

theorem four_step_vertex_zero (n : ℕ) : fourStepVertex n 0 = 0 := by
  apply Fin.ext
  simp only [fourStepVertex, Fin.val_zero, zero_add, Nat.reduceDiv]

theorem four_step_vertex_nonedge (n : ℕ) (i : Fin (4 * n + 1)) (hi : i.val % 4 ≠ 2) :
    fourStepVertex n i.castSucc = fourStepVertex n i.succ := by
  apply Fin.ext
  dsimp only [fourStepVertex, Fin.val_castSucc, Fin.val_succ]
  omega

theorem four_step_vertex_edge_before {n : ℕ} (j : Fin n) :
    fourStepVertex n ⟨4 * j.val + 2, by have := j.isLt; omega⟩ = j.castSucc := by
  apply Fin.ext
  dsimp only [fourStepVertex, Fin.val_castSucc]
  omega

theorem four_step_vertex_edge_after {n : ℕ} (j : Fin n) :
    fourStepVertex n ⟨4 * j.val + 3, by have := j.isLt; omega⟩ = j.succ := by
  apply Fin.ext
  dsimp only [fourStepVertex, Fin.val_succ]
  omega

theorem four_step_block_product (n : ℕ) (f : Fin (4 * n + 1) → ℂ) :
    (∏ i, f i) =
      (∏ j : Fin n, ∏ t : Fin 4, f ⟨4 * j.val + t.val, by have := j.isLt; have := t.isLt; omega⟩) *
        f (Fin.last (4 * n)) := by
  rw [Fin.prod_univ_castSucc]
  congr 1
  rw [← Fintype.prod_prod_type (fun jt : Fin n × Fin 4 =>
    f ⟨4 * jt.1.val + jt.2.val, by have := jt.1.isLt; have := jt.2.isLt; omega⟩)]
  symm
  apply prod_bij (fun (jt : Fin n × Fin 4) _ =>
    (⟨4 * jt.1.val + jt.2.val, by have := jt.1.isLt; have := jt.2.isLt; omega⟩ : Fin (4 * n)))
  · intros; exact mem_univ _
  · intro a _ b _ hab
    have hv := congrArg Fin.val hab
    have ha := a.2.isLt
    have hb := b.2.isLt
    apply Prod.ext <;> apply Fin.ext <;> dsimp only at hv ⊢ <;> omega
  · intro i _
    refine ⟨(⟨i.val / 4, by have := i.isLt; omega⟩, ⟨i.val % 4, by omega⟩), mem_univ _, ?_⟩
    apply Fin.ext
    dsimp only
    omega
  · intros; rfl

theorem four_step_normalized_product (n : ℕ) (c : ℂ) (f : Fin (4 * n + 1) → ℂ)
    (hvisit : ∀ j : Fin (n + 1), f ⟨4 * j.val, by have := j.isLt; omega⟩ = 1)
    (hleft : ∀ j : Fin n, f ⟨4 * j.val + 1, by have := j.isLt; omega⟩ = c)
    (hright : ∀ j : Fin n, f ⟨4 * j.val + 3, by have := j.isLt; omega⟩ = c) :
    (∏ i, f i) = ∏ j : Fin n, c * c * f ⟨4 * j.val + 2, by have := j.isLt; omega⟩ := by
  rw [four_step_block_product]
  have hlast : f (Fin.last (4 * n)) = 1 := hvisit (Fin.last n)
  rw [hlast, mul_one]
  apply prod_congr rfl
  intro j _
  rw [Fin.prod_univ_four]
  change f ⟨4 * j.val + 0, _⟩ * f ⟨4 * j.val + 1, _⟩ *
    f ⟨4 * j.val + 2, _⟩ * f ⟨4 * j.val + 3, _⟩ = _
  have hzero : f ⟨4 * j.val + 0, by have := j.isLt; omega⟩ = 1 := hvisit j.castSucc
  rw [hzero, hleft, hright]
  ring

end Bounty
end

section

/- Exact auxiliary shift averages reduce to the first endpoint's major
energy once the actual multiplier has been bounded on minor arcs. -/

open Finset MeasureTheory
open scoped Classical ComplexConjugate
namespace Bounty

theorem physical_aux_fourier_continuous
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (k : ℤ)
    (bA : (∀ i : A, P i.val.1) → ℂ) (bB : (∀ i : B, P i.val.1) → ℂ) :
    Continuous (physicalAuxFourierMultiplier P V A B hU hAB k bA bB) := by
  unfold physicalAuxFourierMultiplier
  apply continuous_finsetSum
  intro aux _
  exact continuous_const.mul (continuous_fourier_real _)

theorem physical_aux_shift_major_energy
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (k : ℤ)
    (bA : (∀ i : A, P i.val.1) → ℂ) (bB : (∀ i : B, P i.val.1) → ℂ)
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (hA : ∀ a, ‖bA a‖ ≤ 1) (hB : ∀ b, ‖bB b‖ ≤ 1)
    (S T : Finset ℤ) (f g : ℤ → ℂ)
    (M : Set ℝ) (hM : MeasurableSet M) {ε : ℝ} (hε : 0 ≤ ε)
    (hminor : ∀ θ, θ ∉ M →
      ‖physicalAuxFourierMultiplier P V A B hU hAB k bA bB θ‖ ≤ ε) :
    ‖∑ aux : PhysicalAuxLabels P (repeatedBigAuxCut A B),
      (physicalAuxMass V (repeatedBigAuxCut A B) aux : ℂ) *
        bA (repeatedBigAuxSplitEquiv P A B hU hAB aux).1 *
        bB (repeatedBigAuxSplitEquiv P A B hU hAB aux).2 *
        ∑ n ∈ S, let δ : ℤ := k * (∏ g, ∏ j : repeatedBigAuxCut A B g, (aux g j).val : ℕ)
          if n+δ ∈ T then conj (f n)*g (n+δ) else 0‖ ≤
      Real.sqrt (ε^2*(∑ n ∈ S, ‖f n‖^2) +
        ∫ x in M ∩ Set.Ioc 0 1, ‖finiteFourierSum S f x‖^2) *
      Real.sqrt (∑ n ∈ T, ‖g n‖^2) := by
  rw [physical_aux_averaged_shift_fourier]
  exact finite_fourier_major_energy S T f g _
    (physical_aux_fourier_continuous P V A B hU hAB k bA bB) M hM hε
    (physical_aux_fourier_norm P V A B hU hAB k bA bB hV hMass hA hB) hminor

end Bounty
end

section

/- Relabeling full-event edge keys preserves the actual dependent path and
every pulled-back deterministic phase. -/

namespace Bounty
section Keys
variable {I K J G : Type*} {P : G → Type*}
  (n : ∀ g, P g → ℕ) {M : G → ℕ}
  (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → G → ℤ) (f : I → K)

def fullPermutationKeyEventEquiv
    (tag : Option (J ⊕ I))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    FullPermutationMixedEvent n (fun i => S (f i)) B (fun i => A (f i))
      (fun i => Δ (f i)) (fun i => D (f i)) tag x ≃
    FullPermutationMixedEvent n S B A Δ D (tag.map (Sum.map id f)) x :=
  match tag with
  | none => Equiv.refl _
  | some (.inl _) => Equiv.refl _
  | some (.inr _) => Equiv.refl _

theorem full_permutation_key_target
    (tag : Option (J ⊕ I))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n (fun i => S (f i)) B (fun i => A (f i))
      (fun i => Δ (f i)) (fun i => D (f i)) tag x) :
    fullPermutationMixedEventTarget n S B A Δ D (tag.map (Sum.map id f)) x
        (fullPermutationKeyEventEquiv n S B A Δ D f tag x e) =
      fullPermutationMixedEventTarget n (fun i => S (f i)) B (fun i => A (f i))
        (fun i => Δ (f i)) (fun i => D (f i)) tag x e := by
  cases tag with
  | none => rfl
  | some tag => cases tag <;> rfl

noncomputable def fullPermutationKeyPathEquiv (steps : List (Option (J ⊕ I)))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    FullPermutationMixedPath n (fun i => S (f i)) B (fun i => A (f i))
      (fun i => Δ (f i)) (fun i => D (f i)) steps x ≃
    FullPermutationMixedPath n S B A Δ D (steps.map (Option.map (Sum.map id f))) x :=
  (finiteEventPathEquiv _ _ _ _ id
    (fullPermutationKeyEventEquiv n S B A Δ D f)
    (fun tag x e => (full_permutation_key_target n S B A Δ D f tag x e).symm) steps x).trans
      (finiteEventPathMapEquiv (FullPermutationMixedEvent n S B A Δ D)
        (fullPermutationMixedEventTarget n S B A Δ D) (Option.map (Sum.map id f)) steps x)

theorem full_permutation_key_ledger_phase
    {L : Type*}
    (update : ∀ tag, L → (x : ProductBoundedOrderedState P
      (fun g => UnrestrictedResidueParticle (n g)) M B) → FullPermutationMixedEvent n S B A Δ D tag x → L)
    (phase : ∀ tag, L → (x : ProductBoundedOrderedState P
      (fun g => UnrestrictedResidueParticle (n g)) M B) → FullPermutationMixedEvent n S B A Δ D tag x → ℂ)
    (steps : List (Option (J ⊕ I))) (l : L)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n (fun i => S (f i)) B (fun i => A (f i))
      (fun i => Δ (f i)) (fun i => D (f i)) steps x) :
    deterministicLedgerPhase (FullPermutationMixedEvent n S B A Δ D)
        (fullPermutationMixedEventTarget n S B A Δ D) update phase
        (steps.map (Option.map (Sum.map id f))) l x
        (fullPermutationKeyPathEquiv n S B A Δ D f steps x p) =
      deterministicLedgerPhase
        (FullPermutationMixedEvent n (fun i => S (f i)) B (fun i => A (f i))
          (fun i => Δ (f i)) (fun i => D (f i)))
        (fullPermutationMixedEventTarget n (fun i => S (f i)) B (fun i => A (f i))
          (fun i => Δ (f i)) (fun i => D (f i)))
        (fun tag l x e => update (tag.map (Sum.map id f)) l x
          (fullPermutationKeyEventEquiv n S B A Δ D f tag x e))
        (fun tag l x e => phase (tag.map (Sum.map id f)) l x
          (fullPermutationKeyEventEquiv n S B A Δ D f tag x e)) steps l x p := by
  unfold fullPermutationKeyPathEquiv
  erw [Equiv.trans_apply]
  rw [← deterministic_ledger_phase_map]
  exact deterministic_ledger_phase_equiv _ _ _ _ id _ _ _ _ (by intros; rfl)
    _ _ (by intros; rfl) steps l x p

end Keys
end Bounty
end

