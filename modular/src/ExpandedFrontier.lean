open Finset
open scoped Classical InnerProductSpace

theorem finite_measure_vector_norm_energy {X : Type*} [Fintype X]
    (w : X → ℝ) (hw : ∀ x, 0 ≤ w x) (f : X → ℂ) :
    ‖finiteMeasureVector w f‖ = Real.sqrt (finiteWeightedEnergy w f) := by
  unfold finiteWeightedEnergy
  rw [← finite_measure_vector_norm_sq w hw, Real.sqrt_sq (norm_nonneg _)]

theorem finite_unit_multiplier_energy_le {X : Type*} [Fintype X]
    (w : X → ℝ) (hw : ∀ x, 0 ≤ w x) (k : X → ℂ) (hk : ∀ x, ‖k x‖ ≤ 1)
    (f : X → ℂ) :
    finiteWeightedEnergy w (fun x => f x * k x) ≤ finiteWeightedEnergy w f := by
  apply sum_le_sum
  intro x _
  apply mul_le_mul_of_nonneg_left _ (hw x)
  rw [norm_mul, mul_pow]
  have h : ‖k x‖ ^ 2 ≤ 1 := by nlinarith [norm_nonneg (k x), hk x]
  simpa only [mul_one] using mul_le_mul_of_nonneg_left h (sq_nonneg ‖f x‖)

theorem clean_raw_pairing_norm_le {X : Type*} [Fintype X]
    (w : X → ℝ) (hw : ∀ x, 0 ≤ w x) (k : X → ℂ) (hk : ∀ x, ‖k x‖ ≤ 1)
    (f g : X → ℂ) :
    ‖cleanRawPairing w k f g‖ ≤
      Real.sqrt (finiteWeightedEnergy w f) * Real.sqrt (finiteWeightedEnergy w g) := by
  have he : cleanRawPairing w k f g =
      inner ℂ (finiteMeasureVector w f) (finiteMeasureVector w (fun x => g x * k x)) := by
    rw [finite_measure_vector_inner w hw]
    unfold cleanRawPairing
    apply sum_congr rfl
    intro x _
    ring
  rw [he]
  calc
    _ ≤ ‖finiteMeasureVector w f‖ * ‖finiteMeasureVector w (fun x => g x * k x)‖ :=
      norm_inner_le_norm _ _
    _ = Real.sqrt (finiteWeightedEnergy w f) *
        Real.sqrt (finiteWeightedEnergy w (fun x => g x * k x)) := by
      rw [finite_measure_vector_norm_energy w hw, finite_measure_vector_norm_energy w hw]
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (Real.sqrt_le_sqrt (finite_unit_multiplier_energy_le w hw k hk g)) (Real.sqrt_nonneg _)
end

section
open Finset
theorem character_conductor_pair_injective (d : ℕ) :
    Function.Injective (fun χ : DirichletCharacter ℂ d =>
      (⟨χ.conductor, χ.primitiveCharacter⟩ : (f : ℕ) × DirichletCharacter ℂ f)) := by
  intro χ ψ h
  have hh := congrArg (fun t : (f : ℕ) × DirichletCharacter ℂ f =>
    if ht : t.1 ∣ d then DirichletCharacter.changeLevel ht t.2 else 1) h
  simpa only [dif_pos χ.conductor_dvd_level, dif_pos ψ.conductor_dvd_level,
    DirichletCharacter.changeLevel_primitiveCharacter] using hh

noncomputable def typeIPrimitiveConductorNormSum {Ω : Type*} (d : ℕ)
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) : ℝ := by
  classical
  exact ∑ f ∈ d.divisors.filter (fun f => 1 < f),
    ∑ ψ ∈ (univ : Finset (DirichletCharacter ℂ f)).filter
      (fun ψ => ψ.IsPrimitive ∧ ψ ≠ 1),
      ‖∑ t ∈ T.filter (fun t => (value t).Coprime (d / f)),
        μ t * ψ (value t : ZMod f)‖

theorem character_conductor_norm_sum_le {Ω : Type*} (d : ℕ) [NeZero d]
    (C : Finset (DirichletCharacter ℂ d)) (hC : ∀ χ ∈ C, χ ≠ 1)
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) :
    (∑ χ ∈ C, ‖typeICharacterSum T μ value χ‖) ≤
      typeIPrimitiveConductorNormSum d T μ value := by
  classical
  let pair := fun χ : DirichletCharacter ℂ d =>
    (⟨χ.conductor, χ.primitiveCharacter⟩ : (f : ℕ) × DirichletCharacter ℂ f)
  let D : Finset ((f : ℕ) × DirichletCharacter ℂ f) :=
    (d.divisors.filter (fun f => 1 < f)).sigma (fun f =>
      (univ : Finset (DirichletCharacter ℂ f)).filter (fun ψ => ψ.IsPrimitive ∧ ψ ≠ 1))
  let w : ((f : ℕ) × DirichletCharacter ℂ f) → ℝ := fun x =>
    ‖∑ t ∈ T.filter (fun t => (value t).Coprime (d / x.1)),
      μ t * x.2 (value t : ZMod x.1)‖
  have hinj : Set.InjOn pair C := (character_conductor_pair_injective d).injOn
  have hsub : C.image pair ⊆ D := by
    intro x hx
    obtain ⟨χ, hχ, rfl⟩ := mem_image.mp hx
    apply mem_sigma.mpr
    constructor
    · exact mem_filter.mpr ⟨Nat.mem_divisors.mpr ⟨χ.conductor_dvd_level, NeZero.ne d⟩,
        nonprincipal_conductor_one_lt χ (hC χ hχ)⟩
    · exact mem_filter.mpr ⟨mem_univ _, χ.primitiveCharacter_isPrimitive,
        nonprincipal_primitiveCharacter_ne_one χ (hC χ hχ)⟩
  calc
    _ = ∑ x ∈ C.image pair, w x := by
      rw [sum_image hinj]
      apply sum_congr rfl
      intro χ _
      change ‖∑ t ∈ T, μ t * χ (value t : ZMod d)‖ = _
      rw [character_weighted_sum_eq_primitive_filtered]
    _ ≤ ∑ x ∈ D, w x :=
      sum_le_sum_of_subset_of_nonneg hsub (fun x _ _ => norm_nonneg _)
    _ = typeIPrimitiveConductorNormSum d T μ value := by
      rw [show D = (d.divisors.filter (fun f => 1 < f)).sigma (fun f =>
        (univ : Finset (DirichletCharacter ℂ f)).filter (fun ψ => ψ.IsPrimitive ∧ ψ ≠ 1)) from rfl,
        sum_sigma]
      rfl

theorem typeI_nonprincipal_norm_sum_le_conductors {Ω : Type*} (d : ℕ) [NeZero d]
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) :
    typeINonprincipalNormSum d T μ value ≤ typeIPrimitiveConductorNormSum d T μ value := by
  classical
  unfold typeINonprincipalNormSum
  apply character_conductor_norm_sum_le
  intro χ hχ
  simpa only [mem_erase, mem_univ, and_true] using hχ

theorem typeI_real_deviation_le_conductors {Ω : Type*} (d : ℕ) [NeZero d] (hd : Odd d)
    (T : Finset Ω) (μ : Ω → ℝ) (value : Ω → ℕ) :
    |(∑ t ∈ T.filter (fun t => d ∣ 2 * value t + 1), μ t) -
        (∑ t ∈ T.filter (fun t => (value t).Coprime d), μ t) / (d.totient : ℝ)| ≤
      typeIPrimitiveConductorNormSum d T (fun t => (μ t : ℂ)) value / (d.totient : ℝ) := by
  exact (typeI_real_deviation_le d hd T μ value).trans
    (div_le_div_of_nonneg_right (typeI_nonprincipal_norm_sum_le_conductors d T
      (fun t => (μ t : ℂ)) value) (Nat.cast_nonneg _))
end

section
open Finset
theorem fixed_prime_shifted_intersection_moment (T S : Finset ℕ) (μ : ℕ → ℝ)
    {p : ℕ} (hp : p.Prime) (hpS : p ∉ S) (hS : ∀ q ∈ S, q.Prime) :
    (∑ u ∈ (T.filter (fun u => p ∣ 2*u + 1)).filter
      (fun u => ∀ q ∈ S, q ∣ 2*u + 1), μ u) =
      ((∑ u ∈ T, μ u) / ((p : ℝ) - 1)) * (∏ q ∈ S, 1 / ((q : ℝ) - 1)) +
        shiftedTotientSieveRemainder T μ (p * ∏ q ∈ S, q) := by
  have hfilter : (T.filter (fun u => p ∣ 2*u + 1)).filter
      (fun u => ∀ q ∈ S, q ∣ 2*u + 1) =
      T.filter (fun u => ∀ q ∈ insert p S, q ∣ 2*u + 1) := by
    ext u
    simp only [mem_filter, mem_insert, forall_eq_or_imp]
    tauto
  rw [hfilter]
  have hpr : ∀ q ∈ insert p S, q.Prime := by
    intro q hq
    rcases mem_insert.mp hq with rfl | hq
    · exact hp
    · exact hS q hq
  have hm := shifted_totient_intersection_moment T (insert p S) μ hpr
  rw [prod_insert hpS, prod_insert hpS] at hm
  convert hm using 1
  ring

theorem exists_fixed_prime_shifted_sieve :
    ∃ K : ℝ, 0 < K ∧ ∀ (P T : Finset ℕ) (μ : ℕ → ℝ) (p : ℕ)
      {z : ℝ} {h : ℕ},
      1 < z → 1 ≤ h → Even h → p.Prime → p ∉ P →
      (∀ q ∈ P, q.Prime) → (∀ q ∈ P, q ≠ 2) →
      (∀ q ∈ P, (q : ℝ) ≤ z) → (∀ u ∈ T, 0 ≤ μ u) →
      |(∑ u ∈ T.filter (fun u => p ∣ 2*u + 1 ∧ ∀ q ∈ P, ¬q ∣ 2*u + 1), μ u) -
          ((∑ u ∈ T, μ u) / ((p : ℝ) - 1)) *
            (∏ q ∈ P, (1 - 1 / ((q : ℝ) - 1)))| ≤
        ((∑ u ∈ T, μ u) / ((p : ℝ) - 1)) *
          (∏ q ∈ P, (1 - 1 / ((q : ℝ) - 1))) * K * Real.exp (-(h : ℝ)) +
          ∑ d ∈ blockSieveModuli P (z^(4 * (h : ℝ) + 2)),
            |shiftedTotientSieveRemainder T μ (p*d)| := by
  obtain ⟨K, hK, hsieve⟩ := exists_odd_prime_reciprocal_sieve_events
  refine ⟨K, hK, ?_⟩
  intro P T μ p z h hz hh heven hp hpP hP hodd hPz hμ
  have hden : 0 < (p : ℝ) - 1 := by
    have hp1 : (1 : ℝ) < p := by exact_mod_cast hp.one_lt
    linarith
  have hm : ∀ S ∈ P.powerset,
      (∑ u ∈ (T.filter (fun u => p ∣ 2*u + 1)).filter
        (fun u => ∀ q ∈ S, q ∣ 2*u + 1), μ u) =
        ((∑ u ∈ T, μ u) / ((p : ℝ) - 1)) * (∏ q ∈ S, 1 / ((q : ℝ) - 1)) +
          shiftedTotientSieveRemainder T μ (p * ∏ q ∈ S, q) := by
    intro S hS
    have hSP := mem_powerset.mp hS
    exact fixed_prime_shifted_intersection_moment T S μ hp (fun hpS => hpP (hSP hpS))
      (fun q hq => hP q (hSP hq))
  have hb := hsieve P (T.filter (fun u => p ∣ 2*u + 1)) μ
    (fun u q => q ∣ 2*u + 1) (fun d => shiftedTotientSieveRemainder T μ (p*d))
    hz (div_nonneg (sum_nonneg hμ) hden.le) hh heven hP hodd hPz
    (fun u hu => hμ u (mem_filter.mp hu).1) hm
  simpa only [filter_filter] using hb
end

