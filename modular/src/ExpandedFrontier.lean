noncomputable def candidateB0HarmonicCorrelation (c L q : ℝ) (r jStar : ℕ)
    (P : Finset ℕ) (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (ν Z : ℝ) (k : ℤ)
