open Finset Classical
section

variable {G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  (Δ D : G → ℤ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (t : G → ℕ) (B : ℕ)

noncomputable def unrestrictedProductOperator
    (phase : ∀ g, UnrestrictedBoundedPhase (n g) (Δ g) (D g) (t g) B)
    (groups : Finset G)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ) :=
  finiteCoordinateFinsetAction
    (fun g => unrestrictedBoundedOperator (n g) (Δ g) (D g) (μ g) ρ (V g) (t g) B (phase g))
    groups f

noncomputable def unrestrictedProjectedProductOperator
    (phase : ∀ g, UnrestrictedBoundedPhase (n g) (Δ g) (D g) (t g) B)
    (groups : Finset G)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ) :=
  finiteCoordinateFinsetAction
    (fun g => unrestrictedProjectedOperator (n g) (Δ g) (D g) (μ g) ρ (V g) (t g) B (phase g))
    groups f

noncomputable def unrestrictedCutoffProductOperator
    (phase : ∀ g, UnrestrictedBoundedPhase (n g) (Δ g) (D g) (t g) B)
    (groups : Finset G)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ) :=
  productMemoryCutoff
    (unrestrictedProductOperator n Δ D μ ρ V t B phase groups (productMemoryCutoff f))

omit [Fintype G] in
theorem unrestricted_projected_product_eq_of_symmetric
    (phase : ∀ g, UnrestrictedBoundedPhase (n g) (Δ g) (D g) (t g) B)
    (groups : Finset G)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    unrestrictedProjectedProductOperator n Δ D μ ρ V t B phase groups f =
      unrestrictedProductOperator n Δ D μ ρ V t B phase groups f := by
  exact product_memory_projected_finset_eq
    (fun g => unrestrictedBoundedOperator (n g) (Δ g) (D g) (μ g) ρ (V g) (t g) B (phase g))
    groups f hf

theorem unrestricted_projected_product_energy_le
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, t g ≤ T)
    (phase : ∀ g, UnrestrictedBoundedPhase (n g) (Δ g) (D g) (t g) B)
    (hphase : ∀ g s stores promotions e fresh, ‖phase g s stores promotions e fresh‖ ≤ 1)
    (groups : Finset G)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (unrestrictedProjectedProductOperator n Δ D μ ρ V t B phase groups f) ≤
    unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ groups.card *
      finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  have h := finite_coordinate_finset_energy_le
    (fun g => boundedOrderedStateWeight (μ g) (unrestrictedResidueWeight (μ g)))
    (fun g s => boundedOrderedStateWeight_nonneg (μ g) (unrestrictedResidueWeight (μ g))
      (hμ g) (fun z => hμ g z.1) s)
    (fun g => unrestrictedProjectedOperator (n g) (Δ g) (D g) (μ g) ρ (V g) (t g) B (phase g))
    (fun _ => unrestrictedEdgeEnergyBound ρ v vmin vmax T)
    (fun _ => unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T)
    (fun g f => unrestricted_projected_operator_energy_le (n g) (Δ g) (D g) (μ g)
      hρ0 hρ1 hv hvmin (hVlo g) (hVhi g) (hμ g) (hmass g) (t g) B T (ht g)
      (phase g) (hphase g) f) groups f
  simpa only [prod_const, finiteWeightedEnergy, finiteProductWeight, productMemoryWeight,
    unrestrictedProjectedProductOperator] using h

theorem unrestricted_product_energy_le
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, t g ≤ T)
    (phase : ∀ g, UnrestrictedBoundedPhase (n g) (Δ g) (D g) (t g) B)
    (hphase : ∀ g s stores promotions e fresh, ‖phase g s stores promotions e fresh‖ ≤ 1)
    (groups : Finset G)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (unrestrictedProductOperator n Δ D μ ρ V t B phase groups f) ≤
    unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ groups.card *
      finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  rw [← unrestricted_projected_product_eq_of_symmetric n Δ D μ ρ V t B phase groups f hf]
  exact unrestricted_projected_product_energy_le n Δ D μ ρ V t B hρ0 hρ1 hv hvmin hVlo hVhi
    hμ hmass T ht phase hphase groups f

theorem unrestricted_cutoff_product_energy_le
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, t g ≤ T)
    (phase : ∀ g, UnrestrictedBoundedPhase (n g) (Δ g) (D g) (t g) B)
    (hphase : ∀ g s stores promotions e fresh, ‖phase g s stores promotions e fresh‖ ≤ 1)
    (groups : Finset G)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (unrestrictedCutoffProductOperator n Δ D μ ρ V t B phase groups f) ≤
    unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ groups.card *
      finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  calc
    _ ≤ finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
        (unrestrictedProductOperator n Δ D μ ρ V t B phase groups (productMemoryCutoff f)) :=
      productMemoryCutoff_energy_le μ (fun g => unrestrictedResidueWeight (μ g))
        hμ (fun g z => hμ g z.1) _
    _ ≤ unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ groups.card *
        finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
          (productMemoryCutoff f) :=
      unrestricted_product_energy_le n Δ D μ ρ V t B hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass
        T ht phase hphase groups _ (productMemoryCutoff_symmetric f hf)
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (productMemoryCutoff_energy_le μ (fun g => unrestrictedResidueWeight (μ g))
        hμ (fun g z => hμ g z.1) f)
      (pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _)

end
end

