open Finset
open scoped Classical
section Joint
variable {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
  [∀ g, DecidableEq (P g)] {R : (g : Fin N) → P g → Type*}
  [∀ g p, AddGroup (R g p)]
  [∀ g p, DecidableEq (R g p)]
  (a : ℕ → (g : Fin N) → P g → Bool)
  (steps : (i : ℕ) → (g : Fin N) → GlobalBirthRawStep (R := R g) (a i g) (a (i + 1) g))
  (cap : ℕ → ℕ)

abbrev GlobalBirthJointMemoryEventPath (n : ℕ) (q : GlobalBirthJointMemory R) :=
  FiniteEventPath (fun i => GlobalBirthJointAmbientEvent (steps i))
    (fun i => globalBirthJointMemoryTarget (steps i)) (List.range n) q

noncomputable def globalBirthJointMemoryPathAllowed (n : ℕ) (H : GlobalBirthJointLedger P)
    (q : GlobalBirthJointMemory R) (p : GlobalBirthJointMemoryEventPath a steps n q) : Prop :=
  finiteEventPathAllowed (fun i s => GlobalBirthJointAmbientEvent (steps i) s.2)
    (finiteLedgerEventTarget (fun i => GlobalBirthJointAmbientEvent (steps i))
      (fun i => globalBirthJointMemoryTarget (steps i))
      (fun i => globalBirthJointLedgerUpdate (steps i)))
    (fun i => globalBirthJointLedgerEventAllowed (steps i) (cap i) (cap (i + 1)))
    (List.range n) (H, q)
    ((finiteLedgerEventPathEquiv (fun i => GlobalBirthJointAmbientEvent (steps i))
      (fun i => globalBirthJointMemoryTarget (steps i))
      (fun i => globalBirthJointLedgerUpdate (steps i)) (List.range n) H q).symm p)

theorem global_birth_joint_raw_history_memory_paths (n : ℕ)
    (F : GlobalBirthJointMemory R → ℂ) (H : GlobalBirthJointLedger P)
    (q : GlobalBirthJointMemory R) :
    let _ : ∀ i q, Fintype (GlobalBirthJointAmbientEvent (steps i) q) :=
      fun i q => globalBirthJointAmbientEventFintype (steps i) q
    globalBirthJointRawHistory a steps cap n (fun s => F (fun g => (s g).2))
      (fun g => (H g, q g)) =
      finiteEventPathAction (fun i => GlobalBirthJointAmbientEvent (steps i))
        (fun i => globalBirthJointMemoryTarget (steps i))
        (fun i => globalBirthJointCappedEventWeight (steps i) (cap i) (cap (i + 1))) (List.range n)
        (fun q p => if globalBirthJointMemoryPathAllowed a steps cap n H q p then 1 else 0) F q := by
  let _ : ∀ i q, Fintype (GlobalBirthJointAmbientEvent (steps i) q) :=
    fun i q => globalBirthJointAmbientEventFintype (steps i) q
  let E := fun i => GlobalBirthJointAmbientEvent (steps i)
  let target := fun i => globalBirthJointMemoryTarget (steps i)
  let update := fun i => globalBirthJointLedgerUpdate (steps i)
  let allowed := fun i => globalBirthJointLedgerEventAllowed (steps i) (cap i) (cap (i + 1))
  let weight := fun i => globalBirthJointCappedEventWeight (steps i) (cap i) (cap (i + 1))
  let row := finiteLocalEventAction (fun i s => E i s.2)
    (fun i s e => if allowed i s e then weight i s.2 e else 0)
    (finiteLedgerEventTarget E target update)
  have hr : ∀ i (G : GlobalBirthJointLedger P × GlobalBirthJointMemory R → ℂ),
      globalBirthJointCutRawRow (steps i) (cap i) (cap (i + 1))
        (G ∘ globalBirthJointStateEquiv) = row i G ∘ globalBirthJointStateEquiv := by
    intro i G
    funext s
    exact global_birth_joint_cut_row_capped_ledger_events (steps i) (cap i) (cap (i + 1)) G s
  have he : globalBirthJointRawHistory a steps cap n (fun s => F (fun g => (s g).2))
      (fun g => (H g, q g)) =
      finiteEventPathAction (fun i s => E i s.2)
        (finiteLedgerEventTarget E target update)
        (fun i s e => if allowed i s e then weight i s.2 e else 0)
        (List.range n) (fun _ _ => 1) (fun s => F s.2) (H, q) := by
    have h := finite_row_composition_intertwines_apply
      (fun i => globalBirthJointCutRawRow (steps i) (cap i) (cap (i + 1))) row
      (fun _ => globalBirthJointStateEquiv.toFun) hr n (fun s => F s.2) (fun g => (H g, q g))
    change globalBirthJointRawHistory a steps cap n _ _ =
      finiteRowComposition (S := fun _ => GlobalBirthJointLedger P × GlobalBirthJointMemory R) row n
        (fun s : GlobalBirthJointLedger P × GlobalBirthJointMemory R => F s.2) (H, q) at h
    refine h.trans ?_
    rw [finite_event_path_action_one]
    exact finite_row_composition_eq_event_paths _ _ _ _ _ _
  rw [he, finite_event_path_action_restrict]
  exact finite_ledger_event_path_action_memory E target update weight (List.range n) _ F H q

end Joint
