        ∀ j ∈ dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊),
        let B := shiftedTypeIIBilinear (arithmeticProductWindow 1 (Real.exp L)) (candidateCoefficient c L (1/2) r jStar)
          (typeIIRestrict (dyadicNatBucket (Icc 1 ⌊33*Real.exp L⌋₊) i)
            (ambientRoughIntervalTypeIIAlpha (reciprocalGrid b (1/2-κ) N z) L S
              (reciprocalGrid b (1/2-κ) N z) (reciprocalGrid b (1/2-κ) N ((z : ℕ)+1))))
          (typeIIRestrict (dyadicNatBucket (Icc 1 ⌊33*Real.exp L⌋₊) j)
            (ambientRoughTypeIIBeta (Real.exp (reciprocalGrid b (1/2-κ) N z*L))
              (Real.exp (reciprocalGrid b (1/2-κ) N ((z : ℕ)+1)*L))))
        B ≠ 0 → |B| ≤ Real.exp L * L^(-D) ) ∧
      (∃ J : ℕ, ∀ jStar : ℕ, J<jStar →
        ∃ S₀ : ℝ, 0≤S₀ ∧ ∀ S : ℝ, S₀≤S → ∀ᶠ L : ℝ in atTop,
        ∀ proxy : Bool, ∀ i ∈ dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊),
        ∀ j ∈ dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊),
        let B := shiftedTypeIIBilinear (arithmeticProductWindow 1 (Real.exp L)) (candidateCoefficient c L (1/2) r jStar)
          (typeIIRestrict (dyadicNatBucket (Icc 1 ⌊33*Real.exp L⌋₊) i) (ambientPrimeTypeIIAlpha κ L S))
          (typeIIRestrict (dyadicNatBucket (Icc 1 ⌊33*Real.exp L⌋₊) j)
            (if proxy then ambientProxyTypeIIBeta κ L S else ambientPrimeTypeIIBeta κ L))
        B ≠ 0 → |B| ≤ Real.exp L * L^(-D) )

theorem candidate_half_components_of_active_blocks
    (hB : CandidateHalfActiveBlockBounds) : CandidateHalfFixedSlotComponentBounds := by
  intro c r hc hr hcenter κ b N hκ hκmax hb hbq hN
  obtain ⟨D, hD, Jmass, hmass⟩ := exists_candidate_ambient_error_from_blocks hc
    (by omega : 0<r) (by norm_num : (0 : ℝ) ≤ 1/2) (by norm_num : (1/2 : ℝ) < 1) hcenter
  obtain ⟨hrough, hprime⟩ := hB c r hc hr hcenter D hD κ b N hκ hκmax hb hbq hN
  constructor
  · intro z
    obtain ⟨Jblock, hblock⟩ := hrough z
    refine ⟨max Jmass Jblock, ?_⟩
    intro jStar hj
    have hjmass := (le_max_left Jmass Jblock).trans_lt hj
    have hjblock := (le_max_right Jmass Jblock).trans_lt hj
    obtain ⟨S₀, hS₀, hS⟩ := hblock jStar hjblock
    refine ⟨S₀, hS₀, ?_⟩
    intro S hSge
    filter_upwards [hmass jStar hjmass,hS S hSge] with L hm hblocks
    exact hm.1 _ S _ _ hblocks
  · obtain ⟨Jblock, hblock⟩ := hprime
    refine ⟨max Jmass Jblock, ?_⟩
    intro jStar hj
    have hjmass := (le_max_left Jmass Jblock).trans_lt hj
    have hjblock := (le_max_right Jmass Jblock).trans_lt hj
    obtain ⟨S₀, hS₀, hS⟩ := hblock jStar hjblock
    refine ⟨S₀, hS₀, ?_⟩
    intro S hSge
    filter_upwards [hmass jStar hjmass,hS S hSge] with L hm hblocks
    exact hm.2 κ S hblocks

theorem target_of_candidate_half_active_blocks
    (hZ : PrimitiveZeroFreeHalfPlane) (hB : CandidateHalfActiveBlockBounds) :
    fcTypeOfName% "Erdos1057.erdos_1057" :=
  target_of_candidate_half_fixed_slot_components hZ
    (candidate_half_components_of_active_blocks hB)

