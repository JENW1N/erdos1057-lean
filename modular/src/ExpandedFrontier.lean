  fullPermutationKeyPathEquiv (fun g (p : P g) => p.val)
    (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
    (fun i _ => PhysicalAuxLabels P (C i))
    (fun i => physicalFullEdgeDelta (C i) (k i)) (fun i => physicalFullEdgeD (C i)) f steps x

theorem physical_full_key_coefficient_path
    (steps : List (Option (V ⊕ H))) (x : PhysicalFullBoundedState P J ell B)
    (p : FullPermutationMixedPath (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C (f i) g)) B
      (fun i _ => PhysicalAuxLabels P (C (f i)))
      (fun i => physicalFullEdgeDelta (C (f i)) (k (f i)))
      (fun i => physicalFullEdgeD (C (f i))) steps x) :
    finiteEventLocalPhase
      (FullPermutationMixedEvent (fun g (p : P g) => p.val)
        (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
        (fun i _ => PhysicalAuxLabels P (C i))
        (fun i => physicalFullEdgeDelta (C i) (k i)) (fun i => physicalFullEdgeD (C i)))
      (fullPermutationMixedEventTarget (fun g (p : P g) => p.val)
        (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
        (fun i _ => PhysicalAuxLabels P (C i))
        (fun i => physicalFullEdgeDelta (C i) (k i)) (fun i => physicalFullEdgeD (C i)))
      (physicalFullKeyCoefficientPhase C k ζ K) (steps.map (Option.map (Sum.map id f))) x
      (physicalFullKeyPathEquiv C k f steps x p) =
    finiteEventLocalPhase
      (FullPermutationMixedEvent (fun g (p : P g) => p.val)
        (fun i g => physicalFullSharedIndices (ell := ell) (C (f i) g)) B
        (fun i _ => PhysicalAuxLabels P (C (f i)))
        (fun i => physicalFullEdgeDelta (C (f i)) (k (f i))) (fun i => physicalFullEdgeD (C (f i))))
      (fullPermutationMixedEventTarget (fun g (p : P g) => p.val)
        (fun i g => physicalFullSharedIndices (ell := ell) (C (f i) g)) B
        (fun i _ => PhysicalAuxLabels P (C (f i)))
        (fun i => physicalFullEdgeDelta (C (f i)) (k (f i))) (fun i => physicalFullEdgeD (C (f i))))
      (physicalFullKeyCoefficientPhase (fun i => C (f i)) (fun i => k (f i))
        (fun i => ζ (f i)) (fun i => K (f i))) steps x p := by
  have h := full_permutation_key_local_phase (fun g (p : P g) => p.val)
    (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
    (fun i _ => PhysicalAuxLabels P (C i))
    (fun i => physicalFullEdgeDelta (C i) (k i)) (fun i => physicalFullEdgeD (C i)) f
    (physicalFullKeyCoefficientPhase C k ζ K) steps x p
  have hp : (fun (tag : Option (V ⊕ H)) (x : PhysicalFullBoundedState P J ell B)
      (e : FullPermutationMixedEvent (fun g (p : P g) => p.val)
        (fun i g => physicalFullSharedIndices (ell := ell) (C (f i) g)) B
        (fun i _ => PhysicalAuxLabels P (C (f i)))
        (fun i => physicalFullEdgeDelta (C (f i)) (k (f i))) (fun i => physicalFullEdgeD (C (f i))) tag x) =>
      physicalFullKeyCoefficientPhase C k ζ K (tag.map (Sum.map id f)) x
        (fullPermutationKeyEventEquiv (fun g (p : P g) => p.val)
          (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
          (fun i _ => PhysicalAuxLabels P (C i))
          (fun i => physicalFullEdgeDelta (C i) (k i)) (fun i => physicalFullEdgeD (C i)) f tag x e)) =
      physicalFullKeyCoefficientPhase (fun i => C (f i)) (fun i => k (f i))
        (fun i => ζ (f i)) (fun i => K (f i)) := by
    funext tag x e
    exact physical_full_key_coefficient_transport C k ζ K f tag x e
  erw [hp] at h
  exact h

