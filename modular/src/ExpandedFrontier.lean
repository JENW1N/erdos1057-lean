theorem rational_phase_fintype_interval_row_sum_le {Y : Type*} [Fintype Y]
    (t : Y → ℤ) (hinj : Function.Injective t) (A : ℤ) (V N : ℕ)
    (ht : ∀ y, A ≤ t y ∧ t y ≤ A + (V : ℤ))
    {u : ℤ} {r : ℕ} (hr : 0 < r) (hcop : (r : ℤ).gcd u = 1)
    {β : ℝ} (hβ : |β| ≤ 1 / (r : ℝ) ^ 2) (base : ℝ) :
    (∑ y, circleGeometricBound N (((u : ℝ) / r + β) * t y - base)) ≤
      (1 + 3 * (V : ℝ) / r) *
        (2 * (N : ℝ) + 2 * (r : ℝ) * (1 + Real.log r)) :=
  rational_phase_interval_row_sum_le_of_pos Finset.univ t hinj.injOn A V N
    (fun y _ => ht y) hr hcop hβ base

/-- The arbitrary-width integer interval version of the separated bilinear bound.
All coefficients may be complex; there are no prime or positivity assumptions on them. -/
theorem rational_phase_integer_interval_bilinear_norm_sq_le {Y : Type*} [Fintype Y]
    (t : Y → ℤ) (hinj : Function.Injective t) (A : ℤ) (V : ℕ)
    (ht : ∀ y, A ≤ t y ∧ t y ≤ A + (V : ℤ))
    {u : ℤ} {r : ℕ} (hr : 0 < r) (hcop : (r : ℤ).gcd u = 1)
    {β : ℝ} (hβ : |β| ≤ 1 / (r : ℝ) ^ 2)
    (a N : ℕ) (c : Fin N → ℂ) (b : Y → ℂ) :
    ‖∑ n : Fin N, ∑ y, c n * b y *
      (Complex.exp (Complex.I * (2 * Real.pi *
        (((u : ℝ) / r + β) * t y) : ℝ))) ^ (a + n.val)‖ ^ 2 ≤
      ((1 + 3 * (V : ℝ) / r) *
        (2 * (N : ℝ) + 2 * (r : ℝ) * (1 + Real.log r))) *
          (∑ n : Fin N, ‖c n‖ ^ 2) * ∑ y, ‖b y‖ ^ 2 := by
  apply circle_bilinear_norm_sq_le (fun y => ((u : ℝ) / r + β) * t y) a N c b
  intro y
  exact rational_phase_fintype_interval_row_sum_le t hinj A V N ht hr hcop hβ
    (((u : ℝ) / r + β) * t y)
end

