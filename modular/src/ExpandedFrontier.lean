/- State and completion masses restricted to a chosen group set. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def physicalGroupPathMass {G : Type*} {J : ℕ}
    (V : G → ℝ) (groups : Finset G) (C : ℕ → G → Finset (Fin J)) (ell n : ℕ) : ℝ :=
  ∏ g ∈ groups, (1 / V g) ^ ((J + ell) + ∑ j ∈ range n, (ell + (C j g).card))

theorem physical_group_path_mass_factors {G : Type*} {J : ℕ}
    (V : G → ℝ) (groups : Finset G) (C : ℕ → G → Finset (Fin J)) (ell n : ℕ) :
    physicalGroupPathMass V groups C ell n =
      (∏ g ∈ groups, 1 / (V g) ^ (J + ell)) *
        ∏ j ∈ range n, ∏ g ∈ groups, 1 / (V g) ^ (ell + (C j g).card) := by
  classical
  unfold physicalGroupPathMass
  rw [prod_comm (s := range n) (t := groups), ← prod_mul_distrib]
  apply prod_congr rfl
  intro g hg
  simp only [one_div, ← inv_pow]
  rw [prod_pow_eq_pow_sum, ← pow_add]

theorem physical_group_path_mass_split {G : Type*} [Fintype G] [DecidableEq G] {J : ℕ}
    (V : G → ℝ) (groups : Finset G) (C : ℕ → G → Finset (Fin J)) (ell n : ℕ) :
    physicalStateMass V J ell * (∏ j ∈ range n, physicalCompletionMass V (C j) ell) =
      physicalGroupPathMass V groups C ell n * physicalGroupPathMass V groupsᶜ C ell n := by
  classical
  rw [physical_path_mass_grouped]
  exact (prod_mul_prod_compl groups _).symm

end Bounty
end

