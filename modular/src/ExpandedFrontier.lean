/- Nonnegative weighted enlargement from actual least-prime-factor pairs to ambient tests. -/

open Finset Real

namespace Bounty

theorem weighted_subset_le_test_sum {α : Type*} [DecidableEq α]
    {A B : Finset α} (hAB : A ⊆ B) (w t : α → ℝ)
    (hw : ∀ x ∈ B, 0 ≤ w x) (ht : ∀ x ∈ B, 0 ≤ t x)
    (hAt : ∀ x ∈ A, t x = 1) :
    (∑ x ∈ A, w x) ≤ ∑ x ∈ B, w x*t x := by
  calc
    _ = ∑ x ∈ A, w x*t x := by
      apply sum_congr rfl
      intro x hx
      rw [hAt x hx, mul_one]
    _ ≤ _ := sum_le_sum_of_subset_of_nonneg hAB
      (fun x hx _ => mul_nonneg (hw x hx) (ht x hx))

theorem shifted_buchstab_mesh_bin_rough_test {T : Finset ℕ}
    (hT : ∀ u ∈ T, 0 < u) {b q L : ℝ} {N i : ℕ} {v : ℕ × ℕ}
    (hv : v ∈ shiftedBuchstabMeshBin T b q L N i) :
    exponentialRoughTest (reciprocalGrid b q N i) L v.2 := by
  have hmem := mem_shifted_buchstab_mesh_bin.mp hv
  have hp := shifted_buchstab_pair_properties T (exp (b*L)) hT
    (mem_shifted_buchstab_unbalanced_pairs.mp hmem.1).1
  have hlo := ((mem_primeBand_iff (exp_pos _).le (exp_pos _).le v.1).mp hmem.2).2.1
  intro p hpf
  exact hlo.trans_le (Nat.cast_le.mpr (hp.2.2.2.2.2 p hpf))

theorem shifted_buchstab_mesh_bin_rough_indicator {T : Finset ℕ}
    (hT : ∀ u ∈ T, 0 < u) {b q L : ℝ} {N i : ℕ} {v : ℕ × ℕ}
    (hv : v ∈ shiftedBuchstabMeshBin T b q L N i) :
    roughTestIndicator (reciprocalGrid b q N i) L v.2 = 1 := by
  simp only [roughTestIndicator, if_pos (shifted_buchstab_mesh_bin_rough_test hT hv)]

theorem shifted_buchstab_mesh_bin_le_ambient_rough_test
    {T : Finset ℕ} (hT : ∀ u ∈ T, 0 < u) {b q L : ℝ} {N i : ℕ}
    (A : Finset (ℕ × ℕ)) (μ : ℕ → ℝ)
    (hsub : shiftedBuchstabMeshBin T b q L N i ⊆ A)
    (hμ : ∀ v ∈ A, 0 ≤ μ (shiftedPairIndex v)) :
    (∑ v ∈ shiftedBuchstabMeshBin T b q L N i, μ (shiftedPairIndex v)) ≤
      ∑ v ∈ A, μ (shiftedPairIndex v)*roughTestIndicator (reciprocalGrid b q N i) L v.2 := by
  apply weighted_subset_le_test_sum hsub _ _ hμ
  · intro v hv
    unfold roughTestIndicator
    split <;> norm_num
  · intro v hv
    exact shifted_buchstab_mesh_bin_rough_indicator hT hv

theorem shifted_buchstab_balanced_le_ambient_prime_test
    {T : Finset ℕ} (hT : ∀ u ∈ T, 0 < u) {b q L : ℝ}
    (A : Finset (ℕ × ℕ)) (μ : ℕ → ℝ)
    (hsub : shiftedBuchstabBalancedPairs T b q L ⊆ A)
    (hμ : ∀ v ∈ A, 0 ≤ μ (shiftedPairIndex v))
    (hprime : ∀ v ∈ shiftedBuchstabBalancedPairs T b q L, v.2.Prime) :
    (∑ v ∈ shiftedBuchstabBalancedPairs T b q L, μ (shiftedPairIndex v)) ≤
      ∑ v ∈ A, μ (shiftedPairIndex v)*
        ((if v.1.Prime then 1 else 0)*(if v.2.Prime then 1 else 0)) := by
  apply weighted_subset_le_test_sum hsub _ _ hμ
  · intro v hv
    positivity
  · intro v hv
    have hp := shifted_buchstab_pair_properties T (exp (b*L)) hT
      (mem_shifted_buchstab_balanced_pairs.mp hv).1
    simp only [if_pos hp.1, if_pos (hprime v hv), mul_one]

end Bounty
end

