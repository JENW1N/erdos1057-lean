variable {J K G : Type*} [Fintype G] {P : G → Type*}
  (n : ∀ g, P g → ℕ) {M : G → ℕ}
  (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → G → ℤ)

theorem fullActiveEdgeEventTarget_memory_le (k : K)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullActiveEdgeEvent n (S k) B (A k) (Δ k) (D k) s) :
    productTotalMemory (fullActiveEdgeEventTarget n (S k) B (A k) (Δ k) (D k) s e) ≤
      productTotalMemory s + ∑ g, (S k g)ᶜ.card := by
  rw [fullActiveEdgeEventTarget_total]
  have h := unrestrictedJointEventTarget_memory_le n
    (Δ k (productActiveMemorySplit (S k) B s).1 e.1)
    (D k (productActiveMemorySplit (S k) B s).1 e.1)
    (fun g => (S k g)ᶜ.card) B (productActiveMemorySplit (S k) B s).2 e.2
  rw [productActiveMemorySplit_total_memory] at h
  exact h

theorem full_permutation_event_memory_le (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (k : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D k s) :
    productTotalMemory (fullPermutationMixedEventTarget n S B A Δ D k s e) ≤
      productTotalMemory s + fullGhostEventBirthCount n S B A Δ D k s e +
        fullMemoryEdgeIndicator k * (T * Fintype.card G) := by
  cases k with
  | none =>
    simp only [fullPermutationMixedEventTarget, fullGhostEventBirthCount,
      fullMemoryEdgeIndicator, Nat.add_zero, Nat.zero_mul]
    exact le_rfl
  | some k =>
    cases k with
    | inl j =>
      dsimp only [FullPermutationMixedEvent, FullMixedMemoryEvent] at e
      simpa only [fullPermutationMixedEventTarget, fullMixedMemoryEventTarget,
        fullGhostEventBirthCount, fullMemoryEdgeIndicator, Nat.zero_mul, Nat.add_zero] using
        coupledGhostJointEventTarget_memory_le M B s e.down
    | inr k =>
      have h := fullActiveEdgeEventTarget_memory_le n S B A Δ D k s e
      have hc : (∑ g, (S k g)ᶜ.card) ≤ T * Fintype.card G := by
        calc
          _ ≤ ∑ _g : G, T := sum_le_sum fun g _ => ht k g
          _ = _ := by simp only [sum_const, card_univ, smul_eq_mul, mul_comm]
      exact h.trans (by simpa only [fullGhostEventBirthCount, fullMemoryEdgeIndicator,
        Nat.add_zero, Nat.one_mul] using Nat.add_le_add_left hc (productTotalMemory s))

noncomputable def fullMemoryPathPeak (steps : List (Option (J ⊕ K)))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps s) : ℕ :=
  finiteEventPathMaximum (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) productTotalMemory steps s p

theorem full_memory_path_peak_le (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (steps : List (Option (J ⊕ K)))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps s) :
    fullMemoryPathPeak n S B A Δ D steps s p ≤
      productTotalMemory s + fullGhostPathBirthCount n S B A Δ D steps s p +
        fullMemoryEdgeCount steps * (T * Fintype.card G) := by
  induction steps generalizing s with
  | nil =>
    simp only [fullMemoryPathPeak, finiteEventPathMaximum, fullGhostPathBirthCount,
      finiteEventPathCount, fullMemoryEdgeCount, List.map_nil, List.sum_nil,
      Nat.add_zero, Nat.zero_mul, le_refl]
  | cons k steps ih =>
    rcases p with ⟨e, p⟩
    have he := full_permutation_event_memory_le n S B A Δ D T ht k s e
    have hp := ih (fullPermutationMixedEventTarget n S B A Δ D k s e) p
    change max (productTotalMemory s)
      (fullMemoryPathPeak n S B A Δ D steps _ p) ≤
        productTotalMemory s +
          (fullGhostEventBirthCount n S B A Δ D k s e + fullGhostPathBirthCount n S B A Δ D steps _ p) +
          (fullMemoryEdgeIndicator k + fullMemoryEdgeCount steps) * (T * Fintype.card G)
    rw [add_mul]
    omega

theorem full_memory_path_terminal_le (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (steps : List (Option (J ⊕ K)))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps s) :
    productTotalMemory (finiteEventPathTerminal (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps s p) ≤
      productTotalMemory s + fullGhostPathBirthCount n S B A Δ D steps s p +
        fullMemoryEdgeCount steps * (T * Fintype.card G) :=
  (finite_event_path_terminal_le_maximum (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) productTotalMemory steps s p).trans
    (full_memory_path_peak_le n S B A Δ D T ht steps s p)

theorem full_memory_path_exceeds_implies_births (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (steps : List (Option (J ⊕ K)))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps s) (threshold : ℕ)
    (hlarge : threshold < fullMemoryPathPeak n S B A Δ D steps s p) :
    threshold + 1 - productTotalMemory s - fullMemoryEdgeCount steps * (T * Fintype.card G) ≤
      fullGhostPathBirthCount n S B A Δ D steps s p := by
  have h := full_memory_path_peak_le n S B A Δ D T ht steps s p
  omega

end Full
end

