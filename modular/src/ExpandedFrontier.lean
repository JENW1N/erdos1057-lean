      (q : ℝ) ≤ L^Tmod → |σ| ≤ L^Sshift →
      R ≤ UQ*UM*UT/2 → Y^(3/5 : ℝ) ≤ UM*UT/2 → Real.log (8*(UQ*UM*UT)) ≤ c*L →
      (∀ u ∈ Set.Icc (-R) R, |u| ≤ L^B0 →
        ‖∑ n ∈ D, α n*harmonicMellinWeight u n‖ ≤ L^(-Bsave)) →
      (∫ u in Set.Icc (-R) R,
        ‖primeReciprocalPolynomial s coeff u *
          (∑ n ∈ roughBand Alo Blo (Real.exp (Real.sqrt L)), harmonicMellinWeight (u+σ) n*χ (n : ZMod q))*
          (∑ n ∈ D, α n*harmonicMellinWeight u n)*
          (∑ n ∈ F, γ n*harmonicMellinWeight u n)‖^2) ≤ L^(-A) := by
  obtain ⟨B0,hB0,hmain⟩ := exists_long_rough_four_factor_integral_decay
    (a := a) (beta := beta) (c := c) (d := d) (Bcoeff := Bcoeff)
    (A := A) (As := As) (H := H) (Cmean := 2*E+16) (Cres := 2*E+16)
    (kmean := 1) (kres := 1) (q := 1) (t := Et+1) (aLong := aLong)
    ha ha1 hbeta hc hd hBcoeff hAs0 haLong (by linarith) (by linarith) Tmod Sshift
  refine ⟨B0,hB0,?_⟩
  intro Bsave hsave
  filter_upwards [hmain Bsave (by linarith),
    eventually_finite_pair_five_dyad_data (E := E) hc,
    eventually_finite_triple_five_dyad_data (E := E) hc,
    eventually_ge_atTop (5 : ℝ)] with L hdecay hpair htriple hL
  intro s hs coeff Y P R hY hYlo hYhi hPlo hPhi hR hRY hRX hsp hcoeff
    D F α γ UM UT BM BT hUM hUT hBM hBT hprod hBTpow hα hγ hD hF
    UQ Alo Blo σ q hqInst χ hUQ hQA hAB hBQ hq hσ hmeanScale hresScale hlog hlow
  have hLpos : 0 < L := by linarith
  have hUQ1 : 1 ≤ UQ := (Real.one_le_exp (mul_nonneg haLong.le hLpos.le)).trans hUQ
  have hUQpos : 0 < UQ := zero_lt_one.trans_le hUQ1
  have hUTpos : 0 < UT := zero_lt_one.trans_le hUT
  have hpair1 : 1 ≤ UM*UT/2 := (Real.one_le_rpow hY (by norm_num : (0 : ℝ) ≤ 3/5)).trans hresScale
  have hpairs : UM*UT ≤ UQ*UM*UT := by nlinarith [mul_pos hUM hUTpos]
  have htriple1 : 1 ≤ UQ*UM*UT/2 := by linarith
  have hpairlog : Real.log (8*(UM*UT)) ≤ c*L :=
    (Real.log_le_log (by positivity) (by linarith : 8*(UM*UT) ≤ 8*(UQ*UM*UT))).trans hlog
  let Qs := roughBand Alo Blo (Real.exp (Real.sqrt L))
  let δ : ℕ → ℂ := fun n => χ (n : ZMod q)*(n : ℂ)^((σ : ℂ)*Complex.I)
  have hQs : ∀ n ∈ Qs, UQ ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*UQ := by
    intro n hn
    have hm := mem_Ioc.mp (mem_filter.mp hn).1
    exact ⟨hQA.trans ((Nat.floor_lt (hUQpos.le.trans hQA)).mp hm.1).le,
