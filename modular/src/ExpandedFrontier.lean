section

/- Uniform control of the convergent correction factors in the pair sieve. -/

open Finset

namespace Bounty

theorem finite_pair_euler_correction_le_four (S : Finset ℕ)
    (hS : ∀ n ∈ S, 2 ≤ n) :
    (∏ n ∈ S, (1 + 2/(n : ℝ)^2)) ≤ 4 := by
  have hlocal : ∀ n ∈ S, 1 + 2/(n : ℝ)^2 ≤ (1 + 1/((n : ℝ)^2 - 1))^2 := by
    intro n hn
    have hn2 : (2 : ℝ) ≤ n := by exact_mod_cast hS n hn
    have hden : 0 < (n : ℝ)^2 - 1 := by nlinarith
    have hrec := one_div_le_one_div_of_le hden (by linarith : (n : ℝ)^2 - 1 ≤ (n : ℝ)^2)
    simp only [div_eq_mul_inv, one_mul] at hrec ⊢
    nlinarith [sq_nonneg (((n : ℝ)^2 - 1)⁻¹)]
  have hupper := euler_correction_product_le_two S hS
  have hnonneg : 0 ≤ ∏ n ∈ S, (1 + 1/((n : ℝ)^2 - 1)) := by
    apply prod_nonneg
    intro n hn
    have hn2 : (2 : ℝ) ≤ n := by exact_mod_cast hS n hn
    have hden : 0 < (n : ℝ)^2 - 1 := by nlinarith
    positivity
  calc
    _ ≤ ∏ n ∈ S, (1 + 1/((n : ℝ)^2 - 1))^2 :=
      prod_le_prod₀ (fun n _ => by positivity) hlocal
    _ = (∏ n ∈ S, (1 + 1/((n : ℝ)^2 - 1)))^2 := by rw [prod_pow]
    _ ≤ 4 := by nlinarith

theorem finite_inverse_avoidance_le_exp (S : Finset ℕ)
    (hS : ∀ n ∈ S, 2 ≤ n) :
    (∏ n ∈ S, (1 - 1/(n : ℝ))⁻¹) ≤ Real.exp (2 * ∑ n ∈ S, 1/(n : ℝ)) := by
  have hlocal : ∀ n ∈ S, (1 - 1/(n : ℝ))⁻¹ ≤ Real.exp (2/(n : ℝ)) := by
    intro n hn
    have hn2 : (2 : ℝ) ≤ n := by exact_mod_cast hS n hn
    have hn0 : (0 : ℝ) < n := by linarith
    have hn1 : 0 < (n : ℝ)-1 := by linarith
    have hrec : 1/((n : ℝ)-1) ≤ 2/(n : ℝ) := by
      apply (div_le_div_iff₀ hn1 hn0).mpr
      linarith
    have hid : (1 - 1/(n : ℝ))⁻¹ = 1 + 1/((n : ℝ)-1) := by
      field_simp
      ring
    have he := Real.add_one_le_exp (2/(n : ℝ))
    rw [hid]
    linarith
  calc
    _ ≤ ∏ n ∈ S, Real.exp (2/(n : ℝ)) := by
      apply prod_le_prod₀ _ hlocal
      intro n hn
      have hn2 : (2 : ℝ) ≤ n := by exact_mod_cast hS n hn
      have hn0 : (0 : ℝ) < n := by linarith
      apply inv_nonneg.mpr
      exact sub_nonneg.mpr ((div_le_one hn0).mpr (by linarith))
    _ = Real.exp (∑ n ∈ S, 2/(n : ℝ)) := by rw [Real.exp_sum]
    _ = Real.exp (2 * ∑ n ∈ S, 1/(n : ℝ)) := by
      congr 1
      rw [mul_sum]
      apply sum_congr rfl
      intro n _
      ring

end Bounty
end

section

/- The original joint raw rows and histories preserve scalar multiplication,
with independent input and output caps and arbitrary signed raw steps. -/

open Finset

namespace Bounty

variable {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
  [∀ g, DecidableEq (P g)] {R : (g : Fin N) → P g → Type*}
  [∀ g p, AddGroup (R g p)]
  [∀ g p, DecidableEq (R g p)]

theorem global_birth_joint_raw_row_mul
    {a b : (g : Fin N) → P g → Bool}
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (cap : ℕ) (c : ℂ) (F : GlobalBirthJointState R → ℂ)
    (s : GlobalBirthJointState R) :
    globalBirthJointRawRow step cap (fun t => c * F t) s =
      c * globalBirthJointRawRow step cap F s := by
  unfold globalBirthJointRawRow
  rw [global_birth_joint_raw_cutoff_mul]
  exact fin_tensor_row_mul_left N _
    (fun g d K t => global_birth_raw_step_row_mul (step g) d K t)
    c (globalBirthJointRawCutoff cap F) s

theorem global_birth_joint_cut_raw_row_mul
    {a b : (g : Fin N) → P g → Bool}
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (inputCap outputCap : ℕ) (c : ℂ) (F : GlobalBirthJointState R → ℂ)
    (s : GlobalBirthJointState R) :
    globalBirthJointCutRawRow step inputCap outputCap (fun t => c * F t) s =
      c * globalBirthJointCutRawRow step inputCap outputCap F s := by
  unfold globalBirthJointCutRawRow
  have he : globalBirthJointRawRow step outputCap (fun t => c * F t) =
      fun t => c * globalBirthJointRawRow step outputCap F t :=
    funext (global_birth_joint_raw_row_mul step outputCap c F)
  rw [he, global_birth_joint_raw_cutoff_mul]

variable (a : ℕ → (g : Fin N) → P g → Bool)
  (steps : (i : ℕ) → (g : Fin N) → GlobalBirthRawStep (R := R g) (a i g) (a (i + 1) g))
  (cap : ℕ → ℕ)

theorem global_birth_joint_raw_history_mul (n : ℕ) (c : ℂ)
    (F : GlobalBirthJointState R → ℂ) :
    globalBirthJointRawHistory a steps cap n (fun t => c * F t) =
      fun s => c * globalBirthJointRawHistory a steps cap n F s :=
  finite_row_composition_mul (S := fun _ => GlobalBirthJointState R)
    (fun i => globalBirthJointCutRawRow (steps i) (cap i) (cap (i + 1))) n
    (fun i _ d K s => global_birth_joint_cut_raw_row_mul (steps i) (cap i) (cap (i + 1)) d K s)
    c F

theorem global_birth_joint_raw_history_weighted (c : ℕ → ℂ) (n : ℕ)
    (F : GlobalBirthJointState R → ℂ) :
    finiteRowComposition (S := fun _ => GlobalBirthJointState R)
      (fun i K s => c i * globalBirthJointCutRawRow (steps i) (cap i) (cap (i + 1)) K s) n F =
      fun s => (∏ i ∈ range n, c i) * globalBirthJointRawHistory a steps cap n F s :=
  finite_row_composition_weighted (S := fun _ => GlobalBirthJointState R)
    (fun i => globalBirthJointCutRawRow (steps i) (cap i) (cap (i + 1))) c n
    (fun i _ d K s => global_birth_joint_cut_raw_row_mul (steps i) (cap i) (cap (i + 1)) d K s) F

end Bounty
end

section

/- Summing the lattice discrepancy over any finite set of residue pairs. -/

open Finset

namespace Bounty

theorem interval_allowed_residue_pairs_error (A B C D r : ℕ) [NeZero r]
    (R : Finset (ZMod r × ZMod r)) (hAB : A ≤ B) (hCD : C ≤ D) :
    |(((Finset.product (Ioc A B) (Ioc C D)).filter
        (fun n : ℕ × ℕ => ((n.1 : ZMod r), (n.2 : ZMod r)) ∈ R)).card : ℝ) -
      (R.card : ℝ) * ((((B : ℝ)-A)/r) * (((D : ℝ)-C)/r))| ≤
      (R.card : ℝ) * (1 + ((B : ℝ)-A)/r + ((D : ℝ)-C)/r) := by
  classical
  let P := Finset.product (Ioc A B) (Ioc C D)
  let f : ℕ × ℕ → ZMod r × ZMod r := fun n => ((n.1 : ZMod r), (n.2 : ZMod r))
  let X := (((B : ℝ)-A)/r) * (((D : ℝ)-C)/r)
  let E := 1 + ((B : ℝ)-A)/r + ((D : ℝ)-C)/r
  have hsum : (∑ a ∈ R, ((P.filter (fun n => f n = a)).card : ℝ)) =
      ((P.filter (fun n => f n ∈ R)).card : ℝ) := by
    simpa only [sum_const, nsmul_eq_mul, mul_one] using
      sum_fiberwise_eq_sum_filter P R f (fun _ => (1 : ℝ))
  have hres (k : ℕ) (t : ZMod r) : (k : ZMod r) = t ↔ k % r = t.val % r := by
    conv_lhs => rhs; rw [← ZMod.natCast_zmod_val t]
    exact ZMod.natCast_eq_natCast_iff' k t.val r
  have hbound (a : ZMod r × ZMod r) :
      |((P.filter (fun n => f n = a)).card : ℝ) - X| ≤ E := by
    have hset : P.filter (fun n => f n = a) = P.filter
        (fun n : ℕ × ℕ => n.1 % r = a.1.val % r ∧ n.2 % r = a.2.val % r) := by
      apply filter_congr
      intro n _
      change (((n.1 : ZMod r), (n.2 : ZMod r)) = a) ↔ _
      rw [Prod.ext_iff]
      exact and_congr (hres n.1 a.1) (hres n.2 a.2)
    rw [hset]
    exact interval_residue_pair_count_error A B C D r a.1.val a.2.val hAB hCD
      (Nat.pos_of_ne_zero (NeZero.ne r))
  have hid : ((P.filter (fun n => f n ∈ R)).card : ℝ) - (R.card : ℝ)*X =
      ∑ a ∈ R, (((P.filter (fun n => f n = a)).card : ℝ)-X) := by
    rw [sum_sub_distrib, hsum]
    simp only [sum_const, nsmul_eq_mul]
  change |((P.filter (fun n => f n ∈ R)).card : ℝ) - (R.card : ℝ)*X| ≤ (R.card : ℝ)*E
  rw [hid]
  calc
    _ ≤ ∑ a ∈ R, |((P.filter (fun n => f n = a)).card : ℝ)-X| := abs_sum_le_sum_abs _ _
    _ ≤ ∑ _a ∈ R, E := sum_le_sum (fun a _ => hbound a)
    _ = _ := by simp

end Bounty
end

section

/- Chinese-remainder counting in natural residue representatives. -/

open Finset

namespace Bounty

theorem nat_residue_pair_crt_card (m n : ℕ) (hm : 0 < m) (hn : 0 < n)
    (hcop : m.Coprime n) (S T : Finset (ℕ × ℕ))
    (hS : ∀ v ∈ S, v.1 < m ∧ v.2 < m) (hT : ∀ v ∈ T, v.1 < n ∧ v.2 < n) :
    (((Finset.product (range (m*n)) (range (m*n))).filter
      (fun v : ℕ × ℕ => (v.1 % m, v.2 % m) ∈ S ∧ (v.1 % n, v.2 % n) ∈ T)).card) =
      S.card * T.card := by
  classical
  have hinj (a b : ℕ) (ha : a < m*n) (hb : b < m*n)
      (habm : a % m = b % m) (habn : a % n = b % n) : a = b := by
    have h := (Nat.modEq_and_modEq_iff_modEq_mul hcop).mp ⟨habm, habn⟩
    simpa only [Nat.ModEq, Nat.mod_eq_of_lt ha, Nat.mod_eq_of_lt hb] using h
  rw [← Finset.card_product S T]
  apply card_bij (fun v _ => ((v.1 % m, v.2 % m), (v.1 % n, v.2 % n)))
  · intro v hv
    exact mem_product.mpr (mem_filter.mp hv).2
  · intro v hv w hw h
    have hv' := (mem_filter.mp hv).1
    have hw' := (mem_filter.mp hw).1
    rw [Finset.product_eq_sprod, mem_product] at hv' hw'
    simp only [mem_range] at hv' hw'
    have h1 := congrArg (fun a : (ℕ × ℕ) × (ℕ × ℕ) => a.1.1) h
    have h2 := congrArg (fun a : (ℕ × ℕ) × (ℕ × ℕ) => a.1.2) h
    have h3 := congrArg (fun a : (ℕ × ℕ) × (ℕ × ℕ) => a.2.1) h
    have h4 := congrArg (fun a : (ℕ × ℕ) × (ℕ × ℕ) => a.2.2) h
    exact Prod.ext (hinj _ _ hv'.1 hw'.1 h1 h3) (hinj _ _ hv'.2 hw'.2 h2 h4)
  · intro v hv
    obtain ⟨hvS, hvT⟩ := mem_product.mp hv
    obtain ⟨hS1, hS2⟩ := hS v.1 hvS
    obtain ⟨hT1, hT2⟩ := hT v.2 hvT
    let x := Nat.chineseRemainder hcop v.1.1 v.2.1
    let y := Nat.chineseRemainder hcop v.1.2 v.2.2
    have hx : (x : ℕ) < m*n := Nat.chineseRemainder_lt_mul hcop _ _ hm.ne' hn.ne'
    have hy : (y : ℕ) < m*n := Nat.chineseRemainder_lt_mul hcop _ _ hm.ne' hn.ne'
    have hxm : (x : ℕ) % m = v.1.1 := by
      simpa only [Nat.ModEq, Nat.mod_eq_of_lt hS1] using x.property.1
    have hxn : (x : ℕ) % n = v.2.1 := by
      simpa only [Nat.ModEq, Nat.mod_eq_of_lt hT1] using x.property.2
    have hym : (y : ℕ) % m = v.1.2 := by
      simpa only [Nat.ModEq, Nat.mod_eq_of_lt hS2] using y.property.1
    have hyn : (y : ℕ) % n = v.2.2 := by
      simpa only [Nat.ModEq, Nat.mod_eq_of_lt hT2] using y.property.2
    refine ⟨(x, y), ?_, ?_⟩
    · apply mem_filter.mpr
      constructor
      · rw [Finset.product_eq_sprod, mem_product]
        exact ⟨mem_range.mpr hx, mem_range.mpr hy⟩
      · simpa only [hxm, hym, hxn, hyn, Prod.mk.eta] using And.intro hvS hvT
    · simp only [hxm, hym, hxn, hyn, Prod.mk.eta]

end Bounty
end

section

/- Finite-sum preservation for the literal raw rows, with all cutoffs retained. -/

open Finset
namespace Bounty

theorem global_birth_raw_step_row_sum {A P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)]
    {a b : P → Bool} (step : GlobalBirthRawStep (R := R) a b)
    (t : Finset A) (F : A → GlobalBirthHistoryState R → ℂ) (s : GlobalBirthHistoryState R) :
    globalBirthRawStepRow step (fun H q => ∑ a ∈ t, F a (H, q)) s.1 s.2 =
      ∑ a ∈ t, globalBirthRawStepRow step (fun H q => F a (H, q)) s.1 s.2 := by
  rw [global_birth_raw_step_event_sum step s (fun u => ∑ a ∈ t, F a u)]
  simp only [mul_sum]
  rw [sum_comm]
  apply sum_congr rfl
  intro a ha
  exact (global_birth_raw_step_event_sum step s (F a)).symm

theorem global_birth_joint_raw_cutoff_sum {A : Type*} {N : ℕ} {P : Fin N → Type*}
    {R : (g : Fin N) → P g → Type*} (B : ℕ)
    (t : Finset A) (F : A → GlobalBirthJointState R → ℂ) :
    globalBirthJointRawCutoff B (fun s => ∑ a ∈ t, F a s) =
      fun s => ∑ a ∈ t, globalBirthJointRawCutoff B (F a) s := by
  funext s
  unfold globalBirthJointRawCutoff
  split_ifs <;> simp

theorem joint_raw_tensor_cutoff_sum {A : Type*} {N : ℕ} {P : Fin N → Type*}
    {R : (g : Fin N) → P g → Type*} (B : ℕ)
    (row : (g : Fin N) → (GlobalBirthHistoryState (R g) → ℂ) →
      GlobalBirthHistoryState (R g) → ℂ)
    (hrow : ∀ g (t : Finset A) (F : A → GlobalBirthHistoryState (R g) → ℂ) s, row g (fun u => ∑ a ∈ t, F a u) s =
      ∑ a ∈ t, row g (F a) s)
    (t : Finset A) (F : A → GlobalBirthJointState R → ℂ) (s : GlobalBirthJointState R) :
    jointRawTensorCutoff B row (fun u => ∑ a ∈ t, F a u) s =
      ∑ a ∈ t, jointRawTensorCutoff B row (F a) s := by
  unfold jointRawTensorCutoff
  rw [global_birth_joint_raw_cutoff_sum]
  have he : finTensorRow N row (fun u => ∑ a ∈ t, globalBirthJointRawCutoff B (F a) u) =
      fun v => ∑ a ∈ t, finTensorRow N row (globalBirthJointRawCutoff B (F a)) v :=
    funext (fin_tensor_row_sum N row hrow t _)
  rw [he, global_birth_joint_raw_cutoff_sum]

theorem global_birth_joint_cut_raw_row_sum {A : Type*} {N : ℕ} {P : Fin N → Type*}
    [∀ g, Fintype (P g)] [∀ g, DecidableEq (P g)]
    {R : (g : Fin N) → P g → Type*} [∀ g p, AddGroup (R g p)]
    [∀ g p, DecidableEq (R g p)]
    {a b : (g : Fin N) → P g → Bool}
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (inputCap outputCap : ℕ) (t : Finset A) (F : A → GlobalBirthJointState R → ℂ)
    (s : GlobalBirthJointState R) :
    globalBirthJointCutRawRow step inputCap outputCap (fun u => ∑ a ∈ t, F a u) s =
      ∑ a ∈ t, globalBirthJointCutRawRow step inputCap outputCap (F a) s := by
  unfold globalBirthJointCutRawRow globalBirthJointRawRow
  rw [global_birth_joint_raw_cutoff_sum]
  have he : finTensorRow N (fun g K (v : GlobalBirthHistoryState (R g)) => globalBirthRawStepRow (step g)
      (fun H q => K (H, q)) v.1 v.2)
      (fun u => ∑ a ∈ t, globalBirthJointRawCutoff outputCap (F a) u) =
      fun v => ∑ a ∈ t, finTensorRow N (fun g K (v : GlobalBirthHistoryState (R g)) => globalBirthRawStepRow (step g)
        (fun H q => K (H, q)) v.1 v.2) (globalBirthJointRawCutoff outputCap (F a)) v := by
    funext v
    exact fin_tensor_row_sum N _ (fun g => global_birth_raw_step_row_sum (step g)) t _ v
  rw [he, global_birth_joint_raw_cutoff_sum]

theorem global_birth_edge_raw_row_sum {A P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] {N d : ℕ}
    (source target : Fin d ↪ P) (delta : (p : P) → R p)
    (H : Finset P) (old : Fin N → Σ p, R p) (eligible : Finset (Fin N))
    (β : P → ℝ) (ρ V : ℝ) (cap : ℕ)
    (t : Finset A) (F : A → GlobalBirthHistoryState R → ℂ) :
    globalBirthEdgeRawRow source target delta H old eligible β ρ V cap
      (fun H q => ∑ a ∈ t, F a (H, q)) =
      ∑ a ∈ t, globalBirthEdgeRawRow source target delta H old eligible β ρ V cap
        (fun H q => F a (H, q)) := by
  classical
  unfold globalBirthEdgeRawRow unrestrictedEdgeAction
  conv_rhs => rw [sum_comm]
  apply sum_congr rfl
  intro stores _
  conv_rhs => rw [sum_comm]
  apply sum_congr rfl
  intro promotions _
  conv_rhs => rw [sum_comm]
  apply sum_congr rfl
  intro e _
  conv_rhs => rw [sum_comm]
  apply sum_congr rfl
  intro fresh _
  split_ifs <;> simp [mul_sum]

end Bounty
end

section

/- The actual root residue model may be summed only over paths admitting all marked residues. -/

open Finset
open scoped Classical
namespace Bounty

section Root
variable {G I : Type*} [Fintype G] [DecidableEq G]
  {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val]
  {J ell : ℕ} {patterns : Finset I}
  (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hprime : ∀ g p, p ∈ P g → p.Prime)
  (C : I → G → Finset (Fin J)) (q : ℝ) (k : ℕ → I → ℤ)
  (N : ℕ) (L : PhysicalMarkLists P J ell)

include hP hprime

theorem physical_finite_vertex_expectation_zero_of_incompatible
    (p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)
    (h : ¬ ∃ r : PhysicalResidues P, physicalFinitePathResidueCompatible C k N r L p) :
    physicalFiniteVertexExpectation C q k N L p = 0 := by
  exact physical_residue_vertex_expectation_zero_of_incompatible hP hprime
    (finitePathMarks L p) (range (N + 2))
    (physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p) (N + 1))
    (physicalEndpointSchedule q (N + 1)) h

theorem physical_finite_vertex_expectation_nonzero_compatible
    (p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)
    (h : physicalFiniteVertexExpectation C q k N L p ≠ 0) :
    ∃ r : PhysicalResidues P, physicalFinitePathResidueCompatible C k N r L p := by
  by_contra hn
  exact h (physical_finite_vertex_expectation_zero_of_incompatible hP hprime C q k N L p hn)

theorem physical_finite_vertex_expectation_nonzero_marks
    (p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)
    (h : physicalFiniteVertexExpectation C q k N L p ≠ 0) :
    ∃ r : PhysicalResidues P, ∀ j : Fin (N + 2),
      ∀ a ∈ physicalMarkedPrimes (finitePathMarks L p j.val),
      r a = -(physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p)
        (N + 1) j.val : ZMod a.2.val) := by
  obtain ⟨r, hr⟩ := physical_finite_vertex_expectation_nonzero_compatible hP hprime C q k N L p h
  exact ⟨r, (physical_finite_path_residue_compatible_iff C k N r L p).mp hr⟩

theorem physical_finite_vertex_weighted_sum_compatible
    (s : Finset (Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell))
    (c : (Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) → ℂ) :
    (∑ p ∈ s, c p * (physicalFiniteVertexExpectation C q k N L p : ℂ)) =
      ∑ p ∈ s.filter (fun p => ∃ r : PhysicalResidues P,
        physicalFinitePathResidueCompatible C k N r L p),
        c p * (physicalFiniteVertexExpectation C q k N L p : ℂ) := by
  rw [sum_filter]
  apply sum_congr rfl
  intro p hp
  by_cases h : ∃ r : PhysicalResidues P, physicalFinitePathResidueCompatible C k N r L p
  · simp only [h, if_true]
  · rw [if_neg h, physical_finite_vertex_expectation_zero_of_incompatible hP hprime C q k N L p h]
    simp only [Complex.ofReal_zero, mul_zero]

theorem physical_root_residue_model_compatible
    (V : G → ℝ) (ζ : ℕ → I → ℝ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    physicalRootResidueModel V patterns C q ζ k K N =
      (physicalStateMass V J ell : ℂ) * ∑ L : PhysicalMarkLists P J ell,
        ∑ p : {p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell //
          ∃ r : PhysicalResidues P, physicalFinitePathResidueCompatible C k N r L p},
          physicalFiniteReturnScalar V patterns C ζ k K N L p.val *
            (physicalFiniteVertexExpectation C q k N L p.val : ℂ) := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  dsimp only [physicalRootResidueModel]
  congr 1
  apply sum_congr rfl
  intro M hM
  rw [physical_finite_vertex_weighted_sum_compatible hP hprime C q k N M univ]
  exact sum_subtype _ (by simp) _

end Root
end Bounty
end

section

/- Exact splitting of physical auxiliary draws into disjoint flat slot sets.
The identities retain repeated labels and require no analytic hypotheses. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def repeatedBigAuxCut {G : Type*} [DecidableEq G] {J ell : ℕ}
    (A B : Finset (Σ _ : G, PhysicalSlots J ell)) (g : G) : Finset (Fin J) :=
  univ.filter (fun j => ⟨g, Sum.inl j⟩ ∈ A ∪ B)

theorem mem_repeatedBigAuxCut {G : Type*} [DecidableEq G] {J ell : ℕ}
    (A B : Finset (Σ _ : G, PhysicalSlots J ell)) (g : G) (j : Fin J) :
    j ∈ repeatedBigAuxCut A B g ↔ ⟨g, Sum.inl j⟩ ∈ A ∪ B := by
  simp only [repeatedBigAuxCut, mem_filter, mem_univ, true_and]

noncomputable def repeatedBigAuxIndexEquiv {G : Type*} [DecidableEq G] {J ell : ℕ}
    (A B : Finset (Σ _ : G, PhysicalSlots J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : Σ _ : G, PhysicalSlots J ell) ∉ A ∪ B) :
    (Σ g, ↥(repeatedBigAuxCut A B g)) ≃ ↥(A ∪ B) where
  toFun i := ⟨⟨i.1, Sum.inl i.2.val⟩, (mem_repeatedBigAuxCut A B i.1 i.2.val).mp i.2.property⟩
  invFun i := by
    rcases i with ⟨⟨g, s⟩, hi⟩
    cases s with
    | inl j => exact ⟨g, ⟨j, (mem_repeatedBigAuxCut A B g j).mpr hi⟩⟩
    | inr j => exact False.elim (hU g j hi)
  left_inv i := by rcases i with ⟨g, j, hj⟩; rfl
  right_inv i := by
    rcases i with ⟨⟨g, s⟩, hi⟩
    cases s with
    | inl j => rfl
    | inr j => exact False.elim (hU g j hi)

noncomputable def repeatedBigAuxUnionEquiv {G : Type*} [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (A B : Finset (Σ _ : G, PhysicalSlots J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : Σ _ : G, PhysicalSlots J ell) ∉ A ∪ B) :
    PhysicalAuxLabels P (repeatedBigAuxCut A B) ≃ (∀ i : ↥(A ∪ B), P i.val.1) where
  toFun aux i := by
    rcases i with ⟨⟨g, s⟩, hi⟩
    cases s with
    | inl j => exact aux g ⟨j, (mem_repeatedBigAuxCut A B g j).mpr hi⟩
    | inr j => exact False.elim (hU g j hi)
  invFun f g j := f ⟨⟨g, Sum.inl j.val⟩, (mem_repeatedBigAuxCut A B g j.val).mp j.property⟩
  left_inv aux := by funext g j; rfl
  right_inv f := by
    funext i
    rcases i with ⟨⟨g, s⟩, hi⟩
    cases s with
    | inl j => rfl
    | inr j => exact False.elim (hU g j hi)

noncomputable def repeatedBigAuxSplitEquiv {G : Type*} [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (A B : Finset (Σ _ : G, PhysicalSlots J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : Σ _ : G, PhysicalSlots J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) :
    PhysicalAuxLabels P (repeatedBigAuxCut A B) ≃
      ((∀ i : A, P i.val.1) × (∀ i : B, P i.val.1)) :=
  (repeatedBigAuxUnionEquiv P A B hU).trans
    (Equiv.piFinsetUnion (fun i : Σ _ : G, PhysicalSlots J ell => P i.1) hAB).symm

theorem repeatedBigAuxUnionEquiv_apply_inl {G : Type*} [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (A B : Finset (Σ _ : G, PhysicalSlots J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : Σ _ : G, PhysicalSlots J ell) ∉ A ∪ B)
    (aux : PhysicalAuxLabels P (repeatedBigAuxCut A B)) (g : G) (j : Fin J)
    (hj : (⟨g, Sum.inl j⟩ : Σ _ : G, PhysicalSlots J ell) ∈ A ∪ B) :
    repeatedBigAuxUnionEquiv P A B hU aux ⟨⟨g, Sum.inl j⟩, hj⟩ =
      aux g ⟨j, (mem_repeatedBigAuxCut A B g j).mpr hj⟩ := rfl

theorem repeatedBigAuxUnionEquiv_prod {G : Type*} [DecidableEq G] [Fintype G] {J ell : ℕ}
    (P : G → Finset ℕ) (A B : Finset (Σ _ : G, PhysicalSlots J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : Σ _ : G, PhysicalSlots J ell) ∉ A ∪ B)
    {M : Type*} [CommMonoid M] (F : ∀ g, P g → M)
    (aux : PhysicalAuxLabels P (repeatedBigAuxCut A B)) :
    (∏ g, ∏ j : repeatedBigAuxCut A B g, F g (aux g j)) =
      ∏ i : ↥(A ∪ B), F i.val.1 (repeatedBigAuxUnionEquiv P A B hU aux i) := by
  have h := Fintype.prod_equiv (repeatedBigAuxIndexEquiv A B hU)
    (fun i => F i.1 (aux i.1 i.2))
    (fun i => F i.val.1 (repeatedBigAuxUnionEquiv P A B hU aux i)) (fun _ => rfl)
  simpa only [Fintype.prod_sigma] using h

theorem repeatedBigAuxSplitEquiv_symm_prod {G : Type*} [DecidableEq G] [Fintype G] {J ell : ℕ}
    (P : G → Finset ℕ) (A B : Finset (Σ _ : G, PhysicalSlots J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : Σ _ : G, PhysicalSlots J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) {M : Type*} [CommMonoid M] (F : ∀ g, P g → M)
    (a : ∀ i : A, P i.val.1) (b : ∀ i : B, P i.val.1) :
    (∏ g, ∏ j : repeatedBigAuxCut A B g,
      F g ((repeatedBigAuxSplitEquiv P A B hU hAB).symm (a, b) g j)) =
      (∏ i : A, F i.val.1 (a i)) * (∏ i : B, F i.val.1 (b i)) := by
  rw [repeatedBigAuxUnionEquiv_prod P A B hU F]
  simp only [repeatedBigAuxSplitEquiv, Equiv.symm_trans_apply, Equiv.symm_symm,
    Equiv.apply_symm_apply]
  let e := Equiv.Finset.union A B hAB
  let f := Equiv.piFinsetUnion (fun i : Σ _ : G, PhysicalSlots J ell => P i.1) hAB (a, b)
  calc
    (∏ i : ↥(A ∪ B), F i.val.1 (f i)) =
        ∏ i : A ⊕ B, F (e i).val.1 (f (e i)) := (e.prod_comp _).symm
    _ = _ := by
      rw [Fintype.prod_sum_type]
      congr 1
      · apply prod_congr rfl
        intro i _
        change F i.val.1 (f ⟨i.val, mem_union_left B i.property⟩) = F i.val.1 (a i)
        dsimp only [f]
        rw [Equiv.piFinsetUnion_left]
      · apply prod_congr rfl
        intro i _
        change F i.val.1 (f ⟨i.val, mem_union_right A i.property⟩) = F i.val.1 (b i)
        dsimp only [f]
        rw [Equiv.piFinsetUnion_right]

theorem repeatedBigAuxSplitEquiv_symm_mass {G : Type*} [DecidableEq G] [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (a : ∀ i : A, P i.val.1) (b : ∀ i : B, P i.val.1) :
    physicalAuxMass V (repeatedBigAuxCut A B)
        ((repeatedBigAuxSplitEquiv P A B hU hAB).symm (a, b)) =
      finiteProductWeight (fun i : A => physicalLabelLaw V i.val.1) a *
        finiteProductWeight (fun i : B => physicalLabelLaw V i.val.1) b :=
  repeatedBigAuxSplitEquiv_symm_prod P A B hU hAB (physicalLabelLaw V) a b

theorem repeatedBigAuxSplitEquiv_symm_label_prod {G : Type*} [DecidableEq G] [Fintype G]
    (P : G → Finset ℕ) {J ell : ℕ} (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (a : ∀ i : A, P i.val.1) (b : ∀ i : B, P i.val.1) :
    (∏ g, ∏ j : repeatedBigAuxCut A B g,
      (((repeatedBigAuxSplitEquiv P A B hU hAB).symm (a, b)) g j).val) =
      (∏ i : A, (a i).val) * (∏ i : B, (b i).val) :=
  repeatedBigAuxSplitEquiv_symm_prod P A B hU hAB (fun _ p => p.val) a b

theorem repeated_big_aux_split_sum {G : Type*} [DecidableEq G] [Fintype G]
    (P : G → Finset ℕ) {J ell : ℕ} (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) {M : Type*} [AddCommMonoid M]
    (F : PhysicalAuxLabels P (repeatedBigAuxCut A B) → M) :
    (∑ aux, F aux) = ∑ a, ∑ b, F ((repeatedBigAuxSplitEquiv P A B hU hAB).symm (a, b)) := by
  rw [← (repeatedBigAuxSplitEquiv P A B hU hAB).symm.sum_comp F]
  exact Fintype.sum_prod_type _

theorem repeatedBigAuxCut_shared {G : Type*} [DecidableEq G] [Fintype G] {J ell : ℕ}
    (A B : Finset (RepeatedBigFlatIndex G J ell)) :
    repeatedBigFlatShared (ell := ell) (repeatedBigAuxCut A B) =
      repeatedBigFlatActive J ell \ (A ∪ B) := by
  ext ⟨g, j | j⟩
  · simp only [repeatedBigFlatShared_mem_inl, mem_repeatedBigAuxCut, mem_sdiff,
      repeatedBigFlatActive_mem_inl, true_and]
  · simp only [repeatedBigFlatShared_not_mem_inr, mem_sdiff,
      repeatedBigFlatActive_not_mem_inr, false_and]

theorem repeatedBigAux_no_tail_of_subset {G : Type*} [DecidableEq G] [Fintype G] {J ell : ℕ}
    {A B : Finset (RepeatedBigFlatIndex G J ell)}
    (hA : A ⊆ repeatedBigFlatActive J ell) (hB : B ⊆ repeatedBigFlatActive J ell) :
    ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B := by
  intro g j hij
  exact repeatedBigFlatActive_not_mem_inr J ell g j ((union_subset hA hB) hij)

end Bounty
end

section

/- Exact raw and kernel pairing transport from repeated physical lists to
flat group-slot arrays under the untilted active law. Full independent
slot-permutation symmetry is equivalent to symmetry in each group. -/

open Finset Classical

namespace Bounty

theorem repeated_big_clean_raw_pairing_flat {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ)
    (k f g : RepeatedBigLists P J ell → ℂ) :
    cleanRawPairing
      (finiteProductWeight (fun i : RepeatedBigFlatIndex G J ell => physicalLabelLaw V i.1))
      (fun x => k ((repeatedBigFlatEquiv P J ell).symm x))
      (fun x => f ((repeatedBigFlatEquiv P J ell).symm x))
      (fun x => g ((repeatedBigFlatEquiv P J ell).symm x)) =
      cleanRawPairing (repeatedBigActiveMass V (fun _ _ => 1)) k f g := by
  have hw : (fun x => repeatedBigActiveMass V (fun _ _ => 1)
      ((repeatedBigFlatEquiv P J ell).symm x)) =
      finiteProductWeight (fun i : RepeatedBigFlatIndex G J ell => physicalLabelLaw V i.1) := by
    funext x
    simpa only [Equiv.apply_symm_apply] using
      repeated_big_active_mass_flat V ((repeatedBigFlatEquiv P J ell).symm x)
  have h := clean_raw_pairing_equiv (repeatedBigFlatEquiv P J ell)
    (repeatedBigActiveMass V (fun _ _ => 1)) k f g
  rw [hw] at h
  exact h.symm

theorem repeated_big_clean_kernel_pairing_flat {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → ℂ)
    (f g : RepeatedBigLists P J ell → ℂ) :
    cleanKernelPairing
      (finiteProductWeight (fun i : RepeatedBigFlatIndex G J ell => physicalLabelLaw V i.1))
      (fun x y => K ((repeatedBigFlatEquiv P J ell).symm x)
        ((repeatedBigFlatEquiv P J ell).symm y))
      (fun x => f ((repeatedBigFlatEquiv P J ell).symm x))
      (fun x => g ((repeatedBigFlatEquiv P J ell).symm x)) =
      cleanKernelPairing (repeatedBigActiveMass V (fun _ _ => 1)) K f g := by
  have hw : (fun x => repeatedBigActiveMass V (fun _ _ => 1)
      ((repeatedBigFlatEquiv P J ell).symm x)) =
      finiteProductWeight (fun i : RepeatedBigFlatIndex G J ell => physicalLabelLaw V i.1) := by
    funext x
    simpa only [Equiv.apply_symm_apply] using
      repeated_big_active_mass_flat V ((repeatedBigFlatEquiv P J ell).symm x)
  have h := clean_kernel_pairing_equiv (repeatedBigFlatEquiv P J ell)
    (repeatedBigActiveMass V (fun _ _ => 1)) K f g
  rw [hw] at h
  exact h.symm

theorem repeated_big_symmetric_iff_group_slot_symmetric
    {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (f : RepeatedBigLists P J ell → ℂ) :
    f ∈ repeatedBigSymmetricSubspace ↔ ∀ g, finiteGroupSlotSymmetric g f := by
  constructor
  · intro hf g σ L
    let τ : PhysicalPermutations G J ell := Function.update (fun _ => Equiv.refl _) g σ
    have hτ : repeatedBigPermutationEquiv τ L =
        Function.update L g (finiteSlotRelabel σ (L g)) := by
      funext h
      by_cases hh : h = g
      · subst h
        simp only [repeatedBigPermutationEquiv, Equiv.coe_fn_mk, τ,
          Function.update_self, finiteSlotRelabel]
      · simp only [repeatedBigPermutationEquiv, Equiv.coe_fn_mk, τ,
          Function.update_of_ne hh, Equiv.refl_apply]
    exact hτ ▸ hf τ L
  · intro hf
    change ∀ σ L, f (repeatedBigPermutationEquiv σ L) = f L
    intro σ L
    have hpartial (s : Finset G) :
        f (fun g => if g ∈ s then finiteSlotRelabel (σ g) (L g) else L g) = f L := by
      induction s using Finset.induction with
      | empty => simp
      | @insert a s ha ih =>
        let y : RepeatedBigLists P J ell :=
          fun g => if g ∈ s then finiteSlotRelabel (σ g) (L g) else L g
        have hy :
            (fun g => if g ∈ insert a s then finiteSlotRelabel (σ g) (L g) else L g) =
              Function.update y a (finiteSlotRelabel (σ a) (y a)) := by
          funext g
          by_cases hg : g = a
          · subst g
            simp only [mem_insert_self, if_true, Function.update_self, y, if_neg ha]
          · simp only [mem_insert, hg, false_or, Function.update_of_ne hg, y]
        rw [hy, hf a (σ a)]
        exact ih
    simpa only [mem_univ, if_true, finiteSlotRelabel, repeatedBigPermutationEquiv,
      Equiv.coe_fn_mk] using hpartial univ

end Bounty
end

section

/- Birth data on the existing paths are projections of the owning full event. -/

namespace Bounty

section Paths

variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
    (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
    (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K)))

noncomputable def fullMixedPathBornData
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x)
    (a : FullMixedBirthAddress S B steps) : Option (FullMixedBornData n) :=
  let e := finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) steps x p a.1
  fullMixedEventBornData n S B A Δ D (steps.get a.1) e.1 e.2 a.2

noncomputable def fullMixedPathBirthLabel
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x)
    (a : FullMixedBirthAddress S B steps) : Option ((g : Fin N) × P g) :=
  (fullMixedPathBornData n S B A Δ D steps x p a).map (fullMixedBornPrime n)

noncomputable def fullMixedPathBirthPerformed
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x)
    (a : FullMixedBirthAddress S B steps) : Prop :=
  (fullMixedPathBornData n S B A Δ D steps x p a).isSome = true

theorem full_mixed_path_born_data_local
    (x y : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x)
    (q : FullPermutationMixedPath n S B A Δ D steps y)
    (a : FullMixedBirthAddress S B steps)
    (h : finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x p a.1 =
      finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps y q a.1) :
    fullMixedPathBornData n S B A Δ D steps x p a =
      fullMixedPathBornData n S B A Δ D steps y q a := by
  unfold fullMixedPathBornData
  rw [h]

theorem full_mixed_path_birth_label_local
    (x y : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x)
    (q : FullPermutationMixedPath n S B A Δ D steps y)
    (a : FullMixedBirthAddress S B steps)
    (h : finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x p a.1 =
      finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps y q a.1) :
    fullMixedPathBirthLabel n S B A Δ D steps x p a =
      fullMixedPathBirthLabel n S B A Δ D steps y q a := by
  unfold fullMixedPathBirthLabel
  rw [full_mixed_path_born_data_local n S B A Δ D steps x y p q a h]

theorem full_mixed_path_birth_performed_local
    (x y : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x)
    (q : FullPermutationMixedPath n S B A Δ D steps y)
    (a : FullMixedBirthAddress S B steps)
    (h : finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x p a.1 =
      finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps y q a.1) :
    fullMixedPathBirthPerformed n S B A Δ D steps x p a ↔
      fullMixedPathBirthPerformed n S B A Δ D steps y q a := by
  unfold fullMixedPathBirthPerformed
  rw [full_mixed_path_born_data_local n S B A Δ D steps x y p q a h]

variable [∀ g, DecidableEq (P g)]

noncomputable def fullMixedLedgerPathBornData
    (x : FullMixedLedgerState n (M := M) B)
    (p : FullMixedLedgerPath n S B A Δ D steps x)
    (a : FullMixedBirthAddress S B steps) : Option (FullMixedBornData n) :=
  let e := finiteEventPathOccurrence
    (fun tag (s : FullMixedLedgerState n (M := M) B) =>
      FullPermutationMixedEvent n S B A Δ D tag s.2)
    (fullMixedLedgerTarget n S B A Δ D) steps x p a.1
  fullMixedEventBornData n S B A Δ D (steps.get a.1) e.1.2 e.2 a.2

theorem full_mixed_ledger_path_born_data_local
    (x y : FullMixedLedgerState n (M := M) B)
    (p : FullMixedLedgerPath n S B A Δ D steps x)
    (q : FullMixedLedgerPath n S B A Δ D steps y)
    (a : FullMixedBirthAddress S B steps)
    (h : finiteEventPathOccurrence
      (fun tag (s : FullMixedLedgerState n (M := M) B) =>
        FullPermutationMixedEvent n S B A Δ D tag s.2)
      (fullMixedLedgerTarget n S B A Δ D) steps x p a.1 =
      finiteEventPathOccurrence
      (fun tag (s : FullMixedLedgerState n (M := M) B) =>
        FullPermutationMixedEvent n S B A Δ D tag s.2)
      (fullMixedLedgerTarget n S B A Δ D) steps y q a.1) :
    fullMixedLedgerPathBornData n S B A Δ D steps x p a =
      fullMixedLedgerPathBornData n S B A Δ D steps y q a := by
  unfold fullMixedLedgerPathBornData
  rw [h]

end Paths

end Bounty
end

section

/- Quantitative product-size bounds for the actual microscopic Q lists. -/

open Finset

namespace Bounty

theorem finite_dyadic_tail_le (S : Finset ℕ) (J : ℕ) (hS : ∀ j ∈ S, J ≤ j) :
    (∑ j ∈ S, (1 : ℝ)/2^j) ≤ 2/(2 : ℝ)^J := by
  have hsub : S ⊆ Ico J (S.sup id + 1) := by
    intro j hj
    exact mem_Ico.mpr ⟨hS j hj, Nat.lt_succ_of_le (le_sup (f := id) hj)⟩
  calc
    _ ≤ ∑ j ∈ Ico J (S.sup id + 1), (1 : ℝ)/2^j :=
      sum_le_sum_of_subset_of_nonneg hsub (fun _ _ _ => by positivity)
    _ = ∑ j ∈ Ico J (S.sup id + 1), (1/(2 : ℝ))^j := by simp only [one_div_pow]
    _ ≤ (1/(2 : ℝ))^J / (1-1/2) := geom_sum_Ico_le_of_lt_one
      (by norm_num : (0 : ℝ) ≤ 1/2) (by norm_num : (1/(2 : ℝ)) < 1)
    _ = _ := by rw [one_div_pow]; ring

theorem candidate_micro_Q_slot_upper (c L : ℝ) (r jStar J : ℕ)
    (slot : (candidateMicroQIndices c L J) × Fin r) {n : ℕ}
    (hn : n ∈ candidateMicroQSlotChoices c L r jStar J slot) :
    (n : ℝ) ≤ Real.exp ((6/5 : ℝ)*(c*L)/(2 : ℝ)^slot.1.val) := by
  unfold candidateMicroQSlotChoices at hn
  split_ifs at hn with hrough
  · have hnup := (Nat.cast_le.mpr (mem_Ioc.mp (mem_filter.mp hn).1).2).trans
      (Nat.floor_le (Real.exp_pos _).le)
    simpa only [candidateRoughBand, roughBand, hrough.1, mul_assoc] using hnup
  · exact ((mem_dyadicPrimeBand_iff (c*L) 1 (6/5) slot.1.val n).mp hn).2.2

theorem candidate_micro_Q_product_upper {c L : ℝ} (hcL : 0 ≤ c*L) (r jStar J : ℕ)
    (x : ∀ i, candidateMicroQSlotChoices c L r jStar J i) :
    (orderedSlotProduct (candidateMicroQSlotChoices c L r jStar J) x : ℝ) ≤
      Real.exp (((12/5 : ℝ)*(r : ℝ)*c/(2 : ℝ)^J)*L) := by
  have htail := finite_dyadic_tail_le (candidateMicroQIndices c L J) J
    (fun j hj => (mem_filter.mp hj).2)
  have hcoef : 0 ≤ (r : ℝ)*((6/5 : ℝ)*(c*L)) := by positivity
  have hsum : (∑ slot : (candidateMicroQIndices c L J) × Fin r,
      (6/5 : ℝ)*(c*L)/(2 : ℝ)^slot.1.val) ≤ ((12/5 : ℝ)*(r : ℝ)*c/(2 : ℝ)^J)*L := by
    rw [Fintype.sum_prod_type]
    simp only [sum_const, card_univ, Fintype.card_fin, nsmul_eq_mul]
    have he : (∑ j : candidateMicroQIndices c L J, (r : ℝ)*((6/5 : ℝ)*(c*L)/(2 : ℝ)^j.val)) =
        (r : ℝ)*((6/5 : ℝ)*(c*L)) * (∑ j ∈ candidateMicroQIndices c L J, (1 : ℝ)/2^j) := by
      rw [sum_coe_sort (candidateMicroQIndices c L J)
        (fun j : ℕ => (r : ℝ)*((6/5 : ℝ)*(c*L)/(2 : ℝ)^j)), mul_sum]
      apply sum_congr rfl
      intro j _
      ring
    rw [he]
    exact (mul_le_mul_of_nonneg_left htail hcoef).trans_eq (by ring)
  calc
    _ = ∏ i, ((x i).val : ℝ) := by simp only [orderedSlotProduct, Nat.cast_prod]
    _ ≤ ∏ i : (candidateMicroQIndices c L J) × Fin r,
        Real.exp ((6/5 : ℝ)*(c*L)/(2 : ℝ)^i.1.val) :=
      prod_le_prod₀ (fun _ _ => Nat.cast_nonneg _) (fun i _ => candidate_micro_Q_slot_upper c L r jStar J i (x i).property)
    _ = Real.exp (∑ i : (candidateMicroQIndices c L J) × Fin r,
        (6/5 : ℝ)*(c*L)/(2 : ℝ)^i.1.val) := (Real.exp_sum _ _).symm
    _ ≤ _ := Real.exp_le_exp.mpr hsum

end Bounty
end

section

/- The actual asymmetric comparison pairing only sees the tail averages
of both tests when its three coordinate sets lie in the active set.
This is an exact finite identity, with no positivity or norm assumptions. -/

open Finset Classical

namespace Bounty

theorem finite_asymmetric_comparison_pairing_tail_projection
    {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)]
    (μ : ∀ i, X i → ℝ) (hmass : ∀ i, ∑ v, μ i v = 1)
    (active A B : Finset I) (hA : A ⊆ active) (hB : B ⊆ active)
    (hμ : ∀ i ∈ active \ (A ∪ B), ∀ v, μ i v ≠ 0)
    (F : ∀ A B : Finset I, (∀ i : ↥(active \ (A ∪ B)), X i.val) →
      (∀ i : A, X i.val) → (∀ i : B, X i.val) → ℂ)
    (f g : (∀ i, X i) → ℂ) :
    cleanKernelPairing (finiteProductWeight μ) (finiteAsymmetricComparisonKernel μ active F A B) f g =
      cleanKernelPairing (finiteProductWeight μ) (finiteAsymmetricComparisonKernel μ active F A B)
        (finiteCoordinateComponent μ ∅ activeᶜ.toList f)
        (finiteCoordinateComponent μ ∅ activeᶜ.toList g) := by
  let H := finiteAsymmetricDensity μ (active \ (A ∪ B)) A B (F A B)
  have hkernel : finiteAsymmetricComparisonKernel μ active F A B =
      fun x y => (finiteProductWeight μ y : ℂ) * H x y := by
    funext x y
    exact finite_asymmetric_kernel_eq_density μ (active \ (A ∪ B)) A B hμ (F A B) x y
  have hleft (i : I) (hi : i ∈ activeᶜ) (x y : ∀ i, X i) (v : X i) :
      H (Function.update x i v) y = H x y := by
    have hia : i ∉ active := mem_compl.mp hi
    exact finite_asymmetric_density_update_left μ (active \ (A ∪ B)) A B (F A B) i
      (fun hs => hia (mem_sdiff.mp hs).1) (fun hb => hia (hB hb)) x y v
  have hright (i : I) (hi : i ∈ activeᶜ) (x y : ∀ i, X i) (v : X i) :
      H x (Function.update y i v) = H x y := by
    have hia : i ∉ active := mem_compl.mp hi
    exact finite_asymmetric_density_update_right μ (active \ (A ∪ B)) A B (F A B) i
      (fun hs => hia (mem_sdiff.mp hs).1) (fun ha => hia (hA ha)) x y v
  rw [← clean_kernel_component_pairing_sum μ activeᶜ activeᶜ
    (finiteProductWeight μ) (finiteAsymmetricComparisonKernel μ active F A B) f g]
  rw [sum_eq_single ∅]
  · rw [sum_eq_single ∅]
    · intro T hT hTne
      obtain ⟨i, hi⟩ := Finset.nonempty_iff_ne_empty.mpr hTne
      rw [hkernel]
      exact clean_kernel_component_zero_right μ hmass activeᶜ T (mem_powerset.mp hT) i hi
        (finiteProductWeight μ) H (finiteCoordinateComponent μ ∅ activeᶜ.toList f) g
        (hright i ((mem_powerset.mp hT) hi))
    · simp
  · intro S hS hSne
    obtain ⟨i, hi⟩ := Finset.nonempty_iff_ne_empty.mpr hSne
    apply sum_eq_zero
    intro T _
    rw [hkernel]
    apply clean_kernel_component_zero_left μ hmass activeᶜ S (mem_powerset.mp hS) i hi
      (fun x y => (finiteProductWeight μ y : ℂ) * H x y) f
      (finiteCoordinateComponent μ T activeᶜ.toList g)
    intro x y v
    rw [hleft i ((mem_powerset.mp hS) hi)]
  · simp

theorem finite_asymmetric_comparison_pairing_tail_projection_of_compl
    {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)]
    (μ : ∀ i, X i → ℝ) (hmass : ∀ i, ∑ v, μ i v = 1)
    (active tails A B : Finset I) (htails : tails = activeᶜ)
    (hA : A ⊆ active) (hB : B ⊆ active)
    (hμ : ∀ i ∈ active \ (A ∪ B), ∀ v, μ i v ≠ 0)
    (F : ∀ A B : Finset I, (∀ i : ↥(active \ (A ∪ B)), X i.val) →
      (∀ i : A, X i.val) → (∀ i : B, X i.val) → ℂ)
    (f g : (∀ i, X i) → ℂ) :
    cleanKernelPairing (finiteProductWeight μ) (finiteAsymmetricComparisonKernel μ active F A B) f g =
      cleanKernelPairing (finiteProductWeight μ) (finiteAsymmetricComparisonKernel μ active F A B)
        (finiteCoordinateComponent μ ∅ tails.toList f)
        (finiteCoordinateComponent μ ∅ tails.toList g) := by
  subst tails
  exact finite_asymmetric_comparison_pairing_tail_projection μ hmass active A B hA hB hμ F f g

end Bounty
end

section

/- The image of present birth addresses is the exact original birth-label batch. -/

open scoped Classical

namespace Bounty

section Images

variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
    (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
    (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)

noncomputable def fullMixedEventGroupBirthImage (tag : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag s) (g : Fin N) :
    Finset ((g : Fin N) × P g) :=
  Finset.univ.biUnion (fun i : Fin (fullMixedBirthCapacity S B tag g) =>
    (fullMixedEventBirthLabel n S B A Δ D tag s e ⟨g, i⟩).toFinset)

theorem full_mixed_ghost_group_birth_image (j : J)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (some (.inl j)) s) (g : Fin N) :
    fullMixedEventGroupBirthImage n S B A Δ D (some (.inl j)) s e g =
      Finset.univ.image (fun i : Fin (e.down g).1.val =>
        (⟨g, ((e.down g).2.2 i).1⟩ : (g : Fin N) × P g)) := by
  have hf : (fun i : Fin B =>
      fullMixedEventBirthLabel n S B A Δ D (some (.inl j)) s e ⟨g, i⟩) =
      (fun i : Fin B => if h : i.val < (e.down g).1.val then
        some (⟨g, ((e.down g).2.2 ⟨i.val, h⟩).1⟩ : (g : Fin N) × P g) else none) := by
    funext i
    simp only [fullMixedEventBirthLabel, fullMixedEventBornData]
    split_ifs <;> rfl
  unfold fullMixedEventGroupBirthImage
  change (Finset.univ.biUnion (fun i : Fin B =>
    (fullMixedEventBirthLabel n S B A Δ D (some (.inl j)) s e ⟨g, i⟩).toFinset)) = _
  simp_rw [congrFun hf]
  exact optional_prefix_birth_image B (e.down g).1.val
    (Nat.le_of_lt_succ (e.down g).1.isLt)
    (fun i : Fin (e.down g).1.val => (⟨g, ((e.down g).2.2 i).1⟩ : (g : Fin N) × P g))

theorem full_mixed_edge_group_birth_image (k : K)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent (J := J) n S B A Δ D (some (.inr k)) s) (g : Fin N) :
    fullMixedEventGroupBirthImage n S B A Δ D (some (.inr k)) s e g =
      Finset.univ.image (fun i : {i : Fin (S k g)ᶜ.card // i ∉ (e.2 g).2.1} =>
        (⟨g, (e.2 g).2.2.2 i⟩ : (g : Fin N) × P g)) := by
  have hf : (fun i : Fin (S k g)ᶜ.card =>
      fullMixedEventBirthLabel n S B A Δ D (some (.inr k)) s e ⟨g, i⟩) =
      (fun i : Fin (S k g)ᶜ.card => if h : i ∈ (e.2 g).2.1 then none
        else some (⟨g, (e.2 g).2.2.2 ⟨i, h⟩⟩ : (g : Fin N) × P g)) := by
    funext i
    simp only [fullMixedEventBirthLabel, fullMixedEventBornData]
    split_ifs with h h' h' <;> try rfl
    · exact (h' h).elim
    · exact (h h').elim
  unfold fullMixedEventGroupBirthImage
  change (Finset.univ.biUnion (fun i : Fin (S k g)ᶜ.card =>
    (fullMixedEventBirthLabel n S B A Δ D (some (.inr k)) s e ⟨g, i⟩).toFinset)) = _
  simp_rw [congrFun hf]
  exact optional_fresh_birth_image (e.2 g).2.1
    (fun i : {i : Fin (S k g)ᶜ.card // i ∉ (e.2 g).2.1} =>
      (⟨g, (e.2 g).2.2.2 i⟩ : (g : Fin N) × P g))

theorem mem_full_mixed_ghost_group_birth_image (j : J)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (some (.inl j)) s) (g : Fin N) (p : P g) :
    (⟨g, p⟩ : (g : Fin N) × P g) ∈
      fullMixedEventGroupBirthImage n S B A Δ D (some (.inl j)) s e g ↔
      ∃ i : Fin (e.down g).1.val, ((e.down g).2.2 i).1 = p := by
  rw [full_mixed_ghost_group_birth_image]
  simp only [Finset.mem_image, Finset.mem_univ, true_and, Sigma.mk.inj_iff, heq_eq_eq]

theorem mem_full_mixed_edge_group_birth_image (k : K)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent (J := J) n S B A Δ D (some (.inr k)) s)
    (g : Fin N) (p : P g) :
    (⟨g, p⟩ : (g : Fin N) × P g) ∈
      fullMixedEventGroupBirthImage n S B A Δ D (some (.inr k)) s e g ↔
      ∃ i : {i : Fin (S k g)ᶜ.card // i ∉ (e.2 g).2.1}, (e.2 g).2.2.2 i = p := by
  rw [full_mixed_edge_group_birth_image]
  simp only [Finset.mem_image, Finset.mem_univ, true_and, Sigma.mk.inj_iff, heq_eq_eq]

end Images

end Bounty
end

section

/- The original deterministic mixed ledger covers every currently carried label. -/

open Finset
open scoped Classical
namespace Bounty

theorem active_memory_split_covers {P : Type*} (n : P → ℕ) {M B : ℕ}
    (S : Finset (Fin M)) (H : Finset P)
    (x : BoundedOrderedState P (UnrestrictedResidueParticle n) M B)
    (hx : BoundedResidueLedgerCovers n H x) :
    BoundedResidueLedgerCovers n H (activeMemorySplit S B x).2 :=
  ⟨fun i => hx.1 (Sᶜ.equivFin.symm i).val, hx.2⟩

theorem active_memory_reassemble_covers {P : Type*} (n : P → ℕ) {M B : ℕ}
    (S : Finset (Fin M)) (H : Finset P) (c : Fin S.card → P)
    (x : BoundedOrderedState P (UnrestrictedResidueParticle n) Sᶜ.card B)
    (hc : ∀ i, c i ∈ H) (hx : BoundedResidueLedgerCovers n H x) :
    BoundedResidueLedgerCovers n H ((activeMemorySplit S B).symm (c, x)) := by
  constructor
  · intro i
    change (if h : i ∈ S then c (S.equivFin ⟨i, h⟩)
      else x.1 (Sᶜ.equivFin ⟨i, mem_compl.mpr h⟩)) ∈ H
    split_ifs
    · exact hc _
    · exact hx.1 _
  · exact hx.2

section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
  [∀ g, DecidableEq (P g)] (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ)

def FullMixedLedgerCovers (s : FullMixedLedgerState n (M := M) B) : Prop :=
  ∀ g, BoundedResidueLedgerCovers (n g) (s.1 g) (s.2 g)

theorem full_mixed_ledger_target_covers (tag : Option (J ⊕ K))
    (s : FullMixedLedgerState n (M := M) B)
    (e : FullPermutationMixedEvent n S B A Δ D tag s.2)
    (hs : FullMixedLedgerCovers n B s) :
    FullMixedLedgerCovers n B (fullMixedLedgerTarget n S B A Δ D tag s e) := by
  cases tag with
  | none =>
    intro g
    exact ⟨fun i => (hs g).1 (e.down g i), (hs g).2⟩
  | some tag =>
    cases tag with
    | inl j =>
      intro g
      exact bounded_ghost_ledger_target_covers (n g) (M g) B (s.1 g) (s.2 g)
        (e.down g) (hs g)
    | inr k =>
      intro g
      let u := unrestrictedBoundedEventTarget (n g)
        (Δ k (productActiveMemorySplit (S k) B s.2).1 e.1 g)
        (D k (productActiveMemorySplit (S k) B s.2).1 e.1 g)
        (S k g)ᶜ.card B ((productActiveMemorySplit (S k) B s.2).2 g) (e.2 g)
      have hledger : (fullMixedLedgerTarget n S B A Δ D (some (.inr k)) s e).1 g =
          s.1 g ∪ univ.image u.1 := by
        change fullEdgeLedgerUpdate n (S k) B (A k) (Δ k) (D k) s.1 s.2 e g = _
        unfold fullEdgeLedgerUpdate fullActiveEdgeEventTarget
        simp only [Equiv.apply_symm_apply]
        rfl
      rw [show BoundedResidueLedgerCovers (n g)
        ((fullMixedLedgerTarget n S B A Δ D (some (.inr k)) s e).1 g)
        ((fullMixedLedgerTarget n S B A Δ D (some (.inr k)) s e).2 g) =
          BoundedResidueLedgerCovers (n g) (s.1 g ∪ univ.image u.1)
          ((fullMixedLedgerTarget n S B A Δ D (some (.inr k)) s e).2 g) from
            congrArg (fun H => BoundedResidueLedgerCovers (n g) H
              ((fullMixedLedgerTarget n S B A Δ D (some (.inr k)) s e).2 g)) hledger]
      apply active_memory_reassemble_covers
      · intro i
        exact mem_union_left _ ((hs g).1 ((S k g).equivFin.symm i).val)
      · exact bounded_edge_ledger_target_covers (n g) _ _ _ B (s.1 g)
          ((productActiveMemorySplit (S k) B s.2).2 g) (e.2 g)
          (active_memory_split_covers (n g) (S k g) (s.1 g) (s.2 g) (hs g))

end Full

theorem finite_event_path_occurrence_invariant {K X : Type*}
    (E : K → X → Type*) (target : ∀ k x, E k x → X) (Q : X → Prop)
    (hstep : ∀ k x e, Q x → Q (target k x e)) :
    ∀ (steps : List K) (x : X) (p : FiniteEventPath E target steps x),
      Q x → ∀ i, Q (finiteEventPathOccurrence E target steps x p i).1 := by
  intro steps
  induction steps with
  | nil => intro x p hx i; exact Fin.elim0 i
  | cons k steps ih =>
    intro x p hx i
    refine Fin.cases ?_ (fun j => ?_) i
    · exact hx
    · exact ih (target k x p.1) p.2 (hstep k x p.1 hx) j

end Bounty
end

section

/- Ledger freshness and within-event distinctness give exact global distinctness. -/

namespace Bounty

theorem birth_ledger_freshness_iff {T Q : Type*} [DecidableEq Q]
    (owner : T → ℕ) (label : T → Option Q) (initial : Finset Q) (ledger : T → Finset Q)
    (hledger : ∀ a z, z ∈ ledger a ↔ z ∈ initial ∨
      ∃ b, owner b < owner a ∧ label b = some z) :
    ((∀ a z, label a = some z → z ∉ ledger a) ∧
      (∀ a b z, owner a = owner b → label a = some z → label b = some z → a = b)) ↔
    ((∀ a z, label a = some z → z ∉ initial) ∧
      (∀ a b z, label a = some z → label b = some z → a = b)) := by
  constructor
  · rintro ⟨hfresh, hbatch⟩
    constructor
    · intro a z haz hz
      exact hfresh a z haz ((hledger a z).mpr (Or.inl hz))
    · intro a b z haz hbz
      rcases lt_trichotomy (owner a) (owner b) with hab | hab | hab
      · exact False.elim (hfresh b z hbz ((hledger b z).mpr (Or.inr ⟨a, hab, haz⟩)))
      · exact hbatch a b z hab haz hbz
      · exact False.elim (hfresh a z haz ((hledger a z).mpr (Or.inr ⟨b, hab, hbz⟩)))
  · rintro ⟨havoid, hinj⟩
    constructor
    · intro a z haz hz
      rcases (hledger a z).mp hz with hz | ⟨b, hba, hbz⟩
      · exact havoid a z haz hz
      · have hab := hinj a b z haz hbz
        subst b
        exact Nat.lt_irrefl _ hba
    · intro a b z _ haz hbz
      exact hinj a b z haz hbz

end Bounty
end

section

/- Both initial and terminal physical mark masses stay close to one under the actual endpoint tilt. -/

open Finset
namespace Bounty

section Mass
variable {G : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ}
  (V : G → ℝ) {q : ℝ} (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (edges : ℕ)
  (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
  {P₀ : ℝ} (hP₀ : 0 < P₀) (hsize : 2 * (edges + 1 : ℝ) ≤ P₀)
  (hp : ∀ g (p : P g), P₀ ≤ (p.val : ℝ))

include hq0 hq1 hV hMass hP₀ hsize hp

omit [Fintype G] [DecidableEq G] in
theorem physical_endpoint_beta_mass_le (g : G) :
    (∑ p : P g, ((p.val : ℝ) * physicalEndpointBaseline q edges p.val)⁻¹ / V g) ≤
      1 + 2 * (edges + 1) / P₀ := by
  simp_rw [physical_endpoint_beta_law]
  exact tilted_linear_mass_le V g
    (fun _ => ∑ j ∈ range (edges + 1), (1 - physicalEndpointSchedule q edges j))
    (hV g) (hMass g) hP₀ (by positivity) hsize
    (fun _ => physical_endpoint_damping_sum_nonneg hq0 hq1 edges)
    (fun _ => physical_endpoint_damping_sum_le hq0 hq1 edges) (hp g)

omit [DecidableEq G] in
theorem physical_endpoint_terminal_mass_le (M : G → ℕ) :
    (∏ g, (∑ p : P g, ((p.val : ℝ) * physicalEndpointBaseline q edges p.val)⁻¹ / V g) ^ M g) ≤
      Real.exp ((2 * (edges + 1) / P₀) * ∑ g, (M g : ℝ)) := by
  apply (finite_product_powers_le_exp _ (fun _ => 2 * (edges + 1) / P₀) M ?_ ?_).trans_eq
    (congrArg Real.exp (mul_sum _ _ _).symm)
  · intro g
    apply sum_nonneg
    intro p hp'
    have hb := memory_baseline_bounds (physical_endpoint_damping_sum_nonneg hq0 hq1 edges)
      (hP₀.trans_le (hp g p)) (by
        calc
          2 * (∑ j ∈ range (edges + 1), (1 - physicalEndpointSchedule q edges j)) ≤
              2 * (edges + 1 : ℝ) := by
            linarith [physical_endpoint_damping_sum_le hq0 hq1 edges]
          _ ≤ (p.val : ℝ) := hsize.trans (hp g p))
    exact (div_pos (inv_pos.mpr (mul_pos (hP₀.trans_le (hp g p))
      (by change 0 < 1 - _; linarith [hb.1]))) (hV g)).le
  · exact fun g => physical_endpoint_beta_mass_le V hq0 hq1 edges hV hMass hP₀ hsize hp g

theorem physical_endpoint_initial_mass_le (J ell : ℕ) :
    physicalMarkMass (J := J) (ell := ell)
      (fun g (p : P g) => ((p.val : ℝ) * physicalEndpointBaseline q edges p.val)⁻¹ / V g) ≤
      Real.exp ((2 * (edges + 1) / P₀) * (Fintype.card G * (J + ell) : ℕ)) := by
  apply (physical_mark_mass_le _ ?_).trans
  · simpa only [sum_const, card_univ, nsmul_eq_mul, Nat.cast_mul, Nat.cast_add] using physical_endpoint_terminal_mass_le V hq0 hq1 edges hV hMass hP₀ hsize hp
      (fun _ => J + ell)
  · intro g p
    have hp0 : 0 < p.val := by exact_mod_cast hP₀.trans_le (hp g p)
    have hs : 2 * (edges + 1) ≤ p.val := by exact_mod_cast hsize.trans (hp g p)
    exact (physical_endpoint_beta_pos V q edges hq0 hq1 g (hV g) p hp0 hs).le

end Mass
end Bounty
end

section

/- Fixed parameter choices satisfying the two numerical gaps in the actual
clean prime-row power bound. These choices precede all kernel exponents. -/

namespace Bounty

/-- A fixed positive tail length and positive block density permit the exact
probe and accuracy margins required by the clean power theorem. -/
theorem exists_repeated_big_clean_parameters (ell : ℕ) (hell : 1 ≤ ell)
    (a E : ℝ) {beta : ℝ} (hbeta : 0 < beta) :
    ∃ (m : ℕ) (D : ℝ), ell ≤ m ∧ 0 ≤ D ∧
      beta * Real.log ((ell : ℝ) ^ ell / (m : ℝ) ^ ell) / 2 ≤ -(E + 2) ∧
      (m : ℝ) * a * Real.log 3 + E + 2 ≤ D := by
  have hE : 0 ≤ max E 0 + 1 := by have := le_max_right E 0; linarith
  obtain ⟨m, hm, _, _, hgap⟩ :=
    exists_repeated_big_probe_parameter ell hell hbeta hE
  refine ⟨m, max 0 ((m : ℝ) * a * Real.log 3 + E + 2), hm,
    le_max_left _ _, ?_, le_max_right _ _⟩
  have hE' : E ≤ max E 0 := le_max_left _ _
  linarith

end Bounty
end

section

/- The clean action lifted to all bounded ordered memory sectors.
The exact identities retain both adjacent full active-slot averages and
all occurrence residues; the displacement may depend on every big active
label and free auxiliary label as in the original clean action. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def cleanFullMemorySlice {G R : Type*} {P : G → Finset ℕ} {J ell B : ℕ}
    (f : CleanFullMemoryState P J ell B → R → ℂ)
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
    (source : RepeatedBigLists P J ell) (r : R × FixedOrderedResidues p) : ℂ :=
  f (cleanFullMemoryState N p source r.2) r.1

noncomputable def cleanFullMemoryLift {G R : Type*} {P : G → Finset ℕ} {J ell B : ℕ}
    (A : ∀ (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val)),
      (RepeatedBigLists P J ell → (R × FixedOrderedResidues p) → ℂ) →
        RepeatedBigLists P J ell → (R × FixedOrderedResidues p) → ℂ)
    (f : CleanFullMemoryState P J ell B → R → ℂ)
    (x : CleanFullMemoryState P J ell B) (r : R) : ℂ :=
  let c := cleanFullMemoryEquiv P J ell B x
  A c.1 c.2.1 (cleanFullMemorySlice f c.1 c.2.1) c.2.2.1 (r, c.2.2.2)

theorem clean_full_memory_lift_slice {G R : Type*} {P : G → Finset ℕ} {J ell B : ℕ}
    (A : ∀ (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val)),
      (RepeatedBigLists P J ell → (R × FixedOrderedResidues p) → ℂ) →
        RepeatedBigLists P J ell → (R × FixedOrderedResidues p) → ℂ)
    (f : CleanFullMemoryState P J ell B → R → ℂ)
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val)) :
    cleanFullMemorySlice (cleanFullMemoryLift A f) N p = A N p (cleanFullMemorySlice f N p) := by
  funext source r
  have hc : cleanFullMemoryEquiv P J ell B (cleanFullMemoryState N p source r.2) =
      ⟨N, p, source, r.2⟩ :=
    (cleanFullMemoryEquiv P J ell B).apply_symm_apply ⟨N, p, source, r.2⟩
  unfold cleanFullMemorySlice cleanFullMemoryLift
  rw [hc]
  rfl

theorem clean_full_memory_slice_ext {G R : Type*} {P : G → Finset ℕ} {J ell B : ℕ}
    {f g : CleanFullMemoryState P J ell B → R → ℂ}
    (h : ∀ (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun j => (N j).val)),
      cleanFullMemorySlice f N p = cleanFullMemorySlice g N p) : f = g := by
  funext x r
  let c := cleanFullMemoryEquiv P J ell B x
  have he := congrFun (congrFun (h c.1 c.2.1) c.2.2.1) (r, c.2.2.2)
  change f ((cleanFullMemoryEquiv P J ell B).symm c) r =
    g ((cleanFullMemoryEquiv P J ell B).symm c) r at he
  simpa only [c, Equiv.symm_apply_apply] using he

noncomputable def cleanFullMemoryActiveMap {G R : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell B : ℕ} (f : CleanFullMemoryState P J ell B → R → ℂ)
    (x : CleanFullMemoryState P J ell B) (r : R) : ℂ :=
  fullActiveAverage (fun y => f y r) x

theorem clean_full_memory_active_map_slice {G R : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell B : ℕ} (f : CleanFullMemoryState P J ell B → R → ℂ)
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val)) :
    cleanFullMemorySlice (cleanFullMemoryActiveMap f) N p =
      cleanActiveMap repeatedBigSymmetrizeLinear (cleanFullMemorySlice f N p) := by
  funext source r
  exact clean_full_memory_active_average N p (fun x => f x r.1) source r.2

noncomputable def cleanFullMemoryPatternDampedAction {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell B : ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : I → G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ)
    (K : ∀ i, RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb (C i) → ℂ)
    (d : PhysicalSharedLists Ps J) :
    (CleanFullMemoryState Pb J ell B → PhysicalResidues Ps → ℂ) →
      CleanFullMemoryState Pb J ell B → PhysicalResidues Ps → ℂ :=
  cleanFullMemoryLift (fun _ p => cleanHybridPatternDampedAction Vb b C ζ θ ρ k (fun _ => B) p K d)

theorem clean_full_memory_pattern_damped_apply {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell B : ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : I → G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ)
    (K : ∀ i, RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb (C i) → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : CleanFullMemoryState Pb J ell B → PhysicalResidues Ps → ℂ)
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels Pb (fun g => (N g).val))
    (source : RepeatedBigLists Pb J ell) (rs : PhysicalResidues Ps) (rm : FixedOrderedResidues p) :
    cleanFullMemoryPatternDampedAction Vb b C ζ θ ρ k K d f
        (cleanFullMemoryState N p source rm) rs =
      ∑ i, ∑ aux, ∑ target,
        (cleanHybridBetweenKernel Vb b (C i) ζ θ ρ k (fun _ => B) p rm (K i) d aux source target *
          physicalPhase ζ (physicalSharedProduct d)) *
        f (cleanFullMemoryState N p target
          (fixedOrderedResidueTranslate p rm (cleanHybridStep k (C i) source aux d)))
          (physicalTranslateResidues rs (cleanHybridStep k (C i) source aux d)) := by
  exact congrFun (congrFun (clean_full_memory_lift_slice
    (fun _ p => cleanHybridPatternDampedAction Vb b C ζ θ ρ k (fun _ => B) p K d) f N p)
      source) (rs, rm)

theorem clean_full_memory_projected_damped_slice {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell B : ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : I → G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ)
    (K : ∀ i, RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb (C i) → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : CleanFullMemoryState Pb J ell B → PhysicalResidues Ps → ℂ)
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels Pb (fun g => (N g).val)) :
    cleanFullMemorySlice
      (cleanFullMemoryActiveMap (cleanFullMemoryPatternDampedAction Vb b C ζ θ ρ k K d
        (cleanFullMemoryActiveMap f))) N p =
      cleanResidueWeightMap (fun r => cleanMemoryInputWeight ρ p r.2)
        (cleanActiveMap repeatedBigSymmetrizeLinear (cleanHybridPatternCoreAction Vb b C ζ θ k p K d
          (cleanActiveMap repeatedBigSymmetrizeLinear
            (cleanResidueWeightMap (fun r => cleanMemoryOutputWeight ρ (fun _ => B) p r.2)
              (cleanFullMemorySlice f N p))))) := by
  rw [clean_full_memory_active_map_slice]
  unfold cleanFullMemoryPatternDampedAction
  rw [clean_full_memory_lift_slice, clean_full_memory_active_map_slice]
  exact clean_hybrid_projected_damped_factorization Vb b C ζ θ ρ k (fun _ => B) p K d
    repeatedBigSymmetrizeLinear (cleanFullMemorySlice f N p)

theorem clean_full_memory_projected_damped_lift {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell B : ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : I → G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ)
    (K : ∀ i, RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb (C i) → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : CleanFullMemoryState Pb J ell B → PhysicalResidues Ps → ℂ) :
    cleanFullMemoryActiveMap (cleanFullMemoryPatternDampedAction Vb b C ζ θ ρ k K d
        (cleanFullMemoryActiveMap f)) =
      cleanFullMemoryLift (fun _ p v => cleanActiveMap repeatedBigSymmetrizeLinear
        (cleanHybridPatternDampedAction Vb b C ζ θ ρ k (fun _ => B) p K d
          (cleanActiveMap repeatedBigSymmetrizeLinear v))) f := by
  apply clean_full_memory_slice_ext
  intro N p
  rw [clean_full_memory_active_map_slice, cleanFullMemoryPatternDampedAction,
    clean_full_memory_lift_slice, clean_full_memory_active_map_slice, clean_full_memory_lift_slice]

end Bounty
end

section

/- The omitted Q bands have factorial-normalized product weight at most one. -/

open Finset

namespace Bounty

theorem candidate_macro_Q_weight_le_one {c L : ℝ} (hcL : 0 ≤ c*L) (r J n : ℕ) :
    orderedSlotWeight (fun i : (candidateMacroQIndices c L J) × Fin r =>
      candidateQBand (c*L) i.1.val) ((r.factorial : ℝ)^(candidateMacroQIndices c L J).card) n ≤ 1 := by
  have hdisj : Pairwise (fun i j : candidateMacroQIndices c L J =>
      Disjoint (candidateQBand (c*L) i.val) (candidateQBand (c*L) j.val)) := by
    intro i j hij
    exact pairwise_disjoint_dyadicPrimeBand hcL (by norm_num) (by norm_num)
      (fun h => hij (Subtype.ext h))
  simpa only [Fintype.card_coe] using grouped_prime_slot_weight_le_one
    (fun j : candidateMacroQIndices c L J => candidateQBand (c*L) j.val) r
    (fun _ _ hp => (mem_filter.mp hp).2) hdisj n

theorem candidate_micro_Q_product_pos (c L : ℝ) (r jStar J : ℕ)
    (x : ∀ i, candidateMicroQSlotChoices c L r jStar J i) :
    0 < orderedSlotProduct (candidateMicroQSlotChoices c L r jStar J) x := by
  apply Nat.pos_of_ne_zero
  apply prod_ne_zero_iff.mpr
  intro slot _
  exact candidate_Q_slot_nonzero c L r jStar
    (⟨slot.1.val, (mem_filter.mp slot.1.property).1⟩, slot.2) (x slot).property

theorem candidate_macro_Q_no_small_prime {c L z : ℝ} {r J : ℕ}
    (hz : ∀ j ∈ candidateMacroQIndices c L J, ∀ p ∈ candidateQBand (c*L) j, z < (p : ℝ))
    (y : ∀ i : (candidateMacroQIndices c L J) × Fin r, candidateQBand (c*L) i.1.val)
    {p : ℕ} (hp : p.Prime) (hpz : (p : ℝ) ≤ z) :
    ¬ p ∣ orderedSlotProduct (fun i : (candidateMacroQIndices c L J) × Fin r =>
      candidateQBand (c*L) i.1.val) y := by
  intro hdiv
  obtain ⟨i, _, hi⟩ := ((Nat.prime_iff.mp hp).dvd_finsetProd_iff (fun i => (y i).val)).mp hdiv
  have hyprime : (y i).val.Prime := (mem_filter.mp (y i).property).2
  have heq : p = (y i).val := ((Nat.dvd_prime hyprime).mp hi).resolve_left hp.ne_one
  have hlarge := hz i.1.val i.1.property (y i).val (y i).property
  exact (not_lt_of_ge hpz) (heq.symm ▸ hlarge)

end Bounty
end

section

/- Prime marks are distinct and their product divides every marked integer. -/

open Finset

namespace Bounty

theorem chosen_mark_set_prime {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (hprime : ∀ g p, p ∈ P g → p.Prime) (x : ∀ g, P g) :
    ∀ p ∈ chosenMarkSet P x, p.Prime := by
  intro p hp
  obtain ⟨g, _, rfl⟩ := mem_image.mp hp
  exact hprime g _ (x g).property

theorem chosen_mark_product {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h))) (x : ∀ g, P g) :
    (∏ p ∈ chosenMarkSet P x, p) = orderedSlotProduct P x := by
  unfold chosenMarkSet orderedSlotProduct
  rw [prod_image]
  intro a _ b _ hab
  exact chosen_mark_injective P hdisj x hab

theorem chosen_mark_product_primeFactors {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h))) (x : ∀ g, P g) :
    (orderedSlotProduct P x).primeFactors = chosenMarkSet P x := by
  rw [← chosen_mark_product P hdisj x, Nat.primeFactors_prod (chosen_mark_set_prime P hprime x)]

theorem chosen_mark_product_dvd {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h))) (x : ∀ g, P g)
    (u : ℕ) (hx : ∀ g, (x g).val ∣ u) : orderedSlotProduct P x ∣ u := by
  rw [← chosen_mark_product P hdisj x]
  apply prod_primes_dvd u
  · intro p hp
    exact Nat.prime_iff.mp (chosen_mark_set_prime P hprime x p hp)
  · intro p hp
    obtain ⟨g, _, rfl⟩ := mem_image.mp hp
    exact hx g

theorem chosen_mark_product_ne_zero {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (hprime : ∀ g p, p ∈ P g → p.Prime) (x : ∀ g, P g) : orderedSlotProduct P x ≠ 0 := by
  exact prod_ne_zero_iff.mpr (fun g _ => (hprime g _ (x g).property).ne_zero)

theorem chosen_mark_product_support {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h))) (x : ∀ g, P g) :
    (orderedSlotProduct P x).primeFactors ⊆ univ.biUnion P := by
  rw [chosen_mark_product_primeFactors P hprime hdisj x]
  intro p hp
  obtain ⟨g, _, rfl⟩ := mem_image.mp hp
  exact mem_biUnion.mpr ⟨g, mem_univ _, (x g).property⟩

end Bounty
end

section

/- A pinned original birth slot costs its actual atom, with the other samples left free. -/

open Finset Classical

namespace Bounty

section Edge
variable {P : Type*} [Fintype P] [DecidableEq P] (n : P → ℕ) (Δ D : ℤ) (μ : P → ℝ)
    (ρ V : ℝ) (t B : ℕ) (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (stores promotions : Finset (Fin t))
    (e : promotions ↪ ↥(unrestrictedResidueEligible n Δ D s.2.2))
    (i : {j : Fin t // j ∉ promotions}) (p : P)
    (F : ({j : {j : Fin t // j ∉ promotions} // j ≠ i} → P) → ℝ)

theorem unrestricted_bounded_fresh_slot_sum :
    (∑ fresh : UnrestrictedFreshLabels P promotions, if fresh i = p then
      unrestrictedBoundedEventWeight n Δ D μ ρ V t B s ⟨stores, promotions, e, fresh⟩ *
        F (fun j => fresh j.1) else 0) =
      μ p * (unrestrictedBoundedSkeletonMass n Δ D ρ V t B s stores promotions e *
        ∑ fresh : {j : {j : Fin t // j ∉ promotions} // j ≠ i} → P,
          (∏ j, μ (fresh j)) * F fresh) := by
  simp_rw [unrestricted_bounded_event_fresh_factor, unrestrictedFreshWeight]
  simpa only [id_eq, sum_ite_eq', mem_univ, if_true] using
    independent_coordinate_atom_factor_mul i μ id p
      (unrestrictedBoundedSkeletonMass n Δ D ρ V t B s stores promotions e) F

theorem unrestricted_bounded_fresh_slot_le (hρ : 0 ≤ ρ) (hV : 0 ≤ V)
    (hμ : ∀ p, 0 ≤ μ p) (hF : ∀ f, 0 ≤ F f) {ε : ℝ} (hatom : μ p ≤ ε) :
    (∑ fresh : UnrestrictedFreshLabels P promotions, if fresh i = p then
      unrestrictedBoundedEventWeight n Δ D μ ρ V t B s ⟨stores, promotions, e, fresh⟩ *
        F (fun j => fresh j.1) else 0) ≤
      ε * (unrestrictedBoundedSkeletonMass n Δ D ρ V t B s stores promotions e *
        ∑ fresh : {j : {j : Fin t // j ∉ promotions} // j ≠ i} → P,
          (∏ j, μ (fresh j)) * F fresh) := by
  rw [unrestricted_bounded_fresh_slot_sum]
  exact mul_le_mul_of_nonneg_right hatom (mul_nonneg
    (unrestricted_bounded_skeleton_mass_nonneg n Δ D ρ V hρ hV t B s stores promotions e)
    (sum_nonneg fun f _ => mul_nonneg (prod_nonneg fun j _ => hμ _) (hF f)))

end Edge

section Ghost
variable {P : Type*} [Fintype P] [DecidableEq P] (n : P → ℕ) [∀ p, NeZero (n p)]
    (μ : P → ℝ) (q ρ V : ℝ) (t B : ℕ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (b : Fin (B + 1)) (retained : Finset (Fin s.2.1.val)) (i : Fin b.val) (p : P)
    (F : ({j : Fin b.val // j ≠ i} → UnrestrictedResidueParticle n) → ℝ)

theorem bounded_physical_ghost_slot_sum (hμ : ∀ p, 0 ≤ μ p) :
    (∑ births : Fin b.val → UnrestrictedResidueParticle n, if (births i).1 = p then
      |boundedGhostEventWeight (physicalGhostRetention n q ρ) (physicalGhostTermination n q ρ)
        (physicalGhostBirth n q ρ V) (unrestrictedResidueWeight μ)
        t B s ⟨b, retained, births⟩| * F (fun j => births j.1) else 0) =
      (|(1 - q) * V / ρ| * μ p) *
        (boundedGhostSkeletonAbsMass (physicalGhostRetention n q ρ)
          (physicalGhostTermination n q ρ) t B s b retained *
          ∑ births : {j : Fin b.val // j ≠ i} → UnrestrictedResidueParticle n,
            (∏ j, physicalGhostBirthAtom n μ q ρ V (births j)) * F births) := by
  simp_rw [bounded_ghost_event_abs_factor (physicalGhostRetention n q ρ)
    (physicalGhostTermination n q ρ) (physicalGhostBirth n q ρ V)
    (unrestrictedResidueWeight μ) (fun z : UnrestrictedResidueParticle n => hμ z.1)
    t B s b retained]
  change (∑ births : Fin b.val → UnrestrictedResidueParticle n, if (births i).1 = p then
    (_ * ∏ j, physicalGhostBirthAtom n μ q ρ V (births j)) * F (fun j => births j.1)
      else 0) = _
  rw [independent_coordinate_atom_factor_mul, physical_ghost_birth_atom_prime_sum]

theorem bounded_physical_ghost_slot_le (hμ : ∀ p, 0 ≤ μ p)
    (hF : ∀ f, 0 ≤ F f) {ε : ℝ} (hatom : |(1 - q) * V / ρ| * μ p ≤ ε) :
    (∑ births : Fin b.val → UnrestrictedResidueParticle n, if (births i).1 = p then
      |boundedGhostEventWeight (physicalGhostRetention n q ρ) (physicalGhostTermination n q ρ)
        (physicalGhostBirth n q ρ V) (unrestrictedResidueWeight μ)
        t B s ⟨b, retained, births⟩| * F (fun j => births j.1) else 0) ≤
      ε * (boundedGhostSkeletonAbsMass (physicalGhostRetention n q ρ)
        (physicalGhostTermination n q ρ) t B s b retained *
        ∑ births : {j : Fin b.val // j ≠ i} → UnrestrictedResidueParticle n,
          (∏ j, physicalGhostBirthAtom n μ q ρ V (births j)) * F births) := by
  rw [bounded_physical_ghost_slot_sum n μ q ρ V t B s b retained i p F hμ]
  exact mul_le_mul_of_nonneg_right hatom (mul_nonneg
    (bounded_ghost_skeleton_abs_mass_nonneg _ _ t B s b retained)
    (sum_nonneg fun f _ => mul_nonneg
      (prod_nonneg fun j _ => physical_ghost_birth_atom_nonneg n μ q ρ V hμ _) (hF f)))

end Ghost

end Bounty
end

section

/- Freshness and distinctness predicates on the actual local optional birth labels. -/

namespace Bounty
section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ)

def FullMixedLocalBirthAvoids (H : (g : Fin N) → Finset (P g))
    (tag : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag s) : Prop :=
  ∀ a z, fullMixedEventBirthLabel n S B A Δ D tag s e a = some z → z.2 ∉ H z.1

def FullMixedLocalBirthDistinct (tag : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag s) : Prop :=
  ∀ a b z, fullMixedEventBirthLabel n S B A Δ D tag s e a = some z →
    fullMixedEventBirthLabel n S B A Δ D tag s e b = some z → a = b

theorem full_mixed_ghost_local_label (j : J)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (some (.inl j)) s)
    (g : Fin N) (i : Fin B) (hi : i.val < (e.down g).1.val) :
    fullMixedEventBirthLabel n S B A Δ D (some (.inl j)) s e ⟨g, i⟩ =
      some ⟨g, ((e.down g).2.2 ⟨i.val, hi⟩).1⟩ := by
  unfold fullMixedEventBirthLabel
  rw [full_mixed_ghost_born_data n S B A Δ D j s e g i hi]
  rfl

theorem full_mixed_ghost_local_label_some (j : J)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (some (.inl j)) s)
    (g : Fin N) (i : Fin B) (z : (g : Fin N) × P g)
    (hz : fullMixedEventBirthLabel n S B A Δ D (some (.inl j)) s e ⟨g, i⟩ = some z) :
    ∃ hi : i.val < (e.down g).1.val, z = ⟨g, ((e.down g).2.2 ⟨i.val, hi⟩).1⟩ := by
  by_cases hi : i.val < (e.down g).1.val
  · rw [full_mixed_ghost_local_label n S B A Δ D j s e g i hi] at hz
    exact ⟨hi, (Option.some.inj hz).symm⟩
  · simp only [fullMixedEventBirthLabel, fullMixedEventBornData, dif_neg hi,
      Option.map_none] at hz
    cases hz

theorem full_mixed_edge_local_label (k : K)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent (J := J) n S B A Δ D (some (.inr k)) s)
    (g : Fin N) (i : Fin (S k g)ᶜ.card) (hi : i ∉ (e.2 g).2.1) :
    fullMixedEventBirthLabel n S B A Δ D (some (.inr k)) s e ⟨g, i⟩ =
      some ⟨g, (e.2 g).2.2.2 ⟨i, hi⟩⟩ := by
  unfold fullMixedEventBirthLabel
  rw [full_mixed_edge_born_data n S B A Δ D k s e g i hi]
  rfl

theorem full_mixed_edge_local_label_some (k : K)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent (J := J) n S B A Δ D (some (.inr k)) s)
    (g : Fin N) (i : Fin (S k g)ᶜ.card) (z : (g : Fin N) × P g)
    (hz : fullMixedEventBirthLabel n S B A Δ D (some (.inr k)) s e ⟨g, i⟩ = some z) :
    ∃ hi : i ∉ (e.2 g).2.1, z = ⟨g, (e.2 g).2.2.2 ⟨i, hi⟩⟩ := by
  by_cases hi : i ∈ (e.2 g).2.1
  · simp only [fullMixedEventBirthLabel, fullMixedEventBornData] at hz
    split_ifs at hz with h
    · cases hz
    · exact (h hi).elim
  · rw [full_mixed_edge_local_label n S B A Δ D k s e g i hi] at hz
    exact ⟨hi, (Option.some.inj hz).symm⟩

end Full
end Bounty
end

section

/- Exact clean joint-event extraction, with the total memory cutoff retained. -/

open Finset
open scoped Classical

namespace Bounty

theorem product_memory_coordinate_actions_eq {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (A C : ∀ g, (BoundedOrderedState (P g) (Z g) (t g) B → ℂ) →
      BoundedOrderedState (P g) (Z g) (t g) B → ℂ)
    (hAC : ∀ g f, BoundedOrderedSymmetric f → A g f = C g f)
    (groups : Finset G) (f : ProductBoundedOrderedState P Z t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteCoordinateFinsetAction A groups f = finiteCoordinateFinsetAction C groups f := by
  rw [← product_memory_projected_finset_eq A groups f hf,
    ← product_memory_projected_finset_eq C groups f hf]
  have he : (fun g h => A g (boundedMemorySymmetrize h)) =
      (fun g h => C g (boundedMemorySymmetrize h)) := by
    funext g h
    exact hAC g _ (boundedMemorySymmetrize_symmetric h)
  rw [he]

noncomputable def unrestrictedBoundedCleanFactor {P : Type*} (n : P → ℕ)
    (Δ : ℤ) (ρ : ℝ) {t B : ℕ}
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B) : ℝ :=
  ρ ^ orderedPredicateCount (boundedOrderedTupleToFinite s.2) unrestrictedResidueHit *
    ρ ^ orderedPredicateCount
      (boundedOrderedTupleToFinite (unrestrictedBoundedCleanTarget n Δ s s.1).2)
        unrestrictedResidueHit

theorem unrestricted_product_clean_event_sum {G : Type*} [Fintype G] [dG : DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (Δ D : G → ℤ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (t : G → ℕ) (B : ℕ)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) :
    (∑ e : UnrestrictedJointEvent n Δ D t B s,
      (∏ g, (if (e g).1 = ∅ ∧ (e g).2.1 = ∅ then
        unrestrictedBoundedEventWeight (n g) (Δ g) (D g) (μ g) ρ (V g) (t g) B (s g) (e g)
        else 0 : ℝ) : ℂ) * f (unrestrictedJointEventTarget n Δ D t B s e)) =
      (∏ g, (unrestrictedBoundedCleanFactor (n g) (Δ g) ρ (s g) : ℂ)) *
        ∑ target : (∀ g, Fin (t g) → P g),
          (∏ g, (∏ j, μ g (target g j) : ℝ) : ℂ) *
            f (fun g => unrestrictedBoundedCleanTarget (n g) (Δ g) (s g) (target g)) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  let E := fun g => UnrestrictedBoundedEvent (n g) (Δ g) (D g) (t g) B
  let w := fun g x (e : E g x) => if e.1 = ∅ ∧ e.2.1 = ∅ then
    unrestrictedBoundedEventWeight (n g) (Δ g) (D g) (μ g) ρ (V g) (t g) B x e else 0
  let z := fun g => unrestrictedBoundedEventTarget (n g) (Δ g) (D g) (t g) B
  let E' := fun g (_ : BoundedOrderedState (P g) (UnrestrictedResidueParticle (n g)) (t g) B) =>
    Fin (t g) → P g
  let w' := fun g x (target : E' g x) => unrestrictedBoundedCleanFactor (n g) (Δ g) ρ x *
    ∏ j, μ g (target j)
  let z' := fun g x (target : E' g x) => unrestrictedBoundedCleanTarget (n g) (Δ g) x target
  have hlocal : ∀ g h, BoundedOrderedSymmetric h →
      finiteLocalEventAction E w z g h = finiteLocalEventAction E' w' z' g h := by
    intro g h hh
    funext x
    have he := unrestricted_bounded_clean_event_sum (n g) (Δ g) (D g) (μ g) ρ (V g)
      (t g) B (fun _ => 1) h hh x
    change (∑ e : E g x, (w g x e : ℂ) * h (z g x e)) = _
    calc
      _ = ∑ e : UnrestrictedBoundedEvent (n g) (Δ g) (D g) (t g) B x,
          (unrestrictedBoundedEventWeight (n g) (Δ g) (D g) (μ g) ρ (V g) (t g) B x e : ℂ) *
            (if e.1 = ∅ ∧ e.2.1 = ∅ then 1 else 0) * h (z g x e) := by
        apply sum_congr rfl
        intro e _
        dsimp only [w]
        split_ifs <;> simp
      _ = _ := by
        rw [he]
        simp only [finiteLocalEventAction, w', z', unrestrictedBoundedCleanFactor,
          Complex.ofReal_mul, mul_one, mul_sum, mul_assoc]
        apply sum_congr
        · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
        · intro a _
          rfl
  have he := congrFun ((finite_product_event_eq_coordinate_action E w z f).trans
    ((product_memory_coordinate_actions_eq (finiteLocalEventAction E w z)
      (finiteLocalEventAction E' w' z') hlocal univ f hf).trans
      (finite_product_event_eq_coordinate_action E' w' z' f).symm)) s
  simp only [finiteProductEventAction, mul_one, w, z, E, E', w', z',
    Complex.ofReal_prod, Complex.ofReal_mul, prod_mul_distrib, mul_sum, mul_assoc] at he ⊢
  refine Eq.trans ?_ (he.trans ?_)
  all_goals
    apply sum_congr
    · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
    · intro a _
      rfl

end Bounty
end

section

/- The displacement read from canonical shared-coordinate fibers is exactly
the physical displacement in the clean kernel. No source-dependent step is
postulated: all of its big shared factors are recovered from the fiber. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def cleanFullSharedD {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (c : SharedActiveLabels (fun g => P g) (cleanFullSharedSlots (ell := ell) C))
    (aux : PhysicalAuxLabels P C) : ℕ :=
  ∏ g, ((∏ j, (c g j).val) * ∏ j : C g, (aux g j).val)

noncomputable def cleanFullSharedStep {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell : ℕ}
    (k : ℤ) (C : G → Finset (Fin J))
    (c : SharedActiveLabels (fun g => P g) (cleanFullSharedSlots (ell := ell) C))
    (aux : PhysicalAuxLabels P C) (d : PhysicalSharedLists Ps J) : ℤ :=
  (k * (cleanFullSharedD C c aux : ℤ)) * (physicalSharedProduct d : ℤ)

theorem cleanFullShared_label_product {G : Type*} {P : G → Finset ℕ}
    {J ell : ℕ} (C : G → Finset (Fin J)) (source : RepeatedBigLists P J ell) (g : G) :
    (∏ j : Fin (cleanFullSharedSlots (ell := ell) C g).card,
      (source g (finSumFinEquiv.symm
        (((cleanFullSharedSlots C g).equivFin.symm j).val))).val) =
      ∏ j ∈ univ \ C g, (source g (Sum.inl j)).val := by
  calc
    _ = ∏ j : cleanFullSharedSlots (ell := ell) C g,
        (source g (finSumFinEquiv.symm j.val)).val :=
      Equiv.prod_comp (cleanFullSharedSlots C g).equivFin.symm
        (fun j => (source g (finSumFinEquiv.symm j.val)).val)
    _ = ∏ j ∈ cleanFullSharedSlots (ell := ell) C g,
        (source g (finSumFinEquiv.symm j)).val :=
      prod_coe_sort (cleanFullSharedSlots (ell := ell) C g)
        (fun j => (source g (finSumFinEquiv.symm j)).val)
    _ = _ := by
      simp only [cleanFullSharedSlots, physicalSharedSlots, prod_map,
        Equiv.toEmbedding_apply, Equiv.symm_apply_apply, Function.Embedding.inl_apply]

theorem cleanFullSharedD_split {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell B : ℕ} (C : G → Finset (Fin J))
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
    (source : RepeatedBigLists P J ell) (r : FixedOrderedResidues p)
    (aux : PhysicalAuxLabels P C) :
    cleanFullSharedD C
      (productActiveMemorySplit (cleanFullSharedSlots C) B
        (cleanFullMemoryState N p source r)).1 aux = repeatedBigD C source aux := by
  unfold cleanFullSharedD repeatedBigD
  apply prod_congr rfl
  intro g _
  congr 1
  exact cleanFullShared_label_product C source g

theorem cleanFullSharedStep_split {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    (k : ℤ) (C : G → Finset (Fin J))
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
    (source : RepeatedBigLists P J ell) (r : FixedOrderedResidues p)
    (aux : PhysicalAuxLabels P C) (d : PhysicalSharedLists Ps J) :
    cleanFullSharedStep k C
      (productActiveMemorySplit (cleanFullSharedSlots C) B
        (cleanFullMemoryState N p source r)).1 aux d =
      cleanHybridStep k C source aux d := by
  rw [cleanFullSharedStep, cleanFullSharedD_split, cleanHybridStep]

end Bounty
end

section

/- The full coupled ghost coefficient factors over the reconstructed birth coordinates. -/

open Finset Classical

namespace Bounty

noncomputable def coupledGhostSkeletonAbsMass {G : Type*} [Fintype G]
    {P Z : G → Type*} (A D : ∀ g, Z g → ℝ) (t : G → ℕ) (B : ℕ)
    (s : ProductBoundedOrderedState P Z t B) (sk : CoupledGhostSkeleton t B s) : ℝ :=
  if productTotalMemory s ≤ B ∧
      (∑ g, boundedGhostSkeletonOutputCount (t g) B (s g) (sk g).1 (sk g).2) ≤ B then
    ∏ g, boundedGhostSkeletonAbsMass (A g) (D g) (t g) B (s g) (sk g).1 (sk g).2
  else 0

theorem coupled_ghost_skeleton_abs_mass_nonneg {G : Type*} [Fintype G]
    {P Z : G → Type*} (A D : ∀ g, Z g → ℝ) (t : G → ℕ) (B : ℕ)
    (s : ProductBoundedOrderedState P Z t B) (sk : CoupledGhostSkeleton t B s) :
    0 ≤ coupledGhostSkeletonAbsMass A D t B s sk := by
  unfold coupledGhostSkeletonAbsMass
  split_ifs
  · exact prod_nonneg fun g _ => bounded_ghost_skeleton_abs_mass_nonneg _ _ _ _ _ _ _
  · exact le_rfl

theorem coupled_ghost_skeleton_weight_factor {G : Type*} [Fintype G]
    {P Z : G → Type*} (A D C ν : ∀ g, Z g → ℝ) (hν : ∀ g z, 0 ≤ ν g z)
    (t : G → ℕ) (B : ℕ) (s : ProductBoundedOrderedState P Z t B)
    (sk : CoupledGhostSkeleton t B s) (births : CoupledGhostSamples t B s sk) :
    |coupledGhostJointEventWeight A D C ν t B s
      ((coupledGhostSkeletonEquiv t B s).symm ⟨sk, births⟩)| =
      coupledGhostSkeletonAbsMass A D t B s sk *
        ∏ i : CoupledGhostSampleIndex t B s sk, |C i.1 (births i)| * ν i.1 (births i) := by
  unfold coupledGhostJointEventWeight coupledGhostSkeletonAbsMass
  rw [coupled_ghost_skeleton_target_memory]
  split_ifs
  · rw [abs_prod, Fintype.prod_sigma]
    change (∏ g, |boundedGhostEventWeight (A g) (D g) (C g) (ν g) (t g) B (s g)
      ⟨(sk g).1, (sk g).2, fun j => births ⟨g, j⟩⟩|) = _
    simp_rw [bounded_ghost_event_abs_factor _ _ _ _ (hν _)]
    exact prod_mul_distrib
  · simp only [abs_zero, zero_mul]

end Bounty
end

section

/- The full edge coefficient retains its auxiliary draw, both caps and all fresh coordinates. -/

open Finset Classical

namespace Bounty

section Full
variable {G : Type*} [Fintype G] {P : G → Type*} (n : ∀ g, P g → ℕ)
    {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : SharedActiveLabels P S → Type*) (Δ D : ∀ c, A c → G → ℤ)
    (ω : ∀ c, A c → ℝ) (ρ : ℝ) (V : G → ℝ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (sk : FullActiveEdgeSkeleton n S B A Δ D s)

noncomputable def fullActiveEdgeSkeletonAbsMass : ℝ :=
  let c := (productActiveMemorySplit S B s).1
  let r := (productActiveMemorySplit S B s).2
  |ω c sk.1| * (if productTotalMemory r ≤ B ∧
      (∑ g, unrestrictedSkeletonOutputCount (n g) (Δ c sk.1 g) (D c sk.1 g)
        (S g)ᶜ.card B (r g) (sk.2 g)) ≤ B then
    ∏ g, |unrestrictedBoundedSkeletonMass (n g) (Δ c sk.1 g) (D c sk.1 g)
      ρ (V g) (S g)ᶜ.card B (r g) (sk.2 g).1 (sk.2 g).2.1 (sk.2 g).2.2|
  else 0)

theorem full_active_edge_skeleton_abs_mass_nonneg :
    0 ≤ fullActiveEdgeSkeletonAbsMass n S B A Δ D ω ρ V s sk := by
  unfold fullActiveEdgeSkeletonAbsMass
  apply mul_nonneg (abs_nonneg _)
  split_ifs
  · exact prod_nonneg fun g _ => abs_nonneg _
  · exact le_rfl

theorem full_active_edge_skeleton_target_memory
    (fresh : FullActiveEdgeSamples n S B A Δ D s sk) :
    productTotalMemory (unrestrictedJointEventTarget n
      (Δ (productActiveMemorySplit S B s).1 sk.1)
      (D (productActiveMemorySplit S B s).1 sk.1) (fun g => (S g)ᶜ.card) B
      (productActiveMemorySplit S B s).2
      ((fullActiveEdgeSkeletonEquiv n S B A Δ D s).symm ⟨sk, fresh⟩).2) =
      ∑ g, unrestrictedSkeletonOutputCount (n g)
        (Δ (productActiveMemorySplit S B s).1 sk.1 g)
        (D (productActiveMemorySplit S B s).1 sk.1 g)
        (S g)ᶜ.card B ((productActiveMemorySplit S B s).2 g) (sk.2 g) := by
  apply sum_congr rfl
  intro g _
  exact unrestricted_bounded_skeleton_target_count _ _ _ _ _ _ _ _

theorem full_active_edge_skeleton_weight_factor (μ : ∀ g, P g → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (fresh : FullActiveEdgeSamples n S B A Δ D s sk) :
    |fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V s
      ((fullActiveEdgeSkeletonEquiv n S B A Δ D s).symm ⟨sk, fresh⟩)| =
      fullActiveEdgeSkeletonAbsMass n S B A Δ D ω ρ V s sk *
        ∏ i : FullActiveEdgeSampleIndex n S B A Δ D s sk, μ i.1 (fresh i) := by
  unfold fullActiveEdgeEventWeight unrestrictedJointCutoffEventWeight
  change |ω (productActiveMemorySplit S B s).1 sk.1 *
    (if productTotalMemory (productActiveMemorySplit S B s).2 ≤ B ∧
      productTotalMemory (unrestrictedJointEventTarget n
        (Δ (productActiveMemorySplit S B s).1 sk.1)
        (D (productActiveMemorySplit S B s).1 sk.1) (fun g => (S g)ᶜ.card) B
        (productActiveMemorySplit S B s).2
        ((fullActiveEdgeSkeletonEquiv n S B A Δ D s).symm ⟨sk, fresh⟩).2) ≤ B then _ else 0)| = _
  rw [full_active_edge_skeleton_target_memory]
  unfold fullActiveEdgeSkeletonAbsMass
  dsimp only
  rw [abs_mul]
  split_ifs
  · rw [abs_prod, Fintype.prod_sigma]
    change |ω (productActiveMemorySplit S B s).1 sk.1| *
      (∏ g, |unrestrictedBoundedEventWeight (n g)
        (Δ (productActiveMemorySplit S B s).1 sk.1 g)
        (D (productActiveMemorySplit S B s).1 sk.1 g) (μ g) ρ (V g) (S g)ᶜ.card B
        ((productActiveMemorySplit S B s).2 g)
        ⟨(sk.2 g).1, (sk.2 g).2.1, (sk.2 g).2.2, fun j => fresh ⟨g, j⟩⟩|) = _
    simp_rw [unrestricted_bounded_event_fresh_factor]
    simp_rw [abs_mul, abs_of_nonneg (unrestrictedFreshWeight_nonneg _ _ (hμ _) _)]
    rw [prod_mul_distrib, mul_assoc]
    rfl
  · simp only [abs_zero, mul_zero, zero_mul]

end Full

end Bounty
end

section

/- The skeleton equivalences reconstruct exactly the original mixed events and their targets. -/

namespace Bounty

section Mixed
variable {J K G : Type*} {P : G → Type*} (n : ∀ g, P g → ℕ)
    {M : G → ℕ} (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → G → ℤ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)

noncomputable def fullPermutationGhostBirthEquiv (j : J) :
    FullPermutationMixedEvent n S B A Δ D (some (.inl j)) s ≃
      (sk : CoupledGhostSkeleton M B s) × CoupledGhostSamples M B s sk :=
  Equiv.ulift.trans (coupledGhostSkeletonEquiv M B s)

noncomputable def fullPermutationEdgeBirthEquiv (k : K) :
    FullPermutationMixedEvent (J := J) n S B A Δ D (some (.inr k)) s ≃
      (sk : FullActiveEdgeSkeleton n (S k) B (A k) (Δ k) (D k) s) ×
        FullActiveEdgeSamples n (S k) B (A k) (Δ k) (D k) s sk :=
  fullActiveEdgeSkeletonEquiv n (S k) B (A k) (Δ k) (D k) s

theorem full_permutation_ghost_skeleton_target (j : J)
    (sk : CoupledGhostSkeleton M B s) (births : CoupledGhostSamples M B s sk) :
    fullPermutationMixedEventTarget n S B A Δ D (some (.inl j)) s
      ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩) =
      coupledGhostJointEventTarget M B s ((coupledGhostSkeletonEquiv M B s).symm ⟨sk, births⟩) := rfl

theorem full_permutation_edge_skeleton_target (k : K)
    (sk : FullActiveEdgeSkeleton n (S k) B (A k) (Δ k) (D k) s)
    (fresh : FullActiveEdgeSamples n (S k) B (A k) (Δ k) (D k) s sk) :
    fullPermutationMixedEventTarget (J := J) n S B A Δ D (some (.inr k)) s
      ((fullPermutationEdgeBirthEquiv (J := J) n S B A Δ D s k).symm ⟨sk, fresh⟩) =
      fullActiveEdgeEventTarget n (S k) B (A k) (Δ k) (D k) s
        ((fullActiveEdgeSkeletonEquiv n (S k) B (A k) (Δ k) (D k) s).symm ⟨sk, fresh⟩) := rfl

theorem full_permutation_ghost_skeleton_weight [Fintype G] [DecidableEq G]
    (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)
    (j : J) (sk : CoupledGhostSkeleton M B s) (births : CoupledGhostSamples M B s sk) :
    fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V (some (.inl j)) s
      ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩) =
      coupledGhostJointEventWeight
        (fun g => physicalGhostRetention (n g) (q j) ρ)
        (fun g => physicalGhostTermination (n g) (q j) ρ)
        (fun g => physicalGhostBirth (n g) (q j) ρ (V g))
        (fun g => unrestrictedResidueWeight (μ g)) M B s
        ((coupledGhostSkeletonEquiv M B s).symm ⟨sk, births⟩) := rfl

theorem full_permutation_edge_skeleton_weight [Fintype G] [DecidableEq G]
    (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)
    (k : K) (sk : FullActiveEdgeSkeleton n (S k) B (A k) (Δ k) (D k) s)
    (fresh : FullActiveEdgeSamples n (S k) B (A k) (Δ k) (D k) s sk) :
    fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V (some (.inr k)) s
      ((fullPermutationEdgeBirthEquiv (J := J) n S B A Δ D s k).symm ⟨sk, fresh⟩) =
      fullActiveEdgeEventWeight n (S k) B (A k) (Δ k) (D k) (ω k) μ ρ V s
        ((fullActiveEdgeSkeletonEquiv n (S k) B (A k) (Δ k) (D k) s).symm ⟨sk, fresh⟩) := rfl

end Mixed

end Bounty
end

section

/- Explicit conversion between canonical first/tail coordinates and the
physical pattern-dependent slot enumeration. The permutation depends only
on the cut, and every ordered pending-memory coordinate is untouched. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def cleanPhysicalSlotChange {G : Type*} {J ell : ℕ}
    (C : G → Finset (Fin J)) : FullActiveSlotPermutations (fun _ : G => J + ell) :=
  fun g => (physicalFullSlotIndex (C g)).trans finSumFinEquiv

theorem clean_physical_slot_change_shared {G : Type*} {J ell : ℕ}
    (C : G → Finset (Fin J)) (g : G) (i : Fin (J + ell)) :
    cleanPhysicalSlotChange C g i ∈ cleanFullSharedSlots C g ↔
      i ∈ physicalFullSharedIndices (C g) := by
  change finSumFinEquiv (physicalFullSlotIndex (C g) i) ∈ cleanFullSharedSlots C g ↔ _
  simpa only [cleanFullSharedSlots, mem_map_equiv, Equiv.symm_apply_apply] using
    physical_full_slot_index_shared_iff (C g) i

theorem clean_physical_repeated_encoding {G : Type*} {P : G → Finset ℕ}
    {Z : G → Type*} {J ell B : ℕ} (C : G → Finset (Fin J))
    (source : RepeatedBigLists P J ell) (q : ∀ g, BoundedOrderedTuple (Z g) B) :
    fullActivePermutation (cleanPhysicalSlotChange C)
      (fun g => (fun j => source g (finSumFinEquiv.symm j), q g)) =
      (fun g => (fun j => source g (physicalFullSlotIndex (C g) j), q g)) := by
  funext g
  apply Prod.ext
  · funext j
    change source g (finSumFinEquiv.symm (finSumFinEquiv
      (physicalFullSlotIndex (C g) j))) = _
    rw [Equiv.symm_apply_apply]
  · rfl

theorem clean_physical_repeated_weight {G : Type*} [Fintype G] {P : G → Finset ℕ}
    {Z : G → Type*} {J ell B : ℕ} (C : G → Finset (Fin J))
    (source : RepeatedBigLists P J ell) (q : ∀ g, BoundedOrderedTuple (Z g) B)
    (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ) :
    productMemoryWeight μ ν
      (fun g => (fun j => source g (physicalFullSlotIndex (C g) j), q g)) =
      productMemoryWeight μ ν
        (fun g => (fun j => source g (finSumFinEquiv.symm j), q g)) := by
  rw [← clean_physical_repeated_encoding C source q]
  exact fullActivePermutation_weight μ ν (cleanPhysicalSlotChange C) _

theorem clean_physical_repeated_average {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {Z : G → Type*} {J ell B : ℕ}
    (C : G → Finset (Fin J)) (source : RepeatedBigLists P J ell)
    (q : ∀ g, BoundedOrderedTuple (Z g) B)
    (F : ProductBoundedOrderedState (fun g => ↥(P g)) Z (fun _ => J + ell) B → ℂ) :
    fullActiveAverage F
      (fun g => (fun j => source g (physicalFullSlotIndex (C g) j), q g)) =
      fullActiveAverage F
        (fun g => (fun j => source g (finSumFinEquiv.symm j), q g)) := by
  rw [← clean_physical_repeated_encoding C source q]
  exact fullActiveAverage_invariant F (cleanPhysicalSlotChange C) _

theorem clean_full_memory_physical_encoding {G : Type*} {P : G → Finset ℕ}
    {J ell B : ℕ} (C : G → Finset (Fin J))
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
    (source : RepeatedBigLists P J ell) (r : FixedOrderedResidues p) :
    fullActivePermutation (cleanPhysicalSlotChange C) (cleanFullMemoryState N p source r) =
      (fun g => (fun j => source g (physicalFullSlotIndex (C g) j),
        (⟨N g, fun j => ⟨p g j, r g j⟩⟩ :
          BoundedOrderedTuple (UnrestrictedResidueParticle (fun q : P g => q.val)) B))) :=
  clean_physical_repeated_encoding C source _

theorem clean_full_memory_physical_mark_encoding {G : Type*} {P : G → Finset ℕ}
    {J ell B : ℕ} (C : G → Finset (Fin J))
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
    (L : PhysicalMarkLists P J ell) (r : FixedOrderedResidues p) :
    fullActivePermutation (cleanPhysicalSlotChange C)
      (cleanFullMemoryState N p (fun g => L g) r) =
      physicalFullMemoryState C L (fun g =>
        (⟨N g, fun j => ⟨p g j, r g j⟩⟩ :
          BoundedOrderedTuple (UnrestrictedResidueParticle (fun q : P g => q.val)) B)) :=
  clean_full_memory_physical_encoding C N p (fun g => L g) r

theorem clean_full_memory_physical_average {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell B : ℕ} (C : G → Finset (Fin J))
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
    (L : PhysicalMarkLists P J ell) (r : FixedOrderedResidues p)
    (F : CleanFullMemoryState P J ell B → ℂ) :
    fullActiveAverage F (physicalFullMemoryState C L (fun g =>
      (⟨N g, fun j => ⟨p g j, r g j⟩⟩ :
        BoundedOrderedTuple (UnrestrictedResidueParticle (fun q : P g => q.val)) B))) =
      fullActiveAverage F (cleanFullMemoryState N p (fun g => L g) r) := by
  rw [← clean_full_memory_physical_mark_encoding C N p L r]
  exact fullActiveAverage_invariant F (cleanPhysicalSlotChange C) _

/-- Conjugate any full-state operator by the two explicit encoding changes.
The source and target patterns may differ. -/
noncomputable def cleanPhysicalReencodeOperator {G : Type*} {P Z : G → Type*}
    {J ell B : ℕ} (C D : G → Finset (Fin J))
    (T : (ProductBoundedOrderedState P Z (fun _ => J + ell) B → ℂ) →
      ProductBoundedOrderedState P Z (fun _ => J + ell) B → ℂ)
    (f : ProductBoundedOrderedState P Z (fun _ => J + ell) B → ℂ)
    (x : ProductBoundedOrderedState P Z (fun _ => J + ell) B) : ℂ :=
  T (fun y => f ((fullActivePermutation (cleanPhysicalSlotChange D)).symm y))
    (fullActivePermutation (cleanPhysicalSlotChange C) x)

theorem clean_physical_reencode_average_sandwich {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} {J ell B : ℕ} (C D : G → Finset (Fin J))
    (T : (ProductBoundedOrderedState P Z (fun _ => J + ell) B → ℂ) →
      ProductBoundedOrderedState P Z (fun _ => J + ell) B → ℂ)
    (f : ProductBoundedOrderedState P Z (fun _ => J + ell) B → ℂ) :
    fullActiveAverage (cleanPhysicalReencodeOperator C D T (fullActiveAverage f)) =
      fullActiveAverage (T (fullActiveAverage f)) := by
  exact fullActiveAverage_operator_permutation_sandwich T
    (cleanPhysicalSlotChange C) (fun g => (cleanPhysicalSlotChange D g).symm) f

end Bounty
end

section

/- The unchanged endpoint sum and source-injectivity extension preserve the birth factor. -/

open Finset
open scoped Classical
namespace Bounty
section Physical
variable {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin N → Finset (Fin J)) (k : ℤ)
  (H : (g : Fin N) → Finset ↥(P g))
  (ω : ∀ _c : SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C g)), PhysicalAuxLabels P C → ℝ)
  (μ : (g : Fin N) → ↥(P g) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

theorem physical_full_endpoint_birth_factor (L : PhysicalMarkLists P J ell)
    (q : (g : Fin N) → BoundedOrderedTuple
      (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B)
    (e : PhysicalFullEdgeEvent C k (physicalFullMemoryState C L q)) :
    physicalFullEndpointPhase C k L H q ω μ ρ V e =
      (if (∀ g i, (e.2 g).2.2.2 i ∉ H g) ∧
          (∀ g, Function.Injective (e.2 g).2.2.2) then 1 else 0) *
        physicalFullEndpointPhase C k L (fun _ => ∅) q ω μ ρ V e := by
  unfold physicalFullEndpointPhase
  by_cases hw : fullActiveEdgeEventWeight (fun g (p : ↥(P g)) => p.val)
      (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
      (fun _ => PhysicalAuxLabels P C) (physicalFullEdgeDelta C k) (physicalFullEdgeD C)
      ω μ ρ V (physicalFullMemoryState C L q) e = 0
  · simp only [if_pos hw, mul_zero]
  · simp only [if_neg hw]
    calc
      _ = ∑ R : PhysicalMarkLists P J ell,
          (if (∀ g i, (e.2 g).2.2.2 i ∉ H g) ∧
              (∀ g, Function.Injective (e.2 g).2.2.2) then (1 : ℂ) else 0) *
            physicalFullEdgePhase C k L R (fun _ => ∅) q e :=
        sum_congr rfl (fun R _ => physical_full_edge_phase_birth_factor C k L R H q e)
      _ = _ := (mul_sum _ _ _).symm

theorem physical_full_global_birth_factor (x : PhysicalFullBoundedState P J ell B)
    (e : PhysicalFullEdgeEvent C k x) :
    physicalFullGlobalEdgePhase C k H ω μ ρ V x e =
      (if (∀ g i, (e.2 g).2.2.2 i ∉ H g) ∧
          (∀ g, Function.Injective (e.2 g).2.2.2) then 1 else 0) *
        physicalFullGlobalEdgePhase C k (fun _ => ∅) ω μ ρ V x e := by
  have hencoded (L : PhysicalMarkLists P J ell)
      (q : (g : Fin N) → BoundedOrderedTuple
        (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B)
      (e : PhysicalFullEdgeEvent C k (physicalFullMemoryState C L q)) :
      physicalFullGlobalEdgePhase C k H ω μ ρ V (physicalFullMemoryState C L q) e =
        (if (∀ g i, (e.2 g).2.2.2 i ∉ H g) ∧
            (∀ g, Function.Injective (e.2 g).2.2.2) then 1 else 0) *
          physicalFullGlobalEdgePhase C k (fun _ => ∅) ω μ ρ V (physicalFullMemoryState C L q) e := by
    rw [physical_full_global_edge_phase_encode, physical_full_global_edge_phase_encode]
    exact physical_full_endpoint_birth_factor C k H ω μ ρ V L q e
  by_cases hx : FullActiveInjective x
  · have h := hencoded (physicalFullStateLabels C x hx) (fun g => (x g).2)
    rw [physical_full_state_encode_labels C x hx] at h
    exact h e
  · simp only [physicalFullGlobalEdgePhase, dif_neg hx, mul_zero]

end Physical
end Bounty
end

section

/- Converting microscopic harmonic masses into the actual candidate window mass. -/

open Filter

namespace Bounty

theorem harmonic_mass_normalization {P Q H A C K T : ℝ}
    (hP : 1 ≤ P) (hH : 0 ≤ H) (hC : 0 ≤ C) (hK : 0 < K) (hT : 0 < T)
    (hmicro : H ≤ C*Q) (hmass : K*T*P*Q ≤ A) :
    P*H ≤ (C/(K*T))*A ∧ H ≤ (C/(K*T))*A := by
  have hprod : P*Q ≤ A/(K*T) := by
    apply (le_div_iff₀ (mul_pos hK hT)).mpr
    nlinarith only [hmass]
  have hmain : P*H ≤ (C/(K*T))*A := by
    calc
      P*H ≤ P*(C*Q) := mul_le_mul_of_nonneg_left hmicro (by linarith)
      _ = C*(P*Q) := by ring
      _ ≤ C*(A/(K*T)) := mul_le_mul_of_nonneg_left hprod hC
      _ = _ := by ring
  exact ⟨hmain, (le_mul_of_one_le_left hH hP).trans hmain⟩

theorem exists_candidate_micro_mass_normalization {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ)*(r : ℝ)*c = 1) (J : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∃ J0 : ℕ, J ≤ J0 ∧
      ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, J0 < jStar →
        candidateOneMarkedHarmonicMass c L q * candidateMicroQHarmonicMass c L r jStar J ≤
          C*(L/Real.exp L)*candidateCoefficientWindowMass c L q r jStar ∧
        candidateMicroQHarmonicMass c L r jStar J ≤
          C*(L/Real.exp L)*candidateCoefficientWindowMass c L q r jStar := by
  obtain ⟨Cm, hCm, hmicro⟩ := exists_candidate_micro_Q_harmonic_comparison hc r J
  obtain ⟨Klo, Khi, hKlo, _, Jlo, hmass⟩ :=
    exists_candidate_coefficient_window_mass_comparison hc hr hq0 hq1 hcenter
  refine ⟨Cm/Klo, div_pos hCm hKlo, max J Jlo, le_max_left _ _, ?_⟩
  filter_upwards [hmicro, hmass, eventually_candidate_one_marked_mass_ge_one hc hq0 hq1.le,
    eventually_gt_atTop (0 : ℝ)] with L hm hmassL hP hL
  intro jStar hj
  have hjJ : J ≤ jStar := le_trans (le_max_left _ _) (Nat.le_of_lt hj)
  have hjlo : Jlo < jStar := lt_of_le_of_lt (le_max_right _ _) hj
  have h := harmonic_mass_normalization hP (candidate_micro_Q_harmonic_nonneg c L r jStar J)
    hCm.le hKlo (div_pos (Real.exp_pos _) hL) (hm jStar hjJ) (hmassL jStar hjlo).1
  have heq : Cm/(Klo*(Real.exp L/L)) = (Cm/Klo)*(L/Real.exp L) := by
    field_simp
  simpa only [heq] using h

end Bounty
end

section

/- Compatible dyadic pairs occupy only a bounded number of second-coordinate indices. -/

open Finset

namespace Bounty

def dyadicPairIndices (S : Finset (ℕ × ℕ)) : Finset (ℕ × ℕ) :=
  S.image (fun v => (v.1.log2, v.2.log2))

def dyadicPairBucket (S : Finset (ℕ × ℕ)) (k : ℕ × ℕ) : Finset (ℕ × ℕ) :=
  S.filter (fun v => (v.1.log2, v.2.log2) = k)

theorem sum_dyadic_pair_buckets (S : Finset (ℕ × ℕ)) (w : ℕ × ℕ → ℝ) :
    (∑ k ∈ dyadicPairIndices S, ∑ v ∈ dyadicPairBucket S k, w v) = ∑ v ∈ S, w v := by
  exact sum_fiberwise_of_maps_to (fun v hv => mem_image_of_mem _ hv) w

theorem dyadic_pair_index_log_bounds {L : ℝ} {v : ℕ × ℕ}
    (hm : 0 < v.1) (hn : 0 < v.2)
    (hlo : Real.exp L ≤ ((v.1*v.2 : ℕ) : ℝ))
    (hhi : ((v.1*v.2 : ℕ) : ℝ) ≤ 33*Real.exp L) :
    L/Real.log 2-2 < (v.1.log2 : ℝ)+(v.2.log2 : ℝ) ∧
      (v.1.log2 : ℝ)+(v.2.log2 : ℝ) ≤ (L+Real.log 33)/Real.log 2 := by
  have h2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hmR : (0 : ℝ) < v.1 := Nat.cast_pos.mpr hm
  have hnR : (0 : ℝ) < v.2 := Nat.cast_pos.mpr hn
  have hmB := dyadic_log2_real_bounds hm
  have hnB := dyadic_log2_real_bounds hn
  have hloglo := Real.log_le_log (Real.exp_pos L) hlo
  have hloghi := Real.log_le_log (by positivity : (0 : ℝ) < ((v.1*v.2 : ℕ) : ℝ)) hhi
  simp only [Real.log_exp, Nat.cast_mul, Real.log_mul hmR.ne' hnR.ne'] at hloglo hloghi
  rw [Real.log_mul (by norm_num : (33 : ℝ) ≠ 0) (Real.exp_pos L).ne', Real.log_exp] at hloghi
  have hl := div_le_div_of_nonneg_right hloglo h2.le
  have hu := div_le_div_of_nonneg_right hloghi h2.le
  simp only [add_div] at hl hu ⊢
  constructor <;> linarith

theorem dyadic_pair_second_diameter (S : Finset (ℕ × ℕ)) {L : ℝ}
    (hS : ∀ v ∈ S, 0 < v.1 ∧ 0 < v.2 ∧ Real.exp L ≤ ((v.1*v.2 : ℕ) : ℝ) ∧
      ((v.1*v.2 : ℕ) : ℝ) ≤ 33*Real.exp L)
    {k l : ℕ × ℕ} (hk : k ∈ dyadicPairIndices S) (hl : l ∈ dyadicPairIndices S)
    (hfirst : k.1 = l.1) : k.2 ≤ l.2+8 := by
  obtain ⟨v, hv, rfl⟩ := mem_image.mp hk
  obtain ⟨w, hw, rfl⟩ := mem_image.mp hl
  obtain ⟨hv1, hv2, hvlo, hvhi⟩ := hS v hv
  obtain ⟨hw1, hw2, hwlo, hwhi⟩ := hS w hw
  have hV := dyadic_pair_index_log_bounds hv1 hv2 hvlo hvhi
  have hW := dyadic_pair_index_log_bounds hw1 hw2 hwlo hwhi
  have hlog33 : Real.log 33 < 6*Real.log 2 := by
    have h := Real.log_lt_log (by norm_num : (0 : ℝ) < 33) (by norm_num : (33 : ℝ) < 2^6)
    rw [Real.log_pow] at h
    norm_num at h ⊢
    exact h
  have h2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hquot : Real.log 33/Real.log 2 < 6 := (div_lt_iff₀ h2).mpr hlog33
  simp only [add_div] at hV hW
  change v.1.log2 = w.1.log2 at hfirst
  rw [hfirst] at hV
  have hR : (v.2.log2 : ℝ) ≤ (w.2.log2 : ℝ)+8 := by linarith
  exact_mod_cast hR

end Bounty
end

section

/- A genuine weighted row bound for the original bounded ghost event sum. -/

open Finset Classical

namespace Bounty

theorem bounded_ghost_length_row_le {P Z : Type*} [Fintype Z]
    (A D C ν : Z → ℝ) (v : ℝ) (hA : ∀ z, 0 ≤ A z) (hν : ∀ z, 0 ≤ ν z)
    (hv : 0 ≤ v) (hdamp : ∀ z, A z * v + |D z| ≤ v)
    (t B : ℕ) (s : BoundedOrderedState P Z t B) :
    (∑ e : BoundedGhostEvent t B s, |boundedGhostEventWeight A D C ν t B s e| *
      v ^ (boundedGhostEventTarget t B s e).2.1.val) ≤
      Real.exp ((∑ z, |C z| * ν z) * v) * v ^ s.2.1.val := by
  have hmass : 0 ≤ ∑ z, |C z| * ν z :=
    sum_nonneg fun z _ => mul_nonneg (abs_nonneg _) (hν z)
  calc
    _ ≤ ∑ b : Fin (B + 1), ∑ r : Finset (Fin s.2.1.val), ∑ births : Fin b.val → Z,
      (((∏ i ∈ r, A (s.2.2 i)) * (∏ i ∈ univ \ r, |D (s.2.2 i)|)) *
        (∏ i, |C (births i)| * ν (births i)) / (b.val.factorial : ℝ)) * v ^ (r.card + b.val) := by
          simp only [Fintype.sum_sigma, Fintype.sum_prod_type]
          apply sum_le_sum
          intro b _
          apply sum_le_sum
          intro r _
          apply sum_le_sum
          intro births _
          rw [boundedGhostEventWeight_abs A D C ν hA hν]
          by_cases h : r.card + b.val ≤ B
          · simp only [boundedGhostEventWeight, h, if_true,
              bounded_ghost_target_count, boundedGhostSkeletonOutputCount]
            exact le_rfl
          · simp only [boundedGhostEventWeight, h, if_false, zero_mul]
            exact mul_nonneg (div_nonneg
              (mul_nonneg (mul_nonneg (prod_nonneg fun i _ => hA _)
                (prod_nonneg fun i _ => abs_nonneg _))
                (prod_nonneg fun i _ => mul_nonneg (abs_nonneg _) (hν _)))
              (Nat.cast_nonneg _)) (pow_nonneg hv _)
    _ = (∏ i, (A (s.2.2 i) * v + |D (s.2.2 i)|)) *
        ∑ b ∈ range (B + 1), ((∑ z, |C z| * ν z) * v) ^ b / (b.factorial : ℝ) :=
      ghost_uncut_length_sum A D C ν v t B s
    _ ≤ (∏ i, (A (s.2.2 i) * v + |D (s.2.2 i)|)) *
        Real.exp ((∑ z, |C z| * ν z) * v) :=
      mul_le_mul_of_nonneg_left (Real.sum_le_exp_of_nonneg (mul_nonneg hmass hv) _)
        (prod_nonneg fun i _ => add_nonneg (mul_nonneg (hA _) hv) (abs_nonneg _))
    _ ≤ v ^ s.2.1.val * Real.exp ((∑ z, |C z| * ν z) * v) := by
      apply mul_le_mul_of_nonneg_right _ (Real.exp_pos _).le
      rw [← Fin.prod_const]
      exact prod_le_prod₀ (fun i _ => add_nonneg (mul_nonneg (hA _) hv) (abs_nonneg _))
        (fun i _ => hdamp _)
    _ = _ := mul_comm _ _

end Bounty
end

section

/- Supported original occurrences have adjacent states and their original observations. -/

namespace Bounty
section Paths
variable {K X O : Type*} (E : K → X → Type*) (target : ∀ k x, E k x → X)

theorem finite_event_local_phase_supported_invariant
    (phase : ∀ k x, E k x → ℂ) (Q : X → Prop)
    (hstep : ∀ k x e, Q x → phase k x e ≠ 0 → Q (target k x e))
    (steps : List K) (x : X) (p : FiniteEventPath E target steps x)
    (hx : Q x) (hp : finiteEventLocalPhase E target phase steps x p ≠ 0)
    (i : Fin steps.length) :
    Q (finiteEventPathOccurrence E target steps x p i).1 ∧
      Q (target (steps.get i) (finiteEventPathOccurrence E target steps x p i).1
        (finiteEventPathOccurrence E target steps x p i).2) := by
  induction steps generalizing x with
  | nil => exact Fin.elim0 i
  | cons k steps ih =>
    rcases p with ⟨e, p⟩
    have hboth := mul_ne_zero_iff.mp hp
    have hnext := hstep k x e hx hboth.1
    refine Fin.cases ?_ (fun j => ?_) i
    · exact ⟨hx, hnext⟩
    · exact ih (target k x e) p hnext hboth.2 j

theorem finite_event_occurrence_source_after
    (steps : List K) (x : X) (p : FiniteEventPath E target steps x)
    (i : ℕ) (hi : i + 1 < steps.length) :
    (finiteEventPathOccurrence E target steps x p ⟨i + 1, hi⟩).1 =
      target (steps.get ⟨i, by omega⟩)
        (finiteEventPathOccurrence E target steps x p ⟨i, by omega⟩).1
        (finiteEventPathOccurrence E target steps x p ⟨i, by omega⟩).2 := by
  induction steps generalizing x i with
  | nil => simp only [List.length_nil] at hi; omega
  | cons k steps ih =>
    rcases p with ⟨e, p⟩
    cases i with
    | zero =>
      cases steps with
      | nil => simp only [List.length_cons, List.length_nil] at hi; omega
      | cons l steps => rfl
    | succ i => exact ih (target k x e) p i (by simp only [List.length_cons] at hi; omega)

theorem finite_event_observations_get
    (observe : ∀ k x, E k x → O)
    (steps : List K) (x : X) (p : FiniteEventPath E target steps x)
    (i : ℕ) (hi : i < steps.length) :
    (finiteEventPathObservations E target observe steps x p).get
      ⟨i, by rw [finite_event_path_observations_length]; exact hi⟩ =
      observe (steps.get ⟨i, hi⟩)
        (finiteEventPathOccurrence E target steps x p ⟨i, hi⟩).1
        (finiteEventPathOccurrence E target steps x p ⟨i, hi⟩).2 := by
  induction steps generalizing x i with
  | nil => simp only [List.length_nil] at hi; omega
  | cons k steps ih =>
    rcases p with ⟨e, p⟩
    cases i with
    | zero => rfl
    | succ i => exact ih (target k x e) p i (by simp only [List.length_cons] at hi; omega)

end Paths
end Bounty
end

section

/- A fixed initial ledger excludes fresh active births. Retained shared
slots and auxiliary draws are not births and are not tested by this mask. -/

open Finset
open scoped Classical

namespace Bounty

def cleanInitialBirthAllowed {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (F : ∀ g, Finset (P g)) (C : G → Finset (Fin J))
    (target : RepeatedBigLists P J ell) : Prop :=
  ∀ g (s : PhysicalSlots J ell), repeatedBigUnshared C g s → target g s ∉ F g

noncomputable def cleanInitialBirthKernel {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (F : ∀ g, Finset (P g)) (C : G → Finset (Fin J))
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (source target : RepeatedBigLists P J ell) (aux : PhysicalAuxLabels P C) : ℂ :=
  if cleanInitialBirthAllowed F C target then K source target aux else 0

theorem clean_initial_birth_allowed_fill {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (F : ∀ g, Finset (P g)) (C : G → Finset (Fin J))
    (source : RepeatedBigLists P J ell)
    (fresh : ∀ g, Fin (cleanFullSharedSlots (ell := ell) C g)ᶜ.card → P g) :
    cleanInitialBirthAllowed F C (repeatedBigFill C source (cleanFullFreshEquiv P C fresh)) ↔
      ∀ g i, fresh g i ∉ F g := by
  constructor
  · intro h g i
    have hi := h g (cleanFullUnsharedIndex C g i).val (cleanFullUnsharedIndex C g i).property
    simpa only [repeated_big_fill_unshared, cleanFullFreshEquiv_apply_index] using hi
  · intro h g s hs
    simp only [repeatedBigFill, dif_pos hs]
    obtain ⟨i, hi⟩ := (cleanFullUnsharedIndex C g).surjective ⟨s, hs⟩
    rw [← hi, cleanFullFreshEquiv_apply_index]
    exact h g i

theorem clean_initial_birth_address_card {G : Type*} {J ell : ℕ}
    (C : G → Finset (Fin J)) (g : G) :
    Fintype.card (Fin (cleanFullSharedSlots (ell := ell) C g)ᶜ.card) =
      ell + (C g).card := by
  rw [Fintype.card_fin, cleanFullSharedSlots_compl_card]

end Bounty
end

section

/- Earlier-operation parent labels are fixed anchors; within-operation parents retain chronological order. -/

open Finset Classical

namespace Bounty

abbrev birthLabelsAnchored {n : ℕ} {α : Type*} (anchor : Fin n → Option α) (a : Fin n → α) : Prop :=
  ∀ i p, anchor i = some p → a i = p

theorem anchored_product_identity {n : ℕ} (Z : Fin n → Type*) [∀ i, Fintype (Z i)]
    {α : Type*} (label : ∀ i, Z i → α) (w : ∀ i, Z i → ℝ)
    (anchor : Fin n → Option α) (f : ∀ i, Z i) :
    (∏ i, if ∀ p, anchor i = some p → label i (f i) = p then w i (f i) else 0) =
      if birthLabelsAnchored anchor (fun i => label i (f i)) then ∏ i, w i (f i) else 0 := by
  simp only [prod_ite_zero, mem_univ, forall_const, birthLabelsAnchored]

theorem labeled_anchored_birth_forest_sum_le {n : ℕ}
    (Z : Fin n → Type*) [∀ i, Fintype (Z i)]
    {α : Type*} [Fintype α] [DecidableEq α]
    (label : ∀ i, Z i → α) (w : ∀ i, Z i → ℝ)
    (code : BirthForestCode n) (anchor : Fin n → Option α)
    (M ε : Fin n → ℝ) (hM : ∀ i, 0 ≤ M i) (hε : ∀ i, 0 ≤ ε i)
    (hw : ∀ i z, 0 ≤ w i z) (hsum : ∀ i, ∑ z, w i z ≤ M i)
    (hatom : ∀ i a, finiteLabelMass (label i) (w i) a ≤ ε i) :
    (∑ f : ∀ i, Z i,
      if birthForestEqualValues code (fun i => label i (f i)) ∧
          birthLabelsAnchored anchor (fun i => label i (f i)) then
        ∏ i, w i (f i) else 0) ≤
      ∏ i, match code i with
        | some _ => ε i
        | none => match anchor i with | none => M i | some _ => ε i := by
  let wa : ∀ i, Z i → ℝ := fun i z =>
    if ∀ p, anchor i = some p → label i z = p then w i z else 0
  let Ma : Fin n → ℝ := fun i => match anchor i with | none => M i | some _ => ε i
  have hwa : ∀ i z, 0 ≤ wa i z := by
    intro i z
    dsimp [wa]
    split_ifs <;> simp_all
  have hMa : ∀ i, 0 ≤ Ma i := by
    intro i
    dsimp [Ma]
    cases anchor i <;> simp only [hM, hε]
  have hsa : ∀ i, ∑ z, wa i z ≤ Ma i := by
    intro i
    cases ha : anchor i with
    | none => simpa [wa, Ma, ha] using hsum i
    | some p =>
      simpa only [wa, Ma, ha, Option.some.injEq, forall_eq', finiteLabelMass] using hatom i p
  have haa : ∀ i a, finiteLabelMass (label i) (wa i) a ≤ ε i := by
    intro i a
    apply le_trans _ (hatom i a)
    apply sum_le_sum
    intro z _
    dsimp [wa]
    split_ifs <;> simp_all
  have hb := labeled_birth_forest_sum_le Z label wa code Ma ε hMa hε hwa hsa haa
  have he (f : ∀ i, Z i) :
      (if birthForestEqualValues code (fun i => label i (f i)) then
        ∏ i, wa i (f i) else 0) =
      if birthForestEqualValues code (fun i => label i (f i)) ∧
          birthLabelsAnchored anchor (fun i => label i (f i)) then
        ∏ i, w i (f i) else 0 := by
    have hp : (∏ i, wa i (f i)) =
        if birthLabelsAnchored anchor (fun i => label i (f i)) then ∏ i, w i (f i) else 0 := by
      dsimp only [wa]
      rw [prod_ite_zero]
      simp only [mem_univ, forall_const, birthLabelsAnchored]
    rw [hp]
    split_ifs <;> simp_all
  simp_rw [he] at hb
  apply le_trans hb
  apply le_of_eq
  apply prod_congr rfl
  intro i _
  cases code i <;> rfl

end Bounty
end

section

/- Atom bounds retain group tags and integrate the full ghost residue data. -/

open Finset Classical

namespace Bounty

theorem finiteLabelMass_tagged_prime_le {G : Type*} {P : G → Type*}
    [DecidableEq (Sigma P)] (g : G) [Fintype (P g)]
    (μ : P g → ℝ) {η : ℝ} (hη : 0 ≤ η) (hμ : ∀ p, μ p ≤ η) (a : Sigma P) :
    finiteLabelMass (fun p : P g => (⟨g, p⟩ : Sigma P)) μ a ≤ η := by
  rcases a with ⟨h, p⟩
  by_cases he : g = h
  · subst h
    unfold finiteLabelMass
    simpa only [Sigma.mk.inj_iff, heq_eq_eq, true_and, sum_ite_eq', mem_univ, ite_true] using hμ p
  · have hn (q : P g) : (⟨g, q⟩ : Sigma P) ≠ ⟨h, p⟩ := by
      intro hq
      exact he (congrArg Sigma.fst hq)
    simpa only [finiteLabelMass, hn, if_false, sum_const_zero] using hη

theorem finiteLabelMass_tagged_ghost_le {G : Type*} {P : G → Type*}
    [DecidableEq (Sigma P)] (g : G) [Fintype (P g)] (n : P g → ℕ)
    [∀ p, NeZero (n p)] (μ : P g → ℝ) (q ρ V : ℝ)
    {η : ℝ} (hη : 0 ≤ η) (hμ : ∀ p, μ p ≤ η) (a : Sigma P) :
    finiteLabelMass (fun z : UnrestrictedResidueParticle n => (⟨g, z.1⟩ : Sigma P))
      (physicalGhostBirthAtom n μ q ρ V) a ≤ |(1 - q) * V / ρ| * η := by
  rcases a with ⟨h, p⟩
  by_cases he : g = h
  · subst h
    unfold finiteLabelMass
    have heq : (∑ z : UnrestrictedResidueParticle n,
        if (⟨g, z.1⟩ : Sigma P) = ⟨g, p⟩ then physicalGhostBirthAtom n μ q ρ V z else 0) =
        ∑ z : UnrestrictedResidueParticle n,
          if z.1 = p then physicalGhostBirthAtom n μ q ρ V z else 0 := by
      apply sum_congr rfl
      intro z _
      simp only [Sigma.mk.inj_iff, heq_eq_eq, true_and]
    rw [heq, physical_ghost_birth_atom_prime_sum]
    exact mul_le_mul_of_nonneg_left (hμ p) (abs_nonneg _)
  · have hn (z : UnrestrictedResidueParticle n) : (⟨g, z.1⟩ : Sigma P) ≠ ⟨h, p⟩ := by
      intro hz
      exact he (congrArg Sigma.fst hz)
    simpa only [finiteLabelMass, hn, if_false, sum_const_zero] using
      mul_nonneg (abs_nonneg ((1 - q) * V / ρ)) hη

end Bounty
end

section

/- Exact coefficients and targets under an old-memory permutation. -/

open Finset Classical
namespace Bounty

section Edge
variable {P : Type*} [Fintype P] (n : P → ℕ) [∀ p, NeZero (n p)]
    (Δ D : ℤ) {t B : ℕ}
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (τ : Equiv.Perm (Fin s.2.1.val))
    (e : UnrestrictedBoundedEvent n Δ D t B s)

theorem bounded_edge_reindex_test {K : Type*} [Zero K]
    (f : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → K)
    (hf : BoundedOrderedSymmetric f) :
    f (unrestrictedBoundedEventTarget n Δ D t B (boundedGhostMemoryPermute s τ)
      (boundedEdgeMemoryReindex n Δ D s τ e)) =
      f (unrestrictedBoundedEventTarget n Δ D t B s e) := by
  let out := unrestrictedEdgeMemory s.2.2 (unrestrictedResidueTransport n Δ)
    (unrestrictedStoredTuple s.1 (unrestrictedResidueSeed n) e.1) e.2.2.1
  let out' := unrestrictedEdgeMemory (s.2.2 ∘ τ) (unrestrictedResidueTransport n Δ)
    (unrestrictedStoredTuple s.1 (unrestrictedResidueSeed n) e.1)
    (residuePromotionReindex n Δ D s.2.2 τ e.2.2.1)
  have hl : out'.1 = out.1 := by simp only [out, out', unrestrictedEdgeMemory_length]
  have hext := symmetric_tuple_equal_on_occupancy
    (boundedOrderedZeroExtension f
      (unrestrictedEdgeTarget s.2.2 Sigma.fst e.2.1 e.2.2.1 e.2.2.2))
    ((boundedOrderedZeroExtension_symmetric_iff f).mpr hf _) out' out
    (residue_promotion_reindex_memory n Δ D s.2.2 τ e.2.2.1 _)
  rw [boundedEdgeMemoryReindex_apply]
  change f (if h : out'.1 ≤ B then
    (unrestrictedEdgeTarget (s.2.2 ∘ τ) Sigma.fst e.2.1
      (residuePromotionReindex n Δ D s.2.2 τ e.2.2.1) e.2.2.2,
      ⟨⟨out'.1, Nat.lt_succ_of_le h⟩, out'.2⟩) else boundedGhostMemoryPermute s τ) =
    f (if h : out.1 ≤ B then
    (unrestrictedEdgeTarget s.2.2 Sigma.fst e.2.1 e.2.2.1 e.2.2.2,
      ⟨⟨out.1, Nat.lt_succ_of_le h⟩, out.2⟩) else s)
  rw [residue_promotion_reindex_target]
  by_cases h : out.1 ≤ B
  · simpa only [boundedOrderedZeroExtension, hl, h, dif_pos] using hext
  · simp only [hl, h]
    exact hf s.1 s.2.1 s.2.2 τ
theorem bounded_edge_reindex_length :
    (unrestrictedBoundedEventTarget n Δ D t B (boundedGhostMemoryPermute s τ)
      (boundedEdgeMemoryReindex n Δ D s τ e)).2.1 =
      (unrestrictedBoundedEventTarget n Δ D t B s e).2.1 := by
  apply Fin.ext
  exact bounded_edge_reindex_test n Δ D s τ e (fun x => x.2.1.val) (by intro active N q σ; rfl)

theorem bounded_edge_reindex_active :
    (unrestrictedBoundedEventTarget n Δ D t B (boundedGhostMemoryPermute s τ)
      (boundedEdgeMemoryReindex n Δ D s τ e)).1 =
      (unrestrictedBoundedEventTarget n Δ D t B s e).1 := by
  have h := bounded_edge_reindex_test n Δ D s τ e
    (fun x => if x.1 = (unrestrictedBoundedEventTarget n Δ D t B s e).1
      then (1 : ℂ) else 0) (by intro active N q σ; rfl)
  by_contra hne
  simp only [hne, if_false, if_true, zero_ne_one] at h

theorem bounded_edge_reindex_weight (μ : P → ℝ) (ρ V : ℝ) :
    unrestrictedBoundedEventWeight n Δ D μ ρ V t B (boundedGhostMemoryPermute s τ)
      (boundedEdgeMemoryReindex n Δ D s τ e) =
      unrestrictedBoundedEventWeight n Δ D μ ρ V t B s e := by
  have hc : orderedPredicateCount
      (unrestrictedEdgeMemory (s.2.2 ∘ τ) (unrestrictedResidueTransport n Δ)
        (unrestrictedStoredTuple s.1 (unrestrictedResidueSeed n) e.1)
        (residuePromotionReindex n Δ D s.2.2 τ e.2.2.1)) unrestrictedResidueHit =
      orderedPredicateCount
      (unrestrictedEdgeMemory s.2.2 (unrestrictedResidueTransport n Δ)
        (unrestrictedStoredTuple s.1 (unrestrictedResidueSeed n) e.1) e.2.2.1)
          unrestrictedResidueHit := by
    apply symmetric_tuple_equal_on_occupancy
      (fun q : FiniteOrderedTuple (UnrestrictedResidueParticle n) =>
        orderedPredicateCount q unrestrictedResidueHit)
      (fun _ q σ => orderedPredicateCount_permutation q unrestrictedResidueHit σ)
    exact residue_promotion_reindex_memory n Δ D s.2.2 τ e.2.2.1 _
  rw [boundedEdgeMemoryReindex_apply]
  simp only [unrestrictedBoundedEventWeight, boundedGhostMemoryPermute,
    unrestrictedEdgeOutput, unrestrictedEdgeMemory_length]
  split_ifs
  · simp only [unrestrictedEdgeEventMass, unrestrictedEdgeOutput,
      orderedPredicateCount_permutation, hc]
  · rfl


end Edge
end Bounty
end

section

/- Joint signed ghost events preserve their ordered birth batches under memory reindexing. -/

open Finset Classical
namespace Bounty

theorem bounded_ghost_reindex_length {P Z : Type*} {t B : ℕ}
    (s : BoundedOrderedState P Z t B) (τ : Equiv.Perm (Fin s.2.1.val))
    (e : BoundedGhostEvent t B s) :
    (boundedGhostEventTarget t B (boundedGhostMemoryPermute s τ)
      (boundedGhostEventPermEquiv s τ e)).2.1 =
      (boundedGhostEventTarget t B s e).2.1 := by
  rw [boundedGhostEventPermEquiv_apply]
  by_cases h : e.2.1.card + e.1.val ≤ B
  · simp [boundedGhostEventTarget, boundedGhostMemoryPermute, retainedBirthTuple, h]
  · simp [boundedGhostEventTarget, boundedGhostMemoryPermute, retainedBirthTuple, h]

section Joint
variable {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} [∀ g, Fintype (Z g)] [∀ g, DecidableEq (Z g)]
    (t : G → ℕ) (B : ℕ) (s : ProductBoundedOrderedState P Z t B)
    (τ : ∀ g, Equiv.Perm (Fin (s g).2.1.val))

noncomputable def jointGhostMemoryReindex : CoupledGhostEvent t B s ≃
    CoupledGhostEvent t B (productMemoryReindex s τ) :=
  Equiv.piCongrRight fun g => boundedGhostEventPermEquiv (s g) (τ g)

theorem joint_ghost_reindex_test (e : CoupledGhostEvent t B s)
    (f : ProductBoundedOrderedState P Z t B → ℂ) (hf : ProductMemorySymmetric f) :
    f (coupledGhostJointEventTarget t B (productMemoryReindex s τ)
      (jointGhostMemoryReindex t B s τ e)) = f (coupledGhostJointEventTarget t B s e) := by
  apply product_memory_test_congr f hf
  intro g h hh
  exact bounded_ghost_event_perm_test (s g) (τ g) (e g) h hh

omit [DecidableEq G] [∀ g, Fintype (Z g)] [∀ g, DecidableEq (Z g)] in
theorem joint_ghost_reindex_total (e : CoupledGhostEvent t B s) :
    productTotalMemory (coupledGhostJointEventTarget t B (productMemoryReindex s τ)
      (jointGhostMemoryReindex t B s τ e)) = productTotalMemory (coupledGhostJointEventTarget t B s e) := by
  apply sum_congr rfl
  intro g _
  exact congrArg Fin.val (bounded_ghost_reindex_length (s g) (τ g) (e g))

omit [DecidableEq G] [∀ g, Fintype (Z g)] [∀ g, DecidableEq (Z g)] in
theorem joint_ghost_reindex_weight (A D C ν : ∀ g, Z g → ℝ)
    (e : CoupledGhostEvent t B s) :
    coupledGhostJointEventWeight A D C ν t B (productMemoryReindex s τ)
      (jointGhostMemoryReindex t B s τ e) = coupledGhostJointEventWeight A D C ν t B s e := by
  unfold coupledGhostJointEventWeight
  rw [joint_ghost_reindex_total]
  have hs : productTotalMemory (productMemoryReindex s τ) = productTotalMemory s := rfl
  rw [hs]
  split_ifs
  · apply prod_congr rfl
    intro g _
    exact bounded_ghost_event_perm_weight (A g) (D g) (C g) (ν g) (s g) (τ g) (e g)
  · rfl

end Joint
end Bounty
end

section

/- Original physical full-edge coefficients with an external finite
residue coordinate translated separately for each auxiliary draw. The
initial forbidden set applies only to raw fresh births. -/

open Finset Classical

namespace Bounty

noncomputable def physicalFullExternalCoefficientAction {R : Type*} {N J ell B : ℕ}
    {P : Fin N → Finset ℕ} [∀ g (p : P g), NeZero p.val]
    (C : Fin N → Finset (Fin J)) (k : ℤ)
    (V : Fin N → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ)
    (F : ∀ g, Finset (P g))
    (τ : SharedActiveLabels (fun g => ↥(P g))
      (fun g => physicalFullSharedIndices (ell := ell) (C g)) → PhysicalAuxLabels P C → R ≃ R)
    (Ψ : ∀ x : PhysicalFullBoundedState P J ell B, R → PhysicalFullEdgeEvent C k x → ℂ)
    (f : PhysicalFullBoundedState P J ell B → R → ℂ) :
    PhysicalFullBoundedState P J ell B → R → ℂ :=
  fullActiveExternalCoefficientAction (fun g (p : P g) => p.val)
    (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
    (fun _ => PhysicalAuxLabels P C) (physicalFullEdgeDelta C k) (physicalFullEdgeD C)
    (fun _ => physicalAuxMass V C) (fun g => tiltedPhysicalBirthLaw V g (baseline g)) ρ V τ
    (fun x r e => if ∀ g i, (e.2 g).2.2.2 i ∉ F g then Ψ x r e else 0) f

theorem physical_full_external_coefficient_projected_energy_le {R : Type*} [Fintype R] {N J ell B : ℕ}
    {P : Fin N → Finset ℕ} [∀ g (p : P g), NeZero p.val]
    (C : Fin N → Finset (Fin J)) (k : ℤ)
    (V : Fin N → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ)
    (F : ∀ g, Finset (P g))
    (τ : SharedActiveLabels (fun g => ↥(P g))
      (fun g => physicalFullSharedIndices (ell := ell) (C g)) → PhysicalAuxLabels P C → R ≃ R)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (hbaseline : ∀ g p, 1 / 2 ≤ baseline g p ∧ baseline g p ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (T : ℕ) (ht : ∀ g, ell + (C g).card ≤ T)
    (Ψ : ∀ x : PhysicalFullBoundedState P J ell B, R → PhysicalFullEdgeEvent C k x → ℂ)
    (H : ℝ) (hH : 0 ≤ H) (hΨ : ∀ x r e, ‖Ψ x r e‖ ≤ H)
    (f : PhysicalFullBoundedState P J ell B → R → ℂ) (hf : ∀ r, ProductMemorySymmetric (fun x => f x r)) :
    (∑ r, finiteWeightedEnergy
      (productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (baseline g))
        (fun g => unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g (baseline g))))
      (fullActiveAverage (fun x => physicalFullExternalCoefficientAction C k V baseline ρ F τ Ψ
        (fun y s => fullActiveAverage (fun z => f z s) y) x r))) ≤
      H ^ 2 * unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ N *
        ∑ r, finiteWeightedEnergy
          (productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (baseline g))
            (fun g => unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g (baseline g)))) (fun x => f x r) := by
  have hV : ∀ g, 0 < V g := fun g => hvmin.trans_le (hVlo g)
  have hμ : ∀ g p, 0 ≤ tiltedPhysicalBirthLaw V g (baseline g) p := by
    intro g p
    exact tiltedPhysicalBirthLaw_nonneg V g (baseline g) (hV g).le
      (fun p => (by norm_num : (0 : ℝ) ≤ 1 / 2).trans (hbaseline g p).1) p
  have hphase : ∀ x r (e : PhysicalFullEdgeEvent (B := B) C k x),
      ‖if ∀ g i, (e.2 g).2.2.2 i ∉ F g then Ψ x r e else 0‖ ≤ H := by
    intro x r e
    split_ifs
    · exact hΨ x r e
    · simpa only [norm_zero] using hH
  have h := full_active_external_coefficient_projected_energy_le (fun g (p : P g) => p.val)
    (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
    (fun _ => PhysicalAuxLabels P C) (physicalFullEdgeDelta C k) (physicalFullEdgeD C)
    (fun _ => physicalAuxMass V C) (fun g => tiltedPhysicalBirthLaw V g (baseline g)) ρ V τ
    (fun _ a => physical_aux_mass_nonneg V C (fun g => (hV g).le) a)
    (fun _ => (physical_aux_mass_sum V C hV hMass).le)
    hρ0 hρ1 hv hvmin hVlo hVhi hμ
    (fun g => (tiltedPhysicalBirthLaw_sum_bounds V g (baseline g) (hV g) (hMass g) (hbaseline g)).2)
    T (fun g => by simpa only [physical_full_unshared_indices_card] using ht g)
    _ H hH hphase f hf
  simpa only [physicalFullExternalCoefficientAction, Fintype.card_fin] using h

theorem clean_weighted_norm_eq_external_energy {X R : Type*} [Fintype X] [Fintype R]
    (w : X → ℝ) (f : X → R → ℂ) :
    cleanWeightedNorm w f = Real.sqrt (∑ r, finiteWeightedEnergy w (fun x => f x r)) := by
  unfold cleanWeightedNorm finiteWeightedEnergy
  congr 1
  simp only [mul_sum]
  exact sum_comm

theorem clean_weighted_norm_le_of_external_energy {X R : Type*} [Fintype X] [Fintype R]
    (w : X → ℝ) (H : ℝ) (hH : 0 ≤ H) (K : ℝ) (hK : 0 ≤ K)
    (f output : X → R → ℂ)
    (h : (∑ r, finiteWeightedEnergy w (fun x => output x r)) ≤
      H ^ 2 * K * ∑ r, finiteWeightedEnergy w (fun x => f x r)) :
    cleanWeightedNorm w output ≤ H * Real.sqrt K * cleanWeightedNorm w f := by
  rw [clean_weighted_norm_eq_external_energy, clean_weighted_norm_eq_external_energy]
  have hs := Real.sqrt_le_sqrt h
  rwa [Real.sqrt_mul (mul_nonneg (sq_nonneg H) hK),
    Real.sqrt_mul (sq_nonneg H), Real.sqrt_sq hH] at hs

noncomputable def physicalFullSmallCoefficientAction {S : Type*}
    (Ps : S → Finset ℕ) {N J ell B : ℕ}
    {P : Fin N → Finset ℕ} [∀ g (p : P g), NeZero p.val]
    (C : Fin N → Finset (Fin J)) (k : ℤ)
    (V : Fin N → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ)
    (F : ∀ g, Finset (P g))
    (Ψ : ∀ x : PhysicalFullBoundedState P J ell B,
      PhysicalResidues Ps → PhysicalFullEdgeEvent C k x → ℂ)
    (f : PhysicalFullBoundedState P J ell B → PhysicalResidues Ps → ℂ) :=
  physicalFullExternalCoefficientAction C k V baseline ρ F
    (fun c a => physicalResidueTranslationEquiv (P := Ps) (k * physicalFullSharedD C c a)) Ψ f

theorem physical_full_small_coefficient_projected_norm_le {S : Type*} [Fintype S]
    (Ps : S → Finset ℕ) [∀ p : PhysicalPrime Ps, NeZero p.2.val]
    {N J ell B : ℕ} {P : Fin N → Finset ℕ} [∀ g (p : P g), NeZero p.val]
    (C : Fin N → Finset (Fin J)) (k : ℤ)
    (V : Fin N → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ)
    (F : ∀ g, Finset (P g))
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (hbaseline : ∀ g p, 1 / 2 ≤ baseline g p ∧ baseline g p ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (T : ℕ) (ht : ∀ g, ell + (C g).card ≤ T)
    (Ψ : ∀ x : PhysicalFullBoundedState P J ell B,
      PhysicalResidues Ps → PhysicalFullEdgeEvent C k x → ℂ)
    (H : ℝ) (hH : 0 ≤ H) (hΨ : ∀ x r e, ‖Ψ x r e‖ ≤ H)
    (f : PhysicalFullBoundedState P J ell B → PhysicalResidues Ps → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun x => f x r)) :
    cleanWeightedNorm
      (productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (baseline g))
        (fun g => unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g (baseline g))))
      (fun x r => fullActiveAverage (fun y => physicalFullSmallCoefficientAction Ps C k V baseline ρ F Ψ
        (fun z s => fullActiveAverage (fun w => f w s) z) y r) x) ≤
      H * Real.sqrt (unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ N) *
        cleanWeightedNorm
          (productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (baseline g))
            (fun g => unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g (baseline g)))) f := by
  have h := physical_full_external_coefficient_projected_energy_le C k V baseline ρ F
    (fun c a => physicalResidueTranslationEquiv (P := Ps) (k * physicalFullSharedD C c a))
    hMass hbaseline hρ0 hρ1 hv hvmin hVlo hVhi T ht Ψ H hH hΨ f hf
  exact clean_weighted_norm_le_of_external_energy _ H hH _
    (pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) N) f _ h

end Bounty
end

section

/- Exact separation of full edge events into empty storage/promotion and
its complement. Both pieces retain the original capped event weights. -/

open Finset
open scoped Classical

namespace Bounty

section
variable {G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ)
  {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : SharedActiveLabels P S → Type*) [∀ c, Fintype (A c)]
  (Δ D : ∀ c, A c → G → ℤ)
  (ω : ∀ c, A c → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)

theorem full_active_coefficient_clean_split
    (Ψ : ∀ x, FullActiveEdgeEvent n S B A Δ D x → ℂ)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ) :
    fullActiveCoefficientAction n S B A Δ D ω μ ρ V Ψ f =
      fullActiveCoefficientAction n S B A Δ D ω μ ρ V
        (fun x e => if ∀ g, (e.2 g).1 = ∅ ∧ (e.2 g).2.1 = ∅ then Ψ x e else 0) f +
      fullActiveCoefficientAction n S B A Δ D ω μ ρ V
        (fun x e => if ∀ g, (e.2 g).1 = ∅ ∧ (e.2 g).2.1 = ∅ then 0 else Ψ x e) f := by
  funext x
  simp only [Pi.add_apply, fullActiveCoefficientAction, ← sum_add_distrib]
  apply sum_congr rfl
  intro e _
  split_ifs <;> simp

theorem full_active_external_coefficient_clean_split {R : Type*}
    (τ : ∀ c, A c → R ≃ R)
    (Ψ : ∀ x, R → FullActiveEdgeEvent n S B A Δ D x → ℂ)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → R → ℂ) :
    fullActiveExternalCoefficientAction n S B A Δ D ω μ ρ V τ Ψ f =
      fullActiveExternalCoefficientAction n S B A Δ D ω μ ρ V τ
        (fun x r e => if ∀ g, (e.2 g).1 = ∅ ∧ (e.2 g).2.1 = ∅ then Ψ x r e else 0) f +
      fullActiveExternalCoefficientAction n S B A Δ D ω μ ρ V τ
        (fun x r e => if ∀ g, (e.2 g).1 = ∅ ∧ (e.2 g).2.1 = ∅ then 0 else Ψ x r e) f := by
  funext x r
  simp only [Pi.add_apply, fullActiveExternalCoefficientAction, ← sum_add_distrib]
  apply sum_congr rfl
  intro e _
  split_ifs <;> simp

end
