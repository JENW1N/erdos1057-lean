/- The actual mixed target translates small residues by the original full displacement. -/

open scoped Classical
namespace Bounty
section Translation
variable {G H : Type*} [Fintype G] [Fintype H]
  {P : G → Finset ℕ} {J ell B : ℕ}
  (small : G → Prop) (e : {g : G // ¬small g} ≃ H)
  (C : G → Finset (Fin J)) (hC : ∀ g, small g → C g = ∅)
  (aux : PhysicalAuxLabels P C) (L : PhysicalMarkLists P J ell)
  {Z : H → Type*} (q : ∀ h, BoundedOrderedTuple (Z h) B) (k : ℤ)
  (r : PhysicalResidues (fun g : {g // small g} => P g.val))

include hC in
theorem physical_mixed_encoded_translate :
    physicalTranslateResidues r
      (physicalMixedBigStep (fun h => C (e.symm h).val) k
        (productActiveMemorySplit (fun h => physicalFullSharedIndices (C (e.symm h).val)) B
          (physicalFullMemoryState (fun h => C (e.symm h).val)
            (physicalMarkGroupReindex e (fun g => P g.val) J ell (fun g => L g.val)) q)).1
        (physicalAuxGroupReindex e (fun g => P g.val) J (fun g => C g.val) (fun g => aux g.val)) *
        (physicalSharedProduct (physicalSharedPrefix (fun g : {g // small g} => L g.val)) : ℕ)) =
    physicalTranslateResidues r (k * (physicalD C L aux : ℕ)) := by
  rw [physical_mixed_step_factor, physical_mixed_shared_D_reindexed small e C hC aux L q]

include hC in
theorem physical_mixed_encoded_target_residue
    (E : PhysicalSharedLists (fun g : {g // small g} => P g.val) J →
      ProductBoundedOrderedState (fun h => ↥(P (e.symm h).val)) Z (fun _ => J + ell) B → Type*)
    (target : ∀ d x, E d x →
      ProductBoundedOrderedState (fun h => ↥(P (e.symm h).val)) Z (fun _ => J + ell) B)
    (a : PhysicalSmallBigEvent E ((r, (fun g : {g // small g} => L g.val)),
      physicalFullMemoryState (fun h => C (e.symm h).val)
        (physicalMarkGroupReindex e (fun g => P g.val) J ell (fun g => L g.val)) q)) :
    (physicalSmallBigTarget E target
      (fun x => physicalMixedBigStep (fun h => C (e.symm h).val) k
        (productActiveMemorySplit (fun h => physicalFullSharedIndices (C (e.symm h).val)) B x).1
        (physicalAuxGroupReindex e (fun g => P g.val) J (fun g => C g.val) (fun g => aux g.val)))
      ((r, (fun g : {g // small g} => L g.val)),
        physicalFullMemoryState (fun h => C (e.symm h).val)
          (physicalMarkGroupReindex e (fun g => P g.val) J ell (fun g => L g.val)) q) a).1.1 =
    physicalTranslateResidues r (k * (physicalD C L aux : ℕ)) := by
  exact physical_mixed_encoded_translate small e C hC aux L q k r

end Translation
