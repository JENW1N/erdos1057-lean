section

/- The actual bounded physical state keeps its ordered mark list, birth
ledger and pending memory. Its full-state encoding is allowed to vary at
successive cuts of a physical schedule. -/

open scoped Classical
namespace Bounty

abbrev PhysicalBoundedMarkState {N : ℕ} (P : Fin N → Finset ℕ) (J ell B : ℕ) :=
  PhysicalMarkLists P J ell × ((g : Fin N) → Finset ↥(P g)) ×
    ((g : Fin N) → BoundedOrderedTuple (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B)

noncomputable def physicalBoundedMarkEncode {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (C : Fin N → Finset (Fin J)) (s : PhysicalBoundedMarkState P J ell B) :
    FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B :=
  (s.2.1, physicalFullMemoryState C s.1 s.2.2)

noncomputable def physicalMarkRawExtension {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (F : PhysicalBoundedMarkState P J ell B → ℂ) (R : PhysicalMarkLists P J ell)
    (s : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val)) : ℂ :=
  if h : ∀ g, (s g).2.1 ≤ B then
    F (R, (fun g => (s g).1),
      fun g => ⟨⟨(s g).2.1, Nat.lt_succ_of_le (h g)⟩, (s g).2.2⟩)
  else 0

theorem physical_mark_raw_extension_encode {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (C : Fin N → Finset (Fin J))
    (F : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ)
    (R : PhysicalMarkLists P J ell) :
    physicalMarkRawExtension (F ∘ physicalBoundedMarkEncode C) R =
      physicalFullContinuation C R F := rfl

end Bounty
end

section

/- The support of a small-cap full active edge is exactly the support of
the large-cap edge whose target still satisfies the small total cap. -/

open Finset Classical

namespace Bounty

section

variable {G : Type*} {P : G → Type*} (n : ∀ g, P g → ℕ) {M : G → ℕ}
  (S : ∀ g, Finset (Fin (M g)))
  (A : SharedActiveLabels P S → Type*) (Δ D : ∀ c, A c → G → ℤ)
  {b B : ℕ} (h : b ≤ B)
  (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b)
  [Fintype G] (ω : ∀ c, A c → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)

theorem fullActiveEdgeEvent_cap_support_iff (hs : productTotalMemory s ≤ b)
    (e : FullActiveEdgeEvent n S b A Δ D s) :
    fullActiveEdgeEventWeight n S b A Δ D ω μ ρ V s e ≠ 0 ↔
      fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V (productStateCapEmbed h s)
        (fullActiveEdgeEventCapEquiv n S A Δ D h s e) ≠ 0 ∧
      productTotalMemory (fullActiveEdgeEventTarget n S B A Δ D (productStateCapEmbed h s)
        (fullActiveEdgeEventCapEquiv n S A Δ D h s e)) ≤ b := by
  rw [fullActiveEdgeEventWeight_cap n S A Δ D h s ω μ ρ V hs e]
  split_ifs <;> simp_all

def fullActiveEdgeSupportedCapEquiv (hs : productTotalMemory s ≤ b) :
    {e : FullActiveEdgeEvent n S b A Δ D s //
      fullActiveEdgeEventWeight n S b A Δ D ω μ ρ V s e ≠ 0} ≃
    {e : FullActiveEdgeEvent n S B A Δ D (productStateCapEmbed h s) //
      fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V (productStateCapEmbed h s) e ≠ 0 ∧
      productTotalMemory (fullActiveEdgeEventTarget n S B A Δ D (productStateCapEmbed h s) e) ≤ b} :=
  (fullActiveEdgeEventCapEquiv n S A Δ D h s).subtypeEquiv
    (fullActiveEdgeEvent_cap_support_iff n S A Δ D h s ω μ ρ V hs)

theorem fullActiveEdgeSupportedCapEquiv_apply_val (hs : productTotalMemory s ≤ b)
    (e : {e : FullActiveEdgeEvent n S b A Δ D s //
      fullActiveEdgeEventWeight n S b A Δ D ω μ ρ V s e ≠ 0}) :
    (fullActiveEdgeSupportedCapEquiv n S A Δ D h s ω μ ρ V hs e).val =
      fullActiveEdgeEventCapEquiv n S A Δ D h s e.val := rfl

theorem fullActiveEdgeEventTarget_total_of_weight_ne_zero
    (e : FullActiveEdgeEvent n S b A Δ D s)
    (hw : fullActiveEdgeEventWeight n S b A Δ D ω μ ρ V s e ≠ 0) :
    productTotalMemory (fullActiveEdgeEventTarget n S b A Δ D s e) ≤ b := by
  by_contra ht
  apply hw
  rw [fullActiveEdgeEventWeight_full_caps]
  simp only [ht, and_false, if_false]

theorem fullActiveEdgeEventWeight_cap_of_ne_zero
    (e : FullActiveEdgeEvent n S b A Δ D s)
    (hw : fullActiveEdgeEventWeight n S b A Δ D ω μ ρ V s e ≠ 0) :
    fullActiveEdgeEventWeight n S b A Δ D ω μ ρ V s e =
      fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V (productStateCapEmbed h s)
        (fullActiveEdgeEventCapEquiv n S A Δ D h s e) := by
  have hs : productTotalMemory s ≤ b := by
    by_contra hs
    apply hw
    rw [fullActiveEdgeEventWeight_full_caps]
    simp only [hs, false_and, if_false]
  rw [fullActiveEdgeEventWeight_cap n S A Δ D h s ω μ ρ V hs e]
  exact if_pos ((fullActiveEdgeEvent_cap_support_iff n S A Δ D h s ω μ ρ V hs e).mp hw).2

end

end Bounty
end

section

/- Exact supported-event transport for permutations, signed ghost visits,
and varying full active edges. The initial total memory stays below the
smaller cap, and the image consists exactly of supported events staying there. -/

open Finset Classical

namespace Bounty

universe uJ uK uG uP uA

section

variable {J : Type uJ} {K : Type uK} {G : Type uG} {P : G → Type uP}
  (n : ∀ g, P g → ℕ) {M : G → ℕ}
  (S : K → ∀ g, Finset (Fin (M g)))
  (A : ∀ k, SharedActiveLabels P (S k) → Type uA)
  (Δ D : ∀ k c, A k c → G → ℤ)
  {b B : ℕ} (h : b ≤ B)

def fullPermutationMixedEventCapEmbed (k : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b) :
    FullPermutationMixedEvent n S b A Δ D k s →
      FullPermutationMixedEvent n S B A Δ D k (productStateCapEmbed h s) :=
  match k with
  | none => id
  | some (.inl _) => fun e => ⟨coupledGhostEventCapEmbed h s e.down⟩
  | some (.inr j) => fullActiveEdgeEventCapEquiv n (S j) (A j) (Δ j) (D j) h s

theorem fullPermutationMixedEventCapEmbed_injective (k : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b) :
    Function.Injective (fullPermutationMixedEventCapEmbed n S A Δ D h k s) := by
  cases k with
  | none => exact Function.injective_id
  | some k =>
    cases k with
    | inl j =>
      intro e f hef
      apply ULift.ext
      exact coupledGhostEventCapEmbed_injective h s (congrArg ULift.down hef)
    | inr j => exact (fullActiveEdgeEventCapEquiv n (S j) (A j) (Δ j) (D j) h s).injective

variable [Fintype G] [DecidableEq G]
  (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)

theorem fullPermutationMixedEventCapEmbed_target (k : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b)
    (e : FullPermutationMixedEvent n S b A Δ D k s)
    (hw : fullPermutationMixedEventWeight n S b A Δ D ω μ q ρ V k s e ≠ 0) :
    fullPermutationMixedEventTarget n S B A Δ D k (productStateCapEmbed h s)
        (fullPermutationMixedEventCapEmbed n S A Δ D h k s e) =
      productStateCapEmbed h (fullPermutationMixedEventTarget n S b A Δ D k s e) := by
  cases k with
  | none => rfl
  | some k =>
    cases k with
    | inl j =>
      exact coupledGhostEventCapEmbed_target_of_ne_zero h
        (fun g => physicalGhostRetention (n g) (q j) ρ)
        (fun g => physicalGhostTermination (n g) (q j) ρ)
        (fun g => physicalGhostBirth (n g) (q j) ρ (V g))
        (fun g => unrestrictedResidueWeight (μ g)) s e.down hw
    | inr j =>
      exact (fullActiveEdgeEventTarget_cap_of_weight_ne_zero n (S j) (A j) (Δ j) (D j)
        h s (ω j) μ ρ V e hw).symm

theorem fullPermutationMixedEventCapEmbed_weight (k : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b)
    (hs : productTotalMemory s ≤ b) (e : FullPermutationMixedEvent n S b A Δ D k s) :
    fullPermutationMixedEventWeight n S b A Δ D ω μ q ρ V k s e =
      if productTotalMemory (fullPermutationMixedEventTarget n S B A Δ D k (productStateCapEmbed h s)
          (fullPermutationMixedEventCapEmbed n S A Δ D h k s e)) ≤ b then
        fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V k (productStateCapEmbed h s)
          (fullPermutationMixedEventCapEmbed n S A Δ D h k s e)
      else 0 := by
  cases k with
  | none =>
    change fullActivePermutationWeight M e.down =
      if productTotalMemory (fullActivePermutation e.down (productStateCapEmbed h s)) ≤ b then _ else _
    rw [fullActivePermutation_total_memory, productStateCapEmbed_totalMemory, if_pos hs]
    rfl
  | some k =>
    cases k with
    | inl j =>
      exact coupledGhostEventCapEmbed_weight h
        (fun g => physicalGhostRetention (n g) (q j) ρ)
        (fun g => physicalGhostTermination (n g) (q j) ρ)
        (fun g => physicalGhostBirth (n g) (q j) ρ (V g))
        (fun g => unrestrictedResidueWeight (μ g)) s hs e.down
    | inr j =>
      exact fullActiveEdgeEventWeight_cap n (S j) (A j) (Δ j) (D j) h s (ω j) μ ρ V hs e

theorem fullPermutationMixedEventCapEmbed_surjective_of_ne_zero (k : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b)
    (e : FullPermutationMixedEvent n S B A Δ D k (productStateCapEmbed h s))
    (hw : fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V k (productStateCapEmbed h s) e ≠ 0)
    (ht : productTotalMemory (fullPermutationMixedEventTarget n S B A Δ D k (productStateCapEmbed h s) e) ≤ b) :
    ∃ d : FullPermutationMixedEvent n S b A Δ D k s,
      fullPermutationMixedEventCapEmbed n S A Δ D h k s d = e := by
  cases k with
  | none => exact ⟨e, rfl⟩
  | some k =>
    cases k with
    | inl j =>
      obtain ⟨d, hd⟩ := coupledGhostEventCapEmbed_surjective_of_ne_zero h
        (fun g => physicalGhostRetention (n g) (q j) ρ)
        (fun g => physicalGhostTermination (n g) (q j) ρ)
        (fun g => physicalGhostBirth (n g) (q j) ρ (V g))
        (fun g => unrestrictedResidueWeight (μ g)) s e.down hw ht
      exact ⟨⟨d⟩, congrArg ULift.up hd⟩
    | inr j => exact ⟨(fullActiveEdgeEventCapEquiv n (S j) (A j) (Δ j) (D j) h s).symm e,
        (fullActiveEdgeEventCapEquiv n (S j) (A j) (Δ j) (D j) h s).apply_symm_apply e⟩

theorem fullPermutationMixedEvent_supported_target (k : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b)
    (hs : productTotalMemory s ≤ b) (e : FullPermutationMixedEvent n S b A Δ D k s)
    (hw : fullPermutationMixedEventWeight n S b A Δ D ω μ q ρ V k s e ≠ 0) :
    productTotalMemory (fullPermutationMixedEventTarget n S b A Δ D k s e) ≤ b := by
  cases k with
  | none => exact hs
  | some k =>
    cases k with
    | inl j =>
      exact (coupledGhostJointEventWeight_support
        (fun g => physicalGhostRetention (n g) (q j) ρ)
        (fun g => physicalGhostTermination (n g) (q j) ρ)
        (fun g => physicalGhostBirth (n g) (q j) ρ (V g))
        (fun g => unrestrictedResidueWeight (μ g)) s e.down hw).1.2
    | inr j =>
      change FullActiveEdgeEvent n (S j) b (A j) (Δ j) (D j) s at e
      change productTotalMemory (fullActiveEdgeEventTarget n (S j) b (A j) (Δ j) (D j) s e) ≤ b
      change fullActiveEdgeEventWeight n (S j) b (A j) (Δ j) (D j) (ω j) μ ρ V s e ≠ 0 at hw
      rw [fullActiveEdgeEventWeight_full_caps] at hw
      by_contra ht
      exact hw (if_neg (fun hc => ht hc.2))

theorem fullPermutationMixedEventCapEmbed_support (k : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b)
    (hs : productTotalMemory s ≤ b) (e : FullPermutationMixedEvent n S b A Δ D k s) :
    fullPermutationMixedEventWeight n S b A Δ D ω μ q ρ V k s e ≠ 0 ↔
      fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V k (productStateCapEmbed h s)
        (fullPermutationMixedEventCapEmbed n S A Δ D h k s e) ≠ 0 ∧
      productTotalMemory (fullPermutationMixedEventTarget n S B A Δ D k (productStateCapEmbed h s)
        (fullPermutationMixedEventCapEmbed n S A Δ D h k s e)) ≤ b := by
  rw [fullPermutationMixedEventCapEmbed_weight n S A Δ D h ω μ q ρ V k s hs e]
  split_ifs <;> simp_all

theorem fullPermutationMixedEventCapEmbed_weight_of_ne_zero (k : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b)
    (hs : productTotalMemory s ≤ b) (e : FullPermutationMixedEvent n S b A Δ D k s)
    (hw : fullPermutationMixedEventWeight n S b A Δ D ω μ q ρ V k s e ≠ 0) :
    fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V k (productStateCapEmbed h s)
      (fullPermutationMixedEventCapEmbed n S A Δ D h k s e) =
      fullPermutationMixedEventWeight n S b A Δ D ω μ q ρ V k s e := by
  have ht := ((fullPermutationMixedEventCapEmbed_support n S A Δ D h ω μ q ρ V k s hs e).mp hw).2
  exact ((fullPermutationMixedEventCapEmbed_weight n S A Δ D h ω μ q ρ V k s hs e).trans (if_pos ht)).symm

noncomputable def fullPermutationMixedEventCapSupportEquiv (k : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b)
    (hs : productTotalMemory s ≤ b) :
    {e : FullPermutationMixedEvent n S b A Δ D k s //
      fullPermutationMixedEventWeight n S b A Δ D ω μ q ρ V k s e ≠ 0} ≃
    {e : FullPermutationMixedEvent n S B A Δ D k (productStateCapEmbed h s) //
      fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V k (productStateCapEmbed h s) e ≠ 0 ∧
      productTotalMemory (fullPermutationMixedEventTarget n S B A Δ D k (productStateCapEmbed h s) e) ≤ b} :=
  Equiv.ofBijective (fun e => ⟨fullPermutationMixedEventCapEmbed n S A Δ D h k s e.val,
    (fullPermutationMixedEventCapEmbed_support n S A Δ D h ω μ q ρ V k s hs e.val).mp e.property⟩) ⟨by
      intro e f hef
      apply Subtype.ext
      exact fullPermutationMixedEventCapEmbed_injective n S A Δ D h k s (congrArg Subtype.val hef), by
    intro e
    obtain ⟨d, hd⟩ := fullPermutationMixedEventCapEmbed_surjective_of_ne_zero n S A Δ D h ω μ q ρ V k s e.val
      e.property.1 e.property.2
    have hw := (fullPermutationMixedEventCapEmbed_support n S A Δ D h ω μ q ρ V k s hs d).mpr
      (by simpa only [hd] using e.property)
    exact ⟨⟨d, hw⟩, Subtype.ext hd⟩⟩

theorem fullPermutationMixedEventCapSupportEquiv_apply (k : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b)
    (hs : productTotalMemory s ≤ b)
    (e : {e : FullPermutationMixedEvent n S b A Δ D k s //
      fullPermutationMixedEventWeight n S b A Δ D ω μ q ρ V k s e ≠ 0}) :
    (fullPermutationMixedEventCapSupportEquiv n S A Δ D h ω μ q ρ V k s hs e).val =
      fullPermutationMixedEventCapEmbed n S A Δ D h k s e.val := rfl

theorem fullPermutationMixedEventCapSupportEquiv_target (k : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b)
    (hs : productTotalMemory s ≤ b)
    (e : {e : FullPermutationMixedEvent n S b A Δ D k s //
      fullPermutationMixedEventWeight n S b A Δ D ω μ q ρ V k s e ≠ 0}) :
    productStateCapEmbed h (fullPermutationMixedEventTarget n S b A Δ D k s e.val) =
      fullPermutationMixedEventTarget n S B A Δ D k (productStateCapEmbed h s)
        (fullPermutationMixedEventCapSupportEquiv n S A Δ D h ω μ q ρ V k s hs e).val := by
  exact (fullPermutationMixedEventCapEmbed_target n S A Δ D h ω μ q ρ V k s e.val e.property).symm

theorem fullPermutationMixedEventCapSupportEquiv_weight (k : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b)
    (hs : productTotalMemory s ≤ b)
    (e : {e : FullPermutationMixedEvent n S b A Δ D k s //
      fullPermutationMixedEventWeight n S b A Δ D ω μ q ρ V k s e ≠ 0}) :
    fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V k (productStateCapEmbed h s)
        (fullPermutationMixedEventCapSupportEquiv n S A Δ D h ω μ q ρ V k s hs e).val =
      fullPermutationMixedEventWeight n S b A Δ D ω μ q ρ V k s e.val := by
  exact fullPermutationMixedEventCapEmbed_weight_of_ne_zero n S A Δ D h ω μ q ρ V k s hs e.val e.property

end

end Bounty
end

section

/- Transport to paths staying below a height cap. The transported phase
retains its norm bound, and the complementary high-maximum action is exactly
the difference between the full action and its capped part. -/

open Finset Classical

namespace Bounty

universe uK uX uY uE uF

noncomputable def finiteSafePathPhase {K : Type uK} {X : Type uX} {Y : Type uY}
    (E : K → X → Type uE) (F : K → Y → Type uF)
    (t : ∀ k x, E k x → X) (u : ∀ k y, F k y → Y)
    (w : ∀ k x, E k x → ℝ) (v : ∀ k y, F k y → ℝ)
    (height : Y → ℕ) (b : ℕ) (e : X → Y) (P : X → Prop)
    (closed : ∀ k x, P x → ∀ a : FiniteNonzeroEvent E w k x, P (t k x a.val))
    (δ : ∀ k x, P x → FiniteNonzeroEvent E w k x ≃
      FiniteSelectedEvent F (finiteSafeEventPredicate F u v height b) k (e x))
    (ht : ∀ k x (hx : P x) a, e (t k x a.val) = u k (e x) (δ k x hx a).val)
    (ks : List K) (phase : ∀ y, FiniteEventPath F u ks y → ℂ) :
    ∀ x, FiniteEventPath E t ks x → ℂ :=
  finiteSupportedPathPhase E F t u w (finiteSafeEventPredicate F u v height b)
    e P closed δ ht ks phase

theorem finite_safe_path_phase_norm_le {K : Type uK} {X : Type uX} {Y : Type uY}
    (E : K → X → Type uE) (F : K → Y → Type uF)
    (t : ∀ k x, E k x → X) (u : ∀ k y, F k y → Y)
    (w : ∀ k x, E k x → ℝ) (v : ∀ k y, F k y → ℝ)
    (height : Y → ℕ) (b : ℕ) (e : X → Y) (P : X → Prop)
    (closed : ∀ k x, P x → ∀ a : FiniteNonzeroEvent E w k x, P (t k x a.val))
    (δ : ∀ k x, P x → FiniteNonzeroEvent E w k x ≃
      FiniteSelectedEvent F (finiteSafeEventPredicate F u v height b) k (e x))
    (ht : ∀ k x (hx : P x) a, e (t k x a.val) = u k (e x) (δ k x hx a).val)
    (ks : List K) (phase : ∀ y, FiniteEventPath F u ks y → ℂ)
    (hphase : ∀ y p, ‖phase y p‖ ≤ 1) (x : X) (p : FiniteEventPath E t ks x) :
    ‖finiteSafePathPhase E F t u w v height b e P closed δ ht ks phase x p‖ ≤ 1 :=
  finite_supported_path_phase_norm_le E F t u w (finiteSafeEventPredicate F u v height b)
    e P closed δ ht ks phase hphase x p

theorem finite_safe_path_action_transport {K : Type uK} {X : Type uX} {Y : Type uY}
    (E : K → X → Type uE) (F : K → Y → Type uF)
    [∀ k x, Fintype (E k x)] [∀ k y, Fintype (F k y)]
    (t : ∀ k x, E k x → X) (u : ∀ k y, F k y → Y)
    (w : ∀ k x, E k x → ℝ) (v : ∀ k y, F k y → ℝ)
    (height : Y → ℕ) (b : ℕ) (e : X → Y) (P : X → Prop)
    (closed : ∀ k x, P x → ∀ a : FiniteNonzeroEvent E w k x, P (t k x a.val))
    (δ : ∀ k x, P x → FiniteNonzeroEvent E w k x ≃
      FiniteSelectedEvent F (finiteSafeEventPredicate F u v height b) k (e x))
    (ht : ∀ k x (hx : P x) a, e (t k x a.val) = u k (e x) (δ k x hx a).val)
    (hw : ∀ k x (hx : P x) a, v k (e x) (δ k x hx a).val = w k x a.val)
    (ks : List K) (phase : ∀ y, FiniteEventPath F u ks y → ℂ)
    (f : Y → ℂ) (x : X) (hx : P x) (hheight : height (e x) ≤ b) :
    finiteEventPathAction E t w ks
        (finiteSafePathPhase E F t u w v height b e P closed δ ht ks phase)
        (fun x => f (e x)) x =
      finiteEventPathAction F u v ks
        (fun y p => if finiteEventPathMaximum F u height ks y p ≤ b then phase y p else 0)
        f (e x) := by
  let Q := finiteSafeEventPredicate F u v height b
  let _ : ∀ k y, Fintype (FiniteSelectedEvent F Q k y) := finiteSelectedEventFintype F Q
  exact (finite_supported_path_action_transport E F t u w v Q e P closed δ ht hw
    ks phase f x hx).trans
      ((finite_event_path_action_selected F u Q v ks phase f (e x)).trans
        (finite_event_path_action_safe F u v height b ks phase f (e x) hheight).symm)

theorem finite_event_path_action_sub_safe {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) [∀ k x, Fintype (E k x)]
    (t : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (height : X → ℕ) (b : ℕ) (ks : List K)
    (phase : ∀ x, FiniteEventPath E t ks x → ℂ) (f : X → ℂ) (x : X) :
    finiteEventPathAction E t w ks phase f x -
      finiteEventPathAction E t w ks
        (fun x p => if finiteEventPathMaximum E t height ks x p ≤ b then phase x p else 0) f x =
      finiteEventPathAction E t w ks
        (fun x p => if b < finiteEventPathMaximum E t height ks x p then phase x p else 0) f x := by
  unfold finiteEventPathAction
  rw [← sum_sub_distrib]
  apply sum_congr rfl
  intro p _
  by_cases hp : finiteEventPathMaximum E t height ks x p ≤ b
  · simp only [if_pos hp, if_neg (not_lt.mpr hp), mul_zero, zero_mul, sub_self]
  · simp only [if_neg hp, if_pos (Nat.lt_of_not_ge hp), mul_zero, zero_mul, sub_zero]

end Bounty
end

section

/- Bilinear large-sieve bounds retaining a two-sided hyperbolic product window. -/

open Finset

namespace Bounty

theorem dyadic_product_prefix_filter (K X m : ℕ) (hm : 0 < m)
    (T : Finset ℕ) (hT : T ⊆ range (2 ^ K)) :
    (range (min (2 ^ K) (X / m + 1))).filter (fun n => n ∈ T) =
      T.filter (fun n => m * n ≤ X) := by
  ext n
  simp only [mem_filter, mem_range, lt_min_iff, Nat.lt_succ_iff]
  constructor
  · rintro ⟨⟨_, hn⟩, hnT⟩
    refine ⟨hnT, ?_⟩
    simpa only [Nat.mul_comm] using (Nat.le_div_iff_mul_le hm).mp hn
  · rintro ⟨hnT, hprod⟩
    refine ⟨⟨mem_range.mp (hT hnT), ?_⟩, hnT⟩
    exact (Nat.le_div_iff_mul_le hm).mpr (by simpa only [Nat.mul_comm] using hprod)

theorem multiplicative_large_sieve_product_upper (Q : Finset ℕ) {D R N V : ℝ}
    (hD : 0 < D) (hR : 1 ≤ R)
    (hQD : ∀ q ∈ Q, D ≤ (q : ℝ)) (hQR : ∀ q ∈ Q, (q : ℝ) ≤ R)
    (K X : ℕ) (S T : Finset ℕ) (hSpos : ∀ m ∈ S, 0 < m)
    (hT : T ⊆ range (2 ^ K)) (a b : ℕ → ℂ) (hN : 0 ≤ N) (hV : 0 ≤ V)
    (hS : ∀ m ∈ S, (m : ℝ) ≤ N) (hcol : ∀ n ∈ range (2 ^ K), (n : ℝ) ≤ V) :
    (∑ q ∈ Q, 1 / (q.totient : ℝ) * ∑ χ ∈ primitiveCharacters q,
      ‖∑ m ∈ S, ∑ n ∈ T.filter (fun n => m * n ≤ X),
        a m * b n * χ ((m * n : ℕ) : ZMod q)‖) ≤
      (K + 1 : ℝ) * ((6 + 8 * Real.pi) / D) *
        Real.sqrt ((N + R ^ 2) * (V + R ^ 2) *
          (∑ m ∈ S, ‖a m‖ ^ 2) * ∑ n ∈ T, ‖b n‖ ^ 2) := by
  classical
  let κ : ℕ → ℕ := fun m => min (2 ^ K) (X / m + 1)
  let b' : ℕ → ℂ := fun n => if n ∈ T then b n else 0
  have henergy : (∑ n ∈ range (2 ^ K), ‖b' n‖ ^ 2) = ∑ n ∈ T, ‖b n‖ ^ 2 := by
    calc
      _ = ∑ n ∈ T, ‖b' n‖ ^ 2 := by
        symm
        apply sum_subset hT
        intro n hn hnT
        simp [b', hnT]
      _ = _ := sum_congr rfl (fun n hn => by simp [b', hn])
  have hrow (q : ℕ) (χ : DirichletCharacter ℂ q) (m : ℕ) (hm : m ∈ S) :
      (∑ n ∈ range (κ m), a m * b' n * χ ((m * n : ℕ) : ZMod q)) =
        ∑ n ∈ T.filter (fun n => m * n ≤ X),
          a m * b n * χ ((m * n : ℕ) : ZMod q) := by
    simp only [b', mul_ite, ite_mul, mul_zero, zero_mul]
    rw [← sum_filter]
    rw [dyadic_product_prefix_filter K X m (hSpos m hm) T hT]
  have h := multiplicative_large_sieve_dyadic_prefix Q hD hR hQD hQR K S κ
    (fun m _ => min_le_left _ _) a b' hN hV hS hcol
  rw [henergy] at h
  convert h using 1
  apply sum_congr rfl
  intro q hq
  congr 1
  apply sum_congr rfl
  intro χ hχ
  congr 1
  symm
  exact sum_congr rfl (hrow q χ)


theorem sum_product_window_eq_sub {E : Type*} [AddCommGroup E]
    (A B : ℕ) (hAB : A ≤ B) (T : Finset ℕ) (m : ℕ) (w : ℕ → E) :
    (∑ n ∈ T.filter (fun n => A < m * n ∧ m * n ≤ B), w n) =
      (∑ n ∈ T.filter (fun n => m * n ≤ B), w n) -
        ∑ n ∈ T.filter (fun n => m * n ≤ A), w n := by
  have hset : T.filter (fun n => A < m * n ∧ m * n ≤ B) =
      T.filter (fun n => m * n ≤ B) \ T.filter (fun n => m * n ≤ A) := by
    ext n
    simp only [mem_filter, mem_sdiff]
    constructor
    · rintro ⟨hnT, hnA, hnB⟩
      exact ⟨⟨hnT, hnB⟩, fun h => (not_le_of_gt hnA) h.2⟩
    · rintro ⟨⟨hnT, hnB⟩, hnA⟩
      exact ⟨hnT, Nat.lt_of_not_ge (fun h => hnA ⟨hnT, h⟩), hnB⟩
  rw [hset, sum_sdiff_eq_sub]
  intro n hn
  obtain ⟨hnT, hnA⟩ := mem_filter.mp hn
  exact mem_filter.mpr ⟨hnT, hnA.trans hAB⟩

theorem multiplicative_large_sieve_product_window (Q : Finset ℕ) {D R N V : ℝ}
    (hD : 0 < D) (hR : 1 ≤ R)
    (hQD : ∀ q ∈ Q, D ≤ (q : ℝ)) (hQR : ∀ q ∈ Q, (q : ℝ) ≤ R)
    (K A B : ℕ) (S T : Finset ℕ) (hSpos : ∀ m ∈ S, 0 < m)
    (hT : T ⊆ range (2 ^ K)) (a b : ℕ → ℂ) (hN : 0 ≤ N) (hV : 0 ≤ V)
    (hS : ∀ m ∈ S, (m : ℝ) ≤ N) (hcol : ∀ n ∈ range (2 ^ K), (n : ℝ) ≤ V) :
    (∑ q ∈ Q, 1 / (q.totient : ℝ) * ∑ χ ∈ primitiveCharacters q,
      ‖∑ m ∈ S, ∑ n ∈ T.filter (fun n => A < m * n ∧ m * n ≤ B),
        a m * b n * χ ((m * n : ℕ) : ZMod q)‖) ≤
      2 * (K + 1 : ℝ) * ((6 + 8 * Real.pi) / D) *
        Real.sqrt ((N + R ^ 2) * (V + R ^ 2) *
          (∑ m ∈ S, ‖a m‖ ^ 2) * ∑ n ∈ T, ‖b n‖ ^ 2) := by
  by_cases hAB : A ≤ B
  · have hdiff (q : ℕ) (χ : DirichletCharacter ℂ q) :
        (∑ m ∈ S, ∑ n ∈ T.filter (fun n => A < m * n ∧ m * n ≤ B),
          a m * b n * χ ((m * n : ℕ) : ZMod q)) =
        (∑ m ∈ S, ∑ n ∈ T.filter (fun n => m * n ≤ B),
          a m * b n * χ ((m * n : ℕ) : ZMod q)) -
        (∑ m ∈ S, ∑ n ∈ T.filter (fun n => m * n ≤ A),
          a m * b n * χ ((m * n : ℕ) : ZMod q)) := by
      rw [← sum_sub_distrib]
      apply sum_congr rfl
      intro m hm
      exact sum_product_window_eq_sub A B hAB T m _
    have htri :
        (∑ q ∈ Q, 1 / (q.totient : ℝ) * ∑ χ ∈ primitiveCharacters q,
          ‖∑ m ∈ S, ∑ n ∈ T.filter (fun n => A < m * n ∧ m * n ≤ B),
            a m * b n * χ ((m * n : ℕ) : ZMod q)‖) ≤
        (∑ q ∈ Q, 1 / (q.totient : ℝ) * ∑ χ ∈ primitiveCharacters q,
          ‖∑ m ∈ S, ∑ n ∈ T.filter (fun n => m * n ≤ B),
            a m * b n * χ ((m * n : ℕ) : ZMod q)‖) +
        (∑ q ∈ Q, 1 / (q.totient : ℝ) * ∑ χ ∈ primitiveCharacters q,
          ‖∑ m ∈ S, ∑ n ∈ T.filter (fun n => m * n ≤ A),
            a m * b n * χ ((m * n : ℕ) : ZMod q)‖) := by
      rw [← sum_add_distrib]
      apply sum_le_sum
      intro q hq
      rw [← mul_add, ← sum_add_distrib]
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      apply sum_le_sum
      intro χ hχ
      rw [hdiff]
      exact norm_sub_le _ _
    have hB := multiplicative_large_sieve_product_upper Q hD hR hQD hQR
      K B S T hSpos hT a b hN hV hS hcol
    have hA := multiplicative_large_sieve_product_upper Q hD hR hQD hQR
      K A S T hSpos hT a b hN hV hS hcol
    have h := htri.trans (add_le_add hB hA)
    nlinarith only [h]
  · have hempty (m : ℕ) : T.filter (fun n => A < m * n ∧ m * n ≤ B) = ∅ := by
      apply filter_eq_empty_iff.mpr
      intro n hn
      omega
    simp only [hempty, sum_empty, sum_const_zero, norm_zero, mul_zero]
    positivity

theorem multiplicative_large_sieve_product_window_real (Q : Finset ℕ) {D R N V A B : ℝ}
    (hD : 0 < D) (hR : 1 ≤ R)
    (hQD : ∀ q ∈ Q, D ≤ (q : ℝ)) (hQR : ∀ q ∈ Q, (q : ℝ) ≤ R)
    (hA : 0 ≤ A) (hB : 0 ≤ B)
    (K : ℕ) (S T : Finset ℕ) (hSpos : ∀ m ∈ S, 0 < m)
    (hT : T ⊆ range (2 ^ K)) (a b : ℕ → ℂ) (hN : 0 ≤ N) (hV : 0 ≤ V)
    (hS : ∀ m ∈ S, (m : ℝ) ≤ N) (hcol : ∀ n ∈ range (2 ^ K), (n : ℝ) ≤ V) :
    (∑ q ∈ Q, 1 / (q.totient : ℝ) * ∑ χ ∈ primitiveCharacters q,
      ‖∑ m ∈ S, ∑ n ∈ T.filter (fun n : ℕ => A < (m : ℝ) * (n : ℝ) ∧ (m : ℝ) * (n : ℝ) ≤ B),
        a m * b n * χ ((m * n : ℕ) : ZMod q)‖) ≤
      2 * (K + 1 : ℝ) * ((6 + 8 * Real.pi) / D) *
        Real.sqrt ((N + R ^ 2) * (V + R ^ 2) *
          (∑ m ∈ S, ‖a m‖ ^ 2) * ∑ n ∈ T, ‖b n‖ ^ 2) := by
  have h := multiplicative_large_sieve_product_window Q hD hR hQD hQR
    K ⌊A⌋₊ ⌊B⌋₊ S T hSpos hT a b hN hV hS hcol
  simpa only [Nat.floor_lt hA, Nat.le_floor_iff hB, Nat.cast_mul] using h


end Bounty
