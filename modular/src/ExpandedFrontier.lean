/- The exact original unrestricted harmonic main term as a selected endpoint pairing. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_free_positive_harmonic_selected
    {G : Type*} [Fintype G] [dG : DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ) (hξ : 0 < ξ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i)) :
    let cut := repeatedBigPrimePatternCut probes r t i
    let marks := fun j => ell+(cut j).card
    let W := fun n : ℤ => markedDivisorWeight univ P (1/2) V marks n
    ∃ f g : GroupMarkedLists (fun j : ↥(r ∪ t) => P j.val)
        (fun j : ↥(r ∪ t) => marks j.val) → ℂ,
      (∀ u, ‖f u‖ ≤ 1+(Q*Q : ℕ)/ξ) ∧ (∀ u, ‖g u‖ ≤ 1+(Q*Q : ℕ)/ξ) ∧
      ∀ (a b Z : ℝ) (k : ℤ) (pool : Finset ℕ) (α β γ α' β' γ' : ℕ → ℂ),
      let d := physicalFreeFactor cut aux
      let δ : ℤ := k*(d : ℤ)
      let E₀ := fun n : ℕ => (W n : ℂ)*groupMarkedAverage (fun j : ↥(r ∪ t) => P j.val)
        (fun j : ↥(r ∪ t) => marks j.val) (n : ℤ) (fun u => star (f u))*
        invariantTripleEndpoint pool α β γ n
      let E₁ := fun n : ℕ => (W n : ℂ)*groupMarkedAverage (fun j : ↥(r ∪ t) => P j.val)
        (fun j : ↥(r ∪ t) => marks j.val) (n : ℤ) g*
        invariantTripleEndpoint pool α' β' γ' n
      (physicalFreePositiveHarmonicMain P V probes r t hrt Q h ξ i aux a b Z k pool α β γ α' β' γ' =
        (repeatedBigPrimePatternWeight probes r t i*physicalPhase (-(a+b)) d)*
        ∑ n ∈ harmonicPositiveSupport Z k d,
          ((typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) : ℂ)/(n : ℂ))*
          star (physicalPhase (-a) n.natAbs*E₀ n.natAbs)*
          (physicalPhase b (n+δ).natAbs*E₁ (n+δ).natAbs)) ∧
      (physicalFreePositiveHarmonicMain P V probes r t hrt Q h ξ i aux a b Z k pool α β γ α' β' γ' =
        (repeatedBigPrimePatternWeight probes r t i*physicalPhase (-(a+b)) d)*
        ∑ n ∈ harmonicPositiveSupport Z k d,
          (physicalPhasedHarmonicCutoff a b Z k d n/(n : ℂ))*star (E₀ n.natAbs)*E₁ (n+δ).natAbs) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  dsimp only
  obtain ⟨f, g, hf, hg, hsep⟩ := physical_free_prime_average_selected P V probes r t hrt Q h ξ hξ i aux
  refine ⟨f, g, hf, hg, ?_⟩
  intro a b Z k pool α β γ α' β' γ'
  let cut := repeatedBigPrimePatternCut probes r t i
  let d := physicalFreeFactor cut aux
  let marks := fun j => ell+(cut j).card
  let W := fun n : ℤ => markedDivisorWeight univ P (1/2) V marks n
  let δ : ℤ := k*(d : ℤ)
  let E₀ := fun n : ℕ => (W n : ℂ)*groupMarkedAverage (fun j : ↥(r ∪ t) => P j.val)
    (fun j : ↥(r ∪ t) => marks j.val) (n : ℤ) (fun u => star (f u))*
    invariantTripleEndpoint pool α β γ n
  let E₁ := fun n : ℕ => (W n : ℂ)*groupMarkedAverage (fun j : ↥(r ∪ t) => P j.val)
    (fun j : ↥(r ∪ t) => marks j.val) (n : ℤ) g*
    invariantTripleEndpoint pool α' β' γ' n
  let C := repeatedBigPrimePatternWeight probes r t i*physicalPhase (-(a+b)) d
  have hfirst : physicalFreePositiveHarmonicMain P V probes r t hrt Q h ξ i aux a b Z k pool α β γ α' β' γ' =
      C*∑ n ∈ harmonicPositiveSupport Z k d,
        ((typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) : ℂ)/(n : ℂ))*
        star (physicalPhase (-a) n.natAbs*E₀ n.natAbs)*
        (physicalPhase b (n+δ).natAbs*E₁ (n+δ).natAbs) := by
    unfold physicalFreePositiveHarmonicMain
    dsimp only
    rw [mul_sum]
    apply sum_congr rfl
    intro n hn
    have hs := hsep a b n.natAbs (n+δ).natAbs
    let K := ((W n.natAbs*W (n+δ).natAbs : ℝ) : ℂ)*
      groupMarkedAverage P marks (n.natAbs : ℤ) (fun u =>
        groupMarkedAverage P marks ((n+δ).natAbs : ℤ)
          (physicalFreePrimePairCoefficient P V probes r t hrt Q h ξ i aux a b n.natAbs (n+δ).natAbs u))
    have hk : K = C*physicalPhase a n.natAbs*physicalPhase b (n+δ).natAbs*
        ((W n.natAbs : ℂ)*groupMarkedAverage (fun j : ↥(r ∪ t) => P j.val)
          (fun j : ↥(r ∪ t) => marks j.val) (n.natAbs : ℤ) f)*
        ((W (n+δ).natAbs : ℂ)*groupMarkedAverage (fun j : ↥(r ∪ t) => P j.val)
          (fun j : ↥(r ∪ t) => marks j.val) ((n+δ).natAbs : ℤ) g) := by
      apply hs.trans
      dsimp only [C, d, W, marks, cut]
      ac_rfl
    have hp := selected_marked_phased_pair (fun j : ↥(r ∪ t) => P j.val)
      (fun j : ↥(r ∪ t) => marks j.val) f g n.natAbs (n+δ).natAbs
      (W n.natAbs) (W (n+δ).natAbs) a b C
      ((typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) : ℂ)/(n : ℂ))
      (invariantTripleEndpoint pool α β γ n.natAbs)
      (invariantTripleEndpoint pool α' β' γ' (n+δ).natAbs) K hk
    dsimp only [K, E₀, E₁] at hp ⊢
    convert hp using 1 <;> ring
  refine ⟨hfirst, ?_⟩
  rw [hfirst, mul_sum, mul_sum]
  apply sum_congr rfl
  intro n hn
  rw [star_mul, physical_phase_star, neg_neg]
  dsimp only [physicalPhasedHarmonicCutoff, C, d, δ, E₀, E₁, W, marks, cut]
  simp only [div_eq_mul_inv, star_mul]
  ac_rfl

end Bounty
end

section

/- Original determinant shifts are uniformly small relative to the original harmonic dyadic scale. -/

open Finset Filter Real

namespace Bounty

theorem eventually_typeII_determinant_le_half_exp {b K : ℝ}
    (hb : 0 < b) (hK : 0 ≤ K) :
    ∀ᶠ L : ℝ in atTop,
      (typeIIAdmissibleDeterminantBound L K : ℝ) ≤ exp (b*L)/2 := by
  have hgrowth := eventually_mul_rpow_log_add_le_rpow
    (a := (0 : ℝ)) (b := (1 : ℝ)) (c := b)
    (by norm_num) (by norm_num) hb (K+88) (log 6)
  filter_upwards [hgrowth,eventually_ge_atTop (1 : ℝ)] with L hg hL
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  simp only [rpow_zero,rpow_one,mul_one] at hg
  have hlog : log (6*L^(K+88)) ≤ b*L := by
    rw [log_mul (by norm_num) (by positivity),log_rpow hL0]
    linarith
  have hexp : 6*L^(K+88) ≤ exp (b*L) := by
    calc
      _ = exp (log (6*L^(K+88))) := (exp_log (by positivity)).symm
      _ ≤ _ := exp_le_exp.mpr hlog
  have hdet := determinant_bound_le_three_rpow_public hL hK
  linarith

theorem eventually_typeII_original_harmonic_shift_small {b K : ℝ}
    (hb : 0 < b) (hK : 0 ≤ K) :
    ∀ᶠ L : ℝ in atTop, ∀ U V : ℝ,
      exp (b*L) ≤ U → U ≤ exp L → exp (b*L) ≤ V → V ≤ exp L →
      ∀ k ∈ Icc (-(typeIIAdmissibleDeterminantBound L K : ℤ))
        (typeIIAdmissibleDeterminantBound L K : ℤ),
      ∀ j ∈ range (typeIISmoothDyadicCount L),
      |(k : ℝ)| ≤ typeIISmoothDyadicScale U V (U*L^(-K)) j/4 := by
  filter_upwards [eventually_typeII_determinant_le_half_exp hb hK,
    eventually_typeII_harmonic_scale_lower hb hK] with L hdet hscale
  intro U V hUlo _hUhi hVlo _hVhi k hk j _hj
  have hk' : |(k : ℝ)| ≤ (typeIIAdmissibleDeterminantBound L K : ℝ) := by
    apply abs_le.mpr
    obtain ⟨hklo,hkhi⟩ := mem_Icc.mp hk
    constructor
    · exact_mod_cast hklo
    · exact_mod_cast hkhi
  have hZ := hscale U V hUlo hVlo j
  linarith

end Bounty
end

section

/- Global bounds and common support for the expanded Mellin source and phased target. -/

namespace Bounty

theorem harmonic_common_mellin_source_norm_le {Y : ℝ} (hY : 0 < Y)
    (Z v a : ℝ) (F : ℤ → ℂ) (n : ℤ) :
    ‖physicalMellinSource Y Z v (fun m => physicalPhase (-a) m.natAbs *
      ((harmonicCommonCutoff ((m : ℝ) / Y) : ℂ) * F m)) n‖ ≤ 8 * ‖F n‖ := by
  by_cases hn : n = 0
  · subst n
    simp only [physicalMellinSource, Int.cast_zero, div_zero, Complex.ofReal_zero,
      zero_mul, norm_zero]
    positivity
  · have hnr : (n : ℝ) ≠ 0 := by exact_mod_cast hn
    have hratio : (Y / (n : ℝ)) * harmonicCommonCutoff ((n : ℝ) / Y) =
        harmonicCommonCutoff ((n : ℝ) / Y) / ((n : ℝ) / Y) := by
      field_simp
    rw [physical_mellin_phased_source_norm, norm_mul, Complex.norm_real, Real.norm_eq_abs]
    calc
      _ = |(Y / (n : ℝ)) * harmonicCommonCutoff ((n : ℝ) / Y)| * ‖F n‖ := by
        rw [abs_mul]
        ring
      _ = |harmonicCommonCutoff ((n : ℝ) / Y) / ((n : ℝ) / Y)| * ‖F n‖ := by rw [hratio]
      _ ≤ 8 * ‖F n‖ := mul_le_mul_of_nonneg_right
        (harmonic_common_cutoff_div_bound ((n : ℝ) / Y)) (norm_nonneg _)

theorem harmonic_common_phased_target_norm_le (Y b : ℝ) (G : ℤ → ℂ) (n : ℤ) :
    ‖physicalPhase b n.natAbs * ((harmonicCommonCutoff ((n : ℝ) / Y) : ℂ) * G n)‖ ≤
      ‖G n‖ := by
  rw [norm_mul, physical_phase_norm, one_mul, norm_mul, Complex.norm_real,
    Real.norm_eq_abs, abs_of_nonneg (harmonic_common_cutoff_bounds _).1]
  exact mul_le_of_le_one_left (norm_nonneg _) (harmonic_common_cutoff_bounds _).2

theorem harmonic_common_cutoff_scaled_zero_of_not_mem {Y x : ℝ} (hY : 0 < Y)
    (hx : x ∉ Set.Icc (Y / 8) (4 * Real.exp 2 * Y)) :
    harmonicCommonCutoff (x / Y) = 0 := by
  by_contra hne
  have hs := harmonic_common_cutoff_scaled_support hY hne
  exact hx ⟨hs.1.le, hs.2.le⟩

theorem harmonic_common_mellin_source_zero_of_not_mem {Y : ℝ} (hY : 0 < Y)
    (Z v a : ℝ) (F : ℤ → ℂ) (n : ℤ)
    (hn : (n : ℝ) ∉ Set.Icc (Y / 8) (4 * Real.exp 2 * Y)) :
    physicalMellinSource Y Z v (fun m => physicalPhase (-a) m.natAbs *
      ((harmonicCommonCutoff ((m : ℝ) / Y) : ℂ) * F m)) n = 0 := by
  apply physical_mellin_source_zero
  rw [harmonic_common_cutoff_scaled_zero_of_not_mem hY hn]
  simp only [Complex.ofReal_zero, zero_mul, mul_zero]

theorem harmonic_common_phased_target_zero_of_not_mem {Y : ℝ} (hY : 0 < Y)
    (b : ℝ) (G : ℤ → ℂ) (n : ℤ)
    (hn : (n : ℝ) ∉ Set.Icc (Y / 8) (4 * Real.exp 2 * Y)) :
    physicalPhase b n.natAbs * ((harmonicCommonCutoff ((n : ℝ) / Y) : ℂ) * G n) = 0 := by
  rw [harmonic_common_cutoff_scaled_zero_of_not_mem hY hn]
  simp only [Complex.ofReal_zero, zero_mul, mul_zero]

end Bounty
