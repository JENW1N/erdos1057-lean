open Finset
open scoped Classical

theorem finite_exceptional_pairing_norm_le {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hμ : ∀ i x, 0 ≤ μ i x) (hmass : ∀ i, ∑ y, μ i y = 1)
    (U V : Finset I) (k : (∀ i, X i) → ℂ) (hk : ∀ x, ‖k x‖ ≤ 1)
    (f g : (∀ i, X i) → ℂ) (θA θB : ℝ)
    (hA : Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ U U.toList f)) ≤
      θA * Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) f))
    (hB : Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ V V.toList g)) ≤
      θB * Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) g)) :
    ‖cleanRawPairing (finiteProductWeight μ) k (finiteCoordinateComponent μ U U.toList f) g +
      cleanRawPairing (finiteProductWeight μ) k
        (f - finiteCoordinateComponent μ U U.toList f) (finiteCoordinateComponent μ V V.toList g)‖ ≤
      (θA + θB) * Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) f) *
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) g) := by
  have hw : ∀ x, 0 ≤ finiteProductWeight μ x := fun x => prod_nonneg (fun i _ => hμ i (x i))
  calc
    _ ≤ ‖cleanRawPairing (finiteProductWeight μ) k (finiteCoordinateComponent μ U U.toList f) g‖ +
        ‖cleanRawPairing (finiteProductWeight μ) k
          (f - finiteCoordinateComponent μ U U.toList f) (finiteCoordinateComponent μ V V.toList g)‖ := norm_add_le _ _
    _ ≤ Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ U U.toList f)) *
          Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) g) +
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (f - finiteCoordinateComponent μ U U.toList f)) *
          Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ V V.toList g)) :=
      add_le_add (clean_raw_pairing_norm_le _ hw k hk _ _) (clean_raw_pairing_norm_le _ hw k hk _ _)
    _ ≤ (θA * Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) f)) *
          Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) g) +
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) f) *
          (θB * Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) g)) := by
      apply add_le_add
      · exact mul_le_mul_of_nonneg_right hA (Real.sqrt_nonneg _)
      · exact mul_le_mul (finite_probe_complement_norm_le μ hμ hmass U f) hB
          (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)
    _ = _ := by ring

/-- Envelope bounds retain the norms of the original symmetric tests after
additional averaging has changed the vectors used in the raw pairing. -/
theorem finite_exceptional_pairing_envelope {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hμ : ∀ i x, 0 ≤ μ i x) (hmass : ∀ i, ∑ y, μ i y = 1)
    (U V : Finset I) (k : (∀ i, X i) → ℂ) (hk : ∀ x, ‖k x‖ ≤ 1)
    (f g : (∀ i, X i) → ℂ) (a b θA θB : ℝ)
    (hf : Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) f) ≤ a)
    (hg : Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) g) ≤ b)
    (hA : Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ U U.toList f)) ≤ θA * a)
    (hB : Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ V V.toList g)) ≤ θB * b) :
    ‖cleanRawPairing (finiteProductWeight μ) k (finiteCoordinateComponent μ U U.toList f) g +
      cleanRawPairing (finiteProductWeight μ) k
        (f - finiteCoordinateComponent μ U U.toList f) (finiteCoordinateComponent μ V V.toList g)‖ ≤
      (θA + θB) * a * b := by
  have hw : ∀ x, 0 ≤ finiteProductWeight μ x := fun x => prod_nonneg (fun i _ => hμ i (x i))
  have ha : 0 ≤ a := (Real.sqrt_nonneg _).trans hf
  have hθa : 0 ≤ θA * a := (Real.sqrt_nonneg _).trans hA
  calc
    _ ≤ ‖cleanRawPairing (finiteProductWeight μ) k (finiteCoordinateComponent μ U U.toList f) g‖ +
        ‖cleanRawPairing (finiteProductWeight μ) k
          (f - finiteCoordinateComponent μ U U.toList f) (finiteCoordinateComponent μ V V.toList g)‖ := norm_add_le _ _
    _ ≤ Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ U U.toList f)) *
          Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) g) +
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (f - finiteCoordinateComponent μ U U.toList f)) *
          Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ V V.toList g)) :=
      add_le_add (clean_raw_pairing_norm_le _ hw k hk _ _) (clean_raw_pairing_norm_le _ hw k hk _ _)
    _ ≤ (θA * a) * b + a * (θB * b) := by
      apply add_le_add
      · exact mul_le_mul hA hg (Real.sqrt_nonneg _) hθa
      · exact mul_le_mul ((finite_probe_complement_norm_le μ hμ hmass U f).trans hf) hB
          (Real.sqrt_nonneg _) ha
    _ = _ := by ring
end

section
open Finset
theorem exists_summed_external_prime_shifted_sieve :
    ∃ K : ℝ, 0 < K ∧ ∀ (P Q T : Finset ℕ) (μ : ℕ → ℝ) (N : ℕ)
      {z : ℝ} {h : ℕ},
      1 < z → 1 ≤ h → Even h →
      (∀ q ∈ P, q.Prime) → (∀ q ∈ P, q ≠ 2) →
      (∀ q ∈ P, (q : ℝ) ≤ z) → (∀ p ∈ Q, p.Prime) →
      (∀ p ∈ Q, p ∉ P) → (∀ u ∈ T, 0 ≤ μ u) →
      (∀ p ∈ Q, ∀ d ∈ blockSieveModuli P (z^(4 * (h : ℝ) + 2)), p*d ≤ N) →
      |(∑ p ∈ Q, ∑ u ∈ T.filter
          (fun u => p ∣ 2*u + 1 ∧ ∀ q ∈ P, ¬q ∣ 2*u + 1), μ u) -
          (∑ u ∈ T, μ u) * (∏ q ∈ P, (1 - 1 / ((q : ℝ) - 1))) *
            (∑ p ∈ Q, 1 / ((p : ℝ) - 1))| ≤
        (∑ u ∈ T, μ u) * (∏ q ∈ P, (1 - 1 / ((q : ℝ) - 1))) *
          (∑ p ∈ Q, 1 / ((p : ℝ) - 1)) * K * Real.exp (-(h : ℝ)) +
          ∑ m ∈ (Icc 1 N).filter Squarefree, |shiftedTotientSieveRemainder T μ m| := by
  obtain ⟨K, hK, hsieve⟩ := exists_fixed_prime_shifted_sieve
  refine ⟨K, hK, ?_⟩
  intro P Q T μ N z h hz hh heven hP hodd hPz hQ hout hμ hlevel
  let X : ℝ := ∑ u ∈ T, μ u
  let A : ℝ := ∏ q ∈ P, (1 - 1 / ((q : ℝ) - 1))
  let H : ℝ := ∑ p ∈ Q, 1 / ((p : ℝ) - 1)
  let D : ℝ := z^(4 * (h : ℝ) + 2)
  let r : ℕ → ℝ := shiftedTotientSieveRemainder T μ
  let F : ℕ → ℝ := fun p => ∑ u ∈ T.filter
    (fun u => p ∣ 2*u + 1 ∧ ∀ q ∈ P, ¬q ∣ 2*u + 1), μ u
  have hfixed : ∀ p ∈ Q,
      |F p - (X / ((p : ℝ) - 1)) * A| ≤
        (X / ((p : ℝ) - 1)) * A * K * Real.exp (-(h : ℝ)) +
          ∑ d ∈ blockSieveModuli P D, |r (p*d)| := by
    intro p hp
    exact hsieve P T μ p hz hh heven (hQ p hp) (hout p hp) hP hodd hPz hμ
  have hmain : (∑ p ∈ Q, (X / ((p : ℝ) - 1)) * A) = X*A*H := by
    dsimp only [H]
    rw [mul_sum]
    apply sum_congr rfl
    intro p _
    ring
  change |(∑ p ∈ Q, F p) - X*A*H| ≤
    X*A*H*K*Real.exp (-(h : ℝ)) + ∑ m ∈ (Icc 1 N).filter Squarefree, |r m|
  calc
    _ = |∑ p ∈ Q, (F p - (X / ((p : ℝ) - 1)) * A)| := by
      rw [sum_sub_distrib, hmain]
    _ ≤ ∑ p ∈ Q, |F p - (X / ((p : ℝ) - 1)) * A| := abs_sum_le_sum_abs _ _
    _ ≤ ∑ p ∈ Q, ((X / ((p : ℝ) - 1)) * A * K * Real.exp (-(h : ℝ)) +
        ∑ d ∈ blockSieveModuli P D, |r (p*d)|) := sum_le_sum hfixed
    _ = X*A*H*K*Real.exp (-(h : ℝ)) +
        ∑ p ∈ Q, ∑ d ∈ blockSieveModuli P D, |r (p*d)| := by
      rw [sum_add_distrib, ← sum_mul, ← sum_mul, hmain]
    _ ≤ _ := add_le_add le_rfl
      (separated_prime_sieve_remainders_le P Q D N r hP hQ hout hlevel)
end

section
open Finset Filter
open scoped Topology
theorem odd_sieve_moduli_subset (P : Finset ℕ) (D : ℝ) (N : ℕ)
    (hP : ∀ p ∈ P, p.Prime) (hodd : ∀ p ∈ P, p ≠ 2) (hDN : D ≤ (N : ℝ)) :
    blockSieveModuli P D ⊆ oddSquarefreeModuli N := by
  have hprod : Odd (∏ p ∈ P, p) := by
    apply prod_induction (fun p : ℕ => p) Odd
    · intro a b ha hb
      exact ha.mul hb
    · decide
    · intro p hp
      exact (hP p hp).odd_of_ne_two (hodd p hp)
  intro d hd
  obtain ⟨hd0, hdD, hdsq, hdvd⟩ := block_sieve_modulus_properties P hP D hd
  apply mem_filter.mpr
  refine ⟨mem_Icc.mpr ⟨hd0, Nat.cast_le.mp (hdD.trans hDN)⟩, hdsq, ?_⟩
  exact hprod.of_dvd_nat hdvd

theorem exists_candidate_preliminary_sieve :
    ∃ K : ℝ, 0 < K ∧ ∀ c : ℝ, 0 < c → ∀ᶠ L : ℝ in atTop,
      ∀ q : ℝ, 0 ≤ q → ∀ r jStar : ℕ, ∀ z : ℝ, 1 < z →
        ∀ h : ℕ, 1 ≤ h → Even h → ∀ N : ℕ,
        z^(4 * (h : ℝ) + 2) ≤ (N : ℝ) → (N : ℝ) ≤ Real.exp L →
        |(∑ u ∈ shiftedRoughSet (arithmeticProductWindow 1 (Real.exp L)) z,
            candidateCoefficient c L q r jStar u) -
          candidateCoefficientWindowMass c L q r jStar *
            (∏ p ∈ (primeBand 0 z).erase 2, (1 - 1 / ((p : ℝ) - 1)))| ≤
          candidateCoefficientWindowMass c L q r jStar *
            (∏ p ∈ (primeBand 0 z).erase 2, (1 - 1 / ((p : ℝ) - 1))) *
            K * Real.exp (-(h : ℝ)) +
            (candidateNonprincipalTypeIMass c L q r jStar N +
              candidateCoefficientWindowMass c L q r jStar *
                ((16 * primeEulerProductUpperConstant) * L^(-18 : ℝ))) := by
  obtain ⟨K, hK, hsieve⟩ := exists_shifted_totient_rough_sieve
  refine ⟨K, hK, ?_⟩
  intro c hc
  filter_upwards [eventually_candidate_typeI_remainder_bound hc] with L htype
  intro q hq r jStar z hz h hh heven N hDN hN
  have hs := hsieve (arithmeticProductWindow 1 (Real.exp L))
    (candidateCoefficient c L q r jStar) hz hh heven
    (fun u _ => candidate_coefficient_nonneg c L hq r jStar u)
  apply hs.trans
  apply add_le_add le_rfl
  apply le_trans _ (htype q hq r jStar N hN)
  apply sum_le_sum_of_subset_of_nonneg
  · apply odd_sieve_moduli_subset _ _ N
      (fun _ hp => small_prime_pool_prime (mem_of_mem_erase hp))
      (fun _ hp => (mem_erase.mp hp).1) hDN
  · intro d _ _
    exact abs_nonneg _
end

