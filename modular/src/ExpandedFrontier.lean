/- The actual preliminary candidate mass on the common Mertens density scale. -/

open Finset Filter
open scoped Topology

namespace Bounty

theorem exists_candidate_shifted_rough_mass_density_lower (hZ : PrimitiveZeroFreeHalfPlane) :
    ∃ K : ℝ, 0 < K ∧ ∀ (c q b : ℝ) (r h : ℕ),
      0 < c → 0 < r → 0 ≤ q → q < 1 →
      (11/5 : ℝ)*(r : ℝ)*c = 1 →
      0 < b → 1 ≤ h → Even h → b*(4*(h : ℝ)+2) < 1/2 →
      ∃ J : ℕ, ∀ jStar : ℕ, J < jStar → ∀ ε : ℝ, 0 < ε → ∀ᶠ L : ℝ in atTop,
        ((shiftedSieveRatioConstant*Mertens.primeProductLimitConstant/b)*
            (1-K*Real.exp (-(h : ℝ)))-ε) *
          candidateCoefficientWindowMass c L q r jStar / L ≤
        candidateShiftedRoughMass c L q r jStar (Real.exp (b*L)) := by
  obtain ⟨K, hK, hmass⟩ := exists_candidate_shifted_rough_mass_estimate hZ
  refine ⟨K, hK, ?_⟩
  intro c q b r h hc hr hq0 hq1 hcenter hb hh heven hlevel
  obtain ⟨J, hJ⟩ := hmass c q b r h hc hr hq0 hq1 hcenter hb hh heven hlevel
  refine ⟨J, ?_⟩
  intro jStar hj ε hε
  have hpow : Tendsto (fun L : ℝ => L^(-16 : ℝ)) atTop (𝓝 0) :=
    tendsto_rpow_neg_atTop (by norm_num : (0 : ℝ) < 16)
  have hlim := (exponential_shifted_prime_avoidance_product_tendsto hb).mul
    (hpow.const_sub (1-K*Real.exp (-(h : ℝ))))
  simp only [sub_zero] at hlim
  have hev := hlim.eventually_const_lt (show
    (shiftedSieveRatioConstant*Mertens.primeProductLimitConstant/b)*
        (1-K*Real.exp (-(h : ℝ)))-ε <
      (shiftedSieveRatioConstant*Mertens.primeProductLimitConstant/b)*
        (1-K*Real.exp (-(h : ℝ))) by linarith)
  filter_upwards [hJ jStar hj, hev, eventually_gt_atTop (0 : ℝ)] with L hm hd hL
  have hXA : 0 ≤ candidateCoefficientWindowMass c L q r jStar := by
    apply sum_nonneg
    intro u _
    exact candidate_coefficient_nonneg c L hq0 r jStar u
  have hlower : candidateCoefficientWindowMass c L q r jStar *
      shiftedPrimeAvoidanceProduct (Real.exp (b*L)) *
        (1-K*Real.exp (-(h : ℝ))-L^(-16 : ℝ)) ≤
      candidateShiftedRoughMass c L q r jStar (Real.exp (b*L)) := by
    have h := (neg_le_neg hm).trans (neg_abs_le _)
    nlinarith
  calc
    _ ≤ ((L*shiftedPrimeAvoidanceProduct (Real.exp (b*L)))*
          (1-K*Real.exp (-(h : ℝ))-L^(-16 : ℝ))) *
          candidateCoefficientWindowMass c L q r jStar / L := by
      exact div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right hd.le hXA) hL.le
    _ = candidateCoefficientWindowMass c L q r jStar *
        shiftedPrimeAvoidanceProduct (Real.exp (b*L)) *
        (1-K*Real.exp (-(h : ℝ))-L^(-16 : ℝ)) := by field_simp
    _ ≤ _ := hlower

end Bounty
end

section

/- The successor step for actual rough-number short-cell asymptotics. -/

namespace Bounty

open Finset Filter Real
open scoped Topology

theorem uniform_rough_depth_approx_succ_of_prime_error {n : ℕ} {S : ℝ}
    (hS : 0 ≤ S) (hprev : UniformRoughDepthApprox n S)
    (hprime : ∀ a ε : ℝ, 0 < a → 0 < ε →
      ∀ᶠ L : ℝ in atTop, ∀ w : ℝ, a ≤ w →
        |normalizedPrimeCellCount L S (exp (w*L))-1/w| ≤ ε) :
    UniformRoughDepthApprox (n+1) S := by
  intro a b γ₀ gap ha hγ₀ hgap ε hε
  by_cases hγb : γ₀ < b
  · have hεq : 0 < ε/4 := by positivity
    filter_upwards [eventually_gt_atTop (0 : ℝ),
      uniform_rough_depth_cofactor_sum_error hS hprev ha hγ₀ hγb hεq,
      buchstab_depth_prime_kernel_uniform_error n ha hγ₀ hγb hεq,
      eventually_normalized_buchstab_cell_error ha hγ₀ hS 1,
      hprime a (ε/4) ha hεq,
      eventually_logarithmic_cell_width_div_le (S := 0) (by norm_num) hεq]
      with L hL hcofactor hkernel hrec hprimeL hsmall
    intro w γ haw hwb hγ hgapw htop
    have hγw : γ ≤ w := by linarith
    have htop' : w+L^(-S)/L ≤ ((n : ℝ)+3)*γ := by
      simpa only [Nat.cast_add, Nat.cast_one, show (n : ℝ)+1+2 = (n : ℝ)+3 by ring] using htop
    have hc := hcofactor w γ haw hwb hγ hγw htop'
    have hk := hkernel w γ haw hwb hγ hγw
    have hp := hprimeL w haw
    have hr := hrec γ hγ (exp (w*L))
      (exp_le_exp.mpr (mul_le_mul_of_nonneg_right haw hL.le))
      (exp_le_exp.mpr (mul_le_mul_of_nonneg_right hγw hL.le))
    have hs : L^(-(1 : ℝ)) ≤ ε/4 := by
      simpa only [neg_zero, rpow_zero, rpow_neg_one, one_div] using hsmall
    have hrhi := hr.2.trans hs
    have hcl := (abs_le.mp hc).1
    have hcu := (abs_le.mp hc).2
    have hkl := (abs_lt.mp hk).1
    have hku := (abs_lt.mp hk).2
    have hpl := (abs_le.mp hp).1
    have hpu := (abs_le.mp hp).2
    apply abs_le.mpr
    constructor <;> linarith [hr.1]
  · filter_upwards [] with L
    intro w γ haw hwb hγ hgapw htop
    exfalso
    exact hγb (by linarith)

end Bounty

/- Public declaration closure audit. -/
