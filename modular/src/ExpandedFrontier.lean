section

/- Three consecutive selected physical rows retain both normalized
permutation factors and the original signed edge action. -/

open Finset
open scoped Classical
namespace Bounty

section Physical
variable {I K : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (retention : I → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
  (hV : ∀ g, V g ≠ 0)

noncomputable def physicalSelectedEdgeBlock (j : K) (aux : PhysicalAuxLabels P (C j))
    (σ τ : PhysicalPermutations (Fin N) J ell) (R : PhysicalMarkLists P J ell)
    (F : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) : ℂ :=
  physicalObservedMarkRow C k ω β retention ρ V hV none
    (fun o t => if o = .inl σ then
      physicalObservedMarkRow C k ω β retention ρ V hV (some (.inr j))
        (fun o u => if o = .inr (some ⟨j, aux⟩) ∧ u.1 = physicalPermuteLabels τ R then
          physicalObservedMarkRow C k ω β retention ρ V hV none
            (fun o v => if o = .inl (physicalInversePermutations τ) then F (physicalMarkRawReadout v) else 0) u
          else 0) t
      else 0) s

theorem physical_selected_edge_block_eq (j : K) (aux : PhysicalAuxLabels P (C j))
    (σ τ : PhysicalPermutations (Fin N) J ell) (R : PhysicalMarkLists P J ell)
    (F : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) :
    physicalSelectedEdgeBlock C k ω β retention ρ V hV j aux σ τ R F s =
      (((Fintype.card (PhysicalPermutations (Fin N) J ell) : ℝ)⁻¹ : ℂ) ^ 2) *
        (ω j (productActiveMemorySplit (fun g => physicalFullSharedIndices (C j g)) B
          (physicalFullMemoryState (C j) (physicalPermuteLabels σ s.1) s.2.2)).1 aux : ℂ) *
        if physicalListAdmissible (C j) aux (physicalPermuteLabels σ s.1) (physicalPermuteLabels τ R) then
          jointRawTensorCutoff B
            (physicalFullEdgeRawRow (B := B) (C j) (k j) (physicalPermuteLabels σ s.1)
              (physicalPermuteLabels τ R) β ρ V aux) F (physicalMarkRawReadout s)
        else 0 := by
  unfold physicalSelectedEdgeBlock
  rw [physical_observed_selected_permutation_state]
  simp_rw [physical_observed_selected_permutation]
  have he := physical_observed_selected_edge C k ω β retention ρ V hV j aux
    (physicalPermuteLabels τ R)
    (fun t => ((Fintype.card (PhysicalPermutations (Fin N) J ell) : ℝ)⁻¹ : ℂ) * F t)
    (physicalPermuteLabels σ s.1, s.2)
  have he' := congrArg (((Fintype.card (PhysicalPermutations (Fin N) J ell) : ℝ)⁻¹ : ℂ) * ·) he
  convert he'.trans ?_ using 1
  · congr 2
    funext o u
    split_ifs <;> rfl
  · by_cases ha : physicalListAdmissible (C j) aux (physicalPermuteLabels σ s.1)
        (physicalPermuteLabels τ R)
    · simp only [ha, if_true]
      rw [joint_raw_tensor_cutoff_mul B _
        (fun g c F s => physical_full_edge_raw_row_mul _ _ _ _ _ _ _ _ g c F s)]
      ring_nf
      rfl
    · simp only [ha, if_false, mul_zero]

end Physical
end Bounty
end

section

/- The signed grouped comparison for disjoint prime pools, with all subset
atom and product-log hypotheses discharged from fixed group bounds. -/

open Finset Filter
open scoped Classical

universe u

namespace Bounty

theorem eventually_prime_grouped_disjoint_pool_comparison
    (hZ : PrimitiveZeroFreeHalfPlane) (c s z a v D ε : ℝ) (m : ℕ)
    (hc : 0 < c) (hs : 0 ≤ s) (hz : 0 ≤ z) (ha : 0 ≤ a)
    (hv : 0 < v) (hD : 0 ≤ D) (hε : 0 < ε) (hm : 0 < m) :
    let κ := a * Real.log (primeFiberFactorBound v m)
    let s' := s + ε
    let A₀ := D + 2 * (s' + 1)
    let q := 2 * κ + (s' + 1) + 2 * A₀ + 3
    let w := 4 * q + max z q + A₀ + 2
    let x := (s' + w + 2) + 2 * A₀ + 2
    ∀ᶠ L : ℝ in atTop,
    let Q := ⌊L ^ q⌋₊
    let h := L ^ (-w)
    let ξ := L ^ (-x)
    ∀ {G : Type u} [Fintype G] [DecidableEq G]
      {I : G → Type u} [∀ g, Fintype (I g)] [∀ g, DecidableEq (I g)],
    ∀ (P : G → Finset ℕ) (V : G → ℝ),
    Pairwise (fun g h => Disjoint (P g) (P h)) →
    (∀ g p, p ∈ P g → p.Prime ∧ Q < p) →
    (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) →
    (∀ g, v ≤ V g) →
    (∀ g p, p ∈ P g → Real.log p ≤ L ^ s) →
    (Fintype.card G : ℝ) ≤ a * Real.log L →
    (∀ g, ∃ a b : ℝ, P g = primeBand a b ∧ Real.exp (L ^ c) ≤ a ∧ 0 ≤ b) →
    ∀ (probes tails : ∀ g, Finset (I g)),
    (∀ g, Disjoint (probes g) (tails g)) →
    ∀ ell : ℕ,
    (∀ g, (probes g).card = m) → (∀ g, (tails g).card = ell) →
    ∀ r t : Finset G, Disjoint r t →
    ∀ active : Finset (Sigma I), activeᶜ = univ.sigma tails →
    ∀ ζ Θ : ℝ, |ζ| ≤ L ^ z →
    ∀ f g : (∀ g, I g → P g) → ℂ,
    (∀ a, finiteGroupSlotSymmetric a f) → (∀ a, finiteGroupSlotSymmetric a g) →
    let kept := fun U : Finset (Sigma I) => primeProductRetainedCells
      (fun i : U => P i.1.1) (fun i => V i.1.1) h ξ
    ‖cleanRawPairing (finiteProductWeight (fun a : Sigma I => physicalLabelLaw V a.1))
            (primeActivePhase (fun a : Sigma I => P a.1) active ζ Θ)
        (finiteGroupedTailTest (physicalLabelLaw V) tails f)
        (finiteGroupedTailTest (physicalLabelLaw V) tails g) -
      ∑ A ∈ cleanNonemptySubsets (r.sigma probes), ∑ B ∈ cleanNonemptySubsets (t.sigma probes),
        (-1 : ℂ) ^ (A.card + B.card) *
          cleanKernelPairing (finiteProductWeight (fun a : Sigma I => physicalLabelLaw V a.1))
            (primeAsymmetricComparisonKernel (fun a : Sigma I => P a.1) (fun a => V a.1)
              active Q h kept kept ζ Θ A B)
            (finiteGroupedTailTest (physicalLabelLaw V) tails f)
            (finiteGroupedTailTest (physicalLabelLaw V) tails g)‖ ≤
      (Real.sqrt (((ell : ℝ) ^ ell / (m : ℝ) ^ ell) ^ r.card) +
        Real.sqrt (((ell : ℝ) ^ ell / (m : ℝ) ^ ell) ^ t.card) +
        (3 : ℝ) ^ ((r.sigma probes).card + (t.sigma probes).card) * L ^ (-D)) *
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight
          (fun g => finiteProductWeight (fun _ : I g => physicalLabelLaw V g))) f) *
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight
          (fun g => finiteProductWeight (fun _ : I g => physicalLabelLaw V g))) g) := by
  intro κ s' A₀ q w x
  have hκ : 0 ≤ a * Real.log (primeFiberFactorBound v m) :=
    mul_nonneg ha (Real.log_nonneg (one_le_primeFiberFactorBound v m))
  filter_upwards [eventually_prime_grouped_actual_comparison.{u} hZ c
    (a * Real.log (primeFiberFactorBound v m)) (s + ε) z 1 D hc hκ
    (add_nonneg hs hε.le) hz hD,
    eventually_prime_subset_product_log_rpow a s ε m hs hε,
    eventually_gt_atTop (0 : ℝ), eventually_ge_atTop (1 / v)]
    with L hcomp hlogs hL hlarge
  intro Q h ξ G _ _ I _ _ P V hdisj hP hmass hV hlog hcard hband
    probes tails hpt ell hp ht r t hrt active hactive ζ Θ hζ f g hf hg kept
  have hVpos (g : G) : 0 < V g := hv.trans_le (hV g)
  have hVlower (g : G) : L ^ (-1 : ℝ) ≤ V g := by
    have hb := one_div_le_one_div_of_le (one_div_pos.mpr hv) hlarge
    have hb' : 1 / L ≤ v := by simpa only [one_div_one_div] using hb
    simpa only [Real.rpow_neg_one, one_div] using hb'.trans (hV g)
  have hprime (g : G) (p : ℕ) (hp : p ∈ P g) : p.Prime := (hP g p hp).1
  have hpos (g : G) (p : ℕ) (hp : p ∈ P g) : 0 < p := (hprime g p hp).pos
  have hm' (g : G) : (probes g).card ≤ m := (hp g).le
  apply hcomp P V hVpos hP hmass hVlower hband probes tails hpt m ell hm hp ht
    r t hrt active hactive ?_ ?_ ζ Θ hζ f g hf hg
  · intro U hU b
    rcases mem_union.mp hU with hU | hU
    · exact hlogs P r probes hm' hpos hlog hcard U
        ((clean_mem_nonempty_subsets _ _).mp hU).2 b
    · exact hlogs P t probes hm' hpos hlog hcard U
        ((clean_mem_nonempty_subsets _ _).mp hU).2 b
  · intro U hU n
    rcases mem_union.mp hU with hU | hU
    · exact prime_subset_physical_atom_rpow P V hprime hdisj r probes m hv hL hV hm'
        hcard U ((clean_mem_nonempty_subsets _ _).mp hU).2 n
    · exact prime_subset_physical_atom_rpow P V hprime hdisj t probes m hv hL hV hm'
        hcard U ((clean_mem_nonempty_subsets _ _).mp hU).2 n

end Bounty
end

section

/- A two-variable finite sieve with all congruence moments and remainders evaluated. -/

open Finset

namespace Bounty

noncomputable def pairSieveAvoidance (A B C D m : ℕ) (P : Finset ℕ)
    (rough banned : ℕ → Bool) : Finset (ℕ × ℕ) := by
  classical
  exact (pairSieveBaseBox A B C D m).filter
    (fun v => ∀ p ∈ P, ¬pairSieveBadEvent rough banned v p)

theorem exists_finite_pair_sieve_estimate :
    ∃ K : ℝ, 0 < K ∧ ∀ (A B C D m : ℕ) [NeZero m]
      (P : Finset ℕ) (rough banned : ℕ → Bool) {z : ℝ} {h : ℕ},
      A ≤ B → C ≤ D → 1 < z → 1 ≤ h → Even h →
      (∀ p ∈ P, p.Prime) → (∀ p ∈ P, 3 ≤ p) →
      (∀ p ∈ P, ¬p ∣ m) → (∀ p ∈ P, (p : ℝ) ≤ z) →
      |((pairSieveAvoidance A B C D m P rough banned).card : ℝ) -
        (((B : ℝ)-A)*((D : ℝ)-C)*(m.totient : ℝ)/(m : ℝ)^2) *
          ∏ p ∈ P, (1 - pairSieveDensity p (rough p) (banned p))| ≤
      ((((B : ℝ)-A)*((D : ℝ)-C)*(m.totient : ℝ)/(m : ℝ)^2) *
          ∏ p ∈ P, (1 - pairSieveDensity p (rough p) (banned p))) *
            K * Real.exp (-(h : ℝ)) +
        ((m : ℝ)*(z^(4*(h : ℝ)+2))^3 +
          (((B : ℝ)-A)+((D : ℝ)-C))*(z^(4*(h : ℝ)+2))^2) := by
  classical
  obtain ⟨C₀, hC₀, hshell⟩ := exists_finite_prime_reciprocal_shell_bound
  refine ⟨blockSieveModelErrorConstant (3*C₀) (2/9),
    block_sieve_model_error_constant_pos _ _, ?_⟩
  intro A B C D m hm P rough banned z h hAB hCD hz hh heven hP hP3 hPm hPz
  let g := fun p => pairSieveDensity p (rough p) (banned p)
  let M := ((B : ℝ)-A)*((D : ℝ)-C)*(m.totient : ℝ)/(m : ℝ)^2
  have hX : 0 ≤ (B : ℝ)-A := sub_nonneg.mpr (Nat.cast_le.mpr hAB)
  have hY : 0 ≤ (D : ℝ)-C := sub_nonneg.mpr (Nat.cast_le.mpr hCD)
  have hM : 0 ≤ M := by dsimp [M]; positivity
  have hg : ∀ p ∈ P, 0 ≤ g p ∧ g p ≤ 1-(2/9 : ℝ) := by
    intro p hp
    have hb := pair_sieve_density_bounds (hP3 p hp) (rough p) (banned p)
    exact ⟨hb.1, by norm_num; exact hb.2.1⟩
  have hs : ∀ w : ℝ, 1 < w →
      (∑ p ∈ P.filter (fun p : ℕ => w < (p : ℝ) ∧ (p : ℝ) ≤ w^2), g p) ≤ 3*C₀ := by
    intro w hw
    calc
      _ ≤ ∑ p ∈ P.filter (fun p : ℕ => w < (p : ℝ) ∧ (p : ℝ) ≤ w^2),
          3*(1/(p : ℝ)) := by
        apply sum_le_sum
        intro p hp
        simpa only [mul_one_div] using
          (pair_sieve_density_bounds (hP3 p (mem_filter.mp hp).1) (rough p) (banned p)).2.2
      _ = 3 * ∑ p ∈ P.filter (fun p : ℕ => w < (p : ℝ) ∧ (p : ℝ) ≤ w^2),
          1/(p : ℝ) := (mul_sum _ _ _).symm
      _ ≤ 3*C₀ := mul_le_mul_of_nonneg_left (hshell P hP w hw) (by norm_num)
  have hmoment : ∀ S ∈ P.powerset,
      (∑ _v ∈ (pairSieveBaseBox A B C D m).filter
          (fun v => ∀ p ∈ S, pairSieveBadEvent rough banned v p), (1 : ℝ)) =
        M * (∏ p ∈ S, g p) + pairSieveRemainder A B C D m rough banned (∏ p ∈ S, p) := by
    intro S hS
    simpa only [sum_const, nsmul_eq_mul, mul_one, pairSieveIntersection] using
      pair_sieve_exact_moment A B C D m rough banned S (fun p hp => hP p (mem_powerset.mp hS hp))
  have hbound := finite_prime_sieve_events P (pairSieveBaseBox A B C D m)
    (fun _ => (1 : ℝ)) (pairSieveBadEvent rough banned) g
    (pairSieveRemainder A B C D m rough banned) hz hM (by positivity) (by norm_num)
    hh heven hP hPz (fun _ _ => by norm_num) hg hs hmoment
  have herror := pair_sieve_remainder_sum_le A B C D m rough banned hAB hCD P hP hPm
    (z^(4*(h : ℝ)+2)) (Real.rpow_nonneg (zero_lt_one.trans hz).le _)
  simpa only [sum_const, nsmul_eq_mul, mul_one, pairSieveAvoidance] using
    hbound.trans (add_le_add le_rfl herror)

end Bounty
end

section

/- Actual signed physical rows and fully recorded histories preserve finite sums of arbitrary terminal tests. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_mark_raw_extension_sum {A : Type*} {N J ell B : ℕ}
    {P : Fin N → Finset ℕ} (t : Finset A)
    (F : A → PhysicalBoundedMarkState P J ell B → ℂ) (R : PhysicalMarkLists P J ell) :
    physicalMarkRawExtension (fun s => ∑ a ∈ t, F a s) R =
      fun s => ∑ a ∈ t, physicalMarkRawExtension (F a) R s := by
  funext s
  unfold physicalMarkRawExtension
  split_ifs <;> simp

theorem physical_full_edge_raw_row_sum {A : Type*} {N J ell B : ℕ}
    {P : Fin N → Finset ℕ} (C : Fin N → Finset (Fin J)) (k : ℤ)
    (L R : PhysicalMarkLists P J ell) (β : (g : Fin N) → ↥(P g) → ℝ)
    (ρ : ℝ) (V : Fin N → ℝ) (aux : PhysicalAuxLabels P C) (g : Fin N)
    (t : Finset A)
    (F : A → GlobalBirthHistoryState (fun p : ↥(P g) => ZMod p.val) → ℂ)
    (s : GlobalBirthHistoryState (fun p : ↥(P g) => ZMod p.val)) :
    physicalFullEdgeRawRow (B := B) C k L R β ρ V aux g (fun u => ∑ a ∈ t, F a u) s =
      ∑ a ∈ t, physicalFullEdgeRawRow (B := B) C k L R β ρ V aux g (F a) s := by
  unfold physicalFullEdgeRawRow
  exact global_birth_edge_raw_row_sum _ _ _ _ _ _ _ _ _ _ t F

section Physical
variable {I K A H : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (retention : I → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
  (hV : ∀ g, V g ≠ 0)

theorem physical_observed_mark_row_sum (tag : Option (I ⊕ K)) (t : Finset A)
    (F : A → PhysicalMarkObservation P ell C → PhysicalBoundedMarkState P J ell B → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) :
    physicalObservedMarkRow C k ω β retention ρ V hV tag (fun o u => ∑ a ∈ t, F a o u) s =
      ∑ a ∈ t, physicalObservedMarkRow C k ω β retention ρ V hV tag (F a) s := by
  classical
  cases tag with
  | none =>
    simp only [physicalObservedMarkRow, mul_sum]
    exact sum_comm
  | some tag =>
    cases tag with
    | inl j =>
      simp only [physicalObservedMarkRow]
      rw [physical_mark_raw_extension_sum, global_birth_joint_cut_raw_row_sum]
    | inr j =>
      simp only [physicalObservedMarkRow]
      conv_rhs => rw [sum_comm]
      apply sum_congr rfl
      intro R _
      conv_rhs => rw [sum_comm]
      apply sum_congr rfl
      intro aux _
      by_cases hlist : physicalListAdmissible (C j) aux s.1 R
      · simp only [if_pos hlist]
        rw [physical_mark_raw_extension_sum,
          joint_raw_tensor_cutoff_sum B _
            (fun g => physical_full_edge_raw_row_sum (C j) (k j) s.1 R β ρ V aux g),
          mul_sum]
      · simp only [if_neg hlist, mul_zero, sum_const_zero]

theorem physical_recorded_mark_row_sum
    (tag : Option (I ⊕ K)) (before after : Fin N → Finset (Fin J))
    (update : H → FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B →
      PhysicalMarkObservation P ell C →
      FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → H)
    (t : Finset A) (F : A → H × PhysicalBoundedMarkState P J ell B → ℂ)
    (s : H × PhysicalBoundedMarkState P J ell B) :
    physicalRecordedMarkRow C k ω β retention ρ V hV tag before after update
      (fun u => ∑ a ∈ t, F a u) s =
    ∑ a ∈ t, physicalRecordedMarkRow C k ω β retention ρ V hV tag before after update (F a) s := by
  unfold physicalRecordedMarkRow
  exact finite_observed_record_row_sum _ _
    (physical_observed_mark_row_sum C k ω β retention ρ V hV tag) t F s

theorem physical_recorded_mark_history_sum
    (tags : ℕ → Option (I ⊕ K)) (cut : ℕ → Fin N → Finset (Fin J))
    (update : ℕ → H → FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B →
      PhysicalMarkObservation P ell C →
      FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → H)
    (steps : ℕ) (t : Finset A) (F : A → H × PhysicalBoundedMarkState P J ell B → ℂ) :
    finiteRowComposition (S := fun _ => H × PhysicalBoundedMarkState P J ell B)
      (fun i => physicalRecordedMarkRow C k ω β retention ρ V hV
        (tags i) (cut i) (cut (i + 1)) (update i)) steps (fun u => ∑ a ∈ t, F a u) =
    fun s => ∑ a ∈ t,
      finiteRowComposition (S := fun _ => H × PhysicalBoundedMarkState P J ell B)
        (fun i => physicalRecordedMarkRow C k ω β retention ρ V hV
          (tags i) (cut i) (cut (i + 1)) (update i)) steps (F a) s := by
  apply finite_row_composition_sum
  intro i hi
  exact physical_recorded_mark_row_sum C k ω β retention ρ V hV
    (tags i) (cut i) (cut (i + 1)) (update i)

end Physical
end Bounty
