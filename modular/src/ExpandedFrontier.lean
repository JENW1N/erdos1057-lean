    (A ^ (r + 1)) (pow_pos hA _) hw a hstep ζ hmarks hlist hk
  convert hb using 1
  congr 2
  apply sum_congr rfl
  intro d hd
  rw [physical_selected_memory_walk_scalar_factor V patterns C phase K pattern d.val (hlist d)]
  dsimp only [w]
  simp only [Nat.add_sub_cancel]
