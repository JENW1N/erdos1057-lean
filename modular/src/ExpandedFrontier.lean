  · exact hk'.trans ((le_max_right _ _).trans
      (hscale.trans (typeII_smooth_dyadic_scale_mono_zero hU hV hE j)))
  · exact hcut U V (U*L^(-K)) _ hUlo hUhi hVlo hVhi rfl hpos hupper

