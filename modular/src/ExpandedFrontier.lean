      PhysicalMarkObservation P ell C →
      FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → R) :=
  finiteObservedRecordRow (physicalFullObservedRow (B := B) C k ω β retention ρ V before after tag) update

theorem physical_recorded_mark_history_intertwines
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (tags : ℕ → Option (I ⊕ K)) (cut : ℕ → Fin N → Finset (Fin J))
    (hencode : ∀ i, PhysicalMarkRowEncoding C (tags i) (cut i) (cut (i + 1)))
    (update : ℕ → R → FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B →
      PhysicalMarkObservation P ell C →
      FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → R)
    (steps : ℕ)
    (F : R × FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ) :
    finiteRowComposition (S := fun _ => R × PhysicalBoundedMarkState P J ell B)
      (fun i => physicalRecordedMarkRow C k ω β retention ρ V hV
        (tags i) (cut i) (cut (i + 1)) (update i)) steps
      (F ∘ Prod.map id (physicalBoundedMarkEncode (cut steps))) =
    finiteRowComposition (S := fun _ => R × FullMixedLedgerState
      (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
      (fun i => physicalFullRecordedRow C k ω β retention ρ V
        (tags i) (cut i) (cut (i + 1)) (update i)) steps F ∘
      Prod.map id (physicalBoundedMarkEncode (cut 0)) := by
  unfold physicalRecordedMarkRow physicalFullRecordedRow
  refine finite_observed_record_history_intertwines
    (S := fun _ => PhysicalBoundedMarkState P J ell B)
    (T := fun _ => FullMixedLedgerState
      (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (fun i => physicalObservedMarkRow (B := B) C k ω β retention ρ V hV (tags i))
    (fun i => physicalFullObservedRow (B := B) C k ω β retention ρ V
      (cut i) (cut (i + 1)) (tags i))
    (fun i => physicalBoundedMarkEncode (B := B) (cut i)) ?_ update steps F
  intro i G
  funext s
  exact physical_observed_mark_row_intertwines C k ω β retention ρ V hV hP hdis
    (tags i) (cut i) (cut (i + 1)) (hencode i) G s

