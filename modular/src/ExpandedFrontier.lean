theorem finite_coordinate_lift_identity {G : Type*} [DecidableEq G] {Y : G → Type*}
    (g : G) (f : (∀ h, Y h) → ℂ) : finiteCoordinateLift g (fun v => v) f = f := by
  funext x
  simp only [finite_coordinate_lift_eq_update, Function.update_eq_self]

theorem finite_coordinate_lift_composition {G : Type*} [DecidableEq G] {Y : G → Type*}
    (g : G) (P Q : (Y g → ℂ) → Y g → ℂ) (f : (∀ h, Y h) → ℂ) :
    finiteCoordinateLift g P (finiteCoordinateLift g Q f) =
      finiteCoordinateLift g (fun v => P (Q v)) f := by
  funext x
  simp only [finite_coordinate_lift_eq_update, Function.update_self, Function.update_idem]

theorem finite_group_unflatten_update {G : Type*} [DecidableEq G]
    {I X : G → Type*} [∀ g, DecidableEq (I g)]
    (x : ∀ a : Sigma I, X a.1) (g : G) (i : I g) (v : X g) :
    finiteGroupFlattenEquiv.symm (Function.update x ⟨g, i⟩ v) =
      Function.update (finiteGroupFlattenEquiv.symm x) g
        (Function.update (finiteGroupFlattenEquiv.symm x g) i v) := by
  funext h j
  by_cases hh : h = g
  · subst h
    by_cases hj : j = i
    · subst j
      simp only [finite_group_unflatten_apply, Function.update_self]
    · have hs : (⟨g, j⟩ : Sigma I) ≠ ⟨g, i⟩ := by simpa using hj
      simp only [finite_group_unflatten_apply, Function.update_of_ne hs, Function.update_self,
        Function.update_of_ne hj]
  · have hs : (⟨h, j⟩ : Sigma I) ≠ ⟨g, i⟩ := fun he => hh (congrArg Sigma.fst he)
    simp only [finite_group_unflatten_apply, Function.update_of_ne hs, Function.update_of_ne hh]

theorem finite_group_flatten_average {G : Type*} [DecidableEq G]
    {I X : G → Type*} [∀ g, DecidableEq (I g)] [∀ g, Fintype (X g)]
    (μ : ∀ g, X g → ℝ) (g : G) (i : I g) (f : (∀ g, I g → X g) → ℂ) :
    finiteCoordinateAverage (fun a : Sigma I => μ a.1) ⟨g, i⟩ (finiteGroupFlattenFunction f) =
      finiteGroupFlattenFunction (finiteCoordinateLift g
        (finiteCoordinateAverage (fun _ : I g => μ g) i) f) := by
  funext x
  rw [finite_coordinate_average_update]
  change (∑ y, (μ g y : ℂ) * f (finiteGroupFlattenEquiv.symm (Function.update x ⟨g, i⟩ y))) = _
  simp only [finite_group_unflatten_update]
  change _ = finiteCoordinateLift g (finiteCoordinateAverage (fun _ : I g => μ g) i) f
    (finiteGroupFlattenEquiv.symm x)
  rw [finite_coordinate_lift_eq_update, finite_coordinate_average_update]

theorem finite_group_flatten_choice {G : Type*} [DecidableEq G]
    {I X : G → Type*} [∀ g, DecidableEq (I g)] [∀ g, Fintype (X g)]
    (μ : ∀ g, X g → ℝ) (g : G) (i : I g) (S : Finset (Sigma I)) (A : Finset (I g))
    (hi : (⟨g, i⟩ : Sigma I) ∈ S ↔ i ∈ A) (f : (∀ g, I g → X g) → ℂ) :
    finiteCoordinateChoice (fun a : Sigma I => μ a.1) ⟨g, i⟩ S (finiteGroupFlattenFunction f) =
      finiteGroupFlattenFunction (finiteCoordinateLift g
        (finiteCoordinateChoice (fun _ : I g => μ g) i A) f) := by
  have hav := finite_group_flatten_average μ g i f
  by_cases hA : i ∈ A
  · have hS := hi.mpr hA
    unfold finiteCoordinateChoice
    simp only [if_pos hS, if_pos hA]
    rw [hav]
    funext x
    simp only [Pi.sub_apply, finiteGroupFlattenFunction, finite_coordinate_lift_eq_update,
      Function.update_eq_self]
  · have hS : (⟨g, i⟩ : Sigma I) ∉ S := fun h => hA (hi.mp h)
    unfold finiteCoordinateChoice
    simp only [if_neg hS, if_neg hA]
    exact hav

theorem finite_group_flatten_component {G : Type*} [DecidableEq G]
    {I X : G → Type*} [∀ g, DecidableEq (I g)] [∀ g, Fintype (X g)]
    (μ : ∀ g, X g → ℝ) (g : G) (S : Finset (Sigma I)) (A : Finset (I g))
    (is : List (I g)) (hS : ∀ i ∈ is, (⟨g, i⟩ : Sigma I) ∈ S ↔ i ∈ A)
    (f : (∀ g, I g → X g) → ℂ) :
    finiteCoordinateComponent (fun a : Sigma I => μ a.1) S (is.map (Sigma.mk g))
        (finiteGroupFlattenFunction f) =
      finiteGroupFlattenFunction (finiteCoordinateLift g
        (finiteCoordinateComponent (fun _ : I g => μ g) A is) f) := by
  induction is with
  | nil =>
    simp only [List.map_nil, finiteCoordinateComponent, finite_coordinate_lift_identity]
  | cons i is ih =>
    simp only [List.map_cons, finiteCoordinateComponent]
    rw [ih (fun j hj => hS j (List.mem_cons_of_mem _ hj)),
      finite_group_flatten_choice μ g i S A (hS i (List.mem_cons_self)),
      finite_coordinate_lift_composition]
end

