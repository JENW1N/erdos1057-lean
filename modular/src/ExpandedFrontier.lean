theorem physical_initial_recorded_mark_forest_paths
    (hV : ∀ g, V g ≠ 0)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hencode : ∀ i, PhysicalMarkRowEncoding C (tags i) (cut i) (cut (i + 1)))
    (L : PhysicalMarkLists P J ell) :
    let prime := fun g (p : ↥(P g)) => p.val
    let S := fun j g => physicalFullSharedIndices (ell := ell) (C j g)
    let A := fun j (_ : SharedActiveLabels (fun g => ↥(P g)) (S j)) => PhysicalAuxLabels P (C j)
    let Δ := fun j => physicalFullEdgeDelta (ell := ell) (C j) (k j)
    let D := fun j => physicalFullEdgeD (ell := ell) (C j)
