section

variable {J K G : Type*} [Fintype G] [DecidableEq G]
  (P : G → Finset ℕ) (V : G → ℝ) (baseline : ∀ g, P g → ℝ)
  (hpositive : ∀ g (p : P g), 0 < p.val)
  (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
  (hbaseline : ∀ g p, 1 / 2 ≤ baseline g p ∧ baseline g p ≤ 1)
  {M : G → ℕ} (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels (fun g => P g) (S k) → Type*) [∀ k c, Fintype (A k c)]
  (Δ D : ∀ k c, A k c → G → ℤ) (ω : ∀ k c, A k c → ℝ)
  (q : J → ℝ)

include hMass hbaseline

theorem tilted_full_permutation_mixed_path_mask_energy_le_rpow
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    {ρ v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (hC : ∀ j g, q j / ρ ^ 2 + ((1 - q j) * V g / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    {L R : ℝ} (hL : 0 < L) (hgroups : (Fintype.card G : ℝ) ≤ R * Real.log L)
    (steps : List (Option (J ⊕ K)))
    (allowed : ∀ s, FullPermutationMixedPath (fun g (p : P g) => p.val) S B A Δ D steps s → Prop)
    (phase : ∀ s, FullPermutationMixedPath (fun g (p : P g) => p.val) S B A Δ D steps s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1)
    (f : ProductBoundedOrderedState (fun g => P g)
      (fun g => UnrestrictedResidueParticle (fun p : P g => p.val)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    let _ : ∀ g (p : P g), NeZero p.val := fun g p => ⟨Nat.ne_of_gt (hpositive g p)⟩
    finiteWeightedEnergy
      (productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (baseline g))
        (fun g => unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g (baseline g))))
      (fullPermutationMixedPathAction (fun g (p : P g) => p.val) S B A Δ D ω
        (fun g => tiltedPhysicalBirthLaw V g (baseline g)) q ρ V steps
        (fun s p => if allowed s p then phase s p else 0) f) ≤
    L ^ ((steps.filterMap id).length * R * Real.log (mixedMemoryUniformEnergy ρ v vmin vmax T)) *
      finiteWeightedEnergy
        (productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (baseline g))
          (fun g => unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g (baseline g)))) f := by
  let _ : ∀ g (p : P g), NeZero p.val := fun g p => ⟨Nat.ne_of_gt (hpositive g p)⟩
  apply full_permutation_mixed_path_mask_energy_le_rpow (fun g (p : P g) => p.val)
    S B A Δ D ω (fun g => tiltedPhysicalBirthLaw V g (baseline g)) q ρ V
    hω hωmass hρ0 hρ1 hv hvmin hVlo hVhi _ _ hq0 hq1 hD hC T ht hL hgroups
    steps allowed phase hphase f hf
  · intro g p
    exact tiltedPhysicalBirthLaw_pos V g (baseline g) (hvmin.trans_le (hVlo g)) (hpositive g)
      (fun p => lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1 / 2) (hbaseline g p).1) p
  · intro g
    exact (tiltedPhysicalBirthLaw_sum_bounds V g (baseline g)
      (hvmin.trans_le (hVlo g)) (hMass g) (hbaseline g)).2

theorem tilted_full_permutation_mixed_path_mask_energy_parameter_choice
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    {qmax vmin vmax : ℝ} (hqmax0 : 0 ≤ qmax) (hqmax1 : qmax < 1)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hq0 : ∀ j, 0 ≤ q j) (hqmax : ∀ j, q j ≤ qmax)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    {L R : ℝ} (hL : 0 < L) (hgroups : (Fintype.card G : ℝ) ≤ R * Real.log L)
    (steps : List (Option (J ⊕ K)))
    (allowed : ∀ s, FullPermutationMixedPath (fun g (p : P g) => p.val) S B A Δ D steps s → Prop)
    (phase : ∀ s, FullPermutationMixedPath (fun g (p : P g) => p.val) S B A Δ D steps s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1)
    (f : ProductBoundedOrderedState (fun g => P g)
      (fun g => UnrestrictedResidueParticle (fun p : P g => p.val)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    let _ : ∀ g (p : P g), NeZero p.val := fun g p => ⟨Nat.ne_of_gt (hpositive g p)⟩
    let ρ := physicalGhostRhoChoice qmax
    let v := physicalGhostWeightChoice qmax vmax
    finiteWeightedEnergy
      (productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (baseline g))
        (fun g => unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g (baseline g))))
      (fullPermutationMixedPathAction (fun g (p : P g) => p.val) S B A Δ D ω
        (fun g => tiltedPhysicalBirthLaw V g (baseline g)) q ρ V steps
        (fun s p => if allowed s p then phase s p else 0) f) ≤
    L ^ ((steps.filterMap id).length * R * Real.log (mixedMemoryUniformEnergy ρ v vmin vmax T)) *
      finiteWeightedEnergy
        (productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (baseline g))
          (fun g => unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g (baseline g)))) f := by
  let _ : ∀ g (p : P g), NeZero p.val := fun g p => ⟨Nat.ne_of_gt (hpositive g p)⟩
  obtain ⟨hρ0, hρ1, hgap, hv, hthreshold, hconditions⟩ :=
    physical_ghost_parameter_choice (Vmax := vmax) hqmax0 hqmax1
  apply tilted_full_permutation_mixed_path_mask_energy_le_rpow P V baseline hpositive hMass
    hbaseline S B A Δ D ω q hω hωmass hρ0 hρ1 hv hvmin hVlo hVhi hq0
    (fun j => (hqmax j).trans hqmax1.le) _ _ T ht hL hgroups steps allowed phase hphase f hf
  · intro j
    simpa only [one_mul, mul_one] using
      (physical_ghost_scaled_damping_lt_one (hq0 j) (hqmax j) hgap hρ0 hρ1 hthreshold
        (a := 1) (W := 1) (by norm_num) zero_le_one (le_max_left 1 vmax)).le
  · intro j g
    exact (hconditions (q j) (V g) (hq0 j) (hqmax j) (hvmin.trans_le (hVlo g)).le (hVhi g)).2.1

end
end

