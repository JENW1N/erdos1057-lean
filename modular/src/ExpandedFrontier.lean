        ring
      _ ≤ 3*(M*L^Cb)^2*(L^Ce*L^Ce*L^Ce)^2*energy := by gcongr; norm_num
      _ ≤ _ := selected_peel_harmonic_power hL3 hM0 hM he0 he
  have hpair {A B : ℝ} (hA : A ≤ 4*E) (hB : B ≤ 4*E) :
