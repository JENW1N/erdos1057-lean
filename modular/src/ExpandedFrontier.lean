open Finset
open scoped Classical

/-- The real-frequency hypothesis is a compressed ideal block P T_Theta on
symmetric inputs. No uncompressed block or symmetry preservation is required. -/
theorem clean_hybrid_projected_norm_le_of_ideal_blocks {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : G → Finset (Fin J)) (ζ θ : ℝ) (k : ℤ)
    (p : FixedOrderedMemoryLabels Pb N)
    [∀ q : PhysicalPrime Ps, NeZero q.2.val] [∀ g j, NeZero (p g j).val]
    (K : RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb C → ℂ)
    (d : PhysicalSharedLists Ps J) (w : RepeatedBigLists Pb J ell → ℝ) (hw : ∀ x, 0 ≤ w x)
    (Proj : (RepeatedBigLists Pb J ell → ℂ) →ₗ[ℂ] (RepeatedBigLists Pb J ell → ℂ))
    (U : Submodule ℂ (RepeatedBigLists Pb J ell → ℂ)) (hProjU : ∀ v, Proj v ∈ U)
    (hProj : ∀ v, cleanActiveNorm w (Proj v) ≤ cleanActiveNorm w v)
    (M : ℝ) (hM : 0 ≤ M)
    (hblock : ∀ (Θ : ℝ) (v : RepeatedBigLists Pb J ell → ℂ), v ∈ U →
      cleanActiveNorm w (Proj (fun source => ∑ target,
        (∑ aux, repeatedBigKernel Vb b C ζ K aux source target *
          physicalReturnPhase Θ (repeatedBigD C source aux)) * v target)) ≤
        M * cleanActiveNorm w v)
    (f : RepeatedBigLists Pb J ell → (PhysicalResidues Ps × FixedOrderedResidues p) → ℂ) :
    cleanWeightedNorm w (cleanActiveMap Proj
        (cleanHybridCoreAction Vb b C ζ θ k p K d (cleanActiveMap Proj f))) ≤
      M * cleanWeightedNorm w f := by
  rw [clean_hybrid_core_action_translated]
  change cleanWeightedNorm w
    (cleanProjectedTranslatedSum Proj (cleanHybridCoreCoefficient Vb b C ζ θ k K d)
      (fun aux source _ => cleanHybridResidueDirection p (cleanHybridStep k C source aux d)) f) ≤ _
  apply clean_projected_translated_norm_le Proj w hw U hProjU hProj _ _ M hM _ f
  intro χ v hv
  obtain ⟨Θ, hΘ⟩ := clean_hybrid_fourier_block_real_frequency Vb b C ζ θ k p K d χ
  have he : cleanFourierSumBlock (cleanHybridCoreCoefficient Vb b C ζ θ k K d)
      (fun aux source _ => cleanHybridResidueDirection p (cleanHybridStep k C source aux d)) χ v =
      physicalPhase ζ (physicalSharedProduct d) • (fun source => ∑ target,
        (∑ aux, repeatedBigKernel Vb b C ζ K aux source target *
          physicalReturnPhase Θ (repeatedBigD C source aux)) * v target) := by
    funext source
    exact hΘ v source
  rw [he, map_smul]
  simpa only [cleanActiveNorm, Pi.smul_apply, smul_eq_mul, norm_mul, physical_phase_norm, one_mul]
    using hblock Θ v hv
end

