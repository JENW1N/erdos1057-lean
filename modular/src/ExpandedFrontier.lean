open Finset Classical
theorem fullActivePermutation_mul {G : Type*} {P Z : G → Type*} {M : G → ℕ} {B : ℕ}
    (σ τ : FullActiveSlotPermutations M) (x : ProductBoundedOrderedState P Z M B) :
    fullActivePermutation σ (fullActivePermutation τ x) = fullActivePermutation (τ * σ) x := rfl

theorem fullActiveAverage_invariant {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ}
    (f : ProductBoundedOrderedState P Z M B → ℂ) (τ : FullActiveSlotPermutations M)
    (x : ProductBoundedOrderedState P Z M B) :
    fullActiveAverage f (fullActivePermutation τ x) = fullActiveAverage f x := by
  simp only [fullActiveAverage, fullActivePermutation_mul, fullActivePermutationWeight]
  exact Equiv.sum_comp (Equiv.mulLeft τ)
    (fun σ => (((Fintype.card (FullActiveSlotPermutations M) : ℝ)⁻¹ : ℝ) : ℂ) *
      f (fullActivePermutation σ x))

theorem fullActiveAverage_eq_self {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ}
    (f : ProductBoundedOrderedState P Z M B → ℂ)
    (hf : ∀ (τ : FullActiveSlotPermutations M) x, f (fullActivePermutation τ x) = f x) :
    fullActiveAverage f = f := by
  funext x
  simp only [fullActiveAverage, hf]
  rw [← sum_mul, ← Complex.ofReal_sum, fullActivePermutationWeight_mass, Complex.ofReal_one, one_mul]

theorem fullActiveAverage_idempotent {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ}
    (f : ProductBoundedOrderedState P Z M B → ℂ) :
    fullActiveAverage (fullActiveAverage f) = fullActiveAverage f :=
  fullActiveAverage_eq_self _ (fullActiveAverage_invariant f)

theorem fullActiveAverage_cutoff {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ}
    (f : ProductBoundedOrderedState P Z M B → ℂ) :
    fullActiveAverage (productMemoryCutoff f) = productMemoryCutoff (fullActiveAverage f) := by
  funext x
  change (∑ τ : FullActiveSlotPermutations M, (fullActivePermutationWeight M τ : ℂ) *
    (if productTotalMemory x ≤ B then f (fullActivePermutation τ x) else 0)) =
    if productTotalMemory x ≤ B then
      ∑ τ : FullActiveSlotPermutations M, (fullActivePermutationWeight M τ : ℂ) * f (fullActivePermutation τ x)
    else 0
  split_ifs <;> simp only [mul_zero, sum_const_zero]
end

section
open Finset
open scoped Classical
noncomputable def globalBirthBoundedEdgePhase {P : Type*} [DecidableEq P]
    (n : P → ℕ) (Δ D : ℤ) (t B : ℕ) (target : Fin t → P) (H : Finset P) :
    UnrestrictedBoundedPhase n Δ D t B :=
  fun s _stores promotions e fresh =>
    if unrestrictedEdgeTarget s.2.2 Sigma.fst promotions e fresh = target ∧
      (∀ i, fresh i ∉ H) then 1 else 0

theorem global_birth_bounded_edge_phase_norm_le {P : Type*} [DecidableEq P]
    (n : P → ℕ) (Δ D : ℤ) (t B : ℕ) (target : Fin t → P) (H : Finset P)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (stores promotions : Finset (Fin t))
    (e : promotions ↪ unrestrictedResidueEligible n Δ D s.2.2)
    (fresh : UnrestrictedFreshLabels P promotions) :
    ‖globalBirthBoundedEdgePhase n Δ D t B target H s stores promotions e fresh‖ ≤ 1 := by
  unfold globalBirthBoundedEdgePhase
  split_ifs <;> norm_num

theorem global_birth_edge_raw_row_bounded_events {P : Type*}
    [Fintype P] [DecidableEq P] (n : P → ℕ) (Δ D : ℤ) (t B : ℕ)
    (source target : Fin t ↪ P)
    (hsource : ∀ i, ¬ (n (source i) : ℤ) ∣ D)
    (htarget : ∀ i, ¬ (n (target i) : ℤ) ∣ D)
    (H : Finset P) (q : BoundedOrderedTuple (UnrestrictedResidueParticle n) B)
    (β : P → ℝ) (ρ V : ℝ)
    (F : Finset P → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    globalBirthEdgeRawRow source target (fun p => (Δ : ZMod (n p))) H q.2
      (globalBirthRawHitIndices (fun p => (Δ : ZMod (n p)))
        (boundedOrderedTupleToFinite q)) β ρ V B F =
    ∑ e : UnrestrictedBoundedEvent n Δ D t B (source, q),
      (unrestrictedBoundedEventWeight n Δ D (fun p => β p / V) ρ V t B (source, q) e : ℂ) *
        globalBirthBoundedEdgePhase n Δ D t B target H (source, q)
          e.1 e.2.1 e.2.2.1 e.2.2.2 *
        F (H ∪ univ.image (unrestrictedBoundedEventTarget n Δ D t B (source, q) e).1)
          (boundedOrderedTupleToFinite (unrestrictedBoundedEventTarget n Δ D t B (source, q) e).2) := by
  refine (global_birth_edge_raw_row_eq_residue_action n Δ D source target hsource htarget
    H q.2 β ρ V B F).trans ?_
  exact unrestricted_residue_action_raw_event_sum n Δ D (fun p => β p / V) ρ V t B
    (globalBirthBoundedEdgePhase n Δ D t B target H)
    (fun target' q' => F (H ∪ univ.image target') q') (source, q)
end

section
open Finset
theorem exists_rough_interval_count_bound :
    ∃ K : ℝ, 0 < K ∧ ∀ (P : Finset ℕ) (A B : ℕ) {z : ℝ} {h : ℕ},
      1 < z → A ≤ B → 1 ≤ h → Even h →
      (∀ p ∈ P, p.Prime) → (∀ p ∈ P, (p : ℝ) ≤ z) →
      |(((Ioc A B).filter (fun n => ∀ p ∈ P, ¬p ∣ n)).card : ℝ) -
          ((B : ℝ) - A) * (∏ p ∈ P, (1 - 1 / (p : ℝ)))| ≤
        ((B : ℝ) - A) * (∏ p ∈ P, (1 - 1 / (p : ℝ))) * K * Real.exp (-(h : ℝ)) +
          z^(4 * (h : ℝ) + 2) := by
  obtain ⟨K, hK, hsieve⟩ := exists_reciprocal_prime_sieve_events
  refine ⟨K, hK, ?_⟩
  intro P A B z h hz hAB hh heven hP hPz
  have hX : 0 ≤ (B : ℝ) - A := sub_nonneg.mpr (Nat.cast_le.mpr hAB)
  have hcount := hsieve P (Ioc A B) (fun _ => 1) (fun n p => p ∣ n)
    (intervalDivisibilityRemainder A B) hz hX hh heven hP hPz (by intros; norm_num)
    (fun S hS => interval_prime_intersection_moment P hP A B S (mem_powerset.mp hS))
  have hrem := interval_divisibility_remainder_sum_le P hP A B hAB
    (z^(4 * (h : ℝ) + 2)) (Real.rpow_nonneg (zero_lt_one.trans hz).le _)
  have hresult := hcount.trans (add_le_add le_rfl hrem)
  simpa only [sum_const, nsmul_eq_mul, mul_one] using hresult
end

section
open Finset
noncomputable def natSieveCoefficient (P : Finset ℕ) (D : ℝ)
    (a : Finset ℕ → ℝ) (d : ℕ) : ℝ :=
  if d ∈ blockSieveModuli P D then a d.primeFactors else 0

theorem block_sieve_modulus_primeFactors_subset (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) (D : ℝ) {d : ℕ} (hd : d ∈ blockSieveModuli P D) :
    d.primeFactors ⊆ P := by
  have hm := block_sieve_modulus_properties P hP D hd
  have hp0 : (∏ p ∈ P, p) ≠ 0 :=
    prod_ne_zero_iff.mpr (fun p hp => (hP p hp).ne_zero)
  simpa only [Nat.primeFactors_prod hP] using Nat.primeFactors_mono hm.2.2.2 hp0

theorem nat_sieve_coefficient_abs_le_one (P : Finset ℕ) (D : ℝ)
    (a : Finset ℕ → ℝ) (hP : ∀ p ∈ P, p.Prime)
    (ha : ∀ S ∈ P.powerset, |a S| ≤ 1) (d : ℕ) :
    |natSieveCoefficient P D a d| ≤ 1 := by
  unfold natSieveCoefficient
  split_ifs with hd
  · exact ha _ (mem_powerset.mpr (block_sieve_modulus_primeFactors_subset P hP D hd))
  · norm_num

theorem nat_sieve_coefficient_support (P : Finset ℕ) (D : ℝ)
    (a : Finset ℕ → ℝ) (hP : ∀ p ∈ P, p.Prime) {d : ℕ}
    (hd : natSieveCoefficient P D a d ≠ 0) :
    0 < d ∧ (d : ℝ) ≤ D ∧ Squarefree d ∧ d ∣ ∏ p ∈ P, p := by
  have hm : d ∈ blockSieveModuli P D := by
    by_contra hm
    exact hd (by simp [natSieveCoefficient, hm])
  exact block_sieve_modulus_properties P hP D hm

theorem block_sieve_moduli_eq_subset_products (P : Finset ℕ) (D : ℝ)
    (hP : ∀ p ∈ P, p.Prime) :
    blockSieveModuli P D =
      (P.powerset.filter (fun S => ((∏ p ∈ S, p : ℕ) : ℝ) ≤ D)).image
        (fun S => ∏ p ∈ S, p) := by
  ext d
  constructor
  · intro hd
    have hm := block_sieve_modulus_properties P hP D hd
    have heq := Nat.prod_primeFactors_of_squarefree hm.2.2.1
    refine mem_image.mpr ⟨d.primeFactors, mem_filter.mpr ⟨?_, ?_⟩, heq⟩
    · exact mem_powerset.mpr (block_sieve_modulus_primeFactors_subset P hP D hd)
    · simpa only [heq] using hm.2.1
  · intro hd
    obtain ⟨S, hS, rfl⟩ := mem_image.mp hd
    obtain ⟨hS, hD⟩ := mem_filter.mp hS
    have hSP : S ⊆ P := mem_powerset.mp hS
    apply mem_filter.mpr
    refine ⟨mem_Icc.mpr ⟨?_, Nat.le_floor hD⟩, ?_⟩
    · exact prod_pos (fun p hp => (hP p (hSP hp)).pos)
    · exact prod_dvd_prod_of_subset S P (fun p => p) hSP

theorem nat_sieve_coefficient_sum (P : Finset ℕ) (D : ℝ) (a : Finset ℕ → ℝ)
    (hP : ∀ p ∈ P, p.Prime)
    (hlevel : ∀ S ∈ P.powerset, a S ≠ 0 → ((∏ p ∈ S, p : ℕ) : ℝ) ≤ D)
    (F : ℕ → ℝ) :
    (∑ S ∈ P.powerset, a S * F (∏ p ∈ S, p)) =
      ∑ d ∈ blockSieveModuli P D, natSieveCoefficient P D a d * F d := by
  let L := P.powerset.filter (fun S => ((∏ p ∈ S, p : ℕ) : ℝ) ≤ D)
  have hLP : L ⊆ P.powerset := filter_subset _ _
  have himage : blockSieveModuli P D = L.image (fun S => ∏ p ∈ S, p) :=
    block_sieve_moduli_eq_subset_products P D hP
  have hinj : Set.InjOn (fun S : Finset ℕ => ∏ p ∈ S, p) L := by
    intro S hS T hT heq
    have hs : (∏ p ∈ S, p).primeFactors = S :=
      Nat.primeFactors_prod (fun p hp => hP p ((mem_powerset.mp (hLP hS)) hp))
    have ht : (∏ p ∈ T, p).primeFactors = T :=
      Nat.primeFactors_prod (fun p hp => hP p ((mem_powerset.mp (hLP hT)) hp))
    rw [← hs, ← ht]
    exact congrArg Nat.primeFactors heq
  have hcoef : ∀ S ∈ L, natSieveCoefficient P D a (∏ p ∈ S, p) = a S := by
    intro S hS
    have hm : (∏ p ∈ S, p) ∈ blockSieveModuli P D := by
      rw [himage]
      exact mem_image.mpr ⟨S, hS, rfl⟩
    have hpf : (∏ p ∈ S, p).primeFactors = S :=
      Nat.primeFactors_prod (fun p hp => hP p ((mem_powerset.mp (hLP hS)) hp))
    simp only [natSieveCoefficient, if_pos hm, hpf]
  symm
  calc
    _ = ∑ S ∈ L, natSieveCoefficient P D a (∏ p ∈ S, p) * F (∏ p ∈ S, p) := by
      rw [himage, sum_image hinj]
    _ = ∑ S ∈ L, a S * F (∏ p ∈ S, p) :=
      sum_congr rfl (fun S hS => by rw [hcoef S hS])
    _ = _ := by
      apply sum_subset hLP
      intro S hS hn
      have hz : a S = 0 := by
        by_contra hz
        exact hn (mem_filter.mpr ⟨hS, hlevel S hS hz⟩)
      rw [hz, zero_mul]

theorem nat_sieve_coefficient_harmonic_bound (P : Finset ℕ) (D : ℝ)
    (a : Finset ℕ → ℝ) (hP : ∀ p ∈ P, p.Prime)
    (ha : ∀ S ∈ P.powerset, |a S| ≤ 1)
    (hlevel : ∀ S ∈ P.powerset, a S ≠ 0 → ((∏ p ∈ S, p : ℕ) : ℝ) ≤ D) :
    (∑ d ∈ blockSieveModuli P D, |natSieveCoefficient P D a d| / (d : ℝ)) ≤
      ∏ p ∈ P, (1 + 1 / (p : ℝ)) := by
  have hlevel' : ∀ S ∈ P.powerset, |a S| ≠ 0 → ((∏ p ∈ S, p : ℕ) : ℝ) ≤ D := by
    intro S hS hz
    exact hlevel S hS (abs_ne_zero.mp hz)
  calc
    _ = ∑ d ∈ blockSieveModuli P D,
        natSieveCoefficient P D (fun S => |a S|) d * (1 / (d : ℝ)) := by
      apply sum_congr rfl
      intro d hd
      simp only [natSieveCoefficient, if_pos hd]
      ring
    _ = ∑ S ∈ P.powerset, |a S| * (1 / ((∏ p ∈ S, p : ℕ) : ℝ)) :=
      (nat_sieve_coefficient_sum P D (fun S => |a S|) hP hlevel' (fun d => 1 / (d : ℝ))).symm
    _ ≤ ∑ S ∈ P.powerset, 1 / ((∏ p ∈ S, p : ℕ) : ℝ) := by
      apply sum_le_sum
      intro S hS
      exact mul_le_of_le_one_left (by positivity) (ha S hS)
    _ = ∑ S ∈ P.powerset, ∏ p ∈ S, 1 / (p : ℝ) := by
      apply sum_congr rfl
      intro S _
      simp only [Nat.cast_prod, one_div, prod_inv_distrib]
    _ = _ := (prod_one_add P).symm

theorem nat_sieve_polynomial_eq_divisor_sum (P : Finset ℕ) (D : ℝ)
    (a : Finset ℕ → ℝ) (hP : ∀ p ∈ P, p.Prime)
    (hlevel : ∀ S ∈ P.powerset, a S ≠ 0 → ((∏ p ∈ S, p : ℕ) : ℝ) ≤ D)
    (n : ℕ) :
    subsetPolynomial P a (fun p => if p ∣ n then 1 else 0) =
      ∑ d ∈ blockSieveModuli P D, if d ∣ n then natSieveCoefficient P D a d else 0 := by
  calc
    _ = ∑ S ∈ P.powerset, a S * (if (∏ p ∈ S, p) ∣ n then 1 else 0) := by
      apply sum_congr rfl
      intro S hS
      rw [finite_bad_event_indicator_product]
      simp only [prime_subset_product_dvd_iff S
        (fun p hp => hP p ((mem_powerset.mp hS) hp)) n]
    _ = ∑ d ∈ blockSieveModuli P D,
        natSieveCoefficient P D a d * (if d ∣ n then 1 else 0) :=
      nat_sieve_coefficient_sum P D a hP hlevel (fun d => if d ∣ n then 1 else 0)
    _ = _ := by
      apply sum_congr rfl
      intro d _
      split_ifs <;> simp

theorem nat_sieve_polynomial_eq_sum_divisors (P : Finset ℕ) (D : ℝ)
    (a : Finset ℕ → ℝ) (hP : ∀ p ∈ P, p.Prime)
    (hlevel : ∀ S ∈ P.powerset, a S ≠ 0 → ((∏ p ∈ S, p : ℕ) : ℝ) ≤ D)
    {n : ℕ} (hn : n ≠ 0) :
    subsetPolynomial P a (fun p => if p ∣ n then 1 else 0) =
      ∑ d ∈ n.divisors, natSieveCoefficient P D a d := by
  rw [nat_sieve_polynomial_eq_divisor_sum P D a hP hlevel n, ← sum_filter]
  apply sum_subset
  · intro d hd
    exact Nat.mem_divisors.mpr ⟨(mem_filter.mp hd).2, hn⟩
  · intro d hd hnot
    have hm : d ∉ blockSieveModuli P D := by
      intro hm
      exact hnot (mem_filter.mpr ⟨hm, Nat.dvd_of_mem_divisors hd⟩)
    simp only [natSieveCoefficient, if_neg hm]
end

section
open Finset
noncomputable def roughBlockUpper (J : Finset ℕ) (B : ℕ → Finset ℕ) (h n : ℕ) : ℝ :=
  blockSieveUpper J B (fun p => if p ∣ n then 1 else 0) (fun j => (j + 1) * h)

theorem interval_block_sieve_overcount (J : Finset ℕ) (P : ℕ → Finset ℕ)
    (A B : ℕ) {z C : ℝ} {h : ℕ} (hz : 1 < z) (hC : 0 ≤ C)
    (hAB : A ≤ B) (hh : 1 ≤ h) (heven : Even h)
    (hdisj : (J : Set ℕ).PairwiseDisjoint P)
    (hprime : ∀ j ∈ J, ∀ p ∈ P j, p.Prime)
    (hsize : ∀ j ∈ J, ∀ p ∈ P j, Real.log (p : ℝ) ≤ Real.log z / (2 : ℝ)^j)
    (hsum : ∀ j ∈ J, (∑ p ∈ P j, 1 / (p : ℝ)) ≤ C) :
    let M := (∑ n ∈ Ioc A B, roughBlockUpper J P h n) -
      (((Ioc A B).filter (fun n => ∀ p ∈ J.biUnion P, ¬p ∣ n)).card : ℝ)
    0 ≤ M ∧ M ≤ ((B : ℝ) - A) * blockSieveModelErrorConstant C (1/2) *
      Real.exp (-(h : ℝ)) + z^(4 * (h : ℝ) + 2) := by
  have hX : 0 ≤ (B : ℝ) - A := sub_nonneg.mpr (Nat.cast_le.mpr hAB)
  have hP : ∀ p ∈ J.biUnion P, p.Prime := by
    intro p hp
    obtain ⟨j, hj, hp⟩ := mem_biUnion.mp hp
    exact hprime j hj p hp
  have hg : ∀ j ∈ J, ∀ p ∈ P j, 0 ≤ 1 / (p : ℝ) ∧ 1 / (p : ℝ) ≤ 1 - (1/2 : ℝ) := by
    intro j hj p hp
    have hp2 : (2 : ℝ) ≤ p := Nat.cast_le.mpr (hprime j hj p hp).two_le
    refine ⟨by positivity, ?_⟩
    have hd := one_div_le_one_div_of_le (by norm_num : (0 : ℝ) < 2) hp2
    norm_num at hd ⊢
    exact hd
  have hresult := finite_block_sieve_event_overcount J P (Ioc A B) (fun _ => 1)
    (fun n p => p ∣ n) (fun p => 1 / (p : ℝ)) (intervalDivisibilityRemainder A B)
    hz.le hX hC (by norm_num) hh heven hdisj hprime hsize (by intros; norm_num) hg hsum
    (fun S hS => interval_prime_intersection_moment (J.biUnion P) hP A B S (mem_powerset.mp hS))
  dsimp only at hresult ⊢
  simp only [one_mul, sum_const, nsmul_eq_mul, mul_one] at hresult
  have hproduct : (∏ p ∈ J.biUnion P, (1 - 1 / (p : ℝ))) ≤ 1 := by
    apply prod_le_one₀
    · intro p hp
      have hp1 : (1 : ℝ) ≤ p := by exact_mod_cast (hP p hp).one_lt.le
      apply sub_nonneg.mpr
      simpa only [div_one] using one_div_le_one_div_of_le (by norm_num : (0 : ℝ) < 1) hp1
    · intro p _
      exact sub_le_self 1 (by positivity)
  have hmain : ((B : ℝ) - A) * (∏ p ∈ J.biUnion P, (1 - 1 / (p : ℝ))) *
      blockSieveModelErrorConstant C (1/2) * Real.exp (-(h : ℝ)) ≤
      ((B : ℝ) - A) * blockSieveModelErrorConstant C (1/2) * Real.exp (-(h : ℝ)) := by
    apply mul_le_mul_of_nonneg_right _ (Real.exp_pos _).le
    apply mul_le_mul_of_nonneg_right _ (block_sieve_model_error_constant_pos C (1/2)).le
    exact mul_le_of_le_one_right hX hproduct
  have hrem := interval_divisibility_remainder_sum_le (J.biUnion P) hP A B hAB
    (z^(4 * (h : ℝ) + 2)) (Real.rpow_nonneg (zero_lt_one.trans hz).le _)
  exact ⟨hresult.1, hresult.2.trans (add_le_add hmain hrem)⟩

theorem exists_rough_interval_sieve_blocks :
    ∃ K : ℝ, 0 < K ∧ ∀ (P : Finset ℕ) {z : ℝ}, 1 < z →
      (∀ p ∈ P, p.Prime) → (∀ p ∈ P, (p : ℝ) ≤ z) →
      ∃ (J : Finset ℕ) (B : ℕ → Finset ℕ), J.biUnion B = P ∧
        (J : Set ℕ).PairwiseDisjoint B ∧
        (∀ j ∈ J, ∀ p ∈ B j, Real.log (p : ℝ) ≤ Real.log z / (2 : ℝ)^j) ∧
        ∀ h : ℕ, 1 ≤ h → Even h →
          (∀ n : ℕ, 0 ≤ roughBlockUpper J B h n ∧
            (if ∀ p ∈ P, ¬p ∣ n then (1 : ℝ) else 0) ≤ roughBlockUpper J B h n) ∧
          (∀ a b : ℕ, a ≤ b →
            let M := (∑ n ∈ Ioc a b, roughBlockUpper J B h n) -
              (((Ioc a b).filter (fun n => ∀ p ∈ P, ¬p ∣ n)).card : ℝ)
            0 ≤ M ∧ M ≤ ((b : ℝ) - a) * K * Real.exp (-(h : ℝ)) + z^(4 * (h : ℝ) + 2)) := by
  obtain ⟨C, hC, hshell⟩ := exists_finite_prime_reciprocal_shell_bound
  refine ⟨blockSieveModelErrorConstant C (1/2), block_sieve_model_error_constant_pos C (1/2), ?_⟩
  intro P z hz hP hPz
  obtain ⟨J, B, hunion, hdisj, hsub, hband⟩ := exists_dyadic_sieve_blocks_log P hP hPz
  refine ⟨J, B, hunion, hdisj, fun j hj p hp => (hband j hj p hp).2, ?_⟩
  intro h hh heven
  constructor
  · intro n
    have hw : ∀ j ∈ J, ∀ p ∈ B j, 0 ≤ (if p ∣ n then (1 : ℝ) else 0) ∧
        (if p ∣ n then (1 : ℝ) else 0) ≤ 1 := by
      intros
      split_ifs <;> norm_num
    have hc : ∀ j ∈ J, Even ((j + 1) * h) := fun j _ => heven.mul_left (j + 1)
    refine ⟨block_sieve_upper_nonneg J B _ _ hw hc, ?_⟩
    have hs := (block_sieve_sandwich J B _ _ hw hc).2
    rw [← prod_biUnion hdisj, hunion, finite_bad_event_avoidance_product] at hs
    exact hs
  · intro a b hab
    have hm := interval_block_sieve_overcount J B a b hz hC hab hh heven hdisj
      (fun j _ p hp => hP p (hsub j hp)) (fun j hj p hp => (hband j hj p hp).2) (by
        intro j hj
        exact dyadic_sieve_block_mass P (B j) (fun p => 1 / (p : ℝ)) hz j hP
          (by intros; positivity) (hsub j) (fun p hp => (hband j hj p hp).1)
          (fun p hp => (hband j hj p hp).2) (hshell P hP))
    simpa only [hunion] using hm
end

section
open scoped BigOperators Classical
theorem prime_product_ideal_character_reproduction (hZ : PrimitiveZeroFreeHalfPlane) :
    ∃ C : ℝ, 0 < C ∧ ∀ Q : ℕ, 0 < Q →
      ∀ {I : Type*} [Fintype I] [DecidableEq I],
      ∀ (P : I → Finset ℕ) (V : I → ℝ) (i : I),
      (∀ j, 0 < V j) →
      (∀ j p, p ∈ P j → p.Prime ∧ Q < p) →
      (∀ j, ∑ p ∈ P j, 1 / (p : ℝ) = V j) →
      ∀ a b : ℝ, P i = primeBand a b → 2 ≤ a → 0 ≤ b →
      ∀ h ξ : ℝ, 0 < h → 0 < ξ → ∀ kept : Finset ℤ,
      (∀ d ∈ kept, ξ ≤ finiteCellMass (finiteProductWeight (physicalLabelLaw (P := P) V))
        (fun x => upperLogCell h (Real.log (∏ j, (x j).val : ℕ))) d) →
      ∀ (t : BoundedPrimitiveCharacter Q) (y : ∀ j, P j),
      upperLogCell h (Real.log (∏ j, (y j).val : ℕ)) ∈ kept →
        ‖(∑ x, (finiteProductWeight (physicalLabelLaw V) x : ℂ) *
            primeProductIdealKernel P V Q h kept x y *
            boundedPrimitiveValue t ((∏ j, (x j).val : ℕ) : ZMod (boundedPrimitiveModulus t))) -
          boundedPrimitiveValue t ((∏ j, (y j).val : ℕ) : ZMod (boundedPrimitiveModulus t))‖ ≤
        (Q * Q : ℕ) * (((C / V i) * a ^ (-(1 : ℝ) / 32) *
          (1 + Real.log (Q * Q : ℕ) / Real.log a)) / ξ) := by
  obtain ⟨C, hC, hbnd⟩ := prime_family_log_cell_gram hZ
  refine ⟨C, hC, ?_⟩
  intro Q hQ I _ _ P V i hV hp hmass a b hPi ha hb h ξ hh hξ kept hkept t y hy
  let ψ : BoundedPrimitiveCharacter Q → (∀ j, P j) → ℂ := fun s x =>
    star (boundedPrimitiveValue s ((∏ j, (x j).val : ℕ) : ZMod (boundedPrimitiveModulus s)))
  let δ := (C / V i) * a ^ (-(1 : ℝ) / 32) * (1 + Real.log (Q * Q : ℕ) / Real.log a)
  have hVi := hV i
  have hlog : 0 < Real.log a := Real.log_pos (by linarith)
  have hQ1 : (1 : ℝ) ≤ (Q * Q : ℕ) := by
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero (Nat.ne_of_gt hQ) (Nat.ne_of_gt hQ))
  have hδ : 0 ≤ δ := by
    have := Real.log_nonneg hQ1
    dsimp only [δ]
    positivity
  have hunit : ∀ s x, finiteProductWeight (physicalLabelLaw (P := P) V) x ≠ 0 → ‖ψ s x‖ = 1 := by
    intro s x _
    rw [show ψ s x = star (boundedPrimitiveValue s ((∏ j, (x j).val : ℕ) : ZMod (boundedPrimitiveModulus s))) from rfl, norm_star]
    exact prime_tuple_character_norm_one P (boundedPrimitiveValue s)
      (fun j p hj => prime_above_modulus_coprime (hp j p hj).1
        (bounded_primitive_modulus_pos s) (bounded_primitive_modulus_le s) (hp j p hj).2) x
  have hraw : ∀ d ∈ kept, ∀ s u, s ≠ u →
      ‖∑ x : (∀ j, P j), if upperLogCell h (Real.log (∏ j, (x j).val : ℕ)) = d then
        (finiteProductWeight (physicalLabelLaw V) x : ℂ) * (starRingEnd ℂ) (ψ s x) * ψ u x else 0‖ ≤ δ := by
    intro d _ s u hsu
    simpa only [ψ, starRingEnd_apply, star_star] using
      hbnd Q hQ P V i hV (fun j p hj => (hp j p hj).1.pos) hmass a b hPi ha hb h hh d s u hsu
  have hrec := finite_cell_character_reproduction
    (finiteProductWeight (physicalLabelLaw (P := P) V))
    (fun x => upperLogCell h (Real.log (∏ j, (x j).val : ℕ))) kept ψ hunit hδ hξ hkept hraw t y hy
    (fun s => by
      dsimp only [ψ]
      rw [norm_star]
      exact (boundedPrimitiveValue s).norm_le_one _)
  have hc : ((Fintype.card (BoundedPrimitiveCharacter Q) - 1 : ℕ) : ℝ) ≤ (Q * Q : ℕ) := by
    exact_mod_cast (Nat.sub_le (Fintype.card (BoundedPrimitiveCharacter Q)) 1).trans
      (bounded_primitive_character_card_le Q)
  have hout := hrec.trans (mul_le_mul_of_nonneg_right hc (div_nonneg hδ hξ.le))
  simpa only [primeProductIdealKernel, ψ, starRingEnd_apply, star_star, δ] using hout
end

section
open scoped BigOperators Classical
noncomputable def primeProductRetainedCells {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ) (h ξ : ℝ) : Finset ℤ :=
  finiteRetainedCells (finiteProductWeight (physicalLabelLaw (P := P) V))
    (fun x => upperLogCell h (Real.log (∏ j, (x j).val : ℕ))) ξ

theorem prime_product_retained_cell_mass {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ) (h ξ : ℝ) {d : ℤ}
    (hd : d ∈ primeProductRetainedCells P V h ξ) :
    ξ ≤ finiteCellMass (finiteProductWeight (physicalLabelLaw (P := P) V))
      (fun x => upperLogCell h (Real.log (∏ j, (x j).val : ℕ))) d :=
  finite_retained_cell_mass _ _ _ hd

theorem prime_product_log_bounds {I : Type*} [Fintype I]
    (P : I → Finset ℕ) (lo hi : I → ℝ)
    (hp : ∀ i p, p ∈ P i → 0 < p)
    (hrange : ∀ i p, p ∈ P i → lo i ≤ Real.log p ∧ Real.log p ≤ hi i)
    (x : ∀ i, P i) :
    (∑ i, lo i) ≤ Real.log (∏ i, (x i).val : ℕ) ∧
      Real.log (∏ i, (x i).val : ℕ) ≤ ∑ i, hi i := by
  have hpos : ∀ i ∈ (Finset.univ : Finset I), ((x i).val : ℝ) ≠ 0 := by
    intro i _
    exact_mod_cast (hp i (x i).val (x i).property).ne'
  rw [Nat.cast_prod, Real.log_prod hpos]
  exact ⟨Finset.sum_le_sum (fun i _ => (hrange i (x i).val (x i).property).1),
    Finset.sum_le_sum (fun i _ => (hrange i (x i).val (x i).property).2)⟩

theorem prime_product_occupied_cells_card_le {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (lo hi : I → ℝ)
    (hp : ∀ i p, p ∈ P i → 0 < p) (hlh : ∀ i, lo i ≤ hi i)
    (hrange : ∀ i p, p ∈ P i → lo i ≤ Real.log p ∧ Real.log p ≤ hi i)
    {h : ℝ} (hh : 0 < h) :
    ((finiteOccupiedCells (fun x : (∀ i, P i) =>
      upperLogCell h (Real.log (∏ i, (x i).val : ℕ)))).card : ℝ) ≤
      ((∑ i, hi i) - ∑ i, lo i) / h + 2 := by
  exact upper_log_occupied_cells_card_real_le _ hh
    (Finset.sum_le_sum (fun i _ => hlh i)) (prime_product_log_bounds P lo hi hp hrange)

theorem prime_product_discarded_mass_le {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V lo hi : I → ℝ)
    (hp : ∀ i p, p ∈ P i → 0 < p) (hlh : ∀ i, lo i ≤ hi i)
    (hrange : ∀ i p, p ∈ P i → lo i ≤ Real.log p ∧ Real.log p ≤ hi i)
    {h ξ : ℝ} (hh : 0 < h) (hξ : 0 ≤ ξ) :
    (∑ x : (∀ i, P i), if upperLogCell h (Real.log (∏ i, (x i).val : ℕ)) ∉
      primeProductRetainedCells P V h ξ then
        finiteProductWeight (physicalLabelLaw V) x else 0) ≤
      (((∑ i, hi i) - ∑ i, lo i) / h + 2) * ξ := by
  exact upper_log_discarded_mass_le _ _ hh
    (Finset.sum_le_sum (fun i _ => hlh i)) (prime_product_log_bounds P lo hi hp hrange) hξ

theorem prime_product_cell_mass_pos_iff {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ) (hV : ∀ i, 0 < V i)
    (hp : ∀ i p, p ∈ P i → 0 < p) (h : ℝ) (d : ℤ) :
    0 < finiteCellMass (finiteProductWeight (physicalLabelLaw (P := P) V))
      (fun x => upperLogCell h (Real.log (∏ i, (x i).val : ℕ))) d ↔
    d ∈ finiteOccupiedCells (fun x : (∀ i, P i) =>
      upperLogCell h (Real.log (∏ i, (x i).val : ℕ))) := by
  apply finite_cell_mass_pos_iff_occupied
  intro x
  apply Finset.prod_pos
  intro i _
  unfold physicalLabelLaw
  have := hV i
  have hpR : (0 : ℝ) < (x i).val := by exact_mod_cast hp i (x i).val (x i).property
  positivity

theorem prime_product_retained_probability_ge {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V lo hi : I → ℝ) (hV : ∀ i, 0 < V i)
    (hmass : ∀ i, ∑ p ∈ P i, 1 / (p : ℝ) = V i)
    (hp : ∀ i p, p ∈ P i → 0 < p) (hlh : ∀ i, lo i ≤ hi i)
    (hrange : ∀ i p, p ∈ P i → lo i ≤ Real.log p ∧ Real.log p ≤ hi i)
    {h ξ : ℝ} (hh : 0 < h) (hξ : 0 ≤ ξ) :
    1 - (((∑ i, hi i) - ∑ i, lo i) / h + 2) * ξ ≤
    ∑ x : (∀ i, P i), if upperLogCell h (Real.log (∏ i, (x i).val : ℕ)) ∈
      primeProductRetainedCells P V h ξ then finiteProductWeight (physicalLabelLaw V) x else 0 := by
  have hm : ∑ x, finiteProductWeight (physicalLabelLaw (P := P) V) x = 1 :=
    finite_product_weight_sum_one _ (fun i => physical_label_law_sum V i (hV i) (hmass i))
  have hb := finite_retained_probability_ge (finiteProductWeight (physicalLabelLaw (P := P) V))
    (fun x => upperLogCell h (Real.log (∏ i, (x i).val : ℕ))) hξ hm
  have hc := mul_le_mul_of_nonneg_right
    (prime_product_occupied_cells_card_le P lo hi hp hlh hrange hh) hξ
  exact (sub_le_sub_left hc 1).trans hb
end

section
open Finset
theorem totient_sieve_interval_squarefree_prime_support (N : ℕ) :
    ∀ d ∈ (Icc 1 N).filter Squarefree,
      d.primeFactors ⊆ (Icc 1 N).filter Nat.Prime := by
  intro d hd p hp
  have hpri := Nat.prime_of_mem_primeFactors hp
  exact mem_filter.mpr ⟨mem_Icc.mpr ⟨hpri.one_le,
    (Nat.le_of_mem_primeFactors hp).trans (mem_Icc.mp (mem_filter.mp hd).1).2⟩, hpri⟩

theorem totient_sieve_interval_noncoprime_mass (N n : ℕ) (hn : n ≠ 0) :
    (∑ d ∈ (Icc 1 N).filter (fun d => Squarefree d ∧ ¬ Nat.Coprime d n),
      1 / (Nat.totient d : ℝ)) ≤
      (∑ p ∈ n.primeFactors.filter (fun p => p ≤ N), 1 / ((p : ℝ) - 1)) *
        ∏ p ∈ (Icc 1 N).filter Nat.Prime, (1 + 1 / ((p : ℝ) - 1)) := by
  have hprime : ∀ p ∈ (Icc 1 N).filter Nat.Prime, p.Prime :=
    fun p hp => (mem_filter.mp hp).2
  have hf : ((Icc 1 N).filter Nat.Prime).filter (fun p => p ∣ n) =
      n.primeFactors.filter (fun p => p ≤ N) := by
    ext p
    simp only [mem_filter, mem_Icc, Nat.mem_primeFactors, hn, ne_eq, not_false_eq_true,
      and_true]
    constructor
    · rintro ⟨⟨⟨_, hpN⟩, hp⟩, hpn⟩
      exact ⟨⟨hp, hpn⟩, hpN⟩
    · rintro ⟨⟨hp, hpn⟩, hpN⟩
      exact ⟨⟨⟨hp.one_le, hpN⟩, hp⟩, hpn⟩
  have hb := totient_sieve_squarefree_noncoprime_mass
    ((Icc 1 N).filter Nat.Prime) ((Icc 1 N).filter Squarefree) hprime
    (fun d hd => (mem_filter.mp hd).2)
    (totient_sieve_interval_squarefree_prime_support N) n
  simpa only [filter_filter, hf] using hb
end

section
open Finset
open scoped Classical
def globalBirthGhostEventFresh {P : Type*} (n : P → ℕ) (H : Finset P)
    (t B : ℕ) (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (e : BoundedGhostEvent t B s) : Prop :=
  Function.Injective (fun j => (e.2.2 j).1) ∧ ∀ j, (e.2.2 j).1 ∉ H

theorem global_birth_visit_eq_bounded_ghost_ledger_sum {P : Type*} [Fintype P] [DecidableEq P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (β : P → ℝ) (η V ρ : ℝ) (H : Finset P)
    (t B : ℕ) (F : Finset P → BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B) :
    globalBirthGhostVisitRawRow (fun _ => 0) β η V ρ B H s.2.2
      (fun H' q => boundedOrderedZeroExtension (F H') s.1 q) =
      ∑ e : BoundedGhostEvent t B s,
        (boundedGhostEventWeight (physicalGhostRetention n (1 - η) ρ)
          (physicalGhostTermination n (1 - η) ρ) (physicalGhostBirth n (1 - η) ρ V)
          (unrestrictedResidueWeight (fun p => β p / V)) t B s e : ℂ) *
        (if globalBirthGhostEventFresh n H t B s e then 1 else 0) *
          F (H ∪ univ.image (fun j => (e.2.2 j).1)) (boundedGhostEventTarget t B s e) := by
  rw [global_birth_ghost_visit_eq_particle_row]
  unfold globalBirthGhostParticleRow
  rw [Fintype.sum_sigma]
  simp only [Fintype.sum_prod_type]
  rw [← Fin.sum_univ_eq_sum_range]
  apply sum_congr rfl
  intro b _
  apply sum_congr rfl
  intro S _
  rw [mul_sum, sum_div]
  apply sum_congr rfl
  intro z _
  by_cases hc : S.card + b.val ≤ B
  · by_cases hf : globalBirthGhostEventFresh n H t B s ⟨b, S, z⟩
    · have ha : Function.Injective (fun j => (z j).1) ∧
          (∀ j, (z j).1 ∉ H) ∧ S.card + b.val ≤ B := ⟨hf.1, hf.2, hc⟩
      rw [if_pos ha, if_pos hf, mul_one]
      have hq : (retainedBirthTuple s.2.2 S z).1 ≤ B := hc
      rw [boundedOrderedZeroExtension_of_le _ _ _ hq]
      simp only [boundedGhostEventWeight, if_pos hc, boundedGhostEventTarget, dif_pos hq]
      push_cast
      ring
    · have ha : ¬ (Function.Injective (fun j => (z j).1) ∧
          (∀ j, (z j).1 ∉ H) ∧ S.card + b.val ≤ B) := fun h => hf ⟨h.1, h.2.1⟩
      rw [if_neg ha, if_neg hf, mul_zero, mul_zero, zero_div, mul_zero, zero_mul]
  · have ha : ¬ (Function.Injective (fun j => (z j).1) ∧
        (∀ j, (z j).1 ∉ H) ∧ S.card + b.val ≤ B) := fun h => hc h.2.2
    rw [if_neg ha, mul_zero, mul_zero, zero_div]
    simp only [boundedGhostEventWeight, if_neg hc, Complex.ofReal_zero, zero_mul]

theorem global_birth_visit_eq_bounded_ghost_event_sum {P : Type*} [Fintype P] [DecidableEq P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (β : P → ℝ) (η V ρ : ℝ) (H : Finset P)
    (t B : ℕ) (F : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B) :
    globalBirthGhostVisitRawRow (fun _ => 0) β η V ρ B H s.2.2
      (fun _ q => boundedOrderedZeroExtension F s.1 q) =
      ∑ e : BoundedGhostEvent t B s,
        (boundedGhostEventWeight (physicalGhostRetention n (1 - η) ρ)
          (physicalGhostTermination n (1 - η) ρ) (physicalGhostBirth n (1 - η) ρ V)
          (unrestrictedResidueWeight (fun p => β p / V)) t B s e : ℂ) *
        (if globalBirthGhostEventFresh n H t B s e then 1 else 0) *
          F (boundedGhostEventTarget t B s e) :=
  global_birth_visit_eq_bounded_ghost_ledger_sum n β η V ρ H t B (fun _ => F) s
end

section
open Finset
open scoped Classical
theorem physical_bare_edge_bounded_events {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L R : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C)
    (hlist : physicalListAdmissible C aux L R)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (a b k : ℤ) (hstep : b = a + k * (physicalD C L aux : ℤ))
    (g : G) (B : ℕ) (H : Finset ↥(P g))
    (q : BoundedOrderedTuple (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B)
    (β : ↥(P g) → ℝ) (ρ V : ℝ)
    (F : Finset ↥(P g) →
      FiniteOrderedTuple (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) → ℂ) :
    let n := fun p : ↥(P g) => p.val
    let D : ℤ := physicalD C L aux
    let Δ := -k * D
    let t := ell + (C g).card
    let source := physicalGroupUnsharedEmbedding C L g
    let target := physicalGroupUnsharedEmbedding C R g
    globalBirthEdgeRawRow source target (physicalGroupPhaseDelta a b g) H q.2
      (globalBirthRawHitIndices (physicalGroupPhaseDelta a b g)
        (boundedOrderedTupleToFinite q)) β ρ V B F =
    ∑ e : UnrestrictedBoundedEvent n Δ D t B (source, q),
      (unrestrictedBoundedEventWeight n Δ D (fun p => β p / V) ρ V t B (source, q) e : ℂ) *
        globalBirthBoundedEdgePhase n Δ D t B target H (source, q)
          e.1 e.2.1 e.2.2.1 e.2.2.2 *
        F (H ∪ univ.image (unrestrictedBoundedEventTarget n Δ D t B (source, q) e).1)
          (boundedOrderedTupleToFinite (unrestrictedBoundedEventTarget n Δ D t B (source, q) e).2) := by
  dsimp only
  have hδ := physical_group_phase_delta_as_integer_step (P := P)
    a b k (physicalD C L aux : ℤ) hstep g
  simpa only [hδ] using
    global_birth_edge_raw_row_bounded_events (fun p : ↥(P g) => p.val)
      (-k * (physicalD C L aux : ℤ)) (physicalD C L aux : ℤ) (ell + (C g).card) B
      (physicalGroupUnsharedEmbedding C L g) (physicalGroupUnsharedEmbedding C R g)
      (physical_group_unshared_source_not_dvd C L aux hP hdis hlist.2.1 g)
      (physical_group_unshared_target_not_dvd C L R aux hlist hP hdis g)
      H q β ρ V F

section ResiduePath
variable {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell n : ℕ}
  (C : Fin n → G → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations G J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (ζ : ∀ p : PhysicalPrime P, ZMod p.2.val)
  (hmarks : ∀ j : Fin (n + 1), ∀ p ∈ physicalMarkedPrimes (L j),
    ζ p = -(a j : ZMod p.2.val))
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (g : G)
  (hk : ∀ j : Fin n, ∀ s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : ↥(P g) → ℝ) (η : Fin (n + 1) → ℝ) (V ρ : ℝ) (hV : V ≠ 0) (B : ℕ)

theorem physical_group_residue_finite_edge_bounded_events (j : Fin n)
    (H : Finset ↥(P g))
    (q : BoundedOrderedTuple (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B)
    (F : Finset ↥(P g) →
      FiniteOrderedTuple (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) → ℂ) :
    let np := fun p : ↥(P g) => p.val
    let D : ℤ := physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j)
    let Δ := -k j * D
    let t := ell + (C j g).card
    let source := physicalGroupUnsharedEmbedding (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) g
    let target := physicalGroupUnsharedEmbedding (C j) (physicalPermuteLabels (τ j) (L j.succ)) g
    globalBirthRawStepRow
      (physicalGroupResidueFiniteStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis
        g hk β η V ρ hV B (2 * j.val + 1)) F H (boundedOrderedTupleToFinite q) =
    ∑ e : UnrestrictedBoundedEvent np Δ D t B (source, q),
      (unrestrictedBoundedEventWeight np Δ D (fun p => β p / V) ρ V t B (source, q) e : ℂ) *
        globalBirthBoundedEdgePhase np Δ D t B target H (source, q)
          e.1 e.2.1 e.2.2.1 e.2.2.2 *
        F (H ∪ univ.image (unrestrictedBoundedEventTarget np Δ D t B (source, q) e).1)
          (boundedOrderedTupleToFinite (unrestrictedBoundedEventTarget np Δ D t B (source, q) e).2) := by
  exact (physical_group_residue_finite_edge_row C aux k L a σ τ hstep ζ hmarks
    hlist hP hdis g hk β η V ρ hV B j F H (boundedOrderedTupleToFinite q)).trans
    (physical_bare_edge_bounded_events (C j)
      (physicalPermuteLabels (σ j) (L j.castSucc))
      (physicalPermuteLabels (τ j) (L j.succ)) (aux j) (hlist j) hP hdis
      (a j.castSucc) (a j.succ) (k j) (hstep j) g B H q β ρ V F)

end ResiduePath
end

section
open Finset
theorem exists_rough_sieve_divisor_weights :
    ∃ K : ℝ, 0 < K ∧ ∀ (P : Finset ℕ) {z : ℝ}, 1 < z →
      (∀ p ∈ P, p.Prime) → (∀ p ∈ P, (p : ℝ) ≤ z) →
      ∀ h : ℕ, 1 ≤ h → Even h → ∃ lam : ℕ → ℝ,
        (∀ d, |lam d| ≤ 1) ∧
        (∀ d, lam d ≠ 0 → 0 < d ∧ (d : ℝ) ≤ z^(4 * (h : ℝ) + 2) ∧
          Squarefree d ∧ d ∣ ∏ p ∈ P, p) ∧
        (∀ n : ℕ, n ≠ 0 → 0 ≤ ∑ d ∈ n.divisors, lam d ∧
          (if ∀ p ∈ P, ¬p ∣ n then (1 : ℝ) else 0) ≤ ∑ d ∈ n.divisors, lam d) ∧
        (∑ d ∈ blockSieveModuli P (z^(4 * (h : ℝ) + 2)), |lam d| / (d : ℝ)) ≤
          ∏ p ∈ P, (1 + 1 / (p : ℝ)) ∧
        ∀ a b : ℕ, a ≤ b →
          let M := (∑ n ∈ Ioc a b, ∑ d ∈ n.divisors, lam d) -
            (((Ioc a b).filter (fun n => ∀ p ∈ P, ¬p ∣ n)).card : ℝ)
          0 ≤ M ∧ M ≤ ((b : ℝ) - a) * K * Real.exp (-(h : ℝ)) + z^(4 * (h : ℝ) + 2) := by
  obtain ⟨K, hK, hblocks⟩ := exists_rough_interval_sieve_blocks
  refine ⟨K, hK, ?_⟩
  intro P z hz hP hPz h hh heven
  obtain ⟨J, B, hunion, hdisj, hsize, hcontrol⟩ := hblocks P hz hP hPz
  let cap := fun j => (j + 1) * h
  let a := blockSieveSubsetUpperCoefficient J B cap
  let D := z^(4 * (h : ℝ) + 2)
  let lam := natSieveCoefficient P D a
  have ha : ∀ S ∈ P.powerset, |a S| ≤ 1 :=
    fun S _ => abs_block_sieve_subset_upper_coefficient_le_one J B cap S
  have hlevel : ∀ S ∈ P.powerset, a S ≠ 0 → ((∏ p ∈ S, p : ℕ) : ℝ) ≤ D := by
    intro S _ hS
    have hprime : ∀ j ∈ J, ∀ p ∈ B j, p.Prime := by
      intro j hj p hp
      apply hP p
      rw [← hunion]
      exact mem_biUnion.mpr ⟨j, hj, hp⟩
    simpa only [Nat.cast_prod] using
      (block_sieve_upper_coefficient_level J B S h hz.le hdisj hprime hsize hS).2
  have heq (n : ℕ) (hn : n ≠ 0) : roughBlockUpper J B h n = ∑ d ∈ n.divisors, lam d := by
    have hexp := block_sieve_upper_expansion J B (fun p => if p ∣ n then (1 : ℝ) else 0) cap hdisj
    rw [hunion] at hexp
    exact hexp.trans (nat_sieve_polynomial_eq_sum_divisors P D a hP hlevel hn)
  have hpoint := (hcontrol h hh heven).1
  have hover := (hcontrol h hh heven).2
  refine ⟨lam, fun d => nat_sieve_coefficient_abs_le_one P D a hP ha d,
    fun d hd => nat_sieve_coefficient_support P D a hP hd, ?_,
    nat_sieve_coefficient_harmonic_bound P D a hP ha hlevel, ?_⟩
  · intro n hn
    simpa only [heq n hn] using hpoint n
  · intro a b hab
    have hsum : (∑ n ∈ Ioc a b, roughBlockUpper J B h n) =
        ∑ n ∈ Ioc a b, ∑ d ∈ n.divisors, lam d := by
      apply sum_congr rfl
      intro n hn
      exact heq n (Nat.ne_of_gt (lt_of_le_of_lt (Nat.zero_le a) (mem_Ioc.mp hn).1))
    have hm := hover a b hab
    dsimp only at hm ⊢
    rwa [hsum] at hm
end

section
open Finset
open scoped Classical
section Joint
variable {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
  [∀ g, DecidableEq (P g)] (n : (g : Fin N) → P g → ℕ)
  (Δ D : Fin N → ℤ) (t : Fin N → ℕ) (B : ℕ)
  (source target : (g : Fin N) → Fin (t g) ↪ P g)
  (H : (g : Fin N) → Finset (P g))
  (q : (g : Fin N) → BoundedOrderedTuple (UnrestrictedResidueParticle (n g)) B)

noncomputable def boundedEdgeJointRawTarget
    (e : UnrestrictedJointEvent n Δ D t B (fun g => (source g, q g))) :
    GlobalBirthJointState (fun g p => ZMod (n g p)) :=
  fun g =>
    let u := unrestrictedBoundedEventTarget (n g) (Δ g) (D g) (t g) B (source g, q g) (e g)
    (H g ∪ univ.image u.1, boundedOrderedTupleToFinite u.2)

noncomputable def boundedEdgeJointPhase
    (e : UnrestrictedJointEvent n Δ D t B (fun g => (source g, q g))) : ℂ :=
  ∏ g, globalBirthBoundedEdgePhase (n g) (Δ g) (D g) (t g) B (target g) (H g)
    (source g, q g) (e g).1 (e g).2.1 (e g).2.2.1 (e g).2.2.2

omit [∀ g, Fintype (P g)] in
theorem bounded_edge_joint_phase_norm_le
    (e : UnrestrictedJointEvent n Δ D t B (fun g => (source g, q g))) :
    ‖boundedEdgeJointPhase n Δ D t B source target H q e‖ ≤ 1 := by
  unfold boundedEdgeJointPhase
  rw [norm_prod]
  apply prod_le_one₀
  · intro g _
    exact norm_nonneg _
  · intro g _
    exact global_birth_bounded_edge_phase_norm_le (n g) (Δ g) (D g) (t g) B
      (target g) (H g) (source g, q g) (e g).1 (e g).2.1 (e g).2.2.1 (e g).2.2.2

theorem global_birth_joint_cut_edge_events_of_rows
    (β : (g : Fin N) → P g → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    {a b : (g : Fin N) → P g → Bool}
    (step : (g : Fin N) → GlobalBirthRawStep (R := fun p => ZMod (n g p)) (a g) (b g))
    (hrows : ∀ g (K : GlobalBirthHistoryState (fun p => ZMod (n g p)) → ℂ),
      globalBirthRawStepRow (step g) (fun H' q' => K (H', q')) (H g)
        (boundedOrderedTupleToFinite (q g)) =
      ∑ e : UnrestrictedBoundedEvent (n g) (Δ g) (D g) (t g) B (source g, q g),
        (unrestrictedBoundedEventWeight (n g) (Δ g) (D g)
          (fun p => β g p / V g) ρ (V g) (t g) B (source g, q g) e : ℂ) *
        globalBirthBoundedEdgePhase (n g) (Δ g) (D g) (t g) B (target g) (H g)
          (source g, q g) e.1 e.2.1 e.2.2.1 e.2.2.2 *
        K (H g ∪ univ.image (unrestrictedBoundedEventTarget (n g) (Δ g) (D g) (t g) B (source g, q g) e).1,
          boundedOrderedTupleToFinite (unrestrictedBoundedEventTarget (n g) (Δ g) (D g) (t g) B (source g, q g) e).2))
    (F : GlobalBirthJointState (fun g p => ZMod (n g p)) → ℂ) :
    globalBirthJointCutRawRow step B B F (fun g => (H g, boundedOrderedTupleToFinite (q g))) =
      ∑ e : UnrestrictedJointEvent n Δ D t B (fun g => (source g, q g)),
        (unrestrictedJointCutoffEventWeight n Δ D (fun g p => β g p / V g) ρ V t B
          (fun g => (source g, q g)) e : ℂ) *
        boundedEdgeJointPhase n Δ D t B source target H q e *
          F (boundedEdgeJointRawTarget n Δ D t B source H q e) := by
  have hr := fin_tensor_row_events_at N
    (fun g (K : GlobalBirthHistoryState (fun p => ZMod (n g p)) → ℂ)
      (u : GlobalBirthHistoryState (fun p => ZMod (n g p))) =>
      globalBirthRawStepRow (step g) (fun H' q' => K (H', q')) u.1 u.2)
    (fun g => (H g, boundedOrderedTupleToFinite (q g)))
    (fun g => UnrestrictedBoundedEvent (n g) (Δ g) (D g) (t g) B (source g, q g))
    (fun g e =>
      (H g ∪ univ.image (unrestrictedBoundedEventTarget (n g) (Δ g) (D g) (t g) B (source g, q g) e).1,
        boundedOrderedTupleToFinite (unrestrictedBoundedEventTarget (n g) (Δ g) (D g) (t g) B (source g, q g) e).2))
    (fun g e =>
      (unrestrictedBoundedEventWeight (n g) (Δ g) (D g) (fun p => β g p / V g)
        ρ (V g) (t g) B (source g, q g) e : ℂ) *
      globalBirthBoundedEdgePhase (n g) (Δ g) (D g) (t g) B (target g) (H g)
        (source g, q g) e.1 e.2.1 e.2.2.1 e.2.2.2)
    hrows (globalBirthJointRawCutoff B F)
  simp only [prod_mul_distrib, ← Complex.ofReal_prod] at hr
  change globalBirthJointRawRow step B F (fun g => (H g, boundedOrderedTupleToFinite (q g))) =
    ∑ e : UnrestrictedJointEvent n Δ D t B (fun g => (source g, q g)),
      ((∏ g, unrestrictedBoundedEventWeight (n g) (Δ g) (D g) (fun p => β g p / V g)
        ρ (V g) (t g) B (source g, q g) (e g) : ℝ) : ℂ) *
      boundedEdgeJointPhase n Δ D t B source target H q e *
      globalBirthJointRawCutoff B F (boundedEdgeJointRawTarget n Δ D t B source H q e) at hr
  unfold globalBirthJointCutRawRow
  change (if productTotalMemory (fun g => (source g, q g)) ≤ B then
    globalBirthJointRawRow step B F (fun g => (H g, boundedOrderedTupleToFinite (q g))) else 0) = _
  rw [hr]
  have hout (e : UnrestrictedJointEvent n Δ D t B (fun g => (source g, q g))) :
      globalBirthJointRawCutoff B F (boundedEdgeJointRawTarget n Δ D t B source H q e) =
      if productTotalMemory (unrestrictedJointEventTarget n Δ D t B (fun g => (source g, q g)) e) ≤ B
      then F (boundedEdgeJointRawTarget n Δ D t B source H q e) else 0 := rfl
  simp only [hout]
  unfold unrestrictedJointCutoffEventWeight
  by_cases hi : productTotalMemory (fun g => (source g, q g)) ≤ B
  · rw [if_pos hi]
    apply sum_congr rfl
    intro e _
    by_cases ho : productTotalMemory (unrestrictedJointEventTarget n Δ D t B (fun g => (source g, q g)) e) ≤ B
    · have hb : productTotalMemory (fun g => (source g, q g)) ≤ B ∧
          productTotalMemory (unrestrictedJointEventTarget n Δ D t B (fun g => (source g, q g)) e) ≤ B := ⟨hi, ho⟩
      rw [if_pos ho, if_pos hb]
    · have hb : ¬ (productTotalMemory (fun g => (source g, q g)) ≤ B ∧
          productTotalMemory (unrestrictedJointEventTarget n Δ D t B (fun g => (source g, q g)) e) ≤ B) :=
        fun h => ho h.2
      rw [if_neg ho, if_neg hb]
      simp only [mul_zero, Complex.ofReal_zero, zero_mul]
  · rw [if_neg hi]
    symm
    apply sum_eq_zero
    intro e _
    have hb : ¬ (productTotalMemory (fun g => (source g, q g)) ≤ B ∧
        productTotalMemory (unrestrictedJointEventTarget n Δ D t B (fun g => (source g, q g)) e) ≤ B) :=
      fun h => hi h.1
    rw [if_neg hb]
    simp only [Complex.ofReal_zero, zero_mul]

end Joint
end

section
open scoped BigOperators Classical
theorem prime_label_log_interval_of_exp {I : Type*} (P : I → Finset ℕ) (H : ℝ)
    (hp : ∀ i p, p ∈ P i → 0 < p)
    (hmax : ∀ i p, p ∈ P i → (p : ℝ) ≤ Real.exp H) :
    ∀ i p, p ∈ P i → 0 ≤ Real.log p ∧ Real.log p ≤ H := by
  intro i p hpP
  have hpR : (0 : ℝ) < p := by exact_mod_cast hp i p hpP
  refine ⟨Real.log_nonneg (by exact_mod_cast hp i p hpP), ?_⟩
  simpa only [Real.log_exp] using Real.log_le_log hpR (hmax i p hpP)

theorem prime_product_occupied_cells_budget {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) {H h : ℝ} (hH : 0 ≤ H) (hh : 0 < h)
    (hp : ∀ i p, p ∈ P i → 0 < p)
    (hmax : ∀ i p, p ∈ P i → (p : ℝ) ≤ Real.exp H)
    (N : ℕ) (hslots : Fintype.card I ≤ N) :
    ((finiteOccupiedCells (fun x : (∀ i, P i) =>
      upperLogCell h (Real.log (∏ i, (x i).val : ℕ)))).card : ℝ) ≤
      (N : ℝ) * H / h + 2 := by
  have hc := prime_product_occupied_cells_card_le P (fun _ => 0) (fun _ => H) hp
    (fun _ => hH) (prime_label_log_interval_of_exp P H hp hmax) hh
  have hN : (Fintype.card I : ℝ) * H ≤ (N : ℝ) * H :=
    mul_le_mul_of_nonneg_right (by exact_mod_cast hslots) hH
  simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_zero, sub_zero] at hc
  have hd := div_le_div_of_nonneg_right hN hh.le
  linarith

theorem prime_product_discarded_mass_budget {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ) {H h ξ : ℝ}
    (hH : 0 ≤ H) (hh : 0 < h) (hξ : 0 ≤ ξ)
    (hp : ∀ i p, p ∈ P i → 0 < p)
    (hmax : ∀ i p, p ∈ P i → (p : ℝ) ≤ Real.exp H)
    (N : ℕ) (hslots : Fintype.card I ≤ N) :
    (∑ x : (∀ i, P i), if upperLogCell h (Real.log (∏ i, (x i).val : ℕ)) ∉
      primeProductRetainedCells P V h ξ then
        finiteProductWeight (physicalLabelLaw V) x else 0) ≤
      ((N : ℝ) * H / h + 2) * ξ := by
  exact (finite_discarded_cell_mass_le (finiteProductWeight (physicalLabelLaw (P := P) V))
    (fun x => upperLogCell h (Real.log (∏ i, (x i).val : ℕ))) hξ).trans
    (mul_le_mul_of_nonneg_right (prime_product_occupied_cells_budget P hH hh hp hmax N hslots) hξ)

theorem prime_product_retained_probability_budget {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ) (hV : ∀ i, 0 < V i)
    (hmass : ∀ i, ∑ p ∈ P i, 1 / (p : ℝ) = V i)
    {H h ξ : ℝ} (hH : 0 ≤ H) (hh : 0 < h) (hξ : 0 ≤ ξ)
    (hp : ∀ i p, p ∈ P i → 0 < p)
    (hmax : ∀ i p, p ∈ P i → (p : ℝ) ≤ Real.exp H)
    (N : ℕ) (hslots : Fintype.card I ≤ N) :
    1 - ((N : ℝ) * H / h + 2) * ξ ≤
    ∑ x : (∀ i, P i), if upperLogCell h (Real.log (∏ i, (x i).val : ℕ)) ∈
      primeProductRetainedCells P V h ξ then finiteProductWeight (physicalLabelLaw V) x else 0 := by
  have hm : ∑ x, finiteProductWeight (physicalLabelLaw (P := P) V) x = 1 :=
    finite_product_weight_sum_one _ (fun i => physical_label_law_sum V i (hV i) (hmass i))
  have hb := finite_retained_probability_ge (finiteProductWeight (physicalLabelLaw (P := P) V))
    (fun x => upperLogCell h (Real.log (∏ i, (x i).val : ℕ))) hξ hm
  have hc := mul_le_mul_of_nonneg_right
    (prime_product_occupied_cells_budget P hH hh hp hmax N hslots) hξ
  exact (sub_le_sub_left hc 1).trans hb
end

section
open Finset
theorem totient_sieve_interval_euler_product_le_log (N : ℕ) {D : ℝ}
    (hD : 1 ≤ D) (hND : (N : ℝ) ≤ D) :
    (∏ p ∈ (Icc 1 N).filter Nat.Prime, (1 + 1 / ((p : ℝ) - 1))) ≤
      (2 * primeEulerProductUpperConstant) * Real.log (2 * D) := by
  apply finite_inverse_prime_euler_product_le_log _
    (fun _ hp => (mem_filter.mp hp).2) hD
  intro p hp
  exact (Nat.cast_le.mpr (mem_Icc.mp (mem_filter.mp hp).1).2).trans hND

theorem totient_sieve_squarefree_mass_le_log (N : ℕ) {D : ℝ}
    (hD : 1 ≤ D) (hND : (N : ℝ) ≤ D) :
    (∑ d ∈ (Icc 1 N).filter Squarefree, 1 / (Nat.totient d : ℝ)) ≤
      (2 * primeEulerProductUpperConstant) * Real.log (2 * D) := by
  let P := (Icc 1 N).filter Nat.Prime
  have hP : ∀ p ∈ P, p.Prime := fun _ hp => (mem_filter.mp hp).2
  have hsub := totient_sieve_squarefree_moduli_subset P ((Icc 1 N).filter Squarefree) hP
    (fun _ hd => (mem_filter.mp hd).2) (totient_sieve_interval_squarefree_prime_support N)
  calc
    _ ≤ ∑ d ∈ (∏ p ∈ P, p).divisors, 1 / (Nat.totient d : ℝ) :=
      sum_le_sum_of_subset_of_nonneg hsub (fun _ _ _ => by positivity)
    _ = ∏ p ∈ P, (1 + 1 / ((p : ℝ) - 1)) := totient_sieve_divisor_mass P hP
    _ ≤ _ := totient_sieve_interval_euler_product_le_log N hD hND

theorem totient_sieve_noncoprime_mass_le_log (N n : ℕ) (hn : n ≠ 0) {D : ℝ}
    (hD : 1 ≤ D) (hND : (N : ℝ) ≤ D) :
    (∑ d ∈ (Icc 1 N).filter (fun d => Squarefree d ∧ ¬ Nat.Coprime d n),
      1 / (Nat.totient d : ℝ)) ≤
      (∑ p ∈ n.primeFactors, 1 / ((p : ℝ) - 1)) *
        ((2 * primeEulerProductUpperConstant) * Real.log (2 * D)) := by
  have hnonneg (p : ℕ) (hp : p ∈ n.primeFactors) : 0 ≤ 1 / ((p : ℝ) - 1) := by
    have hp1 : (1 : ℝ) ≤ p := by exact_mod_cast (Nat.prime_of_mem_primeFactors hp).one_le
    positivity
  apply (totient_sieve_interval_noncoprime_mass N n hn).trans
  apply mul_le_mul
  · exact sum_le_sum_of_subset_of_nonneg (filter_subset _ _) (fun p hp _ => hnonneg p hp)
  · exact totient_sieve_interval_euler_product_le_log N hD hND
  · apply prod_nonneg
    intro p hp
    have hp1 : (1 : ℝ) ≤ p := by exact_mod_cast (mem_filter.mp hp).2.one_le
    positivity
  · exact sum_nonneg hnonneg
end

section
open Finset
open scoped Classical
theorem global_birth_visit_norm_le_absolute_ghost {P : Type*} [Fintype P] [DecidableEq P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (β : P → ℝ) (η V ρ : ℝ) (H : Finset P)
    (hη : 0 ≤ 1 - η) (hμ : ∀ p, 0 ≤ β p / V)
    (t B : ℕ) (F : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B) :
    ‖globalBirthGhostVisitRawRow (fun _ => 0) β η V ρ B H s.2.2
      (fun _ q => boundedOrderedZeroExtension F s.1 q)‖ ≤
      (physicalAbsoluteBoundedGhostOperator n (fun p => β p / V) (1 - η) ρ V t B
        (complexNormEnvelope F) s).re := by
  rw [global_birth_visit_eq_bounded_ghost_event_sum]
  let _ : DecidableEq P := Classical.decEq P
  rw [physicalAbsoluteBoundedGhostOperator, bounded_ordered_ghost_eq_event_sum]
  simp_rw [← boundedGhostEventWeight_abs (physicalGhostRetention n (1 - η) ρ)
    (physicalGhostTermination n (1 - η) ρ) (physicalGhostBirth n (1 - η) ρ V)
    (unrestrictedResidueWeight (fun p => β p / V))
    (fun z => physical_ghost_retention_nonneg n hη z) (fun z => hμ z.1) t B s]
  rw [Complex.re_sum]
  refine (norm_sum_le _ _).trans (sum_le_sum fun e _ => ?_)
  simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, complexNormEnvelope,
    Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, mul_zero, sub_zero]
  have hm : ‖(if globalBirthGhostEventFresh n H t B s e then 1 else 0 : ℂ)‖ ≤ 1 := by
    split_ifs <;> simp
  calc
    _ ≤ (|boundedGhostEventWeight (physicalGhostRetention n (1 - η) ρ)
        (physicalGhostTermination n (1 - η) ρ) (physicalGhostBirth n (1 - η) ρ V)
        (unrestrictedResidueWeight (fun p => β p / V)) t B s e| * 1) *
          ‖F (boundedGhostEventTarget t B s e)‖ :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hm (abs_nonneg _)) (norm_nonneg _)
    _ = _ := by rw [mul_one]

noncomputable def globalBirthBoundedGhostOperator {P : Type*} [Fintype P] [DecidableEq P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (β : P → ℝ) (η V ρ : ℝ) (t B : ℕ)
    (H : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → Finset P)
    (F : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B) : ℂ :=
  globalBirthGhostVisitRawRow (fun _ => 0) β η V ρ B (H s) s.2.2
    (fun _ q => boundedOrderedZeroExtension F s.1 q)

theorem global_birth_bounded_ghost_energy_le {P : Type*} [Fintype P] [DecidableEq P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (β : P → ℝ) (η V ρ v vmax : ℝ) (t B : ℕ)
    (H : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → Finset P)
    (hμ : ∀ p, 0 < β p / V) (hmass : ∑ p, β p / V ≤ 2)
    (hη0 : 0 ≤ η) (hη1 : η ≤ 1) (hρ : 0 < ρ)
    (hV : 0 ≤ V) (hVmax : V ≤ vmax) (hv : 0 < v)
    (hD : (1 - η) / ρ ^ 2 + (η / ρ) / v ≤ 1)
    (hC : (1 - η) / ρ ^ 2 + (η * V / ρ) / v ≤ 1)
    (F : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
    (hF : BoundedOrderedSymmetric F) :
    finiteWeightedEnergy (boundedOrderedStateWeight (fun p => β p / V)
      (unrestrictedResidueWeight (fun p => β p / V)))
        (globalBirthBoundedGhostOperator n β η V ρ t B H F) ≤
      physicalGhostUniformEnergyBound ρ vmax v *
        finiteWeightedEnergy (boundedOrderedStateWeight (fun p => β p / V)
          (unrestrictedResidueWeight (fun p => β p / V))) F := by
  apply finiteWeightedEnergy_le_of_envelope_domination
    (boundedOrderedStateWeight (fun p => β p / V) (unrestrictedResidueWeight (fun p => β p / V)))
    (boundedOrderedStateWeight_nonneg _ _ (fun p => (hμ p).le) (fun z => (hμ z.1).le))
    F _ (physicalAbsoluteBoundedGhostOperator n (fun p => β p / V) (1 - η) ρ V t B)
  · intro s
    exact (global_birth_visit_norm_le_absolute_ghost n β η V ρ (H s)
      (sub_nonneg.mpr hη1) (fun p => (hμ p).le) t B F s).trans (Complex.re_le_norm _)
  · apply physical_bounded_ghost_absolute_energy_le_uniform n (fun p => β p / V)
      (1 - η) ρ V v vmax t B hμ hmass (sub_nonneg.mpr hη1) (sub_le_self _ hη0)
      hρ hV hVmax hv
    · simpa only [sub_sub_cancel] using hD
    · simpa only [sub_sub_cancel] using hC
    · intro active N q τ
      change (‖F (active, ⟨N, q ∘ τ⟩)‖ : ℂ) = (‖F (active, ⟨N, q⟩)‖ : ℂ)
      rw [hF active N q τ]
end

section
open Finset
open scoped Classical
theorem global_birth_visit_raw_cutoff_congr {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, DecidableEq (R p)] {N : ℕ}
    (h : (p : P) → R p) (β : P → ℝ) (η V ρ : ℝ) (B : ℕ)
    (H : Finset P) (old : Fin N → Σ p, R p)
    (F G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ)
    (hFG : ∀ H' q, q.1 ≤ B → F H' q = G H' q) :
    globalBirthGhostVisitRawRow h β η V ρ B H old F =
      globalBirthGhostVisitRawRow h β η V ρ B H old G := by
  unfold globalBirthGhostVisitRawRow
  apply sum_congr rfl
  intro T _
  apply sum_congr rfl
  intro b _
  apply sum_congr rfl
  intro f _
  congr 1
  split_ifs with hq
  · exact hFG _ _ hq
  · rfl

def boundedGhostLedgerDecode {P : Type*} (n : P → ℕ) (t B : ℕ)
    (s : Finset P × BoundedOrderedState P (UnrestrictedResidueParticle n) t B) :
    Finset P × FiniteOrderedTuple (UnrestrictedResidueParticle n) :=
  (s.1, boundedOrderedTupleToFinite s.2.2)

noncomputable def boundedGhostLedgerTarget {P : Type*} [DecidableEq P] (n : P → ℕ) (t B : ℕ)
    (s : Finset P × BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (e : BoundedGhostEvent t B s.2) :
    Finset P × BoundedOrderedState P (UnrestrictedResidueParticle n) t B :=
  (s.1 ∪ univ.image (fun j => (e.2.2 j).1), boundedGhostEventTarget t B s.2 e)

noncomputable def boundedGhostLedgerRow {P : Type*} [Fintype P] [DecidableEq P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (β : P → ℝ) (η V ρ : ℝ) (t B : ℕ)
    (F : Finset P × BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
    (s : Finset P × BoundedOrderedState P (UnrestrictedResidueParticle n) t B) : ℂ :=
  ∑ e : BoundedGhostEvent t B s.2,
    (boundedGhostEventWeight (physicalGhostRetention n (1 - η) ρ)
      (physicalGhostTermination n (1 - η) ρ) (physicalGhostBirth n (1 - η) ρ V)
      (unrestrictedResidueWeight (fun p => β p / V)) t B s.2 e : ℂ) *
    (if globalBirthGhostEventFresh n s.1 t B s.2 e then 1 else 0) *
      F (boundedGhostLedgerTarget n t B s e)

theorem bounded_ghost_ledger_row_decode {P : Type*} [Fintype P] [DecidableEq P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (β : P → ℝ) (η V ρ : ℝ) (t B : ℕ)
    (F : (Finset P × FiniteOrderedTuple (UnrestrictedResidueParticle n)) → ℂ)
    (s : Finset P × BoundedOrderedState P (UnrestrictedResidueParticle n) t B) :
    boundedGhostLedgerRow n β η V ρ t B (F ∘ boundedGhostLedgerDecode n t B) s =
      globalBirthGhostVisitRawRow (fun _ => 0) β η V ρ B s.1 s.2.2.2
        (fun H q => F (H, q)) := by
  symm
  calc
    _ = globalBirthGhostVisitRawRow (fun _ => 0) β η V ρ B s.1 s.2.2.2
        (fun H q => boundedOrderedZeroExtension
          (fun u => F (H, boundedOrderedTupleToFinite u.2)) s.2.1 q) := by
      apply global_birth_visit_raw_cutoff_congr
      intro H q hq
      rw [boundedOrderedZeroExtension_of_le _ _ _ hq]
      rfl
    _ = _ := global_birth_visit_eq_bounded_ghost_ledger_sum n β η V ρ s.1 t B
      (fun H u => F (H, boundedOrderedTupleToFinite u.2)) s.2
end

section
open Finset
theorem exists_rough_integer_divisor_weights :
    ∃ K : ℝ, 0 < K ∧ ∀ {z : ℝ}, 1 < z → ∀ h : ℕ, 1 ≤ h → Even h →
      ∃ lam : ℕ → ℝ,
        (∀ d, |lam d| ≤ 1) ∧
        (∀ d, lam d ≠ 0 → 0 < d ∧ (d : ℝ) ≤ z^(4 * (h : ℝ) + 2) ∧
          Squarefree d ∧ d ∣ ∏ p ∈ primeBand 0 z, p) ∧
        (∀ n : ℕ, n ≠ 0 → 0 ≤ ∑ d ∈ n.divisors, lam d ∧
          (if ∀ p ∈ n.primeFactors, z < (p : ℝ) then (1 : ℝ) else 0) ≤
            ∑ d ∈ n.divisors, lam d) ∧
        (∑ d ∈ blockSieveModuli (primeBand 0 z) (z^(4 * (h : ℝ) + 2)), |lam d| / (d : ℝ)) ≤
          ∏ p ∈ primeBand 0 z, (1 + 1 / (p : ℝ)) ∧
        ∀ a b : ℕ, a ≤ b →
          let M := (∑ n ∈ Ioc a b, ∑ d ∈ n.divisors, lam d) -
            (((Ioc a b).filter (fun n : ℕ => ∀ p ∈ n.primeFactors, z < (p : ℝ))).card : ℝ)
          0 ≤ M ∧ M ≤ ((b : ℝ) - a) * K * Real.exp (-(h : ℝ)) + z^(4 * (h : ℝ) + 2) := by
  obtain ⟨K, hK, hweights⟩ := exists_rough_sieve_divisor_weights
  refine ⟨K, hK, ?_⟩
  intro z hz h hh heven
  have hz0 : 0 ≤ z := (zero_lt_one.trans hz).le
  obtain ⟨lam, habs, hsupport, hpoint, hharm, hover⟩ :=
    hweights (primeBand 0 z) hz (fun _ hp => small_prime_pool_prime hp)
      (fun _ hp => small_prime_pool_le hz0 hp) h hh heven
  refine ⟨lam, habs, hsupport, ?_, hharm, ?_⟩
  · intro n hn
    simpa only [small_prime_avoidance_iff_rough hz0 hn] using hpoint n hn
  · intro a b hab
    simpa only [interval_small_prime_avoidance_eq_rough a b hz0] using hover a b hab

theorem exists_rough_integer_interval_count :
    ∃ K : ℝ, 0 < K ∧ ∀ (a b : ℕ) {z : ℝ} {h : ℕ},
      1 < z → a ≤ b → 1 ≤ h → Even h →
      |(((Ioc a b).filter (fun n : ℕ => ∀ p ∈ n.primeFactors, z < (p : ℝ))).card : ℝ) -
          ((b : ℝ) - a) * (∏ p ∈ primeBand 0 z, (1 - 1 / (p : ℝ)))| ≤
        ((b : ℝ) - a) * (∏ p ∈ primeBand 0 z, (1 - 1 / (p : ℝ))) * K *
          Real.exp (-(h : ℝ)) + z^(4 * (h : ℝ) + 2) := by
  obtain ⟨K, hK, hcount⟩ := exists_rough_interval_count_bound
  refine ⟨K, hK, ?_⟩
  intro a b z h hz hab hh heven
  have hz0 : 0 ≤ z := (zero_lt_one.trans hz).le
  simpa only [interval_small_prime_avoidance_eq_rough a b hz0] using
    hcount (primeBand 0 z) a b hz hab hh heven (fun _ hp => small_prime_pool_prime hp)
      (fun _ hp => small_prime_pool_le hz0 hp)
end

