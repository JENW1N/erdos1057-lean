open Finset
open scoped Classical
theorem global_birth_initial_phase_mass {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, DecidableEq (R p)]
    (a : P → Bool) (β : P → ℝ) :
    (∏ p, ghostPhaseInitial (a p) (β p)
      (globalBirthMemoryReadout (ghostPhaseActivitySupport a) (ghostPhaseActivitySupport a)
        (globalBirthEmptyMemory (R := R)) p)) =
      ∏ p, if a p then β p else 1 := by
  rw [global_birth_initial_phase]
  have h := ghost_phase_initial_tensor_point_mass (R := R) a β (ghostPhaseInitialState a)
  simpa only [ghostPhaseInitialState, ite_true] using h

/-- The full initial/terminal phase pairing equals the actual empty-to-empty
raw history multiplied by exactly the initial active beta product. -/
theorem global_birth_initial_terminal_pairing {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    (a : ℕ → P → Bool)
    (steps : ∀ i, GlobalBirthRawStep (R := R) (a i) (a (i + 1))) (β : P → ℝ) (n : ℕ) :
    (∑ w, ((∏ p, ghostPhaseInitial (a 0 p) (β p) (w p) : ℝ) : ℂ) *
      globalBirthPhaseHistory a steps n
        (fun z => ((∏ p, ghostPhaseTerminal (a n p) (z p) : ℝ) : ℂ)) w) =
      ((∏ p, if a 0 p then β p else 1 : ℝ) : ℂ) *
        globalBirthRawHistory a steps n (fun _ q => if q.1 = 0 then 1 else 0)
          (ghostPhaseActivitySupport (a 0)) (globalBirthEmptyMemory (R := R)) := by
  rw [ghost_phase_initial_tensor_sum, global_birth_raw_history_empty_boundary]
  rfl
end

section
open Finset
/-- The actual step matrix, indexed by output then input. Its output-memory
cutoff is part of the matrix entry. -/
noncomputable def globalBirthRawStepKernel {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)]
    [∀ p, DecidableEq (R p)] {a b : P → Bool}
    (step : GlobalBirthRawStep (R := R) a b)
    (z w : (p : P) → GhostPhaseState (R p)) : ℂ := by
  classical
  cases step with
  | visit h β η V ρ hV cap =>
      exact if (ghostPhasePendingSupport z).card ≤ cap then
        ((∏ p, ghostPhaseDampedVisit (a p) (h p) η (β p) ρ (z p) (w p) : ℝ) : ℂ) else 0
  | edge delta hshared source target hsource htarget β ρ V cap =>
      exact if (ghostPhasePendingSupport z).card ≤ cap then
        ((∏ p, (if b p && !(a p) then V⁻¹ else 1) *
          ghostPhaseDampedMovingEdge (b p) (a p) (delta p) (β p) ρ ρ (z p) (w p) : ℝ) : ℂ)
        else 0

/-- The existing phase row is exactly pullback by the extracted step matrix. -/
theorem global_birth_raw_step_phase_row_eq {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)]
    [∀ p, DecidableEq (R p)] {a b : P → Bool}
    (step : GlobalBirthRawStep (R := R) a b)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ)
    (w : (p : P) → GhostPhaseState (R p)) :
    globalBirthRawStepPhaseRow step F w = ∑ z, globalBirthRawStepKernel step z w * F z := by
  cases step <;> simp only [globalBirthRawStepPhaseRow, globalBirthRawStepKernel]
  all_goals
    apply sum_congr rfl
    intro z _
    split_ifs <;> simp

section History

variable {P : Type*} [Fintype P] [DecidableEq P] {R : P → Type*}
  [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
  (a : ℕ → P → Bool) (steps : ∀ i, GlobalBirthRawStep (R := R) (a i) (a (i + 1)))

/-- The chronological sequence of actual step matrices, with every local cap. -/
noncomputable def globalBirthHistoryKernel (i : ℕ)
    (z w : (p : P) → GhostPhaseState (R p)) : ℂ :=
  globalBirthRawStepKernel (steps i) z w

theorem global_birth_history_phase_row_eq :
    globalBirthHistoryPhaseRow a steps = finiteKernelPullback (globalBirthHistoryKernel a steps) := by
  funext i F w
  exact global_birth_raw_step_phase_row_eq (steps i) F w

/-- Initial weighting of actual phase history equals terminal weighting of
the forward path action of the same unmodified kernels. -/
theorem global_birth_phase_history_path_pairing
    (initial F : ((p : P) → GhostPhaseState (R p)) → ℂ) (n : ℕ) :
    (∑ w, initial w * globalBirthPhaseHistory a steps n F w) =
      ∑ z, F z * finitePathAction (globalBirthHistoryKernel a steps) initial n z := by
  unfold globalBirthPhaseHistory
  rw [global_birth_history_phase_row_eq]
  exact finite_row_composition_path_pairing _ initial F n

/-- Every intermediate phase cut appears in the complete weighted trace. -/
theorem global_birth_phase_history_trace_pairing
    (initial F : ((p : P) → GhostPhaseState (R p)) → ℂ) (n : ℕ) :
    (∑ w, initial w * globalBirthPhaseHistory a steps n F w) =
      ∑ x : Fin (n + 1) → (p : P) → GhostPhaseState (R p),
        F (x (Fin.last n)) * finiteChronologicalPrefix
          (globalBirthHistoryKernel a steps) initial n x := by
  unfold globalBirthPhaseHistory
  rw [global_birth_history_phase_row_eq]
  exact finite_row_composition_trace_pairing _ initial F n

/-- A fixed phase source is represented by the delta initial weight. -/
theorem global_birth_phase_history_trace_at
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) (n : ℕ)
    (w : (p : P) → GhostPhaseState (R p)) :
    globalBirthPhaseHistory a steps n F w =
      ∑ x : Fin (n + 1) → (p : P) → GhostPhaseState (R p),
        F (x (Fin.last n)) * finiteChronologicalPrefix
          (globalBirthHistoryKernel a steps) (fun z => if z = w then 1 else 0) n x := by
  classical
  unfold globalBirthPhaseHistory
  rw [global_birth_history_phase_row_eq]
  exact finite_row_composition_trace_at _ F n w

/-- The actual raw ordered-memory history is the complete finite phase trace
when its terminal continuation agrees on coherent final snapshots. -/
theorem global_birth_raw_history_trace (n : ℕ)
    (G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ)
    (hterminal : ∀ H' q', GlobalBirthMemoryCoherent (ghostPhaseActivitySupport (a n)) H' q' →
      G H' q' = F (globalBirthMemoryReadout (ghostPhaseActivitySupport (a n)) H' q'))
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent (ghostPhaseActivitySupport (a 0)) H q) :
    globalBirthRawHistory a steps n G H q =
      ∑ x : Fin (n + 1) → (p : P) → GhostPhaseState (R p),
        F (x (Fin.last n)) * finiteChronologicalPrefix (globalBirthHistoryKernel a steps)
          (fun z => if z = globalBirthMemoryReadout (ghostPhaseActivitySupport (a 0)) H q
            then 1 else 0) n x := by
  classical
  rw [global_birth_raw_history_intertwines a steps n G F hterminal H q hq]
  exact global_birth_phase_history_trace_at a steps F n _

end History
end

section

open Finset
open scoped Classical

/-- The actual repeated-list kernel with just the two auxiliary collision bans removed. -/
noncomputable def repeatedBigUnbannedKernel {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (source target : RepeatedBigLists P J ell) : ℂ :=
  if repeatedBigSharedCompatible C source target then
    ((physicalAuxMass V C aux * repeatedBigTargetMass V b C target : ℝ) : ℂ) *
      K source target aux * physicalPhase ζ (repeatedBigD C source aux) else 0

theorem repeated_big_ban_difference_norm_le {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 ≤ V g) (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (B : ℝ) (_hB : 0 ≤ B) (hK : ∀ x y a, ‖K x y a‖ ≤ B)
    (aux : PhysicalAuxLabels P C) (source target : RepeatedBigLists P J ell) :
    ‖repeatedBigUnbannedKernel V (fun _ _ => 1) C ζ K aux source target -
        repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target‖ ≤
      B * (if repeatedBigSharedCompatible C source target then
          repeatedBigTargetMass V (fun _ _ => 1) C target else 0) *
        (physicalAuxMass V C aux *
          (if ¬(repeatedBigAuxAvoids C aux source ∧ repeatedBigAuxAvoids C aux target) then 1 else 0)) := by
  have ha := physical_aux_mass_nonneg V C hV aux
  have ht := repeated_big_untilted_target_mass_nonneg V hV C target
  by_cases hs : repeatedBigSharedCompatible C source target
  · by_cases hb : repeatedBigAuxAvoids C aux source ∧ repeatedBigAuxAvoids C aux target
    · simp [repeatedBigUnbannedKernel, repeatedBigKernel, hs, hb]
    · simp only [repeatedBigUnbannedKernel, repeatedBigKernel, hs, true_and, if_true,
        hb, if_false, not_false_eq_true, sub_zero, mul_one, norm_mul, physical_phase_norm,
        Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg ha, abs_of_nonneg ht]
      calc
        _ ≤ (physicalAuxMass V C aux * repeatedBigTargetMass V (fun _ _ => 1) C target) * B :=
          mul_le_mul_of_nonneg_left (hK source target aux) (mul_nonneg ha ht)
        _ = _ := by ring
  · simp [repeatedBigUnbannedKernel, repeatedBigKernel, hs]

/-- Summing all free-label collisions costs only the total number of endpoint comparisons. -/
theorem repeated_big_ban_difference_absolute_row_bound {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (B : ℝ) (hB : 0 ≤ B) (hK : ∀ x y a, ‖K x y a‖ ≤ B)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (source : RepeatedBigLists P J ell) :
    (∑ aux, ∑ target, ‖repeatedBigUnbannedKernel V (fun _ _ => 1) C ζ K aux source target -
        repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target‖) ≤
      B * ∑ g, (C g).card * (2 * (J + ell : ℕ)) / (V g * Pmin) := by
  let δ : ℝ := ∑ g, (C g).card * (2 * (J + ell : ℕ)) / (V g * Pmin)
  let mass (target : RepeatedBigLists P J ell) : ℝ :=
    if repeatedBigSharedCompatible C source target then
      repeatedBigTargetMass V (fun _ _ => 1) C target else 0
  have hm (target) : 0 ≤ mass target := by
    dsimp [mass]
    split_ifs
    · exact repeated_big_untilted_target_mass_nonneg V (fun g => (hV g).le) C target
    · exact le_rfl
  calc
    _ = ∑ target, ∑ aux, ‖repeatedBigUnbannedKernel V (fun _ _ => 1) C ζ K aux source target -
        repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target‖ := sum_comm
    _ ≤ ∑ target, B * mass target * δ := by
      apply sum_le_sum
      intro target ht
      calc
        _ ≤ ∑ aux, B * mass target * (physicalAuxMass V C aux *
            (if ¬(repeatedBigAuxAvoids C aux source ∧ repeatedBigAuxAvoids C aux target) then 1 else 0)) :=
          sum_le_sum (fun aux _ => repeated_big_ban_difference_norm_le
            V C (fun g => (hV g).le) ζ K B hB hK aux source target)
        _ = B * mass target * ∑ aux, physicalAuxMass V C aux *
            (if ¬(repeatedBigAuxAvoids C aux source ∧ repeatedBigAuxAvoids C aux target) then 1 else 0) :=
          (mul_sum _ _ _).symm
        _ ≤ _ := mul_le_mul_of_nonneg_left
          (repeated_big_auxiliary_collision_mass_le V C hV hMass source target hPmin hp)
          (mul_nonneg hB (hm target))
    _ = B * δ := by
      rw [← sum_mul, ← mul_sum]
      dsimp [mass]
      rw [repeated_big_untilted_compatible_target_mass_sum V C hV hMass source, mul_one]

theorem repeated_big_unbanned_kernel_weighted_transpose {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (source target : RepeatedBigLists P J ell) :
    (repeatedBigActiveMass V b source : ℂ) * repeatedBigUnbannedKernel V b C ζ K aux source target =
      (repeatedBigActiveMass V b target : ℂ) *
        repeatedBigUnbannedKernel V b C ζ (fun x y a => K y x a) aux target source := by
  unfold repeatedBigUnbannedKernel
  by_cases hs : repeatedBigSharedCompatible C source target
  · rw [if_pos hs, if_pos (repeated_big_shared_compatible_symm C hs),
      ← repeated_big_D_eq_of_shared C hs aux]
    have hm := congrArg (fun x : ℝ => (x : ℂ))
      (repeated_big_active_target_mass_balance V b C hs)
    push_cast at hm ⊢
    linear_combination (physicalAuxMass V C aux : ℂ) * K source target aux *
      physicalPhase ζ (repeatedBigD C source aux) * hm
  · have hr : ¬ repeatedBigSharedCompatible C target source :=
      fun h => hs (repeated_big_shared_compatible_symm C h)
    rw [if_neg hs, if_neg hr, mul_zero, mul_zero]

theorem repeated_big_ban_difference_row_bound {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (B : ℝ) (hB : 0 ≤ B) (hK : ∀ x y a, ‖K x y a‖ ≤ B)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (source : RepeatedBigLists P J ell) :
    (∑ target, ‖∑ aux, (repeatedBigUnbannedKernel V (fun _ _ => 1) C ζ K aux source target -
        repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target)‖) ≤
      B * ∑ g, (C g).card * (2 * (J + ell : ℕ)) / (V g * Pmin) := by
  calc
    _ ≤ ∑ target, ∑ aux, ‖repeatedBigUnbannedKernel V (fun _ _ => 1) C ζ K aux source target -
        repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target‖ :=
      sum_le_sum (fun target _ => norm_sum_le _ _)
    _ = ∑ aux, ∑ target, ‖repeatedBigUnbannedKernel V (fun _ _ => 1) C ζ K aux source target -
        repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target‖ := sum_comm
    _ ≤ _ := repeated_big_ban_difference_absolute_row_bound V C hV hMass ζ K B hB hK hPmin hp source

/-- Removing the two actual auxiliary bans costs the global collision probability
in the true product-weighted active norm. No operator bound is assumed. -/
theorem repeated_big_ban_removal_operator_error {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (B : ℝ) (hB : 0 ≤ B) (hK : ∀ x y a, ‖K x y a‖ ≤ B)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (f : RepeatedBigLists P J ell → ℂ) :
    cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
        (fun source => ∑ target,
          (∑ aux, (repeatedBigUnbannedKernel V (fun _ _ => 1) C ζ K aux source target -
            repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target)) * f target) ≤
      (B * ∑ g, (C g).card * (2 * (J + ell : ℕ)) / (V g * Pmin)) *
        cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f := by
  let δ : ℝ := ∑ g, (C g).card * (2 * (J + ell : ℕ)) / (V g * Pmin)
  have hδ : 0 ≤ δ := by
    apply sum_nonneg
    intro g hg
    exact div_nonneg (mul_nonneg (Nat.cast_nonneg _)
      (mul_nonneg (by norm_num) (Nat.cast_nonneg _))) (mul_nonneg (hV g).le hPmin.le)
  let E (K' : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
      (source target : RepeatedBigLists P J ell) : ℂ :=
    ∑ aux, (repeatedBigUnbannedKernel V (fun _ _ => 1) C ζ K' aux source target -
      repeatedBigKernel V (fun _ _ => 1) C ζ K' aux source target)
  have htrans (source target : RepeatedBigLists P J ell) :
      (repeatedBigActiveMass V (fun _ _ => 1) source : ℂ) * E K source target =
        (repeatedBigActiveMass V (fun _ _ => 1) target : ℂ) *
          E (fun x y a => K y x a) target source := by
    unfold E
    rw [mul_sum, mul_sum]
    apply sum_congr rfl
    intro aux ha
    rw [mul_sub, mul_sub,
      repeated_big_unbanned_kernel_weighted_transpose V (fun _ _ => 1) C ζ K aux source target,
      repeated_big_kernel_weighted_transpose V (fun _ _ => 1) C ζ K aux source target]
  have hr (source : RepeatedBigLists P J ell) : ∑ target, ‖E K source target‖ ≤ B * δ :=
    repeated_big_ban_difference_row_bound V C hV hMass ζ K B hB hK hPmin hp source
  have hr' (target : RepeatedBigLists P J ell) :
      ∑ source, ‖E (fun x y a => K y x a) target source‖ ≤ B * δ :=
    repeated_big_ban_difference_row_bound V C hV hMass ζ (fun x y a => K y x a) B hB
      (fun x y a => hK y x a) hPmin hp target
  have h := finite_weighted_schur_of_transpose univ
    (repeatedBigActiveMass V (fun _ _ => 1)) (fun _ => 1) (E K) (E (fun x y a => K y x a))
    (fun source _ => repeated_big_untilted_active_mass_nonneg V (fun g => (hV g).le) source)
    (fun _ _ => zero_lt_one) (fun source _ target _ => htrans source target)
    (fun source _ => by simpa only [mul_one] using hr source)
    (fun target _ => by simpa only [mul_one] using hr' target) f
  have hs := Real.sqrt_le_sqrt h
  simpa only [cleanActiveNorm, E, ← pow_two, Real.sqrt_mul (sq_nonneg (B * δ)),
    Real.sqrt_sq (mul_nonneg hB hδ)] using hs
end

