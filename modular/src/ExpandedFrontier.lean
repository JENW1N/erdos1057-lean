/-! Direct weighted selection of physical paths, without a recorded-history action. -/

open Finset Classical
namespace Bounty

theorem direct_filtered_rows_weighted_fiber
    {D K X : Type*} (E : K → X → Type*) [∀ k x, Fintype (E k x)]
    (target : ∀ k x, E k x → X) (phase : ∀ k x, E k x → ℂ)
    (weight : ∀ k x, E k x → ℝ) (allowed : D → ∀ k x, E k x → Prop)
    (S : Finset D) (w : D → ℂ) (ks : List K) (F : X → ℂ) (x : X) :
    (∑ d ∈ S, w d * finiteOperatorListAction
      (finiteLocalPhasedRow E target
        (fun k x e => if allowed d k x e then phase k x e else 0) weight) ks F x) =
    finiteEventPathAction E target weight ks
      (fun x p => (∑ d ∈ S, if finiteEventPathAllowed E target (allowed d) ks x p
        then w d else 0) * finiteEventLocalPhase E target phase ks x p) F x := by
  simp_rw [finite_phased_rows_eq_event_paths]
  unfold finiteEventPathAction
  simp_rw [Finset.mul_sum, Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro p _
  simp only [Finset.mul_sum, Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro d _
  rw [finite_event_local_phase_filter]
  split_ifs <;> ring

section Physical
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g (p : P g), NeZero p.val]
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (β : (g : Fin N) → P g → ℝ) (V : Fin N → ℝ) (ρ : ℝ)
  (hV : ∀ g, V g ≠ 0)
  (ω : ∀ j, SharedActiveLabels (fun g => P g)
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) →
      PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)
  (cut : ℕ → Fin N → Finset (Fin J))

theorem physical_direct_selected_history_rows
    (d : PhysicalSelectedData P ell C)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hencode : ∀ i, PhysicalMarkRowEncoding C
      (physicalSelectedFineTag n i) (cut i) (cut (i + 1)))
    (steps : ℕ)
    (F : FullMixedLedgerState (fun g (p : P g) => p.val)
      (M := fun _ => J + ell) B → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) :
    let _ : ∀ i x, Fintype (PhysicalFullLedgerEvent (P := P) (ell := ell) (B := B)
      C k (physicalSelectedFineTag n i) x) :=
      fun i x => physicalFullLedgerEventFintype C k (physicalSelectedFineTag n i) x
    finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
      (physicalSelectedFineRow C d.1 d.2.1 d.2.2.1 d.2.2.2 k β V ρ hV ω retention)
      steps (F ∘ physicalBoundedMarkEncode (cut steps)) s =
    finiteOperatorListAction
      (finiteLocalPhasedRow
        (fun i => PhysicalFullLedgerEvent (P := P) (ell := ell) (B := B)
          C k (physicalSelectedFineTag n i))
        (fun i => physicalFullLedgerEventTarget C k (physicalSelectedFineTag n i))
        (fun i x e => if physicalSelectedFineTraceTest C d.1 d.2.1 d.2.2.1 d.2.2.2 cut i
            (physicalFullTraceObservation C k (physicalSelectedFineTag n) cut i x e)
          then physicalFullLedgerEventPhase C k ω β ρ V (physicalSelectedFineTag n i) x e
          else 0)
        (fun i => physicalFullLedgerEventWeight C k ω β retention ρ V
          (physicalSelectedFineTag n i)))
      (List.range steps) F (physicalBoundedMarkEncode (cut 0) s) := by
  let _ : ∀ i x, Fintype (PhysicalFullLedgerEvent (P := P) (ell := ell) (B := B)
      C k (physicalSelectedFineTag n i) x) :=
    fun i x => physicalFullLedgerEventFintype C k (physicalSelectedFineTag n i) x
  rw [physical_selected_fine_history_intertwines C d.1 d.2.1 d.2.2.1 d.2.2.2
    k β V ρ hV ω retention hP hdis cut hencode steps F]
  dsimp only [Function.comp_apply]
  rw [finite_row_composition_eq_operator_list]
  congr 1
  funext i F x
  unfold physicalSelectedFineFullRow physicalFullObservedRow fullMixedObservedRow
    finiteLocalPhasedRow
  apply Finset.sum_congr
  · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
  · intro e _
    unfold physicalSelectedFineTraceTest physicalFullTraceObservation
      physicalFullLedgerEventPhase physicalFullLedgerEventWeight physicalFullLedgerEventTarget
    dsimp only
    split_ifs <;> simp only [mul_zero, zero_mul]

theorem physical_direct_selected_weighted_fiber
    (S : Finset (PhysicalSelectedData P ell C)) (w : PhysicalSelectedData P ell C → ℂ)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hencode : ∀ i, PhysicalMarkRowEncoding C
      (physicalSelectedFineTag n i) (cut i) (cut (i + 1)))
    (steps : ℕ)
    (F : FullMixedLedgerState (fun g (p : P g) => p.val)
      (M := fun _ => J + ell) B → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) :
    let _ : ∀ i x, Fintype (PhysicalFullLedgerEvent (P := P) (ell := ell) (B := B)
      C k (physicalSelectedFineTag n i) x) :=
      fun i x => physicalFullLedgerEventFintype C k (physicalSelectedFineTag n i) x
    (∑ d ∈ S, w d * finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
      (physicalSelectedFineRow C d.1 d.2.1 d.2.2.1 d.2.2.2 k β V ρ hV ω retention)
      steps (F ∘ physicalBoundedMarkEncode (cut steps)) s) =
    finiteEventPathAction
      (fun i => PhysicalFullLedgerEvent (P := P) (ell := ell) (B := B)
        C k (physicalSelectedFineTag n i))
      (fun i => physicalFullLedgerEventTarget C k (physicalSelectedFineTag n i))
      (fun i => physicalFullLedgerEventWeight C k ω β retention ρ V (physicalSelectedFineTag n i))
      (List.range steps)
      (fun x p => (∑ d ∈ S,
        if finiteEventPathAllowed
          (fun i => PhysicalFullLedgerEvent (P := P) (ell := ell) (B := B)
            C k (physicalSelectedFineTag n i))
          (fun i => physicalFullLedgerEventTarget C k (physicalSelectedFineTag n i))
          (fun i x e => physicalSelectedFineTraceTest C d.1 d.2.1 d.2.2.1 d.2.2.2 cut i
            (physicalFullTraceObservation C k (physicalSelectedFineTag n) cut i x e))
          (List.range steps) x p then w d else 0) *
        finiteEventLocalPhase
          (fun i => PhysicalFullLedgerEvent (P := P) (ell := ell) (B := B)
            C k (physicalSelectedFineTag n i))
          (fun i => physicalFullLedgerEventTarget C k (physicalSelectedFineTag n i))
          (fun i => physicalFullLedgerEventPhase C k ω β ρ V (physicalSelectedFineTag n i))
          (List.range steps) x p)
      F (physicalBoundedMarkEncode (cut 0) s) := by
  let _ : ∀ i x, Fintype (PhysicalFullLedgerEvent (P := P) (ell := ell) (B := B)
      C k (physicalSelectedFineTag n i) x) :=
    fun i x => physicalFullLedgerEventFintype C k (physicalSelectedFineTag n i) x
  simp_rw [physical_direct_selected_history_rows C k β V ρ hV ω retention cut
    _ hP hdis hencode steps F s]
  exact direct_filtered_rows_weighted_fiber _ _ _ _ _ S w (List.range steps) F _

end Physical

section Normalization
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g (p : P g), NeZero p.val]
  (C : Fin n → Fin N → Finset (Fin J))
  [Fintype (PhysicalSelectedData P ell C)]
  (k : Fin n → ℤ)
  (a : PhysicalSelectedData P ell C → Fin (n + 1) → ℤ)
  (hstep : ∀ d, ∀ j : Fin n, a d j.succ = a d j.castSucc +
    k j * (physicalD (C j)
      (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc)) (d.1 j) : ℤ))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ d : PhysicalSelectedData P ell C,
    ∀ j : Fin n, ∀ g s, ¬ ((d.2.1 j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → P g → ℝ) (V : Fin N → ℝ) (ρ : ℝ)
  (hV : ∀ g, V g ≠ 0) (q : Fin (n + 1) → ℝ) (hρ : ρ ≠ 0)

include hstep hP hdis hk hρ in
theorem physical_direct_weighted_normalization
    (w : PhysicalSelectedData P ell C → ℂ) :
    (∑ d : PhysicalSelectedData P ell C,
      (if ∀ j : Fin n, physicalListAdmissible (C j) (d.1 j)
        (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc))
        (physicalPermuteLabels (d.2.2.2 j) (d.2.1 j.succ)) then (1 : ℂ) else 0) *
      (∏ i ∈ range (2 * n + 1), physicalSelectedCoarseScalar C
        d.1 d.2.1 d.2.2.1 (fun j _ aux => physicalAuxMass V (C j) aux) i) *
      w d *
      (ghostPhaseCappedHistory
        (fun p : PhysicalPrime P => fun j => globalBirthFiniteActivity
          (physicalGroupBareFiniteActivity d.2.1 p.1) j p.2)
        (fun p => physicalResidueAbsoluteHit (a d) p.1 p.2)
        (fun _ j => 1 - q (globalBirthFiniteIndex n j))
        (fun p => β p.1 p.2) (fun p => V p.1) (fun _ => B) (fun _ => B) n : ℂ)) =
    ∑ L : PhysicalMarkLists P J ell,
      ((∏ g, ∏ s : PhysicalSlots J ell, β g (L g s) / V g : ℝ) : ℂ) *
      (∑ d : PhysicalSelectedData P ell C, w d *
        finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
          (physicalSelectedFineRow C d.1 d.2.1 d.2.2.1 d.2.2.2 k β V ρ hV
            (fun j _ aux => physicalAuxMass V (C j) aux) q)
          (4 * n + 1) physicalEmptyMemoryTerminal (physicalInitialMarkState B L)) := by
  rw [physical_selected_initial_pairing C k β V ρ hV
    (fun j _ aux => physicalAuxMass V (C j) aux) q univ w
    (fun L => ((∏ g, ∏ s : PhysicalSlots J ell, β g (L g s) / V g : ℝ) : ℂ))
    physicalEmptyMemoryTerminal]
  apply Finset.sum_congr rfl
  intro d _
  have hn := physical_selected_fine_normalization_unrestricted C d.1 k d.2.1 (a d)
    d.2.2.1 d.2.2.2 (hstep d) hP hdis (hk d) β V ρ hV B
    (fun j _ aux => physicalAuxMass V (C j) aux) q hρ
  linear_combination -(w d) * hn

end Normalization
end Bounty


/-! Exhaustive arbitrary-weight selection on original nonzero physical paths. -/

open Finset Classical
namespace Bounty

section Selection
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (cut : ℕ → Fin N → Finset (Fin J))

theorem physical_direct_selector_eq_record_phase
    (S : Finset (PhysicalSelectedData P ell C)) (w : PhysicalSelectedData P ell C → ℂ)
    (x : FullMixedLedgerState (fun g (p : P g) => p.val) (M := fun _ => J + ell) B)
    (p : FiniteEventPath
      (fun i => PhysicalFullLedgerEvent (P := P) (ell := ell) (B := B)
        C k (physicalSelectedFineTag n i))
      (fun i => physicalFullLedgerEventTarget C k (physicalSelectedFineTag n i))
      (List.range (4 * n + 1)) x) :
    (∑ d ∈ S, if finiteEventPathAllowed
      (fun i => PhysicalFullLedgerEvent (P := P) (ell := ell) (B := B)
        C k (physicalSelectedFineTag n i))
      (fun i => physicalFullLedgerEventTarget C k (physicalSelectedFineTag n i))
      (fun i x e => physicalSelectedFineTraceTest C d.1 d.2.1 d.2.2.1 d.2.2.2 cut i
        (physicalFullTraceObservation C k (physicalSelectedFineTag n) cut i x e))
      (List.range (4 * n + 1)) x p then w d else 0) =
    physicalSelectedDataRecordPhase C cut S w
      (finiteEventPathObservations
        (fun i => PhysicalFullLedgerEvent (P := P) (ell := ell) (B := B)
          C k (physicalSelectedFineTag n i))
        (fun i => physicalFullLedgerEventTarget C k (physicalSelectedFineTag n i))
        (physicalFullTraceObservation C k (physicalSelectedFineTag n) cut)
        (List.range (4 * n + 1)) x p) := by
  unfold physicalSelectedDataRecordPhase physicalSelectedDataRecordTest
  apply Finset.sum_congr rfl
  intro d _
  rw [finite_event_path_observations_forall₂]

theorem physical_direct_record_phase_at
    [Fintype (PhysicalSelectedData P ell C)]
    (r : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C))
    (d : PhysicalSelectedData P ell C)
    (hd : physicalSelectedDataRecordTest C cut d r)
    (w : PhysicalSelectedData P ell C → ℂ) :
    physicalSelectedDataRecordPhase C cut univ w r = w d := by
  unfold physicalSelectedDataRecordPhase
  rw [Finset.sum_eq_single d]
  · rw [if_pos hd]
  · intro b _ hb
    apply if_neg
    intro h
    exact hb (physical_selected_data_record_unique C cut r h hd)
  · intro h
    exact (h (mem_univ d)).elim

end Selection

section Original
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => P g)
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) →
      PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → P g → ℝ) (retention : Fin (n + 1) → ℝ)
  (ρ : ℝ) (V : Fin N → ℝ)

theorem physical_direct_original_selector_collapse
    [Fintype (PhysicalSelectedData P ell C)]
    (cut : ℕ → Fin N → Finset (Fin J))
    (hencode : ∀ i, PhysicalMarkRowEncoding C
      (physicalSelectedFineTag n i) (cut i) (cut (i + 1)))
    (x : PhysicalFullBoundedState P J ell B) (hx : FullActiveInjective x)
    (p : FullPermutationMixedPath (fun g (p : P g) => p.val)
      (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j))
      ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)) x) :
    physicalOriginalFineWeight C k ω β retention ρ V x p = 0 ∨
      ∃ d : PhysicalSelectedData P ell C,
        physicalSelectedDataRecordTest C cut d (physicalOriginalFineRecord C k cut x p) ∧
        (∀ e, physicalSelectedDataRecordTest C cut e (physicalOriginalFineRecord C k cut x p) → e = d) ∧
        ∀ w : PhysicalSelectedData P ell C → ℂ,
          physicalSelectedDataRecordPhase C cut univ w (physicalOriginalFineRecord C k cut x p) = w d := by
  by_cases hp : physicalOriginalFineWeight C k ω β retention ρ V x p = 0
  · exact Or.inl hp
  · right
    obtain ⟨o, t, hcoh, hlen, ho, ht⟩ :=
      physical_original_fine_trace_coherent C k ω β retention ρ V cut hencode x hx p hp
    obtain ⟨d, hd, _⟩ := physical_coherent_fine_history_has_selection C o t hcoh
    have htest : physicalSelectedDataRecordTest C cut d
        (physicalOriginalFineRecord C k cut x p) :=
      (physical_selected_record_iff_decoded C cut o t
        (physicalOriginalFineRecord C k cut x p) hlen ho ht d).mpr hd
    refine ⟨d, htest, ?_, ?_⟩
    · intro e he
      exact physical_selected_data_record_unique C cut _ he htest
    · intro w
      exact physical_direct_record_phase_at C cut _ d htest w

theorem physical_direct_original_weighted_phase
    [Fintype (PhysicalSelectedData P ell C)]
    (cut : ℕ → Fin N → Finset (Fin J))
    (hencode : ∀ i, PhysicalMarkRowEncoding C
      (physicalSelectedFineTag n i) (cut i) (cut (i + 1)))
    (x : PhysicalFullBoundedState P J ell B) (hx : FullActiveInjective x)
    (p : FullPermutationMixedPath (fun g (p : P g) => p.val)
      (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j))
      ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)) x)
    (w : PhysicalSelectedData P ell C → ℂ) (z : ℂ)
    (hvalue : ∀ d, physicalSelectedDataRecordTest C cut d
      (physicalOriginalFineRecord C k cut x p) → w d = z) :
    physicalOriginalFineWeight C k ω β retention ρ V x p *
      physicalSelectedDataRecordPhase C cut univ w (physicalOriginalFineRecord C k cut x p) =
    physicalOriginalFineWeight C k ω β retention ρ V x p * z := by
  rcases physical_direct_original_selector_collapse C k ω β retention ρ V
    cut hencode x hx p with hz | ⟨d, hd, _, hw⟩
  · rw [hz, zero_mul, zero_mul]
  · rw [hw w, hvalue d hd]

end Original
end Bounty


/-! The raw divisor and decoded small phases agree after multiplication
by the original signed weight, including every zero-weight path. -/

open scoped Classical
namespace Bounty
section Weighted
variable {S : Type} [Fintype S] {Ps : S → Finset ℕ}
  {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (Cs : Fin n → S → Finset (Fin J)) (Vs : S → ℝ) (q : ℝ)
  (ds : PhysicalGroupSelectedData Ps ell Cs)
  (cut : ℕ → Fin N → Finset (Fin J))
  (hcut : ∀ j : Fin n, cut (4 * j.val + 2) = C j)

include hcut in
theorem physical_direct_small_raw_phase
    (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
      (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
    (β : (g : Fin N) → ↥(P g) → ℝ) (retention : Fin (n + 1) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (r : PhysicalResidues Ps) (x : PhysicalFullBoundedState P J ell B) (hx : FullActiveInjective x)
    (p : FullPermutationMixedPath (fun g (p : ↥(P g)) => p.val)
      (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j))
      ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)) x)
    (hp : physicalOriginalFineWeight C k ω β retention ρ V x p ≠ 0) :
    let E := FullPermutationMixedEvent (J := Fin (n + 1)) (fun g (p : ↥(P g)) => p.val)
      (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (ell := ell) (C j) (k j)) (fun j => physicalFullEdgeD (ell := ell) (C j))
    let target := fullPermutationMixedEventTarget (J := Fin (n + 1)) (fun g (p : ↥(P g)) => p.val)
      (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (ell := ell) (C j) (k j)) (fun j => physicalFullEdgeD (ell := ell) (C j))
    let steps := (List.range (4 * n + 1)).map (physicalSelectedFineTag n)
    deterministicLedgerPhase E target (physicalFullSmallUpdate C k cut)
          (physicalFullSmallPhase C k cut Cs Vs q ds) steps r x p =
      deterministicLedgerPhase E target (physicalFullSmallRawUpdate C k)
          (physicalFullSmallRawPhase C k Cs Vs q ds) steps r x p := by
  dsimp only
  let E := FullPermutationMixedEvent (J := Fin (n + 1)) (fun g (p : ↥(P g)) => p.val)
    (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
    (fun j => physicalFullEdgeDelta (ell := ell) (C j) (k j)) (fun j => physicalFullEdgeD (ell := ell) (C j))
  let target := fullPermutationMixedEventTarget (J := Fin (n + 1)) (fun g (p : ↥(P g)) => p.val)
    (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
    (fun j => physicalFullEdgeDelta (ell := ell) (C j) (k j)) (fun j => physicalFullEdgeD (ell := ell) (C j))
  let history := fullMixedLedgerUpdate (J := Fin (n + 1)) (fun g (p : ↥(P g)) => p.val)
    (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
    (fun j => physicalFullEdgeDelta (ell := ell) (C j) (k j)) (fun j => physicalFullEdgeD (ell := ell) (C j))
  let steps := (List.range (4 * n + 1)).map (physicalSelectedFineTag n)
  let lift := (finiteLedgerEventPathEquiv E target history steps (fullActiveInitialLedger x) x).symm p
  have hphase : finiteEventLocalPhase (PhysicalFullLedgerEvent C k) (physicalFullLedgerEventTarget C k)
      (physicalFullLedgerEventPhase C k ω β ρ V) steps (fullActiveInitialLedger x, x) lift ≠ 0 :=
    (mul_ne_zero_iff.mp hp).2
  have h := physical_small_ledger_raw_on_support C k Cs Vs q ds cut hcut ω β ρ V
    steps r (fullActiveInitialLedger x, x) lift hx hphase
  have hd := deterministic_ledger_phase_forget E target history
    (physicalFullSmallUpdate C k cut) (physicalFullSmallPhase C k cut Cs Vs q ds)
    steps (fullActiveInitialLedger x) r x lift
  have hr := deterministic_ledger_phase_forget E target history
    (physicalFullSmallRawUpdate C k) (physicalFullSmallRawPhase C k Cs Vs q ds)
    steps (fullActiveInitialLedger x) r x lift
  simp only [lift, Equiv.apply_symm_apply] at hd hr
  exact hd.symm.trans (h.trans hr)

end Weighted
end Bounty


/-! Pointwise complete selected weights on original paths, using direct selector recovery. -/

open scoped Classical
namespace Bounty
section Root
variable {I : Type} {N M J ell n B : ℕ} {P : Fin N → Finset ℕ}
  [∀ z : PhysicalPrime P, NeZero z.2.val]
  (groups : Finset (Fin N)) (e : {g // g ∉ groupsᶜ} ≃ Fin M)
  (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
  (hC : ∀ i : patterns, ∀ g : ↥groupsᶜ, C i.val g.val = ∅)
  (k : ℕ → I → ℤ)
  (pl : PhysicalRootSmallPlan (P := P) (J := J) (ell := ell) (n := n) groups patterns)

theorem physical_root_direct_weighted_effective_complete
    [Fintype (PhysicalSelectedData (fun g => P (e.symm g).val) ell
      (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val))]
    (V : Fin N → ℝ) {q : ℝ} (hq : 0 ≤ q)
    (r : PhysicalGroupResidues P groupsᶜ)
    (ζ : ℕ → I → ℝ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ) (θ : ℝ)
    (ω : ∀ j, SharedActiveLabels (fun g => ↥(P (e.symm g).val))
      (fun g => physicalFullSharedIndices (ell := ell)
        (C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val)) →
      PhysicalAuxLabels (fun g => P (e.symm g).val)
        (fun g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val) → ℝ)
    (β : (g : Fin M) → ↥(P (e.symm g).val) → ℝ)
    (retention : Fin (n + 2) → ℝ) (ρ : ℝ)
    (cut : ℕ → Fin M → Finset (Fin J))
    (hencode : ∀ i, PhysicalMarkRowEncoding
      (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val)
      (physicalSelectedFineTag (n + 1) i) (cut i) (cut (i + 1)))
    (x : PhysicalFullBoundedState (fun g => P (e.symm g).val) J ell B) (hx : FullActiveInjective x)
    (path : FullPermutationMixedPath (fun g (p : P (e.symm g).val) => p.val)
      (fun j g => physicalFullSharedIndices (ell := ell)
        (C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val)) B
      (fun j _ => PhysicalAuxLabels (fun g => P (e.symm g).val)
        (fun g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val))
      (fun j => physicalFullEdgeDelta
        (fun g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val)
        (physicalRootPlanMultiplier groups patterns C hC k pl j))
      (fun j => physicalFullEdgeD
        (fun g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val))
      ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1))) x) :
    let Cn := fun j g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val
    let kn := physicalRootPlanMultiplier groups patterns C hC k pl
    let record := physicalOriginalFineRecord Cn kn cut x path
    let weight := physicalOriginalFineWeight Cn kn ω β retention ρ (fun g => V (e.symm g).val) x path
    weight * physicalSelectedDataRecordPhase Cn cut Finset.univ
      (physicalRootNumberedCompleteWeight groups e patterns C hC V q ζ k K r θ pl) record =
      weight * physicalEffectivePlanSmallFactor
        (fun (i : patterns) g => C i.val (e.symm g).val)
        (fun (j : Fin (n + 1)) (i : patterns) => k (n - j.val) i.val) B
        (fun g : ↥groupsᶜ => V g.val) (fun _ => q)
        ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1)))
        (physicalGroupResidueVector r) pl.1 pl.2 x
        (physicalRootSelectedEffectivePathEquiv groups e patterns C hC k pl x path) *
      physicalEffectivePlanCoefficientPhase
        (fun (i : patterns) g => C i.val (e.symm g).val)
        (fun (j : Fin (n + 1)) (i : patterns) => k (n - j.val) i.val) B
        (fun _ => 0) (physicalRootKeyCoefficient groups e patterns C hC ζ k K θ)
        ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1)))
        pl.1 pl.2 x (physicalRootSelectedEffectivePathEquiv groups e patterns C hC k pl x path) := by
  let Cn := fun j g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val
  let kn := physicalRootPlanMultiplier groups patterns C hC k pl
  let Cs := fun j (g : ↥groupsᶜ) => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val g.val
  let ds := physicalRootSmallPlanSmallData groups patterns C hC pl
  let Kb := fun j => physicalGroupReindexedCoefficient e
    (fun g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val g.val)
    (physicalRootPlanBigCoefficient groups patterns C hC ζ k K θ pl j)
  by_cases hp : physicalOriginalFineWeight Cn kn ω β retention ρ (fun g => V (e.symm g).val) x path = 0
  · dsimp only
    rw [hp, zero_mul, zero_mul, zero_mul]
  · obtain ⟨o, t, hcoh, hlen, ho, ht⟩ :=
      physical_original_fine_trace_coherent Cn kn ω β retention ρ (fun g => V (e.symm g).val)
        cut hencode x hx path hp
    have hcut : ∀ j : Fin (n + 1), cut (4 * j.val + 2) = Cn j := by
      intro j
      have h := hencode (4 * j.val + 2)
      rw [physical_fine_tag_edge] at h
      exact h.1
    dsimp only
    rw [mul_assoc]
    apply physical_direct_original_weighted_phase Cn kn ω β retention ρ (fun g => V (e.symm g).val)
      cut hencode x hx path
    intro d hd
    have hdd := (physical_selected_record_iff_decoded Cn cut o t
      (physicalOriginalFineRecord Cn kn cut x path) hlen ho ht d).mp hd
    unfold physicalRootNumberedCompleteWeight
    apply congrArg₂ (fun a b : ℂ => a * b)
    · rw [physical_root_numbered_small_weight_cumulative groups e patterns C hC k pl V hq r]
      rw [physical_coherent_selected_cumulative_offset Cn kn cut o t
        (physicalOriginalFineRecord Cn kn cut x path) hcoh hlen ho ht d hdd]
      have hs := physical_original_small_ledger Cn kn cut Cs (fun g => V g.val) q ds
        (physicalGroupResidueVector r) x path
      have hr := physical_direct_small_raw_phase Cn kn Cs (fun g => V g.val) q ds cut hcut
        ω β retention ρ (fun g => V (e.symm g).val) (physicalGroupResidueVector r) x hx path hp
      have he := physical_root_effective_small_factor groups e patterns C hC k pl V q r x path
      exact hs.symm.trans (hr.trans he.symm)
    · have ha : ∀ j, o (4 * j.val + 2) = .inr (some ⟨j, d.1 j⟩) :=
        fun j => (((physical_selected_data_test_iff_four Cn d o t).mp hdd).2.2.1 j).1
      have hc := physical_coherent_selected_coefficient Cn o t hcoh (fun _ => 0) Kb d.1 ha d hdd
      have hr := physical_record_coefficient_decoded Cn cut (fun _ => 0) Kb o t
        (physicalOriginalFineRecord Cn kn cut x path) hlen ho ht d.1 ha
      have hp1 := physical_original_record_coefficient_phase Cn kn cut (fun _ => 0) Kb x path
      have hp2 := physical_original_coefficient_full_phase Cn kn cut (fun _ => 0) Kb x path
      have he := physical_root_effective_coefficient groups e patterns C hC k pl ζ K θ cut hencode x path
      exact hc.trans (hr.symm.trans (hp1.trans (hp2.trans he.symm)))

end Root
end Bounty


/-! The original fixed-small-plan integrand enters selected fine rows directly. -/

open Finset Classical
namespace Bounty
section Numbered
variable {I : Type} {N M J ell n B : ℕ} {P : Fin N → Finset ℕ}
  [∀ z : PhysicalPrime P, NeZero z.2.val]
  (groups : Finset (Fin N)) (e : {g // g ∉ groupsᶜ} ≃ Fin M)
  (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
  (hC : ∀ i : patterns, ∀ g : ↥groupsᶜ, C i.val g.val = ∅)
  (V : Fin N → ℝ) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
  (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
    PhysicalAuxLabels P (C i) → ℂ)
  (r : PhysicalGroupResidues P groupsᶜ) (θ : ℝ)
  (p : PhysicalRootSmallPlan (P := P) (J := J) (ell := ell) (n := n) groups patterns)
  [Fintype (PhysicalSelectedData (fun g => P (e.symm g).val) ell
    (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val))]
  (β : PhysicalPrime P → ℝ)
  (hB : (physicalPrimeGroups P groups).card ≤ B)

include hB

theorem physical_root_numbered_integrand_sum_coarse :
    let _ : ∀ g (z : P (e.symm g).val), NeZero z.val :=
      fun g z => inferInstanceAs (NeZero (⟨(e.symm g).val, z⟩ : PhysicalPrime P).2.val)
    let Pn := fun g => P (e.symm g).val
    let Cn := fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val
    let Vn := fun g => V (e.symm g).val
    (∑ d : PhysicalSelectedData Pn ell Cn,
      let db := (physicalSelectedGroupReindex e (fun g => P g.val)
        (fun j (g : {g // g ∉ groupsᶜ}) => C (physicalRootSmallPlanPattern groups patterns C hC p j).val g.val)).symm d
      let old := physicalRootSmallPlanPath groups patterns C hC p db
      physicalRootMixedPathIntegrand groups patterns C V q ζ k K β B r θ old.1 old.2) =
    (physicalStateMass (fun g : ↥groupsᶜ => V g.val) J ell : ℂ) *
    ∑ d : PhysicalSelectedData Pn ell Cn,
      (if ∀ j : Fin (n + 1), physicalListAdmissible (Cn j) (d.1 j)
        (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc))
        (physicalPermuteLabels (d.2.2.2 j) (d.2.1 j.succ)) then (1 : ℂ) else 0) *
      (∏ i ∈ range (2 * (n + 1) + 1), physicalSelectedCoarseScalar Cn
        d.1 d.2.1 d.2.2.1 (fun j _ aux => physicalAuxMass Vn (Cn j) aux) i) *
      physicalRootNumberedCompleteWeight groups e patterns C hC V q ζ k K r θ p d *
      (ghostPhaseCappedHistory
        (fun z : PhysicalPrime Pn => fun j => globalBirthFiniteActivity
