/- Pointwise rational twists preserve the original coefficient and phase order. -/

namespace Bounty

theorem rational_normalized_phase_twist (r d : ℕ) {q : ℕ}
    (χ : DirichletCharacter ℂ q) (ψ : AddChar (Additive (ZMod (r/d))ˣ) ℂ)
    (a : ℂ) (τ : ℝ) (n : ℕ) :
    (a*(χ (n : ZMod q)*typeIIPhase τ n))*
        unitAddCharDirichlet ψ (n : ZMod (r/d)) =
      a*(rationalProductCharacter r d χ ψ (n : ZMod (q*(r/d)))*typeIIPhase τ n) := by
  rw [rational_product_character_apply]
  ring

theorem rational_phase_left_twist (r d : ℕ) {q : ℕ}
    (χ : DirichletCharacter ℂ q) (ψ : AddChar (Additive (ZMod (r/d))ˣ) ℂ)
    (τ : ℝ) (n : ℕ) :
    (typeIIPhase τ n*χ (n : ZMod q))*unitAddCharDirichlet ψ (n : ZMod (r/d)) =
      typeIIPhase τ n*rationalProductCharacter r d χ ψ (n : ZMod (q*(r/d))) := by
  rw [rational_product_character_apply]
  ring

theorem rational_weighted_phase_twist (r d : ℕ) {q : ℕ}
    (χ : DirichletCharacter ℂ q) (ψ : AddChar (Additive (ZMod (r/d))ˣ) ℂ)
    (a : ℂ) (τ : ℝ) (n : ℕ) :
    (a*χ (n : ZMod q)*typeIIPhase τ n)*unitAddCharDirichlet ψ (n : ZMod (r/d)) =
      a*rationalProductCharacter r d χ ψ (n : ZMod (q*(r/d)))*typeIIPhase τ n := by
  rw [rational_product_character_apply]
  ring

theorem candidate_selected_rational_multiplier
    (c L q : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm
      (candidateRoughSlot c L r jStar hr hj)) = false)
    (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ)
    (t u : candidatePIndices c L → ℕ) (big : Finset (candidatePIndices c L))
    (b : GroupMarkedLists (fun g : big => candidatePBand (c*L) g.val.val)
      (fun g : big => u g.val) → ℂ) (κ θ : ℕ → ℂ)
    (qRat dRat : ℕ) (ψ : AddChar (Additive (ZMod (qRat/dRat))ˣ) ℂ) (n : ℕ) :
    candidateSelectedResidualCoefficient c L q r jStar hr hj take hkeep ξ t u big b κ θ n *
        rationalResidualGcdMultiplier qRat dRat ψ n =
      candidateSelectedResidualCoefficient c L q r jStar hr hj take hkeep ξ t u big b κ
        (fun n => θ n*rationalResidualGcdMultiplier qRat dRat ψ n) n :=
  (candidate_selected_residual_full_multiplier c L q r jStar hr hj take hkeep ξ t u big b
    κ θ (rationalResidualGcdMultiplier qRat dRat ψ) n).symm

