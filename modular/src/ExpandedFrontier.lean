open Finset
theorem finite_majorant_complex_error {ι : Type*} (T : Finset ι)
    (R : ι → Prop) [DecidablePred R] (U : ι → ℝ) (F : ι → ℂ) {B : ℝ}
    (hU : ∀ n ∈ T, (if R n then (1 : ℝ) else 0) ≤ U n)
    (hF : ∀ n ∈ T, ‖F n‖ ≤ B) :
    ‖(∑ n ∈ T.filter R, F n) - ∑ n ∈ T, (U n : ℂ) * F n‖ ≤
      B * ((∑ n ∈ T, U n) - ((T.filter R).card : ℝ)) := by
  classical
  let I : ι → ℝ := fun n => if R n then 1 else 0
  have hI : (∑ n ∈ T, I n) = ((T.filter R).card : ℝ) := by
    simp only [I, ← sum_filter, sum_const, nsmul_eq_mul, mul_one]
  have hIF : (∑ n ∈ T, (I n : ℂ) * F n) = ∑ n ∈ T.filter R, F n := by
    rw [sum_filter]
    apply sum_congr rfl
    intro n _
    by_cases hn : R n <;> simp [I, hn]
  rw [← hIF, ← sum_sub_distrib]
  calc
    ‖∑ n ∈ T, ((I n : ℂ) * F n - (U n : ℂ) * F n)‖ ≤
        ∑ n ∈ T, ‖(I n : ℂ) * F n - (U n : ℂ) * F n‖ := norm_sum_le _ _
    _ ≤ ∑ n ∈ T, B * (U n - I n) := by
      apply sum_le_sum
      intro n hn
      have hnonneg : 0 ≤ U n - I n := sub_nonneg.mpr (hU n hn)
      rw [← sub_mul, ← Complex.ofReal_sub, norm_mul, Complex.norm_real,
        Real.norm_eq_abs, abs_of_nonpos (by linarith : I n - U n ≤ 0)]
      nlinarith [hF n hn]
    _ = B * ((∑ n ∈ T, U n) - ((T.filter R).card : ℝ)) := by
      rw [← mul_sum, sum_sub_distrib, hI]

theorem rough_divisor_majorant_complex_error (lam : ℕ → ℝ) {z B E : ℝ}
    (a b : ℕ) (F : ℕ → ℂ) (hB : 0 ≤ B)
    (hpoint : ∀ n : ℕ, n ≠ 0 →
      (if ∀ p ∈ n.primeFactors, z < (p : ℝ) then (1 : ℝ) else 0) ≤
        ∑ d ∈ n.divisors, lam d)
    (hF : ∀ n ∈ Ioc a b, ‖F n‖ ≤ B)
    (hover : (∑ n ∈ Ioc a b, ∑ d ∈ n.divisors, lam d) -
      (((Ioc a b).filter (fun n : ℕ => ∀ p ∈ n.primeFactors, z < (p : ℝ))).card : ℝ) ≤ E) :
    ‖(∑ n ∈ (Ioc a b).filter (fun n : ℕ => ∀ p ∈ n.primeFactors, z < (p : ℝ)), F n) -
        ∑ n ∈ Ioc a b, ((∑ d ∈ n.divisors, lam d : ℝ) : ℂ) * F n‖ ≤ B * E := by
  apply (finite_majorant_complex_error (Ioc a b) _ (fun n => ∑ d ∈ n.divisors, lam d)
    F ?_ hF).trans (mul_le_mul_of_nonneg_left hover hB)
  intro n hn
  exact hpoint n (Nat.ne_of_gt (lt_of_le_of_lt (Nat.zero_le a) (mem_Ioc.mp hn).1))
end

