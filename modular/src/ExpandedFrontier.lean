section
open scoped BigOperators Classical
theorem bounded_primitive_contains {q Q : ℕ} (hq : 0 < q) (hqQ : q ≤ Q)
    (χ : DirichletCharacter ℂ q) (hχ : χ.IsPrimitive) :
    ∃ t : BoundedPrimitiveCharacter Q, boundedPrimitiveModulus t = q ∧
      ∀ n : ℕ, boundedPrimitiveValue t (n : ZMod (boundedPrimitiveModulus t)) = χ (n : ZMod q) := by
  cases q with
  | zero => omega
  | succ k =>
    refine ⟨⟨⟨⟨k, by omega⟩, χ⟩, hχ⟩, rfl, ?_⟩
    intro n
    rfl

theorem bounded_primitive_inducing {q Q : ℕ} (hq : 0 < q) (hqQ : q ≤ Q)
    (χ : DirichletCharacter ℂ q) :
    ∃ t : BoundedPrimitiveCharacter Q, boundedPrimitiveModulus t ≤ q ∧
      ∀ n : ℕ, n.Coprime q →
        boundedPrimitiveValue t (n : ZMod (boundedPrimitiveModulus t)) = χ (n : ZMod q) := by
  let : NeZero q := ⟨Nat.ne_of_gt hq⟩
  have hc : 0 < χ.conductor := Nat.pos_of_ne_zero χ.conductor_ne_zero
  have hcq : χ.conductor ≤ q := Nat.le_of_dvd hq χ.conductor_dvd_level
  obtain ⟨t, ht, heval⟩ := bounded_primitive_contains hc (hcq.trans hqQ)
    χ.primitiveCharacter χ.primitiveCharacter_isPrimitive
  refine ⟨t, ht ▸ hcq, ?_⟩
  intro n hn
  rw [heval]
  simpa only [Int.cast_natCast] using
    χ.primitiveCharacter_apply_of_isCoprime (Nat.isCoprime_iff_coprime.mpr hn)
end

section
open scoped BigOperators Classical ComplexConjugate
noncomputable def finiteCharacterCoefficient {G : Type*} [AddCommGroup G] [Fintype G]
    (f : G → ℂ) (χ : AddChar G ℂ) : ℂ :=
  (Fintype.card G : ℂ)⁻¹ * ∑ x, (starRingEnd ℂ) (χ x) * f x

theorem finite_character_dual_pair_sum {G : Type*} [AddCommGroup G] [Fintype G]
    [DecidableEq G] (x y : G) :
    (∑ χ : AddChar G ℂ, (starRingEnd ℂ) (χ x) * χ y) =
      if x = y then (Fintype.card G : ℂ) else 0 := by
  have ht (χ : AddChar G ℂ) : (starRingEnd ℂ) (χ x) * χ y = χ (y - x) := by
    rw [χ.map_sub_eq_div, div_eq_mul_inv, mul_comm]
    rw [← χ.inv_apply_eq_conj]
  simp_rw [ht]
  rw [AddChar.sum_apply_eq_ite]
  simp only [sub_eq_zero, eq_comm]

theorem finite_character_expansion {G : Type*} [AddCommGroup G] [Fintype G]
    [DecidableEq G] (f : G → ℂ) (y : G) :
    (∑ χ : AddChar G ℂ, finiteCharacterCoefficient f χ * χ y) = f y := by
  have hN : (Fintype.card G : ℂ) ≠ 0 := by
    exact_mod_cast Fintype.card_ne_zero
  calc
    _ = (Fintype.card G : ℂ)⁻¹ *
        ∑ x, f x * ∑ χ : AddChar G ℂ, (starRingEnd ℂ) (χ x) * χ y := by
      simp only [finiteCharacterCoefficient, Finset.mul_sum, Finset.sum_mul]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro x _
      apply Finset.sum_congr rfl
      intro χ _
      ring
    _ = f y := by
      simp_rw [finite_character_dual_pair_sum]
      simp [hN, mul_ite, mul_left_comm]

theorem finite_character_coefficient_as_inner {G : Type*} [AddCommGroup G] [Fintype G]
    (f : G → ℂ) (χ : AddChar G ℂ) :
    finiteCharacterCoefficient f χ =
      inner ℂ (finiteMeasureVector (fun _ : G => (Fintype.card G : ℝ)⁻¹) χ)
        (finiteMeasureVector (fun _ : G => (Fintype.card G : ℝ)⁻¹) f) := by
  rw [finite_measure_vector_inner _ (fun _ => by positivity)]
  simp only [finiteCharacterCoefficient, Complex.ofReal_inv, Complex.ofReal_natCast,
    Finset.mul_sum, mul_assoc]

theorem finite_character_weighted_inner {G : Type*} [AddCommGroup G] [Fintype G]
    (χ ψ : AddChar G ℂ) :
    inner ℂ (finiteMeasureVector (fun _ : G => (Fintype.card G : ℝ)⁻¹) χ)
      (finiteMeasureVector (fun _ : G => (Fintype.card G : ℝ)⁻¹) ψ) =
      if χ = ψ then 1 else 0 := by
  rw [finite_measure_vector_inner _ (fun _ => by positivity)]
  have h := AddChar.wInner_cWeight_eq_boole χ ψ
  simpa only [RCLike.wInner_cWeight_eq_expect, Fintype.expect_eq_sum_div_card,
    RCLike.inner_apply, div_eq_mul_inv, Finset.sum_mul, Finset.mul_sum, mul_comm, mul_left_comm,
    mul_assoc, Complex.ofReal_inv, Complex.ofReal_natCast] using h

theorem finite_character_coefficient_energy {G : Type*} [AddCommGroup G] [Fintype G]
    (f : G → ℂ) :
    (∑ χ : AddChar G ℂ, ‖finiteCharacterCoefficient f χ‖ ^ 2) ≤
      (Fintype.card G : ℝ)⁻¹ * ∑ x, ‖f x‖ ^ 2 := by
  have hrow (χ : AddChar G ℂ) :
      (∑ ψ : AddChar G ℂ,
        ‖inner ℂ (finiteMeasureVector (fun _ : G => (Fintype.card G : ℝ)⁻¹) χ)
          (finiteMeasureVector (fun _ : G => (Fintype.card G : ℝ)⁻¹) ψ)‖) ≤ 1 := by
    simp only [finite_character_weighted_inner, apply_ite, norm_one, norm_zero]
    simp
  have he := finite_gram_row_analysis_sq _ (by norm_num : (0 : ℝ) ≤ 1) hrow
    (finiteMeasureVector (fun _ : G => (Fintype.card G : ℝ)⁻¹) f)
  have hμ : ∀ _x : G, 0 ≤ (Fintype.card G : ℝ)⁻¹ := fun _ => by positivity
  rw [finite_measure_vector_norm_sq _ hμ] at he
  simpa only [← finite_character_coefficient_as_inner, one_mul, Finset.mul_sum] using he

theorem finite_character_coefficient_l1 {G : Type*} [AddCommGroup G] [Fintype G]
    (f : G → ℂ) (hf : ∀ x, ‖f x‖ ≤ 1) :
    (∑ χ : AddChar G ℂ, ‖finiteCharacterCoefficient f χ‖) ≤
      Real.sqrt (Fintype.card G : ℝ) := by
  have hN : (Fintype.card G : ℝ) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have he : (∑ χ : AddChar G ℂ, ‖finiteCharacterCoefficient f χ‖ ^ 2) ≤ 1 := by
    apply (finite_character_coefficient_energy f).trans
    calc
      _ ≤ (Fintype.card G : ℝ)⁻¹ * ∑ _x : G, (1 : ℝ) := by
        gcongr with x
        exact (pow_le_pow_left₀ (norm_nonneg _) (hf x) 2).trans_eq (one_pow 2)
      _ = 1 := by simp [hN]
  have hcs := Finset.sum_mul_sq_le_sq_mul_sq Finset.univ
    (fun χ : AddChar G ℂ => ‖finiteCharacterCoefficient f χ‖) (fun _ => (1 : ℝ))
  simp only [mul_one, one_pow, Finset.sum_const, Finset.card_univ, nsmul_eq_mul,
    mul_one, AddChar.card_eq] at hcs
  have hb : (∑ χ : AddChar G ℂ, ‖finiteCharacterCoefficient f χ‖) ^ 2 ≤
      (Fintype.card G : ℝ) := hcs.trans (by simpa only [one_mul] using mul_le_mul_of_nonneg_right he (Nat.cast_nonneg (Fintype.card G) : (0 : ℝ) ≤ _))
  exact (Real.le_sqrt (Finset.sum_nonneg (fun _ _ => norm_nonneg _)) (Nat.cast_nonneg _)).mpr hb
end

section
open Finset
open scoped Classical
noncomputable def finiteTwoKernelAverage {X Y : Type*} [Fintype X] [Fintype Y]
    (μ : X → ℝ) (ν : Y → ℝ) (KA : X → X → ℂ) (KB : Y → Y → ℂ)
    (x : X) (y : Y) (F : X → Y → ℂ) : ℂ :=
  ∑ d, ∑ e, ((μ d : ℂ) * KA d x) * ((ν e : ℂ) * KB e y) * F d e

theorem finite_two_kernel_average_separable {X Y : Type*} [Fintype X] [Fintype Y]
    (μ : X → ℝ) (ν : Y → ℝ) (KA : X → X → ℂ) (KB : Y → Y → ℂ)
    (x : X) (y : Y) (f : X → ℂ) (g : Y → ℂ) :
    finiteTwoKernelAverage μ ν KA KB x y (fun d e => f d * g e) =
      (∑ d, (μ d : ℂ) * KA d x * f d) * (∑ e, (ν e : ℂ) * KB e y * g e) := by
  simp only [finiteTwoKernelAverage, sum_mul, mul_sum]
  rw [sum_comm]
  apply sum_congr rfl
  intro d _
  apply sum_congr rfl
  intro e _
  ring

theorem finite_two_kernel_average_sum {I X Y : Type*} [Fintype X] [Fintype Y]
    (s : Finset I) (μ : X → ℝ) (ν : Y → ℝ) (KA : X → X → ℂ) (KB : Y → Y → ℂ)
    (x : X) (y : Y) (F : I → X → Y → ℂ) :
    finiteTwoKernelAverage μ ν KA KB x y (∑ i ∈ s, F i) =
      ∑ i ∈ s, finiteTwoKernelAverage μ ν KA KB x y (F i) := by
  simp only [finiteTwoKernelAverage, Finset.sum_apply, mul_sum]
  simp_rw [sum_comm (s := (univ : Finset Y))]
  rw [sum_comm]

theorem finite_two_kernel_average_mul {X Y : Type*} [Fintype X] [Fintype Y]
    (μ : X → ℝ) (ν : Y → ℝ) (KA : X → X → ℂ) (KB : Y → Y → ℂ)
    (x : X) (y : Y) (c : ℂ) (F : X → Y → ℂ) :
    finiteTwoKernelAverage μ ν KA KB x y (fun d e => c * F d e) =
      c * finiteTwoKernelAverage μ ν KA KB x y F := by
  simp only [finiteTwoKernelAverage, mul_sum]
  apply sum_congr rfl
  intro d _
  apply sum_congr rfl
  intro e _
  ring

theorem finite_two_kernel_average_sub {X Y : Type*} [Fintype X] [Fintype Y]
    (μ : X → ℝ) (ν : Y → ℝ) (KA : X → X → ℂ) (KB : Y → Y → ℂ)
    (x : X) (y : Y) (F H : X → Y → ℂ) :
    finiteTwoKernelAverage μ ν KA KB x y (F - H) =
      finiteTwoKernelAverage μ ν KA KB x y F - finiteTwoKernelAverage μ ν KA KB x y H := by
  simp only [finiteTwoKernelAverage, Pi.sub_apply, mul_sub, sum_sub_distrib]

theorem complex_product_reproduction_error (a b u v : ℂ) (εA εB : ℝ)
    (hεA : 0 ≤ εA) (hεB : 0 ≤ εB) (ha : ‖a‖ ≤ 1) (hb : ‖b‖ ≤ 1)
    (hu : ‖u - a‖ ≤ εA) (hv : ‖v - b‖ ≤ εB) :
    ‖u * v - a * b‖ ≤ εA + εB + εA * εB := by
  have hvnorm : ‖v‖ ≤ εB + 1 := by
    calc
      _ = ‖(v - b) + b‖ := by congr 1; ring
      _ ≤ ‖v - b‖ + ‖b‖ := norm_add_le _ _
      _ ≤ εB + 1 := add_le_add hv hb
  calc
    _ = ‖(u - a) * v + a * (v - b)‖ := by congr 1; ring
    _ ≤ ‖(u - a) * v‖ + ‖a * (v - b)‖ := norm_add_le _ _
    _ = ‖u - a‖ * ‖v‖ + ‖a‖ * ‖v - b‖ := by rw [norm_mul, norm_mul]
    _ ≤ εA * (εB + 1) + 1 * εB :=
      add_le_add (mul_le_mul hu hvnorm (norm_nonneg _) hεA)
        ((mul_le_mul_of_nonneg_left hv (norm_nonneg _)).trans
          (mul_le_mul_of_nonneg_right ha hεB))
    _ = _ := by ring

theorem finite_two_kernel_character_error {X Y : Type*} [Fintype X] [Fintype Y]
    (μ : X → ℝ) (ν : Y → ℝ) (KA : X → X → ℂ) (KB : Y → Y → ℂ)
    (x : X) (y : Y) (χA : X → ℂ) (χB : Y → ℂ) (εA εB : ℝ)
    (hεA : 0 ≤ εA) (hεB : 0 ≤ εB) (hχA : ‖χA x‖ ≤ 1) (hχB : ‖χB y‖ ≤ 1)
    (hA : ‖(∑ d, (μ d : ℂ) * KA d x * χA d) - χA x‖ ≤ εA)
    (hB : ‖(∑ e, (ν e : ℂ) * KB e y * χB e) - χB y‖ ≤ εB) :
    ‖finiteTwoKernelAverage μ ν KA KB x y (fun d e => χA d * χB e) - χA x * χB y‖ ≤
      εA + εB + εA * εB := by
  rw [finite_two_kernel_average_separable]
  exact complex_product_reproduction_error _ _ _ _ εA εB hεA hεB hχA hχB hA hB

theorem finite_two_kernel_expansion_error {I X Y : Type*} [Fintype X] [Fintype Y]
    (s : Finset I) (μ : X → ℝ) (ν : Y → ℝ) (KA : X → X → ℂ) (KB : Y → Y → ℂ)
    (x : X) (y : Y) (c : I → ℂ) (χA : I → X → ℂ) (χB : I → Y → ℂ)
    (εA εB H : ℝ) (hεA : 0 ≤ εA) (hεB : 0 ≤ εB)
    (hc : ∑ i ∈ s, ‖c i‖ ≤ H)
    (hχA : ∀ i ∈ s, ‖χA i x‖ ≤ 1) (hχB : ∀ i ∈ s, ‖χB i y‖ ≤ 1)
    (hA : ∀ i ∈ s, ‖(∑ d, (μ d : ℂ) * KA d x * χA i d) - χA i x‖ ≤ εA)
    (hB : ∀ i ∈ s, ‖(∑ e, (ν e : ℂ) * KB e y * χB i e) - χB i y‖ ≤ εB) :
    ‖finiteTwoKernelAverage μ ν KA KB x y (fun d e => ∑ i ∈ s, c i * (χA i d * χB i e)) -
        ∑ i ∈ s, c i * (χA i x * χB i y)‖ ≤ H * (εA + εB + εA * εB) := by
  have hrewrite : finiteTwoKernelAverage μ ν KA KB x y
      (fun d e => ∑ i ∈ s, c i * (χA i d * χB i e)) =
      ∑ i ∈ s, c i * finiteTwoKernelAverage μ ν KA KB x y (fun d e => χA i d * χB i e) := by
    have hfun : (fun d e => ∑ i ∈ s, c i * (χA i d * χB i e)) =
        ∑ i ∈ s, fun d e => c i * (χA i d * χB i e) := by
      funext d e
      simp only [Finset.sum_apply]
    rw [hfun, finite_two_kernel_average_sum]
    simp_rw [finite_two_kernel_average_mul]
  rw [hrewrite, ← sum_sub_distrib]
  calc
    _ ≤ ∑ i ∈ s, ‖c i * finiteTwoKernelAverage μ ν KA KB x y (fun d e => χA i d * χB i e) -
        c i * (χA i x * χB i y)‖ := norm_sum_le _ _
    _ ≤ ∑ i ∈ s, ‖c i‖ * (εA + εB + εA * εB) := by
      apply sum_le_sum
      intro i hi
      rw [← mul_sub, norm_mul]
      exact mul_le_mul_of_nonneg_left
        (finite_two_kernel_character_error μ ν KA KB x y (χA i) (χB i) εA εB hεA hεB
          (hχA i hi) (hχB i hi) (hA i hi) (hB i hi)) (norm_nonneg _)
    _ = (∑ i ∈ s, ‖c i‖) * (εA + εB + εA * εB) := (sum_mul _ _ _).symm
    _ ≤ _ := mul_le_mul_of_nonneg_right hc (by positivity)

theorem finite_two_kernel_average_norm_le {X Y : Type*} [Fintype X] [Fintype Y]
    (μ : X → ℝ) (ν : Y → ℝ) (KA : X → X → ℂ) (KB : Y → Y → ℂ)
    (x : X) (y : Y) (F : X → Y → ℂ) (L RA RB : ℝ)
    (hμ : ∀ d, 0 ≤ μ d) (hν : ∀ e, 0 ≤ ν e) (hL : 0 ≤ L)
    (hA : ∑ d, μ d * ‖KA d x‖ ≤ RA) (hB : ∑ e, ν e * ‖KB e y‖ ≤ RB)
    (hF : ∀ d e, KA d x * KB e y ≠ 0 → ‖F d e‖ ≤ L) :
    ‖finiteTwoKernelAverage μ ν KA KB x y F‖ ≤ L * RA * RB := by
  have hRA : 0 ≤ RA := (sum_nonneg fun d _ => mul_nonneg (hμ d) (norm_nonneg _)).trans hA
  have hRBsum : 0 ≤ ∑ e, ν e * ‖KB e y‖ :=
    sum_nonneg fun e _ => mul_nonneg (hν e) (norm_nonneg _)
  have hterm (d : X) (e : Y) :
      ‖((μ d : ℂ) * KA d x) * ((ν e : ℂ) * KB e y) * F d e‖ ≤
        L * (μ d * ‖KA d x‖) * (ν e * ‖KB e y‖) := by
    by_cases hz : KA d x * KB e y = 0
    · rcases mul_eq_zero.mp hz with hz | hz <;> simp [hz]
    · simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hμ d),
        abs_of_nonneg (hν e)]
      calc
        _ ≤ (μ d * ‖KA d x‖ * (ν e * ‖KB e y‖)) * L :=
          mul_le_mul_of_nonneg_left (hF d e hz)
            (mul_nonneg (mul_nonneg (hμ d) (norm_nonneg _)) (mul_nonneg (hν e) (norm_nonneg _)))
        _ = _ := by ring
  calc
    _ ≤ ∑ d, ∑ e, ‖((μ d : ℂ) * KA d x) * ((ν e : ℂ) * KB e y) * F d e‖ :=
      (norm_sum_le _ _).trans (sum_le_sum fun d _ => norm_sum_le _ _)
    _ ≤ ∑ d, ∑ e, L * (μ d * ‖KA d x‖) * (ν e * ‖KB e y‖) :=
      sum_le_sum fun d _ => sum_le_sum fun e _ => hterm d e
    _ = L * (∑ d, μ d * ‖KA d x‖) * (∑ e, ν e * ‖KB e y‖) := by
      simp only [mul_sum, sum_mul]
      rw [sum_comm]
    _ ≤ L * RA * RB :=
      mul_le_mul (mul_le_mul_of_nonneg_left hA hL) hB hRBsum (mul_nonneg hL hRA)

theorem finite_two_kernel_multiplier_replacement {X Y : Type*} [Fintype X] [Fintype Y]
    (μ : X → ℝ) (ν : Y → ℝ) (KA : X → X → ℂ) (KB : Y → Y → ℂ)
    (x : X) (y : Y) (M phase : X → Y → ℂ) (L RA RB : ℝ)
    (hμ : ∀ d, 0 ≤ μ d) (hν : ∀ e, 0 ≤ ν e) (hL : 0 ≤ L)
    (hA : ∑ d, μ d * ‖KA d x‖ ≤ RA) (hB : ∑ e, ν e * ‖KB e y‖ ≤ RB)
    (hphase : ∀ d e, ‖phase d e‖ ≤ 1)
    (hM : ∀ d e, KA d x * KB e y ≠ 0 → ‖M d e - M x y‖ ≤ L) :
    ‖finiteTwoKernelAverage μ ν KA KB x y (fun d e => M d e * phase d e) -
        M x y * finiteTwoKernelAverage μ ν KA KB x y phase‖ ≤ L * RA * RB := by
  rw [← finite_two_kernel_average_mul, ← finite_two_kernel_average_sub]
  apply finite_two_kernel_average_norm_le μ ν KA KB x y _ L RA RB hμ hν hL hA hB
  intro d e hde
  change ‖M d e * phase d e - M x y * phase d e‖ ≤ L
  rw [← sub_mul, norm_mul]
  calc
    _ ≤ L * 1 := mul_le_mul (hM d e hde) (hphase d e) (norm_nonneg _) hL
    _ = L := mul_one _
end

section

open Finset
open scoped Classical

noncomputable def cleanNonemptySubsets {I : Type*} [DecidableEq I] (U : Finset I) : Finset (Finset I) :=
  U.powerset.erase ∅

theorem clean_mem_nonempty_subsets {I : Type*} [DecidableEq I] (U A : Finset I) :
    A ∈ cleanNonemptySubsets U ↔ A ≠ ∅ ∧ A ⊆ U := by
  simp [cleanNonemptySubsets]

theorem clean_nonempty_subsets_mono {I : Type*} [DecidableEq I] {U V : Finset I} (hUV : U ⊆ V) :
    cleanNonemptySubsets U ⊆ cleanNonemptySubsets V := by
  intro A hA
  rw [clean_mem_nonempty_subsets] at hA ⊢
  exact ⟨hA.1, hA.2.trans hUV⟩

theorem clean_nonempty_subset_sign_sum {I : Type*} [DecidableEq I] (U : Finset I) :
    (∑ A ∈ cleanNonemptySubsets U, (-1 : ℂ) ^ A.card) = if U = ∅ then 0 else -1 := by
  by_cases hU : U = ∅
  · simp [hU, cleanNonemptySubsets]
  · rw [if_neg hU]
    have h : (∑ A ∈ U.powerset, (-1 : ℂ) ^ A.card) = 0 := by
      exact_mod_cast (sum_powerset_neg_one_pow_card_of_nonempty (nonempty_iff_ne_empty.mpr hU))
    have he := sum_erase_add U.powerset (fun A : Finset I => (-1 : ℂ) ^ A.card)
      (show (∅ : Finset I) ∈ U.powerset by simp)
    change (∑ A ∈ U.powerset.erase ∅, (-1 : ℂ) ^ A.card) = -1
    simpa only [card_empty, pow_zero, h, zero_sub] using eq_sub_of_add_eq he

theorem clean_double_subset_sign_sum {I J : Type*} [DecidableEq I] [DecidableEq J] (U : Finset I) (V : Finset J) :
    (∑ A ∈ cleanNonemptySubsets U, ∑ B ∈ cleanNonemptySubsets V,
      (-1 : ℂ) ^ (A.card + B.card)) = if U = ∅ ∨ V = ∅ then 0 else 1 := by
  simp only [pow_add, ← mul_sum, ← sum_mul, clean_nonempty_subset_sign_sum]
  split_ifs <;> simp_all

theorem clean_signed_component_cancellation {I J : Type*} [DecidableEq I] [DecidableEq J] (U : Finset I) (V : Finset J)
    (r : ℂ) (q : Finset I → Finset J → ℂ) :
    r - (∑ A ∈ cleanNonemptySubsets U, ∑ B ∈ cleanNonemptySubsets V,
        (-1 : ℂ) ^ (A.card + B.card) * q A B) =
      (if U = ∅ ∨ V = ∅ then r else 0) -
        ∑ A ∈ cleanNonemptySubsets U, ∑ B ∈ cleanNonemptySubsets V,
          (-1 : ℂ) ^ (A.card + B.card) * (q A B - r) := by
  simp only [mul_sub, sum_sub_distrib, ← sum_mul, clean_double_subset_sign_sum]
  split_ifs <;> ring

noncomputable def cleanSignedComponentBlock {I J : Type*} [DecidableEq I] [DecidableEq J] (U : Finset I) (V : Finset J)
    (r : Finset I → Finset J → ℂ) (q : Finset I → Finset J → Finset I → Finset J → ℂ) : ℂ :=
  ∑ S ∈ U.powerset, ∑ T ∈ V.powerset,
    (r S T - ∑ A ∈ cleanNonemptySubsets (U \ S), ∑ B ∈ cleanNonemptySubsets (V \ T),
      (-1 : ℂ) ^ (A.card + B.card) * q S T A B)

noncomputable def cleanSignedComponentError {I J : Type*} [DecidableEq I] [DecidableEq J] (U : Finset I) (V : Finset J)
    (r : Finset I → Finset J → ℂ) (q : Finset I → Finset J → Finset I → Finset J → ℂ) : ℂ :=
  ∑ S ∈ U.powerset, ∑ T ∈ V.powerset,
    ∑ A ∈ cleanNonemptySubsets (U \ S), ∑ B ∈ cleanNonemptySubsets (V \ T),
      (-1 : ℂ) ^ (A.card + B.card) * (q S T A B - r S T)

theorem clean_exceptional_component_sum {I J : Type*} [DecidableEq I] [DecidableEq J] (U : Finset I) (V : Finset J)
    (r : Finset I → Finset J → ℂ) :
    (∑ S ∈ U.powerset, ∑ T ∈ V.powerset,
      if U \ S = ∅ ∨ V \ T = ∅ then r S T else 0) =
      (∑ T ∈ V.powerset, r U T) + ∑ S ∈ U.powerset.erase U, r S V := by
  rw [← sum_erase_add U.powerset _ (show U ∈ U.powerset by simp)]
  have hfull : (∑ T ∈ V.powerset, if U \ U = ∅ ∨ V \ T = ∅ then r U T else 0) =
      ∑ T ∈ V.powerset, r U T := by simp
  rw [hfull, add_comm]
  congr 1
  apply sum_congr rfl
  intro S hS
  have hSU : S ⊆ U := mem_powerset.mp (mem_erase.mp hS).2
  have hne : U \ S ≠ ∅ := by
    intro h
    exact (mem_erase.mp hS).1 ((sdiff_eq_empty_iff_subset.mp h).antisymm hSU).symm
  calc
    (∑ T ∈ V.powerset, if U \ S = ∅ ∨ V \ T = ∅ then r S T else 0) =
        ∑ T ∈ V.powerset, if T = V then r S T else 0 := by
      apply sum_congr rfl
      intro T hT
      have hTV := mem_powerset.mp hT
      have he : V \ T = ∅ ↔ T = V := by
        constructor
        · intro h; exact hTV.antisymm (sdiff_eq_empty_iff_subset.mp h)
        · rintro rfl; simp
      simp only [hne, false_or, he]
    _ = r S V := by simp

theorem clean_signed_block_cancellation {I J : Type*} [DecidableEq I] [DecidableEq J] (U : Finset I) (V : Finset J)
    (r : Finset I → Finset J → ℂ) (q : Finset I → Finset J → Finset I → Finset J → ℂ) :
    cleanSignedComponentBlock U V r q =
      ((∑ T ∈ V.powerset, r U T) + ∑ S ∈ U.powerset.erase U, r S V) -
        cleanSignedComponentError U V r q := by
  unfold cleanSignedComponentBlock cleanSignedComponentError
  calc
    _ = ∑ S ∈ U.powerset, ∑ T ∈ V.powerset,
        ((if U \ S = ∅ ∨ V \ T = ∅ then r S T else 0) -
          ∑ A ∈ cleanNonemptySubsets (U \ S), ∑ B ∈ cleanNonemptySubsets (V \ T),
            (-1 : ℂ) ^ (A.card + B.card) * (q S T A B - r S T)) := by
      apply sum_congr rfl
      intro S _
      apply sum_congr rfl
      intro T _
      exact clean_signed_component_cancellation _ _ _ _
    _ = _ := by simp only [sum_sub_distrib]; rw [clean_exceptional_component_sum]

/-- Each probe is indicated, missing but not freed, or freed. -/
theorem clean_admissible_subset_count {I : Type*} [DecidableEq I] (U : Finset I) :
    (∑ S ∈ U.powerset, (cleanNonemptySubsets (U \ S)).card) ≤ 3 ^ U.card := by
  calc
    _ ≤ ∑ S ∈ U.powerset, 2 ^ (U \ S).card := by
      apply sum_le_sum
      intro S _
      exact (card_erase_le).trans_eq (card_powerset _)
    _ = 3 ^ U.card := by
      have h := prod_add (fun _ : I => (1 : ℕ)) (fun _ : I => (2 : ℕ)) U
      simpa only [prod_const, one_pow, one_mul, show (1 : ℕ) + 2 = 3 by rfl] using h.symm

theorem clean_signed_component_error_bound {I J : Type*} [DecidableEq I] [DecidableEq J] (U : Finset I) (V : Finset J)
    (r : Finset I → Finset J → ℂ) (q : Finset I → Finset J → Finset I → Finset J → ℂ)
    (ε : ℝ) (hε : 0 ≤ ε)
    (herr : ∀ S ∈ U.powerset, ∀ T ∈ V.powerset,
      ∀ A ∈ cleanNonemptySubsets (U \ S), ∀ B ∈ cleanNonemptySubsets (V \ T),
        ‖q S T A B - r S T‖ ≤ ε) :
    ‖cleanSignedComponentError U V r q‖ ≤ (3 : ℝ) ^ (U.card + V.card) * ε := by
  have hU : (∑ S ∈ U.powerset, ((cleanNonemptySubsets (U \ S)).card : ℝ)) ≤ 3 ^ U.card := by
    exact_mod_cast clean_admissible_subset_count U
  have hV : (∑ T ∈ V.powerset, ((cleanNonemptySubsets (V \ T)).card : ℝ)) ≤ 3 ^ V.card := by
    exact_mod_cast clean_admissible_subset_count V
  calc
    _ ≤ ∑ S ∈ U.powerset, ∑ T ∈ V.powerset,
        ∑ A ∈ cleanNonemptySubsets (U \ S), ∑ B ∈ cleanNonemptySubsets (V \ T),
          ‖(-1 : ℂ) ^ (A.card + B.card) * (q S T A B - r S T)‖ := by
      unfold cleanSignedComponentError
      exact (norm_sum_le _ _).trans (sum_le_sum fun S _ =>
        (norm_sum_le _ _).trans (sum_le_sum fun T _ =>
          (norm_sum_le _ _).trans (sum_le_sum fun A _ => norm_sum_le _ _)))
    _ ≤ ∑ S ∈ U.powerset, ∑ T ∈ V.powerset,
        ∑ A ∈ cleanNonemptySubsets (U \ S), ∑ B ∈ cleanNonemptySubsets (V \ T), ε := by
      apply sum_le_sum
      intro S hS
      apply sum_le_sum
      intro T hT
      apply sum_le_sum
      intro A hA
      apply sum_le_sum
      intro B hB
      simpa only [norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul] using herr S hS T hT A hA B hB
    _ = (∑ S ∈ U.powerset, ((cleanNonemptySubsets (U \ S)).card : ℝ)) *
        (∑ T ∈ V.powerset, ((cleanNonemptySubsets (V \ T)).card : ℝ)) * ε := by
      simp only [sum_const, nsmul_eq_mul]
      simp_rw [← mul_sum]
      rw [← sum_mul, ← sum_mul]
      ring
    _ ≤ (3 : ℝ) ^ U.card * 3 ^ V.card * ε := by
      apply mul_le_mul_of_nonneg_right _ hε
      exact mul_le_mul hU hV (sum_nonneg fun _ _ => Nat.cast_nonneg _) (by positivity)
    _ = _ := by rw [pow_add]

theorem clean_signed_block_exceptional_bound {I J : Type*} [DecidableEq I] [DecidableEq J] (U : Finset I) (V : Finset J)
    (r : Finset I → Finset J → ℂ) (q : Finset I → Finset J → Finset I → Finset J → ℂ)
    (ε : ℝ) (hε : 0 ≤ ε)
    (herr : ∀ S ∈ U.powerset, ∀ T ∈ V.powerset,
      ∀ A ∈ cleanNonemptySubsets (U \ S), ∀ B ∈ cleanNonemptySubsets (V \ T),
        ‖q S T A B - r S T‖ ≤ ε) :
    ‖cleanSignedComponentBlock U V r q -
      ((∑ T ∈ V.powerset, r U T) + ∑ S ∈ U.powerset.erase U, r S V)‖ ≤
        (3 : ℝ) ^ (U.card + V.card) * ε := by
  rw [clean_signed_block_cancellation]
  have he : ((∑ T ∈ V.powerset, r U T) + ∑ S ∈ U.powerset.erase U, r S V) -
      cleanSignedComponentError U V r q -
        ((∑ T ∈ V.powerset, r U T) + ∑ S ∈ U.powerset.erase U, r S V) =
      -cleanSignedComponentError U V r q := by ring
  rw [he, norm_neg]
  exact clean_signed_component_error_bound U V r q ε hε herr
end

section

open Finset
open scoped Classical

theorem finite_probe_component_norm_le {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hμ : ∀ i x, 0 ≤ μ i x) (hmass : ∀ i, ∑ y, μ i y = 1)
    (U S : Finset I) (hS : S ⊆ U) (f : (∀ i, X i) → ℂ) :
    Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ S U.toList f)) ≤
      Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) f) := by
  apply Real.sqrt_le_sqrt
  exact finite_coordinate_component_energy_le μ hμ hmass U.toList (nodup_toList U) S
    (by simpa using hS) f

theorem finite_probe_comparison_error_uniform {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hμ : ∀ i x, 0 ≤ μ i x) (hmass : ∀ i, ∑ y, μ i y = 1)
    (U V S T : Finset I) (hS : S ⊆ U) (hT : T ⊆ V)
    (f g : (∀ i, X i) → ℂ) (ε : ℝ) (hε : 0 ≤ ε) (e : ℂ)
    (he : ‖e‖ ≤ ε *
      Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ S U.toList f)) *
      Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ T V.toList g))) :
    ‖e‖ ≤ ε * Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) f) *
      Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) g) := by
  exact he.trans (mul_le_mul
    (mul_le_mul_of_nonneg_left (finite_probe_component_norm_le μ hμ hmass U S hS f) hε)
    (finite_probe_component_norm_le μ hμ hmass V T hT g)
    (Real.sqrt_nonneg _) (mul_nonneg hε (Real.sqrt_nonneg _)))
end

section

open Finset
open scoped Classical

theorem finite_coordinate_average_of_independent {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (i : I) (hmass : ∑ y, μ i y = 1) (h : (∀ j, X j) → ℂ)
    (hi : ∀ x y, h (Function.update x i y) = h x) :
    finiteCoordinateAverage μ i h = h := by
  funext x
  rw [finite_coordinate_average_update]
  simp_rw [hi]
  rw [← sum_mul]
  have hm : (∑ y, (μ i y : ℂ)) = 1 := by exact_mod_cast hmass
  rw [hm, one_mul]

theorem finite_probe_component_pairing_zero_left {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hmass : ∀ i, ∑ y, μ i y = 1) (U S : Finset I) (hS : S ⊆ U)
    (i : I) (hiS : i ∈ S) (f h : (∀ j, X j) → ℂ)
    (hi : ∀ x y, h (Function.update x i y) = h x) :
    (∑ x, (finiteProductWeight μ x : ℂ) *
      ((starRingEnd ℂ) (finiteCoordinateComponent μ S U.toList f x) * h x)) = 0 := by
  have he := finite_coordinate_average_selfadjoint μ i
    (finiteCoordinateComponent μ S U.toList f) h
  rw [finite_coordinate_component_average μ hmass S U.toList i
    (by simpa using hS hiS), if_pos hiS,
    finite_coordinate_average_of_independent μ i (hmass i) h hi] at he
  simpa only [Pi.zero_apply, map_zero, zero_mul, mul_zero, sum_const_zero] using he.symm

theorem finite_probe_component_pairing_zero_right {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hmass : ∀ i, ∑ y, μ i y = 1) (U S : Finset I) (hS : S ⊆ U)
    (i : I) (hiS : i ∈ S) (f h : (∀ j, X j) → ℂ)
    (hi : ∀ x y, h (Function.update x i y) = h x) :
    (∑ x, (finiteProductWeight μ x : ℂ) *
      ((starRingEnd ℂ) (h x) * finiteCoordinateComponent μ S U.toList f x)) = 0 := by
  have he := finite_coordinate_average_selfadjoint μ i h
    (finiteCoordinateComponent μ S U.toList f)
  rw [finite_coordinate_average_of_independent μ i (hmass i) h hi,
    finite_coordinate_component_average μ hmass S U.toList i
      (by simpa using hS hiS), if_pos hiS] at he
  simpa only [Pi.zero_apply, mul_zero, sum_const_zero] using he
end

section
open Finset
open scoped Classical
noncomputable def cleanRawPairing {X : Type*} [Fintype X]
    (w : X → ℝ) (k f g : X → ℂ) : ℂ :=
  ∑ x, (w x : ℂ) * (starRingEnd ℂ) (f x) * g x * k x

noncomputable def cleanKernelPairing {X Y : Type*} [Fintype X] [Fintype Y]
    (w : X → ℝ) (K : X → Y → ℂ) (f : X → ℂ) (g : Y → ℂ) : ℂ :=
  ∑ x, ∑ y, (w x : ℂ) * (starRingEnd ℂ) (f x) * K x y * g y

theorem clean_raw_pairing_sum_left {A X : Type*} [Fintype X]
    (s : Finset A) (w : X → ℝ) (k : X → ℂ) (F : A → X → ℂ) (g : X → ℂ) :
    cleanRawPairing w k (∑ a ∈ s, F a) g = ∑ a ∈ s, cleanRawPairing w k (F a) g := by
  simp only [cleanRawPairing, Finset.sum_apply, map_sum, mul_sum, sum_mul]
  rw [sum_comm]

theorem clean_raw_pairing_sum_right {A X : Type*} [Fintype X]
    (s : Finset A) (w : X → ℝ) (k f : X → ℂ) (H : A → X → ℂ) :
    cleanRawPairing w k f (∑ a ∈ s, H a) = ∑ a ∈ s, cleanRawPairing w k f (H a) := by
  simp only [cleanRawPairing, Finset.sum_apply, mul_sum, sum_mul]
  rw [sum_comm]

theorem clean_raw_pairing_add_left {X : Type*} [Fintype X]
    (w : X → ℝ) (k f f' g : X → ℂ) :
    cleanRawPairing w k (f + f') g = cleanRawPairing w k f g + cleanRawPairing w k f' g := by
  simp only [cleanRawPairing, Pi.add_apply, map_add, mul_add, add_mul, sum_add_distrib]

theorem clean_raw_pairing_add_right {X : Type*} [Fintype X]
    (w : X → ℝ) (k f g g' : X → ℂ) :
    cleanRawPairing w k f (g + g') = cleanRawPairing w k f g + cleanRawPairing w k f g' := by
  simp only [cleanRawPairing, Pi.add_apply, mul_add, add_mul, sum_add_distrib]

theorem clean_raw_pairing_sub_left {X : Type*} [Fintype X]
    (w : X → ℝ) (k f f' g : X → ℂ) :
    cleanRawPairing w k (f - f') g = cleanRawPairing w k f g - cleanRawPairing w k f' g := by
  simp only [cleanRawPairing, Pi.sub_apply, map_sub, mul_sub, sub_mul, sum_sub_distrib]

theorem clean_kernel_pairing_sum_left {A X Y : Type*} [Fintype X] [Fintype Y]
    (s : Finset A) (w : X → ℝ) (K : X → Y → ℂ) (F : A → X → ℂ) (g : Y → ℂ) :
    cleanKernelPairing w K (∑ a ∈ s, F a) g = ∑ a ∈ s, cleanKernelPairing w K (F a) g := by
  simp only [cleanKernelPairing, Finset.sum_apply, map_sum, mul_sum, sum_mul]
  simp_rw [sum_comm (s := (univ : Finset Y))]
  rw [sum_comm]

theorem clean_kernel_pairing_sum_right {A X Y : Type*} [Fintype X] [Fintype Y]
    (s : Finset A) (w : X → ℝ) (K : X → Y → ℂ) (f : X → ℂ) (H : A → Y → ℂ) :
    cleanKernelPairing w K f (∑ a ∈ s, H a) = ∑ a ∈ s, cleanKernelPairing w K f (H a) := by
  simp only [cleanKernelPairing, Finset.sum_apply, mul_sum]
  simp_rw [sum_comm (s := (univ : Finset Y))]
  rw [sum_comm]

theorem clean_kernel_pairing_sum_kernel {A X Y : Type*} [Fintype X] [Fintype Y]
    (s : Finset A) (w : X → ℝ) (K : A → X → Y → ℂ) (f : X → ℂ) (g : Y → ℂ) :
    cleanKernelPairing w (∑ a ∈ s, K a) f g = ∑ a ∈ s, cleanKernelPairing w (K a) f g := by
  simp only [cleanKernelPairing, Finset.sum_apply, mul_sum, sum_mul]
  simp_rw [sum_comm (s := (univ : Finset Y))]
  rw [sum_comm]

theorem clean_kernel_pairing_smul_kernel {X Y : Type*} [Fintype X] [Fintype Y]
    (w : X → ℝ) (K : X → Y → ℂ) (f : X → ℂ) (g : Y → ℂ) (a : ℂ) :
    cleanKernelPairing w (a • K) f g = a * cleanKernelPairing w K f g := by
  simp only [cleanKernelPairing, Pi.smul_apply, smul_eq_mul, mul_sum]
  apply sum_congr rfl
  intro x _
  apply sum_congr rfl
  intro y _
  ring

theorem clean_component_sum {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (U : Finset I) (f : (∀ i, X i) → ℂ) :
    (∑ S ∈ U.powerset, finiteCoordinateComponent μ S U.toList f) = f := by
  simpa using finite_coordinate_component_sum μ U.toList U.nodup_toList f

theorem clean_component_erase_sum {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (U : Finset I) (f : (∀ i, X i) → ℂ) :
    (∑ S ∈ U.powerset.erase U, finiteCoordinateComponent μ S U.toList f) =
      f - finiteCoordinateComponent μ U U.toList f := by
  apply eq_sub_iff_add_eq.mpr
  rw [sum_erase_add _ _ (show U ∈ U.powerset by simp), clean_component_sum]

theorem clean_raw_component_pairing_sum {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (U V : Finset I) (w : (∀ i, X i) → ℝ) (k f g : (∀ i, X i) → ℂ) :
    (∑ S ∈ U.powerset, ∑ T ∈ V.powerset,
      cleanRawPairing w k (finiteCoordinateComponent μ S U.toList f)
        (finiteCoordinateComponent μ T V.toList g)) = cleanRawPairing w k f g := by
  simp_rw [← clean_raw_pairing_sum_right, clean_component_sum]
  rw [← clean_raw_pairing_sum_left, clean_component_sum]

theorem clean_kernel_component_pairing_sum {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (U V : Finset I) (w : (∀ i, X i) → ℝ) (K : (∀ i, X i) → (∀ i, X i) → ℂ)
    (f g : (∀ i, X i) → ℂ) :
    (∑ S ∈ U.powerset, ∑ T ∈ V.powerset,
      cleanKernelPairing w K (finiteCoordinateComponent μ S U.toList f)
        (finiteCoordinateComponent μ T V.toList g)) = cleanKernelPairing w K f g := by
  simp_rw [← clean_kernel_pairing_sum_right, clean_component_sum]
  rw [← clean_kernel_pairing_sum_left, clean_component_sum]

theorem clean_raw_component_exceptional_pairing {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (U V : Finset I) (w : (∀ i, X i) → ℝ) (k f g : (∀ i, X i) → ℂ) :
    (∑ T ∈ V.powerset,
      cleanRawPairing w k (finiteCoordinateComponent μ U U.toList f)
        (finiteCoordinateComponent μ T V.toList g)) +
      (∑ S ∈ U.powerset.erase U,
        cleanRawPairing w k (finiteCoordinateComponent μ S U.toList f)
          (finiteCoordinateComponent μ V V.toList g)) =
      cleanRawPairing w k (finiteCoordinateComponent μ U U.toList f) g +
        cleanRawPairing w k (f - finiteCoordinateComponent μ U U.toList f)
          (finiteCoordinateComponent μ V V.toList g) := by
  rw [← clean_raw_pairing_sum_right, clean_component_sum,
    ← clean_raw_pairing_sum_left, clean_component_erase_sum]
end

section
open Finset Classical
universe uJ uK uG uP uA

section

variable {J : Type uJ} {K : Type uK} {G : Type uG} {P : G → Type uP}
  (n : ∀ g, P g → ℕ) {M : G → ℕ}
  (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type uA)
  (Δ D : ∀ k c, A k c → G → ℤ)

def FullPermutationMixedEvent : Option (J ⊕ K) →
    ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → Type _
  | none, _ => ULift.{max uA uP} (FullActiveSlotPermutations M)
  | some k, s => FullMixedMemoryEvent n S B A Δ D k s

noncomputable abbrev fullPermutationMixedEventFintype [Fintype G] [DecidableEq G]
    [∀ g, Fintype (P g)] [∀ g p, NeZero (n g p)] [∀ k c, Fintype (A k c)]
    (k : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    Fintype (FullPermutationMixedEvent n S B A Δ D k s) := by
  cases k with
  | none => dsimp [FullPermutationMixedEvent]; infer_instance
  | some k => exact fullMixedMemoryEventFintype n S B A Δ D k s

noncomputable def fullPermutationMixedEventTarget (k : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    FullPermutationMixedEvent n S B A Δ D k s →
      ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B :=
  match k with
  | none => fun e => fullActivePermutation e.down s
  | some k => fullMixedMemoryEventTarget n S B A Δ D k s

noncomputable def fullPermutationMixedEventWeight [Fintype G] [DecidableEq G]
    (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)
    (k : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    FullPermutationMixedEvent n S B A Δ D k s → ℝ :=
  match k with
  | none => fun e => fullActivePermutationWeight M e.down
  | some k => fullMixedMemoryEventWeight n S B A Δ D ω μ q ρ V k s

noncomputable def fullPermutationMixedPositiveOperator [Fintype G] [DecidableEq G]
    [∀ g, Fintype (P g)] [∀ g p, NeZero (n g p)] [∀ k c, Fintype (A k c)]
    (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)
    (k : Option (J ⊕ K)) :=
  match k with
  | none => fullActiveAverage
  | some k => fullMixedMemoryPositiveOperator n S B A Δ D ω μ q ρ V k

theorem full_permutation_mixed_absolute_actions_eq [Fintype G] [DecidableEq G]
    [∀ g, Fintype (P g)] [∀ g p, NeZero (n g p)] [∀ k c, Fintype (A k c)]
    (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)
    (hω : ∀ k c a, 0 ≤ ω k c a)
    (hμ : ∀ g p, 0 ≤ μ g p) (hq : ∀ j, 0 ≤ q j) (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ V g) :
    let _ : ∀ (k : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D k s) :=
      fullPermutationMixedEventFintype n S B A Δ D
    finiteLocalEventAction (FullPermutationMixedEvent n S B A Δ D)
      (fun k s e => |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V k s e|)
      (fullPermutationMixedEventTarget n S B A Δ D) =
        fullPermutationMixedPositiveOperator n S B A Δ D ω μ q ρ V := by
  let _ : ∀ (k : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D k s) :=
    fullPermutationMixedEventFintype n S B A Δ D
  funext k f s
  cases k with
  | none =>
    dsimp only [finiteLocalEventAction, fullPermutationMixedEventWeight,
      fullPermutationMixedEventTarget, fullPermutationMixedPositiveOperator, fullActiveAverage]
    refine Eq.trans ?_ (Equiv.sum_comp
      (Equiv.ulift : ULift.{max uA uP} (FullActiveSlotPermutations M) ≃ FullActiveSlotPermutations M)
      (fun τ : FullActiveSlotPermutations M =>
        (fullActivePermutationWeight M τ : ℂ) * f (fullActivePermutation τ s)))
    apply sum_congr
    · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
    · intro e _
      rw [abs_of_nonneg (fullActivePermutationWeight_nonneg M e.down)]
      rfl
  | some k =>
    have h := congrFun (congrFun (congrFun
      (full_mixed_memory_absolute_actions_eq n S B A Δ D ω μ q ρ V hω hμ hq hρ hV) k) f) s
    dsimp only [finiteLocalEventAction, fullPermutationMixedEventWeight,
      fullPermutationMixedEventTarget, fullPermutationMixedPositiveOperator]
    refine Eq.trans ?_ h
    apply sum_congr
    · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
    · intro e _
      rfl

end
end

section
open Finset Classical
theorem finite_pattern_sum_sq_le {I : Type*} (patterns : Finset I)
    (c : I → ℝ) (hc : ∀ i ∈ patterns, 0 ≤ c i) (a F : I → ℂ)
    (ha : ∀ i ∈ patterns, ‖a i‖ ≤ c i) :
    ‖∑ i ∈ patterns, a i * F i‖ ^ 2 ≤
      (∑ i ∈ patterns, c i) * ∑ i ∈ patterns, c i * ‖F i‖ ^ 2 := by
  have h := complex_row_weighted_cauchy patterns a F (fun _ => 1) (by intros; norm_num)
  simp only [mul_one, div_one] at h
  refine h.trans (mul_le_mul (sum_le_sum ha) ?_ ?_ ?_)
  · exact sum_le_sum fun i hi => mul_le_mul_of_nonneg_right (ha i hi) (sq_nonneg _)
  · exact sum_nonneg fun i _ => mul_nonneg (norm_nonneg _) (sq_nonneg _)
  · exact sum_nonneg hc

/-- Coefficients may depend on the output state; their bounds are uniform. -/
theorem finite_pattern_energy_le_weighted {I X : Type*} [Fintype X]
    (patterns : Finset I) (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x)
    (c : I → ℝ) (hc : ∀ i ∈ patterns, 0 ≤ c i)
    (a F : I → X → ℂ) (ha : ∀ i ∈ patterns, ∀ x, ‖a i x‖ ≤ c i) :
    finiteWeightedEnergy μ (fun x => ∑ i ∈ patterns, a i x * F i x) ≤
      (∑ i ∈ patterns, c i) * ∑ i ∈ patterns, c i * finiteWeightedEnergy μ (F i) := by
  calc
    _ ≤ ∑ x, μ x * ((∑ i ∈ patterns, c i) * ∑ i ∈ patterns, c i * ‖F i x‖ ^ 2) := by
      apply sum_le_sum
      intro x _
      exact mul_le_mul_of_nonneg_left
        (finite_pattern_sum_sq_le patterns c hc (fun i => a i x) (fun i => F i x)
          (fun i hi => ha i hi x)) (hμ x)
    _ = _ := by
      simp only [finiteWeightedEnergy, mul_sum]
      rw [sum_comm]
      apply sum_congr rfl
      intro i hi
      apply sum_congr rfl
      intro x hx
      ring

theorem finite_pattern_energy_le {I X : Type*} [Fintype X]
    (patterns : Finset I) (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x)
    (c : I → ℝ) (hc : ∀ i ∈ patterns, 0 ≤ c i)
    (a F : I → X → ℂ) (ha : ∀ i ∈ patterns, ∀ x, ‖a i x‖ ≤ c i)
    {H C : ℝ} (hH : ∑ i ∈ patterns, c i ≤ H) (hC : 0 ≤ C)
    (f : X → ℂ) (hF : ∀ i ∈ patterns, finiteWeightedEnergy μ (F i) ≤ C * finiteWeightedEnergy μ f) :
    finiteWeightedEnergy μ (fun x => ∑ i ∈ patterns, a i x * F i x) ≤
      H ^ 2 * C * finiteWeightedEnergy μ f := by
  have hs : 0 ≤ ∑ i ∈ patterns, c i := sum_nonneg hc
  have hH0 : 0 ≤ H := hs.trans hH
  have hf0 : 0 ≤ finiteWeightedEnergy μ f :=
    sum_nonneg fun x _ => mul_nonneg (hμ x) (sq_nonneg _)
  calc
    _ ≤ (∑ i ∈ patterns, c i) * ∑ i ∈ patterns, c i * finiteWeightedEnergy μ (F i) :=
      finite_pattern_energy_le_weighted patterns μ hμ c hc a F ha
    _ ≤ (∑ i ∈ patterns, c i) * ∑ i ∈ patterns, c i * (C * finiteWeightedEnergy μ f) := by
      apply mul_le_mul_of_nonneg_left _ hs
      exact sum_le_sum fun i hi => mul_le_mul_of_nonneg_left (hF i hi) (hc i hi)
    _ = (∑ i ∈ patterns, c i) ^ 2 * (C * finiteWeightedEnergy μ f) := by
      rw [← sum_mul]
      ring
    _ ≤ H ^ 2 * (C * finiteWeightedEnergy μ f) :=
      mul_le_mul_of_nonneg_right ((sq_le_sq₀ hs hH0).mpr hH) (mul_nonneg hC hf0)
    _ = _ := by ring

theorem finite_pattern_energy_le_const {I X : Type*} [Fintype X]
    (patterns : Finset I) (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x)
    (c : I → ℝ) (hc : ∀ i ∈ patterns, 0 ≤ c i)
    (a : I → ℂ) (F : I → X → ℂ) (ha : ∀ i ∈ patterns, ‖a i‖ ≤ c i)
    {H C : ℝ} (hH : ∑ i ∈ patterns, c i ≤ H) (hC : 0 ≤ C)
    (f : X → ℂ) (hF : ∀ i ∈ patterns, finiteWeightedEnergy μ (F i) ≤ C * finiteWeightedEnergy μ f) :
    finiteWeightedEnergy μ (fun x => ∑ i ∈ patterns, a i * F i x) ≤
      H ^ 2 * C * finiteWeightedEnergy μ f :=
  finite_pattern_energy_le patterns μ hμ c hc (fun i _ => a i) F
    (fun i hi _ => ha i hi) hH hC f hF
end

section
open Finset Classical
theorem norm_div_real_bound_le_one {z : ℂ} {c : ℝ} (hc : 0 ≤ c) (hz : ‖z‖ ≤ c) :
    ‖z / (c : ℂ)‖ ≤ 1 := by
  by_cases hzero : c = 0
  · simp [hzero]
  · rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hc]
    exact (div_le_one (lt_of_le_of_ne hc (Ne.symm hzero))).mpr hz

theorem real_bound_mul_div_eq {z : ℂ} {c : ℝ} (hz : ‖z‖ ≤ c) :
    (c : ℂ) * (z / (c : ℂ)) = z := by
  by_cases hzero : c = 0
  · have hz0 : z = 0 := norm_eq_zero.mp (le_antisymm (hzero ▸ hz) (norm_nonneg _))
    simp [hzero, hz0]
  · have hc : (c : ℂ) ≠ 0 := by exact_mod_cast hzero
    exact mul_div_cancel₀ z hc

theorem finite_event_path_phase_mul {K X : Type*} (E : K → X → Type*)
    [∀ k x, Fintype (E k x)] (target : ∀ k x, E k x → X)
    (w : ∀ k x, E k x → ℝ) (ks : List K)
    (phase : ∀ x, FiniteEventPath E target ks x → ℂ) (c : ℂ) (f : X → ℂ) (x : X) :
    finiteEventPathAction E target w ks (fun y p => c * phase y p) f x =
      c * finiteEventPathAction E target w ks phase f x := by
  simp only [finiteEventPathAction, mul_sum]
  apply sum_congr rfl
  intro p _
  ring

theorem finite_event_path_phase_normalize {K X : Type*} (E : K → X → Type*)
    [∀ k x, Fintype (E k x)] (target : ∀ k x, E k x → X)
    (w : ∀ k x, E k x → ℝ) (ks : List K)
    (phase : ∀ x, FiniteEventPath E target ks x → ℂ) (c : ℝ)
    (hphase : ∀ x p, ‖phase x p‖ ≤ c) (f : X → ℂ) (x : X) :
    finiteEventPathAction E target w ks phase f x =
      (c : ℂ) * finiteEventPathAction E target w ks (fun y p => phase y p / (c : ℂ)) f x := by
  rw [← finite_event_path_phase_mul]
  congr 1
  funext y p
  exact (real_bound_mul_div_eq (hphase y p)).symm
end

section
open Finset Classical
theorem fullActiveAverage_absorb_input_permutation
    {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ}
    (f : ProductBoundedOrderedState P Z M B → ℂ) (τ : FullActiveSlotPermutations M) :
    fullActiveAverage (fun x => f (fullActivePermutation τ x)) = fullActiveAverage f := by
  funext x
  simp only [fullActiveAverage, fullActivePermutation_mul, fullActivePermutationWeight]
  exact Equiv.sum_comp (Equiv.mulRight τ)
    (fun σ => (((Fintype.card (FullActiveSlotPermutations M) : ℝ)⁻¹ : ℝ) : ℂ) *
      f (fullActivePermutation σ x))

/-- In operator notation, Π Uσ T Uτ Π = Π T Π. The two permutations
are fixed independently of the labels, and T needs no linearity hypothesis. -/
theorem fullActiveAverage_operator_permutation_sandwich
    {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ}
    (T : (ProductBoundedOrderedState P Z M B → ℂ) →
      ProductBoundedOrderedState P Z M B → ℂ)
    (σ τ : FullActiveSlotPermutations M) (f : ProductBoundedOrderedState P Z M B → ℂ) :
    fullActiveAverage (fun x =>
      T (fun y => fullActiveAverage f (fullActivePermutation τ y)) (fullActivePermutation σ x)) =
      fullActiveAverage (T (fullActiveAverage f)) := by
  have hin : (fun y => fullActiveAverage f (fullActivePermutation τ y)) = fullActiveAverage f :=
    funext (fullActiveAverage_invariant f τ)
  rw [hin]
  exact fullActiveAverage_absorb_input_permutation (T (fullActiveAverage f)) σ
end

section
open Finset
def finitePartitionEquiv {I J : Type*} [Fintype I] [Fintype J]
    [DecidableEq I] [DecidableEq J] (S : Finset I) (T : Finset J)
    (left : S ≃ T) (right : ↥(Sᶜ) ≃ ↥(Tᶜ)) : I ≃ J where
  toFun x := if hx : x ∈ S then (left ⟨x, hx⟩).val
    else (right ⟨x, mem_compl.mpr hx⟩).val
  invFun y := if hy : y ∈ T then (left.symm ⟨y, hy⟩).val
    else (right.symm ⟨y, mem_compl.mpr hy⟩).val
  left_inv x := by
    by_cases hx : x ∈ S
    · simp only [dif_pos hx]
      have hy := (left ⟨x, hx⟩).property
      rw [dif_pos hy]
      exact congrArg Subtype.val (left.symm_apply_apply ⟨x, hx⟩)
    · simp only [dif_neg hx]
      have hy := mem_compl.mp (right ⟨x, mem_compl.mpr hx⟩).property
      rw [dif_neg hy]
      exact congrArg Subtype.val (right.symm_apply_apply ⟨x, mem_compl.mpr hx⟩)
  right_inv y := by
    by_cases hy : y ∈ T
    · simp only [dif_pos hy]
      have hx := (left.symm ⟨y, hy⟩).property
      rw [dif_pos hx]
      exact congrArg Subtype.val (left.apply_symm_apply ⟨y, hy⟩)
    · simp only [dif_neg hy]
      have hx := mem_compl.mp (right.symm ⟨y, mem_compl.mpr hy⟩).property
      rw [dif_neg hx]
      exact congrArg Subtype.val (right.apply_symm_apply ⟨y, mem_compl.mpr hy⟩)

theorem finite_partition_equiv_left {I J : Type*} [Fintype I] [Fintype J]
    [DecidableEq I] [DecidableEq J] (S : Finset I) (T : Finset J)
    (left : S ≃ T) (right : ↥(Sᶜ) ≃ ↥(Tᶜ)) (i : S) :
    finitePartitionEquiv S T left right i.val = (left i).val := by
  simp only [finitePartitionEquiv, Equiv.coe_fn_mk, dif_pos i.property]

theorem finite_partition_equiv_right {I J : Type*} [Fintype I] [Fintype J]
    [DecidableEq I] [DecidableEq J] (S : Finset I) (T : Finset J)
    (left : S ≃ T) (right : ↥(Sᶜ) ≃ ↥(Tᶜ)) (i : ↥(Sᶜ)) :
    finitePartitionEquiv S T left right i.val = (right i).val := by
  simp only [finitePartitionEquiv, Equiv.coe_fn_mk, dif_neg (mem_compl.mp i.property)]

theorem finite_partition_equiv_mem_iff {I J : Type*} [Fintype I] [Fintype J]
    [DecidableEq I] [DecidableEq J] (S : Finset I) (T : Finset J)
    (left : S ≃ T) (right : ↥(Sᶜ) ≃ ↥(Tᶜ)) (x : I) :
    finitePartitionEquiv S T left right x ∈ T ↔ x ∈ S := by
  by_cases hx : x ∈ S
  · have he := finite_partition_equiv_left S T left right ⟨x, hx⟩
    rw [he]
    exact iff_of_true (left ⟨x, hx⟩).property hx
  · have he := finite_partition_equiv_right S T left right ⟨x, mem_compl.mpr hx⟩
    rw [he]
    exact iff_of_false (mem_compl.mp (right ⟨x, mem_compl.mpr hx⟩).property) hx
end

section
open Finset
open scoped Classical
def activeEmbeddingSizeCast {P : Type*} {t u : ℕ} (h : t = u)
    (source : Fin t ↪ P) : Fin u ↪ P := h ▸ source

theorem active_embedding_size_cast_apply {P : Type*} {t u : ℕ}
    (h : t = u) (source : Fin t ↪ P) (i : Fin u) :
    activeEmbeddingSizeCast h source i = source (finCongr h.symm i) := by
  subst u
  rfl

theorem global_birth_bounded_edge_events_size_cast {P : Type*}
    [Fintype P] [DecidableEq P] (n : P → ℕ) (Δ D : ℤ) {t u : ℕ} (h : t = u) (B : ℕ)
    (source target : Fin t ↪ P)
    (hsource : ∀ i, ¬ (n (source i) : ℤ) ∣ D)
    (htarget : ∀ i, ¬ (n (target i) : ℤ) ∣ D)
    (H : Finset P) (q : BoundedOrderedTuple (UnrestrictedResidueParticle n) B)
    (β : P → ℝ) (ρ V : ℝ)
    (F : Finset P → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    globalBirthEdgeRawRow source target (fun p => (Δ : ZMod (n p))) H q.2
      (globalBirthRawHitIndices (fun p => (Δ : ZMod (n p)))
        (boundedOrderedTupleToFinite q)) β ρ V B F =
    ∑ e : UnrestrictedBoundedEvent n Δ D u B (activeEmbeddingSizeCast h source, q),
      (unrestrictedBoundedEventWeight n Δ D (fun p => β p / V) ρ V u B
        (activeEmbeddingSizeCast h source, q) e : ℂ) *
      globalBirthBoundedEdgePhase n Δ D u B (activeEmbeddingSizeCast h target) H
        (activeEmbeddingSizeCast h source, q) e.1 e.2.1 e.2.2.1 e.2.2.2 *
      F (H ∪ univ.image (unrestrictedBoundedEventTarget n Δ D u B
          (activeEmbeddingSizeCast h source, q) e).1)
        (boundedOrderedTupleToFinite (unrestrictedBoundedEventTarget n Δ D u B
          (activeEmbeddingSizeCast h source, q) e).2) := by
  subst u
  exact global_birth_edge_raw_row_bounded_events n Δ D t B source target hsource htarget H q β ρ V F
end

section
open Finset Classical
theorem finite_indicator_pairing_energy_le {X : Type*} [Fintype X]
    (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (P : X → Prop) (f : X → ℂ) :
    ‖∑ x, (μ x : ℂ) * (if P x then (1 : ℂ) else 0) * f x‖ ^ 2 ≤
      finiteWeightedEnergy μ (fun x => if P x then (1 : ℂ) else 0) *
        finiteWeightedEnergy μ f := by
  let ν := fun x => if P x then μ x else 0
  have hν : ∀ x, 0 ≤ ν x := by
    intro x
    dsimp [ν]
    split_ifs
    · exact hμ x
    · exact le_rfl
  have hc := finite_weighted_sum_cauchy univ ν (fun x _ => hν x) f
  have hleft : (∑ x, (ν x : ℂ) * f x) =
      ∑ x, (μ x : ℂ) * (if P x then (1 : ℂ) else 0) * f x := by
    apply sum_congr rfl
    intro x _
    by_cases hx : P x <;> simp [ν, hx]
  have hmass : (∑ x, ν x) =
      finiteWeightedEnergy μ (fun x => if P x then (1 : ℂ) else 0) := by
    apply sum_congr rfl
    intro x _
    by_cases hx : P x <;> simp [ν, hx]
  have henergy : (∑ x, ν x * ‖f x‖ ^ 2) ≤ finiteWeightedEnergy μ f := by
    apply sum_le_sum
    intro x _
    by_cases hx : P x
    · simp [ν, hx]
    · simpa [ν, hx] using mul_nonneg (hμ x) (sq_nonneg ‖f x‖)
  rw [hleft, hmass] at hc
  exact hc.trans (mul_le_mul_of_nonneg_left henergy (hmass ▸ sum_nonneg (fun x _ => hν x)))

theorem finite_indicator_pairing_le_of_energy {X : Type*} [Fintype X]
    (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (P : X → Prop) (f : X → ℂ)
    {C : ℝ}
    (hf : finiteWeightedEnergy μ f ≤
      C * finiteWeightedEnergy μ (fun x => if P x then (1 : ℂ) else 0)) :
    ‖∑ x, (μ x : ℂ) * (if P x then (1 : ℂ) else 0) * f x‖ ^ 2 ≤
      C * (finiteWeightedEnergy μ (fun x => if P x then (1 : ℂ) else 0)) ^ 2 := by
  have hmass : 0 ≤ finiteWeightedEnergy μ (fun x => if P x then (1 : ℂ) else 0) :=
    sum_nonneg fun x _ => mul_nonneg (hμ x) (sq_nonneg _)
  calc
    _ ≤ finiteWeightedEnergy μ (fun x => if P x then (1 : ℂ) else 0) *
        finiteWeightedEnergy μ f := finite_indicator_pairing_energy_le μ hμ P f
    _ ≤ finiteWeightedEnergy μ (fun x => if P x then (1 : ℂ) else 0) *
        (C * finiteWeightedEnergy μ (fun x => if P x then (1 : ℂ) else 0)) :=
      mul_le_mul_of_nonneg_left hf hmass
    _ = _ := by ring
end

section
open Finset Classical
noncomputable def fullMemoryVacuum {G : Type*} {P Z : G → Type*}
    {M : G → ℕ} {B : ℕ} (x : ProductBoundedOrderedState P Z M B) : ℂ :=
  if ∀ g, (x g).2.1.val = 0 then 1 else 0

theorem fullMemoryVacuum_symmetric {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ} :
    ProductMemorySymmetric (fullMemoryVacuum (P := P) (Z := Z) (M := M) (B := B)) := by
  intro x g τ
  have hlen (i : G) : (productMemoryPermuteAt x g τ i).2.1.val = (x i).2.1.val := by
    by_cases hi : i = g
    · subst i
      simp [productMemoryPermuteAt]
    · simp [productMemoryPermuteAt, hi]
  simp only [fullMemoryVacuum, hlen]

theorem fullMemoryVacuum_norm_sq {G : Type*} [Fintype G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ}
    (x : ProductBoundedOrderedState P Z M B) :
    ‖fullMemoryVacuum x‖ ^ 2 =
      ∏ g, (if (x g).2.1.val = 0 then (1 : ℝ) else 0) := by
  rw [Fintype.prod_ite_zero]
  by_cases h : ∀ g, (x g).2.1.val = 0
  · simp only [fullMemoryVacuum, if_pos h, norm_one, one_pow, prod_const_one]
  · simp only [fullMemoryVacuum, if_neg h, norm_zero]
    norm_num

theorem bounded_empty_memory_mass {Z : Type*} [Fintype Z]
    (ν : Z → ℝ) (B : ℕ) :
    (∑ q : BoundedOrderedTuple Z B,
      boundedOrderedMemoryWeight ν q * (if q.1.val = 0 then 1 else 0)) = 1 := by
  rw [Fintype.sum_sigma, sum_eq_single (0 : Fin (B + 1))]
  · change (∑ y : Fin 0 → Z,
      ((∏ j, ν (y j)) / (Nat.factorial 0 : ℝ)) * (if 0 = 0 then 1 else 0)) = 1
    simp
  · intro N _ hN
    have hval : N.val ≠ 0 := fun h => hN (Fin.ext h)
    simp [hval]
  · simp

theorem bounded_empty_state_mass {P Z : Type*} [Fintype P] [Fintype Z]
    (μ : P → ℝ) (ν : Z → ℝ) (M B : ℕ) :
    (∑ s : BoundedOrderedState P Z M B,
      boundedOrderedStateWeight μ ν s * (if s.2.1.val = 0 then 1 else 0)) =
      (∑ p, μ p) ^ M := by
  rw [Fintype.sum_prod_type]
  simp only [boundedOrderedStateWeight, mul_assoc, ← mul_sum, bounded_empty_memory_mass, mul_one]
  exact (Fintype.sum_pow μ M).symm

theorem fullMemoryVacuum_energy {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ) (M : G → ℕ) (B : ℕ) :
    finiteWeightedEnergy (productMemoryWeight μ ν)
      (fullMemoryVacuum (M := M) (B := B)) =
      ∏ g, (∑ p, μ g p) ^ M g := by
  unfold finiteWeightedEnergy productMemoryWeight
  simp only [fullMemoryVacuum_norm_sq, ← prod_mul_distrib]
  rw [← Fintype.prod_sum (fun g (s : BoundedOrderedState (P g) (Z g) (M g) B) =>
    boundedOrderedStateWeight (μ g) (ν g) s * (if s.2.1.val = 0 then (1 : ℝ) else 0))]
  apply prod_congr rfl
  intro g _
  exact bounded_empty_state_mass (μ g) (ν g) (M g) B

theorem fullMemoryVacuum_active_permutation {G : Type*}
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ}
    (τ : FullActiveSlotPermutations M) (x : ProductBoundedOrderedState P Z M B) :
    fullMemoryVacuum (fullActivePermutation τ x) = fullMemoryVacuum x := rfl

theorem fullActiveAverage_fullMemoryVacuum {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ} :
    fullActiveAverage (fullMemoryVacuum (P := P) (Z := Z) (M := M) (B := B)) =
      fullMemoryVacuum :=
  fullActiveAverage_eq_self _ fullMemoryVacuum_active_permutation

theorem productMemoryCutoff_fullMemoryVacuum {G : Type*} [Fintype G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ} :
    productMemoryCutoff (fullMemoryVacuum (P := P) (Z := Z) (M := M) (B := B)) =
      fullMemoryVacuum := by
  funext x
  by_cases h : ∀ g, (x g).2.1.val = 0
  · have htotal : productTotalMemory x = 0 := by simp [productTotalMemory, h]
    simp [productMemoryCutoff, htotal]
  · simp only [productMemoryCutoff, fullMemoryVacuum, if_neg h]
    split_ifs <;> rfl
end

section
open Filter
theorem prime_kernel_log_factor_le (Q : ℕ) (a : ℝ) (hQ : 0 < Q)
    (ha : 1 ≤ Real.log a) :
    1 + Real.log ((Q * Q : ℕ) : ℝ) / Real.log a ≤ 2 * (Q : ℝ) ^ 2 := by
  have hQone : (1 : ℝ) ≤ Q := by exact_mod_cast hQ
  have hQsq : (1 : ℝ) ≤ (Q : ℝ) ^ 2 := by nlinarith
  have hQcast : ((Q * Q : ℕ) : ℝ) = (Q : ℝ) ^ 2 := by push_cast; ring
  rw [hQcast]
  have hlog0 : 0 ≤ Real.log ((Q : ℝ) ^ 2) := Real.log_nonneg hQsq
  have hlog : Real.log ((Q : ℝ) ^ 2) ≤ (Q : ℝ) ^ 2 := Real.log_le_self (by positivity)
  have hdiv : Real.log ((Q : ℝ) ^ 2) / Real.log a ≤ Real.log ((Q : ℝ) ^ 2) := by
    apply (div_le_iff₀ (by linarith : 0 < Real.log a)).mpr
    exact le_mul_of_one_le_right hlog0 ha
  linarith

/-- The logarithmic factor is bounded crudely by another `Q²`, leaving a
uniform exponential-times-power majorant. The exponent bounds may be any reals. -/
theorem prime_kernel_reproduction_error_majorant (c C q v x L : ℝ)
    (hc : 0 < c) (hC : 0 < C) (hL : 1 < L) (Q : ℕ) (V ξ a : ℝ)
    (hQ : 0 < Q) (hQbound : (Q : ℝ) ≤ L ^ q)
    (hV : L ^ (-v) ≤ V) (hξ : L ^ (-x) ≤ ξ) (ha : Real.exp (L ^ c) ≤ a) :
    ((Q * Q : ℕ) : ℝ) *
        (((C / V) * a ^ (-(1 : ℝ) / 32) *
          (1 + Real.log ((Q * Q : ℕ) : ℝ) / Real.log a)) / ξ) ≤
      (2 * C) * Real.exp (-(1 / 32 : ℝ) * L ^ c) * L ^ (4 * q + v + x) := by
  have hL0 : 0 < L := by linarith
  have hV0 : 0 < V := (Real.rpow_pos_of_pos hL0 (-v)).trans_le hV
  have hξ0 : 0 < ξ := (Real.rpow_pos_of_pos hL0 (-x)).trans_le hξ
  have ha0 : 0 < a := (Real.exp_pos _).trans_le ha
  have halog : 1 ≤ Real.log a := by
    have hh := Real.log_le_log (Real.exp_pos (L ^ c)) ha
    rw [Real.log_exp] at hh
    exact (Real.one_le_rpow hL.le hc.le).trans hh
  have hVinv : 1 / V ≤ L ^ v := by
    calc
      _ ≤ 1 / L ^ (-v) := one_div_le_one_div_of_le (Real.rpow_pos_of_pos hL0 (-v)) hV
      _ = _ := by rw [Real.rpow_neg hL0.le]; simp
  have hξinv : 1 / ξ ≤ L ^ x := by
    calc
      _ ≤ 1 / L ^ (-x) := one_div_le_one_div_of_le (Real.rpow_pos_of_pos hL0 (-x)) hξ
      _ = _ := by rw [Real.rpow_neg hL0.le]; simp
  have hadecay : a ^ (-(1 : ℝ) / 32) ≤ Real.exp (-(1 / 32 : ℝ) * L ^ c) := by
    calc
      _ ≤ (Real.exp (L ^ c)) ^ (-(1 : ℝ) / 32) :=
        Real.rpow_le_rpow_of_nonpos (Real.exp_pos _) ha (by norm_num)
      _ = _ := by rw [← Real.exp_mul]; congr 1; ring
  have hQsq : (Q : ℝ) ^ 2 ≤ (L ^ q) ^ 2 :=
    pow_le_pow_left₀ (Nat.cast_nonneg Q) hQbound 2
  have hlogbound : 1 + Real.log ((Q * Q : ℕ) : ℝ) / Real.log a ≤ 2 * (L ^ q) ^ 2 :=
    (prime_kernel_log_factor_le Q a hQ halog).trans (by linarith)
  have hlog0 : 0 ≤ 1 + Real.log ((Q * Q : ℕ) : ℝ) / Real.log a := by
    have hQQ : (1 : ℝ) ≤ ((Q * Q : ℕ) : ℝ) := by
      exact_mod_cast (show 1 ≤ Q * Q by nlinarith)
    have hh := Real.log_nonneg hQQ
    positivity
  calc
    _ = (Q : ℝ) ^ 2 * C * (1 / V) * a ^ (-(1 : ℝ) / 32) *
        (1 + Real.log ((Q * Q : ℕ) : ℝ) / Real.log a) * (1 / ξ) := by
      push_cast
      ring
    _ ≤ (L ^ q) ^ 2 * C * L ^ v * Real.exp (-(1 / 32 : ℝ) * L ^ c) *
        (2 * (L ^ q) ^ 2) * L ^ x := by
      gcongr
    _ = _ := by
      rw [show 4 * q + v + x = q + q + v + q + q + x by ring]
      simp only [Real.rpow_add hL0]
      ring

/-- One threshold in `L` works for every allowed modulus bound, mass,
cell width, and prime-band starting point. -/
theorem eventually_prime_kernel_reproduction_error_small (c C q v x D : ℝ)
    (hc : 0 < c) (hC : 0 < C) :
    ∀ᶠ L : ℝ in atTop, ∀ (Q : ℕ) (V ξ a : ℝ), 0 < Q →
      (Q : ℝ) ≤ L ^ q → L ^ (-v) ≤ V → L ^ (-x) ≤ ξ → Real.exp (L ^ c) ≤ a →
      ((Q * Q : ℕ) : ℝ) *
        (((C / V) * a ^ (-(1 : ℝ) / 32) *
          (1 + Real.log ((Q * Q : ℕ) : ℝ) / Real.log a)) / ξ) ≤ L ^ (-D) := by
  filter_upwards [eventually_exp_neg_rpow_mul_rpow_le hc (by norm_num : (0 : ℝ) < 1 / 32)
      (4 * q + v + x + 1) D,
    eventually_gt_atTop (1 : ℝ), eventually_ge_atTop (2 * C)] with L hdecay hL hCL
  intro Q V ξ a hQ hQbound hV hξ ha
  have hL0 : 0 < L := by linarith
  calc
    _ ≤ (2 * C) * Real.exp (-(1 / 32 : ℝ) * L ^ c) * L ^ (4 * q + v + x) :=
      prime_kernel_reproduction_error_majorant c C q v x L hc hC hL Q V ξ a
        hQ hQbound hV hξ ha
    _ ≤ L * Real.exp (-(1 / 32 : ℝ) * L ^ c) * L ^ (4 * q + v + x) := by
      gcongr
    _ = Real.exp (-(1 / 32 : ℝ) * L ^ c) * L ^ (4 * q + v + x + 1) := by
      rw [Real.rpow_add hL0 (4 * q + v + x) 1, Real.rpow_one]
      ring
    _ ≤ L ^ (-D) := hdecay
end

section
open scoped BigOperators Classical
theorem finite_subtype_sum_eq_of_zero_off {X M : Type*} [Fintype X] [AddCommMonoid M]
    (S : X → Prop) [DecidablePred S] (F : X → M) (hF : ∀ x, ¬ S x → F x = 0) :
    (∑ x : {x // S x}, F x.val) = ∑ x, F x := by
  exact (Finset.sum_congr_set {x | S x} F (fun x => F x.val) (fun _ _ => rfl) hF).symm

theorem finite_subtype_sum_le_of_nonneg {X : Type*} [Fintype X]
    (S : X → Prop) [DecidablePred S] (w : X → ℝ) (hw : ∀ x, 0 ≤ w x) :
    (∑ x : {x // S x}, w x.val) ≤ ∑ x, w x := by
  rw [← Finset.sum_subtype (Finset.univ.filter S) (by simp)]
  exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
    (fun x _ _ => hw x)

theorem finite_subtype_fiber_mass_le {X : Type*} [Fintype X]
    (S : X → Prop) [DecidablePred S] (π : X → ℕ) (μ : X → ℝ)
    (hμ : ∀ x, 0 ≤ μ x) (m : ℕ) :
    (∑ x ∈ Finset.univ.filter (fun x : {x // S x} => π x.val = m), μ x.val) ≤
      ∑ x ∈ Finset.univ.filter (fun x => π x = m), μ x := by
  simp only [Finset.sum_filter]
  exact finite_subtype_sum_le_of_nonneg S (fun x => if π x = m then μ x else 0)
    (fun x => by split_ifs; exact hμ x; exact le_rfl)

theorem finite_test_support_energy {X : Type*} [Fintype X]
    (μ : X → ℝ) (f : X → ℂ) :
    (∑ x : {x // f x ≠ 0}, μ x.val * ‖f x.val‖ ^ 2) =
      ∑ x, μ x * ‖f x‖ ^ 2 := by
  apply finite_subtype_sum_eq_of_zero_off (fun x => f x ≠ 0) (fun x => μ x * ‖f x‖ ^ 2)
  intro x hx
  have hf : f x = 0 := not_not.mp hx
  simp [hf]

theorem finite_test_support_bilinear {X Y : Type*} [Fintype X] [Fintype Y]
    (μ : X → ℝ) (ν : Y → ℝ) (f : X → ℂ) (g : Y → ℂ) (K : X → Y → ℂ) :
    (∑ x : {x // f x ≠ 0}, ∑ y : {y // g y ≠ 0},
      ((μ x.val : ℂ) * f x.val) * ((ν y.val : ℂ) * g y.val) * K x.val y.val) =
      ∑ x, ∑ y, ((μ x : ℂ) * f x) * ((ν y : ℂ) * g y) * K x y := by
  calc
    _ = ∑ x : {x // f x ≠ 0}, ∑ y,
        ((μ x.val : ℂ) * f x.val) * ((ν y : ℂ) * g y) * K x.val y := by
      apply Finset.sum_congr rfl
      intro x _
      apply finite_subtype_sum_eq_of_zero_off (fun y => g y ≠ 0)
        (fun y => ((μ x.val : ℂ) * f x.val) * ((ν y : ℂ) * g y) * K x.val y)
      intro y hy
      have hg : g y = 0 := not_not.mp hy
      simp [hg]
    _ = _ := by
      apply finite_subtype_sum_eq_of_zero_off (fun x => f x ≠ 0)
        (fun x => ∑ y, ((μ x : ℂ) * f x) * ((ν y : ℂ) * g y) * K x y)
      intro x hx
      have hf : f x = 0 := not_not.mp hx
      simp [hf]
end

section

theorem positive_log_distance_le_factor_two {p q : ℝ} (hp : 0 < p) (hq : 0 < q)
    (hlog : |Real.log p - Real.log q| ≤ Real.log 2) :
    q / 2 ≤ p ∧ p ≤ 2 * q := by
  have hh := abs_le.mp hlog
  have hq2 : 0 < 2 * q := mul_pos (by norm_num) hq
  have hp2 : 0 < 2 * p := mul_pos (by norm_num) hp
  have hupper : Real.log p ≤ Real.log (2 * q) := by
    rw [Real.log_mul (by norm_num : (2 : ℝ) ≠ 0) hq.ne']
    linarith
  have hlower : Real.log q ≤ Real.log (2 * p) := by
    rw [Real.log_mul (by norm_num : (2 : ℝ) ≠ 0) hp.ne']
    linarith
  have hu := (Real.log_le_log_iff hp hq2).mp hupper
  have hl := (Real.log_le_log_iff hq hp2).mp hlower
  constructor <;> linarith

theorem positive_log_distance_lt_factor_two {p q h : ℝ} (hp : 0 < p) (hq : 0 < q)
    (hlog : |Real.log p - Real.log q| < h) (hh : h ≤ Real.log 2) :
    q / 2 < p ∧ p < 2 * q := by
  have habs := abs_lt.mp (hlog.trans_le hh)
  have hq2 : 0 < 2 * q := mul_pos (by norm_num) hq
  have hp2 : 0 < 2 * p := mul_pos (by norm_num) hp
  have hupper : Real.log p < Real.log (2 * q) := by
    rw [Real.log_mul (by norm_num : (2 : ℝ) ≠ 0) hq.ne']
    linarith
  have hlower : Real.log q < Real.log (2 * p) := by
    rw [Real.log_mul (by norm_num : (2 : ℝ) ≠ 0) hp.ne']
    linarith
  have hu := (Real.log_lt_log_iff hp hq2).mp hupper
  have hl := (Real.log_lt_log_iff hq hp2).mp hlower
  constructor <;> linarith
end

section
open Finset
open scoped Classical
theorem finite_coordinate_component_append {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (A : Finset I) (is js : List I) (f : (∀ i, X i) → ℂ) :
    finiteCoordinateComponent μ A (is ++ js) f =
      finiteCoordinateComponent μ A is (finiteCoordinateComponent μ A js f) := by
  induction is with
  | nil => rfl
  | cons i is ih => simp only [List.cons_append, finiteCoordinateComponent, ih]

/-- Probing all slots in A after averaging disjoint tail slots B is exactly the
single component used by the quantitative probe bound. -/
theorem finite_probe_after_tail_component {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (A B : Finset I) (hAB : Disjoint A B) (f : (∀ i, X i) → ℂ) :
    finiteCoordinateComponent μ A A.toList (finiteCoordinateComponent μ ∅ B.toList f) =
      finiteCoordinateComponent μ A (A ∪ B).toList f := by
  have hinner : finiteCoordinateComponent μ A B.toList f =
      finiteCoordinateComponent μ ∅ B.toList f := by
    apply finite_coordinate_component_congr
    intro i hi
    have hiB : i ∈ B := mem_toList.mp hi
    have hiA : i ∉ A := fun hiA => disjoint_left.mp hAB hiA hiB
    simp [hiA]
  rw [← hinner, ← finite_coordinate_component_append]
  apply finite_coordinate_component_perm
  have hdis : List.Disjoint A.toList B.toList := by
    intro i hiA hiB
    exact disjoint_left.mp hAB (mem_toList.mp hiA) (mem_toList.mp hiB)
  have hn : (A.toList ++ B.toList).Nodup := A.nodup_toList.append B.nodup_toList hdis
  apply List.perm_of_nodup_nodup_toFinset_eq hn (A ∪ B).nodup_toList
  simp

theorem finite_symmetric_probe_tensor_tail_energy {G : Type*} [Fintype G] [DecidableEq G]
    {I X : G → Type*} [∀ g, Fintype (I g)] [∀ g, DecidableEq (I g)] [∀ g, Fintype (X g)]
    (μ : ∀ g, X g → ℝ) (hμ : ∀ g x, 0 ≤ μ g x) (hmass : ∀ g, ∑ x, μ g x = 1)
    (A B : ∀ g, Finset (I g)) (hAB : ∀ g, Disjoint (A g) (B g))
    (m ell : ℕ) (hm : 0 < m) (hA : ∀ g, (A g).card = m) (hB : ∀ g, (B g).card = ell)
    (s t : Finset G) (f : (∀ g, I g → X g) → ℂ) (hf : ∀ g, finiteGroupSlotSymmetric g f) :
    finiteWeightedEnergy (finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g)))
      (finiteCoordinateFinsetAction (fun g v => finiteCoordinateComponent (fun _ : I g => μ g)
        ∅ (B g).toList v) t
        (finiteCoordinateFinsetAction (fun g v => finiteCoordinateComponent (fun _ : I g => μ g)
          (A g) (A g ∪ B g).toList v) s f)) ≤
      (((ell : ℝ) ^ ell / (m : ℝ) ^ ell) ^ s.card) *
        finiteWeightedEnergy (finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g))) f := by
  exact (finite_tensor_averaging_energy_le μ hμ hmass B t _).trans
    (finite_symmetric_probe_tensor_uniform μ hμ hmass A B hAB m ell hm hA hB s f hf)

theorem finite_symmetric_probe_tensor_tail_norm {G : Type*} [Fintype G] [DecidableEq G]
    {I X : G → Type*} [∀ g, Fintype (I g)] [∀ g, DecidableEq (I g)] [∀ g, Fintype (X g)]
    (μ : ∀ g, X g → ℝ) (hμ : ∀ g x, 0 ≤ μ g x) (hmass : ∀ g, ∑ x, μ g x = 1)
    (A B : ∀ g, Finset (I g)) (hAB : ∀ g, Disjoint (A g) (B g))
    (m ell : ℕ) (hm : 0 < m) (hA : ∀ g, (A g).card = m) (hB : ∀ g, (B g).card = ell)
    (s t : Finset G) (f : (∀ g, I g → X g) → ℂ) (hf : ∀ g, finiteGroupSlotSymmetric g f) :
    Real.sqrt (finiteWeightedEnergy (finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g)))
      (finiteCoordinateFinsetAction (fun g v => finiteCoordinateComponent (fun _ : I g => μ g)
        ∅ (B g).toList v) t
        (finiteCoordinateFinsetAction (fun g v => finiteCoordinateComponent (fun _ : I g => μ g)
          (A g) (A g ∪ B g).toList v) s f))) ≤
      Real.sqrt (((ell : ℝ) ^ ell / (m : ℝ) ^ ell) ^ s.card) *
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g))) f) := by
  have h := Real.sqrt_le_sqrt
    (finite_symmetric_probe_tensor_tail_energy μ hμ hmass A B hAB m ell hm hA hB s t f hf)
  rw [Real.sqrt_mul (by positivity)] at h
  exact h
end

section
open Finset
theorem dvd_twice_add_one_iff_zmod (d u : ℕ) :
    d ∣ 2 * u + 1 ↔ (-2 : ZMod d) * (u : ZMod d) = 1 := by
  rw [← ZMod.natCast_eq_zero_iff]
  push_cast
  constructor <;> intro h <;> linear_combination -h

noncomputable def typeICharacterSum {Ω : Type*} (T : Finset Ω)
    (μ : Ω → ℂ) (value : Ω → ℕ) {d : ℕ} (χ : DirichletCharacter ℂ d) : ℂ :=
  ∑ t ∈ T, μ t * χ (value t : ZMod d)

noncomputable def typeINonprincipalRemainder {Ω : Type*} (d : ℕ) (T : Finset Ω)
    (μ : Ω → ℂ) (value : Ω → ℕ) : ℂ := by
  classical
  exact ∑ χ ∈ (univ : Finset (DirichletCharacter ℂ d)).erase 1,
    χ (-2 : ZMod d) * typeICharacterSum T μ value χ

noncomputable def typeINonprincipalNormSum {Ω : Type*} (d : ℕ) (T : Finset Ω)
    (μ : Ω → ℂ) (value : Ω → ℕ) : ℝ := by
  classical
  exact ∑ χ ∈ (univ : Finset (DirichletCharacter ℂ d)).erase 1,
    ‖typeICharacterSum T μ value χ‖

theorem typeI_character_expansion {Ω : Type*} (d : ℕ) [NeZero d]
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) :
    (d.totient : ℂ) * (∑ t ∈ T.filter (fun t => d ∣ 2 * value t + 1), μ t) =
      ∑ χ : DirichletCharacter ℂ d,
        χ (-2 : ZMod d) * typeICharacterSum T μ value χ := by
  classical
  symm
  calc
    _ = ∑ t ∈ T, μ t * ∑ χ : DirichletCharacter ℂ d,
        χ ((-2 : ZMod d) * (value t : ZMod d)) := by
      simp only [typeICharacterSum, mul_sum, map_mul]
      rw [sum_comm]
      apply sum_congr rfl
      intro t _
      apply sum_congr rfl
      intro χ _
      ring
    _ = ∑ t ∈ T, μ t * (if d ∣ 2 * value t + 1 then (d.totient : ℂ) else 0) := by
      apply sum_congr rfl
      intro t _
      rw [DirichletCharacter.sum_characters_eq]
      simp only [← dvd_twice_add_one_iff_zmod]
    _ = _ := by rw [sum_filter, mul_sum]; apply sum_congr rfl; intro t _; split_ifs <;> ring

theorem typeI_principal_character_sum {Ω : Type*} (d : ℕ)
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) :
    typeICharacterSum T μ value (1 : DirichletCharacter ℂ d) =
      ∑ t ∈ T.filter (fun t => (value t).Coprime d), μ t := by
  classical
  rw [typeICharacterSum, sum_filter]
  apply sum_congr rfl
  intro t _
  by_cases hcop : (value t).Coprime d
  · rw [if_pos hcop, MulChar.one_apply ((ZMod.isUnit_iff_coprime _ _).mpr hcop), mul_one]
  · rw [if_neg hcop, MulChar.map_nonunit _ (by simpa only [ZMod.isUnit_iff_coprime] using hcop), mul_zero]

theorem typeI_principal_factor (d : ℕ) (hd : Odd d) :
    (1 : DirichletCharacter ℂ d) (-2 : ZMod d) = 1 := by
  apply MulChar.one_apply
  exact (show IsUnit (2 : ZMod d) from
    (ZMod.isUnit_iff_coprime 2 d).mpr hd.coprime_two_left).neg

theorem typeI_character_decomposition {Ω : Type*} (d : ℕ) [NeZero d] (hd : Odd d)
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) :
    (d.totient : ℂ) * (∑ t ∈ T.filter (fun t => d ∣ 2 * value t + 1), μ t) =
      (∑ t ∈ T.filter (fun t => (value t).Coprime d), μ t) +
        typeINonprincipalRemainder d T μ value := by
  classical
  have hsum := sum_erase_add univ
    (fun χ : DirichletCharacter ℂ d => χ (-2 : ZMod d) * typeICharacterSum T μ value χ)
    (mem_univ (1 : DirichletCharacter ℂ d))
  have hrem : (∑ χ ∈ (univ : Finset (DirichletCharacter ℂ d)).erase 1,
      χ (-2 : ZMod d) * typeICharacterSum T μ value χ) =
      typeINonprincipalRemainder d T μ value := by
    unfold typeINonprincipalRemainder
    apply sum_congr
    · ext χ
      simp only [mem_erase, mem_univ, and_true]
    · intro χ _
      rfl
  rw [typeI_character_expansion, ← hsum,
    typeI_principal_factor d hd, one_mul, typeI_principal_character_sum, hrem]
  exact add_comm (typeINonprincipalRemainder d T μ value)
    (∑ t ∈ T.filter (fun t => (value t).Coprime d), μ t)

theorem typeI_nonprincipal_remainder_norm_le {Ω : Type*} (d : ℕ)
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) :
    ‖typeINonprincipalRemainder d T μ value‖ ≤ typeINonprincipalNormSum d T μ value := by
  classical
  apply (norm_sum_le _ _).trans
  apply sum_le_sum
  intro χ _
  rw [norm_mul]
  exact mul_le_of_le_one_left (norm_nonneg _) (χ.norm_le_one _)

theorem typeI_deviation_le {Ω : Type*} (d : ℕ) [NeZero d] (hd : Odd d)
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) :
    ‖(∑ t ∈ T.filter (fun t => d ∣ 2 * value t + 1), μ t) -
        (∑ t ∈ T.filter (fun t => (value t).Coprime d), μ t) / (d.totient : ℂ)‖ ≤
      typeINonprincipalNormSum d T μ value / (d.totient : ℝ) := by
  have hφ : (d.totient : ℂ) ≠ 0 := by
    exact_mod_cast (Nat.totient_pos.mpr (Nat.pos_of_ne_zero (NeZero.ne d))).ne'
  have heq : (∑ t ∈ T.filter (fun t => d ∣ 2 * value t + 1), μ t) -
      (∑ t ∈ T.filter (fun t => (value t).Coprime d), μ t) / (d.totient : ℂ) =
        typeINonprincipalRemainder d T μ value / (d.totient : ℂ) := by
    apply (eq_div_iff hφ).mpr
    have h := typeI_character_decomposition d hd T μ value
    field_simp
    linear_combination h
  rw [heq, norm_div, Complex.norm_natCast]
  exact div_le_div_of_nonneg_right (typeI_nonprincipal_remainder_norm_le d T μ value)
    (Nat.cast_nonneg _)

theorem typeI_real_deviation_le {Ω : Type*} (d : ℕ) [NeZero d] (hd : Odd d)
    (T : Finset Ω) (μ : Ω → ℝ) (value : Ω → ℕ) :
    |(∑ t ∈ T.filter (fun t => d ∣ 2 * value t + 1), μ t) -
        (∑ t ∈ T.filter (fun t => (value t).Coprime d), μ t) / (d.totient : ℝ)| ≤
      typeINonprincipalNormSum d T (fun t => (μ t : ℂ)) value / (d.totient : ℝ) := by
  have h := typeI_deviation_le d hd T (fun t => (μ t : ℂ)) value
  have hcast :
      (((∑ t ∈ T.filter (fun t => d ∣ 2 * value t + 1), μ t) -
        (∑ t ∈ T.filter (fun t => (value t).Coprime d), μ t) / (d.totient : ℝ) : ℝ) : ℂ) =
      (∑ t ∈ T.filter (fun t => d ∣ 2 * value t + 1), (μ t : ℂ)) -
        (∑ t ∈ T.filter (fun t => (value t).Coprime d), (μ t : ℂ)) / (d.totient : ℂ) := by
    push_cast
    rfl
  rw [← hcast] at h
  simpa only [Complex.norm_real, Real.norm_eq_abs] using h
end

section
open Finset
theorem nonprincipal_conductor_one_lt {d : ℕ} [NeZero d]
    (χ : DirichletCharacter ℂ d) (hχ : χ ≠ 1) : 1 < χ.conductor := by
  have h0 := χ.conductor_ne_zero
  have h1 : χ.conductor ≠ 1 := fun h => hχ (χ.eq_one_iff_conductor_eq_one.mpr h)
  omega

theorem nonprincipal_primitiveCharacter_ne_one {d : ℕ}
    (χ : DirichletCharacter ℂ d) (hχ : χ ≠ 1) : χ.primitiveCharacter ≠ 1 := by
  intro h
  apply hχ
  rw [← χ.changeLevel_primitiveCharacter, h, map_one]

theorem character_conductor_mul_complement {d : ℕ} (χ : DirichletCharacter ℂ d) :
    χ.conductor * (d / χ.conductor) = d :=
  Nat.mul_div_cancel' χ.conductor_dvd_level

theorem character_conductor_complement_pos {d : ℕ} [NeZero d]
    (χ : DirichletCharacter ℂ d) : 0 < d / χ.conductor := by
  apply Nat.pos_of_ne_zero
  intro h
  have hh := character_conductor_mul_complement χ
  rw [h, mul_zero] at hh
  exact NeZero.ne d hh.symm

theorem squarefree_conductor_coprime_complement {d : ℕ} (hd : Squarefree d)
    (χ : DirichletCharacter ℂ d) : χ.conductor.Coprime (d / χ.conductor) := by
  apply Nat.coprime_of_squarefree_mul
  rwa [character_conductor_mul_complement]

theorem character_apply_eq_primitive_mul_coprime {d : ℕ}
    (χ : DirichletCharacter ℂ d) (n : ℕ) :
    χ (n : ZMod d) = χ.primitiveCharacter (n : ZMod χ.conductor) *
      (if n.Coprime (d / χ.conductor) then (1 : ℂ) else 0) := by
  by_cases hnd : n.Coprime d
  · have hnh := hnd.of_dvd_right (Nat.div_dvd_of_dvd χ.conductor_dvd_level)
    rw [if_pos hnh, mul_one]
    have h := χ.primitiveCharacter_apply_of_isCoprime
      (Nat.isCoprime_iff_coprime.mpr hnd)
    simpa only [Int.cast_natCast] using h.symm
  · have hzero : χ (n : ZMod d) = 0 := by
      have h := (χ.apply_eq_zero_iff (n : ℤ)).mpr
        (by simpa only [Nat.isCoprime_iff_coprime] using hnd)
      simpa only [Int.cast_natCast] using h
    rw [hzero]
    by_cases hnh : n.Coprime (d / χ.conductor)
    · have hnf : ¬ n.Coprime χ.conductor := by
        intro hnf
        apply hnd
        have h := hnf.mul_right hnh
        rwa [character_conductor_mul_complement] at h
      have hz : χ.primitiveCharacter (n : ZMod χ.conductor) = 0 := by
        have h := (χ.primitiveCharacter.apply_eq_zero_iff (n : ℤ)).mpr
          (by simpa only [Nat.isCoprime_iff_coprime] using hnf)
        simpa only [Int.cast_natCast] using h
      rw [hz, zero_mul]
    · rw [if_neg hnh, mul_zero]

theorem character_weighted_sum_eq_primitive_filtered {Ω : Type*} {d : ℕ}
    (χ : DirichletCharacter ℂ d) (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) :
    (∑ t ∈ T, μ t * χ (value t : ZMod d)) =
      ∑ t ∈ T.filter (fun t => (value t).Coprime (d / χ.conductor)),
        μ t * χ.primitiveCharacter (value t : ZMod χ.conductor) := by
  rw [sum_filter]
  apply sum_congr rfl
  intro t _
  rw [character_apply_eq_primitive_mul_coprime]
  split_ifs <;> simp

theorem squarefree_nonprincipal_conductor_data {d : ℕ} [NeZero d]
    (hd : Squarefree d) (χ : DirichletCharacter ℂ d) (hχ : χ ≠ 1) :
    1 < χ.conductor ∧ 0 < d / χ.conductor ∧
      χ.conductor * (d / χ.conductor) = d ∧
      χ.conductor.Coprime (d / χ.conductor) ∧
      Squarefree χ.conductor ∧ Squarefree (d / χ.conductor) ∧
      χ.primitiveCharacter.IsPrimitive ∧ χ.primitiveCharacter ≠ 1 := by
  exact ⟨nonprincipal_conductor_one_lt χ hχ, character_conductor_complement_pos χ,
    character_conductor_mul_complement χ, squarefree_conductor_coprime_complement hd χ,
    hd.squarefree_of_dvd χ.conductor_dvd_level,
    hd.squarefree_of_dvd (Nat.div_dvd_of_dvd χ.conductor_dvd_level),
    χ.primitiveCharacter_isPrimitive, nonprincipal_primitiveCharacter_ne_one χ hχ⟩
end

section
open Finset
theorem finite_euler_correction_product_lower (S : Finset ℕ)
    (hS : ∀ n ∈ S, 2 ≤ n) :
    (1 / 2 : ℝ) ≤ ∏ n ∈ S, (1 - 1 / (n : ℝ)^2) := by
  have hnonneg : 0 ≤ ∏ n ∈ S, (1 - 1 / (n : ℝ)^2) := by
    apply prod_nonneg
    intro n hn
    have hn2 : (2 : ℝ) ≤ n := by exact_mod_cast hS n hn
    apply sub_nonneg.mpr
    apply (div_le_one (by nlinarith : (0 : ℝ) < (n : ℝ)^2)).mpr
    nlinarith
  have hid : (∏ n ∈ S, (1 - 1 / (n : ℝ)^2)) *
      (∏ n ∈ S, (1 + 1 / ((n : ℝ)^2 - 1))) = 1 := by
    rw [← prod_mul_distrib]
    apply prod_eq_one
    intro n hn
    have hn2 : (2 : ℝ) ≤ n := by exact_mod_cast hS n hn
    have h0 : (n : ℝ)^2 ≠ 0 := by nlinarith
    have h1 : (n : ℝ)^2 - 1 ≠ 0 := by nlinarith
    field_simp
    ring
  have hmul := mul_le_mul_of_nonneg_left (euler_correction_product_le_two S hS) hnonneg
  rw [hid] at hmul
  linarith

theorem finite_prime_avoidance_product_pos (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) : 0 < ∏ p ∈ P, (1 - 1 / (p : ℝ)) := by
  apply prod_pos
  intro p hp
  have hp1 : (1 : ℝ) < p := by exact_mod_cast (hP p hp).one_lt
  apply sub_pos.mpr
  exact (div_lt_one (by linarith)).mpr hp1

theorem finite_prime_avoidance_product_lower (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) {z : ℝ} (hz : 1 ≤ z)
    (hbound : ∀ p ∈ P, (p : ℝ) ≤ z) :
    1 / ((2 * primeEulerProductUpperConstant) * Real.log (2 * z)) ≤
      ∏ p ∈ P, (1 - 1 / (p : ℝ)) := by
  have hpos := finite_prime_avoidance_product_pos P hP
  have hden : 0 < (2 * primeEulerProductUpperConstant) * Real.log (2 * z) := by
    apply mul_pos (mul_pos (by norm_num) primeEulerProductUpperConstant_pos)
    exact Real.log_pos (by linarith)
  have hid : (∏ p ∈ P, (1 - 1 / (p : ℝ))) *
      (∏ p ∈ P, (1 + 1 / ((p : ℝ) - 1))) = 1 := by
    rw [← prod_mul_distrib]
    apply prod_eq_one
    intro p hp
    have hp1 : (1 : ℝ) < p := by exact_mod_cast (hP p hp).one_lt
    have h0 : (p : ℝ) ≠ 0 := by linarith
    have h1 : (p : ℝ) - 1 ≠ 0 := by linarith
    field_simp
    ring
  have hm := mul_le_mul_of_nonneg_left
    (finite_inverse_prime_euler_product_le_log P hP hz hbound) hpos.le
  rw [hid] at hm
  exact (div_le_iff₀ hden).mpr hm

theorem finite_odd_prime_correction_product_lower (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) (hodd : ∀ p ∈ P, p ≠ 2) :
    (1 / 2 : ℝ) ≤ ∏ p ∈ P, (1 - 1 / ((p : ℝ) - 1)^2) := by
  have hp3 : ∀ p ∈ P, 3 ≤ p := by
    intro p hp
    have := (hP p hp).two_le
    have := hodd p hp
    omega
  have hpred : ∀ n ∈ P.image (fun p : ℕ => (p - 1 : ℕ)), 2 ≤ n := by
    intro n hn
    obtain ⟨p, hp, rfl⟩ := mem_image.mp hn
    have := hp3 p hp
    omega
  have hinj : Set.InjOn (fun p : ℕ => (p - 1 : ℕ)) P := by
    intro p hp q hq heq
    change p - 1 = q - 1 at heq
    have := hp3 p hp
    have := hp3 q hq
    omega
  have heq : (∏ n ∈ P.image (fun p : ℕ => (p - 1 : ℕ)), (1 - 1 / (n : ℝ)^2)) =
      ∏ p ∈ P, (1 - 1 / ((p : ℝ) - 1)^2) := by
    rw [prod_image hinj]
    apply prod_congr rfl
    intro p hp
    rw [Nat.cast_sub (hP p hp).one_le, Nat.cast_one]
  rw [← heq]
  exact finite_euler_correction_product_lower _ hpred

theorem finite_odd_prime_predecessor_avoidance_product_lower (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) (hodd : ∀ p ∈ P, p ≠ 2)
    {z : ℝ} (hz : 1 ≤ z) (hbound : ∀ p ∈ P, (p : ℝ) ≤ z) :
    1 / ((4 * primeEulerProductUpperConstant) * Real.log (2 * z)) ≤
      ∏ p ∈ P, (1 - 1 / ((p : ℝ) - 1)) := by
  have hfactor : (∏ p ∈ P, (1 - 1 / ((p : ℝ) - 1))) =
      (∏ p ∈ P, (1 - 1 / (p : ℝ))) *
        (∏ p ∈ P, (1 - 1 / ((p : ℝ) - 1)^2)) := by
    rw [← prod_mul_distrib]
    apply prod_congr rfl
    intro p hp
    have hp1 : (1 : ℝ) < p := by exact_mod_cast (hP p hp).one_lt
    have h0 : (p : ℝ) ≠ 0 := by linarith
    have h1 : (p : ℝ) - 1 ≠ 0 := by linarith
    field_simp
    ring
  have hlog : 0 < Real.log (2 * z) := Real.log_pos (by linarith)
  calc
    _ = (1 / ((2 * primeEulerProductUpperConstant) * Real.log (2 * z))) * (1/2) := by ring
    _ ≤ (∏ p ∈ P, (1 - 1 / (p : ℝ))) *
        (∏ p ∈ P, (1 - 1 / ((p : ℝ) - 1)^2)) :=
      mul_le_mul (finite_prime_avoidance_product_lower P hP hz hbound)
        (finite_odd_prime_correction_product_lower P hP hodd) (by norm_num)
        (finite_prime_avoidance_product_pos P hP).le
    _ = _ := hfactor.symm

theorem finite_odd_prime_predecessor_avoidance_product_pos (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) (hodd : ∀ p ∈ P, p ≠ 2) :
    0 < ∏ p ∈ P, (1 - 1 / ((p : ℝ) - 1)) := by
  apply prod_pos
  intro p hp
  have hp3 : 3 ≤ p := by
    have := (hP p hp).two_le
    have := hodd p hp
    omega
  have hp3R : (3 : ℝ) ≤ p := by exact_mod_cast hp3
  apply sub_pos.mpr
  exact (div_lt_one (by linarith)).mpr (by linarith)
end

section
open Finset
noncomputable def shiftedTotientSieveRemainder (T : Finset ℕ) (μ : ℕ → ℝ) (d : ℕ) : ℝ :=
  (∑ u ∈ T.filter (fun u => d ∣ 2*u + 1), μ u) -
    (∑ u ∈ T, μ u) / (Nat.totient d : ℝ)

theorem shifted_totient_intersection_moment (T S : Finset ℕ) (μ : ℕ → ℝ)
    (hS : ∀ p ∈ S, p.Prime) :
    (∑ u ∈ T.filter (fun u => ∀ p ∈ S, p ∣ 2*u + 1), μ u) =
      (∑ u ∈ T, μ u) * (∏ p ∈ S, 1 / ((p : ℝ) - 1)) +
        shiftedTotientSieveRemainder T μ (∏ p ∈ S, p) := by
  have hf : T.filter (fun u => ∀ p ∈ S, p ∣ 2*u + 1) =
      T.filter (fun u => (∏ p ∈ S, p) ∣ 2*u + 1) := by
    apply filter_congr
    intro u _
    exact (prime_subset_product_dvd_iff S hS (2*u + 1)).symm
  rw [hf, ← totient_sieve_prime_product_reciprocal S hS]
  unfold shiftedTotientSieveRemainder
  ring

theorem exists_shifted_totient_prime_sieve :
    ∃ K : ℝ, 0 < K ∧ ∀ (P T : Finset ℕ) (μ : ℕ → ℝ) {z : ℝ} {h : ℕ},
      1 < z → 1 ≤ h → Even h →
      (∀ p ∈ P, p.Prime) → (∀ p ∈ P, p ≠ 2) →
      (∀ p ∈ P, (p : ℝ) ≤ z) → (∀ u ∈ T, 0 ≤ μ u) →
      |(∑ u ∈ T.filter (fun u => ∀ p ∈ P, ¬p ∣ 2*u + 1), μ u) -
          (∑ u ∈ T, μ u) * (∏ p ∈ P, (1 - 1 / ((p : ℝ) - 1)))| ≤
        (∑ u ∈ T, μ u) * (∏ p ∈ P, (1 - 1 / ((p : ℝ) - 1))) *
          K * Real.exp (-(h : ℝ)) +
          ∑ d ∈ blockSieveModuli P (z^(4 * (h : ℝ) + 2)),
            |shiftedTotientSieveRemainder T μ d| := by
  obtain ⟨K, hK, hsieve⟩ := exists_odd_prime_reciprocal_sieve_events
  refine ⟨K, hK, ?_⟩
  intro P T μ z h hz hh heven hP hodd hPz hμ
  apply hsieve P T μ (fun u p => p ∣ 2*u + 1) (shiftedTotientSieveRemainder T μ)
    hz (sum_nonneg hμ) hh heven hP hodd hPz hμ
  intro S hS
  exact shifted_totient_intersection_moment T S μ
    (fun p hp => hP p ((mem_powerset.mp hS) hp))

noncomputable def shiftedRoughSet (T : Finset ℕ) (z : ℝ) : Finset ℕ := by
  classical
  exact T.filter (fun u : ℕ => ∀ p : ℕ, p ∈ (2*u + 1).primeFactors → z < (p : ℝ))

theorem mem_shifted_rough_set_iff (T : Finset ℕ) (z : ℝ) (u : ℕ) :
    u ∈ shiftedRoughSet T z ↔ u ∈ T ∧
      ∀ p ∈ (2*u + 1).primeFactors, z < (p : ℝ) := by
  classical
  simp only [shiftedRoughSet, mem_filter]

theorem exists_shifted_totient_rough_sieve :
    ∃ K : ℝ, 0 < K ∧ ∀ (T : Finset ℕ) (μ : ℕ → ℝ) {z : ℝ} {h : ℕ},
      1 < z → 1 ≤ h → Even h → (∀ u ∈ T, 0 ≤ μ u) →
      |(∑ u ∈ shiftedRoughSet T z, μ u) -
          (∑ u ∈ T, μ u) *
            (∏ p ∈ (primeBand 0 z).erase 2, (1 - 1 / ((p : ℝ) - 1)))| ≤
        (∑ u ∈ T, μ u) *
          (∏ p ∈ (primeBand 0 z).erase 2, (1 - 1 / ((p : ℝ) - 1))) *
          K * Real.exp (-(h : ℝ)) +
          ∑ d ∈ blockSieveModuli ((primeBand 0 z).erase 2) (z^(4 * (h : ℝ) + 2)),
            |shiftedTotientSieveRemainder T μ d| := by
  classical
  obtain ⟨K, hK, hsieve⟩ := exists_shifted_totient_prime_sieve
  refine ⟨K, hK, ?_⟩
  intro T μ z h hz hh heven hμ
  have hz0 : 0 ≤ z := le_trans (by norm_num) hz.le
  have hb := hsieve ((primeBand 0 z).erase 2) T μ hz hh heven
    (fun p hp => small_prime_pool_prime (mem_of_mem_erase hp))
    (fun p hp => (mem_erase.mp hp).1)
    (fun p hp => small_prime_pool_le hz0 (mem_of_mem_erase hp)) hμ
  have hf : T.filter (fun u => ∀ p ∈ (primeBand 0 z).erase 2, ¬p ∣ 2*u + 1) =
      shiftedRoughSet T z := by
    ext u
    simp only [mem_filter, mem_shifted_rough_set_iff]
    exact and_congr_right (fun _ => two_mul_add_one_odd_prime_avoidance_iff_rough u hz0)
  rw [hf] at hb
  exact hb
end

section
open Finset
theorem sieve_modulus_mem_factoredNumbers (P : Finset ℕ) (hP : ∀ p ∈ P, p.Prime)
    {D : ℝ} {d : ℕ} (hd : d ∈ blockSieveModuli P D) : d ∈ Nat.factoredNumbers P := by
  exact Nat.mem_factoredNumbers_of_primeFactors_subset
    (Nat.ne_of_gt (block_sieve_modulus_properties P hP D hd).1)
    (block_sieve_modulus_primeFactors_subset P hP D hd)

theorem external_prime_coprime_sieve_modulus (P : Finset ℕ) (hP : ∀ p ∈ P, p.Prime)
    {p d : ℕ} {D : ℝ} (hp : p.Prime) (hout : p ∉ P)
    (hd : d ∈ blockSieveModuli P D) : Nat.Coprime p d := by
  apply hp.coprime_iff_not_dvd.mpr
  intro hdiv
  apply hout
  apply block_sieve_modulus_primeFactors_subset P hP D hd
  exact hp.mem_primeFactors hdiv (Nat.ne_of_gt (block_sieve_modulus_properties P hP D hd).1)

theorem separated_prime_sieve_product_injective (P Q : Finset ℕ) (D : ℝ)
    (hP : ∀ p ∈ P, p.Prime) (hQ : ∀ p ∈ Q, p.Prime)
    (hout : ∀ p ∈ Q, p ∉ P) :
    Set.InjOn (fun x : ℕ × ℕ => x.1 * x.2) (Q.product (blockSieveModuli P D)) := by
  intro x hx y hy hxy
  obtain ⟨hxp, hxd⟩ := mem_product.mp hx
  obtain ⟨hyp, hyd⟩ := mem_product.mp hy
  have hxfree : Disjoint x.1.primeFactors P := by
    rw [(hQ x.1 hxp).primeFactors]
    exact disjoint_singleton_left.mpr (hout x.1 hxp)
  have hyfree : Disjoint y.1.primeFactors P := by
    rw [(hQ y.1 hyp).primeFactors]
    exact disjoint_singleton_left.mpr (hout y.1 hyp)
  obtain ⟨hd, hp⟩ := supported_free_product_unique
    (sieve_modulus_mem_factoredNumbers P hP hxd) (hQ x.1 hxp).ne_zero hxfree
    (sieve_modulus_mem_factoredNumbers P hP hyd) (hQ y.1 hyp).ne_zero hyfree
    (by simpa only [mul_comm] using hxy)
  exact Prod.ext hp hd

theorem separated_prime_sieve_remainders_le (P Q : Finset ℕ) (D : ℝ) (N : ℕ)
    (r : ℕ → ℝ) (hP : ∀ p ∈ P, p.Prime) (hQ : ∀ p ∈ Q, p.Prime)
    (hout : ∀ p ∈ Q, p ∉ P)
    (hlevel : ∀ p ∈ Q, ∀ d ∈ blockSieveModuli P D, p * d ≤ N) :
    (∑ p ∈ Q, ∑ d ∈ blockSieveModuli P D, |r (p * d)|) ≤
      ∑ m ∈ (Icc 1 N).filter Squarefree, |r m| := by
  classical
  let f : ℕ × ℕ → ℕ := fun x => x.1 * x.2
  have hsubset : (Q ×ˢ blockSieveModuli P D).image f ⊆ (Icc 1 N).filter Squarefree := by
    intro m hm
    obtain ⟨⟨p, d⟩, hpd, rfl⟩ := mem_image.mp hm
    obtain ⟨hp, hd⟩ := mem_product.mp hpd
    have hdprop := block_sieve_modulus_properties P hP D hd
    apply mem_filter.mpr
    refine ⟨mem_Icc.mpr ⟨Nat.mul_pos (hQ p hp).pos hdprop.1, hlevel p hp d hd⟩, ?_⟩
    exact Nat.squarefree_mul_iff.mpr
      ⟨external_prime_coprime_sieve_modulus P hP (hQ p hp) (hout p hp) hd,
        (hQ p hp).squarefree, hdprop.2.2.1⟩
  calc
    _ = ∑ x ∈ Q ×ˢ blockSieveModuli P D, |r (f x)| := (sum_product _ _ _).symm
    _ = ∑ m ∈ (Q ×ˢ blockSieveModuli P D).image f, |r m| :=
      (sum_image (f := fun m => |r m|)
        (separated_prime_sieve_product_injective P Q D hP hQ hout)).symm
    _ ≤ _ := sum_le_sum_of_subset_of_nonneg hsubset (fun m _ _ => abs_nonneg (r m))
end

section
open scoped BigOperators Classical
theorem finite_probability_pairing_bound {X Y : Type*} [Fintype X] [Fintype Y]
    (μ : X → ℝ) (ν : Y → ℝ) (hμ : ∀ x, 0 ≤ μ x) (hν : ∀ y, 0 ≤ ν y)
    (hμmass : ∑ x, μ x = 1) (hνmass : ∑ y, ν y = 1)
    (K : X → Y → ℂ) {M : ℝ} (hM : 0 ≤ M) (hK : ∀ x y, ‖K x y‖ ≤ M)
    (f : X → ℂ) (g : Y → ℂ) :
    ‖∑ x, ∑ y, ((μ x * ν y : ℝ) : ℂ) * (K x y * f x * g y)‖ ≤
      M * Real.sqrt ((∑ x, μ x * ‖f x‖ ^ 2) * ∑ y, ν y * ‖g y‖ ^ 2) := by
  rcases eq_or_lt_of_le hM with hM0 | hMp
  · have hz (x : X) (y : Y) : K x y = 0 := norm_le_zero_iff.mp (by simpa [← hM0] using hK x y)
    simp [hz, ← hM0]
  have hMc : (M : ℂ) ≠ 0 := by exact_mod_cast hMp.ne'
  let K' := fun x y => K x y / (M : ℂ)
  have hK' (x : X) (y : Y) : ‖K' x y‖ ≤ 1 := by
    dsimp only [K']
    rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hMp]
    exact (div_le_one hMp).mpr (hK x y)
  have h := finite_pair_event_pairing_le μ ν hμ hν (fun _ _ => True) K' hK' f g
  have hmass : finitePairEventMass μ ν (fun _ _ => True) = 1 := by
    simp only [finitePairEventMass, if_true, ← Finset.mul_sum, hνmass, mul_one, hμmass]
  rw [hmass, Real.sqrt_one, one_mul] at h
  simp only [if_true] at h
  have he : (∑ x, ∑ y, ((μ x * ν y : ℝ) : ℂ) * (K x y * f x * g y)) =
      (M : ℂ) * ∑ x, ∑ y, ((μ x * ν y : ℝ) : ℂ) * (K' x y * f x * g y) := by
    simp only [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro x _
    apply Finset.sum_congr rfl
    intro y _
    dsimp only [K']
    field_simp
  rw [he, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hMp]
  exact mul_le_mul_of_nonneg_left h hM

theorem finite_retained_comparison_pairing {X Y : Type*} [Fintype X] [Fintype Y]
    (μ : X → ℝ) (ν : Y → ℝ) (hμ : ∀ x, 0 ≤ μ x) (hν : ∀ y, 0 ≤ ν y)
    (hμmass : ∑ x, μ x = 1) (hνmass : ∑ y, ν y = 1)
    (E : X → Y → Prop) (raw comparison : X → Y → ℂ)
    (hraw : ∀ x y, ‖raw x y‖ ≤ 1) (hzero : ∀ x y, E x y → comparison x y = 0)
    {ε : ℝ} (hε : 0 ≤ ε) (hclose : ∀ x y, ¬E x y → ‖raw x y - comparison x y‖ ≤ ε)
    (f : X → ℂ) (g : Y → ℂ) :
    ‖∑ x, ∑ y, ((μ x * ν y : ℝ) : ℂ) * ((raw x y - comparison x y) * f x * g y)‖ ≤
      (Real.sqrt (finitePairEventMass μ ν E) + ε) *
        Real.sqrt ((∑ x, μ x * ‖f x‖ ^ 2) * ∑ y, ν y * ‖g y‖ ^ 2) := by
  let keep := fun x y => if E x y then (0 : ℂ) else raw x y - comparison x y
  have hk (x : X) (y : Y) : ‖keep x y‖ ≤ ε := by
    dsimp only [keep]
    split_ifs with h
    · simpa only [norm_zero] using hε
    · exact hclose x y h
  have hr := finite_pair_event_pairing_le μ ν hμ hν E raw hraw f g
  have hc := finite_probability_pairing_bound μ ν hμ hν hμmass hνmass keep hε hk f g
  have he : (∑ x, ∑ y, ((μ x * ν y : ℝ) : ℂ) * ((raw x y - comparison x y) * f x * g y)) =
      (∑ x, ∑ y, if E x y then ((μ x * ν y : ℝ) : ℂ) * (raw x y * f x * g y) else 0) +
      ∑ x, ∑ y, ((μ x * ν y : ℝ) : ℂ) * (keep x y * f x * g y) := by
    simp only [← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro x _
    apply Finset.sum_congr rfl
    intro y _
    by_cases h : E x y <;> simp [keep, h, hzero x y]
  rw [he]
  exact (norm_add_le _ _).trans ((add_le_add hr hc).trans_eq (by ring))

theorem finite_retained_comparison_pairing_supported {X Y : Type*} [Fintype X] [Fintype Y]
    (μ : X → ℝ) (ν : Y → ℝ) (hμ : ∀ x, 0 ≤ μ x) (hν : ∀ y, 0 ≤ ν y)
    (hμmass : ∑ x, μ x = 1) (hνmass : ∑ y, ν y = 1)
    (E : X → Y → Prop) (raw comparison : X → Y → ℂ)
    (hraw : ∀ x y, ‖raw x y‖ ≤ 1) (hzero : ∀ x y, E x y → comparison x y = 0)
    (f : X → ℂ) (g : Y → ℂ) {ε : ℝ} (hε : 0 ≤ ε)
    (hclose : ∀ x y, f x ≠ 0 → g y ≠ 0 → ¬E x y → ‖raw x y - comparison x y‖ ≤ ε) :
    ‖∑ x, ∑ y, ((μ x * ν y : ℝ) : ℂ) * ((raw x y - comparison x y) * f x * g y)‖ ≤
      (Real.sqrt (finitePairEventMass μ ν E) + ε) *
        Real.sqrt ((∑ x, μ x * ‖f x‖ ^ 2) * ∑ y, ν y * ‖g y‖ ^ 2) := by
  let cut := fun x y => f x ≠ 0 ∧ g y ≠ 0
  let raw' := fun x y => if cut x y then raw x y else 0
  let comparison' := fun x y => if cut x y then comparison x y else 0
  have hr (x : X) (y : Y) : ‖raw' x y‖ ≤ 1 := by
    dsimp only [raw']
    split_ifs
    · exact hraw x y
    · simp
  have hz (x : X) (y : Y) (he : E x y) : comparison' x y = 0 := by
    simp only [comparison', hzero x y he, ite_self]
  have hc (x : X) (y : Y) (he : ¬E x y) : ‖raw' x y - comparison' x y‖ ≤ ε := by
    dsimp only [raw', comparison']
    split_ifs with hcut
    · exact hclose x y hcut.1 hcut.2 he
    · simpa only [sub_self, norm_zero] using hε
  have he (x : X) (y : Y) :
      (raw' x y - comparison' x y) * f x * g y =
        (raw x y - comparison x y) * f x * g y := by
    by_cases hx : f x = 0
    · simp [hx]
    by_cases hy : g y = 0
    · simp [hy]
    simp [raw', comparison', cut, hx, hy]
  simpa only [he] using finite_retained_comparison_pairing μ ν hμ hν hμmass hνmass E
    raw' comparison' hr hz hε hc f g
end

section
open Finset
open scoped Classical
noncomputable def jointRawTensorCutoff {N : ℕ} {P : Fin N → Type*}
    {R : (g : Fin N) → P g → Type*} (B : ℕ)
    (row : (g : Fin N) → (GlobalBirthHistoryState (R g) → ℂ) →
      GlobalBirthHistoryState (R g) → ℂ)
    (F : GlobalBirthJointState R → ℂ) (s : GlobalBirthJointState R) : ℂ :=
  globalBirthJointRawCutoff B (finTensorRow N row (globalBirthJointRawCutoff B F)) s

section Joint
variable {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
  [∀ g, DecidableEq (P g)] (n : (g : Fin N) → P g → ℕ)
  (Δ D : Fin N → ℤ) (t : Fin N → ℕ) (B : ℕ)
  (source target : (g : Fin N) → Fin (t g) → P g)
  (H : (g : Fin N) → Finset (P g))
  (q : (g : Fin N) → BoundedOrderedTuple (UnrestrictedResidueParticle (n g)) B)

noncomputable def jointStateEdgeRawTarget
    (e : UnrestrictedJointEvent n Δ D t B (fun g => (source g, q g))) :
    GlobalBirthJointState (fun g p => ZMod (n g p)) :=
  fun g =>
    let u := unrestrictedBoundedEventTarget (n g) (Δ g) (D g) (t g) B (source g, q g) (e g)
    (H g ∪ univ.image u.1, boundedOrderedTupleToFinite u.2)

noncomputable def jointStateEdgePhase
    (e : UnrestrictedJointEvent n Δ D t B (fun g => (source g, q g))) : ℂ :=
  ∏ g, globalBirthBoundedEdgePhase (n g) (Δ g) (D g) (t g) B (target g) (H g)
    (source g, q g) (e g).1 (e g).2.1 (e g).2.2.1 (e g).2.2.2

omit [∀ g, Fintype (P g)] in
theorem joint_state_edge_phase_norm_le
    (e : UnrestrictedJointEvent n Δ D t B (fun g => (source g, q g))) :
    ‖jointStateEdgePhase n Δ D t B source target H q e‖ ≤ 1 := by
  unfold jointStateEdgePhase
  rw [norm_prod]
  apply prod_le_one₀
  · intro g _
    exact norm_nonneg _
  · intro g _
    exact global_birth_bounded_edge_phase_norm_le (n g) (Δ g) (D g) (t g) B
      (target g) (H g) (source g, q g) (e g).1 (e g).2.1 (e g).2.2.1 (e g).2.2.2

theorem joint_raw_tensor_cutoff_edge_events
    (β : (g : Fin N) → P g → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (row : (g : Fin N) → (GlobalBirthHistoryState (fun p => ZMod (n g p)) → ℂ) →
      GlobalBirthHistoryState (fun p => ZMod (n g p)) → ℂ)
    (hrows : ∀ g (K : GlobalBirthHistoryState (fun p => ZMod (n g p)) → ℂ),
      row g K (H g, boundedOrderedTupleToFinite (q g)) =
      ∑ e : UnrestrictedBoundedEvent (n g) (Δ g) (D g) (t g) B (source g, q g),
        (unrestrictedBoundedEventWeight (n g) (Δ g) (D g)
          (fun p => β g p / V g) ρ (V g) (t g) B (source g, q g) e : ℂ) *
        globalBirthBoundedEdgePhase (n g) (Δ g) (D g) (t g) B (target g) (H g)
          (source g, q g) e.1 e.2.1 e.2.2.1 e.2.2.2 *
        K (H g ∪ univ.image (unrestrictedBoundedEventTarget (n g) (Δ g) (D g) (t g) B (source g, q g) e).1,
          boundedOrderedTupleToFinite (unrestrictedBoundedEventTarget (n g) (Δ g) (D g) (t g) B (source g, q g) e).2))
    (F : GlobalBirthJointState (fun g p => ZMod (n g p)) → ℂ) :
    jointRawTensorCutoff B row F (fun g => (H g, boundedOrderedTupleToFinite (q g))) =
      ∑ e : UnrestrictedJointEvent n Δ D t B (fun g => (source g, q g)),
        (unrestrictedJointCutoffEventWeight n Δ D (fun g p => β g p / V g) ρ V t B
          (fun g => (source g, q g)) e : ℂ) *
        jointStateEdgePhase n Δ D t B source target H q e *
          F (jointStateEdgeRawTarget n Δ D t B source H q e) := by
  have hr := fin_tensor_row_events_at N
    row
    (fun g => (H g, boundedOrderedTupleToFinite (q g)))
    (fun g => UnrestrictedBoundedEvent (n g) (Δ g) (D g) (t g) B (source g, q g))
    (fun g e =>
      (H g ∪ univ.image (unrestrictedBoundedEventTarget (n g) (Δ g) (D g) (t g) B (source g, q g) e).1,
        boundedOrderedTupleToFinite (unrestrictedBoundedEventTarget (n g) (Δ g) (D g) (t g) B (source g, q g) e).2))
    (fun g e =>
      (unrestrictedBoundedEventWeight (n g) (Δ g) (D g) (fun p => β g p / V g)
        ρ (V g) (t g) B (source g, q g) e : ℂ) *
      globalBirthBoundedEdgePhase (n g) (Δ g) (D g) (t g) B (target g) (H g)
        (source g, q g) e.1 e.2.1 e.2.2.1 e.2.2.2)
    hrows (globalBirthJointRawCutoff B F)
  simp only [prod_mul_distrib, ← Complex.ofReal_prod] at hr
  change finTensorRow N row (globalBirthJointRawCutoff B F) (fun g => (H g, boundedOrderedTupleToFinite (q g))) =
    ∑ e : UnrestrictedJointEvent n Δ D t B (fun g => (source g, q g)),
      ((∏ g, unrestrictedBoundedEventWeight (n g) (Δ g) (D g) (fun p => β g p / V g)
        ρ (V g) (t g) B (source g, q g) (e g) : ℝ) : ℂ) *
      jointStateEdgePhase n Δ D t B source target H q e *
      globalBirthJointRawCutoff B F (jointStateEdgeRawTarget n Δ D t B source H q e) at hr
  unfold jointRawTensorCutoff
  change (if productTotalMemory (fun g => (source g, q g)) ≤ B then
    finTensorRow N row (globalBirthJointRawCutoff B F) (fun g => (H g, boundedOrderedTupleToFinite (q g))) else 0) = _
  rw [hr]
  have hout (e : UnrestrictedJointEvent n Δ D t B (fun g => (source g, q g))) :
      globalBirthJointRawCutoff B F (jointStateEdgeRawTarget n Δ D t B source H q e) =
      if productTotalMemory (unrestrictedJointEventTarget n Δ D t B (fun g => (source g, q g)) e) ≤ B
      then F (jointStateEdgeRawTarget n Δ D t B source H q e) else 0 := rfl
  simp only [hout]
  unfold unrestrictedJointCutoffEventWeight
  by_cases hi : productTotalMemory (fun g => (source g, q g)) ≤ B
  · rw [if_pos hi]
    apply sum_congr rfl
    intro e _
    by_cases ho : productTotalMemory (unrestrictedJointEventTarget n Δ D t B (fun g => (source g, q g)) e) ≤ B
    · have hb : productTotalMemory (fun g => (source g, q g)) ≤ B ∧
          productTotalMemory (unrestrictedJointEventTarget n Δ D t B (fun g => (source g, q g)) e) ≤ B := ⟨hi, ho⟩
      rw [if_pos ho, if_pos hb]
    · have hb : ¬ (productTotalMemory (fun g => (source g, q g)) ≤ B ∧
          productTotalMemory (unrestrictedJointEventTarget n Δ D t B (fun g => (source g, q g)) e) ≤ B) :=
        fun h => ho h.2
      rw [if_neg ho, if_neg hb]
      simp only [mul_zero, Complex.ofReal_zero, zero_mul]
  · rw [if_neg hi]
    symm
    apply sum_eq_zero
    intro e _
    have hb : ¬ (productTotalMemory (fun g => (source g, q g)) ≤ B ∧
        productTotalMemory (unrestrictedJointEventTarget n Δ D t B (fun g => (source g, q g)) e) ≤ B) :=
      fun h => hi h.1
    rw [if_neg hb]
    simp only [Complex.ofReal_zero, zero_mul]


end Joint
end

