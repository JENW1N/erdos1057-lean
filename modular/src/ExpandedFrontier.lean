/- The original finite offset and residue constraints in selected-path coordinates. -/

open Finset
open scoped Classical
namespace Bounty

section Coherence
variable {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  {patterns : Finset I} (C : I → Fin N → Finset (Fin J)) (k : ℕ → I → ℤ)
  (L : PhysicalMarkLists P J ell)
  (p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)

noncomputable def physicalPathSelectedOffset : Fin (n + 2) → ℤ :=
  fun j => physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p) (n + 1) j.val

def physicalPathSelectedMultiplier (j : Fin (n + 1)) : ℤ :=
  k (n - j.val) (p j).1.2.2.1.val

theorem physical_path_selected_offset_zero : physicalPathSelectedOffset C k L p 0 = 0 := rfl

theorem physical_path_selected_offset_step (j : Fin (n + 1)) :
    physicalPathSelectedOffset C k L p j.succ =
      physicalPathSelectedOffset C k L p j.castSucc + physicalPathSelectedMultiplier C k p j *
        (physicalD (C ((physicalPathSelectedEquiv patterns C (L, p)).1 j).val)
          (physicalPermuteLabels ((physicalPathSelectedEquiv patterns C (L, p)).2.2.2.1 j)
            ((physicalPathSelectedEquiv patterns C (L, p)).2.2.1 j.castSucc))
          ((physicalPathSelectedEquiv patterns C (L, p)).2.1 j) : ℤ) := by
  rw [physical_path_selected_marks_eq_finite_path]
  simp only [physicalPathSelectedOffset, Fin.val_succ, Fin.val_castSucc]
  rw [physicalBareOffset]
  have ha : finitePathLabels p j.val = (p j).1 := by
    simp only [finitePathLabels, dif_pos j.isLt]
  rw [ha]
  simp only [physicalBareStep, Nat.add_sub_cancel, physicalPathSelectedMultiplier,
    physical_path_selected_patterns, physical_path_selected_sigma, physical_path_selected_aux]

theorem physical_path_selected_marks_of_compatible
    (r : PhysicalResidues P) (hr : physicalFinitePathResidueCompatible C k n r L p) :
    ∀ j : Fin (n + 2), ∀ a ∈ physicalMarkedPrimes ((physicalPathSelectedEquiv patterns C (L, p)).2.2.1 j),
      r a = -(physicalPathSelectedOffset C k L p j : ZMod a.2.val) := by
  rw [physical_path_selected_marks_eq_finite_path]
  exact (physical_finite_path_residue_compatible_iff C k n r L p).mp hr

theorem physical_path_selected_return_offset
    (V : Fin N → ℝ) (ζ : ℕ → I → ℝ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (h : physicalFiniteReturnScalar V patterns C ζ k K n L p ≠ 0) :
    physicalPathSelectedOffset C k L p (Fin.last (n + 1)) = 0 := by
  unfold physicalFiniteReturnScalar physicalBareReturnScalar at h
  split_ifs at h with he
  · exact he
  · exact (h rfl).elim

end Coherence
end Bounty
end

section

/- Exact conversion of the original memory coefficient to selected chronological data. -/

open Finset
namespace Bounty

section Scalar
variable {I : Type*} {N J ell r : ℕ} {P : Fin N → Finset ℕ}
    (V : Fin N → ℝ) (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
    (ζ : ℕ → I → ℝ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (pattern : Fin (r + 1) → patterns)
    (d : PhysicalSelectedData P ell (fun j => C (pattern j).val))

theorem physical_selected_memory_walk_scalar_factor
    (hlist : ∀ j : Fin (r + 1), physicalListAdmissible (C (pattern j).val) (d.1 j)
      (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc))
      (physicalPermuteLabels (d.2.2.2 j) (d.2.1 j.succ))) :
    physicalMemoryWalkScalar V patterns C ζ K
      (finitePathLabels ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d⟩).2)
      (finitePathMarks ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d⟩).1
        ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d⟩).2) (r + 1) =
      (∏ i ∈ range (2 * (r + 1) + 1), physicalSelectedCoarseScalar (fun j => C (pattern j).val)
        d.1 d.2.1 d.2.2.1 (fun j _ a => physicalAuxMass V (C (pattern j).val) a) i) *
      physicalSelectedCoefficient (fun j => C (pattern j).val)
        (fun j => ζ ((r + 1) - 1 - j.val) (pattern j).val)
        (fun j => K ((r + 1) - 1 - j.val) (pattern j).val) d := by
  rw [physicalMemoryWalkScalar, ← Fin.prod_univ_eq_prod_range,
    physical_selected_coarse_scalar_product, physicalSelectedCoefficient, ← prod_mul_distrib]
  apply prod_congr rfl
  intro j hj
  have hs := congrFun (physical_selected_inverse_finite_path_marks patterns C pattern d) j.castSucc
  have ht := congrFun (physical_selected_inverse_finite_path_marks patterns C pattern d) j.succ
  dsimp only [Fin.val_castSucc, Fin.val_succ] at hs ht
  rw [hs, ht]
  simp only [finitePathLabels, dif_pos j.isLt, physical_path_selected_inverse_step]
  dsimp only [physicalMemoryLabeledScalar]
  rw [if_pos (hlist j)]
  simp only [Complex.ofReal_natCast]
  ring

end Scalar
end Bounty
end

section

/- Observation and mark-transition conditions for a physical fine history. -/

open scoped Classical
namespace Bounty
section Fine
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J))

noncomputable def PhysicalFineHistoryCoherent
    (o : ℕ → PhysicalMarkObservation P ell C)
    (t : ℕ → PhysicalBoundedMarkState P J ell B) : Prop :=
  (∀ j : Fin (n + 1), o (4 * j.val) = .inr none) ∧
  (∀ j : Fin n, ∃ σ : PhysicalPermutations (Fin N) J ell,
    o (4 * j.val + 1) = .inl σ ∧
    (t (4 * j.val + 1)).1 = physicalPermuteLabels σ (t (4 * j.val)).1) ∧
  (∀ j : Fin n, ∃ a : PhysicalAuxLabels P (C j), o (4 * j.val + 2) = .inr (some ⟨j, a⟩)) ∧
  (∀ j : Fin n, ∃ κ : PhysicalPermutations (Fin N) J ell,
    o (4 * j.val + 3) = .inl κ ∧
    (t (4 * j.val + 4)).1 = physicalPermuteLabels κ (t (4 * j.val + 2)).1)

theorem physical_coherent_fine_history_has_selection
    (o : ℕ → PhysicalMarkObservation P ell C)
    (t : ℕ → PhysicalBoundedMarkState P J ell B)
    (h : PhysicalFineHistoryCoherent C o t) :
    ∃! d : PhysicalSelectedData P ell C, physicalSelectedDataTest C d o t := by
  classical
  obtain ⟨h0, h1, h2, h3⟩ := h
  choose σ hσ hσmark using h1
  choose a ha using h2
  choose κ hκ hκmark using h3
  let L : Fin (n + 1) → PhysicalMarkLists P J ell := fun j => (t (4 * j.val)).1
  let d : PhysicalSelectedData P ell C := (a, L, σ, fun j => physicalInversePermutations (κ j))
  have hd : physicalSelectedDataTest C d o t := by
    apply (physical_selected_data_test_iff_four C d o t).mpr
    refine ⟨fun j => ⟨h0 j, rfl⟩, hσ, ?_, ?_⟩
    · intro j
      refine ⟨ha j, ?_⟩
      change (t (4 * j.val + 2)).1 =
        physicalPermuteLabels (physicalInversePermutations (κ j)) (t (4 * (j.val + 1))).1
      rw [show 4 * (j.val + 1) = 4 * j.val + 4 by omega, hκmark j]
      exact (physical_permute_inverse (κ j) _).symm
    · intro j
      change o (4 * j.val + 3) = .inl (physicalInversePermutations (physicalInversePermutations (κ j)))
      have hi : physicalInversePermutations (physicalInversePermutations (κ j)) = κ j := by
        funext g
        exact Equiv.symm_symm _
      rw [hi]
      exact hκ j
  exact ⟨d, hd, fun e he => physical_selected_data_unique C o t he hd⟩

theorem physical_coherent_selected_source_marks
    (o : ℕ → PhysicalMarkObservation P ell C)
    (t : ℕ → PhysicalBoundedMarkState P J ell B)
    (h : PhysicalFineHistoryCoherent C o t)
    (d : PhysicalSelectedData P ell C) (hd : physicalSelectedDataTest C d o t)
    (j : Fin n) :
    physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc) = (t (4 * j.val + 1)).1 := by
  obtain ⟨h0, h1, _, _⟩ := (physical_selected_data_test_iff_four C d o t).mp hd
  obtain ⟨σ, ho, hm⟩ := h.2.1 j
  have he : σ = d.2.2.1 j := Sum.inl.inj (ho.symm.trans (h1 j))
  rw [← he, ← (h0 j.castSucc).2]
  exact hm.symm

end Fine
end Bounty
end

section

/- A uniform candidate-mass bound for each balanced dyadic rectangle. -/

open Finset Filter
open scoped Topology

namespace Bounty

theorem exists_candidate_pair_mass_bound {c q θ Barea : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ)*(r : ℝ)*c = 1) (hθ : 0 < θ) (hBarea : 0 < Barea)
    (J : ℕ) (hcut : θ < 2*c/(2 : ℝ)^J)
    (hsize : (12/5 : ℝ)*(r : ℝ)*c/(2 : ℝ)^J ≤ 1/25) (hθsmall : 10*θ ≤ 1/20) :
    ∃ C : ℝ, 0 < C ∧ ∃ J0 : ℕ, J ≤ J0 ∧ ∀ D : ℝ,
      ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, J0 < jStar →
      ∀ (a b s t : ℕ) (W : ℝ) (S : Finset (ℕ × ℕ)) (u : ℕ × ℕ → ℕ),
        a ≤ b → s ≤ t → 0 ≤ W → W ≤ Real.exp (θ*L) →
        (b : ℝ)-a ≤ Real.exp ((27/50 : ℝ)*L) →
        (t : ℝ)-s ≤ Real.exp ((27/50 : ℝ)*L) →
        ((b : ℝ)-a)*((t : ℝ)-s) ≤ Barea*Real.exp L →
        (∀ v ∈ S, v.1*v.2 = 2*u v+1) →
        (∀ v ∈ S, v.1 ∈ Ioc a b ∧ v.2 ∈ Ioc s t) →
        (∀ v ∈ S, ∀ p ∈ primeBand 0 W, ¬p ∣ v.1*v.2) →
        (∑ v ∈ S, candidateCoefficient c L q r jStar (u v)) ≤
          C*candidateCoefficientWindowMass c L q r jStar *
            (∏ p ∈ primeBand 0 W, (1-1/(p : ℝ)))^2 +
          candidateCoefficientWindowMass c L q r jStar * L^(-D) := by
  obtain ⟨K, hK, hpair⟩ := exists_candidate_pair_sieve_bound
  obtain ⟨Cm, hCm, J0, hJJ0, hnorm⟩ := exists_candidate_micro_mass_normalization hc hr hq0 hq1 hcenter J
  refine ⟨K*Barea*Cm/θ, by positivity, J0, hJJ0, ?_⟩
  intro D
  filter_upwards [hpair c q θ hc hq0 hq1.le hθ r J hcut hsize, hnorm,
    eventually_pair_lattice_profile_small (3*Cm) D, eventually_gt_atTop (0 : ℝ)]
    with L hp hm he hL
  intro jStar hj a b s t W S u hab hst hW hWz hx hy harea hv hrect hrough
  have hjJ : J ≤ jStar := hJJ0.trans (Nat.le_of_lt hj)
  have hXA : 0 ≤ candidateCoefficientWindowMass c L q r jStar :=
    sum_nonneg (fun n _ => candidate_coefficient_nonneg c L hq0 r jStar n)
  have hVz : 0 ≤ ∏ p ∈ primeBand 0 (Real.exp (θ*L)), (1-1/(p : ℝ)) := by
    apply prod_nonneg
    intro p hpm
    exact (avoidance_factor_bounds ((mem_filter.mp hpm).2).two_le).1.le
  have hmain := pair_main_term_normalization hL hθ hK.le hBarea.le hCm.le
    (mul_nonneg (sub_nonneg.mpr (Nat.cast_le.mpr hab)) (sub_nonneg.mpr (Nat.cast_le.mpr hst)))
    hVz hXA harea (full_prime_avoidance_exp_upper (mul_pos hθ hL)) (hm jStar hj).1
    (V := ∏ p ∈ primeBand 0 W, (1-1/(p : ℝ)))
  have herr := pair_error_term_normalization hL hCm.le
    (candidate_micro_Q_harmonic_nonneg c L r jStar J) hXA
    (pair_lattice_error_scale hL.le hθsmall hx hy) (hm jStar hj).2 he
  refine (hp jStar hjJ a b s t W S u hab hst hW hWz hv hrect hrough).trans ?_
  convert add_le_add hmain herr using 1; ring

end Bounty
end

section

/- The actual recorded empty-memory terminal is insensitive to pending-memory order. -/

open scoped Classical
namespace Bounty

theorem physical_recorded_empty_terminal_formula
    {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (A : Fin N → Finset (Fin J))
    (H : (g : Fin N) → Finset ↥(P g)) (x : PhysicalFullBoundedState P J ell B) :
    physicalRecordedTerminalExtension A physicalEmptyMemoryTerminal (H, x) =
      if FullActiveInjective x ∧ ∀ g, (x g).2.1.val = 0 then 1 else 0 := by
  unfold physicalRecordedTerminalExtension physicalEmptyMemoryTerminal
  by_cases hx : FullActiveInjective x
  · simp only [dif_pos hx, physicalBoundedMarkDecode, hx, true_and]
    rfl
  · simp [hx]

theorem physical_recorded_empty_terminal_reindex
    {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (A : Fin N → Finset (Fin J))
    (H : (g : Fin N) → Finset ↥(P g)) (x : PhysicalFullBoundedState P J ell B)
    (τ : ∀ g, Equiv.Perm (Fin (x g).2.1.val)) :
    physicalRecordedTerminalExtension A physicalEmptyMemoryTerminal (H, productMemoryReindex x τ) =
      physicalRecordedTerminalExtension A physicalEmptyMemoryTerminal (H, x) := by
  rw [physical_recorded_empty_terminal_formula, physical_recorded_empty_terminal_formula]
  rfl

theorem physical_recorded_empty_terminal_symmetric
    {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (A : Fin N → Finset (Fin J))
    (H : (g : Fin N) → Finset ↥(P g)) :
    ProductMemorySymmetric (fun x : PhysicalFullBoundedState P J ell B =>
      physicalRecordedTerminalExtension A physicalEmptyMemoryTerminal (H, x)) := by
  intro x g τ
  rw [← product_memory_reindex_at x g τ]
  exact physical_recorded_empty_terminal_reindex A H x _

end Bounty
end

section

/- Original selected normalization with no residue witness or list-admissibility premise. -/

open Finset
open scoped Classical
namespace Bounty

section ResiduePath
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ)
  (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0) (B : ℕ)

variable
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)


variable [∀ g, ∀ p : ↥(P g), NeZero p.val]

include hstep hP hdis hk in
theorem physical_selected_fine_normalization_unrestricted (hρ : ρ ≠ 0) :
    ((∏ g, ∏ s : PhysicalSlots J ell, β g (L 0 g s) / V g : ℝ) : ℂ) *
      finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
        (physicalSelectedFineRow (B := B) C aux L σ τ k β V ρ hV ω retention)
        (4 * n + 1) physicalEmptyMemoryTerminal (physicalInitialMarkState B (L 0)) =
    (if ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
        (physicalPermuteLabels (σ j) (L j.castSucc))
        (physicalPermuteLabels (τ j) (L j.succ)) then (1 : ℂ) else 0) *
    (∏ i ∈ range (2 * n + 1), physicalSelectedCoarseScalar C aux L σ ω i) *
      (ghostPhaseCappedHistory
        (fun p : PhysicalPrime P => fun j =>
          globalBirthFiniteActivity (physicalGroupBareFiniteActivity L p.1) j p.2)
        (fun p => physicalResidueAbsoluteHit a p.1 p.2)
        (fun _ j => 1 - retention (globalBirthFiniteIndex n j))
        (fun p => β p.1 p.2) (fun p => V p.1)
        (fun _ => B) (fun _ => B) n : ℂ) := by
  by_cases hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ))
  · simp only [if_pos hlist, one_mul]
    exact physical_selected_fine_normalization_without_residues C aux k L a σ τ
