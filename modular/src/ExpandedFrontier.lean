/- The actual count-matched proxy for the exponential roughness test. -/

open Finset Filter

namespace Bounty

def exponentialRoughTest (γ L : ℝ) (n : ℕ) : Prop :=
  ∀ p ∈ n.primeFactors, Real.exp (γ*L) < (p : ℝ)

noncomputable def roughTestIndicator (γ L : ℝ) (n : ℕ) : ℝ := by
  classical
  exact if exponentialRoughTest γ L n then 1 else 0

noncomputable def roughTestCellProxyCoefficient (γ L S Y : ℝ) : ℝ :=
  ((roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (γ*L))).card : ℝ) /
    (roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (Real.sqrt L))).card

noncomputable def roughTestCellProxy (γ L S Y : ℝ) (n : ℕ) : ℝ :=
  if n ∈ roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (Real.sqrt L)) then
    roughTestCellProxyCoefficient γ L S Y else 0

noncomputable def roughTestLogarithmicProxy (γ L S : ℝ) (n : ℕ) : ℝ :=
  roughTestCellProxy γ L S (logarithmicCellBase (L^(-S)) (logarithmicCellIndex (L^(-S)) n)) n

theorem rough_band_subset_of_cutoff {A B W z : ℝ} (hWz : W ≤ z) :
    roughBand A B z ⊆ roughBand A B W := by
  intro n hn
  obtain ⟨hnI, hnrough⟩ := mem_filter.mp hn
  exact mem_filter.mpr ⟨hnI, fun p hp => hWz.trans_lt (hnrough p hp)⟩

theorem rough_test_cell_coefficient_bounds {γ L S Y : ℝ}
    (hcut : Real.sqrt L ≤ γ*L) :
    0 ≤ roughTestCellProxyCoefficient γ L S Y ∧ roughTestCellProxyCoefficient γ L S Y ≤ 1 := by
  let I := roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (γ*L))
  let R := roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (Real.sqrt L))
  have hIR : I ⊆ R := rough_band_subset_of_cutoff (Real.exp_le_exp.mpr hcut)
  by_cases hR : R.card = 0
  · have hI : I.card = 0 := Nat.eq_zero_of_le_zero (hR ▸ card_le_card hIR)
    change 0 ≤ (I.card : ℝ)/(R.card : ℝ) ∧ (I.card : ℝ)/(R.card : ℝ) ≤ 1
    simp only [hR, hI, Nat.cast_zero, div_zero, le_refl, zero_le_one, and_self]
  · have h := finite_cell_count_proxy R I hIR (Nat.pos_of_ne_zero hR)
    exact ⟨h.1, h.2.1⟩

theorem rough_test_cell_proxy_nonneg (γ L S Y : ℝ) (n : ℕ) :
    0 ≤ roughTestCellProxy γ L S Y n := by
  unfold roughTestCellProxy roughTestCellProxyCoefficient
  split <;> positivity

theorem rough_test_cell_proxy_bounds {γ L S Y : ℝ} (hcut : Real.sqrt L ≤ γ*L) (n : ℕ) :
    0 ≤ roughTestCellProxy γ L S Y n ∧ roughTestCellProxy γ L S Y n ≤ 1 := by
  unfold roughTestCellProxy
  split
  · exact rough_test_cell_coefficient_bounds hcut
  · exact ⟨le_rfl, zero_le_one⟩

theorem eventually_rough_test_proxy_cutoff {γ : ℝ} (hγ : 0 < γ) :
    ∀ᶠ L : ℝ in atTop, Real.sqrt L ≤ γ*L := by
  simpa only [pow_zero, div_one] using eventually_sqrt_le_dyadic_scale hγ 0

theorem rough_test_cell_proxy_ne_zero_mem {γ L S Y : ℝ} {n : ℕ}
    (h : roughTestCellProxy γ L S Y n ≠ 0) :
    n ∈ roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (Real.sqrt L)) := by
  by_contra hn
  exact h (by simp only [roughTestCellProxy, if_neg hn])

theorem rough_band_avoids_small_primes {A B W : ℝ} {n : ℕ} (hn : n ∈ roughBand A B W) :
    ∀ p ∈ primeBand 0 W, ¬p ∣ n := by
  intro p hp hpn
  have hpf : p ∈ n.primeFactors := Nat.mem_primeFactors.mpr
    ⟨(mem_filter.mp hp).2, hpn, (roughBand_pos hn).ne'⟩
  have hlarge := (mem_filter.mp hn).2 p hpf
  have hW : 0 ≤ W := by
    have hfloor : 0 < ⌊W⌋₊ := ((mem_filter.mp hp).2.pos).trans_le (mem_Ioc.mp (mem_filter.mp hp).1).2
    have hh : 1 ≤ W := Nat.floor_pos.mp hfloor
    linarith
  have hsmall : (p : ℝ) ≤ W := (Nat.cast_le.mpr (mem_Ioc.mp (mem_filter.mp hp).1).2).trans
    (Nat.floor_le hW)
  exact (not_lt_of_ge hsmall) hlarge

theorem rough_test_cell_proxy_count_match {γ L S Y : ℝ}
    (hR : 0 < (roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (Real.sqrt L))).card) :
    (∑ n ∈ Ioc ⌊Y⌋₊ ⌊Real.exp (L^(-S))*Y⌋₊, roughTestCellProxy γ L S Y n) =
      ((roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (γ*L))).card : ℝ) := by
  classical
  have hsubset : roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (Real.sqrt L)) ⊆
      Ioc ⌊Y⌋₊ ⌊Real.exp (L^(-S))*Y⌋₊ := fun _ hn => (mem_filter.mp hn).1
  rw [← sum_subset hsubset (fun n _ hn => by simp only [roughTestCellProxy, if_neg hn])]
  trans ∑ _n ∈ roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (Real.sqrt L)),
    roughTestCellProxyCoefficient γ L S Y
  · exact sum_congr rfl (fun n hn => by simp only [roughTestCellProxy, if_pos hn])
  simp only [sum_const, nsmul_eq_mul]
  unfold roughTestCellProxyCoefficient
  have hcard : ((roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (Real.sqrt L))).card : ℝ) ≠ 0 :=
    (Nat.cast_pos.mpr hR).ne'
  field_simp

theorem rough_test_cell_proxy_full_cell_zero_sum {γ L S Y : ℝ}
    (hR : 0 < (roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (Real.sqrt L))).card) :
    (∑ n ∈ Ioc ⌊Y⌋₊ ⌊Real.exp (L^(-S))*Y⌋₊,
      (roughTestIndicator γ L n-roughTestCellProxy γ L S Y n)) = 0 := by
  classical
  rw [sum_sub_distrib, rough_test_cell_proxy_count_match hR]
  simp only [roughTestIndicator, sum_boole]
  apply sub_eq_zero.mpr
  congr 2
  ext i
  constructor
  · intro hi
    exact mem_filter.mpr ⟨(mem_filter.mp hi).1, (mem_filter.mp hi).2⟩
  · intro hi
    exact mem_filter.mpr ⟨(mem_filter.mp hi).1, (mem_filter.mp hi).2⟩

theorem rough_test_logarithmic_proxy_eq_on_cell {γ L S : ℝ} (hL : 0 < L) {k : ℤ} {n : ℕ}
    (hn : n ∈ logarithmicCellSet (L^(-S)) k) :
    roughTestLogarithmicProxy γ L S n = roughTestCellProxy γ L S (logarithmicCellBase (L^(-S)) k) n := by
  unfold roughTestLogarithmicProxy
  rw [(mem_logarithmic_cell_iff (by positivity) (logarithmic_cell_pos hn) k).mp hn]

theorem eventually_rough_test_logarithmic_proxy_bounds {γ : ℝ} (hγ : 0 < γ) :
    ∀ᶠ L : ℝ in atTop, ∀ S : ℝ, ∀ n : ℕ,
      0 ≤ roughTestLogarithmicProxy γ L S n ∧ roughTestLogarithmicProxy γ L S n ≤ 1 ∧
      |roughTestIndicator γ L n-roughTestLogarithmicProxy γ L S n| ≤ 1 := by
  classical
  filter_upwards [eventually_rough_test_proxy_cutoff hγ] with L hcut
  intro S n
  have hv := rough_test_cell_proxy_bounds (S := S)
    (Y := logarithmicCellBase (L^(-S)) (logarithmicCellIndex (L^(-S)) n)) hcut n
  change 0 ≤ roughTestLogarithmicProxy γ L S n ∧ roughTestLogarithmicProxy γ L S n ≤ 1 at hv
  refine ⟨hv.1, hv.2, ?_⟩
  unfold roughTestIndicator
  split <;> rw [abs_le] <;> constructor <;> linarith [hv.1, hv.2]

end Bounty
end

section

/- Selected-child counts are fixed by the original forest and schedule, not by birth values. -/

open Finset Classical

namespace Bounty

noncomputable def fullMixedHeadSelectedCount
    {J K : Type*} {N : ℕ} {M : Fin N → ℕ}
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (tag : Option (J ⊕ K)) (steps : List (Option (J ⊕ K)))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B (tag :: steps)))) (g : Fin N) : ℕ :=
  (univ.filter (fun i =>
    fullMixedBirthOwner S B (tag :: steps) (fullMixedBirthOrder S B (tag :: steps) i) = 0 ∧
    (fullMixedBirthOrder S B (tag :: steps) i).2.1 = g ∧ code i ≠ none)).card

section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K)))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)

section Ghost
variable (j : J) (sk : CoupledGhostSkeleton M B s) (births : CoupledGhostSamples M B s sk)
    (tail : FullPermutationMixedPath n S B A Δ D steps
      (fullPermutationMixedEventTarget n S B A Δ D (some (.inl j)) s ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩)))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B (some (.inl j) :: steps))))


theorem full_mixed_ghost_head_selected_count (hchildren : ∀ i, code i ≠ none → fullMixedPathBirthPerformed n S B A Δ D (some (.inl j) :: steps) s ⟨(fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩, tail⟩
      (fullMixedBirthOrder S B (some (.inl j) :: steps) i))
    (g : Fin N) :
    (univ.filter (fun i : Fin (sk g).1.val => code ((fullMixedGhostHeadSampleEmbedding S B j steps s sk) ⟨g, i⟩) ≠ none)).card =
      fullMixedHeadSelectedCount S B (some (.inl j)) steps code g := by
  unfold fullMixedHeadSelectedCount
  exact selected_fiber_card (fullMixedGhostHeadSampleEmbedding S B j steps s sk)
    (fun i => fullMixedBirthOwner S B (some (.inl j) :: steps) (fullMixedBirthOrder S B (some (.inl j) :: steps) i) = 0)
    (fun i => code i ≠ none) (fun i => (fullMixedBirthOrder S B (some (.inl j) :: steps) i).2.1)
    (full_mixed_ghost_head_sample_owner S B j steps s sk) (full_mixed_ghost_head_sample_group S B j steps s sk)
    (fun i hi hs => (full_mixed_ghost_head_sample_coverage n S B A Δ D steps s j sk births tail i).mp ⟨hchildren i hs, hi⟩) g

theorem full_mixed_ghost_head_selected_count_le (hchildren : ∀ i, code i ≠ none → fullMixedPathBirthPerformed n S B A Δ D (some (.inl j) :: steps) s ⟨(fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩, tail⟩
      (fullMixedBirthOrder S B (some (.inl j) :: steps) i))
    (g : Fin N) :
    fullMixedHeadSelectedCount S B (some (.inl j)) steps code g ≤ (sk g).1.val := by
  rw [← full_mixed_ghost_head_selected_count n S B A Δ D steps s j sk births tail code hchildren g]
  have h := card_filter_le (s := (univ : Finset (Fin (sk g).1.val)))
    (p := fun i => code ((fullMixedGhostHeadSampleEmbedding S B j steps s sk) ⟨g, i⟩) ≠ none)
  simpa only [card_univ, Fintype.card_fin, Fintype.card_subtype_compl, Fintype.card_coe] using h

end Ghost

section Edge
variable (k : K) (sk : FullActiveEdgeSkeleton n (S k) B (A k) (Δ k) (D k) s) (fresh : FullActiveEdgeSamples n (S k) B (A k) (Δ k) (D k) s sk)
    (tail : FullPermutationMixedPath n S B A Δ D steps
      (fullPermutationMixedEventTarget n S B A Δ D (some (.inr k)) s ((fullPermutationEdgeBirthEquiv (J := J) n S B A Δ D s k).symm ⟨sk, fresh⟩)))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B (some (.inr k) :: steps))))


theorem full_mixed_edge_head_selected_count (hchildren : ∀ i, code i ≠ none → fullMixedPathBirthPerformed n S B A Δ D (some (.inr k) :: steps) s ⟨(fullPermutationEdgeBirthEquiv (J := J) n S B A Δ D s k).symm ⟨sk, fresh⟩, tail⟩
      (fullMixedBirthOrder S B (some (.inr k) :: steps) i))
    (g : Fin N) :
    (univ.filter (fun i : {i : Fin (S k g)ᶜ.card // i ∉ (sk.2 g).2.1} => code ((fullMixedEdgeHeadSampleEmbedding n S B k steps (A k) (Δ k) (D k) s sk) ⟨g, i⟩) ≠ none)).card =
      fullMixedHeadSelectedCount S B (some (.inr k)) steps code g := by
  unfold fullMixedHeadSelectedCount
  exact selected_fiber_card (fullMixedEdgeHeadSampleEmbedding n S B k steps (A k) (Δ k) (D k) s sk)
    (fun i => fullMixedBirthOwner S B (some (.inr k) :: steps) (fullMixedBirthOrder S B (some (.inr k) :: steps) i) = 0)
    (fun i => code i ≠ none) (fun i => (fullMixedBirthOrder S B (some (.inr k) :: steps) i).2.1)
    (full_mixed_edge_head_sample_owner n S B k steps (A k) (Δ k) (D k) s sk) (full_mixed_edge_head_sample_group n S B k steps (A k) (Δ k) (D k) s sk)
    (fun i hi hs => (full_mixed_edge_head_sample_coverage n S B A Δ D steps s k sk fresh tail i).mp ⟨hchildren i hs, hi⟩) g

theorem full_mixed_edge_head_selected_count_le (hchildren : ∀ i, code i ≠ none → fullMixedPathBirthPerformed n S B A Δ D (some (.inr k) :: steps) s ⟨(fullPermutationEdgeBirthEquiv (J := J) n S B A Δ D s k).symm ⟨sk, fresh⟩, tail⟩
      (fullMixedBirthOrder S B (some (.inr k) :: steps) i))
    (g : Fin N) :
    fullMixedHeadSelectedCount S B (some (.inr k)) steps code g ≤ (S k g)ᶜ.card - (sk.2 g).2.1.card := by
  rw [← full_mixed_edge_head_selected_count n S B A Δ D steps s k sk fresh tail code hchildren g]
  have h := card_filter_le (s := (univ : Finset ({i : Fin (S k g)ᶜ.card // i ∉ (sk.2 g).2.1})))
    (p := fun i => code ((fullMixedEdgeHeadSampleEmbedding n S B k steps (A k) (Δ k) (D k) s sk) ⟨g, i⟩) ≠ none)
  simpa only [card_univ, Fintype.card_fin, Fintype.card_subtype_compl, Fintype.card_coe] using h

end Edge

end Full
end Bounty
