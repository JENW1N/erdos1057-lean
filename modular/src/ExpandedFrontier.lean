section

/- Exact physical history normalization under adjacent common-mark compatibility.
No global residue assignment is supplied; all original local rows and cutoffs remain. -/

open Finset
namespace Bounty

section ResiduePath
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (hcompat : ∀ j : Fin n, ∀ g s t,
    ((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val =
      ((physicalPermuteLabels (τ j) (L j.succ)) g t).val →
    (((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val : ℤ) ∣
      k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))

variable
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ) (η : Fin N → Fin (n + 1) → ℝ)
  (V ρ : Fin N → ℝ) (hV : ∀ g, V g ≠ 0) (cap : ℕ)


variable [∀ g, ∀ p : ↥(P g), NeZero p.val]

/- The actual total-cutoff joint kernel is exactly the flattened real
capped tensor kernel, for every atomic index used by the finite path. -/
include hstep in
theorem physical_joint_adjacent_kernel_to_real (i : ℕ) (hi : i < 2 * n + 1)
    (z w : (g : Fin N) → (p : ↥(P g)) → GhostPhaseState (ZMod p.val)) :
    globalBirthJointKernel
      (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β η V ρ hV cap i)
      cap z w =
    ((finiteAlternatingKernel (physicalJointCappedVisitKernel L β η ρ cap)
      (physicalJointCappedMovingEdgeKernel L a β V ρ cap) i
      (globalBirthFlattenPhase z) (globalBirthFlattenPhase w) : ℝ) : ℂ) := by
  have hg (g : Fin N) := physical_adjacent_atomic_kernel_to_real
    C aux k L a σ τ hstep hcompat hlist hP hdis g (fun j => hk j g)
    (β g) (η g) (V g) (ρ g) (hV g) cap i hi (z g) (w g)
  calc
    _ = ((if (∑ g, (ghostPhasePendingSupport (z g)).card) ≤ cap then
          ∏ g, finiteAlternatingKernel (physicalResidueCappedVisitKernel L g (β g) (η g) (ρ g) cap)
            (physicalResidueCappedMovingEdgeKernel L a g (β g) (V g) (ρ g) cap) i (z g) (w g)
        else 0 : ℝ) : ℂ) := by
      unfold globalBirthJointKernel
      change (if _ then ∏ g, globalBirthRawStepKernel
        (physicalGroupAdjacentFiniteStep C aux k L a σ τ hcompat hlist hP hdis
          g (fun j => hk j g) (β g) (η g) (V g) (ρ g) (hV g) cap i) (z g) (w g) else 0) = _
      simp_rw [hg]
      simp only [globalBirthJointPending]
      split_ifs <;> simp only [Complex.ofReal_prod, Complex.ofReal_zero]
    _ = _ := by
      apply congrArg (fun r : ℝ => (r : ℂ))
      by_cases he : i % 2 = 0
      · simp only [finiteAlternatingKernel, he, ite_true]
        exact ghost_phase_grouped_capped_visit _ _ _ _ _ cap z w
      · simp only [finiteAlternatingKernel, he, ite_false]
        exact ghost_phase_grouped_capped_moving_edge _ _ _ _ _ _ _ cap z w

end ResiduePath
end Bounty
end

section

/- Exact physical history normalization under adjacent common-mark compatibility.
No global residue assignment is supplied; all original local rows and cutoffs remain. -/

open Finset
namespace Bounty

section ResiduePath
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (hcompat : ∀ j : Fin n, ∀ g s t,
    ((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val =
      ((physicalPermuteLabels (τ j) (L j.succ)) g t).val →
    (((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val : ℤ) ∣
      k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ) (η : Fin N → Fin (n + 1) → ℝ)
  (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0) (B : ℕ)

include hstep in
theorem physical_joint_adjacent_edge_literal_row (j : Fin n) (g : Fin N)
    (K : GlobalBirthHistoryState (fun p : ↥(P g) => ZMod p.val) → ℂ)
    (u : GlobalBirthHistoryState (fun p : ↥(P g) => ZMod p.val)) :
    globalBirthRawStepRow
      (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β η V
        (fun _ => ρ) hV B (2 * j.val + 1) g) (fun H q => K (H, q)) u.1 u.2 =
    physicalFullEdgeRawRow (B := B) (C j) (k j)
      (physicalPermuteLabels (σ j) (L j.castSucc))
      (physicalPermuteLabels (τ j) (L j.succ)) β ρ V (aux j) g K u := by
  have h := physical_group_adjacent_finite_edge_row C aux k L a σ τ hstep hcompat
    hlist hP hdis g (fun j => hk j g) (β g) (η g) (V g) ρ (hV g) B j
    (fun H q => K (H, q)) u.1 u.2
  have hδ := physical_group_phase_delta_as_integer_step (P := P)
    (a j.castSucc) (a j.succ) (k j)
    (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ) (hstep j) g
  simp only [hδ] at h
  convert h using 1 <;> rfl

include hstep in
theorem physical_joint_adjacent_edge_literal_tensor (j : Fin n)
    (F : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ)
    (s : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val)) :
    globalBirthJointCutRawRow
      (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β η V
        (fun _ => ρ) hV B (2 * j.val + 1)) B B F s =
    jointRawTensorCutoff B
      (physicalFullEdgeRawRow (B := B) (C j) (k j)
        (physicalPermuteLabels (σ j) (L j.castSucc))
        (physicalPermuteLabels (τ j) (L j.succ)) β ρ V (aux j)) F s := by
  have hr :
      (fun g (K : GlobalBirthHistoryState (fun p : ↥(P g) => ZMod p.val) → ℂ)
        (u : GlobalBirthHistoryState (fun p : ↥(P g) => ZMod p.val)) =>
        globalBirthRawStepRow
          (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β η V
            (fun _ => ρ) hV B (2 * j.val + 1) g) (fun H q => K (H, q)) u.1 u.2) =
      physicalFullEdgeRawRow (B := B) (C j) (k j)
        (physicalPermuteLabels (σ j) (L j.castSucc))
        (physicalPermuteLabels (τ j) (L j.succ)) β ρ V (aux j) := by
    funext g K u
    exact physical_joint_adjacent_edge_literal_row C aux k L a σ τ hstep hcompat
      hlist hP hdis hk β η V ρ hV B j g K u
  unfold globalBirthJointCutRawRow globalBirthJointRawRow jointRawTensorCutoff
  rw [hr]

end ResiduePath
end Bounty
end

section

/- Sort an actual finite sample set by its embedding into the original chronological addresses. -/

open Classical

namespace Bounty

noncomputable def finiteEmbeddedOrder {I : Type*} [Fintype I] {N : ℕ}
    (f : I ↪ Fin N) : Fin (Fintype.card I) ≃ I :=
  (Fintype.orderIsoFinOfCardEq (Set.range f)
    (Fintype.card_congr (Equiv.ofInjective f f.injective).symm)).toEquiv.trans
      (Equiv.ofInjective f f.injective).symm

theorem finite_embedded_order_strictMono {I : Type*} [Fintype I] {N : ℕ}
    (f : I ↪ Fin N) : StrictMono (fun j => f (finiteEmbeddedOrder f j)) := by
  let e := Equiv.ofInjective f f.injective
  have he (x : Set.range f) : f (e.symm x) = x.val := by
    exact congrArg Subtype.val (e.apply_symm_apply x)
  intro i j hij
  dsimp [finiteEmbeddedOrder]
  rw [he, he]
  exact (Fintype.orderIsoFinOfCardEq (Set.range f) (Fintype.card_congr e.symm)).strictMono hij

end Bounty
end

section

/- A cofactor-first form of the least-prime-factor decomposition, including repeated primes. -/

open Finset

namespace Bounty

theorem buchstab_cofactors_as_rough_band {U V z : ℝ} (hU : 1 ≤ U) (hV : 0 ≤ V)
    {p : ℕ} (hp : p.Prime) (hpz : z < (p : ℝ)) :
    buchstabCompositeCofactors (roughBand U V z) ⌊V⌋₊ p =
      (roughBand 1 V z).filter (fun m => p ≤ m.minFac ∧ U < ((p*m : ℕ) : ℝ) ∧ ((p*m : ℕ) : ℝ) ≤ V) := by
  classical
  ext m
  constructor
  · intro hm
    obtain ⟨hmI, hmS, hmorder⟩ := mem_filter.mp hm
    have hpm : p ≤ m := (mem_Icc.mp hmI).1
    have hm0 : m ≠ 0 := (hp.pos.trans_le hpm).ne'
    have hm1 : m ≠ 1 := by have := hp.two_le.trans hpm; omega
    have hmrough : ∀ q ∈ m.primeFactors, z < (q : ℝ) := by
      intro q hq
      apply (mem_filter.mp hmS).2 q
      exact Nat.mem_primeFactors.mpr ⟨Nat.prime_of_mem_primeFactors hq,
        (Nat.dvd_of_mem_primeFactors hq).trans (dvd_mul_left m p),
        Nat.mul_ne_zero hp.ne_zero hm0⟩
    have hmR : m ∈ roughBand 1 V z := mem_filter.mpr
      ⟨mem_Ioc.mpr ⟨by simpa only [Nat.floor_one] using (show 1 < m by have := hp.two_le.trans hpm; omega),
        (mem_Icc.mp hmI).2⟩, hmrough⟩
    have hmin : p ≤ m.minFac := hmorder m.minFac
      (Nat.mem_primeFactors.mpr ⟨Nat.minFac_prime hm1, Nat.minFac_dvd m, hm0⟩)
    exact mem_filter.mpr ⟨hmR, hmin,
      Nat.lt_of_floor_lt (mem_Ioc.mp (mem_filter.mp hmS).1).1,
      (Nat.cast_le.mpr (mem_Ioc.mp (mem_filter.mp hmS).1).2).trans (Nat.floor_le hV)⟩
  · intro hm
    obtain ⟨hmR, hmin, hprodlo, hprodhi⟩ := mem_filter.mp hm
    have hm0 : m ≠ 0 := (roughBand_pos hmR).ne'
    have hmrough := (mem_filter.mp hmR).2
    have hpm : p ≤ m := hmin.trans (Nat.minFac_le (roughBand_pos hmR))
    have hprodrough : ∀ q ∈ (p*m).primeFactors, z < (q : ℝ) := by
      intro q hq
      rw [Nat.primeFactors_mul hp.ne_zero hm0, hp.primeFactors] at hq
      rcases mem_union.mp hq with hqp | hqm
      · simpa only [mem_singleton.mp hqp] using hpz
      · exact hmrough q hqm
    have hprod : p*m ∈ roughBand U V z := mem_filter.mpr
      ⟨mem_Ioc.mpr ⟨(Nat.floor_lt (by linarith : 0 ≤ U)).mpr hprodlo,
        Nat.le_floor hprodhi⟩, hprodrough⟩
    apply mem_filter.mpr
    refine ⟨mem_Icc.mpr ⟨hpm, (mem_Ioc.mp (mem_filter.mp hmR).1).2⟩, hprod, ?_⟩
    intro q hq
    exact hmin.trans (Nat.minFac_le_of_dvd (Nat.prime_of_mem_primeFactors hq).two_le
      (Nat.dvd_of_mem_primeFactors hq))

theorem prime_part_of_rough_band {U V z : ℝ} (hU : 0 ≤ U) (hV : 0 ≤ V) :
    (roughBand U V z).filter Nat.Prime = primeBand (max U z) V := by
  classical
  ext p
  simp only [mem_filter, roughBand, mem_Ioc, Nat.floor_lt hU, Nat.le_floor_iff hV,
    mem_primeBand_iff (hU.trans (le_max_left _ _)) hV, max_lt_iff]
  constructor
  · rintro ⟨⟨⟨hUp, hpV⟩, hrough⟩, hp⟩
    have hpz : z < (p : ℝ) := hrough p (by rw [hp.primeFactors]; exact mem_singleton_self _)
    exact ⟨hp, ⟨hUp, hpz⟩, hpV⟩
  · rintro ⟨hp, ⟨hUp, hpz⟩, hpV⟩
    refine ⟨⟨⟨hUp, hpV⟩, ?_⟩, hp⟩
    intro q hq
    rw [hp.primeFactors] at hq
    simpa only [mem_singleton.mp hq] using hpz

end Bounty
end

section

/- Position-dependent local phases expand along the original, unaugmented event paths. -/

open Finset Classical
namespace Bounty
section Indexed
variable {K X : Type*} (E : K → X → Type*) [∀ k x, Fintype (E k x)]
    (target : ∀ k x, E k x → X) (weight : ∀ k x, E k x → ℝ)

noncomputable def finiteOccurrencePhasedRow (steps : List K)
    (phase : ∀ (i : Fin steps.length) x, E (steps.get i) x → ℂ)
    (i : Fin steps.length) (f : X → ℂ) (x : X) : ℂ :=
  ∑ e : E (steps.get i) x, (weight (steps.get i) x e : ℂ) * phase i x e *
    f (target (steps.get i) x e)

theorem finite_occurrence_phased_rows_eq_paths (steps : List K)
    (phase : ∀ (i : Fin steps.length) x, E (steps.get i) x → ℂ) (f : X → ℂ) :
    finiteOperatorListAction (finiteOccurrencePhasedRow E target weight steps phase)
      (List.finRange steps.length) f =
      finiteEventPathAction E target weight steps
        (fun x p => ∏ i : Fin steps.length, phase i
          (finiteEventPathOccurrence E target steps x p i).1
          (finiteEventPathOccurrence E target steps x p i).2) f := by
  induction steps with
  | nil =>
    funext x
    change f x = ∑ _p : PUnit, (1 : ℂ) * (1 : ℂ) * f x
    simp
  | cons k steps ih =>
    change finiteOperatorListAction (finiteOccurrencePhasedRow E target weight (k :: steps) phase)
      (List.finRange (steps.length + 1)) f = _
    rw [List.finRange_succ]
    change finiteOccurrencePhasedRow E target weight (k :: steps) phase 0
      (finiteOperatorListAction _ ((List.finRange steps.length).map Fin.succ) f) = _
    rw [← finite_operator_list_map]
    change finiteOccurrencePhasedRow E target weight (k :: steps) phase 0
      (finiteOperatorListAction (finiteOccurrencePhasedRow E target weight steps
        (fun i x e => phase i.succ x e)) (List.finRange steps.length) f) = _
    rw [ih]
    funext x
    let _ : ∀ y, Fintype (FiniteEventPath E target steps y) := finiteEventPathFintype E target steps
    change (∑ e : E k x, (weight k x e : ℂ) * phase 0 x e *
      (∑ p : FiniteEventPath E target steps (target k x e),
        (finiteEventPathWeight E target weight steps _ p : ℂ) *
          (∏ i : Fin steps.length, phase i.succ
            (finiteEventPathOccurrence E target steps _ p i).1
            (finiteEventPathOccurrence E target steps _ p i).2) *
          f (finiteEventPathTerminal E target steps _ p))) =
      ∑ p : (Σ e : E k x, FiniteEventPath E target steps (target k x e)), _
    rw [Fintype.sum_sigma]
    apply sum_congr rfl
    intro e _
    rw [mul_sum]
    apply sum_congr rfl
    intro p _
    have hprod := Fin.prod_univ_succ (fun i : Fin (steps.length + 1) => phase i
      (finiteEventPathOccurrence E target (k :: steps) x ⟨e, p⟩ i).1
      (finiteEventPathOccurrence E target (k :: steps) x ⟨e, p⟩ i).2)
    calc
      _ = (weight k x e : ℂ) *
          (finiteEventPathWeight E target weight steps (target k x e) p : ℂ) *
          (phase 0 x e * ∏ i : Fin steps.length, phase i.succ
            (finiteEventPathOccurrence E target steps (target k x e) p i).1
            (finiteEventPathOccurrence E target steps (target k x e) p i).2) *
          f (finiteEventPathTerminal E target steps (target k x e) p) := by ring
      _ = (weight k x e : ℂ) *
          (finiteEventPathWeight E target weight steps (target k x e) p : ℂ) *
          (∏ i : Fin (steps.length + 1), phase i
            (finiteEventPathOccurrence E target (k :: steps) x ⟨e, p⟩ i).1
            (finiteEventPathOccurrence E target (k :: steps) x ⟨e, p⟩ i).2) *
          f (finiteEventPathTerminal E target steps (target k x e) p) :=
        congrArg (fun z : ℂ => (weight k x e : ℂ) *
          (finiteEventPathWeight E target weight steps (target k x e) p : ℂ) * z *
          f (finiteEventPathTerminal E target steps (target k x e) p)) hprod.symm
      _ = _ := by
        simp only [finiteEventPathWeight, Complex.ofReal_mul, finiteEventPathTerminal]
        rfl

end Indexed
end Bounty
end

section

/- The actual bounded edge skeleton has the existing damping and length cost before fresh masses are inserted. -/

open Finset Classical

namespace Bounty

theorem unrestricted_bounded_skeleton_length_cost {P : Type*}
    (n : P → ℕ) (Δ D : ℤ) (ρ V v : ℝ)
    (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1) (hV : 0 ≤ V) (hv : 0 < v)
    (t B : ℕ) (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (sk : UnrestrictedLocalEdgeSkeleton n Δ D t B s) :
    |unrestrictedBoundedSkeletonMass n Δ D ρ V t B s sk.1 sk.2.1 sk.2.2| *
      v ^ unrestrictedSkeletonOutputCount n Δ D t B s sk ≤
    (ρ ^ ((unrestrictedResidueEligible n Δ D s.2.2).card - sk.2.1.card) / V ^ sk.2.1.card) *
      (v ^ s.2.1.val * (v ^ sk.1.card / v ^ sk.2.1.card)) := by
  have hout : v ^ (unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
      (unrestrictedResidueTransport n Δ) sk.1 sk.2.1 sk.2.2).1 =
      v ^ s.2.1.val * (v ^ sk.1.card / v ^ sk.2.1.card) := by
    simpa only [unrestrictedEdgeOutput, Fintype.card_coe] using
      unrestrictedEdgeMemory_weight s.2.2 (unrestrictedResidueTransport n Δ)
        (unrestrictedStoredTuple s.1 (unrestrictedResidueSeed n) sk.1) sk.2.2 hv.ne'
  have hdamp : ρ ^ orderedPredicateCount ⟨s.2.1.val, s.2.2⟩ unrestrictedResidueHit *
      ρ ^ orderedPredicateCount (unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
        (unrestrictedResidueTransport n Δ) sk.1 sk.2.1 sk.2.2) unrestrictedResidueHit ≤
      ρ ^ ((unrestrictedResidueEligible n Δ D s.2.2).card - sk.2.1.card) := by
    simpa only [unrestrictedEdgeOutput, Fintype.card_coe] using
      unrestrictedEdgeMemory_two_damping_le s.2.2 (unrestrictedResidueTransport n Δ)
        (unrestrictedStoredTuple s.1 (unrestrictedResidueSeed n) sk.1) unrestrictedResidueHit sk.2.2
        (unrestrictedResidueEligible_translated_hit n Δ D s.2.2) hρ0 hρ1
  rw [abs_of_nonneg (unrestricted_bounded_skeleton_mass_nonneg n Δ D ρ V hρ0 hV t B s sk.1 sk.2.1 sk.2.2)]
  by_cases hc : unrestrictedResidueStorageAllowed n D s.1 sk.1 ∧
      (unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
        (unrestrictedResidueTransport n Δ) sk.1 sk.2.1 sk.2.2).1 ≤ B
  · simp only [unrestrictedBoundedSkeletonMass, hc, if_true, unrestrictedSkeletonOutputCount]
    rw [hout]
    exact mul_le_mul_of_nonneg_right
      (div_le_div_of_nonneg_right hdamp (pow_nonneg hV _))
      (mul_nonneg (pow_nonneg hv.le _) (div_nonneg (pow_nonneg hv.le _) (pow_nonneg hv.le _)))
  · simp only [unrestrictedBoundedSkeletonMass, hc, if_false, zero_mul]
    exact mul_nonneg (div_nonneg (pow_nonneg hρ0 _) (pow_nonneg hV _))
      (mul_nonneg (pow_nonneg hv.le _) (div_nonneg (pow_nonneg hv.le _) (pow_nonneg hv.le _)))

end Bounty
end

section

/- The shifted and ordinary sieve densities share the same positive Mertens constant. -/

open Finset Filter
open scoped Topology

namespace Bounty

theorem logarithmic_shifted_prime_avoidance_product_tendsto :
    Tendsto (fun z : ℝ => Real.log z * shiftedPrimeAvoidanceProduct z) atTop
      (𝓝 (shiftedSieveRatioConstant * Mertens.primeProductLimitConstant)) := by
  have ht := odd_prime_correction_product_tendsto.mul logarithmic_prime_avoidance_product_tendsto
  apply ht.congr'
  filter_upwards [eventually_ge_atTop (2 : ℝ)] with z hz
  rw [shifted_prime_avoidance_product_factorization hz]
  ring

theorem exponential_shifted_prime_avoidance_product_tendsto {b : ℝ} (hb : 0 < b) :
    Tendsto (fun L : ℝ => L * shiftedPrimeAvoidanceProduct (Real.exp (b*L))) atTop
      (𝓝 (shiftedSieveRatioConstant * Mertens.primeProductLimitConstant/b)) := by
  have he : Tendsto (fun L : ℝ => Real.exp (b*L)) atTop atTop :=
    Real.tendsto_exp_atTop.comp (tendsto_id.const_mul_atTop hb)
  have h := (logarithmic_shifted_prime_avoidance_product_tendsto.comp he).div_const b
  convert h using 1
  ext L
  simp only [Function.comp_apply, Real.log_exp]
  field_simp

theorem shifted_mertens_limit_constant_pos :
    0 < shiftedSieveRatioConstant * Mertens.primeProductLimitConstant :=
  mul_pos (lt_of_lt_of_le zero_lt_one shifted_sieve_ratio_constant_bounds.1)
    Mertens.prime_product_limit_constant_pos

end Bounty
end

section

/- Averaged literal promotion operators with choice-dependent external
residue translations. The external coordinate is summed before comparing
per-choice energies, so its cardinality introduces no loss. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def unrestrictedPromotionExternalAverage
    {A G R : Type*} [Fintype A] [Fintype G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) (Δ D : A → G → ℤ)
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ) (t : G → ℕ) (B : ℕ)
    (π : A → ℝ) (τ : A → R ≃ R)
    (phase : ∀ a, R → UnrestrictedProductPhase n (Δ a) (D a) t B)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → R → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) (r : R) : ℂ :=
  ∑ a, (π a : ℂ) * unrestrictedCoupledCutoffProductOperator n (Δ a) (D a) μ ρ V t B
    (fun s e => if ∃ g, (e g).2.1.Nonempty then phase a r s e else 0) (fun x => f x (τ a r)) s

theorem unrestricted_promotion_external_average_energy_le
    {A G R : Type*} [Fintype A] [Fintype G] [Fintype R] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] (Δ D : A → G → ℤ)
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ) (t : G → ℕ) (B : ℕ)
    (π : A → ℝ) (hπ : ∀ a, 0 ≤ π a) (hπmass : ∑ a, π a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, t g ≤ T)
    (τ : A → R ≃ R)
    (phase : ∀ a, R → UnrestrictedProductPhase n (Δ a) (D a) t B)
    (hphase : ∀ a r s e, ‖phase a r s e‖ ≤ 1)
    {δ : ℝ} (hδ : 0 ≤ δ)
    (hrare : ∀ s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B,
      productTotalMemory s ≤ B →
      (∑ a, if ∃ g, (unrestrictedResidueEligible (n g) (Δ a g) (D a g) (s g).2.2).Nonempty
        then π a else 0) ≤ δ)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → R → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun s => f s r)) :
    (∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fun s => unrestrictedPromotionExternalAverage n Δ D μ ρ V t B π τ phase f s r)) ≤
      δ * unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        ∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
          (fun s => f s r) := by
  let bad : A → ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → Prop :=
    fun a s => productTotalMemory s ≤ B ∧
    ∃ g, (unrestrictedResidueEligible (n g) (Δ a g) (D a g) (s g).2.2).Nonempty
  refine finite_sparse_external_average_energy_le π hπ hπmass
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productMemoryWeight_nonneg μ (fun g => unrestrictedResidueWeight (μ g)) hμ (fun g z => hμ g z.1))
    bad _ ?_ hδ (pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _) ?_ f ?_
  · intro a s r hbad
    by_cases hs : productTotalMemory s ≤ B
    · apply unrestricted_joint_promoting_operator_zero
      intro hg
      exact hbad ⟨hs, hg⟩
    · exact unrestricted_coupled_cutoff_zero_above_cap n (Δ a) (D a) μ ρ V t B _ (fun x => f x (τ a r)) s hs
  · intro s
    by_cases hs : productTotalMemory s ≤ B
    · simpa only [bad, hs, true_and] using hrare s hs
    · simpa only [bad, hs, false_and, if_false, sum_const_zero] using hδ
  · intro a
    calc
      _ ≤ ∑ r, unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
          finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
            (fun s => f s (τ a r)) := by
        apply sum_le_sum
        intro r _
        apply unrestricted_coupled_cutoff_product_energy_le n (Δ a) (D a) μ ρ V t B
          hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht _ _ _ (hf (τ a r))
        intro s e
        split_ifs
        · exact hphase a r s e
        · simp only [norm_zero, zero_le_one]
      _ = _ := by
        rw [← mul_sum, Equiv.sum_comp (τ a)
          (fun r => finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
            (fun s => f s r))]

end Bounty
end

section

/- The normalized reverse slot operator has the same energy constant as
its forward transpose. No additional square of the reversal coefficient
bound is lost when passing to reverse promotion events. -/

open Finset Classical

namespace Bounty

theorem unrestricted_reverse_slot_operator_energy_le {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (Δ D : ℤ) (μ : P → ℝ)
    {ρ V v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : vmin ≤ V) (hVhi : V ≤ vmax)
    (hμ : ∀ p, 0 ≤ μ p) (hmass : ∑ p, μ p ≤ 2)
    (t B T : ℕ) (ht : t ≤ T)
    (w : Finset (Fin t) → Finset (Fin t) → ℂ) (hw : ∀ S T, ‖w S T‖ ≤ 1)
    (f : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
    (hf : BoundedOrderedSymmetric f) :
    finiteWeightedEnergy (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ))
      (unrestrictedSlotOperator n (-Δ) D μ ρ V t B
        (fun S T => ((V ^ T.card / V ^ S.card : ℝ) : ℂ) * w T S) f) ≤
      unrestrictedEdgeEnergyBound ρ v vmin vmax T *
        finiteWeightedEnergy (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ)) f := by
  apply finite_symmetric_transpose_energy_le
    (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ))
    (fun s => boundedOrderedStateWeight_nonneg μ (unrestrictedResidueWeight μ)
      hμ (fun z => hμ z.1) s) BoundedOrderedSymmetric
    (unrestrictedSlotOperator n (-Δ) D μ ρ V t B
      (fun S T => ((V ^ T.card / V ^ S.card : ℝ) : ℂ) * w T S))
    (unrestrictedSlotOperator n Δ D μ ρ V t B w)
  · intro g hg active N q τ
    dsimp only
    rw [hg active N q τ]
  · intro g hg
    exact unrestricted_slot_operator_symmetric n (-Δ) D μ ρ V t B _ g hg
  · intro g h hg hh
    have hp := unrestricted_slot_operator_pairing_reverse n Δ D μ ρ
      (hvmin.trans_le hVlo).ne' t B w h g hh hg
    simpa only [mul_comm, mul_left_comm, mul_assoc] using hp.symm
  · exact unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T
  · intro g hg
    exact unrestricted_bounded_operator_energy_le n Δ D μ hρ0 hρ1 hv hvmin
      hVlo hVhi hμ hmass t B T ht (fun _ S T _ _ => w S T)
      (fun _ S T _ _ => hw S T) g hg
  · exact hf

end Bounty
end

section

/- The storage-only part of the full dirty edge is a difference of two
positive tensor restrictions. Its transpose is the reverse edge with some
promotion and no storage. The event formulas retain both total cutoffs. -/

open Finset Classical

namespace Bounty

theorem finite_transfer_mask_difference {G : Type*} [Fintype G]
    (p q : G → Prop) [DecidablePred p] [DecidablePred q] :
    (∏ g, if p g then (1 : ℝ) else 0) -
      (∏ g, if p g ∧ q g then (1 : ℝ) else 0) =
      if (∀ g, p g) ∧ (∃ g, ¬ q g) then 1 else 0 := by
  simp only [Fintype.prod_ite_zero, prod_const_one]
  have hh : (∀ g, p g ∧ q g) ↔ (∀ g, p g) ∧ (∀ g, q g) := forall_and
  simp only [hh]
  by_cases hp : ∀ g, p g
  · by_cases hq : ∀ g, q g
    · simp [hp, hq]
    · have hq' : ∃ g, ¬ q g := not_forall.mp hq
      simp [hp, hq, hq']
  · simp [hp]

section

variable {G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  (Δ D : G → ℤ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (t : G → ℕ) (B : ℕ)

noncomputable def unrestrictedStorageOnlyProduct :=
  unrestrictedCoupledCutoffProductOperator n Δ D μ ρ V t B
    (fun _ e => if (∀ g, (e g).2.1 = ∅) ∧ (∃ g, (e g).1 ≠ ∅) then 1 else 0)

noncomputable def unrestrictedReversePromotionOnlyProduct :=
  unrestrictedCoupledCutoffProductOperator n (fun g => -Δ g) D μ ρ V t B
    (fun _ e => ((∏ g, V g ^ (e g).2.1.card / V g ^ (e g).1.card : ℝ) : ℂ) *
      (if (∀ g, (e g).1 = ∅) ∧ (∃ g, (e g).2.1 ≠ ∅) then 1 else 0))

/-- Two tensor restrictions differ exactly by the nonempty-storage gate. -/
theorem unrestricted_storage_only_product_difference
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ) :
    unrestrictedStorageOnlyProduct n Δ D μ ρ V t B f =
      fun s => productMemoryCutoff (unrestrictedRealSlotProduct n Δ D μ ρ V t B
          (fun _ _ T => if T = ∅ then 1 else 0) (productMemoryCutoff f)) s -
        productMemoryCutoff (unrestrictedRealSlotProduct n Δ D μ ρ V t B
          (fun _ S T => if T = ∅ ∧ S = ∅ then 1 else 0) (productMemoryCutoff f)) s := by
  rw [unrestricted_real_slot_product_eq_coupled, unrestricted_real_slot_product_eq_coupled]
  funext s
  unfold unrestrictedStorageOnlyProduct unrestrictedCoupledCutoffProductOperator productMemoryCutoff
  split_ifs with hcap
  · simp only [unrestrictedCoupledProductOperator, finiteProductEventAction]
    rw [← sum_sub_distrib]
    apply sum_congr rfl
    intro e he
    have hm := finite_transfer_mask_difference (fun g => (e g).2.1 = ∅)
      (fun g => (e g).1 = ∅)
    have hc := congrArg (fun r : ℝ => (r : ℂ)) hm
    have hcast (p : Prop) [Decidable p] : Complex.ofReal (if p then (1 : ℝ) else 0) =
        if p then (1 : ℂ) else 0 := by split_ifs <;> rfl
    simp only [Complex.ofReal_sub, hcast] at hc
    rw [← sub_mul, ← mul_sub, hc]
  · simp only [sub_self]

theorem unrestricted_reverse_promotion_only_product_difference
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ) :
    unrestrictedReversePromotionOnlyProduct n Δ D μ ρ V t B f =
      fun s => productMemoryCutoff (unrestrictedRealSlotProduct n (fun g => -Δ g) D μ ρ V t B
          (fun g S T => V g ^ T.card / V g ^ S.card * (if S = ∅ then 1 else 0))
          (productMemoryCutoff f)) s -
        productMemoryCutoff (unrestrictedRealSlotProduct n (fun g => -Δ g) D μ ρ V t B
          (fun g S T => V g ^ T.card / V g ^ S.card * (if S = ∅ ∧ T = ∅ then 1 else 0))
          (productMemoryCutoff f)) s := by
  rw [unrestricted_real_slot_product_eq_coupled, unrestricted_real_slot_product_eq_coupled]
  funext s
  unfold unrestrictedReversePromotionOnlyProduct unrestrictedCoupledCutoffProductOperator productMemoryCutoff
  split_ifs with hcap
  · simp only [unrestrictedCoupledProductOperator, finiteProductEventAction]
    rw [← sum_sub_distrib]
    apply sum_congr rfl
    intro e he
    have hm := finite_transfer_mask_difference (fun g => (e g).1 = ∅)
      (fun g => (e g).2.1 = ∅)
    have hc := congrArg (fun r : ℝ => (r : ℂ)) hm
    have hcast (p : Prop) [Decidable p] : Complex.ofReal (if p then (1 : ℝ) else 0) =
        if p then (1 : ℂ) else 0 := by split_ifs <;> rfl
    simp only [Complex.ofReal_sub, hcast] at hc
    simp only [prod_mul_distrib, Complex.ofReal_mul]
    rw [← sub_mul, ← mul_sub, ← mul_sub, hc]
  · simp only [sub_self]

theorem unrestricted_storage_only_product_symmetric
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric (unrestrictedStorageOnlyProduct n Δ D μ ρ V t B f) := by
  rw [unrestricted_storage_only_product_difference]
  have ha := productMemoryCutoff_symmetric _
    (unrestricted_real_slot_product_symmetric n Δ D μ ρ V t B
      (fun _ _ T => if T = ∅ then 1 else 0) (productMemoryCutoff f)
      (productMemoryCutoff_symmetric f hf))
  have hb := productMemoryCutoff_symmetric _
    (unrestricted_real_slot_product_symmetric n Δ D μ ρ V t B
      (fun _ S T => if T = ∅ ∧ S = ∅ then 1 else 0) (productMemoryCutoff f)
      (productMemoryCutoff_symmetric f hf))
  intro x j τ
  dsimp only
  rw [ha x j τ, hb x j τ]

theorem unrestricted_reverse_promotion_only_product_symmetric
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric (unrestrictedReversePromotionOnlyProduct n Δ D μ ρ V t B f) := by
  rw [unrestricted_reverse_promotion_only_product_difference]
  have ha := productMemoryCutoff_symmetric _
    (unrestricted_real_slot_product_symmetric n (fun j => -Δ j) D μ ρ V t B
      (fun j S T => V j ^ T.card / V j ^ S.card * (if S = ∅ then 1 else 0))
      (productMemoryCutoff f) (productMemoryCutoff_symmetric f hf))
  have hb := productMemoryCutoff_symmetric _
    (unrestricted_real_slot_product_symmetric n (fun j => -Δ j) D μ ρ V t B
      (fun j S T => V j ^ T.card / V j ^ S.card * (if S = ∅ ∧ T = ∅ then 1 else 0))
      (productMemoryCutoff f) (productMemoryCutoff_symmetric f hf))
  intro x j τ
  dsimp only
  rw [ha x j τ, hb x j τ]

/-- Full product/factorial-measure storage adjoint with the exact reverse
volume ratio, all group sums, and both total caps. -/
theorem unrestricted_storage_only_product_pairing
    (hV : ∀ g, V g ≠ 0)
    (f g : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) (hg : ProductMemorySymmetric g) :
    (∑ s, (productMemoryWeight μ (fun j => unrestrictedResidueWeight (μ j)) s : ℂ) *
      f s * unrestrictedStorageOnlyProduct n Δ D μ ρ V t B g s) =
    ∑ s, (productMemoryWeight μ (fun j => unrestrictedResidueWeight (μ j)) s : ℂ) *
      unrestrictedReversePromotionOnlyProduct n Δ D μ ρ V t B f s * g s := by
  rw [unrestricted_storage_only_product_difference,
    unrestricted_reverse_promotion_only_product_difference]
  simp only [mul_sub, sub_mul, sum_sub_distrib]
  rw [unrestricted_real_slot_cutoff_pairing n Δ D μ ρ V t B hV
      (fun _ _ T => if T = ∅ then 1 else 0) f g hf hg,
    unrestricted_real_slot_cutoff_pairing n Δ D μ ρ V t B hV
      (fun _ S T => if T = ∅ ∧ S = ∅ then 1 else 0) f g hf hg]

end

end Bounty
end

section

/- Bilinear transposition of a finite external permutation uses its inverse.
The external counting measure is preserved exactly, with no cardinality factor. -/

open Finset Classical

namespace Bounty

theorem finite_external_bilinear_transpose {X R : Type*} [Fintype X] [Fintype R]
    (μ : X → ℝ) (A T : (X → ℂ) → X → ℂ) (τ : R ≃ R)
    (f g : X → R → ℂ)
    (hpair : ∀ r q, (∑ x, (μ x : ℂ) * f x r * A (fun y => g y q) x) =
      ∑ x, (μ x : ℂ) * T (fun y => f y r) x * g x q) :
    (∑ r, ∑ x, (μ x : ℂ) * f x r * A (fun y => g y (τ r)) x) =
      ∑ r, ∑ x, (μ x : ℂ) * T (fun y => f y (τ.symm r)) x * g x r := by
  calc
    _ = ∑ r, ∑ x, (μ x : ℂ) * T (fun y => f y r) x * g x (τ r) := by
      apply sum_congr rfl
      intro r hr
      exact hpair r (τ r)
    _ = _ := by
      simpa only [Equiv.symm_apply_apply] using τ.sum_comp
        (fun r => ∑ x, (μ x : ℂ) * T (fun y => f y (τ.symm r)) x * g x r)

theorem finite_external_fiber_average_pairing {C X R : Type*}
    [Fintype X] [Fintype R] {A : C → Type*} [∀ c, Fintype (A c)]
    (μ : X → ℝ) (ω : ∀ c, A c → ℝ)
    (T U : ∀ c, A c → (X → ℂ) → X → ℂ) (τ : ∀ c, A c → R ≃ R)
    (f g : C → X → R → ℂ) (c : C)
    (hpair : ∀ a r q, (∑ x, (μ x : ℂ) * f c x r * T c a (fun y => g c y q) x) =
      ∑ x, (μ x : ℂ) * U c a (fun y => f c y r) x * g c x q) :
    (∑ r, ∑ x, (μ x : ℂ) * f c x r * finiteExternalFiberAverage ω T τ g c x r) =
      ∑ r, ∑ x, (μ x : ℂ) *
        finiteExternalFiberAverage ω U (fun c a => (τ c a).symm) f c x r * g c x r := by
  unfold finiteExternalFiberAverage
  simp only [mul_sum, sum_mul]
  have hrotate (H : R → X → A c → ℂ) :
      (∑ r, ∑ x, ∑ a, H r x a) = ∑ a, ∑ r, ∑ x, H r x a := by
    calc
      _ = ∑ r, ∑ a, ∑ x, H r x a := by
        apply sum_congr rfl
        intro r hr
        exact sum_comm
      _ = _ := sum_comm
  rw [hrotate, hrotate]
  apply sum_congr rfl
  intro a ha
  have h := congrArg (fun z : ℂ => (ω c a : ℂ) * z)
    (finite_external_bilinear_transpose μ (T c a) (U c a) (τ c a)
      (f c) (g c) (hpair a))
  simpa only [mul_sum, mul_assoc, mul_comm, mul_left_comm] using h

/-- Shared-coordinate reassembly and the auxiliary sum preserve the inverse
external permutation in the exact full-space transpose. -/
theorem equiv_external_fiber_average_pairing {X C Y R : Type*}
    [Fintype X] [Fintype C] [Fintype Y] [Fintype R]
    {A : C → Type*} [∀ c, Fintype (A c)]
    (e : X ≃ C × Y) (W : X → ℝ) (κ : C → ℝ) (μ : Y → ℝ)
    (hW : ∀ c y, W (e.symm (c, y)) = κ c * μ y)
    (ω : ∀ c, A c → ℝ) (T U : ∀ c, A c → (Y → ℂ) → Y → ℂ)
    (τ : ∀ c, A c → R ≃ R) (f g : X → R → ℂ)
    (hpair : ∀ c a r q,
      (∑ y, (μ y : ℂ) * f (e.symm (c, y)) r * T c a (fun z => g (e.symm (c, z)) q) y) =
      ∑ y, (μ y : ℂ) * U c a (fun z => f (e.symm (c, z)) r) y * g (e.symm (c, y)) q) :
    (∑ r, ∑ x, (W x : ℂ) * f x r * equivExternalFiberAverage e ω T τ g x r) =
      ∑ r, ∑ x, (W x : ℂ) *
        equivExternalFiberAverage e ω U (fun c a => (τ c a).symm) f x r * g x r := by
  have hs (u v : X → R → ℂ) :
      (∑ r, ∑ x, (W x : ℂ) * u x r * v x r) =
      ∑ c, (κ c : ℂ) * ∑ r, ∑ y, (μ y : ℂ) * u (e.symm (c, y)) r * v (e.symm (c, y)) r := by
    simp_rw [← e.symm.sum_comp]
    simp only [Fintype.sum_prod_type, hW, Complex.ofReal_mul]
    rw [sum_comm]
    apply sum_congr rfl
    intro c hc
    simp only [mul_sum, mul_assoc]
  rw [hs, hs]
  apply sum_congr rfl
  intro c hc
  congr 1
  have h := finite_external_fiber_average_pairing μ ω T U τ
    (fun c y r => f (e.symm (c, y)) r) (fun c y r => g (e.symm (c, y)) r) c (hpair c)
  simpa only [equivExternalFiberAverage, Equiv.apply_symm_apply] using h

/-- Transfer an energy estimate through an external-coordinate transpose on
conjugation-stable slices. The external coordinate carries counting measure. -/
theorem finite_external_symmetric_transpose_energy_le {X R : Type*}
    [Fintype X] [Fintype R] (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x)
    (S : (X → ℂ) → Prop)
    (A T : (X → R → ℂ) → X → R → ℂ)
    (hconj : ∀ f, S f → S (fun x => (starRingEnd ℂ) (f x)))
    (hA : ∀ f, (∀ r, S (fun x => f x r)) → ∀ r, S (fun x => A f x r))
    (hpair : ∀ f g, (∀ r, S (fun x => f x r)) → (∀ r, S (fun x => g x r)) →
      (∑ r, ∑ x, (μ x : ℂ) * f x r * A g x r) =
        ∑ r, ∑ x, (μ x : ℂ) * T f x r * g x r)
    {K : ℝ} (hK : 0 ≤ K)
    (hT : ∀ f, (∀ r, S (fun x => f x r)) →
      (∑ r, finiteWeightedEnergy μ (fun x => T f x r)) ≤
        K * ∑ r, finiteWeightedEnergy μ (fun x => f x r))
    (f : X → R → ℂ) (hf : ∀ r, S (fun x => f x r)) :
    (∑ r, finiteWeightedEnergy μ (fun x => A f x r)) ≤
      K * ∑ r, finiteWeightedEnergy μ (fun x => f x r) := by
  have h := finite_symmetric_transpose_energy_le (fun z : R × X => μ z.2)
    (fun z => hμ z.2) (fun u : R × X → ℂ => ∀ r, S (fun x => u (r, x)))
    (fun u z => A (fun x r => u (r, x)) z.2 z.1)
    (fun u z => T (fun x r => u (r, x)) z.2 z.1)
    (fun u hu r => hconj (fun x => u (r, x)) (hu r))
    (fun u hu => hA (fun x r => u (r, x)) hu)
    (fun u v hu hv => by
      simpa only [Fintype.sum_prod_type] using hpair
        (fun x r => u (r, x)) (fun x r => v (r, x)) hu hv)
    hK (fun u hu => by
      simpa only [finiteWeightedEnergy, Fintype.sum_prod_type] using
        hT (fun x r => u (r, x)) hu) (fun z => f z.2 z.1) hf
  simpa only [finiteWeightedEnergy, Fintype.sum_prod_type] using h

end Bounty
end

section

/- Exact disintegration of the full event sum into its chosen auxiliary
draws. The law here is independent of retained labels, as in the physical
auxiliary law; no positivity, symmetry or norm bound is needed. -/

open Finset
open scoped Classical

namespace Bounty

theorem full_active_auxiliary_disintegration
    {G A : Type*} [Fintype G] [dG : DecidableEq G] [Fintype A]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (Δ D : SharedActiveLabels P S → A → G → ℤ)
    (ω : A → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (phase : ∀ x, FullActiveEdgeEvent n S B (fun _ => A) Δ D x → ℂ)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    fullActiveCoefficientAction n S B (fun _ => A) Δ D (fun _ a => ω a) μ ρ V phase f x =
      ∑ a, (ω a : ℂ) * fullActiveChosenAuxiliaryAction n S B Δ D μ ρ V a phase f x := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  simp only [fullActiveChosenAuxiliaryAction, fullActiveCoefficientAction, mul_sum]
  rw [sum_comm]
  apply sum_congr rfl
  intro e _
  simp only [fullActiveEdgeEventWeight, Complex.ofReal_mul, apply_ite,
    Complex.ofReal_zero, ite_mul, one_mul, zero_mul, mul_zero]
  simp only [sum_ite_eq, mem_univ, if_true]
  ring

end Bounty
