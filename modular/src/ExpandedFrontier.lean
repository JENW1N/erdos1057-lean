section

/- The empty-memory boundary vector is unchanged by increasing the cap.
All larger-cap vacuum states already occur in the smaller-cap image, so
weighted vacuum pairings agree exactly for arbitrary signed weights. -/

open Finset Classical

namespace Bounty

section

variable {G : Type*} {P Z : G → Type*} {M : G → ℕ} {b B : ℕ} (h : b ≤ B)

theorem fullMemoryVacuum_capEmbed (x : ProductBoundedOrderedState P Z M b) :
    fullMemoryVacuum (productStateCapEmbed h x) = fullMemoryVacuum x := rfl

theorem fullMemoryVacuum_empty_mem_range (y : ProductBoundedOrderedState P Z M B)
    (hy : ∀ g, (y g).2.1.val = 0) :
    y ∈ Set.range (productStateCapEmbed (P := P) (Z := Z) (M := M) h) := by
  refine ⟨fun g => ((y g).1, ⟨⟨(y g).2.1.val, ?_⟩, (y g).2.2⟩), ?_⟩
  · rw [hy g]
    exact Nat.succ_pos b
  · funext g
    rfl

theorem fullMemoryVacuum_ne_zero_mem_range (y : ProductBoundedOrderedState P Z M B)
    (hy : fullMemoryVacuum y ≠ 0) :
    y ∈ Set.range (productStateCapEmbed (P := P) (Z := Z) (M := M) h) := by
  apply fullMemoryVacuum_empty_mem_range h y
  by_contra hempty
  exact hy (if_neg hempty)

theorem fullMemoryVacuum_eq_zero_of_not_mem_range (y : ProductBoundedOrderedState P Z M B)
    (hy : y ∉ Set.range (productStateCapEmbed (P := P) (Z := Z) (M := M) h)) :
    fullMemoryVacuum y = 0 := by
  by_contra hvac
  exact hy (fullMemoryVacuum_ne_zero_mem_range h y hvac)

theorem full_memory_vacuum_pairing_cap [Fintype G] [DecidableEq G]
    [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (F : ProductBoundedOrderedState P Z M B → ℂ) :
    (∑ y : ProductBoundedOrderedState P Z M B,
      (productMemoryWeight μ ν y : ℂ) * fullMemoryVacuum y * F y) =
    ∑ x : ProductBoundedOrderedState P Z M b,
      (productMemoryWeight μ ν x : ℂ) * fullMemoryVacuum x * F (productStateCapEmbed h x) := by
  symm
  apply Fintype.sum_of_injective (productStateCapEmbed h) (productStateCapEmbed_injective h)
  · intro y hy
    rw [fullMemoryVacuum_eq_zero_of_not_mem_range h y hy, mul_zero, zero_mul]
  · intro x
    rw [productStateCapEmbed_weight, fullMemoryVacuum_capEmbed]

end

end Bounty
end

section

/- Dyadic conductor ranges above an exponential cutoff. -/

open Finset Filter

namespace Bounty

theorem dyadicConductorRange_scale_bounds (c L : ℝ) (N h k : ℕ)
    (hk : k ∈ dyadicNatIndices
      (Icc (max 2 (⌊Real.exp (c * L / 512)⌋₊ + 1)) (N / h))) :
    Real.exp (c * L / 512) < (2 : ℝ) ^ (k + 1) ∧
      (2 : ℝ) ^ (k + 1) ≤ 2 * (N : ℝ) ∧
      1 ≤ (2 : ℝ) ^ (k + 1) := by
  obtain ⟨f, hf⟩ := (dyadicNatBucket_nonempty_iff _ k).mpr hk
  have hfmem := (mem_dyadicNatBucket _ k f).mp hf
  have hfI := mem_Icc.mp hfmem.1
  have hf2 : 2 ≤ f := (le_max_left _ _).trans hfI.1
  have hfloor : ⌊Real.exp (c * L / 512)⌋₊ < f := by
    have := (le_max_right _ _).trans hfI.1
    omega
  have hexpf : Real.exp (c * L / 512) < (f : ℝ) :=
    (Nat.floor_lt (Real.exp_pos _).le).mp hfloor
  have hsc := dyadicNatBucket_upper_scale_real _
    (fun n hn => by have := (le_max_left _ _).trans (mem_Icc.mp hn).1; omega) hf
  have hfN : f ≤ N := hfI.2.trans (Nat.div_le_self _ _)
  have hfNreal : (f : ℝ) ≤ N := by exact_mod_cast hfN
  have hf2real : (2 : ℝ) ≤ f := by exact_mod_cast hf2
  exact ⟨hexpf.trans_le hsc.1, hsc.2.trans (by linarith), by linarith [hsc.1]⟩

theorem eventually_two_mul_exp_le_exp {a b : ℝ} (hab : a < b) :
    ∀ᶠ L : ℝ in atTop, 2 * Real.exp (a * L) ≤ Real.exp (b * L) := by
  filter_upwards [eventually_ge_atTop (Real.log 2 / (b - a))] with L hL
  have hlog : Real.log 2 ≤ L * (b - a) :=
    (div_le_iff₀ (sub_pos.mpr hab)).mp hL
  calc
    2 * Real.exp (a * L) = Real.exp (Real.log 2 + a * L) := by
      rw [Real.exp_add, Real.exp_log (by norm_num : (0 : ℝ) < 2)]
    _ ≤ Real.exp (b * L) := Real.exp_le_exp.mpr (by nlinarith)

theorem eventually_dyadicConductorRange_scale_bounds (c : ℝ) {θ : ℝ}
    (hθ : θ < 1 / 2) :
    ∀ᶠ L : ℝ in atTop, ∀ (N h k : ℕ), (N : ℝ) ≤ Real.exp (θ * L) →
      k ∈ dyadicNatIndices
        (Icc (max 2 (⌊Real.exp (c * L / 512)⌋₊ + 1)) (N / h)) →
      Real.exp (c * L / 512) ≤ (2 : ℝ) ^ (k + 1) ∧
        (2 : ℝ) ^ (k + 1) ≤ Real.exp (((θ + 1 / 2) / 2) * L) ∧
        1 ≤ (2 : ℝ) ^ (k + 1) := by
  have hmid : θ < (θ + 1 / 2) / 2 := by linarith
  filter_upwards [eventually_two_mul_exp_le_exp hmid] with L hL
  intro N h k hN hk
  obtain ⟨hlow, hupp, hone⟩ := dyadicConductorRange_scale_bounds c L N h k hk
  exact ⟨hlow.le, hupp.trans ((mul_le_mul_of_nonneg_left hN (by norm_num)).trans hL),
    hone⟩

theorem eventually_dyadicConductorRange_card_le_linear (c : ℝ) {θ : ℝ}
    (hθ : θ < 1 / 2) :
    ∀ᶠ L : ℝ in atTop, ∀ (N h : ℕ), (N : ℝ) ≤ Real.exp (θ * L) →
      ((dyadicNatIndices
        (Icc (max 2 (⌊Real.exp (c * L / 512)⌋₊ + 1)) (N / h))).card : ℝ) ≤
        (2 / Real.log 2 + 1) * L := by
  filter_upwards [eventually_dyadicNatIndices_card_le_linear,
    eventually_ge_atTop (0 : ℝ)] with L hcount hL
  intro N h hN
  apply hcount N
  · calc
      (N : ℝ) ≤ Real.exp (θ * L) := hN
      _ ≤ Real.exp L := Real.exp_le_exp.mpr (by nlinarith)
      _ ≤ 16 * Real.exp L := by nlinarith [Real.exp_pos L]
  · intro n hn
    exact (mem_Icc.mp hn).2.trans (Nat.div_le_self _ _)

theorem three_dyadic_counts_totient_factor_le_pow_five {L x y z : ℝ}
    (hL : 1 ≤ L) (hlog : Real.log 2 ≤ L)
    (hlarge : 4 * primeEulerProductUpperConstant * (2 / Real.log 2 + 1) ^ 3 ≤ L)
    (hx0 : 0 ≤ x) (hy0 : 0 ≤ y) (hz0 : 0 ≤ z)
    (hx : x ≤ (2 / Real.log 2 + 1) * L)
    (hy : y ≤ (2 / Real.log 2 + 1) * L)
    (hz : z ≤ (2 / Real.log 2 + 1) * L) :
    (2 * primeEulerProductUpperConstant * Real.log (2 * Real.exp L)) * x * y * z ≤
      L ^ 5 := by
  have hL0 : 0 ≤ L := by linarith
  have hC := primeEulerProductUpperConstant_pos
  have htwo : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hxyz : x * y * z ≤
      ((2 / Real.log 2 + 1) * L) * ((2 / Real.log 2 + 1) * L) *
        ((2 / Real.log 2 + 1) * L) := by
    gcongr
  have hfactor : 2 * primeEulerProductUpperConstant * Real.log (2 * Real.exp L) ≤
      4 * primeEulerProductUpperConstant * L := by
    rw [Real.log_mul (by norm_num) (Real.exp_pos L).ne', Real.log_exp]
    nlinarith
  calc
    _ = (2 * primeEulerProductUpperConstant * Real.log (2 * Real.exp L)) *
        (x * y * z) := by ring
    _ ≤ (4 * primeEulerProductUpperConstant * L) *
        (((2 / Real.log 2 + 1) * L) * ((2 / Real.log 2 + 1) * L) *
          ((2 / Real.log 2 + 1) * L)) :=
      mul_le_mul hfactor hxyz (mul_nonneg (mul_nonneg hx0 hy0) hz0) (by positivity)
    _ = (4 * primeEulerProductUpperConstant * (2 / Real.log 2 + 1) ^ 3) *
        L ^ 4 := by ring
    _ ≤ L * L ^ 4 := mul_le_mul_of_nonneg_right hlarge (pow_nonneg hL0 _)
    _ = L ^ 5 := by ring

theorem eventually_three_dyadic_counts_totient_factor_le_pow_five :
    ∀ᶠ L : ℝ in atTop, 0 < L ∧ ∀ x y z : ℝ,
      0 ≤ x → 0 ≤ y → 0 ≤ z →
      x ≤ (2 / Real.log 2 + 1) * L →
      y ≤ (2 / Real.log 2 + 1) * L →
      z ≤ (2 / Real.log 2 + 1) * L →
      (2 * primeEulerProductUpperConstant * Real.log (2 * Real.exp L)) * x * y * z ≤
        L ^ 5 := by
  filter_upwards [eventually_ge_atTop (1 : ℝ), eventually_ge_atTop (Real.log 2),
    eventually_ge_atTop (4 * primeEulerProductUpperConstant *
      (2 / Real.log 2 + 1) ^ 3)] with L hL hlog hlarge
  exact ⟨by linarith, fun _ _ _ hx0 hy0 hz0 hx hy hz =>
    three_dyadic_counts_totient_factor_le_pow_five hL hlog hlarge hx0 hy0 hz0 hx hy hz⟩


end Bounty
end

section

/- A power saving for the triangular Mangoldt sum from the zero-free input. -/

namespace Bounty

open OAI.Ostmann Complex Set

/-- The finite contour argument gives a uniform smoothed estimate, with only
logarithmic dependence on the conductor. It assumes only the zero-free input. -/
theorem character_riesz_bound_right_of (b σ : ℝ) (hb : 7 / 8 ≤ b)
    (hbσ : b < σ) (hσ1 : σ < 1) (hZ : PrimitiveZeroFreeRightOf b) :
    ∃ D : ℝ, 0 < D ∧ ∀ (χ : PrimitiveComplexCharacter) (x : ℝ), 2 ≤ x →
      ‖characterRieszMean χ x‖ ≤ D * x ^ σ *
        (1 + Real.log (24 * (χ.modulus : ℝ) * (x ^ 2 + 2))) := by
  obtain ⟨K, C, hK, hC, hrect⟩ := characterRieszMean_rectangle_bound
  refine ⟨(K + 5 + 2 * C) * (36 / (σ - b) ^ 2), by positivity, ?_⟩
  intro χ x hx
  let L : ℝ := 1 + Real.log (24 * (χ.modulus : ℝ) * (x ^ 2 + 2))
  let M : ℝ := (36 / (σ - b) ^ 2) * L
  have hx0 : 0 < x := by linarith
  have hq : (1 : ℝ) ≤ χ.modulus := by exact_mod_cast χ.positive
  have hq0 : (0 : ℝ) < χ.modulus := by linarith
  have hx2 : 1 ≤ x ^ 2 := by nlinarith
  have hL : 1 ≤ L := by
    have hh : 1 ≤ 24 * (χ.modulus : ℝ) * (x ^ 2 + 2) := by nlinarith
    have hl := Real.log_nonneg hh
    dsimp [L]
    linarith
  have hmargin : 0 < σ - b := sub_pos.mpr hbσ
  have hmargin1 : σ - b ≤ 1 := by linarith
  have hfactor : 1 ≤ 36 / (σ - b) ^ 2 := by
    apply (le_div_iff₀ (sq_pos_of_pos hmargin)).mpr
    nlinarith
  have hM : 1 ≤ M := by dsimp [M]; nlinarith
  have hzre (z : ℂ) (hz : z ∈ uIcc σ 2 ×ℂ uIcc (-x ^ 2) (x ^ 2)) :
      σ ≤ z.re ∧ z.re ≤ 2 ∧ |z.im| ≤ x ^ 2 := by
    have hz' : z.re ∈ Icc σ 2 ∧ z.im ∈ Icc (-x ^ 2) (x ^ 2) := by
      simpa only [mem_reProdIm, uIcc_of_le (by linarith : σ ≤ 2),
        uIcc_of_le (by nlinarith : -x ^ 2 ≤ x ^ 2)] using hz
    exact ⟨hz'.1.1, hz'.1.2, abs_le.mpr hz'.2⟩
  have hne : ∀ z ∈ uIcc σ 2 ×ℂ uIcc (-x ^ 2) (x ^ 2), χ.L z ≠ 0 := by
    intro z hz
    apply hZ χ z
    linarith [(hzre z hz).1]
  have hbound : ∀ z ∈ uIcc σ 2 ×ℂ uIcc (-x ^ 2) (x ^ 2),
      ‖logDeriv χ.L z‖ ≤ M := by
    intro z hz
    obtain ⟨hzlo, hzhi, hzim⟩ := hzre z hz
    have hh := character_logDeriv_bound_right_of b hb (by linarith) hZ χ
      (ε := σ - b) hmargin hmargin1 z (by linarith) hzhi
    have hl : Real.log (24 * (χ.modulus : ℝ) * (|z.im| + 2)) ≤ L := by
      have hhlog : Real.log (24 * (χ.modulus : ℝ) * (|z.im| + 2)) ≤
          Real.log (24 * (χ.modulus : ℝ) * (x ^ 2 + 2)) := by
        apply Real.log_le_log (by positivity)
        gcongr
      dsimp [L]
      linarith
    dsimp [M]
    exact hh.trans (mul_le_mul_of_nonneg_left hl (by positivity))
  have hraw := hrect χ x σ 2 (x ^ 2) M (by linarith) (by linarith)
    (by linarith) (by norm_num) le_rfl (by positivity) (by linarith) hne hbound
  rw [Real.rpow_two] at hraw
  have hx24 : x ^ 2 ≤ (x ^ 2) ^ 2 := by nlinarith [sq_nonneg (x ^ 2 - 1)]
  have hquot : M * x ^ 2 / (x ^ 2) ^ 2 ≤ M := by
    apply (div_le_iff₀ (by positivity : 0 < (x ^ 2) ^ 2)).mpr
    exact mul_le_mul_of_nonneg_left hx24 (by linarith)
  have hquot0 : 0 ≤ M * x ^ 2 / (x ^ 2) ^ 2 := by positivity
  have herr : 2 * (M * x ^ 2 / (x ^ 2) ^ 2) * (2 - σ) ≤ 3 * M := by
    nlinarith
  have htail : 2 * (1 / (2 - 1) + C) * x ^ 2 / x ^ 2 = 2 * (1 + C) := by
    field_simp
    ring
  rw [htail] at hraw
  have hp : 1 ≤ x ^ σ := Real.one_le_rpow (by linarith) (by linarith)
  have hscale : M ≤ M * x ^ σ := by nlinarith
  have hone : 1 ≤ M * x ^ σ := by nlinarith
  calc
    _ ≤ K * M * x ^ σ + 3 * M + 2 * (1 + C) := by linarith
    _ ≤ K * M * x ^ σ + 3 * (M * x ^ σ) +
        2 * (1 + C) * (M * x ^ σ) := by
      apply add_le_add
      · exact add_le_add le_rfl (mul_le_mul_of_nonneg_left hscale (show (0 : ℝ) ≤ 3 by norm_num))
      · simpa only [mul_one] using
          mul_le_mul_of_nonneg_left hone (show 0 ≤ 2 * (1 + C) by positivity)
    _ = _ := by dsimp [M, L]; ring


end Bounty
end

section

/- Exact subset and complement disintegration of dependent finite products. -/

open scoped BigOperators Classical

namespace Bounty

def finiteSubsetSplitEquiv {I : Type*} [DecidableEq I] {X : I → Type*} (s : Finset I) :
    (∀ i, X i) ≃ ((∀ i : s, X i.1) × (∀ i : {i // i ∉ s}, X i.1)) :=
  Equiv.piEquivPiSubtypeProd (fun i => i ∈ s) X

def finiteSubsetFill {I : Type*} [DecidableEq I] {X : I → Type*} (s : Finset I)
    (a : ∀ i : s, X i.1) (b : ∀ i : {i // i ∉ s}, X i.1) : ∀ i, X i :=
  (finiteSubsetSplitEquiv s).symm (a, b)

theorem finite_subset_split_fst {I : Type*} [DecidableEq I] {X : I → Type*}
    (s : Finset I) (x : ∀ i, X i) :
    (finiteSubsetSplitEquiv s x).1 = finiteCoordinateRestrict s x := rfl

theorem finite_subset_split_snd {I : Type*} [DecidableEq I] {X : I → Type*}
    (s : Finset I) (x : ∀ i, X i) :
    (finiteSubsetSplitEquiv s x).2 = (fun i : {i // i ∉ s} => x i.1) := rfl

theorem finite_subset_fill_mem {I : Type*} [DecidableEq I] {X : I → Type*}
    (s : Finset I) (a : ∀ i : s, X i.1) (b : ∀ i : {i // i ∉ s}, X i.1)
    (i : I) (hi : i ∈ s) : finiteSubsetFill s a b i = a ⟨i, hi⟩ := by
  simp only [finiteSubsetFill, finiteSubsetSplitEquiv, Equiv.piEquivPiSubtypeProd,
    Equiv.coe_fn_symm_mk, dif_pos hi]

theorem finite_subset_fill_not_mem {I : Type*} [DecidableEq I] {X : I → Type*}
    (s : Finset I) (a : ∀ i : s, X i.1) (b : ∀ i : {i // i ∉ s}, X i.1)
    (i : I) (hi : i ∉ s) : finiteSubsetFill s a b i = b ⟨i, hi⟩ := by
  simp only [finiteSubsetFill, finiteSubsetSplitEquiv, Equiv.piEquivPiSubtypeProd,
    Equiv.coe_fn_symm_mk, dif_neg hi]

theorem finite_subset_fill_left {I : Type*} [DecidableEq I] {X : I → Type*}
    (s : Finset I) (a : ∀ i : s, X i.1) (b : ∀ i : {i // i ∉ s}, X i.1) :
    finiteCoordinateRestrict s (finiteSubsetFill s a b) = a :=
  congrArg Prod.fst ((finiteSubsetSplitEquiv s).apply_symm_apply (a, b))

theorem finite_subset_fill_right {I : Type*} [DecidableEq I] {X : I → Type*}
    (s : Finset I) (a : ∀ i : s, X i.1) (b : ∀ i : {i // i ∉ s}, X i.1) :
    (fun i : {i // i ∉ s} => finiteSubsetFill s a b i.1) = b :=
  congrArg Prod.snd ((finiteSubsetSplitEquiv s).apply_symm_apply (a, b))

theorem finite_subset_fill_restrict {I : Type*} [DecidableEq I] {X : I → Type*}
    (s : Finset I) (x : ∀ i, X i) :
    finiteSubsetFill s (finiteCoordinateRestrict s x) (fun i => x i.1) = x :=
  (finiteSubsetSplitEquiv s).symm_apply_apply x

theorem finite_product_value_subset_split {I M : Type*} [Fintype I] [DecidableEq I]
    [CommMonoid M] {X : I → Type*} (v : ∀ i, X i → M) (s : Finset I) (x : ∀ i, X i) :
    (∏ i, v i (x i)) =
      (∏ i : s, v i.1 (x i.1)) * ∏ i : {i // i ∉ s}, v i.1 (x i.1) := by
  convert (Fintype.prod_subtype_mul_prod_subtype (fun i => i ∈ s)
    (fun i => v i (x i))).symm using 1
  congr 3
  exact Subsingleton.elim _ _

theorem finite_product_weight_subset_split {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} (μ : ∀ i, X i → ℝ) (s : Finset I) (x : ∀ i, X i) :
    finiteProductWeight μ x =
      finiteProductWeight (fun i : s => μ i.1) (finiteCoordinateRestrict s x) *
        finiteProductWeight (fun i : {i // i ∉ s} => μ i.1) (fun i => x i.1) :=
  finite_product_value_subset_split μ s x

theorem finite_product_weight_subset_fill {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} (μ : ∀ i, X i → ℝ) (s : Finset I)
    (a : ∀ i : s, X i.1) (b : ∀ i : {i // i ∉ s}, X i.1) :
    finiteProductWeight μ (finiteSubsetFill s a b) =
      finiteProductWeight (fun i : s => μ i.1) a *
        finiteProductWeight (fun i : {i // i ∉ s} => μ i.1) b := by
  rw [finite_product_weight_subset_split μ s, finite_subset_fill_left, finite_subset_fill_right]

theorem finite_sum_subset_split {I M : Type*} [Fintype I] [DecidableEq I]
    [AddCommMonoid M] {X : I → Type*} [∀ i, Fintype (X i)]
    (s : Finset I) (f : (∀ i, X i) → M) :
    (∑ x, f x) = ∑ a : (∀ i : s, X i.1), ∑ b : (∀ i : {i // i ∉ s}, X i.1),
      f (finiteSubsetFill s a b) := by
  rw [← (finiteSubsetSplitEquiv (X := X) s).symm.sum_comp f, Fintype.sum_prod_type]
  rfl

theorem finite_product_expectation_subset_split {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (s : Finset I) (f : (∀ i, X i) → ℂ) :
    (∑ x, (finiteProductWeight μ x : ℂ) * f x) =
      ∑ a : (∀ i : s, X i.1), (finiteProductWeight (fun i : s => μ i.1) a : ℂ) *
        ∑ b : (∀ i : {i // i ∉ s}, X i.1),
          (finiteProductWeight (fun i : {i // i ∉ s} => μ i.1) b : ℂ) *
            f (finiteSubsetFill s a b) := by
  rw [finite_sum_subset_split s]
  simp only [finite_product_weight_subset_fill, Complex.ofReal_mul, Finset.mul_sum, mul_assoc]

theorem finite_product_real_expectation_subset_split {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (s : Finset I) (f : (∀ i, X i) → ℝ) :
    (∑ x, finiteProductWeight μ x * f x) =
      ∑ a : (∀ i : s, X i.1), finiteProductWeight (fun i : s => μ i.1) a *
        ∑ b : (∀ i : {i // i ∉ s}, X i.1),
          finiteProductWeight (fun i : {i // i ∉ s} => μ i.1) b *
            f (finiteSubsetFill s a b) := by
  rw [finite_sum_subset_split s]
  simp only [finite_product_weight_subset_fill, Finset.mul_sum, mul_assoc]

theorem finite_product_energy_subset_split {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (s : Finset I) (f : (∀ i, X i) → ℂ) :
    finiteWeightedEnergy (finiteProductWeight μ) f =
      ∑ a : (∀ i : s, X i.1), finiteProductWeight (fun i : s => μ i.1) a *
        finiteWeightedEnergy (finiteProductWeight (fun i : {i // i ∉ s} => μ i.1))
          (fun b => f (finiteSubsetFill s a b)) :=
  finite_product_real_expectation_subset_split μ s (fun x => ‖f x‖ ^ 2)

end Bounty
end

section

/- Exact four-way disintegration into specified disjoint coordinate sets. -/

open Finset
open scoped BigOperators Classical

namespace Bounty

variable {I : Type*} [Fintype I] [DecidableEq I] {X : I → Type*}

theorem finite_active_four_partition (active A B : Finset I)
    (hA : A ⊆ active) (hB : B ⊆ active) (hAB : Disjoint A B) :
    Disjoint (active \ (A ∪ B)) A ∧
    Disjoint (active \ (A ∪ B)) B ∧
    Disjoint (active \ (A ∪ B)) activeᶜ ∧
    Disjoint A B ∧ Disjoint A activeᶜ ∧ Disjoint B activeᶜ ∧
    (active \ (A ∪ B)) ∪ A ∪ B ∪ activeᶜ = univ := by
  refine ⟨?_, ?_, ?_, hAB, ?_, ?_, ?_⟩
  · exact disjoint_left.mpr (fun i hi ha => (mem_sdiff.mp hi).2 (mem_union_left B ha))
  · exact disjoint_left.mpr (fun i hi hb => (mem_sdiff.mp hi).2 (mem_union_right A hb))
  · exact disjoint_left.mpr (fun i hi ht => (mem_compl.mp ht) (mem_sdiff.mp hi).1)
  · exact disjoint_left.mpr (fun i hi ht => (mem_compl.mp ht) (hA hi))
  · exact disjoint_left.mpr (fun i hi ht => (mem_compl.mp ht) (hB hi))
  · ext i
    by_cases hi : i ∈ active <;> by_cases hiA : i ∈ A <;> by_cases hiB : i ∈ B <;>
      simp [hi, hiA, hiB]

def finiteFourPartitionFill (S A B T : Finset I) (hcover : S ∪ A ∪ B ∪ T = univ)
    (s : ∀ i : S, X i.1) (a : ∀ i : A, X i.1)
    (b : ∀ i : B, X i.1) (t : ∀ i : T, X i.1) (i : I) : X i :=
  if hiS : i ∈ S then s ⟨i, hiS⟩ else
  if hiA : i ∈ A then a ⟨i, hiA⟩ else
  if hiB : i ∈ B then b ⟨i, hiB⟩ else
  t ⟨i, by
    have hi : i ∈ S ∪ A ∪ B ∪ T := by rw [hcover]; exact mem_univ i
    simpa only [mem_union, hiS, hiA, hiB, false_or] using hi⟩

theorem finite_four_partition_fill_s (S A B T : Finset I) (hcover : S ∪ A ∪ B ∪ T = univ)
    (s : ∀ i : S, X i.1) (a : ∀ i : A, X i.1)
    (b : ∀ i : B, X i.1) (t : ∀ i : T, X i.1) :
    finiteCoordinateRestrict S (finiteFourPartitionFill S A B T hcover s a b t) = s := by
  funext i
  simp only [finiteCoordinateRestrict, finiteFourPartitionFill, dif_pos i.property]

theorem finite_four_partition_fill_a (S A B T : Finset I) (hcover : S ∪ A ∪ B ∪ T = univ)
    (hSA : Disjoint S A) (s : ∀ i : S, X i.1) (a : ∀ i : A, X i.1)
    (b : ∀ i : B, X i.1) (t : ∀ i : T, X i.1) :
    finiteCoordinateRestrict A (finiteFourPartitionFill S A B T hcover s a b t) = a := by
  funext i
  have hiS : i.1 ∉ S := fun hi => disjoint_left.mp hSA hi i.property
  simp only [finiteCoordinateRestrict, finiteFourPartitionFill, dif_neg hiS, dif_pos i.property]

theorem finite_four_partition_fill_b (S A B T : Finset I) (hcover : S ∪ A ∪ B ∪ T = univ)
    (hSB : Disjoint S B) (hAB : Disjoint A B)
    (s : ∀ i : S, X i.1) (a : ∀ i : A, X i.1)
    (b : ∀ i : B, X i.1) (t : ∀ i : T, X i.1) :
    finiteCoordinateRestrict B (finiteFourPartitionFill S A B T hcover s a b t) = b := by
  funext i
  have hiS : i.1 ∉ S := fun hi => disjoint_left.mp hSB hi i.property
  have hiA : i.1 ∉ A := fun hi => disjoint_left.mp hAB hi i.property
  simp only [finiteCoordinateRestrict, finiteFourPartitionFill, dif_neg hiS, dif_neg hiA,
    dif_pos i.property]

theorem finite_four_partition_fill_t (S A B T : Finset I) (hcover : S ∪ A ∪ B ∪ T = univ)
    (hST : Disjoint S T) (hAT : Disjoint A T) (hBT : Disjoint B T)
    (s : ∀ i : S, X i.1) (a : ∀ i : A, X i.1)
    (b : ∀ i : B, X i.1) (t : ∀ i : T, X i.1) :
    finiteCoordinateRestrict T (finiteFourPartitionFill S A B T hcover s a b t) = t := by
  funext i
  have hiS : i.1 ∉ S := fun hi => disjoint_left.mp hST hi i.property
  have hiA : i.1 ∉ A := fun hi => disjoint_left.mp hAT hi i.property
  have hiB : i.1 ∉ B := fun hi => disjoint_left.mp hBT hi i.property
  simp only [finiteCoordinateRestrict, finiteFourPartitionFill, dif_neg hiS, dif_neg hiA,
    dif_neg hiB]

def finiteFourPartitionEquiv (S A B T : Finset I)
    (hSA : Disjoint S A) (hSB : Disjoint S B) (hST : Disjoint S T)
    (hAB : Disjoint A B) (hAT : Disjoint A T) (hBT : Disjoint B T)
    (hcover : S ∪ A ∪ B ∪ T = univ) :
    (∀ i, X i) ≃ ((∀ i : S, X i.1) × (∀ i : A, X i.1) ×
      (∀ i : B, X i.1) × (∀ i : T, X i.1)) where
  toFun x := (finiteCoordinateRestrict S x, finiteCoordinateRestrict A x,
    finiteCoordinateRestrict B x, finiteCoordinateRestrict T x)
  invFun q := finiteFourPartitionFill S A B T hcover q.1 q.2.1 q.2.2.1 q.2.2.2
  left_inv x := by
    funext i
    unfold finiteFourPartitionFill
    dsimp only
    split_ifs <;> rfl
  right_inv q := by
    rcases q with ⟨s, a, b, t⟩
    simp only [finite_four_partition_fill_s, finite_four_partition_fill_a S A B T hcover hSA,
      finite_four_partition_fill_b S A B T hcover hSB hAB,
      finite_four_partition_fill_t S A B T hcover hST hAT hBT]

theorem finite_four_partition_fill_restrict (S A B T : Finset I)
    (hcover : S ∪ A ∪ B ∪ T = univ) (x : ∀ i, X i) :
    finiteFourPartitionFill S A B T hcover (finiteCoordinateRestrict S x)
      (finiteCoordinateRestrict A x) (finiteCoordinateRestrict B x)
      (finiteCoordinateRestrict T x) = x := by
  funext i
  unfold finiteFourPartitionFill
  split_ifs <;> rfl

theorem finite_product_value_four_partition {M : Type*} [CommMonoid M]
    (v : ∀ i, X i → M) (S A B T : Finset I)
    (hSA : Disjoint S A) (hSB : Disjoint S B) (hST : Disjoint S T)
    (hAB : Disjoint A B) (hAT : Disjoint A T) (hBT : Disjoint B T)
    (hcover : S ∪ A ∪ B ∪ T = univ) (x : ∀ i, X i) :
    (∏ i, v i (x i)) = (∏ i : S, v i.1 (x i.1)) * (∏ i : A, v i.1 (x i.1)) *
      (∏ i : B, v i.1 (x i.1)) * ∏ i : T, v i.1 (x i.1) := by
  rw [prod_coe_sort S (fun i => v i (x i)), prod_coe_sort A (fun i => v i (x i)),
    prod_coe_sort B (fun i => v i (x i)), prod_coe_sort T (fun i => v i (x i))]
  rw [← hcover, prod_union (disjoint_union_left.mpr
    ⟨disjoint_union_left.mpr ⟨hST, hAT⟩, hBT⟩),
    prod_union (disjoint_union_left.mpr ⟨hSB, hAB⟩), prod_union hSA]

theorem finite_product_weight_four_partition (μ : ∀ i, X i → ℝ) (S A B T : Finset I)
    (hSA : Disjoint S A) (hSB : Disjoint S B) (hST : Disjoint S T)
    (hAB : Disjoint A B) (hAT : Disjoint A T) (hBT : Disjoint B T)
    (hcover : S ∪ A ∪ B ∪ T = univ) (x : ∀ i, X i) :
    finiteProductWeight μ x =
      finiteProductWeight (fun i : S => μ i.1) (finiteCoordinateRestrict S x) *
      finiteProductWeight (fun i : A => μ i.1) (finiteCoordinateRestrict A x) *
      finiteProductWeight (fun i : B => μ i.1) (finiteCoordinateRestrict B x) *
      finiteProductWeight (fun i : T => μ i.1) (finiteCoordinateRestrict T x) :=
  finite_product_value_four_partition μ S A B T hSA hSB hST hAB hAT hBT hcover x

theorem finite_product_weight_four_fill (μ : ∀ i, X i → ℝ) (S A B T : Finset I)
    (hSA : Disjoint S A) (hSB : Disjoint S B) (hST : Disjoint S T)
    (hAB : Disjoint A B) (hAT : Disjoint A T) (hBT : Disjoint B T)
    (hcover : S ∪ A ∪ B ∪ T = univ)
    (s : ∀ i : S, X i.1) (a : ∀ i : A, X i.1)
    (b : ∀ i : B, X i.1) (t : ∀ i : T, X i.1) :
    finiteProductWeight μ (finiteFourPartitionFill S A B T hcover s a b t) =
      finiteProductWeight (fun i : S => μ i.1) s *
      finiteProductWeight (fun i : A => μ i.1) a *
      finiteProductWeight (fun i : B => μ i.1) b *
      finiteProductWeight (fun i : T => μ i.1) t := by
  rw [finite_product_weight_four_partition μ S A B T hSA hSB hST hAB hAT hBT hcover,
    finite_four_partition_fill_s, finite_four_partition_fill_a S A B T hcover hSA,
    finite_four_partition_fill_b S A B T hcover hSB hAB,
    finite_four_partition_fill_t S A B T hcover hST hAT hBT]

variable [∀ i, Fintype (X i)]

theorem finite_sum_four_partition {M : Type*} [AddCommMonoid M]
    (S A B T : Finset I)
    (hSA : Disjoint S A) (hSB : Disjoint S B) (hST : Disjoint S T)
    (hAB : Disjoint A B) (hAT : Disjoint A T) (hBT : Disjoint B T)
    (hcover : S ∪ A ∪ B ∪ T = univ) (f : (∀ i, X i) → M) :
    (∑ x, f x) = ∑ s : (∀ i : S, X i.1), ∑ a : (∀ i : A, X i.1),
      ∑ b : (∀ i : B, X i.1), ∑ t : (∀ i : T, X i.1),
        f (finiteFourPartitionFill S A B T hcover s a b t) := by
  have h := ((finiteFourPartitionEquiv (X := X) S A B T
    hSA hSB hST hAB hAT hBT hcover).symm.sum_comp f).symm
  simpa only [Fintype.sum_prod_type, finiteFourPartitionEquiv, Equiv.coe_fn_symm_mk] using h

theorem finite_product_expectation_four_partition (μ : ∀ i, X i → ℝ) (S A B T : Finset I)
    (hSA : Disjoint S A) (hSB : Disjoint S B) (hST : Disjoint S T)
    (hAB : Disjoint A B) (hAT : Disjoint A T) (hBT : Disjoint B T)
    (hcover : S ∪ A ∪ B ∪ T = univ) (f : (∀ i, X i) → ℂ) :
    (∑ x, (finiteProductWeight μ x : ℂ) * f x) =
      ∑ s : (∀ i : S, X i.1), (finiteProductWeight (fun i : S => μ i.1) s : ℂ) *
      ∑ a : (∀ i : A, X i.1), (finiteProductWeight (fun i : A => μ i.1) a : ℂ) *
      ∑ b : (∀ i : B, X i.1), (finiteProductWeight (fun i : B => μ i.1) b : ℂ) *
      ∑ t : (∀ i : T, X i.1), (finiteProductWeight (fun i : T => μ i.1) t : ℂ) *
        f (finiteFourPartitionFill S A B T hcover s a b t) := by
  rw [finite_sum_four_partition S A B T hSA hSB hST hAB hAT hBT hcover]
  simp only [finite_product_weight_four_fill μ S A B T hSA hSB hST hAB hAT hBT hcover,
    Complex.ofReal_mul, Finset.mul_sum, mul_assoc]

theorem finite_product_real_expectation_four_partition (μ : ∀ i, X i → ℝ) (S A B T : Finset I)
    (hSA : Disjoint S A) (hSB : Disjoint S B) (hST : Disjoint S T)
    (hAB : Disjoint A B) (hAT : Disjoint A T) (hBT : Disjoint B T)
    (hcover : S ∪ A ∪ B ∪ T = univ) (f : (∀ i, X i) → ℝ) :
    (∑ x, finiteProductWeight μ x * f x) =
      ∑ s : (∀ i : S, X i.1), finiteProductWeight (fun i : S => μ i.1) s *
      ∑ a : (∀ i : A, X i.1), finiteProductWeight (fun i : A => μ i.1) a *
      ∑ b : (∀ i : B, X i.1), finiteProductWeight (fun i : B => μ i.1) b *
      ∑ t : (∀ i : T, X i.1), finiteProductWeight (fun i : T => μ i.1) t *
        f (finiteFourPartitionFill S A B T hcover s a b t) := by
  rw [finite_sum_four_partition S A B T hSA hSB hST hAB hAT hBT hcover]
  simp only [finite_product_weight_four_fill μ S A B T hSA hSB hST hAB hAT hBT hcover,
    Finset.mul_sum, mul_assoc]

theorem finite_product_energy_four_partition (μ : ∀ i, X i → ℝ) (S A B T : Finset I)
    (hSA : Disjoint S A) (hSB : Disjoint S B) (hST : Disjoint S T)
    (hAB : Disjoint A B) (hAT : Disjoint A T) (hBT : Disjoint B T)
    (hcover : S ∪ A ∪ B ∪ T = univ) (f : (∀ i, X i) → ℂ) :
    finiteWeightedEnergy (finiteProductWeight μ) f =
      ∑ s : (∀ i : S, X i.1), finiteProductWeight (fun i : S => μ i.1) s *
      ∑ a : (∀ i : A, X i.1), finiteProductWeight (fun i : A => μ i.1) a *
      ∑ b : (∀ i : B, X i.1), finiteProductWeight (fun i : B => μ i.1) b *
        finiteWeightedEnergy (finiteProductWeight (fun i : T => μ i.1))
          (fun t => f (finiteFourPartitionFill S A B T hcover s a b t)) :=
  finite_product_real_expectation_four_partition μ S A B T hSA hSB hST hAB hAT hBT hcover
    (fun x => ‖f x‖ ^ 2)

end Bounty
end

section

/- The literal asymmetric transition conditioned on its shared coordinates. -/

namespace Bounty

open Finset
open scoped Classical

noncomputable def finiteThreeWayKernel {C A B : Type*} [DecidableEq C]
    (μ : A → ℝ) (ν : B → ℝ) (H : C → A → B → ℂ)
    (x y : C × A × B) : ℂ :=
  if x.1 = y.1 then ((μ y.2.1 * ν y.2.2 : ℝ) : ℂ) * H x.1 y.2.1 x.2.2 else 0

theorem finite_three_way_kernel_row {C A B : Type*} [Fintype C] [DecidableEq C]
    [Fintype A] [Fintype B] (μ : A → ℝ) (ν : B → ℝ) (hν : ∑ b, ν b = 1)
    (H : C → A → B → ℂ) (G : C → A → ℂ) (x : C × A × B) :
    (∑ y, finiteThreeWayKernel μ ν H x y * G y.1 y.2.1) =
      ∑ a, (μ a : ℂ) * H x.1 a x.2.2 * G x.1 a := by
  simp only [Fintype.sum_prod_type]
  rw [sum_eq_single x.1]
  · apply sum_congr rfl
    intro a _
    simp only [finiteThreeWayKernel, if_true, Complex.ofReal_mul]
    have hn : (∑ b, (ν b : ℂ)) = 1 := by exact_mod_cast hν
    calc
      _ = ((μ a : ℂ) * H x.1 a x.2.2 * G x.1 a) * ∑ b, (ν b : ℂ) := by
        rw [mul_sum]
        apply sum_congr rfl
        intro b _
        ring
      _ = _ := by rw [hn, mul_one]
  · intro c _ hcx
    simp only [finiteThreeWayKernel, Ne.symm hcx, if_false, zero_mul, sum_const_zero]
  · simp

theorem finite_three_way_kernel_pairing {C A B : Type*} [Fintype C] [DecidableEq C]
    [Fintype A] [Fintype B] (ρ : C → ℝ) (μ : A → ℝ) (ν : B → ℝ)
    (hμ : ∑ a, μ a = 1) (hν : ∑ b, ν b = 1)
    (H : C → A → B → ℂ) (F : C → B → ℂ) (G : C → A → ℂ) :
    cleanKernelPairing (fun x : C × A × B => ρ x.1 * μ x.2.1 * ν x.2.2)
      (finiteThreeWayKernel μ ν H) (fun x => F x.1 x.2.2) (fun x => G x.1 x.2.1) =
      ∑ c, (ρ c : ℂ) * ∑ a, ∑ b, ((μ a * ν b : ℝ) : ℂ) *
        ((starRingEnd ℂ) (F c b) * G c a * H c a b) := by
  have hr (x : C × A × B) :
      (∑ y, ((ρ x.1 * μ x.2.1 * ν x.2.2 : ℝ) : ℂ) *
        (starRingEnd ℂ) (F x.1 x.2.2) * finiteThreeWayKernel μ ν H x y * G y.1 y.2.1) =
      (((ρ x.1 * μ x.2.1 * ν x.2.2 : ℝ) : ℂ) * (starRingEnd ℂ) (F x.1 x.2.2)) *
        ∑ a, (μ a : ℂ) * H x.1 a x.2.2 * G x.1 a := by
    rw [← finite_three_way_kernel_row μ ν hν H G x, mul_sum]
    apply sum_congr rfl
    intro y _
    ring
  unfold cleanKernelPairing
  simp_rw [hr]
  simp only [Fintype.sum_prod_type]
  apply sum_congr rfl
  intro c _
  rw [sum_comm]
  have hm : (∑ a, (μ a : ℂ)) = 1 := by exact_mod_cast hμ
  have hu (b : B) :
      (∑ a, (((ρ c * μ a * ν b : ℝ) : ℂ) * (starRingEnd ℂ) (F c b)) *
        ∑ a', (μ a' : ℂ) * H c a' b * G c a') =
      ((ρ c * ν b : ℝ) : ℂ) * (starRingEnd ℂ) (F c b) *
        ∑ a', (μ a' : ℂ) * H c a' b * G c a' := by
    calc
      _ = (∑ a, (μ a : ℂ)) * (((ρ c * ν b : ℝ) : ℂ) * (starRingEnd ℂ) (F c b) *
          ∑ a', (μ a' : ℂ) * H c a' b * G c a') := by
        rw [sum_mul]
        apply sum_congr rfl
        intro a _
        push_cast
        ring
      _ = _ := by rw [hm, one_mul]
  simp_rw [hu, mul_sum]
  rw [sum_comm]
  apply sum_congr rfl
  intro a _
  apply sum_congr rfl
  intro b _
  push_cast
  ring

theorem finite_three_way_raw_pairing {C A B : Type*} [Fintype C]
    [Fintype A] [Fintype B] (ρ : C → ℝ) (μ : A → ℝ) (ν : B → ℝ)
    (phase : C → A → B → ℂ) (F : C → B → ℂ) (G : C → A → ℂ) :
    cleanRawPairing (fun x : C × A × B => ρ x.1 * μ x.2.1 * ν x.2.2)
      (fun x => phase x.1 x.2.1 x.2.2) (fun x => F x.1 x.2.2) (fun x => G x.1 x.2.1) =
      ∑ c, (ρ c : ℂ) * ∑ a, ∑ b, ((μ a * ν b : ℝ) : ℂ) *
        ((starRingEnd ℂ) (F c b) * G c a * phase c a b) := by
  simp only [cleanRawPairing, Fintype.sum_prod_type, mul_sum]
  apply sum_congr rfl
  intro c _
  apply sum_congr rfl
  intro a _
  apply sum_congr rfl
  intro b _
  push_cast
  ring

end Bounty
end

section

/- The fixed shared product only contributes a unit scalar and shifts additive frequency. -/

namespace Bounty

open Finset
open scoped Classical

theorem finite_two_kernel_pairing_error_mul {A B : Type*} [Fintype A] [Fintype B]
    (μ : A → ℝ) (ν : B → ℝ) (KA : A → A → ℂ) (KB : B → B → ℂ)
    (phase : A → B → ℂ) (f : A → ℂ) (g : B → ℂ) (z : ℂ) :
    finiteTwoKernelPairingError μ ν KA KB (fun a b => z * phase a b) f g =
      z * finiteTwoKernelPairingError μ ν KA KB phase f g := by
  simp only [finiteTwoKernelPairingError, finite_two_kernel_average_mul, mul_sum]
  apply sum_congr rfl
  intro a _
  apply sum_congr rfl
  intro b _
  ring

theorem prime_shared_phase_error_norm {A B : Type*} [Fintype A] [Fintype B]
    (μ : A → ℝ) (ν : B → ℝ) (KA : A → A → ℂ) (KB : B → B → ℂ)
    (π : A → ℕ) (τ : B → ℕ) (hπ : ∀ a, 0 < π a) (hτ : ∀ b, 0 < τ b)
    (ζ Θ : ℝ) (C : ℕ) (hC : 0 < C) (f : A → ℂ) (g : B → ℂ) :
    ‖finiteTwoKernelPairingError μ ν KA KB
      (fun a b => primeTuplePhase ζ Θ (C * π a * τ b)) f g‖ =
    ‖finiteTwoKernelPairingError μ ν KA KB
      (fun a b => Complex.exp (Complex.I *
        (ζ * Real.log ((π a : ℝ) * τ b) + 2 * Real.pi * ((Θ * C) * ((π a : ℝ) * τ b)) : ℝ))) f g‖ := by
  have he : (fun a b => primeTuplePhase ζ Θ (C * π a * τ b)) =
      fun a b => physicalPhase ζ C * primeTuplePhase ζ (Θ * C) (π a * τ b) := by
    funext a b
    rw [Nat.mul_assoc, prime_tuple_phase_shared_mul ζ Θ C (π a * τ b) hC
      (Nat.mul_pos (hπ a) (hτ b))]
  rw [he, finite_two_kernel_pairing_error_mul, norm_mul, physical_phase_norm, one_mul]
  congr 2
  funext a b
  rw [prime_tuple_phase_eq_exp]
  congr 1
  push_cast
  ring

theorem prime_shared_phase_error_le {C A B : Type*}
    [Fintype C] [Fintype A] [Fintype B]
    (ρ : C → ℝ) (μ : A → ℝ) (ν : B → ℝ)
    (hρ : ∀ c, 0 ≤ ρ c) (hμ : ∀ a, 0 ≤ μ a) (hν : ∀ b, 0 ≤ ν b)
    (KA : A → A → ℂ) (KB : B → B → ℂ)
    (π : A → ℕ) (τ : B → ℕ) (hπ : ∀ a, 0 < π a) (hτ : ∀ b, 0 < τ b)
    (shared : C → ℕ) (hshared : ∀ c, 0 < shared c) (ζ Θ : ℝ)
    (f : C → A → ℂ) (g : C → B → ℂ) (ε : ℝ) (hε : 0 ≤ ε)
    (hfree : ∀ α : ℝ, ∀ (u : A → ℂ) (v : B → ℂ),
      ‖finiteTwoKernelPairingError μ ν KA KB
        (fun a b => Complex.exp (Complex.I *
          (ζ * Real.log ((π a : ℝ) * τ b) + 2 * Real.pi * (α * ((π a : ℝ) * τ b)) : ℝ))) u v‖ ≤
        ε * Real.sqrt (finiteWeightedEnergy μ u) * Real.sqrt (finiteWeightedEnergy ν v)) :
    ‖∑ c, (ρ c : ℂ) * finiteTwoKernelPairingError μ ν KA KB
        (fun a b => primeTuplePhase ζ Θ (shared c * π a * τ b)) (f c) (g c)‖ ≤
      ε * Real.sqrt (∑ c, ρ c * finiteWeightedEnergy μ (f c)) *
        Real.sqrt (∑ c, ρ c * finiteWeightedEnergy ν (g c)) := by
  apply finite_shared_two_kernel_error_bound ρ μ ν hρ hμ hν KA KB _ f g ε hε
  intro c
  rw [prime_shared_phase_error_norm μ ν KA KB π τ hπ hτ ζ Θ (shared c) (hshared c)]
  exact hfree (Θ * shared c) (f c) (g c)

end Bounty
end

section

/- Arbitrary power saving for the explicit rough-cell sieve error profile. -/

open Filter

namespace Bounty

theorem eventually_rough_cell_error_profile_le {a K : ℝ}
    (ha : 0 < a) (hK : 0 ≤ K) (S B : ℝ) :
    ∀ᶠ L : ℝ in atTop,
      K*(Real.exp (-L^(1/8 : ℝ)) + L^(S+1)*Real.exp (-(a/2)*L)) ≤ L^(-B) := by
  have hfirst := eventually_exp_neg_rpow_mul_rpow_le
    (by norm_num : (0 : ℝ) < 1/8) (by norm_num : (0 : ℝ) < 1) 0 (B+1)
  have hsecond := eventually_exp_neg_rpow_mul_rpow_le
    (by norm_num : (0 : ℝ) < 1) (half_pos ha) (S+1) (B+1)
  filter_upwards [hfirst, hsecond, eventually_ge_atTop (2*K),
    eventually_gt_atTop (0 : ℝ)] with L hfirstL hsecondL hconst hL
  simp only [neg_one_mul, Real.rpow_zero, mul_one] at hfirstL
  simp only [Real.rpow_one] at hsecondL
  calc
    _ ≤ K*(L^(-(B+1)) + L^(-(B+1))) := by
      apply mul_le_mul_of_nonneg_left _ hK
      exact add_le_add hfirstL (by simpa only [mul_comm] using hsecondL)
    _ = (2*K)*L^(-(B+1)) := by ring
    _ ≤ L*L^(-(B+1)) :=
      mul_le_mul_of_nonneg_right hconst (Real.rpow_nonneg hL.le _)
    _ = L^(-B) := by
      nth_rw 1 [← Real.rpow_one L]
      rw [← Real.rpow_add hL]
      congr 1
      ring

theorem eventually_rough_cell_order_error_le {a K : ℝ}
    (ha : 0 < a) (hK : 0 ≤ K) (S B : ℝ) :
    ∀ᶠ L : ℝ in atTop,
      K*(Real.exp (-(roughCellSieveOrder L : ℝ)) +
        L^(S+1)*Real.exp (-(a/2)*L)) ≤ L^(-B) := by
  filter_upwards [eventually_rough_cell_error_profile_le ha hK S B,
    eventually_ge_atTop (1 : ℝ)] with L hprofile hL
  apply le_trans _ hprofile
  apply mul_le_mul_of_nonneg_left _ hK
  exact add_le_add (rough_cell_sieve_order_exponential_le hL) le_rfl

end Bounty

end

section

/- A quantitative positive main term in a short logarithmic rough-integer cell. -/

open Finset

namespace Bounty

theorem rough_sqrt_avoidance_product_lower {L : ℝ} (hL : 1 ≤ L)
    (hlog : Real.log 2 ≤ L) :
    1 / ((4 * primeEulerProductUpperConstant) * L) ≤
      ∏ p ∈ primeBand 0 (Real.exp (Real.sqrt L)), (1 - 1 / (p : ℝ)) := by
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hC := primeEulerProductUpperConstant_pos
  have hsqrt : Real.sqrt L ≤ L := Real.sqrt_le_self_iff.mpr (Or.inr hL)
  have hbound := finite_prime_avoidance_product_lower
    (primeBand 0 (Real.exp (Real.sqrt L))) (fun _ hp => small_prime_pool_prime hp)
    (Real.one_le_exp_iff.mpr (Real.sqrt_nonneg L))
    (fun _ hp => small_prime_pool_le (Real.exp_nonneg _) hp)
  rw [Real.log_mul (by norm_num) (Real.exp_ne_zero _), Real.log_exp] at hbound
  apply le_trans _ hbound
  apply one_div_le_one_div_of_le
  · have hlog0 : 0 < Real.log 2 := Real.log_pos (by norm_num)
    positivity
  · nlinarith

theorem logarithmic_cell_length_lower {L Y : ℝ} (hY : 0 ≤ Y) (S : ℝ) :
    Y * L^(-S) ≤ Real.exp (L^(-S)) * Y - Y := by
  have h := mul_le_mul_of_nonneg_right (Real.add_one_le_exp (L^(-S))) hY
  nlinarith

theorem rough_logarithmic_cell_main_term_lower {L Y : ℝ} (hL : 1 ≤ L)
    (hlog : Real.log 2 ≤ L) (hY : 0 ≤ Y) (S : ℝ) :
    Y / ((4 * primeEulerProductUpperConstant) * L^(S + 1)) ≤
      (Real.exp (L^(-S)) * Y - Y) *
        (∏ p ∈ primeBand 0 (Real.exp (Real.sqrt L)), (1 - 1 / (p : ℝ))) := by
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hC := primeEulerProductUpperConstant_pos
  have hlen := logarithmic_cell_length_lower (L := L) hY S
  have hV := rough_sqrt_avoidance_product_lower hL hlog
  have hV0 := (finite_prime_avoidance_product_pos
    (primeBand 0 (Real.exp (Real.sqrt L))) (fun _ hp => small_prime_pool_prime hp)).le
  have hlen0 : 0 ≤ Real.exp (L^(-S)) * Y - Y :=
    (mul_nonneg hY (Real.rpow_nonneg hL0.le _)).trans hlen
  have hmain := mul_le_mul hlen hV (by positivity) hlen0
  apply le_trans _ hmain
  apply le_of_eq
  rw [Real.rpow_add hL0, Real.rpow_one, Real.rpow_neg hL0.le]
  field_simp

end Bounty
