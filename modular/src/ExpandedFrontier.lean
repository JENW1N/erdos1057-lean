section
open scoped BigOperators Classical
theorem prime_tuple_character_norm_one {I : Type*} [Fintype I]
    (P : I → Finset ℕ) {q : ℕ} (χ : DirichletCharacter ℂ q)
    (hcop : ∀ i p, p ∈ P i → p.Coprime q) (x : ∀ i, P i) :
    ‖χ ((∏ i, (x i).val : ℕ) : ZMod q)‖ = 1 := by
  have hc : (∏ i, (x i).val : ℕ).Coprime q :=
    Nat.coprime_prod_left_iff.mpr (fun i _ => hcop i _ (x i).property)
  obtain ⟨u, hu⟩ := (ZMod.isUnit_iff_coprime _ _).mpr hc
  rw [← hu]
  exact χ.unit_norm_eq_one u

theorem prime_tuple_log_cell_kernel_energy (hZ : PrimitiveZeroFreeHalfPlane) :
    ∃ C : ℝ, 0 < C ∧
      ∀ {T : Type*} [Fintype T] (q : T → ℕ) (χ : (t : T) → DirichletCharacter ℂ (q t)),
      (∀ t, 0 < q t) → (∀ t, (χ t).IsPrimitive) →
      Function.Injective (fun t => (⟨q t, χ t⟩ : (n : ℕ) × DirichletCharacter ℂ n)) →
      ∀ Q : ℕ, 0 < Q → (∀ t, q t ≤ Q) →
      ∀ {I : Type*} [Fintype I] [DecidableEq I],
      ∀ (P : I → Finset ℕ) (V : I → ℝ) (i : I),
      (∀ j, 0 < V j) → (∀ j p, p ∈ P j → 0 < p) →
      (∀ j, ∑ p ∈ P j, 1 / (p : ℝ) = V j) →
      (∀ t j p, p ∈ P j → p.Coprime (q t)) →
      ∀ a b : ℝ, P i = primeBand a b → 2 ≤ a → 0 ≤ b →
      ∀ h ξ : ℝ, 0 < h → 0 < ξ → ∀ kept : Finset ℤ,
      (∀ d ∈ kept, ξ ≤ finiteCellMass (finiteProductWeight (physicalLabelLaw (P := P) V))
        (fun x => upperLogCell h (Real.log (∏ j, (x j).val : ℕ))) d) →
      (Fintype.card T - 1 : ℕ) *
        (((C / V i) * a ^ (-(1 : ℝ) / 32) *
          (1 + Real.log (Q * Q : ℕ) / Real.log a)) / ξ) ≤ 1 →
      ∀ f : (∀ j, P j) → ℂ,
        (∑ x, finiteProductWeight (physicalLabelLaw (P := P) V) x *
          ‖∑ y, (finiteProductWeight (physicalLabelLaw (P := P) V) y : ℂ) *
            finiteCellFrameKernel (finiteProductWeight (physicalLabelLaw (P := P) V))
              (fun z => upperLogCell h (Real.log (∏ j, (z j).val : ℕ))) kept
              (fun t z => star (χ t ((∏ j, (z j).val : ℕ) : ZMod (q t)))) x y * f y‖ ^ 2) ≤
        4 * ∑ x, finiteProductWeight (physicalLabelLaw (P := P) V) x * ‖f x‖ ^ 2 := by
  obtain ⟨C, hC, hbnd⟩ := prime_tuple_log_cell_correlation_bound hZ
  refine ⟨C, hC, ?_⟩
  intro T _ q χ hq hχ hinj Q hQ hqQ I _ _ P V i hV hp hmass hcop a b hPi ha hb h ξ hh hξ kept hkept hsmall f
  have hVi := hV i
  have ha0 : 0 < a := by linarith
  have hlog : 0 < Real.log a := Real.log_pos (by linarith)
  have hQ1 : (1 : ℝ) ≤ (Q * Q : ℕ) := by exact_mod_cast Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero (Nat.ne_of_gt hQ) (Nat.ne_of_gt hQ))
  have hδ : 0 ≤ (C / V i) * a ^ (-(1 : ℝ) / 32) *
      (1 + Real.log (Q * Q : ℕ) / Real.log a) := by
    have := Real.log_nonneg hQ1
    positivity
  refine finite_cell_kernel_energy_of_raw_gram
    (finiteProductWeight (physicalLabelLaw (P := P) V)) ?_
    (fun z => upperLogCell h (Real.log (∏ j, (z j).val : ℕ))) kept hδ hξ hkept
    (fun t z => star (χ t ((∏ j, (z j).val : ℕ) : ZMod (q t)))) ?_ hsmall ?_ f
  · intro x
    exact Finset.prod_nonneg (fun j _ => physical_label_law_nonneg V (fun k => (hV k).le) j (x j))
  · intro t x _
    rw [norm_star]
    exact prime_tuple_character_norm_one P (χ t) (hcop t) x
  · intro d hd t s hts
    have hraw := hbnd (q t) (q s) (hq t) (hq s) (χ t) (χ s) (hχ t) (hχ s)
      (fun he => hts (hinj he)) P V i hV hp hmass a b hPi ha hb h hh d
    have hqprod : (0 : ℝ) < (q t * q s : ℕ) := by exact_mod_cast Nat.mul_pos (hq t) (hq s)
    have hprod : (q t * q s : ℕ) ≤ Q * Q := Nat.mul_le_mul (hqQ t) (hqQ s)
    have hlogs : Real.log (q t * q s : ℕ) ≤ Real.log (Q * Q : ℕ) :=
      Real.log_le_log hqprod (by exact_mod_cast hprod)
    have hmono : (C / V i) * a ^ (-(1 : ℝ) / 32) *
        (1 + Real.log (q t * q s : ℕ) / Real.log a) ≤
        (C / V i) * a ^ (-(1 : ℝ) / 32) *
        (1 + Real.log (Q * Q : ℕ) / Real.log a) :=
      mul_le_mul_of_nonneg_left (add_le_add le_rfl (div_le_div_of_nonneg_right hlogs hlog.le)) (by positivity)
    simpa only [starRingEnd_apply, star_star] using hraw.trans hmono
end

section
open Finset
open scoped Classical
section ResiduePath
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (ζ : ∀ p : PhysicalPrime P, ZMod p.2.val)
  (hmarks : ∀ j : Fin (n + 1), ∀ p ∈ physicalMarkedPrimes (L j),
    ζ p = -(a j : ZMod p.2.val))

variable
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ) (η : Fin N → Fin (n + 1) → ℝ)
  (V ρ : Fin N → ℝ) (hV : ∀ g, V g ≠ 0) (cap : ℕ)


noncomputable def physicalJointResidueStep (i : ℕ) (g : Fin N) :
    GlobalBirthRawStep (R := fun p : ↥(P g) => ZMod p.val)
      (physicalGroupBareAtomicActivity L g i) (physicalGroupBareAtomicActivity L g (i + 1)) :=
  physicalGroupResidueFiniteStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis
    g (fun j => hk j g) (β g) (η g) (V g) (ρ g) (hV g) cap i

variable [∀ g, ∀ p : ↥(P g), NeZero p.val]

/-- All groups move simultaneously, with the total cutoff applied once to
all input memories and once to all output memories at each atomic step. -/
noncomputable def physicalJointResidueRawHistory : ℂ :=
  globalBirthJointRawHistory (fun i g => physicalGroupBareAtomicActivity L g i)
    (physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β η V ρ hV cap)
    (fun _ => cap) (2 * n + 1)
    (fun s => if ∀ g, (s g).2.1 = 0 then 1 else 0)
    (globalBirthJointInitial (fun g => physicalGroupBareAtomicActivity L g 0))

/-- Exact normalized physical residue trace across all groups. The total
memory cap and every local row cap remain in the literal joint kernels. -/
theorem physical_joint_residue_normalized_history_trace :
    ((∏ g, ∏ s : PhysicalSlots J ell, β g (L 0 g s) / V g : ℝ) : ℂ) *
      physicalJointResidueRawHistory C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β η V ρ hV cap =
    ∑ z : Fin (2 * n + 2) → (g : Fin N) → (p : ↥(P g)) → GhostPhaseState (ZMod p.val),
      ((∏ g, ∏ p, ghostPhaseTerminal (physicalGroupPhaseActivity (L (Fin.last n)) g p)
        (z (Fin.last (2 * n + 1)) g p) : ℝ) : ℂ) *
      (((∏ g, ∏ p, ghostPhaseRunInitial (physicalGroupPhaseActivity (L 0) g p)
        (β g p) (V g) (z 0 g p) : ℝ) : ℂ) *
        ∏ j : Fin (2 * n + 1), globalBirthJointHistoryKernel
          (fun i g => physicalGroupBareAtomicActivity L g i)
          (physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β η V ρ hV cap)
          (fun _ => cap) j.val (z j.succ) (z j.castSucc)) := by
  have h := global_birth_joint_weighted_empty_history_product
    (fun i g => physicalGroupBareAtomicActivity L g i)
    (physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β η V ρ hV cap)
    (fun _ => cap) (fun g p => β g p / V g) (2 * n + 1)
  simpa only [physicalJointResidueRawHistory, physical_group_bare_atomic_activity_initial,
    physical_group_bare_atomic_activity_terminal, physical_group_initial_tilt_eq_active,
    ghost_phase_run_initial_eq_tilted] using h

end ResiduePath
end

section
open Finset Classical
noncomputable def mixedMemoryStepEnergy {J K : Type*}
    (ρ v vmin vmax : ℝ) (T groups : ℕ) : J ⊕ K → ℝ
  | .inl _ => physicalGhostUniformEnergyBound ρ vmax v ^ groups
  | .inr _ => unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ groups

section

variable {J K G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  (Δ D : K → G → ℤ) (μ : ∀ g, P g → ℝ) (q : J → ℝ)
  (ρ : ℝ) (V : G → ℝ) (t : G → ℕ) (B : ℕ)

abbrev MixedMemoryPath (steps : List (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) :=
  FiniteEventPath (MixedMemoryEvent n Δ D t B) (mixedMemoryEventTarget n Δ D t B) steps s

noncomputable def mixedMemoryPathAction (steps : List (J ⊕ K))
    (phase : ∀ s, MixedMemoryPath n Δ D t B steps s → ℂ)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ) :=
  let _ : ∀ (k : J ⊕ K) s, Fintype (MixedMemoryEvent n Δ D t B k s) := mixedMemoryEventFintype n Δ D t B
  finiteEventPathAction (MixedMemoryEvent n Δ D t B) (mixedMemoryEventTarget n Δ D t B)
    (mixedMemoryEventWeight n Δ D t B μ q ρ V) steps phase f

theorem mixed_memory_path_norm_le_positive_list
    (hμ : ∀ g p, 0 ≤ μ g p) (hq : ∀ j, 0 ≤ q j) (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ V g)
    (steps : List (J ⊕ K)) (phase : ∀ s, MixedMemoryPath n Δ D t B steps s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) :
    ‖mixedMemoryPathAction n Δ D μ q ρ V t B steps phase f s‖ ≤
      (finiteOperatorListAction (mixedMemoryPositiveOperator n Δ D t B μ q ρ V)
        steps (complexNormEnvelope f) s).re := by
  let _ : ∀ (k : J ⊕ K) s, Fintype (MixedMemoryEvent n Δ D t B k s) := mixedMemoryEventFintype n Δ D t B
  have h := finite_event_path_norm_le_abs_list_re (MixedMemoryEvent n Δ D t B)
    (mixedMemoryEventTarget n Δ D t B) (mixedMemoryEventWeight n Δ D t B μ q ρ V)
    steps phase hphase f s
  rw [mixed_memory_absolute_actions_eq n Δ D t B μ q ρ V hμ hq hρ hV] at h
  exact h

theorem mixed_memory_positive_symmetric (k : J ⊕ K)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric (mixedMemoryPositiveOperator n Δ D t B μ q ρ V k f) := by
  cases k with
  | inl j => exact physical_absolute_ghost_cutoff_symmetric n μ (q j) ρ V t B univ f hf
  | inr k => exact unrestricted_positive_cutoff_product_symmetric n (Δ k) (D k) μ ρ V t B univ f hf

theorem mixed_memory_path_energy_le
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 < μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (hC : ∀ j g, q j / ρ ^ 2 + ((1 - q j) * V g / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ g, t g ≤ T)
    (steps : List (J ⊕ K)) (phase : ∀ s, MixedMemoryPath n Δ D t B steps s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (mixedMemoryPathAction n Δ D μ q ρ V t B steps phase f) ≤
    (steps.map (mixedMemoryStepEnergy ρ v vmin vmax T (Fintype.card G))).prod *
      finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  have hμ0 : ∀ g p, 0 ≤ μ g p := fun g p => (hμ g p).le
  have hV0 : ∀ g, 0 ≤ V g := fun g => (hvmin.trans_le (hVlo g)).le
  apply finiteWeightedEnergy_le_of_envelope_domination
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productMemoryWeight_nonneg μ (fun g => unrestrictedResidueWeight (μ g)) hμ0
      (fun g z => hμ0 g z.1)) f _
    (finiteOperatorListAction (mixedMemoryPositiveOperator n Δ D t B μ q ρ V) steps)
  · intro s
    exact (mixed_memory_path_norm_le_positive_list n Δ D μ q ρ V t B hμ0 hq0 hρ0.le hV0
      steps phase hphase f s).trans (Complex.re_le_norm _)
  · apply finite_operator_list_energy_le _ ProductMemorySymmetric
      (mixedMemoryPositiveOperator n Δ D t B μ q ρ V)
      (mixed_memory_positive_symmetric n Δ D μ q ρ V t B)
      (mixedMemoryStepEnergy ρ v vmin vmax T (Fintype.card G))
    · intro k
      cases k with
      | inl j => exact pow_nonneg (Real.exp_pos _).le _
      | inr k => exact pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _
    · intro k F hF
      cases k with
      | inl j =>
        simpa only [mixedMemoryPositiveOperator, mixedMemoryStepEnergy, card_univ] using
          physical_ghost_absolute_cutoff_product_energy_le n μ (q j) ρ V v vmax t B
            hμ hmass (hq0 j) (hq1 j) hρ0 hV0 hVhi (zero_lt_one.trans hv)
            (hD j) (hC j) univ F hF
      | inr k =>
        simpa only [mixedMemoryPositiveOperator, mixedMemoryStepEnergy, card_univ] using
          unrestricted_cutoff_product_energy_le n (Δ k) (D k) μ ρ V t B
            hρ0 hρ1 hv hvmin hVlo hVhi hμ0 hmass T ht (fun _ _ _ _ _ _ => 1)
            (by intros; simp) univ F hF
    · exact complexNormEnvelope_memory_symmetric f hf

theorem mixed_memory_path_mask_energy_le
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 < μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (hC : ∀ j g, q j / ρ ^ 2 + ((1 - q j) * V g / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ g, t g ≤ T)
    (steps : List (J ⊕ K))
    (allowed : ∀ s, MixedMemoryPath n Δ D t B steps s → Prop)
    (phase : ∀ s, MixedMemoryPath n Δ D t B steps s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (mixedMemoryPathAction n Δ D μ q ρ V t B steps
        (fun s p => if allowed s p then phase s p else 0) f) ≤
    (steps.map (mixedMemoryStepEnergy ρ v vmin vmax T (Fintype.card G))).prod *
      finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  apply mixed_memory_path_energy_le n Δ D μ q ρ V t B hρ0 hρ1 hv hvmin hVlo hVhi
    hμ hmass hq0 hq1 hD hC T ht steps _ _ f hf
  intro s p
  split_ifs
  · exact hphase s p
  · simp

end
end

section
open scoped BigOperators Classical
abbrev BoundedPrimitiveCharacter (Q : ℕ) :=
  {t : (n : Fin Q) × DirichletCharacter ℂ (n.val + 1) // t.2.IsPrimitive}

noncomputable def boundedPrimitiveModulus {Q : ℕ} (t : BoundedPrimitiveCharacter Q) : ℕ :=
  t.val.1.val + 1

noncomputable def boundedPrimitiveValue {Q : ℕ} (t : BoundedPrimitiveCharacter Q) :
    DirichletCharacter ℂ (boundedPrimitiveModulus t) := t.val.2

theorem bounded_primitive_modulus_pos {Q : ℕ} (t : BoundedPrimitiveCharacter Q) :
    0 < boundedPrimitiveModulus t := Nat.zero_lt_succ _

theorem bounded_primitive_modulus_le {Q : ℕ} (t : BoundedPrimitiveCharacter Q) :
    boundedPrimitiveModulus t ≤ Q := t.val.1.isLt

theorem bounded_primitive_value_primitive {Q : ℕ} (t : BoundedPrimitiveCharacter Q) :
    (boundedPrimitiveValue t).IsPrimitive := t.property

theorem bounded_primitive_character_card_le (Q : ℕ) :
    Fintype.card (BoundedPrimitiveCharacter Q) ≤ Q * Q := by
  calc
    _ ≤ Fintype.card ((n : Fin Q) × DirichletCharacter ℂ (n.val + 1)) :=
      Fintype.card_subtype_le _
    _ = ∑ n : Fin Q, Fintype.card (DirichletCharacter ℂ (n.val + 1)) := Fintype.card_sigma
    _ ≤ ∑ _n : Fin Q, Q := by
      apply Finset.sum_le_sum
      intro n _
      rw [← Nat.card_eq_fintype_card, DirichletCharacter.card_eq_totient_of_hasEnoughRootsOfUnity]
      exact (Nat.totient_le _).trans n.isLt
    _ = Q * Q := by simp

theorem bounded_primitive_character_injective (Q : ℕ) :
    Function.Injective (fun t : BoundedPrimitiveCharacter Q =>
      (⟨boundedPrimitiveModulus t, boundedPrimitiveValue t⟩ : (n : ℕ) × DirichletCharacter ℂ n)) := by
  rintro ⟨⟨i, χ⟩, hi⟩ ⟨⟨j, ψ⟩, hj⟩ he
  have hn : i.val + 1 = j.val + 1 := congrArg Sigma.fst he
  have hij : i = j := Fin.ext (Nat.add_right_cancel hn)
  subst j
  have hc : χ = ψ := eq_of_heq (Sigma.mk.inj he).2
  subst ψ
  rfl
end

section
open Finset
theorem block_sieve_local_bounds {ι : Type*} (s : Finset ι) (w : ι → ℝ)
    (hw : ∀ i ∈ s, 0 ≤ w i ∧ w i ≤ 1) {h : ℕ} (hh : Even h) :
    0 ≤ exclusionTruncation s w (h + 1) ∧
    (∏ i ∈ s, (1 - w i)) ≤ exclusionTruncation s w (h + 1) ∧
    exclusionTruncation s w (h + 1) - (∏ i ∈ s, (1 - w i)) ≤
      exclusionElementary s w (h + 1) := by
  have hb := exclusion_bonferroni s w hw (h + 1)
  rw [pow_succ, hh.neg_one_pow, one_mul] at hb
  have hprod : 0 ≤ ∏ i ∈ s, (1 - w i) :=
    prod_nonneg (fun i hi => sub_nonneg.mpr (hw i hi).2)
  constructor
  · linarith [hb.1]
  constructor <;> linarith [hb.1, hb.2]

theorem block_sieve_log_factor_lower {η u : ℝ} (hη : 0 < η)
    (hu0 : 0 ≤ u) (hu1 : u ≤ 1 - η) : -u / η ≤ Real.log (1 - u) := by
  have hden : 0 < 1 - u := by linarith
  have hηden : η ≤ 1 - u := by linarith
  have hdiv : u / (1 - u) ≤ u / η := div_le_div_of_nonneg_left hu0 hη hηden
  have hlog := Real.one_sub_inv_le_log_of_pos hden
  have he : 1 - (1 - u)⁻¹ = -u / (1 - u) := by field_simp; ring
  rw [he] at hlog
  have hneg : -u / η ≤ -u / (1 - u) := by
    simpa only [neg_div] using neg_le_neg hdiv
  exact hneg.trans hlog

theorem block_sieve_avoidance_lower {ι : Type*} (s : Finset ι) (w : ι → ℝ)
    {η C : ℝ} (hη : 0 < η) (hw : ∀ i ∈ s, 0 ≤ w i ∧ w i ≤ 1 - η)
    (hsum : (∑ i ∈ s, w i) ≤ C) :
    Real.exp (-C / η) ≤ ∏ i ∈ s, (1 - w i) := by
  have hf : ∀ i ∈ s, Real.exp (-w i / η) ≤ 1 - w i := by
    intro i hi
    have hpos : 0 < 1 - w i := by linarith [(hw i hi).2]
    exact (Real.exp_le_exp.mpr (block_sieve_log_factor_lower hη (hw i hi).1 (hw i hi).2)).trans_eq
      (Real.exp_log hpos)
  calc
    _ ≤ Real.exp (-(∑ i ∈ s, w i) / η) :=
      Real.exp_le_exp.mpr (div_le_div_of_nonneg_right (neg_le_neg hsum) hη.le)
    _ = ∏ i ∈ s, Real.exp (-w i / η) := by
      rw [← Real.exp_sum]
      congr 1
      rw [← sum_neg_distrib, sum_div]
    _ ≤ _ := prod_le_prod₀ (fun _ _ => (Real.exp_pos _).le) hf

theorem block_sieve_relative_error_bound {ι : Type*} (s : Finset ι) (w : ι → ℝ)
    {η C : ℝ} (hη : 0 < η) (hC : 0 ≤ C)
    (hw : ∀ i ∈ s, 0 ≤ w i ∧ w i ≤ 1 - η)
    (hsum : (∑ i ∈ s, w i) ≤ C) (h : ℕ) :
    exclusionElementary s w (h + 1) / (∏ i ∈ s, (1 - w i)) ≤
      Real.exp (C / η) * (C^(h + 1) / ((h + 1).factorial : ℝ)) := by
  have ha := block_sieve_avoidance_lower s w hη hw hsum
  have ha0 : 0 < ∏ i ∈ s, (1 - w i) := (Real.exp_pos _).trans_le ha
  have hE : exclusionElementary s w (h + 1) ≤ C^(h + 1) / ((h + 1).factorial : ℝ) := by
    apply (exclusion_elementary_le_pow_div_factorial s w (fun i hi => (hw i hi).1) (h + 1)).trans
    exact div_le_div_of_nonneg_right
      (pow_le_pow_left₀ (sum_nonneg (fun i hi => (hw i hi).1)) hsum _)
      (Nat.cast_nonneg _)
  calc
    _ ≤ (C^(h + 1) / ((h + 1).factorial : ℝ)) / (∏ i ∈ s, (1 - w i)) :=
      div_le_div_of_nonneg_right hE ha0.le
    _ ≤ (C^(h + 1) / ((h + 1).factorial : ℝ)) / Real.exp (-C / η) :=
      div_le_div_of_nonneg_left (by positivity) (Real.exp_pos _) ha
    _ = _ := by rw [neg_div, Real.exp_neg, div_inv_eq_mul]; ring
end

section
open Finset
theorem block_product_correction_insert {G : Type*} [DecidableEq G]
    (s : Finset G) (U E : G → ℝ) {a : G} (ha : a ∉ s) :
    (∑ g ∈ insert a s, E g * ∏ k ∈ (insert a s).erase g, U k) =
      E a * (∏ k ∈ s, U k) +
        U a * (∑ g ∈ s, E g * ∏ k ∈ s.erase g, U k) := by
  rw [sum_insert ha, erase_insert ha, mul_sum]
  congr 1
  apply sum_congr rfl
  intro g hg
  have hag : a ≠ g := by
    intro h
    exact ha (h ▸ hg)
  rw [erase_insert_of_ne hag, prod_insert (not_mem_subset (erase_subset _ _) ha)]
  ring

theorem block_product_difference_bound {G : Type*} [DecidableEq G]
    (s : Finset G) (I U E : G → ℝ)
    (hI : ∀ g ∈ s, 0 ≤ I g)
    (hIU : ∀ g ∈ s, I g ≤ U g)
    (hE : ∀ g ∈ s, U g - I g ≤ E g) :
    0 ≤ (∏ g ∈ s, U g) - (∏ g ∈ s, I g) ∧
      (∏ g ∈ s, U g) - (∏ g ∈ s, I g) ≤
        ∑ g ∈ s, E g * ∏ k ∈ s.erase g, U k := by
  refine ⟨sub_nonneg.mpr (prod_le_prod₀ hI hIU), ?_⟩
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih =>
    have hIa : 0 ≤ I a := hI a (mem_insert_self _ _)
    have hIUa : I a ≤ U a := hIU a (mem_insert_self _ _)
    have hEa : U a - I a ≤ E a := hE a (mem_insert_self _ _)
    have hIs : ∀ g ∈ s, 0 ≤ I g := fun g hg => hI g (mem_insert_of_mem hg)
    have hIUs : ∀ g ∈ s, I g ≤ U g := fun g hg => hIU g (mem_insert_of_mem hg)
    have hEs : ∀ g ∈ s, U g - I g ≤ E g :=
      fun g hg => hE g (mem_insert_of_mem hg)
    have hUs : 0 ≤ ∏ g ∈ s, U g :=
      prod_nonneg (fun g hg => (hIs g hg).trans (hIUs g hg))
    have hCs : 0 ≤ ∑ g ∈ s, E g * ∏ k ∈ s.erase g, U k := by
      apply sum_nonneg
      intro g hg
      apply mul_nonneg
      · exact (sub_nonneg.mpr (hIUs g hg)).trans (hEs g hg)
      · exact prod_nonneg (fun k hk =>
          (hIs k (mem_of_mem_erase hk)).trans (hIUs k (mem_of_mem_erase hk)))
    have h1 := mul_le_mul_of_nonneg_right hEa hUs
    have h2 := mul_le_mul_of_nonneg_left (ih hIs hIUs hEs) hIa
    have h3 := mul_le_mul_of_nonneg_right hIUa hCs
    rw [prod_insert ha, prod_insert ha, block_product_correction_insert s U E ha]
    nlinarith

theorem block_product_sandwich {G : Type*} [DecidableEq G]
    (s : Finset G) (I U E : G → ℝ)
    (hI : ∀ g ∈ s, 0 ≤ I g)
    (hIU : ∀ g ∈ s, I g ≤ U g)
    (hE : ∀ g ∈ s, U g - I g ≤ E g) :
    (∏ g ∈ s, U g) - (∑ g ∈ s, E g * ∏ k ∈ s.erase g, U k) ≤
        (∏ g ∈ s, I g) ∧
      (∏ g ∈ s, I g) ≤ (∏ g ∈ s, U g) := by
  have h := block_product_difference_bound s I U E hI hIU hE
  constructor <;> linarith [h.1, h.2]
end

section
open Finset
def blockSieveUpperSupport {G : Type*} (J : Finset G) (h n : G → ℕ) : Prop :=
  ∀ g ∈ J, n g ≤ h g

def blockSieveCorrectionSupport {G : Type*} (J : Finset G) (h n : G → ℕ) (j : G) : Prop :=
  j ∈ J ∧ n j = h j + 1 ∧ ∀ g ∈ J, g ≠ j → n g ≤ h g

theorem block_sieve_upper_correction_disjoint {G : Type*} {J : Finset G}
    {h n : G → ℕ} {j : G} (hu : blockSieveUpperSupport J h n)
    (hj : blockSieveCorrectionSupport J h n j) : False := by
  have := hu j hj.1
  have := hj.2.1
  omega

theorem block_sieve_correction_support_unique {G : Type*} {J : Finset G}
    {h n : G → ℕ} {j k : G} (hj : blockSieveCorrectionSupport J h n j)
    (hk : blockSieveCorrectionSupport J h n k) : j = k := by
  by_contra hne
  have := hk.2.2 j hj.1 hne
  have := hj.2.1
  omega

noncomputable def blockSieveUpperCoefficient {G : Type*} (J : Finset G) (h n : G → ℕ) : ℝ := by
  classical
  exact if blockSieveUpperSupport J h n then (-1 : ℝ)^(∑ g ∈ J, n g) else 0

noncomputable def blockSieveCorrectionAt {G : Type*} (J : Finset G) (h n : G → ℕ) (j : G) : ℝ := by
  classical
  exact if blockSieveCorrectionSupport J h n j then (-1 : ℝ)^(∑ g ∈ J.erase j, n g) else 0

noncomputable def blockSieveCorrectionCoefficient {G : Type*} (J : Finset G) (h n : G → ℕ) : ℝ :=
  ∑ j ∈ J, blockSieveCorrectionAt J h n j

noncomputable def blockSieveLowerCoefficient {G : Type*} (J : Finset G) (h n : G → ℕ) : ℝ :=
  blockSieveUpperCoefficient J h n - blockSieveCorrectionCoefficient J h n

theorem block_sieve_upper_coefficient_ne_zero_iff {G : Type*} (J : Finset G) (h n : G → ℕ) :
    blockSieveUpperCoefficient J h n ≠ 0 ↔ blockSieveUpperSupport J h n := by
  classical
  by_cases hs : blockSieveUpperSupport J h n <;> simp [blockSieveUpperCoefficient, hs]

theorem block_sieve_correction_at_ne_zero_iff {G : Type*} (J : Finset G) (h n : G → ℕ) (j : G) :
    blockSieveCorrectionAt J h n j ≠ 0 ↔ blockSieveCorrectionSupport J h n j := by
  classical
  by_cases hs : blockSieveCorrectionSupport J h n j <;> simp [blockSieveCorrectionAt, hs]

theorem block_sieve_correction_coefficient_eq_at {G : Type*} {J : Finset G}
    {h n : G → ℕ} {j : G} (hj : blockSieveCorrectionSupport J h n j) :
    blockSieveCorrectionCoefficient J h n = blockSieveCorrectionAt J h n j := by
  classical
  apply sum_eq_single j
  · intro k _ hkj
    apply not_ne_iff.mp
    intro hk
    exact hkj (block_sieve_correction_support_unique
      ((block_sieve_correction_at_ne_zero_iff J h n k).mp hk) hj)
  · exact fun hnot => (hnot hj.1).elim

theorem block_sieve_correction_coefficient_eq_zero {G : Type*} {J : Finset G}
    {h n : G → ℕ} (hn : ¬ ∃ j, blockSieveCorrectionSupport J h n j) :
    blockSieveCorrectionCoefficient J h n = 0 := by
  classical
  apply sum_eq_zero
  intro j _
  exact not_ne_iff.mp (fun hj => hn ⟨j, (block_sieve_correction_at_ne_zero_iff J h n j).mp hj⟩)

theorem block_sieve_correction_coefficient_ne_zero_iff {G : Type*} (J : Finset G) (h n : G → ℕ) :
    blockSieveCorrectionCoefficient J h n ≠ 0 ↔ ∃! j, blockSieveCorrectionSupport J h n j := by
  classical
  constructor
  · intro hc
    have hex : ∃ j, blockSieveCorrectionSupport J h n j := by
      by_contra hn
      exact hc (block_sieve_correction_coefficient_eq_zero hn)
    obtain ⟨j, hj⟩ := hex
    exact ⟨j, hj, fun k hk => block_sieve_correction_support_unique hk hj⟩
  · rintro ⟨j, hj, _⟩
    rw [block_sieve_correction_coefficient_eq_at hj]
    exact (block_sieve_correction_at_ne_zero_iff J h n j).mpr hj

theorem block_sieve_correction_coefficient_eq_zero_of_upper {G : Type*} {J : Finset G}
    {h n : G → ℕ} (hu : blockSieveUpperSupport J h n) :
    blockSieveCorrectionCoefficient J h n = 0 := by
  apply block_sieve_correction_coefficient_eq_zero
  rintro ⟨j, hj⟩
  exact block_sieve_upper_correction_disjoint hu hj

theorem abs_block_sieve_upper_coefficient_le_one {G : Type*} (J : Finset G) (h n : G → ℕ) :
    |blockSieveUpperCoefficient J h n| ≤ 1 := by
  classical
  unfold blockSieveUpperCoefficient
  split_ifs <;> simp [abs_pow]

theorem abs_block_sieve_correction_at_le_one {G : Type*} (J : Finset G) (h n : G → ℕ) (j : G) :
    |blockSieveCorrectionAt J h n j| ≤ 1 := by
  classical
  unfold blockSieveCorrectionAt
  split_ifs <;> simp [abs_pow]

theorem abs_block_sieve_correction_coefficient_le_one {G : Type*} (J : Finset G) (h n : G → ℕ) :
    |blockSieveCorrectionCoefficient J h n| ≤ 1 := by
  classical
  by_cases hex : ∃ j, blockSieveCorrectionSupport J h n j
  · obtain ⟨j, hj⟩ := hex
    rw [block_sieve_correction_coefficient_eq_at hj]
    exact abs_block_sieve_correction_at_le_one J h n j
  · rw [block_sieve_correction_coefficient_eq_zero hex]
    norm_num

theorem block_sieve_lower_coefficient_ne_zero_iff {G : Type*} (J : Finset G) (h n : G → ℕ) :
    blockSieveLowerCoefficient J h n ≠ 0 ↔
      blockSieveUpperSupport J h n ∨ ∃! j, blockSieveCorrectionSupport J h n j := by
  classical
  by_cases hu : blockSieveUpperSupport J h n
  · have hc := block_sieve_correction_coefficient_eq_zero_of_upper hu
    simp [blockSieveLowerCoefficient, hc, (block_sieve_upper_coefficient_ne_zero_iff J h n).mpr hu, hu]
  · have hz : blockSieveUpperCoefficient J h n = 0 :=
      not_ne_iff.mp (fun hn => hu ((block_sieve_upper_coefficient_ne_zero_iff J h n).mp hn))
    simp only [blockSieveLowerCoefficient, hz, zero_sub, neg_ne_zero, hu, false_or]
    exact block_sieve_correction_coefficient_ne_zero_iff J h n

theorem abs_block_sieve_lower_coefficient_le_one {G : Type*} (J : Finset G) (h n : G → ℕ) :
    |blockSieveLowerCoefficient J h n| ≤ 1 := by
  classical
  by_cases hu : blockSieveUpperSupport J h n
  · rw [blockSieveLowerCoefficient, block_sieve_correction_coefficient_eq_zero_of_upper hu, sub_zero]
    exact abs_block_sieve_upper_coefficient_le_one J h n
  · have hz : blockSieveUpperCoefficient J h n = 0 :=
      not_ne_iff.mp (fun hn => hu ((block_sieve_upper_coefficient_ne_zero_iff J h n).mp hn))
    rw [blockSieveLowerCoefficient, hz, zero_sub, abs_neg]
    exact abs_block_sieve_correction_coefficient_le_one J h n

def blockSieveOccupancy {G α : Type*} [DecidableEq α]
    (B : G → Finset α) (S : Finset α) (g : G) : ℕ := (S ∩ B g).card

noncomputable def blockSieveSubsetUpperCoefficient {G α : Type*} [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (h : G → ℕ) (S : Finset α) : ℝ :=
  if S ⊆ J.biUnion B then blockSieveUpperCoefficient J h (blockSieveOccupancy B S) else 0

noncomputable def blockSieveSubsetCorrectionAt {G α : Type*} [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (h : G → ℕ) (j : G) (S : Finset α) : ℝ :=
  if S ⊆ J.biUnion B then blockSieveCorrectionAt J h (blockSieveOccupancy B S) j else 0

noncomputable def blockSieveSubsetLowerCoefficient {G α : Type*} [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (h : G → ℕ) (S : Finset α) : ℝ :=
  if S ⊆ J.biUnion B then blockSieveLowerCoefficient J h (blockSieveOccupancy B S) else 0

theorem block_sieve_subset_lower_coefficient_eq {G α : Type*} [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (h : G → ℕ) (S : Finset α) :
    blockSieveSubsetLowerCoefficient J B h S = blockSieveSubsetUpperCoefficient J B h S -
      ∑ j ∈ J, blockSieveSubsetCorrectionAt J B h j S := by
  classical
  by_cases hs : S ⊆ J.biUnion B <;>
    simp [blockSieveSubsetLowerCoefficient, blockSieveSubsetUpperCoefficient,
      blockSieveSubsetCorrectionAt, blockSieveLowerCoefficient, blockSieveCorrectionCoefficient, hs]

theorem abs_block_sieve_subset_upper_coefficient_le_one {G α : Type*} [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (h : G → ℕ) (S : Finset α) :
    |blockSieveSubsetUpperCoefficient J B h S| ≤ 1 := by
  classical
  unfold blockSieveSubsetUpperCoefficient
  split_ifs
  · exact abs_block_sieve_upper_coefficient_le_one _ _ _
  · norm_num

theorem abs_block_sieve_subset_correction_sum_le_one {G α : Type*} [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (h : G → ℕ) (S : Finset α) :
    |∑ j ∈ J, blockSieveSubsetCorrectionAt J B h j S| ≤ 1 := by
  classical
  by_cases hs : S ⊆ J.biUnion B
  · simpa only [blockSieveSubsetCorrectionAt, if_pos hs, blockSieveCorrectionCoefficient] using
      abs_block_sieve_correction_coefficient_le_one J h (blockSieveOccupancy B S)
  · simp [blockSieveSubsetCorrectionAt, hs]

theorem abs_block_sieve_subset_lower_coefficient_le_one {G α : Type*} [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (h : G → ℕ) (S : Finset α) :
    |blockSieveSubsetLowerCoefficient J B h S| ≤ 1 := by
  classical
  unfold blockSieveSubsetLowerCoefficient
  split_ifs
  · exact abs_block_sieve_lower_coefficient_le_one _ _ _
  · norm_num

theorem block_sieve_subset_upper_coefficient_ne_zero_iff {G α : Type*} [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (h : G → ℕ) (S : Finset α) :
    blockSieveSubsetUpperCoefficient J B h S ≠ 0 ↔
      S ⊆ J.biUnion B ∧ blockSieveUpperSupport J h (blockSieveOccupancy B S) := by
  classical
  by_cases hs : S ⊆ J.biUnion B <;>
    simp_all [blockSieveSubsetUpperCoefficient, block_sieve_upper_coefficient_ne_zero_iff]

theorem block_sieve_subset_correction_at_ne_zero_iff {G α : Type*} [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (h : G → ℕ) (j : G) (S : Finset α) :
    blockSieveSubsetCorrectionAt J B h j S ≠ 0 ↔
      S ⊆ J.biUnion B ∧ blockSieveCorrectionSupport J h (blockSieveOccupancy B S) j := by
  classical
  by_cases hs : S ⊆ J.biUnion B <;>
    simp_all [blockSieveSubsetCorrectionAt, block_sieve_correction_at_ne_zero_iff]

theorem block_sieve_subset_lower_coefficient_ne_zero_iff {G α : Type*} [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (h : G → ℕ) (S : Finset α) :
    blockSieveSubsetLowerCoefficient J B h S ≠ 0 ↔ S ⊆ J.biUnion B ∧
      (blockSieveUpperSupport J h (blockSieveOccupancy B S) ∨
        ∃! j, blockSieveCorrectionSupport J h (blockSieveOccupancy B S) j) := by
  classical
  by_cases hs : S ⊆ J.biUnion B <;>
    simp_all [blockSieveSubsetLowerCoefficient, block_sieve_lower_coefficient_ne_zero_iff]

theorem block_sieve_occupancy_sum_eq_card {G α : Type*} [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (S : Finset α)
    (hdisj : (J : Set G).PairwiseDisjoint B) (hs : S ⊆ J.biUnion B) :
    (∑ g ∈ J, blockSieveOccupancy B S g) = S.card := by
  classical
  have he : J.biUnion (fun g => S ∩ B g) = S := by
    ext p
    simp only [mem_biUnion, mem_inter]
    constructor
    · rintro ⟨g, _, hp, _⟩
      exact hp
    · intro hp
      obtain ⟨g, hg, hpg⟩ := mem_biUnion.mp (hs hp)
      exact ⟨g, hg, hp, hpg⟩
  have hd : (J : Set G).PairwiseDisjoint (fun g => S ∩ B g) := by
    intro i hi j hj hij
    exact (hdisj hi hj hij).mono inter_subset_right inter_subset_right
  calc
    _ = (J.biUnion (fun g => S ∩ B g)).card := (card_biUnion hd).symm
    _ = S.card := congrArg Finset.card he

theorem block_sieve_subset_upper_coefficient_eq {G α : Type*} [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (h : G → ℕ) (S : Finset α)
    (hdisj : (J : Set G).PairwiseDisjoint B) (hs : S ⊆ J.biUnion B)
    (hu : blockSieveUpperSupport J h (blockSieveOccupancy B S)) :
    blockSieveSubsetUpperCoefficient J B h S = (-1 : ℝ)^S.card := by
  classical
  simp only [blockSieveSubsetUpperCoefficient, if_pos hs, blockSieveUpperCoefficient,
    if_pos hu, block_sieve_occupancy_sum_eq_card J B S hdisj hs]

noncomputable def blockSieveUpperSubsets {G α : Type*} [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (h : G → ℕ) : Finset (Finset α) := by
  classical
  exact (J.biUnion B).powerset.filter
    (fun S => blockSieveUpperSupport J h (blockSieveOccupancy B S))

noncomputable def blockSieveCorrectionSubsets {G α : Type*} [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (h : G → ℕ) (j : G) : Finset (Finset α) := by
  classical
  exact (J.biUnion B).powerset.filter
    (fun S => blockSieveCorrectionSupport J h (blockSieveOccupancy B S) j)

theorem block_sieve_upper_correction_subsets_disjoint {G α : Type*} [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (h : G → ℕ) (j : G) :
    Disjoint (blockSieveUpperSubsets J B h) (blockSieveCorrectionSubsets J B h j) := by
  classical
  apply disjoint_left.mpr
  intro S hU hC
  exact block_sieve_upper_correction_disjoint (mem_filter.mp hU).2 (mem_filter.mp hC).2

theorem block_sieve_correction_subsets_pairwise_disjoint {G α : Type*} [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (h : G → ℕ) :
    Pairwise (fun j k => Disjoint (blockSieveCorrectionSubsets J B h j)
      (blockSieveCorrectionSubsets J B h k)) := by
  classical
  intro j k hjk
  apply disjoint_left.mpr
  intro S hj hk
  exact hjk (block_sieve_correction_support_unique (mem_filter.mp hj).2 (mem_filter.mp hk).2)

/-- Arbitrary finite-subset weights can be evaluated term by term, so in
particular this applies to the monomial `w S = ∏ p ∈ S, x p`. -/
theorem block_sieve_subset_weighted_expansion {G α : Type*} [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (h : G → ℕ) (w : Finset α → ℝ) :
    (∑ S ∈ (J.biUnion B).powerset, blockSieveSubsetLowerCoefficient J B h S * w S) =
      (∑ S ∈ (J.biUnion B).powerset, blockSieveSubsetUpperCoefficient J B h S * w S) -
        ∑ j ∈ J, ∑ S ∈ (J.biUnion B).powerset, blockSieveSubsetCorrectionAt J B h j S * w S := by
  simp_rw [block_sieve_subset_lower_coefficient_eq, sub_mul, sum_sub_distrib, sum_mul]
  rw [sum_comm]

theorem block_sieve_subset_upper_weighted_expansion {G α : Type*} [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (h : G → ℕ) (w : Finset α → ℝ)
    (hdisj : (J : Set G).PairwiseDisjoint B) :
    (∑ S ∈ (J.biUnion B).powerset, blockSieveSubsetUpperCoefficient J B h S * w S) =
      ∑ S ∈ blockSieveUpperSubsets J B h, (-1 : ℝ)^S.card * w S := by
  classical
  unfold blockSieveUpperSubsets
  rw [sum_filter]
  apply sum_congr rfl
  intro S hS
  by_cases hu : blockSieveUpperSupport J h (blockSieveOccupancy B S)
  · rw [if_pos hu, block_sieve_subset_upper_coefficient_eq J B h S hdisj (mem_powerset.mp hS) hu]
  · have hz : blockSieveSubsetUpperCoefficient J B h S = 0 := by
      apply not_ne_iff.mp
      exact fun hn => hu ((block_sieve_subset_upper_coefficient_ne_zero_iff J B h S).mp hn).2
    rw [if_neg hu, hz, zero_mul]
end

section
open Finset
theorem block_sieve_model_product_upper {G : Type*} (s : Finset G)
    (a e u : G → ℝ) (ha : ∀ g ∈ s, 0 < a g)
    (hu : ∀ g ∈ s, 0 ≤ u g) (hub : ∀ g ∈ s, u g ≤ a g + e g) :
    (∏ g ∈ s, u g) ≤ (∏ g ∈ s, a g) * Real.exp (∑ g ∈ s, e g / a g) := by
  calc
    _ ≤ ∏ g ∈ s, a g * Real.exp (e g / a g) := by
      apply prod_le_prod₀ hu
      intro g hg
      apply (hub g hg).trans
      have h := mul_le_mul_of_nonneg_left (Real.add_one_le_exp (e g / a g)) (ha g hg).le
      have he : a g * (e g / a g + 1) = a g + e g := by
        field_simp [(ha g hg).ne']; ring
      rwa [he] at h
    _ = _ := by rw [prod_mul_distrib, Real.exp_sum]

theorem block_sieve_model_correction_upper {G : Type*} [DecidableEq G]
    (s : Finset G) (a e u : G → ℝ) (ha : ∀ g ∈ s, 0 < a g)
    (he : ∀ g ∈ s, 0 ≤ e g) (hu : ∀ g ∈ s, 0 ≤ u g)
    (hub : ∀ g ∈ s, u g ≤ a g + e g) :
    (∑ j ∈ s, e j * ∏ g ∈ s.erase j, u g) ≤
      (∏ g ∈ s, a g) * (∑ g ∈ s, e g / a g) *
        Real.exp (∑ g ∈ s, e g / a g) := by
  have hterm : ∀ j ∈ s,
      e j * (∏ g ∈ s.erase j, u g) ≤
        (∏ g ∈ s, a g) * (e j / a j) * Real.exp (∑ g ∈ s, e g / a g) := by
    intro j hj
    have hprod := block_sieve_model_product_upper (s.erase j) a e u
      (fun g hg => ha g (mem_of_mem_erase hg))
      (fun g hg => hu g (mem_of_mem_erase hg))
      (fun g hg => hub g (mem_of_mem_erase hg))
    have hsum : (∑ g ∈ s.erase j, e g / a g) ≤ ∑ g ∈ s, e g / a g := by
      apply sum_le_sum_of_subset_of_nonneg (erase_subset j s)
      intro g hg _
      exact div_nonneg (he g hg) (ha g hg).le
    have hid : e j * (∏ g ∈ s.erase j, a g) = (∏ g ∈ s, a g) * (e j / a j) := by
      rw [← prod_erase_mul s a hj]
      field_simp [(ha j hj).ne']
    calc
      _ ≤ e j * ((∏ g ∈ s.erase j, a g) * Real.exp (∑ g ∈ s.erase j, e g / a g)) :=
        mul_le_mul_of_nonneg_left hprod (he j hj)
      _ ≤ e j * ((∏ g ∈ s.erase j, a g) * Real.exp (∑ g ∈ s, e g / a g)) := by
        apply mul_le_mul_of_nonneg_left _ (he j hj)
        exact mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr hsum)
          (prod_nonneg (fun g hg => (ha g (mem_of_mem_erase hg)).le))
      _ = _ := by rw [← mul_assoc, hid]
  calc
    _ ≤ ∑ j ∈ s, (∏ g ∈ s, a g) * (e j / a j) * Real.exp (∑ g ∈ s, e g / a g) :=
      sum_le_sum hterm
    _ = _ := by rw [← sum_mul, ← mul_sum]

theorem block_sieve_exp_error_le (R : ℝ) : Real.exp R - 1 ≤ R * Real.exp R := by
  have h := mul_le_mul_of_nonneg_right (Real.add_one_le_exp (-R)) (Real.exp_pos R).le
  rw [← Real.exp_add, neg_add_cancel, Real.exp_zero] at h
  nlinarith

theorem block_sieve_model_product_error {G : Type*} (s : Finset G)
    (a e u : G → ℝ) (ha : ∀ g ∈ s, 0 < a g)
    (hlo : ∀ g ∈ s, a g ≤ u g) (hub : ∀ g ∈ s, u g ≤ a g + e g) :
    0 ≤ (∏ g ∈ s, u g) - (∏ g ∈ s, a g) ∧
    (∏ g ∈ s, u g) - (∏ g ∈ s, a g) ≤
      (∏ g ∈ s, a g) * (∑ g ∈ s, e g / a g) *
        Real.exp (∑ g ∈ s, e g / a g) := by
  have hprod0 : 0 ≤ ∏ g ∈ s, a g := prod_nonneg (fun g hg => (ha g hg).le)
  have hprod := block_sieve_model_product_upper s a e u
    ha (fun g hg => (ha g hg).le.trans (hlo g hg)) hub
  have herr := mul_le_mul_of_nonneg_left
    (block_sieve_exp_error_le (∑ g ∈ s, e g / a g)) hprod0
  exact ⟨sub_nonneg.mpr (prod_le_prod₀ (fun g hg => (ha g hg).le) hlo), by nlinarith⟩
end

section
open Finset
theorem factorial_term_le_exp_decay {C : ℝ} (hC : 0 ≤ C) (n : ℕ) :
    C^n / (n.factorial : ℝ) ≤
      Real.exp (C * Real.exp 1) * Real.exp (-(n : ℝ)) := by
  have hexp : (Real.exp 1)^n * Real.exp (-(n : ℝ)) = 1 := by
    rw [← Real.exp_nat_mul, mul_one, ← Real.exp_add]
    simp
  calc
    C^n / (n.factorial : ℝ) =
        ((C * Real.exp 1)^n / (n.factorial : ℝ)) * Real.exp (-(n : ℝ)) := by
      rw [mul_pow]
      calc
        _ = (C^n / (n.factorial : ℝ)) *
            ((Real.exp 1)^n * Real.exp (-(n : ℝ))) := by rw [hexp, mul_one]
        _ = _ := by ring
    _ ≤ _ := mul_le_mul_of_nonneg_right
      (Real.pow_div_factorial_le_exp (C * Real.exp 1)
        (mul_nonneg hC (Real.exp_pos _).le) n)
      (Real.exp_pos _).le

theorem finite_sum_exp_neg_nat_le (J : Finset ℕ) :
    (∑ j ∈ J, Real.exp (-(j : ℝ))) ≤ (1 - Real.exp (-1))⁻¹ := by
  have hlt : Real.exp (-1) < 1 := Real.exp_lt_one_iff.mpr (by norm_num)
  have hs := hasSum_geometric_of_lt_one (Real.exp_pos (-1)).le hlt
  calc
    (∑ j ∈ J, Real.exp (-(j : ℝ))) = ∑ j ∈ J, (Real.exp (-1))^j := by
      apply sum_congr rfl
      intro j _
      rw [← Real.exp_nat_mul, mul_neg_one]
    _ ≤ ∑' j : ℕ, (Real.exp (-1))^j :=
      hs.summable.sum_le_tsum J (fun _ _ => by positivity)
    _ = _ := hs.tsum_eq

theorem block_sieve_factorial_tail_bound {C : ℝ} (hC : 0 ≤ C)
    {h : ℕ} (hh : 1 ≤ h) (J : Finset ℕ) :
    (∑ j ∈ J, C^((j + 1)*h + 1) / (((j + 1)*h + 1).factorial : ℝ)) ≤
      (Real.exp (C * Real.exp 1) / (1 - Real.exp (-1))) * Real.exp (-(h : ℝ)) := by
  have hterm (j : ℕ) :
      C^((j + 1)*h + 1) / (((j + 1)*h + 1).factorial : ℝ) ≤
        (Real.exp (C * Real.exp 1) * Real.exp (-(h : ℝ))) *
          Real.exp (-(j : ℝ)) := by
    have hn : h + j ≤ (j + 1)*h + 1 := by nlinarith
    have hn' : (h : ℝ) + j ≤ (((j + 1)*h + 1 : ℕ) : ℝ) := by exact_mod_cast hn
    calc
      _ ≤ Real.exp (C * Real.exp 1) *
          Real.exp (-((((j + 1)*h + 1 : ℕ) : ℝ))) := factorial_term_le_exp_decay hC _
      _ ≤ Real.exp (C * Real.exp 1) * Real.exp (-(h : ℝ) - (j : ℝ)) := by
        apply mul_le_mul_of_nonneg_left _ (Real.exp_pos _).le
        apply Real.exp_le_exp.mpr
        linarith
      _ = _ := by rw [sub_eq_add_neg, Real.exp_add]; ring
  calc
    _ ≤ ∑ j ∈ J, (Real.exp (C * Real.exp 1) * Real.exp (-(h : ℝ))) *
        Real.exp (-(j : ℝ)) := sum_le_sum (fun j _ => hterm j)
    _ = (Real.exp (C * Real.exp 1) * Real.exp (-(h : ℝ))) *
        (∑ j ∈ J, Real.exp (-(j : ℝ))) := (mul_sum ..).symm
    _ ≤ (Real.exp (C * Real.exp 1) * Real.exp (-(h : ℝ))) *
        (1 - Real.exp (-1))⁻¹ :=
      mul_le_mul_of_nonneg_left (finite_sum_exp_neg_nat_le J) (by positivity)
    _ = _ := by ring

theorem exists_block_sieve_factorial_tail_bound {C : ℝ} (hC : 0 ≤ C) :
    ∃ (H : ℕ) (K : ℝ), 0 ≤ K ∧ ∀ h ≥ H, ∀ J : Finset ℕ,
      (∑ j ∈ J, C^((j + 1)*h + 1) / (((j + 1)*h + 1).factorial : ℝ)) ≤
        K * Real.exp (-(h : ℝ)) := by
  refine ⟨1, Real.exp (C * Real.exp 1) / (1 - Real.exp (-1)), ?_, ?_⟩
  · apply div_nonneg (Real.exp_pos _).le
    exact sub_nonneg.mpr (Real.exp_lt_one_iff.mpr (by norm_num)).le
  · intro h hh J
    exact block_sieve_factorial_tail_bound hC hh J
end

section
open Finset
theorem block_sieve_dyadic_degree_sum (J : Finset ℕ) (h : ℕ) :
    (∑ j ∈ J, (((j + 1) * h + 1 : ℕ) : ℝ) / (2 : ℝ)^j) ≤ 4 * (h : ℝ) + 2 := by
  have hg : HasSum (fun j : ℕ => (1/2 : ℝ)^j) 2 := by
    convert! hasSum_geometric_of_lt_one (by norm_num : (0 : ℝ) ≤ 1/2)
      (by norm_num : (1/2 : ℝ) < 1) using 1; norm_num
  have hn : HasSum (fun j : ℕ => (j : ℝ) * (1/2 : ℝ)^j) 2 := by
    convert! hasSum_coe_mul_geometric_of_norm_lt_one
      (by norm_num : ‖(1/2 : ℝ)‖ < 1) using 1; norm_num
  have hall : HasSum (fun j : ℕ => (((j + 1) * h + 1 : ℕ) : ℝ) / (2 : ℝ)^j)
      (4 * (h : ℝ) + 2) := by
    convert! ((hn.add hg).mul_left (h : ℝ)).add hg using 1
    · ext j
      simp only [Nat.cast_add, Nat.cast_mul, Nat.cast_one, div_pow, one_pow]
      ring
    · ring
  exact (hall.summable.sum_le_tsum J (fun j _ => by positivity)).trans_eq hall.tsum_eq

theorem block_sieve_weighted_degree_sum (J : Finset ℕ) (h : ℕ) (n : ℕ → ℕ)
    (hn : ∀ j ∈ J, n j ≤ (j + 1) * h + 1) :
    (∑ j ∈ J, (n j : ℝ) / (2 : ℝ)^j) ≤ 4 * (h : ℝ) + 2 := by
  apply le_trans _ (block_sieve_dyadic_degree_sum J h)
  exact sum_le_sum (fun j hj => div_le_div_of_nonneg_right
    (Nat.cast_le.mpr (hn j hj)) (by positivity))

theorem block_sieve_log_product_level {ι : Type*} [DecidableEq ι]
    (J : Finset ℕ) (B : ℕ → Finset ι) (x : ι → ℝ) (h : ℕ) {z : ℝ}
    (hz : 1 ≤ z) (hdisj : (J : Set ℕ).PairwiseDisjoint B)
    (hpos : ∀ j ∈ J, ∀ p ∈ B j, 0 < x p)
    (hsize : ∀ j ∈ J, ∀ p ∈ B j, Real.log (x p) ≤ Real.log z / (2 : ℝ)^j)
    (hcard : ∀ j ∈ J, (B j).card ≤ (j + 1) * h + 1) :
    (∏ p ∈ J.biUnion B, x p) ≤ z^(4 * (h : ℝ) + 2) := by
  have hz0 : 0 < z := zero_lt_one.trans_le hz
  have hprodpos : 0 < ∏ p ∈ J.biUnion B, x p := by
    apply prod_pos
    intro p hp
    obtain ⟨j, hj, hp⟩ := mem_biUnion.mp hp
    exact hpos j hj p hp
  have hlog : Real.log (∏ p ∈ J.biUnion B, x p) ≤ (4 * (h : ℝ) + 2) * Real.log z := by
    rw [prod_biUnion hdisj, Real.log_prod (fun j hj => ne_of_gt (prod_pos (hpos j hj)))]
    calc
      _ = ∑ j ∈ J, ∑ p ∈ B j, Real.log (x p) := by
        apply sum_congr rfl
        intro j hj
        exact Real.log_prod (fun p hp => ne_of_gt (hpos j hj p hp))
      _ ≤ ∑ j ∈ J, ((B j).card : ℝ) * (Real.log z / (2 : ℝ)^j) := by
        apply sum_le_sum
        intro j hj
        exact (sum_le_sum (hsize j hj)).trans_eq (by simp)
      _ = (∑ j ∈ J, ((B j).card : ℝ) / (2 : ℝ)^j) * Real.log z := by
        rw [sum_mul]
        apply sum_congr rfl
        intro j _
        ring
      _ ≤ _ := mul_le_mul_of_nonneg_right
        (block_sieve_weighted_degree_sum J h (fun j => (B j).card) hcard) (Real.log_nonneg hz)
  rw [← Real.exp_log hprodpos, Real.rpow_def_of_pos hz0]
  exact Real.exp_le_exp.mpr (by simpa only [mul_comm (Real.log z)] using hlog)
end

section
open Finset
noncomputable def subsetPolynomial {ι : Type*} (P : Finset ι)
    (a : Finset ι → ℝ) (x : ι → ℝ) : ℝ :=
  ∑ S ∈ P.powerset, a S * ∏ p ∈ S, x p

theorem subset_polynomial_average_identity {ι Ω : Type*}
    (P : Finset ι) (T : Finset Ω) (a r : Finset ι → ℝ)
    (μ : Ω → ℝ) (x : Ω → ι → ℝ) (g : ι → ℝ) (X : ℝ)
    (hmoment : ∀ S ∈ P.powerset,
      (∑ t ∈ T, μ t * ∏ p ∈ S, x t p) = X * (∏ p ∈ S, g p) + r S) :
    (∑ t ∈ T, μ t * subsetPolynomial P a (x t)) - X * subsetPolynomial P a g =
      ∑ S ∈ P.powerset, a S * r S := by
  have heq : (∑ t ∈ T, μ t * subsetPolynomial P a (x t)) =
      ∑ S ∈ P.powerset, a S * (∑ t ∈ T, μ t * ∏ p ∈ S, x t p) := by
    simp only [subsetPolynomial, mul_sum]
    rw [sum_comm]
    apply sum_congr rfl
    intro S _
    apply sum_congr rfl
    intro t _
    ring
  rw [heq]
  have hmainsum : (∑ S ∈ P.powerset, a S * (∑ t ∈ T, μ t * ∏ p ∈ S, x t p)) =
      ∑ S ∈ P.powerset, a S * (X * (∏ p ∈ S, g p) + r S) := by
    apply sum_congr rfl
    intro S hS
    rw [hmoment S hS]
  rw [hmainsum]
  simp only [subsetPolynomial, mul_add, sum_add_distrib, mul_sum]
  have hmain : (∑ S ∈ P.powerset, a S * (X * ∏ p ∈ S, g p)) =
      ∑ S ∈ P.powerset, X * (a S * ∏ p ∈ S, g p) := by
    apply sum_congr rfl
    intro S _
    ring
  rw [hmain]
  ring

theorem subset_polynomial_average_error {ι Ω : Type*}
    (P : Finset ι) (T : Finset Ω) (a r : Finset ι → ℝ)
    (μ : Ω → ℝ) (x : Ω → ι → ℝ) (g : ι → ℝ) (X : ℝ)
    (ha : ∀ S ∈ P.powerset, |a S| ≤ 1)
    (hmoment : ∀ S ∈ P.powerset,
      (∑ t ∈ T, μ t * ∏ p ∈ S, x t p) = X * (∏ p ∈ S, g p) + r S) :
    |(∑ t ∈ T, μ t * subsetPolynomial P a (x t)) - X * subsetPolynomial P a g| ≤
      ∑ S ∈ P.powerset, if a S = 0 then 0 else |r S| := by
  classical
  rw [subset_polynomial_average_identity P T a r μ x g X hmoment]
  apply (abs_sum_le_sum_abs _ _).trans
  apply sum_le_sum
  intro S hS
  by_cases hzero : a S = 0
  · simp [hzero]
  · rw [if_neg hzero, abs_mul]
    exact mul_le_of_le_one_left (abs_nonneg _) (ha S hS)

theorem subset_polynomial_sandwich_transfer {ι Ω : Type*}
    (P : Finset ι) (T : Finset Ω) (a b : Finset ι → ℝ)
    (μ F : Ω → ℝ) (x : Ω → ι → ℝ) (g : ι → ℝ) (X A E R : ℝ)
    (hμ : ∀ t ∈ T, 0 ≤ μ t) (hX : 0 ≤ X)
    (hpoint : ∀ t ∈ T, subsetPolynomial P b (x t) ≤ F t ∧
      F t ≤ subsetPolynomial P a (x t))
    (hmodela : |subsetPolynomial P a g - A| ≤ E)
    (hmodelb : |subsetPolynomial P b g - A| ≤ E)
    (herra : |(∑ t ∈ T, μ t * subsetPolynomial P a (x t)) - X * subsetPolynomial P a g| ≤ R)
    (herrb : |(∑ t ∈ T, μ t * subsetPolynomial P b (x t)) - X * subsetPolynomial P b g| ≤ R) :
    |(∑ t ∈ T, μ t * F t) - X * A| ≤ X * E + R := by
  have hlo : (∑ t ∈ T, μ t * subsetPolynomial P b (x t)) ≤ ∑ t ∈ T, μ t * F t :=
    sum_le_sum (fun t ht => mul_le_mul_of_nonneg_left (hpoint t ht).1 (hμ t ht))
  have hhi : (∑ t ∈ T, μ t * F t) ≤ ∑ t ∈ T, μ t * subsetPolynomial P a (x t) :=
    sum_le_sum (fun t ht => mul_le_mul_of_nonneg_left (hpoint t ht).2 (hμ t ht))
  have hma := mul_le_mul_of_nonneg_left (abs_le.mp hmodela).2 hX
  have hmb := mul_le_mul_of_nonneg_left (abs_le.mp hmodelb).1 hX
  apply abs_le.mpr
  constructor <;> nlinarith [(abs_le.mp herra).2, (abs_le.mp herrb).1]
end

section
open Finset
def physicalResidueAbsoluteHit {G : Type*} {P : G → Finset ℕ} {n : ℕ}
    (a : Fin (n + 1) → ℤ) (g : G) (p : ↥(P g)) (j : ℕ) : ZMod p.val :=
  -(a (globalBirthFiniteIndex n j) : ZMod p.val)

theorem physical_residue_absolute_hit_step {G : Type*} {P : G → Finset ℕ} {n : ℕ}
    (a : Fin (n + 1) → ℤ) (g : G) (j : Fin n) (p : ↥(P g)) :
    physicalResidueAbsoluteHit a g p (j.val + 1) - physicalResidueAbsoluteHit a g p j.val =
      physicalGroupPhaseDelta (a j.castSucc) (a j.succ) g p := by
  unfold physicalResidueAbsoluteHit
  rw [show globalBirthFiniteIndex n (j.val + 1) = j.succ from global_birth_finite_index_at j.succ]
  rw [show globalBirthFiniteIndex n j.val = j.castSucc from global_birth_finite_index_at j.castSucc]
  exact (physical_group_phase_delta_eq_hit_difference _ _ g p).symm

section ResiduePath
variable {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell n : ℕ}
  (C : Fin n → G → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations G J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (ζ : ∀ p : PhysicalPrime P, ZMod p.2.val)
  (hmarks : ∀ j : Fin (n + 1), ∀ p ∈ physicalMarkedPrimes (L j),
    ζ p = -(a j : ZMod p.2.val))

variable
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (g : G)
  (hk : ∀ j : Fin n, ∀ s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : ↥(P g) → ℝ) (η : Fin (n + 1) → ℝ) (V ρ : ℝ) (hV : V ≠ 0) (cap : ℕ)

noncomputable def physicalResidueFiniteEdge (j : Fin n) :
    GlobalBirthRawStep (R := fun p : ↥(P g) => ZMod p.val)
      (physicalGroupBareFiniteActivity L g j.castSucc) (physicalGroupBareFiniteActivity L g j.succ) :=
  physicalGroupBareFiniteEdge C aux k L a σ τ hlist hP hdis
    (physical_group_residue_path_compatibility C aux k L a σ τ hstep ζ hmarks)
    g hk β V ρ cap j

noncomputable def physicalResidueCappedVisitKernel (j : ℕ) :
    ((p : ↥(P g)) → GhostPhaseState (ZMod p.val)) →
    ((p : ↥(P g)) → GhostPhaseState (ZMod p.val)) → ℝ :=
  ghostPhaseCappedDampedVisit
    (globalBirthFiniteActivity (physicalGroupBareFiniteActivity L g) j) (fun _ => 0)
    (fun _ => η (globalBirthFiniteIndex n j)) β (fun _ => ρ) cap

variable [∀ p : ↥(P g), NeZero p.val]

noncomputable def physicalResidueCappedMovingEdgeKernel (j : ℕ) :
    ((p : ↥(P g)) → GhostPhaseState (ZMod p.val)) →
    ((p : ↥(P g)) → GhostPhaseState (ZMod p.val)) → ℝ :=
  ghostPhaseCappedDampedMovingEdge
    (globalBirthFiniteActivity (physicalGroupBareFiniteActivity L g) (j + 1))
    (globalBirthFiniteActivity (physicalGroupBareFiniteActivity L g) j)
    (fun p => physicalResidueAbsoluteHit a g p (j + 1) - physicalResidueAbsoluteHit a g p j)
    β (fun _ => V) (fun _ => ρ) (fun _ => ρ) cap

omit [Fintype G] in
theorem physical_residue_visit_kernel_to_real (j : Fin (n + 1))
    (z w : (p : ↥(P g)) → GhostPhaseState (ZMod p.val)) :
    globalBirthRawStepKernel (physicalGroupBareFiniteVisit L g β η V ρ hV cap j) z w =
      (physicalResidueCappedVisitKernel L g β η ρ cap j.val z w : ℂ) := by
  unfold physicalResidueCappedVisitKernel
  rw [global_birth_finite_activity_at, global_birth_finite_index_at]
  change globalBirthRawStepKernel (.visit (a := physicalGroupPhaseActivity (L j) g)
    (fun _ => 0) β (η j) V ρ hV cap) z w = _
  rw [global_birth_raw_step_kernel_visit]
  unfold ghostPhaseCappedDampedVisit
  split_ifs <;> rfl

theorem physical_residue_edge_kernel_to_real (j : Fin n)
    (z w : (p : ↥(P g)) → GhostPhaseState (ZMod p.val)) :
    globalBirthRawStepKernel
      (physicalResidueFiniteEdge C aux k L a σ τ hstep ζ hmarks hlist hP hdis g hk β V ρ cap j) z w =
      (physicalResidueCappedMovingEdgeKernel L a g β V ρ cap j.val z w : ℂ) := by
  unfold physicalResidueCappedMovingEdgeKernel
  rw [show globalBirthFiniteActivity (physicalGroupBareFiniteActivity L g) (j.val + 1) =
      physicalGroupBareFiniteActivity L g j.succ from
    global_birth_finite_activity_at _ j.succ]
  rw [show globalBirthFiniteActivity (physicalGroupBareFiniteActivity L g) j.val =
      physicalGroupBareFiniteActivity L g j.castSucc from
    global_birth_finite_activity_at _ j.castSucc]
  simp_rw [physical_residue_absolute_hit_step a g j]
  refine (physical_group_permuted_bare_raw_edge_kernel (C j) (aux j) (k j)
    (L j.castSucc) (L j.succ) (a j.castSucc) (σ j) (τ j) (hlist j) hP hdis
    (physical_group_residue_path_compatibility C aux k L a σ τ hstep ζ hmarks j)
    g (hk j) β ρ V cap z w).trans ?_
  simp only [physicalGroupBareRawEdge, global_birth_raw_step_kernel_edge,
    ← hstep j, physical_group_phase_activity_permute]
  unfold ghostPhaseCappedDampedMovingEdge
  split_ifs <;> rfl

/-- The finite atomic physical kernels are exactly the real capped kernels,
after their canonical complex embedding. Only used time indices are compared. -/
theorem physical_residue_atomic_kernel_to_real (i : ℕ) (hi : i < 2 * n + 1)
    (z w : (p : ↥(P g)) → GhostPhaseState (ZMod p.val)) :
    globalBirthRawStepKernel
      (physicalGroupResidueFiniteStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis g hk β η V ρ hV cap i) z w =
      ((finiteAlternatingKernel (physicalResidueCappedVisitKernel L g β η ρ cap)
        (physicalResidueCappedMovingEdgeKernel L a g β V ρ cap) i z w : ℝ) : ℂ) := by
  by_cases hp : i % 2 = 0
  · let j : Fin (n + 1) := ⟨i / 2, by omega⟩
    have hi' : i = 2 * j.val := by dsimp [j]; omega
    rw [hi', finite_alternating_kernel_even]
    exact (global_birth_finite_alternating_kernel_even (physicalGroupBareFiniteActivity L g)
      (physicalGroupBareFiniteVisit L g β η V ρ hV cap)
      (physicalResidueFiniteEdge C aux k L a σ τ hstep ζ hmarks hlist hP hdis g hk β V ρ cap) j z w).trans
      (physical_residue_visit_kernel_to_real L g β η V ρ hV cap j z w)
  · let j : Fin n := ⟨i / 2, by omega⟩
    have hi' : i = 2 * j.val + 1 := by dsimp [j]; omega
    rw [hi', finite_alternating_kernel_odd]
    exact (global_birth_finite_alternating_kernel_odd (physicalGroupBareFiniteActivity L g)
      (physicalGroupBareFiniteVisit L g β η V ρ hV cap)
      (physicalResidueFiniteEdge C aux k L a σ τ hstep ζ hmarks hlist hP hdis g hk β V ρ cap) j z w).trans
      (physical_residue_edge_kernel_to_real C aux k L a σ τ hstep ζ hmarks hlist hP hdis g hk β V ρ cap j z w)

/-- Exact real/complex identification of the existing normalized physical
history, including both endpoint permutations and all atomic memory caps. -/
theorem physical_residue_normalized_history_eq_capped_moving :
    ((∏ s : PhysicalSlots J ell, β ((L 0) g s) / V : ℝ) : ℂ) *
      physicalGroupResidueFiniteRawHistory C aux k L a σ τ hstep ζ hmarks hlist hP hdis g hk β η V ρ hV cap =
      (ghostPhaseCappedMovingDampedHistory
        (fun p j => globalBirthFiniteActivity (physicalGroupBareFiniteActivity L g) j p)
        (physicalResidueAbsoluteHit a g) (fun _ j => η (globalBirthFiniteIndex n j))
        β (fun _ => V) (fun _ _ => ρ) (fun _ => cap) (fun _ => cap) n : ℂ) := by
  rw [physical_group_residue_normalized_history_trace]
  have he := complex_trace_eq_real_alternating
    (physicalResidueCappedVisitKernel L g β η ρ cap)
    (physicalResidueCappedMovingEdgeKernel L a g β V ρ cap)
    (fun i => globalBirthRawStepKernel
      (physicalGroupResidueFiniteStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis g hk β η V ρ hV cap i))
    (fun z => ∏ p, ghostPhaseRunInitial (physicalGroupPhaseActivity (L 0) g p)
      (β p) V (z p))
    (fun z => ∏ p, ghostPhaseTerminal
      (physicalGroupPhaseActivity (L (Fin.last n)) g p) (z p)) n
    (physical_residue_atomic_kernel_to_real C aux k L a σ τ hstep ζ hmarks hlist hP hdis g hk β η V ρ hV cap)
  have h0 : globalBirthFiniteActivity (physicalGroupBareFiniteActivity L g) 0 =
      physicalGroupPhaseActivity (L 0) g :=
    global_birth_finite_activity_at (physicalGroupBareFiniteActivity L g) (0 : Fin (n + 1))
  have hn : globalBirthFiniteActivity (physicalGroupBareFiniteActivity L g) n =
      physicalGroupPhaseActivity (L (Fin.last n)) g :=
    global_birth_finite_activity_at (physicalGroupBareFiniteActivity L g) (Fin.last n)
  refine he.trans ?_
  congr 1
  unfold ghostPhaseCappedMovingDampedHistory
  change finiteAlternatingPairing _ _ _ _ n =
    finiteAlternatingPairing (physicalResidueCappedVisitKernel L g β η ρ cap)
      (physicalResidueCappedMovingEdgeKernel L a g β V ρ cap) _ _ n
  dsimp only
  rw [h0, hn]

/-- Auxiliary rho and moving frames are removed from the actual physical
history under rho != 0. The exact visit and edge cutoff remains in force. -/
theorem physical_residue_normalized_history_eq_capped_absolute (hρ : ρ ≠ 0) :
    ((∏ s : PhysicalSlots J ell, β ((L 0) g s) / V : ℝ) : ℂ) *
      physicalGroupResidueFiniteRawHistory C aux k L a σ τ hstep ζ hmarks hlist hP hdis g hk β η V ρ hV cap =
      (ghostPhaseCappedHistory
        (fun p j => globalBirthFiniteActivity (physicalGroupBareFiniteActivity L g) j p)
        (physicalResidueAbsoluteHit a g) (fun _ j => η (globalBirthFiniteIndex n j))
        β (fun _ => V) (fun _ => cap) (fun _ => cap) n : ℂ) := by
  rw [physical_residue_normalized_history_eq_capped_moving]
  rw [ghost_phase_capped_moving_history_eq_undamped _ _ _ _ _ _ _ _ (fun _ _ => hρ)]

/-- When the cap is at least the whole group pool, it excludes no phase
state and the actual normalized physical history is the product of the
original one-prime lifespan histories. -/
theorem physical_residue_normalized_history_eq_run_product (hρ : ρ ≠ 0)
    (hcap : (P g).card ≤ cap) :
    ((∏ s : PhysicalSlots J ell, β ((L 0) g s) / V : ℝ) : ℂ) *
      physicalGroupResidueFiniteRawHistory C aux k L a σ τ hstep ζ hmarks hlist hP hdis g hk β η V ρ hV cap =
      ((∏ p : ↥(P g), ghostPhaseRunHistory
        (fun j => globalBirthFiniteActivity (physicalGroupBareFiniteActivity L g) j p)
        (physicalResidueAbsoluteHit a g p) (fun j => η (globalBirthFiniteIndex n j))
        (β p) V n : ℝ) : ℂ) := by
  have hc : Fintype.card ↥(P g) ≤ cap := by simpa only [Fintype.card_coe] using hcap
  rw [physical_residue_normalized_history_eq_capped_absolute C aux k L a σ τ hstep ζ hmarks hlist hP hdis g hk
    β η V ρ hV cap hρ]
  rw [ghost_phase_capped_history_eq_run_product _ _ _ _ _ _ _ (fun _ => hc) (fun _ => hc)]

end ResiduePath
end

section
open Finset
section Groups
variable {G : Type*} [Fintype G] {P : G → Type*} [∀ g, Fintype (P g)]
  {R : (g : G) → P g → Type*} [∀ g p, DecidableEq (R g p)]

theorem ghost_phase_grouped_capped_visit
    (a : (g : G) → P g → Bool) (h : (g : G) → (p : P g) → R g p)
    (η β ρ : (g : G) → P g → ℝ) (cap : ℕ)
    (z w : (g : G) → (p : P g) → GhostPhaseState (R g p)) :
    (if (∑ g, (ghostPhasePendingSupport (z g)).card) ≤ cap then
      ∏ g, ghostPhaseCappedDampedVisit (a g) (h g) (η g) (β g) (ρ g) cap (z g) (w g)
    else 0) =
    ghostPhaseCappedDampedVisit (fun p : Σ g, P g => a p.1 p.2)
      (fun p => h p.1 p.2) (fun p => η p.1 p.2) (fun p => β p.1 p.2)
      (fun p => ρ p.1 p.2) cap (globalBirthFlattenPhase z) (globalBirthFlattenPhase w) := by
  classical
  unfold ghostPhaseCappedDampedVisit
  rw [global_birth_flatten_pending_card]
  split_ifs with hz
  · rw [Fintype.prod_sigma]
    apply prod_congr rfl
    intro g _
    have hg : (ghostPhasePendingSupport (z g)).card ≤ cap :=
      (single_le_sum (fun i _ => Nat.zero_le _) (mem_univ g)).trans hz
    rw [if_pos hg]
    rfl
  · rfl

variable [∀ g p, AddGroup (R g p)] [∀ g p, Fintype (R g p)]

theorem ghost_phase_grouped_capped_moving_edge
    (atgt asrc : (g : G) → P g → Bool) (δ : (g : G) → (p : P g) → R g p)
    (β V ρtgt ρsrc : (g : G) → P g → ℝ) (cap : ℕ)
    (z w : (g : G) → (p : P g) → GhostPhaseState (R g p)) :
    (if (∑ g, (ghostPhasePendingSupport (z g)).card) ≤ cap then
      ∏ g, ghostPhaseCappedDampedMovingEdge (atgt g) (asrc g) (δ g) (β g) (V g)
        (ρtgt g) (ρsrc g) cap (z g) (w g)
    else 0) =
    ghostPhaseCappedDampedMovingEdge (fun p : Σ g, P g => atgt p.1 p.2)
      (fun p => asrc p.1 p.2) (fun p => δ p.1 p.2) (fun p => β p.1 p.2)
      (fun p => V p.1 p.2) (fun p => ρtgt p.1 p.2) (fun p => ρsrc p.1 p.2)
      cap (globalBirthFlattenPhase z) (globalBirthFlattenPhase w) := by
  classical
  unfold ghostPhaseCappedDampedMovingEdge
  rw [global_birth_flatten_pending_card]
  split_ifs with hz
  · rw [Fintype.prod_sigma]
    apply prod_congr rfl
    intro g _
    have hg : (ghostPhasePendingSupport (z g)).card ≤ cap :=
      (single_le_sum (fun i _ => Nat.zero_le _) (mem_univ g)).trans hz
    rw [if_pos hg]
    rfl
  · rfl

end Groups
end

section
open Finset
def globalBirthFlattenEquiv {G : Type*} {P : G → Type*}
    {R : (g : G) → P g → Type*} :
    ((g : G) → (p : P g) → GhostPhaseState (R g p)) ≃
      ((p : Σ g, P g) → GhostPhaseState (R p.1 p.2)) where
  toFun z p := z p.1 p.2
  invFun z g p := z ⟨g, p⟩
  left_inv _z := rfl
  right_inv _z := rfl

theorem finite_alternating_pairing_fixed_equiv {X Y : Type*} [Fintype X] [Fintype Y]
    (e : X ≃ Y) (G E : ℕ → X → X → ℝ) (f q : X → ℝ) (n : ℕ) :
    finiteAlternatingPairing
      (fun j y z => G j (e.symm y) (e.symm z))
      (fun j y z => E j (e.symm y) (e.symm z))
      (fun y => f (e.symm y)) (fun y => q (e.symm y)) n =
    finiteAlternatingPairing G E f q n := by
  have hK : finiteAlternatingKernel
      (fun j y z => G j (e.symm y) (e.symm z))
      (fun j y z => E j (e.symm y) (e.symm z)) =
      (fun j y z => finiteAlternatingKernel G E j (e.symm y) (e.symm z)) := by
    funext j y z
    unfold finiteAlternatingKernel
    split_ifs <;> rfl
  unfold finiteAlternatingPairing
  rw [hK, ← e.sum_comp]
  apply sum_congr rfl
  intro x _
  dsimp only
  rw [Equiv.symm_apply_apply]
  exact congrArg (q x * ·) (finite_path_action_conjugate (fun _ => e)
    (finiteAlternatingKernel G E) f (2 * n + 1) x)

theorem complex_trace_eq_real_alternating_equiv {X Y : Type*} [Fintype X] [Fintype Y]
    (e : X ≃ Y) (G E : ℕ → Y → Y → ℝ) (K : ℕ → X → X → ℂ)
    (f q : Y → ℝ) (n : ℕ)
    (hK : ∀ j < 2 * n + 1, ∀ z w,
      K j z w = ((finiteAlternatingKernel G E j (e z) (e w) : ℝ) : ℂ)) :
    (∑ x : Fin (2 * n + 2) → X,
      (q (e (x (Fin.last (2 * n + 1)))) : ℂ) *
        ((f (e (x 0)) : ℂ) * ∏ j : Fin (2 * n + 1), K j.val (x j.succ) (x j.castSucc))) =
      (finiteAlternatingPairing G E f q n : ℂ) := by
  have h := complex_trace_eq_real_alternating
    (fun j z w => G j (e z) (e w)) (fun j z w => E j (e z) (e w)) K
    (fun x => f (e x)) (fun x => q (e x)) n (by
      intro j hj z w
      by_cases hp : j % 2 = 0
      · simpa only [finiteAlternatingKernel, hp, ite_true] using hK j hj z w
      · simpa only [finiteAlternatingKernel, hp, ite_false] using hK j hj z w)
  rw [h]
  exact congrArg (fun r : ℝ => (r : ℂ))
    (finite_alternating_pairing_fixed_equiv e.symm G E f q n)
end

section
open Finset
theorem fin_tensor_row_events (n : ℕ) {S T : Fin n → Type*}
    (E : (g : Fin n) → S g → Type*) [∀ g s, Fintype (E g s)]
    (target : ∀ g s, E g s → T g) (weight : ∀ g s, E g s → ℂ)
    (F : ((g : Fin n) → T g) → ℂ) (s : (g : Fin n) → S g) :
    finTensorRow n (fun g G x => ∑ e : E g x, weight g x e * G (target g x e)) F s =
      ∑ e : (g : Fin n) → E g (s g),
        (∏ g, weight g (s g) (e g)) * F (fun g => target g (s g) (e g)) := by
  classical
  induction n with
  | zero =>
      simp only [finTensorRow, Fintype.prod_empty, one_mul, Fintype.sum_unique]
      exact congrArg F (Subsingleton.elim _ _)
  | succ n ih =>
      simp only [finTensorRow, ih, mul_sum]
      rw [← (Fin.consEquiv (fun g => E g (s g))).sum_comp]
      rw [Fintype.sum_prod_type]
      apply sum_congr rfl
      intro t _
      apply sum_congr rfl
      intro u _
      simp only [Fin.consEquiv, Equiv.coe_fn_mk, Fin.prod_univ_succ, Fin.tail]
      rw [mul_assoc]
      congr 1
      congr 1
      apply congrArg F
      funext g
      refine Fin.cases ?_ (fun j => ?_) g <;> rfl
end

section
open Finset Classical
noncomputable def activeTupleSplit {P : Type*} {M : ℕ} (S : Finset (Fin M)) :
    (Fin M → P) ≃ (Fin S.card → P) × (Fin Sᶜ.card → P) where
  toFun x := (fun j => x (S.equivFin.symm j), fun j => x (Sᶜ.equivFin.symm j))
  invFun y i := if h : i ∈ S then y.1 (S.equivFin ⟨i, h⟩)
    else y.2 (Sᶜ.equivFin ⟨i, mem_compl.mpr h⟩)
  left_inv x := by
    funext i
    by_cases h : i ∈ S <;> simp [h]
  right_inv y := by
    apply Prod.ext
    · funext j
      have h : (S.equivFin.symm j).val ∈ S := (S.equivFin.symm j).property
      simp [h]
    · funext j
      have h : (Sᶜ.equivFin.symm j).val ∉ S := mem_compl.mp (Sᶜ.equivFin.symm j).property
      simp [h]

theorem activeTupleSplit_weight {P : Type*} {M : ℕ} (S : Finset (Fin M))
    (μ : P → ℝ) (x : Fin M → P) :
    (∏ i, μ (x i)) =
      (∏ i, μ ((activeTupleSplit S x).1 i)) * (∏ i, μ ((activeTupleSplit S x).2 i)) := by
  have h : (∏ i : ↥S, μ (x i)) * (∏ i : ↥Sᶜ, μ (x i)) = ∏ i, μ (x i) := by
    rw [prod_coe_sort S (fun i => μ (x i)), prod_coe_sort Sᶜ (fun i => μ (x i))]
    exact prod_mul_prod_compl S (fun i => μ (x i))
  rw [← h]
  congr 1
  · exact (Equiv.prod_comp S.equivFin.symm (fun i : ↥S => μ (x i))).symm
  · exact (Equiv.prod_comp Sᶜ.equivFin.symm (fun i : ↥Sᶜ => μ (x i))).symm

noncomputable def activeMemorySplit {P Z : Type*} {M : ℕ}
    (S : Finset (Fin M)) (B : ℕ) :
    BoundedOrderedState P Z M B ≃
      (Fin S.card → P) × BoundedOrderedState P Z Sᶜ.card B :=
  (Equiv.prodCongr (activeTupleSplit S) (Equiv.refl (BoundedOrderedTuple Z B))).trans
    (Equiv.prodAssoc _ _ _)

theorem activeMemorySplit_memory {P Z : Type*} {M : ℕ}
    (S : Finset (Fin M)) (B : ℕ) (x : BoundedOrderedState P Z M B) :
    (activeMemorySplit S B x).2.2 = x.2 := rfl

theorem activeMemorySplit_weight {P Z : Type*} {M : ℕ}
    (S : Finset (Fin M)) (B : ℕ) (μ : P → ℝ) (ν : Z → ℝ)
    (x : BoundedOrderedState P Z M B) :
    boundedOrderedStateWeight μ ν x =
      (∏ i, μ ((activeMemorySplit S B x).1 i)) *
        boundedOrderedStateWeight μ ν (activeMemorySplit S B x).2 := by
  change (∏ i, μ (x.1 i)) * boundedOrderedMemoryWeight ν x.2 =
    (∏ i, μ ((activeTupleSplit S x.1).1 i)) *
      ((∏ i, μ ((activeTupleSplit S x.1).2 i)) * boundedOrderedMemoryWeight ν x.2)
  rw [activeTupleSplit_weight S μ x.1]
  exact mul_assoc _ _ _
end

section
open Finset Classical
def equivFiberSlice {X C Y : Type*} (e : X ≃ C × Y) (f : X → ℂ) (c : C) (y : Y) : ℂ :=
  f (e.symm (c, y))

noncomputable def equivFiberAverageLift {X C Y : Type*} {A : C → Type*}
    [∀ c, Fintype (A c)] (e : X ≃ C × Y) (ν : ∀ c, A c → ℝ)
    (T : ∀ c, A c → (Y → ℂ) → Y → ℂ) (f : X → ℂ) (x : X) : ℂ :=
  finiteFiberAverage ν T (equivFiberSlice e f) (e x).1 (e x).2

theorem equivFiberSlice_average_lift {X C Y : Type*} {A : C → Type*}
    [∀ c, Fintype (A c)] (e : X ≃ C × Y) (ν : ∀ c, A c → ℝ)
    (T : ∀ c, A c → (Y → ℂ) → Y → ℂ) (f : X → ℂ) :
    equivFiberSlice e (equivFiberAverageLift e ν T f) =
      finiteFiberAverage ν T (equivFiberSlice e f) := by
  funext c y
  simp only [equivFiberSlice, equivFiberAverageLift, Equiv.apply_symm_apply]

theorem finite_energy_equiv_fibers {X C Y : Type*}
    [Fintype X] [Fintype C] [Fintype Y]
    (e : X ≃ C × Y) (W : X → ℝ) (κ : C → ℝ) (μ : Y → ℝ)
    (hW : ∀ c y, W (e.symm (c, y)) = κ c * μ y) (f : X → ℂ) :
    finiteWeightedEnergy W f = finiteFiberEnergy κ (fun _ => μ) (equivFiberSlice e f) := by
  unfold finiteWeightedEnergy finiteFiberEnergy
  rw [← Equiv.sum_comp e.symm, Fintype.sum_prod_type]
  simp only [hW, finiteWeightedEnergy, equivFiberSlice, mul_sum, mul_assoc]

theorem equiv_fiber_average_lift_energy_le {X C Y : Type*}
    [Fintype X] [Fintype C] [Fintype Y] {A : C → Type*} [∀ c, Fintype (A c)]
    (e : X ≃ C × Y) (W : X → ℝ) (κ : C → ℝ) (μ : Y → ℝ)
    (hW : ∀ c y, W (e.symm (c, y)) = κ c * μ y)
    (hκ : ∀ c, 0 ≤ κ c) (hμ : ∀ y, 0 ≤ μ y)
    (ν : ∀ c, A c → ℝ) (hν : ∀ c a, 0 ≤ ν c a) (hνmass : ∀ c, ∑ a, ν c a ≤ 1)
    (T : ∀ c, A c → (Y → ℂ) → Y → ℂ) {L : ℝ} (hL : 0 ≤ L) (f : X → ℂ)
    (hT : ∀ c a, finiteWeightedEnergy μ (T c a (equivFiberSlice e f c)) ≤
      L * finiteWeightedEnergy μ (equivFiberSlice e f c)) :
    finiteWeightedEnergy W (equivFiberAverageLift e ν T f) ≤ L * finiteWeightedEnergy W f := by
  rw [finite_energy_equiv_fibers e W κ μ hW, equivFiberSlice_average_lift,
    finite_energy_equiv_fibers e W κ μ hW]
  exact finite_fiber_average_energy_le κ (fun _ => μ) ν hκ (fun _ => hμ)
    hν hνmass T (equivFiberSlice e f) hL hT
end

section
open scoped BigOperators Classical
noncomputable def primeProductIdealKernel {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ) (Q : ℕ) (h : ℝ) (kept : Finset ℤ)
    (x y : ∀ j, P j) : ℂ :=
  finiteCellFrameKernel (finiteProductWeight (physicalLabelLaw V))
    (fun z => upperLogCell h (Real.log (∏ j, (z j).val : ℕ))) kept
    (fun t : BoundedPrimitiveCharacter Q => fun z =>
      star (boundedPrimitiveValue t ((∏ j, (z j).val : ℕ) : ZMod (boundedPrimitiveModulus t)))) x y

theorem prime_above_modulus_coprime {p q Q : ℕ} (hp : p.Prime)
    (hq : 0 < q) (hqQ : q ≤ Q) (hQp : Q < p) : p.Coprime q := by
  apply hp.coprime_iff_not_dvd.mpr
  intro hd
  have := Nat.le_of_dvd hq hd
  omega

theorem bounded_primitive_smallness (Q : ℕ) {V C a ξ : ℝ}
    (hV : 0 < V) (hC : 0 < C) (ha : 2 ≤ a) (hQ : 0 < Q) (hξ : 0 < ξ)
    (hsmall : (Q * Q - 1 : ℕ) *
      (((C / V) * a ^ (-(1 : ℝ) / 32) *
        (1 + Real.log (Q * Q : ℕ) / Real.log a)) / ξ) ≤ 1) :
    (Fintype.card (BoundedPrimitiveCharacter Q) - 1 : ℕ) *
      (((C / V) * a ^ (-(1 : ℝ) / 32) *
        (1 + Real.log (Q * Q : ℕ) / Real.log a)) / ξ) ≤ 1 := by
  have hlog : 0 < Real.log a := Real.log_pos (by linarith)
  have hQ1 : (1 : ℝ) ≤ (Q * Q : ℕ) := by
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr
      (Nat.mul_ne_zero (Nat.ne_of_gt hQ) (Nat.ne_of_gt hQ))
  have hδ : 0 ≤ ((C / V) * a ^ (-(1 : ℝ) / 32) *
      (1 + Real.log (Q * Q : ℕ) / Real.log a)) / ξ := by
    have := Real.log_nonneg hQ1
    positivity
  have hcard : (Fintype.card (BoundedPrimitiveCharacter Q) - 1 : ℕ) ≤ Q * Q - 1 :=
    Nat.sub_le_sub_right (bounded_primitive_character_card_le Q) 1
  exact (mul_le_mul_of_nonneg_right (by exact_mod_cast hcard) hδ).trans hsmall

theorem prime_product_ideal_kernel_energy (hZ : PrimitiveZeroFreeHalfPlane) :
    ∃ C : ℝ, 0 < C ∧ ∀ Q : ℕ, 0 < Q →
      ∀ {I : Type*} [Fintype I] [DecidableEq I],
      ∀ (P : I → Finset ℕ) (V : I → ℝ) (i : I),
      (∀ j, 0 < V j) →
      (∀ j p, p ∈ P j → p.Prime ∧ Q < p) →
      (∀ j, ∑ p ∈ P j, 1 / (p : ℝ) = V j) →
      ∀ a b : ℝ, P i = primeBand a b → 2 ≤ a → 0 ≤ b →
      ∀ h ξ : ℝ, 0 < h → 0 < ξ → ∀ kept : Finset ℤ,
      (∀ d ∈ kept, ξ ≤ finiteCellMass (finiteProductWeight (physicalLabelLaw (P := P) V))
        (fun x => upperLogCell h (Real.log (∏ j, (x j).val : ℕ))) d) →
      (Q * Q - 1 : ℕ) *
        (((C / V i) * a ^ (-(1 : ℝ) / 32) *
          (1 + Real.log (Q * Q : ℕ) / Real.log a)) / ξ) ≤ 1 →
      ∀ f : (∀ j, P j) → ℂ,
        (∑ x, finiteProductWeight (physicalLabelLaw V) x *
          ‖∑ y, (finiteProductWeight (physicalLabelLaw V) y : ℂ) *
            primeProductIdealKernel P V Q h kept x y * f y‖ ^ 2) ≤
        4 * ∑ x, finiteProductWeight (physicalLabelLaw V) x * ‖f x‖ ^ 2 := by
  obtain ⟨C, hC, hbnd⟩ := prime_tuple_log_cell_kernel_energy hZ
  refine ⟨C, hC, ?_⟩
  intro Q hQ I _ _ P V i hV hp hmass a b hPi ha hb h ξ hh hξ kept hkept hsmall f
  have hs := bounded_primitive_smallness Q (hV i) hC ha hQ hξ hsmall
  change _ ≤ _
  unfold primeProductIdealKernel
  have test := hbnd (T := BoundedPrimitiveCharacter Q) boundedPrimitiveModulus boundedPrimitiveValue
    bounded_primitive_modulus_pos bounded_primitive_value_primitive
    (bounded_primitive_character_injective Q) Q hQ bounded_primitive_modulus_le
    P V i hV (fun j p h => (hp j p h).1.pos) hmass
    (fun t j p h => prime_above_modulus_coprime (hp j p h).1
      (bounded_primitive_modulus_pos t) (bounded_primitive_modulus_le t) (hp j p h).2)
    a b hPi ha hb h ξ hh hξ kept hkept hs f
  exact test
end

section
open scoped BigOperators Classical
noncomputable def finiteCoordinateAverage {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ) (i : I)
    (f : (∀ j, X j) → ℂ) : (∀ j, X j) → ℂ :=
  finiteCoordinateLift i (fun v _ => ∑ y, (μ i y : ℂ) * v y) f

theorem finite_coordinate_average_update {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ) (i : I)
    (f : (∀ j, X j) → ℂ) (x : ∀ j, X j) :
    finiteCoordinateAverage μ i f x = ∑ y, (μ i y : ℂ) * f (Function.update x i y) := by
  exact finite_coordinate_lift_eq_update i _ f x

theorem finite_coordinate_average_split {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ) (i : I)
    (f : (∀ j, X j) → ℂ) (y : X i) (z : ∀ j : {j : I // j ≠ i}, X j.val) :
    finiteCoordinateAverage μ i f ((Equiv.piSplitAt i X).symm (y, z)) =
      ∑ y', (μ i y' : ℂ) * f ((Equiv.piSplitAt i X).symm (y', z)) := by
  exact finite_coordinate_lift_split i _ f y z

theorem finite_coordinate_average_invariant {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ) (i : I)
    (f : (∀ j, X j) → ℂ) (x : ∀ j, X j) (y : X i) :
    finiteCoordinateAverage μ i f (Function.update x i y) = finiteCoordinateAverage μ i f x := by
  simp only [finite_coordinate_average_update, Function.update_idem]

theorem finite_coordinate_average_add {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ) (i : I)
    (f g : (∀ j, X j) → ℂ) :
    finiteCoordinateAverage μ i (f + g) = finiteCoordinateAverage μ i f + finiteCoordinateAverage μ i g := by
  funext x
  simp only [finite_coordinate_average_update, Pi.add_apply, mul_add, Finset.sum_add_distrib]

theorem finite_coordinate_average_smul {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ) (i : I)
    (c : ℂ) (f : (∀ j, X j) → ℂ) :
    finiteCoordinateAverage μ i (c • f) = c • finiteCoordinateAverage μ i f := by
  funext x
  simp only [finite_coordinate_average_update, Pi.smul_apply, smul_eq_mul, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro y _
  ring

theorem finite_coordinate_average_idempotent {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ) (i : I)
    (hmass : ∑ y, μ i y = 1) (f : (∀ j, X j) → ℂ) :
    finiteCoordinateAverage μ i (finiteCoordinateAverage μ i f) = finiteCoordinateAverage μ i f := by
  funext x
  rw [finite_coordinate_average_update]
  simp only [finite_coordinate_average_invariant, ← Finset.sum_mul, ← Complex.ofReal_sum, hmass,
    Complex.ofReal_one, one_mul]

theorem finite_coordinate_average_commute {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ) (i j : I)
    (f : (∀ j, X j) → ℂ) :
    finiteCoordinateAverage μ i (finiteCoordinateAverage μ j f) =
      finiteCoordinateAverage μ j (finiteCoordinateAverage μ i f) := by
  by_cases hij : i = j
  · subst j; rfl
  funext x
  simp only [finite_coordinate_average_update, Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro y _
  apply Finset.sum_congr rfl
  intro z _
  rw [Function.update_comm hij]
  ring
end

section
open Finset
noncomputable def blockSieveUpper {G ι : Type*} (J : Finset G)
    (B : G → Finset ι) (w : ι → ℝ) (h : G → ℕ) : ℝ :=
  ∏ g ∈ J, exclusionTruncation (B g) w (h g + 1)

noncomputable def blockSieveCorrection {G ι : Type*} (J : Finset G)
    (B : G → Finset ι) (w : ι → ℝ) (h : G → ℕ) : ℝ := by
  classical
  exact ∑ g ∈ J, exclusionElementary (B g) w (h g + 1) *
    ∏ k ∈ J.erase g, exclusionTruncation (B k) w (h k + 1)

noncomputable def blockSieveLower {G ι : Type*} (J : Finset G)
    (B : G → Finset ι) (w : ι → ℝ) (h : G → ℕ) : ℝ :=
  blockSieveUpper J B w h - blockSieveCorrection J B w h

theorem block_sieve_sandwich {G ι : Type*} (J : Finset G)
    (B : G → Finset ι) (w : ι → ℝ) (h : G → ℕ)
    (hw : ∀ g ∈ J, ∀ i ∈ B g, 0 ≤ w i ∧ w i ≤ 1)
    (hh : ∀ g ∈ J, Even (h g)) :
    blockSieveLower J B w h ≤ (∏ g ∈ J, ∏ i ∈ B g, (1 - w i)) ∧
      (∏ g ∈ J, ∏ i ∈ B g, (1 - w i)) ≤ blockSieveUpper J B w h := by
  classical
  exact block_product_sandwich J
    (fun g => ∏ i ∈ B g, (1 - w i))
    (fun g => exclusionTruncation (B g) w (h g + 1))
    (fun g => exclusionElementary (B g) w (h g + 1))
    (fun g hg => prod_nonneg (fun i hi => sub_nonneg.mpr (hw g hg i hi).2))
    (fun g hg => (block_sieve_local_bounds (B g) w (hw g hg) (hh g hg)).2.1)
    (fun g hg => (block_sieve_local_bounds (B g) w (hw g hg) (hh g hg)).2.2)

theorem block_sieve_upper_nonneg {G ι : Type*} (J : Finset G)
    (B : G → Finset ι) (w : ι → ℝ) (h : G → ℕ)
    (hw : ∀ g ∈ J, ∀ i ∈ B g, 0 ≤ w i ∧ w i ≤ 1)
    (hh : ∀ g ∈ J, Even (h g)) : 0 ≤ blockSieveUpper J B w h := by
  exact prod_nonneg (fun g hg =>
    (block_sieve_local_bounds (B g) w (hw g hg) (hh g hg)).1)

theorem block_sieve_difference_bound {G ι : Type*} (J : Finset G)
    (B : G → Finset ι) (w : ι → ℝ) (h : G → ℕ)
    (hw : ∀ g ∈ J, ∀ i ∈ B g, 0 ≤ w i ∧ w i ≤ 1)
    (hh : ∀ g ∈ J, Even (h g)) :
    0 ≤ blockSieveUpper J B w h - (∏ g ∈ J, ∏ i ∈ B g, (1 - w i)) ∧
      blockSieveUpper J B w h - (∏ g ∈ J, ∏ i ∈ B g, (1 - w i)) ≤
        blockSieveCorrection J B w h := by
  have hs := block_sieve_sandwich J B w h hw hh
  dsimp only [blockSieveLower] at hs
  constructor <;> linarith [hs.1, hs.2]
end

section
open Finset
theorem block_sieve_subset_product_level (J : Finset ℕ) (B : ℕ → Finset ℕ)
    (S : Finset ℕ) (h : ℕ) {z : ℝ} (hz : 1 ≤ z)
    (hdisj : (J : Set ℕ).PairwiseDisjoint B)
    (hprime : ∀ j ∈ J, ∀ p ∈ B j, p.Prime)
    (hsize : ∀ j ∈ J, ∀ p ∈ B j, Real.log (p : ℝ) ≤ Real.log z / (2 : ℝ)^j)
    (hs : S ⊆ J.biUnion B)
    (hcard : ∀ j ∈ J, (S ∩ B j).card ≤ (j + 1) * h + 1) :
    Squarefree (∏ p ∈ S, p) ∧ (∏ p ∈ S, (p : ℝ)) ≤ z^(4 * (h : ℝ) + 2) := by
  have hp : ∀ p ∈ S, p.Prime := by
    intro p hpS
    obtain ⟨j, hj, hpB⟩ := mem_biUnion.mp (hs hpS)
    exact hprime j hj p hpB
  constructor
  · refine squarefree_prod_of_pairwise_isCoprime (fun p hpS q hqS hpq => ?_)
      (fun p hpS => (hp p hpS).squarefree)
    simp only [← Nat.coprime_iff_isRelPrime]
    exact (Nat.coprime_primes (hp p hpS) (hp q hqS)).mpr hpq
  · have heq : J.biUnion (fun j => S ∩ B j) = S := by
      ext p
      simp only [mem_biUnion, mem_inter]
      constructor
      · rintro ⟨j, _, hpS, _⟩
        exact hpS
      · intro hpS
        obtain ⟨j, hj, hpB⟩ := mem_biUnion.mp (hs hpS)
        exact ⟨j, hj, hpS, hpB⟩
    have hb := block_sieve_log_product_level J (fun j => S ∩ B j) (fun p => (p : ℝ)) h hz
      (fun i hi j hj hij => (hdisj hi hj hij).mono inter_subset_right inter_subset_right)
      (fun j hj p hpS => Nat.cast_pos.mpr (hprime j hj p (mem_inter.mp hpS).2).pos)
      (fun j hj p hpS => hsize j hj p (mem_inter.mp hpS).2) hcard
    rwa [heq] at hb

theorem block_sieve_upper_coefficient_level (J : Finset ℕ) (B : ℕ → Finset ℕ)
    (S : Finset ℕ) (h : ℕ) {z : ℝ} (hz : 1 ≤ z)
    (hdisj : (J : Set ℕ).PairwiseDisjoint B)
    (hprime : ∀ j ∈ J, ∀ p ∈ B j, p.Prime)
    (hsize : ∀ j ∈ J, ∀ p ∈ B j, Real.log (p : ℝ) ≤ Real.log z / (2 : ℝ)^j)
    (hc : blockSieveSubsetUpperCoefficient J B (fun j => (j + 1) * h) S ≠ 0) :
    Squarefree (∏ p ∈ S, p) ∧ (∏ p ∈ S, (p : ℝ)) ≤ z^(4 * (h : ℝ) + 2) := by
  obtain ⟨hs, hupper⟩ := (block_sieve_subset_upper_coefficient_ne_zero_iff _ _ _ _).mp hc
  apply block_sieve_subset_product_level J B S h hz hdisj hprime hsize hs
  intro j hj
  exact (hupper j hj).trans (Nat.le_succ _)

theorem block_sieve_correction_coefficient_level (J : Finset ℕ) (B : ℕ → Finset ℕ)
    (S : Finset ℕ) (h jStar : ℕ) {z : ℝ} (hz : 1 ≤ z)
    (hdisj : (J : Set ℕ).PairwiseDisjoint B)
    (hprime : ∀ j ∈ J, ∀ p ∈ B j, p.Prime)
    (hsize : ∀ j ∈ J, ∀ p ∈ B j, Real.log (p : ℝ) ≤ Real.log z / (2 : ℝ)^j)
    (hc : blockSieveSubsetCorrectionAt J B (fun j => (j + 1) * h) jStar S ≠ 0) :
    Squarefree (∏ p ∈ S, p) ∧ (∏ p ∈ S, (p : ℝ)) ≤ z^(4 * (h : ℝ) + 2) := by
  obtain ⟨hs, hcorr⟩ := (block_sieve_subset_correction_at_ne_zero_iff _ _ _ _ _).mp hc
  apply block_sieve_subset_product_level J B S h hz hdisj hprime hsize hs
  intro j hj
  by_cases heq : j = jStar
  · subst j
    exact hcorr.2.1.le
  · exact (hcorr.2.2 j hj heq).trans (Nat.le_succ _)

theorem block_sieve_lower_coefficient_level (J : Finset ℕ) (B : ℕ → Finset ℕ)
    (S : Finset ℕ) (h : ℕ) {z : ℝ} (hz : 1 ≤ z)
    (hdisj : (J : Set ℕ).PairwiseDisjoint B)
    (hprime : ∀ j ∈ J, ∀ p ∈ B j, p.Prime)
    (hsize : ∀ j ∈ J, ∀ p ∈ B j, Real.log (p : ℝ) ≤ Real.log z / (2 : ℝ)^j)
    (hc : blockSieveSubsetLowerCoefficient J B (fun j => (j + 1) * h) S ≠ 0) :
    Squarefree (∏ p ∈ S, p) ∧ (∏ p ∈ S, (p : ℝ)) ≤ z^(4 * (h : ℝ) + 2) := by
  obtain ⟨hs, hsupport⟩ := (block_sieve_subset_lower_coefficient_ne_zero_iff _ _ _ _).mp hc
  apply block_sieve_subset_product_level J B S h hz hdisj hprime hsize hs
  intro j hj
  rcases hsupport with hupper | ⟨jStar, hcorr, _⟩
  · exact (hupper j hj).trans (Nat.le_succ _)
  · by_cases heq : j = jStar
    · subst j
      exact hcorr.2.1.le
    · exact (hcorr.2.2 j hj heq).trans (Nat.le_succ _)
end

section
open Finset
noncomputable def blockSieveModuli (P : Finset ℕ) (D : ℝ) : Finset ℕ :=
  (Icc 1 ⌊D⌋₊).filter (fun d => d ∣ ∏ p ∈ P, p)

theorem block_sieve_modulus_properties (P : Finset ℕ) (hP : ∀ p ∈ P, p.Prime)
    (D : ℝ) {d : ℕ} (hd : d ∈ blockSieveModuli P D) :
    0 < d ∧ (d : ℝ) ≤ D ∧ Squarefree d ∧ d ∣ ∏ p ∈ P, p := by
  obtain ⟨hdrange, hdvd⟩ := mem_filter.mp hd
  obtain ⟨hd0, hdD⟩ := mem_Icc.mp hdrange
  have hsq : Squarefree (∏ p ∈ P, p) := by
    refine squarefree_prod_of_pairwise_isCoprime (fun p hp q hq hpq => ?_)
      (fun p hp => (hP p hp).squarefree)
    simp only [← Nat.coprime_iff_isRelPrime]
    exact (Nat.coprime_primes (hP p hp) (hP q hq)).mpr hpq
  exact ⟨hd0, (Nat.le_floor_iff' (Nat.ne_zero_of_lt hd0)).mp hdD,
    hsq.squarefree_of_dvd hdvd, hdvd⟩

theorem sieve_prime_subset_product_injective (P : Finset ℕ) (hP : ∀ p ∈ P, p.Prime) :
    Set.InjOn (fun S : Finset ℕ => ∏ p ∈ S, p) P.powerset := by
  intro S hS T hT heq
  have hs : (∏ p ∈ S, p).primeFactors = S := Nat.primeFactors_prod
    (fun p hp => hP p ((mem_powerset.mp hS) hp))
  have ht : (∏ p ∈ T, p).primeFactors = T := Nat.primeFactors_prod
    (fun p hp => hP p ((mem_powerset.mp hT) hp))
  rw [← hs, ← ht]
  exact congrArg Nat.primeFactors heq

theorem subset_remainder_le_modulus_sum (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) (a : Finset ℕ → ℝ) (r : ℕ → ℝ) (D : ℝ)
    (hlevel : ∀ S ∈ P.powerset, a S ≠ 0 → ((∏ p ∈ S, p : ℕ) : ℝ) ≤ D) :
    (∑ S ∈ P.powerset, if a S = 0 then 0 else |r (∏ p ∈ S, p)|) ≤
      ∑ d ∈ blockSieveModuli P D, |r d| := by
  classical
  let F := P.powerset.filter (fun S => a S ≠ 0)
  have hinj : Set.InjOn (fun S : Finset ℕ => ∏ p ∈ S, p) F :=
    (sieve_prime_subset_product_injective P hP).mono (filter_subset _ _)
  have hsubset : F.image (fun S => ∏ p ∈ S, p) ⊆ blockSieveModuli P D := by
    intro d hd
    obtain ⟨S, hS, rfl⟩ := mem_image.mp hd
    apply mem_filter.mpr
    refine ⟨mem_Icc.mpr ⟨?_, Nat.le_floor (hlevel S (mem_filter.mp hS).1 (mem_filter.mp hS).2)⟩, ?_⟩
    · exact prod_pos (fun p hp => (hP p ((mem_powerset.mp (mem_filter.mp hS).1) hp)).pos)
    · exact prod_dvd_prod_of_subset S P (fun p => p) (mem_powerset.mp (mem_filter.mp hS).1)
  calc
    _ = ∑ S ∈ F, |r (∏ p ∈ S, p)| := by
      rw [sum_filter]
      apply sum_congr rfl
      intro S _
      by_cases hzero : a S = 0 <;> simp [hzero]
    _ = ∑ d ∈ F.image (fun S => ∏ p ∈ S, p), |r d| :=
      (sum_image (f := fun d => |r d|) hinj).symm
    _ ≤ _ := sum_le_sum_of_subset_of_nonneg hsubset (fun d _ _ => abs_nonneg (r d))

theorem subset_polynomial_average_error_level {Ω : Type*}
    (P : Finset ℕ) (T : Finset Ω) (a : Finset ℕ → ℝ) (r : ℕ → ℝ)
    (μ : Ω → ℝ) (x : Ω → ℕ → ℝ) (g : ℕ → ℝ) (X D : ℝ)
    (hP : ∀ p ∈ P, p.Prime) (ha : ∀ S ∈ P.powerset, |a S| ≤ 1)
    (hlevel : ∀ S ∈ P.powerset, a S ≠ 0 → ((∏ p ∈ S, p : ℕ) : ℝ) ≤ D)
    (hmoment : ∀ S ∈ P.powerset,
      (∑ t ∈ T, μ t * ∏ p ∈ S, x t p) = X * (∏ p ∈ S, g p) + r (∏ p ∈ S, p)) :
    |(∑ t ∈ T, μ t * subsetPolynomial P a (x t)) - X * subsetPolynomial P a g| ≤
      ∑ d ∈ blockSieveModuli P D, |r d| := by
  exact (subset_polynomial_average_error P T a (fun S => r (∏ p ∈ S, p)) μ x g X ha hmoment).trans
    (subset_remainder_le_modulus_sum P hP a r D hlevel)
end

section
open Finset
theorem exists_dyadic_log_band {p z : ℝ} (hp : 1 < p) (hpz : p ≤ z) :
    ∃ j : ℕ, Real.log z / (2 : ℝ)^(j + 1) < Real.log p ∧
      Real.log p ≤ Real.log z / (2 : ℝ)^j := by
  have hlp : 0 < Real.log p := Real.log_pos hp
  have hlpz : Real.log p ≤ Real.log z := Real.log_le_log (by linarith) hpz
  have hx : 1 ≤ Real.log z / Real.log p := (le_div_iff₀ hlp).mpr (by simpa)
  obtain ⟨j, hlo, hhi⟩ := exists_nat_pow_near hx (by norm_num : (1 : ℝ) < 2)
  refine ⟨j, (div_lt_iff₀ (by positivity)).mpr ?_,
    (le_div_iff₀ (by positivity)).mpr ?_⟩
  · simpa only [mul_comm] using (div_lt_iff₀ hlp).mp hhi
  · simpa only [mul_comm] using (le_div_iff₀ hlp).mp hlo

theorem exists_dyadic_sieve_blocks_log (P : Finset ℕ) {z : ℝ}
    (hP : ∀ p ∈ P, p.Prime) (hPz : ∀ p ∈ P, (p : ℝ) ≤ z) :
    ∃ (J : Finset ℕ) (B : ℕ → Finset ℕ),
      J.biUnion B = P ∧ (J : Set ℕ).PairwiseDisjoint B ∧
      (∀ j, B j ⊆ P) ∧
      (∀ j ∈ J, ∀ p ∈ B j,
        Real.log z / (2 : ℝ)^(j + 1) < Real.log (p : ℝ) ∧
          Real.log (p : ℝ) ≤ Real.log z / (2 : ℝ)^j) := by
  classical
  have hex : ∀ p : ℕ, ∃ j : ℕ, p ∉ P ∨
      (Real.log z / (2 : ℝ)^(j + 1) < Real.log (p : ℝ) ∧
        Real.log (p : ℝ) ≤ Real.log z / (2 : ℝ)^j) := by
    intro p
    by_cases hp : p ∈ P
    · obtain ⟨j, hj⟩ := exists_dyadic_log_band
        (by exact_mod_cast (hP p hp).one_lt) (hPz p hp)
      exact ⟨j, Or.inr hj⟩
    · exact ⟨0, Or.inl hp⟩
  choose f hf using hex
  refine ⟨P.image f, (fun j => P.filter (fun p => f p = j)), ?_, ?_, ?_, ?_⟩
  · ext p
    constructor
    · intro hp
      obtain ⟨j, _, hp⟩ := mem_biUnion.mp hp
      exact (mem_filter.mp hp).1
    · intro hp
      exact mem_biUnion.mpr ⟨f p, mem_image.mpr ⟨p, hp, rfl⟩,
        mem_filter.mpr ⟨hp, rfl⟩⟩
  · exact Set.pairwiseDisjoint_filter f _ P
  · intro j
    exact filter_subset _ _
  · intro j _ p hp
    obtain ⟨hp, hj⟩ := mem_filter.mp hp
    exact hj ▸ (hf p).resolve_left (fun hnot => hnot hp)

theorem exists_dyadic_sieve_blocks (P : Finset ℕ) {z : ℝ}
    (hP : ∀ p ∈ P, p.Prime) (hPz : ∀ p ∈ P, (p : ℝ) ≤ z) :
    ∃ (J : Finset ℕ) (B : ℕ → Finset ℕ),
      J.biUnion B = P ∧ (J : Set ℕ).PairwiseDisjoint B ∧
      (∀ j, B j ⊆ P) ∧
      (∀ j ∈ J, ∀ p ∈ B j,
        Real.exp (Real.log z / (2 : ℝ)^(j + 1)) < (p : ℝ) ∧
          (p : ℝ) ≤ Real.exp (Real.log z / (2 : ℝ)^j)) ∧
      (∀ j ∈ J, ∀ p ∈ B j, Real.log (p : ℝ) ≤ Real.log z / (2 : ℝ)^j) := by
  obtain ⟨J, B, hunion, hdisj, hsub, hband⟩ := exists_dyadic_sieve_blocks_log P hP hPz
  refine ⟨J, B, hunion, hdisj, hsub, ?_, ?_⟩
  · intro j hj p hp
    have hp0 : (0 : ℝ) < p := Nat.cast_pos.mpr (hP p (hsub j hp)).pos
    constructor
    · simpa only [Real.exp_log hp0] using (Real.exp_lt_exp.mpr (hband j hj p hp).1)
    · simpa only [Real.exp_log hp0] using (Real.exp_le_exp.mpr (hband j hj p hp).2)
  · intro j hj p hp
    exact (hband j hj p hp).2
end

section
open Finset
theorem dyadic_sieve_block_mass (P B : Finset ℕ) (g : ℕ → ℝ) {z C : ℝ}
    (hz : 1 < z) (j : ℕ) (hP : ∀ p ∈ P, p.Prime)
    (hg : ∀ p ∈ P, 0 ≤ g p) (hB : B ⊆ P)
    (hlo : ∀ p ∈ B, Real.log z / (2 : ℝ)^(j + 1) < Real.log (p : ℝ))
    (hhi : ∀ p ∈ B, Real.log (p : ℝ) ≤ Real.log z / (2 : ℝ)^j)
    (hshell : ∀ w : ℝ, 1 < w → (∑ p ∈ P.filter (fun p : ℕ => w < (p : ℝ) ∧ (p : ℝ) ≤ w^2), g p) ≤ C) :
    (∑ p ∈ B, g p) ≤ C := by
  let w := Real.exp (Real.log z / (2 : ℝ)^(j + 1))
  have hw : 1 < w := Real.one_lt_exp_iff.mpr (div_pos (Real.log_pos hz) (by positivity))
  have hsquare : w^2 = Real.exp (Real.log z / (2 : ℝ)^j) := by
    dsimp only [w]
    rw [pow_two, ← Real.exp_add]
    congr 1
    rw [pow_succ]
    field_simp
    ring
  have hsubset : B ⊆ P.filter (fun p : ℕ => w < (p : ℝ) ∧ (p : ℝ) ≤ w^2) := by
    intro p hp
    have hp0 : (0 : ℝ) < p := Nat.cast_pos.mpr (hP p (hB hp)).pos
    refine mem_filter.mpr ⟨hB hp, ?_, ?_⟩
    · simpa only [Real.exp_log hp0] using Real.exp_lt_exp.mpr (hlo p hp)
    · rw [hsquare]
      simpa only [Real.exp_log hp0] using Real.exp_le_exp.mpr (hhi p hp)
  exact (sum_le_sum_of_subset_of_nonneg hsubset
    (fun p hp _ => hg p (mem_filter.mp hp).1)).trans (hshell w hw)
end

section
open Finset
section ResiduePath
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (ζ : ∀ p : PhysicalPrime P, ZMod p.2.val)
  (hmarks : ∀ j : Fin (n + 1), ∀ p ∈ physicalMarkedPrimes (L j),
    ζ p = -(a j : ZMod p.2.val))

variable
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ) (η : Fin N → Fin (n + 1) → ℝ)
  (V ρ : Fin N → ℝ) (hV : ∀ g, V g ≠ 0) (cap : ℕ)


variable [∀ g, ∀ p : ↥(P g), NeZero p.val]

noncomputable def physicalJointCappedVisitKernel (j : ℕ) :
    ((p : PhysicalPrime P) → GhostPhaseState (ZMod p.2.val)) →
    ((p : PhysicalPrime P) → GhostPhaseState (ZMod p.2.val)) → ℝ :=
  ghostPhaseCappedDampedVisit
    (fun p => globalBirthFiniteActivity (physicalGroupBareFiniteActivity L p.1) j p.2)
    (fun _ => 0) (fun p => η p.1 (globalBirthFiniteIndex n j))
    (fun p => β p.1 p.2) (fun p => ρ p.1) cap

noncomputable def physicalJointCappedMovingEdgeKernel (j : ℕ) :
    ((p : PhysicalPrime P) → GhostPhaseState (ZMod p.2.val)) →
    ((p : PhysicalPrime P) → GhostPhaseState (ZMod p.2.val)) → ℝ :=
  ghostPhaseCappedDampedMovingEdge
    (fun p => globalBirthFiniteActivity (physicalGroupBareFiniteActivity L p.1) (j + 1) p.2)
    (fun p => globalBirthFiniteActivity (physicalGroupBareFiniteActivity L p.1) j p.2)
    (fun p => physicalResidueAbsoluteHit a p.1 p.2 (j + 1) - physicalResidueAbsoluteHit a p.1 p.2 j)
    (fun p => β p.1 p.2) (fun p => V p.1) (fun p => ρ p.1) (fun p => ρ p.1) cap

/-- The actual total-cutoff joint kernel is exactly the flattened real
capped tensor kernel, for every atomic index used by the finite path. -/
theorem physical_joint_residue_kernel_to_real (i : ℕ) (hi : i < 2 * n + 1)
    (z w : (g : Fin N) → (p : ↥(P g)) → GhostPhaseState (ZMod p.val)) :
    globalBirthJointKernel
      (physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β η V ρ hV cap i)
      cap z w =
    ((finiteAlternatingKernel (physicalJointCappedVisitKernel L β η ρ cap)
      (physicalJointCappedMovingEdgeKernel L a β V ρ cap) i
      (globalBirthFlattenPhase z) (globalBirthFlattenPhase w) : ℝ) : ℂ) := by
  have hg (g : Fin N) := physical_residue_atomic_kernel_to_real
    C aux k L a σ τ hstep ζ hmarks hlist hP hdis g (fun j => hk j g)
    (β g) (η g) (V g) (ρ g) (hV g) cap i hi (z g) (w g)
  calc
    _ = ((if (∑ g, (ghostPhasePendingSupport (z g)).card) ≤ cap then
          ∏ g, finiteAlternatingKernel (physicalResidueCappedVisitKernel L g (β g) (η g) (ρ g) cap)
            (physicalResidueCappedMovingEdgeKernel L a g (β g) (V g) (ρ g) cap) i (z g) (w g)
        else 0 : ℝ) : ℂ) := by
      unfold globalBirthJointKernel
      change (if _ then ∏ g, globalBirthRawStepKernel
        (physicalGroupResidueFiniteStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis
          g (fun j => hk j g) (β g) (η g) (V g) (ρ g) (hV g) cap i) (z g) (w g) else 0) = _
      simp_rw [hg]
      simp only [globalBirthJointPending]
      split_ifs <;> simp only [Complex.ofReal_prod, Complex.ofReal_zero]
    _ = _ := by
      apply congrArg (fun r : ℝ => (r : ℂ))
      by_cases he : i % 2 = 0
      · simp only [finiteAlternatingKernel, he, ite_true]
        exact ghost_phase_grouped_capped_visit _ _ _ _ _ cap z w
      · simp only [finiteAlternatingKernel, he, ite_false]
        exact ghost_phase_grouped_capped_moving_edge _ _ _ _ _ _ _ cap z w

end ResiduePath
end

section
open Finset
open scoped Classical
section Joint
variable {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
  [∀ g, DecidableEq (P g)] {R : (g : Fin N) → P g → Type*}
  [∀ g p, AddGroup (R g p)]
  [∀ g p, DecidableEq (R g p)]
  {a b : (g : Fin N) → P g → Bool}

abbrev GlobalBirthJointMemory (R : (g : Fin N) → P g → Type*) :=
  (g : Fin N) → FiniteOrderedTuple (Σ p, R g p)

abbrev GlobalBirthJointLedger (P : Fin N → Type*) := (g : Fin N) → Finset (P g)

abbrev GlobalBirthJointAmbientEvent
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (q : GlobalBirthJointMemory R) := (g : Fin N) → GlobalBirthAmbientEvent (step g) (q g)

noncomputable abbrev globalBirthJointAmbientEventFintype
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (q : GlobalBirthJointMemory R) : Fintype (GlobalBirthJointAmbientEvent step q) := by
  let _ : ∀ g, Fintype (GlobalBirthAmbientEvent (step g) (q g)) :=
    fun g => globalBirthAmbientEventFintype (step g) (q g)
  infer_instance

noncomputable def globalBirthJointAmbientTarget
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (s : GlobalBirthJointState R) (e : GlobalBirthJointAmbientEvent step (fun g => (s g).2)) :
    GlobalBirthJointState R := fun g => globalBirthAmbientEventTarget (step g) (s g) (e g)

noncomputable def globalBirthJointAmbientWeight
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (q : GlobalBirthJointMemory R) (e : GlobalBirthJointAmbientEvent step q) : ℝ :=
  ∏ g, globalBirthAmbientEventWeight (step g) (q g) (e g)

noncomputable def globalBirthJointAmbientAllowed
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (inputCap outputCap : ℕ) (s : GlobalBirthJointState R)
    (e : GlobalBirthJointAmbientEvent step (fun g => (s g).2)) : Prop :=
  globalBirthJointLength s ≤ inputCap ∧
    globalBirthJointLength (globalBirthJointAmbientTarget step s e) ≤ outputCap ∧
    ∀ g, globalBirthAmbientEventAllowed (step g) (s g) (e g)

theorem global_birth_joint_ambient_mass_product
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (s : GlobalBirthJointState R) (e : GlobalBirthJointAmbientEvent step (fun g => (s g).2)) :
    (∏ g, globalBirthAmbientEventMass (step g) (s g) (e g)) =
      if ∀ g, globalBirthAmbientEventAllowed (step g) (s g) (e g)
      then globalBirthJointAmbientWeight step (fun g => (s g).2) e else 0 := by
  by_cases h : ∀ g, globalBirthAmbientEventAllowed (step g) (s g) (e g)
  · simp only [if_pos h, globalBirthJointAmbientWeight,
      globalBirthAmbientEventMass, if_pos (h _)]
  · rw [if_neg h]
    obtain ⟨g, hg⟩ := not_forall.mp h
    exact prod_eq_zero (mem_univ g) (by simp [globalBirthAmbientEventMass, hg])

theorem global_birth_joint_raw_row_ambient_events
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (cap : ℕ) (F : GlobalBirthJointState R → ℂ) (s : GlobalBirthJointState R) :
    let _ := globalBirthJointAmbientEventFintype step (fun g => (s g).2)
    globalBirthJointRawRow step cap F s =
      ∑ e : GlobalBirthJointAmbientEvent step (fun g => (s g).2),
        ((∏ g, globalBirthAmbientEventMass (step g) (s g) (e g) : ℝ) : ℂ) *
          globalBirthJointRawCutoff cap F (globalBirthJointAmbientTarget step s e) := by
  let _ : ∀ g q, Fintype (GlobalBirthAmbientEvent (step g) q) :=
    fun g q => globalBirthAmbientEventFintype (step g) q
  have hr : (fun g (K : GlobalBirthHistoryState (R g) → ℂ) (s : GlobalBirthHistoryState (R g)) =>
      globalBirthRawStepRow (step g) (fun H q => K (H, q)) s.1 s.2) =
      (fun g (K : GlobalBirthHistoryState (R g) → ℂ) (s : GlobalBirthHistoryState (R g)) =>
        ∑ e : GlobalBirthAmbientEvent (step g) s.2,
          (globalBirthAmbientEventMass (step g) s e : ℂ) *
            K (globalBirthAmbientEventTarget (step g) s e)) := by
    funext g K s
    exact global_birth_raw_step_ambient_event_sum (step g) s K
  unfold globalBirthJointRawRow
  rw [hr, fin_tensor_row_events]
  apply sum_congr rfl
  intro e _
  simp only [Complex.ofReal_prod]
  rfl

theorem global_birth_joint_cut_row_ambient_events
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (inputCap outputCap : ℕ) (F : GlobalBirthJointState R → ℂ) (s : GlobalBirthJointState R) :
    let _ := globalBirthJointAmbientEventFintype step (fun g => (s g).2)
    globalBirthJointCutRawRow step inputCap outputCap F s =
      ∑ e : GlobalBirthJointAmbientEvent step (fun g => (s g).2),
        ((if globalBirthJointAmbientAllowed step inputCap outputCap s e
          then globalBirthJointAmbientWeight step (fun g => (s g).2) e else 0 : ℝ) : ℂ) *
          F (globalBirthJointAmbientTarget step s e) := by
  let _ := globalBirthJointAmbientEventFintype step (fun g => (s g).2)
  unfold globalBirthJointCutRawRow
  change (if globalBirthJointLength s ≤ inputCap
    then globalBirthJointRawRow step outputCap F s else 0) = _
  rw [global_birth_joint_raw_row_ambient_events]
  by_cases hi : globalBirthJointLength s ≤ inputCap
  · rw [if_pos hi]
    apply sum_congr rfl
    intro e _
    rw [global_birth_joint_ambient_mass_product]
    unfold globalBirthJointRawCutoff globalBirthJointAmbientAllowed
    split_ifs <;> simp_all
  · simp [hi, globalBirthJointAmbientAllowed]

end Joint
end

section
open Finset Classical
abbrev SharedActiveLabels {G : Type*} (P : G → Type*) {M : G → ℕ}
    (S : ∀ g, Finset (Fin (M g))) := ∀ g, Fin (S g).card → P g

noncomputable def productActiveMemorySplit {G : Type*} {P Z : G → Type*} {M : G → ℕ}
    (S : ∀ g, Finset (Fin (M g))) (B : ℕ) :
    ProductBoundedOrderedState P Z M B ≃
      SharedActiveLabels P S × ProductBoundedOrderedState P Z (fun g => (S g)ᶜ.card) B where
  toFun x := (fun g => (activeMemorySplit (S g) B (x g)).1,
    fun g => (activeMemorySplit (S g) B (x g)).2)
  invFun y := fun g => (activeMemorySplit (S g) B).symm (y.1 g, y.2 g)
  left_inv x := by
    funext g
    exact (activeMemorySplit (S g) B).symm_apply_apply (x g)
  right_inv y := by
    apply Prod.ext
    · funext g
      exact congrArg Prod.fst ((activeMemorySplit (S g) B).apply_symm_apply (y.1 g, y.2 g))
    · funext g
      exact congrArg Prod.snd ((activeMemorySplit (S g) B).apply_symm_apply (y.1 g, y.2 g))

noncomputable def sharedActiveWeight {G : Type*} [Fintype G] {P : G → Type*} {M : G → ℕ}
    (S : ∀ g, Finset (Fin (M g))) (μ : ∀ g, P g → ℝ) (c : SharedActiveLabels P S) : ℝ :=
  ∏ g, ∏ i, μ g (c g i)

theorem sharedActiveWeight_nonneg {G : Type*} [Fintype G] {P : G → Type*} {M : G → ℕ}
    (S : ∀ g, Finset (Fin (M g))) (μ : ∀ g, P g → ℝ) (hμ : ∀ g p, 0 ≤ μ g p)
    (c : SharedActiveLabels P S) : 0 ≤ sharedActiveWeight S μ c :=
  prod_nonneg fun g _ => prod_nonneg fun _i _ => hμ g _

theorem productActiveMemorySplit_weight {G : Type*} [Fintype G]
    {P Z : G → Type*} {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (x : ProductBoundedOrderedState P Z M B) :
    productMemoryWeight μ ν x =
      sharedActiveWeight S μ (productActiveMemorySplit S B x).1 *
        productMemoryWeight μ ν (productActiveMemorySplit S B x).2 := by
  unfold productMemoryWeight sharedActiveWeight
  simp_rw [activeMemorySplit_weight (S _) B]
  exact prod_mul_distrib

theorem productActiveMemorySplit_weight_symm {G : Type*} [Fintype G]
    {P Z : G → Type*} {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ) (c : SharedActiveLabels P S)
    (y : ProductBoundedOrderedState P Z (fun g => (S g)ᶜ.card) B) :
    productMemoryWeight μ ν ((productActiveMemorySplit S B).symm (c, y)) =
      sharedActiveWeight S μ c * productMemoryWeight μ ν y := by
  rw [productActiveMemorySplit_weight S B μ ν, Equiv.apply_symm_apply]

theorem productActiveMemorySplit_total_memory {G : Type*} [Fintype G]
    {P Z : G → Type*} {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (x : ProductBoundedOrderedState P Z M B) :
    productTotalMemory (productActiveMemorySplit S B x).2 = productTotalMemory x := by
  apply sum_congr rfl
  intro g _
  rfl

theorem productActiveMemorySplit_total_memory_symm {G : Type*} [Fintype G]
    {P Z : G → Type*} {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (c : SharedActiveLabels P S)
    (y : ProductBoundedOrderedState P Z (fun g => (S g)ᶜ.card) B) :
    productTotalMemory ((productActiveMemorySplit S B).symm (c, y)) = productTotalMemory y := by
  have h := productActiveMemorySplit_total_memory S B ((productActiveMemorySplit S B).symm (c, y))
  simpa only [Equiv.apply_symm_apply] using h.symm

theorem productActiveMemorySplit_symm_permute {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (c : SharedActiveLabels P S)
    (y : ProductBoundedOrderedState P Z (fun g => (S g)ᶜ.card) B)
    (g : G) (τ : Equiv.Perm (Fin (y g).2.1.val)) :
    (productActiveMemorySplit S B).symm (c, productMemoryPermuteAt y g τ) =
      productMemoryPermuteAt ((productActiveMemorySplit S B).symm (c, y)) g τ := by
  funext h
  by_cases hh : h = g
  · subst h
    change (activeMemorySplit (S g) B).symm
      (c g, (productMemoryPermuteAt y g τ) g) = _
    simp only [productMemoryPermuteAt, Function.update_self]
    rfl
  · change (activeMemorySplit (S h) B).symm
      (c h, (productMemoryPermuteAt y g τ) h) = _
    simp only [productMemoryPermuteAt, Function.update_of_ne hh]
    rfl

theorem productActiveMemorySlice_symmetric {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (f : ProductBoundedOrderedState P Z M B → ℂ) (hf : ProductMemorySymmetric f)
    (c : SharedActiveLabels P S) :
    ProductMemorySymmetric (equivFiberSlice (productActiveMemorySplit S B) f c) := by
  intro y g τ
  unfold equivFiberSlice
  rw [productActiveMemorySplit_symm_permute]
  exact hf ((productActiveMemorySplit S B).symm (c, y)) g τ


theorem productActiveMemorySplit_permute {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (x : ProductBoundedOrderedState P Z M B)
    (g : G) (τ : Equiv.Perm (Fin (x g).2.1.val)) :
    productActiveMemorySplit S B (productMemoryPermuteAt x g τ) =
      ((productActiveMemorySplit S B x).1,
        productMemoryPermuteAt (productActiveMemorySplit S B x).2 g τ) := by
  apply Prod.ext
  · funext h
    change (activeMemorySplit (S h) B ((productMemoryPermuteAt x g τ) h)).1 = _
    by_cases hh : h = g
    · subst h
      simp only [productMemoryPermuteAt, Function.update_self]
      rfl
    · simp only [productMemoryPermuteAt, Function.update_of_ne hh]
      rfl
  · funext h
    change (activeMemorySplit (S h) B ((productMemoryPermuteAt x g τ) h)).2 = _
    by_cases hh : h = g
    · subst h
      simp only [productMemoryPermuteAt, Function.update_self]
      rfl
    · simp only [productMemoryPermuteAt, Function.update_of_ne hh]
      rfl

theorem productActiveMemorySlice_cutoff {G : Type*} [Fintype G]
    {P Z : G → Type*} {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (f : ProductBoundedOrderedState P Z M B → ℂ) (c : SharedActiveLabels P S) :
    equivFiberSlice (productActiveMemorySplit S B) (productMemoryCutoff f) c =
      productMemoryCutoff (equivFiberSlice (productActiveMemorySplit S B) f c) := by
  funext y
  simp only [equivFiberSlice, productMemoryCutoff, productActiveMemorySplit_total_memory_symm]
end

section
open Finset Classical
theorem equivFiberSlice_normEnvelope {X C Y : Type*} (e : X ≃ C × Y)
    (f : X → ℂ) (c : C) :
    equivFiberSlice e (complexNormEnvelope f) c =
      complexNormEnvelope (equivFiberSlice e f c) := rfl

theorem equiv_fiber_average_lift_re_mono {X C Y : Type*} {A : C → Type*}
    [∀ c, Fintype (A c)] (e : X ≃ C × Y) (ω : ∀ c, A c → ℝ)
    (hω : ∀ c a, 0 ≤ ω c a) (T : ∀ c, A c → (Y → ℂ) → Y → ℂ)
    (hT : ∀ c a F H, (∀ y, (F y).re ≤ (H y).re) →
      ∀ y, (T c a F y).re ≤ (T c a H y).re)
    (f h : X → ℂ) (hfh : ∀ x, (f x).re ≤ (h x).re) (x : X) :
    (equivFiberAverageLift e ω T f x).re ≤ (equivFiberAverageLift e ω T h x).re := by
  simp only [equivFiberAverageLift, finiteFiberAverage, Complex.re_sum, Complex.mul_re,
    Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero]
  apply sum_le_sum
  intro a _
  apply mul_le_mul_of_nonneg_left _ (hω _ a)
  exact hT _ a _ _ (fun y => hfh (e.symm ((e x).1, y))) _

theorem equiv_fiber_average_lift_norm_le {X C Y : Type*} {A : C → Type*}
    [∀ c, Fintype (A c)] (e : X ≃ C × Y) (ω : ∀ c, A c → ℝ)
    (hω : ∀ c a, 0 ≤ ω c a)
    (T U : ∀ c, A c → (Y → ℂ) → Y → ℂ)
    (hTU : ∀ c a F y, ‖T c a F y‖ ≤ (U c a (complexNormEnvelope F) y).re)
    (f : X → ℂ) (x : X) :
    ‖equivFiberAverageLift e ω T f x‖ ≤
      (equivFiberAverageLift e ω U (complexNormEnvelope f) x).re := by
  unfold equivFiberAverageLift finiteFiberAverage
  rw [Complex.re_sum]
  calc
    _ ≤ ∑ a, ‖(ω (e x).1 a : ℂ) * T (e x).1 a (equivFiberSlice e f (e x).1) (e x).2‖ :=
      norm_sum_le _ _
    _ = ∑ a, ω (e x).1 a * ‖T (e x).1 a (equivFiberSlice e f (e x).1) (e x).2‖ := by
      apply sum_congr rfl
      intro a _
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hω _ a)]
    _ ≤ ∑ a, ω (e x).1 a *
        (U (e x).1 a (complexNormEnvelope (equivFiberSlice e f (e x).1)) (e x).2).re :=
      sum_le_sum fun a _ => mul_le_mul_of_nonneg_left (hTU _ a _ _) (hω _ a)
    _ = _ := by
      simp only [equivFiberSlice_normEnvelope, Complex.mul_re, Complex.ofReal_re,
        Complex.ofReal_im, zero_mul, sub_zero]
end

section
open scoped BigOperators Classical
theorem finite_weighted_mean_selfadjoint {X : Type*} [Fintype X]
    (μ : X → ℝ) (f g : X → ℂ) :
    (∑ x, (μ x : ℂ) * ((starRingEnd ℂ) (∑ y, (μ y : ℂ) * f y) * g x)) =
      ∑ x, (μ x : ℂ) * ((starRingEnd ℂ) (f x) * ∑ y, (μ y : ℂ) * g y) := by
  calc
    _ = (starRingEnd ℂ) (∑ y, (μ y : ℂ) * f y) * ∑ x, (μ x : ℂ) * g x := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro x _
      ring
    _ = _ := by
      rw [map_sum, Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro x _
      simp only [map_mul, Complex.conj_ofReal, mul_assoc]

theorem finite_coordinate_average_selfadjoint {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ) (i : I)
    (f g : (∀ j, X j) → ℂ) :
    (∑ x, (finiteProductWeight μ x : ℂ) *
      ((starRingEnd ℂ) (finiteCoordinateAverage μ i f x) * g x)) =
      ∑ x, (finiteProductWeight μ x : ℂ) *
        ((starRingEnd ℂ) (f x) * finiteCoordinateAverage μ i g x) := by
  rw [finite_product_expectation_split μ i, finite_product_expectation_split μ i]
  apply Finset.sum_congr rfl
  intro z _
  congr 1
  simp only [finite_coordinate_average_split]
  exact finite_weighted_mean_selfadjoint (μ i)
    (fun y => f ((Equiv.piSplitAt i X).symm (y, z)))
    (fun y => g ((Equiv.piSplitAt i X).symm (y, z)))

theorem finite_coordinate_average_sub {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ) (i : I)
    (f g : (∀ j, X j) → ℂ) :
    finiteCoordinateAverage μ i (f - g) = finiteCoordinateAverage μ i f - finiteCoordinateAverage μ i g := by
  funext x
  simp only [finite_coordinate_average_update, Pi.sub_apply, mul_sub, Finset.sum_sub_distrib]

theorem finite_coordinate_average_complement_zero {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ) (i : I)
    (hmass : ∑ y, μ i y = 1) (f : (∀ j, X j) → ℂ) :
    finiteCoordinateAverage μ i (f - finiteCoordinateAverage μ i f) = 0 := by
  rw [finite_coordinate_average_sub, finite_coordinate_average_idempotent μ i hmass, sub_self]

theorem finite_coordinate_average_complement_orthogonal {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ) (i : I)
    (hmass : ∑ y, μ i y = 1) (f g : (∀ j, X j) → ℂ) :
    (∑ x, (finiteProductWeight μ x : ℂ) *
      ((starRingEnd ℂ) (finiteCoordinateAverage μ i f x) *
        (g x - finiteCoordinateAverage μ i g x))) = 0 := by
  change (∑ x, (finiteProductWeight μ x : ℂ) *
      ((starRingEnd ℂ) (finiteCoordinateAverage μ i f x) *
        (g - finiteCoordinateAverage μ i g) x)) = 0
  rw [finite_coordinate_average_selfadjoint, finite_coordinate_average_complement_zero μ i hmass]
  simp only [Pi.zero_apply, mul_zero, Finset.sum_const_zero]
end

section
open Finset
theorem sum_subsets_disjoint_blocks_product {G α : Type*} [Fintype G] [DecidableEq α]
    (B : G → Finset α) (F : G → Finset α → ℝ)
    (hdisj : Pairwise (fun g k => Disjoint (B g) (B k))) :
    (∑ S ∈ (univ.biUnion B).powerset, ∏ g, F g (S ∩ B g)) =
      ∏ g, ∑ S ∈ (B g).powerset, F g S := by
  classical
  let Pool := univ.biUnion B
  let forward : Pool.powerset → ∀ g, (B g).powerset := fun S g =>
    ⟨S.val ∩ B g, mem_powerset.mpr inter_subset_right⟩
  let backward : (∀ g, (B g).powerset) → Pool.powerset := fun x =>
    ⟨univ.biUnion (fun g => (x g).val), mem_powerset.mpr (by
      intro p hp
      obtain ⟨g, hg, hpg⟩ := mem_biUnion.mp hp
      exact mem_biUnion.mpr ⟨g, hg, (mem_powerset.mp (x g).property) hpg⟩)⟩
  have hleft : Function.LeftInverse backward forward := by
    intro S
    apply Subtype.ext
    ext p
    change p ∈ univ.biUnion (fun g => S.val ∩ B g) ↔ p ∈ S.val
    constructor
    · intro hp
      obtain ⟨g, _, hpg⟩ := mem_biUnion.mp hp
      exact (mem_inter.mp hpg).1
    · intro hp
      obtain ⟨g, hg, hpg⟩ := mem_biUnion.mp ((mem_powerset.mp S.property) hp)
      exact mem_biUnion.mpr ⟨g, hg, mem_inter.mpr ⟨hp, hpg⟩⟩
  have hright : Function.RightInverse backward forward := by
    intro x
    funext g
    apply Subtype.ext
    ext p
    change p ∈ (univ.biUnion (fun k => (x k).val)) ∩ B g ↔ p ∈ (x g).val
    constructor
    · intro hp
      obtain ⟨hpU, hpB⟩ := mem_inter.mp hp
      obtain ⟨k, _, hpk⟩ := mem_biUnion.mp hpU
      by_cases hkg : k = g
      · subst k
        exact hpk
      · exact (disjoint_left.mp (hdisj hkg) ((mem_powerset.mp (x k).property) hpk) hpB).elim
    · intro hp
      exact mem_inter.mpr ⟨mem_biUnion.mpr ⟨g, mem_univ g, hp⟩,
        (mem_powerset.mp (x g).property) hp⟩
  let e : Pool.powerset ≃ (∀ g, (B g).powerset) :=
    ⟨forward, backward, hleft, hright⟩
  calc
    _ = ∑ S : Pool.powerset, ∏ g, F g (S.val ∩ B g) :=
      (sum_coe_sort Pool.powerset _).symm
    _ = ∑ x : ∀ g, (B g).powerset, ∏ g, F g (x g).val :=
      Fintype.sum_equiv e _ _ (fun _ => rfl)
    _ = ∏ g, ∑ S : (B g).powerset, F g S.val :=
      (Fintype.prod_sum (fun g (S : (B g).powerset) => F g S.val)).symm
    _ = _ := prod_congr rfl (fun g _ => sum_coe_sort (B g).powerset (F g))

theorem sum_subsets_disjoint_finset_blocks_product {G α : Type*} [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (F : G → Finset α → ℝ)
    (hdisj : (J : Set G).PairwiseDisjoint B) :
    (∑ S ∈ (J.biUnion B).powerset, ∏ g ∈ J, F g (S ∩ B g)) =
      ∏ g ∈ J, ∑ S ∈ (B g).powerset, F g S := by
  classical
  have hd : Pairwise (fun g k : J => Disjoint (B g.val) (B k.val)) := by
    intro g k hne
    exact hdisj g.property k.property (fun he => hne (Subtype.ext he))
  have he : univ.biUnion (fun g : J => B g.val) = J.biUnion B := by
    ext p
    simp only [mem_biUnion, mem_univ, true_and, Subtype.exists, exists_prop]
  have hh := sum_subsets_disjoint_blocks_product (fun g : J => B g.val)
    (fun g : J => F g.val) hd
  rw [he] at hh
  have hp (S : Finset α) : (∏ g : J, F g.val (S ∩ B g.val)) =
      ∏ g ∈ J, F g (S ∩ B g) := prod_coe_sort J (fun g => F g (S ∩ B g))
  simp_rw [hp] at hh
  rw [prod_coe_sort J (fun g => ∑ S ∈ (B g).powerset, F g S)] at hh
  exact hh

theorem block_sieve_subset_monomial_factor {G α : Type*} [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (w : α → ℝ) (S : Finset α)
    (hdisj : (J : Set G).PairwiseDisjoint B) (hs : S ⊆ J.biUnion B) :
    (∏ g ∈ J, ∏ p ∈ S ∩ B g, w p) = ∏ p ∈ S, w p := by
  classical
  have he : J.biUnion (fun g => S ∩ B g) = S := by
    ext p
    simp only [mem_biUnion, mem_inter]
    constructor
    · rintro ⟨g, _, hp, _⟩
      exact hp
    · intro hp
      obtain ⟨g, hg, hpg⟩ := mem_biUnion.mp (hs hp)
      exact ⟨g, hg, hp, hpg⟩
  have hd : (J : Set G).PairwiseDisjoint (fun g => S ∩ B g) := by
    intro i hi j hj hij
    exact (hdisj hi hj hij).mono inter_subset_right inter_subset_right
  rw [← prod_biUnion hd, he]

theorem exclusion_truncation_eq_subset_sum {α : Type*} [DecidableEq α]
    (B : Finset α) (w : α → ℝ) (h : ℕ) :
    exclusionTruncation B w (h + 1) =
      ∑ S ∈ B.powerset, if S.card ≤ h then (-1 : ℝ)^S.card * ∏ p ∈ S, w p else 0 := by
  classical
  unfold exclusionTruncation
  simp_rw [exclusionElementary, powersetCard_eq_filter, sum_filter, mul_sum, mul_ite, mul_zero]
  rw [sum_comm]
  simp [mem_range]

theorem block_sieve_upper_atom_factor {G α : Type*} [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (w : α → ℝ) (h : G → ℕ) (S : Finset α)
    (hdisj : (J : Set G).PairwiseDisjoint B) (hs : S ⊆ J.biUnion B) :
    blockSieveSubsetUpperCoefficient J B h S * (∏ p ∈ S, w p) =
      ∏ g ∈ J, if (S ∩ B g).card ≤ h g then
        (-1 : ℝ)^((S ∩ B g).card) * (∏ p ∈ S ∩ B g, w p) else 0 := by
  classical
  by_cases hu : blockSieveUpperSupport J h (blockSieveOccupancy B S)
  · have hp : (∏ g ∈ J, if (S ∩ B g).card ≤ h g then
          (-1 : ℝ)^((S ∩ B g).card) * (∏ p ∈ S ∩ B g, w p) else 0) =
        ∏ g ∈ J, (-1 : ℝ)^(blockSieveOccupancy B S g) * (∏ p ∈ S ∩ B g, w p) := by
      apply prod_congr rfl
      intro g hg
      exact if_pos (hu g hg)
    rw [hp, prod_mul_distrib, prod_pow_eq_pow_sum,
      block_sieve_occupancy_sum_eq_card J B S hdisj hs,
      block_sieve_subset_monomial_factor J B w S hdisj hs,
      block_sieve_subset_upper_coefficient_eq J B h S hdisj hs hu]
  · have hz : blockSieveSubsetUpperCoefficient J B h S = 0 := by
      apply not_ne_iff.mp
      exact fun hn => hu ((block_sieve_subset_upper_coefficient_ne_zero_iff J B h S).mp hn).2
    rw [hz, zero_mul]
    symm
    have hbad : ∃ g ∈ J, ¬blockSieveOccupancy B S g ≤ h g := by
      simpa only [blockSieveUpperSupport, not_forall, not_le, exists_prop] using hu
    obtain ⟨g, hg, hng⟩ := hbad
    apply prod_eq_zero hg
    exact if_neg hng

theorem block_sieve_upper_expansion {G α : Type*} [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (w : α → ℝ) (h : G → ℕ)
    (hdisj : (J : Set G).PairwiseDisjoint B) :
    blockSieveUpper J B w h =
      ∑ S ∈ (J.biUnion B).powerset, blockSieveSubsetUpperCoefficient J B h S * ∏ p ∈ S, w p := by
  symm
  calc
    _ = ∑ S ∈ (J.biUnion B).powerset, ∏ g ∈ J, if (S ∩ B g).card ≤ h g then
        (-1 : ℝ)^((S ∩ B g).card) * (∏ p ∈ S ∩ B g, w p) else 0 := by
      apply sum_congr rfl
      intro S hS
      exact block_sieve_upper_atom_factor J B w h S hdisj (mem_powerset.mp hS)
    _ = ∏ g ∈ J, ∑ S ∈ (B g).powerset,
        if S.card ≤ h g then (-1 : ℝ)^S.card * (∏ p ∈ S, w p) else 0 :=
      sum_subsets_disjoint_finset_blocks_product J B
        (fun g S => if S.card ≤ h g then (-1 : ℝ)^S.card * (∏ p ∈ S, w p) else 0) hdisj
    _ = _ := prod_congr rfl (fun g _ => (exclusion_truncation_eq_subset_sum (B g) w (h g)).symm)

theorem exclusion_elementary_eq_subset_sum {α : Type*} [DecidableEq α]
    (B : Finset α) (w : α → ℝ) (k : ℕ) :
    exclusionElementary B w k =
      ∑ S ∈ B.powerset, if S.card = k then ∏ p ∈ S, w p else 0 := by
  simp only [exclusionElementary, powersetCard_eq_filter, sum_filter]

theorem block_sieve_correction_atom_factor {G α : Type*} [DecidableEq G] [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (w : α → ℝ) (h : G → ℕ) (j : G) (S : Finset α)
    (hdisj : (J : Set G).PairwiseDisjoint B) (hj : j ∈ J) (hs : S ⊆ J.biUnion B) :
    blockSieveSubsetCorrectionAt J B h j S * (∏ p ∈ S, w p) =
      ∏ g ∈ J, if g = j then
        (if (S ∩ B g).card = h g + 1 then ∏ p ∈ S ∩ B g, w p else 0)
      else (if (S ∩ B g).card ≤ h g then
        (-1 : ℝ)^((S ∩ B g).card) * (∏ p ∈ S ∩ B g, w p) else 0) := by
  classical
  let n := blockSieveOccupancy B S
  let m : G → ℝ := fun g => ∏ p ∈ S ∩ B g, w p
  have hm : m j * (∏ g ∈ J.erase j, m g) = ∏ p ∈ S, w p := by
    rw [mul_prod_erase J m hj]
    exact block_sieve_subset_monomial_factor J B w S hdisj hs
  change _ = ∏ g ∈ J, if g = j then (if n g = h g + 1 then m g else 0)
    else (if n g ≤ h g then (-1 : ℝ)^(n g) * m g else 0)
  by_cases hc : blockSieveCorrectionSupport J h n j
  · have hcoef : blockSieveSubsetCorrectionAt J B h j S = (-1 : ℝ)^(∑ g ∈ J.erase j, n g) := by
      dsimp only [n] at hc ⊢
      simp only [blockSieveSubsetCorrectionAt, if_pos hs, blockSieveCorrectionAt, if_pos hc]
      congr 1
      apply sum_congr
      · ext g
        simp only [mem_erase]
      · intro g _
        rfl
    rw [hcoef, ← mul_prod_erase J _ hj, if_pos rfl, if_pos hc.2.1]
    have hrest : (∏ g ∈ J.erase j, if g = j then (if n g = h g + 1 then m g else 0)
        else (if n g ≤ h g then (-1 : ℝ)^(n g) * m g else 0)) =
        ∏ g ∈ J.erase j, (-1 : ℝ)^(n g) * m g := by
      apply prod_congr rfl
      intro g hg
      rw [if_neg (mem_erase.mp hg).1, if_pos (hc.2.2 g (mem_erase.mp hg).2 (mem_erase.mp hg).1)]
    rw [hrest, prod_mul_distrib, prod_pow_eq_pow_sum, ← hm]
    ring
  · have hcoef : blockSieveSubsetCorrectionAt J B h j S = 0 := by
      dsimp only [n] at hc
      simp only [blockSieveSubsetCorrectionAt, if_pos hs, blockSieveCorrectionAt, if_neg hc]
    rw [hcoef, zero_mul]
    symm
    by_cases hjc : n j = h j + 1
    · have hex : ∃ g ∈ J, g ≠ j ∧ ¬n g ≤ h g := by
        by_contra hn
        apply hc
        refine ⟨hj, hjc, ?_⟩
        intro g hg hgj
        by_contra hb
        exact hn ⟨g, hg, hgj, hb⟩
      obtain ⟨g, hg, hgj, hbad⟩ := hex
      apply prod_eq_zero hg
      rw [if_neg hgj, if_neg hbad]
    · apply prod_eq_zero hj
      rw [if_pos rfl, if_neg hjc]

theorem block_sieve_correction_at_expansion {G α : Type*} [DecidableEq G] [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (w : α → ℝ) (h : G → ℕ) (j : G)
    (hdisj : (J : Set G).PairwiseDisjoint B) (hj : j ∈ J) :
    exclusionElementary (B j) w (h j + 1) *
        (∏ g ∈ J.erase j, exclusionTruncation (B g) w (h g + 1)) =
      ∑ S ∈ (J.biUnion B).powerset, blockSieveSubsetCorrectionAt J B h j S * ∏ p ∈ S, w p := by
  classical
  symm
  let F : G → Finset α → ℝ := fun g S => if g = j then
    (if S.card = h g + 1 then ∏ p ∈ S, w p else 0)
    else (if S.card ≤ h g then (-1 : ℝ)^S.card * (∏ p ∈ S, w p) else 0)
  calc
    _ = ∑ S ∈ (J.biUnion B).powerset, ∏ g ∈ J, F g (S ∩ B g) := by
      apply sum_congr rfl
      intro S hS
      exact block_sieve_correction_atom_factor J B w h j S hdisj hj (mem_powerset.mp hS)
    _ = ∏ g ∈ J, ∑ S ∈ (B g).powerset, F g S :=
      sum_subsets_disjoint_finset_blocks_product J B F hdisj
    _ = exclusionElementary (B j) w (h j + 1) *
        (∏ g ∈ J.erase j, exclusionTruncation (B g) w (h g + 1)) := by
      rw [← mul_prod_erase J (fun g => ∑ S ∈ (B g).powerset, F g S) hj]
      apply congrArg₂ (· * ·)
      · simp only [F, if_pos rfl, ← exclusion_elementary_eq_subset_sum]
      · apply prod_congr rfl
        intro g hg
        simp only [F, if_neg (mem_erase.mp hg).1, ← exclusion_truncation_eq_subset_sum]

theorem block_sieve_lower_expansion {G α : Type*} [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (w : α → ℝ) (h : G → ℕ)
    (hdisj : (J : Set G).PairwiseDisjoint B) :
    blockSieveLower J B w h =
      ∑ S ∈ (J.biUnion B).powerset, blockSieveSubsetLowerCoefficient J B h S * ∏ p ∈ S, w p := by
  classical
  rw [block_sieve_subset_weighted_expansion, blockSieveLower,
    block_sieve_upper_expansion J B w h hdisj]
  apply congrArg₂ (· - ·) rfl
  apply sum_congr rfl
  intro j hj
  exact block_sieve_correction_at_expansion J B w h j hdisj hj
end

section
open Finset
noncomputable def blockSieveRelativeTailConstant (C η : ℝ) : ℝ :=
  Real.exp (C / η) * (Real.exp (C * Real.exp 1) / (1 - Real.exp (-1)))

noncomputable def blockSieveModelErrorConstant (C η : ℝ) : ℝ :=
  blockSieveRelativeTailConstant C η * Real.exp (blockSieveRelativeTailConstant C η)

theorem block_sieve_relative_tail_constant_pos (C η : ℝ) :
    0 < blockSieveRelativeTailConstant C η := by
  unfold blockSieveRelativeTailConstant
  apply mul_pos (Real.exp_pos _) (div_pos (Real.exp_pos _) _)
  exact sub_pos.mpr (Real.exp_lt_one_iff.mpr (by norm_num))

theorem block_sieve_model_error_constant_pos (C η : ℝ) :
    0 < blockSieveModelErrorConstant C η :=
  mul_pos (block_sieve_relative_tail_constant_pos C η) (Real.exp_pos _)

theorem block_sieve_relative_sum_bound {ι : Type*} {C η : ℝ}
    (hη : 0 < η) (hC : 0 ≤ C) {h : ℕ} (hh : 1 ≤ h)
    (J : Finset ℕ) (B : ℕ → Finset ι) (w : ι → ℝ)
    (hw : ∀ j ∈ J, ∀ i ∈ B j, 0 ≤ w i ∧ w i ≤ 1 - η)
    (hsum : ∀ j ∈ J, (∑ i ∈ B j, w i) ≤ C) :
    (∑ j ∈ J, exclusionElementary (B j) w ((j + 1)*h + 1) /
      (∏ i ∈ B j, (1 - w i))) ≤
      blockSieveRelativeTailConstant C η * Real.exp (-(h : ℝ)) := by
  calc
    _ ≤ ∑ j ∈ J, Real.exp (C / η) *
        (C^((j + 1)*h + 1) / (((j + 1)*h + 1).factorial : ℝ)) := by
      apply sum_le_sum
      intro j hj
      exact block_sieve_relative_error_bound (B j) w hη hC (hw j hj) (hsum j hj) _
    _ = Real.exp (C / η) * (∑ j ∈ J,
        C^((j + 1)*h + 1) / (((j + 1)*h + 1).factorial : ℝ)) := (mul_sum ..).symm
    _ ≤ Real.exp (C / η) *
        ((Real.exp (C * Real.exp 1) / (1 - Real.exp (-1))) * Real.exp (-(h : ℝ))) :=
      mul_le_mul_of_nonneg_left (block_sieve_factorial_tail_bound hC hh J) (Real.exp_pos _).le
    _ = _ := by unfold blockSieveRelativeTailConstant; ring

theorem block_sieve_model_bounds {ι : Type*} {C η : ℝ}
    (hη : 0 < η) (hC : 0 ≤ C) {h : ℕ} (hh : 1 ≤ h) (heven : Even h)
    (J : Finset ℕ) (B : ℕ → Finset ι) (w : ι → ℝ)
    (hw : ∀ j ∈ J, ∀ i ∈ B j, 0 ≤ w i ∧ w i ≤ 1 - η)
    (hsum : ∀ j ∈ J, (∑ i ∈ B j, w i) ≤ C) :
    let A := ∏ j ∈ J, ∏ i ∈ B j, (1 - w i)
    let cap := fun j => (j + 1)*h
    let err := A * blockSieveModelErrorConstant C η * Real.exp (-(h : ℝ))
    0 ≤ blockSieveCorrection J B w cap ∧
      blockSieveCorrection J B w cap ≤ err ∧
      |blockSieveUpper J B w cap - A| ≤ err ∧
      |blockSieveLower J B w cap - A| ≤ err := by
  classical
  dsimp only
  have hdec : (fun a b : ℕ => Classical.propDecidable (a = b)) =
      instDecidableEqNat := Subsingleton.elim _ _
  let a := fun j => ∏ i ∈ B j, (1 - w i)
  let e := fun j => exclusionElementary (B j) w ((j + 1)*h + 1)
  let u := fun j => exclusionTruncation (B j) w ((j + 1)*h + 1)
  let R := ∑ j ∈ J, e j / a j
  let K₀ := blockSieveRelativeTailConstant C η
  have hcorr_eq : blockSieveCorrection J B w (fun j => (j + 1)*h) =
      ∑ j ∈ J, e j * ∏ k ∈ J.erase j, u k := by
    unfold blockSieveCorrection
    rw [hdec]
  have hw1 : ∀ j ∈ J, ∀ i ∈ B j, 0 ≤ w i ∧ w i ≤ 1 := by
    intro j hj i hi
    exact ⟨(hw j hj i hi).1, by linarith [(hw j hj i hi).2]⟩
  have hc : ∀ j ∈ J, Even ((j + 1)*h) := fun j _ => heven.mul_left (j + 1)
  have ha : ∀ j ∈ J, 0 < a j := by
    intro j hj
    apply prod_pos
    intro i hi
    linarith [(hw j hj i hi).2]
  have hloc : ∀ j ∈ J, 0 ≤ u j ∧ a j ≤ u j ∧ u j - a j ≤ e j := by
    intro j hj
    exact block_sieve_local_bounds (B j) w (hw1 j hj) (hc j hj)
  have he : ∀ j ∈ J, 0 ≤ e j := by
    intro j hj
    linarith [(hloc j hj).2.1, (hloc j hj).2.2]
  have hA : 0 ≤ ∏ j ∈ J, a j := prod_nonneg (fun j hj => (ha j hj).le)
  have hR0 : 0 ≤ R := sum_nonneg (fun j hj => div_nonneg (he j hj) (ha j hj).le)
  have hR : R ≤ K₀ * Real.exp (-(h : ℝ)) :=
    block_sieve_relative_sum_bound hη hC hh J B w hw hsum
  have hdecay : Real.exp (-(h : ℝ)) ≤ 1 :=
    Real.exp_le_one_iff.mpr (neg_nonpos.mpr (Nat.cast_nonneg h))
  have hK₀ : 0 ≤ K₀ := (block_sieve_relative_tail_constant_pos C η).le
  have hRK : R ≤ K₀ := hR.trans (mul_le_of_le_one_right hK₀ hdecay)
  have hRexp : R * Real.exp R ≤
      blockSieveModelErrorConstant C η * Real.exp (-(h : ℝ)) := by
    calc
      _ ≤ (K₀ * Real.exp (-(h : ℝ))) * Real.exp K₀ :=
        mul_le_mul hR (Real.exp_le_exp.mpr hRK) (Real.exp_pos _).le
          (mul_nonneg hK₀ (Real.exp_pos _).le)
      _ = _ := by unfold blockSieveModelErrorConstant; dsimp [K₀]; ring
  have hcorr0 : 0 ≤ blockSieveCorrection J B w (fun j => (j + 1)*h) := by
    have hraw : 0 ≤ ∑ j ∈ J, e j * ∏ k ∈ J.erase j, u k := by
      apply sum_nonneg
      intro j hj
      exact mul_nonneg (he j hj)
        (prod_nonneg (fun k hk => (hloc k (mem_of_mem_erase hk)).1))
    rw [hcorr_eq]
    exact hraw
  have hcorr : blockSieveCorrection J B w (fun j => (j + 1)*h) ≤
      (∏ j ∈ J, a j) * blockSieveModelErrorConstant C η * Real.exp (-(h : ℝ)) := by
    calc
      _ ≤ (∏ j ∈ J, a j) * R * Real.exp R :=
        by
          rw [hcorr_eq]
          exact block_sieve_model_correction_upper J a e u ha he (fun j hj => (hloc j hj).1)
            (fun j hj => by linarith [(hloc j hj).2.2])
      _ = (∏ j ∈ J, a j) * (R * Real.exp R) := by ring
      _ ≤ (∏ j ∈ J, a j) *
          (blockSieveModelErrorConstant C η * Real.exp (-(h : ℝ))) :=
        mul_le_mul_of_nonneg_left hRexp hA
      _ = _ := by ring
  have hs := block_sieve_sandwich J B w (fun j => (j + 1)*h) hw1 hc
  have hd := block_sieve_difference_bound J B w (fun j => (j + 1)*h) hw1 hc
  refine ⟨hcorr0, hcorr, ?_, ?_⟩
  · rw [abs_of_nonneg hd.1]
    exact hd.2.trans hcorr
  · rw [abs_of_nonpos (sub_nonpos.mpr hs.1)]
    dsimp only [blockSieveLower] at *
    change _ ≤ (∏ j ∈ J, a j) * blockSieveModelErrorConstant C η * Real.exp (-(h : ℝ))
    have hsa : (∏ j ∈ J, a j) ≤ blockSieveUpper J B w (fun j => (j + 1)*h) := hs.2
    change -((blockSieveUpper J B w (fun j => (j + 1)*h) -
      blockSieveCorrection J B w (fun j => (j + 1)*h)) - (∏ j ∈ J, a j)) ≤ _
    linarith
end

section
open Finset
section ResiduePath
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (ζ : ∀ p : PhysicalPrime P, ZMod p.2.val)
  (hmarks : ∀ j : Fin (n + 1), ∀ p ∈ physicalMarkedPrimes (L j),
    ζ p = -(a j : ZMod p.2.val))

variable
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ) (η : Fin N → Fin (n + 1) → ℝ)
  (V ρ : Fin N → ℝ) (hV : ∀ g, V g ≠ 0) (cap : ℕ)


variable [∀ g, ∀ p : ↥(P g), NeZero p.val]

/-- The normalized actual joint residue history equals a single real capped
moving history on the tagged prime pool, with every total output cap retained. -/
theorem physical_joint_residue_normalized_eq_capped_moving :
    ((∏ g, ∏ s : PhysicalSlots J ell, β g (L 0 g s) / V g : ℝ) : ℂ) *
      physicalJointResidueRawHistory C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β η V ρ hV cap =
    (ghostPhaseCappedMovingDampedHistory
      (fun p : PhysicalPrime P => fun j => globalBirthFiniteActivity (physicalGroupBareFiniteActivity L p.1) j p.2)
      (fun p => physicalResidueAbsoluteHit a p.1 p.2)
      (fun p j => η p.1 (globalBirthFiniteIndex n j))
      (fun p => β p.1 p.2) (fun p => V p.1) (fun p _ => ρ p.1)
      (fun _ => cap) (fun _ => cap) n : ℂ) := by
  rw [physical_joint_residue_normalized_history_trace]
  simp only [ghost_phase_run_initial_eq_tilted]
  have hc := global_birth_joint_initial_trace_output_only
    (fun i g => physicalGroupBareAtomicActivity L g i)
    (physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β η V ρ hV cap)
    (fun _ => cap) (fun g p => β g p / V g)
    (fun z => ((∏ g, ∏ p, ghostPhaseTerminal (physicalGroupPhaseActivity (L (Fin.last n)) g p)
      (z g p) : ℝ) : ℂ)) (2 * n + 1)
  simp only [physical_group_bare_atomic_activity_initial, finiteChronologicalPrefix] at hc
  rw [hc]
  let f := fun z : (p : PhysicalPrime P) → GhostPhaseState (ZMod p.2.val) =>
    ∏ p, ghostPhaseRunInitial (physicalGroupPhaseActivity (L 0) p.1 p.2) (β p.1 p.2) (V p.1) (z p)
  let q := fun z : (p : PhysicalPrime P) → GhostPhaseState (ZMod p.2.val) =>
    ∏ p, ghostPhaseTerminal (physicalGroupPhaseActivity (L (Fin.last n)) p.1 p.2) (z p)
  have he := complex_trace_eq_real_alternating_equiv
    (globalBirthFlattenEquiv (P := fun g : Fin N => ↥(P g)) (R := fun g p => ZMod p.val))
    (physicalJointCappedVisitKernel L β η ρ cap)
    (physicalJointCappedMovingEdgeKernel L a β V ρ cap)
    (fun i => globalBirthJointKernel
      (physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β η V ρ hV cap i) cap)
    f q n (fun i hi z w => physical_joint_residue_kernel_to_real
      C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β η V ρ hV cap i hi z w)
  have h0 (g : Fin N) : globalBirthFiniteActivity (physicalGroupBareFiniteActivity L g) 0 =
      physicalGroupPhaseActivity (L 0) g :=
    global_birth_finite_activity_at (physicalGroupBareFiniteActivity L g) (0 : Fin (n + 1))
  have hn (g : Fin N) : globalBirthFiniteActivity (physicalGroupBareFiniteActivity L g) n =
      physicalGroupPhaseActivity (L (Fin.last n)) g :=
    global_birth_finite_activity_at (physicalGroupBareFiniteActivity L g) (Fin.last n)
  calc
    _ = (finiteAlternatingPairing (physicalJointCappedVisitKernel L β η ρ cap)
        (physicalJointCappedMovingEdgeKernel L a β V ρ cap) f q n : ℂ) := by
      simpa only [f, q, Fintype.prod_sigma, globalBirthFlattenEquiv, Equiv.coe_fn_mk,
        ghost_phase_run_initial_eq_tilted] using he
    _ = _ := by
      congr 1
      unfold ghostPhaseCappedMovingDampedHistory
      change finiteAlternatingPairing (physicalJointCappedVisitKernel L β η ρ cap)
        (physicalJointCappedMovingEdgeKernel L a β V ρ cap) _ _ n =
        finiteAlternatingPairing (physicalJointCappedVisitKernel L β η ρ cap)
          (physicalJointCappedMovingEdgeKernel L a β V ρ cap) _ _ n
      dsimp only [f, q]
      simp only [h0, hn]

/-- Nonzero group damping parameters disappear from the actual joint trace.
This equality retains the intended total pending-memory cutoff. -/
theorem physical_joint_residue_normalized_eq_capped_absolute (hρ : ∀ g, ρ g ≠ 0) :
    ((∏ g, ∏ s : PhysicalSlots J ell, β g (L 0 g s) / V g : ℝ) : ℂ) *
      physicalJointResidueRawHistory C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β η V ρ hV cap =
    (ghostPhaseCappedHistory
      (fun p : PhysicalPrime P => fun j => globalBirthFiniteActivity (physicalGroupBareFiniteActivity L p.1) j p.2)
      (fun p => physicalResidueAbsoluteHit a p.1 p.2)
      (fun p j => η p.1 (globalBirthFiniteIndex n j))
      (fun p => β p.1 p.2) (fun p => V p.1) (fun _ => cap) (fun _ => cap) n : ℂ) := by
  rw [physical_joint_residue_normalized_eq_capped_moving]
  exact congrArg (fun r : ℝ => (r : ℂ))
    (ghost_phase_capped_moving_history_eq_undamped
      (fun p : PhysicalPrime P => fun j => globalBirthFiniteActivity (physicalGroupBareFiniteActivity L p.1) j p.2)
      (fun p => physicalResidueAbsoluteHit a p.1 p.2)
      (fun p j => η p.1 (globalBirthFiniteIndex n j))
      (fun p => β p.1 p.2) (fun p => V p.1) (fun p _ => ρ p.1)
      (fun _ => cap) (fun _ => cap) (fun p _ => hρ p.1) n)

end ResiduePath
end

section
open Finset
open scoped Classical
section Joint
variable {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
  [∀ g, DecidableEq (P g)] {R : (g : Fin N) → P g → Type*}

def globalBirthJointStateEquiv : GlobalBirthJointState R ≃
    GlobalBirthJointLedger P × GlobalBirthJointMemory R where
  toFun s := (fun g => (s g).1, fun g => (s g).2)
  invFun s := fun g => (s.1 g, s.2 g)
  left_inv s := by funext g; exact Prod.eta (s g)
  right_inv s := by cases s; rfl

variable [∀ g p, AddGroup (R g p)]
  [∀ g p, DecidableEq (R g p)]
  {a b : (g : Fin N) → P g → Bool}

noncomputable def globalBirthJointMemoryTarget
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (q : GlobalBirthJointMemory R) (e : GlobalBirthJointAmbientEvent step q) :
    GlobalBirthJointMemory R := fun g => globalBirthAmbientMemoryTarget (step g) (q g) (e g)

noncomputable def globalBirthJointLedgerUpdate
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (H : GlobalBirthJointLedger P) (q : GlobalBirthJointMemory R)
    (e : GlobalBirthJointAmbientEvent step q) : GlobalBirthJointLedger P :=
  fun g => globalBirthAmbientLedgerUpdate (step g) (H g) (q g) (e g)

theorem global_birth_joint_ambient_target_pair
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (s : GlobalBirthJointState R) (e : GlobalBirthJointAmbientEvent step (fun g => (s g).2)) :
    globalBirthJointStateEquiv (globalBirthJointAmbientTarget step s e) =
      (globalBirthJointLedgerUpdate step (fun g => (s g).1) (fun g => (s g).2) e,
        globalBirthJointMemoryTarget step (fun g => (s g).2) e) := by
  apply Prod.ext
  · rfl
  · funext g
    have h := congrArg (fun t : GlobalBirthHistoryState (R g) => t.2)
      (global_birth_ambient_target_pair (step g) (s g) (e g))
    exact h

noncomputable def globalBirthJointLedgerEventAllowed
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (inputCap outputCap : ℕ)
    (s : GlobalBirthJointLedger P × GlobalBirthJointMemory R)
    (e : GlobalBirthJointAmbientEvent step s.2) : Prop :=
  globalBirthJointAmbientAllowed step inputCap outputCap (globalBirthJointStateEquiv.symm s) e

theorem global_birth_joint_cut_row_ledger_events
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (inputCap outputCap : ℕ)
    (F : GlobalBirthJointLedger P × GlobalBirthJointMemory R → ℂ)
    (s : GlobalBirthJointState R) :
    let _ := globalBirthJointAmbientEventFintype step (fun g => (s g).2)
    globalBirthJointCutRawRow step inputCap outputCap (F ∘ globalBirthJointStateEquiv) s =
      ∑ e : GlobalBirthJointAmbientEvent step (fun g => (s g).2),
        ((if globalBirthJointLedgerEventAllowed step inputCap outputCap
          (globalBirthJointStateEquiv s) e
          then globalBirthJointAmbientWeight step (fun g => (s g).2) e else 0 : ℝ) : ℂ) *
          F (globalBirthJointLedgerUpdate step (fun g => (s g).1) (fun g => (s g).2) e,
            globalBirthJointMemoryTarget step (fun g => (s g).2) e) := by
  let _ := globalBirthJointAmbientEventFintype step (fun g => (s g).2)
  rw [global_birth_joint_cut_row_ambient_events]
  apply sum_congr rfl
  intro e _
  dsimp only [Function.comp_apply]
  rw [global_birth_joint_ambient_target_pair]
  rfl

end Joint
end

section
open Finset Classical
section

variable {G : Type*} [Fintype G] [DecidableEq G]
  {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
  {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
  {A : SharedActiveLabels P S → Type*} [∀ c, Fintype (A c)]

noncomputable def fullActiveMemoryAverage
    (ω : ∀ c, A c → ℝ)
    (T : ∀ c, A c →
      (ProductBoundedOrderedState P Z (fun g => (S g)ᶜ.card) B → ℂ) →
      ProductBoundedOrderedState P Z (fun g => (S g)ᶜ.card) B → ℂ)
    (f : ProductBoundedOrderedState P Z M B → ℂ) :
    ProductBoundedOrderedState P Z M B → ℂ :=
  equivFiberAverageLift (productActiveMemorySplit S B) ω T f

theorem full_active_memory_average_energy_le
    (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hν : ∀ g z, 0 ≤ ν g z)
    (ω : ∀ c, A c → ℝ) (hω : ∀ c a, 0 ≤ ω c a) (hωmass : ∀ c, ∑ a, ω c a ≤ 1)
    (T : ∀ c, A c →
      (ProductBoundedOrderedState P Z (fun g => (S g)ᶜ.card) B → ℂ) →
      ProductBoundedOrderedState P Z (fun g => (S g)ᶜ.card) B → ℂ)
    {L : ℝ} (hL : 0 ≤ L)
    (hT : ∀ c a F, ProductMemorySymmetric F →
      finiteWeightedEnergy (productMemoryWeight μ ν) (T c a F) ≤
        L * finiteWeightedEnergy (productMemoryWeight μ ν) F)
    (f : ProductBoundedOrderedState P Z M B → ℂ) (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ ν) (fullActiveMemoryAverage S B ω T f) ≤
      L * finiteWeightedEnergy (productMemoryWeight μ ν) f := by
  apply equiv_fiber_average_lift_energy_le (productActiveMemorySplit S B)
    (productMemoryWeight μ ν) (sharedActiveWeight S μ) (productMemoryWeight μ ν)
    (productActiveMemorySplit_weight_symm S B μ ν) (sharedActiveWeight_nonneg S μ hμ)
    (productMemoryWeight_nonneg μ ν hμ hν) ω hω hωmass T hL f
  intro c a
  exact hT c a _ (productActiveMemorySlice_symmetric S B f hf c)

omit [Fintype G] [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)] in
theorem full_active_memory_average_symmetric
    (ω : ∀ c, A c → ℝ)
    (T : ∀ c, A c →
      (ProductBoundedOrderedState P Z (fun g => (S g)ᶜ.card) B → ℂ) →
      ProductBoundedOrderedState P Z (fun g => (S g)ᶜ.card) B → ℂ)
    (hT : ∀ c a F, ProductMemorySymmetric F → ProductMemorySymmetric (T c a F))
    (f : ProductBoundedOrderedState P Z M B → ℂ) (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric (fullActiveMemoryAverage S B ω T f) := by
  intro x g τ
  unfold fullActiveMemoryAverage equivFiberAverageLift
  rw [productActiveMemorySplit_permute S B x g τ]
  unfold finiteFiberAverage
  apply sum_congr rfl
  intro a _
  exact congrArg (fun z : ℂ => (ω (productActiveMemorySplit S B x).1 a : ℂ) * z)
    (hT (productActiveMemorySplit S B x).1 a _
      (productActiveMemorySlice_symmetric S B f hf (productActiveMemorySplit S B x).1)
      (productActiveMemorySplit S B x).2 g τ)

end
end

section
open scoped BigOperators Classical
noncomputable def finiteCoordinateChoice {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (i : I) (active : Finset I) (f : (∀ j, X j) → ℂ) : (∀ j, X j) → ℂ :=
  if i ∈ active then f - finiteCoordinateAverage μ i f else finiteCoordinateAverage μ i f

noncomputable def finiteCoordinateComponent {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (active : Finset I) : List I → ((∀ j, X j) → ℂ) → ((∀ j, X j) → ℂ)
  | [], f => f
  | i :: is, f => finiteCoordinateChoice μ i active (finiteCoordinateComponent μ active is f)

theorem finite_coordinate_average_zero {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ) (i : I) :
    finiteCoordinateAverage μ i 0 = 0 := by
  funext x
  simp only [finite_coordinate_average_update, Pi.zero_apply, mul_zero, Finset.sum_const_zero]

theorem finite_coordinate_choice_zero {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ) (i : I) (S : Finset I) :
    finiteCoordinateChoice μ i S 0 = 0 := by
  simp only [finiteCoordinateChoice, finite_coordinate_average_zero, sub_self, ite_self]

theorem finite_coordinate_average_choice {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (i j : I) (S : Finset I) (f : (∀ k, X k) → ℂ) :
    finiteCoordinateAverage μ i (finiteCoordinateChoice μ j S f) =
      finiteCoordinateChoice μ j S (finiteCoordinateAverage μ i f) := by
  by_cases hj : j ∈ S
  · simp only [finiteCoordinateChoice, if_pos hj, finite_coordinate_average_sub]
    rw [finite_coordinate_average_commute μ i j]
  · simp only [finiteCoordinateChoice, if_neg hj]
    exact finite_coordinate_average_commute μ i j f

theorem finite_coordinate_component_congr {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (S T : Finset I) (is : List I) (h : ∀ i ∈ is, (i ∈ S ↔ i ∈ T))
    (f : (∀ j, X j) → ℂ) :
    finiteCoordinateComponent μ S is f = finiteCoordinateComponent μ T is f := by
  induction is with
  | nil => rfl
  | cons i is ih =>
    simp only [finiteCoordinateComponent]
    rw [ih (fun j hj => h j (List.mem_cons_of_mem _ hj))]
    simp only [finiteCoordinateChoice, h i (List.mem_cons_self)]

theorem finite_coordinate_component_average {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hmass : ∀ i, ∑ y, μ i y = 1) (S : Finset I) (is : List I) (i : I)
    (hi : i ∈ is) (f : (∀ j, X j) → ℂ) :
    finiteCoordinateAverage μ i (finiteCoordinateComponent μ S is f) =
      if i ∈ S then 0 else finiteCoordinateComponent μ S is f := by
  induction is with
  | nil => simp only [List.not_mem_nil] at hi
  | cons j js ih =>
    by_cases hij : i = j
    · subst j
      by_cases his : i ∈ S
      · simp only [finiteCoordinateComponent, finiteCoordinateChoice, if_pos his]
        exact finite_coordinate_average_complement_zero μ i (hmass i) _
      · simp only [finiteCoordinateComponent, finiteCoordinateChoice, if_neg his]
        exact finite_coordinate_average_idempotent μ i (hmass i) _
    · have hit : i ∈ js := (List.mem_cons.mp hi).resolve_left hij
      rw [finiteCoordinateComponent, finite_coordinate_average_choice, ih hit]
      by_cases his : i ∈ S
      · simp only [if_pos his, finite_coordinate_choice_zero]
      · simp only [if_neg his]
end

section
open Finset
theorem finite_block_sieve {Ω : Type*} (J : Finset ℕ) (B : ℕ → Finset ℕ)
    (T : Finset Ω) (μ : Ω → ℝ) (x : Ω → ℕ → ℝ) (g r : ℕ → ℝ)
    {z X C η : ℝ} {h : ℕ} (hz : 1 ≤ z) (hX : 0 ≤ X) (hC : 0 ≤ C)
    (hη : 0 < η) (hh : 1 ≤ h) (heven : Even h)
    (hdisj : (J : Set ℕ).PairwiseDisjoint B)
    (hprime : ∀ j ∈ J, ∀ p ∈ B j, p.Prime)
    (hsize : ∀ j ∈ J, ∀ p ∈ B j, Real.log (p : ℝ) ≤ Real.log z / (2 : ℝ)^j)
    (hμ : ∀ t ∈ T, 0 ≤ μ t)
    (hx : ∀ t ∈ T, ∀ p ∈ J.biUnion B, 0 ≤ x t p ∧ x t p ≤ 1)
    (hg : ∀ j ∈ J, ∀ p ∈ B j, 0 ≤ g p ∧ g p ≤ 1 - η)
    (hsum : ∀ j ∈ J, (∑ p ∈ B j, g p) ≤ C)
    (hmoment : ∀ S ∈ (J.biUnion B).powerset,
      (∑ t ∈ T, μ t * ∏ p ∈ S, x t p) = X * (∏ p ∈ S, g p) + r (∏ p ∈ S, p)) :
    |(∑ t ∈ T, μ t * ∏ p ∈ J.biUnion B, (1 - x t p)) -
        X * (∏ p ∈ J.biUnion B, (1 - g p))| ≤
      X * (∏ p ∈ J.biUnion B, (1 - g p)) * blockSieveModelErrorConstant C η *
        Real.exp (-(h : ℝ)) + ∑ d ∈ blockSieveModuli (J.biUnion B) (z^(4 * (h : ℝ) + 2)), |r d| := by
  classical
  let P := J.biUnion B
  let cap := fun j => (j + 1) * h
  let a := blockSieveSubsetUpperCoefficient J B cap
  let b := blockSieveSubsetLowerCoefficient J B cap
  let A := ∏ p ∈ P, (1 - g p)
  let E := A * blockSieveModelErrorConstant C η * Real.exp (-(h : ℝ))
  let D := z^(4 * (h : ℝ) + 2)
  let R := ∑ d ∈ blockSieveModuli P D, |r d|
  have hP : ∀ p ∈ P, p.Prime := by
    intro p hp
    obtain ⟨j, hj, hp⟩ := mem_biUnion.mp hp
    exact hprime j hj p hp
  have haeq (w : ℕ → ℝ) : subsetPolynomial P a w = blockSieveUpper J B w cap :=
    (block_sieve_upper_expansion J B w cap hdisj).symm
  have hbeq (w : ℕ → ℝ) : subsetPolynomial P b w = blockSieveLower J B w cap :=
    (block_sieve_lower_expansion J B w cap hdisj).symm
  have hA : (∏ j ∈ J, ∏ p ∈ B j, (1 - g p)) = A := (prod_biUnion hdisj).symm
  have hmodel := block_sieve_model_bounds hη hC hh heven J B g hg hsum
  dsimp only at hmodel
  rw [hA] at hmodel
  have hma : |subsetPolynomial P a g - A| ≤ E := by rw [haeq]; exact hmodel.2.2.1
  have hmb : |subsetPolynomial P b g - A| ≤ E := by rw [hbeq]; exact hmodel.2.2.2
  have hla : ∀ S ∈ P.powerset, a S ≠ 0 → ((∏ p ∈ S, p : ℕ) : ℝ) ≤ D := by
    intro S _ hS
    simpa only [Nat.cast_prod] using
      (block_sieve_upper_coefficient_level J B S h hz hdisj hprime hsize hS).2
  have hlb : ∀ S ∈ P.powerset, b S ≠ 0 → ((∏ p ∈ S, p : ℕ) : ℝ) ≤ D := by
    intro S _ hS
    simpa only [Nat.cast_prod] using
      (block_sieve_lower_coefficient_level J B S h hz hdisj hprime hsize hS).2
  have herra := subset_polynomial_average_error_level P T a r μ x g X D hP
    (fun S _ => abs_block_sieve_subset_upper_coefficient_le_one J B cap S) hla hmoment
  have herrb := subset_polynomial_average_error_level P T b r μ x g X D hP
    (fun S _ => abs_block_sieve_subset_lower_coefficient_le_one J B cap S) hlb hmoment
  have hpoint : ∀ t ∈ T,
      subsetPolynomial P b (x t) ≤ (∏ p ∈ P, (1 - x t p)) ∧
      (∏ p ∈ P, (1 - x t p)) ≤ subsetPolynomial P a (x t) := by
    intro t ht
    rw [haeq, hbeq]
    have hs := block_sieve_sandwich J B (x t) cap
      (fun j hj p hp => hx t ht p (mem_biUnion.mpr ⟨j, hj, hp⟩))
      (fun j _ => heven.mul_left (j + 1))
    simpa only [P, prod_biUnion hdisj] using hs
  have hfinal := subset_polynomial_sandwich_transfer P T a b μ
    (fun t => ∏ p ∈ P, (1 - x t p)) x g X A E R hμ hX hpoint hma hmb herra herrb
  exact hfinal.trans_eq (by dsimp only [E, A, R, P, D]; ring)
end

section
open Finset
section ResiduePath
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (ζ : ∀ p : PhysicalPrime P, ZMod p.2.val)
  (hmarks : ∀ j : Fin (n + 1), ∀ p ∈ physicalMarkedPrimes (L j),
    ζ p = -(a j : ZMod p.2.val))

variable
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ) (η : Fin N → Fin (n + 1) → ℝ)
  (V ρ : Fin N → ℝ) (hV : ∀ g, V g ≠ 0) (cap : ℕ)


variable [∀ g, ∀ p : ↥(P g), NeZero p.val]

/-- A cap at least the whole tagged pool is inactive. This hypothesis is
explicit and is not asserted for the smaller caps used in operator estimates. -/
theorem physical_joint_residue_normalized_eq_run_product (hρ : ∀ g, ρ g ≠ 0)
    (hcap : Fintype.card (PhysicalPrime P) ≤ cap) :
    ((∏ g, ∏ s : PhysicalSlots J ell, β g (L 0 g s) / V g : ℝ) : ℂ) *
      physicalJointResidueRawHistory C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β η V ρ hV cap =
    ((∏ p : PhysicalPrime P, ghostPhaseRunHistory
      (fun j => globalBirthFiniteActivity (physicalGroupBareFiniteActivity L p.1) j p.2)
      (physicalResidueAbsoluteHit a p.1 p.2)
      (fun j => η p.1 (globalBirthFiniteIndex n j)) (β p.1 p.2) (V p.1) n : ℝ) : ℂ) := by
  rw [physical_joint_residue_normalized_eq_capped_absolute C aux k L a σ τ hstep ζ hmarks
    hlist hP hdis hk β η V ρ hV cap hρ]
  exact congrArg (fun r : ℝ => (r : ℂ))
    (ghost_phase_capped_history_eq_run_product
      (fun p : PhysicalPrime P => fun j => globalBirthFiniteActivity (physicalGroupBareFiniteActivity L p.1) j p.2)
      (fun p => physicalResidueAbsoluteHit a p.1 p.2)
      (fun p j => η p.1 (globalBirthFiniteIndex n j))
      (fun p => β p.1 p.2) (fun p => V p.1) (fun _ => cap) (fun _ => cap)
      (fun _ => hcap) (fun _ => hcap) n)

/-- With an inactive cap and the actual nonzero baseline parameter, the
joint raw history gives the original product of active-residue expectations. -/
theorem physical_joint_residue_history_baseline_identity
    (hρ : ∀ g, ρ g ≠ 0) (hcap : Fintype.card (PhysicalPrime P) ≤ cap)
    (b : PhysicalPrime P → ℝ)
    (hb : ∀ p, b p = 1 - (∑ j ∈ range (n + 1), η p.1 (globalBirthFiniteIndex n j)) /
      Fintype.card (ZMod p.2.val))
    (hb0 : ∀ p, b p ≠ 0)
    (hβ : ∀ g p, β g p = ((Fintype.card (ZMod p.val) : ℝ) * b ⟨g, p⟩)⁻¹) :
    ((∏ p, b p : ℝ) : ℂ) *
      (((∏ g, ∏ s : PhysicalSlots J ell, β g (L 0 g s) / V g : ℝ) : ℂ) *
        physicalJointResidueRawHistory C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β η V ρ hV cap) =
    ((∏ p : PhysicalPrime P,
      (V p.1)⁻¹ ^ ghostPhaseRunCount
        (fun j => globalBirthFiniteActivity (physicalGroupBareFiniteActivity L p.1) j p.2) n *
      ((∑ r : ZMod p.2.val, activeResidueWeight (range (n + 1))
        ((range (n + 1)).filter
          (fun j => globalBirthFiniteActivity (physicalGroupBareFiniteActivity L p.1) j p.2 = true))
        (physicalResidueAbsoluteHit a p.1 p.2)
        (fun j => η p.1 (globalBirthFiniteIndex n j)) r) / Fintype.card (ZMod p.2.val)) : ℝ) : ℂ) := by
  rw [physical_joint_residue_normalized_eq_run_product C aux k L a σ τ hstep ζ hmarks
    hlist hP hdis hk β η V ρ hV cap hρ hcap, ← Complex.ofReal_mul, ← prod_mul_distrib]
  apply congrArg (fun r : ℝ => (r : ℂ))
  apply prod_congr rfl
  intro p _
  rw [hβ p.1 p.2]
  exact ghost_phase_run_history_residue_identity
    (fun j => globalBirthFiniteActivity (physicalGroupBareFiniteActivity L p.1) j p.2)
    (physicalResidueAbsoluteHit a p.1 p.2) (fun j => η p.1 (globalBirthFiniteIndex n j))
    (V p.1) n (b p) (hb p) (hb0 p)

end ResiduePath
end

section
open Finset
open scoped Classical
theorem global_birth_ambient_allowed_cap {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)]
    {a b : P → Bool} (step : GlobalBirthRawStep (R := R) a b)
    (s : GlobalBirthHistoryState R) (e : GlobalBirthAmbientEvent step s.2)
    (h : globalBirthAmbientEventAllowed step s e) :
    (globalBirthAmbientMemoryTarget step s.2 e).1 ≤ globalBirthRawStepCap step := by
  cases step <;> exact h.2

section Joint
variable {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
  [∀ g, DecidableEq (P g)] {R : (g : Fin N) → P g → Type*}
  [∀ g p, AddGroup (R g p)] [∀ g p, DecidableEq (R g p)]
  {a b : (g : Fin N) → P g → Bool}

def globalBirthJointMemoryLength (q : GlobalBirthJointMemory R) : ℕ := ∑ g, (q g).1

noncomputable def globalBirthJointEventWithinCaps
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (inputCap outputCap : ℕ) (q : GlobalBirthJointMemory R)
    (e : GlobalBirthJointAmbientEvent step q) : Prop :=
  globalBirthJointMemoryLength q ≤ inputCap ∧
    globalBirthJointMemoryLength (globalBirthJointMemoryTarget step q e) ≤ outputCap ∧
    ∀ g, (globalBirthJointMemoryTarget step q e g).1 ≤ globalBirthRawStepCap (step g)

noncomputable def globalBirthJointCappedEventWeight
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (inputCap outputCap : ℕ) (q : GlobalBirthJointMemory R)
    (e : GlobalBirthJointAmbientEvent step q) : ℝ :=
  if globalBirthJointEventWithinCaps step inputCap outputCap q e
    then globalBirthJointAmbientWeight step q e else 0

theorem global_birth_joint_capped_event_weight_abs
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (inputCap outputCap : ℕ) (q : GlobalBirthJointMemory R)
    (e : GlobalBirthJointAmbientEvent step q) :
    |globalBirthJointCappedEventWeight step inputCap outputCap q e| =
      if globalBirthJointEventWithinCaps step inputCap outputCap q e
      then ∏ g, |globalBirthAmbientEventWeight (step g) (q g) (e g)| else 0 := by
  unfold globalBirthJointCappedEventWeight globalBirthJointAmbientWeight
  split_ifs <;> simp only [abs_prod, abs_zero]

theorem global_birth_joint_event_caps_iff_total
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (inputCap outputCap : ℕ) (hcaps : ∀ g, outputCap ≤ globalBirthRawStepCap (step g))
    (q : GlobalBirthJointMemory R) (e : GlobalBirthJointAmbientEvent step q) :
    globalBirthJointEventWithinCaps step inputCap outputCap q e ↔
      globalBirthJointMemoryLength q ≤ inputCap ∧
        globalBirthJointMemoryLength (globalBirthJointMemoryTarget step q e) ≤ outputCap := by
  constructor
  · exact fun h => ⟨h.1, h.2.1⟩
  · rintro ⟨hi, ho⟩
    refine ⟨hi, ho, ?_⟩
    intro g
    have hg : (globalBirthJointMemoryTarget step q e g).1 ≤
        ∑ j, (globalBirthJointMemoryTarget step q e j).1 :=
      single_le_sum (f := fun j => (globalBirthJointMemoryTarget step q e j).1)
        (fun j _ => Nat.zero_le _) (mem_univ g)
    exact hg.trans (ho.trans (hcaps g))

theorem global_birth_joint_ambient_target_length
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (s : GlobalBirthJointState R) (e : GlobalBirthJointAmbientEvent step (fun g => (s g).2)) :
    globalBirthJointLength (globalBirthJointAmbientTarget step s e) =
      globalBirthJointMemoryLength (globalBirthJointMemoryTarget step (fun g => (s g).2) e) := by
  apply sum_congr rfl
  intro g _
  have h := congrArg (fun t : GlobalBirthHistoryState (R g) => t.2.1)
    (global_birth_ambient_target_pair (step g) (s g) (e g))
  exact h

theorem global_birth_joint_allowed_within_caps
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (inputCap outputCap : ℕ) (s : GlobalBirthJointState R)
    (e : GlobalBirthJointAmbientEvent step (fun g => (s g).2))
    (h : globalBirthJointAmbientAllowed step inputCap outputCap s e) :
    globalBirthJointEventWithinCaps step inputCap outputCap (fun g => (s g).2) e := by
  refine ⟨h.1, ?_, ?_⟩
  · rw [← global_birth_joint_ambient_target_length]
    exact h.2.1
  · intro g
    exact global_birth_ambient_allowed_cap (step g) (s g) (e g) (h.2.2 g)

theorem global_birth_joint_cut_row_capped_ledger_events
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (inputCap outputCap : ℕ)
    (F : GlobalBirthJointLedger P × GlobalBirthJointMemory R → ℂ)
    (s : GlobalBirthJointState R) :
    let _ := globalBirthJointAmbientEventFintype step (fun g => (s g).2)
    globalBirthJointCutRawRow step inputCap outputCap (F ∘ globalBirthJointStateEquiv) s =
      ∑ e : GlobalBirthJointAmbientEvent step (fun g => (s g).2),
        ((if globalBirthJointLedgerEventAllowed step inputCap outputCap
          (globalBirthJointStateEquiv s) e
          then globalBirthJointCappedEventWeight step inputCap outputCap (fun g => (s g).2) e
          else 0 : ℝ) : ℂ) *
          F (globalBirthJointLedgerUpdate step (fun g => (s g).1) (fun g => (s g).2) e,
            globalBirthJointMemoryTarget step (fun g => (s g).2) e) := by
  let _ := globalBirthJointAmbientEventFintype step (fun g => (s g).2)
  rw [global_birth_joint_cut_row_ledger_events]
  apply sum_congr rfl
  intro e _
  by_cases h : globalBirthJointLedgerEventAllowed step inputCap outputCap
      (globalBirthJointStateEquiv s) e
  · have hc := global_birth_joint_allowed_within_caps step inputCap outputCap s e h
    simp only [if_pos h, globalBirthJointCappedEventWeight, if_pos hc]
  · simp only [if_neg h]

end Joint
