theorem bounded_ghost_joint_row_events_factorized
    (F : BoundedGhostJointLedgerState n t B → ℂ) (s : BoundedGhostJointLedgerState n t B) :
    boundedGhostJointRow n β η V ρ t B F s =
      ∑ e : CoupledGhostEvent t B (fun g => (s g).2),
        ((∏ g, boundedGhostEventWeight (physicalGhostRetention (n g) (1 - η g) (ρ g))
          (physicalGhostTermination (n g) (1 - η g) (ρ g))
          (physicalGhostBirth (n g) (1 - η g) (ρ g) (V g))
