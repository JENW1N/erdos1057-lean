section

/- Shift-uniform mean-square bounds for the actual normalized four-factor box. -/

open Finset MeasureTheory

namespace Bounty

private theorem harmonic_weight_add (t v x : ℝ) :
    harmonicMellinWeight (t + v) x = harmonicMellinWeight v x *
      Complex.exp (((Real.log x * t : ℝ) : ℂ) * Complex.I) := by
  unfold harmonicMellinWeight
  have he : Complex.I * (((t + v) * Real.log x : ℝ) : ℂ) =
      Complex.I * ((v * Real.log x : ℝ) : ℂ) +
        ((Real.log x * t : ℝ) : ℂ) * Complex.I := by push_cast; ring
  rw [he, Complex.exp_add]
  ring

theorem harmonic_polynomial_shifted_mean_square (S : Finset ℕ) (a : ℕ → ℂ)
    (N : ℕ) (T v : ℝ) (hT : 0 ≤ T)
    (hS : ∀ n ∈ S, 1 ≤ n ∧ n ≤ N) :
    (∫ t in Set.Icc (-T) T,
      ‖∑ n ∈ S, a n * harmonicMellinWeight (t + v) n‖ ^ 2) ≤
      (2*T + 4*(N : ℝ)*(1 + Real.log N)) *
        ∑ n ∈ S, ‖a n / (n : ℂ)‖ ^ 2 := by
  have hm := dirichlet_polynomial_mean_square S
    (fun n => a n * harmonicMellinWeight v n) N (-T) T (by linarith) hS
  rw [intervalIntegral.integral_of_le (by linarith), ← integral_Icc_eq_integral_Ioc] at hm
  rw [show T - -T = 2*T by ring] at hm
  calc
    _ = ∫ t in Set.Icc (-T) T,
        ‖∑ n ∈ S, (a n * harmonicMellinWeight v n) *
          Complex.exp (((Real.log (n : ℝ) * t : ℝ) : ℂ) * Complex.I)‖ ^ 2 := by
      apply setIntegral_congr_fun measurableSet_Icc
      intro t _
      simp only [harmonic_weight_add, mul_assoc]
    _ ≤ _ := hm
    _ = _ := by
      congr 1
      apply sum_congr rfl
      intro n hn
      rw [norm_mul, norm_harmonic_mellin_weight v (by exact_mod_cast (hS n hn).1),
        norm_div, Complex.norm_natCast]
      ring

theorem harmonic_four_box_shifted_mean_square
    (D A B C : Finset ℕ) (δ α β γ : ℕ → ℂ)
    {D₀ A₀ B₀ C₀ U : ℝ} (hD₀ : 0 ≤ D₀) (hA₀ : 0 ≤ A₀)
    (hB₀ : 0 ≤ B₀) (hC₀ : 0 ≤ C₀) (hU : 0 < U)
    (hD : ∀ d ∈ D, 0 < d) (hA : ∀ a ∈ A, 0 < a)
    (hB : ∀ b ∈ B, 0 < b) (hC : ∀ c ∈ C, 0 < c)
    (hδ : ∀ d ∈ D, ‖δ d‖ ≤ D₀) (hα : ∀ a ∈ A, ‖α a‖ ≤ A₀)
    (hβ : ∀ b ∈ B, ‖β b‖ ≤ B₀) (hγ : ∀ c ∈ C, ‖γ c‖ ≤ C₀)
    (N : ℕ) (hproduct : ∀ d ∈ D, ∀ a ∈ A, ∀ b ∈ B, ∀ c ∈ C,
      U ≤ ((d*a*b*c : ℕ) : ℝ) ∧ d*a*b*c ≤ N)
    (T v : ℝ) (hT : 0 ≤ T) :
    (∫ t in Set.Icc (-T) T,
      ‖(∑ d ∈ D, δ d * harmonicMellinWeight (t + v) d) *
        (∑ a ∈ A, α a * harmonicMellinWeight (t + v) a) *
        (∑ b ∈ B, β b * harmonicMellinWeight (t + v) b) *
        (∑ c ∈ C, γ c * harmonicMellinWeight (t + v) c)‖ ^ 2) ≤
      (2*T + 4*(N : ℝ)*(1 + Real.log N)) *
        ((D₀*A₀*B₀*C₀)^2 * ((N : ℝ)*(1 + Real.log N)^15) / U^2) := by
  classical
  let S := (D ×ˢ (A ×ˢ (B ×ˢ C))).image
    (fun q => q.1*q.2.1*q.2.2.1*q.2.2.2)
  let δ' : ℕ → ℂ := fun n => if n ∈ D then δ n else 0
  let α' : ℕ → ℂ := fun n => if n ∈ A then α n else 0
  let β' : ℕ → ℂ := fun n => if n ∈ B then β n else 0
  let γ' : ℕ → ℂ := fun n => if n ∈ C then γ n else 0
  have hS : ∀ n ∈ S, 0 < n ∧ n ≤ N ∧ U ≤ (n : ℝ) := by
    intro n hn
    obtain ⟨q, hq, rfl⟩ := mem_image.mp hn
    obtain ⟨hd, ha, hb, hc⟩ := by simpa only [mem_product] using hq
    have hp := hproduct q.1 hd q.2.1 ha q.2.2.1 hb q.2.2.2 hc
    exact ⟨mul_pos (mul_pos (mul_pos (hD _ hd) (hA _ ha)) (hB _ hb)) (hC _ hc),
      hp.2, hp.1⟩
  have hrepr (z : ℝ) :
      (∑ n ∈ S, endpointFourConvolution δ' α' β' γ' n * harmonicMellinWeight z n) =
        (∑ d ∈ D, δ d * harmonicMellinWeight z d) *
        (∑ a ∈ A, α a * harmonicMellinWeight z a) *
        (∑ b ∈ B, β b * harmonicMellinWeight z b) *
        (∑ c ∈ C, γ c * harmonicMellinWeight z c) := by
    have he := endpoint_four_finite_mellin S D A B C δ' α' β' γ' hD hA hB hC
      (by intro n hn; simp [δ', hn]) (by intro n hn; simp [α', hn])
      (by intro n hn; simp [β', hn]) (by intro n hn; simp [γ', hn])
      (by
        intro d hd a ha b hb c hc
        exact mem_image.mpr ⟨(d,a,b,c), by simp [hd, ha, hb, hc], rfl⟩) z
    simpa [δ', α', β', γ'] using he
  have he := endpoint_four_convolution_reciprocal_energy δ' α' β' γ'
    hD₀ hA₀ hB₀ hC₀ hU
    (by
      intro n
      dsimp only [δ']
      split_ifs with hn
      · exact hδ n hn
      · simpa only [norm_zero] using hD₀)
    (by
      intro n
      dsimp only [α']
      split_ifs with hn
      · exact hα n hn
      · simpa only [norm_zero] using hA₀)
    (by
      intro n
      dsimp only [β']
      split_ifs with hn
      · exact hβ n hn
      · simpa only [norm_zero] using hB₀)
    (by
      intro n
      dsimp only [γ']
      split_ifs with hn
      · exact hγ n hn
      · simpa only [norm_zero] using hC₀)
    S N (fun n hn => ⟨(hS n hn).1, (hS n hn).2.1⟩) (fun n hn => (hS n hn).2.2)
  calc
    _ = ∫ t in Set.Icc (-T) T,
        ‖∑ n ∈ S, endpointFourConvolution δ' α' β' γ' n *
          harmonicMellinWeight (t + v) n‖ ^ 2 := by
      apply setIntegral_congr_fun measurableSet_Icc
      intro t _
      dsimp only
      rw [hrepr]
    _ ≤ (2*T + 4*(N : ℝ)*(1 + Real.log N)) *
        ∑ n ∈ S, ‖endpointFourConvolution δ' α' β' γ' n / (n : ℂ)‖ ^ 2 :=
      harmonic_polynomial_shifted_mean_square S _ N T v hT
        (fun n hn => ⟨(hS n hn).1, (hS n hn).2.1⟩)
    _ ≤ _ := mul_le_mul_of_nonneg_left he (by
      have hlog := Real.log_natCast_nonneg N
      positivity)

end Bounty
