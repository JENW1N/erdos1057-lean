noncomputable def physicalGhostRhoChoice (qmax : ℝ) : ℝ :=
  (1 + Real.sqrt qmax) / 2

noncomputable def physicalGhostWeightChoice (qmax Vmax : ℝ) : ℝ :=
  physicalGhostWeightThreshold qmax (physicalGhostRhoChoice qmax) Vmax

theorem physical_ghost_rho_choice {qmax : ℝ} (hq0 : 0 ≤ qmax) (hq1 : qmax < 1) :
    0 < physicalGhostRhoChoice qmax ∧ physicalGhostRhoChoice qmax < 1 ∧
      qmax < physicalGhostRhoChoice qmax ^ 2 := by
  have hs0 := Real.sqrt_nonneg qmax
  have hs2 := Real.sq_sqrt hq0
  have hs1 : Real.sqrt qmax < 1 := by nlinarith
  unfold physicalGhostRhoChoice
  constructor
  · positivity
  constructor
  · linarith
  · nlinarith

/-- One explicit pair works simultaneously for all visit retentions and
group masses in the stated ranges, including doubled ghost births. -/
theorem physical_ghost_parameter_choice {qmax Vmax : ℝ}
    (hq0 : 0 ≤ qmax) (hq1 : qmax < 1) :
    let ρ := physicalGhostRhoChoice qmax
    let v := physicalGhostWeightChoice qmax Vmax
    0 < ρ ∧ ρ < 1 ∧ qmax < ρ ^ 2 ∧ 1 < v ∧
      physicalGhostWeightThreshold qmax ρ Vmax ≤ v ∧
      ∀ q V : ℝ, 0 ≤ q → q ≤ qmax → 0 ≤ V → V ≤ Vmax →
        (q / ρ ^ 2 + ((1 - q) / ρ) / v ≤ 1) ∧
        (q / ρ ^ 2 + ((1 - q) * V / ρ) / v ≤ 1) ∧
        (q / ρ ^ 2 + (2 * ((1 - q) * V / ρ)) / v < 1) := by
  obtain ⟨hρ0, hρ1, hgap⟩ := physical_ghost_rho_choice hq0 hq1
  dsimp only
  refine ⟨hρ0, hρ1, hgap, physicalGhostWeightThreshold_gt_one hρ0 hgap, le_rfl, ?_⟩
  intro q V hq hqmax hV0 hVmax
  obtain ⟨hD, hC⟩ := physical_ghost_damping_conditions hq hqmax hgap hρ0 hρ1
    (v := physicalGhostWeightChoice qmax Vmax) le_rfl hV0 hVmax
  exact ⟨hD, hC, physical_ghost_doubled_birth_damping hq hqmax hgap hρ0 hρ1
    le_rfl hV0 hVmax⟩

theorem physical_ghost_parameters_exist {qmax : ℝ} (hq0 : 0 ≤ qmax) (hq1 : qmax < 1)
    (Vmax : ℝ) :
    ∃ ρ v : ℝ, 0 < ρ ∧ ρ < 1 ∧ qmax < ρ ^ 2 ∧ 1 < v ∧
      physicalGhostWeightThreshold qmax ρ Vmax ≤ v ∧
      ∀ q V : ℝ, 0 ≤ q → q ≤ qmax → 0 ≤ V → V ≤ Vmax →
        (q / ρ ^ 2 + ((1 - q) / ρ) / v ≤ 1) ∧
        (q / ρ ^ 2 + ((1 - q) * V / ρ) / v ≤ 1) ∧
        (q / ρ ^ 2 + (2 * ((1 - q) * V / ρ)) / v < 1) := by
  exact ⟨physicalGhostRhoChoice qmax, physicalGhostWeightChoice qmax Vmax,
    physical_ghost_parameter_choice hq0 hq1⟩
end

