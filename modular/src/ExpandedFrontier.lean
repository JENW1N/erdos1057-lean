    (x : PhysicalFullBoundedState P J ell B) (e : PhysicalFullEdgeEvent (C j) (k j) x) :
    ‖physicalEnrichedEdgePhase C k ω β ρ V cut ζ K j H x e‖ ≤ 1 := by
  rw [physicalEnrichedEdgePhase, norm_mul]
  apply mul_le_one₀ (physical_full_global_edge_phase_norm_le _ _ _ _ _ _ _ _ _) (norm_nonneg _)
  exact physical_active_coefficient_norm_le _ _ _ _ _ (hK j) _ _ _

theorem physical_enriched_edge_birth_factor
