theorem repeated_big_kernel_mul_coefficient {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (ζ : ℝ)
    (K q : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (source target : RepeatedBigLists P J ell) :
    repeatedBigKernel V b C ζ (fun x y a => K x y a * q x y a) aux source target =
      repeatedBigKernel V b C ζ K aux source target * q source target aux := by
  unfold repeatedBigKernel
  split_ifs <;> ring

theorem repeated_big_unbanned_kernel_mul_coefficient {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (ζ : ℝ)
    (K q : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (source target : RepeatedBigLists P J ell) :
    repeatedBigUnbannedKernel V b C ζ (fun x y a => K x y a * q x y a) aux source target =
      repeatedBigUnbannedKernel V b C ζ K aux source target * q source target aux := by
  unfold repeatedBigUnbannedKernel
  split_ifs <;> ring

theorem repeated_big_phase_pattern_row {I G : Type*} [Fintype I] [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : I → G → Finset (Fin J)) (ζ Θ : ℝ) (c : I → ℂ)
    (K : ∀ i, RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (v : RepeatedBigLists P J ell → ℂ) :
    (∑ i, c i • repeatedBigRowAction V b (C i) ζ
      (fun x y a => K i x y a * physicalReturnPhase Θ (repeatedBigD (C i) x a)) v) =
    fun source => ∑ target, (∑ i, ∑ aux,
      repeatedBigKernel V b (C i) ζ (fun x y a => c i * K i x y a) aux source target *
        physicalReturnPhase Θ (repeatedBigD (C i) source aux)) * v target := by
  ext source
  simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, repeatedBigRowAction,
    repeated_big_kernel_mul_coefficient, mul_sum, sum_mul]
  rw [sum_comm]
  apply sum_congr rfl
  intro target _
  apply sum_congr rfl
  intro i _
  apply sum_congr rfl
  intro aux _
  unfold repeatedBigKernel
  split_ifs <;> ring

theorem repeated_big_unbanned_phase_pattern_row {I G : Type*} [Fintype I] [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ)
    (C : I → G → Finset (Fin J)) (ζ Θ : ℝ) (c : I → ℂ)
    (K : ∀ i, RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (v : RepeatedBigLists P J ell → ℂ) :
    (∑ i, c i • repeatedBigUnbannedRowAction V (C i) ζ
      (fun x y a => K i x y a * physicalReturnPhase Θ (repeatedBigD (C i) x a)) v) =
    fun source => ∑ target, (∑ i, ∑ aux,
      c i * repeatedBigUnbannedKernel V (fun _ _ => 1) (C i) ζ (K i) aux source target *
        physicalReturnPhase Θ (repeatedBigD (C i) source aux)) * v target := by
  ext source
  simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, repeatedBigUnbannedRowAction,
    repeated_big_unbanned_kernel_mul_coefficient, mul_sum, sum_mul]
  rw [sum_comm]
  apply sum_congr rfl
  intro target _
  apply sum_congr rfl
  intro i _
  apply sum_congr rfl
  intro aux _
  ring

/-- A direct clean-hybrid bound from the compressed, untilted, unbanned ideal
block. All signed patterns remain summed in the ideal hypothesis. The only
patternwise triangle estimate is the explicit sum of coefficient norms times
proved density and collision errors. -/
theorem clean_hybrid_symmetric_pattern_norm_le_of_unbanned {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ q ∈ Pb g, 1 / (q : ℝ) = V g)
    (b : ∀ g, Pb g → ℝ) (hbpos : ∀ g q, 0 < b g q)
    (C : I → G → Finset (Fin J)) (ζ θ : ℝ) (k : ℤ) (p : FixedOrderedMemoryLabels Pb N)
    [∀ q : PhysicalPrime Ps, NeZero q.2.val] [∀ g j, NeZero (p g j).val]
    (K : ∀ i, RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb (C i) → ℂ)
    (c : I → ℂ) (B : I → ℝ) (hB : ∀ i, 0 ≤ B i)
    (hK : ∀ i x y a, ‖K i x y a‖ ≤ B i)
    {T Pmin : ℝ} (hT : 0 ≤ T) (hPmin : 0 < Pmin)
    (hp : ∀ g (q : Pb g), Pmin ≤ (q.val : ℝ))
    (hb : ∀ g (q : Pb g), b g q = 1 - T / (q.val : ℝ))
    (hsmall : ∀ i, ((2 * ∑ g, (ell + (C i g).card) : ℕ) : ℝ) * T / Pmin ≤ 1 / 2)
    (d : PhysicalSharedLists Ps J) (M : ℝ) (hM : 0 ≤ M)
    (hideal : ∀ (Θ : ℝ) (v : RepeatedBigLists Pb J ell → ℂ), v ∈ repeatedBigSymmetricSubspace →
      cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
        (repeatedBigSymmetrizeLinear (fun source => ∑ target,
          (∑ i, ∑ aux, c i * repeatedBigUnbannedKernel V (fun _ _ => 1) (C i) ζ (K i) aux source target *
            physicalReturnPhase Θ (repeatedBigD (C i) source aux)) * v target)) ≤
          M * cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) v)
    (f : RepeatedBigLists Pb J ell → (PhysicalResidues Ps × FixedOrderedResidues p) → ℂ) :
    cleanWeightedNorm (repeatedBigActiveMass V b) (cleanActiveMap repeatedBigSymmetrizeLinear
        (cleanHybridPatternCoreAction V b C ζ θ k p (fun i x y a => c i * K i x y a) d
          (cleanActiveMap repeatedBigSymmetrizeLinear f))) ≤
      (M + ∑ i, ‖c i‖ * repeatedBigPatternError (ell := ell) V (C i) T Pmin (B i)) *
        cleanWeightedNorm (repeatedBigActiveMass V b) f := by
  have herr : 0 ≤ ∑ i, ‖c i‖ * repeatedBigPatternError (ell := ell) V (C i) T Pmin (B i) := by
    apply sum_nonneg
    intro i _
    exact mul_nonneg (norm_nonneg _) (repeated_big_pattern_error_nonneg V (C i) T Pmin (B i)
      (fun g => (hV g).le) hT hPmin.le (hB i))
  apply clean_hybrid_symmetric_pattern_norm_le V (fun g => (hV g).le) b
    (fun g q => (hbpos g q).le) C ζ θ k p (fun i x y a => c i * K i x y a) d
    _ (add_nonneg hM herr) _ f
  intro Θ v hv
  rw [← repeated_big_phase_pattern_row]
  apply repeated_big_symmetric_pattern_perturbation V b hbpos C hV hMass ζ
    (fun i x y a => K i x y a * physicalReturnPhase Θ (repeatedBigD (C i) x a))
    c B hB _ hT hPmin hp hb hsmall M _ v hv
  · intro i x y a
    simpa only [norm_mul, physicalReturnPhase_norm, mul_one] using hK i x y a
  · intro u hu
    rw [repeated_big_unbanned_phase_pattern_row]
    exact hideal Θ u hu
end

section
open Finset Filter
theorem eventually_candidate_full_mass_harmonic_upper {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hq : 0 ≤ q) (hr : 0 < r) :
    ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, 0 < jStar →
      candidateFullOrdinaryWindowMass c L q r jStar ≤
        (512 * (Real.log 4 + 1) / c) * (Real.exp L / L) *
          candidateSmallPHarmonicMass c L q (16 * Real.exp L + 1) *
            candidateQRestHarmonicMass c L r jStar hr := by
  filter_upwards [eventually_candidate_free_prime_card_upper hc] with L hcount
  intro jStar hj
  rw [candidate_full_ordinary_window_split c L q r jStar hr hj]
  have h := indexed_free_prime_mass_upper
    (candidateFullPSet c L) (candidateQBand (c * L) 0) (candidatePWeight c L q)
    (orderedSlotProduct (candidateQRestChoices c L r jStar hr))
    ((r.factorial : ℝ)^(candidateQIndices c L).card) (Real.exp L)
    ((512 * (Real.log 4 + 1) / c) / L)
    (by positivity) (fun p _ => candidate_P_weight_nonneg c L hq p) ?_
  · rw [candidateFullPSet, candidate_small_P_weight_harmonic_sum,
      ← candidate_Q_rest_harmonic_eq_tuple_sum] at h
    exact h.trans_eq (by ring)
  · intro p hp y
    have hn : 0 < p * orderedSlotProduct (candidateQRestChoices c L r jStar hr) y :=
      Nat.pos_of_ne_zero (mul_ne_zero (candidate_full_P_set_nonzero hp)
        (candidate_Q_rest_product_nonzero c L r jStar hr y))
    have hnR : (0 : ℝ) < (p * orderedSlotProduct (candidateQRestChoices c L r jStar hr) y : ℕ) :=
      Nat.cast_pos.mpr hn
    convert hcount _ hnR using 1; ring

theorem exists_candidate_coefficient_window_mass_upper {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hq : 0 ≤ q) (hr : 0 < r) :
    ∃ K : ℝ, 0 < K ∧ ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, 0 < jStar →
      candidateCoefficientWindowMass c L q r jStar ≤
        K * (Real.exp L / L) * candidateOneMarkedHarmonicMass c L q *
          candidateQHarmonicMass c L r jStar := by
  obtain ⟨V, hV, hrest⟩ := exists_candidate_Q_rest_harmonic_upper hc r hr
  let D : ℝ := 512 * (Real.log 4 + 1) / c
  have hD : 0 < D := by dsimp only [D]; positivity
  refine ⟨D * V, mul_pos hD hV, ?_⟩
  filter_upwards [eventually_candidate_full_mass_harmonic_upper hc hq hr, hrest,
    eventually_candidate_coefficient_full_convolution hc,
    eventually_gt_atTop (0 : ℝ)] with L hmass hrest hconv hL
  intro jStar hj
  have hsmall := candidate_small_P_harmonic_le_total (mul_nonneg hc.le hL.le) hq
    (16 * Real.exp L + 1)
  have hparts : candidateSmallPHarmonicMass c L q (16 * Real.exp L + 1) *
        candidateQRestHarmonicMass c L r jStar hr ≤
      candidateOneMarkedHarmonicMass c L q * (V * candidateQHarmonicMass c L r jStar) :=
    mul_le_mul hsmall (hrest jStar hj)
      (candidate_Q_rest_harmonic_nonneg c L r jStar hr)
      ((candidate_small_P_harmonic_nonneg c L q _ hq).trans hsmall)
  calc
    _ = candidateFullOrdinaryWindowMass c L q r jStar := hconv q r jStar
    _ ≤ D * (Real.exp L / L) * candidateSmallPHarmonicMass c L q (16 * Real.exp L + 1) *
        candidateQRestHarmonicMass c L r jStar hr := hmass jStar hj
    _ = (D * (Real.exp L / L)) *
        (candidateSmallPHarmonicMass c L q (16 * Real.exp L + 1) *
          candidateQRestHarmonicMass c L r jStar hr) := by ring
    _ ≤ (D * (Real.exp L / L)) *
        (candidateOneMarkedHarmonicMass c L q * (V * candidateQHarmonicMass c L r jStar)) :=
      mul_le_mul_of_nonneg_left hparts (by positivity)
    _ = _ := by ring
end

section
open Finset
open scoped Classical
section Events
variable {P : Type*} [Fintype P] [DecidableEq P] {R : P → Type*}
  [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)] {a b : P → Bool}

def GlobalBirthAmbientEvent (step : GlobalBirthRawStep (R := R) a b)
    (q : FiniteOrderedTuple (Σ p, R p)) : Type _ :=
  match step with
  | .visit h _ _ _ _ _ _ =>
      Σ _T : ↥((globalBirthVisitZeroIndices h q.2).powerset),
        Σ m : ↥(range (Fintype.card P + 1)), Fin m.val → P
  | .edge (t := t) delta _ _ _ _ _ _ _ _ _ =>
      Finset (Fin t) × FixedTargetEdgeEvent (Fin t) (Fin q.1) P
        (globalBirthRawHitIndices delta q)

noncomputable abbrev globalBirthAmbientEventFintype
    (step : GlobalBirthRawStep (R := R) a b) (q : FiniteOrderedTuple (Σ p, R p)) :
    Fintype (GlobalBirthAmbientEvent step q) := by
  cases step <;> unfold GlobalBirthAmbientEvent <;> infer_instance

noncomputable def globalBirthAmbientEventTarget (step : GlobalBirthRawStep (R := R) a b)
    (s : GlobalBirthHistoryState R) : GlobalBirthAmbientEvent step s.2 → GlobalBirthHistoryState R :=
  match step with
  | .visit h _ _ _ _ _ _ => fun e =>
      (s.1 ∪ univ.image e.2.2,
        retainedBirthTuple s.2.2 (univ \ e.1.val) (fun j => ⟨e.2.2 j, h (e.2.2 j)⟩))
  | .edge delta _ source _ _ _ _ _ _ _ => fun e =>
      (s.1 ∪ univ.image (unrestrictedEdgeTarget s.2.2 Sigma.fst e.2.1 e.2.2.1 e.2.2.2),
        unrestrictedEdgeOutput source s.2.2 (fun p => ⟨p, 0⟩)
          (unrestrictedPhaseTransport delta) e.1 e.2.1 e.2.2.1)

noncomputable def globalBirthAmbientEventWeight (step : GlobalBirthRawStep (R := R) a b)
    (q : FiniteOrderedTuple (Σ p, R p)) : GlobalBirthAmbientEvent step q → ℝ :=
  match step with
  | .visit h β η V ρ _ _ => fun e =>
      (((-η / ρ) ^ e.1.val.card *
        ((1 - η) / ρ ^ 2) ^ (globalBirthVisitZeroIndices h q.2 \ e.1.val).card) *
        ((-η * V / ρ) ^ e.2.1.val * (∏ j, β (e.2.2 j) / V))) /
          (e.2.1.val.factorial : ℝ)
  | .edge delta _ source _ _ _ β ρ V _ => fun e =>
      unrestrictedEdgeEventMass source q.2 (fun p => ⟨p, 0⟩)
        (unrestrictedPhaseTransport delta) (fun z => z.2 = 0) (fun p => β p / V)
        ρ V e.1 e.2.1 e.2.2.1 e.2.2.2

def globalBirthAmbientEventAllowed (step : GlobalBirthRawStep (R := R) a b)
    (s : GlobalBirthHistoryState R) : GlobalBirthAmbientEvent step s.2 → Prop :=
  match step with
  | .visit h _ _ _ _ _ cap => fun e =>
      (Function.Injective e.2.2 ∧ ∀ j, e.2.2 j ∉ s.1) ∧
      (retainedBirthTuple s.2.2 (univ \ e.1.val) (fun j => ⟨e.2.2 j, h (e.2.2 j)⟩)).1 ≤ cap
  | .edge delta _ source target _ _ _ _ _ cap => fun e =>
      (unrestrictedEdgeTarget s.2.2 Sigma.fst e.2.1 e.2.2.1 e.2.2.2 = target ∧
        ∀ j, e.2.2.2 j ∉ s.1) ∧
      (unrestrictedEdgeOutput source s.2.2 (fun p => ⟨p, 0⟩)
        (unrestrictedPhaseTransport delta) e.1 e.2.1 e.2.2.1).1 ≤ cap

noncomputable def globalBirthAmbientEventMass (step : GlobalBirthRawStep (R := R) a b)
    (s : GlobalBirthHistoryState R) (e : GlobalBirthAmbientEvent step s.2) : ℝ :=
  if globalBirthAmbientEventAllowed step s e then globalBirthAmbientEventWeight step s.2 e else 0

theorem global_birth_raw_step_ambient_event_sum (step : GlobalBirthRawStep (R := R) a b)
    (s : GlobalBirthHistoryState R) (F : GlobalBirthHistoryState R → ℂ) :
    let _ := globalBirthAmbientEventFintype step s.2
    globalBirthRawStepRow step (fun H q => F (H, q)) s.1 s.2 =
      ∑ e : GlobalBirthAmbientEvent step s.2,
        (globalBirthAmbientEventMass step s e : ℂ) * F (globalBirthAmbientEventTarget step s e) := by
  cases step with
  | visit h β η V ρ hV cap =>
      simp only [GlobalBirthAmbientEvent, Fintype.sum_sigma, globalBirthRawStepRow,
        global_birth_ghost_visit_eq_ambient_row, globalBirthGhostVisitAmbientRow,
        globalBirthAmbientEventMass, globalBirthAmbientEventAllowed,
        globalBirthAmbientEventWeight, globalBirthAmbientEventTarget]
      rw [← sum_coe_sort (globalBirthVisitZeroIndices h s.2.2).powerset]
      apply sum_congr rfl
      intro T _
      rw [← sum_coe_sort (range (Fintype.card P + 1))]
      apply sum_congr rfl
      intro m _
      apply sum_congr rfl
      intro f _
      split_ifs <;> simp_all
  | edge delta hshared source target hsource htarget β ρ V cap =>
      simp only [GlobalBirthAmbientEvent, Fintype.sum_prod_type, Fintype.sum_sigma,
        globalBirthRawStepRow, globalBirthEdgeRawRow, unrestrictedEdgeAction,
        globalBirthAmbientEventMass, globalBirthAmbientEventAllowed,
        globalBirthAmbientEventWeight, globalBirthAmbientEventTarget]
      apply sum_congr rfl
      intro stores _
      apply sum_congr rfl
      intro promotions _
      apply sum_congr rfl
      intro e _
      apply sum_congr rfl
      intro fresh _
      split_ifs <;> simp_all

end Events
end

section
open Finset
section Kernels
variable {I : Type*} [Fintype I] {R : I → Type*}
  [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]

omit [∀ p, Fintype (R p)] in
theorem ghost_phase_capped_visit_eq_of_card_le (a : I → Bool)
    (h : (p : I) → R p) (η β : I → ℝ) (cap : ℕ)
    (hc : Fintype.card I ≤ cap) (z w : (p : I) → GhostPhaseState (R p)) :
    ghostPhaseCappedVisit a h η β cap z w =
      ∏ p, ghostPhaseVisit (a p) (h p) (η p) (β p) (z p) (w p) := by
  have hz : (ghostPhasePendingSupport z).card ≤ cap := (card_le_univ _).trans hc
  exact if_pos hz

theorem ghost_phase_capped_edge_eq_of_card_le (atgt asrc : I → Bool)
    (htgt hsrc : (p : I) → R p) (β V : I → ℝ) (cap : ℕ)
    (hc : Fintype.card I ≤ cap) (z w : (p : I) → GhostPhaseState (R p)) :
    ghostPhaseCappedEdge atgt asrc htgt hsrc β V cap z w =
      ∏ p, ghostPhaseRunEdge (atgt p) (asrc p) (htgt p) (hsrc p)
        (β p) (V p) (z p) (w p) := by
  have hz : (ghostPhasePendingSupport z).card ≤ cap := (card_le_univ _).trans hc
  exact if_pos hz

end Kernels

section History
variable {I : Type*} [Fintype I] [DecidableEq I] {R : I → Type*}
  [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
  (a : I → ℕ → Bool) (h : (p : I) → ℕ → R p) (η : I → ℕ → ℝ)
  (β V : I → ℝ) (visitCap edgeCap : ℕ → ℕ)

/-- If no finite phase configuration can exceed the cap, the capped tensor
history factors into the original one-prime run-normalized histories. -/
theorem ghost_phase_capped_history_eq_run_product
    (hv : ∀ j, Fintype.card I ≤ visitCap j)
    (he : ∀ j, Fintype.card I ≤ edgeCap j) (n : ℕ) :
    ghostPhaseCappedHistory a h η β V visitCap edgeCap n =
      ∏ p, ghostPhaseRunHistory (a p) (h p) (η p) (β p) (V p) n := by
  have hG (j : ℕ) (z w : (p : I) → GhostPhaseState (R p)) :
      ghostPhaseCappedVisit (fun p => a p j) (fun p => h p j)
        (fun p => η p j) β (visitCap j) z w =
      ∏ p, ghostPhaseVisit (a p j) (h p j) (η p j) (β p) (z p) (w p) :=
    ghost_phase_capped_visit_eq_of_card_le _ _ _ _ _ (hv j) z w
  have hE (j : ℕ) (z w : (p : I) → GhostPhaseState (R p)) :
      ghostPhaseCappedEdge (fun p => a p (j + 1)) (fun p => a p j)
        (fun p => h p (j + 1)) (fun p => h p j) β V (edgeCap j) z w =
      ∏ p, ghostPhaseRunEdge (a p (j + 1)) (a p j) (h p (j + 1)) (h p j)
        (β p) (V p) (z p) (w p) :=
    ghost_phase_capped_edge_eq_of_card_le _ _ _ _ _ _ _ (he j) z w
  unfold ghostPhaseCappedHistory finiteAlternatingPairing
  simp_rw [finite_alternating_action, hG, hE]
  exact alternating_tensor_pairing_factor
    (fun j p => ghostPhaseVisit (a p j) (h p j) (η p j) (β p))
    (fun j p => ghostPhaseRunEdge (a p (j + 1)) (a p j)
      (h p (j + 1)) (h p j) (β p) (V p))
    (fun p => ghostPhaseRunInitial (a p 0) (β p) (V p))
    (fun p => ghostPhaseTerminal (a p n)) n

variable [∀ p, AddGroup (R p)]

theorem ghost_phase_capped_moving_history_eq_run_product (ρ : I → ℕ → ℝ)
    (hρ : ∀ p j, ρ p j ≠ 0)
    (hv : ∀ j, Fintype.card I ≤ visitCap j)
    (he : ∀ j, Fintype.card I ≤ edgeCap j) (n : ℕ) :
    ghostPhaseCappedMovingDampedHistory a h η β V ρ visitCap edgeCap n =
      ∏ p, ghostPhaseRunHistory (a p) (h p) (η p) (β p) (V p) n := by
  rw [ghost_phase_capped_moving_history_eq_undamped a h η β V ρ visitCap edgeCap hρ n,
    ghost_phase_capped_history_eq_run_product a h η β V visitCap edgeCap hv he n]

/-- Restoring the baseline recovers the original active-residue expectations,
including exactly one inverse-V factor per active run. This conclusion uses
both nonzero rho and the explicit inactive-cap hypotheses. -/
theorem ghost_phase_capped_moving_history_residue_identity [∀ p, Nonempty (R p)]
    (ρ : I → ℕ → ℝ) (hρ : ∀ p j, ρ p j ≠ 0)
    (hv : ∀ j, Fintype.card I ≤ visitCap j)
    (he : ∀ j, Fintype.card I ≤ edgeCap j) (n : ℕ) (b : I → ℝ)
    (hb : ∀ p, b p = 1 - (∑ j ∈ range (n + 1), η p j) / Fintype.card (R p))
    (hb0 : ∀ p, b p ≠ 0) :
    (∏ p, b p) * ghostPhaseCappedMovingDampedHistory a h η
      (fun p => ((Fintype.card (R p) : ℝ) * b p)⁻¹) V ρ visitCap edgeCap n =
      ∏ p, (V p)⁻¹ ^ ghostPhaseRunCount (a p) n *
        ((∑ r : R p, activeResidueWeight (range (n + 1))
          ((range (n + 1)).filter (fun j => a p j = true)) (h p) (η p) r) /
            Fintype.card (R p)) := by
  rw [ghost_phase_capped_moving_history_eq_run_product a h η _ V visitCap edgeCap ρ hρ hv he n,
    ← prod_mul_distrib]
  apply prod_congr rfl
  intro p _
  exact ghost_phase_run_history_residue_identity (a p) (h p) (η p) (V p) n (b p) (hb p) (hb0 p)

end History
end

section
open Finset
section Joint

variable {N : Nat} {P : Fin N → Type*} [∀ g, Fintype (P g)]
  [∀ g, DecidableEq (P g)] {R : (g : Fin N) → P g → Type*}
  [∀ g p, AddGroup (R g p)] [∀ g p, Fintype (R g p)]
  [∀ g p, DecidableEq (R g p)]

noncomputable def globalBirthJointCutRawRow
    {a b : (g : Fin N) → P g → Bool}
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (inputCap outputCap : Nat) (G : GlobalBirthJointState R → ℂ) :
    GlobalBirthJointState R → ℂ :=
  globalBirthJointRawCutoff inputCap (globalBirthJointRawRow step outputCap G)

noncomputable def globalBirthJointCutPhaseRow
    {a b : (g : Fin N) → P g → Bool}
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (inputCap outputCap : Nat) (F : GlobalBirthJointPhase R → ℂ) :
    GlobalBirthJointPhase R → ℂ :=
  globalBirthJointPhaseCutoff inputCap (globalBirthJointPhaseRow step outputCap F)

theorem global_birth_joint_cut_raw_row_intertwines
    {a b : (g : Fin N) → P g → Bool}
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (inputCap outputCap : Nat)
    (G : GlobalBirthJointState R → ℂ) (F : GlobalBirthJointPhase R → ℂ)
    (hGF : ∀ s, GlobalBirthJointCoherent b s → G s = F (globalBirthJointReadout b s))
    (s : GlobalBirthJointState R) (hs : GlobalBirthJointCoherent a s) :
    globalBirthJointCutRawRow step inputCap outputCap G s =
      globalBirthJointCutPhaseRow step inputCap outputCap F (globalBirthJointReadout a s) :=
  global_birth_joint_cutoff_readout a inputCap _ _
    (fun t ht => global_birth_joint_raw_row_intertwines step outputCap G F hGF t ht) s hs

variable (a : Nat → (g : Fin N) → P g → Bool)
  (steps : (i : Nat) → (g : Fin N) → GlobalBirthRawStep (R := R g) (a i g) (a (i + 1) g))
  (cap : Nat → Nat)

noncomputable def globalBirthJointRawHistory (n : Nat)
    (G : GlobalBirthJointState R → ℂ) : GlobalBirthJointState R → ℂ :=
  finiteRowComposition (S := fun _ => GlobalBirthJointState R)
    (fun i => globalBirthJointCutRawRow (steps i) (cap i) (cap (i + 1))) n G

noncomputable def globalBirthJointPhaseHistory (n : Nat)
    (F : GlobalBirthJointPhase R → ℂ) : GlobalBirthJointPhase R → ℂ :=
  finiteRowComposition (S := fun _ => GlobalBirthJointPhase R)
    (fun i => globalBirthJointCutPhaseRow (steps i) (cap i) (cap (i + 1))) n F

theorem global_birth_joint_raw_history_intertwines (n : Nat)
    (G : GlobalBirthJointState R → ℂ) (F : GlobalBirthJointPhase R → ℂ)
    (hGF : ∀ s, GlobalBirthJointCoherent (a n) s →
      G s = F (globalBirthJointReadout (a n) s))
    (s : GlobalBirthJointState R) (hs : GlobalBirthJointCoherent (a 0) s) :
    globalBirthJointRawHistory a steps cap n G s =
      globalBirthJointPhaseHistory a steps cap n F (globalBirthJointReadout (a 0) s) := by
  induction n generalizing G F with
  | zero => exact hGF s hs
  | succ n ih =>
      change globalBirthJointRawHistory a steps cap n
        (globalBirthJointCutRawRow (steps n) (cap n) (cap (n + 1)) G) s =
        globalBirthJointPhaseHistory a steps cap n
          (globalBirthJointCutPhaseRow (steps n) (cap n) (cap (n + 1)) F)
            (globalBirthJointReadout (a 0) s)
      apply ih
      intro t ht
      exact global_birth_joint_cut_raw_row_intertwines (steps n) (cap n) (cap (n + 1))
        G F hGF t ht

theorem global_birth_joint_raw_history_readout (n : Nat)
    (F : GlobalBirthJointPhase R → ℂ)
    (s : GlobalBirthJointState R) (hs : GlobalBirthJointCoherent (a 0) s) :
    globalBirthJointRawHistory a steps cap n
      (fun t => F (globalBirthJointReadout (a n) t)) s =
      globalBirthJointPhaseHistory a steps cap n F (globalBirthJointReadout (a 0) s) :=
  global_birth_joint_raw_history_intertwines a steps cap n _ F (fun _ _ => rfl) s hs

end Joint
end

section
open Finset
variable {G : Type*} [Fintype G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  {R : (g : G) → P g → Type*}

def globalBirthFlattenPhase (z : (g : G) → (p : P g) → GhostPhaseState (R g p)) :
    (p : Σ g, P g) → GhostPhaseState (R p.1 p.2) :=
  fun p => z p.1 p.2

theorem global_birth_flatten_pending_support
    (z : (g : G) → (p : P g) → GhostPhaseState (R g p)) :
    ghostPhasePendingSupport (globalBirthFlattenPhase z) =
      univ.sigma (fun g => ghostPhasePendingSupport (z g)) := by
  classical
  ext p
  change (p ∈ univ.filter (fun i : Σ g, P g =>
    ∃ r, z i.1 i.2 = some (some (some r)))) ↔
      p ∈ univ.sigma (fun g => univ.filter (fun q : P g =>
        ∃ r, z g q = some (some (some r))))
  simp only [mem_filter, mem_sigma, mem_univ, true_and]

theorem global_birth_flatten_pending_card
    (z : (g : G) → (p : P g) → GhostPhaseState (R g p)) :
    (ghostPhasePendingSupport (globalBirthFlattenPhase z)).card =
      ∑ g, (ghostPhasePendingSupport (z g)).card := by
  rw [global_birth_flatten_pending_support, card_sigma]

theorem global_birth_joint_phase_cutoff_flatten {N : Nat}
    {P : Fin N → Type*} [∀ g, Fintype (P g)] [∀ g, DecidableEq (P g)]
    {R : (g : Fin N) → P g → Type*} (cap : Nat)
    (F : GlobalBirthJointPhase R → ℂ) (z : GlobalBirthJointPhase R) :
    globalBirthJointPhaseCutoff cap F z =
      if (ghostPhasePendingSupport (globalBirthFlattenPhase z)).card ≤ cap then F z else 0 := by
  rw [global_birth_flatten_pending_card]
  rfl
end

section
open Finset
open scoped Classical
section ResiduePath
variable {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell n : ℕ}
  (C : Fin n → G → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations G J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (ζ : ∀ p : PhysicalPrime P, ZMod p.2.val)
  (hmarks : ∀ j : Fin (n + 1), ∀ p ∈ physicalMarkedPrimes (L j),
    ζ p = -(a j : ZMod p.2.val))

variable
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (g : G)
  (hk : ∀ j : Fin n, ∀ s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : ↥(P g) → ℝ) (η : Fin (n + 1) → ℝ) (V ρ : ℝ) (hV : V ≠ 0) (cap : ℕ)

variable [∀ p : ↥(P g), NeZero p.val]

omit [∀ p : ↥(P g), NeZero p.val] in
theorem physical_group_residue_history_event_paths :
    physicalGroupResidueFiniteRawHistory C aux k L a σ τ hstep ζ hmarks hlist hP hdis g hk β η V ρ hV cap =
      globalBirthRawEventPathAction (physicalGroupBareAtomicActivity L g)
        (physicalGroupResidueFiniteStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis g hk β η V ρ hV cap) (2 * n + 1)
        (fun _ _ => 1) (fun s => if s.2.1 = 0 then 1 else 0)
        (ghostPhaseActivitySupport (physicalGroupBareAtomicActivity L g 0),
          globalBirthEmptyMemory (R := fun p : ↥(P g) => ZMod p.val)) := by
  exact global_birth_raw_history_event_paths (physicalGroupBareAtomicActivity L g)
    (physicalGroupResidueFiniteStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis g hk β η V ρ hV cap) (2 * n + 1)
    (fun _ q => if q.1 = 0 then 1 else 0)
    (ghostPhaseActivitySupport (physicalGroupBareAtomicActivity L g 0))
    (globalBirthEmptyMemory (R := fun p : ↥(P g) => ZMod p.val))

theorem physical_group_residue_normalized_event_trace :
    ((∏ s : PhysicalSlots J ell, β (L 0 g s) / V : ℝ) : ℂ) *
      (globalBirthRawEventPathAction (physicalGroupBareAtomicActivity L g)
        (physicalGroupResidueFiniteStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis g hk β η V ρ hV cap) (2 * n + 1)
        (fun _ _ => 1) (fun s => if s.2.1 = 0 then 1 else 0)
        (ghostPhaseActivitySupport (physicalGroupBareAtomicActivity L g 0),
          globalBirthEmptyMemory (R := fun p : ↥(P g) => ZMod p.val))) =
    ∑ z : Fin (2 * n + 2) → (p : ↥(P g)) → GhostPhaseState (ZMod p.val),
      ((∏ p, ghostPhaseTerminal (physicalGroupPhaseActivity (L (Fin.last n)) g p)
        (z (Fin.last (2 * n + 1)) p) : ℝ) : ℂ) *
      (((∏ p, ghostPhaseRunInitial (physicalGroupPhaseActivity (L 0) g p)
        (β p) V (z 0 p) : ℝ) : ℂ) *
        ∏ j : Fin (2 * n + 1), globalBirthRawStepKernel
          (physicalGroupResidueFiniteStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis
            g hk β η V ρ hV cap j.val) (z j.succ) (z j.castSucc)) := by
  rw [← physical_group_residue_history_event_paths]
  exact physical_group_residue_normalized_history_trace C aux k L a σ τ hstep ζ hmarks hlist hP hdis g hk β η V ρ hV cap

end ResiduePath
