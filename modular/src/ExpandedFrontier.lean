section

/- The logarithmic first derivative bound for either sign of the frequency. -/

open Finset

namespace Bounty

theorem logarithmic_first_derivative_signed (a b : ℤ) (V t : ℝ)
    (ha : 0 < (a : ℝ)) (haV : (a : ℝ) ≤ V) (hbV : (b : ℝ)+1 ≤ V)
    (ht : t ≠ 0) (htmax : |t| ≤ Real.pi*(a : ℝ)) :
    ‖∑ n ∈ Icc a b, Complex.exp ((t*Real.log (n : ℝ) : ℝ)*Complex.I)‖ ≤
      4*Real.pi*V/|t| := by
  by_cases htp : 0 < t
  · rw [abs_of_pos htp] at htmax ⊢
    exact logarithmic_first_derivative_positive a b V t ha haV hbV htp htmax
  · have htn : t < 0 := lt_of_le_of_ne (le_of_not_gt htp) ht
    have hpos := logarithmic_first_derivative_positive a b V (-t) ha haV hbV
      (by linarith) (by rwa [abs_of_neg htn] at htmax)
    rw [abs_of_neg htn]
    have he := norm_sum_exp_phase_neg (Icc a b) (fun n => t*Real.log (n : ℝ))
    simp only [← neg_mul] at he
    rw [he] at hpos
    exact hpos

end Bounty
end

section

/- The actual exceptional prime-polynomial intervals are a subpower of Y,
uniformly in the prime set and its bounded coefficients. -/

open Filter
open scoped Topology

namespace Bounty

theorem eventually_prime_exceptional_intervals_subpower {a beta c A d ε : ℝ}
    (ha : 0 < a) (ha1 : a ≤ 1) (hbeta : beta < 1) (hc : 0 ≤ c) (hA : 0 ≤ A)
    (hd : 0 < d) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ (s : Finset ℕ), (∀ p ∈ s, Nat.Prime p) →
      ∀ (coeff : s → ℂ) (Y P R : ℝ),
      1 ≤ Y → d * L ≤ Real.log Y → Real.log Y ≤ c * L →
      Real.exp (L ^ a) / 2 ≤ P → P ≤ Real.exp (L ^ beta) →
      0 ≤ R → R ≤ Y →
      (∀ p ∈ s, P ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2 * P) →
      (∀ p : s, ‖coeff p‖ ≤ 1) →
      ((primeExceptionalIntervals s coeff (L ^ (-A)) R).card : ℝ) ≤ Y ^ ε := by
  filter_upwards [eventually_prime_moment_exp_le_rpow ha hbeta
      (zero_le_one.trans (prime_moment_actual_exponent_one_le hc hA)) hd hε,
    eventually_ge_atTop (Real.exp 1)] with L hsub hL
  intro s hs coeff Y P R hY hloglo hloghi hPlo hPhi hR hRY hband hcoeff
  exact (prime_exceptional_intervals_subexponential_bound s hs coeff ha.le ha1 hc hA
    hL hY hloghi hPlo hPhi hR hRY hband hcoeff).trans
      (hsub Y (zero_lt_one.trans_le hY) hloglo)

end Bounty
end

section

/- Fixed bounded coefficients reduce to unit coefficients by division.
The original exceptional intervals are retained through a literal inclusion,
with one additional power in the logarithmic threshold when the scale
dominates the fixed coefficient bound. -/

open Finset
open scoped Classical

namespace Bounty

theorem prime_reciprocal_polynomial_div (s : Finset ℕ) (coeff : s → ℂ)
    (B t : ℝ) :
    primeReciprocalPolynomial s (fun p => coeff p / (B : ℂ)) t =
      primeReciprocalPolynomial s coeff t / (B : ℂ) := by
  unfold primeReciprocalPolynomial
  rw [Finset.sum_div]
  apply Finset.sum_congr rfl
  intro p _
  ring

theorem prime_normalized_coefficient_norm_le_one (s : Finset ℕ) (coeff : s → ℂ)
    {B : ℝ} (hB : 0 < B) (hcoeff : ∀ p : s, ‖coeff p‖ ≤ B) (p : s) :
    ‖coeff p / (B : ℂ)‖ ≤ 1 := by
  rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hB]
  exact (div_le_one hB).mpr (hcoeff p)

theorem prime_bounded_coefficient_threshold {B L : ℝ} (A : ℝ)
    (hB : 0 < B) (hBL : B ≤ L) :
    L ^ (-(A + 1)) ≤ L ^ (-A) / B := by
  have hL : 0 < L := hB.trans_le hBL
  rw [show -(A + 1) = -A - 1 by ring, Real.rpow_sub hL, Real.rpow_one]
  exact div_le_div_of_nonneg_left (Real.rpow_nonneg hL.le _) hB hBL

theorem prime_exceptional_intervals_normalize_subset (s : Finset ℕ)
    (coeff : s → ℂ) {B L : ℝ} (A R : ℝ) (hB : 0 < B) (hBL : B ≤ L) :
    primeExceptionalIntervals s coeff (L ^ (-A)) R ⊆
      primeExceptionalIntervals s (fun p => coeff p / (B : ℂ))
        (L ^ (-(A + 1))) R := by
  intro i hi
  obtain ⟨t, ht, hR, hlarge⟩ := (mem_primeExceptionalIntervals s coeff _ R i).mp hi
  apply (mem_primeExceptionalIntervals s (fun p => coeff p / (B : ℂ)) _ R i).mpr
  refine ⟨t, ht, hR, ?_⟩
  rw [prime_reciprocal_polynomial_div, norm_div, Complex.norm_real,
    Real.norm_eq_abs, abs_of_pos hB]
  exact (prime_bounded_coefficient_threshold A hB hBL).trans_lt
    ((div_lt_div_iff_of_pos_right hB).mpr hlarge)

theorem prime_exceptional_bounded_coefficients_subexponential_bound
    (s : Finset ℕ) (hs : ∀ p ∈ s, Nat.Prime p) (coeff : s → ℂ)
    {a beta c A B L Y P R : ℝ}
    (ha0 : 0 ≤ a) (ha1 : a ≤ 1) (hc : 0 ≤ c) (hA : 0 ≤ A)
    (hB : 1 ≤ B) (hBL : B ≤ L)
    (hL : Real.exp 1 ≤ L) (hY : 1 ≤ Y) (hlogY : Real.log Y ≤ c * L)
    (hPlo : Real.exp (L ^ a) / 2 ≤ P) (hPhi : P ≤ Real.exp (L ^ beta))
    (hR : 0 ≤ R) (hRY : R ≤ Y)
    (hband : ∀ p ∈ s, P ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2 * P)
    (hcoeff : ∀ p : s, ‖coeff p‖ ≤ B) :
    ((primeExceptionalIntervals s coeff (L ^ (-A)) R).card : ℝ) ≤
      Real.exp (primeMomentActualExponent c (A + 1) *
        (L ^ beta + L ^ (1 - a) * Real.log L)) := by
  have hB0 : 0 < B := zero_lt_one.trans_le hB
  have hcard := Finset.card_le_card
    (prime_exceptional_intervals_normalize_subset s coeff A R hB0 hBL)
  have hcardR : ((primeExceptionalIntervals s coeff (L ^ (-A)) R).card : ℝ) ≤
      ((primeExceptionalIntervals s (fun p => coeff p / (B : ℂ))
        (L ^ (-(A + 1))) R).card : ℝ) := by exact_mod_cast hcard
  exact hcardR.trans (prime_exceptional_intervals_subexponential_bound s hs
    (fun p => coeff p / (B : ℂ)) ha0 ha1 hc (by linarith) hL hY hlogY
    hPlo hPhi hR hRY hband (prime_normalized_coefficient_norm_le_one s coeff hB0 hcoeff))

end Bounty
end

section

open Finset

namespace Bounty

theorem integer_mixed_logarithmic_sum_bound
    (hs : List ℝ) (q a u lo hi : ℝ) (l r : ℤ)
    (hq : 0 < q) (hu : u ≠ 0) (hlr : l ≤ r)
    (hhs : ∀ h ∈ hs, 0 < h) (hlo : 0 < lo) (hlohi : lo ≤ hi)
    (hbox : ∀ x ∈ Set.Icc (l:ℝ) ((r:ℝ)+1),
      lo ≤ x+a/q ∧ x+a/q+hs.sum ≤ hi) :
    let d := hs.length+2
    let lam := hs.prod * |u| * ((hs.length+1).factorial:ℝ) / hi^d
    let A := (hi/lo)^d
    ‖∑ n ∈ Icc l r, realUnitPhase
      (mixedForwardDifference hs (fun y => u * Real.log (q*y+a)) (n:ℝ))‖ ≤
      6*(A*((r:ℝ)-l+1)*Real.sqrt lam+2/Real.sqrt lam) := by
  dsimp only
  let lam := hs.prod * |u| * ((hs.length+1).factorial:ℝ) / hi^(hs.length+2)
  let A := (hi/lo)^(hs.length+2)
  have hhi : 0 < hi := lt_of_lt_of_le hlo hlohi
  have hprod : 0 < hs.prod := List.prod_pos hhs
  have hlam : 0 < lam := by dsimp only [lam]; positivity
  have hA : 1 ≤ A := by
    apply one_le_pow₀
    exact (le_div_iff₀ hlo).mpr (by simpa using hlohi)
  have hhs0 : ∀ h ∈ hs, 0 ≤ h := fun h hh => (hhs h hh).le
  have hcurv : hs.prod * |u| * ((1+hs.length).factorial:ℝ) /
        lo^(1+hs.length+1) = A*lam := by
    have hd : 1+hs.length+1 = hs.length+2 := by omega
    have hf : 1+hs.length = hs.length+1 := by omega
    rw [hd, hf]
    dsimp only [A, lam]
    rw [div_pow]
    field_simp
  have hcurvlow : hs.prod * |u| * ((1+hs.length).factorial:ℝ) /
        hi^(1+hs.length+1) = lam := by
    have hd : 1+hs.length+1 = hs.length+2 := by omega
    rw [hd, Nat.add_comm 1 hs.length]
  have hf : ∀ x ∈ Set.Icc (l:ℝ) ((r:ℝ)+1),
      HasDerivAt (mixedForwardDifference hs (fun y => u*Real.log (q*y+a)))
        (mixedForwardDifference hs (logarithmicDerivativeChain u (a/q) 1) x) x := by
    intro x hx
    exact (mixed_affine_logarithmic_phase_derivatives hs q a u x hq hhs0
      (lt_of_lt_of_le hlo (hbox x hx).1)).1
  have hf' : ∀ x ∈ Set.Icc (l:ℝ) ((r:ℝ)+1),
      HasDerivAt (mixedForwardDifference hs (logarithmicDerivativeChain u (a/q) 1))
        (mixedForwardDifference hs (logarithmicDerivativeChain u (a/q) 2) x) x := by
    intro x hx
    exact (mixed_affine_logarithmic_phase_derivatives hs q a u x hq hhs0
      (lt_of_lt_of_le hlo (hbox x hx).1)).2
  rcases le_total 0 (u*(-1:ℝ)^(1+hs.length)) with hp | hn
  · apply integer_second_derivative_sum_bound hlr hlam hA hf hf'
    intro x hx
    have hb := mixed_logarithmic_difference_positive_bounds_on_box hs u (a/q) 1 x lo hi
      hhs0 hlo (hbox x hx).1 (hbox x hx).2 hp
    rwa [hcurv, hcurvlow] at hb
  · apply integer_second_derivative_sum_bound_negative hlr hlam hA hf hf'
    intro x hx
    have hb := mixed_logarithmic_difference_negative_bounds_on_box hs u (a/q) 1 x lo hi
      hhs0 hlo (hbox x hx).1 (hbox x hx).2 hn
    rw [hcurv, hcurvlow] at hb
    simpa only [neg_mul] using hb


theorem integer_mixed_logarithmic_exp_sum_bound
    (hs : List ℝ) (q a u lo hi : ℝ) (l r : ℤ)
    (hq : 0 < q) (hu : u ≠ 0) (hlr : l ≤ r)
    (hhs : ∀ h ∈ hs, 0 < h) (hlo : 0 < lo) (hlohi : lo ≤ hi)
    (hbox : ∀ x ∈ Set.Icc (l:ℝ) ((r:ℝ)+1),
      lo ≤ x+a/q ∧ x+a/q+hs.sum ≤ hi) :
    let d := hs.length+2
    let lam := hs.prod * |u/(2*Real.pi)| * ((hs.length+1).factorial:ℝ) / hi^d
    let A := (hi/lo)^d
    ‖∑ n ∈ Icc l r, Complex.exp
      ((mixedForwardDifference hs (fun y => u * Real.log (q*y+a)) (n:ℝ) : ℂ)*Complex.I)‖ ≤
      6*(A*((r:ℝ)-l+1)*Real.sqrt lam+2/Real.sqrt lam) := by
  have hne : u/(2*Real.pi) ≠ 0 := div_ne_zero hu (by positivity)
  have hb := integer_mixed_logarithmic_sum_bound hs q a (u/(2*Real.pi)) lo hi l r
    hq hne hlr hhs hlo hlohi hbox
  have hf : (fun y => u/(2*Real.pi)*Real.log (q*y+a)) =
      (fun y => (u*Real.log (q*y+a))/(2*Real.pi)) := by funext y; ring
  rw [hf] at hb
  simpa only [real_unit_phase_mixed_div_two_pi] using hb


end Bounty
end

section

/- The remaining vertex weight depends only on the actual unshared labels. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_unshared_tagged_mem {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (p : PhysicalPrime P) :
    p ∈ physicalMarkedPrimes L \ physicalSharedPrimes C L ↔
      p.2 ∈ univ.image (physicalGroupUnsharedEmbedding C L p.1) := by
  rw [mem_sdiff, mem_physical_marked_primes, physical_group_unshared_embedding_mem]
  simp only [mem_physical_shared_primes, mem_physical_group_shared_primes]

theorem physical_unshared_vertex_congr {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L R : PhysicalMarkLists P J ell)
    (h : ∀ g, physicalGroupUnsharedEmbedding C L g = physicalGroupUnsharedEmbedding C R g)
    (q : ℝ) (w : ℤ) :
    physicalUnsharedVertex C L q w = physicalUnsharedVertex C R q w := by
  have he : physicalMarkedPrimes L \ physicalSharedPrimes C L =
      physicalMarkedPrimes R \ physicalSharedPrimes C R := by
    ext p
    rw [physical_unshared_tagged_mem, physical_unshared_tagged_mem, h]
  simp only [physicalUnsharedVertex, he]

theorem physical_unshared_marks_of_vertex_ne_zero {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (q : ℝ) (w : ℤ)
    (h : physicalUnsharedVertex C L q w ≠ 0) :
    ∀ g i, ((physicalGroupUnsharedEmbedding C L g i).val : ℤ) ∣ w := by
  intro g i
  by_contra hn
  apply h
  unfold physicalUnsharedVertex finiteMarkedVertex
  apply prod_eq_zero (mem_univ (⟨g, physicalGroupUnsharedEmbedding C L g i⟩ : PhysicalPrime P))
  have hm : (⟨g, physicalGroupUnsharedEmbedding C L g i⟩ : PhysicalPrime P) ∈
      physicalMarkedPrimes L \ physicalSharedPrimes C L := by
    rw [physical_unshared_tagged_mem]
    exact mem_image.mpr ⟨i, mem_univ _, rfl⟩
  rw [if_pos hm, if_neg hn]

theorem physical_unshared_marks_of_full_vertex_ne_zero {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) {q : ℝ}
    (hq : 0 < q) (w : ℤ)
    (h : physicalVertexWeight L q ((physicalSharedFactor C L : ℤ) * w) ≠ 0) :
    ∀ g i, ((physicalGroupUnsharedEmbedding C L g i).val : ℤ) ∣ w :=
  physical_unshared_marks_of_vertex_ne_zero C L q w
    ((physical_shared_vertex_nonzero_iff C L hprime hdis hq w).mpr h)

end Bounty
end

section

/- The literal small-mark peel has one extracted prime and three remaining factors. -/

open Finset

namespace Bounty

theorem selected_marked_prime_peel_four_convolution
    {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (Q : Finset ℕ) (q : ℝ) (V : G → ℝ)
    (t u : G → ℕ) (g : G) (k : ℕ) (big : Finset G)
    (b : GroupMarkedLists (fun g : big => P g.val) (fun g : big => u g.val) → ℂ)
    (α β γ : ℕ → ℂ) (hP : ∀ g, ∀ p ∈ P g, p.Prime) (hPQ : ∀ g, P g ⊆ Q)
    (hα : ∀ d, ¬ Disjoint d.primeFactors Q → α d = 0)
    (hβ : ∀ d, ¬ Disjoint d.primeFactors Q → β d = 0)
    {n : ℕ} (hn : n ≠ 0) :
    markedPrimePeel univ P q V t g k
      (fun m => groupMarkedAverage (fun g : big => P g.val) (fun g : big => u g.val)
        (m : ℤ) b * invariantTripleEndpoint Q α β γ m) n =
      endpointFourConvolution (fun p => if p ∈ P g then 1 / (V g : ℂ) else 0) α β
        (fun r => selectedMarkedWeight P Q q V (Function.update t g k) u big b (fun _ => 1) r *
          γ (primePoolFreePart Q r)) n := by
  have h := prime_peel_weighted_triple_convolution (P g) Q (fun _ => 1 / (V g : ℂ))
    (selectedMarkedWeight P Q q V (Function.update t g k) u big b (fun _ => 1)) α β γ
    (selected_marked_weight_mul_free P Q q V (Function.update t g k) u big b
      (fun _ => 1) hP hPQ) hα hβ hn
  simpa only [markedPrimePeel, selectedMarkedWeight, one_mul, mul_sum, mul_ite,
    mul_zero, mul_assoc] using h

end Bounty
end

section

/- The literal reciprocal four-fold convolution has the coefficient energy
needed by the ordinary and exceptional dyadic mean-square estimates. -/

open Finset Filter

namespace Bounty

theorem eventually_four_convolution_reciprocal_power_energy {c E : ℝ} (hc : 0 ≤ c) :
    ∀ᶠ L : ℝ in atTop, ∀ (δ α β γ : ℕ → ℂ) (D A B C U : ℝ),
      0 ≤ D → 0 ≤ A → 0 ≤ B → 0 ≤ C → 1 ≤ U → Real.log U ≤ c * L →
      D * A * B * C ≤ L ^ E →
      (∀ n, ‖δ n‖ ≤ D) → (∀ n, ‖α n‖ ≤ A) →
      (∀ n, ‖β n‖ ≤ B) → (∀ n, ‖γ n‖ ≤ C) →
      ∀ S : Finset ℕ, (∀ n ∈ S, U ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2 * U) →
      (∑ n ∈ S, ‖endpointFourConvolution δ α β γ n / (n : ℂ)‖ ^ 2) ≤
        L ^ (2 * E + 16) / U := by
  filter_upwards [eventually_ge_atTop (1 : ℝ),
    eventually_ge_atTop (3 * (1 + Real.log 3 + c) ^ (15 : ℕ))] with L hL hlarge
  intro δ α β γ D A B C U hD hA hB hC hU hlog hprod hδ hα hβ hγ S hband
  have hU0 : 0 < U := zero_lt_one.trans_le hU
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hS : ∀ n ∈ S, 0 < n ∧ n ≤ ⌈2 * U⌉₊ := by
    intro n hn
    constructor
    · exact_mod_cast hU0.trans_le (hband n hn).1
    · exact_mod_cast (hband n hn).2.trans (Nat.le_ceil (2 * U))
  have hraw := endpoint_four_convolution_reciprocal_energy δ α β γ
    hD hA hB hC hU0 hδ hα hβ hγ S ⌈2 * U⌉₊ hS (fun n hn => (hband n hn).1)
  have hN : (⌈2 * U⌉₊ : ℝ) ≤ 3 * U := by
    have hh := Nat.ceil_lt_add_one (by linarith : 0 ≤ 2 * U)
    linarith
  have hlog0 : 0 ≤ 1 + Real.log ⌈2 * U⌉₊ := by
    linarith [Real.log_natCast_nonneg ⌈2 * U⌉₊]
  have hprod0 : 0 ≤ D * A * B * C := by positivity
  have hsq : (D * A * B * C) ^ (2 : ℕ) ≤ (L ^ E) ^ (2 : ℕ) :=
    pow_le_pow_left₀ hprod0 hprod 2
  have hbudget := four_convolution_log_budget hc hL hlarge hU hlog
  calc
    _ ≤ (D * A * B * C) ^ (2 : ℕ) *
        ((⌈2 * U⌉₊ : ℝ) * (1 + Real.log ⌈2 * U⌉₊) ^ (15 : ℕ)) / U ^ (2 : ℕ) := hraw
    _ ≤ (L ^ E) ^ (2 : ℕ) * (3 * U * (1 + Real.log ⌈2 * U⌉₊) ^ (15 : ℕ)) /
        U ^ (2 : ℕ) := by gcongr
    _ = (L ^ E) ^ (2 : ℕ) * (3 * (1 + Real.log ⌈2 * U⌉₊) ^ (15 : ℕ)) / U := by
      field_simp
    _ ≤ (L ^ E) ^ (2 : ℕ) * L ^ (16 : ℕ) / U := by gcongr
    _ = L ^ (2 * E + 16) / U := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hL0.le,
        ← Real.rpow_natCast, ← Real.rpow_add hL0]
      congr 2
      norm_num
      ring

end Bounty
end

section

/- Four dyadic input factors need only five dyads after collapsing their coefficients. -/

open Finset

namespace Bounty

theorem four_dyadic_factor_product_bounds {UD UA UB UC : ℝ} {d a b c : ℕ}
    (hUD : 0 < UD) (hUA : 0 < UA) (hUB : 0 < UB) (hUC : 0 < UC)
    (hd : UD ≤ (d : ℝ) ∧ (d : ℝ) ≤ 2*UD) (ha : UA ≤ (a : ℝ) ∧ (a : ℝ) ≤ 2*UA)
    (hb : UB ≤ (b : ℝ) ∧ (b : ℝ) ≤ 2*UB) (hc : UC ≤ (c : ℝ) ∧ (c : ℝ) ≤ 2*UC) :
    UD*UA*UB*UC ≤ (d*a*b*c : ℕ) ∧ (d*a*b*c : ℕ) ≤ 16*(UD*UA*UB*UC) := by
  rcases hd with ⟨hdlo,hdhi⟩
  rcases ha with ⟨halo,hahi⟩
  rcases hb with ⟨hblo,hbhi⟩
  rcases hc with ⟨hclo,hchi⟩
  push_cast
  constructor
  · gcongr
  · calc
      _ ≤ (2*UD)*(2*UA)*(2*UB)*(2*UC) := by gcongr
      _ = _ := by ring

theorem endpoint_four_five_dyads (D A B C : Finset ℕ) (δ α β γ : ℕ → ℂ)
    {UD UA UB UC : ℝ} (hUD : 0 < UD) (hUA : 0 < UA) (hUB : 0 < UB) (hUC : 0 < UC)
    (hD : ∀ d ∈ D, UD ≤ (d : ℝ) ∧ (d : ℝ) ≤ 2*UD)
    (hA : ∀ a ∈ A, UA ≤ (a : ℝ) ∧ (a : ℝ) ≤ 2*UA)
    (hB : ∀ b ∈ B, UB ≤ (b : ℝ) ∧ (b : ℝ) ≤ 2*UB)
    (hC : ∀ c ∈ C, UC ≤ (c : ℝ) ∧ (c : ℝ) ≤ 2*UC)
    (hδ : ∀ d, d ∉ D → δ d = 0) (hα : ∀ a, a ∉ A → α a = 0)
    (hβ : ∀ b, b ∉ B → β b = 0) (hγ : ∀ c, c ∉ C → γ c = 0) (t : ℝ) :
    let V := UD*UA*UB*UC
    let S := Icc 1 ⌊16*V⌋₊
    let U := V/2
    (∑ d ∈ D, δ d*harmonicMellinWeight t d)*
      (∑ a ∈ A, α a*harmonicMellinWeight t a)*
      (∑ b ∈ B, β b*harmonicMellinWeight t b)*
      (∑ c ∈ C, γ c*harmonicMellinWeight t c) =
      ∑ j : Fin 5, ∑ n ∈ Icc (⌊(2 : ℝ)^j.val*U⌋₊+1) ⌊(2 : ℝ)^(j.val+1)*U⌋₊,
        (if n ∈ S then endpointFourConvolution δ α β γ n/(n : ℂ) else 0)*
          Complex.exp (((Real.log (n : ℝ)*t : ℝ) : ℂ)*Complex.I) := by
  dsimp only
  have hDpos : ∀ d ∈ D, 0 < d := fun d hd => Nat.cast_pos.mp (hUD.trans_le (hD d hd).1)
  have hApos : ∀ a ∈ A, 0 < a := fun a ha => Nat.cast_pos.mp (hUA.trans_le (hA a ha).1)
  have hBpos : ∀ b ∈ B, 0 < b := fun b hb => Nat.cast_pos.mp (hUB.trans_le (hB b hb).1)
  have hCpos : ∀ c ∈ C, 0 < c := fun c hc => Nat.cast_pos.mp (hUC.trans_le (hC c hc).1)
  apply endpoint_four_dyadic_representation _ D A B C δ α β γ hDpos hApos hBpos hCpos hδ hα hβ hγ
  · intro d hd a ha b hb c hc
    have hp := four_dyadic_factor_product_bounds hUD hUA hUB hUC
      (hD d hd) (hA a ha) (hB b hb) (hC c hc)
    exact mem_Icc.mpr ⟨Nat.mul_pos (Nat.mul_pos (Nat.mul_pos (hDpos d hd)
      (hApos a ha)) (hBpos b hb)) (hCpos c hc),Nat.le_floor hp.2⟩
  · positivity
  · intro d hd a ha b hb c hc
    have hp := four_dyadic_factor_product_bounds hUD hUA hUB hUC
      (hD d hd) (hA a ha) (hB b hb) (hC c hc)
    have hV : 0 < UD*UA*UB*UC := by positivity
    constructor
    · linarith
    · norm_num at hp ⊢
      linarith

end Bounty
end

section

/- Fourier multipliers on the unchanged common initial-and-event allocation.
Every touched address retains its performed test even at zero frequency. -/

open Finset Classical
namespace Bounty

section Common
variable {J K Z : Type*} {N : ℕ} (M : Fin N → ℕ) (B : ℕ)
  (steps : List (Option (J ⊕ K)))

noncomputable def commonForestObservedMultiplier
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))
    (θ : (Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) ×
      Fin (Fintype.card (FullMixedCommonBirthAddress M B steps))) → ℝ)
    (encode : Z → ℤ) (label : FullMixedCommonBirthAddress M B steps → Option Z)
    (o : Option (Fin steps.length)) : ℂ :=
  birthForestOperationMultiplier code
    (fun j => fullMixedCommonOwner M B steps (fullMixedCommonBirthOrder M B steps j)) θ
    (fun j => (label (fullMixedCommonBirthOrder M B steps j)).isSome = true)
    (fun j => ((label (fullMixedCommonBirthOrder M B steps j)).map encode).getD 0) o

theorem common_forest_observed_multiplier_congr
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))
    (θ : (Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) ×
      Fin (Fintype.card (FullMixedCommonBirthAddress M B steps))) → ℝ)
    (encode : Z → ℤ) (label label' : FullMixedCommonBirthAddress M B steps → Option Z)
    (o : Option (Fin steps.length))
    (h : ∀ a, fullMixedCommonOwner M B steps a = o → label a = label' a) :
    commonForestObservedMultiplier M B steps code θ encode label o =
      commonForestObservedMultiplier M B steps code θ encode label' o := by
  apply birth_forest_operation_multiplier_congr_on_owner
  · intro j hj
    rw [h _ hj]
  · intro j hj
    rw [h _ hj]

theorem common_forest_observed_multiplier_norm_le_one
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))
    (θ : (Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) ×
      Fin (Fintype.card (FullMixedCommonBirthAddress M B steps))) → ℝ)
    (encode : Z → ℤ) (label : FullMixedCommonBirthAddress M B steps → Option Z)
    (o : Option (Fin steps.length)) :
    ‖commonForestObservedMultiplier M B steps code θ encode label o‖ ≤ 1 :=
  birthForestOperationMultiplier_norm_le_one _ _ _ _ _ _

noncomputable def commonForestEventLabels (i : Fin steps.length)
    (label : FullMixedCommonLocalAddress M B (steps.get i) → Option Z) :
    FullMixedCommonBirthAddress M B steps → Option Z
  | .inl _ => none
  | .inr ⟨j, a⟩ => if h : j = i then label (h ▸ a) else none

def commonForestInitialLabels (label : FullMixedCommonInitialAddress M → Z) :
    FullMixedCommonBirthAddress M B steps → Option Z
  | .inl a => some (label a)
  | .inr _ => none

end Common

section Actual
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ) (steps : List (Option (J ⊕ K)))
  (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))
  (θ : (Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) ×
    Fin (Fintype.card (FullMixedCommonBirthAddress M B steps))) → ℝ)
  (encode : ((g : Fin N) × P g) → ℤ)
  (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
  (p : FullPermutationMixedPath n S B A Δ D steps x)

noncomputable def fullMixedCommonOperationMultiplier (o : Option (Fin steps.length)) : ℂ :=
  commonForestObservedMultiplier M B steps code θ encode
    (fullMixedCommonBirthLabel n S B A Δ D steps x p) o

theorem full_mixed_common_operation_multiplier_product :
    (∏ o : Option (Fin steps.length),
      fullMixedCommonOperationMultiplier n S B A Δ D steps code θ encode x p o) =
    if ∀ j ∈ birthForestTouched code,
        fullMixedCommonIndexedPerformed n S B A Δ D steps x p j then
      ∏ j, physicalReturnPhase (birthForestLocalFrequency code θ j)
        (fullMixedCommonIndexedValue n S B A Δ D steps encode x p j) else 0 :=
  birthForestOperationMultiplier_product _ _ _ _ _

theorem full_mixed_common_operation_multiplier_initial :
    fullMixedCommonOperationMultiplier n S B A Δ D steps code θ encode x p none =
      commonForestObservedMultiplier M B steps code θ encode
        (commonForestInitialLabels M B steps (fullMixedCommonInitialPrime x)) none := by
  apply common_forest_observed_multiplier_congr
  intro a ha
  cases a with
  | inl a => rfl
  | inr a => cases ha

theorem full_mixed_common_operation_multiplier_event (i : Fin steps.length) :
    let e := finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x p i
    fullMixedCommonOperationMultiplier n S B A Δ D steps code θ encode x p (some i) =
      commonForestObservedMultiplier M B steps code θ encode
        (commonForestEventLabels M B steps i
          (fullMixedCommonEventBirthLabel n S B A Δ D (steps.get i) e.1 e.2)) (some i) := by
  dsimp only
  apply common_forest_observed_multiplier_congr
  intro a ha
  cases a with
  | inl a => cases ha
  | inr a =>
    obtain ⟨j, a⟩ := a
    have hji : j = i := Option.some.inj ha
    subst j
    simpa only [commonForestEventLabels, dite_true, full_mixed_common_new_label] using
      full_mixed_common_path_label_occurrence n S B A Δ D steps x p i a

end Actual
end Bounty
end

section

/- The selected ordered-list average preserves the polynomial marked-weight bound. -/

open Finset

namespace Bounty

theorem selected_marked_weight_norm_le_rpow {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (Q : Finset ℕ) {q v L K B : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (hL : 0 < L)
    (V : G → ℝ) (t u : G → ℕ) (T : ℕ) (big : Finset G)
    (hV : ∀ g, v ≤ V g) (ht : ∀ g, t g ≤ T)
    (hcard : (Fintype.card G : ℝ) ≤ K*Real.log L)
    (b : GroupMarkedLists (fun g : big => P g.val) (fun g : big => u g.val) → ℂ)
    (hb : ∀ l, ‖b l‖ ≤ L^B) (κ : ℕ → ℂ) (hκ : ∀ d, ‖κ d‖ ≤ 1) (n : ℕ) :
    ‖selectedMarkedWeight P Q q V t u big b κ n‖ ≤
      L^(K*Real.log (markedDivisorBound q v T)+B) := by
  have hw := marked_divisor_weight_le_rpow univ P hq0 hq1 hv hL V t T
    (fun g _ => hV g) (fun g _ => ht g) (by simpa only [card_univ] using hcard) (n : ℤ)
  have hw0 := marked_divisor_weight_nonneg univ P hq0 V t
    (fun g _ => hv.le.trans (hV g)) (n : ℤ)
  have hb' := group_marked_average_norm_le (fun g : big => P g.val)
    (fun g : big => u g.val) (n : ℤ) b (Real.rpow_nonneg hL.le B) (fun l => hb l.val)
  rw [selectedMarkedWeight,norm_mul,norm_mul,Complex.norm_real,Real.norm_eq_abs,
    abs_of_nonneg hw0]
  calc
    _ ≤ (1*L^(K*Real.log (markedDivisorBound q v T)))*L^B :=
      mul_le_mul (mul_le_mul (hκ _) hw hw0 (by norm_num)) hb'
        (norm_nonneg _) (by positivity)
    _ = _ := by rw [one_mul,← Real.rpow_add hL]

end Bounty
end

section

/- Exact dependent decomposition of an original list into shared and unshared data. -/

open Finset
open scoped Classical
namespace Bounty

private theorem sigma_subtype_base_val_ext {A B : Type*} {R : A → B → Prop}
    (x y : Σ a, {b // R a b}) (hbase : x.1 = y.1) (hval : x.2.val = y.2.val) : x = y := by
  rcases x with ⟨a, ⟨u, hu⟩⟩
  rcases y with ⟨b, ⟨v, hv⟩⟩
  dsimp only at hbase hval
  subst b
  subst v
  rfl

noncomputable def physicalCutListSigmaEquiv {G : Type*} (P : G → Finset ℕ) {J : ℕ}
    (C : G → Finset (Fin J)) (ell : ℕ) :
    PhysicalMarkLists P J ell ≃ Σ s : PhysicalCutSharedEmbedding P C, PhysicalCutCompletion P C ell s where
  toFun L := ⟨physicalCutShared C L, physicalCutCompletionOfList C L⟩
  invFun d := physicalCutGlue C d.1 d.2
  left_inv L := physical_cut_glue_of_list C L
  right_inv d := by
    rcases d with ⟨s, ⟨u, hu⟩⟩
    apply sigma_subtype_base_val_ext
    · exact physical_cut_glue_shared C s ⟨u, hu⟩
    · change (fun g => (physicalCutListEquiv P C ell (physicalCutGlue C s ⟨u, hu⟩) g).val.2) = u
      rw [physical_cut_glue_split]

noncomputable def sigmaSameBasePairEquiv {A : Type*} {B : A → Type*} :
    {x : (Σ a, B a) × (Σ a, B a) // x.1.1 = x.2.1} ≃ Σ a, B a × B a where
  toFun x := by
    rcases x with ⟨⟨⟨a, u⟩, ⟨b, v⟩⟩, h⟩
    dsimp only at h
    subst b
    exact ⟨a, u, v⟩
  invFun x := ⟨(⟨x.1, x.2.1⟩, ⟨x.1, x.2.2⟩), rfl⟩
  left_inv x := by
    rcases x with ⟨⟨⟨a, u⟩, ⟨b, v⟩⟩, h⟩
    dsimp only at h
    subst b
    rfl
  right_inv x := by
    rcases x with ⟨a, u, v⟩
    rfl

end Bounty
end

section

/- The original full vertex pair on any retained bad event has the explicit
shared-overlap loss. The coefficient may depend on the shared labels. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_bad_vertex_coefficient_norm_le {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L R : PhysicalMarkLists P J ell) (hshared : physicalSharedCompatible C L R)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    {q : ℝ} (hq0 : 0 < q) (hq1 : q ≤ 1) (w z : ℤ)
    (bad : Prop) [Decidable bad] (K : ℂ) {H : ℝ} (hK : ‖K‖ ≤ H) :
    ‖if bad then
        ((physicalVertexWeight L q ((physicalSharedFactor C L : ℤ) * w) *
          physicalVertexWeight R q ((physicalSharedFactor C L : ℤ) * z) : ℝ) : ℂ) * K
      else 0‖ ≤
      (physicalUnsharedVertex C L q w * physicalUnsharedVertex C R q z) *
        (H / q ^ (2 * ∑ g : G, (J - (C g).card))) * (if bad then 1 else 0) := by
  have hn (T : PhysicalMarkLists P J ell) (n : ℤ) : 0 ≤ physicalVertexWeight T q n := by
    unfold physicalVertexWeight
    split_ifs
    · exact prod_nonneg (fun g _ => pow_nonneg hq0.le _)
    · exact le_rfl
  have hp := mul_nonneg (hn L ((physicalSharedFactor C L : ℤ) * w))
    (hn R ((physicalSharedFactor C L : ℤ) * z))
  have ho := physical_shared_vertex_pair_overlap_bound C L R hshared hprime hdis hq0 hq1 w z
  by_cases hb : bad
  · rw [if_pos hb, if_pos hb, mul_one, norm_mul, Complex.norm_real,
      Real.norm_eq_abs, abs_of_nonneg hp]
    calc
      _ ≤ ((physicalUnsharedVertex C L q w * physicalUnsharedVertex C R q z) /
          q ^ (2 * ∑ g : G, (J - (C g).card))) * H :=
        mul_le_mul ho hK (norm_nonneg K) (hp.trans ho)
      _ = _ := by ring
  · simp only [if_neg hb, norm_zero, mul_zero, le_refl]

end Bounty
end

section

/- Harmonic summation of a pair error against the literal invariant endpoints.
All position bounds and polynomial coefficient losses remain explicit. -/

open Finset
namespace Bounty

theorem invariant_harmonic_pair_error (Q : Finset ℕ) (α β γ α' β' γ' : ℕ → ℂ)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (hα' : ∀ m, ‖α' m‖ ≤ A) (hβ' : ∀ p, ‖β' p‖ ≤ B) (hγ' : ∀ r, ‖γ' r‖ ≤ C)
    (S : Finset ℤ) (δ : ℤ) (N : ℕ)
    (hS : ∀ n ∈ S, 0 ≤ n ∧ n ≤ (N : ℤ))
    (hS' : ∀ n ∈ S, 0 ≤ n + δ ∧ n + δ ≤ (N : ℤ))
    {Y K M0 M1 ε : ℝ} (hY : 0 < Y) (hK : 0 ≤ K) (hM0 : 0 ≤ M0)
    (hM1 : 0 ≤ M1) (hε : 0 ≤ ε) (hYlow : ∀ n ∈ S, Y ≤ (n : ℝ))
    (θ e : ℤ → ℂ) (W0 W1 : ℤ → ℝ)
    (hθ : ∀ n ∈ S, ‖θ n‖ ≤ K)
    (hW0 : ∀ n ∈ S, 0 ≤ W0 n ∧ W0 n ≤ M0)
    (hW1 : ∀ n ∈ S, 0 ≤ W1 n ∧ W1 n ≤ M1)
    (he : ∀ n ∈ S, ‖e n‖ ≤ W0 n * W1 n * ε) :
    ‖∑ n ∈ S, (θ n / (n : ℂ)) *
      star (invariantTripleEndpoint Q α β γ n.natAbs) *
      invariantTripleEndpoint Q α' β' γ' (n+δ).natAbs * e n‖ ≤
      (K * M0 * M1 * ε / Y) * ((A*B*C)^2 * (N : ℝ) * (1+Real.log N)^15) := by
  have hweight : ∀ n ∈ S, ‖θ n * e n‖ ≤ K * M0 * M1 * ε := by
    intro n hn
    rw [norm_mul]
    have he' : ‖e n‖ ≤ M0 * M1 * ε := (he n hn).trans
      (mul_le_mul_of_nonneg_right
        (mul_le_mul (hW0 n hn).2 (hW1 n hn).2 (hW1 n hn).1 hM0) hε)
    calc
      _ ≤ K * (M0 * M1 * ε) := mul_le_mul (hθ n hn) he' (norm_nonneg _) hK
      _ = _ := by ring
  have hb := invariant_triple_endpoint_harmonic_multiples Q α β γ α' β' γ'
    hA hB hC hα hβ hγ hα' hβ' hγ' S δ 1 N
    (Nat.mem_factoredNumbers_of_primeFactors_subset (by norm_num) (by simp))
    (by simp) (by simp) hS hS' hY (by positivity) hYlow
    (fun n => θ n * e n) hweight
  simp only [Nat.cast_one, div_one] at hb
  convert hb using 1
  congr 1
  apply sum_congr rfl
  intro n _
  ring

end Bounty
end

section

/- A literal fixed-pattern, fixed-auxiliary summand of the original root. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def physicalFixedRootCorrelation
    {G : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (C : G → Finset (Fin J)) (q ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (positions : Finset ℤ)
    (f g : ℤ → ℂ) (Ψ : ℝ → ℂ) (Z : ℝ) : ℂ :=
  (physicalStateMass V J ell : ℂ) *
    ∑ x ∈ physicalCutoff P J ell positions, ∑ y ∈ physicalCutoff P J ell positions,
      if y.1 = x.1 + k * (physicalD C x.2.val aux : ℕ) then
        Ψ ((x.1 : ℝ) / (Z * physicalD C x.2.val aux)) * (x.1 : ℂ)⁻¹ *
        (starRingEnd ℂ) (f x.1) * physicalBarePatternScalar V C ζ K aux x.2.val y.2.val *
        g y.1 * ((physicalVertexWeight x.2.val q x.1 * physicalVertexWeight y.2.val q y.1 : ℝ) : ℂ)
      else 0

noncomputable def physicalRootPositionTerm
    {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (C : G → Finset (Fin J)) (q ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (f g : ℤ → ℂ) (Ψ : ℝ → ℂ) (Z : ℝ)
    (L R : PhysicalMarkLists P J ell) (n : ℤ) : ℂ :=
  let t := n + k * (physicalD C L aux : ℕ)
  Ψ ((n : ℝ) / (Z * physicalD C L aux)) * (n : ℂ)⁻¹ *
    (starRingEnd ℂ) (f n) * physicalBarePatternScalar V C ζ K aux L R *
    g t * ((physicalVertexWeight L q n * physicalVertexWeight R q t : ℝ) : ℂ)

theorem physical_mellin_root_sum_fixed
    {G I : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (patterns : Finset I) (C : I → G → Finset (Fin J))
    (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (positions : Finset ℤ) (f g : ℤ → ℂ) (Ψ : ℝ → ℂ) (Z : ℝ) :
    physicalMellinRootCorrelation V patterns C q ζ k K positions f g Ψ Z =
      ∑ i ∈ patterns, ∑ aux : PhysicalAuxLabels P (C i),
        physicalFixedRootCorrelation V (C i) q (ζ i) (k i) (K i) aux positions f g Ψ Z := by
  unfold physicalMellinRootCorrelation physicalFixedRootCorrelation
  simp only [← mul_sum]
  congr 1
  conv_lhs =>
    arg 2
    ext x
    rw [sum_comm]
  rw [sum_comm]
  apply sum_congr rfl
  intro i _
  conv_lhs =>
    arg 2
    ext x
    rw [sum_comm]
  rw [sum_comm]

end Bounty
end

section

/- Exact finite product reindexing retains the original output support and coupled cutoff. -/

open Finset

namespace Bounty

theorem endpoint_four_finite_cutoff_transform (S D A B C : Finset ℕ)
    (δ α β γ F : ℕ → ℂ)
    (hD : ∀ d ∈ D, 0 < d) (hA : ∀ a ∈ A, 0 < a)
    (hB : ∀ b ∈ B, 0 < b) (hC : ∀ c ∈ C, 0 < c)
    (hδ : ∀ d, d ∉ D → δ d = 0) (hα : ∀ a, a ∉ A → α a = 0)
    (hβ : ∀ b, b ∉ B → β b = 0) (hγ : ∀ c, c ∉ C → γ c = 0) :
    (∑ n ∈ S, endpointFourConvolution δ α β γ n * F n) =
      ∑ d ∈ D, ∑ a ∈ A, ∑ b ∈ B, ∑ c ∈ C,
        if d * a * b * c ∈ S then δ d * α a * β b * γ c * F (d*a*b*c) else 0 := by
  classical
  let U := S ∪ ((((D ×ˢ A) ×ˢ B) ×ˢ C).image
    (fun x => x.1.1.1 * x.1.1.2 * x.1.2 * x.2))
  have hSU : S ⊆ U := subset_union_left
  calc
    _ = ∑ n ∈ S, endpointFourConvolution δ α β γ n * (if n ∈ S then F n else 0) := by
      apply sum_congr rfl
      intro n hn
      rw [if_pos hn]
    _ = ∑ n ∈ U, endpointFourConvolution δ α β γ n * (if n ∈ S then F n else 0) := by
      apply sum_subset hSU
      intro n _ hn
      rw [if_neg hn, mul_zero]
    _ = ∑ d ∈ D, ∑ a ∈ A, ∑ b ∈ B, ∑ c ∈ C,
        δ d * α a * β b * γ c * (if d*a*b*c ∈ S then F (d*a*b*c) else 0) := by
      apply endpoint_four_finite_transform U D A B C δ α β γ _ hD hA hB hC hδ hα hβ hγ
      intro d hd a ha b hb c hc
      exact mem_union_right S (mem_image.mpr
        ⟨(((d,a),b),c), mem_product.mpr
          ⟨mem_product.mpr ⟨mem_product.mpr ⟨hd,ha⟩,hb⟩,hc⟩, rfl⟩)
    _ = _ := by simp only [mul_ite, mul_zero]

theorem endpoint_four_bounded_cutoff_transform (S : Finset ℕ) (N : ℕ)
    (hS : ∀ n ∈ S, n ≤ N) (δ α β γ F : ℕ → ℂ) :
    (∑ n ∈ S, endpointFourConvolution δ α β γ n * F n) =
      ∑ d ∈ Icc 1 N, ∑ a ∈ Icc 1 N, ∑ b ∈ Icc 1 N, ∑ c ∈ Icc 1 N,
        if d*a*b*c ∈ S then δ d * α a * β b * γ c * F (d*a*b*c) else 0 := by
  classical
  calc
    _ = ∑ n ∈ S,
        endpointFourConvolution (fun d => if d ∈ Icc 1 N then δ d else 0)
          (fun a => if a ∈ Icc 1 N then α a else 0)
          (fun b => if b ∈ Icc 1 N then β b else 0)
          (fun c => if c ∈ Icc 1 N then γ c else 0) n * F n := by
      apply sum_congr rfl
      intro n hn
      rw [endpoint_four_convolution_truncate δ α β γ (hS n hn)]
    _ = ∑ d ∈ Icc 1 N, ∑ a ∈ Icc 1 N, ∑ b ∈ Icc 1 N, ∑ c ∈ Icc 1 N,
        if d*a*b*c ∈ S then
          (if d ∈ Icc 1 N then δ d else 0) * (if a ∈ Icc 1 N then α a else 0) *
          (if b ∈ Icc 1 N then β b else 0) * (if c ∈ Icc 1 N then γ c else 0) *
            F (d*a*b*c) else 0 := by
      apply endpoint_four_finite_cutoff_transform
      all_goals first | (intro n hn; exact (mem_Icc.mp hn).1) |
        (intro n hn; exact if_neg hn)
    _ = _ := by
      apply sum_congr rfl
      intro d hd
      apply sum_congr rfl
      intro a ha
      apply sum_congr rfl
      intro b hb
      apply sum_congr rfl
      intro c hc
      rw [if_pos hd, if_pos ha, if_pos hb, if_pos hc]

end Bounty
end

section

open MeasureTheory

namespace Bounty

theorem local_mellin_weighted_energy_truncation (S : Finset ℕ) (a : ℕ → ℂ)
    {h R : ℝ} (hh : 0 < h) {j : ℕ} (hj : 2 ≤ j) :
    (∫ t : ℝ, (1+|h*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2) ≤
      (∫ t in {t : ℝ | |t| ≤ R}, ‖localMellinPolynomial S a t‖^2) +
      (∫ t in {t : ℝ | R < |t|}, (1+|h*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2) := by
  have hi := local_mellin_weighted_energy_integrable S a hh
    (show (1:ℝ)<j by exact_mod_cast (by omega : 1<j))
  have hs : MeasurableSet {t : ℝ | |t| ≤ R} :=
    (isClosed_le continuous_abs continuous_const).measurableSet
  have hset : {t : ℝ | |t| ≤ R} = Set.Icc (-R) R := by
    ext t
    exact (abs_le : |t| ≤ R ↔ -R ≤ t ∧ t ≤ R)
  have he : IntegrableOn (fun t => ‖localMellinPolynomial S a t‖^2) {t : ℝ | |t| ≤ R} := by
    rw [hset]
    exact ((local_mellin_polynomial_continuous S a).norm.pow 2).integrableOn_Icc
  have hsplit := integral_add_compl hs hi
  have hcompl : {t : ℝ | |t| ≤ R}ᶜ = {t : ℝ | R < |t|} := by ext t; simp
  rw [hcompl] at hsplit
  rw [← hsplit]
  apply _root_.add_le_add _ le_rfl
  apply setIntegral_mono_on hi.integrableOn he hs
  intro t ht
  have hw : (1+|h*t|)^(-(j:ℝ)) ≤ 1 := by
    apply Real.rpow_le_one_of_one_le_of_nonpos
    · have : 0 ≤ |h*t| := abs_nonneg _
      linarith
    · exact neg_nonpos.mpr (Nat.cast_nonneg j)
  simpa only [one_mul] using mul_le_mul_of_nonneg_right hw (sq_nonneg ‖localMellinPolynomial S a t‖)

theorem local_mellin_truncation_power_saving (A B D : ℝ) :
    ∃ j : ℕ, 2 ≤ j ∧ ∀ (L Y h : ℝ) (S : Finset ℕ) (a : ℕ → ℂ) (N : ℕ),
      16 ≤ L → 0 < Y → 0 < h → h⁻¹ ≤ Y →
      (∀ n ∈ S, 1 ≤ n ∧ n ≤ N) →
      (N:ℝ)*(1+Real.log N) ≤ Y*L^A →
      (∑ n ∈ S, ‖a n‖^2) ≤ Y*L^B →
      (∫ t : ℝ, (1+|h*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2) ≤
        (∫ t in {t : ℝ | |t| ≤ L/h}, ‖localMellinPolynomial S a t‖^2)+Y^2*L^(-D) := by
  obtain ⟨j,hj,htail⟩ := local_mellin_tail_power_saving A B D
  refine ⟨j,hj,?_⟩
  intro L Y h S a N hL hY hh hhi hS hN hE
  exact (local_mellin_weighted_energy_truncation S a hh (R := L/h) hj).trans
    (_root_.add_le_add le_rfl (htail L Y h S a N hL hY hh hhi hS hN hE))

end Bounty
end

section

/- Exact translation of local energy intervals to zero. -/

open MeasureTheory
namespace Bounty

theorem integral_centered_interval (f : ℝ → ℝ) (c w : ℝ) (hw : 0 ≤ w) :
    (∫ x in Set.Icc (c-w) (c+w), f x) =
      ∫ β in {β : ℝ | |β| ≤ w}, f (c+β) := by
  have hset : {β : ℝ | |β| ≤ w} = Set.Icc (-w) w := by
    ext β
    simp only [Set.mem_ofPred_eq, Set.mem_Icc, abs_le]
  rw [hset]
  simp_rw [integral_Icc_eq_integral_Ioc]
  rw [← intervalIntegral.integral_of_le (show c-w ≤ c+w by linarith),
    ← intervalIntegral.integral_of_le (show -w ≤ w by linarith),
    intervalIntegral.integral_comp_add_left]
  congr 1

theorem finite_fourier_centered_energy (S : Finset ℤ) (f : ℤ → ℂ)
    (hS : ∀ n ∈ S, 0 ≤ n) (c H : ℝ) (hH : 0 < H) :
    (∫ x in Set.Icc (c-1/H) (c+1/H), ‖finiteFourierSum S f x‖^2) =
      ∫ β in {β : ℝ | |β| ≤ 1/H},
        ‖localAdditivePolynomial (S.image Int.natAbs)
          (fun n => f n * fourier (n : ℤ) (c : AddCircle (1 : ℝ))) β‖^2 := by
  rw [integral_centered_interval _ c (1/H) (by positivity)]
  simp_rw [finite_fourier_eq_local_additive S f hS]

end Bounty
end

section

/- The original signed full-path action is unchanged by exact edge-key relabeling. -/

open Finset
open scoped Classical
namespace Bounty
section Action
variable {I K J G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] {M : G → ℕ}
  (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
  (Δ D : ∀ k c, A k c → G → ℤ) (f : I → K)
  (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)

theorem full_permutation_key_path_action (steps : List (Option (J ⊕ I)))
    (phase : ∀ x, FullPermutationMixedPath n (fun i => S (f i)) B (fun i => A (f i))
      (fun i => Δ (f i)) (fun i => D (f i)) steps x → ℂ)
    (F : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ) :
    fullPermutationMixedPathAction n (fun i => S (f i)) B (fun i => A (f i))
      (fun i => Δ (f i)) (fun i => D (f i)) (fun i => ω (f i)) μ q ρ V steps phase F =
    fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V
      (steps.map (Option.map (Sum.map id f)))
      (fun x p => phase x ((fullPermutationKeyPathEquiv n S B A Δ D f steps x).symm p)) F := by
  let _ : ∀ (tag : Option (J ⊕ I)) x, Fintype
      (FullPermutationMixedEvent n (fun i => S (f i)) B (fun i => A (f i))
        (fun i => Δ (f i)) (fun i => D (f i)) tag x) :=
    fullPermutationMixedEventFintype n (fun i => S (f i)) B (fun i => A (f i))
      (fun i => Δ (f i)) (fun i => D (f i))
  let _ : ∀ (tag : Option (J ⊕ K)) x, Fintype (FullPermutationMixedEvent n S B A Δ D tag x) :=
    fullPermutationMixedEventFintype n S B A Δ D
  funext x
  let _ := finiteEventPathFintype
    (FullPermutationMixedEvent n (fun i => S (f i)) B (fun i => A (f i))
      (fun i => Δ (f i)) (fun i => D (f i)))
    (fullPermutationMixedEventTarget n (fun i => S (f i)) B (fun i => A (f i))
      (fun i => Δ (f i)) (fun i => D (f i))) steps x
  let _ := finiteEventPathFintype (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) (steps.map (Option.map (Sum.map id f))) x
  unfold fullPermutationMixedPathAction finiteEventPathAction
  rw [← (fullPermutationKeyPathEquiv n S B A Δ D f steps x).sum_comp]
  apply sum_congr rfl
  intro p _
  rw [full_permutation_key_path_weight, full_permutation_key_path_terminal]
  simp only [Equiv.symm_apply_apply]

end Action
end Bounty
