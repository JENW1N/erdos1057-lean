noncomputable def physicalRootEffectivePhase
    (x : PhysicalFullBoundedState (fun g => P (e.symm g).val) J ell B)
    (path : PhysicalEffectivePlannedBigPath (fun (i : patterns) g => C i.val (e.symm g).val) (fun (j : Fin (n + 1)) (i : patterns) => k (n - j.val) i.val) B ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1))) pl.1 pl.2 x) : ℂ :=
  let Cb := fun key : PhysicalMixedBigKey (Ps := fun s : ↥groupsᶜ => P s.val) (J := J) (ell := ell) (I := patterns) (K := Fin (n + 1)) => fun g => C key.2.1.val (e.symm g).val
  let kb := fun key : PhysicalMixedBigKey (Ps := fun s : ↥groupsᶜ => P s.val) (J := J) (ell := ell) (I := patterns) (K := Fin (n + 1)) =>
    k (n - key.1.val) key.2.1.val * (physicalSharedProduct (physicalSharedPrefix key.2.2.1) : ℕ)
  let steps := physicalMixedBigSteps ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1))) pl.1 pl.2
  physicalFullHistoryPhase Cb kb (fun (key : PhysicalMixedBigKey (Ps := fun s : ↥groupsᶜ => P s.val) (J := J) (ell := ell) (I := patterns) (K := Fin (n + 1))) _ aux => physicalAuxMass (fun g => V (e.symm g).val) (fun g => C key.2.1.val (e.symm g).val) aux) β ρ (fun g => V (e.symm g).val) steps x path *
  physicalEffectivePlanSmallFactor (fun (i : patterns) g => C i.val (e.symm g).val) (fun (j : Fin (n + 1)) (i : patterns) => k (n - j.val) i.val) B
    (fun s : ↥groupsᶜ => V s.val) (fun _ => q) ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1)))
    (physicalGroupResidueVector r) pl.1 pl.2 x path *
  physicalEffectivePlanCoefficientPhase (fun (i : patterns) g => C i.val (e.symm g).val) (fun (j : Fin (n + 1)) (i : patterns) => k (n - j.val) i.val) B
    (fun _ => 0) (physicalRootKeyCoefficient groups e patterns C hC ζ k K θ)
    ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1))) pl.1 pl.2 x path

theorem physical_root_effective_path_action
    (f : PhysicalFullBoundedState (fun g => P (e.symm g).val) J ell B → ℂ)
    (x : PhysicalFullBoundedState (fun g => P (e.symm g).val) J ell B) :
  let _ : ∀ g (z : P (e.symm g).val), NeZero z.val :=
    fun g z => inferInstanceAs (NeZero (⟨(e.symm g).val, z⟩ : PhysicalPrime P).2.val)
  let Cb := fun key : PhysicalMixedBigKey (Ps := fun s : ↥groupsᶜ => P s.val) (J := J) (ell := ell) (I := patterns) (K := Fin (n + 1)) => fun g => C key.2.1.val (e.symm g).val
  let kb := fun key : PhysicalMixedBigKey (Ps := fun s : ↥groupsᶜ => P s.val) (J := J) (ell := ell) (I := patterns) (K := Fin (n + 1)) =>
    k (n - key.1.val) key.2.1.val * (physicalSharedProduct (physicalSharedPrefix key.2.2.1) : ℕ)
  let steps := physicalMixedBigSteps ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1))) pl.1 pl.2
  physicalRootEffectivePathSum groups e patterns C hC k pl V q ζ K r θ β retention ρ f x =
  fullPermutationMixedPathAction (fun g (p : P (e.symm g).val) => p.val)
      (fun key g => physicalFullSharedIndices (ell := ell) (Cb key g)) B
      (fun key _ => PhysicalAuxLabels (fun g => P (e.symm g).val) (Cb key))
      (fun key => physicalFullEdgeDelta (Cb key) (kb key)) (fun key => physicalFullEdgeD (Cb key))
    (fun (key : PhysicalMixedBigKey (Ps := fun s : ↥groupsᶜ => P s.val) (J := J) (ell := ell) (I := patterns) (K := Fin (n + 1))) _ aux => physicalAuxMass (fun g => V (e.symm g).val) (fun g => C key.2.1.val (e.symm g).val) aux) (fun g p => β g p / V (e.symm g).val) retention ρ (fun g => V (e.symm g).val) steps
    (physicalRootEffectivePhase groups e patterns C hC k pl V q ζ K r θ β ρ) f x := by
  let _ : ∀ g (z : P (e.symm g).val), NeZero z.val :=
    fun g z => inferInstanceAs (NeZero (⟨(e.symm g).val, z⟩ : PhysicalPrime P).2.val)
  unfold physicalRootEffectivePathSum fullPermutationMixedPathAction finiteEventPathAction
  dsimp only
  apply Finset.sum_congr
  · exact congrArg (fun inst : Fintype _ => @Finset.univ _ inst) (Subsingleton.elim _ _)
  · intro path _
    unfold physicalRootEffectiveIntegrand physicalRootEffectivePhase physicalEffectivePlanSignedWeight
      physicalFullSignedWeight physicalEffectivePlanTerminal physicalFullPathTerminal
    dsimp only
    ring

end Action
end Bounty
