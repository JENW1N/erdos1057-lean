    (hU : 0 < U) (hZ : 0 < Z) (hR : 0 ≤ R)
    (hM : ∀ m ∈ M, 0 < m) (hk : k ≠ 0)
    (hpos : ∀ z ∈ Zs, 0 < z ∧ 0 < (z:ℤ)+k)
    (hcorrelation : ∀ ξ ∈ T,
      ‖∑ z ∈ Zs, ((typeIIHarmonicDyadic ((z:ℝ)/Z)/(z:ℝ) : ℝ):ℂ) *
        typeIICrossPairCoefficient M H (fun m => α m * χ (m : ZMod (2*k.natAbs))) W B ρ
          (2*Real.pi*ξ 0) (2*Real.pi*ξ 1) (2*Real.pi*ξ 2) z ((z:ℤ)+k).toNat‖ ≤ R) :
    ‖∫ ξ in T, typeIICrossCharacterFourierIntegrand A L U V E Z k M H Zs
        typeIISmoothDyadic α (typeIISeparatedH W B ρ) χ ξ‖ ≤
      Z * R * (∫ ξ : EuclideanSpace ℝ (Fin 3),
        ‖typeIIPulledFourier A (L^88) (U/(2*(k:ℝ)*E))
          (Z/((k:ℝ)*U*V)) (1/(U*V)) ξ‖) := by
  have hf := (typeII_pulled_fourier_integrable A (L^88) (U/(2*(k:ℝ)*E))
    (Z/((k:ℝ)*U*V)) (1/(U*V))).norm
  have hdom : ∀ᵐ ξ ∂volume.restrict T,
      ‖typeIICrossCharacterFourierIntegrand A L U V E Z k M H Zs
        typeIISmoothDyadic α (typeIISeparatedH W B ρ) χ ξ‖ ≤
      ‖typeIIPulledFourier A (L^88) (U/(2*(k:ℝ)*E))
        (Z/((k:ℝ)*U*V)) (1/(U*V)) ξ‖ * (Z*R) := by
    filter_upwards [ae_restrict_mem hT] with ξ hξ
    rw [typeII_character_cross_fourier_eq_harmonic_cross_pairs A L U V E Z k M H Zs
      α W B ρ χ hM hk hZ hpos ξ, norm_mul, norm_mul,
      typeII_cross_fourier_scale_norm A L U V E Z k hU hZ ξ,
      Complex.norm_real, Real.norm_eq_abs, abs_of_pos hZ]
    exact (mul_le_mul_of_nonneg_left (hcorrelation ξ hξ)
      (mul_nonneg (norm_nonneg _) hZ.le)).trans_eq (mul_assoc _ _ _)
  calc
    _ ≤ ∫ ξ in T, ‖typeIIPulledFourier A (L^88) (U/(2*(k:ℝ)*E))
        (Z/((k:ℝ)*U*V)) (1/(U*V)) ξ‖ * (Z*R) :=
      norm_integral_le_of_norm_le (hf.mul_const (Z*R)).integrableOn hdom
    _ = (∫ ξ in T, ‖typeIIPulledFourier A (L^88) (U/(2*(k:ℝ)*E))
        (Z/((k:ℝ)*U*V)) (1/(U*V)) ξ‖) * (Z*R) := integral_mul_const _ _
    _ ≤ (∫ ξ : EuclideanSpace ℝ (Fin 3),
        ‖typeIIPulledFourier A (L^88) (U/(2*(k:ℝ)*E))
          (Z/((k:ℝ)*U*V)) (1/(U*V)) ξ‖) * (Z*R) :=
      mul_le_mul_of_nonneg_right (setIntegral_le_integral hf
        (Filter.Eventually.of_forall (fun _ => norm_nonneg _))) (mul_nonneg hZ.le hR)
    _ = _ := mul_comm _ _

theorem typeII_cross_integral_le_of_active_harmonic_bound
    (A L U V E Z : ℝ) (k : ℤ) (M H Zs : Finset ℕ)
    (α : ℕ → ℂ) (W : ℕ → ℝ) (B : ℕ → ℂ) (ρ : ℝ)
    (χ : DirichletCharacter ℂ (2*k.natAbs))
    (T : Set (EuclideanSpace ℝ (Fin 3))) (hT : MeasurableSet T) {R : ℝ}
    (hU : 0 < U) (hZ : 0 < Z) (hR : 0 ≤ R)
    (hM : ∀ m ∈ M, 0 < m) (hH : ∀ h ∈ H, 0 < h) (hk : k ≠ 0)
    (hcorrelation : ∀ ξ ∈ T,
      ‖∑ z ∈ typeIIActiveCrossZ Z k Zs,
        ((typeIIHarmonicDyadic ((z:ℝ)/Z)/(z:ℝ) : ℝ):ℂ) *
        typeIICrossPairCoefficient M H (fun m => α m * χ (m : ZMod (2*k.natAbs))) W B ρ
          (2*Real.pi*ξ 0) (2*Real.pi*ξ 1) (2*Real.pi*ξ 2) z ((z:ℤ)+k).toNat‖ ≤ R) :
    ‖∫ ξ in T, typeIICrossCharacterFourierIntegrand A L U V E Z k M H Zs
        typeIISmoothDyadic α (typeIISeparatedH W B ρ) χ ξ‖ ≤
      Z * R * (∫ ξ : EuclideanSpace ℝ (Fin 3),
        ‖typeIIPulledFourier A (L^88) (U/(2*(k:ℝ)*E))
          (Z/((k:ℝ)*U*V)) (1/(U*V)) ξ‖) := by
  classical
  rw [integral_congr_ae (Eventually.of_forall
    (typeII_smooth_cross_fourier_active_support A L U V E Z k M H Zs α
      (typeIISeparatedH W B ρ) χ hZ hH))]
  exact typeII_cross_integral_le_of_harmonic_bound A L U V E Z k M H _ α W B ρ χ T hT
    hU hZ hR hM hk (fun z hz => ⟨(mem_filter.mp hz).2.1, (mem_filter.mp hz).2.2.1⟩) hcorrelation

theorem eventually_typeII_harmonic_cross_integral_bound {K₀ : ℝ} :
    ∃ C : ℝ, 0 < C ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (U V E Z : ℝ) (k : ℤ), 0 < U → 0 < V → 0 < Z → k ≠ 0 →
      E = U*L^(-K₀) → 1 ≤ U*V → Z ≤ 24*U^2*V*L^88/E →
      ∀ (M H Zs : Finset ℕ) (α : ℕ → ℂ) (W : ℕ → ℝ) (B : ℕ → ℂ) (ρ : ℝ)
        (χ : DirichletCharacter ℂ (2*k.natAbs))
        (T : Set (EuclideanSpace ℝ (Fin 3))) (R : ℝ),
      MeasurableSet T → 0 ≤ R → (∀ m ∈ M, 0 < m) → (∀ h ∈ H, 0 < h) →
      (∀ ξ ∈ T, ‖∑ z ∈ typeIIActiveCrossZ Z k Zs,
        ((typeIIHarmonicDyadic ((z:ℝ)/Z)/(z:ℝ) : ℝ):ℂ) *
        typeIICrossPairCoefficient M H (fun m => α m * χ (m : ZMod (2*k.natAbs))) W B ρ
          (2*Real.pi*ξ 0) (2*Real.pi*ξ 1) (2*Real.pi*ξ 2) z ((z:ℤ)+k).toNat‖ ≤ R) →
      ‖∫ ξ in T, typeIICrossCharacterFourierIntegrand 1 L U V E Z k M H Zs
        typeIISmoothDyadic α (typeIISeparatedH W B ρ) χ ξ‖ ≤ Z * R * L^C := by
  obtain ⟨C, hC, hcost⟩ := typeII_scale_fourier_polynomial_l1
    (A := 1) (K₀ := K₀) (Cz := K₀+89) (by norm_num)
  refine ⟨C, hC, ?_⟩
  filter_upwards [hcost, eventually_ge_atTop (24:ℝ)] with L hcost hL
  intro U V E Z k hU hV hZ hk hE hUV hZupper M H Zs α W B ρ χ T R hT hR hM hH hcorr
  apply (typeII_cross_integral_le_of_active_harmonic_bound 1 L U V E Z k M H Zs
    α W B ρ χ T hT hU hZ hR hM hH hk hcorr).trans
  exact mul_le_mul_of_nonneg_left
    (hcost U V E Z k hU hV hZ.le hk hE hUV (typeII_localized_scale_ratio hL hU hV hE hZupper))
    (mul_nonneg hZ.le hR)

end Bounty
