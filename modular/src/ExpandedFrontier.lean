/- Key relabeling preserves the full signed weight, including its history phase. -/

open scoped Classical
namespace Bounty
section Key
variable {I H V : Type} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : I → Fin N → Finset (Fin J)) (k : I → ℤ)
  (f : H → I)

variable
  (ω : ∀ i, SharedActiveLabels (fun g => P g)
    (fun g => physicalFullSharedIndices (ell := ell) (C i g)) → PhysicalAuxLabels P (C i) → ℝ)
  (β : (g : Fin N) → P g → ℝ) (ρ : ℝ) (W : Fin N → ℝ)

  (retention : V → ℝ)

theorem physical_full_key_signed_weight
    (steps : List (Option (V ⊕ H))) (x : PhysicalFullBoundedState P J ell B)
    (p : FullPermutationMixedPath (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C (f i) g)) B
      (fun i _ => PhysicalAuxLabels P (C (f i)))
      (fun i => physicalFullEdgeDelta (C (f i)) (k (f i))) (fun i => physicalFullEdgeD (C (f i))) steps x) :
    physicalFullSignedWeight C k ω β retention ρ W (steps.map (Option.map (Sum.map id f))) x
      (physicalFullKeyPathEquiv C k f steps x p) =
    physicalFullSignedWeight (fun i => C (f i)) (fun i => k (f i))
      (fun i => ω (f i)) β retention ρ W steps x p := by
  have hw := full_permutation_key_path_weight (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i _ => PhysicalAuxLabels P (C i))
      (fun i => physicalFullEdgeDelta (C i) (k i)) (fun i => physicalFullEdgeD (C i)) f
    ω (fun g p => β g p / W g) retention ρ W steps x p
  have hh := physical_full_key_history_path C k f ω β ρ W steps x p
  exact congrArg₂ (fun (w : ℝ) (h : ℂ) => (w : ℂ) * h) hw hh

end Key
end Bounty
