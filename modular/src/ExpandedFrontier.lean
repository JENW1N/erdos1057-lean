      ∑ p ∈ s, (1/(((∑ p ∈ candidatePBand (c*L) g, 1/(p : ℝ)) : ℝ) : ℂ))*
        (rationalProductCharacter qRat dRat χP ψ (p : ZMod (qP*(qRat/dRat)))*
