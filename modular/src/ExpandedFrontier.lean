section
open Finset
noncomputable def physicalTimeStepBound {G I : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (J ell : ℕ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (k : ℕ → I → ℤ) (n : ℕ) : ℕ :=
  (range n).sup (fun j => physicalOperatorStepBound P J ell patterns C (k j))

/-- The maximum over the used time indices bounds each individual step. -/
theorem physical_operator_step_bound_le_time {G I : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (J ell : ℕ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (k : ℕ → I → ℤ) {n j : ℕ} (hj : j < n) :
    physicalOperatorStepBound P J ell patterns C (k j) ≤
      physicalTimeStepBound P J ell patterns C k n := by
  exact le_sup (f := fun j => physicalOperatorStepBound P J ell patterns C (k j))
    (mem_range.mpr hj)

/-- The canonical bound is the least common natural bound for the used times. -/
theorem physical_time_step_bound_le_iff {G I : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (J ell : ℕ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (k : ℕ → I → ℤ) (n b : ℕ) :
    physicalTimeStepBound P J ell patterns C k n ≤ b ↔
      ∀ j < n, physicalOperatorStepBound P J ell patterns C (k j) ≤ b := by
  simp only [physicalTimeStepBound, Finset.sup_le_iff, mem_range]

/-- All cutoffs that contain every reachable state give the same root moment. -/
theorem physical_root_moment_cutoff_independent {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (starts : Finset ℤ) (r b₁ b₂ : ℕ)
    (hb₁ : ∀ j < r + 1, physicalOperatorStepBound P J ell patterns C (k j) ≤ b₁)
    (hb₂ : ∀ j < r + 1, physicalOperatorStepBound P J ell patterns C (k j) ≤ b₂) :
    physicalRootMoment V patterns C q ζ k K starts r b₁ =
      physicalRootMoment V patterns C q ζ k K starts r b₂ := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  rw [physical_root_moment_as_vertex_averages V patterns C hq ζ k K starts r b₁ hb₁,
    physical_root_moment_as_vertex_averages V patterns C hq ζ k K starts r b₂ hb₂]

/-- The physical root moment with its reachable cutoff chosen canonically. -/
noncomputable def physicalCanonicalRootMoment {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (starts : Finset ℤ) (r : ℕ) : ℂ :=
  physicalRootMoment V patterns C q ζ k K starts r
    (physicalTimeStepBound P J ell patterns C k (r + 1))

/-- Any admissible cutoff computes the canonical physical root moment. -/
theorem physical_root_moment_eq_canonical {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (starts : Finset ℤ) (r b : ℕ)
    (hbound : ∀ j < r + 1, physicalOperatorStepBound P J ell patterns C (k j) ≤ b) :
    physicalRootMoment V patterns C q ζ k K starts r b =
      physicalCanonicalRootMoment V patterns C q ζ k K starts r := by
  exact physical_root_moment_cutoff_independent V patterns C hq ζ k K starts r b _ hbound
    (fun _ hj => physical_operator_step_bound_le_time P J ell patterns C k hj)
end

section
open Filter Finset
theorem eventually_physical_canonical_root_replacement
    {a c d C V v E γ B q : ℝ}
    (ha : 0 ≤ a) (hc : 0 < c) (hd : 0 < d) (had : a + d < 1)
    (hC : 0 < C) (hV : 0 < V) (hv : 0 < v) (hE : 0 ≤ E)
    (hγ : 0 < γ) (hB : 0 ≤ B) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (J ell m : ℕ) :
    ∀ᶠ T : ℝ in atTop, ∀ (G : Type) [Fintype G] [DecidableEq G]
