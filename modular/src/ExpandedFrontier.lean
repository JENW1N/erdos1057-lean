/- The original finite P cutoff may be enlarged exponentially on its unchanged spatial test. -/

open Finset Filter MeasureTheory

namespace Bounty

theorem eventually_fixed_exp_add_one_le_exp {C : ℝ} (R : ℝ) (hC : 1 < C) :
    ∀ᶠ L : ℝ in atTop, R*Real.exp L+1 ≤ Real.exp (C*L) := by
  filter_upwards [eventually_const_mul_exp_le_exp hC (R+1),eventually_ge_atTop (0 : ℝ)] with L hL hL0
  simp only [one_mul] at hL
  have he : 1 ≤ Real.exp L := Real.one_le_exp hL0
  linarith

theorem eventually_coarse_retained_Psupport_enlarge {c C : ℝ} (Rcoarse : ℝ) (hc : 0 < c) (hC : 1 < C) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ) (R E : ℝ)
      (S : Finset ℕ) (G : ℕ → ℂ), (∀ u ∈ S, (u : ℝ) ≤ Rcoarse*Real.exp L) →
      ∀ (take : Fin ((candidateQIndices c L).card*r) → Bool)
        (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ),
      candidateRetainedAllocationIntegrand c L q r jStar R
        (candidateSmallPSet c L (Rcoarse*Real.exp L+1)) take (candidateBoxFiniteTest L E S G) ξ =
      candidateRetainedAllocationIntegrand c L q r jStar R
        (candidateSmallPSet c L (Real.exp (C*L))) take (candidateBoxFiniteTest L E S G) ξ := by
  filter_upwards [eventually_candidate_retained_finite_test_enlarge hc,
    eventually_fixed_exp_add_one_le_exp Rcoarse hC] with L henlarge hcut
  intro q r jStar R E S G hS take ξ
  have hh := henlarge q r jStar R E (Rcoarse*Real.exp L) (Real.exp (C*L)-1) S G
    (by linarith) hS take ξ
  simpa only [sub_add_cancel] using hh

theorem eventually_coarse_retained_Psupport_integral_enlarge {c C : ℝ} (Rcoarse : ℝ)
    (hc : 0 < c) (hC : 1 < C) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ) (R E T : ℝ)
      (S : Finset ℕ) (G : ℕ → ℂ), (∀ u ∈ S, (u : ℝ) ≤ Rcoarse*Real.exp L) →
      ∀ take : Fin ((candidateQIndices c L).card*r) → Bool,
      (∫ ξ, candidateRetainedAllocationIntegrand c L q r jStar R
        (candidateSmallPSet c L (Rcoarse*Real.exp L+1)) take (candidateBoxFiniteTest L E S G) ξ
        ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) T) =
      ∫ ξ, candidateRetainedAllocationIntegrand c L q r jStar R
        (candidateSmallPSet c L (Real.exp (C*L))) take (candidateBoxFiniteTest L E S G) ξ
        ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) T := by
  filter_upwards [eventually_coarse_retained_Psupport_enlarge Rcoarse hc hC] with L heq
  intro q r jStar R E T S G hS take
  exact integral_congr_ae (Filter.Eventually.of_forall (heq q r jStar R E S G hS take))

end Bounty
end

section

/- The integer ceiling creates only a fixed ratio and logarithmic loss. -/

namespace Bounty

theorem harmonic_ceiling_scale_bounds {x : ℝ} (hx : 1 ≤ x) :
    (⌈3*x⌉₊ : ℝ) ≤ 4*x ∧ (⌈3*x⌉₊ : ℝ)/(x/2) ≤ 8 ∧
      Real.log (⌈3*x⌉₊ : ℝ) ≤ Real.log 4 + Real.log x := by
  have hx0 : 0 < x := zero_lt_one.trans_le hx
  have hc := Nat.ceil_lt_add_one (by positivity : 0 ≤ 3*x)
  have hu : (⌈3*x⌉₊ : ℝ) ≤ 4*x := by linarith
  have hN0 : 0 < (⌈3*x⌉₊ : ℝ) := lt_of_lt_of_le (by positivity) (Nat.le_ceil (3*x))
  refine ⟨hu, (div_le_iff₀ (half_pos hx0)).mpr (by linarith), ?_⟩
  calc
    _ ≤ Real.log (4*x) := Real.log_le_log hN0 hu
    _ = _ := Real.log_mul (by norm_num) hx0.ne'

theorem harmonic_ceiling_log_from_scales {Z D U V : ℝ}
    (hZ : 0 < Z) (hD : 0 < D) (hprod : 1 ≤ Z*D)
    (hZU : Z ≤ Real.exp U) (hDV : D ≤ Real.exp V) :
    Real.log (⌈3*(Z*D)⌉₊ : ℝ) ≤ Real.log 4 + U + V := by
  have hz : Real.log Z ≤ U := (Real.log_le_iff_le_exp hZ).mpr hZU
  have hd : Real.log D ≤ V := (Real.log_le_iff_le_exp hD).mpr hDV
  have hh := (harmonic_ceiling_scale_bounds hprod).2.2
  rw [Real.log_mul hZ.ne' hD.ne'] at hh
  linarith

end Bounty
end

