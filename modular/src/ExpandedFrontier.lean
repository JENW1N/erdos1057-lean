theorem finite_flatten_probe_tail_energy {G : Type*} [Fintype G] [DecidableEq G]
    {I X : G → Type*} [∀ g, Fintype (I g)] [∀ g, DecidableEq (I g)] [∀ g, Fintype (X g)]
    (μ : ∀ g, X g → ℝ) (hμ : ∀ g x, 0 ≤ μ g x) (hmass : ∀ g, ∑ x, μ g x = 1)
    (A B : ∀ g, Finset (I g)) (hAB : ∀ g, Disjoint (A g) (B g))
    (m ell : ℕ) (hm : 0 < m) (hA : ∀ g, (A g).card = m) (hB : ∀ g, (B g).card = ell)
    (s : Finset G) (f : (∀ g, I g → X g) → ℂ) (hf : ∀ g, finiteGroupSlotSymmetric g f) :
    finiteWeightedEnergy (finiteProductWeight (fun a : Sigma I => μ a.1))
      (finiteCoordinateComponent (fun a : Sigma I => μ a.1) (s.sigma A) (s.sigma A).toList
        (finiteCoordinateComponent (fun a : Sigma I => μ a.1) ∅ (univ.sigma B).toList
          (finiteGroupFlattenFunction f))) ≤
      (((ell : ℝ) ^ ell / (m : ℝ) ^ ell) ^ s.card) *
        finiteWeightedEnergy (finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g))) f := by
  have heq (v : (∀ g, I g → X g) → ℂ) :
      finiteWeightedEnergy (finiteProductWeight (fun a : Sigma I => μ a.1))
        (finiteGroupFlattenFunction v) =
      finiteWeightedEnergy (finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g))) v := by
    convert finite_group_flatten_energy μ v using 1 <;> congr 1 <;> exact Subsingleton.elim _ _
  rw [← finite_group_flatten_probe_tail μ A B hAB s f, heq]
  exact finite_symmetric_probe_tensor_tail_energy μ hμ hmass A B hAB m ell hm hA hB s sᶜ f hf

theorem finite_flatten_probe_tail_norm {G : Type*} [Fintype G] [DecidableEq G]
    {I X : G → Type*} [∀ g, Fintype (I g)] [∀ g, DecidableEq (I g)] [∀ g, Fintype (X g)]
    (μ : ∀ g, X g → ℝ) (hμ : ∀ g x, 0 ≤ μ g x) (hmass : ∀ g, ∑ x, μ g x = 1)
    (A B : ∀ g, Finset (I g)) (hAB : ∀ g, Disjoint (A g) (B g))
    (m ell : ℕ) (hm : 0 < m) (hA : ∀ g, (A g).card = m) (hB : ∀ g, (B g).card = ell)
    (s : Finset G) (f : (∀ g, I g → X g) → ℂ) (hf : ∀ g, finiteGroupSlotSymmetric g f) :
    Real.sqrt (finiteWeightedEnergy (finiteProductWeight (fun a : Sigma I => μ a.1))
      (finiteCoordinateComponent (fun a : Sigma I => μ a.1) (s.sigma A) (s.sigma A).toList
        (finiteCoordinateComponent (fun a : Sigma I => μ a.1) ∅ (univ.sigma B).toList
          (finiteGroupFlattenFunction f)))) ≤
      Real.sqrt (((ell : ℝ) ^ ell / (m : ℝ) ^ ell) ^ s.card) *
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g))) f) := by
  have h := Real.sqrt_le_sqrt
    (finite_flatten_probe_tail_energy μ hμ hmass A B hAB m ell hm hA hB s f hf)
  rw [Real.sqrt_mul (by positivity)] at h
  exact h
end

