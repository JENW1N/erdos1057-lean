theorem repeated_big_kernel_lifespan_density_error {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (hbpos : ∀ g p, 0 < b g p) (C : G → Finset (Fin J)) (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (source target : RepeatedBigLists P J ell)
    {T Pmin : ℝ} (hT : 0 ≤ T) (hPmin : 0 < Pmin)
    (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (hb : ∀ g (p : P g), b g p = 1 - T / (p.val : ℝ))
    (hsmall : ((2 * ∑ g, (ell + (C g).card) : ℕ) : ℝ) * T / Pmin ≤ 1 / 2) :
    ‖((Real.sqrt (cleanActiveDensity b source) / Real.sqrt (cleanActiveDensity b target) : ℝ) : ℂ) *
        repeatedBigKernel V b C ζ K aux source target -
          repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target‖ ≤
      (((2 * ∑ g, (ell + (C g).card) : ℕ) : ℝ) * T / Pmin) *
        ‖repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target‖ := by
  rw [repeated_big_kernel_density_conjugation V b hbpos]
  exact clean_unshared_endpoint_lifespan_coefficient_error b C source target hT hPmin hp hb hsmall _

theorem clean_hybrid_between_lifespan_density_error {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (hbpos : ∀ g p, 0 < b g p)
    (C : G → Finset (Fin J)) (ζ θ ρ : ℝ) (k : ℤ) (B : G → ℕ)
    (p : FixedOrderedMemoryLabels Pb N) (r : FixedOrderedResidues p)
    (K : RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb C → ℂ)
    (d : PhysicalSharedLists Ps J) (aux : PhysicalAuxLabels Pb C)
    (source target : RepeatedBigLists Pb J ell)
    {T Pmin : ℝ} (hT : 0 ≤ T) (hPmin : 0 < Pmin)
    (hp : ∀ g (p : Pb g), Pmin ≤ (p.val : ℝ))
    (hb : ∀ g (p : Pb g), b g p = 1 - T / (p.val : ℝ))
    (hsmall : ((2 * ∑ g, (ell + (C g).card) : ℕ) : ℝ) * T / Pmin ≤ 1 / 2) :
    ‖((Real.sqrt (cleanActiveDensity b source) / Real.sqrt (cleanActiveDensity b target) : ℝ) : ℂ) *
        cleanHybridBetweenKernel Vb b C ζ θ ρ k B p r K d aux source target -
          cleanHybridBetweenKernel Vb (fun _ _ => 1) C ζ θ ρ k B p r K d aux source target‖ ≤
      (((2 * ∑ g, (ell + (C g).card) : ℕ) : ℝ) * T / Pmin) *
        ‖cleanHybridBetweenKernel Vb (fun _ _ => 1) C ζ θ ρ k B p r K d aux source target‖ := by
  rw [clean_hybrid_between_density_conjugation Vb b hbpos]
  exact clean_unshared_endpoint_lifespan_coefficient_error b C source target hT hPmin hp hb hsmall _
end

