/- Exact source conjugation and phase separation for the harmonic Mellin cutoff. -/

namespace Bounty

theorem physical_mellin_phased_source_conj (X Z v a : ℝ) (F : ℤ → ℂ) (n : ℤ) :
    star (physicalMellinSource X Z v (fun m => physicalPhase (-a) m.natAbs * F m) n) =
      (X : ℂ) * (n : ℂ)⁻¹ * physicalMellinPhase v ((n : ℝ) / Z) *
        (physicalPhase a n.natAbs * star (F n)) := by
  simp only [physicalMellinSource, star_mul, Complex.star_def,
    Complex.conj_ofReal, physical_mellin_phase_conj, physical_phase_star, neg_neg]
  push_cast
  ring

theorem physical_mellin_phased_source_norm (X Z v a : ℝ) (F : ℤ → ℂ) (n : ℤ) :
    ‖physicalMellinSource X Z v (fun m => physicalPhase (-a) m.natAbs * F m) n‖ =
      |X / (n : ℝ)| * ‖F n‖ := by
  simp only [physicalMellinSource, norm_mul, physical_mellin_phase_norm,
    physical_phase_norm, mul_one, one_mul, Complex.norm_real, Real.norm_eq_abs]

theorem physical_mellin_phased_source_norm_le {X : ℝ} (hX : 0 < X)
    (Z v a : ℝ) (F : ℤ → ℂ) (n : ℤ) (hn : X ≤ (n : ℝ)) :
    ‖physicalMellinSource X Z v (fun m => physicalPhase (-a) m.natAbs * F m) n‖ ≤
      ‖F n‖ := by
  rw [physical_mellin_phased_source_norm]
  have hnpos : (0 : ℝ) < n := hX.trans_le hn
  rw [abs_of_nonneg (div_nonneg hX.le hnpos.le)]
  exact mul_le_of_le_one_left (norm_nonneg _) ((div_le_one hnpos).mpr hn)

theorem physical_mellin_phased_edge_normalized (X Z a b v : ℝ)
    (d : ℕ) (n z : ℤ) (F G : ℤ → ℂ)
    (hX : X ≠ 0) (hZ : Z ≠ 0) (hd : d ≠ 0) (hn : n ≠ 0) :
    (X : ℂ)⁻¹ * physicalPhase (-(a+b+v)) d *
        star (physicalMellinSource X Z v (fun m => physicalPhase (-a) m.natAbs * F m) n) *
        (physicalPhase b z.natAbs * G z) =
      physicalPhase (-(a+b)) d * physicalMellinPhase v ((n : ℝ) / (Z * d)) *
        ((n : ℂ)⁻¹ * physicalPhase a n.natAbs * physicalPhase b z.natAbs * star (F n) * G z) := by
  have hXc : (X : ℂ) ≠ 0 := by exact_mod_cast hX
  have hnr : (n : ℝ) ≠ 0 := by exact_mod_cast hn
  rw [physical_mellin_phased_source_conj]
  rw [show -(a+b+v) = -(a+b) + (-v) by ring, physical_phase_add]
  calc
    _ = ((X : ℂ)⁻¹ * (X : ℂ)) * physicalPhase (-(a+b)) d *
        (physicalMellinPhase v ((n : ℝ) / Z) * physicalPhase (-v) d) *
        ((n : ℂ)⁻¹ * physicalPhase a n.natAbs * physicalPhase b z.natAbs * star (F n) * G z) := by
      ring
    _ = _ := by
      rw [inv_mul_cancel₀ hXc, one_mul, physical_mellin_phase_ratio v (n : ℝ) Z d hnr hZ hd]

end Bounty
end

