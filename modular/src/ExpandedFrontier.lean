section

/- Actual shifted pairs satisfy the corrected odd-prime sieve conditions. -/

open Finset

namespace Bounty

theorem odd_prime_shifted_divisibility {p u n : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (hn : n = 2*u+1) : p ∣ n-1 ↔ p ∣ u := by
  rw [hn, Nat.add_sub_cancel, hp.dvd_mul]
  have hnot : ¬p ∣ 2 := by
    intro h
    exact hp2 (((Nat.dvd_prime Nat.prime_two).mp h).resolve_left hp.ne_one)
  simp only [hnot, false_or]

theorem shifted_unmarked_divisor_set (P : Finset ℕ)
    (hprime : ∀ p ∈ P, p.Prime) (hP2 : 2 ∉ P) (D u : ℕ) (v : ℕ × ℕ)
    (hv : v.1*v.2 = 2*u+1) :
    (P \ D.primeFactors).filter (fun p => p ∣ u) =
      (P \ D.primeFactors).filter (fun p => p ∣ v.1*v.2-1) := by
  apply filter_congr
  intro p hp
  have hpP := (mem_sdiff.mp hp).1
  exact (odd_prime_shifted_divisibility (hprime p hpP) (fun he => hP2 (he ▸ hpP)) hv).symm

theorem prime_assignment_odd_pair_mem (P : Finset ℕ) {W z : ℝ} (hz : 0 ≤ z)
    (a b c d D u : ℕ) (v : ℕ × ℕ) (hv : v.1*v.2 = 2*u+1)
    (hrect : v.1 ∈ Ioc a b ∧ v.2 ∈ Ioc c d)
    (hrough : ∀ p ∈ primeBand 0 W, ¬p ∣ v.1*v.2)
    (hcond : primeAssignmentCondition P z u D) :
    v ∈ oddMaskedPairBox a b c d D W z (P \ D.primeFactors) := by
  classical
  apply mem_filter.mpr
  refine ⟨?_, hrough, ?_⟩
  · apply mem_filter.mpr
    refine ⟨?_, ?_⟩
    · simpa only [Finset.product_eq_sprod, mem_product] using hrect
    · rw [hv, Nat.add_mod, Nat.mul_mod, Nat.mod_eq_zero_of_dvd hcond.1,
        mul_zero, Nat.zero_mod, zero_add, Nat.mod_mod]
  · intro p hp hp2 hpD hpA heq
    obtain ⟨hprime, _, hpz⟩ := (mem_primeBand_iff le_rfl hz p).mp hp
    have hpP : p ∉ P := by
      intro hpP
      exact hpA (mem_sdiff.mpr ⟨hpP, fun hpf => hpD (Nat.dvd_of_mem_primeFactors hpf)⟩)
    have hn : 1 ≤ v.1*v.2 := by omega
    have hdiv : p ∣ v.1*v.2-1 := (Nat.modEq_iff_dvd' hn).mp heq.symm
    exact hpD (hcond.2 p hprime hpz hpP ((odd_prime_shifted_divisibility hprime hp2 hv).mp hdiv))

noncomputable def oddPairAssignmentPower (a b c d D : ℕ) (W z : ℝ)
    (P : Finset ℕ) (q : ℝ) (v : ℕ × ℕ) : ℝ := by
  classical
  exact if v ∈ oddMaskedPairBox a b c d D W z (P \ D.primeFactors) then
    q^(((P \ D.primeFactors).filter (fun p => p ∣ v.1*v.2-1)).card) else 0

theorem prime_assignment_term_le_odd_pair (P : Finset ℕ)
    (hprime : ∀ p ∈ P, p.Prime) (hP2 : 2 ∉ P) {q N W z : ℝ}
    (hq : 0 ≤ q) (hN : 0 ≤ N) (hz : 0 ≤ z)
    (a b c d D u : ℕ) (v : ℕ × ℕ) (hv : v.1*v.2 = 2*u+1)
    (hrect : v.1 ∈ Ioc a b ∧ v.2 ∈ Ioc c d)
    (hrough : ∀ p ∈ primeBand 0 W, ¬p ∣ v.1*v.2) :
    primeAssignmentTerm P q z N u D ≤
      (1/N) * oddPairAssignmentPower a b c d D W z P q v := by
  classical
  by_cases hcond : primeAssignmentCondition P z u D
  · have hmem := prime_assignment_odd_pair_mem P hz a b c d D u v hv hrect hrough hcond
    rw [primeAssignmentTerm, if_pos hcond, oddPairAssignmentPower, if_pos hmem,
      shifted_unmarked_divisor_set P hprime hP2 D u v hv]
    apply le_of_eq
    ring
  · rw [primeAssignmentTerm, if_neg hcond]
    apply mul_nonneg (by positivity)
    unfold oddPairAssignmentPower
    split_ifs <;> positivity

theorem sum_prime_assignment_le_odd_pair_sum (P : Finset ℕ)
    (hprime : ∀ p ∈ P, p.Prime) (hP2 : 2 ∉ P) {q N W z : ℝ}
    (hq : 0 ≤ q) (hN : 0 ≤ N) (hz : 0 ≤ z)
    (a b c d D : ℕ) (S : Finset (ℕ × ℕ)) (u : ℕ × ℕ → ℕ)
    (hv : ∀ v ∈ S, v.1*v.2 = 2*u v+1)
    (hrect : ∀ v ∈ S, v.1 ∈ Ioc a b ∧ v.2 ∈ Ioc c d)
    (hrough : ∀ v ∈ S, ∀ p ∈ primeBand 0 W, ¬p ∣ v.1*v.2) :
    (∑ v ∈ S, primeAssignmentTerm P q z N (u v) D) ≤
      (1/N) * ∑ v ∈ oddMaskedPairBox a b c d D W z (P \ D.primeFactors),
        q^(((P \ D.primeFactors).filter (fun p => p ∣ v.1*v.2-1)).card) := by
  classical
  have hpoint := sum_le_sum (fun v hvS =>
    prime_assignment_term_le_odd_pair P hprime hP2 hq hN hz a b c d D (u v) v
      (hv v hvS) (hrect v hvS) (hrough v hvS))
  rw [← mul_sum] at hpoint
  refine hpoint.trans (mul_le_mul_of_nonneg_left ?_ (by positivity))
  unfold oddPairAssignmentPower
  rw [← sum_filter]
  apply sum_le_sum_of_subset_of_nonneg
  · intro v hvS
    exact (mem_filter.mp hvS).2
  · intro v _ _
    positivity

end Bounty
end

