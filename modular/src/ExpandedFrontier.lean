/- Discharge cross-pool disjointness for the actual small/big subtype split. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_mixed_reindexed_dilation_divisibility
    {G : Type*} [Fintype G] {P : G → Finset ℕ} {M J ell : ℕ}
    (small : G → Prop) (e : {g : G // ¬ small g} ≃ Fin M)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (C : Fin M → Finset (Fin J))
    (d : PhysicalSharedLists (fun g : {g // small g} => P g.val) J)
    (c : SharedActiveLabels (fun g => ↥(P (e.symm g).val))
      (fun g => physicalFullSharedIndices (ell := ell) (C g)))
    (aux : PhysicalAuxLabels (fun g => P (e.symm g).val) C)
    (g : Fin M) (p : ↥(P (e.symm g).val)) :
    (p.val : ℤ) ∣ physicalMixedEdgeD C d c aux g ↔
      (p.val : ℤ) ∣ physicalFullEdgeD C c aux g := by
  apply physical_mixed_dilation_divisibility
    (fun s p hp => hP s.val p hp) (fun g p hp => hP (e.symm g).val p hp)
  intro s g
  apply hdis
  intro he
  exact (e.symm g).property (he ▸ s.property)

end Bounty
