section

/- The original nonzero-M filter does not change the restricted discrepancy polynomial. -/

open Finset

namespace Bounty

theorem typeIIRestrict_complex_ne_zero_iff (M : Finset ℕ) (α : ℕ → ℝ) (n : ℕ) :
    (typeIIRestrict M α n : ℂ) ≠ 0 ↔ n ∈ M ∧ α n ≠ 0 := by
  rw [Complex.ofReal_ne_zero]
  exact typeIIRestrict_ne_zero_iff M α n

theorem typeIIRestrict_nonzero_filter (M : Finset ℕ) (α : ℕ → ℝ) :
    M.filter (fun n => (typeIIRestrict M α n : ℂ) ≠ 0) = M.filter (fun n => α n ≠ 0) := by
  classical
  ext n
  simp only [mem_filter,typeIIRestrict_complex_ne_zero_iff,and_self_left]

theorem typeIIRestrict_nonzero_sum (M : Finset ℕ) (α : ℕ → ℝ) (Φ : ℕ → ℂ) :
    (∑ n ∈ M.filter (fun n => (typeIIRestrict M α n : ℂ) ≠ 0),
      (typeIIRestrict M α n : ℂ)*Φ n) = ∑ n ∈ M, (α n : ℂ)*Φ n := by
  classical
  rw [sum_filter]
  apply sum_congr rfl
  intro n hn
  simp only [typeIIRestrict,if_pos hn]
  by_cases hzero : α n = 0 <;> simp [hzero]

theorem restricted_ambient_rough_mellin_eq (γ L S a v ν u : ℝ)
    {q : ℕ} (χ : DirichletCharacter ℂ q) (lo hi : ℕ) :
    (∑ n ∈ (Ioc lo hi).filter (fun n =>
        (typeIIRestrict (Ioc lo hi) (ambientRoughIntervalTypeIIAlpha γ L S a v) n : ℂ) ≠ 0),
      (typeIIRestrict (Ioc lo hi) (ambientRoughIntervalTypeIIAlpha γ L S a v) n : ℂ)*
        χ (n : ZMod q)*typeIIPhase ν n*harmonicMellinWeight u n) =
      ∑ n ∈ Ioc lo hi, ambientRoughMellinCoefficient γ L S a v ν χ n*harmonicMellinWeight u n := by
  have hs := typeIIRestrict_nonzero_sum (Ioc lo hi) (ambientRoughIntervalTypeIIAlpha γ L S a v)
    (fun n => χ (n : ZMod q)*typeIIPhase ν n*harmonicMellinWeight u n)
  simp only [mul_assoc] at hs ⊢
  rw [hs]
  apply sum_congr rfl
  intro n hn
  rw [← ambient_rough_original_phase_coefficient γ L S a v ν χ
    ((Nat.zero_le lo).trans_lt (mem_Ioc.mp hn).1)]
  ring

theorem restricted_ambient_prime_mellin_eq (κ L S ν u : ℝ)
    {q : ℕ} (χ : DirichletCharacter ℂ q) (lo hi : ℕ) :
    (∑ n ∈ (Ioc lo hi).filter (fun n =>
        (typeIIRestrict (Ioc lo hi) (ambientPrimeTypeIIAlpha κ L S) n : ℂ) ≠ 0),
      (typeIIRestrict (Ioc lo hi) (ambientPrimeTypeIIAlpha κ L S) n : ℂ)*
        χ (n : ZMod q)*typeIIPhase ν n*harmonicMellinWeight u n) =
      ∑ n ∈ Ioc lo hi, ambientPrimeMellinCoefficient κ L S ν χ n*harmonicMellinWeight u n := by
  have hs := typeIIRestrict_nonzero_sum (Ioc lo hi) (ambientPrimeTypeIIAlpha κ L S)
    (fun n => χ (n : ZMod q)*typeIIPhase ν n*harmonicMellinWeight u n)
  simp only [mul_assoc] at hs ⊢
  rw [hs]
  apply sum_congr rfl
  intro n hn
  rw [← ambient_prime_original_phase_coefficient κ L S ν χ
    ((Nat.zero_le lo).trans_lt (mem_Ioc.mp hn).1)]
  ring

end Bounty
end

