/- The original root model over all finite paths, with the small-residue average appearing once. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_root_residue_model_mixed_unrestricted
    {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    [∀ a : PhysicalPrime P, NeZero a.2.val]
    (groups : Finset (Fin N)) (V : Fin N → ℝ) (patterns : Finset I)
    (C : I → Fin N → Finset (Fin J)) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ)
    (hV : ∀ g, 0 < V g)
    (hP : ∀ g a, a ∈ P g → Nat.Prime a)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hk : ∀ t < n + 1, ∀ i ∈ patterns, ∀ g a, a ∈ P g → ¬ (a : ℤ) ∣ k t i)
    (b : PhysicalPrime P → ℝ)
    (hb : ∀ a : PhysicalPrime P, a.1 ∈ groups →
      b a = 1 - (∑ j ∈ range (n + 2), (1 - physicalEndpointSchedule q (n + 1) j)) / a.2.val)
    (hb0 : ∀ a : PhysicalPrime P, a.1 ∈ groups → b a ≠ 0)
    (B : ℕ) (hB : (physicalPrimeGroups P groups).card ≤ B) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    physicalRootResidueModel V patterns C q ζ k K n =
      (∏ a ∈ physicalPrimeGroups P groups, b a : ℝ) *
      ∑ r : PhysicalGroupResidues P groupsᶜ,
        (∏ a : ↥(physicalPrimeGroups P groupsᶜ), 1 / (a.val.2.val : ℝ)) *
        ∑ L : PhysicalMarkLists P J ell,
        ∑ p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
        (if physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p) (n + 1) (n + 1) = 0 then
        (((physicalStateMass (fun g : ↥groupsᶜ => V g.val) J ell *
          ∏ j ∈ range (n + 1), physicalCompletionMass (fun g : ↥groupsᶜ => V g.val)
            (fun g => C (finitePathLabels p j).2.2.1.val g.val) ell : ℝ) : ℂ) *
          physicalMemoryWalkScalar V patterns C ζ K (finitePathLabels p) (finitePathMarks L p) (n + 1) *
          physicalGroupFiniteVertexWeight groupsᶜ C q k L p r *
          physicalGroupFiniteCappedHistory groups C q k
            (fun a => ((a.2.val : ℝ) * b a)⁻¹) V B L p) else 0) := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  unfold physicalRootResidueModel
  simp only [mul_sum]
  trans ∑ L : PhysicalMarkLists P J ell,
    ∑ p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
      (∏ a ∈ physicalPrimeGroups P groups, b a : ℝ) *
      ∑ r : PhysicalGroupResidues P groupsᶜ,
        (∏ a : ↥(physicalPrimeGroups P groupsᶜ), 1 / (a.val.2.val : ℝ)) *
        (if physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p) (n + 1) (n + 1) = 0 then
        (((physicalStateMass (fun g : ↥groupsᶜ => V g.val) J ell *
          ∏ j ∈ range (n + 1), physicalCompletionMass (fun g : ↥groupsᶜ => V g.val)
            (fun g => C (finitePathLabels p j).2.2.1.val g.val) ell : ℝ) : ℂ) *
          physicalMemoryWalkScalar V patterns C ζ K (finitePathLabels p) (finitePathMarks L p) (n + 1) *
          physicalGroupFiniteVertexWeight groupsᶜ C q k L p r *
          physicalGroupFiniteCappedHistory groups C q k
            (fun a => ((a.2.val : ℝ) * b a)⁻¹) V B L p) else 0)
  · apply sum_congr rfl
    intro L _
    apply sum_congr rfl
    intro p _
    have hkp : ∀ j : Fin (n + 1), ∀ g s,
        ¬ (((physicalPathSelectedEquiv patterns C (L, p)).2.2.1 j.castSucc g s).val : ℤ) ∣
          physicalPathSelectedMultiplier C k p j := by
      intro j g s
      exact hk (n - j.val) (by omega) (p j).1.2.2.1.val (p j).1.2.2.1.property g _
        ((physicalPathSelectedEquiv patterns C (L, p)).2.2.1 j.castSucc g s).property
    simpa only [mul_assoc] using physical_finite_root_term_mixed_unrestricted
      groups V patterns C q ζ k K L p hV hP hdis hkp b hb hb0 B hB
  · simp only [mul_sum]
    conv_lhs =>
      arg 2
      ext L
      rw [sum_comm]
    rw [sum_comm]

end Bounty
end

section

/- Selected arrays and initial marks are the exact coordinates of small plans. -/

namespace Bounty

variable {S I V K : Type} {Ps : S → Finset ℕ} {J ell n : ℕ}

abbrev PhysicalSmallSelectedArrays (Ps : S → Finset ℕ) (J ell n : ℕ) (I : Type) :=
  (Fin n → I) × (Fin (n + 1) → PhysicalMarkLists Ps J ell) ×
    (Fin n → PhysicalPermutations S J ell) × (Fin n → PhysicalPermutations S J ell)

def physicalSmallSelectedBlockEquiv :
    PhysicalSmallSelectedArrays Ps J ell n I ≃
      PhysicalMarkLists Ps J ell × (Fin n → PhysicalSmallBlockData Ps J ell I) where
  toFun d := (d.2.1 0, fun j => (d.1 j, d.2.1 j.succ, d.2.2.1 j, d.2.2.2 j))
  invFun p := ((fun j => (p.2 j).1), Fin.cons p.1 (fun j => (p.2 j).2.1),
    (fun j => (p.2 j).2.2.1), (fun j => (p.2 j).2.2.2))
  left_inv := by
    rintro ⟨i, L, σ, τ⟩
    have hL : Fin.cons (L 0) (fun j => L j.succ) = L := by
      funext j
      exact Fin.cases rfl (fun _ => rfl) j
    exact congrArg (fun L' => (i, L', σ, τ)) hL
  right_inv := by
    rintro ⟨L, d⟩
    apply Prod.ext rfl
    funext j
    rfl

noncomputable def physicalSmallSelectedBlockPlanEquiv (last : V) (bs : List (V × K)) :
    PhysicalSmallSelectedArrays Ps J ell bs.length I ≃
      PhysicalMarkLists Ps J ell ×
        PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I)
          (physicalBlockFineSteps bs last) :=
  physicalSmallSelectedBlockEquiv.trans
    (Equiv.prodCongr (Equiv.refl _) (physicalSmallBlockPlanEquiv last bs))

abbrev PhysicalSmallSelectedChoices (Ps : S → Finset ℕ) (ell n : ℕ)
    (C : I → S → Finset (Fin J)) :=
  Σ i : Fin n → I, PhysicalGroupSelectedData Ps ell (fun j => C (i j))

def physicalEmptyAuxLabels (C : S → Finset (Fin J)) (hC : ∀ g, C g = ∅) :
    PhysicalAuxLabels Ps C :=
  fun g s => False.elim (by simpa only [hC g, Finset.notMem_empty] using s.property)

def physicalSmallSelectedArraysEquiv (C : I → S → Finset (Fin J))
    (hC : ∀ i g, C i g = ∅) :
    PhysicalSmallSelectedChoices Ps ell n C ≃ PhysicalSmallSelectedArrays Ps J ell n I where
  toFun d := (d.1, d.2.2.1, d.2.2.2.1, d.2.2.2.2)
  invFun d := ⟨d.1, (fun j => physicalEmptyAuxLabels (C (d.1 j)) (hC (d.1 j))),
    d.2.1, d.2.2.1, d.2.2.2⟩
  left_inv := by
    rintro ⟨i, a, L, σ, τ⟩
    have ha : (fun j => physicalEmptyAuxLabels (Ps := Ps) (C (i j)) (hC (i j))) = a := by
      funext j g s
      exact False.elim (by simpa only [hC (i j) g, Finset.notMem_empty] using s.property)
    exact congrArg (fun a' => (⟨i, a', L, σ, τ⟩ : PhysicalSmallSelectedChoices Ps ell n C)) ha
  right_inv := by rintro ⟨i, L, σ, τ⟩; rfl

end Bounty
end

section

/- The actual selected fine schedule consists of the original indexed blocks. -/

namespace Bounty

theorem physical_selected_fine_block_schedule (n : ℕ) :
    (List.range (4 * n + 1)).map (physicalSelectedFineTag n) =
      physicalBlockFineSteps
        (List.ofFn (fun j : Fin n => (j.castSucc, j))) (Fin.last n) := by
  have hmap : (List.range (4 * n + 1)).map (physicalSelectedFineTag n) =
      List.ofFn (fun j : Fin (4 * n + 1) => physicalSelectedFineTag n j.val) := by
    simpa using (List.ofFn_getElem_eq_map (List.range (4 * n + 1))
      (physicalSelectedFineTag n)).symm
  rw [hmap, List.ofFn_succ', List.concat_eq_append]
  have hend : physicalSelectedFineTag n (4 * n) = some (.inl (Fin.last n)) :=
    physical_fine_tag_visit (Fin.last n)
  simp only [Fin.val_last, hend]
  rw [List.ofFn_mul']
  simp only [physicalBlockFineSteps, List.flatMap_def, List.map_ofFn]
  congr 2
  apply congrArg List.ofFn
  funext j
  simp only [List.ofFn_succ, List.ofFn_zero]
  change [physicalSelectedFineTag n (4 * j.val + 0),
    physicalSelectedFineTag n (4 * j.val + 1),
    physicalSelectedFineTag n (4 * j.val + 2),
    physicalSelectedFineTag n (4 * j.val + 3)] =
      [some (.inl j.castSucc), none, some (.inr j), none]
  have hv : physicalSelectedFineTag n (4 * j.val) = some (.inl j.castSucc) :=
    physical_fine_tag_visit j.castSucc
  simp only [Nat.add_zero, hv,
    physical_fine_tag_source_permutation, physical_fine_tag_edge,
    physical_fine_tag_target_permutation]

end Bounty
end

section

/- The original full-box candidate sum, with its saved diagonal and exact truncated energy.
The allocation threshold is chosen after the coefficient costs and before the Fourier cutoff. -/

open Finset Filter

namespace Bounty

theorem exists_candidate_original_energy_assembly_with_error {c b A D : ℝ}
    (hc : 0 < c) (hb : 0 < b) {r : ℕ} (hr : 6 ≤ r) :
    ∃ aE aH : ℝ, 0 ≤ aE ∧ 0 ≤ aH ∧ ∃ Kmin : ℝ, 0 < Kmin ∧
      ∀ K : ℝ, Kmin ≤ K → ∀ T : ℝ, ∃ F : ℝ, 0 < F ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (jStar : ℕ) (hj : jStar ∈ candidateQIndices c L)
        (take : Fin ((candidateQIndices c L).card*r) → Bool),
      take ((candidateAllocationOrder c L r).symm
        (candidateRoughSlot c L r jStar (by omega) hj)) = false →
      ∀ (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ)
        (ν R U V : ℝ),
      Real.exp (b*L) ≤ U → U ≤ Real.exp L → Real.exp (b*L) ≤ V → V ≤ Real.exp L →
      2*U*V ≤ R*Real.exp L → ∀ (P M N : Finset ℕ) (α β : ℕ → ℂ),
      (∀ p ∈ P, 0 < p) → (∀ m ∈ M, (m:ℝ) ∈ Set.Icc U (2*U)) →
      (∀ n ∈ N, (n:ℝ) ∈ Set.Icc V (2*V)) →
      (∀ m, m ∉ M → α m = 0) → (∀ n, n ∉ N → β n = 0) →
      (∀ m ∈ M, ‖α m‖ ≤ L^A) → (∀ n ∈ N, ‖β n‖ ≤ L^A) →
      (∀ m ∈ M, α m ≠ 0 → ∀ p ∈ m.primeFactors, Real.exp (Real.sqrt L) < (p:ℝ)) →
      let E := U*L^(-K)
      let B := typeIIAdmissibleDeterminantBound L K
      let H := candidateRetainedAllocationSupport c L r jStar P take
      let a := candidateB0RetainedCoefficient c L (1/2) r jStar take
        (candidateAllocationFourierTwist c L r jStar take ξ) ν
      ‖candidateRetainedAllocationIntegrand c L (1/2) r jStar (Real.log E) P take
        (candidateBoxFiniteTest L E (Icc 1 ⌊R*Real.exp L⌋₊)
          (fun u => typeIIMellinPhase ν u * ∑ m ∈ (2*u+1).divisors, α m*β ((2*u+1)/m))) ξ‖^2 ≤
        ‖activeAllocationFourierWeight (candidateAllocationRadius r)
          (candidateAllocationActive c L r jStar) take ξ‖^2 *
        ((U*V)^2*L^(-D) + (2*E*V*(L^aE)^2*(L^A)^2) *
          ((typeIIEnergyFourierIntegral L U V E B M H α a
            {ζ : EuclideanSpace ℝ (Fin 3) | ‖ζ‖ ≤ L^F}).re +
            (2*(B:ℝ)) * (∑ j ∈ range (typeIISmoothDyadicCount L),
              typeIISmoothDyadicScale U V E j) * L^(-T))) := by
  obtain ⟨aE, aH, haE, haH, hcoeff⟩ := exists_candidate_B0_polynomial_bounds hc hr
  obtain ⟨Kmin, hKmin, hdiag⟩ := exists_typeII_actual_diagonal_saving
    (C := 2) (by norm_num) aE A A aH D
  refine ⟨aE, aH, haE, haH, Kmin, hKmin, ?_⟩
  intro K hK T
  have hK0 : 0 ≤ K := hKmin.le.trans hK
  obtain ⟨F, hF, hred⟩ := exists_actual_B0_energy_reduction
    (A := A) (D := T) hc hb hr K hK0
  refine ⟨F, hF, ?_⟩
  filter_upwards [hcoeff, hdiag, hred, eventually_typeII_actual_dyadic_geometry hb hK0,
    eventually_gt_atTop (0:ℝ)] with L hcoeff hdiag hred hgeo hL
  intro jStar hj take hkeep ξ ν R U V hUlo hUhi hVlo hVhi hR
    P M N α β hP hM hN hαsupport hβsupport hα hβ hrough
  have hH : ∀ h ∈ candidateRetainedAllocationSupport c L r jStar P take, 0 < h :=
    fun h hh => candidate_retained_allocation_support_pos c L r jStar P take hP hh
  obtain ⟨hU, hV, hE, hUV, hlogUV, _⟩ :=
    hgeo U V (U*L^(-K)) hUlo hUhi hVlo hVhi rfl
  obtain ⟨htaken, hretained⟩ := hcoeff jStar hj take hkeep ξ ν
  have hd := hdiag K U V M (candidateRetainedAllocationSupport c L r jStar P take) α
    (candidateB0RetainedCoefficient c L (1/2) r jStar take
      (candidateAllocationFourierTwist c L r jStar take ξ) ν)
    hK hU hV (by linarith) hlogUV
    (fun m hm => Nat.cast_pos.mp (hU.trans_le (hM m hm).1))
    (fun m hm => (hM m hm).2) hH hα (fun h hh => hretained h (hH h hh))
  have he := hred jStar hj take hkeep ξ ν U V hUlo hUhi hVlo hVhi M
    (candidateRetainedAllocationSupport c L r jStar P take) α hM hα hH hrough
  have hs := candidate_retained_box_smooth_cauchy c L r jStar P M N take ξ
    (U*L^(-K)) ν R U V (L^aE) (L^A) α β hL hE hU hV hP
    (fun m hm => (hM m hm).2) hN hR hαsupport hβsupport
    (fun e he => htaken e (candidate_taken_product_support_pos c L r jStar take
      (mem_filter.mp he).1)) hβ
  dsimp only at hd he hs ⊢
  have he' := (abs_le.mp he).2
  have hfactor : 0 ≤ 2*(U*L^(-K))*V*(L^aE)^2*(L^A)^2 := by positivity
  apply hs.trans
  apply mul_le_mul_of_nonneg_left _ (sq_nonneg _)
  rw [mul_add]
  apply add_le_add hd
  exact mul_le_mul_of_nonneg_left (by linarith [he']) hfactor

end Bounty
end

section

/- Fixed frequency shifts in the actual ambient Type-II discrepancy bounds. -/

open Finset Filter

namespace Bounty

theorem abs_add_fixed_le_rpow {L x u σ : ℝ} (hL : 2 ≤ L) (hx : 0 ≤ x)
    (hu : |u| ≤ L ^ x) (hσ : |σ| ≤ L) : |u + σ| ≤ L ^ (x + 2) := by
  have hL0 : 0 < L := by linarith
  have hL1 : 1 ≤ L := by linarith
  have hp : 1 ≤ L ^ x := Real.one_le_rpow hL1 hx
  calc
    |u + σ| ≤ |u| + |σ| := abs_add_le u σ
    _ ≤ L ^ x + L := add_le_add hu hσ
    _ ≤ L ^ x * (1 + L) := by nlinarith
    _ ≤ L ^ x * L ^ (2 : ℕ) :=
      mul_le_mul_of_nonneg_left (by nlinarith) (Real.rpow_nonneg hL0.le x)
    _ = L ^ (x + 2) := by rw [Real.rpow_add hL0, Real.rpow_two]

theorem eventually_ambient_rough_shifted_discrepancy
    (hZ : PrimitiveZeroFreeHalfPlane) {γ vMax S B0 Cmod B : ℝ}
    (hγ : 0 < γ) (hv : vMax < 1) (hS : 0 ≤ S)
    (hB0 : 0 ≤ B0) (_hCmod : 0 ≤ Cmod)
    (hprecision : max B0 Cmod + B + 6 ≤ S) (σ : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ a v : ℝ, v ≤ vMax →
      ∀ (r : ℕ) [NeZero r] (χ : DirichletCharacter ℂ r), (r : ℝ) ≤ L ^ Cmod →
      ∀ u : ℝ, |u| ≤ L ^ B0 → ∀ m n : ℕ,
        ‖∑ i ∈ Ioc m n, (ambientRoughIntervalTypeIIAlpha γ L S a v i : ℂ) *
          harmonicMellinWeight (u + σ) i * χ (i : ZMod r)‖ ≤ L ^ (-B) := by
  have hx : 0 ≤ max B0 Cmod := hB0.trans (le_max_left _ _)
  have hT : 0 ≤ max B0 Cmod + 2 := by linarith
  filter_upwards [eventually_ambient_rough_interval_typeII_discrepancy_uniform
    hZ hγ hv hS hT (by linarith : (max B0 Cmod + 2) + B + 4 ≤ S),
    eventually_ge_atTop (2 : ℝ), eventually_ge_atTop |σ|] with L hdis hL hσ
  intro a v hv' r hr χ hrange u hu m n
  have hL1 : 1 ≤ L := by linarith
  apply hdis a v hv' r χ _ (u + σ) _ m n
  · exact hrange.trans (Real.rpow_le_rpow_of_exponent_le hL1 (by linarith [le_max_right B0 Cmod]))
  · apply abs_add_fixed_le_rpow hL hx _ hσ
    exact hu.trans (Real.rpow_le_rpow_of_exponent_le hL1 (le_max_left _ _))

theorem eventually_ambient_prime_shifted_discrepancy
    (hZ : PrimitiveZeroFreeHalfPlane) {S B0 Cmod B : ℝ}
    (hS : 0 ≤ S) (hB0 : 0 ≤ B0) (_hCmod : 0 ≤ Cmod)
    (hprecision : max B0 Cmod + B + 6 ≤ S) (σ : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ κ : ℝ, 0 ≤ κ → κ ≤ 1 / 50 →
      ∀ (r : ℕ) [NeZero r] (χ : DirichletCharacter ℂ r), (r : ℝ) ≤ L ^ Cmod →
      ∀ u : ℝ, |u| ≤ L ^ B0 → ∀ m n : ℕ,
        ‖∑ i ∈ Ioc m n, (ambientPrimeTypeIIAlpha κ L S i : ℂ) *
          harmonicMellinWeight (u + σ) i * χ (i : ZMod r)‖ ≤ L ^ (-B) := by
  have hx : 0 ≤ max B0 Cmod := hB0.trans (le_max_left _ _)
  have hT : 0 ≤ max B0 Cmod + 2 := by linarith
  filter_upwards [eventually_ambient_prime_typeII_discrepancy hZ hS hT
    (by linarith : (max B0 Cmod + 2) + B + 4 ≤ S),
    eventually_ge_atTop (2 : ℝ), eventually_ge_atTop |σ|] with L hdis hL hσ
  intro κ hκ hκ' r hr χ hrange u hu m n
  have hL1 : 1 ≤ L := by linarith
  apply hdis κ hκ hκ' r χ _ (u + σ) _ m n
  · exact hrange.trans (Real.rpow_le_rpow_of_exponent_le hL1 (by linarith [le_max_right B0 Cmod]))
  · apply abs_add_fixed_le_rpow hL hx _ hσ
    exact hu.trans (Real.rpow_le_rpow_of_exponent_le hL1 (le_max_left _ _))

end Bounty
end

section

/- Uniform low-frequency discrepancy across a whole polynomial shift window. -/

open Finset Filter

namespace Bounty

theorem abs_add_le_rpow_max_add_one {L u σ a b : ℝ} (hL : 2 ≤ L)
    (hu : |u| ≤ L ^ a) (hσ : |σ| ≤ L ^ b) :
    |u + σ| ≤ L ^ (max a b + 1) := by
  have hL0 : 0 < L := by linarith
  have hL1 : 1 ≤ L := by linarith
  have ha := Real.rpow_le_rpow_of_exponent_le hL1 (le_max_left a b)
  have hb := Real.rpow_le_rpow_of_exponent_le hL1 (le_max_right a b)
  calc
    _ ≤ |u| + |σ| := abs_add_le u σ
    _ ≤ 2 * L ^ max a b := by linarith
    _ ≤ L * L ^ max a b := mul_le_mul_of_nonneg_right hL (Real.rpow_nonneg hL0.le _)
    _ = L ^ (max a b + 1) := by rw [Real.rpow_add hL0, Real.rpow_one]; ring

theorem eventually_ambient_rough_uniform_shift_discrepancy
    (hZ : PrimitiveZeroFreeHalfPlane) {γ vMax S B0 Cmod Sfreq B : ℝ}
    (hγ : 0 < γ) (hv : vMax < 1) (hS : 0 ≤ S) (hB0 : 0 ≤ B0)
    (hprecision : max (max B0 Sfreq) Cmod + B + 5 ≤ S) :
    ∀ᶠ L : ℝ in atTop, ∀ a v : ℝ, v ≤ vMax →
      ∀ (r : ℕ) [NeZero r] (χ : DirichletCharacter ℂ r), (r : ℝ) ≤ L ^ Cmod →
      ∀ u σ : ℝ, |u| ≤ L ^ B0 → |σ| ≤ L ^ Sfreq → ∀ m n : ℕ,
        ‖∑ i ∈ Ioc m n, (ambientRoughIntervalTypeIIAlpha γ L S a v i : ℂ) *
          harmonicMellinWeight (u + σ) i * χ (i : ZMod r)‖ ≤ L ^ (-B) := by
  have hx : 0 ≤ max (max B0 Sfreq) Cmod :=
    hB0.trans ((le_max_left _ _).trans (le_max_left _ _))
  have hT : 0 ≤ max (max B0 Sfreq) Cmod + 1 := by linarith
  filter_upwards [eventually_ambient_rough_interval_typeII_discrepancy_uniform
    hZ hγ hv hS hT (by linarith : (max (max B0 Sfreq) Cmod + 1) + B + 4 ≤ S),
    eventually_ge_atTop (2 : ℝ)] with L hdis hL
  intro a v hv' r hr χ hrange u σ hu hσ m n
  have hL1 : 1 ≤ L := by linarith
  apply hdis a v hv' r χ _ (u + σ) _ m n
  · exact hrange.trans (Real.rpow_le_rpow_of_exponent_le hL1
      (by linarith [le_max_right (max B0 Sfreq) Cmod]))
  · exact (abs_add_le_rpow_max_add_one hL hu hσ).trans
      (Real.rpow_le_rpow_of_exponent_le hL1
        (by linarith [le_max_left (max B0 Sfreq) Cmod]))

theorem eventually_ambient_prime_uniform_shift_discrepancy
    (hZ : PrimitiveZeroFreeHalfPlane) {S B0 Cmod Sfreq B : ℝ}
    (hS : 0 ≤ S) (hB0 : 0 ≤ B0)
    (hprecision : max (max B0 Sfreq) Cmod + B + 5 ≤ S) :
    ∀ᶠ L : ℝ in atTop, ∀ κ : ℝ, 0 ≤ κ → κ ≤ 1 / 50 →
      ∀ (r : ℕ) [NeZero r] (χ : DirichletCharacter ℂ r), (r : ℝ) ≤ L ^ Cmod →
      ∀ u σ : ℝ, |u| ≤ L ^ B0 → |σ| ≤ L ^ Sfreq → ∀ m n : ℕ,
        ‖∑ i ∈ Ioc m n, (ambientPrimeTypeIIAlpha κ L S i : ℂ) *
          harmonicMellinWeight (u + σ) i * χ (i : ZMod r)‖ ≤ L ^ (-B) := by
  have hx : 0 ≤ max (max B0 Sfreq) Cmod :=
    hB0.trans ((le_max_left _ _).trans (le_max_left _ _))
  have hT : 0 ≤ max (max B0 Sfreq) Cmod + 1 := by linarith
  filter_upwards [eventually_ambient_prime_typeII_discrepancy hZ hS hT
    (by linarith : (max (max B0 Sfreq) Cmod + 1) + B + 4 ≤ S),
    eventually_ge_atTop (2 : ℝ)] with L hdis hL
  intro κ hκ hκ' r hr χ hrange u σ hu hσ m n
  have hL1 : 1 ≤ L := by linarith
  apply hdis κ hκ hκ' r χ _ (u + σ) _ m n
  · exact hrange.trans (Real.rpow_le_rpow_of_exponent_le hL1
      (by linarith [le_max_right (max B0 Sfreq) Cmod]))
  · exact (abs_add_le_rpow_max_add_one hL hu hσ).trans
      (Real.rpow_le_rpow_of_exponent_le hL1
        (by linarith [le_max_left (max B0 Sfreq) Cmod]))

end Bounty
end

section

/- Exponential coefficient support gives the actual dyadic base bounds. -/

open Finset Filter

namespace Bounty

theorem eventually_exponential_dyadic_base_bounds {a b C : ℝ}
    (ha : 0 < a) (hb : b < 1) (hC : 0 < C) :
    ∀ᶠ L : ℝ in atTop, ∀ U x : ℝ,
      Real.exp (a*L) ≤ x → x ≤ C*Real.exp (b*L) → U ≤ x → x ≤ 2*U →
      Real.exp ((a/2)*L) ≤ U ∧ U ≤ Real.exp L := by
  have hgap : 0 < 1-b := sub_pos.mpr hb
  filter_upwards [eventually_exp_half_le_half_exp ha,
    eventually_ge_atTop (Real.log C/(1-b))] with L hhalf hL
  intro U x hlo hhi hUx hxU
  have hlog : Real.log C ≤ (1-b)*L := by
    have h := (div_le_iff₀ hgap).mp hL
    nlinarith only [h]
  have hupper : C*Real.exp (b*L) ≤ Real.exp L := by
    calc
      _ = Real.exp (Real.log C+b*L) := by rw [Real.exp_add,Real.exp_log hC]
      _ ≤ _ := Real.exp_le_exp.mpr (by nlinarith only [hlog])
  exact ⟨hhalf.trans (by linarith), hUx.trans (hhi.trans hupper)⟩

theorem original_dyadic_member_bounds (H i n : ℕ)
    (hn : n ∈ dyadicNatBucket (Icc 1 H) i) :
    originalDyadicBase i ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*originalDyadicBase i := by
  rw [dyadicNatBucket_eq_real_interval (Icc 1 H) (fun m hm => (mem_Icc.mp hm).1)] at hn
  exact ⟨(mem_filter.mp hn).2.1.le,(mem_filter.mp hn).2.2⟩

end Bounty
end

section

/- The exact original finite dyadic partition has only polynomial cost. -/

open Finset Filter
namespace Bounty

theorem eventually_original_dyadic_count :
    ∀ᶠ L : ℝ in atTop,
      ((dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊)).card : ℝ) ≤ L^2 := by
  filter_upwards [eventually_ge_atTop (Real.log 33), eventually_ge_atTop (1 : ℝ),
    eventually_ge_atTop (2/Real.log 2+2)] with L h33 hL hlarge
  have hL0 : 0 ≤ L := by linarith
  have h33exp : (33 : ℝ) ≤ Real.exp L := by
    calc
      _ = Real.exp (Real.log 33) := (Real.exp_log (by norm_num)).symm
      _ ≤ _ := Real.exp_le_exp.mpr h33
  have hupper : 33*Real.exp L ≤ Real.exp (2*L) := by
    calc
      _ ≤ Real.exp L*Real.exp L := mul_le_mul_of_nonneg_right h33exp (Real.exp_pos L).le
      _ = _ := by rw [← Real.exp_add]; congr 1; ring
  have hc := dyadic_indices_card_window (Icc 1 ⌊33*Real.exp L⌋₊)
    (a := 0) (b := 2*L) (by linarith) (by
      intro n hn
      have hn' := mem_Icc.mp hn
      refine ⟨hn'.1, ?_, ?_⟩
      · simpa only [Real.exp_zero,Nat.cast_one] using (Nat.cast_le (α := ℝ).mpr hn'.1)
      · exact (Nat.cast_le.mpr hn'.2).trans ((Nat.floor_le (by positivity)).trans hupper))
  simp only [sub_zero] at hc
  have hmul := mul_le_mul_of_nonneg_right hlarge hL0
  calc
    _ ≤ 2*L/Real.log 2+2 := hc
    _ = (2/Real.log 2)*L+2 := by ring
    _ ≤ (2/Real.log 2+2)*L := by nlinarith
    _ ≤ L^2 := by nlinarith [hmul]

theorem abs_double_sum_le_card_sq {ι : Type*} (I : Finset ι) (f : ι → ι → ℝ)
    {R : ℝ} (hR : 0 ≤ R)
    (hf : ∀ i ∈ I, ∀ j ∈ I, f i j ≠ 0 → |f i j| ≤ R) :
    |∑ i ∈ I, ∑ j ∈ I, f i j| ≤ (I.card : ℝ)^2 * R := by
  calc
    _ ≤ ∑ i ∈ I, |∑ j ∈ I, f i j| := abs_sum_le_sum_abs _ _
    _ ≤ ∑ i ∈ I, ∑ j ∈ I, |f i j| := sum_le_sum (fun _ _ => abs_sum_le_sum_abs _ _)
    _ ≤ ∑ _i ∈ I, ∑ _j ∈ I, R := by
      apply sum_le_sum
      intro i hi
      apply sum_le_sum
      intro j hj
      by_cases hz : f i j = 0
      · simpa only [hz,abs_zero] using hR
      · exact hf i hi j hj hz
    _ = _ := by simp only [sum_const,nsmul_eq_mul]; ring

end Bounty
end

section

/- All harmonic support and scale parameters are verified on the original dyadic indices. -/

open Filter Finset Real
open scoped Classical
namespace Bounty

theorem eventually_actual_candidate_harmonic_parameters {c b K A ε : ℝ}
    (hc : 0 < c) (hb : 0 < b) (hK : 0 ≤ K) (hA : 0 ≤ A) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ (G : Type*) [Fintype G]
      (ι : G → candidatePIndices c L) (J : ℕ) (C : G → Finset (Fin J))
      (aux : PhysicalAuxLabels (fun g => candidatePBand (c*L) (ι g).val) C),
      (J*Fintype.card G : ℕ) ≤ A*log L →
      ∀ U V : ℝ, exp (b*L) ≤ U → U ≤ exp L → exp (b*L) ≤ V → V ≤ exp L →
      ∀ k ∈ Icc (-(typeIIAdmissibleDeterminantBound L K : ℤ)) (typeIIAdmissibleDeterminantBound L K : ℤ),
      ∀ j ∈ range (typeIISmoothDyadicCount L),
      let Z := typeIISmoothDyadicScale U V (U*L^(-K)) j
      let d := physicalFreeFactor C aux
      let Y := Z*(d : ℝ)/2
      let N := ⌈3*Z*(d : ℝ)⌉₊
      0 < Z ∧ |(k : ℝ)| ≤ Z ∧ 1 ≤ Z*(d : ℝ) ∧ 3*Z < exp (4*L) ∧
      0 < Y ∧ exp (b*L) ≤ Y ∧ b*L ≤ log Y ∧ log Y ≤ (4+ε)*L ∧
      (d : ℝ) ≤ exp (ε*L) ∧ 2*((N : ℝ)/Y)*(1+log (N : ℝ))^15 ≤ L^(31 : ℝ) ∧
      log (N : ℝ) ≤ (4+ε)*L ∧
      ∀ w ∈ harmonicPositiveSupport Z k d,
        (0 ≤ w ∧ w ≤ (N : ℤ)) ∧ (0 < w+k*(d : ℤ) ∧ w+k*(d : ℤ) ≤ (N : ℤ)) ∧
        Y ≤ (w : ℝ) ∧ ‖(typeIIHarmonicDyadic ((w : ℝ)/(Z*(d : ℝ))) : ℂ)‖ ≤ 2 := by
  obtain ⟨v, vmax, _, _, hpool⟩ := exists_candidate_P_pool_bounds hc
  filter_upwards [hpool, eventually_actual_harmonic_scale_inputs hb hK,
    eventually_typeII_harmonic_scale_lower hb hK,
    eventually_candidate_harmonic_energy_polynomial hc hA,
    eventually_candidate_free_factor_subexponential hc hA hε,
    eventually_candidate_harmonic_log_linear hc hA hε, eventually_ge_atTop (0 : ℝ)]
    with L hp hgeo hlo henergy hfree hlog hL
  intro G _ ι J C aux hslots U V hUlo hUhi hVlo hVhi k hk j hj
  dsimp only
  let Z := typeIISmoothDyadicScale U V (U*L^(-K)) j
  let d := physicalFreeFactor C aux
  have hprime : ∀ g p, p ∈ candidatePBand (c*L) (ι g).val → p.Prime := by
    intro g p hpg
    exact ((hp.2.2.2.2.2 (ι g).val (ι g).property).2.2 p hpg).1
  have hd : 0 < d := prod_pos (fun g _ => prod_pos (fun u _ => (hprime g _ (aux g u).property).pos))
  have hd1 : (1 : ℝ) ≤ d := by exact_mod_cast hd
  obtain ⟨hZ, _, hkZ, hcut⟩ := hgeo U V hUlo hUhi hVlo hVhi k hk j hj
  have hYlo : exp (b*L) ≤ Z*(d : ℝ)/2 := by
    have hz := hlo U V hUlo hVlo j
    have hm := mul_le_mul_of_nonneg_left hd1 hZ.le
    dsimp only [Z] at *
    nlinarith
  have hY : 0 < Z*(d : ℝ)/2 := (exp_pos _).trans_le hYlo
  have hprod : 1 ≤ Z*(d : ℝ) := by
    have hh : 1 ≤ exp (b*L) := one_le_exp (mul_nonneg hb.le hL)
    linarith
  have he := henergy G ι J C aux hslots Z hZ hprod hcut
  have hdsmall := hfree G ι J C aux hslots
  have hNlog := hlog G ι J C aux hslots Z hZ hprod hcut
  have hYN : Z*(d : ℝ)/2 ≤ (⌈3*Z*(d : ℝ)⌉₊ : ℝ) := by
    have hh := Nat.le_ceil (3*Z*(d : ℝ))
    nlinarith
  have hYlog : log (Z*(d : ℝ)/2) ≤ (4+ε)*L :=
    (log_le_log hY hYN).trans hNlog
  have hloLog : b*L ≤ log (Z*(d : ℝ)/2) := (le_log_iff_exp_le hY).mpr hYlo
  exact ⟨hZ, hkZ, hprod, hcut, hY, hYlo, hloLog, hYlog, hdsmall, he, hNlog,
    (harmonic_positive_error_parameters hZ k hd hkZ).2⟩

end Bounty
end

section

/- Scalar polynomial envelopes for selected endpoint peeling on the original support. -/

open Real
namespace Bounty

theorem selected_peel_log_factor_power {L v z : ℝ}
    (hv : 0 < v) (hL : 1 ≤ L) (hcoef : 1+10/v ≤ L) (hz0 : 0 ≤ z) (hz : z ≤ 5*L) :
    (1+2*z/v)^2 ≤ L^(4 : ℝ) := by
  have hb : 1+2*z/v ≤ L*L := by
    calc
      _ ≤ 1+2*(5*L)/v := by gcongr
      _ = 1+(10/v)*L := by ring
      _ ≤ L+(10/v)*L := add_le_add hL le_rfl
      _ = (1+10/v)*L := by ring
      _ ≤ L*L := mul_le_mul_of_nonneg_right hcoef (zero_le_one.trans hL)
  calc
    _ ≤ (L*L)^2 := pow_le_pow_left₀ (by positivity) hb 2
    _ = _ := by norm_num [pow_two]; ring

theorem selected_peel_harmonic_power {L M energy m Cb Ce : ℝ}
    (hL : 3 ≤ L) (hM0 : 0 ≤ M) (hM : M ≤ L^m)
    (he0 : 0 ≤ energy) (he : energy ≤ L^(31 : ℝ)) :
    3*(M*L^Cb)^2*(L^Ce*L^Ce*L^Ce)^2*energy ≤ L^(2*m+2*Cb+6*Ce+32) := by
  have hL0 : 0 < L := by linarith
  calc
    _ ≤ L*(L^m*L^Cb)^2*(L^Ce*L^Ce*L^Ce)^2*L^(31 : ℝ) := by gcongr
    _ = _ := by
      nth_rw 1 [← rpow_one L]
      simp only [← rpow_mul_natCast hL0.le, ← rpow_add hL0]
      congr 1
      ring

theorem selected_peel_decay_absorb {L cost T : ℝ} (hL : 1 ≤ L)
    (hc : cost ≤ L^T) (D : ℝ) :
    cost*L^(-max 0 (D+T)) ≤ L^(-D) := by
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL
  calc
    _ ≤ L^T*L^(-max 0 (D+T)) := mul_le_mul_of_nonneg_right hc (rpow_nonneg hL0.le _)
    _ = L^(T-max 0 (D+T)) := by rw [← rpow_add hL0]; congr 1
    _ ≤ _ := rpow_le_rpow_of_exponent_le hL (by linarith only [le_max_right (0 : ℝ) (D+T)])

end Bounty
end

section

/- Recorded edge displacements are the actual local displacements on the
unchanged chronological path. On supported states they equal the full edge divisor. -/

open scoped Classical
namespace Bounty
section Local
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (cut : ℕ → Fin N → Finset (Fin J))

noncomputable def physicalLocalDisplacement :
    (tag : Option (Fin (n + 1) ⊕ Fin n)) →
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B) →
    PhysicalFullLedgerEvent C k tag s → ℤ
  | none, _, _ => 0
  | some (.inl _), _, _ => 0
  | some (.inr j), s, e => physicalActiveDisplacement C k cut j (fun g => (s.2 g).1) e.1

theorem physical_local_displacement_edge_observation
    (j : Fin n) (before after : Fin N → Finset (Fin J))
    (tag : Option (Fin (n + 1) ⊕ Fin n)) (htag : tag = some (.inr j))
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (e : PhysicalFullLedgerEvent C k tag s) :
    physicalLocalDisplacement C k cut tag s e =
      physicalObservedDisplacement C k cut j
        (physicalFullEventObservation C k before after tag s e) (fun g => (s.2 g).1) := by
  subst tag
  exact (physical_observed_displacement_aux C k cut j e.1 _).symm

theorem physical_local_displacement_nonedge (i : ℕ) (hi : i % 4 ≠ 2)
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (e : PhysicalFullLedgerEvent C k (physicalSelectedFineTag n i) s) :
    physicalLocalDisplacement C k cut (physicalSelectedFineTag n i) s e = 0 := by
  have hgood (j : Fin n) : physicalSelectedFineTag n i ≠ some (.inr j) := by
    intro h
    unfold physicalSelectedFineTag at h
    split_ifs at h; simp_all
  generalize ht : physicalSelectedFineTag n i = tag at e ⊢
  cases tag with
  | none => rfl
  | some tag =>
    cases tag with
    | inl j => rfl
    | inr j => exact (hgood j ht).elim

theorem physical_record_displacement_local
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (p : FiniteEventPath (fun i => PhysicalFullLedgerEvent C k (physicalSelectedFineTag n i))
      (fun i => physicalFullLedgerEventTarget C k (physicalSelectedFineTag n i))
      (List.range (4 * n + 1)) s) (j : Fin n) :
    let E := fun i => PhysicalFullLedgerEvent (P := P) (ell := ell) (B := B) C k (physicalSelectedFineTag n i)
    let target := fun i => physicalFullLedgerEventTarget (P := P) (ell := ell) (B := B) C k (physicalSelectedFineTag n i)
    let occ := finiteScheduleOccurrence E target (4 * n + 1) s p
    physicalRecordDisplacement C k cut
      (finiteEventPathObservations E target
        (physicalFullTraceObservation C k (physicalSelectedFineTag n) cut) (List.range (4 * n + 1)) s p) j =
      physicalLocalDisplacement C k cut (physicalSelectedFineTag n (4 * j.val + 2))
        (occ ⟨4 * j.val + 2, by have := j.isLt; omega⟩).1
        (occ ⟨4 * j.val + 2, by have := j.isLt; omega⟩).2 := by
  dsimp only
  let E := fun i => PhysicalFullLedgerEvent (P := P) (ell := ell) (B := B) C k (physicalSelectedFineTag n i)
  let target := fun i => physicalFullLedgerEventTarget (P := P) (ell := ell) (B := B) C k (physicalSelectedFineTag n i)
  let observe := physicalFullTraceObservation (P := P) (ell := ell) (B := B) C k (physicalSelectedFineTag n) cut
  let r := finiteEventPathObservations E target observe (List.range (4 * n + 1)) s p
  let occ := finiteScheduleOccurrence E target (4 * n + 1) s p
  have hlen : r.length = 4 * n + 1 := by
    simp only [r, finite_event_path_observations_length, List.length_range]
  have h1 : 4 * j.val + 1 < r.length := by omega
  have h2 : 4 * j.val + 2 < r.length := by omega
  change (match r[4 * j.val + 1]?, r[4 * j.val + 2]? with
    | some a, some b => physicalObservedDisplacement C k cut j b.2.1
        (fun g => (a.2.2.2 g).1)
    | _, _ => 0) = _
  rw [List.getElem?_eq_getElem h1, List.getElem?_eq_getElem h2]
  change physicalObservedDisplacement C k cut j (r.get ⟨_, h2⟩).2.1
    (fun g => ((r.get ⟨_, h1⟩).2.2.2 g).1) = _
  rw [finite_schedule_observations_get E target observe _ s p ⟨_, by omega⟩,
    finite_schedule_observations_get E target observe _ s p ⟨_, by omega⟩]
  change physicalObservedDisplacement C k cut j
    (physicalFullEventObservation C k (cut (4 * j.val + 2)) (cut (4 * j.val + 2 + 1))
      (physicalSelectedFineTag n (4 * j.val + 2)) (occ ⟨4 * j.val + 2, by omega⟩).1
      (occ ⟨4 * j.val + 2, by omega⟩).2)
    (fun g => ((target (4 * j.val + 1) (occ ⟨4 * j.val + 1, by omega⟩).1
      (occ ⟨4 * j.val + 1, by omega⟩).2).2 g).1) = _
  have hs := finite_schedule_source_after E target (4 * n + 1) s p
    (4 * j.val + 1) (by omega)
  change (occ ⟨4 * j.val + 2, by omega⟩).1 =
    target (4 * j.val + 1) (occ ⟨4 * j.val + 1, by omega⟩).1
      (occ ⟨4 * j.val + 1, by omega⟩).2 at hs
  rw [← hs]
  exact (physical_local_displacement_edge_observation C k cut j _ _ _
    (physical_fine_tag_edge j) _ _).symm

theorem physical_active_displacement_full_divisor (j : Fin n)
    (hcut : cut (4 * j.val + 2) = C j)
    (x : PhysicalFullBoundedState P J ell B) (hx : FullActiveInjective x)
    (a : PhysicalAuxLabels P (C j)) :
    physicalActiveDisplacement C k cut j (fun g => (x g).1) a =
      k j * (physicalFullSharedD (C j)
        (productActiveMemorySplit (fun g => physicalFullSharedIndices (C j g)) B x).1 a : ℤ) := by
  have hx' : ∀ g, Function.Injective (x g).1 := hx
  simp only [physicalActiveDisplacement, dif_pos hx', hcut]
  change k j * (physicalD (C j) (physicalFullStateLabels (C j) x hx) a : ℤ) = _
  have h := physical_full_shared_D_eq (C j) (physicalFullStateLabels (C j) x hx)
    (fun g => (x g).2) a
  rw [physical_full_state_encode_labels] at h
  rw [h]

end Local
end Bounty
end

section

/- The actual Mellin-shifted ideal frequency has a fixed polynomial envelope. -/

open Filter Real
namespace Bounty

theorem eventually_harmonic_mellin_frequency_bound (A R : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ a b v : ℝ,
      |a| ≤ L^A → |b| ≤ L^A → |v| ≤ L^R →
      |-(a+b+2*Real.pi*v)| ≤ L^(max A R+1) := by
  filter_upwards [eventually_ge_atTop (max 1 (2+2*Real.pi))] with L hL
  have hL1 : 1 ≤ L := (le_max_left _ _).trans hL
  have hL0 : 0 < L := zero_lt_one.trans_le hL1
  have hLC : 2+2*Real.pi ≤ L := (le_max_right _ _).trans hL
  have hA : L^A ≤ L^(max A R) := rpow_le_rpow_of_exponent_le hL1 (le_max_left _ _)
  have hR : L^R ≤ L^(max A R) := rpow_le_rpow_of_exponent_le hL1 (le_max_right _ _)
  intro a b v ha hb hv
  calc
    _ = |a+b+2*Real.pi*v| := abs_neg _
    _ ≤ |a|+|b|+|2*Real.pi*v| := (abs_add_le _ _).trans (add_le_add (abs_add_le _ _) le_rfl)
    _ = |a|+|b|+(2*Real.pi)*|v| := by rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 2*Real.pi)]
    _ ≤ L^(max A R)+L^(max A R)+(2*Real.pi)*L^(max A R) := by
      gcongr
      · exact ha.trans hA
      · exact hb.trans hA
      · exact hv.trans hR
    _ = (2+2*Real.pi)*L^(max A R) := by ring
    _ ≤ L*L^(max A R) := mul_le_mul_of_nonneg_right hLC (rpow_nonneg hL0.le _)
    _ = L^(max A R+1) := by
      nth_rw 1 [← rpow_one L]
      rw [← rpow_add hL0]
      congr 1
      ring

end Bounty
end

section

/- The common-window harmonic cell coefficient has mass bounded by endpoint energies. -/

open Finset Real
namespace Bounty

noncomputable def harmonicCellCoefficient (Y a b : ℝ) (d : ℕ) (δ : ℤ)
    (F G : ℤ → ℂ) (n : ℤ) : ℂ :=
  physicalPhase (-(a+b)) d *
    ((n : ℂ)⁻¹ * physicalPhase a n.natAbs * physicalPhase b (n+δ).natAbs *
      star ((harmonicCommonCutoff ((n : ℝ)/Y) : ℂ)*F n) *
      ((harmonicCommonCutoff (((n+δ : ℤ) : ℝ)/Y) : ℂ)*G (n+δ)))

theorem harmonic_cell_coefficient_mass_le_energy {Y : ℝ} (hY : 0 < Y)
    (a b : ℝ) (d : ℕ) (δ : ℤ) (F G : ℤ → ℂ) :
    (∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellCoefficient Y a b d δ F G n‖) ≤
      (8/Y)*sqrt (∑ n ∈ harmonicCommonSupport Y,
        ‖(harmonicCommonCutoff ((n : ℝ)/Y) : ℂ)*F n‖^2)*
      sqrt (∑ n ∈ harmonicCommonSupport Y,
        ‖(harmonicCommonCutoff (((n+δ : ℤ) : ℝ)/Y) : ℂ)*G (n+δ)‖^2) := by
  let θ : ℤ → ℂ := fun n =>
    physicalPhase (-(a+b)) d * physicalPhase a n.natAbs * physicalPhase b (n+δ).natAbs
  let f : ℤ → ℂ := fun n => (harmonicCommonCutoff ((n : ℝ)/Y) : ℂ)*F n
  let g : ℤ → ℂ := fun n => (harmonicCommonCutoff (((n+δ : ℤ) : ℝ)/Y) : ℂ)*G (n+δ)
  have hm := harmonic_coefficient_mass_le (harmonicCommonSupport Y) θ f g
    (div_pos hY (by norm_num : (0 : ℝ) < 8))
    (fun n hn => (mem_harmonic_common_support.mp hn).1)
    (by intro n _; simp only [θ, norm_mul, physical_phase_norm, one_mul, le_refl])
  have hscale : (1 : ℝ)/(Y/8) = 8/Y := by field_simp
  calc
    _ = ∑ n ∈ harmonicCommonSupport Y, ‖(θ n/(n : ℂ))*star (f n)*g n‖ := by
      apply sum_congr rfl
      intro n _
      congr 1
      dsimp only [harmonicCellCoefficient, θ, f, g]
      rw [div_eq_mul_inv]
      ring
    _ ≤ (1/(Y/8))*sqrt (∑ n ∈ harmonicCommonSupport Y, ‖f n‖^2)*
        sqrt (∑ n ∈ harmonicCommonSupport Y, ‖g n‖^2) := hm
    _ = _ := by rw [hscale]

end Bounty
end

section

/- Exact finite-circle interfaces for the common harmonic cell endpoints. -/

open Finset MeasureTheory
open scoped ComplexConjugate

namespace Bounty

theorem harmonic_cell_source_norm_le {Y : ℝ} (hY : 0 < Y)
    (Z a v : ℝ) (F : ℤ → ℂ) (n : ℤ) :
    ‖harmonicCellSource Y Z a v F n‖ ≤ 8 * ‖F n‖ :=
  harmonic_common_mellin_source_norm_le hY Z v a F n

theorem harmonic_cell_target_norm_le (Y b : ℝ) (G : ℤ → ℂ) (n : ℤ) :
    ‖harmonicCellTarget Y b G n‖ ≤ ‖G n‖ :=
  harmonic_common_phased_target_norm_le Y b G n

theorem harmonic_cell_source_zero_of_not_mem {Y : ℝ} (hY : 0 < Y)
    (Z a v : ℝ) (F : ℤ → ℂ) (n : ℤ) (hn : n ∉ harmonicCommonSupport Y) :
    harmonicCellSource Y Z a v F n = 0 := by
  apply harmonic_common_mellin_source_zero_of_not_mem hY Z v a F n
  intro hmem
  exact hn (mem_harmonic_common_support.mpr hmem)

theorem harmonic_cell_target_zero_of_not_mem {Y : ℝ} (hY : 0 < Y)
    (b : ℝ) (G : ℤ → ℂ) (n : ℤ) (hn : n ∉ harmonicCommonSupport Y) :
    harmonicCellTarget Y b G n = 0 := by
  apply harmonic_common_phased_target_zero_of_not_mem hY b G n
  intro hmem
  exact hn (mem_harmonic_common_support.mpr hmem)

theorem harmonic_cell_source_nonzero_mem {Y : ℝ} (hY : 0 < Y)
    (Z a v : ℝ) (F : ℤ → ℂ) (n : ℤ) (hn : harmonicCellSource Y Z a v F n ≠ 0) :
    n ∈ harmonicCommonSupport Y := by
  by_contra hnot
  exact hn (harmonic_cell_source_zero_of_not_mem hY Z a v F n hnot)

theorem harmonic_cell_target_nonzero_mem {Y : ℝ} (hY : 0 < Y)
    (b : ℝ) (G : ℤ → ℂ) (n : ℤ) (hn : harmonicCellTarget Y b G n ≠ 0) :
    n ∈ harmonicCommonSupport Y := by
  by_contra hnot
  exact hn (harmonic_cell_target_zero_of_not_mem hY b G n hnot)

theorem harmonic_cell_source_energy_le {Y : ℝ} (hY : 0 < Y)
    (Z a v : ℝ) (F : ℤ → ℂ) (S : Finset ℤ) :
    (∑ n ∈ S, ‖harmonicCellSource Y Z a v F n‖ ^ 2) ≤
      64 * ∑ n ∈ S, ‖F n‖ ^ 2 := by
  rw [mul_sum]
  apply sum_le_sum
  intro n hn
  have h := harmonic_cell_source_norm_le hY Z a v F n
  nlinarith [norm_nonneg (harmonicCellSource Y Z a v F n), norm_nonneg (F n)]

theorem harmonic_cell_target_energy_le (Y b : ℝ) (G : ℤ → ℂ) (S : Finset ℤ) :
    (∑ n ∈ S, ‖harmonicCellTarget Y b G n‖ ^ 2) ≤ ∑ n ∈ S, ‖G n‖ ^ 2 := by
  apply sum_le_sum
  intro n hn
  have h := harmonic_cell_target_norm_le Y b G n
  nlinarith [norm_nonneg (harmonicCellTarget Y b G n), norm_nonneg (G n)]

theorem harmonic_cell_pairing_eq_masked_sum {Y : ℝ} (hY : 0 < Y)
    (Z a b v : ℝ) (δ : ℤ) (F G : ℤ → ℂ) :
    harmonicCellPairing Y Z a b v δ F G =
      ∑ n ∈ harmonicCommonSupport Y,
        if n + δ ∈ harmonicCommonSupport Y then
          star (harmonicCellSource Y Z a v F n) * harmonicCellTarget Y b G (n + δ)
        else 0 := by
  unfold harmonicCellPairing
  apply sum_congr rfl
  intro n hn
  by_cases hmem : n + δ ∈ harmonicCommonSupport Y
  · rw [if_pos hmem]
  · rw [if_neg hmem, harmonic_cell_target_zero_of_not_mem hY b G (n + δ) hmem, mul_zero]

theorem harmonic_cell_pairing_eq_fourier {Y : ℝ} (hY : 0 < Y)
    (Z a b v : ℝ) (δ : ℤ) (F G : ℤ → ℂ) :
    harmonicCellPairing Y Z a b v δ F G =
      ∫ x in (0 : ℝ)..1,
        conj (finiteFourierSum (harmonicCommonSupport Y) (harmonicCellSource Y Z a v F) x) *
          finiteFourierSum (harmonicCommonSupport Y) (harmonicCellTarget Y b G) x *
          fourier (-δ) (x : AddCircle (1 : ℝ)) := by
  rw [harmonic_cell_pairing_eq_masked_sum hY]
  exact (finite_fourier_shift_correlation (harmonicCommonSupport Y) (harmonicCommonSupport Y)
    (harmonicCellSource Y Z a v F) (harmonicCellTarget Y b G) δ).symm

theorem harmonic_cell_weighted_pairing_eq_fourier {I : Type*}
    {Y : ℝ} (hY : 0 < Y) (Z a b v : ℝ) (F G : ℤ → ℂ)
    (A : Finset I) (c : I → ℂ) (δ : I → ℤ) :
    (∑ i ∈ A, c i * harmonicCellPairing Y Z a b v (δ i) F G) =
      ∫ x in (0 : ℝ)..1,
        conj (finiteFourierSum (harmonicCommonSupport Y) (harmonicCellSource Y Z a v F) x) *
          finiteFourierSum (harmonicCommonSupport Y) (harmonicCellTarget Y b G) x *
          (∑ i ∈ A, c i * fourier (-δ i) (x : AddCircle (1 : ℝ))) := by
  simp_rw [harmonic_cell_pairing_eq_masked_sum hY]
  exact finite_averaged_shift_fourier A c δ (harmonicCommonSupport Y) (harmonicCommonSupport Y)
    (harmonicCellSource Y Z a v F) (harmonicCellTarget Y b G)

end Bounty
end

section

/- Candidate inputs to the supported auxiliary-product Fourier estimate. -/

open Finset Filter
open scoped Classical
namespace Bounty

theorem exists_candidate_prime_multiplier_inputs {c : ℝ} (hc : 0 < c) (J : ℕ) :
    ∃ κ : ℝ, 0 ≤ κ ∧ ∀ q : ℝ, ∀ᶠ L : ℝ in atTop,
      512 ≤ L ∧ ∀ (S : Finset ℕ), S ⊆ candidatePIndices c L →
      let P := fun g : S => candidatePBand (c*L) g.val
      let V := fun g : S => ∑ p ∈ P g, 1/(p : ℝ)
      (∀ g, 0 < V g) ∧ ∀ (ell : ℕ) (probes : S → Finset (Fin J)) (r : Finset S)
        (A : Finset (RepeatedBigFlatIndex S J ell)),
        A ⊆ r.sigma (repeatedBigPrimeProbeSlots probes) → A.Nonempty →
        (∀ n : ℕ,
          (∑ a ∈ univ.filter (fun a : (∀ i : A, P i.val.1) => (∏ i, (a i).val) = n),
            finiteProductWeight (fun i : A => physicalLabelLaw V i.val.1) a) ≤ L^κ/(n : ℝ)) ∧
        ∀ U : ℕ, (∃ a : (∀ i : A, P i.val.1),
          U ≤ ∏ i, (a i).val ∧ (∏ i, (a i).val) < 2*U) →
          0 < U ∧ L^q ≤ (U : ℝ) ∧ Real.log (U : ℝ) ≤ L := by
  obtain ⟨κ, hκ, hatom⟩ := exists_candidate_subset_atom_inputs hc J
  refine ⟨κ, hκ, ?_⟩
  intro q
  filter_upwards [hatom, eventually_candidate_supported_dyad hc J q,
    eventually_ge_atTop (512 : ℝ)] with L ha hd hL
  refine ⟨hL, ?_⟩
  intro S hS P V
  refine ⟨(ha S hS).1, ?_⟩
  intro ell probes r A hA hne
  exact ⟨(ha S hS).2 ell probes r A hA, hd S hS ell probes r A hA hne⟩

end Bounty
end

section

/- An arbitrary selected weight passes from the actual recorded action to the
original full-path moment with its original trace and signed phase intact. -/

open Finset Classical
namespace Bounty

section Trace
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g (p : P g), NeZero p.val]
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => P g)
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → P g → ℝ) (q : Fin (n + 1) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
  (cut : ℕ → Fin N → Finset (Fin J))
  (w : PhysicalSelectedData P ell C → ℂ)
  [Fintype (PhysicalSelectedData P ell C)]

omit [∀ g (p : P g), NeZero p.val] in
theorem physical_original_weighted_trace_phase
    (x : PhysicalFullBoundedState P J ell B)
    (p : FullPermutationMixedPath (fun g (p : P g) => p.val)
      (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j))
      ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)) x) :
    fullMixedLedgerInducedPhase (fun g (p : P g) => p.val)
      (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j))
      ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)) fullActiveInitialLedger
      (physicalFullRecordedTracePhase C k ω β ρ V (physicalSelectedFineTag n) cut (4 * n + 1)
        (fun _ => []) (fun r _ => physicalSelectedDataRecordPhase C cut univ w r))
      x p =
    fullMixedLedgerInducedPhase (fun g (p : P g) => p.val)
      (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j))
      ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)) fullActiveInitialLedger
      (finiteEventLocalPhase (PhysicalFullLedgerEvent C k) (physicalFullLedgerEventTarget C k)
        (physicalFullLedgerEventPhase C k ω β ρ V)
        ((List.range (4 * n + 1)).map (physicalSelectedFineTag n))) x p *
      physicalSelectedDataRecordPhase C cut univ w
        (physicalOriginalFineRecord C k cut x p) := by
  let lift : FiniteEventPath (PhysicalFullLedgerEvent C k) (physicalFullLedgerEventTarget C k)
      ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)) (fullActiveInitialLedger x, x) :=
    (finiteLedgerEventPathEquiv
      (FullPermutationMixedEvent (fun g (p : P g) => p.val)
        (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
        (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j)))
      (fullPermutationMixedEventTarget (fun g (p : P g) => p.val)
        (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
        (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j)))
      (fullMixedLedgerUpdate (fun g (p : P g) => p.val)
        (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
        (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j)))
      ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)) (fullActiveInitialLedger x) x).symm p
  change physicalFullRecordedTracePhase C k ω β ρ V (physicalSelectedFineTag n) cut (4 * n + 1)
      (fun _ => []) (fun r _ => physicalSelectedDataRecordPhase C cut univ w r)
      (fullActiveInitialLedger x, x) lift =
    finiteEventLocalPhase (PhysicalFullLedgerEvent C k) (physicalFullLedgerEventTarget C k)
      (physicalFullLedgerEventPhase C k ω β ρ V)
      ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)) (fullActiveInitialLedger x, x) lift * _
  unfold physicalFullRecordedTracePhase
  rw [finite_recorded_schedule_phase_factor]
  rfl

theorem physical_original_weighted_moment_eq_trace_action
    (f : PhysicalFullBoundedState P J ell B → ℂ) (x : PhysicalFullBoundedState P J ell B) :
    physicalOriginalWeightedMoment C k ω β q ρ V cut w f x =
      fullMixedLedgerPathAction (fun g (p : P g) => p.val)
        (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
        (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j))
        ω (fun g p => β g p / V g) q ρ V
        ((List.range (4 * n + 1)).map (physicalSelectedFineTag n))
        (physicalFullRecordedTracePhase C k ω β ρ V (physicalSelectedFineTag n) cut (4 * n + 1)
          (fun _ => []) (fun r _ => physicalSelectedDataRecordPhase C cut univ w r))
        (fun s => f s.2) (fullActiveInitialLedger x, x) := by
  have he := congrFun (full_mixed_ledger_path_action_eq (fun g (p : P g) => p.val)
    (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
    (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j))
    ω (fun g p => β g p / V g) q ρ V
    ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)) fullActiveInitialLedger
    (physicalFullRecordedTracePhase C k ω β ρ V (physicalSelectedFineTag n) cut (4 * n + 1)
      (fun _ => []) (fun r _ => physicalSelectedDataRecordPhase C cut univ w r)) f) x
  rw [he]
  unfold physicalOriginalWeightedMoment fullPermutationMixedPathAction finiteEventPathAction
  apply sum_congr rfl
  intro p _
  dsimp only
  rw [physical_original_weighted_trace_phase]
  unfold physicalOriginalFineWeight
  ring

theorem physical_selected_record_action_eq_weighted_moment
    (hV : ∀ g, V g ≠ 0)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hencode : ∀ i, PhysicalMarkRowEncoding C (physicalSelectedFineTag n i) (cut i) (cut (i + 1)))
    (f : PhysicalFullBoundedState P J ell B → ℂ)
    (L : PhysicalMarkLists P J ell)
    (memory : ∀ g, BoundedOrderedTuple (UnrestrictedResidueParticle (fun p : P g => p.val)) B) :
    let x := physicalFullMemoryState (cut 0) L memory
    physicalSelectedRecordAction C k β V ρ hV ω q cut univ w
      f (L, fullActiveInitialLedger x, memory) =
      physicalOriginalWeightedMoment C k ω β q ρ V cut w f x := by
  intro x
  unfold physicalSelectedRecordAction
  rw [physical_recorded_mark_history_intertwines C k ω β q ρ V hV hP hdis
    (physicalSelectedFineTag n) cut hencode (fun _ => physicalFullTraceAppend C) (4 * n + 1)]
  have he := congrFun (physical_full_recorded_trace_rows_eq_paths C k ω β q ρ V
    (physicalSelectedFineTag n) cut (4 * n + 1) (fun _ => [])
    (fun r _ => physicalSelectedDataRecordPhase C cut univ w r)
    (fun s => f s.2)) (fullActiveInitialLedger x, x)
  exact he.trans (physical_original_weighted_moment_eq_trace_action C k ω β q ρ V cut w f x).symm

end Trace
end Bounty
end

section

/- Exact Mellin-polynomial factorization on the original common positive support. -/

open Finset MeasureTheory

namespace Bounty

private theorem source_natAbs_cast {n : ℤ} (hn : 0 < n) :
    (n.natAbs : ℝ) = (n : ℝ) := by
  simpa only [Int.cast_natCast] using
    congrArg (fun z : ℤ => (z : ℝ)) (Int.natAbs_of_nonneg hn.le)

private theorem source_phase_factorization {Y Z : ℝ} (hY : 0 < Y) (hZ : 0 < Z)
    (a v t u : ℝ) {n : ℤ} (hn : 0 < n) :
    physicalMellinPhase (-v) ((n : ℝ) / Z) * physicalPhase (-a) n.natAbs *
        physicalMellinPhase t (n : ℝ) * physicalMellinPhase (2 * Real.pi * u) ((n : ℝ) / Y) =
      physicalMellinPhase v Z * physicalMellinPhase (-2 * Real.pi * u) Y *
        physicalMellinPhase (t - a - v + 2 * Real.pi * u) (n : ℝ) := by
  have hnr : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  unfold physicalMellinPhase physicalPhase
  rw [source_natAbs_cast hn, Real.log_div hnr hZ.ne', Real.log_div hnr hY.ne']
  simp only [← Complex.exp_add]
  congr 1
  push_cast
  ring

private theorem source_cutoff_factorization {Y : ℝ} (hY : 0 < Y)
    (Z a v t : ℝ) (F : ℤ → ℂ) {n : ℤ} (hn : 0 < n) :
    harmonicCellSource Y Z a v F n * physicalMellinPhase t (n : ℝ) =
      (physicalMellinPhase (-v) ((n : ℝ) / Z) * physicalPhase (-a) n.natAbs *
        F n * physicalMellinPhase t (n : ℝ)) *
      ((harmonicCommonCutoff ((n : ℝ) / Y) / ((n : ℝ) / Y) : ℝ) : ℂ) := by
  have hnr : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  have hratio : (Y / (n : ℝ)) * harmonicCommonCutoff ((n : ℝ) / Y) =
      harmonicCommonCutoff ((n : ℝ) / Y) / ((n : ℝ) / Y) := by
    field_simp
  calc
    harmonicCellSource Y Z a v F n * physicalMellinPhase t (n : ℝ) =
      (((Y / (n : ℝ) : ℝ) : ℂ) * (harmonicCommonCutoff ((n : ℝ) / Y) : ℂ)) *
        (physicalMellinPhase (-v) ((n : ℝ) / Z) * physicalPhase (-a) n.natAbs *
          F n * physicalMellinPhase t (n : ℝ)) := by
      unfold harmonicCellSource physicalMellinSource
      ring
    _ = _ := by
      rw [← Complex.ofReal_mul, hratio]
      ring

theorem harmonic_source_polynomial_integrable (Y a v t : ℝ) (F : ℤ → ℂ) :
    Integrable (fun u : ℝ => harmonicSourceLogFourier u *
      physicalMellinPhase (-2 * Real.pi * u) Y *
      ∑ n ∈ harmonicCommonSupport Y,
        F n * physicalMellinPhase (t - a - v + 2 * Real.pi * u) (n : ℝ)) := by
  exact finite_mellin_sum_integrable (harmonicCommonSupport Y)
    (fun u => harmonicSourceLogFourier u * physicalMellinPhase (-2 * Real.pi * u) Y)
    (fun u => t - a - v + 2 * Real.pi * u)
    (physical_mellin_phase_integrable harmonicSourceLogFourier
      (fun u => -2 * Real.pi * u) harmonic_source_log_fourier_integrable (by fun_prop) Y)
    (by fun_prop) F (fun n => (n : ℝ))

theorem harmonic_source_polynomial_scaled_integrable (Y Z a v t : ℝ) (F : ℤ → ℂ) :
    Integrable (fun u : ℝ => physicalMellinPhase v Z *
      (harmonicSourceLogFourier u * physicalMellinPhase (-2 * Real.pi * u) Y *
        ∑ n ∈ harmonicCommonSupport Y,
          F n * physicalMellinPhase (t - a - v + 2 * Real.pi * u) (n : ℝ))) :=
  (harmonic_source_polynomial_integrable Y a v t F).const_mul _

theorem harmonic_cell_source_mellin_polynomial {Y Z : ℝ} (hY : 0 < Y) (hZ : 0 < Z)
    (a v t : ℝ) (F : ℤ → ℂ) :
    (∑ n ∈ harmonicCommonSupport Y,
      harmonicCellSource Y Z a v F n * physicalMellinPhase t (n : ℝ)) =
      physicalMellinPhase v Z * ∫ u : ℝ,
        harmonicSourceLogFourier u * physicalMellinPhase (-2 * Real.pi * u) Y *
          ∑ n ∈ harmonicCommonSupport Y,
            F n * physicalMellinPhase (t - a - v + 2 * Real.pi * u) (n : ℝ) := by
  let c : ℤ → ℂ := fun n => physicalMellinPhase (-v) ((n : ℝ) / Z) *
    physicalPhase (-a) n.natAbs * F n * physicalMellinPhase t (n : ℝ)
  have hpos : ∀ n ∈ harmonicCommonSupport Y, 0 < n :=
    fun n hn => harmonic_common_support_positive hY hn
  have hrep := finite_mellin_sum_representation (harmonicCommonSupport Y)
    harmonicSourceLogFourier (fun u => 2 * Real.pi * u)
    harmonic_source_log_fourier_integrable (by fun_prop) c (fun n => (n : ℝ) / Y)
    (fun x => ((harmonicCommonCutoff x / x : ℝ) : ℂ)) (by
      intro n hn _
      exact harmonic_source_cutoff_mellin_representation
        (div_pos (by exact_mod_cast hpos n hn) hY))
  calc
    (∑ n ∈ harmonicCommonSupport Y,
        harmonicCellSource Y Z a v F n * physicalMellinPhase t (n : ℝ)) =
      ∑ n ∈ harmonicCommonSupport Y,
        c n * ((harmonicCommonCutoff ((n : ℝ) / Y) / ((n : ℝ) / Y) : ℝ) : ℂ) := by
      apply sum_congr rfl
      intro n hn
      exact source_cutoff_factorization hY Z a v t F (hpos n hn)
    _ = ∫ u : ℝ, harmonicSourceLogFourier u * ∑ n ∈ harmonicCommonSupport Y,
        c n * physicalMellinPhase (2 * Real.pi * u) ((n : ℝ) / Y) := hrep
    _ = _ := by
      rw [← integral_const_mul]
      apply integral_congr_ae
      filter_upwards [] with u
      have hs : (∑ n ∈ harmonicCommonSupport Y,
          c n * physicalMellinPhase (2 * Real.pi * u) ((n : ℝ) / Y)) =
        ∑ n ∈ harmonicCommonSupport Y,
          (physicalMellinPhase v Z * physicalMellinPhase (-2 * Real.pi * u) Y) *
            (F n * physicalMellinPhase (t - a - v + 2 * Real.pi * u) (n : ℝ)) := by
        apply sum_congr rfl
        intro n hn
        have hp := source_phase_factorization hY hZ a v t u (hpos n hn)
        dsimp only [c]
        calc
          _ = F n * (physicalMellinPhase (-v) ((n : ℝ) / Z) * physicalPhase (-a) n.natAbs *
              physicalMellinPhase t (n : ℝ) * physicalMellinPhase (2 * Real.pi * u) ((n : ℝ) / Y)) := by ring
          _ = _ := by rw [hp]; ring
      rw [hs, ← mul_sum]
      ring

end Bounty
end

section

/- Total Fourier endpoint energies retain the actual common cutoff. -/

open Finset Real

namespace Bounty

theorem harmonic_cell_source_square_energy {Y : ℝ} (hY : 0 < Y)
    (Z a v : ℝ) (F : ℤ → ℂ) :
    (∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellSource Y Z a v F n‖^2) ≤
      64*∑ n ∈ harmonicCommonSupport Y, ‖(harmonicCommonCutoff ((n : ℝ)/Y) : ℂ)*F n‖^2 := by
  rw [mul_sum]
  apply sum_le_sum
  intro n hn
  have hlo := (mem_harmonic_common_support.mp hn).1
  have hn0 : (0 : ℝ) < n := (div_pos hY (by norm_num)).trans_le hlo
  have hr : Y/(n : ℝ) ≤ 8 := (div_le_iff₀ hn0).mpr (by linarith)
  have hnorm : ‖harmonicCellSource Y Z a v F n‖ ≤
      8*‖(harmonicCommonCutoff ((n : ℝ)/Y) : ℂ)*F n‖ := by
    rw [harmonicCellSource,physical_mellin_phased_source_norm,
      abs_of_nonneg (div_nonneg hY.le hn0.le)]
    exact mul_le_mul_of_nonneg_right hr (norm_nonneg _)
  have hsq := pow_le_pow_left₀ (norm_nonneg _) hnorm 2
  nlinarith only [hsq]

theorem harmonic_cell_target_square_energy (Y b : ℝ) (G : ℤ → ℂ) :
    (∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellTarget Y b G n‖^2) =
      ∑ n ∈ harmonicCommonSupport Y, ‖(harmonicCommonCutoff ((n : ℝ)/Y) : ℂ)*G n‖^2 := by
  simp only [harmonicCellTarget,norm_mul,physical_phase_norm,one_mul]

theorem harmonic_cell_fourier_energy_le_cutoff {Y : ℝ} (hY : 0 < Y)
    (Z a b v : ℝ) (F G : ℤ → ℂ) :
    (1/Y)*sqrt (∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellSource Y Z a v F n‖^2)*
        sqrt (∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellTarget Y b G n‖^2) ≤
      (8/Y)*sqrt (∑ n ∈ harmonicCommonSupport Y,
        ‖(harmonicCommonCutoff ((n : ℝ)/Y) : ℂ)*F n‖^2)*
        sqrt (∑ n ∈ harmonicCommonSupport Y,
          ‖(harmonicCommonCutoff ((n : ℝ)/Y) : ℂ)*G n‖^2) := by
  rw [harmonic_cell_target_square_energy]
  have hs := sqrt_le_sqrt (harmonic_cell_source_square_energy hY Z a v F)
  rw [sqrt_mul (by norm_num : (0 : ℝ) ≤ 64),show sqrt (64 : ℝ) = 8 by norm_num] at hs
  calc
    _ ≤ (1/Y)*(8*sqrt (∑ n ∈ harmonicCommonSupport Y,
        ‖(harmonicCommonCutoff ((n : ℝ)/Y) : ℂ)*F n‖^2))*
        sqrt (∑ n ∈ harmonicCommonSupport Y,
          ‖(harmonicCommonCutoff ((n : ℝ)/Y) : ℂ)*G n‖^2) := by gcongr
    _ = _ := by ring

end Bounty
end

section

/- The normalized harmonic source separates into genuine harmonic Mellin polynomials. -/

open Finset MeasureTheory

namespace Bounty

private theorem normalized_source_natAbs_cast {n : ℤ} (hn : 0 < n) :
    (n.natAbs : ℝ) = (n : ℝ) := by
  simpa only [Int.cast_natCast] using
    congrArg (fun z : ℤ => (z : ℝ)) (Int.natAbs_of_nonneg hn.le)

private theorem normalized_source_weight_eq (s x : ℝ) :
    harmonicMellinWeight s x = physicalMellinPhase s x / (x : ℂ) := by
  unfold harmonicMellinWeight physicalMellinPhase
  rw [mul_comm Complex.I]

private theorem normalized_source_phase_factorization {Y Z : ℝ}
    (hY : 0 < Y) (hZ : 0 < Z) (a v t u : ℝ) {n : ℤ} (hn : 0 < n) :
    physicalMellinPhase (-v) ((n : ℝ) / Z) * physicalPhase (-a) n.natAbs *
        physicalMellinPhase t (n : ℝ) * physicalMellinPhase (2 * Real.pi * u) ((n : ℝ) / Y) =
      physicalMellinPhase v Z * physicalMellinPhase (-2 * Real.pi * u) Y *
        physicalMellinPhase (t - a - v + 2 * Real.pi * u) (n : ℝ) := by
  have hnr : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  unfold physicalMellinPhase physicalPhase
  rw [normalized_source_natAbs_cast hn, Real.log_div hnr hZ.ne', Real.log_div hnr hY.ne']
  simp only [← Complex.exp_add]
  congr 1
  push_cast
  ring

private theorem normalized_source_cutoff_factorization {Y : ℝ} (hY : 0 < Y)
    (Z a v t : ℝ) (F : ℤ → ℂ) (n : ℤ) (hn : 0 < n) :
    (Y : ℂ)⁻¹ * (harmonicCellSource Y Z a v F n * physicalMellinPhase t (n : ℝ)) =
      (physicalMellinPhase (-v) ((n : ℝ) / Z) * physicalPhase (-a) n.natAbs *
        F n * physicalMellinPhase t (n : ℝ) / ((n : ℝ) : ℂ)) *
      (harmonicCommonCutoff ((n : ℝ) / Y) : ℂ) := by
  have hYC : (Y : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hY.ne'
  have hnC : (n : ℂ) ≠ 0 := by exact_mod_cast hn.ne'
  unfold harmonicCellSource physicalMellinSource
  push_cast
  field_simp

theorem harmonic_normalized_source_polynomial_integrable
    (Y a v t : ℝ) (F : ℤ → ℂ) :
    Integrable (fun u : ℝ => harmonicWindowLogFourier u *
      physicalMellinPhase (-2 * Real.pi * u) Y *
      ∑ n ∈ harmonicCommonSupport Y,
        F n * harmonicMellinWeight (t - a - v + 2 * Real.pi * u) (n : ℝ)) := by
  have hi := finite_mellin_sum_integrable (harmonicCommonSupport Y)
    (fun u => harmonicWindowLogFourier u * physicalMellinPhase (-2 * Real.pi * u) Y)
    (fun u => t - a - v + 2 * Real.pi * u)
    (physical_mellin_phase_integrable harmonicWindowLogFourier
      (fun u => -2 * Real.pi * u) harmonic_window_log_fourier_integrable (by fun_prop) Y)
    (by fun_prop) (fun n => F n / ((n : ℝ) : ℂ)) (fun n => (n : ℝ))
  apply hi.congr
  filter_upwards [] with u
  congr 1
  apply sum_congr rfl
  intro n _
  rw [normalized_source_weight_eq]
  ring

theorem harmonic_normalized_source_polynomial_scaled_integrable
    (Y Z a v t : ℝ) (F : ℤ → ℂ) :
    Integrable (fun u : ℝ => physicalMellinPhase v Z *
      (harmonicWindowLogFourier u * physicalMellinPhase (-2 * Real.pi * u) Y *
        ∑ n ∈ harmonicCommonSupport Y,
          F n * harmonicMellinWeight (t - a - v + 2 * Real.pi * u) (n : ℝ))) :=
  (harmonic_normalized_source_polynomial_integrable Y a v t F).const_mul _

theorem harmonic_normalized_cell_source_mellin_polynomial {Y Z : ℝ}
    (hY : 0 < Y) (hZ : 0 < Z) (a v t : ℝ) (F : ℤ → ℂ) :
    (Y : ℂ)⁻¹ * (∑ n ∈ harmonicCommonSupport Y,
      harmonicCellSource Y Z a v F n * physicalMellinPhase t (n : ℝ)) =
      physicalMellinPhase v Z * ∫ u : ℝ,
        harmonicWindowLogFourier u * physicalMellinPhase (-2 * Real.pi * u) Y *
          ∑ n ∈ harmonicCommonSupport Y,
            F n * harmonicMellinWeight (t - a - v + 2 * Real.pi * u) (n : ℝ) := by
  let c : ℤ → ℂ := fun n => physicalMellinPhase (-v) ((n : ℝ) / Z) *
    physicalPhase (-a) n.natAbs * F n * physicalMellinPhase t (n : ℝ) / ((n : ℝ) : ℂ)
  have hpos : ∀ n ∈ harmonicCommonSupport Y, 0 < n :=
    fun n hn => harmonic_common_support_positive hY hn
  have hrep := finite_mellin_sum_representation (harmonicCommonSupport Y)
    harmonicWindowLogFourier (fun u => 2 * Real.pi * u)
    harmonic_window_log_fourier_integrable (by fun_prop) c (fun n => (n : ℝ) / Y)
    (fun x => (harmonicCommonCutoff x : ℂ)) (by
      intro n hn _
      exact harmonic_window_cutoff_mellin_representation
        (div_pos (by exact_mod_cast hpos n hn) hY))
  calc
    _ = ∑ n ∈ harmonicCommonSupport Y,
        c n * (harmonicCommonCutoff ((n : ℝ) / Y) : ℂ) := by
      rw [mul_sum]
      apply sum_congr rfl
      intro n hn
      exact normalized_source_cutoff_factorization hY Z a v t F n (hpos n hn)
    _ = ∫ u : ℝ, harmonicWindowLogFourier u * ∑ n ∈ harmonicCommonSupport Y,
        c n * physicalMellinPhase (2 * Real.pi * u) ((n : ℝ) / Y) := hrep
    _ = _ := by
      rw [← integral_const_mul]
      apply integral_congr_ae
      filter_upwards [] with u
      have hs : (∑ n ∈ harmonicCommonSupport Y,
          c n * physicalMellinPhase (2 * Real.pi * u) ((n : ℝ) / Y)) =
        ∑ n ∈ harmonicCommonSupport Y,
          (physicalMellinPhase v Z * physicalMellinPhase (-2 * Real.pi * u) Y) *
            (F n * harmonicMellinWeight (t - a - v + 2 * Real.pi * u) (n : ℝ)) := by
        apply sum_congr rfl
        intro n hn
        have hp := normalized_source_phase_factorization hY hZ a v t u (hpos n hn)
        dsimp only [c]
        rw [normalized_source_weight_eq]
        calc
          _ = (F n / ((n : ℝ) : ℂ)) *
              (physicalMellinPhase (-v) ((n : ℝ) / Z) * physicalPhase (-a) n.natAbs *
                physicalMellinPhase t (n : ℝ) *
                  physicalMellinPhase (2 * Real.pi * u) ((n : ℝ) / Y)) := by ring
          _ = _ := by rw [hp]; ring
      rw [hs, ← mul_sum]
      ring

end Bounty
end

section

/- A common cell-scale major region controls the entire original multiplier. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_aux_fourier_cell_minor_bound
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (k : ℤ)
    (bA : (∀ i : A, P i.val.1) → ℂ) (bB : (∀ i : B, P i.val.1) → ℂ)
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1/(p : ℝ) = V g)
    (hA : ∀ a, ‖bA a‖ ≤ 1) (hB : ∀ b, ‖bB b‖ ≤ 1)
    (L κ q Rsave HA HB : ℝ) (hL : 512 ≤ L) (hq : 0 ≤ q)
    (hparam : 2*κ+2+2*(Rsave+3)+3 ≤ q) (hHA : 0 ≤ HA) (hHB : 0 ≤ HB)
    (hposA : ∀ a : (∀ i : A, P i.val.1), 0 < ∏ i, (a i).val)
    (hposB : ∀ b : (∀ i : B, P i.val.1), 0 < ∏ i, (b i).val)
    (hlargeA : ∀ a : (∀ i : A, P i.val.1), 2*L^q ≤ (∏ i, (a i).val : ℕ))
    (hlargeB : ∀ b : (∀ i : B, P i.val.1), 2*L^q ≤ (∏ i, (b i).val : ℕ))
    (hlogA : ∀ a : (∀ i : A, P i.val.1), Real.log (∏ i, (a i).val : ℕ) ≤ L)
    (hlogB : ∀ b : (∀ i : B, P i.val.1), Real.log (∏ i, (b i).val : ℕ) ≤ L)
    (hcellA : ∀ a, bA a ≠ 0 → HA ≤ (∏ i, (a i).val : ℕ))
    (hcellB : ∀ b, bB b ≠ 0 → HB ≤ (∏ i, (b i).val : ℕ))
    (hAtomA : ∀ n : ℕ,
      (∑ a ∈ univ.filter (fun a : (∀ i : A, P i.val.1) => (∏ i, (a i).val) = n),
        finiteProductWeight (fun i : A => physicalLabelLaw V i.val.1) a) ≤ L^κ/(n : ℝ))
    (hAtomB : ∀ n : ℕ,
      (∑ b ∈ univ.filter (fun b : (∀ i : B, P i.val.1) => (∏ i, (b i).val) = n),
        finiteProductWeight (fun i : B => physicalLabelLaw V i.val.1) b) ≤ L^κ/(n : ℝ)) :
    ∀ θ, θ ∉ productMajorArcSet k L (q+1) HA HB →
      ‖physicalAuxFourierMultiplier P V A B hU hAB k bA bB θ‖ ≤ L^(-Rsave) := by
  intro θ hminor
  let π := fun a : (∀ i : A, P i.val.1) => ∏ i, (a i).val
  let τ := fun b : (∀ i : B, P i.val.1) => ∏ i, (b i).val
  have hL0 : 0 < L := by linarith
  have hdyad (i j : ℕ) :
      ‖physicalAuxFourierMultiplier P V A B hU hAB k
        (finiteDyadicTest π i bA) (finiteDyadicTest τ j bB) θ‖ ≤ L^(-(Rsave+3)) := by
    by_cases hai : ∃ a, finiteDyadicTest π i bA a ≠ 0
    · by_cases hbj : ∃ b, finiteDyadicTest τ j bB b ≠ 0
      · obtain ⟨haL, halog⟩ := finite_dyadic_endpoint_scales π bA hposA
          (fun a _ => hlargeA a) hlogA hai
        obtain ⟨hbL, hblog⟩ := finite_dyadic_endpoint_scales τ bB hposB
          (fun b _ => hlargeB b) hlogB hbj
        have haCell : HA ≤ 2*((2^i : ℕ) : ℝ) := by
          obtain ⟨a, ha⟩ := hai
          have hr := (finite_dyadic_test_range π bA (fun a _ => hposA a) i a ha).2
          have hr' : (π a : ℝ) < 2*((2^i : ℕ) : ℝ) := by exact_mod_cast hr
          exact (hcellA a (finite_dyadic_test_ne_zero π bA ha)).trans hr'.le
        have hbCell : HB ≤ 2*((2^j : ℕ) : ℝ) := by
          obtain ⟨b, hb⟩ := hbj
          have hr := (finite_dyadic_test_range τ bB (fun b _ => hposB b) j b hb).2
          have hr' : (τ b : ℝ) < 2*((2^j : ℕ) : ℝ) := by exact_mod_cast hr
          exact (hcellB b (finite_dyadic_test_ne_zero τ bB hb)).trans hr'.le
        have hscale : HA*HB ≤ 4*(((2^i : ℕ) : ℝ)*((2^j : ℕ) : ℝ)) := by
          have hm := mul_le_mul haCell hbCell hHB (hHA.trans haCell)
          nlinarith
        apply physical_aux_fourier_minor_bound P V A B hU hAB k
          (finiteDyadicTest π i bA) (finiteDyadicTest τ j bB) hV hMass
          (finite_dyadic_test_norm_le_one π bA hA i)
          (finite_dyadic_test_norm_le_one τ bB hB j)
          (2^i) (2^j) (by positivity) (by positivity)
          (fun a ha => finite_dyadic_test_range π bA (fun a _ => hposA a) i a ha)
          (fun b hb => finite_dyadic_test_range τ bB (fun b _ => hposB b) j b hb)
          (C := L^κ) (D := L^κ) (by positivity) (by positivity) hAtomA hAtomB
          L κ 2 q (Rsave+3) hL (by norm_num) hq hparam le_rfl le_rfl haL hbL
          (supported_dyad_log_product (by linarith) (by positivity) (by positivity) halog hblog)
          θ
        exact fun hm => hminor (product_major_arc_cell_subset (by linarith) hscale k hm)
      · push Not at hbj
        rw [physical_aux_fourier_zero_right P V A B hU hAB k _ _ hbj θ, norm_zero]
        positivity
    · push Not at hai
      rw [physical_aux_fourier_zero_left P V A B hU hAB k _ _ hai θ, norm_zero]
      positivity
  have hcA := finite_dyadic_card_le_three_mul π hposA (by linarith) hlogA
  have hcB := finite_dyadic_card_le_three_mul τ hposB (by linarith) hlogB
  have hcube : L^(3 : ℝ) = L*L*L := by
    rw [show (3 : ℝ) = 2+1 by norm_num, Real.rpow_add hL0, Real.rpow_one, Real.rpow_two]
    ring
  rw [← physical_aux_fourier_dyadic_sum P V A B hU hAB k bA bB θ]
  calc
    _ ≤ ∑ i ∈ finiteDyadicIndices π, ∑ j ∈ finiteDyadicIndices τ,
        ‖physicalAuxFourierMultiplier P V A B hU hAB k
          (finiteDyadicTest π i bA) (finiteDyadicTest τ j bB) θ‖ :=
      (norm_sum_le _ _).trans (sum_le_sum (fun i _ => norm_sum_le _ _))
    _ ≤ ∑ _i ∈ finiteDyadicIndices π, ∑ _j ∈ finiteDyadicIndices τ, L^(-(Rsave+3)) :=
      sum_le_sum (fun i _ => sum_le_sum (fun j _ => hdyad i j))
    _ = ((finiteDyadicIndices π).card : ℝ)*(finiteDyadicIndices τ).card*L^(-(Rsave+3)) := by
      simp only [sum_const, nsmul_eq_mul]
      ring
    _ ≤ (3*L)*(3*L)*L^(-(Rsave+3)) := by gcongr
    _ ≤ L^(3 : ℝ)*L^(-(Rsave+3)) := by
      apply mul_le_mul_of_nonneg_right _ (by positivity)
      rw [hcube]
      nlinarith
    _ = L^(-Rsave) := by
      rw [← Real.rpow_add hL0]
      congr 1
      ring

end Bounty
end

