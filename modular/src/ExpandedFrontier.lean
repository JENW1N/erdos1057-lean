/- Finite character Parseval and the primitive multiplicative-to-additive transfer. -/

open Finset ZMod
open scoped ComplexConjugate

namespace Bounty

theorem character_conj_apply_unit {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) {b : ZMod q} (hb : IsUnit b) :
    conj (χ b) = χ b⁻¹ := by
  rw [← Complex.star_def, MulChar.star_apply', MulChar.inv_apply]
  rcases hb with ⟨u, rfl⟩
  rw [Ring.inverse_unit, ZMod.inv_coe_unit]

theorem character_parseval {q : ℕ} [NeZero q]
    (S : Finset (ZMod q)) (hS : ∀ k ∈ S, IsUnit k) (F : ZMod q → ℂ) :
    (∑ χ : DirichletCharacter ℂ q, ‖∑ k ∈ S, F k * χ k‖ ^ 2) =
      (q.totient : ℝ) * ∑ k ∈ S, ‖F k‖ ^ 2 := by
  classical
  have hnorm (z : ℂ) : conj z * z = ((‖z‖ ^ 2 : ℝ) : ℂ) := by
    rw [← Complex.normSq_eq_conj_mul_self, Complex.normSq_eq_norm_sq]
  have hexpand (χ : DirichletCharacter ℂ q) :
      conj (∑ k ∈ S, F k * χ k) * (∑ k ∈ S, F k * χ k) =
        ∑ k ∈ S, ∑ l ∈ S, (conj (F k) * F l) * (χ k⁻¹ * χ l) := by
    simp only [map_sum, map_mul, sum_mul, mul_sum]
    rw [sum_comm]
    apply sum_congr rfl
    intro k hk
    apply sum_congr rfl
    intro l hl
    rw [character_conj_apply_unit χ (hS k hk)]
    ring
  have hc :
      (∑ χ : DirichletCharacter ℂ q,
        conj (∑ k ∈ S, F k * χ k) * (∑ k ∈ S, F k * χ k)) =
        (q.totient : ℂ) * ∑ k ∈ S, conj (F k) * F k := by
    simp_rw [hexpand]
    rw [sum_comm]
    rw [mul_sum]
    apply sum_congr rfl
    intro k hk
    rw [sum_comm]
    simp_rw [← mul_sum, DirichletCharacter.sum_char_inv_mul_char_eq ℂ (hS k hk)]
    simp [hk, mul_comm]
  simp_rw [hnorm] at hc
  exact_mod_cast hc


theorem character_inverse_parseval {q : ℕ} [NeZero q]
    (S : Finset (ZMod q)) (hS : ∀ k ∈ S, IsUnit k) (F : ZMod q → ℂ) :
    (∑ χ : DirichletCharacter ℂ q, ‖∑ k ∈ S, F k * χ⁻¹ k‖ ^ 2) =
      (q.totient : ℝ) * ∑ k ∈ S, ‖F k‖ ^ 2 := by
  rw [← character_parseval S hS F]
  exact Fintype.sum_bijective _ inv_involutive.bijective _ _ (fun _ => rfl)

theorem character_transform_additive_sum {q : ℕ} [NeZero q]
    {ι : Type*} (T : Finset ι) (a : ι → ℂ) (v : ι → ZMod q)
    {χ : DirichletCharacter ℂ q} (hχ : χ.IsPrimitive) :
    (∑ k ∈ univ.filter IsUnit,
      (∑ t ∈ T, a t * stdAddChar (v t * k)) * χ k) =
      gaussSum χ stdAddChar * ∑ t ∈ T, a t * χ⁻¹ (v t) := by
  classical
  have hfull :
      (∑ k ∈ univ.filter IsUnit,
        (∑ t ∈ T, a t * stdAddChar (v t * k)) * χ k) =
      ∑ k : ZMod q, (∑ t ∈ T, a t * stdAddChar (v t * k)) * χ k := by
    apply sum_subset (filter_subset _ _)
    intro k _ hk
    have hk' : ¬IsUnit k := by simpa only [mem_filter, mem_univ, true_and] using hk
    rw [MulChar.map_nonunit χ hk', mul_zero]
  rw [hfull]
  simp_rw [sum_mul]
  rw [sum_comm, mul_sum]
  apply sum_congr rfl
  intro t ht
  have hg := gaussSum_mulShift_of_isPrimitive stdAddChar hχ (v t)
  simp only [gaussSum, AddChar.mulShift_apply] at hg
  calc
    (∑ k : ZMod q, a t * stdAddChar (v t * k) * χ k) =
        a t * ∑ k : ZMod q, χ k * stdAddChar (v t * k) := by
      rw [mul_sum]
      apply sum_congr rfl
      intro k _
      ring
    _ = gaussSum χ stdAddChar * (a t * χ⁻¹ (v t)) := by
      rw [hg]
      simp only [gaussSum]
      ring


noncomputable def primitiveCharacters (q : ℕ) : Finset (DirichletCharacter ℂ q) := by
  classical
  exact univ.filter (fun χ => χ.IsPrimitive)

theorem primitive_character_sum_sq_le_additive {q : ℕ} [NeZero q]
    {ι : Type*} (T : Finset ι) (a : ι → ℂ) (v : ι → ZMod q) :
    (q : ℝ) / q.totient *
      (∑ χ ∈ primitiveCharacters q,
        ‖∑ t ∈ T, a t * χ (v t)‖ ^ 2) ≤
      ∑ k ∈ univ.filter IsUnit, ‖∑ t ∈ T, a t * stdAddChar (v t * k)‖ ^ 2 := by
  classical
  unfold primitiveCharacters
  let F : ZMod q → ℂ := fun k => ∑ t ∈ T, a t * stdAddChar (v t * k)
  have hid (χ : DirichletCharacter ℂ q) (hχ : χ.IsPrimitive) :
      ‖∑ k ∈ univ.filter IsUnit, F k * χ⁻¹ k‖ ^ 2 =
        (q : ℝ) * ‖∑ t ∈ T, a t * χ (v t)‖ ^ 2 := by
    have hi : χ⁻¹.IsPrimitive := by
      simpa only [DirichletCharacter.isPrimitive_def, DirichletCharacter.conductor_inv] using hχ
    have ht := character_transform_additive_sum T a v hi
    simp only [inv_inv] at ht
    change ‖∑ k ∈ univ.filter IsUnit,
      (∑ t ∈ T, a t * stdAddChar (v t * k)) * χ⁻¹ k‖ ^ 2 = _
    rw [ht, norm_mul, mul_pow, primitive_gaussSum_norm_sq hi]
  have hle :
      (∑ χ ∈ univ.filter (fun χ : DirichletCharacter ℂ q => χ.IsPrimitive),
        ‖∑ k ∈ univ.filter IsUnit, F k * χ⁻¹ k‖ ^ 2) ≤
      ∑ χ : DirichletCharacter ℂ q, ‖∑ k ∈ univ.filter IsUnit, F k * χ⁻¹ k‖ ^ 2 :=
    sum_le_sum_of_subset_of_nonneg (filter_subset _ _) (fun χ _ _ => sq_nonneg _)
  rw [character_inverse_parseval _ (fun k hk => (mem_filter.mp hk).2) F] at hle
  have heq :
      (∑ χ ∈ univ.filter (fun χ : DirichletCharacter ℂ q => χ.IsPrimitive),
        ‖∑ k ∈ univ.filter IsUnit, F k * χ⁻¹ k‖ ^ 2) =
      (q : ℝ) * ∑ χ ∈ univ.filter (fun χ : DirichletCharacter ℂ q => χ.IsPrimitive),
        ‖∑ t ∈ T, a t * χ (v t)‖ ^ 2 := by
    rw [mul_sum]
    apply sum_congr rfl
    intro χ hχ
    exact hid χ (mem_filter.mp hχ).2
  rw [heq] at hle
  have hφ : (0 : ℝ) < q.totient := by
    exact_mod_cast Nat.totient_pos.mpr (NeZero.pos q)
  rw [div_mul_eq_mul_div, div_le_iff₀ hφ]
  simpa only [F, mul_comm] using hle


end Bounty
end

section

/- Exact small and large conductor decomposition of the candidate Type I mass. -/

open Finset

namespace Bounty

noncomputable def primitiveConductorNormTerm {Ω : Type*} (d f : ℕ)
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) : ℝ := by
  classical
  exact ∑ ψ ∈ (univ : Finset (DirichletCharacter ℂ f)).filter
    (fun ψ => ψ.IsPrimitive ∧ ψ ≠ 1),
    ‖∑ t ∈ T.filter (fun t => (value t).Coprime (d / f)),
      μ t * ψ (value t : ZMod f)‖

noncomputable def smallPrimitiveConductorNormSum {Ω : Type*} (d R : ℕ)
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) : ℝ :=
  ∑ f ∈ d.divisors.filter (fun f => 1 < f ∧ f ≤ R),
    primitiveConductorNormTerm d f T μ value

noncomputable def largePrimitiveConductorNormSum {Ω : Type*} (d R : ℕ)
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) : ℝ :=
  ∑ f ∈ d.divisors.filter (fun f => 1 < f ∧ R < f),
    primitiveConductorNormTerm d f T μ value

theorem primitive_conductor_norm_split {Ω : Type*} (d R : ℕ)
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) :
    typeIPrimitiveConductorNormSum d T μ value =
      smallPrimitiveConductorNormSum d R T μ value +
        largePrimitiveConductorNormSum d R T μ value := by
  classical
  have h := sum_filter_add_sum_filter_not (d.divisors.filter (fun f => 1 < f))
    (fun f => f ≤ R) (fun f => primitiveConductorNormTerm d f T μ value)
  simpa only [typeIPrimitiveConductorNormSum, smallPrimitiveConductorNormSum,
    largePrimitiveConductorNormSum, filter_filter, not_le,
    primitiveConductorNormTerm] using h.symm

theorem small_primitive_conductor_norm_nonneg {Ω : Type*} (d R : ℕ)
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) :
    0 ≤ smallPrimitiveConductorNormSum d R T μ value := by
  unfold smallPrimitiveConductorNormSum primitiveConductorNormTerm
  positivity

theorem large_primitive_conductor_norm_nonneg {Ω : Type*} (d R : ℕ)
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) :
    0 ≤ largePrimitiveConductorNormSum d R T μ value := by
  unfold largePrimitiveConductorNormSum primitiveConductorNormTerm
  positivity

noncomputable def candidateSmallPrimitiveTypeIMass (c L q : ℝ) (r jStar N R : ℕ) : ℝ :=
  ∑ d ∈ oddSquarefreeModuli N,
    smallPrimitiveConductorNormSum d R (arithmeticProductWindow 1 (Real.exp L))
      (fun u => (candidateCoefficient c L q r jStar u : ℂ)) (fun u => u) /
      (d.totient : ℝ)

noncomputable def candidateLargePrimitiveTypeIMass (c L q : ℝ) (r jStar N R : ℕ) : ℝ :=
  ∑ d ∈ oddSquarefreeModuli N,
    largePrimitiveConductorNormSum d R (arithmeticProductWindow 1 (Real.exp L))
      (fun u => (candidateCoefficient c L q r jStar u : ℂ)) (fun u => u) /
      (d.totient : ℝ)

theorem candidate_primitive_typeI_mass_split (c L q : ℝ) (r jStar N R : ℕ) :
    candidatePrimitiveTypeIMass c L q r jStar N =
      candidateSmallPrimitiveTypeIMass c L q r jStar N R +
        candidateLargePrimitiveTypeIMass c L q r jStar N R := by
  unfold candidatePrimitiveTypeIMass candidateSmallPrimitiveTypeIMass
    candidateLargePrimitiveTypeIMass
  simp_rw [primitive_conductor_norm_split (R := R), add_div]
  exact sum_add_distrib

theorem candidate_small_primitive_mass_le (c L q : ℝ) (r jStar N R : ℕ)
    (B : ℕ → ℝ) (hB : ∀ f ∈ Icc 2 R, 0 ≤ B f) {D : ℝ}
    (hD : 1 ≤ D) (hND : (N : ℝ) ≤ D)
    (hbound : ∀ d ∈ (Icc 1 N).filter Squarefree,
      ∀ f ∈ d.divisors.filter (fun f => 1 < f ∧ f ≤ R),
      ∀ ψ : DirichletCharacter ℂ f, ψ.IsPrimitive → ψ ≠ 1 →
        ‖∑ u ∈ (arithmeticProductWindow 1 (Real.exp L)).filter
          (fun u => u.Coprime (d / f)),
          (candidateCoefficient c L q r jStar u : ℂ) * ψ (u : ZMod f)‖ ≤ B f) :
    candidateSmallPrimitiveTypeIMass c L q r jStar N R ≤
      ((2 * primeEulerProductUpperConstant) * Real.log (2 * D)) *
        ∑ f ∈ Icc 2 R, B f := by
  classical
  have h := small_primitive_conductor_mass_le N R
    (arithmeticProductWindow 1 (Real.exp L))
    (fun u => (candidateCoefficient c L q r jStar u : ℂ)) (fun u => u)
    B hB hD hND hbound
  apply le_trans _ h
  change (∑ d ∈ oddSquarefreeModuli N, _) ≤ _
  apply sum_le_sum_of_subset_of_nonneg
  · intro d hd
    exact mem_filter.mpr ⟨(mem_filter.mp hd).1, (mem_filter.mp hd).2.1⟩
  · intro d _ _
    apply div_nonneg _ (Nat.cast_nonneg _)
    exact small_primitive_conductor_norm_nonneg d R _ _ _

end Bounty
end

section

/- Explicit disjoint rectangle layers for finite dyadic prefixes. -/

open Finset

namespace Bounty

def shiftPrefixRectangle {α : Type*} (L : ℕ) (r : Finset α × Finset ℕ) :
    Finset α × Finset ℕ := (r.1, r.2.image (fun n => n + L))

noncomputable def dyadicPrefixLayer {α : Type*} (K d : ℕ)
    (M : Finset α) (κ : α → ℕ) : List (Finset α × Finset ℕ) := by
  classical
  exact match K, d with
  | 0, 0 => [(M.filter (fun m => 0 < κ m), {0})]
  | 0, _ + 1 => []
  | K + 1, 0 => [(M.filter (fun m => 2 ^ K ≤ κ m), range (2 ^ K))]
  | K + 1, d + 1 =>
      dyadicPrefixLayer K d (M.filter (fun m => κ m < 2 ^ K)) κ ++
        (dyadicPrefixLayer K d (M.filter (fun m => 2 ^ K ≤ κ m))
          (fun m => κ m - 2 ^ K)).map (shiftPrefixRectangle (2 ^ K))

theorem dyadicPrefixLayer_bounds {α : Type*} (K d : ℕ)
    (M : Finset α) (κ : α → ℕ) :
    ∀ r ∈ dyadicPrefixLayer K d M κ, r.1 ⊆ M ∧ r.2 ⊆ range (2 ^ K) := by
  classical
  induction K generalizing d M κ with
  | zero =>
    cases d with
    | zero => simp [dyadicPrefixLayer]
    | succ d => simp [dyadicPrefixLayer]
  | succ K ih =>
    cases d with
    | zero =>
      intro r hr
      simp only [dyadicPrefixLayer, List.mem_singleton] at hr
      subst r
      exact ⟨filter_subset _ _, range_mono (by simp only [pow_succ]; omega)⟩
    | succ d =>
      intro r hr
      simp only [dyadicPrefixLayer, List.mem_append, List.mem_map] at hr
      rcases hr with hl | ⟨r', hr', rfl⟩
      · obtain ⟨hm, hn⟩ := ih d _ κ r hl
        exact ⟨hm.trans (filter_subset _ _), hn.trans (range_mono (by simp only [pow_succ]; omega))⟩
      · obtain ⟨hm, hn⟩ := ih d _ (fun m => κ m - 2 ^ K) r' hr'
        refine ⟨hm.trans (filter_subset _ _), ?_⟩
        intro n hn'
        obtain ⟨k, hk, rfl⟩ := mem_image.mp hn'
        have hk' := mem_range.mp (hn hk)
        simp only [mem_range, pow_succ]
        omega

theorem dyadicPrefixLayer_pairwise {α : Type*} (K d : ℕ)
    (M : Finset α) (κ : α → ℕ) :
    (dyadicPrefixLayer K d M κ).Pairwise (fun r s =>
      Disjoint r.1 s.1 ∧ Disjoint r.2 s.2) := by
  classical
  induction K generalizing d M κ with
  | zero => cases d <;> simp [dyadicPrefixLayer]
  | succ K ih =>
    cases d with
    | zero => simp [dyadicPrefixLayer]
    | succ d =>
      rw [dyadicPrefixLayer, List.pairwise_append]
      refine ⟨ih d _ _, ?_, ?_⟩
      · rw [List.pairwise_map]
        apply (ih d _ _).imp
        intro r s hrs
        exact ⟨hrs.1, (Finset.disjoint_image (fun a b h => Nat.add_right_cancel h)).mpr hrs.2⟩
      · intro r hr s hs
        obtain ⟨s', hs', rfl⟩ := List.mem_map.mp hs
        obtain ⟨hrM, hrN⟩ := dyadicPrefixLayer_bounds K d _ κ r hr
        obtain ⟨hsM, hsN⟩ := dyadicPrefixLayer_bounds K d _
          (fun m => κ m - 2 ^ K) s' hs'
        constructor
        · apply disjoint_left.mpr
          intro m hm hm'
          have h₁ := (mem_filter.mp (hrM hm)).2
          have h₂ := (mem_filter.mp (hsM hm')).2
          omega
        · apply disjoint_left.mpr
          intro n hn hn'
          have h₁ := mem_range.mp (hrN hn)
          obtain ⟨k, hk, hkn⟩ := mem_image.mp hn'
          omega


def prefixRectangleSum {α E : Type*} [AddCommMonoid E]
    (w : α → ℕ → E) (r : Finset α × Finset ℕ) : E :=
  ∑ m ∈ r.1, ∑ n ∈ r.2, w m n

def prefixLayerSum {α E : Type*} [AddCommMonoid E]
    (w : α → ℕ → E) (L : List (Finset α × Finset ℕ)) : E :=
  (L.map (prefixRectangleSum w)).sum

theorem prefixRectangleSum_shift {α E : Type*} [AddCommMonoid E]
    (w : α → ℕ → E) (L : ℕ) (r : Finset α × Finset ℕ) :
    prefixRectangleSum w (shiftPrefixRectangle L r) =
      prefixRectangleSum (fun m n => w m (n + L)) r := by
  unfold prefixRectangleSum shiftPrefixRectangle
  apply sum_congr rfl
  intro m hm
  exact sum_image (fun a _ b _ h => Nat.add_right_cancel h)

theorem prefixLayerSum_append {α E : Type*} [AddCommMonoid E]
    (w : α → ℕ → E) (L R : List (Finset α × Finset ℕ)) :
    prefixLayerSum w (L ++ R) = prefixLayerSum w L + prefixLayerSum w R := by
  simp only [prefixLayerSum, List.map_append, List.sum_append]

theorem prefixLayerSum_shift {α E : Type*} [AddCommMonoid E]
    (w : α → ℕ → E) (N : ℕ) (L : List (Finset α × Finset ℕ)) :
    prefixLayerSum w (L.map (shiftPrefixRectangle N)) =
      prefixLayerSum (fun m n => w m (n + N)) L := by
  simp only [prefixLayerSum, List.map_map, Function.comp_def, prefixRectangleSum_shift]

private theorem prefix_sum_split {α E : Type*} [AddCommMonoid E]
    (M : Finset α) (κ : α → ℕ) (L : ℕ) (w : α → ℕ → E) :
    (∑ m ∈ M, ∑ n ∈ range (κ m), w m n) =
      prefixRectangleSum w (M.filter (fun m => L ≤ κ m), range L) +
      (∑ m ∈ M.filter (fun m => κ m < L), ∑ n ∈ range (κ m), w m n) +
      (∑ m ∈ M.filter (fun m => L ≤ κ m),
        ∑ n ∈ range (κ m - L), w m (n + L)) := by
  classical
  have hpart := sum_filter_add_sum_filter_not M (fun m => κ m < L)
    (fun m => ∑ n ∈ range (κ m), w m n)
  simp only [not_lt] at hpart
  rw [← hpart]
  have hright : (∑ m ∈ M.filter (fun m => L ≤ κ m),
      ∑ n ∈ range (κ m), w m n) =
      prefixRectangleSum w (M.filter (fun m => L ≤ κ m), range L) +
      ∑ m ∈ M.filter (fun m => L ≤ κ m),
        ∑ n ∈ range (κ m - L), w m (n + L) := by
    rw [prefixRectangleSum, ← sum_add_distrib]
    apply sum_congr rfl
    intro m hm
    have hLm := (mem_filter.mp hm).2
    nth_rw 1 [← Nat.add_sub_of_le hLm]
    rw [sum_range_add]
    simp only [Nat.add_comm]
  rw [hright]
  ac_rfl

theorem dyadicPrefixLayer_weighted_sum {α E : Type*} [AddCommMonoid E]
    (K : ℕ) (M : Finset α) (κ : α → ℕ)
    (hκ : ∀ m ∈ M, κ m ≤ 2 ^ K) (w : α → ℕ → E) :
    (∑ m ∈ M, ∑ n ∈ range (κ m), w m n) =
      ∑ d ∈ range (K + 1), prefixLayerSum w (dyadicPrefixLayer K d M κ) := by
  classical
  induction K generalizing M κ w with
  | zero =>
    simp only [zero_add, sum_range_one, dyadicPrefixLayer, prefixLayerSum,
      List.map_singleton, List.sum_singleton, prefixRectangleSum, sum_singleton]
    rw [sum_filter]
    apply sum_congr rfl
    intro m hm
    have h := hκ m hm
    simp only [pow_zero] at h
    by_cases hm' : 0 < κ m
    · have hk : κ m = 1 := by omega
      simp [hk]
    · have hk : κ m = 0 := by omega
      simp [hk]
  | succ K ih =>
    have hleft : ∀ m ∈ M.filter (fun m => κ m < 2 ^ K), κ m ≤ 2 ^ K := by
      intro m hm
      exact Nat.le_of_lt (mem_filter.mp hm).2
    have hright : ∀ m ∈ M.filter (fun m => 2 ^ K ≤ κ m), κ m - 2 ^ K ≤ 2 ^ K := by
      intro m hm
      have h := hκ m (mem_filter.mp hm).1
      simp only [pow_succ] at h
      omega
    rw [prefix_sum_split M κ (2 ^ K) w]
    rw [ih _ _ hleft w, ih _ _ hright (fun m n => w m (n + 2 ^ K))]
    conv_rhs => rw [sum_range_succ']
    simp only [dyadicPrefixLayer, prefixLayerSum_append, prefixLayerSum_shift]
    simp only [prefixLayerSum, List.map_singleton, List.sum_singleton]
    rw [sum_add_distrib]
    ac_rfl


theorem dyadicPrefixLayer_eq_nil {α : Type*} (K d : ℕ)
    (M : Finset α) (κ : α → ℕ) (hd : K < d) :
    dyadicPrefixLayer K d M κ = [] := by
  classical
  induction K generalizing d M κ with
  | zero => cases d <;> simp_all [dyadicPrefixLayer]
  | succ K ih =>
    cases d with
    | zero => omega
    | succ d =>
      simp only [dyadicPrefixLayer, ih d _ _ (by omega), List.map_nil, List.append_nil]

theorem prefixRectangleSum_mul {α E : Type*} [Semiring E]
    (a : α → E) (b : ℕ → E) (r : Finset α × Finset ℕ) :
    prefixRectangleSum (fun m n => a m * b n) r =
      (∑ m ∈ r.1, a m) * ∑ n ∈ r.2, b n := by
  simp only [prefixRectangleSum, ← mul_sum, ← sum_mul]


end Bounty
end

section

/- Exponential individual-character savings for a fixed positive prime-band exponent. -/

open Finset Filter

namespace Bounty

theorem eventually_prime_profile_exponential {c : ℝ} (hc : 0 < c) (C D : ℝ) :
    ∀ᶠ L : ℝ in atTop,
      C * Real.exp (-(c / 32) * L) + D * L * Real.exp (-c * L) ≤
        Real.exp (-(c / 64) * L) := by
  have hsmall : 0 < c / 64 := div_pos hc (by norm_num)
  have hlarge : 0 < 63 * c / 64 := by positivity
  filter_upwards [eventually_linear_exponential_profile_le_rpow hsmall hlarge C D 0] with L hL
  simp only [neg_zero, Real.rpow_zero] at hL
  have hx : Real.exp (-(c / 64) * L) * Real.exp (-(c / 64) * L) =
      Real.exp (-(c / 32) * L) := by rw [← Real.exp_add]; congr 1; ring
  have hy : Real.exp (-(63 * c / 64) * L) * Real.exp (-(c / 64) * L) =
      Real.exp (-c * L) := by rw [← Real.exp_add]; congr 1; ring
  calc
    _ = (C * Real.exp (-(c / 64) * L) +
        D * L * Real.exp (-(63 * c / 64) * L)) * Real.exp (-(c / 64) * L) := by
      rw [add_mul, mul_assoc C, mul_assoc (D * L), hx, hy]
    _ ≤ 1 * Real.exp (-(c / 64) * L) :=
      mul_le_mul_of_nonneg_right hL (Real.exp_nonneg _)
    _ = _ := one_mul _

theorem eventually_prime_band_coprime_relative_exponential_bound
    (hZ : PrimitiveZeroFreeHalfPlane) {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (f : ℕ), 0 < f → (f : ℝ) ≤ Real.exp L →
      ∀ χ : DirichletCharacter ℂ f, χ ≠ 1 →
      ∀ b t U V : ℝ, 0 ≤ b → 0 < t → 0 ≤ U → 0 ≤ V →
      ∀ m : ℕ, m ≠ 0 → (m : ℝ) ≤ Real.exp L →
        ‖∑ p ∈ ((primeBand (Real.exp (c * L)) b).filter
          (fun p : ℕ => U < t * (p : ℝ) ∧ t * (p : ℝ) ≤ V)).filter
            (fun p => p.Coprime m), χ (p : ZMod f)‖ ≤
          (V / t) * Real.exp (-(c / 64) * L) := by
  obtain ⟨C, hC, hbound⟩ := ordinary_prime_band_product_coprime_relative_bound hZ
  have hlarge : ∀ᶠ L : ℝ in atTop, (2 : ℝ) ≤ Real.exp (c * L) :=
    (Real.tendsto_exp_atTop.comp (tendsto_id.const_mul_atTop hc)).eventually_ge_atTop 2
  filter_upwards [eventually_prime_profile_exponential hc
    (2 * C * (1 + 1 / c)) (1 / Real.log 2),
    hlarge, eventually_gt_atTop (0 : ℝ)] with L hdecay hlarge hL
  intro f hf hfL χ hχ b t U V hb ht hU hV m hm hmL
  apply (hbound f hf χ hχ (Real.exp (c * L)) b t U V hlarge hb ht hU hV m hm).trans
  apply mul_le_mul_of_nonneg_left _ (div_nonneg hV ht.le)
  exact (prime_coprime_relative_profile_bound hc hL hC.le hf hfL hm hmL).trans hdecay

end Bounty
end

section

/- Exact supported/free convolution with arbitrary complex tests on the product. -/

open Finset

namespace Bounty

theorem supported_free_window_complex_test_eq (P S : Finset ℕ)
    (a b W : ℕ → ℝ) (F : ℕ → ℂ) (X : ℝ)
    (hS : ∀ p ∈ S, p ∈ Nat.factoredNumbers P)
    (hb : ∀ n, b n ≠ 0 → n ≠ 0 ∧ Disjoint n.primeFactors P)
    (hprod : ∀ p ∈ S, ∀ n, b n ≠ 0 → W (p*n) = a p*b n)
    (hcovered : ∀ u ∈ arithmeticProductWindow 1 X, W u ≠ 0 →
      ∃ p ∈ S, ∃ n ∈ arithmeticProductWindow p X, b n ≠ 0 ∧ p*n = u) :
    (∑ p ∈ S, (a p : ℂ) * ∑ n ∈ arithmeticProductWindow p X, (b n : ℂ)*F (p*n)) =
      ∑ u ∈ arithmeticProductWindow 1 X, (W u : ℂ)*F u := by
  classical
  let T : Finset (Σ _p : ℕ, ℕ) :=
    S.sigma (fun p => (arithmeticProductWindow p X).filter (fun n => b n ≠ 0))
  let f : (Σ _p : ℕ, ℕ) → ℕ := fun z => z.1*z.2
  have hinj : Set.InjOn f T := by
    intro x hx y hy hxy
    have hx' := mem_sigma.mp hx
    have hy' := mem_sigma.mp hy
    have hbx := hb x.2 (mem_filter.mp hx'.2).2
    have hby := hb y.2 (mem_filter.mp hy'.2).2
    obtain ⟨hp, hn⟩ := supported_free_product_unique
      (hS x.1 hx'.1) hbx.1 hbx.2 (hS y.1 hy'.1) hby.1 hby.2 hxy
    exact Sigma.ext hp (heq_of_eq hn)
  have hsubset : T.image f ⊆ arithmeticProductWindow 1 X := by
    intro u hu
    obtain ⟨z, hz, rfl⟩ := mem_image.mp hu
    have hz' := mem_sigma.mp hz
    have hwindow := (mem_filter.mp hz'.2).1
    have hp0 := Nat.ne_zero_of_mem_factoredNumbers (hS z.1 hz'.1)
    have hrange := (mem_arithmeticProductWindow_iff hp0 X).mp hwindow
    apply (mem_arithmeticProductWindow_iff one_ne_zero X).mpr
    simpa only [one_mul, f] using hrange
  calc
    _ = ∑ z ∈ T, (W (f z) : ℂ)*F (f z) := by
      dsimp only [T, f]
      rw [sum_sigma]
      apply sum_congr rfl
      intro p hp
      rw [mul_sum, sum_filter]
      apply sum_congr rfl
      intro n _
      by_cases hbn : b n = 0
      · simp only [hbn, Complex.ofReal_zero, zero_mul, mul_zero, ne_eq, not_true_eq_false, if_false]
      · rw [if_pos hbn, hprod p hp n hbn, Complex.ofReal_mul]
        ring
    _ = ∑ u ∈ T.image f, (W u : ℂ)*F u := (sum_image (f := fun u => (W u : ℂ)*F u) hinj).symm
    _ = _ := by
      apply sum_subset hsubset
      intro u hu hnot
      have hWu : W u = 0 := by
        by_contra hWu
        obtain ⟨p, hp, n, hn, hbn, hpn⟩ := hcovered u hu hWu
        exact hnot (mem_image.mpr
          ⟨⟨p, n⟩, mem_sigma.mpr ⟨hp, mem_filter.mpr ⟨hn, hbn⟩⟩, hpn⟩)
      simp only [hWu, Complex.ofReal_zero, zero_mul]

end Bounty

end

section

/- Complex tests of ordered slot weights and exact extraction of one slot. -/

open Finset

namespace Bounty

theorem ordered_slot_complex_window_sum {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (normalization : ℝ) (S : Finset ℕ) (F : ℕ → ℂ) :
    (∑ n ∈ S, (orderedSlotWeight choices normalization n : ℂ) * F n) =
      ∑ x : ∀ i, choices i, if orderedSlotProduct choices x ∈ S then
        (1 / (normalization : ℂ)) * F (orderedSlotProduct choices x) else 0 := by
  classical
  simp only [orderedSlotWeight, Complex.ofReal_sum, apply_ite,
    Complex.ofReal_div, Complex.ofReal_one, Complex.ofReal_zero, sum_mul]
  rw [sum_comm]
  apply sum_congr
  · ext x
    simp
  · intro x _
    simp only [ite_mul, zero_mul]
    simp

theorem ordered_slot_complex_test_split {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (i : I) (F : ℕ → ℂ) :
    (∑ x : ∀ j, choices j, F (orderedSlotProduct choices x)) =
      ∑ p : choices i, ∑ y : ∀ j : {j : I // j ≠ i}, choices j.val,
        F (p.val * orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y) := by
  classical
  let f : choices i × (∀ j : {j : I // j ≠ i}, choices j.val) → ℂ := fun z =>
    F (z.1.val * orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) z.2)
  calc
    _ = ∑ z, f z := by
      apply Fintype.sum_equiv (Equiv.piSplitAt i (fun j => choices j))
      intro x
      simp only [f, Equiv.piSplitAt_apply]
      rw [ordered_slot_product_split choices i x]
    _ = _ := Fintype.sum_prod_type f

theorem ordered_slot_complex_window_split {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (i : I) (normalization : ℝ) (S : Finset ℕ) (F : ℕ → ℂ) :
    (∑ n ∈ S, (orderedSlotWeight choices normalization n : ℂ) * F n) =
      ∑ p : choices i, ∑ y : ∀ j : {j : I // j ≠ i}, choices j.val,
        if p.val * orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y ∈ S then
          (1 / (normalization : ℂ)) *
            F (p.val * orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y) else 0 := by
  rw [ordered_slot_complex_window_sum]
  exact ordered_slot_complex_test_split choices i
    (fun n => if n ∈ S then (1 / (normalization : ℂ)) * F n else 0)

end Bounty

end

section

/- Harmonic summation of relative bounds for finite prime-character sums. -/

open Finset

namespace Bounty

theorem indexed_prime_character_mass_bound {T : Type*} [Fintype T]
    (S : Finset ℕ) (W : ℕ → ℝ) (R : T → ℕ) (N X H : ℝ)
    (C : ℕ → T → ℂ) (hN : 0 ≤ N) (hW : ∀ n ∈ S, 0 ≤ W n)
    (hbound : ∀ n ∈ S, ∀ t : T, ‖C n t‖ ≤ (X / ((n * R t : ℕ) : ℝ)) * H) :
    ‖∑ n ∈ S, ∑ t : T, ((W n / N : ℝ) : ℂ) * C n t‖ ≤
      X * H * (∑ n ∈ S, W n / (n : ℝ)) *
        (∑ t : T, (1 / (R t : ℝ)) / N) := by
  calc
    _ ≤ ∑ n ∈ S, ∑ t : T, ‖((W n / N : ℝ) : ℂ) * C n t‖ := by
      apply (norm_sum_le _ _).trans
      apply sum_le_sum
      intro n _
      exact norm_sum_le _ _
    _ = ∑ n ∈ S, ∑ t : T, (W n / N) * ‖C n t‖ := by
      apply sum_congr rfl
      intro n hn
      apply sum_congr rfl
      intro t _
      rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (div_nonneg (hW n hn) hN)]
    _ ≤ ∑ n ∈ S, ∑ t : T, (W n / N) * ((X / ((n * R t : ℕ) : ℝ)) * H) := by
      apply sum_le_sum
      intro n hn
      apply sum_le_sum
      intro t _
      exact mul_le_mul_of_nonneg_left (hbound n hn t) (div_nonneg (hW n hn) hN)
    _ = _ := by
      symm
      simp only [mul_sum, sum_mul]
      rw [sum_comm]
      apply sum_congr rfl
      intro n _
      apply sum_congr rfl
      intro t _
      simp only [Nat.cast_mul, div_eq_mul_inv, mul_inv]
      ring

end Bounty

end

section

/- Actual kernel pairings vanish when a probe meets an omitted coordinate. -/

open Finset
open scoped Classical

namespace Bounty

theorem clean_kernel_component_zero_left {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] {Y : Type*} [Fintype Y]
    (μ : ∀ i, X i → ℝ) (hmass : ∀ i, ∑ v, μ i v = 1)
    (U S : Finset I) (hS : S ⊆ U) (i : I) (hiS : i ∈ S)
    (K : (∀ i, X i) → Y → ℂ) (f : (∀ i, X i) → ℂ) (g : Y → ℂ)
    (hK : ∀ x y v, K (Function.update x i v) y = K x y) :
    cleanKernelPairing (finiteProductWeight μ) K
      (finiteCoordinateComponent μ S U.toList f) g = 0 := by
  have hzero := finite_probe_component_pairing_zero_left μ hmass U S hS i hiS f
    (fun x => ∑ y, K x y * g y) (by
      intro x v
      apply sum_congr rfl
      intro y _
      rw [hK])
  simpa only [cleanKernelPairing, mul_sum, mul_assoc] using hzero

theorem clean_kernel_component_zero_right {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] {Y : Type*} [Fintype Y]
    (μ : ∀ i, X i → ℝ) (hmass : ∀ i, ∑ v, μ i v = 1)
    (V T : Finset I) (hT : T ⊆ V) (i : I) (hiT : i ∈ T)
    (w : Y → ℝ) (H : Y → (∀ i, X i) → ℂ) (f : Y → ℂ) (g : (∀ i, X i) → ℂ)
    (hH : ∀ x y v, H x (Function.update y i v) = H x y) :
    cleanKernelPairing w (fun x y => (finiteProductWeight μ y : ℂ) * H x y)
      f (finiteCoordinateComponent μ T V.toList g) = 0 := by
  unfold cleanKernelPairing
  apply sum_eq_zero
  intro x _
  have hzero : (∑ y, (finiteProductWeight μ y : ℂ) *
      (H x y * finiteCoordinateComponent μ T V.toList g y)) = 0 := by
    simpa using finite_probe_component_pairing_zero_right μ hmass V T hT i hiT g
      (fun y => (starRingEnd ℂ) (H x y)) (by
        intro y v
        rw [hH])
  calc
    _ = ((w x : ℂ) * (starRingEnd ℂ) (f x)) *
        ∑ y, (finiteProductWeight μ y : ℂ) *
          (H x y * finiteCoordinateComponent μ T V.toList g y) := by
      rw [mul_sum]
      apply sum_congr rfl
      intro y _
      ring
    _ = 0 := by rw [hzero, mul_zero]

theorem clean_kernel_components_zero_of_not_admissible
    {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)]
    (μ : ∀ i, X i → ℝ) (hmass : ∀ i, ∑ v, μ i v = 1)
    (U V S T A B : Finset I) (hS : S ⊆ U) (hT : T ⊆ V)
    (hA : A ⊆ U) (hB : B ⊆ V)
    (H : (∀ i, X i) → (∀ i, X i) → ℂ) (f g : (∀ i, X i) → ℂ)
    (hleft : ∀ i ∈ A, ∀ x y v, H (Function.update x i v) y = H x y)
    (hright : ∀ i ∈ B, ∀ x y v, H x (Function.update y i v) = H x y)
    (hnot : ¬(A ⊆ U \ S ∧ B ⊆ V \ T)) :
    cleanKernelPairing (finiteProductWeight μ)
      (fun x y => (finiteProductWeight μ y : ℂ) * H x y)
      (finiteCoordinateComponent μ S U.toList f)
      (finiteCoordinateComponent μ T V.toList g) = 0 := by
  by_cases hAS : A ⊆ U \ S
  · have hBT : ¬ B ⊆ V \ T := fun h => hnot ⟨hAS, h⟩
    obtain ⟨i, hiB, hi⟩ := not_subset.mp hBT
    have hiT : i ∈ T := by simpa [mem_sdiff, hB hiB] using hi
    exact clean_kernel_component_zero_right μ hmass V T hT i hiT
      (finiteProductWeight μ) H (finiteCoordinateComponent μ S U.toList f) g
      (hright i hiB)
  · obtain ⟨i, hiA, hi⟩ := not_subset.mp hAS
    have hiS : i ∈ S := by simpa [mem_sdiff, hA hiA] using hi
    apply clean_kernel_component_zero_left μ hmass U S hS i hiS
      (fun x y => (finiteProductWeight μ y : ℂ) * H x y) f
      (finiteCoordinateComponent μ T V.toList g)
    intro x y v
    rw [hleft i hiA]

end Bounty
end

section

/- The literal fresh-coordinate transition and its exact product-law density. -/

namespace Bounty

open Finset
open scoped Classical

def finiteCoordinateRestrict {I : Type*} {X : I → Type*}
    (s : Finset I) (x : ∀ i, X i) : ∀ i : s, X i.val := fun i => x i.val

theorem finite_coordinate_restrict_update {I : Type*} [DecidableEq I] {X : I → Type*}
    (s : Finset I) (i : I) (hi : i ∉ s) (x : ∀ i, X i) (v : X i) :
    finiteCoordinateRestrict s (Function.update x i v) = finiteCoordinateRestrict s x := by
  funext j
  have hj : j.val ≠ i := fun he => hi (he ▸ j.property)
  exact Function.update_of_ne hj _ _

def finiteSharedCompatible {I : Type*} {X : I → Type*}
    (s : Finset I) (x y : ∀ i, X i) : Prop := ∀ i ∈ s, x i = y i

noncomputable def finiteSharedDensity {I : Type*} {X : I → Type*}
    (μ : ∀ i, X i → ℝ) (s : Finset I) (x y : ∀ i, X i) : ℝ :=
  ∏ i ∈ s, if x i = y i then (μ i (y i))⁻¹ else 0

noncomputable def finiteFreshMass {I : Type*} [Fintype I] [DecidableEq I] {X : I → Type*}
    (μ : ∀ i, X i → ℝ) (s : Finset I) (y : ∀ i, X i) : ℝ :=
  ∏ i ∈ sᶜ, μ i (y i)

theorem finite_shared_density_of_compatible {I : Type*} {X : I → Type*}
    (μ : ∀ i, X i → ℝ) (s : Finset I) (x y : ∀ i, X i)
    (hxy : finiteSharedCompatible s x y) :
    finiteSharedDensity μ s x y = (∏ i ∈ s, μ i (y i))⁻¹ := by
  unfold finiteSharedDensity
  simp only [← Finset.prod_inv_distrib]
  apply prod_congr rfl
  intro i hi
  rw [if_pos (hxy i hi)]

theorem finite_shared_density_of_not_compatible {I : Type*} {X : I → Type*}
    (μ : ∀ i, X i → ℝ) (s : Finset I) (x y : ∀ i, X i)
    (hxy : ¬ finiteSharedCompatible s x y) : finiteSharedDensity μ s x y = 0 := by
  classical
  obtain ⟨i, hi, hne⟩ : ∃ i ∈ s, x i ≠ y i := by
    simpa only [finiteSharedCompatible, not_forall, exists_prop] using hxy
  exact prod_eq_zero hi (if_neg hne)

theorem finite_product_weight_mul_shared_density {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} (μ : ∀ i, X i → ℝ) (s : Finset I)
    (hμ : ∀ i ∈ s, ∀ v, μ i v ≠ 0) (x y : ∀ i, X i) :
    finiteProductWeight μ y * finiteSharedDensity μ s x y =
      if finiteSharedCompatible s x y then finiteFreshMass μ s y else 0 := by
  by_cases hxy : finiteSharedCompatible s x y
  · rw [if_pos hxy, finite_shared_density_of_compatible μ s x y hxy]
    have hp : (∏ i ∈ s, μ i (y i)) ≠ 0 := prod_ne_zero_iff.mpr (fun i hi => hμ i hi _)
    have he := prod_mul_prod_compl s (fun i => μ i (y i))
    change (∏ i, μ i (y i)) * (∏ i ∈ s, μ i (y i))⁻¹ = ∏ i ∈ sᶜ, μ i (y i)
    rw [← he]
    field_simp
  · rw [if_neg hxy, finite_shared_density_of_not_compatible μ s x y hxy, mul_zero]

theorem finite_shared_fresh_weight_reversal {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} (μ : ∀ i, X i → ℝ) (shared : Finset I)
    (x y : ∀ i, X i) (hxy : finiteSharedCompatible shared x y) :
    finiteProductWeight μ x * finiteFreshMass μ shared y =
      finiteProductWeight μ y * finiteFreshMass μ shared x := by
  have hs : (∏ i ∈ shared, μ i (x i)) = ∏ i ∈ shared, μ i (y i) := by
    apply prod_congr rfl
    intro i hi
    rw [hxy i hi]
  unfold finiteProductWeight finiteFreshMass
  rw [← prod_mul_prod_compl shared (fun i => μ i (x i)),
    ← prod_mul_prod_compl shared (fun i => μ i (y i)), hs]
  ring

noncomputable def finiteAsymmetricKernel {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} (μ : ∀ i, X i → ℝ) (shared A B : Finset I)
    (F : (∀ i : shared, X i.val) → (∀ i : A, X i.val) → (∀ i : B, X i.val) → ℂ)
    (x y : ∀ i, X i) : ℂ :=
  if finiteSharedCompatible shared x y then
    (finiteFreshMass μ shared y : ℂ) *
      F (finiteCoordinateRestrict shared x) (finiteCoordinateRestrict A y) (finiteCoordinateRestrict B x)
  else 0

noncomputable def finiteAsymmetricDensity {I : Type*} {X : I → Type*}
    (μ : ∀ i, X i → ℝ) (shared A B : Finset I)
    (F : (∀ i : shared, X i.val) → (∀ i : A, X i.val) → (∀ i : B, X i.val) → ℂ)
    (x y : ∀ i, X i) : ℂ :=
  (finiteSharedDensity μ shared x y : ℂ) *
    F (finiteCoordinateRestrict shared x) (finiteCoordinateRestrict A y) (finiteCoordinateRestrict B x)

theorem finite_asymmetric_kernel_eq_density {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} (μ : ∀ i, X i → ℝ) (shared A B : Finset I)
    (hμ : ∀ i ∈ shared, ∀ v, μ i v ≠ 0)
    (F : (∀ i : shared, X i.val) → (∀ i : A, X i.val) → (∀ i : B, X i.val) → ℂ)
    (x y : ∀ i, X i) :
    finiteAsymmetricKernel μ shared A B F x y =
      (finiteProductWeight μ y : ℂ) * finiteAsymmetricDensity μ shared A B F x y := by
  unfold finiteAsymmetricKernel finiteAsymmetricDensity
  rw [← mul_assoc, ← Complex.ofReal_mul, finite_product_weight_mul_shared_density μ shared hμ x y]
  split_ifs <;> simp only [Complex.ofReal_zero, zero_mul]

end Bounty
end

section

/- The actual asymmetric prime value. The A tuple is taken from the target
endpoint, and the B tuple from the source endpoint; the shared tuple is fixed. -/

open scoped BigOperators Classical

namespace Bounty

noncomputable def primeTuplePhase (ζ Θ : ℝ) (N : ℕ) : ℂ :=
  physicalPhase ζ N * physicalReturnPhase Θ (N : ℤ)

theorem prime_tuple_phase_eq_exp (ζ Θ : ℝ) (N : ℕ) :
    primeTuplePhase ζ Θ N =
      Complex.exp (Complex.I * (ζ * Real.log (N : ℝ) + 2 * Real.pi * Θ * N : ℝ)) := by
  unfold primeTuplePhase physicalPhase physicalReturnPhase
  rw [← Complex.exp_add]
  congr 1
  push_cast
  ring

theorem prime_tuple_phase_norm (ζ Θ : ℝ) (N : ℕ) :
    ‖primeTuplePhase ζ Θ N‖ = 1 := by
  rw [prime_tuple_phase_eq_exp, Complex.norm_exp]
  simp only [Complex.mul_re, Complex.I_re, Complex.I_im, Complex.ofReal_re,
    Complex.ofReal_im, zero_mul, mul_zero, sub_zero, Real.exp_zero]

theorem prime_tuple_phase_shared_mul (ζ Θ : ℝ) (C N : ℕ)
    (hC : 0 < C) (hN : 0 < N) :
    primeTuplePhase ζ Θ (C * N) =
      physicalPhase ζ C * primeTuplePhase ζ (Θ * C) N := by
  rw [prime_tuple_phase_eq_exp, prime_tuple_phase_eq_exp, physicalPhase, ← Complex.exp_add]
  have hCr : (C : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hC)
  have hNr : (N : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hN)
  simp only [Nat.cast_mul, Real.log_mul hCr hNr]
  congr 1
  push_cast
  ring

noncomputable def primeAsymmetricValue {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ) (shared A B : Finset I)
    (Q : ℕ) (h : ℝ) (keptA keptB : Finset ℤ) (ζ Θ : ℝ)
    (c : ∀ i : shared, P i.1) (a : ∀ i : A, P i.1) (b : ∀ i : B, P i.1) : ℂ :=
  finiteTwoKernelAverage
    (finiteProductWeight (physicalLabelLaw (P := fun i : A => P i.1) (fun i => V i.1)))
    (finiteProductWeight (physicalLabelLaw (P := fun i : B => P i.1) (fun i => V i.1)))
    (primeProductIdealKernel (fun i : A => P i.1) (fun i => V i.1) Q h keptA)
    (primeProductIdealKernel (fun i : B => P i.1) (fun i => V i.1) Q h keptB) a b
    (fun d e => primeTuplePhase ζ Θ
      ((∏ i : shared, (c i).val) * (∏ i : A, (d i).val) * (∏ i : B, (e i).val)))

theorem prime_asymmetric_value_eq_sum {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ) (shared A B : Finset I)
    (Q : ℕ) (h : ℝ) (keptA keptB : Finset ℤ) (ζ Θ : ℝ)
    (c : ∀ i : shared, P i.1) (a : ∀ i : A, P i.1) (b : ∀ i : B, P i.1) :
    primeAsymmetricValue P V shared A B Q h keptA keptB ζ Θ c a b =
      ∑ d : ∀ i : A, P i.1, ∑ e : ∀ i : B, P i.1,
        ((finiteProductWeight (physicalLabelLaw (P := fun i : A => P i.1)
          (fun i => V i.1)) d : ℂ) *
          primeProductIdealKernel (fun i : A => P i.1) (fun i => V i.1) Q h keptA d a) *
        ((finiteProductWeight (physicalLabelLaw (P := fun i : B => P i.1)
          (fun i => V i.1)) e : ℂ) *
          primeProductIdealKernel (fun i : B => P i.1) (fun i => V i.1) Q h keptB e b) *
        primeTuplePhase ζ Θ
          ((∏ i : shared, (c i).val) * (∏ i : A, (d i).val) * (∏ i : B, (e i).val)) := rfl

end Bounty
end

section

/- A full-state continuation can be read on raw memory with fixed active
labels. The zero extension agrees exactly on every decoded bounded state. -/

open scoped Classical
namespace Bounty

section Fixed
variable {N : ℕ} {P : Fin N → Type*} (n : (g : Fin N) → P g → ℕ)
  {M : Fin N → ℕ} (B : ℕ) (active : (g : Fin N) → Fin (M g) → P g)

noncomputable def fixedActiveRawExtension
    (F : FullMixedLedgerState n (M := M) B → ℂ)
    (s : GlobalBirthJointState (fun g p => ZMod (n g p))) : ℂ :=
  if h : ∀ g, (s g).2.1 ≤ B then
    F (fun g => (s g).1,
      fun g => (active g, ⟨⟨(s g).2.1, Nat.lt_succ_of_le (h g)⟩, (s g).2.2⟩))
  else 0

theorem fixed_active_raw_extension_decode
    (F : FullMixedLedgerState n (M := M) B → ℂ)
    (s : FullMixedLedgerState n (M := M) B) :
    fixedActiveRawExtension n B active F (fullMixedLedgerDecode n B s) =
      F (s.1, fun g => (active g, (s.2 g).2)) := by
  unfold fixedActiveRawExtension fullMixedLedgerDecode
  rw [dif_pos (fun g => boundedOrderedTupleToFinite_length_le (s.2 g).2)]
  rfl

theorem fixed_active_raw_extension_self
    (F : FullMixedLedgerState n (M := M) B → ℂ)
    (s : FullMixedLedgerState n (M := M) B)
    (hactive : ∀ g, (s.2 g).1 = active g) :
    fixedActiveRawExtension n B active F (fullMixedLedgerDecode n B s) = F s := by
  rw [fixed_active_raw_extension_decode]
  congr 1
  apply Prod.ext
  · rfl
  · funext g
    exact Prod.ext (hactive g).symm rfl

end Fixed
end Bounty
end

section

/- Extend the physical endpoint phase to every full active state. On an
injective state its physical list is uniquely decoded; elsewhere the phase
vanishes. No change is made to the full event type or weight. -/

open scoped Classical
namespace Bounty

section Physical
variable {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin N → Finset (Fin J)) (k : ℤ)
  (H : (g : Fin N) → Finset ↥(P g))
  (ω : ∀ _c : SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C g)), PhysicalAuxLabels P C → ℝ)
  (μ : (g : Fin N) → ↥(P g) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

noncomputable def physicalFullGlobalEdgePhase (x : PhysicalFullBoundedState P J ell B)
    (e : PhysicalFullEdgeEvent C k x) : ℂ :=
  if hx : FullActiveInjective x then
    physicalFullEndpointPhase C k (physicalFullStateLabels C x hx) H (fun g => (x g).2)
      ω μ ρ V (Eq.mpr (congrArg (PhysicalFullEdgeEvent C k)
        (physical_full_state_encode_labels C x hx)) e)
  else 0

theorem physical_full_global_edge_phase_norm_le (x : PhysicalFullBoundedState P J ell B)
    (e : PhysicalFullEdgeEvent C k x) :
    ‖physicalFullGlobalEdgePhase C k H ω μ ρ V x e‖ ≤ 1 := by
  unfold physicalFullGlobalEdgePhase
  split_ifs
  · exact physical_full_endpoint_phase_norm_le _ _ _ _ _ _ _ _ _ _
  · simp only [norm_zero, zero_le_one]

theorem physical_full_global_edge_phase_encode (L : PhysicalMarkLists P J ell)
    (q : (g : Fin N) → BoundedOrderedTuple
      (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B)
    (e : PhysicalFullEdgeEvent C k (physicalFullMemoryState C L q)) :
    physicalFullGlobalEdgePhase C k H ω μ ρ V (physicalFullMemoryState C L q) e =
      physicalFullEndpointPhase C k L H q ω μ ρ V e := by
  unfold physicalFullGlobalEdgePhase
  rw [dif_pos (physical_full_state_injective C L q)]
  have ht (L' : PhysicalMarkLists P J ell) (hL : L' = L)
      (he : PhysicalFullEdgeEvent C k (physicalFullMemoryState C L' q) =
        PhysicalFullEdgeEvent C k (physicalFullMemoryState C L q)) :
      physicalFullEndpointPhase C k L' H q ω μ ρ V (Eq.mpr he e) =
        physicalFullEndpointPhase C k L H q ω μ ρ V e := by
    subst L'
    rfl
  exact ht _ (physical_full_state_labels_encode C L q) _

end Physical
end Bounty
end

section

/- Changing the chosen slot enumeration between vertices is incorporated
into the permutation bijection. Normalization and the complete dependence
on the original permutation are retained together. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def physicalTransitionPermutationEquiv {G : Type*} {J ell : ℕ}
    (C D : G → Finset (Fin J)) :
    PhysicalPermutations G J ell ≃ FullActiveSlotPermutations (fun _ : G => J + ell) where
  toFun σ g := ((physicalFullSlotIndex (D g)).trans (σ g)).trans (physicalFullSlotIndex (C g)).symm
  invFun τ g := ((physicalFullSlotIndex (D g)).symm.trans (τ g)).trans (physicalFullSlotIndex (C g))
  left_inv σ := by
    funext g
    apply Equiv.ext
    intro i
    simp only [Equiv.trans_apply, Equiv.apply_symm_apply]
  right_inv τ := by
    funext g
    apply Equiv.ext
    intro i
    simp only [Equiv.trans_apply, Equiv.symm_apply_apply]

theorem physical_full_memory_transition_permute {G : Type*} {P : G → Finset ℕ}
    {Z : G → Type*} {J ell B : ℕ} (C D : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (q : ∀ g, BoundedOrderedTuple (Z g) B)
    (σ : PhysicalPermutations G J ell) :
    physicalFullMemoryState D (physicalPermuteLabels σ L) q =
      fullActivePermutation (physicalTransitionPermutationEquiv C D σ) (physicalFullMemoryState C L q) := by
  funext g
  apply Prod.ext
  · funext i
    change L g (σ g (physicalFullSlotIndex (D g) i)) =
      L g (physicalFullSlotIndex (C g) ((physicalFullSlotIndex (C g)).symm
        (σ g (physicalFullSlotIndex (D g) i))))
    rw [Equiv.apply_symm_apply]
  · rfl

theorem physical_full_transition_permutation_weight {G : Type*} [Fintype G] [DecidableEq G]
    {J ell : ℕ} (C D : G → Finset (Fin J)) (σ : PhysicalPermutations G J ell) :
    (Fintype.card (PhysicalPermutations G J ell) : ℝ)⁻¹ =
      fullActivePermutationWeight (fun _ : G => J + ell) (physicalTransitionPermutationEquiv C D σ) := by
  unfold fullActivePermutationWeight
  rw [Fintype.card_congr (physicalTransitionPermutationEquiv C D)]

theorem physical_full_transition_phase_reindex {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {Z : G → Type*} {J ell B : ℕ}
    (C D : G → Finset (Fin J)) (L : PhysicalMarkLists P J ell)
    (q : ∀ g, BoundedOrderedTuple (Z g) B)
    (F : PhysicalPermutations G J ell →
      ProductBoundedOrderedState (fun g => ↥(P g)) Z (fun _ : G => J + ell) B → ℂ) :
    (∑ σ : PhysicalPermutations G J ell,
      ((Fintype.card (PhysicalPermutations G J ell) : ℝ)⁻¹ : ℂ) *
        F σ (physicalFullMemoryState D (physicalPermuteLabels σ L) q)) =
    ∑ τ : FullActiveSlotPermutations (fun _ : G => J + ell),
      (fullActivePermutationWeight (fun _ : G => J + ell) τ : ℂ) *
        F ((physicalTransitionPermutationEquiv C D).symm τ)
          (fullActivePermutation τ (physicalFullMemoryState C L q)) := by
  calc
    _ = ∑ σ : PhysicalPermutations G J ell,
        (fullActivePermutationWeight (fun _ : G => J + ell) (physicalTransitionPermutationEquiv C D σ) : ℂ) *
          F σ (fullActivePermutation (physicalTransitionPermutationEquiv C D σ) (physicalFullMemoryState C L q)) := by
      apply sum_congr rfl
      intro σ _
      rw [physical_full_memory_transition_permute C D L q σ]
      have hw := congrArg Complex.ofReal (physical_full_transition_permutation_weight C D σ)
      simpa only [Complex.ofReal_inv] using congrArg
        (fun z : ℂ => z * F σ (fullActivePermutation (physicalTransitionPermutationEquiv C D σ)
          (physicalFullMemoryState C L q))) hw
    _ = _ := by
      simpa only [Equiv.symm_apply_apply] using
        (physicalTransitionPermutationEquiv C D).sum_comp
          (fun τ => (fullActivePermutationWeight (fun _ : G => J + ell) τ : ℂ) *
            F ((physicalTransitionPermutationEquiv C D).symm τ)
              (fullActivePermutation τ (physicalFullMemoryState C L q)))

theorem physical_full_transition_average {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {Z : G → Type*} {J ell B : ℕ}
    (C D : G → Finset (Fin J)) (L : PhysicalMarkLists P J ell)
    (q : ∀ g, BoundedOrderedTuple (Z g) B)
    (F : ProductBoundedOrderedState (fun g => ↥(P g)) Z (fun _ : G => J + ell) B → ℂ) :
    (∑ σ : PhysicalPermutations G J ell,
      ((Fintype.card (PhysicalPermutations G J ell) : ℝ)⁻¹ : ℂ) *
        F (physicalFullMemoryState D (physicalPermuteLabels σ L) q)) =
      fullActiveAverage F (physicalFullMemoryState C L q) := by
  exact physical_full_transition_phase_reindex C D L q (fun _ => F)

end Bounty
end

section

/- A finite chronological schedule of named rows is the corresponding
operator list, with every occurrence and its order preserved. -/

namespace Bounty

theorem finite_operator_list_map {I K X : Type*}
    (row : K → (X → ℂ) → X → ℂ) (tag : I → K) (steps : List I) (F : X → ℂ) :
    finiteOperatorListAction (fun i => row (tag i)) steps F =
      finiteOperatorListAction row (steps.map tag) F := by
  induction steps with
  | nil => rfl
  | cons i steps ih =>
    change row (tag i) (finiteOperatorListAction (fun i => row (tag i)) steps F) = _
    rw [ih]
    rfl

theorem finite_row_schedule_eq_list {K X : Type*}
    (row : K → (X → ℂ) → X → ℂ) (tag : ℕ → K) (steps : ℕ) (F : X → ℂ) :
    finiteRowComposition (S := fun _ => X) (fun i => row (tag i)) steps F =
      finiteOperatorListAction row ((List.range steps).map tag) F := by
  rw [finite_row_composition_eq_operator_list, finite_operator_list_map]

end Bounty
end

section

/- Physical ordered lists carry exactly the restriction of full-state
energy to injective active coordinates. Nonnegative weights allow this
restriction to be bounded without introducing a cardinality factor. -/

open Finset
open scoped Classical
namespace Bounty

section Physical
variable {G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Finset ℕ} {Z : G → Type*} [∀ g, Fintype (Z g)] {J ell B : ℕ}
  (C : G → Finset (Fin J))

theorem physical_full_state_sum_real
    (F : ProductBoundedOrderedState (fun g => ↥(P g)) Z (fun _ => J + ell) B → ℝ) :
    (∑ L : PhysicalMarkLists P J ell, ∑ q : (g : G) → BoundedOrderedTuple (Z g) B,
      F (physicalFullMemoryState C L q)) =
    ∑ x : ProductBoundedOrderedState (fun g => ↥(P g)) Z (fun _ => J + ell) B,
      if FullActiveInjective x then F x else 0 := by
  rw [← Fintype.sum_prod_type (f := fun s : PhysicalMarkLists P J ell ×
    ((g : G) → BoundedOrderedTuple (Z g) B) => F (physicalFullMemoryState C s.1 s.2))]
  refine (Equiv.sum_comp (physicalFullStateEquiv (Z := Z) (B := B) C)
    (fun x => F x.val)).trans ?_
  rw [← Finset.sum_subtype (univ.filter FullActiveInjective) (by simp) F]
  exact sum_filter _ _

noncomputable def physicalMarkMemoryEnergy
    (μ : (g : G) → ↥(P g) → ℝ) (ν : (g : G) → Z g → ℝ)
    (F : PhysicalMarkLists P J ell → ((g : G) → BoundedOrderedTuple (Z g) B) → ℂ) : ℝ :=
  ∑ L, ∑ q, (∏ g, (∏ i : PhysicalSlots J ell, μ g (L g i)) *
    boundedOrderedMemoryWeight (ν g) (q g)) * ‖F L q‖ ^ 2

theorem physical_full_state_energy_eq
    (μ : (g : G) → ↥(P g) → ℝ) (ν : (g : G) → Z g → ℝ)
    (F : ProductBoundedOrderedState (fun g => ↥(P g)) Z (fun _ => J + ell) B → ℂ) :
    physicalMarkMemoryEnergy μ ν (fun L q => F (physicalFullMemoryState C L q)) =
    ∑ x : ProductBoundedOrderedState (fun g => ↥(P g)) Z (fun _ => J + ell) B,
      if FullActiveInjective x then productMemoryWeight μ ν x * ‖F x‖ ^ 2 else 0 := by
  have h := physical_full_state_sum_real C (fun x => productMemoryWeight μ ν x * ‖F x‖ ^ 2)
  simpa only [physicalMarkMemoryEnergy, physical_full_memory_state_weight] using h

theorem physical_full_state_energy_le
    (μ : (g : G) → ↥(P g) → ℝ) (ν : (g : G) → Z g → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hν : ∀ g z, 0 ≤ ν g z)
    (F : ProductBoundedOrderedState (fun g => ↥(P g)) Z (fun _ => J + ell) B → ℂ) :
    physicalMarkMemoryEnergy μ ν (fun L q => F (physicalFullMemoryState C L q)) ≤
      finiteWeightedEnergy (productMemoryWeight μ ν) F := by
  rw [physical_full_state_energy_eq C]
  unfold finiteWeightedEnergy
  apply sum_le_sum
  intro x _
  split_ifs
  · exact le_rfl
  · exact mul_nonneg (productMemoryWeight_nonneg μ ν hμ hν x) (sq_nonneg _)

end Physical
end Bounty
end

section

/- The minor coefficient is small using only a bound on the product of dyad endpoints. -/

namespace Bounty

theorem minor_arc_uniform_factor_le {L C D U V r κ t q B : ℝ}
    (hL : 512 ≤ L) (hC : 0 ≤ C) (hD : 0 ≤ D) (ht : 0 ≤ t) (hq : 0 ≤ q)
    (hparam : 2 * κ + t + 2 * B + 3 ≤ q)
    (hCb : C ≤ L ^ κ) (hDb : D ≤ L ^ κ)
    (hU : L ^ q ≤ U) (hV : L ^ q ≤ V) (hr : L ^ q ≤ r)
    (hrUV : r / (U * V) ≤ L ^ (-q)) (hlog : Real.log (U * V) ≤ L ^ t) :
    33 * Real.sqrt (6 * C * D * (1 + Real.log r) *
      (1 / r + 1 / U + 1 / V + r / (U * V))) ≤ L ^ (-B) := by
  have hL0 : 0 < L := by linarith
  have hL1 : 1 ≤ L := by linarith
  have hp : 0 < L ^ q := Real.rpow_pos_of_pos hL0 q
  have hU0 := hp.trans_le hU
  have hV0 := hp.trans_le hV
  have hr0 := hp.trans_le hr
  have hsmall : L ^ (-q) ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos hL1 (by linarith)
  have hrprod : r ≤ U * V := by
    have hb := (div_le_iff₀ (mul_pos hU0 hV0)).mp hrUV
    exact hb.trans (by simpa only [one_mul] using
      mul_le_mul_of_nonneg_right hsmall (mul_pos hU0 hV0).le)
  have hlogr : Real.log r ≤ L ^ t := (Real.log_le_log hr0 hrprod).trans hlog
  apply minor_arc_factor_absorption (by linarith)
  have hb := minor_arc_dyad_coefficient_small (B := B + 1)
    (by linarith : 48 ≤ L) hC hD ht hq (by linarith)
    hCb hDb hU hV hr hrUV hlogr
  convert hb using 1
  congr 1
  ring

end Bounty
end

section

/- A single marked prime band supplies the lower scale for all product dyads. -/

open Filter
open scoped BigOperators Classical

namespace Bounty

theorem prime_band_product_lower {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (i : I) (hp : ∀ j p, p ∈ P j → 0 < p)
    {a b : ℝ} (hPi : P i = primeBand a b) (ha : 0 ≤ a) (hb : 0 ≤ b)
    (x : ∀ j, P j) : a < ((∏ j, (x j).val : ℕ) : ℝ) := by
  have hmem : (x i).val ∈ primeBand a b := hPi ▸ (x i).property
  have hband := (mem_primeBand_iff ha hb (x i).val).mp hmem
  have hle : (x i).val ≤ ∏ j, (x j).val :=
    Finset.single_le_prod' (f := fun j => (x j).val)
      (fun j _ => hp j (x j).val (x j).property) (Finset.mem_univ i)
  exact hband.2.1.trans_le (by exact_mod_cast hle)

theorem eventually_prime_band_product_scale {c : ℝ} (hc : 0 < c) (q : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ {I : Type*} [Fintype I] [DecidableEq I]
      (P : I → Finset ℕ) (i : I), (∀ j p, p ∈ P j → 0 < p) →
      ∀ a b : ℝ, P i = primeBand a b → Real.exp (L ^ c) ≤ a → 0 ≤ b →
      ∀ x : (∀ j, P j), 2 * L ^ q ≤ ((∏ j, (x j).val : ℕ) : ℝ) := by
  filter_upwards [eventually_mul_rpow_le_exp_rpow q 2 hc] with L hL
  intro I _ _ P i hp a b hPi ha hb x
  exact hL.trans ((ha.trans_lt (prime_band_product_lower P i hp hPi
    ((Real.exp_pos _).le.trans ha) hb x)).le)

end Bounty
end

section

/- Canonical inclusions between memory caps preserve literal lengths,
ordered coordinates, active labels, and the factorial product measures. -/

open Finset

namespace Bounty

def boundedMemoryCapEmbed {Z : Type*} {b B : ℕ} (h : b ≤ B)
    (q : BoundedOrderedTuple Z b) : BoundedOrderedTuple Z B :=
  ⟨⟨q.1.val, lt_of_lt_of_le q.1.isLt (Nat.add_le_add_right h 1)⟩, q.2⟩

def boundedStateCapEmbed {P Z : Type*} {t b B : ℕ} (h : b ≤ B)
    (s : BoundedOrderedState P Z t b) : BoundedOrderedState P Z t B :=
  (s.1, boundedMemoryCapEmbed h s.2)

def productStateCapEmbed {G : Type*} {P Z : G → Type*} {M : G → ℕ} {b B : ℕ}
    (h : b ≤ B) (x : ProductBoundedOrderedState P Z M b) :
    ProductBoundedOrderedState P Z M B :=
  fun g => boundedStateCapEmbed h (x g)

theorem boundedMemoryCapEmbed_length {Z : Type*} {b B : ℕ} (h : b ≤ B)
    (q : BoundedOrderedTuple Z b) : (boundedMemoryCapEmbed h q).1.val = q.1.val := rfl

theorem boundedMemoryCapEmbed_values {Z : Type*} {b B : ℕ} (h : b ≤ B)
    (q : BoundedOrderedTuple Z b) : (boundedMemoryCapEmbed h q).2 = q.2 := rfl

theorem boundedMemoryCapEmbed_toFinite {Z : Type*} {b B : ℕ} (h : b ≤ B)
    (q : BoundedOrderedTuple Z b) :
    boundedOrderedTupleToFinite (boundedMemoryCapEmbed h q) = boundedOrderedTupleToFinite q := rfl

theorem boundedStateCapEmbed_active {P Z : Type*} {t b B : ℕ} (h : b ≤ B)
    (s : BoundedOrderedState P Z t b) : (boundedStateCapEmbed h s).1 = s.1 := rfl

theorem boundedStateCapEmbed_memory {P Z : Type*} {t b B : ℕ} (h : b ≤ B)
    (s : BoundedOrderedState P Z t b) :
    (boundedStateCapEmbed h s).2 = boundedMemoryCapEmbed h s.2 := rfl

theorem productStateCapEmbed_apply {G : Type*} {P Z : G → Type*} {M : G → ℕ} {b B : ℕ}
    (h : b ≤ B) (x : ProductBoundedOrderedState P Z M b) (g : G) :
    productStateCapEmbed h x g = boundedStateCapEmbed h (x g) := rfl

theorem boundedMemoryCapEmbed_injective {Z : Type*} {b B : ℕ} (h : b ≤ B) :
    Function.Injective (boundedMemoryCapEmbed (Z := Z) h) := by
  intro x y hxy
  rcases x with ⟨⟨k, hk⟩, x⟩
  rcases y with ⟨⟨l, hl⟩, y⟩
  have hkl : k = l := congrArg (fun q => q.1.val) hxy
  subst l
  have hvals : x = y := eq_of_heq (Sigma.mk.inj hxy).2
  subst y
  rfl

theorem boundedStateCapEmbed_injective {P Z : Type*} {t b B : ℕ} (h : b ≤ B) :
    Function.Injective (boundedStateCapEmbed (P := P) (Z := Z) (t := t) h) := by
  intro x y hxy
  apply Prod.ext
  · exact congrArg (fun s : BoundedOrderedState P Z t B => s.1) hxy
  · apply boundedMemoryCapEmbed_injective h
    exact congrArg (fun s : BoundedOrderedState P Z t B => s.2) hxy

theorem productStateCapEmbed_injective {G : Type*} {P Z : G → Type*} {M : G → ℕ}
    {b B : ℕ} (h : b ≤ B) :
    Function.Injective (productStateCapEmbed (P := P) (Z := Z) (M := M) h) := by
  intro x y hxy
  funext g
  exact boundedStateCapEmbed_injective h (congrFun hxy g)

theorem boundedMemoryCapEmbed_weight {Z : Type*} {b B : ℕ} (h : b ≤ B)
    (ν : Z → ℝ) (q : BoundedOrderedTuple Z b) :
    boundedOrderedMemoryWeight ν (boundedMemoryCapEmbed h q) = boundedOrderedMemoryWeight ν q := rfl

theorem boundedStateCapEmbed_weight {P Z : Type*} {t b B : ℕ} (h : b ≤ B)
    (μ : P → ℝ) (ν : Z → ℝ) (s : BoundedOrderedState P Z t b) :
    boundedOrderedStateWeight μ ν (boundedStateCapEmbed h s) = boundedOrderedStateWeight μ ν s := rfl

theorem productStateCapEmbed_weight {G : Type*} [Fintype G]
    {P Z : G → Type*} {M : G → ℕ} {b B : ℕ} (h : b ≤ B)
    (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (x : ProductBoundedOrderedState P Z M b) :
    productMemoryWeight μ ν (productStateCapEmbed h x) = productMemoryWeight μ ν x := rfl

theorem productStateCapEmbed_totalMemory {G : Type*} [Fintype G]
    {P Z : G → Type*} {M : G → ℕ} {b B : ℕ} (h : b ≤ B)
    (x : ProductBoundedOrderedState P Z M b) :
    productTotalMemory (productStateCapEmbed h x) = productTotalMemory x := rfl

theorem boundedMemoryCapEmbed_refl {Z : Type*} {b : ℕ} (q : BoundedOrderedTuple Z b) :
    boundedMemoryCapEmbed le_rfl q = q := rfl

theorem boundedStateCapEmbed_refl {P Z : Type*} {t b : ℕ} (s : BoundedOrderedState P Z t b) :
    boundedStateCapEmbed le_rfl s = s := rfl

theorem productStateCapEmbed_refl {G : Type*} {P Z : G → Type*} {M : G → ℕ} {b : ℕ}
    (x : ProductBoundedOrderedState P Z M b) : productStateCapEmbed le_rfl x = x := rfl

theorem boundedMemoryCapEmbed_trans {Z : Type*} {a b B : ℕ} (hab : a ≤ b) (hbB : b ≤ B)
    (q : BoundedOrderedTuple Z a) :
    boundedMemoryCapEmbed hbB (boundedMemoryCapEmbed hab q) = boundedMemoryCapEmbed (hab.trans hbB) q := rfl

theorem boundedStateCapEmbed_trans {P Z : Type*} {t a b B : ℕ} (hab : a ≤ b) (hbB : b ≤ B)
    (s : BoundedOrderedState P Z t a) :
    boundedStateCapEmbed hbB (boundedStateCapEmbed hab s) = boundedStateCapEmbed (hab.trans hbB) s := rfl

theorem productStateCapEmbed_trans {G : Type*} {P Z : G → Type*} {M : G → ℕ}
    {a b B : ℕ} (hab : a ≤ b) (hbB : b ≤ B) (x : ProductBoundedOrderedState P Z M a) :
    productStateCapEmbed hbB (productStateCapEmbed hab x) = productStateCapEmbed (hab.trans hbB) x := rfl

end Bounty
end

section

/- Every ghost target retains the full source active tuples, including
invalid local events whose target falls back to the source. Consequently
the target is reconstructed exactly from source active labels and target
pending memory. No event-validity or nonzero-weight premise is needed. -/

namespace Bounty

theorem boundedGhostEventTarget_active {P Z : Type*} (t B : ℕ)
    (s : BoundedOrderedState P Z t B) (e : BoundedGhostEvent t B s) :
    (boundedGhostEventTarget t B s e).1 = s.1 := by
  unfold boundedGhostEventTarget
  dsimp only
  split_ifs <;> rfl

theorem boundedGhostEventTarget_reconstruct {P Z : Type*} (t B : ℕ)
    (s : BoundedOrderedState P Z t B) (e : BoundedGhostEvent t B s) :
    (s.1, (boundedGhostEventTarget t B s e).2) = boundedGhostEventTarget t B s e := by
  exact Prod.ext (boundedGhostEventTarget_active t B s e).symm rfl

theorem coupledGhostJointEventTarget_active {G : Type*} {P Z : G → Type*}
    (M : G → ℕ) (B : ℕ) (s : ProductBoundedOrderedState P Z M B)
    (e : CoupledGhostEvent M B s) (g : G) :
    (coupledGhostJointEventTarget M B s e g).1 = (s g).1 :=
  boundedGhostEventTarget_active (M g) B (s g) (e g)

theorem coupledGhostJointEventTarget_reconstruct {G : Type*} {P Z : G → Type*}
    (M : G → ℕ) (B : ℕ) (s : ProductBoundedOrderedState P Z M B)
    (e : CoupledGhostEvent M B s) :
    (fun g => ((s g).1, (coupledGhostJointEventTarget M B s e g).2)) =
      coupledGhostJointEventTarget M B s e := by
  funext g
  exact boundedGhostEventTarget_reconstruct (M g) B (s g) (e g)

universe uJ uK uG uP uA

section

variable {J : Type uJ} {K : Type uK} {G : Type uG} {P : G → Type uP}
  (n : ∀ g, P g → ℕ) {M : G → ℕ}
  (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type uA)
  (Δ D : ∀ k c, A k c → G → ℤ)

theorem fullMixedMemoryEventTarget_ghost_active (j : J)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullMixedMemoryEvent n S B A Δ D (.inl j) s) (g : G) :
    (fullMixedMemoryEventTarget n S B A Δ D (.inl j) s e g).1 = (s g).1 :=
  coupledGhostJointEventTarget_active M B s e.down g

theorem fullMixedMemoryEventTarget_ghost_reconstruct (j : J)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullMixedMemoryEvent n S B A Δ D (.inl j) s) :
    (fun g => ((s g).1, (fullMixedMemoryEventTarget n S B A Δ D (.inl j) s e g).2)) =
      fullMixedMemoryEventTarget n S B A Δ D (.inl j) s e :=
  coupledGhostJointEventTarget_reconstruct M B s e.down

theorem fullPermutationMixedEventTarget_ghost_active (j : J)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (some (.inl j)) s) (g : G) :
    (fullPermutationMixedEventTarget n S B A Δ D (some (.inl j)) s e g).1 = (s g).1 :=
  fullMixedMemoryEventTarget_ghost_active n S B A Δ D j s e g

theorem fullPermutationMixedEventTarget_ghost_reconstruct (j : J)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (some (.inl j)) s) :
    (fun g => ((s g).1, (fullPermutationMixedEventTarget n S B A Δ D (some (.inl j)) s e g).2)) =
      fullPermutationMixedEventTarget n S B A Δ D (some (.inl j)) s e :=
  fullMixedMemoryEventTarget_ghost_reconstruct n S B A Δ D j s e

end

end Bounty
end

section

/- Exact transport of dependent event paths through a state map and event
bijections. The phase is transported with every event identity intact. -/

open Finset Classical

namespace Bounty

universe uK uX uY uE uF

def finiteEventPathEquiv {K : Type uK} {X : Type uX} {Y : Type uY}
    (E : K → X → Type uE) (F : K → Y → Type uF)
    (t : ∀ k x, E k x → X) (u : ∀ k y, F k y → Y)
    (e : X → Y) (δ : ∀ k x, E k x ≃ F k (e x))
    (ht : ∀ k x a, e (t k x a) = u k (e x) (δ k x a)) :
    ∀ ks x, FiniteEventPath E t ks x ≃ FiniteEventPath F u ks (e x)
  | [], _ => Equiv.punitEquivPUnit
  | k :: ks, x => Equiv.sigmaCongr (δ k x) (fun a =>
      (finiteEventPathEquiv E F t u e δ ht ks (t k x a)).trans
        (Equiv.cast (congrArg (FiniteEventPath F u ks) (ht k x a))))

theorem finite_event_path_terminal_cast {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X) (ks : List K)
    {x y : X} (h : x = y) (p : FiniteEventPath E t ks x) :
    finiteEventPathTerminal E t ks y (cast (congrArg (FiniteEventPath E t ks) h) p) =
      finiteEventPathTerminal E t ks x p := by
  cases h
  rfl

theorem finite_event_path_weight_cast {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X)
    (w : ∀ k x, E k x → ℝ) (ks : List K)
    {x y : X} (h : x = y) (p : FiniteEventPath E t ks x) :
    finiteEventPathWeight E t w ks y (cast (congrArg (FiniteEventPath E t ks) h) p) =
      finiteEventPathWeight E t w ks x p := by
  cases h
  rfl

theorem finite_event_path_equiv_terminal {K : Type uK} {X : Type uX} {Y : Type uY}
    (E : K → X → Type uE) (F : K → Y → Type uF)
    (t : ∀ k x, E k x → X) (u : ∀ k y, F k y → Y)
    (e : X → Y) (δ : ∀ k x, E k x ≃ F k (e x))
    (ht : ∀ k x a, e (t k x a) = u k (e x) (δ k x a))
    (ks : List K) (x : X) (p : FiniteEventPath E t ks x) :
    finiteEventPathTerminal F u ks (e x) (finiteEventPathEquiv E F t u e δ ht ks x p) =
      e (finiteEventPathTerminal E t ks x p) := by
  induction ks generalizing x with
  | nil => rfl
  | cons k ks ih =>
    rcases p with ⟨a, p⟩
    change finiteEventPathTerminal F u ks _
      (cast (congrArg (FiniteEventPath F u ks) (ht k x a))
        (finiteEventPathEquiv E F t u e δ ht ks (t k x a) p)) = _
    rw [finite_event_path_terminal_cast F u ks (ht k x a)]
    exact ih _ p

theorem finite_event_path_equiv_weight {K : Type uK} {X : Type uX} {Y : Type uY}
    (E : K → X → Type uE) (F : K → Y → Type uF)
    (t : ∀ k x, E k x → X) (u : ∀ k y, F k y → Y)
    (e : X → Y) (δ : ∀ k x, E k x ≃ F k (e x))
    (ht : ∀ k x a, e (t k x a) = u k (e x) (δ k x a))
    (w : ∀ k x, E k x → ℝ) (v : ∀ k y, F k y → ℝ)
    (hw : ∀ k x a, v k (e x) (δ k x a) = w k x a)
    (ks : List K) (x : X) (p : FiniteEventPath E t ks x) :
    finiteEventPathWeight F u v ks (e x) (finiteEventPathEquiv E F t u e δ ht ks x p) =
      finiteEventPathWeight E t w ks x p := by
  induction ks generalizing x with
  | nil => rfl
  | cons k ks ih =>
    rcases p with ⟨a, p⟩
    change v k (e x) (δ k x a) * finiteEventPathWeight F u v ks _
      (cast (congrArg (FiniteEventPath F u ks) (ht k x a))
        (finiteEventPathEquiv E F t u e δ ht ks (t k x a) p)) = _
    rw [hw, finite_event_path_weight_cast F u v ks (ht k x a), ih]
    rfl

theorem finite_event_path_action_equiv {K : Type uK} {X : Type uX} {Y : Type uY}
    (E : K → X → Type uE) (F : K → Y → Type uF)
    [∀ k x, Fintype (E k x)] [∀ k y, Fintype (F k y)]
    (t : ∀ k x, E k x → X) (u : ∀ k y, F k y → Y)
    (e : X → Y) (δ : ∀ k x, E k x ≃ F k (e x))
    (ht : ∀ k x a, e (t k x a) = u k (e x) (δ k x a))
    (w : ∀ k x, E k x → ℝ) (v : ∀ k y, F k y → ℝ)
    (hw : ∀ k x a, v k (e x) (δ k x a) = w k x a)
    (ks : List K) (phase : ∀ y, FiniteEventPath F u ks y → ℂ)
    (f : Y → ℂ) (x : X) :
    finiteEventPathAction E t w ks
        (fun x p => phase (e x) (finiteEventPathEquiv E F t u e δ ht ks x p)) (fun x => f (e x)) x =
      finiteEventPathAction F u v ks phase f (e x) := by
  let _ := finiteEventPathFintype E t ks x
  let _ := finiteEventPathFintype F u ks (e x)
  have h := Equiv.sum_comp (finiteEventPathEquiv E F t u e δ ht ks x)
    (fun p => (finiteEventPathWeight F u v ks (e x) p : ℂ) * phase (e x) p *
      f (finiteEventPathTerminal F u ks (e x) p))
  simpa only [finiteEventPathAction, finite_event_path_equiv_weight E F t u e δ ht w v hw,
    finite_event_path_equiv_terminal E F t u e δ ht] using h

end Bounty
end

section

/- Deterministic observation records do not add event multiplicity. Each
source-state/event observation is appended in chronological order. Arbitrary
terminal dependence on that record becomes a whole-path observable on the
original state space; no measure or symmetry on records is required. -/

open Finset

namespace Bounty

section

variable {K X O : Type*} (E : K → X → Type*)
  (target : ∀ k x, E k x → X) (observe : ∀ k x, E k x → O)

def finiteObservationLedgerUpdate (k : K) (record : List O) (x : X) (e : E k x) : List O :=
  record ++ [observe k x e]

def finiteEventPathObservations : ∀ ks x, FiniteEventPath E target ks x → List O
  | [], _, _ => []
  | k :: ks, x, ⟨e, p⟩ =>
      observe k x e :: finiteEventPathObservations ks (target k x e) p

theorem finite_event_path_observations_length (ks : List K) (x : X)
    (p : FiniteEventPath E target ks x) :
    (finiteEventPathObservations E target observe ks x p).length = ks.length := by
  induction ks generalizing x with
  | nil => rfl
  | cons k ks ih =>
    rcases p with ⟨e, p⟩
    exact congrArg Nat.succ (ih (target k x e) p)

theorem finite_event_path_observation_ledger (ks : List K) (record : List O) (x : X)
    (p : FiniteEventPath E target ks x) :
    finiteEventPathLedger E target (finiteObservationLedgerUpdate E observe) ks record x p =
      record ++ finiteEventPathObservations E target observe ks x p := by
  induction ks generalizing record x with
  | nil => exact (List.append_nil record).symm
  | cons k ks ih =>
    rcases p with ⟨e, p⟩
    simp only [finiteEventPathLedger, finiteEventPathObservations, ih,
      finiteObservationLedgerUpdate, List.append_assoc, List.singleton_append]

theorem finite_recorded_observation_path_terminal (ks : List K) (record : List O) (x : X)
    (p : FiniteEventPath (fun k (s : List O × X) => E k s.2)
      (finiteLedgerEventTarget E target (finiteObservationLedgerUpdate E observe)) ks (record, x)) :
    finiteEventPathTerminal (fun k (s : List O × X) => E k s.2)
      (finiteLedgerEventTarget E target (finiteObservationLedgerUpdate E observe)) ks (record, x) p =
      (record ++ finiteEventPathObservations E target observe ks x
        (finiteLedgerEventPathEquiv E target (finiteObservationLedgerUpdate E observe) ks record x p),
       finiteEventPathTerminal E target ks x
        (finiteLedgerEventPathEquiv E target (finiteObservationLedgerUpdate E observe) ks record x p)) := by
  rw [finite_ledger_event_path_terminal, finite_event_path_observation_ledger]

variable [∀ k x, Fintype (E k x)]

theorem finite_recorded_observation_path_action_with_terminal_factor
    (w : ∀ k x, E k x → ℝ) (ks : List K) (initial : X → List O)
    (phase : ∀ s : List O × X, FiniteEventPath (fun k s => E k s.2)
      (finiteLedgerEventTarget E target (finiteObservationLedgerUpdate E observe)) ks s → ℂ)
    (F : List O → X → ℂ) (f : X → ℂ) :
    (fun x => finiteEventPathAction (fun k (s : List O × X) => E k s.2)
      (finiteLedgerEventTarget E target (finiteObservationLedgerUpdate E observe))
      (fun k s => w k s.2) ks phase (fun s => F s.1 s.2 * f s.2) (initial x, x)) =
    finiteEventPathAction E target w ks
      (fun x p =>
        phase (initial x, x)
          ((finiteLedgerEventPathEquiv E target (finiteObservationLedgerUpdate E observe)
            ks (initial x) x).symm p) *
        F (initial x ++ finiteEventPathObservations E target observe ks x p)
          (finiteEventPathTerminal E target ks x p)) f := by
  classical
  funext x
  let _ := finiteEventPathFintype E target ks x
  let _ := finiteEventPathFintype (fun k (s : List O × X) => E k s.2)
    (finiteLedgerEventTarget E target (finiteObservationLedgerUpdate E observe)) ks (initial x, x)
  unfold finiteEventPathAction
  rw [← (finiteLedgerEventPathEquiv E target (finiteObservationLedgerUpdate E observe)
    ks (initial x) x).symm.sum_comp]
  apply sum_congr rfl
  intro p _
  rw [finite_ledger_event_path_weight, finite_recorded_observation_path_terminal]
  simp only [Equiv.apply_symm_apply]
  ring

theorem finite_recorded_observation_path_action
    (w : ∀ k x, E k x → ℝ) (ks : List K) (initial : X → List O)
    (phase : ∀ s : List O × X, FiniteEventPath (fun k s => E k s.2)
      (finiteLedgerEventTarget E target (finiteObservationLedgerUpdate E observe)) ks s → ℂ)
    (F : List O → X → ℂ) :
    (fun x => finiteEventPathAction (fun k (s : List O × X) => E k s.2)
      (finiteLedgerEventTarget E target (finiteObservationLedgerUpdate E observe))
      (fun k s => w k s.2) ks phase (fun s => F s.1 s.2) (initial x, x)) =
    finiteEventPathAction E target w ks
      (fun x p =>
        phase (initial x, x)
          ((finiteLedgerEventPathEquiv E target (finiteObservationLedgerUpdate E observe)
            ks (initial x) x).symm p) *
        F (initial x ++ finiteEventPathObservations E target observe ks x p)
          (finiteEventPathTerminal E target ks x p)) (fun _ => 1) := by
  simpa only [mul_one] using
    finite_recorded_observation_path_action_with_terminal_factor E target observe w ks initial phase F
      (fun _ => 1)

end

end Bounty
end

section

/- Dyadic endpoint, cardinality, and occupied-cell bounds from polynomial logarithmic scales. -/

open scoped BigOperators Classical

namespace Bounty

theorem finite_dyadic_test_ne_zero {X : Type*} (π : X → ℕ) (f : X → ℂ)
    {j : ℕ} {x : X} (hx : finiteDyadicTest π j f x ≠ 0) : f x ≠ 0 := by
  unfold finiteDyadicTest at hx
  split_ifs at hx
  · exact hx
  · exact (hx rfl).elim

theorem finite_dyadic_endpoint_scales {X : Type*} (π : X → ℕ) (f : X → ℂ)
    (hπ : ∀ x, 0 < π x) {M H : ℝ}
    (hmin : ∀ x, f x ≠ 0 → 2 * M ≤ (π x : ℝ))
    (hmax : ∀ x, Real.log (π x) ≤ H) {j : ℕ}
    (hj : ∃ x, finiteDyadicTest π j f x ≠ 0) :
    M ≤ (2 ^ j : ℕ) ∧ Real.log (2 ^ j : ℕ) ≤ H := by
  obtain ⟨x, hx⟩ := hj
  have hfx := finite_dyadic_test_ne_zero π f hx
  have hb := finite_dyadic_test_range π f (fun x _ => hπ x) j x hx
  constructor
  · have hu : (π x : ℝ) < 2 * (2 ^ j : ℕ) := by exact_mod_cast hb.2
    linarith [hmin x hfx]
  · exact (Real.log_le_log (by positivity) (by exact_mod_cast hb.1)).trans (hmax x)

theorem finite_dyadic_card_polynomial {X : Type*} [Fintype X]
    (π : X → ℕ) (hπ : ∀ x, 0 < π x) {L s : ℝ} (hL : 4 ≤ L) (hs : 0 ≤ s)
    (hmax : ∀ x, Real.log (π x) ≤ L ^ s) :
    ((finiteDyadicIndices π).card : ℝ) ≤ L ^ (s + 1) := by
  have hL0 : 0 < L := by linarith
  have hL1 : 1 ≤ L := by linarith
  have hp1 : 1 ≤ L ^ s := Real.one_le_rpow hL1 hs
  have hlog2 : (1 : ℝ) / 2 ≤ Real.log 2 := by linarith [Real.log_two_gt_d9]
  have hbound := finite_dyadic_indices_card_le π hπ (Real.rpow_pos_of_pos hL0 s).le hmax
  have hdiv : L ^ s / Real.log 2 ≤ 2 * L ^ s := by
    apply (div_le_iff₀ (Real.log_pos (by norm_num : (1 : ℝ) < 2))).mpr
    nlinarith [mul_nonneg (Real.rpow_pos_of_pos hL0 s).le (sub_nonneg.mpr hlog2)]
  calc
    _ ≤ L ^ s / Real.log 2 + 1 := hbound
    _ ≤ 3 * L ^ s := by linarith
    _ ≤ L * L ^ s := mul_le_mul_of_nonneg_right (by linarith) (by positivity)
    _ = L ^ (s + 1) := by rw [Real.rpow_add hL0, Real.rpow_one]; ring

theorem dyadic_log_product_polynomial {U V L s : ℝ}
    (hU : 0 < U) (hV : 0 < V) (hL : 2 ≤ L)
    (hlogU : Real.log U ≤ L ^ s) (hlogV : Real.log V ≤ L ^ s) :
    Real.log (U * V) ≤ L ^ (s + 1) := by
  have hL0 : 0 < L := by linarith
  rw [Real.log_mul hU.ne' hV.ne', Real.rpow_add hL0, Real.rpow_one]
  have hm := mul_le_mul_of_nonneg_right hL (Real.rpow_pos_of_pos hL0 s).le
  nlinarith

theorem polynomial_width_le_log_two {L w : ℝ} (hL : 4 ≤ L) (hw : 1 ≤ w) :
    L ^ (-w) ≤ Real.log 2 := by
  have hL0 : 0 < L := by linarith
  calc
    _ ≤ L ^ (-(1 : ℝ)) := Real.rpow_le_rpow_of_exponent_le (by linarith) (by linarith)
    _ = 1 / L := by rw [Real.rpow_neg_one, one_div]
    _ ≤ (1 : ℝ) / 4 := one_div_le_one_div_of_le (by norm_num) hL
    _ ≤ Real.log 2 := by linarith [Real.log_two_gt_d9]

theorem two_upper_log_cell_cards_polynomial
    {X Y : Type*} [Fintype X] [Fintype Y] (p : X → ℝ) (q : Y → ℝ)
    {L s w : ℝ} (hL : 4 ≤ L) (hs : 0 ≤ s) (hw : 0 ≤ w)
    (hp : ∀ x, 0 ≤ p x ∧ p x ≤ L ^ s) (hq : ∀ y, 0 ≤ q y ∧ q y ≤ L ^ s) :
    (((finiteOccupiedCells (fun x => upperLogCell (L ^ (-w)) (p x))).card +
      (finiteOccupiedCells (fun y => upperLogCell (L ^ (-w)) (q y))).card : ℕ) : ℝ) ≤
      L ^ (s + w + 2) := by
  have hL0 : 0 < L := by linarith
  have hL1 : 1 ≤ L := by linarith
  have hh : 0 < L ^ (-w) := Real.rpow_pos_of_pos hL0 _
  have hP := upper_log_occupied_cells_card_real_le p hh (by positivity : 0 ≤ L ^ s) hp
  have hQ := upper_log_occupied_cells_card_real_le q hh (by positivity : 0 ≤ L ^ s) hq
  have he : (L ^ s - 0) / L ^ (-w) = L ^ (s + w) := by
    rw [sub_zero, ← Real.rpow_sub hL0]
    congr 1
    ring
  rw [he] at hP hQ
  have hp1 : 1 ≤ L ^ (s + w) := Real.one_le_rpow hL1 (by linarith)
  have hsq : (6 : ℝ) ≤ L ^ (2 : ℕ) := by nlinarith
  have hm := mul_le_mul_of_nonneg_right hsq (Real.rpow_pos_of_pos hL0 (s + w)).le
  push_cast
  calc
    _ ≤ 2 * L ^ (s + w) + 4 := by linarith
    _ ≤ 6 * L ^ (s + w) := by linarith
    _ ≤ L ^ (2 : ℕ) * L ^ (s + w) := hm
    _ = L ^ (s + w) * L ^ (2 : ℝ) := by rw [Real.rpow_two]; ring
    _ = L ^ (s + w + 2) := (Real.rpow_add hL0 _ _).symm

theorem finite_weighted_pairing_reorder {X Y : Type*} [Fintype X] [Fintype Y]
    (μ : X → ℝ) (ν : Y → ℝ) (f : X → ℂ) (g : Y → ℂ) (K : X → Y → ℂ) :
    (∑ x, ∑ y, ((μ x * ν y : ℝ) : ℂ) * (K x y * f x * g y)) =
      ∑ x, ∑ y, ((μ x : ℂ) * f x) * ((ν y : ℂ) * g y) * K x y := by
  apply Finset.sum_congr rfl
  intro x _
  apply Finset.sum_congr rfl
  intro y _
  push_cast
  ring

end Bounty
end

section

/- Exact finite dyadic partitions of positive natural-number supports. -/

open Finset Filter

namespace Bounty

def dyadicNatBucket (S : Finset ℕ) (k : ℕ) : Finset ℕ :=
  S.filter (fun n => n.log2 = k)

def dyadicNatIndices (S : Finset ℕ) : Finset ℕ := S.image Nat.log2

theorem mem_dyadicNatBucket (S : Finset ℕ) (k n : ℕ) :
    n ∈ dyadicNatBucket S k ↔ n ∈ S ∧ n.log2 = k := by
  exact mem_filter

theorem dyadicNatBucket_subset (S : Finset ℕ) (k : ℕ) :
    dyadicNatBucket S k ⊆ S := filter_subset _ _

theorem dyadicNatBucket_bounds (S : Finset ℕ) (hS : ∀ n ∈ S, 0 < n)
    {k n : ℕ} (hn : n ∈ dyadicNatBucket S k) :
    2 ^ k ≤ n ∧ n < 2 ^ (k + 1) := by
  obtain ⟨hnS, hnk⟩ := (mem_dyadicNatBucket S k n).mp hn
  exact (Nat.log2_eq_iff (hS n hnS).ne').mp hnk

theorem dyadicNatBucket_upper_scale (S : Finset ℕ) (hS : ∀ n ∈ S, 0 < n)
    {k n : ℕ} (hn : n ∈ dyadicNatBucket S k) :
    n ≤ 2 ^ (k + 1) ∧ 2 ^ (k + 1) ≤ 2 * n := by
  obtain ⟨hlow, hupp⟩ := dyadicNatBucket_bounds S hS hn
  constructor
  · exact hupp.le
  · rw [pow_succ]
    omega

theorem dyadicNatBucket_upper_scale_real (S : Finset ℕ) (hS : ∀ n ∈ S, 0 < n)
    {k n : ℕ} (hn : n ∈ dyadicNatBucket S k) :
    (n : ℝ) ≤ (2 : ℝ) ^ (k + 1) ∧ (2 : ℝ) ^ (k + 1) ≤ 2 * (n : ℝ) := by
  exact_mod_cast dyadicNatBucket_upper_scale S hS hn

theorem dyadicNatBucket_eq_filter_interval (S : Finset ℕ)
    (hS : ∀ n ∈ S, 0 < n) (k : ℕ) :
    dyadicNatBucket S k = S.filter (fun n => 2 ^ k ≤ n ∧ n < 2 ^ (k + 1)) := by
  ext n
  simp only [mem_dyadicNatBucket, mem_filter]
  exact and_congr_right (fun hn => Nat.log2_eq_iff (hS n hn).ne')

theorem dyadicNatBucket_disjoint (S : Finset ℕ) {i j : ℕ} (hij : i ≠ j) :
    Disjoint (dyadicNatBucket S i) (dyadicNatBucket S j) := by
  apply disjoint_left.mpr
  intro n hni hnj
  exact hij (((mem_dyadicNatBucket S i n).mp hni).2.symm.trans
    ((mem_dyadicNatBucket S j n).mp hnj).2)

theorem dyadicNatBucket_nonempty_iff (S : Finset ℕ) (k : ℕ) :
    (dyadicNatBucket S k).Nonempty ↔ k ∈ dyadicNatIndices S := by
  simp only [Finset.Nonempty, mem_dyadicNatBucket, dyadicNatIndices, mem_image]

theorem dyadicNatBuckets_biUnion (S : Finset ℕ) :
    (dyadicNatIndices S).biUnion (dyadicNatBucket S) = S := by
  ext n
  simp only [mem_biUnion, mem_dyadicNatBucket]
  constructor
  · rintro ⟨k, hk, hn, hnk⟩
    exact hn
  · intro hn
    exact ⟨n.log2, mem_image_of_mem Nat.log2 hn, hn, rfl⟩

theorem sum_dyadicNatBuckets {E : Type*} [AddCommMonoid E]
    (S : Finset ℕ) (w : ℕ → E) :
    (∑ k ∈ dyadicNatIndices S, ∑ n ∈ dyadicNatBucket S k, w n) = ∑ n ∈ S, w n := by
  exact sum_fiberwise_of_maps_to (fun n hn => mem_image_of_mem Nat.log2 hn) w

theorem dyadicNatIndices_subset_range (S : Finset ℕ) (N : ℕ)
    (hN : ∀ n ∈ S, n ≤ N) :
    dyadicNatIndices S ⊆ range (N.log2 + 1) := by
  intro k hk
  obtain ⟨n, hn, rfl⟩ := mem_image.mp hk
  apply mem_range.mpr
  have h := Nat.log_mono_right (b := 2) (hN n hn)
  simpa only [← Nat.log2_eq_log_two] using Nat.lt_succ_of_le h

theorem sum_dyadicNatBuckets_range {E : Type*} [AddCommMonoid E]
    (S : Finset ℕ) (N : ℕ) (hN : ∀ n ∈ S, n ≤ N) (w : ℕ → E) :
    (∑ k ∈ range (N.log2 + 1), ∑ n ∈ dyadicNatBucket S k, w n) = ∑ n ∈ S, w n := by
  apply sum_fiberwise_of_maps_to
  intro n hn
  exact dyadicNatIndices_subset_range S N hN (mem_image_of_mem Nat.log2 hn)

theorem dyadicNatIndices_card_le (S : Finset ℕ) (N : ℕ)
    (hN : ∀ n ∈ S, n ≤ N) : (dyadicNatIndices S).card ≤ N.log2 + 1 := by
  simpa only [card_range] using card_le_card (dyadicNatIndices_subset_range S N hN)

theorem dyadic_log_count_le_log (N : ℕ) :
    (N.log2 + 1 : ℝ) ≤ Real.log N / Real.log 2 + 1 := by
  have h := Real.log2_le_logb N
  simp only [Real.logb] at h
  linarith

theorem dyadicNatIndices_card_le_log (S : Finset ℕ) (N : ℕ)
    (hN : ∀ n ∈ S, n ≤ N) :
    ((dyadicNatIndices S).card : ℝ) ≤ Real.log N / Real.log 2 + 1 := by
  have h : ((dyadicNatIndices S).card : ℝ) ≤ N.log2 + 1 := by
    exact_mod_cast dyadicNatIndices_card_le S N hN
  exact h.trans (dyadic_log_count_le_log N)

theorem sum_dyadicNatBuckets_bilinear {E : Type*} [AddCommMonoid E]
    (S T : Finset ℕ) (w : ℕ → ℕ → E) :
    (∑ i ∈ dyadicNatIndices S, ∑ j ∈ dyadicNatIndices T,
      ∑ m ∈ dyadicNatBucket S i, ∑ n ∈ dyadicNatBucket T j, w m n) =
      ∑ m ∈ S, ∑ n ∈ T, w m n := by
  rw [← sum_dyadicNatBuckets S (fun m => ∑ n ∈ T, w m n)]
  apply sum_congr rfl
  intro i hi
  rw [sum_comm]
  apply sum_congr rfl
  intro m hm
  exact sum_dyadicNatBuckets T (w m)

theorem norm_bilinear_sum_le_dyadicNatBuckets {E : Type*} [NormedAddCommGroup E]
    (S T : Finset ℕ) (w : ℕ → ℕ → E) :
    ‖∑ m ∈ S, ∑ n ∈ T, w m n‖ ≤
      ∑ i ∈ dyadicNatIndices S, ∑ j ∈ dyadicNatIndices T,
        ‖∑ m ∈ dyadicNatBucket S i, ∑ n ∈ dyadicNatBucket T j, w m n‖ := by
  rw [← sum_dyadicNatBuckets_bilinear S T w]
  apply (norm_sum_le _ _).trans
  apply sum_le_sum
  intro i hi
  exact norm_sum_le _ _


theorem dyadic_log_count_le_linear_of_le_exp {L : ℝ}
    (hL : 1 ≤ L) (h16 : Real.log 16 ≤ L) (N : ℕ)
    (hN : (N : ℝ) ≤ 16 * Real.exp L) :
    (N.log2 + 1 : ℝ) ≤ (2 / Real.log 2 + 1) * L := by
  have hlog : Real.log N ≤ 2 * L := by
    by_cases hn : N = 0
    · simp only [hn, Nat.cast_zero, Real.log_zero]
      linarith
    · have h := Real.log_le_log
        (show (0 : ℝ) < N from Nat.cast_pos.mpr (Nat.pos_of_ne_zero hn)) hN
      rw [Real.log_mul (by norm_num) (Real.exp_pos L).ne', Real.log_exp] at h
      linarith
  have htwo : 0 < Real.log 2 := Real.log_pos (by norm_num)
  calc
    (N.log2 + 1 : ℝ) ≤ Real.log N / Real.log 2 + 1 := dyadic_log_count_le_log N
    _ ≤ 2 * L / Real.log 2 + 1 :=
      add_le_add (div_le_div_of_nonneg_right hlog htwo.le) le_rfl
    _ ≤ 2 * L / Real.log 2 + L := add_le_add le_rfl hL
    _ = _ := by ring

theorem eventually_dyadic_log_count_le_linear :
    ∀ᶠ L : ℝ in atTop, ∀ N : ℕ, (N : ℝ) ≤ 16 * Real.exp L →
      (N.log2 + 1 : ℝ) ≤ (2 / Real.log 2 + 1) * L := by
  filter_upwards [eventually_ge_atTop (1 : ℝ), eventually_ge_atTop (Real.log 16)] with L hL h16
  exact dyadic_log_count_le_linear_of_le_exp hL h16

theorem eventually_dyadicNatIndices_card_le_linear :
    ∀ᶠ L : ℝ in atTop, ∀ (N : ℕ) (S : Finset ℕ),
      (N : ℝ) ≤ 16 * Real.exp L → (∀ n ∈ S, n ≤ N) →
      ((dyadicNatIndices S).card : ℝ) ≤ (2 / Real.log 2 + 1) * L := by
  filter_upwards [eventually_dyadic_log_count_le_linear] with L hL
  intro N S hN hS
  have hcard : ((dyadicNatIndices S).card : ℝ) ≤ N.log2 + 1 := by
    exact_mod_cast dyadicNatIndices_card_le S N hS
  exact hcard.trans (hL N hN)


end Bounty
end

section

/- Removing a prime outside a finite pool commutes with extracting the pool-free part. -/

namespace Bounty

theorem prime_not_dvd_primePoolPart {P : Finset ℕ} {p u : ℕ}
    (hp : p.Prime) (hpP : p ∉ P) : ¬ p ∣ primePoolPart P u := by
  intro h
  exact hpP (Nat.primeFactors_subset_of_mem_factoredNumbers
    (primePoolPart_mem_factoredNumbers P u)
    (hp.mem_primeFactors h (primePoolPart_ne_zero P u)))

theorem prime_dvd_primePoolFreePart_iff {P : Finset ℕ} {p u : ℕ}
    (hp : p.Prime) (hpP : p ∉ P) :
    p ∣ primePoolFreePart P u ↔ p ∣ u := by
  conv_rhs => rw [← primePoolPart_mul_primePoolFreePart P u]
  rw [hp.dvd_mul]
  exact (or_iff_right (prime_not_dvd_primePoolPart hp hpP)).symm

theorem primePoolPart_prime_of_not_mem {P : Finset ℕ} {p : ℕ}
    (hp : p.Prime) (hpP : p ∉ P) : primePoolPart P p = 1 := by
  apply primePoolPart_eq_one_of_disjoint (Q := {p})
  · simpa using hpP
  · apply Nat.mem_factoredNumbers_of_primeFactors_subset hp.ne_zero
    rw [hp.primeFactors]

theorem primePoolPart_div_prime_of_not_mem {P : Finset ℕ} {p u : ℕ}
    (hp : p.Prime) (hpP : p ∉ P) (hu : u ≠ 0) (hpu : p ∣ u) :
    primePoolPart P (u / p) = primePoolPart P u := by
  have hmul : p * (u / p) = u := Nat.mul_div_cancel' hpu
  have hquot : u / p ≠ 0 := by
    intro h
    rw [h, mul_zero] at hmul
    exact hu hmul.symm
  calc
    primePoolPart P (u / p) = primePoolPart P p * primePoolPart P (u / p) := by
      rw [primePoolPart_prime_of_not_mem hp hpP, one_mul]
    _ = primePoolPart P (p * (u / p)) := (primePoolPart_mul P hp.ne_zero hquot).symm
    _ = primePoolPart P u := congrArg (primePoolPart P) hmul

theorem primePoolFreePart_div_prime_of_not_mem {P : Finset ℕ} {p u : ℕ}
    (hp : p.Prime) (hpP : p ∉ P) (hu : u ≠ 0) (hpu : p ∣ u) :
    primePoolFreePart P (u / p) = primePoolFreePart P u / p := by
  unfold primePoolFreePart
  rw [primePoolPart_div_prime_of_not_mem hp hpP hu hpu]
  exact Nat.div_right_comm u p (primePoolPart P u)

end Bounty

end

section

/- The actual normalized remainder after extracting the distinguished Q-zero prime. -/

open Finset Filter

namespace Bounty

theorem ordered_slot_rest_weight_le {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (i : I) (p : choices i) {Z : ℝ} (hZ : 0 ≤ Z) (n : ℕ) :
    orderedSlotWeight (fun j : {j : I // j ≠ i} => choices j.val) Z n ≤
      orderedSlotWeight choices Z (p.val * n) := by
  classical
  rw [ordered_slot_weight_split choices i]
  apply le_trans _ (single_le_sum
    (f := fun q : choices i => ∑ y : ∀ j : {j : I // j ≠ i}, choices j.val,
      if q.val * orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y = p.val * n
      then 1 / Z else 0) (fun _ _ => sum_nonneg (fun _ _ => by split_ifs <;> positivity)) (mem_univ p))
  unfold orderedSlotWeight
  trans ∑ y : ∀ j : {j : I // j ≠ i}, choices j.val,
    if orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y = n then 1 / Z else 0
  · apply le_of_eq
    apply sum_congr
    · ext y; simp
    · intro y _; rfl
  · apply sum_le_sum
    intro y _
    split_ifs with hy hmul hmul
    · exact le_rfl
    · exact False.elim (hmul (congrArg (fun k => p.val * k) hy))
    · positivity
    · exact le_rfl

theorem ordered_slot_weight_divisor_split {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (i : I) (Z : ℝ)
    (hp0 : ∀ p ∈ choices i, p ≠ 0) (n : ℕ) :
    orderedSlotWeight choices Z n =
      ∑ p ∈ choices i, if p ∣ n then
        orderedSlotWeight (fun j : {j : I // j ≠ i} => choices j.val) Z (n / p) else 0 := by
  classical
  rw [ordered_slot_weight_split choices i, ← sum_coe_sort (choices i)]
  apply sum_congr rfl
  intro p _
  by_cases hd : p.val ∣ n
  · rw [if_pos hd]
    unfold orderedSlotWeight
    apply sum_congr
    · ext y; simp
    · intro y _
      have heq : p.val * orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y = n ↔
          orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y = n / p.val := by
        constructor
        · intro h
          apply Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero (hp0 p.val p.property))
          exact h.trans (Nat.mul_div_cancel' hd).symm
        · intro h
          rw [h, Nat.mul_div_cancel' hd]
      simp only [heq]
  · rw [if_neg hd]
    apply sum_eq_zero
    intro y _
    apply if_neg
    intro h
    exact hd ⟨_, h.symm⟩

noncomputable def candidateQRestWeight (c L : ℝ) (r jStar : ℕ) (hr : 0 < r) (n : ℕ) : ℝ :=
  orderedSlotWeight (candidateQRestChoices c L r jStar hr)
    ((r.factorial : ℝ) ^ (candidateQIndices c L).card) n

theorem candidate_Q_rest_weight_nonneg (c L : ℝ) (r jStar : ℕ) (hr : 0 < r) (n : ℕ) :
    0 ≤ candidateQRestWeight c L r jStar hr n :=
  ordered_slot_weight_nonneg _ (by positivity) n

theorem candidate_Q_rest_weight_le_full (c L : ℝ) (r jStar : ℕ)
    (hr : 0 < r) (hj : 0 < jStar) {p : ℕ} (hp : p ∈ candidateQBand (c * L) 0) (n : ℕ) :
    candidateQRestWeight c L r jStar hr n ≤ candidateQWeight c L r jStar (p * n) := by
  have hp' : p ∈ candidateQSlotChoices c L r jStar (candidateFreeSlot c L r hr) := by
    rwa [candidate_Q_free_choice c L r jStar hr hj]
  exact ordered_slot_rest_weight_le (candidateQSlotChoices c L r jStar)
    (candidateFreeSlot c L r hr) ⟨p, hp'⟩ (by positivity) n

theorem candidate_Q_weight_rest_divisor_split (c L : ℝ) (r jStar : ℕ)
    (hr : 0 < r) (hj : 0 < jStar) (n : ℕ) :
    candidateQWeight c L r jStar n =
      ∑ p ∈ candidateQBand (c * L) 0, if p ∣ n then candidateQRestWeight c L r jStar hr (n / p) else 0 := by
  have h := ordered_slot_weight_divisor_split (candidateQSlotChoices c L r jStar)
    (candidateFreeSlot c L r hr) ((r.factorial : ℝ) ^ (candidateQIndices c L).card)
    (fun p hp => candidate_Q_slot_nonzero c L r jStar _ hp) n
  rw [candidate_Q_free_choice c L r jStar hr hj] at h
  exact h

theorem eventually_candidate_Q_rest_weight_le_exp_sqrt {c : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) :
    ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, 0 < jStar → ∀ n : ℕ,
      (n : ℝ) ≤ 16 * Real.exp L →
      candidateQRestWeight c L r jStar hr n ≤
        Real.exp ((((6/5 : ℝ) * c + 2) * Real.log 2) * Real.sqrt L) := by
  filter_upwards [eventually_candidateQBand_nonempty hc,
    eventually_candidate_Q_weight_le_roughDivisors hc hr,
    eventually_ge_atTop (Real.log 16), eventually_gt_atTop (0 : ℝ)] with L hband hQ hlarge hL
  intro jStar hj n hn
  obtain ⟨p, hp⟩ := hband 0 (by simp [candidateQIndices])
  have hpdata := (mem_dyadicPrimeBand_iff (c * L) 1 (6/5) 0 p).mp hp
  have hle := candidate_Q_rest_weight_le_full c L r jStar hr hj hp n
  by_cases hn0 : n = 0
  · subst n
    simp only [mul_zero, candidate_Q_weight_zero_at_zero] at hle
    exact hle.trans (Real.exp_pos ((((6/5 : ℝ) * c + 2) * Real.log 2) * Real.sqrt L)).le
  · have hpbound : (p : ℝ) ≤ Real.exp (((6/5 : ℝ) * c) * L) := by
      simpa only [pow_zero, div_one, mul_assoc] using hpdata.2.2
    have hsize : ((p * n : ℕ) : ℝ) ≤ Real.exp (((6/5 : ℝ) * c + 2) * L) := by
      calc
        ((p * n : ℕ) : ℝ) = (p : ℝ) * n := Nat.cast_mul p n
        _ ≤ Real.exp (((6/5 : ℝ) * c) * L) * Real.exp (2 * L) :=
          mul_le_mul hpbound (wide_window_nat_le_exp_twice hlarge hn) (Nat.cast_nonneg n)
            (Real.exp_pos _).le
        _ = _ := by rw [← Real.exp_add]; congr 1; ring
    exact hle.trans ((hQ jStar (p * n)).trans
      (roughDivisors_card_le_exp_sqrt hL (Nat.mul_ne_zero hpdata.1.ne_zero hn0) hsize))

noncomputable def candidateRemainderCoefficient (c L q : ℝ) (r jStar : ℕ)
    (hr : 0 < r) (u : ℕ) : ℝ :=
  candidateQRestWeight c L r jStar hr
    (primePoolFreePart ((candidatePIndices c L).biUnion (candidatePBand (c * L))) u) *
  markedDivisorWeight (candidatePIndices c L) (candidatePBand (c * L)) q
    (fun j => ∑ p ∈ candidatePBand (c * L) j, 1 / (p : ℝ)) (fun _ => 1) (u : ℤ)

theorem candidate_remainder_coefficient_nonneg (c L : ℝ) {q : ℝ} (hq : 0 ≤ q)
    (r jStar : ℕ) (hr : 0 < r) (u : ℕ) :
    0 ≤ candidateRemainderCoefficient c L q r jStar hr u := by
  apply mul_nonneg (candidate_Q_rest_weight_nonneg _ _ _ _ _ _)
  exact marked_divisor_weight_nonneg _ _ hq _ _
    (fun _ _ => sum_nonneg (fun _ _ => by positivity)) _

theorem eventually_candidate_remainder_coefficient_le_exp_sqrt {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1) :
    ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, 0 < jStar → ∀ u : ℕ,
      (u : ℝ) ≤ 16 * Real.exp L →
      candidateRemainderCoefficient c L q r jStar hr u ≤
        Real.exp (((((6/5 : ℝ) * c + 2) * Real.log 2) + 1) * Real.sqrt L) := by
  filter_upwards [eventually_candidate_Q_rest_weight_le_exp_sqrt hc hr,
    eventually_candidate_marked_multiplier_bound hc hq0 hq1 (((6/5 : ℝ) * c + 2) * Real.log 2)]
      with L hrest hmarked
  intro jStar hj u hu
  have hfree : (primePoolFreePart ((candidatePIndices c L).biUnion (candidatePBand (c * L))) u : ℝ) ≤
      16 * Real.exp L :=
    (Nat.cast_le.mpr (Nat.div_le_self _ _)).trans hu
  exact hmarked (u : ℤ) _ (candidate_Q_rest_weight_nonneg _ _ _ _ _ _)
    (hrest jStar hj _ hfree)

end Bounty
end

section

/- Elementary numerical bounds for bilinear large-sieve errors. -/

namespace Bounty

theorem sqrt_add_square_le {P R : ℝ} (hP : 0 ≤ P) (hR : 0 ≤ R) :
    Real.sqrt (P + R ^ 2) ≤ Real.sqrt P + R := by
  apply Real.sqrt_le_iff.mpr
  constructor
  · positivity
  · nlinarith [Real.sq_sqrt hP, mul_nonneg (Real.sqrt_nonneg P) hR]

theorem large_sieve_sqrt_expand {P U R : ℝ} (hP : 0 ≤ P) (hU : 0 ≤ U) (hR : 0 ≤ R) :
    Real.sqrt ((P + R ^ 2) * (U + R ^ 2) * P * U) ≤
      P * U + R * P * Real.sqrt U + R * U * Real.sqrt P +
        R ^ 2 * Real.sqrt (P * U) := by
  have hP' : 0 ≤ P + R ^ 2 := by positivity
  have hU' : 0 ≤ U + R ^ 2 := by positivity
  have heq : (P + R ^ 2) * (U + R ^ 2) * P * U =
      ((P + R ^ 2) * P) * ((U + R ^ 2) * U) := by ring
  rw [heq, Real.sqrt_mul (mul_nonneg hP' hP), Real.sqrt_mul hP', Real.sqrt_mul hU']
  calc
    _ ≤ ((Real.sqrt P + R) * Real.sqrt P) *
        ((Real.sqrt U + R) * Real.sqrt U) := by
      exact mul_le_mul
        (mul_le_mul_of_nonneg_right (sqrt_add_square_le hP hR) (Real.sqrt_nonneg P))
        (mul_le_mul_of_nonneg_right (sqrt_add_square_le hU hR) (Real.sqrt_nonneg U))
        (by positivity) (by positivity)
    _ = _ := by
      rw [Real.sqrt_mul hP]
      simp only [add_mul, Real.mul_self_sqrt hP, Real.mul_self_sqrt hU]
      ring

theorem large_sieve_sqrt_div_expand {P U R : ℝ}
    (hP : 0 ≤ P) (hU : 0 ≤ U) (hR : 0 < R) :
    Real.sqrt ((P + R ^ 2) * (U + R ^ 2) * P * U) / R ≤
      P * U / R + P * Real.sqrt U + U * Real.sqrt P + R * Real.sqrt (P * U) := by
  apply (div_le_div_of_nonneg_right (large_sieve_sqrt_expand hP hU hR.le) hR.le).trans
  exact le_of_eq (by field_simp)

theorem large_sieve_energy_factor {P U R E F W : ℝ}
    (hP : 0 ≤ P) (hU : 0 ≤ U) (hF : 0 ≤ F) (hW : 0 ≤ W)
    (hEP : E ≤ P * W) (hFU : F ≤ U * W) :
    Real.sqrt ((P + R ^ 2) * (U + R ^ 2) * E * F) ≤
      W * Real.sqrt ((P + R ^ 2) * (U + R ^ 2) * P * U) := by
  have hfactor : 0 ≤ (P + R ^ 2) * (U + R ^ 2) := by positivity
  have hEF : E * F ≤ (P * W) * (U * W) :=
    mul_le_mul hEP hFU hF (mul_nonneg hP hW)
  have h := Real.sqrt_le_sqrt (mul_le_mul_of_nonneg_left hEF hfactor)
  have heq : ((P + R ^ 2) * (U + R ^ 2)) * ((P * W) * (U * W)) =
      W ^ 2 * ((P + R ^ 2) * (U + R ^ 2) * P * U) := by ring
  rw [heq, Real.sqrt_mul (sq_nonneg W), Real.sqrt_sq hW] at h
  simpa only [mul_assoc] using h

theorem sqrt_exp_half (x : ℝ) : Real.sqrt (Real.exp x) = Real.exp (x / 2) := by
  apply (Real.sqrt_eq_iff_mul_self_eq (Real.exp_nonneg _) (Real.exp_nonneg _)).mpr
  rw [← Real.exp_add]
  congr 1
  ring

theorem large_sieve_exponential_ranges {P U R L a eta theta C : ℝ}
    (hC : 0 ≤ C) (hP : Real.exp (a * L) ≤ P) (hU : Real.exp (a * L) ≤ U)
    (hPU : P * U ≤ C * Real.exp L)
    (hRlo : Real.exp (eta * L) ≤ R) (hRhi : R ≤ Real.exp (theta * L)) :
    Real.sqrt ((P + R ^ 2) * (U + R ^ 2) * P * U) / R ≤
      C * Real.exp ((1 - eta) * L) +
        2 * C * Real.exp ((1 - a / 2) * L) +
          Real.sqrt C * Real.exp ((theta + 1 / 2) * L) := by
  have hP0 : 0 < P := (Real.exp_pos _).trans_le hP
  have hU0 : 0 < U := (Real.exp_pos _).trans_le hU
  have hR0 : 0 < R := (Real.exp_pos _).trans_le hRlo
  have hsP : Real.exp ((a / 2) * L) ≤ Real.sqrt P := by
    have h := Real.sqrt_le_sqrt hP
    rw [sqrt_exp_half] at h
    convert h using 1
    congr 1
    ring
  have hsU : Real.exp ((a / 2) * L) ≤ Real.sqrt U := by
    have h := Real.sqrt_le_sqrt hU
    rw [sqrt_exp_half] at h
    convert h using 1
    congr 1
    ring
  have hfirst : P * U / R ≤ C * Real.exp ((1 - eta) * L) := by
    calc
      _ ≤ (C * Real.exp L) / R := div_le_div_of_nonneg_right hPU hR0.le
      _ ≤ (C * Real.exp L) / Real.exp (eta * L) :=
        div_le_div_of_nonneg_left (mul_nonneg hC (Real.exp_nonneg _)) (Real.exp_pos _) hRlo
      _ = _ := by rw [mul_div_assoc, ← Real.exp_sub]; congr 2; ring
  have hsecond : P * Real.sqrt U ≤ C * Real.exp ((1 - a / 2) * L) := by
    calc
      _ = P * U / Real.sqrt U := by rw [mul_div_assoc, Real.div_sqrt]
      _ ≤ (C * Real.exp L) / Real.sqrt U :=
        div_le_div_of_nonneg_right hPU (Real.sqrt_nonneg _)
      _ ≤ (C * Real.exp L) / Real.exp ((a / 2) * L) :=
        div_le_div_of_nonneg_left (mul_nonneg hC (Real.exp_nonneg _)) (Real.exp_pos _) hsU
      _ = _ := by rw [mul_div_assoc, ← Real.exp_sub]; congr 2; ring
  have hthird : U * Real.sqrt P ≤ C * Real.exp ((1 - a / 2) * L) := by
    calc
      _ = P * U / Real.sqrt P := by rw [mul_comm P U, mul_div_assoc, Real.div_sqrt]
      _ ≤ (C * Real.exp L) / Real.sqrt P :=
        div_le_div_of_nonneg_right hPU (Real.sqrt_nonneg _)
      _ ≤ (C * Real.exp L) / Real.exp ((a / 2) * L) :=
        div_le_div_of_nonneg_left (mul_nonneg hC (Real.exp_nonneg _)) (Real.exp_pos _) hsP
      _ = _ := by rw [mul_div_assoc, ← Real.exp_sub]; congr 2; ring
  have hfourth : R * Real.sqrt (P * U) ≤
      Real.sqrt C * Real.exp ((theta + 1 / 2) * L) := by
    calc
      _ ≤ Real.exp (theta * L) * Real.sqrt (C * Real.exp L) :=
        mul_le_mul hRhi (Real.sqrt_le_sqrt hPU) (Real.sqrt_nonneg _) (Real.exp_nonneg _)
      _ = _ := by
        rw [Real.sqrt_mul hC, sqrt_exp_half, mul_left_comm, ← Real.exp_add]
        congr 2
        ring
  exact (large_sieve_sqrt_div_expand hP0.le hU0.le hR0).trans (by linarith)

end Bounty
end

section

/- Finite coefficient energies from pointwise bounds on positive integer supports. -/

open Finset

namespace Bounty

theorem positive_nat_finset_card_le_real (S : Finset ℕ) {P : ℝ} (hP : 0 ≤ P)
    (hpos : ∀ n ∈ S, 0 < n) (hbound : ∀ n ∈ S, (n : ℝ) ≤ P) :
    (S.card : ℝ) ≤ P := by
  have hsub : S ⊆ Icc 1 ⌊P⌋₊ := by
    intro n hn
    exact mem_Icc.mpr ⟨hpos n hn, Nat.le_floor (hbound n hn)⟩
  calc
    _ ≤ ((Icc 1 ⌊P⌋₊).card : ℝ) := Nat.cast_le.mpr (card_le_card hsub)
    _ = (⌊P⌋₊ : ℝ) := by simp
    _ ≤ P := Nat.floor_le hP

theorem positive_nat_finset_energy_le (S : Finset ℕ) (a : ℕ → ℂ) {P M : ℝ}
    (hP : 0 ≤ P) (hpos : ∀ n ∈ S, 0 < n) (hbound : ∀ n ∈ S, (n : ℝ) ≤ P)
    (ha : ∀ n ∈ S, ‖a n‖ ≤ M) :
    (∑ n ∈ S, ‖a n‖ ^ 2) ≤ P * M ^ 2 := by
  calc
    _ ≤ ∑ _n ∈ S, M ^ 2 := by
      apply sum_le_sum
      intro n hn
      exact pow_le_pow_left₀ (norm_nonneg _) (ha n hn) 2
    _ = (S.card : ℝ) * M ^ 2 := by simp
    _ ≤ P * M ^ 2 := mul_le_mul_of_nonneg_right
      (positive_nat_finset_card_le_real S hP hpos hbound) (sq_nonneg M)

theorem positive_nat_finset_exponential_energy_le (S : Finset ℕ) (a : ℕ → ℂ)
    {P H L : ℝ} (hP : 0 ≤ P) (hpos : ∀ n ∈ S, 0 < n)
    (hbound : ∀ n ∈ S, (n : ℝ) ≤ P)
    (ha : ∀ n ∈ S, ‖a n‖ ≤ Real.exp (H * Real.sqrt L)) :
    (∑ n ∈ S, ‖a n‖ ^ 2) ≤ P * Real.exp ((2 * H) * Real.sqrt L) := by
  apply (positive_nat_finset_energy_le S a hP hpos hbound ha).trans_eq
  rw [pow_two, ← Real.exp_add]
  congr 2
  ring

end Bounty
end

section

/- Growth margins and complementary-modulus mass for the final large-sieve summation. -/

open Filter Finset

namespace Bounty

theorem eventually_const_mul_exp_le_exp {a b : ℝ} (hab : a < b) (C : ℝ) :
    ∀ᶠ L : ℝ in atTop, C * Real.exp (a * L) ≤ Real.exp (b * L) := by
  have ht := Real.tendsto_exp_atTop.comp (tendsto_id.const_mul_atTop (sub_pos.mpr hab))
  filter_upwards [ht.eventually_ge_atTop C] with L hL
  calc
    _ ≤ Real.exp ((b - a) * L) * Real.exp (a * L) :=
      mul_le_mul_of_nonneg_right hL (Real.exp_nonneg _)
    _ = _ := by rw [← Real.exp_add]; congr 1; ring

theorem eventually_squarefree_totient_mass_le_linear :
    ∀ᶠ L : ℝ in atTop, ∀ N : ℕ, (N : ℝ) ≤ Real.exp L →
      (∑ d ∈ (Icc 1 N).filter Squarefree, 1 / (Nat.totient d : ℝ)) ≤
        (4 * primeEulerProductUpperConstant) * L := by
  filter_upwards [eventually_ge_atTop (Real.log 2), eventually_ge_atTop (0 : ℝ)]
    with L hlog hL
  intro N hN
  have hD : (1 : ℝ) ≤ Real.exp L := Real.one_le_exp_iff.mpr hL
  have h := totient_sieve_squarefree_mass_le_log N hD hN
  rw [Real.log_mul (by norm_num) (Real.exp_ne_zero L), Real.log_exp] at h
  apply h.trans
  have hC : 0 < primeEulerProductUpperConstant := primeEulerProductUpperConstant_pos
  nlinarith

end Bounty
end

section

/- The raw continuation may observe the auxiliary draw. The exact full
event retains that draw, in addition to the original weight, phase and caps. -/

open Finset
open scoped Classical
namespace Bounty

section Full
variable {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
  [∀ g, DecidableEq (P g)] (n : (g : Fin N) → P g → ℕ)
  {M : Fin N → ℕ} (S : (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : SharedActiveLabels P S → Type*) [∀ c, Fintype (A c)]
  (Δ D : ∀ c, A c → Fin N → ℤ)
  (target : (g : Fin N) → Fin (S g)ᶜ.card → P g)
  (H : (g : Fin N) → Finset (P g))
  (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)

theorem full_edge_ledger_observed_rows
    (β : (g : Fin N) → P g → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (ω : ∀ c, A c → ℝ)
    (m : A (productActiveMemorySplit S B x).1 → Prop)
    (row : A (productActiveMemorySplit S B x).1 → (g : Fin N) →
      (GlobalBirthHistoryState (fun p => ZMod (n g p)) → ℂ) →
      GlobalBirthHistoryState (fun p => ZMod (n g p)) → ℂ)
    (hrows : ∀ a, m a → ∀ g (K : GlobalBirthHistoryState (fun p => ZMod (n g p)) → ℂ),
      row a g K (H g, boundedOrderedTupleToFinite (x g).2) =
      ∑ e : UnrestrictedBoundedEvent (n g)
        (Δ (productActiveMemorySplit S B x).1 a g)
        (D (productActiveMemorySplit S B x).1 a g) (S g)ᶜ.card B
        ((productActiveMemorySplit S B x).2 g),
        (unrestrictedBoundedEventWeight (n g)
          (Δ (productActiveMemorySplit S B x).1 a g)
          (D (productActiveMemorySplit S B x).1 a g)
          (fun p => β g p / V g) ρ (V g) (S g)ᶜ.card B
          ((productActiveMemorySplit S B x).2 g) e : ℂ) *
        globalBirthBoundedEdgePhase (n g)
          (Δ (productActiveMemorySplit S B x).1 a g)
          (D (productActiveMemorySplit S B x).1 a g) (S g)ᶜ.card B (target g) (H g)
          ((productActiveMemorySplit S B x).2 g) e.1 e.2.1 e.2.2.1 e.2.2.2 *
        K (H g ∪ univ.image (unrestrictedBoundedEventTarget (n g)
          (Δ (productActiveMemorySplit S B x).1 a g)
          (D (productActiveMemorySplit S B x).1 a g) (S g)ᶜ.card B
          ((productActiveMemorySplit S B x).2 g) e).1,
          boundedOrderedTupleToFinite (unrestrictedBoundedEventTarget (n g)
          (Δ (productActiveMemorySplit S B x).1 a g)
          (D (productActiveMemorySplit S B x).1 a g) (S g)ᶜ.card B
          ((productActiveMemorySplit S B x).2 g) e).2))
    (F : A (productActiveMemorySplit S B x).1 →
      GlobalBirthJointState (fun g p => ZMod (n g p)) → ℂ) :
    (∑ a : A (productActiveMemorySplit S B x).1,
      (ω (productActiveMemorySplit S B x).1 a : ℂ) *
      if m a then jointRawTensorCutoff B (row a) (F a)
        (fun g => (H g, boundedOrderedTupleToFinite (x g).2)) else 0) =
      ∑ e : FullActiveEdgeEvent n S B A Δ D x,
        (fullActiveEdgeEventWeight n S B A Δ D ω (fun g p => β g p / V g) ρ V x e : ℂ) *
        (if m e.1 then fullEdgeLedgerPhase n S B A Δ D target H x e else 0) *
        F e.1 (fullEdgeLedgerRawTarget n S B A Δ D H x e) := by
  rw [Fintype.sum_sigma]
  apply sum_congr rfl
  intro a _
  by_cases ha : m a
  · simp only [ha, if_true]
    rw [joint_raw_tensor_cutoff_edge_events n
      (Δ (productActiveMemorySplit S B x).1 a)
      (D (productActiveMemorySplit S B x).1 a) (fun g => (S g)ᶜ.card) B
      (fun g => ((productActiveMemorySplit S B x).2 g).1) target H
      (fun g => (x g).2) β ρ V (row a) (hrows a ha)]
    rw [mul_sum]
    apply sum_congr rfl
    intro e _
    rw [full_edge_ledger_raw_target_eq]
    simp only [fullActiveEdgeEventWeight, Complex.ofReal_mul, fullEdgeLedgerPhase,
      jointStateEdgePhase, mul_assoc]
    rfl
  · simp only [ha, if_false, mul_zero, zero_mul, sum_const_zero]

end Full
end Bounty
end

section

/- A full ledger row may expose an observation of its actual event to
its continuation. The event, signed weight and local phase are unchanged. -/

open Finset
open scoped Classical
namespace Bounty

section Full
variable {I K O : Type*} {N : ℕ} {P : Fin N → Type*}
  [∀ g, Fintype (P g)] [∀ g, DecidableEq (P g)]
  (n : (g : Fin N) → P g → ℕ) [∀ g p, NeZero (n g p)] {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
  (Δ D : ∀ k c, A k c → Fin N → ℤ)
  (edgePhase : ∀ k, ((g : Fin N) → Finset (P g)) →
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) →
    FullActiveEdgeEvent n (S k) B (A k) (Δ k) (D k) x → ℂ)
  (ω : ∀ k c, A k c → ℝ) (μ : (g : Fin N) → P g → ℝ)
  (q : I → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

noncomputable def fullMixedObservedRow
    (observe : (i : Option (I ⊕ K)) → (s : FullMixedLedgerState n (M := M) B) →
      FullPermutationMixedEvent n S B A Δ D i s.2 → O)
    (i : Option (I ⊕ K)) (F : O → FullMixedLedgerState n (M := M) B → ℂ)
    (s : FullMixedLedgerState n (M := M) B) : ℂ :=
  let _ : ∀ (i : Option (I ⊕ K)) x, Fintype (FullPermutationMixedEvent n S B A Δ D i x) :=
    fullPermutationMixedEventFintype n S B A Δ D
  ∑ e : FullPermutationMixedEvent n S B A Δ D i s.2,
    (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V i s.2 e : ℂ) *
      fullMixedLedgerPhase n S B A Δ D edgePhase i s e *
        F (observe i s e) (fullMixedLedgerTarget n S B A Δ D i s e)

theorem full_mixed_observed_row_constant
    (observe : (i : Option (I ⊕ K)) → (s : FullMixedLedgerState n (M := M) B) →
      FullPermutationMixedEvent n S B A Δ D i s.2 → O)
    (i : Option (I ⊕ K)) (F : FullMixedLedgerState n (M := M) B → ℂ)
    (s : FullMixedLedgerState n (M := M) B) :
    fullMixedObservedRow n S B A Δ D edgePhase ω μ q ρ V observe i (fun _ => F) s =
      fullMixedLedgerRow n S B A Δ D edgePhase ω μ q ρ V i F s := by
  unfold fullMixedObservedRow fullMixedLedgerRow finiteLocalPhasedRow
  apply sum_congr
  · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
  · intro e _
    rfl

end Full
end Bounty
end

section

/- Exact observation-aware row identities remain exact after recording
any deterministic history update. The update may inspect both source and
target states as well as the exposed observation. -/

namespace Bounty

noncomputable def finiteObservedRecordRow {X Y O H V : Type*}
    (row : (O → Y → V) → X → V) (update : H → X → O → Y → H)
    (F : H × Y → V) (s : H × X) : V :=
  row (fun o y => F (update s.1 s.2 o y, y)) s.2

theorem finite_observed_record_row_intertwines {X Y X' Y' O H V : Type*}
    (rowS : (O → Y → V) → X → V) (rowT : (O → Y' → V) → X' → V)
    (before : X → X') (after : Y → Y')
    (hrow : ∀ F : O → Y' → V,
      rowS (fun o => F o ∘ after) = rowT F ∘ before)
    (update : H → X' → O → Y' → H) (F : H × Y' → V) :
    finiteObservedRecordRow rowS (fun h x o y => update h (before x) o (after y))
      (F ∘ Prod.map id after) =
    finiteObservedRecordRow rowT update F ∘ Prod.map id before := by
  funext s
  exact congrFun (hrow (fun o y => F (update s.1 (before s.2) o y, y))) s.2

theorem finite_observed_record_history_intertwines
    {S T : Nat → Type*} {O H V : Type*}
    (rowS : (i : Nat) → (O → S (i + 1) → V) → S i → V)
    (rowT : (i : Nat) → (O → T (i + 1) → V) → T i → V)
    (readout : (i : Nat) → S i → T i)
    (hrow : ∀ i (F : O → T (i + 1) → V),
      rowS i (fun o => F o ∘ readout (i + 1)) = rowT i F ∘ readout i)
    (update : (i : Nat) → H → T i → O → T (i + 1) → H)
    (steps : Nat) (F : H × T steps → V) :
    finiteRowComposition (S := fun i => H × S i)
      (fun i => finiteObservedRecordRow (rowS i)
        (fun h x o y => update i h (readout i x) o (readout (i + 1) y))) steps
      (F ∘ Prod.map id (readout steps)) =
    finiteRowComposition (S := fun i => H × T i)
      (fun i => finiteObservedRecordRow (rowT i) (update i)) steps F ∘
        Prod.map id (readout 0) := by
  apply finite_row_composition_intertwines
  intro i G
  exact finite_observed_record_row_intertwines (rowS i) (rowT i)
    (readout i) (readout (i + 1)) (hrow i) (update i) G

end Bounty
end

section

/- Relabeling a finite schedule preserves every dependent event, endpoint
and signed weight. Arbitrary whole-path phases are transported through the
path equivalence, including their dependence on positions in the schedule. -/

open Finset
namespace Bounty

section Map
variable {I K X : Type*} (E : K → X → Type*)
  (target : ∀ k x, E k x → X) (tag : I → K)

def finiteEventPathMapEquiv : ∀ ks x,
    FiniteEventPath (fun i => E (tag i)) (fun i => target (tag i)) ks x ≃
      FiniteEventPath E target (ks.map tag) x
  | [], _ => Equiv.refl _
  | i :: ks, x => Equiv.sigmaCongrRight (fun e : E (tag i) x =>
      finiteEventPathMapEquiv ks (target (tag i) x e))

theorem finite_event_path_map_terminal (ks : List I) (x : X)
    (p : FiniteEventPath (fun i => E (tag i)) (fun i => target (tag i)) ks x) :
    finiteEventPathTerminal (fun i => E (tag i)) (fun i => target (tag i)) ks x p =
      finiteEventPathTerminal E target (ks.map tag) x (finiteEventPathMapEquiv E target tag ks x p) := by
  induction ks generalizing x with
  | nil => rfl
  | cons i ks ih =>
    rcases p with ⟨e, p⟩
    exact ih (target (tag i) x e) p

theorem finite_event_path_map_weight (w : ∀ k x, E k x → ℝ) (ks : List I) (x : X)
    (p : FiniteEventPath (fun i => E (tag i)) (fun i => target (tag i)) ks x) :
    finiteEventPathWeight (fun i => E (tag i)) (fun i => target (tag i))
      (fun i => w (tag i)) ks x p =
    finiteEventPathWeight E target w (ks.map tag) x (finiteEventPathMapEquiv E target tag ks x p) := by
  induction ks generalizing x with
  | nil => rfl
  | cons i ks ih =>
    rcases p with ⟨e, p⟩
    exact congrArg (w (tag i) x e * ·) (ih (target (tag i) x e) p)

variable [∀ k x, Fintype (E k x)]

theorem finite_event_path_action_map (w : ∀ k x, E k x → ℝ) (ks : List I)
    (phase : ∀ x, FiniteEventPath (fun i => E (tag i)) (fun i => target (tag i)) ks x → ℂ)
    (F : X → ℂ) :
    finiteEventPathAction (fun i => E (tag i)) (fun i => target (tag i))
      (fun i => w (tag i)) ks phase F =
    finiteEventPathAction E target w (ks.map tag)
      (fun x p => phase x ((finiteEventPathMapEquiv E target tag ks x).symm p)) F := by
  classical
  funext x
  let _ := finiteEventPathFintype (fun i => E (tag i)) (fun i => target (tag i)) ks x
  let _ := finiteEventPathFintype E target (ks.map tag) x
  unfold finiteEventPathAction
  rw [← (finiteEventPathMapEquiv E target tag ks x).symm.sum_comp]
  apply sum_congr rfl
  intro p _
  rw [finite_event_path_map_weight, finite_event_path_map_terminal]
  simp only [Equiv.apply_symm_apply]

end Map
end Bounty
end

section

/- Finite label pools bound coherent physical memory. Every phase snapshot
has at most one pending state per label, so sufficiently large finite caps
can be erased exactly. No bound on unrestricted repeated-label tuples is
asserted. -/

open Finset

namespace Bounty

theorem global_birth_coherent_length_le_card {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (active born : Finset P) (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent active born q) : q.1 ≤ Fintype.card P := by
  simpa only [Fintype.card_fin] using
    Fintype.card_le_of_injective (Sigma.fst ∘ q.2) hq.label_injective

section Joint

variable {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
  [∀ g, DecidableEq (P g)] {R : (g : Fin N) → P g → Type*}

theorem global_birth_joint_coherent_length_le_sum_card
    (a : (g : Fin N) → P g → Bool) (s : GlobalBirthJointState R)
    (hs : GlobalBirthJointCoherent a s) :
    globalBirthJointLength s ≤ ∑ g, Fintype.card (P g) := by
  apply sum_le_sum
  intro g _
  exact global_birth_coherent_length_le_card _ _ _ (hs g)

omit [∀ g, DecidableEq (P g)] in
theorem global_birth_joint_pending_le_sum_card (z : GlobalBirthJointPhase R) :
    globalBirthJointPending z ≤ ∑ g, Fintype.card (P g) := by
  apply sum_le_sum
  intro g _
  exact card_le_univ _

theorem global_birth_joint_raw_cutoff_of_large_cap
    (a : (g : Fin N) → P g → Bool) (s : GlobalBirthJointState R)
    (hs : GlobalBirthJointCoherent a s) (B : ℕ) (hB : ∑ g, Fintype.card (P g) ≤ B)
    (F : GlobalBirthJointState R → ℂ) : globalBirthJointRawCutoff B F s = F s :=
  if_pos ((global_birth_joint_coherent_length_le_sum_card a s hs).trans hB)

omit [∀ g, DecidableEq (P g)] in
theorem global_birth_joint_phase_cutoff_of_large_cap
    (B : ℕ) (hB : ∑ g, Fintype.card (P g) ≤ B) (F : GlobalBirthJointPhase R → ℂ) :
    globalBirthJointPhaseCutoff B F = F := by
  funext z
  exact if_pos ((global_birth_joint_pending_le_sum_card z).trans hB)

variable [∀ g p, AddGroup (R g p)] [∀ g p, Fintype (R g p)]
  [∀ g p, DecidableEq (R g p)]

theorem global_birth_joint_cut_kernel_of_large_caps
    {a b : (g : Fin N) → P g → Bool}
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (inputCap outputCap : ℕ)
    (hi : ∑ g, Fintype.card (P g) ≤ inputCap)
    (ho : ∑ g, Fintype.card (P g) ≤ outputCap)
    (hl : ∀ g, Fintype.card (P g) ≤ globalBirthRawStepCap (step g))
    (z w : GlobalBirthJointPhase R) :
    globalBirthJointCutKernel step inputCap outputCap z w =
      ∏ g, globalBirthRawStepUncutKernel (step g) (z g) (w g) := by
  unfold globalBirthJointCutKernel globalBirthJointKernel
  rw [if_pos ((global_birth_joint_pending_le_sum_card w).trans hi),
    if_pos ((global_birth_joint_pending_le_sum_card z).trans ho)]
  apply prod_congr rfl
  intro g _
  exact global_birth_raw_step_kernel_of_cap (step g) (z g) (w g)
    ((card_le_univ _).trans (hl g))

theorem global_birth_joint_cut_phase_row_of_large_caps
    {a b : (g : Fin N) → P g → Bool}
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (inputCap outputCap : ℕ)
    (hi : ∑ g, Fintype.card (P g) ≤ inputCap)
    (ho : ∑ g, Fintype.card (P g) ≤ outputCap)
    (hl : ∀ g, Fintype.card (P g) ≤ globalBirthRawStepCap (step g))
    (F : GlobalBirthJointPhase R → ℂ) (w : GlobalBirthJointPhase R) :
    globalBirthJointCutPhaseRow step inputCap outputCap F w =
      ∑ z : GlobalBirthJointPhase R,
        (∏ g, globalBirthRawStepUncutKernel (step g) (z g) (w g)) * F z := by
  rw [global_birth_joint_cut_phase_row_eq]
  apply sum_congr rfl
  intro z _
  rw [global_birth_joint_cut_kernel_of_large_caps step inputCap outputCap hi ho hl]

theorem global_birth_joint_cut_raw_readout_of_large_caps
    {a b : (g : Fin N) → P g → Bool}
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (inputCap outputCap : ℕ)
    (hi : ∑ g, Fintype.card (P g) ≤ inputCap)
    (ho : ∑ g, Fintype.card (P g) ≤ outputCap)
    (hl : ∀ g, Fintype.card (P g) ≤ globalBirthRawStepCap (step g))
    (F : GlobalBirthJointPhase R → ℂ) (s : GlobalBirthJointState R)
    (hs : GlobalBirthJointCoherent a s) :
    globalBirthJointCutRawRow step inputCap outputCap
        (fun t => F (globalBirthJointReadout b t)) s =
      ∑ z : GlobalBirthJointPhase R,
        (∏ g, globalBirthRawStepUncutKernel (step g) (z g)
          (globalBirthJointReadout a s g)) * F z := by
  rw [global_birth_joint_cut_raw_row_intertwines step inputCap outputCap _ F
    (fun _ _ => rfl) s hs]
  exact global_birth_joint_cut_phase_row_of_large_caps step inputCap outputCap hi ho hl F _

end Joint

end Bounty
end

section

/- A full-path phase matters only on paths with nonzero weight. -/

open Finset Classical

namespace Bounty

universe uK uX uE

theorem finite_event_path_action_congr_on_support
    {K : Type uK} {X : Type uX} (E : K → X → Type uE)
    [∀ k x, Fintype (E k x)] (t : ∀ k x, E k x → X)
    (w : ∀ k x, E k x → ℝ) (ks : List K)
    (phase ψ : ∀ x, FiniteEventPath E t ks x → ℂ) (f : X → ℂ) (x : X)
    (hphase : ∀ p, finiteEventPathWeight E t w ks x p ≠ 0 → phase x p = ψ x p) :
    finiteEventPathAction E t w ks phase f x = finiteEventPathAction E t w ks ψ f x := by
  unfold finiteEventPathAction
  apply sum_congr rfl
  intro p _
  by_cases hp : finiteEventPathWeight E t w ks x p = 0
  · simp only [hp, Complex.ofReal_zero, zero_mul]
  · rw [hphase p hp]

end Bounty
end

section

/- Polynomial upper bounds whose eventual threshold is independent of the rough-slot band. -/

open Finset Filter

namespace Bounty

theorem candidate_rough_slot_harmonic_upper_uniform {c L : ℝ}
    (hc : 0 ≤ c) (hL : 0 ≤ L) (j : ℕ) :
    (∑ n ∈ candidateRoughBand c L j, 1 / (n : ℝ)) ≤
      1 + (6/5 : ℝ) * c * L := by
  have hB : 1 ≤ Real.exp ((6/5 : ℝ) * c * L / 2^j) :=
    Real.one_le_exp (by positivity)
  change roughBandHarmonic (Real.exp (c * L / 2^j))
    (Real.exp ((6/5 : ℝ) * c * L / 2^j)) (Real.exp (Real.sqrt L)) ≤ _
  refine (roughBandHarmonic_le_log hB).trans ?_
  rw [Real.log_exp]
  apply add_le_add le_rfl
  exact div_le_self (by positivity) (one_le_pow₀ (by norm_num : (1 : ℝ) ≤ 2))

theorem exists_candidate_Q_harmonic_polynomial_upper_uniform {c : ℝ}
    (hc : 0 < c) (r : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ,
      candidateQHarmonicMass c L r jStar ≤ L^C := by
  obtain ⟨vl, vu, hvl, hvu, hbands⟩ := exists_candidateQBands_bounds hc
  let V : ℝ := max 1 vu
  let K : ℝ := 1 / Real.log 2 + 1
  let E : ℝ := (r : ℝ) * K * Real.log V
  have hV : 1 ≤ V := le_max_left _ _
  have hK : 0 ≤ K := by dsimp [K]; positivity
  have hE : 0 ≤ E :=
    mul_nonneg (mul_nonneg (Nat.cast_nonneg _) hK) (Real.log_nonneg hV)
  refine ⟨E + 2, by linarith, ?_⟩
  filter_upwards [hbands, eventually_ge_atTop (1 : ℝ),
    eventually_ge_atTop (1 + (6/5 : ℝ) * c)] with L hb hL hLbig
  intro jStar
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hZ : 1 ≤ 1 + (6/5 : ℝ) * c * L := le_add_of_nonneg_right (by positivity)
  have hhi : candidateQHarmonicMass c L r jStar ≤
      (1 + (6/5 : ℝ) * c * L) * L^E := by
    apply candidate_Q_harmonic_upper_of_slot_bounds hV hZ hL0 _ _ hb.2.1
    · intro slot hslot
      rw [candidateQSlotChoices, if_neg hslot]
      exact ((hb.2.2 slot.1.val slot.1.property).2.2.2).trans (le_max_right 1 vu)
    · intro slot hslot
      rw [candidateQSlotChoices, if_pos hslot]
      exact candidate_rough_slot_harmonic_upper_uniform hc.le hL0.le jStar
  have hZL : 1 + (6/5 : ℝ) * c * L ≤ L^2 := by
    calc
      _ ≤ L * (1 + (6/5 : ℝ) * c) := by nlinarith
      _ ≤ L * L := mul_le_mul_of_nonneg_left hLbig hL0.le
      _ = _ := by ring
  calc
    _ ≤ (1 + (6/5 : ℝ) * c * L) * L^E := hhi
    _ ≤ L^2 * L^E := mul_le_mul_of_nonneg_right hZL (Real.rpow_nonneg hL0.le E)
    _ = L^(E + 2) := by rw [Real.rpow_add hL0, Real.rpow_two]; ring

theorem exists_candidate_coefficient_mass_polynomial_upper_uniform {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q ≤ 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, 0 < jStar →
      candidateCoefficientWindowMass c L q r jStar ≤ Real.exp L * L^C := by
  obtain ⟨K, hK, hmass⟩ := exists_candidate_coefficient_window_mass_upper hc hq0 hr
  obtain ⟨P, hP, hpmass⟩ := exists_candidate_one_marked_harmonic_polynomial_upper hc hq0 hq1
  obtain ⟨Q, hQ, hqmass⟩ := exists_candidate_Q_harmonic_polynomial_upper_uniform hc r
  refine ⟨P + Q, add_nonneg hP hQ, ?_⟩
  filter_upwards [hmass, hpmass, hqmass,
    eventually_candidate_one_marked_mass_ge_one hc hq0 hq1,
    eventually_ge_atTop K, eventually_gt_atTop (0 : ℝ)] with L hm hp hq hp1 hKL hL
  intro jStar hj
  have hp0 : 0 ≤ candidateOneMarkedHarmonicMass c L q := zero_le_one.trans hp1
  have hq0' : 0 ≤ candidateQHarmonicMass c L r jStar := by
    unfold candidateQHarmonicMass
    exact tsum_nonneg (fun n => div_nonneg (candidate_Q_weight_nonneg c L r jStar n)
      (Nat.cast_nonneg n))
  have hKL' : K / L ≤ 1 := (div_le_one hL).mpr hKL
  calc
    _ ≤ K * (Real.exp L / L) * candidateOneMarkedHarmonicMass c L q *
        candidateQHarmonicMass c L r jStar := hm jStar hj
    _ = (K / L) * (Real.exp L * candidateOneMarkedHarmonicMass c L q *
        candidateQHarmonicMass c L r jStar) := by ring
    _ ≤ Real.exp L * candidateOneMarkedHarmonicMass c L q *
        candidateQHarmonicMass c L r jStar :=
      mul_le_of_le_one_left (by positivity) hKL'
    _ ≤ Real.exp L * L^P * L^Q :=
      mul_le_mul (mul_le_mul_of_nonneg_left hp (Real.exp_pos L).le) (hq jStar) hq0'
        (by positivity)
    _ = Real.exp L * L^(P + Q) := by rw [Real.rpow_add hL]; ring

end Bounty

end

section

/- A uniform logarithmic-conductor bound inside the zero-free half-plane. -/

namespace Bounty

open Complex Metric Set OAI.Ostmann

/-- The zero-free half-plane controls the logarithmic derivative with a fixed
interior margin. The conductor enters only through a logarithm. -/
def PrimitiveZeroFreeRightOf (b : ℝ) : Prop :=
  ∀ χ : PrimitiveComplexCharacter, ∀ s : ℂ, b < s.re → χ.L s ≠ 0

theorem character_logDeriv_bound_right_of (b : ℝ) (hb : 7 / 8 ≤ b) (hb1 : b ≤ 1)
    (hZ : PrimitiveZeroFreeRightOf b)
    (χ : PrimitiveComplexCharacter) {ε : ℝ} (hε : 0 < ε) (hε1 : ε ≤ 1)
    (s : ℂ) (hs : b + ε ≤ s.re) (hs2 : s.re ≤ 2) :
    ‖logDeriv χ.L s‖ ≤ (36 / ε ^ 2) *
      Real.log (24 * (χ.modulus : ℝ) * (|s.im| + 2)) := by
  let c : ℂ := 2 + (s.im : ℂ) * I
  let R : ℝ := 2 - b - ε / 2
  let g : ℂ → ℂ := fun z => χ.L (z + c)
  let A : ℝ := Real.log (24 * (χ.modulus : ℝ) * (|s.im| + 2))
  have hc : c.re = 2 := by simp [c]
  have hq : (1 : ℝ) ≤ χ.modulus := by exact_mod_cast χ.positive
  have hq0 : (0 : ℝ) < χ.modulus := by linarith
  have hR : 0 < R := by dsimp [R]; linarith
  have hR2 : R < 2 := by dsimp [R]; linarith
  have hA : 0 < A := by
    apply Real.log_pos
    nlinarith [abs_nonneg s.im]
  have hg : AnalyticOnNhd ℂ g (ball 0 R) := by
    intro z hz
    exact (χ.L_analytic (z + c)).comp (f := fun w : ℂ => w + c) (x := z) (by fun_prop)
  have hre (z : ℂ) (hz : z ∈ ball 0 R) : b < (z + c).re := by
    have hn : ‖z‖ < R := by simpa only [mem_ball, dist_zero_right] using hz
    have hr := (abs_le.mp (abs_re_le_norm z)).1
    simp only [add_re, hc]
    dsimp [R] at hn
    linarith
  have hne : ∀ z ∈ ball 0 R, g z ≠ 0 := fun z hz => hZ χ (z + c) (hre z hz)
  have hcnorm : ‖c‖ ≤ 2 + |s.im| := by
    calc
      ‖c‖ ≤ ‖(2 : ℂ)‖ + ‖(s.im : ℂ) * I‖ := norm_add_le _ _
      _ = _ := by simp
  have hnorm (z : ℂ) (hz : z ∈ ball 0 R) :
      ‖g z‖ ≤ 8 * (χ.modulus : ℝ) * (|s.im| + 2) := by
    have hn : ‖z‖ < R := by simpa only [mem_ball, dist_zero_right] using hz
    have hzn : ‖z + c‖ ≤ 2 * (|s.im| + 2) := by
      have hh := norm_add_le z c
      linarith [abs_nonneg s.im]
    have hzr : 1 / 2 ≤ (z + c).re := by linarith [hre z hz]
    calc
      ‖g z‖ ≤ ‖z + c‖ * ((χ.modulus : ℝ) + 1) / (z + c).re :=
        χ.L_norm_bound_positive (z + c) (by linarith)
      _ ≤ (2 * (|s.im| + 2)) * (2 * (χ.modulus : ℝ)) / (1 / 2) := by
        apply div_le_div₀ (by positivity) _ (by norm_num) hzr
        exact mul_le_mul hzn (by linarith) (by positivity) (by positivity)
      _ = _ := by ring
  have hlog : ∀ z ∈ ball 0 R, Real.log ‖g z‖ - Real.log ‖g 0‖ ≤ A := by
    intro z hz
    have h0 : 1 / 3 ≤ ‖g 0‖ := by simpa [g] using χ.L_lower_re_two c hc
    have h0pos : 0 < ‖g 0‖ := by linarith
    have hzpos : 0 < ‖g z‖ := norm_pos_iff.mpr (hne z hz)
    rw [← Real.log_div (ne_of_gt hzpos) (ne_of_gt h0pos)]
    apply Real.log_le_log (div_pos hzpos h0pos)
    apply (div_le_iff₀ h0pos).mpr
    have hh := mul_le_mul_of_nonneg_left h0
      (show 0 ≤ 24 * (χ.modulus : ℝ) * (|s.im| + 2) by positivity)
    nlinarith [hnorm z hz]
  have hw : ‖s - c‖ ≤ R - ε / 2 := by
    have heq : s - c = ((s.re - 2 : ℝ) : ℂ) := by
      apply Complex.ext <;> simp [c]
    rw [heq, norm_real, Real.norm_eq_abs, abs_of_nonpos (by linarith)]
    dsimp [R]
    linarith
  have hb := logDeriv_norm_le_margin_disk g R A (ε / 2) hR hA
    (by positivity) hg hne hlog (s - c) hw
  have hcomp : logDeriv g (s - c) = logDeriv χ.L s := by
    have hh := logDeriv_comp (f := χ.L) (g := fun z : ℂ => z + c) (x := s - c)
      (χ.L_analytic ((s - c) + c)).differentiableAt
      (show DifferentiableAt ℂ (fun z : ℂ => z + c) (s - c) by fun_prop)
    simpa [g, Function.comp_def] using hh
  rw [hcomp] at hb
  calc
    _ ≤ 8 * A * R / (ε / 2) ^ 2 := hb
    _ ≤ 8 * A * (9 / 8) / (ε / 2) ^ 2 := by
      apply div_le_div_of_nonneg_right _ (sq_nonneg _)
      gcongr
      dsimp [R]
      linarith
    _ = _ := by dsimp [A]; field_simp; ring


end Bounty
end

section

/- A uniform parametric finite-unsmoothing estimate. -/

namespace Bounty

open OAI.Ostmann

theorem power_three_scale_le_of_exponent {θ : ℝ} (hθ0 : 0 ≤ θ) (hθ1 : θ ≤ 1) {x y : ℝ} (hx : 0 < x) (hy : 0 ≤ y) (hyx : y ≤ 3 * x) :
    y ^ θ ≤ 3 * x ^ θ := by
  have hthree : (3 : ℝ) ^ θ ≤ 3 := by
    calc
      _ ≤ (3 : ℝ) ^ (1 : ℝ) := Real.rpow_le_rpow_of_exponent_le (by norm_num) hθ1
      _ = _ := Real.rpow_one _
  calc
    _ ≤ (3 * x) ^ θ := Real.rpow_le_rpow hy hyx hθ0
    _ = (3 : ℝ) ^ θ * x ^ θ := Real.mul_rpow (by norm_num) hx.le
    _ ≤ _ := mul_le_mul_of_nonneg_right hthree (Real.rpow_nonneg hx.le _)

/-- A triangular bound at exponent θ gives a sharp bound at (1+θ)/2. -/
theorem twistedPsi_bound_of_smoothed_exponent {θ : ℝ} (hθ0 : 0 ≤ θ) (hθ1 : θ ≤ 1)
    {q : ℕ} (χ : DirichletCharacter ℂ q)
    (hq : 0 < q) {C : ℝ} (hC : 0 < C)
    (hbound : ∀ y : ℝ, 2 ≤ y → ‖smoothedTwistedPsi χ y‖ ≤
      C * y ^ θ * Real.log ((q : ℝ) * y))
    {x : ℝ} (hx : 2 ≤ x) :
    ‖twistedPsi χ x‖ ≤ (28 * C + 6) * x ^ ((1 + θ) / 2) * Real.log ((q : ℝ) * x) := by
  let p : ℝ := x ^ ((1 + θ) / 2)
  let m : ℕ := ⌈p⌉₊
  let L : ℝ := Real.log ((q : ℝ) * x)
  have hx0 : 0 < x := by linarith
  have hq1 : (1 : ℝ) ≤ q := by exact_mod_cast hq
  have hq0 : (0 : ℝ) < q := by exact_mod_cast hq
  have hL : 0 ≤ L := Real.log_nonneg (by nlinarith)
  have hp1 : 1 ≤ p := Real.one_le_rpow (by linarith) (by linarith)
  have hp0 : 0 < p := by linarith
  have hpx : p ≤ x := by
    calc
      _ ≤ x ^ (1 : ℝ) := Real.rpow_le_rpow_of_exponent_le (by linarith) (by linarith)
      _ = x := Real.rpow_one _
  have hmp : p ≤ (m : ℝ) := Nat.le_ceil p
  have hm2p : (m : ℝ) ≤ 2 * p := by
    have hh := Nat.ceil_lt_add_one hp0.le
    dsimp [m]
    linarith
  have hm : 0 < m := Nat.ceil_pos.mpr hp0
  have hm0 : 0 < (m : ℝ) := by exact_mod_cast hm
  have hym : x + (m : ℝ) ≤ 3 * x := by linarith
  have hy2 : 2 ≤ x + (m : ℝ) := by linarith
  have hpow := power_three_scale_le_of_exponent hθ0 hθ1 hx0 (by positivity : 0 ≤ x + (m : ℝ)) hym
  have hlog := log_three_scale_le hq1 hx (by positivity : 0 < x + (m : ℝ)) hym
  have hlog0 : 0 ≤ Real.log ((q : ℝ) * (x + (m : ℝ))) :=
    Real.log_nonneg (by nlinarith)
  have hsmy : ‖smoothedTwistedPsi χ (x + m)‖ ≤
      9 * C * x ^ θ * L := by
    calc
      _ ≤ C * (x + m) ^ θ * Real.log ((q : ℝ) * (x + m)) := hbound _ hy2
      _ ≤ C * (3 * x ^ θ) * (3 * L) := by gcongr
      _ = _ := by ring
  have hsmx : ‖smoothedTwistedPsi χ x‖ ≤ C * x ^ θ * L := hbound x hx
  have hp2 : x * x ^ θ = p ^ 2 := by
    dsimp [p]
    calc
      _ = x ^ (1 : ℝ) * x ^ θ := by rw [Real.rpow_one]
      _ = x ^ ((1 : ℝ) + θ) := (Real.rpow_add hx0 _ _).symm
      _ = x ^ (((1 + θ) / 2) * 2) := by congr 1; ring
      _ = _ := by rw [Real.rpow_mul hx0.le, Real.rpow_two]
  have hpair : (x + m) * ‖smoothedTwistedPsi χ (x + m)‖ + x * ‖smoothedTwistedPsi χ x‖ ≤
      28 * C * p ^ 2 * L := by
    calc
      _ ≤ (3 * x) * (9 * C * x ^ θ * L) +
          x * (C * x ^ θ * L) := by gcongr
      _ = 28 * C * (x * x ^ θ) * L := by ring
      _ = _ := by rw [hp2]
  have hlogy : Real.log (x + (m : ℝ)) ≤ 3 * L := by
    apply le_trans _ hlog
    apply Real.log_le_log (by positivity)
    nlinarith
  have hpp : p ^ 2 ≤ p * m := by nlinarith
  have hmp2 : (m : ℝ) ^ 2 ≤ 2 * p * m := by nlinarith
  calc
    _ ≤ ((x + m) * ‖smoothedTwistedPsi χ (x + m)‖ + x * ‖smoothedTwistedPsi χ x‖ +
        (m : ℝ) ^ 2 * Real.log (x + m)) / m := riesz_unsmoothing_bound χ hx0 hm
    _ ≤ (28 * C + 6) * p * L := by
      apply (div_le_iff₀ hm0).mpr
      calc
        _ ≤ 28 * C * p ^ 2 * L + (m : ℝ) ^ 2 * (3 * L) := by gcongr
        _ = 28 * C * p ^ 2 * L + 3 * (m : ℝ) ^ 2 * L := by ring
        _ ≤ 28 * C * (p * m) * L + 3 * (2 * p * m) * L := by gcongr
        _ = _ := by ring


end Bounty
end

section

/- Actual Hoeffding components omit their missing probes and all averaged tails. -/

namespace Bounty

open Finset
open scoped Classical

theorem finite_coordinate_average_component_commute {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (i : I) (S : Finset I) (is : List I) (f : (∀ j, X j) → ℂ) :
    finiteCoordinateAverage μ i (finiteCoordinateComponent μ S is f) =
      finiteCoordinateComponent μ S is (finiteCoordinateAverage μ i f) := by
  induction is with
  | nil => rfl
  | cons j js ih =>
    simp only [finiteCoordinateComponent, finite_coordinate_average_choice, ih]

theorem finite_average_fixed_invariant {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (i : I) (f : (∀ j, X j) → ℂ) (hf : finiteCoordinateAverage μ i f = f)
    (x : ∀ j, X j) (v : X i) : f (Function.update x i v) = f x := by
  rw [← hf]
  exact finite_coordinate_average_invariant μ i f x v

theorem finite_component_missing_invariant {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hmass : ∀ i, ∑ v, μ i v = 1) (U S : Finset I) (i : I) (hi : i ∈ U \ S)
    (f : (∀ j, X j) → ℂ) (x : ∀ j, X j) (v : X i) :
    finiteCoordinateComponent μ S U.toList f (Function.update x i v) =
      finiteCoordinateComponent μ S U.toList f x := by
  apply finite_average_fixed_invariant μ i
  rw [finite_coordinate_component_average μ hmass S U.toList i
    (mem_toList.mpr (mem_sdiff.mp hi).1), if_neg (mem_sdiff.mp hi).2]

theorem finite_component_tail_invariant {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hmass : ∀ i, ∑ v, μ i v = 1) (U S tail : Finset I) (i : I) (hi : i ∈ tail)
    (f : (∀ j, X j) → ℂ) (x : ∀ j, X j) (v : X i) :
    finiteCoordinateComponent μ S U.toList (finiteCoordinateComponent μ ∅ tail.toList f)
        (Function.update x i v) =
      finiteCoordinateComponent μ S U.toList (finiteCoordinateComponent μ ∅ tail.toList f) x := by
  apply finite_average_fixed_invariant μ i
  rw [finite_coordinate_average_component_commute,
    finite_coordinate_component_average μ hmass ∅ tail.toList i (mem_toList.mpr hi)]
  simp

theorem finite_function_eq_of_coordinate_invariance {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} {Y : Type*} (kept : Finset I) (f : (∀ i, X i) → Y)
    (hf : ∀ i ∉ kept, ∀ x v, f (Function.update x i v) = f x)
    (x y : ∀ i, X i) (hxy : ∀ i ∈ kept, x i = y i) : f x = f y := by
  have hmain (s : Finset I) : ∀ x y : ∀ i, X i,
      (∀ i ∈ kept, x i = y i) → (∀ i ∉ s, x i = y i) → f x = f y := by
    induction s using Finset.induction with
    | empty =>
      intro x y _ hout
      have he : x = y := funext (fun i => hout i (by simp))
      rw [he]
    | @insert i s hi ih =>
      intro x y hkeep hout
      have hfi : f (Function.update x i (y i)) = f x := by
        by_cases hik : i ∈ kept
        · rw [← hkeep i hik, Function.update_eq_self]
        · exact hf i hik x (y i)
      rw [← hfi]
      apply ih
      · intro j hj
        by_cases hji : j = i
        · subst j
          exact Function.update_self _ _ _
        · rw [Function.update_of_ne hji]
          exact hkeep j hj
      · intro j hjs
        by_cases hji : j = i
        · subst j
          exact Function.update_self _ _ _
        · rw [Function.update_of_ne hji]
          exact hout j (by simp [hji, hjs])
  exact hmain univ x y hxy (by simp)

end Bounty
end

section

/- Normalized independent tails leave energies and pairings unchanged. -/

open Finset
open scoped Classical

namespace Bounty

def finiteFourPackEquiv {C A B T : Type*} :
    (C × A × B × T) ≃ ((C × A × B) × T) where
  toFun p := ((p.1, p.2.1, p.2.2.1), p.2.2.2)
  invFun p := (p.1.1, p.1.2.1, p.1.2.2, p.2)
  left_inv := by rintro ⟨c, a, b, t⟩; rfl
  right_inv := by rintro ⟨⟨c, a, b⟩, t⟩; rfl

theorem finite_four_pack_apply {C A B T : Type*} (c : C) (a : A) (b : B) (t : T) :
    finiteFourPackEquiv (c, a, b, t) = ((c, a, b), t) := rfl

theorem finite_four_pack_symm_apply {C A B T : Type*} (c : C) (a : A) (b : B) (t : T) :
    finiteFourPackEquiv.symm ((c, a, b), t) = (c, a, b, t) := rfl

theorem finite_independent_tail_energy {X T : Type*} [Fintype X] [Fintype T]
    (w : X → ℝ) (ν : T → ℝ) (hν : ∑ t, ν t = 1) (f : X → ℂ) :
    finiteWeightedEnergy (fun p : X × T => w p.1 * ν p.2) (fun p => f p.1) =
      finiteWeightedEnergy w f := by
  simp only [finiteWeightedEnergy, Fintype.sum_prod_type]
  apply sum_congr rfl
  intro x _
  calc
    _ = (w x * ‖f x‖ ^ 2) * ∑ t, ν t := by
      rw [mul_sum]
      apply sum_congr rfl
      intro t _
      ring
    _ = _ := by rw [hν, mul_one]

theorem finite_independent_tail_raw_pairing {X T : Type*} [Fintype X] [Fintype T]
    (w : X → ℝ) (ν : T → ℝ) (hν : ∑ t, ν t = 1) (k f g : X → ℂ) :
    cleanRawPairing (fun p : X × T => w p.1 * ν p.2)
      (fun p => k p.1) (fun p => f p.1) (fun p => g p.1) = cleanRawPairing w k f g := by
  have hνc : (∑ t, (ν t : ℂ)) = 1 := by exact_mod_cast hν
  simp only [cleanRawPairing, Fintype.sum_prod_type]
  apply sum_congr rfl
  intro x _
  calc
    _ = ((w x : ℂ) * (starRingEnd ℂ) (f x) * g x * k x) * ∑ t, (ν t : ℂ) := by
      rw [mul_sum]
      apply sum_congr rfl
      intro t _
      push_cast
      ring
    _ = _ := by rw [hνc, mul_one]

theorem finite_independent_tail_kernel_pairing {X T : Type*} [Fintype X] [Fintype T]
    (w : X → ℝ) (ν : T → ℝ) (hν : ∑ t, ν t = 1) (K : X → X → ℂ) (f g : X → ℂ) :
    cleanKernelPairing (fun p : X × T => w p.1 * ν p.2)
      (fun (p q : X × T) => (ν q.2 : ℂ) * K p.1 q.1) (fun p => f p.1) (fun p => g p.1) =
        cleanKernelPairing w K f g := by
  have hνc : (∑ t, (ν t : ℂ)) = 1 := by exact_mod_cast hν
  have hin (x y : X) (t : T) :
      (∑ u, ((w x * ν t : ℝ) : ℂ) * (starRingEnd ℂ) (f x) *
        ((ν u : ℂ) * K x y) * g y) =
      (ν t : ℂ) * ((w x : ℂ) * (starRingEnd ℂ) (f x) * K x y * g y) := by
    calc
      _ = ((ν t : ℂ) * ((w x : ℂ) * (starRingEnd ℂ) (f x) * K x y * g y)) *
          ∑ u, (ν u : ℂ) := by
        rw [mul_sum]
        apply sum_congr rfl
        intro u _
        push_cast
        ring
      _ = _ := by rw [hνc, mul_one]
  simp only [cleanKernelPairing, Fintype.sum_prod_type]
  simp_rw [hin, ← mul_sum, ← sum_mul, hνc, one_mul]

end Bounty
end

section

/- Averaging actual shared-label slice errors with their conditional energies. -/

namespace Bounty

open Finset
open scoped Classical

theorem finite_weighted_slice_sqrt_cauchy {C : Type*} [Fintype C]
    (ρ A B : C → ℝ) (hρ : ∀ c, 0 ≤ ρ c) (hA : ∀ c, 0 ≤ A c) (hB : ∀ c, 0 ≤ B c) :
    (∑ c, ρ c * Real.sqrt (A c) * Real.sqrt (B c)) ≤
      Real.sqrt (∑ c, ρ c * A c) * Real.sqrt (∑ c, ρ c * B c) := by
  have h := Real.sum_sqrt_mul_sqrt_le (univ : Finset C)
    (fun c => mul_nonneg (hρ c) (hA c)) (fun c => mul_nonneg (hρ c) (hB c))
  have he (c : C) : Real.sqrt (ρ c * A c) * Real.sqrt (ρ c * B c) =
      ρ c * Real.sqrt (A c) * Real.sqrt (B c) := by
    rw [Real.sqrt_mul (hρ c), Real.sqrt_mul (hρ c)]
    calc
      _ = (Real.sqrt (ρ c) * Real.sqrt (ρ c)) * Real.sqrt (A c) * Real.sqrt (B c) := by ring
      _ = _ := by rw [Real.mul_self_sqrt (hρ c)]
  simpa only [he] using h

theorem finite_weighted_slice_error_bound {C : Type*} [Fintype C]
    (ρ A B : C → ℝ) (hρ : ∀ c, 0 ≤ ρ c) (hA : ∀ c, 0 ≤ A c) (hB : ∀ c, 0 ≤ B c)
    (err : C → ℂ) (ε : ℝ) (hε : 0 ≤ ε)
    (herr : ∀ c, ‖err c‖ ≤ ε * Real.sqrt (A c) * Real.sqrt (B c)) :
    ‖∑ c, (ρ c : ℂ) * err c‖ ≤
      ε * Real.sqrt (∑ c, ρ c * A c) * Real.sqrt (∑ c, ρ c * B c) := by
  calc
    _ ≤ ∑ c, ‖(ρ c : ℂ) * err c‖ := norm_sum_le _ _
    _ = ∑ c, ρ c * ‖err c‖ := by
      apply sum_congr rfl
      intro c _
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hρ c)]
    _ ≤ ∑ c, ρ c * (ε * Real.sqrt (A c) * Real.sqrt (B c)) :=
      sum_le_sum (fun c _ => mul_le_mul_of_nonneg_left (herr c) (hρ c))
    _ = ε * (∑ c, ρ c * Real.sqrt (A c) * Real.sqrt (B c)) := by
      rw [mul_sum]
      apply sum_congr rfl
      intro c _
      ring
    _ ≤ _ := by
      simpa only [mul_assoc] using
        mul_le_mul_of_nonneg_left (finite_weighted_slice_sqrt_cauchy ρ A B hρ hA hB) hε

noncomputable def finiteTwoKernelPairingError {A B : Type*} [Fintype A] [Fintype B]
    (μ : A → ℝ) (ν : B → ℝ) (KA : A → A → ℂ) (KB : B → B → ℂ)
    (phase : A → B → ℂ) (f : A → ℂ) (g : B → ℂ) : ℂ :=
  ∑ a, ∑ b, ((μ a * ν b : ℝ) : ℂ) *
    ((phase a b - finiteTwoKernelAverage μ ν KA KB a b phase) * f a * g b)

theorem finite_shared_two_kernel_error_bound {C A B : Type*}
    [Fintype C] [Fintype A] [Fintype B]
    (ρ : C → ℝ) (μ : A → ℝ) (ν : B → ℝ)
    (hρ : ∀ c, 0 ≤ ρ c) (hμ : ∀ a, 0 ≤ μ a) (hν : ∀ b, 0 ≤ ν b)
    (KA : A → A → ℂ) (KB : B → B → ℂ) (phase : C → A → B → ℂ)
    (f : C → A → ℂ) (g : C → B → ℂ) (ε : ℝ) (hε : 0 ≤ ε)
    (herr : ∀ c, ‖finiteTwoKernelPairingError μ ν KA KB (phase c) (f c) (g c)‖ ≤
      ε * Real.sqrt (finiteWeightedEnergy μ (f c)) * Real.sqrt (finiteWeightedEnergy ν (g c))) :
    ‖∑ c, (ρ c : ℂ) * finiteTwoKernelPairingError μ ν KA KB (phase c) (f c) (g c)‖ ≤
      ε * Real.sqrt (∑ c, ρ c * finiteWeightedEnergy μ (f c)) *
        Real.sqrt (∑ c, ρ c * finiteWeightedEnergy ν (g c)) := by
  exact finite_weighted_slice_error_bound ρ
    (fun c => finiteWeightedEnergy μ (f c)) (fun c => finiteWeightedEnergy ν (g c)) hρ
    (fun c => sum_nonneg (fun a _ => mul_nonneg (hμ a) (sq_nonneg _)))
    (fun c => sum_nonneg (fun b _ => mul_nonneg (hν b) (sq_nonneg _)))
    _ ε hε herr

end Bounty
end

section

/- Exact finite pairing and energy transport along a state equivalence. -/

namespace Bounty

open Finset

theorem clean_raw_pairing_equiv {X Y : Type*} [Fintype X] [Fintype Y]
    (E : X ≃ Y) (w : X → ℝ) (k f g : X → ℂ) :
    cleanRawPairing w k f g = cleanRawPairing (fun y => w (E.symm y))
      (fun y => k (E.symm y)) (fun y => f (E.symm y)) (fun y => g (E.symm y)) := by
  exact (E.symm.sum_comp (fun x => (w x : ℂ) * (starRingEnd ℂ) (f x) * g x * k x)).symm

theorem clean_kernel_pairing_equiv {X Y : Type*} [Fintype X] [Fintype Y]
    (E : X ≃ Y) (w : X → ℝ) (K : X → X → ℂ) (f g : X → ℂ) :
    cleanKernelPairing w K f g = cleanKernelPairing (fun y => w (E.symm y))
      (fun y z => K (E.symm y) (E.symm z)) (fun y => f (E.symm y)) (fun y => g (E.symm y)) := by
  unfold cleanKernelPairing
  rw [← E.symm.sum_comp]
  apply sum_congr rfl
  intro y _
  exact (E.symm.sum_comp (fun x => (w (E.symm y) : ℂ) *
    (starRingEnd ℂ) (f (E.symm y)) * K (E.symm y) x * g x)).symm

theorem finite_weighted_energy_equiv {X Y : Type*} [Fintype X] [Fintype Y]
    (E : X ≃ Y) (w : X → ℝ) (f : X → ℂ) :
    finiteWeightedEnergy w f =
      finiteWeightedEnergy (fun y => w (E.symm y)) (fun y => f (E.symm y)) := by
  exact (E.symm.sum_comp (fun x => w x * ‖f x‖ ^ 2)).symm

end Bounty
end

section

/- Uniform ordinary prime-character cancellation on the wider interval
(y/4,5y], under the same explicit primitive zero-free hypothesis. -/

open Finset Filter
open scoped Topology

namespace Bounty

theorem eventually_wide_ambient_prime_cancellation
    (hZ : PrimitiveZeroFreeHalfPlane) {δ σ : ℝ} (hδ : 0 < δ) (hσ : 0 < σ) :
    ∀ᶠ y : ℝ in atTop, ∀ L : ℕ, 0 < L →
      Real.log (L : ℝ) ≤ y ^ δ * Real.log (5 * y) →
      ∀ χ : DirichletCharacter ℂ L, χ ≠ 1 →
      ‖∑ p ∈ primeBand (y / 4) (5 * y), χ (p : ZMod L)‖ ≤
        y ^ ((31 : ℝ) / 32 + 2 * δ + σ) := by
  obtain ⟨C, hC, hbound⟩ := ordinary_prime_band_product_interval_bound hZ
  let A : ℝ := 20 * C / (4 : ℝ) ^ (-(1 : ℝ) / 32)
  filter_upwards [eventually_log_natLog_le_rpow δ hδ,
    eventually_const_le_mul_rpow hσ (show (0 : ℝ) < 1 by norm_num) A,
    eventually_ge_atTop (4 * Real.exp 1), eventually_ge_atTop (8 : ℝ)]
    with y hlog hA hyexp hy8
  have hy0 : 0 < y := by linarith
  have hy1 : 1 ≤ y := by linarith
  have ha2 : 2 ≤ y / 4 := by linarith
  have ha0 : 0 < y / 4 := by positivity
  have hb0 : 0 ≤ 5 * y := by positivity
  have hden : 1 ≤ Real.log (y / 4) := by
    calc
      1 = Real.log (Real.exp 1) := (Real.log_exp 1).symm
      _ ≤ Real.log (y / 4) := Real.log_le_log (Real.exp_pos _) (by linarith)
  have hden0 : 0 < Real.log (y / 4) := by linarith
  have hpow : 1 ≤ y ^ (2 * δ) := Real.one_le_rpow hy1 (by linarith)
  intro L hL hLlog χ hχ
  have hL0 : 0 ≤ Real.log (L : ℝ) := Real.log_nonneg (by exact_mod_cast hL)
  have hLpow : Real.log (L : ℝ) ≤ y ^ (2 * δ) := by
    simpa only [two_mul] using (hlog L hLlog).1
  have hfrac : Real.log (L : ℝ) / Real.log (y / 4) ≤ y ^ (2 * δ) := by
    apply le_trans _ hLpow
    apply (div_le_iff₀ hden0).mpr
    exact le_mul_of_one_le_right hL0 hden
  have hfactor : 1 + Real.log (L : ℝ) / Real.log (y / 4) ≤ 2 * y ^ (2 * δ) := by linarith
  have hfilter : (primeBand (y / 4) (5 * y)).filter
      (fun p : ℕ => (0 : ℝ) < 1 * (p : ℝ) ∧ 1 * (p : ℝ) ≤ 5 * y) =
      primeBand (y / 4) (5 * y) := by
    apply filter_eq_self.mpr
    intro p hp
    have hp' := (mem_primeBand_iff ha0.le hb0 p).mp hp
    simpa only [one_mul] using And.intro (show (0 : ℝ) < p by exact_mod_cast hp'.1.pos) hp'.2.2
  have hbasic := hbound L hL χ hχ (y / 4) (5 * y) 1 0 (5 * y)
    ha2 hb0 (by norm_num) (by norm_num) hb0
  rw [hfilter] at hbasic
  calc
    _ ≤ 2 * (5 * y) * C * (y / 4) ^ (-(1 : ℝ) / 32) *
        (1 + Real.log (L : ℝ) / Real.log (y / 4)) := hbasic
    _ ≤ 2 * (5 * y) * C * (y / 4) ^ (-(1 : ℝ) / 32) * (2 * y ^ (2 * δ)) :=
      mul_le_mul_of_nonneg_left hfactor (by positivity)
    _ = A * y ^ ((31 : ℝ) / 32 + 2 * δ) := by
      rw [Real.div_rpow hy0.le (by norm_num)]
      have h31 : y ^ ((31 : ℝ) / 32) = y * y ^ (-(1 : ℝ) / 32) := by
        rw [show (31 : ℝ) / 32 = 1 + (-(1 : ℝ) / 32) by norm_num, Real.rpow_add hy0, Real.rpow_one]
      rw [Real.rpow_add hy0, h31]
      dsimp only [A]
      ring
    _ ≤ y ^ σ * y ^ ((31 : ℝ) / 32 + 2 * δ) :=
      mul_le_mul_of_nonneg_right (by simpa only [one_mul] using hA) (by positivity)
    _ = y ^ ((31 : ℝ) / 32 + 2 * δ + σ) := by
      rw [← Real.rpow_add hy0]
      congr 1
      ring

end Bounty
end

section

/- An explicit even sieve order with sublinear logarithmic level. -/

open Filter

namespace Bounty

noncomputable def roughCellSieveOrder (L : ℝ) : ℕ := 2 * ⌈L^(1/8 : ℝ)⌉₊

theorem rough_cell_sieve_order_even (L : ℝ) : Even (roughCellSieveOrder L) := by
  exact ⟨⌈L^(1/8 : ℝ)⌉₊, by simp only [roughCellSieveOrder, two_mul]⟩

theorem rough_cell_sieve_order_bounds {L : ℝ} (hL : 1 ≤ L) :
    1 ≤ roughCellSieveOrder L ∧ L^(1/8 : ℝ) ≤ (roughCellSieveOrder L : ℝ) ∧
      (roughCellSieveOrder L : ℝ) ≤ 4*L^(1/8 : ℝ) := by
  have hp : 1 ≤ L^(1/8 : ℝ) := Real.one_le_rpow hL (by norm_num)
  have hceil : 1 ≤ ⌈L^(1/8 : ℝ)⌉₊ := Nat.one_le_ceil_iff.mpr (zero_lt_one.trans_le hp)
  have hlower := Nat.le_ceil (L^(1/8 : ℝ))
  have hupper := Nat.ceil_lt_add_one (zero_le_one.trans hp)
  constructor
  · unfold roughCellSieveOrder
    omega
  · simp only [roughCellSieveOrder, Nat.cast_mul, Nat.cast_ofNat]
    constructor <;> linarith

theorem rough_cell_sieve_order_exponential_le {L : ℝ} (hL : 1 ≤ L) :
    Real.exp (-(roughCellSieveOrder L : ℝ)) ≤ Real.exp (-L^(1/8 : ℝ)) := by
  exact Real.exp_le_exp.mpr (neg_le_neg (rough_cell_sieve_order_bounds hL).2.1)

theorem eventually_rough_cell_sieve_level_le {a : ℝ} (ha : 0 < a) :
    ∀ᶠ L : ℝ in atTop,
      (Real.exp (Real.sqrt L))^(4*(roughCellSieveOrder L : ℝ) + 2) ≤
        Real.exp ((a/2)*L) := by
  have hlevel := eventually_mul_rpow_log_add_le_rpow
    (by norm_num : (0 : ℝ) < 1) (by norm_num : (5/8 : ℝ) < 1)
    (half_pos ha) 18 0
  filter_upwards [hlevel, eventually_ge_atTop (1 : ℝ),
    Real.tendsto_log_atTop.eventually (eventually_ge_atTop (1 : ℝ))]
    with L hlevelL hL hlog
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hp : 1 ≤ L^(1/8 : ℝ) := Real.one_le_rpow hL (by norm_num)
  have horder := (rough_cell_sieve_order_bounds hL).2.2
  have horder' : 4*(roughCellSieveOrder L : ℝ) + 2 ≤ 18*L^(1/8 : ℝ) := by linarith
  have hpow : Real.sqrt L * L^(1/8 : ℝ) = L^(5/8 : ℝ) := by
    rw [Real.sqrt_eq_rpow, ← Real.rpow_add hL0]
    norm_num
  have hsmall : 18*L^(5/8 : ℝ) ≤ (a/2)*L := by
    have hm := le_mul_of_one_le_right
      (show 0 ≤ 18*L^(5/8 : ℝ) by positivity) hlog
    simp only [add_zero, Real.rpow_one] at hlevelL
    exact hm.trans hlevelL
  rw [← Real.exp_mul]
  apply Real.exp_le_exp.mpr
  calc
    Real.sqrt L * (4*(roughCellSieveOrder L : ℝ) + 2) ≤
        Real.sqrt L * (18*L^(1/8 : ℝ)) :=
      mul_le_mul_of_nonneg_left horder' (Real.sqrt_nonneg L)
    _ = 18*L^(5/8 : ℝ) := by rw [mul_left_comm, hpow]
    _ ≤ (a/2)*L := hsmall

theorem eventually_rough_cell_sieve_parameters {a : ℝ} (ha : 0 < a) :
    ∀ᶠ L : ℝ in atTop,
      1 ≤ roughCellSieveOrder L ∧ Even (roughCellSieveOrder L) ∧
      1 < Real.exp (Real.sqrt L) ∧
      (Real.exp (Real.sqrt L))^(4*(roughCellSieveOrder L : ℝ) + 2) ≤
        Real.exp ((a/2)*L) ∧
      Real.exp (-(roughCellSieveOrder L : ℝ)) ≤ Real.exp (-L^(1/8 : ℝ)) := by
  filter_upwards [eventually_rough_cell_sieve_level_le ha, eventually_ge_atTop (1 : ℝ)]
    with L hlevel hL
  exact ⟨(rough_cell_sieve_order_bounds hL).1, rough_cell_sieve_order_even L,
    Real.one_lt_exp_iff.mpr (Real.sqrt_pos.mpr (zero_lt_one.trans_le hL)),
    hlevel, rough_cell_sieve_order_exponential_le hL⟩

end Bounty

end

section

/- A two-sided rough-integer count with real endpoints and a uniform error. -/

open Finset

namespace Bounty

theorem floor_interval_length_error_le_one {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) :
    |((⌊b⌋₊ : ℝ) - ⌊a⌋₊) - (b - a)| ≤ 1 := by
  have hfa := Nat.floor_le ha
  have hfb := Nat.floor_le hb
  have hla := Nat.lt_floor_add_one a
  have hlb := Nat.lt_floor_add_one b
  apply abs_le.mpr
  constructor <;> linarith

theorem finite_prime_avoidance_product_le_one (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) :
    (∏ p ∈ P, (1 - 1 / (p : ℝ))) ≤ 1 := by
  apply prod_le_one₀
  · intro p hp
    have hp1 : (1 : ℝ) ≤ p := by exact_mod_cast (hP p hp).one_le
    exact sub_nonneg.mpr ((div_le_one (by linarith)).mpr hp1)
  · intro p hp
    have hp0 : (0 : ℝ) ≤ p := Nat.cast_nonneg p
    have := div_nonneg (by norm_num : (0 : ℝ) ≤ 1) hp0
    linarith

theorem exists_real_rough_integer_interval_count :
    ∃ K : ℝ, 0 < K ∧ ∀ {a b z : ℝ} {h : ℕ},
      0 ≤ a → a ≤ b → 1 < z → 1 ≤ h → Even h →
      |((roughBand a b z).card : ℝ) -
          (b - a) * (∏ p ∈ primeBand 0 z, (1 - 1 / (p : ℝ)))| ≤
        K * ((b - a) * (∏ p ∈ primeBand 0 z, (1 - 1 / (p : ℝ))) *
          Real.exp (-(h : ℝ)) + z^(4 * (h : ℝ) + 2)) := by
  obtain ⟨K, hK, hcount⟩ := exists_rough_integer_interval_count
  refine ⟨K + 2, by linarith, ?_⟩
  intro a b z h ha hab hz hh heven
  have hbase := hcount ⌊a⌋₊ ⌊b⌋₊ hz (Nat.floor_mono hab) hh heven
  let V := ∏ p ∈ primeBand 0 z, (1 - 1 / (p : ℝ))
  let D := z^(4 * (h : ℝ) + 2)
  have hV0 : 0 ≤ V := (finite_prime_avoidance_product_pos _
    (fun _ hp => small_prime_pool_prime hp)).le
  have hV1 : V ≤ 1 := finite_prime_avoidance_product_le_one _
    (fun _ hp => small_prime_pool_prime hp)
  have hD : 1 ≤ D := Real.one_le_rpow hz.le (by positivity)
  have he0 : 0 ≤ Real.exp (-(h : ℝ)) := Real.exp_nonneg _
  have he1 : Real.exp (-(h : ℝ)) ≤ 1 :=
    Real.exp_le_one_iff.mpr (neg_nonpos.mpr (Nat.cast_nonneg h))
  have hlen := floor_interval_length_le (a := a) (ha.trans hab)
  have herr := floor_interval_length_error_le_one ha (ha.trans hab)
  have hchange :
      |(((⌊b⌋₊ : ℝ) - ⌊a⌋₊) - (b - a)) * V| ≤ 1 := by
    rw [abs_mul, abs_of_nonneg hV0]
    exact (mul_le_mul_of_nonneg_right herr hV0).trans (by simpa using hV1)
  change |((roughBand a b z).card : ℝ) -
    ((⌊b⌋₊ : ℝ) - ⌊a⌋₊) * V| ≤
      ((⌊b⌋₊ : ℝ) - ⌊a⌋₊) * V * K * Real.exp (-(h : ℝ)) + D at hbase
  have htriangle := abs_add_le
    (((roughBand a b z).card : ℝ) - ((⌊b⌋₊ : ℝ) - ⌊a⌋₊) * V)
    ((((⌊b⌋₊ : ℝ) - ⌊a⌋₊) - (b - a)) * V)
  have hid : (((roughBand a b z).card : ℝ) - ((⌊b⌋₊ : ℝ) - ⌊a⌋₊) * V) +
      ((((⌊b⌋₊ : ℝ) - ⌊a⌋₊) - (b - a)) * V) =
      ((roughBand a b z).card : ℝ) - (b - a) * V := by ring
  rw [hid] at htriangle
  have hmain0 : 0 ≤ (b - a) * V * Real.exp (-(h : ℝ)) := by positivity
  have hVe : V * Real.exp (-(h : ℝ)) ≤ 1 :=
    (mul_le_mul hV1 he1 he0 (by norm_num)).trans (by norm_num)
  have hlength := mul_le_mul_of_nonneg_right hlen
    (show 0 ≤ V * K * Real.exp (-(h : ℝ)) by positivity)
  have hsmall := mul_le_mul_of_nonneg_left hVe hK.le
  have hKD := mul_le_mul_of_nonneg_left hD hK.le
  change |((roughBand a b z).card : ℝ) - (b - a) * V| ≤
    (K + 2) * ((b - a) * V * Real.exp (-(h : ℝ)) + D)
  nlinarith

end Bounty
end

section

/- Exponential sieve levels fit below an integer cutoff with a fixed exponent gap. -/

open Filter

namespace Bounty

theorem eventually_exp_le_floor_exp {a theta : ℝ} (ha : 0 ≤ a) (hat : a < theta) :
    ∀ᶠ L : ℝ in atTop,
      Real.exp (a * L) ≤ (⌊Real.exp (theta * L)⌋₊ : ℝ) := by
  have hgap : 0 < theta - a := sub_pos.mpr hat
  filter_upwards [eventually_ge_atTop (0 : ℝ),
    eventually_ge_atTop (Real.log 2 / (theta - a))] with L hL hLgap
  have hA : 1 ≤ Real.exp (a * L) := Real.one_le_exp (mul_nonneg ha hL)
  have hB : 2 ≤ Real.exp ((theta - a) * L) := by
    calc
      _ = Real.exp (Real.log 2) := (Real.exp_log (by norm_num)).symm
      _ ≤ _ := Real.exp_le_exp.mpr (by
        have h := (div_le_iff₀ hgap).mp hLgap
        nlinarith only [h])
  have hexp : Real.exp (theta * L) =
      Real.exp (a * L) * Real.exp ((theta - a) * L) := by
    rw [← Real.exp_add]
    congr 1
    ring
  have hsize : Real.exp (a * L) + 1 ≤ Real.exp (theta * L) := by
    rw [hexp]
    have h := mul_le_mul_of_nonneg_left hB (Real.exp_pos (a * L)).le
    nlinarith only [h, hA]
  have hfloor := Nat.sub_one_lt_floor (Real.exp (theta * L))
  linarith only [hsize, hfloor]

theorem floor_exp_mul_le_exp {theta L : ℝ} (htheta : theta ≤ 1) (hL : 0 ≤ L) :
    (⌊Real.exp (theta * L)⌋₊ : ℝ) ≤ Real.exp L := by
  apply (Nat.floor_le (Real.exp_pos _).le).trans
  apply Real.exp_le_exp.mpr
  nlinarith only [htheta, hL]

theorem eventually_candidate_sieve_scale {b theta : ℝ} (hb : 0 < b) (h : ℕ)
    (hlevel : b * (4 * (h : ℝ) + 2) < theta) (htheta : theta ≤ 1) :
    ∀ᶠ L : ℝ in atTop,
      1 < Real.exp (b * L) ∧
      (Real.exp (b * L)) ^ (4 * (h : ℝ) + 2) ≤ (⌊Real.exp (theta * L)⌋₊ : ℝ) ∧
      (⌊Real.exp (theta * L)⌋₊ : ℝ) ≤ Real.exp L := by
  have ha : 0 ≤ b * (4 * (h : ℝ) + 2) := by positivity
  filter_upwards [eventually_exp_le_floor_exp ha hlevel,
    eventually_gt_atTop (0 : ℝ)] with L hcut hL
  refine ⟨Real.one_lt_exp_iff.mpr (mul_pos hb hL), ?_, floor_exp_mul_le_exp htheta hL.le⟩
  calc
    _ = Real.exp ((b * (4 * (h : ℝ) + 2)) * L) := by
      rw [← Real.exp_mul]
      congr 1
      ring
    _ ≤ _ := hcut

theorem eventually_candidate_midpoint_sieve_scale {b : ℝ} (hb : 0 < b) (h : ℕ)
    (hlevel : b * (4 * (h : ℝ) + 2) < 1/2) :
    ∀ᶠ L : ℝ in atTop,
      1 < Real.exp (b * L) ∧
      (Real.exp (b * L)) ^ (4 * (h : ℝ) + 2) ≤
        (⌊Real.exp (((b * (4 * (h : ℝ) + 2) + 1/2) / 2) * L)⌋₊ : ℝ) ∧
      (⌊Real.exp (((b * (4 * (h : ℝ) + 2) + 1/2) / 2) * L)⌋₊ : ℝ) ≤
        Real.exp L := by
  apply eventually_candidate_sieve_scale hb h
  · linarith only [hlevel]
  · linarith only [hlevel]

end Bounty

end

section

/- The exact predecessor avoidance product and absorption of the principal distribution error. -/

open Finset Filter

namespace Bounty

noncomputable def shiftedPrimeAvoidanceProduct (z : ℝ) : ℝ :=
  ∏ p ∈ (primeBand 0 z).erase 2, (1 - 1 / ((p : ℝ) - 1))

theorem shifted_prime_avoidance_product_pos (z : ℝ) :
    0 < shiftedPrimeAvoidanceProduct z := by
  apply finite_odd_prime_predecessor_avoidance_product_pos
  · intro p hp
    exact small_prime_pool_prime (mem_of_mem_erase hp)
  · intro p hp
    exact (mem_erase.mp hp).1

theorem shifted_prime_avoidance_product_lower {z : ℝ} (hz : 1 ≤ z) :
    1 / ((4 * primeEulerProductUpperConstant) * Real.log (2 * z)) ≤
      shiftedPrimeAvoidanceProduct z := by
  apply finite_odd_prime_predecessor_avoidance_product_lower
  · intro p hp
    exact small_prime_pool_prime (mem_of_mem_erase hp)
  · intro p hp
    exact (mem_erase.mp hp).1
  · exact hz
  · intro p hp
    exact small_prime_pool_le (zero_le_one.trans hz) (mem_of_mem_erase hp)

theorem eventually_shifted_avoidance_absorbs_power {b : ℝ} (hb : 0 < b)
    (A : ℝ) (hA : 0 ≤ A) :
    ∀ᶠ L : ℝ in atTop, A * L^(-18 : ℝ) ≤
      shiftedPrimeAvoidanceProduct (Real.exp (b * L)) * L^(-16 : ℝ) := by
  let T : ℝ := (4 * primeEulerProductUpperConstant) * (1 + b)
  have hT : 0 < T := by dsimp [T]; positivity [primeEulerProductUpperConstant_pos]
  filter_upwards [eventually_ge_atTop (1 : ℝ), eventually_ge_atTop (Real.log 2),
    eventually_ge_atTop (T * A)] with L hL1 hLlog hLA
  have hL : 0 < L := zero_lt_one.trans_le hL1
  have hz : 1 ≤ Real.exp (b * L) := Real.one_le_exp (by positivity)
  have hprod := shifted_prime_avoidance_product_lower hz
  have hprod0 := (shifted_prime_avoidance_product_pos (Real.exp (b * L))).le
  have hden : 0 < (4 * primeEulerProductUpperConstant) *
      Real.log (2 * Real.exp (b * L)) := by
    apply mul_pos (by positivity [primeEulerProductUpperConstant_pos])
    exact Real.log_pos (by nlinarith)
  have hlog : Real.log (2 * Real.exp (b * L)) ≤ (1 + b) * L := by
    rw [Real.log_mul (by norm_num : (2 : ℝ) ≠ 0) (Real.exp_ne_zero _), Real.log_exp]
    nlinarith only [hLlog]
  have hdenle : (4 * primeEulerProductUpperConstant) *
      Real.log (2 * Real.exp (b * L)) ≤ T * L := by
    calc
      _ ≤ (4 * primeEulerProductUpperConstant) * ((1 + b) * L) :=
        mul_le_mul_of_nonneg_left hlog (by positivity [primeEulerProductUpperConstant_pos])
      _ = _ := by dsimp [T]; ring
  have hone : 1 ≤ shiftedPrimeAvoidanceProduct (Real.exp (b * L)) * (T * L) :=
    ((div_le_iff₀ hden).mp hprod).trans (mul_le_mul_of_nonneg_left hdenle hprod0)
  have hAprod : A ≤ shiftedPrimeAvoidanceProduct (Real.exp (b * L)) * L^2 := by
    have h1 := mul_le_mul_of_nonneg_left hone hA
    have h2 := mul_le_mul_of_nonneg_left hLA
      (mul_nonneg hprod0 hL.le)
    nlinarith only [h1, h2]
  have hpow : L^2 * L^(-18 : ℝ) = L^(-16 : ℝ) := by
    rw [← Real.rpow_two, ← Real.rpow_add hL]
    norm_num
  calc
    _ ≤ (shiftedPrimeAvoidanceProduct (Real.exp (b * L)) * L^2) * L^(-18 : ℝ) :=
      mul_le_mul_of_nonneg_right hAprod (Real.rpow_nonneg hL.le _)
    _ = _ := by rw [mul_assoc, hpow]

end Bounty
end

section

/- Exact normalization of the omitted-prime sieve density in a unit class. -/

open Finset

namespace Bounty

theorem totient_eq_real_prime_avoidance (r : ℕ) :
    (r.totient : ℝ) = (r : ℝ) *
      ∏ p ∈ r.primeFactors, (1 - 1 / (p : ℝ)) := by
  have h := Nat.totient_eq_mul_prod_factors r
  have h' := congrArg (fun x : ℚ => (x : ℝ)) h
  push_cast at h'
  simpa only [one_div] using h'

theorem omitted_prime_avoidance_density (P : Finset ℕ) (r : ℕ)
    (hP : ∀ p ∈ P, p.Prime) (hr : 0 < r) (hpf : r.primeFactors ⊆ P) :
    (∏ p ∈ P.filter (fun p => ¬p ∣ r), (1 - 1 / (p : ℝ))) / (r : ℝ) =
      (∏ p ∈ P, (1 - 1 / (p : ℝ))) / (r.totient : ℝ) := by
  have hfilter : P.filter (fun p => p ∣ r) = r.primeFactors := by
    ext p
    simp only [mem_filter]
    constructor
    · intro hp
      exact Nat.mem_primeFactors.mpr ⟨hP p hp.1, hp.2, hr.ne'⟩
    · intro hp
      exact ⟨hpf hp, Nat.dvd_of_mem_primeFactors hp⟩
  have hsplit := prod_filter_mul_prod_filter_not
    (s := P) (p := fun p : ℕ => p ∣ r) (f := fun p : ℕ => (1 - 1 / (p : ℝ)))
  rw [hfilter] at hsplit
  have hr0 : (r : ℝ) ≠ 0 := by exact_mod_cast hr.ne'
  have hphi0 : (r.totient : ℝ) ≠ 0 := by
    exact_mod_cast (Nat.totient_pos.mpr hr).ne'
  apply (div_eq_div_iff hr0 hphi0).mpr
  rw [totient_eq_real_prime_avoidance, ← hsplit]
  ring

theorem small_prime_avoidance_unit_density {z : ℝ} (hz : 0 ≤ z) (r : ℕ)
    (hr : 0 < r) (hpf : ∀ p ∈ r.primeFactors, (p : ℝ) ≤ z) :
    (∏ p ∈ (primeBand 0 z).filter (fun p => ¬p ∣ r), (1 - 1 / (p : ℝ))) / (r : ℝ) =
      (∏ p ∈ primeBand 0 z, (1 - 1 / (p : ℝ))) / (r.totient : ℝ) := by
  apply omitted_prime_avoidance_density _ r (fun _ hp => small_prime_pool_prime hp) hr
  intro p hp
  exact (mem_small_prime_pool_iff hz p).mpr ⟨Nat.prime_of_mem_primeFactors hp, hpf p hp⟩

end Bounty
end

section

/- Exact residue-class interval counts and their unit discrepancy. -/

open Finset

namespace Bounty

theorem nat_mod_eq_iff_dvd_shift (r u n : ℕ) (hr : 0 < r) :
    n % r = u % r ↔ r ∣ n + (r - u % r) := by
  have hu : u % r ≤ r := (Nat.mod_lt u hr).le
  have heq : u % r + (r - u % r) = r := Nat.add_sub_of_le hu
  constructor
  · intro hn
    apply Nat.dvd_of_mod_eq_zero
    calc
      (n + (r - u % r)) % r = (u % r + (r - u % r)) % r := by
        simp only [Nat.add_mod, hn, Nat.mod_mod]
      _ = 0 := by rw [heq, Nat.mod_self]
  · intro hd
    have hmod : Nat.ModEq r (n + (r - u % r)) (u % r + (r - u % r)) := by
      show (n + (r - u % r)) % r = (u % r + (r - u % r)) % r
      rw [Nat.mod_eq_zero_of_dvd hd, heq, Nat.mod_self]
    have hn := Nat.ModEq.add_right_cancel (Nat.ModEq.refl (r - u % r)) hmod
    simpa only [Nat.ModEq, Nat.mod_mod] using hn

theorem interval_residue_shift_image (A B r u : ℕ) (hr : 0 < r) :
    ((Ioc A B).filter (fun n => n % r = u % r)).image (fun n => n + (r - u % r)) =
      (Ioc (A + (r - u % r)) (B + (r - u % r))).filter (fun n => r ∣ n) := by
  ext m
  constructor
  · intro hm
    obtain ⟨n, hn, rfl⟩ := mem_image.mp hm
    obtain ⟨hnI, hnR⟩ := mem_filter.mp hn
    obtain ⟨ha, hb⟩ := mem_Ioc.mp hnI
    apply mem_filter.mpr
    exact ⟨mem_Ioc.mpr ⟨by omega, by omega⟩, (nat_mod_eq_iff_dvd_shift r u n hr).mp hnR⟩
  · intro hm
    obtain ⟨hmI, hmR⟩ := mem_filter.mp hm
    obtain ⟨ha, hb⟩ := mem_Ioc.mp hmI
    have hshift : m - (r - u % r) + (r - u % r) = m := by omega
    apply mem_image.mpr
    refine ⟨m - (r - u % r), mem_filter.mpr ⟨?_, ?_⟩, hshift⟩
    · exact mem_Ioc.mpr ⟨by omega, by omega⟩
    · apply (nat_mod_eq_iff_dvd_shift r u _ hr).mpr
      rwa [hshift]

theorem interval_residue_error_le_one (A B r u : ℕ) (hAB : A ≤ B) (hr : 0 < r) :
    |(((Ioc A B).filter (fun n => n % r = u % r)).card : ℝ) -
      ((B : ℝ) - A) / r| ≤ 1 := by
  have hcard := congrArg Finset.card (interval_residue_shift_image A B r u hr)
  rw [card_image_of_injective _ (fun _ _ h => Nat.add_right_cancel h)] at hcard
  rw [hcard]
  have he := interval_multiples_error_le_one (A + (r - u % r)) (B + (r - u % r)) r
    (by omega) hr
  simpa only [Nat.cast_add, add_sub_add_right_eq_sub] using he



theorem exists_residue_divisibility_crt (r d u : ℕ) (hr : 0 < r) (hd : 0 < d)
    (hcop : r.Coprime d) :
    ∃ v : ℕ, v < r * d ∧ ∀ n : ℕ,
      (n % r = u % r ∧ d ∣ n) ↔ n % (r * d) = v := by
  let v := Nat.chineseRemainder hcop u 0
  have hv : (v : ℕ) < r * d := Nat.chineseRemainder_lt_mul hcop u 0 hr.ne' hd.ne'
  refine ⟨v, hv, ?_⟩
  intro n
  constructor
  · rintro ⟨hnr, hnd⟩
    have h := Nat.chineseRemainder_modEq_unique hcop
      (show Nat.ModEq r n u from hnr) (Nat.modEq_zero_iff_dvd.mpr hnd)
    change Nat.ModEq (r * d) n v at h
    simpa only [Nat.ModEq, Nat.mod_eq_of_lt hv] using h
  · intro hn
    have h : Nat.ModEq (r * d) n v := by
      show n % (r * d) = (v : ℕ) % (r * d)
      rwa [Nat.mod_eq_of_lt hv]
    exact ⟨(h.of_dvd (dvd_mul_right r d)).trans v.property.1,
      Nat.modEq_zero_iff_dvd.mp ((h.of_dvd (dvd_mul_left d r)).trans v.property.2)⟩

theorem interval_residue_divisibility_error_le_one (A B r u d : ℕ)
    (hAB : A ≤ B) (hr : 0 < r) (hd : 0 < d) (hcop : r.Coprime d) :
    |(((Ioc A B).filter (fun n => n % r = u % r ∧ d ∣ n)).card : ℝ) -
      ((B : ℝ) - A) / (r * d : ℕ)| ≤ 1 := by
  obtain ⟨v, hv, hiff⟩ := exists_residue_divisibility_crt r d u hr hd hcop
  have hset : (Ioc A B).filter (fun n => n % r = u % r ∧ d ∣ n) =
      (Ioc A B).filter (fun n => n % (r * d) = v % (r * d)) := by
    apply filter_congr
    intro n hn
    rw [Nat.mod_eq_of_lt hv]
    exact hiff n
  rw [hset]
  exact interval_residue_error_le_one A B (r * d) v hAB (Nat.mul_pos hr hd)


end Bounty
end

section

/- Exact least-prime-factor extraction, including repeated prime factors. -/

open Finset

namespace Bounty

theorem buchstab_rough_iff_minFac {n : ℕ} (hn0 : n ≠ 0) (hn1 : n ≠ 1) (z : ℝ) :
    (∀ p ∈ n.primeFactors, z < (p : ℝ)) ↔ z < (n.minFac : ℝ) := by
  constructor
  · intro h
    exact h n.minFac (Nat.mem_primeFactors.mpr ⟨Nat.minFac_prime hn1, Nat.minFac_dvd n, hn0⟩)
  · intro h p hp
    exact h.trans_le (Nat.cast_le.mpr (Nat.minFac_le_of_dvd
      (Nat.prime_of_mem_primeFactors hp).two_le (Nat.dvd_of_mem_primeFactors hp)))

theorem buchstab_cofactor_prime_factors (n : ℕ) :
    ∀ p ∈ (n/n.minFac).primeFactors, n.minFac ≤ p := by
  intro p hp
  apply Nat.minFac_le_of_dvd (Nat.prime_of_mem_primeFactors hp).two_le
  exact (Nat.dvd_of_mem_primeFactors hp).trans (Nat.div_dvd_of_dvd (Nat.minFac_dvd n))

theorem buchstab_minFac_mul {p m : ℕ} (hp : p.Prime) (hm : m ≠ 0)
    (hrough : ∀ q ∈ m.primeFactors, p ≤ q) : (p*m).minFac = p := by
  have hpm1 : p*m ≠ 1 := by intro h; exact hp.ne_one (Nat.eq_one_of_mul_eq_one_right h)
  have hprime := Nat.minFac_prime hpm1
  apply le_antisymm (Nat.minFac_le_of_dvd hp.two_le (dvd_mul_right p m))
  rcases hprime.dvd_mul.mp (Nat.minFac_dvd (p*m)) with hdiv | hdiv
  · exact ((Nat.prime_dvd_prime_iff_eq hprime hp).mp hdiv).symm.le
  · exact hrough _ (Nat.mem_primeFactors.mpr ⟨hprime, hdiv, hm⟩)

noncomputable def buchstabCompositeCofactors (S : Finset ℕ) (N p : ℕ) : Finset ℕ := by
  classical
  exact (Icc p N).filter (fun m => p*m ∈ S ∧ ∀ q ∈ m.primeFactors, p ≤ q)

theorem buchstab_minFac_fiber_image (S : Finset ℕ) {N p : ℕ} (hp : p.Prime)
    (hSlo : ∀ n ∈ S, 2 ≤ n) (hShi : ∀ n ∈ S, n ≤ N) :
    S.filter (fun n => ¬n.Prime ∧ n.minFac = p) =
      (buchstabCompositeCofactors S N p).image (fun m => p*m) := by
  classical
  ext n
  constructor
  · intro hn
    obtain ⟨hnS, hnprime, hnfac⟩ := mem_filter.mp hn
    have hn0 : 0 < n := lt_of_lt_of_le (by norm_num : 0 < 2) (hSlo n hnS)
    have hdvd : p ∣ n := hnfac ▸ Nat.minFac_dvd n
    have hmul : p*(n/p) = n := Nat.mul_div_cancel' hdvd
    apply mem_image.mpr
    refine ⟨n/p, mem_filter.mpr ⟨mem_Icc.mpr ⟨?_, ?_⟩, (by rwa [hmul]), ?_⟩, hmul⟩
    · simpa only [hnfac] using Nat.minFac_le_div hn0 hnprime
    · exact (Nat.div_le_self n p).trans (hShi n hnS)
    · simpa only [hnfac] using buchstab_cofactor_prime_factors n
  · intro hn
    obtain ⟨m, hm, rfl⟩ := mem_image.mp hn
    obtain ⟨hmI, hmS, hmrough⟩ := mem_filter.mp hm
    have hpm : p ≤ m := (mem_Icc.mp hmI).1
    have hm0 : m ≠ 0 := ne_of_gt (hp.pos.trans_le hpm)
    refine mem_filter.mpr ⟨hmS, Nat.not_prime_mul hp.ne_one ?_, buchstab_minFac_mul hp hm0 hmrough⟩
    exact ne_of_gt (hp.one_lt.trans_le hpm)

end Bounty

end

section

/- Common smooth moduli with an independently specified ambient lower bound. -/

namespace Bounty

/-- The ambient primes need only exceed the smoothness bound; their lower
endpoint need not be twice the scale. -/
theorem exists_real_smooth_prime_modulus_above_smoothness {y δ : ℝ}
    (hy : 1 ≤ y) (P S : Finset ℕ) (hsub : P ⊆ S)
    (hprime : ∀ p ∈ S, p.Prime)
    (hbound : ∀ p ∈ S, (p : ℝ) ≤ 5 * y)
    (hlarge : ∀ p ∈ S, y ^ δ < (p : ℝ))
    (hsmooth : ∀ p ∈ P, ∀ q : ℕ, q.Prime → q ∣ p - 1 → (q : ℝ) ≤ y ^ δ) :
    ∃ (L : ℕ) (g : ℕ → (ZMod L)ˣ),
      0 < L ∧ (∀ p ∈ P, p - 1 ∣ L) ∧
      (∀ q ∈ L.primeFactors, (q : ℝ) ≤ y ^ δ) ∧
      Real.log (L : ℝ) ≤ y ^ δ * Real.log (5 * y) ∧
      Nat.card (ZMod L)ˣ ≤ L ∧ ∀ p ∈ S, (g p : ZMod L) = p := by
  have hypos : 0 < y := lt_of_lt_of_le zero_lt_one hy
  have hP : ∀ p ∈ P, p.Prime := fun p hp => hprime p (hsub hp)
  have hLpos : 0 < primePredecessorLCM P := primePredecessorLCM_pos hP
  have hsmooth' : ∀ p ∈ P, ∀ q : ℕ, q.Prime → q ∣ p - 1 → q ≤ ⌊y ^ δ⌋₊ := by
    intro p hp q hq hdiv
    exact Nat.le_floor (hsmooth p hp q hq hdiv)
  have hLsmooth : ∀ q ∈ (primePredecessorLCM P).primeFactors, (q : ℝ) ≤ y ^ δ := by
    intro q hq
    have hsmall : (q : ℝ) ≤ (⌊y ^ δ⌋₊ : ℝ) := by
      exact_mod_cast primePredecessorLCM_smooth hP hsmooth' hq
    exact hsmall.trans (Nat.floor_le (Real.rpow_nonneg hypos.le _))
  have hcoprime : ∀ p ∈ S, p.Coprime (primePredecessorLCM P) := by
    intro p hp
    apply prime_coprime_of_primeFactors_lt (hprime p hp) hLpos
    intro q hq
    exact_mod_cast (hLsmooth q hq).trans_lt (hlarge p hp)
  let g : ℕ → (ZMod (primePredecessorLCM P))ˣ := fun p =>
    if hp : p ∈ S then ZMod.unitOfCoprime p (hcoprime p hp) else 1
  refine ⟨primePredecessorLCM P, g, hLpos, ?_, hLsmooth,
    log_primePredecessorLCM_le_real hy hP (fun p hp => hbound p (hsub hp)) hsmooth,
    card_zmod_units_le hLpos, ?_⟩
  · intro p hp
    exact predecessor_dvd_primePredecessorLCM hp
  · intro p hp
    simp only [g, dif_pos hp, ZMod.coe_unitOfCoprime]

end Bounty
end

section

/- Exact grouping of consecutive operators and variable-state rows.
No additivity, positivity, or norm assumptions are required. -/

namespace Bounty

theorem finite_operator_list_action_flatMap {I K X : Type*}
    (row : I → (X → ℂ) → X → ℂ) (blocks : K → List I) (ks : List K) (F : X → ℂ) :
    finiteOperatorListAction row (ks.flatMap blocks) F =
      finiteOperatorListAction (fun k => finiteOperatorListAction row (blocks k)) ks F := by
  induction ks with
  | nil => rfl
  | cons k ks ih =>
    rw [List.flatMap_cons, finite_operator_list_action_append, ih]
    rfl

theorem finite_operator_list_action_flatten {I X : Type*}
    (row : I → (X → ℂ) → X → ℂ) (blocks : List (List I)) (F : X → ℂ) :
    finiteOperatorListAction row blocks.flatten F =
      finiteOperatorListAction (fun block => finiteOperatorListAction row block) blocks F := by
  simpa only [List.flatMap_id, id_eq] using finite_operator_list_action_flatMap row id blocks F

def finiteRowSegment {S : ℕ → Type*} {V : Type*}
    (row : ∀ i, (S (i + 1) → V) → S i → V) (a : ℕ) :
    ∀ len, (S (a + len) → V) → S a → V
  | 0, F => F
  | len + 1, F => finiteRowSegment row a len (row (a + len) F)

theorem finite_row_composition_segment {S : ℕ → Type*} {V : Type*}
    (row : ∀ i, (S (i + 1) → V) → S i → V) (a len : ℕ) (F : S (a + len) → V) :
    finiteRowComposition row (a + len) F =
      finiteRowComposition row a (finiteRowSegment row a len F) := by
  induction len with
  | zero => rfl
  | succ len ih =>
    change finiteRowComposition row (a + len) (row (a + len) F) = _
    exact ih (row (a + len) F)

def finiteRowBlockCut (length : ℕ → ℕ) : ℕ → ℕ
  | 0 => 0
  | n + 1 => finiteRowBlockCut length n + length n

def finiteRowGrouped {S : ℕ → Type*} {V : Type*}
    (row : ∀ i, (S (i + 1) → V) → S i → V) (length : ℕ → ℕ) (i : ℕ) :
    (S (finiteRowBlockCut length (i + 1)) → V) → S (finiteRowBlockCut length i) → V :=
  finiteRowSegment row (finiteRowBlockCut length i) (length i)

theorem finite_row_grouped_composition {S : ℕ → Type*} {V : Type*}
    (row : ∀ i, (S (i + 1) → V) → S i → V) (length : ℕ → ℕ)
    (n : ℕ) (F : S (finiteRowBlockCut length n) → V) :
    finiteRowComposition (S := fun i => S (finiteRowBlockCut length i)) (finiteRowGrouped row length) n F =
      finiteRowComposition row (finiteRowBlockCut length n) F := by
  induction n with
  | zero => rfl
  | succ n ih =>
    change finiteRowComposition (S := fun i => S (finiteRowBlockCut length i)) (finiteRowGrouped row length) n
      (finiteRowSegment row (finiteRowBlockCut length n) (length n) F) = _
    rw [ih]
    exact (finite_row_composition_segment row (finiteRowBlockCut length n) (length n) F).symm

def visitThreeBlockLength (i : ℕ) : ℕ := if i % 2 = 0 then 1 else 3

theorem visit_three_block_cut (i : ℕ) :
    finiteRowBlockCut visitThreeBlockLength i = 2 * i - i % 2 := by
  induction i with
  | zero => rfl
  | succ i ih =>
    simp only [finiteRowBlockCut, ih, visitThreeBlockLength]
    split_ifs <;> omega

theorem visit_three_block_cut_even (n : ℕ) :
    finiteRowBlockCut visitThreeBlockLength (2 * n) = 4 * n := by
  rw [visit_three_block_cut]
  omega

theorem visit_three_block_cut_odd (n : ℕ) :
    finiteRowBlockCut visitThreeBlockLength (2 * n + 1) = 4 * n + 1 := by
  rw [visit_three_block_cut]
  omega

theorem finite_row_composition_terminal_cast {S : ℕ → Type*} {V : Type*}
    (row : ∀ i, (S (i + 1) → V) → S i → V) {m n : ℕ} (h : m = n) (F : S n → V) :
    finiteRowComposition row m (fun s => F (cast (congrArg S h) s)) =
      finiteRowComposition row n F := by
  cases h
  rfl

theorem finite_row_visit_three_grouping {S : ℕ → Type*} {V : Type*}
    (row : ∀ i, (S (i + 1) → V) → S i → V) (n : ℕ) (F : S (4 * n + 1) → V) :
    finiteRowComposition (S := fun i => S (finiteRowBlockCut visitThreeBlockLength i)) (finiteRowGrouped row visitThreeBlockLength) (2 * n + 1)
        (fun s => F (cast (congrArg S (visit_three_block_cut_odd n)) s)) =
      finiteRowComposition row (4 * n + 1) F := by
  rw [finite_row_grouped_composition]
  exact finite_row_composition_terminal_cast row (visit_three_block_cut_odd n) F

theorem finite_row_segment_one {S : ℕ → Type*} {V : Type*}
    (row : ∀ i, (S (i + 1) → V) → S i → V) (a : ℕ) (F : S (a + 1) → V) :
    finiteRowSegment row a 1 F = row a F := rfl

theorem finite_row_segment_three {S : ℕ → Type*} {V : Type*}
    (row : ∀ i, (S (i + 1) → V) → S i → V) (a : ℕ) (F : S (a + 3) → V) :
    finiteRowSegment row a 3 F = row a (row (a + 1) (row (a + 2) F)) := rfl

theorem visit_three_block_length_even (n : ℕ) : visitThreeBlockLength (2 * n) = 1 := by
  simp [visitThreeBlockLength]

theorem visit_three_block_length_odd (n : ℕ) : visitThreeBlockLength (2 * n + 1) = 3 := by
  simp [visitThreeBlockLength]

end Bounty
end

section

/- Multiplicative constants pass through finite tensor rows whenever they
pass through each coordinate row. This retains the complete joint test. -/

namespace Bounty

theorem fin_tensor_row_mul_left (N : ℕ) {S T : Fin N → Type*}
    (row : (g : Fin N) → (T g → ℂ) → S g → ℂ)
    (hrow : ∀ g c F s, row g (fun t => c * F t) s = c * row g F s)
    (c : ℂ) (F : ((g : Fin N) → T g) → ℂ) (s : (g : Fin N) → S g) :
    finTensorRow N row (fun t => c * F t) s = c * finTensorRow N row F s := by
  induction N with
  | zero => rfl
  | succ N ih =>
    simp only [finTensorRow]
    have ht : (fun t => finTensorRow N (fun g => row g.succ)
        (fun u => c * F (Fin.cons t u)) (Fin.tail s)) =
        (fun t => c * finTensorRow N (fun g => row g.succ)
          (fun u => F (Fin.cons t u)) (Fin.tail s)) := by
      funext t
      exact ih _ (fun g => hrow g.succ) _ _
    rw [ht, hrow]

theorem fin_tensor_row_zero_function (N : ℕ) {S T : Fin N → Type*}
    (row : (g : Fin N) → (T g → ℂ) → S g → ℂ)
    (hrow : ∀ g c F s, row g (fun t => c * F t) s = c * row g F s)
    (s : (g : Fin N) → S g) : finTensorRow N row (fun _ => 0) s = 0 := by
  simpa only [zero_mul] using fin_tensor_row_mul_left N row hrow 0 (fun _ => 0) s

end Bounty
end

section

/- The target permutation in a labeled physical edge is undone by the
corresponding inverse permutation in the chronological row schedule. -/

namespace Bounty

def physicalInversePermutations {G : Type*} {J ell : ℕ}
    (σ : PhysicalPermutations G J ell) : PhysicalPermutations G J ell :=
  fun g => (σ g).symm

theorem physical_permute_inverse {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (σ : PhysicalPermutations G J ell) (L : PhysicalMarkLists P J ell) :
    physicalPermuteLabels (physicalInversePermutations σ) (physicalPermuteLabels σ L) = L := by
  funext g
  apply Function.Embedding.ext
  intro i
  exact (σ g).apply_symm_apply i |> congrArg (L g)

theorem physical_inverse_permute {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (σ : PhysicalPermutations G J ell) (L : PhysicalMarkLists P J ell) :
    physicalPermuteLabels σ (physicalPermuteLabels (physicalInversePermutations σ) L) = L := by
  funext g
  apply Function.Embedding.ext
  intro i
  exact (σ g).symm_apply_apply i |> congrArg (L g)

end Bounty
end

section

/- Exact local residue counts for the two-variable upper-bound sieve. -/

open Finset

namespace Bounty

theorem finite_mul_one_pair_card {R : Type*} [CommMonoid R] [Fintype R] [DecidableEq R] :
    ((univ : Finset (R × R)).filter (fun v => v.1 * v.2 = 1)).card = Fintype.card Rˣ := by
  classical
  let e : Rˣ ≃ {v : R × R // v.1 * v.2 = 1} :=
    { toFun := fun u => ⟨(u, ↑u⁻¹), by simp⟩
      invFun := fun v => ⟨v.1.1, v.1.2, v.2, by simpa only [mul_comm] using v.2⟩
      left_inv := fun u => by apply Units.ext; rfl
      right_inv := fun v => by apply Subtype.ext; rfl }
  simpa only [Fintype.card_subtype] using (Fintype.card_congr e).symm

theorem finite_mul_zero_pair_card {R : Type*} [Semiring R] [NoZeroDivisors R]
    [Fintype R] [DecidableEq R] :
    ((univ : Finset (R × R)).filter (fun v => v.1 * v.2 = 0)).card + 1 =
      2 * Fintype.card R := by
  classical
  let S : Finset (R × R) := Finset.product ({0} : Finset R) univ
  let T : Finset (R × R) := Finset.product (univ : Finset R) {0}
  have hzero : (univ : Finset (R × R)).filter (fun v => v.1 * v.2 = 0) = S ∪ T := by
    ext v
    simp only [S, T, Finset.product_eq_sprod, mem_filter, mem_univ, true_and, mem_union, Finset.mem_product,
      mem_singleton, and_true, mul_eq_zero]
  have hinter : S ∩ T = {(0, 0)} := by
    ext v
    simp only [S, T, Finset.product_eq_sprod, mem_inter, Finset.mem_product, mem_singleton, mem_univ, and_true, true_and]
    constructor
    · rintro ⟨h1, h2⟩
      exact Prod.ext h1 h2
    · intro hv
      cases hv
      exact ⟨rfl, rfl⟩
  have h := card_union_add_card_inter S T
  rw [hinter] at h
  simpa only [hzero, S, T, Finset.product_eq_sprod, Finset.card_product, card_singleton, card_univ, one_mul, mul_one,
    two_mul] using h

theorem prime_mul_zero_pair_card (p : ℕ) [Fact p.Prime] :
    ((univ : Finset (ZMod p × ZMod p)).filter (fun v => v.1 * v.2 = 0)).card = 2*p - 1 := by
  have h := finite_mul_zero_pair_card (R := ZMod p)
  rw [ZMod.card] at h
  omega

theorem prime_mul_one_pair_card (p : ℕ) [Fact p.Prime] :
    ((univ : Finset (ZMod p × ZMod p)).filter (fun v => v.1 * v.2 = 1)).card = p - 1 := by
  rw [finite_mul_one_pair_card, ZMod.card_units]

theorem prime_zero_or_one_pair_card (p : ℕ) [Fact p.Prime] :
    ((univ : Finset (ZMod p × ZMod p)).filter
      (fun v => v.1 * v.2 = 0 ∨ v.1 * v.2 = 1)).card = 3*p - 2 := by
  have hdisj : Disjoint
      ((univ : Finset (ZMod p × ZMod p)).filter (fun v => v.1 * v.2 = 0))
      ((univ : Finset (ZMod p × ZMod p)).filter (fun v => v.1 * v.2 = 1)) := by
    apply disjoint_left.mpr
    intro v h0 h1
    have hzero := (mem_filter.mp h0).2
    have hone := (mem_filter.mp h1).2
    exact zero_ne_one (hzero.symm.trans hone)
  rw [filter_or, card_union_of_disjoint hdisj, prime_mul_zero_pair_card, prime_mul_one_pair_card]
  have hp := (Fact.out : p.Prime).two_le
  omega

end Bounty
end

section

/- Disjoint prime pools give uniform polynomial atom bounds for arbitrary
subsets of grouped coordinates, with a factorial cost only within each group. -/

open Finset
open scoped Classical

namespace Bounty

theorem group_fiber_fin_product {G X M : Type*} [Fintype G] [Fintype X]
    [DecidableEq G] [CommMonoid M] (j : X → G) (f : X → M) :
    (∏ g, ∏ i : Fin (Fintype.card {x : X // j x = g}),
      f (((Fintype.equivFin {x : X // j x = g}).symm i).val)) = ∏ x, f x := by
  calc
    _ = ∏ g, ∏ x : {x : X // j x = g}, f x.val := by
      apply prod_congr rfl
      intro g _
      exact (Fintype.equivFin {x : X // j x = g}).symm.prod_comp (fun x => f x.val)
    _ = _ := Fintype.prod_fiberwise j f

theorem prime_group_index_physical_atom_rpow {G X : Type*} [Fintype G] [Fintype X]
    [DecidableEq G] [DecidableEq X] (j : X → G) (P : G → Finset ℕ) (V : G → ℝ)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h))) (m : ℕ)
    {v L D : ℝ} (hv : 0 < v) (hL : 0 < L) (hV : ∀ g, v ≤ V g)
    (hk : ∀ g, Fintype.card {x : X // j x = g} ≤ m)
    (hcard : (Fintype.card G : ℝ) ≤ D * Real.log L) (n : ℕ) :
    (∑ a ∈ univ.filter (fun a : (∀ x : X, P (j x)) => (∏ x, (a x).val : ℕ) = n),
      finiteProductWeight (physicalLabelLaw (P := fun x : X => P (j x))
        (fun x => V (j x))) a) ≤
      L ^ (D * Real.log (primeFiberFactorBound v m)) / (n : ℝ) := by
  let k := fun g => Fintype.card {x : X // j x = g}
  let pick := fun g (i : Fin (k g)) =>
    ((Fintype.equivFin {x : X // j x = g}).symm i).val
  have hpick (g : G) (i : Fin (k g)) : j (pick g i) = g :=
    ((Fintype.equivFin {x : X // j x = g}).symm i).property
  let x := fun (a : ∀ i : X, P (j i)) g (i : Fin (k g)) => (a (pick g i)).val
  have hxinj : Function.Injective x := by
    intro a b hab
    funext i
    apply Subtype.ext
    have hi := congrFun (congrFun hab (j i))
      ((Fintype.equivFin {x : X // j x = j i}) ⟨i, rfl⟩)
    have he : pick (j i) ((Fintype.equivFin {x : X // j x = j i}) ⟨i, rfl⟩) = i := by
      exact congrArg Subtype.val
        ((Fintype.equivFin {x : X // j x = j i}).symm_apply_apply ⟨i, rfl⟩)
    change (a (pick (j i) _)).val = (b (pick (j i) _)).val at hi
    exact he ▸ hi
  have hx (a : ∀ i : X, P (j i)) (g : G) (i : Fin (k g)) : x a g i ∈ P g := by
    have hi := (a (pick g i)).property
    simpa only [hpick] using hi
  have hprod (a : ∀ i : X, P (j i)) :
      (∏ g, ∏ i, x a g i) = ∏ i, (a i).val :=
    group_fiber_fin_product j (fun i => (a i).val)
  have hweight (a : ∀ i : X, P (j i)) :
      (∏ g, ∏ i, (1 / (x a g i : ℝ)) / V g) =
      finiteProductWeight (physicalLabelLaw (P := fun i : X => P (j i))
        (fun i => V (j i))) a := by
    calc
      _ = ∏ g, ∏ i : Fin (k g), (1 / ((a (pick g i)).val : ℝ)) / V (j (pick g i)) := by
        simp only [hpick, x]
      _ = ∏ i, (1 / ((a i).val : ℝ)) / V (j i) :=
        group_fiber_fin_product j (fun i => (1 / ((a i).val : ℝ)) / V (j i))
      _ = _ := by
        unfold finiteProductWeight physicalLabelLaw
        apply prod_congr rfl
        intro i _
        rw [div_div, mul_comm]
  have hb := prime_group_slot_harmonic_atom_rpow P k hprime hdisj x hxinj hx
    V m hv hL hV hk hcard n
  simpa only [sum_filter, hprod, hweight] using hb

theorem prime_subset_group_fiber_card {G : Type*} [DecidableEq G]
    {I : G → Type*} [∀ g, DecidableEq (I g)]
    (r : Finset G) (probes : ∀ g, Finset (I g)) (U : Finset (Sigma I))
    (hU : U ⊆ r.sigma probes) (g : G) :
    Fintype.card {i : U // i.val.fst = g} ≤ (probes g).card := by
  let f : {i : U // i.val.fst = g} → probes g := by
    rintro ⟨⟨⟨g', i⟩, hi⟩, hg⟩
    dsimp at hg
    subst g'
    exact ⟨i, (mem_sigma.mp (hU hi)).2⟩
  have hf : Function.Injective f := by
    rintro ⟨⟨⟨g₁, i₁⟩, hi₁⟩, hg₁⟩ ⟨⟨⟨g₂, i₂⟩, hi₂⟩, hg₂⟩ he
    dsimp at hg₁ hg₂
    subst g₁
    subst g₂
    have he' : i₁ = i₂ := congrArg Subtype.val he
    subst i₂
    rfl
  simpa only [Fintype.card_coe] using Fintype.card_le_of_injective f hf

theorem prime_subset_physical_atom_rpow {G : Type*} [Fintype G] [DecidableEq G]
    {I : G → Type*} [∀ g, DecidableEq (I g)]
    (P : G → Finset ℕ) (V : G → ℝ)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h)))
    (r : Finset G) (probes : ∀ g, Finset (I g)) (m : ℕ)
    {v L D : ℝ} (hv : 0 < v) (hL : 0 < L) (hV : ∀ g, v ≤ V g)
    (hm : ∀ g, (probes g).card ≤ m)
    (hcard : (Fintype.card G : ℝ) ≤ D * Real.log L)
    (U : Finset (Sigma I)) (hU : U ⊆ r.sigma probes) (n : ℕ) :
    (∑ a ∈ univ.filter (fun a : (∀ i : U, P i.val.fst) => (∏ i, (a i).val : ℕ) = n),
      finiteProductWeight (physicalLabelLaw (P := fun i : U => P i.val.fst)
        (fun i => V i.val.fst)) a) ≤
      L ^ (D * Real.log (primeFiberFactorBound v m)) / (n : ℝ) := by
  exact prime_group_index_physical_atom_rpow (fun i : U => i.val.fst) P V hprime
    hdisj m hv hL hV (fun g => (prime_subset_group_fiber_card r probes U hU g).trans (hm g))
    hcard n

end Bounty
end

section

/- Scalar factors in finite chronological row compositions with varying
state types. Only multiplicative homogeneity of the unweighted rows is used. -/

open Finset

namespace Bounty

theorem finite_row_composition_mul {S : ℕ → Type*} {V : Type*} [CommMonoid V]
    (row : (i : ℕ) → (S (i + 1) → V) → S i → V) (n : ℕ)
    (hrow : ∀ i, i < n → ∀ c F s, row i (fun t => c * F t) s = c * row i F s)
    (c : V) (F : S n → V) :
    finiteRowComposition row n (fun t => c * F t) =
      fun s => c * finiteRowComposition row n F s := by
  induction n with
  | zero => rfl
  | succ n ih =>
    have he : row n (fun t => c * F t) = fun s => c * row n F s :=
      funext (hrow n (Nat.lt_succ_self n) c F)
    rw [finite_row_composition_succ, he]
    exact ih (fun i hi => hrow i (Nat.lt_trans hi (Nat.lt_succ_self n))) (row n F)

theorem finite_row_composition_scalar_rows {S : ℕ → Type*} {V : Type*} [CommMonoid V]
    (row weighted : (i : ℕ) → (S (i + 1) → V) → S i → V)
    (c : ℕ → V) (n : ℕ)
    (hrow : ∀ i, i < n → ∀ d F s, row i (fun t => d * F t) s = d * row i F s)
    (hweighted : ∀ i, i < n → ∀ F s, weighted i F s = c i * row i F s)
    (F : S n → V) :
    finiteRowComposition weighted n F =
      fun s => (∏ i ∈ range n, c i) * finiteRowComposition row n F s := by
  induction n with
  | zero => simp only [finite_row_composition_zero, range_zero, prod_empty, one_mul]
  | succ n ih =>
    have hr := fun i hi => hrow i (Nat.lt_trans hi (Nat.lt_succ_self n))
    have hw := fun i hi => hweighted i (Nat.lt_trans hi (Nat.lt_succ_self n))
    have he : weighted n F = fun s => c n * row n F s :=
      funext (hweighted n (Nat.lt_succ_self n) F)
    rw [finite_row_composition_succ, he, ih hr hw,
      finite_row_composition_mul row n hr (c n) (row n F)]
    simp only [prod_range_succ, finite_row_composition_succ, mul_assoc]

theorem finite_row_composition_weighted {S : ℕ → Type*} {V : Type*} [CommMonoid V]
    (row : (i : ℕ) → (S (i + 1) → V) → S i → V)
    (c : ℕ → V) (n : ℕ)
    (hrow : ∀ i, i < n → ∀ d F s, row i (fun t => d * F t) s = d * row i F s)
    (F : S n → V) :
    finiteRowComposition (fun i F s => c i * row i F s) n F =
      fun s => (∏ i ∈ range n, c i) * finiteRowComposition row n F s :=
  finite_row_composition_scalar_rows row (fun i F s => c i * row i F s) c n hrow
    (fun _ _ _ _ => rfl) F

end Bounty
end

section

/- Shared labels in the physical full-state encoding are independent of memory. -/

namespace Bounty

noncomputable def physicalSharedMarkLabels {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (L : PhysicalMarkLists P J ell) :
    SharedActiveLabels (fun g => ↥(P g))
      (fun g => physicalFullSharedIndices (ell := ell) (C g)) :=
  fun g i => L g (physicalFullSlotIndex (C g)
    (((physicalFullSharedIndices (ell := ell) (C g)).equivFin.symm i).val))

theorem physical_full_memory_state_shared_labels
    {G : Type*} {P : G → Finset ℕ} {Z : G → Type*} {J ell B : ℕ}
    (C : G → Finset (Fin J)) (L : PhysicalMarkLists P J ell)
    (q : ∀ g, BoundedOrderedTuple (Z g) B) :
    (productActiveMemorySplit (fun g => physicalFullSharedIndices (C g)) B
      (physicalFullMemoryState C L q)).1 = physicalSharedMarkLabels C L := rfl

end Bounty
end

section

/- Function maps such as zero extension intertwine finite row compositions. -/

namespace Bounty

theorem finite_row_composition_test_maps {S T : Nat → Type*} {V : Type*}
    (rowS : (i : Nat) → (S (i + 1) → V) → S i → V)
    (rowT : (i : Nat) → (T (i + 1) → V) → T i → V)
    (map : (i : Nat) → (T i → V) → S i → V) (n : Nat)
    (hrow : ∀ i, i < n → ∀ F, map i (rowT i F) = rowS i (map (i + 1) F))
    (F : T n → V) :
    map 0 (finiteRowComposition rowT n F) = finiteRowComposition rowS n (map n F) := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [finite_row_composition_succ, finite_row_composition_succ,
        ← hrow n (Nat.lt_succ_self n)]
      exact ih (fun i hi => hrow i (Nat.lt_trans hi (Nat.lt_succ_self n))) (rowT n F)

end Bounty
end

section

/- Exact products along a four-phase schedule ending with its final visit. -/

namespace Bounty

theorem four_phase_list_product {M : Type*} [CommMonoid M] (a b c : M) (n : ℕ) :
    ((List.range (4 * n + 1)).map
      (fun i => if i % 4 = 0 then a else if i % 4 = 2 then b else c)).prod =
      a ^ (n + 1) * b ^ n * c ^ (2 * n) := by
  induction n with
  | zero => simp
  | succ n ih =>
    have hlen : 4 * (n + 1) + 1 = 4 * n + 1 + 1 + 1 + 1 + 1 := by omega
    have h1 : (4 * n + 1) % 4 = 1 := by omega
    have h2 : (4 * n + 1 + 1) % 4 = 2 := by omega
    have h3 : (4 * n + 1 + 1 + 1) % 4 = 3 := by omega
    have h4 : (4 * n + 1 + 1 + 1 + 1) % 4 = 0 := by omega
    rw [hlen, List.prod_range_succ, List.prod_range_succ,
      List.prod_range_succ, List.prod_range_succ, ih]
    simp only [h1, h2, h3, h4, Nat.reduceEqDiff, if_false, if_true]
    rw [Nat.mul_add, mul_one, pow_add c (2 * n) 2, pow_two]
    simp only [pow_succ]
    ac_rfl

end Bounty
end

section

/- At most one selected phase contributes to a disjoint finite sum. -/

open Finset
open scoped Classical
namespace Bounty

theorem finite_disjoint_phase_norm_le_one {D : Type*} (S : Finset D)
    (Q : D → Prop) (w : D → ℂ)
    (hunique : ∀ d ∈ S, ∀ e ∈ S, Q d → Q e → d = e)
    (hw : ∀ d ∈ S, Q d → ‖w d‖ ≤ 1) :
    ‖∑ d ∈ S, if Q d then w d else 0‖ ≤ 1 := by
  by_cases hex : ∃ d ∈ S, Q d
  · obtain ⟨d, hd, hQd⟩ := hex
    rw [sum_eq_single d]
    · simpa only [if_pos hQd] using hw d hd hQd
    · intro e he hne
      apply if_neg
      intro hQe
      exact hne (hunique e he d hd hQe hQd)
    · intro hnot
      exact False.elim (hnot hd)
  · have hz : (∑ d ∈ S, if Q d then w d else 0) = (0 : ℂ) := by
      apply sum_eq_zero
      intro d hd
      apply if_neg
      intro hQ
      exact hex ⟨d, hd, hQ⟩
    rw [hz]
    simp

end Bounty
end

section

/- Summing a uniquely selected source evaluates its initial weight exactly. -/

open Finset
open scoped Classical
namespace Bounty

theorem finite_selected_source_pairing {D M : Type*} [Fintype M]
    (S : Finset D) (a : M → ℂ) (w H : D → ℂ) (source : D → M)
    (F : D → M → ℂ)
    (hF : ∀ d ∈ S, ∀ m, F d m = if m = source d then H d else 0) :
    (∑ m, a m * ∑ d ∈ S, w d * F d m) =
      ∑ d ∈ S, a (source d) * (w d * H d) := by
  simp only [mul_sum]
  rw [sum_comm]
  apply sum_congr rfl
  intro d hd
  simp_rw [hF d hd]
  simp only [mul_ite, mul_zero]
  simp

end Bounty
end

section

/- Exact compatibility support of the original finite residue vertex product. -/

open Finset
open scoped Classical
namespace Bounty

section Compatibility
variable {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}

noncomputable def physicalResiduePathCompatible
    (labels : ℕ → PhysicalMarkLists P J ell) (visits : Finset ℕ)
    (offset : ℕ → ℤ) (r : PhysicalResidues P) : Prop :=
  ∀ j ∈ visits, ∀ p ∈ physicalMarkedPrimes (labels j), r p = -(offset j : ZMod p.2.val)

theorem physical_residue_translated_marks_valid_iff
    (r : PhysicalResidues P) (L : PhysicalMarkLists P J ell) (a : ℤ) :
    physicalResidueMarksValid (physicalTranslateResidues r a) L ↔
      ∀ p ∈ physicalMarkedPrimes L, r p = -(a : ZMod p.2.val) := by
  rw [physical_residue_marks_valid_iff_marked]
  simp only [physicalTranslateResidues, add_eq_zero_iff_eq_neg]

theorem physical_residue_path_compatible_iff
    (labels : ℕ → PhysicalMarkLists P J ell) (visits : Finset ℕ)
    (offset : ℕ → ℤ) (r : PhysicalResidues P) :
    physicalResiduePathCompatible labels visits offset r ↔
      ∀ j ∈ visits, physicalResidueMarksValid (physicalTranslateResidues r (offset j)) (labels j) := by
  simp only [physicalResiduePathCompatible, physical_residue_translated_marks_valid_iff]

theorem physical_residue_path_compatible_range_iff
    (labels : ℕ → PhysicalMarkLists P J ell) (n : ℕ)
    (offset : ℕ → ℤ) (r : PhysicalResidues P) :
    physicalResiduePathCompatible labels (range n) offset r ↔
      ∀ j : Fin n, ∀ p ∈ physicalMarkedPrimes (labels j.val),
        r p = -(offset j.val : ZMod p.2.val) := by
  constructor
  · intro h j
    exact h j.val (mem_range.mpr j.isLt)
  · intro h j hj
    exact h ⟨j, mem_range.mp hj⟩

theorem physical_residue_vertex_product_zero_of_incompatible
    (labels : ℕ → PhysicalMarkLists P J ell) (visits : Finset ℕ)
    (offset : ℕ → ℤ) (q : ℕ → ℝ) (r : PhysicalResidues P)
    (h : ¬ physicalResiduePathCompatible labels visits offset r) :
    (∏ j ∈ visits, physicalResidueVertexWeight (labels j) (q j)
      (physicalTranslateResidues r (offset j))) = 0 := by
  rw [physical_residue_path_compatible_iff] at h
  push Not at h
  obtain ⟨j, hj, hinvalid⟩ := h
  exact prod_eq_zero hj (physical_residue_vertex_weight_zero_of_invalid
    (labels j) (q j) (physicalTranslateResidues r (offset j)) hinvalid)

theorem physical_residue_vertex_product_nonzero_compatible
    (labels : ℕ → PhysicalMarkLists P J ell) (visits : Finset ℕ)
    (offset : ℕ → ℤ) (q : ℕ → ℝ) (r : PhysicalResidues P)
    (h : (∏ j ∈ visits, physicalResidueVertexWeight (labels j) (q j)
      (physicalTranslateResidues r (offset j))) ≠ 0) :
    physicalResiduePathCompatible labels visits offset r := by
  by_contra hn
  exact h (physical_residue_vertex_product_zero_of_incompatible labels visits offset q r hn)

end Compatibility
end Bounty
end

section

/- The actual ordered Q slots in the microscopic bands and their harmonic mass. -/

open Finset

namespace Bounty

noncomputable def candidateMicroQIndices (c L : ℝ) (J : ℕ) : Finset ℕ :=
  (candidateQIndices c L).filter (fun j => J ≤ j)

noncomputable def candidateMicroQSlotChoices (c L : ℝ) (r jStar J : ℕ)
    (slot : (candidateMicroQIndices c L J) × Fin r) : Finset ℕ :=
  if slot.1.val = jStar ∧ slot.2.val = 0 then candidateRoughBand c L jStar
  else candidateQBand (c*L) slot.1.val

noncomputable def candidateMicroQWeight (c L : ℝ) (r jStar J n : ℕ) : ℝ :=
  orderedSlotWeight (candidateMicroQSlotChoices c L r jStar J)
    ((r.factorial : ℝ)^(candidateMicroQIndices c L J).card) n

noncomputable def candidateMicroQHarmonicMass (c L : ℝ) (r jStar J : ℕ) : ℝ :=
  ∑' n : ℕ, candidateMicroQWeight c L r jStar J n / (n : ℝ)

noncomputable def candidateQBandHarmonicFactor (c L : ℝ) (r jStar j : ℕ) : ℝ :=
  (∏ k : Fin r, ∑ p ∈ (if j = jStar ∧ k.val = 0 then candidateRoughBand c L jStar
    else candidateQBand (c*L) j), 1/(p : ℝ)) / (r.factorial : ℝ)

theorem candidate_micro_Q_weight_nonneg (c L : ℝ) (r jStar J n : ℕ) :
    0 ≤ candidateMicroQWeight c L r jStar J n :=
  ordered_slot_weight_nonneg _ (by positivity) n

theorem candidate_micro_Q_harmonic_nonneg (c L : ℝ) (r jStar J : ℕ) :
    0 ≤ candidateMicroQHarmonicMass c L r jStar J :=
  tsum_nonneg (fun n => div_nonneg (candidate_micro_Q_weight_nonneg c L r jStar J n) (Nat.cast_nonneg n))

theorem candidate_Q_harmonic_eq_band_factors (c L : ℝ) (r jStar : ℕ) :
    candidateQHarmonicMass c L r jStar =
      ∏ j ∈ candidateQIndices c L, candidateQBandHarmonicFactor c L r jStar j := by
  rw [candidate_Q_harmonic_eq_group_product]
  exact prod_coe_sort _ (candidateQBandHarmonicFactor c L r jStar)

theorem candidate_micro_Q_harmonic_eq_band_factors (c L : ℝ) (r jStar J : ℕ) :
    candidateMicroQHarmonicMass c L r jStar J =
      ∏ j ∈ candidateMicroQIndices c L J, candidateQBandHarmonicFactor c L r jStar j := by
  classical
  unfold candidateMicroQHarmonicMass candidateMicroQWeight
  rw [ordered_slot_harmonic_sum, Fintype.prod_prod_type]
  have he := prod_coe_sort (candidateMicroQIndices c L J) (candidateQBandHarmonicFactor c L r jStar)
  convert he using 1
  simp only [candidateQBandHarmonicFactor, candidateMicroQSlotChoices, prod_div_distrib,
    prod_const, card_univ, Fintype.card_coe]

theorem candidate_Q_band_factor_pure (c L : ℝ) (r jStar j : ℕ) (hne : j ≠ jStar) :
    candidateQBandHarmonicFactor c L r jStar j =
      (∑ p ∈ candidateQBand (c*L) j, 1/(p : ℝ))^r / (r.factorial : ℝ) := by
  simp [candidateQBandHarmonicFactor, hne]

theorem candidate_Q_harmonic_split_micro (c L : ℝ) (r jStar J : ℕ) :
    candidateQHarmonicMass c L r jStar =
      (∏ j ∈ (candidateQIndices c L).filter (fun j => j < J),
        candidateQBandHarmonicFactor c L r jStar j) * candidateMicroQHarmonicMass c L r jStar J := by
  rw [candidate_Q_harmonic_eq_band_factors, candidate_micro_Q_harmonic_eq_band_factors]
  symm
  simpa only [candidateMicroQIndices, Nat.not_lt] using
    prod_filter_mul_prod_filter_not (candidateQIndices c L) (fun j => j < J)
      (candidateQBandHarmonicFactor c L r jStar)

end Bounty
end

section

/- Read an owning source and its full dependent event from an existing path. -/

namespace Bounty

universe u v w

def finiteEventPathOccurrence {K : Type u} {X : Type v} (E : K → X → Type w)
    (target : ∀ k x, E k x → X) :
    ∀ (steps : List K) (x : X), FiniteEventPath E target steps x →
      (i : Fin steps.length) → Σ y, E (steps.get i) y
  | [], _, _, i => Fin.elim0 i
  | k :: steps, x, ⟨e, p⟩, i =>
      Fin.cases ⟨x, e⟩ (fun j => finiteEventPathOccurrence E target steps (target k x e) p j) i

theorem finite_event_path_occurrence_zero
    {K : Type u} {X : Type v} (E : K → X → Type w)
    (target : ∀ k x, E k x → X) (k : K) (steps : List K) (x : X)
    (e : E k x) (p : FiniteEventPath E target steps (target k x e)) :
    finiteEventPathOccurrence E target (k :: steps) x ⟨e, p⟩ 0 = ⟨x, e⟩ := rfl

theorem finite_event_path_occurrence_succ
    {K : Type u} {X : Type v} (E : K → X → Type w)
    (target : ∀ k x, E k x → X) (k : K) (steps : List K) (x : X)
    (e : E k x) (p : FiniteEventPath E target steps (target k x e))
    (i : Fin steps.length) :
    finiteEventPathOccurrence E target (k :: steps) x ⟨e, p⟩ i.succ =
      finiteEventPathOccurrence E target steps (target k x e) p i := rfl

end Bounty
end

section

/- Fixed potential birth slots depend on schedule occurrences, not the path. -/

namespace Bounty

section Addresses

variable {J K : Type*} {N : ℕ} {M : Fin N → ℕ}
    (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)

def fullMixedBirthCapacity : Option (J ⊕ K) → Fin N → ℕ
  | none, _ => 0
  | some (.inl _), _ => B
  | some (.inr k), g => (S k g)ᶜ.card

abbrev FullMixedLocalBirthAddress (tag : Option (J ⊕ K)) :=
  (g : Fin N) × Fin (fullMixedBirthCapacity S B tag g)

abbrev FullMixedBirthAddress (steps : List (Option (J ⊕ K))) :=
  (i : Fin steps.length) × FullMixedLocalBirthAddress S B (steps.get i)

def fullMixedBirthOwner (steps : List (Option (J ⊕ K)))
    (a : FullMixedBirthAddress S B steps) : Fin steps.length := a.1

theorem full_mixed_birth_owner_mk (steps : List (Option (J ⊕ K)))
    (i : Fin steps.length) (a : FullMixedLocalBirthAddress S B (steps.get i)) :
    fullMixedBirthOwner S B steps ⟨i, a⟩ = i := rfl

theorem full_mixed_birth_capacity_le (T : ℕ)
    (hT : ∀ k g, (S k g)ᶜ.card ≤ T) (tag : Option (J ⊕ K)) (g : Fin N) :
    fullMixedBirthCapacity S B tag g ≤ max B T := by
  cases tag with
  | none => exact Nat.zero_le _
  | some tag =>
    cases tag with
    | inl _ => exact le_max_left _ _
    | inr k => exact (hT k g).trans (le_max_right _ _)

theorem full_mixed_local_birth_address_card (tag : Option (J ⊕ K)) :
    Fintype.card (FullMixedLocalBirthAddress S B tag) =
      ∑ g, fullMixedBirthCapacity S B tag g := by
  simp only [FullMixedLocalBirthAddress, Fintype.card_sigma, Fintype.card_fin]

theorem full_mixed_birth_address_card (steps : List (Option (J ⊕ K))) :
    Fintype.card (FullMixedBirthAddress S B steps) =
      ∑ i : Fin steps.length, ∑ g, fullMixedBirthCapacity S B (steps.get i) g := by
  simp only [FullMixedBirthAddress, Fintype.card_sigma, Fintype.card_fin]

theorem full_mixed_birth_address_card_le (T : ℕ)
    (hT : ∀ k g, (S k g)ᶜ.card ≤ T) (steps : List (Option (J ⊕ K))) :
    Fintype.card (FullMixedBirthAddress S B steps) ≤ steps.length * (N * max B T) := by
  rw [full_mixed_birth_address_card]
  calc
    _ ≤ ∑ _i : Fin steps.length, ∑ _g : Fin N, max B T := by
      apply Finset.sum_le_sum
      intro i _
      apply Finset.sum_le_sum
      intro g _
      exact full_mixed_birth_capacity_le S B T hT (steps.get i) g
    _ = _ := by simp

end Addresses

end Bounty
end

section

/- An operation multiplier reads only the birth data of its own addresses. -/

namespace Bounty

theorem birth_forest_operation_multiplier_congr_on_owner
    {m : ℕ} {Op : Type*} (code : BirthForestCode m) (owner : Fin m → Op)
    (θ : (Fin m × Fin m) → ℝ) (performed performed' : Fin m → Prop)
    (label label' : Fin m → ℤ) (o : Op)
    (hp : ∀ j, owner j = o → (performed j ↔ performed' j))
    (hl : ∀ j, owner j = o → label j = label' j) :
    birthForestOperationMultiplier code owner θ performed label o =
      birthForestOperationMultiplier code owner θ performed' label' o := by
  classical
  unfold birthForestOperationMultiplier
  apply Finset.prod_congr rfl
  intro j hj
  have ho : owner j = o := (Finset.mem_filter.mp hj).2
  have hpred : (j ∈ birthForestTouched code → performed j) =
      (j ∈ birthForestTouched code → performed' j) := propext
    ⟨fun h ht => (hp j ho).mp (h ht), fun h ht => (hp j ho).mpr (h ht)⟩
  simp only [hpred, hl j ho]

end Bounty
end

section

/- Recover a projected weighted norm from pairings against symmetric tests.
The operator is arbitrary; no linearity or prior operator norm is assumed. -/

open Finset
open scoped Classical

namespace Bounty

theorem clean_active_norm_eq_sqrt_energy {X : Type*} [Fintype X]
    (w : X → ℝ) (u : X → ℂ) :
    cleanActiveNorm w u = Real.sqrt (finiteWeightedEnergy w u) := rfl

theorem clean_weighted_self_pairing_norm {X : Type*} [Fintype X]
    (w : X → ℝ) (hw : ∀ x, 0 ≤ w x) (u : X → ℂ) :
    ‖∑ x, (w x : ℂ) * (starRingEnd ℂ) (u x) * u x‖ =
      cleanActiveNorm w u ^ 2 := by
  have he : (∑ x, (w x : ℂ) * (starRingEnd ℂ) (u x) * u x) =
      ((∑ x, w x * ‖u x‖ ^ 2 : ℝ) : ℂ) := by
    rw [Complex.ofReal_sum]
    apply sum_congr rfl
    intro x hx
    rw [mul_assoc, Complex.conj_mul', Complex.ofReal_mul, Complex.ofReal_pow]
  rw [he, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (sum_nonneg (fun x _ => mul_nonneg (hw x) (sq_nonneg _))),
    clean_active_norm_sq w hw]

theorem clean_active_norm_le_of_self_pairing {X : Type*} [Fintype X]
    (w : X → ℝ) (hw : ∀ x, 0 ≤ w x) (u : X → ℂ) {C : ℝ}
    (hC : 0 ≤ C)
    (hpair : ‖∑ x, (w x : ℂ) * (starRingEnd ℂ) (u x) * u x‖ ≤
      C * cleanActiveNorm w u) :
    cleanActiveNorm w u ≤ C := by
  rw [clean_weighted_self_pairing_norm w hw u, pow_two] at hpair
  by_cases hzero : cleanActiveNorm w u = 0
  · simpa only [hzero] using hC
  · have hn : 0 ≤ cleanActiveNorm w u := Real.sqrt_nonneg _
    have hp : 0 < cleanActiveNorm w u := lt_of_le_of_ne hn (Ne.symm hzero)
    exact (mul_le_mul_iff_left₀ hp).mp hpair

theorem repeated_big_symmetric_pairing_symmetrize {G : Type*}
    [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (w : RepeatedBigLists P J ell → ℝ)
    (hw : ∀ (σ : PhysicalPermutations G J ell) L,
      w (repeatedBigPermutationEquiv σ L) = w L)
    (f u : RepeatedBigLists P J ell → ℂ)
    (hf : f ∈ repeatedBigSymmetricSubspace) :
    (∑ L, (w L : ℂ) * (starRingEnd ℂ) (f L) * repeatedBigSymmetrizeLinear u L) =
      ∑ L, (w L : ℂ) * (starRingEnd ℂ) (f L) * u L := by
  have hσ (σ : PhysicalPermutations G J ell) :
      (∑ L, (w L : ℂ) * (starRingEnd ℂ) (f L) *
        u (repeatedBigPermutationEquiv σ L)) =
      ∑ L, (w L : ℂ) * (starRingEnd ℂ) (f L) * u L := by
    have he := (repeatedBigPermutationEquiv (P := P) σ).sum_comp
      (fun L => (w L : ℂ) * (starRingEnd ℂ) (f L) * u L)
    simpa only [hw, show ∀ σ L, f (repeatedBigPermutationEquiv σ L) = f L from hf]
      using he
  change (∑ L, (w L : ℂ) * (starRingEnd ℂ) (f L) *
    ((Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
      ∑ σ : PhysicalPermutations G J ell, u (repeatedBigPermutationEquiv σ L))) = _
  calc
    _ = (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
        ∑ σ : PhysicalPermutations G J ell,
          ∑ L, (w L : ℂ) * (starRingEnd ℂ) (f L) * u (repeatedBigPermutationEquiv σ L) := by
      rw [sum_comm]
      simp_rw [mul_sum]
      apply sum_congr rfl
      intro L hL
      apply sum_congr rfl
      intro σ hσ
      ring
    _ = _ := by
      simp_rw [hσ]
      rw [sum_const, card_univ, nsmul_eq_mul, ← mul_assoc, inv_mul_cancel₀, one_mul]
      exact_mod_cast Fintype.card_ne_zero

theorem repeated_big_projected_norm_le_of_pairing {G : Type*}
    [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (w : RepeatedBigLists P J ell → ℝ) (hw0 : ∀ L, 0 ≤ w L)
    (hw : ∀ (σ : PhysicalPermutations G J ell) L,
      w (repeatedBigPermutationEquiv σ L) = w L)
    (u : RepeatedBigLists P J ell → ℂ) {C : ℝ} (hC : 0 ≤ C)
    (hpair : ∀ f : RepeatedBigLists P J ell → ℂ,
      f ∈ repeatedBigSymmetricSubspace →
      ‖∑ L, (w L : ℂ) * (starRingEnd ℂ) (f L) * u L‖ ≤ C * cleanActiveNorm w f) :
    cleanActiveNorm w (repeatedBigSymmetrizeLinear u) ≤ C := by
  apply clean_active_norm_le_of_self_pairing w hw0 _ hC
  rw [repeated_big_symmetric_pairing_symmetrize w hw _ u (repeated_big_symmetrize_mem u)]
  exact hpair _ (repeated_big_symmetrize_mem u)

theorem repeated_big_operator_norm_le_of_symmetric_pairing {G : Type*}
    [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (w : RepeatedBigLists P J ell → ℝ) (hw0 : ∀ L, 0 ≤ w L)
    (hw : ∀ (σ : PhysicalPermutations G J ell) L,
      w (repeatedBigPermutationEquiv σ L) = w L)
    (A : (RepeatedBigLists P J ell → ℂ) → RepeatedBigLists P J ell → ℂ)
    {M : ℝ} (hM : 0 ≤ M)
    (hpair : ∀ f v : RepeatedBigLists P J ell → ℂ,
      f ∈ repeatedBigSymmetricSubspace → v ∈ repeatedBigSymmetricSubspace →
      ‖∑ L, (w L : ℂ) * (starRingEnd ℂ) (f L) * A v L‖ ≤
        M * cleanActiveNorm w f * cleanActiveNorm w v)
    (v : RepeatedBigLists P J ell → ℂ) (hv : v ∈ repeatedBigSymmetricSubspace) :
    cleanActiveNorm w (repeatedBigSymmetrizeLinear (A v)) ≤ M * cleanActiveNorm w v := by
  apply repeated_big_projected_norm_le_of_pairing w hw0 hw (A v)
    (C := M * cleanActiveNorm w v) (mul_nonneg hM (Real.sqrt_nonneg _))
  intro f hf
  simpa only [mul_right_comm] using hpair f v hf hv

theorem repeated_big_untilted_operator_norm_le_of_symmetric_pairing {G : Type*}
    [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (hV : ∀ g, 0 ≤ V g)
    (A : (RepeatedBigLists P J ell → ℂ) → RepeatedBigLists P J ell → ℂ)
    {M : ℝ} (hM : 0 ≤ M)
    (hpair : ∀ f v : RepeatedBigLists P J ell → ℂ,
      f ∈ repeatedBigSymmetricSubspace → v ∈ repeatedBigSymmetricSubspace →
      ‖∑ L, (repeatedBigActiveMass V (fun _ _ => 1) L : ℂ) *
        (starRingEnd ℂ) (f L) * A v L‖ ≤
        M * cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f *
          cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) v)
    (v : RepeatedBigLists P J ell → ℂ) (hv : v ∈ repeatedBigSymmetricSubspace) :
    cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
      (repeatedBigSymmetrizeLinear (A v)) ≤
      M * cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) v :=
  repeated_big_operator_norm_le_of_symmetric_pairing _
    (repeated_big_untilted_active_mass_nonneg V hV)
    (repeated_big_active_mass_permutation V (fun _ _ => 1)) A hM hpair v hv

theorem clean_raw_sub_kernel_pairing {X : Type*} [Fintype X]
    (w : X → ℝ) (k : X → ℂ) (K : X → X → ℂ) (f v : X → ℂ) :
    cleanRawPairing w k f v - cleanKernelPairing w K f v =
      ∑ x, (w x : ℂ) * (starRingEnd ℂ) (f x) *
        (k x * v x - ∑ y, K x y * v y) := by
  simp only [cleanRawPairing, cleanKernelPairing, mul_sub, mul_sum, sum_sub_distrib]
  apply congrArg₂ (fun a b : ℂ => a - b)
  · apply sum_congr rfl
    intro x hx
    ring
  · apply sum_congr rfl
    intro x hx
    apply sum_congr rfl
    intro y hy
    ring

theorem repeated_big_raw_sub_kernel_norm_le_of_bilinear {G : Type*}
    [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (hV : ∀ g, 0 ≤ V g)
    (k : RepeatedBigLists P J ell → ℂ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → ℂ)
    {M : ℝ} (hM : 0 ≤ M)
    (hpair : ∀ f v : RepeatedBigLists P J ell → ℂ,
      f ∈ repeatedBigSymmetricSubspace → v ∈ repeatedBigSymmetricSubspace →
      ‖cleanRawPairing (repeatedBigActiveMass V (fun _ _ => 1)) k f v -
        cleanKernelPairing (repeatedBigActiveMass V (fun _ _ => 1)) K f v‖ ≤
        M * cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f *
          cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) v)
    (v : RepeatedBigLists P J ell → ℂ) (hv : v ∈ repeatedBigSymmetricSubspace) :
    cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
      (repeatedBigSymmetrizeLinear (fun x => k x * v x - ∑ y, K x y * v y)) ≤
      M * cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) v := by
  apply repeated_big_untilted_operator_norm_le_of_symmetric_pairing V hV _ hM _ v hv
  intro f u hf hu
  rw [← clean_raw_sub_kernel_pairing]
  exact hpair f u hf hu

end Bounty
end

section

/- The finite images of optional prefix draws and optional fresh slots. -/

open scoped Classical

namespace Bounty

theorem optional_prefix_birth_image {P : Type*} [DecidableEq P] (B b : ℕ) (hb : b ≤ B)
    (f : Fin b → P) :
    (Finset.univ.biUnion (fun i : Fin B =>
      (if h : i.val < b then some (f ⟨i.val, h⟩) else none).toFinset)) =
      Finset.univ.image f := by
  classical
  ext p
  simp only [Finset.mem_biUnion, Finset.mem_univ, true_and, Finset.mem_image]
  constructor
  · rintro ⟨i, hi⟩
    by_cases h : i.val < b
    · simp only [dif_pos h, Option.toFinset_some, Finset.mem_singleton] at hi
      exact ⟨⟨i.val, h⟩, hi.symm⟩
    · simp [h] at hi
  · rintro ⟨i, hi⟩
    refine ⟨⟨i.val, i.isLt.trans_le hb⟩, ?_⟩
    simp only [dif_pos i.isLt, Option.toFinset_some, Finset.mem_singleton]
    exact hi.symm

theorem optional_fresh_birth_image {I P : Type*} [Fintype I] [DecidableEq I] [DecidableEq P]
    (promotions : Finset I) (f : {i : I // i ∉ promotions} → P) :
    (Finset.univ.biUnion (fun i : I =>
      (if h : i ∈ promotions then none else some (f ⟨i, h⟩)).toFinset)) =
      Finset.univ.image f := by
  classical
  ext p
  simp only [Finset.mem_biUnion, Finset.mem_univ, true_and, Finset.mem_image]
  constructor
  · rintro ⟨i, hi⟩
    by_cases h : i ∈ promotions
    · simp [h] at hi
    · simp only [dif_neg h, Option.toFinset_some, Finset.mem_singleton] at hi
      exact ⟨⟨i, h⟩, hi.symm⟩
  · rintro ⟨i, hi⟩
    refine ⟨i.val, ?_⟩
    simp only [dif_neg i.property, Option.toFinset_some, Finset.mem_singleton]
    exact hi.symm

end Bounty
end

section

/- Remove unit visit factors from an alternating finite product. -/

open Finset
namespace Bounty

theorem alternating_even_one_product {M : Type*} [CommMonoid M]
    (f : ℕ → M) (n : ℕ) (h : ∀ j ≤ n, f (2 * j) = 1) :
    (∏ i ∈ range (2 * n + 1), f i) = ∏ j ∈ range n, f (2 * j + 1) := by
  induction n with
  | zero => simpa using h 0 (by omega)
  | succ n ih =>
    have hn : 2 * (n + 1) + 1 = (2 * n + 1) + 1 + 1 := by omega
    rw [hn, prod_range_succ, prod_range_succ, ih (fun j hj => h j (by omega)),
      show 2 * n + 1 + 1 = 2 * (n + 1) by omega, h (n + 1) le_rfl,
      mul_one, prod_range_succ]

end Bounty
end

section

/- Scale finite complex weighted sums without changing their index set. -/

open Finset
namespace Bounty

theorem finite_complex_weighted_sum_scale {I : Type*} [Fintype I]
    (w f : I → ℂ) {W : ℝ} (hW : 0 < W) :
    (∑ i, w i * f i) = (W : ℂ) * ∑ i, (w i / (W : ℂ)) * f i := by
  have hWc : (W : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hW)
  rw [mul_sum]
  apply sum_congr rfl
  intro i hi
  field_simp

theorem finite_complex_weighted_sum_scale_sq {I : Type*} [Fintype I]
    (w f : I → ℂ) {W E : ℝ} (hW : 0 < W)
    (h : ‖(∑ i, (w i / (W : ℂ)) * f i)‖ ^ 2 ≤ E) :
    ‖(∑ i, w i * f i)‖ ^ 2 ≤ W ^ 2 * E := by
  rw [finite_complex_weighted_sum_scale w f hW, norm_mul, Complex.norm_real,
    Real.norm_eq_abs, abs_of_pos hW, mul_pow]
  exact mul_le_mul_of_nonneg_left h (sq_nonneg W)

end Bounty
end

section

/- On valid edge outputs, promoted labels already in the ledger add no births. -/

open Finset
open scoped Classical
namespace Bounty

theorem unrestricted_target_ledger_union {P Z : Type*} [DecidableEq P] {t N : ℕ}
    (H : Finset P) (old : Fin N → Z) (label : Z → P)
    (promotions : Finset (Fin t)) {eligible : Finset (Fin N)}
    (e : promotions ↪ ↥eligible) (fresh : UnrestrictedFreshLabels P promotions)
    (hold : ∀ j, label (old j) ∈ H) :
    H ∪ univ.image (unrestrictedEdgeTarget old label promotions e fresh) =
      H ∪ univ.image fresh := by
  ext p
  simp only [mem_union, mem_image, mem_univ, true_and]
  constructor
  · rintro (hp | ⟨i, rfl⟩)
    · exact Or.inl hp
    · by_cases hi : i ∈ promotions
      · left
        simpa only [unrestrictedEdgeTarget, unrestrictedTargetLabels, dif_pos hi]
          using hold (e ⟨i, hi⟩).val
      · right
        exact ⟨⟨i, hi⟩, by simp only [unrestrictedEdgeTarget, unrestrictedTargetLabels, dif_neg hi]⟩
  · rintro (hp | ⟨i, rfl⟩)
    · exact Or.inl hp
    · right
      exact ⟨i.val, by simp only [unrestrictedEdgeTarget, unrestrictedTargetLabels, dif_neg i.property]⟩

theorem bounded_edge_ledger_union_of_output_le {P : Type*} [DecidableEq P]
    (n : P → ℕ) (Δ D : ℤ) (t B : ℕ) (H : Finset P)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (e : UnrestrictedBoundedEvent n Δ D t B s)
    (hold : ∀ i, (s.2.2 i).1 ∈ H)
    (hout : (unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
      (unrestrictedResidueTransport n Δ) e.1 e.2.1 e.2.2.1).1 ≤ B) :
    H ∪ univ.image (unrestrictedBoundedEventTarget n Δ D t B s e).1 =
      H ∪ univ.image e.2.2.2 := by
  simp only [unrestrictedBoundedEventTarget, dif_pos hout]
  exact unrestricted_target_ledger_union H s.2.2 Sigma.fst e.2.1 e.2.2.1 e.2.2.2 hold

theorem bounded_edge_ledger_union_of_nonzero {P : Type*} [DecidableEq P]
    (n : P → ℕ) (Δ D : ℤ) (t B : ℕ) (H : Finset P)
    (μ : P → ℝ) (ρ V : ℝ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (e : UnrestrictedBoundedEvent n Δ D t B s)
    (hold : ∀ i, (s.2.2 i).1 ∈ H)
    (hw : unrestrictedBoundedEventWeight n Δ D μ ρ V t B s e ≠ 0) :
    H ∪ univ.image (unrestrictedBoundedEventTarget n Δ D t B s e).1 =
      H ∪ univ.image e.2.2.2 := by
  apply bounded_edge_ledger_union_of_output_le n Δ D t B H s e hold
  by_contra h
  apply hw
  simp only [unrestrictedBoundedEventWeight, h, and_false, if_false]

end Bounty
end

section

/- The exact baseline for the endpoint damping schedule in a physical root path. -/

open Finset
namespace Bounty

noncomputable def physicalEndpointBaseline (q : ℝ) (edges p : ℕ) : ℝ :=
  1 - (∑ j ∈ range (edges + 1), (1 - physicalEndpointSchedule q edges j)) / (p : ℝ)

theorem physical_endpoint_damping_sum_nonneg {q : ℝ} (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (edges : ℕ) :
    0 ≤ ∑ j ∈ range (edges + 1), (1 - physicalEndpointSchedule q edges j) := by
  apply sum_nonneg
  intro j hj
  exact sub_nonneg.mpr (physical_endpoint_schedule_unit hq0 hq1 edges j).2

theorem physical_endpoint_damping_sum_le {q : ℝ} (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (edges : ℕ) :
    (∑ j ∈ range (edges + 1), (1 - physicalEndpointSchedule q edges j)) ≤ edges + 1 := by
  calc
    _ ≤ ∑ _j ∈ range (edges + 1), (1 : ℝ) := by
      apply sum_le_sum
      intro j hj
      linarith [(physical_endpoint_schedule_unit hq0 hq1 edges j).1]
    _ = _ := by simp

theorem physical_endpoint_baseline_bounds {q : ℝ} (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (edges p : ℕ) (hp : 0 < p) (hsize : 2 * (edges + 1) ≤ p) :
    1 / 2 ≤ physicalEndpointBaseline q edges p ∧ physicalEndpointBaseline q edges p ≤ 1 := by
  apply memory_baseline_bounds (physical_endpoint_damping_sum_nonneg hq0 hq1 edges)
    (by exact_mod_cast hp)
  have hsize' : (2 : ℝ) * (edges + 1) ≤ p := by exact_mod_cast hsize
  linarith [physical_endpoint_damping_sum_le hq0 hq1 edges]

theorem physical_endpoint_baseline_pos {q : ℝ} (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (edges p : ℕ) (hp : 0 < p) (hsize : 2 * (edges + 1) ≤ p) :
    0 < physicalEndpointBaseline q edges p := by
  linarith [(physical_endpoint_baseline_bounds hq0 hq1 edges p hp hsize).1]

end Bounty
end

section

/- Injective encoding preserves equality and distinctness of present optional labels. -/

namespace Bounty

theorem optional_encoded_eq_iff {α : Type*} (encode : α → ℤ)
    (hencode : Function.Injective encode) (a b : Option α)
    (ha : a.isSome = true) (hb : b.isSome = true) :
    (a.map encode).getD 0 = (b.map encode).getD 0 ↔ a = b := by
  cases a with
  | none => cases ha
  | some a =>
    cases b with
    | none => cases hb
    | some b =>
      simpa only [Option.map_some, Option.getD_some, Option.some.injEq] using
        hencode.eq_iff

theorem birth_values_distinct_option_equiv_iff {ι α : Type*} {m : ℕ}
    (e : Fin m ≃ ι) (label : ι → Option α) (performed : ι → Prop)
    (hperformed : ∀ a, performed a ↔ (label a).isSome = true)
    (encode : α → ℤ) (hencode : Function.Injective encode) :
    birthValuesDistinct (fun i => performed (e i))
      (fun i => ((label (e i)).map encode).getD 0) ↔
      Set.InjOn label {a | performed a} := by
  constructor
  · intro h a ha b hb hab
    have hai : performed (e (e.symm a)) := by simpa only [e.apply_symm_apply] using (show performed a from ha)
    have hbi : performed (e (e.symm b)) := by simpa only [e.apply_symm_apply] using (show performed b from hb)
    have hi := h hai hbi (show ((label (e (e.symm a))).map encode).getD 0 =
        ((label (e (e.symm b))).map encode).getD 0 from by
      simp only [e.apply_symm_apply, hab])
    exact e.symm.injective hi
  · intro h i hi j hj hij
    apply e.injective
    apply h hi hj
    exact (optional_encoded_eq_iff encode hencode _ _
      ((hperformed _).mp hi) ((hperformed _).mp hj)).mp hij

end Bounty

namespace Bounty

theorem optional_label_injOn_iff_same_some {ι α : Type*}
    (label : ι → Option α) (performed : ι → Prop)
    (hperformed : ∀ a, performed a ↔ (label a).isSome = true) :
    Set.InjOn label {a | performed a} ↔
      ∀ a b z, label a = some z → label b = some z → a = b := by
  constructor
  · intro h a b z ha hb
    apply h
    · apply (hperformed a).mpr
      simp only [ha, Option.isSome_some]
    · apply (hperformed b).mpr
      simp only [hb, Option.isSome_some]
    · exact ha.trans hb.symm
  · intro h a ha b _ hab
    cases hl : label a with
    | none =>
      have hp := (hperformed a).mp ha
      simp only [hl, Option.isSome_none, Bool.false_eq_true] at hp
    | some z => exact h a b z hl (hab.symm.trans hl)

end Bounty
end

section

/- The original scheduled finite vertex expectation has its exact baseline and phase history. -/

open Finset
open scoped Classical
namespace Bounty

section Phase
variable {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  [∀ a : PhysicalPrime P, NeZero a.2.val]
  {patterns : Finset I} (C : I → Fin N → Finset (Fin J)) (q : ℝ) (k : ℕ → I → ℤ)
  (L : PhysicalMarkLists P J ell)
  (p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)
  (b : PhysicalPrime P → ℝ)
  (hb : ∀ a, b a = 1 - (∑ j ∈ range (n + 2), (1 - physicalEndpointSchedule q (n + 1) j)) / a.2.val)
  (hb0 : ∀ a, b a ≠ 0)

include hb hb0

theorem physical_finite_vertex_expectation_eq_phase :
    physicalFiniteVertexExpectation C q k n L p =
      (∏ a, b a) * ghostPhaseTensorHistory
        (fun a j => decide (a ∈ physicalMarkedPrimes (finitePathMarks L p j)))
        (fun a j => -(physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p)
          (n + 1) j : ZMod a.2.val))
        (fun _ j => 1 - physicalEndpointSchedule q (n + 1) j)
        (fun a => ((a.2.val : ℝ) * b a)⁻¹) (n + 1) := by
  have he := pool_path_residue_eq_phase_history (fun a : PhysicalPrime P => a.2.val)
    (fun a j => decide (a ∈ physicalMarkedPrimes (finitePathMarks L p j)))
    (fun a j => -(physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p)
      (n + 1) j : ZMod a.2.val))
    (fun j => 1 - physicalEndpointSchedule q (n + 1) j) (n + 1) b hb hb0
  simpa only [physicalFiniteVertexExpectation, decide_eq_true_eq] using he

end Phase
end Bounty
end

section

/- Numerical bounds for fixed probe sizes and logarithmically many prime groups.
The density-loss parameter is allowed polynomial growth in the path length. -/

open Filter

namespace Bounty

/-- A positive proportion of logarithmically many groups turns a fixed probe
loss into a power saving. -/
theorem repeated_big_sqrt_probe_le {L theta beta E : ℝ} {n : ℕ}
    (hL : 1 ≤ L) (htheta : 0 < theta) (htheta1 : theta ≤ 1)
    (hn : beta * Real.log L ≤ (n : ℝ))
    (hgap : beta * Real.log theta / 2 ≤ -E) :
    Real.sqrt (theta ^ n) ≤ L ^ (-E) := by
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL
  have hlog : Real.log theta ≤ 0 := Real.log_nonpos htheta.le htheta1
  have hpow : theta ^ n ≤ L ^ (-2 * E) := by
    rw [← Real.exp_log htheta, ← Real.exp_nat_mul, Real.rpow_def_of_pos hL0]
    apply Real.exp_le_exp.mpr
    have hh := mul_le_mul_of_nonpos_right hn hlog
    have hg := mul_le_mul_of_nonneg_right hgap (Real.log_nonneg hL)
    nlinarith
  calc
    Real.sqrt (theta ^ n) ≤ Real.sqrt (L ^ (-2 * E)) := Real.sqrt_le_sqrt hpow
    _ = L ^ (-E) := by
      rw [Real.sqrt_eq_rpow, ← Real.rpow_mul hL0.le]
      congr 1
      ring

/-- An exponential in a logarithmic group count has an explicit polynomial
bound. The natural exponent can count any fixed number of probes per group. -/
theorem repeated_big_log_count_pow_le {L a b : ℝ} (m s : ℕ)
    (hL : 0 < L) (hb : 1 ≤ b) (hs : (s : ℝ) ≤ a * Real.log L) :
    b ^ (m * s) ≤ L ^ ((m : ℝ) * a * Real.log b) := by
  have hb0 : 0 < b := lt_of_lt_of_le zero_lt_one hb
  rw [← Real.exp_log hb0, ← Real.exp_nat_mul, Real.rpow_def_of_pos hL]
  apply Real.exp_le_exp.mpr
  have hh := mul_le_mul_of_nonneg_left hs
    (mul_nonneg (Nat.cast_nonneg m) (Real.log_nonneg hb))
  rw [Real.log_exp]
  push_cast
  nlinarith

/-- Concrete scalar error budget after the finite pattern count. -/
noncomputable def repeatedBigNumericError (s m J ell Q : ℕ) (xi T P v : ℝ) : ℝ :=
  (1 + (2 : ℝ) ^ (m * s) * (((Q * Q : ℕ) : ℝ) / xi) ^ 2) *
    ((((2 * s * (ell + m) : ℕ) : ℝ) * T / P) +
      (s : ℝ) * ((m : ℝ) * (2 * ((J + ell : ℕ) : ℝ))) / (v * P))

/-- Fixed constants in the density and collision errors. -/
noncomputable def repeatedBigNumericErrorConstant (m J ell : ℕ) (a v : ℝ) : ℝ :=
  2 * (2 * a * ((ell + m : ℕ) : ℝ) +
    a * ((m : ℝ) * (2 * ((J + ell : ℕ) : ℝ))) / v)

/-- All factors in the actual finite pattern error are bounded explicitly;
no estimate for that error is assumed as a premise. -/
theorem repeated_big_numeric_error_le {L a q x tau v T P xi : ℝ}
    (s m J ell Q : ℕ) (hL : 1 ≤ L) (ha : 0 ≤ a) (hq : 0 ≤ q)
    (hx : 0 ≤ x) (htau : 0 ≤ tau) (hv : 0 < v) (hP : 0 < P)
    (hs : (s : ℝ) ≤ a * Real.log L) (hQ : (Q : ℝ) ≤ L ^ q)
    (hxi : L ^ (-x) ≤ xi) (hT0 : 0 ≤ T) (hT : T ≤ L ^ tau) :
    repeatedBigNumericError s m J ell Q xi T P v ≤
      repeatedBigNumericErrorConstant m J ell a v *
        L ^ ((m : ℝ) * a * Real.log 2 + 4 * q + 2 * x + tau + 1) / P := by
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL
  have hxi0 : 0 < xi := lt_of_lt_of_le (Real.rpow_pos_of_pos hL0 _) hxi
  have hsL : (s : ℝ) ≤ a * L := hs.trans
    (mul_le_mul_of_nonneg_left (Real.log_le_self hL0.le) ha)
  have htwo := repeated_big_log_count_pow_le (L := L) (a := a) (b := 2) m s hL0
    (by norm_num) hs
  have hQ2 : ((Q * Q : ℕ) : ℝ) ≤ L ^ (2 * q) := by
    push_cast
    calc
      (Q : ℝ) * Q ≤ L ^ q * L ^ q := mul_le_mul hQ hQ (Nat.cast_nonneg _) (by positivity)
      _ = L ^ (2 * q) := by rw [← Real.rpow_add hL0]; congr 1; ring
  have hratio : ((Q * Q : ℕ) : ℝ) / xi ≤ L ^ (2 * q + x) := by
    calc
      _ ≤ L ^ (2 * q) / L ^ (-x) := div_le_div₀ (by positivity) hQ2
        (Real.rpow_pos_of_pos hL0 _) hxi
      _ = _ := by rw [← Real.rpow_sub hL0]; congr 1; ring
  have hB : (((Q * Q : ℕ) : ℝ) / xi) ^ 2 ≤ L ^ (4 * q + 2 * x) := by
    calc
      _ ≤ (L ^ (2 * q + x)) ^ (2 : ℕ) := pow_le_pow_left₀ (by positivity) hratio 2
      _ = _ := by rw [← Real.rpow_natCast, ← Real.rpow_mul hL0.le]; congr 1; ring
  have hgamma : 0 ≤ (m : ℝ) * a * Real.log 2 + 4 * q + 2 * x := by
    have hl : 0 ≤ Real.log 2 := Real.log_nonneg (by norm_num)
    positivity
  have hcoeff : 1 + (2 : ℝ) ^ (m * s) * (((Q * Q : ℕ) : ℝ) / xi) ^ 2 ≤
      2 * L ^ ((m : ℝ) * a * Real.log 2 + 4 * q + 2 * x) := by
    have hp := mul_le_mul htwo hB (sq_nonneg _) (Real.rpow_nonneg hL0.le _)
    rw [← Real.rpow_add hL0, ← add_assoc] at hp
    have hone := Real.one_le_rpow hL hgamma
    nlinarith
  have hLtau : L ≤ L ^ (tau + 1) := by
    simpa only [Real.rpow_one] using Real.rpow_le_rpow_of_exponent_le hL
      (show (1 : ℝ) ≤ tau + 1 by linarith)
  have hdensity : (((2 * s * (ell + m) : ℕ) : ℝ) * T) ≤
      (2 * a * ((ell + m : ℕ) : ℝ)) * L ^ (tau + 1) := by
    have hh := mul_le_mul hsL hT hT0 (by positivity : 0 ≤ a * L)
    have hh' := mul_le_mul_of_nonneg_left hh
      (show 0 ≤ 2 * ((ell + m : ℕ) : ℝ) by positivity)
    rw [Real.rpow_add hL0, Real.rpow_one]
    push_cast at hh' ⊢
    ring_nf at hh' ⊢
    exact hh'
  have hcollision : (s : ℝ) * ((m : ℝ) * (2 * ((J + ell : ℕ) : ℝ))) / v ≤
      (a * ((m : ℝ) * (2 * ((J + ell : ℕ) : ℝ))) / v) * L ^ (tau + 1) := by
    have hh := hsL.trans (mul_le_mul_of_nonneg_left hLtau ha)
    have hh' := div_le_div_of_nonneg_right
      (mul_le_mul_of_nonneg_right hh (by positivity : 0 ≤ (m : ℝ) * (2 * ((J + ell : ℕ) : ℝ)))) hv.le
    ring_nf at hh' ⊢
    exact hh'
  unfold repeatedBigNumericError repeatedBigNumericErrorConstant
  have hsum : (((2 * s * (ell + m) : ℕ) : ℝ) * T / P) +
      (s : ℝ) * ((m : ℝ) * (2 * ((J + ell : ℕ) : ℝ))) / (v * P) ≤
      (2 * a * ((ell + m : ℕ) : ℝ) +
        a * ((m : ℝ) * (2 * ((J + ell : ℕ) : ℝ))) / v) * L ^ (tau + 1) / P := by
    have hh := div_le_div_of_nonneg_right (add_le_add hdensity hcollision) hP.le
    ring_nf at hh ⊢
    exact hh
  calc
    _ ≤ (2 * L ^ ((m : ℝ) * a * Real.log 2 + 4 * q + 2 * x)) *
        ((2 * a * ((ell + m : ℕ) : ℝ) +
          a * ((m : ℝ) * (2 * ((J + ell : ℕ) : ℝ))) / v) * L ^ (tau + 1) / P) :=
      mul_le_mul hcoeff hsum (by positivity) (by positivity)
    _ = _ := by
      rw [show L ^ ((m : ℝ) * a * Real.log 2 + 4 * q + 2 * x + tau + 1) =
        L ^ ((m : ℝ) * a * Real.log 2 + 4 * q + 2 * x) * L ^ (tau + 1) by
          rw [← Real.rpow_add hL0]; congr 1; ring]
      ring

/-- Uniform power saving for the literal density-plus-collision budget.
The cutoff, density loss, group count, and smallest prime remain quantified
inside the eventual statement. -/
theorem eventually_repeated_big_numeric_error_small (m J ell : ℕ)
    {a q x tau v c : ℝ} (ha : 0 ≤ a) (hq : 0 ≤ q) (hx : 0 ≤ x)
    (htau : 0 ≤ tau) (hv : 0 < v) (hc : 0 < c) (E : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (s Q : ℕ) (xi T P : ℝ),
      (s : ℝ) ≤ a * Real.log L → (Q : ℝ) ≤ L ^ q →
      L ^ (-x) ≤ xi → 0 ≤ T → T ≤ L ^ tau → Real.exp (L ^ c) ≤ P →
      repeatedBigNumericError s m J ell Q xi T P v ≤ L ^ (-E) := by
  let K := repeatedBigNumericErrorConstant m J ell a v
  let d := (m : ℝ) * a * Real.log 2 + 4 * q + 2 * x + tau + 1
  filter_upwards [eventually_ge_atTop (1 : ℝ), eventually_ge_atTop K,
    eventually_exp_neg_rpow_mul_rpow_le hc (show (0 : ℝ) < 1 by norm_num) (d + 1) E]
    with L hL hKL hdecay
  intro s Q xi T P hs hQ hxi hT0 hT hP
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL
  have hP0 : 0 < P := lt_of_lt_of_le (Real.exp_pos _) hP
  have hbase := repeated_big_numeric_error_le s m J ell Q hL ha hq hx htau hv hP0
    hs hQ hxi hT0 hT
  change repeatedBigNumericError s m J ell Q xi T P v ≤ K * L ^ d / P at hbase
  calc
    _ ≤ K * L ^ d / P := hbase
    _ ≤ L * L ^ d / Real.exp (L ^ c) := div_le_div₀
      (mul_nonneg hL0.le (Real.rpow_nonneg hL0.le _))
      (mul_le_mul_of_nonneg_right hKL (Real.rpow_nonneg hL0.le _))
      (Real.exp_pos _) hP
    _ = Real.exp (-1 * L ^ c) * L ^ (d + 1) := by
      rw [show L ^ (d + 1) = L ^ d * L by rw [Real.rpow_add hL0, Real.rpow_one]]
      simp only [neg_mul, one_mul, Real.exp_neg]
      ring
    _ ≤ _ := hdecay

/-- The two block losses and the complete finite probe sum fit the desired
power bound with one power of slack in the parameter choices. -/
theorem repeated_big_positive_block_bound {L theta beta a D E : ℝ}
    (m s r t n : ℕ) (hL : 3 ≤ L) (htheta : 0 < theta) (htheta1 : theta ≤ 1)
    (hr : beta * Real.log L ≤ (r : ℝ)) (ht : beta * Real.log L ≤ (t : ℝ))
    (hs : (s : ℝ) ≤ a * Real.log L) (hn : n ≤ m * s)
    (hgap : beta * Real.log theta / 2 ≤ -(E + 1))
    (hD : (m : ℝ) * a * Real.log 3 + E + 1 ≤ D) :
    Real.sqrt (theta ^ r) + Real.sqrt (theta ^ t) + (3 : ℝ) ^ n * L ^ (-D) ≤
      L ^ (-E) := by
  have hL1 : 1 ≤ L := by linarith
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL1
  have hr' := repeated_big_sqrt_probe_le hL1 htheta htheta1 hr hgap
  have ht' := repeated_big_sqrt_probe_le hL1 htheta htheta1 ht hgap
  have hn' : (3 : ℝ) ^ n * L ^ (-D) ≤ L ^ (-(E + 1)) := by
    calc
      _ ≤ (3 : ℝ) ^ (m * s) * L ^ (-D) := mul_le_mul_of_nonneg_right
        (pow_le_pow_right₀ (by norm_num) hn) (Real.rpow_nonneg hL0.le _)
      _ ≤ L ^ ((m : ℝ) * a * Real.log 3) * L ^ (-D) := mul_le_mul_of_nonneg_right
        (repeated_big_log_count_pow_le m s hL0 (by norm_num) hs)
        (Real.rpow_nonneg hL0.le _)
      _ = L ^ ((m : ℝ) * a * Real.log 3 - D) := by rw [← Real.rpow_add hL0]; rfl
      _ ≤ _ := Real.rpow_le_rpow_of_exponent_le hL1 (by linarith)
  have hlast : 3 * L ^ (-(E + 1)) ≤ L ^ (-E) := by
    rw [show -(E + 1) = -E - 1 by ring, Real.rpow_sub hL0, Real.rpow_one,
      ← mul_div_assoc]
    apply (div_le_iff₀ hL0).mpr
    nlinarith [Real.rpow_pos_of_pos hL0 (-E)]
  linarith

end Bounty
end

section

/- Exact damping factorization for the complete clean pattern action.
The ordered memory occurrences stay in the residue fiber. Both adjacent
active projections remain in their original order. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def cleanResidueWeightMap {X R : Type*} (w : R → ℝ)
    (f : X → R → ℂ) (x : X) (r : R) : ℂ := (w r : ℂ) * f x r

theorem clean_active_map_residue_weight {X R : Type*}
    (Proj : (X → ℂ) →ₗ[ℂ] (X → ℂ)) (w : R → ℝ) (f : X → R → ℂ) :
    cleanActiveMap Proj (cleanResidueWeightMap w f) =
      cleanResidueWeightMap w (cleanActiveMap Proj f) := by
  funext x r
  change Proj ((w r : ℂ) • fun y => f y r) x = _
  rw [map_smul]
  rfl

noncomputable def cleanHybridPatternDampedAction {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : I → G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ) (B : G → ℕ) (p : FixedOrderedMemoryLabels Pb N)
    (K : ∀ i, RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb (C i) → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : RepeatedBigLists Pb J ell → (PhysicalResidues Ps × FixedOrderedResidues p) → ℂ)
    (source : RepeatedBigLists Pb J ell) (r : PhysicalResidues Ps × FixedOrderedResidues p) : ℂ :=
  ∑ i, ∑ aux, ∑ target,
    (cleanHybridBetweenKernel Vb b (C i) ζ θ ρ k B p r.2 (K i) d aux source target *
      physicalPhase ζ (physicalSharedProduct d)) *
    f target (physicalTranslateResidues r.1 (cleanHybridStep k (C i) source aux d),
      fixedOrderedResidueTranslate p r.2 (cleanHybridStep k (C i) source aux d))

theorem clean_hybrid_pattern_damped_factorization {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : I → G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ) (B : G → ℕ) (p : FixedOrderedMemoryLabels Pb N)
    (K : ∀ i, RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb (C i) → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : RepeatedBigLists Pb J ell → (PhysicalResidues Ps × FixedOrderedResidues p) → ℂ) :
    cleanHybridPatternDampedAction Vb b C ζ θ ρ k B p K d f =
      cleanResidueWeightMap (fun r => cleanMemoryInputWeight ρ p r.2)
        (cleanHybridPatternCoreAction Vb b C ζ θ k p K d
          (cleanResidueWeightMap (fun r => cleanMemoryOutputWeight ρ B p r.2) f)) := by
  funext source r
  simp only [cleanHybridPatternDampedAction, cleanHybridPatternCoreAction,
    cleanHybridCoreAction, cleanResidueWeightMap, mul_sum]
  apply sum_congr rfl
  intro i _
  apply sum_congr rfl
  intro aux _
  apply sum_congr rfl
  intro target _
  simp only [cleanHybridBetweenKernel, cleanHybridCoreCoefficient,
    clean_hybrid_memory_factor_split, Complex.ofReal_mul]
  ring

theorem clean_hybrid_projected_damped_factorization {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : I → G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ) (B : G → ℕ) (p : FixedOrderedMemoryLabels Pb N)
    (K : ∀ i, RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb (C i) → ℂ)
    (d : PhysicalSharedLists Ps J)
    (Proj : (RepeatedBigLists Pb J ell → ℂ) →ₗ[ℂ] (RepeatedBigLists Pb J ell → ℂ))
    (f : RepeatedBigLists Pb J ell → (PhysicalResidues Ps × FixedOrderedResidues p) → ℂ) :
    cleanActiveMap Proj (cleanHybridPatternDampedAction Vb b C ζ θ ρ k B p K d
      (cleanActiveMap Proj f)) =
      cleanResidueWeightMap (fun r => cleanMemoryInputWeight ρ p r.2)
        (cleanActiveMap Proj (cleanHybridPatternCoreAction Vb b C ζ θ k p K d
          (cleanActiveMap Proj
            (cleanResidueWeightMap (fun r => cleanMemoryOutputWeight ρ B p r.2) f)))) := by
  rw [clean_hybrid_pattern_damped_factorization, clean_active_map_residue_weight,
    clean_active_map_residue_weight]

theorem clean_residue_weight_norm_le {X R : Type*} [Fintype X] [Fintype R]
    (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (w : R → ℝ)
    (hw0 : ∀ r, 0 ≤ w r) (hw1 : ∀ r, w r ≤ 1) (f : X → R → ℂ) :
    cleanWeightedNorm μ (cleanResidueWeightMap w f) ≤ cleanWeightedNorm μ f := by
  apply Real.sqrt_le_sqrt
  apply sum_le_sum
  intro x _
  apply mul_le_mul_of_nonneg_left _ (hμ x)
  apply sum_le_sum
  intro r _
  apply pow_le_pow_left₀ (norm_nonneg _)
  calc
    ‖cleanResidueWeightMap w f x r‖ = w r * ‖f x r‖ := by
      simp only [cleanResidueWeightMap, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (hw0 r)]
    _ ≤ 1 * ‖f x r‖ := mul_le_mul_of_nonneg_right (hw1 r) (norm_nonneg _)
    _ = _ := one_mul _

theorem clean_hybrid_projected_damped_norm_le {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : I → G → Finset (Fin J))
    (ζ θ ρ : ℝ) (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1) (k : ℤ)
    (B : G → ℕ) (p : FixedOrderedMemoryLabels Pb N)
    [∀ q : PhysicalPrime Ps, NeZero q.2.val] [∀ g j, NeZero (p g j).val]
    (K : ∀ i, RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb (C i) → ℂ)
    (d : PhysicalSharedLists Ps J)
    (Proj : (RepeatedBigLists Pb J ell → ℂ) →ₗ[ℂ] (RepeatedBigLists Pb J ell → ℂ))
    (w : RepeatedBigLists Pb J ell → ℝ) (hw : ∀ x, 0 ≤ w x)
    (M : ℝ) (hM : 0 ≤ M)
    (hcore : ∀ f, cleanWeightedNorm w (cleanActiveMap Proj
      (cleanHybridPatternCoreAction Vb b C ζ θ k p K d (cleanActiveMap Proj f))) ≤
        M * cleanWeightedNorm w f)
    (f : RepeatedBigLists Pb J ell → (PhysicalResidues Ps × FixedOrderedResidues p) → ℂ) :
    cleanWeightedNorm w (cleanActiveMap Proj
      (cleanHybridPatternDampedAction Vb b C ζ θ ρ k B p K d (cleanActiveMap Proj f))) ≤
        M * cleanWeightedNorm w f := by
  rw [clean_hybrid_projected_damped_factorization]
  exact (clean_residue_weight_norm_le w hw (fun r : PhysicalResidues Ps × FixedOrderedResidues p => cleanMemoryInputWeight ρ p r.2)
    (fun r => clean_memory_input_weight_nonneg hρ0 p r.2)
    (fun r => clean_memory_input_weight_le_one hρ0 hρ1 p r.2) _).trans
      ((hcore _).trans (mul_le_mul_of_nonneg_left
        (clean_residue_weight_norm_le w hw (fun r : PhysicalResidues Ps × FixedOrderedResidues p => cleanMemoryOutputWeight ρ B p r.2)
          (fun r => clean_memory_output_weight_nonneg hρ0 B p r.2)
          (fun r => clean_memory_output_weight_le_one hρ0 hρ1 B p r.2) f) hM))

end Bounty
end

section

/- Exact coordinates for the full bounded product memory. Every ordered
occurrence keeps its own prime label and residue, including repeated labels.
The active slots are the literal first and tail blocks of the clean kernel. -/

open Finset
open scoped Classical

namespace Bounty

abbrev CleanFullMemoryState {G : Type*} (P : G → Finset ℕ) (J ell B : ℕ) :=
  ProductBoundedOrderedState (fun g => ↥(P g)) (fun g => UnrestrictedResidueParticle (fun p : P g => p.val))
    (fun _ => J + ell) B

abbrev CleanFullMemoryCoordinates {G : Type*} (P : G → Finset ℕ) (J ell B : ℕ) :=
  Σ N : G → Fin (B + 1), Σ p : FixedOrderedMemoryLabels P (fun g => (N g).val),
    RepeatedBigLists P J ell × FixedOrderedResidues p

def cleanFullMemoryState {G : Type*} {P : G → Finset ℕ} {J ell B : ℕ}
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
    (source : RepeatedBigLists P J ell) (r : FixedOrderedResidues p) :
    CleanFullMemoryState P J ell B :=
  fun g => (fun j => source g (finSumFinEquiv.symm j),
    ⟨N g, fun j => ⟨p g j, r g j⟩⟩)

def cleanFullMemoryEquiv {G : Type*} (P : G → Finset ℕ) (J ell B : ℕ) :
    CleanFullMemoryState P J ell B ≃ CleanFullMemoryCoordinates P J ell B where
  toFun x := ⟨fun g => (x g).2.1, fun g j => ((x g).2.2 j).1,
    (fun g j => (x g).1 (finSumFinEquiv j)), fun g j => ((x g).2.2 j).2⟩
  invFun x := cleanFullMemoryState x.1 x.2.1 x.2.2.1 x.2.2.2
  left_inv x := by
    funext g
    apply Prod.ext
    · funext j
      simp only [cleanFullMemoryState, Equiv.apply_symm_apply]
    · rfl
  right_inv x := by
    rcases x with ⟨N, p, source, r⟩
    simp only [cleanFullMemoryState, Equiv.symm_apply_apply]

theorem cleanFullMemoryEquiv_symm_apply {G : Type*} (P : G → Finset ℕ) (J ell B : ℕ)
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
    (source : RepeatedBigLists P J ell) (r : FixedOrderedResidues p) :
    (cleanFullMemoryEquiv P J ell B).symm ⟨N, p, source, r⟩ =
      cleanFullMemoryState N p source r := rfl

theorem cleanFullMemoryState_total_memory {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell B : ℕ}
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
    (source : RepeatedBigLists P J ell) (r : FixedOrderedResidues p) :
    productTotalMemory (cleanFullMemoryState N p source r) = ∑ g, (N g).val := rfl

noncomputable def cleanMemoryLabelWeight {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {B : ℕ} (ν : ∀ g, P g → ℝ)
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val)) : ℝ :=
  ∏ g, (∏ j, ν g (p g j)) / ((N g).val.factorial : ℝ)

theorem cleanFullMemoryState_weight {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell B : ℕ} (μ ν : ∀ g, P g → ℝ)
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
    (source : RepeatedBigLists P J ell) (r : FixedOrderedResidues p) :
    productMemoryWeight μ (fun g z => ν g z.1) (cleanFullMemoryState N p source r) =
      (∏ g, ∏ s, μ g (source g s)) * cleanMemoryLabelWeight ν N p := by
  unfold productMemoryWeight boundedOrderedStateWeight boundedOrderedMemoryWeight
    cleanFullMemoryState cleanMemoryLabelWeight
  rw [← prod_mul_distrib]
  apply prod_congr rfl
  intro g _
  congr 1
  exact Equiv.prod_comp finSumFinEquiv.symm (fun s => μ g (source g s))

theorem cleanFullMemoryState_tilted_weight {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell B : ℕ}
    (V : G → ℝ) (b : ∀ g, P g → ℝ) (ν : ∀ g, P g → ℝ)
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
    (source : RepeatedBigLists P J ell) (r : FixedOrderedResidues p) :
    productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (b g))
        (fun g z => ν g z.1) (cleanFullMemoryState N p source r) =
      repeatedBigActiveMass V b source * cleanMemoryLabelWeight ν N p :=
  cleanFullMemoryState_weight _ ν N p source r

theorem clean_full_memory_sum {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell B : ℕ} [∀ g (p : P g), NeZero p.val]
    (μ ν : ∀ g, P g → ℝ) (F : CleanFullMemoryState P J ell B → ℝ) :
    (∑ x : CleanFullMemoryState P J ell B,
      productMemoryWeight μ (fun g z => ν g z.1) x * F x) =
      ∑ N : G → Fin (B + 1),
        ∑ p : FixedOrderedMemoryLabels P (fun g => (N g).val),
          cleanMemoryLabelWeight ν N p *
            ∑ source : RepeatedBigLists P J ell, (∏ g, ∏ s, μ g (source g s)) *
              ∑ r : FixedOrderedResidues p, F (cleanFullMemoryState N p source r) := by
  rw [← (cleanFullMemoryEquiv P J ell B).symm.sum_comp
    (fun x => productMemoryWeight μ (fun g z => ν g z.1) x * F x)]
  rw [Fintype.sum_sigma]
  apply sum_congr rfl
  intro N _
  rw [Fintype.sum_sigma]
  apply sum_congr rfl
  intro p _
  rw [Fintype.sum_prod_type, mul_sum]
  apply sum_congr rfl
  intro source _
  rw [mul_sum, mul_sum]
  apply sum_congr rfl
  intro r _
  rw [cleanFullMemoryEquiv_symm_apply, cleanFullMemoryState_weight]
  ring

theorem clean_full_memory_tilted_energy {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell B : ℕ} [∀ g (p : P g), NeZero p.val]
    (V : G → ℝ) (b : ∀ g, P g → ℝ) (ν : ∀ g, P g → ℝ)
    (f : CleanFullMemoryState P J ell B → ℂ) :
    finiteWeightedEnergy (productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (b g))
        (fun g z => ν g z.1)) f =
      ∑ N : G → Fin (B + 1),
        ∑ p : FixedOrderedMemoryLabels P (fun g => (N g).val),
          cleanMemoryLabelWeight ν N p *
            ∑ source : RepeatedBigLists P J ell, repeatedBigActiveMass V b source *
              ∑ r : FixedOrderedResidues p, ‖f (cleanFullMemoryState N p source r)‖ ^ 2 :=
  clean_full_memory_sum _ ν (fun x => ‖f x‖ ^ 2)

theorem cleanMemoryLabelWeight_nonneg {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {B : ℕ} (ν : ∀ g, P g → ℝ)
    (hν : ∀ g p, 0 ≤ ν g p)
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val)) :
    0 ≤ cleanMemoryLabelWeight ν N p :=
  prod_nonneg fun g _ => div_nonneg (prod_nonneg fun j _ => hν g (p g j))
    (Nat.cast_nonneg _)

theorem clean_full_memory_tilted_residue_energy {G R : Type*}
    [Fintype G] [DecidableEq G] [Fintype R]
    {P : G → Finset ℕ} {J ell B : ℕ} [∀ g (p : P g), NeZero p.val]
    (V : G → ℝ) (b : ∀ g, P g → ℝ) (ν : ∀ g, P g → ℝ)
    (f : CleanFullMemoryState P J ell B → R → ℂ) :
    (∑ x : CleanFullMemoryState P J ell B,
      productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (b g))
        (fun g z => ν g z.1) x * ∑ r : R, ‖f x r‖ ^ 2) =
      ∑ N : G → Fin (B + 1),
        ∑ p : FixedOrderedMemoryLabels P (fun g => (N g).val),
          cleanMemoryLabelWeight ν N p *
            ∑ source : RepeatedBigLists P J ell, repeatedBigActiveMass V b source *
              ∑ r : R × FixedOrderedResidues p,
                ‖f (cleanFullMemoryState N p source r.2) r.1‖ ^ 2 := by
  rw [clean_full_memory_sum]
  apply sum_congr rfl
  intro N _
  apply sum_congr rfl
  intro p _
  congr 1
  apply sum_congr rfl
  intro source _
  congr 1
  rw [Fintype.sum_prod_type, sum_comm]

end Bounty
end

section

/- Exact reindexing and binary partition of finite ordered product lists. -/

open Finset

namespace Bounty

theorem ordered_slot_sum_test_equiv {I J : Type*} [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    (choices : J → Finset ℕ) (e : I ≃ J) (F : ℕ → ℝ) :
    (∑ x : ∀ j, choices j, F (orderedSlotProduct choices x)) =
      ∑ y : ∀ i, choices (e i), F (orderedSlotProduct (fun i => choices (e i)) y) := by
  classical
  apply Fintype.sum_equiv (Equiv.piCongrLeft (fun j => choices j) e).symm
  intro x
  congr 1
  exact (e.prod_comp (fun j => (x j).val)).symm

theorem ordered_slot_weight_equiv {I J : Type*} [Fintype I] [Fintype J]
    [DecidableEq I] [DecidableEq J] (choices : J → Finset ℕ) (e : I ≃ J)
    (normalization : ℝ) (n : ℕ) :
    orderedSlotWeight choices normalization n =
      orderedSlotWeight (fun i => choices (e i)) normalization n := by
  classical
  unfold orderedSlotWeight
  convert ordered_slot_sum_test_equiv choices e
    (fun d => if d = n then 1/normalization else 0) using 1
  all_goals apply Finset.sum_congr (by ext; simp); intro x _; rfl

theorem ordered_slot_sum_test_sum {I J : Type*} [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    (A : I → Finset ℕ) (B : J → Finset ℕ) (F : ℕ → ℝ) :
    (∑ x : ∀ i : I ⊕ J, ↥(Sum.elim A B i), F (orderedSlotProduct (Sum.elim A B) x)) =
      ∑ a : ∀ i, A i, ∑ b : ∀ j, B j,
        F (orderedSlotProduct A a * orderedSlotProduct B b) := by
  classical
  let f : (∀ i, A i) × (∀ j, B j) → ℝ := fun y =>
    F (orderedSlotProduct A y.1 * orderedSlotProduct B y.2)
  calc
    _ = ∑ y, f y := by
      apply Fintype.sum_equiv (Equiv.sumPiEquivProdPi (fun i : I ⊕ J => ↥(Sum.elim A B i)))
      intro x
      congr 1
      exact Fintype.prod_sum_type (fun i => (x i).val)
    _ = _ := Fintype.sum_prod_type f

theorem ordered_slot_weight_sum_split {I J : Type*} [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    (A : I → Finset ℕ) (B : J → Finset ℕ) (normalization : ℝ) (n : ℕ) :
    orderedSlotWeight (Sum.elim A B) normalization n =
      ∑ a : ∀ i, A i, ∑ b : ∀ j, B j,
        if orderedSlotProduct A a * orderedSlotProduct B b = n then 1/normalization else 0 := by
  classical
  unfold orderedSlotWeight
  convert ordered_slot_sum_test_sum A B (fun d => if d = n then 1/normalization else 0) using 1
  apply Finset.sum_congr (by ext; simp)
  intro x _
  rfl

end Bounty
end

section

/- Exact one-mark expansions, including the endpoint q = 0. -/

open Finset

namespace Bounty

theorem one_marked_factor_choice_sum {G : Type*} (P : G → Finset ℕ) (g : G)
    (q V : ℝ) (n : ℤ) :
    markedDivisorFactor q V (physicalOmega P g n) 1 =
      ∑ p : P g, if (p.val : ℤ) ∣ n then q^(physicalOmega P g n - 1)/V else 0 := by
  classical
  rw [sum_coe_sort (P g) (fun p : ℕ => if (p : ℤ) ∣ n then q^(physicalOmega P g n - 1)/V else 0)]
  rw [← sum_filter]
  simp only [sum_const, nsmul_eq_mul]
  unfold markedDivisorFactor physicalOmega physicalDivisorPool
  simp only [Nat.descFactorial_one, pow_one]
  ring

theorem one_marked_weight_choice_sum {G : Type*} [DecidableEq G] (groups : Finset G)
    (P : G → Finset ℕ) (q : ℝ) (V : G → ℝ) (n : ℤ) :
    markedDivisorWeight groups P q V (fun _ => 1) n =
      ∑ x : ∀ g : groups, P g.val,
        ∏ g : groups, if ((x g).val : ℤ) ∣ n then q^(physicalOmega P g.val n - 1)/V g.val else 0 := by
  classical
  unfold markedDivisorWeight
  rw [← prod_coe_sort groups]
  simp_rw [one_marked_factor_choice_sum]
  exact Fintype.prod_sum _

end Bounty
end

section

/- Exact isolation of one independent sample; the remaining factor cannot read it. -/

open Finset Classical

namespace Bounty

theorem independent_coordinate_atom_factor {I Z P : Type*}
    [Fintype I] [DecidableEq I] [Fintype Z] [DecidableEq P] (i : I)
    (w : Z → ℝ) (label : Z → P) (p : P)
    (F : ({j : I // j ≠ i} → Z) → ℝ) :
    (∑ f : I → Z, if label (f i) = p then
      (∏ j, w (f j)) * F (fun j => f j.1) else 0) =
      (∑ z : Z, if label z = p then w z else 0) *
        ∑ f : {j : I // j ≠ i} → Z, (∏ j, w (f j)) * F f := by
  calc
    _ = ∑ f : I → Z, (if label (f i) = p then w (f i) else 0) *
        ((∏ j : {j : I // j ≠ i}, w (f j.1)) * F (fun j => f j.1)) := by
      apply sum_congr rfl
      intro f _
      rw [Fintype.prod_eq_mul_prod_subtype_ne (fun j => w (f j)) i]
      split_ifs <;> simp only [zero_mul, mul_assoc]
    _ = ∑ v : Z × ({j : I // j ≠ i} → Z),
        (if label v.1 = p then w v.1 else 0) * ((∏ j, w (v.2 j)) * F v.2) :=
      (Equiv.funSplitAt i Z).sum_comp (fun v =>
        (if label v.1 = p then w v.1 else 0) * ((∏ j, w (v.2 j)) * F v.2))
    _ = _ := by
      rw [Fintype.sum_prod_type]
      simp_rw [← mul_sum]
      rw [← sum_mul]

theorem independent_coordinate_atom_le {I Z P : Type*}
    [Fintype I] [DecidableEq I] [Fintype Z] [DecidableEq P] (i : I)
    (w : Z → ℝ) (label : Z → P) (p : P)
    (F : ({j : I // j ≠ i} → Z) → ℝ) (hw : ∀ z, 0 ≤ w z)
    (hF : ∀ f, 0 ≤ F f) {ε : ℝ}
    (hatom : (∑ z : Z, if label z = p then w z else 0) ≤ ε) :
    (∑ f : I → Z, if label (f i) = p then
      (∏ j, w (f j)) * F (fun j => f j.1) else 0) ≤
      ε * ∑ f : {j : I // j ≠ i} → Z, (∏ j, w (f j)) * F f := by
  rw [independent_coordinate_atom_factor]
  exact mul_le_mul_of_nonneg_right hatom
    (sum_nonneg fun f _ => mul_nonneg (prod_nonneg fun j _ => hw _) (hF f))

end Bounty

namespace Bounty

open Finset Classical

theorem independent_coordinate_atom_factor_mul {I Z P : Type*}
    [Fintype I] [DecidableEq I] [Fintype Z] [DecidableEq P] (i : I)
    (w : Z → ℝ) (label : Z → P) (p : P) (K : ℝ)
    (F : ({j : I // j ≠ i} → Z) → ℝ) :
    (∑ f : I → Z, if label (f i) = p then
      (K * ∏ j, w (f j)) * F (fun j => f j.1) else 0) =
      (∑ z : Z, if label z = p then w z else 0) *
        (K * ∑ f : {j : I // j ≠ i} → Z, (∏ j, w (f j)) * F f) := by
  calc
    _ = K * ∑ f : I → Z, if label (f i) = p then
        (∏ j, w (f j)) * F (fun j => f j.1) else 0 := by
      rw [mul_sum]
      apply sum_congr rfl
      intro f _
      split_ifs <;> simp only [mul_assoc, mul_zero]
    _ = _ := by rw [independent_coordinate_atom_factor]; ring

theorem independent_coordinate_atom_le_mul {I Z P : Type*}
    [Fintype I] [DecidableEq I] [Fintype Z] [DecidableEq P] (i : I)
    (w : Z → ℝ) (label : Z → P) (p : P) (K : ℝ)
    (F : ({j : I // j ≠ i} → Z) → ℝ) (hK : 0 ≤ K)
    (hw : ∀ z, 0 ≤ w z) (hF : ∀ f, 0 ≤ F f) {ε : ℝ}
    (hatom : (∑ z : Z, if label z = p then w z else 0) ≤ ε) :
    (∑ f : I → Z, if label (f i) = p then
      (K * ∏ j, w (f j)) * F (fun j => f j.1) else 0) ≤
      ε * (K * ∑ f : {j : I // j ≠ i} → Z, (∏ j, w (f j)) * F f) := by
  rw [independent_coordinate_atom_factor_mul]
  exact mul_le_mul_of_nonneg_right hatom (mul_nonneg hK
    (sum_nonneg fun f _ => mul_nonneg (prod_nonneg fun j _ => hw _) (hF f)))

end Bounty
end

section

/- Fixed count, retention, storage and promotion factors in the original event laws. -/

open Finset Classical

namespace Bounty

noncomputable def boundedGhostSkeletonAbsMass {P Z : Type*} (A D : Z → ℝ)
    (t B : ℕ) (s : BoundedOrderedState P Z t B) (b : Fin (B + 1))
    (retained : Finset (Fin s.2.1.val)) : ℝ :=
  if retained.card + b.val ≤ B then
    |((∏ j ∈ retained, A (s.2.2 j)) * (∏ j ∈ univ \ retained, D (s.2.2 j))) /
      (b.val.factorial : ℝ)| else 0

theorem bounded_ghost_skeleton_abs_mass_nonneg {P Z : Type*} (A D : Z → ℝ)
    (t B : ℕ) (s : BoundedOrderedState P Z t B) (b : Fin (B + 1))
    (retained : Finset (Fin s.2.1.val)) :
    0 ≤ boundedGhostSkeletonAbsMass A D t B s b retained := by
  unfold boundedGhostSkeletonAbsMass
  split_ifs
  · exact abs_nonneg _
  · exact le_rfl

theorem bounded_ghost_event_abs_factor {P Z : Type*} (A D C ν : Z → ℝ)
    (hν : ∀ z, 0 ≤ ν z) (t B : ℕ) (s : BoundedOrderedState P Z t B)
    (b : Fin (B + 1)) (retained : Finset (Fin s.2.1.val)) (births : Fin b.val → Z) :
    |boundedGhostEventWeight A D C ν t B s ⟨b, retained, births⟩| =
      boundedGhostSkeletonAbsMass A D t B s b retained *
        ∏ j, |C (births j)| * ν (births j) := by
  have hp : |∏ j, C (births j) * ν (births j)| =
      ∏ j, |C (births j)| * ν (births j) := by
    rw [abs_prod]
    apply prod_congr rfl
    intro j _
    rw [abs_mul, abs_of_nonneg (hν _)]
  unfold boundedGhostEventWeight boundedGhostSkeletonAbsMass
  dsimp only
  split_ifs
  · rw [abs_div, abs_mul, hp, abs_div]
    ring
  · simp only [abs_zero, zero_mul]

noncomputable def unrestrictedBoundedSkeletonMass {P : Type*} (n : P → ℕ)
    (Δ D : ℤ) (ρ V : ℝ) (t B : ℕ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (stores promotions : Finset (Fin t))
    (e : promotions ↪ ↥(unrestrictedResidueEligible n Δ D s.2.2)) : ℝ :=
  if unrestrictedResidueStorageAllowed n D s.1 stores ∧
      (unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
        (unrestrictedResidueTransport n Δ) stores promotions e).1 ≤ B then
    (ρ ^ orderedPredicateCount ⟨s.2.1.val, s.2.2⟩ unrestrictedResidueHit *
      ρ ^ orderedPredicateCount (unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
        (unrestrictedResidueTransport n Δ) stores promotions e) unrestrictedResidueHit) /
          V ^ promotions.card else 0

theorem unrestricted_bounded_skeleton_mass_nonneg {P : Type*} (n : P → ℕ)
    (Δ D : ℤ) (ρ V : ℝ) (hρ : 0 ≤ ρ) (hV : 0 ≤ V) (t B : ℕ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (stores promotions : Finset (Fin t))
    (e : promotions ↪ ↥(unrestrictedResidueEligible n Δ D s.2.2)) :
    0 ≤ unrestrictedBoundedSkeletonMass n Δ D ρ V t B s stores promotions e := by
  unfold unrestrictedBoundedSkeletonMass
  split_ifs
  · exact div_nonneg (mul_nonneg (pow_nonneg hρ _) (pow_nonneg hρ _)) (pow_nonneg hV _)
  · exact le_rfl

theorem unrestricted_bounded_event_fresh_factor {P : Type*} (n : P → ℕ)
    (Δ D : ℤ) (μ : P → ℝ) (ρ V : ℝ) (t B : ℕ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (stores promotions : Finset (Fin t))
    (e : promotions ↪ ↥(unrestrictedResidueEligible n Δ D s.2.2))
    (fresh : UnrestrictedFreshLabels P promotions) :
    unrestrictedBoundedEventWeight n Δ D μ ρ V t B s ⟨stores, promotions, e, fresh⟩ =
      unrestrictedBoundedSkeletonMass n Δ D ρ V t B s stores promotions e *
        unrestrictedFreshWeight μ promotions fresh := by
  unfold unrestrictedBoundedEventWeight unrestrictedEdgeEventMass unrestrictedBoundedSkeletonMass
  dsimp only
  split_ifs
  · rfl
  · exact (zero_mul _).symm

end Bounty
end

section

/- Separating cumulative ledger avoidance leaves the exact original local edge factor. -/

open Finset
open scoped Classical
namespace Bounty

theorem global_birth_bounded_edge_phase_factor {P : Type*} [DecidableEq P]
    (n : P → ℕ) (Δ D : ℤ) (t B : ℕ) (target : Fin t → P) (H : Finset P)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (e : UnrestrictedBoundedEvent n Δ D t B s) :
    globalBirthBoundedEdgePhase n Δ D t B target H s e.1 e.2.1 e.2.2.1 e.2.2.2 =
      (if ∀ i, e.2.2.2 i ∉ H then 1 else 0) *
        globalBirthBoundedEdgePhase n Δ D t B target ∅ s e.1 e.2.1 e.2.2.1 e.2.2.2 := by
  simp only [globalBirthBoundedEdgePhase, notMem_empty]
  split_ifs <;> simp_all

theorem unrestricted_fresh_injective_of_target {P Z : Type*} {N t : ℕ}
    (old : Fin N → Z) (label : Z → P) (promotions : Finset (Fin t))
    {eligible : Finset (Fin N)} (e : promotions ↪ ↥eligible)
    (fresh : UnrestrictedFreshLabels P promotions) (target : Fin t → P)
    (hinj : Function.Injective target)
    (htarget : unrestrictedEdgeTarget old label promotions e fresh = target) :
    Function.Injective fresh := by
  intro i j hij
  apply Subtype.ext
  apply hinj
  have hi : unrestrictedEdgeTarget old label promotions e fresh i.val = fresh i := by
    simp only [unrestrictedEdgeTarget, unrestrictedTargetLabels, dif_neg i.property]
  have hj : unrestrictedEdgeTarget old label promotions e fresh j.val = fresh j := by
    simp only [unrestrictedEdgeTarget, unrestrictedTargetLabels, dif_neg j.property]
  rw [htarget] at hi hj
  exact hi.trans (hij.trans hj.symm)

section Full
variable {N : ℕ} {P : Fin N → Type*} [∀ g, DecidableEq (P g)]
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : SharedActiveLabels P S → Type*) (Δ D : ∀ c, A c → Fin N → ℤ)
  (target : (g : Fin N) → Fin (S g)ᶜ.card → P g)
  (H : (g : Fin N) → Finset (P g))
  (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
  (e : FullActiveEdgeEvent n S B A Δ D x)

theorem full_edge_ledger_phase_factor :
    fullEdgeLedgerPhase n S B A Δ D target H x e =
      (if ∀ g i, (e.2 g).2.2.2 i ∉ H g then 1 else 0) *
        fullEdgeLedgerPhase n S B A Δ D target (fun _ => ∅) x e := by
  unfold fullEdgeLedgerPhase
  trans (∏ g, if ∀ i, (e.2 g).2.2.2 i ∉ H g then (1 : ℂ) else 0) *
    (∏ g, globalBirthBoundedEdgePhase (n g)
      (Δ (productActiveMemorySplit S B x).1 e.1 g)
      (D (productActiveMemorySplit S B x).1 e.1 g) (S g)ᶜ.card B (target g) ∅
      ((productActiveMemorySplit S B x).2 g)
      (e.2 g).1 (e.2 g).2.1 (e.2 g).2.2.1 (e.2 g).2.2.2)
  · rw [← prod_mul_distrib]
    apply prod_congr rfl
    intro g _
    exact global_birth_bounded_edge_phase_factor _ _ _ _ _ _ _ _ (e.2 g)
  congr 1
  by_cases h : ∀ g i, (e.2 g).2.2.2 i ∉ H g
  · rw [if_pos h]
    calc
      _ = ∏ _g : Fin N, (1 : ℂ) := prod_congr rfl (fun g _ => if_pos (h g))
      _ = 1 := prod_const_one
  · rw [if_neg h]
    obtain ⟨g, hg⟩ := not_forall.mp h
    exact prod_eq_zero (mem_univ g) (if_neg hg)

theorem full_edge_ledger_phase_target_of_nonzero
    (hphase : fullEdgeLedgerPhase n S B A Δ D target H x e ≠ 0) (g : Fin N) :
    unrestrictedEdgeTarget ((productActiveMemorySplit S B x).2 g).2.2 Sigma.fst
      (e.2 g).2.1 (e.2 g).2.2.1 (e.2 g).2.2.2 = target g := by
  by_contra h
  apply hphase
  apply prod_eq_zero (mem_univ g)
  simp only [globalBirthBoundedEdgePhase, h, false_and, if_false]

theorem full_edge_ledger_phase_fresh_injective
    (hphase : fullEdgeLedgerPhase n S B A Δ D target H x e ≠ 0)
    (htarget : ∀ g, Function.Injective (target g)) (g : Fin N) :
    Function.Injective (e.2 g).2.2.2 :=
  unrestricted_fresh_injective_of_target _ _ _ _ _ _ (htarget g)
    (full_edge_ledger_phase_target_of_nonzero n S B A Δ D target H x e hphase g)

end Full
end Bounty
end

section

/- A finite path action only reads its initial value and the kernels in its prefix. -/

open Finset
namespace Bounty

theorem finite_path_action_prefix_congr {X R : Type*} [Fintype X] [Semiring R]
    (K H : ℕ → X → X → R) (f g : X → R) (n : ℕ)
    (hK : ∀ j < n, ∀ x y, K j x y = H j x y) (hf : ∀ x, f x = g x) (x : X) :
    finitePathAction K f n x = finitePathAction H g n x := by
  induction n generalizing x with
  | zero => exact hf x
  | succ n ih =>
    simp only [finitePathAction]
    apply sum_congr rfl
    intro y hy
    rw [hK n (by omega) x y, ih (fun j hj => hK j (by omega)) y]

end Bounty
end

section

/- Multipliers depending only on active labels preserve the independent
permutation symmetry of every pending memory tuple. -/

namespace Bounty

theorem productMemoryPermuteAt_active {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (x : ProductBoundedOrderedState P Z t B) (g : G)
    (τ : Equiv.Perm (Fin (x g).2.1.val)) :
    (fun h => (productMemoryPermuteAt x g τ h).1) = (fun h => (x h).1) := by
  funext h
  by_cases hh : h = g
  · subst h
    simp only [productMemoryPermuteAt, Function.update_self]
  · simp only [productMemoryPermuteAt, Function.update_of_ne hh]

theorem productMemorySymmetric_mul_active {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ} {K : Type*} [Mul K]
    (a : (∀ g, Fin (t g) → P g) → K)
    (f : ProductBoundedOrderedState P Z t B → K) (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric (fun x => a (fun g => (x g).1) * f x) := by
  intro x g τ
  change a (fun h => (productMemoryPermuteAt x g τ h).1) *
    f (productMemoryPermuteAt x g τ) = a (fun h => (x h).1) * f x
  rw [productMemoryPermuteAt_active, hf x g τ]

end Bounty
end

section

/- Exact clean-event extraction on bounded ordered memory states. The
continuation remains symmetric in memory; target labels may repeat. -/

open Finset
open scoped Classical

namespace Bounty

def unrestrictedBoundedCleanTarget {P : Type*} (n : P → ℕ) (Δ : ℤ) {t B : ℕ}
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B) (target : Fin t → P) :
    BoundedOrderedState P (UnrestrictedResidueParticle n) t B :=
  (target, ⟨s.2.1, unrestrictedResidueTransport n Δ ∘ s.2.2⟩)

theorem unrestricted_bounded_operator_clean {P : Type*} [Fintype P]
    (n : P → ℕ) (Δ D : ℤ) (μ : P → ℝ) (ρ V : ℝ) (t B : ℕ)
    (θ : (Fin t → P) → ℂ)
    (f : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
    (hf : BoundedOrderedSymmetric f)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B) :
    unrestrictedBoundedOperator n Δ D μ ρ V t B
      (fun s stores promotions e fresh => if stores = ∅ ∧ promotions = ∅ then
        θ (unrestrictedEdgeTarget s.2.2 Sigma.fst promotions e fresh) else 0) f s =
      ((ρ ^ orderedPredicateCount (boundedOrderedTupleToFinite s.2) unrestrictedResidueHit *
        ρ ^ orderedPredicateCount
          (boundedOrderedTupleToFinite (unrestrictedBoundedCleanTarget n Δ s s.1).2)
            unrestrictedResidueHit : ℝ) : ℂ) *
        ∑ target : Fin t → P, ((∏ j, μ (target j) : ℝ) : ℂ) * θ target *
          f (unrestrictedBoundedCleanTarget n Δ s target) := by
  unfold unrestrictedBoundedOperator unrestrictedBoundedAction
  rw [unrestricted_residue_edge_action_clean n Δ D s.1 s.2.2 μ ρ V B θ
    (boundedOrderedZeroExtension f) ((boundedOrderedZeroExtension_symmetric_iff f).mpr hf)]
  rw [if_pos (Nat.le_of_lt_succ s.2.1.isLt)]
  congr 1
  apply sum_congr rfl
  intro target ht
  congr 1
  exact boundedOrderedZeroExtension_apply f (unrestrictedBoundedCleanTarget n Δ s target)

theorem unrestricted_bounded_clean_event_sum {P : Type*} [Fintype P]
    (n : P → ℕ) (Δ D : ℤ) (μ : P → ℝ) (ρ V : ℝ) (t B : ℕ)
    (θ : (Fin t → P) → ℂ)
    (f : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
    (hf : BoundedOrderedSymmetric f)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B) :
    (∑ e : UnrestrictedBoundedEvent n Δ D t B s,
      (unrestrictedBoundedEventWeight n Δ D μ ρ V t B s e : ℂ) *
        (if e.1 = ∅ ∧ e.2.1 = ∅ then
          θ (unrestrictedEdgeTarget s.2.2 Sigma.fst e.2.1 e.2.2.1 e.2.2.2) else 0) *
        f (unrestrictedBoundedEventTarget n Δ D t B s e)) =
      ((ρ ^ orderedPredicateCount (boundedOrderedTupleToFinite s.2) unrestrictedResidueHit *
        ρ ^ orderedPredicateCount
          (boundedOrderedTupleToFinite (unrestrictedBoundedCleanTarget n Δ s s.1).2)
            unrestrictedResidueHit : ℝ) : ℂ) *
        ∑ target : Fin t → P, ((∏ j, μ (target j) : ℝ) : ℂ) * θ target *
          f (unrestrictedBoundedCleanTarget n Δ s target) := by
  exact (unrestricted_bounded_operator_eq_event_sum n Δ D μ ρ V t B
    (fun s stores promotions e fresh => if stores = ∅ ∧ promotions = ∅ then
      θ (unrestrictedEdgeTarget s.2.2 Sigma.fst promotions e fresh) else 0) f s).symm.trans
    (unrestricted_bounded_operator_clean n Δ D μ ρ V t B θ f hf s)

theorem unrestricted_bounded_clean_target_fixed_memory {G : Type*}
    {P : G → Finset ℕ} {t B : ℕ} (N : G → Fin (B + 1))
    (p : FixedOrderedMemoryLabels P (fun g => (N g).val)) (r : FixedOrderedResidues p)
    (g : G) (Δ : ℤ) (source target : Fin t → P g) :
    unrestrictedBoundedCleanTarget (fun q : P g => q.val) (-Δ)
      (source, ⟨N g, fun j => ⟨p g j, r g j⟩⟩) target =
      (target, ⟨N g, fun j => ⟨p g j, fixedOrderedResidueTranslate p r Δ g j⟩⟩) := by
  apply congrArg (fun q : Fin (N g).val → UnrestrictedResidueParticle (fun q : P g => q.val) =>
    (target, (⟨N g, q⟩ : BoundedOrderedTuple _ B)))
  funext j
  exact (fixed_ordered_residue_memory_transport_apply p r Δ g j).symm

end Bounty
end

section

/- One fixed damping choice controls every endpoint and interior visit. -/

namespace Bounty

theorem physical_endpoint_schedule_le_sqrt {q : ℝ} (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (edges j : ℕ) : physicalEndpointSchedule q edges j ≤ Real.sqrt q := by
  have hs0 := Real.sqrt_nonneg q
  have hs2 := Real.sq_sqrt hq0
  have hs1 : Real.sqrt q ≤ 1 := by nlinarith
  unfold physicalEndpointSchedule
  split_ifs
  · exact le_rfl
  · nlinarith

theorem physical_endpoint_ghost_parameter_choice {q : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1)
    (Vmax : ℝ) :
    let ρ := physicalGhostRhoChoice (Real.sqrt q)
    let v := physicalGhostWeightChoice (Real.sqrt q) Vmax
    0 < ρ ∧ ρ < 1 ∧ 1 < v ∧
      ∀ (edges j : ℕ) (V : ℝ), 0 ≤ V → V ≤ Vmax →
        (physicalEndpointSchedule q edges j / ρ ^ 2 +
          ((1 - physicalEndpointSchedule q edges j) / ρ) / v ≤ 1) ∧
        (physicalEndpointSchedule q edges j / ρ ^ 2 +
          ((1 - physicalEndpointSchedule q edges j) * V / ρ) / v ≤ 1) ∧
        (physicalEndpointSchedule q edges j / ρ ^ 2 +
          (2 * ((1 - physicalEndpointSchedule q edges j) * V / ρ)) / v < 1) := by
  have hs1 : Real.sqrt q < 1 := by nlinarith [Real.sq_sqrt hq0, Real.sqrt_nonneg q]
  obtain ⟨hρ0, hρ1, _, hv, _, h⟩ := physical_ghost_parameter_choice (Real.sqrt_nonneg q) hs1 (Vmax := Vmax)
  refine ⟨hρ0, hρ1, hv, ?_⟩
  intro edges j V hV0 hVmax
  exact h _ _ (physical_endpoint_schedule_unit hq0 hq1.le edges j).1
    (physical_endpoint_schedule_le_sqrt hq0 hq1.le edges j) hV0 hVmax

end Bounty
end

section

/- Exact skeleton and sampled-coordinate decompositions of the existing full events. -/

open Classical

namespace Bounty

abbrev CoupledGhostSkeleton {G : Type*} {P Z : G → Type*} (t : G → ℕ) (B : ℕ)
    (s : ProductBoundedOrderedState P Z t B) :=
  ∀ g, Fin (B + 1) × Finset (Fin (s g).2.1.val)

abbrev CoupledGhostSampleIndex {G : Type*} {P Z : G → Type*} (t : G → ℕ) (B : ℕ)
    (s : ProductBoundedOrderedState P Z t B) (sk : CoupledGhostSkeleton t B s) :=
  (g : G) × Fin (sk g).1.val

abbrev CoupledGhostSamples {G : Type*} {P Z : G → Type*} (t : G → ℕ) (B : ℕ)
    (s : ProductBoundedOrderedState P Z t B) (sk : CoupledGhostSkeleton t B s) :=
  (i : CoupledGhostSampleIndex t B s sk) → Z i.1

noncomputable def coupledGhostSkeletonEquiv {G : Type*} {P Z : G → Type*} (t : G → ℕ) (B : ℕ)
    (s : ProductBoundedOrderedState P Z t B) :
    CoupledGhostEvent t B s ≃ (sk : CoupledGhostSkeleton t B s) × CoupledGhostSamples t B s sk where
  toFun e := ⟨fun g => ⟨(e g).1, (e g).2.1⟩, fun i => (e i.1).2.2 i.2⟩
  invFun v g := ⟨(v.1 g).1, (v.1 g).2, fun i => v.2 ⟨g, i⟩⟩
  left_inv _ := rfl
  right_inv _ := rfl

abbrev UnrestrictedLocalEdgeSkeleton {P : Type*} (n : P → ℕ) (Δ D : ℤ) (t B : ℕ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B) :=
  (_stores : Finset (Fin t)) × (promotions : Finset (Fin t)) ×
    (promotions ↪ ↥(unrestrictedResidueEligible n Δ D s.2.2))

abbrev FullActiveEdgeSkeleton {G : Type*} {P : G → Type*}
    (n : ∀ g, P g → ℕ) {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : SharedActiveLabels P S → Type*) (Δ D : ∀ c, A c → G → ℤ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :=
  (a : A (productActiveMemorySplit S B s).1) ×
    ∀ g, UnrestrictedLocalEdgeSkeleton (n g)
      (Δ (productActiveMemorySplit S B s).1 a g) (D (productActiveMemorySplit S B s).1 a g)
      (S g)ᶜ.card B ((productActiveMemorySplit S B s).2 g)

abbrev FullActiveEdgeSampleIndex {G : Type*} {P : G → Type*}
    (n : ∀ g, P g → ℕ) {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : SharedActiveLabels P S → Type*) (Δ D : ∀ c, A c → G → ℤ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (sk : FullActiveEdgeSkeleton n S B A Δ D s) :=
  (g : G) × {i : Fin (S g)ᶜ.card // i ∉ (sk.2 g).2.1}

abbrev FullActiveEdgeSamples {G : Type*} {P : G → Type*}
    (n : ∀ g, P g → ℕ) {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : SharedActiveLabels P S → Type*) (Δ D : ∀ c, A c → G → ℤ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (sk : FullActiveEdgeSkeleton n S B A Δ D s) :=
  (i : FullActiveEdgeSampleIndex n S B A Δ D s sk) → P i.1

noncomputable def fullActiveEdgeSkeletonEquiv {G : Type*} {P : G → Type*}
    (n : ∀ g, P g → ℕ) {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : SharedActiveLabels P S → Type*) (Δ D : ∀ c, A c → G → ℤ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    FullActiveEdgeEvent n S B A Δ D s ≃
      (sk : FullActiveEdgeSkeleton n S B A Δ D s) × FullActiveEdgeSamples n S B A Δ D s sk where
  toFun e := by
    refine ⟨⟨e.1, ?_⟩, ?_⟩
    · intro g
      exact ⟨(e.2 g).1, (e.2 g).2.1, (e.2 g).2.2.1⟩
    · intro i
      exact (e.2 i.1).2.2.2 i.2
  invFun v := by
    rcases v with ⟨⟨a, sk⟩, fresh⟩
    exact ⟨a, fun g => ⟨(sk g).1, (sk g).2.1, (sk g).2.2, fun i => fresh ⟨g, i⟩⟩⟩
  left_inv e := by
    rcases e with ⟨a, e⟩
    rfl
  right_inv v := by
    rcases v with ⟨⟨a, sk⟩, fresh⟩
    rfl

end Bounty
end

section

/- Splitting one sample retains a continuation at the fully reconstructed assignment. -/

open Finset Classical

namespace Bounty

def birthCoordinateInsert {I : Type*} [DecidableEq I] (Z : I → Type*) (i : I)
    (z : Z i) (rest : (j : {j : I // j ≠ i}) → Z j.1) : (j : I) → Z j :=
  (Equiv.piSplitAt i Z).symm (z, rest)

theorem birth_coordinate_insert_same {I : Type*} [DecidableEq I] (Z : I → Type*) (i : I)
    (z : Z i) (rest : (j : {j : I // j ≠ i}) → Z j.1) :
    birthCoordinateInsert Z i z rest i = z := by
  simp [birthCoordinateInsert, Equiv.piSplitAt]

theorem birth_coordinate_insert_other {I : Type*} [DecidableEq I] (Z : I → Type*) (i : I)
    (z : Z i) (rest : (j : {j : I // j ≠ i}) → Z j.1) (j : {j : I // j ≠ i}) :
    birthCoordinateInsert Z i z rest j.1 = rest j := by
  simp [birthCoordinateInsert, Equiv.piSplitAt, j.property]

theorem selected_coordinate_kernel_sum {I : Type*} [Fintype I] [DecidableEq I]
    (Z : I → Type*) [∀ j, Fintype (Z j)] (i : I) (w : (j : I) → Z j → ℝ)
    {P : Type*} [DecidableEq P] (label : Z i → P) (p : P) (K : ℝ)
    (F : ((j : I) → Z j) → ℝ) :
    (∑ f : (j : I) → Z j, if label (f i) = p then (K * ∏ j, w j (f j)) * F f else 0) =
      ∑ z : Z i, if label z = p then w i z *
        (K * ∑ rest : (j : {j : I // j ≠ i}) → Z j.1,
          (∏ j, w j.1 (rest j)) * F (birthCoordinateInsert Z i z rest)) else 0 := by
  rw [← (Equiv.piSplitAt i Z).symm.sum_comp, Fintype.sum_prod_type]
  apply sum_congr rfl
  intro z _
  change (∑ rest, if label (birthCoordinateInsert Z i z rest i) = p then
    (K * ∏ j, w j (birthCoordinateInsert Z i z rest j)) *
      F (birthCoordinateInsert Z i z rest) else 0) = _
  simp only [birth_coordinate_insert_same]
  by_cases hz : label z = p
  · simp only [if_pos hz, mul_sum]
    apply sum_congr rfl
    intro rest _
    rw [Fintype.prod_eq_mul_prod_subtype_ne
      (fun j => w j (birthCoordinateInsert Z i z rest j)) i]
    simp only [birth_coordinate_insert_same, birth_coordinate_insert_other]
    ring
  · simp only [if_neg hz, sum_const_zero]

theorem selected_coordinate_value_kernel_sum {I : Type*} [Fintype I] [DecidableEq I]
    (Z : I → Type*) [∀ j, Fintype (Z j)] (i : I) (w : (j : I) → Z j → ℝ)
    [DecidableEq (Z i)] (p : Z i) (K : ℝ) (F : ((j : I) → Z j) → ℝ) :
    (∑ f : (j : I) → Z j, if f i = p then (K * ∏ j, w j (f j)) * F f else 0) =
      w i p * (K * ∑ rest : (j : {j : I // j ≠ i}) → Z j.1,
        (∏ j, w j.1 (rest j)) * F (birthCoordinateInsert Z i p rest)) := by
  simpa only [id_eq, sum_ite_eq', mem_univ, if_true] using
    selected_coordinate_kernel_sum Z i w id p K F

theorem selected_coordinate_value_kernel_le {I : Type*} [Fintype I] [DecidableEq I]
    (Z : I → Type*) [∀ j, Fintype (Z j)] (i : I) (w : (j : I) → Z j → ℝ)
    [DecidableEq (Z i)] (p : Z i) (K : ℝ) (F : ((j : I) → Z j) → ℝ)
    (hK : 0 ≤ K) (hw : ∀ j z, 0 ≤ w j z) (hF : ∀ f, 0 ≤ F f)
    {ε : ℝ} (hatom : w i p ≤ ε) :
    (∑ f : (j : I) → Z j, if f i = p then (K * ∏ j, w j (f j)) * F f else 0) ≤
      ε * (K * ∑ rest : (j : {j : I // j ≠ i}) → Z j.1,
        (∏ j, w j.1 (rest j)) * F (birthCoordinateInsert Z i p rest)) := by
  rw [selected_coordinate_value_kernel_sum]
  exact mul_le_mul_of_nonneg_right hatom (mul_nonneg hK
    (sum_nonneg fun rest _ => mul_nonneg (prod_nonneg fun j _ => hw j.1 _) (hF _)))

end Bounty
end

section

/- Birth-slot factors preserve memory symmetry while all old-particle retrievals are summed. -/

open Finset Classical
namespace Bounty

theorem unrestricted_residue_birth_phase_symmetric {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] {t : ℕ} (Δ D : ℤ) (source : Fin t → P)
    (μ : P → ℝ) (ρ V : ℝ) (B : ℕ)
    (φ : ∀ (_stores promotions : Finset (Fin t)), UnrestrictedFreshLabels P promotions → (Fin t → P) → ℂ)
    (F : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (hF : ∀ target, OrderedTupleSymmetric (F target)) :
    OrderedTupleSymmetric (fun old : FiniteOrderedTuple (UnrestrictedResidueParticle n) =>
      unrestrictedResidueEdgeAction n Δ D source old.2 μ ρ V B
        (fun stores promotions e fresh =>
          φ stores promotions fresh (unrestrictedEdgeTarget old.2 Sigma.fst promotions e fresh)) F) := by
  intro N old τ
  dsimp only
  unfold unrestrictedResidueEdgeAction
  rw [unrestricted_residue_eligible_perm]
  apply unrestricted_edge_action_perm
  · intro stores promotions e fresh
    dsimp only
    rw [unrestricted_edge_target_perm]
  · exact hF

theorem unrestricted_bounded_birth_phase_symmetric {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (Δ D : ℤ) (μ : P → ℝ) (ρ V : ℝ)
    (t B : ℕ)
    (φ : (Fin t → P) → ∀ (_stores promotions : Finset (Fin t)),
      UnrestrictedFreshLabels P promotions → (Fin t → P) → ℂ)
    (f : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
    (hf : BoundedOrderedSymmetric f) :
    BoundedOrderedSymmetric (unrestrictedBoundedOperator n Δ D μ ρ V t B
      (fun s stores promotions e fresh => φ s.1 stores promotions fresh
        (unrestrictedEdgeTarget s.2.2 Sigma.fst promotions e fresh)) f) := by
  intro active N q τ
  exact unrestricted_residue_birth_phase_symmetric n Δ D active μ ρ V B (φ active)
    (boundedOrderedZeroExtension f) ((boundedOrderedZeroExtension_symmetric_iff f).mpr hf)
    N.val q τ

theorem unrestricted_birth_cutoff_product_symmetric
    {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (Δ D : G → ℤ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (t : G → ℕ) (B : ℕ)
    (φ : ∀ g, (Fin (t g) → P g) → ∀ (_stores promotions : Finset (Fin (t g))),
      UnrestrictedFreshLabels (P g) promotions → (Fin (t g) → P g) → ℂ)
    (groups : Finset G)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric (unrestrictedCutoffProductOperator n Δ D μ ρ V t B
      (fun g s stores promotions e fresh => φ g s.1 stores promotions fresh
        (unrestrictedEdgeTarget s.2.2 Sigma.fst promotions e fresh)) groups f) := by
  apply product_memory_cutoff_sandwich_symmetric
  · intro g h hh
    exact unrestricted_bounded_birth_phase_symmetric (n g) (Δ g) (D g) (μ g) ρ (V g)
      (t g) B (φ g) h hh
  · exact hf

/-- Shared labels and auxiliary parameters may be fixed while proving memory symmetry. -/
theorem full_active_birth_edge_symmetric
    {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
    {A : SharedActiveLabels P S → Type*} [∀ c, Fintype (A c)]
    (ω : ∀ c, A c → ℝ) (Δ D : ∀ c, A c → G → ℤ)
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (φ : ∀ c, A c → ∀ g, (Fin (S g)ᶜ.card → P g) →
      ∀ (_stores promotions : Finset (Fin (S g)ᶜ.card)),
      UnrestrictedFreshLabels (P g) promotions → (Fin (S g)ᶜ.card → P g) → ℂ)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric (fullActiveMemoryAverage S B ω
      (fun c a => unrestrictedCutoffProductOperator n (Δ c a) (D c a) μ ρ V
        (fun g => (S g)ᶜ.card) B
        (fun g s stores promotions e fresh => φ c a g s.1 stores promotions fresh
          (unrestrictedEdgeTarget s.2.2 Sigma.fst promotions e fresh)) univ) f) := by
  apply full_active_memory_average_symmetric S B ω _ _ f hf
  intro c a F hF
  exact unrestricted_birth_cutoff_product_symmetric n (Δ c a) (D c a) μ ρ V
    (fun g => (S g)ᶜ.card) B (φ c a) univ F hF

end Bounty
end

section

/- Retention indices may be reindexed without changing any ordered birth address. -/

open Finset Classical
namespace Bounty

abbrev boundedGhostMemoryPermute {P Z : Type*} {t B : ℕ}
    (s : BoundedOrderedState P Z t B) (τ : Equiv.Perm (Fin s.2.1.val)) :
    BoundedOrderedState P Z t B := (s.1, ⟨s.2.1, s.2.2 ∘ τ⟩)

noncomputable def boundedGhostEventPermEquiv {P Z : Type*} {t B : ℕ}
    (s : BoundedOrderedState P Z t B) (τ : Equiv.Perm (Fin s.2.1.val)) :
    BoundedGhostEvent t B s ≃ BoundedGhostEvent t B (boundedGhostMemoryPermute s τ) :=
  Equiv.sigmaCongrRight fun _ =>
    Equiv.prodCongr (Equiv.finsetCongr τ.symm) (Equiv.refl _)

theorem boundedGhostEventPermEquiv_apply {P Z : Type*} {t B : ℕ}
    (s : BoundedOrderedState P Z t B) (τ : Equiv.Perm (Fin s.2.1.val))
    (e : BoundedGhostEvent t B s) :
    boundedGhostEventPermEquiv s τ e =
      ⟨e.1, e.2.1.map τ.symm.toEmbedding, e.2.2⟩ := rfl

theorem bounded_ghost_event_perm_weight {P Z : Type*} {t B : ℕ}
    (A D C ν : Z → ℝ) (s : BoundedOrderedState P Z t B)
    (τ : Equiv.Perm (Fin s.2.1.val)) (e : BoundedGhostEvent t B s) :
    boundedGhostEventWeight A D C ν t B (boundedGhostMemoryPermute s τ)
        (boundedGhostEventPermEquiv s τ e) = boundedGhostEventWeight A D C ν t B s e := by
  rcases e with ⟨b, retained, births⟩
  rw [boundedGhostEventPermEquiv_apply]
  have hcomp : univ \ retained.map τ.symm.toEmbedding =
      (univ \ retained).map τ.symm.toEmbedding := by
    rw [Finset.map_sdiff]
    simp
  simp only [boundedGhostEventWeight, boundedGhostMemoryPermute, card_map,
    hcomp, prod_map, Function.comp_apply, Equiv.coe_toEmbedding, Equiv.apply_symm_apply]

theorem bounded_ghost_event_perm_test {P Z : Type*} [Fintype Z] [DecidableEq Z]
    {t B : ℕ} (s : BoundedOrderedState P Z t B)
    (τ : Equiv.Perm (Fin s.2.1.val)) (e : BoundedGhostEvent t B s)
    (f : BoundedOrderedState P Z t B → ℂ) (hf : BoundedOrderedSymmetric f) :
    f (boundedGhostEventTarget t B (boundedGhostMemoryPermute s τ)
        (boundedGhostEventPermEquiv s τ e)) = f (boundedGhostEventTarget t B s e) := by
  rw [boundedGhostEventPermEquiv_apply]
  rcases e with ⟨b, retained, births⟩
  have hocc : orderedTupleOccupancy
      (retainedBirthTuple (s.2.2 ∘ τ) (retained.map τ.symm.toEmbedding) births) =
      orderedTupleOccupancy (retainedBirthTuple s.2.2 retained births) := by
    simp only [retained_birth_tuple_occupancy, retainedTupleOccupancy, sum_map,
      Function.comp_apply, Equiv.coe_toEmbedding, Equiv.apply_symm_apply]
  have hext := symmetric_tuple_equal_on_occupancy (boundedOrderedZeroExtension f s.1)
    ((boundedOrderedZeroExtension_symmetric_iff f).mpr hf s.1) _ _ hocc
  by_cases h : retained.card + b.val ≤ B
  · simpa [boundedGhostEventTarget, boundedGhostMemoryPermute,
      boundedOrderedZeroExtension, retainedBirthTuple, h] using hext
  · simpa [boundedGhostEventTarget, boundedGhostMemoryPermute,
      retainedBirthTuple, h] using hf s.1 s.2.1 s.2.2 τ

/-- No symmetry of the birth batch is assumed: numbered birth slots may carry different factors. -/
theorem bounded_ghost_birth_phase_symmetric {P Z : Type*} [Fintype Z] [DecidableEq Z]
    (A D C ν : Z → ℝ) (t B : ℕ)
    (φ : (Fin t → P) → (b : Fin (B + 1)) → (Fin b.val → Z) → ℂ)
    (f : BoundedOrderedState P Z t B → ℂ) (hf : BoundedOrderedSymmetric f) :
    BoundedOrderedSymmetric (fun s => ∑ e : BoundedGhostEvent t B s,
      (boundedGhostEventWeight A D C ν t B s e : ℂ) * φ s.1 e.1 e.2.2 *
        f (boundedGhostEventTarget t B s e)) := by
  intro active N q τ
  let s : BoundedOrderedState P Z t B := (active, ⟨N, q⟩)
  change (∑ e : BoundedGhostEvent t B (boundedGhostMemoryPermute s τ), _) = _
  rw [← (boundedGhostEventPermEquiv s τ).sum_comp]
  apply sum_congr rfl
  intro e _
  rw [bounded_ghost_event_perm_weight A D C ν s τ e,
    bounded_ghost_event_perm_test s τ e f hf, boundedGhostEventPermEquiv_apply]

end Bounty
end

section

/- Exact causal integration on the original dependent paths, including arbitrary path observables. -/

open Finset Classical

namespace Bounty

universe u v w z

section Integral
variable {K : Type u} {X : Type v} (E : K → X → Type w)
    [∀ k x, Fintype (E k x)] (target : ∀ k x, E k x → X)
    (weight : ∀ k x, E k x → ℝ)

noncomputable def finiteEventPathIntegral (steps : List K) (x : X)
    (F : FiniteEventPath E target steps x → ℝ) : ℝ :=
  let _ := finiteEventPathFintype E target steps x
  ∑ p, finiteEventPathWeight E target weight steps x p * F p

theorem finite_event_path_integral_nil (x : X)
    (F : FiniteEventPath E target [] x → ℝ) :
    finiteEventPathIntegral E target weight [] x F = F PUnit.unit := by
  change (∑ p : PUnit.{w + 1}, 1 * F p) = F PUnit.unit
  simpa only [one_mul] using Fintype.sum_subsingleton (fun p : PUnit.{w + 1} => 1 * F p) PUnit.unit

theorem finite_event_path_integral_cons (k : K) (steps : List K) (x : X)
    (F : FiniteEventPath E target (k :: steps) x → ℝ) :
    finiteEventPathIntegral E target weight (k :: steps) x F =
      ∑ e : E k x, weight k x e * finiteEventPathIntegral E target weight steps
        (target k x e) (fun p => F ⟨e, p⟩) := by
  let _ : ∀ e : E k x, Fintype (FiniteEventPath E target steps (target k x e)) :=
    fun e => finiteEventPathFintype E target steps (target k x e)
  change (∑ p : (e : E k x) × FiniteEventPath E target steps (target k x e),
    (weight k x p.1 * finiteEventPathWeight E target weight steps _ p.2) * F p) = _
  rw [Fintype.sum_sigma]
  simp only [finiteEventPathIntegral, mul_sum, mul_assoc]

theorem finite_event_path_integral_cons_reindex (k : K) (steps : List K) (x : X)
    {I : Type z} [Fintype I] (e : I ≃ E k x)
    (F : FiniteEventPath E target (k :: steps) x → ℝ) :
    finiteEventPathIntegral E target weight (k :: steps) x F =
      ∑ i : I, weight k x (e i) * finiteEventPathIntegral E target weight steps
        (target k x (e i)) (fun p => F ⟨e i, p⟩) := by
  rw [finite_event_path_integral_cons]
  exact (e.sum_comp _).symm

theorem finite_event_path_integral_nonneg
    (hw : ∀ k x e, 0 ≤ weight k x e) (steps : List K) (x : X)
    (F : FiniteEventPath E target steps x → ℝ) (hF : ∀ p, 0 ≤ F p) :
    0 ≤ finiteEventPathIntegral E target weight steps x F := by
  let _ := finiteEventPathFintype E target steps x
  exact sum_nonneg fun p _ => mul_nonneg
    (finite_event_path_weight_nonneg E target weight hw steps x p) (hF p)

theorem finite_event_path_integral_mono
    (hw : ∀ k x e, 0 ≤ weight k x e) (steps : List K) (x : X)
    (F G : FiniteEventPath E target steps x → ℝ) (hFG : ∀ p, F p ≤ G p) :
    finiteEventPathIntegral E target weight steps x F ≤
      finiteEventPathIntegral E target weight steps x G := by
  let _ := finiteEventPathFintype E target steps x
  exact sum_le_sum fun p _ => mul_le_mul_of_nonneg_left (hFG p)
    (finite_event_path_weight_nonneg E target weight hw steps x p)

theorem finite_event_path_integral_const_mask (steps : List K) (x : X)
    (F : FiniteEventPath E target steps x → ℝ) (Q : Prop) [Decidable Q] :
    finiteEventPathIntegral E target weight steps x (fun p => if Q then F p else 0) =
      if Q then finiteEventPathIntegral E target weight steps x F else 0 := by
  by_cases h : Q
  · simp only [if_pos h]
  · simp only [if_neg h, finiteEventPathIntegral, mul_zero, sum_const_zero]

theorem finite_event_path_integral_terminal_cast (steps : List K) (x : X) (f : X → ℝ) :
    (finiteEventPathIntegral E target weight steps x
      (fun p => f (finiteEventPathTerminal E target steps x p)) : ℂ) =
      finiteEventPathPositive E target weight steps (fun y => (f y : ℂ)) x := by
  let _ := finiteEventPathFintype E target steps x
  simp only [finiteEventPathIntegral, finiteEventPathPositive, Complex.ofReal_sum, Complex.ofReal_mul]

theorem finite_event_path_integral_le_row_product
    (hw : ∀ k x e, 0 ≤ weight k x e) (C : K → ℝ) (hC : ∀ k, 0 ≤ C k)
    (hrow : ∀ k x, ∑ e : E k x, weight k x e ≤ C k)
    (steps : List K) (x : X) (F : FiniteEventPath E target steps x → ℝ)
    {L : ℝ} (hL : 0 ≤ L) (hF : ∀ p, F p ≤ L) :
    finiteEventPathIntegral E target weight steps x F ≤ (steps.map C).prod * L := by
  induction steps generalizing x with
  | nil => simpa only [finite_event_path_integral_nil, List.map_nil, List.prod_nil, one_mul]
      using hF PUnit.unit
  | cons k steps ih =>
    rw [finite_event_path_integral_cons]
    have hp : 0 ≤ (steps.map C).prod := by
      apply List.prod_nonneg
      intro a ha
      obtain ⟨k, _, rfl⟩ := List.mem_map.mp ha
      exact hC k
    calc
      _ ≤ ∑ e : E k x, weight k x e * ((steps.map C).prod * L) := by
        apply sum_le_sum
        intro e _
        exact mul_le_mul_of_nonneg_left (ih _ _ (fun p => hF ⟨e, p⟩)) (hw k x e)
      _ = (∑ e : E k x, weight k x e) * ((steps.map C).prod * L) :=
        (sum_mul _ _ _).symm
      _ ≤ C k * ((steps.map C).prod * L) :=
        mul_le_mul_of_nonneg_right (hrow k x) (mul_nonneg hp hL)
      _ = ((k :: steps).map C).prod * L := by simp only [List.map_cons, List.prod_cons, mul_assoc]

end Integral

end Bounty
end

section

/- The actual bounded edge row has the existing uniform length-weighted row bound. -/

open Finset Classical

namespace Bounty

theorem unrestricted_bounded_length_row_le_raw {P : Type*} [Fintype P]
    (n : P → ℕ) (Δ D : ℤ) (μ : P → ℝ) (ρ V v : ℝ)
    (hρ : 0 ≤ ρ) (hV : 0 ≤ V) (hv : 0 ≤ v) (hμ : ∀ p, 0 ≤ μ p)
    (t B : ℕ) (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B) :
    (∑ e : UnrestrictedBoundedEvent n Δ D t B s,
      |unrestrictedBoundedEventWeight n Δ D μ ρ V t B s e| *
        v ^ (unrestrictedBoundedEventTarget n Δ D t B s e).2.1.val) ≤
      unrestrictedEdgeRowMass s.1 s.2.2 (unrestrictedResidueSeed n)
        (unrestrictedResidueTransport n Δ) unrestrictedResidueHit μ ρ V v
        (unrestrictedResidueEligible n Δ D s.2.2) := by
  simp only [Fintype.sum_sigma, Fintype.sum_prod_type,
    unrestrictedEdgeRowMass, unrestrictedEdgeChoiceRowMass]
  apply sum_le_sum
  intro stores _
  apply sum_le_sum
  intro promotions _
  apply sum_le_sum
  intro e _
  apply sum_le_sum
  intro fresh _
  rw [abs_of_nonneg (unrestrictedBoundedEventWeight_nonneg n Δ D μ hρ hV hμ t B s _)]
  by_cases h : unrestrictedResidueStorageAllowed n D s.1 stores ∧
      (unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
        (unrestrictedResidueTransport n Δ) stores promotions e).1 ≤ B
  · simp [unrestrictedBoundedEventWeight, unrestrictedBoundedEventTarget, h.1, h.2]
  · simp only [unrestrictedBoundedEventWeight, h, if_false, zero_mul]
    exact mul_nonneg (unrestrictedEdgeEventMass_nonneg _ _ _ _ _ μ hρ hV hμ _ _ _ _)
      (pow_nonneg hv _)

theorem unrestricted_bounded_length_row_le {P : Type*} [Fintype P]
    (n : P → ℕ) (Δ D : ℤ) (μ : P → ℝ) {ρ V v vmin : ℝ}
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : vmin ≤ V) (hμ : ∀ p, 0 ≤ μ p) (hmass : ∑ p, μ p ≤ 2)
    (t B T : ℕ) (ht : t ≤ T)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B) :
    (∑ e : UnrestrictedBoundedEvent n Δ D t B s,
      |unrestrictedBoundedEventWeight n Δ D μ ρ V t B s e| *
        v ^ (unrestrictedBoundedEventTarget n Δ D t B s e).2.1.val) ≤
      v ^ s.2.1.val * unrestrictedEdgeRowBound ρ v vmin T := by
  exact (unrestricted_bounded_length_row_le_raw n Δ D μ ρ V v hρ0.le
    (hvmin.trans_le hV).le (zero_lt_one.trans hv).le hμ t B s).trans
      (unrestricted_edge_row_mass_le s.1 s.2.2 (unrestrictedResidueSeed n)
        (unrestrictedResidueTransport n Δ) unrestrictedResidueHit μ hρ0 hρ1 hv hvmin hV hμ hmass
        (unrestrictedResidueEligible n Δ D s.2.2)
        (unrestrictedResidueEligible_translated_hit n Δ D s.2.2) T ht)

end Bounty
end

section

/- Scalar domination of nonnegative pair weights. -/

open Finset

namespace Bounty

theorem sum_nonneg_pair_coefficient_bound {ι : Type*} (F : Finset ι)
    (A f g : ι → ℝ) {K : ℝ} (hK : 0 ≤ K)
    (hA : ∀ v ∈ F, 0 ≤ A v) (hf : ∀ v ∈ F, f v ≤ K)
    (hg0 : ∀ v ∈ F, 0 ≤ g v) (hg : ∀ v ∈ F, g v ≤ K) :
    (∑ v ∈ F, A v*f v*g v) ≤ K^2*(∑ v ∈ F, A v) := by
  calc
    _ ≤ ∑ v ∈ F, A v*K^2 := by
      apply sum_le_sum
      intro v hv
      have hfg : f v*g v ≤ K*K := mul_le_mul (hf v hv) (hg v hv) (hg0 v hv) hK
      simpa only [pow_two, mul_assoc] using mul_le_mul_of_nonneg_left hfg (hA v hv)
    _ = _ := by rw [← sum_mul]; ring

end Bounty
end

section

/- Forbidden-label mass bounds for reciprocal-prime and tilted laws.
The finite forbidden set and its cardinality remain explicit. -/

open Finset

namespace Bounty

theorem initial_prime_forbidden_mass_le (P F : Finset ℕ) {V v Pmin : ℝ}
    (hv : 0 < v) (hV : v ≤ V) (hPmin : 0 < Pmin)
    (hp : ∀ p ∈ P, Pmin ≤ (p : ℝ)) :
    (∑ p ∈ F ∩ P, 1 / (V * (p : ℝ))) ≤ (F.card : ℝ) / (v * Pmin) := by
  calc
    _ ≤ ∑ _p ∈ F ∩ P, 1 / (v * Pmin) := by
      apply sum_le_sum
      intro p h
      apply one_div_le_one_div_of_le (mul_pos hv hPmin)
      exact mul_le_mul hV (hp p (mem_inter.mp h).2) hPmin.le (hv.trans_le hV).le
    _ = ((F ∩ P).card : ℝ) / (v * Pmin) := by simp [div_eq_mul_inv]
    _ ≤ _ := div_le_div_of_nonneg_right
      (by exact_mod_cast card_le_card (inter_subset_left : F ∩ P ⊆ F)) (mul_pos hv hPmin).le

theorem initial_prime_tilted_forbidden_mass_le (P F : Finset ℕ) (b : ℕ → ℝ)
    {V v Pmin : ℝ} (hv : 0 < v) (hV : v ≤ V) (hPmin : 0 < Pmin)
    (hp : ∀ p ∈ P, Pmin ≤ (p : ℝ)) (hb : ∀ p ∈ P, 1 / 2 ≤ b p) :
    (∑ p ∈ F ∩ P, (1 / (V * (p : ℝ))) / b p) ≤ 2 * (F.card : ℝ) / (v * Pmin) := by
  calc
    _ ≤ ∑ _p ∈ F ∩ P, 2 / (v * Pmin) := by
      apply sum_le_sum
      intro p h
      have ha : 1 / (V * (p : ℝ)) ≤ 1 / (v * Pmin) := by
        apply one_div_le_one_div_of_le (mul_pos hv hPmin)
        exact mul_le_mul hV (hp p (mem_inter.mp h).2) hPmin.le (hv.trans_le hV).le
      have hh := div_le_div₀ (by positivity : 0 ≤ 1 / (v * Pmin)) ha
        (by norm_num : (0 : ℝ) < 1 / 2) (hb p (mem_inter.mp h).2)
      apply hh.trans_eq
      ring
    _ = 2 * ((F ∩ P).card : ℝ) / (v * Pmin) := by simp [div_eq_mul_inv]; ring
    _ ≤ _ := div_le_div_of_nonneg_right
      (mul_le_mul_of_nonneg_left
        (by exact_mod_cast card_le_card (inter_subset_left : F ∩ P ⊆ F)) (by norm_num))
      (mul_pos hv hPmin).le

theorem physical_label_law_forbidden_mass_le {G : Type*} {P : G → Finset ℕ}
    (V : G → ℝ) (g : G) (F : Finset (P g)) (hV : 0 < V g)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ p : P g, Pmin ≤ (p.val : ℝ)) :
    (∑ p ∈ F, physicalLabelLaw V g p) ≤ (F.card : ℝ) / (V g * Pmin) := by
  calc
    _ ≤ ∑ _p ∈ F, 1 / (V g * Pmin) :=
      sum_le_sum (fun p _ => physical_label_law_atom_le V g hV hPmin p (hp p))
    _ = _ := by simp [div_eq_mul_inv]

theorem tilted_physical_label_law_forbidden_mass_le {G : Type*} {P : G → Finset ℕ}
    (V : G → ℝ) (g : G) (F : Finset (P g)) (b : P g → ℝ) (hV : 0 < V g)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ p : P g, Pmin ≤ (p.val : ℝ))
    (hb : ∀ p ∈ F, 1 / 2 ≤ b p) :
    (∑ p ∈ F, tiltedPhysicalBirthLaw V g b p) ≤ 2 * (F.card : ℝ) / (V g * Pmin) := by
  calc
    _ ≤ ∑ _p ∈ F, 2 / (V g * Pmin) :=
      sum_le_sum (fun p h => tiltedPhysicalBirthLaw_atom_le V g b hV hPmin p (hp p) (hb p h))
    _ = _ := by simp [div_eq_mul_inv]; ring

end Bounty
end

section

/- Exact normalized product marginals and finite forbidden-label union bounds. -/

open Finset
open scoped Classical

namespace Bounty

theorem finite_forbidden_hits_mass_le {A P : Type*}
    [Fintype A] [DecidableEq A] [Fintype P]
    (μ : P → ℝ) (hμ0 : ∀ p, 0 ≤ μ p) (hμ : ∑ p, μ p = 1)
    (F : Finset P) (a0 : ℝ) (hatom : ∀ p, μ p ≤ a0) :
    (∑ f : A → P, cleanAuxiliaryWeight μ f * (if ∃ a, f a ∈ F then 1 else 0)) ≤
      (Fintype.card A : ℝ) * F.card * a0 := by
  classical
  have he (f : A → P) : (∃ a, f a ∈ F) ↔ ∃ a, ∃ p : F, f a = p.val := by
    constructor
    · rintro ⟨a, ha⟩
      exact ⟨a, ⟨f a, ha⟩, rfl⟩
    · rintro ⟨a, p, hp⟩
      exact ⟨a, hp ▸ p.property⟩
  simp_rw [he]
  simpa only [Fintype.card_coe] using
    clean_auxiliary_hits_mass_le (A := A) μ hμ0 hμ (fun p : F => p.val) a0 hatom

theorem finite_normalized_product_marginal {G : Type*} [Fintype G] [DecidableEq G]
    {X : G → Type*} [∀ g, Fintype (X g)]
    (w : ∀ g, X g → ℝ) (hw : ∀ g, ∑ x, w g x = 1) (g : G) (F : X g → ℝ) :
    (∑ x : ∀ g, X g, (∏ i, w i (x i)) * F (x g)) = ∑ x : X g, w g x * F x := by
  let factors (i : G) (x : X i) : ℝ := w i x * (if h : i = g then F (h ▸ x) else 1)
  have hprod (x : ∀ g, X g) : (∏ i, w i (x i)) * F (x g) = ∏ i, factors i (x i) := by
    simp only [factors, prod_mul_distrib]
    congr 1
    rw [prod_eq_single g]
    · simp
    · intro i _ hig
      simp only [dif_neg hig]
    · simp
  simp_rw [hprod]
  rw [← Fintype.prod_sum factors, prod_eq_single g]
  · simp only [factors, ↓reduceDIte]
  · intro i _ hig
    simpa only [factors, dif_neg hig, mul_one] using hw i
  · simp

theorem finite_product_forbidden_hits_mass_le {G : Type*} [Fintype G] [DecidableEq G]
    {A P : G → Type*} [∀ g, Fintype (A g)] [∀ g, DecidableEq (A g)]
    [∀ g, Fintype (P g)]
    (μ : ∀ g, P g → ℝ) (hμ0 : ∀ g p, 0 ≤ μ g p) (hμ : ∀ g, ∑ p, μ g p = 1)
    (F : ∀ g, Finset (P g)) (a0 : G → ℝ) (hatom : ∀ g p, μ g p ≤ a0 g) :
    (∑ f : ∀ g, A g → P g, (∏ g, ∏ a, μ g (f g a)) *
      (if ∃ g a, f g a ∈ F g then 1 else 0)) ≤
      ∑ g, (Fintype.card (A g) : ℝ) * (F g).card * a0 g := by
  classical
  have hgroup (g : G) : (∑ f : A g → P g, ∏ a, μ g (f a)) = 1 := by
    rw [← Fintype.prod_sum]
    simp only [hμ, prod_const_one]
  calc
    _ ≤ ∑ g, ∑ f : ∀ g, A g → P g, (∏ g, ∏ a, μ g (f g a)) *
        (if ∃ a, f g a ∈ F g then 1 else 0) :=
by
      rw [sum_comm]
      apply sum_le_sum
      intro f _
      have hn : 0 ≤ ∏ g, ∏ a, μ g (f g a) :=
        prod_nonneg (fun g _ => prod_nonneg (fun a _ => hμ0 g (f g a)))
      have hnn : ∀ i ∈ (univ : Finset G),
          0 ≤ (∏ g, ∏ a, μ g (f g a)) * (if ∃ a, f i a ∈ F i then 1 else 0) := by
        intro i _
        exact mul_nonneg hn (by split_ifs <;> norm_num)
      by_cases he : ∃ g a, f g a ∈ F g
      · obtain ⟨g, a, ha⟩ := he
        rw [if_pos ⟨g, a, ha⟩, mul_one]
        have hs := single_le_sum hnn (mem_univ g)
        rw [if_pos ⟨a, ha⟩, mul_one] at hs
        exact hs
      · rw [if_neg he, mul_zero]
        exact sum_nonneg hnn
    _ = ∑ g, ∑ f : A g → P g, (∏ a, μ g (f a)) *
        (if ∃ a, f a ∈ F g then 1 else 0) := by
      apply sum_congr rfl
      intro g _
      have hm := finite_normalized_product_marginal (X := fun g => A g → P g) (fun g f => ∏ a, μ g (f a)) hgroup g
        (fun f => if ∃ a, f a ∈ F g then 1 else 0)
      convert hm using 1
    _ ≤ _ := by
      apply sum_le_sum
      intro g _
      have hh := finite_forbidden_hits_mass_le (A := A g)
        (μ g) (hμ0 g) (hμ g) (F g) (a0 g) (hatom g)
      convert hh using 1 <;> rfl

end Bounty
end

section

/- One-sided rare target events give a square-root Schur gain. All rows
keep their shared fiber. The banned-kernel estimates preserve the original
auxiliary endpoint collision bans; no auxiliary initial-ledger mask is added. -/

open Finset
open scoped Classical

namespace Bounty

theorem repeated_big_kernel_mask {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (m : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → Prop)
    (a : PhysicalAuxLabels P C) (x y : RepeatedBigLists P J ell) :
    repeatedBigKernel V b C ζ (fun x y a => if m x y a then K x y a else 0) a x y =
      if m x y a then repeatedBigKernel V b C ζ K a x y else 0 := by
  by_cases hm : m x y a <;> simp [repeatedBigKernel, hm]

theorem repeated_big_target_mask_row_bound {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (B : ℝ) (hB : 0 ≤ B) (hK : ∀ x y a, ‖K x y a‖ ≤ B)
    (Q : RepeatedBigLists P J ell → Prop) (δ : ℝ)
    (hQ : ∀ x, (∑ y, (if repeatedBigSharedCompatible C x y then
      repeatedBigTargetMass V (fun _ _ => 1) C y else 0) * (if Q y then 1 else 0)) ≤ δ)
    (x : RepeatedBigLists P J ell) :
    (∑ a, ∑ y, ‖repeatedBigKernel V (fun _ _ => 1) C ζ
      (fun x y a => if Q y then K x y a else 0) a x y‖) ≤ B * δ := by
  calc
    _ ≤ ∑ a : PhysicalAuxLabels P C, ∑ y : RepeatedBigLists P J ell,
        physicalAuxMass V C a * B *
          ((if repeatedBigSharedCompatible C x y then
            repeatedBigTargetMass V (fun _ _ => 1) C y else 0) * (if Q y then 1 else 0)) := by
      apply sum_le_sum
      intro a _
      apply sum_le_sum
      intro y _
      rw [repeated_big_kernel_mask V (fun _ _ => 1) C ζ K (fun _ y _ => Q y)]
      by_cases hy : Q y
      · simpa only [if_pos hy, mul_one] using
          repeated_big_untilted_kernel_norm_le V C (fun g => (hV g).le) ζ K B hB hK a x y
      · simp only [if_neg hy, norm_zero, mul_zero, le_refl]
    _ = ∑ a : PhysicalAuxLabels P C, physicalAuxMass V C a * B *
        (∑ y, (if repeatedBigSharedCompatible C x y then
          repeatedBigTargetMass V (fun _ _ => 1) C y else 0) * (if Q y then 1 else 0)) := by
      simp only [mul_sum]
    _ ≤ ∑ a : PhysicalAuxLabels P C, physicalAuxMass V C a * B * δ := by
      apply sum_le_sum
      intro a _
      exact mul_le_mul_of_nonneg_left (hQ x)
        (mul_nonneg (physical_aux_mass_nonneg V C (fun g => (hV g).le) a) hB)
    _ = B * δ := by
      rw [← sum_mul, ← sum_mul, physical_aux_mass_sum V C hV hMass, one_mul]

theorem repeated_big_target_mask_norm {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (B : ℝ) (hB : 0 ≤ B) (hK : ∀ x y a, ‖K x y a‖ ≤ B)
    (Q : RepeatedBigLists P J ell → Prop) (δ : ℝ) (hδ : 0 ≤ δ)
    (hQ : ∀ x, (∑ y, (if repeatedBigSharedCompatible C x y then
      repeatedBigTargetMass V (fun _ _ => 1) C y else 0) * (if Q y then 1 else 0)) ≤ δ)
    (f : RepeatedBigLists P J ell → ℂ) :
    cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
      (repeatedBigRowAction V (fun _ _ => 1) C ζ
        (fun x y a => if Q y then K x y a else 0) f) ≤
      (B * Real.sqrt δ) * cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f := by
  let K' := fun x y a => if Q y then K x y a else 0
  have hK' : ∀ x y a, ‖K' x y a‖ ≤ B := by
    intro x y a
    dsimp only [K']
    split_ifs
    · exact hK x y a
    · simpa using hB
  let E := fun x y => ∑ a, repeatedBigKernel V (fun _ _ => 1) C ζ K' a x y
  have hr (x) : ∑ y, ‖E x y‖ ≤ B * δ := by
    calc
      _ ≤ ∑ y, ∑ a, ‖repeatedBigKernel V (fun _ _ => 1) C ζ K' a x y‖ :=
        sum_le_sum fun y _ => norm_sum_le _ _
      _ = ∑ a, ∑ y, ‖repeatedBigKernel V (fun _ _ => 1) C ζ K' a x y‖ := sum_comm
      _ ≤ _ := repeated_big_target_mask_row_bound V C hV hMass ζ K B hB hK Q δ hQ x
  have hc (y) : ∑ x, repeatedBigActiveMass V (fun _ _ => 1) x * ‖E x y‖ ≤
      B * repeatedBigActiveMass V (fun _ _ => 1) y := by
    calc
      _ ≤ ∑ x, repeatedBigActiveMass V (fun _ _ => 1) x *
          ∑ a, ‖repeatedBigKernel V (fun _ _ => 1) C ζ K' a x y‖ := by
        apply sum_le_sum
        intro x _
        exact mul_le_mul_of_nonneg_left (norm_sum_le _ _)
          (repeated_big_untilted_active_mass_nonneg V (fun g => (hV g).le) x)
      _ = ∑ a, ∑ x, repeatedBigActiveMass V (fun _ _ => 1) x *
          ‖repeatedBigKernel V (fun _ _ => 1) C ζ K' a x y‖ := by
        simp_rw [mul_sum]
        exact sum_comm
      _ ≤ _ := repeated_big_untilted_kernel_column_bound V C hV hMass ζ K' B hB hK' y
  have h := finite_weighted_schur_transition_norm univ
    (repeatedBigActiveMass V (fun _ _ => 1)) (fun _ => 1) E
    (fun x _ => repeated_big_untilted_active_mass_nonneg V (fun g => (hV g).le) x)
    (fun _ _ => zero_lt_one) (mul_nonneg hB hδ) hB
    (fun x _ => by simpa only [mul_one] using hr x)
    (fun y _ => by simpa only [mul_one] using hc y) f
  have hs : Real.sqrt (B * δ * B) = B * Real.sqrt δ := by
    rw [show B * δ * B = B ^ 2 * δ by ring, Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq hB]
  simpa only [hs, cleanActiveNorm, repeatedBigRowAction, E, K'] using h

theorem repeated_big_compatible_mass_balance {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (x y : RepeatedBigLists P J ell) :
    repeatedBigActiveMass V (fun _ _ => 1) x *
      (if repeatedBigSharedCompatible C x y then repeatedBigTargetMass V (fun _ _ => 1) C y else 0) =
    repeatedBigActiveMass V (fun _ _ => 1) y *
      (if repeatedBigSharedCompatible C y x then repeatedBigTargetMass V (fun _ _ => 1) C x else 0) := by
  by_cases h : repeatedBigSharedCompatible C x y
  · rw [if_pos h, if_pos (repeated_big_shared_compatible_symm C h)]
    exact repeated_big_active_target_mass_balance V (fun _ _ => 1) C h
  · have hr : ¬repeatedBigSharedCompatible C y x := fun hh => h (repeated_big_shared_compatible_symm C hh)
    simp only [if_neg h, if_neg hr, mul_zero]

theorem repeated_big_rare_transition_norm {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (E : RepeatedBigLists P J ell → RepeatedBigLists P J ell → ℂ)
    (B : ℝ) (hB : 0 ≤ B)
    (hE : ∀ x y, ‖E x y‖ ≤ B * (if repeatedBigSharedCompatible C x y then
      repeatedBigTargetMass V (fun _ _ => 1) C y else 0))
    (Q : RepeatedBigLists P J ell → Prop) (δ : ℝ) (hδ : 0 ≤ δ)
    (hQ : ∀ x, (∑ y, (if repeatedBigSharedCompatible C x y then
      repeatedBigTargetMass V (fun _ _ => 1) C y else 0) * (if Q y then 1 else 0)) ≤ δ)
    (f : RepeatedBigLists P J ell → ℂ) :
    cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
      (fun x => ∑ y, (if Q y then E x y else 0) * f y) ≤
      (B * Real.sqrt δ) * cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f := by
  let m := fun x y : RepeatedBigLists P J ell => if repeatedBigSharedCompatible C x y then
    repeatedBigTargetMass V (fun _ _ => 1) C y else 0
  let w : RepeatedBigLists P J ell → ℝ := repeatedBigActiveMass V (fun _ _ => 1)
  have hw (x) : 0 ≤ w x := repeated_big_untilted_active_mass_nonneg V (fun g => (hV g).le) x
  have hm (x y) : 0 ≤ m x y := by
    dsimp only [m]
    split_ifs
    · exact repeated_big_untilted_target_mass_nonneg V (fun g => (hV g).le) C y
    · exact le_rfl
  have hb (x y) : ‖if Q y then E x y else 0‖ ≤ B * m x y := by
    split_ifs
    · exact hE x y
    · simpa only [norm_zero] using mul_nonneg hB (hm x y)
  have hr (x) : ∑ y, ‖if Q y then E x y else 0‖ ≤ B * δ := by
    calc
      _ ≤ ∑ y, B * (m x y * (if Q y then 1 else 0)) := by
        apply sum_le_sum
        intro y _
        by_cases h : Q y
        · simpa only [if_pos h, mul_one] using hE x y
        · simp only [if_neg h, norm_zero, mul_zero, le_refl]
      _ = B * ∑ y, m x y * (if Q y then 1 else 0) := (mul_sum _ _ _).symm
      _ ≤ B * δ := mul_le_mul_of_nonneg_left (hQ x) hB
  have hc (y) : ∑ x, w x * ‖if Q y then E x y else 0‖ ≤ B * w y := by
    calc
      _ ≤ ∑ x, w x * (B * m x y) := sum_le_sum fun x _ => mul_le_mul_of_nonneg_left (hb x y) (hw x)
      _ = ∑ x, B * (w y * m y x) := by
        apply sum_congr rfl
        intro x _
        calc
          _ = B * (w x * m x y) := by ring
          _ = _ := congrArg (fun z : ℝ => B * z) (repeated_big_compatible_mass_balance V C x y)
      _ = B * w y := by
        simp only [← mul_assoc, ← mul_sum, m,
          repeated_big_untilted_compatible_target_mass_sum V C hV hMass y, mul_one]
  have h := finite_weighted_schur_transition_norm univ w (fun _ => 1)
    (fun x y => if Q y then E x y else 0) (fun x _ => hw x) (fun _ _ => zero_lt_one)
    (mul_nonneg hB hδ) hB
    (fun x _ => by simpa only [mul_one] using hr x)
    (fun y _ => by simpa only [mul_one] using hc y) f
  have hs : Real.sqrt (B * δ * B) = B * Real.sqrt δ := by
    rw [show B * δ * B = B ^ 2 * δ by ring, Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq hB]
  simpa only [hs, cleanActiveNorm, w] using h

theorem repeated_big_unbanned_transition_norm_le {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (B : ℝ) (_hB : 0 ≤ B) (hK : ∀ x y a, ‖K x y a‖ ≤ B)
    (x y : RepeatedBigLists P J ell) :
    ‖∑ a, repeatedBigUnbannedKernel V (fun _ _ => 1) C ζ K a x y‖ ≤
      B * (if repeatedBigSharedCompatible C x y then
        repeatedBigTargetMass V (fun _ _ => 1) C y else 0) := by
  by_cases h : repeatedBigSharedCompatible C x y
  · rw [if_pos h]
    calc
      _ ≤ ∑ a, ‖repeatedBigUnbannedKernel V (fun _ _ => 1) C ζ K a x y‖ := norm_sum_le _ _
      _ ≤ ∑ a, physicalAuxMass V C a * B * repeatedBigTargetMass V (fun _ _ => 1) C y := by
        apply sum_le_sum
        intro a _
        have ha := physical_aux_mass_nonneg V C (fun g => (hV g).le) a
        have ht := repeated_big_untilted_target_mass_nonneg V (fun g => (hV g).le) C y
        simp only [repeatedBigUnbannedKernel, if_pos h, norm_mul, physical_phase_norm,
          mul_one, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg ha, abs_of_nonneg ht]
        calc
          _ ≤ (physicalAuxMass V C a * repeatedBigTargetMass V (fun _ _ => 1) C y) * B :=
            mul_le_mul_of_nonneg_left (hK x y a) (mul_nonneg ha ht)
          _ = _ := by ring
      _ = _ := by rw [← sum_mul, ← sum_mul, physical_aux_mass_sum V C hV hMass, one_mul]
  · simp only [repeatedBigUnbannedKernel, if_neg h, sum_const_zero, norm_zero, mul_zero, le_refl]

theorem repeated_big_unbanned_target_mask_norm {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (B : ℝ) (hB : 0 ≤ B) (hK : ∀ x y a, ‖K x y a‖ ≤ B)
    (Q : RepeatedBigLists P J ell → Prop) (δ : ℝ) (hδ : 0 ≤ δ)
    (hQ : ∀ x, (∑ y, (if repeatedBigSharedCompatible C x y then
      repeatedBigTargetMass V (fun _ _ => 1) C y else 0) * (if Q y then 1 else 0)) ≤ δ)
    (f : RepeatedBigLists P J ell → ℂ) :
    cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
      (repeatedBigUnbannedRowAction V C ζ (fun x y a => if Q y then K x y a else 0) f) ≤
      (B * Real.sqrt δ) * cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f := by
  have h := repeated_big_rare_transition_norm V C hV hMass
    (fun x y => ∑ a, repeatedBigUnbannedKernel V (fun _ _ => 1) C ζ K a x y)
    B hB (repeated_big_unbanned_transition_norm_le V C hV hMass ζ K B hB hK) Q δ hδ hQ f
  have he : repeatedBigUnbannedRowAction V C ζ (fun x y a => if Q y then K x y a else 0) f =
      (fun x => ∑ y, (if Q y then ∑ a, repeatedBigUnbannedKernel V (fun _ _ => 1) C ζ K a x y else 0) * f y) := by
    funext x
    apply sum_congr rfl
    intro y _
    by_cases hy : Q y <;> simp [repeatedBigUnbannedKernel, hy]
  rw [he]
  exact h

end Bounty
end

section

/- Positive group masses make the bare and memory path coefficients vanish together. -/

open Finset
namespace Bounty

theorem physical_memory_walk_scalar_zero_iff {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (patterns : Finset I) (C : I → G → Finset (Fin J)) (ζ : ℕ → I → ℝ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (edges : ℕ) :
    physicalMemoryWalkScalar V patterns C ζ K a L edges = 0 ↔
      physicalBareWalkScalar V patterns C ζ K a L edges = 0 := by
  rw [physical_memory_walk_scalar_factor]
  have hn : (∏ j ∈ range edges, physicalCompletionMass V (C (a j).2.2.1.val) ell : ℝ) ≠ 0 :=
    ne_of_gt (prod_pos (fun j _ => physical_completion_mass_pos V _ ell hV))
  have hn' : ((∏ j ∈ range edges, physicalCompletionMass V (C (a j).2.2.1.val) ell : ℝ) : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr hn
  exact (mul_eq_zero_iff_left hn').symm

end Bounty
end

section

/- Finite complex summation by parts with interval prefix sums. -/

open Finset

namespace Bounty

theorem complex_sum_Ioc_interval_by_parts (f g : ℕ → ℂ) {m n : ℕ} (hmn : m < n) :
    (∑ i ∈ Ioc m n, f i*g i) =
      f n*(∑ j ∈ Ioc m n, g j)-
      ∑ i ∈ Ioc m (n-1), (f (i+1)-f i)*(∑ j ∈ Ioc m i, g j) := by
  let h := fun j => if m < j then g j else 0
  have hpref (k : ℕ) : (∑ j ∈ range (k+1), h j) = ∑ j ∈ Ioc m k, g j := by
    dsimp only [h]
    rw [← sum_filter]
    apply sum_congr
    · ext j
      simp only [mem_filter, mem_range, Nat.lt_succ_iff, mem_Ioc, and_comm]
    · intro j _
      rfl
  have hh := sum_Ioc_by_parts f h hmn
  simp only [smul_eq_mul, hpref, Ioc_self, sum_empty, mul_zero, sub_zero] at hh
  convert hh using 1
  apply sum_congr rfl
  intro i hi
  simp only [h, if_pos (mem_Ioc.mp hi).1]

theorem norm_complex_sum_Ioc_le_of_interval_prefix (f g : ℕ → ℂ) {m n : ℕ}
    (hmn : m < n) {B : ℝ}
    (hprefix : ∀ i ∈ Icc m n, ‖∑ j ∈ Ioc m i, g j‖ ≤ B) :
    ‖∑ i ∈ Ioc m n, f i*g i‖ ≤
      (‖f n‖+∑ i ∈ Ioc m (n-1), ‖f (i+1)-f i‖)*B := by
  rw [complex_sum_Ioc_interval_by_parts f g hmn]
  calc
    _ ≤ ‖f n*(∑ j ∈ Ioc m n, g j)‖+
        ‖∑ i ∈ Ioc m (n-1), (f (i+1)-f i)*(∑ j ∈ Ioc m i, g j)‖ := norm_sub_le _ _
    _ ≤ ‖f n‖*B+∑ i ∈ Ioc m (n-1), ‖f (i+1)-f i‖*B := by
      apply add_le_add
      · rw [norm_mul]
        exact mul_le_mul_of_nonneg_left (hprefix n (mem_Icc.mpr ⟨hmn.le, le_rfl⟩)) (norm_nonneg _)
      · apply (norm_sum_le _ _).trans
        apply sum_le_sum
        intro i hi
        rw [norm_mul]
        exact mul_le_mul_of_nonneg_left
          (hprefix i (mem_Icc.mpr ⟨(mem_Ioc.mp hi).1.le, (mem_Ioc.mp hi).2.trans (Nat.sub_le _ _)⟩))
          (norm_nonneg _)
    _ = _ := by rw [← sum_mul, add_mul]

end Bounty
end

section

/- Elementary norm and variation estimates for the harmonic Mellin weight. -/

namespace Bounty

noncomputable def harmonicMellinWeight (v t : ℝ) : ℂ :=
  Complex.exp (Complex.I * ((v*Real.log t : ℝ) : ℂ)) / (t : ℂ)

theorem harmonic_mellin_weight_eq_cpow (v : ℝ) {t : ℝ} (ht : 0 < t) :
    harmonicMellinWeight v t = (t : ℂ)^((v : ℂ)*Complex.I-1) := by
  have htC : (t : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr ht.ne'
  rw [Complex.cpow_def_of_ne_zero htC, ← Complex.ofReal_log ht.le]
  have he : (Real.log t : ℂ)*((v : ℂ)*Complex.I-1) =
      Complex.I*((v*Real.log t : ℝ) : ℂ)-(Real.log t : ℂ) := by push_cast; ring
  rw [he, Complex.exp_sub, ← Complex.ofReal_exp, Real.exp_log ht]
  rfl

theorem norm_exp_imaginary_difference (x y : ℝ) :
    ‖Complex.exp (Complex.I*(x : ℂ))-Complex.exp (Complex.I*(y : ℂ))‖ ≤ |x-y| := by
  have heq : Complex.exp (Complex.I*(x : ℂ))-Complex.exp (Complex.I*(y : ℂ)) =
      Complex.exp (Complex.I*(y : ℂ))*(Complex.exp (Complex.I*((x-y : ℝ) : ℂ))-1) := by
    rw [mul_sub, mul_one, ← Complex.exp_add]
    congr 2
    push_cast
    ring
  rw [heq, norm_mul, Complex.norm_exp_I_mul_ofReal, one_mul]
  exact Real.norm_exp_I_mul_ofReal_sub_one_le

theorem norm_harmonic_mellin_weight (v : ℝ) {t : ℝ} (ht : 0 < t) :
    ‖harmonicMellinWeight v t‖ = 1/t := by
  simp only [harmonicMellinWeight, norm_div, Complex.norm_exp_I_mul_ofReal,
    Complex.norm_real, Real.norm_eq_abs, abs_of_pos ht]

theorem harmonic_mellin_weight_variation {v s t : ℝ} (hs : 0 < s) (hst : s ≤ t) :
    ‖harmonicMellinWeight v t-harmonicMellinWeight v s‖ ≤
      (1+|v|)*(t-s)/(s*t) := by
  have ht : 0 < t := hs.trans_le hst
  have hlog0 : 0 ≤ Real.log t-Real.log s := sub_nonneg.mpr (Real.log_le_log hs hst)
  have hlog : Real.log t-Real.log s ≤ (t-s)/s := by
    have h := Real.log_le_sub_one_of_pos (div_pos ht hs)
    rw [Real.log_div ht.ne' hs.ne'] at h
    convert h using 1
    field_simp
  let et := Complex.exp (Complex.I*((v*Real.log t : ℝ) : ℂ))
  let es := Complex.exp (Complex.I*((v*Real.log s : ℝ) : ℂ))
  have hphase : ‖et-es‖ ≤ |v| *(Real.log t-Real.log s) := by
    have h := norm_exp_imaginary_difference (v*Real.log t) (v*Real.log s)
    rw [← mul_sub, abs_mul, abs_of_nonneg hlog0] at h
    exact h
  have heq : harmonicMellinWeight v t-harmonicMellinWeight v s =
      (et-es)/(t : ℂ)+es*((1/t-1/s : ℝ) : ℂ) := by
    dsimp [harmonicMellinWeight, et, es]
    push_cast
    ring
  have hinv : |1/t-1/s| = (t-s)/(s*t) := by
    rw [abs_of_nonpos (sub_nonpos.mpr (one_div_le_one_div_of_le hs hst))]
    field_simp
    ring
  calc
    _ ≤ ‖(et-es)/(t : ℂ)‖+‖es*((1/t-1/s : ℝ) : ℂ)‖ := by
      rw [heq]
      exact norm_add_le _ _
    _ = ‖et-es‖/t+(t-s)/(s*t) := by
      rw [norm_div, norm_mul]
      simp only [es, Complex.norm_exp_I_mul_ofReal, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos ht, one_mul, hinv]
    _ ≤ (|v| *((t-s)/s))/t+(t-s)/(s*t) := by
      exact add_le_add (div_le_div_of_nonneg_right
        (hphase.trans (mul_le_mul_of_nonneg_left hlog (abs_nonneg v))) ht.le) le_rfl
    _ = _ := by ring

theorem harmonic_mellin_weight_variation_lower_scale {v s t Y : ℝ}
    (hY : 0 < Y) (hYs : Y ≤ s) (hst : s ≤ t) :
    ‖harmonicMellinWeight v t-harmonicMellinWeight v s‖ ≤
      (1+|v|)*(t-s)/Y^2 := by
  have hs : 0 < s := hY.trans_le hYs
  apply (harmonic_mellin_weight_variation hs hst).trans
  apply div_le_div_of_nonneg_left (by positivity) (by positivity)
  calc
    Y^2 = Y*Y := pow_two Y
    _ ≤ s*t := mul_le_mul hYs (hYs.trans hst) hY.le hs.le

end Bounty
end

section

/- Exact cancellation against constants controls variation-weighted finite sums. -/

open Finset

namespace Bounty

theorem zero_sum_weighted_variation_bound {ι : Type*} (F : Finset ι) (a f : ι → ℂ)
    (z : ℂ) {K : ℝ} (hzero : (∑ i ∈ F, a i) = 0)
    (hvariation : ∀ i ∈ F, ‖f i-z‖ ≤ K) :
    ‖∑ i ∈ F, a i*f i‖ ≤ K*(∑ i ∈ F, ‖a i‖) := by
  have heq : (∑ i ∈ F, a i*f i) = ∑ i ∈ F, a i*(f i-z) := by
    simp only [mul_sub, sum_sub_distrib, ← sum_mul, hzero, zero_mul, sub_zero]
  rw [heq]
  calc
    _ ≤ ∑ i ∈ F, ‖a i*(f i-z)‖ := norm_sum_le _ _
    _ ≤ ∑ i ∈ F, ‖a i‖*K := by
      apply sum_le_sum
      intro i hi
      rw [norm_mul]
      exact mul_le_mul_of_nonneg_left (hvariation i hi) (norm_nonneg _)
    _ = _ := by rw [← sum_mul, mul_comm]

theorem zero_sum_bounded_weighted_variation {ι : Type*} (F : Finset ι)
    (a f : ι → ℂ) (z : ℂ) {K : ℝ} (hK : 0 ≤ K)
    (hzero : (∑ i ∈ F, a i) = 0) (ha : ∀ i ∈ F, ‖a i‖ ≤ 1)
    (hvariation : ∀ i ∈ F, ‖f i-z‖ ≤ K) :
    ‖∑ i ∈ F, a i*f i‖ ≤ K*(F.card : ℝ) := by
  apply (zero_sum_weighted_variation_bound F a f z hzero hvariation).trans
  apply mul_le_mul_of_nonneg_left _ hK
  simpa only [sum_const, nsmul_eq_mul, mul_one] using
    (sum_le_sum ha : (∑ i ∈ F, ‖a i‖) ≤ ∑ _i ∈ F, (1 : ℝ))

end Bounty
end

section

/- The existing chronological forest bound with separate root and atom costs at every address. -/

open Finset Classical

namespace Bounty

theorem birthForestCausalMass_le_coordinate_costs {n : ℕ} {α : Type*} [Fintype α]
    (code : BirthForestCode n) (w : BirthForestCausalWeights n α)
    (M ε : Fin n → ℝ) (hM : ∀ i, 0 ≤ M i) (hε : ∀ i, 0 ≤ ε i)
    (hw : ∀ i h a, 0 ≤ w i h a)
    (hsum : ∀ i h, ∑ a, w i h a ≤ M i) (hatom : ∀ i h a, w i h a ≤ ε i) :
    birthForestCausalMass code w ≤ ∏ i, match code i with | none => M i | some _ => ε i := by
  induction n with
  | zero => simp [birthForestCausalMass, birthForestCausalAssignmentMass, birthForestAssignmentMass]
  | succ n ih =>
    have hprev := ih (birthForestCodeInit code) (fun i => w i.castSucc)
      (fun i => M i.castSucc) (fun i => ε i.castSucc) (fun i => hM i.castSucc)
      (fun i => hε i.castSucc) (fun i h a => hw i.castSucc h a)
      (fun i h => hsum i.castSucc h) (fun i h a => hatom i.castSucc h a)
    rw [birthForestCausalMass_last, Fin.prod_univ_castSucc]
    cases hc : code (Fin.last n) with
    | none =>
      calc
        _ ≤ ∑ f : Fin n → α,
            birthForestCausalAssignmentMass (birthForestCodeInit code) (fun i => w i.castSucc) f * M (Fin.last n) := by
          apply sum_le_sum
          intro f _
          exact mul_le_mul_of_nonneg_left (hsum _ _)
            (birthForestCausalAssignmentMass_nonneg _ _ (fun i h a => hw i.castSucc h a) f)
        _ = birthForestCausalMass (birthForestCodeInit code) (fun i => w i.castSucc) * M (Fin.last n) :=
          (sum_mul _ _ _).symm
        _ ≤ _ := by
          apply le_trans (mul_le_mul_of_nonneg_right hprev (hM (Fin.last n)))
          apply le_of_eq
          congr 1
          apply prod_congr rfl
          intro i _
          unfold birthForestCodeInit
          cases code i.castSucc <;> rfl
    | some p =>
      calc
        _ ≤ ∑ f : Fin n → α,
            birthForestCausalAssignmentMass (birthForestCodeInit code) (fun i => w i.castSucc) f * ε (Fin.last n) := by
          apply sum_le_sum
          intro f _
          exact mul_le_mul_of_nonneg_left (hatom _ _ _)
            (birthForestCausalAssignmentMass_nonneg _ _ (fun i h a => hw i.castSucc h a) f)
        _ = birthForestCausalMass (birthForestCodeInit code) (fun i => w i.castSucc) * ε (Fin.last n) :=
          (sum_mul _ _ _).symm
        _ ≤ _ := by
          apply le_trans (mul_le_mul_of_nonneg_right hprev (hε (Fin.last n)))
          apply le_of_eq
          congr 1
          apply prod_congr rfl
          intro i _
          unfold birthForestCodeInit
          cases code i.castSucc <;> rfl

end Bounty
end

section

/- External finite coordinates may be permuted separately on each retained
parameter and auxiliary fiber. The auxiliary average is taken after the
permutation, so no number-of-residues loss is incurred. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def finiteExternalFiberAverage {C R Y : Type*} {A : C → Type*}
    [∀ c, Fintype (A c)] (ω : ∀ c, A c → ℝ)
    (T : ∀ c, A c → (Y → ℂ) → Y → ℂ) (τ : ∀ c, A c → R ≃ R)
    (f : C → Y → R → ℂ) (c : C) (y : Y) (r : R) : ℂ :=
  ∑ a, (ω c a : ℂ) * T c a (fun z => f c z (τ c a r)) y

theorem finite_external_fiber_average_energy_le {C R Y : Type*}
    [Fintype R] [Fintype Y] {A : C → Type*} [∀ c, Fintype (A c)]
    (μ : Y → ℝ) (hμ : ∀ y, 0 ≤ μ y)
    (ω : ∀ c, A c → ℝ) (hω : ∀ c a, 0 ≤ ω c a)
    (hωmass : ∀ c, ∑ a, ω c a ≤ 1)
    (T : ∀ c, A c → (Y → ℂ) → Y → ℂ) (τ : ∀ c, A c → R ≃ R)
    (f : C → Y → R → ℂ) {L : ℝ} (hL : 0 ≤ L)
    (hT : ∀ c a r, finiteWeightedEnergy μ (T c a (fun z => f c z r)) ≤
      L * finiteWeightedEnergy μ (fun z => f c z r)) (c : C) :
    (∑ r, finiteWeightedEnergy μ (fun y => finiteExternalFiberAverage ω T τ f c y r)) ≤
      L * ∑ r, finiteWeightedEnergy μ (fun y => f c y r) := by
  calc
    _ ≤ ∑ r, ∑ a, ω c a * finiteWeightedEnergy μ
        (T c a (fun z => f c z (τ c a r))) := by
      apply sum_le_sum
      intro r _
      exact finite_subprobability_average_energy_le (ω c) μ (hω c) (hωmass c) hμ _
    _ ≤ ∑ r, ∑ a, ω c a * (L * finiteWeightedEnergy μ (fun z => f c z (τ c a r))) := by
      apply sum_le_sum
      intro r _
      exact sum_le_sum fun a _ => mul_le_mul_of_nonneg_left (hT c a (τ c a r)) (hω c a)
    _ = (∑ a, ω c a) * (L * ∑ r, finiteWeightedEnergy μ (fun y => f c y r)) := by
      rw [sum_comm]
      simp only [← mul_sum]
      rw [sum_mul]
      apply sum_congr rfl
      intro a _
      rw [Equiv.sum_comp (τ c a) (fun r => finiteWeightedEnergy μ (fun z => f c z r))]
    _ ≤ 1 * (L * ∑ r, finiteWeightedEnergy μ (fun y => f c y r)) := by
      apply mul_le_mul_of_nonneg_right (hωmass c)
      exact mul_nonneg hL (sum_nonneg fun r _ =>
        sum_nonneg fun y _ => mul_nonneg (hμ y) (sq_nonneg _))
    _ = _ := one_mul _

noncomputable def equivExternalFiberAverage {X C Y R : Type*} {A : C → Type*}
    [∀ c, Fintype (A c)] (e : X ≃ C × Y) (ω : ∀ c, A c → ℝ)
    (T : ∀ c, A c → (Y → ℂ) → Y → ℂ) (τ : ∀ c, A c → R ≃ R)
    (f : X → R → ℂ) (x : X) (r : R) : ℂ :=
  finiteExternalFiberAverage ω T τ (fun c y r => f (e.symm (c, y)) r) (e x).1 (e x).2 r

theorem equiv_external_fiber_average_energy_le {X C Y R : Type*}
    [Fintype X] [Fintype C] [Fintype Y] [Fintype R]
    {A : C → Type*} [∀ c, Fintype (A c)]
    (e : X ≃ C × Y) (W : X → ℝ) (κ : C → ℝ) (μ : Y → ℝ)
    (hW : ∀ c y, W (e.symm (c, y)) = κ c * μ y)
    (hκ : ∀ c, 0 ≤ κ c) (hμ : ∀ y, 0 ≤ μ y)
    (ω : ∀ c, A c → ℝ) (hω : ∀ c a, 0 ≤ ω c a)
    (hωmass : ∀ c, ∑ a, ω c a ≤ 1)
    (T : ∀ c, A c → (Y → ℂ) → Y → ℂ) (τ : ∀ c, A c → R ≃ R)
    (f : X → R → ℂ) {L : ℝ} (hL : 0 ≤ L)
    (hT : ∀ c a r, finiteWeightedEnergy μ (T c a (fun y => f (e.symm (c, y)) r)) ≤
      L * finiteWeightedEnergy μ (fun y => f (e.symm (c, y)) r)) :
    (∑ r, finiteWeightedEnergy W (fun x => equivExternalFiberAverage e ω T τ f x r)) ≤
      L * ∑ r, finiteWeightedEnergy W (fun x => f x r) := by
  simp_rw [finite_energy_equiv_fibers e W κ μ hW]
  unfold finiteFiberEnergy equivFiberSlice
  dsimp only [equivExternalFiberAverage]
  simp only [Equiv.apply_symm_apply]
  rw [sum_comm, sum_comm (f := fun r c => κ c * finiteWeightedEnergy μ (fun y => f (e.symm (c,y)) r))]
  simp only [← mul_sum]
  rw [mul_sum]
  apply sum_le_sum
  intro c _
  calc
    _ ≤ κ c * (L * ∑ r, finiteWeightedEnergy μ (fun y => f (e.symm (c,y)) r)) :=
      mul_le_mul_of_nonneg_left
        (finite_external_fiber_average_energy_le μ hμ ω hω hωmass T τ _ hL hT c) (hκ c)
    _ = _ := by ring

end Bounty
end

section

/- Full edge event sums with arbitrary bounded complex coefficients.
Every storage, retrieval and fresh draw remains summed, with both total
memory caps in the event weight. No symmetry of the coefficient is required. -/

open Finset Classical

namespace Bounty

theorem finite_weighted_energy_of_scaled_norm {X : Type*} [Fintype X]
    (w : X → ℝ) (hw : ∀ x, 0 ≤ w x) (H : ℝ) (hH : 0 ≤ H) (K : ℝ)
    (f output majorant : X → ℂ)
    (hdom : ∀ x, ‖output x‖ ≤ ‖(H : ℂ) * majorant x‖)
    (hbase : finiteWeightedEnergy w majorant ≤ K * finiteWeightedEnergy w f) :
    finiteWeightedEnergy w output ≤ H ^ 2 * K * finiteWeightedEnergy w f := by
  calc
    _ ≤ finiteWeightedEnergy w (fun x => (H : ℂ) * majorant x) :=
      finiteWeightedEnergy_le_of_norm_le w hw _ _ hdom
    _ = H ^ 2 * finiteWeightedEnergy w majorant := by
      rw [finiteWeightedEnergy_const_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hH]
    _ ≤ _ := (mul_le_mul_of_nonneg_left hbase (sq_nonneg H)).trans_eq (by ring)

section

variable {G : Type*} [Fintype G] [dG : DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : SharedActiveLabels P S → Type*) [∀ c, Fintype (A c)]
  (Δ D : ∀ c, A c → G → ℤ)
  (ω : ∀ c, A c → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)

noncomputable def fullActiveCoefficientAction
    (Ψ : ∀ x, FullActiveEdgeEvent n S B A Δ D x → ℂ)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) : ℂ :=
  ∑ e : FullActiveEdgeEvent n S B A Δ D x,
    (fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V x e : ℂ) * Ψ x e *
      f (fullActiveEdgeEventTarget n S B A Δ D x e)

theorem full_active_coefficient_norm_le
    (hω : ∀ c a, 0 ≤ ω c a) (hμ : ∀ g p, 0 ≤ μ g p)
    (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ V g)
    (Ψ : ∀ x, FullActiveEdgeEvent n S B A Δ D x → ℂ)
    (H : ℝ) (hH : 0 ≤ H) (hΨ : ∀ x e, ‖Ψ x e‖ ≤ H)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    ‖fullActiveCoefficientAction n S B A Δ D ω μ ρ V Ψ f x‖ ≤
      ‖(H : ℂ) * fullActiveUnrestrictedEdge n S B ω Δ D μ ρ V (fun _ _ _ _ => 1)
        (complexNormEnvelope f) x‖ := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  have hw (e : FullActiveEdgeEvent n S B A Δ D x) :=
    fullActiveEdgeEventWeight_nonneg n S B A Δ D ω μ ρ V hω hμ hρ hV x e
  have he : fullActiveUnrestrictedEdge n S B ω Δ D μ ρ V (fun _ _ _ _ => 1)
        (complexNormEnvelope f) x =
      ((∑ e : FullActiveEdgeEvent n S B A Δ D x,
        fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V x e *
          ‖f (fullActiveEdgeEventTarget n S B A Δ D x e)‖ : ℝ) : ℂ) := by
    rw [full_active_edge_eq_event_sum]
    simp only [complexNormEnvelope, mul_one, Complex.ofReal_sum, Complex.ofReal_mul]
  rw [he, norm_mul]
  simp only [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hH]
  rw [abs_of_nonneg (sum_nonneg fun e _ => mul_nonneg (hw e) (norm_nonneg _))]
  unfold fullActiveCoefficientAction
  calc
    _ ≤ ∑ e : FullActiveEdgeEvent n S B A Δ D x,
        ‖(fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V x e : ℂ) * Ψ x e *
          f (fullActiveEdgeEventTarget n S B A Δ D x e)‖ := norm_sum_le _ _
    _ ≤ ∑ e : FullActiveEdgeEvent n S B A Δ D x,
        fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V x e * H *
          ‖f (fullActiveEdgeEventTarget n S B A Δ D x e)‖ := by
      apply sum_le_sum
      intro e _
      rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hw e)]
      exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (hΨ x e) (hw e)) (norm_nonneg _)
    _ = _ := by
      rw [mul_sum]
      apply sum_congr rfl
      intro e _
      ring

theorem full_active_coefficient_energy_le
    (hω : ∀ c a, 0 ≤ ω c a) (hωmass : ∀ c, ∑ a, ω c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, (S g)ᶜ.card ≤ T)
    (Ψ : ∀ x, FullActiveEdgeEvent n S B A Δ D x → ℂ)
    (H : ℝ) (hH : 0 ≤ H) (hΨ : ∀ x e, ‖Ψ x e‖ ≤ H)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fullActiveCoefficientAction n S B A Δ D ω μ ρ V Ψ f) ≤
      H ^ 2 * unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  have hp := full_active_unrestricted_edge_energy_le n S B ω Δ D μ ρ V hω hωmass
    hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht (fun _ _ _ _ => 1)
    (by intros; simp only [norm_one, le_refl]) (complexNormEnvelope f)
    (complexNormEnvelope_memory_symmetric f hf)
  rw [complexNormEnvelope_energy] at hp
  exact finite_weighted_energy_of_scaled_norm
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productMemoryWeight_nonneg μ _ hμ (fun g z => hμ g z.1)) H hH
    (unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G) f
    (fullActiveCoefficientAction n S B A Δ D ω μ ρ V Ψ f)
    (fullActiveUnrestrictedEdge n S B ω Δ D μ ρ V (fun _ _ _ _ => 1) (complexNormEnvelope f))
    (full_active_coefficient_norm_le n S B A Δ D ω μ ρ V hω hμ hρ0.le
      (fun g => (hvmin.trans_le (hVlo g)).le) Ψ H hH hΨ f) hp

theorem full_active_coefficient_projected_energy_le
    (hω : ∀ c a, 0 ≤ ω c a) (hωmass : ∀ c, ∑ a, ω c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, (S g)ᶜ.card ≤ T)
    (Ψ : ∀ x, FullActiveEdgeEvent n S B A Δ D x → ℂ)
    (H : ℝ) (hH : 0 ≤ H) (hΨ : ∀ x e, ‖Ψ x e‖ ≤ H)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fullActiveAverage (fullActiveCoefficientAction n S B A Δ D ω μ ρ V Ψ (fullActiveAverage f))) ≤
      H ^ 2 * unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  have h1 := fullActiveAverage_energy_le μ (fun g => unrestrictedResidueWeight (μ g))
    hμ (fun g z => hμ g z.1)
    (fullActiveCoefficientAction n S B A Δ D ω μ ρ V Ψ (fullActiveAverage f))
  have h2 := full_active_coefficient_energy_le n S B A Δ D ω μ ρ V hω hωmass
    hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht Ψ H hH hΨ
    (fullActiveAverage f) (fullActiveAverage_symmetric f hf)
  have h3 := fullActiveAverage_energy_le μ (fun g => unrestrictedResidueWeight (μ g))
    hμ (fun g z => hμ g z.1) f
  exact h1.trans (h2.trans (mul_le_mul_of_nonneg_left h3
    (mul_nonneg (sq_nonneg H) (pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _))))

end

end Bounty
end

section

/- Chronological low-rank propagation directly on finite weighted function
norms. The invariant predicate records the admissible suffixes, for example
symmetry under pending-memory permutations. Local bounds and preservation
are separate hypotheses: neither follows merely from a phase having norm one.
No operator-ring structure or linearity is required. -/

open Finset
open scoped Classical

namespace Bounty

theorem finite_row_composition_weighted_norm_le
    {X : ℕ → Type*} [∀ i, Fintype (X i)] {R : Type*} [Fintype R]
    (w : ∀ i, X i → ℝ)
    (row : ∀ i, (X (i + 1) → R → ℂ) → X i → R → ℂ)
    (P : ∀ i, (X i → R → ℂ) → Prop) (c : ℕ → ℝ) (N : ℕ)
    (hc : ∀ i < N, 0 ≤ c i)
    (hpres : ∀ i < N, ∀ f, P (i + 1) f → P i (row i f))
    (hrow : ∀ i < N, ∀ f, P (i + 1) f →
      cleanWeightedNorm (w i) (row i f) ≤ c i * cleanWeightedNorm (w (i + 1)) f)
    (f : X N → R → ℂ) (hf : P N f) :
    P 0 (finiteRowComposition row N f) ∧
      cleanWeightedNorm (w 0) (finiteRowComposition row N f) ≤
        (∏ i ∈ range N, c i) * cleanWeightedNorm (w N) f := by
  induction N with
  | zero => simpa only [finiteRowComposition, range_zero, prod_empty, one_mul] using And.intro hf (le_refl _)
  | succ N ih =>
      have hp := hpres N (Nat.lt_succ_self N) f hf
      have hh := ih (fun i hi => hc i (Nat.lt_succ_of_lt hi))
        (fun i hi => hpres i (Nat.lt_succ_of_lt hi))
        (fun i hi => hrow i (Nat.lt_succ_of_lt hi)) (row N f) hp
      refine ⟨hh.1, hh.2.trans ?_⟩
      rw [prod_range_succ, mul_assoc]
      exact mul_le_mul_of_nonneg_left (hrow N (Nat.lt_succ_self N) f hf)
        (prod_nonneg fun i hi => hc i (Nat.lt_succ_of_lt (mem_range.mp hi)))

/-- Increasing-time order is `G 0 (E 0 (G 1 (... (G N f))))`.
The terminal visit is included, so there are `N + 1` visit costs. -/
theorem weighted_interleaved_composition_le
    {X R : Type*} [Fintype X] [Fintype R]
    (w : X → ℝ) (E G : ℕ → (X → R → ℂ) → X → R → ℂ)
    (P : (X → R → ℂ) → Prop) (c : ℕ → ℝ) (N : ℕ) {M : ℝ}
    (hM : 0 ≤ M) (hc : ∀ i < N, 0 ≤ c i)
    (hEpres : ∀ i < N, ∀ f, P f → P (E i f))
    (hGpres : ∀ i ≤ N, ∀ f, P f → P (G i f))
    (hE : ∀ i < N, ∀ f, P f → cleanWeightedNorm w (E i f) ≤ c i * cleanWeightedNorm w f)
    (hG : ∀ i ≤ N, ∀ f, P f → cleanWeightedNorm w (G i f) ≤ M * cleanWeightedNorm w f)
    (f : X → R → ℂ) (hf : P f) :
    P (finiteRowComposition (S := fun _ => X) (fun i u => G i (E i u)) N (G N f)) ∧
      cleanWeightedNorm w
        (finiteRowComposition (S := fun _ => X) (fun i u => G i (E i u)) N (G N f)) ≤
        M ^ (N + 1) * (∏ i ∈ range N, c i) * cleanWeightedNorm w f := by
  have hp : P (G N f) := hGpres N le_rfl f hf
  have hh := finite_row_composition_weighted_norm_le (X := fun _ => X) (fun _ => w)
    (fun i u => G i (E i u)) (fun _ => P) (fun i => M * c i) N
    (fun i hi => mul_nonneg hM (hc i hi))
    (fun i hi u hu => hGpres i (Nat.le_of_lt hi) _ (hEpres i hi u hu))
    (fun i hi u hu => (hG i (Nat.le_of_lt hi) _ (hEpres i hi u hu)).trans
      (by simpa only [mul_assoc] using mul_le_mul_of_nonneg_left (hE i hi u hu) hM))
    (G N f) hp
  refine ⟨hh.1, hh.2.trans ?_⟩
  calc
    (∏ i ∈ range N, M * c i) * cleanWeightedNorm w (G N f) ≤
        (∏ i ∈ range N, M * c i) * (M * cleanWeightedNorm w f) :=
      mul_le_mul_of_nonneg_left (hG N le_rfl f hf)
        (prod_nonneg fun i hi => mul_nonneg hM (hc i (mem_range.mp hi)))
    _ = _ := by
      rw [prod_mul_distrib]
      simp only [prod_const, card_range, pow_succ]
      ring

/-- The finite exceptional set is deduplicated before the scalar loss is
counted. Invariant suffixes can therefore use restricted local norm bounds. -/
theorem weighted_low_rank_composition_le
    {X R : Type*} [Fintype X] [Fintype R]
    (w : X → ℝ) (E G : ℕ → (X → R → ℂ) → X → R → ℂ)
    (P : (X → R → ℂ) → Prop) {N : ℕ} (bad : Finset (Fin N)) (r : ℕ)
    {q A M : ℝ} (hq : 0 < q) (hA : q ≤ A) (hM : 0 ≤ M)
    (hbad : bad.card ≤ 2 * r)
    (hEpres : ∀ i < N, ∀ f, P f → P (E i f))
    (hGpres : ∀ i ≤ N, ∀ f, P f → P (G i f))
    (hE : ∀ i : Fin N, ∀ f, P f → cleanWeightedNorm w (E i.val f) ≤
      (if i ∈ bad then A else q) * cleanWeightedNorm w f)
    (hG : ∀ i ≤ N, ∀ f, P f → cleanWeightedNorm w (G i f) ≤ M * cleanWeightedNorm w f)
    (f : X → R → ℂ) (hf : P f) :
    P (finiteRowComposition (S := fun _ => X) (fun i u => G i (E i u)) N (G N f)) ∧
      cleanWeightedNorm w
        (finiteRowComposition (S := fun _ => X) (fun i u => G i (E i u)) N (G N f)) ≤
        (M ^ (N + 1) * q ^ N * (A / q) ^ (2 * r)) * cleanWeightedNorm w f := by
  let c : ℕ → ℝ := fun i => if i ∈ bad.image Fin.val then A else q
  have hc : ∀ i < N, 0 ≤ c i := by
    intro i hi
    exact ite_nonneg (hq.le.trans hA) hq.le
  have hcost (i : Fin N) : c i.val = if i ∈ bad then A else q := by
    simp only [c, mem_image, Fin.val_inj, exists_eq_right]
  have hh := weighted_interleaved_composition_le w E G P c N hM hc hEpres hGpres
    (fun i hi u hu => by simpa only [hcost ⟨i, hi⟩] using hE ⟨i, hi⟩ u hu) hG f hf
  have hprod : (∏ i ∈ range N, c i) = q ^ N * (A / q) ^ bad.card := by
    rw [← Fin.prod_univ_eq_prod_range]
    simp_rw [hcost]
    exact edge_scalar_product_eq bad hq.ne'
  have hratio : 1 ≤ A / q := (le_div_iff₀ hq).mpr (by simpa only [one_mul] using hA)
  refine ⟨hh.1, hh.2.trans ?_⟩
  rw [hprod, ← mul_assoc]
  exact mul_le_mul_of_nonneg_right
    (mul_le_mul_of_nonneg_left (pow_le_pow_right₀ hratio hbad)
      (mul_nonneg (pow_nonneg hM _) (pow_nonneg hq.le _))) (Real.sqrt_nonneg _)

/-- The actual image of touched birth addresses loses clean contraction at
most twice the forest rank, including when incident Fourier frequencies
cancel and only a performed-birth condition remains. -/
theorem birth_forest_weighted_composition_le
    {X R : Type*} [Fintype X] [Fintype R]
    (w : X → ℝ) (E G : ℕ → (X → R → ℂ) → X → R → ℂ)
    (P : (X → R → ℂ) → Prop) {n N : ℕ}
    (code : BirthForestCode n) (edgeOf : Fin n → Option (Fin N))
    {q A M : ℝ} (hq : 0 < q) (hA : q ≤ A) (hM : 0 ≤ M)
    (hEpres : ∀ i < N, ∀ f, P f → P (E i f))
    (hGpres : ∀ i ≤ N, ∀ f, P f → P (G i f))
    (hclean : ∀ i : Fin N, i ∉ birthForestAffectedEdges code edgeOf →
      ∀ f, P f → cleanWeightedNorm w (E i.val f) ≤ q * cleanWeightedNorm w f)
    (hbad : ∀ i : Fin N, i ∈ birthForestAffectedEdges code edgeOf →
      ∀ f, P f → cleanWeightedNorm w (E i.val f) ≤ A * cleanWeightedNorm w f)
    (hG : ∀ i ≤ N, ∀ f, P f → cleanWeightedNorm w (G i f) ≤ M * cleanWeightedNorm w f)
    (f : X → R → ℂ) (hf : P f) :
    P (finiteRowComposition (S := fun _ => X) (fun i u => G i (E i u)) N (G N f)) ∧
      cleanWeightedNorm w
        (finiteRowComposition (S := fun _ => X) (fun i u => G i (E i u)) N (G N f)) ≤
        (M ^ (N + 1) * q ^ N * (A / q) ^ (2 * birthForestRank code)) * cleanWeightedNorm w f := by
  apply weighted_low_rank_composition_le w E G P (birthForestAffectedEdges code edgeOf)
    (birthForestRank code) hq hA hM (birthForestAffectedEdges_card_le code edgeOf)
    hEpres hGpres ?_ hG f hf
  intro i u hu
  by_cases hi : i ∈ birthForestAffectedEdges code edgeOf
  · simpa only [if_pos hi] using hbad i hi u hu
  · simpa only [if_neg hi] using hclean i hi u hu

/-- Concrete product-memory interface. Local rows can include slot averages,
total-memory cutoffs, and literal event sums. The terminal test and every
intermediate suffix are symmetric in pending memory; active-slot symmetry
is not added as a hidden requirement. -/
theorem birth_forest_product_memory_composition_le
    {H : Type*} [Fintype H] [DecidableEq H]
    {P Z : H → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    {slots : H → ℕ} {B : ℕ} {R : Type*} [Fintype R]
    (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (E G : ℕ → (ProductBoundedOrderedState P Z slots B → R → ℂ) →
      ProductBoundedOrderedState P Z slots B → R → ℂ)
    {n N : ℕ} (code : BirthForestCode n) (edgeOf : Fin n → Option (Fin N))
    {q A M : ℝ} (hq : 0 < q) (hA : q ≤ A) (hM : 0 ≤ M)
    (hEpres : ∀ i < N, ∀ f, (∀ r, ProductMemorySymmetric (fun x => f x r)) →
      ∀ r, ProductMemorySymmetric (fun x => E i f x r))
    (hGpres : ∀ i ≤ N, ∀ f, (∀ r, ProductMemorySymmetric (fun x => f x r)) →
      ∀ r, ProductMemorySymmetric (fun x => G i f x r))
    (hclean : ∀ i : Fin N, i ∉ birthForestAffectedEdges code edgeOf →
      ∀ f, (∀ r, ProductMemorySymmetric (fun x => f x r)) →
      cleanWeightedNorm (productMemoryWeight μ ν) (E i.val f) ≤
        q * cleanWeightedNorm (productMemoryWeight μ ν) f)
    (hbad : ∀ i : Fin N, i ∈ birthForestAffectedEdges code edgeOf →
      ∀ f, (∀ r, ProductMemorySymmetric (fun x => f x r)) →
      cleanWeightedNorm (productMemoryWeight μ ν) (E i.val f) ≤
        A * cleanWeightedNorm (productMemoryWeight μ ν) f)
    (hG : ∀ i ≤ N, ∀ f, (∀ r, ProductMemorySymmetric (fun x => f x r)) →
      cleanWeightedNorm (productMemoryWeight μ ν) (G i f) ≤
        M * cleanWeightedNorm (productMemoryWeight μ ν) f)
    (f : ProductBoundedOrderedState P Z slots B → R → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun x => f x r)) :
    (∀ r, ProductMemorySymmetric (fun x =>
      finiteRowComposition (S := fun _ => ProductBoundedOrderedState P Z slots B)
        (fun i u => G i (E i u)) N (G N f) x r)) ∧
    cleanWeightedNorm (productMemoryWeight μ ν)
      (finiteRowComposition (S := fun _ => ProductBoundedOrderedState P Z slots B)
        (fun i u => G i (E i u)) N (G N f)) ≤
      (M ^ (N + 1) * q ^ N * (A / q) ^ (2 * birthForestRank code)) *
        cleanWeightedNorm (productMemoryWeight μ ν) f :=
  birth_forest_weighted_composition_le (productMemoryWeight μ ν) E G
    (fun f => ∀ r, ProductMemorySymmetric (fun x => f x r)) code edgeOf hq hA hM
    hEpres hGpres hclean hbad hG f hf

end Bounty
end

section

/- Exact physical history normalization under adjacent common-mark compatibility.
No global residue assignment is supplied; all original local rows and cutoffs remain. -/

open Finset
open scoped Classical
namespace Bounty

section ResiduePath
variable {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell n : ℕ}
  (C : Fin n → G → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations G J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (hcompat : ∀ j : Fin n, ∀ g s t,
    ((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val =
      ((physicalPermuteLabels (τ j) (L j.succ)) g t).val →
    (((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val : ℤ) ∣
      k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))

variable
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (g : G)
  (hk : ∀ j : Fin n, ∀ s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : ↥(P g) → ℝ) (η : Fin (n + 1) → ℝ) (V ρ : ℝ) (hV : V ≠ 0) (cap : ℕ)

noncomputable def physicalGroupAdjacentFiniteStep (i : ℕ) :
    GlobalBirthRawStep (R := fun p : ↥(P g) => ZMod p.val)
      (physicalGroupBareAtomicActivity L g i) (physicalGroupBareAtomicActivity L g (i + 1)) :=
  physicalGroupBareFiniteStep C aux k L a σ τ hlist hP hdis
    hcompat
    g hk β η V ρ hV cap i

theorem physical_group_adjacent_finite_visit_row (j : Fin (n + 1))
    (F : Finset ↥(P g) → FiniteOrderedTuple (Σ p : ↥(P g), ZMod p.val) → ℂ)
    (H : Finset ↥(P g)) (q : FiniteOrderedTuple (Σ p : ↥(P g), ZMod p.val)) :
    globalBirthRawStepRow
      (physicalGroupAdjacentFiniteStep C aux k L a σ τ hcompat hlist hP hdis
        g hk β η V ρ hV cap (2 * j.val)) F H q =
    globalBirthGhostVisitRawRow (fun _ => 0) β (η j) V ρ cap H q.2 F :=
  physical_group_bare_finite_visit_row C aux k L a σ τ hlist hP hdis
    hcompat
    g hk β η V ρ hV cap j F H q

/- The moving displacement is exactly the difference between adjacent
offsets of the same residue path. Both endpoint permutations are retained. -/
include hstep in
theorem physical_group_adjacent_finite_edge_row (j : Fin n)
    (F : Finset ↥(P g) → FiniteOrderedTuple (Σ p : ↥(P g), ZMod p.val) → ℂ)
    (H : Finset ↥(P g)) (q : FiniteOrderedTuple (Σ p : ↥(P g), ZMod p.val)) :
    globalBirthRawStepRow
      (physicalGroupAdjacentFiniteStep C aux k L a σ τ hcompat hlist hP hdis
        g hk β η V ρ hV cap (2 * j.val + 1)) F H q =
    globalBirthEdgeRawRow
      (physicalGroupUnsharedEmbedding (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) g)
      (physicalGroupUnsharedEmbedding (C j) (physicalPermuteLabels (τ j) (L j.succ)) g)
      (physicalGroupPhaseDelta (a j.castSucc) (a j.succ) g) H q.2
      (globalBirthRawHitIndices (physicalGroupPhaseDelta (a j.castSucc) (a j.succ) g) q)
      β ρ V cap F := by
  unfold physicalGroupAdjacentFiniteStep
  rw [physical_group_bare_finite_edge_row, physical_group_permuted_bare_raw_edge_row, ← hstep j]

variable [∀ p : ↥(P g), NeZero p.val]

noncomputable def physicalGroupAdjacentFiniteRawHistory : ℂ :=
  physicalGroupBareFiniteRawHistory C aux k L a σ τ hlist hP hdis
    hcompat
    g hk β η V ρ hV cap

/- The normalized exact trace requires only adjacent common-mark compatibility. -/
theorem physical_group_adjacent_normalized_history_trace :
    ((∏ s : PhysicalSlots J ell, β (L 0 g s) / V : ℝ) : ℂ) *
      physicalGroupAdjacentFiniteRawHistory C aux k L a σ τ hcompat hlist hP hdis
        g hk β η V ρ hV cap =
    ∑ z : Fin (2 * n + 2) → (p : ↥(P g)) → GhostPhaseState (ZMod p.val),
      ((∏ p, ghostPhaseTerminal (physicalGroupPhaseActivity (L (Fin.last n)) g p)
        (z (Fin.last (2 * n + 1)) p) : ℝ) : ℂ) *
      (((∏ p, ghostPhaseRunInitial (physicalGroupPhaseActivity (L 0) g p)
        (β p) V (z 0 p) : ℝ) : ℂ) *
        ∏ j : Fin (2 * n + 1), globalBirthRawStepKernel
          (physicalGroupAdjacentFiniteStep C aux k L a σ τ hcompat hlist hP hdis
            g hk β η V ρ hV cap j.val) (z j.succ) (z j.castSucc)) :=
  physical_group_bare_normalized_history_trace C aux k L a σ τ hlist hP hdis
    hcompat
    g hk β η V ρ hV cap

end ResiduePath
end Bounty
end

section

/- A fresh-or-promoted target cannot reuse a currently active prime. -/

open Finset
open scoped Classical
namespace Bounty

theorem global_birth_target_avoids_active {P : Type*} [DecidableEq P]
    {R : P → Type*} {m t : ℕ} (active H : Finset P)
    (old : Fin m → Σ p, R p) (target : Fin t → P)
    (hborn : active ⊆ H) (hinactive : ∀ j, (old j).1 ∉ active)
    (eligible : Finset (Fin m)) (promotions : Finset (Fin t))
    (e : promotions ↪ eligible) (fresh : UnrestrictedFreshLabels P promotions)
    (hv : unrestrictedEdgeTarget old Sigma.fst promotions e fresh = target ∧
      ∀ s, fresh s ∉ H) :
    ∀ s, target s ∉ active := by
  intro s hs
  have he := congrFun hv.1 s
  by_cases hp : s ∈ promotions
  · have ho : (old (e ⟨s, hp⟩).val).1 = target s := by
      simpa only [unrestrictedEdgeTarget, unrestrictedTargetLabels, dif_pos hp] using he
    exact hinactive _ (ho ▸ hs)
  · have hf : fresh ⟨s, hp⟩ = target s := by
      simpa only [unrestrictedEdgeTarget, unrestrictedTargetLabels, dif_neg hp] using he
    exact hv.2 ⟨s, hp⟩ (hborn (hf ▸ hs))

theorem global_birth_edge_raw_zero_of_active_target {P : Type*}
    [Fintype P] [DecidableEq P] {R : P → Type*} [∀ p, AddGroup (R p)]
    {m t : ℕ} (source target : Fin t ↪ P) (delta : (p : P) → R p)
    (active H : Finset P) (old : Fin m → Σ p, R p)
    (hborn : active ⊆ H) (hinactive : ∀ j, (old j).1 ∉ active)
    (htarget : ∃ s, target s ∈ active)
    (eligible : Finset (Fin m)) (β : P → ℝ) (ρ V : ℝ) (cap : ℕ)
    (G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ) :
    globalBirthEdgeRawRow source target delta H old eligible β ρ V cap G = 0 := by
  unfold globalBirthEdgeRawRow unrestrictedEdgeAction
  apply sum_eq_zero
  intro stores _
  apply sum_eq_zero
  intro promotions _
  apply sum_eq_zero
  intro e _
  apply sum_eq_zero
  intro fresh _
  have hn : ¬ (unrestrictedEdgeTarget old Sigma.fst promotions e fresh = target ∧
      ∀ s, fresh s ∉ H) := by
    intro hv
    obtain ⟨s, hs⟩ := htarget
    exact global_birth_target_avoids_active active H old target hborn hinactive
      eligible promotions e fresh hv s hs
  simp only [if_neg hn, mul_zero, zero_mul]

end Bounty
end

section

/- Exact zero propagation through supported finite rows. -/

namespace Bounty

theorem fin_tensor_row_zero_at (n : ℕ) {S T : Fin n → Type*}
    (row : (g : Fin n) → (T g → ℂ) → S g → ℂ)
    (s : (g : Fin n) → S g)
    (hzero : ∀ g, row g (fun _ => 0) (s g) = 0)
    (g : Fin n) (hkill : ∀ F, row g F (s g) = 0)
    (F : ((g : Fin n) → T g) → ℂ) :
    finTensorRow n row F s = 0 := by
  induction n with
  | zero => exact Fin.elim0 g
  | succ n ih =>
    refine Fin.cases ?_ (fun j => ?_) g hkill
    · intro hk
      exact hk _
    · intro hk
      change row 0 (fun t => finTensorRow n (fun j => row j.succ)
        (fun u => F (Fin.cons t u)) (Fin.tail s)) (s 0) = 0
      have hz (t : T 0) : finTensorRow n (fun j => row j.succ)
          (fun u => F (Fin.cons t u)) (Fin.tail s) = 0 :=
        ih _ _ (fun j => hzero j.succ) j hk _
      simp only [hz]
      exact hzero 0

theorem finite_row_composition_supported_congr {S : ℕ → Type*}
    (row : (i : ℕ) → (S (i + 1) → ℂ) → S i → ℂ)
    (Q : (i : ℕ) → S i → Prop) (n : ℕ)
    (hrow : ∀ i < n, ∀ F G, (∀ t, Q (i + 1) t → F t = G t) →
      ∀ s, Q i s → row i F s = row i G s)
    (F G : S n → ℂ) (hFG : ∀ t, Q n t → F t = G t)
    (s : S 0) (hs : Q 0 s) :
    finiteRowComposition row n F s = finiteRowComposition row n G s := by
  induction n with
  | zero => exact hFG s hs
  | succ n ih =>
    exact ih (fun i hi => hrow i (Nat.lt_trans hi (Nat.lt_succ_self n)))
      _ _ (hrow n (Nat.lt_succ_self n) F G hFG)

theorem finite_row_composition_supported_zero {S : ℕ → Type*}
    (row : (i : ℕ) → (S (i + 1) → ℂ) → S i → ℂ)
    (Q : (i : ℕ) → S i → Prop) (n : ℕ)
    (hrow : ∀ i < n, ∀ F G, (∀ t, Q (i + 1) t → F t = G t) →
      ∀ s, Q i s → row i F s = row i G s)
    (hzero : ∀ i < n, ∀ s, Q i s → row i (fun _ => 0) s = 0)
    (s : S 0) (hs : Q 0 s) :
    finiteRowComposition row n (fun _ => 0) s = 0 := by
  induction n with
  | zero => rfl
  | succ n ih =>
    change finiteRowComposition row n (row n (fun _ => 0)) s = 0
    rw [finite_row_composition_supported_congr row Q n
      (fun i hi => hrow i (Nat.lt_trans hi (Nat.lt_succ_self n)))
      _ (fun _ => 0) (hzero n (Nat.lt_succ_self n)) s hs]
    exact ih (fun i hi => hrow i (Nat.lt_trans hi (Nat.lt_succ_self n)))
      (fun i hi => hzero i (Nat.lt_trans hi (Nat.lt_succ_self n)))

theorem finite_row_composition_supported_zero_at {S : ℕ → Type*}
    (row : (i : ℕ) → (S (i + 1) → ℂ) → S i → ℂ)
    (Q : (i : ℕ) → S i → Prop) (n : ℕ)
    (hrow : ∀ i < n, ∀ F G, (∀ t, Q (i + 1) t → F t = G t) →
      ∀ s, Q i s → row i F s = row i G s)
    (hzero : ∀ i < n, ∀ s, Q i s → row i (fun _ => 0) s = 0)
    (i : ℕ) (hi : i < n) (hkill : ∀ F s, Q i s → row i F s = 0)
    (F : S n → ℂ) (s : S 0) (hs : Q 0 s) :
    finiteRowComposition row n F s = 0 := by
  induction n with
  | zero => omega
  | succ n ih =>
    by_cases hin : i < n
    · exact ih (fun j hj => hrow j (Nat.lt_trans hj (Nat.lt_succ_self n)))
        (fun j hj => hzero j (Nat.lt_trans hj (Nat.lt_succ_self n))) hin (row n F)
    · have he : i = n := by omega
      subst i
      change finiteRowComposition row n (row n F) s = 0
      rw [finite_row_composition_supported_congr row Q n
        (fun j hj => hrow j (Nat.lt_trans hj (Nat.lt_succ_self n)))
        _ (fun _ => 0) (hkill F) s hs]
      exact finite_row_composition_supported_zero row Q n
        (fun j hj => hrow j (Nat.lt_trans hj (Nat.lt_succ_self n)))
        (fun j hj => hzero j (Nat.lt_trans hj (Nat.lt_succ_self n))) s hs

end Bounty
end

