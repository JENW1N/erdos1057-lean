theorem finite_group_flatten_probe_tail {G : Type*} [Fintype G] [DecidableEq G]
    {I X : G → Type*} [∀ g, DecidableEq (I g)] [∀ g, Fintype (X g)]
    (μ : ∀ g, X g → ℝ) (A B : ∀ g, Finset (I g))
    (hAB : ∀ g, Disjoint (A g) (B g)) (s : Finset G)
    (f : (∀ g, I g → X g) → ℂ) :
    finiteGroupFlattenFunction
      (finiteCoordinateFinsetAction (fun g (v : (I g → X g) → ℂ) => finiteCoordinateComponent (fun _ : I g => μ g)
        ∅ (B g).toList v) sᶜ
        (finiteCoordinateFinsetAction (fun g (v : (I g → X g) → ℂ) => finiteCoordinateComponent (fun _ : I g => μ g)
          (A g) (A g ∪ B g).toList v) s f)) =
      finiteCoordinateComponent (fun a : Sigma I => μ a.1) (s.sigma A) (s.sigma A).toList
        (finiteCoordinateComponent (fun a : Sigma I => μ a.1) ∅ (univ.sigma B).toList
          (finiteGroupFlattenFunction f)) := by
  have hin := finite_group_flatten_finset_action μ (s.sigma A) A (fun g => A g ∪ B g) s
    (fun g hg i _ => by simp only [mem_sigma, hg, true_and]) f
  have hout := finite_group_flatten_finset_action μ ∅ (fun g => (∅ : Finset (I g))) B sᶜ
    (fun g _ i _ => by simp)
    (finiteCoordinateFinsetAction (fun g (v : (I g → X g) → ℂ) => finiteCoordinateComponent (fun _ : I g => μ g)
      (A g) (A g ∪ B g).toList v) s f)
  rw [← hout, ← hin]
  have houter (v : (∀ a : Sigma I, X a.1) → ℂ) :
      finiteCoordinateComponent (fun a : Sigma I => μ a.1) ∅ (sᶜ.sigma B).toList v =
        finiteCoordinateComponent (fun a : Sigma I => μ a.1) (s.sigma A) (sᶜ.sigma B).toList v := by
    apply finite_coordinate_component_congr
    intro a ha
    have hnot : a ∉ s.sigma A := by
      intro h
      exact (mem_compl.mp (mem_sigma.mp (mem_toList.mp ha)).1) (mem_sigma.mp h).1
    simp [hnot]
  rw [houter, ← finite_coordinate_component_append]
  rw [finite_coordinate_component_perm (fun a : Sigma I => μ a.1) (s.sigma A)
    (finite_disjoint_toList_append_perm (sᶜ.sigma B) (s.sigma (fun g => A g ∪ B g))
      (finite_sigma_outside_inside_disjoint s A B))]
  rw [finite_sigma_outside_inside_union]
  exact (finite_probe_after_tail_component (fun a : Sigma I => μ a.1)
    (s.sigma A) (univ.sigma B) (finite_sigma_probe_tail_disjoint s A B hAB)
      (finiteGroupFlattenFunction f)).symm
end

