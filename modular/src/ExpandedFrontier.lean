/- Polynomial atoms for the actual candidate pools and original mapped slots. -/

open Finset Filter
open scoped Classical
namespace Bounty

theorem exists_candidate_subset_atom_inputs {c : ℝ} (hc : 0 < c) (J : ℕ) :
    ∃ κ : ℝ, 0 ≤ κ ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (S : Finset ℕ), S ⊆ candidatePIndices c L →
      let P := fun g : S => candidatePBand (c*L) g.val
      let V := fun g : S => ∑ p ∈ P g, 1/(p : ℝ)
      (∀ g, 0 < V g) ∧ ∀ (ell : ℕ) (probes : S → Finset (Fin J)) (r : Finset S)
        (A : Finset (RepeatedBigFlatIndex S J ell)),
        A ⊆ r.sigma (repeatedBigPrimeProbeSlots probes) → ∀ n : ℕ,
          (∑ a ∈ univ.filter (fun a : (∀ i : A, P i.val.1) => (∏ i, (a i).val) = n),
            finiteProductWeight (fun i : A => physicalLabelLaw V i.val.1) a) ≤ L^κ/(n : ℝ) := by
  obtain ⟨v, W, hv, _, hpool⟩ := exists_candidate_P_pool_bounds hc
  let D : ℝ := 2/(5*Real.log 2)
  let κ := D*Real.log (primeFiberFactorBound v J)
  refine ⟨κ, mul_nonneg (by dsimp [D]; positivity)
    (Real.log_nonneg (one_le_primeFiberFactorBound v J)), ?_⟩
  filter_upwards [hpool] with L hp
  intro S hS P V
  have hV (g : S) : v ≤ V g := (hp.2.2.2.2.2 g.val (hS g.property)).1
  refine ⟨fun g => hv.trans_le (hV g), ?_⟩
  intro ell probes r A hA n
  have hprime : ∀ g p, p ∈ P g → p.Prime :=
    fun g p hpg => ((hp.2.2.2.2.2 g.val (hS g.property)).2.2 p hpg).1
  have hdisj : Pairwise (fun g h : S => Disjoint (P g) (P h)) := by
    intro g h hgh
    exact hp.2.2.2.2.1 (fun he => hgh (Subtype.ext he))
  have hcard : (Fintype.card S : ℝ) ≤ D*Real.log L := by
    simpa only [Fintype.card_coe] using
      (Nat.cast_le.mpr (card_le_card hS) : (S.card : ℝ) ≤ (candidatePIndices c L).card).trans hp.2.2.2.1
  exact prime_subset_physical_atom_rpow P V hprime hdisj r
    (repeatedBigPrimeProbeSlots probes) J hv (zero_lt_one.trans_le hp.1) hV
    (fun g => by simpa only [repeatedBigPrimeProbeSlots, card_map, Fintype.card_fin] using card_le_univ (probes g))
    hcard A hA n

end Bounty
end

