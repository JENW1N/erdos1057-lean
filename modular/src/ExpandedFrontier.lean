/- Exact full-P and active-slot separation of the finite-window Mellin integrand. -/

open Finset Filter MeasureTheory Real

namespace Bounty

noncomputable def candidateFiniteCoarseMellinTest (L E : ℝ) (S : Finset ℕ) (ν : ℝ) (F : ℕ → ℕ → ℂ) : ℕ → ℕ → ℂ :=
  candidateBoxFiniteTest L E S
    (fun u => (u : ℂ)^(((2*Real.pi*ν : ℝ) : ℂ)*Complex.I) * ∑ m ∈ (2*u+1).divisors, F u m)

noncomputable def candidateFiniteMixedMellinIntegrand (c L q : ℝ) (r jStar : ℕ)
    (E B R : ℝ) (S : Finset ℕ) (F : ℕ → ℕ → ℂ) (ν : ℝ) : ℂ :=
  (exp L : ℂ)^(-((2*Real.pi*ν : ℝ) : ℂ)*Complex.I) * typeIIWindowFourier (L^B) ν *
    ∑ take ∈ (univ : Finset (Fin ((candidateQIndices c L).card*r) → Bool)).filter
      (fun take => ∀ i, candidateAllocationActive c L r jStar i = false → take i = false),
      ∫ ξ, candidateRetainedAllocationIntegrand c L q r jStar (log E)
        (candidateSmallPSet c L (R*exp L+1)) take (candidateFiniteCoarseMellinTest L E S ν F) ξ
        ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) L

theorem eventually_candidate_finite_mixed_mellin_eq {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ) (E B R : ℝ) (S : Finset ℕ) (F : ℕ → ℕ → ℂ),
      (∀ u ∈ S, 0 < u ∧ (u : ℝ) ≤ R*exp L) → ∀ ν : ℝ,
      candidateFiniteMellinIntegrand c L q r jStar E B S F ν =
        candidateFiniteMixedMellinIntegrand c L q r jStar E B R S F ν := by
  filter_upwards [eventually_candidate_box_finite_retained_integrals hc] with L hL
  intro q r jStar E B R S F hS ν
  unfold candidateFiniteMellinIntegrand candidateFiniteMixedMellinIntegrand candidateFiniteCoarseMellinTest
  rw [finite_window_mellin_integrand_separated]
  congr 1
  calc
    _ = ∑ u ∈ S, candidateBoxRangeCoefficient c L q r jStar E L u *
        ((u : ℂ)^(((2*Real.pi*ν : ℝ) : ℂ)*Complex.I) * ∑ m ∈ (2*u+1).divisors, F u m) := by
      apply sum_congr rfl
      intro u hu
      exact mul_assoc _ _ _
    _ = _ := hL q r jStar E L (R*exp L) (S)
      (fun u => (u : ℂ)^(((2*Real.pi*ν : ℝ) : ℂ)*Complex.I) * ∑ m ∈ (2*u+1).divisors, F u m)
      hS

theorem eventually_candidate_finite_mixed_mellin_integrable {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ) (E B R : ℝ) (S : Finset ℕ) (F : ℕ → ℕ → ℂ),
      (∀ u ∈ S, 0 < u ∧ (u : ℝ) ≤ R*exp L) →
      Integrable (candidateFiniteMixedMellinIntegrand c L q r jStar E B R S F) := by
  filter_upwards [eventually_candidate_finite_mixed_mellin_eq hc] with L hL
  intro q r jStar E B R S F hS
  exact (candidate_finite_mellin_integrable c L q r jStar E B S F (fun u hu => (hS u hu).1)).congr
    (Filter.Eventually.of_forall (hL q r jStar E B R S F hS))

