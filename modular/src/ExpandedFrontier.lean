  refine IntervalIntegrable.continuousOn_mul ?_ h_cont
  rw [intervalIntegrable_iff']
  apply MeasureTheory.Measure.integrableOn_of_bounded (by simp) (by exact (RCLike.ofRealCLM (K := 𝕜)).continuous.comp_aestronglyMeasurable aestronglyMeasurable_B1) (M := 1 / 2)
  filter_upwards [self_mem_ae_restrict (by measurability)] with x hx
  rw [Set.uIcc_of_le hab, Set.mem_Icc] at hx
  norm_cast
  exact abs_B1_le_half (by linarith)

lemma integral_deriv_mul_floor_add_one (ha : 0 ≤ a) (hab : a ≤ b)
    (hf_diff : ∀ t ∈ Set.Icc a b, DifferentiableAt ℝ f t) (h_cont : ContinuousOn (deriv f) [[a, b]]) :
    ∫ t in a..b, deriv f t * (⌊t⌋₊ + 1) = (b + 1 / 2) * f b - (a + 1 / 2) * f a - (∫ t in a..b, f t) - ∫ t in a..b, deriv f t * B1 t := by
  calc
  _ = ∫ t in a..b, (deriv f t * (t + 1 / 2) -deriv f t * B1 t) := by
    congr
    ext
    simp only [B1]
    push_cast
    ring
  _ = (∫ t in a..b, deriv f t * (t + 1 / 2)) - ∫ t in a..b, deriv f t * B1 t := by
    exact intervalIntegral.integral_sub (ContinuousOn.intervalIntegrable (by fun_prop)) (intervalIntegrable_deriv_mul_B1 ha hab h_cont)
  _ = _ := by
    conv => lhs; arg 1; arg 1; ext; rw [mul_comm]
    rw [integral_deriv_mul_add_const _ hab h_cont.intervalIntegrable hf_diff]

theorem sum_eq_integral_add_integral_deriv (ha : 0 ≤ a) (hab : a ≤ b)
    (hf_diff : ∀ t ∈ Set.Icc a b, DifferentiableAt ℝ f t)
    (h_cont : ContinuousOn (deriv f) [[a, b]]) :
    ∑ k ∈ Ioc ⌊a⌋₊ ⌊b⌋₊, f k =
      f a * B1 a - f b * B1 b + (∫ t in a..b, f t) + ∫ t in a..b, deriv f t * B1 t  := by
  have := sum_mul_eq_sub_sub_integral_mul (fun _ ↦ 1) ha hab hf_diff (Set.uIcc_of_le hab ▸ h_cont).integrableOn_Icc
  simp only [mul_one, sum_const, Nat.card_Icc, tsub_zero, nsmul_eq_mul, Nat.cast_add,
    Nat.cast_one] at this
  rw [this, ← intervalIntegral.integral_of_le hab]
  rw [integral_deriv_mul_floor_add_one ha hab hf_diff h_cont]
  unfold B1
  push_cast
  ring
end

section

/- A stretched exponential in log x is smaller than every inverse log power. -/

open Filter Asymptotics

namespace Bounty

theorem ordinary_stretched_exp_log_isLittleO {c d : ℝ}
    (hc : 0 < c) (hd : 0 < d) (B : ℝ) :
    (fun x : ℝ => Real.exp (-c * (Real.log x)^d)) =o[atTop]
      (fun x : ℝ => (Real.log x)^(-B)) := by
  have h := (isLittleO_exp_neg_mul_rpow_atTop hc (-B/d)).comp_tendsto
    ((tendsto_rpow_atTop hd).comp Real.tendsto_log_atTop)
  refine h.congr' (Eventually.of_forall fun _ => rfl) ?_
  filter_upwards [eventually_ge_atTop (1 : ℝ)] with x hx
  dsimp only [Function.comp_def]
  rw [← Real.rpow_mul (Real.log_nonneg hx)]
  congr 1
  field_simp [hd.ne']

end Bounty
end

section

/- Exact ordered-prime product fibers, and factorial normalization with or without repetitions. -/

open Finset

namespace Bounty

noncomputable def orderedPrimeProductTuples (P : Finset ℕ) (k n : ℕ) :
    Finset (Fin k → ℕ) := by
  classical
  exact (Fintype.piFinset (fun _ : Fin k => P)).filter (fun x => (∏ i, x i) = n)

theorem mem_ordered_prime_product_tuples {P : Finset ℕ} {k n : ℕ} {x : Fin k → ℕ} :
    x ∈ orderedPrimeProductTuples P k n ↔ (∀ i, x i ∈ P) ∧ (∏ i, x i) = n := by
  classical
  simp only [orderedPrimeProductTuples, mem_filter, Fintype.mem_piFinset]

theorem ordered_prime_tuple_perm_factors {P : Finset ℕ} (hP : ∀ p ∈ P, p.Prime)
    {k n : ℕ} (hn : n ≠ 0) {x : Fin k → ℕ}
    (hx : x ∈ orderedPrimeProductTuples P k n) :
    (List.ofFn x).Perm n.primeFactorsList := by
  obtain ⟨hxP, hxprod⟩ := mem_ordered_prime_product_tuples.mp hx
  apply perm_of_prod_eq_prod
  · simpa only [List.prod_ofFn, Nat.prod_primeFactorsList hn] using hxprod
  · exact List.forall_mem_ofFn_iff.mpr (fun i => (hP _ (hxP i)).prime)
  · intro p hp
    exact (Nat.prime_of_mem_primeFactorsList hp).prime

theorem ordered_prime_tuple_lists_eq_permutations {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {n : ℕ} (hn : n ≠ 0)
    (hpool : n.primeFactors ⊆ P) :
    (orderedPrimeProductTuples P n.primeFactorsList.length n).image List.ofFn =
      n.primeFactorsList.permutations.toFinset := by
  classical
  ext l
  constructor
  · intro hl
    obtain ⟨x, hx, rfl⟩ := mem_image.mp hl
    exact List.mem_toFinset.mpr (List.mem_permutations.mpr
      (ordered_prime_tuple_perm_factors hP hn hx))
  · intro hl
    have hperm := List.mem_permutations.mp (List.mem_toFinset.mp hl)
    obtain ⟨x, hx⟩ : ∃ x : Fin n.primeFactorsList.length → ℕ, List.ofFn x = l := by
      rw [← hperm.length_eq]
      exact ⟨l.get, List.ofFn_get l⟩
    apply mem_image.mpr
    refine ⟨x, mem_ordered_prime_product_tuples.mpr ⟨?_, ?_⟩, hx⟩
    · intro i
      apply hpool
      apply Nat.mem_primeFactors_iff_mem_primeFactorsList.mpr
      apply hperm.mem_iff.mp
      rw [← hx]
      exact List.mem_ofFn.mpr ⟨i, rfl⟩
    · rw [← List.prod_ofFn, hx, hperm.prod_eq, Nat.prod_primeFactorsList hn]

theorem squarefree_factor_permutations_card {n : ℕ} (hn : Squarefree n) :
    n.primeFactorsList.permutations.toFinset.card = n.primeFactorsList.length.factorial := by
  rw [List.toFinset_card_of_nodup
    (List.nodup_permutations _ ((Nat.squarefree_iff_nodup_primeFactorsList hn.ne_zero).mp hn)),
    List.length_permutations]

theorem ordered_prime_product_tuples_card_squarefree {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {n : ℕ} (hn : Squarefree n)
    (hpool : n.primeFactors ⊆ P) :
    (orderedPrimeProductTuples P n.primeFactorsList.length n).card =
      n.primeFactorsList.length.factorial := by
  rw [← card_image_of_injective _ List.ofFn_injective,
    ordered_prime_tuple_lists_eq_permutations hP hn.ne_zero hpool,
    squarefree_factor_permutations_card hn]

theorem ordered_prime_product_tuples_card_le {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (k n : ℕ) :
    (orderedPrimeProductTuples P k n).card ≤ k.factorial := by
  classical
  by_cases hF : (orderedPrimeProductTuples P k n).Nonempty
  · obtain ⟨x, hx⟩ := hF
    have hn : n ≠ 0 := by
      rw [← (mem_ordered_prime_product_tuples.mp hx).2]
      exact prod_ne_zero_iff.mpr (fun i _ => (hP _ ((mem_ordered_prime_product_tuples.mp hx).1 i)).ne_zero)
    have hsub : (orderedPrimeProductTuples P k n).image List.ofFn ⊆
        (List.ofFn x).permutations.toFinset := by
      intro l hl
      obtain ⟨y, hy, rfl⟩ := mem_image.mp hl
      exact List.mem_toFinset.mpr (List.mem_permutations.mpr
        ((ordered_prime_tuple_perm_factors hP hn hy).trans
          (ordered_prime_tuple_perm_factors hP hn hx).symm))
    calc
      _ = ((orderedPrimeProductTuples P k n).image List.ofFn).card :=
        (card_image_of_injective _ List.ofFn_injective).symm
      _ ≤ (List.ofFn x).permutations.toFinset.card := card_le_card hsub
      _ ≤ (List.ofFn x).permutations.length := List.toFinset_card_le _
      _ = k.factorial := by rw [List.length_permutations, List.length_ofFn]
  · rw [not_nonempty_iff_eq_empty.mp hF, card_empty]
    exact Nat.zero_le _

theorem ordered_prime_product_tuples_normalized_le_one {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (k n : ℕ) :
    ((orderedPrimeProductTuples P k n).card : ℝ) / (k.factorial : ℝ) ≤ 1 := by
  apply (div_le_one (Nat.cast_pos.mpr (Nat.factorial_pos k))).mpr
  exact_mod_cast ordered_prime_product_tuples_card_le hP k n

theorem ordered_prime_product_tuples_normalized_squarefree {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) {n : ℕ} (hn : Squarefree n)
    (hpool : n.primeFactors ⊆ P) :
    ((orderedPrimeProductTuples P n.primeFactorsList.length n).card : ℝ) /
      (n.primeFactorsList.length.factorial : ℝ) = 1 := by
  rw [ordered_prime_product_tuples_card_squarefree hP hn hpool]
  exact div_self (Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _))

theorem ordered_prime_tuple_weighted_fiber_sum (P : Finset ℕ) (k : ℕ)
    (S : Finset ℕ) (w : ℕ → ℝ) :
    (∑ x ∈ (Fintype.piFinset (fun _ : Fin k => P)).filter (fun x => (∏ i, x i) ∈ S),
      w (∏ i, x i) / (k.factorial : ℝ)) =
      ∑ n ∈ S, ((orderedPrimeProductTuples P k n).card : ℝ) * w n / (k.factorial : ℝ) := by
  classical
  rw [← sum_fiberwise_eq_sum_filter' (Fintype.piFinset (fun _ : Fin k => P)) S
    (fun x => ∏ i, x i) (fun n => w n / (k.factorial : ℝ))]
  apply sum_congr rfl
  intro n hn
  simp only [orderedPrimeProductTuples, sum_const, nsmul_eq_mul, mul_div_assoc]

theorem ordered_prime_tuple_weighted_sum_le {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (k : ℕ) (S : Finset ℕ) (w : ℕ → ℝ)
    (hw : ∀ n ∈ S, 0 ≤ w n) :
    (∑ x ∈ (Fintype.piFinset (fun _ : Fin k => P)).filter (fun x => (∏ i, x i) ∈ S),
      w (∏ i, x i) / (k.factorial : ℝ)) ≤ ∑ n ∈ S, w n := by
  rw [ordered_prime_tuple_weighted_fiber_sum]
  apply sum_le_sum
  intro n hn
  have h := mul_le_mul_of_nonneg_right
    (ordered_prime_product_tuples_normalized_le_one hP k n) (hw n hn)
  calc
    _ = (((orderedPrimeProductTuples P k n).card : ℝ) / (k.factorial : ℝ)) * w n := by ring
    _ ≤ 1 * w n := h
    _ = w n := one_mul _

theorem ordered_prime_tuple_weighted_sum_squarefree {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (k : ℕ) (S : Finset ℕ) (w : ℕ → ℝ)
    (hS : ∀ n ∈ S, Squarefree n ∧ n.primeFactors ⊆ P ∧ n.primeFactorsList.length = k) :
    (∑ x ∈ (Fintype.piFinset (fun _ : Fin k => P)).filter (fun x => (∏ i, x i) ∈ S),
      w (∏ i, x i) / (k.factorial : ℝ)) = ∑ n ∈ S, w n := by
  rw [ordered_prime_tuple_weighted_fiber_sum]
  apply sum_congr rfl
  intro n hn
  obtain ⟨hnsq, hnP, hnk⟩ := hS n hn
  have hc : (orderedPrimeProductTuples P k n).card = k.factorial := by
    rw [← hnk]
    exact ordered_prime_product_tuples_card_squarefree hP hnsq hnP
  rw [hc]
  have hk0 : (k.factorial : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
  field_simp

theorem ordered_prime_tuple_count_squarefree {P : Finset ℕ}
    (hP : ∀ p ∈ P, p.Prime) (k : ℕ) (S : Finset ℕ)
    (hS : ∀ n ∈ S, Squarefree n ∧ n.primeFactors ⊆ P ∧ n.primeFactorsList.length = k) :
    (((Fintype.piFinset (fun _ : Fin k => P)).filter (fun x => (∏ i, x i) ∈ S)).card : ℝ) /
      (k.factorial : ℝ) = (S.card : ℝ) := by
  have h := ordered_prime_tuple_weighted_sum_squarefree hP k S (fun _ => 1) hS
  simpa only [sum_const, nsmul_eq_mul, mul_one, mul_one_div] using h

theorem rough_band_prime_factors_subset {A B z : ℝ} (hB : 0 ≤ B) (hz : 0 ≤ z)
    {n : ℕ} (hn : n ∈ roughBand A B z) : n.primeFactors ⊆ primeBand z B := by
  classical
  intro p hp
  apply (mem_primeBand_iff hz hB p).mpr
  refine ⟨Nat.prime_of_mem_primeFactors hp, (mem_filter.mp hn).2 p hp, ?_⟩
  have hnB : (n : ℝ) ≤ B :=
    (Nat.cast_le.mpr (mem_Ioc.mp (mem_filter.mp hn).1).2).trans (Nat.floor_le hB)
  exact (Nat.cast_le.mpr (Nat.le_of_mem_primeFactors hp)).trans hnB

theorem rough_band_squarefree_tuple_count {A B z : ℝ} (hB : 0 ≤ B) (hz : 0 ≤ z)
    (k : ℕ) :
    let S := (roughBand A B z).filter (fun n => Squarefree n ∧ n.primeFactorsList.length = k)
    (((Fintype.piFinset (fun _ : Fin k => primeBand z B)).filter
      (fun x => (∏ i, x i) ∈ S)).card : ℝ) / (k.factorial : ℝ) = (S.card : ℝ) := by
  classical
  dsimp only
  apply ordered_prime_tuple_count_squarefree
  · intro p hp
    exact ((mem_primeBand_iff hz hB p).mp hp).1
  · intro n hn
    obtain ⟨hnR, hnsq, hnk⟩ := mem_filter.mp hn
    exact ⟨hnsq, rough_band_prime_factors_subset hB hz hnR, hnk⟩

end Bounty



end

section

/- Finite-depth Buchstab densities and their stable integral recursion. -/

open Filter
open scoped Topology

namespace Bounty

noncomputable def buchstabDepthDensity : ℕ → ℝ → ℝ → ℝ
  | 0, _, w => 1/w
  | n+1, γ, w => 1/w + ∫ α in γ..max γ (w/2), buchstabDepthDensity n α (w-α)/α

theorem buchstab_depth_density_step_eq {γ w : ℝ} (hγ : 0 < γ) (n : ℕ)
    (hw : w ≤ ((n : ℝ)+2)*γ) :
    buchstabDepthDensity (n+1) γ w = buchstabDepthDensity n γ w := by
  induction n generalizing γ w with
  | zero =>
    have hhalf : w/2 ≤ γ := by norm_num at hw; linarith
    simp only [buchstabDepthDensity, max_eq_left hhalf, intervalIntegral.integral_same, add_zero]
  | succ n ih =>
    by_cases hhalf : w/2 ≤ γ
    · simp only [buchstabDepthDensity, max_eq_left hhalf, intervalIntegral.integral_same, add_zero]
    · have hhalf' : γ ≤ w/2 := le_of_lt (lt_of_not_ge hhalf)
      simp only [buchstabDepthDensity, max_eq_right hhalf']
      congr 1
      apply intervalIntegral.integral_congr
      intro α hα
      have hαg : γ ≤ α := (Set.mem_Icc.mp (by simpa only [Set.uIcc_of_le hhalf'] using hα)).1
      have hα0 : 0 < α := hγ.trans_le hαg
      have hwa : w-α ≤ ((n : ℝ)+2)*α := by
        have hm := mul_le_mul_of_nonneg_left hαg (show 0 ≤ (n : ℝ)+3 by positivity)
        push_cast at hw
        nlinarith
      change buchstabDepthDensity (n+1) α (w-α)/α = buchstabDepthDensity n α (w-α)/α
      rw [ih hα0 hwa]

theorem buchstab_depth_density_add_eq {γ w : ℝ} (hγ : 0 < γ) (n k : ℕ)
    (hw : w ≤ ((n : ℝ)+2)*γ) :
    buchstabDepthDensity (n+k) γ w = buchstabDepthDensity n γ w := by
  induction k with
  | zero => simp only [Nat.add_zero]
  | succ k ih =>
    rw [Nat.add_succ, buchstab_depth_density_step_eq hγ (n+k), ih]
    push_cast
    nlinarith

theorem buchstab_depth_density_stable {γ w : ℝ} (hγ : 0 < γ) (m n : ℕ)
    (hm : w ≤ ((m : ℝ)+2)*γ) (hn : w ≤ ((n : ℝ)+2)*γ) :
    buchstabDepthDensity m γ w = buchstabDepthDensity n γ w := by
  by_cases hmn : m ≤ n
  · obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hmn
    exact (buchstab_depth_density_add_eq hγ m k hm).symm
  · obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le (Nat.le_of_not_ge hmn)
    exact buchstab_depth_density_add_eq hγ n k hn

noncomputable def buchstabDensity (γ w : ℝ) : ℝ :=
  buchstabDepthDensity ⌊w/γ⌋₊ γ w

theorem buchstab_density_depth_bound {γ w : ℝ} (hγ : 0 < γ) :
    w ≤ ((⌊w/γ⌋₊ : ℝ)+2)*γ := by
  have hf := Nat.lt_floor_add_one (w/γ)
  have hh := (div_lt_iff₀ hγ).mp hf
  nlinarith

theorem buchstab_depth_density_eq_density {γ w : ℝ} (hγ : 0 < γ) (n : ℕ)
    (hw : w ≤ ((n : ℝ)+2)*γ) :
    buchstabDepthDensity n γ w = buchstabDensity γ w :=
  buchstab_depth_density_stable hγ n ⌊w/γ⌋₊ hw (buchstab_density_depth_bound hγ)

theorem buchstab_density_eq_prime_term {γ w : ℝ} (hγ : 0 < γ) (hw : w ≤ 2*γ) :
    buchstabDensity γ w = 1/w := by
  have hh := buchstab_depth_density_eq_density hγ 0 (by simpa using hw)
  exact hh.symm

theorem buchstab_density_integral_recursion {γ w : ℝ} (hγ : 0 < γ) :
    buchstabDensity γ w = 1/w +
      ∫ α in γ..max γ (w/2), buchstabDensity α (w-α)/α := by
  let n := ⌊w/γ⌋₊
  have hw : w ≤ ((n : ℝ)+2)*γ := buchstab_density_depth_bound hγ
  have hs := buchstab_depth_density_step_eq hγ n hw
  change buchstabDepthDensity n γ w = _
  rw [← hs, buchstabDepthDensity]
  congr 1
  by_cases hhalf : w/2 ≤ γ
  · simp only [max_eq_left hhalf, intervalIntegral.integral_same]
  · have hhalf' : γ ≤ w/2 := le_of_lt (lt_of_not_ge hhalf)
    rw [max_eq_right hhalf']
    apply intervalIntegral.integral_congr
    intro α hα
    have hαg : γ ≤ α := (Set.mem_Icc.mp (by simpa only [Set.uIcc_of_le hhalf'] using hα)).1
    have hα0 : 0 < α := hγ.trans_le hαg
    have hwa : w-α ≤ ((n : ℝ)+2)*α := by
      have hm := mul_le_mul_of_nonneg_left hαg (show 0 ≤ (n : ℝ)+2 by positivity)
      linarith
    change buchstabDepthDensity n α (w-α)/α = buchstabDensity α (w-α)/α
    rw [buchstab_depth_density_eq_density hα0 n hwa]

theorem buchstab_density_integral_identity {b : ℝ} (hb : 0 < b) (hbhalf : b ≤ 1/2) :
    (∫ α in b..(1/2 : ℝ), buchstabDensity α (1-α)/α) = buchstabDensity b 1-1 := by
  have h := buchstab_density_integral_recursion (w := 1) hb
  rw [max_eq_right hbhalf] at h
  norm_num at h
  linarith

end Bounty
end

section

/- Actual candidate omission counts suppress every fixed polynomial cost
at the manuscript cap ceil(L^2), after choosing J once and before L grows. -/

open Finset Filter
open scoped Topology

namespace Bounty

theorem binomial_omission_power_lower (J ell n : ℕ) (c L : ℝ)
    (hL : 0 < L) (hn : c * Real.log L ≤ (n : ℝ)) :
    L ^ (c * Real.log (((J + ell).choose ell : ℕ) : ℝ)) ≤
      (((J + ell).choose ell : ℕ) : ℝ) ^ n := by
  have hq : 0 < (J + ell).choose ell := Nat.choose_pos (by omega)
  have hqR : 0 < (((J + ell).choose ell : ℕ) : ℝ) := by exact_mod_cast hq
  have hq1 : 1 ≤ (((J + ell).choose ell : ℕ) : ℝ) := by exact_mod_cast hq
  calc
    _ = (((J + ell).choose ell : ℕ) : ℝ) ^ (c * Real.log L) := by
      rw [Real.rpow_def_of_pos hL, Real.rpow_def_of_pos hqR]
      congr 1
      ring
    _ ≤ (((J + ell).choose ell : ℕ) : ℝ) ^ (n : ℝ) :=
      Real.rpow_le_rpow_of_exponent_le hq1 hn
    _ = _ := Real.rpow_natCast _ _

theorem ceil_square_omission_sqrt_le (J ell n : ℕ) (c L : ℝ)
    (hL : 1 ≤ L) (hn : c * Real.log L ≤ (n : ℝ)) :
    Real.sqrt ((⌈L ^ 2⌉₊ : ℝ) / (((J + ell).choose ell) ^ n : ℕ)) ≤
      2 * L ^ (1 - (c / 2) * Real.log (((J + ell).choose ell : ℕ) : ℝ)) := by
  have hL0 : 0 < L := by linarith
  have hB : (⌈L ^ 2⌉₊ : ℝ) ≤ 4 * L ^ 2 := by
    have hceil := Nat.ceil_lt_add_one (sq_nonneg L)
    nlinarith
  have hden := binomial_omission_power_lower J ell n c L hL0 hn
  have hq : 0 < (((J + ell).choose ell : ℕ) : ℝ) := by
    exact_mod_cast (Nat.choose_pos (show ell ≤ J + ell by omega))
  have hsquare :
      (2 * L ^ (1 - (c / 2) * Real.log (((J + ell).choose ell : ℕ) : ℝ))) ^ 2 =
        4 * L ^ 2 / L ^ (c * Real.log (((J + ell).choose ell : ℕ) : ℝ)) := by
    calc
      _ = 4 * (L ^ (1 - (c / 2) * Real.log (((J + ell).choose ell : ℕ) : ℝ)) *
        L ^ (1 - (c / 2) * Real.log (((J + ell).choose ell : ℕ) : ℝ))) := by ring
      _ = 4 * L ^ ((2 : ℝ) - c * Real.log (((J + ell).choose ell : ℕ) : ℝ)) := by
        rw [← Real.rpow_add hL0]
        congr 1
        congr 1
        ring
      _ = _ := by rw [Real.rpow_sub hL0, Real.rpow_two]; ring
  apply Real.sqrt_le_iff.mpr
  refine ⟨by positivity, ?_⟩
  rw [hsquare, Nat.cast_pow]
  calc
    _ ≤ (4 * L ^ 2) / ((((J + ell).choose ell : ℕ) : ℝ) ^ n) :=
      div_le_div_of_nonneg_right hB (pow_nonneg hq.le _)
    _ ≤ _ := div_le_div_of_nonneg_left (by positivity)
      (Real.rpow_pos_of_pos hL0 _) hden

theorem four_mul_rpow_le_half_of_gap (a b L : ℝ)
    (hgap : a + 2 ≤ b) (hL : 4 ≤ L) :
    4 * L ^ a ≤ (1 / 2 : ℝ) * L ^ b := by
  have hL0 : 0 < L := by linarith
  have hcoeff : (4 : ℝ) ≤ L ^ 2 / 2 := by nlinarith
  calc
    _ ≤ (L ^ 2 / 2) * L ^ a :=
      mul_le_mul_of_nonneg_right hcoeff (Real.rpow_nonneg hL0.le _)
    _ = (1 / 2 : ℝ) * L ^ (a + 2) := by
      rw [Real.rpow_add hL0, Real.rpow_two]
      ring
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (Real.rpow_le_rpow_of_exponent_le (by linarith) hgap) (by norm_num)

theorem eventually_candidate_rare_transfer_decay {s : ℝ} (hs : 0 < s) (ell : ℕ) :
    ∀ᶠ L : ℝ in atTop, ∀ (J : ℕ) (A E : ℝ),
      ((1 / (20 * Real.log 2)) / 2) * Real.log (((J + ell).choose ell : ℕ) : ℝ) > A + E + 3 →
      2 * L ^ A * Real.sqrt ((⌈L ^ 2⌉₊ : ℝ) /
        (((J + ell).choose ell) ^ (candidateSmallPIndices s L).card : ℕ)) ≤
          (1 / 2 : ℝ) * L ^ (-E) := by
  obtain ⟨v, V, _, _, hpool⟩ := exists_candidate_P_pool_bounds hs
  filter_upwards [hpool, eventually_ge_atTop (4 : ℝ)] with L hp hL
  intro J A E hgain
  have hL0 : 0 < L := by linarith
  have hr := ceil_square_omission_sqrt_le J ell (candidateSmallPIndices s L).card
    (1 / (20 * Real.log 2)) L (by linarith) hp.2.1
  calc
    _ ≤ 2 * L ^ A * (2 * L ^ (1 - ((1 / (20 * Real.log 2)) / 2) *
        Real.log (((J + ell).choose ell : ℕ) : ℝ))) :=
      mul_le_mul_of_nonneg_left hr (by positivity)
    _ = 4 * L ^ (A + 1 - ((1 / (20 * Real.log 2)) / 2) *
        Real.log (((J + ell).choose ell : ℕ) : ℝ)) := by
      rw [show A + 1 - ((1 / (20 * Real.log 2)) / 2) * Real.log (((J + ell).choose ell : ℕ) : ℝ) =
        A + (1 - ((1 / (20 * Real.log 2)) / 2) * Real.log (((J + ell).choose ell : ℕ) : ℝ)) by ring,
        Real.rpow_add hL0]
      ring
    _ ≤ _ := four_mul_rpow_le_half_of_gap _ _ L (by linarith) hL

theorem exists_candidate_rare_transfer_parameter {s : ℝ} (hs : 0 < s)
    (ell : ℕ) (hell : 0 < ell) (J₀ : ℕ) (A E : ℝ) :
    ∃ J : ℕ, J₀ ≤ J ∧
      ((1 / (20 * Real.log 2)) / 2) * Real.log (((J + ell).choose ell : ℕ) : ℝ) > A + E + 3 ∧
      ∀ᶠ L : ℝ in atTop,
        2 * L ^ A * Real.sqrt ((⌈L ^ 2⌉₊ : ℝ) /
          (((J + ell).choose ell) ^ (candidateSmallPIndices s L).card : ℕ)) ≤
            (1 / 2 : ℝ) * L ^ (-E) := by
  have hc : 0 < (1 / (20 * Real.log 2) : ℝ) / 2 := by
    have hlog : 0 < Real.log (2 : ℝ) := Real.log_pos (by norm_num)
    positivity
  obtain ⟨J, hJ, hlog⟩ := exists_log_choose_add_gt_ge ell hell
    ((A + E + 3) / ((1 / (20 * Real.log 2)) / 2)) J₀
  have hgain : ((1 / (20 * Real.log 2)) / 2) * Real.log (((J + ell).choose ell : ℕ) : ℝ) > A + E + 3 := by
    simpa only [mul_comm] using (div_lt_iff₀ hc).mp hlog
  refine ⟨J, hJ, hgain, ?_⟩
  filter_upwards [eventually_candidate_rare_transfer_decay hs ell] with L hL
  exact hL J A E hgain

end Bounty
end

section

/- Forest compatibility split by original owners, using exact optional prime-label presence. -/

open Finset Classical

namespace Bounty

def birthForestStageCondition {N L : ℕ} {α : Type*}
    (owner : Fin N → Fin L) (u : Fin L) (values : Fin N → Option α) (code : BirthForestCode N) : Prop :=
  ∀ i, owner i = u → match code i with
    | none => True
    | some p => (values (birthForestParentEmbedding i p)).isSome = true ∧
        (values i).isSome = true ∧ values (birthForestParentEmbedding i p) = values i

theorem birth_forest_compatible_iff_stages {N L : ℕ} {α : Type*}
    (owner : Fin N → Fin L) (values : Fin N → Option α) (code : BirthForestCode N) :
    birthForestCompatible (fun i => (values i).isSome = true) values code ↔
      ∀ u, birthForestStageCondition owner u values code := by
  constructor
  · intro h u i _
    exact h i
  · intro h i
    exact h (owner i) i rfl

theorem birth_forest_stage_congr {N L : ℕ} {α : Type*}
    (owner : Fin N → Fin L) (hmono : Monotone owner) (u : Fin L)
    (values other : Fin N → Option α) (code : BirthForestCode N)
    (hvalues : ∀ i, owner i ≤ u → values i = other i) :
    birthForestStageCondition owner u values code ↔ birthForestStageCondition owner u other code := by
  have hi : ∀ i (_hu : owner i = u),
      (match code i with
        | none => True
        | some p => (values (birthForestParentEmbedding i p)).isSome = true ∧
            (values i).isSome = true ∧ values (birthForestParentEmbedding i p) = values i) ↔
      (match code i with
        | none => True
        | some p => (other (birthForestParentEmbedding i p)).isSome = true ∧
            (other i).isSome = true ∧ other (birthForestParentEmbedding i p) = other i) := by
    intro i hu
    cases hc : code i with
    | none => exact Iff.rfl
    | some p =>
      have hp : owner (birthForestParentEmbedding i p) ≤ u :=
        (hmono (show birthForestParentEmbedding i p ≤ i from Nat.le_of_lt p.isLt)).trans hu.le
      dsimp only
      rw [hvalues i hu.le, hvalues _ hp]
  constructor <;> intro h i hu
  · exact (hi i hu).mp (h i hu)
  · exact (hi i hu).mpr (h i hu)

theorem prod_condition_indicators {I : Type*} [Fintype I]
    (C : I → Prop) [DecidablePred C] :
    (∏ i, if C i then (1 : ℝ) else 0) = if ∀ i, C i then 1 else 0 := by
  by_cases h : ∀ i, C i
  · simp only [if_pos h, if_pos (h _), prod_const_one]
  · rw [if_neg h]
    obtain ⟨i, hi⟩ := not_forall.mp h
    exact prod_eq_zero (mem_univ i) (if_neg hi)

end Bounty
end

section

/- Converting ordinary theta increments to prime counts in finite intervals. -/

open Finset

namespace Bounty

theorem ordinary_prime_band_log_sum {A B : ℝ} (hAB : A ≤ B) :
    (∑ p ∈ primeBand A B, Real.log (p : ℝ)) = Chebyshev.theta B - Chebyshev.theta A := by
  have hfloor := Nat.floor_le_floor hAB
  have hset : Ioc ⌊A⌋₊ ⌊B⌋₊ = Ico (⌊A⌋₊ + 1) (⌊B⌋₊ + 1) := by
    ext n
    simp only [mem_Ioc, mem_Ico]
    omega
  have hsum := sum_Ico_eq_sub (fun n : ℕ => if n.Prime then Real.log (n : ℝ) else 0)
    (Nat.add_le_add_right hfloor 1)
  rw [← hset] at hsum
  simpa only [primeBand, Chebyshev.theta_eq_sum_Icc, sum_filter,
    Nat.range_succ_eq_Icc_zero] using hsum

theorem ordinary_prime_band_card_log_bounds {A B : ℝ} (hA : 1 < A) (hAB : A ≤ B) :
    (primeBand A B).card * Real.log A ≤ Chebyshev.theta B - Chebyshev.theta A ∧
    Chebyshev.theta B - Chebyshev.theta A ≤ (primeBand A B).card * Real.log B := by
  rw [← ordinary_prime_band_log_sum hAB]
  constructor
  · calc
      _ = ∑ p ∈ primeBand A B, Real.log A := by simp
      _ ≤ _ := sum_le_sum fun p hp => by
        have hm := (mem_primeBand_iff (by linarith) (by linarith) p).mp hp
        exact Real.log_le_log (by linarith) hm.2.1.le
  · calc
      _ ≤ ∑ p ∈ primeBand A B, Real.log B := sum_le_sum fun p hp => by
        have hm := (mem_primeBand_iff (by linarith) (by linarith) p).mp hp
        exact Real.log_le_log (by linarith) hm.2.2
      _ = _ := by simp

theorem ordinary_prime_band_relative_error {A B ε : ℝ}
    (hA : 1 < A) (hAB : A ≤ B) (hε : 0 ≤ ε)
    (hθ : |(Chebyshev.theta B - Chebyshev.theta A) - (B-A)| ≤ ε*(B-A))
    (hlog : Real.log B ≤ (1+ε)*Real.log A) :
    |(primeBand A B).card - (B-A)/Real.log A| ≤ 2*ε*((B-A)/Real.log A) := by
  have hL : 0 < Real.log A := Real.log_pos hA
  have hH : 0 ≤ B-A := sub_nonneg.mpr hAB
  have hN : (0 : ℝ) ≤ (primeBand A B).card := Nat.cast_nonneg _
  have hb := ordinary_prime_band_card_log_bounds hA hAB
  have he := abs_le.mp hθ
  have hupper : (primeBand A B).card * Real.log A ≤ (1+ε)*(B-A) := by linarith
  have hfactor : (1-ε)*(B-A) ≤ (1+ε)*((primeBand A B).card * Real.log A) := by
    have hh := mul_le_mul_of_nonneg_left hlog hN
    nlinarith
  have hden : 0 < 1+ε := by linarith
  have hlo : (1-2*ε)*(B-A) ≤ (primeBand A B).card * Real.log A := by
    calc
      _ ≤ (1-ε)*(B-A)/(1+ε) := (le_div_iff₀ hden).mpr (by
        nlinarith [mul_nonneg (sq_nonneg ε) hH])
      _ ≤ _ := (div_le_iff₀ hden).mpr (by nlinarith [hfactor])
  have hlo' : (1-2*ε)*((B-A)/Real.log A) ≤ (primeBand A B).card := by
    rw [← mul_div_assoc]
    exact (div_le_iff₀ hL).mpr hlo
  have hup' : (primeBand A B).card ≤ (1+ε)*((B-A)/Real.log A) := by
    rw [← mul_div_assoc]
    exact (le_div_iff₀ hL).mpr hupper
  have hM : 0 ≤ (B-A)/Real.log A := div_nonneg hH hL.le
  apply abs_le.mpr
  constructor <;> nlinarith [mul_nonneg hε hM]

end Bounty
end

section

open Finset

namespace Bounty

theorem separated_odd_prime_sieve_remainders_le (P Q : Finset ℕ) (D : ℝ) (N : ℕ)
    (r : ℕ → ℝ) (hP : ∀ p ∈ P, p.Prime) (hQ : ∀ p ∈ Q, p.Prime)
    (hPodd : ∀ p ∈ P, p ≠ 2) (hQodd : ∀ p ∈ Q, p ≠ 2)
    (hout : ∀ p ∈ Q, p ∉ P)
    (hlevel : ∀ p ∈ Q, ∀ d ∈ blockSieveModuli P D, p * d ≤ N) :
    (∑ p ∈ Q, ∑ d ∈ blockSieveModuli P D, |r (p * d)|) ≤
      ∑ m ∈ oddSquarefreeModuli N, |r m| := by
  classical
  let f : ℕ × ℕ → ℕ := fun x => x.1 * x.2
  have hsubset : (Q ×ˢ blockSieveModuli P D).image f ⊆ oddSquarefreeModuli N := by
    intro m hm
    obtain ⟨⟨p, d⟩, hpd, rfl⟩ := mem_image.mp hm
    obtain ⟨hp, hd⟩ := mem_product.mp hpd
    have hdprop := block_sieve_modulus_properties P hP D hd
    apply mem_filter.mpr
    refine ⟨mem_Icc.mpr ⟨Nat.mul_pos (hQ p hp).pos hdprop.1, hlevel p hp d hd⟩, ?_⟩
    refine ⟨Nat.squarefree_mul_iff.mpr
      ⟨external_prime_coprime_sieve_modulus P hP (hQ p hp) (hout p hp) hd,
        (hQ p hp).squarefree, hdprop.2.2.1⟩, ?_⟩
    have hprod : Odd (∏ q ∈ P, q) := by
      apply prod_induction (fun q : ℕ => q) Odd
      · intro a b ha hb
        exact ha.mul hb
      · decide
      · intro q hq
        exact (hP q hq).odd_of_ne_two (hPodd q hq)
    exact ((hQ p hp).odd_of_ne_two (hQodd p hp)).mul
      (hprod.of_dvd_nat hdprop.2.2.2)
  calc
    _ = ∑ x ∈ Q ×ˢ blockSieveModuli P D, |r (f x)| := (sum_product _ _ _).symm
    _ = ∑ m ∈ (Q ×ˢ blockSieveModuli P D).image f, |r m| :=
      (sum_image (f := fun m => |r m|)
        (separated_prime_sieve_product_injective P Q D hP hQ hout)).symm
    _ ≤ _ := sum_le_sum_of_subset_of_nonneg hsubset (fun m _ _ => abs_nonneg (r m))


theorem exists_summed_external_odd_prime_shifted_sieve :
    ∃ K : ℝ, 0 < K ∧ ∀ (P Q T : Finset ℕ) (μ : ℕ → ℝ) (N : ℕ)
      {z : ℝ} {h : ℕ},
      1 < z → 1 ≤ h → Even h →
      (∀ q ∈ P, q.Prime) → (∀ q ∈ P, q ≠ 2) →
      (∀ q ∈ P, (q : ℝ) ≤ z) → (∀ p ∈ Q, p.Prime) →
      (∀ p ∈ Q, p ≠ 2) → (∀ p ∈ Q, p ∉ P) → (∀ u ∈ T, 0 ≤ μ u) →
      (∀ p ∈ Q, ∀ d ∈ blockSieveModuli P (z^(4 * (h : ℝ) + 2)), p*d ≤ N) →
      |(∑ p ∈ Q, ∑ u ∈ T.filter
          (fun u => p ∣ 2*u + 1 ∧ ∀ q ∈ P, ¬q ∣ 2*u + 1), μ u) -
          (∑ u ∈ T, μ u) * (∏ q ∈ P, (1 - 1 / ((q : ℝ) - 1))) *
            (∑ p ∈ Q, 1 / ((p : ℝ) - 1))| ≤
        (∑ u ∈ T, μ u) * (∏ q ∈ P, (1 - 1 / ((q : ℝ) - 1))) *
          (∑ p ∈ Q, 1 / ((p : ℝ) - 1)) * K * Real.exp (-(h : ℝ)) +
          ∑ m ∈ oddSquarefreeModuli N, |shiftedTotientSieveRemainder T μ m| := by
  obtain ⟨K, hK, hsieve⟩ := exists_fixed_prime_shifted_sieve
  refine ⟨K, hK, ?_⟩
  intro P Q T μ N z h hz hh heven hP hodd hPz hQ hQodd hout hμ hlevel
  let X : ℝ := ∑ u ∈ T, μ u
  let A : ℝ := ∏ q ∈ P, (1 - 1 / ((q : ℝ) - 1))
  let H : ℝ := ∑ p ∈ Q, 1 / ((p : ℝ) - 1)
  let D : ℝ := z^(4 * (h : ℝ) + 2)
  let r : ℕ → ℝ := shiftedTotientSieveRemainder T μ
  let F : ℕ → ℝ := fun p => ∑ u ∈ T.filter
    (fun u => p ∣ 2*u + 1 ∧ ∀ q ∈ P, ¬q ∣ 2*u + 1), μ u
  have hfixed : ∀ p ∈ Q,
      |F p - (X / ((p : ℝ) - 1)) * A| ≤
        (X / ((p : ℝ) - 1)) * A * K * Real.exp (-(h : ℝ)) +
          ∑ d ∈ blockSieveModuli P D, |r (p*d)| := by
    intro p hp
    exact hsieve P T μ p hz hh heven (hQ p hp) (hout p hp) hP hodd hPz hμ
  have hmain : (∑ p ∈ Q, (X / ((p : ℝ) - 1)) * A) = X*A*H := by
    dsimp only [H]
    rw [mul_sum]
    apply sum_congr rfl
    intro p _
    ring
  change |(∑ p ∈ Q, F p) - X*A*H| ≤
    X*A*H*K*Real.exp (-(h : ℝ)) + ∑ m ∈ oddSquarefreeModuli N, |r m|
  calc
    _ = |∑ p ∈ Q, (F p - (X / ((p : ℝ) - 1)) * A)| := by
      rw [sum_sub_distrib, hmain]
    _ ≤ ∑ p ∈ Q, |F p - (X / ((p : ℝ) - 1)) * A| := abs_sum_le_sum_abs _ _
    _ ≤ ∑ p ∈ Q, ((X / ((p : ℝ) - 1)) * A * K * Real.exp (-(h : ℝ)) +
        ∑ d ∈ blockSieveModuli P D, |r (p*d)|) := sum_le_sum hfixed
    _ = X*A*H*K*Real.exp (-(h : ℝ)) +
        ∑ p ∈ Q, ∑ d ∈ blockSieveModuli P D, |r (p*d)| := by
      rw [sum_add_distrib, ← sum_mul, ← sum_mul, hmain]
    _ ≤ _ := add_le_add le_rfl
      (separated_odd_prime_sieve_remainders_le P Q D N r hP hQ hodd hQodd hout hlevel)


end Bounty
end

section

/- Disintegrate the literal full event at its original auxiliary draw. -/

open Finset
open scoped Classical
namespace Bounty
section Fixed
variable {G : Type*} {P : G → Type*} (n : ∀ g, P g → ℕ)
  {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ) {A : Type*}
  (Δ D : SharedActiveLabels P S → A → G → ℤ)
  (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)

def fullActiveFixedAuxEvent (a : A)
    (e : FullActiveEdgeEvent n S B (fun _ => Unit)
      (fun c _ => Δ c a) (fun c _ => D c a) x) :
    FullActiveEdgeEvent n S B (fun _ => A) Δ D x := ⟨a, e.2⟩

theorem full_active_fixed_aux_target (a : A)
    (e : FullActiveEdgeEvent n S B (fun _ => Unit)
      (fun c _ => Δ c a) (fun c _ => D c a) x) :
    fullActiveEdgeEventTarget n S B (fun _ => A) Δ D x
      (fullActiveFixedAuxEvent n S B Δ D x a e) =
    fullActiveEdgeEventTarget n S B (fun _ => Unit)
      (fun c _ => Δ c a) (fun c _ => D c a) x e := rfl

theorem full_active_fixed_aux_weight [Fintype G]
    (ω : SharedActiveLabels P S → A → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (a : A) (e : FullActiveEdgeEvent n S B (fun _ => Unit)
      (fun c _ => Δ c a) (fun c _ => D c a) x) :
    fullActiveEdgeEventWeight n S B (fun _ => A) Δ D ω μ ρ V x
      (fullActiveFixedAuxEvent n S B Δ D x a e) =
      ω (productActiveMemorySplit S B x).1 a *
        fullActiveEdgeEventWeight n S B (fun _ => Unit)
          (fun c _ => Δ c a) (fun c _ => D c a) (fun _ _ => 1) μ ρ V x e := by
  simp only [fullActiveFixedAuxEvent, fullActiveEdgeEventWeight, one_mul]

theorem full_active_fixed_aux_sum [Fintype G] [∀ g, Fintype (P g)] [Fintype A]
    (ω : SharedActiveLabels P S → A → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (Φ : FullActiveEdgeEvent n S B (fun _ => A) Δ D x → ℂ)
    (F : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ) :
    (∑ e : FullActiveEdgeEvent n S B (fun _ => A) Δ D x,
      (fullActiveEdgeEventWeight n S B (fun _ => A) Δ D ω μ ρ V x e : ℂ) *
        Φ e * F (fullActiveEdgeEventTarget n S B (fun _ => A) Δ D x e)) =
    ∑ a : A, (ω (productActiveMemorySplit S B x).1 a : ℂ) *
      ∑ e : FullActiveEdgeEvent n S B (fun _ => Unit) (fun c _ => Δ c a) (fun c _ => D c a) x,
        (fullActiveEdgeEventWeight n S B (fun _ => Unit)
          (fun c _ => Δ c a) (fun c _ => D c a) (fun _ _ => 1) μ ρ V x e : ℂ) *
          Φ (fullActiveFixedAuxEvent n S B Δ D x a e) *
          F (fullActiveEdgeEventTarget n S B (fun _ => Unit)
            (fun c _ => Δ c a) (fun c _ => D c a) x e) := by
  simp only [Fintype.sum_sigma, Fintype.sum_unique, fullActiveEdgeEventWeight,
    fullActiveFixedAuxEvent, fullActiveEdgeEventTarget, one_mul, Complex.ofReal_mul,
    mul_sum, mul_assoc]

theorem full_active_selected_aux_sum [Fintype G] [∀ g, Fintype (P g)] [Fintype A]
    (a : A) (ω : SharedActiveLabels P S → A → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (Φ : FullActiveEdgeEvent n S B (fun _ => A) Δ D x → ℂ)
    (F : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ) :
    (∑ e : FullActiveEdgeEvent n S B (fun _ => A) Δ D x,
      if e.1 = a then (fullActiveEdgeEventWeight n S B (fun _ => A) Δ D ω μ ρ V x e : ℂ) *
        Φ e * F (fullActiveEdgeEventTarget n S B (fun _ => A) Δ D x e) else 0) =
    (ω (productActiveMemorySplit S B x).1 a : ℂ) *
      ∑ e : FullActiveEdgeEvent n S B (fun _ => Unit) (fun c _ => Δ c a) (fun c _ => D c a) x,
        (fullActiveEdgeEventWeight n S B (fun _ => Unit)
          (fun c _ => Δ c a) (fun c _ => D c a) (fun _ _ => 1) μ ρ V x e : ℂ) *
          Φ (fullActiveFixedAuxEvent n S B Δ D x a e) *
          F (fullActiveEdgeEventTarget n S B (fun _ => Unit)
            (fun c _ => Δ c a) (fun c _ => D c a) x e) := by
  simp only [Fintype.sum_sigma]
  rw [Finset.sum_eq_single a]
  · simp only [eq_self, ite_true, Fintype.sum_unique, fullActiveEdgeEventWeight,
      fullActiveFixedAuxEvent, fullActiveEdgeEventTarget, one_mul, Complex.ofReal_mul,
      mul_sum, mul_assoc]
  · intro b hb hba
    simp only [if_neg hba, Finset.sum_const_zero]
  · intro ha
    exact (ha (Finset.mem_univ a)).elim

end Fixed
end Bounty
end

section

/- Position-dependent vectors with the exact normalization used by physical states. -/

open scoped BigOperators InnerProductSpace

namespace Bounty

noncomputable def finitePositionVector {X : Type*} (position : X → ℤ)
    (mass : ℝ) (f : ℤ → ℂ) : EuclideanSpace ℂ X :=
  WithLp.toLp 2 (fun x => (Real.sqrt mass : ℂ) * f (position x))

theorem finite_position_vector_fiber_sum {X : Type*} [Fintype X]
    (position : X → ℤ) (mass : ℝ) (f : ℤ → ℂ) (S : Finset ℤ)
    (hf : ∀ x, position x ∉ S → f (position x) = 0) :
    finitePositionVector position mass f =
      ∑ n ∈ S, f n • finiteFiberVector position mass n := by
  classical
  ext x
  by_cases hx : position x ∈ S
  · simp [finitePositionVector, finiteFiberVector, finiteFiberIndicator,
      mul_ite, hx, eq_comm, mul_comm]
  · simp [finitePositionVector, finiteFiberVector, finiteFiberIndicator,
      mul_ite, hx, hf x hx, eq_comm]

theorem finite_position_vector_norm_sq {X : Type*} [Fintype X]
    (position : X → ℤ) {mass : ℝ} (hmass : 0 ≤ mass) (f : ℤ → ℂ) :
    ‖finitePositionVector position mass f‖ ^ 2 =
      mass * ∑ x, ‖f (position x)‖ ^ 2 := by
  rw [EuclideanSpace.norm_sq_eq, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro x _
  change ‖(Real.sqrt mass : ℂ) * f (position x)‖ ^ 2 = _
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (Real.sqrt_nonneg mass), mul_pow, Real.sq_sqrt hmass]

theorem finite_position_vector_kernel_pairing {X : Type*} [Fintype X]
    (position : X → ℤ) {mass : ℝ} (hmass : 0 ≤ mass)
    (K : X → X → ℂ) (f g : ℤ → ℂ) :
    inner ℂ (finitePositionVector position mass f)
      (finiteKernelOperator K (finitePositionVector position mass g)) =
      (mass : ℂ) * ∑ x, ∑ y,
        (starRingEnd ℂ) (f (position x)) * K x y * g (position y) := by
  rw [PiLp.inner_apply, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro x _
  rw [finite_kernel_operator_apply]
  change (∑ y, K x y * ((Real.sqrt mass : ℂ) * g (position y))) *
      (starRingEnd ℂ) ((Real.sqrt mass : ℂ) * f (position x)) = _
  rw [Finset.sum_mul, Finset.mul_sum, map_mul, Complex.conj_ofReal]
  apply Finset.sum_congr rfl
  intro y _
  have hs : (Real.sqrt mass : ℂ) * (Real.sqrt mass : ℂ) = (mass : ℂ) := by
    rw [← Complex.ofReal_mul, Real.mul_self_sqrt hmass]
  calc
    _ = ((Real.sqrt mass : ℂ) * (Real.sqrt mass : ℂ)) *
        ((starRingEnd ℂ) (f (position x)) * K x y * g (position y)) := by ring
    _ = _ := by rw [hs]

end Bounty
end

section

/- Exact signed determinant identities for two shifted product equations. -/

namespace Bounty

theorem typeII_determinant_identities {m m' n e h h' : ℤ}
    (ha : m * n = 2 * e * h + 1) (hb : m' * n = 2 * e * h' + 1) :
    m' - m = 2 * e * (m * h' - m' * h) ∧
      h' - h = (m * h' - m' * h) * n := by
  constructor
  · linear_combination m * hb - m' * ha
  · linear_combination h * hb - h' * ha

theorem typeII_determinant_unique {m m' n e h h' : ℤ}
    (ha : m * n = 2 * e * h + 1) (hb : m' * n = 2 * e * h' + 1)
    (hne : m ≠ m') :
    ∃! k : ℤ, k ≠ 0 ∧ m' - m = 2 * e * k ∧ h' - h = k * n ∧
      m * h' - m' * h = k := by
  obtain ⟨hm, hh⟩ := typeII_determinant_identities ha hb
  refine ⟨m * h' - m' * h, ⟨?_, hm, hh, rfl⟩, ?_⟩
  · intro hz
    rw [hz, mul_zero] at hm
    exact hne (sub_eq_zero.mp hm).symm
  · intro k hk
    exact hk.2.2.2.symm

theorem typeII_determinant_reconstruction_identity {m m' e h h' k : ℤ}
    (hd : m * h' - m' * h = k) (he : m' - m = 2 * e * k) :
    m * (h' - h) = k * (2 * e * h + 1) := by
  linear_combination hd + h * he

theorem typeII_determinant_reconstruct {m m' e h h' k : ℤ}
    (hm : m ≠ 0) (hc : IsCoprime m k)
    (hd : m * h' - m' * h = k) (he : m' - m = 2 * e * k) :
    ∃! n : ℤ, m * n = 2 * e * h + 1 ∧ m' * n = 2 * e * h' + 1 ∧
      h' - h = k * n := by
  have hi := typeII_determinant_reconstruction_identity hd he
  have hdiv : m ∣ 2 * e * h + 1 :=
    hc.dvd_of_dvd_mul_left ⟨h' - h, hi.symm⟩
  obtain ⟨n, hn⟩ := hdiv
  have hstep : h' - h = k * n := by
    apply mul_left_cancel₀ hm
    rw [hi, hn]
    ring
  have hn' : m' * n = 2 * e * h' + 1 := by
    linear_combination -hn + n * he - 2 * e * hstep
  refine ⟨n, ⟨hn.symm, hn', hstep⟩, ?_⟩
  intro n' hn'
  exact mul_left_cancel₀ hm (hn'.1.trans hn)

theorem typeII_determinant_reconstruct_positive {m m' e h h' k : ℤ}
    (hm : 0 < m) (hepos : 0 < e) (hh : 0 ≤ h)
    (hc : IsCoprime m k) (hd : m * h' - m' * h = k)
    (he : m' - m = 2 * e * k) :
    ∃! n : ℤ, 0 < n ∧ m * n = 2 * e * h + 1 ∧
      m' * n = 2 * e * h' + 1 ∧ h' - h = k * n := by
  obtain ⟨n, hn, huniq⟩ := typeII_determinant_reconstruct hm.ne' hc hd he
  have hnpos : 0 < n := by
    have hprod : 0 < m * n := by rw [hn.1]; positivity
    exact (mul_pos_iff_of_pos_left hm).mp hprod
  exact ⟨n, ⟨hnpos, hn⟩, fun n' hn' => huniq n' hn'.2⟩

end Bounty
end

section

/- The literal three-factor endpoint convolution and its divisor majorant. -/

open scoped BigOperators

namespace Bounty

noncomputable def endpointTripleConvolution (α β γ : ℕ → ℂ) (n : ℕ) : ℂ :=
  ∑ m ∈ n.divisors, ∑ p ∈ (n / m).divisors, α m * β p * γ (n / m / p)

theorem endpoint_triple_convolution_norm_le (α β γ : ℕ → ℂ)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (n : ℕ) :
    ‖endpointTripleConvolution α β γ n‖ ≤ A * B * C * (n.divisors.card : ℝ) ^ 2 := by
  classical
  have hABC : 0 ≤ A * B * C := mul_nonneg (mul_nonneg hA hB) hC
  calc
    _ ≤ ∑ m ∈ n.divisors, ∑ p ∈ (n / m).divisors, ‖α m * β p * γ (n / m / p)‖ := by
      exact (norm_sum_le _ _).trans (Finset.sum_le_sum (fun m _ => norm_sum_le _ _))
    _ ≤ ∑ m ∈ n.divisors, ∑ _p ∈ (n / m).divisors, A * B * C := by
      apply Finset.sum_le_sum
      intro m _
      apply Finset.sum_le_sum
      intro p _
      rw [norm_mul, norm_mul]
      exact mul_le_mul (mul_le_mul (hα m) (hβ p) (norm_nonneg _) hA)
        (hγ _) (norm_nonneg _) (mul_nonneg hA hB)
    _ ≤ ∑ _m ∈ n.divisors, (n.divisors.card : ℝ) * (A * B * C) := by
      apply Finset.sum_le_sum
      intro m hm
      simp only [Finset.sum_const, nsmul_eq_mul]
      apply mul_le_mul_of_nonneg_right _ hABC
      exact_mod_cast Finset.card_le_card (Nat.divisors_subset_of_dvd
        (Nat.ne_zero_of_mem_divisors hm) (Nat.div_dvd_of_dvd (Nat.dvd_of_mem_divisors hm)))
    _ = _ := by simp only [Finset.sum_const, nsmul_eq_mul]; ring

noncomputable def invariantTripleEndpoint (P : Finset ℕ)
    (α β γ : ℕ → ℂ) (n : ℕ) : ℂ :=
  endpointTripleConvolution α β γ (primePoolFreePart P n)

theorem invariant_triple_endpoint_norm_le (P : Finset ℕ) (α β γ : ℕ → ℂ)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (n : ℕ) :
    ‖invariantTripleEndpoint P α β γ n‖ ≤
      A * B * C * ((primePoolFreePart P n).divisors.card : ℝ) ^ 2 :=
  endpoint_triple_convolution_norm_le α β γ hA hB hC hα hβ hγ _

end Bounty
end

section

/- A sixteenth Dirichlet convolution majorizes the fourth divisor moment. -/

open Finset ArithmeticFunction

namespace Bounty

theorem divisor_zeta_power_prime_pow (r a : ℕ) {p : ℕ} (hp : p.Prime) :
    (ArithmeticFunction.zeta ^ (r + 1)) (p ^ a) = (a + r).choose r := by
  induction r generalizing a with
  | zero => simp [ArithmeticFunction.zeta_apply_ne (pow_ne_zero _ hp.ne_zero)]
  | succ r ih =>
    rw [pow_succ, ArithmeticFunction.mul_zeta_apply, Nat.sum_divisors_prime_pow hp]
    simp_rw [ih]
    simpa only [Nat.add_assoc] using Nat.sum_range_add_choose a r

theorem fourth_power_le_choose_fifteen (a : ℕ) : (a + 1) ^ 4 ≤ (a + 15).choose 15 := by
  induction a with
  | zero => norm_num
  | succ a ih =>
    have hr := Nat.choose_mul_succ_eq (a + 15) 15
    have hs : a + 15 + 1 - 15 = a + 1 := by omega
    rw [hs] at hr
    have hpoly : (a + 2) ^ 4 ≤ (a + 16) * (a + 1) ^ 3 := by
      nlinarith [Nat.zero_le (a ^ 3)]
    have hmul := Nat.mul_le_mul_right (a + 1) hpoly
    have hih := Nat.mul_le_mul_left (a + 16) ih
    have hfinal : (a + 1) * (a + 2) ^ 4 ≤
        (a + 1) * (a + 16).choose 15 := by
      calc
        _ ≤ (a + 16) * (a + 1) ^ 4 := by nlinarith only [hmul]
        _ ≤ (a + 16) * (a + 15).choose 15 := hih
        _ = _ := by nlinarith only [hr]
    have hres : (a + 2) ^ 4 ≤ (a + 16).choose 15 := by nlinarith only [hfinal]
    simpa only [Nat.succ_eq_add_one, Nat.add_assoc] using hres

theorem divisor_fourth_power_le_zeta_sixteen (n : ℕ) :
    n.divisors.card ^ 4 ≤ (ArithmeticFunction.zeta ^ 16) n := by
  by_cases hn : n = 0
  · simp [hn]
  rw [Nat.card_divisors hn,
    (ArithmeticFunction.isMultiplicative_zeta.pow (k := 16)).multiplicative_factorization _ hn]
  simp only [Finsupp.prod, ← Finset.prod_pow]
  apply Finset.prod_le_prod'
  intro p hp
  have hp' : p.Prime := Nat.prime_of_mem_primeFactors hp
  rw [show 16 = 15 + 1 by omega, divisor_zeta_power_prime_pow 15 _ hp']
  exact fourth_power_le_choose_fifteen _

end Bounty
end

section

/- Scalar arithmetic for a positive candidate mass after proxy subtraction. -/

open Filter

namespace Bounty

theorem candidate_proxy_gap_arithmetic
    {d L X C κ Rpre Rmesh A U B : ℝ}
    (_hd : 0 < d) (hL : 0 < L) (hX : 0 ≤ X)
    (hC : C / L ≤ d / 12)
    (hgap : d / 2 < Rpre - Rmesh - C * κ)
    (hA : (Rpre - d / 24) * X / L ≤ A)
    (hU : U ≤ (Rmesh + d / 24) * X / L)
    (hB : B ≤ C * (κ + 1 / L) * X / L) :
    (d / 3) * X / L ≤ A - U - B := by
  have hscalar : d / 3 ≤ (Rpre - d / 24) - (Rmesh + d / 24) - C * (κ + 1 / L) := by
    have hsplit : C * (κ + 1 / L) = C * κ + C / L := by ring
    rw [hsplit]
    linarith
  have hscale : 0 ≤ X / L := div_nonneg hX hL.le
  calc
    (d / 3) * X / L = (d / 3) * (X / L) := by ring
    _ ≤ ((Rpre - d / 24) - (Rmesh + d / 24) - C * (κ + 1 / L)) * (X / L) :=
      mul_le_mul_of_nonneg_right hscalar hscale
    _ = (Rpre - d / 24) * X / L - (Rmesh + d / 24) * X / L -
          C * (κ + 1 / L) * X / L := by ring
    _ ≤ A - U - B := by linarith

theorem eventually_proxy_gap_reciprocal_bound {d C : ℝ} (hd : 0 < d) :
    ∀ᶠ L : ℝ in atTop, 0 < L ∧ C / L ≤ d / 12 := by
  filter_upwards [eventually_ge_atTop (max 1 (12 * C / d))] with L hbound
  have hLone : 1 ≤ L := (le_max_left _ _).trans hbound
  have hL : 0 < L := by linarith
  refine ⟨hL, ?_⟩
  have hCL : 12 * C / d ≤ L := (le_max_right _ _).trans hbound
  have hCL' : 12 * C ≤ L * d := (div_le_iff₀ hd).mp hCL
  apply (div_le_iff₀ hL).mpr
  nlinarith

end Bounty

end

section

/- A fixed positive mass fraction absorbs two powers of the logarithmic parameter. -/

open Filter

namespace Bounty

theorem eventually_polynomial_mass_absorption (C : ℝ) {σ : ℝ} (hσ : 0 < σ) :
    ∀ᶠ L : ℝ in atTop,
      Real.exp L * L ^ (-(C + 2)) ≤ σ * (Real.exp L * L ^ (-C)) / L := by
  filter_upwards [eventually_ge_atTop (max 1 (1 / σ))] with L hbound
  have hLone : 1 ≤ L := (le_max_left _ _).trans hbound
  have hL : 0 < L := by linarith
  have hσL : 1 ≤ σ * L := by
    have hrecip : 1 / σ ≤ L := (le_max_right _ _).trans hbound
    have := (div_le_iff₀ hσ).mp hrecip
    nlinarith
  have hp : L ^ (-(C + 2)) = L ^ (-C) / (L * L) := by
    rw [show -(C + 2) = -C - 2 by ring, Real.rpow_sub hL]
    norm_num [pow_two]
  have hK : 0 ≤ Real.exp L * L ^ (-C) := by positivity
  rw [hp, ← mul_div_assoc]
  apply (div_le_iff₀ (mul_pos hL hL)).mpr
  have hid : (σ * (Real.exp L * L ^ (-C)) / L) * (L * L) =
      (σ * L) * (Real.exp L * L ^ (-C)) := by
    field_simp
  rw [hid]
  simpa only [one_mul] using mul_le_mul_of_nonneg_right hσL hK

theorem eventually_polynomial_mass_lower_transfer
    (C : ℝ) {σ : ℝ} (hσ : 0 < σ) {X m : ℝ → ℝ}
    (hX : ∀ᶠ L : ℝ in atTop, Real.exp L * L ^ (-C) ≤ X L)
    (hm : ∀ᶠ L : ℝ in atTop, σ * X L / L ≤ m L) :
    ∀ᶠ L : ℝ in atTop, Real.exp L * L ^ (-(C + 2)) ≤ m L := by
  filter_upwards [eventually_polynomial_mass_absorption C hσ, hX, hm,
    eventually_gt_atTop (0 : ℝ)] with L habsorb hmass htarget hL
  apply habsorb.trans
  apply le_trans _ htarget
  exact div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hmass hσ.le) hL.le

end Bounty

end

section

/- The product of the actual physical marks is a supported squarefree divisor. -/

open Finset

namespace Bounty

noncomputable def physicalMarkProduct {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (L : PhysicalMarkLists P J ell) : ℕ :=
  ∏ p ∈ physicalMarkedPrimes L, p.2.val

theorem physical_mark_product_pos {G : Type*} [Fintype G]
    {P : G → Finset ℕ} (hprime : ∀ g p, p ∈ P g → p.Prime)
    {J ell : ℕ} (L : PhysicalMarkLists P J ell) : 0 < physicalMarkProduct L := by
  unfold physicalMarkProduct
  exact prod_pos (fun p _ => (hprime p.1 p.2.val p.2.property).pos)

theorem physical_mark_product_inverse {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (L : PhysicalMarkLists P J ell) :
    1 / (physicalMarkProduct L : ℝ) = ∏ g, ∏ s, 1 / ((L g s).val : ℝ) := by
  rw [← physical_marked_probability_product L]
  simp only [physicalMarkProduct, Nat.cast_prod, prod_div_distrib, prod_const_one]

theorem physical_mark_product_dvd_iff {G : Type*} [Fintype G]
    {P : G → Finset ℕ} (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    {J ell : ℕ} (L : PhysicalMarkLists P J ell) (n : ℤ) :
    physicalMarkProduct L ∣ n.natAbs ↔ ∀ g s, ((L g s).val : ℤ) ∣ n := by
  rw [← physical_marked_divisibility_iff L n]
  constructor
  · intro hn p hp
    apply Int.natCast_dvd.mpr
    exact (dvd_prod_of_mem (fun p : PhysicalPrime P => p.2.val) hp).trans hn
  · intro hn
    apply prod_dvd_of_isRelPrime
    · intro p _ q _ hpq
      exact Nat.coprime_iff_isRelPrime.mp (physical_prime_pool_coprime hP hprime hpq)
    · intro p hp
      exact Int.natCast_dvd.mp (hn p hp)

theorem physical_mark_product_supported {G : Type*} [Fintype G]
    {P : G → Finset ℕ} (hprime : ∀ g p, p ∈ P g → p.Prime)
    (Q : Finset ℕ) (hQ : ∀ g, P g ⊆ Q)
    {J ell : ℕ} (L : PhysicalMarkLists P J ell) :
    physicalMarkProduct L ∈ Nat.factoredNumbers Q := by
  unfold physicalMarkProduct
  apply prod_induction
  · exact fun _ _ => Nat.mul_mem_factoredNumbers
  · exact Nat.mem_factoredNumbers_of_primeFactors_subset (by decide) (by simp)
  · intro p _
    apply Nat.mem_factoredNumbers_of_primeFactors_subset (hprime p.1 p.2.val p.2.property).ne_zero
    rw [(hprime p.1 p.2.val p.2.property).primeFactors]
    exact singleton_subset_iff.mpr (hQ p.1 p.2.property)

end Bounty
end

section

/- Exact separated Fourier phases for ordered smooth slot allocation. -/

open Finset

namespace Bounty

noncomputable def orderedSlotResidual {N : ℕ} (R : ℝ) (δ v : Fin N → ℝ)
    (i : Fin N) : ℝ := R-∑ j∈univ.filter (fun j => j < i), δ j*v j

noncomputable def orderedSlotFrequency {N : ℕ} (δ a : Fin N → ℝ)
    (j : Fin N) : ℝ := -a j-δ j*(∑ i∈univ.filter (fun i => j < i), a i)

theorem ordered_slot_phase_separation {N : ℕ} (R : ℝ) (δ v a : Fin N → ℝ) :
    (∑ i, a i*(orderedSlotResidual R δ v i-v i)) =
      R*(∑ i, a i)+∑ j, v j*orderedSlotFrequency δ a j := by
  have hswap : (∑ i, a i*(∑ j∈univ.filter (fun j => j < i), δ j*v j)) =
      ∑ j, v j*δ j*(∑ i∈univ.filter (fun i => j < i), a i) := by
    simp only [mul_sum, sum_filter]
    rw [sum_comm]
    apply sum_congr rfl
    intro j hj
    apply sum_congr rfl
    intro i hi
    by_cases h : j < i <;> simp only [h, if_true, if_false, mul_zero]
    ring
  have hmul : (∑ i, a i*v i) = ∑ i, v i*a i := by
    apply sum_congr rfl
    intro i hi
    ring
  simp only [orderedSlotResidual, orderedSlotFrequency, mul_sub, mul_neg,
    sum_sub_distrib, sum_neg_distrib, ← mul_assoc]
  rw [hswap, hmul]
  simp only [sum_mul, mul_comm R]
  ring

theorem ordered_slot_frequency_abs_le {N : ℕ} (δ a : Fin N → ℝ)
    (hδ : ∀ i, |δ i|≤1) (j : Fin N) :
    |orderedSlotFrequency δ a j| ≤ ∑ i, |a i| := by
  have htail : |δ j*(∑ i∈univ.filter (fun i => j < i), a i)| ≤
      ∑ i∈univ.filter (fun i => j < i), |a i| := by
    rw [abs_mul]
    exact (mul_le_mul_of_nonneg_right (hδ j) (abs_nonneg _)).trans
      (by simpa only [one_mul] using abs_sum_le_sum_abs a (univ.filter (fun i => j < i)))
  have hsplit : |a j|+(∑ i∈univ.filter (fun i => j < i), |a i|) ≤ ∑ i, |a i| := by
    have hnot : j∉univ.filter (fun i => j < i) := by simp
    have heq : (∑ i∈insert j (univ.filter (fun i => j < i)), |a i|) =
        |a j|+(∑ i∈univ.filter (fun i => j < i), |a i|) := sum_insert hnot
    rw [← heq]
    exact sum_le_sum_of_subset_of_nonneg (subset_univ _) (fun _ _ _ => abs_nonneg _)
  unfold orderedSlotFrequency
  exact (abs_sub _ _).trans ((add_le_add (le_of_eq (abs_neg _)) htail).trans hsplit)

theorem ordered_slot_frequency_div_abs_le {N : ℕ} (δ ξ s : Fin N → ℝ)
    (hδ : ∀ i, |δ i|≤1) (hs : ∀ i, 0 < s i) {L : ℝ}
    (hξ : ∀ i, |ξ i|≤L) (j : Fin N) :
    |orderedSlotFrequency δ (fun i => ξ i/s i) j| ≤ L*(∑ i, 1/s i) := by
  apply (ordered_slot_frequency_abs_le δ _ hδ j).trans
  rw [mul_sum]
  apply sum_le_sum
  intro i hi
  rw [abs_div, abs_of_pos (hs i), mul_one_div]
  exact div_le_div_of_nonneg_right (hξ i) (hs i).le

theorem ordered_slot_exponential_separation {N : ℕ}
    (R : ℝ) (δ v a : Fin N → ℝ) :
    Complex.exp (Complex.I*((∑ i, a i*(orderedSlotResidual R δ v i-v i) : ℝ) : ℂ)) =
      Complex.exp (Complex.I*((R*(∑ i, a i) : ℝ) : ℂ))*
        ∏ j, Complex.exp (Complex.I*((v j*orderedSlotFrequency δ a j : ℝ) : ℂ)) := by
  rw [ordered_slot_phase_separation]
  simp only [Complex.ofReal_add, mul_add, Complex.exp_add, Complex.ofReal_sum,
    mul_sum, Complex.exp_sum]

theorem ordered_slot_scalar_phase_norm {N : ℕ} (R : ℝ) (a : Fin N → ℝ) :
    ‖Complex.exp (Complex.I*((R*(∑ i, a i) : ℝ) : ℂ))‖ = 1 :=
  Complex.norm_exp_I_mul_ofReal _

theorem ordered_slot_prime_power_separation {N : ℕ}
    (R : ℝ) (δ p a : Fin N → ℝ) (hp : ∀ i, 0 < p i) :
    Complex.exp (Complex.I*((∑ i, a i*
      (orderedSlotResidual R δ (fun j => Real.log (p j)) i-Real.log (p i)) : ℝ) : ℂ)) =
      Complex.exp (Complex.I*((R*(∑ i, a i) : ℝ) : ℂ))*
        ∏ j, (p j : ℂ)^((orderedSlotFrequency δ a j : ℂ)*Complex.I) := by
  rw [ordered_slot_exponential_separation]
  congr 1
  apply prod_congr rfl
  intro j hj
  rw [Complex.cpow_def_of_ne_zero (Complex.ofReal_ne_zero.mpr (hp j).ne'),
    ← Complex.ofReal_log (hp j).le]
  congr 1
  push_cast
  ring

end Bounty
end

section

/- Concrete smooth take/skip allocation of ordered logarithmic slot values. -/

open Finset Real

namespace Bounty

noncomputable def smoothSlotTakeProbability (v s R : ℝ) (active : Bool) : ℝ :=
  if active then smoothTransition ((R-v)/s) else 0

noncomputable def smoothSlotTransition (v s R : ℝ) (active take : Bool) : ℝ :=
  if take then smoothSlotTakeProbability v s R active
  else 1-smoothSlotTakeProbability v s R active

noncomputable def smoothAllocationWeight : (n : ℕ) → (Fin n → ℝ) → (Fin n → ℝ) →
    (Fin n → Bool) → ℝ → (Fin n → Bool) → ℝ
  | 0, _, _, _, _, _ => 1
  | n+1, v, s, active, R, take =>
    smoothSlotTransition (v 0) (s 0) R (active 0) (take 0) *
      smoothAllocationWeight n (Fin.tail v) (Fin.tail s) (Fin.tail active)
        (R-if take 0 then v 0 else 0) (Fin.tail take)

theorem smooth_slot_take_bounds (v s R : ℝ) (active : Bool) :
    0 ≤ smoothSlotTakeProbability v s R active ∧ smoothSlotTakeProbability v s R active ≤ 1 := by
  cases active <;> simp only [smoothSlotTakeProbability, Bool.false_eq_true, if_false, if_true]
  · norm_num
  · exact ⟨smoothTransition.nonneg _,smoothTransition.le_one _⟩

theorem smooth_slot_transition_nonneg (v s R : ℝ) (active take : Bool) :
    0 ≤ smoothSlotTransition v s R active take := by
  obtain ⟨h0,h1⟩ := smooth_slot_take_bounds v s R active
  cases take <;> simp only [smoothSlotTransition, Bool.false_eq_true, if_false, if_true]
  · linarith
  · exact h0

theorem smooth_slot_transition_sum (v s R : ℝ) (active : Bool) :
    (∑ take : Bool, smoothSlotTransition v s R active take) = 1 := by
  rw [Fintype.sum_bool]
  simp only [smoothSlotTransition, Bool.false_eq_true, if_true, if_false]
  ring

theorem smooth_allocation_weight_nonneg (n : ℕ) (v s : Fin n → ℝ)
    (active : Fin n → Bool) (R : ℝ) (take : Fin n → Bool) :
    0 ≤ smoothAllocationWeight n v s active R take := by
  induction n generalizing R with
  | zero => exact zero_le_one
  | succ n ih => exact mul_nonneg (smooth_slot_transition_nonneg _ _ _ _ _) (ih _ _ _ _ _)

theorem smooth_allocation_total_mass (n : ℕ) (v s : Fin n → ℝ)
    (active : Fin n → Bool) (R : ℝ) :
    (∑ take : Fin n → Bool, smoothAllocationWeight n v s active R take) = 1 := by
  induction n generalizing R with
  | zero => simp [smoothAllocationWeight]
  | succ n ih =>
    have he := Fintype.sum_equiv (Fin.consEquiv (fun _ : Fin (n+1) => Bool))
      (fun t => smoothAllocationWeight (n+1) v s active R (Fin.cons t.1 t.2))
      (fun take => smoothAllocationWeight (n+1) v s active R take) (fun _ => rfl)
    rw [← he, Fintype.sum_prod_type]
    simp only [smoothAllocationWeight, Fin.cons_zero, Fin.tail_cons, ← mul_sum, ih, mul_one]
    exact smooth_slot_transition_sum _ _ _ _

theorem smooth_allocation_weight_le_one (n : ℕ) (v s : Fin n → ℝ)
    (active : Fin n → Bool) (R : ℝ) (take : Fin n → Bool) :
    smoothAllocationWeight n v s active R take ≤ 1 := by
  rw [← smooth_allocation_total_mass n v s active R]
  exact single_le_sum (fun t _ => smooth_allocation_weight_nonneg n v s active R t) (mem_univ take)

theorem smooth_allocation_positive_factors {n : ℕ} {v s : Fin (n+1) → ℝ}
    {active : Fin (n+1) → Bool} {R : ℝ} {take : Fin (n+1) → Bool}
    (h : 0 < smoothAllocationWeight (n+1) v s active R take) :
    0 < smoothSlotTransition (v 0) (s 0) R (active 0) (take 0) ∧
      0 < smoothAllocationWeight n (Fin.tail v) (Fin.tail s) (Fin.tail active)
        (R-if take 0 then v 0 else 0) (Fin.tail take) := by
  have ht := smooth_slot_transition_nonneg (v 0) (s 0) R (active 0) (take 0)
  have hr := smooth_allocation_weight_nonneg n (Fin.tail v) (Fin.tail s) (Fin.tail active)
    (R-if take 0 then v 0 else 0) (Fin.tail take)
  change 0 < _*_ at h
  constructor <;> nlinarith

theorem smooth_allocation_inactive_not_taken (n : ℕ) (v s : Fin n → ℝ)
    (active : Fin n → Bool) (R : ℝ) (take : Fin n → Bool)
    (h : 0 < smoothAllocationWeight n v s active R take) :
    ∀ i, active i = false → take i = false := by
  induction n generalizing R with
  | zero => exact fun i => Fin.elim0 i
  | succ n ih =>
    obtain ⟨hh,ht⟩ := smooth_allocation_positive_factors h
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · intro ha
      cases hb : take 0
      · rfl
      · simp only [smoothSlotTransition, smoothSlotTakeProbability, ha, hb,
          Bool.false_eq_true, if_false, if_true] at hh
        linarith
    · exact ih (Fin.tail v) (Fin.tail s) (Fin.tail active) _ (Fin.tail take) ht j

theorem smooth_slot_take_requires_room {v s R : ℝ} (hs : 0 < s) {active : Bool}
    (h : 0 < smoothSlotTransition v s R active true) : v < R := by
  cases active
  · simp [smoothSlotTransition,smoothSlotTakeProbability] at h
  · have hn : smoothTransition ((R-v)/s) ≠ 0 := ne_of_gt h
    have hp : 0 < (R-v)/s := lt_of_not_ge (fun hz => hn (smoothTransition.zero_of_nonpos hz))
    have hh := (div_pos_iff_of_pos_right hs).mp hp
    linarith

theorem smooth_slot_skip_requires_room {v s R : ℝ} (hs : 0 < s)
    (h : 0 < smoothSlotTransition v s R true false) : R < v+s := by
  have hn : smoothTransition ((R-v)/s) ≠ 1 := by
    change 0 < 1-smoothTransition ((R-v)/s) at h
    linarith
  have hp : (R-v)/s < 1 := lt_of_not_ge (fun hz => hn (smoothTransition.one_of_one_le hz))
  have hh := (div_lt_one hs).mp hp
  linarith

end Bounty
end

section

/- An exact mass-one refinement preserves the original ordered-slot normalization. -/

open Finset

namespace Bounty

theorem ordered_slot_weight_partition {I B : Type*} [Fintype I] [DecidableEq I] [Fintype B]
    (choices : I → Finset ℕ) (normalization : ℝ) (n : ℕ)
    (weight : (∀ i, choices i) → B → ℝ) (hweight : ∀ x, ∑ b, weight x b = 1) :
    orderedSlotWeight choices normalization n =
      ∑ x : ∀ i, choices i, ∑ b : B,
        if orderedSlotProduct choices x = n then weight x b / normalization else 0 := by
  classical
  unfold orderedSlotWeight
  refine sum_congr ?_ ?_
  · ext x
    simp only [mem_univ]
  intro x hx
  by_cases hn : orderedSlotProduct choices x = n
  · simp only [hn, if_true, ← sum_div, hweight]
  · simp only [hn, if_false, sum_const_zero]

end Bounty
end

section

/- The powers of the interval length cancel in the localized Gram estimate. -/

namespace Bounty

theorem block_gram_scaling_bound {R : ℕ} (hR : 1 ≤ R)
    {X U T : ℝ} (hX : 0 < X) (hU : 1 ≤ U) (hT : 0 ≤ T) :
    (3 * (X * U ^ 2)) ^ (1 / 2 : ℝ) *
      (X * U ^ 2) ^ ((1 - 1 / (R : ℝ)) / 2) *
      (X * T ^ (2 * R)) ^ (1 / (2 * (R : ℝ))) ≤
        Real.sqrt 3 * X * U ^ 2 * T := by
  have hR0 : (0 : ℝ) < R := by exact_mod_cast (by omega : 0 < R)
  have hU0 : 0 < U := lt_of_lt_of_le zero_lt_one hU
  have hXU : 0 < X * U ^ 2 := mul_pos hX (sq_pos_of_pos hU0)
  have he : (1 / 2 : ℝ) + (1 - 1 / (R : ℝ)) / 2 = 1 - 1 / (2 * (R : ℝ)) := by ring
  have ht : (T ^ (2 * R)) ^ (1 / (2 * (R : ℝ))) = T := by
    rw [← Real.rpow_natCast_mul hT]
    have he' : ((2 * R : ℕ) : ℝ) * (1 / (2 * (R : ℝ))) = 1 := by
      push_cast
      field_simp
    rw [he', Real.rpow_one]
  have hu : (U ^ 2) ^ (1 - 1 / (2 * (R : ℝ))) = U ^ (2 - 1 / (R : ℝ)) := by
    rw [← Real.rpow_natCast_mul hU0.le]
    congr 1
    norm_num
    ring
  have hcomb : (X * U ^ 2) ^ (1 - 1 / (2 * (R : ℝ))) *
      (X * T ^ (2 * R)) ^ (1 / (2 * (R : ℝ))) =
      X * U ^ (2 - 1 / (R : ℝ)) * T := by
    rw [Real.mul_rpow hX.le (sq_nonneg U), Real.mul_rpow hX.le (pow_nonneg hT _), ht, hu]
    calc
      _ = (X ^ (1 - 1 / (2 * (R : ℝ))) * X ^ (1 / (2 * (R : ℝ)))) *
          U ^ (2 - 1 / (R : ℝ)) * T := by ring
      _ = _ := by rw [← Real.rpow_add hX]; simp
  calc
    _ = (3 : ℝ) ^ (1 / 2 : ℝ) *
        ((X * U ^ 2) ^ (1 - 1 / (2 * (R : ℝ))) *
          (X * T ^ (2 * R)) ^ (1 / (2 * (R : ℝ)))) := by
      rw [Real.mul_rpow (by norm_num : (0 : ℝ) ≤ 3) hXU.le,
        ← mul_assoc, mul_assoc ((3 : ℝ) ^ (1 / 2 : ℝ)), ← Real.rpow_add hXU, he]
    _ = Real.sqrt 3 * X * U ^ (2 - 1 / (R : ℝ)) * T := by
      rw [hcomb, Real.sqrt_eq_rpow]
      ring
    _ ≤ _ := by
      apply mul_le_mul_of_nonneg_right _ hT
      apply mul_le_mul_of_nonneg_left _ (mul_nonneg (Real.sqrt_nonneg _) hX.le)
      have h := Real.rpow_le_rpow_of_exponent_le hU
        (show 2 - 1 / (R : ℝ) ≤ 2 by linarith [one_div_pos.mpr hR0])
      simpa only [Real.rpow_two] using h

theorem block_gram_of_energy_bounds {R : ℕ} (hR : 1 ≤ R)
    {Q F G Z B X U T : ℝ} (hF0 : 0 ≤ F) (hG0 : 0 ≤ G) (hZ0 : 0 ≤ Z)
    (hB : 0 ≤ B) (hX : 0 < X) (hU : 1 ≤ U) (hT : 0 ≤ T)
    (hblock : Q ^ (1 / (2 * (R : ℝ))) ≤ B)
    (hF : F ≤ X * U ^ 2) (hG : G ≤ X * U ^ 2) (hZ : Z ≤ X * T ^ (2 * R)) :
    Q ^ (1 / (2 * (R : ℝ))) * (3 * G) ^ (1 / 2 : ℝ) *
      F ^ ((1 - 1 / (R : ℝ)) / 2) * Z ^ (1 / (2 * (R : ℝ))) ≤
        B * Real.sqrt 3 * X * U ^ 2 * T := by
  have hR1 : (1 : ℝ) ≤ R := by exact_mod_cast hR
  have hR0 : (0 : ℝ) < R := lt_of_lt_of_le zero_lt_one hR1
  have htheta : 0 ≤ (1 - 1 / (R : ℝ)) / 2 := by
    have hh : 1 / (R : ℝ) ≤ 1 := (div_le_one hR0).mpr hR1
    linarith
  calc
    _ ≤ B * (3 * (X * U ^ 2)) ^ (1 / 2 : ℝ) *
        (X * U ^ 2) ^ ((1 - 1 / (R : ℝ)) / 2) *
        (X * T ^ (2 * R)) ^ (1 / (2 * (R : ℝ))) := by
      gcongr
    _ = B * ((3 * (X * U ^ 2)) ^ (1 / 2 : ℝ) *
        (X * U ^ 2) ^ ((1 - 1 / (R : ℝ)) / 2) *
        (X * T ^ (2 * R)) ^ (1 / (2 * (R : ℝ)))) := by ring
    _ ≤ B * (Real.sqrt 3 * X * U ^ 2 * T) :=
      mul_le_mul_of_nonneg_left (block_gram_scaling_bound hR hX hU hT) hB
    _ = _ := by ring

end Bounty
end

section

/- Explicit exponential rank tails retain the required saving in the whole path length. -/

namespace Bounty

theorem geometric_rank_tail_le_exp {A a b c E : ℝ} (r : ℕ)
    (hAc : A ≤ Real.exp c) (ha : 0 ≤ a) (ha2 : a ≤ 1 / 2)
    (hab : a ≤ Real.exp (-b)) (hmargin : c + E + Real.log 2 ≤ b * r) :
    A * a ^ r / (1 - a) ≤ Real.exp (-E) := by
  have hden : 0 < 1 - a := by linarith
  have hp : a ^ r ≤ Real.exp (-b * r) := by
    calc
      _ ≤ Real.exp (-b) ^ r := pow_le_pow_left₀ ha hab r
      _ = _ := by rw [← Real.exp_nat_mul]; congr 1; ring
  have hnum : A * a ^ r ≤ Real.exp (-E) / 2 := by
    calc
      _ ≤ Real.exp c * Real.exp (-b * r) := mul_le_mul hAc hp (pow_nonneg ha _) (Real.exp_pos c).le
      _ = Real.exp (c - b * r) := by rw [← Real.exp_add]; congr 1; ring
      _ ≤ Real.exp (-E - Real.log 2) := Real.exp_le_exp.mpr (by linarith)
      _ = _ := by rw [Real.exp_sub, Real.exp_log (by norm_num : (0 : ℝ) < 2)]
  apply (div_le_iff₀ hden).mpr
  calc
    _ ≤ Real.exp (-E) / 2 := hnum
    _ ≤ Real.exp (-E) * (1 - a) := by nlinarith [Real.exp_pos (-E)]

theorem forest_rank_cutoff_tail {L C E b A a : ℝ} (N : ℕ)
    (hL : 2 ≤ L) (hC : 0 ≤ C) (hb : Real.log 2 ≤ b)
    (hN : 1 ≤ N) (hAb : A ≤ L ^ (C * ((N : ℝ) + 1)))
    (ha : 0 ≤ a) (hab : a ≤ Real.exp (-b)) :
    A * a ^ (Nat.ceil (((2 * C + E + 1) * N * Real.log L) / b)) / (1 - a) ≤
      L ^ (-(E * N)) := by
  have hL0 : 0 < L := lt_of_lt_of_le (by norm_num) hL
  have hlog : 0 < Real.log L := Real.log_pos (by linarith)
  have hb0 : 0 < b := (Real.log_pos (by norm_num : (1 : ℝ) < 2)).trans_le hb
  have hN1 : (1 : ℝ) ≤ N := by exact_mod_cast hN
  have hceil := Nat.le_ceil (((2 * C + E + 1) * N * Real.log L) / b)
  have hprod : (2 * C + E + 1) * N * Real.log L ≤
      b * (Nat.ceil (((2 * C + E + 1) * N * Real.log L) / b) : ℝ) := by
    have h := (div_le_iff₀ hb0).mp hceil
    nlinarith
  have hlog2 : Real.log 2 ≤ Real.log L := Real.log_le_log (by norm_num) hL
  have hmargin : C * ((N : ℝ) + 1) * Real.log L + (E * N) * Real.log L + Real.log 2 ≤
      b * (Nat.ceil (((2 * C + E + 1) * N * Real.log L) / b) : ℝ) := by
    have hcN : 0 ≤ C * ((N : ℝ) - 1) * Real.log L := by positivity
    have hnlog : Real.log 2 ≤ (N : ℝ) * Real.log L := by nlinarith
    nlinarith
  have ha2 : a ≤ 1 / 2 := by
    calc
      a ≤ Real.exp (-b) := hab
      _ ≤ Real.exp (-Real.log 2) := Real.exp_le_exp.mpr (by linarith)
      _ = 1 / 2 := by rw [Real.exp_neg, Real.exp_log (by norm_num : (0 : ℝ) < 2)]; norm_num
  have hAc : A ≤ Real.exp (C * ((N : ℝ) + 1) * Real.log L) := by
    simpa only [Real.rpow_def_of_pos hL0, mul_comm (Real.log L)] using hAb
  have h := geometric_rank_tail_le_exp
    (Nat.ceil (((2 * C + E + 1) * N * Real.log L) / b)) hAc ha ha2 hab hmargin
  simpa only [Real.rpow_def_of_pos hL0, neg_mul, mul_neg, mul_comm (Real.log L)] using h

end Bounty
end

section

/- Explicit compact smooth Type-II transitions and their Schwartz Fourier transforms. -/

open MeasureTheory
open scoped FourierTransform ContDiff

namespace Bounty

noncomputable def typeIISmoothRho (A t : ℝ) : ℝ :=
  Real.smoothTransition (t + A + 1) * Real.smoothTransition (A + 1 - t)

noncomputable def typeIISmoothCutoff (A : ℝ) (active : Bool) (t : ℝ) : ℝ :=
  typeIISmoothRho A t *
    (if active then Real.smoothTransition t else 1 - Real.smoothTransition t)

theorem typeII_smooth_rho_bounds (A t : ℝ) :
    0 ≤ typeIISmoothRho A t ∧ typeIISmoothRho A t ≤ 1 := by
  constructor
  · exact mul_nonneg (Real.smoothTransition.nonneg _) (Real.smoothTransition.nonneg _)
  · calc
      _ ≤ 1 * Real.smoothTransition (A + 1 - t) :=
        mul_le_mul_of_nonneg_right (Real.smoothTransition.le_one _) (Real.smoothTransition.nonneg _)
      _ ≤ 1 := by simpa using Real.smoothTransition.le_one (A + 1 - t)

theorem typeII_smooth_rho_eq_one {A t : ℝ} (ht : t ∈ Set.Icc (-A) A) :
    typeIISmoothRho A t = 1 := by
  unfold typeIISmoothRho
  rw [Real.smoothTransition.one_of_one_le (by linarith [ht.1]),
    Real.smoothTransition.one_of_one_le (by linarith [ht.2]), mul_one]

theorem typeII_smooth_rho_eq_zero {A t : ℝ} (ht : t ∉ Set.Icc (-A - 1) (A + 1)) :
    typeIISmoothRho A t = 0 := by
  unfold typeIISmoothRho
  by_cases hlo : t < -A - 1
  · rw [Real.smoothTransition.zero_of_nonpos (by linarith), zero_mul]
  · have hhi : A + 1 < t := lt_of_not_ge (fun h => ht ⟨le_of_not_gt hlo, h⟩)
    rw [Real.smoothTransition.zero_of_nonpos (by linarith : A + 1 - t ≤ 0), mul_zero]

theorem typeII_smooth_rho_contDiff (A : ℝ) : ContDiff ℝ ∞ (typeIISmoothRho A) := by
  unfold typeIISmoothRho
  fun_prop

theorem typeII_smooth_rho_hasCompactSupport (A : ℝ) : HasCompactSupport (typeIISmoothRho A) :=
  HasCompactSupport.intro isCompact_Icc (fun _ ht => typeII_smooth_rho_eq_zero ht)

theorem typeII_smooth_cutoff_contDiff (A : ℝ) (active : Bool) :
    ContDiff ℝ ∞ (typeIISmoothCutoff A active) := by
  cases active <;> unfold typeIISmoothCutoff <;> simp only [Bool.false_eq_true, if_false, if_true]
  · exact (typeII_smooth_rho_contDiff A).mul (contDiff_const.sub Real.smoothTransition.contDiff)
  · exact (typeII_smooth_rho_contDiff A).mul Real.smoothTransition.contDiff

theorem typeII_smooth_cutoff_hasCompactSupport (A : ℝ) (active : Bool) :
    HasCompactSupport (typeIISmoothCutoff A active) :=
  (typeII_smooth_rho_hasCompactSupport A).mul_right

theorem typeII_smooth_cutoff_bounds (A t : ℝ) (active : Bool) :
    0 ≤ typeIISmoothCutoff A active t ∧ typeIISmoothCutoff A active t ≤ 1 := by
  have hr := typeII_smooth_rho_bounds A t
  have ht0 := Real.smoothTransition.nonneg t
  have ht1 := Real.smoothTransition.le_one t
  cases active <;> simp only [typeIISmoothCutoff, Bool.false_eq_true, if_false, if_true]
  · constructor
    · exact mul_nonneg hr.1 (by linarith)
    · calc
        _ ≤ typeIISmoothRho A t * 1 := mul_le_mul_of_nonneg_left (by linarith) hr.1
        _ ≤ 1 := by simpa using hr.2
  · constructor
    · exact mul_nonneg hr.1 ht0
    · calc
        _ ≤ typeIISmoothRho A t * 1 := mul_le_mul_of_nonneg_left ht1 hr.1
        _ ≤ 1 := by simpa using hr.2

theorem typeII_smooth_cutoff_sum (A t : ℝ) :
    typeIISmoothCutoff A false t + typeIISmoothCutoff A true t = typeIISmoothRho A t := by
  simp only [typeIISmoothCutoff, Bool.false_eq_true, if_false, if_true]
  ring

theorem typeII_smooth_cutoff_sum_eq_one {A t : ℝ} (ht : t ∈ Set.Icc (-A) A) :
    typeIISmoothCutoff A false t + typeIISmoothCutoff A true t = 1 := by
  rw [typeII_smooth_cutoff_sum, typeII_smooth_rho_eq_one ht]

theorem typeII_smooth_cutoff_eq_transition {A t : ℝ} (active : Bool)
    (ht : t ∈ Set.Icc (-A) A) :
    typeIISmoothCutoff A active t =
      (if active then Real.smoothTransition t else 1 - Real.smoothTransition t) := by
  rw [typeIISmoothCutoff, typeII_smooth_rho_eq_one ht, one_mul]

theorem typeII_complex_cutoff_contDiff (A : ℝ) (active : Bool) :
    ContDiff ℝ ∞ (fun t => (typeIISmoothCutoff A active t : ℂ)) :=
  Complex.ofRealCLM.contDiff.comp (typeII_smooth_cutoff_contDiff A active)

theorem typeII_complex_cutoff_hasCompactSupport (A : ℝ) (active : Bool) :
    HasCompactSupport (fun t => (typeIISmoothCutoff A active t : ℂ)) :=
  (typeII_smooth_cutoff_hasCompactSupport A active).comp_left
    (g := fun x : ℝ => (x : ℂ)) (by simp)

noncomputable def typeIICutoffSchwartz (A : ℝ) (active : Bool) : SchwartzMap ℝ ℂ :=
  (typeII_complex_cutoff_hasCompactSupport A active).toSchwartzMap
    (typeII_complex_cutoff_contDiff A active)

noncomputable def typeIICutoffFourier (A : ℝ) (active : Bool) : SchwartzMap ℝ ℂ :=
  𝓕 (typeIICutoffSchwartz A active)

theorem typeII_cutoff_schwartz_apply (A t : ℝ) (active : Bool) :
    typeIICutoffSchwartz A active t = (typeIISmoothCutoff A active t : ℂ) := rfl

theorem typeII_cutoff_fourier_integrable (A : ℝ) (active : Bool) :
    Integrable (typeIICutoffFourier A active) := (typeIICutoffFourier A active).integrable

theorem typeII_cutoff_fourier_moment_integrable (A : ℝ) (active : Bool) (M : ℕ) :
    Integrable (fun ξ : ℝ => ‖ξ‖ ^ M * ‖typeIICutoffFourier A active ξ‖) :=
  (typeIICutoffFourier A active).integrable_pow_mul volume M

theorem typeII_cutoff_fourier_inversion (A t : ℝ) (active : Bool) :
    (typeIISmoothCutoff A active t : ℂ) =
      ∫ ξ : ℝ, Complex.exp ((2 * Real.pi * ξ * t : ℝ) * Complex.I) *
        typeIICutoffFourier A active ξ := by
  have hi := congrArg (fun f : SchwartzMap ℝ ℂ => f t)
    (FourierPair.fourierInv_fourier_eq (E := SchwartzMap ℝ ℂ)
      (F := SchwartzMap ℝ ℂ) (typeIICutoffSchwartz A active))
  rw [SchwartzMap.fourierInv_coe, Real.fourierInv_eq'] at hi
  change (∫ ξ : ℝ, Complex.exp ((2 * Real.pi * inner ℝ ξ t : ℝ) * Complex.I) •
    typeIICutoffFourier A active ξ) = (typeIISmoothCutoff A active t : ℂ) at hi
  rw [← hi]
  apply integral_congr_ae
  filter_upwards [] with ξ
  simp only [RCLike.inner_apply, starRingEnd_apply, star_trivial, smul_eq_mul]
  congr 2
  push_cast
  ring

end Bounty
end

section

/- Quantitative tails obtained from actual integrable Schwartz moments. -/

open MeasureTheory

namespace Bounty

theorem schwartz_norm_tail_le_moment (g : SchwartzMap ℝ ℂ) (M : ℕ)
    {R : ℝ} (hR : 0 < R) :
    (∫ x in {x : ℝ | R < ‖x‖}, ‖g x‖) ≤
      (∫ x : ℝ, ‖x‖ ^ M * ‖g x‖) / R ^ M := by
  have hs : MeasurableSet {x : ℝ | R < ‖x‖} :=
    (isOpen_lt continuous_const continuous_norm).measurableSet
  have hw := g.integrable_pow_mul volume M
  have hcomp :
      (∫ x in {x : ℝ | R < ‖x‖}, R ^ M * ‖g x‖) ≤
        ∫ x in {x : ℝ | R < ‖x‖}, ‖x‖ ^ M * ‖g x‖ := by
    apply setIntegral_mono_on (g.integrable.norm.const_mul (R ^ M)).integrableOn
      hw.integrableOn hs
    intro x hx
    exact mul_le_mul_of_nonneg_right (pow_le_pow_left₀ hR.le hx.le M) (norm_nonneg _)
  rw [integral_const_mul] at hcomp
  have hwhole : (∫ x in {x : ℝ | R < ‖x‖}, ‖x‖ ^ M * ‖g x‖) ≤
      ∫ x : ℝ, ‖x‖ ^ M * ‖g x‖ := by
    exact setIntegral_le_integral hw
      (Filter.Eventually.of_forall (fun x => mul_nonneg (pow_nonneg (norm_nonneg x) M)
        (norm_nonneg (g x))))
  apply (le_div_iff₀ (pow_pos hR M)).2
  calc
    _ = R ^ M * (∫ x in {x : ℝ | R < ‖x‖}, ‖g x‖) := mul_comm _ _
    _ ≤ _ := hcomp.trans hwhole

theorem schwartz_norm_rapid_tail (g : SchwartzMap ℝ ℂ) (M : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ R : ℝ, 1 ≤ R →
      (∫ x in {x : ℝ | R < ‖x‖}, ‖g x‖) ≤ C * R ^ (-(M : ℝ)) := by
  let I : ℝ := ∫ x : ℝ, ‖x‖ ^ M * ‖g x‖
  have hI : 0 ≤ I := integral_nonneg (fun x =>
    mul_nonneg (pow_nonneg (norm_nonneg x) M) (norm_nonneg (g x)))
  refine ⟨I + 1, by linarith, ?_⟩
  intro R hR
  have hRpos : 0 < R := lt_of_lt_of_le zero_lt_one hR
  calc
    _ ≤ I / R ^ M := schwartz_norm_tail_le_moment g M hRpos
    _ ≤ (I + 1) / R ^ M := div_le_div_of_nonneg_right (by linarith) (pow_nonneg hRpos.le M)
    _ = (I + 1) * R ^ (-(M : ℝ)) := by
      rw [Real.rpow_neg hRpos.le, Real.rpow_natCast, div_eq_mul_inv]

end Bounty
end

section

open Finset

namespace Bounty

theorem complex_finset_product_error {ι : Type*} (s : Finset ι) (f g : ι → ℂ)
    {C ε : ℝ} (hC : 0 ≤ C) (hε : 0 ≤ ε)
    (hf : ∀ i ∈ s, ‖f i‖ ≤ C) (hg : ∀ i ∈ s, ‖g i‖ ≤ C)
    (he : ∀ i ∈ s, ‖f i - g i‖ ≤ ε) :
    ‖(∏ i ∈ s, f i) - ∏ i ∈ s, g i‖ ≤ s.card * ε * C ^ (s.card - 1) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih =>
    have hfs : ∀ i ∈ s, ‖f i‖ ≤ C := fun i hi => hf i (mem_insert_of_mem hi)
    have hgs : ∀ i ∈ s, ‖g i‖ ≤ C := fun i hi => hg i (mem_insert_of_mem hi)
    have hes : ∀ i ∈ s, ‖f i - g i‖ ≤ ε := fun i hi => he i (mem_insert_of_mem hi)
    have hp : ‖∏ i ∈ s, g i‖ ≤ C ^ s.card := by
      rw [norm_prod]
      calc
        _ ≤ ∏ _i ∈ s, C := prod_le_prod₀ (fun i _ => norm_nonneg (g i)) hgs
        _ = _ := by simp
    rw [prod_insert ha, prod_insert ha]
    have hid : f a * (∏ i ∈ s, f i) - g a * (∏ i ∈ s, g i) =
        f a * ((∏ i ∈ s, f i) - ∏ i ∈ s, g i) +
          (f a - g a) * ∏ i ∈ s, g i := by ring
    rw [hid]
    apply (norm_add_le _ _).trans
    rw [norm_mul, norm_mul]
    have hb := add_le_add
      (mul_le_mul (hf a (mem_insert_self a s)) (ih hfs hgs hes)
        (norm_nonneg _) hC)
      (mul_le_mul (he a (mem_insert_self a s)) hp (norm_nonneg _) hε)
    apply hb.trans
    rw [card_insert_of_notMem ha]
    cases hn : s.card with
    | zero => simp
    | succ n =>
      simp only [Nat.succ_sub_one, Nat.cast_succ, pow_succ]
      ring_nf
      exact le_rfl

end Bounty
end

section

/- Every finite supported P-tail is bounded by the actual marked harmonic tail. -/

open Finset Real

namespace Bounty

theorem candidate_P_harmonic_term_nonneg (c L : ℝ) {q : ℝ} (hq : 0 ≤ q) (n : ℕ) :
    0 ≤ candidatePHarmonicTerm c L q n := by
  apply div_nonneg
  · exact marked_divisor_weight_nonneg _ _ hq _ _
      (fun _ _ => sum_nonneg (fun _ _ => by positivity)) _
  · exact Nat.cast_nonneg _

theorem candidate_finite_P_tail_le {c L q : ℝ} (hcL : 0 ≤ c*L) (hq : 0 ≤ q)
    (X : ℝ) (S : Finset ℕ)
    (hsupport : ∀ p ∈ S, p ∈ Nat.factoredNumbers
      ((candidatePIndices c L).biUnion (candidatePBand (c*L))))
    (hcut : ∀ p ∈ S, X ≤ (p : ℝ)) :
    (∑ p ∈ S, candidatePWeight c L q p / (p : ℝ)) ≤
      candidateMarkedSmoothTail c L q 1 X := by
  classical
  let P := (candidatePIndices c L).biUnion (candidatePBand (c*L))
  let T : Finset (Nat.factoredNumbers P) := S.subtype (fun p => p ∈ Nat.factoredNumbers P)
  have hbig : Summable (fun p : Nat.factoredNumbers P =>
      if X ≤ (p.val : ℝ) then candidatePHarmonicTerm c L q p.val else 0) := by
    simpa only [Set.indicator, Set.mem_ofPred_eq] using!
      (candidate_P_harmonic_summable hcL q).indicator {p | X ≤ (p.val : ℝ)}
  calc
    _ = ∑ p ∈ S, candidatePHarmonicTerm c L q p := by
      apply sum_congr rfl
      intro p hp
      exact candidate_P_weight_harmonic c L q (Nat.ne_zero_of_mem_factoredNumbers (hsupport p hp))
    _ = ∑ p ∈ T, candidatePHarmonicTerm c L q p.val := by
      symm
      exact sum_subtype_of_mem _ hsupport
    _ = ∑ p ∈ T, if X ≤ (p.val : ℝ) then candidatePHarmonicTerm c L q p.val else 0 := by
      apply sum_congr rfl
      intro p hp
      exact (if_pos (hcut p.val (mem_subtype.mp hp))).symm
    _ ≤ ∑' p : Nat.factoredNumbers P,
        if X ≤ (p.val : ℝ) then candidatePHarmonicTerm c L q p.val else 0 := by
      apply hbig.sum_le_tsum
      intro p hp
      split_ifs
      · exact candidate_P_harmonic_term_nonneg c L hq p.val
      · rfl
    _ = candidateMarkedSmoothTail c L q 1 X := rfl

theorem candidate_Q_window_le_harmonic (c L : ℝ) (r jStar : ℕ) {p : ℕ} (hp : p ≠ 0) :
    (∑ n ∈ arithmeticProductWindow p (exp L), candidateQWeight c L r jStar n) ≤
      (16*exp L/(p : ℝ))*candidateQHarmonicMass c L r jStar := by
  have hp0 : (0 : ℝ) < p := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hp)
  calc
    _ ≤ ∑ n ∈ arithmeticProductWindow p (exp L),
        (16*exp L/(p : ℝ))*(candidateQWeight c L r jStar n/(n : ℝ)) := by
      apply sum_le_sum
      intro n hn
      have hwin := (mem_arithmeticProductWindow_iff hp (exp L)).mp hn
      have hn0 : (0 : ℝ) < n := by
        have hh : 0 < (p : ℝ)*(n : ℝ) := by
          simpa only [Nat.cast_mul] using (exp_pos L).trans hwin.1
        exact (mul_pos_iff_of_pos_left hp0).mp hh
      have hnle : (n : ℝ) ≤ 16*exp L/(p : ℝ) := by
        apply (le_div_iff₀ hp0).mpr
        simpa only [Nat.cast_mul, mul_comm] using hwin.2
      calc
        _ = (n : ℝ)*(candidateQWeight c L r jStar n/(n : ℝ)) := by field_simp
        _ ≤ _ := mul_le_mul_of_nonneg_right hnle
          (div_nonneg (candidate_Q_weight_nonneg c L r jStar n) hn0.le)
    _ = (16*exp L/(p : ℝ))*∑ n ∈ arithmeticProductWindow p (exp L),
        candidateQWeight c L r jStar n/(n : ℝ) := (mul_sum _ _ _).symm
    _ ≤ _ := mul_le_mul_of_nonneg_left
      ((candidate_Q_harmonic_summable c L r jStar).sum_le_tsum _
        (fun n _ => div_nonneg (candidate_Q_weight_nonneg c L r jStar n) (Nat.cast_nonneg n)))
      (by positivity)

end Bounty
end

section

/- Complex weighted product fibers for labelled prime slots in disjoint pools. -/

open Finset

namespace Bounty

/-- Labelled slots may have arbitrary finite index types and arbitrary finite restrictions.
The factorial cost is determined separately in each disjoint prime pool. -/
theorem card_labelled_prime_product_fiber
    {I G Ω : Type*} [Fintype I] [Fintype G] [DecidableEq G] [Fintype Ω]
    (group : I → G) (P : G → Finset ℕ)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h)))
    (x : Ω → I → ℕ) (hxinj : Function.Injective x)
    (hx : ∀ a i, x a i ∈ P (group i)) (n : ℕ) :
    Nat.card {a : Ω // (∏ i, x a i) = n} ≤
      ∏ g, (Fintype.card {i : I // group i = g}).factorial := by
  classical
  let K (g : G) := {i : I // group i = g}
  let e (g : G) : Fin (Fintype.card (K g)) ≃ K g := (Fintype.equivFin (K g)).symm
  let y (a : Ω) (g : G) (j : Fin (Fintype.card (K g))) : ℕ := x a (e g j).val
  have hyinj : Function.Injective y := by
    intro a b hab
    apply hxinj
    funext i
    have hi := congrFun (congrFun hab (group i)) ((e (group i)).symm ⟨i, rfl⟩)
    simpa only [y, Equiv.apply_symm_apply] using hi
  have hy : ∀ a g j, y a g j ∈ P g := by
    intro a g j
    dsimp only [y]
    simpa only [(e g j).property] using hx a (e g j).val
  have hyprod (a : Ω) : (∏ g, ∏ j, y a g j) = ∏ i, x a i := by
    calc
      _ = ∏ g, ∏ i : K g, x a i.val := by
        apply prod_congr rfl
        intro g _
        exact Fintype.prod_equiv (e g) _ _ (fun _ => rfl)
      _ = _ := Fintype.prod_fiberwise group (x a)
  have h := card_prime_group_product_fiber P (fun g => Fintype.card (K g))
    hprime hdisj y hyinj hy n
  simpa only [hyprod, K] using h

/-- Unit-bounded complex weights preserve the unweighted factorial fiber bound. -/
theorem norm_labelled_prime_product_fiber_sum_le
    {I G Ω : Type*} [Fintype I] [Fintype G] [DecidableEq G] [Fintype Ω]
    (group : I → G) (P : G → Finset ℕ)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h)))
    (x : Ω → I → ℕ) (hxinj : Function.Injective x)
    (hx : ∀ a i, x a i ∈ P (group i))
    (w : Ω → ℂ) (hw : ∀ a, ‖w a‖ ≤ 1) (n : ℕ) :
    ‖∑ a : Ω, if (∏ i, x a i) = n then w a else 0‖ ≤
      ∏ g, ((Fintype.card {i : I // group i = g}).factorial : ℝ) := by
  classical
  calc
    _ ≤ ∑ a : Ω, ‖if (∏ i, x a i) = n then w a else 0‖ := norm_sum_le _ _
    _ ≤ ∑ a : Ω, if (∏ i, x a i) = n then (1 : ℝ) else 0 := by
      apply sum_le_sum
      intro a _
      split_ifs with ha
      · exact hw a
      · simp
    _ = (Nat.card {a : Ω // (∏ i, x a i) = n} : ℝ) := by
      simp [Nat.card_eq_fintype_card, Fintype.card_subtype]
    _ ≤ _ := by
      exact_mod_cast card_labelled_prime_product_fiber group P hprime hdisj x hxinj hx n

/-- A common per-pool slot cap gives a uniform factorial power bound. -/
theorem norm_labelled_prime_product_fiber_sum_le_factorial_pow
    {I G Ω : Type*} [Fintype I] [Fintype G] [DecidableEq G] [Fintype Ω]
    (group : I → G) (P : G → Finset ℕ)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h)))
    (x : Ω → I → ℕ) (hxinj : Function.Injective x)
    (hx : ∀ a i, x a i ∈ P (group i))
    (w : Ω → ℂ) (hw : ∀ a, ‖w a‖ ≤ 1)
    (r : ℕ) (hr : ∀ g, Fintype.card {i : I // group i = g} ≤ r) (n : ℕ) :
    ‖∑ a : Ω, if (∏ i, x a i) = n then w a else 0‖ ≤
      (r.factorial : ℝ) ^ Fintype.card G := by
  apply (norm_labelled_prime_product_fiber_sum_le group P hprime hdisj x hxinj hx w hw n).trans
  calc
    _ ≤ ∏ _g : G, (r.factorial : ℝ) := by
      apply prod_le_prod₀
      · intro g _
        positivity
      · intro g _
        exact_mod_cast Nat.factorial_le (hr g)
    _ = _ := by simp

/-- Dividing by the common full factorial normalization bounds each fiber by one. -/
theorem norm_labelled_prime_product_fiber_sum_div_factorial_pow_le_one
    {I G Ω : Type*} [Fintype I] [Fintype G] [DecidableEq G] [Fintype Ω]
    (group : I → G) (P : G → Finset ℕ)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h)))
    (x : Ω → I → ℕ) (hxinj : Function.Injective x)
    (hx : ∀ a i, x a i ∈ P (group i))
    (w : Ω → ℂ) (hw : ∀ a, ‖w a‖ ≤ 1)
    (r : ℕ) (hr : ∀ g, Fintype.card {i : I // group i = g} ≤ r) (n : ℕ) :
    ‖(∑ a : Ω, if (∏ i, x a i) = n then w a else 0) /
      (((r.factorial : ℝ) ^ Fintype.card G : ℝ) : ℂ)‖ ≤ 1 := by
  rw [norm_div, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (by positivity : 0 ≤ (r.factorial : ℝ) ^ Fintype.card G)]
  apply (div_le_one (by positivity : 0 < (r.factorial : ℝ) ^ Fintype.card G)).mpr
  exact norm_labelled_prime_product_fiber_sum_le_factorial_pow
    group P hprime hdisj x hxinj hx w hw r hr n

/-- Exact per-pool factorial normalization also gives a unit bound. -/
theorem norm_labelled_prime_product_fiber_sum_div_le_one
    {I G Ω : Type*} [Fintype I] [Fintype G] [DecidableEq G] [Fintype Ω]
    (group : I → G) (P : G → Finset ℕ)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h)))
    (x : Ω → I → ℕ) (hxinj : Function.Injective x)
    (hx : ∀ a i, x a i ∈ P (group i))
    (w : Ω → ℂ) (hw : ∀ a, ‖w a‖ ≤ 1) (n : ℕ) :
    ‖(∑ a : Ω, if (∏ i, x a i) = n then w a else 0) /
      (((∏ g, ((Fintype.card {i : I // group i = g}).factorial : ℝ)) : ℝ) : ℂ)‖ ≤ 1 := by
  have hpos : 0 < ∏ g, ((Fintype.card {i : I // group i = g}).factorial : ℝ) := by
    exact prod_pos (fun g _ => Nat.cast_pos.mpr (Nat.factorial_pos _))
  rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hpos]
  exact (div_le_one hpos).mpr
    (norm_labelled_prime_product_fiber_sum_le group P hprime hdisj x hxinj hx w hw n)

/-- The two factorial budgets of a slot split fit inside the full normalization. -/
theorem split_group_factorial_product_le {G : Type*} [Fintype G]
    (k l : G → ℕ) (r : ℕ) (h : ∀ g, k g + l g ≤ r) :
    (∏ g, ((k g).factorial : ℝ)) * (∏ g, ((l g).factorial : ℝ)) ≤
      (r.factorial : ℝ) ^ Fintype.card G := by
  rw [← prod_mul_distrib]
  calc
    _ ≤ ∏ _g : G, (r.factorial : ℝ) := by
      apply prod_le_prod₀
      · intro g _
        positivity
      · intro g _
        have hfac : (k g).factorial * (l g).factorial ≤ r.factorial :=
          (Nat.le_of_dvd (Nat.factorial_pos _) (Nat.factorial_mul_factorial_dvd_factorial_add _ _)).trans
            (Nat.factorial_le (h g))
        exact_mod_cast hfac
    _ = _ := by simp


end Bounty
end

section

/- The full Q-slot factorial normalization has fixed polynomial growth. -/

open Finset Filter

namespace Bounty

theorem eventually_candidate_factorial_normalization_le_rpow {c : ℝ}
    (hc : 0 < c) (r : ℕ) :
    ∀ᶠ L : ℝ in atTop,
      (r.factorial : ℝ) ^ (candidateQIndices c L).card ≤
        L ^ ((1 / Real.log 2 + 1) * Real.log (r.factorial : ℝ)) := by
  have hfac : (1 : ℝ) ≤ r.factorial := by
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr (Nat.factorial_ne_zero r)
  filter_upwards [eventually_candidateQIndices_geometry hc,
    eventually_gt_atTop (0 : ℝ)] with L hgeom hL
  simpa only [prod_const] using
    group_product_bound_of_log_card (candidateQIndices c L) (fun _ => (r.factorial : ℝ))
      hfac hL (fun _ _ => Nat.cast_nonneg _) (fun _ _ => le_rfl) hgeom.1

theorem exists_candidate_factorial_normalization_polynomial_bound {c : ℝ}
    (hc : 0 < c) (r : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ L : ℝ in atTop,
      (r.factorial : ℝ) ^ (candidateQIndices c L).card ≤ L ^ C := by
  have hfac : (1 : ℝ) ≤ r.factorial := by
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr (Nat.factorial_ne_zero r)
  refine ⟨(1 / Real.log 2 + 1) * Real.log (r.factorial : ℝ), ?_,
    eventually_candidate_factorial_normalization_le_rpow hc r⟩
  exact mul_nonneg (by positivity) (Real.log_nonneg hfac)


end Bounty
end

section

/- Uniform polynomial derivative bounds on fixed compact support control all Schwartz seminorms. -/

open Finset MeasureTheory
open scoped FourierTransform

namespace Bounty

theorem schwartz_seminorm_polynomial_of_fixed_support {I : Type*}
    (f : I → SchwartzMap (EuclideanSpace ℝ (Fin 3)) ℂ) (w : I → ℝ)
    (hw : ∀ p, 1 ≤ w p) (R : ℝ) (hR : 0 ≤ R)
    (hsupport : ∀ p, tsupport (f p) ⊆ Metric.closedBall 0 R)
    (hderiv : ∀ n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p x, ‖iteratedFDeriv ℝ n (f p) x‖ ≤ C*(w p)^d) :
    ∀ k n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p, SchwartzMap.seminorm ℂ k n (f p) ≤ C*(w p)^d := by
  intro k n
  obtain ⟨d,C,hC,hbound⟩ := hderiv n
  refine ⟨d,R^k*C,mul_nonneg (pow_nonneg hR _) hC,?_⟩
  intro p
  have hwp : 0 ≤ w p := zero_le_one.trans (hw p)
  apply SchwartzMap.seminorm_le_bound ℂ k n (f p) (by positivity)
  intro x
  by_cases hz : iteratedFDeriv ℝ n (f p) x = 0
  · rw [hz, norm_zero, mul_zero]
    positivity
  · have hx : x ∈ tsupport (f p) := (support_iteratedFDeriv_subset n) hz
    have hxR : ‖x‖ ≤ R := by
      simpa only [Metric.mem_closedBall, dist_zero_right] using hsupport p hx
    calc
      _ ≤ R^k*(C*(w p)^d) := mul_le_mul (pow_le_pow_left₀ (norm_nonneg _) hxR _)
        (hbound p x) (norm_nonneg _) (pow_nonneg hR _)
      _ = _ := by ring

theorem continuous_schwartz_seminorm_polynomial {I : Type*}
    (f : I → SchwartzMap (EuclideanSpace ℝ (Fin 3)) ℂ) (w : I → ℝ)
    (hw : ∀ p, 1 ≤ w p)
    (hsemi : ∀ k n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p, SchwartzMap.seminorm ℂ k n (f p) ≤ C*(w p)^d)
    (q : Seminorm ℂ (SchwartzMap (EuclideanSpace ℝ (Fin 3)) ℂ)) (hq : Continuous q) :
    ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ p, q (f p) ≤ C*(w p)^d := by
  classical
  choose d C hC hbound using hsemi
  obtain ⟨s,K,hK,hqK⟩ := Seminorm.bound_of_continuous
    (schwartz_withSeminorms ℂ (EuclideanSpace ℝ (Fin 3)) ℂ) q hq
  let D := s.sup (fun kn => d kn.1 kn.2)
  let M := ∑ kn ∈ s, C kn.1 kn.2
  have hM : 0 ≤ M := sum_nonneg (fun kn _ => hC kn.1 kn.2)
  refine ⟨D,(K : ℝ)*M,mul_nonneg K.coe_nonneg hM,?_⟩
  intro p
  have hwp : 0 ≤ w p := zero_le_one.trans (hw p)
  have hs : s.sup (schwartzSeminormFamily ℂ (EuclideanSpace ℝ (Fin 3)) ℂ) (f p) ≤ M*(w p)^D := by
    apply Seminorm.finset_sup_apply_le (by positivity)
    intro kn hkn
    have hCM : C kn.1 kn.2 ≤ M := single_le_sum (fun kn _ => hC kn.1 kn.2) hkn
    have hdD : d kn.1 kn.2 ≤ D := Finset.le_sup (f := fun kn => d kn.1 kn.2) hkn
    exact (hbound kn.1 kn.2 p).trans (mul_le_mul hCM
      (pow_le_pow_right₀ (hw p) hdD) (pow_nonneg (zero_le_one.trans (hw p)) _) hM)
  calc
    _ ≤ (K : ℝ)*s.sup (schwartzSeminormFamily ℂ (EuclideanSpace ℝ (Fin 3)) ℂ) (f p) := hqK (f p)
    _ ≤ (K : ℝ)*(M*(w p)^D) := mul_le_mul_of_nonneg_left hs K.coe_nonneg
    _ = _ := by ring

end Bounty
end

section

open scoped ContDiff

namespace Bounty

theorem norm_iteratedFDeriv_slice_le {P E F : Type*}
    [NormedAddCommGroup P] [NormedSpace ℝ P]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F]
    {G : P × E → F} (hG : ContDiff ℝ ∞ G) (p : P) (x : E) (n : ℕ) :
    ‖iteratedFDeriv ℝ n (fun x => G (p, x)) x‖ ≤ ‖iteratedFDeriv ℝ n G (p, x)‖ := by
  let j : E →L[ℝ] P × E := ContinuousLinearMap.inr ℝ P E
  let H : P × E → F := fun y => G (y + (p, 0))
  have hH : ContDiff ℝ ∞ H := hG.comp (contDiff_id.add contDiff_const)
  have heq : (fun x => G (p, x)) = H ∘ j := by
    funext y
    simp [H, j]
  rw [heq, j.iteratedFDeriv_comp_right hH x (i := n) (by exact WithTop.coe_le_coe.mpr le_top)]
  apply (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans
  have hj : ‖j‖ ≤ 1 := ContinuousLinearMap.norm_inr_le_one ℝ P E
  have hprod : (∏ _i : Fin n, ‖j‖) ≤ 1 :=
    Finset.prod_le_one₀ (fun _ _ => norm_nonneg j) (fun _ _ => hj)
  calc
    _ ≤ ‖iteratedFDeriv ℝ n H (j x)‖ * 1 := mul_le_mul_of_nonneg_left hprod (norm_nonneg _)
    _ = _ := by
      simp only [mul_one, H, iteratedFDeriv_comp_add_right]
      simp [j]

end Bounty
end

section

/- Quantitative tails obtained from actual integrable Schwartz moments. -/

open MeasureTheory

namespace Bounty

theorem euclidean_schwartz_norm_tail_le_moment {N : ℕ} (g : SchwartzMap (EuclideanSpace ℝ (Fin N)) ℂ) (M : ℕ)
    {R : ℝ} (hR : 0 < R) :
    (∫ x in {x : EuclideanSpace ℝ (Fin N) | R < ‖x‖}, ‖g x‖) ≤
      (∫ x : EuclideanSpace ℝ (Fin N), ‖x‖ ^ M * ‖g x‖) / R ^ M := by
  have hs : MeasurableSet {x : EuclideanSpace ℝ (Fin N) | R < ‖x‖} :=
    (isOpen_lt continuous_const continuous_norm).measurableSet
  have hw := g.integrable_pow_mul volume M
  have hcomp :
      (∫ x in {x : EuclideanSpace ℝ (Fin N) | R < ‖x‖}, R ^ M * ‖g x‖) ≤
        ∫ x in {x : EuclideanSpace ℝ (Fin N) | R < ‖x‖}, ‖x‖ ^ M * ‖g x‖ := by
    apply setIntegral_mono_on (g.integrable.norm.const_mul (R ^ M)).integrableOn
      hw.integrableOn hs
    intro x hx
    exact mul_le_mul_of_nonneg_right (pow_le_pow_left₀ hR.le hx.le M) (norm_nonneg _)
  rw [integral_const_mul] at hcomp
  have hwhole : (∫ x in {x : EuclideanSpace ℝ (Fin N) | R < ‖x‖}, ‖x‖ ^ M * ‖g x‖) ≤
      ∫ x : EuclideanSpace ℝ (Fin N), ‖x‖ ^ M * ‖g x‖ := by
    exact setIntegral_le_integral hw
      (Filter.Eventually.of_forall (fun x => mul_nonneg (pow_nonneg (norm_nonneg x) M)
        (norm_nonneg (g x))))
  apply (le_div_iff₀ (pow_pos hR M)).2
  calc
    _ = R ^ M * (∫ x in {x : EuclideanSpace ℝ (Fin N) | R < ‖x‖}, ‖g x‖) := mul_comm _ _
    _ ≤ _ := hcomp.trans hwhole


end Bounty
end

section

/- Scalar costs for the actual candidate allocation slots. The truncation
constant may depend on its chosen order; the order threshold does not depend
on that constant or on the allocation target and initial scale. -/

open Finset Filter

namespace Bounty

noncomputable def candidateSlotCostExponent (r : ℕ) (C : ℝ) : ℝ :=
  (1 / Real.log 2 + 1) * (r : ℝ) * Real.log C

theorem candidate_slot_cost_exponent_nonneg (r : ℕ) {C : ℝ} (hC : 1 ≤ C) :
    0 ≤ candidateSlotCostExponent r C := by
  unfold candidateSlotCostExponent
  exact mul_nonneg (mul_nonneg (by positivity) (Nat.cast_nonneg _))
    (Real.log_nonneg hC)

theorem eventually_candidate_slot_power_le_rpow {c C : ℝ}
    (hc : 0 < c) (hC : 1 ≤ C) (r : ℕ) :
    ∀ᶠ L : ℝ in atTop,
      C ^ ((candidateQIndices c L).card * r) ≤
        L ^ candidateSlotCostExponent r C := by
  filter_upwards [eventually_candidateQIndices_geometry hc,
    eventually_gt_atTop (0 : ℝ)] with L hgeom hL
  have hp := group_product_bound_of_log_card (candidateQIndices c L)
    (fun _ => C ^ r) (one_le_pow₀ hC) hL
    (fun _ _ => pow_nonneg (by linarith) _) (fun _ _ => le_rfl) hgeom.1
  simpa only [prod_const, ← pow_mul, Nat.mul_comm r, Real.log_pow,
    candidateSlotCostExponent, mul_assoc] using hp

theorem all_pattern_truncation_cost_le (N : ℕ) {C D : ℝ}
    (hC : 1 ≤ C) (hD : 0 ≤ D) :
    (2 : ℝ) ^ N * N * D * C ^ (N - 1) ≤ D * (4 * C) ^ N := by
  have hN : (N : ℝ) ≤ (2 : ℝ) ^ N := by
    exact_mod_cast (Nat.lt_two_pow_self (n := N)).le
  have hC0 : 0 ≤ C := zero_le_one.trans hC
  have hp : C ^ (N - 1) ≤ C ^ N := pow_le_pow_right₀ hC (Nat.sub_le _ _)
  calc
    _ = D * ((2 : ℝ) ^ N * ((N : ℝ) * C ^ (N - 1))) := by ring
    _ ≤ D * ((2 : ℝ) ^ N * ((2 : ℝ) ^ N * C ^ N)) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left (mul_le_mul hN hp (pow_nonneg hC0 _) (by positivity))
          (by positivity)) hD
    _ = _ := by rw [mul_pow, show (4 : ℝ) = 2 * 2 by norm_num, mul_pow]; ring

theorem eventually_candidate_truncation_cost_le {c C D B : ℝ}
    (hc : 0 < c) (hC : 1 ≤ C) (hD : 0 ≤ D) (r M : ℕ)
    (hM : candidateSlotCostExponent r (4 * C) + B + 1 ≤ (M : ℝ)) :
    ∀ᶠ L : ℝ in atTop,
      (2 : ℝ) ^ ((candidateQIndices c L).card * r) *
        ((candidateQIndices c L).card * r : ℕ) * D *
        C ^ ((candidateQIndices c L).card * r - 1) * L ^ (-(M : ℝ)) ≤
          L ^ (-B) := by
  have h4C : 1 ≤ 4 * C := by linarith
  filter_upwards [eventually_candidate_slot_power_le_rpow hc h4C r,
    eventually_ge_atTop (1 : ℝ), eventually_ge_atTop D] with L hp hL hDL
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  calc
    _ ≤ (D * (4 * C) ^ ((candidateQIndices c L).card * r)) * L ^ (-(M : ℝ)) :=
      mul_le_mul_of_nonneg_right (all_pattern_truncation_cost_le _ hC hD)
        (Real.rpow_nonneg hL0.le _)
    _ ≤ (L * L ^ candidateSlotCostExponent r (4 * C)) * L ^ (-(M : ℝ)) :=
      mul_le_mul_of_nonneg_right
        (mul_le_mul hDL hp (by positivity) hL0.le) (Real.rpow_nonneg hL0.le _)
    _ = L ^ (1 + candidateSlotCostExponent r (4 * C) - (M : ℝ)) := by
      rw [sub_eq_add_neg, Real.rpow_add hL0, Real.rpow_add hL0, Real.rpow_one]
    _ ≤ L ^ (-B) := Real.rpow_le_rpow_of_exponent_le hL (by linarith)

theorem exists_candidate_truncation_order {c C : ℝ}
    (hc : 0 < c) (hC : 1 ≤ C) (r : ℕ) (B : ℝ) :
    ∃ M₀ : ℕ, ∀ M : ℕ, M₀ ≤ M → ∀ D : ℝ, 0 ≤ D →
      ∀ᶠ L : ℝ in atTop,
        (2 : ℝ) ^ ((candidateQIndices c L).card * r) *
          ((candidateQIndices c L).card * r : ℕ) * D *
          C ^ ((candidateQIndices c L).card * r - 1) * L ^ (-(M : ℝ)) ≤
            L ^ (-B) := by
  obtain ⟨M₀, hM₀⟩ := exists_nat_ge (candidateSlotCostExponent r (4 * C) + B + 1)
  refine ⟨M₀, fun M hM D hD => eventually_candidate_truncation_cost_le hc hC hD r M ?_⟩
  exact hM₀.trans (by exact_mod_cast hM)

end Bounty
end

section

/- Finite perturbations supported on a boundary set, with arbitrary complex inner sums. -/

open Finset

namespace Bounty

theorem finite_boundary_perturbation_norm_le
    (T S : Finset ℕ) (μ : ℕ → ℝ) (ε G : ℕ → ℂ)
    (hμ : ∀ u, 0 ≤ μ u)
    (hsupport : ∀ u ∈ T, u ∉ S → ε u = 0)
    (hε : ∀ u ∈ T ∩ S, ‖ε u‖ ≤ 1) :
    ‖∑ u ∈ T, (μ u : ℂ) * ε u * G u‖ ≤ ∑ u ∈ S, μ u * ‖G u‖ := by
  classical
  have hrestrict : (∑ u ∈ T, (μ u : ℂ) * ε u * G u) =
      ∑ u ∈ T ∩ S, (μ u : ℂ) * ε u * G u := by
    symm
    apply sum_subset inter_subset_left
    intro u hu hnot
    have huS : u ∉ S := fun hs => hnot (mem_inter.mpr ⟨hu, hs⟩)
    rw [hsupport u hu huS, mul_zero, zero_mul]
  rw [hrestrict]
  calc
    _ ≤ ∑ u ∈ T ∩ S, ‖(μ u : ℂ) * ε u * G u‖ := norm_sum_le _ _
    _ ≤ ∑ u ∈ T ∩ S, μ u * ‖G u‖ := by
      apply sum_le_sum
      intro u hu
      rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hμ u)]
      simpa only [mul_one] using
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (hε u hu) (hμ u)) (norm_nonneg (G u))
    _ ≤ _ := sum_le_sum_of_subset_of_nonneg inter_subset_right
      (fun u _ _ => mul_nonneg (hμ u) (norm_nonneg (G u)))

theorem finite_divisor_boundary_perturbation_norm_le
    (T S : Finset ℕ) (μ : ℕ → ℝ) (ε : ℕ → ℂ) (F : ℕ → ℕ → ℂ)
    (hμ : ∀ u, 0 ≤ μ u)
    (hsupport : ∀ u ∈ T, u ∉ S → ε u = 0)
    (hε : ∀ u ∈ T ∩ S, ‖ε u‖ ≤ 1) :
    ‖∑ u ∈ T, (μ u : ℂ) * ε u * (∑ m ∈ (2 * u + 1).divisors, F u m)‖ ≤
      ∑ u ∈ S, μ u * (∑ m ∈ (2 * u + 1).divisors, ‖F u m‖) := by
  apply (finite_boundary_perturbation_norm_le T S μ ε
    (fun u => ∑ m ∈ (2 * u + 1).divisors, F u m) hμ hsupport hε).trans
  apply sum_le_sum
  intro u _
  exact mul_le_mul_of_nonneg_left (norm_sum_le _ _) (hμ u)

/-- Both sharp and smoothed terms use the same outer finite domain. -/
theorem finite_sharp_smoothed_difference_eq
    (T W : Finset ℕ) (μ ψ : ℕ → ℝ) (G : ℕ → ℂ) :
    (∑ u ∈ T ∩ W, (μ u : ℂ) * G u) -
        (∑ u ∈ T, (μ u : ℂ) * (ψ u : ℂ) * G u) =
      ∑ u ∈ T, (μ u : ℂ) * (((if u ∈ W then 1 else 0 : ℝ) - ψ u : ℝ) : ℂ) * G u := by
  classical
  rw [← filter_mem_eq_inter, sum_filter, ← sum_sub_distrib]
  apply sum_congr rfl
  intro u _
  by_cases hu : u ∈ W <;>
    simp only [hu, if_true, if_false, Complex.ofReal_sub, Complex.ofReal_one, Complex.ofReal_zero] <;>
    ring

theorem finite_sharp_smoothed_difference_norm_le
    (T S W : Finset ℕ) (μ ψ : ℕ → ℝ) (G : ℕ → ℂ)
    (hμ : ∀ u, 0 ≤ μ u) (hψ : ∀ u ∈ T, 0 ≤ ψ u ∧ ψ u ≤ 1)
    (hmatch : ∀ u ∈ T, u ∉ S → ψ u = if u ∈ W then 1 else 0) :
    ‖(∑ u ∈ T ∩ W, (μ u : ℂ) * G u) -
        (∑ u ∈ T, (μ u : ℂ) * (ψ u : ℂ) * G u)‖ ≤
      ∑ u ∈ S, μ u * ‖G u‖ := by
  rw [finite_sharp_smoothed_difference_eq]
  apply finite_boundary_perturbation_norm_le T S μ _ G hμ
  · intro u hu hnot
    rw [hmatch u hu hnot, sub_self, Complex.ofReal_zero]
  · intro u hu
    obtain ⟨hψ0, hψ1⟩ := hψ u (mem_inter.mp hu).1
    rw [Complex.norm_real, Real.norm_eq_abs, abs_le]
    by_cases huW : u ∈ W
    · simp only [if_pos huW]
      constructor <;> linarith
    · simp only [if_neg huW]
      constructor <;> linarith

theorem finite_divisor_sharp_smoothed_difference_norm_le
    (T S W : Finset ℕ) (μ ψ : ℕ → ℝ) (F : ℕ → ℕ → ℂ)
    (hμ : ∀ u, 0 ≤ μ u) (hψ : ∀ u ∈ T, 0 ≤ ψ u ∧ ψ u ≤ 1)
    (hmatch : ∀ u ∈ T, u ∉ S → ψ u = if u ∈ W then 1 else 0) :
    ‖(∑ u ∈ T ∩ W, (μ u : ℂ) * (∑ m ∈ (2 * u + 1).divisors, F u m)) -
        (∑ u ∈ T, (μ u : ℂ) * (ψ u : ℂ) * (∑ m ∈ (2 * u + 1).divisors, F u m))‖ ≤
      ∑ u ∈ S, μ u * (∑ m ∈ (2 * u + 1).divisors, ‖F u m‖) := by
  apply (finite_sharp_smoothed_difference_norm_le T S W μ ψ
    (fun u => ∑ m ∈ (2 * u + 1).divisors, F u m) hμ hψ hmatch).trans
  apply sum_le_sum
  intro u _
  exact mul_le_mul_of_nonneg_left (norm_sum_le _ _) (hμ u)


end Bounty
end

section

/- Include the initial active labels in the same distinctness condition as every later birth. -/

open Classical

namespace Bounty

def initialAndBirthLabels {I J α : Type*} (initial : I → α) (birth : J → Option α) :
    I ⊕ J → Option α := Sum.elim (fun i => some (initial i)) birth

theorem initial_birth_distinctness_iff {I J α : Type*}
    (initial : I → α) (birth : J → Option α) :
    (∀ a b z, initialAndBirthLabels initial birth a = some z →
      initialAndBirthLabels initial birth b = some z → a = b) ↔
      Function.Injective initial ∧
        (∀ a b z, birth a = some z → birth b = some z → a = b) ∧
        (∀ i j, birth j ≠ some (initial i)) := by
  constructor
  · intro h
    refine ⟨?_, ?_, ?_⟩
    · intro i j hij
      exact Sum.inl.inj (h (.inl i) (.inl j) (initial i) rfl (by
        change some (initial j) = some (initial i)
        rw [hij]))
    · intro a b z ha hb
      exact Sum.inr.inj (h (.inr a) (.inr b) z ha hb)
    · intro i j hj
      have hbad := h (.inl i) (.inr j) (initial i) rfl hj
      cases hbad
  · rintro ⟨hinj, hbirth, havoid⟩ a b z ha hb
    cases a with
    | inl i =>
      cases b with
      | inl j =>
        exact congrArg Sum.inl (hinj (Option.some.inj (ha.trans hb.symm)))
      | inr j =>
        exact False.elim (havoid i j (hb.trans ha.symm))
    | inr i =>
      cases b with
      | inl j =>
        exact False.elim (havoid j i (ha.trans hb.symm))
      | inr j =>
        exact congrArg Sum.inr (hbirth i j z ha hb)

theorem initial_birth_indicator_factor {I J α R : Type*} [MulZeroOneClass R]
    (initial : I → α) (birth : J → Option α) (hinitial : Function.Injective initial)
    (w : R) :
    (if ∀ i j, birth j ≠ some (initial i) then (1 : R) else 0) *
      (if ∀ a b z, birth a = some z → birth b = some z → a = b then (1 : R) else 0) * w =
      if ∀ a b z, initialAndBirthLabels initial birth a = some z →
        initialAndBirthLabels initial birth b = some z → a = b then w else 0 := by
  classical
  rw [initial_birth_distinctness_iff]
  by_cases hd : ∀ a b z, birth a = some z → birth b = some z → a = b <;>
    by_cases ha : ∀ i j, birth j ≠ some (initial i) <;> simp [hinitial, hd, ha]

end Bounty
end

section

/- Dilation enters the original full event through divisibility tests only.
Equal tests give an exact event bijection, including fallback targets and caps. -/

open Finset
open scoped Classical
namespace Bounty

section Dilation
variable {P : Type*} (n : P → ℕ) (Δ D D' : ℤ)
  (hD : ∀ p, ((n p : ℤ) ∣ D ↔ (n p : ℤ) ∣ D'))

include hD in
theorem unrestricted_residue_eligible_dilation_congr {N : ℕ}
    (old : Fin N → UnrestrictedResidueParticle n) :
    unrestrictedResidueEligible n Δ D old = unrestrictedResidueEligible n Δ D' old := by
  ext i
  simp only [mem_unrestrictedResidueEligible, hD]

include hD in
theorem unrestricted_residue_storage_dilation_congr {t : ℕ}
    (source : Fin t → P) (stores : Finset (Fin t)) :
    unrestrictedResidueStorageAllowed n D source stores ↔
      unrestrictedResidueStorageAllowed n D' source stores := by
  simp only [unrestrictedResidueStorageAllowed, hD]

def unrestrictedDilationEventMap {t B : ℕ}
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (e : UnrestrictedBoundedEvent n Δ D t B s) :
    UnrestrictedBoundedEvent n Δ D' t B s :=
  ⟨e.1, e.2.1,
    ⟨{ toFun := fun i => ⟨(e.2.2.1 i).val, by
          have h := (mem_unrestrictedResidueEligible n Δ D s.2.2 (e.2.2.1 i).val).mp (e.2.2.1 i).property
          exact (mem_unrestrictedResidueEligible n Δ D' s.2.2 (e.2.2.1 i).val).mpr
            ⟨h.1, fun hd => h.2 ((hD _).mpr hd)⟩⟩
       inj' := by
          intro i j hij
          apply e.2.2.1.injective
          exact Subtype.ext (congrArg (fun z : ↥(unrestrictedResidueEligible n Δ D' s.2.2) => z.val) hij) },
      e.2.2.2⟩⟩

def unrestrictedDilationEventEquiv {t B : ℕ}
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B) :
    UnrestrictedBoundedEvent n Δ D t B s ≃ UnrestrictedBoundedEvent n Δ D' t B s where
  toFun := unrestrictedDilationEventMap n Δ D D' hD s
  invFun := unrestrictedDilationEventMap n Δ D' D (fun p => (hD p).symm) s
  left_inv e := by rcases e with ⟨stores, promotions, e, fresh⟩; rfl
  right_inv e := by rcases e with ⟨stores, promotions, e, fresh⟩; rfl

theorem unrestricted_dilation_event_target {t B : ℕ}
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (e : UnrestrictedBoundedEvent n Δ D t B s) :
    unrestrictedBoundedEventTarget n Δ D' t B s (unrestrictedDilationEventEquiv n Δ D D' hD s e) =
      unrestrictedBoundedEventTarget n Δ D t B s e := by
  rfl

theorem unrestricted_dilation_event_weight (μ : P → ℝ) (ρ V : ℝ) {t B : ℕ}
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (e : UnrestrictedBoundedEvent n Δ D t B s) :
    unrestrictedBoundedEventWeight n Δ D' μ ρ V t B s
      (unrestrictedDilationEventEquiv n Δ D D' hD s e) =
      unrestrictedBoundedEventWeight n Δ D μ ρ V t B s e := by
  let out := unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
    (unrestrictedResidueTransport n Δ) e.1 e.2.1 e.2.2.1
  let mass := unrestrictedEdgeEventMass s.1 s.2.2 (unrestrictedResidueSeed n)
    (unrestrictedResidueTransport n Δ) unrestrictedResidueHit μ ρ V e.1 e.2.1 e.2.2.1 e.2.2.2
  change (if unrestrictedResidueStorageAllowed n D' s.1 e.1 ∧ out.1 ≤ B then mass else 0) =
    (if unrestrictedResidueStorageAllowed n D s.1 e.1 ∧ out.1 ≤ B then mass else 0)
  by_cases hd : unrestrictedResidueStorageAllowed n D s.1 e.1
  · have hd' := (unrestricted_residue_storage_dilation_congr n D D' hD s.1 e.1).mp hd
    simp only [hd, hd', true_and]
  · have hd' : ¬ unrestrictedResidueStorageAllowed n D' s.1 e.1 :=
      fun h => hd ((unrestricted_residue_storage_dilation_congr n D D' hD s.1 e.1).mpr h)
    simp only [hd, hd', false_and, ite_false]

end Dilation
end Bounty
end

section

/- Uniform polynomial derivative bounds on fixed compact support control all Schwartz seminorms. -/

open Finset MeasureTheory
open scoped FourierTransform

namespace Bounty

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

theorem schwartz_domain_seminorm_polynomial_of_fixed_support {I : Type*}
    (f : I → SchwartzMap E ℂ) (w : I → ℝ)
    (hw : ∀ p, 1 ≤ w p) (R : ℝ) (hR : 0 ≤ R)
    (hsupport : ∀ p, tsupport (f p) ⊆ Metric.closedBall 0 R)
    (hderiv : ∀ n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p x, ‖iteratedFDeriv ℝ n (f p) x‖ ≤ C*(w p)^d) :
    ∀ k n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p, SchwartzMap.seminorm ℂ k n (f p) ≤ C*(w p)^d := by
  intro k n
  obtain ⟨d,C,hC,hbound⟩ := hderiv n
  refine ⟨d,R^k*C,mul_nonneg (pow_nonneg hR _) hC,?_⟩
  intro p
  have hwp : 0 ≤ w p := zero_le_one.trans (hw p)
  apply SchwartzMap.seminorm_le_bound ℂ k n (f p) (by positivity)
  intro x
  by_cases hz : iteratedFDeriv ℝ n (f p) x = 0
  · rw [hz, norm_zero, mul_zero]
    positivity
  · have hx : x ∈ tsupport (f p) := (support_iteratedFDeriv_subset n) hz
    have hxR : ‖x‖ ≤ R := by
      simpa only [Metric.mem_closedBall, dist_zero_right] using hsupport p hx
    calc
      _ ≤ R^k*(C*(w p)^d) := mul_le_mul (pow_le_pow_left₀ (norm_nonneg _) hxR _)
        (hbound p x) (norm_nonneg _) (pow_nonneg hR _)
      _ = _ := by ring

theorem continuous_schwartz_domain_seminorm_polynomial {I : Type*}
    (f : I → SchwartzMap E ℂ) (w : I → ℝ)
    (hw : ∀ p, 1 ≤ w p)
    (hsemi : ∀ k n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p, SchwartzMap.seminorm ℂ k n (f p) ≤ C*(w p)^d)
    (q : Seminorm ℂ (SchwartzMap E ℂ)) (hq : Continuous q) :
    ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ p, q (f p) ≤ C*(w p)^d := by
  classical
  choose d C hC hbound using hsemi
  obtain ⟨s,K,hK,hqK⟩ := Seminorm.bound_of_continuous
    (schwartz_withSeminorms ℂ E ℂ) q hq
  let D := s.sup (fun kn => d kn.1 kn.2)
  let M := ∑ kn ∈ s, C kn.1 kn.2
  have hM : 0 ≤ M := sum_nonneg (fun kn _ => hC kn.1 kn.2)
  refine ⟨D,(K : ℝ)*M,mul_nonneg K.coe_nonneg hM,?_⟩
  intro p
  have hwp : 0 ≤ w p := zero_le_one.trans (hw p)
  have hs : s.sup (schwartzSeminormFamily ℂ E ℂ) (f p) ≤ M*(w p)^D := by
    apply Seminorm.finset_sup_apply_le (by positivity)
    intro kn hkn
    have hCM : C kn.1 kn.2 ≤ M := single_le_sum (fun kn _ => hC kn.1 kn.2) hkn
    have hdD : d kn.1 kn.2 ≤ D := Finset.le_sup (f := fun kn => d kn.1 kn.2) hkn
    exact (hbound kn.1 kn.2 p).trans (mul_le_mul hCM
      (pow_le_pow_right₀ (hw p) hdD) (pow_nonneg (zero_le_one.trans (hw p)) _) hM)
  calc
    _ ≤ (K : ℝ)*s.sup (schwartzSeminormFamily ℂ E ℂ) (f p) := hqK (f p)
    _ ≤ (K : ℝ)*(M*(w p)^D) := mul_le_mul_of_nonneg_left hs K.coe_nonneg
    _ = _ := by ring

end Bounty
end

section

/- Removing a simple prime factor deletes exactly that prime from its divisor pool. -/

open Finset

namespace Bounty

theorem physical_divisor_pool_div_simple_prime {G : Type*}
    (P : G → Finset ℕ) (g : G) (hP : ∀ r ∈ P g, r.Prime)
    {n p : ℕ} (hp : p ∈ P g) (hpn : p ∣ n) (hpp : ¬ p ^ 2 ∣ n) :
    physicalDivisorPool P g ((n / p : ℕ) : ℤ) =
      (physicalDivisorPool P g (n : ℤ)).erase p := by
  classical
  have hpprime := hP p hp
  have hmul : n / p * p = n := Nat.div_mul_cancel hpn
  have hpnot : ¬ p ∣ n / p := by
    intro h
    apply hpp
    have hd := Nat.mul_dvd_mul_right h p
    simpa only [← pow_two, hmul] using hd
  ext r
  simp only [physicalDivisorPool, mem_filter, mem_erase, Int.natCast_dvd_natCast]
  constructor
  · rintro ⟨hr, hrn⟩
    refine ⟨?_, hr, dvd_trans hrn (Nat.div_dvd_of_dvd hpn)⟩
    intro he
    subst r
    exact hpnot hrn
  · rintro ⟨hrp, hr, hrn⟩
    refine ⟨hr, ?_⟩
    rw [← hmul] at hrn
    rcases (hP r hr).dvd_mul.mp hrn with hq | hpdiv
    · exact hq
    · rcases (Nat.dvd_prime hpprime).mp hpdiv with hone | heq
      · exact False.elim ((hP r hr).ne_one hone)
      · exact False.elim (hrp heq)

theorem physical_omega_div_simple_prime {G : Type*}
    (P : G → Finset ℕ) (g : G) (hP : ∀ r ∈ P g, r.Prime)
    {n p : ℕ} (hp : p ∈ P g) (hpn : p ∣ n) (hpp : ¬ p ^ 2 ∣ n) :
    physicalOmega P g ((n / p : ℕ) : ℤ) = physicalOmega P g (n : ℤ) - 1 := by
  unfold physicalOmega
  rw [physical_divisor_pool_div_simple_prime P g hP hp hpn hpp, card_erase_of_mem]
  exact mem_filter.mpr ⟨hp, by exact_mod_cast hpn⟩

theorem physical_divisor_pool_div_other_prime {G : Type*}
    (P : G → Finset ℕ) (g : G) (hP : ∀ r ∈ P g, r.Prime)
    {n p : ℕ} (hp : p.Prime) (hpout : p ∉ P g) (hpn : p ∣ n) :
    physicalDivisorPool P g ((n / p : ℕ) : ℤ) = physicalDivisorPool P g (n : ℤ) := by
  classical
  have hmul : n / p * p = n := Nat.div_mul_cancel hpn
  ext r
  simp only [physicalDivisorPool, mem_filter, Int.natCast_dvd_natCast]
  constructor
  · rintro ⟨hr, hrn⟩
    exact ⟨hr, dvd_trans hrn (Nat.div_dvd_of_dvd hpn)⟩
  · rintro ⟨hr, hrn⟩
    refine ⟨hr, ?_⟩
    rw [← hmul] at hrn
    rcases (hP r hr).dvd_mul.mp hrn with hq | hpdiv
    · exact hq
    · rcases (Nat.dvd_prime hp).mp hpdiv with hone | heq
      · exact False.elim ((hP r hr).ne_one hone)
      · exact False.elim (hpout (heq ▸ hr))

end Bounty
end

section

/- Extending a birth label by none creates no performed births or collisions outside its embedded addresses. -/

open Classical
namespace Bounty

noncomputable def optionalBirthExtension {A B Z : Type*} (e : A ↪ B)
    (label : A → Option Z) : B → Option Z :=
  Function.extend e label (fun _ => none)

theorem optional_birth_extension_apply {A B Z : Type*} (e : A ↪ B)
    (label : A → Option Z) (a : A) : optionalBirthExtension e label (e a) = label a :=
  e.injective.extend_apply label (fun _ => none) a

theorem optional_birth_extension_none {A B Z : Type*} (e : A ↪ B)
    (label : A → Option Z) (b : B) (hb : ¬∃ a, e a = b) :
    optionalBirthExtension e label b = none :=
  Function.extend_apply' label (fun _ => none) b hb

theorem optional_birth_extension_some_iff {A B Z : Type*} (e : A ↪ B)
    (label : A → Option Z) (b : B) (z : Z) :
    optionalBirthExtension e label b = some z ↔ ∃ a, e a = b ∧ label a = some z := by
  constructor
  · intro h
    by_cases hb : ∃ a, e a = b
    · obtain ⟨a, rfl⟩ := hb
      exact ⟨a, rfl, (optional_birth_extension_apply e label a).symm.trans h⟩
    · rw [optional_birth_extension_none e label b hb] at h
      cases h
  · rintro ⟨a, rfl, h⟩
    exact (optional_birth_extension_apply e label a).trans h

theorem optional_birth_extension_distinct_iff {A B Z : Type*} (e : A ↪ B)
    (label : A → Option Z) :
    (∀ a b z, optionalBirthExtension e label a = some z →
      optionalBirthExtension e label b = some z → a = b) ↔
    (∀ a b z, label a = some z → label b = some z → a = b) := by
  constructor
  · intro h a b z ha hb
    apply e.injective
    exact h (e a) (e b) z ((optional_birth_extension_apply e label a).trans ha)
      ((optional_birth_extension_apply e label b).trans hb)
  · intro h a b z ha hb
    obtain ⟨a', rfl, ha'⟩ := (optional_birth_extension_some_iff e label a z).mp ha
    obtain ⟨b', rfl, hb'⟩ := (optional_birth_extension_some_iff e label b z).mp hb
    exact congrArg e (h a' b' z ha' hb')

theorem optional_birth_extension_all_iff {A B Z : Type*} (e : A ↪ B)
    (label : A → Option Z) (Q : Z → Prop) :
    (∀ b z, optionalBirthExtension e label b = some z → Q z) ↔
      (∀ a z, label a = some z → Q z) := by
  constructor
  · intro h a z ha
    exact h (e a) z ((optional_birth_extension_apply e label a).trans ha)
  · intro h b z hb
    obtain ⟨a, _, ha⟩ := (optional_birth_extension_some_iff e label b z).mp hb
    exact h a z ha

theorem optional_birth_extension_map {A B Z Y : Type*} (e : A ↪ B)
    (label : A → Option Z) (f : Z → Y) (b : B) :
    (optionalBirthExtension e label b).map f =
      optionalBirthExtension e (fun a => (label a).map f) b := by
  by_cases hb : ∃ a, e a = b
  · obtain ⟨a, rfl⟩ := hb
    rw [optional_birth_extension_apply, optional_birth_extension_apply]
  · rw [optional_birth_extension_none e label b hb,
      optional_birth_extension_none e (fun a => (label a).map f) b hb]
    rfl

end Bounty
end

section

/- Quantitative additive/logarithmic kernel comparison on positive dyadic centers. -/

open scoped NNReal

namespace Bounty

theorem abs_log_one_add_sub_self_le {x : ℝ} (hx : |x| ≤ 1 / 2) :
    |Real.log (1 + x) - x| ≤ 2 * x ^ 2 := by
  have hh := Real.abs_log_sub_add_sum_range_le
    (x := -x) (by simpa only [abs_neg] using (lt_of_le_of_lt hx (by norm_num : (1 : ℝ) / 2 < 1))) 1
  simp only [Finset.sum_range_one, Nat.cast_zero, zero_add, pow_one, div_one,
    sub_neg_eq_add, abs_neg] at hh
  have hden : 0 < 1 - |x| := by linarith
  have hb : |x| ^ 2 / (1 - |x|) ≤ 2 * x ^ 2 := by
    apply (div_le_iff₀ hden).mpr
    rw [sq_abs]
    nlinarith [sq_nonneg x, mul_nonneg (sq_nonneg x) (show 0 ≤ 1 - 2 * |x| by linarith)]
  have hh' : |Real.log (1 + x) - x| ≤ |x|^2 / (1-|x|) := by
    simpa only [neg_add_eq_sub] using hh
  exact hh'.trans hb

theorem additive_log_displacement_bound {w v : ℝ} (hv : 0 < v)
    (hclose : |w - v| ≤ v / 2) :
    |(w - v) - v * Real.log (w / v)| ≤ 2 * (w - v) ^ 2 / v := by
  have hx : |(w - v) / v| ≤ 1 / 2 := by
    rw [abs_div, abs_of_pos hv]
    exact (div_le_iff₀ hv).mpr (by linarith)
  have ht := abs_log_one_add_sub_self_le hx
  have harg : 1 + (w - v) / v = w / v := by field_simp; ring
  rw [harg] at ht
  calc
    _ = |v * (Real.log (w / v) - (w - v) / v)| := by
      rw [abs_sub_comm]
      congr 1
      field_simp
    _ = v * |Real.log (w / v) - (w - v) / v| := by rw [abs_mul, abs_of_pos hv]
    _ ≤ v * (2 * ((w - v) / v) ^ 2) := mul_le_mul_of_nonneg_left ht hv.le
    _ = _ := by field_simp

theorem normalized_additive_log_displacement_bound {w v H : ℝ}
    (hv : 0 < v) (hH : 0 < H) (hclose : |w - v| ≤ v / 2) :
    |(w - v) / H - v * Real.log (w / v) / H| ≤
      2 * (w - v) ^ 2 / (v * H) := by
  rw [← sub_div, abs_div, abs_of_pos hH]
  exact (div_le_div_of_nonneg_right (additive_log_displacement_bound hv hclose) hH.le).trans_eq (by ring)

theorem normalized_log_displacement_dyadic_bound {w v H Y R : ℝ}
    (hY : 0 < Y) (hH : 0 < H) (_hR : 0 ≤ R) (hv : Y / 2 ≤ v)
    (hsmall : R * H ≤ Y / 4) (hclose : |w - v| ≤ R * H) :
    |(w - v) / H - v * Real.log (w / v) / H| ≤ 4 * R ^ 2 * H / Y := by
  have hv0 : 0 < v := by linarith
  have hc : |w-v| ≤ v/2 := by linarith
  apply (normalized_additive_log_displacement_bound hv0 hH hc).trans
  apply (div_le_div_iff₀ (mul_pos hv0 hH) hY).mpr
  have hs : (w-v)^2 ≤ (R*H)^2 := by
    simpa only [sq_abs] using pow_le_pow_left₀ (abs_nonneg (w-v)) hclose 2
  have hmul : R^2*H^2*Y ≤ 2*R^2*H^2*v := by
    nlinarith [mul_nonneg (sq_nonneg R) (sq_nonneg H),
      mul_nonneg (mul_nonneg (sq_nonneg R) (sq_nonneg H)) (show 0≤2*v-Y by linarith)]
  nlinarith [mul_le_mul_of_nonneg_right hs hY.le]

theorem lipschitz_log_kernel_comparison {K : ℝ → ℂ} {C : ℝ≥0}
    (hK : LipschitzWith C K) {w v H Y R : ℝ}
    (hY : 0 < Y) (hH : 0 < H) (hR : 0 ≤ R) (hv : Y / 2 ≤ v)
    (hsmall : R * H ≤ Y / 4) (hclose : |w - v| ≤ R * H) :
    ‖K ((w-v)/H) - K (v*Real.log (w/v)/H)‖ ≤ (C : ℝ) * (4*R^2*H/Y) := by
  exact (hK.norm_sub_le _ _).trans (mul_le_mul_of_nonneg_left
    (by simpa only [Real.norm_eq_abs] using
      normalized_log_displacement_dyadic_bound hY hH hR hv hsmall hclose) C.coe_nonneg)

end Bounty
end

section

/- Variable-length ordered mark lists and their exact divisor-pool fibers. -/

open Finset

namespace Bounty

abbrev GroupMarkedLists {G : Type*} (P : G → Finset ℕ) (t : G → ℕ) :=
  ∀ g, Fin (t g) ↪ ↥(P g)

abbrev GroupMarkedListsAt {G : Type*} (P : G → Finset ℕ) (t : G → ℕ) (n : ℤ) :=
  {L : GroupMarkedLists P t // ∀ g s, ((L g s).val : ℤ) ∣ n}

def groupMarkedListsAtEquiv {G : Type*} (P : G → Finset ℕ) (t : G → ℕ) (n : ℤ) :
    GroupMarkedListsAt P t n ≃ (∀ g, Fin (t g) ↪ ↥(physicalDivisorPool P g n)) where
  toFun L g := {
    toFun := fun s => ⟨(L.val g s).val, mem_filter.mpr ⟨(L.val g s).property, L.property g s⟩⟩
    inj' := by
      intro i j h
      apply (L.val g).injective
      exact Subtype.ext (congrArg (fun p : ↥(physicalDivisorPool P g n) => p.val) h) }
  invFun L := ⟨fun g => {
    toFun := fun s => ⟨(L g s).val, (mem_filter.mp (L g s).property).1⟩
    inj' := by
      intro i j h
      apply (L g).injective
      exact Subtype.ext (congrArg (fun p : ↥(P g) => p.val) h) },
    fun g s => (mem_filter.mp (L g s).property).2⟩
  left_inv L := by
    apply Subtype.ext
    funext g
    apply Function.Embedding.ext
    intro s
    rfl
  right_inv L := by
    funext g
    apply Function.Embedding.ext
    intro s
    rfl

theorem group_marked_lists_at_card {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (t : G → ℕ) (n : ℤ) :
    Nat.card (GroupMarkedListsAt P t n) =
      ∏ g, (physicalOmega P g n).descFactorial (t g) := by
  classical
  rw [Nat.card_congr (groupMarkedListsAtEquiv P t n), Nat.card_eq_fintype_card,
    Fintype.card_pi]
  apply prod_congr rfl
  intro g _
  rw [Fintype.card_embedding_eq]
  simp only [Fintype.card_coe, Fintype.card_fin, physicalOmega]

theorem marked_divisor_weight_eq_fiber_mass {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (q : ℝ) (V : G → ℝ) (t : G → ℕ) (n : ℤ) :
    markedDivisorWeight univ P q V t n =
      (∏ g, q ^ (physicalOmega P g n - t g) / V g ^ t g) *
        (Nat.card (GroupMarkedListsAt P t n) : ℝ) := by
  classical
  rw [group_marked_lists_at_card, Nat.cast_prod, ← prod_mul_distrib]
  unfold markedDivisorWeight markedDivisorFactor
  apply prod_congr rfl
  intro g _
  ring

end Bounty
end

section

/- The full big-active projection is self-adjoint for the original product
memory measure. This identity does not move any small-tail endpoint gate. -/

open Finset
open scoped Classical

namespace Bounty

theorem fullActiveAverage_pairing {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    {M : G → ℕ} {B : ℕ} (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (f h : ProductBoundedOrderedState P Z M B → ℂ) :
    (∑ x, (productMemoryWeight μ ν x : ℂ) * f x * fullActiveAverage h x) =
      ∑ x, (productMemoryWeight μ ν x : ℂ) * fullActiveAverage f x * h x := by
  simp only [fullActiveAverage, mul_sum, sum_mul]
  rw [sum_comm]
  conv_rhs => rw [sum_comm]
  let inv : FullActiveSlotPermutations M ≃ FullActiveSlotPermutations M :=
    Equiv.piCongrRight (fun _ => Equiv.inv _)
  have hi := inv.sum_comp (fun τ : FullActiveSlotPermutations M =>
    ∑ x, (productMemoryWeight μ ν x : ℂ) *
      ((fullActivePermutationWeight M τ : ℂ) * f (fullActivePermutation τ x)) * h x)
  rw [← hi]
  apply sum_congr rfl
  intro τ _
  have hx := (fullActivePermutation τ).sum_comp (fun x =>
    (productMemoryWeight μ ν x : ℂ) *
      ((fullActivePermutationWeight M (inv τ) : ℂ) *
        f ((fullActivePermutation τ).symm x)) * h x)
  have he : fullActivePermutation (P := P) (Z := Z) (B := B) (inv τ) =
      (fullActivePermutation τ).symm := by
    apply Equiv.ext
    intro x
    rfl
  simp only [fullActivePermutation_weight, Equiv.symm_apply_apply] at hx
  rw [he]
  calc
    _ = ∑ x, (productMemoryWeight μ ν x : ℂ) *
        ((fullActivePermutationWeight M (inv τ) : ℂ) * f x) *
          h (fullActivePermutation τ x) := by
      apply sum_congr rfl
      intro x _
      unfold fullActivePermutationWeight
      ring
    _ = _ := hx

theorem fullActiveAverage_conj {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ}
    (f : ProductBoundedOrderedState P Z M B → ℂ) (x) :
    fullActiveAverage (fun y => (starRingEnd ℂ) (f y)) x =
      (starRingEnd ℂ) (fullActiveAverage f x) := by
  simp only [fullActiveAverage, map_sum, map_mul, Complex.conj_ofReal]

theorem fullActiveAverage_self_adjoint {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    {M : G → ℕ} {B : ℕ} (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (f h : ProductBoundedOrderedState P Z M B → ℂ) :
    (∑ x, (productMemoryWeight μ ν x : ℂ) * (starRingEnd ℂ) (f x) * fullActiveAverage h x) =
      ∑ x, (productMemoryWeight μ ν x : ℂ) * (starRingEnd ℂ) (fullActiveAverage f x) * h x := by
  simpa only [fullActiveAverage_conj] using
    fullActiveAverage_pairing μ ν (fun x => (starRingEnd ℂ) (f x)) h

end Bounty
end

section

/- Uniform integrable Fourier envelopes for compact families with two controlled derivatives. -/

open MeasureTheory Set Real
open scoped FourierTransform

namespace Bounty

theorem compact_integral_norm_bound (f : ℝ → ℂ) (R C : ℝ)
    (hs : ∀ x, x ∉ Icc (-R) R → f x = 0) (hb : ∀ x, ‖f x‖ ≤ C) :
    (∫ x, ‖f x‖) ≤ C * volume.real (Icc (-R) R) := by
  rw [← setIntegral_eq_integral_of_forall_compl_eq_zero
    (fun x hx => by rw [hs x hx, norm_zero])]
  calc
    _ ≤ ‖∫ x in Icc (-R) R, ‖f x‖‖ := le_abs_self _
    _ ≤ _ := norm_setIntegral_le_of_norm_le_const (measure_Icc_lt_top)
      (fun x _ => by simpa only [norm_norm] using hb x)

theorem schwartz_fourier_deriv_formula (f : SchwartzMap ℝ ℂ) (s : ℝ) :
    𝓕 (SchwartzMap.derivCLM ℂ ℂ f) s =
      (2 * (Real.pi : ℂ) * Complex.I * (s : ℂ)) * 𝓕 f s := by
  rw [SchwartzMap.fourier_coe]
  change 𝓕 (deriv f) s = _
  rw [Real.fourier_deriv f.integrable f.differentiable
    (SchwartzMap.derivCLM ℂ ℂ f).integrable]
  rfl

theorem compact_schwartz_fourier_envelope {ι : Type*} (f : ι → SchwartzMap ℝ ℂ)
    (R C₀ C₂ : ℝ) (hC₀ : 0 ≤ C₀) (hC₂ : 0 ≤ C₂)
    (hs : ∀ i x, x ∉ Icc (-R) R → f i x = 0)
    (hs₂ : ∀ i x, x ∉ Icc (-R) R →
      SchwartzMap.derivCLM ℂ ℂ (SchwartzMap.derivCLM ℂ ℂ (f i)) x = 0)
    (h₀ : ∀ i x, ‖f i x‖ ≤ C₀)
    (h₂ : ∀ i x, ‖SchwartzMap.derivCLM ℂ ℂ
      (SchwartzMap.derivCLM ℂ ℂ (f i)) x‖ ≤ C₂) :
    ∃ C : ℝ, 0 ≤ C ∧ Integrable (fun s : ℝ => C/(1+s^2)) ∧
      ∀ i s, ‖𝓕 (f i) s‖ ≤ C/(1+s^2) := by
  let V := volume.real (Icc (-R) R)
  refine ⟨(C₀+C₂)*V, mul_nonneg (add_nonneg hC₀ hC₂) (ENNReal.toReal_nonneg), ?_, ?_⟩
  · simpa only [div_eq_mul_inv] using integrable_inv_one_add_sq.const_mul ((C₀+C₂)*V)
  intro i s
  have hf : ‖𝓕 (f i) s‖ ≤ C₀*V := by
    apply (VectorFourier.norm_fourierIntegral_le_integral_norm _ _ _ _ _).trans
    exact compact_integral_norm_bound (f i) R C₀ (hs i) (h₀ i)
  have hd : ‖𝓕 (SchwartzMap.derivCLM ℂ ℂ (SchwartzMap.derivCLM ℂ ℂ (f i))) s‖ ≤ C₂*V := by
    apply (VectorFourier.norm_fourierIntegral_le_integral_norm _ _ _ _ _).trans
    exact compact_integral_norm_bound _ R C₂ (hs₂ i) (h₂ i)
  rw [schwartz_fourier_deriv_formula, schwartz_fourier_deriv_formula] at hd
  simp only [norm_mul, Complex.norm_ofNat, Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos pi_pos, Complex.norm_I, mul_one] at hd
  have hp : 1 ≤ (2*Real.pi)^2 := by nlinarith [two_le_pi]
  have hn : 0 ≤ s^2*‖𝓕 (f i) s‖ := mul_nonneg (sq_nonneg _) (norm_nonneg _)
  have hd' : s^2*‖𝓕 (f i) s‖ ≤ C₂*V := by
    calc
      _ ≤ (2*Real.pi)^2*(s^2*‖𝓕 (f i) s‖) := by
        simpa only [one_mul] using mul_le_mul_of_nonneg_right hp hn
      _ = 2*Real.pi* |s| *(2*Real.pi* |s| *‖𝓕 (f i) s‖) := by rw [← sq_abs s]; ring
      _ ≤ _ := hd
  apply (le_div_iff₀ (by positivity : 0 < 1+s^2)).mpr
  nlinarith

end Bounty
end

section

/- Schwartz decay controls polynomial weights uniformly over scales bounded away from zero. -/

open Real

namespace Bounty

theorem schwartz_scaled_polynomial_weight_bound (f : SchwartzMap ℝ ℂ)
    (j k : ℕ) {a : ℝ} (ha : 0 < a) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ t : ℝ, a ≤ t → ∀ v : ℝ,
      (1+v^2)^((j : ℝ)/4) * |t*v|^k * ‖f (t*v)‖ ≤ C := by
  let Q : ℝ := 1+a⁻¹
  have hQ : 1 ≤ Q := by dsimp [Q]; exact le_add_of_nonneg_right (inv_nonneg.mpr ha.le)
  let B : ℝ := 2^(2*j+k) * (Finset.Iic (2*j+k,0)).sup
    (fun m : ℕ × ℕ => SchwartzMap.seminorm ℂ m.1 m.2) f
  have hB : 0 ≤ B := by dsimp [B]; positivity
  refine ⟨Q^(2*j)*B, mul_nonneg (pow_nonneg (by linarith) _) hB, ?_⟩
  intro t ht v
  have ht0 : 0 < t := ha.trans_le ht
  have hx : |v| ≤ Q*|t*v| := by
    rw [abs_mul, abs_of_pos ht0]
    have hqt : 1 ≤ Q*t := by
      have hat : a⁻¹*a ≤ a⁻¹*t := mul_le_mul_of_nonneg_left ht (inv_nonneg.mpr ha.le)
      rw [inv_mul_cancel₀ ha.ne'] at hat
      dsimp [Q]
      nlinarith
    nlinarith [abs_nonneg v]
  have hbase : 1+v^2 ≤ Q^2*(1+|t*v|)^2 := by
    have hlin : 1+|v| ≤ Q*(1+|t*v|) := by nlinarith
    have hp := pow_le_pow_left₀ (show 0 ≤ 1+|v| by positivity) hlin 2
    rw [mul_pow] at hp
    nlinarith [sq_abs v, abs_nonneg v]
  have hweight : (1+v^2)^((j : ℝ)/4) ≤ Q^(2*j)*(1+|t*v|)^(2*j) := by
    calc
      _ ≤ (1+v^2)^(j : ℝ) := rpow_le_rpow_of_exponent_le (by nlinarith [sq_nonneg v])
        (by have hj : (0 : ℝ) ≤ j := Nat.cast_nonneg _; linarith)
      _ = (1+v^2)^j := rpow_natCast _ _
      _ ≤ (Q^2*(1+|t*v|)^2)^j := pow_le_pow_left₀ (by positivity) hbase _
      _ = _ := by rw [mul_pow, ← pow_mul, ← pow_mul]
  have hdecay : (1+|t*v|)^(2*j+k)*‖f (t*v)‖ ≤ B := by
    simpa only [norm_iteratedFDeriv_zero, Real.norm_eq_abs] using
      (SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℂ)
        (m := (2*j+k,0)) (k := 2*j+k) (n := 0) le_rfl le_rfl f (t*v))
  calc
    _ ≤ (Q^(2*j)*(1+|t*v|)^(2*j)) * (1+|t*v|)^k * ‖f (t*v)‖ := by
      gcongr
      exact le_add_of_nonneg_left zero_le_one
    _ = Q^(2*j)*((1+|t*v|)^(2*j+k)*‖f (t*v)‖) := by rw [pow_add]; ring
    _ ≤ Q^(2*j)*B := mul_le_mul_of_nonneg_left hdecay (pow_nonneg (by linarith) _)

end Bounty
end

section

/- Two explicit derivatives of a Schwartz profile at an exponential scale. -/

namespace Bounty

noncomputable def exponentialProfileArgument (v u : ℝ) : ℝ := Real.exp (-u)*v/(2*Real.pi)

noncomputable def exponentialProfile (g f : SchwartzMap ℝ ℂ) (v u : ℝ) : ℂ :=
  g u * f (exponentialProfileArgument v u)

noncomputable def exponentialProfileFirst (g f : SchwartzMap ℝ ℂ) (v u : ℝ) : ℂ :=
  deriv g u * f (exponentialProfileArgument v u) -
    g u * (exponentialProfileArgument v u : ℂ) * deriv f (exponentialProfileArgument v u)

noncomputable def exponentialProfileSecond (g f : SchwartzMap ℝ ℂ) (v u : ℝ) : ℂ :=
  deriv (deriv g) u * f (exponentialProfileArgument v u) +
    (g u - 2*deriv g u) * (exponentialProfileArgument v u : ℂ) *
      deriv f (exponentialProfileArgument v u) +
    g u * (exponentialProfileArgument v u : ℂ)^2 * deriv (deriv f) (exponentialProfileArgument v u)

theorem exponential_profile_argument_hasDerivAt (v u : ℝ) :
    HasDerivAt (exponentialProfileArgument v) (-exponentialProfileArgument v u) u := by
  have h : HasDerivAt (fun z : ℝ => Real.exp (-z)*v/(2*Real.pi))
      (Real.exp (-u)*(-1)*v/(2*Real.pi)) u :=
    (((Real.hasDerivAt_exp (-u)).comp u (hasDerivAt_neg u)).mul_const v).div_const (2*Real.pi)
  have he : -exponentialProfileArgument v u = Real.exp (-u)*(-1)*v/(2*Real.pi) := by
    unfold exponentialProfileArgument
    ring
  rw [he]
  exact h

theorem exponential_profile_hasDerivAt (g f : SchwartzMap ℝ ℂ) (v u : ℝ) :
    HasDerivAt (exponentialProfile g f v) (exponentialProfileFirst g f v u) u := by
  have hx := exponential_profile_argument_hasDerivAt v u
  have hf := (f.hasDerivAt (exponentialProfileArgument v u)).scomp u hx
  have he : exponentialProfileFirst g f v u =
      deriv g u*f (exponentialProfileArgument v u) +
        g u*((-exponentialProfileArgument v u) • deriv f (exponentialProfileArgument v u)) := by
    simp only [exponentialProfileFirst,Complex.real_smul,Complex.ofReal_neg]
    ring
  rw [he]
  exact (g.hasDerivAt u).mul hf

theorem exponential_profile_first_hasDerivAt (g f : SchwartzMap ℝ ℂ) (v u : ℝ) :
    HasDerivAt (exponentialProfileFirst g f v) (exponentialProfileSecond g f v u) u := by
  let x := exponentialProfileArgument v u
  have hx := exponential_profile_argument_hasDerivAt v u
  have hxC := hx.ofReal_comp
  have hg := g.hasDerivAt u
  have hg' : HasDerivAt (deriv g) (deriv (deriv g) u) u :=
    (SchwartzMap.derivCLM ℂ ℂ g).hasDerivAt u
  have hf := (f.hasDerivAt (exponentialProfileArgument v u)).scomp u hx
  have hf' : HasDerivAt (fun z => deriv f (exponentialProfileArgument v z))
      ((-x) • deriv (deriv f) x) u :=
    ((SchwartzMap.derivCLM ℂ ℂ f).hasDerivAt (exponentialProfileArgument v u)).scomp u hx
  have he : exponentialProfileSecond g f v u =
      (deriv (deriv g) u*f x+deriv g u*((-x) • deriv f x)) -
        ((deriv g u*(x : ℂ)+g u*((-x : ℝ) : ℂ))*deriv f x+
          (g u*(x : ℂ))*((-x) • deriv (deriv f) x)) := by
    simp only [exponentialProfileSecond,Complex.real_smul,Complex.ofReal_neg]
    dsimp only [x]
    ring
  rw [he]
  exact (hg'.mul hf).sub ((hg.mul hxC).mul hf')

end Bounty
end

section

open MeasureTheory

namespace Bounty

theorem translated_kernel_square_integrable
    {K : ℝ → ℝ} {f : ℝ → ℂ} (hK : Continuous K) (hKi : Integrable K)
    (hK0 : ∀ t, 0 ≤ K t) (hf : Continuous f)
    (hf2 : Integrable (fun t => ‖f t‖^2)) :
    Integrable (fun p : ℝ × ℝ => K (p.1-p.2) * ‖f p.1‖^2)
      (volume.prod volume) := by
  have hc : Continuous (fun p : ℝ × ℝ => K (p.1-p.2) * ‖f p.1‖^2) := by
    fun_prop
  apply (integrable_prod_iff hc.aestronglyMeasurable).mpr
  constructor
  · filter_upwards [] with t
    exact (hKi.comp_sub_left t).mul_const _
  · have heq : (fun t => ∫ r : ℝ, ‖K (t-r) * ‖f t‖^2‖) =
        (fun t => (∫ r : ℝ, K r) * ‖f t‖^2) := by
      funext t
      simp_rw [Real.norm_of_nonneg (mul_nonneg (hK0 _) (sq_nonneg _))]
      rw [integral_mul_const, integral_sub_left_eq_self]
    rw [heq]
    exact hf2.const_mul _

theorem translated_kernel_square_integral
    {K : ℝ → ℝ} {f : ℝ → ℂ} (hK : Continuous K) (hKi : Integrable K)
    (hK0 : ∀ t, 0 ≤ K t) (hf : Continuous f)
    (hf2 : Integrable (fun t => ‖f t‖^2)) :
    (∫ p : ℝ × ℝ, K (p.1-p.2) * ‖f p.1‖^2 ∂(volume.prod volume)) =
      (∫ t : ℝ, K t) * ∫ t : ℝ, ‖f t‖^2 := by
  rw [integral_prod _ (translated_kernel_square_integrable hK hKi hK0 hf hf2)]
  simp_rw [integral_mul_const, integral_sub_left_eq_self]
  exact integral_const_mul _ _

theorem schur_quadratic_bound
    {K : ℝ → ℝ} {f : ℝ → ℂ} (hK : Continuous K) (hKi : Integrable K)
    (hK0 : ∀ t, 0 ≤ K t) (hKe : ∀ t, K (-t) = K t) (hf : Continuous f)
    (hf2 : Integrable (fun t => ‖f t‖^2)) :
    Integrable (fun p : ℝ × ℝ => K (p.1-p.2) * ‖f p.1‖ * ‖f p.2‖)
        (volume.prod volume) ∧
    (∫ p : ℝ × ℝ, K (p.1-p.2) * ‖f p.1‖ * ‖f p.2‖ ∂(volume.prod volume)) ≤
      (∫ t : ℝ, K t) * ∫ t : ℝ, ‖f t‖^2 := by
  have hleft := translated_kernel_square_integrable hK hKi hK0 hf hf2
  have hright : Integrable (fun p : ℝ × ℝ => K (p.1-p.2) * ‖f p.2‖^2)
      (volume.prod volume) := by
    have heq : (fun p : ℝ × ℝ => K (p.1-p.2) * ‖f p.2‖^2) =
        (fun p : ℝ × ℝ => K (p.1-p.2) * ‖f p.1‖^2) ∘ Prod.swap := by
      funext p
      dsimp
      rw [← neg_sub p.1 p.2, hKe]
    rw [heq]
    exact hleft.swap
  have hmaj := (hleft.add hright).div_const 2
  have hpoint (p : ℝ × ℝ) : K (p.1-p.2) * ‖f p.1‖ * ‖f p.2‖ ≤
      (K (p.1-p.2) * ‖f p.1‖^2 + K (p.1-p.2) * ‖f p.2‖^2) / 2 := by
    nlinarith [mul_nonneg (hK0 (p.1-p.2)) (sq_nonneg (‖f p.1‖-‖f p.2‖))]
  have hcross : Integrable (fun p : ℝ × ℝ => K (p.1-p.2) * ‖f p.1‖ * ‖f p.2‖)
      (volume.prod volume) := by
    apply hmaj.mono' (by fun_prop)
    filter_upwards [] with p
    rw [Real.norm_of_nonneg (mul_nonneg (mul_nonneg (hK0 _) (norm_nonneg _)) (norm_nonneg _))]
    exact hpoint p
  refine ⟨hcross, (integral_mono hcross hmaj hpoint).trans_eq ?_⟩
  change (∫ p : ℝ × ℝ, (K (p.1-p.2) * ‖f p.1‖^2 +
      K (p.1-p.2) * ‖f p.2‖^2) / 2 ∂(volume.prod volume)) = _
  rw [integral_div, integral_add hleft hright]
  have hr : (∫ p : ℝ × ℝ, K (p.1-p.2) * ‖f p.2‖^2 ∂(volume.prod volume)) =
      ∫ p : ℝ × ℝ, K (p.1-p.2) * ‖f p.1‖^2 ∂(volume.prod volume) := by
    rw [← MeasureTheory.integral_prod_swap]
    apply integral_congr_ae
    filter_upwards [] with p
    dsimp
    rw [← neg_sub p.1 p.2, hKe]
  rw [hr, translated_kernel_square_integral hK hKi hK0 hf hf2]
  ring

end Bounty
end

section

open scoped BigOperators ComplexConjugate
open MeasureTheory

namespace Bounty

theorem complex_finite_norm_sq {ι : Type*} (s : Finset ι) (z : ι → ℂ) :
    ‖∑ i ∈ s, z i‖ ^ 2 = ∑ i ∈ s, ∑ j ∈ s, (z i * conj (z j)).re := by
  have h := congrArg Complex.re (Complex.mul_conj' (∑ i ∈ s, z i))
  simp only [map_sum, Finset.sum_mul, Finset.mul_sum, Complex.re_sum,
    ← Complex.ofReal_pow, Complex.ofReal_re] at h
  exact h.symm.trans (Finset.sum_comm)

theorem interval_finite_gram_energy {ι : Type*} (s : Finset ι)
    (u : ι → ℝ → ℂ) (c : ι → ℂ) (a b : ℝ)
    (hu : ∀ i ∈ s, Continuous (u i)) :
    (∫ t in a..b, ‖∑ i ∈ s, c i * u i t‖ ^ 2) =
      ∑ i ∈ s, ∑ j ∈ s,
        (c i * conj (c j) * (∫ t in a..b, u i t * conj (u j t))).re := by
  simp_rw [complex_finite_norm_sq]
  rw [intervalIntegral.integral_finsetSum]
  · apply Finset.sum_congr rfl
    intro i hi
    rw [intervalIntegral.integral_finsetSum]
    · apply Finset.sum_congr rfl
      intro j hj
      have he : (fun t => (c i * u i t * conj (c j * u j t)).re) =
          (fun t => (c i * conj (c j) * (u i t * conj (u j t))).re) := by
        funext t
        congr 1
        simp only [map_mul]
        ring
      rw [he]
      have hij : IntervalIntegrable
          (fun t => c i * conj (c j) * (u i t * conj (u j t))) volume a b :=
        (continuous_const.mul ((hu i hi).mul (hu j hj).star)).intervalIntegrable a b
      change (∫ t in a..b, RCLike.re (c i * conj (c j) * (u i t * conj (u j t)))) = _
      rw [intervalIntegral.intervalIntegral_re hij, intervalIntegral.integral_const_mul]
      rfl
    · intro j hj
      have hui := hu i hi
      have huj := hu j hj
      apply Continuous.intervalIntegrable
      fun_prop
  · intro i hi
    apply Continuous.intervalIntegrable
    apply continuous_finsetSum
    intro j hj
    have hui := hu i hi
    have huj := hu j hj
    fun_prop

end Bounty
end

section

open scoped BigOperators ComplexConjugate
open MeasureTheory

namespace Bounty

theorem oscillatory_interval_norm_le {a b w : ℝ} (hw : w ≠ 0) :
    ‖∫ t in a..b, Complex.exp ((w * t : ℝ) * Complex.I)‖ ≤ 2 / |w| := by
  have he : (fun t : ℝ => Complex.exp ((w * t : ℝ) * Complex.I)) =
      (fun t : ℝ => Complex.exp (((w : ℂ) * Complex.I) * t)) := by
    funext t
    congr 1
    push_cast
    ring
  rw [he, integral_exp_mul_complex (mul_ne_zero (by exact_mod_cast hw) Complex.I_ne_zero),
    norm_div, norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs]
  apply div_le_div_of_nonneg_right _ (abs_nonneg w)
  calc
    ‖Complex.exp (↑w * Complex.I * ↑b) - Complex.exp (↑w * Complex.I * ↑a)‖ ≤
        ‖Complex.exp (↑w * Complex.I * ↑b)‖ + ‖Complex.exp (↑w * Complex.I * ↑a)‖ :=
      norm_sub_le _ _
    _ = 2 := by
      have h (t : ℝ) : ‖Complex.exp (↑w * Complex.I * ↑t)‖ = 1 := by
        have he : (w : ℂ) * Complex.I * (t : ℂ) = ((w * t : ℝ) : ℂ) * Complex.I := by
          push_cast
          ring
        rw [he]
        exact Complex.norm_exp_ofReal_mul_I (w * t)
      rw [h, h]
      norm_num

theorem oscillatory_interval_zero (a b : ℝ) :
    (∫ t in a..b, Complex.exp ((0 * t : ℝ) * Complex.I)) = (b - a : ℝ) := by
  simp

theorem logarithmic_gap_lower {x y N : ℝ} (hx : 0 < x) (hxy : x < y)
    (hyN : y ≤ N) : (y - x) / N ≤ Real.log y - Real.log x := by
  have hy : 0 < y := hx.trans hxy
  have h := Real.one_sub_inv_le_log_of_pos (div_pos hy hx)
  rw [Real.log_div hy.ne' hx.ne', inv_div] at h
  calc
    (y - x) / N ≤ (y - x) / y := div_le_div_of_nonneg_left (sub_nonneg.mpr hxy.le) hy hyN
    _ = 1 - x / y := by field_simp
    _ ≤ _ := h

end Bounty
end

section

open scoped BigOperators

namespace Bounty

theorem sum_inverse_lower_distances_le (s : Finset ℕ) (n N : ℕ)
    (hn : n ≤ N) :
    (∑ m ∈ s.filter (· < n), ((n - m : ℕ) : ℝ)⁻¹) ≤ 1 + Real.log N := by
  classical
  have hinj : Set.InjOn (fun m => n - m) (s.filter (· < n)) := by
    intro x hx y hy he
    dsimp only at he
    have hx' := (Finset.mem_filter.mp hx).2
    have hy' := (Finset.mem_filter.mp hy).2
    omega
  have hsub : (s.filter (· < n)).image (fun m => n - m) ⊆ Finset.Icc 1 N := by
    intro k hk
    obtain ⟨m, hm, rfl⟩ := Finset.mem_image.mp hk
    simp only [Finset.mem_filter] at hm
    simp only [Finset.mem_Icc]
    omega
  calc
    _ = ∑ k ∈ (s.filter (· < n)).image (fun m => n - m), (k : ℝ)⁻¹ :=
      (Finset.sum_image hinj).symm
    _ ≤ ∑ k ∈ Finset.Icc 1 N, (k : ℝ)⁻¹ :=
      Finset.sum_le_sum_of_subset_of_nonneg hsub (by intros; positivity)
    _ = (harmonic N : ℝ) := by
      simp only [harmonic_eq_sum_Icc, Rat.cast_sum, Rat.cast_inv, Rat.cast_natCast]
    _ ≤ _ := harmonic_le_one_add_log N

theorem sum_inverse_upper_distances_le (s : Finset ℕ) (n N : ℕ)
    (hs : ∀ m ∈ s, m ≤ N) :
    (∑ m ∈ s.filter (n < ·), ((m - n : ℕ) : ℝ)⁻¹) ≤ 1 + Real.log N := by
  classical
  have hinj : Set.InjOn (fun m => m - n) (s.filter (n < ·)) := by
    intro x hx y hy he
    dsimp only at he
    have hx' := (Finset.mem_filter.mp hx).2
    have hy' := (Finset.mem_filter.mp hy).2
    omega
  have hsub : (s.filter (n < ·)).image (fun m => m - n) ⊆ Finset.Icc 1 N := by
    intro k hk
    obtain ⟨m, hm, rfl⟩ := Finset.mem_image.mp hk
    have hm' := Finset.mem_filter.mp hm
    have hN := hs m hm'.1
    simp only [Finset.mem_Icc]
    omega
  calc
    _ = ∑ k ∈ (s.filter (n < ·)).image (fun m => m - n), (k : ℝ)⁻¹ :=
      (Finset.sum_image hinj).symm
    _ ≤ ∑ k ∈ Finset.Icc 1 N, (k : ℝ)⁻¹ :=
      Finset.sum_le_sum_of_subset_of_nonneg hsub (by intros; positivity)
    _ = (harmonic N : ℝ) := by
      simp only [harmonic_eq_sum_Icc, Rat.cast_sum, Rat.cast_inv, Rat.cast_natCast]
    _ ≤ _ := harmonic_le_one_add_log N

theorem sum_inverse_abs_distances_le (s : Finset ℕ) (n N : ℕ)
    (hn : n ≤ N) (hs : ∀ m ∈ s, m ≤ N) :
    (∑ m ∈ s, if m = n then 0 else |(n : ℝ) - m|⁻¹) ≤ 2 * (1 + Real.log N) := by
  have he : (∑ m ∈ s, if m = n then 0 else |(n : ℝ) - m|⁻¹) =
      (∑ m ∈ s.filter (· < n), ((n - m : ℕ) : ℝ)⁻¹) +
      (∑ m ∈ s.filter (n < ·), ((m - n : ℕ) : ℝ)⁻¹) := by
    rw [Finset.sum_filter, Finset.sum_filter, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro m _
    rcases lt_trichotomy m n with h | rfl | h
    · have hc : (m : ℝ) ≤ n := by exact_mod_cast h.le
      simp [h, h.ne, not_lt.mpr h.le, Nat.cast_sub h.le, abs_of_nonneg (sub_nonneg.mpr hc)]
    · simp
    · have hc : (n : ℝ) ≤ m := by exact_mod_cast h.le
      simp [h, h.ne', not_lt.mpr h.le, Nat.cast_sub h.le, abs_of_nonpos (sub_nonpos.mpr hc), neg_sub]
  rw [he]
  linarith [sum_inverse_lower_distances_le s n N hn, sum_inverse_upper_distances_le s n N hs]

end Bounty
end

section

/- Exact error propagation through normalized character averages and finite outer sums. -/

open Finset

namespace Bounty

noncomputable def normalizedCharacterAverage (n : ℕ)
    (S : DirichletCharacter ℂ n → ℂ) : ℂ :=
  (1/(n.totient:ℂ)) * ∑ χ, S χ

theorem normalized_character_average_zero (S : DirichletCharacter ℂ 0 → ℂ) :
    normalizedCharacterAverage 0 S = 0 := by
  simp [normalizedCharacterAverage]

theorem finite_complex_sum_error_le {ι : Type*} (J : Finset ι)
    (S T : ι → ℂ) (ε : ι → ℝ)
    (herror : ∀ j ∈ J, ‖S j - T j‖ ≤ ε j) :
    ‖(∑ j ∈ J, S j) - ∑ j ∈ J, T j‖ ≤ ∑ j ∈ J, ε j := by
  rw [← sum_sub_distrib]
  exact (norm_sum_le _ _).trans (sum_le_sum herror)

theorem normalized_character_average_error_le {n : ℕ} [NeZero n]
    (S T : DirichletCharacter ℂ n → ℂ) {ε : ℝ} (_hε : 0 ≤ ε)
    (herror : ∀ χ, ‖S χ - T χ‖ ≤ ε) :
    ‖normalizedCharacterAverage n S - normalizedCharacterAverage n T‖ ≤ ε := by
  classical
  have hcard : Fintype.card (DirichletCharacter ℂ n) = n.totient := by
    rw [← Nat.card_eq_fintype_card]
    exact DirichletCharacter.card_eq_totient_of_hasEnoughRootsOfUnity ℂ n
  have hφ : (0:ℝ) < n.totient := by
    exact_mod_cast Nat.totient_pos.mpr (NeZero.pos n)
  unfold normalizedCharacterAverage
  rw [← mul_sub, norm_mul, norm_div, norm_one, Complex.norm_natCast]
  calc
    _ ≤ (1/(n.totient:ℝ)) * ∑ _χ : DirichletCharacter ℂ n, ε :=
      mul_le_mul_of_nonneg_left
        (finite_complex_sum_error_le univ S T (fun _ => ε) (fun χ _ => herror χ))
        (by positivity)
    _ = (1/(n.totient:ℝ))*((n.totient:ℝ)*ε) := by simp [hcard]
    _ = ε := by field_simp

theorem normalized_character_family_error_le {ι : Type*} {n : ℕ} [NeZero n]
    (J : Finset ι) (S T : ι → DirichletCharacter ℂ n → ℂ) (ε : ι → ℝ)
    (hε : ∀ j ∈ J, 0 ≤ ε j)
    (herror : ∀ j ∈ J, ∀ χ, ‖S j χ - T j χ‖ ≤ ε j) :
    ‖normalizedCharacterAverage n (fun χ => ∑ j ∈ J, S j χ) -
      normalizedCharacterAverage n (fun χ => ∑ j ∈ J, T j χ)‖ ≤ ∑ j ∈ J, ε j := by
  apply normalized_character_average_error_le _ _ (sum_nonneg hε)
  intro χ
  exact finite_complex_sum_error_le J _ _ ε (fun j hj => herror j hj χ)

theorem normalized_character_box_error_le {ι : Type*} {n : ℕ} [NeZero n]
    (J : Finset ι) (S T : ι → DirichletCharacter ℂ n → ℂ) (Z : ι → ℝ) {ε : ℝ}
    (hZ : ∀ j ∈ J, 0 ≤ Z j) (hε : 0 ≤ ε)
    (herror : ∀ j ∈ J, ∀ χ, ‖S j χ - T j χ‖ ≤ Z j * ε) :
    ‖normalizedCharacterAverage n (fun χ => ∑ j ∈ J, S j χ) -
      normalizedCharacterAverage n (fun χ => ∑ j ∈ J, T j χ)‖ ≤ (∑ j ∈ J, Z j) * ε := by
  rw [sum_mul]
  exact normalized_character_family_error_le J S T (fun j => Z j * ε)
    (fun j hj => mul_nonneg (hZ j hj) hε) herror

theorem normalized_character_signed_sum_error_le (K : Finset ℤ)
    (S T : (k : ℤ) → DirichletCharacter ℂ (2*k.natAbs) → ℂ) (ε : ℤ → ℝ)
    (hε : ∀ k ∈ K, k ≠ 0 → 0 ≤ ε k)
    (herror : ∀ k ∈ K, k ≠ 0 → ∀ χ, ‖S k χ - T k χ‖ ≤ ε k) :
    ‖(∑ k ∈ K, normalizedCharacterAverage (2*k.natAbs) (S k)) -
      ∑ k ∈ K, normalizedCharacterAverage (2*k.natAbs) (T k)‖ ≤
        ∑ k ∈ K.filter (fun k => k ≠ 0), ε k := by
  classical
  have h := finite_complex_sum_error_le K
    (fun k => normalizedCharacterAverage (2*k.natAbs) (S k))
    (fun k => normalizedCharacterAverage (2*k.natAbs) (T k))
    (fun k => if k = 0 then 0 else ε k) (by
      intro k hk
      by_cases hk0 : k = 0
      · subst k
        simp [normalizedCharacterAverage]
      · rw [if_neg hk0]
        have hn : 2*k.natAbs ≠ 0 := by
          have habs : k.natAbs ≠ 0 := by simpa using hk0
          exact mul_ne_zero (by decide) habs
        exact @normalized_character_average_error_le (2*k.natAbs) ⟨hn⟩
          (S k) (T k) (ε k) (hε k hk hk0) (herror k hk hk0))
  simpa only [sum_filter, ite_not] using h

theorem normalized_character_signed_sum_error_le_card (K : Finset ℤ)
    (S T : (k : ℤ) → DirichletCharacter ℂ (2*k.natAbs) → ℂ) {ε : ℝ}
    (hε : 0 ≤ ε)
    (herror : ∀ k ∈ K, k ≠ 0 → ∀ χ, ‖S k χ - T k χ‖ ≤ ε) :
    ‖(∑ k ∈ K, normalizedCharacterAverage (2*k.natAbs) (S k)) -
      ∑ k ∈ K, normalizedCharacterAverage (2*k.natAbs) (T k)‖ ≤
        ((K.filter (fun k => k ≠ 0)).card:ℝ) * ε := by
  simpa using normalized_character_signed_sum_error_le K S T (fun _ => ε)
    (fun _ _ _ => hε) herror

theorem signed_interval_nonzero_card (N : ℕ) :
    ((Icc (-(N:ℤ)) (N:ℤ)).filter (fun k => k ≠ 0)).card = 2*N := by
  classical
  have hfilter : (Icc (-(N:ℤ)) (N:ℤ)).filter (fun k => k ≠ 0) =
      (Icc (-(N:ℤ)) (N:ℤ)).erase 0 := by
    ext k
    simp only [mem_filter, mem_erase]
    tauto
  have hmem : (0:ℤ) ∈ Icc (-(N:ℤ)) (N:ℤ) := by simp
  rw [hfilter, card_erase_of_mem hmem, Int.card_Icc]
  omega

theorem normalized_character_signed_interval_error_le (N : ℕ)
    (S T : (k : ℤ) → DirichletCharacter ℂ (2*k.natAbs) → ℂ) {ε : ℝ}
    (hε : 0 ≤ ε)
    (herror : ∀ k ∈ Icc (-(N:ℤ)) (N:ℤ), k ≠ 0 → ∀ χ, ‖S k χ - T k χ‖ ≤ ε) :
    ‖(∑ k ∈ Icc (-(N:ℤ)) (N:ℤ), normalizedCharacterAverage (2*k.natAbs) (S k)) -
      ∑ k ∈ Icc (-(N:ℤ)) (N:ℤ), normalizedCharacterAverage (2*k.natAbs) (T k)‖ ≤
        (2*(N:ℝ)) * ε := by
  have h := normalized_character_signed_sum_error_le_card (Icc (-(N:ℤ)) (N:ℤ)) S T hε herror
  simpa only [signed_interval_nonzero_card, Nat.cast_mul, Nat.cast_ofNat] using h


end Bounty
end

section

open Finset
open scoped ComplexConjugate

namespace Bounty

theorem finite_complex_sum_norm_sq {ι : Type*} (S : Finset ι) (f : ι → ℂ) :
    ‖∑ n ∈ S, f n‖^2 = ∑ m ∈ S, ∑ n ∈ S, (f m * conj (f n)).re := by
  calc
    _ = ((∑ n ∈ S, f n) * conj (∑ n ∈ S, f n)).re := by
      rw [Complex.mul_conj, Complex.ofReal_re, Complex.normSq_eq_norm_sq]
    _ = _ := by
      simp only [map_sum, mul_sum, sum_mul, Complex.re_sum]
      rw [sum_comm]

theorem finite_sum_norm_square_le_card {ι : Type*} (S : Finset ι) (f : ι → ℂ) :
    ‖∑ n ∈ S, f n‖^2 ≤ (S.card : ℝ) * ∑ n ∈ S, ‖f n‖^2 := by
  have hn := norm_sum_le S f
  have hc := sum_mul_sq_le_sq_mul_sq S (fun _ => (1:ℝ)) (fun n => ‖f n‖)
  simp only [one_mul, one_pow, sum_const, nsmul_eq_mul, mul_one] at hc
  exact (pow_le_pow_left₀ (norm_nonneg _) hn 2).trans hc

theorem finite_translate_sum_eq (S X : Finset ℤ) (f : ℤ → ℂ) (h : ℤ)
    (hsupport : ∀ n, n ∉ S → f n = 0)
    (hcover : ∀ n ∈ S, n-h ∈ X) :
    (∑ x ∈ X, f (x+h)) = ∑ n ∈ S, f n := by
  classical
  have hsub : S.image (fun n => n-h) ⊆ X := by
    intro x hx
    obtain ⟨n, hn, rfl⟩ := mem_image.mp hx
    exact hcover n hn
  have hz (x : ℤ) (hx : x ∈ X) (hxnot : x ∉ S.image (fun n => n-h)) : f (x+h) = 0 := by
    apply hsupport
    intro hxS
    apply hxnot
    apply mem_image.mpr
    exact ⟨x+h, hxS, by omega⟩
  rw [← sum_subset hsub hz, sum_image]
  · simp only [sub_add_cancel]
  · intro a ha b hb hab
    change a-h = b-h at hab
    exact sub_left_inj.mp hab

theorem finite_translate_average_identity (S H X : Finset ℤ) (f : ℤ → ℂ)
    (hsupport : ∀ n, n ∉ S → f n = 0)
    (hcover : ∀ n ∈ S, ∀ h ∈ H, n-h ∈ X) :
    (∑ x ∈ X, ∑ h ∈ H, f (x+h)) = (H.card : ℂ) * ∑ n ∈ S, f n := by
  rw [sum_comm]
  have he : (∑ h ∈ H, ∑ x ∈ X, f (x+h)) = ∑ _h ∈ H, ∑ n ∈ S, f n := by
    apply sum_congr rfl
    intro h hh
    exact finite_translate_sum_eq S X f h hsupport (fun n hn => hcover n hn h hh)
  rw [he, sum_const, nsmul_eq_mul]

theorem finite_translate_cauchy_gram (S H X : Finset ℤ) (f : ℤ → ℂ)
    (hsupport : ∀ n, n ∉ S → f n = 0)
    (hcover : ∀ n ∈ S, ∀ h ∈ H, n-h ∈ X) :
    (H.card : ℝ)^2 * ‖∑ n ∈ S, f n‖^2 ≤
      (X.card : ℝ) * ∑ h ∈ H, ∑ k ∈ H,
        (∑ x ∈ X, f (x+h) * conj (f (x+k))).re := by
  have hc := finite_sum_norm_square_le_card X (fun x => ∑ h ∈ H, f (x+h))
  rw [finite_translate_average_identity S H X f hsupport hcover,
    norm_mul, Complex.norm_natCast, mul_pow] at hc
  apply hc.trans_eq
  congr 1
  simp_rw [finite_complex_sum_norm_sq]
  rw [sum_comm]
  apply sum_congr rfl
  intro h hh
  rw [sum_comm]
  apply sum_congr rfl
  intro k hk
  simp only [Complex.re_sum]

end Bounty
end

section

/- A finite summation identity for reciprocals of phase increments. -/

open Finset

namespace Bounty

theorem sum_phase_weighted_difference (u w : ℕ → ℂ) (N : ℕ) :
    (∑ n ∈ range N, w n * (u n-u (n+1))) =
      w 0*u 0-w N*u N + ∑ n ∈ range N, (w (n+1)-w n)*u (n+1) := by
  induction N with
  | zero => simp
  | succ N hN =>
    rw [sum_range_succ, sum_range_succ, hN]
    ring

theorem sum_phase_reciprocal_identity (u w : ℕ → ℂ) (N : ℕ)
    (hw : ∀ n < N, w n*(u n-u (n+1)) = u n) :
    (∑ n ∈ range N, u n) =
      w 0*u 0-w N*u N + ∑ n ∈ range N, (w (n+1)-w n)*u (n+1) := by
  rw [← sum_phase_weighted_difference]
  apply sum_congr rfl
  intro n hn
  exact (hw n (mem_range.mp hn)).symm

theorem sum_phase_reciprocal_norm_le (u w : ℕ → ℂ) (N : ℕ)
    (hw : ∀ n < N, w n*(u n-u (n+1)) = u n)
    (hu : ∀ n ≤ N, ‖u n‖ ≤ 1) :
    ‖∑ n ∈ range N, u n‖ ≤ ‖w 0‖+‖w N‖ + ∑ n ∈ range N, ‖w (n+1)-w n‖ := by
  rw [sum_phase_reciprocal_identity u w N hw]
  calc
    _ ≤ ‖w 0*u 0‖+‖w N*u N‖ + ∑ n ∈ range N, ‖(w (n+1)-w n)*u (n+1)‖ :=
      (norm_add_le _ _).trans (add_le_add (norm_sub_le _ _) (norm_sum_le _ _))
    _ ≤ _ := by
      apply add_le_add
      · apply add_le_add
        · rw [norm_mul]
          exact mul_le_of_le_one_right (norm_nonneg _) (hu 0 (Nat.zero_le N))
        · rw [norm_mul]
          exact mul_le_of_le_one_right (norm_nonneg _) (hu N le_rfl)
      · apply sum_le_sum
        intro n hn
        rw [norm_mul]
        exact mul_le_of_le_one_right (norm_nonneg _) (hu (n+1) (by have := mem_range.mp hn; omega))

end Bounty
end

section

/- The explicit reciprocal of a nontrivial unit-circle phase increment. -/

open Real

namespace Bounty

noncomputable def phaseReciprocalKernel (θ : ℝ) : ℂ :=
  ⟨1/2, cos (θ/2)/(2*sin (θ/2))⟩

theorem phase_reciprocal_kernel_re (θ : ℝ) : (phaseReciprocalKernel θ).re = 1/2 := rfl

theorem phase_reciprocal_kernel_im (θ : ℝ) :
    (phaseReciprocalKernel θ).im = cos (θ/2)/(2*sin (θ/2)) := rfl

theorem phase_reciprocal_kernel_mul {θ : ℝ} (hθ : sin (θ/2) ≠ 0) :
    phaseReciprocalKernel θ * (1-Complex.exp ((θ : ℂ)*Complex.I)) = 1 := by
  have hc : cos θ = 2*(cos (θ/2))^2-1 := by
    simpa only [mul_div_cancel₀ _ (by norm_num : (2 : ℝ) ≠ 0)] using cos_two_mul (θ/2)
  have hs : sin θ = 2*sin (θ/2)*cos (θ/2) := by
    simpa only [mul_div_cancel₀ _ (by norm_num : (2 : ℝ) ≠ 0)] using sin_two_mul (θ/2)
  have hunit := sin_sq_add_cos_sq (θ/2)
  have hunitc := congrArg (fun x : ℝ => x*cos (θ/2)) hunit
  apply Complex.ext
  · simp only [Complex.mul_re, phase_reciprocal_kernel_re, phase_reciprocal_kernel_im,
      Complex.sub_re, Complex.sub_im, Complex.one_re, Complex.one_im,
      Complex.exp_ofReal_mul_I_re, Complex.exp_ofReal_mul_I_im]
    rw [hc,hs]
    field_simp
    <;> ring
  · simp only [Complex.mul_im, phase_reciprocal_kernel_re, phase_reciprocal_kernel_im,
      Complex.sub_re, Complex.sub_im, Complex.one_re, Complex.one_im,
      Complex.exp_ofReal_mul_I_re, Complex.exp_ofReal_mul_I_im]
    rw [hc,hs]
    field_simp
    nlinarith only [hunitc]

end Bounty
end

section

/- Explicit sine and cotangent bounds on a fractional phase band. -/

open Real Set

namespace Bounty

theorem sine_pi_lower_on_unit_band {δ x : ℝ} (hδ : 0 < δ)
    (hδhalf : δ ≤ 1/2) (hx : δ ≤ x ∧ x ≤ 1-δ) :
    2*δ ≤ sin (Real.pi*x) := by
  have hpi : 0 < Real.pi := pi_pos
  have half_bound {y : ℝ} (hy0 : 0 ≤ y) (hy1 : y ≤ 1/2) : 2*y ≤ sin (Real.pi*y) := by
    have hh := mul_le_sin (show 0 ≤ Real.pi*y by positivity)
      (show Real.pi*y ≤ Real.pi/2 by nlinarith)
    have he : 2/Real.pi*(Real.pi*y) = 2*y := by field_simp
    rwa [he] at hh
  by_cases hxhalf : x ≤ 1/2
  · exact (by linarith : 2*δ ≤ 2*x).trans (half_bound (by linarith) hxhalf)
  · have hh := half_bound (y := 1-x) (by linarith) (by linarith)
    have he : Real.pi*(1-x) = Real.pi-Real.pi*x := by ring
    rw [he, sin_pi_sub] at hh
    exact (by linarith : 2*δ ≤ 2*(1-x)).trans hh

theorem strictAntiOn_unit_cotangent :
    StrictAntiOn (fun x : ℝ => cos (Real.pi*x)/sin (Real.pi*x)) (Ioo 0 1) := by
  intro x hx y hy hxy
  have hsx : 0 < sin (Real.pi*x) := sin_pos_of_pos_of_lt_pi (mul_pos pi_pos hx.1)
    (by nlinarith [mul_lt_mul_of_pos_left hx.2 pi_pos])
  have hsy : 0 < sin (Real.pi*y) := sin_pos_of_pos_of_lt_pi (mul_pos pi_pos hy.1)
    (by nlinarith [mul_lt_mul_of_pos_left hy.2 pi_pos])
  apply (div_lt_div_iff₀ hsy hsx).mpr
  have hsin : 0 < sin (Real.pi*y-Real.pi*x) := sin_pos_of_pos_of_lt_pi
    (by nlinarith [mul_lt_mul_of_pos_left hxy pi_pos])
    (by nlinarith [mul_lt_mul_of_pos_left (show y-x < 1 by linarith [hx.1,hy.2]) pi_pos])
  rw [sin_sub] at hsin
  nlinarith

end Bounty
end

section

/- Unit-period additive phases and exact removal of integer increments. -/

namespace Bounty

noncomputable def realUnitPhase (x : ℝ) : ℂ :=
  Complex.exp (((2*Real.pi*x : ℝ) : ℂ)*Complex.I)

theorem real_unit_phase_norm (x : ℝ) : ‖realUnitPhase x‖ = 1 :=
  Complex.norm_exp_ofReal_mul_I _

theorem real_unit_phase_add (x y : ℝ) :
    realUnitPhase (x+y) = realUnitPhase x*realUnitPhase y := by
  unfold realUnitPhase
  rw [← Complex.exp_add]
  congr 1
  push_cast
  ring

theorem real_unit_phase_int (k : ℤ) : realUnitPhase (k : ℝ) = 1 := by
  unfold realUnitPhase
  have he : (((2*Real.pi*(k : ℝ) : ℝ) : ℂ)*Complex.I) =
      (k : ℂ)*(2*(Real.pi : ℂ)*Complex.I) := by push_cast; ring
  rw [he,Complex.exp_int_mul_two_pi_mul_I]

theorem real_unit_phase_sub_int (x : ℝ) (k : ℤ) : realUnitPhase (x-k) = realUnitPhase x := by
  rw [sub_eq_add_neg, real_unit_phase_add]
  have he : realUnitPhase (-(k : ℝ)) = 1 := by
    simpa only [Int.cast_neg] using real_unit_phase_int (-k)
  rw [he,mul_one]

theorem real_unit_phase_increment (x y : ℝ) (k : ℤ) :
    realUnitPhase y = realUnitPhase x*realUnitPhase (y-x-k) := by
  rw [real_unit_phase_sub_int,← real_unit_phase_add]
  congr 1
  ring

end Bounty
end

section

/- Unit increments inherit bounds and monotonicity from the first derivative. -/

namespace Bounty

theorem first_derivative_unit_increment_bounds {f f' : ℝ → ℝ} {a b c C : ℝ}
    (hf : ∀ x ∈ Set.Icc a (b+1), HasDerivAt f (f' x) x)
    (hb : ∀ x ∈ Set.Icc a (b+1), c ≤ f' x ∧ f' x ≤ C)
    {x : ℝ} (hx : x ∈ Set.Icc a b) : c ≤ f (x+1)-f x ∧ f (x+1)-f x ≤ C := by
  have hs : Set.Icc x (x+1) ⊆ Set.Icc a (b+1) := by
    intro y hy
    exact ⟨hx.1.trans hy.1, hy.2.trans (by linarith [hx.2])⟩
  obtain ⟨y,hy,he⟩ := exists_hasDerivAt_eq_slope f f' (show x < x+1 by linarith)
    (fun t ht => (hf t (hs ht)).continuousAt.continuousWithinAt)
    (fun t ht => hf t (hs ⟨ht.1.le,ht.2.le⟩))
  have hbound := hb y (hs ⟨hy.1.le,hy.2.le⟩)
  rw [he] at hbound
  simpa only [add_sub_cancel_left,div_one] using hbound

theorem hasDerivAt_unit_increment {f f' : ℝ → ℝ} {a b x : ℝ}
    (hf : ∀ t ∈ Set.Icc a (b+1), HasDerivAt f (f' t) t)
    (hx : x ∈ Set.Icc a b) :
    HasDerivAt (fun t => f (t+1)-f t) (f' (x+1)-f' x) x := by
  have h0 : x ∈ Set.Icc a (b+1) := ⟨hx.1,by linarith [hx.2]⟩
  have h1 : x+1 ∈ Set.Icc a (b+1) := ⟨by linarith [hx.1],by linarith [hx.2]⟩
  simpa only [mul_one,Function.comp_def,id_eq,Pi.sub_apply] using
    ((hf (x+1) h1).comp x ((hasDerivAt_id x).add_const 1)).fun_sub (hf x h0)

theorem monotoneOn_unit_increment {f f' : ℝ → ℝ} {a b : ℝ}
    (hf : ∀ x ∈ Set.Icc a (b+1), HasDerivAt f (f' x) x)
    (hm : MonotoneOn f' (Set.Icc a (b+1))) :
    MonotoneOn (fun x => f (x+1)-f x) (Set.Icc a b) := by
  have hd := fun x hx => hasDerivAt_unit_increment hf (x := x) hx
  apply monotoneOn_of_deriv_nonneg (convex_Icc a b)
    (fun x hx => (hd x hx).continuousAt.continuousWithinAt)
    (fun x hx => (hd x (interior_subset hx)).differentiableAt.differentiableWithinAt)
  intro x hx
  have hx' := interior_subset hx
  rw [(hd x hx').deriv]
  exact sub_nonneg.mpr (hm ⟨hx'.1,by linarith [hx'.2]⟩
    ⟨by linarith [hx'.1],by linarith [hx'.2]⟩ (by linarith))

theorem antitoneOn_unit_increment {f f' : ℝ → ℝ} {a b : ℝ}
    (hf : ∀ x ∈ Set.Icc a (b+1), HasDerivAt f (f' x) x)
    (hm : AntitoneOn f' (Set.Icc a (b+1))) :
    AntitoneOn (fun x => f (x+1)-f x) (Set.Icc a b) := by
  have hd := fun x hx => hasDerivAt_unit_increment hf (x := x) hx
  apply antitoneOn_of_deriv_nonpos (convex_Icc a b)
    (fun x hx => (hd x hx).continuousAt.continuousWithinAt)
    (fun x hx => (hd x (interior_subset hx)).differentiableAt.differentiableWithinAt)
  intro x hx
  have hx' := interior_subset hx
  rw [(hd x hx').deriv]
  exact sub_nonpos.mpr (hm ⟨hx'.1,by linarith [hx'.2]⟩
    ⟨by linarith [hx'.1],by linarith [hx'.2]⟩ (by linarith))

end Bounty
end

section

/- Finite geometry of monotone phase increments, independent of cancellation estimates. -/

open Finset

namespace Bounty

noncomputable def discreteSlopeBand (a b : ℕ) (d : ℕ → ℝ) (x y : ℝ) : Finset ℕ :=
  (Icc a b).filter (fun n => x ≤ d n ∧ d n ≤ y)

theorem discrete_slope_band_interval {a b : ℕ} {d : ℕ → ℝ} {x y : ℝ}
    (hmono : MonotoneOn d (Set.Icc a b))
    (hne : (discreteSlopeBand a b d x y).Nonempty) :
    discreteSlopeBand a b d x y =
      Icc ((discreteSlopeBand a b d x y).min' hne)
        ((discreteSlopeBand a b d x y).max' hne) := by
  classical
  let S := discreteSlopeBand a b d x y
  have hlo := mem_filter.mp (S.min'_mem hne)
  have hhi := mem_filter.mp (S.max'_mem hne)
  ext n
  constructor
  · intro hn
    exact mem_Icc.mpr ⟨S.min'_le n hn,S.le_max' n hn⟩
  · intro hn
    obtain ⟨hl,hr⟩ := mem_Icc.mp hn
    have hnab : n ∈ Set.Icc a b :=
      ⟨(mem_Icc.mp hlo.1).1.trans hl,hr.trans (mem_Icc.mp hhi.1).2⟩
    exact mem_filter.mpr ⟨mem_Icc.mpr hnab,
      ⟨hlo.2.1.trans (hmono (mem_Icc.mp hlo.1) hnab hl),
       (hmono hnab (mem_Icc.mp hhi.1) hr).trans hhi.2.2⟩⟩

theorem separated_slope_card_bound (S : Finset ℕ) (d : ℕ → ℝ) {lam x y : ℝ}
    (hlam : 0 < lam) (hxy : x ≤ y)
    (hS : ∀ n ∈ S, x ≤ d n ∧ d n ≤ y)
    (hsep : ∀ i ∈ S, ∀ j ∈ S, i ≤ j → lam*((j : ℝ)-i) ≤ d j-d i) :
    (S.card : ℝ) ≤ (y-x)/lam+1 := by
  classical
  by_cases hne : S.Nonempty
  · let lo := S.min' hne
    let hi := S.max' hne
    have hlo : lo ∈ S := S.min'_mem hne
    have hhi : hi ∈ S := S.max'_mem hne
    have hle : lo ≤ hi := S.min'_le_max' hne
    have hcard : S.card ≤ hi+1-lo := by
      simpa only [Nat.card_Icc] using card_le_card
        (show S ⊆ Icc lo hi from fun n hn => mem_Icc.mpr ⟨S.min'_le n hn,S.le_max' n hn⟩)
    have hcardR : (S.card : ℝ) ≤ (hi : ℝ)+1-lo := by
      have hc := (Nat.cast_le (α := ℝ)).mpr hcard
      simpa only [Nat.cast_sub (show lo ≤ hi+1 by omega),Nat.cast_add,Nat.cast_one] using hc
    have hgap := hsep lo hlo hi hhi hle
    have hx := (hS lo hlo).1
    have hy := (hS hi hhi).2
    have hquot : lam*((y-x)/lam)=y-x := by field_simp
    nlinarith
  · rw [not_nonempty_iff_eq_empty.mp hne]
    simp only [card_empty,Nat.cast_zero]
    positivity

theorem discrete_slope_band_card_bound {a b : ℕ} {d : ℕ → ℝ} {lam x y : ℝ}
    (hlam : 0 < lam) (hxy : x ≤ y)
    (hsep : ∀ i ∈ Icc a b, ∀ j ∈ Icc a b, i ≤ j → lam*((j : ℝ)-i) ≤ d j-d i) :
    ((discreteSlopeBand a b d x y).card : ℝ) ≤ (y-x)/lam+1 := by
  apply separated_slope_card_bound _ d hlam hxy
  · intro n hn
    exact (mem_filter.mp hn).2
  · intro i hi j hj hij
    exact hsep i (mem_filter.mp hi).1 j (mem_filter.mp hj).1 hij

theorem floor_slope_range_card {a b : ℕ} {d : ℕ → ℝ}
    (hab : a ≤ b) (hmono : MonotoneOn d (Set.Icc a b)) :
    ((Icc ⌊d a⌋ ⌊d b⌋).card : ℝ) ≤ d b-d a+2 := by
  have hle := Int.floor_mono (hmono ⟨le_rfl,hab⟩ ⟨hab,le_rfl⟩ hab)
  have hc := Int.card_Icc_of_le ⌊d a⌋ ⌊d b⌋ (show ⌊d a⌋ ≤ ⌊d b⌋+1 by omega)
  have hcR : ((Icc ⌊d a⌋ ⌊d b⌋).card : ℝ) = (⌊d b⌋ : ℝ)+1-⌊d a⌋ := by
    exact_mod_cast hc
  rw [hcR]
  have ha := Int.lt_floor_add_one (d a)
  have hb := Int.floor_le (d b)
  linarith

end Bounty
end

section

/- Second derivative bounds imply the separated phase increments used by finite slope partitioning. -/

namespace Bounty

theorem interval_secant_bounds {f f' : ℝ → ℝ} {a b c C : ℝ}
    (hf : ∀ x ∈ Set.Icc a b, HasDerivAt f (f' x) x)
    (hb : ∀ x ∈ Set.Icc a b, c ≤ f' x ∧ f' x ≤ C)
    {x y : ℝ} (hx : x ∈ Set.Icc a b) (hy : y ∈ Set.Icc a b) (hxy : x ≤ y) :
    c*(y-x) ≤ f y-f x ∧ f y-f x ≤ C*(y-x) := by
  have hc : ContinuousOn f (Set.Icc a b) := fun t ht => (hf t ht).continuousAt.continuousWithinAt
  have hd : DifferentiableOn ℝ f (interior (Set.Icc a b)) :=
    fun t ht => (hf t (interior_subset ht)).differentiableAt.differentiableWithinAt
  constructor
  · apply (convex_Icc a b).mul_sub_le_image_sub_of_le_deriv hc hd _ x hx y hy hxy
    intro t ht
    rw [(hf t (interior_subset ht)).deriv]
    exact (hb t (interior_subset ht)).1
  · apply (convex_Icc a b).image_sub_le_mul_sub_of_deriv_le hc hd _ x hx y hy hxy
    intro t ht
    rw [(hf t (interior_subset ht)).deriv]
    exact (hb t (interior_subset ht)).2

theorem second_derivative_increment_bounds {f f' f'' : ℝ → ℝ} {a b lam B : ℝ}
    (hf : ∀ x ∈ Set.Icc a (b+1), HasDerivAt f (f' x) x)
    (hf' : ∀ x ∈ Set.Icc a (b+1), HasDerivAt f' (f'' x) x)
    (hb : ∀ x ∈ Set.Icc a (b+1), lam ≤ f'' x ∧ f'' x ≤ B)
    {x y : ℝ} (hx : x ∈ Set.Icc a b) (hy : y ∈ Set.Icc a b) (hxy : x ≤ y) :
    lam*(y-x) ≤ (f (y+1)-f y)-(f (x+1)-f x) ∧
      (f (y+1)-f y)-(f (x+1)-f x) ≤ B*(y-x) := by
  have hd (t : ℝ) (ht : t ∈ Set.Icc a b) :
      HasDerivAt (fun t => f (t+1)-f t) (f' (t+1)-f' t) t := by
    have ht0 : t ∈ Set.Icc a (b+1) := ⟨ht.1,by linarith [ht.2]⟩
    have ht1 : t+1 ∈ Set.Icc a (b+1) := ⟨by linarith [ht.1],by linarith [ht.2]⟩
    simpa only [mul_one,Function.comp_def,id_eq,Pi.sub_apply] using
      ((hf (t+1) ht1).comp t ((hasDerivAt_id t).add_const 1)).fun_sub (hf t ht0)
  have hbound (t : ℝ) (ht : t ∈ Set.Icc a b) :
      lam ≤ f' (t+1)-f' t ∧ f' (t+1)-f' t ≤ B := by
    have ht0 : t ∈ Set.Icc a (b+1) := ⟨ht.1,by linarith [ht.2]⟩
    have ht1 : t+1 ∈ Set.Icc a (b+1) := ⟨by linarith [ht.1],by linarith [ht.2]⟩
    simpa only [add_sub_cancel_left,mul_one] using
      interval_secant_bounds hf' hb ht0 ht1 (show t ≤ t+1 by linarith)
  exact interval_secant_bounds hd hbound hx hy hxy

end Bounty
end

section

/- Exact conversion between nonnegative integer intervals and natural intervals. -/

open Finset

namespace Bounty

theorem nat_sum_eq_integer_interval_sum (g : ℤ → ℂ) (a b : ℕ) :
    ∑ n ∈ Icc a b, g (n : ℤ) = ∑ n ∈ Icc (a : ℤ) (b : ℤ), g n := by
  apply sum_bij (fun (n : ℕ) _ => (n : ℤ))
  · intro n hn
    obtain ⟨hl,hr⟩ := mem_Icc.mp hn
    exact mem_Icc.mpr ⟨by exact_mod_cast hl,by exact_mod_cast hr⟩
  · intro n hn m hm he
    exact_mod_cast he
  · intro z hz
    obtain ⟨hl,hr⟩ := mem_Icc.mp hz
    refine ⟨z.toNat, mem_Icc.mpr ⟨?_, ?_⟩, ?_⟩ <;> omega
  · intro n hn
    rfl

end Bounty
end

section

/- Cardinality controls logarithmic sums at small frequencies. -/

open Finset

namespace Bounty

theorem norm_nat_log_phase_le_card (a b : ℕ) (t : ℝ) :
    ‖∑ n ∈ Icc a b, Complex.exp ((t*Real.log (n : ℝ) : ℝ)*Complex.I)‖ ≤
      ((Icc a b).card : ℝ) := by
  calc
    _ ≤ ∑ n ∈ Icc a b, ‖Complex.exp ((t*Real.log (n : ℝ) : ℝ)*Complex.I)‖ := norm_sum_le _ _
    _ = _ := by simp only [Complex.norm_exp_ofReal_mul_I,sum_const,nsmul_eq_mul,mul_one]

theorem norm_nat_log_phase_small (a b : ℕ) (U t : ℝ)
    (hU : 1 ≤ U) (ha : U ≤ (a : ℝ)) (hb : (b : ℝ) ≤ 2*U) (ht : |t| ≤ 1) :
    ‖∑ n ∈ Icc a b, Complex.exp ((t*Real.log (n : ℝ) : ℝ)*Complex.I)‖ ≤
      4*U/(1+|t|) := by
  have hc : ((Icc a b).card : ℝ) ≤ 2*U := by
    rw [Nat.card_Icc]
    by_cases hab : a ≤ b+1
    · rw [Nat.cast_sub hab,Nat.cast_add,Nat.cast_one]
      linarith
    · rw [Nat.sub_eq_zero_of_le (by omega),Nat.cast_zero]
      linarith
  calc
    _ ≤ ((Icc a b).card : ℝ) := norm_nat_log_phase_le_card a b t
    _ ≤ 2*U := hc
    _ ≤ 4*U/(1+|t|) := by
      apply (le_div_iff₀ (by positivity : 0 < 1+|t|)).mpr
      nlinarith

end Bounty
end

section

/- Product fibers of ordered prime tuples, allowing repeated primes. -/

namespace Bounty

open Finset

def primeTupleProduct (P : Finset ℕ) (j : ℕ) (a : Fin j → P) : ℕ :=
  ∏ r, (a r).val

theorem prime_tuple_product_eq_iff_perm (P : Finset ℕ)
    (hP : ∀ p ∈ P, Nat.Prime p) (j : ℕ) (a b : Fin j → P) :
    primeTupleProduct P j a = primeTupleProduct P j b ↔
      (List.ofFn (fun r => (a r).val)).Perm (List.ofFn (fun r => (b r).val)) := by
  constructor
  · intro hab
    apply perm_of_prod_eq_prod
    · simpa only [List.prod_ofFn, primeTupleProduct] using hab
    · intro p hp
      obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hp
      exact Nat.prime_iff.mp (hP _ (a i).property)
    · intro p hp
      obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hp
      exact Nat.prime_iff.mp (hP _ (b i).property)
  · intro hab
    simpa only [List.prod_ofFn, primeTupleProduct] using hab.prod_eq

theorem prime_tuple_product_fiber_card_le_factorial (P : Finset ℕ)
    (hP : ∀ p ∈ P, Nat.Prime p) (j n : ℕ) :
    ((Finset.univ : Finset (Fin j → P)).filter
      (fun a => primeTupleProduct P j a = n)).card ≤ j.factorial := by
  classical
  let fiber := (Finset.univ : Finset (Fin j → P)).filter
    (fun a => primeTupleProduct P j a = n)
  change fiber.card ≤ j.factorial
  by_cases hf : fiber.Nonempty
  · obtain ⟨a₀, ha₀⟩ := hf
    let L : (Fin j → P) → List ℕ := fun a => List.ofFn (fun r => (a r).val)
    have hL : Function.Injective L := by
      intro a b hab
      have hv := List.ofFn_injective hab
      funext i
      exact Subtype.ext (congrFun hv i)
    have hsub : fiber.image L ⊆ (L a₀).permutations.toFinset := by
      intro l hl
      obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hl
      apply List.mem_toFinset.mpr
      apply List.mem_permutations.mpr
      apply (prime_tuple_product_eq_iff_perm P hP j a a₀).mp
      exact (Finset.mem_filter.mp ha).2.trans (Finset.mem_filter.mp ha₀).2.symm
    calc
      fiber.card = (fiber.image L).card := (Finset.card_image_of_injective fiber hL).symm
      _ ≤ (L a₀).permutations.toFinset.card := Finset.card_le_card hsub
      _ ≤ (L a₀).permutations.length := List.toFinset_card_le _
      _ = j.factorial := by simp [List.length_permutations, L]
  · have he : fiber = ∅ := Finset.not_nonempty_iff_eq_empty.mp hf
    simp [he]

end Bounty
end

section

/- Regrouping finite complex sums and their squared norms by fibers.
The cardinal bound is used only in the intermediate estimate; prime-product
fibers will supply it in the arithmetic specialization. -/

open Finset
open scoped Classical
namespace Bounty

theorem finite_complex_sum_norm_sq_le_card {X : Type*} (s : Finset X) (a : X → ℂ) :
    ‖∑ x ∈ s, a x‖ ^ 2 ≤ (s.card : ℝ) * ∑ x ∈ s, ‖a x‖ ^ 2 := by
  exact ((sq_le_sq₀ (norm_nonneg _) (sum_nonneg fun x _ => norm_nonneg (a x))).mpr
    (norm_sum_le s a)).trans (sq_sum_le_card_mul_sum_sq)

theorem finite_fiber_sum_mul {X Y : Type*} [Fintype X] [DecidableEq Y]
    (f : X → Y) (a : X → ℂ) (b : Y → ℂ) :
    (∑ y ∈ univ.image f, (∑ x ∈ univ.filter (fun x => f x = y), a x) * b y) =
      ∑ x, a x * b (f x) := by
  calc
    _ = ∑ y ∈ univ.image f, ∑ x ∈ univ.filter (fun x => f x = y), a x * b (f x) := by
      apply sum_congr rfl
      intro y _
      rw [sum_mul]
      apply sum_congr rfl
      intro x hx
      rw [(mem_filter.mp hx).2]
    _ = _ := sum_fiberwise_of_maps_to (fun x hx => mem_image_of_mem f hx) _

theorem finite_fiber_sum_norm_sq_le {X Y : Type*} [Fintype X] [DecidableEq Y]
    (f : X → Y) (a : X → ℂ) (M : ℕ)
    (hM : ∀ y ∈ univ.image f, (univ.filter (fun x => f x = y)).card ≤ M) :
    (∑ y ∈ univ.image f, ‖∑ x ∈ univ.filter (fun x => f x = y), a x‖ ^ 2) ≤
      (M : ℝ) * ∑ x, ‖a x‖ ^ 2 := by
  calc
    _ ≤ ∑ y ∈ univ.image f, (M : ℝ) * ∑ x ∈ univ.filter (fun x => f x = y), ‖a x‖ ^ 2 := by
      apply sum_le_sum
      intro y hy
      exact (finite_complex_sum_norm_sq_le_card _ a).trans
        (mul_le_mul_of_nonneg_right (Nat.cast_le.mpr (hM y hy)) (sum_nonneg fun x _ => sq_nonneg _))
    _ = _ := by
      rw [← mul_sum, sum_fiberwise_of_maps_to (fun x hx => mem_image_of_mem f hx)]

end Bounty
end

section

/- Occupied unit intervals give a finite, explicit exceptional set. One
witness from each occupied interval is separated after splitting the integer
indices into three residue classes. The resulting count uses the genuine
Sobolev sampling inequality, with one unit of room to the right. -/

open Finset Set MeasureTheory
open scoped BigOperators Classical

namespace Bounty

noncomputable def occupiedUnitIntervals (indices : Finset ℤ) (E : Set ℝ) : Finset ℤ :=
  indices.filter (fun j => ∃ t ∈ Set.Icc (j : ℝ) ((j : ℝ) + 1), t ∈ E)

theorem mem_occupiedUnitIntervals (indices : Finset ℤ) (E : Set ℝ) (j : ℤ) :
    j ∈ occupiedUnitIntervals indices E ↔
      j ∈ indices ∧ ∃ t ∈ Set.Icc (j : ℝ) ((j : ℝ) + 1), t ∈ E := by
  simp only [occupiedUnitIntervals, Finset.mem_filter]

noncomputable def occupiedUnitIntervalPoint (E : Set ℝ) (j : ℤ) : ℝ :=
  if h : ∃ t ∈ Set.Icc (j : ℝ) ((j : ℝ) + 1), t ∈ E then h.choose else (j : ℝ)

theorem occupiedUnitIntervalPoint_spec (indices : Finset ℤ) (E : Set ℝ) (j : ℤ)
    (hj : j ∈ occupiedUnitIntervals indices E) :
    occupiedUnitIntervalPoint E j ∈ Set.Icc (j : ℝ) ((j : ℝ) + 1) ∧
      occupiedUnitIntervalPoint E j ∈ E := by
  have h := ((mem_occupiedUnitIntervals indices E j).mp hj).2
  rw [occupiedUnitIntervalPoint, dif_pos h]
  exact h.choose_spec

def unitIntervalResidue (j : ℤ) : Fin 3 :=
  ⟨(j % 3).toNat, by
    have h0 := Int.emod_nonneg j (by norm_num : (3 : ℤ) ≠ 0)
    have h3 := Int.emod_lt_of_pos j (by norm_num : (0 : ℤ) < 3)
    omega⟩

theorem unit_interval_residue_separated {i j : ℤ} {x y : ℝ}
    (hx : x ∈ Set.Icc (i : ℝ) ((i : ℝ) + 1))
    (hy : y ∈ Set.Icc (j : ℝ) ((j : ℝ) + 1))
    (hres : unitIntervalResidue i = unitIntervalResidue j) (hne : i ≠ j) :
    1 ≤ |x - y| := by
  have he := congrArg Fin.val hres
  dsimp only [unitIntervalResidue] at he
  have hi0 := Int.emod_nonneg i (by norm_num : (3 : ℤ) ≠ 0)
  have hj0 := Int.emod_nonneg j (by norm_num : (3 : ℤ) ≠ 0)
  rcases lt_or_gt_of_ne hne with hij | hji
  · have hgap : i + 3 ≤ j := by omega
    have hgapR : (i : ℝ) + 3 ≤ (j : ℝ) := by exact_mod_cast hgap
    have habs : y - x ≤ |x - y| := by
      simpa only [abs_sub_comm] using le_abs_self (y - x)
    linarith [hx.2, hy.1]
  · have hgap : j + 3 ≤ i := by omega
    have hgapR : (j : ℝ) + 3 ≤ (i : ℝ) := by exact_mod_cast hgap
    have habs := le_abs_self (x - y)
    linarith [hy.2, hx.1]

theorem unit_interval_residue_card_sum (indices : Finset ℤ) :
    (∑ r : Fin 3, (indices.filter (fun j => unitIntervalResidue j = r)).card) = indices.card := by
  exact (Finset.card_eq_sum_card_fiberwise
    (s := indices) (t := Finset.univ) (f := unitIntervalResidue)
    (fun _ _ => Finset.mem_univ _)).symm

theorem occupied_unit_intervals_card_energy_le {H : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (indices : Finset ℤ) (E : Set ℝ) (F F' : ℝ → H) {a b η K Q : ℝ}
    (hab : a ≤ b) (hleft : ∀ j ∈ indices, a ≤ (j : ℝ))
    (hright : ∀ j ∈ indices, (j : ℝ) + 2 ≤ b)
    (hη : 0 < η) (hE : ∀ t ∈ E, η ≤ ‖F t‖)
    (hF : ∀ t, HasDerivAt F (F' t) t) (hF' : Continuous F')
    (hK : 0 < K) (henergy : (∫ t in a..b, ‖F t‖ ^ 2) ≤ Q)
    (hderiv : (∫ t in a..b, ‖F' t‖ ^ 2) ≤ K ^ 2 * Q) :
    ((occupiedUnitIntervals indices E).card : ℝ) * η ^ 2 ≤ 3 * (1 + 2 * K) * Q := by
  let occupied := occupiedUnitIntervals indices E
  let point := occupiedUnitIntervalPoint E
  have hpoint : ∀ j ∈ occupied, point j ∈ Set.Icc (j : ℝ) ((j : ℝ) + 1) ∧ point j ∈ E :=
    fun j hj => occupiedUnitIntervalPoint_spec indices E j hj
  have hclass (r : Fin 3) :
      ((occupied.filter (fun j => unitIntervalResidue j = r)).card : ℝ) * η ^ 2 ≤
        (1 + 2 * K) * Q := by
    let cls := occupied.filter (fun j => unitIntervalResidue j = r)
    have hoc : ∀ j ∈ cls, j ∈ occupied := fun j hj => (Finset.mem_filter.mp hj).1
    have hidx : ∀ j ∈ cls, j ∈ indices := fun j hj =>
      ((mem_occupiedUnitIntervals indices E j).mp (hoc j hj)).1
    have hsamp := separated_samples_norm_sq_le_energy cls point
      (δ := 1) (by norm_num) hab
      (fun j hj => (hleft j (hidx j hj)).trans (hpoint j (hoc j hj)).1.1)
      (fun j hj => by linarith [(hpoint j (hoc j hj)).1.2, hright j (hidx j hj)])
      (fun i hi j hj hij => unit_interval_residue_separated
        (hpoint i (hoc i hi)).1 (hpoint j (hoc j hj)).1
        ((Finset.mem_filter.mp hi).2.trans (Finset.mem_filter.mp hj).2.symm) hij)
      F F' hF hF' hK henergy hderiv
    have hlow : (cls.card : ℝ) * η ^ 2 ≤ ∑ j ∈ cls, ‖F (point j)‖ ^ 2 := by
      calc
        (cls.card : ℝ) * η ^ 2 = ∑ _j ∈ cls, η ^ 2 := by simp
        _ ≤ _ := Finset.sum_le_sum (fun j hj =>
          pow_le_pow_left₀ hη.le (hE (point j) (hpoint j (hoc j hj)).2) 2)
    exact hlow.trans (by simpa only [inv_one] using hsamp)
  have hsum := Finset.sum_le_sum (fun r (_ : r ∈ (Finset.univ : Finset (Fin 3))) => hclass r)
  have hcard : (∑ r : Fin 3, ((occupied.filter (fun j => unitIntervalResidue j = r)).card : ℝ)) =
      (occupied.card : ℝ) := by
    exact_mod_cast unit_interval_residue_card_sum occupied
  rw [← Finset.sum_mul, hcard] at hsum
  simpa only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, Nat.cast_ofNat,
    mul_assoc] using hsum

noncomputable def exceptionalUnitIntervals {H : Type*} [Norm H]
    (F : ℝ → H) (η : ℝ) (lo hi : ℤ) : Finset ℤ :=
  occupiedUnitIntervals (Finset.Icc lo hi) {t | η ≤ ‖F t‖}

theorem mem_exceptionalUnitIntervals {H : Type*} [Norm H]
    (F : ℝ → H) (η : ℝ) (lo hi j : ℤ) :
    j ∈ exceptionalUnitIntervals F η lo hi ↔
      lo ≤ j ∧ j ≤ hi ∧ ∃ t ∈ Set.Icc (j : ℝ) ((j : ℝ) + 1), η ≤ ‖F t‖ := by
  simp only [exceptionalUnitIntervals, mem_occupiedUnitIntervals, Finset.mem_Icc, Set.mem_ofPred_eq]
  tauto

theorem exceptional_unit_intervals_card_energy_le {H : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (F F' : ℝ → H) (lo hi : ℤ) (hlohi : lo ≤ hi) {η K Q : ℝ}
    (hη : 0 < η) (hF : ∀ t, HasDerivAt F (F' t) t) (hF' : Continuous F')
    (hK : 0 < K) (henergy : (∫ t in (lo : ℝ)..(hi : ℝ) + 2, ‖F t‖ ^ 2) ≤ Q)
    (hderiv : (∫ t in (lo : ℝ)..(hi : ℝ) + 2, ‖F' t‖ ^ 2) ≤ K ^ 2 * Q) :
    ((exceptionalUnitIntervals F η lo hi).card : ℝ) * η ^ 2 ≤ 3 * (1 + 2 * K) * Q := by
  have hlohiR : (lo : ℝ) ≤ (hi : ℝ) := by exact_mod_cast hlohi
  exact occupied_unit_intervals_card_energy_le (Finset.Icc lo hi) {t | η ≤ ‖F t‖} F F'
    (by linarith) (fun j hj => by exact_mod_cast (Finset.mem_Icc.mp hj).1)
    (fun j hj => by
      have hjR : (j : ℝ) ≤ (hi : ℝ) := by exact_mod_cast (Finset.mem_Icc.mp hj).2
      linarith)
    hη (fun _ ht => ht) hF hF' hK henergy hderiv

end Bounty
end

section

/- The growing degree and the exact factorial budget used for prime moments. -/

namespace Bounty

noncomputable def primeMomentDegree (Y P : ℝ) : ℕ :=
  ⌊Real.log Y / Real.log (2 * P)⌋₊

theorem prime_moment_degree_log_bounds {Y P : ℝ} (hY : 1 ≤ Y) (hP : 1 < 2 * P) :
    (primeMomentDegree Y P : ℝ) * Real.log (2 * P) ≤ Real.log Y ∧
      Real.log Y < (primeMomentDegree Y P + 1 : ℝ) * Real.log (2 * P) := by
  have hd : 0 < Real.log (2 * P) := Real.log_pos hP
  have hn : 0 ≤ Real.log Y / Real.log (2 * P) :=
    div_nonneg (Real.log_nonneg hY) hd.le
  exact ⟨(le_div_iff₀ hd).mp (Nat.floor_le hn),
    (div_lt_iff₀ hd).mp (Nat.lt_floor_add_one _)⟩

theorem prime_moment_degree_power_bounds {Y P : ℝ} (hY : 1 ≤ Y) (hP : 1 < 2 * P) :
    (2 * P) ^ primeMomentDegree Y P ≤ Y ∧
      Y < (2 * P) ^ (primeMomentDegree Y P + 1) := by
  have hy : 0 < Y := zero_lt_one.trans_le hY
  have hp : 0 < 2 * P := zero_lt_one.trans hP
  obtain ⟨hlo, hhi⟩ := prime_moment_degree_log_bounds hY hP
  constructor
  · apply (Real.log_le_log_iff (pow_pos hp _) hy).mp
    simpa only [Real.log_pow] using hlo
  · apply (Real.log_lt_log_iff hy (pow_pos hp _)).mp
    simpa only [Real.log_pow, Nat.cast_add, Nat.cast_one] using hhi

theorem prime_moment_degree_le {Y P L a c : ℝ}
    (hL : 0 < L) (hY : 1 ≤ Y)
    (hlogY : Real.log Y ≤ c * L) (hP : Real.exp (L ^ a) / 2 ≤ P) :
    (primeMomentDegree Y P : ℝ) ≤ c * L ^ (1 - a) := by
  have hLa : 0 < L ^ a := Real.rpow_pos_of_pos hL a
  have hP2 : Real.exp (L ^ a) ≤ 2 * P := by linarith
  have hP1 : 1 < 2 * P := (Real.one_lt_exp_iff.mpr hLa).trans_le hP2
  have hlogP : L ^ a ≤ Real.log (2 * P) :=
    (Real.le_log_iff_exp_le (zero_lt_one.trans hP1)).mpr hP2
  have hj := (prime_moment_degree_log_bounds hY hP1).1
  have hprod : (primeMomentDegree Y P : ℝ) * L ^ a ≤ c * L :=
    (mul_le_mul_of_nonneg_left hlogP (Nat.cast_nonneg _)).trans (hj.trans hlogY)
  calc
    (primeMomentDegree Y P : ℝ) ≤ c * L / L ^ a := (le_div_iff₀ hLa).mpr hprod
    _ = c * L ^ (1 - a) := by rw [Real.rpow_sub hL, Real.rpow_one]; ring

theorem prime_moment_factorial_le (j : ℕ) :
    (j.factorial : ℝ) ≤ (max 1 (j : ℝ)) ^ j := by
  have h : (j.factorial : ℝ) ≤ (j : ℝ) ^ j := by exact_mod_cast Nat.factorial_le_pow j
  exact h.trans (pow_le_pow_left₀ (Nat.cast_nonneg _) (le_max_right _ _) _)

theorem prime_moment_scalar_budget {Y P B T : ℝ}
    (hY : 1 ≤ Y) (hP : 1 < 2 * P) (hB : 0 ≤ B) (hT : 0 ≤ T) :
    B * Y * (primeMomentDegree Y P).factorial * (T / P) ^ primeMomentDegree Y P ≤
      B * (2 * P) * (2 * T * max 1 (primeMomentDegree Y P : ℝ)) ^
        primeMomentDegree Y P := by
  let j := primeMomentDegree Y P
  have hp : 0 < P := by linarith
  have hy := (prime_moment_degree_power_bounds hY hP).2.le
  have hj := prime_moment_factorial_le j
  calc
    B * Y * (j.factorial : ℝ) * (T / P) ^ j ≤
        B * (2 * P) ^ (j + 1) * (max 1 (j : ℝ)) ^ j * (T / P) ^ j := by
      gcongr
    _ = B * (2 * P) * (2 * T * max 1 (j : ℝ)) ^ j := by
      have he : (2 * P) * max 1 (j : ℝ) * (T / P) = 2 * T * max 1 (j : ℝ) := by
        field_simp
      calc
        _ = B * (2 * P) * ((2 * P) * max 1 (j : ℝ) * (T / P)) ^ j := by
          simp only [mul_pow, pow_succ]
          ring
        _ = _ := by rw [he]

end Bounty
end

section

/- An explicit scalar budget for the unit-interval sampling and mean-square
factors. The estimate is uniform in the moment order and prime set. -/

namespace Bounty

theorem prime_moment_sampling_overhead_le (Y R : ℝ) (hY : 1 ≤ Y)
    (hR : 0 ≤ R) (hRY : R ≤ Y) :
    3 * (1 + 2 * (1 + Real.log (⌈Y⌉₊ : ℝ))) *
      ((2 * (⌈R⌉₊ : ℝ) + 3) +
        4 * (⌈Y⌉₊ : ℝ) * (1 + Real.log (⌈Y⌉₊ : ℝ))) ≤
      512 * Y * (1 + Real.log Y) ^ 2 := by
  have hYpos : 0 < Y := by linarith
  have hNY : Y ≤ (⌈Y⌉₊ : ℝ) := Nat.le_ceil Y
  have hNpos : (0 : ℝ) < (⌈Y⌉₊ : ℝ) := hYpos.trans_le hNY
  have hN : (⌈Y⌉₊ : ℝ) ≤ 2 * Y := by
    have := Nat.ceil_lt_add_one hYpos.le
    linarith
  have hRc : (⌈R⌉₊ : ℝ) ≤ Y + 1 := by
    have := Nat.ceil_lt_add_one hR
    linarith
  have hlogY : 0 ≤ Real.log Y := Real.log_nonneg hY
  have hlogN : 0 ≤ Real.log (⌈Y⌉₊ : ℝ) := Real.log_nonneg (hY.trans hNY)
  have hlog2 : Real.log (2 : ℝ) ≤ 1 := by
    have hh := Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 2)
    linarith
  have hlog : Real.log (⌈Y⌉₊ : ℝ) ≤ 1 + Real.log Y := by
    have hh := Real.log_le_log hNpos hN
    rw [Real.log_mul (by norm_num : (2 : ℝ) ≠ 0) (ne_of_gt hYpos)] at hh
    linarith
  let L := 1 + Real.log Y
  let Z := 1 + Real.log (⌈Y⌉₊ : ℝ)
  have hL : 1 ≤ L := by dsimp only [L]; linarith
  have hZ0 : 0 ≤ Z := by dsimp only [Z]; linarith
  have hZ : Z ≤ 2 * L := by dsimp only [Z, L]; linarith
  have hsamp : 3 * (1 + 2 * Z) ≤ 18 * L := by linarith
  have hYL : Y ≤ Y * L := by nlinarith
  have hNZ : (⌈Y⌉₊ : ℝ) * Z ≤ (2 * Y) * (2 * L) :=
    mul_le_mul hN hZ hZ0 (by positivity)
  have hmoment : (2 * (⌈R⌉₊ : ℝ) + 3) + 4 * (⌈Y⌉₊ : ℝ) * Z ≤
      23 * Y * L := by nlinarith
  change 3 * (1 + 2 * Z) * ((2 * (⌈R⌉₊ : ℝ) + 3) + 4 * (⌈Y⌉₊ : ℝ) * Z) ≤
    512 * Y * L ^ 2
  calc
    _ ≤ (18 * L) * (23 * Y * L) :=
      mul_le_mul hsamp hmoment (by positivity) (by positivity)
    _ = 414 * Y * L ^ 2 := by ring
    _ ≤ 512 * Y * L ^ 2 := by nlinarith [sq_nonneg L]

end Bounty
end

section

/- The exceptional prime-moment exponential is a subpower of any scale
whose logarithm is bounded below by a fixed positive multiple of L. -/

open Filter
open scoped Topology

namespace Bounty

theorem eventually_prime_moment_exp_le_rpow {a beta K d ε : ℝ}
    (ha : 0 < a) (hbeta : beta < 1) (hK : 0 ≤ K) (hd : 0 < d) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, 0 < Y → d * L ≤ Real.log Y →
      Real.exp (K * (L ^ beta + L ^ (1 - a) * Real.log L)) ≤ Y ^ ε := by
  have hbudget : 0 < ε * d / 2 := by positivity
  filter_upwards [
    eventually_mul_rpow_log_add_le_rpow (a := beta) (b := 1)
      zero_lt_one hbeta hbudget K 0,
    eventually_mul_rpow_log_add_le_rpow (a := 1 - a) (b := 1)
      zero_lt_one (by linarith : 1 - a < 1) hbudget K 0,
    Real.tendsto_log_atTop.eventually_ge_atTop 1,
    eventually_gt_atTop (0 : ℝ)] with L hfirst hsecond hlogL hL
  intro Y hY hscale
  simp only [add_zero, Real.rpow_one] at hfirst hsecond
  have hfirst' : K * L ^ beta ≤ K * L ^ beta * Real.log L :=
    le_mul_of_one_le_right (mul_nonneg hK (Real.rpow_nonneg hL.le beta)) hlogL
  have hexponent : K * (L ^ beta + L ^ (1 - a) * Real.log L) ≤ ε * (d * L) := by
    nlinarith only [hfirst'.trans hfirst, hsecond]
  calc
    _ ≤ Real.exp (ε * Real.log Y) := Real.exp_le_exp.mpr
      (hexponent.trans (mul_le_mul_of_nonneg_left hscale hε.le))
    _ = Y ^ ε := by rw [Real.rpow_def_of_pos hY]; congr 1; ring

theorem eventually_prime_moment_exp_le_exp {a beta K ε : ℝ}
    (ha : 0 < a) (hbeta : beta < 1) (hK : 0 ≤ K) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop,
      Real.exp (K * (L ^ beta + L ^ (1 - a) * Real.log L)) ≤ Real.exp (ε * L) := by
  filter_upwards [eventually_prime_moment_exp_le_rpow ha hbeta hK zero_lt_one hε] with L hL
  have hh := hL (Real.exp L) (Real.exp_pos L) (by simp only [one_mul, Real.log_exp, le_refl])
  simpa only [Real.rpow_def_of_pos (Real.exp_pos L), Real.log_exp, mul_comm] using hh

end Bounty
end

section

/- Finite separated sampling estimates for exponential polynomials. -/

open scoped BigOperators

namespace Bounty

theorem separated_floor_injective {ι : Type*} (s : Finset ι) (d : ι → ℝ)
    (h0 : ∀ i ∈ s, 0 ≤ d i)
    (hsep : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → 1 ≤ |d i - d j|) :
    Set.InjOn (fun i => Nat.floor (d i)) s := by
  intro i hi j hj he
  dsimp only at he
  by_contra hij
  have h := hsep i hi j hj hij
  have hi0 := Nat.floor_le (h0 i hi)
  have hj0 := Nat.floor_le (h0 j hj)
  have hi1 := Nat.lt_floor_add_one (d i)
  have hj1 := Nat.lt_floor_add_one (d j)
  rw [he] at hi0 hi1
  have habs : |d i - d j| < 1 := abs_lt.mpr ⟨by linarith, by linarith⟩
  linarith

theorem separated_positive_reciprocal_sum {ι : Type*} (s : Finset ι) (d : ι → ℝ)
    (N : ℕ) (h1 : ∀ i ∈ s, 1 ≤ d i) (hN : ∀ i ∈ s, d i ≤ N)
    (hsep : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → 1 ≤ |d i - d j|) :
    (∑ i ∈ s, (1 + d i)⁻¹) ≤ 1 + Real.log N := by
  classical
  have hinj := separated_floor_injective s d (fun i hi => le_trans (by norm_num) (h1 i hi)) hsep
  have hsub : s.image (fun i => Nat.floor (d i)) ⊆ Finset.Icc 1 N := by
    intro k hk
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hk
    exact Finset.mem_Icc.mpr ⟨(Nat.one_le_floor_iff (d i)).mpr (h1 i hi), Nat.floor_le_of_le (hN i hi)⟩
  calc
    _ ≤ ∑ i ∈ s, ((Nat.floor (d i) : ℕ) : ℝ)⁻¹ := by
      apply Finset.sum_le_sum
      intro i hi
      have hfloor : (1 : ℝ) ≤ Nat.floor (d i) := by exact_mod_cast (Nat.one_le_floor_iff (d i)).mpr (h1 i hi)
      exact inv_anti₀ (lt_of_lt_of_le (by norm_num) hfloor)
        (le_trans (Nat.floor_le (le_trans (by norm_num) (h1 i hi))) (by linarith))
    _ = ∑ k ∈ s.image (fun i => Nat.floor (d i)), (k : ℝ)⁻¹ := by rw [Finset.sum_image hinj]
    _ ≤ ∑ k ∈ Finset.Icc 1 N, (k : ℝ)⁻¹ :=
      Finset.sum_le_sum_of_subset_of_nonneg hsub (by intros; positivity)
    _ = (harmonic N : ℝ) := by
      simp only [harmonic_eq_sum_Icc, Rat.cast_sum, Rat.cast_inv, Rat.cast_natCast]
    _ ≤ _ := harmonic_le_one_add_log N

end Bounty
end

section

/- Finite separated sampling estimates for exponential polynomials. -/

open scoped BigOperators ComplexConjugate InnerProductSpace

namespace Bounty

theorem finite_row_gram_energy_le {I X : Type*} [Fintype I] [Fintype X]
    (K : I → X → ℂ) (c : X → ℂ) {B : ℝ} (hB : 0 ≤ B)
    (hrow : ∀ i, (∑ j, ‖∑ n, K i n * conj (K j n)‖) ≤ B) :
    (∑ i, ‖∑ n, K i n * c n‖ ^ 2) ≤ B * ∑ n, ‖c n‖ ^ 2 := by
  let u : I → EuclideanSpace ℂ X := fun i =>
    finiteMeasureVector (fun _ => 1) (fun n => conj (K i n))
  have h := finite_gram_row_analysis_sq u hB (fun i => by
    simpa only [u, finite_measure_vector_inner _ (fun _ => zero_le_one),
      Complex.ofReal_one, one_mul, starRingEnd_self_apply] using hrow i)
    (finiteMeasureVector (fun _ => 1) c)
  simpa only [u, finite_measure_vector_inner _ (fun _ => zero_le_one),
    finite_measure_vector_norm_sq _ (fun _ => zero_le_one), Complex.ofReal_one,
    one_mul, starRingEnd_self_apply] using h

end Bounty
end

section

/- Continuous squared norms attain their supremum on each closed unit interval. -/

open Set

namespace Bounty

noncomputable def unitIntervalEnergySup (f : ℝ → ℂ) (j : ℤ) : ℝ :=
  sSup ((fun t => ‖f t‖ ^ 2) '' Icc (j : ℝ) ((j : ℝ) + 1))

theorem exists_unit_interval_energy_max (f : ℝ → ℂ) (hf : Continuous f) (j : ℤ) :
    ∃ t ∈ Icc (j : ℝ) ((j : ℝ) + 1), unitIntervalEnergySup f j = ‖f t‖ ^ 2 := by
  obtain ⟨t, ht, hmax⟩ := isCompact_Icc.exists_isMaxOn
    (nonempty_Icc.mpr (by linarith : (j : ℝ) ≤ (j : ℝ) + 1)) (hf.norm.pow 2).continuousOn
  refine ⟨t, ht, ?_⟩
  apply IsGreatest.csSup_eq
  refine ⟨mem_image_of_mem _ ht, ?_⟩
  rintro y ⟨v, hv, rfl⟩
  exact hmax hv

theorem unit_interval_energy_sup_nonneg (f : ℝ → ℂ) (hf : Continuous f) (j : ℤ) :
    0 ≤ unitIntervalEnergySup f j := by
  obtain ⟨t, _, ht⟩ := exists_unit_interval_energy_max f hf j
  rw [ht]
  positivity

end Bounty
end

section

open Set

namespace Bounty

def mixedForwardDifference : List ℝ → (ℝ → ℝ) → ℝ → ℝ
  | [], f, x => f x
  | h :: hs, f, x => mixedForwardDifference hs f (x+h) - mixedForwardDifference hs f x

theorem mixed_forward_difference_const_mul
    (hs : List ℝ) (f : ℝ → ℝ) (a x : ℝ) :
    mixedForwardDifference hs (fun y => a * f y) x = a * mixedForwardDifference hs f x := by
  induction hs generalizing x with
  | nil => rfl
  | cons h hs ih => simp only [mixedForwardDifference, ih]; ring

theorem mixed_forward_difference_hasDerivAt
    (hs : List ℝ) (f g : ℝ → ℝ) (c : ℝ)
    (hhs : ∀ h ∈ hs, 0 ≤ h)
    (hfg : ∀ x, c < x → HasDerivAt f (g x) x)
    (x : ℝ) (hx : c < x) :
    HasDerivAt (mixedForwardDifference hs f) (mixedForwardDifference hs g x) x := by
  induction hs generalizing x with
  | nil => exact hfg x hx
  | cons h hs ih =>
    have hh : 0 ≤ h := hhs h (by simp)
    have htail : ∀ a ∈ hs, 0 ≤ a := fun a ha => hhs a (by simp [ha])
    have hp := (ih htail (x+h) (by linarith)).comp x ((hasDerivAt_id x).add_const h)
    simpa only [mixedForwardDifference, one_mul, mul_one, Function.comp_def, id_eq, Pi.sub_apply, Pi.sub_def] using hp.sub (ih htail x hx)

theorem mixed_forward_difference_mean_value
    (hs : List ℝ) (F : ℕ → ℝ → ℝ) (c : ℝ)
    (hhs : ∀ h ∈ hs, 0 ≤ h)
    (hF : ∀ k x, c < x → HasDerivAt (F k) (F (k+1) x) x)
    (k : ℕ) (x : ℝ) (hx : c < x) :
    ∃ y ∈ Icc x (x+hs.sum),
      mixedForwardDifference hs (F k) x = hs.prod * F (k+hs.length) y := by
  induction hs generalizing k x with
  | nil => exact ⟨x, by simp, by simp [mixedForwardDifference]⟩
  | cons h hs ih =>
    have hh : 0 ≤ h := hhs h (by simp)
    have htail : ∀ a ∈ hs, 0 ≤ a := fun a ha => hhs a (by simp [ha])
    have hsum : 0 ≤ hs.sum := List.sum_nonneg htail
    by_cases hzero : h = 0
    · subst h
      exact ⟨x, by simpa using hsum, by simp [mixedForwardDifference]⟩
    have hhpos : 0 < h := lt_of_le_of_ne hh (Ne.symm hzero)
    have hder : ∀ y, c < y →
        HasDerivAt (mixedForwardDifference hs (F k))
          (mixedForwardDifference hs (F (k+1)) y) y :=
      fun y hy => mixed_forward_difference_hasDerivAt hs (F k) (F (k+1)) c
        htail (hF k) y hy
    obtain ⟨y, hy, hyeq⟩ := exists_hasDerivAt_eq_slope
      (mixedForwardDifference hs (F k)) (mixedForwardDifference hs (F (k+1)))
      (show x < x+h by linarith)
      (fun y hy => (hder y (by linarith [hy.1])).continuousAt.continuousWithinAt)
      (fun y hy => hder y (by linarith [hy.1]))
    obtain ⟨z, hz, hzeq⟩ := ih htail (k+1) y (by linarith [hy.1])
    refine ⟨z, ?_, ?_⟩
    · simp only [List.sum_cons, mem_Icc]
      constructor <;> linarith [hy.1, hy.2, hz.1, hz.2]
    · have heq : mixedForwardDifference (h::hs) (F k) x =
          h * mixedForwardDifference hs (F (k+1)) y := by
        dsimp only [mixedForwardDifference]
        have hd : x+h-x = h := by ring
        rw [hd] at hyeq
        exact (eq_div_iff hzero).mp hyeq |>.symm.trans (mul_comm _ _)
      rw [heq, hzeq]
      simp only [List.prod_cons, List.length_cons]
      have hk : k+1+hs.length = k+(hs.length+1) := by omega
      rw [hk]
      ring

end Bounty
end

section

namespace Bounty

noncomputable def vanDerCorputScalarBound (H B : ℝ) : ℕ → ℝ
  | 0 => B
  | m+1 => Real.sqrt (2/H+4*vanDerCorputScalarBound H B m)

theorem van_der_corput_scalar_bound_nonneg (H B : ℝ) (hB : 0 ≤ B) (m : ℕ) :
    0 ≤ vanDerCorputScalarBound H B m := by
  cases m with
  | zero => exact hB
  | succ m => exact Real.sqrt_nonneg _

end Bounty
end

section

/- Iterated square roots record the exponent loss in repeated differencing. -/

namespace Bounty

noncomputable def repeatedSquareRoot : ℕ → ℝ → ℝ
  | 0, x => x
  | n+1, x => Real.sqrt (repeatedSquareRoot n x)

theorem repeated_square_root_nonneg (n : ℕ) {x : ℝ} (hx : 0 ≤ x) :
    0 ≤ repeatedSquareRoot n x := by
  cases n with
  | zero => exact hx
  | succ n => exact Real.sqrt_nonneg _

theorem repeated_square_root_le_one (n : ℕ) {x : ℝ} (hx : x ≤ 1) :
    repeatedSquareRoot n x ≤ 1 := by
  induction n with
  | zero => exact hx
  | succ n ih => exact Real.sqrt_le_one.mpr ih

theorem le_repeated_square_root (n : ℕ) {x : ℝ} (hx : x ≤ 1) :
    x ≤ repeatedSquareRoot n x := by
  induction n with
  | zero => exact le_rfl
  | succ n ih => exact ih.trans (Real.le_sqrt_self_iff.mpr (repeated_square_root_le_one n hx))

theorem repeated_square_root_eq_rpow (n : ℕ) {x : ℝ} (hx : 0 ≤ x) :
    repeatedSquareRoot n x = x^((2:ℝ)^n)⁻¹ := by
  induction n with
  | zero => simp [repeatedSquareRoot]
  | succ n ih =>
    change Real.sqrt (repeatedSquareRoot n x) = _
    rw [ih,Real.sqrt_eq_rpow,← Real.rpow_mul hx]
    congr 1
    rw [pow_succ]
    field_simp

end Bounty
end

section

/- A finite family of overlapping derivative ranges covers all relevant frequencies. -/

namespace Bounty

theorem exists_derivative_order_interval (K : ℕ) (v ε : ℝ)
    (hε : 0 < ε) (hεhalf : ε ≤ 1/2) (hv : 1 ≤ v) (hvK : v ≤ K-ε) :
    ∃ k : ℕ, 2 ≤ k ∧ k ≤ K ∧ (k : ℝ)-2+ε ≤ v ∧ v ≤ (k : ℝ)-ε := by
  refine ⟨Nat.ceil (v+ε), ?_, ?_, ?_, ?_⟩
  · have h : 1+1 ≤ Nat.ceil (v+ε) := Nat.add_one_le_ceil_iff.mpr (by norm_num; linarith)
    exact h
  · apply Nat.ceil_le.mpr
    linarith
  · have h := Nat.ceil_lt_add_one (show 0 ≤ v+ε by linarith)
    linarith
  · have h := Nat.le_ceil (v+ε)
    linarith

theorem exists_derivative_order_power_band (K : ℕ) (N u ε : ℝ)
    (hN : 1 < N) (hε : 0 < ε) (hεhalf : ε ≤ 1/2)
    (hu : N ≤ u) (huK : u ≤ N^((K : ℝ)-ε)) :
    ∃ k : ℕ, 2 ≤ k ∧ k ≤ K ∧ N^((k : ℝ)-2+ε) ≤ u ∧ u ≤ N^((k : ℝ)-ε) := by
  have hup : 0 < u := lt_of_lt_of_le (by linarith) hu
  have hv : 1 ≤ Real.logb N u := (Real.le_logb_iff_rpow_le hN hup).mpr (by simpa using hu)
  have hvK : Real.logb N u ≤ (K : ℝ)-ε := (Real.logb_le_iff_le_rpow hN hup).mpr huK
  obtain ⟨k,hk2,hkK,hlo,hhi⟩ := exists_derivative_order_interval K (Real.logb N u) ε hε hεhalf hv hvK
  exact ⟨k,hk2,hkK,(Real.le_logb_iff_rpow_le hN hup).mp hlo,
    (Real.logb_le_iff_le_rpow hN hup).mp hhi⟩

end Bounty
end

section

/- Uniform comparison of the decay exponents for finitely many derivative orders. -/

namespace Bounty

theorem derivative_decay_exponent_eq (ε : ℝ) (k : ℕ) (hk : 2 ≤ k) :
    (ε/(2*(k : ℝ)))/(2:ℝ)^(k-2) = ε/((k : ℝ)*(2:ℝ)^(k-1)) := by
  have he : k-1 = k-2+1 := by omega
  rw [he,pow_succ,div_div]
  congr 1
  ring

theorem derivative_decay_exponent_antitone {ε : ℝ} (hε : 0 ≤ ε) {k K : ℕ}
    (hk : 2 ≤ k) (hkK : k ≤ K) :
    ε/((K : ℝ)*(2:ℝ)^(K-1)) ≤ ε/((k : ℝ)*(2:ℝ)^(k-1)) := by
  have hkR : (0 : ℝ) < k := by exact_mod_cast (show 0 < k by omega)
  apply div_le_div_of_nonneg_left hε (mul_pos hkR (by positivity))
  apply mul_le_mul
  · exact_mod_cast hkK
  · exact pow_le_pow_right₀ (by norm_num) (Nat.sub_le_sub_right hkK 1)
  · positivity
  · positivity

end Bounty
end

section

/- Exact removal of a prescribed marked subset, retaining its overlap damping. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def finiteMarkedVertex {T : Type*} [Fintype T]
    (marked : Finset T) (hit : T → Prop) (q : ℝ) : ℝ :=
  ∏ p, if p ∈ marked then (if hit p then 1 else 0) else if hit p then q else 1

theorem finite_marked_vertex_factor {T : Type*} [Fintype T]
    (marked : Finset T) (hit : T → Prop) (q : ℝ) :
    finiteMarkedVertex marked hit q =
      (∏ p ∈ marked, if hit p then (1 : ℝ) else 0) *
        q ^ ((univ \ marked).filter hit).card := by
  classical
  rw [← unmarked_damping_product]
  have hi : (∏ p ∈ marked, if hit p then (1 : ℝ) else 0) =
      ∏ p, if p ∈ marked then (if hit p then (1 : ℝ) else 0) else 1 := by
    simpa only [filter_mem_eq_inter, univ_inter] using
      (prod_filter (s := (univ : Finset T)) (fun p => p ∈ marked)
        (fun p => if hit p then (1 : ℝ) else 0))
  rw [hi, ← prod_mul_distrib]
  apply prod_congr rfl
  intro p _
  by_cases hm : p ∈ marked <;> by_cases hh : hit p <;>
    simp [hm, hh]

theorem finite_shared_vertex_removal {T : Type*} [Fintype T]
    (marked shared : Finset T) (hit fullHit : T → Prop) (q : ℝ)
    (hsub : shared ⊆ marked) (hfull : ∀ p, fullHit p ↔ p ∈ shared ∨ hit p) :
    finiteMarkedVertex marked fullHit q *
        (∏ p ∈ shared, if hit p then q else 1) =
      finiteMarkedVertex (marked \ shared) hit q := by
  classical
  have hs : (∏ p ∈ shared, if hit p then q else 1) =
      ∏ p, if p ∈ shared then (if hit p then q else 1) else 1 := by
    simpa only [filter_mem_eq_inter, univ_inter] using
      (prod_filter (s := (univ : Finset T)) (fun p => p ∈ shared)
        (fun p => if hit p then q else 1))
  rw [hs, finiteMarkedVertex, finiteMarkedVertex, ← prod_mul_distrib]
  apply prod_congr rfl
  intro p _
  by_cases hs : p ∈ shared
  · have hm := hsub hs
    have hf := (hfull p).mpr (Or.inl hs)
    by_cases hh : hit p <;> simp [hs, hm, hf, hh]
  · have hf : fullHit p ↔ hit p := by simpa only [hs, false_or] using hfull p
    by_cases hm : p ∈ marked <;> by_cases hh : hit p <;> simp [hs, hm, hf, hh]

theorem physical_vertex_weight_as_finite {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (L : PhysicalMarkLists P J ell) (q : ℝ) (n : ℤ) :
    physicalVertexWeight L q n =
      finiteMarkedVertex (physicalMarkedPrimes L)
        (fun p : PhysicalPrime P => (p.2.val : ℤ) ∣ n) q := by
  rw [physical_vertex_weight_factor, finite_marked_vertex_factor]
  congr 1
  · apply prod_congr rfl
    intro p _
    split_ifs <;> rfl
  · congr 2
    ext p
    simp only [mem_filter, mem_sdiff]

end Bounty
end

section

/- Bounds for forbidden values and repeated coordinates in the shared draw itself. -/

open Finset
open scoped Classical

namespace Bounty

theorem clean_auxiliary_forbidden_mass_le {A P : Type*}
    [Fintype A] [DecidableEq A] [Fintype P]
    (μ : P → ℝ) (hμ0 : ∀ p, 0 ≤ μ p) (hμ : ∑ p, μ p = 1)
    (T : Finset P) (a₀ : ℝ) (hatom : ∀ p, μ p ≤ a₀) :
    (∑ aux : A → P, cleanAuxiliaryWeight μ aux *
      (if ∃ a, aux a ∈ T then 1 else 0)) ≤
        (Fintype.card A : ℝ) * T.card * a₀ := by
  have he (aux : A → P) : (∃ a, aux a ∈ T) ↔ ∃ a, ∃ p : T, aux a = p.val := by
    constructor
    · rintro ⟨a, ha⟩
      exact ⟨a, ⟨aux a, ha⟩, rfl⟩
    · rintro ⟨a, p, hp⟩
      exact ⟨a, hp ▸ p.property⟩
  simp_rw [he]
  simpa only [Fintype.card_coe] using
    clean_auxiliary_hits_mass_le (A := A) μ hμ0 hμ (fun p : T => p.val) a₀ hatom

theorem clean_auxiliary_two_coordinate_mass {A P : Type*}
    [Fintype A] [DecidableEq A] [Fintype P]
    (μ : P → ℝ) (hμ : ∑ p, μ p = 1) (a b : A) (hab : a ≠ b) (f g : P → ℝ) :
    (∑ aux : A → P, cleanAuxiliaryWeight μ aux * f (aux a) * g (aux b)) =
      (∑ p, μ p * f p) * ∑ p, μ p * g p := by
  let factors (i : A) (p : P) := μ p * (if i = a then f p else if i = b then g p else 1)
  have hp (aux : A → P) :
      cleanAuxiliaryWeight μ aux * f (aux a) * g (aux b) = ∏ i, factors i (aux i) := by
    simp only [factors, prod_mul_distrib, cleanAuxiliaryWeight]
    rw [mul_assoc]
    congr 1
    rw [prod_eq_mul_of_mem a b (mem_univ _) (mem_univ _) hab]
    · simp only [ite_true, if_neg (Ne.symm hab)]
    · rintro i _ ⟨hia, hib⟩
      simp [hia, hib]
  simp_rw [hp]
  rw [← Fintype.prod_sum factors, prod_eq_mul_of_mem a b (mem_univ _) (mem_univ _) hab]
  · simp [factors, Ne.symm hab]
  · rintro i _ ⟨hia, hib⟩
    simpa only [factors, if_neg hia, if_neg hib, mul_one] using hμ

theorem clean_auxiliary_pair_collision_mass_le {A P : Type*}
    [Fintype A] [DecidableEq A] [Fintype P]
    (μ : P → ℝ) (hμ0 : ∀ p, 0 ≤ μ p) (hμ : ∑ p, μ p = 1)
    (a b : A) (hab : a ≠ b) (a₀ : ℝ) (hatom : ∀ p, μ p ≤ a₀) :
    (∑ aux : A → P, cleanAuxiliaryWeight μ aux *
      (if aux a = aux b then 1 else 0)) ≤ a₀ := by
  have he (aux : A → P) : (if aux a = aux b then (1 : ℝ) else 0) =
      ∑ p, (if aux a = p then (1 : ℝ) else 0) * (if aux b = p then 1 else 0) := by
    simp [eq_comm]
  simp_rw [he, mul_sum, ← mul_assoc]
  rw [sum_comm]
  calc
    _ = ∑ p, μ p * μ p := by
      apply sum_congr rfl
      intro p _
      rw [clean_auxiliary_two_coordinate_mass μ hμ a b hab
        (fun z => if z = p then 1 else 0) (fun z => if z = p then 1 else 0)]
      simp
    _ ≤ ∑ p, μ p * a₀ :=
      sum_le_sum (fun p _ => mul_le_mul_of_nonneg_left (hatom p) (hμ0 p))
    _ = a₀ := by rw [← sum_mul, hμ, one_mul]

theorem clean_auxiliary_repeated_mass_le {A P : Type*}
    [Fintype A] [DecidableEq A] [Fintype P]
    (μ : P → ℝ) (hμ0 : ∀ p, 0 ≤ μ p) (hμ : ∑ p, μ p = 1)
    (a₀ : ℝ) (ha₀ : 0 ≤ a₀) (hatom : ∀ p, μ p ≤ a₀) :
    (∑ aux : A → P, cleanAuxiliaryWeight μ aux *
      (if ¬Function.Injective aux then 1 else 0)) ≤
        (Fintype.card A : ℝ)^2 * a₀ := by
  have he (aux : A → P) : ¬Function.Injective aux ↔
      ∃ z : A × A, z.1 ≠ z.2 ∧ aux z.1 = aux z.2 := by
    constructor
    · intro h
      by_contra hn
      apply h
      intro a b hab
      by_contra hne
      exact hn ⟨⟨a, b⟩, hne, hab⟩
    · rintro ⟨⟨a, b⟩, hne, he⟩ hi
      exact hne (hi he)
  have hu := clean_weighted_exists_le_sum (Ω := A → P) (J := A × A)
    (fun aux => cleanAuxiliaryWeight μ aux)
    (fun aux => prod_nonneg (fun i _ => hμ0 (aux i)))
    (fun z aux => z.1 ≠ z.2 ∧ aux z.1 = aux z.2)
  calc
    _ ≤ ∑ z : A × A, ∑ aux : A → P, cleanAuxiliaryWeight μ aux *
        (if z.1 ≠ z.2 ∧ aux z.1 = aux z.2 then 1 else 0) := by
      convert hu using 1
      · apply sum_congr rfl
        intro aux _
        congr 1
        by_cases hi : ¬Function.Injective aux
        · rw [if_pos hi, if_pos ((he aux).mp hi)]
        · rw [if_neg hi, if_neg (fun h => hi ((he aux).mpr h))]
      · apply sum_congr rfl
        intro z _
        apply sum_congr rfl
        intro aux _
        congr 1
        split_ifs <;> rfl
    _ ≤ ∑ _z : A × A, a₀ := by
      apply sum_le_sum
      intro z _
      by_cases hz : z.1 = z.2
      · simpa only [hz, ne_eq, not_true_eq_false, false_and, if_false, mul_zero, sum_const_zero] using ha₀
      · have heq : (∑ aux : A → P, cleanAuxiliaryWeight μ aux *
            (if z.1 ≠ z.2 ∧ aux z.1 = aux z.2 then 1 else 0)) =
          ∑ aux : A → P, cleanAuxiliaryWeight μ aux *
            (if aux z.1 = aux z.2 then 1 else 0) := by
          apply sum_congr rfl
          intro aux _
          by_cases he : aux z.1 = aux z.2 <;> simp [hz, he]
        rw [heq]
        exact clean_auxiliary_pair_collision_mass_le μ hμ0 hμ z.1 z.2 hz a₀ hatom
    _ = _ := by simp [Fintype.card_prod, pow_two, mul_assoc]

theorem clean_auxiliary_forbidden_or_repeated_mass_le {A P : Type*}
    [Fintype A] [DecidableEq A] [Fintype P]
    (μ : P → ℝ) (hμ0 : ∀ p, 0 ≤ μ p) (hμ : ∑ p, μ p = 1)
    (T : Finset P) (a₀ : ℝ) (ha₀ : 0 ≤ a₀) (hatom : ∀ p, μ p ≤ a₀) :
    (∑ aux : A → P, cleanAuxiliaryWeight μ aux *
      (if (∃ a, aux a ∈ T) ∨ ¬Function.Injective aux then 1 else 0)) ≤
        (Fintype.card A : ℝ) * (T.card + Fintype.card A) * a₀ := by
  calc
    _ ≤ (∑ aux : A → P, cleanAuxiliaryWeight μ aux *
        (if ∃ a, aux a ∈ T then 1 else 0)) +
      ∑ aux : A → P, cleanAuxiliaryWeight μ aux *
        (if ¬Function.Injective aux then 1 else 0) := by
      rw [← sum_add_distrib]
      apply sum_le_sum
      intro aux _
      have hn : 0 ≤ cleanAuxiliaryWeight μ aux := prod_nonneg (fun i _ => hμ0 (aux i))
      by_cases hh : ∃ a, aux a ∈ T <;> by_cases hi : Function.Injective aux <;>
        simp [hh, hi, hn]
    _ ≤ (Fintype.card A : ℝ) * T.card * a₀ + (Fintype.card A : ℝ)^2 * a₀ :=
      add_le_add (clean_auxiliary_forbidden_mass_le μ hμ0 hμ T a₀ hatom)
        (clean_auxiliary_repeated_mass_le μ hμ0 hμ a₀ ha₀ hatom)
    _ = _ := by ring

end Bounty
end

section

/- Exact loss from restricting a normalized finite draw when its coefficient
is independent of that draw. -/

open Finset
open scoped Classical

namespace Bounty

theorem finite_constant_restriction_error {S : Type*} [Fintype S]
    (μ : S → ℝ) (hμ0 : ∀ s, 0 ≤ μ s) (hμ : ∑ s, μ s = 1)
    (good : S → Prop) [DecidablePred good] (c : ℂ) :
    ‖(∑ s, if good s then (μ s : ℂ) * c else 0) - c‖ =
      (∑ s, μ s * (if ¬good s then 1 else 0)) * ‖c‖ := by
  let a : ℝ := ∑ s, μ s * (if good s then 1 else 0)
  let b : ℝ := ∑ s, μ s * (if ¬good s then 1 else 0)
  have hab : a + b = 1 := by
    rw [← hμ]
    dsimp only [a, b]
    rw [← sum_add_distrib]
    apply sum_congr rfl
    intro s _
    by_cases hs : good s <;> simp [hs]
  have hb : 0 ≤ b := sum_nonneg (fun s _ => mul_nonneg (hμ0 s) (by split_ifs <;> norm_num))
  have he : (∑ s, if good s then (μ s : ℂ) * c else 0) = (a : ℂ) * c := by
    dsimp only [a]
    rw [Complex.ofReal_sum, sum_mul]
    apply sum_congr rfl
    intro s _
    by_cases hs : good s <;> simp [hs]
  have hd : (a : ℂ) * c - c = ((a : ℂ) - 1) * c := by ring
  rw [he, hd]
  have hh : (a : ℂ) - 1 = -(b : ℂ) := by
    exact_mod_cast (show a - 1 = -b by linarith)
  rw [hh, norm_mul, norm_neg, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hb]

end Bounty
end

section

/- Quantitative square-root consequences of polynomial curvature bounds. -/

namespace Bounty

theorem sqrt_scaled_rpow {N c : ℝ} (hN : 0 < N) (hc : 0 ≤ c) (p : ℝ) :
    Real.sqrt (c*N^p) = Real.sqrt c*N^(p/2) := by
  rw [Real.sqrt_mul hc,Real.sqrt_eq_rpow (N^p),← Real.rpow_mul hN.le]
  congr 1
  ring

theorem curvature_sqrt_power_bounds {N eps c C lam : ℝ}
    (hN : 1 ≤ N) (heps : 0 ≤ eps) (hc : 0 < c) (hC : 0 ≤ C)
    (hlo : c*N^(-2+eps) ≤ lam) (hhi : lam ≤ C*N^(-eps/2)) :
    Real.sqrt lam ≤ Real.sqrt C*N^(-eps/4) ∧
      1/Real.sqrt lam ≤ (N/Real.sqrt c)*N^(-eps/4) := by
  have hN0 : 0 < N := by linarith
  have hsc : 0 < Real.sqrt c := Real.sqrt_pos.mpr hc
  have hp : 0 < N^(-1+eps/2) := Real.rpow_pos_of_pos hN0 _
  have hlo' := Real.sqrt_le_sqrt hlo
  have hhi' := Real.sqrt_le_sqrt hhi
  rw [sqrt_scaled_rpow hN0 hc.le] at hlo'
  rw [sqrt_scaled_rpow hN0 hC] at hhi'
  have he1 : (-2+eps)/2 = -1+eps/2 := by ring
  have he2 : (-eps/2)/2 = -eps/4 := by ring
  rw [he1] at hlo'
  rw [he2] at hhi'
  refine ⟨hhi',?_⟩
  have hinv := one_div_le_one_div_of_le (mul_pos hsc hp) hlo'
  have hpow : N^(-1+eps/2)*N*N^(-eps/2) = 1 := by
    calc
      _ = N^((-1+eps/2)+1+(-eps/2)) := by
        rw [Real.rpow_add hN0 ((-1+eps/2)+1) (-eps/2),
          Real.rpow_add hN0 (-1+eps/2) 1,Real.rpow_one]
      _ = 1 := by
        have he : (-1+eps/2)+1+(-eps/2) = 0 := by ring
        rw [he,Real.rpow_zero]
  have hid : 1/(Real.sqrt c*N^(-1+eps/2)) = (N/Real.sqrt c)*N^(-eps/2) := by
    apply (div_eq_iff (ne_of_gt (mul_pos hsc hp))).mpr
    calc
      1 = (Real.sqrt c/Real.sqrt c)*(N^(-1+eps/2)*N*N^(-eps/2)) := by
        rw [div_self hsc.ne',hpow,one_mul]
      _ = _ := by ring
  rw [hid] at hinv
  exact hinv.trans (mul_le_mul_of_nonneg_left
    (Real.rpow_le_rpow_of_exponent_le hN (by linarith : -eps/2 ≤ -eps/4)) (by positivity))

theorem curvature_test_power_saving {N eps c C lam A D M : ℝ}
    (hN : 1 ≤ N) (heps : 0 ≤ eps) (hc : 0 < c) (hC : 0 ≤ C)
    (hA : 0 ≤ A) (hD : 0 ≤ D) (hM : 0 ≤ M) (hlen : M ≤ D*N)
    (hlo : c*N^(-2+eps) ≤ lam) (hhi : lam ≤ C*N^(-eps/2)) :
    6*(A*M*Real.sqrt lam+2/Real.sqrt lam) ≤
      (6*(A*D*Real.sqrt C+2/Real.sqrt c))*N*N^(-eps/4) := by
  obtain ⟨hroot,hinv⟩ := curvature_sqrt_power_bounds hN heps hc hC hlo hhi
  have ht1 : A*M*Real.sqrt lam ≤ A*(D*N)*(Real.sqrt C*N^(-eps/4)) :=
    mul_le_mul (mul_le_mul_of_nonneg_left hlen hA) hroot
      (Real.sqrt_nonneg _) (by positivity)
  have ht2 : 2/Real.sqrt lam ≤ 2*((N/Real.sqrt c)*N^(-eps/4)) := by
    have h := mul_le_mul_of_nonneg_left hinv (show (0 : ℝ) ≤ 2 by norm_num)
    simpa only [mul_one_div] using h
  calc
    _ ≤ 6*(A*(D*N)*(Real.sqrt C*N^(-eps/4))+2*((N/Real.sqrt c)*N^(-eps/4))) := by linarith
    _ = _ := by ring

end Bounty
end

section

namespace Bounty

noncomputable def logarithmicAmbientLeft (N c : ℝ) : ℤ := Int.ceil (N-c)

noncomputable def logarithmicAmbientRight (N C c : ℝ) : ℤ :=
  logarithmicAmbientLeft N c + (Nat.ceil (C*N):ℤ)

theorem logarithmic_ambient_interval_contains
    (N C c : ℝ) (a b : ℤ) (hN : 1 ≤ N) (hC : 1 ≤ C)
    (ha : N ≤ (a:ℝ)+c) (hb : (b:ℝ)+1+c ≤ C*N) :
    logarithmicAmbientLeft N c ≤ a ∧ b ≤ logarithmicAmbientRight N C c := by
  constructor
  · apply Int.ceil_le.mpr
    linarith
  · have hleft := Int.le_ceil (N-c)
    have hright := Nat.le_ceil (C*N)
    have hh : (b:ℝ) ≤ (logarithmicAmbientRight N C c : ℝ) := by
      simp only [logarithmicAmbientRight, logarithmicAmbientLeft, Int.cast_add, Int.cast_natCast]
      linarith
    exact_mod_cast hh

theorem logarithmic_ambient_length_bounds (N C c : ℝ) (hN : 1 ≤ N) (hC : 1 ≤ C) :
    N ≤ ((logarithmicAmbientRight N C c-logarithmicAmbientLeft N c+1:ℤ):ℝ) ∧
    ((logarithmicAmbientRight N C c-logarithmicAmbientLeft N c+1:ℤ):ℝ) ≤ (C+2)*N := by
  have hCN : 0 ≤ C*N := by positivity
  have hlo := Nat.le_ceil (C*N)
  have hhi := Nat.ceil_lt_add_one hCN
  simp only [logarithmicAmbientRight, add_sub_cancel_left, Int.cast_add,
    Int.cast_natCast, Int.cast_one]
  constructor <;> nlinarith

theorem logarithmic_ambient_order (N C c : ℝ) :
    logarithmicAmbientLeft N c ≤ logarithmicAmbientRight N C c := by
  dsimp only [logarithmicAmbientRight]
  omega

theorem logarithmic_ambient_box
    (N C c s x : ℝ) (hN : 1 ≤ N) (hC : 1 ≤ C) (hs : s ≤ N)
    (hx : x ∈ Set.Icc (logarithmicAmbientLeft N c:ℝ)
      ((logarithmicAmbientRight N C c:ℝ)+1)) :
    N ≤ x+c ∧ x+c+s ≤ (C+5)*N := by
  have hl := Int.le_ceil (N-c)
  have hu := Int.ceil_lt_add_one (N-c)
  have hv := Nat.ceil_lt_add_one (show 0 ≤ C*N by positivity)
  simp only [logarithmicAmbientRight, logarithmicAmbientLeft,
    Int.cast_add, Int.cast_natCast] at hx
  constructor <;> nlinarith [hx.1,hx.2]

end Bounty
end

section

namespace Bounty

theorem logarithmic_shift_power_le_sqrt (N ε : ℝ) (k : ℕ)
    (hN : 1 ≤ N) (hε : ε ≤ 1) (hk : 2 ≤ k) :
    N^(ε/(2*(k:ℝ))) ≤ Real.sqrt N := by
  have hkR : (2:ℝ) ≤ k := by exact_mod_cast hk
  rw [Real.sqrt_eq_rpow]
  apply Real.rpow_le_rpow_of_exponent_le hN
  apply (div_le_iff₀ (show 0 < 2*(k:ℝ) by positivity)).mpr
  linarith

theorem logarithmic_shift_sum_le_scale (N ε : ℝ) (k : ℕ) (hs : List ℤ)
    (hN : 1 ≤ N) (hε : ε ≤ 1) (hk : 2 ≤ k) (hkN : (k:ℝ)^2 ≤ N)
    (hlen : hs.length = k-2)
    (hshifts : ∀ h ∈ hs, h ≤ (Nat.floor (N^(ε/(2*(k:ℝ)))):ℤ)) :
    (hs.map (fun h : ℤ => (h:ℝ))).sum ≤ N := by
  have hN0 : 0 ≤ N := by linarith
  have hpow := logarithmic_shift_power_le_sqrt N ε k hN hε hk
  have hfloor := Nat.floor_le (Real.rpow_nonneg hN0 (ε/(2*(k:ℝ))))
  have hpoint : ∀ h ∈ hs.map (fun h : ℤ => (h:ℝ)), h ≤ Real.sqrt N := by
    intro h hh
    obtain ⟨z,hz,rfl⟩ := List.mem_map.mp hh
    have hz' : (z:ℝ) ≤ (Nat.floor (N^(ε/(2*(k:ℝ)))):ℝ) := by
      exact_mod_cast hshifts z hz
    exact hz'.trans (hfloor.trans hpow)
  have hsum := List.sum_le_card_nsmul (hs.map (fun h : ℤ => (h:ℝ))) (Real.sqrt N) hpoint
  have hlenR : (hs.length:ℝ) ≤ k := by exact_mod_cast (show hs.length ≤ k by omega)
  calc
    _ ≤ (hs.length:ℝ)*Real.sqrt N := by simpa only [List.length_map, nsmul_eq_mul] using hsum
    _ ≤ (k:ℝ)*Real.sqrt N := mul_le_mul_of_nonneg_right hlenR (Real.sqrt_nonneg _)
    _ ≤ N := by
      have hsqr := Real.sq_sqrt hN0
      have hkR : (0:ℝ) ≤ k := Nat.cast_nonneg _
      have hkle : (k:ℝ) ≤ Real.sqrt N := by nlinarith [Real.sqrt_nonneg N]
      nlinarith [Real.sqrt_nonneg N]

theorem logarithmic_floor_shift_bounds (N ε : ℝ) (k : ℕ)
    (hN : 1 ≤ N) (hε : ε ≤ 1) (hk : 2 ≤ k)
    (hpow2 : 2 ≤ N^(ε/(2*(k:ℝ)))) :
    1 ≤ (Nat.floor (N^(ε/(2*(k:ℝ)))):ℤ) ∧
    (Nat.floor (N^(ε/(2*(k:ℝ)))):ℝ) ≤ N := by
  have hN0 : 0 ≤ N := by linarith
  have hf := Nat.lt_floor_add_one (N^(ε/(2*(k:ℝ))))
  have hfloor := Nat.floor_le (Real.rpow_nonneg hN0 (ε/(2*(k:ℝ))))
  constructor
  · have hpos : (0:ℝ) < (Nat.floor (N^(ε/(2*(k:ℝ)))):ℝ) := by linarith
    exact_mod_cast (show 1 ≤ Nat.floor (N^(ε/(2*(k:ℝ)))) by exact_mod_cast hpos)
  · have hp := logarithmic_shift_power_le_sqrt N ε k hN hε hk
    have hsqrtN : Real.sqrt N ≤ N := by nlinarith [Real.sq_sqrt hN0, Real.sqrt_nonneg N]
    exact hfloor.trans (hp.trans hsqrtN)

end Bounty
end

section

/- Exact divisor-majorant rearrangement and norm bounds for oscillatory tests. -/

open Finset

namespace Bounty

theorem interval_divisor_sum_rearrange (a b : ℕ) (lam : ℕ → ℂ) (F : ℕ → ℂ) :
    (∑ n ∈ Ioc a b, (∑ d ∈ n.divisors, lam d)*F n) =
      ∑ d ∈ Icc 1 b, lam d*(∑ n ∈ (Ioc a b).filter (fun n => d ∣ n), F n) := by
  classical
  have hdiv (n : ℕ) (hn : n ∈ Ioc a b) :
      n.divisors = (Icc 1 b).filter (fun d => d ∣ n) := by
    have hn' := mem_Ioc.mp hn
    have hnp : 0 < n := lt_of_le_of_lt (Nat.zero_le _) hn'.1
    ext d
    simp only [Nat.mem_divisors,mem_filter,mem_Icc]
    constructor
    · rintro ⟨hd,hn0⟩
      exact ⟨⟨Nat.pos_of_dvd_of_pos hd hnp,(Nat.le_of_dvd hnp hd).trans hn'.2⟩,hd⟩
    · rintro ⟨hd,hdn⟩
      exact ⟨hdn,hnp.ne'⟩
  calc
    _ = ∑ n ∈ Ioc a b, ∑ d ∈ Icc 1 b, if d ∣ n then lam d*F n else 0 := by
      apply sum_congr rfl
      intro n hn
      rw [hdiv n hn,sum_mul,sum_filter]
    _ = ∑ d ∈ Icc 1 b, ∑ n ∈ Ioc a b, if d ∣ n then lam d*F n else 0 := sum_comm
    _ = _ := by
      apply sum_congr rfl
      intro d hd
      rw [mul_sum,sum_filter]

theorem interval_divisor_sum_norm_bound (a b : ℕ) (lam : ℕ → ℂ) (F : ℕ → ℂ)
    (R : ℕ → ℝ)
    (hR : ∀ d ∈ Icc 1 b, lam d ≠ 0 →
      ‖∑ n ∈ (Ioc a b).filter (fun n => d ∣ n), F n‖ ≤ R d) :
    ‖∑ n ∈ Ioc a b, (∑ d ∈ n.divisors, lam d)*F n‖ ≤
      ∑ d ∈ Icc 1 b, ‖lam d‖*R d := by
  rw [interval_divisor_sum_rearrange]
  apply (norm_sum_le _ _).trans
  apply sum_le_sum
  intro d hd
  by_cases hz : lam d = 0
  · simp [hz]
  · rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (hR d hd hz) (norm_nonneg _)

end Bounty
end

section

/- Exact interval reindexing of the multiples of a positive integer. -/

open Finset

namespace Bounty

theorem sum_interval_multiples (a b d : ℕ) (hd : 0 < d) (F : ℕ → ℂ) :
    ∑ n ∈ (Ioc a b).filter (fun n => d ∣ n), F n =
      ∑ m ∈ Ioc (a/d) (b/d), F (m*d) := by
  classical
  symm
  apply sum_bij (fun (m : ℕ) _ => m*d)
  · intro m hm
    obtain ⟨hl,hr⟩ := mem_Ioc.mp hm
    exact mem_filter.mpr ⟨mem_Ioc.mpr ⟨(Nat.div_lt_iff_lt_mul hd).mp hl,
      (Nat.le_div_iff_mul_le hd).mp hr⟩,dvd_mul_left d m⟩
  · intro m hm n hn he
    exact Nat.eq_of_mul_eq_mul_right hd he
  · intro n hn
    obtain ⟨hn,hdn⟩ := mem_filter.mp hn
    obtain ⟨hl,hr⟩ := mem_Ioc.mp hn
    have he : n/d*d=n := Nat.div_mul_cancel hdn
    refine ⟨n/d, mem_Ioc.mpr ⟨?_, ?_⟩, he⟩
    · apply (Nat.div_lt_iff_lt_mul hd).mpr
      rwa [he]
    · exact Nat.div_le_div_right hr
  · intro m hm
    rfl

end Bounty
end

section

/- Any Dirichlet character can be bounded using its individual residue-class phase sums. -/

open Finset

namespace Bounty

theorem character_sum_le_residue_phase_bounds {q : ℕ} [NeZero q]
    (S : Finset ℕ) (χ : DirichletCharacter ℂ q) (F : ℕ → ℂ) {E : ℝ}
    (hE : 0 ≤ E)
    (hclass : ∀ a : ZMod q, IsUnit a →
      ‖∑ n ∈ S.filter (fun n : ℕ => (n : ZMod q) = a), F n‖ ≤ E) :
    ‖∑ n ∈ S, χ (n : ZMod q)*F n‖ ≤ (q : ℝ)*E := by
  classical
  rw [← sum_fiberwise S (fun n : ℕ => (n : ZMod q)) (fun n => χ (n : ZMod q)*F n)]
  have he (a : ZMod q) :
      (∑ n ∈ S.filter (fun n : ℕ => (n : ZMod q) = a), χ (n : ZMod q)*F n) =
      χ a*(∑ n ∈ S.filter (fun n : ℕ => (n : ZMod q) = a), F n) := by
    rw [mul_sum]
    apply sum_congr rfl
    intro n hn
    rw [(mem_filter.mp hn).2]
  simp_rw [he]
  calc
    _ ≤ ∑ a : ZMod q, ‖χ a*(∑ n ∈ S.filter (fun n : ℕ => (n : ZMod q) = a), F n)‖ := norm_sum_le _ _
    _ ≤ ∑ _a : ZMod q, E := by
      apply sum_le_sum
      intro a ha
      by_cases hau : IsUnit a
      · rw [norm_mul]
        exact (mul_le_mul_of_nonneg_right (χ.norm_le_one a) (norm_nonneg _)).trans
          (by simpa only [one_mul] using hclass a hau)
      · rw [MulChar.map_nonunit χ hau,zero_mul,norm_zero]
        exact hE
    _ = (q : ℝ)*E := by simp [ZMod.card]

end Bounty
end

section

/- Divisors in the complementary prime pool, with multiplicities retained. -/

open Finset

namespace Bounty

theorem primePoolFreePart_mul (P : Finset ℕ) {a b : ℕ} (ha : a ≠ 0) (hb : b ≠ 0) :
    primePoolFreePart P (a * b) = primePoolFreePart P a * primePoolFreePart P b := by
  apply Nat.eq_of_mul_eq_mul_left (Nat.mul_pos
    (Nat.pos_of_ne_zero (primePoolPart_ne_zero P a))
    (Nat.pos_of_ne_zero (primePoolPart_ne_zero P b)))
  calc
    (primePoolPart P a * primePoolPart P b) * primePoolFreePart P (a * b) =
        primePoolPart P (a * b) * primePoolFreePart P (a * b) := by
      rw [primePoolPart_mul P ha hb]
    _ = a * b := primePoolPart_mul_primePoolFreePart P (a * b)
    _ = (primePoolPart P a * primePoolFreePart P a) *
        (primePoolPart P b * primePoolFreePart P b) := by
      rw [primePoolPart_mul_primePoolFreePart, primePoolPart_mul_primePoolFreePart]
    _ = _ := by ring

theorem primePoolFreePart_eq_self_of_disjoint (P : Finset ℕ) {n : ℕ}
    (hn : n ≠ 0) (hfree : Disjoint n.primeFactors P) : primePoolFreePart P n = n := by
  have hp := primePoolPart_eq_one_of_disjoint hfree.symm
    (Nat.mem_factoredNumbers_of_primeFactors_subset hn (fun _ h => h))
  rw [primePoolFreePart, hp, Nat.div_one]

theorem dvd_primePoolFreePart_iff (P : Finset ℕ) {d n : ℕ} (hn : n ≠ 0) :
    d ∣ primePoolFreePart P n ↔ d ∣ n ∧ Disjoint d.primeFactors P := by
  constructor
  · intro hd
    refine ⟨dvd_trans hd (Nat.div_dvd_of_dvd (primePoolPart_dvd P n)), ?_⟩
    exact (primePoolFreePart_primeFactors_disjoint P n).mono_left
      (Nat.primeFactors_mono hd (primePoolFreePart_ne_zero P hn))
  · rintro ⟨hd, hfree⟩
    obtain ⟨k, rfl⟩ := hd
    have hd0 : d ≠ 0 := by intro h; apply hn; simp [h]
    have hk0 : k ≠ 0 := by intro h; apply hn; simp [h]
    rw [primePoolFreePart_mul P hd0 hk0, primePoolFreePart_eq_self_of_disjoint P hd0 hfree]
    exact dvd_mul_right d _

theorem divisors_primePoolFreePart (P : Finset ℕ) {n : ℕ} (hn : n ≠ 0) :
    (primePoolFreePart P n).divisors = n.divisors.filter (fun d => Disjoint d.primeFactors P) := by
  classical
  ext d
  constructor
  · intro hd
    have h := (dvd_primePoolFreePart_iff P hn).mp (Nat.mem_divisors.mp hd).1
    exact mem_filter.mpr ⟨Nat.mem_divisors.mpr ⟨h.1, hn⟩, h.2⟩
  · intro hd
    obtain ⟨hd, hfree⟩ := mem_filter.mp hd
    exact Nat.mem_divisors.mpr ⟨(dvd_primePoolFreePart_iff P hn).mpr
      ⟨(Nat.mem_divisors.mp hd).1, hfree⟩, primePoolFreePart_ne_zero P hn⟩

end Bounty
end

section

/- A three-region integral estimate on a bounded real interval. The low-region
cost uses only the length of its enclosing interval, so no disjointness or
overlap multiplicity is hidden in the conclusion. -/

open MeasureTheory Set

namespace Bounty

theorem three_regime_integral_le (R l A B C : ℝ) (f g h : ℝ → ℝ)
    (hf : Continuous f) (hg : Continuous g) (hh : Continuous h)
    (hl : 0 ≤ l) (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (E : Set ℝ) (hE : MeasurableSet E) (hED : E ⊆ Icc (-R) R)
    (hg0 : ∀ t ∈ Icc (-R) R, 0 ≤ g t)
    (hh0 : ∀ t ∈ Icc (-R) R, 0 ≤ h t)
    (hsmall : ∀ t ∈ Icc (-R) R, t ∉ E → f t ≤ A * g t)
    (hhigh : ∀ t ∈ E, l < |t| → f t ≤ B * h t)
    (hlow : ∀ t ∈ E, |t| ≤ l → f t ≤ C) :
    (∫ t in Icc (-R) R, f t) ≤
      A * (∫ t in Icc (-R) R, g t) + B * (∫ t in E, h t) + 2 * l * C := by
  classical
  let D := Icc (-R) R
  let L := Icc (-l) l
  have hfD : IntegrableOn f D := hf.continuousOn.integrableOn_Icc
  have hgD : IntegrableOn g D := hg.continuousOn.integrableOn_Icc
  have hhD : IntegrableOn h D := hh.continuousOn.integrableOn_Icc
  have hcD : IntegrableOn (fun _ : ℝ => C) D :=
    continuous_const.continuousOn.integrableOn_Icc
  have hcL : IntegrableOn (fun _ : ℝ => C) L :=
    continuous_const.continuousOn.integrableOn_Icc
  have hLi : MeasurableSet L := measurableSet_Icc
  have hEi := hhD.indicator hE
  have hCi := hcD.indicator hLi
  have hpoint : ∀ t ∈ D,
      f t ≤ A * g t + B * E.indicator h t + L.indicator (fun _ => C) t := by
    intro t ht
    have hag : 0 ≤ A * g t := mul_nonneg hA (hg0 t ht)
    have hbh : 0 ≤ B * h t := mul_nonneg hB (hh0 t ht)
    by_cases he : t ∈ E
    · by_cases htl : |t| ≤ l
      · have htL : t ∈ L := abs_le.mp htl
        simpa only [indicator_of_mem he, indicator_of_mem htL] using
          (hlow t he htl).trans (by linarith : C ≤ A * g t + B * h t + C)
      · have htL : t ∉ L := fun hmem => htl (abs_le.mpr hmem)
        simpa only [indicator_of_mem he, indicator_of_notMem htL, add_zero] using
          (hhigh t he (lt_of_not_ge htl)).trans (by linarith : B * h t ≤ A * g t + B * h t)
    · by_cases htL : t ∈ L
      · simpa only [indicator_of_notMem he, indicator_of_mem htL, mul_zero, add_zero] using
          (hsmall t ht he).trans (by linarith : A * g t ≤ A * g t + C)
      · simpa only [indicator_of_notMem he, indicator_of_notMem htL, mul_zero, add_zero] using
          hsmall t ht he
  have hmajor := setIntegral_mono_on hfD
    (((hgD.const_mul A).add (hEi.const_mul B)).add hCi) measurableSet_Icc hpoint
  have hlowIntegral : (∫ t in D, L.indicator (fun _ => C) t) ≤ 2 * l * C := by
    rw [setIntegral_indicator hLi]
    calc
      (∫ t in D ∩ L, C) ≤ ∫ t in L, C :=
        setIntegral_mono_set hcL (Filter.Eventually.of_forall fun _ => hC)
          (Filter.Eventually.of_forall fun _ ht => ht.2)
      _ = 2 * l * C := by
        rw [setIntegral_const, Real.volume_real_Icc_of_le (by linarith : -l ≤ l)]
        simp only [smul_eq_mul]
        ring
  have hDE : D ∩ E = E := inter_eq_right.mpr hED
  simp only [Pi.add_apply] at hmajor
  have hsplit₁ := integral_add ((hgD.const_mul A).add (hEi.const_mul B)) hCi
  have hsplit₂ := integral_add (hgD.const_mul A) (hEi.const_mul B)
  simp only [Pi.add_apply] at hsplit₁ hsplit₂
  rw [hsplit₁, hsplit₂, integral_const_mul,
    integral_const_mul, setIntegral_indicator hE, hDE] at hmajor
  exact hmajor.trans (by linarith [hlowIntegral])

theorem three_regime_integral_bound (R l η Bs Bq Hq Lm Bt : ℝ)
    (S Q M T : ℝ → ℂ) (hS : Continuous S) (hQ : Continuous Q)
    (hM : Continuous M) (hT : Continuous T)
    (hl : 0 ≤ l) (hη : 0 ≤ η) (hBs : 0 ≤ Bs) (_hBq : 0 ≤ Bq)
    (hHq : 0 ≤ Hq) (_hLm : 0 ≤ Lm) (_hBt : 0 ≤ Bt)
    (hSbound : ∀ t ∈ Icc (-R) R, ‖S t‖ ≤ Bs)
    (hQbound : ∀ t ∈ Icc (-R) R, ‖Q t‖ ≤ Bq)
    (hTbound : ∀ t ∈ Icc (-R) R, ‖T t‖ ≤ Bt)
    (hhigh : ∀ t ∈ Icc (-R) R, η < ‖S t‖ → l < |t| → ‖Q t‖ ≤ Hq)
    (hlow : ∀ t ∈ Icc (-R) R, |t| ≤ l → ‖M t‖ ≤ Lm) :
    (∫ t in Icc (-R) R, ‖S t * Q t * M t * T t‖ ^ 2) ≤
      η ^ 2 * (∫ t in Icc (-R) R, ‖Q t * M t * T t‖ ^ 2) +
      Bs ^ 2 * Hq ^ 2 *
        (∫ t in {t ∈ Icc (-R) R | η < ‖S t‖}, ‖M t * T t‖ ^ 2) +
      2 * l * Bs ^ 2 * Bq ^ 2 * Lm ^ 2 * Bt ^ 2 := by
  have hsquare : ∀ t ∈ Icc (-R) R, ‖S t‖ ^ 2 ≤ Bs ^ 2 := fun t ht =>
    (sq_le_sq₀ (norm_nonneg _) hBs).mpr (hSbound t ht)
  have h := three_regime_integral_le R l (η ^ 2) (Bs ^ 2 * Hq ^ 2)
    (Bs ^ 2 * Bq ^ 2 * Lm ^ 2 * Bt ^ 2)
    (fun t => ‖S t * Q t * M t * T t‖ ^ 2)
    (fun t => ‖Q t * M t * T t‖ ^ 2) (fun t => ‖M t * T t‖ ^ 2)
    (by fun_prop) (by fun_prop) (by fun_prop) hl (sq_nonneg _)
    (mul_nonneg (sq_nonneg _) (sq_nonneg _)) (by positivity)
    {t ∈ Icc (-R) R | η < ‖S t‖}
    (measurableSet_Icc.inter (isOpen_lt continuous_const hS.norm).measurableSet)
    (fun _ ht => ht.1) (fun _ _ => sq_nonneg _) (fun _ _ => sq_nonneg _)
    (by
      intro t ht he
      have hs : ‖S t‖ ≤ η := le_of_not_gt (fun hh => he ⟨ht, hh⟩)
      have hs2 := (sq_le_sq₀ (norm_nonneg _) hη).mpr hs
      simpa only [norm_mul, mul_pow, mul_assoc] using
        mul_le_mul_of_nonneg_right hs2 (sq_nonneg ‖Q t * M t * T t‖))
    (by
      intro t ht htl
      have hq2 := (sq_le_sq₀ (norm_nonneg _) hHq).mpr (hhigh t ht.1 ht.2 htl)
      have hsq := mul_le_mul (hsquare t ht.1) hq2 (sq_nonneg _) (sq_nonneg _)
      simpa only [norm_mul, mul_pow, mul_assoc] using
        mul_le_mul_of_nonneg_right hsq (sq_nonneg ‖M t * T t‖))
    (by
      intro t ht htl
      simp only [norm_mul, mul_pow]
      gcongr
      · exact hSbound t ht.1
      · exact hQbound t ht.1
      · exact hlow t ht.1 htl
      · exact hTbound t ht.1)
  convert h using 1
  ring

end Bounty
end

section

/- Scalar decay and parameter order for the three frequency regimes. -/

namespace Bounty

theorem three_regime_rpow_sq {L : ℝ} (hL : 0 < L) (a : ℝ) :
    (L ^ a) ^ (2 : ℕ) = L ^ (2 * a) := by
  rw [← Real.rpow_natCast, ← Real.rpow_mul hL.le]
  congr 1
  ring

theorem three_regime_power_budget {L A Cmean Csparse s q t As H B B0 : ℝ}
    (hL : 4 ≤ L)
    (hAs : A + Cmean + 1 ≤ 2 * As)
    (hH : A + 2 * s + Csparse + 1 ≤ 2 * H)
    (hB : A + B0 + 2 * s + 2 * q + 2 * t + 1 ≤ 2 * B) :
    (L ^ (-As)) ^ (2 : ℕ) * L ^ Cmean +
        (L ^ s) ^ (2 : ℕ) * (L ^ (-H)) ^ (2 : ℕ) * L ^ Csparse +
        2 * L ^ B0 * (L ^ s) ^ (2 : ℕ) * (L ^ q) ^ (2 : ℕ) *
          (L ^ (-B)) ^ (2 : ℕ) * (L ^ t) ^ (2 : ℕ) ≤ L ^ (-A) := by
  have hL0 : 0 < L := by linarith
  have hL1 : 1 ≤ L := by linarith
  have hout : (L ^ (-As)) ^ (2 : ℕ) * L ^ Cmean ≤ L ^ (-A - 1) := by
    rw [three_regime_rpow_sq hL0, ← Real.rpow_add hL0]
    apply Real.rpow_le_rpow_of_exponent_le hL1
    linarith
  have hhigh : (L ^ s) ^ (2 : ℕ) * (L ^ (-H)) ^ (2 : ℕ) * L ^ Csparse ≤
      L ^ (-A - 1) := by
    rw [three_regime_rpow_sq hL0, three_regime_rpow_sq hL0,
      ← Real.rpow_add hL0, ← Real.rpow_add hL0]
    apply Real.rpow_le_rpow_of_exponent_le hL1
    linarith
  have hlow : 2 * L ^ B0 * (L ^ s) ^ (2 : ℕ) * (L ^ q) ^ (2 : ℕ) *
      (L ^ (-B)) ^ (2 : ℕ) * (L ^ t) ^ (2 : ℕ) ≤ 2 * L ^ (-A - 1) := by
    calc
      _ = 2 * (L ^ B0 * (L ^ s) ^ (2 : ℕ) * (L ^ q) ^ (2 : ℕ) *
          (L ^ (-B)) ^ (2 : ℕ) * (L ^ t) ^ (2 : ℕ)) := by ring
      _ ≤ _ := by
        apply mul_le_mul_of_nonneg_left _ (by norm_num : (0 : ℝ) ≤ 2)
        rw [three_regime_rpow_sq hL0, three_regime_rpow_sq hL0,
          three_regime_rpow_sq hL0, three_regime_rpow_sq hL0,
          ← Real.rpow_add hL0, ← Real.rpow_add hL0,
          ← Real.rpow_add hL0, ← Real.rpow_add hL0]
        apply Real.rpow_le_rpow_of_exponent_le hL1
        linarith
  have hfinal : 4 * L ^ (-A - 1) ≤ L ^ (-A) := by
    rw [Real.rpow_sub hL0, Real.rpow_one, ← mul_div_assoc]
    apply (div_le_iff₀ hL0).mpr
    nlinarith [Real.rpow_nonneg hL0.le (-A)]
  linarith

theorem exists_three_regime_power_choices (A Cmean Csparse s q t : ℝ) :
    ∃ As : ℝ, 0 ≤ As ∧ ∃ H : ℝ, 0 ≤ H ∧ ∀ B0 : ℝ, ∃ B : ℝ, 0 ≤ B ∧
      ∀ L : ℝ, 4 ≤ L →
      (L ^ (-As)) ^ (2 : ℕ) * L ^ Cmean +
          (L ^ s) ^ (2 : ℕ) * (L ^ (-H)) ^ (2 : ℕ) * L ^ Csparse +
          2 * L ^ B0 * (L ^ s) ^ (2 : ℕ) * (L ^ q) ^ (2 : ℕ) *
            (L ^ (-B)) ^ (2 : ℕ) * (L ^ t) ^ (2 : ℕ) ≤ L ^ (-A) := by
  refine ⟨max 0 ((A + Cmean + 1) / 2), le_max_left _ _,
    max 0 ((A + 2 * s + Csparse + 1) / 2), le_max_left _ _, ?_⟩
  intro B0
  refine ⟨max 0 ((A + B0 + 2 * s + 2 * q + 2 * t + 1) / 2),
    le_max_left _ _, ?_⟩
  intro L hL
  apply three_regime_power_budget hL
  · linarith [le_max_right 0 ((A + Cmean + 1) / 2)]
  · linarith [le_max_right 0 ((A + 2 * s + Csparse + 1) / 2)]
  · linarith [le_max_right 0 ((A + B0 + 2 * s + 2 * q + 2 * t + 1) / 2)]

end Bounty
end

section

/- A uniform log-power budget for the explicit sparse sampling prefactor. -/

open Filter

namespace Bounty

theorem sparse_logarithmic_prefactor_le_square {c L Y : ℝ} {N : ℕ}
    (_hc : 0 ≤ c) (hL : 1 ≤ L)
    (hlarge : 72 * Real.pi * (3 + 2 * Real.log 4 + 2 * c) + 1 ≤ L)
    (hY : 0 < Y) (hN : 1 ≤ N) (hNY : (N : ℝ) ≤ 4 * Y)
    (hlog : Real.log Y ≤ c * L) :
    72 * Real.pi * (1 + 2 * (1 + Real.log N)) + 1 ≤ L ^ (2 : ℕ) := by
  have hN0 : 0 < (N : ℝ) := by exact_mod_cast (zero_lt_one.trans_le hN)
  have hlogN : Real.log N ≤ Real.log 4 + c * L := by
    calc
      _ ≤ Real.log (4 * Y) := Real.log_le_log hN0 hNY
      _ = Real.log 4 + Real.log Y := Real.log_mul (by norm_num) hY.ne'
      _ ≤ Real.log 4 + c * L := by linarith
  have hlog4 : 0 ≤ Real.log 4 := Real.log_nonneg (by norm_num)
  have hpi := Real.pi_pos
  have hbase : 3 + 2 * Real.log 4 + 2 * c * L ≤
      (3 + 2 * Real.log 4 + 2 * c) * L := by nlinarith
  have hinner : 1 + 2 * (1 + Real.log N) ≤
      (3 + 2 * Real.log 4 + 2 * c) * L := by linarith
  have hm := mul_le_mul_of_nonneg_left hinner (by positivity : 0 ≤ 72 * Real.pi)
  have hlast := mul_le_mul_of_nonneg_right hlarge (by linarith : 0 ≤ L)
  nlinarith

theorem eventually_sparse_logarithmic_prefactor_le_square {c : ℝ} (hc : 0 ≤ c) :
    ∀ᶠ L : ℝ in atTop, ∀ (Y : ℝ) (N : ℕ), 0 < Y → 1 ≤ N →
      (N : ℝ) ≤ 4 * Y → Real.log Y ≤ c * L →
      72 * Real.pi * (1 + 2 * (1 + Real.log N)) + 1 ≤ L ^ (2 : ℕ) := by
  filter_upwards [eventually_ge_atTop (1 : ℝ),
    eventually_ge_atTop (72 * Real.pi * (3 + 2 * Real.log 4 + 2 * c) + 1)]
    with L hL hlarge
  intro Y N hY hN hNY hlog
  exact sparse_logarithmic_prefactor_le_square hc hL hlarge hY hN hNY hlog

end Bounty
end

section

/- Exact residue-class interval sums as integer arithmetic progressions. -/

open Finset

namespace Bounty

theorem integer_residue_interval_sum (A B : ℤ) {q : ℕ} [NeZero q]
    (r : ZMod q) (F : ℤ → ℂ) :
    ∑ n ∈ (Ioc A B).filter (fun n : ℤ => (n : ZMod q) = r), F n =
      ∑ y ∈ Icc ((A-(r.val : ℤ))/(q : ℤ)+1) ((B-(r.val : ℤ))/(q : ℤ)),
        F (y*(q : ℤ)+r.val) := by
  classical
  have hq : 0 < (q : ℤ) := by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne q)
  symm
  apply sum_bij (fun (y : ℤ) _ => y*(q : ℤ)+r.val)
  · intro y hy
    obtain ⟨hlo,hhi⟩ := mem_Icc.mp hy
    have hl := (Int.ediv_lt_iff_lt_mul hq).mp (show (A-(r.val : ℤ))/(q : ℤ) < y by omega)
    have hr := (Int.le_ediv_iff_mul_le hq).mp hhi
    apply mem_filter.mpr
    refine ⟨mem_Ioc.mpr ⟨by linarith,by linarith⟩,?_⟩
    apply (ZMod.intCast_eq_iff q _ r).mpr
    exact ⟨y,by ring⟩
  · intro y hy z hz he
    exact mul_right_cancel₀ hq.ne' (by linarith)
  · intro n hn
    obtain ⟨hn,hr⟩ := mem_filter.mp hn
    obtain ⟨hl,hu⟩ := mem_Ioc.mp hn
    obtain ⟨y,hy⟩ := (ZMod.intCast_eq_iff q n r).mp hr
    refine ⟨y,mem_Icc.mpr ⟨?_,?_⟩,by linarith [hy]⟩
    · have hh : (A-(r.val : ℤ))/(q : ℤ) < y :=
        (Int.ediv_lt_iff_lt_mul hq).mpr (by nlinarith [hy])
      omega
    · exact (Int.le_ediv_iff_mul_le hq).mpr (by nlinarith [hy])
  · intro y hy
    rfl

end Bounty
end

section

/- Division endpoints retain the original dyadic scale after passing to a residue progression. -/

namespace Bounty

theorem progression_multiple_endpoints (a b d q r : ℤ) (hd : 0 < d) (hq : 0 < q) :
    a < (((a/d-r)/q+1)*q+r)*d ∧
      (((b/d-r)/q+1)*q+r)*d ≤ b+d*q := by
  constructor
  · apply (Int.ediv_lt_iff_lt_mul hd).mp
    have h := (Int.ediv_lt_iff_lt_mul hq).mp
      (show (a/d-r)/q < (a/d-r)/q+1 by omega)
    linarith
  · have hq0 := (Int.le_ediv_iff_mul_le hq).mp (show (b/d-r)/q ≤ (b/d-r)/q by rfl)
    have hd0 := (Int.le_ediv_iff_mul_le hd).mp (show b/d ≤ b/d by rfl)
    have hm := mul_le_mul_of_nonneg_right hq0 hd.le
    nlinarith

theorem progression_real_scale (a b d q r : ℤ) {Y : ℝ} (hd : 0 < d) (hq : 0 < q)
    (hYa : Y ≤ (a : ℝ)+1) (hbY : (b : ℝ) ≤ 2*Y) (hdq : (d : ℝ)*(q : ℝ) ≤ Y) :
    Y/((d : ℝ)*(q : ℝ)) ≤ (((a/d-r)/q+1 : ℤ) : ℝ)+(r : ℝ)/(q : ℝ) ∧
      (((b/d-r)/q : ℤ) : ℝ)+1+(r : ℝ)/(q : ℝ) ≤ 3*(Y/((d : ℝ)*(q : ℝ))) := by
  have hdR : 0 < (d : ℝ) := by exact_mod_cast hd
  have hqR : 0 < (q : ℝ) := by exact_mod_cast hq
  have hprod : 0 < (d : ℝ)*(q : ℝ) := mul_pos hdR hqR
  obtain ⟨hlo,hhi⟩ := progression_multiple_endpoints a b d q r hd hq
  have hloR : (a : ℝ)+1 ≤ ((((a/d-r)/q+1)*q+r)*d : ℤ) := by
    exact_mod_cast (show a+1 ≤ (((a/d-r)/q+1)*q+r)*d by omega)
  have hhiR : (((((b/d-r)/q+1)*q+r)*d : ℤ) : ℝ) ≤ (b : ℝ)+(d : ℝ)*(q : ℝ) := by
    exact_mod_cast hhi
  have he (x : ℤ) : ((x : ℝ)+(r : ℝ)/(q : ℝ))*((d : ℝ)*(q : ℝ)) = ((x*q+r)*d : ℤ) := by
    push_cast
    field_simp
  constructor
  · apply (div_le_iff₀ hprod).mpr
    rw [he]
    exact hYa.trans hloR
  · have hx : (((b/d-r)/q : ℤ) : ℝ)+1+(r : ℝ)/(q : ℝ) =
        (((b/d-r)/q+1 : ℤ) : ℝ)+(r : ℝ)/(q : ℝ) := by push_cast; ring
    have hh : ((((b/d-r)/q : ℤ) : ℝ)+1+(r : ℝ)/(q : ℝ))*((d : ℝ)*(q : ℝ)) ≤ 3*Y := by
      rw [hx,he]
      linarith
    have hh' := (le_div_iff₀ hprod).mpr hh
    calc
      _ ≤ (3*Y)/((d : ℝ)*(q : ℝ)) := hh'
      _ = 3*(Y/((d : ℝ)*(q : ℝ))) := by ring

end Bounty
end

section

/- All four unit factors use the same complete character expansion. -/

open scoped BigOperators Classical

namespace Bounty

theorem rational_four_factor_unit_expansion {r Q : ℕ} (hr : 0 < r) (hrQ : r ≤ Q)
    (u : ℤ) :
    ∃ c : AddChar (Additive (ZMod r)ˣ) ℂ → ℂ,
      (∑ ψ, ‖c ψ‖) ≤ Real.sqrt (Q : ℝ) ∧
      ∀ m a p v : ℕ, m.Coprime r → a.Coprime r → p.Coprime r → v.Coprime r →
        (∑ ψ, c ψ * unitAddCharDirichlet ψ (m : ZMod r) *
          unitAddCharDirichlet ψ (a : ZMod r) * unitAddCharDirichlet ψ (p : ZMod r) *
          unitAddCharDirichlet ψ (v : ZMod r)) =
          Complex.exp (Complex.I * (2 * Real.pi * ((u : ℝ) / r * (m * a * p * v)) : ℝ)) := by
  obtain ⟨c, hc, he⟩ := rational_unit_character_expansion hr hrQ u
  refine ⟨c, hc, ?_⟩
  intro m a p v hm ha hp hv
  simpa only [Nat.cast_mul, map_mul, mul_assoc] using
    he (m * a * p * v) (((hm.mul_left ha).mul_left hp).mul_left hv)

theorem rational_four_factor_phase_cancel {d q r v n : ℕ}
    (hd : 0 < d) (hq : 0 < q) (hr : d * q = r) (hn : d * v = n)
    (u : ℤ) (m a p : ℕ) :
    Complex.exp (Complex.I * (2 * Real.pi * ((u : ℝ) / r * (m * a * p * n)) : ℝ)) =
      Complex.exp (Complex.I * (2 * Real.pi * ((u : ℝ) / q * (m * a * p * v)) : ℝ)) := by
  have hd0 : (d : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.ne_of_gt hd)
  have hq0 : (q : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.ne_of_gt hq)
  have hrd : (d : ℝ) * q = r := by exact_mod_cast hr
  have hnd : (d : ℝ) * v = n := by exact_mod_cast hn
  have he : (u : ℝ) / r * (m * a * p * n) = (u : ℝ) / q * (m * a * p * v) := by
    rw [← hrd, ← hnd]
    field_simp
  rw [he]

end Bounty
end

section

/- The fixed sixteenth-divisor-moment loss fits a fixed power of L. -/

namespace Bounty

theorem four_convolution_log_budget {c L U : ℝ} (_hc : 0 ≤ c) (hL : 1 ≤ L)
    (hlarge : 3 * (1 + Real.log 3 + c) ^ (15 : ℕ) ≤ L)
    (hU : 1 ≤ U) (hlog : Real.log U ≤ c * L) :
    3 * (1 + Real.log ⌈2 * U⌉₊) ^ (15 : ℕ) ≤ L ^ (16 : ℕ) := by
  have hU0 : 0 < U := zero_lt_one.trans_le hU
  have hN0 : 0 < (⌈2 * U⌉₊ : ℝ) :=
    lt_of_lt_of_le (by linarith) (Nat.le_ceil (2 * U))
  have hN : (⌈2 * U⌉₊ : ℝ) ≤ 3 * U := by
    have hh := Nat.ceil_lt_add_one (by linarith : 0 ≤ 2 * U)
    linarith
  have hlogN : Real.log ⌈2 * U⌉₊ ≤ Real.log 3 + c * L := by
    calc
      _ ≤ Real.log (3 * U) := Real.log_le_log hN0 hN
      _ = Real.log 3 + Real.log U := Real.log_mul (by norm_num) hU0.ne'
      _ ≤ Real.log 3 + c * L := by linarith
  have hlog3 : 0 ≤ Real.log 3 := Real.log_nonneg (by norm_num)
  have hlinear : 1 + Real.log ⌈2 * U⌉₊ ≤ (1 + Real.log 3 + c) * L := by nlinarith
  have hbase : 0 ≤ 1 + Real.log ⌈2 * U⌉₊ := by
    linarith [Real.log_natCast_nonneg ⌈2 * U⌉₊]
  calc
    _ ≤ 3 * ((1 + Real.log 3 + c) * L) ^ (15 : ℕ) :=
      mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hbase hlinear 15) (by norm_num)
    _ = (3 * (1 + Real.log 3 + c) ^ (15 : ℕ)) * L ^ (15 : ℕ) := by ring
    _ ≤ L * L ^ (15 : ℕ) := mul_le_mul_of_nonneg_right hlarge (by positivity)
    _ = L ^ (16 : ℕ) := by ring

end Bounty
end

section

/- The two scale comparisons required by the ordinary and sparse energies. -/

open Filter

namespace Bounty

theorem eventually_four_factor_residual_scale {beta d eta C : ℝ}
    (hbeta : beta < 1) (_hd : 0 < d) (heta : eta < (2 / 5 : ℝ) * d) (hC : 0 < C) :
    ∀ᶠ L : ℝ in atTop, ∀ Y P P' U : ℝ,
      0 < Y → 0 < P → 0 < P' → d * L ≤ Real.log Y →
      P ≤ Real.exp (L ^ beta) → P' ≤ Real.exp (eta * L) →
      Y / (C * P * P') ≤ U → Y ^ (3 / 5 : ℝ) ≤ U := by
  have hgap : 0 < (2 / 5 : ℝ) * d - eta := by linarith
  filter_upwards [eventually_mul_rpow_log_add_le_rpow zero_lt_one hbeta hgap 1 (Real.log C),
    Real.tendsto_log_atTop.eventually_ge_atTop 1, eventually_gt_atTop (0 : ℝ)]
    with L hbudget hlogL hL
  intro Y P P' U hY hP hP' hlogY hsmall hlarge hU
  simp only [one_mul, Real.rpow_one] at hbudget
  have hpow : L ^ beta ≤ L ^ beta * Real.log L :=
    le_mul_of_one_le_right (Real.rpow_nonneg hL.le beta) hlogL
  have hden : C * P * P' ≤ Y ^ (2 / 5 : ℝ) := by
    calc
      _ ≤ C * Real.exp (L ^ beta) * Real.exp (eta * L) := by gcongr
      _ = Real.exp (Real.log C + L ^ beta + eta * L) := by
        rw [Real.exp_add, Real.exp_add, Real.exp_log hC]
      _ ≤ Real.exp ((2 / 5 : ℝ) * (d * L)) := Real.exp_le_exp.mpr (by nlinarith)
      _ ≤ Real.exp ((2 / 5 : ℝ) * Real.log Y) := Real.exp_le_exp.mpr (by linarith)
      _ = Y ^ (2 / 5 : ℝ) := by rw [Real.rpow_def_of_pos hY]; congr 1; ring
  calc
    Y ^ (3 / 5 : ℝ) = Y / Y ^ (2 / 5 : ℝ) := by
      rw [show (3 / 5 : ℝ) = 1 - 2 / 5 by norm_num, Real.rpow_sub hY, Real.rpow_one]
    _ ≤ Y / (C * P * P') := div_le_div_of_nonneg_left hY.le (by positivity) hden
    _ ≤ U := hU

theorem eventually_four_factor_time_budget {beta gamma C : ℝ}
    (hgamma : 0 < gamma) (hbeta : beta < gamma) (hC : 0 < C) :
    ∀ᶠ L : ℝ in atTop, 2 * C * L * Real.exp (L ^ beta) ≤ Real.exp (L ^ gamma) := by
  have hmax : max beta 0 < gamma := max_lt hbeta hgamma
  filter_upwards [eventually_mul_rpow_log_add_le_rpow hgamma hmax zero_lt_one
    2 (Real.log (2 * C)), Real.tendsto_log_atTop.eventually_ge_atTop 1,
    eventually_ge_atTop (1 : ℝ)] with L hbudget hlogL hL
  simp only [one_mul] at hbudget
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hpow : L ^ beta ≤ L ^ max beta 0 :=
    Real.rpow_le_rpow_of_exponent_le hL (le_max_left _ _)
  have hone : 1 ≤ L ^ max beta 0 := Real.one_le_rpow hL (le_max_right _ _)
  have hmul : L ^ max beta 0 ≤ L ^ max beta 0 * Real.log L :=
    le_mul_of_one_le_right (Real.rpow_nonneg hL0.le _) hlogL
  have hlog : Real.log L ≤ L ^ max beta 0 * Real.log L := by nlinarith
  calc
    _ = Real.exp (Real.log (2 * C) + Real.log L + L ^ beta) := by
      rw [Real.exp_add, Real.exp_add, Real.exp_log (by positivity), Real.exp_log hL0]
    _ ≤ Real.exp (L ^ gamma) := Real.exp_le_exp.mpr (by linarith)

theorem eventually_four_factor_ordinary_scale {beta gamma C : ℝ}
    (hgamma : 0 < gamma) (hbeta : beta < gamma) (hC : 0 < C) :
    ∀ᶠ L : ℝ in atTop, ∀ Y P h U : ℝ,
      0 < Y → 0 < P → 0 < h → P ≤ Real.exp (L ^ beta) →
      Real.exp (L ^ gamma) ≤ Y * h → Y / (C * P) ≤ U → 2 * L / h ≤ U := by
  filter_upwards [eventually_four_factor_time_budget hgamma hbeta hC,
    eventually_ge_atTop (0 : ℝ)] with L hbudget hL
  intro Y P h U _hY hP hh hsmall hH hU
  have hprod : 2 * C * L * P ≤ Y * h := by
    calc
      _ ≤ 2 * C * L * Real.exp (L ^ beta) :=
        mul_le_mul_of_nonneg_left hsmall (by positivity)
      _ ≤ Real.exp (L ^ gamma) := hbudget
      _ ≤ Y * h := hH
  have hratio : 2 * L / h ≤ Y / (C * P) := by
    apply (div_le_div_iff₀ hh (mul_pos hC hP)).mpr
    nlinarith
  exact hratio.trans hU

end Bounty
end

section

/- Finite support turns a literal divisor convolution into an exact product box. -/

open Finset

namespace Bounty

theorem finite_divisor_convolution_box (A B : Finset ℕ) (α β : ℕ → ℂ)
    (hA : ∀ a ∈ A, 0 < a) (hB : ∀ b ∈ B, 0 < b)
    (hα : ∀ a, a ∉ A → α a = 0) (hβ : ∀ b, b ∉ B → β b = 0) (n : ℕ) :
    (∑ d ∈ n.divisors, α d*β (n/d)) =
      ∑ a ∈ A, ∑ b ∈ B, if a*b = n then α a*β b else 0 := by
  classical
  rw [← Nat.sum_divisorsAntidiagonal (fun a b => α a*β b)]
  rw [← sum_product A B (fun ab : ℕ × ℕ => if ab.1*ab.2 = n then α ab.1*β ab.2 else 0)]
  apply sum_bij_ne_zero (fun ab _ _ => ab)
  · intro ab hab hne
    apply mem_product.mpr
    constructor
    · by_contra hn
      exact hne (by rw [hα _ hn,zero_mul])
    · by_contra hn
      exact hne (by rw [hβ _ hn,mul_zero])
  · intro ab hab hne cd hcd hne' he
    exact he
  · intro ab hab hne
    have he : ab.1*ab.2 = n := by
      by_contra hh
      exact hne (if_neg hh)
    have hn : n ≠ 0 := by
      rw [← he]
      exact Nat.ne_of_gt (Nat.mul_pos (hA _ (mem_product.mp hab).1) (hB _ (mem_product.mp hab).2))
    exact ⟨ab,Nat.mem_divisorsAntidiagonal.mpr ⟨he,hn⟩,
      (by simpa only [if_pos he] using hne),rfl⟩
  · intro ab hab hne
    exact (if_pos (Nat.mem_divisorsAntidiagonal.mp hab).1).symm

theorem finite_divisor_convolution_support (A B : Finset ℕ) (α β : ℕ → ℂ)
    (hA : ∀ a ∈ A, 0 < a) (hB : ∀ b ∈ B, 0 < b)
    (hα : ∀ a, a ∉ A → α a = 0) (hβ : ∀ b, b ∉ B → β b = 0)
    (n : ℕ) (hn : n ∉ (A ×ˢ B).image (fun ab => ab.1*ab.2)) :
    (∑ d ∈ n.divisors, α d*β (n/d)) = 0 := by
  classical
  rw [finite_divisor_convolution_box A B α β hA hB hα hβ n]
  apply sum_eq_zero
  intro a ha
  apply sum_eq_zero
  intro b hb
  apply if_neg
  intro he
  exact hn (mem_image.mpr ⟨(a,b),mem_product.mpr ⟨ha,hb⟩,he⟩)

theorem finite_divisor_convolution_transform (S A B : Finset ℕ) (α β F : ℕ → ℂ)
    (hA : ∀ a ∈ A, 0 < a) (hB : ∀ b ∈ B, 0 < b)
    (hα : ∀ a, a ∉ A → α a = 0) (hβ : ∀ b, b ∉ B → β b = 0)
    (hS : ∀ a ∈ A, ∀ b ∈ B, a*b ∈ S) :
    (∑ n ∈ S, (∑ d ∈ n.divisors, α d*β (n/d))*F n) =
      ∑ a ∈ A, ∑ b ∈ B, α a*β b*F (a*b) := by
  classical
  simp_rw [finite_divisor_convolution_box A B α β hA hB hα hβ]
  simp only [sum_mul,ite_mul,zero_mul]
  rw [sum_comm]
  apply sum_congr rfl
  intro a ha
  rw [sum_comm]
  apply sum_congr rfl
  intro b hb
  rw [sum_eq_single (a*b)]
  · simp only [ite_true]
  · intro n hn hne
    exact if_neg (Ne.symm hne)
  · intro hn
    exact (hn (hS a ha b hb)).elim

end Bounty
end

section

/- An exact finite dyadic partition of a real-endpoint integer interval. -/

open Finset

namespace Bounty

theorem sum_finite_dyadic_intervals (U : ℝ) (hU : 0 ≤ U) (K : ℕ) (F : ℕ → ℂ) :
    (∑ j ∈ range K, ∑ n ∈ Ioc ⌊(2 : ℝ)^j*U⌋₊ ⌊(2 : ℝ)^(j+1)*U⌋₊, F n) =
      ∑ n ∈ Ioc ⌊U⌋₊ ⌊(2 : ℝ)^K*U⌋₊, F n := by
  induction K with
  | zero => simp only [range_zero,sum_empty,pow_zero,one_mul,Ioc_self]
  | succ K ih =>
    rw [sum_range_succ,ih]
    apply sum_Ioc_consecutive F
    · apply Nat.floor_le_floor
      exact le_mul_of_one_le_left hU (one_le_pow₀ (by norm_num))
    · apply Nat.floor_le_floor
      rw [pow_succ]
      nlinarith [mul_nonneg (pow_nonneg (by norm_num : (0 : ℝ) ≤ 2) K) hU]

theorem sum_finite_dyadic_closed_intervals (U : ℝ) (hU : 0 ≤ U) (K : ℕ) (F : ℕ → ℂ) :
    (∑ j : Fin K, ∑ n ∈ Icc (⌊(2 : ℝ)^j.val*U⌋₊+1) ⌊(2 : ℝ)^(j.val+1)*U⌋₊, F n) =
      ∑ n ∈ Ioc ⌊U⌋₊ ⌊(2 : ℝ)^K*U⌋₊, F n := by
  simp_rw [Icc_add_one_left_eq_Ioc]
  rw [Fin.sum_univ_eq_sum_range (fun j : ℕ => ∑ n ∈ Ioc ⌊(2 : ℝ)^j*U⌋₊ ⌊(2 : ℝ)^(j+1)*U⌋₊, F n) K]
  exact sum_finite_dyadic_intervals U hU K F

theorem finite_dyadic_interval_geometry {U : ℝ} (hU : 0 ≤ U) (j : ℕ) :
    (2 : ℝ)^j*U ≤ (⌊(2 : ℝ)^j*U⌋₊+1 : ℕ) ∧
      (⌊(2 : ℝ)^(j+1)*U⌋₊ : ℝ) ≤ 2*((2 : ℝ)^j*U) := by
  constructor
  · simpa only [Nat.cast_add,Nat.cast_one] using (Nat.lt_floor_add_one ((2 : ℝ)^j*U)).le
  · calc
      _ ≤ (2 : ℝ)^(j+1)*U := Nat.floor_le (by positivity)
      _ = _ := by rw [pow_succ]; ring

end Bounty
end

section

/- Exact clipping and long-scale bounds for an original candidate rough band. -/

open Finset Filter

namespace Bounty

theorem mem_roughBand_real_iff {A B W : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (n : ℕ) :
    n ∈ roughBand A B W ↔ A < (n : ℝ) ∧ (n : ℝ) ≤ B ∧
      ∀ p ∈ n.primeFactors, W < (p : ℝ) := by
  classical
  simp only [roughBand,mem_filter,mem_Ioc,Nat.floor_lt hA,Nat.le_floor_iff hB]
  tauto

theorem roughBand_filter_real_interval {A B U V W : ℝ}
    (hA : 0 ≤ A) (hB : 0 ≤ B) (_hU : 0 ≤ U) (hV : 0 ≤ V) :
    (roughBand A B W).filter (fun n : ℕ => U < (n : ℝ) ∧ (n : ℝ) ≤ V) =
      roughBand (max A U) (min B V) W := by
  classical
  ext n
  simp only [mem_filter,mem_roughBand_real_iff hA hB,
    mem_roughBand_real_iff (le_max_of_le_left hA) (le_min hB hV),max_lt_iff,le_min_iff]
  tauto

theorem eventually_candidate_rough_dyadic_scales {c aLong eta : ℝ}
    (hc : 0 < c) (Jlo Jhi : ℕ)
    (hLong : aLong < c/2^Jhi) (hShort : (6/5 : ℝ)*(c/2^Jlo) ≤ eta) :
    ∀ᶠ L : ℝ in atTop, ∀ j : ℕ, Jlo ≤ j → j ≤ Jhi → ∀ U : ℝ, 0 < U →
      ((candidateRoughBand c L j).filter (fun n : ℕ => U < (n : ℝ) ∧ (n : ℝ) ≤ 2*U)).Nonempty →
      Real.exp (aLong*L) ≤ U ∧ U ≤ Real.exp (eta*L) ∧
      U ≤ max (Real.exp (c*L/2^j)) U ∧
      max (Real.exp (c*L/2^j)) U ≤ min (Real.exp ((6/5 : ℝ)*c*L/2^j)) (2*U) ∧
      min (Real.exp ((6/5 : ℝ)*c*L/2^j)) (2*U) ≤ 2*U ∧
      (candidateRoughBand c L j).filter (fun n : ℕ => U < (n : ℝ) ∧ (n : ℝ) ≤ 2*U) =
        roughBand (max (Real.exp (c*L/2^j)) U)
          (min (Real.exp ((6/5 : ℝ)*c*L/2^j)) (2*U)) (Real.exp (Real.sqrt L)) := by
  classical
  have hgap : 0 < c/2^Jhi-aLong := sub_pos.mpr hLong
  filter_upwards [eventually_ge_atTop (Real.log 2/(c/2^Jhi-aLong)),
    eventually_ge_atTop (0 : ℝ)] with L hLgap hL
  intro j hjlo hjhi U hU hne
  obtain ⟨n,hn⟩ := hne
  obtain ⟨hnrough,hnlo,hnhi⟩ := mem_filter.mp hn
  have hnrange := roughBand_value_bounds (Real.exp_pos _).le (Real.exp_pos _).le hnrough
  have hjlower : c/2^Jhi ≤ c/2^j := by
    apply div_le_div_of_nonneg_left hc.le (by positivity)
    exact pow_le_pow_right₀ (by norm_num) hjhi
  have hjupper : c/2^j ≤ c/2^Jlo := by
    apply div_le_div_of_nonneg_left hc.le (by positivity)
    exact pow_le_pow_right₀ (by norm_num) hjlo
  have hlower : (c/2^Jhi)*L ≤ c*L/2^j := by
    calc
      _ ≤ (c/2^j)*L := mul_le_mul_of_nonneg_right hjlower hL
      _ = _ := by ring
  have hupper : (6/5 : ℝ)*c*L/2^j ≤ eta*L := by
    have hh : (6/5 : ℝ)*(c/2^j) ≤ eta :=
      (mul_le_mul_of_nonneg_left hjupper (by norm_num)).trans hShort
    calc
      _ = ((6/5 : ℝ)*(c/2^j))*L := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_right hh hL
  have hgapL : Real.log 2 ≤ (c/2^Jhi-aLong)*L := by
    have hh := (div_le_iff₀ hgap).mp hLgap
    nlinarith only [hh]
  have hexp : 2*Real.exp (aLong*L) ≤ Real.exp ((c/2^Jhi)*L) := by
    calc
      _ = Real.exp (Real.log 2+aLong*L) := by
        rw [Real.exp_add,Real.exp_log (by norm_num : (0 : ℝ) < 2)]
      _ ≤ _ := Real.exp_le_exp.mpr (by nlinarith only [hgapL])
  have hnlarge : 2*Real.exp (aLong*L) < (n : ℝ) :=
    (hexp.trans (Real.exp_le_exp.mpr hlower)).trans_lt hnrange.1
  refine ⟨by linarith,hnlo.le.trans (hnrange.2.trans (Real.exp_le_exp.mpr hupper)),
    le_max_right _ _,?_,min_le_right _ _,?_⟩
  · exact (max_lt hnrange.1 hnlo).le.trans (le_min hnrange.2 hnhi)
  · exact roughBand_filter_real_interval (Real.exp_pos _).le (Real.exp_pos _).le hU.le (by positivity)

end Bounty
end

section

/- A logarithmic saving chosen before the slot controls the required relative mass error. -/

open Filter
namespace Bounty

theorem exists_candidate_error_mass_exponent {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ)*(r : ℝ)*c = 1) :
    ∃ D : ℝ, 0 ≤ D ∧ ∃ J : ℕ, ∀ jStar : ℕ, J < jStar →
      ∀ᶠ L : ℝ in atTop, ∀ e : ℝ,
        |e| ≤ Real.exp L * L^(-D) →
        |e| ≤ candidateCoefficientWindowMass c L q r jStar * L^(-2 : ℝ) := by
  obtain ⟨C, hC, J, hmass⟩ := exists_candidate_coefficient_mass_polynomial_lower hc hr hq0 hq1 hcenter
  refine ⟨C+2, by linarith, J, ?_⟩
  intro jStar hj
  filter_upwards [hmass jStar hj,eventually_gt_atTop (0 : ℝ)] with L hmass hL
  intro e he
  apply he.trans
  calc
    _ = (Real.exp L * L^(-C))*L^(-2 : ℝ) := by
      rw [mul_assoc,← Real.rpow_add hL]
      congr 2
      ring
    _ ≤ _ := mul_le_mul_of_nonneg_right hmass (by positivity)

end Bounty
end

section

/- Summation of pointwise pair errors against their actual weighted endpoint
energies. The original finite set and weight are retained. -/

open Finset
namespace Bounty

theorem finite_weighted_pair_error {I : Type*} (s : Finset I)
    (μ W0 W1 : I → ℝ) (f g e : I → ℂ) {ε : ℝ}
    (hμ : ∀ i ∈ s, 0 ≤ μ i) (hε : 0 ≤ ε)
    (he : ∀ i ∈ s, ‖e i‖ ≤ W0 i * W1 i * ε) :
    ‖∑ i ∈ s, (μ i : ℂ) * (starRingEnd ℂ) (f i) * g i * e i‖ ≤
      ε * Real.sqrt (∑ i ∈ s, μ i * (W0 i * ‖f i‖)^2) *
        Real.sqrt (∑ i ∈ s, μ i * (W1 i * ‖g i‖)^2) := by
  have hc := Real.sum_mul_le_sqrt_mul_sqrt s
    (fun i => Real.sqrt (μ i) * (W0 i * ‖f i‖))
    (fun i => Real.sqrt (μ i) * (W1 i * ‖g i‖))
  have hs0 : (∑ i ∈ s, (Real.sqrt (μ i) * (W0 i * ‖f i‖))^2) =
      ∑ i ∈ s, μ i * (W0 i * ‖f i‖)^2 := by
    apply sum_congr rfl
    intro i hi
    rw [mul_pow, Real.sq_sqrt (hμ i hi)]
  have hs1 : (∑ i ∈ s, (Real.sqrt (μ i) * (W1 i * ‖g i‖))^2) =
      ∑ i ∈ s, μ i * (W1 i * ‖g i‖)^2 := by
    apply sum_congr rfl
    intro i hi
    rw [mul_pow, Real.sq_sqrt (hμ i hi)]
  rw [hs0, hs1] at hc
  calc
    _ ≤ ∑ i ∈ s, ‖(μ i : ℂ) * (starRingEnd ℂ) (f i) * g i * e i‖ := norm_sum_le _ _
    _ ≤ ε * ∑ i ∈ s, (Real.sqrt (μ i) * (W0 i * ‖f i‖)) *
        (Real.sqrt (μ i) * (W1 i * ‖g i‖)) := by
      rw [mul_sum]
      apply sum_le_sum
      intro i hi
      rw [norm_mul, norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (hμ i hi), Complex.norm_conj]
      calc
        _ ≤ μ i * ‖f i‖ * ‖g i‖ * (W0 i * W1 i * ε) :=
          mul_le_mul_of_nonneg_left (he i hi)
            (mul_nonneg (mul_nonneg (hμ i hi) (norm_nonneg _)) (norm_nonneg _))
        _ = (Real.sqrt (μ i))^2 * ‖f i‖ * ‖g i‖ * (W0 i * W1 i * ε) := by
          rw [Real.sq_sqrt (hμ i hi)]
        _ = _ := by ring
    _ ≤ _ := by simpa only [mul_assoc] using mul_le_mul_of_nonneg_left hc hε

theorem finite_weighted_pair_difference {I : Type*} (s : Finset I)
    (μ W0 W1 : I → ℝ) (f g A B : I → ℂ) {ε : ℝ}
    (hμ : ∀ i ∈ s, 0 ≤ μ i) (hε : 0 ≤ ε)
    (he : ∀ i ∈ s, ‖A i - B i‖ ≤ W0 i * W1 i * ε) :
    ‖(∑ i ∈ s, (μ i : ℂ) * (starRingEnd ℂ) (f i) * g i * A i) -
      (∑ i ∈ s, (μ i : ℂ) * (starRingEnd ℂ) (f i) * g i * B i)‖ ≤
      ε * Real.sqrt (∑ i ∈ s, μ i * (W0 i * ‖f i‖)^2) *
        Real.sqrt (∑ i ∈ s, μ i * (W1 i * ‖g i‖)^2) := by
  simpa only [mul_sub, sum_sub_distrib] using
    finite_weighted_pair_error s μ W0 W1 f g (fun i => A i - B i) hμ hε he

end Bounty
end

section

/- A local phase with a deterministic auxiliary state is a phase on the
original event path. Its state updates add no path multiplicity. -/

namespace Bounty
section Phase
variable {K L X : Type*} (E : K → X → Type*)
  (target : ∀ k x, E k x → X) (update : ∀ k, L → (x : X) → E k x → L)
  (phase : ∀ k, L → (x : X) → E k x → ℂ)

def deterministicLedgerPhase : ∀ ks, L → (x : X) → FiniteEventPath E target ks x → ℂ
  | [], _, _, _ => 1
  | k :: ks, l, x, ⟨e, p⟩ =>
      phase k l x e * deterministicLedgerPhase ks (update k l x e) (target k x e) p

theorem deterministic_ledger_phase_eq_lifted (ks : List K) (l : L) (x : X)
    (p : FiniteEventPath E target ks x) :
    deterministicLedgerPhase E target update phase ks l x p =
      finiteEventLocalPhase (fun k (s : L × X) => E k s.2)
        (finiteLedgerEventTarget E target update) (fun k s => phase k s.1 s.2)
        ks (l, x) ((finiteLedgerEventPathEquiv E target update ks l x).symm p) := by
  induction ks generalizing l x with
  | nil => rfl
  | cons k ks ih =>
    rcases p with ⟨e, p⟩
    exact congrArg (phase k l x e * ·) (ih (update k l x e) (target k x e) p)

end Phase
end Bounty
end

section

/- The memory scalar is independent of presentations of the same finite type. -/

namespace Bounty

theorem physical_memory_labeled_scalar_instances
    {G I : Type*} (f₁ f₂ : Fintype G) (d₁ d₂ : DecidableEq G)
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (ζ : I → ℝ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (L R : PhysicalMarkLists P J ell) :
    @physicalMemoryLabeledScalar G I f₁ d₁ P J ell V patterns C ζ K a L R =
    @physicalMemoryLabeledScalar G I f₂ d₂ P J ell V patterns C ζ K a L R := by
  cases Subsingleton.elim f₁ f₂
  cases Subsingleton.elim d₁ d₂
  rfl

theorem physical_aux_mass_instances {G : Type*} (f₁ f₂ : Fintype G)
    {P : G → Finset ℕ} {J : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (a : PhysicalAuxLabels P C) :
    @physicalAuxMass G f₁ P J V C a = @physicalAuxMass G f₂ P J V C a := by
  cases Subsingleton.elim f₁ f₂
  rfl

end Bounty
