/- Replace the original sharp candidate sum by an actual finite-frequency Mellin integral. -/

open Finset Filter MeasureTheory Real

namespace Bounty

theorem exists_candidate_sharp_window_mellin_bound {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1) (A D : ℝ) :
    ∃ B : ℝ, 1 ≤ B ∧ ∃ K : ℝ, 0 < K ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (jStar : ℕ) (F : ℕ → ℕ → ℂ),
      (∀ u, ∀ m ∈ (2*u+1).divisors, ‖F u m‖ ≤ L^A) →
      Integrable (candidateWindowMellinIntegrand c L q r jStar B F) ∧
      ‖(∑ u ∈ arithmeticProductWindow 1 (exp L),
          (candidateCoefficient c L q r jStar u : ℂ) *
            (∑ m ∈ (2*u+1).divisors, F u m)) -
        (∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ L^K}, candidateWindowMellinIntegrand c L q r jStar B F ξ)‖ ≤
          exp L * L^(-D) := by
  obtain ⟨B, hB, hsmooth⟩ := exists_candidate_actual_window_smoothing_error_bound
    hc hr hq0 hq1 A (D+1)
  obtain ⟨K, hK, htrunc⟩ := exists_candidate_smooth_window_truncation_bound
    hc hr hq0 hq1 B (by linarith) A (D+1)
  refine ⟨B, hB, K, hK, ?_⟩
  filter_upwards [hsmooth, htrunc, eventually_ge_atTop (2 : ℝ)] with L hsL htL hL
  intro jStar F hF
  refine ⟨candidate_window_mellin_integrable c L q r jStar B F, ?_⟩
  have hs := hsL jStar (candidateWindowBox L) F (arithmetic_window_subset_candidate_window_box L) hF
  have ht := htL jStar F (fun u _ m hm => hF u m hm)
  have hL0 : 0 < L := by linarith
  calc
    _ ≤ ‖(∑ u ∈ arithmeticProductWindow 1 (exp L),
          (candidateCoefficient c L q r jStar u : ℂ) * (∑ m ∈ (2*u+1).divisors, F u m)) -
        (∑ u ∈ candidateWindowBox L, (candidateCoefficient c L q r jStar u : ℂ) *
          (typeIIWindowSmooth (L^(-B)) ((u:ℝ)/exp L) : ℂ) * (∑ m ∈ (2*u+1).divisors, F u m))‖ +
      ‖(∑ u ∈ candidateWindowBox L, (candidateCoefficient c L q r jStar u : ℂ) *
          (typeIIWindowSmooth (L^(-B)) ((u:ℝ)/exp L) : ℂ) * (∑ m ∈ (2*u+1).divisors, F u m)) -
        (∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ L^K}, candidateWindowMellinIntegrand c L q r jStar B F ξ)‖ :=
      norm_sub_le_norm_sub_add_norm_sub _ _ _
    _ ≤ exp L*L^(-(D+1)) + exp L*L^(-(D+1)) := add_le_add hs ht
    _ = 2*(exp L*L^(-(D+1))) := by ring
    _ ≤ L*(exp L*L^(-(D+1))) := mul_le_mul_of_nonneg_right hL (by positivity)
    _ = exp L*(L^(1:ℝ)*L^(-(D+1))) := by rw [rpow_one]; ring
    _ = exp L*L^(-D) := by rw [← rpow_add hL0]; congr 2; ring

theorem exists_candidate_factorization_sharp_window_mellin_bound {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1) (A D : ℝ) :
    ∃ B : ℝ, 1 ≤ B ∧ ∃ K : ℝ, 0 < K ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (jStar : ℕ) (α β : ℕ → ℂ),
      (∀ m, ‖α m‖ ≤ L^A) → (∀ n, ‖β n‖ ≤ L^A) →
      Integrable (candidateWindowMellinIntegrand c L q r jStar B
        (fun u m => α m * β ((2*u+1)/m))) ∧
      ‖(∑ u ∈ arithmeticProductWindow 1 (exp L),
          (candidateCoefficient c L q r jStar u : ℂ) *
            (∑ m ∈ (2*u+1).divisors, α m * β ((2*u+1)/m))) -
        (∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ L^K}, candidateWindowMellinIntegrand c L q r jStar B
          (fun u m => α m * β ((2*u+1)/m)) ξ)‖ ≤ exp L * L^(-D) := by
  obtain ⟨B, hB, K, hK, hbound⟩ := exists_candidate_sharp_window_mellin_bound hc hr hq0 hq1 (2*A) D
  refine ⟨B, hB, K, hK, ?_⟩
  filter_upwards [hbound, eventually_gt_atTop (0 : ℝ)] with L hL hL0
  intro jStar α β hα hβ
  apply hL jStar (fun u m => α m * β ((2*u+1)/m))
  intro u m hm
  rw [norm_mul, show 2*A = A+A by ring, rpow_add hL0]
  exact mul_le_mul (hα m) (hβ _) (norm_nonneg _) (rpow_nonneg hL0.le _)

end Bounty
end

section

/- Reciprocal square mass has an exponential saving over harmonic prime mass. -/

open Finset Filter

namespace Bounty

theorem finite_reciprocal_square_sum_le (P : Finset ℕ) {M : ℝ}
    (hM : 0 < M) (hP : ∀ p ∈ P, M ≤ (p : ℝ)) :
    (∑ p ∈ P, 1 / (p : ℝ) ^ 2) ≤ (1 / M) * ∑ p ∈ P, 1 / (p : ℝ) := by
  rw [mul_sum]
  apply sum_le_sum
  intro p hp
  calc
    1 / (p : ℝ) ^ 2 = (1 / (p : ℝ)) * (1 / (p : ℝ)) := by ring
    _ ≤ (1 / M) * (1 / (p : ℝ)) :=
      mul_le_mul_of_nonneg_right (one_div_le_one_div_of_le hM (hP p hp)) (by positivity)

theorem eventually_weighted_reciprocal_squares_le {a : ℝ}
    (ha : 0 < a) (C D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (P : Finset ℕ) (H : ℝ), 0 ≤ H →
      H * (∑ p ∈ P, 1 / (p : ℝ)) ≤ L ^ C →
      (∀ p ∈ P, Real.exp (L ^ a) ≤ (p : ℝ)) →
      H * (∑ p ∈ P, 1 / (p : ℝ) ^ 2) ≤ L ^ (-D) := by
  filter_upwards [eventually_rpow_mul_exp_neg_rpow_le ha C D] with L hL
  intro P H hH hmass hP
  calc
    _ ≤ H * ((1 / Real.exp (L ^ a)) * ∑ p ∈ P, 1 / (p : ℝ)) :=
      mul_le_mul_of_nonneg_left (finite_reciprocal_square_sum_le P (Real.exp_pos _) hP) hH
    _ = (H * (∑ p ∈ P, 1 / (p : ℝ))) * Real.exp (-(L ^ a)) := by
      rw [Real.exp_neg]; ring
    _ ≤ L ^ C * Real.exp (-(L ^ a)) :=
      mul_le_mul_of_nonneg_right hmass (Real.exp_pos _).le
    _ ≤ _ := hL

end Bounty
end

section

open MeasureTheory

namespace Bounty

theorem exists_local_fourier_mellin_energy_constants {j : ℕ} (hj : 2 ≤ j) :
    ∃ Cj Cerr : ℝ, 0 < Cj ∧ 0 < Cerr ∧
      ∀ (S : Finset ℕ) (a : ℕ → ℂ) (Y H : ℝ),
      0 < Y → 1 ≤ H → H ≤ Y/8 →
      (∀ n ∈ S, Y ≤ (n:ℝ) ∧ (n:ℝ) ≤ 2*Y) →
      (∫ β in {β : ℝ | |β| ≤ 1/H}, ‖localAdditivePolynomial S a β‖^2) ≤
        (Cj/Y) * (∫ t : ℝ, (1+|(H/Y)*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2) +
          Cerr * (H/Y)^2 * (∑ n ∈ S, ‖a n‖^2) := by
  obtain ⟨Cj, hCj, hmellin⟩ := exists_local_log_mellin_energy_constant hj
  obtain ⟨Cerr, hCerr, hadd⟩ := exists_local_fourier_log_energy_constant
  refine ⟨24*Cj, Cerr, by positivity, hCerr, ?_⟩
  intro S a Y H hY hH hsmall hS
  have hHp : 0 < H := lt_of_lt_of_le zero_lt_one hH
  have hSpos : ∀ n ∈ S, 0 < n := by
    intro n hn
    exact_mod_cast hY.trans_le (hS n hn).1
  have hlog := hmellin S a hSpos (H/Y) Y (div_pos hHp hY) hY
  have hHY : H/Y*Y = H := div_mul_cancel₀ H hY.ne'
  rw [hHY] at hlog
  calc
    _ ≤ (8/H^2) * (∫ v in Set.Icc (Y/2) (3*Y), ‖localLogConvolution S a H v‖^2) +
        Cerr * (H/Y)^2 * (∑ n ∈ S, ‖a n‖^2) := hadd S a Y H hY hH hsmall hS
    _ ≤ (8/H^2) * (3*Y*(H/Y)^2*Cj *
        ∫ t : ℝ, (1+|(H/Y)*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2) +
        Cerr * (H/Y)^2 * (∑ n ∈ S, ‖a n‖^2) := by
      exact add_le_add (mul_le_mul_of_nonneg_left hlog (by positivity : 0 ≤ 8/H^2)) le_rfl
    _ = _ := by
      have hc : (8/H^2)*(3*Y*(H/Y)^2*Cj) = 24*Cj/Y := by
        field_simp
        ring
      rw [← mul_assoc, hc]

end Bounty
end

section

/- Seeded chronological history agrees exactly with all original common birth labels already owned by the past. -/

open Classical
namespace Bounty
section History
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ) (steps : List (Option (J ⊕ K)))

noncomputable def fullMixedCommonPathHistory
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps s)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P))
    (t : ℕ) (i : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps))) : Option (Sigma P) :=
  if (fullMixedCommonIndexStage M B steps i).val ≤ t then
    fullMixedCommonBirthLabel n S B A Δ D steps s p (fullMixedCommonBirthOrder M B steps i)
  else history i

theorem full_mixed_common_path_history_zero
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps s)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P)) :
    fullMixedCommonPathHistory n S B A Δ D steps s p history 0 =
      fullMixedCommonHistorySeed n B steps s history := by
  funext i
  obtain ⟨a, rfl⟩ := (fullMixedCommonBirthOrder M B steps).symm.surjective i
  cases a <;>
    simp [fullMixedCommonPathHistory, fullMixedCommonHistorySeed, fullMixedCommonIndexStage,
      full_mixed_common_initial_label]

theorem full_mixed_common_path_history_complete
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps s)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P)) :
    fullMixedCommonPathHistory n S B A Δ D steps s p history steps.length =
      fun i => fullMixedCommonBirthLabel n S B A Δ D steps s p (fullMixedCommonBirthOrder M B steps i) := by
  funext i
  exact if_pos (Nat.le_of_lt_succ (fullMixedCommonIndexStage M B steps i).isLt)

theorem full_mixed_common_path_history_write
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps s)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P))
    (u : Fin steps.length) :
    fullMixedCommonHistoryWrite n S B A Δ D steps u
      (fullMixedOwnerOccurrence n S B A Δ D steps s p u).1
      (fullMixedOwnerOccurrence n S B A Δ D steps s p u).2
      (fullMixedCommonPathHistory n S B A Δ D steps s p history u.val) =
      fullMixedCommonPathHistory n S B A Δ D steps s p history (u.val + 1) := by
  funext i
  obtain ⟨a, rfl⟩ := (fullMixedCommonBirthOrder M B steps).symm.surjective i
  cases a with
  | inl a =>
    simp [fullMixedCommonHistoryWrite, fullMixedCommonAddressWrite,
      fullMixedCommonPathHistory, fullMixedCommonIndexStage]
  | inr a =>
    rcases a with ⟨v, a⟩
    by_cases hv : v = u
    · subst v
      rw [full_mixed_common_history_write_here]
      simp only [fullMixedCommonPathHistory, fullMixedCommonIndexStage,
        Equiv.apply_symm_apply, Fin.val_succ, le_refl, if_true, full_mixed_common_new_label]
      exact (full_mixed_common_path_label_occurrence n S B A Δ D steps s p u a).symm
    · rw [full_mixed_common_history_write_other n S B A Δ D steps u _ _ _ _ (by
        simpa only [Equiv.apply_symm_apply, fullMixedCommonOwner, ne_eq, Option.some.injEq] using hv)]
      simp only [fullMixedCommonPathHistory, fullMixedCommonIndexStage, Equiv.apply_symm_apply, Fin.val_succ]
      have hval : v.val ≠ u.val := fun h => hv (Fin.ext h)
      by_cases h : v.val + 1 ≤ u.val
      · have h' : v.val + 1 ≤ u.val + 1 := by omega
        simp only [if_pos h, if_pos h']
      · have h' : ¬v.val + 1 ≤ u.val + 1 := by omega
        simp only [if_neg h, if_neg h']

end History
end Bounty
end

section

/- A uniform first-derivative kernel estimate including zero frequency. -/

open Finset

namespace Bounty

theorem logarithmic_low_frequency_kernel (a b : ℕ) (U t : ℝ)
    (hU : 1 ≤ U) (ha : U ≤ (a : ℝ)) (hab : a ≤ b) (hb : (b : ℝ) ≤ 2*U)
    (htmax : |t| ≤ U) :
    ‖∑ n ∈ Icc a b, Complex.exp ((t*Real.log (n : ℝ) : ℝ)*Complex.I)‖ ≤
      24*Real.pi*U/(1+|t|) := by
  have hUp : 0 < U := lt_of_lt_of_le (by norm_num) hU
  have hden : 0 < 1+|t| := by positivity
  by_cases hsmall : |t| ≤ 1
  · exact (norm_nat_log_phase_small a b U t hU ha hb hsmall).trans
      (div_le_div_of_nonneg_right
        (mul_le_mul_of_nonneg_right (by nlinarith [Real.pi_gt_three] : (4 : ℝ) ≤ 24*Real.pi)
          hUp.le) hden.le)
  · have ht1 : 1 < |t| := lt_of_not_ge hsmall
    have htp : 0 < |t| := lt_trans (by norm_num) ht1
    have htne : t ≠ 0 := abs_pos.mp htp
    calc
      _ ≤ 12*Real.pi*U/|t| := nat_logarithmic_first_derivative a b U t hU ha hab hb htne htmax
      _ ≤ 24*Real.pi*U/(1+|t|) := by
        apply (div_le_div_iff₀ htp hden).mpr
        have hh := mul_le_mul_of_nonneg_left (show 1+|t| ≤ 2*|t| by linarith)
          (show 0 ≤ 12*Real.pi*U by positivity)
        nlinarith

end Bounty
end

section

/- Actual logarithmic phase cancellation in each derivative-order frequency band. -/

open Finset

namespace Bounty

theorem exists_affine_logarithmic_derivative_band_bound (k : ℕ) (C : ℝ)
    (hk : 2 ≤ k) (hC : 1 ≤ C) :
    ∃ D : ℝ, 0 < D ∧ ∀ (N ε q c u : ℝ) (a b : ℤ),
      1 ≤ N → 0 ≤ ε → ε ≤ 1 → (k : ℝ)^2 ≤ N →
      2 ≤ N^(ε/(2*(k : ℝ))) → 0 < q →
      N^((k : ℝ)-2+ε) ≤ |u| → |u| ≤ N^((k : ℝ)-ε) →
      N ≤ (a : ℝ)+c/q → (b : ℝ)+1+c/q ≤ C*N →
      ‖∑ n ∈ Icc a b, Complex.exp (((u*Real.log (q*(n : ℝ)+c) : ℝ) : ℂ)*Complex.I)‖ ≤
        D*N*N^(-(ε/((k : ℝ)*(2:ℝ)^(k-1)))) := by
  obtain ⟨T0,hT0,hterm⟩ := exists_mixed_terminal_power_saving k (C+5) hk (by linarith)
  let R := max 4 T0
  have hR : 4 ≤ R := le_max_left _ _
  have hRp : 0 < R := by linarith
  have hCp : 0 < C := by linarith
  refine ⟨(C+2)*5^(k-2)*R,by positivity,?_⟩
  intro N ε q c u a b hN hε hε1 hkN hpow hq hu0 hu1 ha hb
  let A := logarithmicAmbientLeft N (c/q)
  let B := logarithmicAmbientRight N C (c/q)
  let M : ℝ := ((B-A+1 : ℤ) : ℝ)
  let H : ℤ := (Nat.floor (N^(ε/(2*(k : ℝ)))) : ℤ)
  let T := T0*N^(-ε/4)
  have hAB : A ≤ B := logarithmic_ambient_order N C (c/q)
  have hM : N ≤ M ∧ M ≤ (C+2)*N := logarithmic_ambient_length_bounds N C (c/q) hN hC
  have hMp : 0 < M := by linarith
  have hH := logarithmic_floor_shift_bounds N ε k hN hε1 hk hpow
  have hHN : H ≤ B-A+1 := by
    have hh : (H : ℝ) ≤ M := by exact hH.2.trans hM.1
    dsimp only [M] at hh
    exact_mod_cast hh
  have hT : 0 ≤ T := by dsimp [T]; positivity
  have hterminal : ∀ hs : List ℤ, hs.length = k-2 →
      (∀ h ∈ hs, 1 ≤ h ∧ h < H) → ∀ l r : ℤ, A ≤ l → r ≤ B →
      ‖∑ n ∈ Icc l r, Complex.exp
        ((mixedForwardDifference (hs.map (fun h : ℤ => (h : ℝ)))
          (fun y => u*Real.log (q*y+c)) (n : ℝ) : ℂ)*Complex.I)‖ ≤ M*T := by
    intro hs hlen hshifts l r hl hr
    by_cases hlr : l ≤ r
    · have hmap : ∀ h ∈ hs.map (fun h : ℤ => (h : ℝ)),
          1 ≤ h ∧ h ≤ (Nat.floor (N^(ε/(2*(k : ℝ)))) : ℝ) := by
        intro h hh
        obtain ⟨z,hz,rfl⟩ := List.mem_map.mp hh
        have hz' := hshifts z hz
        dsimp only [H] at hz'
        constructor
        · exact_mod_cast hz'.1
        · exact_mod_cast hz'.2.le
      have hsum := logarithmic_shift_sum_le_scale N ε k hs hN hε1 hk hkN hlen
        (fun h hh => (hshifts h hh).2.le)
      have hbox : ∀ x ∈ Set.Icc (l : ℝ) ((r : ℝ)+1),
          N ≤ x+c/q ∧ x+c/q+(hs.map (fun h : ℤ => (h : ℝ))).sum ≤ (C+5)*N := by
        intro x hx
        have hlR : (A : ℝ) ≤ (l : ℝ) := by exact_mod_cast hl
        have hrR : (r : ℝ) ≤ (B : ℝ) := by exact_mod_cast hr
        exact logarithmic_ambient_box N C (c/q) _ x hN hC hsum
          ⟨hlR.trans hx.1,by linarith [hx.2]⟩
      have ht := hterm N ε (hs.map (fun h : ℤ => (h : ℝ))) q c u l r hN hε
        (by simpa only [List.length_map] using hlen) hmap hu0 hu1 hq hlr hbox
      calc
        _ ≤ T0*N*N^(-ε/4) := ht
        _ = N*T := by dsimp [T]; ring
        _ ≤ M*T := mul_le_mul_of_nonneg_right hM.1 hT
    · rw [Icc_eq_empty_of_lt (lt_of_not_ge hlr),sum_empty,norm_zero]
      exact mul_nonneg hMp.le hT
  obtain ⟨haA,hbB⟩ := logarithmic_ambient_interval_contains N C (c/q) a b hN hC ha hb
  have hi := integer_phase_iterated_van_der_corput A B H (k-2) T
    (fun y => u*Real.log (q*y+c)) hAB hH.1 hHN hT hterminal a b haA hbB
  have hTR : T ≤ R*N^(-(ε/4)) := by
    dsimp [T]
    rw [show -ε/4 = -(ε/4) by ring]
    have htR : T0 ≤ R := le_max_right _ _
    exact mul_le_mul_of_nonneg_right htR (by positivity)
  have hs := derivative_order_scalar_power_saving T R N ε k hN
    (by by_contra he; have he0 : ε = 0 := le_antisymm (le_of_not_gt he) hε
        simp only [he0,zero_div,Real.rpow_zero] at hpow; linarith) hk hR hpow hTR
  rw [derivative_decay_exponent_eq ε k hk] at hs
  have hs' : vanDerCorputScalarBound (H : ℝ) T (k-2) ≤
      5^(k-2)*R*N^(-(ε/((k : ℝ)*(2:ℝ)^(k-1)))) := by
    simpa only [H,Int.cast_natCast] using hs
  calc
    _ ≤ M*vanDerCorputScalarBound (H : ℝ) T (k-2) := hi
    _ ≤ M*(5^(k-2)*R*N^(-(ε/((k : ℝ)*(2:ℝ)^(k-1))))) :=
      mul_le_mul_of_nonneg_left hs' hMp.le
    _ ≤ ((C+2)*N)*(5^(k-2)*R*N^(-(ε/((k : ℝ)*(2:ℝ)^(k-1))))) :=
      mul_le_mul_of_nonneg_right hM.2 (by positivity)
    _ = _ := by ring

end Bounty
end

section

/- The actual exceptional interval count absorbs the square-root sparse-kernel
error for a residual dyad of size at least Y^(3/5). -/

open Filter

namespace Bounty

theorem prime_exceptional_time_span_le {R Y : ℝ} (hR : 0 ≤ R) (hRY : R ≤ Y)
    (hY : 2 ≤ Y) : ((2 * ⌈R⌉₊ + 2 : ℕ) : ℝ) ≤ 4 * Y := by
  push_cast
  have hc := Nat.ceil_lt_add_one hR
  linarith

theorem sparse_cardinality_square_root_absorption {C Y U : ℝ} {N : ℕ}
    (hY : 0 < Y) (_hC : 0 ≤ C) (hcard : C ≤ Y ^ (1 / 20 : ℝ))
    (hN : (N : ℝ) ≤ 4 * Y) (hconstant : 432 ≤ Y ^ (1 / 20 : ℝ))
    (hU : Y ^ (3 / 5 : ℝ) ≤ U) : C * (216 * Real.sqrt N) ≤ U := by
  have hsqrt : Real.sqrt N ≤ 2 * Real.sqrt Y := by
    calc
      _ ≤ Real.sqrt (4 * Y) := Real.sqrt_le_sqrt hN
      _ = 2 * Real.sqrt Y := by rw [Real.sqrt_mul (by norm_num : (0 : ℝ) ≤ 4)]; norm_num
  calc
    C * (216 * Real.sqrt N) ≤ Y ^ (1 / 20 : ℝ) * (216 * (2 * Real.sqrt Y)) :=
      mul_le_mul hcard (mul_le_mul_of_nonneg_left hsqrt (by norm_num))
        (by positivity) (Real.rpow_nonneg hY.le _)
    _ = 432 * (Y ^ (1 / 20 : ℝ) * Y ^ (1 / 2 : ℝ)) := by
      rw [Real.sqrt_eq_rpow]; ring
    _ ≤ Y ^ (1 / 20 : ℝ) * (Y ^ (1 / 20 : ℝ) * Y ^ (1 / 2 : ℝ)) :=
      mul_le_mul_of_nonneg_right hconstant (by positivity)
    _ = Y ^ (3 / 5 : ℝ) := by rw [← Real.rpow_add hY, ← Real.rpow_add hY]; norm_num
    _ ≤ U := hU

theorem eventually_constant_le_rpow_of_log_lower {d ε K : ℝ}
    (hd : 0 < d) (hε : 0 < ε) (hK : 0 < K) :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, 0 < Y → d * L ≤ Real.log Y → K ≤ Y ^ ε := by
  filter_upwards [eventually_ge_atTop (Real.log K / (ε * d))] with L hL
  intro Y hY hlog
  have hscale : Real.log K ≤ (ε * d) * L := by
    have hh := (div_le_iff₀ (mul_pos hε hd)).mp hL
    nlinarith only [hh]
  calc
    K = Real.exp (Real.log K) := (Real.exp_log hK).symm
    _ ≤ Real.exp (Real.log Y * ε) := Real.exp_le_exp.mpr (by
      have hh := mul_le_mul_of_nonneg_left hlog hε.le
      nlinarith only [hscale, hh])
    _ = Y ^ ε := (Real.rpow_def_of_pos hY _).symm

theorem eventually_prime_exceptional_sparse_absorption
    {a beta c A B d : ℝ}
    (ha : 0 < a) (ha1 : a ≤ 1) (hbeta : beta < 1) (hc : 0 ≤ c) (hA : 0 ≤ A)
    (hB : 1 ≤ B) (hd : 0 < d) :
    ∀ᶠ L : ℝ in atTop, ∀ (s : Finset ℕ), (∀ p ∈ s, Nat.Prime p) →
      ∀ (coeff : s → ℂ) (Y P R U : ℝ),
      1 ≤ Y → d * L ≤ Real.log Y → Real.log Y ≤ c * L →
      Real.exp (L ^ a) / 2 ≤ P → P ≤ Real.exp (L ^ beta) →
      0 ≤ R → R ≤ Y →
      (∀ p ∈ s, P ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2 * P) →
      (∀ p : s, ‖coeff p‖ ≤ B) → Y ^ (3 / 5 : ℝ) ≤ U →
      ((primeExceptionalIntervals s coeff (L ^ (-A)) R).card : ℝ) *
        (216 * Real.sqrt (2 * ⌈R⌉₊ + 2 : ℕ)) ≤ U := by
  filter_upwards [eventually_prime_exceptional_bounded_coefficients_subpower
    ha ha1 hbeta hc hA hB hd (by norm_num : (0 : ℝ) < 1 / 20),
    eventually_constant_le_rpow_of_log_lower hd (by norm_num : (0 : ℝ) < 1 / 20)
      (by norm_num : (0 : ℝ) < 432),
    eventually_constant_le_rpow_of_log_lower hd zero_lt_one (by norm_num : (0 : ℝ) < 2)]
      with L hcount hconstant htwo
  intro s hs coeff Y P R U hY hlo hhi hPlo hPhi hR hRY hband hcoeff hU
  have hY0 : 0 < Y := zero_lt_one.trans_le hY
  have hY2 : 2 ≤ Y := by simpa only [Real.rpow_one] using htwo Y hY0 hlo
  exact sparse_cardinality_square_root_absorption hY0 (Nat.cast_nonneg _)
    (hcount s hs coeff Y P R hY hlo hhi hPlo hPhi hR hRY hband hcoeff)
    (prime_exceptional_time_span_le hR hRY hY2) (hconstant Y hY0 hlo) hU

end Bounty
end

section

/- A literal product of four finite polynomials has explicit supported dyadic coefficients. -/

open Finset

namespace Bounty

theorem finite_four_polynomial_five_dyads (D A B C : Finset ℕ) (δ α β γ : ℕ → ℂ)
    {UD UA UB UC : ℝ} (hUD : 0 < UD) (hUA : 0 < UA) (hUB : 0 < UB) (hUC : 0 < UC)
    (hD : ∀ d ∈ D, UD ≤ (d : ℝ) ∧ (d : ℝ) ≤ 2*UD)
    (hA : ∀ a ∈ A, UA ≤ (a : ℝ) ∧ (a : ℝ) ≤ 2*UA)
    (hB : ∀ b ∈ B, UB ≤ (b : ℝ) ∧ (b : ℝ) ≤ 2*UB)
    (hC : ∀ c ∈ C, UC ≤ (c : ℝ) ∧ (c : ℝ) ≤ 2*UC) (t : ℝ) :
    let V := UD*UA*UB*UC
    let S := Icc 1 ⌊16*V⌋₊
    let U := V/2
    (∑ d ∈ D, δ d*harmonicMellinWeight t d)*
      (∑ a ∈ A, α a*harmonicMellinWeight t a)*
      (∑ b ∈ B, β b*harmonicMellinWeight t b)*
      (∑ c ∈ C, γ c*harmonicMellinWeight t c) =
      ∑ j : Fin 5, ∑ n ∈ Icc (⌊(2 : ℝ)^j.val*U⌋₊+1) ⌊(2 : ℝ)^(j.val+1)*U⌋₊,
        (if n ∈ S then endpointFourConvolution
          (fun n => if n ∈ D then δ n else 0) (fun n => if n ∈ A then α n else 0)
          (fun n => if n ∈ B then β n else 0) (fun n => if n ∈ C then γ n else 0) n/(n : ℂ) else 0)*
          Complex.exp (((Real.log (n : ℝ)*t : ℝ) : ℂ)*Complex.I) := by
  classical
  have hr := endpoint_four_five_dyads D A B C
    (fun n => if n ∈ D then δ n else 0) (fun n => if n ∈ A then α n else 0)
    (fun n => if n ∈ B then β n else 0) (fun n => if n ∈ C then γ n else 0)
    hUD hUA hUB hUC hD hA hB hC
    (by intro n hn; exact if_neg hn) (by intro n hn; exact if_neg hn)
    (by intro n hn; exact if_neg hn) (by intro n hn; exact if_neg hn) t
  simpa only [finite_support_weighted_sum] using hr

end Bounty
end

section

/- The shorter actual coefficient convolutions inherit the audited fourth-moment budget. -/

open Finset Filter

namespace Bounty

theorem eventually_pair_convolution_reciprocal_power_energy {c E : ℝ} (hc : 0 ≤ c) :
    ∀ᶠ L : ℝ in atTop, ∀ (β γ : ℕ → ℂ) (B C U : ℝ),
      0 ≤ B → 0 ≤ C → 1 ≤ U → Real.log U ≤ c*L → B*C ≤ L^E →
      (∀ n, ‖β n‖ ≤ B) → (∀ n, ‖γ n‖ ≤ C) →
      ∀ S : Finset ℕ, (∀ n ∈ S, U ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*U) →
        (∑ n ∈ S, ‖(∑ d ∈ n.divisors, β d*γ (n/d))/(n : ℂ)‖^2) ≤ L^(2*E+16)/U := by
  filter_upwards [eventually_four_convolution_reciprocal_power_energy (E := E) hc] with L hL
  intro β γ B C U hB hC hU hlog hprod hβ hγ S hS
  let e : ℕ → ℂ := fun n => if n = 1 then 1 else 0
  have he : ∀ n, ‖e n‖ ≤ 1 := by intro n; dsimp [e]; split_ifs <;> norm_num
  have hh := hL e e β γ 1 1 B C U zero_le_one zero_le_one hB hC hU hlog
    (by simpa only [one_mul] using hprod) he he hβ hγ S hS
  have heq : (∑ n ∈ S, ‖endpointFourConvolution e e β γ n/(n : ℂ)‖^2) =
      ∑ n ∈ S, ‖(∑ d ∈ n.divisors, β d*γ (n/d))/(n : ℂ)‖^2 := by
    apply sum_congr rfl
    intro n hn
    have hn0 : n ≠ 0 := (Nat.cast_pos.mp ((zero_lt_one.trans_le hU).trans_le (hS n hn).1)).ne'
    rw [endpoint_four_unit_left e β γ hn0,endpoint_triple_unit_left β γ hn0]
  rw [heq] at hh
  exact hh

theorem eventually_triple_convolution_reciprocal_power_energy {c E : ℝ} (hc : 0 ≤ c) :
    ∀ᶠ L : ℝ in atTop, ∀ (α β γ : ℕ → ℂ) (A B C U : ℝ),
      0 ≤ A → 0 ≤ B → 0 ≤ C → 1 ≤ U → Real.log U ≤ c*L → A*B*C ≤ L^E →
      (∀ n, ‖α n‖ ≤ A) → (∀ n, ‖β n‖ ≤ B) → (∀ n, ‖γ n‖ ≤ C) →
      ∀ S : Finset ℕ, (∀ n ∈ S, U ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*U) →
        (∑ n ∈ S, ‖endpointTripleConvolution α β γ n/(n : ℂ)‖^2) ≤ L^(2*E+16)/U := by
  filter_upwards [eventually_four_convolution_reciprocal_power_energy (E := E) hc] with L hL
  intro α β γ A B C U hA hB hC hU hlog hprod hα hβ hγ S hS
  let e : ℕ → ℂ := fun n => if n = 1 then 1 else 0
  have he : ∀ n, ‖e n‖ ≤ 1 := by intro n; dsimp [e]; split_ifs <;> norm_num
  have hh := hL e α β γ 1 A B C U zero_le_one hA hB hC hU hlog
    (by simpa only [one_mul] using hprod) he hα hβ hγ S hS
  have heq : (∑ n ∈ S, ‖endpointFourConvolution e α β γ n/(n : ℂ)‖^2) =
      ∑ n ∈ S, ‖endpointTripleConvolution α β γ n/(n : ℂ)‖^2 := by
    apply sum_congr rfl
    intro n hn
    have hn0 : n ≠ 0 := (Nat.cast_pos.mp ((zero_lt_one.trans_le hU).trans_le (hS n hn).1)).ne'
    rw [endpoint_four_unit_left α β γ hn0]
  rw [heq] at hh
  exact hh

theorem finite_masked_energy_le (S T : Finset ℕ) (f : ℕ → ℂ) :
    (∑ n ∈ S, ‖if n ∈ T then f n else 0‖^2) ≤ ∑ n ∈ S, ‖f n‖^2 := by
  apply sum_le_sum
  intro n _
  split_ifs <;> simp only [norm_zero,zero_pow (by omega : 2 ≠ 0),le_refl]
  exact sq_nonneg _

end Bounty
end

section

/- The exact common ghost multiplier is an ordered-newborn observable.
Its phase never reads retained memory labels or retention indices. -/

open Finset Classical
namespace Bounty

section Ghost
variable {I K S : Type*} {N J ell B : ℕ} {Ps : S → Finset ℕ}
  {P : Fin N → Type*} (n : (g : Fin N) → P g → ℕ) (M : Fin N → ℕ)
  (steps : List (Option (I ⊕ K)))
  (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))
  (θ : (Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) ×
    Fin (Fintype.card (FullMixedCommonBirthAddress M B steps))) → ℝ)
  (encode : ((g : Fin N) × P g) → ℤ)
  (i : Fin steps.length) (tag : I) (hi : steps.get i = some (.inl tag))

noncomputable def physicalCommonGhostObservable :
    PhysicalBareResidueState Ps J ell → (∀ g, Fin (M g) → P g) →
    (∀ g, FiniteOrderedTuple (UnrestrictedResidueParticle (n g))) → ℂ :=
  fun _ _ born => commonForestObservedMultiplier M B steps code θ encode
    (commonForestEventLabels M B steps i (fun a =>
      let b : FullMixedCommonLocalAddress M B (some (Sum.inl (β := K) tag)) := hi ▸ a
      if h : b.2.val < (born b.1).1 then some ⟨b.1, ((born b.1).2 ⟨b.2.val, h⟩).1⟩
      else none)) (some i)

noncomputable def physicalCommonGhostEventPhase
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (e : CoupledGhostEvent M B s.2) : ℂ :=
  commonForestGhostOperationObservation B steps code θ encode i tag hi
    (fun g => ⟨(e g).1, fun a => ((e g).2.2 a).1⟩)

theorem physical_common_ghost_eq_observable
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (e : CoupledGhostEvent M B s.2) :
    physicalCommonGhostEventPhase n M steps code θ encode i tag hi s e =
      physicalSmallBigGhostBirthPhase M B
        (physicalCommonGhostObservable n M steps code θ encode i tag hi) s e := rfl

theorem physical_common_ghost_observable_norm_le_one
    (s : PhysicalBareResidueState Ps J ell) (active : ∀ g, Fin (M g) → P g)
    (born : ∀ g, FiniteOrderedTuple (UnrestrictedResidueParticle (n g))) :
    ‖physicalCommonGhostObservable n M steps code θ encode i tag hi s active born‖ ≤ 1 :=
  common_forest_observed_multiplier_norm_le_one _ _ _ _ _ _ _ _

theorem physical_common_ghost_event_reindex
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (τ : ∀ g, Equiv.Perm (Fin (s.2 g).2.1.val)) (e : CoupledGhostEvent M B s.2) :
    physicalCommonGhostEventPhase n M steps code θ encode i tag hi
      (s.1, productMemoryReindex s.2 τ) (jointGhostMemoryReindex M B s.2 τ e) =
      physicalCommonGhostEventPhase n M steps code θ encode i tag hi s e := rfl

theorem physical_common_ghost_action_memory_symmetric
    [∀ g, Fintype (P g)] [∀ g, Fintype (UnrestrictedResidueParticle (n g))]
    [∀ g, DecidableEq (UnrestrictedResidueParticle (n g))]
    (A D C ν : ∀ g, UnrestrictedResidueParticle (n g) → ℝ)
    (f : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (hf : ∀ s, ProductMemorySymmetric (fun x => f (s, x))) :
    ∀ s, ProductMemorySymmetric (fun x => physicalSmallBigGhostAction A D C ν M B
      (physicalCommonGhostEventPhase n M steps code θ encode i tag hi) f (s, x)) :=
  physical_small_big_ghost_signed_memory_symmetric A D C ν M B _
    (physical_common_ghost_event_reindex n M steps code θ encode i tag hi) f hf

end Ghost
end Bounty
end

section

/- Reindex the full compatible endpoint sum without changing its coefficient or guards. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_compatible_pair_sum_eq_cut_sum {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {J ell : ℕ} (C : G → Finset (Fin J))
    (F : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → ℂ) :
    (∑ L : PhysicalMarkLists P J ell, ∑ R : PhysicalMarkLists P J ell,
      if physicalSharedCompatible C L R then F L R else 0) =
      ∑ d : PhysicalJointCutData P C ell,
        F (physicalCutGlue C d.1 d.2.1) (physicalCutGlue C d.1 d.2.2) := by
  let f : PhysicalMarkLists P J ell × PhysicalMarkLists P J ell → ℂ := fun x => F x.1 x.2
  have hs : (∑ x : PhysicalCompatibleMarkPair P C ell, f x.val) =
      ∑ x : PhysicalMarkLists P J ell × PhysicalMarkLists P J ell,
        if physicalSharedCompatible C x.1 x.2 then f x else 0 := by
    rw [← sum_filter]
    exact (sum_subtype _ (by simp) f).symm
  have he := (physicalCutPairEquiv P C ell).symm.sum_comp
    (fun x : PhysicalCompatibleMarkPair P C ell => f x.val)
  rw [Fintype.sum_prod_type] at hs
  calc
    _ = ∑ x : PhysicalCompatibleMarkPair P C ell, f x.val := hs.symm
    _ = ∑ d : PhysicalJointCutData P C ell,
        f ((physicalCutPairEquiv P C ell).symm d).val := he.symm
    _ = _ := by
      apply sum_congr rfl
      intro d _
      simp only [f, physical_cut_pair_inverse_left, physical_cut_pair_inverse_right]

theorem physical_joint_normalized_sum_eq_shared_draw_sum {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {J ell : ℕ} (C : G → Finset (Fin J)) (V : G → ℝ)
    (F : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → ℂ) :
    (∑ L : PhysicalMarkLists P J ell, ∑ R : PhysicalMarkLists P J ell,
      if physicalSharedCompatible C L R then
        ((physicalStateMass V J ell * physicalCompletionMass V C ell /
          (physicalSharedFactor C L : ℝ) : ℝ) : ℂ) * F L R else 0) =
      ∑ d : PhysicalJointCutData P C ell,
        ((physicalAuxMass V (fun g => univ \ C g) (fun g j => d.1 g j) *
          physicalCompletionMass V C ell ^ 2 : ℝ) : ℂ) *
          F (physicalCutGlue C d.1 d.2.1) (physicalCutGlue C d.1 d.2.2) := by
  rw [physical_compatible_pair_sum_eq_cut_sum]
  apply sum_congr rfl
  intro d _
  rw [physical_shared_joint_normalization]
  have haux : physicalSharedAux C (physicalCutGlue C d.1 d.2.1) = fun g j => d.1 g j := by
    simpa only [physical_cut_pair_inverse_left] using physical_cut_pair_inverse_shared_aux C d
  rw [haux]

end Bounty
end

section

/- Independent raw shared draws, with all original injectivity and disjointness guards. -/

open Finset
open scoped Classical
namespace Bounty

def physicalRawCutGood {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (u v : GroupMarkedLists P (fun g => ell + (C g).card))
    (s : PhysicalAuxLabels P (fun g => univ \ C g)) : Prop :=
  (∀ g, Function.Injective (s g)) ∧
    ∀ g, Disjoint (Set.range (s g)) (Set.range (u g)) ∧
      Disjoint (Set.range (s g)) (Set.range (v g))

abbrev PhysicalRawCutData {G : Type*} (P : G → Finset ℕ) {J : ℕ}
    (C : G → Finset (Fin J)) (ell : ℕ) :=
  {x : (GroupMarkedLists P (fun g => ell + (C g).card) ×
      GroupMarkedLists P (fun g => ell + (C g).card)) ×
      PhysicalAuxLabels P (fun g => univ \ C g) // physicalRawCutGood C x.1.1 x.1.2 x.2}

noncomputable def physicalCutRawEquiv {G : Type*} (P : G → Finset ℕ) {J : ℕ}
    (C : G → Finset (Fin J)) (ell : ℕ) :
    PhysicalJointCutData P C ell ≃ PhysicalRawCutData P C ell where
  toFun d := ⟨((d.2.1.val,d.2.2.val),fun g j => d.1 g j),
    (fun g => (d.1 g).injective), fun g => ⟨d.2.1.property g,d.2.2.property g⟩⟩
  invFun x := ⟨(fun g => ⟨x.val.2 g,x.property.1 g⟩),
    ⟨x.val.1.1,fun g => (x.property.2 g).1⟩,
    ⟨x.val.1.2,fun g => (x.property.2 g).2⟩⟩
  left_inv d := by
    rcases d with ⟨s, ⟨u, hu⟩, ⟨v, hv⟩⟩
    rfl
  right_inv x := by
    rcases x with ⟨⟨⟨u,v⟩,s⟩,h⟩
    rfl

theorem physical_joint_cut_sum_eq_raw_sum {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {J ell : ℕ} (C : G → Finset (Fin J))
    (F : GroupMarkedLists P (fun g => ell + (C g).card) →
      GroupMarkedLists P (fun g => ell + (C g).card) →
      PhysicalAuxLabels P (fun g => univ \ C g) → ℂ) :
    (∑ d : PhysicalJointCutData P C ell, F d.2.1.val d.2.2.val (fun g j => d.1 g j)) =
      ∑ u : GroupMarkedLists P (fun g => ell + (C g).card),
      ∑ v : GroupMarkedLists P (fun g => ell + (C g).card),
      ∑ s : PhysicalAuxLabels P (fun g => univ \ C g),
        if physicalRawCutGood C u v s then F u v s else 0 := by
  let f : (GroupMarkedLists P (fun g => ell + (C g).card) ×
      GroupMarkedLists P (fun g => ell + (C g).card)) ×
      PhysicalAuxLabels P (fun g => univ \ C g) → ℂ := fun x => F x.1.1 x.1.2 x.2
  have hs : (∑ x : PhysicalRawCutData P C ell, f x.val) =
      ∑ x, if physicalRawCutGood C x.1.1 x.1.2 x.2 then f x else 0 := by
    rw [← sum_filter]
    exact (sum_subtype _ (by simp) f).symm
  have he := (physicalCutRawEquiv P C ell).sum_comp
    (fun x : PhysicalRawCutData P C ell => f x.val)
  rw [Fintype.sum_prod_type] at hs
  rw [Fintype.sum_prod_type] at hs
  calc
    _ = ∑ x : PhysicalRawCutData P C ell, f x.val := he
    _ = _ := hs

end Bounty
end

section

/- Shared-factor reindexing with both original cutoff guards retained. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def physicalQuotientPositions {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {J : ℕ} (C : G → Finset (Fin J)) (ell : ℕ)
    (positions : Finset ℤ) : Finset ℤ :=
  univ.biUnion (fun L : PhysicalMarkLists P J ell =>
    positions.image (fun n => n / physicalSharedFactor C L))

theorem physical_mem_quotient_positions {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {J ell : ℕ} (C : G → Finset (Fin J))
    (positions : Finset ℤ) (L : PhysicalMarkLists P J ell) {n : ℤ}
    (hn : n ∈ positions) :
    n / physicalSharedFactor C L ∈ physicalQuotientPositions P C ell positions := by
  exact mem_biUnion.mpr ⟨L, mem_univ _, mem_image.mpr ⟨n, hn, rfl⟩⟩

theorem physical_fixed_root_reindex_guarded
    {G : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (V : G → ℝ) (C : G → Finset (Fin J)) (q ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (positions W : Finset ℤ)
    (hW : ∀ L : PhysicalMarkLists P J ell, ∀ n ∈ positions,
      n / physicalSharedFactor C L ∈ W)
    (f g : ℤ → ℂ) (Ψ : ℝ → ℂ) (Z : ℝ) :
    physicalFixedRootCorrelation V C q ζ k K aux positions f g Ψ Z =
      (physicalStateMass V J ell : ℂ) *
      ∑ L : PhysicalMarkLists P J ell, ∑ R : PhysicalMarkLists P J ell,
        ∑ w ∈ W,
          if (physicalSharedFactor C L : ℤ) * w ∈ positions ∧
              (physicalSharedFactor C L : ℤ) *
                (w + k * (physicalFreeFactor C aux : ℕ)) ∈ positions then
            physicalRootPositionTerm V C q ζ k K aux f g Ψ Z L R
              ((physicalSharedFactor C L : ℤ) * w)
          else 0 := by
  rw [physical_fixed_root_all_lists]
  congr 1
  apply sum_congr rfl
  intro L _
  apply sum_congr rfl
  intro R _
  have hs : (physicalSharedFactor C L : ℤ) ≠ 0 := by
    exact_mod_cast (physical_shared_factor_pos C L hprime).ne'
  rw [integer_guarded_position_sum hs positions W
    (fun n => if n + k * (physicalD C L aux : ℕ) ∈ positions then
      physicalRootPositionTerm V C q ζ k K aux f g Ψ Z L R n else 0)]
  · apply sum_congr rfl
    intro w _
    have he : (physicalSharedFactor C L : ℤ) * w + k * (physicalD C L aux : ℕ) =
        (physicalSharedFactor C L : ℤ) * (w + k * (physicalFreeFactor C aux : ℕ)) := by
      rw [physical_D_shared_free, Nat.cast_mul]
      ring
    rw [he]
    split_ifs <;> simp_all
  · intro n _ hn
    have hL : ¬ ∀ g s, ((L g s).val : ℤ) ∣ n :=
      fun hm => hn (physical_shared_factor_dvd C L n hdis hprime hm)
    simp only [physicalRootPositionTerm, physicalVertexWeight, if_neg hL, zero_mul,
      Complex.ofReal_zero, mul_zero, ite_self]
  · intro n hn _ _
    exact hW L n hn

end Bounty
end

section

/- The literal selected marked endpoint and its peeled four-factor replacement. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def selectedMarkedEndpoint {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (q : ℝ) (V : G → ℝ) (t : G → ℕ) (big : Finset G)
    (b : GroupMarkedLists (fun h : big => P h.val) (fun h : big => t h.val) → ℂ)
    (Q : Finset ℕ) (α β γ : ℕ → ℂ) (n : ℕ) : ℂ :=
  (markedDivisorWeight univ P q V t (n : ℤ) : ℂ) *
    groupMarkedAverage (fun h : big => P h.val) (fun h : big => t h.val) (n : ℤ) b *
    invariantTripleEndpoint Q α β γ n

noncomputable def selectedPeeledEndpoint {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (q : ℝ) (V : G → ℝ) (t : G → ℕ) (g : G) (k : ℕ)
    (big : Finset G)
    (b : GroupMarkedLists (fun h : big => P h.val) (fun h : big => t h.val) → ℂ)
    (Q : Finset ℕ) (α β γ : ℕ → ℂ) (n : ℕ) : ℂ :=
  endpointFourConvolution (fun p => if p ∈ P g then 1 / (V g : ℂ) else 0) α β
    (fun r => selectedMarkedWeight P Q q V (Function.update t g k) t big b (fun _ => 1) r *
      γ (primePoolFreePart Q r)) n

theorem selected_marked_endpoint_energy
    {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {q v : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v)
    (V : G → ℝ) (t : G → ℕ) (T : ℕ)
    (hV : ∀ g, v ≤ V g) (ht : ∀ g, t g ≤ T)
    (big : Finset G)
    (b : GroupMarkedLists (fun h : big => P h.val) (fun h : big => t h.val) → ℂ)
    {H : ℝ} (hH : 0 ≤ H) (hb : ∀ l, ‖b l‖ ≤ H)
    (Q : Finset ℕ) (α β γ : ℕ → ℂ)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (positions : Finset ℕ) (N : ℕ) (hN : ∀ n ∈ positions, n ≤ N) :
    (∑ n ∈ positions, ‖selectedMarkedEndpoint P q V t big b Q α β γ n‖ ^ 2) ≤
      ((markedDivisorBound q v T) ^ Fintype.card G * H) ^ 2 *
        ((A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15) := by
  let M := (markedDivisorBound q v T) ^ Fintype.card G
  have hM : 0 ≤ M := pow_nonneg (zero_le_one.trans (one_le_markedDivisorBound q v T)) _
  have hn (n : ℕ) : ‖selectedMarkedEndpoint P q V t big b Q α β γ n‖ ≤
      (M*H) * ‖invariantTripleEndpoint Q α β γ n‖ := by
    have hW := marked_divisor_weight_nonneg univ P hq0 V t
      (fun g _ => hv.le.trans (hV g)) (n : ℤ)
    have hWb : markedDivisorWeight univ P q V t (n : ℤ) ≤ M := by
      simpa only [card_univ] using marked_divisor_weight_le_pow univ P hq0 hq1 hv
        V t T (fun g _ => hV g) (fun g _ => ht g) (n : ℤ)
    have havg := group_marked_average_norm_le
      (fun h : big => P h.val) (fun h : big => t h.val) (n : ℤ) b hH (fun l => hb l.val)
    unfold selectedMarkedEndpoint
    rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hW]
    exact mul_le_mul_of_nonneg_right (mul_le_mul hWb havg (norm_nonneg _) hM) (norm_nonneg _)
  have he := invariant_triple_endpoint_divisible_energy Q α β γ hA hB hC hα hβ hγ
    positions 1 N (by simp [Nat.mem_factoredNumbers]) (by intro n _; exact one_dvd n) hN
  simp only [Nat.cast_one, div_one] at he
  calc
    _ ≤ ∑ n ∈ positions, (M*H)^2 * ‖invariantTripleEndpoint Q α β γ n‖^2 := by
      apply sum_le_sum
      intro n _
      simpa only [mul_pow] using pow_le_pow_left₀ (norm_nonneg _) (hn n) 2
    _ = (M*H)^2 * ∑ n ∈ positions, ‖invariantTripleEndpoint Q α β γ n‖^2 :=
      (mul_sum ..).symm
    _ ≤ _ := mul_le_mul_of_nonneg_left he (sq_nonneg _)

theorem selected_shifted_endpoint_energy
    {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {q v : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v)
    (V : G → ℝ) (t : G → ℕ) (T : ℕ)
    (hV : ∀ g, v ≤ V g) (ht : ∀ g, t g ≤ T)
    (big : Finset G)
    (b : GroupMarkedLists (fun h : big => P h.val) (fun h : big => t h.val) → ℂ)
    {H : ℝ} (hH : 0 ≤ H) (hb : ∀ l, ‖b l‖ ≤ H)
    (Q : Finset ℕ) (α β γ : ℕ → ℂ)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (S : Finset ℤ) (δ : ℤ) (N : ℕ)
    (hpos : ∀ n ∈ S, 0 < n+δ ∧ n+δ ≤ (N : ℤ)) :
    (∑ n ∈ S, ‖selectedMarkedEndpoint P q V t big b Q α β γ (n+δ).natAbs‖ ^ 2) ≤
      ((markedDivisorBound q v T) ^ Fintype.card G * H) ^ 2 *
        ((A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15) := by
  rw [sum_shift_natAbs S δ
    (fun m => ‖selectedMarkedEndpoint P q V t big b Q α β γ m‖ ^ 2)
    (fun n hn => (hpos n hn).1.le)]
  exact selected_marked_endpoint_energy P hq0 hq1 hv V t T hV ht big b hH hb
    Q α β γ hA hB hC hα hβ hγ _ N
    (fun m hm => (shifted_natAbs_image_bounds S δ N hpos m hm).2)

theorem selected_shifted_peel_error_energy
    {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) {q v : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v)
    (V : G → ℝ) (t : G → ℕ) (T : ℕ)
    (hV : ∀ g, v ≤ V g) (ht : ∀ g, t g ≤ T)
    (hprime : ∀ g, ∀ p ∈ P g, p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (g : G) (k : ℕ) (htg : t g = k + 1) (big : Finset G) (hsmall : g ∉ big)
    (b : GroupMarkedLists (fun h : big => P h.val) (fun h : big => t h.val) → ℂ)
    {H : ℝ} (hH : 0 ≤ H) (hb : ∀ l, ‖b l‖ ≤ H)
    (Q : Finset ℕ) (hQ : ∀ g, P g ⊆ Q) (α β γ : ℕ → ℂ)
    (hαfree : ∀ d, ¬ Disjoint d.primeFactors Q → α d = 0)
    (hβfree : ∀ d, ¬ Disjoint d.primeFactors Q → β d = 0)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (S : Finset ℤ) (δ : ℤ) (N : ℕ)
    (hpos : ∀ n ∈ S, 0 < n+δ ∧ n+δ ≤ (N : ℤ)) :
    (∑ n ∈ S, ‖selectedMarkedEndpoint P q V t big b Q α β γ (n+δ).natAbs -
      selectedPeeledEndpoint P q V t g k big b Q α β γ (n+δ).natAbs‖ ^ 2) ≤
      H ^ 2 * (((markedDivisorBound q v T) ^ Fintype.card G * (1 + 2 * Real.log N / v)) ^ 2 *
        (((A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15) *
          ∑ p ∈ P g, 1 / (p : ℝ) ^ 2)) := by
  rw [sum_shift_natAbs S δ
    (fun m => ‖selectedMarkedEndpoint P q V t big b Q α β γ m -
      selectedPeeledEndpoint P q V t g k big b Q α β γ m‖ ^ 2)
    (fun n hn => (hpos n hn).1.le)]
  exact selected_four_convolution_error_energy P hq0 hq1 hv V t T hV ht hprime hdis
    g k htg big hsmall b hH hb Q hQ α β γ hαfree hβfree hA hB hC hα hβ hγ
    _ N (shifted_natAbs_image_bounds S δ N hpos)

end Bounty
end

section

/- A genuine output cutoff can remove the output mask on each full box,
while only boxes meeting its original support need be retained. -/

open Finset
namespace Bounty

theorem four_box_supported_sum (S D A B C : Finset ℕ)
    (δ α β γ F : ℕ → ℂ) (hF : ∀ n, n ∉ S → F n = 0) :
    (∑ d ∈ D, ∑ a ∈ A, ∑ b ∈ B, ∑ c ∈ C,
      if d*a*b*c ∈ S then δ d*α a*β b*γ c*F (d*a*b*c) else 0) =
      ∑ d ∈ D, ∑ a ∈ A, ∑ b ∈ B, ∑ c ∈ C,
        δ d*α a*β b*γ c*F (d*a*b*c) := by
  classical
  apply sum_congr rfl
  intro d _
  apply sum_congr rfl
  intro a _
  apply sum_congr rfl
  intro b _
  apply sum_congr rfl
  intro c _
  by_cases h : d*a*b*c ∈ S
  · rw [if_pos h]
  · rw [if_neg h, hF _ h, mul_zero]

theorem four_box_outside_support_zero (S D A B C : Finset ℕ)
    (δ α β γ F : ℕ → ℂ) (hF : ∀ n, n ∉ S → F n = 0)
    (hbox : ¬∃ d ∈ D, ∃ a ∈ A, ∃ b ∈ B, ∃ c ∈ C, d*a*b*c ∈ S) :
    (∑ d ∈ D, ∑ a ∈ A, ∑ b ∈ B, ∑ c ∈ C,
      δ d*α a*β b*γ c*F (d*a*b*c)) = 0 := by
  apply sum_eq_zero
  intro d hd
  apply sum_eq_zero
  intro a ha
  apply sum_eq_zero
  intro b hb
  apply sum_eq_zero
  intro c hc
  rw [hF _ (fun h => hbox ⟨d,hd,a,ha,b,hb,c,hc,h⟩), mul_zero]

theorem endpoint_four_supported_dyadic_boxes (S : Finset ℕ) (N : ℕ)
    (hS : ∀ n ∈ S, n ≤ N) (δ α β γ F : ℕ → ℂ)
    (hF : ∀ n, n ∉ S → F n = 0) :
    (∑ n ∈ S, endpointFourConvolution δ α β γ n*F n) =
      ∑ i ∈ dyadicNatIndices (Icc 1 N), ∑ j ∈ dyadicNatIndices (Icc 1 N),
      ∑ k ∈ dyadicNatIndices (Icc 1 N), ∑ l ∈ dyadicNatIndices (Icc 1 N),
        if ∃ d ∈ dyadicNatBucket (Icc 1 N) i, ∃ a ∈ dyadicNatBucket (Icc 1 N) j,
          ∃ b ∈ dyadicNatBucket (Icc 1 N) k, ∃ c ∈ dyadicNatBucket (Icc 1 N) l,
          d*a*b*c ∈ S then
        ∑ d ∈ dyadicNatBucket (Icc 1 N) i, ∑ a ∈ dyadicNatBucket (Icc 1 N) j,
        ∑ b ∈ dyadicNatBucket (Icc 1 N) k, ∑ c ∈ dyadicNatBucket (Icc 1 N) l,
          δ d*α a*β b*γ c*F (d*a*b*c) else 0 := by
  classical
  rw [endpoint_four_bounded_dyadic_transform S N hS]
  apply sum_congr rfl
  intro i _
  apply sum_congr rfl
  intro j _
  apply sum_congr rfl
  intro k _
  apply sum_congr rfl
  intro l _
  rw [four_box_supported_sum S _ _ _ _ δ α β γ F hF]
  split_ifs with h
  · rfl
  · exact four_box_outside_support_zero S _ _ _ _ δ α β γ F hF h

end Bounty
end

section

/- The local convolution estimate needs only positive coefficient support. -/

open Finset MeasureTheory

namespace Bounty

theorem exists_local_additive_mellin_interval_constants {j : ℕ} (hj : 2 ≤ j) :
    ∃ Cj Cerr : ℝ, 0 < Cj ∧ 0 < Cerr ∧
      ∀ (S : Finset ℕ) (a : ℕ → ℂ), (∀ n ∈ S, 0 < n) →
      ∀ Y H : ℝ, 0 < Y → 1 ≤ H → H ≤ Y/8 →
      (4/H^2) * (∫ v in Set.Icc (Y/2) (3*Y), ‖localAdditiveConvolution S a H v‖^2) ≤
        (Cj/Y) * (∫ t : ℝ, (1+|(H/Y)*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2) +
          Cerr * (H/Y)^2 * (∑ n ∈ S, ‖a n‖^2) := by
  obtain ⟨Cj,hCj,hmellin⟩ := exists_local_log_mellin_energy_constant hj
  obtain ⟨C,hC,herr⟩ := exists_actual_local_kernel_error_constant
  refine ⟨24*Cj,8*C,by positivity,by positivity,?_⟩
  intro S a hSpos Y H hY hH hsmall
  have hHp : 0 < H := lt_of_lt_of_le zero_lt_one hH
  have hlog := hmellin S a hSpos (H/Y) Y (div_pos hHp hY) hY
  rw [div_mul_cancel₀ H hY.ne'] at hlog
  have hla := local_additive_convolution_contDiff S a H
  have hll := local_log_convolution_continuousOn S a hSpos hY H
  have hlaInt : IntegrableOn (fun v => ‖localAdditiveConvolution S a H v‖^2) (Set.Icc (Y/2) (3*Y)) :=
    (hla.continuous.norm.pow 2).integrableOn_Icc
  have hllInt : IntegrableOn (fun v => ‖localLogConvolution S a H v‖^2) (Set.Icc (Y/2) (3*Y)) :=
    (hll.norm.pow 2).integrableOn_Icc
  have hdInt : IntegrableOn (fun v => ‖localAdditiveConvolution S a H v-localLogConvolution S a H v‖^2) (Set.Icc (Y/2) (3*Y)) :=
    ((hla.continuous.continuousOn.sub hll).norm.pow 2).integrableOn_Icc
  have htri (v : ℝ) : ‖localAdditiveConvolution S a H v‖^2 ≤
      2*‖localLogConvolution S a H v‖^2 +
        2*‖localAdditiveConvolution S a H v-localLogConvolution S a H v‖^2 := by
    have hn := norm_add_le (localLogConvolution S a H v)
      (localAdditiveConvolution S a H v-localLogConvolution S a H v)
    have he : localLogConvolution S a H v + (localAdditiveConvolution S a H v-localLogConvolution S a H v) = localAdditiveConvolution S a H v := by abel
    rw [he] at hn
    have hs := pow_le_pow_left₀ (norm_nonneg _) hn 2
    nlinarith [sq_nonneg (‖localLogConvolution S a H v‖-
      ‖localAdditiveConvolution S a H v-localLogConvolution S a H v‖)]
  have hti := integral_mono hlaInt ((hllInt.const_mul 2).add (hdInt.const_mul 2)) htri
  simp only [Pi.add_apply] at hti
  rw [integral_add (hllInt.const_mul 2) (hdInt.const_mul 2), integral_const_mul,
    integral_const_mul] at hti
  have he := herr S a hSpos Y H hY hH hsmall
  simp_rw [← local_convolution_difference S a H] at he
  calc
    _ ≤ (8/H^2)*(∫ v in Set.Icc (Y/2) (3*Y), ‖localLogConvolution S a H v‖^2) +
        8*((∫ v in Set.Icc (Y/2) (3*Y), ‖localAdditiveConvolution S a H v-localLogConvolution S a H v‖^2)/H^2) := by
      have ht := mul_le_mul_of_nonneg_left hti (show 0 ≤ 4/H^2 by positivity)
      calc
        _ ≤ (4/H^2) * (2*(∫ v in Set.Icc (Y/2) (3*Y), ‖localLogConvolution S a H v‖^2) +
            2*(∫ v in Set.Icc (Y/2) (3*Y), ‖localAdditiveConvolution S a H v-localLogConvolution S a H v‖^2)) := ht
        _ = _ := by ring
    _ ≤ (8/H^2)*(3*Y*(H/Y)^2*Cj *
        ∫ t : ℝ, (1+|(H/Y)*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2) +
        8*(C*(H/Y)^2*(∑ n ∈ S, ‖a n‖^2)) := by
      exact add_le_add (mul_le_mul_of_nonneg_left hlog (by positivity))
        (mul_le_mul_of_nonneg_left he (by norm_num))
    _ = _ := by
      have hc : (8/H^2)*(3*Y*(H/Y)^2*Cj) = 24*Cj/Y := by
        field_simp
        ring
      rw [← mul_assoc, hc]
      ring

end Bounty
end

section

/- The physical edge with every target list and auxiliary draw is one
unified full-state row. Its globally extended phase is bounded everywhere. -/

open Finset
open scoped Classical
namespace Bounty

section Physical
variable {I K : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g, ∀ p : ↥(P g), NeZero p.val]
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (retention : I → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

noncomputable def physicalFullRecordedTracePhase
    (tags : ℕ → Option (I ⊕ K)) (cut : ℕ → Fin N → Finset (Fin J)) (steps : ℕ)
    (initial : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B →
      List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C))
    (F : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C) →
      FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ) :=
  finiteRecordedSchedulePhase (PhysicalFullLedgerEvent (P := P) (ell := ell) (B := B) C k)
    (physicalFullLedgerEventTarget C k) (physicalFullLedgerEventPhase C k ω β ρ V)
    tags (physicalFullTraceObservation C k tags cut) steps initial F

omit [∀ g, ∀ p : ↥(P g), NeZero p.val] in
theorem physical_full_recorded_trace_phase_norm_le
    (tags : ℕ → Option (I ⊕ K)) (cut : ℕ → Fin N → Finset (Fin J)) (steps : ℕ)
    (initial : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B →
      List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C))
    (F : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C) →
      FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ)
    (hF : ∀ r x, ‖F r x‖ ≤ 1)
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (p : FiniteEventPath (PhysicalFullLedgerEvent C k) (physicalFullLedgerEventTarget C k)
      ((List.range steps).map tags) s) :
    ‖physicalFullRecordedTracePhase C k ω β ρ V tags cut steps initial F s p‖ ≤ 1 :=
  finite_recorded_schedule_phase_norm_le _ _ _ _ _
    (physical_full_ledger_event_phase_norm_le C k ω β ρ V) _ _ _ hF s p

theorem physical_full_recorded_trace_rows_eq_paths
    (tags : ℕ → Option (I ⊕ K)) (cut : ℕ → Fin N → Finset (Fin J)) (steps : ℕ)
    (initial : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B →
      List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C))
    (F : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C) →
      FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ)
    (f : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ) :
    (fun s => finiteRowComposition (S := fun _ => List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C) ×
      FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
      (fun i => physicalFullRecordedRow C k ω β retention ρ V
        (tags i) (cut i) (cut (i + 1)) (physicalFullTraceAppend C)) steps
      (fun r => F r.1 r.2 * f r.2) (initial s, s)) =
    fullMixedLedgerPathAction (fun g (p : ↥(P g)) => p.val)
      (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j))
      ω (fun g p => β g p / V g) retention ρ V ((List.range steps).map tags)
      (physicalFullRecordedTracePhase C k ω β ρ V tags cut steps initial F) f := by
  let _ : ∀ (tag : Option (I ⊕ K)) s, Fintype (PhysicalFullLedgerEvent (P := P) (ell := ell) (B := B) C k tag s) :=
    physicalFullLedgerEventFintype (P := P) (ell := ell) (B := B) C k
  simp_rw [physical_full_trace_row_eq]
  exact finite_recorded_schedule_rows_eq_paths (PhysicalFullLedgerEvent (P := P) (ell := ell) (B := B) C k)
    (physicalFullLedgerEventTarget C k) (physicalFullLedgerEventPhase C k ω β ρ V)
    tags (physicalFullTraceObservation C k tags cut)
    (physicalFullLedgerEventWeight C k ω β retention ρ V) steps initial F f

end Physical
end Bounty
