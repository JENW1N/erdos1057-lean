/- Nonempty original probe subsets have products between superpolynomial and
subexponential scales, uniformly in their actual prime labels. -/

open Finset Filter
open scoped Classical
namespace Bounty

theorem eventually_candidate_subset_product_range {c ε : ℝ}
    (hc : 0 < c) (hε : 0 < ε) (J : ℕ) :
    ∀ᶠ L : ℝ in atTop, ∀ (S : Finset ℕ), S ⊆ candidatePIndices c L →
      ∀ (ell : ℕ) (probes : S → Finset (Fin J)) (r : Finset S)
        (A : Finset (RepeatedBigFlatIndex S J ell)),
        A ⊆ r.sigma (repeatedBigPrimeProbeSlots probes) → A.Nonempty →
        ∀ a : (∀ i : A, candidatePBand (c*L) i.val.1.val),
          Real.exp (L^(1/10 : ℝ)) ≤ (∏ i, (a i).val : ℕ) ∧
          (∏ i, (a i).val : ℕ) ≤ Real.exp (ε*L) := by
  obtain ⟨v, W, _, _, hpool⟩ := exists_candidate_P_pool_bounds hc
  let D : ℝ := (J : ℝ)*(2/(5*Real.log 2))
  filter_upwards [hpool, eventually_scaled_log_sublinear
    (A := D) (by dsimp [D]; positivity) (s := (2/5 : ℝ)) (by norm_num) hε]
    with L hp hscaled
  intro S hS ell probes r A hA hne a
  have hdata (i : A) := (hp.2.2.2.2.2 i.val.1.val (hS i.val.1.property)).2.2
    (a i).val (a i).property
  have hcard : (A.card : ℝ) ≤ D*Real.log L := by
    have hAcard : A.card ≤ J*S.card :=
      (card_le_card hA).trans ((repeated_big_prime_probe_sigma_card_le
        probes r (fun g => by simpa using card_le_univ (probes g))).trans
        (Nat.mul_le_mul_left J (by simpa only [Fintype.card_coe] using card_le_univ r)))
    have hScard : (S.card : ℝ) ≤ (2/(5*Real.log 2))*Real.log L :=
      (Nat.cast_le.mpr (card_le_card hS)).trans hp.2.2.2.1
    calc
      _ ≤ (J : ℝ)*S.card := by exact_mod_cast hAcard
      _ ≤ (J : ℝ)*((2/(5*Real.log 2))*Real.log L) :=
        mul_le_mul_of_nonneg_left hScard (Nat.cast_nonneg J)
      _ = _ := by dsimp [D]; ring
  constructor
  · obtain ⟨i, hi⟩ := hne
    have hsingle : (a ⟨i, hi⟩).val ≤ ∏ j : A, (a j).val :=
      single_le_prod' (fun j _ => (hdata j).1.one_le) (mem_univ (⟨i, hi⟩ : A))
    exact (hdata ⟨i, hi⟩).2.1.le.trans (by exact_mod_cast hsingle)
  · calc
      ((∏ i, (a i).val : ℕ) : ℝ) = ∏ i : A, ((a i).val : ℝ) := by simp only [Nat.cast_prod]
      _ ≤ ∏ _i : A, Real.exp (L^(2/5 : ℝ)) :=
        prod_le_prod₀ (fun _ _ => Nat.cast_nonneg _) (fun i _ => (hdata i).2.2)
      _ = Real.exp ((A.card : ℝ)*L^(2/5 : ℝ)) := by
        rw [← Real.exp_sum]
        simp only [sum_const, card_univ, Fintype.card_coe, nsmul_eq_mul]
      _ ≤ Real.exp (D*L^(2/5 : ℝ)*Real.log L) := Real.exp_le_exp.mpr (by
        have hh := mul_le_mul_of_nonneg_right hcard (Real.rpow_nonneg (zero_le_one.trans hp.1) (2/5))
        nlinarith)
      _ ≤ Real.exp (ε*L) := Real.exp_le_exp.mpr hscaled

end Bounty
end

section

/- The genuine harmonic source cutoff separates a full positive four-factor box. -/

open Finset MeasureTheory

namespace Bounty

private theorem box_phase_four (s : ℝ) {d a b c : ℕ}
    (hd : 0 < d) (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) :
    physicalMellinPhase s ((d*a*b*c : ℕ) : ℝ) =
      physicalMellinPhase s d * physicalMellinPhase s a *
        physicalMellinPhase s b * physicalMellinPhase s c := by
  have hdr : (d : ℝ) ≠ 0 := by exact_mod_cast hd.ne'
  have har : (a : ℝ) ≠ 0 := by exact_mod_cast ha.ne'
  have hbr : (b : ℝ) ≠ 0 := by exact_mod_cast hb.ne'
  have hcr : (c : ℝ) ≠ 0 := by exact_mod_cast hc.ne'
  unfold physicalMellinPhase
  simp only [Nat.cast_mul, Real.log_mul (mul_ne_zero (mul_ne_zero hdr har) hbr) hcr,
    Real.log_mul (mul_ne_zero hdr har) hbr, Real.log_mul hdr har, ← Complex.exp_add]
  congr 1
  push_cast
  ring

private theorem box_mellin_factorization (D A B C : Finset ℕ)
    (δ α β γ : ℕ → ℂ) (s : ℝ)
    (hD : ∀ d ∈ D, 0 < d) (hA : ∀ a ∈ A, 0 < a)
    (hB : ∀ b ∈ B, 0 < b) (hC : ∀ c ∈ C, 0 < c) :
    (∑ d ∈ D, ∑ a ∈ A, ∑ b ∈ B, ∑ c ∈ C,
      (δ d * α a * β b * γ c) * physicalMellinPhase s ((d*a*b*c : ℕ) : ℝ)) =
      (∑ d ∈ D, δ d * physicalMellinPhase s d) *
        (∑ a ∈ A, α a * physicalMellinPhase s a) *
        (∑ b ∈ B, β b * physicalMellinPhase s b) *
        (∑ c ∈ C, γ c * physicalMellinPhase s c) := by
  calc
    _ = ∑ d ∈ D, ∑ a ∈ A, ∑ b ∈ B, ∑ c ∈ C,
        (δ d * physicalMellinPhase s d) * (α a * physicalMellinPhase s a) *
          (β b * physicalMellinPhase s b) * (γ c * physicalMellinPhase s c) := by
      apply sum_congr rfl
      intro d hd
      apply sum_congr rfl
      intro a ha
      apply sum_congr rfl
      intro b hb
      apply sum_congr rfl
      intro c hc
      rw [box_phase_four s (hD d hd) (hA a ha) (hB b hb) (hC c hc)]
      ring
    _ = _ := by simp only [← mul_sum, ← sum_mul]

private theorem box_phase_ratio {Y x : ℝ} (hY : 0 < Y) (hx : 0 < x)
    (s u : ℝ) :
    physicalMellinPhase s x * physicalMellinPhase (2 * Real.pi * u) (x / Y) =
      physicalMellinPhase (-2 * Real.pi * u) Y *
        physicalMellinPhase (s + 2 * Real.pi * u) x := by
  unfold physicalMellinPhase
  rw [Real.log_div hx.ne' hY.ne']
  simp only [← Complex.exp_add]
  congr 1
  push_cast
  ring

theorem harmonic_source_four_box_integrable (Y s : ℝ) (D A B C : Finset ℕ)
    (δ α β γ : ℕ → ℂ)
    (hD : ∀ d ∈ D, 0 < d) (hA : ∀ a ∈ A, 0 < a)
    (hB : ∀ b ∈ B, 0 < b) (hC : ∀ c ∈ C, 0 < c) :
    Integrable (fun u : ℝ => harmonicSourceLogFourier u *
      physicalMellinPhase (-2 * Real.pi * u) Y *
        ((∑ d ∈ D, δ d * physicalMellinPhase (s + 2 * Real.pi * u) d) *
          (∑ a ∈ A, α a * physicalMellinPhase (s + 2 * Real.pi * u) a) *
          (∑ b ∈ B, β b * physicalMellinPhase (s + 2 * Real.pi * u) b) *
          (∑ c ∈ C, γ c * physicalMellinPhase (s + 2 * Real.pi * u) c))) := by
  have hi := finite_mellin_sum_integrable (D ×ˢ (A ×ˢ (B ×ˢ C)))
    (fun u => harmonicSourceLogFourier u * physicalMellinPhase (-2 * Real.pi * u) Y)
    (fun u => s + 2 * Real.pi * u)
    (physical_mellin_phase_integrable harmonicSourceLogFourier
      (fun u => -2 * Real.pi * u) harmonic_source_log_fourier_integrable (by fun_prop) Y)
    (by fun_prop)
    (fun q => δ q.1 * α q.2.1 * β q.2.2.1 * γ q.2.2.2)
    (fun q => ((q.1*q.2.1*q.2.2.1*q.2.2.2 : ℕ) : ℝ))
  apply hi.congr
  filter_upwards [] with u
  simp only [sum_product]
  rw [box_mellin_factorization D A B C δ α β γ _ hD hA hB hC]

theorem harmonic_source_four_box_mellin {Y : ℝ} (hY : 0 < Y) (s : ℝ)
    (D A B C : Finset ℕ) (δ α β γ : ℕ → ℂ)
    (hD : ∀ d ∈ D, 0 < d) (hA : ∀ a ∈ A, 0 < a)
    (hB : ∀ b ∈ B, 0 < b) (hC : ∀ c ∈ C, 0 < c) :
    (∑ d ∈ D, ∑ a ∈ A, ∑ b ∈ B, ∑ c ∈ C,
      (δ d * α a * β b * γ c) *
        ((harmonicCommonCutoff (((d*a*b*c : ℕ) : ℝ) / Y) /
          (((d*a*b*c : ℕ) : ℝ) / Y) : ℝ) : ℂ) *
        physicalMellinPhase s ((d*a*b*c : ℕ) : ℝ)) =
      ∫ u : ℝ, harmonicSourceLogFourier u * physicalMellinPhase (-2 * Real.pi * u) Y *
        ((∑ d ∈ D, δ d * physicalMellinPhase (s + 2 * Real.pi * u) d) *
          (∑ a ∈ A, α a * physicalMellinPhase (s + 2 * Real.pi * u) a) *
          (∑ b ∈ B, β b * physicalMellinPhase (s + 2 * Real.pi * u) b) *
          (∑ c ∈ C, γ c * physicalMellinPhase (s + 2 * Real.pi * u) c)) := by
  let K := D ×ˢ (A ×ˢ (B ×ˢ C))
  let m : ℕ × ℕ × ℕ × ℕ → ℝ := fun q => ((q.1*q.2.1*q.2.2.1*q.2.2.2 : ℕ) : ℝ)
  let f : ℕ × ℕ × ℕ × ℕ → ℂ := fun q => δ q.1 * α q.2.1 * β q.2.2.1 * γ q.2.2.2
  have hm : ∀ q ∈ K, 0 < m q := by
    intro q hq
    obtain ⟨hd, ha, hb, hc⟩ := by simpa only [K, mem_product] using hq
    dsimp only [m]
    exact_mod_cast mul_pos (mul_pos (mul_pos (hD q.1 hd) (hA q.2.1 ha))
      (hB q.2.2.1 hb)) (hC q.2.2.2 hc)
  have hrep := finite_mellin_sum_representation K harmonicSourceLogFourier
    (fun u => 2 * Real.pi * u) harmonic_source_log_fourier_integrable (by fun_prop)
    (fun q => f q * physicalMellinPhase s (m q)) (fun q => m q / Y)
    (fun x => ((harmonicCommonCutoff x / x : ℝ) : ℂ)) (by
      intro q hq _
      exact harmonic_source_cutoff_mellin_representation (div_pos (hm q hq) hY))
  calc
    _ = ∑ q ∈ K, (f q * physicalMellinPhase s (m q)) *
        ((harmonicCommonCutoff (m q / Y) / (m q / Y) : ℝ) : ℂ) := by
      dsimp only [K, f, m]
      simp only [sum_product]
      apply sum_congr rfl
      intro d _
      apply sum_congr rfl
      intro a _
      apply sum_congr rfl
      intro b _
      apply sum_congr rfl
      intro c _
      ring
    _ = ∫ u : ℝ, harmonicSourceLogFourier u * ∑ q ∈ K,
        (f q * physicalMellinPhase s (m q)) *
          physicalMellinPhase (2 * Real.pi * u) (m q / Y) := hrep
    _ = _ := by
      apply integral_congr_ae
      filter_upwards [] with u
      have hs : (∑ q ∈ K, (f q * physicalMellinPhase s (m q)) *
          physicalMellinPhase (2 * Real.pi * u) (m q / Y)) =
        physicalMellinPhase (-2 * Real.pi * u) Y *
          ∑ q ∈ K, f q * physicalMellinPhase (s + 2 * Real.pi * u) (m q) := by
        rw [mul_sum]
        apply sum_congr rfl
        intro q hq
        rw [mul_assoc, box_phase_ratio hY (hm q hq)]
        ring
      rw [hs, ← mul_assoc]
      dsimp only [K, f, m]
      simp only [sum_product]
      rw [box_mellin_factorization D A B C δ α β γ _ hD hA hB hC]

end Bounty
end

