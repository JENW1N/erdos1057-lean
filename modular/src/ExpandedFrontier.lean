noncomputable def fullDoubledGhostUniformEnergy (ρ v vmin vmax : ℝ) (T : ℕ) : ℝ :=
  max 1 (max (physicalGhostUniformEnergyBound ρ (2 * vmax) v)
    (unrestrictedEdgeEnergyBound ρ v vmin vmax T))

theorem fullDoubledGhostUniformEnergy_ge_one (ρ v vmin vmax : ℝ) (T : ℕ) :
    1 ≤ fullDoubledGhostUniformEnergy ρ v vmin vmax T := le_max_left _ _

theorem fullDoubledGhost_product_le_uniform {J K : Type*}
    (ρ v vmin vmax : ℝ) (T groups : ℕ) (steps : List (Option (J ⊕ K))) :
    (steps.map (fullDoubledGhostStepEnergy ρ v vmin vmax T groups)).prod ≤
      (fullDoubledGhostUniformEnergy ρ v vmin vmax T ^ groups) ^
        (steps.filterMap id).length := by
  have hU0 : 0 ≤ fullDoubledGhostUniformEnergy ρ v vmin vmax T :=
    zero_le_one.trans (fullDoubledGhostUniformEnergy_ge_one ρ v vmin vmax T)
  induction steps with
  | nil => simp
  | cons k steps ih =>
    cases k with
    | none => simpa [fullDoubledGhostStepEnergy] using ih
    | some k =>
      have h0 : 0 ≤ fullDoubledGhostStepEnergy ρ v vmin vmax T groups (some k) := by
        cases k with
        | inl j => exact pow_nonneg (Real.exp_pos _).le _
        | inr k => exact pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _
      have hle : fullDoubledGhostStepEnergy ρ v vmin vmax T groups (some k) ≤
          fullDoubledGhostUniformEnergy ρ v vmin vmax T ^ groups := by
        cases k with
        | inl j =>
          exact pow_le_pow_left₀ (Real.exp_pos _).le
            ((le_max_left _ _).trans (le_max_right _ _)) _
        | inr k =>
          exact pow_le_pow_left₀ (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T)
            ((le_max_right _ _).trans (le_max_right _ _)) _
      change fullDoubledGhostStepEnergy ρ v vmin vmax T groups (some k) *
        (steps.map (fullDoubledGhostStepEnergy ρ v vmin vmax T groups)).prod ≤
          (fullDoubledGhostUniformEnergy ρ v vmin vmax T ^ groups) ^
            ((steps.filterMap id).length + 1)
      rw [pow_succ']
      exact (mul_le_mul_of_nonneg_left ih h0).trans
        (mul_le_mul_of_nonneg_right hle (pow_nonneg (pow_nonneg hU0 _) _))

theorem fullDoubledGhost_product_le_rpow {J K : Type*}
    (ρ v vmin vmax : ℝ) (T groups : ℕ) (steps : List (Option (J ⊕ K)))
    {L R : ℝ} (hL : 0 < L) (hgroups : (groups : ℝ) ≤ R * Real.log L) :
    (steps.map (fullDoubledGhostStepEnergy ρ v vmin vmax T groups)).prod ≤
      L ^ ((steps.filterMap id).length * R *
        Real.log (fullDoubledGhostUniformEnergy ρ v vmin vmax T)) := by
  have hU := fullDoubledGhostUniformEnergy_ge_one ρ v vmin vmax T
  have hU0 := (zero_le_one : (0 : ℝ) ≤ 1).trans hU
  have hp : fullDoubledGhostUniformEnergy ρ v vmin vmax T ^ groups ≤
      L ^ (R * Real.log (fullDoubledGhostUniformEnergy ρ v vmin vmax T)) := by
    simpa only [prod_const, card_univ, Fintype.card_fin] using
      group_product_bound_of_log_card (univ : Finset (Fin groups))
        (fun _ => fullDoubledGhostUniformEnergy ρ v vmin vmax T) hU hL
        (fun _ _ => hU0) (fun _ _ => le_rfl)
        (by simpa only [card_univ, Fintype.card_fin] using hgroups)
  calc
    _ ≤ (fullDoubledGhostUniformEnergy ρ v vmin vmax T ^ groups) ^
        (steps.filterMap id).length :=
      fullDoubledGhost_product_le_uniform ρ v vmin vmax T groups steps
    _ ≤ (L ^ (R * Real.log (fullDoubledGhostUniformEnergy ρ v vmin vmax T))) ^
        (steps.filterMap id).length := pow_le_pow_left₀ (pow_nonneg hU0 _) hp _
    _ = _ := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hL.le]
      congr 1
      ring

