/- The selected chronological physical rows evaluate to the original joint residue history. -/

open Finset
open scoped Classical
namespace Bounty

section ResiduePath
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (ζ : ∀ p : PhysicalPrime P, ZMod p.2.val)
  (hmarks : ∀ j : Fin (n + 1), ∀ p ∈ physicalMarkedPrimes (L j),
    ζ p = -(a j : ZMod p.2.val))
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ) (η : Fin N → Fin (n + 1) → ℝ)
  (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0) (B : ℕ)

variable
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)

theorem physical_selected_fine_path_eq_original :
    finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
      (physicalSelectedFineRow (B := B) C aux L σ τ k β V ρ hV ω retention)
      (4 * n + 1) physicalEmptyMemoryTerminal (physicalInitialMarkState B (L 0)) =
      (∏ i ∈ range (2 * n + 1), physicalSelectedCoarseScalar C aux L σ ω i) *
        physicalJointResidueRawHistory C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β
          (fun _ j => 1 - retention j) V (fun _ => ρ) hV B := by
  rw [physical_selected_fine_composition_eq_coarse]
  exact physical_selected_fixed_path_eq_original C aux k L a σ τ hstep ζ hmarks hlist
    hP hdis hk β V ρ hV B ω retention

end ResiduePath
