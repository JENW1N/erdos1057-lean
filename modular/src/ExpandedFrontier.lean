section

/- Actual rough and prime ambient errors assembled from their original active blocks. -/

open Finset Filter
namespace Bounty

theorem eventually_ambient_rough_error_of_active_blocks (D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (μ : ℕ → ℝ) (γ S a v : ℝ),
      (∀ i ∈ dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊),
        ∀ j ∈ dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊),
        let B := shiftedTypeIIBilinear (arithmeticProductWindow 1 (Real.exp L)) μ
          (typeIIRestrict (dyadicNatBucket (Icc 1 ⌊33*Real.exp L⌋₊) i)
            (ambientRoughIntervalTypeIIAlpha γ L S a v))
          (typeIIRestrict (dyadicNatBucket (Icc 1 ⌊33*Real.exp L⌋₊) j)
            (ambientRoughTypeIIBeta (Real.exp (a*L)) (Real.exp (v*L))))
        B ≠ 0 → |B| ≤ Real.exp L * L^(-(D+4))) →
      |ambientRoughProxyError (arithmeticProductWindow 1 (Real.exp L)) μ γ L S
        (Real.exp (a*L)) (Real.exp (v*L))| ≤ Real.exp L * L^(-D) := by
  filter_upwards [eventually_original_bilinear_block_assembly D,eventually_ge_atTop (0 : ℝ)]
    with L hall hL
  intro μ γ S a v hblocks
  rw [ambient_rough_proxy_error_eq_interval_typeII hL]
  exact hall μ _ _ hblocks

theorem eventually_ambient_prime_error_of_active_blocks (D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (μ : ℕ → ℝ) (κ S : ℝ),
      (∀ proxy : Bool, ∀ i ∈ dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊),
        ∀ j ∈ dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊),
        let B := shiftedTypeIIBilinear (arithmeticProductWindow 1 (Real.exp L)) μ
          (typeIIRestrict (dyadicNatBucket (Icc 1 ⌊33*Real.exp L⌋₊) i) (ambientPrimeTypeIIAlpha κ L S))
          (typeIIRestrict (dyadicNatBucket (Icc 1 ⌊33*Real.exp L⌋₊) j)
            (if proxy then ambientProxyTypeIIBeta κ L S else ambientPrimeTypeIIBeta κ L))
        B ≠ 0 → |B| ≤ Real.exp L * L^(-(D+5))) →
      |ambientPrimeProxyError (arithmeticProductWindow 1 (Real.exp L)) μ κ L S| ≤
        Real.exp L * L^(-D) := by
  filter_upwards [eventually_original_bilinear_block_assembly (D+1),eventually_ge_atTop (2 : ℝ)]
    with L hall hL
  intro μ κ S hblocks
  have hL0 : 0 < L := by linarith
  have hf := hall μ (ambientPrimeTypeIIAlpha κ L S) (ambientPrimeTypeIIBeta κ L)
    (by simpa only [Bool.false_eq_true,if_false,show D+1+4=D+5 by ring] using hblocks false)
  have ht := hall μ (ambientPrimeTypeIIAlpha κ L S) (ambientProxyTypeIIBeta κ L S)
    (by simpa only [if_true,show D+1+4=D+5 by ring] using hblocks true)
  have hid : L * L^(-(D+1)) = L^(-D) := by
    conv_lhs => lhs; rw [← Real.rpow_one L]
    rw [← Real.rpow_add hL0]
    congr 1
    ring
  rw [ambient_prime_proxy_error_eq_typeII hL0.le]
  calc
    _ ≤ _ := abs_add_le _ _
    _ ≤ 2*(Real.exp L * L^(-(D+1))) := by linarith [hf,ht]
    _ ≤ L*(Real.exp L * L^(-(D+1))) := mul_le_mul_of_nonneg_right hL (by positivity)
    _ = Real.exp L * (L*L^(-(D+1))) := by ring
    _ = _ := by rw [hid]

end Bounty
end

section

/- At the actual encoded big source, the small residue ledger advances by
the original effective multiplier times the original big divisor. -/

open scoped Classical
namespace Bounty
section Encoded
variable {S I V K : Type} [Fintype S] {N J ell B : ℕ}
  {Ps : S → Finset ℕ} {P : Fin N → Finset ℕ}
  (C : I → Fin N → Finset (Fin J)) (k : K → I → ℤ)
  (t : K) (i : I) (Ls Rs : PhysicalMarkLists Ps J ell)
  (r : PhysicalResidues Ps) (Lb : PhysicalMarkLists P J ell)
  (memory : ∀ g, BoundedOrderedTuple (UnrestrictedResidueParticle (fun p : P g => p.val)) B)
  (e : PhysicalPlannedResidueEvent (V := V) (fun g (p : P g) => p.val)
    (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
    (fun i => PhysicalAuxLabels P (C i))
    (fun t i => physicalMixedEdgeDelta (C i) (k t i))
    (fun _ i => physicalMixedEdgeD (C i))
    (some (.inr (t, i, Ls, Rs))) (physicalFullMemoryState (C i) Lb memory))

theorem physical_planned_small_update_encoded :
    physicalPlannedSmallUpdate (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i => PhysicalAuxLabels P (C i))
      (fun t i => physicalMixedEdgeDelta (C i) (k t i))
      (fun _ i => physicalMixedEdgeD (C i))
      (fun t i => physicalMixedBigStep (C i) (k t i))
      (some (.inr (t, i, Ls, Rs))) r (physicalFullMemoryState (C i) Lb memory) e =
    physicalTranslateResidues r
      ((k t i * (physicalSharedProduct (physicalSharedPrefix Ls) : ℕ)) *
        (physicalD (C i) Lb e.1 : ℕ)) := by
  change physicalTranslateResidues r
    (physicalMixedBigStep (C i) (k t i)
      (productActiveMemorySplit (fun g => physicalFullSharedIndices (C i g)) B
        (physicalFullMemoryState (C i) Lb memory)).1 e.1 *
      (physicalSharedProduct (physicalSharedPrefix Ls) : ℕ)) = _
  rw [physical_mixed_big_step_at_state]
  congr 1
  ring

theorem physical_planned_small_phase_encoded
    (Vs : S → ℝ) (q : K → ℝ)
    (aSmall : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J)))) :
    physicalPlannedSmallPhase (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i => PhysicalAuxLabels P (C i))
      (fun t i => physicalMixedEdgeDelta (C i) (k t i))
      (fun _ i => physicalMixedEdgeD (C i))
      (fun t i => physicalMixedBigStep (C i) (k t i)) Vs q
      (some (.inr (t, i, Ls, Rs))) r (physicalFullMemoryState (C i) Lb memory) e =
    physicalBarePatternScalar Vs (fun _ => (∅ : Finset (Fin J))) 0
      (fun _ _ _ => 1) aSmall Ls Rs *
      ((physicalResidueVertexWeight Ls (Real.sqrt (q t)) r *
        physicalResidueVertexWeight Rs (Real.sqrt (q t))
          (physicalTranslateResidues r
            ((k t i * (physicalSharedProduct (physicalSharedPrefix Ls) : ℕ)) *
              (physicalD (C i) Lb e.1 : ℕ))) : ℝ) : ℂ) := by
  simp only [physicalPlannedSmallPhase]
  erw [physical_planned_small_update_encoded]
  rw [physical_bare_empty_prefix Vs 0 aSmall (fun _ => 1)]
  simp only [physical_phase_zero_frequency, mul_one]
  split_ifs <;> simp only [Complex.ofReal_mul, zero_mul]

end Encoded
end Bounty
end

section

/- The original small residue phase is preserved by exact transport of the
planned big events. Both the auxiliary labels and the ledger are retained. -/

open scoped Classical
namespace Bounty
section Transport
variable {S G I V K : Type} [Fintype S]
  {Ps : S → Finset ℕ} {P : G → Type}
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : I → ∀ g, Finset (Fin (M g))) (B : ℕ) (A : I → Type)
  (Δ Δ' D D' : ∀ _k : K, ∀ i, PhysicalSharedLists Ps J →
    SharedActiveLabels P (shared i) → A i → G → ℤ)
  (hΔ : ∀ k i d, Δ k i d = Δ' k i d)
  (hD : ∀ k i d c a g p, (n g p : ℤ) ∣ D k i d c a g ↔
    (n g p : ℤ) ∣ D' k i d c a g)

noncomputable def physicalPlannedParameterEventEquiv
    (tag : Option (V ⊕ PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K)))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    PhysicalPlannedResidueEvent n shared B A Δ D tag x ≃
      PhysicalPlannedResidueEvent n shared B A Δ' D' tag x :=
  fullPermutationParameterEventEquiv n
    (fun key : PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K) => shared key.2.1)
    B (fun key _ => A key.2.1)
    (fun key => Δ key.1 key.2.1 (physicalSharedPrefix key.2.2.1))
    (fun key => Δ' key.1 key.2.1 (physicalSharedPrefix key.2.2.1))
    (fun key => D key.1 key.2.1 (physicalSharedPrefix key.2.2.1))
    (fun key => D' key.1 key.2.1 (physicalSharedPrefix key.2.2.1))
    (fun key => hΔ key.1 key.2.1 (physicalSharedPrefix key.2.2.1))
    (fun key => hD key.1 key.2.1 (physicalSharedPrefix key.2.2.1)) tag x

noncomputable def physicalPlannedParameterPathEquiv
    (steps : List (Option (V ⊕ PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K))))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    FiniteEventPath (PhysicalPlannedResidueEvent n shared B A Δ D)
      (physicalPlannedResidueTarget n shared B A Δ D) steps x ≃
    FiniteEventPath (PhysicalPlannedResidueEvent n shared B A Δ' D')
      (physicalPlannedResidueTarget n shared B A Δ' D') steps x :=
  fullPermutationParameterPathEquiv n
    (fun key : PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K) => shared key.2.1)
    B (fun key _ => A key.2.1)
    (fun key => Δ key.1 key.2.1 (physicalSharedPrefix key.2.2.1))
    (fun key => Δ' key.1 key.2.1 (physicalSharedPrefix key.2.2.1))
    (fun key => D key.1 key.2.1 (physicalSharedPrefix key.2.2.1))
    (fun key => D' key.1 key.2.1 (physicalSharedPrefix key.2.2.1))
    (fun key => hΔ key.1 key.2.1 (physicalSharedPrefix key.2.2.1))
    (fun key => hD key.1 key.2.1 (physicalSharedPrefix key.2.2.1)) steps x

variable (kbig : ∀ _k : K, ∀ i, SharedActiveLabels P (shared i) → A i → ℤ)

theorem physical_planned_small_update_transport
    (tag : Option (V ⊕ PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K)))
    (r : PhysicalResidues Ps)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : PhysicalPlannedResidueEvent n shared B A Δ D tag x) :
    physicalPlannedSmallUpdate n shared B A Δ' D' kbig tag r x
        (physicalPlannedParameterEventEquiv n shared B A Δ Δ' D D' hΔ hD tag x e) =
      physicalPlannedSmallUpdate n shared B A Δ D kbig tag r x e := by
  cases tag with
  | none => rfl
  | some tag =>
    cases tag with
    | inl v => rfl
    | inr key =>
      dsimp only [physicalPlannedSmallUpdate, physicalPlannedParameterEventEquiv,
        fullPermutationParameterEventEquiv]
      erw [full_active_parameter_auxiliary]

theorem physical_planned_small_phase_transport
    (Vs : S → ℝ) (qedge : K → ℝ)
    (tag : Option (V ⊕ PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K)))
    (r : PhysicalResidues Ps)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : PhysicalPlannedResidueEvent n shared B A Δ D tag x) :
    physicalPlannedSmallPhase n shared B A Δ' D' kbig Vs qedge tag r x
        (physicalPlannedParameterEventEquiv n shared B A Δ Δ' D D' hΔ hD tag x e) =
      physicalPlannedSmallPhase n shared B A Δ D kbig Vs qedge tag r x e := by
  cases tag with
  | none => rfl
  | some tag =>
    cases tag with
    | inl v => rfl
    | inr key =>
      dsimp only [physicalPlannedSmallPhase]
      rw [physical_planned_small_update_transport]

theorem physical_planned_small_ledger_transport
    (Vs : S → ℝ) (qedge : K → ℝ)
    (steps : List (Option (V ⊕ PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K))))
    (r : PhysicalResidues Ps)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FiniteEventPath (PhysicalPlannedResidueEvent n shared B A Δ D)
      (physicalPlannedResidueTarget n shared B A Δ D) steps x) :
    deterministicLedgerPhase (PhysicalPlannedResidueEvent n shared B A Δ' D')
        (physicalPlannedResidueTarget n shared B A Δ' D')
        (physicalPlannedSmallUpdate n shared B A Δ' D' kbig)
        (physicalPlannedSmallPhase n shared B A Δ' D' kbig Vs qedge) steps r x
        (physicalPlannedParameterPathEquiv n shared B A Δ Δ' D D' hΔ hD steps x p) =
      deterministicLedgerPhase (PhysicalPlannedResidueEvent n shared B A Δ D)
        (physicalPlannedResidueTarget n shared B A Δ D)
        (physicalPlannedSmallUpdate n shared B A Δ D kbig)
        (physicalPlannedSmallPhase n shared B A Δ D kbig Vs qedge) steps r x p := by
  exact deterministic_ledger_phase_equiv _ _ _ _ id _ _ _ _
    (physical_planned_small_update_transport n shared B A Δ Δ' D D' hΔ hD kbig)
    _ _ (physical_planned_small_phase_transport n shared B A Δ Δ' D D' hΔ hD kbig Vs qedge)
    steps r x p

theorem physical_mixed_plan_small_factor_transport
    (Vs : S → ℝ) (qedge : K → ℝ)
    (ks : List (Option (V ⊕ K))) (r : PhysicalResidues Ps) (L : PhysicalMarkLists Ps J ell)
    (pl : PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) ks)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : PhysicalMixedPlannedBigPath n shared B A Δ D ks L pl x) :
    (physicalMixedPlanSmallFactor n shared B A Δ D kbig Vs qedge ks r L pl x p : ℂ) =
      deterministicLedgerPhase (PhysicalPlannedResidueEvent n shared B A Δ' D')
        (physicalPlannedResidueTarget n shared B A Δ' D')
        (physicalPlannedSmallUpdate n shared B A Δ' D' kbig)
        (physicalPlannedSmallPhase n shared B A Δ' D' kbig Vs qedge)
        (physicalMixedBigSteps ks L pl) r x
        (physicalPlannedParameterPathEquiv n shared B A Δ Δ' D D' hΔ hD
          (physicalMixedBigSteps ks L pl) x p) := by
  rw [physical_planned_small_ledger_transport, physical_mixed_plan_small_factor_eq_ledger]

end Transport
end Bounty
