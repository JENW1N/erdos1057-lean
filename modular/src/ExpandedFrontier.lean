theorem physical_full_split_state_eq {G : Type*} {P : G → Finset ℕ}
    {Z : G → Type*} {J ell B : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (q : ∀ g, BoundedOrderedTuple (Z g) B) (g : G) :
    (productActiveMemorySplit (fun g => physicalFullSharedIndices (C g)) B
      (physicalFullMemoryState C L q)).2 g =
    ((activeEmbeddingSizeCast (physical_full_unshared_indices_card (ell := ell) (C g)).symm
      (physicalGroupUnsharedEmbedding C L g) : Fin (physicalFullSharedIndices (C g))ᶜ.card → ↥(P g)), q g) := by
  apply Prod.ext
  · rw [physical_full_memory_state_unshared]
    funext i
    symm
    exact active_embedding_size_cast_apply _ _ i
  · rfl

theorem physical_full_split_edge_bounded_events {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell B : ℕ} (C : G → Finset (Fin J))
    (L R : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C)
    (hlist : physicalListAdmissible C aux L R)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (a b k : ℤ) (hstep : b = a + k * (physicalD C L aux : ℤ))
    (q : ∀ g, BoundedOrderedTuple (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B)
    (g : G) (H : Finset ↥(P g)) (β : ↥(P g) → ℝ) (ρ V : ℝ)
    (F : Finset ↥(P g) →
      FiniteOrderedTuple (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) → ℂ) :
    let np := fun p : ↥(P g) => p.val
    let D : ℤ := physicalD C L aux
    let Δ := -k * D
    let S := fun g => physicalFullSharedIndices (ell := ell) (C g)
    let x := (productActiveMemorySplit S B (physicalFullMemoryState C L q)).2 g
    let y := (productActiveMemorySplit S B (physicalFullMemoryState C R q)).2 g
    globalBirthEdgeRawRow (physicalGroupUnsharedEmbedding C L g)
      (physicalGroupUnsharedEmbedding C R g) (physicalGroupPhaseDelta a b g) H (q g).2
      (globalBirthRawHitIndices (physicalGroupPhaseDelta a b g)
        (boundedOrderedTupleToFinite (q g))) β ρ V B F =
    ∑ e : UnrestrictedBoundedEvent np Δ D (S g)ᶜ.card B x,
      (unrestrictedBoundedEventWeight np Δ D (fun p => β p / V) ρ V (S g)ᶜ.card B x e : ℂ) *
      globalBirthBoundedEdgePhase np Δ D (S g)ᶜ.card B y.1 H x
        e.1 e.2.1 e.2.2.1 e.2.2.2 *
      F (H ∪ univ.image (unrestrictedBoundedEventTarget np Δ D (S g)ᶜ.card B x e).1)
        (boundedOrderedTupleToFinite (unrestrictedBoundedEventTarget np Δ D (S g)ᶜ.card B x e).2) := by
  dsimp only
  rw [physical_full_split_state_eq C L q g, physical_full_split_state_eq C R q g]
  have hδ := physical_group_phase_delta_as_integer_step (P := P)
    a b k (physicalD C L aux : ℤ) hstep g
  simpa only [hδ] using global_birth_bounded_edge_events_size_cast
    (fun p : ↥(P g) => p.val) (-k * (physicalD C L aux : ℤ)) (physicalD C L aux : ℤ)
    (physical_full_unshared_indices_card (ell := ell) (C g)).symm B
    (physicalGroupUnsharedEmbedding C L g) (physicalGroupUnsharedEmbedding C R g)
    (physical_group_unshared_source_not_dvd C L aux hP hdis hlist.2.1 g)
    (physical_group_unshared_target_not_dvd C L R aux hlist hP hdis g)
    H (q g) β ρ V F
end

