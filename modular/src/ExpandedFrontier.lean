open Finset
open scoped Classical

/-- The lifespan density error is controlled in the true untilted active product
measure. The probability row and weighted column bounds are proved from the kernel. -/
theorem repeated_big_lifespan_density_operator_error {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (hbpos : ∀ g p, 0 < b g p) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (B : ℝ) (hB : 0 ≤ B) (hK : ∀ x y a, ‖K x y a‖ ≤ B)
    {T Pmin : ℝ} (hT : 0 ≤ T) (hPmin : 0 < Pmin)
    (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (hb : ∀ g (p : P g), b g p = 1 - T / (p.val : ℝ))
    (hsmall : ((2 * ∑ g, (ell + (C g).card) : ℕ) : ℝ) * T / Pmin ≤ 1 / 2)
    (f : RepeatedBigLists P J ell → ℂ) :
    cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
        (fun source => ∑ target,
          (((Real.sqrt (cleanActiveDensity b source) /
              Real.sqrt (cleanActiveDensity b target) : ℝ) : ℂ) *
            (∑ aux, repeatedBigKernel V b C ζ K aux source target) -
              ∑ aux, repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target) * f target) ≤
      ((((2 * ∑ g, (ell + (C g).card) : ℕ) : ℝ) * T / Pmin) * B) *
        cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f := by
  have hη : 0 ≤ ((2 * ∑ g, (ell + (C g).card) : ℕ) : ℝ) * T / Pmin :=
    div_nonneg (mul_nonneg (Nat.cast_nonneg _) hT) hPmin.le
  apply repeated_big_dominated_schur V C hV hMass ζ K B hB hK _ _ hη _ f
  intro source target
  rw [mul_sum, ← sum_sub_distrib]
  calc
    _ ≤ ∑ aux, ‖((Real.sqrt (cleanActiveDensity b source) /
        Real.sqrt (cleanActiveDensity b target) : ℝ) : ℂ) *
          repeatedBigKernel V b C ζ K aux source target -
          repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target‖ := norm_sum_le _ _
    _ ≤ ∑ aux, (((2 * ∑ g, (ell + (C g).card) : ℕ) : ℝ) * T / Pmin) *
        ‖repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target‖ := by
      exact sum_le_sum (fun aux _ => repeated_big_kernel_lifespan_density_error
        V b hbpos C ζ K aux source target hT hPmin hp hb hsmall)
    _ = _ := (mul_sum _ _ _).symm
end

