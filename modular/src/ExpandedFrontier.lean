section
open scoped BigOperators Classical
theorem finite_full_list_map_perm {I : Type*} [DecidableEq I]
    (is : List I) (hnodup : is.Nodup) (hall : ∀ i, i ∈ is) (σ : Equiv.Perm I) :
    (is.map σ).Perm is := by
  apply (List.perm_ext_iff_of_nodup (hnodup.map σ.injective) hnodup).mpr
  intro i
  constructor
  · intro _; exact hall i
  · intro _
    exact List.mem_map.mpr ⟨σ.symm i, hall _, σ.apply_symm_apply i⟩

theorem exists_perm_map_finset_of_card_eq {I : Type*} [Fintype I] [DecidableEq I]
    (S T : Finset I) (hcard : S.card = T.card) :
    ∃ σ : Equiv.Perm I, S.map σ.toEmbedding = T := by
  let e : S ≃ T := Finset.equivOfCardEq hcard
  let σ := e.extendSubtype
  refine ⟨σ, Finset.eq_of_subset_of_card_le ?_ ?_⟩
  · intro y hy
    obtain ⟨x, hx, rfl⟩ := Finset.mem_map.mp hy
    exact e.extendSubtype_mem x hx
  · simpa only [Finset.card_map] using hcard.ge

theorem finite_symmetric_component_energy_map {I X : Type*}
    [Fintype I] [DecidableEq I] [Fintype X]
    (μ : X → ℝ) (is : List I) (hnodup : is.Nodup) (hall : ∀ i, i ∈ is)
    (S : Finset I) (σ : Equiv.Perm I) (f : (I → X) → ℂ)
    (hsym : finiteSlotPermute σ f = f) :
    finiteWeightedEnergy (finiteProductWeight (fun _ : I => μ))
        (finiteCoordinateComponent (fun _ : I => μ) (S.map σ.toEmbedding) is f) =
      finiteWeightedEnergy (finiteProductWeight (fun _ : I => μ))
        (finiteCoordinateComponent (fun _ : I => μ) S is f) := by
  have hc := finite_slot_component_covariant μ σ S is f
  rw [hsym, finite_coordinate_component_perm (fun _ : I => μ) _
    (finite_full_list_map_perm is hnodup hall σ)] at hc
  rw [hc, finite_slot_energy_invariant]

theorem finite_symmetric_component_energy_card {I X : Type*}
    [Fintype I] [DecidableEq I] [Fintype X]
    (μ : X → ℝ) (is : List I) (hnodup : is.Nodup) (hall : ∀ i, i ∈ is)
    (S T : Finset I) (hcard : S.card = T.card) (f : (I → X) → ℂ)
    (hsym : ∀ σ : Equiv.Perm I, finiteSlotPermute σ f = f) :
    finiteWeightedEnergy (finiteProductWeight (fun _ : I => μ))
        (finiteCoordinateComponent (fun _ : I => μ) S is f) =
      finiteWeightedEnergy (finiteProductWeight (fun _ : I => μ))
        (finiteCoordinateComponent (fun _ : I => μ) T is f) := by
  obtain ⟨σ, hσ⟩ := exists_perm_map_finset_of_card_eq S T hcard
  have h := finite_symmetric_component_energy_map μ is hnodup hall S σ f (hsym σ)
  rw [hσ] at h
  exact h.symm
end

section
open scoped BigOperators Classical
def retainsProbes {I : Type*} [DecidableEq I] (A B S : Finset I) : Prop :=
  A ⊆ S ∧ Disjoint S B

noncomputable def retainedSubsets {I : Type*} [DecidableEq I]
    (Ω A B : Finset I) (j : ℕ) : Finset (Finset I) :=
  (Ω.powersetCard j).filter (retainsProbes A B)

theorem retained_subsets_sdiff {I : Type*} [DecidableEq I]
    (Ω A B : Finset I) (j : ℕ) :
    retainedSubsets Ω A B j = ((Ω \ B).powersetCard j).filter (A ⊆ ·) := by
  ext S
  simp only [retainedSubsets, Finset.mem_filter, Finset.mem_powersetCard, retainsProbes]
  constructor
  · rintro ⟨⟨hS, hj⟩, hA, hB⟩
    exact ⟨⟨fun x hx => Finset.mem_sdiff.mpr ⟨hS hx, fun hb => Finset.disjoint_left.mp hB hx hb⟩, hj⟩, hA⟩
  · rintro ⟨⟨hS, hj⟩, hA⟩
    exact ⟨⟨hS.trans Finset.sdiff_subset, hj⟩, hA,
      Finset.disjoint_left.mpr (fun x hx hb => (Finset.mem_sdiff.mp (hS hx)).2 hb)⟩

theorem retained_subsets_card {I : Type*} [DecidableEq I]
    (Ω A B : Finset I) (j : ℕ) (hA : A ⊆ Ω) (hB : B ⊆ Ω)
    (hAB : Disjoint A B) (hj : A.card ≤ j) :
    (retainedSubsets Ω A B j).card =
      (Ω.card - A.card - B.card).choose (j - A.card) := by
  have hAs : A ⊆ Ω \ B := fun x hx =>
    Finset.mem_sdiff.mpr ⟨hA hx, fun hb => Finset.disjoint_left.mp hAB hx hb⟩
  rw [retained_subsets_sdiff, Finset.card_filter_powersetCard_subset A (Ω \ B) j hAs hj,
    Finset.card_sdiff_of_subset hB]
  congr 1
  omega

theorem retained_subsets_feasible {I : Type*} [DecidableEq I]
    (Ω A B : Finset I) (j : ℕ) (hB : B ⊆ Ω) (hne : (retainedSubsets Ω A B j).Nonempty) :
    A.card ≤ j ∧ j + B.card ≤ Ω.card := by
  obtain ⟨S, hS⟩ := hne
  obtain ⟨⟨hSΩ, hj⟩, hAS, hSB⟩ := (show (S ⊆ Ω ∧ S.card = j) ∧ A ⊆ S ∧ Disjoint S B from by
    simpa only [retainedSubsets, Finset.mem_filter, Finset.mem_powersetCard, retainsProbes] using hS)
  refine ⟨hj ▸ Finset.card_le_card hAS, ?_⟩
  have hc := Finset.card_le_card (Finset.union_subset hSΩ hB)
  rwa [Finset.card_union_of_disjoint hSB, hj] at hc

theorem retained_subsets_card_mul_le {I : Type*} [DecidableEq I]
    (Ω A B : Finset I) (j : ℕ) (hA : A ⊆ Ω) (hB : B ⊆ Ω) (hAB : Disjoint A B) :
    (retainedSubsets Ω A B j).card * A.card ^ B.card ≤
      B.card ^ B.card * (Ω.card).choose j := by
  by_cases hne : (retainedSubsets Ω A B j).Nonempty
  · obtain ⟨hmj, hjM⟩ := retained_subsets_feasible Ω A B j hB hne
    rw [retained_subsets_card Ω A B j hA hB hAB hmj]
    have hp := hoeffding_probe_power_le_choose A.card B.card
    have hv := hoeffding_retained_choose_mul_le Ω.card A.card B.card j hmj hjM
    calc
      _ ≤ (Ω.card - A.card - B.card).choose (j - A.card) *
          (B.card ^ B.card * (A.card + B.card).choose A.card) := Nat.mul_le_mul_left _ hp
      _ = B.card ^ B.card * ((Ω.card - A.card - B.card).choose (j - A.card) *
          (A.card + B.card).choose A.card) := by ring
      _ ≤ _ := Nat.mul_le_mul_left _ hv
  · rw [Finset.not_nonempty_iff_eq_empty.mp hne, Finset.card_empty, zero_mul]
    exact Nat.zero_le _

theorem retained_subsets_card_le {I : Type*} [DecidableEq I]
    (Ω A B : Finset I) (j : ℕ) (hA : A ⊆ Ω) (hB : B ⊆ Ω)
    (hAB : Disjoint A B) (hm : 0 < A.card) :
    ((retainedSubsets Ω A B j).card : ℝ) ≤
      ((B.card : ℝ) ^ B.card / (A.card : ℝ) ^ B.card) * ((Ω.powersetCard j).card : ℝ) := by
  have hmR : (0 : ℝ) < A.card := by exact_mod_cast hm
  have hc : ((retainedSubsets Ω A B j).card : ℝ) * (A.card : ℝ) ^ B.card ≤
      (B.card : ℝ) ^ B.card * ((Ω.card).choose j : ℝ) := by
    exact_mod_cast retained_subsets_card_mul_le Ω A B j hA hB hAB
  rw [Finset.card_powersetCard, div_mul_eq_mul_div]
  exact (le_div_iff₀ (pow_pos hmR B.card)).mpr hc
end

section
open scoped BigOperators Classical
theorem finite_constant_subset_sum_le {J : Type*} (s t : Finset J) (hst : s ⊆ t)
    (e : J → ℝ) (he : ∀ j ∈ t, 0 ≤ e j)
    (hconst : ∀ i ∈ t, ∀ j ∈ t, e i = e j) {θ : ℝ}
    (hcard : (s.card : ℝ) ≤ θ * (t.card : ℝ)) :
    (∑ i ∈ s, e i) ≤ θ * ∑ i ∈ t, e i := by
  by_cases ht : t.Nonempty
  · obtain ⟨j, hj⟩ := ht
    have hs : (∑ i ∈ s, e i) = (s.card : ℝ) * e j := by
      calc
        _ = ∑ _i ∈ s, e j := Finset.sum_congr rfl (fun i hi => hconst i (hst hi) j hj)
        _ = _ := by simp
    have ht' : (∑ i ∈ t, e i) = (t.card : ℝ) * e j := by
      calc
        _ = ∑ _i ∈ t, e j := Finset.sum_congr rfl (fun i hi => hconst i hi j hj)
        _ = _ := by simp
    rw [hs, ht', ← mul_assoc]
    exact mul_le_mul_of_nonneg_right hcard (he j hj)
  · have ht' := Finset.not_nonempty_iff_eq_empty.mp ht
    have hs := Finset.subset_empty.mp (ht' ▸ hst)
    simp only [ht', hs, Finset.sum_empty, mul_zero, le_refl]

theorem finite_powerset_sum_by_card {I : Type*} (Ω : Finset I) (e : Finset I → ℝ) :
    (∑ S ∈ Ω.powerset, e S) =
      ∑ j ∈ Finset.range (Ω.card + 1), ∑ S ∈ Ω.powersetCard j, e S := by
  have hm : Set.MapsTo (fun S : Finset I => S.card) (↑Ω.powerset) (↑(Finset.range (Ω.card + 1))) := by
    intro S hS
    exact Finset.mem_range.mpr (Nat.lt_succ_of_le (Finset.card_le_card (Finset.mem_powerset.mp hS)))
  rw [← Finset.sum_fiberwise_of_maps_to hm e]
  apply Finset.sum_congr rfl
  intro j _
  rw [Finset.powersetCard_eq_filter]

theorem finite_retained_sum_by_card {I : Type*} [DecidableEq I]
    (Ω A B : Finset I) (e : Finset I → ℝ) :
    (∑ S ∈ Ω.powerset.filter (retainsProbes A B), e S) =
      ∑ j ∈ Finset.range (Ω.card + 1), ∑ S ∈ retainedSubsets Ω A B j, e S := by
  have hm : Set.MapsTo (fun S : Finset I => S.card) (↑(Ω.powerset.filter (retainsProbes A B)))
      (↑(Finset.range (Ω.card + 1))) := by
    intro S hS
    exact Finset.mem_range.mpr (Nat.lt_succ_of_le (Finset.card_le_card
      (Finset.mem_powerset.mp (Finset.mem_filter.mp hS).1)))
  rw [← Finset.sum_fiberwise_of_maps_to hm e]
  apply Finset.sum_congr rfl
  intro j _
  unfold retainedSubsets
  rw [Finset.powersetCard_eq_filter, Finset.filter_comm]

theorem finite_symmetric_subset_retention_bound {I : Type*} [DecidableEq I]
    (Ω A B : Finset I) (hA : A ⊆ Ω) (hB : B ⊆ Ω) (hAB : Disjoint A B)
    (hm : 0 < A.card) (e : Finset I → ℝ)
    (he : ∀ S ⊆ Ω, 0 ≤ e S)
    (hconst : ∀ S ⊆ Ω, ∀ T ⊆ Ω, S.card = T.card → e S = e T) :
    (∑ S ∈ Ω.powerset.filter (retainsProbes A B), e S) ≤
      ((B.card : ℝ) ^ B.card / (A.card : ℝ) ^ B.card) * ∑ S ∈ Ω.powerset, e S := by
  rw [finite_retained_sum_by_card, finite_powerset_sum_by_card, Finset.mul_sum]
  apply Finset.sum_le_sum
  intro j _
  refine finite_constant_subset_sum_le (retainedSubsets Ω A B j) (Ω.powersetCard j)
    (Finset.filter_subset _ _) e ?_ ?_ (retained_subsets_card_le Ω A B j hA hB hAB hm)
  · intro S hS
    exact he S (Finset.mem_powersetCard.mp hS).1
  · intro S hS T hT
    obtain ⟨hSΩ, hSj⟩ := Finset.mem_powersetCard.mp hS
    obtain ⟨hTΩ, hTj⟩ := Finset.mem_powersetCard.mp hT
    exact hconst S hSΩ T hTΩ (hSj.trans hTj.symm)
end

section
open scoped BigOperators Classical
theorem coordinate_pattern_matches_probes {I : Type*} [DecidableEq I]
    (A B S : Finset I) (hAB : Disjoint A B) :
    finiteCoordinatePatternMatches A (A ∪ B).toList S ↔ retainsProbes A B S := by
  constructor
  · intro h
    refine ⟨?_, Finset.disjoint_left.mpr ?_⟩
    · intro i hi
      exact (h i (Finset.mem_toList.mpr (Finset.mem_union_left B hi))).mp hi
    · intro i hiS hiB
      have hiA := (h i (Finset.mem_toList.mpr (Finset.mem_union_right A hiB))).mpr hiS
      exact Finset.disjoint_left.mp hAB hiA hiB
  · rintro ⟨hA, hB⟩ i hi
    have hu := Finset.mem_toList.mp hi
    constructor
    · exact fun hiA => hA hiA
    · intro hiS
      rcases Finset.mem_union.mp hu with hiA | hiB
      · exact hiA
      · exact (Finset.disjoint_left.mp hB hiS hiB).elim

theorem finite_symmetric_probe_energy {I X : Type*}
    [Fintype I] [DecidableEq I] [Fintype X]
    (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (hmass : ∑ x, μ x = 1)
    (A B : Finset I) (hAB : Disjoint A B) (hm : 0 < A.card)
    (f : (I → X) → ℂ) (hsym : ∀ σ : Equiv.Perm I, finiteSlotPermute σ f = f) :
    finiteWeightedEnergy (finiteProductWeight (fun _ : I => μ))
      (finiteCoordinateComponent (fun _ : I => μ) A (A ∪ B).toList f) ≤
      ((B.card : ℝ) ^ B.card / (A.card : ℝ) ^ B.card) *
        finiteWeightedEnergy (finiteProductWeight (fun _ : I => μ)) f := by
  let is := (Finset.univ : Finset I).toList
  have hn : is.Nodup := Finset.nodup_toList _
  have hall : ∀ i, i ∈ is := by intro i; simp [is]
  have hset : is.toFinset = Finset.univ := by simp [is]
  let e : Finset I → ℝ := fun S => finiteWeightedEnergy (finiteProductWeight (fun _ : I => μ))
    (finiteCoordinateComponent (fun _ : I => μ) S is f)
  have he : ∀ S ⊆ (Finset.univ : Finset I), 0 ≤ e S := by
    intro S _
    exact Finset.sum_nonneg (fun x _ => mul_nonneg
      (Finset.prod_nonneg (fun i _ => hμ (x i))) (sq_nonneg _))
  have hc : ∀ S ⊆ (Finset.univ : Finset I), ∀ T ⊆ Finset.univ, S.card = T.card → e S = e T := by
    intro S _ T _ hST
    exact finite_symmetric_component_energy_card μ is hn hall S T hST f hsym
  have htotal : (∑ S ∈ (Finset.univ : Finset I).powerset, e S) =
      finiteWeightedEnergy (finiteProductWeight (fun _ : I => μ)) f := by
    simpa only [hset] using finite_coordinate_component_energy_sum (fun _ : I => μ)
      (fun _ x => hμ x) (fun _ => hmass) is hn f
  have hb := finite_symmetric_subset_retention_bound (Finset.univ : Finset I) A B
    (Finset.subset_univ A) (Finset.subset_univ B) hAB hm e he hc
  rw [htotal] at hb
  have hfilter : is.toFinset.powerset.filter (finiteCoordinatePatternMatches A (A ∪ B).toList) =
      (Finset.univ : Finset I).powerset.filter (retainsProbes A B) := by
    rw [hset]
    exact Finset.filter_congr (fun S _ => coordinate_pattern_matches_probes A B S hAB)
  rw [finite_coordinate_retained_energy (fun _ : I => μ) (fun _ x => hμ x)
    (fun _ => hmass) A is (A ∪ B).toList hn (fun i _ => hall i), hfilter]
  exact hb
end

section
open Finset
theorem seeded_tuple_sum {P Z : Type*} [Fintype P] [Fintype Z]
    (seed : P → Z) (label : Z → P) (hseed : Function.LeftInverse label seed)
    (w : Z → ℝ) (hw : ∀ z, seed (label z) ≠ z → w z = 0)
    (b : ℕ) (F : (Fin b → Z) → ℂ) :
    (∑ f : Fin b → P, ((∏ j, w (seed (f j)) : ℝ) : ℂ) * F (fun j => seed (f j))) =
      ∑ q : Fin b → Z, ((∏ j, w (q j) : ℝ) : ℂ) * F q := by
  classical
  let e : (Fin b → P) → (Fin b → Z) := fun f j => seed (f j)
  have he : Function.Injective e := by
    intro f g h
    funext j
    exact hseed.injective (congrFun h j)
  apply Fintype.sum_of_injective e he
  · intro q hq
    have h : ¬ ∀ j, seed (label (q j)) = q j := by
      intro hh
      exact hq ⟨fun j => label (q j), funext hh⟩
    obtain ⟨j, hj⟩ := not_forall.mp h
    have hz : (∏ k, w (q k)) = 0 := prod_eq_zero (mem_univ j) (hw _ hj)
    simp only [hz, Complex.ofReal_zero, zero_mul]
  · intro f
    rfl

theorem physical_ghost_seed_birth_weight {P : Type*} (n : P → ℕ)
    (β : P → ℝ) (η V ρ : ℝ) (p : P) :
    physicalGhostBirth n (1 - η) ρ V (unrestrictedResidueSeed n p) *
      unrestrictedResidueWeight (fun p => β p / V) (unrestrictedResidueSeed n p) =
      (-η * V / ρ) * (β p / V) := by
  unfold physicalGhostBirth
  split_ifs with h
  · simp only [unrestrictedResidueWeight, unrestrictedResidueSeed]
    ring
  · exact False.elim (h rfl)

theorem physical_ghost_birth_tuple_sum {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (β : P → ℝ) (η V ρ : ℝ)
    (b : ℕ) (F : (Fin b → UnrestrictedResidueParticle n) → ℂ) :
    (∑ f : Fin b → P, (((-η * V / ρ) ^ b * (∏ j, β (f j) / V) : ℝ) : ℂ) *
      F (fun j => unrestrictedResidueSeed n (f j))) =
    ∑ q : Fin b → UnrestrictedResidueParticle n,
      ((∏ j, physicalGhostBirth n (1 - η) ρ V (q j) *
        unrestrictedResidueWeight (fun p => β p / V) (q j) : ℝ) : ℂ) * F q := by
  have he := seeded_tuple_sum (unrestrictedResidueSeed n) Sigma.fst (fun _ => rfl)
    (fun z => physicalGhostBirth n (1 - η) ρ V z *
      unrestrictedResidueWeight (fun p => β p / V) z) (by
        rintro ⟨p, r⟩ h
        have hr : r ≠ 0 := by
          intro hr
          subst r
          exact h rfl
        unfold physicalGhostBirth
        split_ifs with hz
        · exact False.elim (hr hz)
        · exact zero_mul _) b F
  simpa only [physical_ghost_seed_birth_weight, prod_mul_distrib, prod_const,
    card_univ, Fintype.card_fin] using he
end

section
open Finset
theorem physical_ghost_retained_coefficient {P : Type*} (n : P → ℕ)
    {N : ℕ} (old : Fin N → UnrestrictedResidueParticle n)
    (η ρ : ℝ) (T : Finset (Fin N)) :
    (∏ j ∈ univ \ T, physicalGhostRetention n (1 - η) ρ (old j)) =
      ((1 - η) / ρ ^ 2) ^ (globalBirthVisitZeroIndices (fun _ => 0) old \ T).card := by
  classical
  have he (j : Fin N) : physicalGhostRetention n (1 - η) ρ (old j) =
      if j ∈ globalBirthVisitZeroIndices (fun _ => 0) old then (1 - η) / ρ ^ 2 else 1 := by
    unfold physicalGhostRetention
    split_ifs with h1 h2 h2
    · rfl
    · exact False.elim (h2 (mem_filter.mpr ⟨mem_univ _, h1⟩))
    · exact False.elim (h1 (mem_filter.mp h2).2)
    · rfl
  simp_rw [he]
  rw [Finset.prod_ite_mem, prod_const]
  congr 1
  congr 1
  ext j
  simp only [mem_inter, mem_sdiff, mem_univ, true_and]
  exact and_comm

theorem physical_ghost_terminated_coefficient {P : Type*} (n : P → ℕ)
    {N : ℕ} (old : Fin N → UnrestrictedResidueParticle n)
    (η ρ : ℝ) (T : Finset (Fin N))
    (hT : T ⊆ globalBirthVisitZeroIndices (fun _ => 0) old) :
    (∏ j ∈ T, physicalGhostTermination n (1 - η) ρ (old j)) = (-η / ρ) ^ T.card := by
  classical
  calc
    _ = ∏ _j ∈ T, (-η / ρ) := by
      apply prod_congr rfl
      intro j hj
      have hz := (mem_filter.mp (hT hj)).2
      unfold physicalGhostTermination
      split_ifs with h
      · ring
      · exact False.elim (h hz)
    _ = _ := prod_const _

theorem physical_ghost_terminated_coefficient_zero {P : Type*} (n : P → ℕ)
    {N : ℕ} (old : Fin N → UnrestrictedResidueParticle n)
    (η ρ : ℝ) (T : Finset (Fin N))
    (hT : ¬ T ⊆ globalBirthVisitZeroIndices (fun _ => 0) old) :
    (∏ j ∈ T, physicalGhostTermination n (1 - η) ρ (old j)) = 0 := by
  classical
  obtain ⟨j, hj, hz⟩ := not_subset.mp hT
  apply prod_eq_zero hj
  have hr : (old j).2 ≠ 0 := by
    simpa only [globalBirthVisitZeroIndices, mem_filter, mem_univ, true_and] using hz
  unfold physicalGhostTermination
  split_ifs with h
  · exact False.elim (hr h)
  · rfl

theorem physical_ghost_old_event_coefficient {P : Type*} (n : P → ℕ)
    {N : ℕ} (old : Fin N → UnrestrictedResidueParticle n)
    (η ρ : ℝ) (T : Finset (Fin N))
    (hT : T ⊆ globalBirthVisitZeroIndices (fun _ => 0) old) :
    (∏ j ∈ univ \ T, physicalGhostRetention n (1 - η) ρ (old j)) *
      (∏ j ∈ T, physicalGhostTermination n (1 - η) ρ (old j)) =
    (-η / ρ) ^ T.card * ((1 - η) / ρ ^ 2) ^
      (globalBirthVisitZeroIndices (fun _ => 0) old \ T).card := by
  rw [physical_ghost_retained_coefficient, physical_ghost_terminated_coefficient n old η ρ T hT,
    mul_comm]
end

section
open Finset Classical
section

variable {G : Type*} {P : G → Type*}
  (n : ∀ g, P g → ℕ) {M : G → ℕ}
  (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : SharedActiveLabels P S → Type*)
  (Δ D : ∀ c, A c → G → ℤ)

abbrev FullActiveEdgeEvent
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :=
  Σ a : A (productActiveMemorySplit S B x).1,
    UnrestrictedJointEvent n (Δ (productActiveMemorySplit S B x).1 a)
      (D (productActiveMemorySplit S B x).1 a) (fun g => (S g)ᶜ.card) B
      (productActiveMemorySplit S B x).2

noncomputable abbrev fullActiveEdgeEventFintype [Fintype G] [∀ g, Fintype (P g)]
    [∀ g p, NeZero (n g p)] [∀ c, Fintype (A c)]
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    Fintype (FullActiveEdgeEvent n S B A Δ D x) := inferInstance

noncomputable def fullActiveEdgeEventTarget
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullActiveEdgeEvent n S B A Δ D x) :
    ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B :=
  (productActiveMemorySplit S B).symm ((productActiveMemorySplit S B x).1,
    unrestrictedJointEventTarget n (Δ (productActiveMemorySplit S B x).1 e.1)
      (D (productActiveMemorySplit S B x).1 e.1) (fun g => (S g)ᶜ.card) B
      (productActiveMemorySplit S B x).2 e.2)

noncomputable def fullActiveEdgeEventWeight [Fintype G]
    (ω : ∀ c, A c → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullActiveEdgeEvent n S B A Δ D x) : ℝ :=
  ω (productActiveMemorySplit S B x).1 e.1 *
    unrestrictedJointCutoffEventWeight n (Δ (productActiveMemorySplit S B x).1 e.1)
      (D (productActiveMemorySplit S B x).1 e.1) μ ρ V (fun g => (S g)ᶜ.card) B
      (productActiveMemorySplit S B x).2 e.2

theorem fullActiveEdgeEventWeight_nonneg [Fintype G]
    (ω : ∀ c, A c → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (hω : ∀ c a, 0 ≤ ω c a) (hμ : ∀ g p, 0 ≤ μ g p)
    (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ V g)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullActiveEdgeEvent n S B A Δ D x) :
    0 ≤ fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V x e := by
  exact mul_nonneg (hω _ _) (unrestrictedJointCutoffEventWeight_nonneg n _ _ μ V
    hρ hV hμ _ B _ e.2)

theorem full_active_edge_eq_event_sum [Fintype G] [∀ g, Fintype (P g)]
    [∀ g p, NeZero (n g p)] [∀ c, Fintype (A c)]
    (ω : ∀ c, A c → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (phase : ∀ c a, UnrestrictedProductPhase n (Δ c a) (D c a) (fun g => (S g)ᶜ.card) B)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    fullActiveUnrestrictedEdge n S B ω Δ D μ ρ V phase f x =
      ∑ e : FullActiveEdgeEvent n S B A Δ D x,
        (fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V x e : ℂ) *
          phase (productActiveMemorySplit S B x).1 e.1 (productActiveMemorySplit S B x).2 e.2 *
          f (fullActiveEdgeEventTarget n S B A Δ D x e) := by
  unfold fullActiveUnrestrictedEdge fullActiveMemoryAverage equivFiberAverageLift finiteFiberAverage
  rw [Fintype.sum_sigma]
  apply sum_congr rfl
  intro a _
  dsimp only
  rw [unrestricted_coupled_cutoff_eq_joint_event_sum n
    (Δ (productActiveMemorySplit S B x).1 a) (D (productActiveMemorySplit S B x).1 a)
    μ ρ V (fun g => (S g)ᶜ.card) B]
  simp only [mul_sum, fullActiveEdgeEventWeight, fullActiveEdgeEventTarget,
    Complex.ofReal_mul, mul_assoc, equivFiberSlice]

end
end

section
open scoped BigOperators Classical
noncomputable def finiteSlotSymmetrize {I X : Type*} [Fintype I] [DecidableEq I]
    (f : (I → X) → ℂ) (x : I → X) : ℂ :=
  (Fintype.card (Equiv.Perm I) : ℂ)⁻¹ * ∑ σ : Equiv.Perm I, f (finiteSlotRelabel σ x)

theorem finite_slot_relabel_mul {I X : Type*} (σ τ : Equiv.Perm I) (x : I → X) :
    finiteSlotRelabel σ (finiteSlotRelabel τ x) = finiteSlotRelabel (τ * σ) x := rfl

theorem finite_slot_symmetrize_invariant {I X : Type*} [Fintype I] [DecidableEq I]
    (f : (I → X) → ℂ) (τ : Equiv.Perm I) :
    finiteSlotPermute τ (finiteSlotSymmetrize f) = finiteSlotSymmetrize f := by
  funext x
  simp only [finiteSlotPermute, finiteSlotSymmetrize, finite_slot_relabel_mul]
  congr 1
  exact Equiv.sum_comp (Equiv.mulLeft τ) (fun σ => f (finiteSlotRelabel σ x))

theorem finite_slot_symmetrize_eq_self {I X : Type*} [Fintype I] [DecidableEq I]
    (f : (I → X) → ℂ) (hsym : ∀ σ : Equiv.Perm I, finiteSlotPermute σ f = f) :
    finiteSlotSymmetrize f = f := by
  funext x
  have hv (σ : Equiv.Perm I) : f (finiteSlotRelabel σ x) = f x := congrFun (hsym σ) x
  simp only [finiteSlotSymmetrize, hv, Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
  rw [← mul_assoc, inv_mul_cancel₀, one_mul]
  exact_mod_cast Fintype.card_ne_zero

theorem finite_slot_symmetrize_pointwise {I X : Type*} [Fintype I] [DecidableEq I]
    (f : (I → X) → ℂ) (x : I → X) :
    ‖finiteSlotSymmetrize f x‖ ^ 2 ≤
      (Fintype.card (Equiv.Perm I) : ℝ)⁻¹ * ∑ σ : Equiv.Perm I, ‖f (finiteSlotRelabel σ x)‖ ^ 2 := by
  have hc : (0 : ℝ) < Fintype.card (Equiv.Perm I) := by exact_mod_cast Fintype.card_pos
  have hsum := complex_row_weighted_cauchy (Finset.univ : Finset (Equiv.Perm I))
    (fun _ => 1) (fun σ => f (finiteSlotRelabel σ x)) (fun _ => 1) (by intros; norm_num)
  have hs : ‖∑ σ : Equiv.Perm I, f (finiteSlotRelabel σ x)‖ ^ 2 ≤
      (Fintype.card (Equiv.Perm I) : ℝ) * ∑ σ : Equiv.Perm I, ‖f (finiteSlotRelabel σ x)‖ ^ 2 := by
    simpa using hsum
  unfold finiteSlotSymmetrize
  rw [norm_mul, norm_inv, Complex.norm_natCast, mul_pow]
  calc
    _ ≤ ((Fintype.card (Equiv.Perm I) : ℝ)⁻¹) ^ 2 *
        ((Fintype.card (Equiv.Perm I) : ℝ) * ∑ σ : Equiv.Perm I, ‖f (finiteSlotRelabel σ x)‖ ^ 2) :=
      mul_le_mul_of_nonneg_left hs (sq_nonneg _)
    _ = _ := by field_simp

theorem finite_slot_symmetrize_energy {I X : Type*}
    [Fintype I] [DecidableEq I] [Fintype X]
    (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (f : (I → X) → ℂ) :
    finiteWeightedEnergy (finiteProductWeight (fun _ : I => μ)) (finiteSlotSymmetrize f) ≤
      finiteWeightedEnergy (finiteProductWeight (fun _ : I => μ)) f := by
  let w := finiteProductWeight (fun _ : I => μ)
  have hw : ∀ x, 0 ≤ w x := fun x => Finset.prod_nonneg (fun i _ => hμ (x i))
  have hc : (Fintype.card (Equiv.Perm I) : ℝ) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  change (∑ x, w x * ‖finiteSlotSymmetrize f x‖ ^ 2) ≤ ∑ x, w x * ‖f x‖ ^ 2
  calc
    _ ≤ ∑ x, w x * ((Fintype.card (Equiv.Perm I) : ℝ)⁻¹ *
        ∑ σ : Equiv.Perm I, ‖f (finiteSlotRelabel σ x)‖ ^ 2) :=
      Finset.sum_le_sum (fun x _ => mul_le_mul_of_nonneg_left (finite_slot_symmetrize_pointwise f x) (hw x))
    _ = (Fintype.card (Equiv.Perm I) : ℝ)⁻¹ *
        ∑ σ : Equiv.Perm I, ∑ x, w x * ‖f (finiteSlotRelabel σ x)‖ ^ 2 := by
      rw [Finset.sum_comm]
      simp_rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro x _
      apply Finset.sum_congr rfl
      intro σ _
      ring
    _ = (Fintype.card (Equiv.Perm I) : ℝ)⁻¹ *
        ∑ _σ : Equiv.Perm I, ∑ x, w x * ‖f x‖ ^ 2 := by
      congr 1
      apply Finset.sum_congr rfl
      intro σ _
      exact finite_slot_energy_invariant μ σ f
    _ = _ := by simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]; field_simp

theorem finite_projected_probe_energy {I X : Type*}
    [Fintype I] [DecidableEq I] [Fintype X]
    (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (hmass : ∑ x, μ x = 1)
    (A B : Finset I) (hAB : Disjoint A B) (hm : 0 < A.card) (f : (I → X) → ℂ) :
    finiteWeightedEnergy (finiteProductWeight (fun _ : I => μ))
      (finiteCoordinateComponent (fun _ : I => μ) A (A ∪ B).toList (finiteSlotSymmetrize f)) ≤
      ((B.card : ℝ) ^ B.card / (A.card : ℝ) ^ B.card) *
        finiteWeightedEnergy (finiteProductWeight (fun _ : I => μ)) f := by
  exact (finite_symmetric_probe_energy μ hμ hmass A B hAB hm (finiteSlotSymmetrize f)
    (finite_slot_symmetrize_invariant f)).trans
      (mul_le_mul_of_nonneg_left (finite_slot_symmetrize_energy μ hμ f) (by positivity))
end

section
open scoped BigOperators Classical
theorem finite_coordinate_lift_preserves_invariance {G : Type*} [DecidableEq G]
    {Y : G → Type*} (g h : G) (hgh : g ≠ h) (r : Y g → Y g)
    (A : (Y h → ℂ) → Y h → ℂ) (f : (∀ j, Y j) → ℂ)
    (hf : ∀ x, f (Function.update x g (r (x g))) = f x) (x : ∀ j, Y j) :
    finiteCoordinateLift h A f (Function.update x g (r (x g))) = finiteCoordinateLift h A f x := by
  rw [finite_coordinate_lift_eq_update, finite_coordinate_lift_eq_update,
    Function.update_of_ne hgh.symm]
  congr 1
  funext y
  rw [Function.update_comm hgh]
  have hy : (Function.update x h y) g = x g := Function.update_of_ne hgh _ _
  simpa only [hy] using hf (Function.update x h y)

theorem finite_coordinate_compose_preserves_invariance {G : Type*} [DecidableEq G]
    {Y : G → Type*} (g : G) (r : Y g → Y g)
    (A : ∀ h, (Y h → ℂ) → Y h → ℂ) (is : List G) (hg : g ∉ is)
    (f : (∀ j, Y j) → ℂ) (hf : ∀ x, f (Function.update x g (r (x g))) = f x)
    (x : ∀ j, Y j) :
    finiteCoordinateCompose A is f (Function.update x g (r (x g))) = finiteCoordinateCompose A is f x := by
  induction is generalizing x with
  | nil => exact hf x
  | cons h is ih =>
    have hgh : g ≠ h := fun he => hg (List.mem_cons.mpr (Or.inl he))
    have htail : g ∉ is := fun hi => hg (List.mem_cons_of_mem _ hi)
    exact finite_coordinate_lift_preserves_invariance g h hgh r (A h)
      (finiteCoordinateCompose A is f) (fun y => ih htail y) x
end

section
open scoped BigOperators Classical
theorem finite_coordinate_component_energy_le {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hμ : ∀ i x, 0 ≤ μ i x) (hmass : ∀ i, ∑ y, μ i y = 1)
    (is : List I) (hnodup : is.Nodup) (S : Finset I) (hS : S ⊆ is.toFinset)
    (f : (∀ j, X j) → ℂ) :
    finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ S is f) ≤
      finiteWeightedEnergy (finiteProductWeight μ) f := by
  have h := Finset.single_le_sum
    (f := fun T => finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ T is f))
    (s := is.toFinset.powerset)
    (fun T _ => Finset.sum_nonneg (fun x _ => mul_nonneg
      (Finset.prod_nonneg (fun i _ => hμ i (x i))) (sq_nonneg _)))
    (Finset.mem_powerset.mpr hS)
  exact h.trans_eq (finite_coordinate_component_energy_sum μ hμ hmass is hnodup f)

theorem finite_coordinate_averaging_energy_le {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hμ : ∀ i x, 0 ≤ μ i x) (hmass : ∀ i, ∑ y, μ i y = 1)
    (s : Finset I) (f : (∀ j, X j) → ℂ) :
    finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ ∅ s.toList f) ≤
      finiteWeightedEnergy (finiteProductWeight μ) f :=
  finite_coordinate_component_energy_le μ hμ hmass s.toList (Finset.nodup_toList s) ∅
    (Finset.empty_subset _) f

theorem finite_tensor_averaging_energy_le {G : Type*} [Fintype G] [DecidableEq G]
    {I X : G → Type*} [∀ g, Fintype (I g)] [∀ g, DecidableEq (I g)] [∀ g, Fintype (X g)]
    (μ : ∀ g, X g → ℝ) (hμ : ∀ g x, 0 ≤ μ g x) (hmass : ∀ g, ∑ x, μ g x = 1)
    (B : ∀ g, Finset (I g)) (s : Finset G) (f : (∀ g, I g → X g) → ℂ) :
    finiteWeightedEnergy (finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g)))
      (finiteCoordinateFinsetAction (fun g v => finiteCoordinateComponent (fun _ : I g => μ g)
        ∅ (B g).toList v) s f) ≤
      finiteWeightedEnergy (finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g))) f := by
  have hlocal (g : G) (v : (I g → X g) → ℂ) :
      finiteWeightedEnergy (finiteProductWeight (fun _ : I g => μ g))
        (finiteCoordinateComponent (fun _ : I g => μ g) ∅ (B g).toList v) ≤
      1 * finiteWeightedEnergy (finiteProductWeight (fun _ : I g => μ g)) v := by
    simpa only [one_mul] using (finite_coordinate_averaging_energy_le
      (fun _ : I g => μ g) (fun _ x => hμ g x) (fun _ => hmass g) (B g) v)
  have h := finite_coordinate_finset_energy_le
    (fun g => finiteProductWeight (fun _ : I g => μ g))
    (fun g x => Finset.prod_nonneg (fun i _ => hμ g (x i)))
    (fun g v => finiteCoordinateComponent (fun _ : I g => μ g) ∅ (B g).toList v)
    (fun _ => (1 : ℝ)) (fun _ => zero_le_one)
    hlocal s f
  simpa only [Finset.prod_const_one, one_mul] using h
end

section
open Finset Classical
abbrev FullActiveSlotPermutations {G : Type*} (M : G → ℕ) :=
  ∀ g, Equiv.Perm (Fin (M g))

def fullActivePermutation {G : Type*} {P Z : G → Type*} {M : G → ℕ} {B : ℕ}
    (τ : FullActiveSlotPermutations M) :
    ProductBoundedOrderedState P Z M B ≃ ProductBoundedOrderedState P Z M B where
  toFun x g := ((x g).1 ∘ τ g, (x g).2)
  invFun x g := ((x g).1 ∘ (τ g).symm, (x g).2)
  left_inv x := by
    funext g
    apply Prod.ext
    · funext i
      exact congrArg (x g).1 ((τ g).apply_symm_apply i)
    · rfl
  right_inv x := by
    funext g
    apply Prod.ext
    · funext i
      exact congrArg (x g).1 ((τ g).symm_apply_apply i)
    · rfl

theorem fullActivePermutation_weight {G : Type*} [Fintype G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ}
    (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ) (τ : FullActiveSlotPermutations M)
    (x : ProductBoundedOrderedState P Z M B) :
    productMemoryWeight μ ν (fullActivePermutation τ x) = productMemoryWeight μ ν x := by
  apply prod_congr rfl
  intro g _
  change (∏ i, μ g ((x g).1 (τ g i))) * boundedOrderedMemoryWeight (ν g) (x g).2 =
    (∏ i, μ g ((x g).1 i)) * boundedOrderedMemoryWeight (ν g) (x g).2
  exact congrArg (fun r : ℝ => r * boundedOrderedMemoryWeight (ν g) (x g).2)
    (Equiv.prod_comp (τ g) (fun i => μ g ((x g).1 i)))

theorem fullActivePermutation_total_memory {G : Type*} [Fintype G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ} (τ : FullActiveSlotPermutations M)
    (x : ProductBoundedOrderedState P Z M B) :
    productTotalMemory (fullActivePermutation τ x) = productTotalMemory x := rfl

theorem fullActivePermutation_memory_permute {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ} (τ : FullActiveSlotPermutations M)
    (x : ProductBoundedOrderedState P Z M B) (g : G)
    (σ : Equiv.Perm (Fin (x g).2.1.val)) :
    fullActivePermutation τ (productMemoryPermuteAt x g σ) =
      productMemoryPermuteAt (fullActivePermutation τ x) g σ := by
  funext h
  by_cases hh : h = g
  · subst h
    change (((productMemoryPermuteAt x g σ) g).1 ∘ τ g,
      ((productMemoryPermuteAt x g σ) g).2) = _
    simp only [productMemoryPermuteAt, Function.update_self]
    rfl
  · change (((productMemoryPermuteAt x g σ) h).1 ∘ τ h,
      ((productMemoryPermuteAt x g σ) h).2) = _
    simp only [productMemoryPermuteAt, Function.update_of_ne hh]
    rfl

theorem fullActivePermutation_symmetric {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ} (τ : FullActiveSlotPermutations M)
    (f : ProductBoundedOrderedState P Z M B → ℂ) (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric (fun x => f (fullActivePermutation τ x)) := by
  intro x g σ
  change f (fullActivePermutation τ (productMemoryPermuteAt x g σ)) =
    f (fullActivePermutation τ x)
  rw [fullActivePermutation_memory_permute τ x g σ]
  exact hf (fullActivePermutation τ x) g σ

theorem fullActivePermutation_energy {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    {M : G → ℕ} {B : ℕ} (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (τ : FullActiveSlotPermutations M) (f : ProductBoundedOrderedState P Z M B → ℂ) :
    finiteWeightedEnergy (productMemoryWeight μ ν) (fun x => f (fullActivePermutation τ x)) =
      finiteWeightedEnergy (productMemoryWeight μ ν) f := by
  have h := Equiv.sum_comp (fullActivePermutation τ)
    (fun x => productMemoryWeight μ ν x * ‖f x‖ ^ 2)
  simpa only [finiteWeightedEnergy, fullActivePermutation_weight] using h
end

section
open Finset
open scoped Classical
def promotionEligibilityInclusion {A J : Type*} {small large : Finset J}
    (h : small ⊆ large) (e : A ↪ small) : A ↪ large :=
  ⟨fun a => ⟨(e a).val, h (e a).property⟩,
    fun _ _ he => e.injective (Subtype.ext (congrArg (fun x : large => x.val) he))⟩

theorem promotion_eligibility_inclusion_injective {A J : Type*}
    {small large : Finset J} (h : small ⊆ large) :
    Function.Injective (promotionEligibilityInclusion (A := A) h) := by
  intro e f he
  ext a
  exact congrArg (fun x : large => x.val) (congrArg (fun k : A ↪ large => k a) he)

theorem promotion_eligibility_sum_restrict {A J M : Type*}
    [Fintype A] [AddCommMonoid M] {small large : Finset J}
    (h : small ⊆ large) (F : (A ↪ large) → M)
    (hzero : ∀ e, (∃ a, (e a).val ∉ small) → F e = 0) :
    (∑ e : A ↪ small, F (promotionEligibilityInclusion h e)) =
      ∑ e : A ↪ large, F e := by
  classical
  apply Fintype.sum_of_injective (promotionEligibilityInclusion h)
    (promotion_eligibility_inclusion_injective h)
  · intro e he
    apply hzero e
    by_contra! hn
    apply he
    refine ⟨⟨fun a => ⟨(e a).val, hn a⟩, ?_⟩, ?_⟩
    · intro a b hab
      exact e.injective (Subtype.ext (congrArg (fun x : small => x.val) hab))
    · ext a
      rfl
  · intro e
    rfl

theorem unrestricted_edge_action_restrict_eligibility {P Z : Type*}
    [Fintype P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (label : Z → P)
    (seed : P → Z) (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ)
    (ρ V : ℝ) (small large : Finset (Fin N)) (h : small ⊆ large) (B : ℕ)
    (phase : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ large) → UnrestrictedFreshLabels P promotions → ℂ)
    (hzero : ∀ stores promotions e fresh,
      (∃ a, (e a).val ∉ small) → phase stores promotions e fresh = 0)
    (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ) :
    unrestrictedEdgeAction source old label seed transport hit μ ρ V small B
      (fun stores promotions e fresh =>
        phase stores promotions (promotionEligibilityInclusion h e) fresh) F =
    unrestrictedEdgeAction source old label seed transport hit μ ρ V large B phase F := by
  unfold unrestrictedEdgeAction
  apply sum_congr rfl
  intro stores _
  apply sum_congr rfl
  intro promotions _
  apply promotion_eligibility_sum_restrict h
    (fun e => ∑ fresh : UnrestrictedFreshLabels P promotions,
      (unrestrictedEdgeEventMass source old seed transport hit μ ρ V stores promotions e fresh : ℂ) *
        phase stores promotions e fresh *
          (if (unrestrictedEdgeOutput source old seed transport stores promotions e).1 ≤ B then
            F (unrestrictedEdgeTarget old label promotions e fresh)
              (unrestrictedEdgeOutput source old seed transport stores promotions e) else 0))
  intro e he
  apply sum_eq_zero
  intro fresh _
  rw [hzero stores promotions e fresh he]
  simp only [mul_zero, zero_mul]
end

section
open Finset
open scoped Classical
theorem unrestricted_edge_action_cutoff_congr {P Z : Type*} [Fintype P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (label : Z → P)
    (seed : P → Z) (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ)
    (ρ V : ℝ) (eligible : Finset (Fin N)) (B : ℕ)
    (phase : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ eligible) → UnrestrictedFreshLabels P promotions → ℂ)
    (F K : (Fin t → P) → FiniteOrderedTuple Z → ℂ)
    (hFK : ∀ target q, q.1 ≤ B → F target q = K target q) :
    unrestrictedEdgeAction source old label seed transport hit μ ρ V eligible B phase F =
      unrestrictedEdgeAction source old label seed transport hit μ ρ V eligible B phase K := by
  unfold unrestrictedEdgeAction
  apply sum_congr rfl
  intro stores _
  apply sum_congr rfl
  intro promotions _
  apply sum_congr rfl
  intro e _
  apply sum_congr rfl
  intro fresh _
  congr 1
  split_ifs with hq
  · exact hFK _ _ hq
  · rfl

theorem unrestricted_residue_action_raw_event_sum {P : Type*} [Fintype P]
    (n : P → ℕ) (Δ D : ℤ) (μ : P → ℝ) (ρ V : ℝ) (t B : ℕ)
    (phase : UnrestrictedBoundedPhase n Δ D t B)
    (F : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B) :
    unrestrictedResidueEdgeAction n Δ D s.1 s.2.2 μ ρ V B (phase s) F =
      ∑ e : UnrestrictedBoundedEvent n Δ D t B s,
        (unrestrictedBoundedEventWeight n Δ D μ ρ V t B s e : ℂ) *
          phase s e.1 e.2.1 e.2.2.1 e.2.2.2 *
          F (unrestrictedBoundedEventTarget n Δ D t B s e).1
            (boundedOrderedTupleToFinite (unrestrictedBoundedEventTarget n Δ D t B s e).2) := by
  let f : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ :=
    fun u => F u.1 (boundedOrderedTupleToFinite u.2)
  have he : unrestrictedResidueEdgeAction n Δ D s.1 s.2.2 μ ρ V B (phase s) F =
      unrestrictedBoundedOperator n Δ D μ ρ V t B phase f s := by
    unfold unrestrictedBoundedOperator unrestrictedBoundedAction unrestrictedResidueEdgeAction
    apply unrestricted_edge_action_cutoff_congr
    intro target q hq
    rw [boundedOrderedZeroExtension_of_le _ _ _ hq]
    rfl
  rw [he, unrestricted_bounded_operator_eq_event_sum]
end

section
open Finset
theorem physical_group_unshared_source_not_dvd {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (havoid : physicalAuxAvoids C aux L) (g : G)
    (i : Fin (ell + (C g).card)) :
    ¬ ((physicalGroupUnsharedEmbedding C L g i).val : ℤ) ∣
      (physicalD C L aux : ℤ) := by
  rw [Int.natCast_dvd_natCast]
  exact physical_unshared_mark_not_dvd_D C L aux hP hdis havoid g
    (physicalGroupUnsharedIndex (ell := ell) (C g) i).val
    (physicalGroupUnsharedIndex (ell := ell) (C g) i).property

theorem physical_group_unshared_target_not_dvd {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L R : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C)
    (hlist : physicalListAdmissible C aux L R)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (g : G) (i : Fin (ell + (C g).card)) :
    ¬ ((physicalGroupUnsharedEmbedding C R g i).val : ℤ) ∣
      (physicalD C L aux : ℤ) := by
  rw [physical_D_eq_of_shared C hlist.1 aux]
  exact physical_group_unshared_source_not_dvd C R aux hP hdis hlist.2.2 g i

theorem physical_group_phase_delta_as_integer_step {G : Type*}
    {P : G → Finset ℕ} (a b k D : ℤ) (hstep : b = a + k * D) (g : G) :
    physicalGroupPhaseDelta (P := P) a b g =
      fun p : ↥(P g) => ((-k * D : ℤ) : ZMod p.val) := by
  funext p
  unfold physicalGroupPhaseDelta
  congr 1
  rw [hstep]
  ring
