/- The encoded forest coefficient is exactly an original event-path action with the retained residual phase. -/

open Finset Classical
namespace Bounty
section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
  [∀ g, DecidableEq (P g)] (n : (g : Fin N) → P g → ℕ) [∀ g p, NeZero (n g p)]
  {M : Fin N → ℕ} (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
  (Δ D : ∀ k c, A k c → Fin N → ℤ)
  (edgePhase : ∀ k, ((g : Fin N) → Finset (P g)) →
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) →
    FullActiveEdgeEvent n (S k) B (A k) (Δ k) (D k) x → ℂ)
  (ω : ∀ k c, A k c → ℝ) (μ : (g : Fin N) → P g → ℝ)
  (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ) (steps : List (Option (J ⊕ K)))
  (initial : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B →
    (g : Fin N) → Finset (P g))

noncomputable def fullMixedResidualForestAction
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) : ℂ :=
  fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps
    (fun s p => if birthForestCompatible
      (fun i => fullMixedPathBirthPerformed n S B A Δ D steps s p (fullMixedBirthOrder S B steps i))
      (fun i => fullMixedPathBirthLabel n S B A Δ D steps s p (fullMixedBirthOrder S B steps i)) code
      then fullMixedResidualPathPhase n S B A Δ D edgePhase steps initial s p else 0) f x

theorem full_mixed_residual_forest_action_eq
    (encode : ((g : Fin N) × P g) → ℤ) (hinj : Function.Injective encode)
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    let _ : ∀ (tag : Option (J ⊕ K)) x, Fintype (FullPermutationMixedEvent n S B A Δ D tag x) :=
      fullPermutationMixedEventFintype n S B A Δ D
    let _ := finiteEventPathFintype (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x
    fullMixedResidualForestAction n S B A Δ D edgePhase ω μ q ρ V steps initial code f x =
      birthForestPathSum univ
        (fun p => f (finiteEventPathTerminal (FullPermutationMixedEvent n S B A Δ D)
          (fullPermutationMixedEventTarget n S B A Δ D) steps x p) *
          fullMixedResidualPathWeight n S B A Δ D edgePhase ω μ q ρ V steps initial x p)
        (fullMixedIndexedBirthPerformed n S B A Δ D steps x)
        (fullMixedIndexedBirthValue n S B A Δ D steps encode x) code := by
  dsimp only
  unfold fullMixedResidualForestAction fullPermutationMixedPathAction finiteEventPathAction birthForestPathSum
  apply sum_congr rfl
  intro p _
  dsimp only
  rw [full_mixed_indexed_forest_encoding_iff n S B A Δ D steps encode hinj x p code,
    full_mixed_residual_weight_factor]
  split_ifs <;> ring

end Full
end Bounty
end

section

/- Actual majorant support admits finitely many fixed logarithmic boxes. -/

open Finset Filter

namespace Bounty

theorem typeII_majorant_dyadic_log_box {y : TypeIIShiftIndex} {L U V E : ℝ}
    (hL : 0 < L) (hU : 0 < U) (hV : 0 < V) (hE : 0 < E)
    (hUV : 4 ≤ U * V) (hk : y.1.1 ≠ 0)
    (hm : (y.2.1.1 : ℝ) ∈ Set.Icc U (2 * U))
    (hm' : (y.2.2.1 : ℝ) ∈ Set.Icc U (2 * U))
    (hz : y.1.2 = y.2.2.1 * y.2.1.2)
    (hne : typeIIEMajorant (L ^ 88) (typeIIRealE y / E) *
      typeIINMajorant (typeIIRealN y / V) ≠ 0) :
    ∃ j ∈ range (⌈Real.logb 2 (192 * L ^ 88)⌉₊ + 1),
      let Z := U ^ 2 * V / (16 * E) * 2 ^ j
      0 < Z ∧ (y.1.2 : ℝ) ∈ Set.Ico Z (2 * Z) ∧
        ∀ i, typeIILogCoordinates ![(y.2.1.1 : ℝ), (y.2.2.1 : ℝ), (y.1.2 : ℝ)]
          ![U, U, Z] i ∈ Set.Icc (-1) 1 := by
  let Z₀ := U ^ 2 * V / (16 * E)
  have hZ₀ : 0 < Z₀ := by dsimp only [Z₀]; positivity
  have hr := typeII_majorant_cross_scale_range hL hU hV hE hUV hk hm hm' hz hne
  have hupper : (y.1.2 : ℝ) ≤ (192 * L ^ 88) * Z₀ := by
    calc
      (y.1.2 : ℝ) ≤ 12 * U ^ 2 * V * L ^ 88 / E := hr.2.le
      _ = (192 * L ^ 88) * Z₀ := by dsimp only [Z₀]; ring
  have hj := typeII_dyadic_index_bound hZ₀ hr.1.le hupper
  have hinterval := typeII_dyadic_index_interval hZ₀ hr.1.le
  refine ⟨typeIIDyadicIndex Z₀ y.1.2, mem_range.mpr (Nat.lt_succ_of_le hj), ?_⟩
  refine ⟨by positivity, hinterval, ?_⟩
  exact typeII_three_factor_two_log_box hU (by positivity) hm hm' ⟨hinterval.1, hinterval.2.le⟩

theorem typeII_dyadic_log_cost {L : ℝ} (hL : 1 ≤ L) :
    ((⌈Real.logb 2 (192 * L ^ 88)⌉₊ + 1 : ℕ) : ℝ) ≤
      (Real.log 192 + 88 * Real.log L) / Real.log 2 + 2 := by
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hP : 1 ≤ L ^ 88 := one_le_pow₀ hL
  have hR : 1 ≤ 192 * L ^ 88 := by linarith
  have hh := Nat.ceil_lt_add_one (Real.logb_nonneg (b := 2) (by norm_num) hR)
  have heq : Real.logb 2 (192 * L ^ 88) =
      (Real.log 192 + 88 * Real.log L) / Real.log 2 := by
    rw [Real.logb, Real.log_mul (by norm_num) (pow_ne_zero _ hL0.ne'), Real.log_pow]
    norm_num
  rw [heq] at hh ⊢
  push_cast
  linarith

theorem eventually_typeII_dyadic_count_le_square :
    ∀ᶠ L : ℝ in atTop,
      ((⌈Real.logb 2 (192 * L ^ 88)⌉₊ + 1 : ℕ) : ℝ) ≤ L ^ 2 := by
  let a := Real.log 192 / Real.log 2
  let b := 88 / Real.log 2
  have ha : 0 ≤ a := by dsimp only [a]; positivity
  have hb : 0 ≤ b := by dsimp only [b]; positivity
  filter_upwards [eventually_ge_atTop (1 : ℝ), eventually_ge_atTop (a + b + 2)] with L hL hC
  have hlog := Real.log_le_self (zero_le_one.trans hL)
  have hc := typeII_dyadic_log_cost hL
  have heq : (Real.log 192 + 88 * Real.log L) / Real.log 2 + 2 =
      a + b * Real.log L + 2 := by dsimp only [a, b]; ring
  rw [heq] at hc
  have hstep : a + b * Real.log L + 2 ≤ (a + b + 2) * L := by nlinarith
  exact hc.trans (hstep.trans (by nlinarith))

end Bounty
end

section

/- The full box coefficient is the sum of the actual truncated retained integrals. -/

open Finset Filter MeasureTheory

namespace Bounty

noncomputable def candidateBoxArithmeticTest (L E : ℝ) (G : ℕ → ℂ) (e h : ℕ) : ℂ :=
  if (E/L^88 ≤ (e : ℝ) ∧ (e : ℝ) ≤ E) ∧ e*h ∈ arithmeticProductWindow 1 (Real.exp L)
  then G (e*h) else 0

theorem candidate_box_Q_test (c L : ℝ) (r jStar : ℕ) (E R : ℝ) (G : ℕ → ℂ) :
    (∑ n ∈ orderedSlotProductSupport (candidateQSlotChoices c L r jStar),
      candidateBoxRangeQWeight c L r jStar E R n*G n) =
      ∑ x : ∀ slot, candidateQSlotChoices c L r jStar slot,
        candidateBoxRangeAllocationMass c L r jStar x E R *
          G (orderedSlotProduct (candidateQSlotChoices c L r jStar) x) /
          (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ) := by
  classical
  unfold candidateBoxRangeQWeight
  simp only [sum_mul, ite_mul, zero_mul]
  rw [sum_comm]
  apply sum_congr rfl
  intro x hx
  have hm : orderedSlotProduct (candidateQSlotChoices c L r jStar) x ∈
      orderedSlotProductSupport (candidateQSlotChoices c L r jStar) := mem_image.mpr ⟨x,mem_univ _,rfl⟩
  simp [hm, div_mul_eq_mul_div]

theorem candidate_box_single_P_patterns (c L : ℝ) (r jStar p : ℕ) (E R : ℝ) (G : ℕ → ℂ) :
    (∑ x : ∀ slot, candidateQSlotChoices c L r jStar slot,
      candidateBoxRangeAllocationMass c L r jStar x E R *
        (if p*orderedSlotProduct (candidateQSlotChoices c L r jStar) x ∈ arithmeticProductWindow 1 (Real.exp L)
          then G (p*orderedSlotProduct (candidateQSlotChoices c L r jStar) x) else 0) /
          (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ)) =
    ∑ take ∈ (univ : Finset (Fin ((candidateQIndices c L).card*r) → Bool)).filter
      (fun take => ∀ i, candidateAllocationActive c L r jStar i = false → take i = false),
      (∑ x : ∀ slot, candidateQSlotChoices c L r jStar slot,
        (∫ ξ, activeAllocationFourierIntegrand (candidateAllocationRadius r) (Real.log E)
          (fun i => Real.log (candidateAllocationValue c L r jStar x i))
          (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val)
          (candidateAllocationActive c L r jStar) take ξ
            ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) R) *
        candidateBoxArithmeticTest L E G (candidateAllocatedFactor c L r jStar x take)
          (candidateRetainedFactor c L r jStar p x take)) /
          (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ) := by
  classical
  unfold candidateBoxRangeAllocationMass
  rw [sum_filter]
  simp only [sum_mul, sum_div]
  rw [sum_comm]
  apply sum_congr rfl
  intro take ht
  by_cases hk : ∀ i, candidateAllocationActive c L r jStar i = false → take i = false
  · have hkeq : (∀ i, candidateAllocationActive c L r jStar i = false → take i = false) = True :=
      propext (iff_true_intro hk)
    simp only [hkeq, true_and, if_true]
    apply sum_congr rfl
    intro x hx
    simp only [candidateBoxArithmeticTest, candidate_allocation_factorization]
    by_cases he : E/L^88 ≤ (candidateAllocatedFactor c L r jStar x take : ℝ) ∧
      (candidateAllocatedFactor c L r jStar x take : ℝ) ≤ E
    · by_cases hw : p*orderedSlotProduct (candidateQSlotChoices c L r jStar) x ∈
        arithmeticProductWindow 1 (Real.exp L)
      · simp only [he, hw, and_self, if_true]
      · simp only [he, hw, true_and, if_false, mul_zero, zero_div]
    · simp only [he, false_and, if_false, zero_mul, mul_zero, zero_div]
  · simp only [hk, false_and, if_false, zero_mul, zero_div, sum_const_zero]

theorem eventually_candidate_box_retained_integrals {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ) (E R : ℝ) (G : ℕ → ℂ),
      (∑ u ∈ arithmeticProductWindow 1 (Real.exp L),
        candidateBoxRangeCoefficient c L q r jStar E R u*G u) =
      ∑ take ∈ (univ : Finset (Fin ((candidateQIndices c L).card*r) → Bool)).filter
        (fun take => ∀ i, candidateAllocationActive c L r jStar i = false → take i = false),
        ∫ ξ, candidateRetainedAllocationIntegrand c L q r jStar (Real.log E)
          (candidateSmallPSet c L (16*Real.exp L+1)) take (candidateBoxArithmeticTest L E G) ξ
          ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) R := by
  classical
  filter_upwards [eventually_candidate_box_convolution hc,
    eventually_candidate_retained_box_integral hc] with L hconv hint
  intro q r jStar E R G
  rw [hconv q r jStar E R G]
  simp_rw [candidate_box_Q_test, candidate_box_single_P_patterns, mul_sum]
  rw [sum_comm]
  apply sum_congr rfl
  intro take ht
  exact (hint q r jStar (Real.log E) R _ take (fun p hp =>
    ((mem_candidateSmallPSet_iff c L _ p).mp hp).2) (candidateBoxArithmeticTest L E G)).2

end Bounty
end

section

/- The original path action equals the signed sum on a pattern-independent forest code type. -/

open Finset Classical
namespace Bounty
section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
  [∀ g, DecidableEq (P g)] (n : (g : Fin N) → P g → ℕ) [∀ g p, NeZero (n g p)]
  {M : Fin N → ℕ} (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
  (Δ D : ∀ k c, A k c → Fin N → ℤ)
  (edgePhase : ∀ k, ((g : Fin N) → Finset (P g)) →
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) →
    FullActiveEdgeEvent n (S k) B (A k) (Δ k) (D k) x → ℂ)
  (ω : ∀ k c, A k c → ℝ) (μ : (g : Fin N) → P g → ℝ)
  (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ) (steps : List (Option (J ⊕ K)))

theorem full_mixed_common_forest_expansion
    (hedge : ∀ k H x e, edgePhase k H x e =
      (if FullMixedLocalBirthAvoids (J := J) n S B A Δ D H (some (.inr k)) x e ∧
          FullMixedLocalBirthDistinct (J := J) n S B A Δ D (some (.inr k)) x e then 1 else 0) *
        edgePhase k (fun _ => ∅) x e)
    (encode : ((g : Fin N) × P g) → ℤ) (hinj : Function.Injective encode)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (hx : FullActiveInjective x)
    (hcover : FullMixedLedgerCovers n B (fullActiveInitialLedger x, x)) :
    fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps
      (fullMixedLedgerInducedPhase n S B A Δ D steps fullActiveInitialLedger
        (finiteEventLocalPhase
          (fun tag (s : FullMixedLedgerState n (M := M) B) => FullPermutationMixedEvent n S B A Δ D tag s.2)
          (fullMixedLedgerTarget n S B A Δ D) (fullMixedLedgerPhase n S B A Δ D edgePhase) steps)) f x =
    ∑ code, (-1 : ℂ) ^ birthForestRank code *
      fullMixedCommonForestAction n S B A Δ D edgePhase ω μ q ρ V steps code f x := by
  let _ : ∀ (tag : Option (J ⊕ K)) x, Fintype (FullPermutationMixedEvent n S B A Δ D tag x) :=
    fullPermutationMixedEventFintype n S B A Δ D
  let _ := finiteEventPathFintype (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) steps x
  have h := full_mixed_common_ledger_forest_expansion n S B A Δ D edgePhase ω μ q ρ V steps
    hedge univ (fun _ : FullPermutationMixedPath n S B A Δ D steps x => x) (fun p => p)
    (fun _ _ => hx) (fun _ _ => hcover)
    (fun p => f (finiteEventPathTerminal (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x p)) encode hinj
  simp_rw [full_mixed_common_forest_action_eq n S B A Δ D edgePhase ω μ q ρ V steps encode hinj]
  rw [← h]
  unfold fullPermutationMixedPathAction finiteEventPathAction
  apply sum_congr rfl
  intro p _
  ring

end Full
end Bounty
end

section

/- The literal gated clean mixed row, averaged over its original auxiliary
draws, has the exact small-conditioning pairing with the physical big row. -/

open Finset
open scoped Classical

namespace Bounty

section

variable {S G : Type*} [Fintype S] [Fintype G] [DecidableEq S] [DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    [∀ p : PhysicalPrime Ps, NeZero p.2.val] [∀ g (p : P g), NeZero p.val]

noncomputable def physicalMixedGatedCleanAction
    (initial : ∀ g, Finset (P g)) (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (ζ θ ρ : ℝ) (k : ℤ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (Vs : S → ℝ) (q : ℝ)
    (sourceGate targetGate F : PhysicalSmallBigState Ps J ell
      (CleanFullMemoryState P J ell B) → ℂ)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B)) : ℂ :=
  ∑ a : PhysicalAuxLabels P C, (physicalAuxMass V C a : ℂ) *
    physicalSmallBigFullPhasedAction (fun g (p : P g) => p.val)
      (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
      (fun d c => physicalMixedEdgeDelta C k d c a)
      (fun d c => physicalMixedEdgeD C d c a)
      (fun g => tiltedPhysicalBirthLaw V g (b g)) ρ V
      (fun c => physicalMixedBigStep C k c a) Vs q
      (physicalSmallBigEndpointPhase
        (PhysicalSmallBigFullEvent (fun g (p : P g) => p.val)
          (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
          (fun d c => physicalMixedEdgeDelta C k d c a)
          (fun d c => physicalMixedEdgeD C d c a))
        (physicalSmallBigFullTarget (fun g (p : P g) => p.val)
          (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
          (fun d c => physicalMixedEdgeDelta C k d c a)
          (fun d c => physicalMixedEdgeD C d c a))
        (fun r d x e => physicalSmallBigCleanInitialPhase (fun g (p : P g) => p.val)
          (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
          (fun d c => physicalMixedEdgeDelta C k d c a)
          (fun d c => physicalMixedEdgeD C d c a) initial
          (physicalMixedCleanPrefixPhase C ζ θ k K a) d x r e)
        (fun x => physicalMixedBigStep C k
          (productActiveMemorySplit (fun g => physicalFullSharedIndices (ell := ell) (C g)) B x).1 a)
        sourceGate targetGate) F s

theorem physical_mixed_gated_clean_pairing
    (initial : ∀ g, Finset (P g)) (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (ζ θ ρ : ℝ) (k : ℤ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (Vs : S → ℝ) (hVs : ∀ s, 0 < Vs s) (q : ℝ)
    (W : CleanFullMemoryState P J ell B → ℝ)
    (smallAux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))))
    (sourceGate targetGate u F : PhysicalSmallBigState Ps J ell
      (CleanFullMemoryState P J ell B) → ℂ) :
    (∑ s, (physicalSmallBigMeasure Vs W s : ℂ) * (starRingEnd ℂ) (u s) *
      physicalMixedGatedCleanAction initial V b C ζ θ ρ k K Vs q sourceGate targetGate F s) =
      ∑ d, ∑ r, ∑ x, (W x : ℂ) *
        (starRingEnd ℂ) (physicalSmallBigCondition Vs q (fun s => sourceGate s * u s) d x r) *
        physicalMixedCleanInitialAction initial V b C ζ θ ρ k K d
          (physicalSmallBigCondition Vs q (fun s => targetGate s * F s) d) x r := by
  have hswap (T : PhysicalAuxLabels P C →
      PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ) :
      (∑ s, (physicalSmallBigMeasure Vs W s : ℂ) * (starRingEnd ℂ) (u s) *
        ∑ a, (physicalAuxMass V C a : ℂ) * T a s) =
        ∑ a, (physicalAuxMass V C a : ℂ) *
          ∑ s, (physicalSmallBigMeasure Vs W s : ℂ) * (starRingEnd ℂ) (u s) * T a s := by
    simp only [mul_sum]
    rw [sum_comm]
    apply sum_congr rfl
    intro a _
    apply sum_congr rfl
    intro s _
    ring
  unfold physicalMixedGatedCleanAction
  rw [hswap]
  simp_rw [physical_mixed_clean_fixed_aux_pairing C k _
    (fun g => tiltedPhysicalBirthLaw V g (b g)) ρ V Vs hVs q W smallAux initial
    (physicalMixedCleanPrefixPhase C ζ θ k K _) sourceGate targetGate u F]
  simp only [mul_sum]
  rw [sum_comm]
  apply sum_congr rfl
  intro d _
  rw [sum_comm]
  apply sum_congr rfl
  intro r _
  rw [sum_comm]
  apply sum_congr rfl
  intro x _
  rw [← physical_mixed_clean_aux_sum_eq_action]
  rw [mul_sum]
  apply sum_congr rfl
  intro a _
  ring

end

end Bounty
end

section

/- Actual mixed edges with the original auxiliary law and a fixed initial
fresh-birth exclusion. Both small and big slot averages remain at the two
endpoints. The coefficient may inspect both small endpoints and every event. -/

open Finset
open scoped Classical

namespace Bounty

section
variable {S G : Type} [Fintype S] [Fintype G] [DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
  (C : G → Finset (Fin J)) (k : ℤ)

abbrev PhysicalMixedCoefficientEvent (a : PhysicalAuxLabels P C)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B)) :=
  PhysicalSmallBigEvent (PhysicalSmallBigFullEvent (fun g (p : P g) => p.val)
    (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
    (fun d c g => physicalMixedEdgeDelta C k d c a g)
    (fun d c g => physicalMixedEdgeD C d c a g)) s

noncomputable def physicalMixedCoefficientAction
    (V : G → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ) (Vs : S → ℝ) (q : ℝ)
    (initial : ∀ g, Finset (P g))
    (Ψ : ∀ a (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B)),
      PhysicalMixedCoefficientEvent C k a s → ℂ)
    (f : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B)) : ℂ :=
  ∑ a : PhysicalAuxLabels P C, (physicalAuxMass V C a : ℂ) *
    physicalSmallBigFullPhasedAction (fun g (p : P g) => p.val)
      (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
      (fun d c g => physicalMixedEdgeDelta C k d c a g)
      (fun d c g => physicalMixedEdgeD C d c a g)
      (fun g => tiltedPhysicalBirthLaw V g (baseline g)) ρ V
      (fun c => physicalMixedBigStep C k c a) Vs q
      (fun y e => if ∀ g i, (e.2.2 g).2.2.2 i ∉ initial g then Ψ a y e else 0) f s
end

theorem exists_physical_mixed_coefficient_projected_norm_bound
    {q vs : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hvs : 0 < vs) (ell : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (S G : Type) [Fintype S] [DecidableEq S]
      [Fintype G] [DecidableEq G] (Ps : S → Finset ℕ)
      [∀ p : PhysicalPrime Ps, NeZero p.2.val] (P : G → Finset ℕ)
      [∀ g (p : P g), NeZero p.val] (J B : ℕ)
      (C : G → Finset (Fin J)) (k : ℤ)
      (V : G → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ) (Vs : S → ℝ)
      (initial : ∀ g, Finset (P g)),
      (∀ s, vs ≤ Vs s) →
      (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) →
      (∀ g p, 1 / 2 ≤ baseline g p ∧ baseline g p ≤ 1) →
      ∀ (v vmin vmax : ℝ), 0 < ρ → ρ < 1 → 1 < v → 0 < vmin →
      (∀ g, vmin ≤ V g) → (∀ g, V g ≤ vmax) →
      ∀ T : ℕ, (∀ g, ell + (C g).card ≤ T) →
      ∀ (Ψ : ∀ a (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B)),
          PhysicalMixedCoefficientEvent C k a s → ℂ) (H : ℝ),
      0 ≤ H → (∀ a s e, ‖Ψ a s e‖ ≤ H) →
      ∀ f : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ,
      (∀ s, ProductMemorySymmetric (fun x => f (s,x))) →
      let μ := fun g => tiltedPhysicalBirthLaw V g (baseline g)
      let W := productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))
      cleanActiveNorm (physicalSmallBigMeasure Vs W)
        (physicalSmallBigJointAverage (physicalMixedCoefficientAction C k V baseline ρ Vs q initial Ψ
          (physicalSmallBigJointAverage f))) ≤
      H * A ^ Fintype.card S *
        Real.sqrt (unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G) *
          cleanActiveNorm (physicalSmallBigMeasure Vs W) f := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_small_big_phased_energy_bound hq0 hq1 hvs ell
  refine ⟨A, hA, ?_⟩
  intro S G _ dS _ dG
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  intro Ps _ P _ J B C k V baseline ρ Vs initial hVs hMass hbaseline
    v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi T ht Ψ H hH hΨ f hf μ W
  have hVs0 : ∀ s, 0 < Vs s := fun s => hvs.trans_le (hVs s)
  have hV : ∀ g, 0 < V g := fun g => hvmin.trans_le (hVlo g)
  have hμ : ∀ g p, 0 ≤ μ g p := fun g p =>
    tiltedPhysicalBirthLaw_nonneg V g (baseline g) (hV g).le
      (fun p => (by norm_num : (0 : ℝ) ≤ 1/2).trans (hbaseline g p).1) p
  have hmass : ∀ g, ∑ p, μ g p ≤ 2 := fun g =>
    (tiltedPhysicalBirthLaw_sum_bounds V g (baseline g) (hV g) (hMass g) (hbaseline g)).2
  have hW : ∀ x, 0 ≤ W x := productMemoryWeight_nonneg μ _ hμ (fun g z => hμ g z.1)
  let K := unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G
  have hK : 0 ≤ K := pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _
  have hcost : 0 ≤ H ^ 2 * (A ^ (2 * Fintype.card S) * K) :=
    mul_nonneg (sq_nonneg _) (mul_nonneg (pow_nonneg (zero_le_one.trans hA) _) hK)
  let f' := physicalSmallBigJointAverage f
  have hf' : ∀ s, ProductMemorySymmetric (fun x => f' (s,x)) :=
    physical_small_big_joint_average_memory_symmetric f hf
  let smallAux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))) :=
    fun _ j => False.elim (notMem_empty j.val j.property)
  have hlocal (a : PhysicalAuxLabels P C) := hbound S G Ps (fun g => ↥(P g))
    (fun g p => p.val) J (fun _ => J + ell)
    (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
    (fun d c g => physicalMixedEdgeDelta C k d c a g)
    (fun d c g => physicalMixedEdgeD C d c a g) μ ρ V
    (fun c => physicalMixedBigStep C k c a) Vs hVs
    smallAux
    v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T
    (fun g => by simpa only [physical_full_unshared_indices_card] using ht g)
    (fun y e => if ∀ g i, (e.2.2 g).2.2.2 i ∉ initial g then Ψ a y e else 0)
    H hH (by intro y e; split_ifs; exact hΨ a y e; simpa only [norm_zero] using hH) f' hf'
  have havg : physicalSmallBigEnergy Vs W
      (physicalMixedCoefficientAction C k V baseline ρ Vs q initial Ψ f') ≤
      (H ^ 2 * (A ^ (2 * Fintype.card S) * K)) * physicalSmallBigEnergy Vs W f' := by
    apply physical_small_big_auxiliary_energy_bound Vs hVs0 W hW (physicalAuxMass V C)
      (physical_aux_mass_nonneg V C (fun g => (hV g).le))
      (physical_aux_mass_sum V C hV hMass).le _ f' _ hcost
    intro a
    convert hlocal a using 1
  have hin : physicalSmallBigEnergy Vs W f' ≤ physicalSmallBigEnergy Vs W f := by
    convert physical_small_big_joint_average_energy_le Vs hVs0 μ
      (fun g => unrestrictedResidueWeight (μ g)) hμ (fun g z => hμ g z.1) f using 1
  let out := physicalMixedCoefficientAction C k V baseline ρ Vs q initial Ψ f'
  have hout : physicalSmallBigEnergy Vs W (physicalSmallBigJointAverage out) ≤
      physicalSmallBigEnergy Vs W out := by
    convert physical_small_big_joint_average_energy_le Vs hVs0 μ
      (fun g => unrestrictedResidueWeight (μ g)) hμ (fun g z => hμ g z.1) out using 1
  have henergy : physicalSmallBigEnergy Vs W (physicalSmallBigJointAverage out) ≤
      (H ^ 2 * (A ^ (2 * Fintype.card S) * K)) * physicalSmallBigEnergy Vs W f :=
    hout.trans (havg.trans (mul_le_mul_of_nonneg_left hin hcost))
  apply physical_small_big_norm_le_of_energy Vs W (H * A ^ Fintype.card S) K
    (mul_nonneg hH (pow_nonneg (zero_le_one.trans hA) _)) hK f _
  have hp : (A ^ Fintype.card S) ^ 2 = A ^ (2 * Fintype.card S) := by
    rw [← pow_mul, Nat.mul_comm]
  simp only [mul_pow, hp, mul_assoc] at henergy ⊢
  convert henergy using 1
  congr 2

end Bounty
end

section

/- The actual smooth diagonal has any required power saving after choosing the allocation gap. -/

open Finset Filter Real

namespace Bounty

theorem exists_typeII_actual_diagonal_saving {C : ℝ} (hC : 0 ≤ C)
    (aE aN aM aH D : ℝ) :
    ∃ K₀ : ℝ, 0 < K₀ ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (K U V : ℝ) (M H : Finset ℕ) (α a : ℕ → ℂ),
        K₀ ≤ K → 0 < U → 0 < V → 1 ≤ U*V → log (U*V) ≤ C*L →
        (∀ m ∈ M, 0 < m) → (∀ m ∈ M, (m : ℝ) ≤ 2*U) →
        (∀ h ∈ H, 0 < h) → (∀ m ∈ M, ‖α m‖ ≤ L^aM) →
        (∀ h ∈ H, ‖a h‖ ≤ L^aH*(h.divisors.card : ℝ)) →
        let E := U*L^(-K)
        let EF := Icc ⌈E/(2*L^88)⌉₊ ⌊2*E⌋₊
        let NF := Icc ⌈V/2⌉₊ ⌊3*V⌋₊
        let η := fun e n : ℕ => typeIIEMajorant (L^88) ((e : ℝ)/E) *
          typeIINMajorant ((n : ℝ)/V)
        (2*E*V*(L^aE)^2*(L^aN)^2)*typeIIDiagonalEnergy EF NF M H η α a ≤
          (U*V)^2*L^(-D) := by
  let K₀ := max 1 (2*aE+2*aN+2*aM+2*aH+17+D)
  refine ⟨K₀,lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1) (le_max_left _ _),?_⟩
  filter_upwards [eventually_typeII_diagonal_moment_cost hC, eventually_ge_atTop (2 : ℝ)]
    with L hcost hL
  intro K U V M H α a hK hU hV hUV hlogUV hMpos hM hH hα ha
  have hL0 : 0 < L := by linarith
  have hE : 0 < U*L^(-K) := mul_pos hU (rpow_pos_of_pos hL0 _)
  have hd := typeII_actual_smooth_diagonal M H α a hL0 hE hU hV hMpos hM hH hα ha
  have hm : 2*(⌊6*U*V⌋₊ : ℝ)*(1+log (⌊6*U*V⌋₊ : ℝ))^15 ≤ (U*V)*L^(16 : ℝ) := by
    simpa only [mul_assoc] using hcost (U*V) hUV hlogUV
  dsimp only at hd ⊢
  have hd' := hd.trans (mul_le_mul_of_nonneg_left hm
    (mul_nonneg (sq_nonneg (L^aM)) (sq_nonneg (L^aH))))
  exact (mul_le_mul_of_nonneg_left hd' (by positivity)).trans
    (typeII_diagonal_scalar_saving hL ((le_max_right 1 _).trans hK))

end Bounty
end

section

/- Original reconstructed ghost and full auxiliary edge events write exactly their sampled primes. -/

namespace Bounty

section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K))) (u : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P))

section Ghost
variable (j : J) (htag : steps.get u = some (.inl j))
    (sk : CoupledGhostSkeleton M B s) (births : CoupledGhostSamples M B s sk)

theorem full_mixed_common_ghost_history_sample_label (i : CoupledGhostSampleIndex M B s sk) :
    fullMixedCommonHistoryWrite n S B A Δ D steps u s
      (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inl j)) htag s ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩)) history (fullMixedCommonGhostSampleEmbedding S B j steps u htag s sk i) = some ⟨i.1, (births i).1⟩ := by
  have h := full_mixed_common_tagged_history_write_here n S B A Δ D steps u (some (.inl j)) htag s
    ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩) history
    (fullMixedBirthCoordinateEquiv n S B A Δ D (some (.inl j)) s ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩) i).val
  refine h.trans ?_
  exact congrArg (Option.map (fullMixedBornPrime n))
    (full_mixed_birth_coordinate_data n S B A Δ D (some (.inl j)) s ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩) i)

theorem full_mixed_common_ghost_history_sample_coverage
    (i : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps))) :
    ((fullMixedCommonHistoryWrite n S B A Δ D steps u s
      (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inl j)) htag s ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩)) history i).isSome = true ∧
      fullMixedCommonIndexStage M B steps i = u.succ) ↔
      ∃ c, fullMixedCommonGhostSampleEmbedding S B j steps u htag s sk c = i :=
  full_mixed_common_tagged_history_write_coverage n S B A Δ D steps u (some (.inl j)) htag s
    ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩) history i

end Ghost

section Edge
variable (k : K) (htag : steps.get u = some (.inr k))
    (sk : FullActiveEdgeSkeleton n (S k) B (A k) (Δ k) (D k) s) (fresh : FullActiveEdgeSamples n (S k) B (A k) (Δ k) (D k) s sk)

theorem full_mixed_common_edge_history_sample_label (i : FullActiveEdgeSampleIndex n (S k) B (A k) (Δ k) (D k) s sk) :
    fullMixedCommonHistoryWrite n S B A Δ D steps u s
      (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inr k)) htag s ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm ⟨sk, fresh⟩)) history (fullMixedCommonEdgeSampleEmbedding n S B k steps u htag (A k) (Δ k) (D k) s sk i) = some ⟨i.1, fresh i⟩ := by
  have h := full_mixed_common_tagged_history_write_here n S B A Δ D steps u (some (.inr k)) htag s
    ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm ⟨sk, fresh⟩) history
    (fullMixedBirthCoordinateEquiv n S B A Δ D (some (.inr k)) s ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm ⟨sk, fresh⟩) i).val
  refine h.trans ?_
  exact congrArg (Option.map (fullMixedBornPrime n))
    (full_mixed_birth_coordinate_data n S B A Δ D (some (.inr k)) s ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm ⟨sk, fresh⟩) i)

theorem full_mixed_common_edge_history_sample_coverage
    (i : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps))) :
    ((fullMixedCommonHistoryWrite n S B A Δ D steps u s
      (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inr k)) htag s ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm ⟨sk, fresh⟩)) history i).isSome = true ∧
      fullMixedCommonIndexStage M B steps i = u.succ) ↔
      ∃ c, fullMixedCommonEdgeSampleEmbedding n S B k steps u htag (A k) (Δ k) (D k) s sk c = i :=
  full_mixed_common_tagged_history_write_coverage n S B A Δ D steps u (some (.inr k)) htag s
    ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm ⟨sk, fresh⟩) history i

end Edge

end Full
end Bounty
