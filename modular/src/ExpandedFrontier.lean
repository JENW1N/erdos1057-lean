/- Fixed multiplicative scale constants are absorbed with their exact logarithmic cost. -/

open Finset Filter Real
namespace Bounty

theorem determinant_bound_le_three_rpow_public {L K : ℝ}
    (hL : 1 ≤ L) (hK : 0 ≤ K) :
    (typeIIAdmissibleDeterminantBound L K : ℝ) ≤ 3*L^(K+88) := by
  have hp : 1 ≤ L^(K+88) := one_le_rpow hL (by linarith)
  have hceil := Nat.ceil_lt_add_one (show 0 ≤ 2*L^(K+88) by positivity)
  change (⌈2*L^(K+88)⌉₊ : ℝ) ≤ _
  linarith

theorem eventually_typeII_fixed_multiple_dyadic_geometry {b K C : ℝ}
    (hb : 0 < b) (hK : 0 ≤ K) (hC : 0 < C) :
    ∀ᶠ L : ℝ in atTop, ∀ U V E : ℝ,
      exp (b*L) ≤ U → U ≤ C*exp L → exp (b*L) ≤ V → V ≤ C*exp L →
      E = U*L^(-K) →
      0 < U ∧ 0 < V ∧ 0 < E ∧ 4 ≤ U*V ∧ log (U*V) ≤ 2*L+2*log C ∧
      (2*U)/(2*(E/(2*L^88))) ≤ (typeIIAdmissibleDeterminantBound L K : ℝ) ∧
      max 1 (typeIIAdmissibleDeterminantBound L K : ℝ) ≤ typeIISmoothDyadicScale U V E 0 ∧
      log (24*U^2*V*L^88/E) ≤ 3*L ∧
      (typeIIAdmissibleDeterminantBound L K : ℝ) ≤ exp (sqrt L) ∧ 2 ≤ exp (sqrt L) := by
  have hgrowth := eventually_mul_rpow_log_add_le_rpow
    (a := (0:ℝ)) (b := (1:ℝ)) (c := 2*b)
    (by norm_num) (by norm_num) (by positivity) 88 (log 48)
  have hlogcost := eventually_mul_rpow_log_add_le_rpow
    (a := (0:ℝ)) (b := (1:ℝ)) (c := (1:ℝ))
    (by norm_num) (by norm_num) (by norm_num) (K+88) (log 24+2*log C)
  have hsqrtcost := eventually_mul_rpow_log_add_le_rpow
    (a := (0:ℝ)) (b := (1/2:ℝ)) (c := (1:ℝ))
    (by norm_num) (by norm_num) (by norm_num) (K+88) (log 3)
  filter_upwards [hgrowth, hlogcost, hsqrtcost, eventually_ge_atTop (1:ℝ)]
    with L hgrowth hlogcost hsqrtcost hL
  simp only [rpow_zero, rpow_one, mul_one, one_mul, ← sqrt_eq_rpow] at hgrowth hlogcost hsqrtcost
  intro U V E hUlo hUhi hVlo hVhi hE
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hU : 0 < U := (exp_pos _).trans_le hUlo
  have hV : 0 < V := (exp_pos _).trans_le hVlo
  have hE0 : 0 < E := by rw [hE]; positivity
  have hpK : 0 < L^K := rpow_pos_of_pos hL0 K
  have hp88 : 1 ≤ L^88 := one_le_pow₀ hL
  have hp : 1 ≤ L^(K+88) := one_le_rpow hL (by linarith)
  have hUVlower : 48*L^88 ≤ U*V := by
    have hl : log (48*L^88) ≤ (2*b)*L := by
      rw [log_mul (by norm_num) (by positivity), log_pow]
      norm_num
      linarith
    calc
      _ = exp (log (48*L^88)) := (exp_log (by positivity)).symm
      _ ≤ exp ((2*b)*L) := exp_le_exp.mpr hl
      _ = exp (b*L)*exp (b*L) := by rw [← exp_add]; congr 1; ring
      _ ≤ U*V := mul_le_mul hUlo hVlo (exp_pos _).le hU.le
  have hUV : 4 ≤ U*V := by nlinarith
  have hlogU : log U ≤ log C+L := by
    simpa only [log_mul hC.ne' (exp_ne_zero L),log_exp] using log_le_log hU hUhi
  have hlogV : log V ≤ log C+L := by
    simpa only [log_mul hC.ne' (exp_ne_zero L),log_exp] using log_le_log hV hVhi
  have hlogUV : log (U*V) ≤ 2*L+2*log C := by rw [log_mul hU.ne' hV.ne']; linarith
  have hB := determinant_bound_le_three_rpow_public hL hK
  have hscale : max 1 (typeIIAdmissibleDeterminantBound L K : ℝ) ≤
      typeIISmoothDyadicScale U V E 0 := by
    have heq : typeIISmoothDyadicScale U V E 0 = U*V*L^K/16 := by
      simp only [typeIISmoothDyadicScale, pow_zero, mul_one]
      rw [hE, rpow_neg hL0.le]
      field_simp
    rw [heq]
    calc
      _ ≤ 3*L^(K+88) := max_le (by linarith) hB
      _ = (48*L^88)*L^K/16 := by rw [rpow_add hL0]; norm_num; ring
      _ ≤ U*V*L^K/16 := div_le_div_of_nonneg_right
        (mul_le_mul_of_nonneg_right hUVlower hpK.le) (by norm_num)
  have hupper : 24*U^2*V*L^88/E = 24*U*V*L^(K+88) := by
    rw [hE, rpow_add hL0, rpow_neg hL0.le]
    norm_num
    field_simp
  have hlogupper : log (24*U^2*V*L^88/E) ≤ 3*L := by
    rw [hupper, log_mul (by positivity) (by positivity),
      log_mul (by positivity) hV.ne', log_mul (by norm_num) hU.ne', log_rpow hL0]
    linarith
  have hBrough : (typeIIAdmissibleDeterminantBound L K : ℝ) ≤ exp (sqrt L) := by
    apply hB.trans
    have hl : log (3*L^(K+88)) ≤ sqrt L := by
      rw [log_mul (by norm_num) (by positivity), log_rpow hL0]
      linarith
    calc
      _ = exp (log (3*L^(K+88))) := (exp_log (by positivity)).symm
      _ ≤ _ := exp_le_exp.mpr hl
  have hrough : 2 ≤ exp (sqrt L) := by
    have hsqrt : 1 ≤ sqrt L := one_le_sqrt.mpr hL
    linarith [add_one_le_exp (sqrt L)]
  exact ⟨hU, hV, hE0, hUV, hlogUV, typeII_admissible_determinant_bound hL0 hU hE,
    hscale, hlogupper, hBrough, hrough⟩


end Bounty
end

