      (∏ a ∈ physicalPrimeGroups P groups,
        ghostPhaseRunHistory (fun j => decide (a ∈ physicalMarkedPrimes (finitePathMarks L p.val j)))
          (fun j => -(physicalBareOffset C k (finitePathLabels p.val) (finitePathMarks L p.val)
