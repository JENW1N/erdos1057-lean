/- The original memory-walk coefficient times its capped residue history,
summed over selected data, is the original physical moment with its exact
initial mass. Zero rows and the original coefficient are retained. -/

open Finset Classical
namespace Bounty

theorem physical_selected_memory_history_sum_eq_moment
    {I : Type*} {N J ell r B : ℕ} {P : Fin N → Finset ℕ}
    [∀ g (p : P g), NeZero p.val]
    (V : Fin N → ℝ) (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
    (ζ : ℕ → I → ℝ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ)
    (pattern : Fin (r + 1) → patterns)
    [Fintype (PhysicalSelectedData P ell (fun j => C (pattern j).val))]
    (k : Fin (r + 1) → ℤ)
    (a : PhysicalSelectedData P ell (fun j => C (pattern j).val) → Fin (r + 2) → ℤ)
    (hstep : ∀ d, ∀ j : Fin (r + 1), a d j.succ = a d j.castSucc +
      k j * (physicalD (C (pattern j).val)
        (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc)) (d.1 j) : ℤ))
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hk : ∀ d : PhysicalSelectedData P ell (fun j => C (pattern j).val),
      ∀ j : Fin (r + 1), ∀ g s, ¬ ((d.2.1 j.castSucc g s).val : ℤ) ∣ k j)
    (β : (g : Fin N) → P g → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0)
    (q : Fin (r + 2) → ℝ) (hρ : ρ ≠ 0)
    (cut : ℕ → Fin N → Finset (Fin J))
    (hencode : ∀ i, PhysicalMarkRowEncoding (fun j => C (pattern j).val)
      (physicalSelectedFineTag (r + 1) i) (cut i) (cut (i + 1))) :
    (∑ d : PhysicalSelectedData P ell (fun j => C (pattern j).val),
      physicalMemoryWalkScalar V patterns C ζ K
        (finitePathLabels ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d⟩).2)
        (finitePathMarks ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d⟩).1
          ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d⟩).2) (r + 1) *
      (ghostPhaseCappedHistory
        (fun p : PhysicalPrime P => fun j => globalBirthFiniteActivity
          (physicalGroupBareFiniteActivity d.2.1 p.1) j p.2)
        (fun p => physicalResidueAbsoluteHit (a d) p.1 p.2)
        (fun _ j => 1 - q (globalBirthFiniteIndex (r + 1) j))
        (fun p => β p.1 p.2) (fun p => V p.1) (fun _ => B) (fun _ => B) (r + 1) : ℂ)) =
    ∑ L : PhysicalMarkLists P J ell,
      ((∏ g, ∏ s : PhysicalSlots J ell, β g (L g s) / V g : ℝ) : ℂ) *
      physicalOriginalSelectedMoment (fun j => C (pattern j).val) k
        (fun j _ aux => physicalAuxMass V (C (pattern j).val) aux) β q ρ V cut
        (fun j => ζ ((r + 1) - 1 - j.val) (pattern j).val)
        (fun j => K ((r + 1) - 1 - j.val) (pattern j).val) fullMemoryVacuum
        (physicalFullMemoryState (cut 0) L
          (fun g => fullEmptyBoundedMemory (UnrestrictedResidueParticle (fun p : P g => p.val)) B)) := by
  have hnorm (d : PhysicalSelectedData P ell (fun j => C (pattern j).val)) :=
    physical_selected_memory_history_normalization V patterns C ζ K pattern d k (a d)
      (hstep d) hP hdis (hk d) β ρ hV B q hρ
  simp_rw [hnorm]
  exact physical_selected_weighted_sum_eq_moment_pairing (fun j => C (pattern j).val) k
    (fun j _ aux => physicalAuxMass V (C (pattern j).val) aux) β q ρ V cut
    (fun j => ζ ((r + 1) - 1 - j.val) (pattern j).val)
    (fun j => K ((r + 1) - 1 - j.val) (pattern j).val) hV hP hdis hencode
    (fun L => ((∏ g, ∏ s : PhysicalSlots J ell, β g (L g s) / V g : ℝ) : ℂ))

end Bounty
