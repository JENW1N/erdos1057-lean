/- Recorded rows with local complex phases are original event paths with
one whole-path phase. Terminal conditions may inspect the complete record. -/

namespace Bounty

section Recorded
variable {K X O : Type*} (E : K → X → Type*)
  (target : ∀ k x, E k x → X) (phase : ∀ k x, E k x → ℂ)
  (observe : ∀ k x, E k x → O)

noncomputable def finiteRecordedPathPhase (ks : List K) (initial : X → List O)
    (F : List O → X → ℂ) (x : X) (p : FiniteEventPath E target ks x) : ℂ :=
  finiteEventLocalPhase (fun k (s : List O × X) => E k s.2)
    (finiteLedgerEventTarget E target (finiteObservationLedgerUpdate E observe))
    (fun k s => phase k s.2) ks (initial x, x)
    ((finiteLedgerEventPathEquiv E target (finiteObservationLedgerUpdate E observe)
      ks (initial x) x).symm p) *
      F (initial x ++ finiteEventPathObservations E target observe ks x p)
        (finiteEventPathTerminal E target ks x p)

theorem finite_recorded_path_phase_norm_le
    (hphase : ∀ k x e, ‖phase k x e‖ ≤ 1)
    (ks : List K) (initial : X → List O) (F : List O → X → ℂ)
    (hF : ∀ r x, ‖F r x‖ ≤ 1) (x : X) (p : FiniteEventPath E target ks x) :
    ‖finiteRecordedPathPhase E target phase observe ks initial F x p‖ ≤ 1 := by
  unfold finiteRecordedPathPhase
  rw [norm_mul]
  exact mul_le_one₀
    (finite_event_local_phase_norm_le (fun k (s : List O × X) => E k s.2)
      (finiteLedgerEventTarget E target (finiteObservationLedgerUpdate E observe))
      (fun k s => phase k s.2) (fun k s e => hphase k s.2 e) _ _ _)
    (norm_nonneg _) (hF _ _)

variable [∀ k x, Fintype (E k x)] (weight : ∀ k x, E k x → ℝ)

noncomputable def finiteRecordedPhasedRow : K → (List O × X → ℂ) → List O × X → ℂ :=
  finiteLocalPhasedRow (fun k (s : List O × X) => E k s.2)
    (finiteLedgerEventTarget E target (finiteObservationLedgerUpdate E observe))
    (fun k s => phase k s.2) (fun k s => weight k s.2)

theorem finite_recorded_phased_rows_eq_paths (ks : List K) (initial : X → List O)
    (F : List O → X → ℂ) (f : X → ℂ) :
    (fun x => finiteOperatorListAction
      (finiteRecordedPhasedRow E target phase observe weight) ks
      (fun s => F s.1 s.2 * f s.2) (initial x, x)) =
    finiteEventPathAction E target weight ks
      (finiteRecordedPathPhase E target phase observe ks initial F) f := by
  unfold finiteRecordedPhasedRow
  simp_rw [finite_phased_rows_eq_event_paths]
  exact finite_recorded_observation_path_action_with_terminal_factor E target observe weight
    ks initial (finiteEventLocalPhase (fun k (s : List O × X) => E k s.2)
      (finiteLedgerEventTarget E target (finiteObservationLedgerUpdate E observe))
      (fun k s => phase k s.2) ks) F f

end Recorded
end Bounty
end

