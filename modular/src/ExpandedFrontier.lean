/- The precise free-tuple prime comparison estimate supplies the actual component error. -/

namespace Bounty

open Finset
open scoped Classical

theorem prime_admissible_component_error_le {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ) (hV : ∀ i, 0 < V i)
    (hp : ∀ i p, p ∈ P i → 0 < p) (hmass : ∀ i, ∑ p ∈ P i, 1 / (p : ℝ) = V i)
    (active U W S T A B : Finset I) (hU : U ⊆ active) (hW : W ⊆ active) (hUW : Disjoint U W)
    (hA : A ⊆ U \ S) (hB : B ⊆ W \ T)
    (Q : ℕ) (h : ℝ) (keptA keptB : Finset I → Finset ℤ) (ζ Θ : ℝ)
    (f g : (∀ i, P i) → ℂ) (ε : ℝ) (hε : 0 ≤ ε)
    (hfree : ∀ α : ℝ, ∀ (u : (∀ i : A, P i.1) → ℂ) (v : (∀ i : B, P i.1) → ℂ),
      ‖finiteTwoKernelPairingError
        (finiteProductWeight (physicalLabelLaw (P := fun i : A => P i.1) (fun i => V i.1)))
        (finiteProductWeight (physicalLabelLaw (P := fun i : B => P i.1) (fun i => V i.1)))
        (primeProductIdealKernel (fun i : A => P i.1) (fun i => V i.1) Q h (keptA A))
        (primeProductIdealKernel (fun i : B => P i.1) (fun i => V i.1) Q h (keptB B))
        (fun a b => Complex.exp (Complex.I *
          (ζ * Real.log (((∏ i : A, (a i).val : ℕ) : ℝ) * (∏ i : B, (b i).val : ℕ)) +
            2 * Real.pi * (α * (((∏ i : A, (a i).val : ℕ) : ℝ) *
              (∏ i : B, (b i).val : ℕ))) : ℝ))) u v‖ ≤
        ε * Real.sqrt (finiteWeightedEnergy
          (finiteProductWeight (physicalLabelLaw (P := fun i : A => P i.1) (fun i => V i.1))) u) *
        Real.sqrt (finiteWeightedEnergy
          (finiteProductWeight (physicalLabelLaw (P := fun i : B => P i.1) (fun i => V i.1))) v)) :
    ‖cleanKernelPairing (finiteProductWeight (physicalLabelLaw V))
        (primeAsymmetricComparisonKernel P V active Q h keptA keptB ζ Θ A B)
        (finiteCoordinateComponent (physicalLabelLaw V) S U.toList
          (finiteCoordinateComponent (physicalLabelLaw V) ∅ activeᶜ.toList f))
        (finiteCoordinateComponent (physicalLabelLaw V) T W.toList
          (finiteCoordinateComponent (physicalLabelLaw V) ∅ activeᶜ.toList g)) -
      cleanRawPairing (finiteProductWeight (physicalLabelLaw V)) (primeActivePhase P active ζ Θ)
        (finiteCoordinateComponent (physicalLabelLaw V) S U.toList
          (finiteCoordinateComponent (physicalLabelLaw V) ∅ activeᶜ.toList f))
        (finiteCoordinateComponent (physicalLabelLaw V) T W.toList
          (finiteCoordinateComponent (physicalLabelLaw V) ∅ activeᶜ.toList g))‖ ≤
      ε * Real.sqrt (finiteWeightedEnergy (finiteProductWeight (physicalLabelLaw V))
        (finiteCoordinateComponent (physicalLabelLaw V) S U.toList
          (finiteCoordinateComponent (physicalLabelLaw V) ∅ activeᶜ.toList f))) *
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight (physicalLabelLaw V))
          (finiteCoordinateComponent (physicalLabelLaw V) T W.toList
            (finiteCoordinateComponent (physicalLabelLaw V) ∅ activeᶜ.toList g))) := by
  let μA := finiteProductWeight (physicalLabelLaw (P := fun i : A => P i.1) (fun i => V i.1))
  let μB := finiteProductWeight (physicalLabelLaw (P := fun i : B => P i.1) (fun i => V i.1))
  let KA := primeProductIdealKernel (fun i : A => P i.1) (fun i => V i.1) Q h (keptA A)
  let KB := primeProductIdealKernel (fun i : B => P i.1) (fun i => V i.1) Q h (keptB B)
  let π := fun a : ∀ i : A, P i.1 => ∏ i : A, (a i).val
  let τ := fun b : ∀ i : B, P i.1 => ∏ i : B, (b i).val
  let phase := fun (c : ∀ i : ↥(active \ (A ∪ B)), P i.1)
    (a : ∀ i : A, P i.1) (b : ∀ i : B, P i.1) =>
      primeTuplePhase ζ Θ ((∏ i, (c i).val) * π a * τ b)
  have hAU : A ⊆ U := fun i hi => (mem_sdiff.mp (hA hi)).1
  have hBW : B ⊆ W := fun i hi => (mem_sdiff.mp (hB hi)).1
  have hAB : Disjoint A B := hUW.mono hAU hBW
  have hk : primeActivePhase P active ζ Θ = fun x =>
      phase (finiteCoordinateRestrict (active \ (A ∪ B)) x)
        (finiteCoordinateRestrict A x) (finiteCoordinateRestrict B x) := by
    funext x
    exact prime_active_phase_three_partition P active A B (hAU.trans hU) (hBW.trans hW) hAB ζ Θ x
  rw [norm_sub_rev, hk]
  apply finite_admissible_component_slice_error_le (physicalLabelLaw V)
    (physical_label_law_nonneg V (fun i => (hV i).le))
    (fun i => physical_label_law_sum V i (hV i) (hmass i))
    active U W S T A B hU hW hUW hA hB KA KB phase f g ε hε
  intro c u v
  have hπ : ∀ a, 0 < π a := fun a => prod_pos (fun i _ => hp i.1 (a i).val (a i).property)
  have hτ : ∀ b, 0 < τ b := fun b => prod_pos (fun i _ => hp i.1 (b i).val (b i).property)
  have hc : 0 < ∏ i, (c i).val := prod_pos (fun i _ => hp i.1 (c i).val (c i).property)
  change ‖finiteTwoKernelPairingError μA μB KA KB (phase c) u v‖ ≤ _
  rw [show phase c = (fun a b => primeTuplePhase ζ Θ ((∏ i, (c i).val) * π a * τ b)) from rfl,
    prime_shared_phase_error_norm μA μB KA KB π τ hπ hτ ζ Θ _ hc]
  exact hfree (Θ * (∏ i, (c i).val : ℕ)) u v

end Bounty
end

section

/- Visit identification with the already defined physical residue schedule.
The literal tensor row retains its cumulative ledger and both total caps. -/

open Finset
namespace Bounty

section ResiduePath
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (ζ : ∀ p : PhysicalPrime P, ZMod p.2.val)
  (hmarks : ∀ j : Fin (n + 1), ∀ p ∈ physicalMarkedPrimes (L j),
    ζ p = -(a j : ZMod p.2.val))
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ) (η : Fin N → Fin (n + 1) → ℝ)
  (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0) (B : ℕ)

theorem physical_joint_residue_visit_literal_tensor (j : Fin (n + 1))
    (activity : (g : Fin N) → ↥(P g) → Bool)
    (F : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ)
    (s : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val)) :
    globalBirthJointCutRawRow
      (physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β η V
        (fun _ => ρ) hV B (2 * j.val)) B B F s =
    globalBirthJointCutRawRow
      (fun g => GlobalBirthRawStep.visit (a := activity g)
        (fun _ => 0) (β g) (η g j) (V g) ρ (hV g) B) B B F s := by
  have hr :
      (fun g (K : GlobalBirthHistoryState (fun p : ↥(P g) => ZMod p.val) → ℂ)
        (u : GlobalBirthHistoryState (fun p : ↥(P g) => ZMod p.val)) =>
        globalBirthRawStepRow
          (physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β η V
            (fun _ => ρ) hV B (2 * j.val) g) (fun H q => K (H, q)) u.1 u.2) =
      (fun g (K : GlobalBirthHistoryState (fun p : ↥(P g) => ZMod p.val) → ℂ)
        (u : GlobalBirthHistoryState (fun p : ↥(P g) => ZMod p.val)) =>
        globalBirthRawStepRow
          (GlobalBirthRawStep.visit (a := activity g) (fun _ => 0) (β g) (η g j)
            (V g) ρ (hV g) B) (fun H q => K (H, q)) u.1 u.2) := by
    funext g K u
    exact physical_group_residue_finite_visit_row C aux k L a σ τ hstep ζ hmarks
      hlist hP hdis g (fun j => hk j g) (β g) (η g) (V g) ρ (hV g) B j
      (fun H q => K (H, q)) u.1 u.2
  unfold globalBirthJointCutRawRow globalBirthJointRawRow
  rw [hr]

end ResiduePath
end Bounty
end

section

/- Extending a bounded physical continuation by zero and reading out a
bounded physical state exactly recovers that continuation. -/

namespace Bounty

theorem physical_mark_extension_roundtrip {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (F : PhysicalBoundedMarkState P J ell B → ℂ) (s : PhysicalBoundedMarkState P J ell B) :
    physicalMarkRawExtension F s.1 (physicalMarkRawReadout s) = F s := by
  have hs : ∀ g, (physicalMarkRawReadout s g).2.1 ≤ B :=
    fun g => Nat.le_of_lt_succ (s.2.2 g).1.isLt
  unfold physicalMarkRawExtension
  rw [dif_pos hs]
  apply congrArg F
  apply Prod.ext rfl
  apply Prod.ext rfl
  funext g
  rcases s.2.2 g with ⟨⟨m, hm⟩, q⟩
  rfl

end Bounty
end

section

/- Lattice bounds in natural residues and a crude sufficient pair-sieve remainder bound. -/

open Finset

namespace Bounty

theorem interval_allowed_nat_residue_pairs_error (A B C D r : ℕ) (hr : 0 < r)
    (R : Finset (ℕ × ℕ)) (hR : ∀ v ∈ R, v.1 < r ∧ v.2 < r)
    (hAB : A ≤ B) (hCD : C ≤ D) :
    |(((Finset.product (Ioc A B) (Ioc C D)).filter
        (fun n : ℕ × ℕ => (n.1 % r, n.2 % r) ∈ R)).card : ℝ) -
      (R.card : ℝ) * ((((B : ℝ)-A)/r) * (((D : ℝ)-C)/r))| ≤
      (R.card : ℝ) * (1 + ((B : ℝ)-A)/r + ((D : ℝ)-C)/r) := by
  let P := Finset.product (Ioc A B) (Ioc C D)
  let f : ℕ × ℕ → ℕ × ℕ := fun v => (v.1 % r, v.2 % r)
  let X := (((B : ℝ)-A)/r) * (((D : ℝ)-C)/r)
  let E := 1 + ((B : ℝ)-A)/r + ((D : ℝ)-C)/r
  have hsum : (∑ a ∈ R, ((P.filter (fun v => f v = a)).card : ℝ)) =
      ((P.filter (fun v => f v ∈ R)).card : ℝ) := by
    simpa only [sum_const, nsmul_eq_mul, mul_one] using
      sum_fiberwise_eq_sum_filter P R f (fun _ => (1 : ℝ))
  have hbound (a : ℕ × ℕ) (ha : a ∈ R) :
      |((P.filter (fun v => f v = a)).card : ℝ)-X| ≤ E := by
    have hset : P.filter (fun v => f v = a) =
        P.filter (fun v : ℕ × ℕ => v.1 % r = a.1 % r ∧ v.2 % r = a.2 % r) := by
      apply filter_congr
      intro v _
      change (v.1 % r, v.2 % r) = a ↔ _
      rw [Prod.ext_iff, Nat.mod_eq_of_lt (hR a ha).1, Nat.mod_eq_of_lt (hR a ha).2]
    rw [hset]
    exact interval_residue_pair_count_error A B C D r a.1 a.2 hAB hCD hr
  have hid : ((P.filter (fun v => f v ∈ R)).card : ℝ) - (R.card : ℝ)*X =
      ∑ a ∈ R, (((P.filter (fun v => f v = a)).card : ℝ)-X) := by
    rw [sum_sub_distrib, hsum]
    simp only [sum_const, nsmul_eq_mul]
  change |((P.filter (fun v => f v ∈ R)).card : ℝ) - (R.card : ℝ)*X| ≤ (R.card : ℝ)*E
  rw [hid]
  exact (abs_sum_le_sum_abs _ _).trans
    ((sum_le_sum hbound).trans_eq (by simp))

theorem nat_pair_bad_residue_card_le (p : ℕ) (rough banned : Bool) :
    (natPairBadResidues p rough banned).card ≤ p^2 := by
  apply (card_le_card (filter_subset _ _)).trans_eq
  rw [Finset.product_eq_sprod, card_product, card_range]
  ring

theorem actual_pair_sieve_residue_card_le (m : ℕ) [NeZero m]
    (P : Finset ℕ) (rough banned : ℕ → Bool)
    (hP : ∀ p ∈ P, p.Prime) (hPm : ∀ p ∈ P, ¬p ∣ m) :
    (natPairSieveResidues m (natPairBaseResidues m) P
      (fun p => natPairBadResidues p (rough p) (banned p))).card ≤ m * (∏ p ∈ P, p)^2 := by
  rw [actual_pair_sieve_residue_card m P rough banned hP hPm]
  apply (Nat.mul_le_mul (Nat.totient_le m)
    (prod_le_prod' (fun p _ => nat_pair_bad_residue_card_le p (rough p) (banned p)))).trans_eq
  rw [prod_pow]

theorem pair_lattice_crude_error {m d R X Y : ℝ}
    (hm : 0 < m) (hd : 0 < d) (hX : 0 ≤ X) (hY : 0 ≤ Y) (hR : R ≤ m*d^2) :
    R*(1+X/(m*d)+Y/(m*d)) ≤ m*d^2 + (X+Y)*d := by
  have hquot : R/(m*d) ≤ d := (div_le_iff₀ (mul_pos hm hd)).mpr (by nlinarith)
  calc
    _ = R + (X+Y)*(R/(m*d)) := by ring
    _ ≤ m*d^2+(X+Y)*d := add_le_add hR (mul_le_mul_of_nonneg_left hquot (add_nonneg hX hY))

end Bounty
end

section

/- Complete state-and-observation records remain injective when cut encodings vary. -/

namespace Bounty

section Record

variable {O : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (before after : Fin N → Finset (Fin J))

noncomputable def physicalMarkRecordEncode
    (r : PhysicalBoundedMarkState P J ell B × O × PhysicalBoundedMarkState P J ell B) :
    FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B × O ×
    FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B :=
  (physicalBoundedMarkEncode before r.1, r.2.1, physicalBoundedMarkEncode after r.2.2)

theorem physical_mark_record_encode_injective :
    Function.Injective (physicalMarkRecordEncode (O := O) (P := P)
      (ell := ell) (B := B) before after) := by
  intro r s h
  have hsource := congrArg Prod.fst h
  have hobservation := congrArg (fun x => x.2.1) h
  have htarget := congrArg (fun x => x.2.2) h
  exact Prod.ext (physical_bounded_mark_encode_injective before hsource)
    (Prod.ext hobservation (physical_bounded_mark_encode_injective after htarget))

theorem physical_mark_record_encode_eq_iff
    (r s : PhysicalBoundedMarkState P J ell B × O × PhysicalBoundedMarkState P J ell B) :
    physicalMarkRecordEncode before after r = physicalMarkRecordEncode before after s ↔ r = s :=
  (physical_mark_record_encode_injective before after).eq_iff

end Record

section History

variable {O : Type*} {N J ell B steps : ℕ} {P : Fin N → Finset ℕ}
    (cut : ℕ → Fin N → Finset (Fin J))

noncomputable def physicalMarkRecordHistoryEncode
    (r : Fin steps → PhysicalBoundedMarkState P J ell B × O ×
      PhysicalBoundedMarkState P J ell B) :=
  List.ofFn (fun i => physicalMarkRecordEncode (cut i.val) (cut (i.val + 1)) (r i))

theorem physical_mark_record_history_encode_injective :
    Function.Injective (physicalMarkRecordHistoryEncode (O := O) (P := P)
      (ell := ell) (B := B) (steps := steps) cut) := by
  intro r s h
  have hfun := List.ofFn_injective h
  funext i
  exact physical_mark_record_encode_injective (cut i.val) (cut (i.val + 1))
    (congrFun hfun i)

theorem physical_mark_record_history_encode_eq_iff
    (r s : Fin steps → PhysicalBoundedMarkState P J ell B × O ×
      PhysicalBoundedMarkState P J ell B) :
    physicalMarkRecordHistoryEncode cut r = physicalMarkRecordHistoryEncode cut s ↔ r = s :=
  (physical_mark_record_history_encode_injective cut).eq_iff

noncomputable def physicalMarkRecordHistoryPredicate
    (test : (Fin steps → PhysicalBoundedMarkState P J ell B × O ×
      PhysicalBoundedMarkState P J ell B) → Prop)
    (r : List (FullMixedLedgerState (fun g (p : ↥(P g)) => p.val)
      (M := fun _ => J + ell) B × O ×
      FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)) : Prop :=
  ∃ s, physicalMarkRecordHistoryEncode cut s = r ∧ test s

theorem physical_mark_record_history_predicate_encode
    (test : (Fin steps → PhysicalBoundedMarkState P J ell B × O ×
      PhysicalBoundedMarkState P J ell B) → Prop)
    (r : Fin steps → PhysicalBoundedMarkState P J ell B × O ×
      PhysicalBoundedMarkState P J ell B) :
    physicalMarkRecordHistoryPredicate cut test (physicalMarkRecordHistoryEncode cut r) ↔
      test r := by
  constructor
  · rintro ⟨s, hs, ht⟩
    exact (physical_mark_record_history_encode_injective cut hs) ▸ ht
  · intro ht
    exact ⟨r, rfl, ht⟩

end History

end Bounty
end

section

/- The concrete prime row, extended by zero outside the active disjoint
subset pairs. The valid branch retains the literal physical auxiliary sum. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def repeatedBigPrimeRawRow
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ) (ζ Θ : ℝ)
    (source target : RepeatedBigLists P J ell) : ℂ :=
  ∑ aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))),
    repeatedBigUnbannedKernel V (fun _ _ => 1) (fun _ => ∅) ζ (fun _ _ _ => 1)
      aux source target * physicalReturnPhase Θ (repeatedBigD (fun _ => ∅) source aux)

theorem repeated_big_active_pair_avoids_tail
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    {A B : Finset (RepeatedBigFlatIndex G J ell)}
    (hA : A ⊆ repeatedBigFlatActive J ell) (hB : B ⊆ repeatedBigFlatActive J ell) :
    ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B := by
  intro g j hj
  exact repeatedBigFlatActive_not_mem_inr J ell g j
    ((union_subset hA hB) hj)

noncomputable def repeatedBigPrimeComparisonRow
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell)) (Q : ℕ) (h : ℝ)
    (keptA keptB : Finset (RepeatedBigFlatIndex G J ell) → Finset ℤ)
    (ζ Θ : ℝ) : RepeatedBigLists P J ell → RepeatedBigLists P J ell → ℂ :=
  if hvalid : A ⊆ repeatedBigFlatActive J ell ∧
      B ⊆ repeatedBigFlatActive J ell ∧ Disjoint A B then
    repeatedBigPrimeRow P V A B
      (repeated_big_active_pair_avoids_tail hvalid.1 hvalid.2.1) hvalid.2.2
      Q h keptA keptB ζ Θ
  else 0

theorem repeatedBigPrimeComparisonRow_eq
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hA : A ⊆ repeatedBigFlatActive J ell) (hB : B ⊆ repeatedBigFlatActive J ell)
    (hAB : Disjoint A B) (Q : ℕ) (h : ℝ)
    (keptA keptB : Finset (RepeatedBigFlatIndex G J ell) → Finset ℤ) (ζ Θ : ℝ) :
    repeatedBigPrimeComparisonRow P V A B Q h keptA keptB ζ Θ =
      repeatedBigPrimeRow P V A B (repeated_big_active_pair_avoids_tail hA hB)
        hAB Q h keptA keptB ζ Θ := by
  unfold repeatedBigPrimeComparisonRow
  rw [dif_pos (show A ⊆ repeatedBigFlatActive J ell ∧
    B ⊆ repeatedBigFlatActive J ell ∧ Disjoint A B from ⟨hA, hB, hAB⟩)]

theorem repeatedBigPrimeComparisonRow_eq_zero
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hbad : ¬(A ⊆ repeatedBigFlatActive J ell ∧
      B ⊆ repeatedBigFlatActive J ell ∧ Disjoint A B)) (Q : ℕ) (h : ℝ)
    (keptA keptB : Finset (RepeatedBigFlatIndex G J ell) → Finset ℤ) (ζ Θ : ℝ) :
    repeatedBigPrimeComparisonRow P V A B Q h keptA keptB ζ Θ = 0 := by
  simp only [repeatedBigPrimeComparisonRow, dif_neg hbad]

theorem repeated_big_prime_comparison_pairing_eq
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hA : A ⊆ repeatedBigFlatActive J ell) (hB : B ⊆ repeatedBigFlatActive J ell)
    (hAB : Disjoint A B) (Q : ℕ) (h : ℝ)
    (keptA keptB : Finset (RepeatedBigFlatIndex G J ell) → Finset ℤ)
    (ζ Θ : ℝ) (f g : RepeatedBigLists P J ell → ℂ) :
    cleanKernelPairing (repeatedBigActiveMass V (fun _ _ => 1))
      (repeatedBigPrimeComparisonRow P V A B Q h keptA keptB ζ Θ) f g =
    cleanKernelPairing
      (finiteProductWeight (fun i : RepeatedBigFlatIndex G J ell => physicalLabelLaw V i.1))
      (primeAsymmetricComparisonKernel (fun i : RepeatedBigFlatIndex G J ell => P i.1)
        (fun i => V i.1) (repeatedBigFlatActive J ell) Q h keptA keptB ζ Θ A B)
      (finiteGroupFlattenFunction f) (finiteGroupFlattenFunction g) := by
  rw [repeatedBigPrimeComparisonRow_eq P V A B hA hB hAB]
  exact repeated_big_prime_pairing_eq P V A B
    (repeated_big_active_pair_avoids_tail hA hB) hAB Q h keptA keptB ζ Θ f g

theorem repeated_big_prime_comparison_pairing_tail_eq
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (hV : ∀ g, 0 < V g) (hP : ∀ g p, p ∈ P g → 0 < p)
    (hmass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hA : A ⊆ repeatedBigFlatActive J ell) (hB : B ⊆ repeatedBigFlatActive J ell)
    (hAB : Disjoint A B) (Q : ℕ) (h : ℝ)
    (keptA keptB : Finset (RepeatedBigFlatIndex G J ell) → Finset ℤ)
    (ζ Θ : ℝ) (f g : RepeatedBigLists P J ell → ℂ) :
    cleanKernelPairing (repeatedBigActiveMass V (fun _ _ => 1))
      (repeatedBigPrimeComparisonRow P V A B Q h keptA keptB ζ Θ) f g =
    cleanKernelPairing
      (finiteProductWeight (fun i : RepeatedBigFlatIndex G J ell => physicalLabelLaw V i.1))
      (primeAsymmetricComparisonKernel (fun i : RepeatedBigFlatIndex G J ell => P i.1)
        (fun i => V i.1) (repeatedBigFlatActive J ell) Q h keptA keptB ζ Θ A B)
      (finiteCoordinateComponent (fun i : RepeatedBigFlatIndex G J ell => physicalLabelLaw V i.1)
        ∅ (repeatedBigFlatActive J ell)ᶜ.toList (finiteGroupFlattenFunction f))
      (finiteCoordinateComponent (fun i : RepeatedBigFlatIndex G J ell => physicalLabelLaw V i.1)
        ∅ (repeatedBigFlatActive J ell)ᶜ.toList (finiteGroupFlattenFunction g)) := by
  rw [repeated_big_prime_comparison_pairing_eq P V A B hA hB hAB]
  apply finite_asymmetric_comparison_pairing_tail_projection
    (fun i : RepeatedBigFlatIndex G J ell => physicalLabelLaw V i.1)
    (fun i => physical_label_law_sum V i.1 (hV i.1) (hmass i.1))
    (repeatedBigFlatActive J ell) A B hA hB
  intro i _ p
  unfold physicalLabelLaw
  apply div_ne_zero one_ne_zero
  exact mul_ne_zero (hV i.1).ne' (by exact_mod_cast (hP i.1 p.val p.property).ne')

theorem repeated_big_active_mass_product
    {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) :
    repeatedBigActiveMass (J := J) (ell := ell) V (fun _ _ => 1) =
      finiteProductWeight (fun g => finiteProductWeight
        (fun _ : PhysicalSlots J ell => physicalLabelLaw (P := P) V g)) := by
  funext source
  simp only [repeatedBigActiveMass, finiteProductWeight, tiltedPhysicalBirthLaw, div_one]

end Bounty
end

section

/- The coherent ledger at each occurrence is the initial ledger plus prior births. -/

open Finset
open scoped Classical
namespace Bounty
section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
  [∀ g, DecidableEq (P g)] (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ)

noncomputable def fullMixedLedgerPriorGroupBirths (steps : List (Option (J ⊕ K)))
    (x : FullMixedLedgerState n (M := M) B)
    (p : FullMixedLedgerPath n S B A Δ D steps x) (cut : ℕ) (g : Fin N) :
    Finset ((h : Fin N) × P h) :=
  univ.biUnion fun j : Fin steps.length => if j.val < cut then
    univ.biUnion fun b : Fin (fullMixedBirthCapacity S B (steps.get j) g) =>
      (fullMixedLedgerPathBirthLabel n S B A Δ D steps x p ⟨j, g, b⟩).toFinset
  else ∅

theorem full_mixed_prior_group_births_eq (steps : List (Option (J ⊕ K)))
    (x : FullMixedLedgerState n (M := M) B)
    (p : FullMixedLedgerPath n S B A Δ D steps x) (cut : ℕ) (g : Fin N) :
    fullMixedLedgerPriorGroupBirths n S B A Δ D steps x p cut g =
      finiteEventPathPriorBirths
        (fun tag (s : FullMixedLedgerState n (M := M) B) =>
          FullPermutationMixedEvent n S B A Δ D tag s.2)
        (fullMixedLedgerTarget n S B A Δ D)
        (fun tag s e => fullMixedEventGroupBirthImage n S B A Δ D tag s.2 e g)
        steps x p cut := by
  ext z
  simp only [fullMixedLedgerPriorGroupBirths, finiteEventPathPriorBirths,
    fullMixedEventGroupBirthImage, mem_biUnion, mem_univ, true_and]
  apply exists_congr
  intro j
  split_ifs
  · simp only [mem_biUnion, mem_univ, true_and, Option.mem_toFinset]
    rfl
  · rfl

theorem mem_full_mixed_prior_group_births (steps : List (Option (J ⊕ K)))
    (x : FullMixedLedgerState n (M := M) B)
    (p : FullMixedLedgerPath n S B A Δ D steps x) (cut : ℕ) (g : Fin N)
    (z : (h : Fin N) × P h) :
    z ∈ fullMixedLedgerPriorGroupBirths n S B A Δ D steps x p cut g ↔
      ∃ j : Fin steps.length, j.val < cut ∧
        ∃ b : Fin (fullMixedBirthCapacity S B (steps.get j) g),
          fullMixedLedgerPathBirthLabel n S B A Δ D steps x p ⟨j, g, b⟩ = some z := by
  simp only [fullMixedLedgerPriorGroupBirths, mem_biUnion, mem_univ, true_and]
  apply exists_congr
  intro j
  split_ifs <;> simp_all only [mem_biUnion, mem_univ, true_and, Option.mem_toFinset,
    Option.mem_def, Finset.notMem_empty, false_and, true_and, iff_self]

variable (ω : ∀ k c, A k c → ℝ) (μ : (g : Fin N) → P g → ℝ)
  (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

theorem full_mixed_ledger_group_union_before (steps : List (Option (J ⊕ K)))
    (x : FullMixedLedgerState n (M := M) B)
    (p : FullMixedLedgerPath n S B A Δ D steps x)
    (hx : FullMixedLedgerCovers n B x)
    (hw : ∀ j : Fin steps.length,
      let e := finiteEventPathOccurrence
        (fun tag (s : FullMixedLedgerState n (M := M) B) =>
          FullPermutationMixedEvent n S B A Δ D tag s.2)
        (fullMixedLedgerTarget n S B A Δ D) steps x p j
      fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V (steps.get j) e.1.2 e.2 ≠ 0)
    (i : Fin steps.length) (g : Fin N) :
    fullMixedLedgerGroupImage n B
      (finiteEventPathOccurrence
        (fun tag (s : FullMixedLedgerState n (M := M) B) =>
          FullPermutationMixedEvent n S B A Δ D tag s.2)
        (fullMixedLedgerTarget n S B A Δ D) steps x p i).1 g =
      fullMixedLedgerGroupImage n B x g ∪
        fullMixedLedgerPriorGroupBirths n S B A Δ D steps x p i.val g := by
  rw [full_mixed_prior_group_births_eq]
  apply finite_event_path_ledger_union_before _ _ (fun s => fullMixedLedgerGroupImage n B s g)
  intro j
  apply full_mixed_ledger_group_image_update n S B A Δ D ω μ q ρ V
  · exact finite_event_path_occurrence_invariant _ _ (FullMixedLedgerCovers n B)
      (full_mixed_ledger_target_covers n S B A Δ D) steps x p hx j
  · exact hw j

end Full
end Bounty
end

section

/- Literal clean event actions and their exact identification with the
full-memory kernel action, including both adjacent active-slot averages. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def cleanFullMemoryEventAction {S G : Type*}
    [Fintype S] [Fintype G] [dG : DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    [∀ g (p : P g), NeZero p.val]
    (V : G → ℝ) (b : ∀ g, P g → ℝ) (C : G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ)
    (D : SharedActiveLabels (fun g => ↥(P g)) (cleanFullSharedSlots (ell := ell) C) →
      PhysicalAuxLabels P C → G → ℤ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : CleanFullMemoryState P J ell B → PhysicalResidues Ps → ℂ)
    (x : CleanFullMemoryState P J ell B) (rs : PhysicalResidues Ps) : ℂ :=
  let source := (cleanFullMemoryEquiv P J ell B x).2.2.1
  let c := (productActiveMemorySplit (cleanFullSharedSlots C) B x).1
  let s := (productActiveMemorySplit (cleanFullSharedSlots C) B x).2
  let δ := fun c aux (_ : G) => -cleanFullSharedStep k C c aux d
  let Ψ := fun c aux (fresh : ∀ g, Fin (cleanFullSharedSlots (ell := ell) C g)ᶜ.card → P g) =>
    if repeatedBigAuxAvoids C aux source ∧
        repeatedBigAuxAvoids C aux (repeatedBigFill C source (cleanFullFreshEquiv P C fresh)) then
      K source (repeatedBigFill C source (cleanFullFreshEquiv P C fresh)) aux *
        physicalPhase ζ (cleanFullSharedD C c aux) *
        physicalReturnPhase θ (cleanFullSharedStep k C c aux d) *
        physicalPhase ζ (physicalSharedProduct d) else 0
  ∑ e : FullActiveEdgeEvent (fun g (q : P g) => q.val) (cleanFullSharedSlots C) B
      (fun _ => PhysicalAuxLabels P C) δ D x,
    (fullActiveEdgeEventWeight (fun g (q : P g) => q.val) (cleanFullSharedSlots C) B
      (fun _ => PhysicalAuxLabels P C) δ D (fun _ aux => physicalAuxMass V C aux)
      (fun g => tiltedPhysicalBirthLaw V g (b g)) ρ V x e : ℂ) *
    (if ∀ g, (e.2 g).1 = ∅ ∧ (e.2 g).2.1 = ∅ then
      Ψ c e.1 (fun g => (unrestrictedJointEventTarget (fun g (q : P g) => q.val)
        (δ c e.1) (D c e.1) (fun g => (cleanFullSharedSlots C g)ᶜ.card) B s e.2 g).1)
      else 0) *
    f (fullActiveEdgeEventTarget (fun g (q : P g) => q.val) (cleanFullSharedSlots C) B
      (fun _ => PhysicalAuxLabels P C) δ D x e)
      (physicalTranslateResidues rs (cleanFullSharedStep k C c e.1 d))

theorem clean_full_memory_event_action_apply {S G : Type*}
    [Fintype S] [Fintype G] [dG : DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    [∀ g (p : P g), NeZero p.val]
    (V : G → ℝ) (b : ∀ g, P g → ℝ) (C : G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ)
    (D : SharedActiveLabels (fun g => ↥(P g)) (cleanFullSharedSlots (ell := ell) C) →
      PhysicalAuxLabels P C → G → ℤ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : CleanFullMemoryState P J ell B → PhysicalResidues Ps → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun x => f x r))
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
    (source : RepeatedBigLists P J ell) (rm : FixedOrderedResidues p) (rs : PhysicalResidues Ps) :
    cleanFullMemoryEventAction V b C ζ θ ρ k D K d f (cleanFullMemoryState N p source rm) rs =
      if (∑ g, (N g).val) ≤ B then
        ∑ aux : PhysicalAuxLabels P C, ∑ target : RepeatedBigLists P J ell,
          (cleanHybridBetweenKernel V b C ζ θ ρ k (fun _ => B) p rm K d aux source target *
            physicalPhase ζ (physicalSharedProduct d)) *
          f (cleanFullMemoryState N p target
            (fixedOrderedResidueTranslate p rm (cleanHybridStep k C source aux d)))
            (physicalTranslateResidues rs (cleanHybridStep k C source aux d))
      else 0 := by
  have hc : cleanFullMemoryEquiv P J ell B (cleanFullMemoryState N p source rm) =
      ⟨N, p, source, rm⟩ :=
    (cleanFullMemoryEquiv P J ell B).apply_symm_apply ⟨N, p, source, rm⟩
  unfold cleanFullMemoryEventAction
  rw [hc]
  exact clean_full_memory_event_kernel_row V b C ζ θ ρ k N p rm rs d D K source f hf

noncomputable def cleanFullMemoryPatternEventAction {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G] [dG : DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    [∀ g (p : P g), NeZero p.val]
    (V : G → ℝ) (b : ∀ g, P g → ℝ) (C : I → G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ)
    (D : ∀ i, SharedActiveLabels (fun g => ↥(P g)) (cleanFullSharedSlots (ell := ell) (C i)) →
      PhysicalAuxLabels P (C i) → G → ℤ)
    (K : ∀ i, RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : CleanFullMemoryState P J ell B → PhysicalResidues Ps → ℂ)
    (x : CleanFullMemoryState P J ell B) (rs : PhysicalResidues Ps) : ℂ :=
  ∑ i, cleanFullMemoryEventAction V b (C i) ζ θ ρ k (D i) (K i) d f x rs

theorem clean_full_memory_pattern_event_action {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G] [dG : DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    [∀ g (p : P g), NeZero p.val]
    (V : G → ℝ) (b : ∀ g, P g → ℝ) (C : I → G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ)
    (D : ∀ i, SharedActiveLabels (fun g => ↥(P g)) (cleanFullSharedSlots (ell := ell) (C i)) →
      PhysicalAuxLabels P (C i) → G → ℤ)
    (K : ∀ i, RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : CleanFullMemoryState P J ell B → PhysicalResidues Ps → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun x => f x r)) :
    cleanFullMemoryPatternEventAction V b C ζ θ ρ k D K d f =
      cleanFullMemoryCutoff (cleanFullMemoryPatternDampedAction V b C ζ θ ρ k K d f) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  apply clean_full_memory_slice_ext
  intro N p
  funext source r
  change (∑ i, cleanFullMemoryEventAction V b (C i) ζ θ ρ k (D i) (K i) d f
      (cleanFullMemoryState N p source r.2) r.1) = _
  change _ = if productTotalMemory (cleanFullMemoryState N p source r.2) ≤ B then
    cleanFullMemoryPatternDampedAction V b C ζ θ ρ k K d f
      (cleanFullMemoryState N p source r.2) r.1 else 0
  rw [cleanFullMemoryState_total_memory, clean_full_memory_pattern_damped_apply]
  by_cases h : (∑ g, (N g).val) ≤ B
  · rw [if_pos h]
    apply sum_congr rfl
    intro i _
    have hi := clean_full_memory_event_action_apply V b (C i) ζ θ ρ k (D i) (K i)
      d f hf N p source r.2 r.1
    simp only [if_pos h] at hi
    convert hi using 1
    · congr 1
    · apply sum_congr
      · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
      · intro aux _
        apply sum_congr
        · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
        · intro target _
          rfl
  · rw [if_neg h]
    apply sum_eq_zero
    intro i _
    have hi := clean_full_memory_event_action_apply V b (C i) ζ θ ρ k (D i) (K i)
      d f hf N p source r.2 r.1
    simp only [if_neg h] at hi
    convert hi using 1
    congr 1

/-- Both adjacent averages and both total-memory cutoffs agree with the
kernel operator occurring in the existing full-memory norm bound. -/
theorem clean_full_memory_projected_event_action {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G] [dG : DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    [∀ g (p : P g), NeZero p.val]
    (V : G → ℝ) (b : ∀ g, P g → ℝ) (C : I → G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ)
    (D : ∀ i, SharedActiveLabels (fun g => ↥(P g)) (cleanFullSharedSlots (ell := ell) (C i)) →
      PhysicalAuxLabels P (C i) → G → ℤ)
    (K : ∀ i, RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : CleanFullMemoryState P J ell B → PhysicalResidues Ps → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun x => f x r)) :
    cleanFullMemoryActiveMap (cleanFullMemoryPatternEventAction V b C ζ θ ρ k D K d
      (cleanFullMemoryActiveMap f)) =
      cleanFullMemoryCutoff (cleanFullMemoryActiveMap (cleanFullMemoryPatternDampedAction
        V b C ζ θ ρ k K d (cleanFullMemoryActiveMap (cleanFullMemoryCutoff f)))) := by
  have hsym : ∀ r, ProductMemorySymmetric (fun x => cleanFullMemoryActiveMap f x r) :=
    fun r => fullActiveAverage_symmetric (fun x => f x r) (hf r)
  rw [clean_full_memory_pattern_event_action V b C ζ θ ρ k D K d _ hsym,
    ← clean_full_memory_cutoff_active_map,
    clean_full_memory_double_cutoff_projected_damped_action]

/-- The literal clean action already enforces the input total-memory cap. -/
theorem clean_full_memory_projected_event_input_cutoff {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G] [dG : DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    [∀ g (p : P g), NeZero p.val]
    (V : G → ℝ) (b : ∀ g, P g → ℝ) (C : I → G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ)
    (D : ∀ i, SharedActiveLabels (fun g => ↥(P g)) (cleanFullSharedSlots (ell := ell) (C i)) →
      PhysicalAuxLabels P (C i) → G → ℤ)
    (K : ∀ i, RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : CleanFullMemoryState P J ell B → PhysicalResidues Ps → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun x => f x r)) :
    cleanFullMemoryActiveMap (cleanFullMemoryPatternEventAction V b C ζ θ ρ k D K d
      (cleanFullMemoryActiveMap (cleanFullMemoryCutoff f))) =
      cleanFullMemoryActiveMap (cleanFullMemoryPatternEventAction V b C ζ θ ρ k D K d
        (cleanFullMemoryActiveMap f)) := by
  have hsym : ∀ r, ProductMemorySymmetric (fun x => cleanFullMemoryCutoff f x r) :=
    fun r => productMemoryCutoff_symmetric (fun x => f x r) (hf r)
  rw [clean_full_memory_projected_event_action V b C ζ θ ρ k D K d _ hsym,
    clean_full_memory_projected_event_action V b C ζ θ ρ k D K d f hf,
    clean_full_memory_cutoff_idempotent]

end Bounty
end

section

/- Pinned current births retain the entire original path continuation, including history-dependent tests. -/

open Finset Classical

namespace Bounty

section Paths
variable {J K G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] {M : G → ℕ}
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
    (Δ D : ∀ k c, A k c → G → ℤ) (ω : ∀ k c, A k c → ℝ)
    (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)
    (steps : List (Option (J ⊕ K)))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)

noncomputable def fullMixedGhostPathPinnedKernel (j : J)
    (F : FullPermutationMixedPath n S B A Δ D (some (.inl j) :: steps) x → ℝ)
    (sk : CoupledGhostSkeleton M B x) (i : CoupledGhostSampleIndex M B x sk) (p : P i.1) : ℝ :=
  coupledGhostSkeletonAbsMass (fun g => physicalGhostRetention (n g) (q j) ρ)
    (fun g => physicalGhostTermination (n g) (q j) ρ) M B x sk *
  ∑ rest : (a : {a : CoupledGhostSampleIndex M B x sk // a ≠ i}) →
      UnrestrictedResidueParticle (n a.1.1),
    (∏ a, physicalGhostBirthAtom (n a.1.1) (μ a.1.1) (q j) ρ (V a.1.1) (rest a)) *
      fullMixedPathAbsContinuation n S B A Δ D ω μ q ρ V (some (.inl j)) steps x F
        ((fullPermutationGhostBirthEquiv n S B A Δ D x j).symm
          ⟨sk, birthCoordinateInsert (fun a => UnrestrictedResidueParticle (n a.1)) i
            (unrestrictedResidueSeed (n i.1) p) rest⟩)

noncomputable def fullMixedEdgePathPinnedKernel (k : K)
    (F : FullPermutationMixedPath n S B A Δ D (some (.inr k) :: steps) x → ℝ)
    (sk : FullActiveEdgeSkeleton n (S k) B (A k) (Δ k) (D k) x)
    (i : FullActiveEdgeSampleIndex n (S k) B (A k) (Δ k) (D k) x sk) (p : P i.1) : ℝ :=
  fullActiveEdgeSkeletonAbsMass n (S k) B (A k) (Δ k) (D k) (ω k) ρ V x sk *
  ∑ rest : (a : {a : FullActiveEdgeSampleIndex n (S k) B (A k) (Δ k) (D k) x sk // a ≠ i}) → P a.1.1,
    (∏ a, μ a.1.1 (rest a)) *
      fullMixedPathAbsContinuation n S B A Δ D ω μ q ρ V (some (.inr k)) steps x F
        ((fullPermutationEdgeBirthEquiv n S B A Δ D x k).symm
          ⟨sk, birthCoordinateInsert (fun a => P a.1) i p rest⟩)

theorem full_mixed_ghost_path_pinned_nonneg (hμ : ∀ g p, 0 ≤ μ g p) (j : J)
    (F : FullPermutationMixedPath n S B A Δ D (some (.inl j) :: steps) x → ℝ)
    (hF : ∀ path, 0 ≤ F path)
    (sk : CoupledGhostSkeleton M B x) (i : CoupledGhostSampleIndex M B x sk) (p : P i.1) :
    0 ≤ fullMixedGhostPathPinnedKernel n S B A Δ D ω μ q ρ V steps x j F sk i p := by
  apply mul_nonneg (coupled_ghost_skeleton_abs_mass_nonneg _ _ _ _ _ _)
  apply sum_nonneg
  intro rest _
  exact mul_nonneg (prod_nonneg fun a _ => physical_ghost_birth_atom_nonneg _ _ _ _ _ (hμ _) _)
    (full_mixed_path_abs_continuation_nonneg n S B A Δ D ω μ q ρ V _ steps x F hF _)

theorem full_mixed_edge_path_pinned_nonneg (hμ : ∀ g p, 0 ≤ μ g p) (k : K)
    (F : FullPermutationMixedPath n S B A Δ D (some (.inr k) :: steps) x → ℝ)
    (hF : ∀ path, 0 ≤ F path)
    (sk : FullActiveEdgeSkeleton n (S k) B (A k) (Δ k) (D k) x)
    (i : FullActiveEdgeSampleIndex n (S k) B (A k) (Δ k) (D k) x sk) (p : P i.1) :
    0 ≤ fullMixedEdgePathPinnedKernel n S B A Δ D ω μ q ρ V steps x k F sk i p := by
  apply mul_nonneg (full_active_edge_skeleton_abs_mass_nonneg _ _ _ _ _ _ _ _ _ _ _)
  apply sum_nonneg
  intro rest _
  exact mul_nonneg (prod_nonneg fun a _ => hμ a.1.1 _)
    (full_mixed_path_abs_continuation_nonneg n S B A Δ D ω μ q ρ V _ steps x F hF _)

theorem full_mixed_ghost_path_pinned_eq (hμ : ∀ g p, 0 ≤ μ g p) (j : J)
    (F : FullPermutationMixedPath n S B A Δ D (some (.inl j) :: steps) x → ℝ)
    (sk : CoupledGhostSkeleton M B x) (i : CoupledGhostSampleIndex M B x sk) (p : P i.1)
    [DecidableEq (P i.1)] :
    (∑ births : CoupledGhostSamples M B x sk, if (births i).1 = p then
      |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V (some (.inl j)) x
        ((fullPermutationGhostBirthEquiv n S B A Δ D x j).symm ⟨sk, births⟩)| *
      fullMixedPathAbsContinuation n S B A Δ D ω μ q ρ V (some (.inl j)) steps x F
        ((fullPermutationGhostBirthEquiv n S B A Δ D x j).symm ⟨sk, births⟩) else 0) =
      (|(1 - q j) * V i.1 / ρ| * μ i.1 p) *
        fullMixedGhostPathPinnedKernel n S B A Δ D ω μ q ρ V steps x j F sk i p := by
  unfold fullMixedGhostPathPinnedKernel
  simp_rw [full_permutation_ghost_skeleton_weight,
    coupled_ghost_skeleton_weight_factor
      (fun g => physicalGhostRetention (n g) (q j) ρ)
      (fun g => physicalGhostTermination (n g) (q j) ρ)
      (fun g => physicalGhostBirth (n g) (q j) ρ (V g))
      (fun g => unrestrictedResidueWeight (μ g)) (fun g z => hμ g z.1)]
  change (∑ births : CoupledGhostSamples M B x sk, if (births i).1 = p then
    (_ * ∏ a, physicalGhostBirthAtom (n a.1) (μ a.1) (q j) ρ (V a.1) (births a)) *
      fullMixedPathAbsContinuation n S B A Δ D ω μ q ρ V _ steps x F
        ((fullPermutationGhostBirthEquiv n S B A Δ D x j).symm ⟨sk, births⟩) else 0) = _
  rw [selected_coordinate_kernel_sum]
  exact physical_ghost_birth_atom_weighted_sum (n i.1) (μ i.1) (q j) ρ (V i.1) p _

theorem full_mixed_edge_path_pinned_eq (hμ : ∀ g p, 0 ≤ μ g p) (k : K)
    (F : FullPermutationMixedPath n S B A Δ D (some (.inr k) :: steps) x → ℝ)
    (sk : FullActiveEdgeSkeleton n (S k) B (A k) (Δ k) (D k) x)
    (i : FullActiveEdgeSampleIndex n (S k) B (A k) (Δ k) (D k) x sk) (p : P i.1)
    [DecidableEq (P i.1)] :
    (∑ fresh : FullActiveEdgeSamples n (S k) B (A k) (Δ k) (D k) x sk, if fresh i = p then
      |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V (some (.inr k)) x
        ((fullPermutationEdgeBirthEquiv n S B A Δ D x k).symm ⟨sk, fresh⟩)| *
      fullMixedPathAbsContinuation n S B A Δ D ω μ q ρ V (some (.inr k)) steps x F
        ((fullPermutationEdgeBirthEquiv n S B A Δ D x k).symm ⟨sk, fresh⟩) else 0) =
      μ i.1 p * fullMixedEdgePathPinnedKernel n S B A Δ D ω μ q ρ V steps x k F sk i p := by
  unfold fullMixedEdgePathPinnedKernel
  simp_rw [full_permutation_edge_skeleton_weight,
    full_active_edge_skeleton_weight_factor n (S k) B (A k) (Δ k) (D k) (ω k) ρ V x sk μ hμ]
  exact selected_coordinate_value_kernel_sum (fun a => P a.1) i (fun a => μ a.1) p _ _

theorem full_mixed_ghost_path_pinned_le (hμ : ∀ g p, 0 ≤ μ g p) (j : J)
    (F : FullPermutationMixedPath n S B A Δ D (some (.inl j) :: steps) x → ℝ)
    (hF : ∀ path, 0 ≤ F path)
    (sk : CoupledGhostSkeleton M B x) (i : CoupledGhostSampleIndex M B x sk) (p : P i.1)
    [DecidableEq (P i.1)] {ε : ℝ} (hatom : |(1 - q j) * V i.1 / ρ| * μ i.1 p ≤ ε) :
    (∑ births : CoupledGhostSamples M B x sk, if (births i).1 = p then
      |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V (some (.inl j)) x
        ((fullPermutationGhostBirthEquiv n S B A Δ D x j).symm ⟨sk, births⟩)| *
      fullMixedPathAbsContinuation n S B A Δ D ω μ q ρ V (some (.inl j)) steps x F
        ((fullPermutationGhostBirthEquiv n S B A Δ D x j).symm ⟨sk, births⟩) else 0) ≤
      ε * fullMixedGhostPathPinnedKernel n S B A Δ D ω μ q ρ V steps x j F sk i p := by
  rw [full_mixed_ghost_path_pinned_eq n S B A Δ D ω μ q ρ V steps x hμ]
  exact mul_le_mul_of_nonneg_right hatom
    (full_mixed_ghost_path_pinned_nonneg n S B A Δ D ω μ q ρ V steps x hμ j F hF sk i p)

theorem full_mixed_edge_path_pinned_le (hμ : ∀ g p, 0 ≤ μ g p) (k : K)
    (F : FullPermutationMixedPath n S B A Δ D (some (.inr k) :: steps) x → ℝ)
    (hF : ∀ path, 0 ≤ F path)
    (sk : FullActiveEdgeSkeleton n (S k) B (A k) (Δ k) (D k) x)
    (i : FullActiveEdgeSampleIndex n (S k) B (A k) (Δ k) (D k) x sk) (p : P i.1)
    [DecidableEq (P i.1)] {ε : ℝ} (hatom : μ i.1 p ≤ ε) :
    (∑ fresh : FullActiveEdgeSamples n (S k) B (A k) (Δ k) (D k) x sk, if fresh i = p then
      |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V (some (.inr k)) x
        ((fullPermutationEdgeBirthEquiv n S B A Δ D x k).symm ⟨sk, fresh⟩)| *
      fullMixedPathAbsContinuation n S B A Δ D ω μ q ρ V (some (.inr k)) steps x F
        ((fullPermutationEdgeBirthEquiv n S B A Δ D x k).symm ⟨sk, fresh⟩) else 0) ≤
      ε * fullMixedEdgePathPinnedKernel n S B A Δ D ω μ q ρ V steps x k F sk i p := by
  rw [full_mixed_edge_path_pinned_eq n S B A Δ D ω μ q ρ V steps x hμ]
  exact mul_le_mul_of_nonneg_right hatom
    (full_mixed_edge_path_pinned_nonneg n S B A Δ D ω μ q ρ V steps x hμ k F hF sk i p)

end Paths

end Bounty
end

section

/- Exact unnormalized root masses and the product bound that requires an explicit uniform row estimate. -/

open Finset Classical

namespace Bounty

section Mass
variable {J K G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] {M : G → ℕ}
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
    (Δ D : ∀ k c, A k c → G → ℤ) (ω : ∀ k c, A k c → ℝ)
    (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)

noncomputable def fullMixedPathRootMass (tag : Option (J ⊕ K))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) : ℝ :=
  fullMixedPathAbsIntegral n S B A Δ D ω μ q ρ V [tag] x (fun _ => 1)

theorem full_mixed_path_root_mass_nonneg (tag : Option (J ⊕ K))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    0 ≤ fullMixedPathRootMass n S B A Δ D ω μ q ρ V tag x :=
  full_mixed_path_abs_integral_nonneg n S B A Δ D ω μ q ρ V [tag] x _ (fun _ => zero_le_one)

theorem full_mixed_path_root_mass_eq_sum (tag : Option (J ⊕ K))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    fullMixedPathRootMass n S B A Δ D ω μ q ρ V tag x =
      let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
        fullPermutationMixedEventFintype n S B A Δ D
      ∑ e : FullPermutationMixedEvent n S B A Δ D tag x,
        |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V tag x e| := by
  unfold fullMixedPathRootMass
  rw [full_mixed_path_abs_integral_cons]
  simp only [fullMixedPathAbsContinuation, full_mixed_path_abs_integral_nil, mul_one]

theorem full_mixed_path_root_mass_ghost (hμ : ∀ g p, 0 ≤ μ g p) (j : J)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    fullMixedPathRootMass n S B A Δ D ω μ q ρ V (some (.inl j)) x =
      ∑ sk : CoupledGhostSkeleton M B x,
        coupledGhostSkeletonAbsMass (fun g => physicalGhostRetention (n g) (q j) ρ)
          (fun g => physicalGhostTermination (n g) (q j) ρ) M B x sk *
          ∏ i : CoupledGhostSampleIndex M B x sk, (|(1 - q j) * V i.1 / ρ| * ∑ p, μ i.1 p) := by
  unfold fullMixedPathRootMass
  rw [full_mixed_path_abs_ghost_skeleton n S B A Δ D ω μ q ρ V hμ]
  simp only [fullMixedPathAbsContinuation, full_mixed_path_abs_integral_nil, mul_one]
  apply sum_congr rfl
  intro sk _
  rw [← mul_sum, ← Fintype.prod_sum]
  congr 1
  apply prod_congr rfl
  intro i _
  exact physical_ghost_birth_atom_total _ _ _ _ _

theorem full_mixed_path_root_mass_edge (hμ : ∀ g p, 0 ≤ μ g p) (k : K)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    fullMixedPathRootMass n S B A Δ D ω μ q ρ V (some (.inr k)) x =
      ∑ sk : FullActiveEdgeSkeleton n (S k) B (A k) (Δ k) (D k) x,
        fullActiveEdgeSkeletonAbsMass n (S k) B (A k) (Δ k) (D k) (ω k) ρ V x sk *
          ∏ i : FullActiveEdgeSampleIndex n (S k) B (A k) (Δ k) (D k) x sk, ∑ p, μ i.1 p := by
  unfold fullMixedPathRootMass
  rw [full_mixed_path_abs_edge_skeleton n S B A Δ D ω μ q ρ V hμ]
  simp only [fullMixedPathAbsContinuation, full_mixed_path_abs_integral_nil, mul_one]
  apply sum_congr rfl
  intro sk _
  rw [← mul_sum, ← Fintype.prod_sum]

theorem full_mixed_path_root_mass_permutation
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    fullMixedPathRootMass n S B A Δ D ω μ q ρ V none x = 1 := by
  rw [full_mixed_path_root_mass_eq_sum]
  change (∑ e : ULift (FullActiveSlotPermutations M), |fullActivePermutationWeight M e.down|) = 1
  simp_rw [abs_of_nonneg (fullActivePermutationWeight_nonneg M _)]
  exact (Equiv.ulift.sum_comp (fullActivePermutationWeight M)).trans (fullActivePermutationWeight_mass M)

theorem full_mixed_path_abs_integral_le_root_masses
    (C : Option (J ⊕ K) → ℝ) (hC : ∀ tag, 0 ≤ C tag)
    (hroot : ∀ tag x, fullMixedPathRootMass n S B A Δ D ω μ q ρ V tag x ≤ C tag)
    (steps : List (Option (J ⊕ K)))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (F : FullPermutationMixedPath n S B A Δ D steps x → ℝ)
    {L : ℝ} (hL : 0 ≤ L) (hF : ∀ path, F path ≤ L) :
    fullMixedPathAbsIntegral n S B A Δ D ω μ q ρ V steps x F ≤ (steps.map C).prod * L := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
    fullPermutationMixedEventFintype n S B A Δ D
  apply finite_event_path_integral_le_row_product _ _ _ (fun _ _ _ => abs_nonneg _) C hC
    (fun tag x => ?_) steps x F hL hF
  rw [← full_mixed_path_root_mass_eq_sum]
  exact hroot tag x

theorem full_mixed_path_abs_terminal_cast
    (hω : ∀ k c a, 0 ≤ ω k c a) (hμ : ∀ g p, 0 ≤ μ g p)
    (hq : ∀ j, 0 ≤ q j) (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ V g)
    (steps : List (Option (J ⊕ K)))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℝ) :
    (fullMixedPathAbsIntegral n S B A Δ D ω μ q ρ V steps x
      (fun p => f (finiteEventPathTerminal (FullPermutationMixedEvent n S B A Δ D)
        (fullPermutationMixedEventTarget n S B A Δ D) steps x p)) : ℂ) =
      finiteOperatorListAction (fullPermutationMixedPositiveOperator n S B A Δ D ω μ q ρ V)
        steps (fun y => (f y : ℂ)) x := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
    fullPermutationMixedEventFintype n S B A Δ D
  unfold fullMixedPathAbsIntegral
  rw [finite_event_path_integral_terminal_cast, finite_event_path_positive_eq_list,
    full_permutation_mixed_absolute_actions_eq n S B A Δ D ω μ q ρ V hω hμ hq hρ hV]

end Mass

end Bounty
end

section

/- Concrete uniform Lyapunov rows and their iteration for the original full mixed trajectories. -/

open Finset Classical

namespace Bounty

noncomputable def fullMixedLengthRowFactor {J K G : Type*} [Fintype G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ v vmin : ℝ) (V : G → ℝ) (T : ℕ) :
    Option (J ⊕ K) → ℝ
  | none => 1
  | some (.inl j) => ∏ g, Real.exp ((|(1 - q j) * V g / ρ| * ∑ p, μ g p) * v)
  | some (.inr _) => unrestrictedEdgeRowBound ρ v vmin T ^ Fintype.card G

theorem fullMixedLengthRowFactor_nonneg {J K G : Type*} [Fintype G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ v vmin : ℝ) (V : G → ℝ) (T : ℕ)
    (hρ : ρ < 1) (hv : 0 ≤ v) (tag : Option (J ⊕ K)) :
    0 ≤ fullMixedLengthRowFactor μ q ρ v vmin V T tag := by
  cases tag with
  | none => exact zero_le_one
  | some tag =>
    cases tag with
    | inl j => exact prod_nonneg fun _ _ => (Real.exp_pos _).le
    | inr k => exact pow_nonneg (unrestricted_edge_row_bound_nonneg hρ hv T) _

section Mixed
variable {J K G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] {M : G → ℕ}
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
    (Δ D : ∀ k c, A k c → G → ℤ) (ω : ∀ k c, A k c → ℝ)
    (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ v vmin : ℝ) (V : G → ℝ)

theorem full_permutation_mixed_length_row_le
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : ∀ g, vmin ≤ V g)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (tag : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
    (∑ e : FullPermutationMixedEvent n S B A Δ D tag s,
      |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V tag s e| *
        productLengthLyapunov v (fullPermutationMixedEventTarget n S B A Δ D tag s e)) ≤
      fullMixedLengthRowFactor μ q ρ v vmin V T tag * productLengthLyapunov v s := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
    fullPermutationMixedEventFintype n S B A Δ D
  cases tag with
  | none =>
    have hm : (∑ e : FullPermutationMixedEvent (J := J) n S B A Δ D none s,
        fullActivePermutationWeight M e.down) = 1 :=
      ((Equiv.ulift : FullPermutationMixedEvent (J := J) n S B A Δ D none s ≃
        FullActiveSlotPermutations M).sum_comp (fullActivePermutationWeight M)).trans
          (fullActivePermutationWeight_mass M)
    change (∑ e : FullPermutationMixedEvent (J := J) n S B A Δ D none s,
      |fullActivePermutationWeight M e.down| * productLengthLyapunov v s) ≤ 1 * productLengthLyapunov v s
    simp_rw [abs_of_nonneg (fullActivePermutationWeight_nonneg M _)]
    rw [← sum_mul, hm]
  | some tag =>
    cases tag with
    | inl j =>
      have he := (Equiv.ulift : FullPermutationMixedEvent n S B A Δ D (some (.inl j)) s ≃
        CoupledGhostEvent M B s).sum_comp (fun e =>
          |coupledGhostJointEventWeight (fun g => physicalGhostRetention (n g) (q j) ρ)
            (fun g => physicalGhostTermination (n g) (q j) ρ)
            (fun g => physicalGhostBirth (n g) (q j) ρ (V g))
            (fun g => unrestrictedResidueWeight (μ g)) M B s e| *
            productLengthLyapunov v (coupledGhostJointEventTarget M B s e))
      apply le_trans ?_ (coupled_physical_ghost_length_row_le n μ (q j) ρ v V hμ (hq0 j) (hq1 j)
        hρ0 (zero_lt_one.trans hv) (hD j) M B s)
      apply le_of_eq
      refine Eq.trans ?_ he
      apply sum_congr
      · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
      · intro e _
        rfl
    | inr k =>
      exact (full_active_edge_length_row_le n (S k) B (A k) (Δ k) (D k) (ω k) μ V
        (hω k) (hωmass k) hρ0 hρ1 hv hvmin hV hμ hmass T (ht k) s).trans_eq (mul_comm _ _)

theorem full_mixed_path_abs_integral_le_length
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : ∀ g, vmin ≤ V g)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (steps : List (Option (J ⊕ K)))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (F : FullPermutationMixedPath n S B A Δ D steps s → ℝ)
    {L : ℝ} (hL : 0 ≤ L)
    (hF : ∀ p, F p ≤ L * productLengthLyapunov v
      (finiteEventPathTerminal (FullPermutationMixedEvent n S B A Δ D)
        (fullPermutationMixedEventTarget n S B A Δ D) steps s p)) :
    fullMixedPathAbsIntegral n S B A Δ D ω μ q ρ V steps s F ≤
      (steps.map (fullMixedLengthRowFactor μ q ρ v vmin V T)).prod * (L * productLengthLyapunov v s) := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
    fullPermutationMixedEventFintype n S B A Δ D
  apply finite_event_path_integral_le_lyapunov _ _ _ (fun _ _ _ => abs_nonneg _)
    (productLengthLyapunov v) (fullMixedLengthRowFactor μ q ρ v vmin V T)
    (fullMixedLengthRowFactor_nonneg μ q ρ v vmin V T hρ1 (zero_lt_one.trans hv).le)
    (fun tag s => ?_) steps s F hL hF
  exact full_permutation_mixed_length_row_le n S B A Δ D ω μ q ρ v vmin V
    hω hωmass hμ hmass hq0 hq1 hρ0 hρ1 hv hvmin hV hD T ht tag s

end Mixed

end Bounty
end

section

/- Actual count-matched prime proxies are bounded by a uniform reciprocal density. -/

open Finset Filter

namespace Bounty

noncomputable def primeCellProxyCoefficient (L S Y : ℝ) : ℝ :=
  ((primeBand Y (Real.exp (L^(-S))*Y)).card : ℝ) /
    (roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (Real.sqrt L))).card

theorem exists_prime_cell_proxy_bound {a : ℝ} (ha : 0 < a) :
    ∃ C : ℝ, 0 < C ∧ ∀ S : ℝ, ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ,
      Real.exp (a*L) ≤ Y →
      0 ≤ primeCellProxyCoefficient L S Y ∧ primeCellProxyCoefficient L S Y ≤ 1 ∧
      primeCellProxyCoefficient L S Y ≤
        C/(L*(∏ p ∈ primeBand 0 (Real.exp (Real.sqrt L)), (1-1/(p : ℝ)))) := by
  obtain ⟨C, hC, hprime⟩ := exists_prime_logarithmic_cell_upper ha
  refine ⟨2*C, by positivity, ?_⟩
  intro S
  filter_upwards [hprime S, eventually_rough_logarithmic_cell_count_pos ha S,
    eventually_sqrt_le_dyadic_scale ha 0, eventually_gt_atTop (0 : ℝ)] with L hprimeL hrough hsqrt hL
  intro Y hY
  let V := ∏ p ∈ primeBand 0 (Real.exp (Real.sqrt L)), (1-1/(p : ℝ))
  let len := Real.exp (L^(-S))*Y-Y
  let P := primeBand Y (Real.exp (L^(-S))*Y)
  let R := roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (Real.sqrt L))
  have hV : 0 < V := finite_prime_avoidance_product_pos _ (fun _ hp => (mem_filter.mp hp).2)
  have hR : (0 : ℝ) < R.card := Nat.cast_pos.mpr (hrough Y hY).1
  have hRlower : len*V/2 ≤ (R.card : ℝ) := (hrough Y hY).2.1
  have hW : Real.exp (Real.sqrt L) ≤ Y := by
    apply le_trans _ hY
    apply Real.exp_le_exp.mpr
    simpa only [pow_zero, div_one] using hsqrt
  have hsub : P ⊆ R := prime_band_subset_rough_band hW
  have hunit := finite_cell_count_proxy R P hsub (hrough Y hY).1
  refine ⟨hunit.1, hunit.2.1, ?_⟩
  change (P.card : ℝ)/(R.card : ℝ) ≤ (2*C)/(L*V)
  apply (div_le_iff₀ hR).mpr
  calc
    _ ≤ C*len/L := hprimeL Y hY
    _ = ((2*C)/(L*V))*(len*V/2) := by field_simp
    _ ≤ _ := mul_le_mul_of_nonneg_left hRlower (by positivity)

end Bounty
end

section

/- A coefficient-preserving reindexing of every actual full mixed event. -/

open Finset Classical
namespace Bounty
section Mixed
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
    (n : (g : Fin N) → P g → ℕ) [∀ g p, NeZero (n g p)]
    {M : Fin N → ℕ} (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (tag : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (τ : ∀ g, Equiv.Perm (Fin (s g).2.1.val))

noncomputable def fullMixedMemoryReindex :
    FullPermutationMixedEvent n S B A Δ D tag s ≃
      FullPermutationMixedEvent n S B A Δ D tag (productMemoryReindex s τ) :=
  match tag with
  | none => Equiv.refl _
  | some (.inl _) => Equiv.ulift.trans ((jointGhostMemoryReindex M B s τ).trans Equiv.ulift.symm)
  | some (.inr k) => fullEdgeMemoryReindex n (S k) B (A k) (Δ k) (D k) s τ

theorem full_mixed_reindex_weight (ω : ∀ k c, A k c → ℝ)
    (μ : (g : Fin N) → P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (e : FullPermutationMixedEvent n S B A Δ D tag s) :
    fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V tag (productMemoryReindex s τ)
      (fullMixedMemoryReindex n S B A Δ D tag s τ e) =
      fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V tag s e := by
  cases tag with
  | none => rfl
  | some tag =>
    cases tag with
    | inl j => exact joint_ghost_reindex_weight M B s τ _ _ _ _ e.down
    | inr k => exact full_edge_reindex_weight n (S k) B (A k) (Δ k) (D k) s τ (ω k) μ ρ V e

theorem full_mixed_reindex_test (e : FullPermutationMixedEvent n S B A Δ D tag s)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    f (fullPermutationMixedEventTarget n S B A Δ D tag (productMemoryReindex s τ)
      (fullMixedMemoryReindex n S B A Δ D tag s τ e)) =
      f (fullPermutationMixedEventTarget n S B A Δ D tag s e) := by
  cases tag with
  | none => exact product_memory_reindex_test f hf (fullActivePermutation e.down s) τ
  | some tag =>
    cases tag with
    | inl j => exact joint_ghost_reindex_test M B s τ e.down f hf
    | inr k => exact full_edge_reindex_test n (S k) B (A k) (Δ k) (D k) s τ e f hf

omit [∀ g, Fintype (P g)] [∀ g p, NeZero (n g p)] in
theorem full_mixed_reindex_birth_labels
    (e : FullPermutationMixedEvent n S B A Δ D tag s) :
    fullMixedEventBirthLabel n S B A Δ D tag (productMemoryReindex s τ)
      (fullMixedMemoryReindex n S B A Δ D tag s τ e) =
      fullMixedEventBirthLabel n S B A Δ D tag s e := by
  cases tag with
  | none => funext a; exact Fin.elim0 a.2
  | some tag =>
    cases tag with
    | inl j =>
      apply full_mixed_ghost_birth_labels_congr
      intro g
      rfl
    | inr k =>
      apply full_mixed_edge_birth_labels_congr
      intro g
      rfl

end Mixed
end Bounty
end

section

/- The source decoding in the global physical phase does not inspect memory order. -/

open Finset Classical
namespace Bounty

theorem physical_full_global_phase_reindex
    {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    [∀ g, ∀ p : ↥(P g), NeZero p.val]
    (C : Fin N → Finset (Fin J)) (k : ℤ)
    (H : (g : Fin N) → Finset ↥(P g))
    (ω : ∀ _c : SharedActiveLabels (fun g => ↥(P g))
      (fun g => physicalFullSharedIndices (ell := ell) (C g)), PhysicalAuxLabels P C → ℝ)
    (μ : (g : Fin N) → ↥(P g) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (x : PhysicalFullBoundedState P J ell B)
    (τ : ∀ g, Equiv.Perm (Fin (x g).2.1.val)) (e : PhysicalFullEdgeEvent C k x) :
    physicalFullGlobalEdgePhase C k H ω μ ρ V (productMemoryReindex x τ)
      (fullEdgeMemoryReindex (fun g (p : ↥(P g)) => p.val)
        (fun g => physicalFullSharedIndices (C g)) B (fun _ => PhysicalAuxLabels P C)
        (physicalFullEdgeDelta C k) (physicalFullEdgeD C) x τ e) =
      physicalFullGlobalEdgePhase C k H ω μ ρ V x e := by
  by_cases hx : FullActiveInjective x
  · obtain ⟨⟨L, q⟩, he⟩ := (physicalFullStateEquiv C).surjective ⟨x, hx⟩
    have heq : physicalFullMemoryState C L q = x := congrArg Subtype.val he
    subst x
    have hl := physical_full_global_edge_phase_encode C k H ω μ ρ V L
      (fun g => ⟨(q g).1, (q g).2 ∘ τ g⟩)
      (fullEdgeMemoryReindex (fun g (p : ↥(P g)) => p.val)
        (fun g => physicalFullSharedIndices (C g)) B (fun _ => PhysicalAuxLabels P C)
        (physicalFullEdgeDelta C k) (physicalFullEdgeD C) (physicalFullMemoryState C L q) τ e)
    exact hl.trans ((physical_full_endpoint_phase_reindex C k L H q τ e ω μ ρ V).trans
      (physical_full_global_edge_phase_encode C k H ω μ ρ V L q e).symm)
  · have hx' : ¬ FullActiveInjective (productMemoryReindex x τ) := hx
    simp only [physicalFullGlobalEdgePhase, dif_neg hx, dif_neg hx']

end Bounty
end

section

/- Exact physical history normalization under adjacent common-mark compatibility.
No global residue assignment is supplied; all original local rows and cutoffs remain. -/

open Finset
namespace Bounty

section ResiduePath
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (hcompat : ∀ j : Fin n, ∀ g s t,
    ((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val =
      ((physicalPermuteLabels (τ j) (L j.succ)) g t).val →
    (((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val : ℤ) ∣
      k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ) (η : Fin N → Fin (n + 1) → ℝ)
  (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0) (B : ℕ)

theorem physical_joint_adjacent_visit_literal_tensor (j : Fin (n + 1))
    (activity : (g : Fin N) → ↥(P g) → Bool)
    (F : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ)
    (s : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val)) :
    globalBirthJointCutRawRow
      (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β η V
        (fun _ => ρ) hV B (2 * j.val)) B B F s =
    globalBirthJointCutRawRow
      (fun g => GlobalBirthRawStep.visit (a := activity g)
        (fun _ => 0) (β g) (η g j) (V g) ρ (hV g) B) B B F s := by
  have hr :
      (fun g (K : GlobalBirthHistoryState (fun p : ↥(P g) => ZMod p.val) → ℂ)
        (u : GlobalBirthHistoryState (fun p : ↥(P g) => ZMod p.val)) =>
        globalBirthRawStepRow
          (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β η V
            (fun _ => ρ) hV B (2 * j.val) g) (fun H q => K (H, q)) u.1 u.2) =
      (fun g (K : GlobalBirthHistoryState (fun p : ↥(P g) => ZMod p.val) → ℂ)
        (u : GlobalBirthHistoryState (fun p : ↥(P g) => ZMod p.val)) =>
        globalBirthRawStepRow
          (GlobalBirthRawStep.visit (a := activity g) (fun _ => 0) (β g) (η g j)
            (V g) ρ (hV g) B) (fun H q => K (H, q)) u.1 u.2) := by
    funext g K u
    exact physical_group_adjacent_finite_visit_row C aux k L a σ τ hcompat
      hlist hP hdis g (fun j => hk j g) (β g) (η g) (V g) ρ (hV g) B j
      (fun H q => K (H, q)) u.1 u.2
  unfold globalBirthJointCutRawRow globalBirthJointRawRow
  rw [hr]

end ResiduePath
end Bounty
end

