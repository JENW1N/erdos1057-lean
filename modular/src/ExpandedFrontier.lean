open Finset
noncomputable def physicalGroupRawVisit {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (L : PhysicalMarkLists P J ell) (g : G) (β : ↥(P g) → ℝ)
    (η V ρ : ℝ) (hV : V ≠ 0) (cap : ℕ) :
    GlobalBirthRawStep (R := fun p : ↥(P g) => ZMod p.val)
      (physicalGroupPhaseActivity L g) (physicalGroupPhaseActivity L g) :=
  .visit (fun _ => 0) β η V ρ hV cap

noncomputable def physicalGroupRawEdge {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) {x y : PhysicalState P J ell}
    (hadm : physicalAdmissible C aux k x y)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (g : G)
    (hk : ∀ s, ¬ ((x.2.val g s).val : ℤ) ∣ k)
    (β : ↥(P g) → ℝ) (ρ V : ℝ) (cap : ℕ) :
    GlobalBirthRawStep (R := fun p : ↥(P g) => ZMod p.val)
      (physicalGroupPhaseActivity x.2.val g) (physicalGroupPhaseActivity y.2.val g) :=
  .edge (physicalGroupPhaseDelta x.1 y.1 g)
    (physical_group_phase_shared_delta_zero x y g)
    (physicalGroupUnsharedEmbedding C x.2.val g)
    (physicalGroupUnsharedEmbedding C y.2.val g)
    (physical_group_phase_images_of_admissible C aux k hadm hP hdis g hk).1
    (physical_group_phase_images_of_admissible C aux k hadm hP hdis g hk).2 β ρ V cap

/-- Moving memory uses the negative of the actual physical integer step. -/
theorem physical_group_phase_delta_of_admissible {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) {x y : PhysicalState P J ell}
    (hadm : physicalAdmissible C aux k x y) (g : G) (p : ↥(P g)) :
    physicalGroupPhaseDelta x.1 y.1 g p = -((k * (physicalD C x.2.val aux : ℤ) : ℤ) : ZMod p.val) := by
  rw [physicalGroupPhaseDelta, hadm.2.2.2]
  simp

/-- The physical raw edge is the actual unrestricted event action with the
canonical physical unshared labels and exact transported-hit indices. -/
theorem physical_group_raw_edge_row {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) {x y : PhysicalState P J ell}
    (hadm : physicalAdmissible C aux k x y)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (g : G)
    (hk : ∀ s, ¬ ((x.2.val g s).val : ℤ) ∣ k)
    (β : ↥(P g) → ℝ) (ρ V : ℝ) (cap : ℕ)
    (F : Finset ↥(P g) → FiniteOrderedTuple (Σ p : ↥(P g), ZMod p.val) → ℂ)
    (H : Finset ↥(P g)) (q : FiniteOrderedTuple (Σ p : ↥(P g), ZMod p.val)) :
    globalBirthRawStepRow (physicalGroupRawEdge C aux k hadm hP hdis g hk β ρ V cap) F H q =
      globalBirthEdgeRawRow (physicalGroupUnsharedEmbedding C x.2.val g)
        (physicalGroupUnsharedEmbedding C y.2.val g) (physicalGroupPhaseDelta x.1 y.1 g)
        H q.2 (globalBirthRawHitIndices (physicalGroupPhaseDelta x.1 y.1 g) q) β ρ V cap F := rfl

/-- Every coherent physical source has the complete exact phase row, including
sources for which a required old hit is incompatible and the row vanishes. -/
theorem physical_group_raw_edge_intertwines {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) {x y : PhysicalState P J ell}
    (hadm : physicalAdmissible C aux k x y)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (g : G)
    [∀ p : ↥(P g), NeZero p.val]
    (hk : ∀ s, ¬ ((x.2.val g s).val : ℤ) ∣ k)
    (β : ↥(P g) → ℝ) (ρ V : ℝ) (cap : ℕ)
    (H : Finset ↥(P g)) (q : FiniteOrderedTuple (Σ p : ↥(P g), ZMod p.val))
    (hq : GlobalBirthMemoryCoherent (ghostPhaseActivitySupport (physicalGroupPhaseActivity x.2.val g)) H q)
    (F : Finset ↥(P g) → FiniteOrderedTuple (Σ p : ↥(P g), ZMod p.val) → ℂ)
    (f : ((p : ↥(P g)) → GhostPhaseState (ZMod p.val)) → ℂ)
    (hF : ∀ H' q', GlobalBirthMemoryCoherent
      (ghostPhaseActivitySupport (physicalGroupPhaseActivity y.2.val g)) H' q' → q'.1 ≤ cap →
      F H' q' = f (globalBirthMemoryReadout (ghostPhaseActivitySupport (physicalGroupPhaseActivity y.2.val g)) H' q')) :
    globalBirthEdgeRawRow (physicalGroupUnsharedEmbedding C x.2.val g)
      (physicalGroupUnsharedEmbedding C y.2.val g) (physicalGroupPhaseDelta x.1 y.1 g)
      H q.2 (globalBirthRawHitIndices (physicalGroupPhaseDelta x.1 y.1 g) q) β ρ V cap F =
      globalBirthRawStepPhaseRow (physicalGroupRawEdge C aux k hadm hP hdis g hk β ρ V cap) f
        (globalBirthMemoryReadout (ghostPhaseActivitySupport (physicalGroupPhaseActivity x.2.val g)) H q) :=
  global_birth_raw_step_intertwines (physicalGroupRawEdge C aux k hadm hP hdis g hk β ρ V cap)
    H q hq F f hF
end

