section

/- The prime-only initial case of uniform finite-depth Buchstab approximation. -/

open Filter Real

namespace Bounty

theorem uniform_rough_depth_approx_zero {S : ℝ} (hS : 0 ≤ S) :
    UniformRoughDepthApprox 0 S := by
  intro a b γ₀ gap ha hγ₀ hgap ε hε
  filter_upwards [eventually_normalized_prime_cell_error ha hS hε,
    eventually_gt_atTop (0 : ℝ)] with L hprime hL
  intro w γ hw hwb hγ hsep htop
  have hw0 : 0 < w := ha.trans_le hw
  have hγw : γ ≤ w := by linarith
  have hA : 1 ≤ exp (w*L) := one_le_exp (mul_nonneg hw0.le hL.le)
  have hcut : exp (γ*L) ≤ exp (w*L) :=
    exp_le_exp.mpr (mul_le_mul_of_nonneg_right hγw hL.le)
  have hB : exp (L^(-S))*exp (w*L) ≤ (exp (γ*L))^2 := by
    rw [← exp_add, ← exp_nat_mul]
    apply exp_le_exp.mpr
    norm_num only [Nat.cast_ofNat]
    have hh := mul_le_mul_of_nonneg_right htop hL.le
    norm_num only [Nat.cast_zero, zero_add] at hh
    have hc : (L^(-S)/L)*L = L^(-S) := div_mul_cancel₀ _ hL.ne'
    nlinarith
  have heq := rough_band_eq_prime_band_of_upper_le_cutoff_sq hA (exp_pos (γ*L)).le hB
  rw [max_eq_left hcut] at heq
  change |normalizedRoughCellCount L S (exp (w*L)) (exp (γ*L))-1/w| ≤ ε
  unfold normalizedRoughCellCount
  rw [heq]
  exact hprime w hw

end Bounty
end

section

/- Separating the induction range from the balanced cofactor tail. -/

namespace Bounty

open Finset Filter Real MeasureTheory
open scoped Topology

theorem normalized_buchstab_cofactor_comparison_bound
    {n : ℕ} {S L a b γ₀ w γ η τ C K : ℝ}
    (hL : 0 < L) (ha : 0 < a)
    (hη : 0 ≤ η) (hηa : η ≤ a/4) (hτ : 0 ≤ τ) (hC : 0 ≤ C) (hK : 0 ≤ K)
    (haw : a ≤ w) (hwb : w ≤ b) (hγ : γ₀ ≤ γ) (hγw : γ ≤ w)
    (hδ : L^(-S)/L ≤ η)
    (hrough : ∀ α x : ℝ, γ₀ ≤ α → a/3 ≤ x →
      |normalizedRoughCellCount L S (exp (x*L)) (exp (α*L))| ≤ C)
    (hkernel : ∀ α : ℝ, γ₀ ≤ α → α ≤ b → |buchstabDepthExtendedKernel n w α| ≤ K)
    (hgood : ∀ α : ℝ, γ ≤ α → α ≤ w/2-η →
      |normalizedRoughCellCount L S (exp ((w-α)*L)) (exp (α*L))-
        buchstabDepthExtendedKernel n w α| ≤ τ) :
    |(∑ p ∈ primeBand (exp (γ*L)) (sqrt (exp (L^(-S))*exp (w*L))),
        normalizedRoughCellCount L S (exp (w*L)/(p : ℝ)) (p : ℝ)/(p : ℝ)) -
      (∑ p ∈ primeBand (exp (γ*L)) (exp (max γ (w/2)*L)),
        buchstabDepthExtendedKernel n w (log (p : ℝ)/L)/(p : ℝ))| ≤
      τ*primeBandHarmonic (exp (γ₀*L)) (exp (b*L))+
      (C+K)*primeBandHarmonic (exp ((w/2-η)*L)) (exp (((w+L^(-S)/L)/2)*L)) := by
  rw [logarithmic_cell_sqrt_exp w S hL.ne']
  let v := (w+L^(-S)/L)/2
  let t := max γ (w/2-η)
  let m := max γ (w/2)
  have hδ0 : 0 ≤ L^(-S)/L := by positivity
  have hhalfv : w/2 ≤ v := by dsimp [v]; linarith
  have hvb : v ≤ b := by dsimp [v]; linarith
  have htm : t ≤ m := max_le_max le_rfl (by linarith)
  have hγt : γ ≤ t := le_max_left _ _
  have hmb : m ≤ b := max_le (hγw.trans hwb) (by linarith)
  have htlo : w/2-η ≤ t := le_max_right _ _
  have hmass0 (u v : ℝ) : 0 ≤ primeBandHarmonic u v := by
    unfold primeBandHarmonic
    exact sum_nonneg (fun _ _ => by positivity)
  by_cases hγv : γ ≤ v
  · have hmv : m ≤ v := max_le hγv hhalfv
    have htv : t ≤ v := htm.trans hmv
    have he (x y : ℝ) (hxy : x ≤ y) : exp (x*L) ≤ exp (y*L) :=
      exp_le_exp.mpr (mul_le_mul_of_nonneg_right hxy hL.le)
    have hpoint (p : ℕ) (hp : p ∈ primeBand (exp (γ*L)) (exp (t*L))) :
        |normalizedRoughCellCount L S (exp (w*L)/(p : ℝ)) (p : ℝ)-
          buchstabDepthExtendedKernel n w (log (p : ℝ)/L)| ≤ τ := by
      have hcoord := prime_log_coordinate_mem hL hp
      have hcut : log (p : ℝ)/L ≤ w/2-η := by
        by_cases hg : γ ≤ w/2-η
        · simpa only [t, max_eq_right hg] using hcoord.2
        · have hh : log (p : ℝ)/L ≤ γ := by
            simpa only [t, max_eq_left (le_of_not_ge hg)] using hcoord.2
          linarith [hcoord.1]
      have hp0 : (0 : ℝ) < p := by
        have hpp := ((mem_primeBand_iff (exp_pos _).le (exp_pos _).le p).mp hp).1
        exact Nat.cast_pos.mpr hpp.pos
      rw [exponential_cofactor_log_coordinate w hL.ne' hp0]
      have hh := hgood (log (p : ℝ)/L) hcoord.1.le hcut
      simpa only [exponential_prime_log_coordinate hL.ne' hp0] using hh
    have htail (p : ℕ) (hp : p ∈ primeBand (exp (t*L)) (exp (v*L))) :
        |normalizedRoughCellCount L S (exp (w*L)/(p : ℝ)) (p : ℝ)| ≤ C := by
      have hcoord := prime_log_coordinate_mem hL hp
      have hp0 : (0 : ℝ) < p := by
        have hpp := ((mem_primeBand_iff (exp_pos _).le (exp_pos _).le p).mp hp).1
        exact Nat.cast_pos.mpr hpp.pos
      have hα := hγ.trans (hγt.trans hcoord.1.le)
      have hx : a/3 ≤ w-log (p : ℝ)/L := by dsimp [v] at hcoord; linarith [hcoord.2]
      rw [exponential_cofactor_log_coordinate w hL.ne' hp0]
      have hh := hrough (log (p : ℝ)/L) (w-log (p : ℝ)/L) hα hx
      simpa only [exponential_prime_log_coordinate hL.ne' hp0] using hh
    have hktail (p : ℕ) (hp : p ∈ primeBand (exp (t*L)) (exp (m*L))) :
        |buchstabDepthExtendedKernel n w (log (p : ℝ)/L)| ≤ K := by
      have hcoord := prime_log_coordinate_mem hL hp
      exact hkernel _ (hγ.trans (hγt.trans hcoord.1.le)) (hcoord.2.trans hmb)
    have hb := prime_band_reciprocal_split_error
      (fun p => normalizedRoughCellCount L S (exp (w*L)/(p : ℝ)) (p : ℝ))
      (fun p => buchstabDepthExtendedKernel n w (log (p : ℝ)/L))
      (he _ _ hγt) (he _ _ htm) (he _ _ hmv) hpoint htail hktail
    have hmain := exponential_prime_band_harmonic_mono hL.le hγ (htm.trans hmb)
    have htail1 := exponential_prime_band_harmonic_mono hL.le htlo (le_refl v)
    have htail2 := exponential_prime_band_harmonic_mono hL.le htlo hmv
    calc
      _ ≤ τ*primeBandHarmonic (exp (γ*L)) (exp (t*L))+
          C*primeBandHarmonic (exp (t*L)) (exp (v*L))+
          K*primeBandHarmonic (exp (t*L)) (exp (m*L)) := hb
      _ ≤ τ*primeBandHarmonic (exp (γ₀*L)) (exp (b*L))+
          C*primeBandHarmonic (exp ((w/2-η)*L)) (exp (v*L))+
          K*primeBandHarmonic (exp ((w/2-η)*L)) (exp (v*L)) :=
        add_le_add (add_le_add (mul_le_mul_of_nonneg_left hmain hτ)
          (mul_le_mul_of_nonneg_left htail1 hC)) (mul_le_mul_of_nonneg_left htail2 hK)
      _ = _ := by dsimp [v]; ring
  · have hvγ : v ≤ γ := le_of_not_ge hγv
    have hmγ : m = γ := max_eq_left (hhalfv.trans hvγ)
    have hempty : primeBand (exp (γ*L)) (exp (v*L)) = ∅ :=
      prime_band_eq_empty_of_upper_le (exp_le_exp.mpr (mul_le_mul_of_nonneg_right hvγ hL.le))
    change |(∑ p ∈ primeBand (exp (γ*L)) (exp (v*L)),
        normalizedRoughCellCount L S (exp (w*L)/(p : ℝ)) (p : ℝ)/(p : ℝ)) -
      (∑ p ∈ primeBand (exp (γ*L)) (exp (m*L)),
        buchstabDepthExtendedKernel n w (log (p : ℝ)/L)/(p : ℝ))| ≤ _
    rw [hempty, hmγ, prime_band_eq_empty_of_upper_le le_rfl]
    simp only [sum_empty, sub_self, abs_zero]
    exact add_nonneg (mul_nonneg hτ (hmass0 _ _))
      (mul_nonneg (add_nonneg hC hK) (hmass0 _ _))

theorem eventually_logarithmic_cell_width_div_le {S η : ℝ}
    (hS : 0 ≤ S) (hη : 0 < η) :
    ∀ᶠ L : ℝ in atTop, L^(-S)/L ≤ η := by
  filter_upwards [eventually_ge_atTop (1 : ℝ), eventually_ge_atTop (1/η)] with L hL1 hLη
  have hL : 0 < L := zero_lt_one.trans_le hL1
  have hp : L^(-S) ≤ 1 := rpow_le_one_of_one_le_of_nonpos hL1 (neg_nonpos.mpr hS)
  have hηL : 1 ≤ η*L := by
    have h := (div_le_iff₀ hη).mp hLη
    nlinarith
  exact (div_le_div_of_nonneg_right hp hL.le).trans ((div_le_iff₀ hL).mpr hηL)

theorem uniform_rough_depth_cofactor_sum_error {n : ℕ} {S : ℝ}
    (hS : 0 ≤ S) (hprev : UniformRoughDepthApprox n S)
    {a b γ₀ ε : ℝ} (ha : 0 < a) (hγ₀ : 0 < γ₀) (hγb : γ₀ < b) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ w γ : ℝ,
      a ≤ w → w ≤ b → γ₀ ≤ γ → γ ≤ w →
      w+L^(-S)/L ≤ ((n : ℝ)+3)*γ →
      |(∑ p ∈ primeBand (exp (γ*L)) (sqrt (exp (L^(-S))*exp (w*L))),
          normalizedRoughCellCount L S (exp (w*L)/(p : ℝ)) (p : ℝ)/(p : ℝ)) -
        (∑ p ∈ primeBand (exp (γ*L)) (exp (max γ (w/2)*L)),
          buchstabDepthExtendedKernel n w (log (p : ℝ)/L)/(p : ℝ))| ≤ ε := by
  obtain ⟨C,hC,hrough⟩ := exists_normalized_rough_cell_bound (a := a/3) (by positivity) hγ₀
  have hc : ContinuousOn (fun p : ℝ × ℝ => buchstabDepthExtendedKernel n p.1 p.2)
      ((Set.Icc a b) ×ˢ (Set.Icc γ₀ b)) := by
    apply (buchstab_depth_extended_kernel_continuous n).mono
    intro p hp
    exact ⟨ha.trans_le hp.1.1, hγ₀.trans_le hp.2.1⟩
  obtain ⟨K₀,hK₀⟩ := (isCompact_Icc.prod isCompact_Icc).exists_bound_of_continuousOn hc
  let K : ℝ := |K₀|+1
  have hK : 0 < K := by dsimp [K]; positivity
  have hkernel : ∀ w α : ℝ, a ≤ w → w ≤ b → γ₀ ≤ α → α ≤ b →
      |buchstabDepthExtendedKernel n w α| ≤ K := by
    intro w α haw hwb hα hαb
    have hh := hK₀ (w,α) ⟨⟨haw,hwb⟩,⟨hα,hαb⟩⟩
    rw [Real.norm_eq_abs] at hh
    exact hh.trans (by dsimp [K]; linarith [le_abs_self K₀])
  let M : ℝ := |log (b/γ₀)|+1
  have hM : 0 < M := by dsimp [M]; positivity
  let T : ℝ := 8/a+1
  have hT : 0 < T := by dsimp [T]; positivity
  let τ : ℝ := ε/(4*M)
  have hτ : 0 < τ := by dsimp [τ]; positivity
  let η : ℝ := min (a/4) (ε/(4*(C+K)*T))
  have hη : 0 < η := by dsimp [η]; positivity
  have hηa : η ≤ a/4 := min_le_left _ _
  have hτbudget : τ*M = ε/4 := by dsimp [τ]; field_simp
  have hηbudget : (C+K)*(T*η) ≤ ε/4 := by
    have he : η*(4*(C+K)*T) ≤ ε :=
      (le_div_iff₀ (by positivity : 0 < 4*(C+K)*T)).mp (min_le_right _ _)
    nlinarith
  have hmass := (exponential_prime_band_harmonic_tendsto hγ₀ hγb.le).eventually_lt_const
    (show log (b/γ₀) < M by dsimp [M]; linarith [le_abs_self (log (b/γ₀))])
  filter_upwards [eventually_gt_atTop (0 : ℝ), hrough S, hmass,
    uniform_rough_depth_cofactor_pointwise hprev ha hγ₀ hη hτ,
    eventually_logarithmic_cell_width_div_le hS hη,
    exponential_prime_band_short_interval_bound (a := a/4) (η := 2*η)
      (by positivity) (by positivity) hη] with L hL hr hm hg hδ hs
  intro w γ haw hwb hγ hγw htop
  have hraw : ∀ α x : ℝ, γ₀ ≤ α → a/3 ≤ x →
      |normalizedRoughCellCount L S (exp (x*L)) (exp (α*L))| ≤ C := by
    intro α x hα hx
    obtain ⟨h0,h1⟩ := hr α x hα hx
    simpa only [abs_of_nonneg h0] using h1
  have hp := normalized_buchstab_cofactor_comparison_bound hL ha hη.le hηa
    hτ.le hC.le hK.le haw hwb hγ hγw hδ hraw
    (fun α hα hαb => hkernel w α haw hwb hα hαb)
    (fun α hγα hα => hg w γ α haw hwb hγ hγα hα htop)
  have hδ0 : 0 ≤ L^(-S)/L := by positivity
  have hsmall : primeBandHarmonic (exp ((w/2-η)*L)) (exp (((w+L^(-S)/L)/2)*L)) ≤ T*η := by
    have hh := hs (w/2-η) ((w+L^(-S)/L)/2)
      (by linarith) (by linarith) (by linarith)
    convert hh using 1; dsimp [T]; field_simp; ring
  calc
    _ ≤ τ*primeBandHarmonic (exp (γ₀*L)) (exp (b*L))+
        (C+K)*primeBandHarmonic (exp ((w/2-η)*L)) (exp (((w+L^(-S)/L)/2)*L)) := hp
    _ ≤ τ*M+(C+K)*(T*η) := add_le_add
      (mul_le_mul_of_nonneg_left hm.le hτ.le)
      (mul_le_mul_of_nonneg_left hsmall (add_nonneg hC.le hK.le))
    _ ≤ ε := by linarith

end Bounty

/- Public declaration closure audit. -/
end

section

/- The full candidate mixed dirty estimate, with the genuine small-state
measure, arbitrary bounded endpoint coefficient, and both small-slot
averages. Actual promotion and storage bounds are discharged separately. -/

open Finset Filter
open scoped Classical Topology

namespace Bounty

theorem eventually_candidate_mixed_dirty_energy_le
    {q vs scale : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hvs : 0 < vs) (hscale : 0 < scale)
    (ell : ℕ) (C₂ : ℝ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ᶠ L : ℝ in atTop,
      letI : DecidableEq (CandidateSmallGroup scale L) := Classical.decEq _
      letI : DecidableEq (CandidateBigGroup scale L) := Classical.decEq _
      letI : ∀ p : PhysicalPrime (candidateSmallPool scale L), NeZero p.2.val :=
        candidateSmallPrimeNeZero scale L
      letI : ∀ g p, NeZero (candidateBigModulus scale L g p) := candidateBigModulusNeZero scale L
      ∀ J B : ℕ,
      letI : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
      ∀ M : CandidateBigGroup scale L → ℕ,
      ∀ shared : ∀ g, Finset (Fin (M g)),
      ∀ D_B : SharedActiveLabels (CandidateBigLabel scale L) shared → ℕ,
      ∀ k : ℤ, k ≠ 0 → (k.natAbs : ℝ) ≤ L ^ C₂ →
      ∀ Vs : CandidateSmallGroup scale L → ℝ, (∀ g, vs ≤ Vs g) →
      ∀ μ : ∀ g, CandidateBigLabel scale L g → ℝ, ∀ ρ : ℝ,
      ∀ V : CandidateBigGroup scale L → ℝ,
      ∀ v vmin vmax : ℝ, 0 < ρ → ρ < 1 → 1 < v → 0 < vmin →
      (∀ g, vmin ≤ V g) → (∀ g, V g ≤ vmax) →
      (∀ g p, 0 ≤ μ g p) → (∀ g, ∑ p, μ g p ≤ 2) →
      ∀ T : ℕ, (∀ g, (shared g)ᶜ.card ≤ T) →
      ∀ Φ : ∀ s : PhysicalSmallBigState (candidateSmallPool scale L) J ell
        (ProductBoundedOrderedState (CandidateBigLabel scale L)
          (fun g => UnrestrictedResidueParticle (candidateBigModulus scale L g)) M B),
        PhysicalSmallBigEvent (PhysicalSmallBigFullEvent (candidateBigModulus scale L) shared B
          (fun d c _ => -(k * (D_B c * physicalSharedProduct d : ℕ)))
          (fun d c _ => (D_B c * physicalSharedProduct d : ℕ))) s → ℂ,
      (∀ s e, ‖Φ s e‖ ≤ 1) →
      ∀ F : PhysicalSmallBigState (candidateSmallPool scale L) J ell
        (ProductBoundedOrderedState (CandidateBigLabel scale L)
          (fun g => UnrestrictedResidueParticle (candidateBigModulus scale L g)) M B) → ℂ,
      (∀ s, ProductMemorySymmetric (fun x => F (s, x))) →
      physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
        (physicalSmallBigAverage (fun s =>
          physicalSmallBigFullPhasedAction (candidateBigModulus scale L) shared B
            (fun d c _ => -(k * (D_B c * physicalSharedProduct d : ℕ)))
            (fun d c _ => (D_B c * physicalSharedProduct d : ℕ)) μ ρ V
            (fun c => k * D_B c) Vs q
            (fun y e => if ¬ (∀ g, (e.2.2 g).1 = ∅ ∧ (e.2.2 g).2.1 = ∅) then Φ y e else 0)
            (physicalSmallBigAverage F) s)) ≤
      4 * ((B : ℝ) / (((J + ell).choose ell) ^ (candidateSmallPIndices scale L).card : ℕ)) *
        (A ^ (2 * (candidateSmallPIndices scale L).card) *
          unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ (candidateBigPIndices scale L).card) *
        physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) F := by
  obtain ⟨Ap, hAp, hp⟩ := eventually_candidate_mixed_promotion_energy_le hq0 hq1 hvs hscale ell C₂
  obtain ⟨As, hAs, hs⟩ := eventually_candidate_mixed_storage_energy_le hq0 hq1 hvs hscale ell C₂
  refine ⟨max Ap As, hAp.trans (le_max_left _ _), ?_⟩
  filter_upwards [hp, hs] with L hpL hsL
  let _ : DecidableEq (CandidateSmallGroup scale L) := Classical.decEq _
  let _ : DecidableEq (CandidateBigGroup scale L) := Classical.decEq _
  let _ : ∀ p : PhysicalPrime (candidateSmallPool scale L), NeZero p.2.val := candidateSmallPrimeNeZero scale L
  let _ : ∀ g p, NeZero (candidateBigModulus scale L g p) := candidateBigModulusNeZero scale L
  intro J B
  let _ : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
  intro M shared D_B k hk hkbound Vs hVs μ ρ V v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi
    hμ hmass T ht Φ hΦ F hF
  let W : ProductBoundedOrderedState (CandidateBigLabel scale L)
      (fun g => UnrestrictedResidueParticle (candidateBigModulus scale L g)) M B → ℝ :=
    productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))
  let env := complexNormEnvelope (physicalSmallBigAverage F)
  let δ : ℝ := (B : ℝ) / (((J + ell).choose ell) ^ (candidateSmallPIndices scale L).card : ℕ)
  let C : ℝ := unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ (candidateBigPIndices scale L).card
  let K : ℝ := (max Ap As) ^ (2 * (candidateSmallPIndices scale L).card) * C
  let aux : PhysicalAuxLabels (candidateSmallPool scale L) (fun _ => (∅ : Finset (Fin J))) :=
    fun _ j => False.elim ((Finset.notMem_empty j.val) j.property)
  have hVs' : ∀ s, 0 < Vs s := fun s => hvs.trans_le (hVs s)
  have hW : ∀ x, 0 ≤ W x := productMemoryWeight_nonneg μ _ hμ (fun g z => hμ g z.1)
  have hδ : 0 ≤ δ := div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _)
  have hC : 0 ≤ C := pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _
  have hmax : 0 ≤ max Ap As := (zero_le_one.trans hAp).trans (le_max_left _ _)
  have henv : ∀ s, ProductMemorySymmetric (fun x => env (s, x)) := by
    intro s x g τ
    exact congrArg (fun z : ℂ => (‖z‖ : ℂ))
      (physical_small_big_average_memory_symmetric F hF s x g τ)
  have henvfix : physicalSmallBigAverage env = env := physical_small_big_average_envelope_fixed F
  have henvE : physicalSmallBigEnergy Vs W env ≤ physicalSmallBigEnergy Vs W F :=
    physical_small_big_average_envelope_energy_le Vs hVs' W hW F
  have henv0 : 0 ≤ physicalSmallBigEnergy Vs W env := by
    rw [← physical_small_big_energy_eq]
    exact sum_nonneg fun s _ => mul_nonneg
      (physical_small_big_measure_nonneg Vs hVs' W hW s) (sq_nonneg _)
  have upgrade (a : ℝ) (ha : 0 ≤ a) (haA : a ≤ max Ap As)
      (out : PhysicalSmallBigState (candidateSmallPool scale L) J ell
        (ProductBoundedOrderedState (CandidateBigLabel scale L)
          (fun g => UnrestrictedResidueParticle (candidateBigModulus scale L g)) M B) → ℂ)
      (hout : physicalSmallBigEnergy Vs W out ≤
        δ * (a ^ (2 * (candidateSmallPIndices scale L).card) * C) * physicalSmallBigEnergy Vs W env) :
      physicalSmallBigEnergy Vs W out ≤ δ * K * physicalSmallBigEnergy Vs W F := by
    apply hout.trans
    refine mul_le_mul ?_ henvE henv0 ?_
    · exact mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_right (pow_le_pow_left₀ ha haA _) hC) hδ
    · exact mul_nonneg hδ (mul_nonneg (pow_nonneg hmax _) hC)
  have hprom := hpL J B M shared D_B k hk hkbound Vs hVs μ ρ V v vmin vmax
    hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht (fun _ _ => 1) 1 zero_le_one
    (by intros; simp only [norm_one, le_refl]) env henv
  simp only [one_pow, one_mul] at hprom
  have hstore := hsL J B M shared D_B k hk hkbound Vs hVs aux μ ρ V v vmin vmax
    hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht env henv
  rw [henvfix] at hstore
  exact physical_small_big_dirty_energy_of_components Vs W hVs' hW F _ _ _ δ K
    (physical_small_big_averaged_dirty_domination (candidateBigModulus scale L) shared B
      (fun d c _ => -(k * (D_B c * physicalSharedProduct d : ℕ)))
      (fun d c _ => (D_B c * physicalSharedProduct d : ℕ)) μ ρ V
      (fun c => k * D_B c) Vs q aux hVs' hμ hρ0.le (fun g => (hvmin.trans_le (hVlo g)).le)
      Φ hΦ (physicalSmallBigAverage F))
    (upgrade Ap (zero_le_one.trans hAp) (le_max_left _ _) _ hprom)
    (upgrade As (zero_le_one.trans hAs) (le_max_right _ _) _ hstore)

end Bounty
end

section

/- The stage indicator is exactly the current original event test, with no births at permutation owners. -/

open Classical Finset

namespace Bounty

section Gain
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K)))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))

theorem full_mixed_forest_history_gain_tagged (u : Fin steps.length)
    (tag : Option (J ⊕ K)) (htag : steps.get u = tag)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag s)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P)) :
    fullMixedForestHistoryGain n S B A Δ D steps code u.val tag s e history =
      if birthForestStageCondition
        (fun i => fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i)) u
        (fullMixedBirthHistoryWrite n S B A Δ D steps u s
          (fullMixedTaggedOwnerEvent n S B A Δ D steps u tag htag s e) history) code then 1 else 0 := by
  subst tag
  exact full_mixed_forest_history_gain_owner n S B A Δ D steps code u s e history

theorem full_mixed_none_owner_empty (u : Fin steps.length) (htag : steps.get u = none)
    (i : Fin (Fintype.card (FullMixedBirthAddress S B steps))) :
    fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i) ≠ u := by
  intro hi
  obtain ⟨a, _⟩ := (full_mixed_tagged_occurrence_range S B steps u none htag i).mp hi
  exact Fin.elim0 a.2

theorem full_mixed_none_selected_count (u : Fin steps.length) (htag : steps.get u = none)
    (g : Fin N) : fullMixedSelectedCount S B steps code u g = 0 := by
  apply card_eq_zero.mpr
  apply filter_eq_empty_iff.mpr
  intro i _ hi
  exact full_mixed_none_owner_empty S B steps u htag i hi.1

theorem full_mixed_forest_history_gain_none (u : Fin steps.length) (htag : steps.get u = none)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D none s)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P)) :
    fullMixedForestHistoryGain n S B A Δ D steps code u.val none s e history = 1 := by
  rw [full_mixed_forest_history_gain_tagged n S B A Δ D steps code u none htag]
  apply if_pos
  intro i hi
  exact False.elim (full_mixed_none_owner_empty S B steps u htag i hi)

end Gain
end Bounty
end

section

/- Actual fixed-skeleton ghost stages pay exactly their original selected-child atom costs. -/

open Finset Classical

namespace Bounty

section Ghost
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
    [∀ g, DecidableEq (P g)] {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K))) (u : Fin steps.length) (j : J)
    (htag : steps.get u = some (.inl j))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))
    (sk : CoupledGhostSkeleton M B s)
    (μ : ∀ g, P g → ℝ) (q ρ v : ℝ) (V η : Fin N → ℝ)

theorem full_mixed_ghost_skeleton_stage_le
    (hη : ∀ g, 0 ≤ η g) (hμ : ∀ g p, 0 ≤ μ g p) (hμatom : ∀ g p, μ g p ≤ η g) (hv : 0 ≤ v) :
    let d := fullMixedSelectedCount S B steps code u
    (∑ births : CoupledGhostSamples M B s sk,
      if birthForestStageCondition
        (fun i => fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i)) u
        (fullMixedBirthHistoryWrite n S B A Δ D steps u s
          (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inl j)) htag s
            ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩)) history) code then
        |coupledGhostJointEventWeight
          (fun g => physicalGhostRetention (n g) q ρ)
          (fun g => physicalGhostTermination (n g) q ρ)
          (fun g => physicalGhostBirth (n g) q ρ (V g))
          (fun g => unrestrictedResidueWeight (μ g)) M B s
          ((coupledGhostSkeletonEquiv M B s).symm ⟨sk, births⟩)| *
        productLengthLyapunov v
          (coupledGhostJointEventTarget M B s ((coupledGhostSkeletonEquiv M B s).symm ⟨sk, births⟩))
      else 0) ≤
    if ∀ g, d g ≤ (sk g).1.val then
      coupledGhostSkeletonAbsMass
        (fun g => physicalGhostRetention (n g) q ρ)
        (fun g => physicalGhostTermination (n g) q ρ) M B s sk *
        v ^ (∑ g, boundedGhostSkeletonOutputCount (M g) B (s g) (sk g).1 (sk g).2) *
        ∏ g, (|(1 - q) * V g / ρ| * η g) ^ d g *
          (|(1 - q) * V g / ρ| * ∑ p, μ g p) ^ ((sk g).1.val - d g)
    else 0 := by
  dsimp only
  let ord := fullMixedGhostOwnerSampleOrder S B j steps u htag s sk
  let f := fullMixedGhostOwnerSampleEmbedding S B j steps u htag s sk
  let owner := fun i => fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i)
  let d := fullMixedSelectedCount S B steps code u
  let root := fun g => |(1 - q) * V g / ρ| * ∑ p, μ g p
  let atom := fun g => |(1 - q) * V g / ρ| * η g
  rw [full_mixed_ghost_skeleton_stage_sum n S B A Δ D steps u s history code j htag sk]
  by_cases hs : birthForestStageSupport owner u (ownerSampleSupport (f ∘ ord) owner u history) code
  · dsimp only [owner, f, ord, Function.comp] at hs
    erw [if_pos hs]
    have hd : ∀ g, (univ.filter (fun i : Fin (sk g).1.val => code (f ⟨g, i⟩) ≠ none)).card = d g := by
      intro g
      exact owner_supported_selected_fiber_card (fun g => Fin (sk g).1.val) ord f owner u
        (fun i => (fullMixedBirthOrder S B steps i).2.1)
        (full_mixed_ghost_owner_sample_owner S B j steps u htag s sk)
        (full_mixed_ghost_owner_sample_group S B j steps u htag s sk) code history hs g
    have hcap : ∀ g, d g ≤ (sk g).1.val := by
      intro g
      rw [← hd g]
      exact (card_filter_le _ _).trans_eq (by simp only [card_univ, Fintype.card_fin])
    rw [if_pos hcap]
    have hvalid := owner_sample_support_anchors_valid (f ∘ ord)
      (full_mixed_ghost_owner_sample_strictMono S B j steps u htag s sk)
      owner (full_mixed_birth_order_owner_monotone S B steps) u
      (fun i => full_mixed_ghost_owner_sample_owner S B j steps u htag s sk (ord i)) history code hs
    have hcost := grouped_join_restricted_forest_cost_eq (fun g => Fin (sk g).1.val)
      ord f code history root atom d hvalid hd
    have hb := coupled_ghost_forest_continuation_le n μ q ρ V M B s sk ord
      (restrictedBirthCode (f ∘ ord) code) (fun i => (restrictedBirthAnchors (f ∘ ord) code history i).join)
      η hη hμ hμatom v 1 hv zero_le_one
      (fun births => productLengthLyapunov v
        (coupledGhostJointEventTarget M B s ((coupledGhostSkeletonEquiv M B s).symm ⟨sk, births⟩)))
      (fun _ => by simp only [one_mul]; exact le_rfl)
    rw [one_mul] at hb
    dsimp only [root, atom] at hcost
    refine le_trans (le_of_eq ?_) (le_trans hb (le_of_eq ?_))
    · apply sum_congr rfl
      intro births _
      dsimp only [f, ord, Function.comp]
      split_ifs <;> first | rfl | contradiction
    · congr 1
      convert hcost using 1
      · apply prod_congr rfl
        intro i _
        cases restrictedBirthCode (f ∘ ord) code i <;>
          cases (restrictedBirthAnchors (f ∘ ord) code history i).join <;> rfl
      · simp only [Fintype.card_fin, d]
  · dsimp only [owner, f, ord, Function.comp] at hs
    erw [if_neg hs]
    split_ifs
    · exact mul_nonneg
        (mul_nonneg (coupled_ghost_skeleton_abs_mass_nonneg _ _ _ _ _ _) (pow_nonneg hv _))
        (prod_nonneg fun g _ => mul_nonneg
          (pow_nonneg (mul_nonneg (abs_nonneg _) (hη g)) _)
          (pow_nonneg (mul_nonneg (abs_nonneg _) (sum_nonneg fun p _ => hμ g p)) _))
    · exact le_rfl

end Ghost
end Bounty
end

section

/- Actual fixed-skeleton full-edge stages pay exactly their original selected-child atom costs. -/

open Finset Classical

namespace Bounty

section Edge
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
    [∀ g, DecidableEq (P g)] {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K))) (u : Fin steps.length) (k : K)
    (htag : steps.get u = some (.inr k))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))
    (sk : FullActiveEdgeSkeleton n (S k) B (A k) (Δ k) (D k) s)
    (ω : ∀ c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (ρ v : ℝ) (V η : Fin N → ℝ)

theorem full_mixed_edge_skeleton_stage_le
    (hη : ∀ g, 0 ≤ η g) (hμ : ∀ g p, 0 ≤ μ g p) (hμatom : ∀ g p, μ g p ≤ η g) (hv : 0 ≤ v) :
    let d := fullMixedSelectedCount S B steps code u
    (∑ fresh : FullActiveEdgeSamples n (S k) B (A k) (Δ k) (D k) s sk,
      if birthForestStageCondition
        (fun i => fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i)) u
        (fullMixedBirthHistoryWrite n S B A Δ D steps u s
          (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inr k)) htag s
            ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm ⟨sk, fresh⟩)) history) code then
        |fullActiveEdgeEventWeight n (S k) B (A k) (Δ k) (D k) ω μ ρ V s ((fullActiveEdgeSkeletonEquiv n (S k) B (A k) (Δ k) (D k) s).symm ⟨sk, fresh⟩)| * productLengthLyapunov v (fullActiveEdgeEventTarget n (S k) B (A k) (Δ k) (D k) s ((fullActiveEdgeSkeletonEquiv n (S k) B (A k) (Δ k) (D k) s).symm ⟨sk, fresh⟩))
      else 0) ≤
    if ∀ g, d g ≤ ((S k g)ᶜ.card - (sk.2 g).2.1.card) then
      fullActiveEdgeSkeletonAbsMass n (S k) B (A k) (Δ k) (D k) ω ρ V s sk * v ^ (∑ g, unrestrictedSkeletonOutputCount (n g)
          (Δ k (productActiveMemorySplit (S k) B s).1 sk.1 g)
          (D k (productActiveMemorySplit (S k) B s).1 sk.1 g)
          (S k g)ᶜ.card B ((productActiveMemorySplit (S k) B s).2 g) (sk.2 g)) *
        ∏ g, η g ^ d g * (∑ p, μ g p) ^ (((S k g)ᶜ.card - (sk.2 g).2.1.card) - d g)
    else 0 := by
  dsimp only
  let ord := fullMixedEdgeOwnerSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk
  let f := fullMixedEdgeOwnerSampleEmbedding n S B k steps u htag (A k) (Δ k) (D k) s sk
  let owner := fun i => fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i)
  let d := fullMixedSelectedCount S B steps code u
  rw [full_mixed_edge_skeleton_stage_sum n S B A Δ D steps u s history code k htag sk]
  by_cases hs : birthForestStageSupport owner u (ownerSampleSupport (f ∘ ord) owner u history) code
  · dsimp only [owner, f, ord, Function.comp] at hs
    erw [if_pos hs]
    have hd : ∀ g, (univ.filter (fun i : {i : Fin (S k g)ᶜ.card // i ∉ (sk.2 g).2.1} => code (f ⟨g, i⟩) ≠ none)).card = d g := by
      intro g
      exact owner_supported_selected_fiber_card (fun g => {i : Fin (S k g)ᶜ.card // i ∉ (sk.2 g).2.1}) ord f owner u
        (fun i => (fullMixedBirthOrder S B steps i).2.1)
        (full_mixed_edge_owner_sample_owner n S B k steps u htag (A k) (Δ k) (D k) s sk)
        (full_mixed_edge_owner_sample_group n S B k steps u htag (A k) (Δ k) (D k) s sk) code history hs g
    have hcap : ∀ g, d g ≤ ((S k g)ᶜ.card - (sk.2 g).2.1.card) := by
      intro g
      rw [← hd g]
      have h := card_filter_le (s := (univ : Finset ({i : Fin (S k g)ᶜ.card // i ∉ (sk.2 g).2.1})))
        (p := fun i => code (f ⟨g, i⟩) ≠ none)
      simpa only [card_univ, Fintype.card_subtype_compl, Fintype.card_fin, Fintype.card_coe] using h
    rw [if_pos hcap]
    have hvalid := owner_sample_support_anchors_valid (f ∘ ord)
      (full_mixed_edge_owner_sample_strictMono n S B k steps u htag (A k) (Δ k) (D k) s sk)
      owner (full_mixed_birth_order_owner_monotone S B steps) u
      (fun i => full_mixed_edge_owner_sample_owner n S B k steps u htag (A k) (Δ k) (D k) s sk (ord i)) history code hs
    have hb := full_edge_grouped_restricted_continuation_le n (S k) B (A k) (Δ k) (D k) ω μ ρ V s sk ord
      f code history d hvalid hd
      η hη hμ hμatom v 1 hv zero_le_one
      (fun fresh => productLengthLyapunov v (fullActiveEdgeEventTarget n (S k) B (A k) (Δ k) (D k) s ((fullActiveEdgeSkeletonEquiv n (S k) B (A k) (Δ k) (D k) s).symm ⟨sk, fresh⟩)))
      (fun _ => by simp only [one_mul]; exact le_rfl)
    rw [one_mul] at hb
    refine le_trans (le_of_eq ?_) hb
    apply sum_congr rfl
    intro fresh _
    dsimp only [f, ord, Function.comp]
    split_ifs <;> first | rfl | contradiction
  · dsimp only [owner, f, ord, Function.comp] at hs
    erw [if_neg hs]
    split_ifs
    · exact mul_nonneg
        (mul_nonneg (full_active_edge_skeleton_abs_mass_nonneg _ _ _ _ _ _ _ _ _ _ _) (pow_nonneg hv _))
        (prod_nonneg fun g _ => mul_nonneg (pow_nonneg (hη g) _)
          (pow_nonneg (sum_nonneg fun p _ => hμ g p) _))
    · exact le_rfl

end Edge
end Bounty
end

section

/- Both encoded endpoint states use the same original full divisor and displacement. -/

open scoped Classical
namespace Bounty

theorem physical_mixed_step_factor
    {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (k : ℤ) (d : PhysicalSharedLists Ps J)
    (c : SharedActiveLabels (fun g => ↥(P g))
      (fun g => physicalFullSharedIndices (ell := ell) (C g)))
    (aux : PhysicalAuxLabels P C) :
    physicalMixedBigStep C k c aux * (physicalSharedProduct d : ℕ) =
      k * (physicalMixedSharedD C d c aux : ℕ) := by
  simp only [physicalMixedBigStep, physicalMixedSharedD, Nat.cast_mul]
  ring

theorem physical_mixed_parameters_both_endpoints
    {G H : Type*} [Fintype G] [Fintype H]
    {P : G → Finset ℕ} {J ell B : ℕ}
    (small : G → Prop) (e : {g : G // ¬small g} ≃ H)
    (C : G → Finset (Fin J)) (hC : ∀ g, small g → C g = ∅)
    (aux : PhysicalAuxLabels P C) (L R : PhysicalMarkLists P J ell)
    (hshared : physicalSharedCompatible C L R) (k : ℤ)
    {Z : H → Type*} (qL qR : ∀ h, BoundedOrderedTuple (Z h) B) :
    let Cb := fun h => C (e.symm h).val
    let d := physicalSharedPrefix (fun g : {g // small g} => L g.val)
    let ab := physicalAuxGroupReindex e (fun g => P g.val) J (fun g => C g.val) (fun g => aux g.val)
    let cL := (productActiveMemorySplit (fun h => physicalFullSharedIndices (Cb h)) B
      (physicalFullMemoryState Cb
        (physicalMarkGroupReindex e (fun g => P g.val) J ell (fun g => L g.val)) qL)).1
    let cR := (productActiveMemorySplit (fun h => physicalFullSharedIndices (Cb h)) B
      (physicalFullMemoryState Cb
        (physicalMarkGroupReindex e (fun g => P g.val) J ell (fun g => R g.val)) qR)).1
    let parameters := fun c => (physicalMixedEdgeD Cb d c ab, physicalMixedEdgeDelta Cb k d c ab,
      physicalMixedBigStep Cb k c ab * (physicalSharedProduct d : ℕ))
    let original := ((fun _ : H => (physicalD C L aux : ℤ)),
      (fun _ : H => -k * (physicalD C L aux : ℕ)), k * (physicalD C L aux : ℕ))
    parameters cL = original ∧ parameters cR = original := by
  dsimp only
  have hs := physical_mixed_shared_D_reindexed small e C hC aux L qL
  have hr := physical_mixed_shared_D_reindexed small e C hC aux R qR
  have hp := physical_mixed_small_prefix_eq small C hC hshared
  have hd := physical_D_eq_of_shared C hshared aux
  rw [← hp, ← hd] at hr
  unfold physicalMixedEdgeDelta physicalMixedEdgeD
  simp only [physical_mixed_step_factor, hs, hr, and_self]


theorem physical_mixed_big_step_shared_endpoints
    {G : Type*} [Fintype G] {P : G → Finset ℕ} {Z : G → Type*} {J ell B : ℕ}
    (C : G → Finset (Fin J)) (k : ℤ) (L R : PhysicalMarkLists P J ell)
    (hshared : physicalSharedCompatible C L R) (aux : PhysicalAuxLabels P C)
    (qL qR : ∀ g, BoundedOrderedTuple (Z g) B) :
    physicalMixedBigStep C k
      (productActiveMemorySplit (fun g => physicalFullSharedIndices (C g)) B
        (physicalFullMemoryState C L qL)).1 aux =
    physicalMixedBigStep C k
      (productActiveMemorySplit (fun g => physicalFullSharedIndices (C g)) B
        (physicalFullMemoryState C R qR)).1 aux := by
  rw [physical_mixed_big_step_at_state, physical_mixed_big_step_at_state,
    physical_D_eq_of_shared C hshared aux]

end Bounty
end

section

/- The original fresh-birth initial-ledger gate survives the mixed clean
encoding change. Neither auxiliary nor promoted labels are newly tested. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_mixed_clean_initial_sum_reencode {S G : Type*} [Fintype S] [Fintype G]
    [dG : DecidableEq G] {Ps : S → Finset ℕ} {J ell B : ℕ} {P : G → Finset ℕ}
    [∀ g (p : P g), NeZero p.val]
    (initial : ∀ g, Finset (P g)) (C : G → Finset (Fin J)) (k : ℤ) (d : PhysicalSharedLists Ps J)
    (ω : PhysicalAuxLabels P C → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (Θ : PhysicalAuxLabels P C → (∀ g, Fin (cleanFullSharedSlots (ell := ell) C g)ᶜ.card → P g) → ℂ)
    (f : PhysicalAuxLabels P C → CleanFullMemoryState P J ell B → ℂ)
    (hf : ∀ aux, ProductMemorySymmetric (f aux))
    (x : CleanFullMemoryState P J ell B) :
    let τ := fullActivePermutation (cleanPhysicalSlotChange C)
    let y := τ x
    let Sp := fun g => physicalFullSharedIndices (ell := ell) (C g)
    let Sc := cleanFullSharedSlots (ell := ell) C
    let cp := (productActiveMemorySplit Sp B y).1
    let sp := (productActiveMemorySplit Sp B y).2
    let cc := (productActiveMemorySplit Sc B x).1
    let sc := (productActiveMemorySplit Sc B x).2
    (∑ e : FullActiveEdgeEvent (fun g (p : P g) => p.val) Sp B
        (fun _ => PhysicalAuxLabels P C) (physicalMixedEdgeDelta C k d) (physicalMixedEdgeD C d) y,
      (fullActiveEdgeEventWeight (fun g (p : P g) => p.val) Sp B
        (fun _ => PhysicalAuxLabels P C) (physicalMixedEdgeDelta C k d) (physicalMixedEdgeD C d)
        (fun _ => ω) μ ρ V y e : ℂ) *
      (if (∀ g, (e.2 g).1 = ∅ ∧ (e.2 g).2.1 = ∅) ∧
          (∀ g i, (e.2 g).2.2.2 i ∉ initial g) then
        Θ e.1 (physicalCleanFreshEquiv (fun g => ↥(P g)) C (fun g =>
          (unrestrictedJointEventTarget (fun g (p : P g) => p.val)
            (physicalMixedEdgeDelta C k d cp e.1) (physicalMixedEdgeD C d cp e.1)
            (fun g => (Sp g)ᶜ.card) B sp e.2 g).1)) else 0) *
      f e.1 (τ.symm (fullActiveEdgeEventTarget (fun g (p : P g) => p.val) Sp B
        (fun _ => PhysicalAuxLabels P C) (physicalMixedEdgeDelta C k d) (physicalMixedEdgeD C d) y e))) =
    ∑ e : FullActiveEdgeEvent (fun g (p : P g) => p.val) Sc B
        (fun _ => PhysicalAuxLabels P C) (canonicalMixedEdgeDelta C k d) (canonicalMixedEdgeD C d) x,
      (fullActiveEdgeEventWeight (fun g (p : P g) => p.val) Sc B
        (fun _ => PhysicalAuxLabels P C) (canonicalMixedEdgeDelta C k d) (canonicalMixedEdgeD C d)
        (fun _ => ω) μ ρ V x e : ℂ) *
      (if (∀ g, (e.2 g).1 = ∅ ∧ (e.2 g).2.1 = ∅) ∧
          (∀ g i, (e.2 g).2.2.2 i ∉ initial g) then
        Θ e.1 (fun g => (unrestrictedJointEventTarget (fun g (p : P g) => p.val)
          (canonicalMixedEdgeDelta C k d cc e.1) (canonicalMixedEdgeD C d cc e.1)
          (fun g => (Sc g)ᶜ.card) B sc e.2 g).1) else 0) *
      f e.1 (fullActiveEdgeEventTarget (fun g (p : P g) => p.val) Sc B
        (fun _ => PhysicalAuxLabels P C) (canonicalMixedEdgeDelta C k d) (canonicalMixedEdgeD C d) x e) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  intro τ y Sp Sc cp sp cc sc
  have h := physical_mixed_clean_event_sum_reencode C k d ω μ ρ V
    (fun a fresh => if ∀ g i, fresh g i ∉ initial g then Θ a fresh else 0) f hf x
  dsimp only at h
  refine Eq.trans ?_ (h.trans ?_)
  · apply sum_congr
    · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
    · intro e _
      congr 1
      congr 1
      convert (physical_clean_initial_event_gate initial C
        (physicalMixedEdgeDelta C k d cp e.1) (physicalMixedEdgeD C d cp e.1) sp e.2 (Θ e.1 (physicalCleanFreshEquiv (fun g => ↥(P g)) C (fun g =>
          (unrestrictedJointEventTarget (fun g (p : P g) => p.val)
            (physicalMixedEdgeDelta C k d cp e.1) (physicalMixedEdgeD C d cp e.1)
            (fun g => (Sp g)ᶜ.card) B sp e.2 g).1)))).symm using 1 <;> congr 2
  · apply sum_congr
    · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
    · intro e _
      congr 1
      congr 1
      by_cases he : ∀ g, (e.2 g).1 = ∅ ∧ (e.2 g).2.1 = ∅
      · rw [if_pos he]
        have hi : (∀ g i, (unrestrictedJointEventTarget (fun g (p : P g) => p.val)
            (canonicalMixedEdgeDelta C k d cc e.1) (canonicalMixedEdgeD C d cc e.1)
            (fun g => (Sc g)ᶜ.card) B sc e.2 g).1 i ∉ initial g) ↔
              ∀ g i, (e.2 g).2.2.2 i ∉ initial g :=
          forall_congr' fun g => unrestricted_clean_fresh_allowed (initial g)
            (fun p : P g => p.val) (canonicalMixedEdgeDelta C k d cc e.1 g)
            (canonicalMixedEdgeD C d cc e.1 g) _ B (sc g) (e.2 g) (he g)
        by_cases ha : ∀ g i, (e.2 g).2.2.2 i ∉ initial g
        · rw [if_pos (hi.mpr ha), if_pos ⟨he, ha⟩]
        · rw [if_neg (mt hi.mp ha), if_neg (not_and_of_not_right _ ha)]
      · simp only [he, false_and, ↓reduceIte]

end Bounty
end

section

/- Exact character averages for all shifts in the finite off-diagonal energy. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

noncomputable def typeIICharacterAverage (E N M H Z : Finset ℕ)
    (k : ℤ) [NeZero (2 * k.natAbs)] (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ) : ℂ :=
  (1 / ((2 * k.natAbs).totient : ℂ)) *
    ∑ χ : DirichletCharacter ℂ (2 * k.natAbs),
      ∑ y ∈ typeIIFreeDeterminantSlice E N M H Z k,
        typeIIShiftComplexWeight η α aH y * χ (y.2.1.1 : ZMod (2 * k.natAbs)) *
          conj (χ (y.2.2.1 : ZMod (2 * k.natAbs)))

noncomputable def typeIICharacterSlice (E N M H Z : Finset ℕ)
    (k : ℤ) (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ) : ℂ :=
  if hk : k = 0 then 0 else
    @typeIICharacterAverage E N M H Z k
      ⟨by simpa only [ne_eq, mul_eq_zero, OfNat.ofNat_ne_zero, false_or,
        Int.natAbs_eq_zero] using hk⟩ η α aH

theorem typeII_determinant_sum_slices (E N M H : Finset ℕ)
    (K : Finset ℤ) (Z : Finset ℕ) (f : TypeIIShiftIndex → ℝ) :
    (∑ y ∈ typeIIDeterminantDomain E N M H K Z, f y) =
      ∑ k ∈ K, ∑ y ∈ typeIIDeterminantDomain E N M H {k} Z, f y := by
  classical
  simp only [typeIIDeterminantDomain, sum_filter, sum_product, sum_singleton]

theorem typeII_zero_determinant_slice (E N M H Z : Finset ℕ) :
    typeIIDeterminantDomain E N M H {0} Z = ∅ := by
  classical
  apply filter_eq_empty_iff.mpr
  intro y hy hc
  have hk : y.1.1 = 0 := mem_singleton.mp (mem_product.mp (mem_product.mp hy).1).1
  exact hc.2.1 hk

theorem typeII_rough_character_slice_eq (E N M H Z : Finset ℕ)
    (k : ℤ) (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ)
    {W : ℝ} (hW : 2 ≤ W) (hM : ∀ m ∈ M, 0 < m)
    (hrough : ∀ m ∈ M, ∀ p ∈ m.primeFactors, W < (p : ℝ))
    (hsmall : (k.natAbs : ℝ) ≤ W) :
    (∑ y ∈ typeIIDeterminantDomain E N M H {k} Z, typeIIShiftWeight η α aH y) =
      (typeIICharacterSlice E N M H Z k η α aH).re := by
  classical
  by_cases hk : k = 0
  · subst k
    rw [typeII_zero_determinant_slice]
    simp [typeIICharacterSlice]
  · rw [typeIICharacterSlice, dif_neg hk]
    exact @typeII_rough_determinant_slice_characters E N M H Z k
      ⟨by simpa only [ne_eq, mul_eq_zero, OfNat.ofNat_ne_zero, false_or,
        Int.natAbs_eq_zero] using hk⟩ η α aH W hW hM hrough hsmall

theorem typeII_off_diagonal_energy_eq_character_slices (E N M H : Finset ℕ)
    (K : Finset ℤ) (Z : Finset ℕ) (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ)
    {W : ℝ} (hW : 2 ≤ W) (hM : ∀ m ∈ M, 0 < m)
    (hrough : ∀ m ∈ M, ∀ p ∈ m.primeFactors, W < (p : ℝ))
    (hsmall : ∀ k ∈ K, |(k : ℝ)| ≤ W)
    (hK : ∀ x ∈ typeIIOffDiagonalSupport E N M H, (typeIIShiftMap x).1.1 ∈ K)
    (hZ : ∀ x ∈ typeIIOffDiagonalSupport E N M H, (typeIIShiftMap x).1.2 ∈ Z) :
    typeIIOffDiagonalEnergy E N M H η α aH =
      ∑ k ∈ K, (typeIICharacterSlice E N M H Z k η α aH).re := by
  rw [typeII_off_diagonal_energy_eq_determinant_sum E N M H K Z η α aH hrough hsmall hK hZ,
    typeII_determinant_sum_slices]
  apply sum_congr rfl
  intro k hk
  apply typeII_rough_character_slice_eq E N M H Z k η α aH hW hM hrough
  have habs : (k.natAbs : ℝ) = |(k : ℝ)| := by
    simpa only [Int.cast_abs, Int.cast_natCast] using
      congrArg (fun z : ℤ => (z : ℝ)) (Int.natCast_natAbs k)
  rw [habs]
  exact hsmall k hk

theorem typeII_shift_weight_character_twist {q : ℕ}
    (χ : DirichletCharacter ℂ q) (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ)
    (y : TypeIIShiftIndex) :
    typeIIShiftComplexWeight η (fun m => α m * χ (m : ZMod q)) aH y =
      typeIIShiftComplexWeight η α aH y * χ (y.2.1.1 : ZMod q) *
        conj (χ (y.2.2.1 : ZMod q)) := by
  simp only [typeIIShiftComplexWeight, map_mul]
  ring

theorem typeII_off_diagonal_energy_eq_bounded_character_slices
    (E N M H : Finset ℕ) (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ)
    {Elo U W : ℝ} {B : ℕ}
    (hElo : 0 < Elo) (hE : ∀ e ∈ E, Elo ≤ (e : ℝ))
    (hMpos : ∀ m ∈ M, 0 < m) (hM : ∀ m ∈ M, (m : ℝ) ≤ U)
    (hB : U / (2 * Elo) ≤ B) (hBW : (B : ℝ) ≤ W) (hW : 2 ≤ W)
    (hrough : ∀ m ∈ M, α m ≠ 0 → ∀ p ∈ m.primeFactors, W < (p : ℝ)) :
    typeIIOffDiagonalEnergy E N M H η α aH =
      ∑ k ∈ Icc (-(B : ℤ)) B,
        (typeIICharacterSlice E N (M.filter (fun m => α m ≠ 0)) H
          (Icc 0 ((M.filter (fun m => α m ≠ 0)).sup id * H.sup id)) k η α aH).re := by
  classical
  rw [typeII_off_diagonal_energy_restrict_support]
  apply typeII_off_diagonal_energy_eq_character_slices _ _ _ _ _ _ _ _ _ hW
  · intro m hm
    exact hMpos m (mem_filter.mp hm).1
  · intro m hm
    exact hrough m (mem_filter.mp hm).1 (mem_filter.mp hm).2
  · intro k hk
    have hi : |k| ≤ (B : ℤ) := abs_le.mpr (mem_Icc.mp hk)
    have hr : |(k : ℝ)| ≤ (B : ℝ) := by exact_mod_cast hi
    exact hr.trans hBW
  · intro x hx
    exact typeII_determinant_interval_coverage hElo hE
      (fun m hm => hM m (mem_filter.mp hm).1) hB hx
  · intro x hx
    exact typeII_cross_product_interval_coverage hx

end Bounty

end

section

/- Actual cap truncation on the genuine mixed state, including moving small
labels and residues. The only symmetry assumption is on the terminal test's
big pending-memory coordinates. All path masks remain inside the phase. -/
open Finset Classical
namespace Bounty

theorem exists_physical_small_big_cap_difference_energy_bound
    {qsmall vs : ℝ} (hq0 : 0 ≤ qsmall) (hq1 : qsmall < 1) (hvs : 0 < vs) (ell : ℕ) :
    ∃ Ccond : ℝ, 1 ≤ Ccond ∧ ∀ (H K S G : Type) [Fintype S] [DecidableEq S]
      [Fintype G] [DecidableEq G]
      (Ps : S → Finset ℕ) [∀ p : PhysicalPrime Ps, NeZero p.2.val]
      (P : G → Type) [∀ g, Fintype (P g)] (n : ∀ g, P g → ℕ)
      [∀ g p, NeZero (n g p)] (J : ℕ) (M : G → ℕ)
      (shared : K → ∀ g, Finset (Fin (M g))) (b B : ℕ) (h : b ≤ B)
      (A : K → Type) [∀ k, Fintype (A k)]
      (Δ D : ∀ k, PhysicalSharedLists Ps J → SharedActiveLabels P (shared k) → A k → G → ℤ)
      (kbig : ∀ k, SharedActiveLabels P (shared k) → A k → ℤ)
      (ω : ∀ k, A k → ℝ) (μ : ∀ g, P g → ℝ) (qghost : H → ℝ) (ρ : ℝ)
      (V : G → ℝ) (Vs : S → ℝ), (∀ s, vs ≤ Vs s) →
      (∀ k a, 0 ≤ ω k a) → (∀ k, ∑ a, ω k a ≤ 1) →
      ∀ (v vmin vmax : ℝ), 0 < ρ → ρ < 1 → 1 < v → 0 < vmin →
      (∀ g, vmin ≤ V g) → (∀ g, V g ≤ vmax) →
      (∀ g p, 0 < μ g p) → (∀ g, ∑ p, μ g p ≤ 2) →
      (∀ j, 0 ≤ qghost j) → (∀ j, qghost j ≤ 1) →
      (∀ j, qghost j / ρ ^ 2 + ((1 - qghost j) / ρ) / v ≤ 1) →
      (∀ j g, qghost j / ρ ^ 2 + ((1 - qghost j) * (2 * V g) / ρ) / v ≤ 1) →
      ∀ (T : ℕ), (∀ k g, (shared k g)ᶜ.card ≤ T) →
      ∀ (steps : List (Option (H ⊕ K))) (I : ℕ), I ≤ b →
      ∀ (phase : ∀ s, PhysicalSmallBigPath (ell := ell) n shared B A Δ D kbig steps s → ℂ),
      (∀ s p, ‖phase s p‖ ≤ 1) →
      ∀ (f : PhysicalSmallBigState Ps J ell
        (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ),
      (∀ s, ProductMemorySymmetric (fun x => f (s, x))) →
      physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
        (fun s : PhysicalSmallBigState Ps J ell
          (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b) =>
          if productTotalMemory s.2 ≤ I then
            physicalSmallBigPathAction n shared B A Δ D kbig ω μ qghost ρ V Vs qsmall
              steps phase f (physicalSmallBigCapEmbed h s) -
            physicalSmallBigPathAction n shared b A Δ D kbig ω μ qghost ρ V Vs qsmall steps
              (physicalSmallBigCapPhase n shared A Δ D h kbig ω μ qghost ρ V Vs qsmall steps phase)
              (fun x => f (physicalSmallBigCapEmbed h x)) s
          else 0) ≤
        ((2 : ℝ) ^ (b + 1 - I - fullMemoryEdgeCount steps * (T * Fintype.card G)))⁻¹ ^ 2 *
        (steps.map (physicalSmallBigPathStepEnergy Ccond ρ v vmin vmax (2 * vmax)
          T (Fintype.card S) (Fintype.card G))).prod *
        physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  obtain ⟨Ccond, hCcond, henergy⟩ := exists_physical_small_big_path_energy_bound hq0 hq1 hvs ell
  refine ⟨Ccond, hCcond, ?_⟩
  intro H K S G _ dS _ dG
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  intro Ps _ P _ n _ J M shared b B h A _ Δ D kbig ω μ qghost ρ V Vs hVs
    hω hωmass v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass
    hqg0 hqg1 hD hC T ht steps I hIb phase hphase f hf
  have hVs0 : ∀ s, 0 < Vs s := fun s => hvs.trans_le (hVs s)
  let r := b + 1 - I - fullMemoryEdgeCount steps * (T * Fintype.card G)
  let allowed : ∀ s, PhysicalSmallBigPath (ell := ell) n shared B A Δ D kbig steps s → Prop := fun s p => productTotalMemory s.2 ≤ I ∧
    b < physicalSmallBigPathPeak n shared B A Δ D kbig steps s p
  have hallowed : ∀ s p, allowed s p →
      r ≤ physicalSmallBigPathBirthCount n shared B A Δ D kbig steps s p := by
    intro s p hp
    have hg := physical_small_big_path_exceeds_implies_births n shared B A Δ D kbig T ht steps s p b hp.2
    dsimp only [allowed] at hp
    dsimp only [r]
    omega
  let χ := fun s p => countTailPhase 2 r
    (physicalSmallBigPathBirthCount n shared B A Δ D kbig steps s p)
    (if allowed s p then phase s p else 0)
  have hχ : ∀ s p, ‖χ s p‖ ≤ 1 := by
    intro s p
    apply countTailPhase_norm_le_one (by norm_num)
    split_ifs
    · exact hphase s p
    · simp only [norm_zero, zero_le_one]
  have he := henergy H K S G Ps P n J M shared B A Δ D kbig ω μ qghost ρ
    V (fun g => 2 * V g) Vs hVs hω hωmass v vmin vmax (2 * vmax)
    hρ0 hρ1 hv hvmin hVlo hVhi
    (fun g => mul_nonneg (by norm_num) (hvmin.trans_le (hVlo g)).le)
    (fun g => mul_le_mul_of_nonneg_left (hVhi g) (by norm_num))
    hμ hmass hqg0 hqg1 hD hC T ht steps χ hχ f hf
  have heq : physicalSmallBigPathAction n shared B A Δ D kbig ω μ qghost ρ V Vs qsmall steps
      (fun s p => if allowed s p then phase s p else 0) f =
      fun s => ((((2 : ℝ) ^ r)⁻¹ : ℝ) : ℂ) *
        physicalSmallBigPathVaryingGhostAction n shared B A Δ D kbig ω μ qghost ρ
          V (fun g => 2 * V g) Vs qsmall steps χ f s := by
    funext s
    have hh := physical_small_big_birth_tail_action n shared B A Δ D kbig ω μ qghost ρ V Vs qsmall
      steps allowed phase 2 (by norm_num) r hallowed f s
    convert hh using 1
    · apply congrArg (fun ψ => physicalSmallBigPathAction n shared B A Δ D kbig ω μ qghost ρ
        V Vs qsmall steps ψ f s)
      funext y p
      split_ifs <;> rfl
    · apply congrArg (fun ψ => ((((2 : ℝ) ^ r)⁻¹ : ℝ) : ℂ) *
        physicalSmallBigPathVaryingGhostAction n shared B A Δ D kbig ω μ qghost ρ
          V (fun g => 2 * V g) Vs qsmall steps ψ f s)
      funext y p
      dsimp only [χ]
      split_ifs <;> rfl
  have htail : physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (physicalSmallBigPathAction n shared B A Δ D kbig ω μ qghost ρ V Vs qsmall steps
        (fun s p => if allowed s p then phase s p else 0) f) ≤
      ((2 : ℝ) ^ r)⁻¹ ^ 2 *
        (steps.map (physicalSmallBigPathStepEnergy Ccond ρ v vmin vmax (2 * vmax)
          T (Fintype.card S) (Fintype.card G))).prod *
        physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
    rw [heq, ← physical_small_big_energy_eq, finiteWeightedEnergy_const_mul,
      physical_small_big_energy_eq]
    have hc : ‖((((2 : ℝ) ^ r)⁻¹ : ℝ) : ℂ)‖ = ((2 : ℝ) ^ r)⁻¹ := by
      rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    rw [hc, mul_assoc]
    exact mul_le_mul_of_nonneg_left he (sq_nonneg _)
  have hdiff :
      (fun s : PhysicalSmallBigState Ps J ell
        (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b) =>
        if productTotalMemory s.2 ≤ I then
          physicalSmallBigPathAction n shared B A Δ D kbig ω μ qghost ρ V Vs qsmall steps phase f
              (physicalSmallBigCapEmbed h s) -
          physicalSmallBigPathAction n shared b A Δ D kbig ω μ qghost ρ V Vs qsmall steps
            (physicalSmallBigCapPhase n shared A Δ D h kbig ω μ qghost ρ V Vs qsmall steps phase)
            (fun x => f (physicalSmallBigCapEmbed h x)) s
        else 0) =
      (fun s => physicalSmallBigPathAction n shared B A Δ D kbig ω μ qghost ρ V Vs qsmall steps
        (fun y p => if allowed y p then phase y p else 0) f (physicalSmallBigCapEmbed h s)) := by
    funext s
    exact physical_small_big_cap_difference_mask n shared A Δ D h kbig ω μ qghost ρ V Vs qsmall
      steps phase f I hIb s
  rw [hdiff]
  exact (physical_small_big_cap_pullback_energy_le h Vs hVs0 μ
    (fun g => unrestrictedResidueWeight (μ g)) (fun g p => (hμ g p).le)
    (fun g z => (hμ g z.1).le) _).trans htail

end Bounty
end

section

/- Fold the full original P-weight inside the exact separated allocation integral. -/

open Finset Filter MeasureTheory

namespace Bounty

noncomputable def candidateRetainedAllocationSupport (c L : ℝ) (r jStar : ℕ)
    (S : Finset ℕ) (take : Fin ((candidateQIndices c L).card*r) → Bool) : Finset ℕ :=
  (S ×ˢ orderedSlotProductSupport
    (fun slot : CandidateRemainingSlot c L r take => candidateQSlotChoices c L r jStar slot.val)).image
      (fun z => z.1*z.2)

noncomputable def candidateRetainedAllocationIntegrand (c L q : ℝ) (r jStar : ℕ)
    (R : ℝ) (S : Finset ℕ) (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (F : ℕ → ℕ → ℂ)
    (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ) : ℂ :=
  candidateAllocationFourierScalar c L r jStar R ξ *
    (∑ e ∈ orderedSlotProductSupport
      (fun slot : CandidateTakenSlot c L r take => candidateQSlotChoices c L r jStar slot.val),
    ∑ h ∈ candidateRetainedAllocationSupport c L r jStar S take,
      candidateTakenComplexCoefficient c L r jStar take
        (candidateAllocationFourierTwist c L r jStar take ξ) e *
      candidateRetainedComplexCoefficient c L q r jStar take
        (candidateAllocationFourierTwist c L r jStar take ξ) h * F e h) *
    activeAllocationFourierWeight (candidateAllocationRadius r)
      (candidateAllocationActive c L r jStar) take ξ

theorem eventually_candidate_full_P_separated_convolution {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ) (S : Finset ℕ)
      (take : Fin ((candidateQIndices c L).card*r) → Bool)
      (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ),
      (∀ p ∈ S, p ∈ Nat.factoredNumbers
        ((candidatePIndices c L).biUnion (candidatePBand (c*L)))) →
      ∀ F : ℕ → ℕ → ℂ,
      (∑ p ∈ S, (candidatePWeight c L q p : ℂ) *
        ∑ e ∈ orderedSlotProductSupport
          (fun slot : CandidateTakenSlot c L r take => candidateQSlotChoices c L r jStar slot.val),
        ∑ n ∈ orderedSlotProductSupport
          (fun slot : CandidateRemainingSlot c L r take => candidateQSlotChoices c L r jStar slot.val),
          candidateTakenComplexCoefficient c L r jStar take twist e *
            candidateRemainingComplexCoefficient c L r jStar take twist n * F e (p*n)) =
      ∑ e ∈ orderedSlotProductSupport
        (fun slot : CandidateTakenSlot c L r take => candidateQSlotChoices c L r jStar slot.val),
      ∑ h ∈ candidateRetainedAllocationSupport c L r jStar S take,
        candidateTakenComplexCoefficient c L r jStar take twist e *
          candidateRetainedComplexCoefficient c L q r jStar take twist h * F e h := by
  filter_upwards [eventually_candidate_retained_convolution hc] with L hL
  intro q r jStar S take twist hS F
  simp_rw [mul_sum]
  rw [sum_comm]
  apply sum_congr rfl
  intro e he
  have h := hL q r jStar take twist S hS (F e)
  have hmul := congrArg
    (fun z => candidateTakenComplexCoefficient c L r jStar take twist e * z) h
  simpa only [mul_sum, candidateRetainedAllocationSupport, mul_assoc, mul_left_comm, mul_comm]
    using hmul

theorem eventually_candidate_retained_allocation_integrand_eq {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ) (R : ℝ) (S : Finset ℕ)
      (take : Fin ((candidateQIndices c L).card*r) → Bool),
      (∀ p ∈ S, p ∈ Nat.factoredNumbers
        ((candidatePIndices c L).biUnion (candidatePBand (c*L)))) →
      ∀ (F : ℕ → ℕ → ℂ)
        (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ),
      candidateFullPAllocationIntegrand c L q r jStar R S take F ξ =
        candidateRetainedAllocationIntegrand c L q r jStar R S take F ξ := by
  filter_upwards [eventually_candidate_full_P_separated_convolution hc] with L hL
  intro q r jStar R S take hS F ξ
  unfold candidateFullPAllocationIntegrand candidateSeparatedAllocationIntegrand
    candidateRetainedAllocationIntegrand
  rw [← hL q r jStar S take (candidateAllocationFourierTwist c L r jStar take ξ) hS F]
  simp only [sum_mul, mul_sum]
  apply sum_congr rfl
  intro p hp
  apply sum_congr rfl
  intro e he
  apply sum_congr rfl
  intro n hn
  ring

theorem eventually_candidate_retained_allocation_integrable {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ) (R : ℝ) (S : Finset ℕ)
      (take : Fin ((candidateQIndices c L).card*r) → Bool),
      (∀ p ∈ S, p ∈ Nat.factoredNumbers
        ((candidatePIndices c L).biUnion (candidatePBand (c*L)))) →
      ∀ F : ℕ → ℕ → ℂ,
      Integrable (candidateRetainedAllocationIntegrand c L q r jStar R S take F) := by
  filter_upwards [eventually_candidate_retained_allocation_integrand_eq hc] with L hL
  intro q r jStar R S take hS F
  apply (candidate_full_P_allocation_integrable c L q r jStar R S take F).congr
  exact Filter.Eventually.of_forall (hL q r jStar R S take hS F)

end Bounty
end

section

/- Removing integer quotient guards using the support of the actual real cutoff. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

theorem typeII_smooth_cutoff_guard_removal {y : TypeIIShiftIndex}
    (E N : Finset ℕ) (η : ℝ → ℝ → ℝ)
    (hm : 0 < y.2.1.1) (hm' : 0 < y.2.2.1) (hk : y.1.1 ≠ 0)
    (hz : y.1.2 = y.2.2.1 * y.2.1.2)
    (hcross : (y.1.2 : ℤ) + y.1.1 = (y.2.1.1 : ℤ) * y.2.2.2)
    (hc : IsCoprime (y.2.1.1 : ℤ) y.1.1)
    (hmod : Int.ModEq (2 * |y.1.1|) (y.2.1.1 : ℤ) (y.2.2.1 : ℤ))
    (hpos : ∀ e n, η e n ≠ 0 → 0 < e)
    (hmem : ∀ e n : ℕ, η e n ≠ 0 → e ∈ E ∧ n ∈ N) :
    (if 0 < typeIIRecoveredE y ∧ 0 < typeIIRecoveredN y ∧
        (typeIIRecoveredE y).toNat ∈ E ∧ (typeIIRecoveredN y).toNat ∈ N
      then η (typeIIRecoveredE y).toNat (typeIIRecoveredN y).toNat else 0) =
        η (typeIIRealE y) (typeIIRealN y) := by
  classical
  by_cases he : 0 < typeIIRealE y
  · obtain ⟨hE, hN, hEr, hNr⟩ :=
      typeII_positive_real_reconstruction hm hm' hk hz hcross hc hmod he
    by_cases hη : η (typeIIRealE y) (typeIIRealN y) = 0
    · simp [hEr, hNr, hη]
    · have hη' : η (typeIIRecoveredE y).toNat (typeIIRecoveredN y).toNat ≠ 0 := by
        rwa [hEr, hNr]
      obtain ⟨hmE, hmN⟩ := hmem _ _ hη'
      simp [hE, hN, hmE, hmN, hEr, hNr]
  · have hE : ¬ 0 < typeIIRecoveredE y := by
      intro hp
      apply he
      rw [← typeII_recovered_e_real_of_congruence hmod]
      exact_mod_cast hp
    have hη : η (typeIIRealE y) (typeIIRealN y) = 0 := by
      by_contra hne
      exact he (hpos _ _ hne)
    simp [hE, hη]

def TypeIICrossConditions (y : TypeIIShiftIndex) : Prop :=
  0 < y.2.1.1 ∧ y.1.1 ≠ 0 ∧ y.1.2 = y.2.2.1 * y.2.1.2 ∧
    (y.1.2 : ℤ) + y.1.1 = (y.2.1.1 : ℤ) * y.2.2.2

noncomputable def typeIICrossSlice (M H Z : Finset ℕ) (k : ℤ) : Finset TypeIIShiftIndex := by
  classical
  exact ((({k} : Finset ℤ) ×ˢ Z) ×ˢ ((M ×ˢ H) ×ˢ (M ×ˢ H))).filter
    TypeIICrossConditions

noncomputable def typeIIRealShiftWeight (η : ℝ → ℝ → ℝ) (α aH : ℕ → ℂ)
    (y : TypeIIShiftIndex) : ℂ :=
  (η (typeIIRealE y) (typeIIRealN y) : ℂ) *
    (α y.2.1.1 * conj (α y.2.2.1) * aH y.2.1.2 * conj (aH y.2.2.2))

theorem typeII_smooth_shift_pointwise {y : TypeIIShiftIndex}
    (E N : Finset ℕ) (η : ℝ → ℝ → ℝ) (α aH : ℕ → ℂ)
    (hm' : 0 < y.2.2.1) {W : ℝ}
    (hrough : ∀ p ∈ y.2.1.1.primeFactors, W < (p : ℝ))
    (hsmall : |(y.1.1 : ℝ)| ≤ W)
    (hpos : ∀ e n, η e n ≠ 0 → 0 < e)
    (hmem : ∀ e n : ℕ, η e n ≠ 0 → e ∈ E ∧ n ∈ N) : by
  classical
  exact (if TypeIIShiftConditions E N y then
      typeIIShiftComplexWeight (fun e n => η e n) α aH y else 0) =
    (if TypeIICrossConditions y ∧ Nat.ModEq (2 * y.1.1.natAbs) y.2.1.1 y.2.2.1
      then typeIIRealShiftWeight η α aH y else 0) := by
  classical
  by_cases hcross : TypeIICrossConditions y
  · obtain ⟨hm, hk, hz, hcross⟩ := hcross
    by_cases hmod : Int.ModEq (2 * |y.1.1|) (y.2.1.1 : ℤ) (y.2.2.1 : ℤ)
    · have hnmod := (typeII_signed_congruence_iff (k := y.1.1) (m := y.2.1.1) (m' := y.2.2.1)).mp hmod
      have hc := typeII_rough_coprime_determinant hm hk hrough hsmall
      have hg := typeII_smooth_cutoff_guard_removal E N η hm hm' hk hz hcross hc hmod hpos hmem
      have hcc : TypeIICrossConditions y := ⟨hm, hk, hz, hcross⟩
      have hs : TypeIIShiftConditions E N y ↔
          0 < typeIIRecoveredE y ∧ 0 < typeIIRecoveredN y ∧
            (typeIIRecoveredE y).toNat ∈ E ∧ (typeIIRecoveredN y).toNat ∈ N := by
        unfold TypeIIShiftConditions
        tauto
      rw [if_pos (show TypeIICrossConditions y ∧
        Nat.ModEq (2 * y.1.1.natAbs) y.2.1.1 y.2.2.1 from ⟨hcc, hnmod⟩)]
      simp only [hs, typeIIShiftComplexWeight, typeIIRealShiftWeight]
      rw [← hg]
      split_ifs <;> simp
    · have hnmod := mt (typeII_signed_congruence_iff (k := y.1.1) (m := y.2.1.1) (m' := y.2.2.1)).mpr hmod
      simp [TypeIIShiftConditions, TypeIICrossConditions, hmod, hnmod]
  · have hc : ¬ TypeIIShiftConditions E N y := by
      intro h
      exact hcross ⟨h.1, h.2.1, h.2.2.1, h.2.2.2.1⟩
    simp [hc, hcross]

end Bounty
end

section

/- All actual allocation patterns may be truncated before Cauchy, at arbitrary logarithmic saving. -/

open Finset Filter Real

namespace Bounty

theorem eventually_candidate_allocation_box_error {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1) (A D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (jStar : ℕ) (E : ℝ) (F : ℕ → ℕ → ℂ),
      (∀ u ∈ arithmeticProductWindow 1 (exp L), ∀ m ∈ (2*u+1).divisors, ‖F u m‖ ≤ L^A) →
      ‖(∑ u ∈ arithmeticProductWindow 1 (exp L),
          (candidateCompactRangeCoefficient c L q r jStar E u : ℂ)*
            ∑ m ∈ (2*u+1).divisors, F u m) -
        ∑ u ∈ arithmeticProductWindow 1 (exp L),
          candidateBoxRangeCoefficient c L q r jStar E L u*
            ∑ m ∈ (2*u+1).divisors, F u m‖ ≤ exp L*L^(-D) := by
  obtain ⟨B,hB,hmass⟩ := exists_candidate_divisor_test_absolute_bound hc hr hq0 hq1 A
  obtain ⟨C,hC,hL1,hdecay⟩ := active_allocation_fourier_bounds (candidateAllocationRadius r)
  obtain ⟨M,hM⟩ := exists_candidate_truncation_order hc hC r (D+B)
  obtain ⟨CM,hCM,htrunc⟩ := hdecay M
  filter_upwards [hmass, hM M le_rfl CM hCM.le, eventually_ge_atTop (1 : ℝ)]
    with L hmassL hcost hL
  intro jStar E F hF
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  let N := (candidateQIndices c L).card*r
  let err : ℝ := N*CM*C^(N-1)*L^(-(M : ℝ))
  have herr : 0 ≤ err := by dsimp [err]; positivity
  have hall : 0 ≤ (2 : ℝ)^N*err := mul_nonneg (by positivity) herr
  have hsingle (x : ∀ slot, candidateQSlotChoices c L r jStar slot) :
      ‖(candidateRangeAllocationMass c L r jStar x E : ℂ) -
        candidateBoxRangeAllocationMass c L r jStar x E L‖ ≤ (2 : ℝ)^N*err := by
    apply candidate_range_box_error c L r jStar x E L herr
    intro take hkeep
    exact htrunc _ (log E) _ _ _ take hkeep L hL
  have hcost' : (2 : ℝ)^N*err ≤ L^(-(D+B)) := by
    convert hcost using 1
    dsimp [N,err]
    ring
  have hbound := norm_fiber_coefficient_error_le (arithmeticProductWindow 1 (exp L))
    (fun u => (2*u+1).divisors) (candidateCoefficient c L q r jStar)
    (fun u => (candidateCompactRangeCoefficient c L q r jStar E u : ℂ))
    (candidateBoxRangeCoefficient c L q r jStar E L) F hall
    (fun u hu => candidate_coefficient_nonneg c L hq0 r jStar u)
    (fun u hu => candidate_box_coefficient_error c L hq0 r jStar E L u hsingle)
  calc
    _ ≤ ((2 : ℝ)^N*err)*(∑ u ∈ arithmeticProductWindow 1 (exp L),
        candidateCoefficient c L q r jStar u*∑ m ∈ (2*u+1).divisors, ‖F u m‖) := hbound
    _ ≤ L^(-(D+B))*(exp L*L^B) :=
      mul_le_mul hcost' (hmassL jStar F hF)
        (sum_nonneg (fun u hu => mul_nonneg (candidate_coefficient_nonneg c L hq0 r jStar u)
          (sum_nonneg (fun _ _ => norm_nonneg _)))) (rpow_nonneg hL0.le _)
    _ = exp L*L^(-D) := by
      rw [mul_left_comm, ← rpow_add hL0]
      congr 2
      ring

end Bounty
end

section

/- Exact full-P expansion of the actual box coefficient. -/

open Finset Filter

namespace Bounty

theorem candidate_box_Q_support (c L : ℝ) (r jStar : ℕ) (E R : ℝ) (n : ℕ)
    (hn : n ∉ orderedSlotProductSupport (candidateQSlotChoices c L r jStar)) :
    candidateBoxRangeQWeight c L r jStar E R n = 0 := by
  classical
  apply sum_eq_zero
  intro x hx
  apply if_neg
  intro he
  exact hn (mem_image.mpr ⟨x,mem_univ _,he⟩)

theorem eventually_candidate_box_convolution {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ) (E R : ℝ) (F : ℕ → ℂ),
      (∑ u ∈ arithmeticProductWindow 1 (Real.exp L),
        candidateBoxRangeCoefficient c L q r jStar E R u*F u) =
      ∑ p ∈ candidateSmallPSet c L (16*Real.exp L+1), (candidatePWeight c L q p : ℂ)*
        ∑ n ∈ orderedSlotProductSupport (candidateQSlotChoices c L r jStar),
          candidateBoxRangeQWeight c L r jStar E R n*
            (if p*n ∈ arithmeticProductWindow 1 (Real.exp L) then F (p*n) else 0) := by
  classical
  filter_upwards [eventually_candidate_P_pool_below_rough_cutoff hc,
    eventually_ge_atTop (0 : ℝ)] with L hpool hL
  intro q r jStar E R F
  let P := (candidatePIndices c L).biUnion (candidatePBand (c*L))
  let S := candidateSmallPSet c L (16*Real.exp L+1)
  let B := orderedSlotProductSupport (candidateQSlotChoices c L r jStar)
  let U := arithmeticProductWindow 1 (Real.exp L)
  let T := (S ×ˢ B).image (fun z => z.1*z.2)
  have hS : ∀ p ∈ S, p ∈ Nat.factoredNumbers P := fun p hp =>
    ((mem_candidateSmallPSet_iff c L _ p).mp hp).2
  have hB : ∀ n ∈ B, n ≠ 0 ∧ Disjoint n.primeFactors P := by
    intro n hn
    obtain ⟨x,hx,rfl⟩ := mem_image.mp hn
    exact ⟨prod_ne_zero_iff.mpr (fun slot _ =>
      candidate_Q_slot_nonzero c L r jStar slot (x slot).property),
      candidate_Q_tuple_primeFactors_disjoint (mul_nonneg hc.le hL) hpool x⟩
  have hreindex := supported_free_complex_product_reindex P S B hS hB
    (fun p => (candidatePWeight c L q p : ℂ)) (candidateBoxRangeQWeight c L r jStar E R)
    (fun u => if u ∈ U then F u else 0)
  symm
  calc
    _ = ∑ u ∈ T, (candidatePWeight c L q (primePoolPart P u) : ℂ)*
        candidateBoxRangeQWeight c L r jStar E R (primePoolFreePart P u)*
        (if u ∈ U then F u else 0) := by
      simp_rw [mul_sum, ← mul_assoc]
      exact hreindex
    _ = ∑ u ∈ T, candidateBoxRangeCoefficient c L q r jStar E R u*
        (if u ∈ U then F u else 0) := by
      apply sum_congr rfl
      intro u hu
      obtain ⟨pn,hpn,rfl⟩ := mem_image.mp hu
      obtain ⟨hp,hn⟩ := mem_product.mp hpn
      obtain ⟨hn0,hnfree⟩ := hB pn.2 hn
      have hp0 := Nat.ne_zero_of_mem_factoredNumbers (hS pn.1 hp)
      rw [primePoolPart_mul_of_free (hS _ hp) hn0 hnfree,
        primePoolFreePart_mul_of_free (hS _ hp) hn0 hnfree]
      unfold candidateBoxRangeCoefficient
      rw [candidate_marked_weight_mul_of_free c L q hn0 hnfree pn.1,
        primePoolFreePart_mul_of_free (hS _ hp) hn0 hnfree,
        candidate_P_weight_eq_marked c L q hp0]
      ring
    _ = ∑ u ∈ T.filter (fun u => u ∈ U), candidateBoxRangeCoefficient c L q r jStar E R u*F u := by
      rw [sum_filter]
      simp only [mul_ite, mul_zero]
    _ = ∑ u ∈ U.filter (fun u => u ∈ T), candidateBoxRangeCoefficient c L q r jStar E R u*F u := by
      congr 1
      ext u
      simp only [mem_filter, and_comm]
    _ = _ := by
      rw [sum_filter]
      apply sum_congr rfl
      intro u hu
      by_cases ht : u ∈ T
      · simp only [ht, if_true]
      · simp only [ht, if_false]
        have hnot : primePoolFreePart P u ∉ B := by
          intro hn
          have hurange : Real.exp L < (u : ℝ) ∧ (u : ℝ) ≤ 16*Real.exp L := by
            simpa only [one_mul] using (mem_arithmeticProductWindow_iff one_ne_zero (Real.exp L)).mp hu
          have hu0 : u ≠ 0 := by exact_mod_cast (Real.exp_pos L).trans hurange.1 |>.ne'
          have hpu : (primePoolPart P u : ℝ) ≤ (u : ℝ) := by
            exact_mod_cast Nat.le_of_dvd (Nat.pos_of_ne_zero hu0) (primePoolPart_dvd P u)
          have hp : primePoolPart P u ∈ S := by
            apply (mem_candidateSmallPSet_iff c L _ _).mpr
            exact ⟨by linarith [hurange.2],primePoolPart_mem_factoredNumbers P u⟩
          exact ht (mem_image.mpr ⟨(primePoolPart P u,primePoolFreePart P u),
            mem_product.mpr ⟨hp,hn⟩,primePoolPart_mul_primePoolFreePart P u⟩)
        have hz := candidate_box_Q_support c L r jStar E R (primePoolFreePart P u) hnot
        change 0 = candidateBoxRangeQWeight c L r jStar E R (primePoolFreePart P u) * _ * _
        rw [hz, zero_mul, zero_mul]

end Bounty
end

section

/- Exact finite summation of the three-variable majorant Fourier inversion. -/

open Finset MeasureTheory

namespace Bounty

noncomputable def typeIIFiniteCrossFourierIntegrand (A L U V E Z : ℝ) (k : ℤ)
    (S : Finset TypeIIShiftIndex) (ω : TypeIIShiftIndex → ℂ)
    (ξ : EuclideanSpace ℝ (Fin 3)) : ℂ :=
  typeIICrossFourierScale A L U V E Z k ξ *
    ∑ y ∈ S, ω y * typeIICrossFourierPowers y ξ

theorem finite_typeII_majorant_fourier_integral
    (A L U V E Z : ℝ) (k : ℤ) (S : Finset TypeIIShiftIndex) (ω : TypeIIShiftIndex → ℂ)
    (hU : 0 < U) (hV : 0 < V) (hZ : 0 < Z) (hk : k ≠ 0)
    (hgeometry : ∀ y ∈ S, ω y ≠ 0 → y.1.1 = k ∧
      0 < y.2.1.1 ∧ 0 < y.2.2.1 ∧ 0 < y.1.2 ∧
      ∀ i, typeIILogCoordinates ![(y.2.1.1:ℝ),(y.2.2.1:ℝ),(y.1.2:ℝ)] ![U,U,Z] i ∈
        Set.Icc (-A) A) :
    Integrable (typeIIFiniteCrossFourierIntegrand A L U V E Z k S ω) ∧
      (∑ y ∈ S, ω y * ((typeIIEMajorant (L^88) (typeIIRealE y/E) *
        typeIINMajorant (typeIIRealN y/V) : ℝ):ℂ)) =
        ∫ ξ : EuclideanSpace ℝ (Fin 3), typeIIFiniteCrossFourierIntegrand A L U V E Z k S ω ξ := by
  let f : TypeIIShiftIndex → EuclideanSpace ℝ (Fin 3) → ℂ :=
    fun y ξ => ω y * (typeIICrossFourierScale A L U V E Z k ξ * typeIICrossFourierPowers y ξ)
  have hf : ∀ y ∈ S, Integrable (f y) := by
    intro y hy
    by_cases hω : ω y = 0
    · simp only [f, hω, zero_mul]
      exact integrable_zero _ _ _
    · obtain ⟨_, hm, hm', hz, _⟩ := hgeometry y hy hω
      exact (typeII_cross_fourier_kernel_integrable A L U V E Z k y hU hZ hm hm' hz).const_mul (ω y)
  have heq (ξ : EuclideanSpace ℝ (Fin 3)) : (∑ y ∈ S, f y ξ) =
      typeIIFiniteCrossFourierIntegrand A L U V E Z k S ω ξ := by
    simp only [typeIIFiniteCrossFourierIntegrand, mul_sum, f]
    apply sum_congr rfl
    intro y hy
    ring
  refine ⟨(integrable_finsetSum (s := S) hf).congr (Filter.Eventually.of_forall heq), ?_⟩
  calc
    _ = ∑ y ∈ S, ∫ ξ : EuclideanSpace ℝ (Fin 3), f y ξ := by
      apply sum_congr rfl
      intro y hy
      by_cases hω : ω y = 0
      · simp only [f, hω, zero_mul, integral_zero]
      · obtain ⟨hyk, hm, hm', hz, hbox⟩ := hgeometry y hy hω
        rw [typeII_cross_majorant_fourier_inversion hU hV hZ hk hyk hm hm' hz hbox]
        exact (integral_const_mul _ _).symm
    _ = ∫ ξ : EuclideanSpace ℝ (Fin 3), ∑ y ∈ S, f y ξ := (integral_finsetSum (s := S) hf).symm
    _ = _ := integral_congr_ae (Filter.Eventually.of_forall heq)

end Bounty
end

section

/- The smooth diagonal bound depends on UV and coefficient bounds, not on the allocation scale E. -/

open Finset

namespace Bounty

theorem typeII_actual_smooth_diagonal (M H : Finset ℕ) (α aH : ℕ → ℂ)
    {L E U V A B : ℝ} (hL : 0 < L) (hE : 0 < E) (hU : 0 < U) (hV : 0 < V)
    (hMpos : ∀ m ∈ M, 0 < m) (hM : ∀ m ∈ M, (m : ℝ) ≤ 2 * U)
    (hH : ∀ h ∈ H, 0 < h) (hα : ∀ m ∈ M, ‖α m‖ ≤ A)
    (haH : ∀ h ∈ H, ‖aH h‖ ≤ B * (h.divisors.card : ℝ)) :
    let EF := Icc ⌈E / (2 * L ^ 88)⌉₊ ⌊2 * E⌋₊
    let NF := Icc ⌈V / 2⌉₊ ⌊3 * V⌋₊
    let η := fun e n : ℕ => typeIIEMajorant (L ^ 88) ((e : ℝ) / E) *
      typeIINMajorant ((n : ℝ) / V)
    typeIIDiagonalEnergy EF NF M H η α aH ≤
      A ^ 2 * B ^ 2 * (2 * (⌊6 * U * V⌋₊ : ℝ) * (1 + Real.log ⌊6 * U * V⌋₊) ^ 15) := by
  dsimp only
  let EF := Icc ⌈E / (2 * L ^ 88)⌉₊ ⌊2 * E⌋₊
  let NF := Icc ⌈V / 2⌉₊ ⌊3 * V⌋₊
  let η := fun e n : ℕ => typeIIEMajorant (L ^ 88) ((e : ℝ) / E) *
    typeIINMajorant ((n : ℝ) / V)
  have hEF : ∀ e ∈ EF, 0 < e := by
    intro e he
    have hlo := (Nat.le_ceil (E / (2 * L ^ 88))).trans
      (by exact_mod_cast (mem_Icc.mp he).1 : (⌈E / (2 * L ^ 88)⌉₊ : ℝ) ≤ e)
    have hp : (0 : ℝ) < e := lt_of_lt_of_le (by positivity) hlo
    exact_mod_cast hp
  have hNF : ∀ n ∈ NF, 0 < n := by
    intro n hn
    have hlo := (Nat.le_ceil (V / 2)).trans
      (by exact_mod_cast (mem_Icc.mp hn).1 : (⌈V / 2⌉₊ : ℝ) ≤ n)
    have hp : (0 : ℝ) < n := lt_of_lt_of_le (by positivity) hlo
    exact_mod_cast hp
  have hNupper : ∀ n ∈ NF, (n : ℝ) ≤ 3 * V := by
    intro n hn
    exact (by exact_mod_cast (mem_Icc.mp hn).2 : (n : ℝ) ≤ (⌊3 * V⌋₊ : ℝ)).trans
      (Nat.floor_le (by positivity))
  have hX : ∀ m ∈ M, ∀ n ∈ NF, m * n ≤ ⌊6 * U * V⌋₊ := by
    intro m hm n hn
    apply Nat.le_floor
    push_cast
    calc
      (m : ℝ) * n ≤ (2 * U) * (3 * V) :=
        mul_le_mul (hM m hm) (hNupper n hn) (Nat.cast_nonneg _) (by positivity)
      _ = 6 * U * V := by ring
  have hη : ∀ e ∈ EF, ∀ n ∈ NF, 0 ≤ η e n ∧ η e n ≤ 1 := by
    intro e _ n _
    have he := typeII_e_majorant_bounds (L ^ 88) ((e : ℝ) / E)
    have hn := typeII_n_majorant_bounds ((n : ℝ) / V)
    refine ⟨mul_nonneg he.1 hn.1, ?_⟩
    exact (mul_le_mul he.2 hn.2 hn.1 (by norm_num)).trans_eq (by norm_num)
  have hbound := typeII_diagonal_energy_bound EF NF M H ⌊6 * U * V⌋₊ η α aH
    (C := 1) (by norm_num) hEF hH hMpos hNF hX hη hα haH
  simpa only [one_mul] using hbound

end Bounty
end

section

/- Pointwise control of the complex truncated coefficient on every integer. -/

open Finset Filter Real

namespace Bounty

theorem eventually_candidate_box_pointwise_error {c : ℝ} (hc : 0 < c) (r : ℕ) (D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ), 0 ≤ q → ∀ (jStar : ℕ) (E : ℝ) (u : ℕ),
      ‖(candidateCompactRangeCoefficient c L q r jStar E u : ℂ) -
        candidateBoxRangeCoefficient c L q r jStar E L u‖ ≤
          L^(-D)*candidateCoefficient c L q r jStar u := by
  obtain ⟨C,hC,hL1,hdecay⟩ := active_allocation_fourier_bounds (candidateAllocationRadius r)
  obtain ⟨M,hM⟩ := exists_candidate_truncation_order hc hC r D
  obtain ⟨CM,hCM,htrunc⟩ := hdecay M
  filter_upwards [hM M le_rfl CM hCM.le, eventually_ge_atTop (1 : ℝ)] with L hcost hL
  intro q hq jStar E u
  let N := (candidateQIndices c L).card*r
  let err : ℝ := N*CM*C^(N-1)*L^(-(M : ℝ))
  have herr : 0 ≤ err := by dsimp [err]; positivity
  have hsingle (x : ∀ slot, candidateQSlotChoices c L r jStar slot) :
      ‖(candidateRangeAllocationMass c L r jStar x E : ℂ) -
        candidateBoxRangeAllocationMass c L r jStar x E L‖ ≤ (2 : ℝ)^N*err := by
    apply candidate_range_box_error c L r jStar x E L herr
    intro take hkeep
    exact htrunc _ (log E) _ _ _ take hkeep L hL
  have hcost' : (2 : ℝ)^N*err ≤ L^(-D) := by
    convert hcost using 1
    dsimp [N,err]
    ring
  exact (candidate_box_coefficient_error c L hq r jStar E L u hsingle).trans
    (mul_le_mul_of_nonneg_right hcost' (candidate_coefficient_nonneg c L hq r jStar u))

theorem eventually_candidate_box_norm_bound {c : ℝ} (hc : 0 < c) (r : ℕ) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ), 0 ≤ q → ∀ (jStar : ℕ) (E : ℝ) (u : ℕ),
      ‖candidateBoxRangeCoefficient c L q r jStar E L u‖ ≤
        2*candidateCoefficient c L q r jStar u := by
  filter_upwards [eventually_candidate_box_pointwise_error hc r 0] with L he
  intro q hq jStar E u
  have he' := he q hq jStar E u
  simp only [neg_zero, rpow_zero, one_mul] at he'
  have hb := candidate_compact_range_coefficient_bounds c L hq r jStar E u
  calc
    _ ≤ ‖(candidateCompactRangeCoefficient c L q r jStar E u : ℂ) -
          candidateBoxRangeCoefficient c L q r jStar E L u‖ +
        ‖(candidateCompactRangeCoefficient c L q r jStar E u : ℂ)‖ := by
      simpa only [add_comm] using
        norm_le_insert (candidateCompactRangeCoefficient c L q r jStar E u : ℂ)
          (candidateBoxRangeCoefficient c L q r jStar E L u)
    _ ≤ candidateCoefficient c L q r jStar u + candidateCoefficient c L q r jStar u := by
      apply add_le_add he'
      simpa only [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hb.1] using hb.2
    _ = _ := by ring

end Bounty
end

section

/- The common forest mask is an exact causal factor on original paths, starting from the actual initial prime labels. -/

open Finset Classical
namespace Bounty
section Factor
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ) (steps : List (Option (J ⊕ K)))
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))

noncomputable def fullMixedCommonForestHistoryGain (t : ℕ) (tag : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag s)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P)) : ℝ :=
  if ht : t < steps.length then
    if steps.get ⟨t, ht⟩ = tag then
      if birthForestStageCondition (fullMixedCommonIndexStage M B steps) (Fin.succ ⟨t, ht⟩)
        (fullMixedCommonStepHistoryUpdate n S B A Δ D steps t tag s e history) code then 1 else 0
    else 0
  else 0

theorem full_mixed_common_forest_history_gain_nonneg (t : ℕ) (tag : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag s)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P)) :
    0 ≤ fullMixedCommonForestHistoryGain n S B A Δ D steps code t tag s e history := by
  unfold fullMixedCommonForestHistoryGain
  split_ifs <;> norm_num

theorem full_mixed_common_forest_history_gain_owner (u : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (steps.get u) s)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P)) :
    fullMixedCommonForestHistoryGain n S B A Δ D steps code u.val (steps.get u) s e history =
      if birthForestStageCondition (fullMixedCommonIndexStage M B steps) u.succ
        (fullMixedCommonHistoryWrite n S B A Δ D steps u s e history) code then 1 else 0 := by
  unfold fullMixedCommonForestHistoryGain
  rw [dif_pos u.isLt, if_pos rfl, full_mixed_common_step_history_update_owner]

theorem full_mixed_common_forest_history_factor
    (hcode : ∀ i, fullMixedCommonIndexStage M B steps i = 0 → code i = none)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps s)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P)) :
    finiteEventHistoryFactor (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D)
      (fullMixedCommonStepHistoryUpdate n S B A Δ D steps)
      (fullMixedCommonForestHistoryGain n S B A Δ D steps code) 0 steps s p
      (fullMixedCommonHistorySeed n B steps s history) =
    if birthForestCompatible
      (fun i => fullMixedCommonBirthPerformed n S B A Δ D steps s p (fullMixedCommonBirthOrder M B steps i))
      (fun i => fullMixedCommonBirthLabel n S B A Δ D steps s p (fullMixedCommonBirthOrder M B steps i)) code
      then 1 else 0 := by
  rw [finite_event_history_factor_eq_prod]
  trans (∏ u : Fin steps.length,
    if birthForestStageCondition (fullMixedCommonIndexStage M B steps) u.succ
      (fullMixedCommonPathHistory n S B A Δ D steps s p history (u.val + 1)) code then (1 : ℝ) else 0)
  · apply prod_congr rfl
    intro u _
    dsimp only
    rw [Nat.zero_add,
      full_mixed_common_path_history_at n S B A Δ D steps s p history u.val (Nat.le_of_lt u.isLt),
      full_mixed_common_forest_history_gain_owner,
      full_mixed_common_path_history_write]
  · rw [prod_condition_indicators]
    simp only [← full_mixed_common_forest_compatible_iff_history_stages n S B A Δ D steps s p history code hcode]

end Factor
end Bounty
end

