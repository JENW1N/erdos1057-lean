  (β : (g : Fin N) → ↥(P g) → ℝ) (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)
  (S : Finset (PhysicalSelectedData P ell C)) (w : PhysicalSelectedData P ell C → ℂ)

theorem physical_selected_capped_history_sum_bound
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hω : ∀ j c a, 0 ≤ ω j c a) (hωmass : ∀ j c, ∑ a, ω j c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 < β g p / V g) (hmass : ∀ g, ∑ p, β g p / V g ≤ 2)
    (hq0 : ∀ i, 0 ≤ retention i) (hq1 : ∀ i, retention i ≤ 1)
    (hD : ∀ i, retention i / ρ ^ 2 + ((1 - retention i) / ρ) / v ≤ 1)
    (hC : ∀ i g, retention i / ρ ^ 2 + ((1 - retention i) * V g / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ j g, ell + (C j g).card ≤ T)
    (hw : ∀ d ∈ S, ‖w d‖ ≤ 1)
    (a : S → Fin (n + 1) → ℤ)
    (hstep : ∀ d : S, ∀ j : Fin n, a d j.succ = a d j.castSucc +
      k j * (physicalD (C j) (physicalPermuteLabels (d.val.2.2.1 j)
        (d.val.2.1 j.castSucc)) (d.val.1 j) : ℤ))
    (ζ : S → ∀ p : PhysicalPrime P, ZMod p.2.val)
    (hmarks : ∀ d : S, ∀ j : Fin (n + 1), ∀ p ∈ physicalMarkedPrimes (d.val.2.1 j),
      ζ d p = -(a d j : ZMod p.2.val))
    (hlist : ∀ d : S, ∀ j : Fin n, physicalListAdmissible (C j) (d.val.1 j)
      (physicalPermuteLabels (d.val.2.2.1 j) (d.val.2.1 j.castSucc))
      (physicalPermuteLabels (d.val.2.2.2 j) (d.val.2.1 j.succ)))
    (hk : ∀ d : S, ∀ j : Fin n, ∀ g t, ¬ ((d.val.2.1 j.castSucc g t).val : ℤ) ∣ k j) :
    ‖(∑ d : S, w d.val *
      (∏ i ∈ range (2 * n + 1), physicalSelectedCoarseScalar C d.val.1 d.val.2.1 d.val.2.2.1 ω i) *
      (ghostPhaseCappedHistory
        (fun p : PhysicalPrime P => fun j => globalBirthFiniteActivity
          (physicalGroupBareFiniteActivity d.val.2.1 p.1) j p.2)
        (fun p => physicalResidueAbsoluteHit (a d) p.1 p.2)
        (fun _ j => 1 - retention (globalBirthFiniteIndex n j))
        (fun p => β p.1 p.2) (fun p => V p.1) (fun _ => B) (fun _ => B) n : ℂ))‖ ^ 2 ≤
      physicalMarkMass (J := J) (ell := ell) (fun g p => β g p / V g) *
        (physicalGhostUniformEnergyBound ρ vmax v ^ (N * (n + 1)) *
          unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ (N * n) *
          ∏ g, (∑ p, β g p / V g) ^ (J + ell)) := by
  have hV : ∀ g, V g ≠ 0 := fun g => ne_of_gt (lt_of_lt_of_le hvmin (hVlo g))
  have he := physical_selected_original_history_sum_bound (B := B) C k β V ρ hV ω retention S w
    hP hdis hω hωmass hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass hq0 hq1 hD hC T ht hw
    a hstep ζ hmarks hlist hk
  have hnorm (d : S) := physical_joint_residue_normalized_eq_capped_absolute
    C d.val.1 k d.val.2.1 (a d) d.val.2.2.1 d.val.2.2.2 (hstep d) (ζ d) (hmarks d)
    (hlist d) hP hdis (hk d) β (fun _ j => 1 - retention j) V (fun _ => ρ) hV B
    (fun _ => ne_of_gt hρ0)
  convert he using 1
  congr 2
  apply sum_congr rfl
  intro d hd
  rw [← hnorm d]
  ring

end Energy
end Bounty
