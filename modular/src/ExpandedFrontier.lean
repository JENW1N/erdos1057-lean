/- Two-sided small-slot averaging transfers reverse promotion rarity to
literal mixed storage on the original small-state measure. -/

open Finset Classical

namespace Bounty

theorem exists_physical_small_big_storage_sandwich_energy_bound
    {q vs : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hvs : 0 < vs) (ell : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (S G : Type) [Fintype S] [DecidableEq S]
      [Fintype G] [DecidableEq G]
      (Ps : S → Finset ℕ) [∀ p : PhysicalPrime Ps, NeZero p.2.val]
      (P : G → Type) [∀ g, Fintype (P g)] (n : ∀ g, P g → ℕ)
      [∀ g p, NeZero (n g p)] (J : ℕ) (M : G → ℕ)
      (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
      (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
      (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
      (kbig : SharedActiveLabels P shared → ℤ)
      (Vs : S → ℝ), (∀ s, vs ≤ Vs s) →
      ∀ (aux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))))
        (v vmin vmax : ℝ), 0 < ρ → ρ < 1 → 1 < v → 0 < vmin →
      (∀ g, vmin ≤ V g) → (∀ g, V g ≤ vmax) →
      (∀ g p, 0 ≤ μ g p) → (∀ g, ∑ p, μ g p ≤ 2) →
      ∀ (T : ℕ), (∀ g, (shared g)ᶜ.card ≤ T) →
      ∀ (δ : ℝ), 0 ≤ δ →
      (∀ s : PhysicalSmallBigState Ps J ell
          (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B),
        productTotalMemory s.2 ≤ B →
        (∑ σ : PhysicalPermutations S J ell,
          if physicalSmallBigEligible n shared B (fun d c g => -Δ d c g) D
            (physicalSmallBigPermutation σ s)
          then 1 / (Fintype.card (PhysicalPermutations S J ell) : ℝ) else 0) ≤ δ) →
      ∀ (F : PhysicalSmallBigState Ps J ell
        (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ),
      (∀ s, ProductMemorySymmetric (fun x => F (s, x))) →
      physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
        (physicalSmallBigAverage (physicalSmallBigStorageAction n shared B Δ D μ ρ V kbig Vs q aux
          (physicalSmallBigAverage F))) ≤
        δ * (A ^ (2 * Fintype.card S) *
          unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G) *
          physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) F := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_small_big_reverse_energy_bound hq0 hq1 hvs ell
  refine ⟨A, hA, ?_⟩
  intro S G _ dS _ dG
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  intro Ps _ P _ n _ J M shared B Δ D μ ρ V kbig Vs hVs aux
    v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht δ hδ hrare F hF
  let X := ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B
  let W : X → ℝ := productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))
  let C : ℝ := A ^ (2 * Fintype.card S) * unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G
  let Rev := physicalSmallBigReverseAction (ell := ell) n shared B Δ D μ ρ V kbig Vs q aux
  let Sto := physicalSmallBigStorageAction (ell := ell) n shared B Δ D μ ρ V kbig Vs q aux
  have hVs0 : ∀ s, 0 < Vs s := fun s => hvs.trans_le (hVs s)
  have hW : ∀ x, 0 ≤ W x := productMemoryWeight_nonneg μ _ hμ (fun g z => hμ g z.1)
  have hC : 0 ≤ C := mul_nonneg (pow_nonneg (zero_le_one.trans hA) _)
    (pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _)
  have hbase (f : PhysicalSmallBigState Ps J ell X → ℂ)
      (hf : ∀ s, ProductMemorySymmetric (fun x => f (s,x))) :
      physicalSmallBigEnergy Vs W (Rev f) ≤ C * physicalSmallBigEnergy Vs W f := by
    exact hbound S G Ps P n J M shared B Δ D μ ρ V kbig Vs hVs aux
      v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht f hf
  have hleft (f : PhysicalSmallBigState Ps J ell X → ℂ)
      (hf : ∀ s, ProductMemorySymmetric (fun x => f (s,x))) :
      physicalSmallBigEnergy Vs W (physicalSmallBigAverage (Rev f)) ≤
        δ * C * physicalSmallBigEnergy Vs W f := by
    let π : PhysicalPermutations S J ell → ℝ := fun _ => 1 / (Fintype.card (PhysicalPermutations S J ell) : ℝ)
    let bad : PhysicalPermutations S J ell → PhysicalSmallBigState Ps J ell X → Prop :=
      fun _ s => productTotalMemory s.2 ≤ B ∧
        physicalSmallBigEligible n shared B (fun d c g => -Δ d c g) D s
    have hc : (Fintype.card (PhysicalPermutations S J ell) : ℝ) ≠ 0 := by
      exact_mod_cast (Fintype.card_ne_zero : Fintype.card (PhysicalPermutations S J ell) ≠ 0)
    have hm : ∑ σ, π σ ≤ 1 := by
      simp only [π, sum_const, card_univ, nsmul_eq_mul, one_div, mul_inv_cancel₀ hc, le_refl]
    have hh := physical_small_big_sparse_permutation_energy_le Vs hVs0 W hW π
      (by intro σ; exact one_div_nonneg.mpr (Nat.cast_nonneg _)) hm (fun σ => σ) (fun _ => True)
      bad (fun _ => Rev f) (by
        intro σ s hb
        by_cases hs : productTotalMemory s.2 ≤ B
        · apply physical_small_big_reverse_zero n shared B Δ D μ ρ V kbig Vs q aux f s
          exact fun he => hb ⟨hs, he⟩
        · exact physical_small_big_full_zero_above_cap n shared B (fun d c g => -Δ d c g) D
            μ ρ V (fun c => -kbig c) Vs q 0 aux (fun _ => 1)
            (physicalSmallBigReversePhase n shared B Δ D V) f s hs)
      hδ hC (by
        intro s hsTrue
        by_cases hs : productTotalMemory s.2 ≤ B
        · have he : (∑ σ, @ite ℝ (bad σ (physicalSmallBigPermutation σ s))
              (Classical.propDecidable _) (π σ) 0) =
              ∑ σ, if physicalSmallBigEligible n shared B (fun d c g => -Δ d c g) D
                (physicalSmallBigPermutation σ s) then π σ else 0 := by
            apply sum_congr rfl
            intro σ _
            have hi : bad σ (physicalSmallBigPermutation σ s) ↔
                physicalSmallBigEligible n shared B (fun d c g => -Δ d c g) D
                  (physicalSmallBigPermutation σ s) := by
              exact and_iff_right hs
            simp only [hi]
          exact he.le.trans (hrare s hs)
        · have hz : (∑ σ, @ite ℝ (bad σ (physicalSmallBigPermutation σ s))
              (Classical.propDecidable _) (π σ) 0) = 0 := by
            apply sum_eq_zero
            intro σ _
            exact if_neg (fun hb => hs hb.1)
          exact hz.le.trans hδ)
      f (fun _ => hbase f hf)
    refine le_trans (le_of_eq ?_) hh
    apply congrArg (physicalSmallBigEnergy Vs W)
    funext s
    simp only [physicalSmallBigAverage, π, if_true, one_div, Complex.ofReal_inv,
      Complex.ofReal_natCast, mul_sum]
  have hrev (f : PhysicalSmallBigState Ps J ell X → ℂ)
      (hf : ∀ s, ProductMemorySymmetric (fun x => f (s,x))) :
      physicalSmallBigEnergy Vs W (physicalSmallBigAverage (Rev (physicalSmallBigAverage f))) ≤
        δ * C * physicalSmallBigEnergy Vs W f :=
    (hleft (physicalSmallBigAverage f) (physical_small_big_average_memory_symmetric f hf)).trans
      (mul_le_mul_of_nonneg_left (physical_small_big_average_energy_le Vs hVs0 W hW f) (mul_nonneg hδ hC))
  have h := finite_symmetric_transpose_energy_le (physicalSmallBigMeasure Vs W)
    (physical_small_big_measure_nonneg Vs hVs0 W hW)
    (fun f : PhysicalSmallBigState Ps J ell X → ℂ => ∀ s, ProductMemorySymmetric (fun x => f (s,x)))
    (fun f => physicalSmallBigAverage (Sto (physicalSmallBigAverage f)))
    (fun f => physicalSmallBigAverage (Rev (physicalSmallBigAverage f)))
    (by intro f hf s x g σ; exact congrArg (starRingEnd ℂ) (hf s x g σ))
    (by
      intro f hf
      exact physical_small_big_average_memory_symmetric _
        (physical_small_big_storage_memory_symmetric n shared B Δ D μ ρ V kbig Vs q aux _
          (physical_small_big_average_memory_symmetric f hf)))
    (by
      intro f g hf hg
      apply physical_small_big_average_sandwich_pairing Vs W Sto Rev f g
      exact physical_small_big_storage_pairing n shared B Δ D μ ρ V kbig Vs hVs0 q aux
        (fun g => (hvmin.trans_le (hVlo g)).ne') _ _
        (physical_small_big_average_memory_symmetric f hf)
        (physical_small_big_average_memory_symmetric g hg))
    (mul_nonneg hδ hC) (by
      intro f hf
      simpa only [physical_small_big_energy_eq] using hrev f hf) F hF
  simp only [physical_small_big_energy_eq] at h
  convert h using 1 <;> congr 2

end Bounty
end

section

/- Uniform logarithmic displacement of an actual cofactor cell under fixed product bounds. -/

open Real

namespace Bounty

theorem cofactor_logarithmic_cell_distance {L S cLo cHi : ℝ}
    (hL : 1 ≤ L) (hS : 0 ≤ S) (hcLo : 0 < cLo) (hcHi : 0 < cHi)
    {p m : ℕ} (hp : 0 < p) (hm : 0 < m)
    (hlo : cLo*exp L ≤ (p : ℝ)*(m : ℝ))
    (hhi : (p : ℝ)*(m : ℝ) ≤ cHi*exp L) :
    |(logarithmicCellIndex (L^(-S)) m : ℝ)*L^(-S)/L -
      (1-log (p : ℝ)/L)| ≤ (|log cLo|+|log cHi|+1)/L := by
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hp0 : 0 < (p : ℝ) := Nat.cast_pos.mpr hp
  have hm0 : 0 < (m : ℝ) := Nat.cast_pos.mpr hm
  have hloglo := log_le_log (mul_pos hcLo (exp_pos L)) hlo
  have hloghi := log_le_log (mul_pos hp0 hm0) hhi
  rw [log_mul hcLo.ne' (exp_ne_zero _), log_exp, log_mul hp0.ne' hm0.ne'] at hloglo
  rw [log_mul hp0.ne' hm0.ne', log_mul hcHi.ne' (exp_ne_zero _), log_exp] at hloghi
  have hδ : 0 < L^(-S) := rpow_pos_of_pos hL0 _
  have hδ1 : L^(-S) ≤ 1 := rpow_le_one_of_one_le_of_nonpos hL (neg_nonpos.mpr hS)
  obtain ⟨hl,hu⟩ := logarithmic_cell_index_bounds hδ m
  have hn : |(logarithmicCellIndex (L^(-S)) m : ℝ)*L^(-S)+log (p : ℝ)-L| ≤
      |log cLo|+|log cHi|+1 := by
    apply abs_le.mpr
    constructor
    · linarith [neg_abs_le (log cLo), abs_nonneg (log cHi)]
    · linarith [le_abs_self (log cHi), abs_nonneg (log cLo)]
  have hid : (logarithmicCellIndex (L^(-S)) m : ℝ)*L^(-S)/L -
      (1-log (p : ℝ)/L) =
      ((logarithmicCellIndex (L^(-S)) m : ℝ)*L^(-S)+log (p : ℝ)-L)/L := by
    field_simp
    ring
  rw [hid, abs_div, abs_of_pos hL0]
  exact div_le_div_of_nonneg_right hn hL0.le

theorem prime_band_logarithmic_exponent_bounds {a v L : ℝ} (hL : 0 < L)
    {p : ℕ} (hp : p ∈ primeBand (exp (a*L)) (exp (v*L))) :
    a ≤ log (p : ℝ)/L ∧ log (p : ℝ)/L ≤ v := by
  obtain ⟨hpp,hlo,hhi⟩ := (mem_primeBand_iff (exp_pos _).le (exp_pos _).le p).mp hp
  have hpl := log_le_log (exp_pos (a*L)) hlo.le
  have hpu := log_le_log (Nat.cast_pos.mpr hpp.pos) hhi
  rw [log_exp] at hpl hpu
  exact ⟨(le_div_iff₀ hL).mpr hpl, (div_le_iff₀ hL).mpr hpu⟩

end Bounty
end

section

/- Exact proxy subtraction with the remaining candidate-weighted replacement errors explicit. -/

open Finset
namespace Bounty

theorem shifted_buchstab_pair_rough_test (T : Finset ℕ) (z γ L : ℝ)
    (hT : ∀ u ∈ T, 0 < u) {v : ℕ × ℕ} (hv : v ∈ shiftedBuchstabPairs T z)
    (hγ : Real.exp (γ*L) < (v.1 : ℝ)) : roughTestIndicator γ L v.2=1 := by
  classical
  have hrough := (shifted_buchstab_pair_properties T z hT hv).2.2.2.2.2
  unfold roughTestIndicator
  apply if_pos
  intro p hp
  exact hγ.trans_le (Nat.cast_le.mpr (hrough p hp))

theorem weighted_shifted_buchstab_proxy_identity
    (T : Finset ℕ) (z cutoff : ℝ) (μ : ℕ → ℝ) (P Q : ℕ × ℕ → ℝ) :
    let F := shiftedBuchstabPairs T z
    let U := F.filter (fun v => (v.1 : ℝ) ≤ cutoff)
    let B := F.filter (fun v => ¬(v.1 : ℝ) ≤ cutoff)
    (∑ u ∈ (shiftedRoughSet T z).filter (fun u => (2*u+1).Prime), μ u) =
      (∑ u ∈ shiftedRoughSet T z, μ u) -
        (∑ v ∈ U, μ (shiftedPairIndex v)*P v) -
        (∑ v ∈ B, μ (shiftedPairIndex v)*Q v) -
        ((∑ v ∈ U, μ (shiftedPairIndex v)*(1-P v))+
          ∑ v ∈ B, μ (shiftedPairIndex v)*(1-Q v)) := by
  classical
  dsimp only
  have h := weighted_shifted_buchstab_pair_identity T z μ
  have hs := sum_filter_add_sum_filter_not (shiftedBuchstabPairs T z)
    (fun v => (v.1 : ℝ) ≤ cutoff) (fun v => μ (shiftedPairIndex v))
  have he (G : Finset (ℕ × ℕ)) (R : ℕ × ℕ → ℝ) :
      (∑ v ∈ G, μ (shiftedPairIndex v)*R v)+
        (∑ v ∈ G, μ (shiftedPairIndex v)*(1-R v)) =
          ∑ v ∈ G, μ (shiftedPairIndex v) := by
    rw [← sum_add_distrib]
    apply sum_congr rfl
    intro v hv
    ring
  have hU := he ((shiftedBuchstabPairs T z).filter (fun v => (v.1 : ℝ) ≤ cutoff)) P
  have hB := he ((shiftedBuchstabPairs T z).filter (fun v => ¬(v.1 : ℝ) ≤ cutoff)) Q
  linarith

theorem weighted_shifted_buchstab_proxy_lower_bound
    (T : Finset ℕ) (z cutoff : ℝ) (μ : ℕ → ℝ) (P Q : ℕ × ℕ → ℝ)
    (Rlo Uhi Bhi E : ℝ)
    (hR : Rlo ≤ ∑ u ∈ shiftedRoughSet T z, μ u)
    (hU : (∑ v ∈ (shiftedBuchstabPairs T z).filter (fun v => (v.1 : ℝ) ≤ cutoff),
      μ (shiftedPairIndex v)*P v) ≤ Uhi)
    (hB : (∑ v ∈ (shiftedBuchstabPairs T z).filter (fun v => ¬(v.1 : ℝ) ≤ cutoff),
      μ (shiftedPairIndex v)*Q v) ≤ Bhi)
    (hE : |(∑ v ∈ (shiftedBuchstabPairs T z).filter (fun v => (v.1 : ℝ) ≤ cutoff),
      μ (shiftedPairIndex v)*(1-P v))+
      (∑ v ∈ (shiftedBuchstabPairs T z).filter (fun v => ¬(v.1 : ℝ) ≤ cutoff),
        μ (shiftedPairIndex v)*(1-Q v))| ≤ E) :
    Rlo-Uhi-Bhi-E ≤
      ∑ u ∈ (shiftedRoughSet T z).filter (fun u => (2*u+1).Prime), μ u := by
  rw [weighted_shifted_buchstab_proxy_identity T z cutoff μ P Q]
  have hh := (le_abs_self _).trans hE
  linarith

end Bounty
end

section

/- Exact shifted Buchstab mesh decomposition with explicit proxy replacement error. -/

open Finset Real

namespace Bounty

noncomputable def shiftedBuchstabUnbalancedPairs (T : Finset ℕ) (b q L : ℝ) :
    Finset (ℕ × ℕ) := by
  classical
  exact (shiftedBuchstabPairs T (exp (b*L))).filter (fun v => (v.1 : ℝ) ≤ exp (q*L))

noncomputable def shiftedBuchstabBalancedPairs (T : Finset ℕ) (b q L : ℝ) :
    Finset (ℕ × ℕ) := by
  classical
  exact (shiftedBuchstabPairs T (exp (b*L))).filter (fun v => ¬(v.1 : ℝ) ≤ exp (q*L))

noncomputable def shiftedBuchstabMeshBin (T : Finset ℕ) (b q L : ℝ) (N i : ℕ) :
    Finset (ℕ × ℕ) :=
  primeGridPairBin b q N L (shiftedBuchstabUnbalancedPairs T b q L) i

theorem mem_shifted_buchstab_unbalanced_pairs {T : Finset ℕ} {b q L : ℝ} {v : ℕ × ℕ} :
    v ∈ shiftedBuchstabUnbalancedPairs T b q L ↔
      v ∈ shiftedBuchstabPairs T (exp (b*L)) ∧ (v.1 : ℝ) ≤ exp (q*L) := by
  classical
  exact mem_filter

theorem mem_shifted_buchstab_balanced_pairs {T : Finset ℕ} {b q L : ℝ} {v : ℕ × ℕ} :
    v ∈ shiftedBuchstabBalancedPairs T b q L ↔
      v ∈ shiftedBuchstabPairs T (exp (b*L)) ∧ exp (q*L) < (v.1 : ℝ) := by
  classical
  simp only [shiftedBuchstabBalancedPairs, mem_filter, not_le]

theorem mem_shifted_buchstab_mesh_bin {T : Finset ℕ} {b q L : ℝ}
    {N i : ℕ} {v : ℕ × ℕ} :
    v ∈ shiftedBuchstabMeshBin T b q L N i ↔
      v ∈ shiftedBuchstabUnbalancedPairs T b q L ∧
      v.1 ∈ primeBand (exp (reciprocalGrid b q N i*L))
        (exp (reciprocalGrid b q N (i+1)*L)) :=
  mem_prime_grid_pair_bin

theorem shifted_buchstab_unbalanced_prime_band (T : Finset ℕ) (b q L : ℝ)
    (hT : ∀ u ∈ T, 0 < u) {v : ℕ × ℕ}
    (hv : v ∈ shiftedBuchstabUnbalancedPairs T b q L) :
    v.1 ∈ primeBand (exp (b*L)) (exp (q*L)) := by
  obtain ⟨hv,hcut⟩ := mem_shifted_buchstab_unbalanced_pairs.mp hv
  have hp := shifted_buchstab_pair_properties T (exp (b*L)) hT hv
  exact (mem_primeBand_iff (exp_pos _).le (exp_pos _).le v.1).mpr
    ⟨hp.1,hp.2.2.2.2.1,hcut⟩

theorem weighted_shifted_buchstab_mesh_identity {M : Type*} [AddCommMonoid M]
    (T : Finset ℕ) (μ : ℕ → M) {b q L : ℝ} (hbq : b ≤ q) (hL : 0 ≤ L)
    {N : ℕ} (hN : 0 < N) (hT : ∀ u ∈ T, 0 < u) :
    (∑ u ∈ shiftedRoughSet T (exp (b*L)), μ u) =
      (∑ u ∈ (shiftedRoughSet T (exp (b*L))).filter (fun u => (2*u+1).Prime), μ u)+
      (∑ i : Fin N, ∑ v ∈ shiftedBuchstabMeshBin T b q L N i, μ (shiftedPairIndex v))+
      ∑ v ∈ shiftedBuchstabBalancedPairs T b q L, μ (shiftedPairIndex v) := by
  classical
  have hparts := sum_filter_add_sum_filter_not (shiftedBuchstabPairs T (exp (b*L)))
    (fun v => (v.1 : ℝ) ≤ exp (q*L)) (fun v => μ (shiftedPairIndex v))
  have hmesh := sum_pairs_eq_sum_prime_grid_bins hbq hL hN
    (shiftedBuchstabUnbalancedPairs T b q L) (fun v => μ (shiftedPairIndex v))
    (fun v hv => shifted_buchstab_unbalanced_prime_band T b q L hT hv)
  change (∑ v ∈ shiftedBuchstabUnbalancedPairs T b q L, μ (shiftedPairIndex v))+
    (∑ v ∈ shiftedBuchstabBalancedPairs T b q L, μ (shiftedPairIndex v)) =
    ∑ v ∈ shiftedBuchstabPairs T (exp (b*L)), μ (shiftedPairIndex v) at hparts
  change (∑ v ∈ shiftedBuchstabUnbalancedPairs T b q L, μ (shiftedPairIndex v)) =
    ∑ i : Fin N, ∑ v ∈ shiftedBuchstabMeshBin T b q L N i, μ (shiftedPairIndex v) at hmesh
  rw [weighted_shifted_buchstab_pair_identity, ← hparts, hmesh, add_assoc]

noncomputable def shiftedBuchstabUnbalancedProxy (T : Finset ℕ) (μ : ℕ → ℝ)
    (b q L S : ℝ) (N : ℕ) : ℝ :=
  ∑ i : Fin N, ∑ v ∈ shiftedBuchstabMeshBin T b q L N i,
    μ (shiftedPairIndex v)*roughTestLogarithmicProxy (reciprocalGrid b q N i) L S v.2

noncomputable def shiftedBuchstabBalancedProxy (T : Finset ℕ) (μ : ℕ → ℝ)
    (b q L S : ℝ) : ℝ :=
  ∑ v ∈ shiftedBuchstabBalancedPairs T b q L,
    μ (shiftedPairIndex v)*primeLogarithmicProxy L S v.1*primeLogarithmicProxy L S v.2

noncomputable def shiftedBuchstabProxyError (T : Finset ℕ) (μ : ℕ → ℝ)
    (b q L S : ℝ) (N : ℕ) : ℝ :=
  (∑ i : Fin N, ∑ v ∈ shiftedBuchstabMeshBin T b q L N i,
    μ (shiftedPairIndex v)*(1-roughTestLogarithmicProxy (reciprocalGrid b q N i) L S v.2))+
  ∑ v ∈ shiftedBuchstabBalancedPairs T b q L,
    μ (shiftedPairIndex v)*(1-primeLogarithmicProxy L S v.1*primeLogarithmicProxy L S v.2)

theorem shifted_buchstab_proxy_error_eq (T : Finset ℕ) (μ : ℕ → ℝ)
    (b q L S : ℝ) (N : ℕ) :
    shiftedBuchstabProxyError T μ b q L S N =
      (∑ i : Fin N, ∑ v ∈ shiftedBuchstabMeshBin T b q L N i, μ (shiftedPairIndex v))+
      (∑ v ∈ shiftedBuchstabBalancedPairs T b q L, μ (shiftedPairIndex v))-
      shiftedBuchstabUnbalancedProxy T μ b q L S N-shiftedBuchstabBalancedProxy T μ b q L S := by
  unfold shiftedBuchstabProxyError shiftedBuchstabUnbalancedProxy shiftedBuchstabBalancedProxy
  simp only [mul_sub, mul_one, sum_sub_distrib, mul_assoc]
  ring

theorem weighted_shifted_buchstab_mesh_proxy_identity (T : Finset ℕ) (μ : ℕ → ℝ)
    {b q L : ℝ} (hbq : b ≤ q) (hL : 0 ≤ L) {N : ℕ} (hN : 0 < N)
    (hT : ∀ u ∈ T, 0 < u) (S : ℝ) :
    (∑ u ∈ (shiftedRoughSet T (exp (b*L))).filter (fun u => (2*u+1).Prime), μ u) =
      (∑ u ∈ shiftedRoughSet T (exp (b*L)), μ u)-
      shiftedBuchstabUnbalancedProxy T μ b q L S N-shiftedBuchstabBalancedProxy T μ b q L S-
      shiftedBuchstabProxyError T μ b q L S N := by
  rw [shifted_buchstab_proxy_error_eq]
  have h := weighted_shifted_buchstab_mesh_identity T μ hbq hL hN hT
  linarith

end Bounty
end

section

/- Group the actual full-edge sampled forest costs by their original prime groups. -/

open Finset Classical

namespace Bounty

theorem full_edge_grouped_restricted_continuation_le
    {G : Type*} [Fintype G] [DecidableEq G] {P : G → Type*}
    [∀ g, Fintype (P g)] [∀ g, DecidableEq (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : SharedActiveLabels P S → Type*) (Δ D : ∀ c, A c → G → ℤ)
    (ω : ∀ c, A c → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (sk : FullActiveEdgeSkeleton n S B A Δ D s) {m : ℕ}
    (ord : Fin m ≃ FullActiveEdgeSampleIndex n S B A Δ D s sk)
    {Q : ℕ} (f : FullActiveEdgeSampleIndex n S B A Δ D s sk → Fin Q)
    (code : BirthForestCode Q) (history : Fin Q → Option (Sigma P))
    (d : G → ℕ)
    (hvalid : ∀ i, restrictedBirthAnchors (f ∘ ord) code history i ≠ some none)
    (hd : ∀ g, (univ.filter (fun i : {i : Fin (S g)ᶜ.card // i ∉ (sk.2 g).2.1} => code (f ⟨g, i⟩) ≠ none)).card = d g)
    (η : G → ℝ) (hη : ∀ g, 0 ≤ η g) (hμ : ∀ g p, 0 ≤ μ g p)
    (hμatom : ∀ g p, μ g p ≤ η g)
    (v L : ℝ) (hv : 0 ≤ v) (hL : 0 ≤ L)
    (F : FullActiveEdgeSamples n S B A Δ D s sk → ℝ)
    (hF : ∀ fresh, F fresh ≤ L * productLengthLyapunov v
      (fullActiveEdgeEventTarget n S B A Δ D s
        ((fullActiveEdgeSkeletonEquiv n S B A Δ D s).symm ⟨sk, fresh⟩))) :
    (∑ fresh : FullActiveEdgeSamples n S B A Δ D s sk,
      if birthForestEqualValues (restrictedBirthCode (f ∘ ord) code) (fun j => (⟨(ord j).1, fresh (ord j)⟩ : Sigma P)) ∧
          birthLabelsAnchored (fun i => (restrictedBirthAnchors (f ∘ ord) code history i).join) (fun j => (⟨(ord j).1, fresh (ord j)⟩ : Sigma P)) then
        |fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V s
          ((fullActiveEdgeSkeletonEquiv n S B A Δ D s).symm ⟨sk, fresh⟩)| * F fresh
      else 0) ≤
    fullActiveEdgeSkeletonAbsMass n S B A Δ D ω ρ V s sk *
      (L * v ^ (∑ g, unrestrictedSkeletonOutputCount (n g)
        (Δ (productActiveMemorySplit S B s).1 sk.1 g)
        (D (productActiveMemorySplit S B s).1 sk.1 g)
        (S g)ᶜ.card B ((productActiveMemorySplit S B s).2 g) (sk.2 g))) *
      ∏ g, η g ^ d g * (∑ p, μ g p) ^ ((S g)ᶜ.card - (sk.2 g).2.1.card - d g) := by
  have hb := full_edge_forest_continuation_le n S B A Δ D ω μ ρ V s sk ord
    (restrictedBirthCode (f ∘ ord) code)
    (fun i => (restrictedBirthAnchors (f ∘ ord) code history i).join)
    η hη hμ hμatom v L hv hL F hF
  have hc := grouped_join_restricted_forest_cost_eq
    (fun g => {i : Fin (S g)ᶜ.card // i ∉ (sk.2 g).2.1})
    ord f code history (fun g => ∑ p, μ g p) η d hvalid hd
  refine le_trans (le_of_eq ?_) (le_trans hb (le_of_eq ?_))
  · apply sum_congr rfl
    intro fresh _
    split_ifs <;> rfl
  · congr 1
    convert hc using 1
    · apply prod_congr rfl
      intro i _
      cases restrictedBirthCode (f ∘ ord) code i <;>
        cases (restrictedBirthAnchors (f ∘ ord) code history i).join <;> rfl
    · simp only [Fintype.card_subtype_compl, Fintype.card_fin, Fintype.card_coe]

end Bounty
end

section

/- Original full dilation is recovered from the actual restricted encoded big state. -/

open scoped Classical
namespace Bounty
section Restrict
variable {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell B : ℕ}
  (small : G → Prop) (C : G → Finset (Fin J))
  (hC : ∀ g, small g → C g = ∅)
  (aux : PhysicalAuxLabels P C) (L : PhysicalMarkLists P J ell)
  {Z : {g : G // ¬small g} → Type*}
  (q : ∀ g, BoundedOrderedTuple (Z g) B)

include hC in
theorem physical_mixed_shared_D_restrict :
    physicalMixedSharedD (fun g : {g // ¬small g} => C g.val)
      (physicalSharedPrefix (fun g : {g // small g} => L g.val))
      (productActiveMemorySplit (fun g : {g // ¬small g} => physicalFullSharedIndices (C g.val)) B
        (physicalFullMemoryState (fun g : {g // ¬small g} => C g.val)
          (fun g => L g.val) q)).1 (fun g => aux g.val) = physicalD C L aux := by
  rw [physical_mixed_shared_D_at_state]
  symm
  rw [physical_D_group_split small C aux L,
    physical_D_empty_cut (fun g : {g // small g} => C g.val)
      (fun g => hC g.val g.property)]

include hC in
theorem physical_mixed_parameters_restrict (k : ℤ) (g : {g // ¬small g}) :
    let Cb := fun g : {g // ¬small g} => C g.val
    let d := physicalSharedPrefix (fun g : {g // small g} => L g.val)
    let c := (productActiveMemorySplit (fun g => physicalFullSharedIndices (Cb g)) B
      (physicalFullMemoryState Cb (fun g => L g.val) q)).1
    let ab := fun g : {g // ¬small g} => aux g.val
    physicalMixedEdgeD Cb d c ab g = (physicalD C L aux : ℕ) ∧
      physicalMixedEdgeDelta Cb k d c ab g = -k * (physicalD C L aux : ℕ) ∧
      physicalMixedBigStep Cb k c ab * (physicalSharedProduct d : ℕ) =
        k * (physicalD C L aux : ℕ) := by
  dsimp only
  have h := physical_mixed_shared_D_restrict small C hC aux L q
  constructor
  · exact congrArg (fun D : ℕ => (D : ℤ)) h
  constructor
  · change -k * (physicalMixedSharedD _ _ _ _ : ℕ) = _
    rw [h]
  · rw [physical_mixed_step_times_small, h]

end Restrict

section Endpoint
variable {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
  (small : G → Prop) (C : G → Finset (Fin J))
  (hC : ∀ g, small g → C g = ∅)
  {L R : PhysicalMarkLists P J ell} (h : physicalSharedCompatible C L R)

include hC h in
theorem physical_mixed_small_prefix_eq :
    physicalSharedPrefix (fun g : {g // small g} => L g.val) =
      physicalSharedPrefix (fun g : {g // small g} => R g.val) := by
  funext g
  apply Function.Embedding.ext
  intro j
  exact h g.val j (by rw [hC g.val g.property]; exact Finset.notMem_empty j)

end Endpoint

end Bounty
end

section

/- The actual mixed divisor, displacement and small-residue step in canonical
full-memory coordinates. The small shared product stays in the divisor. -/

open scoped Classical

namespace Bounty

noncomputable def canonicalMixedEdgeD {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (d : PhysicalSharedLists Ps J)
    (c : SharedActiveLabels (fun g => ↥(P g)) (cleanFullSharedSlots (ell := ell) C))
    (aux : PhysicalAuxLabels P C) (_g : G) : ℤ :=
  (physicalSharedProduct d * cleanFullSharedD C c aux : ℕ)

noncomputable def canonicalMixedEdgeDelta {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (k : ℤ) (d : PhysicalSharedLists Ps J)
    (c : SharedActiveLabels (fun g => ↥(P g)) (cleanFullSharedSlots (ell := ell) C))
    (aux : PhysicalAuxLabels P C) (_g : G) : ℤ :=
  -cleanFullSharedStep k C c aux d

section
variable {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {Z : G → Type*} {J ell B : ℕ}
    (C : G → Finset (Fin J)) (d : PhysicalSharedLists Ps J)
    (x : ProductBoundedOrderedState (fun g => ↥(P g)) Z (fun _ => J + ell) B)
    (aux : PhysicalAuxLabels P C)

theorem physical_mixed_clean_D_reencode :
    physicalMixedEdgeD C d
      (productActiveMemorySplit (fun g => physicalFullSharedIndices (C g)) B
        (fullActivePermutation (cleanPhysicalSlotChange C) x)).1 aux =
    canonicalMixedEdgeD C d
      (productActiveMemorySplit (cleanFullSharedSlots C) B x).1 aux := by
  funext g
  unfold physicalMixedEdgeD physicalMixedSharedD canonicalMixedEdgeD
  rw [clean_physical_shared_D_reencode]

theorem physical_mixed_clean_delta_reencode (k : ℤ) :
    physicalMixedEdgeDelta C k d
      (productActiveMemorySplit (fun g => physicalFullSharedIndices (C g)) B
        (fullActivePermutation (cleanPhysicalSlotChange C) x)).1 aux =
    canonicalMixedEdgeDelta C k d
      (productActiveMemorySplit (cleanFullSharedSlots C) B x).1 aux := by
  funext g
  unfold physicalMixedEdgeDelta
  rw [physical_mixed_clean_D_reencode]
  unfold canonicalMixedEdgeD canonicalMixedEdgeDelta cleanFullSharedStep
  rw [Nat.cast_mul]
  ring

theorem physical_mixed_clean_step_reencode (k : ℤ) :
    physicalMixedBigStep C k
      (productActiveMemorySplit (fun g => physicalFullSharedIndices (C g)) B
        (fullActivePermutation (cleanPhysicalSlotChange C) x)).1 aux *
        (physicalSharedProduct d : ℕ) =
    cleanFullSharedStep k C
      (productActiveMemorySplit (cleanFullSharedSlots C) B x).1 aux d := by
  unfold physicalMixedBigStep cleanFullSharedStep
  rw [clean_physical_shared_D_reencode]

end
end Bounty
end

section

/- The determinant reindexing uses only the actual nonzero coefficient support. -/

open Finset

namespace Bounty

theorem typeII_off_diagonal_energy_restrict_support (E N M H : Finset ℕ)
    (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ) :
    typeIIOffDiagonalEnergy E N M H η α aH =
      typeIIOffDiagonalEnergy E N (M.filter (fun m => α m ≠ 0)) H η α aH := by
  classical
  unfold typeIIOffDiagonalEnergy
  simp only [sum_product, sum_filter, mul_sum]
  apply sum_congr rfl
  intro e he
  apply sum_congr rfl
  intro n hn
  apply sum_congr rfl
  intro m hm
  by_cases hzero : α m = 0
  · simp [hzero, typeIIEquationTerm]
  · simp only [ne_eq, hzero, not_false_eq_true, if_true, mul_sum]
    apply sum_congr rfl
    intro h hh
    apply sum_congr rfl
    intro m' hm'
    by_cases hzero' : α m' = 0
    · simp [hzero', typeIIEquationTerm]
    · simp only [hzero', not_false_eq_true, if_true, mul_sum]

theorem typeII_off_diagonal_energy_eq_supported_determinant_sum
    (E N M H : Finset ℕ) (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ)
    {Elo U W : ℝ} {B : ℕ}
    (hElo : 0 < Elo) (hE : ∀ e ∈ E, Elo ≤ (e : ℝ))
    (hM : ∀ m ∈ M, (m : ℝ) ≤ U) (hB : U / (2 * Elo) ≤ B) (hBW : (B : ℝ) ≤ W)
    (hrough : ∀ m ∈ M, α m ≠ 0 → ∀ p ∈ m.primeFactors, W < (p : ℝ)) :
    typeIIOffDiagonalEnergy E N M H η α aH =
      ∑ y ∈ typeIIDeterminantDomain E N (M.filter (fun m => α m ≠ 0)) H
        (Icc (-(B : ℤ)) B) (Icc 0 ((M.filter (fun m => α m ≠ 0)).sup id * H.sup id)),
        typeIIShiftWeight η α aH y := by
  classical
  rw [typeII_off_diagonal_energy_restrict_support]
  apply typeII_off_diagonal_energy_eq_bounded_determinant_sum _ _ _ _ _ _ _ hElo hE
    (fun m hm => hM m (mem_filter.mp hm).1) hB hBW
  intro m hm
  exact hrough m (mem_filter.mp hm).1 (mem_filter.mp hm).2

end Bounty

end

section

/- Actual local bounds for the positive mixed path event operators.
Ghost births and edge birth parameters remain separate. -/

open Finset
open scoped Classical

namespace Bounty

section
variable {H K S G : Type} [Fintype S] [Fintype G] [DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Type} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] {J ell : ℕ} {M : G → ℕ}
  (shared : K → ∀ g, Finset (Fin (M g))) (B : ℕ) (A : K → Type) [∀ k, Fintype (A k)]
  (Δ D : ∀ k, PhysicalSharedLists Ps J → SharedActiveLabels P (shared k) → A k → G → ℤ)
  (kbig : ∀ k, SharedActiveLabels P (shared k) → A k → ℤ)
  (ω : ∀ k, A k → ℝ) (μ : ∀ g, P g → ℝ)
  (qghost : H → ℝ) (ρ : ℝ) (Vedge Vghost : G → ℝ) (Vs : S → ℝ) (qsmall : ℝ)

theorem physical_small_big_path_positive_ghost_symmetric
    (hμ : ∀ g p, 0 ≤ μ g p) (j : H) (hq : 0 ≤ qghost j)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (hF : ∀ s, ProductMemorySymmetric (fun x => F (s, x))) :
    ∀ s, ProductMemorySymmetric (fun x => physicalSmallBigPathPositiveAction n shared B A Δ D
      kbig ω μ qghost ρ Vedge Vghost Vs qsmall (some (.inl j)) F (s, x)) := by
  rw [physical_small_big_path_positive_ghost_eq n shared B A Δ D kbig ω μ qghost ρ
    Vedge Vghost Vs qsmall hμ j hq F]
  exact physical_small_big_ghost_one_memory_symmetric _ _ _ _ M B F hF

theorem physical_small_big_path_positive_edge_symmetric [DecidableEq S]
    (hVs : ∀ s, 0 < Vs s) (hω : ∀ k a, 0 ≤ ω k a)
    (hμ : ∀ g p, 0 ≤ μ g p) (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ Vedge g)
    (k : K)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (hF : ∀ s, ProductMemorySymmetric (fun x => F (s, x))) :
    ∀ s, ProductMemorySymmetric (fun x => physicalSmallBigPathPositiveAction n shared B A Δ D
      kbig ω μ qghost ρ Vedge Vghost Vs qsmall (some (.inr k)) F (s, x)) := by
  rw [physical_small_big_path_positive_edge_eq n shared B A Δ D kbig ω μ qghost ρ
    Vedge Vghost Vs qsmall hVs hω hμ hρ hV k F]
  intro s x g σ
  dsimp only
  apply sum_congr rfl
  intro a _
  apply congrArg (fun z : ℂ => (ω k a : ℂ) * z)
  exact physical_small_big_full_positive_memory_symmetric n (shared k) B
    (fun d c => Δ k d c a) (fun d c => D k d c a) μ ρ Vedge
    (fun c => kbig k c a) Vs qsmall F hF s x g σ

theorem physical_small_big_path_positive_ghost_energy_le
    [∀ p : PhysicalPrime Ps, NeZero p.2.val]
    (hVs : ∀ s, 0 < Vs s) (v vmaxGhost : ℝ)
    (hμ : ∀ g p, 0 < μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (j : H) (hq0 : 0 ≤ qghost j) (hq1 : qghost j ≤ 1) (hρ : 0 < ρ)
    (hV : ∀ g, 0 ≤ Vghost g) (hVmax : ∀ g, Vghost g ≤ vmaxGhost) (hv : 0 < v)
    (hD : qghost j / ρ ^ 2 + ((1 - qghost j) / ρ) / v ≤ 1)
    (hC : ∀ g, qghost j / ρ ^ 2 + ((1 - qghost j) * Vghost g / ρ) / v ≤ 1)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (hF : ∀ s, ProductMemorySymmetric (fun x => F (s, x))) :
    physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (physicalSmallBigPathPositiveAction n shared B A Δ D kbig ω μ qghost ρ
        Vedge Vghost Vs qsmall (some (.inl j)) F) ≤
      physicalGhostUniformEnergyBound ρ vmaxGhost v ^ Fintype.card G *
        physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) F := by
  rw [physical_small_big_path_positive_ghost_eq n shared B A Δ D kbig ω μ qghost ρ
    Vedge Vghost Vs qsmall (fun g p => (hμ g p).le) j hq0 F]
  exact physical_small_big_absolute_ghost_energy_le_uniform n Vs hVs μ (qghost j) ρ Vghost v vmaxGhost
    M B hμ hmass hq0 hq1 hρ hV hVmax hv hD hC F hF

end

theorem exists_physical_small_big_path_edge_energy_bound
    {qsmall vs : ℝ} (hq0 : 0 ≤ qsmall) (hq1 : qsmall < 1) (hvs : 0 < vs) (ell : ℕ) :
    ∃ Ccond : ℝ, 1 ≤ Ccond ∧ ∀ (H K S G : Type) [Fintype S] [DecidableEq S]
      [Fintype G] [DecidableEq G]
      (Ps : S → Finset ℕ) [∀ p : PhysicalPrime Ps, NeZero p.2.val]
      (P : G → Type) [∀ g, Fintype (P g)] (n : ∀ g, P g → ℕ)
      [∀ g p, NeZero (n g p)] (J : ℕ) (M : G → ℕ)
      (shared : K → ∀ g, Finset (Fin (M g))) (B : ℕ) (A : K → Type) [∀ k, Fintype (A k)]
      (Δ D : ∀ k, PhysicalSharedLists Ps J → SharedActiveLabels P (shared k) → A k → G → ℤ)
      (kbig : ∀ k, SharedActiveLabels P (shared k) → A k → ℤ)
      (ω : ∀ k, A k → ℝ) (μ : ∀ g, P g → ℝ) (qghost : H → ℝ) (ρ : ℝ)
      (Vedge Vghost : G → ℝ) (Vs : S → ℝ), (∀ s, vs ≤ Vs s) →
      (∀ k a, 0 ≤ ω k a) → (∀ k, ∑ a, ω k a ≤ 1) →
      ∀ (v vmin vmax : ℝ), 0 < ρ → ρ < 1 → 1 < v → 0 < vmin →
      (∀ g, vmin ≤ Vedge g) → (∀ g, Vedge g ≤ vmax) →
      (∀ g p, 0 ≤ μ g p) → (∀ g, ∑ p, μ g p ≤ 2) →
      ∀ (T : ℕ), (∀ k g, (shared k g)ᶜ.card ≤ T) →
      ∀ (k : K) (F : PhysicalSmallBigState Ps J ell
        (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ),
      (∀ s, ProductMemorySymmetric (fun x => F (s, x))) →
      physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
        (physicalSmallBigPathPositiveAction n shared B A Δ D kbig ω μ qghost ρ
          Vedge Vghost Vs qsmall (some (.inr k)) F) ≤
        Ccond ^ (2 * Fintype.card S) * unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
          physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) F := by
  obtain ⟨Ccond, hCcond, hbound⟩ := exists_physical_small_big_phased_energy_bound hq0 hq1 hvs ell
  refine ⟨Ccond, hCcond, ?_⟩
  intro H K S G _ dS _ dG
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  intro Ps _ P _ n _ J M shared B A _ Δ D kbig ω μ qghost ρ Vedge Vghost Vs hVs
    hω hωmass v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht k F hF
  have hVs' : ∀ s, 0 < Vs s := fun s => hvs.trans_le (hVs s)
  rw [physical_small_big_path_positive_edge_eq n shared B A Δ D kbig ω μ qghost ρ
    Vedge Vghost Vs qsmall hVs' hω hμ hρ0.le (fun g => (hvmin.trans_le (hVlo g)).le) k F]
  apply physical_small_big_auxiliary_energy_bound Vs hVs'
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productMemoryWeight_nonneg μ _ hμ (fun g z => hμ g z.1)) (ω k) (hω k) (hωmass k) _ F _
  · exact mul_nonneg (pow_nonneg (zero_le_one.trans hCcond) _)
      (pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _)
  · intro a
    let aux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))) :=
      fun _ j => False.elim (notMem_empty j.val j.property)
    have hh := hbound S G Ps P n J M (shared k) B
      (fun d c => Δ k d c a) (fun d c => D k d c a) μ ρ Vedge (fun c => kbig k c a) Vs hVs
      aux v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T (ht k)
      (fun _ _ => 1) 1 zero_le_one (by intros; simp only [norm_one, le_refl]) F hF
    simp only [one_pow, one_mul] at hh
    convert hh using 1

end Bounty
end

section

/- Whole-path energy follows from the actual positive local actions. Only
the positive comparison must preserve pending symmetry; a bounded signed
phase may inspect the complete path. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def physicalSmallBigPathStepEnergy {H K : Type}
    (A ρ v vmin vmaxEdge vmaxGhost : ℝ) (T smallGroups bigGroups : ℕ) : Option (H ⊕ K) → ℝ
  | none => 1
  | some (.inl _) => physicalGhostUniformEnergyBound ρ vmaxGhost v ^ bigGroups
  | some (.inr _) => A ^ (2 * smallGroups) *
      unrestrictedEdgeEnergyBound ρ v vmin vmaxEdge T ^ bigGroups

theorem physical_small_big_path_step_energy_nonneg {H K : Type}
    (A ρ v vmin vmaxEdge vmaxGhost : ℝ) (T smallGroups bigGroups : ℕ) (hA : 0 ≤ A)
    (tag : Option (H ⊕ K)) :
    0 ≤ physicalSmallBigPathStepEnergy A ρ v vmin vmaxEdge vmaxGhost T smallGroups bigGroups tag := by
  cases tag with
  | none => exact zero_le_one
  | some tag =>
    cases tag with
    | inl j => exact pow_nonneg (Real.exp_pos _).le _
    | inr k =>
      exact mul_nonneg (pow_nonneg hA _)
        (pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmaxEdge T) _)

theorem physical_small_big_varying_ghost_path_energy_of_local
    {H K S G : Type} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} [∀ p : PhysicalPrime Ps, NeZero p.2.val]
    {P : G → Type} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] {J ell : ℕ} {M : G → ℕ}
    (shared : K → ∀ g, Finset (Fin (M g))) (B : ℕ) (A : K → Type) [∀ k, Fintype (A k)]
    (Δ D : ∀ k, PhysicalSharedLists Ps J → SharedActiveLabels P (shared k) → A k → G → ℤ)
    (kbig : ∀ k, SharedActiveLabels P (shared k) → A k → ℤ)
    (ω : ∀ k, A k → ℝ) (μ : ∀ g, P g → ℝ)
    (qghost : H → ℝ) (ρ : ℝ) (Vedge Vghost : G → ℝ) (Vs : S → ℝ) (qsmall : ℝ)
    (hVs : ∀ s, 0 < Vs s) (hμ : ∀ g p, 0 ≤ μ g p)
    (C : Option (H ⊕ K) → ℝ) (hC : ∀ tag, 0 ≤ C tag)
    (hpreserve : ∀ tag (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ), (∀ s, ProductMemorySymmetric (fun x => F (s, x))) →
      ∀ s, ProductMemorySymmetric (fun x =>
        physicalSmallBigPathPositiveAction n shared B A Δ D kbig ω μ qghost ρ
          Vedge Vghost Vs qsmall tag F (s, x)))
    (hlocal : ∀ tag (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ), (∀ s, ProductMemorySymmetric (fun x => F (s, x))) →
      physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
        (physicalSmallBigPathPositiveAction n shared B A Δ D kbig ω μ qghost ρ
          Vedge Vghost Vs qsmall tag F) ≤ C tag *
      physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) F)
    (steps : List (Option (H ⊕ K)))
    (phase : ∀ s, PhysicalSmallBigPath n shared B A Δ D kbig steps s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1)
    (f : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (hf : ∀ s, ProductMemorySymmetric (fun x => f (s, x))) :
    physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (physicalSmallBigPathVaryingGhostAction n shared B A Δ D kbig ω μ qghost ρ
        Vedge Vghost Vs qsmall steps phase f) ≤
      (steps.map C).prod *
        physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  rw [← physical_small_big_energy_eq, ← physical_small_big_energy_eq]
  apply finiteWeightedEnergy_le_of_envelope_domination
    (physicalSmallBigMeasure Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))))
    (physical_small_big_measure_nonneg Vs hVs _
      (productMemoryWeight_nonneg μ _ hμ (fun g z => hμ g z.1))) f _
    (finiteOperatorListAction
      (physicalSmallBigPathPositiveAction n shared B A Δ D kbig ω μ qghost ρ
        Vedge Vghost Vs qsmall) steps)
  · intro s
    exact (physical_small_big_varying_ghost_path_norm_le_positive_list n shared B A Δ D
      kbig ω μ qghost ρ Vedge Vghost Vs qsmall steps phase hphase f s).trans (Complex.re_le_norm _)
  · apply finite_operator_list_energy_le _
      (fun F => ∀ s, ProductMemorySymmetric (fun x => F (s, x))) _ hpreserve C hC
    · intro tag F hF
      simpa only [physical_small_big_energy_eq] using hlocal tag F hF
    · intro s
      exact complexNormEnvelope_memory_symmetric (fun x => f (s, x)) (hf s)

end Bounty
end

section

/- Exact moving-small-state transport between big-memory caps. -/
open Finset Classical
namespace Bounty
section
variable {H K S G : Type} {Ps : S → Finset ℕ} {P : G → Type}
  [Fintype S] [Fintype G]
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : K → ∀ g, Finset (Fin (M g))) (A : K → Type)
  (Δ D : ∀ k, PhysicalSharedLists Ps J → SharedActiveLabels P (shared k) → A k → G → ℤ)
  {b B : ℕ} (h : b ≤ B)
  (kbig : ∀ k, SharedActiveLabels P (shared k) → A k → ℤ)
  (ω : ∀ k, A k → ℝ) (μ : ∀ g, P g → ℝ)
  (qghost : H → ℝ) (ρ : ℝ) (V : G → ℝ) (Vs : S → ℝ) (qsmall : ℝ)

variable [∀ g, Fintype (P g)] [∀ g p, NeZero (n g p)] [∀ k, Fintype (A k)]
  (steps : List (Option (H ⊕ K)))
  (phase : ∀ s, PhysicalSmallBigPath (ell := ell) n shared B A Δ D kbig steps s → ℂ)
  (f : PhysicalSmallBigState Ps J ell
    (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)

theorem physical_small_big_cap_difference
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b))
    (hs : productTotalMemory s.2 ≤ b) :
    physicalSmallBigPathAction n shared B A Δ D kbig ω μ qghost ρ V Vs qsmall steps phase f (physicalSmallBigCapEmbed h s) -
      physicalSmallBigPathAction n shared b A Δ D kbig ω μ qghost ρ V Vs qsmall steps
        (physicalSmallBigCapPhase n shared A Δ D h kbig ω μ qghost ρ V Vs qsmall steps phase)
        (fun s => f (physicalSmallBigCapEmbed h s)) s =
      physicalSmallBigPathAction n shared B A Δ D kbig ω μ qghost ρ V Vs qsmall steps
        (fun s p => if b < physicalSmallBigPathPeak n shared B A Δ D kbig steps s p then phase s p else 0)
        f (physicalSmallBigCapEmbed h s) := by
  rw [physical_small_big_cap_path_action n shared A Δ D h kbig ω μ qghost ρ V Vs qsmall steps phase f s hs]
  let _ : ∀ (k : Option (H ⊕ K)) s, Fintype (PhysicalSmallBigPathEvent (H := H) (ell := ell) n shared B A Δ D k s) :=
    physicalSmallBigPathEventFintype (H := H) (ell := ell) n shared B A Δ D
  exact finite_event_path_action_sub_safe (PhysicalSmallBigPathEvent (H := H) (ell := ell) n shared B A Δ D)
    (physicalSmallBigPathEventTarget n shared B A Δ D kbig)
    (physicalSmallBigPathEventWeight n shared B A Δ D kbig ω μ qghost ρ V Vs qsmall)
    (fun s => productTotalMemory s.2) b steps phase f (physicalSmallBigCapEmbed h s)

theorem physical_small_big_cap_difference_mask
    (I : ℕ) (hIb : I ≤ b)
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b)) :
    (if productTotalMemory s.2 ≤ I then
      physicalSmallBigPathAction n shared B A Δ D kbig ω μ qghost ρ V Vs qsmall steps phase f (physicalSmallBigCapEmbed h s) -
        physicalSmallBigPathAction n shared b A Δ D kbig ω μ qghost ρ V Vs qsmall steps
          (physicalSmallBigCapPhase n shared A Δ D h kbig ω μ qghost ρ V Vs qsmall steps phase)
          (fun s => f (physicalSmallBigCapEmbed h s)) s
      else 0) =
      physicalSmallBigPathAction n shared B A Δ D kbig ω μ qghost ρ V Vs qsmall steps
        (fun s p => if productTotalMemory s.2 ≤ I ∧
          b < physicalSmallBigPathPeak n shared B A Δ D kbig steps s p then phase s p else 0)
        f (physicalSmallBigCapEmbed h s) := by
  by_cases hs : productTotalMemory s.2 ≤ I
  · rw [if_pos hs, physical_small_big_cap_difference n shared A Δ D h kbig ω μ qghost ρ V Vs qsmall steps phase f s (hs.trans hIb)]
    unfold physicalSmallBigPathAction finiteEventPathAction
    apply sum_congr rfl
    intro p _
    simp only [physicalSmallBigCapEmbed, productStateCapEmbed_totalMemory, hs, true_and]
    rfl
  · rw [if_neg hs]
    unfold physicalSmallBigPathAction finiteEventPathAction
    simp only [physicalSmallBigCapEmbed, productStateCapEmbed_totalMemory, hs, false_and, if_false, mul_zero, zero_mul, sum_const_zero]

end
end Bounty
end

section

/- Exact marking of ghost births with moving small states. Edge weights,
residue shifts, and all cap indicators are unchanged. -/
open Finset Classical
namespace Bounty
section
variable {H K S G : Type} {Ps : S → Finset ℕ} {P : G → Type}
  [Fintype S] [Fintype G]
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : K → ∀ g, Finset (Fin (M g))) (B : ℕ) (A : K → Type)
  (Δ D : ∀ k, PhysicalSharedLists Ps J → SharedActiveLabels P (shared k) → A k → G → ℤ)
  (kbig : ∀ k, SharedActiveLabels P (shared k) → A k → ℤ)
  (ω : ∀ k, A k → ℝ) (μ : ∀ g, P g → ℝ)
  (qghost : H → ℝ) (ρ : ℝ) (V : G → ℝ) (Vs : S → ℝ) (qsmall a : ℝ)

theorem physical_small_big_ghost_scale_event (tag : Option (H ⊕ K))
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (e : PhysicalSmallBigPathEvent n shared B A Δ D tag s) :
    physicalSmallBigPathVaryingGhostWeight n shared B A Δ D kbig ω μ qghost ρ
        V (fun g => a * V g) Vs qsmall tag s e =
      a ^ physicalSmallBigEventBirthCount n shared B A Δ D tag s e *
        physicalSmallBigPathEventWeight n shared B A Δ D kbig ω μ qghost ρ V Vs qsmall tag s e := by
  cases tag with
  | none => simp only [physicalSmallBigPathVaryingGhostWeight, physicalSmallBigEventBirthCount,
      pow_zero, one_mul]
  | some tag =>
    cases tag with
    | inl j =>
      change coupledGhostJointEventWeight
          (fun g => physicalGhostRetention (n g) (qghost j) ρ)
          (fun g => physicalGhostTermination (n g) (qghost j) ρ)
          (fun g z => physicalGhostBirth (n g) (qghost j) ρ (a * V g) z)
          (fun g => unrestrictedResidueWeight (μ g)) M B s.2 e =
        a ^ (∑ g, (e g).1.val) *
          coupledGhostJointEventWeight
            (fun g => physicalGhostRetention (n g) (qghost j) ρ)
            (fun g => physicalGhostTermination (n g) (qghost j) ρ)
            (fun g => physicalGhostBirth (n g) (qghost j) ρ (V g))
            (fun g => unrestrictedResidueWeight (μ g)) M B s.2 e
      simp_rw [physicalGhostBirth_scale]
      exact coupledGhostJointEventWeight_birth_scale
        (fun g => physicalGhostRetention (n g) (qghost j) ρ)
        (fun g => physicalGhostTermination (n g) (qghost j) ρ)
        (fun g => physicalGhostBirth (n g) (qghost j) ρ (V g))
        (fun g => unrestrictedResidueWeight (μ g)) a M B s.2 e
    | inr k => simp only [physicalSmallBigPathVaryingGhostWeight, physicalSmallBigEventBirthCount,
        pow_zero, one_mul]

theorem physical_small_big_ghost_scale_path (steps : List (Option (H ⊕ K)))
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (p : PhysicalSmallBigPath (ell := ell) n shared B A Δ D kbig steps s) :
    finiteEventPathWeight (PhysicalSmallBigPathEvent n shared B A Δ D)
        (physicalSmallBigPathEventTarget n shared B A Δ D kbig)
        (physicalSmallBigPathVaryingGhostWeight n shared B A Δ D kbig ω μ qghost ρ
          V (fun g => a * V g) Vs qsmall) steps s p =
      a ^ physicalSmallBigPathBirthCount n shared B A Δ D kbig steps s p *
        finiteEventPathWeight (PhysicalSmallBigPathEvent n shared B A Δ D)
          (physicalSmallBigPathEventTarget n shared B A Δ D kbig)
          (physicalSmallBigPathEventWeight n shared B A Δ D kbig ω μ qghost ρ V Vs qsmall)
          steps s p :=
  finite_event_path_weight_eq_pow_mul (PhysicalSmallBigPathEvent n shared B A Δ D)
    (physicalSmallBigPathEventTarget n shared B A Δ D kbig)
    (physicalSmallBigPathEventWeight n shared B A Δ D kbig ω μ qghost ρ V Vs qsmall)
    (physicalSmallBigPathVaryingGhostWeight n shared B A Δ D kbig ω μ qghost ρ
      V (fun g => a * V g) Vs qsmall)
    (physicalSmallBigEventBirthCount n shared B A Δ D) a
    (physical_small_big_ghost_scale_event n shared B A Δ D kbig ω μ qghost ρ V Vs qsmall a)
    steps s p
end
end Bounty
end

section

/- Actual normalized majorants on the logarithmic Type-II scale box. -/

open MeasureTheory

namespace Bounty

theorem typeII_e_majorant_normalized_eq_one {L e E : ℝ} (hL : 0 < L)
    (ht : e / E ∈ Set.Icc (L ^ (-(88 : ℝ))) 1) :
    typeIIEMajorant (L ^ 88) (e / E) = 1 := by
  apply typeII_e_majorant_log_scale_eq_one hL
  simpa only [Real.rpow_neg hL.le, Real.rpow_ofNat] using ht

theorem typeII_e_majorant_normalized_support {L e E : ℝ} (hL : 0 < L)
    (hnz : typeIIEMajorant (L ^ 88) (e / E) ≠ 0) :
    e / E ∈ Set.Ioo ((L ^ 88)⁻¹ / 2) 2 := by
  have hlo : 1 < 2 * L ^ 88 * (e / E) :=
    lt_of_not_ge (fun h => hnz (typeII_e_majorant_eq_zero (Or.inl h)))
  have hhi : e / E < 2 :=
    lt_of_not_ge (fun h => hnz (typeII_e_majorant_eq_zero (Or.inr h)))
  refine ⟨?_, hhi⟩
  have hp : 0 < L ^ 88 := pow_pos hL _
  have hinv : (L ^ 88) * (L ^ 88)⁻¹ = 1 := mul_inv_cancel₀ hp.ne'
  nlinarith

theorem typeII_n_majorant_normalized_support {n V : ℝ}
    (hnz : typeIINMajorant (n / V) ≠ 0) : n / V ∈ Set.Ioo (1 / 2) 3 := by
  have hlo : 1 < 2 * (n / V) :=
    lt_of_not_ge (fun h => hnz (typeII_n_majorant_eq_zero (Or.inl h)))
  have hhi : n / V < 3 :=
    lt_of_not_ge (fun h => hnz (typeII_n_majorant_eq_zero (Or.inr h)))
  exact ⟨by linarith, hhi⟩

theorem typeII_scaled_exp_log {m U : ℝ} (hm : 0 < m) (hU : 0 < U) :
    U * Real.exp (Real.log (m / U)) = m := by
  rw [Real.exp_log (div_pos hm hU)]
  field_simp

theorem typeII_scale_log_pulled_coordinates {m m' z U V E Z k : ℝ}
    (hm : 0 < m) (hm' : 0 < m') (hz : 0 < z)
    (hU : 0 < U) (hV : 0 < V) (hZ : 0 < Z) (hk : k ≠ 0) :
    typeIIPulledE (U / (2 * k * E))
      (typeIILogCoordinates ![m, m', z] ![U, U, Z]) = ((m' - m) / (2 * k)) / E ∧
    typeIIPulledN (Z / (k * U * V)) (1 / (U * V))
      (typeIILogCoordinates ![m, m', z] ![U, U, Z]) =
        ((m' - m) * z / (k * m * m') + 1 / m) / V := by
  have he := typeII_normalized_e_log_coordinates U E k (Real.log (m / U)) (Real.log (m' / U))
  have hn := typeII_normalized_n_log_coordinates U V Z k (Real.log (m / U))
    (Real.log (m' / U)) (Real.log (z / Z)) hU.ne' hV.ne' hk
  rw [typeII_scaled_exp_log hm hU, typeII_scaled_exp_log hm' hU] at he
  rw [typeII_scaled_exp_log hm hU, typeII_scaled_exp_log hm' hU,
    typeII_scaled_exp_log hz hZ] at hn
  exact ⟨he.symm, hn.symm⟩

theorem typeII_scale_log_cutoff_eq_majorants {A L m m' z U V E Z k : ℝ}
    (hm : 0 < m) (hm' : 0 < m') (hz : 0 < z)
    (hU : 0 < U) (hV : 0 < V) (hZ : 0 < Z) (hk : k ≠ 0)
    (hbox : ∀ i, (typeIILogCoordinates ![m, m', z] ![U, U, Z]) i ∈ Set.Icc (-A) A) :
    typeIIPulledCutoff A (L ^ 88) (U / (2 * k * E)) (Z / (k * U * V)) (1 / (U * V))
      (typeIILogCoordinates ![m, m', z] ![U, U, Z]) =
        typeIIEMajorant (L ^ 88) (((m' - m) / (2 * k)) / E) *
          typeIINMajorant (((m' - m) * z / (k * m * m') + 1 / m) / V) := by
  obtain ⟨he, hn⟩ := typeII_scale_log_pulled_coordinates (E := E) hm hm' hz hU hV hZ hk
  rw [typeIIPulledCutoff, typeII_three_localizer_eq_one hbox, one_mul, he, hn]

theorem typeII_scale_log_cutoff_eq_one {A L m m' z U V E Z k : ℝ}
    (hm : 0 < m) (hm' : 0 < m') (hz : 0 < z)
    (hU : 0 < U) (hV : 0 < V) (hZ : 0 < Z) (hk : k ≠ 0) (hL : 0 < L)
    (hbox : ∀ i, (typeIILogCoordinates ![m, m', z] ![U, U, Z]) i ∈ Set.Icc (-A) A)
    (he : ((m' - m) / (2 * k)) / E ∈ Set.Icc (L ^ (-(88 : ℝ))) 1)
    (hn : ((m' - m) * z / (k * m * m') + 1 / m) / V ∈ Set.Icc 1 2) :
    typeIIPulledCutoff A (L ^ 88) (U / (2 * k * E)) (Z / (k * U * V)) (1 / (U * V))
      (typeIILogCoordinates ![m, m', z] ![U, U, Z]) = 1 := by
  rw [typeII_scale_log_cutoff_eq_majorants hm hm' hz hU hV hZ hk hbox,
    typeII_e_majorant_normalized_eq_one hL he, typeII_n_majorant_eq_one hn, one_mul]

theorem typeII_scale_majorant_fourier_inversion {A L m m' z U V E Z k : ℝ}
    (hm : 0 < m) (hm' : 0 < m') (hz : 0 < z)
    (hU : 0 < U) (hV : 0 < V) (hZ : 0 < Z) (hk : k ≠ 0)
    (hbox : ∀ i, (typeIILogCoordinates ![m, m', z] ![U, U, Z]) i ∈ Set.Icc (-A) A) :
    ((typeIIEMajorant (L ^ 88) (((m' - m) / (2 * k)) / E) *
      typeIINMajorant (((m' - m) * z / (k * m * m') + 1 / m) / V) : ℝ) : ℂ) =
      ∫ ξ : EuclideanSpace ℝ (Fin 3),
        ((∏ i, ((![U, U, Z] : Fin 3 → ℝ) i : ℂ) ^
            (-((2 * Real.pi * ξ i : ℝ) : ℂ) * Complex.I)) *
          ∏ i, ((![m, m', z] : Fin 3 → ℝ) i : ℂ) ^
            (((2 * Real.pi * ξ i : ℝ) : ℂ) * Complex.I)) *
          typeIIPulledFourier A (L ^ 88) (U / (2 * k * E))
            (Z / (k * U * V)) (1 / (U * V)) ξ := by
  rw [← typeII_scale_log_cutoff_eq_majorants hm hm' hz hU hV hZ hk hbox]
  apply typeII_pulled_logarithmic_fourier_inversion
  · intro i
    fin_cases i
    · exact hm
    · exact hm'
    · exact hz
  · intro i
    fin_cases i
    · exact hU
    · exact hU
    · exact hZ

end Bounty
end

section

/- Exact Fourier integral of each valid candidate allocation pattern. -/

open Finset MeasureTheory

namespace Bounty

noncomputable def candidateAllocationFourierTwist (c L : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ)
    (slot : (candidateQIndices c L) × Fin r) (n : ℕ) : ℂ :=
  ((n : ℝ) : ℂ) ^ ((orderedSlotFrequency (fun i => if take i then 1 else 0)
    (activeAllocationFrequencyInput (candidateAllocationActive c L r jStar)
      (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val) ξ)
    ((candidateAllocationOrder c L r).symm slot) : ℂ) * Complex.I)

noncomputable def candidateAllocationFourierScalar (c L : ℝ) (r jStar : ℕ) (R : ℝ)
    (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ) : ℂ :=
  Complex.exp (Complex.I * ((R * ∑ i,
    activeAllocationFrequencyInput (candidateAllocationActive c L r jStar)
      (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val) ξ i : ℝ) : ℂ))

noncomputable def candidateSeparatedAllocationIntegrand (c L : ℝ) (r jStar : ℕ) (R : ℝ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) (F : ℕ → ℕ → ℂ)
    (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ) : ℂ :=
  candidateAllocationFourierScalar c L r jStar R ξ *
    (∑ e ∈ orderedSlotProductSupport
      (fun slot : CandidateTakenSlot c L r take => candidateQSlotChoices c L r jStar slot.val),
    ∑ h ∈ orderedSlotProductSupport
      (fun slot : CandidateRemainingSlot c L r take => candidateQSlotChoices c L r jStar slot.val),
      candidateTakenComplexCoefficient c L r jStar take
        (candidateAllocationFourierTwist c L r jStar take ξ) e *
      candidateRemainingComplexCoefficient c L r jStar take
        (candidateAllocationFourierTwist c L r jStar take ξ) h * F e h) *
    activeAllocationFourierWeight (candidateAllocationRadius r)
      (candidateAllocationActive c L r jStar) take ξ

theorem candidate_allocation_fourier_scalar_norm (c L : ℝ) (r jStar : ℕ) (R : ℝ)
    (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ) :
    ‖candidateAllocationFourierScalar c L r jStar R ξ‖ = 1 :=
  Complex.norm_exp_I_mul_ofReal _

theorem candidate_allocation_fourier_twist_norm (c L : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ)
    (slot : (candidateQIndices c L) × Fin r) {n : ℕ} (hn : 0 < n) :
    ‖candidateAllocationFourierTwist c L r jStar take ξ slot n‖ = 1 := by
  unfold candidateAllocationFourierTwist
  rw [Complex.norm_cpow_eq_rpow_re_of_pos (by exact_mod_cast hn)]
  simp

theorem candidate_allocation_inactive_twist (c L : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hkeep : ∀ i, candidateAllocationActive c L r jStar i = false → take i = false)
    (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ)
    (slot : (candidateQIndices c L) × Fin r) (n : ℕ)
    (ha : candidateAllocationActive c L r jStar ((candidateAllocationOrder c L r).symm slot) = false) :
    candidateAllocationFourierTwist c L r jStar take ξ slot n = 1 := by
  unfold candidateAllocationFourierTwist
  rw [active_allocation_inactive_frequency_zero _ _ _ _ _ ha (hkeep _ ha)]
  simp

theorem candidate_allocation_integrand_separated (c L : ℝ) (r jStar : ℕ) (R : ℝ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot)
    (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ) :
    activeAllocationFourierIntegrand (candidateAllocationRadius r) R
      (fun i => Real.log (candidateAllocationValue c L r jStar x i))
      (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val)
      (candidateAllocationActive c L r jStar) take ξ =
      (candidateAllocationFourierScalar c L r jStar R ξ *
        ∏ slot, candidateAllocationFourierTwist c L r jStar take ξ slot (x slot).val) *
          activeAllocationFourierWeight (candidateAllocationRadius r)
            (candidateAllocationActive c L r jStar) take ξ := by
  rw [active_allocation_prime_powers_separated (candidateAllocationRadius r) R
    (fun i => (candidateAllocationValue c L r jStar x i : ℝ)) _
    (fun i => by exact_mod_cast candidate_allocation_value_pos c L r jStar x i)]
  congr 2
  apply Fintype.prod_equiv (candidateAllocationOrder c L r)
  intro i
  simp only [candidateAllocationFourierTwist, Equiv.symm_apply_apply, candidateAllocationValue]

theorem candidate_separated_allocation_integrand_eq (c L : ℝ) (r jStar : ℕ) (R : ℝ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) (F : ℕ → ℕ → ℂ)
    (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ) :
    (∑ x : ∀ slot, candidateQSlotChoices c L r jStar slot,
      activeAllocationFourierIntegrand (candidateAllocationRadius r) R
        (fun i => Real.log (candidateAllocationValue c L r jStar x i))
        (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val)
        (candidateAllocationActive c L r jStar) take ξ *
        F (candidateAllocatedFactor c L r jStar x take)
          (candidateRetainedFactor c L r jStar 1 x take)) /
        (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ) =
      candidateSeparatedAllocationIntegrand c L r jStar R take F ξ := by
  simp_rw [candidate_allocation_integrand_separated]
  unfold candidateSeparatedAllocationIntegrand
  rw [← candidate_slot_twisted_split_bivariate_test]
  simp only [sum_div, mul_sum, sum_mul]
  apply sum_congr rfl
  intro x hx
  ring

theorem candidate_separated_allocation_integrable (c L : ℝ) (r jStar : ℕ) (R : ℝ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) (F : ℕ → ℕ → ℂ) :
    Integrable (candidateSeparatedAllocationIntegrand c L r jStar R take F) := by
  have h := (integrable_finsetSum (s := (univ : Finset (∀ slot,
      candidateQSlotChoices c L r jStar slot))) (fun x hx =>
    (active_allocation_fourier_integrand_integrable (candidateAllocationRadius r) R
      (fun i => Real.log (candidateAllocationValue c L r jStar x i))
      (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val)
      (candidateAllocationActive c L r jStar) take).mul_const
        (F (candidateAllocatedFactor c L r jStar x take)
          (candidateRetainedFactor c L r jStar 1 x take)))).div_const
      (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ)
  apply h.congr
  exact Filter.Eventually.of_forall (candidate_separated_allocation_integrand_eq c L r jStar R take F)

theorem candidate_compact_allocation_separated_integral (c L : ℝ) (r jStar : ℕ) (R : ℝ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hkeep : ∀ i, candidateAllocationActive c L r jStar i = false → take i = false)
    (F : ℕ → ℕ → ℂ) :
    (∑ x : ∀ slot, candidateQSlotChoices c L r jStar slot,
      (candidateCompactAllocationWeight c L r jStar x R take : ℂ) *
        F (candidateAllocatedFactor c L r jStar x take)
          (candidateRetainedFactor c L r jStar 1 x take)) /
        (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ) =
      ∫ ξ, candidateSeparatedAllocationIntegrand c L r jStar R take F ξ := by
  calc
    _ = ∫ ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ,
        (∑ x : ∀ slot, candidateQSlotChoices c L r jStar slot,
          activeAllocationFourierIntegrand (candidateAllocationRadius r) R
            (fun i => Real.log (candidateAllocationValue c L r jStar x i))
            (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val)
            (candidateAllocationActive c L r jStar) take ξ *
            F (candidateAllocatedFactor c L r jStar x take)
              (candidateRetainedFactor c L r jStar 1 x take)) /
            (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ) := by
      rw [integral_div, integral_finsetSum]
      · congr 1
        apply sum_congr rfl
        intro x hx
        rw [integral_mul_const]
        unfold candidateCompactAllocationWeight
        rw [compact_allocation_fourier_inversion _ _ _ _ _ _ hkeep]
      · intro x hx
        exact (active_allocation_fourier_integrand_integrable _ _ _ _ _ _).mul_const _
    _ = _ := integral_congr_ae (Filter.Eventually.of_forall
      (candidate_separated_allocation_integrand_eq c L r jStar R take F))

end Bounty
end

section

/- A small shared product has no prime factor in a disjoint big pool. -/

open Finset
open scoped Classical
namespace Bounty

section Arithmetic
variable {S G : Type*} [Fintype S] {Ps : S → Finset ℕ} {P : G → Finset ℕ}
  (hPs : ∀ s p, p ∈ Ps s → Nat.Prime p)
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : ∀ s g, Disjoint (Ps s) (P g))
  {J : ℕ} (d : PhysicalSharedLists Ps J)

include hPs hP hdis in
theorem physical_big_prime_not_dvd_small_shared (g : G) (p : ↥(P g)) :
    ¬p.val ∣ physicalSharedProduct d := by
  intro hd
  have hp := hP g p.val p.property
  obtain ⟨s, _, hs⟩ := (hp.prime.dvd_finsetProd_iff _).mp hd
  obtain ⟨j, _, hj⟩ := (hp.prime.dvd_finsetProd_iff _).mp hs
  have he : p.val = (d s j).val :=
    ((Nat.dvd_prime (hPs s _ (d s j).property)).mp hj).resolve_left hp.ne_one
  exact disjoint_left.mp (hdis s g) (d s j).property (he ▸ p.property)

include hPs hP hdis in
theorem physical_big_prime_dvd_small_mul_iff (g : G) (p : ↥(P g)) (D : ℕ) :
    ((p.val : ℤ) ∣ ((physicalSharedProduct d * D : ℕ) : ℤ)) ↔ (p.val : ℤ) ∣ (D : ℤ) := by
  have hn := physical_big_prime_not_dvd_small_shared hPs hP hdis d g p
  have hh : p.val ∣ physicalSharedProduct d * D ↔ p.val ∣ D := by
    rw [(hP g p.val p.property).dvd_mul]
    exact or_iff_right hn
  exact_mod_cast hh

end Arithmetic

section Mixed
variable {S : Type*} [Fintype S] {N J ell : ℕ}
  {Ps : S → Finset ℕ} {P : Fin N → Finset ℕ}
  (hPs : ∀ s p, p ∈ Ps s → Nat.Prime p)
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : ∀ s g, Disjoint (Ps s) (P g))
  (C : Fin N → Finset (Fin J)) (d : PhysicalSharedLists Ps J)

include hPs hP hdis in
theorem physical_mixed_dilation_divisibility
    (c : SharedActiveLabels (fun g => ↥(P g))
      (fun g => physicalFullSharedIndices (ell := ell) (C g)))
    (aux : PhysicalAuxLabels P C) (g : Fin N) (p : ↥(P g)) :
    (p.val : ℤ) ∣ physicalMixedEdgeD C d c aux g ↔
      (p.val : ℤ) ∣ physicalFullEdgeD C c aux g := by
  exact physical_big_prime_dvd_small_mul_iff hPs hP hdis d g p (physicalFullSharedD C c aux)

theorem physical_mixed_delta_effective_big_step (k : ℤ)
    (c : SharedActiveLabels (fun g => ↥(P g))
      (fun g => physicalFullSharedIndices (ell := ell) (C g)))
    (aux : PhysicalAuxLabels P C) (g : Fin N) :
    physicalMixedEdgeDelta C k d c aux g =
      physicalFullEdgeDelta C (k * (physicalSharedProduct d : ℕ)) c aux g := by
  unfold physicalMixedEdgeDelta physicalMixedEdgeD physicalMixedSharedD
    physicalFullEdgeDelta physicalFullEdgeD
  push_cast
  ring

end Mixed
end Bounty
end

section

/- Full compact allocation differs from the original test by one actual large-P tail. -/

open Finset Filter Real

namespace Bounty

theorem exists_candidate_compact_rough_test_reduction {c b q : ℝ}
    (hc : 0 < c) (hb : 0 < b) (hq0 : 0 ≤ q) (hq1 : q < 1)
    {r : ℕ} (hr : 6 ≤ r) :
    ∃ J : ℕ, ∀ jStar : ℕ, J < jStar → ∀ A D : ℝ,
      ∀ᶠ L : ℝ in atTop, ∀ (E : ℝ) (F : ℕ → ℕ → ℂ),
        1 ≤ E → log E ≤ (1-b)*L →
        (∀ u ∈ arithmeticProductWindow 1 (exp L),
          ∀ m ∈ roughDivisors (exp (sqrt L)) (2*u+1), ‖F u m‖ ≤ L^A) →
        ‖(∑ u ∈ arithmeticProductWindow 1 (exp L),
            (candidateCoefficient c L q r jStar u : ℂ)*
              ∑ m ∈ roughDivisors (exp (sqrt L)) (2*u+1), F u m) -
          ∑ u ∈ arithmeticProductWindow 1 (exp L),
            (candidateCompactRangeCoefficient c L q r jStar E u : ℂ)*
              ∑ m ∈ roughDivisors (exp (sqrt L)) (2*u+1), F u m‖ ≤ exp L*L^(-D) := by
  obtain ⟨J,hJ⟩ := exists_candidate_rough_slot_scale (c := c) hb
  refine ⟨J,?_⟩
  intro jStar hj A D
  filter_upwards [eventually_candidate_compact_range_exact hc hb hr jStar (hJ jStar hj),
    eventually_candidate_large_P_rough_power_saving hc hq0 hq1
      (show 0 < b/4 by positivity) r jStar (D+A), eventually_gt_atTop (0 : ℝ)]
    with L hgood htail hL
  intro E F hE hlogE hF
  have hbound := norm_weighted_fiber_deficit_le (arithmeticProductWindow 1 (exp L))
    (fun u => roughDivisors (exp (sqrt L)) (2*u+1))
    (fun u => exp (b/4*L) < (primePoolPart
      ((candidatePIndices c L).biUnion (candidatePBand (c*L))) u : ℝ))
    (candidateCoefficient c L q r jStar)
    (candidateCompactRangeCoefficient c L q r jStar E) F (L^A) (rpow_nonneg hL.le _)
    (fun u hu => (candidate_compact_range_coefficient_bounds c L hq0 r jStar E u).1)
    (fun u hu => (candidate_compact_range_coefficient_bounds c L hq0 r jStar E u).2)
    (fun u hu hnot => hgood E q hE hlogE u hu (le_of_not_gt hnot)) hF
  calc
    _ ≤ L^A*candidateLargePRoughDivisorMass c L q r jStar (exp (b/4*L)) := hbound
    _ ≤ L^A*(exp L*L^(-(D+A))) := mul_le_mul_of_nonneg_left htail (rpow_nonneg hL.le _)
    _ = exp L*L^(-D) := by
      rw [mul_left_comm, ← rpow_add hL]
      congr 2
      ring

theorem exists_candidate_compact_divisor_test_reduction {c b q : ℝ}
    (hc : 0 < c) (hb : 0 < b) (hq0 : 0 ≤ q) (hq1 : q < 1)
    {r : ℕ} (hr : 6 ≤ r) :
    ∃ J : ℕ, ∀ jStar : ℕ, J < jStar → ∀ A D : ℝ,
      ∀ᶠ L : ℝ in atTop, ∀ (E : ℝ) (F : ℕ → ℕ → ℂ),
        1 ≤ E → log E ≤ (1-b)*L →
        (∀ u ∈ arithmeticProductWindow 1 (exp L), ∀ m ∈ (2*u+1).divisors, ‖F u m‖ ≤ L^A) →
        (∀ u ∈ arithmeticProductWindow 1 (exp L), ∀ m ∈ (2*u+1).divisors,
          ¬(∀ p ∈ m.primeFactors, exp (sqrt L) ≤ (p : ℝ)) → F u m = 0) →
        ‖(∑ u ∈ arithmeticProductWindow 1 (exp L),
            (candidateCoefficient c L q r jStar u : ℂ)*∑ m ∈ (2*u+1).divisors, F u m) -
          ∑ u ∈ arithmeticProductWindow 1 (exp L),
            (candidateCompactRangeCoefficient c L q r jStar E u : ℂ)*
              ∑ m ∈ (2*u+1).divisors, F u m‖ ≤ exp L*L^(-D) := by
  obtain ⟨J,hJ⟩ := exists_candidate_compact_rough_test_reduction hc hb hq0 hq1 hr
  refine ⟨J,fun jStar hj A D => ?_⟩
  filter_upwards [hJ jStar hj A D] with L hL
  intro E F hE hlogE hF hsupp
  have heq (a : ℕ → ℂ) :
      (∑ u ∈ arithmeticProductWindow 1 (exp L), a u*∑ m ∈ (2*u+1).divisors, F u m) =
        ∑ u ∈ arithmeticProductWindow 1 (exp L), a u*
          ∑ m ∈ roughDivisors (exp (sqrt L)) (2*u+1), F u m := by
    apply sum_congr rfl
    intro u hu
    rw [rough_supported_divisor_test_eq _ _ _ (hsupp u hu)]
  rw [heq, heq]
  exact hL E F hE hlogE (fun u hu m hm => hF u hu m (mem_filter.mp hm).1)

end Bounty
end

section

/- Real recovered coordinates without finite quotient membership guards. -/

namespace Bounty

theorem typeII_recovered_e_real_of_congruence {y : TypeIIShiftIndex}
    (hmod : Int.ModEq (2 * |y.1.1|) (y.2.1.1 : ℤ) (y.2.2.1 : ℤ)) :
    (typeIIRecoveredE y : ℝ) = typeIIRealE y := by
  have hd := (typeII_signed_modulus_dvd y.1.1 _).mp (Int.modEq_iff_dvd.mp hmod)
  unfold typeIIRecoveredE typeIIRealE
  rw [Int.cast_div_charZero hd]
  push_cast
  rfl

theorem typeII_positive_real_reconstruction {y : TypeIIShiftIndex}
    (hm : 0 < y.2.1.1) (hm' : 0 < y.2.2.1) (hk : y.1.1 ≠ 0)
    (hz : y.1.2 = y.2.2.1 * y.2.1.2)
    (hcross : (y.1.2 : ℤ) + y.1.1 = (y.2.1.1 : ℤ) * y.2.2.2)
    (hc : IsCoprime (y.2.1.1 : ℤ) y.1.1)
    (hmod : Int.ModEq (2 * |y.1.1|) (y.2.1.1 : ℤ) (y.2.2.1 : ℤ))
    (he : 0 < typeIIRealE y) :
    0 < typeIIRecoveredE y ∧ 0 < typeIIRecoveredN y ∧
      ((typeIIRecoveredE y).toNat : ℝ) = typeIIRealE y ∧
      ((typeIIRecoveredN y).toNat : ℝ) = typeIIRealN y := by
  have hEr := typeII_recovered_e_real_of_congruence hmod
  have hE : 0 < typeIIRecoveredE y := by
    have : (0 : ℝ) < typeIIRecoveredE y := hEr ▸ he
    exact_mod_cast this
  have hd : (y.2.1.1 : ℤ) * y.2.2.2 - (y.2.2.1 : ℤ) * y.2.1.2 = y.1.1 := by
    rw [hz, Nat.cast_mul] at hcross
    linarith
  obtain ⟨en, hen, _⟩ := typeII_determinant_from_congruence
    (by exact_mod_cast hm) (by positivity : (0 : ℤ) ≤ y.2.1.2) hk hc hd hmod hE
  have hEq : typeIIRecoveredE y = en.1 := typeII_determinant_e_quotient hk hen.2.2.2.2.1
  have hNq : typeIIRecoveredN y = en.2 := by
    unfold typeIIRecoveredN
    rw [hEq]
    exact typeII_determinant_n_quotient (by exact_mod_cast hm.ne') hen.2.2.1
  have hEc : ((typeIIRecoveredE y).toNat : ℤ) = en.1 := by
    rw [hEq]
    exact Int.toNat_of_nonneg hen.1.le
  have hNc : ((typeIIRecoveredN y).toNat : ℤ) = en.2 := by
    rw [hNq]
    exact Int.toNat_of_nonneg hen.2.1.le
  have hEreal : ((typeIIRecoveredE y).toNat : ℝ) = (en.1 : ℝ) := by exact_mod_cast hEc
  have hNreal : ((typeIIRecoveredN y).toNat : ℝ) = (en.2 : ℝ) := by exact_mod_cast hNc
  have hdet : (y.2.2.1 : ℝ) - y.2.1.1 = 2 * (en.1 : ℝ) * y.1.1 := by
    exact_mod_cast hen.2.2.2.2.1
  have heq : (y.2.1.1 : ℝ) * en.2 = 2 * (en.1 : ℝ) * y.2.1.2 + 1 := by
    exact_mod_cast hen.2.2.1
  have hzr : (y.1.2 : ℝ) = (y.2.2.1 : ℝ) * y.2.1.2 := by exact_mod_cast hz
  have hr := typeII_real_coordinate_algebra
    (by exact_mod_cast hm.ne') (by exact_mod_cast hm'.ne')
    (by exact_mod_cast hk) hdet heq hzr
  exact ⟨hE, hNq ▸ hen.2.1, hEreal.trans hr.1, hNreal.trans hr.2⟩

end Bounty
end

section

/- Actual range-masked allocation with every valid active Fourier integral truncated. -/

open Finset MeasureTheory

namespace Bounty

noncomputable def candidateBoxRangeAllocationMass (c L : ℝ) (r jStar : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) (E R : ℝ) : ℂ :=
  ∑ take : Fin ((candidateQIndices c L).card*r) → Bool,
    if (∀ i, candidateAllocationActive c L r jStar i = false → take i = false) ∧
      (E/L^88 ≤ (candidateAllocatedFactor c L r jStar x take : ℝ) ∧
        (candidateAllocatedFactor c L r jStar x take : ℝ) ≤ E)
    then ∫ ξ, activeAllocationFourierIntegrand (candidateAllocationRadius r) (Real.log E)
      (fun i => Real.log (candidateAllocationValue c L r jStar x i))
      (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val)
      (candidateAllocationActive c L r jStar) take ξ
        ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) R
    else 0

theorem candidate_compact_allocation_invalid_zero (c L : ℝ) (r jStar : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) (E : ℝ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hbad : ¬∀ i, candidateAllocationActive c L r jStar i = false → take i = false) :
    candidateCompactAllocationWeight c L r jStar x (Real.log E) take = 0 := by
  have hb := candidate_compact_allocation_bounds c L r jStar x (Real.log E) take
  apply le_antisymm ?_ hb.1
  by_contra h
  have hp : 0 < candidateAllocationWeight c L r jStar x (Real.log E) take :=
    lt_of_lt_of_le (lt_of_not_ge h) hb.2
  apply hbad
  intro i hi
  exact smooth_allocation_inactive_not_taken _ _ _ _ _ _ hp i hi

theorem candidate_range_box_error (c L : ℝ) (r jStar : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) (E R : ℝ) {err : ℝ}
    (herr : 0 ≤ err)
    (htrunc : ∀ take : Fin ((candidateQIndices c L).card*r) → Bool,
      (∀ i, candidateAllocationActive c L r jStar i = false → take i = false) →
      ‖(candidateCompactAllocationWeight c L r jStar x (Real.log E) take : ℂ) -
        ∫ ξ, activeAllocationFourierIntegrand (candidateAllocationRadius r) (Real.log E)
          (fun i => Real.log (candidateAllocationValue c L r jStar x i))
          (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val)
          (candidateAllocationActive c L r jStar) take ξ
            ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) R‖ ≤ err) :
    ‖(candidateRangeAllocationMass c L r jStar x E : ℂ) -
      candidateBoxRangeAllocationMass c L r jStar x E R‖ ≤
        (2 : ℝ)^((candidateQIndices c L).card*r)*err := by
  classical
  unfold candidateRangeAllocationMass candidateBoxRangeAllocationMass
  rw [Complex.ofReal_sum, ← sum_sub_distrib]
  apply (norm_sum_le _ _).trans
  calc
    _ ≤ ∑ _take : Fin ((candidateQIndices c L).card*r) → Bool, err := by
      apply sum_le_sum
      intro take ht
      by_cases hk : ∀ i, candidateAllocationActive c L r jStar i = false → take i = false
      · by_cases he : E/L^88 ≤ (candidateAllocatedFactor c L r jStar x take : ℝ) ∧
            (candidateAllocatedFactor c L r jStar x take : ℝ) ≤ E
        · simpa only [he, and_true, if_pos hk, if_true] using htrunc take hk
        · simpa only [he, and_false, if_false, Complex.ofReal_zero, sub_self, norm_zero] using herr
      · have hz := candidate_compact_allocation_invalid_zero c L r jStar x E take hk
        simp only [hk, false_and, if_false, hz, ite_self, Complex.ofReal_zero, sub_self, norm_zero]
        exact herr
    _ = _ := by simp

end Bounty
end

section

/- Actual restricted active Fourier weights have the same uniform variation bound. -/

open Finset MeasureTheory

namespace Bounty

theorem active_allocation_box_weight_integrable {N : ℕ} (A R : ℝ)
    (active take : Fin N → Bool) :
    Integrable (activeAllocationFourierWeight A active take) (activeAllocationBoxMeasure active R) :=
  Integrable.fintype_prod (fun i => (typeII_cutoff_fourier_integrable A (take i.val)).integrableOn)

theorem active_allocation_box_l1_le {N : ℕ} (A C R : ℝ)
    (hC1 : 1 ≤ C)
    (hC : ∀ take : Bool, (∫ ξ : ℝ, ‖typeIICutoffFourier A take ξ‖) ≤ C)
    (active take : Fin N → Bool) :
    (∫ ξ, ‖activeAllocationFourierWeight A active take ξ‖
      ∂activeAllocationBoxMeasure active R) ≤ C^N := by
  simp only [activeAllocationFourierWeight, activeAllocationBoxMeasure, norm_prod]
  rw [integral_fintype_prod_eq_prod (fun (i : ActiveAllocationIndex active) (ξ : ℝ) =>
    ‖typeIICutoffFourier A (take i.val) ξ‖)]
  calc
    _ ≤ ∏ _i : ActiveAllocationIndex active, C := by
      apply prod_le_prod₀
      · intro i hi
        exact integral_nonneg (fun ξ => norm_nonneg _)
      · intro i hi
        exact (setIntegral_le_integral (typeII_cutoff_fourier_integrable A (take i.val)).norm
          (Filter.Eventually.of_forall (fun ξ => norm_nonneg _))).trans (hC (take i.val))
    _ = C^Fintype.card (ActiveAllocationIndex active) := by simp
    _ ≤ C^N := pow_le_pow_right₀ hC1 (by
      simpa only [Fintype.card_fin] using Fintype.card_subtype_le (fun i => active i = true))

theorem active_allocation_all_patterns_variation {N : ℕ} (A C R : ℝ)
    (hC1 : 1 ≤ C)
    (hC : ∀ take : Bool, (∫ ξ : ℝ, ‖typeIICutoffFourier A take ξ‖) ≤ C)
    (active : Fin N → Bool) :
    (∑ take ∈ (univ : Finset (Fin N → Bool)).filter
      (fun take => ∀ i, active i = false → take i = false),
      ∫ ξ, ‖activeAllocationFourierWeight A active take ξ‖
        ∂activeAllocationBoxMeasure active R) ≤ (2*C)^N := by
  calc
    _ ≤ ∑ take : Fin N → Bool,
        ∫ ξ, ‖activeAllocationFourierWeight A active take ξ‖
          ∂activeAllocationBoxMeasure active R := by
      apply sum_le_sum_of_subset_of_nonneg (filter_subset _ _)
      intro take ht hnot
      exact integral_nonneg (fun ξ => norm_nonneg _)
    _ ≤ ∑ _take : Fin N → Bool, C^N := sum_le_sum (fun take _ =>
      active_allocation_box_l1_le A C R hC1 hC active take)
    _ = (2*C)^N := by simp [mul_pow]

end Bounty
end

section

/- Iterating the original mixed events from seeded initial primes recovers the exact common birth history. -/

open Classical
namespace Bounty
section History
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ) (steps : List (Option (J ⊕ K)))

noncomputable def fullMixedCommonStepHistoryUpdate (t : ℕ) (tag : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag s)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P)) :
    Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P) :=
  if ht : t < steps.length then
    if htag : steps.get ⟨t, ht⟩ = tag then
      fullMixedCommonHistoryWrite n S B A Δ D steps ⟨t, ht⟩ s
        (fullMixedTaggedOwnerEvent n S B A Δ D steps ⟨t, ht⟩ tag htag s e) history
    else history
  else history

theorem full_mixed_common_step_history_update_owner (u : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (steps.get u) s)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P)) :
    fullMixedCommonStepHistoryUpdate n S B A Δ D steps u.val (steps.get u) s e history =
      fullMixedCommonHistoryWrite n S B A Δ D steps u s e history := by
  unfold fullMixedCommonStepHistoryUpdate
  rw [dif_pos u.isLt, dif_pos rfl]
  rfl

theorem full_mixed_common_path_history_at
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps s)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P))
    (t : ℕ) (ht : t ≤ steps.length) :
    finiteEventPathHistoryAt (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D)
      (fullMixedCommonStepHistoryUpdate n S B A Δ D steps) 0 steps s p
      (fullMixedCommonHistorySeed n B steps s history) t =
      fullMixedCommonPathHistory n S B A Δ D steps s p history t := by
  induction t with
  | zero =>
    rw [finite_event_path_history_at_zero, full_mixed_common_path_history_zero]
  | succ t ih =>
    have hlt : t < steps.length := Nat.lt_of_succ_le ht
    have h := finite_event_path_history_at_succ (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D)
      (fullMixedCommonStepHistoryUpdate n S B A Δ D steps) 0 steps s p
      (fullMixedCommonHistorySeed n B steps s history) ⟨t, hlt⟩
    simp only [Nat.zero_add] at h
    rw [h, ih (Nat.le_of_lt hlt)]
    exact (full_mixed_common_step_history_update_owner n S B A Δ D steps ⟨t, hlt⟩ _ _ _).trans
      (full_mixed_common_path_history_write n S B A Δ D steps s p history ⟨t, hlt⟩)

theorem full_mixed_common_path_history_final
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps s)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P)) :
    finiteEventPathHistoryAt (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D)
      (fullMixedCommonStepHistoryUpdate n S B A Δ D steps) 0 steps s p
      (fullMixedCommonHistorySeed n B steps s history) steps.length =
      fun i => fullMixedCommonBirthLabel n S B A Δ D steps s p (fullMixedCommonBirthOrder M B steps i) := by
  rw [full_mixed_common_path_history_at n S B A Δ D steps s p history steps.length le_rfl,
    full_mixed_common_path_history_complete]

end History
end Bounty
end

section

/- The complete sparse Gram kernel bound for logarithmic phases. -/

open Finset

namespace Bounty

theorem logarithmic_sparse_gram_kernel (a b : ℕ) (U Y t : ℝ)
    (hU : 1 ≤ U) (ha : U ≤ (a : ℝ)) (hb : (b : ℝ) ≤ 2*U) (htY : |t| ≤ Y) :
    ‖∑ n ∈ Icc a b, Complex.exp ((t*Real.log (n : ℝ) : ℝ)*Complex.I)‖ ≤
      24*Real.pi*U/(1+|t|)+216*Real.sqrt Y := by
  by_cases hab : a ≤ b
  · by_cases htU : |t| ≤ U
    · have h := logarithmic_low_frequency_kernel a b U t hU ha hab hb htU
      have hy : 0 ≤ 216*Real.sqrt Y := by positivity
      linarith
    · have h := logarithmic_second_derivative_large t U Y hU hab ha hb
        (le_of_lt (lt_of_not_ge htU)) htY
      have hc : 0 ≤ 24*Real.pi*U/(1+|t|) := by positivity
      linarith
  · rw [Icc_eq_empty_of_lt (lt_of_not_ge hab),sum_empty,norm_zero]
    positivity

end Bounty
end

section

/- A single logarithmic phase estimate across the covered frequency range. -/

open Finset

namespace Bounty

theorem exists_uniform_affine_logarithmic_phase_bound (K : ℕ) (C : ℝ)
    (hK : 2 ≤ K) (hC : 1 ≤ C) :
    ∃ D : ℝ, 0 < D ∧ ∀ (N ε q c u : ℝ) (a b : ℤ),
      1 < N → 0 < ε → ε ≤ 1/2 → (K : ℝ)^2 ≤ N →
      2 ≤ N^(ε/(2*(K : ℝ))) → 0 < q → u ≠ 0 → |u| ≤ N^((K : ℝ)-ε) →
      N ≤ (a : ℝ)+c/q → (b : ℝ)+1+c/q ≤ C*N →
      ‖∑ n ∈ Icc a b, Complex.exp (((u*Real.log (q*(n : ℝ)+c) : ℝ) : ℂ)*Complex.I)‖ ≤
        D*N*(1/|u|+N^(-(ε/((K : ℝ)*(2:ℝ)^(K-1))))) := by
  classical
  let d : ℕ → ℝ := fun k => if hk : 2 ≤ k then
    Classical.choose (exists_affine_logarithmic_derivative_band_bound k C hk hC) else 1
  have hdpos (k : ℕ) : 0 < d k := by
    by_cases hk : 2 ≤ k
    · simpa only [d,dif_pos hk] using
        (Classical.choose_spec (exists_affine_logarithmic_derivative_band_bound k C hk hC)).1
    · simp only [d,dif_neg hk]
      norm_num
  let D := 4*Real.pi*C+∑ k ∈ range (K+1), d k
  have hsum : 0 ≤ ∑ k ∈ range (K+1), d k := sum_nonneg (fun k _ => (hdpos k).le)
  have hCp : 0 < C := by linarith
  have hDpos : 0 < D := by dsimp [D]; positivity
  have hfirst : 4*Real.pi*C ≤ D := by dsimp [D]; linarith
  have hdD (k : ℕ) (hk : k ≤ K) : d k ≤ D := by
    have hh := single_le_sum (fun j (_ : j ∈ range (K+1)) => (hdpos j).le)
      (show k ∈ range (K+1) by simpa using Nat.lt_succ_of_le hk)
    dsimp [D]
    have hp : 0 < 4*Real.pi*C := by positivity
    linarith
  refine ⟨D,hDpos,?_⟩
  intro N ε q c u a b hN hε hεhalf hKN hpow hq hu huK ha hb
  have hNp : 0 < N := by linarith
  have huabs : 0 < |u| := abs_pos.mpr hu
  have hDN : 0 ≤ D*N := by positivity
  by_cases hlow : |u| ≤ Real.pi*N
  · have hlo : q*N ≤ q*(a : ℝ)+c := by
      have hh := mul_le_mul_of_nonneg_left ha hq.le
      field_simp at hh
      nlinarith
    have hhi : q*((b : ℝ)+1)+c ≤ C*q*N := by
      have hh := mul_le_mul_of_nonneg_left hb hq.le
      field_simp at hh
      nlinarith
    have hh := affine_logarithmic_first_bound a b q c N C u hq hNp hC hlo hhi hu hlow
    calc
      _ ≤ 4*Real.pi*C*N/|u| := hh
      _ ≤ D*N/|u| := div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right hfirst hNp.le) huabs.le
      _ = D*N*(1/|u|) := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_left (le_add_of_nonneg_right (by positivity)) hDN
  · have hNu : N ≤ |u| := by
      have hp : N ≤ Real.pi*N := by nlinarith [Real.pi_gt_three]
      exact hp.trans (le_of_lt (lt_of_not_ge hlow))
    obtain ⟨k,hk,hkK,hulo,huhi⟩ := exists_derivative_order_power_band K N |u| ε hN hε hεhalf hNu huK
    have hkspec := (Classical.choose_spec (exists_affine_logarithmic_derivative_band_bound k C hk hC)).2
    have hdk : d k = Classical.choose (exists_affine_logarithmic_derivative_band_bound k C hk hC) := by
      simp only [d,dif_pos hk]
    rw [← hdk] at hkspec
    have hkR : (2 : ℝ) ≤ k := by exact_mod_cast hk
    have hkKR : (k : ℝ) ≤ K := by exact_mod_cast hkK
    have hkN : (k : ℝ)^2 ≤ N := by nlinarith
    have hθ : ε/(2*(K : ℝ)) ≤ ε/(2*(k : ℝ)) :=
      div_le_div_of_nonneg_left hε.le (by positivity) (by linarith)
    have hpowk : 2 ≤ N^(ε/(2*(k : ℝ))) :=
      hpow.trans (Real.rpow_le_rpow_of_exponent_le hN.le hθ)
    have hh := hkspec N ε q c u a b hN.le hε.le (by linarith) hkN hpowk hq hulo huhi ha hb
    have hexp := derivative_decay_exponent_antitone hε.le hk hkK
    have hpowers : N^(-(ε/((k : ℝ)*(2:ℝ)^(k-1)))) ≤
        N^(-(ε/((K : ℝ)*(2:ℝ)^(K-1)))) :=
      Real.rpow_le_rpow_of_exponent_le hN.le (neg_le_neg hexp)
    calc
      _ ≤ d k*N*N^(-(ε/((k : ℝ)*(2:ℝ)^(k-1)))) := hh
      _ ≤ D*N*N^(-(ε/((K : ℝ)*(2:ℝ)^(K-1)))) :=
        mul_le_mul (mul_le_mul_of_nonneg_right (hdD k hkK) hNp.le) hpowers (by positivity) hDN
      _ ≤ _ := mul_le_mul_of_nonneg_left (le_add_of_nonneg_left (by positivity)) hDN

end Bounty
end

section

/- Exact two-factor finite polynomials come with their actual dyadic energy data. -/

open Finset Filter

namespace Bounty

theorem eventually_finite_pair_five_dyad_data {c E : ℝ} (hc : 0 ≤ c) :
    ∀ᶠ L : ℝ in atTop, ∀ (A B : Finset ℕ) (α β : ℕ → ℂ) (UA UB A0 B0 : ℝ),
      0 < UA → 0 < UB → 0 ≤ A0 → 0 ≤ B0 → A0*B0 ≤ L^E →
      (∀ n ∈ A, ‖α n‖ ≤ A0) → (∀ n ∈ B, ‖β n‖ ≤ B0) →
      (∀ n ∈ A, UA ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*UA) →
      (∀ n ∈ B, UB ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*UB) →
      1 ≤ UA*UB/2 → Real.log (8*(UA*UB)) ≤ c*L →
      ∃ (lo hi : Fin 5 → ℕ) (w : Fin 5 → ℕ → ℂ) (U : Fin 5 → ℝ),
        (∀ j, UA*UB/2 ≤ U j ∧ 1 ≤ U j ∧ Real.log (U j) ≤ c*L ∧
          U j ≤ (lo j : ℝ) ∧ (hi j : ℝ) ≤ 2*U j ∧
          (∑ n ∈ Icc (lo j) (hi j), ‖w j n‖^2) ≤ L^(2*E+16)/U j) ∧
        ∀ t : ℝ, (∑ a ∈ A, α a*harmonicMellinWeight t a)*
          (∑ b ∈ B, β b*harmonicMellinWeight t b) =
          ∑ j : Fin 5, ∑ n ∈ Icc (lo j) (hi j),
            w j n*Complex.exp (((Real.log (n : ℝ)*t : ℝ) : ℂ)*Complex.I) := by
  classical
  filter_upwards [eventually_pair_convolution_reciprocal_power_energy (E := E) hc] with L henergy
  intro A B α β UA UB A0 B0 hUA hUB hA0 hB0 hprod hα hβ hA hB hV hlog
  let V := UA*UB
  let α' := fun n => if n ∈ A then α n else 0
  let β' := fun n => if n ∈ B then β n else 0
  have hα' : ∀ n, ‖α' n‖ ≤ A0 := by
    intro n
    dsimp [α']
    split_ifs with hn
    · exact hα n hn
    · simpa only [norm_zero] using hA0
  have hβ' : ∀ n, ‖β' n‖ ≤ B0 := by
    intro n
    dsimp [β']
    split_ifs with hn
    · exact hβ n hn
    · simpa only [norm_zero] using hB0
  refine ⟨(fun j => ⌊(2 : ℝ)^j.val*(V/2)⌋₊+1),
    (fun j => ⌊(2 : ℝ)^(j.val+1)*(V/2)⌋₊),
    (fun _ n => if n ∈ Icc 1 ⌊16*V⌋₊ then
      (∑ d ∈ n.divisors, α' d*β' (n/d))/(n : ℂ) else 0),
    (fun j => (2 : ℝ)^j.val*(V/2)),?_,?_⟩
  · intro j
    have hg := five_dyad_full_geometry hV hlog j
    refine ⟨hg.1,hg.2.1,hg.2.2.1,hg.2.2.2.1,hg.2.2.2.2,?_⟩
    refine (finite_masked_energy_le _ _ _).trans ?_
    apply henergy α' β' A0 B0 _ hA0 hB0 hg.2.1 hg.2.2.1 hprod hα' hβ'
    intro n hn
    obtain ⟨hnlo,hnhi⟩ := mem_Icc.mp hn
    exact ⟨hg.2.2.2.1.trans (Nat.cast_le.mpr hnlo),
      (Nat.cast_le.mpr hnhi).trans hg.2.2.2.2⟩
  · intro t
    exact finite_pair_polynomial_five_dyads A B α β hUA hUB hA hB t

end Bounty
end

