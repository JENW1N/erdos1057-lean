/- Only selected groups receive a baseline and a pending-memory run history. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_group_residue_run_normalization {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ a : PhysicalPrime P, NeZero a.2.val] {J ell : ℕ}
    (groups : Finset G) (V : G → ℝ) (L : ℕ → PhysicalMarkLists P J ell)
    (C : ℕ → G → Finset (Fin J)) (n : ℕ)
    (h : (a : PhysicalPrime P) → ℕ → ZMod a.2.val) (η : ℕ → ℝ) (b : PhysicalPrime P → ℝ)
    (hnew : ∀ j < n, ∀ g ∈ groups,
      (physicalGroupMarks (L (j + 1)) g \ physicalGroupMarks (L j) g).card = ell + (C j g).card)
    (hb : ∀ a : PhysicalPrime P, a.1 ∈ groups →
      b a = 1 - (∑ j ∈ range (n + 1), η j) / a.2.val)
    (hb0 : ∀ a : PhysicalPrime P, a.1 ∈ groups → b a ≠ 0) :
    physicalGroupPathMass V groups C ell n *
      poolPathResidueExpectation (fun a : PhysicalPrime P => a.2.val)
        (physicalPrimeGroups P groups) (range (n + 1))
        (fun a => (range (n + 1)).filter (fun j => a ∈ physicalMarkedPrimes (L j))) h η =
      (∏ a ∈ physicalPrimeGroups P groups, b a) *
        ∏ a ∈ physicalPrimeGroups P groups,
          ghostPhaseRunHistory (fun j => decide (a ∈ physicalMarkedPrimes (L j)))
            (h a) η ((a.2.val : ℝ) * b a)⁻¹ (V a.1) n := by
  classical
  rw [show physicalGroupPathMass V groups C ell n =
    ∏ a ∈ physicalPrimeGroups P groups,
      (V a.1)⁻¹ ^ ghostPhaseRunCount (fun j => decide (a ∈ physicalMarkedPrimes (L j))) n from
        (physical_selected_group_run_weights groups V L C n hnew).symm]
  unfold poolPathResidueExpectation
  rw [← prod_mul_distrib, ← prod_mul_distrib]
  apply prod_congr rfl
  intro a ha
  have hag : a.1 ∈ groups := by simpa [physicalPrimeGroups] using ha
  symm
  simpa only [ZMod.card, decide_eq_true_eq] using
    ghost_phase_run_history_residue_identity
      (fun j => decide (a ∈ physicalMarkedPrimes (L j))) (h a) η (V a.1) n (b a)
      (by simpa only [ZMod.card] using hb a hag) (hb0 a hag)

end Bounty
