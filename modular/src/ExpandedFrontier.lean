section

/- An explicit polynomial bound absorbs the complete harmonic energy scale loss. -/

namespace Bounty

theorem harmonic_energy_scalar_polynomial {A s L N Y : ℝ}
    (hA : 0 ≤ A) (hs : 0 ≤ s) (hL : 1 ≤ L)
    (hcost : 16*(5+Real.log 4+A)^15 ≤ L)
    (hN : 1 ≤ N) (hratio : N/Y ≤ 8)
    (hlog : Real.log N ≤ Real.log 4+4*L+A*L^s*Real.log L) :
    2*(N/Y)*(1+Real.log N)^15 ≤ L^(15*(max 1 s+1)+1) := by
  let p : ℝ := max 1 s+1
  let C : ℝ := 5+Real.log 4+A
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hm0 : 0 ≤ max 1 s := hs.trans (le_max_right _ _)
  have hp0 : 0 ≤ p := add_nonneg hm0 zero_le_one
  have h1 : 1 ≤ L^p := Real.one_le_rpow hL hp0
  have hlin : L ≤ L^p := by
    simpa only [Real.rpow_one] using
      Real.rpow_le_rpow_of_exponent_le hL (show (1 : ℝ) ≤ p by dsimp [p]; linarith)
  have hpow : L^s*Real.log L ≤ L^p := by
    calc
      _ ≤ L^s*L := mul_le_mul_of_nonneg_left (Real.log_le_self hL0.le) (Real.rpow_nonneg hL0.le s)
      _ = L^(s+1) := by rw [Real.rpow_add hL0, Real.rpow_one]
      _ ≤ _ := Real.rpow_le_rpow_of_exponent_le hL (by dsimp [p]; linarith [le_max_right (1 : ℝ) s])
  have hlog4 : 0 ≤ Real.log 4 := Real.log_nonneg (by norm_num)
  have h4 : 4*L ≤ 4*L^p := mul_le_mul_of_nonneg_left hlin (by norm_num)
  have hc : Real.log 4 ≤ Real.log 4*L^p := by
    simpa only [mul_one] using mul_le_mul_of_nonneg_left h1 hlog4
  have ha : A*L^s*Real.log L ≤ A*L^p := by
    simpa only [mul_assoc] using mul_le_mul_of_nonneg_left hpow hA
  have hsum : 1+Real.log N ≤ C*L^p := by dsimp [C]; nlinarith
  have hnonneg : 0 ≤ 1+Real.log N := add_nonneg zero_le_one (Real.log_nonneg hN)
  have hpower : (L^p)^15 = L^(15*p) := by
    rw [← Real.rpow_mul_natCast hL0.le]
    congr 1
    ring
  calc
    _ ≤ 16*(1+Real.log N)^15 := mul_le_mul_of_nonneg_right (by linarith) (pow_nonneg hnonneg _)
    _ ≤ 16*(C*L^p)^15 := mul_le_mul_of_nonneg_left
      (pow_le_pow_left₀ hnonneg hsum 15) (by norm_num)
    _ = (16*C^15)*L^(15*p) := by rw [mul_pow, hpower]; ring
    _ ≤ L*L^(15*p) := mul_le_mul_of_nonneg_right hcost (Real.rpow_nonneg hL0.le _)
    _ = _ := by
      change L*L^(15*p) = L^(15*p+1)
      rw [Real.rpow_add hL0, Real.rpow_one]
      exact mul_comm _ _

end Bounty
end

section

/- The exact memory product of a merged selected path reduces to the big
selected data with the original small labels retained in its coefficient. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_selected_split_memory_labeled
    {I G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell n : ℕ}
    (small : G → Prop) (patterns : Finset I) (C : I → G → Finset (Fin J))
    (pattern : Fin n → patterns)
    (ds : PhysicalGroupSelectedData (fun g : {g // small g} => P g.val) ell
      (fun j g => C (pattern j).val g.val))
    (db : PhysicalGroupSelectedData (fun g : {g // ¬small g} => P g.val) ell
      (fun j g => C (pattern j).val g.val))
    (V : G → ℝ) (ζ : I → ℝ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (j : Fin n) :
    let d := (physicalGroupSelectedSplit small (fun j => C (pattern j).val)).symm (ds, db)
    let a : PhysicalEdgeLabels P J ell patterns C := (d.2.2.1 j, d.2.2.2 j, ⟨pattern j, d.1 j⟩)
    physicalMemoryLabeledScalar (fun g : {g // ¬small g} => V g.val) patterns
      (fun i g => C i g.val) (fun _ => 0)
      (physicalFixedEdgeBigCoefficient small patterns C ζ K a (d.2.1 j.castSucc) (d.2.1 j.succ))
      (physicalRestrictedEdge (fun g => ¬small g) patterns C a)
      (fun g => d.2.1 j.castSucc g.val) (fun g => d.2.1 j.succ g.val) =
    (Fintype.card (PhysicalPermutations {g // ¬small g} J ell) : ℂ)⁻¹ *
      (Fintype.card (PhysicalPermutations {g // ¬small g} J ell) : ℂ)⁻¹ *
      (if physicalListAdmissible (fun g => C (pattern j).val g.val) (db.1 j)
        (physicalPermuteLabels (db.2.2.1 j) (db.2.1 j.castSucc))
        (physicalPermuteLabels (db.2.2.2 j) (db.2.1 j.succ)) then
        (physicalAuxMass (fun g : {g // ¬small g} => V g.val)
          (fun g => C (pattern j).val g.val) (db.1 j) : ℂ) *
        physicalCoupledBigCoefficient small (C (pattern j).val) (ζ (pattern j).val) (K (pattern j).val)
          (physicalPermuteLabels (ds.2.2.1 j) (ds.2.1 j.castSucc))
          (physicalPermuteLabels (ds.2.2.2 j) (ds.2.1 j.succ)) (ds.1 j)
          (physicalPermuteLabels (db.2.2.1 j) (db.2.1 j.castSucc))
          (physicalPermuteLabels (db.2.2.2 j) (db.2.1 j.succ)) (db.1 j)
        else 0) := by
  dsimp only
  let d := (physicalGroupSelectedSplit small (fun j => C (pattern j).val)).symm (ds, db)
  have hb := congrArg Prod.snd
    ((physicalGroupSelectedSplit small (fun j => C (pattern j).val)).apply_symm_apply (ds, db))
  have hbl (i) : (fun g : {g // ¬small g} => d.2.1 i g.val) = db.2.1 i :=
    congrArg (fun x => x.2.1 i) hb
  have hbs : (fun g : {g // ¬small g} => d.2.2.1 j g.val) = db.2.2.1 j :=
    congrArg (fun x => x.2.2.1 j) hb
  have hbt : (fun g : {g // ¬small g} => d.2.2.2 j g.val) = db.2.2.2 j :=
    congrArg (fun x => x.2.2.2 j) hb
  have hba : (fun g : {g // ¬small g} => d.1 j g.val) = db.1 j :=
    congrArg (fun x => x.1 j) hb
  simp only [physicalMemoryLabeledScalar, physicalRestrictedEdge,
    physical_phase_zero_frequency, mul_one]
  change _ = _
  rw [hbl, hbl, hbs, hbt, hba]
  rw [physical_selected_split_fixed_coefficient]

end Bounty
end

section

/- Both actual harmonic replacement errors on the same positive support. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_positive_harmonic_replacement_error
    {G : Type*} [Fintype G] [dG : DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    {v : ℝ} (hv : 0 < v) (hV : ∀ g, v ≤ V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1/(p : ℝ) = V g)
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ) (hξ : 0 < ξ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
    (a b : ℝ) {Z : ℝ} (hZ : 0 < Z) (k : ℤ) (hk : |(k : ℝ)| ≤ Z)
    {Pmin ε : ℝ} (hPmin : 0 < Pmin) (hε : 0 ≤ ε)
    (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (pool : Finset ℕ) (hpool : ∀ g, P g ⊆ pool) (α β γ α' β' γ' : ℕ → ℂ)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ n, ‖γ n‖ ≤ C)
    (hα' : ∀ m, ‖α' m‖ ≤ A) (hβ' : ∀ p, ‖β' p‖ ≤ B) (hγ' : ∀ n, ‖γ' n‖ ≤ C)
    (herror : ∀ n ∈ harmonicPositiveSupport Z k (physicalFreeFactor (repeatedBigPrimePatternCut probes r t i) aux),
      let cut := repeatedBigPrimePatternCut probes r t i
      let δ : ℤ := k*(physicalFreeFactor cut aux : ℤ)
      let H := repeatedBigPrimePatternBound probes r t Q ξ i
      (∑ g, (J-(cut g).card : ℕ) *
        (Real.log n.natAbs / Real.log 2 + Real.log (n+δ).natAbs / Real.log 2 + J) /
          (V g*Pmin)) * (H+H/(1/2 : ℝ)^(2*∑ g : G, (J-(cut g).card))) ≤ ε) :
    let cut := repeatedBigPrimePatternCut probes r t i
    let d := physicalFreeFactor cut aux
    let N := ⌈3*Z*(d : ℝ)⌉₊
    let Y := Z*(d : ℝ)/2
    let M := (markedDivisorBound (1/2) v (ell+J))^Fintype.card G
    let energy := 2*((N : ℝ)/Y)*(1+Real.log N)^15
    let H := repeatedBigPrimePatternBound probes r t Q ξ i
    ‖physicalPositiveHarmonicDifference P V probes r t hrt Q h ξ i aux a b Z k pool α β γ α' β' γ'‖ ≤
      (M*M*(A*B*C)^2*energy)*ε +
      (2*M*M*(A*B*C)^2*energy*H)*(∑ p ∈ physicalFreePrimeSet cut aux, 1/(p : ℝ)) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  let cut := repeatedBigPrimePatternCut probes r t i
  let d := physicalFreeFactor cut aux
  let δ : ℤ := k*(d : ℤ)
  let N := ⌈3*Z*(d : ℝ)⌉₊
  let S := harmonicPositiveSupport Z k d
  let θ := fun n : ℤ => (typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) : ℂ)
  let F := fun n : ℤ => θ n/(n : ℂ)*star (invariantTripleEndpoint pool α β γ n.natAbs)*
    invariantTripleEndpoint pool α' β' γ' (n+δ).natAbs
  have hd : 0 < d := prod_pos (fun g _ => prod_pos (fun u _ => (hprime g _ (aux g u).property).pos))
  have hs := harmonic_positive_error_parameters hZ k hd hk
  have hshared := physical_prime_harmonic_pair_error P V probes hprime hdis hv hV hMass
    r t hrt Q h ξ hξ i aux a b hPmin hε hp pool α β γ α' β' γ' hA hB hC
    hα hβ hγ hα' hβ' hγ' S δ N (fun n hn => (hs.2 n hn).1)
    (fun n hn => (hs.2 n hn).2.1) hs.1 (by norm_num : (0 : ℝ) ≤ 2)
    (fun n hn => (hs.2 n hn).2.2.1) θ (fun n hn => (hs.2 n hn).2.2.2) herror
  have haux := physical_prime_aux_harmonic_error P V probes hprime hv hV r t hrt Q h ξ hξ
    i aux a b k pool hpool α β γ α' β' γ' hA hB hC hα hβ hγ hα' hβ' hγ' S N
    (fun n hn => (hs.2 n hn).1)
    (fun n hn => ⟨(hs.2 n hn).2.1.1.le, (hs.2 n hn).2.1.2⟩)
    hs.1 (by norm_num : (0 : ℝ) ≤ 2) (fun n hn => (hs.2 n hn).2.2.1)
    θ (fun n hn => (hs.2 n hn).2.2.2)
  have hdec := physical_prime_harmonic_decomposition P V probes r t hrt Q h ξ i aux a b S δ F
  apply (congrArg norm hdec).trans_le
  apply ((norm_add_le _ _).trans (add_le_add hshared haux)).trans_eq
  ring

end Bounty
end

section

/- The exact unrestricted main term already present in the harmonic difference. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def physicalFreePositiveHarmonicMain {G : Type*} [Fintype G] [DecidableEq G]
    {J ell : ℕ} (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
    (a b Z : ℝ) (k : ℤ) (pool : Finset ℕ) (α β γ α' β' γ' : ℕ → ℂ) : ℂ :=
  let cut := repeatedBigPrimePatternCut probes r t i
  let d := physicalFreeFactor cut aux
  let δ : ℤ := k*(d : ℤ)
  let marks := fun g => ell+(cut g).card
  let W := fun n : ℤ => markedDivisorWeight univ P (1/2) V marks n
  let S := harmonicPositiveSupport Z k d
  let F := fun n : ℤ => ((typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) : ℂ)/(n : ℂ)) *
    star (invariantTripleEndpoint pool α β γ n.natAbs) *
    invariantTripleEndpoint pool α' β' γ' (n+δ).natAbs
  ∑ n ∈ S, F n * ((W n.natAbs * W (n+δ).natAbs : ℝ) : ℂ) *
    groupMarkedAverage P marks (n.natAbs : ℤ) (fun u =>
      groupMarkedAverage P marks ((n+δ).natAbs : ℤ)
        (physicalFreePrimePairCoefficient P V probes r t hrt Q h ξ i aux a b n.natAbs (n+δ).natAbs u))

theorem physical_positive_harmonic_difference_eq_main {G : Type*} [Fintype G] [DecidableEq G]
    {J ell : ℕ} (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
    (a b Z : ℝ) (k : ℤ) (pool : Finset ℕ) (α β γ α' β' γ' : ℕ → ℂ) :
    let cut := repeatedBigPrimePatternCut probes r t i
    let d := physicalFreeFactor cut aux
    let δ : ℤ := k*(d : ℤ)
    physicalPositiveHarmonicDifference P V probes r t hrt Q h ξ i aux a b Z k pool α β γ α' β' γ' =
      (∑ n ∈ harmonicPositiveSupport Z k d,
        ((typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) : ℂ)/(n : ℂ)) *
          star (invariantTripleEndpoint pool α β γ n.natAbs) *
          invariantTripleEndpoint pool α' β' γ' (n+δ).natAbs *
          physicalFullPairCorrelation P cut V (1/2) n.natAbs (n+δ).natAbs
            (physicalOriginalPrimePairCoefficient P V probes r t hrt Q h ξ i aux a b n.natAbs (n+δ).natAbs)) -
      physicalFreePositiveHarmonicMain P V probes r t hrt Q h ξ i aux a b Z k pool α β γ α' β' γ' := rfl

end Bounty
end

section

/- The original harmonic cutoff separates exactly from the auxiliary free product. -/

open Finset MeasureTheory
namespace Bounty

theorem harmonic_mellin_sum_phase {S : Finset ℤ} {Z : ℝ} {d : ℕ}
    (hZ : Z ≠ 0) (hd : d ≠ 0) (hn : ∀ n ∈ S, n ≠ 0)
    (c : ℤ → ℂ) (v : ℝ) :
    (∑ n ∈ S, c n*physicalMellinPhase v ((n : ℝ)/(Z*(d : ℝ)))) =
      physicalPhase (-v) d*∑ n ∈ S, c n*physicalMellinPhase v ((n : ℝ)/Z) := by
  rw [mul_sum]
  apply sum_congr rfl
  intro n hmem
  have hnr : (n : ℝ) ≠ 0 := by exact_mod_cast hn n hmem
  rw [← physical_mellin_phase_ratio v (n : ℝ) Z d hnr hZ hd]
  ring

theorem harmonic_separated_mellin_integrable {S : Finset ℤ} {Z : ℝ} {d : ℕ}
    (hZ : Z ≠ 0) (hd : d ≠ 0) (hn : ∀ n ∈ S, n ≠ 0) (c : ℤ → ℂ) :
    Integrable (fun v : ℝ => harmonicLogFourier v*physicalPhase (-(2*Real.pi*v)) d*
      ∑ n ∈ S, c n*physicalMellinPhase (2*Real.pi*v) ((n : ℝ)/Z)) := by
  have hi := finite_mellin_sum_integrable S harmonicLogFourier (fun v => 2*Real.pi*v)
    harmonic_log_fourier_integrable (by fun_prop) c (fun n => (n : ℝ)/(Z*(d : ℝ)))
  apply hi.congr
  exact Filter.Eventually.of_forall (fun v => by
    dsimp only
    rw [harmonic_mellin_sum_phase hZ hd hn c]
    ring)

theorem harmonic_sum_eq_separated_mellin {S : Finset ℤ} {Z : ℝ} {d : ℕ}
    (hZ : 0 < Z) (hd : 0 < d) (hn : ∀ n ∈ S, 0 < n) (c : ℤ → ℂ) :
    (∑ n ∈ S, (typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) : ℂ)*c n) =
      ∫ v : ℝ, harmonicLogFourier v*physicalPhase (-(2*Real.pi*v)) d*
        ∑ n ∈ S, c n*physicalMellinPhase (2*Real.pi*v) ((n : ℝ)/Z) := by
  have hn0 : ∀ n ∈ S, n ≠ 0 := fun n h => (hn n h).ne'
  calc
    _ = ∑ n ∈ S, c n*(typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) : ℂ) := by
      apply sum_congr rfl
      intro n _
      exact mul_comm _ _
    _ = ∫ v : ℝ, harmonicLogFourier v*
        ∑ n ∈ S, c n*physicalMellinPhase (2*Real.pi*v) ((n : ℝ)/(Z*(d : ℝ))) := by
      apply finite_mellin_sum_representation S harmonicLogFourier (fun v => 2*Real.pi*v)
        harmonic_log_fourier_integrable (by fun_prop) c _ (fun t => (typeIIHarmonicDyadic t : ℂ))
      intro n hmem _
      apply harmonic_dyadic_mellin_representation
      have hnr : (0 : ℝ) < n := by exact_mod_cast hn n hmem
      exact div_pos hnr (mul_pos hZ (by exact_mod_cast hd))
    _ = _ := by
      apply integral_congr_ae
      exact Filter.Eventually.of_forall (fun v => by
        dsimp only
        rw [harmonic_mellin_sum_phase hZ.ne' hd.ne' hn0 c]
        ring)

end Bounty
end

section

/- An auxiliary-independent finite support for the actual cell-localized harmonic cutoff. -/

open Finset
namespace Bounty

noncomputable def harmonicCommonSupport (Y : ℝ) : Finset ℤ :=
  Icc ⌈Y/8⌉ ⌊4*Real.exp 2*Y⌋

theorem mem_harmonic_common_support {Y : ℝ} {n : ℤ} :
    n ∈ harmonicCommonSupport Y ↔ Y/8 ≤ (n : ℝ) ∧ (n : ℝ) ≤ 4*Real.exp 2*Y := by
  simp only [harmonicCommonSupport, mem_Icc, Int.ceil_le, Int.le_floor]

theorem harmonic_common_support_positive {Y : ℝ} (hY : 0 < Y) {n : ℤ}
    (hn : n ∈ harmonicCommonSupport Y) : 0 < n := by
  have hnr : (0 : ℝ) < n := (div_pos hY (by norm_num)).trans_le
    (mem_harmonic_common_support.mp hn).1
  exact_mod_cast hnr

theorem harmonic_positive_support_subset_common {Z H : ℝ} (hZ : 0 < Z) (hH : 0 < H)
    {d : ℕ} (hHd : H ≤ (d : ℝ)) (hdH : (d : ℝ) ≤ Real.exp 2*H) (k : ℤ) :
    harmonicPositiveSupport Z k d ⊆ harmonicCommonSupport (Z*H) := by
  intro n hn
  have hs := mem_harmonic_positive_support hn
  apply mem_harmonic_common_support.mpr
  have hY : 0 < Z*H := mul_pos hZ hH
  have hlow := mul_le_mul_of_nonneg_left hHd hZ.le
  have hupp := mul_le_mul_of_nonneg_left hdH hZ.le
  have he : 0 < Real.exp 2 := Real.exp_pos _
  constructor <;> nlinarith [hs.2.1, hs.2.2.1]

theorem harmonic_nonzero_mem_positive_support {Z H : ℝ} (hZ : 0 < Z) (hH : 0 < H)
    {d : ℕ} (hHd : H ≤ (d : ℝ)) (hdH : (d : ℝ) ≤ Real.exp 2*H)
    {k n : ℤ} (hk : |(k : ℝ)| ≤ Z/4)
    (hψ : typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) ≠ 0) :
    n ∈ harmonicPositiveSupport Z k d := by
  have hd : (0 : ℝ) < d := hH.trans_le hHd
  have hZd : 0 < Z*(d : ℝ) := mul_pos hZ hd
  have hs := typeII_harmonic_dyadic_support hψ
  have hlo := (lt_div_iff₀ hZd).mp hs.1
  have hhi := (div_lt_iff₀ hZd).mp hs.2
  have hw := harmonic_common_window_of_scale hZ hH hHd hdH hk hψ
  have hn0 : 0 < n := by
    have hnr : (0 : ℝ) < n := (div_pos (mul_pos hZ hH) (by norm_num)).trans hw.1.1
    exact_mod_cast hnr
  have hshift : 0 < n+k*(d : ℤ) := by
    have hz : (0 : ℝ) < (n+k*(d : ℤ) : ℤ) :=
      (div_pos (mul_pos hZ hH) (by norm_num)).trans hw.2.1
    exact_mod_cast hz
  exact mem_filter.mpr ⟨mem_Icc.mpr ⟨by omega, Int.le_floor.mpr (by simpa only [mul_assoc] using hhi.le)⟩,
    by linarith, hshift⟩

theorem harmonic_sum_common_support {Z H : ℝ} (hZ : 0 < Z) (hH : 0 < H)
    {d : ℕ} (hHd : H ≤ (d : ℝ)) (hdH : (d : ℝ) ≤ Real.exp 2*H)
    {k : ℤ} (hk : |(k : ℝ)| ≤ Z/4) (c : ℤ → ℂ) :
    (∑ n ∈ harmonicPositiveSupport Z k d,
      (typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) : ℂ)*c n) =
    ∑ n ∈ harmonicCommonSupport (Z*H),
      (typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) : ℂ)*c n := by
  apply sum_subset (harmonic_positive_support_subset_common hZ hH hHd hdH k)
  intro n _ hn
  have hz : typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) = 0 := by
    by_contra hne
    exact hn (harmonic_nonzero_mem_positive_support hZ hH hHd hdH hk hne)
  rw [hz, Complex.ofReal_zero, zero_mul]

theorem harmonic_common_cutoff_insert {Z H : ℝ} (hZ : 0 < Z) (hH : 0 < H)
    {d : ℕ} (hHd : H ≤ (d : ℝ)) (hdH : (d : ℝ) ≤ Real.exp 2*H)
    {k : ℤ} (hk : |(k : ℝ)| ≤ Z/4) (n : ℤ) :
    (typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) : ℂ) =
      (typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) : ℂ)*
        (harmonicCommonCutoff ((n : ℝ)/(Z*H)) : ℂ)*
        (harmonicCommonCutoff (((n+k*(d : ℤ) : ℤ) : ℝ)/(Z*H)) : ℂ) := by
  by_cases hz : typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) = 0
  · simp only [hz, Complex.ofReal_zero, zero_mul]
  have hs := harmonic_common_window_of_scale hZ hH hHd hdH hk hz
  have hY := mul_pos hZ hH
  rw [harmonic_common_cutoff_scaled_eq_one hY ⟨hs.1.1.le, hs.1.2.le⟩,
    harmonic_common_cutoff_scaled_eq_one hY ⟨hs.2.1.le, hs.2.2.le⟩]
  norm_num

end Bounty
end

section

/- The fixed smooth logarithmic Fourier weight for the common source cutoff divided by its argument. -/

open MeasureTheory
open scoped FourierTransform ContDiff

namespace Bounty

noncomputable def harmonicSourceLogCutoff (u : ℝ) : ℂ :=
  ((harmonicCommonCutoff (Real.exp u) / Real.exp u : ℝ) : ℂ)

theorem harmonic_source_log_cutoff_contDiff : ContDiff ℝ ∞ harmonicSourceLogCutoff := by
  apply Complex.ofRealCLM.contDiff.comp
  exact (harmonic_common_cutoff_contDiff.comp Real.contDiff_exp).div
    Real.contDiff_exp (fun u => Real.exp_ne_zero u)

theorem harmonic_source_log_cutoff_support {u : ℝ} (hu : harmonicSourceLogCutoff u ≠ 0) :
    u ∈ Set.Icc (-Real.log 8) (Real.log 4 + 2) := by
  have hcut : harmonicCommonCutoff (Real.exp u) ≠ 0 := by
    intro hz
    apply hu
    simp only [harmonicSourceLogCutoff, hz, zero_div, Complex.ofReal_zero]
  have hs := harmonic_common_cutoff_support hcut
  have hlo := Real.log_lt_log (by norm_num : (0 : ℝ) < 1/8) hs.1
  have hhi := Real.log_lt_log (Real.exp_pos u) hs.2
  rw [Real.log_div (by norm_num : (1 : ℝ) ≠ 0) (by norm_num : (8 : ℝ) ≠ 0),
    Real.log_one, zero_sub, Real.log_exp] at hlo
  rw [Real.log_exp, Real.log_mul (by norm_num : (4 : ℝ) ≠ 0) (Real.exp_ne_zero 2),
    Real.log_exp] at hhi
  exact ⟨hlo.le, hhi.le⟩

theorem harmonic_source_log_cutoff_hasCompactSupport : HasCompactSupport harmonicSourceLogCutoff := by
  apply HasCompactSupport.intro (K := Set.Icc (-Real.log 8) (Real.log 4 + 2)) isCompact_Icc
  intro u hu
  by_contra hne
  exact hu (harmonic_source_log_cutoff_support hne)

noncomputable def harmonicSourceLogSchwartz : SchwartzMap ℝ ℂ :=
  harmonic_source_log_cutoff_hasCompactSupport.toSchwartzMap harmonic_source_log_cutoff_contDiff

noncomputable def harmonicSourceLogFourier : SchwartzMap ℝ ℂ := 𝓕 harmonicSourceLogSchwartz

theorem harmonic_source_log_fourier_integrable : Integrable harmonicSourceLogFourier :=
  harmonicSourceLogFourier.integrable

theorem harmonic_source_log_fourier_moment_integrable (M : ℕ) :
    Integrable (fun v : ℝ => ‖v‖^M * ‖harmonicSourceLogFourier v‖) :=
  harmonicSourceLogFourier.integrable_pow_mul volume M

theorem harmonic_source_log_fourier_inversion (u : ℝ) :
    harmonicSourceLogCutoff u = ∫ v : ℝ,
      Complex.exp ((2*Real.pi*v*u : ℝ)*Complex.I) * harmonicSourceLogFourier v := by
  have hi := congrArg (fun f : SchwartzMap ℝ ℂ => f u)
    (FourierPair.fourierInv_fourier_eq (E := SchwartzMap ℝ ℂ)
      (F := SchwartzMap ℝ ℂ) harmonicSourceLogSchwartz)
  rw [SchwartzMap.fourierInv_coe, Real.fourierInv_eq'] at hi
  change (∫ v : ℝ, Complex.exp ((2*Real.pi*inner ℝ v u : ℝ)*Complex.I) •
    harmonicSourceLogFourier v) = harmonicSourceLogCutoff u at hi
  rw [← hi]
  apply integral_congr_ae
  filter_upwards [] with v
  simp only [RCLike.inner_apply, starRingEnd_apply, star_trivial, smul_eq_mul]
  congr 2
  push_cast
  ring

theorem harmonic_source_log_fourier_rapid_tail (M : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ R : ℝ, 1 ≤ R →
      (∫ v in {v : ℝ | R < ‖v‖}, ‖harmonicSourceLogFourier v‖) ≤ C*R^(-(M : ℝ)) :=
  schwartz_norm_rapid_tail harmonicSourceLogFourier M

end Bounty
end

