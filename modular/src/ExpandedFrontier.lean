theorem unrestricted_coupled_fiber_average_energy_le
    {C G : Type*} [Fintype C] [Fintype G] [DecidableEq G]
    {A : C → Type*} [∀ c, Fintype (A c)]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (Δ D : ∀ c, A c → G → ℤ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (t : G → ℕ) (B : ℕ)
    (κ : C → ℝ) (ν : ∀ c, A c → ℝ)
    (hκ : ∀ c, 0 ≤ κ c) (hν : ∀ c a, 0 ≤ ν c a)
    (hνmass : ∀ c, ∑ a, ν c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, t g ≤ T)
    (phase : ∀ c a, UnrestrictedProductPhase n (Δ c a) (D c a) t B)
    (hphase : ∀ c a s e, ‖phase c a s e‖ ≤ 1)
    (f : C → ProductBoundedOrderedState P
      (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ∀ c, ProductMemorySymmetric (f c)) :
    finiteFiberEnergy κ
      (fun _ => productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (finiteFiberAverage ν
        (fun c a => unrestrictedCoupledCutoffProductOperator n (Δ c a) (D c a)
          μ ρ V t B (phase c a)) f) ≤
    unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
      finiteFiberEnergy κ
        (fun _ => productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  apply finite_fiber_average_energy_le κ
    (fun _ => productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) ν hκ
    (fun _ => productMemoryWeight_nonneg μ (fun g => unrestrictedResidueWeight (μ g))
      hμ (fun g z => hμ g z.1)) hν hνmass
    (fun c a => unrestrictedCoupledCutoffProductOperator n (Δ c a) (D c a)
      μ ρ V t B (phase c a)) f
    (pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _)
  intro c a
  exact unrestricted_coupled_cutoff_product_energy_le n (Δ c a) (D c a) μ ρ V t B
    hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht (phase c a) (hphase c a) (f c) (hf c)
end

section
open Finset
def physicalGroupPhaseActivity {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (L : PhysicalMarkLists P J ell) (g : G) (p : ↥(P g)) : Bool :=
  decide (p.val ∈ physicalGroupMarks L g)

def physicalGroupPhaseDelta {G : Type*} {P : G → Finset ℕ}
    (n m : ℤ) (g : G) (p : ↥(P g)) : ZMod p.val :=
  ((n - m : ℤ) : ZMod p.val)

theorem physical_group_phase_activity_iff {G : Type*} {P : G → Finset ℕ}
    {J ell : ℕ} (L : PhysicalMarkLists P J ell) (g : G) (p : ↥(P g)) :
    physicalGroupPhaseActivity L g p = true ↔ p.val ∈ physicalGroupMarks L g := by
  simp [physicalGroupPhaseActivity]

theorem physical_group_phase_activity_support_mem {G : Type*} {P : G → Finset ℕ}
    {J ell : ℕ} (L : PhysicalMarkLists P J ell) (g : G) (p : ↥(P g)) :
    p ∈ ghostPhaseActivitySupport (physicalGroupPhaseActivity L g) ↔
      p.val ∈ physicalGroupMarks L g := by
  simp [ghostPhaseActivitySupport, physicalGroupPhaseActivity]

theorem physical_group_phase_activity_support_eq_image {G : Type*}
    {P : G → Finset ℕ} {J ell : ℕ} (L : PhysicalMarkLists P J ell) (g : G) :
    ghostPhaseActivitySupport (physicalGroupPhaseActivity L g) = univ.image (L g) := by
  ext p
  rw [physical_group_phase_activity_support_mem, mem_physical_group_marks]
  simp only [mem_image, mem_univ, true_and]
  constructor
  · rintro ⟨s, hs⟩
    exact ⟨s, Subtype.ext hs⟩
  · rintro ⟨s, hs⟩
    exact ⟨s, congrArg Subtype.val hs⟩

theorem physical_group_phase_activity_support_image {G : Type*}
    {P : G → Finset ℕ} {J ell : ℕ} (L : PhysicalMarkLists P J ell) (g : G) :
    (ghostPhaseActivitySupport (physicalGroupPhaseActivity L g)).image Subtype.val =
      physicalGroupMarks L g := by
  ext p
  simp only [mem_image]
  constructor
  · rintro ⟨q, hq, rfl⟩
    exact (physical_group_phase_activity_support_mem L g q).mp hq
  · intro hp
    let q : ↥(P g) := ⟨p, physical_group_marks_subset L g hp⟩
    exact ⟨q, (physical_group_phase_activity_support_mem L g q).mpr hp, rfl⟩

theorem physical_group_phase_activity_support_card {G : Type*}
    {P : G → Finset ℕ} {J ell : ℕ} (L : PhysicalMarkLists P J ell) (g : G) :
    (ghostPhaseActivitySupport (physicalGroupPhaseActivity L g)).card = J + ell := by
  rw [physical_group_phase_activity_support_eq_image,
    card_image_of_injective _ (L g).injective]
  simp

theorem physical_group_phase_delta_eq_neg_step {G : Type*} {P : G → Finset ℕ}
    (n m : ℤ) (g : G) (p : ↥(P g)) :
    physicalGroupPhaseDelta n m g p = -((m - n : ℤ) : ZMod p.val) := by
  simp [physicalGroupPhaseDelta]

theorem physical_group_phase_delta_eq_hit_difference {G : Type*}
    {P : G → Finset ℕ} (n m : ℤ) (g : G) (p : ↥(P g)) :
    physicalGroupPhaseDelta n m g p = -(m : ZMod p.val) - (-(n : ZMod p.val)) := by
  simp [physicalGroupPhaseDelta, sub_eq_add_neg, add_comm]

theorem physical_group_phase_delta_zero_of_dvd {G : Type*} {P : G → Finset ℕ}
    (n m : ℤ) (g : G) (p : ↥(P g)) (hd : (p.val : ℤ) ∣ m - n) :
    physicalGroupPhaseDelta n m g p = 0 := by
  rw [physical_group_phase_delta_eq_neg_step,
    (ZMod.intCast_zmod_eq_zero_iff_dvd (m - n) p.val).mpr hd, neg_zero]

/-- Bare lists need only divisibility of the displacement by every common mark. -/
theorem physical_group_phase_shared_delta_zero_of_common_marks {G : Type*}
    {P : G → Finset ℕ} {J ell : ℕ} (L R : PhysicalMarkLists P J ell)
    (n m : ℤ) (g : G)
    (hcommon : ∀ s t, (L g s).val = (R g t).val →
      ((L g s).val : ℤ) ∣ m - n)
    (p : ↥(P g))
    (hp : physicalGroupPhaseActivity R g p = true ∧
      physicalGroupPhaseActivity L g p = true) :
    physicalGroupPhaseDelta n m g p = 0 := by
  obtain ⟨s, hs⟩ := (mem_physical_group_marks L g p.val).mp
    ((physical_group_phase_activity_iff L g p).mp hp.2)
  obtain ⟨t, ht⟩ := (mem_physical_group_marks R g p.val).mp
    ((physical_group_phase_activity_iff R g p).mp hp.1)
  apply physical_group_phase_delta_zero_of_dvd
  simpa only [hs] using hcommon s t (hs.trans ht.symm)

/-- Every active prime at an actual physical state divides its integer position. -/
theorem physical_group_phase_active_dvd {G : Type*} {P : G → Finset ℕ}
    {J ell : ℕ} (x : PhysicalState P J ell) (g : G) (p : ↥(P g))
    (hp : physicalGroupPhaseActivity x.2.val g p = true) : (p.val : ℤ) ∣ x.1 := by
  obtain ⟨s, hs⟩ := (mem_physical_group_marks x.2.val g p.val).mp
    ((physical_group_phase_activity_iff x.2.val g p).mp hp)
  simpa only [hs] using x.2.property g s

/-- This is the shared-active hypothesis for the groupwise moving phase edge.
It holds for any two physical states, without an admissibility assumption. -/
theorem physical_group_phase_shared_delta_zero {G : Type*} {P : G → Finset ℕ}
    {J ell : ℕ} (x y : PhysicalState P J ell) (g : G) (p : ↥(P g))
    (hp : physicalGroupPhaseActivity y.2.val g p = true ∧
      physicalGroupPhaseActivity x.2.val g p = true) :
    physicalGroupPhaseDelta x.1 y.1 g p = 0 := by
  apply physical_group_phase_delta_zero_of_dvd
  exact dvd_sub (physical_group_phase_active_dvd y g p hp.1)
    (physical_group_phase_active_dvd x g p hp.2)

/-- Independent marked residue constraints give the same shared-active identity. -/
theorem physical_group_phase_shared_delta_zero_of_residues {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (L R : PhysicalMarkLists P J ell)
    (ρ : ∀ p : PhysicalPrime P, ZMod p.2.val) (n step : ℤ)
    (hL : ∀ p ∈ physicalMarkedPrimes L, ρ p = -(n : ZMod p.2.val))
    (hR : ∀ p ∈ physicalMarkedPrimes R,
      ρ p = -((n + step : ℤ) : ZMod p.2.val))
    (g : G) (p : ↥(P g))
    (hp : physicalGroupPhaseActivity R g p = true ∧
      physicalGroupPhaseActivity L g p = true) :
    physicalGroupPhaseDelta n (n + step) g p = 0 := by
  apply physical_group_phase_shared_delta_zero_of_common_marks L R n (n + step) g _ p hp
  intro s t he
  simpa only [add_sub_cancel_left] using
    physical_common_mark_step_dvd_of_residues L R ρ n step hL hR g s t he
end

section
open Finset
def globalBirthReindexStep {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] {a b a' b' : P → Bool}
    (ha : a = a') (hb : b = b') (step : GlobalBirthRawStep (R := R) a b) :
    GlobalBirthRawStep (R := R) a' b' := by
  subst a'
  subst b'
  exact step

theorem global_birth_reindex_step_row {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)]
    {a b a' b' : P → Bool} (ha : a = a') (hb : b = b')
    (step : GlobalBirthRawStep (R := R) a b)
    (G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p)) :
    globalBirthRawStepRow (globalBirthReindexStep ha hb step) G H q =
      globalBirthRawStepRow step G H q := by
  subst a'
  subst b'
  rfl

theorem global_birth_reindex_step_kernel {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    {a b a' b' : P → Bool} (ha : a = a') (hb : b = b')
    (step : GlobalBirthRawStep (R := R) a b) (z w : (p : P) → GhostPhaseState (R p)) :
    globalBirthRawStepKernel (globalBirthReindexStep ha hb step) z w =
      globalBirthRawStepKernel step z w := by
  subst a'
  subst b'
  rfl

noncomputable def globalBirthAlternatingStep {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)]
    (a : ℕ → P → Bool)
    (visit : ∀ i, GlobalBirthRawStep (R := R) (a i) (a i))
    (edge : ∀ i, GlobalBirthRawStep (R := R) (a i) (a (i + 1)))
    (i : ℕ) : GlobalBirthRawStep (R := R) (a (i / 2)) (a ((i + 1) / 2)) := by
  by_cases hi : i % 2 = 0
  · have he : (i + 1) / 2 = i / 2 := by omega
    exact globalBirthReindexStep rfl (congrArg a he.symm) (visit (i / 2))
  · have he : (i + 1) / 2 = i / 2 + 1 := by omega
    exact globalBirthReindexStep rfl (congrArg a he.symm) (edge (i / 2))

theorem global_birth_alternating_step_row_even {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)]
    (a : ℕ → P → Bool)
    (visit : ∀ i, GlobalBirthRawStep (R := R) (a i) (a i))
    (edge : ∀ i, GlobalBirthRawStep (R := R) (a i) (a (i + 1))) (i : ℕ)
    (G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p)) :
    globalBirthRawStepRow (globalBirthAlternatingStep a visit edge (2 * i)) G H q =
      globalBirthRawStepRow (visit i) G H q := by
  simp [globalBirthAlternatingStep, global_birth_reindex_step_row]
  exact congrArg (fun j => globalBirthRawStepRow (visit j) G H q) (show 2 * i / 2 = i by omega)

theorem global_birth_alternating_step_row_odd {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)]
    (a : ℕ → P → Bool)
    (visit : ∀ i, GlobalBirthRawStep (R := R) (a i) (a i))
    (edge : ∀ i, GlobalBirthRawStep (R := R) (a i) (a (i + 1))) (i : ℕ)
    (G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p)) :
    globalBirthRawStepRow (globalBirthAlternatingStep a visit edge (2 * i + 1)) G H q =
      globalBirthRawStepRow (edge i) G H q := by
  simp [globalBirthAlternatingStep, global_birth_reindex_step_row]
  exact congrArg (fun j => globalBirthRawStepRow (edge j) G H q) (show (2 * i + 1) / 2 = i by omega)

theorem global_birth_alternating_step_kernel_even {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    (a : ℕ → P → Bool)
    (visit : ∀ i, GlobalBirthRawStep (R := R) (a i) (a i))
    (edge : ∀ i, GlobalBirthRawStep (R := R) (a i) (a (i + 1))) (i : ℕ)
    (z w : (p : P) → GhostPhaseState (R p)) :
    globalBirthRawStepKernel (globalBirthAlternatingStep a visit edge (2 * i)) z w =
      globalBirthRawStepKernel (visit i) z w := by
  simp [globalBirthAlternatingStep, global_birth_reindex_step_kernel]
  exact congrArg (fun j => globalBirthRawStepKernel (visit j) z w) (show 2 * i / 2 = i by omega)

theorem global_birth_alternating_step_kernel_odd {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    (a : ℕ → P → Bool)
    (visit : ∀ i, GlobalBirthRawStep (R := R) (a i) (a i))
    (edge : ∀ i, GlobalBirthRawStep (R := R) (a i) (a (i + 1))) (i : ℕ)
    (z w : (p : P) → GhostPhaseState (R p)) :
    globalBirthRawStepKernel (globalBirthAlternatingStep a visit edge (2 * i + 1)) z w =
      globalBirthRawStepKernel (edge i) z w := by
  simp [globalBirthAlternatingStep, global_birth_reindex_step_kernel]
  exact congrArg (fun j => globalBirthRawStepKernel (edge j) z w) (show (2 * i + 1) / 2 = i by omega)
end

section
open Finset
noncomputable def physicalMemoryLabeledScalar {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (ζ : I → ℝ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (L R : PhysicalMarkLists P J ell) : ℂ := by
  classical
  exact (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
    (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
    if physicalListAdmissible (C a.2.2.1.val) a.2.2.2
      (physicalPermuteLabels a.1 L) (physicalPermuteLabels a.2.1 R) then
      (physicalAuxMass V (C a.2.2.1.val) a.2.2.2 : ℂ) *
        K a.2.2.1.val (physicalPermuteLabels a.1 L) (physicalPermuteLabels a.2.1 R) a.2.2.2 *
        physicalPhase (ζ a.2.2.1.val) (physicalD (C a.2.2.1.val) (physicalPermuteLabels a.1 L) a.2.2.2)
    else 0

theorem physical_memory_labeled_scalar_factor {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (ζ : I → ℝ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (L R : PhysicalMarkLists P J ell) :
    physicalBareLabeledScalar V patterns C ζ K a L R =
      (physicalCompletionMass V (C a.2.2.1.val) ell : ℂ) *
        physicalMemoryLabeledScalar V patterns C ζ K a L R := by
  classical
  unfold physicalBareLabeledScalar physicalBarePatternScalar physicalMemoryLabeledScalar
  split_ifs <;> push_cast <;> ring

theorem physical_memory_labeled_scalar_zero_of_incompatible {G I : Type*}
    [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (patterns : Finset I) (C : I → G → Finset (Fin J)) (ζ : I → ℝ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (L R : PhysicalMarkLists P J ell)
    (h : ¬ physicalListAdmissible (C a.2.2.1.val) a.2.2.2
      (physicalPermuteLabels a.1 L) (physicalPermuteLabels a.2.1 R)) :
    physicalMemoryLabeledScalar V patterns C ζ K a L R = 0 := by
  simp only [physicalMemoryLabeledScalar, if_neg h, mul_zero]

noncomputable def physicalMemoryWalkScalar {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (ζ : ℕ → I → ℝ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (edges : ℕ) : ℂ :=
  ∏ j ∈ range edges, physicalMemoryLabeledScalar V patterns C (ζ (edges - 1 - j))
    (K (edges - 1 - j)) (a j) (L j) (L (j + 1))

theorem physical_memory_walk_scalar_factor {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (ζ : ℕ → I → ℝ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (edges : ℕ) :
    physicalBareWalkScalar V patterns C ζ K a L edges =
      ((∏ j ∈ range edges, physicalCompletionMass V (C (a j).2.2.1.val) ell : ℝ) : ℂ) *
        physicalMemoryWalkScalar V patterns C ζ K a L edges := by
  simp only [physicalBareWalkScalar, physical_memory_labeled_scalar_factor,
    prod_mul_distrib, Complex.ofReal_prod, physicalMemoryWalkScalar]

/-- Replacing an ordinary phase history by a run-normalized history also
replaces the bare scalar by its memory scalar, with no duplicate V powers.
The equality preserves the complete signed complex coefficient. -/
theorem physical_memory_walk_phase_factor_of_counts {G I : Type*}
    [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    {R : PhysicalPrime P → Type*} [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    (V : G → ℝ) (patterns : Finset I) (C : I → G → Finset (Fin J))
    (ζ : ℕ → I → ℝ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (edges : ℕ)
    (h : (p : PhysicalPrime P) → ℕ → R p) (η : PhysicalPrime P → ℕ → ℝ)
    (β : PhysicalPrime P → ℝ)
    (hnew : ∀ j < edges, ∀ g,
      (physicalGroupMarks (L (j + 1)) g \ physicalGroupMarks (L j) g).card =
        ell + (C (a j).2.2.1.val g).card) :
    (physicalStateMass V J ell : ℂ) * physicalBareWalkScalar V patterns C ζ K a L edges *
      (ghostPhaseTensorHistory (fun p j => decide (p ∈ physicalMarkedPrimes (L j))) h η β edges : ℂ) =
    physicalMemoryWalkScalar V patterns C ζ K a L edges *
      ((∏ p : PhysicalPrime P, ghostPhaseRunHistory
        (fun j => decide (p ∈ physicalMarkedPrimes (L j))) (h p) (η p) (β p) (V p.1) edges : ℝ) : ℂ) := by
  rw [physical_phase_run_history_eq_of_counts V L (fun j => C (a j).2.2.1.val) edges h η β hnew,
    physical_memory_walk_scalar_factor]
  push_cast
  ring
end

section
open Finset
open scoped Classical
def repeatedBigPermutationEquiv {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (σ : PhysicalPermutations G J ell) : RepeatedBigLists P J ell ≃ RepeatedBigLists P J ell where
  toFun L g s := L g (σ g s)
  invFun L g s := L g ((σ g).symm s)
  left_inv L := by funext g s; exact congrArg (L g) ((σ g).apply_symm_apply s)
  right_inv L := by funext g s; exact congrArg (L g) ((σ g).symm_apply_apply s)

theorem repeated_big_permutation_one {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (L : RepeatedBigLists P J ell) :
    repeatedBigPermutationEquiv (1 : PhysicalPermutations G J ell) L = L := rfl

theorem repeated_big_permutation_mul {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (σ τ : PhysicalPermutations G J ell) (L : RepeatedBigLists P J ell) :
    repeatedBigPermutationEquiv σ (repeatedBigPermutationEquiv τ L) =
      repeatedBigPermutationEquiv (τ * σ) L := rfl

def repeatedBigSymmetricSubspace {G : Type*} {P : G → Finset ℕ} {J ell : ℕ} :
    Submodule ℂ (RepeatedBigLists P J ell → ℂ) where
  carrier := {f | ∀ σ : PhysicalPermutations G J ell, ∀ L, f (repeatedBigPermutationEquiv σ L) = f L}
  zero_mem' := fun _ _ => rfl
  add_mem' := by intro f g hf hg σ L; exact congrArg₂ (· + ·) (hf σ L) (hg σ L)
  smul_mem' := by intro a f hf σ L; exact congrArg (a * ·) (hf σ L)

noncomputable def repeatedBigSymmetrize {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (f : RepeatedBigLists P J ell → ℂ)
    (L : RepeatedBigLists P J ell) : ℂ :=
  (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
    ∑ σ : PhysicalPermutations G J ell, f (repeatedBigPermutationEquiv σ L)

noncomputable def repeatedBigSymmetrizeLinear {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} :
    (RepeatedBigLists P J ell → ℂ) →ₗ[ℂ] (RepeatedBigLists P J ell → ℂ) where
  toFun := repeatedBigSymmetrize
  map_add' f g := by ext L; simp [repeatedBigSymmetrize, sum_add_distrib, mul_add]
  map_smul' a f := by
    ext L
    simp only [repeatedBigSymmetrize, Pi.smul_apply, smul_eq_mul, RingHom.id_apply]
    rw [← mul_sum]
    ring

theorem repeated_big_symmetrize_const {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (c : ℂ) (L : RepeatedBigLists P J ell) :
    repeatedBigSymmetrize (fun _ => c) L = c := by
  unfold repeatedBigSymmetrize
  rw [sum_const, card_univ, nsmul_eq_mul, ← mul_assoc, inv_mul_cancel₀, one_mul]
  exact_mod_cast Fintype.card_ne_zero

theorem repeated_big_symmetrize_invariant {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (f : RepeatedBigLists P J ell → ℂ)
    (τ : PhysicalPermutations G J ell) (L : RepeatedBigLists P J ell) :
    repeatedBigSymmetrize f (repeatedBigPermutationEquiv τ L) = repeatedBigSymmetrize f L := by
  unfold repeatedBigSymmetrize
  simp only [repeated_big_permutation_mul]
  congr 1
  exact Equiv.sum_comp (Equiv.mulLeft τ) (fun σ => f (repeatedBigPermutationEquiv σ L))

theorem repeated_big_symmetrize_mem {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (f : RepeatedBigLists P J ell → ℂ) :
    repeatedBigSymmetrizeLinear f ∈ repeatedBigSymmetricSubspace :=
  repeated_big_symmetrize_invariant f

theorem repeated_big_symmetrize_eq_self {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (f : RepeatedBigLists P J ell → ℂ)
    (hf : f ∈ repeatedBigSymmetricSubspace) : repeatedBigSymmetrizeLinear f = f := by
  funext L
  change (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
    (∑ σ : PhysicalPermutations G J ell, f (repeatedBigPermutationEquiv σ L)) = f L
  simp only [show ∀ σ L, f (repeatedBigPermutationEquiv σ L) = f L from hf]
  exact repeated_big_symmetrize_const (f L) L

theorem repeated_big_symmetrize_idempotent {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (f : RepeatedBigLists P J ell → ℂ) :
    repeatedBigSymmetrizeLinear (repeatedBigSymmetrizeLinear f) = repeatedBigSymmetrizeLinear f :=
  repeated_big_symmetrize_eq_self _ (repeated_big_symmetrize_mem f)

theorem repeated_big_symmetrize_norm_sq_le {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (f : RepeatedBigLists P J ell → ℂ)
    (L : RepeatedBigLists P J ell) :
    ‖repeatedBigSymmetrize f L‖ ^ 2 ≤
      (Fintype.card (PhysicalPermutations G J ell) : ℝ)⁻¹ *
        ∑ σ : PhysicalPermutations G J ell, ‖f (repeatedBigPermutationEquiv σ L)‖ ^ 2 := by
  have hc : (0 : ℝ) < Fintype.card (PhysicalPermutations G J ell) := by
    exact_mod_cast Fintype.card_pos
  have hsum := complex_row_weighted_cauchy (univ : Finset (PhysicalPermutations G J ell))
    (fun _ => 1) (fun σ => f (repeatedBigPermutationEquiv σ L)) (fun _ => 1)
    (by intros; norm_num)
  have hsum' : ‖∑ σ : PhysicalPermutations G J ell, f (repeatedBigPermutationEquiv σ L)‖ ^ 2 ≤
      (Fintype.card (PhysicalPermutations G J ell) : ℝ) *
        ∑ σ : PhysicalPermutations G J ell, ‖f (repeatedBigPermutationEquiv σ L)‖ ^ 2 := by
    simpa using hsum
  unfold repeatedBigSymmetrize
  rw [norm_mul, norm_inv, Complex.norm_natCast, mul_pow]
  calc
    _ ≤ ((Fintype.card (PhysicalPermutations G J ell) : ℝ)⁻¹) ^ 2 *
        ((Fintype.card (PhysicalPermutations G J ell) : ℝ) *
          ∑ σ : PhysicalPermutations G J ell, ‖f (repeatedBigPermutationEquiv σ L)‖ ^ 2) :=
      mul_le_mul_of_nonneg_left hsum' (sq_nonneg _)
    _ = _ := by field_simp

theorem repeated_big_permutation_energy_eq {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (w : RepeatedBigLists P J ell → ℝ)
    (f : RepeatedBigLists P J ell → ℂ)
    (hw : ∀ (σ : PhysicalPermutations G J ell) L, w (repeatedBigPermutationEquiv σ L) = w L)
    (σ : PhysicalPermutations G J ell) :
    (∑ L, w L * ‖f (repeatedBigPermutationEquiv σ L)‖ ^ 2) =
      ∑ L, w L * ‖f L‖ ^ 2 := by
  have h := (repeatedBigPermutationEquiv (P := P) σ).sum_comp (fun L => w L * ‖f L‖ ^ 2)
  simpa only [hw] using h

theorem repeated_big_symmetrize_energy_le {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (w : RepeatedBigLists P J ell → ℝ)
    (hw0 : ∀ L, 0 ≤ w L)
    (hw : ∀ (σ : PhysicalPermutations G J ell) L, w (repeatedBigPermutationEquiv σ L) = w L)
    (f : RepeatedBigLists P J ell → ℂ) :
    (∑ L, w L * ‖repeatedBigSymmetrizeLinear f L‖ ^ 2) ≤ ∑ L, w L * ‖f L‖ ^ 2 := by
  have hc : (Fintype.card (PhysicalPermutations G J ell) : ℝ) ≠ 0 := by
    exact_mod_cast Fintype.card_ne_zero
  calc
    _ ≤ ∑ L, w L * ((Fintype.card (PhysicalPermutations G J ell) : ℝ)⁻¹ *
        ∑ σ : PhysicalPermutations G J ell, ‖f (repeatedBigPermutationEquiv σ L)‖ ^ 2) :=
      sum_le_sum fun L _ => mul_le_mul_of_nonneg_left (repeated_big_symmetrize_norm_sq_le f L) (hw0 L)
    _ = (Fintype.card (PhysicalPermutations G J ell) : ℝ)⁻¹ *
        ∑ σ : PhysicalPermutations G J ell, ∑ L, w L * ‖f (repeatedBigPermutationEquiv σ L)‖ ^ 2 := by
      rw [sum_comm]
      simp_rw [mul_sum]
      apply sum_congr rfl
      intro L _
      apply sum_congr rfl
      intro σ _
      ring
    _ = (Fintype.card (PhysicalPermutations G J ell) : ℝ)⁻¹ *
        ∑ _σ : PhysicalPermutations G J ell, ∑ L, w L * ‖f L‖ ^ 2 := by
      simp_rw [repeated_big_permutation_energy_eq w f hw]
    _ = _ := by
      simp only [sum_const, card_univ, nsmul_eq_mul]
      rw [← mul_assoc, inv_mul_cancel₀ hc, one_mul]

theorem repeated_big_symmetrize_norm_le {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (w : RepeatedBigLists P J ell → ℝ)
    (hw0 : ∀ L, 0 ≤ w L)
    (hw : ∀ (σ : PhysicalPermutations G J ell) L, w (repeatedBigPermutationEquiv σ L) = w L)
    (f : RepeatedBigLists P J ell → ℂ) :
    cleanActiveNorm w (repeatedBigSymmetrizeLinear f) ≤ cleanActiveNorm w f :=
  Real.sqrt_le_sqrt (repeated_big_symmetrize_energy_le w hw0 hw f)

theorem repeated_big_active_mass_permutation {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (σ : PhysicalPermutations G J ell) (L : RepeatedBigLists P J ell) :
    repeatedBigActiveMass V b (repeatedBigPermutationEquiv σ L) = repeatedBigActiveMass V b L := by
  unfold repeatedBigActiveMass
  apply prod_congr rfl
  intro g _
  exact Equiv.prod_comp (σ g) (fun s => tiltedPhysicalBirthLaw V g (b g) (L g s))

theorem clean_active_density_permutation {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (b : ∀ g, P g → ℝ)
    (σ : PhysicalPermutations G J ell) (L : RepeatedBigLists P J ell) :
    cleanActiveDensity b (repeatedBigPermutationEquiv σ L) = cleanActiveDensity b L := by
  unfold cleanActiveDensity
  apply prod_congr rfl
  intro g _
  exact Equiv.prod_comp (σ g) (fun s => 1 / b g (L g s))

/-- Any symmetric scalar multiplier commutes with the full permutation average. -/
theorem repeated_big_symmetrize_mul {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (a : RepeatedBigLists P J ell → ℂ)
    (ha : ∀ (σ : PhysicalPermutations G J ell) L, a (repeatedBigPermutationEquiv σ L) = a L)
    (f : RepeatedBigLists P J ell → ℂ) :
    repeatedBigSymmetrizeLinear (fun L => a L * f L) =
      fun L => a L * repeatedBigSymmetrizeLinear f L := by
  funext L
  change repeatedBigSymmetrize (fun L => a L * f L) L = a L * repeatedBigSymmetrize f L
  simp only [repeatedBigSymmetrize, ha]
  rw [← mul_sum]
  ring

theorem repeated_big_symmetrize_density_mul {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (b : ∀ g, P g → ℝ)
    (f : RepeatedBigLists P J ell → ℂ) :
    repeatedBigSymmetrizeLinear (fun L => (Real.sqrt (cleanActiveDensity b L) : ℂ) * f L) =
      fun L => (Real.sqrt (cleanActiveDensity b L) : ℂ) * repeatedBigSymmetrizeLinear f L := by
  apply repeated_big_symmetrize_mul
  intro σ L
  rw [clean_active_density_permutation]
end

section

open Finset
open scoped ComplexConjugate

noncomputable def cleanActiveMap {X R : Type*}
    (P : (X → ℂ) →ₗ[ℂ] (X → ℂ)) (f : X → R → ℂ) (x : X) (r : R) : ℂ :=
  P (fun y => f y r) x

noncomputable def cleanProjectedTranslatedSum {A X R : Type*} [Fintype A] [Fintype X]
    [AddCommGroup R] (P : (X → ℂ) →ₗ[ℂ] (X → ℂ))
    (K : A → X → X → ℂ) (δ : A → X → X → R) (f : X → R → ℂ) : X → R → ℂ :=
  cleanActiveMap P (cleanTranslatedSumOperator K δ (cleanActiveMap P f))

/-- Every active linear map commutes with Fourier synthesis in the independent residue variable. -/
theorem clean_active_map_synthesis {X R : Type*} [AddCommGroup R] [Fintype R]
    (P : (X → ℂ) →ₗ[ℂ] (X → ℂ)) (c : AddChar R ℂ → X → ℂ) (x : X) (r : R) :
    cleanActiveMap P (fun y => cleanFourierSynthesis (fun χ => c χ y)) x r =
      cleanFourierSynthesis (fun χ => P (c χ) x) r := by
  have hf : (fun y => cleanFourierSynthesis (fun χ => c χ y) r) =
      ∑ χ, χ r • c χ := by
    funext y
    simp only [cleanFourierSynthesis, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, mul_comm]
  unfold cleanActiveMap
  rw [hf, map_sum]
  simp only [map_smul, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, cleanFourierSynthesis, mul_comm]

theorem clean_active_map_fourier_coefficients {X R : Type*} [AddCommGroup R] [Fintype R]
    (P : (X → ℂ) →ₗ[ℂ] (X → ℂ)) (f : X → R → ℂ) (χ : AddChar R ℂ) (x : X) :
    cleanFourierCoefficients (cleanActiveMap P f x) χ =
      P (fun y => cleanFourierCoefficients (f y) χ) x := by
  have hf : f = fun y => cleanFourierSynthesis (fun ψ => cleanFourierCoefficients (f y) ψ) := by
    funext y r
    exact (clean_fourier_synthesis_coefficients (f y) r).symm
  have he : cleanActiveMap P f x = cleanFourierSynthesis
      (fun ψ => P (fun y => cleanFourierCoefficients (f y) ψ) x) := by
    conv_lhs => rw [hf]
    funext r
    exact clean_active_map_synthesis P _ x r
  rw [he, clean_fourier_coefficients_synthesis]

theorem clean_projected_translated_synthesis {A X R : Type*}
    [Fintype A] [Fintype X] [AddCommGroup R] [Fintype R]
    (P : (X → ℂ) →ₗ[ℂ] (X → ℂ)) (K : A → X → X → ℂ) (δ : A → X → X → R)
    (c : AddChar R ℂ → X → ℂ) (x : X) (r : R) :
    cleanProjectedTranslatedSum P K δ (fun y => cleanFourierSynthesis (fun χ => c χ y)) x r =
      cleanFourierSynthesis (fun χ => P (cleanFourierSumBlock K δ χ (P (c χ))) x) r := by
  have hin : cleanActiveMap P (fun y => cleanFourierSynthesis (fun χ => c χ y)) =
      fun y => cleanFourierSynthesis (fun χ => P (c χ) y) := by
    funext y s
    exact clean_active_map_synthesis P c y s
  have hmid : cleanTranslatedSumOperator K δ
      (fun y => cleanFourierSynthesis (fun χ => P (c χ) y)) =
      fun y => cleanFourierSynthesis (fun χ => cleanFourierSumBlock K δ χ (P (c χ)) y) := by
    funext y s
    exact clean_fourier_sum_translated_synthesis K δ _ y s
  unfold cleanProjectedTranslatedSum
  rw [hin, hmid]
  exact clean_active_map_synthesis P _ x r

/-- The exact Fourier block of the projected operator is P T_chi P. -/
theorem clean_projected_translated_fourier_coefficients {A X R : Type*}
    [Fintype A] [Fintype X] [AddCommGroup R] [Fintype R]
    (P : (X → ℂ) →ₗ[ℂ] (X → ℂ)) (K : A → X → X → ℂ) (δ : A → X → X → R)
    (f : X → R → ℂ) (χ : AddChar R ℂ) (x : X) :
    cleanFourierCoefficients (cleanProjectedTranslatedSum P K δ f x) χ =
      P (cleanFourierSumBlock K δ χ (P (fun y => cleanFourierCoefficients (f y) χ))) x := by
  unfold cleanProjectedTranslatedSum
  rw [clean_active_map_fourier_coefficients]
  simp only [clean_fourier_coefficients_sum_translated, clean_active_map_fourier_coefficients]

/-- Only the projected Fourier blocks need to be bounded. The raw row may leave the subspace. -/
theorem clean_projected_translated_energy_le {A X R : Type*}
    [Fintype A] [Fintype X] [AddCommGroup R] [Fintype R]
    (P : (X → ℂ) →ₗ[ℂ] (X → ℂ)) (w : X → ℝ)
    (K : A → X → X → ℂ) (δ : A → X → X → R) (C : ℝ)
    (hblock : ∀ (χ : AddChar R ℂ) (v : X → ℂ),
      (∑ x, w x * ‖P (cleanFourierSumBlock K δ χ (P v)) x‖ ^ 2) ≤
        C ^ 2 * ∑ x, w x * ‖v x‖ ^ 2)
    (f : X → R → ℂ) :
    (∑ x, w x * ∑ r, ‖cleanProjectedTranslatedSum P K δ f x r‖ ^ 2) ≤
      C ^ 2 * ∑ x, w x * ∑ r, ‖f x r‖ ^ 2 := by
  let c (χ : AddChar R ℂ) (x : X) := cleanFourierCoefficients (f x) χ
  have hf : f = fun x => cleanFourierSynthesis (fun χ => c χ x) := by
    funext x r
    exact (clean_fourier_synthesis_coefficients (f x) r).symm
  rw [hf]
  simp_rw [clean_projected_translated_synthesis]
  rw [clean_fourier_weighted_energy, clean_fourier_weighted_energy]
  calc
    _ ≤ (Fintype.card R : ℝ) * ∑ χ, C ^ 2 * ∑ x, w x * ‖c χ x‖ ^ 2 :=
      mul_le_mul_of_nonneg_left (sum_le_sum (fun χ _ => hblock χ (c χ))) (Nat.cast_nonneg _)
    _ = _ := by rw [← mul_sum]; ring

/-- A contraction P into U reduces P T P to projected block bounds on U.
There is no assumption that T itself maps U to U. -/
theorem clean_projected_translated_norm_le {A X R : Type*}
    [Fintype A] [Fintype X] [AddCommGroup R] [Fintype R]
    (P : (X → ℂ) →ₗ[ℂ] (X → ℂ)) (w : X → ℝ) (hw : ∀ x, 0 ≤ w x)
    (U : Submodule ℂ (X → ℂ)) (hPU : ∀ v, P v ∈ U)
    (hP : ∀ v, cleanActiveNorm w (P v) ≤ cleanActiveNorm w v)
    (K : A → X → X → ℂ) (δ : A → X → X → R) (C : ℝ) (hC : 0 ≤ C)
    (hblock : ∀ (χ : AddChar R ℂ) (v : X → ℂ), v ∈ U →
      cleanActiveNorm w (P (cleanFourierSumBlock K δ χ v)) ≤ C * cleanActiveNorm w v)
    (f : X → R → ℂ) :
    cleanWeightedNorm w (cleanProjectedTranslatedSum P K δ f) ≤ C * cleanWeightedNorm w f := by
  have he : ∀ (χ : AddChar R ℂ) (v : X → ℂ),
      (∑ x, w x * ‖P (cleanFourierSumBlock K δ χ (P v)) x‖ ^ 2) ≤
        C ^ 2 * ∑ x, w x * ‖v x‖ ^ 2 := by
    intro χ v
    have hn := (hblock χ (P v) (hPU v)).trans (mul_le_mul_of_nonneg_left (hP v) hC)
    calc
      _ = cleanActiveNorm w (P (cleanFourierSumBlock K δ χ (P v))) ^ 2 :=
        (clean_active_norm_sq w hw _).symm
      _ ≤ (C * cleanActiveNorm w v) ^ 2 := pow_le_pow_left₀ (Real.sqrt_nonneg _) hn 2
      _ = _ := by rw [mul_pow, clean_active_norm_sq w hw]
  have h := Real.sqrt_le_sqrt (clean_projected_translated_energy_le P w K δ C he f)
  simpa only [cleanWeightedNorm, Real.sqrt_mul (sq_nonneg C), Real.sqrt_sq hC] using h
end

section

noncomputable def signedDistanceBin (R x : ℝ) : Bool × ℕ :=
  (decide (0 ≤ x), ⌊R * |x|⌋₊)

theorem signed_distance_bin_abs_sub_lt {R x y : ℝ} (hR : 0 < R)
    (he : signedDistanceBin R x = signedDistanceBin R y) : |x - y| < 1 / R := by
  have he0 : decide (0 ≤ x) = decide (0 ≤ y) := congrArg Prod.fst he
  have he1 : ⌊R * |x|⌋₊ = ⌊R * |y|⌋₊ := congrArg Prod.snd he
  have hxL := Nat.floor_le (show 0 ≤ R * |x| by positivity)
  have hyL := Nat.floor_le (show 0 ≤ R * |y| by positivity)
  have hxU := Nat.lt_floor_add_one (R * |x|)
  have hyU := Nat.lt_floor_add_one (R * |y|)
  rw [← he1] at hyL hyU
  have hdiff : |R * (|x|) - R * (|y|)| < 1 := by
    rw [abs_lt]
    constructor <;> linarith
  have habs : |R * (|x|) - R * (|y|)| = R * |x - y| := by
    by_cases hx : 0 ≤ x
    · have hy : 0 ≤ y := by simpa [hx] using he0
      rw [abs_of_nonneg hx, abs_of_nonneg hy, ← mul_sub, abs_mul, abs_of_pos hR]
    · have hy : ¬ 0 ≤ y := by simpa [hx] using he0
      rw [abs_of_neg (lt_of_not_ge hx), abs_of_neg (lt_of_not_ge hy)]
      rw [← mul_sub, abs_mul, abs_of_pos hR]
      congr 1
      rw [neg_sub_neg, abs_sub_comm]
  rw [habs] at hdiff
  exact (lt_div_iff₀ hR).mpr (by nlinarith)

theorem signed_distance_bin_injOn {ι : Type*} (S : Finset ι) (t : ι → ℝ)
    {R : ℝ} (hR : 0 < R)
    (hsep : ∀ i ∈ S, ∀ j ∈ S, i ≠ j → 1 / R ≤ |t i - t j|) :
    Set.InjOn (fun i => signedDistanceBin R (t i)) S := by
  intro i hi j hj he
  by_contra hne
  exact (not_lt_of_ge (hsep i hi j hj hne)) (signed_distance_bin_abs_sub_lt hR he)

theorem circle_norm_sub_le_centered_difference (x y : ℝ) :
    ‖((x - y : ℝ) : UnitAddCircle)‖ ≤
      |(x - (round x : ℝ)) - (y - (round y : ℝ))| := by
  rw [UnitAddCircle.norm_eq]
  have h := round_le (x - y) (round x - round y)
  rw [Int.cast_sub] at h
  have he : (x - y) - ((round x : ℝ) - (round y : ℝ)) =
      (x - (round x : ℝ)) - (y - (round y : ℝ)) := by ring
  rwa [he] at h

theorem centered_circle_distance_bin_injOn {ι : Type*} (S : Finset ι) (θ : ι → ℝ)
    {R : ℝ} (hR : 0 < R)
    (hsep : ∀ i ∈ S, ∀ j ∈ S, i ≠ j →
      1 / R ≤ ‖((θ i - θ j : ℝ) : UnitAddCircle)‖) :
    Set.InjOn (fun i => signedDistanceBin R (θ i - (round (θ i) : ℝ))) S :=
  signed_distance_bin_injOn S (fun i => θ i - (round (θ i) : ℝ)) hR
    (fun i hi j hj hne => (hsep i hi j hj hne).trans
      (circle_norm_sub_le_centered_difference (θ i) (θ j)))
end

section

theorem same_positive_ediv_abs_sub_lt {x y H : ℤ} (hH : 0 < H)
    (he : x / H = y / H) : |x - y| < H := by
  have hx := (Int.ediv_eq_iff_of_pos hH).mp (rfl : x / H = x / H)
  have hy := (Int.ediv_eq_iff_of_pos hH).mp he.symm
  rw [abs_lt]
  constructor <;> omega

theorem shifted_integer_block_image_card_le {ι : Type*} (S : Finset ι)
    (t : ι → ℤ) (A : ℤ) (V : ℕ) {H : ℕ} (hH : 0 < H)
    (ht : ∀ i ∈ S, A ≤ t i ∧ t i ≤ A + (V : ℤ)) :
    (S.image (fun i => (t i - A) / (H : ℤ))).card ≤ V / H + 1 := by
  classical
  have hHZ : (0 : ℤ) < H := by exact_mod_cast hH
  have hsub : S.image (fun i => (t i - A) / (H : ℤ)) ⊆
      Finset.Icc (0 : ℤ) ((V / H : ℕ) : ℤ) := by
    intro j hj
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hj
    obtain ⟨hl, hu⟩ := ht i hi
    apply Finset.mem_Icc.mpr
    constructor
    · exact Int.ediv_nonneg (by omega) hHZ.le
    · have hh := Int.ediv_le_ediv hHZ (show t i - A ≤ (V : ℤ) by omega)
      simpa only [Int.natCast_ediv] using hh
  calc
    _ ≤ (Finset.Icc (0 : ℤ) ((V / H : ℕ) : ℤ)).card := Finset.card_le_card hsub
    _ = V / H + 1 := by
      generalize V / H = k
      rw [Int.card_Icc]
      omega

theorem half_integer_block_pos {r : ℕ} (hr : 2 ≤ r) : 0 < r / 2 := by omega

theorem half_integer_block_comparison {r : ℕ} (hr : 2 ≤ r) :
    (r : ℝ) ≤ 3 * (r / 2 : ℕ) ∧ (r / 2 : ℕ) ≤ (r : ℝ) / 2 := by
  have hlow : r ≤ 3 * (r / 2) := by omega
  have hhigh : 2 * (r / 2) ≤ r := by omega
  constructor
  · exact_mod_cast hlow
  · have hh : (2 : ℝ) * (r / 2 : ℕ) ≤ r := by exact_mod_cast hhigh
    linarith

theorem half_integer_block_count_le {r : ℕ} (hr : 2 ≤ r) (V : ℕ) :
    ((V / (r / 2) + 1 : ℕ) : ℝ) ≤ 1 + 3 * (V : ℝ) / r := by
  have hr0 : (0 : ℝ) < r := by exact_mod_cast (show 0 < r by omega)
  have hh := (half_integer_block_comparison hr).1
  have hmul : (V / (r / 2) : ℕ) * (r / 2 : ℕ) ≤ (V : ℝ) := by
    exact_mod_cast Nat.div_mul_le_self V (r / 2)
  have hquot : (0 : ℝ) ≤ (V / (r / 2) : ℕ) := by positivity
  push_cast
  have hgoal : (V / (r / 2) : ℕ) ≤ 3 * (V : ℝ) / r := by
    apply (le_div_iff₀ hr0).mpr
    nlinarith
  linarith


theorem integer_interval_injOn_card_le {ι : Type*} (S : Finset ι)
    (t : ι → ℤ) (hinj : Set.InjOn t S) (A : ℤ) (V : ℕ)
    (ht : ∀ i ∈ S, A ≤ t i ∧ t i ≤ A + (V : ℤ)) :
    S.card ≤ V + 1 := by
  classical
  have hs : S.image t ⊆ Finset.Icc A (A + (V : ℤ)) := by
    intro z hz
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hz
    exact Finset.mem_Icc.mpr (ht i hi)
  calc
    S.card = (S.image t).card := (Finset.card_image_of_injOn hinj).symm
    _ ≤ (Finset.Icc A (A + (V : ℤ))).card := Finset.card_le_card hs
    _ = V + 1 := by
      rw [Int.card_Icc]
      have he : A + (V : ℤ) + 1 - A = ((V + 1 : ℕ) : ℤ) := by push_cast; ring
      rw [he, Int.toNat_natCast]
end

section
open Finset
theorem grouped_prime_slot_weight_le_one {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (r : ℕ)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h))) (n : ℕ) :
    orderedSlotWeight (fun s : G × Fin r => P s.1)
      ((r.factorial : ℝ)^(Fintype.card G)) n ≤ 1 := by
  classical
  let x : (∀ s : G × Fin r, P s.1) → ∀ _g : G, Fin r → ℕ :=
    fun a g i => (a (g, i)).val
  have hxinj : Function.Injective x := by
    intro a b h
    funext s
    rcases s with ⟨g, i⟩
    exact Subtype.ext (congrFun (congrFun h g) i)
  have hx : ∀ a g i, x a g i ∈ P g := fun a g i => (a (g, i)).property
  have heq (a : ∀ s : G × Fin r, P s.1) :
      orderedSlotProduct (fun s : G × Fin r => P s.1) a = ∏ g, ∏ i, x a g i :=
    Fintype.prod_prod_type (fun s : G × Fin r => (a s).val)
  have hcard := card_prime_group_product_fiber P (fun _ => r) hprime hdisj x hxinj hx n
  have hcard' : Nat.card {a : ∀ s : G × Fin r, P s.1 //
      orderedSlotProduct (fun s : G × Fin r => P s.1) a = n} ≤ r.factorial^(Fintype.card G) := by
    simpa only [heq, prod_const, card_univ] using hcard
  rw [ordered_slot_weight_eq_count]
  apply (div_le_one (by positivity : 0 < (r.factorial : ℝ)^(Fintype.card G))).mpr
  exact_mod_cast hcard'
end

section
open Finset
theorem roughBand_divisor_filter_subset {A B W : ℝ} {n : ℕ} (hn : n ≠ 0) :
    (roughBand A B W).filter (fun d => d ∣ n) ⊆ roughDivisors W n := by
  intro d hd
  obtain ⟨hdR, hdvd⟩ := mem_filter.mp hd
  apply mem_filter.mpr
  exact ⟨Nat.mem_divisors.mpr ⟨hdvd, hn⟩, fun p hp => ((mem_filter.mp hdR).2 p hp).le⟩

theorem roughBand_divisor_filter_card_le {A B W : ℝ} {n : ℕ} (hn : n ≠ 0) :
    ((roughBand A B W).filter (fun d => d ∣ n)).card ≤ (roughDivisors W n).card :=
  card_le_card (roughBand_divisor_filter_subset hn)

theorem one_mem_roughDivisors (W : ℝ) {n : ℕ} (hn : n ≠ 0) :
    1 ∈ roughDivisors W n := by
  simp [roughDivisors, Nat.mem_divisors, hn]

theorem one_le_roughDivisors_card (W : ℝ) {n : ℕ} (hn : n ≠ 0) :
    1 ≤ (roughDivisors W n).card :=
  card_pos.mpr ⟨1, one_mem_roughDivisors W hn⟩
end

section
open Finset
private theorem prod_replace_eq_mul_div {I : Type*} [Fintype I] [DecidableEq I]
    (x : I → ℕ) (e : I) (q : ℕ) (he : x e ≠ 0) :
    (∏ i, if i = e then q else x i) = q * ((∏ i, x i) / x e) := by
  have hrest : (∏ i ∈ univ.erase e, if i = e then q else x i) =
      ∏ i ∈ univ.erase e, x i := by
    apply prod_congr rfl
    intro i hi
    exact if_neg (mem_erase.mp hi).1
  rw [← mul_prod_erase univ (fun i => if i = e then q else x i) (mem_univ e),
    if_pos rfl, hrest, ← mul_prod_erase univ x (mem_univ e),
    Nat.mul_div_cancel_left _ (Nat.pos_of_ne_zero he)]

/-- An injectively represented finite family with one exceptional slot has the stated product-fiber bound. -/
theorem card_one_exception_prime_product_fiber {G Ω : Type*} [Fintype G] [Fintype Ω]
    (P : G → Finset ℕ) (R : Finset ℕ) (r : ℕ) (e : G × Fin r)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hR0 : ∀ d ∈ R, d ≠ 0) (q0 : ℕ) (hq0 : q0 ∈ P e.1)
    (x : Ω → G × Fin r → ℕ) (hxinj : Function.Injective x)
    (hxR : ∀ a, x a e ∈ R)
    (hxP : ∀ a s, s ≠ e → x a s ∈ P s.1) (n : ℕ) :
    Nat.card {a : Ω // (∏ s, x a s) = n} ≤
      (R.filter (fun d => d ∣ n)).card * ∏ _g : G, r.factorial := by
  classical
  let F := {a : Ω // (∏ s, x a s) = n}
  let D := R.filter (fun d => d ∣ n)
  let B (d : D) := {y : ∀ g : G, Fin r → P g //
    (∏ g, ∏ i, (y g i).val) = q0 * (n / d.val)}
  let y (a : Ω) (g : G) (i : Fin r) : P g :=
    ⟨if (g, i) = e then q0 else x a (g, i), by
      split_ifs with hs
      · have hg : g = e.1 := congrArg Prod.fst hs
        simpa only [hg] using hq0
      · exact hxP a (g, i) hs⟩
  let f : F → Σ d : D, B d := fun a =>
    ⟨⟨x a.val e, by
        refine mem_filter.mpr ⟨hxR a.val, ?_⟩
        simpa only [a.property] using dvd_prod_of_mem (x a.val) (mem_univ e)⟩,
      ⟨y a.val, by
        change (∏ g, ∏ i, if (g, i) = e then q0 else x a.val (g, i)) = q0 * (n / x a.val e)
        rw [← Fintype.prod_prod_type (fun s : G × Fin r => if s = e then q0 else x a.val s),
          prod_replace_eq_mul_div (x a.val) e q0 (hR0 _ (hxR a.val)),
          a.property]⟩⟩
  let recover (b : Σ d : D, B d) (s : G × Fin r) : ℕ :=
    if s = e then b.1.val else (b.2.val s.1 s.2).val
  have hrecovery (a : F) : recover (f a) = x a.val := by
    funext s
    by_cases hs : s = e
    · simp [recover, f, hs]
    · simp [recover, f, y, hs]
  have hfinj : Function.Injective f := by
    intro a b hab
    apply Subtype.ext
    apply hxinj
    rw [← hrecovery a, ← hrecovery b, hab]
  change Nat.card F ≤ D.card * _
  rw [Nat.card_eq_fintype_card]
  calc
    Fintype.card F ≤ Fintype.card (Σ d : D, B d) := Fintype.card_le_of_injective f hfinj
    _ = ∑ d : D, Fintype.card (B d) := Fintype.card_sigma
    _ ≤ ∑ _d : D, ∏ _g : G, r.factorial := by
      apply sum_le_sum
      intro d _
      simpa only [B, Nat.card_eq_fintype_card] using
        card_ordered_prime_group_product_fiber P (fun _ => r) hprime hdisj (q0 * (n / d.val))
    _ = D.card * ∏ _g : G, r.factorial := by simp

/-- Slot choices for a single nonprime exception. -/
noncomputable def oneExceptionPrimeChoices {G : Type*} [DecidableEq G]
    (P : G → Finset ℕ) (R : Finset ℕ) {r : ℕ} (e : G × Fin r)
    (s : G × Fin r) : Finset ℕ :=
  if s = e then R else P s.1

/-- The direct ordered-slot specialization, including arbitrary repeated prime choices. -/
theorem card_one_exception_ordered_slot_fiber {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (R : Finset ℕ) (r : ℕ) (e : G × Fin r)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hR0 : ∀ d ∈ R, d ≠ 0) (q0 : ℕ) (hq0 : q0 ∈ P e.1) (n : ℕ) :
    Nat.card {x : ∀ s, oneExceptionPrimeChoices P R e s //
      orderedSlotProduct (oneExceptionPrimeChoices P R e) x = n} ≤
        (R.filter (fun d => d ∣ n)).card * r.factorial ^ Fintype.card G := by
  classical
  have hinj : Function.Injective (fun x : ∀ s, oneExceptionPrimeChoices P R e s =>
      fun s => (x s).val) := by
    intro x y h
    funext s
    exact Subtype.ext (congrFun h s)
  have h := card_one_exception_prime_product_fiber P R r e hprime hdisj hR0 q0 hq0
    (fun x : ∀ s, oneExceptionPrimeChoices P R e s => fun s => (x s).val) hinj
    (fun x => by simpa [oneExceptionPrimeChoices] using (x e).property)
    (fun x s hs => by simpa only [oneExceptionPrimeChoices, if_neg hs] using (x s).property) n
  simpa only [orderedSlotProduct, prod_const, card_univ] using h

/-- With the natural factorial normalization, the ordered-slot weight costs only a rough-divisor count. -/
theorem one_exception_ordered_slot_weight_le {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (R : Finset ℕ) (r : ℕ) (e : G × Fin r)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hR0 : ∀ d ∈ R, d ≠ 0) (q0 : ℕ) (hq0 : q0 ∈ P e.1) (n : ℕ) :
    orderedSlotWeight (oneExceptionPrimeChoices P R e)
      ((r.factorial : ℝ)^Fintype.card G) n ≤ (R.filter (fun d => d ∣ n)).card := by
  rw [ordered_slot_weight_eq_count]
  apply (div_le_iff₀ (by positivity : (0 : ℝ) < (r.factorial : ℝ)^Fintype.card G)).mpr
  exact_mod_cast card_one_exception_ordered_slot_fiber P R r e hprime hdisj hR0 q0 hq0 n
end

section
open Finset Filter
theorem exists_candidate_marked_weight_rpow_bound {c q : ℝ}
    (hc : 0 < c) (hq0 : 0 ≤ q) (hq1 : q < 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ L : ℝ in atTop, ∀ u : ℤ,
      0 ≤ markedDivisorWeight (candidatePIndices c L) (candidatePBand (c * L)) q
        (fun j => ∑ p ∈ candidatePBand (c * L) j, 1 / (p : ℝ)) (fun _ => 1) u ∧
      markedDivisorWeight (candidatePIndices c L) (candidatePBand (c * L)) q
        (fun j => ∑ p ∈ candidatePBand (c * L) j, 1 / (p : ℝ)) (fun _ => 1) u ≤ L^C := by
  obtain ⟨v, V, hv, hV, hpool⟩ := exists_candidate_P_pool_bounds hc
  refine ⟨(2 / (5 * Real.log 2)) * Real.log (markedDivisorBound q v 1),
    mul_nonneg (by positivity) (Real.log_nonneg (one_le_markedDivisorBound q v 1)), ?_⟩
  filter_upwards [hpool] with L hp
  rcases hp with ⟨hL, _, _, hcard, _, hdata⟩
  intro u
  constructor
  · exact marked_divisor_weight_nonneg _ _ hq0 _ _
      (fun _ _ => sum_nonneg (fun _ _ => by positivity)) u
  · exact marked_divisor_weight_le_rpow _ _ hq0 hq1 hv (zero_lt_one.trans_le hL)
      _ _ 1 (fun j hj => (hdata j hj).1) (fun _ _ => le_rfl) hcard u

theorem eventually_rpow_mul_exp_sqrt_le (C K : ℝ) :
    ∀ᶠ L : ℝ in atTop,
      L^C * Real.exp (K * Real.sqrt L) ≤ Real.exp ((K + 1) * Real.sqrt L) := by
  filter_upwards [eventually_mul_rpow_log_add_le_rpow
    (a := (0 : ℝ)) (b := (1/2 : ℝ)) (c := (1 : ℝ))
    (by norm_num) (by norm_num) (by norm_num) C 0,
    eventually_gt_atTop (0 : ℝ)] with L h hL
  simp only [Real.rpow_zero, mul_one, add_zero, one_mul] at h
  rw [Real.rpow_def_of_pos hL, ← Real.exp_add]
  apply Real.exp_le_exp.mpr
  rw [Real.sqrt_eq_rpow]
  nlinarith

/-- Any nonnegative factor with a square-root exponential bound can be
multiplied by the actual marked weight with just one extra unit in its exponent. -/
theorem eventually_candidate_marked_multiplier_bound {c q : ℝ}
    (hc : 0 < c) (hq0 : 0 ≤ q) (hq1 : q < 1) (K : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (u : ℤ) (a : ℝ), 0 ≤ a →
      a ≤ Real.exp (K * Real.sqrt L) →
      a * markedDivisorWeight (candidatePIndices c L) (candidatePBand (c * L)) q
        (fun j => ∑ p ∈ candidatePBand (c * L) j, 1 / (p : ℝ)) (fun _ => 1) u ≤
          Real.exp ((K + 1) * Real.sqrt L) := by
  obtain ⟨C, hC, hweight⟩ := exists_candidate_marked_weight_rpow_bound hc hq0 hq1
  filter_upwards [hweight, eventually_rpow_mul_exp_sqrt_le C K] with L hw habsorb
  intro u a ha habound
  calc
    _ ≤ Real.exp (K * Real.sqrt L) * L^C :=
      mul_le_mul habound (hw u).2 (hw u).1 (Real.exp_pos _).le
    _ = L^C * Real.exp (K * Real.sqrt L) := mul_comm _ _
    _ ≤ _ := habsorb
end

section
open Finset Filter
theorem eventually_log_sqrt_loss_le_linear (C K : ℝ) {eps : ℝ} (heps : 0 < eps) :
    ∀ᶠ L : ℝ in atTop, C * Real.log L + K * Real.sqrt L ≤ eps * L := by
  have heps2 : 0 < eps / 2 := by positivity
  filter_upwards [eventually_mul_rpow_log_add_le_rpow
      (a := (0 : ℝ)) (b := (1 : ℝ)) (by norm_num) (by norm_num) heps2 C 0,
    eventually_mul_rpow_log_add_le_rpow
      (a := (1/2 : ℝ)) (b := (1 : ℝ)) (by norm_num) (by norm_num) heps2 (max K 0) 0,
    Real.tendsto_log_atTop.eventually (eventually_ge_atTop (1 : ℝ)),
    eventually_gt_atTop (0 : ℝ)] with L hpoly hsqrt hlog hL
  simp only [Real.rpow_zero, Real.rpow_one, mul_one, add_zero] at hpoly hsqrt
  have hroot : K * Real.sqrt L ≤ (max K 0) * L^(1/2 : ℝ) * Real.log L := by
    calc
      _ ≤ max K 0 * Real.sqrt L :=
        mul_le_mul_of_nonneg_right (le_max_left _ _) (Real.sqrt_nonneg L)
      _ = max K 0 * L^(1/2 : ℝ) := by rw [Real.sqrt_eq_rpow]
      _ ≤ _ := le_mul_of_one_le_right
        (mul_nonneg (le_max_right _ _) (Real.rpow_nonneg hL.le _)) hlog
  linarith

/-- The threshold is uniform over every finite set and every real weight.
No positivity of individual weights is required for this counting implication. -/
theorem eventually_weighted_mass_card_lower (C K : ℝ) {eps : ℝ} (heps : 0 < eps) :
    ∀ᶠ L : ℝ in atTop, ∀ (α : Type*) (S : Finset α) (w : α → ℝ),
      Real.exp L * L^(-C) ≤ (∑ u ∈ S, w u) →
      (∀ u ∈ S, w u ≤ Real.exp (K * Real.sqrt L)) →
      Real.exp ((1 - eps) * L) ≤ (S.card : ℝ) := by
  filter_upwards [eventually_log_sqrt_loss_le_linear C K heps,
    eventually_gt_atTop (0 : ℝ)] with L hloss hL
  intro α S w hmass hw
  have hsum : (∑ u ∈ S, w u) ≤ (S.card : ℝ) * Real.exp (K * Real.sqrt L) := by
    calc
      _ ≤ ∑ _u ∈ S, Real.exp (K * Real.sqrt L) := sum_le_sum hw
      _ = _ := by simp
  have hexp : Real.exp ((1 - eps) * L) * Real.exp (K * Real.sqrt L) ≤
      Real.exp L * L^(-C) := by
    rw [Real.rpow_def_of_pos hL, ← Real.exp_add, ← Real.exp_add]
    apply Real.exp_le_exp.mpr
    nlinarith
  have hbound := hexp.trans (hmass.trans hsum)
  have hpos := Real.exp_pos (K * Real.sqrt L)
  nlinarith
end

section
open Finset Filter
open scoped Topology
private theorem support_eventually_pow_twenty_le_exp_rpow {a : ℝ} (ha : 0 < a) :
    ∀ᶠ L : ℝ in atTop, L^20 ≤ Real.exp (L^a) := by
  filter_upwards [eventually_mul_rpow_log_add_le_rpow (a := 0) ha ha
    (show (0 : ℝ) < 1 by norm_num) 20 0,
    eventually_gt_atTop (0 : ℝ)] with L hbound hL
  have hpow : L^20 = Real.exp (20 * Real.log L) := by
    rw [mul_comm, Real.exp_mul, Real.exp_log hL]
    norm_num
  rw [hpow]
  apply Real.exp_le_exp.mpr
  simpa only [Real.rpow_zero, mul_one, add_zero, one_mul] using hbound

theorem ordered_slot_product_primeFactors_inherit {I : Type*} [Fintype I]
    (choices : I → Finset ℕ) (hzero : ∀ i, ∀ n ∈ choices i, n ≠ 0)
    (property : ℕ → Prop)
    (hproperty : ∀ i, ∀ n ∈ choices i, ∀ p ∈ n.primeFactors, property p)
    (x : ∀ i, choices i) :
    ∀ p ∈ (orderedSlotProduct choices x).primeFactors, property p := by
  classical
  intro p hp
  obtain ⟨hpp, hpdvd, _⟩ := Nat.mem_primeFactors.mp hp
  obtain ⟨i, _, hpi⟩ :=
    ((Nat.prime_iff.mp hpp).dvd_finsetProd_iff (fun i => (x i).val)).mp hpdvd
  exact hproperty i (x i).val (x i).property p
    (Nat.mem_primeFactors.mpr ⟨hpp, hpi, hzero i (x i).val (x i).property⟩)

theorem candidate_Q_slot_primeFactors_range {c L A B : ℝ} {r jStar : ℕ}
    (hcL : 0 ≤ c * L)
    (hrough : A ≤ Real.exp (Real.sqrt L))
    (hupper : (6/5 : ℝ) * c * L ≤ B)
    (hregular : ∀ j ∈ candidateQIndices c L, A ≤ Real.exp (c * L / 2^j))
    (slot : (candidateQIndices c L) × Fin r) {n : ℕ}
    (hn : n ∈ candidateQSlotChoices c L r jStar slot) :
    ∀ p ∈ n.primeFactors, A < (p : ℝ) ∧ (p : ℝ) ≤ Real.exp B := by
  classical
  have hscale (j : ℕ) : (6/5 : ℝ) * c * L / 2^j ≤ B := by
    apply le_trans _ hupper
    apply (div_le_iff₀ (by positivity : (0 : ℝ) < 2^j)).mpr
    have hnonneg : 0 ≤ (6/5 : ℝ) * c * L := by nlinarith
    simpa only [mul_one] using
      mul_le_mul_of_nonneg_left (one_le_pow₀ (by norm_num : (1 : ℝ) ≤ 2) : (1 : ℝ) ≤ 2^j) hnonneg
  intro p hp
  simp only [candidateQSlotChoices] at hn
  split_ifs at hn with hs
  · refine ⟨hrough.trans_lt ((mem_filter.mp hn).2 p hp), ?_⟩
    have hpn : p ≤ n := Nat.le_of_dvd (roughBand_pos hn) (Nat.dvd_of_mem_primeFactors hp)
    have hnUpper : (n : ℝ) ≤ Real.exp ((6/5 : ℝ) * c * L / 2^jStar) := by
      have hh := (mem_Ioc.mp (mem_filter.mp hn).1).2
      exact (Nat.cast_le.mpr hh).trans (Nat.floor_le (Real.exp_pos _).le)
    exact (Nat.cast_le.mpr hpn).trans (hnUpper.trans (Real.exp_le_exp.mpr (hscale jStar)))
  · obtain ⟨hnp, hnlo, hnhi⟩ := (mem_dyadicPrimeBand_iff (c * L) 1 (6/5) slot.1.val n).mp hn
    obtain ⟨hpp, hpdvd, _⟩ := Nat.mem_primeFactors.mp hp
    have hpn : p = n := ((Nat.dvd_prime hnp).mp hpdvd).resolve_left hpp.ne_one
    subst p
    refine ⟨(hregular slot.1.val slot.1.property).trans_lt ?_, ?_⟩
    · simpa only [one_mul] using hnlo
    · apply hnhi.trans (Real.exp_le_exp.mpr ?_)
      simpa only [mul_assoc] using hscale slot.1.val

theorem candidate_Q_weight_primeFactors_range {c L A B : ℝ} {r jStar n : ℕ}
    (hcL : 0 ≤ c * L)
    (hrough : A ≤ Real.exp (Real.sqrt L))
    (hupper : (6/5 : ℝ) * c * L ≤ B)
    (hregular : ∀ j ∈ candidateQIndices c L, A ≤ Real.exp (c * L / 2^j))
    (hn : candidateQWeight c L r jStar n ≠ 0) :
    ∀ p ∈ n.primeFactors, A < (p : ℝ) ∧ (p : ℝ) ≤ Real.exp B := by
  obtain ⟨x, hx⟩ := ordered_slot_weight_ne_zero_support _ _ hn
  rw [← hx]
  apply ordered_slot_product_primeFactors_inherit _
    (fun i n hn => candidate_Q_slot_nonzero c L r jStar i hn)
  exact fun i n hn => candidate_Q_slot_primeFactors_range hcL hrough hupper hregular i hn

theorem eventually_candidate_Q_weight_primeFactors_range {c δ : ℝ}
    (hc : 0 < c) (hsmall : (6/5 : ℝ) * c ≤ δ) :
    ∀ᶠ L : ℝ in atTop, ∀ r jStar n : ℕ, candidateQWeight c L r jStar n ≠ 0 →
      ∀ p ∈ n.primeFactors, L^20 < (p : ℝ) ∧ (p : ℝ) ≤ Real.exp (δ * L) := by
  filter_upwards [eventually_candidateQIndices_geometry hc,
    support_eventually_pow_twenty_le_exp_rpow (show (0 : ℝ) < 1/2 by norm_num),
    eventually_gt_atTop (0 : ℝ)] with L hQ hrough hL
  intro r jStar n hn
  apply candidate_Q_weight_primeFactors_range (mul_nonneg hc.le hL.le) _
    (mul_le_mul_of_nonneg_right hsmall hL.le) _ hn
  · simpa only [Real.sqrt_eq_rpow] using hrough
  · intro j hj
    have hpow : L^20 = Real.exp (20 * Real.log L) := by
      rw [mul_comm, Real.exp_mul, Real.exp_log hL]
      norm_num
    rw [hpow]
    exact Real.exp_le_exp.mpr (hQ.2 j hj).1

theorem eventually_candidate_P_pool_prime_range {c δ : ℝ}
    (hc : 0 < c) (hδ : 0 < δ) :
    ∀ᶠ L : ℝ in atTop, ∀ p ∈ (candidatePIndices c L).biUnion (candidatePBand (c * L)),
      L^20 < (p : ℝ) ∧ (p : ℝ) ≤ Real.exp (δ * L) := by
  obtain ⟨v, V, _, _, hpool⟩ := exists_candidate_P_pool_bounds hc
  filter_upwards [hpool,
    support_eventually_pow_twenty_le_exp_rpow (show (0 : ℝ) < 1/10 by norm_num),
    eventually_mul_rpow_log_add_le_rpow (a := (2/5 : ℝ)) (b := 1)
      (by norm_num) (by norm_num) hδ 1 0,
    Real.tendsto_log_atTop.eventually (eventually_ge_atTop (1 : ℝ))]
    with L hpool hlower hupper hlog
  intro p hp
  obtain ⟨j, hj, hpj⟩ := mem_biUnion.mp hp
  obtain ⟨_, hlo, hhi⟩ := (hpool.2.2.2.2.2 j hj).2.2 p hpj
  refine ⟨?_, hhi.trans (Real.exp_le_exp.mpr ?_)⟩
  · exact hlower.trans_lt hlo
  · calc
      L^(2/5 : ℝ) ≤ L^(2/5 : ℝ) * Real.log L := by
        simpa only [mul_one] using mul_le_mul_of_nonneg_left hlog
          (Real.rpow_nonneg (by linarith [hpool.1]) (2/5 : ℝ))
      _ ≤ δ * L := by simpa only [one_mul, add_zero, Real.rpow_one] using hupper

theorem eventually_candidate_coefficient_primeFactors_range {c δ : ℝ}
    (hc : 0 < c) (hsmall : (6/5 : ℝ) * c ≤ δ) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar u : ℕ),
      candidateCoefficient c L q r jStar u ≠ 0 →
      ∀ p ∈ u.primeFactors, L^20 < (p : ℝ) ∧ (p : ℝ) ≤ Real.exp (δ * L) := by
  have hδ : 0 < δ := lt_of_lt_of_le (by positivity) hsmall
  filter_upwards [eventually_candidate_Q_weight_primeFactors_range hc hsmall,
    eventually_candidate_P_pool_prime_range hc hδ] with L hQ hP
  intro q r jStar u hu p hp
  obtain ⟨hpp, hpdiv, hu0⟩ := Nat.mem_primeFactors.mp hp
  let P := (candidatePIndices c L).biUnion (candidatePBand (c * L))
  have hprod : p ∣ primePoolPart P u * primePoolFreePart P u := by
    rwa [primePoolPart_mul_primePoolFreePart]
  rcases hpp.dvd_mul.mp hprod with hpart | hfree
  · exact hP p ((Nat.mem_factoredNumbers'.mp (primePoolPart_mem_factoredNumbers P u)) p hpp hpart)
  · apply hQ r jStar (primePoolFreePart P u)
      (left_ne_zero_of_mul hu) p
    exact Nat.mem_primeFactors.mpr ⟨hpp, hfree, primePoolFreePart_ne_zero P hu0⟩
end

section

/-- The explicit scale satisfies the candidate centering equation. -/
theorem candidate_scale_centered {r : ℕ} (hr : 0 < r) :
    0 < (5 : ℝ) / (11 * (r : ℝ)) ∧
      (11 / 5 : ℝ) * (r : ℝ) * (5 / (11 * (r : ℝ))) = 1 := by
  have hrR : (0 : ℝ) < r := by exact_mod_cast hr
  constructor
  · positivity
  · field_simp

/-- Increasing the integer slot count makes the full candidate prime range arbitrarily small. -/
theorem exists_candidate_scale_for_prime_bound {δ : ℝ} (hδ : 0 < δ) :
    ∃ r : ℕ, ∃ c : ℝ, 0 < r ∧ 0 < c ∧
      (11 / 5 : ℝ) * (r : ℝ) * c = 1 ∧ (6 / 5 : ℝ) * c ≤ δ := by
  obtain ⟨r, hr⟩ := exists_nat_gt ((6 : ℝ) / (11 * δ))
  have hthreshold : (0 : ℝ) < 6 / (11 * δ) := by positivity
  have hrR : (0 : ℝ) < r := hthreshold.trans hr
  have hrN : 0 < r := by exact_mod_cast hrR
  obtain ⟨hc, hcenter⟩ := candidate_scale_centered hrN
  refine ⟨r, 5 / (11 * (r : ℝ)), hrN, hc, hcenter, ?_⟩
  have hbound : 6 < (r : ℝ) * (11 * δ) := (div_lt_iff₀ (by positivity)).mp hr
  have heq : (6 / 5 : ℝ) * (5 / (11 * (r : ℝ))) = 6 / (11 * (r : ℝ)) := by ring
  rw [heq]
  apply (div_le_iff₀ (by positivity)).mpr
  nlinarith
end

section
open Finset Classical
universe u v w

def FiniteEventPath {K : Type u} {X : Type v} (E : K → X → Type w)
    (target : ∀ k x, E k x → X) : List K → X → Type w
  | [], _ => PUnit.{w + 1}
  | k :: ks, x => Σ e : E k x, FiniteEventPath E target ks (target k x e)

noncomputable abbrev finiteEventPathFintype {K : Type u} {X : Type v} (E : K → X → Type w)
    [∀ k x, Fintype (E k x)] (target : ∀ k x, E k x → X) :
    ∀ ks x, Fintype (FiniteEventPath E target ks x)
  | [], _ => inferInstanceAs (Fintype PUnit.{w + 1})
  | k :: ks, x =>
    let _ : ∀ e : E k x, Fintype (FiniteEventPath E target ks (target k x e)) :=
      fun e => finiteEventPathFintype E target ks (target k x e)
    inferInstanceAs (Fintype (Σ e : E k x, FiniteEventPath E target ks (target k x e)))

def finiteEventPathTerminal {K : Type u} {X : Type v} (E : K → X → Type w)
    (target : ∀ k x, E k x → X) : ∀ ks x, FiniteEventPath E target ks x → X
  | [], x, _ => x
  | _ :: ks, _, ⟨_e, p⟩ => finiteEventPathTerminal E target ks _ p

def finiteEventPathWeight {K : Type u} {X : Type v} (E : K → X → Type w)
    (target : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ) :
    ∀ ks x, FiniteEventPath E target ks x → ℝ
  | [], _, _ => 1
  | k :: ks, x, ⟨e, p⟩ => w k x e * finiteEventPathWeight E target w ks _ p

theorem finite_event_path_weight_nonneg {K : Type u} {X : Type v} (E : K → X → Type w)
    (target : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (hw : ∀ k x e, 0 ≤ w k x e) (ks : List K) (x : X) (p : FiniteEventPath E target ks x) :
    0 ≤ finiteEventPathWeight E target w ks x p := by
  induction ks generalizing x with
  | nil => exact zero_le_one
  | cons k ks ih =>
    rcases p with ⟨e, p⟩
    exact mul_nonneg (hw k x e) (ih _ p)

noncomputable def finiteEventPathPositive {K : Type u} {X : Type v} (E : K → X → Type w)
    [∀ k x, Fintype (E k x)] (target : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (ks : List K) (f : X → ℂ) (x : X) : ℂ :=
  let _ := finiteEventPathFintype E target ks x
  ∑ p : FiniteEventPath E target ks x,
    (finiteEventPathWeight E target w ks x p : ℂ) * f (finiteEventPathTerminal E target ks x p)

noncomputable def finiteEventPathAction {K : Type u} {X : Type v} (E : K → X → Type w)
    [∀ k x, Fintype (E k x)] (target : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (ks : List K) (phase : ∀ x, FiniteEventPath E target ks x → ℂ) (f : X → ℂ) (x : X) : ℂ :=
  let _ := finiteEventPathFintype E target ks x
  ∑ p : FiniteEventPath E target ks x,
    (finiteEventPathWeight E target w ks x p : ℂ) * phase x p *
      f (finiteEventPathTerminal E target ks x p)

theorem finite_event_path_positive_nil {K : Type u} {X : Type v} (E : K → X → Type w)
    [∀ k x, Fintype (E k x)] (target : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (f : X → ℂ) (x : X) : finiteEventPathPositive E target w [] f x = f x := by
  change (∑ _p : PUnit.{w + 1}, (1 : ℂ) * f x) = f x
  simp

theorem finite_event_path_positive_cons {K : Type u} {X : Type v} (E : K → X → Type w)
    [∀ k x, Fintype (E k x)] (target : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (k : K) (ks : List K) (f : X → ℂ) (x : X) :
    finiteEventPathPositive E target w (k :: ks) f x =
      ∑ e : E k x, (w k x e : ℂ) * finiteEventPathPositive E target w ks f (target k x e) := by
  let _ : ∀ e : E k x, Fintype (FiniteEventPath E target ks (target k x e)) :=
    fun e => finiteEventPathFintype E target ks (target k x e)
  change (∑ p : (Σ e : E k x, FiniteEventPath E target ks (target k x e)),
    ((w k x p.1 * finiteEventPathWeight E target w ks _ p.2 : ℝ) : ℂ) *
      f (finiteEventPathTerminal E target ks _ p.2)) = _
  rw [Fintype.sum_sigma]
  simp only [finiteEventPathPositive, Complex.ofReal_mul, mul_sum, mul_assoc]

theorem finite_event_path_positive_eq_list {K : Type u} {X : Type v} (E : K → X → Type w)
    [∀ k x, Fintype (E k x)] (target : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (ks : List K) (f : X → ℂ) :
    finiteEventPathPositive E target w ks f =
      finiteOperatorListAction (finiteLocalEventAction E w target) ks f := by
  induction ks with
  | nil => funext x; exact finite_event_path_positive_nil E target w f x
  | cons k ks ih =>
    funext x
    rw [finite_event_path_positive_cons]
    simp only [ih, finiteOperatorListAction, finiteLocalEventAction]

theorem finite_event_path_action_one {K : Type u} {X : Type v} (E : K → X → Type w)
    [∀ k x, Fintype (E k x)] (target : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (ks : List K) (f : X → ℂ) :
    finiteEventPathAction E target w ks (fun _ _ => 1) f =
      finiteEventPathPositive E target w ks f := by
  funext x
  simp only [finiteEventPathAction, finiteEventPathPositive, mul_one]

/-- A single phase may depend on the entire trajectory, including the order
and all identities of the selected events. -/
theorem finite_event_path_norm_le_positive_re {K : Type u} {X : Type v}
    (E : K → X → Type w) [∀ k x, Fintype (E k x)]
    (target : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (hw : ∀ k x e, 0 ≤ w k x e) (ks : List K)
    (phase : ∀ x, FiniteEventPath E target ks x → ℂ)
    (hphase : ∀ x p, ‖phase x p‖ ≤ 1) (f : X → ℂ) (x : X) :
    ‖finiteEventPathAction E target w ks phase f x‖ ≤
      (finiteEventPathPositive E target w ks (complexNormEnvelope f) x).re := by
  let _ := finiteEventPathFintype E target ks x
  have hpos : (finiteEventPathPositive E target w ks (complexNormEnvelope f) x).re =
      ∑ p : FiniteEventPath E target ks x,
        finiteEventPathWeight E target w ks x p * ‖f (finiteEventPathTerminal E target ks x p)‖ := by
    simp [finiteEventPathPositive, complexNormEnvelope, Complex.mul_re]
  rw [hpos]
  unfold finiteEventPathAction
  refine (norm_sum_le _ _).trans (sum_le_sum fun p _ => ?_)
  have hp := finite_event_path_weight_nonneg E target w hw ks x p
  rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hp]
  calc
    _ ≤ (finiteEventPathWeight E target w ks x p * 1) *
        ‖f (finiteEventPathTerminal E target ks x p)‖ :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (hphase x p) hp) (norm_nonneg _)
    _ = _ := by rw [mul_one]

theorem finite_event_path_norm_le_list_re {K : Type u} {X : Type v}
    (E : K → X → Type w) [∀ k x, Fintype (E k x)]
    (target : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (hw : ∀ k x e, 0 ≤ w k x e) (ks : List K)
    (phase : ∀ x, FiniteEventPath E target ks x → ℂ)
    (hphase : ∀ x p, ‖phase x p‖ ≤ 1) (f : X → ℂ) (x : X) :
    ‖finiteEventPathAction E target w ks phase f x‖ ≤
      (finiteOperatorListAction (finiteLocalEventAction E w target) ks (complexNormEnvelope f) x).re := by
  rw [← finite_event_path_positive_eq_list]
  exact finite_event_path_norm_le_positive_re E target w hw ks phase hphase f x

theorem finite_event_path_energy_le {K : Type u} {X : Type v} [Fintype X]
    (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x)
    (E : K → X → Type w) [∀ k x, Fintype (E k x)]
    (target : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (hw : ∀ k x e, 0 ≤ w k x e) (ks : List K)
    (phase : ∀ x, FiniteEventPath E target ks x → ℂ)
    (hphase : ∀ x p, ‖phase x p‖ ≤ 1) (f : X → ℂ) (C : ℝ)
    (hbound : finiteWeightedEnergy μ
      (finiteOperatorListAction (finiteLocalEventAction E w target) ks (complexNormEnvelope f)) ≤
        C * finiteWeightedEnergy μ (complexNormEnvelope f)) :
    finiteWeightedEnergy μ (finiteEventPathAction E target w ks phase f) ≤
      C * finiteWeightedEnergy μ f := by
  apply finiteWeightedEnergy_le_of_envelope_domination μ hμ f
    (finiteEventPathAction E target w ks phase f)
    (finiteOperatorListAction (finiteLocalEventAction E w target) ks) C
  · intro x
    exact (finite_event_path_norm_le_list_re E target w hw ks phase hphase f x).trans
      (Complex.re_le_norm _)
  · exact hbound

/-- The positive local operators need preserve only the class used by their
energy estimates. The globally phased path output need not belong to it. -/
theorem finite_event_path_energy_le_of_positive_class
    {K : Type u} {X : Type v} [Fintype X]
    (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x)
    (E : K → X → Type w) [∀ k x, Fintype (E k x)]
    (target : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (hw : ∀ k x e, 0 ≤ w k x e)
    (S : (X → ℂ) → Prop)
    (hS : ∀ k f, S f → S (finiteLocalEventAction E w target k f))
    (C : K → ℝ) (hC : ∀ k, 0 ≤ C k)
    (hbound : ∀ k f, S f →
      finiteWeightedEnergy μ (finiteLocalEventAction E w target k f) ≤
        C k * finiteWeightedEnergy μ f)
    (ks : List K) (phase : ∀ x, FiniteEventPath E target ks x → ℂ)
    (hphase : ∀ x p, ‖phase x p‖ ≤ 1) (f : X → ℂ)
    (hf : S (complexNormEnvelope f)) :
    finiteWeightedEnergy μ (finiteEventPathAction E target w ks phase f) ≤
      (ks.map C).prod * finiteWeightedEnergy μ f := by
  apply finite_event_path_energy_le μ hμ E target w hw ks phase hphase f
  exact finite_operator_list_energy_le μ S (finiteLocalEventAction E w target)
    hS C hC hbound ks (complexNormEnvelope f) hf

/-- Any history-dependent exclusion can be inserted into the one path phase. -/
theorem finite_event_path_mask_norm_le_list_re {K : Type u} {X : Type v}
    (E : K → X → Type w) [∀ k x, Fintype (E k x)]
    (target : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (hw : ∀ k x e, 0 ≤ w k x e) (ks : List K)
    (allowed : ∀ x, FiniteEventPath E target ks x → Prop)
    (phase : ∀ x, FiniteEventPath E target ks x → ℂ)
    (hphase : ∀ x p, ‖phase x p‖ ≤ 1) (f : X → ℂ) (x : X) :
    ‖finiteEventPathAction E target w ks (fun x p => if allowed x p then phase x p else 0) f x‖ ≤
      (finiteOperatorListAction (finiteLocalEventAction E w target) ks (complexNormEnvelope f) x).re := by
  apply finite_event_path_norm_le_list_re E target w hw ks
  intro y p
  split_ifs
  · exact hphase y p
  · simp
end

section
open Finset Classical
theorem productMemoryCutoff_re_mono {G : Type*} [Fintype G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (f g : ProductBoundedOrderedState P Z t B → ℂ)
    (hfg : ∀ x, (f x).re ≤ (g x).re) (x : ProductBoundedOrderedState P Z t B) :
    (productMemoryCutoff f x).re ≤ (productMemoryCutoff g x).re := by
  unfold productMemoryCutoff
  split_ifs
  · exact hfg x
  · exact le_rfl

theorem complexNormEnvelope_productMemoryCutoff {G : Type*} [Fintype G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (f : ProductBoundedOrderedState P Z t B → ℂ) :
    complexNormEnvelope (productMemoryCutoff f) =
      productMemoryCutoff (complexNormEnvelope f) := by
  funext x
  simp only [complexNormEnvelope, productMemoryCutoff]
  split_ifs
  · rfl
  · simp only [norm_zero, Complex.ofReal_zero]

section

variable {G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  (Δ D : G → ℤ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (t : G → ℕ) (B : ℕ)

theorem unrestricted_coupled_positive_cutoff_eq_product
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ) :
    unrestrictedCoupledCutoffProductOperator n Δ D μ ρ V t B (fun _ _ => 1) f =
      unrestrictedCutoffProductOperator n Δ D μ ρ V t B
        (fun _ _ _ _ _ _ => 1) univ f := by
  unfold unrestrictedCoupledCutoffProductOperator unrestrictedCutoffProductOperator
  rw [unrestricted_coupled_positive_eq_product]

omit [DecidableEq G] [∀ g p, NeZero (n g p)] in
theorem unrestricted_coupled_positive_re_mono
    (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ V g) (hμ : ∀ g p, 0 ≤ μ g p)
    (f g : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hfg : ∀ x, (f x).re ≤ (g x).re)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) :
    (unrestrictedCoupledProductOperator n Δ D μ ρ V t B (fun _ _ => 1) f x).re ≤
      (unrestrictedCoupledProductOperator n Δ D μ ρ V t B (fun _ _ => 1) g x).re := by
  exact finite_product_event_re_mono
    (fun j => UnrestrictedBoundedEvent (n j) (Δ j) (D j) (t j) B)
    (fun j => unrestrictedBoundedEventWeight (n j) (Δ j) (D j) (μ j) ρ (V j) (t j) B)
    (fun j => unrestrictedBoundedEventTarget (n j) (Δ j) (D j) (t j) B)
    (fun j s e => unrestrictedBoundedEventWeight_nonneg (n j) (Δ j) (D j) (μ j)
      hρ (hV j) (hμ j) (t j) B s e) f g hfg x

omit [DecidableEq G] [∀ g p, NeZero (n g p)] in
theorem unrestricted_coupled_positive_cutoff_re_mono
    (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ V g) (hμ : ∀ g p, 0 ≤ μ g p)
    (f g : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hfg : ∀ x, (f x).re ≤ (g x).re)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) :
    (unrestrictedCoupledCutoffProductOperator n Δ D μ ρ V t B (fun _ _ => 1) f x).re ≤
      (unrestrictedCoupledCutoffProductOperator n Δ D μ ρ V t B (fun _ _ => 1) g x).re := by
  apply productMemoryCutoff_re_mono
  exact unrestricted_coupled_positive_re_mono n Δ D μ ρ V t B hρ hV hμ _ _
    (productMemoryCutoff_re_mono f g hfg)

omit [DecidableEq G] [∀ g p, NeZero (n g p)] in
theorem unrestricted_coupled_cutoff_norm_le_positive_re
    (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ V g) (hμ : ∀ g p, 0 ≤ μ g p)
    (phase : UnrestrictedProductPhase n Δ D t B)
    (hphase : ∀ s e, ‖phase s e‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) :
    ‖unrestrictedCoupledCutoffProductOperator n Δ D μ ρ V t B phase f x‖ ≤
      (unrestrictedCoupledCutoffProductOperator n Δ D μ ρ V t B (fun _ _ => 1)
        (complexNormEnvelope f) x).re := by
  have h := finite_product_event_norm_le_positive_re
    (fun j => UnrestrictedBoundedEvent (n j) (Δ j) (D j) (t j) B)
    (fun j => unrestrictedBoundedEventWeight (n j) (Δ j) (D j) (μ j) ρ (V j) (t j) B)
    (fun j => unrestrictedBoundedEventTarget (n j) (Δ j) (D j) (t j) B)
    (fun j s e => unrestrictedBoundedEventWeight_nonneg (n j) (Δ j) (D j) (μ j)
      hρ (hV j) (hμ j) (t j) B s e) phase hphase (productMemoryCutoff f) x
  change ‖unrestrictedCoupledProductOperator n Δ D μ ρ V t B phase
      (productMemoryCutoff f) x‖ ≤
    (unrestrictedCoupledProductOperator n Δ D μ ρ V t B (fun _ _ => 1)
      (complexNormEnvelope (productMemoryCutoff f)) x).re at h
  rw [complexNormEnvelope_productMemoryCutoff] at h
  unfold unrestrictedCoupledCutoffProductOperator
  simp only [productMemoryCutoff]
  split_ifs
  · exact h
  · simp only [norm_zero, Complex.zero_re, le_refl]

end

section

variable {E G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  (Δ D : E → G → ℤ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (t : G → ℕ) (B : ℕ)

noncomputable def unrestrictedCoupledEdgeList
    (phase : ∀ e, UnrestrictedProductPhase n (Δ e) (D e) t B)
    (edges : List E)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ) :=
  finiteOperatorListAction
    (fun e => unrestrictedCoupledCutoffProductOperator n (Δ e) (D e) μ ρ V t B (phase e)) edges f

theorem unrestricted_coupled_edge_list_norm_le_positive
    (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ V g) (hμ : ∀ g p, 0 ≤ μ g p)
    (phase : ∀ e, UnrestrictedProductPhase n (Δ e) (D e) t B)
    (hphase : ∀ e s events, ‖phase e s events‖ ≤ 1)
    (edges : List E)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) :
    ‖unrestrictedCoupledEdgeList n Δ D μ ρ V t B phase edges f x‖ ≤
      (unrestrictedPositiveEdgeList n Δ D μ ρ V t B univ edges
        (complexNormEnvelope f) x).re := by
  apply finite_operator_list_norm_le_envelope
  · intro e u v huv y
    rw [← unrestricted_coupled_positive_cutoff_eq_product n (Δ e) (D e) μ ρ V t B u,
      ← unrestricted_coupled_positive_cutoff_eq_product n (Δ e) (D e) μ ρ V t B v]
    exact unrestricted_coupled_positive_cutoff_re_mono n (Δ e) (D e) μ ρ V t B
      hρ hV hμ u v huv y
  · intro e u y
    rw [← unrestricted_coupled_positive_cutoff_eq_product n (Δ e) (D e) μ ρ V t B]
    exact unrestricted_coupled_cutoff_norm_le_positive_re n (Δ e) (D e) μ ρ V t B
      hρ hV hμ (phase e) (hphase e) u y

/-- Only the initial input is symmetric. Each edge phase may couple all
groups, and none of the phased intermediate functions must be symmetric. -/
theorem unrestricted_coupled_edge_list_energy_le
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, t g ≤ T)
    (phase : ∀ e, UnrestrictedProductPhase n (Δ e) (D e) t B)
    (hphase : ∀ e s events, ‖phase e s events‖ ≤ 1)
    (edges : List E)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (unrestrictedCoupledEdgeList n Δ D μ ρ V t B phase edges f) ≤
    (unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G) ^ edges.length *
      finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  apply finiteWeightedEnergy_le_of_envelope_domination
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productMemoryWeight_nonneg μ (fun g => unrestrictedResidueWeight (μ g))
      hμ (fun g z => hμ g z.1)) f _
    (unrestrictedPositiveEdgeList n Δ D μ ρ V t B univ edges)
  · intro x
    exact (unrestricted_coupled_edge_list_norm_le_positive n Δ D μ ρ V t B hρ0.le
      (fun g => (hvmin.trans_le (hVlo g)).le) hμ phase hphase edges f x).trans
      (Complex.re_le_norm _)
  · simpa only [card_univ] using
      unrestricted_positive_edge_list_energy_le n Δ D μ ρ V t B univ hρ0 hρ1 hv
        hvmin hVlo hVhi hμ hmass T ht edges (complexNormEnvelope f)
        (complexNormEnvelope_memory_symmetric f hf)

end
end

section
open Finset Classical
abbrev UnrestrictedJointEvent {G : Type*} {P : G → Type*}
    (n : ∀ g, P g → ℕ) (Δ D : G → ℤ) (t : G → ℕ) (B : ℕ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) :=
  ∀ g, UnrestrictedBoundedEvent (n g) (Δ g) (D g) (t g) B (s g)

noncomputable def unrestrictedJointEventTarget {G : Type*} {P : G → Type*}
    (n : ∀ g, P g → ℕ) (Δ D : G → ℤ) (t : G → ℕ) (B : ℕ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B)
    (e : UnrestrictedJointEvent n Δ D t B s) :
    ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B :=
  fun g => unrestrictedBoundedEventTarget (n g) (Δ g) (D g) (t g) B (s g) (e g)

noncomputable def unrestrictedJointCutoffEventWeight {G : Type*} [Fintype G]
    {P : G → Type*} (n : ∀ g, P g → ℕ) (Δ D : G → ℤ)
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ) (t : G → ℕ) (B : ℕ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B)
    (e : UnrestrictedJointEvent n Δ D t B s) : ℝ :=
  if productTotalMemory s ≤ B ∧ productTotalMemory (unrestrictedJointEventTarget n Δ D t B s e) ≤ B
  then ∏ g, unrestrictedBoundedEventWeight (n g) (Δ g) (D g) (μ g) ρ (V g) (t g) B (s g) (e g)
  else 0

theorem unrestrictedJointCutoffEventWeight_nonneg {G : Type*} [Fintype G]
    {P : G → Type*} (n : ∀ g, P g → ℕ) (Δ D : G → ℤ)
    (μ : ∀ g, P g → ℝ) {ρ : ℝ} (V : G → ℝ)
    (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ V g) (hμ : ∀ g p, 0 ≤ μ g p)
    (t : G → ℕ) (B : ℕ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B)
    (e : UnrestrictedJointEvent n Δ D t B s) :
    0 ≤ unrestrictedJointCutoffEventWeight n Δ D μ ρ V t B s e := by
  unfold unrestrictedJointCutoffEventWeight
  split_ifs
  · exact prod_nonneg fun g _ => unrestrictedBoundedEventWeight_nonneg (n g) (Δ g) (D g)
      (μ g) hρ (hV g) (hμ g) (t g) B (s g) (e g)
  · exact le_rfl

theorem unrestricted_coupled_cutoff_eq_joint_event_sum
    {G : Type*} [Fintype G] {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) (Δ D : G → ℤ) (μ : ∀ g, P g → ℝ)
    (ρ : ℝ) (V : G → ℝ) (t : G → ℕ) (B : ℕ)
    (phase : UnrestrictedProductPhase n Δ D t B)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) :
    unrestrictedCoupledCutoffProductOperator n Δ D μ ρ V t B phase f s =
      ∑ e : UnrestrictedJointEvent n Δ D t B s,
        (unrestrictedJointCutoffEventWeight n Δ D μ ρ V t B s e : ℂ) * phase s e *
          f (unrestrictedJointEventTarget n Δ D t B s e) := by
  unfold unrestrictedCoupledCutoffProductOperator unrestrictedCoupledProductOperator
    finiteProductEventAction productMemoryCutoff
  by_cases hs : productTotalMemory s ≤ B
  · rw [if_pos hs]
    apply sum_congr rfl
    intro e _
    by_cases ht : productTotalMemory (unrestrictedJointEventTarget n Δ D t B s e) ≤ B
    · simp [unrestrictedJointCutoffEventWeight, hs, ht,
        show productTotalMemory (fun g => unrestrictedBoundedEventTarget (n g) (Δ g) (D g)
          (t g) B (s g) (e g)) ≤ B from ht]
      exact Or.inl rfl
    · simp [unrestrictedJointCutoffEventWeight, hs, ht,
        show ¬productTotalMemory (fun g => unrestrictedBoundedEventTarget (n g) (Δ g) (D g)
          (t g) B (s g) (e g)) ≤ B from ht]
  · simp [hs, unrestrictedJointCutoffEventWeight]
end

section
open scoped BigOperators
theorem reciprocal_character_profile_antitone {a x Q : ℝ}
    (ha : 2 ≤ a) (hax : a ≤ x) (hQ : 1 ≤ Q) :
    x ^ (-(1 : ℝ) / 32) * (1 + Real.log Q / Real.log x) ≤
      a ^ (-(1 : ℝ) / 32) * (1 + Real.log Q / Real.log a) := by
  have ha0 : 0 < a := by linarith
  have hla : 0 < Real.log a := Real.log_pos (by linarith)
  have hlog : Real.log a ≤ Real.log x := Real.log_le_log ha0 hax
  have hlx : 0 < Real.log x := hla.trans_le hlog
  have hQlog : 0 ≤ Real.log Q := Real.log_nonneg hQ
  apply mul_le_mul
  · exact Real.rpow_le_rpow_of_nonpos ha0 hax (by norm_num)
  · have h := div_le_div_of_nonneg_left hQlog hla hlog
    linarith
  · positivity
  · positivity

theorem primeBand_eq_empty_of_upper_le {a b : ℝ} (hba : b ≤ a) :
    primeBand a b = ∅ := by
  unfold primeBand
  rw [Finset.Ioc_eq_empty_of_le (Nat.floor_le_floor hba), Finset.filter_empty]

theorem primeBand_product_interval {a b c U V : ℝ}
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 < c) (_hU : 0 ≤ U) (hV : 0 ≤ V) :
    (primeBand a b).filter (fun p : ℕ => U < c * (p : ℝ) ∧ c * (p : ℝ) ≤ V) =
      primeBand (max a (U / c)) (min b (V / c)) := by
  classical
  ext p
  have hmax : 0 ≤ max a (U / c) := ha.trans (le_max_left _ _)
  have hmin : 0 ≤ min b (V / c) := le_min hb (div_nonneg hV hc.le)
  rw [Finset.mem_filter, mem_primeBand_iff ha hb, mem_primeBand_iff hmax hmin]
  simp only [max_lt_iff, le_min_iff, div_lt_iff₀ hc, le_div_iff₀ hc]
  constructor
  · rintro ⟨⟨hp, hap, hpb⟩, hUp, hpV⟩
    exact ⟨hp, ⟨hap, by simpa only [mul_comm] using hUp⟩,
      ⟨hpb, by simpa only [mul_comm] using hpV⟩⟩
  · rintro ⟨hp, ⟨hap, hUp⟩, hpb, hpV⟩
    exact ⟨⟨hp, hap, hpb⟩, by simpa only [mul_comm] using hUp,
      by simpa only [mul_comm] using hpV⟩

theorem reciprocal_prime_band_product_interval_bound
    (hZ : PrimitiveZeroFreeHalfPlane) :
    ∃ C : ℝ, 0 < C ∧ ∀ (q : ℕ), 0 < q →
      ∀ χ : DirichletCharacter ℂ q, χ ≠ 1 →
      ∀ a b c U V : ℝ, 2 ≤ a → 0 ≤ b → 0 < c → 0 ≤ U → 0 ≤ V →
        ‖∑ p ∈ (primeBand a b).filter
            (fun p : ℕ => U < c * (p : ℝ) ∧ c * (p : ℝ) ≤ V),
          (1 / (p : ℝ)) • χ (p : ZMod q)‖ ≤
            C * a ^ (-(1 : ℝ) / 32) * (1 + Real.log q / Real.log a) := by
  obtain ⟨C, hC, hbound⟩ := reciprocal_prime_interval_bound_of_zero_free hZ
  refine ⟨C, hC, ?_⟩
  intro q hq χ hχ a b c U V ha hb hc hU hV
  rw [primeBand_product_interval (by linarith : 0 ≤ a) hb hc hU hV]
  let x := max a (U / c)
  let y := min b (V / c)
  have hax : a ≤ x := le_max_left _ _
  have hx : 2 ≤ x := ha.trans hax
  have hqR : (1 : ℝ) ≤ q := by exact_mod_cast hq
  by_cases hxy : x ≤ y
  · have h := hbound q hq χ hχ x y hx hxy
    change ‖∑ p ∈ primeBand x y, (1 / (p : ℝ)) • χ (p : ZMod q)‖ ≤ _ at h
    apply h.trans
    simpa only [mul_assoc] using
      mul_le_mul_of_nonneg_left (reciprocal_character_profile_antitone ha hax hqR) hC.le
  · change ‖∑ p ∈ primeBand x y, (1 / (p : ℝ)) • χ (p : ZMod q)‖ ≤ _
    rw [primeBand_eq_empty_of_upper_le (le_of_not_ge hxy), Finset.sum_empty, norm_zero]
    have hlq : 0 ≤ Real.log (q : ℝ) := Real.log_nonneg hqR
    have hla : 0 < Real.log a := Real.log_pos (by linarith)
    positivity
end

section
open Finset
open scoped Classical
/-- Fixed finite indexing of the actual unshared slots, independent of labels. -/
noncomputable def physicalGroupUnsharedIndex {J ell : ℕ} (C : Finset (Fin J)) :
    Fin (ell + C.card) ≃ ↥(physicalUnsharedSlots (ell := ell) C) :=
  (Fintype.equivFinOfCardEq (by
    simpa only [Fintype.card_coe] using physical_unshared_slots_card (ell := ell) C)).symm

/-- Read a physical list at its indexed unshared slots. -/
noncomputable def physicalGroupUnsharedEmbedding {G : Type*} {P : G → Finset ℕ}
    {J ell : ℕ} (C : G → Finset (Fin J)) (L : PhysicalMarkLists P J ell) (g : G) :
    Fin (ell + (C g).card) ↪ ↥(P g) where
  toFun j := L g (physicalGroupUnsharedIndex (ell := ell) (C g) j).val
  inj' := by
    intro j k h
    apply (physicalGroupUnsharedIndex (ell := ell) (C g)).injective
    exact Subtype.ext ((L g).injective h)

theorem physical_group_unshared_embedding_mem {G : Type*} {P : G → Finset ℕ}
    {J ell : ℕ} (C : G → Finset (Fin J)) (L : PhysicalMarkLists P J ell)
    (g : G) (p : P g) :
    p ∈ univ.image (physicalGroupUnsharedEmbedding C L g) ↔
      p.val ∈ physicalGroupMarks L g ∧ p.val ∉ physicalGroupSharedPrimes C L g := by
  constructor
  · intro hp
    obtain ⟨j, _, rfl⟩ := mem_image.mp hp
    let s := physicalGroupUnsharedIndex (ell := ell) (C g) j
    refine ⟨(mem_physical_group_marks L g _).mpr ⟨s.val, rfl⟩, ?_⟩
    intro hs
    obtain ⟨t, ht, he⟩ := (mem_physical_group_shared_primes C L g _).mp hs
    have hts : t = s.val := (L g).injective (Subtype.ext he)
    have hns : s.val ∉ physicalSharedSlots (C g) := by
      simpa only [physicalUnsharedSlots, mem_compl] using s.property
    exact hns (hts ▸ ht)
  · rintro ⟨hp, hn⟩
    obtain ⟨s, hs⟩ := (mem_physical_group_marks L g _).mp hp
    have hns : s ∈ physicalUnsharedSlots (ell := ell) (C g) := by
      rw [physicalUnsharedSlots, mem_compl]
      intro h
      exact hn ((mem_physical_group_shared_primes C L g _).mpr ⟨s, h, hs⟩)
    refine mem_image.mpr ⟨(physicalGroupUnsharedIndex (ell := ell) (C g)).symm
      ⟨s, hns⟩, mem_univ _, ?_⟩
    change L g ((physicalGroupUnsharedIndex (ell := ell) (C g))
      ((physicalGroupUnsharedIndex (ell := ell) (C g)).symm ⟨s, hns⟩)).val = p
    simpa only [Equiv.apply_symm_apply] using (Subtype.ext hs : L g s = p)

theorem physical_group_shared_primes_of_compatible {G : Type*} {P : G → Finset ℕ}
    {J ell : ℕ} (C : G → Finset (Fin J)) (L R : PhysicalMarkLists P J ell)
    (hshared : physicalSharedCompatible C L R) (g : G) :
    physicalGroupSharedPrimes C L g = physicalGroupSharedPrimes C R g := by
  ext p
  simp only [mem_physical_group_shared_primes]
  constructor
  · rintro ⟨s, hs, hp⟩
    obtain ⟨j, hj, rfl⟩ := (physical_mem_shared_slots_iff (C g) s).mp hs
    exact ⟨Sum.inl j, (physical_mem_shared_slots_iff (C g) _).mpr ⟨j, hj, rfl⟩,
      (congrArg Subtype.val (hshared g j hj)).symm.trans hp⟩
  · rintro ⟨s, hs, hp⟩
    obtain ⟨j, hj, rfl⟩ := (physical_mem_shared_slots_iff (C g) s).mp hs
    exact ⟨Sum.inl j, (physical_mem_shared_slots_iff (C g) _).mpr ⟨j, hj, rfl⟩,
      (congrArg Subtype.val (hshared g j hj)).trans hp⟩

/-- If the only common labels are the shared labels, the actual unshared
source slots enumerate exactly the departing activity. -/
theorem physical_group_phase_source_image {G : Type*} {P : G → Finset ℕ}
    {J ell : ℕ} (C : G → Finset (Fin J)) (L R : PhysicalMarkLists P J ell) (g : G)
    (hinter : physicalGroupMarks L g ∩ physicalGroupMarks R g =
      physicalGroupSharedPrimes C L g) :
    univ.image (physicalGroupUnsharedEmbedding C L g) =
      ghostPhaseActivitySupport (physicalGroupPhaseActivity L g) \
        ghostPhaseActivitySupport (physicalGroupPhaseActivity R g) := by
  ext p
  rw [physical_group_unshared_embedding_mem, mem_sdiff,
    physical_group_phase_activity_support_mem, physical_group_phase_activity_support_mem,
    ← hinter, mem_inter]
  tauto

/-- The actual target unshared slots enumerate exactly the newly active labels. -/
theorem physical_group_phase_target_image {G : Type*} {P : G → Finset ℕ}
    {J ell : ℕ} (C : G → Finset (Fin J)) (L R : PhysicalMarkLists P J ell)
    (hshared : physicalSharedCompatible C L R) (g : G)
    (hinter : physicalGroupMarks L g ∩ physicalGroupMarks R g =
      physicalGroupSharedPrimes C L g) :
    univ.image (physicalGroupUnsharedEmbedding C R g) =
      ghostPhaseNewRunSet (physicalGroupPhaseActivity R g) (physicalGroupPhaseActivity L g) := by
  have hi : physicalGroupMarks R g ∩ physicalGroupMarks L g =
      physicalGroupSharedPrimes C R g := by
    rw [inter_comm, hinter, physical_group_shared_primes_of_compatible C L R hshared g]
  rw [physical_group_phase_source_image C R L g hi]
  ext p
  simp only [ghostPhaseActivitySupport, ghostPhaseNewRunSet, mem_sdiff, mem_filter,
    mem_univ, true_and, Bool.and_eq_true, Bool.not_eq_true']
  cases physicalGroupPhaseActivity L g p <;> simp

/-- Actual physical admissibility and the short-step nondivisibility condition
supply both embeddings' image equations. -/
theorem physical_group_phase_images_of_admissible {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) {x y : PhysicalState P J ell}
    (hadm : physicalAdmissible C aux k x y)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (g : G)
    (hk : ∀ s, ¬ ((x.2.val g s).val : ℤ) ∣ k) :
    univ.image (physicalGroupUnsharedEmbedding C x.2.val g) =
      ghostPhaseActivitySupport (physicalGroupPhaseActivity x.2.val g) \
        ghostPhaseActivitySupport (physicalGroupPhaseActivity y.2.val g) ∧
    univ.image (physicalGroupUnsharedEmbedding C y.2.val g) =
      ghostPhaseNewRunSet (physicalGroupPhaseActivity y.2.val g)
        (physicalGroupPhaseActivity x.2.val g) := by
  have hi := physical_group_marks_inter_eq_shared C aux k hadm hP hdis g hk
  exact ⟨physical_group_phase_source_image C x.2.val y.2.val g hi,
    physical_group_phase_target_image C x.2.val y.2.val hadm.1 g hi⟩

/-- The same construction applies to bare physical lists once their common
marks satisfy the actual step divisibility condition. -/
theorem physical_group_phase_images_of_bare {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) (L R : PhysicalMarkLists P J ell)
    (hlist : physicalListAdmissible C aux L R)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hcompat : ∀ g s t, (L g s).val = (R g t).val →
      ((L g s).val : ℤ) ∣ k * (physicalD C L aux : ℤ))
    (g : G) (hk : ∀ s, ¬ ((L g s).val : ℤ) ∣ k) :
    univ.image (physicalGroupUnsharedEmbedding C L g) =
      ghostPhaseActivitySupport (physicalGroupPhaseActivity L g) \
        ghostPhaseActivitySupport (physicalGroupPhaseActivity R g) ∧
    univ.image (physicalGroupUnsharedEmbedding C R g) =
      ghostPhaseNewRunSet (physicalGroupPhaseActivity R g) (physicalGroupPhaseActivity L g) := by
  have hi := physical_bare_group_marks_inter_eq_shared C aux k L R hlist hP hdis hcompat g hk
  exact ⟨physical_group_phase_source_image C L R g hi,
    physical_group_phase_target_image C L R hlist.1 g hi⟩
end

section

def globalBirthFiniteIndex (n i : ℕ) : Fin (n + 1) :=
  ⟨min i n, lt_of_le_of_lt (min_le_right _ _) (Nat.lt_succ_self _)⟩

theorem global_birth_finite_index_at {n : ℕ} (j : Fin (n + 1)) :
    globalBirthFiniteIndex n j.val = j := by
  apply Fin.ext
  exact min_eq_left (Nat.le_of_lt_succ j.isLt)

theorem global_birth_finite_index_tail (n i : ℕ) (hi : n ≤ i) :
    globalBirthFiniteIndex n i = Fin.last n := by
  apply Fin.ext
  exact min_eq_right hi

def globalBirthFiniteActivity {P : Type*} {n : ℕ}
    (a : Fin (n + 1) → P → Bool) (i : ℕ) : P → Bool :=
  a (globalBirthFiniteIndex n i)

theorem global_birth_finite_activity_at {P : Type*} {n : ℕ}
    (a : Fin (n + 1) → P → Bool) (j : Fin (n + 1)) :
    globalBirthFiniteActivity a j.val = a j := by
  rw [globalBirthFiniteActivity, global_birth_finite_index_at]

theorem global_birth_finite_activity_tail {P : Type*} {n : ℕ}
    (a : Fin (n + 1) → P → Bool) (i : ℕ) (hi : n ≤ i) :
    globalBirthFiniteActivity a i = a (Fin.last n) := by
  rw [globalBirthFiniteActivity, global_birth_finite_index_tail n i hi]

section Steps
variable {P : Type*} [Fintype P] [DecidableEq P]
  {R : P → Type*} [∀ p, AddGroup (R p)] {n : ℕ}
  (a : Fin (n + 1) → P → Bool)
  (visit : ∀ j, GlobalBirthRawStep (R := R) (a j) (a j))
  (edge : ∀ j : Fin n, GlobalBirthRawStep (R := R) (a j.castSucc) (a j.succ))

def globalBirthFiniteVisit (i : ℕ) :
    GlobalBirthRawStep (R := R) (globalBirthFiniteActivity a i)
      (globalBirthFiniteActivity a i) :=
  visit (globalBirthFiniteIndex n i)

def globalBirthFiniteEdge (i : ℕ) :
    GlobalBirthRawStep (R := R) (globalBirthFiniteActivity a i)
      (globalBirthFiniteActivity a (i + 1)) := by
  by_cases hi : i < n
  · exact globalBirthReindexStep
      (global_birth_finite_activity_at a (Fin.castSucc ⟨i, hi⟩)).symm
      (global_birth_finite_activity_at a (Fin.succ ⟨i, hi⟩)).symm (edge ⟨i, hi⟩)
  · exact globalBirthReindexStep
      (global_birth_finite_activity_tail a i (by omega)).symm
      (global_birth_finite_activity_tail a (i + 1) (by omega)).symm
      (visit (Fin.last n))

noncomputable def globalBirthFiniteAlternatingStep (i : ℕ) :
    GlobalBirthRawStep (R := R) (globalBirthFiniteActivity a (i / 2))
      (globalBirthFiniteActivity a ((i + 1) / 2)) :=
  globalBirthAlternatingStep (globalBirthFiniteActivity a)
    (globalBirthFiniteVisit a visit) (globalBirthFiniteEdge a visit edge) i

variable [∀ p, DecidableEq (R p)]

theorem global_birth_finite_visit_row (j : Fin (n + 1))
    (G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p)) :
    globalBirthRawStepRow (globalBirthFiniteVisit a visit j.val) G H q =
      globalBirthRawStepRow (visit j) G H q := by
  unfold globalBirthFiniteVisit
  exact congrArg (fun k => globalBirthRawStepRow (visit k) G H q)
    (global_birth_finite_index_at j)

theorem global_birth_finite_edge_row (j : Fin n)
    (G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p)) :
    globalBirthRawStepRow (globalBirthFiniteEdge a visit edge j.val) G H q =
      globalBirthRawStepRow (edge j) G H q := by
  simp only [globalBirthFiniteEdge, dif_pos j.isLt, global_birth_reindex_step_row]

theorem global_birth_finite_alternating_row_even (j : Fin (n + 1))
    (G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p)) :
    globalBirthRawStepRow (globalBirthFiniteAlternatingStep a visit edge (2 * j.val)) G H q =
      globalBirthRawStepRow (visit j) G H q := by
  rw [globalBirthFiniteAlternatingStep, global_birth_alternating_step_row_even,
    global_birth_finite_visit_row]

theorem global_birth_finite_alternating_row_odd (j : Fin n)
    (G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p)) :
    globalBirthRawStepRow (globalBirthFiniteAlternatingStep a visit edge (2 * j.val + 1)) G H q =
      globalBirthRawStepRow (edge j) G H q := by
  rw [globalBirthFiniteAlternatingStep, global_birth_alternating_step_row_odd,
    global_birth_finite_edge_row]

variable [∀ p, Fintype (R p)]

theorem global_birth_finite_visit_kernel (j : Fin (n + 1))
    (z w : (p : P) → GhostPhaseState (R p)) :
    globalBirthRawStepKernel (globalBirthFiniteVisit a visit j.val) z w =
      globalBirthRawStepKernel (visit j) z w := by
  unfold globalBirthFiniteVisit
  exact congrArg (fun k => globalBirthRawStepKernel (visit k) z w)
    (global_birth_finite_index_at j)

theorem global_birth_finite_edge_kernel (j : Fin n)
    (z w : (p : P) → GhostPhaseState (R p)) :
    globalBirthRawStepKernel (globalBirthFiniteEdge a visit edge j.val) z w =
      globalBirthRawStepKernel (edge j) z w := by
  simp only [globalBirthFiniteEdge, dif_pos j.isLt, global_birth_reindex_step_kernel]

theorem global_birth_finite_alternating_kernel_even (j : Fin (n + 1))
    (z w : (p : P) → GhostPhaseState (R p)) :
    globalBirthRawStepKernel (globalBirthFiniteAlternatingStep a visit edge (2 * j.val)) z w =
      globalBirthRawStepKernel (visit j) z w := by
  rw [globalBirthFiniteAlternatingStep, global_birth_alternating_step_kernel_even,
    global_birth_finite_visit_kernel]

theorem global_birth_finite_alternating_kernel_odd (j : Fin n)
    (z w : (p : P) → GhostPhaseState (R p)) :
    globalBirthRawStepKernel (globalBirthFiniteAlternatingStep a visit edge (2 * j.val + 1)) z w =
      globalBirthRawStepKernel (edge j) z w := by
  rw [globalBirthFiniteAlternatingStep, global_birth_alternating_step_kernel_odd,
    global_birth_finite_edge_kernel]

end Steps
