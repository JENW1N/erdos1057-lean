section Reindex
variable {G H : Type*} (e : G ≃ H) {P : G → Finset ℕ} {J ell : ℕ}
  (C : G → Finset (Fin J))
  (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)

noncomputable def physicalGroupReindexedCoefficient
    (L R : PhysicalMarkLists (fun h => P (e.symm h)) J ell)
    (a : PhysicalAuxLabels (fun h => P (e.symm h)) (fun h => C (e.symm h))) : ℂ :=
  K ((physicalMarkGroupReindex e P J ell).symm L) ((physicalMarkGroupReindex e P J ell).symm R)
    ((physicalAuxGroupReindex e P J C).symm a)

theorem physical_group_reindexed_coefficient_apply (a : PhysicalAuxLabels P C)
    (L R : PhysicalMarkLists P J ell) :
    physicalGroupReindexedCoefficient e C K (physicalMarkGroupReindex e P J ell L)
      (physicalMarkGroupReindex e P J ell R) (physicalAuxGroupReindex e P J C a) = K L R a := by
  simp only [physicalGroupReindexedCoefficient, Equiv.symm_apply_apply]

variable [Fintype G] [Fintype H]

theorem physical_bare_pattern_group_reindex (V : G → ℝ) (ζ : ℝ)
    (a : PhysicalAuxLabels P C) (L R : PhysicalMarkLists P J ell) :
    physicalBarePatternScalar (fun h => V (e.symm h)) (fun h => C (e.symm h)) ζ
      (physicalGroupReindexedCoefficient e C K) (physicalAuxGroupReindex e P J C a)
      (physicalMarkGroupReindex e P J ell L) (physicalMarkGroupReindex e P J ell R) =
      physicalBarePatternScalar V C ζ K a L R := by
  simp only [physicalBarePatternScalar, physical_list_admissible_group_reindex,
    physical_aux_mass_group_reindex, physical_completion_mass_group_reindex,
    physical_D_group_reindex, physical_group_reindexed_coefficient_apply]

theorem physical_bare_pattern_group_reindexed_row (V : G → ℝ) (ζ : ℝ)
    (a : PhysicalAuxLabels P C) (L : PhysicalMarkLists P J ell)
    (F : PhysicalMarkLists P J ell → ℂ) :
    (∑ R : PhysicalMarkLists (fun h => P (e.symm h)) J ell,
      physicalBarePatternScalar (fun h => V (e.symm h)) (fun h => C (e.symm h)) ζ
        (physicalGroupReindexedCoefficient e C K) (physicalAuxGroupReindex e P J C a)
        (physicalMarkGroupReindex e P J ell L) R * F ((physicalMarkGroupReindex e P J ell).symm R)) =
      ∑ R : PhysicalMarkLists P J ell, physicalBarePatternScalar V C ζ K a L R * F R := by
  rw [← Equiv.sum_comp (physicalMarkGroupReindex e P J ell)]
  simp only [physical_bare_pattern_group_reindex, Equiv.symm_apply_apply]

end Reindex
