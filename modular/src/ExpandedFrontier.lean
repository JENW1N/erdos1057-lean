      cleanFullMemoryCutoff (cleanFullMemoryActiveMap (cleanFullMemoryPatternDampedAction
        V b C ζ θ ρ k (fun i => cleanInitialBirthKernel F (C i) (K i)) d
        (cleanFullMemoryActiveMap (cleanFullMemoryCutoff f)))) := by
  rw [clean_full_memory_initial_pattern_event_action]
  exact clean_full_memory_projected_event_action V b C ζ θ ρ k D
    (fun i => cleanInitialBirthKernel F (C i) (K i)) d f hf

