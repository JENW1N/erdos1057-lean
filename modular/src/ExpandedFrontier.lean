/- A literal original endpoint correlation hypothesis controls the actual cross integral. -/

open Finset MeasureTheory
open scoped ComplexConjugate

namespace Bounty

noncomputable def candidateOriginalHarmonicCorrelation
    (c L q : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm
      (candidateRoughSlot c L r jStar hr hj)) = false)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (σ : ℝ)
    (marks : ℕ → ℕ) (Z : ℝ) (k : ℤ) (Zs : Finset ℕ)
    (α : ℕ → ℂ) (ρ : ℝ) (χ : DirichletCharacter ℂ (2*k.natAbs))
    (ξ : EuclideanSpace ℝ (Fin 3)) : ℂ :=
  let P := (candidatePIndices c L).biUnion (candidatePBand (c*L))
  let W : ℕ → ℝ := fun n => markedDivisorWeight (candidatePIndices c L)
    (candidatePBand (c*L)) q (fun j => ∑ p ∈ candidatePBand (c*L) j, 1/(p : ℝ)) marks (n : ℤ)
  let cr := candidateResidualPrimeCoefficient c L r jStar hr hj take hkeep twist
  let F₀ := invariantTripleEndpoint P
    (fun m => α m * χ (m : ZMod (2*k.natAbs)) * typeIIPhase (ρ-2*Real.pi*ξ 1) m)
    (fun p => if p ∈ candidateRoughBand c L jStar then typeIIPhase (-σ) p else 0)
    (fun s => conj (cr s))
  let G₀ := invariantTripleEndpoint P
    (fun m => α m * χ (m : ZMod (2*k.natAbs)) * typeIIPhase (2*Real.pi*ξ 0+ρ) m)
    (fun p => if p ∈ candidateRoughBand c L jStar then typeIIPhase (-σ) p else 0)
    (fun s => conj (cr s))
  ∑ z ∈ Zs, ((typeIIHarmonicDyadic ((z : ℝ)/Z)/(z : ℝ) : ℝ) : ℂ) *
    (typeIIPhase (ρ+2*Real.pi*ξ 2) z * typeIIPhase (-ρ) ((z : ℤ)+k).toNat *
      conj (F₀ z) * G₀ ((z : ℤ)+k).toNat * (W z : ℂ) * (W ((z : ℤ)+k).toNat : ℂ))

theorem candidate_cross_integral_le_of_original_harmonic_bound
    (c L q : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm
      (candidateRoughSlot c L r jStar hr hj)) = false)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (σ : ℝ)
    (hphase : ∀ p ∈ candidateRoughBand c L jStar,
      twist (candidateRoughSlot c L r jStar hr hj) p = typeIIPhase σ p)
    (marks : ℕ → ℕ) (A U V E Z : ℝ) (k : ℤ) (M H Zs : Finset ℕ)
    (α : ℕ → ℂ) (ρ : ℝ) (χ : DirichletCharacter ℂ (2*k.natAbs))
    (T : Set (EuclideanSpace ℝ (Fin 3))) (hT : MeasurableSet T) {R : ℝ}
    (hU : 0 < U) (hZ : 0 < Z) (hR : 0 ≤ R)
    (hM : ∀ m ∈ M, 0 < m) (hH : ∀ h ∈ H, 0 < h) (hk : k ≠ 0)
    (hfree : ∀ m ∈ M, Disjoint m.primeFactors
      ((candidatePIndices c L).biUnion (candidatePBand (c*L))))
    (hHz : ∀ z ∈ typeIIActiveCrossZ Z k Zs, ∀ m ∈ M, m ∣ z → z/m ∈ H)
    (hHw : ∀ z ∈ typeIIActiveCrossZ Z k Zs, ∀ m ∈ M,
      m ∣ ((z : ℤ)+k).toNat → ((z : ℤ)+k).toNat/m ∈ H)
    (hα : ∀ m, m ∉ M → α m=0)
    (hcorrelation : ∀ ξ ∈ T,
      ‖candidateOriginalHarmonicCorrelation c L q r jStar hr hj take hkeep twist σ marks
        Z k (typeIIActiveCrossZ Z k Zs) α ρ χ ξ‖ ≤ R) :
    let P := (candidatePIndices c L).biUnion (candidatePBand (c*L))
    let W : ℕ → ℝ := fun n => markedDivisorWeight (candidatePIndices c L)
      (candidatePBand (c*L)) q (fun j => ∑ p ∈ candidatePBand (c*L) j, 1/(p : ℝ)) marks (n : ℤ)
    ‖∫ ξ in T, typeIICrossCharacterFourierIntegrand A L U V E Z k M H Zs typeIISmoothDyadic α
      (typeIISeparatedH W
        (fun h => candidateRemainingComplexCoefficient c L r jStar take twist (primePoolFreePart P h)) ρ) χ ξ‖ ≤
      Z * R * (∫ ξ : EuclideanSpace ℝ (Fin 3),
        ‖typeIIPulledFourier A (L^88) (U/(2*(k : ℝ)*E))
          (Z/((k : ℝ)*U*V)) (1/(U*V)) ξ‖) := by
  classical
  dsimp only
  apply typeII_cross_integral_le_of_active_harmonic_bound A L U V E Z k M H Zs
    α _ _ ρ χ T hT hU hZ hR hM hH hk
  intro ξ hξ
  have hpos : ∀ z ∈ typeIIActiveCrossZ Z k Zs, 0 < z ∧ 0 < (z : ℤ)+k := by
    intro z hz
    exact ⟨(mem_filter.mp hz).2.1, (mem_filter.mp hz).2.2.1⟩
  rw [candidate_harmonic_cross_pairs_eq_original_endpoints c L q r jStar hr hj take hkeep
    twist σ hphase marks Z k M H (typeIIActiveCrossZ Z k Zs) α ρ χ hM hH hpos hfree hHz hHw hα ξ]
  exact hcorrelation ξ hξ


end Bounty
