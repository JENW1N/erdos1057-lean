section
open scoped BigOperators Classical
noncomputable def finiteKernelTestTransform {X : Type*} [Fintype X]
    (μ : X → ℝ) (K : X → X → ℂ) (f : X → ℂ) (d : X) : ℂ :=
  ∑ x, (μ x : ℂ) * K d x * f x

theorem finite_sum_four_swap {A B C D M : Type*}
    [Fintype A] [Fintype B] [Fintype C] [Fintype D] [AddCommMonoid M]
    (F : A → B → C → D → M) :
    (∑ a, ∑ b, ∑ c, ∑ d, F a b c d) = ∑ c, ∑ d, ∑ a, ∑ b, F a b c d := by
  calc
    _ = ∑ ab : A × B, ∑ cd : C × D, F ab.1 ab.2 cd.1 cd.2 := by
      simp only [Fintype.sum_prod_type]
    _ = ∑ cd : C × D, ∑ ab : A × B, F ab.1 ab.2 cd.1 cd.2 := Finset.sum_comm
    _ = _ := by simp only [Fintype.sum_prod_type]

theorem finite_two_kernel_pairing_fubini {X Y : Type*} [Fintype X] [Fintype Y]
    (μ : X → ℝ) (ν : Y → ℝ) (KA : X → X → ℂ) (KB : Y → Y → ℂ)
    (f : X → ℂ) (g : Y → ℂ) (F : X → Y → ℂ) :
    (∑ x, ∑ y, ((μ x : ℂ) * f x) * ((ν y : ℂ) * g y) *
      finiteTwoKernelAverage μ ν KA KB x y F) =
    ∑ d, ∑ e, ((μ d : ℂ) * finiteKernelTestTransform μ KA f d) *
      ((ν e : ℂ) * finiteKernelTestTransform ν KB g e) * F d e := by
  simp only [finiteTwoKernelAverage, finiteKernelTestTransform, Finset.mul_sum, Finset.sum_mul]
  rw [finite_sum_four_swap]
  apply Finset.sum_congr rfl
  intro d _
  apply Finset.sum_congr rfl
  intro e _
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro x _
  apply Finset.sum_congr rfl
  intro y _
  ring

theorem finite_two_kernel_pairing_modulated {X Y : Type*} [Fintype X] [Fintype Y]
    (μ : X → ℝ) (ν : Y → ℝ) (KA : X → X → ℂ) (KB : Y → Y → ℂ)
    (f χ : X → ℂ) (g ψ : Y → ℂ) (F : X → Y → ℂ) :
    (∑ x, ∑ y, ((μ x : ℂ) * f x) * ((ν y : ℂ) * g y) *
      finiteTwoKernelAverage μ ν KA KB x y (fun d e => χ d * ψ e * F d e)) =
    ∑ d, ∑ e, ((μ d : ℂ) * (χ d * finiteKernelTestTransform μ KA f d)) *
      ((ν e : ℂ) * (ψ e * finiteKernelTestTransform ν KB g e)) * F d e := by
  rw [finite_two_kernel_pairing_fubini]
  apply Finset.sum_congr rfl
  intro d _
  apply Finset.sum_congr rfl
  intro e _
  ring

theorem finite_kernel_test_transform_conjugate {X : Type*} [Fintype X]
    (μ : X → ℝ) (K : X → X → ℂ) (f : X → ℂ) (d : X) :
    star (finiteKernelTestTransform μ (fun d x => star (K d x)) f d) =
      finiteKernelTestTransform μ K (fun x => star (f x)) d := by
  simp only [finiteKernelTestTransform, map_sum, map_mul, Complex.star_def,
    Complex.conj_ofReal, starRingEnd_self_apply]

theorem finite_two_kernel_sesquilinear_fubini {X Y : Type*} [Fintype X] [Fintype Y]
    (μ : X → ℝ) (ν : Y → ℝ) (KA : X → X → ℂ) (KB : Y → Y → ℂ)
    (f : X → ℂ) (g : Y → ℂ) (F : X → Y → ℂ) :
    (∑ x, ∑ y, ((μ x : ℂ) * star (f x)) * ((ν y : ℂ) * g y) *
      finiteTwoKernelAverage μ ν KA KB x y F) =
    ∑ d, ∑ e,
      ((μ d : ℂ) * star (finiteKernelTestTransform μ (fun d x => star (KA d x)) f d)) *
      ((ν e : ℂ) * finiteKernelTestTransform ν KB g e) * F d e := by
  simp only [finite_kernel_test_transform_conjugate]
  exact finite_two_kernel_pairing_fubini μ ν KA KB (fun x => star (f x)) g F
end

