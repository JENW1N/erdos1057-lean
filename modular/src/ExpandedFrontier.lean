section

/- Small-conductor character cancellation for the actual candidate coefficient. -/

open Finset Filter

namespace Bounty

theorem eventually_candidate_character_cancellation
    (hZ : PrimitiveZeroFreeHalfPlane) {c : ℝ} (hc : 0 < c) (B : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ), 0 ≤ q →
      ∀ (r jStar : ℕ) (hr : 0 < r), 0 < jStar →
      ∀ (f : ℕ), 0 < f → (f : ℝ) ≤ Real.exp L →
      ∀ χ : DirichletCharacter ℂ f, χ ≠ 1 →
      ∀ (m : ℕ), m ≠ 0 → (m : ℝ) ≤ Real.exp L →
        ‖∑ u ∈ (arithmeticProductWindow 1 (Real.exp L)).filter (fun u => u.Coprime m),
          (candidateCoefficient c L q r jStar u : ℂ) * χ (u : ZMod f)‖ ≤
          (16*Real.exp L) * L^(-B) * candidateOneMarkedHarmonicMass c L q *
            candidateQRestHarmonicMass c L r jStar hr := by
  filter_upwards [eventually_candidate_character_coprime_convolution hc,
    eventually_candidate_Q_character_cancellation hZ hc B,
    eventually_ge_atTop (0 : ℝ)] with L hconv hQ hL
  intro q hq r jStar hr hj f hf hfL χ hχ m hm hmL
  let R : ℝ := candidateQRestHarmonicMass c L r jStar hr
  let C : ℝ := (16*Real.exp L) * L^(-B) * R
  have hR : 0 ≤ R := candidate_Q_rest_harmonic_nonneg c L r jStar hr
  have hC : 0 ≤ C := by dsimp only [C]; positivity
  have htest := hconv q r jStar f m χ (fun _ => 1)
  simp only [mul_one] at htest
  rw [htest]
  calc
    _ ≤ ∑ a ∈ (candidateSmallPSet c L (16*Real.exp L + 1)).filter (fun a => a.Coprime m),
        ‖(candidatePWeight c L q a : ℂ) * χ (a : ZMod f) *
          ∑ n ∈ (arithmeticProductWindow a (Real.exp L)).filter (fun n => n.Coprime m),
            (candidateQWeight c L r jStar n : ℂ) * χ (n : ZMod f)‖ := norm_sum_le _ _
    _ ≤ ∑ a ∈ (candidateSmallPSet c L (16*Real.exp L + 1)).filter (fun a => a.Coprime m),
        (candidatePWeight c L q a / (a : ℝ)) * C := by
      apply sum_le_sum
      intro a ha
      have hWa := candidate_P_weight_nonneg c L hq a
      have ha0 : a ≠ 0 := candidate_small_P_set_nonzero (mem_filter.mp ha).1
      have hi := hQ f hf hfL χ hχ m hm hmL r jStar hr hj a ha0
      rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_of_nonneg hWa]
      calc
        _ ≤ candidatePWeight c L q a *
            ‖∑ n ∈ (arithmeticProductWindow a (Real.exp L)).filter (fun n => n.Coprime m),
              (candidateQWeight c L r jStar n : ℂ) * χ (n : ZMod f)‖ := by
          apply mul_le_mul_of_nonneg_right _ (norm_nonneg _)
          exact mul_le_of_le_one_right hWa (χ.norm_le_one _)
        _ ≤ candidatePWeight c L q a *
            (((16*Real.exp L)/(a : ℝ)) * L^(-B) * R) :=
          mul_le_mul_of_nonneg_left hi hWa
        _ = _ := by dsimp only [C]; ring
    _ ≤ ∑ a ∈ candidateSmallPSet c L (16*Real.exp L + 1),
        (candidatePWeight c L q a / (a : ℝ)) * C := by
      apply sum_le_sum_of_subset_of_nonneg (filter_subset _ _)
      intro a _ _
      exact mul_nonneg (div_nonneg (candidate_P_weight_nonneg c L hq a) (Nat.cast_nonneg a)) hC
    _ = (∑ a ∈ candidateSmallPSet c L (16*Real.exp L + 1),
        candidatePWeight c L q a / (a : ℝ)) * C := (sum_mul _ _ _).symm
    _ ≤ candidateOneMarkedHarmonicMass c L q * C := by
      apply mul_le_mul_of_nonneg_right _ hC
      exact candidate_full_P_harmonic_sum_le_total (mul_nonneg hc.le hL) hq
    _ = _ := by dsimp only [C, R]; ring

end Bounty

end

section

/- The exact one-step physical/full-state identities compose through an
entire finite schedule. The encoding at each cut is explicit, and changing
it is permitted at normalized permutation steps. -/

namespace Bounty

section Physical
variable {I K : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g, ∀ p : ↥(P g), NeZero p.val]
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (retention : I → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
  (hV : ∀ g, V g ≠ 0)

noncomputable def physicalBoundedMarkHistory (tags : ℕ → Option (I ⊕ K)) (steps : ℕ) :=
  finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
    (fun i => physicalBoundedMarkRow C k ω β retention ρ V hV (tags i)) steps

theorem physical_bounded_mark_history_intertwines
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (tags : ℕ → Option (I ⊕ K)) (cut : ℕ → Fin N → Finset (Fin J))
    (hencode : ∀ i, PhysicalMarkRowEncoding C (tags i) (cut i) (cut (i + 1)))
    (steps : ℕ)
    (F : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) :
    physicalBoundedMarkHistory C k ω β retention ρ V hV tags steps
      (F ∘ physicalBoundedMarkEncode (cut steps)) s =
    finiteRowComposition (S := fun _ => FullMixedLedgerState
      (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
      (fun i => physicalFullLedgerRow C k ω β retention ρ V (tags i)) steps F
      (physicalBoundedMarkEncode (cut 0) s) := by
  unfold physicalBoundedMarkHistory
  refine finite_row_composition_intertwines_apply
    (S := fun _ => PhysicalBoundedMarkState P J ell B)
    (T := fun _ => FullMixedLedgerState
      (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (fun i => physicalBoundedMarkRow (B := B) C k ω β retention ρ V hV (tags i))
    (fun i => physicalFullLedgerRow (B := B) C k ω β retention ρ V (tags i))
    (fun i => physicalBoundedMarkEncode (B := B) (cut i)) ?_ steps F s
  intro i G
  funext t
  exact physical_bounded_mark_row_intertwines C k ω β retention ρ V hV hP hdis
    (tags i) (cut i) (cut (i + 1)) (hencode i) G t

theorem physical_bounded_mark_history_eq_operator_list
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (tags : ℕ → Option (I ⊕ K)) (cut : ℕ → Fin N → Finset (Fin J))
    (hencode : ∀ i, PhysicalMarkRowEncoding C (tags i) (cut i) (cut (i + 1)))
    (steps : ℕ)
    (F : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) :
    physicalBoundedMarkHistory C k ω β retention ρ V hV tags steps
      (F ∘ physicalBoundedMarkEncode (cut steps)) s =
    finiteOperatorListAction (physicalFullLedgerRow C k ω β retention ρ V)
      ((List.range steps).map tags) F (physicalBoundedMarkEncode (cut 0) s) := by
  rw [physical_bounded_mark_history_intertwines C k ω β retention ρ V hV
    hP hdis tags cut hencode steps F s]
  rw [finite_row_schedule_eq_list]

end Physical
end Bounty
end

section

/- The difference between two memory caps is precisely the larger-cap path
sum over excursions beyond the smaller cap, with its original whole-path phase. -/

open Finset Classical

namespace Bounty

section

variable {J K G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  {M : G → ℕ} (S : K → ∀ g, Finset (Fin (M g)))
  (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
  (Δ D : ∀ k c, A k c → G → ℤ)
  {b B : ℕ} (h : b ≤ B)
  (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)
  (steps : List (Option (J ⊕ K)))
  (phase : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → ℂ)
  (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)

theorem full_permutation_mixed_cap_difference
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b)
    (hs : productTotalMemory s ≤ b) :
    fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps phase f (productStateCapEmbed h s) -
      fullPermutationMixedPathAction n S b A Δ D ω μ q ρ V steps
        (fullPermutationMixedCapPhase n S A Δ D h ω μ q ρ V steps phase)
        (fun s => f (productStateCapEmbed h s)) s =
      fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps
        (fun s p => if b < fullMemoryPathPeak n S B A Δ D steps s p then phase s p else 0)
        f (productStateCapEmbed h s) := by
  rw [full_permutation_mixed_cap_path_action n S A Δ D h ω μ q ρ V steps phase f s hs]
  let _ : ∀ (k : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D k s) :=
    fullPermutationMixedEventFintype n S B A Δ D
  exact finite_event_path_action_sub_safe (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D)
    (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V)
    productTotalMemory b steps phase f (productStateCapEmbed h s)

theorem full_permutation_mixed_cap_difference_mask
    (I : ℕ) (hIb : I ≤ b)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b) :
    (if productTotalMemory s ≤ I then
      fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps phase f (productStateCapEmbed h s) -
        fullPermutationMixedPathAction n S b A Δ D ω μ q ρ V steps
          (fullPermutationMixedCapPhase n S A Δ D h ω μ q ρ V steps phase)
          (fun s => f (productStateCapEmbed h s)) s
      else 0) =
      fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps
        (fun s p => if productTotalMemory s ≤ I ∧
          b < fullMemoryPathPeak n S B A Δ D steps s p then phase s p else 0)
        f (productStateCapEmbed h s) := by
  by_cases hs : productTotalMemory s ≤ I
  · rw [if_pos hs, full_permutation_mixed_cap_difference n S A Δ D h ω μ q ρ V steps phase f s (hs.trans hIb)]
    unfold fullPermutationMixedPathAction finiteEventPathAction
    apply sum_congr rfl
    intro p _
    simp only [productStateCapEmbed_totalMemory, hs, true_and]
  · rw [if_neg hs]
    unfold fullPermutationMixedPathAction finiteEventPathAction
    simp only [productStateCapEmbed_totalMemory, hs, false_and, if_false, mul_zero, zero_mul, sum_const_zero]

end

end Bounty
end

