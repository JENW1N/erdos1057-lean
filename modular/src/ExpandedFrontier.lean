section

/- Observable mixed event data agree across memory caps on nonzero support.
The cap-free data retain both endpoints, auxiliary choices, actual fresh
labels, and ghost birth tuples and retained indices. Terminal observables of
small states, active labels and pending lengths include the vacuum boundary. -/

open Finset Classical
namespace Bounty

abbrev PhysicalSmallBigStateObservation {S G : Type*} (Ps : S → Finset ℕ)
    (J ell : ℕ) (P : G → Type*) (M : G → ℕ) :=
  PhysicalBareResidueState Ps J ell × (∀ g, Fin (M g) → P g) × (G → ℕ)

def physicalSmallBigStateObservation {S G : Type*} {Ps : S → Finset ℕ}
    {P Z : G → Type*} {J ell B : ℕ} {M : G → ℕ}
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B)) :
    PhysicalSmallBigStateObservation Ps J ell P M :=
  (s.1, (fun g => (s.2 g).1), fun g => (s.2 g).2.1.val)

theorem physical_small_big_state_observation_cap {S G : Type*} {Ps : S → Finset ℕ}
    {P Z : G → Type*} {J ell b B : ℕ} {M : G → ℕ} (h : b ≤ B)
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M b)) :
    physicalSmallBigStateObservation (physicalSmallBigCapEmbed h s) =
      physicalSmallBigStateObservation s := rfl

theorem physical_small_big_terminal_observable_cap {S G E : Type*} {Ps : S → Finset ℕ}
    {P Z : G → Type*} {J ell b B : ℕ} {M : G → ℕ} (h : b ≤ B)
    (F : PhysicalSmallBigStateObservation Ps J ell P M → E)
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M b)) :
    F (physicalSmallBigStateObservation (physicalSmallBigCapEmbed h s)) =
      F (physicalSmallBigStateObservation s) := rfl

theorem physical_small_big_vacuum_observable_cap {S G : Type*} {Ps : S → Finset ℕ}
    {P Z : G → Type*} {J ell b B : ℕ} {M : G → ℕ} (h : b ≤ B)
    (F : PhysicalBareResidueState Ps J ell → (∀ g, Fin (M g) → P g) → ℂ)
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M b)) :
    F (physicalSmallBigCapEmbed h s).1 (fun g => ((physicalSmallBigCapEmbed h s).2 g).1) *
        fullMemoryVacuum (physicalSmallBigCapEmbed h s).2 =
      F s.1 (fun g => (s.2 g).1) * fullMemoryVacuum s.2 := rfl

section
variable {H K S G : Type} {Ps : S → Finset ℕ} {P : G → Type}
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : K → ∀ g, Finset (Fin (M g))) (A : K → Type)
  (Δ D : ∀ k, PhysicalSharedLists Ps J → SharedActiveLabels P (shared k) → A k → G → ℤ)

abbrev PhysicalSmallBigPathDrawObservation : Option (H ⊕ K) → Type
  | none => PhysicalPermutations S J ell × FullActiveSlotPermutations M
  | some (.inl _) => ∀ g, FiniteOrderedTuple (UnrestrictedResidueParticle (n g)) × Finset ℕ
  | some (.inr k) => A k × (∀ g, EdgeDrawObservation (P g) (shared k g)ᶜ.card)

def physicalSmallBigPathDrawObservation (B : ℕ) (tag : Option (H ⊕ K))
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)) :
    PhysicalSmallBigPathEvent n shared B A Δ D tag s →
      PhysicalSmallBigPathDrawObservation (S := S) (J := J) (ell := ell) n shared A tag :=
  match tag with
  | none => id
  | some (.inl _) => fun e g =>
      (⟨(e g).1.val, (e g).2.2⟩, (e g).2.1.map ⟨Fin.val, Fin.val_injective⟩)
  | some (.inr _) => fun e =>
      (e.2.1, fun g => ⟨(e.2.2 g).1, (e.2.2 g).2.1, (e.2.2 g).2.2.2⟩)

theorem physical_small_big_path_draw_observation_cap {b B : ℕ} (h : b ≤ B)
    (tag : Option (H ⊕ K))
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b))
    (e : PhysicalSmallBigPathEvent n shared b A Δ D tag s) :
    physicalSmallBigPathDrawObservation n shared A Δ D B tag (physicalSmallBigCapEmbed h s)
        (physicalSmallBigPathEventCapEmbed n shared A Δ D h tag s e) =
      physicalSmallBigPathDrawObservation n shared A Δ D b tag s e := by
  cases tag with
  | none => rfl
  | some tag => cases tag <;> rfl

variable [Fintype S] [Fintype G]
  (kbig : ∀ k, SharedActiveLabels P (shared k) → A k → ℤ)

noncomputable def physicalSmallBigPathObservablePhase (B : ℕ)
    (Φ : ∀ tag : Option (H ⊕ K), PhysicalSmallBigStateObservation Ps J ell P M →
      PhysicalSmallBigStateObservation Ps J ell P M →
      PhysicalSmallBigPathDrawObservation (S := S) (J := J) (ell := ell) n shared A tag → ℂ)
    (tag : Option (H ⊕ K))
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (e : PhysicalSmallBigPathEvent n shared B A Δ D tag s) : ℂ :=
  Φ tag (physicalSmallBigStateObservation s)
    (physicalSmallBigStateObservation (physicalSmallBigPathEventTarget n shared B A Δ D kbig tag s e))
    (physicalSmallBigPathDrawObservation n shared A Δ D B tag s e)

theorem physical_small_big_path_observable_phase_cap {b B : ℕ} (h : b ≤ B)
    (ω : ∀ k, A k → ℝ) (μ : ∀ g, P g → ℝ)
    (qghost : H → ℝ) (ρ : ℝ) (V : G → ℝ) (Vs : S → ℝ) (qsmall : ℝ)
    (Φ : ∀ tag : Option (H ⊕ K), PhysicalSmallBigStateObservation Ps J ell P M →
      PhysicalSmallBigStateObservation Ps J ell P M →
      PhysicalSmallBigPathDrawObservation (S := S) (J := J) (ell := ell) n shared A tag → ℂ)
    (tag : Option (H ⊕ K))
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b))
    (e : PhysicalSmallBigPathEvent n shared b A Δ D tag s)
    (hw : physicalSmallBigPathEventWeight n shared b A Δ D kbig ω μ qghost ρ V Vs qsmall tag s e ≠ 0) :
    physicalSmallBigPathObservablePhase n shared A Δ D kbig B Φ tag (physicalSmallBigCapEmbed h s)
        (physicalSmallBigPathEventCapEmbed n shared A Δ D h tag s e) =
      physicalSmallBigPathObservablePhase n shared A Δ D kbig b Φ tag s e := by
  unfold physicalSmallBigPathObservablePhase
  rw [physicalSmallBigPathEventCapEmbed_target n shared A Δ D h kbig ω μ qghost ρ V Vs qsmall tag s e hw,
    physical_small_big_state_observation_cap, physical_small_big_state_observation_cap,
    physical_small_big_path_draw_observation_cap]

end
section
variable {S G : Type*} [Fintype S] [Fintype G]
  {Ps : S → Finset ℕ} {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  {J ell : ℕ} {M : G → ℕ} (shared : ∀ g, Finset (Fin (M g)))
  (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
  (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (kbig : SharedActiveLabels P shared → ℤ)

omit [∀ g, Fintype (P g)] [∀ g p, NeZero (n g p)] in
theorem physical_small_big_observable_phase_cap {b B : ℕ} (h : b ≤ B)
    (Vs : S → ℝ) (q : ℝ)
    (Φ : PhysicalBareResidueState Ps J ell → PhysicalBareResidueState Ps J ell →
      (∀ g, Fin (M g) → P g) → (∀ g, Fin (M g) → P g) →
      (∀ g, EdgeDrawObservation (P g) (shared g)ᶜ.card) → ℂ)
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M b))
    (e : PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared b Δ D) s)
    (hw : physicalSmallBigPositiveWeight Vs q (PhysicalSmallBigFullEvent n shared b Δ D)
      (physicalSmallBigFullWeight n shared b Δ D μ ρ V)
      (fun x => kbig (productActiveMemorySplit shared b x).1) s e ≠ 0) :
    physicalSmallBigObservablePhase n shared B Δ D kbig Φ (physicalSmallBigCapEmbed h s) e =
      physicalSmallBigObservablePhase n shared b Δ D kbig Φ s e := by
  have hb : fullActiveEdgeEventWeight n shared b (fun _ => Unit)
      (fun c _ => Δ (physicalSharedPrefix s.1.2) c)
      (fun c _ => D (physicalSharedPrefix s.1.2) c) (fun _ _ => 1) μ ρ V s.2 e.2 ≠ 0 := by
    unfold physicalSmallBigPositiveWeight at hw
    split_ifs at hw
    · exact (mul_ne_zero_iff.mp hw).2
    · exact False.elim (hw rfl)
  have ht := fullActiveEdgeEventTarget_cap_of_weight_ne_zero n shared (fun _ => Unit)
    (fun c _ => Δ (physicalSharedPrefix s.1.2) c)
    (fun c _ => D (physicalSharedPrefix s.1.2) c) h s.2
    (fun _ _ => 1) μ ρ V e.2 hb
  exact congrArg (fun target => Φ s.1
    (physicalSmallBigTarget (PhysicalSmallBigFullEvent n shared b Δ D)
      (physicalSmallBigFullTarget n shared b Δ D)
      (fun x => kbig (productActiveMemorySplit shared b x).1) s e).1
    (fun g => (s.2 g).1) target
    (fun g => ⟨(e.2.2 g).1, (e.2.2 g).2.1, (e.2.2 g).2.2.2⟩))
    (congrArg (fun x => fun g => (x g).1) ht).symm

end
end Bounty
