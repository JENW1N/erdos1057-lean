  (fullEdgeLocalSampleEmbedding (J := J) S B n k A Δ D s sk).trans
    (fullMixedOccurrenceAddressEmbedding S B (some (.inr k) :: steps) ⟨0, by simp⟩)

noncomputable def fullMixedEdgeHeadSampleOrder :
    Fin (Fintype.card (FullActiveEdgeSampleIndex n (S k) B A Δ D s sk)) ≃
      FullActiveEdgeSampleIndex n (S k) B A Δ D s sk :=
  finiteEmbeddedOrder (fullMixedEdgeHeadSampleEmbedding n S B k steps A Δ D s sk)

theorem full_mixed_edge_head_sample_order_strictMono :
    StrictMono (fun i => fullMixedEdgeHeadSampleEmbedding n S B k steps A Δ D s sk
      (fullMixedEdgeHeadSampleOrder n S B k steps A Δ D s sk i)) :=
  finite_embedded_order_strictMono _

theorem full_mixed_edge_head_sample_owner (i : FullActiveEdgeSampleIndex n (S k) B A Δ D s sk) :
    fullMixedBirthOwner S B (some (.inr k) :: steps)
      (fullMixedBirthOrder S B (some (.inr k) :: steps)
        (fullMixedEdgeHeadSampleEmbedding n S B k steps A Δ D s sk i)) = ⟨0, by simp⟩ :=
