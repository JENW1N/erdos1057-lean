section

/- Actual tilted-law vacuum scalars at two finite memory caps. Explicit
damping choices cover doubled ghost births while retaining the original
edge coefficient. A small linear baseline distortion bounds the squared
vacuum boundary factor by exp(2). -/

open Finset Classical

namespace Bounty

theorem tilted_vacuum_scalar_cap_error
    {J K G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (V : G → ℝ) (baseline : ∀ g, P g → ℝ)
    (hpositive : ∀ g (p : P g), 0 < p.val)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (hbaseline : ∀ g p, 1 / 2 ≤ baseline g p ∧ baseline g p ≤ 1)
    {M : G → ℕ} (S : K → ∀ g, Finset (Fin (M g)))
    (A : ∀ k, SharedActiveLabels (fun g => P g) (S k) → Type*) [∀ k c, Fintype (A k c)]
    (Δ D : ∀ k c, A k c → G → ℤ) {b B : ℕ} (h : b ≤ B)
    (ω : ∀ k c, A k c → ℝ) (q : J → ℝ)
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    {qmax vmin vmax : ℝ} (hqmax0 : 0 ≤ qmax) (hqmax1 : qmax < 1)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hq0 : ∀ j, 0 ≤ q j) (hqmax : ∀ j, q j ≤ qmax)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (steps : List (Option (J ⊕ K)))
    (phase : ∀ s, FullPermutationMixedPath (fun g (p : P g) => p.val) S B A Δ D steps s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1) :
    let _ : ∀ g (p : P g), NeZero p.val := fun g p => ⟨Nat.ne_of_gt (hpositive g p)⟩
    let μ := fun g => tiltedPhysicalBirthLaw V g (baseline g)
    let ρ := physicalGhostRhoChoice qmax
    let v := physicalGhostWeightChoice qmax (2 * vmax)
    ‖fullPermutationVacuumScalar (fun g (p : P g) => p.val) S A Δ D ω μ q ρ V steps B phase -
      fullPermutationVacuumScalar (fun g (p : P g) => p.val) S A Δ D ω μ q ρ V steps b
        (fullPermutationMixedCapPhase (fun g (p : P g) => p.val) S A Δ D h ω μ q ρ V steps phase)‖ ^ 2 ≤
      ((2 : ℝ) ^ (b + 1 - fullMemoryEdgeCount steps * (T * Fintype.card G)))⁻¹ ^ 2 *
        (steps.map (fullDoubledGhostStepEnergy ρ v vmin vmax T (Fintype.card G))).prod *
        (∏ g, (∑ p : P g, μ g p) ^ M g) ^ 2 := by
  let _ : ∀ g (p : P g), NeZero p.val := fun g p => ⟨Nat.ne_of_gt (hpositive g p)⟩
  obtain ⟨hρ0, hρ1, hgap, hv, hthreshold, hconditions⟩ :=
    physical_ghost_parameter_choice (Vmax := 2 * vmax) hqmax0 hqmax1
  apply full_permutation_vacuum_scalar_cap_error (fun g (p : P g) => p.val)
    S A Δ D h ω (fun g => tiltedPhysicalBirthLaw V g (baseline g)) q
    (physicalGhostRhoChoice qmax) V hω hωmass hρ0 hρ1 hv hvmin hVlo hVhi
    ?_ ?_ hq0 (fun j => (hqmax j).trans hqmax1.le) ?_ ?_ T ht steps phase hphase
  · intro g p
    exact tiltedPhysicalBirthLaw_pos V g (baseline g) (hvmin.trans_le (hVlo g)) (hpositive g)
      (fun p => lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1 / 2) (hbaseline g p).1) p
  · intro g
    exact (tiltedPhysicalBirthLaw_sum_bounds V g (baseline g)
      (hvmin.trans_le (hVlo g)) (hMass g) (hbaseline g)).2
  · intro j
    simpa only [one_mul, mul_one] using
      (physical_ghost_scaled_damping_lt_one (hq0 j) (hqmax j) hgap hρ0 hρ1 hthreshold
        (a := 1) (W := 1) (by norm_num) zero_le_one (le_max_left _ _)).le
  · intro j g
    exact (hconditions (q j) (2 * V g) (hq0 j) (hqmax j)
      (mul_nonneg (by norm_num) (hvmin.trans_le (hVlo g)).le)
      (mul_le_mul_of_nonneg_left (hVhi g) (by norm_num))).2.1

/-- Linear baselines and a total distortion at most one give an explicit
exp(2) boundary factor in the two-cap scalar comparison. -/
theorem tilted_linear_vacuum_scalar_cap_error
    {J K G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (V : G → ℝ) (d : ∀ g, P g → ℝ)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    {M : G → ℕ} (S : K → ∀ g, Finset (Fin (M g)))
    (A : ∀ k, SharedActiveLabels (fun g => P g) (S k) → Type*) [∀ k c, Fintype (A k c)]
    (Δ D : ∀ k c, A k c → G → ℤ) {b B : ℕ} (h : b ≤ B)
    (ω : ∀ k c, A k c → ℝ) (q : J → ℝ)
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    {qmax vmin vmax : ℝ} (hqmax0 : 0 ≤ qmax) (hqmax1 : qmax < 1)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hq0 : ∀ j, 0 ≤ q j) (hqmax : ∀ j, q j ≤ qmax)
    {dmax P₀ : ℝ} (hP₀ : 0 < P₀) (hdmax : 0 ≤ dmax) (hdP : 2 * dmax ≤ P₀)
    (hd0 : ∀ g p, 0 ≤ d g p) (hdmax' : ∀ g p, d g p ≤ dmax)
    (hp : ∀ g (p : P g), P₀ ≤ (p.val : ℝ))
    (hsmall : (2 * dmax / P₀) * ∑ g, (M g : ℝ) ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (steps : List (Option (J ⊕ K)))
    (phase : ∀ s, FullPermutationMixedPath (fun g (p : P g) => p.val) S B A Δ D steps s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1) :
    let _ : ∀ g (p : P g), NeZero p.val :=
      fun g p => ⟨Nat.ne_of_gt (Nat.cast_pos.mp (hP₀.trans_le (hp g p)))⟩
    let μ := fun g => tiltedPhysicalBirthLaw V g (fun p => 1 - d g p / p.val)
    let ρ := physicalGhostRhoChoice qmax
    let v := physicalGhostWeightChoice qmax (2 * vmax)
    ‖fullPermutationVacuumScalar (fun g (p : P g) => p.val) S A Δ D ω μ q ρ V steps B phase -
      fullPermutationVacuumScalar (fun g (p : P g) => p.val) S A Δ D ω μ q ρ V steps b
        (fullPermutationMixedCapPhase (fun g (p : P g) => p.val) S A Δ D h ω μ q ρ V steps phase)‖ ^ 2 ≤
      ((2 : ℝ) ^ (b + 1 - fullMemoryEdgeCount steps * (T * Fintype.card G)))⁻¹ ^ 2 *
        (steps.map (fullDoubledGhostStepEnergy ρ v vmin vmax T (Fintype.card G))).prod * Real.exp 2 := by
  have hpositive : ∀ g (p : P g), 0 < p.val :=
    fun g p => Nat.cast_pos.mp (hP₀.trans_le (hp g p))
  let _ : ∀ g (p : P g), NeZero p.val := fun g p => ⟨Nat.ne_of_gt (hpositive g p)⟩
  let μ := fun g => tiltedPhysicalBirthLaw V g (fun p => 1 - d g p / p.val)
  let ν : ∀ g, UnrestrictedResidueParticle (fun p : P g => p.val) → ℝ :=
    fun g => unrestrictedResidueWeight (μ g)
  have hbaseline : ∀ g (p : P g),
      1 / 2 ≤ 1 - d g p / (p.val : ℝ) ∧ 1 - d g p / (p.val : ℝ) ≤ 1 := by
    intro g p
    exact memory_baseline_bounds (hd0 g p) (hP₀.trans_le (hp g p))
      ((mul_le_mul_of_nonneg_left (hdmax' g p) (by norm_num)).trans (hdP.trans (hp g p)))
  have hμ : ∀ g (p : P g), 0 ≤ μ g p := by
    intro g p
    exact (tiltedPhysicalBirthLaw_pos V g _ (hvmin.trans_le (hVlo g)) (hpositive g)
      (fun p => lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1 / 2) (hbaseline g p).1) p).le
  have hb := tilted_linear_vacuum_energy_le_exp_one P V d ν M B
    (fun g => hvmin.trans_le (hVlo g)) hMass hP₀ hdmax hdP hd0 hdmax' hp hsmall
  rw [fullMemoryVacuum_energy] at hb
  have hmass0 : 0 ≤ ∏ g, (∑ p : P g, μ g p) ^ M g :=
    prod_nonneg fun g _ => pow_nonneg (sum_nonneg fun p _ => hμ g p) _
  have hboundary : (∏ g, (∑ p : P g, μ g p) ^ M g) ^ 2 ≤ Real.exp 2 := by
    calc
      _ ≤ (Real.exp 1) ^ 2 := pow_le_pow_left₀ hmass0 hb 2
      _ = Real.exp 2 := by rw [pow_two, ← Real.exp_add]; norm_num
  have he := tilted_vacuum_scalar_cap_error P V (fun g p => 1 - d g p / p.val)
    hpositive hMass hbaseline S A Δ D h ω q hω hωmass hqmax0 hqmax1
    hvmin hVlo hVhi hq0 hqmax T ht steps phase hphase
  apply he.trans
  apply mul_le_mul_of_nonneg_left hboundary
  apply mul_nonneg (sq_nonneg _)
  apply List.prod_nonneg
  intro c hc
  obtain ⟨k, _, rfl⟩ := List.mem_map.mp hc
  cases k with
  | none => exact zero_le_one
  | some k =>
    cases k with
    | inl j => exact pow_nonneg (Real.exp_pos _).le _
    | inr k => exact pow_nonneg (unrestrictedEdgeEnergyBound_nonneg _ _ _ _ _) _

end Bounty
end

section

/- Arbitrary power saving for the actual candidate large-conductor Type I mass. -/

open Finset Filter

namespace Bounty

theorem candidate_Q_zero_le_wide_bound {c L : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1) (hL : 0 ≤ L)
    {p : ℕ} (hp : p ∈ candidateQBand (c * L) 0) :
    (p : ℝ) ≤ 16 * Real.exp L := by
  have hscale := (candidate_center_scale_bounds hc hr hcenter).1
  have hupper : (p : ℝ) ≤ Real.exp ((6/5 : ℝ) * (c * L)) := by
    simpa only [pow_zero, div_one] using
      ((mem_dyadicPrimeBand_iff (c * L) 1 (6/5) 0 p).mp hp).2.2
  have hexp : Real.exp ((6/5 : ℝ) * (c * L)) ≤ Real.exp L := by
    apply Real.exp_le_exp.mpr
    have h := mul_le_mul_of_nonneg_right hscale hL
    nlinarith [mul_nonneg hc.le hL]
  exact (hupper.trans hexp).trans (by nlinarith [Real.exp_pos L])

theorem eventually_candidate_large_primitive_power_saving {c q theta : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1)
    (hq0 : 0 ≤ q) (hq1 : q < 1) (htheta : theta < 1/2) (B : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, 0 < jStar → ∀ N : ℕ,
      (N : ℝ) ≤ Real.exp (theta * L) →
      candidateLargePrimitiveTypeIMass c L q r jStar N ⌊Real.exp ((c/512)*L)⌋₊ ≤
        Real.exp L * L ^ (-B) := by
  have htheta' : (theta + 1/2) / 2 < (1/2 : ℝ) := by linarith
  filter_upwards [eventually_candidate_dyadic_block_decay hc hr hq0 hq1 hcenter htheta' (B + 5),
    eventually_dyadicConductorRange_scale_bounds c htheta,
    eventually_dyadicConductorRange_card_le_linear c htheta,
    eventually_dyadicNatIndices_card_le_linear,
    eventually_three_dyadic_counts_totient_factor_le_pow_five] with L hblock hscale hqcount hcount hcost
  intro jStar hj N hN
  have hL : 0 < L := hcost.1
  have hNexp : (N : ℝ) ≤ Real.exp L := by
    apply hN.trans
    apply Real.exp_le_exp.mpr
    nlinarith
  have hcut : (c/512)*L = c*L/512 := by ring
  rw [hcut]
  let H : ℝ := (2 / Real.log 2 + 1) * L
  let CS : ℝ := (dyadicNatIndices (candidateQBand (c * L) 0)).card
  let CT : ℝ := (dyadicNatIndices (Icc 1 ⌊16 * Real.exp L⌋₊)).card
  have hlog : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hH : 0 ≤ H := by dsimp [H]; positivity
  have hCS : CS ≤ H := by
    apply hcount ⌊16 * Real.exp L⌋₊ (candidateQBand (c * L) 0)
      (Nat.floor_le (by positivity))
    intro p hp
    exact Nat.le_floor (candidate_Q_zero_le_wide_bound hc hr hcenter hL.le hp)
  have hCT : CT ≤ H := by
    apply hcount ⌊16 * Real.exp L⌋₊ (Icc 1 ⌊16 * Real.exp L⌋₊)
      (Nat.floor_le (by positivity))
    intro n hn
    exact (mem_Icc.mp hn).2
  have hB : 0 ≤ Real.exp L * L ^ (-(B + 5)) := by positivity
  have hmain := candidate_large_mass_le_dyadic_blocks (mul_nonneg hc.le hL.le)
    q r jStar hr hj N ⌊Real.exp (c*L/512)⌋₊
    (Real.one_le_exp_iff.mpr hL.le) hNexp hH hB
    (fun h _ => hqcount N h hN) (by
      intro h hh k hk i hi j hj'
      obtain ⟨hRlo, hRhi, hRone⟩ := hscale N h k hN hk
      have hbase : ∀ f ∈ Icc (max 2 (⌊Real.exp (c*L/512)⌋₊ + 1)) (N / h), 0 < f := by
        intro f hf
        have hf2 : 2 ≤ f := (le_max_left _ _).trans (mem_Icc.mp hf).1
        omega
      have hQD : ∀ f ∈ dyadicNatBucket
          (Icc (max 2 (⌊Real.exp (c*L/512)⌋₊ + 1)) (N / h)) k,
          (2 : ℝ) ^ (k + 1) / 2 ≤ (f : ℝ) := by
        intro f hf
        have hlo := (dyadicNatBucket_bounds _ hbase hf).1
        have hloR : (2 : ℝ) ^ k ≤ f := by exact_mod_cast hlo
        have heq : (2 : ℝ) ^ (k + 1) / 2 = (2 : ℝ) ^ k := by rw [pow_succ]; ring
        rwa [heq]
      have hQR : ∀ f ∈ dyadicNatBucket
          (Icc (max 2 (⌊Real.exp (c*L/512)⌋₊ + 1)) (N / h)) k,
          (f : ℝ) ≤ (2 : ℝ) ^ (k + 1) := by
        intro f hf
        exact_mod_cast (dyadicNatBucket_bounds _ hbase hf).2.le
      have hb := hblock jStar hj h ((2 : ℝ) ^ (k + 1))
        (by simpa only [hcut] using hRlo) hRhi _ hQD hQR i j
      unfold candidateRemainderCharacterVector
      exact hb)
  have hfactor :
      (2 * primeEulerProductUpperConstant * Real.log (2 * Real.exp L)) * H * CS * CT ≤ L ^ 5 :=
    hcost.2 H CS CT hH (by dsimp [CS]; positivity) (by dsimp [CT]; positivity) le_rfl hCS hCT
  calc
    _ ≤ (2 * primeEulerProductUpperConstant * Real.log (2 * Real.exp L)) * H * CS * CT *
        (Real.exp L * L ^ (-(B + 5))) := hmain
    _ ≤ L ^ 5 * (Real.exp L * L ^ (-(B + 5))) := mul_le_mul_of_nonneg_right hfactor hB
    _ = Real.exp L * L ^ (-B) := by
      have hpow : L ^ (5 : ℝ) = L ^ (5 : ℕ) := Real.rpow_natCast L 5
      rw [← hpow]
      calc
        _ = Real.exp L * (L ^ (5 : ℝ) * L ^ (-(B + 5))) := by ring
        _ = _ := by rw [← Real.rpow_add hL, show (5 : ℝ) + (-(B + 5)) = -B by ring]


end Bounty
end

