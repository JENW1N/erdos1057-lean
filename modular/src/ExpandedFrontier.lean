section

/- The original small and big candidate pools have a uniformly subexponential free factor. -/

open Filter Finset
open scoped Classical
namespace Bounty

theorem eventually_candidate_free_factor_subexponential {c A ε : ℝ}
    (hc : 0 < c) (hA : 0 ≤ A) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ (G : Type*) [Fintype G]
      (ι : G → candidatePIndices c L) (J : ℕ) (C : G → Finset (Fin J))
      (aux : PhysicalAuxLabels (fun g => candidatePBand (c*L) (ι g).val) C),
      (J*Fintype.card G : ℕ) ≤ A*Real.log L →
      (physicalFreeFactor C aux : ℝ) ≤ Real.exp (ε*L) := by
  obtain ⟨v, V, _, _, hpool⟩ := exists_candidate_P_pool_bounds hc
  filter_upwards [hpool, eventually_physical_free_factor_subexponential hA
    (by norm_num : (2/5 : ℝ) < 1) hε] with L hp he
  intro G _ ι J C aux hslots
  exact he G (fun g => candidatePBand (c*L) (ι g).val) J C aux
    (fun g p hpg => ((hp.2.2.2.2.2 (ι g).val (ι g).property).2.2 p hpg).2.2) hslots

end Bounty
end

section

/- The original candidate endpoint ceiling scale has logarithm at most (4+epsilon)L. -/

open Filter Finset
open scoped Classical
namespace Bounty

theorem eventually_candidate_harmonic_log_linear {c A ε : ℝ}
    (hc : 0 < c) (hA : 0 ≤ A) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ (G : Type*) [Fintype G]
      (ι : G → candidatePIndices c L) (J : ℕ) (C : G → Finset (Fin J))
      (aux : PhysicalAuxLabels (fun g => candidatePBand (c*L) (ι g).val) C),
      (J*Fintype.card G : ℕ) ≤ A*Real.log L →
      ∀ Z : ℝ, 0 < Z → 1 ≤ Z*(physicalFreeFactor C aux : ℝ) →
      3*Z < Real.exp (4*L) →
      Real.log (⌈3*Z*(physicalFreeFactor C aux : ℝ)⌉₊ : ℝ) ≤ (4+ε)*L := by
  obtain ⟨v, V, _, _, hpool⟩ := exists_candidate_P_pool_bounds hc
  filter_upwards [hpool, eventually_physical_harmonic_log_linear hA
    (by norm_num : (2/5 : ℝ) < 1) hε] with L hp he
  intro G _ ι J C aux hslots Z hZ hprod hcut
  exact he G (fun g => candidatePBand (c*L) (ι g).val) J C aux
    (fun g p hpg => ((hp.2.2.2.2.2 (ι g).val (ι g).property).2.2 p hpg).1)
    (fun g p hpg => ((hp.2.2.2.2.2 (ι g).val (ι g).property).2.2 p hpg).2.2)
    hslots Z hZ hprod hcut

end Bounty
end

section

/- Polynomial bookkeeping for the two actual harmonic replacement errors. -/

namespace Bounty

theorem harmonic_error_power_envelope {L M energy m C : ℝ}
    (hL : 0 < L) (hM0 : 0 ≤ M) (hM : M ≤ L^m)
    (he0 : 0 ≤ energy) (he : energy ≤ L^(31 : ℝ)) :
    M*M*(L^C*L^C*L^C)^2*energy ≤ L^(2*m+6*C+31) := by
  calc
    _ ≤ L^m*L^m*(L^C*L^C*L^C)^2*L^(31 : ℝ) := by gcongr
    _ = _ := by
      simp only [← Real.rpow_mul_natCast hL.le, ← Real.rpow_add hL]
      congr 1
      ring

theorem harmonic_free_error_power_envelope {L common H T E : ℝ}
    (hL : 2 ≤ L) (hc0 : 0 ≤ common) (hc : common ≤ L^T)
    (hH0 : 0 ≤ H) (hH : H ≤ L^E) :
    2*common*H ≤ L^(T+E+1) := by
  have hL0 : 0 < L := by linarith
  calc
    _ ≤ L*L^T*L^E := by gcongr
    _ = _ := by
      nth_rw 1 [← Real.rpow_one L]
      rw [← Real.rpow_add hL0, ← Real.rpow_add hL0]
      congr 1
      ring

theorem harmonic_error_decay_absorb {L common T D : ℝ}
    (hL : 0 < L) (hc : common ≤ L^T) :
    common*L^(-(D+T+1)) ≤ L^(-D-1) := by
  calc
    _ ≤ L^T*L^(-(D+T+1)) := mul_le_mul_of_nonneg_right hc (Real.rpow_nonneg hL.le _)
    _ = _ := by rw [← Real.rpow_add hL]; congr 1; ring

theorem harmonic_two_errors_absorb {L D : ℝ} (hL : 2 ≤ L) :
    L^(-D-1)+L^(-D-1) ≤ L^(-D) := by
  have hL0 : 0 < L := by linarith
  calc
    _ = 2*L^(-D-1) := by ring
    _ ≤ L*L^(-D-1) := mul_le_mul_of_nonneg_right hL (Real.rpow_nonneg hL0.le _)
    _ = _ := by
      nth_rw 1 [← Real.rpow_one L]
      rw [← Real.rpow_add hL0]
      congr 1
      ring

end Bounty
end

