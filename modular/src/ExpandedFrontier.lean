section

/- The literal full clean event, with its shared-dependent physical
displacement and total cutoff, is the clean repeated-kernel row. -/

open Finset
open scoped Classical

namespace Bounty

theorem clean_full_memory_event_kernel_row {S G : Type*}
    [Fintype S] [Fintype G] [dG : DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    [∀ g (p : P g), NeZero p.val]
    (V : G → ℝ) (b : ∀ g, P g → ℝ) (C : G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ) (N : G → Fin (B + 1))
    (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
    (rm : FixedOrderedResidues p) (rs : PhysicalResidues Ps)
    (d : PhysicalSharedLists Ps J)
    (D : SharedActiveLabels (fun g => ↥(P g)) (cleanFullSharedSlots (ell := ell) C) →
      PhysicalAuxLabels P C → G → ℤ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (source : RepeatedBigLists P J ell)
    (f : CleanFullMemoryState P J ell B → PhysicalResidues Ps → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun x => f x r)) :
    let x := cleanFullMemoryState N p source rm
    let c := (productActiveMemorySplit (cleanFullSharedSlots C) B x).1
    let s := (productActiveMemorySplit (cleanFullSharedSlots C) B x).2
    let δ := fun c aux (_ : G) => -cleanFullSharedStep k C c aux d
    let Ψ := fun c aux (fresh : ∀ g, Fin (cleanFullSharedSlots (ell := ell) C g)ᶜ.card → P g) =>
      if repeatedBigAuxAvoids C aux source ∧
          repeatedBigAuxAvoids C aux (repeatedBigFill C source (cleanFullFreshEquiv P C fresh)) then
        K source (repeatedBigFill C source (cleanFullFreshEquiv P C fresh)) aux *
          physicalPhase ζ (cleanFullSharedD C c aux) *
          physicalReturnPhase θ (cleanFullSharedStep k C c aux d) *
          physicalPhase ζ (physicalSharedProduct d) else 0
    (∑ e : FullActiveEdgeEvent (fun g (q : P g) => q.val) (cleanFullSharedSlots C) B
        (fun _ => PhysicalAuxLabels P C) δ D x,
      (fullActiveEdgeEventWeight (fun g (q : P g) => q.val) (cleanFullSharedSlots C) B
        (fun _ => PhysicalAuxLabels P C) δ D (fun _ aux => physicalAuxMass V C aux)
        (fun g => tiltedPhysicalBirthLaw V g (b g)) ρ V x e : ℂ) *
      (if ∀ g, (e.2 g).1 = ∅ ∧ (e.2 g).2.1 = ∅ then
        Ψ c e.1 (fun g => (unrestrictedJointEventTarget (fun g (q : P g) => q.val)
          (δ c e.1) (D c e.1) (fun g => (cleanFullSharedSlots C g)ᶜ.card) B s e.2 g).1)
        else 0) *
      f (fullActiveEdgeEventTarget (fun g (q : P g) => q.val) (cleanFullSharedSlots C) B
        (fun _ => PhysicalAuxLabels P C) δ D x e)
        (physicalTranslateResidues rs (cleanFullSharedStep k C c e.1 d))) =
      if (∑ g, (N g).val) ≤ B then
        ∑ aux : PhysicalAuxLabels P C, ∑ target : RepeatedBigLists P J ell,
          (cleanHybridBetweenKernel V b C ζ θ ρ k (fun _ => B) p rm K d aux source target *
            physicalPhase ζ (physicalSharedProduct d)) *
          f (cleanFullMemoryState N p target
            (fixedOrderedResidueTranslate p rm (cleanHybridStep k C source aux d)))
            (physicalTranslateResidues rs (cleanHybridStep k C source aux d))
      else 0 := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  intro x c s δ Ψ
  have h := full_active_clean_event_sum (fun g (q : P g) => q.val)
    (cleanFullSharedSlots C) B (fun _ => PhysicalAuxLabels P C) δ D
    (fun _ aux => physicalAuxMass V C aux) (fun g => tiltedPhysicalBirthLaw V g (b g)) ρ V Ψ
    (fun c aux x => f x (physicalTranslateResidues rs (cleanFullSharedStep k C c aux d)))
    (fun c aux => hf _) x
  dsimp only at h
  refine h.trans ?_
  rw [show productTotalMemory x = ∑ g, (N g).val from
    cleanFullMemoryState_total_memory N p source rm]
  split_ifs
  · apply sum_congr rfl
    intro aux _
    dsimp only [δ, Ψ, c, s, x]
    simp only [cleanFullSharedD_split, cleanFullSharedStep_split]
    exact clean_full_memory_fresh_kernel_row V b C ζ θ ρ k N p rm d K aux source
      (fun x => f x (physicalTranslateResidues rs (cleanHybridStep k C source aux d)))
  · rfl

end Bounty
end

section

/- The fixed-forest operation factor reads optional birth labels, not pending-memory indices. -/

namespace Bounty

theorem full_mixed_birth_operation_multiplier_congr_labels
    {J K : Type*} {N : ℕ} {P : Fin N → Type*}
    (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
    (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K)))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))
    (θ : (Fin (Fintype.card (FullMixedBirthAddress S B steps)) ×
      Fin (Fintype.card (FullMixedBirthAddress S B steps))) → ℝ)
    (encode : ((g : Fin N) × P g) → ℤ)
    (x y : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x)
    (q : FullPermutationMixedPath n S B A Δ D steps y) (i : Fin steps.length)
    (h : ∀ j, fullMixedIndexedBirthOwner S B steps j = i →
      fullMixedPathBirthLabel n S B A Δ D steps x p (fullMixedBirthOrder S B steps j) =
      fullMixedPathBirthLabel n S B A Δ D steps y q (fullMixedBirthOrder S B steps j)) :
    fullMixedBirthOperationMultiplier n S B A Δ D steps code θ encode x p i =
      fullMixedBirthOperationMultiplier n S B A Δ D steps code θ encode y q i := by
  apply birth_forest_operation_multiplier_congr_on_owner
  · intro j hj
    unfold fullMixedIndexedBirthPerformed
    rw [full_mixed_path_birth_performed_iff_label_present,
      full_mixed_path_birth_performed_iff_label_present, h j hj]
  · intro j hj
    unfold fullMixedIndexedBirthValue
    rw [h j hj]

/-- Within an edge the optional label vector is determined by promoted active
slots and fresh labels. Retrieval embeddings do not enter it. -/
theorem full_mixed_edge_birth_labels_congr
    {J K : Type*} {N : ℕ} {P : Fin N → Type*}
    (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
    (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ) (k : K)
    (x y : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent (J := J) n S B A Δ D (some (.inr k)) x)
    (e' : FullPermutationMixedEvent (J := J) n S B A Δ D (some (.inr k)) y)
    (h : ∀ g, (⟨(e.2 g).2.1, (e.2 g).2.2.2⟩ :
      Σ U : Finset (Fin (S k g)ᶜ.card), UnrestrictedFreshLabels (P g) U) =
        ⟨(e'.2 g).2.1, (e'.2 g).2.2.2⟩) :
    fullMixedEventBirthLabel n S B A Δ D (some (.inr k)) x e =
      fullMixedEventBirthLabel n S B A Δ D (some (.inr k)) y e' := by
  classical
  funext a
  rcases a with ⟨g, i⟩
  have hg := h g
  have heq := congrArg (fun d : Σ U : Finset (Fin (S k g)ᶜ.card),
      UnrestrictedFreshLabels (P g) U =>
        (if hi : i ∈ d.1 then none else
          some (Sum.inr (Sigma.mk g (d.2 ⟨i, hi⟩))) : Option (FullMixedBornData n)).map
            (fullMixedBornPrime n)) hg
  exact heq

/-- Within a ghost visit only the ordered birth batch determines birth labels. -/
theorem full_mixed_ghost_birth_labels_congr
    {J K : Type*} {N : ℕ} {P : Fin N → Type*}
    (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
    (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ) (j : J)
    (x y : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (some (.inl j)) x)
    (e' : FullPermutationMixedEvent n S B A Δ D (some (.inl j)) y)
    (h : ∀ g, (⟨(e.down g).1, (e.down g).2.2⟩ :
      Σ b : Fin (B + 1), Fin b.val → UnrestrictedResidueParticle (n g)) =
        ⟨(e'.down g).1, (e'.down g).2.2⟩) :
    fullMixedEventBirthLabel n S B A Δ D (some (.inl j)) x e =
      fullMixedEventBirthLabel n S B A Δ D (some (.inl j)) y e' := by
  classical
  funext a
  rcases a with ⟨g, i⟩
  have hg := h g
  have heq := congrArg (fun d : Σ b : Fin (B + 1),
      Fin b.val → UnrestrictedResidueParticle (n g) =>
        (if hi : i.val < d.1.val then some (Sum.inl (Sigma.mk g (d.2 ⟨i.val, hi⟩)))
          else none : Option (FullMixedBornData n)).map (fullMixedBornPrime n)) hg
  exact heq

end Bounty
end

section

/- Exact clean-only change of encoding for the original physical full edge.
This transports the literal no-storage, no-promotion event sum. Historical
freshness and target-admissibility gates are not removed by this identity. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def canonicalPhysicalEdgeD {N J ell : ℕ} {P : Fin N → Finset ℕ}
    (C : Fin N → Finset (Fin J))
    (c : SharedActiveLabels (fun g => ↥(P g)) (cleanFullSharedSlots (ell := ell) C))
    (aux : PhysicalAuxLabels P C) (_g : Fin N) : ℤ := cleanFullSharedD C c aux

noncomputable def canonicalPhysicalEdgeDelta {N J ell : ℕ} {P : Fin N → Finset ℕ}
    (C : Fin N → Finset (Fin J)) (k : ℤ)
    (c : SharedActiveLabels (fun g => ↥(P g)) (cleanFullSharedSlots (ell := ell) C))
    (aux : PhysicalAuxLabels P C) (g : Fin N) : ℤ := -k * canonicalPhysicalEdgeD C c aux g

theorem physical_clean_event_sum_reencode {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    [∀ g (p : P g), NeZero p.val]
    (C : Fin N → Finset (Fin J)) (k : ℤ)
    (ω : PhysicalAuxLabels P C → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (Θ : PhysicalAuxLabels P C → (∀ g, Fin (cleanFullSharedSlots (ell := ell) C g)ᶜ.card → P g) → ℂ)
    (f : PhysicalAuxLabels P C → PhysicalFullBoundedState P J ell B → ℂ)
    (hf : ∀ aux, ProductMemorySymmetric (f aux))
    (x : PhysicalFullBoundedState P J ell B) :
    let τ := fullActivePermutation (cleanPhysicalSlotChange C)
    let y := τ x
    let Sp := fun g => physicalFullSharedIndices (ell := ell) (C g)
    let Sc := cleanFullSharedSlots (ell := ell) C
    let cp := (productActiveMemorySplit Sp B y).1
    let sp := (productActiveMemorySplit Sp B y).2
    let cc := (productActiveMemorySplit Sc B x).1
    let sc := (productActiveMemorySplit Sc B x).2
    (∑ e : PhysicalFullEdgeEvent C k y,
      (fullActiveEdgeEventWeight (fun g (p : P g) => p.val) Sp B
        (fun _ => PhysicalAuxLabels P C) (physicalFullEdgeDelta C k) (physicalFullEdgeD C)
        (fun _ => ω) μ ρ V y e : ℂ) *
      (if ∀ g, (e.2 g).1 = ∅ ∧ (e.2 g).2.1 = ∅ then
        Θ e.1 (physicalCleanFreshEquiv (fun g => ↥(P g)) C (fun g =>
          (unrestrictedJointEventTarget (fun g (p : P g) => p.val)
            (physicalFullEdgeDelta C k cp e.1) (physicalFullEdgeD C cp e.1)
            (fun g => (Sp g)ᶜ.card) B sp e.2 g).1)) else 0) *
      f e.1 (τ.symm (fullActiveEdgeEventTarget (fun g (p : P g) => p.val) Sp B
        (fun _ => PhysicalAuxLabels P C) (physicalFullEdgeDelta C k) (physicalFullEdgeD C) y e))) =
    ∑ e : FullActiveEdgeEvent (fun g (p : P g) => p.val) Sc B
        (fun _ => PhysicalAuxLabels P C) (canonicalPhysicalEdgeDelta C k) (canonicalPhysicalEdgeD C) x,
      (fullActiveEdgeEventWeight (fun g (p : P g) => p.val) Sc B
        (fun _ => PhysicalAuxLabels P C) (canonicalPhysicalEdgeDelta C k) (canonicalPhysicalEdgeD C)
        (fun _ => ω) μ ρ V x e : ℂ) *
      (if ∀ g, (e.2 g).1 = ∅ ∧ (e.2 g).2.1 = ∅ then
        Θ e.1 (fun g => (unrestrictedJointEventTarget (fun g (p : P g) => p.val)
          (canonicalPhysicalEdgeDelta C k cc e.1) (canonicalPhysicalEdgeD C cc e.1)
          (fun g => (Sc g)ᶜ.card) B sc e.2 g).1) else 0) *
      f e.1 (fullActiveEdgeEventTarget (fun g (p : P g) => p.val) Sc B
        (fun _ => PhysicalAuxLabels P C) (canonicalPhysicalEdgeDelta C k) (canonicalPhysicalEdgeD C) x e) := by
  intro τ y Sp Sc cp sp cc sc
  have hsym (a : PhysicalAuxLabels P C) : ProductMemorySymmetric (fun z => f a (τ.symm z)) :=
    fullActivePermutation_symmetric (fun g => (cleanPhysicalSlotChange C g).symm) (f a) (hf a)
  have hp := full_active_clean_event_sum (fun g (p : P g) => p.val) Sp B
    (fun _ => PhysicalAuxLabels P C) (physicalFullEdgeDelta C k) (physicalFullEdgeD C)
    (fun _ => ω) μ ρ V (fun _ a fresh => Θ a (physicalCleanFreshEquiv (fun g => ↥(P g)) C fresh))
    (fun _ a z => f a (τ.symm z)) (fun _ a => hsym a) y
  have hc := full_active_clean_event_sum (fun g (p : P g) => p.val) Sc B
    (fun _ => PhysicalAuxLabels P C) (canonicalPhysicalEdgeDelta C k) (canonicalPhysicalEdgeD C)
    (fun _ => ω) μ ρ V (fun _ a fresh => Θ a fresh) (fun _ => f) (fun _ => hf) x
  dsimp only at hp hc
  refine Eq.trans ?_ (hp.trans (Eq.trans ?_ (hc.symm.trans ?_)))
  · apply sum_congr
    · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
    · intro e _
      split_ifs <;> rfl
  ·
    rw [show productTotalMemory y = productTotalMemory x from rfl]
    split_ifs
    · apply sum_congr rfl
      intro a _
      have hd : physicalFullEdgeDelta C k cp a = canonicalPhysicalEdgeDelta C k cc a := by
        funext g
        unfold physicalFullEdgeDelta physicalFullEdgeD canonicalPhysicalEdgeDelta canonicalPhysicalEdgeD
        rw [clean_physical_shared_D_reencode]
      change (ω a : ℂ) * (∏ g, (unrestrictedBoundedCleanFactor _ (physicalFullEdgeDelta C k cp a g) ρ (sp g) : ℂ)) * _ =
        (ω a : ℂ) * (∏ g, (unrestrictedBoundedCleanFactor _ (canonicalPhysicalEdgeDelta C k cc a g) ρ (sc g) : ℂ)) * _
      rw [hd]
      have hfactor : (∏ g, (unrestrictedBoundedCleanFactor (fun p : P g => p.val)
          (canonicalPhysicalEdgeDelta C k cc a g) ρ (sp g) : ℂ)) =
        ∏ g, (unrestrictedBoundedCleanFactor (fun p : P g => p.val)
          (canonicalPhysicalEdgeDelta C k cc a g) ρ (sc g) : ℂ) := by
        apply prod_congr rfl
        intro g _
        rfl
      rw [hfactor]
      congr 1
      let F := fun fresh : (∀ g, Fin (Sc g)ᶜ.card → P g) => Θ a fresh *
        f a ((productActiveMemorySplit Sc B).symm (cc, fun g =>
          unrestrictedBoundedCleanTarget (fun p : P g => p.val)
            (canonicalPhysicalEdgeDelta C k cc a g) (sc g) (fresh g)))
      have hsum := physical_clean_fresh_weighted_sum (fun g => ↥(P g)) C μ F
      simp only [F, ← mul_assoc] at hsum
      refine Eq.trans ?_ hsum
      apply sum_congr rfl
      intro fresh _
      congr 1
      have hr := physical_clean_reassemble_fresh C x
        (fun g => (unrestrictedBoundedCleanTarget (fun p : P g => p.val)
          (canonicalPhysicalEdgeDelta C k cc a g) (sc g) ((physicalCleanFreshEquiv (fun g => ↥(P g)) C fresh) g)).2) fresh
      change _ = τ _ at hr
      rw [show (productActiveMemorySplit Sp B).symm (_, fun g =>
          unrestrictedBoundedCleanTarget (fun p : P g => p.val)
            (canonicalPhysicalEdgeDelta C k cc a g) (sp g) (fresh g)) = _ from hr]
      rw [Equiv.symm_apply_apply]
      rfl
    · rfl
  · apply sum_congr
    · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
    · intro e _
      split_ifs <;> rfl

end Bounty
end

section

/- Exact chronological recursion on original paths; continuations retain the full preceding event. -/

open Finset Classical

namespace Bounty

section Paths
variable {J K G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] {M : G → ℕ}
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
    (Δ D : ∀ k c, A k c → G → ℤ) (ω : ∀ k c, A k c → ℝ)
    (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)

noncomputable def fullMixedPathAbsIntegral (steps : List (Option (J ⊕ K)))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (F : FullPermutationMixedPath n S B A Δ D steps x → ℝ) : ℝ :=
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
    fullPermutationMixedEventFintype n S B A Δ D
  finiteEventPathIntegral (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D)
    (fun tag s e => |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V tag s e|)
    steps x F

noncomputable def fullMixedPathAbsContinuation (tag : Option (J ⊕ K))
    (steps : List (Option (J ⊕ K)))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (F : FullPermutationMixedPath n S B A Δ D (tag :: steps) x → ℝ)
    (e : FullPermutationMixedEvent n S B A Δ D tag x) : ℝ :=
  fullMixedPathAbsIntegral n S B A Δ D ω μ q ρ V steps
    (fullPermutationMixedEventTarget n S B A Δ D tag x e) (fun p => F ⟨e, p⟩)

theorem full_mixed_path_abs_integral_nil
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (F : FullPermutationMixedPath (J := J) n S B A Δ D [] x → ℝ) :
    fullMixedPathAbsIntegral n S B A Δ D ω μ q ρ V [] x F = F PUnit.unit := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
    fullPermutationMixedEventFintype n S B A Δ D
  exact finite_event_path_integral_nil _ _ _ _ _

theorem full_mixed_path_abs_integral_cons (tag : Option (J ⊕ K))
    (steps : List (Option (J ⊕ K)))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (F : FullPermutationMixedPath n S B A Δ D (tag :: steps) x → ℝ) :
    fullMixedPathAbsIntegral n S B A Δ D ω μ q ρ V (tag :: steps) x F =
      let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
    fullPermutationMixedEventFintype n S B A Δ D
      ∑ e : FullPermutationMixedEvent n S B A Δ D tag x,
        |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V tag x e| *
          fullMixedPathAbsContinuation n S B A Δ D ω μ q ρ V tag steps x F e := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
    fullPermutationMixedEventFintype n S B A Δ D
  exact finite_event_path_integral_cons _ _ _ _ _ _ _

theorem full_mixed_path_abs_integral_nonneg (steps : List (Option (J ⊕ K)))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (F : FullPermutationMixedPath n S B A Δ D steps x → ℝ) (hF : ∀ p, 0 ≤ F p) :
    0 ≤ fullMixedPathAbsIntegral n S B A Δ D ω μ q ρ V steps x F := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
    fullPermutationMixedEventFintype n S B A Δ D
  exact finite_event_path_integral_nonneg _ _ _ (fun _ _ _ => abs_nonneg _) _ _ _ hF

theorem full_mixed_path_abs_continuation_nonneg (tag : Option (J ⊕ K))
    (steps : List (Option (J ⊕ K)))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (F : FullPermutationMixedPath n S B A Δ D (tag :: steps) x → ℝ)
    (hF : ∀ p, 0 ≤ F p) (e : FullPermutationMixedEvent n S B A Δ D tag x) :
    0 ≤ fullMixedPathAbsContinuation n S B A Δ D ω μ q ρ V tag steps x F e :=
  full_mixed_path_abs_integral_nonneg n S B A Δ D ω μ q ρ V _ _ _ (fun p => hF ⟨e, p⟩)

theorem full_mixed_path_abs_ghost_skeleton (hμ : ∀ g p, 0 ≤ μ g p)
    (j : J) (steps : List (Option (J ⊕ K)))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (F : FullPermutationMixedPath n S B A Δ D (some (.inl j) :: steps) x → ℝ) :
    fullMixedPathAbsIntegral n S B A Δ D ω μ q ρ V (some (.inl j) :: steps) x F =
      ∑ sk : CoupledGhostSkeleton M B x, ∑ births : CoupledGhostSamples M B x sk,
        (coupledGhostSkeletonAbsMass (fun g => physicalGhostRetention (n g) (q j) ρ)
          (fun g => physicalGhostTermination (n g) (q j) ρ) M B x sk *
            ∏ i, physicalGhostBirthAtom (n i.1) (μ i.1) (q j) ρ (V i.1) (births i)) *
        fullMixedPathAbsContinuation n S B A Δ D ω μ q ρ V (some (.inl j)) steps x F
          ((fullPermutationGhostBirthEquiv n S B A Δ D x j).symm ⟨sk, births⟩) := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
    fullPermutationMixedEventFintype n S B A Δ D
  rw [full_mixed_path_abs_integral_cons]
  rw [← (fullPermutationGhostBirthEquiv n S B A Δ D x j).symm.sum_comp]
  rw [Fintype.sum_sigma]
  apply sum_congr rfl
  intro sk _
  apply sum_congr rfl
  intro births _
  rw [full_permutation_ghost_skeleton_weight,
    coupled_ghost_skeleton_weight_factor
      (fun g => physicalGhostRetention (n g) (q j) ρ)
      (fun g => physicalGhostTermination (n g) (q j) ρ)
      (fun g => physicalGhostBirth (n g) (q j) ρ (V g))
      (fun g => unrestrictedResidueWeight (μ g)) (fun g z => hμ g z.1)]
  rfl

theorem full_mixed_path_abs_edge_skeleton (hμ : ∀ g p, 0 ≤ μ g p)
    (k : K) (steps : List (Option (J ⊕ K)))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (F : FullPermutationMixedPath n S B A Δ D (some (.inr k) :: steps) x → ℝ) :
    fullMixedPathAbsIntegral n S B A Δ D ω μ q ρ V (some (.inr k) :: steps) x F =
      ∑ sk : FullActiveEdgeSkeleton n (S k) B (A k) (Δ k) (D k) x,
        ∑ fresh : FullActiveEdgeSamples n (S k) B (A k) (Δ k) (D k) x sk,
          (fullActiveEdgeSkeletonAbsMass n (S k) B (A k) (Δ k) (D k) (ω k) ρ V x sk *
            ∏ i, μ i.1 (fresh i)) *
          fullMixedPathAbsContinuation n S B A Δ D ω μ q ρ V (some (.inr k)) steps x F
            ((fullPermutationEdgeBirthEquiv n S B A Δ D x k).symm ⟨sk, fresh⟩) := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
    fullPermutationMixedEventFintype n S B A Δ D
  rw [full_mixed_path_abs_integral_cons]
  rw [← (fullPermutationEdgeBirthEquiv n S B A Δ D x k).symm.sum_comp]
  rw [Fintype.sum_sigma]
  apply sum_congr rfl
  intro sk _
  apply sum_congr rfl
  intro fresh _
  rw [full_permutation_edge_skeleton_weight, full_active_edge_skeleton_weight_factor]
  exact hμ

end Paths

end Bounty
end

section

/- A uniform avoidance lower bound absorbs the normalized polynomial remainder. -/

open Finset Filter

namespace Bounty

theorem eventually_power_four_le_avoidance_square {θ : ℝ} (hθ : 0 < θ) :
    ∀ᶠ L : ℝ in atTop, ∀ W : ℝ, 1 ≤ W → W ≤ Real.exp (θ*L) →
      L^(-(4 : ℝ)) ≤ (∏ p ∈ primeBand 0 W, (1-1/(p : ℝ)))^2 := by
  let C := (2*primeEulerProductUpperConstant)*(1+θ)
  have hC : 0 < C := by dsimp [C]; positivity [primeEulerProductUpperConstant_pos]
  filter_upwards [eventually_ge_atTop (1 : ℝ), eventually_ge_atTop (Real.log 2),
    eventually_ge_atTop C] with L hL hlog hCL
  intro W hW hWup
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hP : ∀ p ∈ primeBand 0 W, p.Prime := fun p hp => (mem_filter.mp hp).2
  have hV := finite_prime_avoidance_product_lower (primeBand 0 W) hP hW
    (fun p hp => ((mem_primeBand_iff le_rfl (zero_le_one.trans hW) p).mp hp).2.2)
  have hden : 0 < (2*primeEulerProductUpperConstant)*Real.log (2*W) := by
    apply mul_pos (by positivity [primeEulerProductUpperConstant_pos])
    apply Real.log_pos
    linarith
  have hlogW : Real.log W ≤ θ*L := by
    simpa only [Real.log_exp] using Real.log_le_log (zero_lt_one.trans_le hW) hWup
  have hd : (2*primeEulerProductUpperConstant)*Real.log (2*W) ≤ L^2 := by
    have hlogprod : Real.log (2*W) ≤ (1+θ)*L := by
      rw [Real.log_mul (by norm_num) (zero_lt_one.trans_le hW).ne']
      nlinarith
    calc
      _ ≤ (2*primeEulerProductUpperConstant)*((1+θ)*L) :=
        mul_le_mul_of_nonneg_left hlogprod (by positivity [primeEulerProductUpperConstant_pos])
      _ = C*L := by dsimp [C]; ring
      _ ≤ L*L := mul_le_mul_of_nonneg_right hCL hL0.le
      _ = L^2 := by ring
  have hsmall : 1/L^2 ≤ ∏ p ∈ primeBand 0 W, (1-1/(p : ℝ)) :=
    (div_le_div_of_nonneg_left zero_le_one hden hd).trans hV
  have hsquare := pow_le_pow_left₀ (by positivity : 0 ≤ 1/L^2) hsmall 2
  have heq : L^(-(4 : ℝ)) = (1/L^2)^2 := by
    rw [Real.rpow_neg hL0.le]
    norm_num [Real.rpow_natCast]
    ring
  rw [heq]
  exact hsquare

end Bounty
end

section

/- Elementary uniform upper bounds for primes in the actual logarithmic cells. -/

open Finset Filter

namespace Bounty

theorem prime_band_subset_rough_band {A B z : ℝ} (hzA : z ≤ A) :
    primeBand A B ⊆ roughBand A B z := by
  intro p hp
  obtain ⟨hpI, hpprime⟩ := mem_filter.mp hp
  apply mem_filter.mpr
  refine ⟨hpI, ?_⟩
  intro q hq
  rw [hpprime.primeFactors] at hq
  have hqp := mem_singleton.mp hq
  subst q
  have hAp : A < (p : ℝ) := Nat.lt_of_floor_lt (mem_Ioc.mp hpI).1
  exact hzA.trans_lt hAp

theorem exists_prime_logarithmic_cell_upper {a : ℝ} (ha : 0 < a) :
    ∃ C : ℝ, 0 < C ∧ ∀ S : ℝ, ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ,
      Real.exp (a*L) ≤ Y →
      ((primeBand Y (Real.exp (L^(-S))*Y)).card : ℝ) ≤
        C*(Real.exp (L^(-S))*Y-Y)/L := by
  obtain ⟨K, hK, hcount⟩ := exists_real_rough_integer_interval_count
  refine ⟨40*(K+1)/a+1, by positivity, ?_⟩
  intro S
  have hb : 0 < 3*a/4 := by positivity
  filter_upwards [eventually_linear_exponential_profile_le_rpow hb hb K 0 (S+1),
    eventually_gt_atTop (0 : ℝ)] with L hprofile hL
  intro Y hY
  let len := Real.exp (L^(-S))*Y-Y
  let z := Real.exp ((a/40)*L)
  let V := ∏ p ∈ primeBand 0 z, (1-1/(p : ℝ))
  have hY0 : 0 < Y := (Real.exp_pos _).trans_le hY
  have hlen : 0 ≤ len := by
    have h := logarithmic_cell_length_lower (L := L) hY0.le S
    have hp : 0 ≤ Y*L^(-S) := by positivity
    exact hp.trans h
  have hz : 1 < z := Real.one_lt_exp_iff.mpr (by positivity)
  have hzY : z ≤ Y := by
    apply le_trans _ hY
    apply Real.exp_le_exp.mpr
    nlinarith
  have hV0 : 0 ≤ V := (finite_prime_avoidance_product_pos _ (fun _ hp => (mem_filter.mp hp).2)).le
  have hVz : V ≤ 1/((a/40)*L) := full_prime_avoidance_exp_upper (by positivity)
  have hbase := hcount hY0.le (show Y ≤ Real.exp (L^(-S))*Y by linarith)
    hz (show 1 ≤ 2 by omega) (show Even 2 by decide)
  change |((roughBand Y (Real.exp (L^(-S))*Y) z).card : ℝ)-len*V| ≤
    K*(len*V*Real.exp (-2)+z^(4*(2 : ℝ)+2)) at hbase
  rw [show 4*(2 : ℝ)+2 = 10 by norm_num] at hbase
  have he2 : Real.exp (-2) ≤ 1 := Real.exp_le_one_iff.mpr (by norm_num)
  have hrough : ((roughBand Y (Real.exp (L^(-S))*Y) z).card : ℝ) ≤
      (K+1)*len*V+K*z^(10 : ℝ) := by
    have hh := (abs_le.mp hbase).2
    have he := mul_le_mul_of_nonneg_left he2 (mul_nonneg hlen hV0)
    nlinarith
  have hz10 : z^(10 : ℝ) = Real.exp ((a/4)*L) := by
    dsimp [z]
    rw [← Real.exp_mul]
    congr 1
    ring
  have herror : K*z^(10 : ℝ) ≤ len/L := by
    simp only [zero_mul, add_zero] at hprofile
    have hm := mul_le_mul_of_nonneg_left hprofile (Real.exp_pos (a*L)).le
    have heq : Real.exp (a*L)*(K*Real.exp (-(3*a/4)*L)) = K*Real.exp ((a/4)*L) := by
      calc
        _ = K*Real.exp (a*L+(-(3*a/4)*L)) := by rw [Real.exp_add]; ring
        _ = _ := by congr 2; ring
    rw [heq] at hm
    rw [hz10]
    apply hm.trans
    calc
      _ ≤ Y*L^(-(S+1)) := mul_le_mul_of_nonneg_right hY (by positivity)
      _ = (Y*L^(-S))/L := by
        rw [show -(S+1) = -S+(-1) by ring, Real.rpow_add hL, Real.rpow_neg_one]
        ring
      _ ≤ len/L := div_le_div_of_nonneg_right (logarithmic_cell_length_lower hY0.le S) hL.le
  have hmain := mul_le_mul_of_nonneg_left hVz (show 0 ≤ (K+1)*len by positivity)
  have hcard : ((primeBand Y (Real.exp (L^(-S))*Y)).card : ℝ) ≤
      ((roughBand Y (Real.exp (L^(-S))*Y) z).card : ℝ) :=
    Nat.cast_le.mpr (card_le_card (prime_band_subset_rough_band hzY))
  calc
    _ ≤ (K+1)*len*V+K*z^(10 : ℝ) := hcard.trans hrough
    _ ≤ (K+1)*len*(1/((a/40)*L))+len/L := add_le_add hmain herror
    _ = _ := by dsimp [len]; field_simp

end Bounty
end

section

/- Arbitrary power cancellation for rough integers with the actual harmonic Mellin twist. -/

open Finset Filter

namespace Bounty

theorem eventually_rough_interval_mellin_power_bound {a T : ℝ} (ha : 0 < a)
    (hT : 0 ≤ T) (Bsave : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, Real.exp (a*L) ≤ Y →
      ∀ (r : ℕ) [NeZero r] (χ : DirichletCharacter ℂ r), χ ≠ 1 → (r : ℝ) ≤ L^T →
      ∀ v : ℝ, |v| ≤ L^T → ∀ m n : ℕ, m ≤ n → Y ≤ (m+1 : ℕ) → (n : ℝ) ≤ 2*Y →
        ‖∑ i ∈ (Ioc m n).filter (fun i : ℕ =>
          ∀ p ∈ i.primeFactors, Real.exp (Real.sqrt L) < (p : ℝ)),
            harmonicMellinWeight v i*χ (i : ZMod r)‖ ≤ L^(-Bsave) := by
  filter_upwards [eventually_rough_interval_character_power_bound ha T (Bsave+T+1),
    eventually_ge_atTop (5 : ℝ)] with L hraw hL5
  intro Y hY r hr χ hχ hrT v hv m n hmn hYm hn
  have hL : 0 < L := by linarith
  have hY0 : 0 < Y := (Real.exp_pos _).trans_le hY
  by_cases heq : m = n
  · subst n
    simp only [Ioc_self, filter_empty, sum_empty, norm_zero]
    positivity
  have hmn' : m < n := lt_of_le_of_ne hmn heq
  let g := fun i : ℕ => if (∀ p ∈ i.primeFactors, Real.exp (Real.sqrt L) < (p : ℝ))
    then χ (i : ZMod r) else 0
  have hprefix : ∀ i ∈ Icc m n,
      ‖∑ j ∈ Ioc m i, g j‖ ≤ Y*L^(-(Bsave+T+1)) := by
    intro i hi
    have hh := hraw Y hY r χ hχ hrT m i (mem_Icc.mp hi).1
      ((Nat.cast_le.mpr (mem_Icc.mp hi).2).trans hn)
    simpa only [sum_filter, g] using hh
  have hh := norm_harmonic_mellin_interval_sum_le g hY0 hmn' hYm hn
    (v := v) (B := Y*L^(-(Bsave+T+1))) (by positivity) hprefix
  have hpow : 1 ≤ L^T := Real.one_le_rpow (by linarith) hT
  have hgain : 3+2*|v| ≤ L^(T+1) := by
    calc
      _ ≤ 5*L^T := by nlinarith
      _ ≤ L*L^T := mul_le_mul_of_nonneg_right hL5 (by positivity)
      _ = _ := by rw [Real.rpow_add hL, Real.rpow_one]; ring
  calc
    _ = ‖∑ i ∈ Ioc m n, harmonicMellinWeight v i*g i‖ := by
      simp only [sum_filter, g, mul_ite, mul_zero]
    _ ≤ ((3+2*|v|)/Y)*(Y*L^(-(Bsave+T+1))) := hh
    _ = (3+2*|v|)*L^(-(Bsave+T+1)) := by field_simp
    _ ≤ L^(T+1)*L^(-(Bsave+T+1)) := mul_le_mul_of_nonneg_right hgain (by positivity)
    _ = L^(-Bsave) := by
      rw [← Real.rpow_add hL]
      congr 1
      ring

end Bounty
end

section

/- Prime harmonic Mellin cancellation, with the original zero-free hypothesis explicit. -/

open Finset Filter

namespace Bounty

theorem eventually_prime_interval_mellin_power_bound (hZ : PrimitiveZeroFreeHalfPlane)
    {a T : ℝ} (ha : 0 < a) (hT : 0 ≤ T) (Bsave : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, Real.exp (a*L) ≤ Y →
      ∀ (r : ℕ), 0 < r → (r : ℝ) ≤ L^T →
      ∀ χ : DirichletCharacter ℂ r, χ ≠ 1 →
      ∀ v : ℝ, |v| ≤ L^T → ∀ m n : ℕ, m ≤ n → Y ≤ (m+1 : ℕ) → (n : ℝ) ≤ 2*Y →
        ‖∑ i ∈ (Ioc m n).filter Nat.Prime, harmonicMellinWeight v i*χ (i : ZMod r)‖ ≤
          L^(-Bsave) := by
  have ha2 : 0 < a/2 := by positivity
  filter_upwards [eventually_prime_band_coprime_relative_power_bound hZ ha2 (Bsave+T+1),
    eventually_rpow_le_exp_sqrt T, eventually_ge_atTop (10 : ℝ)] with L hraw hmod hL10
  intro Y hY r hr hrT χ hχ v hv m n hmn hYm hn
  have hL : 0 < L := by linarith
  have hY0 : 0 < Y := (Real.exp_pos _).trans_le hY
  have hrL : (r : ℝ) ≤ Real.exp L := hrT.trans (hmod.trans
    (Real.exp_le_exp.mpr (Real.sqrt_le_self_iff.mpr (Or.inr (by linarith)))))
  have hexp : Real.exp ((a/2)*L) < Y := by
    apply lt_of_lt_of_le _ hY
    exact Real.exp_lt_exp.mpr (by nlinarith)
  by_cases heq : m = n
  · subst n
    simp only [Ioc_self, filter_empty, sum_empty, norm_zero]
    positivity
  have hmn' : m < n := lt_of_le_of_ne hmn heq
  let g := fun i : ℕ => if i.Prime then χ (i : ZMod r) else 0
  have hprefix : ∀ i ∈ Icc m n,
      ‖∑ j ∈ Ioc m i, g j‖ ≤ 2*Y*L^(-(Bsave+T+1)) := by
    intro i hi
    have hb := hraw r hr hrL χ hχ (i : ℝ) 1 (m : ℝ) (i : ℝ)
      (Nat.cast_nonneg _) zero_lt_one (Nat.cast_nonneg _) (Nat.cast_nonneg _)
      1 (by omega) (by simpa only [Nat.cast_one] using Real.one_le_exp hL.le)
    have hset : ((primeBand (Real.exp ((a/2)*L)) (i : ℝ)).filter
        (fun p : ℕ => (m : ℝ) < 1*(p : ℝ) ∧ 1*(p : ℝ) ≤ i)).filter
        (fun p => p.Coprime 1) = (Ioc m i).filter Nat.Prime := by
      ext p
      simp only [mem_filter, mem_primeBand_iff (Real.exp_pos _).le (Nat.cast_nonneg i),
        one_mul, Nat.coprime_one_right_iff, and_true, mem_Ioc, Nat.cast_lt, Nat.cast_le]
      constructor
      · intro hp
        exact ⟨hp.2, hp.1.1⟩
      · intro hp
        have hpY : Y ≤ (p : ℝ) := hYm.trans (Nat.cast_le.mpr hp.1.1)
        exact ⟨⟨hp.2, hexp.trans_le hpY, hp.1.2⟩, hp.1⟩
    rw [hset, div_one] at hb
    have hiY : (i : ℝ) ≤ 2*Y := (Nat.cast_le.mpr (mem_Icc.mp hi).2).trans hn
    have hb' := hb.trans (mul_le_mul_of_nonneg_right hiY (by positivity))
    simpa only [g, sum_filter] using hb'
  have hh := norm_harmonic_mellin_interval_sum_le g hY0 hmn' hYm hn
    (v := v) (B := 2*Y*L^(-(Bsave+T+1))) (by positivity) hprefix
  have hpow : 1 ≤ L^T := Real.one_le_rpow (by linarith) hT
  have hgain : 2*(3+2*|v|) ≤ L^(T+1) := by
    calc
      _ ≤ 10*L^T := by nlinarith
      _ ≤ L*L^T := mul_le_mul_of_nonneg_right hL10 (by positivity)
      _ = _ := by rw [Real.rpow_add hL, Real.rpow_one]; ring
  calc
    _ = ‖∑ i ∈ Ioc m n, harmonicMellinWeight v i*g i‖ := by
      simp only [sum_filter, g, mul_ite, mul_zero]
    _ ≤ ((3+2*|v|)/Y)*(2*Y*L^(-(Bsave+T+1))) := hh
    _ = (2*(3+2*|v|))*L^(-(Bsave+T+1)) := by field_simp
    _ ≤ L^(T+1)*L^(-(Bsave+T+1)) := mul_le_mul_of_nonneg_right hgain (by positivity)
    _ = L^(-Bsave) := by
      rw [← Real.rpow_add hL]
      congr 1
      ring

end Bounty
end

section

/- Forest ties in a fixed original coupled-ghost skeleton, with the full target continuation retained. -/

open Finset Classical

namespace Bounty

theorem coupled_ghost_forest_continuation_le
    {G : Type*} [Fintype G] [DecidableEq G] {P : G → Type*}
    [∀ g, Fintype (P g)] [∀ g, DecidableEq (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (μ : ∀ g, P g → ℝ) (q ρ : ℝ) (V : G → ℝ)
    (t : G → ℕ) (B : ℕ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B)
    (sk : CoupledGhostSkeleton t B s) {m : ℕ}
    (ord : Fin m ≃ CoupledGhostSampleIndex t B s sk)
    (code : BirthForestCode m) (anchor : Fin m → Option (Sigma P))
    (η : G → ℝ) (hη : ∀ g, 0 ≤ η g) (hμ : ∀ g p, 0 ≤ μ g p)
    (hμatom : ∀ g p, μ g p ≤ η g)
    (v L : ℝ) (hv : 0 ≤ v) (hL : 0 ≤ L)
    (F : CoupledGhostSamples t B s sk → ℝ)
    (hF : ∀ births, F births ≤ L * productLengthLyapunov v
      (coupledGhostJointEventTarget t B s ((coupledGhostSkeletonEquiv t B s).symm ⟨sk, births⟩))) :
    (∑ births : CoupledGhostSamples t B s sk,
      if birthForestEqualValues code (fun j => (⟨(ord j).1, (births (ord j)).1⟩ : Sigma P)) ∧
          birthLabelsAnchored anchor (fun j => (⟨(ord j).1, (births (ord j)).1⟩ : Sigma P)) then
        |coupledGhostJointEventWeight
          (fun g => physicalGhostRetention (n g) q ρ)
          (fun g => physicalGhostTermination (n g) q ρ)
          (fun g => physicalGhostBirth (n g) q ρ (V g))
          (fun g => unrestrictedResidueWeight (μ g)) t B s
          ((coupledGhostSkeletonEquiv t B s).symm ⟨sk, births⟩)| * F births
      else 0) ≤
    coupledGhostSkeletonAbsMass
      (fun g => physicalGhostRetention (n g) q ρ)
      (fun g => physicalGhostTermination (n g) q ρ) t B s sk *
      (L * v ^ (∑ g, boundedGhostSkeletonOutputCount (t g) B (s g) (sk g).1 (sk g).2)) *
      ∏ j, match code j with
        | some _ => |(1 - q) * V (ord j).1 / ρ| * η (ord j).1
        | none => match anchor j with
          | none => |(1 - q) * V (ord j).1 / ρ| * ∑ p, μ (ord j).1 p
          | some _ => |(1 - q) * V (ord j).1 / ρ| * η (ord j).1 := by
  have hb := labeled_anchored_forest_continuation_le
    (fun i : CoupledGhostSampleIndex t B s sk => UnrestrictedResidueParticle (n i.1)) ord
    (fun i z => (⟨i.1, z.1⟩ : Sigma P))
    (fun i => physicalGhostBirthAtom (n i.1) (μ i.1) q ρ (V i.1)) code anchor
    (fun i => |(1 - q) * V i.1 / ρ| * ∑ p, μ i.1 p)
    (fun i => |(1 - q) * V i.1 / ρ| * η i.1)
    (fun i => mul_nonneg (abs_nonneg _) (sum_nonneg fun p _ => hμ i.1 p))
    (fun i => mul_nonneg (abs_nonneg _) (hη i.1))
    (fun i => physical_ghost_birth_atom_nonneg _ _ _ _ _ (hμ i.1))
    (fun i => (physical_ghost_birth_atom_total (n i.1) (μ i.1) q ρ (V i.1)).le)
    (fun i => finiteLabelMass_tagged_ghost_le i.1 (n i.1) (μ i.1) q ρ (V i.1) (hη i.1) (hμatom i.1))
    F (coupledGhostSkeletonAbsMass
      (fun g => physicalGhostRetention (n g) q ρ)
      (fun g => physicalGhostTermination (n g) q ρ) t B s sk)
    (L * v ^ (∑ g, boundedGhostSkeletonOutputCount (t g) B (s g) (sk g).1 (sk g).2))
    (coupled_ghost_skeleton_abs_mass_nonneg _ _ _ _ _ _)
    (mul_nonneg hL (pow_nonneg hv _))
    (fun births => by simpa only [productLengthLyapunov_ghost_skeleton] using hF births)
  refine le_trans ?_ (le_trans hb ?_)
  · apply le_of_eq
    apply sum_congr rfl
    intro births _
    split_ifs
    · rw [coupled_ghost_skeleton_weight_factor
        (fun g => physicalGhostRetention (n g) q ρ)
        (fun g => physicalGhostTermination (n g) q ρ)
        (fun g => physicalGhostBirth (n g) q ρ (V g))
        (fun g => unrestrictedResidueWeight (μ g))
        (fun g (z : UnrestrictedResidueParticle (n g)) => hμ g z.1) t B s sk births]
      rfl
    · rfl
  · apply le_of_eq
    congr 1
    apply prod_congr rfl
    intro j _
    cases code j <;> cases anchor j <;> rfl

end Bounty
end

