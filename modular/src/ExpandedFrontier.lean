theorem unrestricted_bounded_one_symmetric {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (Δ D : ℤ) (μ : P → ℝ) (ρ V : ℝ)
    (t B : ℕ) (f : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
    (hf : BoundedOrderedSymmetric f) :
    BoundedOrderedSymmetric
      (unrestrictedBoundedOperator n Δ D μ ρ V t B (fun _ _ _ _ _ => 1) f) := by
  intro active N q τ
  exact unrestricted_residue_edge_one_symmetric n Δ D active μ ρ V B
    (boundedOrderedZeroExtension f) ((boundedOrderedZeroExtension_symmetric_iff f).mpr hf)
    N.val q τ

theorem unrestricted_positive_product_symmetric
    {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (Δ D : G → ℤ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (t : G → ℕ) (B : ℕ) (groups : Finset G)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric
      (unrestrictedProductOperator n Δ D μ ρ V t B (fun _ _ _ _ _ _ => 1) groups f) := by
  exact product_memory_finset_symmetric
    (fun g => unrestrictedBoundedOperator (n g) (Δ g) (D g) (μ g) ρ (V g) (t g) B
      (fun _ _ _ _ _ => 1))
    (fun g q hq => unrestricted_bounded_one_symmetric (n g) (Δ g) (D g) (μ g) ρ (V g)
      (t g) B q hq) groups f hf

theorem unrestricted_positive_cutoff_product_symmetric
    {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (Δ D : G → ℤ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (t : G → ℕ) (B : ℕ) (groups : Finset G)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric
      (unrestrictedCutoffProductOperator n Δ D μ ρ V t B (fun _ _ _ _ _ _ => 1) groups f) := by
  exact productMemoryCutoff_symmetric _
    (unrestricted_positive_product_symmetric n Δ D μ ρ V t B groups
      (productMemoryCutoff f) (productMemoryCutoff_symmetric f hf))
end

section
open Finset Classical
/-- The real part of a nonnegative event sum is monotone in the real part
of its input, even when the input itself is complex. -/
theorem finite_product_event_re_mono {I : Type*} [Fintype I]
    {X : I → Type*} (E : ∀ i, X i → Type*) [∀ i x, Fintype (E i x)]
    (weight : ∀ i x, E i x → ℝ) (target : ∀ i x, E i x → X i)
    (hweight : ∀ i x e, 0 ≤ weight i x e)
    (f g : (∀ i, X i) → ℂ) (hfg : ∀ x, (f x).re ≤ (g x).re)
    (x : ∀ i, X i) :
    (finiteProductEventAction E weight target (fun _ _ => 1) f x).re ≤
      (finiteProductEventAction E weight target (fun _ _ => 1) g x).re := by
  simp only [finiteProductEventAction, mul_one, Complex.re_sum,
    Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero]
  apply sum_le_sum
  intro e _
  exact mul_le_mul_of_nonneg_left (hfg _) (prod_nonneg fun i _ => hweight i _ _)

theorem finite_operator_list_re_mono {E X : Type*}
    (A : E → (X → ℂ) → X → ℂ)
    (hA : ∀ e f g, (∀ x, (f x).re ≤ (g x).re) →
      ∀ x, (A e f x).re ≤ (A e g x).re)
    (es : List E) (f g : X → ℂ) (hfg : ∀ x, (f x).re ≤ (g x).re) :
    ∀ x, (finiteOperatorListAction A es f x).re ≤
      (finiteOperatorListAction A es g x).re := by
  induction es with
  | nil => exact hfg
  | cons e es ih => exact hA e _ _ ih

/-- The comparison is with the positive operator list throughout. No
symmetry or other invariant property of intermediate phased outputs is used. -/
theorem finite_operator_list_norm_le_envelope {E X : Type*}
    (T A : E → (X → ℂ) → X → ℂ)
    (hA : ∀ e f g, (∀ x, (f x).re ≤ (g x).re) →
      ∀ x, (A e f x).re ≤ (A e g x).re)
    (hT : ∀ e f x, ‖T e f x‖ ≤ (A e (complexNormEnvelope f) x).re)
    (es : List E) (f : X → ℂ) :
    ∀ x, ‖finiteOperatorListAction T es f x‖ ≤
      (finiteOperatorListAction A es (complexNormEnvelope f) x).re := by
  induction es with
  | nil => intro x; exact le_rfl
  | cons e es ih =>
    intro x
    exact (hT e _ x).trans (hA e _ _ ih x)

theorem finite_operator_list_energy_le_of_envelope {E X : Type*} [Fintype X]
    (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x)
    (T A : E → (X → ℂ) → X → ℂ)
    (hA : ∀ e f g, (∀ x, (f x).re ≤ (g x).re) →
      ∀ x, (A e f x).re ≤ (A e g x).re)
    (hT : ∀ e f x, ‖T e f x‖ ≤ (A e (complexNormEnvelope f) x).re)
    (es : List E) (f : X → ℂ) (C : ℝ)
    (hbound : finiteWeightedEnergy μ
        (finiteOperatorListAction A es (complexNormEnvelope f)) ≤
      C * finiteWeightedEnergy μ (complexNormEnvelope f)) :
    finiteWeightedEnergy μ (finiteOperatorListAction T es f) ≤
      C * finiteWeightedEnergy μ f := by
  apply finiteWeightedEnergy_le_of_envelope_domination μ hμ f
    (finiteOperatorListAction T es f) (finiteOperatorListAction A es) C
  · intro x
    exact (finite_operator_list_norm_le_envelope T A hA hT es f x).trans
      (Complex.re_le_norm _)
  · exact hbound

/-- Energy bounds on an invariant class of the positive operators transfer
to arbitrary phased iterates whose initial norm envelope lies in that class. -/
theorem finite_operator_list_energy_le_of_positive_class {E X : Type*} [Fintype X]
    (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (S : (X → ℂ) → Prop)
    (T A : E → (X → ℂ) → X → ℂ)
    (hAmono : ∀ e f g, (∀ x, (f x).re ≤ (g x).re) →
      ∀ x, (A e f x).re ≤ (A e g x).re)
    (hT : ∀ e f x, ‖T e f x‖ ≤ (A e (complexNormEnvelope f) x).re)
    (hS : ∀ e f, S f → S (A e f))
    (C : E → ℝ) (hC : ∀ e, 0 ≤ C e)
    (henergy : ∀ e f, S f → finiteWeightedEnergy μ (A e f) ≤ C e * finiteWeightedEnergy μ f)
    (es : List E) (f : X → ℂ) (hf : S (complexNormEnvelope f)) :
    finiteWeightedEnergy μ (finiteOperatorListAction T es f) ≤
      (es.map C).prod * finiteWeightedEnergy μ f := by
  apply finite_operator_list_energy_le_of_envelope μ hμ T A hAmono hT es f
  exact finite_operator_list_energy_le μ S A hS C hC henergy es (complexNormEnvelope f) hf
end

