theorem physical_root_moment_eq_effective_path_sum
    [Fintype (PhysicalSelectedData (fun g => P (e.symm g).val) ell
      (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val))]
    (hq : 0 ≤ q) (cut : ℕ → Fin M → Finset (Fin J))
    (hencode : ∀ i, PhysicalMarkRowEncoding
      (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val)
