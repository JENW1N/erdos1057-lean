/- Literal endpoint phases agree with the coefficient convention used by the integral theorem. -/

open Finset

namespace Bounty

theorem character_typeIIPhase_norm_le {q : ℕ} (χ : DirichletCharacter ℂ q)
    (τ : ℝ) (n : ℕ) : ‖χ (n : ZMod q)*typeIIPhase τ n‖ ≤ 1 := by
  rw [norm_mul,typeIIPhase_norm,mul_one]
  exact χ.norm_le_one _

theorem typeIIPhase_harmonic_mellin_shift (σ u : ℝ) (n : ℕ) :
    typeIIPhase σ n*harmonicMellinWeight u n = harmonicMellinWeight (u+σ) n := by
  unfold typeIIPhase harmonicMellinWeight
  rw [← mul_div_assoc,← Complex.exp_add]
  congr 2
  push_cast
  ring

theorem ambient_rough_original_phase_coefficient (γ L S a v ν : ℝ)
    {q : ℕ} (χ : DirichletCharacter ℂ q) {n : ℕ} (hn : 0 < n) :
    (ambientRoughIntervalTypeIIAlpha γ L S a v n : ℂ)*χ (n : ZMod q)*typeIIPhase ν n =
      ambientRoughMellinCoefficient γ L S a v ν χ n := by
  rw [typeIIPhase_eq_cpow ν hn]
  rfl

theorem ambient_prime_original_phase_coefficient (κ L S ν : ℝ)
    {q : ℕ} (χ : DirichletCharacter ℂ q) {n : ℕ} (hn : 0 < n) :
    (ambientPrimeTypeIIAlpha κ L S n : ℂ)*χ (n : ZMod q)*typeIIPhase ν n =
      ambientPrimeMellinCoefficient κ L S ν χ n := by
  rw [typeIIPhase_eq_cpow ν hn]
  rfl

