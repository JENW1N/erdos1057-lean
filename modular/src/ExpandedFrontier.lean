open Finset Filter
open scoped Topology
noncomputable def candidateCoefficient (c L q : ℝ) (r jStar u : ℕ) : ℝ :=
  candidateQWeight c L r jStar
    (primePoolFreePart ((candidatePIndices c L).biUnion (candidatePBand (c * L))) u) *
  markedDivisorWeight (candidatePIndices c L) (candidatePBand (c * L)) q
    (fun j => ∑ p ∈ candidatePBand (c * L) j, 1 / (p : ℝ)) (fun _ => 1) (u : ℤ)

theorem candidate_coefficient_nonneg (c L : ℝ) {q : ℝ} (hq : 0 ≤ q)
    (r jStar u : ℕ) : 0 ≤ candidateCoefficient c L q r jStar u := by
  apply mul_nonneg (candidate_Q_weight_nonneg _ _ _ _ _)
  exact marked_divisor_weight_nonneg _ _ hq _ _
    (fun _ _ => sum_nonneg (fun _ _ => by positivity)) _

theorem candidate_marked_weight_mul_of_free (c L q : ℝ) {n : ℕ} (hn : n ≠ 0)
    (hfree : Disjoint n.primeFactors ((candidatePIndices c L).biUnion (candidatePBand (c * L))))
    (p : ℕ) :
    markedDivisorWeight (candidatePIndices c L) (candidatePBand (c * L)) q
      (fun j => ∑ a ∈ candidatePBand (c * L) j, 1 / (a : ℝ)) (fun _ => 1) ((p * n : ℕ) : ℤ) =
    markedDivisorWeight (candidatePIndices c L) (candidatePBand (c * L)) q
      (fun j => ∑ a ∈ candidatePBand (c * L) j, 1 / (a : ℝ)) (fun _ => 1) (p : ℤ) := by
  apply marked_divisor_weight_mul_disjoint _ _ q _ _
    (fun _ _ _ hp => (mem_filter.mp hp).2) (Q := n.primeFactors)
  · intro j hj
    exact hfree.symm.mono (fun _ hp => mem_biUnion.mpr ⟨j, hj, hp⟩) (subset_refl _)
  · exact Nat.mem_factoredNumbers_of_primeFactors_subset hn (subset_refl _)

theorem candidate_coefficient_mul_of_free (c L q : ℝ) (r jStar : ℕ) {p n : ℕ}
    (hp : p ∈ Nat.factoredNumbers ((candidatePIndices c L).biUnion (candidatePBand (c * L))))
    (hn : n ≠ 0)
    (hfree : Disjoint n.primeFactors ((candidatePIndices c L).biUnion (candidatePBand (c * L)))) :
    candidateCoefficient c L q r jStar (p * n) =
      candidatePWeight c L q p * candidateQWeight c L r jStar n := by
  unfold candidateCoefficient
  rw [primePoolFreePart_mul_of_free hp hn hfree,
    candidate_marked_weight_mul_of_free c L q hn hfree p,
    candidate_P_weight_eq_marked c L q (Nat.ne_zero_of_mem_factoredNumbers hp)]
  exact mul_comm _ _

theorem eventually_candidate_coefficient_product_formula {c : ℝ} (hc : 0 < c)
    (q : ℝ) (r : ℕ) :
    ∀ᶠ L : ℝ in atTop, ∀ jStar p n : ℕ,
      p ∈ Nat.factoredNumbers ((candidatePIndices c L).biUnion (candidatePBand (c * L))) →
      candidateQWeight c L r jStar n ≠ 0 →
      candidateCoefficient c L q r jStar (p * n) =
        candidatePWeight c L q p * candidateQWeight c L r jStar n := by
  filter_upwards [eventually_candidate_Q_weight_free_support hc r] with L hL
  intro jStar p n hp hn
  exact candidate_coefficient_mul_of_free c L q r jStar hp (hL jStar n hn).1 (hL jStar n hn).2
end

section
open Finset
open scoped Classical
/-- The complete signed phase trace, with its actual initial and terminal
factors, equals the globally filtered raw history with the initial active
beta product. No further factorial or state-space normalization occurs. -/
theorem global_birth_weighted_empty_history_trace {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    (a : ℕ → P → Bool)
    (steps : ∀ i, GlobalBirthRawStep (R := R) (a i) (a (i + 1))) (β : P → ℝ) (n : ℕ) :
    ((∏ p, if a 0 p then β p else 1 : ℝ) : ℂ) *
        globalBirthRawHistory a steps n (fun _ q => if q.1 = 0 then 1 else 0)
          (ghostPhaseActivitySupport (a 0)) (globalBirthEmptyMemory (R := R)) =
      ∑ x : Fin (n + 1) → (p : P) → GhostPhaseState (R p),
        ((∏ p, ghostPhaseTerminal (a n p) (x (Fin.last n) p) : ℝ) : ℂ) *
          finiteChronologicalPrefix (globalBirthHistoryKernel a steps)
            (fun w => ((∏ p, ghostPhaseInitial (a 0 p) (β p) (w p) : ℝ) : ℂ)) n x := by
  rw [← global_birth_initial_terminal_pairing a steps β n]
  exact global_birth_phase_history_trace_pairing a steps _ _ n

/-- Expanded chronological product form, exposing every visit/edge kernel
and both endpoint tensors in the same finite history sum. -/
theorem global_birth_weighted_empty_history_product {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    (a : ℕ → P → Bool)
    (steps : ∀ i, GlobalBirthRawStep (R := R) (a i) (a (i + 1))) (β : P → ℝ) (n : ℕ) :
    ((∏ p, if a 0 p then β p else 1 : ℝ) : ℂ) *
        globalBirthRawHistory a steps n (fun _ q => if q.1 = 0 then 1 else 0)
          (ghostPhaseActivitySupport (a 0)) (globalBirthEmptyMemory (R := R)) =
      ∑ x : Fin (n + 1) → (p : P) → GhostPhaseState (R p),
        ((∏ p, ghostPhaseTerminal (a n p) (x (Fin.last n) p) : ℝ) : ℂ) *
          (((∏ p, ghostPhaseInitial (a 0 p) (β p) (x 0 p) : ℝ) : ℂ) *
            ∏ j : Fin n, globalBirthRawStepKernel (steps j.val) (x j.succ) (x j.castSucc)) := by
  exact global_birth_weighted_empty_history_trace a steps β n
end

