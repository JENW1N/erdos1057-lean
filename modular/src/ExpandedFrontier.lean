/- Restore the full original ledger path action before splitting its forest ranks. -/

open Finset Classical
namespace Bounty
section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
  [∀ g, DecidableEq (P g)] (n : (g : Fin N) → P g → ℕ) [∀ g p, NeZero (n g p)]
  {M : Fin N → ℕ} (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
  (Δ D : ∀ k c, A k c → Fin N → ℤ)
  (edgePhase : ∀ k, ((g : Fin N) → Finset (P g)) →
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) →
    FullActiveEdgeEvent n (S k) B (A k) (Δ k) (D k) x → ℂ)
  (ω : ∀ k c, A k c → ℝ) (μ : (g : Fin N) → P g → ℝ)
  (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ) (steps : List (Option (J ⊕ K)))
  (initial : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B →
    (g : Fin N) → Finset (P g))

theorem full_mixed_residual_forest_expansion
    (hedge : ∀ k H x e, edgePhase k H x e =
      (if FullMixedLocalBirthAvoids (J := J) n S B A Δ D H (some (.inr k)) x e ∧
          FullMixedLocalBirthDistinct (J := J) n S B A Δ D (some (.inr k)) x e then 1 else 0) *
        edgePhase k (fun _ => ∅) x e)
    (encode : ((g : Fin N) × P g) → ℤ) (hinj : Function.Injective encode)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (hx : FullMixedLedgerCovers n B (initial x, x)) :
    fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps
      (fullMixedLedgerInducedPhase n S B A Δ D steps initial
        (finiteEventLocalPhase
          (fun tag (s : FullMixedLedgerState n (M := M) B) => FullPermutationMixedEvent n S B A Δ D tag s.2)
          (fullMixedLedgerTarget n S B A Δ D) (fullMixedLedgerPhase n S B A Δ D edgePhase) steps)) f x =
    ∑ code, (-1 : ℂ) ^ birthForestRank code *
      fullMixedResidualForestAction n S B A Δ D edgePhase ω μ q ρ V steps initial code f x := by
  let _ : ∀ (tag : Option (J ⊕ K)) x, Fintype (FullPermutationMixedEvent n S B A Δ D tag x) :=
    fullPermutationMixedEventFintype n S B A Δ D
  let _ := finiteEventPathFintype (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) steps x
  have h := full_mixed_ledger_phase_forest_expansion n S B A Δ D edgePhase hedge ω μ q ρ V steps initial x hx
    univ (fun p => f (finiteEventPathTerminal (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x p)) encode hinj
  simp_rw [full_mixed_residual_forest_action_eq n S B A Δ D edgePhase ω μ q ρ V steps initial encode hinj]
  rw [← h]
  unfold fullPermutationMixedPathAction finiteEventPathAction
  apply sum_congr rfl
  intro p _
  ring

end Full
end Bounty
end

