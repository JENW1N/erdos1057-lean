open Finset
theorem finite_bad_event_indicator_product {α : Type*} [DecidableEq α]
    (S : Finset α) (bad : α → Prop) [DecidablePred bad] :
    (∏ p ∈ S, if bad p then (1 : ℝ) else 0) =
      if ∀ p ∈ S, bad p then 1 else 0 := by
  classical
  by_cases hall : ∀ p ∈ S, bad p
  · rw [if_pos hall]
    exact prod_eq_one (fun p hp => if_pos (hall p hp))
  · rw [if_neg hall]
    push Not at hall
    obtain ⟨p, hp, hbad⟩ := hall
    exact prod_eq_zero hp (if_neg hbad)

theorem finite_bad_event_avoidance_product {α : Type*} [DecidableEq α]
    (S : Finset α) (bad : α → Prop) [DecidablePred bad] :
    (∏ p ∈ S, ((1 : ℝ) - (if bad p then 1 else 0))) =
      if ∀ p ∈ S, ¬bad p then 1 else 0 := by
  classical
  calc
    _ = ∏ p ∈ S, if ¬bad p then (1 : ℝ) else 0 := by
      apply prod_congr rfl
      intro p _
      by_cases hp : bad p <;> simp [hp]
    _ = _ := finite_bad_event_indicator_product S (fun p => ¬bad p)

theorem finite_bad_event_weighted_intersection {Ω α : Type*} [DecidableEq α]
    (T : Finset Ω) (μ : Ω → ℝ) (S : Finset α) (bad : Ω → α → Prop)
    [∀ t p, Decidable (bad t p)] :
    (∑ t ∈ T, μ t * ∏ p ∈ S, if bad t p then (1 : ℝ) else 0) =
      ∑ t ∈ T.filter (fun t => ∀ p ∈ S, bad t p), μ t := by
  classical
  simp_rw [finite_bad_event_indicator_product]
  rw [sum_filter]
  apply sum_congr rfl
  intro t _
  split_ifs <;> simp

theorem finite_bad_event_weighted_avoidance {Ω α : Type*} [DecidableEq α]
    (T : Finset Ω) (μ : Ω → ℝ) (S : Finset α) (bad : Ω → α → Prop)
    [∀ t p, Decidable (bad t p)] :
    (∑ t ∈ T, μ t * ∏ p ∈ S, ((1 : ℝ) - (if bad t p then 1 else 0))) =
      ∑ t ∈ T.filter (fun t => ∀ p ∈ S, ¬bad t p), μ t := by
  classical
  simp_rw [finite_bad_event_avoidance_product]
  rw [sum_filter]
  apply sum_congr rfl
  intro t _
  split_ifs <;> simp

theorem finite_block_sieve_events {Ω : Type*} (J : Finset ℕ) (B : ℕ → Finset ℕ)
    (T : Finset Ω) (μ : Ω → ℝ) (bad : Ω → ℕ → Prop) [∀ t p, Decidable (bad t p)]
    (g r : ℕ → ℝ) {z X C η : ℝ} {h : ℕ}
    (hz : 1 ≤ z) (hX : 0 ≤ X) (hC : 0 ≤ C) (hη : 0 < η)
    (hh : 1 ≤ h) (heven : Even h)
    (hdisj : (J : Set ℕ).PairwiseDisjoint B)
    (hprime : ∀ j ∈ J, ∀ p ∈ B j, p.Prime)
    (hsize : ∀ j ∈ J, ∀ p ∈ B j, Real.log (p : ℝ) ≤ Real.log z / (2 : ℝ)^j)
    (hμ : ∀ t ∈ T, 0 ≤ μ t)
    (hg : ∀ j ∈ J, ∀ p ∈ B j, 0 ≤ g p ∧ g p ≤ 1 - η)
    (hsum : ∀ j ∈ J, (∑ p ∈ B j, g p) ≤ C)
    (hmoment : ∀ S ∈ (J.biUnion B).powerset,
      (∑ t ∈ T.filter (fun t => ∀ p ∈ S, bad t p), μ t) =
        X * (∏ p ∈ S, g p) + r (∏ p ∈ S, p)) :
    |(∑ t ∈ T.filter (fun t => ∀ p ∈ J.biUnion B, ¬bad t p), μ t) -
        X * (∏ p ∈ J.biUnion B, (1 - g p))| ≤
      X * (∏ p ∈ J.biUnion B, (1 - g p)) * blockSieveModelErrorConstant C η *
        Real.exp (-(h : ℝ)) +
          ∑ d ∈ blockSieveModuli (J.biUnion B) (z^(4 * (h : ℝ) + 2)), |r d| := by
  classical
  have h := finite_block_sieve J B T μ (fun t p => if bad t p then 1 else 0) g r
    hz hX hC hη hh heven hdisj hprime hsize hμ
    (fun t _ p _ => by by_cases hp : bad t p <;> simp [hp]) hg hsum (by
      intro S hS
      rw [finite_bad_event_weighted_intersection]
      exact hmoment S hS)
  rw [finite_bad_event_weighted_avoidance] at h
  exact h
end

