/- A fixed shared-coordinate and auxiliary fiber has the same coefficient
on both sides of a bilinear transpose. Reassembly introduces no factor for
the number of fibers or auxiliary choices. -/

open Finset Classical

namespace Bounty

theorem equiv_fiber_average_pairing {X C Y : Type*}
    [Fintype X] [Fintype C] [Fintype Y] {A : C → Type*} [∀ c, Fintype (A c)]
    (e : X ≃ C × Y) (W : X → ℝ) (κ : C → ℝ) (μ : Y → ℝ)
    (hW : ∀ c y, W (e.symm (c, y)) = κ c * μ y)
    (ω : ∀ c, A c → ℝ) (T R : ∀ c, A c → (Y → ℂ) → Y → ℂ)
    (f g : X → ℂ)
    (hpair : ∀ c a,
      (∑ y, (μ y : ℂ) * equivFiberSlice e f c y * T c a (equivFiberSlice e g c) y) =
        ∑ y, (μ y : ℂ) * R c a (equivFiberSlice e f c) y * equivFiberSlice e g c y) :
    (∑ x, (W x : ℂ) * f x * equivFiberAverageLift e ω T g x) =
      ∑ x, (W x : ℂ) * equivFiberAverageLift e ω R f x * g x := by
  have hT (c : C) (y : Y) : equivFiberAverageLift e ω T g (e.symm (c, y)) =
      finiteFiberAverage ω T (equivFiberSlice e g) c y := by
    change equivFiberSlice e (equivFiberAverageLift e ω T g) c y = _
    rw [equivFiberSlice_average_lift]
  have hR (c : C) (y : Y) : equivFiberAverageLift e ω R f (e.symm (c, y)) =
      finiteFiberAverage ω R (equivFiberSlice e f) c y := by
    change equivFiberSlice e (equivFiberAverageLift e ω R f) c y = _
    rw [equivFiberSlice_average_lift]
  rw [← e.symm.sum_comp, ← e.symm.sum_comp]
  simp only [Fintype.sum_prod_type, hW, hT, hR, finiteFiberAverage,
    Complex.ofReal_mul, mul_sum, sum_mul]
  apply sum_congr rfl
  intro c hc
  change (∑ y : Y, ∑ a : A c, (κ c : ℂ) * (μ y : ℂ) * f (e.symm (c, y)) *
      ((ω c a : ℂ) * T c a (equivFiberSlice e g c) y)) =
    ∑ y : Y, ∑ a : A c, (κ c : ℂ) * (μ y : ℂ) *
      ((ω c a : ℂ) * R c a (equivFiberSlice e f c) y) * g (e.symm (c, y))
  conv_lhs => rw [sum_comm]
  conv_rhs => rw [sum_comm]
  apply sum_congr rfl
  intro a ha
  have h := congrArg (fun z : ℂ => (κ c : ℂ) * (ω c a : ℂ) * z) (hpair c a)
  simpa only [mul_sum, equivFiberSlice, mul_assoc, mul_comm, mul_left_comm] using h

end Bounty
end

