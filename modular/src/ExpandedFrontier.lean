/- A finite union of prescribed physical paths is one bounded recorded-history phase. -/

open Finset
namespace Bounty

section Energy
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g, ∀ p : ↥(P g), NeZero p.val]
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ) (cut : ℕ → Fin N → Finset (Fin J))
  (S : Finset (PhysicalSelectedData P ell C)) (w : PhysicalSelectedData P ell C → ℂ)

noncomputable def physicalSelectedRecordAction
    (f : PhysicalFullBoundedState P J ell B → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) : ℂ :=
  finiteRowComposition (S := fun _ =>
    List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C) × PhysicalBoundedMarkState P J ell B)
    (fun i => physicalRecordedMarkRow C k ω β retention ρ V hV
      (physicalSelectedFineTag n i) (cut i) (cut (i + 1)) (physicalFullTraceAppend C)) (4 * n + 1)
    ((fun r => physicalSelectedDataRecordPhase C cut S w r.1 * f r.2.2) ∘
      Prod.map id (physicalBoundedMarkEncode (cut (4 * n + 1)))) ([], s)

theorem physical_selected_outer_record_energy_le
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hencode : ∀ i, PhysicalMarkRowEncoding C (physicalSelectedFineTag n i) (cut i) (cut (i + 1)))
    (hω : ∀ j c a, 0 ≤ ω j c a) (hωmass : ∀ j c, ∑ a, ω j c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 < β g p / V g) (hmass : ∀ g, ∑ p, β g p / V g ≤ 2)
    (hq0 : ∀ i, 0 ≤ retention i) (hq1 : ∀ i, retention i ≤ 1)
    (hD : ∀ i, retention i / ρ ^ 2 + ((1 - retention i) / ρ) / v ≤ 1)
    (hC : ∀ i g, retention i / ρ ^ 2 + ((1 - retention i) * V g / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ j g, ell + (C j g).card ≤ T)
    (initial : PhysicalFullBoundedState P J ell B → (g : Fin N) → Finset ↥(P g))
    (hw : ∀ d ∈ S, ‖w d‖ ≤ 1)
    (f : PhysicalFullBoundedState P J ell B → ℂ) (hf : ProductMemorySymmetric f) :
    physicalMarkMemoryEnergy (fun g p => β g p / V g)
      (fun g => unrestrictedResidueWeight (fun p => β g p / V g))
      (fun M q =>
        let x := physicalFullMemoryState (cut 0) M q
        physicalSelectedRecordAction C k β V ρ hV ω retention cut S w f (M, initial x, q)) ≤
      (((List.range (4 * n + 1)).map (physicalSelectedFineTag n)).map
        (fullPermutationMixedStepEnergy ρ v vmin vmax T N)).prod *
        finiteWeightedEnergy (productMemoryWeight (fun g p => β g p / V g)
          (fun g => unrestrictedResidueWeight (fun p => β g p / V g))) f := by
  exact physical_recorded_trace_history_energy_le C k ω β retention ρ V hV hP hdis
    (physicalSelectedFineTag n) cut hencode hω hωmass hρ0 hρ1 hv hvmin hVlo hVhi
    hμ hmass hq0 hq1 hD hC T ht (4 * n + 1) initial (fun _ => [])
    (fun r _ => physicalSelectedDataRecordPhase C cut S w r)
    (fun r _ => physical_selected_data_record_phase_norm_le_one C cut S w r
      (fun d hd _ => hw d hd)) f hf

end Energy
end Bounty
end

section

/- Finite path sums reindex exactly by the actual pattern indices and selected data. -/

open Finset
namespace Bounty

noncomputable abbrev physicalLabeledPathFintype {I : Type*}
    {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    (patterns : Finset I) (C : I → Fin N → Finset (Fin J)) :
    Fintype (Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) := by
  classical
  letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  letI : Fintype (PhysicalMarkLists P J ell) := inferInstance
  exact inferInstance

noncomputable abbrev physicalSelectedDataFintype {N J ell n : ℕ}
    {P : Fin N → Finset ℕ} (C : Fin n → Fin N → Finset (Fin J)) :
    Fintype (PhysicalSelectedData P ell C) := by
  classical
  letI : Fintype (PhysicalMarkLists P J ell) := inferInstance
  letI : Fintype (PhysicalPermutations (Fin N) J ell) := inferInstance
  letI : ∀ j, Fintype (PhysicalAuxLabels P (C j)) := fun _ => inferInstance
  exact inferInstance

section Packing
variable {I R : Type*} [AddCommMonoid R] {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    (patterns : Finset I) (C : I → Fin N → Finset (Fin J))

theorem physical_path_selected_sum
    (F : (Σ pattern : Fin n → patterns,
      PhysicalSelectedData P ell (fun j => C (pattern j).val)) → R) :
    let := physicalLabeledPathFintype (P := P) (ell := ell) (n := n) patterns C
    let : ∀ pattern : Fin n → patterns,
      Fintype (PhysicalSelectedData P ell (fun j => C (pattern j).val)) :=
      fun pattern => physicalSelectedDataFintype (fun j => C (pattern j).val)
    (∑ L : PhysicalMarkLists P J ell,
      ∑ p : Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
        F (physicalPathSelectedEquiv patterns C (L, p))) =
    ∑ pattern : Fin n → patterns,
      ∑ d : PhysicalSelectedData P ell (fun j => C (pattern j).val), F ⟨pattern, d⟩ := by
  classical
  let := physicalLabeledPathFintype (P := P) (ell := ell) (n := n) patterns C
  let : ∀ pattern : Fin n → patterns,
    Fintype (PhysicalSelectedData P ell (fun j => C (pattern j).val)) :=
    fun pattern => physicalSelectedDataFintype (fun j => C (pattern j).val)
  have h := (physicalPathSelectedEquiv (P := P) (ell := ell) (n := n) patterns C).sum_comp F
  simpa only [Fintype.sum_prod_type, Fintype.sum_sigma] using h

theorem physical_path_sum_eq_selected_data
    (F : PhysicalMarkLists P J ell →
      (Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) → R) :
    let := physicalLabeledPathFintype (P := P) (ell := ell) (n := n) patterns C
    let : ∀ pattern : Fin n → patterns,
      Fintype (PhysicalSelectedData P ell (fun j => C (pattern j).val)) :=
      fun pattern => physicalSelectedDataFintype (fun j => C (pattern j).val)
    (∑ L : PhysicalMarkLists P J ell,
      ∑ p : Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell, F L p) =
    ∑ pattern : Fin n → patterns,
      ∑ d : PhysicalSelectedData P ell (fun j => C (pattern j).val),
        F (d.2.1 0) (fun j => ((d.2.2.1 j, d.2.2.2 j, ⟨pattern j, d.1 j⟩), d.2.1 j.succ)) := by
  classical
  let := physicalLabeledPathFintype (P := P) (ell := ell) (n := n) patterns C
  let : ∀ pattern : Fin n → patterns,
    Fintype (PhysicalSelectedData P ell (fun j => C (pattern j).val)) :=
    fun pattern => physicalSelectedDataFintype (fun j => C (pattern j).val)
  have h := physical_path_selected_sum patterns C
    (fun y => F ((physicalPathSelectedEquiv patterns C).symm y).1
      ((physicalPathSelectedEquiv patterns C).symm y).2)
  have hsteps (pattern : Fin n → patterns)
      (d : PhysicalSelectedData P ell (fun j => C (pattern j).val)) :
      ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d⟩).2 =
        fun j => ((d.2.2.1 j, d.2.2.2 j, ⟨pattern j, d.1 j⟩), d.2.1 j.succ) := rfl
  simpa only [Equiv.symm_apply_apply, physical_path_selected_inverse_initial, hsteps] using h

end Packing
end Bounty
end

