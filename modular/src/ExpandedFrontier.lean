/- Old performed coordinates embed into the common indices with their owner and group preserved; no within-owner order preservation is assumed. -/

namespace Bounty
section Indices
variable {J K : Type*} {N : ℕ} {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
