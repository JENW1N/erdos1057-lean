/- The literal original group vertex weight is the product of its two
permuted endpoint factors at every original edge and offset. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_group_finite_vertex_weight_edges
    {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ} {patterns : Finset I}
    (groups : Finset (Fin N)) (C : I → Fin N → Finset (Fin J))
    {q : ℝ} (hq : 0 ≤ q) (k : ℕ → I → ℤ)
    (L : PhysicalMarkLists P J ell)
    (p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)
    (r : PhysicalGroupResidues P groups) :
    physicalGroupFiniteVertexWeight groups C q k L p r =
      ∏ j : Fin (n + 1),
        physicalResidueVertexWeight
          (fun g : ↥groups => physicalPermuteLabels (p j).1.1
            (finitePathMarks L p j.val) g.val) (Real.sqrt q)
          (physicalTranslateResidues (physicalGroupResidueVector r)
            (physicalPathSelectedOffset C k L p j.castSucc)) *
        physicalResidueVertexWeight
          (fun g : ↥groups => physicalPermuteLabels (p j).1.2.1
            (finitePathMarks L p (j.val + 1)) g.val) (Real.sqrt q)
          (physicalTranslateResidues (physicalGroupResidueVector r)
            (physicalPathSelectedOffset C k L p j.succ)) := by
  unfold physicalGroupFiniteVertexWeight
  rw [← physical_residue_permuted_endpoint_product
    (fun j (g : ↥groups) => finitePathMarks L p j g.val)
    (fun j => physicalTranslateResidues (physicalGroupResidueVector r)
      (physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p) (n + 1) j))
    (fun j (g : ↥groups) => (finitePathLabels p j).1 g.val)
    (fun j (g : ↥groups) => (finitePathLabels p j).2.1 g.val) hq n]
  rw [← Fin.prod_univ_eq_prod_range]
  apply prod_congr rfl
  intro j _
  simp only [finitePathLabels, dif_pos j.isLt]
  rfl

end Bounty
end

