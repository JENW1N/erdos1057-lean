/- Assembly of finite rough and prime components with the corrected parameter order. -/

open Filter
namespace Bounty

def CandidateHalfFixedSlotComponentBounds : Prop :=
  ∀ (c : ℝ) (r : ℕ), 0<c → 6≤r →
    (11/5 : ℝ)*(r : ℝ)*c=1 →
    ∀ (κ b : ℝ) (N : ℕ), 0<κ → κ≤1/50 → 0<b → b<1/2-κ → 0<N →
      (∀ i : Fin N, ∃ J : ℕ, ∀ jStar : ℕ, J<jStar →
        ∃ S₀ : ℝ, 0≤S₀ ∧ ∀ S : ℝ, S₀≤S → ∀ᶠ L : ℝ in atTop,
          |ambientRoughProxyError (arithmeticProductWindow 1 (Real.exp L))
            (candidateCoefficient c L (1/2) r jStar) (reciprocalGrid b (1/2-κ) N i) L S
            (Real.exp (reciprocalGrid b (1/2-κ) N i*L))
            (Real.exp (reciprocalGrid b (1/2-κ) N ((i : ℕ)+1)*L))| ≤
              candidateCoefficientWindowMass c L (1/2) r jStar*L^(-2 : ℝ)) ∧
      (∃ J : ℕ, ∀ jStar : ℕ, J<jStar →
        ∃ S₀ : ℝ, 0≤S₀ ∧ ∀ S : ℝ, S₀≤S → ∀ᶠ L : ℝ in atTop,
          |ambientPrimeProxyError (arithmeticProductWindow 1 (Real.exp L))
            (candidateCoefficient c L (1/2) r jStar) κ L S| ≤
              candidateCoefficientWindowMass c L (1/2) r jStar*L^(-2 : ℝ))

theorem candidate_half_fixed_slot_replacement_of_component_bounds
    (hlarge : CandidateHalfFixedSlotComponentBounds) : CandidateHalfFixedSlotReplacement := by
  intro c r hc hr hcenter κ b N hκ hκmax hb hbq hN
  obtain ⟨hrough,hprime⟩ := hlarge c r hc hr hcenter κ b N hκ hκmax hb hbq hN
  let P : Option (Fin N) → ℝ → ℕ → ℝ → Prop := fun i S j L =>
    match i with
    | none => |ambientPrimeProxyError (arithmeticProductWindow 1 (Real.exp L))
        (candidateCoefficient c L (1/2) r j) κ L S| ≤ candidateCoefficientWindowMass c L (1/2) r j*L^(-2 : ℝ)
    | some i => |ambientRoughProxyError (arithmeticProductWindow 1 (Real.exp L))
        (candidateCoefficient c L (1/2) r j) (reciprocalGrid b (1/2-κ) N i) L S
        (Real.exp (reciprocalGrid b (1/2-κ) N i*L))
        (Real.exp (reciprocalGrid b (1/2-κ) N ((i : ℕ)+1)*L))| ≤
          candidateCoefficientWindowMass c L (1/2) r j*L^(-2 : ℝ)
  have hall : ∀ i, ∃ J : ℕ, ∀ j : ℕ, J < j →
      ∃ S₀ : ℝ, 0 ≤ S₀ ∧ ∀ S : ℝ, S₀ ≤ S → ∀ᶠ L : ℝ in atTop, P i S j L := by
    intro i
    cases i with
    | none => exact hprime
    | some i => exact hrough i
  obtain ⟨J, hJ⟩ := finite_fixed_slot_component_thresholds P hall
  refine ⟨J, ?_⟩
  intro j hj
  obtain ⟨S, hS, hbound⟩ := hJ j hj
  refine ⟨S, hS, ?_⟩
  have hev := hbound S le_rfl
  exact eventually_candidate_ambient_error_of_component_bounds
    (fun i => hev.mono (fun L hL => hL (some i)))
    (hev.mono (fun L hL => hL none))

theorem target_of_candidate_half_fixed_slot_components
    (hZ : PrimitiveZeroFreeHalfPlane) (hR : CandidateHalfFixedSlotComponentBounds) :
    fcTypeOfName% "Erdos1057.erdos_1057" :=
  target_of_candidate_half_fixed_slot_replacement hZ
    (candidate_half_fixed_slot_replacement_of_component_bounds hR)

end Bounty
