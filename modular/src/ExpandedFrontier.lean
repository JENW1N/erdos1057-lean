open scoped BigOperators
noncomputable def circleGeometricBound (N : ℕ) (x : ℝ) : ℝ :=
  if (x : UnitAddCircle) = 0 then N else
    min (N : ℝ) (1 / (2 * ‖(x : UnitAddCircle)‖))

theorem circle_geometric_bound_nonneg (N : ℕ) (x : ℝ) :
    0 ≤ circleGeometricBound N x := by
  unfold circleGeometricBound
  split_ifs
  · positivity
  · exact le_min (by positivity) (by positivity)

theorem geometric_chord_le_circle_bound (N : ℕ) (x : ℝ) :
    geometricChordBound N (Complex.exp (Complex.I * (2 * Real.pi * x : ℝ))) ≤
      circleGeometricBound N x := by
  by_cases hx : (x : UnitAddCircle) = 0
  · simp only [circleGeometricBound, if_pos hx, geometricChordBound]
    split_ifs
    · exact le_rfl
    · exact min_le_left _ _
  · have hd := norm_circle_phase_sub_one_pos x hx
    have hz : Complex.exp (Complex.I * (2 * Real.pi * x : ℝ)) ≠ 1 := by
      simpa only [norm_pos_iff, sub_ne_zero] using hd
    simp only [geometricChordBound, if_neg hz, circleGeometricBound, if_neg hx]
    apply min_le_min_left
    apply (div_le_div_iff₀ hd (mul_pos (by norm_num) (norm_pos_iff.mpr hx))).mpr
    have h := norm_circle_phase_sub_one_ge x
    nlinarith

theorem circle_exponential_conj_mul (x y : ℝ) :
    (starRingEnd ℂ) (Complex.exp (Complex.I * (2 * Real.pi * x : ℝ))) *
      Complex.exp (Complex.I * (2 * Real.pi * y : ℝ)) =
      Complex.exp (Complex.I * (2 * Real.pi * (y - x) : ℝ)) := by
  rw [← Complex.exp_conj]
  simp only [map_mul, Complex.conj_I, Complex.conj_ofReal]
  rw [← Complex.exp_add]
  congr 1
  push_cast
  ring

theorem circle_bilinear_norm_sq_le {Y : Type*} [Fintype Y]
    (θ : Y → ℝ) (a N : ℕ) (c : Fin N → ℂ) (b : Y → ℂ) {B : ℝ}
    (hrow : ∀ y, (∑ w, circleGeometricBound N (θ w - θ y)) ≤ B) :
    ‖∑ n : Fin N, ∑ y, c n * b y *
      (Complex.exp (Complex.I * (2 * Real.pi * θ y : ℝ))) ^ (a + n.val)‖ ^ 2 ≤
      B * (∑ n : Fin N, ‖c n‖ ^ 2) * ∑ y, ‖b y‖ ^ 2 := by
  apply unit_geometric_bilinear_norm_sq_le
    (fun y => Complex.exp (Complex.I * (2 * Real.pi * θ y : ℝ)))
    (fun y => by simpa only [mul_comm Complex.I] using
      Complex.norm_exp_ofReal_mul_I (2 * Real.pi * θ y)) a N c b
  intro y
  calc
    _ = ∑ w, geometricChordBound N
        (Complex.exp (Complex.I * (2 * Real.pi * (θ w - θ y) : ℝ))) := by
      apply Finset.sum_congr rfl
      intro w _
      rw [circle_exponential_conj_mul]
    _ ≤ ∑ w, circleGeometricBound N (θ w - θ y) :=
      Finset.sum_le_sum (fun w _ => geometric_chord_le_circle_bound N _)
    _ ≤ B := hrow y
end

