/- Exact assembly of the original auxiliary draws after small-prefix
conditioning. The source is read in canonical coordinates, while the event,
both total-memory cutoffs, and the residue translation remain physical. -/

open Finset
open scoped Classical

namespace Bounty

section

variable {S G : Type*} [Fintype S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}

noncomputable def physicalMixedCleanPrefixPhase
    (C : G → Finset (Fin J)) (ζ θ : ℝ) (k : ℤ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (a : PhysicalAuxLabels P C) (d : PhysicalSharedLists Ps J)
    (x : CleanFullMemoryState P J ell B) (_r : PhysicalResidues Ps)
    (e : PhysicalSmallBigFullEvent (fun g (p : P g) => p.val)
      (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
      (fun d c => physicalMixedEdgeDelta C k d c a)
      (fun d c => physicalMixedEdgeD C d c a) d x) : ℂ :=
  let source := (cleanFullMemoryEquiv P J ell B
    ((fullActivePermutation (cleanPhysicalSlotChange C)).symm x)).2.2.1
  let Sp := fun g => physicalFullSharedIndices (ell := ell) (C g)
  let cp := (productActiveMemorySplit Sp B x).1
  let sp := (productActiveMemorySplit Sp B x).2
  let fresh := physicalCleanFreshEquiv (fun g => ↥(P g)) C (fun g =>
    (unrestrictedJointEventTarget (fun g (p : P g) => p.val)
      (physicalMixedEdgeDelta C k d cp a) (physicalMixedEdgeD C d cp a)
      (fun g => (Sp g)ᶜ.card) B sp e.2 g).1)
  let target := repeatedBigFill C source (cleanFullFreshEquiv P C fresh)
  if repeatedBigAuxAvoids C a source ∧ repeatedBigAuxAvoids C a target then
    K source target a * physicalPhase ζ (physicalMixedSharedD C d cp a) *
      physicalReturnPhase θ (physicalMixedBigStep C k cp a * (physicalSharedProduct d : ℕ))
  else 0

variable [∀ g (p : P g), NeZero p.val]

theorem physical_mixed_clean_aux_sum_eq_action
    (initial : ∀ g, Finset (P g)) (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (ζ θ ρ : ℝ) (k : ℤ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : CleanFullMemoryState P J ell B → PhysicalResidues Ps → ℂ)
    (x : CleanFullMemoryState P J ell B) (r : PhysicalResidues Ps) :
    (∑ a : PhysicalAuxLabels P C, (physicalAuxMass V C a : ℂ) *
      fullActiveExternalCoefficientAction (fun g (p : P g) => p.val)
        (fun g => physicalFullSharedIndices (ell := ell) (C g)) B (fun _ => Unit)
        (fun c _ => physicalMixedEdgeDelta C k d c a)
        (fun c _ => physicalMixedEdgeD C d c a) (fun _ _ => 1)
        (fun g => tiltedPhysicalBirthLaw V g (b g)) ρ V
        (fun c _ => physicalResidueTranslationEquiv (P := Ps)
          (physicalMixedBigStep C k c a * (physicalSharedProduct d : ℕ)))
        (physicalSmallBigCleanInitialPhase (fun g (p : P g) => p.val)
          (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
          (fun d c => physicalMixedEdgeDelta C k d c a)
          (fun d c => physicalMixedEdgeD C d c a) initial
          (physicalMixedCleanPrefixPhase C ζ θ k K a) d) f x r) =
      physicalMixedCleanInitialAction initial V b C ζ θ ρ k K d f x r := by
  unfold physicalMixedCleanInitialAction fullActiveExternalCoefficientAction
  rw [Fintype.sum_sigma]
  apply sum_congr rfl
  intro a _
  rw [Fintype.sum_sigma]
  simp only [Fintype.sum_unique, mul_sum]
  apply sum_congr
  · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
  · intro e _
    simp only [fullActiveEdgeEventWeight, one_mul, Complex.ofReal_mul,
      physicalSmallBigCleanInitialPhase, physicalMixedCleanPrefixPhase,
      fullActiveEdgeEventTarget, physicalResidueTranslationEquiv, Equiv.coe_fn_mk]
    split_ifs <;> ring

end

end Bounty
