      PhysicalMarkObservation P ell C →
      FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → R) :=
  finiteObservedRecordRow (physicalObservedMarkRow (B := B) C k ω β retention ρ V hV tag)
    (fun h x o y => update h (physicalBoundedMarkEncode before x) o (physicalBoundedMarkEncode after y))

noncomputable def physicalFullRecordedRow
    (tag : Option (I ⊕ K)) (before after : Fin N → Finset (Fin J))
