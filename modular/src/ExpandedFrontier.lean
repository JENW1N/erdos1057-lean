theorem physical_root_residue_model_mixed_normalization
    {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    [∀ a : PhysicalPrime P, NeZero a.2.val]
    (groups : Finset (Fin N)) (V : Fin N → ℝ) (patterns : Finset I)
    (C : I → Fin N → Finset (Fin J)) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ)
    (hP : ∀ g a, a ∈ P g → Nat.Prime a)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hk : ∀ t < n + 1, ∀ i ∈ patterns, ∀ g a, a ∈ P g → ¬ (a : ℤ) ∣ k t i)
    (b : PhysicalPrime P → ℝ)
    (hb : ∀ a : PhysicalPrime P, a.1 ∈ groups →
      b a = 1 - (∑ j ∈ range (n + 2), (1 - physicalEndpointSchedule q (n + 1) j)) / a.2.val)
    (hb0 : ∀ a : PhysicalPrime P, a.1 ∈ groups → b a ≠ 0)
    (B : ℕ) (hB : (physicalPrimeGroups P groups).card ≤ B) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    physicalRootResidueModel V patterns C q ζ k K n =
      (∏ a ∈ physicalPrimeGroups P groups, b a : ℝ) *
      ∑ r : PhysicalGroupResidues P groupsᶜ,
        (∏ a : ↥(physicalPrimeGroups P groupsᶜ), 1 / (a.val.2.val : ℝ)) *
        ∑ L : PhysicalMarkLists P J ell,
        ∑ p : {p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell //
          physicalRootNormalizablePath V patterns C ζ k K L p},
        (((physicalStateMass (fun g : ↥groupsᶜ => V g.val) J ell *
          ∏ j ∈ range (n + 1), physicalCompletionMass (fun g : ↥groupsᶜ => V g.val)
            (fun g => C (finitePathLabels p.val j).2.2.1.val g.val) ell : ℝ) : ℂ) *
          physicalMemoryWalkScalar V patterns C ζ K (finitePathLabels p.val) (finitePathMarks L p.val) (n + 1) *
          physicalGroupFiniteVertexWeight groupsᶜ C q k L p.val r *
          physicalGroupFiniteCappedHistory groups C q k
            (fun a => ((a.2.val : ℝ) * b a)⁻¹) V B L p.val) := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  rw [physical_root_residue_model_normalizable V patterns C ζ k K hP hdis q]
  simp only [mul_sum]
  trans ∑ L : PhysicalMarkLists P J ell,
    ∑ p : {p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell //
      physicalRootNormalizablePath V patterns C ζ k K L p},
      (∏ a ∈ physicalPrimeGroups P groups, b a : ℝ) *
      ∑ r : PhysicalGroupResidues P groupsᶜ,
        (∏ a : ↥(physicalPrimeGroups P groupsᶜ), 1 / (a.val.2.val : ℝ)) *
        (((physicalStateMass (fun g : ↥groupsᶜ => V g.val) J ell *
          ∏ j ∈ range (n + 1), physicalCompletionMass (fun g : ↥groupsᶜ => V g.val)
            (fun g => C (finitePathLabels p.val j).2.2.1.val g.val) ell : ℝ) : ℂ) *
          physicalMemoryWalkScalar V patterns C ζ K (finitePathLabels p.val) (finitePathMarks L p.val) (n + 1) *
          physicalGroupFiniteVertexWeight groupsᶜ C q k L p.val r *
          physicalGroupFiniteCappedHistory groups C q k
            (fun a => ((a.2.val : ℝ) * b a)⁻¹) V B L p.val)
  · apply sum_congr rfl
    intro L _
    apply sum_congr rfl
    intro p _
    have hkp : ∀ j : Fin (n + 1), ∀ g s,
        ¬ (((physicalPathSelectedEquiv patterns C (L, p.val)).2.2.1 j.castSucc g s).val : ℤ) ∣
          physicalPathSelectedMultiplier C k p.val j := by
      intro j g s
      exact hk (n - j.val) (by omega) (p.val j).1.2.2.1.val (p.val j).1.2.2.1.property g _
        ((physicalPathSelectedEquiv patterns C (L, p.val)).2.2.1 j.castSucc g s).property
    simpa only [mul_assoc] using physical_finite_root_term_mixed_normalization
      groups V patterns C q ζ k K L p.val p.property hP hdis hkp b hb hb0 B hB
  · simp only [mul_sum]
    conv_lhs =>
      arg 2
      ext L
      rw [sum_comm]
    rw [sum_comm]

end Bounty
end

