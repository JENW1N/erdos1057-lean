  typeIIRetainedHarmonicCorrelation Z k M (candidateRetainedAllocationSupport c L r jStar P take) α
    (fun n => markedDivisorWeight (candidatePIndices c L) (candidatePBand (c*L)) q
      (fun j => ∑ p ∈ candidatePBand (c*L) j, 1/(p:ℝ)) (fun _ => 1) (n:ℤ))
    (fun h => candidateRemainingComplexCoefficient c L r jStar take twist
      (primePoolFreePart ((candidatePIndices c L).biUnion (candidatePBand (c*L))) h))
    (2*Real.pi*ν) χ ζ

theorem candidate_B0_retained_eq_separated (c L q : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (ν : ℝ) :
    candidateB0RetainedCoefficient c L q r jStar take twist ν =
      typeIISeparatedH
        (fun n => markedDivisorWeight (candidatePIndices c L) (candidatePBand (c*L)) q
          (fun j => ∑ p ∈ candidatePBand (c*L) j, 1/(p:ℝ)) (fun _ => 1) (n:ℤ))
        (fun h => candidateRemainingComplexCoefficient c L r jStar take twist
          (primePoolFreePart ((candidatePIndices c L).biUnion (candidatePBand (c*L))) h))
        (2*Real.pi*ν) := by
  rw [candidate_B0_retained_eq_phase]
  funext h
  simp only [candidateRetainedComplexCoefficient, typeIISeparatedH, mul_assoc]

theorem exists_candidate_B0_bound_of_harmonic {c b A D : ℝ}
    (hc : 0 < c) (hb : 0 < b) {r : ℕ} (hr : 6 ≤ r) :
    ∃ Kmin : ℝ, 0 < Kmin ∧ ∀ K : ℝ, Kmin ≤ K →
      ∃ Q F : ℝ, 0 < Q ∧ 0 < F ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (jStar : ℕ) (hj : jStar ∈ candidateQIndices c L)
        (take : Fin ((candidateQIndices c L).card*r) → Bool),
      take ((candidateAllocationOrder c L r).symm
        (candidateRoughSlot c L r jStar (by omega) hj)) = false →
      ∀ (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ)
        (ν R U V : ℝ),
      Real.exp (b*L) ≤ U → U ≤ Real.exp L → Real.exp (b*L) ≤ V → V ≤ Real.exp L →
      2*U*V ≤ R*Real.exp L → ∀ (P M N : Finset ℕ) (α β : ℕ → ℂ),
      (∀ p ∈ P, 0 < p) → (∀ m ∈ M, (m:ℝ) ∈ Set.Icc U (2*U)) →
      (∀ n ∈ N, (n:ℝ) ∈ Set.Icc V (2*V)) →
      (∀ m, m ∉ M → α m = 0) → (∀ n, n ∉ N → β n = 0) →
      (∀ m ∈ M, ‖α m‖ ≤ L^A) → (∀ n ∈ N, ‖β n‖ ≤ L^A) →
      (∀ m ∈ M, α m ≠ 0 → ∀ p ∈ m.primeFactors, Real.exp (Real.sqrt L) < (p:ℝ)) →
      (∀ k ∈ Icc (-(typeIIAdmissibleDeterminantBound L K:ℤ)) (typeIIAdmissibleDeterminantBound L K),
        k ≠ 0 → ∀ j ∈ range (typeIISmoothDyadicCount L),
        ∀ χ : DirichletCharacter ℂ (2*k.natAbs), ∀ ζ : EuclideanSpace ℝ (Fin 3), ‖ζ‖ ≤ L^F →
        ‖candidateB0HarmonicCorrelation c L (1/2) r jStar P take
          (candidateAllocationFourierTwist c L r jStar take ξ) ν
          (typeIISmoothDyadicScale U V (U*L^(-K)) j) k M α χ ζ‖ ≤ L^(-Q)) →
      ‖candidateRetainedAllocationIntegrand c L (1/2) r jStar (Real.log (U*L^(-K))) P take
        (candidateBoxFiniteTest L (U*L^(-K)) (Icc 1 ⌊R*Real.exp L⌋₊)
          (fun u => typeIIMellinPhase ν u * ∑ m ∈ (2*u+1).divisors, α m*β ((2*u+1)/m))) ξ‖ ≤
        (2*U*V*L^(-D/2)) * ‖activeAllocationFourierWeight (candidateAllocationRadius r)
          (candidateAllocationActive c L r jStar) take ξ‖ := by
  obtain ⟨aE, aH, haE, haH, Kmin, hKmin, hsaved⟩ :=
    exists_candidate_original_energy_saving (A := A) (D := D) hc hb hr
  refine ⟨Kmin, hKmin, ?_⟩
  intro K hK
  have hK0 := hKmin.le.trans hK
  obtain ⟨C, hC, henergy⟩ := eventually_typeII_energy_le_of_retained_harmonic_bound (K := K)
  obtain ⟨F, hF, hsaved⟩ := hsaved K hK
  let Q := max 1 (D+K+2*aE+2*A+177+C)
  refine ⟨Q, F, lt_of_lt_of_le (by norm_num) (le_max_left _ _), hF, ?_⟩
  filter_upwards [hsaved, henergy, eventually_typeII_actual_dyadic_geometry hb hK0,
