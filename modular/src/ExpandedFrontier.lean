namespace Bounty

theorem physical_group_path_mass_restriction {G : Type*} [DecidableEq G] {J : ℕ}
    (V : G → ℝ) (groups : Finset G) (C : ℕ → G → Finset (Fin J)) (ell n : ℕ) :
    physicalGroupPathMass V groups C ell n =
      physicalStateMass (fun g : ↥groups => V g.val) J ell *
      ∏ j ∈ range n, physicalCompletionMass (fun g : ↥groups => V g.val)
        (fun g : ↥groups => C j g.val) ell := by
  rw [physical_group_path_mass_factors]
  unfold physicalStateMass physicalCompletionMass
  congr 1
  · exact (prod_coe_sort groups (fun g => 1 / (V g) ^ (J + ell))).symm
  · apply prod_congr rfl
    intro j hj
    exact (prod_coe_sort groups (fun g => 1 / (V g) ^ (ell + (C j g).card))).symm

