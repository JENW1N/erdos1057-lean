noncomputable def physicalRootSmallPlanSumCore
    (F : PhysicalMarkLists P J ell →
      (Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) → ℂ) : ℂ := by
  let := physicalLabeledPathFintype (P := P) (ell := ell) (n := n + 1) patterns C
  let e := physicalPathSmallPlanEquiv (P := P) (ell := ell) (n := n + 1)
    (fun g => g ∈ groupsᶜ) patterns C hC
  let := Fintype.ofEquiv _ e
  exact ∑ x, F (e.symm x).1 (e.symm x).2

noncomputable def physicalRootSmallPlanSum : ℂ :=
  physicalRootSmallPlanSumCore (n := n) groups patterns C hC
    (physicalRootMixedPathIntegrand groups patterns C V q ζ k K β B r θ)

omit [∀ a : PhysicalPrime P, NeZero a.2.val] in
theorem physical_root_small_plan_sum_core
    (F : PhysicalMarkLists P J ell →
      (Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) → ℂ) :
    let := physicalLabeledPathFintype (P := P) (ell := ell) (n := n + 1) patterns C
    (∑ L : PhysicalMarkLists P J ell,
      ∑ p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell, F L p) =
      physicalRootSmallPlanSumCore groups patterns C hC F := by
  let := physicalLabeledPathFintype (P := P) (ell := ell) (n := n + 1) patterns C
  let e := physicalPathSmallPlanEquiv (P := P) (ell := ell) (n := n + 1)
    (fun g => g ∈ groupsᶜ) patterns C hC
  let := Fintype.ofEquiv _ e
  have he := e.symm.sum_comp (fun x => F x.1 x.2)
  simpa only [physicalRootSmallPlanSumCore, Fintype.sum_prod_type] using! he.symm

theorem physical_root_mixed_sum_eq_small_plan :
    let := physicalLabeledPathFintype (P := P) (ell := ell) (n := n + 1) patterns C
