section

/- Actual simultaneous pair-sieve moments, with a direct lattice-error bound. -/

open Finset

namespace Bounty

def pairSieveBadEvent (rough banned : ℕ → Bool) (v : ℕ × ℕ) (p : ℕ) : Prop :=
  (rough p = true ∧ (v.1*v.2) % p = 0) ∨ (banned p = true ∧ (v.1*v.2) % p = 1 % p)

noncomputable def pairSieveBaseBox (A B C D m : ℕ) : Finset (ℕ × ℕ) :=
  (Finset.product (Ioc A B) (Ioc C D)).filter (fun v => (v.1*v.2) % m = 1 % m)

noncomputable def pairSieveIntersection (A B C D m : ℕ) (P : Finset ℕ)
    (rough banned : ℕ → Bool) : Finset (ℕ × ℕ) := by
  classical
  exact (pairSieveBaseBox A B C D m).filter
    (fun v => ∀ p ∈ P, pairSieveBadEvent rough banned v p)

theorem actual_pair_sieve_intersection_error (A B C D m : ℕ) [NeZero m]
    (hAB : A ≤ B) (hCD : C ≤ D) (P : Finset ℕ) (rough banned : ℕ → Bool)
    (hP : ∀ p ∈ P, p.Prime) (hPm : ∀ p ∈ P, ¬p ∣ m) :
    |((pairSieveIntersection A B C D m P rough banned).card : ℝ) -
      (((B : ℝ)-A)*((D : ℝ)-C)*(m.totient : ℝ)/(m : ℝ)^2) *
        ∏ p ∈ P, pairSieveDensity p (rough p) (banned p)| ≤
      (m : ℝ)*((∏ p ∈ P, p : ℕ) : ℝ)^2 +
        (((B : ℝ)-A)+((D : ℝ)-C))*((∏ p ∈ P, p : ℕ) : ℝ) := by
  classical
  let d := ∏ p ∈ P, p
  let N := m*d
  let R := natPairSieveResidues m (natPairBaseResidues m) P
    (fun p => natPairBadResidues p (rough p) (banned p))
  have hm : 0 < m := Nat.pos_of_ne_zero (NeZero.ne m)
  have hd : 0 < d := prod_pos (fun p hp => (hP p hp).pos)
  have hN : 0 < N := mul_pos hm hd
  have hset : (pairSieveBaseBox A B C D m).filter
        (fun v => ∀ p ∈ P, pairSieveBadEvent rough banned v p) =
      (Finset.product (Ioc A B) (Ioc C D)).filter (fun v : ℕ × ℕ => (v.1 % N, v.2 % N) ∈ R) := by
    rw [pairSieveBaseBox, filter_filter]
    apply filter_congr
    intro v _
    rw [nat_pair_sieve_residues_mod m (natPairBaseResidues m) P
      (fun p => natPairBadResidues p (rough p) (banned p)) hN v,
      nat_pair_base_mod_iff m hm]
    apply and_congr_right
    intro _
    apply forall_congr'
    intro p
    apply imp_congr_right
    intro hp
    exact (nat_pair_bad_mod_iff p (hP p hp).pos (rough p) (banned p) v.1 v.2).symm
  have hcount := interval_allowed_nat_residue_pairs_error A B C D N hN R
    (fun _ hv => nat_pair_sieve_residues_bounds m (natPairBaseResidues m) P _ hv) hAB hCD
  have hNcast : (N : ℝ) = (m : ℝ) * ∏ p ∈ P, (p : ℝ) := by simp only [N, d, Nat.cast_mul, Nat.cast_prod]
  have hdensity := actual_pair_sieve_residue_density m P rough banned hP hPm
  change (R.card : ℝ) / ((m : ℝ) * ∏ p ∈ P, (p : ℝ))^2 = _ at hdensity
  have hmean : (R.card : ℝ) * ((((B : ℝ)-A)/N) * (((D : ℝ)-C)/N)) =
      (((B : ℝ)-A)*((D : ℝ)-C)*(m.totient : ℝ)/(m : ℝ)^2) *
        ∏ p ∈ P, pairSieveDensity p (rough p) (banned p) := by
    calc
      _ = ((B : ℝ)-A)*((D : ℝ)-C)*((R.card : ℝ)/(N : ℝ)^2) := by ring
      _ = _ := by rw [hNcast, hdensity]; ring
  rw [hmean] at hcount
  rw [pairSieveIntersection, hset]
  apply hcount.trans
  have hR : (R.card : ℝ) ≤ (m : ℝ)*(d : ℝ)^2 := by
    exact_mod_cast actual_pair_sieve_residue_card_le m P rough banned hP hPm
  have hx : 0 ≤ (B : ℝ)-A := sub_nonneg.mpr (Nat.cast_le.mpr hAB)
  have hy : 0 ≤ (D : ℝ)-C := sub_nonneg.mpr (Nat.cast_le.mpr hCD)
  simpa only [N, Nat.cast_mul] using
    pair_lattice_crude_error (Nat.cast_pos.mpr hm) (Nat.cast_pos.mpr hd) hx hy hR

end Bounty
end

section

/- Extending selected physical rows to all raw states using their actual input cutoff. -/

open scoped Classical

namespace Bounty

theorem physical_mark_raw_extension_eq_of_total_cutoff
    {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (R : PhysicalMarkLists P J ell)
    (F : PhysicalBoundedMarkState P J ell B → ℂ)
    (G : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ)
    (hzero : ∀ s, B < globalBirthJointLength s → G s = 0)
    (hreadout : ∀ s, s.1 = R → F s = G (physicalMarkRawReadout s)) :
    physicalMarkRawExtension F R = G := by
  funext s
  unfold physicalMarkRawExtension
  by_cases hs : ∀ g, (s g).2.1 ≤ B
  · rw [dif_pos hs]
    exact hreadout
      (R, (fun g => (s g).1),
        fun g => ⟨⟨(s g).2.1, Nat.lt_succ_of_le (hs g)⟩, (s g).2.2⟩) rfl
  · rw [dif_neg hs]
    symm
    apply hzero
    by_contra htotal
    apply hs
    intro g
    exact (global_birth_joint_local_length_le_total s g).trans (Nat.le_of_not_gt htotal)

theorem physical_mark_raw_extension_eq_cutoff
    {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (R : PhysicalMarkLists P J ell)
    (F : PhysicalBoundedMarkState P J ell B → ℂ)
    (G : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ)
    (hreadout : ∀ s, s.1 = R →
      F s = globalBirthJointRawCutoff B G (physicalMarkRawReadout s)) :
    physicalMarkRawExtension F R = globalBirthJointRawCutoff B G := by
  apply physical_mark_raw_extension_eq_of_total_cutoff R F _ ?_ hreadout
  intro s hs
  simp only [globalBirthJointRawCutoff, if_neg (Nat.not_le_of_gt hs)]

end Bounty
end

section

/- All groups retain their tags in the cumulative birth ledger of the actual path. -/

open Finset
open scoped Classical
namespace Bounty
section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
  [∀ g, DecidableEq (P g)] (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ)

noncomputable def fullMixedLedgerTaggedImage
    (s : FullMixedLedgerState n (M := M) B) : Finset ((g : Fin N) × P g) :=
  univ.biUnion (fullMixedLedgerGroupImage n B s)

noncomputable def fullMixedLedgerPriorBirths (steps : List (Option (J ⊕ K)))
    (x : FullMixedLedgerState n (M := M) B)
    (p : FullMixedLedgerPath n S B A Δ D steps x) (cut : ℕ) :
    Finset ((g : Fin N) × P g) :=
  univ.biUnion fun a : FullMixedBirthAddress S B steps => if a.1.val < cut then
    (fullMixedLedgerPathBirthLabel n S B A Δ D steps x p a).toFinset else ∅

theorem mem_full_mixed_ledger_tagged (x : FullMixedLedgerState n (M := M) B)
    (z : (g : Fin N) × P g) :
    z ∈ fullMixedLedgerTaggedImage n B x ↔ z.2 ∈ x.1 z.1 := by
  rcases z with ⟨g, z⟩
  simp only [fullMixedLedgerTaggedImage, fullMixedLedgerGroupImage, mem_biUnion,
    mem_univ, true_and, mem_image]
  constructor
  · rintro ⟨h, y, hy, hzy⟩
    cases hzy
    exact hy
  · intro hz
    exact ⟨g, z, hz, rfl⟩

theorem mem_full_mixed_ledger_prior_births (steps : List (Option (J ⊕ K)))
    (x : FullMixedLedgerState n (M := M) B)
    (p : FullMixedLedgerPath n S B A Δ D steps x) (cut : ℕ) (z : (g : Fin N) × P g) :
    z ∈ fullMixedLedgerPriorBirths n S B A Δ D steps x p cut ↔
      ∃ a : FullMixedBirthAddress S B steps, a.1.val < cut ∧
        fullMixedLedgerPathBirthLabel n S B A Δ D steps x p a = some z := by
  simp only [fullMixedLedgerPriorBirths, mem_biUnion, mem_univ, true_and]
  apply exists_congr
  intro a
  split_ifs <;> simp_all only [Option.mem_toFinset, Option.mem_def,
    Finset.notMem_empty, false_and, true_and, iff_self]

theorem full_mixed_ledger_prior_births_eq_groups (steps : List (Option (J ⊕ K)))
    (x : FullMixedLedgerState n (M := M) B)
    (p : FullMixedLedgerPath n S B A Δ D steps x) (cut : ℕ) :
    fullMixedLedgerPriorBirths n S B A Δ D steps x p cut =
      univ.biUnion (fullMixedLedgerPriorGroupBirths n S B A Δ D steps x p cut) := by
  ext z
  rw [mem_full_mixed_ledger_prior_births]
  simp only [mem_biUnion, mem_univ, true_and, mem_full_mixed_prior_group_births]
  constructor
  · rintro ⟨⟨j, g, b⟩, hj, hb⟩
    exact ⟨g, j, hj, b, hb⟩
  · rintro ⟨g, j, hj, b, hb⟩
    exact ⟨⟨j, g, b⟩, hj, hb⟩

variable (ω : ∀ k c, A k c → ℝ) (μ : (g : Fin N) → P g → ℝ)
  (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

theorem full_mixed_ledger_tagged_union_before (steps : List (Option (J ⊕ K)))
    (x : FullMixedLedgerState n (M := M) B)
    (p : FullMixedLedgerPath n S B A Δ D steps x)
    (hx : FullMixedLedgerCovers n B x)
    (hp : finiteEventPathWeight
      (fun tag (s : FullMixedLedgerState n (M := M) B) =>
        FullPermutationMixedEvent n S B A Δ D tag s.2)
      (fullMixedLedgerTarget n S B A Δ D)
      (fun tag s => fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V tag s.2)
      steps x p ≠ 0) (i : Fin steps.length) :
    fullMixedLedgerTaggedImage n B
      (finiteEventPathOccurrence
        (fun tag (s : FullMixedLedgerState n (M := M) B) =>
          FullPermutationMixedEvent n S B A Δ D tag s.2)
        (fullMixedLedgerTarget n S B A Δ D) steps x p i).1 =
      fullMixedLedgerTaggedImage n B x ∪
        fullMixedLedgerPriorBirths n S B A Δ D steps x p i.val := by
  have hw := finite_event_path_occurrence_weight_ne_zero _ _ _ steps x p hp
  simp only [fullMixedLedgerTaggedImage, full_mixed_ledger_prior_births_eq_groups]
  ext z
  simp only [mem_biUnion, mem_univ, true_and, mem_union]
  have hg := fun g => full_mixed_ledger_group_union_before n S B A Δ D ω μ q ρ V
    steps x p hx hw i g
  simp_rw [hg, mem_union, exists_or]

theorem full_mixed_ledger_mem_before (steps : List (Option (J ⊕ K)))
    (x : FullMixedLedgerState n (M := M) B)
    (p : FullMixedLedgerPath n S B A Δ D steps x)
    (hx : FullMixedLedgerCovers n B x)
    (hp : finiteEventPathWeight
      (fun tag (s : FullMixedLedgerState n (M := M) B) =>
        FullPermutationMixedEvent n S B A Δ D tag s.2)
      (fullMixedLedgerTarget n S B A Δ D)
      (fun tag s => fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V tag s.2)
      steps x p ≠ 0) (i : Fin steps.length) (g : Fin N) (r : P g) :
    r ∈ (finiteEventPathOccurrence
        (fun tag (s : FullMixedLedgerState n (M := M) B) =>
          FullPermutationMixedEvent n S B A Δ D tag s.2)
        (fullMixedLedgerTarget n S B A Δ D) steps x p i).1.1 g ↔
      r ∈ x.1 g ∨ ∃ a : FullMixedBirthAddress S B steps, a.1.val < i.val ∧
        fullMixedLedgerPathBirthLabel n S B A Δ D steps x p a = some ⟨g, r⟩ := by
  have h := congrArg (fun H => (⟨g, r⟩ : (h : Fin N) × P h) ∈ H)
    (full_mixed_ledger_tagged_union_before n S B A Δ D ω μ q ρ V steps x p hx hp i)
  simpa only [mem_full_mixed_ledger_tagged, mem_union,
    mem_full_mixed_ledger_prior_births, eq_iff_iff] using h

end Full
end Bounty
end

section

/- The concrete weighted rows bound full original path mass, in particular at empty memory. -/

open Finset Classical

namespace Bounty

theorem productLengthLyapunov_one_le {G : Type*} [Fintype G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ} {v : ℝ} (hv : 1 ≤ v)
    (s : ProductBoundedOrderedState P Z M B) : 1 ≤ productLengthLyapunov v s := by
  rw [productLengthLyapunov_eq_total]
  exact one_le_pow₀ hv

theorem productLengthLyapunov_empty {G : Type*} [Fintype G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ} (v : ℝ)
    (s : ProductBoundedOrderedState P Z M B) (hs : productTotalMemory s = 0) :
    productLengthLyapunov v s = 1 := by
  rw [productLengthLyapunov_eq_total, hs, pow_zero]

section Root
variable {J K G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] {M : G → ℕ}
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
    (Δ D : ∀ k c, A k c → G → ℤ) (ω : ∀ k c, A k c → ℝ)
    (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ v vmin : ℝ) (V : G → ℝ)

theorem full_mixed_path_abs_bounded_observable_le
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : ∀ g, vmin ≤ V g)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (steps : List (Option (J ⊕ K)))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (F : FullPermutationMixedPath n S B A Δ D steps s → ℝ)
    {L : ℝ} (hL : 0 ≤ L) (hF : ∀ p, F p ≤ L) :
    fullMixedPathAbsIntegral n S B A Δ D ω μ q ρ V steps s F ≤
      (steps.map (fullMixedLengthRowFactor μ q ρ v vmin V T)).prod * (L * productLengthLyapunov v s) := by
  apply full_mixed_path_abs_integral_le_length n S B A Δ D ω μ q ρ v vmin V
    hω hωmass hμ hmass hq0 hq1 hρ0 hρ1 hv hvmin hV hD T ht steps s F hL
  intro p
  exact (hF p).trans (by simpa only [mul_one] using
    mul_le_mul_of_nonneg_left (productLengthLyapunov_one_le hv.le _) hL)

theorem full_mixed_path_abs_mass_le
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : ∀ g, vmin ≤ V g)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (steps : List (Option (J ⊕ K)))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    fullMixedPathAbsIntegral n S B A Δ D ω μ q ρ V steps s (fun _ => 1) ≤
      (steps.map (fullMixedLengthRowFactor μ q ρ v vmin V T)).prod * productLengthLyapunov v s := by
  simpa only [one_mul] using full_mixed_path_abs_bounded_observable_le n S B A Δ D ω μ q ρ v vmin V
    hω hωmass hμ hmass hq0 hq1 hρ0 hρ1 hv hvmin hV hD T ht steps s
    (fun _ => 1) zero_le_one (fun _ => le_rfl)

theorem full_mixed_empty_path_abs_mass_le
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : ∀ g, vmin ≤ V g)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (steps : List (Option (J ⊕ K)))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) (hs : productTotalMemory s = 0) :
    fullMixedPathAbsIntegral n S B A Δ D ω μ q ρ V steps s (fun _ => 1) ≤
      (steps.map (fullMixedLengthRowFactor μ q ρ v vmin V T)).prod := by
  simpa only [productLengthLyapunov_empty v s hs, mul_one] using
    full_mixed_path_abs_mass_le n S B A Δ D ω μ q ρ v vmin V
      hω hωmass hμ hmass hq0 hq1 hρ0 hρ1 hv hvmin hV hD T ht steps s

end Root

end Bounty
end

section

/- Full-cell prime proxies: support, positivity, exact mass, and uniform size. -/

open Finset Filter

namespace Bounty

noncomputable def primeCellProxy (L S Y : ℝ) (n : ℕ) : ℝ :=
  if n ∈ roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (Real.sqrt L)) then
    primeCellProxyCoefficient L S Y else 0

theorem prime_cell_proxy_nonneg (L S Y : ℝ) (n : ℕ) :
    0 ≤ primeCellProxy L S Y n := by
  unfold primeCellProxy primeCellProxyCoefficient
  split <;> positivity

theorem prime_cell_proxy_ne_zero_mem {L S Y : ℝ} {n : ℕ}
    (h : primeCellProxy L S Y n ≠ 0) :
    n ∈ roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (Real.sqrt L)) := by
  by_contra hn
  exact h (by simp only [primeCellProxy, if_neg hn])

theorem prime_cell_proxy_avoids_small_primes {L S Y : ℝ} {n : ℕ}
    (h : primeCellProxy L S Y n ≠ 0) :
    ∀ p ∈ primeBand 0 (Real.exp (Real.sqrt L)), ¬p ∣ n := by
  intro p hp hpn
  have hn := prime_cell_proxy_ne_zero_mem h
  have hpp : p.Prime := (mem_filter.mp hp).2
  have hpf : p ∈ n.primeFactors := Nat.mem_primeFactors.mpr
    ⟨hpp, hpn, (roughBand_pos hn).ne'⟩
  have hlarge := (mem_filter.mp hn).2 p hpf
  have hsmall : (p : ℝ) ≤ Real.exp (Real.sqrt L) :=
    (Nat.cast_le.mpr (mem_Ioc.mp (mem_filter.mp hp).1).2).trans
      (Nat.floor_le (Real.exp_pos _).le)
  exact (not_lt_of_ge hsmall) hlarge

theorem prime_cell_proxy_count_match {L S Y : ℝ}
    (hR : 0 < (roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (Real.sqrt L))).card) :
    (∑ n ∈ Ioc ⌊Y⌋₊ ⌊Real.exp (L^(-S))*Y⌋₊, primeCellProxy L S Y n) =
      ((primeBand Y (Real.exp (L^(-S))*Y)).card : ℝ) := by
  classical
  have hsubset : roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (Real.sqrt L)) ⊆
      Ioc ⌊Y⌋₊ ⌊Real.exp (L^(-S))*Y⌋₊ := fun _ hn => (mem_filter.mp hn).1
  rw [← sum_subset hsubset (fun n _ hn => by simp only [primeCellProxy, if_neg hn])]
  trans ∑ _n ∈ roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (Real.sqrt L)),
    primeCellProxyCoefficient L S Y
  · exact sum_congr rfl (fun n hn => by simp only [primeCellProxy, if_pos hn])
  simp only [sum_const, nsmul_eq_mul]
  unfold primeCellProxyCoefficient
  have hcard : ((roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (Real.sqrt L))).card : ℝ) ≠ 0 :=
    (Nat.cast_pos.mpr hR).ne'
  field_simp

theorem prime_cell_proxy_full_cell_zero_sum {L S Y : ℝ}
    (hR : 0 < (roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (Real.sqrt L))).card) :
    (∑ n ∈ Ioc ⌊Y⌋₊ ⌊Real.exp (L^(-S))*Y⌋₊,
      ((if n.Prime then 1 else 0 : ℝ)-primeCellProxy L S Y n)) = 0 := by
  classical
  rw [sum_sub_distrib, prime_cell_proxy_count_match hR, sum_boole]
  exact sub_self _

theorem exists_prime_cell_proxy_uniform_bound {a : ℝ} (ha : 0 < a) :
    ∃ C : ℝ, 0 < C ∧ ∀ S : ℝ, ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ,
      Real.exp (a*L) ≤ Y → ∀ n : ℕ,
        0 ≤ primeCellProxy L S Y n ∧ primeCellProxy L S Y n ≤ 1 ∧
        primeCellProxy L S Y n ≤
          C/(L*(∏ p ∈ primeBand 0 (Real.exp (Real.sqrt L)), (1-1/(p : ℝ)))) := by
  obtain ⟨C, hC, hbound⟩ := exists_prime_cell_proxy_bound ha
  refine ⟨C, hC, ?_⟩
  intro S
  filter_upwards [hbound S, eventually_gt_atTop (0 : ℝ)] with L hb hL
  intro Y hY n
  have hV : 0 < ∏ p ∈ primeBand 0 (Real.exp (Real.sqrt L)), (1-1/(p : ℝ)) :=
    finite_prime_avoidance_product_pos _ (fun _ hp => (mem_filter.mp hp).2)
  unfold primeCellProxy
  split
  · exact hb Y hY
  · exact ⟨le_rfl, zero_le_one, by positivity⟩

end Bounty
end

section

/- Literal clean-event masking by a fixed initial birth ledger.
Only fresh active draws are tested; the original auxiliary law and bans remain. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def cleanFullMemoryInitialEventAction {S G : Type*}
    [Fintype S] [Fintype G] [dG : DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    [∀ g (p : P g), NeZero p.val]
    (F : ∀ g, Finset (P g)) (V : G → ℝ) (b : ∀ g, P g → ℝ) (C : G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ)
    (D : SharedActiveLabels (fun g => ↥(P g)) (cleanFullSharedSlots (ell := ell) C) →
      PhysicalAuxLabels P C → G → ℤ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : CleanFullMemoryState P J ell B → PhysicalResidues Ps → ℂ)
    (x : CleanFullMemoryState P J ell B) (rs : PhysicalResidues Ps) : ℂ :=
  let source := (cleanFullMemoryEquiv P J ell B x).2.2.1
  let c := (productActiveMemorySplit (cleanFullSharedSlots C) B x).1
  let s := (productActiveMemorySplit (cleanFullSharedSlots C) B x).2
  let δ := fun c aux (_ : G) => -cleanFullSharedStep (P := P) (ell := ell) k C c aux d
  let Ψ := fun c aux (fresh : ∀ g, Fin (cleanFullSharedSlots (ell := ell) C g)ᶜ.card → P g) =>
    if repeatedBigAuxAvoids C aux source ∧
        repeatedBigAuxAvoids C aux (repeatedBigFill C source (cleanFullFreshEquiv P C fresh)) then
      K source (repeatedBigFill C source (cleanFullFreshEquiv P C fresh)) aux *
        physicalPhase ζ (cleanFullSharedD C c aux) *
        physicalReturnPhase θ (cleanFullSharedStep k C c aux d) *
        physicalPhase ζ (physicalSharedProduct d) else 0
  ∑ e : FullActiveEdgeEvent (fun g (q : P g) => q.val) (cleanFullSharedSlots C) B
      (fun _ => PhysicalAuxLabels P C) δ D x,
    (fullActiveEdgeEventWeight (fun g (q : P g) => q.val) (cleanFullSharedSlots C) B
      (fun _ => PhysicalAuxLabels P C) δ D (fun _ aux => physicalAuxMass V C aux)
      (fun g => tiltedPhysicalBirthLaw V g (b g)) ρ V x e : ℂ) *
    (if (∀ g, (e.2 g).1 = ∅ ∧ (e.2 g).2.1 = ∅) ∧
        (∀ g i, (e.2 g).2.2.2 i ∉ F g) then
      Ψ c e.1 (fun g => (unrestrictedJointEventTarget (fun g (q : P g) => q.val)
        (δ c e.1) (D c e.1) (fun g => (cleanFullSharedSlots C g)ᶜ.card) B s e.2 g).1)
      else 0) *
    f (fullActiveEdgeEventTarget (fun g (q : P g) => q.val) (cleanFullSharedSlots C) B
      (fun _ => PhysicalAuxLabels P C) δ D x e)
      (physicalTranslateResidues rs (cleanFullSharedStep k C c e.1 d))

theorem clean_full_memory_initial_event_action {S G : Type*}
    [Fintype S] [Fintype G] [dG : DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    [∀ g (p : P g), NeZero p.val]
    (F : ∀ g, Finset (P g)) (V : G → ℝ) (b : ∀ g, P g → ℝ) (C : G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ)
    (D : SharedActiveLabels (fun g => ↥(P g)) (cleanFullSharedSlots (ell := ell) C) →
      PhysicalAuxLabels P C → G → ℤ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : CleanFullMemoryState P J ell B → PhysicalResidues Ps → ℂ)
 :
    cleanFullMemoryInitialEventAction F V b C ζ θ ρ k D K d f =
      cleanFullMemoryEventAction V b C ζ θ ρ k D (cleanInitialBirthKernel F C K) d f := by
  funext x rs
  let source := (cleanFullMemoryEquiv P J ell B x).2.2.1
  let c := (productActiveMemorySplit (cleanFullSharedSlots C) B x).1
  let s := (productActiveMemorySplit (cleanFullSharedSlots C) B x).2
  let δ := fun c aux (_ : G) => -cleanFullSharedStep (P := P) (ell := ell) k C c aux d
  unfold cleanFullMemoryInitialEventAction cleanFullMemoryEventAction
  apply sum_congr rfl
  intro e _
  by_cases he : ∀ g, (e.2 g).1 = ∅ ∧ (e.2 g).2.1 = ∅
  · have hi := clean_initial_birth_allowed_event_target F C (δ c e.1) (D c e.1) source s e.2 he
    by_cases hF : ∀ g i, (e.2 g).2.2.2 i ∉ F g
    · have ha := hi.mpr hF
      dsimp only [source, c, s, δ] at ha
      rw [if_pos ⟨he, hF⟩, if_pos he]
      simp only [cleanInitialBirthKernel]
      rw [if_pos ha]
    · have ha := mt hi.mp hF
      dsimp only [source, c, s, δ] at ha
      rw [if_neg (not_and_of_not_right _ hF), if_pos he]
      simp only [cleanInitialBirthKernel]
      rw [if_neg ha]
      simp only [zero_mul, mul_zero, ite_self]
  · rw [if_neg (not_and_of_not_left _ he), if_neg he]

noncomputable def cleanFullMemoryInitialPatternEventAction {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G] [dG : DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    [∀ g (p : P g), NeZero p.val]
    (F : ∀ g, Finset (P g)) (V : G → ℝ) (b : ∀ g, P g → ℝ) (C : I → G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ)
    (D : ∀ i, SharedActiveLabels (fun g => ↥(P g)) (cleanFullSharedSlots (ell := ell) (C i)) →
      PhysicalAuxLabels P (C i) → G → ℤ)
    (K : ∀ i, RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : CleanFullMemoryState P J ell B → PhysicalResidues Ps → ℂ)
    (x : CleanFullMemoryState P J ell B) (rs : PhysicalResidues Ps) : ℂ :=
  ∑ i, cleanFullMemoryInitialEventAction F V b (C i) ζ θ ρ k (D i) (K i) d f x rs

theorem clean_full_memory_initial_pattern_event_action {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G] [dG : DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    [∀ g (p : P g), NeZero p.val]
    (F : ∀ g, Finset (P g)) (V : G → ℝ) (b : ∀ g, P g → ℝ) (C : I → G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ)
    (D : ∀ i, SharedActiveLabels (fun g => ↥(P g)) (cleanFullSharedSlots (ell := ell) (C i)) →
      PhysicalAuxLabels P (C i) → G → ℤ)
    (K : ∀ i, RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : CleanFullMemoryState P J ell B → PhysicalResidues Ps → ℂ)
 :
    cleanFullMemoryInitialPatternEventAction F V b C ζ θ ρ k D K d f =
      cleanFullMemoryPatternEventAction V b C ζ θ ρ k D
        (fun i => cleanInitialBirthKernel F (C i) (K i)) d f := by
  funext x rs
  unfold cleanFullMemoryInitialPatternEventAction cleanFullMemoryPatternEventAction
  apply sum_congr rfl
  intro i _
  exact congrFun (congrFun (clean_full_memory_initial_event_action F V b (C i) ζ θ ρ k
    (D i) (K i) d f) x) rs

theorem clean_full_memory_initial_pattern_action {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G] [dG : DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    [∀ g (p : P g), NeZero p.val]
    (F : ∀ g, Finset (P g)) (V : G → ℝ) (b : ∀ g, P g → ℝ) (C : I → G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ)
    (D : ∀ i, SharedActiveLabels (fun g => ↥(P g)) (cleanFullSharedSlots (ell := ell) (C i)) →
      PhysicalAuxLabels P (C i) → G → ℤ)
    (K : ∀ i, RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : CleanFullMemoryState P J ell B → PhysicalResidues Ps → ℂ)

    (hf : ∀ r, ProductMemorySymmetric (fun x => f x r)) :
    cleanFullMemoryInitialPatternEventAction F V b C ζ θ ρ k D K d f =
      cleanFullMemoryCutoff (cleanFullMemoryPatternDampedAction V b C ζ θ ρ k
        (fun i => cleanInitialBirthKernel F (C i) (K i)) d f) := by
  rw [clean_full_memory_initial_pattern_event_action]
  exact clean_full_memory_pattern_event_action V b C ζ θ ρ k D
    (fun i => cleanInitialBirthKernel F (C i) (K i)) d f hf

theorem clean_full_memory_initial_projected_action {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G] [dG : DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    [∀ g (p : P g), NeZero p.val]
    (F : ∀ g, Finset (P g)) (V : G → ℝ) (b : ∀ g, P g → ℝ) (C : I → G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ)
    (D : ∀ i, SharedActiveLabels (fun g => ↥(P g)) (cleanFullSharedSlots (ell := ell) (C i)) →
      PhysicalAuxLabels P (C i) → G → ℤ)
    (K : ∀ i, RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : CleanFullMemoryState P J ell B → PhysicalResidues Ps → ℂ)

    (hf : ∀ r, ProductMemorySymmetric (fun x => f x r)) :
    cleanFullMemoryActiveMap (cleanFullMemoryInitialPatternEventAction F V b C ζ θ ρ k D K d
