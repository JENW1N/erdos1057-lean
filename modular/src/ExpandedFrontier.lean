theorem physical_full_state_sum
    (F : ProductBoundedOrderedState (fun g => ↥(P g)) Z (fun _ => J + ell) B → ℂ) :
    (∑ L : PhysicalMarkLists P J ell, ∑ q : (g : G) → BoundedOrderedTuple (Z g) B,
