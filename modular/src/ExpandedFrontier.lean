section

/- Exact prime-divisibility moments within a residue class and their aggregate error. -/

open Finset

namespace Bounty

noncomputable def intervalResidueDivisibilityRemainder (A B r u d : ℕ) : ℝ :=
  (((Ioc A B).filter (fun n => n % r = u % r ∧ d ∣ n)).card : ℝ) -
    ((B : ℝ) - A) / (r * d : ℕ)

theorem coprime_prime_pool_product (P : Finset ℕ) (r : ℕ)
    (hP : ∀ p ∈ P, p.Prime) (hPr : ∀ p ∈ P, ¬p ∣ r) :
    r.Coprime (∏ p ∈ P, p) := by
  apply Nat.Coprime.prod_right
  intro p hp
  exact ((hP p hp).coprime_iff_not_dvd.mpr (hPr p hp)).symm

theorem interval_residue_prime_intersection_moment (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) (A B r u : ℕ) (S : Finset ℕ) (hS : S ⊆ P) :
    (∑ _n ∈ ((Ioc A B).filter (fun n => n % r = u % r)).filter
        (fun n => ∀ p ∈ S, p ∣ n), (1 : ℝ)) =
      (((B : ℝ) - A) / r) * (∏ p ∈ S, 1 / (p : ℝ)) +
        intervalResidueDivisibilityRemainder A B r u (∏ p ∈ S, p) := by
  have hfilter : ((Ioc A B).filter (fun n => n % r = u % r)).filter
        (fun n => ∀ p ∈ S, p ∣ n) =
      (Ioc A B).filter (fun n => n % r = u % r ∧ (∏ p ∈ S, p) ∣ n) := by
    rw [filter_filter]
    apply filter_congr
    intro n _
    rw [prime_subset_product_dvd_iff S (fun p hp => hP p (hS hp)) n]
  have hrecip : (∏ p ∈ S, 1 / (p : ℝ)) = 1 / ((∏ p ∈ S, p : ℕ) : ℝ) := by
    simp only [one_div, prod_inv_distrib, Nat.cast_prod]
  rw [hfilter, hrecip]
  simp only [sum_const, nsmul_eq_mul, mul_one, intervalResidueDivisibilityRemainder,
    Nat.cast_mul, div_mul_eq_div_mul_one_div]
  ring

theorem interval_residue_divisibility_remainder_abs_le_one (A B r u d : ℕ)
    (hAB : A ≤ B) (hr : 0 < r) (hd : 0 < d) (hcop : r.Coprime d) :
    |intervalResidueDivisibilityRemainder A B r u d| ≤ 1 :=
  interval_residue_divisibility_error_le_one A B r u d hAB hr hd hcop

theorem interval_residue_divisibility_remainder_sum_le (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) (r : ℕ) (hPr : ∀ p ∈ P, ¬p ∣ r)
    (A B u : ℕ) (hAB : A ≤ B) (hr : 0 < r) (D : ℝ) (hD : 0 ≤ D) :
    (∑ d ∈ blockSieveModuli P D, |intervalResidueDivisibilityRemainder A B r u d|) ≤ D := by
  have hcop := coprime_prime_pool_product P r hP hPr
  calc
    _ ≤ ∑ _d ∈ blockSieveModuli P D, (1 : ℝ) := by
      apply sum_le_sum
      intro d hd
      have hprop := block_sieve_modulus_properties P hP D hd
      exact interval_residue_divisibility_remainder_abs_le_one A B r u d hAB hr hprop.1
        (hcop.of_dvd_right hprop.2.2.2)
    _ = ((blockSieveModuli P D).card : ℝ) := by simp
    _ ≤ ((Icc 1 ⌊D⌋₊).card : ℝ) := by
      exact_mod_cast card_le_card (filter_subset (fun d => d ∣ ∏ p ∈ P, p) (Icc 1 ⌊D⌋₊))
    _ = (⌊D⌋₊ : ℝ) := by simp
    _ ≤ D := Nat.floor_le hD

end Bounty

end

section

/- Rescaling the wide candidate interval to the Carmichael counting scale. -/

open Filter

namespace Bounty

/-- The prime supply produced by the product window `(X,16X]` after the
shift `u ↦ 2u+1`. This is an input contract until the construction is closed. -/
def WideSmoothShiftedPrimeSupply : Prop :=
  ∀ δ : ℝ, 0 < δ → δ < 1 / 4 → ∀ σ : ℝ, 0 < σ →
    ∀ᶠ x : ℝ in atTop, ∃ P : Finset ℕ,
      P ⊆ primeBand (2 * x) (33 * x) ∧ x ^ (1 - σ) ≤ (P.card : ℝ) ∧
      ∀ p ∈ P, ∀ q : ℕ, q.Prime → q ∣ p - 1 → (q : ℝ) ≤ x ^ δ

theorem eventually_rescaled_rpow_lower {k σ : ℝ} (hk : 0 < k)
    (hσ : 0 < σ) (a : ℝ) :
    ∀ᶠ y : ℝ in atTop, y ^ (a - σ) ≤ (y / k) ^ (a - σ / 2) := by
  filter_upwards [eventually_const_le_mul_rpow (by linarith : 0 < σ / 2)
    (by norm_num : (0 : ℝ) < 1) (k ^ (a - σ / 2)),
    eventually_gt_atTop (0 : ℝ)] with y hy hy0
  have hmul := mul_le_mul_of_nonneg_left hy (Real.rpow_nonneg hy0.le (a - σ))
  rw [one_mul] at hmul
  have heq : y ^ (a - σ) * y ^ (σ / 2) = y ^ (a - σ / 2) := by
    rw [← Real.rpow_add hy0]
    congr 1
    ring
  rw [heq] at hmul
  rw [Real.div_rpow hy0.le hk.le]
  exact (le_div_iff₀ (Real.rpow_pos_of_pos hk _)).mpr hmul

theorem eventually_rpow_le_quarter {δ : ℝ} (hδ : δ < 1) :
    ∀ᶠ y : ℝ in atTop, y ^ δ ≤ y / 4 := by
  filter_upwards [eventually_const_le_mul_rpow (by linarith : 0 < 1 - δ)
    (by norm_num : (0 : ℝ) < 1) 4,
    eventually_gt_atTop (0 : ℝ)] with y hy hy0
  have hmul := mul_le_mul_of_nonneg_left hy (Real.rpow_nonneg hy0.le δ)
  rw [one_mul] at hmul
  have heq : y ^ δ * y ^ (1 - δ) = y := by
    rw [← Real.rpow_add hy0]
    have hexp : δ + (1 - δ) = 1 := by ring
    rw [hexp, Real.rpow_one]
  rw [heq] at hmul
  linarith

/-- The loss from rescaling is absorbed by half the freely chosen power loss. -/
theorem wide_smooth_supply_rescaled (hS : WideSmoothShiftedPrimeSupply)
    {δ σ : ℝ} (hδ : 0 < δ) (hδsmall : δ < 1 / 4) (hσ : 0 < σ) :
    ∀ᶠ y : ℝ in atTop, ∃ P : Finset ℕ,
      P ⊆ primeBand (y / 4) (5 * y) ∧ y ^ (1 - σ) ≤ (P.card : ℝ) ∧
      ∀ p ∈ P, ∀ q : ℕ, q.Prime → q ∣ p - 1 → (q : ℝ) ≤ y ^ δ := by
  have ht : Tendsto (fun y : ℝ => y / 8) atTop atTop :=
    Filter.Tendsto.atTop_div_const (by norm_num) tendsto_id
  filter_upwards [ht.eventually (hS δ hδ hδsmall (σ / 2) (by linarith)),
    eventually_rescaled_rpow_lower (by norm_num : (0 : ℝ) < 8) hσ 1,
    eventually_ge_atTop (1 : ℝ)] with y hSy hcard hy
  obtain ⟨P, hP, hN, hsmooth⟩ := hSy
  have hy0 : 0 ≤ y := by linarith
  refine ⟨P, ?_, hcard.trans hN, ?_⟩
  · intro p hp
    obtain ⟨hpp, hlo, hhi⟩ := (mem_primeBand_iff (by positivity) (by positivity) p).mp (hP hp)
    exact (mem_primeBand_iff (by positivity) (by positivity) p).mpr
      ⟨hpp, by linarith, by linarith⟩
  · intro p hp q hq hdiv
    exact (hsmooth p hp q hq hdiv).trans
      (Real.rpow_le_rpow (by positivity) (by linarith : y / 8 ≤ y) hδ.le)

/-- Ambient cancellation on the wide interval used after rescaling. -/
def WideAmbientPrimeCancellationAt (β : ℝ) : Prop :=
  ∀ δ : ℝ, 0 < δ → δ < 1 / 16 → ∀ σ : ℝ, 0 < σ →
    ∀ᶠ y : ℝ in atTop, ∀ L : ℕ, 0 < L →
      Real.log (L : ℝ) ≤ y ^ δ * Real.log (5 * y) →
      ∀ χ : DirichletCharacter ℂ L, χ ≠ 1 →
        ‖∑ p ∈ primeBand (y / 4) (5 * y), χ (p : ZMod L)‖ ≤
          y ^ (β + 2 * δ + σ)

/-- A wide smooth supply gives the same reservoir contract as the original
narrow supply. The final counting theorem therefore needs no modification. -/
theorem powerPrimeReservoir_of_wide_analytic_inputs_at {β : ℝ}
    (hS : WideSmoothShiftedPrimeSupply) (hC : WideAmbientPrimeCancellationAt β)
    {δ σ : ℝ} (hδ : 0 < δ) (hδsmall : δ < 1 / 16) (hσ : 0 < σ) :
    ∀ᶠ y : ℝ in atTop, PowerPrimeReservoirAt β δ σ y := by
  filter_upwards [wide_smooth_supply_rescaled hS hδ (by linarith) hσ,
    hC δ hδ hδsmall σ hσ,
    eventually_unitGroup_log_natLog_le_rpow δ hσ,
    eventually_rpow_le_quarter (by linarith : δ < 1),
    eventually_ge_atTop (1 : ℝ)] with y hSy hCy hGy hquarter hy
  obtain ⟨P, hPS, hPcard, hPsmooth⟩ := hSy
  have hy0 : 0 ≤ y := by linarith
  have hprime : ∀ p ∈ primeBand (y / 4) (5 * y), p.Prime := by
    intro p hp
    exact ((mem_primeBand_iff (by positivity) (by positivity) p).mp hp).1
  have hinterval : ∀ p ∈ primeBand (y / 4) (5 * y),
      y / 4 < (p : ℝ) ∧ (p : ℝ) ≤ 5 * y := by
    intro p hp
    exact ((mem_primeBand_iff (by positivity) (by positivity) p).mp hp).2
  obtain ⟨L, g, hL, hdiv, _, hlog, _, hcompat⟩ :=
    exists_real_smooth_prime_modulus_above_smoothness hy P (primeBand (y / 4) (5 * y))
      hPS hprime (fun p hp => (hinterval p hp).2)
      (fun p hp => hquarter.trans_lt (hinterval p hp).1) hPsmooth
  obtain ⟨hGlog, hGnatlog⟩ := hGy L hL hlog
  refine ⟨L, primeBand (y / 4) (5 * y), P, g, hL, hPS, hprime,
    (fun p hp => (hinterval p hp).2), hdiv,
    (fun p hp => hcompat p (hPS hp)), hPcard, hGlog, hGnatlog, ?_⟩
  intro ξ hξ
  exact unitCharacter_sum_bound_of_dirichlet (primeBand (y / 4) (5 * y)) g hcompat
    (hCy L hL hlog) ξ hξ

theorem target_of_wide_smooth_supply_and_cancellation {β : ℝ} (hβ : β < 1)
    (hS : WideSmoothShiftedPrimeSupply) (hC : WideAmbientPrimeCancellationAt β) :
    fcTypeOfName% "Erdos1057.erdos_1057" := by
  apply target_of_power_prime_reservoirs_at hβ
  intro δ hδ hδsmall σ hσ
  exact powerPrimeReservoir_of_wide_analytic_inputs_at hS hC hδ hδsmall hσ

end Bounty
end

section

/- The original signed raw rows preserve multiplication of their entire
continuation by a complex scalar, including every cutoff. -/

open Finset
namespace Bounty

theorem global_birth_raw_step_row_mul {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)]
    {a b : P → Bool} (step : GlobalBirthRawStep (R := R) a b)
    (c : ℂ) (F : GlobalBirthHistoryState R → ℂ) (s : GlobalBirthHistoryState R) :
    globalBirthRawStepRow step (fun H q => c * F (H, q)) s.1 s.2 =
      c * globalBirthRawStepRow step (fun H q => F (H, q)) s.1 s.2 := by
  rw [global_birth_raw_step_event_sum step s (fun t => c * F t),
    global_birth_raw_step_event_sum step s F, mul_sum]
  apply sum_congr rfl
  intro e _
  ring

theorem global_birth_joint_raw_cutoff_mul {N : ℕ} {P : Fin N → Type*}
    {R : (g : Fin N) → P g → Type*} (B : ℕ)
    (c : ℂ) (F : GlobalBirthJointState R → ℂ) :
    globalBirthJointRawCutoff B (fun s => c * F s) =
      fun s => c * globalBirthJointRawCutoff B F s := by
  funext s
  unfold globalBirthJointRawCutoff
  split_ifs <;> simp only [mul_zero]

theorem joint_raw_tensor_cutoff_mul {N : ℕ} {P : Fin N → Type*}
    {R : (g : Fin N) → P g → Type*} (B : ℕ)
    (row : (g : Fin N) → (GlobalBirthHistoryState (R g) → ℂ) →
      GlobalBirthHistoryState (R g) → ℂ)
    (hrow : ∀ g c F s, row g (fun t => c * F t) s = c * row g F s)
    (c : ℂ) (F : GlobalBirthJointState R → ℂ) (s : GlobalBirthJointState R) :
    jointRawTensorCutoff B row (fun t => c * F t) s =
      c * jointRawTensorCutoff B row F s := by
  unfold jointRawTensorCutoff
  rw [global_birth_joint_raw_cutoff_mul]
  have he : finTensorRow N row (fun u => c * globalBirthJointRawCutoff B F u) =
      (fun t => c * finTensorRow N row (globalBirthJointRawCutoff B F) t) := by
    funext t
    exact fin_tensor_row_mul_left N row hrow c _ t
  rw [he, global_birth_joint_raw_cutoff_mul]

theorem joint_raw_tensor_cutoff_zero {N : ℕ} {P : Fin N → Type*}
    {R : (g : Fin N) → P g → Type*} (B : ℕ)
    (row : (g : Fin N) → (GlobalBirthHistoryState (R g) → ℂ) →
      GlobalBirthHistoryState (R g) → ℂ)
    (hrow : ∀ g c F s, row g (fun t => c * F t) s = c * row g F s)
    (s : GlobalBirthJointState R) : jointRawTensorCutoff B row (fun _ => 0) s = 0 := by
  simpa only [zero_mul] using joint_raw_tensor_cutoff_mul B row hrow 0 (fun _ => 0) s

end Bounty
end

section

/- Exact finite Buchstab decomposition with repeated prime factors retained. -/

open Finset

namespace Bounty

theorem weighted_buchstab_identity {M : Type*} [AddCommMonoid M]
    (S : Finset ℕ) (N : ℕ) (w : ℕ → M) {z : ℝ} (hz : 0 ≤ z)
    (hSlo : ∀ n ∈ S, 2 ≤ n) (hShi : ∀ n ∈ S, n ≤ N)
    (hrough : ∀ n ∈ S, ∀ p ∈ n.primeFactors, z < (p : ℝ)) :
    (∑ n ∈ S, w n) = (∑ n ∈ S.filter Nat.Prime, w n) +
      ∑ p ∈ primeBand z (N : ℝ), ∑ m ∈ buchstabCompositeCofactors S N p, w (p*m) := by
  classical
  let C := S.filter (fun n => ¬n.Prime)
  have hmap : ∀ n ∈ C, n.minFac ∈ primeBand z (N : ℝ) := by
    intro n hn
    have hnS := (mem_filter.mp hn).1
    have hnlo := hSlo n hnS
    have hn0 : n ≠ 0 := by omega
    have hn1 : n ≠ 1 := by omega
    have hp := Nat.minFac_prime hn1
    apply (mem_primeBand_iff hz (Nat.cast_nonneg N) _).mpr
    refine ⟨hp, hrough n hnS n.minFac ?_, ?_⟩
    · exact Nat.mem_primeFactors.mpr ⟨hp, Nat.minFac_dvd n, hn0⟩
    · exact_mod_cast (Nat.minFac_le (by omega : 0 < n)).trans (hShi n hnS)
  have hfib := sum_fiberwise_of_maps_to (s := C) (t := primeBand z (N : ℝ))
    (g := Nat.minFac) hmap w
  have hcomposite : (∑ n ∈ C, w n) =
      ∑ p ∈ primeBand z (N : ℝ), ∑ m ∈ buchstabCompositeCofactors S N p, w (p*m) := by
    rw [← hfib]
    apply sum_congr rfl
    intro p hp
    have hpprime := ((mem_primeBand_iff hz (Nat.cast_nonneg N) p).mp hp).1
    have hfilter : C.filter (fun n => n.minFac = p) = S.filter (fun n => ¬n.Prime ∧ n.minFac = p) := by
      simp only [C, filter_filter]
    rw [hfilter, buchstab_minFac_fiber_image S hpprime hSlo hShi, sum_image]
    intro a _ b _ hab
    exact Nat.eq_of_mul_eq_mul_left hpprime.pos hab
  have hsplit := sum_filter_add_sum_filter_not S Nat.Prime w
  change (∑ n ∈ S.filter Nat.Prime, w n) + (∑ n ∈ C, w n) = ∑ n ∈ S, w n at hsplit
  rw [hcomposite] at hsplit
  exact hsplit.symm

theorem finite_buchstab_count (S : Finset ℕ) (N : ℕ) {z : ℝ} (hz : 0 ≤ z)
    (hSlo : ∀ n ∈ S, 2 ≤ n) (hShi : ∀ n ∈ S, n ≤ N)
    (hrough : ∀ n ∈ S, ∀ p ∈ n.primeFactors, z < (p : ℝ)) :
    S.card = (S.filter Nat.Prime).card +
      ∑ p ∈ primeBand z (N : ℝ), (buchstabCompositeCofactors S N p).card := by
  simpa only [sum_const, nsmul_eq_mul, mul_one, Nat.cast_id] using
    weighted_buchstab_identity S N (fun _ => (1 : ℕ)) hz hSlo hShi hrough

end Bounty
end

section

/- The two-variable sieve densities and their elementary Euler-factor bounds. -/

namespace Bounty

noncomputable def pairSieveBadResidues (p : ℕ) [NeZero p] (rough banned : Bool) :
    Finset (ZMod p × ZMod p) := by
  classical
  exact Finset.univ.filter (fun v =>
    (rough = true ∧ v.1*v.2 = 0) ∨ (banned = true ∧ v.1*v.2 = 1))

noncomputable def pairSieveDensity (p : ℕ) (rough banned : Bool) : ℝ :=
  ((if rough then 2*(p : ℝ)-1 else 0) + (if banned then (p : ℝ)-1 else 0)) / (p : ℝ)^2

theorem pair_sieve_density_eq_card (p : ℕ) [Fact p.Prime] (rough banned : Bool) :
    ((pairSieveBadResidues p rough banned).card : ℝ) / (p : ℝ)^2 =
      pairSieveDensity p rough banned := by
  have hp : 2 ≤ p := (Fact.out : p.Prime).two_le
  have hp1 : 1 ≤ p := by omega
  have hp2 : 1 ≤ 2*p := by omega
  have hp3 : 2 ≤ 3*p := by omega
  have h00 : pairSieveBadResidues p false false = ∅ := by
    ext v
    simp [pairSieveBadResidues]
  have h01 : pairSieveBadResidues p false true =
      (Finset.univ : Finset (ZMod p × ZMod p)).filter (fun v => v.1*v.2 = 1) := by
    ext v
    simp [pairSieveBadResidues]
  have h10 : pairSieveBadResidues p true false =
      (Finset.univ : Finset (ZMod p × ZMod p)).filter (fun v => v.1*v.2 = 0) := by
    ext v
    simp [pairSieveBadResidues]
  have h11 : pairSieveBadResidues p true true =
      (Finset.univ : Finset (ZMod p × ZMod p)).filter
        (fun v => v.1*v.2 = 0 ∨ v.1*v.2 = 1) := by
    ext v
    simp [pairSieveBadResidues]
  cases rough <;> cases banned
  · simp [h00, pairSieveDensity]
  · rw [h01, prime_mul_one_pair_card]
    simp [pairSieveDensity, Nat.cast_sub hp1]
  · rw [h10, prime_mul_zero_pair_card]
    simp [pairSieveDensity, Nat.cast_sub hp2]
  · rw [h11, prime_zero_or_one_pair_card]
    simp [pairSieveDensity, Nat.cast_sub hp3]
    ring

theorem pair_sieve_density_bounds {p : ℕ} (hp : 3 ≤ p) (rough banned : Bool) :
    0 ≤ pairSieveDensity p rough banned ∧
      pairSieveDensity p rough banned ≤ 7/9 ∧ pairSieveDensity p rough banned ≤ 3/(p : ℝ) := by
  have hpR : (3 : ℝ) ≤ p := by exact_mod_cast hp
  have hp0 : (0 : ℝ) < p := by linarith
  have hp2 : (0 : ℝ) < (p : ℝ)^2 := sq_pos_of_pos hp0
  have hq : 0 ≤ ((p : ℝ)-3) * (7*(p : ℝ)-6) := mul_nonneg (by linarith) (by linarith)
  cases rough <;> cases banned <;> dsimp [pairSieveDensity] <;>
    refine ⟨?_, ?_, ?_⟩
  all_goals first
    | exact div_nonneg (by linarith) hp2.le
    | apply (div_le_iff₀ hp2).mpr; nlinarith
    | apply (div_le_div_iff₀ hp2 hp0).mpr; nlinarith

theorem pair_sieve_unbanned_rough_factor (p : ℕ) (hp : p ≠ 0) :
    1 - pairSieveDensity p true false = (1 - 1/(p : ℝ))^2 := by
  have hpR : (p : ℝ) ≠ 0 := by exact_mod_cast hp
  dsimp [pairSieveDensity]
  field_simp
  ring

theorem pair_sieve_banned_rough_factor_le {p : ℕ} (hp : 3 ≤ p) :
    1 - pairSieveDensity p true true ≤ (1 - 1/(p : ℝ))^3 := by
  have hpR : (3 : ℝ) ≤ p := by exact_mod_cast hp
  have hp0 : (0 : ℝ) < p := by linarith
  have ht : 0 ≤ 1 - 1/(p : ℝ) := sub_nonneg.mpr ((div_le_one hp0).mpr (by linarith))
  have hid : (1 - 1/(p : ℝ))^3 - (1 - pairSieveDensity p true true) =
      (1/(p : ℝ))^2 * (1 - 1/(p : ℝ)) := by
    dsimp [pairSieveDensity]
    field_simp
    ring
  have hnn := mul_nonneg (sq_nonneg (1/(p : ℝ))) ht
  linarith

theorem pair_sieve_banned_factor_le {p : ℕ} (hp : 3 ≤ p) :
    1 - pairSieveDensity p false true ≤
      (1 - 1/(p : ℝ)) * (1 + 2/(p : ℝ)^2) := by
  have hpR : (3 : ℝ) ≤ p := by exact_mod_cast hp
  have hp0 : (0 : ℝ) < p := by linarith
  have ht : 0 ≤ 1 - 2/(p : ℝ) := sub_nonneg.mpr ((div_le_one hp0).mpr (by linarith))
  have hid : (1 - 1/(p : ℝ)) * (1 + 2/(p : ℝ)^2) -
      (1 - pairSieveDensity p false true) = (1/(p : ℝ))^2 * (1 - 2/(p : ℝ)) := by
    dsimp [pairSieveDensity]
    field_simp
    ring
  have hnn := mul_nonneg (sq_nonneg (1/(p : ℝ))) ht
  linarith

end Bounty
end

section

/- A uniform lattice error for one residue pair in a rectangular interval. -/

open Finset

namespace Bounty

theorem product_count_error_le {a b x y : ℝ} (hx : 0 ≤ x) (hy : 0 ≤ y)
    (ha : |a-x| ≤ 1) (hb : |b-y| ≤ 1) :
    |a*b-x*y| ≤ 1+x+y := by
  have hid : a*b-x*y = ((a-x)*(b-y)+x*(b-y))+y*(a-x) := by ring
  have htriangle := (abs_add_le ((a-x)*(b-y)+x*(b-y)) (y*(a-x))).trans
    (add_le_add (abs_add_le ((a-x)*(b-y)) (x*(b-y))) le_rfl)
  rw [← hid] at htriangle
  simp only [abs_mul, abs_of_nonneg hx, abs_of_nonneg hy] at htriangle
  have h1 := mul_le_mul ha hb (abs_nonneg (b-y)) (by norm_num : (0 : ℝ) ≤ 1)
  have h2 := mul_le_mul_of_nonneg_left hb hx
  have h3 := mul_le_mul_of_nonneg_left ha hy
  nlinarith

theorem interval_residue_pair_count_error (A B C D r u v : ℕ)
    (hAB : A ≤ B) (hCD : C ≤ D) (hr : 0 < r) :
    |(((Finset.product (Ioc A B) (Ioc C D)).filter
        (fun n : ℕ × ℕ => n.1 % r = u % r ∧ n.2 % r = v % r)).card : ℝ) -
      (((B : ℝ)-A)/r) * (((D : ℝ)-C)/r)| ≤
      1 + ((B : ℝ)-A)/r + ((D : ℝ)-C)/r := by
  have hset : (Finset.product (Ioc A B) (Ioc C D)).filter
        (fun n : ℕ × ℕ => n.1 % r = u % r ∧ n.2 % r = v % r) =
      Finset.product ((Ioc A B).filter (fun n : ℕ => n % r = u % r))
        ((Ioc C D).filter (fun n : ℕ => n % r = v % r)) := by
    ext n
    simp only [Finset.product_eq_sprod, mem_filter, mem_product]
    tauto
  rw [hset, Finset.product_eq_sprod, card_product, Nat.cast_mul]
  exact product_count_error_le
    (div_nonneg (sub_nonneg.mpr (Nat.cast_le.mpr hAB)) (Nat.cast_nonneg r))
    (div_nonneg (sub_nonneg.mpr (Nat.cast_le.mpr hCD)) (Nat.cast_nonneg r))
    (interval_residue_error_le_one A B r u hAB hr)
    (interval_residue_error_le_one C D r v hCD hr)

end Bounty
end

section

/- Uniform logarithmic product bounds for subsets of bounded group probes. -/

open Finset Filter
open scoped Classical

namespace Bounty

theorem grouped_probe_subset_card_le {G : Type*} [Fintype G] [DecidableEq G]
    {I : G → Type*} [∀ g, DecidableEq (I g)]
    (r : Finset G) (probes : ∀ g, Finset (I g)) (m : ℕ)
    (hm : ∀ g, (probes g).card ≤ m)
    (U : Finset (Sigma I)) (hU : U ⊆ r.sigma probes) :
    U.card ≤ Fintype.card G * m := by
  calc
    U.card ≤ (univ.sigma probes).card :=
      card_le_card (hU.trans (sigma_mono (subset_univ _) (fun _ => Subset.rfl)))
    _ = ∑ g, (probes g).card := card_sigma _ _
    _ ≤ ∑ _g : G, m := sum_le_sum (fun g _ => hm g)
    _ = _ := by simp

theorem prime_subset_product_log_le {G : Type*} [Fintype G] [DecidableEq G]
    {I : G → Type*} [∀ g, DecidableEq (I g)]
    (P : G → Finset ℕ) (r : Finset G) (probes : ∀ g, Finset (I g)) (m : ℕ)
    (hm : ∀ g, (probes g).card ≤ m)
    {B D L : ℝ} (hB : 0 ≤ B)
    (hpos : ∀ g p, p ∈ P g → 0 < p)
    (hlog : ∀ g p, p ∈ P g → Real.log p ≤ B)
    (hcard : (Fintype.card G : ℝ) ≤ D * Real.log L)
    (U : Finset (Sigma I)) (hU : U ⊆ r.sigma probes)
    (a : ∀ i : U, P i.val.fst) :
    Real.log (∏ i : U, (a i).val : ℕ) ≤ (D * (m : ℝ)) * B * Real.log L := by
  have hp : ∀ i ∈ (univ : Finset U), ((a i).val : ℝ) ≠ 0 := by
    intro i _
    exact_mod_cast (hpos i.val.fst (a i).val (a i).property).ne'
  have hc : (U.card : ℝ) ≤ (Fintype.card G : ℝ) * (m : ℝ) := by
    exact_mod_cast grouped_probe_subset_card_le r probes m hm U hU
  calc
    _ = ∑ i : U, Real.log ((a i).val : ℝ) := by rw [Nat.cast_prod, Real.log_prod hp]
    _ ≤ ∑ _i : U, B := sum_le_sum (fun i _ => hlog i.val.fst (a i).val (a i).property)
    _ = (U.card : ℝ) * B := by simp
    _ ≤ ((Fintype.card G : ℝ) * (m : ℝ)) * B := mul_le_mul_of_nonneg_right hc hB
    _ ≤ ((D * Real.log L) * (m : ℝ)) * B :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hcard (Nat.cast_nonneg m)) hB
    _ = _ := by ring

theorem eventually_prime_subset_product_log_rpow (D s ε : ℝ) (m : ℕ)
    (hs : 0 ≤ s) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop,
    ∀ {G : Type*} [Fintype G] [DecidableEq G]
      {I : G → Type*} [∀ g, DecidableEq (I g)]
      (P : G → Finset ℕ) (r : Finset G) (probes : ∀ g, Finset (I g)),
    (∀ g, (probes g).card ≤ m) →
    (∀ g p, p ∈ P g → 0 < p) →
    (∀ g p, p ∈ P g → Real.log p ≤ L ^ s) →
    (Fintype.card G : ℝ) ≤ D * Real.log L →
    ∀ (U : Finset (Sigma I)), U ⊆ r.sigma probes →
    ∀ a : (∀ i : U, P i.val.fst), Real.log (∏ i : U, (a i).val : ℕ) ≤ L ^ (s + ε) := by
  filter_upwards [eventually_mul_rpow_log_add_le_rpow (a := s) (b := s + ε)
    (c := 1) (by linarith) (by linarith) (by norm_num) (D * (m : ℝ)) 0,
    eventually_gt_atTop (0 : ℝ)] with L hbound hL
  intro G _ _ I _ P r probes hm hpos hlog hcard U hU a
  exact (prime_subset_product_log_le P r probes m hm
    (Real.rpow_nonneg hL.le s) hpos hlog hcard U hU a).trans
    (by simpa only [add_zero, one_mul] using hbound)

end Bounty
end

section

/- Exact Chinese-remainder factorization for arbitrary allowed residue-pair sets. -/

open Finset

namespace Bounty

noncomputable def pairChineseRemainder {m n : ℕ} (h : m.Coprime n) :
    (ZMod (m*n) × ZMod (m*n)) ≃ ((ZMod m × ZMod m) × (ZMod n × ZMod n)) :=
  { toFun := fun v => (((ZMod.chineseRemainder h v.1).1, (ZMod.chineseRemainder h v.2).1),
      ((ZMod.chineseRemainder h v.1).2, (ZMod.chineseRemainder h v.2).2))
    invFun := fun v => ((ZMod.chineseRemainder h).symm (v.1.1, v.2.1),
      (ZMod.chineseRemainder h).symm (v.1.2, v.2.2))
    left_inv := fun v => by simp
    right_inv := fun v => by simp }

theorem pair_chineseRemainder_natCast {m n : ℕ} (h : m.Coprime n) (a b : ℕ) :
    pairChineseRemainder h ((a : ZMod (m*n)), (b : ZMod (m*n))) =
      (((a : ZMod m), (b : ZMod m)), ((a : ZMod n), (b : ZMod n))) := by
  simp [pairChineseRemainder]

theorem pair_chineseRemainder_allowed_card {m n : ℕ} [NeZero m] [NeZero n]
    (h : m.Coprime n) (S : Finset (ZMod m × ZMod m)) (T : Finset (ZMod n × ZMod n)) :
    ((univ : Finset (ZMod (m*n) × ZMod (m*n))).filter
      (fun v => (pairChineseRemainder h v).1 ∈ S ∧ (pairChineseRemainder h v).2 ∈ T)).card =
      S.card * T.card := by
  classical
  rw [← Finset.card_product S T]
  apply card_bij (fun v _ => pairChineseRemainder h v)
  · intro v hv
    exact mem_product.mpr (mem_filter.mp hv).2
  · intro v _ w _ hvw
    exact (pairChineseRemainder h).injective hvw
  · intro v hv
    refine ⟨(pairChineseRemainder h).symm v, ?_, (pairChineseRemainder h).apply_symm_apply v⟩
    apply mem_filter.mpr
    exact ⟨mem_univ _, by simpa only [Equiv.apply_symm_apply] using mem_product.mp hv⟩

end Bounty
end

section

/- Equality of finite row compositions uses only rows actually traversed.
For a constant state space, visit/three-row grouping needs no terminal casts. -/

namespace Bounty

theorem finite_row_composition_congr_before {S : ℕ → Type*} {V : Type*}
    (row other : ∀ i, (S (i + 1) → V) → S i → V) (n : ℕ)
    (hrow : ∀ i, i < n → ∀ F, row i F = other i F) (F : S n → V) :
    finiteRowComposition row n F = finiteRowComposition other n F := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [finite_row_composition_succ, hrow n (Nat.lt_succ_self n),
      finite_row_composition_succ]
    exact ih (fun i hi => hrow i (Nat.lt_trans hi (Nat.lt_succ_self n))) (other n F)

theorem finite_row_visit_three_grouping_constant {X V : Type*}
    (row : ℕ → (X → V) → X → V) (n : ℕ) (F : X → V) :
    finiteRowComposition (S := fun _ => X)
      (finiteRowGrouped (S := fun _ => X) row visitThreeBlockLength) (2 * n + 1) F =
      finiteRowComposition (S := fun _ => X) row (4 * n + 1) F := by
  have h := finite_row_visit_three_grouping (S := fun _ => X) row n F
  simpa only [cast_eq] using h

end Bounty
end

section

/- Finite sums of terminal tests commute with sum-preserving chronological, recorded, and tensor rows. -/

open Finset
namespace Bounty

theorem finite_row_composition_sum {S : Nat → Type*} {A V : Type*} [AddCommMonoid V]
    (row : (i : Nat) → (S (i + 1) → V) → S i → V) (n : Nat)
    (hrow : ∀ i < n, ∀ (t : Finset A) (F : A → S (i + 1) → V) s,
      row i (fun x => ∑ a ∈ t, F a x) s = ∑ a ∈ t, row i (F a) s)
    (t : Finset A) (F : A → S n → V) :
    finiteRowComposition row n (fun x => ∑ a ∈ t, F a x) =
      fun s => ∑ a ∈ t, finiteRowComposition row n (F a) s := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [finite_row_composition_succ]
    have hr : row n (fun x => ∑ a ∈ t, F a x) = fun s => ∑ a ∈ t, row n (F a) s :=
      funext (hrow n (Nat.lt_succ_self n) t F)
    rw [hr, ih (fun i hi => hrow i (Nat.lt_succ_of_lt hi))]
    rfl

theorem finite_observed_record_row_sum {X Y O H A V : Type*} [AddCommMonoid V]
    (row : (O → Y → V) → X → V) (update : H → X → O → Y → H)
    (hrow : ∀ (t : Finset A) (F : A → O → Y → V) s,
      row (fun o y => ∑ a ∈ t, F a o y) s = ∑ a ∈ t, row (F a) s)
    (t : Finset A) (F : A → H × Y → V) (s : H × X) :
    finiteObservedRecordRow row update (fun x => ∑ a ∈ t, F a x) s =
      ∑ a ∈ t, finiteObservedRecordRow row update (F a) s :=
  hrow t (fun a o y => F a (update s.1 s.2 o y, y)) s.2

theorem fin_tensor_row_sum {A V : Type*} [AddCommMonoid V] (n : Nat)
    {S T : Fin n → Type*} (row : (g : Fin n) → (T g → V) → S g → V)
    (hrow : ∀ g (t : Finset A) (F : A → T g → V) s,
      row g (fun x => ∑ a ∈ t, F a x) s = ∑ a ∈ t, row g (F a) s)
    (t : Finset A) (F : A → ((g : Fin n) → T g) → V) (s : (g : Fin n) → S g) :
    finTensorRow n row (fun x => ∑ a ∈ t, F a x) s =
      ∑ a ∈ t, finTensorRow n row (F a) s := by
  induction n with
  | zero => rfl
  | succ n ih =>
    simp only [fin_tensor_row_succ]
    have he : (fun x => finTensorRow n (fun g => row g.succ)
        (fun u => ∑ a ∈ t, F a (Fin.cons x u)) (Fin.tail s)) =
        fun x => ∑ a ∈ t, finTensorRow n (fun g => row g.succ)
          (fun u => F a (Fin.cons x u)) (Fin.tail s) := by
      funext x
      exact ih _ (fun g => hrow g.succ) _ _
    rw [he, hrow]

end Bounty
end

section

/- Exact physical vacuum pairing and its unrestricted initial-mass bound. -/

open Finset
open scoped Classical
namespace Bounty

section Physical
variable {G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Finset ℕ} {Z : G → Type*} [∀ g, Fintype (Z g)] {J ell B : ℕ}

noncomputable def physicalMarkMass (μ : (g : G) → ↥(P g) → ℝ) : ℝ :=
  ∑ L : PhysicalMarkLists P J ell, ∏ g, ∏ i : PhysicalSlots J ell, μ g (L g i)

theorem physical_mark_mass_nonneg (μ : (g : G) → ↥(P g) → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) : 0 ≤ physicalMarkMass (J := J) (ell := ell) μ := by
  exact sum_nonneg fun L _ => prod_nonneg fun g _ => prod_nonneg fun i _ => hμ g (L g i)

theorem physical_mark_mass_le (μ : (g : G) → ↥(P g) → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) :
    physicalMarkMass (J := J) (ell := ell) μ ≤ ∏ g, (∑ p, μ g p) ^ (J + ell) := by
  let embed : PhysicalMarkLists P J ell → ((g : G) → PhysicalSlots J ell → ↥(P g)) :=
    fun L g => L g
  have he : Function.Injective embed := by
    intro L R h
    funext g
    apply Function.Embedding.coe_injective
    exact congrFun h g
  let weight := fun L : ((g : G) → PhysicalSlots J ell → ↥(P g)) =>
    ∏ g, ∏ i, μ g (L g i)
  have hw (L) : 0 ≤ weight L :=
    prod_nonneg fun g _ => prod_nonneg fun i _ => hμ g (L g i)
  calc
    physicalMarkMass μ = ∑ L ∈ univ.image embed, weight L := by
      rw [sum_image (fun _ _ _ _ h => he h)]
      rfl
    _ ≤ ∑ L, weight L := sum_le_sum_of_subset_of_nonneg (subset_univ _) (fun L _ _ => hw L)
    _ = ∏ g, (∑ p, μ g p) ^ (J + ell) := by
      dsimp [weight]
      rw [← Fintype.prod_sum (fun g (f : PhysicalSlots J ell → ↥(P g)) => ∏ i, μ g (f i))]
      apply prod_congr rfl
      intro g _
      rw [← Fintype.prod_sum (fun (_ : PhysicalSlots J ell) (p : ↥(P g)) => μ g p)]
      simp [PhysicalSlots]

theorem physical_mark_vacuum_energy_le
    (μ : (g : G) → ↥(P g) → ℝ) (ν : (g : G) → Z g → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hν : ∀ g z, 0 ≤ ν g z)
    (qempty : (g : G) → BoundedOrderedTuple (Z g) B)
    (hq : ∀ g, (qempty g).1.val = 0)
    (F : PhysicalMarkLists P J ell → ((g : G) → BoundedOrderedTuple (Z g) B) → ℂ) :
    (∑ L, (∏ g, ∏ i : PhysicalSlots J ell, μ g (L g i)) * ‖F L qempty‖ ^ 2) ≤
      physicalMarkMemoryEnergy μ ν F := by
  have hweight (g : G) : boundedOrderedMemoryWeight (ν g) (qempty g) = 1 := by
    have hp : (∏ j, ν g ((qempty g).2 j)) = 1 := by
      apply prod_eq_one
      intro i _
      have hi := i.isLt
      have hz := hq g
      omega
    simp [boundedOrderedMemoryWeight, hp, hq]
  apply sum_le_sum
  intro L _
  have h := single_le_sum (f := fun q : (g : G) → BoundedOrderedTuple (Z g) B =>
    (∏ g, (∏ i : PhysicalSlots J ell, μ g (L g i)) *
      boundedOrderedMemoryWeight (ν g) (q g)) * ‖F L q‖ ^ 2)
    (fun q _ => mul_nonneg (prod_nonneg fun g _ =>
      mul_nonneg (prod_nonneg fun i _ => hμ g (L g i))
        (boundedOrderedMemoryWeight_nonneg (ν g) (hν g) (q g))) (sq_nonneg _))
    (mem_univ qempty)
  simpa only [hweight, mul_one] using h

theorem physical_mark_vacuum_pairing_energy_le
    (μ : (g : G) → ↥(P g) → ℝ) (ν : (g : G) → Z g → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hν : ∀ g z, 0 ≤ ν g z)
    (qempty : (g : G) → BoundedOrderedTuple (Z g) B)
    (hq : ∀ g, (qempty g).1.val = 0)
    (F : PhysicalMarkLists P J ell → ((g : G) → BoundedOrderedTuple (Z g) B) → ℂ) :
    ‖∑ L, ((∏ g, ∏ i : PhysicalSlots J ell, μ g (L g i) : ℝ) : ℂ) * F L qempty‖ ^ 2 ≤
      physicalMarkMass (J := J) (ell := ell) μ * physicalMarkMemoryEnergy μ ν F := by
  exact (finite_weighted_sum_cauchy univ
    (fun L : PhysicalMarkLists P J ell => ∏ g, ∏ i, μ g (L g i))
    (fun L _ => prod_nonneg fun g _ => prod_nonneg fun i _ => hμ g (L g i))
    (fun L => F L qempty)).trans (mul_le_mul_of_nonneg_left
      (physical_mark_vacuum_energy_le μ ν hμ hν qempty hq F)
      (physical_mark_mass_nonneg μ hμ))

theorem physical_mark_memory_energy_nonneg
    (μ : (g : G) → ↥(P g) → ℝ) (ν : (g : G) → Z g → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hν : ∀ g z, 0 ≤ ν g z)
    (F : PhysicalMarkLists P J ell → ((g : G) → BoundedOrderedTuple (Z g) B) → ℂ) :
    0 ≤ physicalMarkMemoryEnergy μ ν F := by
  exact sum_nonneg fun L _ => sum_nonneg fun q _ =>
    mul_nonneg (prod_nonneg fun g _ =>
      mul_nonneg (prod_nonneg fun i _ => hμ g (L g i))
        (boundedOrderedMemoryWeight_nonneg (ν g) (hν g) (q g))) (sq_nonneg _)

theorem physical_mark_vacuum_pairing_le
    (μ : (g : G) → ↥(P g) → ℝ) (ν : (g : G) → Z g → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hν : ∀ g z, 0 ≤ ν g z)
    (qempty : (g : G) → BoundedOrderedTuple (Z g) B)
    (hq : ∀ g, (qempty g).1.val = 0)
    (F : PhysicalMarkLists P J ell → ((g : G) → BoundedOrderedTuple (Z g) B) → ℂ) :
    ‖∑ L, ((∏ g, ∏ i : PhysicalSlots J ell, μ g (L g i) : ℝ) : ℂ) * F L qempty‖ ≤
      Real.sqrt (physicalMarkMass (J := J) (ell := ell) μ) *
        Real.sqrt (physicalMarkMemoryEnergy μ ν F) := by
  have hm := physical_mark_mass_nonneg (J := J) (ell := ell) μ hμ
  have he := physical_mark_memory_energy_nonneg μ ν hμ hν F
  rw [← Real.sqrt_mul hm]
  exact (Real.le_sqrt (norm_nonneg _) (mul_nonneg hm he)).mpr
    (physical_mark_vacuum_pairing_energy_le μ ν hμ hν qempty hq F)

theorem physical_mark_vacuum_pairing_le_unrestricted
    (μ : (g : G) → ↥(P g) → ℝ) (ν : (g : G) → Z g → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hν : ∀ g z, 0 ≤ ν g z)
    (qempty : (g : G) → BoundedOrderedTuple (Z g) B)
    (hq : ∀ g, (qempty g).1.val = 0)
    (F : PhysicalMarkLists P J ell → ((g : G) → BoundedOrderedTuple (Z g) B) → ℂ) :
    ‖∑ L, ((∏ g, ∏ i : PhysicalSlots J ell, μ g (L g i) : ℝ) : ℂ) * F L qempty‖ ≤
      Real.sqrt (∏ g, (∑ p, μ g p) ^ (J + ell)) *
        Real.sqrt (physicalMarkMemoryEnergy μ ν F) := by
  exact (physical_mark_vacuum_pairing_le μ ν hμ hν qempty hq F).trans
    (mul_le_mul_of_nonneg_right (Real.sqrt_le_sqrt (physical_mark_mass_le μ hμ))
      (Real.sqrt_nonneg _))

end Physical
end Bounty
end

section

/- Independent-residue averaging restricted exactly to compatible marked visits. -/

open Finset
open scoped Classical
namespace Bounty

section Expectation
variable {G : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ}
  [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}

theorem physical_residue_vertex_sum_compatible
    (labels : ℕ → PhysicalMarkLists P J ell) (visits : Finset ℕ)
    (offset : ℕ → ℤ) (q : ℕ → ℝ) (c : PhysicalResidues P → ℝ) :
    (∑ r : PhysicalResidues P, c r * ∏ j ∈ visits,
      physicalResidueVertexWeight (labels j) (q j) (physicalTranslateResidues r (offset j))) =
    ∑ r : {r : PhysicalResidues P // physicalResiduePathCompatible labels visits offset r},
      c r.val * ∏ j ∈ visits,
        physicalResidueVertexWeight (labels j) (q j) (physicalTranslateResidues r.val (offset j)) := by
  let f := fun r : PhysicalResidues P => c r * ∏ j ∈ visits,
    physicalResidueVertexWeight (labels j) (q j) (physicalTranslateResidues r (offset j))
  have hz (r : PhysicalResidues P) (hr : ¬ physicalResiduePathCompatible labels visits offset r) :
      f r = 0 := by
    simp only [f, physical_residue_vertex_product_zero_of_incompatible labels visits offset q r hr,
      mul_zero]
  calc
    _ = ∑ r ∈ univ.filter (physicalResiduePathCompatible labels visits offset), f r := by
      symm
      apply sum_subset (filter_subset _ _)
      intro r hr hnot
      apply hz r
      simpa only [mem_filter, mem_univ, true_and] using hnot
    _ = _ := sum_subtype _ (by simp) f

theorem physical_residue_vertex_expectation_compatible
    (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (labels : ℕ → PhysicalMarkLists P J ell) (visits : Finset ℕ)
    (offset : ℕ → ℤ) (q : ℕ → ℝ) :
    poolPathResidueExpectation (fun p : PhysicalPrime P => p.2.val) univ visits
      (fun p => visits.filter (fun j => p ∈ physicalMarkedPrimes (labels j)))
      (fun p j => -(offset j : ZMod p.2.val)) (fun j => 1 - q j) =
    ∑ r : {r : PhysicalResidues P // physicalResiduePathCompatible labels visits offset r},
      (∏ p : PhysicalPrime P, 1 / (p.2.val : ℝ)) * ∏ j ∈ visits,
        physicalResidueVertexWeight (labels j) (q j) (physicalTranslateResidues r.val (offset j)) := by
  rw [← physical_residue_vertex_expectation hP hprime]
  exact physical_residue_vertex_sum_compatible labels visits offset q _

theorem physical_residue_vertex_expectation_zero_of_incompatible
    (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (labels : ℕ → PhysicalMarkLists P J ell) (visits : Finset ℕ)
    (offset : ℕ → ℤ) (q : ℕ → ℝ)
    (h : ¬ ∃ r : PhysicalResidues P, physicalResiduePathCompatible labels visits offset r) :
    poolPathResidueExpectation (fun p : PhysicalPrime P => p.2.val) univ visits
      (fun p => visits.filter (fun j => p ∈ physicalMarkedPrimes (labels j)))
      (fun p j => -(offset j : ZMod p.2.val)) (fun j => 1 - q j) = 0 := by
  rw [← physical_residue_vertex_expectation hP hprime]
  apply sum_eq_zero
  intro r _
  rw [physical_residue_vertex_product_zero_of_incompatible labels visits offset q r
    (fun hr => h ⟨r, hr⟩), mul_zero]

end Expectation
end Bounty
end

section

/- The actual finite residue path sum is supported on the residue
assignments prescribed by every visited mark, with the original offsets. -/

open Finset
open scoped Classical

namespace Bounty

section FinitePath
variable {G I : Type*} [Fintype G] [DecidableEq G]
  {P : G → Finset ℕ} {J ell : ℕ} {patterns : Finset I}

noncomputable def physicalFinitePathResidueCompatible
    (C : I → G → Finset (Fin J)) (k : ℕ → I → ℤ)
    (N : ℕ) (r : PhysicalResidues P) (L₀ : PhysicalMarkLists P J ell)
    (p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) : Prop :=
  physicalResiduePathCompatible (finitePathMarks L₀ p) (range (N + 2))
    (physicalBareOffset C k (finitePathLabels p) (finitePathMarks L₀ p) (N + 1)) r

omit [DecidableEq G] in
theorem physical_finite_path_residue_compatible_iff
    (C : I → G → Finset (Fin J)) (k : ℕ → I → ℤ)
    (N : ℕ) (r : PhysicalResidues P) (L₀ : PhysicalMarkLists P J ell)
    (p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) :
    physicalFinitePathResidueCompatible C k N r L₀ p ↔
      ∀ j : Fin (N + 2), ∀ a ∈ physicalMarkedPrimes (finitePathMarks L₀ p j.val),
        r a = -(physicalBareOffset C k (finitePathLabels p) (finitePathMarks L₀ p)
          (N + 1) j.val : ZMod a.2.val) := by
  exact physical_residue_path_compatible_range_iff _ _ _ _

variable (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hprime : ∀ g p, p ∈ P g → p.Prime)
  (V : G → ℝ) (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
  (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
  (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
    PhysicalAuxLabels P (C i) → ℂ)
  (N : ℕ) (r : PhysicalResidues P) (L₀ : PhysicalMarkLists P J ell)

include hP hprime hq

theorem physical_residue_finite_path_zero_of_incompatible
    (p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)
    (h : ¬ physicalFinitePathResidueCompatible C k N r L₀ p) :
    physicalResidueBarePathTerm V patterns C q ζ k K (N + 1) r L₀ p = 0 := by
  rw [physical_residue_finite_path_factor hP hprime V patterns C hq ζ k K N L₀ p r]
  rw [physical_residue_vertex_product_zero_of_incompatible
    (finitePathMarks L₀ p) (range (N + 2))
    (physicalBareOffset C k (finitePathLabels p) (finitePathMarks L₀ p) (N + 1))
    (physicalEndpointSchedule q (N + 1)) r h]
  simp only [Complex.ofReal_zero, mul_zero]

theorem physical_residue_finite_path_nonzero_compatible
    (p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)
    (h : physicalResidueBarePathTerm V patterns C q ζ k K (N + 1) r L₀ p ≠ 0) :
    physicalFinitePathResidueCompatible C k N r L₀ p := by
  by_contra hn
  exact h (physical_residue_finite_path_zero_of_incompatible
    hP hprime V C hq ζ k K N r L₀ p hn)

theorem physical_residue_finite_path_nonzero_marks
    (p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)
    (h : physicalResidueBarePathTerm V patterns C q ζ k K (N + 1) r L₀ p ≠ 0) :
    ∀ j : Fin (N + 2), ∀ a ∈ physicalMarkedPrimes (finitePathMarks L₀ p j.val),
      r a = -(physicalBareOffset C k (finitePathLabels p) (finitePathMarks L₀ p)
        (N + 1) j.val : ZMod a.2.val) := by
  exact (physical_finite_path_residue_compatible_iff C k N r L₀ p).mp
    (physical_residue_finite_path_nonzero_compatible hP hprime V C hq ζ k K N r L₀ p h)

theorem physical_residue_finite_path_sum_filter_compatible
    (s : Finset (Fin (N + 1) →
      PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell))
    (c : (Fin (N + 1) →
      PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) → ℂ) :
    (∑ p ∈ s, c p * physicalResidueBarePathTerm V patterns C q ζ k K (N + 1) r L₀ p) =
      ∑ p ∈ s.filter (physicalFinitePathResidueCompatible C k N r L₀),
        c p * physicalResidueBarePathTerm V patterns C q ζ k K (N + 1) r L₀ p := by
  rw [sum_filter]
  apply sum_congr rfl
  intro p hp
  by_cases h : physicalFinitePathResidueCompatible C k N r L₀ p
  · simp only [h, if_true]
  · rw [if_neg h, physical_residue_finite_path_zero_of_incompatible
      hP hprime V C hq ζ k K N r L₀ p h, mul_zero]

end FinitePath
end Bounty
end

section

/- Repeated physical lists in the flat group-slot coordinates of the
asymmetric kernel. The shared set contains precisely the first-block slots
outside the cut; all remaining coordinates retain their actual label law. -/

open Finset Classical

namespace Bounty

abbrev RepeatedBigFlatIndex (G : Type*) (J ell : ℕ) :=
  Sigma (fun _ : G => PhysicalSlots J ell)

def repeatedBigFlatEquiv {G : Type*} (P : G → Finset ℕ) (J ell : ℕ) :
    RepeatedBigLists P J ell ≃ (∀ i : RepeatedBigFlatIndex G J ell, P i.1) :=
  finiteGroupFlattenEquiv

theorem repeatedBigFlatEquiv_apply {G : Type*} (P : G → Finset ℕ) (J ell : ℕ)
    (source : RepeatedBigLists P J ell) (g : G) (s : PhysicalSlots J ell) :
    repeatedBigFlatEquiv P J ell source ⟨g, s⟩ = source g s := rfl

theorem repeatedBigFlatEquiv_symm_apply {G : Type*} (P : G → Finset ℕ) (J ell : ℕ)
    (source : ∀ i : RepeatedBigFlatIndex G J ell, P i.1) (g : G) (s : PhysicalSlots J ell) :
    (repeatedBigFlatEquiv P J ell).symm source g s = source ⟨g, s⟩ := rfl

def repeatedBigFlatActive {G : Type*} [Fintype G] (J ell : ℕ) :
    Finset (RepeatedBigFlatIndex G J ell) :=
  univ.sigma (fun _ => (univ : Finset (Fin J)).map Function.Embedding.inl)

def repeatedBigFlatShared {G : Type*} [Fintype G] {J ell : ℕ}
    (C : G → Finset (Fin J)) : Finset (RepeatedBigFlatIndex G J ell) :=
  univ.sigma (fun g => physicalSharedSlots (ell := ell) (C g))

noncomputable def repeatedBigFlatUnshared {G : Type*} [Fintype G] {J ell : ℕ}
    (C : G → Finset (Fin J)) : Finset (RepeatedBigFlatIndex G J ell) :=
  (repeatedBigFlatShared C)ᶜ

theorem repeatedBigFlatActive_mem_inl {G : Type*} [Fintype G] (J ell : ℕ)
    (g : G) (j : Fin J) : (⟨g, Sum.inl j⟩ : RepeatedBigFlatIndex G J ell) ∈ repeatedBigFlatActive J ell := by
  simp [repeatedBigFlatActive]

theorem repeatedBigFlatActive_not_mem_inr {G : Type*} [Fintype G] (J ell : ℕ)
    (g : G) (j : Fin ell) : (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ repeatedBigFlatActive J ell := by
  simp [repeatedBigFlatActive]

theorem repeatedBigFlatShared_mem_iff {G : Type*} [Fintype G] {J ell : ℕ}
    (C : G → Finset (Fin J)) (g : G) (s : PhysicalSlots J ell) :
    (⟨g, s⟩ : RepeatedBigFlatIndex G J ell) ∈ repeatedBigFlatShared C ↔
      ¬ repeatedBigUnshared C g s := by
  cases s <;> simp [repeatedBigFlatShared, physicalSharedSlots, repeatedBigUnshared]

theorem repeatedBigFlatShared_mem_inl {G : Type*} [Fintype G] {J ell : ℕ}
    (C : G → Finset (Fin J)) (g : G) (j : Fin J) :
    (⟨g, Sum.inl j⟩ : RepeatedBigFlatIndex G J ell) ∈ repeatedBigFlatShared C ↔ j ∉ C g := by
  simp only [repeatedBigFlatShared_mem_iff, repeatedBigUnshared]

theorem repeatedBigFlatShared_not_mem_inr {G : Type*} [Fintype G] {J ell : ℕ}
    (C : G → Finset (Fin J)) (g : G) (j : Fin ell) :
    (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ repeatedBigFlatShared C := by
  simp only [repeatedBigFlatShared_mem_iff, repeatedBigUnshared, not_true_eq_false, not_false_eq_true]

theorem repeatedBigFlatUnshared_mem_iff {G : Type*} [Fintype G] {J ell : ℕ}
    (C : G → Finset (Fin J)) (g : G) (s : PhysicalSlots J ell) :
    (⟨g, s⟩ : RepeatedBigFlatIndex G J ell) ∈ repeatedBigFlatUnshared C ↔
      repeatedBigUnshared C g s := by
  simp [repeatedBigFlatUnshared, repeatedBigFlatShared_mem_iff]

theorem repeatedBigFlatShared_subset_active {G : Type*} [Fintype G] {J ell : ℕ}
    (C : G → Finset (Fin J)) : repeatedBigFlatShared (ell := ell) C ⊆ repeatedBigFlatActive J ell := by
  rintro ⟨g, j | j⟩ hj
  · exact repeatedBigFlatActive_mem_inl J ell g j
  · exact False.elim (repeatedBigFlatShared_not_mem_inr C g j hj)

theorem repeatedBigFlatUnshared_eq_sigma {G : Type*} [Fintype G] {J ell : ℕ}
    (C : G → Finset (Fin J)) :
    repeatedBigFlatUnshared (ell := ell) C =
      univ.sigma (fun g => univ.filter (repeatedBigUnshared (ell := ell) C g)) := by
  ext ⟨g, s⟩
  simp only [repeatedBigFlatUnshared_mem_iff, mem_sigma, mem_univ, mem_filter, true_and]

theorem repeated_big_shared_compatible_flat {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (source target : RepeatedBigLists P J ell) :
    repeatedBigSharedCompatible C source target ↔
      finiteSharedCompatible (repeatedBigFlatShared C)
        (repeatedBigFlatEquiv P J ell source) (repeatedBigFlatEquiv P J ell target) := by
  constructor
  · intro h i hi
    rcases i with ⟨g, j | j⟩
    · exact h g j ((repeatedBigFlatShared_mem_inl C g j).mp hi)
    · exact False.elim (repeatedBigFlatShared_not_mem_inr C g j hi)
  · intro h g j hj
    exact h ⟨g, Sum.inl j⟩ ((repeatedBigFlatShared_mem_inl C g j).mpr hj)

theorem repeated_big_active_mass_flat_tilted {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (source : RepeatedBigLists P J ell) :
    repeatedBigActiveMass V b source =
      finiteProductWeight (fun i : RepeatedBigFlatIndex G J ell => tiltedPhysicalBirthLaw V i.1 (b i.1))
        (repeatedBigFlatEquiv P J ell source) := by
  exact (finite_product_weight_flatten (fun g => tiltedPhysicalBirthLaw V g (b g)) source).symm

theorem repeated_big_active_mass_flat {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (source : RepeatedBigLists P J ell) :
    repeatedBigActiveMass V (fun _ _ => 1) source =
      finiteProductWeight (fun i : RepeatedBigFlatIndex G J ell => physicalLabelLaw V i.1)
        (repeatedBigFlatEquiv P J ell source) := by
  have hlaw : (fun i : RepeatedBigFlatIndex G J ell => tiltedPhysicalBirthLaw (P := P) V i.1 (fun _ => 1)) =
      (fun i : RepeatedBigFlatIndex G J ell => physicalLabelLaw (P := P) V i.1) := by
    funext i p
    exact div_one _
  simpa only [hlaw] using repeated_big_active_mass_flat_tilted V (fun _ _ => 1) source

theorem repeated_big_target_mass_flat_tilted {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (target : RepeatedBigLists P J ell) :
    repeatedBigTargetMass V b C target =
      finiteFreshMass (fun i : RepeatedBigFlatIndex G J ell => tiltedPhysicalBirthLaw V i.1 (b i.1))
        (repeatedBigFlatShared C) (repeatedBigFlatEquiv P J ell target) := by
  symm
  unfold finiteFreshMass
  have hset : (repeatedBigFlatShared (ell := ell) C)ᶜ =
      univ.sigma (fun g => univ.filter (repeatedBigUnshared (ell := ell) C g)) := by
    ext ⟨g, s⟩
    simp [repeatedBigFlatShared_mem_iff]
  rw [hset, prod_sigma]
  unfold repeatedBigTargetMass
  apply prod_congr rfl
  intro g _
  exact prod_subtype (univ.filter (repeatedBigUnshared C g)) (fun s => by simp)
    (fun s => tiltedPhysicalBirthLaw V g (b g) (target g s))

theorem repeated_big_target_mass_flat {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ)
    (C : G → Finset (Fin J)) (target : RepeatedBigLists P J ell) :
    repeatedBigTargetMass V (fun _ _ => 1) C target =
      finiteFreshMass (fun i : RepeatedBigFlatIndex G J ell => physicalLabelLaw V i.1)
        (repeatedBigFlatShared C) (repeatedBigFlatEquiv P J ell target) := by
  have hlaw : (fun i : RepeatedBigFlatIndex G J ell => tiltedPhysicalBirthLaw (P := P) V i.1 (fun _ => 1)) =
      (fun i : RepeatedBigFlatIndex G J ell => physicalLabelLaw (P := P) V i.1) := by
    funext i p
    exact div_one _
  simpa only [hlaw] using repeated_big_target_mass_flat_tilted V (fun _ _ => 1) C target

theorem repeated_big_flat_shared_prod {G H : Type*} [Fintype G] [CommMonoid H]
    {J ell : ℕ} (C : G → Finset (Fin J)) (F : G → PhysicalSlots J ell → H) :
    (∏ g, ∏ j ∈ univ \ C g, F g (Sum.inl j)) =
      ∏ i : repeatedBigFlatShared (ell := ell) C, F i.val.1 i.val.2 := by
  refine Eq.trans ?_ (prod_coe_sort (repeatedBigFlatShared (ell := ell) C)
    (fun i : RepeatedBigFlatIndex G J ell => F i.1 i.2)).symm
  rw [repeatedBigFlatShared, prod_sigma]
  apply prod_congr rfl
  intro g _
  exact (prod_map _ Function.Embedding.inl (F g)).symm

theorem repeated_big_shared_label_product_flat {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (source : RepeatedBigLists P J ell) :
    (∏ g, ∏ j ∈ univ \ C g, (source g (Sum.inl j)).val) =
      ∏ i : repeatedBigFlatShared (ell := ell) C,
        (repeatedBigFlatEquiv P J ell source i.val).val :=
  repeated_big_flat_shared_prod C (fun g s => (source g s).val)

end Bounty
end

section

/- Omitting a fixed prefix of pure Q bands costs only a fixed harmonic factor. -/

open Finset Filter
open scoped Topology

namespace Bounty

theorem exists_candidate_micro_Q_harmonic_comparison {c : ℝ} (hc : 0 < c) (r J : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, J ≤ jStar →
      candidateMicroQHarmonicMass c L r jStar J ≤ C * candidateQHarmonicMass c L r jStar := by
  obtain ⟨v, V, hv, _, hbands⟩ := exists_candidateQBands_bounds hc
  let u := min 1 (v^r / (r.factorial : ℝ))
  have hu0 : 0 < u := lt_min (by norm_num) (by positivity)
  have hu1 : u ≤ 1 := min_le_left _ _
  refine ⟨1/u^J, by positivity, ?_⟩
  filter_upwards [hbands] with L hL
  intro jStar hjStar
  let S := (candidateQIndices c L).filter (fun j => j < J)
  have hcard : S.card ≤ J := by
    have hsub : S ⊆ range J := fun j hj => mem_range.mpr (mem_filter.mp hj).2
    simpa only [card_range] using card_le_card hsub
  have hlocal : ∀ j ∈ S, u ≤ candidateQBandHarmonicFactor c L r jStar j := by
    intro j hj
    have hjs := (mem_filter.mp hj).2
    have hjQ := (mem_filter.mp hj).1
    rw [candidate_Q_band_factor_pure c L r jStar j (by omega)]
    apply (min_le_right _ _).trans
    exact div_le_div_of_nonneg_right
      (pow_le_pow_left₀ hv.le (hL.2.2 j hjQ).2.2.1 r) (Nat.cast_nonneg _)
  have hprefix : u^J ≤ ∏ j ∈ S, candidateQBandHarmonicFactor c L r jStar j := by
    calc
      _ ≤ u^S.card := pow_le_pow_of_le_one hu0.le hu1 hcard
      _ = ∏ _j ∈ S, u := (prod_const u).symm
      _ ≤ _ := Finset.prod_le_prod₀ (fun _ _ => hu0.le) hlocal
  have hmass := mul_le_mul_of_nonneg_right hprefix (candidate_micro_Q_harmonic_nonneg c L r jStar J)
  rw [show (∏ j ∈ S, candidateQBandHarmonicFactor c L r jStar j) *
      candidateMicroQHarmonicMass c L r jStar J = candidateQHarmonicMass c L r jStar from
    (candidate_Q_harmonic_split_micro c L r jStar J).symm] at hmass
  calc
    _ ≤ candidateQHarmonicMass c L r jStar / u^J :=
      (le_div_iff₀ (pow_pos hu0 _)).mpr (by simpa only [mul_comm] using hmass)
    _ = _ := by ring

end Bounty
end

section

/- Actual microscopic Q-slot and P-mark assignments with full normalization. -/

open Finset Filter
open scoped Topology

namespace Bounty

noncomputable def candidateMicroAssignmentChoices (c L : ℝ) (r jStar J : ℕ) :
    ((candidateMicroQIndices c L J) × Fin r) ⊕ (candidatePIndices c L) → Finset ℕ :=
  Sum.elim (candidateMicroQSlotChoices c L r jStar J)
    (fun g => candidatePBand (c*L) g.val)

noncomputable def candidateMicroAssignmentNormalization (c L : ℝ) (r J : ℕ) : ℝ :=
  (r.factorial : ℝ)^(candidateMicroQIndices c L J).card *
    ∏ g ∈ candidatePIndices c L, ∑ p ∈ candidatePBand (c*L) g, 1/(p : ℝ)

noncomputable def candidateMicroAssignmentWeight (c L : ℝ) (r jStar J n : ℕ) : ℝ :=
  orderedSlotWeight (candidateMicroAssignmentChoices c L r jStar J)
    (candidateMicroAssignmentNormalization c L r J) n

theorem candidate_micro_assignment_normalization_nonneg (c L : ℝ) (r J : ℕ) :
    0 ≤ candidateMicroAssignmentNormalization c L r J := by
  unfold candidateMicroAssignmentNormalization
  exact mul_nonneg (by positivity) (Finset.prod_nonneg (fun _ _ => sum_nonneg (fun _ _ => by positivity)))

theorem candidate_micro_assignment_weight_nonneg (c L : ℝ) (r jStar J n : ℕ) :
    0 ≤ candidateMicroAssignmentWeight c L r jStar J n :=
  ordered_slot_weight_nonneg _ (candidate_micro_assignment_normalization_nonneg c L r J) n

theorem candidate_micro_assignment_harmonic_eq (c L : ℝ) (r jStar J : ℕ)
    (hP : ∀ g ∈ candidatePIndices c L, (∑ p ∈ candidatePBand (c*L) g, 1/(p : ℝ)) ≠ 0) :
    (∑' n : ℕ, candidateMicroAssignmentWeight c L r jStar J n / (n : ℝ)) =
      candidateMicroQHarmonicMass c L r jStar J := by
  classical
  have hprod : (∏ g ∈ candidatePIndices c L, ∑ p ∈ candidatePBand (c*L) g, 1/(p : ℝ)) ≠ 0 :=
    prod_ne_zero_iff.mpr hP
  unfold candidateMicroAssignmentWeight candidateMicroQHarmonicMass candidateMicroQWeight
  rw [ordered_slot_harmonic_sum, ordered_slot_harmonic_sum, Fintype.prod_sum_type]
  simp only [candidateMicroAssignmentChoices, Sum.elim_inl, Sum.elim_inr,
    candidateMicroAssignmentNormalization]
  have hPprod : (∏ g : candidatePIndices c L, ∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ)) =
      ∏ g ∈ candidatePIndices c L, ∑ p ∈ candidatePBand (c*L) g, 1/(p : ℝ) :=
    prod_coe_sort (candidatePIndices c L) (fun g : ℕ => ∑ p ∈ candidatePBand (c*L) g, 1/(p : ℝ))
  rw [hPprod]
  field_simp

theorem candidate_micro_assignment_reciprocal_sum (c L : ℝ) (r jStar J : ℕ)
    (hP : ∀ g ∈ candidatePIndices c L, (∑ p ∈ candidatePBand (c*L) g, 1/(p : ℝ)) ≠ 0) :
    (∑ x : ∀ i, candidateMicroAssignmentChoices c L r jStar J i,
      (1 / candidateMicroAssignmentNormalization c L r J) /
        (orderedSlotProduct (candidateMicroAssignmentChoices c L r jStar J) x : ℝ)) =
      candidateMicroQHarmonicMass c L r jStar J := by
  classical
  rw [← candidate_micro_assignment_harmonic_eq c L r jStar J hP]
  unfold candidateMicroAssignmentWeight orderedSlotWeight
  simp only [Finset.sum_div]
  rw [Summable.tsum_finsetSum]
  · apply Finset.sum_congr (by ext; simp)
    intro x _
    simp_rw [ite_div, zero_div]
    rw [tsum_ite_eq']
  · intro x _
    apply (hasSum_single (orderedSlotProduct (candidateMicroAssignmentChoices c L r jStar J) x) ?_).summable
    intro n hn
    simp [Ne.symm hn]

theorem eventually_candidate_micro_assignment_normalization {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ r jStar J : ℕ,
      0 < candidateMicroAssignmentNormalization c L r J ∧
      (∑ x : ∀ i, candidateMicroAssignmentChoices c L r jStar J i,
        (1 / candidateMicroAssignmentNormalization c L r J) /
          (orderedSlotProduct (candidateMicroAssignmentChoices c L r jStar J) x : ℝ)) =
        candidateMicroQHarmonicMass c L r jStar J := by
  obtain ⟨v, V, hv, _, hpool⟩ := exists_candidate_P_pool_bounds hc
  filter_upwards [hpool] with L hL
  rcases hL with ⟨_, _, _, _, _, hdata⟩
  have hP : ∀ g ∈ candidatePIndices c L, 0 < ∑ p ∈ candidatePBand (c*L) g, 1/(p : ℝ) :=
    fun g hg => hv.trans_le (hdata g hg).1
  intro r jStar J
  refine ⟨?_, candidate_micro_assignment_reciprocal_sum c L r jStar J (fun g hg => (hP g hg).ne')⟩
  unfold candidateMicroAssignmentNormalization
  exact mul_pos (by positivity) (prod_pos hP)

end Bounty
end

section

/- Local birth data retain ghost residues and distinguish fresh edge labels. -/

open scoped Classical

namespace Bounty

abbrev FullMixedBornData {N : ℕ} {P : Fin N → Type*}
    (n : (g : Fin N) → P g → ℕ) :=
  ((g : Fin N) × UnrestrictedResidueParticle (n g)) ⊕ ((g : Fin N) × P g)

def fullMixedBornPrime {N : ℕ} {P : Fin N → Type*}
    (n : (g : Fin N) → P g → ℕ) : FullMixedBornData n → ((g : Fin N) × P g)
  | .inl d => ⟨d.1, d.2.1⟩
  | .inr d => d

section Events

variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
    (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
    (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)

noncomputable def fullMixedEventBornData :
    (tag : Option (J ⊕ K)) →
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) →
    FullPermutationMixedEvent n S B A Δ D tag s →
    FullMixedLocalBirthAddress S B tag → Option (FullMixedBornData n)
  | none, _, _, a => Fin.elim0 a.2
  | some (.inl _), _, e, ⟨g, i⟩ =>
      if h : i.val < (e.down g).1.val then
        some (.inl ⟨g, (e.down g).2.2 ⟨i.val, h⟩⟩)
      else none
  | some (.inr _), _, e, ⟨g, i⟩ =>
      if h : i ∈ (e.2 g).2.1 then none
      else some (.inr ⟨g, (e.2 g).2.2.2 ⟨i, h⟩⟩)

noncomputable def fullMixedEventBirthLabel (tag : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag s)
    (a : FullMixedLocalBirthAddress S B tag) : Option ((g : Fin N) × P g) :=
  (fullMixedEventBornData n S B A Δ D tag s e a).map (fullMixedBornPrime n)

noncomputable def fullMixedEventBirthPerformed (tag : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag s)
    (a : FullMixedLocalBirthAddress S B tag) : Prop :=
  (fullMixedEventBornData n S B A Δ D tag s e a).isSome = true

theorem full_mixed_ghost_born_data (j : J)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (some (.inl j)) s)
    (g : Fin N) (i : Fin B) (hi : i.val < (e.down g).1.val) :
    fullMixedEventBornData n S B A Δ D (some (.inl j)) s e ⟨g, i⟩ =
      some (.inl ⟨g, (e.down g).2.2 ⟨i.val, hi⟩⟩) := by
  simp only [fullMixedEventBornData, dif_pos hi]

theorem full_mixed_ghost_birth_performed_iff (j : J)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (some (.inl j)) s)
    (g : Fin N) (i : Fin B) :
    fullMixedEventBirthPerformed n S B A Δ D (some (.inl j)) s e ⟨g, i⟩ ↔
      i.val < (e.down g).1.val := by
  simp only [fullMixedEventBirthPerformed, fullMixedEventBornData]
  split_ifs <;> simp_all

theorem full_mixed_edge_born_data (k : K)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent (J := J) n S B A Δ D (some (.inr k)) s)
    (g : Fin N) (i : Fin (S k g)ᶜ.card) (hi : i ∉ (e.2 g).2.1) :
    fullMixedEventBornData n S B A Δ D (some (.inr k)) s e ⟨g, i⟩ =
      some (.inr ⟨g, (e.2 g).2.2.2 ⟨i, hi⟩⟩) := by
  simp only [fullMixedEventBornData]
  split_ifs with h
  · exact (hi h).elim
  · rfl

theorem full_mixed_edge_birth_performed_iff (k : K)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent (J := J) n S B A Δ D (some (.inr k)) s)
    (g : Fin N) (i : Fin (S k g)ᶜ.card) :
    fullMixedEventBirthPerformed n S B A Δ D (some (.inr k)) s e ⟨g, i⟩ ↔
      i ∉ (e.2 g).2.1 := by
  simp only [fullMixedEventBirthPerformed, fullMixedEventBornData]
  split_ifs with h
  · constructor
    · intro hf
      cases hf
    · intro hn
      exact (hn h).elim
  · constructor
    · intro _
      exact h
    · intro _
      rfl

theorem full_mixed_birth_label_isSome (tag : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag s)
    (a : FullMixedLocalBirthAddress S B tag) :
    (fullMixedEventBirthLabel n S B A Δ D tag s e a).isSome =
      (fullMixedEventBornData n S B A Δ D tag s e a).isSome := by
  exact Option.isSome_map

end Events

end Bounty
end

section

/- Removing the deterministic ledger preserves every owning full event. -/

namespace Bounty

theorem finite_ledger_event_path_occurrence
    {K L X : Type*} (E : K → X → Type*) (target : ∀ k x, E k x → X)
    (update : ∀ k, L → (x : X) → E k x → L)
    (steps : List K) (l : L) (x : X)
    (p : FiniteEventPath (fun k (s : L × X) => E k s.2)
      (finiteLedgerEventTarget E target update) steps (l, x)) (i : Fin steps.length) :
    (let e := finiteEventPathOccurrence (fun k (s : L × X) => E k s.2)
      (finiteLedgerEventTarget E target update) steps (l, x) p i
     (⟨e.1.2, e.2⟩ : Σ y, E (steps.get i) y)) =
    finiteEventPathOccurrence E target steps x
      (finiteLedgerEventPathEquiv E target update steps l x p) i := by
  induction steps generalizing l x with
  | nil => exact Fin.elim0 i
  | cons k steps ih =>
    rcases p with ⟨e, p⟩
    refine Fin.cases ?_ (fun j => ?_) i
    · rfl
    · exact ih (update k l x e) (target k x e) p j

end Bounty
end

section

/- Kernel pairings give the projected norm of the literal finite row action. -/

open Finset
open scoped Classical

namespace Bounty

theorem clean_kernel_pairing_sub_kernel {X Y : Type*} [Fintype X] [Fintype Y]
    (w : X → ℝ) (K H : X → Y → ℂ) (f : X → ℂ) (g : Y → ℂ) :
    cleanKernelPairing w (K - H) f g =
      cleanKernelPairing w K f g - cleanKernelPairing w H f g := by
  simp only [cleanKernelPairing, Pi.sub_apply, mul_sub, sub_mul, sum_sub_distrib]

theorem clean_kernel_pairing_row_action {X Y : Type*} [Fintype X] [Fintype Y]
    (w : X → ℝ) (K : X → Y → ℂ) (f : X → ℂ) (g : Y → ℂ) :
    cleanKernelPairing w K f g =
      ∑ x, (w x : ℂ) * (starRingEnd ℂ) (f x) * (∑ y, K x y * g y) := by
  simp only [cleanKernelPairing, mul_sum, mul_assoc]

theorem repeated_big_kernel_norm_le_of_bilinear {G : Type*}
    [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (hV : ∀ g, 0 ≤ V g)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → ℂ)
    {M : ℝ} (hM : 0 ≤ M)
    (hpair : ∀ f v : RepeatedBigLists P J ell → ℂ,
      f ∈ repeatedBigSymmetricSubspace → v ∈ repeatedBigSymmetricSubspace →
      ‖cleanKernelPairing (repeatedBigActiveMass V (fun _ _ => 1)) K f v‖ ≤
        M * cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f *
          cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) v)
    (v : RepeatedBigLists P J ell → ℂ) (hv : v ∈ repeatedBigSymmetricSubspace) :
    cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
      (repeatedBigSymmetrizeLinear (fun x => ∑ y, K x y * v y)) ≤
      M * cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) v := by
  apply repeated_big_untilted_operator_norm_le_of_symmetric_pairing V hV _ hM _ v hv
  intro f g hf hg
  rw [← clean_kernel_pairing_row_action]
  exact hpair f g hf hg

end Bounty
end

section

/- A chronological finite enumeration of the existing potential birth addresses. -/

namespace Bounty

variable {J K : Type*} {N : ℕ} {M : Fin N → ℕ}
    (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
    (steps : List (Option (J ⊕ K)))

abbrev FullMixedBirthLexAddress :=
  Lex ((i : Fin steps.length) ×
    Lex ((g : Fin N) × Fin (fullMixedBirthCapacity S B (steps.get i) g)))

def fullMixedBirthLexEquiv :
    FullMixedBirthLexAddress S B steps ≃ FullMixedBirthAddress S B steps where
  toFun a := ⟨(ofLex a).1, ofLex (ofLex a).2⟩
  invFun a := toLex ⟨a.1, toLex a.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

noncomputable def fullMixedBirthOrder :
    Fin (Fintype.card (FullMixedBirthAddress S B steps)) ≃
      FullMixedBirthAddress S B steps :=
  (Fintype.orderIsoFinOfCardEq (FullMixedBirthLexAddress S B steps)
    (Fintype.card_congr (fullMixedBirthLexEquiv S B steps))).toEquiv.trans
      (fullMixedBirthLexEquiv S B steps)

theorem full_mixed_birth_order_owner_monotone :
    Monotone (fun i => fullMixedBirthOwner S B steps
      (fullMixedBirthOrder S B steps i)) := by
  intro i j hij
  have h := (Fintype.orderIsoFinOfCardEq (FullMixedBirthLexAddress S B steps)
    (Fintype.card_congr (fullMixedBirthLexEquiv S B steps))).monotone hij
  rcases Sigma.Lex.le_def.mp h with hlt | ⟨heq, _⟩
  · exact hlt.le
  · exact heq.le

theorem full_mixed_birth_order_apply_symm (a : FullMixedBirthAddress S B steps) :
    fullMixedBirthOrder S B steps ((fullMixedBirthOrder S B steps).symm a) = a :=
  (fullMixedBirthOrder S B steps).apply_symm_apply a

theorem full_mixed_birth_order_symm_apply
    (i : Fin (Fintype.card (FullMixedBirthAddress S B steps))) :
    (fullMixedBirthOrder S B steps).symm (fullMixedBirthOrder S B steps i) = i :=
  (fullMixedBirthOrder S B steps).symm_apply_apply i

theorem full_mixed_birth_order_exact_address
    (i : Fin steps.length) (g : Fin N)
    (s : Fin (fullMixedBirthCapacity S B (steps.get i) g)) :
    fullMixedBirthOrder S B steps
      ((fullMixedBirthOrder S B steps).symm ⟨i, g, s⟩) = ⟨i, g, s⟩ :=
  full_mixed_birth_order_apply_symm S B steps ⟨i, g, s⟩

theorem full_mixed_birth_order_index_lt_of_owner_lt
    (a b : FullMixedBirthAddress S B steps)
    (h : fullMixedBirthOwner S B steps a < fullMixedBirthOwner S B steps b) :
    (fullMixedBirthOrder S B steps).symm a < (fullMixedBirthOrder S B steps).symm b := by
  apply lt_of_not_ge
  intro hba
  have h' := full_mixed_birth_order_owner_monotone S B steps hba
  simp only [full_mixed_birth_order_apply_symm] at h'
  exact (not_le_of_gt h) h'

theorem full_mixed_birth_order_card_le (T : ℕ)
    (hT : ∀ k g, (S k g)ᶜ.card ≤ T) :
    Fintype.card (FullMixedBirthAddress S B steps) ≤ steps.length * (N * max B T) :=
  full_mixed_birth_address_card_le S B T hT steps

end Bounty
end

section

/- Exact cumulative ledger unions along the existing finite dependent paths. -/

open Finset
namespace Bounty

section Paths
variable {K X Q : Type*} [DecidableEq Q]
    (E : K → X → Type*) (target : ∀ k x, E k x → X)
    (ledger : X → Finset Q) (birth : ∀ k x, E k x → Finset Q)

noncomputable def finiteEventPathPriorBirths (steps : List K) (x : X)
    (p : FiniteEventPath E target steps x) (cut : ℕ) : Finset Q :=
  Finset.univ.biUnion fun i : Fin steps.length =>
    if i.val < cut then
      let e := finiteEventPathOccurrence E target steps x p i
      birth (steps.get i) e.1 e.2
    else ∅

theorem mem_finite_event_path_prior_births (steps : List K) (x : X)
    (p : FiniteEventPath E target steps x) (cut : ℕ) (q : Q) :
    q ∈ finiteEventPathPriorBirths E target birth steps x p cut ↔
      ∃ i : Fin steps.length, i.val < cut ∧
        q ∈ birth (steps.get i)
          (finiteEventPathOccurrence E target steps x p i).1
          (finiteEventPathOccurrence E target steps x p i).2 := by
  classical
  simp only [finiteEventPathPriorBirths, mem_biUnion, mem_univ, true_and]
  apply exists_congr
  intro i
  split_ifs <;> simp_all

theorem finite_event_path_ledger_mem_before (steps : List K) (x : X)
    (p : FiniteEventPath E target steps x)
    (hstep : ∀ i : Fin steps.length,
      let e := finiteEventPathOccurrence E target steps x p i
      ledger (target (steps.get i) e.1 e.2) = ledger e.1 ∪ birth (steps.get i) e.1 e.2)
    (i : Fin steps.length) (q : Q) :
    q ∈ ledger (finiteEventPathOccurrence E target steps x p i).1 ↔
      q ∈ ledger x ∨ ∃ j : Fin steps.length, j.val < i.val ∧
        q ∈ birth (steps.get j)
          (finiteEventPathOccurrence E target steps x p j).1
          (finiteEventPathOccurrence E target steps x p j).2 := by
  induction steps generalizing x with
  | nil => exact Fin.elim0 i
  | cons k steps ih =>
    rcases p with ⟨e, p⟩
    refine Fin.cases ?_ (fun j => ?_) i
    · change q ∈ ledger x ↔ _
      simp only [Fin.val_zero, not_lt_zero, false_and, exists_false, or_false]
    · have hs : ∀ r : Fin steps.length,
          let e' := finiteEventPathOccurrence E target steps (target k x e) p r
          ledger (target (steps.get r) e'.1 e'.2) =
            ledger e'.1 ∪ birth (steps.get r) e'.1 e'.2 := fun r => hstep r.succ
      have h0 : ledger (target k x e) = ledger x ∪ birth k x e := hstep 0
      change q ∈ ledger (finiteEventPathOccurrence E target steps (target k x e) p j).1 ↔ _
      rw [ih _ p hs j, h0, mem_union]
      constructor
      · rintro ((hx | hb) | ⟨r, hr, hb⟩)
        · exact Or.inl hx
        · exact Or.inr ⟨0, Nat.zero_lt_succ _, hb⟩
        · exact Or.inr ⟨r.succ, Nat.succ_lt_succ hr, hb⟩
      · rintro (hx | ⟨r, hr, hb⟩)
        · exact Or.inl (Or.inl hx)
        · revert hr hb
          refine Fin.cases ?_ (fun r => ?_) r
          · intro _ hb
            exact Or.inl (Or.inr hb)
          · intro hr hb
            exact Or.inr ⟨r, Nat.lt_of_succ_lt_succ hr, hb⟩

theorem finite_event_path_ledger_union_before (steps : List K) (x : X)
    (p : FiniteEventPath E target steps x)
    (hstep : ∀ i : Fin steps.length,
      let e := finiteEventPathOccurrence E target steps x p i
      ledger (target (steps.get i) e.1 e.2) = ledger e.1 ∪ birth (steps.get i) e.1 e.2)
    (i : Fin steps.length) :
    ledger (finiteEventPathOccurrence E target steps x p i).1 =
      ledger x ∪ finiteEventPathPriorBirths E target birth steps x p i.val := by
  ext q
  rw [mem_union, mem_finite_event_path_prior_births]
  exact finite_event_path_ledger_mem_before E target ledger birth steps x p hstep i q

end Paths
end Bounty
end

section

/- Active labels and pending particles remain covered by the deterministic ledger. -/

open Finset
open scoped Classical
namespace Bounty

def BoundedResidueLedgerCovers {P : Type*} (n : P → ℕ) {t B : ℕ}
    (H : Finset P) (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B) : Prop :=
  (∀ i, s.1 i ∈ H) ∧ ∀ i, (s.2.2 i).1 ∈ H

theorem retained_birth_tuple_all {Z : Type*} {N b : ℕ} (Q : Z → Prop)
    (old : Fin N → Z) (retained : Finset (Fin N)) (fresh : Fin b → Z)
    (hold : ∀ i, Q (old i)) (hfresh : ∀ i, Q (fresh i)) :
    ∀ i, Q ((retainedBirthTuple old retained fresh).2 i) := by
  dsimp only [retainedBirthTuple]
  intro i
  refine Fin.addCases ?_ ?_ i
  · intro j
    rw [Fin.addCases_left]
    exact hold (retained.equivFin.symm j).val
  · intro j
    rw [Fin.addCases_right]
    exact hfresh j

theorem unrestricted_residue_output_labels_mem {P : Type*} {N t : ℕ}
    (n : P → ℕ) (H : Finset P) (source : Fin t → P)
    (old : Fin N → UnrestrictedResidueParticle n) (Δ : ℤ)
    (stores promotions : Finset (Fin t)) {eligible : Finset (Fin N)}
    (e : promotions ↪ ↥eligible)
    (hsource : ∀ i, source i ∈ H) (hold : ∀ i, (old i).1 ∈ H) :
    ∀ i, ((unrestrictedEdgeOutput source old (unrestrictedResidueSeed n)
      (unrestrictedResidueTransport n Δ) stores promotions e).2 i).1 ∈ H := by
  apply retained_birth_tuple_all (fun z : UnrestrictedResidueParticle n => z.1 ∈ H)
  · intro i
    exact hold i
  · intro i
    exact hsource (stores.equivFin.symm i).val

theorem bounded_ghost_ledger_target_covers {P : Type*} [DecidableEq P]
    (n : P → ℕ) (t B : ℕ) (H : Finset P)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (e : BoundedGhostEvent t B s) (hs : BoundedResidueLedgerCovers n H s) :
    BoundedResidueLedgerCovers n (boundedGhostLedgerTarget n t B (H, s) e).1
      (boundedGhostLedgerTarget n t B (H, s) e).2 := by
  change BoundedResidueLedgerCovers n (H ∪ univ.image (fun j => (e.2.2 j).1))
    (boundedGhostEventTarget t B s e)
  unfold boundedGhostEventTarget
  dsimp only
  split_ifs
  · constructor
    · intro i
      exact mem_union_left _ (hs.1 i)
    · apply retained_birth_tuple_all (fun z : UnrestrictedResidueParticle n =>
        z.1 ∈ H ∪ univ.image (fun j => (e.2.2 j).1))
      · intro i
        exact mem_union_left _ (hs.2 i)
      · intro i
        exact mem_union_right _ (mem_image_of_mem _ (mem_univ i))
  · constructor
    · intro i
      exact mem_union_left _ (hs.1 i)
    · intro i
      exact mem_union_left _ (hs.2 i)

theorem bounded_edge_ledger_target_covers {P : Type*} [DecidableEq P]
    (n : P → ℕ) (Δ D : ℤ) (t B : ℕ) (H : Finset P)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (e : UnrestrictedBoundedEvent n Δ D t B s) (hs : BoundedResidueLedgerCovers n H s) :
    BoundedResidueLedgerCovers n
      (H ∪ univ.image (unrestrictedBoundedEventTarget n Δ D t B s e).1)
      (unrestrictedBoundedEventTarget n Δ D t B s e) := by
  unfold unrestrictedBoundedEventTarget
  dsimp only
  split_ifs
  · constructor
    · intro i
      exact mem_union_right _ (mem_image_of_mem _ (mem_univ i))
    · intro i
      apply mem_union_left
      exact unrestricted_residue_output_labels_mem n H s.1 s.2.2 Δ e.1 e.2.1 e.2.2.1
        hs.1 hs.2 i
  · constructor
    · intro i
      exact mem_union_left _ (hs.1 i)
    · intro i
      exact mem_union_left _ (hs.2 i)

end Bounty
end

section

/- A nonzero original path coefficient has nonzero coefficient at every occurrence. -/

namespace Bounty

theorem finite_event_path_occurrence_weight_ne_zero {K X : Type*}
    (E : K → X → Type*) (target : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (steps : List K) (x : X) (p : FiniteEventPath E target steps x)
    (hp : finiteEventPathWeight E target w steps x p ≠ 0) (i : Fin steps.length) :
    w (steps.get i) (finiteEventPathOccurrence E target steps x p i).1
      (finiteEventPathOccurrence E target steps x p i).2 ≠ 0 := by
  induction steps generalizing x with
  | nil => exact Fin.elim0 i
  | cons k steps ih =>
    rcases p with ⟨e, p⟩
    have h : w k x e ≠ 0 ∧ finiteEventPathWeight E target w steps (target k x e) p ≠ 0 :=
      mul_ne_zero_iff.mp hp
    refine Fin.cases ?_ (fun j => ?_) i
    · exact h.1
    · exact ih (target k x e) p h.2 j

end Bounty
end

section

/- The exact endpoint baseline gives a positive tilted law of mass at most two. -/

open Finset
namespace Bounty

section Law
variable {G : Type*} {P : G → Finset ℕ} (V : G → ℝ) (q : ℝ) (edges : ℕ)

theorem physical_endpoint_beta_law (g : G) (p : P g) :
    ((p.val : ℝ) * physicalEndpointBaseline q edges p.val)⁻¹ / V g =
      tiltedPhysicalBirthLaw V g (fun p => physicalEndpointBaseline q edges p.val) p := by
  unfold tiltedPhysicalBirthLaw physicalLabelLaw
  simp only [div_eq_mul_inv, mul_inv_rev]
  ring

theorem physical_endpoint_beta_pos (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (g : G)
    (hV : 0 < V g) (p : P g) (hp : 0 < p.val) (hsize : 2 * (edges + 1) ≤ p.val) :
    0 < ((p.val : ℝ) * physicalEndpointBaseline q edges p.val)⁻¹ / V g := by
  exact div_pos (inv_pos.mpr (mul_pos (by exact_mod_cast hp)
    (physical_endpoint_baseline_pos hq0 hq1 edges p.val hp hsize))) hV

theorem physical_endpoint_beta_mass_bounds (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (g : G)
    (hV : 0 < V g) (hMass : ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (hp : ∀ p : P g, 0 < p.val) (hsize : ∀ p : P g, 2 * (edges + 1) ≤ p.val) :
    1 ≤ ∑ p : P g, ((p.val : ℝ) * physicalEndpointBaseline q edges p.val)⁻¹ / V g ∧
    (∑ p : P g, ((p.val : ℝ) * physicalEndpointBaseline q edges p.val)⁻¹ / V g) ≤ 2 := by
  simp_rw [physical_endpoint_beta_law]
  exact tiltedPhysicalBirthLaw_sum_bounds V g _ hV hMass
    (fun p => physical_endpoint_baseline_bounds hq0 hq1 edges p.val (hp p) (hsize p))

end Law

end Bounty
end

section

/- Fixed probe-size choices for the positive-block local estimate. The probe
size is selected before the accuracy and active-slot parameters. -/

open Filter

namespace Bounty

/-- Any positive logarithmic block density permits a fixed probe size with
an arbitrarily large power saving, provided the tail length is positive. -/
theorem exists_repeated_big_probe_parameter (ell : ℕ) (hell : 1 ≤ ell)
    {beta E : ℝ} (hbeta : 0 < beta) (hE : 0 ≤ E) :
    ∃ m : ℕ, ell ≤ m ∧ 0 < (ell : ℝ) ^ ell / (m : ℝ) ^ ell ∧
      (ell : ℝ) ^ ell / (m : ℝ) ^ ell ≤ 1 ∧
      beta * Real.log ((ell : ℝ) ^ ell / (m : ℝ) ^ ell) / 2 ≤ -(E + 1) := by
  let delta := Real.exp (-(2 * (E + 1) / beta))
  have hd0 : 0 < delta := Real.exp_pos _
  have hd1 : delta ≤ 1 := Real.exp_le_one_iff.mpr (by apply neg_nonpos.mpr; positivity)
  obtain ⟨m, hm⟩ := exists_nat_gt ((ell : ℝ) / delta)
  have he1 : (1 : ℝ) ≤ ell := by exact_mod_cast hell
  have he0 : (0 : ℝ) < ell := lt_of_lt_of_le zero_lt_one he1
  have hem : (ell : ℝ) ≤ m := by
    apply le_trans _ hm.le
    exact (le_div_iff₀ hd0).mpr (by nlinarith)
  have hm0 : (0 : ℝ) < m := he0.trans_le hem
  have hr0 : 0 < (ell : ℝ) / m := div_pos he0 hm0
  have hr1 : (ell : ℝ) / m ≤ delta := by
    apply (div_le_iff₀ hm0).mpr
    have hh := (div_lt_iff₀ hd0).mp hm
    nlinarith
  have hr2 : (ell : ℝ) / m ≤ 1 := hr1.trans hd1
  have hlog : Real.log ((ell : ℝ) / m) ≤ -(2 * (E + 1) / beta) := by
    have hh := Real.log_le_log hr0 hr1
    simpa only [delta, Real.log_exp] using hh
  have hlog0 : Real.log ((ell : ℝ) / m) ≤ 0 := Real.log_nonpos hr0.le hr2
  refine ⟨m, by exact_mod_cast hem, by positivity, ?_, ?_⟩
  · rw [← div_pow]
    exact pow_le_one₀ hr0.le hr2
  · rw [← div_pow, Real.log_pow]
    have hh : (ell : ℝ) * Real.log ((ell : ℝ) / m) ≤
        Real.log ((ell : ℝ) / m) := by nlinarith
    have hb := mul_le_mul_of_nonneg_left (hh.trans hlog) hbeta.le
    have heq : beta * (-(2 * (E + 1) / beta)) = -2 * (E + 1) := by
      field_simp
    rw [heq] at hb
    linarith

/-- The density deficit is at most one per visit. In particular the manuscript
path length `2 * ceil (L ^ (13/25))` gives a density loss at most `L` eventually. -/
theorem eventually_repeated_big_visit_density_le {alpha tau : ℝ}
    (htau : 0 < tau) (hgap : alpha < tau) :
    ∀ᶠ L : ℝ in atTop, ∀ T : ℝ,
      T ≤ 2 * (⌈L ^ alpha⌉₊ : ℝ) + 1 → T ≤ L ^ tau := by
  filter_upwards [eventually_mul_rpow_add_le_mul_rpow htau hgap
    (show (0 : ℝ) < 1 by norm_num) 2 3, eventually_gt_atTop (0 : ℝ)] with L h hL
  intro T hT
  have hceil := Nat.ceil_lt_add_one (Real.rpow_nonneg hL.le alpha)
  nlinarith

end Bounty
end

section

/- Full active-slot averaging is exactly the existing repeated-list
projection in every ordered memory fiber. No memory labels are averaged
away or conditioned out by this identity. -/

open Finset
open scoped Classical

namespace Bounty

def cleanFullSlotPermutationEquiv {G : Type*} (J ell : ℕ) :
    PhysicalPermutations G J ell ≃ FullActiveSlotPermutations (fun _ : G => J + ell) :=
  Equiv.piCongrRight (fun _ => Equiv.permCongr finSumFinEquiv)

theorem clean_full_memory_permutation {G : Type*}
    {P : G → Finset ℕ} {J ell B : ℕ}
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
    (source : RepeatedBigLists P J ell) (r : FixedOrderedResidues p)
    (σ : PhysicalPermutations G J ell) :
    fullActivePermutation (cleanFullSlotPermutationEquiv J ell σ)
        (cleanFullMemoryState N p source r) =
      cleanFullMemoryState N p (repeatedBigPermutationEquiv σ source) r := by
  funext g
  apply Prod.ext
  · funext j
    simp only [fullActivePermutation, Equiv.coe_fn_mk, cleanFullMemoryState,
      Function.comp_apply, cleanFullSlotPermutationEquiv, Equiv.piCongrRight_apply, Pi.map,
      Equiv.permCongr_apply, Equiv.symm_apply_apply, repeatedBigPermutationEquiv]
  · rfl

theorem clean_full_memory_active_average {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell B : ℕ}
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
    (f : CleanFullMemoryState P J ell B → ℂ)
    (source : RepeatedBigLists P J ell) (r : FixedOrderedResidues p) :
    fullActiveAverage f (cleanFullMemoryState N p source r) =
      repeatedBigSymmetrizeLinear (fun target => f (cleanFullMemoryState N p target r)) source := by
  have hs := (cleanFullSlotPermutationEquiv (G := G) J ell).sum_comp
    (fun τ => (fullActivePermutationWeight (fun _ : G => J + ell) τ : ℂ) *
      f (fullActivePermutation τ (cleanFullMemoryState N p source r)))
  unfold fullActiveAverage
  rw [← hs]
  simp only [clean_full_memory_permutation, fullActivePermutationWeight,
    Complex.ofReal_inv, Complex.ofReal_natCast]
  rw [← mul_sum]
  change _ = (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ * _
  rw [Fintype.card_congr (cleanFullSlotPermutationEquiv (G := G) J ell)]

end Bounty
end

section

/- Exact separation of the full Q-list into retained and omitted bands. -/

open Finset

namespace Bounty

noncomputable def candidateMacroQIndices (c L : ℝ) (J : ℕ) : Finset ℕ :=
  (candidateQIndices c L).filter (fun j => j < J)

noncomputable def candidateQIndexSplit (c L : ℝ) (J : ℕ) :
    (candidateMicroQIndices c L J) ⊕ (candidateMacroQIndices c L J) ≃ candidateQIndices c L := by
  unfold candidateMicroQIndices candidateMacroQIndices
  apply Equiv.ofBijective
    (Sum.elim (fun j => ⟨j.val, (mem_filter.mp j.property).1⟩)
      (fun j => ⟨j.val, (mem_filter.mp j.property).1⟩))
  constructor
  · intro a b hab
    have hv := congrArg Subtype.val hab
    cases a with
    | inl a =>
      cases b with
      | inl b => exact congrArg Sum.inl (Subtype.ext hv)
      | inr b =>
        have ha := (mem_filter.mp a.property).2
        have hb := (mem_filter.mp b.property).2
        change a.val = b.val at hv
        omega
    | inr a =>
      cases b with
      | inl b =>
        have ha := (mem_filter.mp a.property).2
        have hb := (mem_filter.mp b.property).2
        change a.val = b.val at hv
        omega
      | inr b => exact congrArg Sum.inr (Subtype.ext hv)
  · intro j
    by_cases h : J ≤ j.val
    · exact ⟨Sum.inl ⟨j.val, mem_filter.mpr ⟨j.property, h⟩⟩, rfl⟩
    · exact ⟨Sum.inr ⟨j.val, mem_filter.mpr ⟨j.property, Nat.lt_of_not_ge h⟩⟩, rfl⟩

noncomputable def candidateQSlotSplit (c L : ℝ) (r J : ℕ) :
    ((candidateMicroQIndices c L J) × Fin r) ⊕ ((candidateMacroQIndices c L J) × Fin r) ≃
      (candidateQIndices c L) × Fin r :=
  (Equiv.sumProdDistrib _ _ _).symm.trans
    (Equiv.prodCongr (candidateQIndexSplit c L J) (Equiv.refl _))

theorem candidate_Q_choices_split (c L : ℝ) (r jStar J : ℕ) (hJ : J ≤ jStar) :
    (fun i => candidateQSlotChoices c L r jStar (candidateQSlotSplit c L r J i)) =
      Sum.elim (candidateMicroQSlotChoices c L r jStar J)
        (fun i : (candidateMacroQIndices c L J) × Fin r => candidateQBand (c*L) i.1.val) := by
  funext i
  cases i with
  | inl i => rfl
  | inr i =>
    have hlt := (mem_filter.mp i.1.property).2
    have hne : i.1.val ≠ jStar := by omega
    change (if i.1.val = jStar ∧ i.2.val = 0 then _ else _) = _
    rw [if_neg (fun h => hne h.1)]
    rfl

theorem candidate_Q_normalization_split (c L : ℝ) (r J : ℕ) :
    (r.factorial : ℝ)^(candidateQIndices c L).card =
      (r.factorial : ℝ)^(candidateMicroQIndices c L J).card *
        (r.factorial : ℝ)^(candidateMacroQIndices c L J).card := by
  have hcard := Fintype.card_congr (candidateQIndexSplit c L J)
  simp only [Fintype.card_sum, Fintype.card_coe] at hcard
  rw [← pow_add, hcard]

theorem candidate_Q_weight_split_micro (c L : ℝ) (r jStar J n : ℕ) (hJ : J ≤ jStar) :
    candidateQWeight c L r jStar n =
      ∑ x : ∀ i, candidateMicroQSlotChoices c L r jStar J i,
        ∑ y : ∀ i : (candidateMacroQIndices c L J) × Fin r, candidateQBand (c*L) i.1.val,
          if orderedSlotProduct (candidateMicroQSlotChoices c L r jStar J) x *
              orderedSlotProduct (fun i : (candidateMacroQIndices c L J) × Fin r =>
                candidateQBand (c*L) i.1.val) y = n then
            1 / ((r.factorial : ℝ)^(candidateMicroQIndices c L J).card *
              (r.factorial : ℝ)^(candidateMacroQIndices c L J).card) else 0 := by
  rw [candidateQWeight, ordered_slot_weight_equiv _ (candidateQSlotSplit c L r J),
    candidate_Q_choices_split c L r jStar J hJ, ordered_slot_weight_sum_split,
    candidate_Q_normalization_split]

end Bounty
end

section

/- Dropping a normalized product fiber while retaining forced conditions. -/

open Finset

namespace Bounty

theorem ordered_slot_left_product_sum {I : Type*} [Fintype I] [DecidableEq I]
    (B : I → Finset ℕ) (α β : ℝ) {d : ℕ} (hd : 0 < d) (n : ℕ) :
    (∑ y : ∀ i, B i, if d * orderedSlotProduct B y = n then 1/(α*β) else 0) =
      if d ∣ n then (1/α) * orderedSlotWeight B β (n/d) else 0 := by
  classical
  by_cases hdn : d ∣ n
  · rw [if_pos hdn, orderedSlotWeight, mul_sum]
    apply sum_congr (by ext; simp)
    intro y _
    have hi : d * orderedSlotProduct B y = n ↔ orderedSlotProduct B y = n/d := by
      constructor
      · intro h
        rw [← h, Nat.mul_div_cancel_left _ hd]
      · intro h
        rw [h, Nat.mul_div_cancel' hdn]
    by_cases h : d * orderedSlotProduct B y = n
    · rw [if_pos h, if_pos (hi.mp h), one_div_mul_one_div]
    · rw [if_neg h, if_neg (fun he => h (hi.mpr he)), mul_zero]
  · rw [if_neg hdn]
    apply sum_eq_zero
    intro y _
    exact if_neg (fun h => hdn ⟨orderedSlotProduct B y, h.symm⟩)

theorem ordered_slot_split_majorant {I J : Type*} [Fintype I] [Fintype J]
    [DecidableEq I] [DecidableEq J] (A : I → Finset ℕ) (B : J → Finset ℕ)
    {α β : ℝ} (hα : 0 ≤ α) (hA : ∀ x : ∀ i, A i, 0 < orderedSlotProduct A x)
    (hB : ∀ n, orderedSlotWeight B β n ≤ 1) (n : ℕ)
    (R : (∀ i, A i) → Prop) [DecidablePred R]
    (hR : ∀ x y, orderedSlotProduct A x * orderedSlotProduct B y = n → R x) :
    orderedSlotWeight (Sum.elim A B) (α*β) n ≤
      ∑ x : ∀ i, A i, if orderedSlotProduct A x ∣ n ∧ R x then 1/α else 0 := by
  classical
  rw [ordered_slot_weight_sum_split]
  apply sum_le_sum
  intro x _
  by_cases hx : orderedSlotProduct A x ∣ n ∧ R x
  · rw [if_pos hx, ordered_slot_left_product_sum B α β (hA x), if_pos hx.1]
    exact (mul_le_mul_of_nonneg_left (hB _) (by positivity)).trans_eq (mul_one _)
  · rw [if_neg hx]
    apply le_of_eq
    apply sum_eq_zero
    intro y _
    apply if_neg
    intro h
    exact hx ⟨⟨orderedSlotProduct B y, h.symm⟩, hR x y h⟩

end Bounty
end

section

/- Distinct chosen marks leave exactly the unmarked prime-divisor exponent. -/

open Finset

namespace Bounty

noncomputable def chosenMarkSet {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (x : ∀ g, P g) : Finset ℕ := univ.image (fun g => (x g).val)

noncomputable def unmarkedDivisorSet {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (x : ∀ g, P g) (u : ℕ) : Finset ℕ :=
  ((univ.biUnion P).filter (fun p => p ∣ u)) \ chosenMarkSet P x

theorem chosen_mark_injective {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h))) (x : ∀ g, P g) :
    Function.Injective (fun g => (x g).val) := by
  intro g h heq
  change (x g).val = (x h).val at heq
  by_contra hne
  exact disjoint_left.mp (hdisj hne) (x g).property (by rw [heq]; exact (x h).property)

theorem chosen_mark_card {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h))) (x : ∀ g, P g) :
    (chosenMarkSet P x).card = Fintype.card G := by
  rw [chosenMarkSet, card_image_of_injective _ (chosen_mark_injective P hdisj x), card_univ]

theorem unmarked_divisor_card {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h))) (x : ∀ g, P g)
    (u : ℕ) (hx : ∀ g, (x g).val ∣ u) :
    (unmarkedDivisorSet P x u).card = ∑ g, (((P g).filter (fun p => p ∣ u)).card - 1) := by
  classical
  have hsub : chosenMarkSet P x ⊆ (univ.biUnion P).filter (fun p => p ∣ u) := by
    intro p hp
    obtain ⟨g, _, rfl⟩ := mem_image.mp hp
    exact mem_filter.mpr ⟨mem_biUnion.mpr ⟨g, mem_univ _, (x g).property⟩, hx g⟩
  have hcard : ((univ.biUnion P).filter (fun p => p ∣ u)).card =
      ∑ g, ((P g).filter (fun p => p ∣ u)).card := by
    rw [filter_biUnion]
    apply card_biUnion
    intro g _ h _ hne
    exact (hdisj hne).mono (filter_subset _ _) (filter_subset _ _)
  rw [unmarkedDivisorSet, card_sdiff_of_subset hsub, hcard, chosen_mark_card P hdisj x]
  have hone : ∀ g ∈ (univ : Finset G), 1 ≤ ((P g).filter (fun p => p ∣ u)).card := by
    intro g _
    exact card_pos.mpr ⟨(x g).val, mem_filter.mpr ⟨(x g).property, hx g⟩⟩
  rw [sum_tsub_distrib univ hone]
  simp only [sum_const, card_univ, smul_eq_mul, mul_one]

theorem one_mark_choice_product {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h))) (x : ∀ g, P g)
    (q : ℝ) (V : G → ℝ) (u : ℕ) :
    (∏ g, if (x g).val ∣ u then q^(((P g).filter (fun p => p ∣ u)).card - 1)/V g else 0) =
      if ∀ g, (x g).val ∣ u then q^(unmarkedDivisorSet P x u).card / (∏ g, V g) else 0 := by
  classical
  by_cases hx : ∀ g, (x g).val ∣ u
  · rw [if_pos hx]
    simp_rw [if_pos (hx _)]
    rw [prod_div_distrib, prod_pow_eq_pow_sum, unmarked_divisor_card P hdisj x u hx]
  · rw [if_neg hx]
    obtain ⟨g, hg⟩ := not_forall.mp hx
    exact prod_eq_zero (mem_univ g) (if_neg hg)

theorem one_marked_weight_unmarked_sum {G : Type*} [DecidableEq G] (groups : Finset G)
    (P : G → Finset ℕ) (q : ℝ) (V : G → ℝ)
    (hdisj : Pairwise (fun g h : groups => Disjoint (P g.val) (P h.val))) (u : ℕ) :
    markedDivisorWeight groups P q V (fun _ => 1) (u : ℤ) =
      ∑ x : ∀ g : groups, P g.val,
        if ∀ g, (x g).val ∣ u then
          q^(unmarkedDivisorSet (fun g : groups => P g.val) x u).card / (∏ g ∈ groups, V g)
        else 0 := by
  classical
  rw [one_marked_weight_choice_sum]
  apply sum_congr (by ext; simp)
  intro x _
  have hOmega (g : G) : physicalOmega P g (u : ℤ) = ((P g).filter (fun p => p ∣ u)).card := by
    simp only [physicalOmega, physicalDivisorPool, Int.natCast_dvd_natCast]
  simp_rw [hOmega, Int.natCast_dvd_natCast]
  rw [one_mark_choice_product (fun g : groups => P g.val) hdisj x q (fun g => V g.val) u]
  rw [prod_coe_sort groups V]

end Bounty
end

section

/- The actual ghost birth factor selects one residue per prime and retains its V factor. -/

open Finset Classical

namespace Bounty

noncomputable def physicalGhostBirthAtom {P : Type*} (n : P → ℕ)
    (μ : P → ℝ) (q ρ V : ℝ) (z : UnrestrictedResidueParticle n) : ℝ :=
  |physicalGhostBirth n q ρ V z| * unrestrictedResidueWeight μ z

theorem physical_ghost_birth_atom_nonneg {P : Type*} (n : P → ℕ)
    (μ : P → ℝ) (q ρ V : ℝ) (hμ : ∀ p, 0 ≤ μ p)
    (z : UnrestrictedResidueParticle n) : 0 ≤ physicalGhostBirthAtom n μ q ρ V z :=
  mul_nonneg (abs_nonneg _) (hμ z.1)

theorem physical_ghost_birth_atom_residue_sum {P : Type*} (n : P → ℕ)
    [∀ p, NeZero (n p)] (μ : P → ℝ) (q ρ V : ℝ) (p : P) :
    (∑ r : ZMod (n p), physicalGhostBirthAtom n μ q ρ V ⟨p, r⟩) =
      |(1 - q) * V / ρ| * μ p := by
  rw [sum_eq_single (0 : ZMod (n p))]
  · simp [physicalGhostBirthAtom, physicalGhostBirth, unrestrictedResidueHit,
      unrestrictedResidueWeight]
  · intro r _ hr
    simp [physicalGhostBirthAtom, physicalGhostBirth, unrestrictedResidueHit, hr]
  · simp

theorem physical_ghost_birth_atom_prime_sum {P : Type*} [Fintype P] [DecidableEq P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (q ρ V : ℝ) (p : P) :
    (∑ z : UnrestrictedResidueParticle n, if z.1 = p then
      physicalGhostBirthAtom n μ q ρ V z else 0) = |(1 - q) * V / ρ| * μ p := by
  rw [Fintype.sum_sigma, sum_eq_single p]
  · simp only [ite_true]
    exact physical_ghost_birth_atom_residue_sum n μ q ρ V p
  · intro a _ ha
    simp only [ha, if_false, sum_const_zero]
  · simp

theorem physical_ghost_birth_atom_total {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (q ρ V : ℝ) :
    (∑ z : UnrestrictedResidueParticle n, physicalGhostBirthAtom n μ q ρ V z) =
      |(1 - q) * V / ρ| * ∑ p, μ p := by
  rw [Fintype.sum_sigma]
  simp_rw [physical_ghost_birth_atom_residue_sum]
  exact (mul_sum _ _ _).symm

theorem physical_ghost_birth_atom_tagged_sum {G : Type*} {P : G → Type*}
    (g : G) [Fintype (P g)] (n : P g → ℕ) [∀ p, NeZero (n p)]
    (μ : P g → ℝ) (q ρ V : ℝ) (p : P g) :
    (∑ z : UnrestrictedResidueParticle n, if (⟨g, z.1⟩ : Sigma P) = ⟨g, p⟩ then
      physicalGhostBirthAtom n μ q ρ V z else 0) = |(1 - q) * V / ρ| * μ p := by
  simpa only [Sigma.mk.inj_iff, heq_eq_eq, true_and] using
    physical_ghost_birth_atom_prime_sum n μ q ρ V p

theorem physical_ghost_birth_atom_tilted_le {G : Type*} {P : G → Finset ℕ}
    (V : G → ℝ) (g : G) (b : P g → ℝ)
    [∀ p : P g, NeZero p.val] (q ρ : ℝ) (hV : 0 < V g)
    {P₀ : ℝ} (hP₀ : 0 < P₀) (p : P g) (hp : P₀ ≤ (p.val : ℝ))
    (hb : 1 / 2 ≤ b p) :
    (∑ z : UnrestrictedResidueParticle (fun p : P g => p.val), if z.1 = p then
      physicalGhostBirthAtom (fun p : P g => p.val)
        (tiltedPhysicalBirthLaw V g b) q ρ (V g) z else 0) ≤
      |(1 - q) / ρ| * (2 / P₀) := by
  rw [physical_ghost_birth_atom_prime_sum]
  have he : (1 - q) * V g / ρ = ((1 - q) / ρ) * V g := by ring
  rw [he, abs_mul, abs_of_pos hV, mul_assoc]
  exact mul_le_mul_of_nonneg_left
    (tiltedPhysicalBirthLaw_scaled_atom_le V g b hV hP₀ p hp hb) (abs_nonneg _)

end Bounty
end

section

/- The physical edge retains its exact admissibility mask after ledger separation. -/

open scoped Classical
namespace Bounty
section Physical
variable {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin N → Finset (Fin J)) (k : ℤ) (L R : PhysicalMarkLists P J ell)
  (H : (g : Fin N) → Finset ↥(P g))
  (q : (g : Fin N) → BoundedOrderedTuple
    (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B)
  (e : PhysicalFullEdgeEvent C k (physicalFullMemoryState C L q))

theorem physical_full_edge_phase_avoidance_factor :
    physicalFullEdgePhase C k L R H q e =
      (if ∀ g i, (e.2 g).2.2.2 i ∉ H g then 1 else 0) *
        physicalFullEdgePhase C k L R (fun _ => ∅) q e := by
  unfold physicalFullEdgePhase
  by_cases h : physicalListAdmissible C e.1 L R
  · rw [if_pos h, if_pos h]
    exact full_edge_ledger_phase_factor _ _ _ _ _ _ _ _ _ _
  · rw [if_neg h, if_neg h, mul_zero]

theorem physical_full_edge_phase_fresh_injective
    (hphase : physicalFullEdgePhase C k L R H q e ≠ 0) (g : Fin N) :
    Function.Injective (e.2 g).2.2.2 := by
  have ha : physicalListAdmissible C e.1 L R := by
    by_contra h
    exact hphase (by simp only [physicalFullEdgePhase, if_neg h])
  have hp := hphase
  rw [physicalFullEdgePhase, if_pos ha] at hp
  apply full_edge_ledger_phase_fresh_injective _ _ _ _ _ _ _ _ _ _ hp
  intro h
  rw [physical_full_split_state_eq]
  exact Function.Embedding.injective _

theorem physical_full_edge_phase_birth_factor :
    physicalFullEdgePhase C k L R H q e =
      (if (∀ g i, (e.2 g).2.2.2 i ∉ H g) ∧
          (∀ g, Function.Injective (e.2 g).2.2.2) then 1 else 0) *
        physicalFullEdgePhase C k L R (fun _ => ∅) q e := by
  rw [physical_full_edge_phase_avoidance_factor C k L R H q e]
  by_cases hz : physicalFullEdgePhase C k L R (fun _ => ∅) q e = 0
  · simp only [hz, mul_zero]
  · have hd := physical_full_edge_phase_fresh_injective C k L R (fun _ => ∅) q e hz
    simp only [hd, forall_true_iff, and_true]

end Physical
end Bounty
end

section

/- A run-normalized phase history depends only on visits through its final index. -/

open Finset
namespace Bounty

theorem ghost_phase_run_history_congr {R : Type*} [Fintype R] [DecidableEq R]
    (a a' : ℕ → Bool) (h h' : ℕ → R) (η η' : ℕ → ℝ) (β V : ℝ) (n : ℕ)
    (ha : ∀ j ≤ n, a j = a' j) (hh : ∀ j ≤ n, h j = h' j)
    (hη : ∀ j ≤ n, η j = η' j) :
    ghostPhaseRunHistory a h η β V n = ghostPhaseRunHistory a' h' η' β V n := by
  unfold ghostPhaseRunHistory
  rw [ha n le_rfl]
  apply sum_congr rfl
  intro x hx
  congr 1
  apply finite_path_action_prefix_congr
  · intro j hj u v
    simp only [ha j (by omega), ha (j + 1) (by omega), hh j (by omega),
      hh (j + 1) (by omega), hη (j + 1) (by omega)]
  · intro u
    simp only [ha 0 (by omega), hh 0 (by omega), hη 0 (by omega)]

end Bounty
end

section

/- Canonical full-slot coordinates for a clean pattern. The full active tuple
uses `finSumFinEquiv`, and its reduced slots enumerate exactly the repeated
fresh-label coordinates. Pending labels and residues are unchanged. -/

open Finset
open scoped Classical

namespace Bounty

def cleanFullSharedSlots {G : Type*} {J ell : ℕ}
    (C : G → Finset (Fin J)) (g : G) : Finset (Fin (J + ell)) :=
  (physicalSharedSlots (ell := ell) (C g)).map finSumFinEquiv.toEmbedding

theorem cleanFullSharedSlots_mem {G : Type*} {J ell : ℕ}
    (C : G → Finset (Fin J)) (g : G) (s : PhysicalSlots J ell) :
    finSumFinEquiv s ∈ cleanFullSharedSlots C g ↔ ¬ repeatedBigUnshared C g s := by
  cases s <;> simp [cleanFullSharedSlots, physicalSharedSlots, repeatedBigUnshared]

theorem cleanFullSharedSlots_card {G : Type*} {J ell : ℕ}
    (C : G → Finset (Fin J)) (g : G) :
    (cleanFullSharedSlots (ell := ell) C g).card = J - (C g).card := by
  rw [cleanFullSharedSlots, card_map, physical_shared_slots_card]

theorem cleanFullSharedSlots_compl_card {G : Type*} {J ell : ℕ}
    (C : G → Finset (Fin J)) (g : G) :
    (cleanFullSharedSlots (ell := ell) C g)ᶜ.card = ell + (C g).card := by
  rw [card_compl, Fintype.card_fin, cleanFullSharedSlots_card]
  have hc : (C g).card ≤ J := by simpa only [Fintype.card_fin] using card_le_univ (C g)
  omega

def cleanFullUnsharedSlotEquiv {G : Type*} {J ell : ℕ}
    (C : G → Finset (Fin J)) (g : G) :
    ↥((cleanFullSharedSlots (ell := ell) C g)ᶜ) ≃
      {s : PhysicalSlots J ell // repeatedBigUnshared C g s} where
  toFun i := ⟨finSumFinEquiv.symm i.val, by
    have hi : i.val ∉ cleanFullSharedSlots C g := mem_compl.mp i.property
    have hh := cleanFullSharedSlots_mem C g (finSumFinEquiv.symm i.val)
    rw [Equiv.apply_symm_apply] at hh
    exact not_not.mp (mt hh.mpr hi)⟩
  invFun s := ⟨finSumFinEquiv s.val, mem_compl.mpr (by
    rw [cleanFullSharedSlots_mem]
    exact not_not.mpr s.property)⟩
  left_inv i := Subtype.ext (Equiv.apply_symm_apply finSumFinEquiv i.val)
  right_inv s := Subtype.ext (Equiv.symm_apply_apply finSumFinEquiv s.val)

noncomputable def cleanFullUnsharedIndex {G : Type*} {J ell : ℕ}
    (C : G → Finset (Fin J)) (g : G) :
    Fin (cleanFullSharedSlots (ell := ell) C g)ᶜ.card ≃
      {s : PhysicalSlots J ell // repeatedBigUnshared C g s} :=
  (cleanFullSharedSlots C g)ᶜ.equivFin.symm.trans (cleanFullUnsharedSlotEquiv C g)

noncomputable def cleanFullFreshEquiv {G : Type*} (P : G → Finset ℕ) {J ell : ℕ}
    (C : G → Finset (Fin J)) :
    (∀ g, Fin (cleanFullSharedSlots (ell := ell) C g)ᶜ.card → P g) ≃
      RepeatedBigFresh P C ell :=
  Equiv.piCongrRight (fun g => Equiv.arrowCongr (cleanFullUnsharedIndex C g) (Equiv.refl (P g)))

theorem cleanFullFreshEquiv_apply_index {G : Type*} (P : G → Finset ℕ) {J ell : ℕ}
    (C : G → Finset (Fin J))
    (fresh : ∀ g, Fin (cleanFullSharedSlots (ell := ell) C g)ᶜ.card → P g)
    (g : G) (i : Fin (cleanFullSharedSlots (ell := ell) C g)ᶜ.card) :
    cleanFullFreshEquiv P C fresh g (cleanFullUnsharedIndex C g i) = fresh g i := by
  change fresh g ((cleanFullUnsharedIndex C g).symm (cleanFullUnsharedIndex C g i)) = _
  rw [Equiv.symm_apply_apply]

theorem cleanFullFreshEquiv_weight {G : Type*} [Fintype G] (P : G → Finset ℕ)
    {J ell : ℕ} (C : G → Finset (Fin J)) (μ : ∀ g, P g → ℝ)
    (fresh : ∀ g, Fin (cleanFullSharedSlots (ell := ell) C g)ᶜ.card → P g) :
    (∏ g, ∏ s, μ g (cleanFullFreshEquiv P C fresh g s)) =
      ∏ g, ∏ i, μ g (fresh g i) := by
  apply prod_congr rfl
  intro g _
  exact Equiv.prod_comp (cleanFullUnsharedIndex C g).symm (fun i => μ g (fresh g i))

/-- Split a filled target using the exact source shared coordinates. -/
theorem cleanFullMemoryState_split_fill {G : Type*} {P : G → Finset ℕ}
    {J ell B : ℕ} (C : G → Finset (Fin J))
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
    (source : RepeatedBigLists P J ell) (r : FixedOrderedResidues p)
    (fresh : ∀ g, Fin (cleanFullSharedSlots (ell := ell) C g)ᶜ.card → P g) :
    productActiveMemorySplit (cleanFullSharedSlots C) B
        (cleanFullMemoryState N p (repeatedBigFill C source (cleanFullFreshEquiv P C fresh)) r) =
      ((productActiveMemorySplit (cleanFullSharedSlots C) B
        (cleanFullMemoryState N p source r)).1,
       fun g => (fresh g, ⟨N g, fun j => ⟨p g j, r g j⟩⟩)) := by
  apply Prod.ext
  · funext g i
    change repeatedBigFill C source (cleanFullFreshEquiv P C fresh) g
      (finSumFinEquiv.symm (((cleanFullSharedSlots C g).equivFin.symm i).val)) = _
    have hs := ((cleanFullSharedSlots (ell := ell) C g).equivFin.symm i).property
    have hh := cleanFullSharedSlots_mem C g
      (finSumFinEquiv.symm (((cleanFullSharedSlots C g).equivFin.symm i).val))
    rw [Equiv.apply_symm_apply] at hh
    simp only [repeatedBigFill, dif_neg (hh.mp hs)]
    rfl
  · funext g
    apply Prod.ext
    · funext i
      change repeatedBigFill C source (cleanFullFreshEquiv P C fresh) g
        (cleanFullUnsharedIndex C g i).val = fresh g i
      rw [repeated_big_fill_unshared, cleanFullFreshEquiv_apply_index]
    · rfl

/-- Reassemble a reduced target while preserving every pending occurrence. -/
theorem cleanFullMemoryState_reassemble_fill {G : Type*} {P : G → Finset ℕ}
    {J ell B : ℕ} (C : G → Finset (Fin J))
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
    (source : RepeatedBigLists P J ell) (r : FixedOrderedResidues p)
    (fresh : ∀ g, Fin (cleanFullSharedSlots (ell := ell) C g)ᶜ.card → P g) :
    (productActiveMemorySplit (cleanFullSharedSlots C) B).symm
      ((productActiveMemorySplit (cleanFullSharedSlots C) B
        (cleanFullMemoryState N p source r)).1,
       fun g => (fresh g, ⟨N g, fun j => ⟨p g j, r g j⟩⟩)) =
      cleanFullMemoryState N p (repeatedBigFill C source (cleanFullFreshEquiv P C fresh)) r := by
  rw [← cleanFullMemoryState_split_fill C N p source r fresh, Equiv.symm_apply_apply]

/-- The reduced fresh integration has exactly the physical fresh mass. -/
theorem clean_full_fresh_weighted_sum {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (F : RepeatedBigFresh P C ell → ℂ) :
    (∑ fresh : ∀ g, Fin (cleanFullSharedSlots (ell := ell) C g)ᶜ.card → P g,
      ((∏ g, ∏ i, tiltedPhysicalBirthLaw V g (b g) (fresh g i) : ℝ) : ℂ) *
        F (cleanFullFreshEquiv P C fresh)) =
      ∑ fresh : RepeatedBigFresh P C ell, (repeatedBigFreshMass V b C fresh : ℂ) * F fresh := by
  have h := (cleanFullFreshEquiv P C).sum_comp
    (fun fresh => (repeatedBigFreshMass V b C fresh : ℂ) * F fresh)
  simpa only [repeatedBigFreshMass, cleanFullFreshEquiv_weight] using h

end Bounty
end

section

/- Clean events preserve the literal total-memory size. The joint cutoff
therefore reduces to its source test, without changing the event weight. -/

open Finset
open scoped Classical

namespace Bounty

theorem unrestricted_bounded_clean_event_length {P : Type*}
    (n : P → ℕ) (Δ D : ℤ) (t B : ℕ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (e : UnrestrictedBoundedEvent n Δ D t B s)
    (he : e.1 = ∅ ∧ e.2.1 = ∅) :
    (unrestrictedBoundedEventTarget n Δ D t B s e).2.1.val = s.2.1.val := by
  rcases e with ⟨stores, promotions, select, fresh⟩
  rcases he with ⟨hs, hp⟩
  dsimp only at hs hp
  subst stores
  subst promotions
  have hs := unrestricted_clean_promotion_unique (unrestrictedResidueEligible n Δ D s.2.2) select
  subst select
  have hlen := unrestricted_clean_output_length s.1 s.2.2 (unrestrictedResidueSeed n)
    (unrestrictedResidueTransport n Δ) (unrestrictedResidueEligible n Δ D s.2.2)
  have hb : (unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
      (unrestrictedResidueTransport n Δ) ∅ ∅
      (unrestrictedCleanPromotion t (unrestrictedResidueEligible n Δ D s.2.2))).1 ≤ B := by
    rw [hlen]
    exact Nat.le_of_lt_succ s.2.1.isLt
  unfold unrestrictedBoundedEventTarget
  rw [dif_pos hb]
  exact hlen

theorem unrestricted_joint_clean_event_total_memory {G : Type*} [Fintype G]
    {P : G → Type*} (n : ∀ g, P g → ℕ) (Δ D : G → ℤ) (t : G → ℕ) (B : ℕ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B)
    (e : UnrestrictedJointEvent n Δ D t B s)
    (he : ∀ g, (e g).1 = ∅ ∧ (e g).2.1 = ∅) :
    productTotalMemory (unrestrictedJointEventTarget n Δ D t B s e) =
      productTotalMemory s := by
  apply sum_congr rfl
  intro g hg
  exact unrestricted_bounded_clean_event_length (n g) (Δ g) (D g) (t g) B (s g) (e g) (he g)

theorem unrestricted_joint_clean_event_weight {G : Type*} [Fintype G]
    {P : G → Type*} (n : ∀ g, P g → ℕ) (Δ D : G → ℤ)
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ) (t : G → ℕ) (B : ℕ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B)
    (e : UnrestrictedJointEvent n Δ D t B s)
    (he : ∀ g, (e g).1 = ∅ ∧ (e g).2.1 = ∅) :
    unrestrictedJointCutoffEventWeight n Δ D μ ρ V t B s e =
      if productTotalMemory s ≤ B then
        ∏ g, unrestrictedBoundedEventWeight (n g) (Δ g) (D g) (μ g) ρ (V g) (t g) B (s g) (e g)
      else 0 := by
  unfold unrestrictedJointCutoffEventWeight
  rw [unrestricted_joint_clean_event_total_memory n Δ D t B s e he]
  simp only [and_self]

theorem full_active_clean_event_total_memory {G : Type*} [Fintype G]
    {P : G → Type*} (n : ∀ g, P g → ℕ) {M : G → ℕ}
    (S : ∀ g, Finset (Fin (M g))) (B : ℕ) (A : SharedActiveLabels P S → Type*)
    (Δ D : ∀ c, A c → G → ℤ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullActiveEdgeEvent n S B A Δ D x)
    (he : ∀ g, (e.2 g).1 = ∅ ∧ (e.2 g).2.1 = ∅) :
    productTotalMemory (fullActiveEdgeEventTarget n S B A Δ D x e) = productTotalMemory x := by
  unfold fullActiveEdgeEventTarget
  rw [productActiveMemorySplit_total_memory_symm,
    unrestricted_joint_clean_event_total_memory n _ _ _ B _ e.2 he,
    productActiveMemorySplit_total_memory]

end Bounty
end

section

/- Products of original local phases retain their full event-path dependence. -/

open Finset
open scoped Classical
namespace Bounty
section Paths
variable {K X : Type*} (E : K → X → Type*) (target : ∀ k x, E k x → X)

theorem finite_event_local_phase_occurrences (phase : ∀ k x, E k x → ℂ)
    (steps : List K) (x : X) (p : FiniteEventPath E target steps x) :
    finiteEventLocalPhase E target phase steps x p =
      ∏ i : Fin steps.length, phase (steps.get i)
        (finiteEventPathOccurrence E target steps x p i).1
        (finiteEventPathOccurrence E target steps x p i).2 := by
  induction steps generalizing x with
  | nil => simp only [finiteEventLocalPhase, List.length_nil, Fin.prod_univ_zero]
  | cons k steps ih =>
    calc
      _ = phase k x p.1 * finiteEventLocalPhase E target phase steps (target k x p.1) p.2 := rfl
      _ = phase k x p.1 * ∏ i : Fin steps.length, phase (steps.get i)
          (finiteEventPathOccurrence E target steps (target k x p.1) p.2 i).1
          (finiteEventPathOccurrence E target steps (target k x p.1) p.2 i).2 :=
        congrArg (phase k x p.1 * ·) (ih (target k x p.1) p.2)
      _ = _ := (Fin.prod_univ_succ (fun i : Fin (steps.length + 1) =>
        phase ((k :: steps).get i) (finiteEventPathOccurrence E target (k :: steps) x p i).1
          (finiteEventPathOccurrence E target (k :: steps) x p i).2)).symm

theorem finite_event_local_phase_indicator_factor
    (phase residual : ∀ k x, E k x → ℂ) (condition : ∀ k x, E k x → Prop)
    (hphase : ∀ k x e, phase k x e = (if condition k x e then 1 else 0) * residual k x e)
    (steps : List K) (x : X) (p : FiniteEventPath E target steps x) :
    finiteEventLocalPhase E target phase steps x p =
      (if ∀ i : Fin steps.length, condition (steps.get i)
        (finiteEventPathOccurrence E target steps x p i).1
        (finiteEventPathOccurrence E target steps x p i).2 then 1 else 0) *
      finiteEventLocalPhase E target residual steps x p := by
  rw [finite_event_local_phase_occurrences, finite_event_local_phase_occurrences]
  simp_rw [hphase]
  rw [prod_mul_distrib]
  congr 1
  by_cases h : ∀ i : Fin steps.length, condition (steps.get i)
      (finiteEventPathOccurrence E target steps x p i).1
      (finiteEventPathOccurrence E target steps x p i).2
  · rw [if_pos h]
    calc
      _ = ∏ _i : Fin steps.length, (1 : ℂ) := prod_congr rfl (fun i _ => if_pos (h i))
      _ = 1 := prod_const_one
  · rw [if_neg h]
    obtain ⟨i, hi⟩ := not_forall.mp h
    exact prod_eq_zero (mem_univ i) (if_neg hi)

end Paths

theorem complex_indicator_and_of_iff (C A D : Prop)
    (dC : Decidable C) (dA : Decidable A) (dD : Decidable D) (h : C ↔ A ∧ D) :
    @ite ℂ C dC 1 0 = @ite ℂ A dA 1 0 * @ite ℂ D dD 1 0 := by
  let : Decidable C := dC
  let : Decidable A := dA
  let : Decidable D := dD
  by_cases hc : C
  · rcases h.mp hc with ⟨ha, hd⟩
    simp only [if_pos hc, if_pos ha, if_pos hd, one_mul]
  · by_cases ha : A
    · have hd : ¬ D := fun hd => hc (h.mpr ⟨ha, hd⟩)
      simp only [if_neg hc, if_pos ha, if_neg hd, mul_zero]
    · simp only [if_neg hc, if_neg ha, zero_mul]

section Ledger
variable {K L X : Type*} (E : K → X → Type*) (target : ∀ k x, E k x → X)
  (update : ∀ k, L → (x : X) → E k x → L)

theorem finite_ledger_event_local_phase (phase : ∀ k x, E k x → ℂ)
    (steps : List K) (l : L) (x : X)
    (p : FiniteEventPath (fun k (s : L × X) => E k s.2)
      (finiteLedgerEventTarget E target update) steps (l, x)) :
    finiteEventLocalPhase (fun k (s : L × X) => E k s.2)
      (finiteLedgerEventTarget E target update) (fun k s => phase k s.2) steps (l, x) p =
      finiteEventLocalPhase E target phase steps x (finiteLedgerEventPathEquiv E target update steps l x p) := by
  induction steps generalizing l x with
  | nil => rfl
  | cons k steps ih =>
    rcases p with ⟨e, p⟩
    exact congrArg (phase k x e * ·) (ih (update k l x e) (target k x e) p)

end Ledger
end Bounty
end

section

/- Reindex the complete original event row without changing its target continuation. -/

open Finset Classical

namespace Bounty

theorem coupled_ghost_skeleton_row_sum {G : Type*} [Fintype G]
    {P Z : G → Type*} [∀ g, Fintype (Z g)]
    (A D C ν : ∀ g, Z g → ℝ) (t : G → ℕ) (B : ℕ)
    (s : ProductBoundedOrderedState P Z t B)
    (F : ProductBoundedOrderedState P Z t B → ℝ) :
    (∑ e : CoupledGhostEvent t B s, |coupledGhostJointEventWeight A D C ν t B s e| *
      F (coupledGhostJointEventTarget t B s e)) =
      ∑ sk : CoupledGhostSkeleton t B s, ∑ births : CoupledGhostSamples t B s sk,
        |coupledGhostJointEventWeight A D C ν t B s
          ((coupledGhostSkeletonEquiv t B s).symm ⟨sk, births⟩)| *
        F (coupledGhostJointEventTarget t B s
          ((coupledGhostSkeletonEquiv t B s).symm ⟨sk, births⟩)) := by
  simpa only [Fintype.sum_sigma] using
    ((coupledGhostSkeletonEquiv t B s).symm.sum_comp (fun e =>
      |coupledGhostJointEventWeight A D C ν t B s e| *
        F (coupledGhostJointEventTarget t B s e))).symm

theorem full_active_edge_skeleton_row_sum {G : Type*} [Fintype G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : SharedActiveLabels P S → Type*) [∀ c, Fintype (A c)]
    (Δ D : ∀ c, A c → G → ℤ) (ω : ∀ c, A c → ℝ)
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (F : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℝ) :
    (∑ e : FullActiveEdgeEvent n S B A Δ D s,
      |fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V s e| *
        F (fullActiveEdgeEventTarget n S B A Δ D s e)) =
      ∑ sk : FullActiveEdgeSkeleton n S B A Δ D s,
        ∑ fresh : FullActiveEdgeSamples n S B A Δ D s sk,
          |fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V s
            ((fullActiveEdgeSkeletonEquiv n S B A Δ D s).symm ⟨sk, fresh⟩)| *
          F (fullActiveEdgeEventTarget n S B A Δ D s
            ((fullActiveEdgeSkeletonEquiv n S B A Δ D s).symm ⟨sk, fresh⟩)) := by
  simpa only [Fintype.sum_sigma] using
    ((fullActiveEdgeSkeletonEquiv n S B A Δ D s).symm.sum_comp (fun e =>
      |fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V s e| *
        F (fullActiveEdgeEventTarget n S B A Δ D s e))).symm

end Bounty
end

section

/- Joint memory cutoffs depend on each fixed event skeleton, not its sampled birth labels. -/

open Finset Classical

namespace Bounty

def boundedGhostSkeletonOutputCount {P Z : Type*} (t B : ℕ)
    (s : BoundedOrderedState P Z t B) (b : Fin (B + 1))
    (retained : Finset (Fin s.2.1.val)) : ℕ :=
  if retained.card + b.val ≤ B then retained.card + b.val else s.2.1.val

theorem bounded_ghost_target_count {P Z : Type*} (t B : ℕ)
    (s : BoundedOrderedState P Z t B) (b : Fin (B + 1))
    (retained : Finset (Fin s.2.1.val)) (births : Fin b.val → Z) :
    (boundedGhostEventTarget t B s ⟨b, retained, births⟩).2.1.val =
      boundedGhostSkeletonOutputCount t B s b retained := by
  unfold boundedGhostEventTarget retainedBirthTuple boundedGhostSkeletonOutputCount
  dsimp only
  split_ifs <;> rfl

theorem coupled_ghost_skeleton_target_memory {G : Type*} [Fintype G]
    {P Z : G → Type*} (t : G → ℕ) (B : ℕ)
    (s : ProductBoundedOrderedState P Z t B) (sk : CoupledGhostSkeleton t B s)
    (births : CoupledGhostSamples t B s sk) :
    productTotalMemory (coupledGhostJointEventTarget t B s
      ((coupledGhostSkeletonEquiv t B s).symm ⟨sk, births⟩)) =
      ∑ g, boundedGhostSkeletonOutputCount (t g) B (s g) (sk g).1 (sk g).2 := by
  apply sum_congr rfl
  intro g _
  exact bounded_ghost_target_count (t g) B (s g) (sk g).1 (sk g).2 _

noncomputable def unrestrictedSkeletonOutputCount {P : Type*} (n : P → ℕ) (Δ D : ℤ)
    (t B : ℕ) (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (sk : UnrestrictedLocalEdgeSkeleton n Δ D t B s) : ℕ :=
  let size := (unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
    (unrestrictedResidueTransport n Δ) sk.1 sk.2.1 sk.2.2).1
  if size ≤ B then size else s.2.1.val

theorem unrestricted_bounded_skeleton_target_count {P : Type*} (n : P → ℕ) (Δ D : ℤ)
    (t B : ℕ) (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (sk : UnrestrictedLocalEdgeSkeleton n Δ D t B s)
    (fresh : UnrestrictedFreshLabels P sk.2.1) :
    (unrestrictedBoundedEventTarget n Δ D t B s ⟨sk.1, sk.2.1, sk.2.2, fresh⟩).2.1.val =
      unrestrictedSkeletonOutputCount n Δ D t B s sk := by
  unfold unrestrictedBoundedEventTarget unrestrictedSkeletonOutputCount
  dsimp only
  split_ifs <;> rfl

end Bounty
end

section

/- Pinning a numbered retained particle can destroy symmetry even on constant continuation. -/

namespace Bounty

theorem pinned_ghost_retention_counterexample :
    let s : BoundedOrderedState Unit Bool 0 2 :=
      (fun i => Fin.elim0 i, ⟨⟨2, by decide⟩, fun i => decide (i = 0)⟩)
    let τ : Equiv.Perm (Fin 2) := Equiv.swap 0 1
    let w := fun b : Bool => if b then (1 : ℝ) else 0
    boundedGhostEventWeight w (fun _ => 1) (fun _ => 1) (fun _ => 1) 0 2 s
        ⟨⟨0, by decide⟩, {0}, fun i => Fin.elim0 i⟩ = 1 ∧
      boundedGhostEventWeight w (fun _ => 1) (fun _ => 1) (fun _ => 1) 0 2
        (boundedGhostMemoryPermute s τ) ⟨⟨0, by decide⟩, {0}, fun i => Fin.elim0 i⟩ = 0 := by
  norm_num [boundedGhostEventWeight, boundedGhostMemoryPermute, Function.comp_apply]

end Bounty
end

section

/- Dyadic index counts sensitive to the width of a logarithmic window. -/

open Finset

namespace Bounty

theorem nat_finset_card_le_real_span (S : Finset ℕ) {a b : ℝ} (hab : a ≤ b)
    (hS : ∀ n ∈ S, a ≤ (n : ℝ) ∧ (n : ℝ) ≤ b) : (S.card : ℝ) ≤ b-a+1 := by
  classical
  by_cases hs : S.Nonempty
  · let lo := S.min' hs
    let hi := S.max' hs
    have hlh : lo ≤ hi := S.min'_le_max' hs
    have hsub : S ⊆ Icc lo hi := by
      intro n hn
      exact mem_Icc.mpr ⟨S.min'_le n hn, S.le_max' n hn⟩
    have hc : S.card ≤ hi-lo+1 := by
      have h := card_le_card hsub
      rw [Nat.card_Icc] at h
      omega
    have hcR := Nat.cast_le (α := ℝ).mpr hc
    rw [Nat.cast_add, Nat.cast_sub hlh, Nat.cast_one] at hcR
    have hlo := (hS lo (S.min'_mem hs)).1
    have hhi := (hS hi (S.max'_mem hs)).2
    linarith
  · rw [not_nonempty_iff_eq_empty.mp hs, card_empty, Nat.cast_zero]
    linarith

theorem dyadic_log2_real_bounds {n : ℕ} (hn : 0 < n) :
    Real.log (n : ℝ)/Real.log 2 - 1 < (n.log2 : ℝ) ∧
      (n.log2 : ℝ) ≤ Real.log (n : ℝ)/Real.log 2 := by
  have htwo : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hpow := (Nat.log2_eq_iff hn.ne').mp (rfl : n.log2 = n.log2)
  have hupper : (n : ℝ) < (2 : ℝ)^(n.log2+1) := by exact_mod_cast hpow.2
  have hlog := Real.log_lt_log (Nat.cast_pos.mpr hn) hupper
  rw [Real.log_pow] at hlog
  constructor
  · rw [div_sub_one htwo.ne', div_lt_iff₀ htwo]
    push_cast at hlog
    nlinarith
  · exact Real.log2_le_logb n

theorem dyadic_indices_card_window (S : Finset ℕ) {a b : ℝ} (hab : a ≤ b)
    (hS : ∀ n ∈ S, 0 < n ∧ Real.exp a ≤ (n : ℝ) ∧ (n : ℝ) ≤ Real.exp b) :
    ((dyadicNatIndices S).card : ℝ) ≤ (b-a)/Real.log 2 + 2 := by
  have htwo : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hspan : a/Real.log 2-1 ≤ b/Real.log 2 := by
    have := div_le_div_of_nonneg_right hab htwo.le
    linarith
  have hbound : ∀ k ∈ dyadicNatIndices S,
      a/Real.log 2-1 ≤ (k : ℝ) ∧ (k : ℝ) ≤ b/Real.log 2 := by
    intro k hk
    obtain ⟨n, hn, rfl⟩ := mem_image.mp hk
    obtain ⟨hn0, hnlo, hnhi⟩ := hS n hn
    have hb := dyadic_log2_real_bounds hn0
    have hlo : a ≤ Real.log (n : ℝ) := by
      simpa only [Real.log_exp] using Real.log_le_log (Real.exp_pos a) hnlo
    have hhi : Real.log (n : ℝ) ≤ b := by
      simpa only [Real.log_exp] using Real.log_le_log (Nat.cast_pos.mpr hn0) hnhi
    constructor
    · have := div_le_div_of_nonneg_right hlo htwo.le
      linarith
    · exact hb.2.trans (div_le_div_of_nonneg_right hhi htwo.le)
  have h := nat_finset_card_le_real_span (dyadicNatIndices S) hspan hbound
  convert h using 1; ring

end Bounty
end

section

/- Scalar retention and birth sums for length-weighted original ghost events. -/

open Finset Classical

namespace Bounty

theorem ghost_retention_length_sum {Z : Type*} {d : ℕ}
    (old : Fin d → Z) (A D : Z → ℝ) (v : ℝ) :
    (∑ r : Finset (Fin d), ((∏ i ∈ r, A (old i)) *
      (∏ i ∈ univ \ r, |D (old i)|)) * v ^ r.card) =
      ∏ i, (A (old i) * v + |D (old i)|) := by
  rw [Finset.prod_add, powerset_univ]
  apply sum_congr rfl
  intro r _
  rw [prod_mul_distrib, prod_const]
  ring

theorem ghost_uncut_length_sum {P Z : Type*} [Fintype Z]
    (A D C ν : Z → ℝ) (v : ℝ) (t B : ℕ) (s : BoundedOrderedState P Z t B) :
    (∑ b : Fin (B + 1), ∑ r : Finset (Fin s.2.1.val), ∑ births : Fin b.val → Z,
      (((∏ i ∈ r, A (s.2.2 i)) * (∏ i ∈ univ \ r, |D (s.2.2 i)|)) *
        (∏ i, |C (births i)| * ν (births i)) / (b.val.factorial : ℝ)) * v ^ (r.card + b.val)) =
      (∏ i, (A (s.2.2 i) * v + |D (s.2.2 i)|)) *
        ∑ b ∈ range (B + 1), ((∑ z, |C z| * ν z) * v) ^ b / (b.factorial : ℝ) := by
  have hb (b : Fin (B + 1)) (r : Finset (Fin s.2.1.val)) :
      (∑ births : Fin b.val → Z,
        (((∏ i ∈ r, A (s.2.2 i)) * (∏ i ∈ univ \ r, |D (s.2.2 i)|)) *
          (∏ i, |C (births i)| * ν (births i)) / (b.val.factorial : ℝ)) * v ^ (r.card + b.val)) =
        (((∏ i ∈ r, A (s.2.2 i)) * (∏ i ∈ univ \ r, |D (s.2.2 i)|)) * v ^ r.card) *
          (((∑ z, |C z| * ν z) * v) ^ b.val / (b.val.factorial : ℝ)) := by
    calc
      _ = (((∏ i ∈ r, A (s.2.2 i)) * (∏ i ∈ univ \ r, |D (s.2.2 i)|)) * v ^ r.card) *
          (v ^ b.val / (b.val.factorial : ℝ)) *
          ∑ births : Fin b.val → Z, ∏ i, |C (births i)| * ν (births i) := by
            rw [mul_sum]
            apply sum_congr rfl
            intro births _
            rw [pow_add]
            ring
      _ = _ := by
        rw [← Fintype.prod_sum (fun (_ : Fin b.val) (z : Z) => |C z| * ν z), Fin.prod_const, mul_pow]
        ring
  simp_rw [hb]
  rw [sum_comm]
  simp_rw [← mul_sum]
  rw [← sum_mul, ghost_retention_length_sum,
    Fin.sum_univ_eq_sum_range (fun b => ((∑ z, |C z| * ν z) * v) ^ b / (b.factorial : ℝ)) (B + 1)]

end Bounty
end

section

/- Iteration of genuine weighted row bounds on the original dependent paths. -/

open Finset Classical

namespace Bounty

universe u v w

theorem finite_event_path_integral_le_lyapunov
    {K : Type u} {X : Type v} (E : K → X → Type w) [∀ k x, Fintype (E k x)]
    (target : ∀ k x, E k x → X) (weight : ∀ k x, E k x → ℝ)
    (hw : ∀ k x e, 0 ≤ weight k x e) (H : X → ℝ) (C : K → ℝ) (hC : ∀ k, 0 ≤ C k)
    (hrow : ∀ k x, ∑ e : E k x, weight k x e * H (target k x e) ≤ C k * H x)
    (steps : List K) (x : X) (F : FiniteEventPath E target steps x → ℝ)
    {L : ℝ} (hL : 0 ≤ L)
    (hF : ∀ p, F p ≤ L * H (finiteEventPathTerminal E target steps x p)) :
    finiteEventPathIntegral E target weight steps x F ≤ (steps.map C).prod * (L * H x) := by
  induction steps generalizing x with
  | nil => simpa only [finite_event_path_integral_nil, List.map_nil, List.prod_nil, one_mul,
      finiteEventPathTerminal]
      using hF PUnit.unit
  | cons k steps ih =>
    have hp : 0 ≤ (steps.map C).prod := by
      apply List.prod_nonneg
      intro a ha
      obtain ⟨k, _, rfl⟩ := List.mem_map.mp ha
      exact hC k
    rw [finite_event_path_integral_cons]
    calc
      _ ≤ ∑ e : E k x, weight k x e * ((steps.map C).prod * (L * H (target k x e))) := by
        apply sum_le_sum
        intro e _
        exact mul_le_mul_of_nonneg_left (ih _ _ (fun p => hF ⟨e, p⟩)) (hw k x e)
      _ = ((steps.map C).prod * L) * ∑ e : E k x, weight k x e * H (target k x e) := by
        rw [mul_sum]
        apply sum_congr rfl
        intro e _
        ring
      _ ≤ ((steps.map C).prod * L) * (C k * H x) :=
        mul_le_mul_of_nonneg_left (hrow k x) (mul_nonneg hp hL)
      _ = ((k :: steps).map C).prod * (L * H x) := by
        simp only [List.map_cons, List.prod_cons]
        ring

end Bounty
end

section

/- The static initial-ledger exclusion costs a square-root rare-target
error. Its complete finite-family budget still has arbitrary power decay. -/

open Filter

namespace Bounty

noncomputable def repeatedBigInitialError (s m J ell Q : ℕ) (xi P v : ℝ) : ℝ :=
  (1 + (2 : ℝ) ^ (m * s) * (((Q * Q : ℕ) : ℝ) / xi) ^ 2) *
    Real.sqrt ((s : ℝ) * (((ell + m : ℕ) : ℝ) * ((J + ell : ℕ) : ℝ)) / (v * P))

theorem repeated_big_initial_error_sq_le (s m J ell Q : ℕ)
    (xi P v : ℝ) (hP : 0 < P) (hv : 0 < v) (hell : ell ≤ m) :
    (repeatedBigInitialError s m J ell Q xi P v) ^ 2 ≤
      2 * repeatedBigNumericError s (2 * m) J ell (Q * Q) (xi ^ 2) 0 P v := by
  let u := (2 : ℝ) ^ (m * s) * (((Q * Q : ℕ) : ℝ) / xi) ^ 2
  let delta := (s : ℝ) * (((ell + m : ℕ) : ℝ) * ((J + ell : ℕ) : ℝ)) / (v * P)
  let d := (s : ℝ) * (((2 * m : ℕ) : ℝ) * (2 * ((J + ell : ℕ) : ℝ))) / (v * P)
  have hd : 0 ≤ delta := by dsimp [delta]; positivity
  have hdelta : delta ≤ d := by
    dsimp [delta, d]
    apply div_le_div_of_nonneg_right _ (mul_pos hv hP).le
    apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg s)
    have hm : ((ell + m : ℕ) : ℝ) ≤ 2 * ((2 * m : ℕ) : ℝ) := by
      exact_mod_cast (show ell + m ≤ 2 * (2 * m) by omega)
    have hh := mul_le_mul_of_nonneg_right hm (Nat.cast_nonneg (J + ell))
    nlinarith
  have hcoef : (1 + u) ^ 2 ≤ 2 * (1 + u ^ 2) := by nlinarith [sq_nonneg (u - 1)]
  have hpow : ((2 : ℝ) ^ (m * s)) ^ 2 = (2 : ℝ) ^ ((2 * m) * s) := by
    rw [← pow_mul]
    congr 1
    ring
  have hratio : ((((Q * Q : ℕ) : ℝ) / xi) ^ 2) =
      (((Q * Q) * (Q * Q) : ℕ) : ℝ) / (xi ^ 2) := by
    rw [div_pow]
    simp only [pow_two, Nat.cast_mul]
  have hu : u ^ 2 = (2 : ℝ) ^ ((2 * m) * s) *
      ((((Q * Q) * (Q * Q) : ℕ) : ℝ) / (xi ^ 2)) ^ 2 := by
    dsimp [u]
    rw [mul_pow, hpow, hratio]
  have hleft : (repeatedBigInitialError s m J ell Q xi P v) ^ 2 = (1 + u) ^ 2 * delta := by
    unfold repeatedBigInitialError
    rw [mul_pow, Real.sq_sqrt hd]
  have hright : repeatedBigNumericError s (2 * m) J ell (Q * Q) (xi ^ 2) 0 P v =
      (1 + u ^ 2) * d := by
    rw [hu]
    simp only [repeatedBigNumericError, mul_zero, zero_div, zero_add, d]
  rw [hleft, hright]
  have hc := mul_le_mul hcoef hdelta hd (by positivity : 0 ≤ 2 * (1 + u ^ 2))
  nlinarith

theorem eventually_repeated_big_initial_error_small (m J ell : ℕ)
    {a q x v c : ℝ} (ha : 0 ≤ a) (hq : 0 ≤ q) (hx : 0 ≤ x)
    (hv : 0 < v) (hc : 0 < c) (hell : ell ≤ m) (E : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (s Q : ℕ) (xi P : ℝ),
      (s : ℝ) ≤ a * Real.log L → (Q : ℝ) ≤ L ^ q →
      L ^ (-x) ≤ xi → Real.exp (L ^ c) ≤ P →
      repeatedBigInitialError s m J ell Q xi P v ≤ L ^ (-E) := by
  filter_upwards [eventually_repeated_big_numeric_error_small (2 * m) J ell ha
      (show 0 ≤ 2 * q by positivity) (show 0 ≤ 2 * x by positivity)
      (show (0 : ℝ) ≤ 0 by norm_num) hv hc (2 * E + 2),
    eventually_ge_atTop (2 : ℝ)] with L herr hL
  intro s Q xi P hs hQ hxi hP
  have hL0 : 0 < L := by linarith
  have hP0 : 0 < P := (Real.exp_pos _).trans_le hP
  have hQ' : ((Q * Q : ℕ) : ℝ) ≤ L ^ (2 * q) := by
    calc
      _ = (Q : ℝ) ^ 2 := by simp [pow_two]
      _ ≤ (L ^ q) ^ 2 := pow_le_pow_left₀ (Nat.cast_nonneg _) hQ 2
      _ = _ := by rw [← Real.rpow_natCast, ← Real.rpow_mul hL0.le]; congr 1; ring
  have hxi' : L ^ (-(2 * x)) ≤ xi ^ 2 := by
    calc
      _ = (L ^ (-x)) ^ (2 : ℕ) := by
        rw [← Real.rpow_natCast, ← Real.rpow_mul hL0.le]
        congr 1
        ring
      _ ≤ _ := pow_le_pow_left₀ (Real.rpow_nonneg hL0.le _) hxi 2
  have hn := herr s (Q * Q) (xi ^ 2) 0 P hs hQ' hxi' le_rfl (by positivity) hP
  have hsquare := (repeated_big_initial_error_sq_le s m J ell Q xi P v hP0 hv hell).trans
    (mul_le_mul_of_nonneg_left hn (by norm_num))
  have hpower : 2 * L ^ (-(2 * E + 2)) ≤ (L ^ (-E)) ^ 2 := by
    have hden : 2 ≤ L ^ (2 : ℕ) := by nlinarith
    rw [show -(2 * E + 2) = (-E) * 2 - 2 by ring,
      Real.rpow_sub hL0, Real.rpow_mul hL0.le,
      ← mul_div_assoc]
    simp only [Real.rpow_two]
    apply (div_le_iff₀ (sq_pos_of_pos hL0)).mpr
    nlinarith [sq_nonneg (L ^ (-E))]
  have hfinal := hsquare.trans hpower
  nlinarith [Real.rpow_pos_of_pos hL0 (-E)]

end Bounty
end

section

/- A uniform harmonic Mellin loss for interval character sums in a dyad. -/

open Finset

namespace Bounty

theorem harmonic_mellin_interval_variation {v Y : ℝ} {m n : ℕ}
    (hY : 0 < Y) (hmn : m < n) (hYm : Y ≤ (m+1 : ℕ)) (hn : (n : ℝ) ≤ 2*Y) :
    ‖harmonicMellinWeight v n‖+
      (∑ i ∈ Ioc m (n-1), ‖harmonicMellinWeight v (i+1)-harmonicMellinWeight v i‖) ≤
      (3+2*|v|)/Y := by
  have hn0 : 0 < (n : ℝ) := Nat.cast_pos.mpr (lt_of_le_of_lt (Nat.zero_le _) hmn)
  have hYn : Y ≤ (n : ℝ) := hYm.trans (Nat.cast_le.mpr hmn)
  have hstep : ∀ i ∈ Ioc m (n-1),
      ‖harmonicMellinWeight v (i+1)-harmonicMellinWeight v i‖ ≤ (1+|v|)/Y^2 := by
    intro i hi
    have hYi : Y ≤ (i : ℝ) := hYm.trans (Nat.cast_le.mpr (mem_Ioc.mp hi).1)
    simpa only [add_sub_cancel_left, mul_one] using
      harmonic_mellin_weight_variation_lower_scale (v := v) hY hYi (show (i : ℝ) ≤ i+1 by linarith)
  have hcard : ((Ioc m (n-1)).card : ℝ) ≤ 2*Y := by
    apply le_trans _ hn
    rw [Nat.card_Ioc]
    exact_mod_cast ((Nat.sub_le (n-1) m).trans (Nat.sub_le n 1))
  calc
    _ ≤ 1/Y+∑ _i ∈ Ioc m (n-1), (1+|v|)/Y^2 := by
      apply add_le_add
      · rw [norm_harmonic_mellin_weight v hn0]
        exact one_div_le_one_div_of_le hY hYn
      · exact sum_le_sum hstep
    _ = 1/Y+((Ioc m (n-1)).card : ℝ)*((1+|v|)/Y^2) := by
      simp only [sum_const, nsmul_eq_mul]
    _ ≤ 1/Y+(2*Y)*((1+|v|)/Y^2) := by gcongr
    _ = _ := by field_simp; ring

theorem norm_harmonic_mellin_interval_sum_le {v Y B : ℝ} {m n : ℕ}
    (g : ℕ → ℂ) (hY : 0 < Y) (hmn : m < n) (hYm : Y ≤ (m+1 : ℕ))
    (hn : (n : ℝ) ≤ 2*Y) (hB : 0 ≤ B)
    (hprefix : ∀ i ∈ Icc m n, ‖∑ j ∈ Ioc m i, g j‖ ≤ B) :
    ‖∑ i ∈ Ioc m n, harmonicMellinWeight v i*g i‖ ≤ ((3+2*|v|)/Y)*B := by
  apply (norm_complex_sum_Ioc_le_of_interval_prefix
    (fun i => harmonicMellinWeight v i) g hmn hprefix).trans
  simpa only [Nat.cast_add, Nat.cast_one] using
    mul_le_mul_of_nonneg_right (harmonic_mellin_interval_variation (v := v) hY hmn hYm hn) hB

end Bounty
end

section

/- Forest constraints on projected labels of the original independent sample coordinates. -/

open Finset Classical

namespace Bounty

noncomputable def finiteLabelMass {Z α : Type*} [Fintype Z] [DecidableEq α]
    (label : Z → α) (w : Z → ℝ) (a : α) : ℝ := ∑ z, if label z = a then w z else 0

theorem finiteLabelMass_nonneg {Z α : Type*} [Fintype Z] [DecidableEq α]
    (label : Z → α) (w : Z → ℝ) (hw : ∀ z, 0 ≤ w z) (a : α) :
    0 ≤ finiteLabelMass label w a := by
  exact sum_nonneg fun z _ => by split_ifs <;> simp_all

theorem finiteLabelMass_total {Z α : Type*} [Fintype Z] [Fintype α] [DecidableEq α]
    (label : Z → α) (w : Z → ℝ) : ∑ a, finiteLabelMass label w a = ∑ z, w z := by
  unfold finiteLabelMass
  rw [sum_comm]
  simp

theorem labeled_product_sum {I : Type*} [Fintype I] [DecidableEq I]
    (Z : I → Type*) [∀ i, Fintype (Z i)] {α : Type*} [Fintype α] [DecidableEq α]
    (label : ∀ i, Z i → α) (w : ∀ i, Z i → ℝ) (F : (I → α) → ℝ) :
    (∑ f : ∀ i, Z i, (∏ i, w i (f i)) * F (fun i => label i (f i))) =
      ∑ a : I → α, (∏ i, finiteLabelMass (label i) (w i) (a i)) * F a := by
  symm
  unfold finiteLabelMass
  simp_rw [Fintype.prod_sum (fun i z => if label i z = _ then w i z else 0), sum_mul]
  rw [sum_comm]
  apply sum_congr rfl
  intro f _
  simp only [prod_ite_zero, mem_univ, forall_const]
  have he (a : I → α) : (∀ i, label i (f i) = a i) ↔ (fun i => label i (f i)) = a :=
    ⟨fun h => funext h, fun h i => congrFun h i⟩
  simp_rw [he, ite_mul, zero_mul]
  exact Fintype.sum_ite_eq _ _

theorem labeled_birth_forest_sum_le {n : ℕ} (Z : Fin n → Type*) [∀ i, Fintype (Z i)]
    {α : Type*} [Fintype α] [DecidableEq α]
    (label : ∀ i, Z i → α) (w : ∀ i, Z i → ℝ) (code : BirthForestCode n)
    (M ε : Fin n → ℝ) (hM : ∀ i, 0 ≤ M i) (hε : ∀ i, 0 ≤ ε i)
    (hw : ∀ i z, 0 ≤ w i z) (hsum : ∀ i, ∑ z, w i z ≤ M i)
    (hatom : ∀ i a, finiteLabelMass (label i) (w i) a ≤ ε i) :
    (∑ f : ∀ i, Z i, if birthForestEqualValues code (fun i => label i (f i)) then
      ∏ i, w i (f i) else 0) ≤ ∏ i, match code i with | none => M i | some _ => ε i := by
  have he := labeled_product_sum Z label w (fun a => if birthForestEqualValues code a then 1 else 0)
  simp only [mul_ite, mul_one, mul_zero] at he
  rw [he]
  have hb := birthForestCausalMass_le_coordinate_costs code
    (fun i _ a => finiteLabelMass (label i) (w i) a) M ε hM hε
    (fun i _ a => finiteLabelMass_nonneg _ _ (hw i) a)
    (fun i _ => (finiteLabelMass_total (label i) (w i)).le.trans (hsum i))
    (fun i _ a => hatom i a)
  apply le_trans ?_ hb
  apply le_of_eq
  unfold birthForestCausalMass birthForestCausalAssignmentMass
  apply sum_congr rfl
  intro f _
  rw [birthForestAssignmentMass_eq]

end Bounty
end

section

/- Reindex actual bounded edge events without changing their birth slots. -/

open Finset Classical
namespace Bounty

noncomputable def residueEligibleReindex {P : Type*} (n : P → ℕ) (Δ D : ℤ)
    {N : ℕ} (old : Fin N → UnrestrictedResidueParticle n) (τ : Equiv.Perm (Fin N)) :
    unrestrictedResidueEligible n Δ D old ≃ unrestrictedResidueEligible n Δ D (old ∘ τ) where
  toFun j := ⟨τ.symm j, by
    rw [unrestricted_residue_eligible_perm, mem_unrestrictedPermutedEligible,
      Equiv.apply_symm_apply]
    exact j.property⟩
  invFun := fun ⟨j, hj⟩ => ⟨τ j, by
    rwa [unrestricted_residue_eligible_perm, mem_unrestrictedPermutedEligible] at hj⟩
  left_inv j := by ext; simp
  right_inv j := by ext; simp

noncomputable def residuePromotionReindex {P I : Type*} (n : P → ℕ) (Δ D : ℤ)
    {N : ℕ} (old : Fin N → UnrestrictedResidueParticle n) (τ : Equiv.Perm (Fin N)) :
    (I ↪ ↥(unrestrictedResidueEligible n Δ D old)) ≃
      (I ↪ ↥(unrestrictedResidueEligible n Δ D (old ∘ τ))) :=
  Equiv.embeddingCongr (Equiv.refl I) (residueEligibleReindex n Δ D old τ)

theorem residuePromotionReindex_val {P I : Type*} (n : P → ℕ) (Δ D : ℤ)
    {N : ℕ} (old : Fin N → UnrestrictedResidueParticle n) (τ : Equiv.Perm (Fin N))
    (e : I ↪ ↥(unrestrictedResidueEligible n Δ D old)) (i : I) :
    (residuePromotionReindex n Δ D old τ e i).val = τ.symm (e i).val := rfl

noncomputable def boundedEdgeMemoryReindex {P : Type*} (n : P → ℕ) (Δ D : ℤ)
    {t B : ℕ} (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (τ : Equiv.Perm (Fin s.2.1.val)) :
    UnrestrictedBoundedEvent n Δ D t B s ≃
      UnrestrictedBoundedEvent n Δ D t B (boundedGhostMemoryPermute s τ) :=
  Equiv.sigmaCongrRight fun _ => Equiv.sigmaCongrRight fun _ =>
    Equiv.prodCongr (residuePromotionReindex n Δ D s.2.2 τ) (Equiv.refl _)

theorem boundedEdgeMemoryReindex_apply {P : Type*} (n : P → ℕ) (Δ D : ℤ)
    {t B : ℕ} (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (τ : Equiv.Perm (Fin s.2.1.val)) (e : UnrestrictedBoundedEvent n Δ D t B s) :
    boundedEdgeMemoryReindex n Δ D s τ e =
      ⟨e.1, e.2.1, residuePromotionReindex n Δ D s.2.2 τ e.2.2.1, e.2.2.2⟩ := rfl

theorem residue_promotion_reindex_survivors {P I : Type*} [Fintype I]
    (n : P → ℕ) (Δ D : ℤ) {N : ℕ} (old : Fin N → UnrestrictedResidueParticle n)
    (τ : Equiv.Perm (Fin N)) (e : I ↪ ↥(unrestrictedResidueEligible n Δ D old)) :
    unrestrictedEdgeSurvivors (residuePromotionReindex n Δ D old τ e) =
      (unrestrictedEdgeSurvivors e).map τ.symm.toEmbedding := by
  have hs : promotionSelectedIndices (residuePromotionReindex n Δ D old τ e) =
      (promotionSelectedIndices e).map τ.symm.toEmbedding := by
    simp only [promotionSelectedIndices, map_map]
    rfl
  rw [unrestrictedEdgeSurvivors, hs]
  simp [unrestrictedEdgeSurvivors, Finset.map_sdiff]

theorem residue_promotion_reindex_memory {P I : Type*} [Fintype I]
    (n : P → ℕ) (Δ D : ℤ) {N b : ℕ} (old : Fin N → UnrestrictedResidueParticle n)
    (τ : Equiv.Perm (Fin N)) (e : I ↪ ↥(unrestrictedResidueEligible n Δ D old))
    (stored : Fin b → UnrestrictedResidueParticle n) :
    orderedTupleOccupancy (unrestrictedEdgeMemory (old ∘ τ) (unrestrictedResidueTransport n Δ)
      stored (residuePromotionReindex n Δ D old τ e)) =
    orderedTupleOccupancy (unrestrictedEdgeMemory old (unrestrictedResidueTransport n Δ) stored e) := by
  simp only [unrestrictedEdgeMemory, retained_birth_tuple_occupancy]
  rw [residue_promotion_reindex_survivors]
  congr 1
  simp [retainedTupleOccupancy, sum_map, Function.comp_apply]

theorem residue_promotion_reindex_target {P : Type*} (n : P → ℕ) (Δ D : ℤ)
    {N t : ℕ} (old : Fin N → UnrestrictedResidueParticle n) (τ : Equiv.Perm (Fin N))
    (promotions : Finset (Fin t)) (e : promotions ↪ ↥(unrestrictedResidueEligible n Δ D old))
    (fresh : UnrestrictedFreshLabels P promotions) :
    unrestrictedEdgeTarget (old ∘ τ) Sigma.fst promotions
        (residuePromotionReindex n Δ D old τ e) fresh =
      unrestrictedEdgeTarget old Sigma.fst promotions e fresh := by
  unfold unrestrictedEdgeTarget
  congr 1
  funext i
  simp [Function.comp_apply, residuePromotionReindex_val]

end Bounty
end

section

/- Local symmetric-test equality implies equality for a joint symmetric continuation. -/

open Finset Classical
namespace Bounty

theorem product_memory_test_congr {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (f : ProductBoundedOrderedState P Z t B → ℂ) (hf : ProductMemorySymmetric f)
    (x y : ProductBoundedOrderedState P Z t B)
    (hxy : ∀ g (h : BoundedOrderedState (P g) (Z g) (t g) B → ℂ),
      BoundedOrderedSymmetric h → h (y g) = h (x g)) : f y = f x := by
  let z (s : Finset G) : ProductBoundedOrderedState P Z t B :=
    fun g => if g ∈ s then y g else x g
  have hc := (product_memory_symmetric_iff_coordinate f).mp hf
  have hs (s : Finset G) : f (z s) = f x := by
    induction s using Finset.induction_on with
    | empty => simp only [z, notMem_empty, if_false]
    | @insert g s hg ih =>
      have hz : z (insert g s) = Function.update (z s) g (y g) := by
        funext j
        by_cases hj : j = g
        · subst j
          simp [z]
        · simp [z, hj]
      rw [hz]
      have hl := hxy g (fun a => f (Function.update (z s) g a))
        ((finite_local_memory_invariant_iff _).mp
          (finite_coordinate_invariant_slice g _ f (hc g) (z s)))
      rw [hl]
      have he : Function.update (z s) g (x g) = z s := by
        have hval : z s g = x g := by simp only [z, hg, if_false]
        rw [← hval, Function.update_eq_self]
      rw [he, ih]
  simpa only [z, mem_univ, if_true] using hs univ

abbrev productMemoryReindex {G : Type*} {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (x : ProductBoundedOrderedState P Z t B)
    (τ : ∀ g, Equiv.Perm (Fin (x g).2.1.val)) : ProductBoundedOrderedState P Z t B :=
  fun g => boundedGhostMemoryPermute (x g) (τ g)

theorem product_memory_reindex_test {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (f : ProductBoundedOrderedState P Z t B → ℂ) (hf : ProductMemorySymmetric f)
    (x : ProductBoundedOrderedState P Z t B)
    (τ : ∀ g, Equiv.Perm (Fin (x g).2.1.val)) : f (productMemoryReindex x τ) = f x := by
  apply product_memory_test_congr f hf
  intro g h hh
  exact hh (x g).1 (x g).2.1 (x g).2.2 (τ g)

theorem product_memory_reindex_at {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (x : ProductBoundedOrderedState P Z t B) (g : G)
    (τ : Equiv.Perm (Fin (x g).2.1.val)) :
    productMemoryReindex x (Function.update (fun h => Equiv.refl (Fin (x h).2.1.val)) g τ) =
      productMemoryPermuteAt x g τ := by
  funext h
  by_cases hh : h = g
  · subst h
    simp only [productMemoryReindex, Function.update_self, productMemoryPermuteAt]
  · simp only [productMemoryReindex, Function.update_of_ne hh, boundedGhostMemoryPermute,
      Equiv.refl_apply, Function.comp_def, productMemoryPermuteAt]

end Bounty
end

section

/- The original full physical edge, under the actual tilted prime law,
with a bounded event coefficient and fixed initial fresh-birth exclusions.
All auxiliary, storage, retrieval and fresh choices remain in the row. -/

open Finset Classical

namespace Bounty

noncomputable def physicalFullCoefficientAction {N J ell B : ℕ}
    {P : Fin N → Finset ℕ} [∀ g (p : P g), NeZero p.val]
    (C : Fin N → Finset (Fin J)) (k : ℤ)
    (V : Fin N → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ)
    (F : ∀ g, Finset (P g))
    (Ψ : ∀ x : PhysicalFullBoundedState P J ell B, PhysicalFullEdgeEvent C k x → ℂ)
    (f : PhysicalFullBoundedState P J ell B → ℂ) :
    PhysicalFullBoundedState P J ell B → ℂ :=
  fullActiveCoefficientAction (fun g (p : P g) => p.val)
    (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
    (fun _ => PhysicalAuxLabels P C) (physicalFullEdgeDelta C k) (physicalFullEdgeD C)
    (fun _ => physicalAuxMass V C) (fun g => tiltedPhysicalBirthLaw V g (baseline g)) ρ V
    (fun x e => if ∀ g i, (e.2 g).2.2.2 i ∉ F g then Ψ x e else 0) f

theorem physical_full_coefficient_projected_energy_le {N J ell B : ℕ}
    {P : Fin N → Finset ℕ} [∀ g (p : P g), NeZero p.val]
    (C : Fin N → Finset (Fin J)) (k : ℤ)
    (V : Fin N → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ)
    (F : ∀ g, Finset (P g))
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (hbaseline : ∀ g p, 1 / 2 ≤ baseline g p ∧ baseline g p ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (T : ℕ) (ht : ∀ g, ell + (C g).card ≤ T)
    (Ψ : ∀ x : PhysicalFullBoundedState P J ell B, PhysicalFullEdgeEvent C k x → ℂ)
    (H : ℝ) (hH : 0 ≤ H) (hΨ : ∀ x e, ‖Ψ x e‖ ≤ H)
    (f : PhysicalFullBoundedState P J ell B → ℂ) (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy
      (productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (baseline g))
        (fun g => unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g (baseline g))))
      (fullActiveAverage (physicalFullCoefficientAction C k V baseline ρ F Ψ (fullActiveAverage f))) ≤
      H ^ 2 * unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ N *
        finiteWeightedEnergy
          (productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (baseline g))
            (fun g => unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g (baseline g)))) f := by
  have hV : ∀ g, 0 < V g := fun g => hvmin.trans_le (hVlo g)
  have hμ : ∀ g p, 0 ≤ tiltedPhysicalBirthLaw V g (baseline g) p := by
    intro g p
    exact tiltedPhysicalBirthLaw_nonneg V g (baseline g) (hV g).le
      (fun p => (by norm_num : (0 : ℝ) ≤ 1 / 2).trans (hbaseline g p).1) p
  have hphase : ∀ x (e : PhysicalFullEdgeEvent (B := B) C k x),
      ‖if ∀ g i, (e.2 g).2.2.2 i ∉ F g then Ψ x e else 0‖ ≤ H := by
    intro x e
    split_ifs
    · exact hΨ x e
    · simpa only [norm_zero] using hH
  have h := full_active_coefficient_projected_energy_le (fun g (p : P g) => p.val)
    (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
    (fun _ => PhysicalAuxLabels P C) (physicalFullEdgeDelta C k) (physicalFullEdgeD C)
    (fun _ => physicalAuxMass V C) (fun g => tiltedPhysicalBirthLaw V g (baseline g)) ρ V
    (fun _ a => physical_aux_mass_nonneg V C (fun g => (hV g).le) a)
    (fun _ => (physical_aux_mass_sum V C hV hMass).le)
    hρ0 hρ1 hv hvmin hVlo hVhi hμ
    (fun g => (tiltedPhysicalBirthLaw_sum_bounds V g (baseline g) (hV g) (hMass g) (hbaseline g)).2)
    T (fun g => by simpa only [physical_full_unshared_indices_card] using ht g)
    _ H hH hphase f hf
  simpa only [physicalFullCoefficientAction, Fintype.card_fin] using h

end Bounty
end

section

/- Full signed edge coefficients with an auxiliary-dependent permutation
of an external finite coordinate. The external permutation is applied before
the auxiliary average. No dimension factor for the external space is used. -/

open Finset Classical

namespace Bounty

theorem finite_external_energy_of_scaled_norm {X R : Type*} [Fintype X] [Fintype R]
    (w : X → ℝ) (hw : ∀ x, 0 ≤ w x) (H : ℝ) (hH : 0 ≤ H) (K : ℝ)
    (f output majorant : X → R → ℂ)
    (hdom : ∀ x r, ‖output x r‖ ≤ ‖(H : ℂ) * majorant x r‖)
    (hbase : (∑ r, finiteWeightedEnergy w (fun x => majorant x r)) ≤
      K * ∑ r, finiteWeightedEnergy w (fun x => f x r)) :
    (∑ r, finiteWeightedEnergy w (fun x => output x r)) ≤
      H ^ 2 * K * ∑ r, finiteWeightedEnergy w (fun x => f x r) := by
  calc
    _ ≤ ∑ r, H ^ 2 * finiteWeightedEnergy w (fun x => majorant x r) := by
      apply sum_le_sum
      intro r _
      simpa only [mul_one] using finite_weighted_energy_of_scaled_norm w hw H hH 1
        (fun x => majorant x r) (fun x => output x r) (fun x => majorant x r)
        (fun x => hdom x r) (by simp only [one_mul, le_refl])
    _ = H ^ 2 * ∑ r, finiteWeightedEnergy w (fun x => majorant x r) := (mul_sum ..).symm
    _ ≤ _ := (mul_le_mul_of_nonneg_left hbase (sq_nonneg H)).trans_eq (by ring)

section

variable {G : Type*} [Fintype G] [dG : DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : SharedActiveLabels P S → Type*) [∀ c, Fintype (A c)]
  (Δ D : ∀ c, A c → G → ℤ)
  (ω : ∀ c, A c → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  {R : Type*} (τ : ∀ c, A c → R ≃ R)

noncomputable def fullActiveExternalCoefficientAction
    (Ψ : ∀ x, R → FullActiveEdgeEvent n S B A Δ D x → ℂ)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → R → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) (r : R) : ℂ :=
  ∑ e : FullActiveEdgeEvent n S B A Δ D x,
    (fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V x e : ℂ) * Ψ x r e *
      f (fullActiveEdgeEventTarget n S B A Δ D x e) (τ (productActiveMemorySplit S B x).1 e.1 r)

noncomputable def fullActiveExternalPositiveAction
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → R → ℂ) :=
  equivExternalFiberAverage (productActiveMemorySplit S B) ω
    (fun c a => unrestrictedCoupledCutoffProductOperator n (Δ c a) (D c a) μ ρ V
      (fun g => (S g)ᶜ.card) B (fun _ _ => 1)) τ f

omit [∀ g p, NeZero (n g p)] in
theorem full_active_external_positive_eq_sum
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → R → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) (r : R) :
    fullActiveExternalPositiveAction n S B A Δ D ω μ ρ V τ f x r =
      fullActiveExternalCoefficientAction n S B A Δ D ω μ ρ V τ (fun _ _ _ => 1) f x r := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  unfold fullActiveExternalPositiveAction equivExternalFiberAverage finiteExternalFiberAverage
    fullActiveExternalCoefficientAction
  rw [Fintype.sum_sigma]
  apply sum_congr rfl
  intro a _
  dsimp only
  rw [unrestricted_coupled_cutoff_eq_joint_event_sum]
  simp only [mul_sum, fullActiveEdgeEventWeight, fullActiveEdgeEventTarget,
    Complex.ofReal_mul, mul_one, mul_assoc]
  apply sum_congr
  · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
  · intro e _; rfl

omit [∀ g p, NeZero (n g p)] in
theorem full_active_external_coefficient_norm_le
    (hω : ∀ c a, 0 ≤ ω c a) (hμ : ∀ g p, 0 ≤ μ g p)
    (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ V g)
    (Ψ : ∀ x, R → FullActiveEdgeEvent n S B A Δ D x → ℂ)
    (H : ℝ) (hH : 0 ≤ H) (hΨ : ∀ x r e, ‖Ψ x r e‖ ≤ H)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → R → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) (r : R) :
    ‖fullActiveExternalCoefficientAction n S B A Δ D ω μ ρ V τ Ψ f x r‖ ≤
      ‖(H : ℂ) * fullActiveExternalPositiveAction n S B A Δ D ω μ ρ V τ
        (fun y s => (‖f y s‖ : ℂ)) x r‖ := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  have hw (e : FullActiveEdgeEvent n S B A Δ D x) :=
    fullActiveEdgeEventWeight_nonneg n S B A Δ D ω μ ρ V hω hμ hρ hV x e
  have he : fullActiveExternalPositiveAction n S B A Δ D ω μ ρ V τ
      (fun y s => (‖f y s‖ : ℂ)) x r =
      ((∑ e : FullActiveEdgeEvent n S B A Δ D x,
        fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V x e *
          ‖f (fullActiveEdgeEventTarget n S B A Δ D x e)
            (τ (productActiveMemorySplit S B x).1 e.1 r)‖ : ℝ) : ℂ) := by
    rw [full_active_external_positive_eq_sum]
    simp only [fullActiveExternalCoefficientAction, mul_one, Complex.ofReal_sum, Complex.ofReal_mul]
  rw [he, norm_mul]
  simp only [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hH]
  rw [abs_of_nonneg (sum_nonneg fun e _ => mul_nonneg (hw e) (norm_nonneg _))]
  unfold fullActiveExternalCoefficientAction
  calc
    _ ≤ ∑ e : FullActiveEdgeEvent n S B A Δ D x,
        ‖(fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V x e : ℂ) * Ψ x r e *
          f (fullActiveEdgeEventTarget n S B A Δ D x e)
            (τ (productActiveMemorySplit S B x).1 e.1 r)‖ := norm_sum_le _ _
    _ ≤ ∑ e : FullActiveEdgeEvent n S B A Δ D x,
        fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V x e * H *
          ‖f (fullActiveEdgeEventTarget n S B A Δ D x e)
            (τ (productActiveMemorySplit S B x).1 e.1 r)‖ := by
      apply sum_le_sum
      intro e _
      rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hw e)]
      exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (hΨ x r e) (hw e)) (norm_nonneg _)
    _ = _ := by
      rw [mul_sum]
      apply sum_congr rfl
      intro e _
      ring

variable [Fintype R]

theorem full_active_external_positive_energy_le
    (hω : ∀ c a, 0 ≤ ω c a) (hωmass : ∀ c, ∑ a, ω c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, (S g)ᶜ.card ≤ T)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → R → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun x => f x r)) :
    (∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fun x => fullActiveExternalPositiveAction n S B A Δ D ω μ ρ V τ f x r)) ≤
      unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        ∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
          (fun x => f x r) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  apply equiv_external_fiber_average_energy_le (productActiveMemorySplit S B)
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) (sharedActiveWeight S μ)
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productActiveMemorySplit_weight_symm S B μ _) (sharedActiveWeight_nonneg S μ hμ)
    (productMemoryWeight_nonneg μ _ hμ (fun g z => hμ g z.1)) ω hω hωmass _ τ f
    (pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _)
  intro c a r
  exact unrestricted_coupled_cutoff_product_energy_le n (Δ c a) (D c a) μ ρ V
    (fun g => (S g)ᶜ.card) B hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht
    (fun _ _ => 1) (by intros; simp only [norm_one, le_refl]) _
    (productActiveMemorySlice_symmetric S B (fun x => f x r) (hf r) c)

theorem full_active_external_coefficient_energy_le
    (hω : ∀ c a, 0 ≤ ω c a) (hωmass : ∀ c, ∑ a, ω c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, (S g)ᶜ.card ≤ T)
    (Ψ : ∀ x, R → FullActiveEdgeEvent n S B A Δ D x → ℂ)
    (H : ℝ) (hH : 0 ≤ H) (hΨ : ∀ x r e, ‖Ψ x r e‖ ≤ H)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → R → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun x => f x r)) :
    (∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fun x => fullActiveExternalCoefficientAction n S B A Δ D ω μ ρ V τ Ψ f x r)) ≤
      H ^ 2 * unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        ∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
          (fun x => f x r) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  have hp := full_active_external_positive_energy_le n S B A Δ D ω μ ρ V τ
    hω hωmass hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht (fun x r => (‖f x r‖ : ℂ))
    (fun r => complexNormEnvelope_memory_symmetric (fun x => f x r) (hf r))
  have he : (∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fun x => (‖f x r‖ : ℂ))) =
      ∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
        (fun x => f x r) := by
    apply sum_congr rfl
    intro r _
    exact complexNormEnvelope_energy _ (fun x => f x r)
  rw [he] at hp
  exact finite_external_energy_of_scaled_norm
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productMemoryWeight_nonneg μ _ hμ (fun g z => hμ g z.1)) H hH
    (unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G) f
    (fullActiveExternalCoefficientAction n S B A Δ D ω μ ρ V τ Ψ f)
    (fullActiveExternalPositiveAction n S B A Δ D ω μ ρ V τ (fun x r => (‖f x r‖ : ℂ)))
    (full_active_external_coefficient_norm_le n S B A Δ D ω μ ρ V τ hω hμ hρ0.le
      (fun g => (hvmin.trans_le (hVlo g)).le) Ψ H hH hΨ f) hp

theorem full_active_external_coefficient_projected_energy_le
    (hω : ∀ c a, 0 ≤ ω c a) (hωmass : ∀ c, ∑ a, ω c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, (S g)ᶜ.card ≤ T)
    (Ψ : ∀ x, R → FullActiveEdgeEvent n S B A Δ D x → ℂ)
    (H : ℝ) (hH : 0 ≤ H) (hΨ : ∀ x r e, ‖Ψ x r e‖ ≤ H)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → R → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun x => f x r)) :
    (∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fullActiveAverage (fun x => fullActiveExternalCoefficientAction n S B A Δ D ω μ ρ V τ Ψ
        (fun y s => fullActiveAverage (fun z => f z s) y) x r))) ≤
      H ^ 2 * unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        ∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
          (fun x => f x r) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  have h1 := sum_le_sum (s := (univ : Finset R)) (fun r _ =>
    fullActiveAverage_energy_le μ (fun g => unrestrictedResidueWeight (μ g))
      hμ (fun g z => hμ g z.1)
      (fun x => fullActiveExternalCoefficientAction n S B A Δ D ω μ ρ V τ Ψ
        (fun y s => fullActiveAverage (fun z => f z s) y) x r))
  have h2 := full_active_external_coefficient_energy_le n S B A Δ D ω μ ρ V τ
    hω hωmass hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht Ψ H hH hΨ
    (fun y s => fullActiveAverage (fun z => f z s) y)
    (fun r => fullActiveAverage_symmetric (fun x => f x r) (hf r))
  have h3 := sum_le_sum (s := (univ : Finset R)) (fun r _ =>
    fullActiveAverage_energy_le μ (fun g => unrestrictedResidueWeight (μ g))
      hμ (fun g z => hμ g z.1) (fun x => f x r))
  exact h1.trans (h2.trans (mul_le_mul_of_nonneg_left h3
    (mul_nonneg (sq_nonneg H) (pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _))))

end

end Bounty
end

section

/- Polynomial costs for the complete finite signed pattern family at an
exceptional operation. The local physical energy constant remains explicit;
no cancellation or small-norm premise is assumed. -/

namespace Bounty

noncomputable def repeatedBigFamilyEnvelope (s m Q : ℕ) (xi : ℝ) : ℝ :=
  1 + (2 : ℝ) ^ (m * s) * (((Q * Q : ℕ) : ℝ) / xi) ^ 2

theorem repeated_big_family_envelope_nonneg (s m Q : ℕ) (xi : ℝ) :
    0 ≤ repeatedBigFamilyEnvelope s m Q xi := by
  unfold repeatedBigFamilyEnvelope
  positivity

theorem repeated_big_family_envelope_le {L a q x xi : ℝ} (s m Q : ℕ)
    (hL : 1 ≤ L) (ha : 0 ≤ a) (hq : 0 ≤ q) (hx : 0 ≤ x)
    (hs : (s : ℝ) ≤ a * Real.log L) (hQ : (Q : ℝ) ≤ L ^ q)
    (hxi : L ^ (-x) ≤ xi) :
    repeatedBigFamilyEnvelope s m Q xi ≤
      2 * L ^ ((m : ℝ) * a * Real.log 2 + 4 * q + 2 * x) := by
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hxi0 : 0 < xi := (Real.rpow_pos_of_pos hL0 _).trans_le hxi
  have htwo := repeated_big_log_count_pow_le (L := L) (a := a) (b := 2) m s hL0
    (by norm_num) hs
  have hQ2 : ((Q * Q : ℕ) : ℝ) ≤ L ^ (2 * q) := by
    push_cast
    calc
      (Q : ℝ) * Q ≤ L ^ q * L ^ q :=
        mul_le_mul hQ hQ (Nat.cast_nonneg _) (Real.rpow_nonneg hL0.le _)
      _ = L ^ (2 * q) := by rw [← Real.rpow_add hL0]; congr 1; ring
  have hratio : ((Q * Q : ℕ) : ℝ) / xi ≤ L ^ (2 * q + x) := by
    calc
      _ ≤ L ^ (2 * q) / L ^ (-x) := div_le_div₀ (by positivity) hQ2
        (Real.rpow_pos_of_pos hL0 _) hxi
      _ = _ := by rw [← Real.rpow_sub hL0]; congr 1; ring
  have hB : (((Q * Q : ℕ) : ℝ) / xi) ^ 2 ≤ L ^ (4 * q + 2 * x) := by
    calc
      _ ≤ (L ^ (2 * q + x)) ^ (2 : ℕ) := pow_le_pow_left₀ (by positivity) hratio 2
      _ = _ := by rw [← Real.rpow_natCast, ← Real.rpow_mul hL0.le]; congr 1; ring
  have hgamma : 0 ≤ (m : ℝ) * a * Real.log 2 + 4 * q + 2 * x := by
    have hl : 0 ≤ Real.log 2 := Real.log_nonneg (by norm_num)
    positivity
  have hp := mul_le_mul htwo hB (sq_nonneg _) (Real.rpow_nonneg hL0.le _)
  rw [← Real.rpow_add hL0, ← add_assoc] at hp
  have hone := Real.one_le_rpow hL hgamma
  unfold repeatedBigFamilyEnvelope
  linarith

theorem repeated_big_group_energy_cost_le {L a K : ℝ} (s : ℕ)
    (hL : 0 < L) (hK : 0 ≤ K) (hs : (s : ℝ) ≤ a * Real.log L) :
    K ^ s ≤ L ^ (a * Real.log (max 1 K)) := by
  calc
    K ^ s ≤ (max 1 K) ^ s := pow_le_pow_left₀ hK (le_max_right 1 K) s
    _ ≤ _ := by
      simpa only [one_mul, Nat.cast_one] using
        repeated_big_log_count_pow_le (L := L) (a := a) (b := max 1 K)
          1 s hL (le_max_left 1 K) hs

theorem repeated_big_family_energy_cost_le {L a q x xi K : ℝ} (s m Q : ℕ)
    (hL : 2 ≤ L) (ha : 0 ≤ a) (hq : 0 ≤ q) (hx : 0 ≤ x) (hK : 0 ≤ K)
    (hs : (s : ℝ) ≤ a * Real.log L) (hQ : (Q : ℝ) ≤ L ^ q)
    (hxi : L ^ (-x) ≤ xi) :
    (repeatedBigFamilyEnvelope s m Q xi) ^ 2 * K ^ s ≤
      L ^ (2 * ((m : ℝ) * a * Real.log 2 + 4 * q + 2 * x) +
        a * Real.log (max 1 K) + 2) := by
  have hL1 : 1 ≤ L := by linarith
  have hL0 : 0 < L := zero_lt_one.trans_le hL1
  let d := (m : ℝ) * a * Real.log 2 + 4 * q + 2 * x
  have hf := repeated_big_family_envelope_le s m Q hL1 ha hq hx hs hQ hxi
  have he := repeated_big_group_energy_cost_le s hL0 hK hs
  have hfour : (4 : ℝ) ≤ L ^ (2 : ℕ) := by nlinarith
  calc
    _ ≤ (2 * L ^ d) ^ 2 * L ^ (a * Real.log (max 1 K)) :=
      mul_le_mul (pow_le_pow_left₀ (repeated_big_family_envelope_nonneg s m Q xi) hf 2)
        he (pow_nonneg hK s) (sq_nonneg _)
    _ = 4 * L ^ (2 * d + a * Real.log (max 1 K)) := by
      have hpow : (L ^ d) ^ (2 : ℕ) = L ^ (2 * d) := by
        rw [pow_two, ← Real.rpow_add hL0]
        congr 1
        ring
      rw [mul_pow, hpow]
      norm_num only [show (2 : ℝ) ^ 2 = 4 by norm_num]
      rw [mul_assoc, ← Real.rpow_add hL0]
    _ ≤ L ^ (2 : ℕ) * L ^ (2 * d + a * Real.log (max 1 K)) :=
      mul_le_mul_of_nonneg_right hfour (Real.rpow_nonneg hL0.le _)
    _ = _ := by
      rw [← Real.rpow_natCast, ← Real.rpow_add hL0]
      congr 1
      dsimp only [d]
      ring

theorem repeated_big_family_norm_cost_le {L a q x xi K : ℝ} (s m Q : ℕ)
    (hL : 2 ≤ L) (ha : 0 ≤ a) (hq : 0 ≤ q) (hx : 0 ≤ x) (hK : 0 ≤ K)
    (hs : (s : ℝ) ≤ a * Real.log L) (hQ : (Q : ℝ) ≤ L ^ q)
    (hxi : L ^ (-x) ≤ xi) :
    repeatedBigFamilyEnvelope s m Q xi * Real.sqrt (K ^ s) ≤
      L ^ ((m : ℝ) * a * Real.log 2 + 4 * q + 2 * x +
        (a / 2) * Real.log (max 1 K) + 1) := by
  have hL0 : 0 < L := by linarith
  have he := Real.sqrt_le_sqrt (repeated_big_family_energy_cost_le s m Q
    hL ha hq hx hK hs hQ hxi)
  rw [Real.sqrt_mul (sq_nonneg _),
    Real.sqrt_sq (repeated_big_family_envelope_nonneg s m Q xi)] at he
  have hright : Real.sqrt (L ^ (2 * ((m : ℝ) * a * Real.log 2 + 4 * q + 2 * x) +
        a * Real.log (max 1 K) + 2)) =
      L ^ ((m : ℝ) * a * Real.log 2 + 4 * q + 2 * x +
        (a / 2) * Real.log (max 1 K) + 1) := by
    rw [Real.sqrt_eq_rpow, ← Real.rpow_mul hL0.le]
    congr 1
    ring
  rw [hright] at he
  exact he

end Bounty
end

section

/- Exact physical history normalization under adjacent common-mark compatibility.
No global residue assignment is supplied; all original local rows and cutoffs remain. -/

open Finset
namespace Bounty

section ResiduePath
variable {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell n : ℕ}
  (C : Fin n → G → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations G J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (hcompat : ∀ j : Fin n, ∀ g s t,
    ((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val =
      ((physicalPermuteLabels (τ j) (L j.succ)) g t).val →
    (((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val : ℤ) ∣
      k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))

variable
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (g : G)
  (hk : ∀ j : Fin n, ∀ s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : ↥(P g) → ℝ) (η : Fin (n + 1) → ℝ) (V ρ : ℝ) (hV : V ≠ 0) (cap : ℕ)

noncomputable def physicalAdjacentFiniteEdge (j : Fin n) :
    GlobalBirthRawStep (R := fun p : ↥(P g) => ZMod p.val)
      (physicalGroupBareFiniteActivity L g j.castSucc) (physicalGroupBareFiniteActivity L g j.succ) :=
  physicalGroupBareFiniteEdge C aux k L a σ τ hlist hP hdis
    hcompat
    g hk β V ρ cap j

variable [∀ p : ↥(P g), NeZero p.val]

include hstep in
theorem physical_adjacent_edge_kernel_to_real (j : Fin n)
    (z w : (p : ↥(P g)) → GhostPhaseState (ZMod p.val)) :
    globalBirthRawStepKernel
      (physicalAdjacentFiniteEdge C aux k L a σ τ hcompat hlist hP hdis g hk β V ρ cap j) z w =
      (physicalResidueCappedMovingEdgeKernel L a g β V ρ cap j.val z w : ℂ) := by
  unfold physicalResidueCappedMovingEdgeKernel
  rw [show globalBirthFiniteActivity (physicalGroupBareFiniteActivity L g) (j.val + 1) =
      physicalGroupBareFiniteActivity L g j.succ from
    global_birth_finite_activity_at _ j.succ]
  rw [show globalBirthFiniteActivity (physicalGroupBareFiniteActivity L g) j.val =
      physicalGroupBareFiniteActivity L g j.castSucc from
    global_birth_finite_activity_at _ j.castSucc]
  simp_rw [physical_residue_absolute_hit_step a g j]
  refine (physical_group_permuted_bare_raw_edge_kernel (C j) (aux j) (k j)
    (L j.castSucc) (L j.succ) (a j.castSucc) (σ j) (τ j) (hlist j) hP hdis
    (hcompat j)
    g (hk j) β ρ V cap z w).trans ?_
  simp only [physicalGroupBareRawEdge, global_birth_raw_step_kernel_edge,
    ← hstep j, physical_group_phase_activity_permute]
  unfold ghostPhaseCappedDampedMovingEdge
  split_ifs <;> rfl

/- The finite atomic physical kernels are exactly the real capped kernels,
after their canonical complex embedding. Only used time indices are compared. -/
include hstep in
theorem physical_adjacent_atomic_kernel_to_real (i : ℕ) (hi : i < 2 * n + 1)
    (z w : (p : ↥(P g)) → GhostPhaseState (ZMod p.val)) :
    globalBirthRawStepKernel
      (physicalGroupAdjacentFiniteStep C aux k L a σ τ hcompat hlist hP hdis g hk β η V ρ hV cap i) z w =
      ((finiteAlternatingKernel (physicalResidueCappedVisitKernel L g β η ρ cap)
        (physicalResidueCappedMovingEdgeKernel L a g β V ρ cap) i z w : ℝ) : ℂ) := by
  by_cases hp : i % 2 = 0
  · let j : Fin (n + 1) := ⟨i / 2, by omega⟩
    have hi' : i = 2 * j.val := by dsimp [j]; omega
    rw [hi', finite_alternating_kernel_even]
    exact (global_birth_finite_alternating_kernel_even (physicalGroupBareFiniteActivity L g)
      (physicalGroupBareFiniteVisit L g β η V ρ hV cap)
      (physicalAdjacentFiniteEdge C aux k L a σ τ hcompat hlist hP hdis g hk β V ρ cap) j z w).trans
      (physical_residue_visit_kernel_to_real L g β η V ρ hV cap j z w)
  · let j : Fin n := ⟨i / 2, by omega⟩
    have hi' : i = 2 * j.val + 1 := by dsimp [j]; omega
    rw [hi', finite_alternating_kernel_odd]
    exact (global_birth_finite_alternating_kernel_odd (physicalGroupBareFiniteActivity L g)
      (physicalGroupBareFiniteVisit L g β η V ρ hV cap)
      (physicalAdjacentFiniteEdge C aux k L a σ τ hcompat hlist hP hdis g hk β V ρ cap) j z w).trans
      (physical_adjacent_edge_kernel_to_real C aux k L a σ τ hstep hcompat hlist hP hdis g hk β V ρ cap j z w)

end ResiduePath
end Bounty
end

section

/- Exact physical history normalization under adjacent common-mark compatibility.
No global residue assignment is supplied; all original local rows and cutoffs remain. -/

open Finset
open scoped Classical
namespace Bounty

section ResiduePath
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (hcompat : ∀ j : Fin n, ∀ g s t,
    ((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val =
      ((physicalPermuteLabels (τ j) (L j.succ)) g t).val →
    (((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val : ℤ) ∣
      k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))

variable
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ) (η : Fin N → Fin (n + 1) → ℝ)
  (V ρ : Fin N → ℝ) (hV : ∀ g, V g ≠ 0) (cap : ℕ)


noncomputable def physicalJointAdjacentStep (i : ℕ) (g : Fin N) :
    GlobalBirthRawStep (R := fun p : ↥(P g) => ZMod p.val)
      (physicalGroupBareAtomicActivity L g i) (physicalGroupBareAtomicActivity L g (i + 1)) :=
  physicalGroupAdjacentFiniteStep C aux k L a σ τ hcompat hlist hP hdis
    g (fun j => hk j g) (β g) (η g) (V g) (ρ g) (hV g) cap i

variable [∀ g, ∀ p : ↥(P g), NeZero p.val]

/- All groups move simultaneously, with the total cutoff applied once to
all input memories and once to all output memories at each atomic step. -/
noncomputable def physicalJointAdjacentRawHistory : ℂ :=
  globalBirthJointRawHistory (fun i g => physicalGroupBareAtomicActivity L g i)
    (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β η V ρ hV cap)
    (fun _ => cap) (2 * n + 1)
    (fun s => if ∀ g, (s g).2.1 = 0 then 1 else 0)
    (globalBirthJointInitial (fun g => physicalGroupBareAtomicActivity L g 0))

/- Exact normalized physical residue trace across all groups. The total
memory cap and every local row cap remain in the literal joint kernels. -/
theorem physical_joint_adjacent_normalized_history_trace :
    ((∏ g, ∏ s : PhysicalSlots J ell, β g (L 0 g s) / V g : ℝ) : ℂ) *
      physicalJointAdjacentRawHistory C aux k L a σ τ hcompat hlist hP hdis hk β η V ρ hV cap =
    ∑ z : Fin (2 * n + 2) → (g : Fin N) → (p : ↥(P g)) → GhostPhaseState (ZMod p.val),
      ((∏ g, ∏ p, ghostPhaseTerminal (physicalGroupPhaseActivity (L (Fin.last n)) g p)
        (z (Fin.last (2 * n + 1)) g p) : ℝ) : ℂ) *
      (((∏ g, ∏ p, ghostPhaseRunInitial (physicalGroupPhaseActivity (L 0) g p)
        (β g p) (V g) (z 0 g p) : ℝ) : ℂ) *
        ∏ j : Fin (2 * n + 1), globalBirthJointHistoryKernel
          (fun i g => physicalGroupBareAtomicActivity L g i)
          (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β η V ρ hV cap)
          (fun _ => cap) j.val (z j.succ) (z j.castSucc)) := by
  have h := global_birth_joint_weighted_empty_history_product
    (fun i g => physicalGroupBareAtomicActivity L g i)
    (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β η V ρ hV cap)
    (fun _ => cap) (fun g p => β g p / V g) (2 * n + 1)
  simpa only [physicalJointAdjacentRawHistory, physical_group_bare_atomic_activity_initial,
    physical_group_bare_atomic_activity_terminal, physical_group_initial_tilt_eq_active,
    ghost_phase_run_initial_eq_tilted] using h

end ResiduePath
end Bounty
end

