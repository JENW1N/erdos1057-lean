/- Exact reencoding of the actual mixed clean edge. The divisor includes both
small and big shared factors; both total-memory cutoffs remain in the row. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_mixed_clean_event_sum_reencode {S G : Type*} [Fintype S] [Fintype G]
    [dG : DecidableEq G] {Ps : S → Finset ℕ} {J ell B : ℕ} {P : G → Finset ℕ}
    [∀ g (p : P g), NeZero p.val]
    (C : G → Finset (Fin J)) (k : ℤ) (d : PhysicalSharedLists Ps J)
    (ω : PhysicalAuxLabels P C → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (Θ : PhysicalAuxLabels P C → (∀ g, Fin (cleanFullSharedSlots (ell := ell) C g)ᶜ.card → P g) → ℂ)
    (f : PhysicalAuxLabels P C → CleanFullMemoryState P J ell B → ℂ)
    (hf : ∀ aux, ProductMemorySymmetric (f aux))
    (x : CleanFullMemoryState P J ell B) :
    let τ := fullActivePermutation (cleanPhysicalSlotChange C)
    let y := τ x
    let Sp := fun g => physicalFullSharedIndices (ell := ell) (C g)
    let Sc := cleanFullSharedSlots (ell := ell) C
    let cp := (productActiveMemorySplit Sp B y).1
    let sp := (productActiveMemorySplit Sp B y).2
    let cc := (productActiveMemorySplit Sc B x).1
    let sc := (productActiveMemorySplit Sc B x).2
    (∑ e : FullActiveEdgeEvent (fun g (p : P g) => p.val) Sp B
        (fun _ => PhysicalAuxLabels P C) (physicalMixedEdgeDelta C k d) (physicalMixedEdgeD C d) y,
      (fullActiveEdgeEventWeight (fun g (p : P g) => p.val) Sp B
        (fun _ => PhysicalAuxLabels P C) (physicalMixedEdgeDelta C k d) (physicalMixedEdgeD C d)
        (fun _ => ω) μ ρ V y e : ℂ) *
      (if ∀ g, (e.2 g).1 = ∅ ∧ (e.2 g).2.1 = ∅ then
        Θ e.1 (physicalCleanFreshEquiv (fun g => ↥(P g)) C (fun g =>
          (unrestrictedJointEventTarget (fun g (p : P g) => p.val)
            (physicalMixedEdgeDelta C k d cp e.1) (physicalMixedEdgeD C d cp e.1)
            (fun g => (Sp g)ᶜ.card) B sp e.2 g).1)) else 0) *
      f e.1 (τ.symm (fullActiveEdgeEventTarget (fun g (p : P g) => p.val) Sp B
        (fun _ => PhysicalAuxLabels P C) (physicalMixedEdgeDelta C k d) (physicalMixedEdgeD C d) y e))) =
    ∑ e : FullActiveEdgeEvent (fun g (p : P g) => p.val) Sc B
        (fun _ => PhysicalAuxLabels P C) (canonicalMixedEdgeDelta C k d) (canonicalMixedEdgeD C d) x,
      (fullActiveEdgeEventWeight (fun g (p : P g) => p.val) Sc B
        (fun _ => PhysicalAuxLabels P C) (canonicalMixedEdgeDelta C k d) (canonicalMixedEdgeD C d)
        (fun _ => ω) μ ρ V x e : ℂ) *
      (if ∀ g, (e.2 g).1 = ∅ ∧ (e.2 g).2.1 = ∅ then
        Θ e.1 (fun g => (unrestrictedJointEventTarget (fun g (p : P g) => p.val)
          (canonicalMixedEdgeDelta C k d cc e.1) (canonicalMixedEdgeD C d cc e.1)
          (fun g => (Sc g)ᶜ.card) B sc e.2 g).1) else 0) *
      f e.1 (fullActiveEdgeEventTarget (fun g (p : P g) => p.val) Sc B
        (fun _ => PhysicalAuxLabels P C) (canonicalMixedEdgeDelta C k d) (canonicalMixedEdgeD C d) x e) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  intro τ y Sp Sc cp sp cc sc
  have hsym (a : PhysicalAuxLabels P C) : ProductMemorySymmetric (fun z => f a (τ.symm z)) :=
    fullActivePermutation_symmetric (fun g => (cleanPhysicalSlotChange C g).symm) (f a) (hf a)
  have hp := full_active_clean_event_sum (fun g (p : P g) => p.val) Sp B
    (fun _ => PhysicalAuxLabels P C) (physicalMixedEdgeDelta C k d) (physicalMixedEdgeD C d)
    (fun _ => ω) μ ρ V (fun _ a fresh => Θ a (physicalCleanFreshEquiv (fun g => ↥(P g)) C fresh))
    (fun _ a z => f a (τ.symm z)) (fun _ a => hsym a) y
  have hc := full_active_clean_event_sum (fun g (p : P g) => p.val) Sc B
    (fun _ => PhysicalAuxLabels P C) (canonicalMixedEdgeDelta C k d) (canonicalMixedEdgeD C d)
    (fun _ => ω) μ ρ V (fun _ a fresh => Θ a fresh) (fun _ => f) (fun _ => hf) x
  dsimp only at hp hc
  refine Eq.trans ?_ (hp.trans (Eq.trans ?_ (hc.symm.trans ?_)))
  · apply sum_congr
    · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
    · intro e _
      split_ifs <;> rfl
  ·
    rw [show productTotalMemory y = productTotalMemory x from rfl]
    split_ifs
    · apply sum_congr rfl
      intro a _
      have hd : physicalMixedEdgeDelta C k d cp a = canonicalMixedEdgeDelta C k d cc a :=
        physical_mixed_clean_delta_reencode C d x a k
      change (ω a : ℂ) * (∏ g, (unrestrictedBoundedCleanFactor _ (physicalMixedEdgeDelta C k d cp a g) ρ (sp g) : ℂ)) * _ =
        (ω a : ℂ) * (∏ g, (unrestrictedBoundedCleanFactor _ (canonicalMixedEdgeDelta C k d cc a g) ρ (sc g) : ℂ)) * _
      rw [hd]
      have hfactor : (∏ g, (unrestrictedBoundedCleanFactor (fun p : P g => p.val)
          (canonicalMixedEdgeDelta C k d cc a g) ρ (sp g) : ℂ)) =
        ∏ g, (unrestrictedBoundedCleanFactor (fun p : P g => p.val)
          (canonicalMixedEdgeDelta C k d cc a g) ρ (sc g) : ℂ) := by
        apply prod_congr rfl
        intro g _
        rfl
      rw [hfactor]
      congr 1
      let F := fun fresh : (∀ g, Fin (Sc g)ᶜ.card → P g) => Θ a fresh *
        f a ((productActiveMemorySplit Sc B).symm (cc, fun g =>
          unrestrictedBoundedCleanTarget (fun p : P g => p.val)
            (canonicalMixedEdgeDelta C k d cc a g) (sc g) (fresh g)))
      have hsum := physical_clean_fresh_weighted_sum (fun g => ↥(P g)) C μ F
      simp only [F, ← mul_assoc] at hsum
      refine Eq.trans ?_ hsum
      apply sum_congr rfl
      intro fresh _
      congr 1
      have hr := physical_clean_reassemble_fresh C x
        (fun g => (unrestrictedBoundedCleanTarget (fun p : P g => p.val)
          (canonicalMixedEdgeDelta C k d cc a g) (sc g) ((physicalCleanFreshEquiv (fun g => ↥(P g)) C fresh) g)).2) fresh
      change _ = τ _ at hr
      rw [show (productActiveMemorySplit Sp B).symm (_, fun g =>
          unrestrictedBoundedCleanTarget (fun p : P g => p.val)
            (canonicalMixedEdgeDelta C k d cc a g) (sp g) (fresh g)) = _ from hr]
      rw [Equiv.symm_apply_apply]
      rfl
    · rfl
  · apply sum_congr
    · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
    · intro e _
      split_ifs <;> rfl

end Bounty
end

section

/- Exact original small conditioning at one actual auxiliary draw, using the
physical mixed divisor and displacement. Endpoint gates stay in their original
order; this theorem assumes no clean operator norm. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_mixed_clean_fixed_aux_pairing {S G : Type*}
    [Fintype S] [Fintype G] [DecidableEq S] [DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    [∀ p : PhysicalPrime Ps, NeZero p.2.val] [∀ g (p : P g), NeZero p.val]
    (C : G → Finset (Fin J)) (k : ℤ) (a : PhysicalAuxLabels P C)
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (Vs : S → ℝ) (hVs : ∀ s, 0 < Vs s) (q : ℝ)
    (W : CleanFullMemoryState P J ell B → ℝ)
    (smallAux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))))
    (initial : ∀ g, Finset (P g))
    (Ψ : ∀ d x, PhysicalResidues Ps →
      PhysicalSmallBigFullEvent (fun g (p : P g) => p.val)
        (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
        (fun d c => physicalMixedEdgeDelta C k d c a)
        (fun d c => physicalMixedEdgeD C d c a) d x → ℂ)
    (sourceGate targetGate u F : PhysicalSmallBigState Ps J ell
      (CleanFullMemoryState P J ell B) → ℂ) :
    let n := fun g (p : P g) => p.val
    let shared := fun g => physicalFullSharedIndices (ell := ell) (C g)
    let Δ := fun d c => physicalMixedEdgeDelta C k d c a
    let D := fun d c => physicalMixedEdgeD C d c a
    let kbig := fun c => physicalMixedBigStep C k c a
    (∑ s, (physicalSmallBigMeasure Vs W s : ℂ) * (starRingEnd ℂ) (u s) *
      physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q
        (physicalSmallBigEndpointPhase (PhysicalSmallBigFullEvent n shared B Δ D)
          (physicalSmallBigFullTarget n shared B Δ D)
          (fun r d x e => physicalSmallBigCleanInitialPhase n shared B Δ D initial Ψ d x r e)
          (fun x => kbig (productActiveMemorySplit shared B x).1) sourceGate targetGate) F s) =
      ∑ d, ∑ r, ∑ x, (W x : ℂ) *
        (starRingEnd ℂ) (physicalSmallBigCondition Vs q (fun s => sourceGate s * u s) d x r) *
        fullActiveExternalCoefficientAction n shared B (fun _ => Unit)
          (fun c _ => Δ d c) (fun c _ => D d c) (fun _ _ => 1) μ ρ V
          (fun c _ => physicalResidueTranslationEquiv (P := Ps)
            (kbig c * (physicalSharedProduct d : ℕ)))
          (physicalSmallBigCleanInitialPhase n shared B Δ D initial Ψ d)
          (physicalSmallBigCondition Vs q (fun s => targetGate s * F s) d) x r := by
  exact physical_small_big_clean_initial_pairing (fun g (p : P g) => p.val)
    (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
    (fun d c => physicalMixedEdgeDelta C k d c a) (fun d c => physicalMixedEdgeD C d c a)
    μ ρ V (fun c => physicalMixedBigStep C k c a) Vs hVs q W smallAux initial Ψ sourceGate targetGate u F

end Bounty
end

section

/- Character expansion of the actual finite determinant sum, with all quotient cutoffs. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

def TypeIIFreeShiftConditions (E N : Finset ℕ) (y : TypeIIShiftIndex) : Prop :=
  0 < y.2.1.1 ∧ y.1.1 ≠ 0 ∧ y.1.2 = y.2.2.1 * y.2.1.2 ∧
  (y.1.2 : ℤ) + y.1.1 = (y.2.1.1 : ℤ) * y.2.2.2 ∧
  0 < typeIIRecoveredE y ∧ 0 < typeIIRecoveredN y ∧
  (typeIIRecoveredE y).toNat ∈ E ∧ (typeIIRecoveredN y).toNat ∈ N

noncomputable def typeIIFreeDeterminantSlice (E N M H Z : Finset ℕ)
    (k : ℤ) : Finset TypeIIShiftIndex := by
  classical
  exact ((({k} : Finset ℤ) ×ˢ Z) ×ˢ ((M ×ˢ H) ×ˢ (M ×ˢ H))).filter
    (TypeIIFreeShiftConditions E N)

noncomputable def typeIIShiftComplexWeight (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ)
    (y : TypeIIShiftIndex) : ℂ :=
  (η (typeIIRecoveredE y).toNat (typeIIRecoveredN y).toNat : ℂ) *
    (α y.2.1.1 * conj (α y.2.2.1) * aH y.2.1.2 * conj (aH y.2.2.2))

theorem typeII_shift_complex_weight_re (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ)
    (y : TypeIIShiftIndex) :
    (typeIIShiftComplexWeight η α aH y).re = typeIIShiftWeight η α aH y := by
  exact Complex.re_ofReal_mul _ _

theorem typeII_shift_conditions_split (E N : Finset ℕ) (y : TypeIIShiftIndex) :
    TypeIIShiftConditions E N y ↔
      TypeIIFreeShiftConditions E N y ∧
        Nat.ModEq (2 * y.1.1.natAbs) y.2.1.1 y.2.2.1 := by
  unfold TypeIIShiftConditions TypeIIFreeShiftConditions
  rw [typeII_signed_congruence_iff]
  tauto

theorem typeII_determinant_slice_eq_filter (E N M H Z : Finset ℕ) (k : ℤ) :
    typeIIDeterminantDomain E N M H {k} Z =
      (typeIIFreeDeterminantSlice E N M H Z k).filter
        (fun y => Nat.ModEq (2 * k.natAbs) y.2.1.1 y.2.2.1) := by
  classical
  ext y
  simp only [typeIIDeterminantDomain, typeIIFreeDeterminantSlice,
    mem_filter, mem_product, mem_singleton, typeII_shift_conditions_split]
  constructor
  · rintro ⟨⟨⟨hk, hz⟩, hrest⟩, hc, hmod⟩
    exact ⟨⟨⟨⟨hk, hz⟩, hrest⟩, hc⟩, by simpa only [hk] using hmod⟩
  · rintro ⟨⟨⟨⟨hk, hz⟩, hrest⟩, hc⟩, hmod⟩
    exact ⟨⟨⟨hk, hz⟩, hrest⟩, hc, by simpa only [hk] using hmod⟩

theorem typeII_determinant_slice_character_sum (E N M H Z : Finset ℕ)
    (k : ℤ) [NeZero (2 * k.natAbs)] (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ)
    (hcoprime : ∀ m ∈ M, m.Coprime (2 * k.natAbs)) :
    (∑ y ∈ typeIIDeterminantDomain E N M H {k} Z, typeIIShiftComplexWeight η α aH y) =
      (1 / ((2 * k.natAbs).totient : ℂ)) *
        ∑ χ : DirichletCharacter ℂ (2 * k.natAbs),
          ∑ y ∈ typeIIFreeDeterminantSlice E N M H Z k,
            typeIIShiftComplexWeight η α aH y * χ (y.2.1.1 : ZMod (2 * k.natAbs)) *
              conj (χ (y.2.2.1 : ZMod (2 * k.natAbs))) := by
  classical
  rw [typeII_determinant_slice_eq_filter]
  apply typeII_congruence_character_sum
  intro y hy
  have hrange := (mem_filter.mp hy).1
  exact hcoprime _ (mem_product.mp (mem_product.mp (mem_product.mp hrange).2).2).1

theorem typeII_determinant_slice_character_real (E N M H Z : Finset ℕ)
    (k : ℤ) [NeZero (2 * k.natAbs)] (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ)
    (hcoprime : ∀ m ∈ M, m.Coprime (2 * k.natAbs)) :
    (∑ y ∈ typeIIDeterminantDomain E N M H {k} Z, typeIIShiftWeight η α aH y) =
      ((1 / ((2 * k.natAbs).totient : ℂ)) *
        ∑ χ : DirichletCharacter ℂ (2 * k.natAbs),
          ∑ y ∈ typeIIFreeDeterminantSlice E N M H Z k,
            typeIIShiftComplexWeight η α aH y * χ (y.2.1.1 : ZMod (2 * k.natAbs)) *
              conj (χ (y.2.2.1 : ZMod (2 * k.natAbs)))).re := by
  have hc := congrArg Complex.re
    (typeII_determinant_slice_character_sum E N M H Z k η α aH hcoprime)
  simpa only [Complex.re_sum, typeII_shift_complex_weight_re] using hc

theorem typeII_rough_determinant_slice_characters (E N M H Z : Finset ℕ)
    (k : ℤ) [NeZero (2 * k.natAbs)] (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ)
    {W : ℝ} (hW : 2 ≤ W) (hM : ∀ m ∈ M, 0 < m)
    (hrough : ∀ m ∈ M, ∀ p ∈ m.primeFactors, W < (p : ℝ))
    (hsmall : (k.natAbs : ℝ) ≤ W) :
    (∑ y ∈ typeIIDeterminantDomain E N M H {k} Z, typeIIShiftWeight η α aH y) =
      ((1 / ((2 * k.natAbs).totient : ℂ)) *
        ∑ χ : DirichletCharacter ℂ (2 * k.natAbs),
          ∑ y ∈ typeIIFreeDeterminantSlice E N M H Z k,
            typeIIShiftComplexWeight η α aH y * χ (y.2.1.1 : ZMod (2 * k.natAbs)) *
              conj (χ (y.2.2.1 : ZMod (2 * k.natAbs)))).re := by
  apply typeII_determinant_slice_character_real
  intro m hm
  have hk : k ≠ 0 := by
    intro hk
    have hne := NeZero.ne (2 * k.natAbs)
    simp [hk] at hne
  exact typeII_rough_coprime_twice_natAbs (hM m hm) hk hW (hrough m hm) hsmall

end Bounty

end

section

/- Actual signed path energy on the genuine mixed state. Small coordinates
may change at every edge. The ghost parameter is independent of the edge
parameter, and no local operator bound remains as a hypothesis. -/

open Finset
open scoped Classical

namespace Bounty

theorem exists_physical_small_big_path_energy_bound
    {qsmall vs : ℝ} (hq0 : 0 ≤ qsmall) (hq1 : qsmall < 1) (hvs : 0 < vs) (ell : ℕ) :
    ∃ Ccond : ℝ, 1 ≤ Ccond ∧ ∀ (H K S G : Type) [Fintype S] [DecidableEq S]
      [Fintype G] [DecidableEq G]
      (Ps : S → Finset ℕ) [∀ p : PhysicalPrime Ps, NeZero p.2.val]
      (P : G → Type) [∀ g, Fintype (P g)] (n : ∀ g, P g → ℕ)
      [∀ g p, NeZero (n g p)] (J : ℕ) (M : G → ℕ)
      (shared : K → ∀ g, Finset (Fin (M g))) (B : ℕ) (A : K → Type) [∀ k, Fintype (A k)]
      (Δ D : ∀ k, PhysicalSharedLists Ps J → SharedActiveLabels P (shared k) → A k → G → ℤ)
      (kbig : ∀ k, SharedActiveLabels P (shared k) → A k → ℤ)
      (ω : ∀ k, A k → ℝ) (μ : ∀ g, P g → ℝ) (qghost : H → ℝ) (ρ : ℝ)
      (Vedge Vghost : G → ℝ) (Vs : S → ℝ), (∀ s, vs ≤ Vs s) →
      (∀ k a, 0 ≤ ω k a) → (∀ k, ∑ a, ω k a ≤ 1) →
      ∀ (v vmin vmaxEdge vmaxGhost : ℝ), 0 < ρ → ρ < 1 → 1 < v → 0 < vmin →
      (∀ g, vmin ≤ Vedge g) → (∀ g, Vedge g ≤ vmaxEdge) →
      (∀ g, 0 ≤ Vghost g) → (∀ g, Vghost g ≤ vmaxGhost) →
      (∀ g p, 0 < μ g p) → (∀ g, ∑ p, μ g p ≤ 2) →
      (∀ j, 0 ≤ qghost j) → (∀ j, qghost j ≤ 1) →
      (∀ j, qghost j / ρ ^ 2 + ((1 - qghost j) / ρ) / v ≤ 1) →
      (∀ j g, qghost j / ρ ^ 2 + ((1 - qghost j) * Vghost g / ρ) / v ≤ 1) →
      ∀ (T : ℕ), (∀ k g, (shared k g)ᶜ.card ≤ T) →
      ∀ (steps : List (Option (H ⊕ K)))
        (phase : ∀ s, PhysicalSmallBigPath n shared B A Δ D kbig steps s → ℂ),
      (∀ s p, ‖phase s p‖ ≤ 1) →
      ∀ (f : PhysicalSmallBigState Ps J ell
        (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ),
      (∀ s, ProductMemorySymmetric (fun x => f (s, x))) →
      physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
        (physicalSmallBigPathVaryingGhostAction n shared B A Δ D kbig ω μ qghost ρ
          Vedge Vghost Vs qsmall steps phase f) ≤
        (steps.map (physicalSmallBigPathStepEnergy Ccond ρ v vmin vmaxEdge vmaxGhost
          T (Fintype.card S) (Fintype.card G))).prod *
        physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  obtain ⟨Ccond, hCcond, hedge⟩ := exists_physical_small_big_path_edge_energy_bound hq0 hq1 hvs ell
  refine ⟨Ccond, hCcond, ?_⟩
  intro H K S G _ dS _ dG
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  intro Ps _ P _ n _ J M shared B A _ Δ D kbig ω μ qghost ρ Vedge Vghost Vs hVs
    hω hωmass v vmin vmaxEdge vmaxGhost hρ0 hρ1 hv hvmin hVlo hVhi hVg0 hVghi hμ hmass
    hqg0 hqg1 hD hC T ht steps phase hphase f hf
  have hVs0 : ∀ s, 0 < Vs s := fun s => hvs.trans_le (hVs s)
  have hμ0 : ∀ g p, 0 ≤ μ g p := fun g p => (hμ g p).le
  have hVe0 : ∀ g, 0 ≤ Vedge g := fun g => (hvmin.trans_le (hVlo g)).le
  apply physical_small_big_varying_ghost_path_energy_of_local n shared B A Δ D kbig
    ω μ qghost ρ Vedge Vghost Vs qsmall hVs0 hμ0
    (physicalSmallBigPathStepEnergy Ccond ρ v vmin vmaxEdge vmaxGhost T (Fintype.card S) (Fintype.card G))
    (physical_small_big_path_step_energy_nonneg Ccond ρ v vmin vmaxEdge vmaxGhost T
      (Fintype.card S) (Fintype.card G) (zero_le_one.trans hCcond))
    ?_ ?_ steps phase hphase f hf
  · intro tag F hF
    cases tag with
    | none =>
      rw [physical_small_big_path_positive_permutation_eq]
      exact physical_small_big_joint_average_memory_symmetric F hF
    | some tag =>
      cases tag with
      | inl j =>
        exact physical_small_big_path_positive_ghost_symmetric n shared B A Δ D kbig
          ω μ qghost ρ Vedge Vghost Vs qsmall hμ0 j (hqg0 j) F hF
      | inr k =>
        exact physical_small_big_path_positive_edge_symmetric n shared B A Δ D kbig
          ω μ qghost ρ Vedge Vghost Vs qsmall hVs0 hω hμ0 hρ0.le hVe0 k F hF
  · intro tag F hF
    cases tag with
    | none =>
      rw [physical_small_big_path_positive_permutation_eq]
      simpa only [physicalSmallBigPathStepEnergy, one_mul] using
        physical_small_big_joint_average_energy_le Vs hVs0 μ
          (fun g => unrestrictedResidueWeight (μ g)) hμ0 (fun g z => hμ0 g z.1) F
    | some tag =>
      cases tag with
      | inl j =>
        exact physical_small_big_path_positive_ghost_energy_le n shared B A Δ D kbig
          ω μ qghost ρ Vedge Vghost Vs qsmall hVs0 v vmaxGhost hμ hmass j
          (hqg0 j) (hqg1 j) hρ0 hVg0 hVghi (zero_lt_one.trans hv) (hD j) (hC j) F hF
      | inr k =>
        exact hedge H K S G Ps P n J M shared B A Δ D kbig ω μ qghost ρ
          Vedge Vghost Vs hVs hω hωmass v vmin vmaxEdge hρ0 hρ1 hv hvmin hVlo hVhi
          hμ0 hmass T ht k F hF

end Bounty
end

