section
open scoped BigOperators InnerProductSpace Classical
theorem finite_orthogonal_norm_sum_sq {J E : Type*}
    [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (s : Finset J) (v : J → E)
    (hoff : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → inner ℂ (v i) (v j) = 0) :
    ‖∑ i ∈ s, v i‖ ^ 2 = ∑ i ∈ s, ‖v i‖ ^ 2 := by
  rw [norm_sq_eq_re_inner (𝕜 := ℂ)]
  change (inner ℂ (∑ i ∈ s, v i) (∑ i ∈ s, v i)).re = _
  simp only [sum_inner, inner_sum, Complex.re_sum]
  apply Finset.sum_congr rfl
  intro j hj
  rw [Finset.sum_eq_single j]
  · exact (norm_sq_eq_re_inner (𝕜 := ℂ) (v j)).symm
  · intro i hi hij
    rw [hoff i hi j hj hij]
    rfl
  · exact fun h => (h hj).elim

theorem finite_measure_vector_sum {J X : Type*} (s : Finset J)
    (μ : X → ℝ) (v : J → X → ℂ) :
    finiteMeasureVector μ (∑ i ∈ s, v i) = ∑ i ∈ s, finiteMeasureVector μ (v i) := by
  apply PiLp.ext
  intro x
  simp only [finite_measure_vector_apply, Finset.sum_apply, WithLp.ofLp_sum, Finset.mul_sum]

theorem finite_weighted_orthogonal_energy {J X : Type*} [Fintype X]
    (s : Finset J) (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (v : J → X → ℂ)
    (hoff : ∀ i ∈ s, ∀ j ∈ s, i ≠ j →
      (∑ x, (μ x : ℂ) * ((starRingEnd ℂ) (v i x) * v j x)) = 0) :
    finiteWeightedEnergy μ (∑ i ∈ s, v i) = ∑ i ∈ s, finiteWeightedEnergy μ (v i) := by
  unfold finiteWeightedEnergy
  rw [← finite_measure_vector_norm_sq μ hμ, finite_measure_vector_sum]
  rw [finite_orthogonal_norm_sum_sq s (fun i => finiteMeasureVector μ (v i))]
  · simp only [finite_measure_vector_norm_sq μ hμ]
  · intro i hi j hj hij
    rw [finite_measure_vector_inner μ hμ]
    simpa only [mul_assoc] using hoff i hi j hj hij

theorem finite_coordinate_component_energy_sum {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hμ : ∀ i x, 0 ≤ μ i x) (hmass : ∀ i, ∑ y, μ i y = 1)
    (is : List I) (hnodup : is.Nodup) (f : (∀ j, X j) → ℂ) :
    (∑ S ∈ is.toFinset.powerset,
      finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ S is f)) =
      finiteWeightedEnergy (finiteProductWeight μ) f := by
  have h := finite_weighted_orthogonal_energy is.toFinset.powerset
    (finiteProductWeight μ) (fun x => Finset.prod_nonneg (fun i _ => hμ i (x i)))
    (fun S => finiteCoordinateComponent μ S is f)
    (fun S hS T hT hST => finite_coordinate_components_orthogonal μ hmass is S T
      (Finset.mem_powerset.mp hS) (Finset.mem_powerset.mp hT) hST f f)
  rw [finite_coordinate_component_sum μ is hnodup] at h
  exact h.symm
end

section
open scoped BigOperators Classical
theorem finite_coordinate_choice_add {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (i : I) (S : Finset I) (f g : (∀ j, X j) → ℂ) :
    finiteCoordinateChoice μ i S (f + g) =
      finiteCoordinateChoice μ i S f + finiteCoordinateChoice μ i S g := by
  by_cases hi : i ∈ S
  · simp only [finiteCoordinateChoice, if_pos hi, finite_coordinate_average_add]
    abel
  · simp only [finiteCoordinateChoice, if_neg hi, finite_coordinate_average_add]

theorem finite_coordinate_choice_commute {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (i j : I) (S T : Finset I) (f : (∀ k, X k) → ℂ) :
    finiteCoordinateChoice μ i S (finiteCoordinateChoice μ j T f) =
      finiteCoordinateChoice μ j T (finiteCoordinateChoice μ i S f) := by
  by_cases hi : i ∈ S <;> by_cases hj : j ∈ T
  · simp only [finiteCoordinateChoice, if_pos hi, if_pos hj, finite_coordinate_average_sub]
    rw [finite_coordinate_average_commute μ i j]
    abel
  · simp only [finiteCoordinateChoice, if_pos hi, if_neg hj, finite_coordinate_average_sub]
    rw [finite_coordinate_average_commute μ i j]
  · simp only [finiteCoordinateChoice, if_neg hi, if_pos hj, finite_coordinate_average_sub]
    rw [finite_coordinate_average_commute μ i j]
  · simp only [finiteCoordinateChoice, if_neg hi, if_neg hj]
    exact finite_coordinate_average_commute μ i j f

theorem finite_coordinate_component_add {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (S : Finset I) (is : List I) (f g : (∀ j, X j) → ℂ) :
    finiteCoordinateComponent μ S is (f + g) =
      finiteCoordinateComponent μ S is f + finiteCoordinateComponent μ S is g := by
  induction is with
  | nil => rfl
  | cons i is ih =>
    simp only [finiteCoordinateComponent, ih, finite_coordinate_choice_add]

theorem finite_coordinate_component_zero {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (S : Finset I) (is : List I) : finiteCoordinateComponent μ S is 0 = 0 := by
  induction is with
  | nil => rfl
  | cons i is ih => simp only [finiteCoordinateComponent, ih, finite_coordinate_choice_zero]

theorem finite_coordinate_component_perm {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (S : Finset I) {is js : List I} (h : is.Perm js) (f : (∀ j, X j) → ℂ) :
    finiteCoordinateComponent μ S is f = finiteCoordinateComponent μ S js f := by
  induction h with
  | nil => rfl
  | cons i h ih => simp only [finiteCoordinateComponent, ih]
  | swap i j is => exact finite_coordinate_choice_commute μ j i S S _
  | trans h₁ h₂ ih₁ ih₂ => exact ih₁.trans ih₂

theorem finite_coordinate_component_finset_sum {I J : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (S : Finset I) (is : List I) (s : Finset J) (f : J → (∀ j, X j) → ℂ) :
    finiteCoordinateComponent μ S is (∑ j ∈ s, f j) =
      ∑ j ∈ s, finiteCoordinateComponent μ S is (f j) := by
  induction s using Finset.induction_on with
  | empty => simp only [Finset.sum_empty, finite_coordinate_component_zero]
  | @insert j s hj ih =>
    rw [Finset.sum_insert hj, finite_coordinate_component_add, ih, Finset.sum_insert hj]
end

section
open Finset
theorem finite_prime_sieve_events {Ω : Type*} (P : Finset ℕ)
    (T : Finset Ω) (μ : Ω → ℝ) (bad : Ω → ℕ → Prop) [∀ t p, Decidable (bad t p)]
    (g r : ℕ → ℝ) {z X C η : ℝ} {h : ℕ}
    (hz : 1 < z) (hX : 0 ≤ X) (hC : 0 ≤ C) (hη : 0 < η)
    (hh : 1 ≤ h) (heven : Even h) (hP : ∀ p ∈ P, p.Prime)
    (hPz : ∀ p ∈ P, (p : ℝ) ≤ z) (hμ : ∀ t ∈ T, 0 ≤ μ t)
    (hg : ∀ p ∈ P, 0 ≤ g p ∧ g p ≤ 1 - η)
    (hshell : ∀ w : ℝ, 1 < w →
      (∑ p ∈ P.filter (fun p : ℕ => w < (p : ℝ) ∧ (p : ℝ) ≤ w^2), g p) ≤ C)
    (hmoment : ∀ S ∈ P.powerset,
      (∑ t ∈ T.filter (fun t => ∀ p ∈ S, bad t p), μ t) =
        X * (∏ p ∈ S, g p) + r (∏ p ∈ S, p)) :
    |(∑ t ∈ T.filter (fun t => ∀ p ∈ P, ¬bad t p), μ t) -
        X * (∏ p ∈ P, (1 - g p))| ≤
      X * (∏ p ∈ P, (1 - g p)) * blockSieveModelErrorConstant C η *
        Real.exp (-(h : ℝ)) + ∑ d ∈ blockSieveModuli P (z^(4 * (h : ℝ) + 2)), |r d| := by
  obtain ⟨J, B, hunion, hdisj, hsub, hband⟩ := exists_dyadic_sieve_blocks_log P hP hPz
  have hlocal : ∀ j ∈ J, (∑ p ∈ B j, g p) ≤ C := by
    intro j hj
    exact dyadic_sieve_block_mass P (B j) g hz j hP (fun p hp => (hg p hp).1) (hsub j)
      (fun p hp => (hband j hj p hp).1) (fun p hp => (hband j hj p hp).2) hshell
  have hm : ∀ S ∈ (J.biUnion B).powerset,
      (∑ t ∈ T.filter (fun t => ∀ p ∈ S, bad t p), μ t) =
        X * (∏ p ∈ S, g p) + r (∏ p ∈ S, p) := by
    simpa only [hunion] using hmoment
  have hsieve := finite_block_sieve_events J B T μ bad g r hz.le hX hC hη hh heven hdisj
    (fun j _ p hp => hP p (hsub j hp))
    (fun j hj p hp => (hband j hj p hp).2) hμ
    (fun j _ p hp => hg p (hsub j hp)) hlocal hm
  simpa only [hunion] using hsieve
end

section
open Finset
theorem block_sieve_correction_expansion {G α : Type*} [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (w : α → ℝ) (h : G → ℕ)
    (hdisj : (J : Set G).PairwiseDisjoint B) :
    blockSieveCorrection J B w h =
      ∑ S ∈ (J.biUnion B).powerset,
        (∑ j ∈ J, blockSieveSubsetCorrectionAt J B h j S) * ∏ p ∈ S, w p := by
  have hid := block_sieve_subset_weighted_expansion J B h (fun S => ∏ p ∈ S, w p)
  rw [← block_sieve_upper_expansion J B w h hdisj,
    ← block_sieve_lower_expansion J B w h hdisj] at hid
  have hc : blockSieveCorrection J B w h =
      ∑ j ∈ J, ∑ S ∈ (J.biUnion B).powerset,
        blockSieveSubsetCorrectionAt J B h j S * ∏ p ∈ S, w p := by
    dsimp only [blockSieveLower] at hid
    linarith
  rw [hc]
  simp_rw [sum_mul]
  exact sum_comm

theorem block_sieve_correction_sum_coefficient_level (J : Finset ℕ) (B : ℕ → Finset ℕ)
    (S : Finset ℕ) (h : ℕ) {z : ℝ} (hz : 1 ≤ z)
    (hdisj : (J : Set ℕ).PairwiseDisjoint B)
    (hprime : ∀ j ∈ J, ∀ p ∈ B j, p.Prime)
    (hsize : ∀ j ∈ J, ∀ p ∈ B j, Real.log (p : ℝ) ≤ Real.log z / (2 : ℝ)^j)
    (hc : (∑ j ∈ J, blockSieveSubsetCorrectionAt J B (fun k => (k + 1) * h) j S) ≠ 0) :
    Squarefree (∏ p ∈ S, p) ∧ (∏ p ∈ S, (p : ℝ)) ≤ z^(4 * (h : ℝ) + 2) := by
  classical
  have hex : ∃ j ∈ J, blockSieveSubsetCorrectionAt J B (fun k => (k + 1) * h) j S ≠ 0 := by
    by_contra hn
    push Not at hn
    exact hc (sum_eq_zero hn)
  obtain ⟨j, _, hj⟩ := hex
  exact block_sieve_correction_coefficient_level J B S h j hz hdisj hprime hsize hj

theorem finite_block_sieve_overcount {Ω : Type*} (J : Finset ℕ) (B : ℕ → Finset ℕ)
    (T : Finset Ω) (μ : Ω → ℝ) (x : Ω → ℕ → ℝ) (g r : ℕ → ℝ)
    {z X C η : ℝ} {h : ℕ} (hz : 1 ≤ z) (hX : 0 ≤ X) (hC : 0 ≤ C)
    (hη : 0 < η) (hh : 1 ≤ h) (heven : Even h)
    (hdisj : (J : Set ℕ).PairwiseDisjoint B)
    (hprime : ∀ j ∈ J, ∀ p ∈ B j, p.Prime)
    (hsize : ∀ j ∈ J, ∀ p ∈ B j, Real.log (p : ℝ) ≤ Real.log z / (2 : ℝ)^j)
    (hμ : ∀ t ∈ T, 0 ≤ μ t)
    (hx : ∀ t ∈ T, ∀ p ∈ J.biUnion B, 0 ≤ x t p ∧ x t p ≤ 1)
    (hg : ∀ j ∈ J, ∀ p ∈ B j, 0 ≤ g p ∧ g p ≤ 1 - η)
    (hsum : ∀ j ∈ J, (∑ p ∈ B j, g p) ≤ C)
    (hmoment : ∀ S ∈ (J.biUnion B).powerset,
      (∑ t ∈ T, μ t * ∏ p ∈ S, x t p) = X * (∏ p ∈ S, g p) + r (∏ p ∈ S, p)) :
    0 ≤ (∑ t ∈ T, μ t * blockSieveUpper J B (x t) (fun j => (j + 1) * h)) -
        (∑ t ∈ T, μ t * ∏ p ∈ J.biUnion B, (1 - x t p)) ∧
      (∑ t ∈ T, μ t * blockSieveUpper J B (x t) (fun j => (j + 1) * h)) -
        (∑ t ∈ T, μ t * ∏ p ∈ J.biUnion B, (1 - x t p)) ≤
        X * (∏ p ∈ J.biUnion B, (1 - g p)) * blockSieveModelErrorConstant C η *
          Real.exp (-(h : ℝ)) +
            ∑ d ∈ blockSieveModuli (J.biUnion B) (z^(4 * (h : ℝ) + 2)), |r d| := by
  classical
  let P := J.biUnion B
  let cap := fun j => (j + 1) * h
  let a := fun S => ∑ j ∈ J, blockSieveSubsetCorrectionAt J B cap j S
  let A := ∏ p ∈ P, (1 - g p)
  let D := z^(4 * (h : ℝ) + 2)
  let R := ∑ d ∈ blockSieveModuli P D, |r d|
  have hP : ∀ p ∈ P, p.Prime := by
    intro p hp
    obtain ⟨j, hj, hp⟩ := mem_biUnion.mp hp
    exact hprime j hj p hp
  have haeq (w : ℕ → ℝ) : subsetPolynomial P a w = blockSieveCorrection J B w cap :=
    (block_sieve_correction_expansion J B w cap hdisj).symm
  have hlevel : ∀ S ∈ P.powerset, a S ≠ 0 → ((∏ p ∈ S, p : ℕ) : ℝ) ≤ D := by
    intro S _ hS
    simpa only [Nat.cast_prod] using
      (block_sieve_correction_sum_coefficient_level J B S h hz hdisj hprime hsize hS).2
  have herr := subset_polynomial_average_error_level P T a r μ x g X D hP
    (fun S _ => abs_block_sieve_subset_correction_sum_le_one J B cap S) hlevel hmoment
  simp_rw [haeq] at herr
  have hmodel := (block_sieve_model_bounds hη hC hh heven J B g hg hsum).2.1
  have hA : (∏ j ∈ J, ∏ p ∈ B j, (1 - g p)) = A := (prod_biUnion hdisj).symm
  rw [hA] at hmodel
  have havg : (∑ t ∈ T, μ t * blockSieveCorrection J B (x t) cap) ≤
      X * A * blockSieveModelErrorConstant C η * Real.exp (-(h : ℝ)) + R := by
    have hm := mul_le_mul_of_nonneg_left hmodel hX
    have he := (abs_le.mp herr).2
    change _ ≤ R at he
    dsimp only [cap] at hm ⊢
    nlinarith
  have hpoint : ∀ t ∈ T,
      0 ≤ blockSieveUpper J B (x t) cap - (∏ p ∈ P, (1 - x t p)) ∧
        blockSieveUpper J B (x t) cap - (∏ p ∈ P, (1 - x t p)) ≤
          blockSieveCorrection J B (x t) cap := by
    intro t ht
    have hd := block_sieve_difference_bound J B (x t) cap
      (fun j hj p hp => hx t ht p (mem_biUnion.mpr ⟨j, hj, hp⟩))
      (fun j _ => heven.mul_left (j + 1))
    simpa only [P, prod_biUnion hdisj] using hd
  have hnonneg : 0 ≤ ∑ t ∈ T, μ t *
      (blockSieveUpper J B (x t) cap - (∏ p ∈ P, (1 - x t p))) :=
    sum_nonneg (fun t ht => mul_nonneg (hμ t ht) (hpoint t ht).1)
  have hupper : (∑ t ∈ T, μ t *
      (blockSieveUpper J B (x t) cap - (∏ p ∈ P, (1 - x t p)))) ≤
        ∑ t ∈ T, μ t * blockSieveCorrection J B (x t) cap :=
    sum_le_sum (fun t ht => mul_le_mul_of_nonneg_left (hpoint t ht).2 (hμ t ht))
  simpa only [mul_sub, sum_sub_distrib] using And.intro hnonneg (hupper.trans havg)

theorem finite_block_sieve_event_overcount {Ω : Type*} (J : Finset ℕ) (B : ℕ → Finset ℕ)
    (T : Finset Ω) (μ : Ω → ℝ) (bad : Ω → ℕ → Prop) [∀ t p, Decidable (bad t p)]
    (g r : ℕ → ℝ) {z X C η : ℝ} {h : ℕ}
    (hz : 1 ≤ z) (hX : 0 ≤ X) (hC : 0 ≤ C) (hη : 0 < η)
    (hh : 1 ≤ h) (heven : Even h)
    (hdisj : (J : Set ℕ).PairwiseDisjoint B)
    (hprime : ∀ j ∈ J, ∀ p ∈ B j, p.Prime)
    (hsize : ∀ j ∈ J, ∀ p ∈ B j, Real.log (p : ℝ) ≤ Real.log z / (2 : ℝ)^j)
    (hμ : ∀ t ∈ T, 0 ≤ μ t)
    (hg : ∀ j ∈ J, ∀ p ∈ B j, 0 ≤ g p ∧ g p ≤ 1 - η)
    (hsum : ∀ j ∈ J, (∑ p ∈ B j, g p) ≤ C)
    (hmoment : ∀ S ∈ (J.biUnion B).powerset,
      (∑ t ∈ T.filter (fun t => ∀ p ∈ S, bad t p), μ t) =
        X * (∏ p ∈ S, g p) + r (∏ p ∈ S, p)) :
    let M := (∑ t ∈ T, μ t * blockSieveUpper J B
      (fun p => if bad t p then 1 else 0) (fun j => (j + 1) * h)) -
        (∑ t ∈ T.filter (fun t => ∀ p ∈ J.biUnion B, ¬bad t p), μ t)
    0 ≤ M ∧ M ≤
      X * (∏ p ∈ J.biUnion B, (1 - g p)) * blockSieveModelErrorConstant C η *
        Real.exp (-(h : ℝ)) +
          ∑ d ∈ blockSieveModuli (J.biUnion B) (z^(4 * (h : ℝ) + 2)), |r d| := by
  classical
  have hresult := finite_block_sieve_overcount J B T μ
    (fun t p => if bad t p then 1 else 0) g r hz hX hC hη hh heven hdisj hprime hsize hμ
    (fun t _ p _ => by by_cases hp : bad t p <;> simp [hp]) hg hsum (by
      intro S hS
      rw [finite_bad_event_weighted_intersection]
      exact hmoment S hS)
  simpa only [finite_bad_event_weighted_avoidance] using hresult
end

