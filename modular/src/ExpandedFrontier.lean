/- The fixed original small plan determines a local big coefficient. The
original Fourier return phase and arbitrary coupled coefficient are retained. -/

open scoped Classical
namespace Bounty
section Coefficient
variable {I : Type} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (groups : Finset (Fin N)) (patterns : Finset I)
  (C : I → Fin N → Finset (Fin J))
  (hC : ∀ i : patterns, ∀ g : ↥groupsᶜ, C i.val g.val = ∅)
  (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
  (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
    PhysicalAuxLabels P (C i) → ℂ) (θ : ℝ)
  (p : PhysicalRootSmallPlan (P := P) (J := J) (ell := ell) (n := n) groups patterns)

noncomputable def physicalRootPlanBigCoefficient (j : Fin (n + 1))
    (Lb Rb : PhysicalMarkLists (fun g : {g // g ∉ groupsᶜ} => P g.val) J ell)
    (ab : PhysicalAuxLabels (fun g : {g // g ∉ groupsᶜ} => P g.val)
      (fun g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val g.val)) : ℂ :=
  let ds := physicalRootSmallPlanSmallData groups patterns C hC p
  let i := (physicalRootSmallPlanPattern groups patterns C hC p j).val
  physicalCoupledBigCoefficient (fun g => g ∈ groupsᶜ) (C i) (ζ (n - j.val) i)
    (physicalLocalFourierCoefficient C k K θ (n - j.val) i)
    (physicalPermuteLabels (ds.2.2.1 j) (ds.2.1 j.castSucc))
    (physicalPermuteLabels (ds.2.2.2 j) (ds.2.1 j.succ)) (ds.1 j) Lb Rb ab

theorem physical_root_plan_big_coefficient
    (db : PhysicalRootSmallPlanBigData groups patterns C hC p) (j : Fin (n + 1)) :
    let d := (physicalGroupSelectedSplit (fun g => g ∈ groupsᶜ)
      (fun j => C (physicalRootSmallPlanPattern groups patterns C hC p j).val)).symm
        (physicalRootSmallPlanSmallData groups patterns C hC p, db)
    let i := (physicalRootSmallPlanPattern groups patterns C hC p j).val
    physicalRootPlanBigCoefficient groups patterns C hC ζ k K θ p j
      (physicalPermuteLabels (db.2.2.1 j) (db.2.1 j.castSucc))
      (physicalPermuteLabels (db.2.2.2 j) (db.2.1 j.succ)) (db.1 j) =
    K (n - j.val) i (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc))
      (physicalPermuteLabels (d.2.2.2 j) (d.2.1 j.succ)) (d.1 j) *
      physicalReturnPhase θ (k (n - j.val) i * (physicalD (C i)
        (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc)) (d.1 j) : ℤ)) *
      physicalPhase (ζ (n - j.val) i) (physicalD (C i)
        (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc)) (d.1 j)) := by
  dsimp only
  exact physical_selected_split_coefficient (fun g => g ∈ groupsᶜ)
    (fun j => C (physicalRootSmallPlanPattern groups patterns C hC p j).val)
    (physicalRootSmallPlanSmallData groups patterns C hC p) db j
    (ζ (n - j.val) (physicalRootSmallPlanPattern groups patterns C hC p j).val)
    (physicalLocalFourierCoefficient C k K θ (n - j.val)
      (physicalRootSmallPlanPattern groups patterns C hC p j).val)

end Coefficient
end Bounty
