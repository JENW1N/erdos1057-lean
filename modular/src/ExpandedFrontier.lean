/- Actual fixed-skeleton full-edge stages pay exactly their original selected-child atom costs. -/

open Finset Classical

namespace Bounty

section Edge
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
    [∀ g, DecidableEq (P g)] {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K))) (u : Fin steps.length) (k : K)
    (htag : steps.get u = some (.inr k))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P))
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))
    [∀ c, Fintype (A k c)]
    (ω : ∀ c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (ρ v vmin : ℝ) (V η : Fin N → ℝ)

theorem full_mixed_common_edge_all_skeletons_stage_le
    (hη : ∀ g, 0 ≤ η g) (hμ : ∀ g p, 0 ≤ μ g p) (hμatom : ∀ g p, μ g p ≤ η g) (hv : 1 < v)
    (hω : ∀ c a, 0 ≤ ω c a) (hωmass : ∀ c, ∑ a, ω c a ≤ 1)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hvmin : 0 < vmin) (hV : ∀ g, vmin ≤ V g)
    (hmass : ∀ g, ∑ p, μ g p ≤ 2) (T : ℕ) (ht : ∀ g, (S k g)ᶜ.card ≤ T) :
    let d := fullMixedCommonSelectedCount M B steps code u
    (∑ sk : FullActiveEdgeSkeleton n (S k) B (A k) (Δ k) (D k) s, ∑ fresh : FullActiveEdgeSamples n (S k) B (A k) (Δ k) (D k) s sk,
      if birthForestStageCondition
        (fullMixedCommonIndexStage M B steps) u.succ
        (fullMixedCommonHistoryWrite n S B A Δ D steps u s
          (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inr k)) htag s
            ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm ⟨sk, fresh⟩)) history) code then
        |fullActiveEdgeEventWeight n (S k) B (A k) (Δ k) (D k) ω μ ρ V s ((fullActiveEdgeSkeletonEquiv n (S k) B (A k) (Δ k) (D k) s).symm ⟨sk, fresh⟩)| * productLengthLyapunov v (fullActiveEdgeEventTarget n (S k) B (A k) (Δ k) (D k) s ((fullActiveEdgeSkeletonEquiv n (S k) B (A k) (Δ k) (D k) s).symm ⟨sk, fresh⟩))
      else 0) ≤
    (∏ g, η g ^ d g) * productLengthLyapunov v s * unrestrictedEdgeRowBound ρ v vmin T ^ N := by
  dsimp only
  refine le_trans (sum_le_sum fun sk _ =>
    full_mixed_common_edge_skeleton_stage_le n S B A Δ D steps u k htag s history code sk ω μ ρ v V η hη hμ hμatom (zero_lt_one.trans hv).le) ?_
  have h := full_active_edge_marked_length_row_le n (S k) B (A k) (Δ k) (D k) ω
    ρ v vmin V (fun g => ∑ p, μ g p) η hω hωmass hρ0 hρ1 hv hvmin hV
    (fun g => sum_nonneg fun p _ => hμ g p) hmass hη T ht
    (fullMixedCommonSelectedCount M B steps code u) s
  simp only [Fintype.card_fin] at h
  refine le_trans (le_of_eq ?_) h
  apply sum_congr rfl
  intro sk _
  split_ifs <;> rfl

end Edge
