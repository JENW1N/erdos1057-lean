section

/- Selected physical rows recover the original physical residue schedule.
The literal tensor row retains its cumulative ledger and both total caps. -/

open Finset
open scoped Classical
namespace Bounty

section ResiduePath
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (ζ : ∀ p : PhysicalPrime P, ZMod p.2.val)
  (hmarks : ∀ j : Fin (n + 1), ∀ p ∈ physicalMarkedPrimes (L j),
    ζ p = -(a j : ZMod p.2.val))
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ) (η : Fin N → Fin (n + 1) → ℝ)
  (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0) (B : ℕ)

variable
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)

theorem physical_selected_original_edge_block (j : Fin n)
    (F : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) (hs : s.1 = L j.castSucc) :
    physicalSelectedEdgeBlock C k ω β retention ρ V hV j (aux j) (σ j) (τ j) (L j.succ) F s =
      (((Fintype.card (PhysicalPermutations (Fin N) J ell) : ℝ)⁻¹ : ℂ) ^ 2) *
        (ω j (productActiveMemorySplit (fun g => physicalFullSharedIndices (C j g)) B
          (physicalFullMemoryState (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) s.2.2)).1
          (aux j) : ℂ) *
      globalBirthJointCutRawRow
        (physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β η V
          (fun _ => ρ) hV B (2 * j.val + 1)) B B F (physicalMarkRawReadout s) := by
  rw [physical_selected_edge_block_eq, hs, if_pos (hlist j)]
  rw [physical_joint_residue_edge_literal_tensor]

theorem physical_selected_original_visit (j : Fin (n + 1))
    (F : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) :
    physicalObservedMarkRow C k ω β retention ρ V hV (some (.inl j))
      (fun o t => if o = .inr none ∧ t.1 = (L j) then F (physicalMarkRawReadout t) else 0)
      (L j, s.2) =
      globalBirthJointCutRawRow
        (physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β
          (fun _ i => 1 - retention i) V (fun _ => ρ) hV B (2 * j.val))
        B B F (physicalMarkRawReadout s) := by
  have hv := physical_observed_selected_visit C k ω β retention ρ V hV j F (L j, s.2)
  have hr := physical_joint_residue_visit_literal_tensor C aux k L a σ τ hstep ζ hmarks hlist
    hP hdis hk β (fun _ i => 1 - retention i) V ρ hV B j
    (fun g => physicalGroupPhaseActivity (L j) g) F (physicalMarkRawReadout s)
  convert hv.trans hr.symm using 1
  congr 1
  funext o t
  split_ifs <;> rfl

theorem physical_selected_original_state_edge_block (j : Fin n)
    (F : PhysicalBoundedMarkState P J ell B → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) (hs : s.1 = L j.castSucc) :
    physicalSelectedStateEdgeBlock C k ω β retention ρ V hV j (aux j) (σ j) (τ j) (L j.succ) F s =
      (((Fintype.card (PhysicalPermutations (Fin N) J ell) : ℝ)⁻¹ : ℂ) ^ 2) *
        (ω j (productActiveMemorySplit (fun g => physicalFullSharedIndices (C j g)) B
          (physicalFullMemoryState (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) s.2.2)).1
          (aux j) : ℂ) *
      globalBirthJointCutRawRow
        (physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β η V
          (fun _ => ρ) hV B (2 * j.val + 1)) B B
        (physicalMarkRawExtension F (L j.succ)) (physicalMarkRawReadout s) := by
  rw [physical_selected_state_edge_block_readout]
  exact physical_selected_original_edge_block C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk
    β η V ρ hV B ω retention j (physicalMarkRawExtension F (L j.succ)) s hs

theorem physical_selected_original_state_visit (j : Fin (n + 1))
    (F : PhysicalBoundedMarkState P J ell B → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) :
    physicalObservedMarkRow C k ω β retention ρ V hV (some (.inl j))
      (fun o t => if o = .inr none ∧ t.1 = L j then F t else 0) (L j, s.2) =
      globalBirthJointCutRawRow
        (physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β
          (fun _ i => 1 - retention i) V (fun _ => ρ) hV B (2 * j.val))
        B B (physicalMarkRawExtension F (L j)) (physicalMarkRawReadout s) := by
  have hv := physical_observed_selected_state_visit C k ω β retention ρ V hV j F (L j, s.2)
  have hr := physical_joint_residue_visit_literal_tensor C aux k L a σ τ hstep ζ hmarks hlist
    hP hdis hk β (fun _ i => 1 - retention i) V ρ hV B j
    (fun g => physicalGroupPhaseActivity (L j) g)
    (physicalMarkRawExtension F (L j)) (physicalMarkRawReadout s)
  convert hv.trans hr.symm using 1
  congr 1
  funext o t
  split_ifs <;> rfl

end ResiduePath
end Bounty
end

section

/- An actual rough pair box avoiding the nonallowed shifted divisibility classes. -/

open Finset

namespace Bounty

noncomputable def maskedPairRoughFlag (W : ℝ) (p : ℕ) : Bool := by
  classical
  exact decide ((p : ℝ) ≤ W)

def maskedPairBannedFlag (A : Finset ℕ) (p : ℕ) : Bool := decide (p ∉ A)

noncomputable def maskedPairBox (a b c d m : ℕ) (W z : ℝ) (A : Finset ℕ) : Finset (ℕ × ℕ) := by
  classical
  exact (pairSieveBaseBox a b c d m).filter (fun v =>
    (∀ p ∈ primeBand 0 W, ¬p ∣ v.1*v.2) ∧
    (∀ p ∈ primeBand 0 z, ¬p ∣ m → p ∉ A → (v.1*v.2) % p ≠ 1 % p))

theorem masked_pair_box_subset (a b c d m : ℕ) (W z : ℝ)
    (hW : 0 ≤ W) (hWz : W ≤ z) (A : Finset ℕ) :
    maskedPairBox a b c d m W z A ⊆
      pairSieveAvoidance a b c d m (maskedPairPrimes m z)
        (maskedPairRoughFlag W) (maskedPairBannedFlag A) := by
  classical
  have hz := hW.trans hWz
  intro v hv
  obtain ⟨hvbase, hvrough, hvban⟩ := mem_filter.mp hv
  apply mem_filter.mpr
  refine ⟨hvbase, ?_⟩
  intro p hp hbad
  obtain ⟨hprime, hpz, _, hpm⟩ := (mem_masked_pair_primes hz).mp hp
  rcases hbad with ⟨hr, hzero⟩ | ⟨hb, hone⟩
  · have hpW : (p : ℝ) ≤ W := by simpa [maskedPairRoughFlag] using hr
    exact hvrough p ((mem_primeBand_iff le_rfl hW p).mpr
      ⟨hprime, Nat.cast_pos.mpr hprime.pos, hpW⟩) (Nat.dvd_of_mod_eq_zero hzero)
  · have hpA : p ∉ A := by simpa [maskedPairBannedFlag] using hb
    exact hvban p ((mem_primeBand_iff le_rfl hz p).mpr
      ⟨hprime, Nat.cast_pos.mpr hprime.pos, hpz⟩) hpm hpA hone

theorem exists_masked_pair_box_upper :
    ∃ K : ℝ, 0 < K ∧ ∀ (L : ℝ) (a b c d m : ℕ) [NeZero m]
      (W z : ℝ) (A : Finset ℕ),
      1 ≤ L → (m : ℝ) ≤ Real.exp L →
      (∀ p ∈ m.primeFactors, L^2 ≤ (p : ℝ)) →
      a ≤ b → c ≤ d → 0 ≤ W → W ≤ z → 1 < z →
      (∀ p ∈ A, 2 ≤ p) →
      ((maskedPairBox a b c d m W z A).card : ℝ) ≤
        K * (((b : ℝ)-a)*((d : ℝ)-c)/(m : ℝ)) *
          (∏ p ∈ primeBand 0 W, (1 - 1/(p : ℝ)))^2 *
          (∏ p ∈ primeBand 0 z, (1 - 1/(p : ℝ))) *
          (∏ p ∈ A, (1 - 1/(p : ℝ))⁻¹) +
        ((m : ℝ)*(z^(10 : ℝ))^3 + (((b : ℝ)-a)+((d : ℝ)-c))*(z^(10 : ℝ))^2) := by
  classical
  obtain ⟨K, hK, hb⟩ := exists_finite_pair_sieve_product_upper
  refine ⟨K*(8*Real.exp 12), by positivity, ?_⟩
  intro L a b c d m hm W z A hL hmL hmin hab hcd hW hWz hz hA
  have hprop := fun (p : ℕ) (hp : p ∈ maskedPairPrimes m z) =>
    (mem_masked_pair_primes (zero_lt_one.trans hz).le).mp hp
  have hprime : ∀ p ∈ maskedPairPrimes m z, p.Prime := fun p hp => (hprop p hp).1
  have h3 : ∀ p ∈ maskedPairPrimes m z, 3 ≤ p := by
    intro p hp
    have h2 := (hprime p hp).two_le
    have hn := (hprop p hp).2.2.1
    omega
  have h := hb a b c d m (maskedPairPrimes m z) (maskedPairRoughFlag W) (maskedPairBannedFlag A)
    hab hcd hz hprime h3 (fun p hp => (hprop p hp).2.2.2) (fun p hp => (hprop p hp).2.1)
  have hrf : (maskedPairPrimes m z).filter (fun p => maskedPairRoughFlag W p = true) =
      maskedPairRoughPrimes m W z := by ext p; simp [maskedPairRoughPrimes, maskedPairRoughFlag]
  have hbf : (maskedPairPrimes m z).filter (fun p => maskedPairBannedFlag A p = true) =
      maskedPairBannedPrimes m z A := by ext p; simp [maskedPairBannedPrimes, maskedPairBannedFlag]
  rw [hrf, hbf] at h
  have hcard : ((maskedPairBox a b c d m W z A).card : ℝ) ≤
      ((pairSieveAvoidance a b c d m (maskedPairPrimes m z)
        (maskedPairRoughFlag W) (maskedPairBannedFlag A)).card : ℝ) :=
    Nat.cast_le.mpr (card_le_card (masked_pair_box_subset a b c d m W z hW hWz A))
  have hX : 0 ≤ (b : ℝ)-a := sub_nonneg.mpr (Nat.cast_le.mpr hab)
  have hY : 0 ≤ (d : ℝ)-c := sub_nonneg.mpr (Nat.cast_le.mpr hcd)
  have hc : 0 ≤ K * (((b : ℝ)-a)*((d : ℝ)-c)/(m : ℝ)) := by positivity
  have he := mul_le_mul_of_nonneg_left
    (masked_pair_euler_uniform_bound hL m (NeZero.ne m) hmL hmin W z hW hWz A hA) hc
  apply (hcard.trans h).trans
  apply add_le_add _ le_rfl
  convert he using 1 <;> ring

end Bounty
end

section

/- The actual local projected norm bound for the raw physical row minus
the alternating prime-comparison rows. The only analytic input is the
proved disjoint-prime-pool comparison, with its original hypotheses. -/

open Finset Filter
open scoped Classical

namespace Bounty

noncomputable def repeatedBigPrimeDifferenceKernel
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (Q : ℕ) (h : ℝ)
    (kept : Finset (RepeatedBigFlatIndex G J ell) → Finset ℤ) (ζ Θ : ℝ) :
    RepeatedBigLists P J ell → RepeatedBigLists P J ell → ℂ :=
  let slots := fun g => (probes g).map (Function.Embedding.inl (β := Fin ell))
  repeatedBigPrimeRawRow P V ζ Θ -
    ∑ A ∈ cleanNonemptySubsets (r.sigma slots), ∑ B ∈ cleanNonemptySubsets (t.sigma slots),
      (-1 : ℂ) ^ (A.card + B.card) • repeatedBigPrimeComparisonRow P V A B Q h kept kept ζ Θ

theorem repeated_big_prime_difference_pairing
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (Q : ℕ) (h : ℝ)
    (kept : Finset (RepeatedBigFlatIndex G J ell) → Finset ℤ) (ζ Θ : ℝ)
    (f g : RepeatedBigLists P J ell → ℂ) :
    cleanKernelPairing (repeatedBigActiveMass V (fun _ _ => 1))
      (repeatedBigPrimeDifferenceKernel P V probes r t Q h kept ζ Θ) f g =
      let slots := fun a => (probes a).map (Function.Embedding.inl (β := Fin ell))
      cleanKernelPairing (repeatedBigActiveMass V (fun _ _ => 1))
          (repeatedBigPrimeRawRow P V ζ Θ) f g -
        ∑ A ∈ cleanNonemptySubsets (r.sigma slots), ∑ B ∈ cleanNonemptySubsets (t.sigma slots),
          (-1 : ℂ) ^ (A.card + B.card) *
            cleanKernelPairing (repeatedBigActiveMass V (fun _ _ => 1))
              (repeatedBigPrimeComparisonRow P V A B Q h kept kept ζ Θ) f g := by
  simp only [repeatedBigPrimeDifferenceKernel, clean_kernel_pairing_sub_kernel,
    clean_kernel_pairing_sum_kernel, clean_kernel_pairing_smul_kernel]

theorem eventually_repeated_big_prime_projected_norm_le
    (hZ : PrimitiveZeroFreeHalfPlane) (c s z a v D ε : ℝ) (m : ℕ)
    (hc : 0 < c) (hs : 0 ≤ s) (hz : 0 ≤ z) (ha : 0 ≤ a)
    (hv : 0 < v) (hD : 0 ≤ D) (hε : 0 < ε) (hm : 0 < m) :
    let κ := a * Real.log (primeFiberFactorBound v m)
    let s' := s + ε
    let A₀ := D + 2 * (s' + 1)
    let q := 2 * κ + (s' + 1) + 2 * A₀ + 3
    let w := 4 * q + max z q + A₀ + 2
    let x := (s' + w + 2) + 2 * A₀ + 2
    ∀ᶠ L : ℝ in atTop,
    let Q := ⌊L ^ q⌋₊
    let h := L ^ (-w)
    let ξ := L ^ (-x)
    ∀ {G : Type} [Fintype G] [DecidableEq G] (J ell : ℕ),
    ∀ (P : G → Finset ℕ) (V : G → ℝ),
    Pairwise (fun g h => Disjoint (P g) (P h)) →
    (∀ g p, p ∈ P g → p.Prime ∧ Q < p) →
    (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) →
    (∀ g, v ≤ V g) →
    (∀ g p, p ∈ P g → Real.log p ≤ L ^ s) →
    (Fintype.card G : ℝ) ≤ a * Real.log L →
    (∀ g, ∃ a b : ℝ, P g = primeBand a b ∧ Real.exp (L ^ c) ≤ a ∧ 0 ≤ b) →
    ∀ probes : G → Finset (Fin J), (∀ g, (probes g).card = m) →
    ∀ r t : Finset G, Disjoint r t →
    ∀ ζ Θ : ℝ, |ζ| ≤ L ^ z →
    ∀ u : RepeatedBigLists P J ell → ℂ, u ∈ repeatedBigSymmetricSubspace →
    let slots := fun g => (probes g).map (Function.Embedding.inl (β := Fin ell))
    let kept := fun U : Finset (RepeatedBigFlatIndex G J ell) => primeProductRetainedCells
      (fun i : U => P i.1.1) (fun i => V i.1.1) h ξ
    cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
      (repeatedBigSymmetrizeLinear (fun source => ∑ target,
        repeatedBigPrimeDifferenceKernel P V probes r t Q h kept ζ Θ source target * u target)) ≤
      (Real.sqrt (((ell : ℝ) ^ ell / (m : ℝ) ^ ell) ^ r.card) +
        Real.sqrt (((ell : ℝ) ^ ell / (m : ℝ) ^ ell) ^ t.card) +
        (3 : ℝ) ^ ((r.sigma slots).card + (t.sigma slots).card) * L ^ (-D)) *
        cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) u := by
  intro κ s' A₀ q w x
  filter_upwards [eventually_repeated_big_prime_disjoint_pool_comparison
    hZ c s z a v D ε m hc hs hz ha hv hD hε hm, eventually_gt_atTop (0 : ℝ)] with L hcomp hL
  intro Q h ξ G _ _ J ell P V hdisj hP hmass hV hlog hcard hband
    probes hp r t hrt ζ Θ hζ u hu slots kept
  apply repeated_big_kernel_norm_le_of_bilinear V (fun j => (hv.trans_le (hV j)).le)
    (repeatedBigPrimeDifferenceKernel P V probes r t Q h kept ζ Θ) (by positivity) _ u hu
  intro f g hf hg
  rw [repeated_big_prime_difference_pairing]
  exact hcomp J ell P V hdisj hP hmass hV hlog hcard hband probes hp r t hrt ζ Θ hζ f g hf hg

end Bounty
end

