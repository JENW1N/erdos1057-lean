section

/- The same discarded-part estimate for ordinary divisor sums with rough support. -/

open Finset Filter Real

namespace Bounty

theorem rough_supported_divisor_test_eq (W : ℝ) (n : ℕ) (F : ℕ → ℂ)
    (hF : ∀ m ∈ n.divisors, ¬(∀ p ∈ m.primeFactors, W ≤ (p : ℝ)) → F m = 0) :
    (∑ m ∈ n.divisors, F m) = ∑ m ∈ roughDivisors W n, F m := by
  classical
  symm
  apply sum_subset (filter_subset _ _)
  intro m hm hnot
  apply hF m hm
  intro hrough
  exact hnot (mem_filter.mpr ⟨hm,hrough⟩)

theorem eventually_candidate_large_P_supported_divisor_tests {c q κ : ℝ} (hc : 0 < c)
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hκ : 0 < κ) (r jStar : ℕ) (A D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ F : ℕ → ℕ → ℂ,
      (∀ u ∈ arithmeticProductWindow 1 (exp L), ∀ m ∈ (2*u+1).divisors, ‖F u m‖ ≤ L^A) →
      (∀ u ∈ arithmeticProductWindow 1 (exp L), ∀ m ∈ (2*u+1).divisors,
        ¬(∀ p ∈ m.primeFactors, exp (sqrt L) ≤ (p : ℝ)) → F u m = 0) →
      ‖∑ u ∈ (arithmeticProductWindow 1 (exp L)).filter
          (fun u => exp (κ*L) < (primePoolPart
            ((candidatePIndices c L).biUnion (candidatePBand (c*L))) u : ℝ)),
        (candidateCoefficient c L q r jStar u : ℂ) *
          ∑ m ∈ (2*u+1).divisors, F u m‖ ≤ exp L*L^(-D) := by
  filter_upwards [eventually_candidate_large_P_bounded_rough_tests hc hq0 hq1 hκ r jStar A D]
    with L hL
  intro F hbound hsupp
  have he : (∑ u ∈ (arithmeticProductWindow 1 (exp L)).filter
      (fun u => exp (κ*L) < (primePoolPart
        ((candidatePIndices c L).biUnion (candidatePBand (c*L))) u : ℝ)),
      (candidateCoefficient c L q r jStar u : ℂ)*∑ m ∈ (2*u+1).divisors, F u m) =
      ∑ u ∈ (arithmeticProductWindow 1 (exp L)).filter
      (fun u => exp (κ*L) < (primePoolPart
        ((candidatePIndices c L).biUnion (candidatePBand (c*L))) u : ℝ)),
      (candidateCoefficient c L q r jStar u : ℂ)*
        ∑ m ∈ roughDivisors (exp (sqrt L)) (2*u+1), F u m := by
    apply sum_congr rfl
    intro u hu
    rw [rough_supported_divisor_test_eq _ _ _ (hsupp u (mem_filter.mp hu).1)]
  rw [he]
  exact hL F (fun u hu m hm => hbound u hu m (mem_filter.mp hm).1)

end Bounty
end

section

/- The explicit high-rank cutoff also preserves the low-rank power saving. -/

open Finset Classical Filter

namespace Bounty

theorem eventually_birthForest_low_rank_power_saving
    {a c C E G Cv Ca M Ch : ℝ}
    (ha : 0 < a) (hc : 0 < c) (hC : 0 ≤ C) (hE : 0 ≤ E)
    (hM : 0 ≤ M) (hD : 0 ≤ G + Ca + M) (hgain : E + Cv + 1 ≤ G) :
    ∀ᶠ L : ℝ in atTop, ∀ N m : ℕ, L ^ a ≤ (N : ℝ) →
      ∀ b H : ℝ, L ^ c ≤ b → (m : ℝ) ≤ L ^ M → 0 ≤ H → H ≤ L ^ Ch →
        ∀ F : BirthForestCode m → ℂ,
          let r := Nat.ceil (((2 * C + E + 1) * N * Real.log L) / b)
          (∀ code, birthForestRank code < r →
            ‖F code‖ ≤ H * L ^ ((-G + Cv) * N + Cv +
              2 * birthForestRank code * (G + Ca))) →
          ‖∑ code ∈ (univ : Finset (BirthForestCode m)).filter
              (fun code => birthForestRank code < r),
            (-1 : ℂ) ^ birthForestRank code * F code‖ ≤ L ^ (-(E * N)) := by
  let D := G + Ca + M
  let ε := 1 / (4 * (D + 1))
  have hD0 : 0 ≤ D := hD
  have hε : 0 < ε := by dsimp [ε]; positivity
  have hK : 0 ≤ 2 * C + E + 1 := by positivity
  have hratio : 2 * ε * D ≤ 1 / 2 := by
    have heq : 4 * (D + 1) * ε = 1 := by
      dsimp [ε]
      field_simp
    nlinarith
  filter_upwards [eventually_ge_atTop (2 : ℝ),
    (tendsto_rpow_atTop ha).eventually_ge_atTop (2 * (Cv + Ch + M + 1)),
    eventually_forest_rank_cutoff_small ha hc hε hK] with L hL hfixed hsmall
  intro N m hN b H hb hm hH hHb F
  dsimp only
  intro hF
  have hL0 : 0 < L := by linarith
  have hNr : (0 : ℝ) < N := (Real.rpow_pos_of_pos hL0 a).trans_le hN
  have hrr := (div_le_iff₀ hNr).mp (hsmall N hN b hb)
  apply birthForest_low_rank_power_saving F _ N
    (G := G) (Cv := Cv) (Ca := Ca) (M := M) (Ch := Ch) (E := E)
    hL hH hM hD hm hHb
  · linarith
  · have hrD := mul_le_mul_of_nonneg_right hrr hD0
    have hNratio := mul_le_mul_of_nonneg_right hratio hNr.le
    dsimp only [D] at hrD hNratio
    nlinarith
  · exact hgain
  · exact hF

end Bounty
end

section

/- Signed full-edge actions preserve pending-memory symmetry when their
coefficients respect the actual event reindexing. Active endpoints, auxiliary
choices, storage/promotion slots and fresh labels satisfy this condition. -/

open Finset Classical

namespace Bounty

abbrev EdgeDrawObservation (P : Type*) (t : ℕ) :=
  Σ _stores : Finset (Fin t), Σ promotions : Finset (Fin t), UnrestrictedFreshLabels P promotions

section
variable {G : Type*} [Fintype G] [dG : DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : SharedActiveLabels P S → Type*) [∀ c, Fintype (A c)]
  (Δ D : ∀ c, A c → G → ℤ)
  (ω : ∀ c, A c → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  {R : Type*} (σ : ∀ c, A c → R ≃ R)

theorem full_active_external_signed_symmetric
    (Ψ : ∀ x, R → FullActiveEdgeEvent n S B A Δ D x → ℂ)
    (hΨ : ∀ (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
      (τ : ∀ g, Equiv.Perm (Fin (x g).2.1.val)) (r : R)
      (e : FullActiveEdgeEvent n S B A Δ D x),
      Ψ (productMemoryReindex x τ) r (fullEdgeMemoryReindex n S B A Δ D x τ e) = Ψ x r e)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → R → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun x => f x r)) :
    ∀ r, ProductMemorySymmetric (fun x =>
      fullActiveExternalCoefficientAction n S B A Δ D ω μ ρ V σ Ψ f x r) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  intro r x g τ
  dsimp only
  refine (congrArg (fun z => fullActiveExternalCoefficientAction n S B A Δ D ω μ ρ V σ Ψ f z r)
    (product_memory_reindex_at x g τ)).symm.trans ?_
  unfold fullActiveExternalCoefficientAction
  rw [← (fullEdgeMemoryReindex n S B A Δ D x
    (Function.update (fun h => Equiv.refl (Fin (x h).2.1.val)) g τ)).sum_comp]
  apply sum_congr rfl
  intro e _
  rw [full_edge_reindex_weight, hΨ]
  congr 1
  exact full_edge_reindex_test n S B A Δ D x _ e
    (fun y => f y (σ (productActiveMemorySplit S B x).1 e.1 r)) (hf _)

noncomputable def fullActiveObservablePhase
    (Φ : ∀ c, A c → R → (∀ g, Fin (M g) → P g) → (∀ g, Fin (M g) → P g) →
      (∀ g, EdgeDrawObservation (P g) (S g)ᶜ.card) → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (r : R) (e : FullActiveEdgeEvent n S B A Δ D x) : ℂ :=
  Φ (productActiveMemorySplit S B x).1 e.1 r (fun g => (x g).1)
    (fun g => (fullActiveEdgeEventTarget n S B A Δ D x e g).1)
    (fun g => ⟨(e.2 g).1, (e.2 g).2.1, (e.2 g).2.2.2⟩)

omit [Fintype G] dG [∀ c, Fintype (A c)] in
theorem full_active_observable_phase_reindex
    (Φ : ∀ c, A c → R → (∀ g, Fin (M g) → P g) → (∀ g, Fin (M g) → P g) →
      (∀ g, EdgeDrawObservation (P g) (S g)ᶜ.card) → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (τ : ∀ g, Equiv.Perm (Fin (x g).2.1.val)) (r : R)
    (e : FullActiveEdgeEvent n S B A Δ D x) :
    fullActiveObservablePhase n S B A Δ D Φ (productMemoryReindex x τ) r
      (fullEdgeMemoryReindex n S B A Δ D x τ e) =
    fullActiveObservablePhase n S B A Δ D Φ x r e := by
  exact congrArg (fun target => Φ (productActiveMemorySplit S B x).1 e.1 r
    (fun g => (x g).1) target (fun g => ⟨(e.2 g).1, (e.2 g).2.1, (e.2 g).2.2.2⟩))
    (funext (full_edge_reindex_active n S B A Δ D x τ e))

theorem full_active_external_observable_symmetric
    (Φ : ∀ c, A c → R → (∀ g, Fin (M g) → P g) → (∀ g, Fin (M g) → P g) →
      (∀ g, EdgeDrawObservation (P g) (S g)ᶜ.card) → ℂ)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → R → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun x => f x r)) :
    ∀ r, ProductMemorySymmetric (fun x => fullActiveExternalCoefficientAction n S B A Δ D
      ω μ ρ V σ (fullActiveObservablePhase n S B A Δ D Φ) f x r) :=
  full_active_external_signed_symmetric n S B A Δ D ω μ ρ V σ _
    (full_active_observable_phase_reindex n S B A Δ D Φ) f hf

end
end Bounty
end

section

/- The candidate's remaining logarithmic inventory is bounded by a geometric band sum. -/

open Finset Real

namespace Bounty

theorem candidate_band_suffix_scale_sum_le {c L : ℝ} (hcL : 0 ≤ c*L) (b : ℕ) :
    (∑ j ∈ (candidateQIndices c L).filter (fun j => b ≤ j), c*L/2^j) ≤ 2*(c*L/2^b) := by
  let J := ⌊log (c*L/(20*log L))/log 2⌋₊
  have hsubset : (candidateQIndices c L).filter (fun j => b ≤ j) ⊆ Ico b (J+1) := by
    intro j hj
    obtain ⟨hjQ,hbj⟩ := mem_filter.mp hj
    exact mem_Ico.mpr ⟨hbj,Nat.lt_succ_of_le (mem_Icc.mp hjQ).2⟩
  have he (j : ℕ) : c*L/(2 : ℝ)^j = (c*L)*(1/2 : ℝ)^j := by
    rw [div_pow, one_pow]
    ring
  calc
    _ ≤ ∑ j ∈ Ico b (J+1), c*L/2^j :=
      sum_le_sum_of_subset_of_nonneg hsubset (fun j _ _ => div_nonneg hcL (by positivity))
    _ = (c*L)*∑ j ∈ Ico b (J+1), (1/2 : ℝ)^j := by simp_rw [he]; rw [mul_sum]
    _ ≤ (c*L)*((1/2 : ℝ)^b/(1-1/2)) := mul_le_mul_of_nonneg_left
      (geom_sum_Ico_le_of_lt_one (by norm_num : (0 : ℝ) ≤ 1/2) (by norm_num)) hcL
    _ = 2*(c*L/2^b) := by rw [he b]; ring

theorem candidate_allocation_band_monotone {c L : ℝ} {r : ℕ}
    {i j : Fin ((candidateQIndices c L).card*r)} (hij : i ≤ j) :
    (candidateAllocationOrder c L r i).1.val ≤ (candidateAllocationOrder c L r j).1.val := by
  by_contra h
  have hh := candidate_allocation_band_strict (Nat.lt_of_not_ge h)
  exact (not_lt_of_ge hij) hh

theorem candidate_allocation_suffix_scales {c L : ℝ} (hcL : 0 ≤ c*L) (r b : ℕ) :
    (∑ i : Fin ((candidateQIndices c L).card*r),
      if b ≤ (candidateAllocationOrder c L r i).1.val
      then c*L/2^(candidateAllocationOrder c L r i).1.val else 0) ≤
        2*(r : ℝ)*(c*L/2^b) := by
  classical
  calc
    _ = ∑ slot : (candidateQIndices c L) × Fin r,
        if b ≤ slot.1.val then c*L/2^slot.1.val else 0 :=
      Fintype.sum_equiv (candidateAllocationOrder c L r) _ _ (fun _ => rfl)
    _ = (r : ℝ)*∑ j : candidateQIndices c L, if b ≤ j.val then c*L/2^j.val else 0 := by
      rw [Fintype.sum_prod_type]
      simp only [sum_const, card_univ, Fintype.card_fin, nsmul_eq_mul]
      rw [mul_sum]
    _ = (r : ℝ)*∑ j ∈ (candidateQIndices c L).filter (fun j => b ≤ j), c*L/2^j := by
      rw [sum_filter]
      congr 1
      exact sum_coe_sort (candidateQIndices c L) (fun j => if b ≤ j then c*L/2^j else 0)
    _ ≤ (r : ℝ)*(2*(c*L/2^b)) :=
      mul_le_mul_of_nonneg_left (candidate_band_suffix_scale_sum_le hcL b) (Nat.cast_nonneg r)
    _ = _ := by ring

theorem candidate_allocation_suffix_inventory_le {c L : ℝ} (hcL : 0 ≤ c*L)
    (r jStar : ℕ) (x : ∀ slot, candidateQSlotChoices c L r jStar slot)
    (i : Fin ((candidateQIndices c L).card*r)) :
    allocationSuffixInventory (fun k => log (candidateAllocationValue c L r jStar x k))
      (candidateAllocationActive c L r jStar) i ≤
        (12/5 : ℝ)*(r : ℝ)*(c*L/2^(candidateAllocationOrder c L r i).1.val) := by
  let b := (candidateAllocationOrder c L r i).1.val
  calc
    _ ≤ (6/5 : ℝ)*(∑ k : Fin ((candidateQIndices c L).card*r),
        if b ≤ (candidateAllocationOrder c L r k).1.val
        then c*L/2^(candidateAllocationOrder c L r k).1.val else 0) := by
      unfold allocationSuffixInventory
      rw [mul_sum]
      apply sum_le_sum
      intro k hk
      by_cases h : i ≤ k ∧ candidateAllocationActive c L r jStar k = true
      · rw [if_pos h, if_pos (candidate_allocation_band_monotone h.1)]
        have hv := (candidate_Q_slot_log_bounds c L r jStar (candidateAllocationOrder c L r k)
          (x _).property).2
        simpa only [candidateAllocationValue, mul_div_assoc] using hv
      · rw [if_neg h]
        positivity
    _ ≤ (6/5 : ℝ)*(2*(r : ℝ)*(c*L/2^b)) :=
      mul_le_mul_of_nonneg_left (candidate_allocation_suffix_scales hcL r b) (by norm_num)
    _ = _ := by dsimp [b]; ring

end Bounty
end

section

open MeasureTheory

namespace Bounty

theorem typeII_pulled_fourier_moment_polynomial {A : ℝ} (hA : 0 ≤ A) (M : ℕ) :
    ∃ (d : ℕ) (C : ℝ), 0 ≤ C ∧ ∀ p : Fin 4 → ℝ,
      (∫ ξ : EuclideanSpace ℝ (Fin 3), ‖ξ‖ ^ M *
        ‖typeIIPulledFourier A (p 0) (p 1) (p 2) (p 3) ξ‖) ≤ C * (1 + ‖p‖) ^ d := by
  obtain ⟨R, hR, hs⟩ := typeII_pulled_support_radius A
  exact fourier_moment_polynomial_of_fixed_support
    (fun p : Fin 4 → ℝ => typeIIPulledSchwartz A (p 0) (p 1) (p 2) (p 3))
    (fun p => 1 + ‖p‖) (fun p => by linarith [norm_nonneg p]) R hR hs
    (typeII_pulled_derivative_polynomial_bound hA) M

theorem typeII_pulled_fourier_l1_polynomial {A : ℝ} (hA : 0 ≤ A) :
    ∃ (d : ℕ) (C : ℝ), 0 ≤ C ∧ ∀ p : Fin 4 → ℝ,
      (∫ ξ : EuclideanSpace ℝ (Fin 3),
        ‖typeIIPulledFourier A (p 0) (p 1) (p 2) (p 3) ξ‖) ≤ C * (1 + ‖p‖) ^ d := by
  simpa only [pow_zero, one_mul] using typeII_pulled_fourier_moment_polynomial hA 0

theorem typeII_pulled_fourier_tail_polynomial {A : ℝ} (hA : 0 ≤ A) (M : ℕ) :
    ∃ (d : ℕ) (C : ℝ), 0 < C ∧ ∀ (p : Fin 4 → ℝ) (R : ℝ), 0 < R →
      (∫ ξ in {ξ : EuclideanSpace ℝ (Fin 3) | R < ‖ξ‖},
        ‖typeIIPulledFourier A (p 0) (p 1) (p 2) (p 3) ξ‖) ≤
          C * (1 + ‖p‖) ^ d * R ^ (-(M : ℝ)) := by
  obtain ⟨d, C, hC, hb⟩ := typeII_pulled_fourier_moment_polynomial hA M
  refine ⟨d, C + 1, by linarith, ?_⟩
  intro p R hR
  calc
    _ ≤ (∫ ξ : EuclideanSpace ℝ (Fin 3), ‖ξ‖^M *
        ‖typeIIPulledFourier A (p 0) (p 1) (p 2) (p 3) ξ‖) / R^M :=
      euclidean_schwartz_norm_tail_le_moment _ M hR
    _ ≤ (C * (1 + ‖p‖)^d) / R^M := div_le_div_of_nonneg_right (hb p) (pow_nonneg hR.le M)
    _ ≤ ((C + 1) * (1 + ‖p‖)^d) / R^M :=
      div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right (by linarith) (by positivity))
        (pow_nonneg hR.le M)
    _ = _ := by rw [Real.rpow_neg hR.le, Real.rpow_natCast, div_eq_mul_inv]

noncomputable def typeIIPulledFourierIntegrand (A q a b c : ℝ)
    (t ξ : EuclideanSpace ℝ (Fin 3)) : ℂ :=
  Complex.exp (((2 * Real.pi * inner ℝ ξ t : ℝ) : ℂ) * Complex.I) *
    typeIIPulledFourier A q a b c ξ

theorem typeII_pulled_fourier_integrand_norm (A q a b c : ℝ)
    (t ξ : EuclideanSpace ℝ (Fin 3)) :
    ‖typeIIPulledFourierIntegrand A q a b c t ξ‖ = ‖typeIIPulledFourier A q a b c ξ‖ := by
  rw [typeIIPulledFourierIntegrand, norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]

theorem typeII_pulled_fourier_integrand_integrable (A q a b c : ℝ)
    (t : EuclideanSpace ℝ (Fin 3)) :
    Integrable (typeIIPulledFourierIntegrand A q a b c t) := by
  have hc : Continuous (typeIIPulledFourierIntegrand A q a b c t) := by
    unfold typeIIPulledFourierIntegrand
    apply Continuous.mul
    · fun_prop
    · exact (typeIIPulledFourier A q a b c).continuous
  apply (typeII_pulled_fourier_integrable A q a b c).norm.mono' hc.aestronglyMeasurable
  exact Filter.Eventually.of_forall (fun ξ => (typeII_pulled_fourier_integrand_norm A q a b c t ξ).le)

theorem typeII_pulled_fourier_truncation_le_tail (A q a b c R : ℝ)
    (t : EuclideanSpace ℝ (Fin 3)) :
    ‖(typeIIPulledCutoff A q a b c t : ℂ) -
        ∫ ξ in {ξ : EuclideanSpace ℝ (Fin 3) | ‖ξ‖ ≤ R},
          typeIIPulledFourierIntegrand A q a b c t ξ‖ ≤
      ∫ ξ in {ξ : EuclideanSpace ℝ (Fin 3) | R < ‖ξ‖},
        ‖typeIIPulledFourier A q a b c ξ‖ := by
  have hs : MeasurableSet {ξ : EuclideanSpace ℝ (Fin 3) | ‖ξ‖ ≤ R} :=
    (isClosed_le continuous_norm continuous_const).measurableSet
  have heq : {ξ : EuclideanSpace ℝ (Fin 3) | ‖ξ‖ ≤ R}ᶜ =
      {ξ : EuclideanSpace ℝ (Fin 3) | R < ‖ξ‖} := by ext ξ; simp
  rw [typeII_pulled_fourier_inversion]
  change ‖(∫ ξ : EuclideanSpace ℝ (Fin 3), typeIIPulledFourierIntegrand A q a b c t ξ) - _‖ ≤ _
  rw [← setIntegral_compl hs (typeII_pulled_fourier_integrand_integrable A q a b c t), heq]
  apply (norm_integral_le_integral_norm _).trans
  exact le_of_eq (integral_congr_ae (Filter.Eventually.of_forall (fun ξ =>
    typeII_pulled_fourier_integrand_norm A q a b c t ξ)))

theorem typeII_pulled_fourier_truncation_polynomial {A : ℝ} (hA : 0 ≤ A) (M : ℕ) :
    ∃ (d : ℕ) (C : ℝ), 0 < C ∧ ∀ (p : Fin 4 → ℝ) (R : ℝ), 0 < R →
      ∀ t : EuclideanSpace ℝ (Fin 3),
        ‖(typeIIPulledCutoff A (p 0) (p 1) (p 2) (p 3) t : ℂ) -
            ∫ ξ in {ξ : EuclideanSpace ℝ (Fin 3) | ‖ξ‖ ≤ R},
              typeIIPulledFourierIntegrand A (p 0) (p 1) (p 2) (p 3) t ξ‖ ≤
          C * (1 + ‖p‖) ^ d * R ^ (-(M : ℝ)) := by
  obtain ⟨d, C, hC, hb⟩ := typeII_pulled_fourier_tail_polynomial hA M
  exact ⟨d, C, hC, fun p R hR t =>
    (typeII_pulled_fourier_truncation_le_tail A (p 0) (p 1) (p 2) (p 3) R t).trans (hb p R hR)⟩

end Bounty
end

section

/- Full absolute factorization mass with the original candidate coefficient. -/

open Finset Filter Real

namespace Bounty

theorem exists_candidate_divisor_test_absolute_bound {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1) (A : ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ L : ℝ in atTop, ∀ (jStar : ℕ) (F : ℕ → ℕ → ℂ),
      (∀ u ∈ arithmeticProductWindow 1 (exp L), ∀ m ∈ (2*u+1).divisors, ‖F u m‖ ≤ L^A) →
      (∑ u ∈ arithmeticProductWindow 1 (exp L), candidateCoefficient c L q r jStar u *
        ∑ m ∈ (2*u+1).divisors, ‖F u m‖) ≤ exp L * L^C := by
  obtain ⟨K,hK,hcoef⟩ := exists_candidate_coefficient_divisor_bound hc hr hq0 hq1
  refine ⟨K+|A|+16, by positivity, ?_⟩
  filter_upwards [hcoef, eventually_arithmetic_window_divisor_cross_mass,
    eventually_ge_atTop (1 : ℝ)] with L hcoeff hmass hL
  intro jStar F hF
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hsum : (∑ u ∈ arithmeticProductWindow 1 (exp L), candidateCoefficient c L q r jStar u *
      ∑ m ∈ (2*u+1).divisors, ‖F u m‖) ≤
      L^(K+|A|) * ∑ u ∈ arithmeticProductWindow 1 (exp L),
        (u.divisors.card : ℝ) * ((2*u+1).divisors.card : ℝ) := by
    rw [mul_sum]
    apply sum_le_sum
    intro u hu
    have hu0 : u ≠ 0 := by
      have hh := ((mem_arithmeticProductWindow_iff one_ne_zero (exp L)).mp hu).1
      intro heq
      simp only [heq, mul_zero, Nat.cast_zero] at hh
      exact (exp_pos L).not_gt hh
    let P := (candidatePIndices c L).biUnion (candidatePBand (c*L))
    have hdiv : primePoolFreePart P u ∣ u :=
      ⟨primePoolPart P u, by simpa only [Nat.mul_comm] using (primePoolPart_mul_primePoolFreePart P u).symm⟩
    have hcard : ((primePoolFreePart P u).divisors.card : ℝ) ≤ (u.divisors.card : ℝ) := by
      exact_mod_cast card_le_card (Nat.divisors_subset_of_dvd hu0 hdiv)
    have hcU : candidateCoefficient c L q r jStar u ≤ L^K*(u.divisors.card : ℝ) :=
      (hcoeff jStar u).2.trans (mul_le_mul_of_nonneg_left hcard (rpow_nonneg hL0.le _))
    have hinner : (∑ m ∈ (2*u+1).divisors, ‖F u m‖) ≤
        ((2*u+1).divisors.card : ℝ)*L^|A| := by
      calc
        _ ≤ ∑ _m ∈ (2*u+1).divisors, L^|A| := sum_le_sum (fun m hm =>
          (hF u hu m hm).trans (rpow_le_rpow_of_exponent_le hL (le_abs_self A)))
        _ = _ := by simp
    calc
      _ ≤ (L^K*(u.divisors.card : ℝ))*(((2*u+1).divisors.card : ℝ)*L^|A|) :=
        mul_le_mul hcU hinner (sum_nonneg (fun _ _ => norm_nonneg _)) (by positivity)
      _ = _ := by rw [rpow_add hL0]; ring
  calc
    _ ≤ L^(K+|A|) * ∑ u ∈ arithmeticProductWindow 1 (exp L),
        (u.divisors.card : ℝ) * ((2*u+1).divisors.card : ℝ) := hsum
    _ ≤ L^(K+|A|) * (exp L*L^(16 : ℝ)) :=
      mul_le_mul_of_nonneg_left hmass (rpow_nonneg hL0.le _)
    _ = exp L*L^(K+|A|+16) := by rw [rpow_add hL0 (K+|A|) 16]; ring

theorem exists_candidate_factorization_absolute_bound {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1) (A : ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ L : ℝ in atTop, ∀ (jStar : ℕ) (α β : ℕ → ℂ),
      (∀ m, ‖α m‖ ≤ L^A) → (∀ n, ‖β n‖ ≤ L^A) →
      (∑ u ∈ arithmeticProductWindow 1 (exp L), candidateCoefficient c L q r jStar u *
        ∑ m ∈ (2*u+1).divisors, ‖α m‖ * ‖β ((2*u+1)/m)‖) ≤ exp L * L^C := by
  obtain ⟨C,hC,h⟩ := exists_candidate_divisor_test_absolute_bound hc hr hq0 hq1 (2*A)
  refine ⟨C,hC,?_⟩
  filter_upwards [h, eventually_gt_atTop (0 : ℝ)] with L hL hL0
  intro jStar α β hα hβ
  have htest := hL jStar (fun u m => α m * β ((2*u+1)/m)) (by
    intro u hu m hm
    rw [norm_mul, show 2*A = A+A by ring, rpow_add hL0]
    exact mul_le_mul (hα m) (hβ _) (norm_nonneg _) (rpow_nonneg hL0.le _))
  simpa only [norm_mul] using htest

end Bounty
end

section

/- The full retained coefficient has a uniform polynomial-divisor bound. -/

open Finset Filter

namespace Bounty

theorem exists_candidate_retained_divisor_bound {c q : ℝ}
    (hc : 0 < c) (hq0 : 0 ≤ q) (hq1 : q < 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ L : ℝ in atTop, ∀ (r jStar : ℕ)
      (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
      (take : Fin ((candidateQIndices c L).card * r) → Bool)
      (_hkeep : take ((candidateAllocationOrder c L r).symm
        (candidateRoughSlot c L r jStar hr hj)) = false)
      (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ),
      (∀ slot p, p ∈ candidateQSlotChoices c L r jStar slot → ‖twist slot p‖ ≤ 1) →
      ∀ h : ℕ, h ≠ 0 →
        ‖candidateRetainedComplexCoefficient c L q r jStar take twist h‖ ≤
          L ^ C * (h.divisors.card : ℝ) := by
  obtain ⟨C, hC, hW⟩ := exists_candidate_marked_weight_rpow_bound hc hq0 hq1
  refine ⟨C, hC, ?_⟩
  filter_upwards [hW, eventually_ge_atTop (0 : ℝ)] with L hW hL
  intro r jStar hr hj take hkeep twist htwist h hh
  let P := (candidatePIndices c L).biUnion (candidatePBand (c * L))
  have hres := norm_candidate_remaining_coefficient_le_divisors
    (mul_nonneg hc.le hL) hr hj take hkeep twist htwist (primePoolFreePart P h)
      (primePoolFreePart_ne_zero P hh)
  have hsub : (primePoolFreePart P h).divisors ⊆ h.divisors :=
    Nat.divisors_subset_of_dvd hh (Nat.div_dvd_of_dvd (primePoolPart_dvd P h))
  have hcard : ((primePoolFreePart P h).divisors.card : ℝ) ≤ h.divisors.card := by
    exact_mod_cast card_le_card hsub
  unfold candidateRetainedComplexCoefficient
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hW (h : ℤ)).1]
  exact mul_le_mul (hW (h : ℤ)).2 (hres.trans hcard) (norm_nonneg _)
    (Real.rpow_nonneg hL _)

end Bounty

end

section

/- Arbitrary logarithmic saving for divisor mass in the two boundary layers. -/

open Finset Filter Real

namespace Bounty

theorem eventually_boundary_scale (B : ℝ) (hB : 1 ≤ B) :
    ∀ᶠ L : ℝ in atTop,
      1 ≤ L ∧ L^(-B) ≤ 1/2 ∧ 1 ≤ exp L * L^(-B) := by
  filter_upwards [eventually_rpow_le_exp_sqrt B, eventually_ge_atTop (2 : ℝ)]
    with L hpow hL
  have hL0 : 0 < L := by linarith
  have hL1 : 1 ≤ L := by linarith
  have hsqrt : sqrt L ≤ L := sqrt_le_iff.mpr ⟨hL0.le, by nlinarith⟩
  have he : L^B ≤ exp L := hpow.trans (exp_le_exp.mpr hsqrt)
  refine ⟨hL1, ?_, ?_⟩
  · calc
      L^(-B) ≤ L^(-1 : ℝ) := rpow_le_rpow_of_exponent_le hL1 (by linarith)
      _ = 1/L := by rw [rpow_neg_one, one_div]
      _ ≤ 1/2 := (div_le_div_iff₀ hL0 (by norm_num)).mpr (by linarith)
  · have hh := mul_le_mul_of_nonneg_right he (rpow_nonneg hL0.le (-B))
    rwa [← rpow_add hL0, add_neg_cancel, rpow_zero] at hh

theorem eventually_typeII_boundary_divisor_mass (B D : ℝ)
    (hB : 1 ≤ B) (hBD : 2*D+17 ≤ B) :
    ∀ᶠ L : ℝ in atTop,
      (∑ u ∈ typeIIBoundaryWindow (exp L) (L^(-B)),
        (u.divisors.card : ℝ) * ((2*u+1).divisors.card : ℝ)) ≤ exp L * L^(-D) := by
  filter_upwards [eventually_boundary_scale B hB,
    eventually_ge_atTop (6 : ℝ), eventually_ge_atTop (35*(2+log 35)^15 : ℝ)]
    with L hscale hL6 hK
  have hL0 : 0 < L := by linarith [hscale.1]
  have hE : 1 ≤ exp L := one_le_exp hL0.le
  have hδ : 0 ≤ L^(-B) := rpow_nonneg hL0.le _
  let S := typeIIBoundaryWindow (exp L) (L^(-B))
  let N : ℕ := ⌊35*exp L⌋₊
  have hN0 : 0 < N := Nat.floor_pos.mpr (by linarith)
  have hNpos : (0 : ℝ) < N := by exact_mod_cast hN0
  have hNle : (N : ℝ) ≤ 35*exp L := Nat.floor_le (by positivity)
  have hlog : 1+log N ≤ (2+log 35)*L := by
    have hh := log_le_log hNpos hNle
    rw [log_mul (by norm_num : (35 : ℝ) ≠ 0) (exp_ne_zero L), log_exp] at hh
    have h35 : 0 ≤ log 35 := log_nonneg (by norm_num)
    nlinarith [hscale.1]
  have hmoment : (N : ℝ)*(1+log N)^15 ≤ exp L*L^(16 : ℝ) := by
    calc
      _ ≤ (35*exp L)*((2+log 35)*L)^15 :=
        mul_le_mul hNle (pow_le_pow_left₀ (by positivity) hlog 15)
          (by positivity) (by positivity)
      _ = (35*(2+log 35)^15)*exp L*L^15 := by rw [mul_pow]; ring
      _ ≤ L*exp L*L^15 := mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right hK (exp_pos _).le) (pow_nonneg hL0.le _)
      _ = exp L*L^(16 : ℝ) := by norm_num only [rpow_ofNat]; ring
  have hcard : (S.card : ℝ) ≤ exp L * L^(-B+1) := by
    have hc := typeII_boundary_window_card_le hE hδ hscale.2.1
    calc
      _ ≤ 4*L^(-B)*exp L+2 := hc
      _ ≤ 6*(exp L*L^(-B)) := by nlinarith [hscale.2.2]
      _ ≤ L*(exp L*L^(-B)) := mul_le_mul_of_nonneg_right hL6 (by positivity)
      _ = exp L*L^(-B+1) := by rw [rpow_add hL0, rpow_one]; ring
  have hmass := shifted_divisor_subset_concentration S N (by
    intro u hu
    have huhi := (mem_typeII_boundary_window_bounds hE hδ hscale.2.1 hu).2
    apply Nat.le_floor
    push_cast
    linarith)
  apply hmass.trans
  rw [← sqrt_mul (Nat.cast_nonneg S.card)]
  apply (sqrt_le_iff).mpr
  refine ⟨by positivity, ?_⟩
  calc
    (S.card : ℝ)*((N : ℝ)*(1+log N)^15) ≤
        (exp L*L^(-B+1))*(exp L*L^(16 : ℝ)) :=
      mul_le_mul hcard hmoment (by positivity) (by positivity)
    _ = (exp L)^2 * L^(17-B) := by
      rw [show 17-B = (-B+1)+16 by ring, rpow_add hL0 (-B+1) 16]; ring
    _ ≤ (exp L)^2 * L^(-D+-D) := mul_le_mul_of_nonneg_left
      (rpow_le_rpow_of_exponent_le hscale.1 (by linarith)) (sq_nonneg _)
    _ = (exp L*L^(-D))^2 := by rw [rpow_add hL0]; ring

end Bounty
end

section

/- Divisible endpoint energy persists after a shift divisible by the same divisor. -/

open Finset

namespace Bounty

theorem invariant_triple_endpoint_shifted_divisible_energy
    (Q : Finset ℕ) (α β γ : ℕ → ℂ)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (S : Finset ℤ) (δ : ℤ) (d N : ℕ) (hd : d ∈ Nat.factoredNumbers Q)
    (hδ : (d : ℤ) ∣ δ) (hdiv : ∀ n ∈ S, (d : ℤ) ∣ n)
    (hS : ∀ n ∈ S, 0 ≤ n + δ ∧ n + δ ≤ (N : ℤ)) :
    (∑ n ∈ S, ‖invariantTripleEndpoint Q α β γ (n + δ).natAbs‖ ^ 2) ≤
      (A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15 / d := by
  classical
  have h := invariant_triple_endpoint_int_divisible_energy Q α β γ hA hB hC hα hβ hγ
    (S.image (fun n => n + δ)) d N hd
    (by
      intro m hm
      obtain ⟨n, hn, rfl⟩ := mem_image.mp hm
      exact Int.natCast_dvd.mp (dvd_add (hdiv n hn) hδ))
    (by
      intro m hm
      obtain ⟨n, hn, rfl⟩ := mem_image.mp hm
      exact hS n hn)
  rw [sum_image] at h
  · exact h
  · intro a _ b _ hab
    exact add_right_cancel hab

end Bounty
end

section

/- The source modulation and shifted edge phase reproduce one Mellin character. -/

namespace Bounty

noncomputable def physicalMellinSource (X Z v : ℝ) (f : ℤ → ℂ) (n : ℤ) : ℂ :=
  ((X / (n : ℝ) : ℝ) : ℂ) * physicalMellinPhase (-v) ((n : ℝ) / Z) * f n

theorem physical_bare_pattern_phase_shift {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (ζ v : ℝ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (L R : PhysicalMarkLists P J ell) :
    physicalBarePatternScalar V C (ζ - v) K aux L R =
      physicalBarePatternScalar V C ζ K aux L R * physicalPhase (-v) (physicalD C L aux) := by
  classical
  unfold physicalBarePatternScalar
  split_ifs
  · rw [sub_eq_add_neg, physical_phase_add]
    ring
  · exact (zero_mul _).symm

theorem physical_mellin_source_edge {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (ζ v X Z : ℝ) (hZ : Z ≠ 0)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (L R : PhysicalMarkLists P J ell)
    (hD : physicalD C L aux ≠ 0) (f : ℤ → ℂ) (n : ℤ) (hn : n ≠ 0) :
    (starRingEnd ℂ) (physicalMellinSource X Z v f n) *
        physicalBarePatternScalar V C (ζ - v) K aux L R =
      (X : ℂ) * physicalMellinPhase v ((n : ℝ) / (Z * physicalD C L aux)) *
        ((n : ℂ)⁻¹ * (starRingEnd ℂ) (f n) *
          physicalBarePatternScalar V C ζ K aux L R) := by
  have hn' : (n : ℝ) ≠ 0 := by exact_mod_cast hn
  simp only [physicalMellinSource, map_mul, Complex.conj_ofReal,
    physical_mellin_phase_conj, neg_neg, physical_bare_pattern_phase_shift]
  calc
    _ = (X : ℂ) *
        (physicalMellinPhase v ((n : ℝ) / Z) * physicalPhase (-v) (physicalD C L aux)) *
        ((n : ℂ)⁻¹ * (starRingEnd ℂ) (f n) * physicalBarePatternScalar V C ζ K aux L R) := by
      push_cast
      ring
    _ = _ := by rw [physical_mellin_phase_ratio v (n : ℝ) Z _ hn' hZ hD]

theorem physical_mellin_source_zero (X Z v : ℝ) (f : ℤ → ℂ) (n : ℤ) (hf : f n = 0) :
    physicalMellinSource X Z v f n = 0 := by
  simp only [physicalMellinSource, hf, mul_zero]

end Bounty
end

section

/- Finite-sum interchange for an explicitly normalized logarithmic Fourier representation. -/

open Finset MeasureTheory

namespace Bounty

theorem finite_mellin_sum_integrable {A : Type*} (s : Finset A)
    (ρ : ℝ → ℂ) (ν : ℝ → ℝ) (hρ : Integrable ρ) (hν : Continuous ν)
    (c : A → ℂ) (t : A → ℝ) :
    Integrable (fun v => ρ v * ∑ a ∈ s, c a * physicalMellinPhase (ν v) (t a)) := by
  simp_rw [mul_sum]
  apply integrable_finsetSum
  intro a _
  apply ((physical_mellin_phase_integrable ρ ν hρ hν (t a)).mul_const (c a)).congr
  exact Filter.Eventually.of_forall (fun v => by ring)

theorem finite_mellin_sum_representation {A : Type*} (s : Finset A)
    (ρ : ℝ → ℂ) (ν : ℝ → ℝ) (hρ : Integrable ρ) (hν : Continuous ν)
    (c : A → ℂ) (t : A → ℝ) (Ψ : ℝ → ℂ)
    (hΨ : ∀ a ∈ s, c a ≠ 0 → Ψ (t a) = ∫ v : ℝ, ρ v * physicalMellinPhase (ν v) (t a)) :
    (∑ a ∈ s, c a * Ψ (t a)) =
      ∫ v : ℝ, ρ v * ∑ a ∈ s, c a * physicalMellinPhase (ν v) (t a) := by
  have hi : ∀ a ∈ s, Integrable (fun v => ρ v * (c a * physicalMellinPhase (ν v) (t a))) := by
    intro a _
    apply ((physical_mellin_phase_integrable ρ ν hρ hν (t a)).mul_const (c a)).congr
    exact Filter.Eventually.of_forall (fun v => by ring)
  simp_rw [mul_sum]
  rw [integral_finsetSum s hi]
  apply sum_congr rfl
  intro a ha
  by_cases hc : c a = 0
  · simp only [hc, zero_mul, mul_zero, integral_zero]
  rw [hΨ a ha hc, ← integral_const_mul]
  apply integral_congr_ae
  exact Filter.Eventually.of_forall (fun v => by ring)

end Bounty
end

section

/- Finite indexing of the literal physical edge sum, including every original guard. -/

open Finset

namespace Bounty

abbrev PhysicalMellinAtom {G I : Type*} [Fintype G]
    (P : G → Finset ℕ) (J ell : ℕ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (positions : Finset ℤ) :=
  Σ _x : physicalCutoff P J ell positions,
  Σ _y : physicalCutoff P J ell positions,
  Σ i : patterns, PhysicalAuxLabels P (C i.val)

noncomputable def physicalMellinAtomCoefficient
    {G I : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (patterns : Finset I) (C : I → G → Finset (Fin J))
    (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (positions : Finset ℤ) (f g : ℤ → ℂ)
    (a : PhysicalMellinAtom P J ell patterns C positions) : ℂ := by
  classical
  let x := a.1.val
  let y := a.2.1.val
  let i := a.2.2.1.val
  let aux := a.2.2.2
  exact if y.1 = x.1 + k i * (physicalD (C i) x.2.val aux : ℕ) then
    (x.1 : ℂ)⁻¹ * (starRingEnd ℂ) (f x.1) *
    physicalBarePatternScalar V (C i) (ζ i) (K i) aux x.2.val y.2.val * g y.1 *
    ((physicalVertexWeight x.2.val q x.1 * physicalVertexWeight y.2.val q y.1 : ℝ) : ℂ)
  else 0

noncomputable def physicalMellinAtomArgument
    {G I : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    {patterns : Finset I} {C : I → G → Finset (Fin J)} {positions : Finset ℤ}
    (Z : ℝ) (a : PhysicalMellinAtom P J ell patterns C positions) : ℝ :=
  (a.1.val.1 : ℝ) / (Z * physicalD (C a.2.2.1.val) a.1.val.2.val a.2.2.2)

theorem physical_mellin_atom_sum
    {G I : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (patterns : Finset I) (C : I → G → Finset (Fin J)) (positions : Finset ℤ)
    (F : PhysicalState P J ell → PhysicalState P J ell → ∀ i, PhysicalAuxLabels P (C i) → ℂ) :
    (∑ a : PhysicalMellinAtom P J ell patterns C positions,
      F a.1.val a.2.1.val a.2.2.1.val a.2.2.2) =
    ∑ x ∈ physicalCutoff P J ell positions, ∑ y ∈ physicalCutoff P J ell positions,
      ∑ i ∈ patterns, ∑ aux : PhysicalAuxLabels P (C i), F x y i aux := by
  classical
  simp only [Fintype.sum_sigma]
  rw [sum_coe_sort (physicalCutoff P J ell positions)
    (fun x => ∑ y : physicalCutoff P J ell positions, ∑ i : patterns,
      ∑ aux : PhysicalAuxLabels P (C i.val), F x y.val i.val aux)]
  apply sum_congr rfl
  intro x _
  rw [sum_coe_sort (physicalCutoff P J ell positions)
    (fun y => ∑ i : patterns, ∑ aux : PhysicalAuxLabels P (C i.val), F x y i.val aux)]
  apply sum_congr rfl
  intro y _
  exact sum_coe_sort patterns (fun i => ∑ aux : PhysicalAuxLabels P (C i), F x y i aux)

theorem physical_mellin_atom_coefficient_zero
    {G I : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (patterns : Finset I) (C : I → G → Finset (Fin J))
    (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (positions : Finset ℤ) (f g : ℤ → ℂ)
    (a : PhysicalMellinAtom P J ell patterns C positions) (hf : f a.1.val.1 = 0) :
    physicalMellinAtomCoefficient V patterns C q ζ k K positions f g a = 0 := by
  classical
  simp only [physicalMellinAtomCoefficient, hf, map_zero, mul_zero, zero_mul, ite_self]

theorem physical_mellin_atom_argument_pos
    {G I : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    {patterns : Finset I} {C : I → G → Finset (Fin J)} {positions : Finset ℤ}
    {Z : ℝ} (hZ : 0 < Z) (hP : ∀ g p, p ∈ P g → 0 < p)
    (a : PhysicalMellinAtom P J ell patterns C positions) (hn : 0 < a.1.val.1) :
    0 < physicalMellinAtomArgument Z a := by
  unfold physicalMellinAtomArgument
  have hD := physical_D_pos (C a.2.2.1.val) a.1.val.2.val a.2.2.2 hP
  exact div_pos (by exact_mod_cast hn) (mul_pos hZ (by exact_mod_cast hD))

end Bounty
end

section

/- Exact signed path sums retain arbitrary whole-path phases under parameter transport. -/

open Finset
open scoped Classical
namespace Bounty
section Action
variable {J K G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] {M : G → ℕ}
  (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
  (Δ Δ' D D' : ∀ k c, A k c → G → ℤ)
  (hΔ : ∀ k, Δ k = Δ' k)
  (hD : ∀ k c a g p, ((n g p : ℤ) ∣ D k c a g ↔ (n g p : ℤ) ∣ D' k c a g))
  (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)

theorem full_permutation_parameter_path_action (steps : List (Option (J ⊕ K)))
    (phase : ∀ x, FullPermutationMixedPath n S B A Δ D steps x → ℂ)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ) :
    fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps phase f =
      fullPermutationMixedPathAction n S B A Δ' D' ω μ q ρ V steps
        (fun x p => phase x ((fullPermutationParameterPathEquiv n S B A Δ Δ' D D' hΔ hD steps x).symm p)) f := by
  let _ : ∀ (tag : Option (J ⊕ K)) x, Fintype (FullPermutationMixedEvent n S B A Δ D tag x) :=
    fullPermutationMixedEventFintype n S B A Δ D
  let _ : ∀ (tag : Option (J ⊕ K)) x, Fintype (FullPermutationMixedEvent n S B A Δ' D' tag x) :=
    fullPermutationMixedEventFintype n S B A Δ' D'
  funext x
  let _ := finiteEventPathFintype (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) steps x
  let _ := finiteEventPathFintype (FullPermutationMixedEvent n S B A Δ' D')
    (fullPermutationMixedEventTarget n S B A Δ' D') steps x
  unfold fullPermutationMixedPathAction finiteEventPathAction
  rw [← (fullPermutationParameterPathEquiv n S B A Δ Δ' D D' hΔ hD steps x).sum_comp]
  apply sum_congr rfl
  intro p _
  rw [full_permutation_parameter_path_weight, full_permutation_parameter_path_terminal]
  simp only [Equiv.symm_apply_apply]

end Action
end Bounty
end

section

/- A nonnegative coefficient deficit supported on a discarded set costs one tail. -/

open Finset

namespace Bounty

theorem norm_weighted_fiber_deficit_le (T : Finset ℕ) (fibers : ℕ → Finset ℕ)
    (bad : ℕ → Prop) [DecidablePred bad] (a d : ℕ → ℝ) (F : ℕ → ℕ → ℂ) (M : ℝ)
    (hM : 0 ≤ M) (hd : ∀ u ∈ T, 0 ≤ d u) (hda : ∀ u ∈ T, d u ≤ a u)
    (heq : ∀ u ∈ T, ¬bad u → d u = a u)
    (hF : ∀ u ∈ T, ∀ m ∈ fibers u, ‖F u m‖ ≤ M) :
    ‖(∑ u ∈ T, (a u : ℂ)*∑ m ∈ fibers u, F u m) -
        ∑ u ∈ T, (d u : ℂ)*∑ m ∈ fibers u, F u m‖ ≤
      M*(∑ u ∈ T.filter bad, a u*((fibers u).card : ℝ)) := by
  have hs : (∑ u ∈ T, (a u : ℂ)*∑ m ∈ fibers u, F u m) -
      (∑ u ∈ T, (d u : ℂ)*∑ m ∈ fibers u, F u m) =
      ∑ u ∈ T.filter bad, ((a u-d u : ℝ) : ℂ)*∑ m ∈ fibers u, F u m := by
    rw [← sum_sub_distrib, sum_filter]
    apply sum_congr rfl
    intro u hu
    by_cases hb : bad u
    · simp only [hb, if_true, Complex.ofReal_sub]
      ring
    · simp only [hb, if_false, heq u hu hb, sub_self]
  rw [hs]
  apply (norm_weighted_finite_fibers_le (T.filter bad) fibers (fun u => a u-d u) F M
    (fun u hu => sub_nonneg.mpr (hda u (mem_filter.mp hu).1))
    (fun u hu => hF u (mem_filter.mp hu).1)).trans
  apply mul_le_mul_of_nonneg_left _ hM
  apply sum_le_sum
  intro u hu
  exact mul_le_mul_of_nonneg_right (sub_le_self _ (hd u (mem_filter.mp hu).1)) (Nat.cast_nonneg _)

end Bounty
end

section

/- Actual polynomial derivative bounds in the inverse smoothing width. -/

namespace Bounty

theorem typeII_window_schwartz_tsupport_subset (r : ℝ) :
    tsupport (typeIIWindowLogSchwartz r) ⊆ tsupport typeIIWindowLogLocalizer := by
  apply (tsupport_comp_subset (g := fun x : ℝ => (x : ℂ)) (by simp)
    (typeIIWindowLogCutoff r)).trans
  exact tsupport_mul_subset_left.trans tsupport_mul_subset_left

theorem typeII_window_support_radius :
    ∃ R : ℝ, 0 ≤ R ∧ ∀ r : ℝ, tsupport (typeIIWindowLogSchwartz r) ⊆ Metric.closedBall 0 R := by
  obtain ⟨R, hR⟩ := typeII_window_log_localizer_hasCompactSupport.isCompact.isBounded.subset_closedBall 0
  refine ⟨max R 0, le_max_right _ _, ?_⟩
  intro r
  exact (typeII_window_schwartz_tsupport_subset r).trans
    (hR.trans (Metric.closedBall_subset_closedBall (le_max_left _ _)))

theorem typeII_window_derivative_polynomial_bound (n : ℕ) :
    ∃ (d : ℕ) (C : ℝ), 0 ≤ C ∧ ∀ r s : ℝ,
      ‖iteratedFDeriv ℝ n (typeIIWindowLogSchwartz r) s‖ ≤ C * (1 + |r|) ^ d := by
  have hG : Function.HasTemperateGrowth (fun y : ℝ × ℝ => (typeIIWindowLogJoint y : ℂ)) :=
    Complex.ofRealCLM.hasTemperateGrowth.comp typeII_window_log_joint_hasTemperateGrowth
  obtain ⟨d, C, hC, hb⟩ := hG.norm_iteratedFDeriv_le_uniform n
  obtain ⟨R, hR0, hR⟩ := typeII_window_support_radius
  refine ⟨d, C * (1 + R) ^ d, mul_nonneg hC (pow_nonneg (by linarith) _), ?_⟩
  intro r s
  by_cases hs : s ∈ Metric.closedBall 0 R
  · have hfun : (fun s : ℝ => (typeIIWindowLogJoint (r, s) : ℂ)) =
        (typeIIWindowLogSchwartz r : ℝ → ℂ) := by
      funext y
      change (typeIIWindowLogJoint (r, y) : ℂ) = (typeIIWindowLogCutoff r y : ℂ)
      rw [typeII_window_log_joint_eq]
    have hslice := norm_iteratedFDeriv_slice_le hG.1 r s n
    rw [hfun] at hslice
    have hsR : ‖s‖ ≤ R := mem_closedBall_zero_iff.mp hs
    have hbase : 1 + ‖(r, s)‖ ≤ (1 + R) * (1 + |r|) := by
      rw [Prod.norm_def, Real.norm_eq_abs]
      have hm : max |r| ‖s‖ ≤ |r| + R := max_le (by linarith) (by linarith [abs_nonneg r])
      nlinarith [abs_nonneg r]
    calc
      _ ≤ C * (1 + ‖(r, s)‖) ^ d := hslice.trans (hb n le_rfl (r, s))
      _ ≤ C * ((1 + R) * (1 + |r|)) ^ d :=
        mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by positivity) hbase d) hC
      _ = _ := by rw [mul_pow]; ring
  · have hz : iteratedFDeriv ℝ n (typeIIWindowLogSchwartz r) s = 0 := by
      apply Function.notMem_support.mp
      intro ht
      exact hs (hR r (support_iteratedFDeriv_subset n ht))
    rw [hz, norm_zero]
    positivity

end Bounty
end

section

/- Exact Mellin separation of the actual smooth product window. -/

open MeasureTheory

namespace Bounty

theorem typeII_window_mellin_phase {e h x : ℝ} (he : 0 < e) (hh : 0 < h) (hx : 0 < x) (ξ : ℝ) :
    Complex.exp (((2 * Real.pi * ξ * Real.log (e * h / x) : ℝ) : ℂ) * Complex.I) =
      (x : ℂ) ^ (-((2 * Real.pi * ξ : ℝ) : ℂ) * Complex.I) *
        (e : ℂ) ^ (((2 * Real.pi * ξ : ℝ) : ℂ) * Complex.I) *
          (h : ℂ) ^ (((2 * Real.pi * ξ : ℝ) : ℂ) * Complex.I) := by
  rw [Complex.cpow_def_of_ne_zero (Complex.ofReal_ne_zero.mpr hx.ne'),
    Complex.cpow_def_of_ne_zero (Complex.ofReal_ne_zero.mpr he.ne'),
    Complex.cpow_def_of_ne_zero (Complex.ofReal_ne_zero.mpr hh.ne'),
    ← Complex.ofReal_log hx.le, ← Complex.ofReal_log he.le, ← Complex.ofReal_log hh.le,
    ← Complex.exp_add, ← Complex.exp_add, Real.log_div (mul_ne_zero he.ne' hh.ne') hx.ne',
    Real.log_mul he.ne' hh.ne']
  congr 1
  push_cast
  ring

theorem typeII_window_smooth_mellin_inversion {δ e h x : ℝ}
    (hδ : 0 < δ) (he : 0 < e) (hh : 0 < h) (hx : 0 < x) :
    (typeIIWindowSmooth δ (e * h / x) : ℂ) =
      ∫ ξ : ℝ, ((x : ℂ) ^ (-((2 * Real.pi * ξ : ℝ) : ℂ) * Complex.I) *
        (e : ℂ) ^ (((2 * Real.pi * ξ : ℝ) : ℂ) * Complex.I) *
          (h : ℂ) ^ (((2 * Real.pi * ξ : ℝ) : ℂ) * Complex.I)) * typeIIWindowFourier δ⁻¹ ξ := by
  have hpos : 0 < e * h / x := div_pos (mul_pos he hh) hx
  have heq := typeII_window_log_cutoff_eq_smooth hδ (Real.log (e * h / x))
  rw [Real.exp_log hpos] at heq
  rw [← heq, typeII_window_fourier_inversion]
  apply integral_congr_ae
  filter_upwards [] with ξ
  rw [typeII_window_mellin_phase he hh hx ξ]

end Bounty
end

section

/- Absolute candidate mass on a finite box containing the sharp product window. -/

open Finset Filter Real

namespace Bounty

noncomputable def candidateWindowBox (L : ℝ) : Finset ℕ :=
  Icc 1 ⌊17*exp L⌋₊

theorem arithmetic_window_subset_candidate_window_box (L : ℝ) :
    arithmeticProductWindow 1 (exp L) ⊆ candidateWindowBox L := by
  intro u hu
  have hu' : exp L < (u : ℝ) ∧ (u : ℝ) ≤ 16*exp L := by
    simpa only [one_mul] using (mem_arithmeticProductWindow_iff one_ne_zero (exp L)).mp hu
  apply mem_Icc.mpr
  constructor
  · have hpos : 0 < u := Nat.cast_pos.mp ((exp_pos L).trans hu'.1)
    omega
  · apply Nat.le_floor
    nlinarith [hu'.2, exp_pos L]

theorem mem_candidate_window_box_bounds {L : ℝ} {u : ℕ}
    (hu : u ∈ candidateWindowBox L) : 0 < u ∧ (u : ℝ) ≤ 17*exp L := by
  obtain ⟨hlo, hhi⟩ := mem_Icc.mp hu
  constructor
  · omega
  · exact (Nat.cast_le.mpr hhi).trans (Nat.floor_le (by positivity))

theorem eventually_candidate_window_box_divisor_cross_mass :
    ∀ᶠ L : ℝ in atTop,
      (∑ u ∈ candidateWindowBox L,
        (u.divisors.card : ℝ) * ((2*u+1).divisors.card : ℝ)) ≤ exp L * L^(16 : ℝ) := by
  filter_upwards [eventually_ge_atTop (1 : ℝ),
    eventually_ge_atTop (35*(2+log 35)^15 : ℝ)] with L hL hK
  have hL0 : 0 < L := by linarith
  have hE : 1 ≤ exp L := one_le_exp hL0.le
  let N : ℕ := ⌊35*exp L⌋₊
  have hN0 : 0 < N := Nat.floor_pos.mpr (by linarith)
  have hNpos : (0 : ℝ) < N := by exact_mod_cast hN0
  have hNle : (N : ℝ) ≤ 35*exp L := Nat.floor_le (by positivity)
  have hlog : 1+log N ≤ (2+log 35)*L := by
    have hh := log_le_log hNpos hNle
    rw [log_mul (by norm_num : (35 : ℝ) ≠ 0) (exp_ne_zero L), log_exp] at hh
    have h35 : 0 ≤ log 35 := log_nonneg (by norm_num)
    nlinarith
  have hmass := shifted_divisor_cross_mass_le (candidateWindowBox L) N (by
    intro u hu
    have huhi := (mem_candidate_window_box_bounds hu).2
    apply Nat.le_floor
    push_cast
    linarith)
  calc
    _ ≤ (N : ℝ)*(1+log N)^15 := hmass
    _ ≤ (35*exp L)*((2+log 35)*L)^15 :=
      mul_le_mul hNle (pow_le_pow_left₀ (by positivity) hlog 15)
        (by positivity) (by positivity)
    _ = (35*(2+log 35)^15)*exp L*L^15 := by rw [mul_pow]; ring
    _ ≤ L*exp L*L^15 := mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right hK (exp_pos _).le) (pow_nonneg hL0.le _)
    _ = exp L*L^(16 : ℝ) := by norm_num only [rpow_ofNat]; ring

theorem exists_candidate_window_box_absolute_bound {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1) (A : ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ L : ℝ in atTop, ∀ (jStar : ℕ) (F : ℕ → ℕ → ℂ),
      (∀ u ∈ candidateWindowBox L, ∀ m ∈ (2*u+1).divisors, ‖F u m‖ ≤ L^A) →
      (∑ u ∈ candidateWindowBox L, candidateCoefficient c L q r jStar u *
        ∑ m ∈ (2*u+1).divisors, ‖F u m‖) ≤ exp L * L^C := by
  obtain ⟨K, hK, hcoef⟩ := exists_candidate_coefficient_divisor_bound hc hr hq0 hq1
  refine ⟨K+|A|+16, by positivity, ?_⟩
  filter_upwards [hcoef, eventually_candidate_window_box_divisor_cross_mass,
    eventually_ge_atTop (1 : ℝ)] with L hcoeff hmass hL
  intro jStar F hF
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hsum : (∑ u ∈ candidateWindowBox L, candidateCoefficient c L q r jStar u *
      ∑ m ∈ (2*u+1).divisors, ‖F u m‖) ≤
      L^(K+|A|) * ∑ u ∈ candidateWindowBox L,
        (u.divisors.card : ℝ) * ((2*u+1).divisors.card : ℝ) := by
    rw [mul_sum]
    apply sum_le_sum
    intro u hu
    have hu0 : u ≠ 0 := Nat.ne_of_gt (mem_candidate_window_box_bounds hu).1
    let P := (candidatePIndices c L).biUnion (candidatePBand (c*L))
    have hdiv : primePoolFreePart P u ∣ u :=
      ⟨primePoolPart P u, by simpa only [Nat.mul_comm] using
        (primePoolPart_mul_primePoolFreePart P u).symm⟩
    have hcard : ((primePoolFreePart P u).divisors.card : ℝ) ≤ (u.divisors.card : ℝ) := by
      exact_mod_cast card_le_card (Nat.divisors_subset_of_dvd hu0 hdiv)
    have hcU : candidateCoefficient c L q r jStar u ≤ L^K*(u.divisors.card : ℝ) :=
      (hcoeff jStar u).2.trans (mul_le_mul_of_nonneg_left hcard (rpow_nonneg hL0.le _))
    have hinner : (∑ m ∈ (2*u+1).divisors, ‖F u m‖) ≤
        ((2*u+1).divisors.card : ℝ)*L^|A| := by
      calc
        _ ≤ ∑ _m ∈ (2*u+1).divisors, L^|A| := sum_le_sum (fun m hm =>
          (hF u hu m hm).trans (rpow_le_rpow_of_exponent_le hL (le_abs_self A)))
        _ = _ := by simp
    calc
      _ ≤ (L^K*(u.divisors.card : ℝ))*(((2*u+1).divisors.card : ℝ)*L^|A|) :=
        mul_le_mul hcU hinner (sum_nonneg (fun _ _ => norm_nonneg _)) (by positivity)
      _ = _ := by rw [rpow_add hL0]; ring
  calc
    _ ≤ L^(K+|A|) * ∑ u ∈ candidateWindowBox L,
        (u.divisors.card : ℝ) * ((2*u+1).divisors.card : ℝ) := hsum
    _ ≤ L^(K+|A|)*(exp L*L^(16 : ℝ)) :=
      mul_le_mul_of_nonneg_left hmass (rpow_nonneg hL0.le _)
    _ = exp L*L^(K+|A|+16) := by rw [rpow_add hL0 (K+|A|) 16]; ring


end Bounty
end

section

/- The actual small-mark extraction error is negligible on square multiples. -/

open Finset

namespace Bounty

theorem invariant_marked_prime_peel_error_energy
    {G : Type*} [DecidableEq G] (groups : Finset G) (P : G → Finset ℕ)
    {q v : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v)
    (V : G → ℝ) (t : G → ℕ) (T : ℕ)
    (hV : ∀ g ∈ groups, v ≤ V g) (ht : ∀ g ∈ groups, t g ≤ T)
    (hprime : ∀ g ∈ groups, ∀ p ∈ P g, p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (g : G) (hg : g ∈ groups) (k : ℕ) (htg : t g = k + 1)
    (Q : Finset ℕ) (hQ : P g ⊆ Q) (α β γ : ℕ → ℂ)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (S : Finset ℕ) (N : ℕ) (hS : ∀ n ∈ S, 0 < n ∧ n ≤ N) :
    (∑ n ∈ S, ‖(markedDivisorWeight groups P q V t (n : ℤ) : ℂ) *
        invariantTripleEndpoint Q α β γ n -
      markedPrimePeel groups P q V t g k (invariantTripleEndpoint Q α β γ) n‖ ^ 2) ≤
      ((markedDivisorBound q v T) ^ groups.card * (1 + 2 * Real.log N / v)) ^ 2 *
        (((A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15) *
          ∑ p ∈ P g, 1 / (p : ℝ) ^ 2) := by
  have hsupport (p : ℕ) (hp : p ∈ P g) : p ∈ Nat.factoredNumbers Q := by
    apply Nat.mem_factoredNumbers_of_primeFactors_subset (hprime g hg p hp).ne_zero
    rw [(hprime g hg p hp).primeFactors]
    exact singleton_subset_iff.mpr (hQ hp)
  have hinvariant (n p : ℕ) (hp : p ∈ P g) (hpn : p ∣ n) :
      invariantTripleEndpoint Q α β γ (n / p) = invariantTripleEndpoint Q α β γ n := by
    have he := invariant_triple_endpoint_mul_supported (hsupport p hp) α β γ (n / p)
    rw [Nat.mul_div_cancel' hpn] at he
    exact he.symm
  apply invariant_triple_endpoint_square_error_energy Q (P g) α β γ
    hA hB hC hα hβ hγ hsupport S N (fun n hn => (hS n hn).2)
  · intro n _ hsq
    exact sub_eq_zero.mpr (marked_prime_peel_exact groups P q V t hprime hdis
      g hg k htg n hsq (invariantTripleEndpoint Q α β γ) (hinvariant n))
  · intro n hn
    exact marked_prime_peel_error_norm_le groups P hq0 hq1 hv V t T hV ht g hg k
      (by omega) (hprime g hg) (invariantTripleEndpoint Q α β γ) n N
      (hS n hn).1 (hS n hn).2 (hinvariant n)

end Bounty
end

section

/- Including initial active primes absorbs the original initial-avoidance condition into one common distinctness predicate. -/

open Classical
namespace Bounty
section Total
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ) (steps : List (Option (J ⊕ K)))
  (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
  (p : FullPermutationMixedPath n S B A Δ D steps x)

noncomputable def fullMixedCommonBirthLabel : FullMixedCommonBirthAddress M B steps → Option ((g : Fin N) × P g) :=
  initialAndBirthLabels (fullMixedCommonInitialPrime x) (fullMixedCommonPathBirthLabel n S B A Δ D steps x p)

noncomputable def fullMixedCommonBirthPerformed (a : FullMixedCommonBirthAddress M B steps) : Prop :=
  (fullMixedCommonBirthLabel n S B A Δ D steps x p a).isSome = true

theorem full_mixed_common_initial_label (a : FullMixedCommonInitialAddress M) :
    fullMixedCommonBirthLabel n S B A Δ D steps x p (.inl a) = some (fullMixedCommonInitialPrime x a) := rfl

theorem full_mixed_common_initial_performed (a : FullMixedCommonInitialAddress M) :
    fullMixedCommonBirthPerformed n S B A Δ D steps x p (.inl a) := rfl

theorem full_mixed_common_new_label (a : FullMixedCommonStepAddress M B steps) :
    fullMixedCommonBirthLabel n S B A Δ D steps x p (.inr a) =
      fullMixedCommonPathBirthLabel n S B A Δ D steps x p a := rfl

variable [∀ g, DecidableEq (P g)]

theorem full_mixed_common_initial_avoidance_iff :
    (∀ i a, fullMixedCommonPathBirthLabel n S B A Δ D steps x p a ≠ some (fullMixedCommonInitialPrime x i)) ↔
      (∀ a z, fullMixedPathBirthLabel n S B A Δ D steps x p a = some z →
        z.2 ∉ fullActiveInitialLedger x z.1) := by
  rw [full_mixed_common_initial_avoids_iff]
  exact full_mixed_common_path_all_labels_iff n S B A Δ D steps x p _

theorem full_mixed_common_distinct_iff (hx : FullActiveInjective x) :
    (∀ a b z, fullMixedCommonBirthLabel n S B A Δ D steps x p a = some z →
      fullMixedCommonBirthLabel n S B A Δ D steps x p b = some z → a = b) ↔
    (∀ a b z, fullMixedPathBirthLabel n S B A Δ D steps x p a = some z →
      fullMixedPathBirthLabel n S B A Δ D steps x p b = some z → a = b) ∧
    (∀ a z, fullMixedPathBirthLabel n S B A Δ D steps x p a = some z →
      z.2 ∉ fullActiveInitialLedger x z.1) := by
  change (∀ a b z, initialAndBirthLabels _ _ a = some z → initialAndBirthLabels _ _ b = some z → a = b) ↔ _
  rw [initial_birth_distinctness_iff, full_mixed_common_path_distinct_iff,
    full_mixed_common_initial_avoidance_iff]
  exact and_iff_right (full_mixed_common_initial_injective x hx)

end Total
end Bounty
end

section

/- Signed shifts retain injectivity on positive endpoints. -/

open Finset Filter Real

namespace Bounty

theorem factorization_absolute_signed_cross_moment
    (S : Finset ℤ) (k : ℤ) (N : ℕ) (M H : Finset ℕ) (α a : ℕ → ℂ)
    {A B : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hα : ∀ m ∈ M, ‖α m‖ ≤ A)
    (ha : ∀ h ∈ H, h ≠ 0 → ‖a h‖ ≤ B*(h.divisors.card : ℝ))
    (hpos : ∀ z ∈ S, 0 < z ∧ 0 < z+k)
    (hN : ∀ z ∈ S, z ≤ N ∧ z+k ≤ N) :
    (∑ z ∈ S, factorizationAbsoluteMass M H α a z.toNat *
      factorizationAbsoluteMass M H α a (z+k).toNat) ≤
      (A*B)^2*(N : ℝ)*(1+log N)^15 := by
  apply factorization_absolute_cross_moment S Int.toNat (fun z => (z+k).toNat) N M H α a hA hB hα ha
  · intro x hx y hy hxy
    have hx0 := (hpos x hx).1
    have hy0 := (hpos y hy).1
    omega
  · intro x hx y hy hxy
    have hx0 := (hpos x hx).2
    have hy0 := (hpos y hy).2
    change (x+k).toNat = (y+k).toNat at hxy
    omega
  · intro z hz
    have hz0 := (hpos z hz).1
    omega
  · intro z hz
    have hz0 := (hpos z hz).2
    omega
  · intro z hz
    have hzn := (hN z hz).1
    omega
  · intro z hz
    have hzn := (hN z hz).2
    omega

theorem factorization_absolute_localized_cross_moment
    (S : Finset ℤ) (k : ℤ) (Z : ℝ) (M H : Finset ℕ) (α a : ℕ → ℂ)
    {A B : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hα : ∀ m ∈ M, ‖α m‖ ≤ A)
    (ha : ∀ h ∈ H, h ≠ 0 → ‖a h‖ ≤ B*(h.divisors.card : ℝ))
    (hpos : ∀ z ∈ S, 0 < z ∧ 0 < z+k)
    (_hZ : 0 ≤ Z) (hloc : ∀ z ∈ S, (z : ℝ) ≤ 2*Z) (hk : |(k : ℝ)| ≤ Z) :
    (∑ z ∈ S, factorizationAbsoluteMass M H α a z.toNat *
      factorizationAbsoluteMass M H α a (z+k).toNat) ≤
      (A*B)^2*(⌈3*Z⌉₊ : ℝ)*(1+log (⌈3*Z⌉₊ : ℝ))^15 := by
  apply factorization_absolute_signed_cross_moment S k ⌈3*Z⌉₊ M H α a hA hB hα ha hpos
  intro z hz
  have hceil : 3*Z ≤ (⌈3*Z⌉₊ : ℝ) := Nat.le_ceil _
  have hzR := hloc z hz
  have hkR := (abs_le.mp hk).2
  constructor
  · exact_mod_cast (show (z : ℝ) ≤ (⌈3*Z⌉₊ : ℝ) by linarith)
  · exact_mod_cast (show ((z+k : ℤ) : ℝ) ≤ (⌈3*Z⌉₊ : ℝ) by push_cast; linarith)

theorem eventually_localized_divisor_moment_cost {C : ℝ} (_hC : 0 ≤ C) :
    ∀ᶠ L : ℝ in atTop, ∀ Z : ℝ, 1 ≤ Z → log Z ≤ C*L →
      (⌈3*Z⌉₊ : ℝ)*(1+log (⌈3*Z⌉₊ : ℝ))^15 ≤ Z*L^(16 : ℝ) := by
  filter_upwards [eventually_ge_atTop (1 : ℝ),
    eventually_ge_atTop (4*(2+C+log 4)^15 : ℝ)] with L hL hK
  intro Z hZ hZlog
  have hZ0 : 0 < Z := by linarith
  have hNpos : (0 : ℝ) < ⌈3*Z⌉₊ := lt_of_lt_of_le (by positivity) (Nat.le_ceil (3*Z))
  have hNle : (⌈3*Z⌉₊ : ℝ) ≤ 4*Z := by
    have hceil := Nat.ceil_lt_add_one (show 0 ≤ 3*Z by positivity)
    linarith
  have h4 : 0 ≤ log 4 := log_nonneg (by norm_num)
  have hlog : 1+log (⌈3*Z⌉₊ : ℝ) ≤ (2+C+log 4)*L := by
    have hh := log_le_log hNpos hNle
    rw [log_mul (by norm_num : (4 : ℝ) ≠ 0) hZ0.ne'] at hh
    nlinarith
  calc
    _ ≤ (4*Z)*((2+C+log 4)*L)^15 :=
      mul_le_mul hNle (pow_le_pow_left₀ (by positivity) hlog 15) (by positivity) (by positivity)
    _ = (4*(2+C+log 4)^15)*Z*L^15 := by rw [mul_pow]; ring
    _ ≤ L*Z*L^15 := mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right hK hZ0.le) (pow_nonneg (by linarith) _)
    _ = Z*L^(16 : ℝ) := by norm_num only [rpow_ofNat]; ring

end Bounty
end

section

/- The actual finite additive convolution is a Schwartz function. -/

open Finset MeasureTheory
open scoped ContDiff FourierTransform

namespace Bounty

noncomputable def localAdditivePolynomial (S : Finset ℕ) (a : ℕ → ℂ) (β : ℝ) : ℂ :=
  ∑ n ∈ S, a n * Complex.exp (((2 * Real.pi * β * n : ℝ) : ℂ) * Complex.I)

noncomputable def localAdditiveConvolution (S : Finset ℕ) (a : ℕ → ℂ) (H v : ℝ) : ℂ :=
  ∑ n ∈ S, a n * localMellinKernelSchwartz (((n:ℝ)-v)/H)

theorem local_kernel_translate_compact (n : ℝ) {H : ℝ} (hH : 0 < H) :
    HasCompactSupport (fun v => localMellinKernelSchwartz ((n-v)/H)) := by
  apply HasCompactSupport.intro (isCompact_Icc : IsCompact (Set.Icc (n-H) (n+H)))
  intro v hv
  apply local_mellin_kernel_unit_support
  apply lt_of_not_ge
  intro hb
  rw [abs_div, abs_of_pos hH] at hb
  have hh := abs_le.mp ((div_le_one hH).mp hb)
  exact hv ⟨by linarith [hh.2], by linarith [hh.1]⟩

theorem local_additive_convolution_contDiff (S : Finset ℕ) (a : ℕ → ℂ) (H : ℝ) :
    ContDiff ℝ ∞ (localAdditiveConvolution S a H) := by
  apply ContDiff.sum
  intro n hn
  exact contDiff_const.mul (localMellinKernelSchwartz.smooth'.comp (by fun_prop))

theorem local_additive_convolution_compact (S : Finset ℕ) (a : ℕ → ℂ)
    {H : ℝ} (hH : 0 < H) : HasCompactSupport (localAdditiveConvolution S a H) := by
  change HasCompactSupport (fun v => ∑ n ∈ S, a n * localMellinKernelSchwartz (((n:ℝ)-v)/H))
  have hc := HasCompactSupport.finset_sum (s := S)
    (fun n hn => (local_kernel_translate_compact (n:ℝ) hH).mul_left (f := fun _ => a n))
  simpa only [Finset.sum_fn, Pi.mul_apply] using hc

noncomputable def localAdditiveSchwartz (S : Finset ℕ) (a : ℕ → ℂ)
    (H : ℝ) (hH : 0 < H) : SchwartzMap ℝ ℂ :=
  (local_additive_convolution_compact S a hH).toSchwartzMap
    (local_additive_convolution_contDiff S a H)

theorem integral_translate_div_scale (f : ℝ → ℂ) (n : ℝ) {H : ℝ} (hH : 0 < H) :
    (∫ v : ℝ, f ((n-v)/H)) = (H:ℂ) * ∫ u : ℝ, f u := by
  rw [integral_sub_left_eq_self (fun v => f (v/H)) volume n,
    Measure.integral_comp_div, abs_of_pos hH, Complex.real_smul]

theorem local_kernel_translate_inverse_fourier (n β : ℝ) {H : ℝ} (hH : 0 < H) :
    (∫ v : ℝ, Complex.exp (((2*Real.pi*β*v:ℝ):ℂ)*Complex.I) *
      localMellinKernelSchwartz ((n-v)/H)) =
        (H:ℂ) * Complex.exp (((2*Real.pi*β*n:ℝ):ℂ)*Complex.I) *
          𝓕 localMellinKernelSchwartz (H*β) := by
  let F : ℝ → ℂ := fun u => Complex.exp (((-2*Real.pi*u*(H*β):ℝ):ℂ)*Complex.I) *
    localMellinKernelSchwartz u
  have heq (v : ℝ) : Complex.exp (((2*Real.pi*β*v:ℝ):ℂ)*Complex.I) *
      localMellinKernelSchwartz ((n-v)/H) =
        Complex.exp (((2*Real.pi*β*n:ℝ):ℂ)*Complex.I) * F ((n-v)/H) := by
    dsimp only [F]
    rw [← mul_assoc, ← Complex.exp_add]
    congr 2
    push_cast
    field_simp [Complex.ofReal_ne_zero.mpr hH.ne']
    ring
  simp_rw [heq]
  rw [integral_const_mul, integral_translate_div_scale F n hH,
    local_mellin_kernel_fourier_formula]
  change _ = (H:ℂ) * _ * ∫ u : ℝ, F u
  ring

end Bounty
end

section

/- Signed ghost phases on the genuine mixed state may depend jointly on
the small state, active labels and ordered newborn particles. All retention
choices remain summed, so no symmetry of the ordered birth batch is needed.
A fixed initial-forbidden-set gate tests newborn labels only. -/

open Finset Classical
namespace Bounty

section Symmetry
variable {S G : Type*} [Fintype G] [dG : DecidableEq G] {Ps : S → Finset ℕ}
  {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
  [∀ g, DecidableEq (Z g)] {J ell : ℕ}
  (A D C ν : ∀ g, Z g → ℝ) (M : G → ℕ) (B : ℕ)

omit [∀ g, Fintype (P g)] in
theorem physical_small_big_ghost_signed_memory_symmetric
    (phase : ∀ s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B),
      CoupledGhostEvent M B s.2 → ℂ)
    (hphase : ∀ (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B))
      (τ : ∀ g, Equiv.Perm (Fin (s.2 g).2.1.val)) (e : CoupledGhostEvent M B s.2),
      phase (s.1, productMemoryReindex s.2 τ) (jointGhostMemoryReindex M B s.2 τ e) = phase s e)
    (F : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ)
    (hF : ∀ s, ProductMemorySymmetric (fun x => F (s, x))) :
    ∀ s, ProductMemorySymmetric (fun x => physicalSmallBigGhostAction A D C ν M B phase F (s, x)) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  intro s x g τ
  dsimp only
  refine (congrArg (fun y => physicalSmallBigGhostAction A D C ν M B phase F (s, y))
    (product_memory_reindex_at x g τ)).symm.trans ?_
  simp only [physical_small_big_ghost_eq_event_sum]
  let σ := Function.update (fun h => Equiv.refl (Fin (x h).2.1.val)) g τ
  rw [← (jointGhostMemoryReindex M B x σ).sum_comp]
  apply sum_congr rfl
  intro e _
  rw [joint_ghost_reindex_weight]
  rw [hphase (s,x) σ e]
  exact congrArg (fun z : ℂ => (coupledGhostJointEventWeight A D C ν M B x e : ℂ) * phase (s,x) e * z)
    (joint_ghost_reindex_test M B x σ e (fun y => F (s,y)) (hF s))

end Symmetry

noncomputable def physicalSmallBigGhostBirthPhase
    {S G : Type*} {Ps : S → Finset ℕ} {P Z : G → Type*} {J ell : ℕ}
    (M : G → ℕ) (B : ℕ)
    (φ : PhysicalBareResidueState Ps J ell → (∀ g, Fin (M g) → P g) →
      (∀ g, FiniteOrderedTuple (Z g)) → ℂ)
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B))
    (e : CoupledGhostEvent M B s.2) : ℂ :=
  φ s.1 (fun g => (s.2 g).1) (fun g => ⟨(e g).1.val, (e g).2.2⟩)

theorem physical_small_big_ghost_birth_phase_reindex
    {S G : Type*} {Ps : S → Finset ℕ} {P Z : G → Type*} {J ell : ℕ}
    (M : G → ℕ) (B : ℕ)
    (φ : PhysicalBareResidueState Ps J ell → (∀ g, Fin (M g) → P g) →
      (∀ g, FiniteOrderedTuple (Z g)) → ℂ)
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B))
    (τ : ∀ g, Equiv.Perm (Fin (s.2 g).2.1.val)) (e : CoupledGhostEvent M B s.2) :
    physicalSmallBigGhostBirthPhase M B φ (s.1, productMemoryReindex s.2 τ)
        (jointGhostMemoryReindex M B s.2 τ e) = physicalSmallBigGhostBirthPhase M B φ s e := rfl

theorem physical_small_big_ghost_birth_memory_symmetric
    {S G : Type*} [Fintype G] [DecidableEq G] {Ps : S → Finset ℕ}
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    [∀ g, DecidableEq (Z g)] {J ell : ℕ}
    (A D C ν : ∀ g, Z g → ℝ) (M : G → ℕ) (B : ℕ)
    (φ : PhysicalBareResidueState Ps J ell → (∀ g, Fin (M g) → P g) →
      (∀ g, FiniteOrderedTuple (Z g)) → ℂ)
    (F : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ)
    (hF : ∀ s, ProductMemorySymmetric (fun x => F (s, x))) :
    ∀ s, ProductMemorySymmetric (fun x => physicalSmallBigGhostAction A D C ν M B
      (physicalSmallBigGhostBirthPhase M B φ) F (s, x)) :=
  physical_small_big_ghost_signed_memory_symmetric A D C ν M B _
    (physical_small_big_ghost_birth_phase_reindex M B φ) F hF

noncomputable def physicalSmallBigGhostInitialBirthPhase
    {S G : Type*} {Ps : S → Finset ℕ} {P Z : G → Type*} {J ell : ℕ}
    (label : ∀ g, Z g → P g) (initial : ∀ g, Finset (P g)) (M : G → ℕ) (B : ℕ)
    (φ : PhysicalBareResidueState Ps J ell → (∀ g, Fin (M g) → P g) →
      (∀ g, FiniteOrderedTuple (Z g)) → ℂ) :=
  physicalSmallBigGhostBirthPhase M B (fun s active births =>
    if ∀ g i, label g ((births g).2 i) ∉ initial g then φ s active births else 0)

theorem physical_small_big_ghost_initial_birth_phase_norm_le
    {S G : Type*} {Ps : S → Finset ℕ} {P Z : G → Type*} {J ell : ℕ}
    (label : ∀ g, Z g → P g) (initial : ∀ g, Finset (P g)) (M : G → ℕ) (B : ℕ)
    (φ : PhysicalBareResidueState Ps J ell → (∀ g, Fin (M g) → P g) →
      (∀ g, FiniteOrderedTuple (Z g)) → ℂ) (hφ : ∀ s active births, ‖φ s active births‖ ≤ 1)
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B))
    (e : CoupledGhostEvent M B s.2) :
    ‖physicalSmallBigGhostInitialBirthPhase label initial M B φ s e‖ ≤ 1 := by
  unfold physicalSmallBigGhostInitialBirthPhase physicalSmallBigGhostBirthPhase
  dsimp only
  split_ifs
  · exact hφ _ _ _
  · simp only [norm_zero, zero_le_one]

theorem physical_small_big_ghost_initial_birth_memory_symmetric
    {S G : Type*} [Fintype G] [DecidableEq G] {Ps : S → Finset ℕ}
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    [∀ g, DecidableEq (Z g)] {J ell : ℕ}
    (A D C ν : ∀ g, Z g → ℝ) (label : ∀ g, Z g → P g) (initial : ∀ g, Finset (P g))
    (M : G → ℕ) (B : ℕ)
    (φ : PhysicalBareResidueState Ps J ell → (∀ g, Fin (M g) → P g) →
      (∀ g, FiniteOrderedTuple (Z g)) → ℂ)
    (F : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ)
    (hF : ∀ s, ProductMemorySymmetric (fun x => F (s, x))) :
    ∀ s, ProductMemorySymmetric (fun x => physicalSmallBigGhostAction A D C ν M B
      (physicalSmallBigGhostInitialBirthPhase label initial M B φ) F (s, x)) :=
  physical_small_big_ghost_birth_memory_symmetric A D C ν M B _ F hF

end Bounty
end

section

/- Integrable envelopes for the actual amplitude and its Gram product, uniformly in both scales. -/

open MeasureTheory Set Real
open scoped FourierTransform

namespace Bounty

theorem local_mellin_amplitude_fourier_bound (j : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ Integrable (fun s : ℝ => C/(1+s^2)) ∧
      ∀ s v, ‖localMellinAmplitudeFourier j s v‖ ≤ C/(1+s^2) := by
  obtain ⟨C₀,C₁,C₂,hC₀,hC₁,hC₂,hb⟩ := local_mellin_amplitude_uniform_derivatives j
  obtain ⟨C,hC,hi,hf⟩ := compact_schwartz_fourier_envelope (localMellinAmplitudeSchwartz j) 3 C₀ C₂
    hC₀ hC₂ (fun v u hu => local_mellin_amplitude_zero j v u hu)
    (fun v u hu => (local_mellin_amplitude_derivatives_zero j v u hu).2)
    (fun v u => (hb v u).1) (fun v u => (hb v u).2.2)
  exact ⟨C,hC,hi,fun s v => hf v s⟩

theorem schwartz_product_star_second (f g : SchwartzMap ℝ ℂ) (u : ℝ) :
    deriv (deriv (fun x => f x*star (g x))) u =
      deriv (deriv f) u*star (g u)+2*deriv f u*star (deriv g u)+
        f u*star (deriv (deriv g) u) := by
  have he : deriv (fun x => f x*star (g x)) =
      fun x => deriv f x*star (g x)+f x*star (deriv g x) := by
    funext x
    exact ((f.hasDerivAt x).mul (g.hasDerivAt x).star).deriv
  rw [he]
  have hf : HasDerivAt (deriv f) (deriv (deriv f) u) u :=
    (SchwartzMap.derivCLM ℂ ℂ f).hasDerivAt u
  have hg : HasDerivAt (deriv g) (deriv (deriv g) u) u :=
    (SchwartzMap.derivCLM ℂ ℂ g).hasDerivAt u
  have hh := ((hf.mul (g.hasDerivAt u).star).add ((f.hasDerivAt u).mul hg.star)).deriv
  change deriv (fun x => deriv f x*star (g x)+f x*star (deriv g x)) u = _ at hh
  rw [hh]
  ring

noncomputable def localMellinAmplitudeProductSchwartz (j : ℕ) (v w : ℝ) : SchwartzMap ℝ ℂ :=
  (show HasCompactSupport (fun u => localMellinAmplitude j v u*star (localMellinAmplitude j w u)) from by
    apply HasCompactSupport.intro (isCompact_Icc : IsCompact (Icc (-3 : ℝ) 3))
    intro u hu
    rw [local_mellin_amplitude_zero j v u hu,zero_mul]).toSchwartzMap
      ((local_mellin_amplitude_contDiff j v).mul
        (Complex.conjCLE.toContinuousLinearMap.contDiff.comp (local_mellin_amplitude_contDiff j w)))

theorem local_mellin_amplitude_product_fourier_bound (j : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ Integrable (fun s : ℝ => C/(1+s^2)) ∧ ∀ v w s,
      ‖∫ u : ℝ, Complex.exp (((-2*Real.pi*s*u : ℝ) : ℂ)*Complex.I) *
        localMellinAmplitude j v u*star (localMellinAmplitude j w u)‖ ≤ C/(1+s^2) := by
  obtain ⟨C₀,C₁,C₂,hC₀,hC₁,hC₂,hb⟩ := local_mellin_amplitude_uniform_derivatives j
  let F : ℝ × ℝ → SchwartzMap ℝ ℂ := fun p => localMellinAmplitudeProductSchwartz j p.1 p.2
  have hs (p : ℝ × ℝ) (u : ℝ) (hu : u ∉ Icc (-3 : ℝ) 3) : F p u = 0 := by
    change localMellinAmplitude j p.1 u*star (localMellinAmplitude j p.2 u) = 0
    rw [local_mellin_amplitude_zero j p.1 u hu,zero_mul]
  have hs₂ (p : ℝ × ℝ) (u : ℝ) (hu : u ∉ Icc (-3 : ℝ) 3) :
      SchwartzMap.derivCLM ℂ ℂ (SchwartzMap.derivCLM ℂ ℂ (F p)) u = 0 := by
    have hsub : tsupport (F p) ⊆ Icc (-3 : ℝ) 3 := by
      apply closure_minimal _ isClosed_Icc
      intro x hx
      by_contra hn
      exact hx (hs p x hn)
    apply image_eq_zero_of_notMem_tsupport
    intro hu'
    exact hu (hsub ((SchwartzMap.tsupport_derivCLM_subset ℂ (F p))
      ((SchwartzMap.tsupport_derivCLM_subset ℂ (SchwartzMap.derivCLM ℂ ℂ (F p))) hu')))
  have h₀ (p : ℝ × ℝ) (u : ℝ) : ‖F p u‖ ≤ C₀^2 := by
    change ‖localMellinAmplitudeSchwartz j p.1 u*star (localMellinAmplitudeSchwartz j p.2 u)‖ ≤ _
    rw [norm_mul,norm_star,pow_two]
    exact mul_le_mul (hb p.1 u).1 (hb p.2 u).1 (norm_nonneg _) hC₀
  have h₂ (p : ℝ × ℝ) (u : ℝ) :
      ‖SchwartzMap.derivCLM ℂ ℂ (SchwartzMap.derivCLM ℂ ℂ (F p)) u‖ ≤ 2*C₀*C₂+2*C₁^2 := by
    change ‖deriv (deriv (fun x => localMellinAmplitudeSchwartz j p.1 x*
      star (localMellinAmplitudeSchwartz j p.2 x))) u‖ ≤ _
    rw [schwartz_product_star_second]
    apply le_trans ((norm_add_le _ _).trans (add_le_add (norm_add_le _ _) le_rfl))
    simp only [norm_mul,norm_star,Complex.norm_ofNat]
    have hv := hb p.1 u
    have hw := hb p.2 u
    calc
      _ ≤ C₂*C₀+2*C₁*C₁+C₀*C₂ := by
        gcongr <;> first | exact hv.2.2 | exact hw.1 | exact hv.2.1 | exact hw.2.1 | exact hv.1 | exact hw.2.2
      _ = _ := by ring
  obtain ⟨C,hC,hi,hf⟩ := compact_schwartz_fourier_envelope F 3 (C₀^2) (2*C₀*C₂+2*C₁^2)
    (by positivity) (by positivity) hs hs₂ h₀ h₂
  refine ⟨C,hC,hi,?_⟩
  intro v w s
  have he : 𝓕 (F (v,w)) s = ∫ u : ℝ,
      Complex.exp (((-2*Real.pi*s*u : ℝ) : ℂ)*Complex.I)*
        localMellinAmplitude j v u*star (localMellinAmplitude j w u) := by
    rw [SchwartzMap.fourier_coe,Real.fourier_eq']
    apply integral_congr_ae
    filter_upwards [] with u
    simp only [RCLike.inner_apply,starRingEnd_apply,star_trivial,smul_eq_mul]
    change Complex.exp _*(localMellinAmplitude j v u*star (localMellinAmplitude j w u)) = _
    simp only [mul_assoc]
  rw [← he]
  exact hf (v,w) s

end Bounty
end

section

open MeasureTheory

namespace Bounty

noncomputable def mellinDecayWeight (j : ℕ) (h t : ℝ) : ℝ :=
  ((1+(h*t)^2)^j)⁻¹

theorem mellin_decay_weight_pos (j : ℕ) (h t : ℝ) :
    0 < mellinDecayWeight j h t := by
  unfold mellinDecayWeight
  positivity

theorem mellin_decay_weight_le_one (j : ℕ) (h t : ℝ) :
    mellinDecayWeight j h t ≤ 1 := by
  unfold mellinDecayWeight
  apply inv_le_one_of_one_le₀
  exact one_le_pow₀ (by nlinarith [sq_nonneg (h*t)])

theorem mellin_decay_weight_bound (j : ℕ) (h t : ℝ) :
    mellinDecayWeight j h t ≤ (2:ℝ)^j * (1+|h*t|)^(-(j:ℝ)) := by
  have hb : 1+|h*t| ≤ 2*(1+(h*t)^2) := by
    nlinarith [sq_nonneg (|h*t|-1), sq_abs (h*t)]
  have hp := pow_le_pow_left₀ (by positivity : 0 ≤ 1+|h*t|) hb j
  rw [mul_pow] at hp
  rw [Real.rpow_neg (by positivity), Real.rpow_natCast]
  unfold mellinDecayWeight
  have hq : 1 / (1+(h*t)^2)^j ≤ (2:ℝ)^j / (1+|h*t|)^j :=
    (div_le_div_iff₀ (by positivity) (by positivity)).mpr (by simpa only [one_mul] using hp)
  simpa only [one_div, div_eq_mul_inv, one_mul] using hq

theorem mellin_decay_weight_continuous (j : ℕ) (h : ℝ) :
    Continuous (mellinDecayWeight j h) := by
  unfold mellinDecayWeight
  apply Continuous.inv₀
  · fun_prop
  · intro t
    positivity

theorem mellin_decay_weight_integrable {j : ℕ} (hj : 2 ≤ j) {h : ℝ} (hh : 0 < h) :
    Integrable (mellinDecayWeight j h) := by
  have hjR : (1:ℝ) < j := by exact_mod_cast (by omega : 1 < j)
  have hi : Integrable (fun t : ℝ => (1+|t|)^(-(j:ℝ))) := by
    simpa only [Real.norm_eq_abs] using
      (integrable_one_add_norm (E := ℝ) (r := (j:ℝ)) (by simpa using hjR))
  apply ((hi.comp_mul_left' hh.ne').const_mul ((2:ℝ)^j)).mono'
    (mellin_decay_weight_continuous j h).aestronglyMeasurable
  filter_upwards [] with t
  rw [Real.norm_of_nonneg (mellin_decay_weight_pos j h t).le]
  exact mellin_decay_weight_bound j h t

theorem mellin_weighted_bounded_integrable
    {j : ℕ} (hj : 2 ≤ j) {h : ℝ} (hh : 0 < h)
    {g : ℝ → ℂ} (hg : Continuous g) {M : ℝ} (hgM : ∀ t, ‖g t‖ ≤ M) :
    Integrable (fun t => (mellinDecayWeight j h t : ℂ) * g t) := by
  apply ((mellin_decay_weight_integrable hj hh).mul_const M).mono'
  · exact ((Complex.continuous_ofReal.comp (mellin_decay_weight_continuous j h)).mul hg).aestronglyMeasurable
  · filter_upwards [] with t
    rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (mellin_decay_weight_pos j h t).le]
    exact mul_le_mul_of_nonneg_left (hgM t) (mellin_decay_weight_pos j h t).le

theorem mellin_weighted_bounded_square_integrable
    {j : ℕ} (hj : 2 ≤ j) {h : ℝ} (hh : 0 < h)
    {g : ℝ → ℂ} (hg : Continuous g) {M : ℝ} (hgM : ∀ t, ‖g t‖ ≤ M) :
    Integrable (fun t => ‖(mellinDecayWeight j h t : ℂ) * g t‖^2) := by
  apply ((mellin_decay_weight_integrable hj hh).mul_const (M^2)).mono'
  · exact (((Complex.continuous_ofReal.comp (mellin_decay_weight_continuous j h)).mul hg).norm.pow 2).aestronglyMeasurable
  · filter_upwards [] with t
    rw [Real.norm_of_nonneg (sq_nonneg _), norm_mul, Complex.norm_real,
      Real.norm_of_nonneg (mellin_decay_weight_pos j h t).le, mul_pow]
    have hw := mellin_decay_weight_le_one j h t
    have hw0 := (mellin_decay_weight_pos j h t).le
    have hwp : (mellinDecayWeight j h t)^2 ≤ mellinDecayWeight j h t := by nlinarith
    exact mul_le_mul hwp (pow_le_pow_left₀ (norm_nonneg _) (hgM t) 2) (sq_nonneg _) hw0

theorem mellin_weighted_square_energy_bound
    {j : ℕ} (hj : 2 ≤ j) {h : ℝ} (hh : 0 < h)
    {g : ℝ → ℂ} (hg : Continuous g) {M : ℝ} (hgM : ∀ t, ‖g t‖ ≤ M) :
    (∫ t : ℝ, ‖(mellinDecayWeight j h t : ℂ) * g t‖^2) ≤
      (2:ℝ)^j * ∫ t : ℝ, (1+|h*t|)^(-(j:ℝ)) * ‖g t‖^2 := by
  have hjR : (1:ℝ) < j := by exact_mod_cast (by omega : 1 < j)
  have hi : Integrable (fun t : ℝ => (1+|h*t|)^(-(j:ℝ))) := by
    have hi0 := integrable_one_add_norm (E := ℝ) (μ := volume) (r := (j:ℝ)) (by simpa using hjR)
    simpa only [Real.norm_eq_abs] using hi0.comp_mul_left' hh.ne'
  have hgi : Integrable (fun t => (1+|h*t|)^(-(j:ℝ)) * ‖g t‖^2) := by
    apply (hi.mul_const (M^2)).mono'
    · have hw : Continuous (fun t : ℝ => (1+|h*t|)^(-(j:ℝ))) :=
        (by fun_prop : Continuous (fun t : ℝ => 1+|h*t|)).rpow_const
          (fun t => Or.inl (by positivity))
      exact (hw.mul (hg.norm.pow 2)).aestronglyMeasurable
    · filter_upwards [] with t
      rw [Real.norm_of_nonneg (by positivity)]
      exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) (hgM t) 2) (by positivity)
  rw [← integral_const_mul]
  apply integral_mono (mellin_weighted_bounded_square_integrable hj hh hg hgM) (hgi.const_mul _)
  intro t
  dsimp only
  rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (mellin_decay_weight_pos j h t).le, mul_pow]
  have hw := mellin_decay_weight_le_one j h t
  have hw0 := (mellin_decay_weight_pos j h t).le
  have hwp : (mellinDecayWeight j h t)^2 ≤ mellinDecayWeight j h t := by nlinarith
  have hb := mul_le_mul_of_nonneg_right (hwp.trans (mellin_decay_weight_bound j h t)) (sq_nonneg ‖g t‖)
  simpa only [mul_assoc] using hb

end Bounty
end

section

/- Absolute candidate mass on a finite box containing the sharp product window. -/

open Finset Filter Real

namespace Bounty

theorem eventually_candidate_finite_divisor_cross_mass (R : ℝ) (hR : 1 ≤ R) :
    ∀ᶠ L : ℝ in atTop, ∀ S : Finset ℕ,
      (∀ u ∈ S, (u : ℝ) ≤ R*exp L) →
      (∑ u ∈ S,
        (u.divisors.card : ℝ) * ((2*u+1).divisors.card : ℝ)) ≤ exp L * L^(16 : ℝ) := by
  filter_upwards [eventually_ge_atTop (1 : ℝ),
    eventually_ge_atTop ((2*R+1)*(2+log (2*R+1))^15 : ℝ)] with L hL hK
  intro S hS
  have hL0 : 0 < L := by linarith
  have hE : 1 ≤ exp L := one_le_exp hL0.le
  let N : ℕ := ⌊(2*R+1)*exp L⌋₊
  have hN0 : 0 < N := Nat.floor_pos.mpr (by nlinarith)
  have hNpos : (0 : ℝ) < N := by exact_mod_cast hN0
  have hNle : (N : ℝ) ≤ (2*R+1)*exp L := Nat.floor_le (by positivity)
  have hlog : 1+log N ≤ (2+log (2*R+1))*L := by
    have hh := log_le_log hNpos hNle
    rw [log_mul (by linarith : ((2*R+1) : ℝ) ≠ 0) (exp_ne_zero L), log_exp] at hh
    have hlogR : 0 ≤ log (2*R+1) := log_nonneg (by linarith)
    nlinarith
  have hmass := shifted_divisor_cross_mass_le (S) N (by
    intro u hu
    have huhi := hS u hu
    apply Nat.le_floor
    push_cast
    nlinarith)
  calc
    _ ≤ (N : ℝ)*(1+log N)^15 := hmass
    _ ≤ ((2*R+1)*exp L)*((2+log (2*R+1))*L)^15 :=
      mul_le_mul hNle (pow_le_pow_left₀ (by positivity) hlog 15)
        (by positivity) (by positivity)
    _ = ((2*R+1)*(2+log (2*R+1))^15)*exp L*L^15 := by rw [mul_pow]; ring
    _ ≤ L*exp L*L^15 := mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right hK (exp_pos _).le) (pow_nonneg hL0.le _)
    _ = exp L*L^(16 : ℝ) := by norm_num only [rpow_ofNat]; ring

theorem exists_candidate_finite_test_absolute_bound {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1) (R : ℝ) (hR : 1 ≤ R) (A : ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ L : ℝ in atTop, ∀ (jStar : ℕ) (S : Finset ℕ) (F : ℕ → ℕ → ℂ),
      (∀ u ∈ S, 0 < u ∧ (u : ℝ) ≤ R*exp L) →
      (∀ u ∈ S, ∀ m ∈ (2*u+1).divisors, ‖F u m‖ ≤ L^A) →
      (∑ u ∈ S, candidateCoefficient c L q r jStar u *
        ∑ m ∈ (2*u+1).divisors, ‖F u m‖) ≤ exp L * L^C := by
  obtain ⟨K, hK, hcoef⟩ := exists_candidate_coefficient_divisor_bound hc hr hq0 hq1
  refine ⟨K+|A|+16, by positivity, ?_⟩
  filter_upwards [hcoef, eventually_candidate_finite_divisor_cross_mass R hR,
    eventually_ge_atTop (1 : ℝ)] with L hcoeff hmass hL
  intro jStar S F hS hF
  have hmassS := hmass S (fun u hu => (hS u hu).2)
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hsum : (∑ u ∈ S, candidateCoefficient c L q r jStar u *
      ∑ m ∈ (2*u+1).divisors, ‖F u m‖) ≤
      L^(K+|A|) * ∑ u ∈ S,
        (u.divisors.card : ℝ) * ((2*u+1).divisors.card : ℝ) := by
    rw [mul_sum]
    apply sum_le_sum
    intro u hu
    have hu0 : u ≠ 0 := Nat.ne_of_gt (hS u hu).1
    let P := (candidatePIndices c L).biUnion (candidatePBand (c*L))
    have hdiv : primePoolFreePart P u ∣ u :=
      ⟨primePoolPart P u, by simpa only [Nat.mul_comm] using
        (primePoolPart_mul_primePoolFreePart P u).symm⟩
    have hcard : ((primePoolFreePart P u).divisors.card : ℝ) ≤ (u.divisors.card : ℝ) := by
      exact_mod_cast card_le_card (Nat.divisors_subset_of_dvd hu0 hdiv)
    have hcU : candidateCoefficient c L q r jStar u ≤ L^K*(u.divisors.card : ℝ) :=
      (hcoeff jStar u).2.trans (mul_le_mul_of_nonneg_left hcard (rpow_nonneg hL0.le _))
    have hinner : (∑ m ∈ (2*u+1).divisors, ‖F u m‖) ≤
        ((2*u+1).divisors.card : ℝ)*L^|A| := by
      calc
        _ ≤ ∑ _m ∈ (2*u+1).divisors, L^|A| := sum_le_sum (fun m hm =>
          (hF u hu m hm).trans (rpow_le_rpow_of_exponent_le hL (le_abs_self A)))
        _ = _ := by simp
    calc
      _ ≤ (L^K*(u.divisors.card : ℝ))*(((2*u+1).divisors.card : ℝ)*L^|A|) :=
        mul_le_mul hcU hinner (sum_nonneg (fun _ _ => norm_nonneg _)) (by positivity)
      _ = _ := by rw [rpow_add hL0]; ring
  calc
    _ ≤ L^(K+|A|) * ∑ u ∈ S,
        (u.divisors.card : ℝ) * ((2*u+1).divisors.card : ℝ) := hsum
    _ ≤ L^(K+|A|)*(exp L*L^(16 : ℝ)) :=
      mul_le_mul_of_nonneg_left hmassS (rpow_nonneg hL0.le _)
    _ = exp L*L^(K+|A|+16) := by rw [rpow_add hL0 (K+|A|) 16]; ring


end Bounty
end

section

/- Exact finite divisor reindexing into the two-equation Type II inner sum. -/

open Finset

namespace Bounty

theorem finite_divisor_product_reindex (M N : Finset ℕ) (α β : ℕ → ℂ)
    (hα : ∀ m, m ∉ M → α m = 0) (hβ : ∀ n, n ∉ N → β n = 0)
    {z : ℕ} (hz : z ≠ 0) :
    (∑ m ∈ z.divisors, α m*β (z/m)) =
      ∑ m ∈ M, ∑ n ∈ N, if m*n=z then α m*β n else 0 := by
  classical
  have hinner (m : ℕ) : (∑ n ∈ N, if m*n=z then α m*β n else 0) =
      if m ∈ z.divisors then α m*β (z/m) else 0 := by
    by_cases hm : m ∈ z.divisors
    · rw [if_pos hm]
      have hd := (Nat.mem_divisors.mp hm).1
      have hm0 : m ≠ 0 := by intro he; subst m; simp_all
      have hmq : m*(z/m)=z := Nat.mul_div_cancel' hd
      rw [sum_eq_single (z/m)]
      · rw [if_pos hmq]
      · intro n hn hneq
        rw [if_neg]
        intro he
        exact hneq (Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero hm0) (he.trans hmq.symm))
      · intro hn
        rw [hβ _ hn,mul_zero]
        simp only [ite_self]
    · rw [if_neg hm]
      apply sum_eq_zero
      intro n hn
      rw [if_neg]
      intro he
      exact hm (Nat.mem_divisors.mpr ⟨⟨n,he.symm⟩,hz⟩)
  simp_rw [hinner]
  rw [← sum_filter]
  have hset : M.filter (fun m => m ∈ z.divisors) = z.divisors.filter (fun m => m ∈ M) := by
    ext m
    simp only [mem_filter,and_comm]
  rw [hset]
  symm
  apply sum_subset (filter_subset _ _)
  intro m hm hn
  have hmM : m ∉ M := by intro h; exact hn (mem_filter.mpr ⟨hm,h⟩)
  rw [hα m hmM,zero_mul]

theorem shifted_divisor_typeII_row (e : ℕ) (M N H : Finset ℕ) (α β aH : ℕ → ℂ)
    (hα : ∀ m, m ∉ M → α m = 0) (hβ : ∀ n, n ∉ N → β n = 0) :
    (∑ h ∈ H, aH h*∑ m ∈ (2*e*h+1).divisors, α m*β ((2*e*h+1)/m)) =
      ∑ n ∈ N, β n*typeIIInnerSum M H α aH e n := by
  classical
  have hre (h : ℕ) : (∑ m ∈ (2*e*h+1).divisors, α m*β ((2*e*h+1)/m)) =
      ∑ m ∈ M, ∑ n ∈ N, if m*n=2*e*h+1 then α m*β n else 0 :=
    finite_divisor_product_reindex M N α β hα hβ (by omega)
  simp_rw [hre, mul_sum]
  calc
    _ = ∑ m ∈ M, ∑ h ∈ H, ∑ n ∈ N, aH h*(if m*n=2*e*h+1 then α m*β n else 0) := sum_comm
    _ = ∑ m ∈ M, ∑ n ∈ N, ∑ h ∈ H, aH h*(if m*n=2*e*h+1 then α m*β n else 0) := by
      apply sum_congr rfl
      intro m hm
      exact sum_comm
    _ = ∑ n ∈ N, ∑ m ∈ M, ∑ h ∈ H, aH h*(if m*n=2*e*h+1 then α m*β n else 0) := sum_comm
    _ = _ := by
      simp only [typeIIInnerSum,sum_product,typeIIEquationTerm,mul_sum]
      apply sum_congr rfl
      intro n hn
      apply sum_congr rfl
      intro m hm
      apply sum_congr rfl
      intro h hh
      split_ifs <;> ring

theorem finite_shifted_divisor_typeII_reindex (E M N H : Finset ℕ) (aE α β aH : ℕ → ℂ)
    (hα : ∀ m, m ∉ M → α m = 0) (hβ : ∀ n, n ∉ N → β n = 0) :
    (∑ e ∈ E, ∑ h ∈ H, aE e*aH h*
      ∑ m ∈ (2*e*h+1).divisors, α m*β ((2*e*h+1)/m)) =
      ∑ e ∈ E, ∑ n ∈ N, aE e*β n*typeIIInnerSum M H α aH e n := by
  apply sum_congr rfl
  intro e he
  have hr := congrArg (fun z : ℂ => aE e*z) (shifted_divisor_typeII_row e M N H α β aH hα hβ)
  simpa only [mul_sum,mul_assoc] using hr

end Bounty
end

section

/- Coarse product masks are removed only under explicit equation-support compatibility. -/

open Finset

namespace Bounty

theorem typeII_inner_coarse_mask_eq (M H S : Finset ℕ) (α aH : ℕ → ℂ) (e n : ℕ)
    (hcompat : ∀ m ∈ M, ∀ h ∈ H, m*n=2*e*h+1 → e*h ∈ S) :
    typeIIInnerSum M H α (fun h => if e*h ∈ S then aH h else 0) e n =
      typeIIInnerSum M H α aH e n := by
  classical
  unfold typeIIInnerSum typeIIEquationTerm
  apply sum_congr rfl
  intro v hv
  obtain ⟨hm,hh⟩ := mem_product.mp hv
  by_cases heq : v.1*n=2*e*v.2+1
  · simp only [heq,if_true,hcompat v.1 hm v.2 hh heq]
  · rw [if_neg heq,if_neg heq]

theorem typeII_equation_coarse_bounds {e h m n : ℕ} {U V R L : ℝ}
    (he : 0 < e) (hh : 0 < h) (hU : 0 ≤ U) (_hV : 0 ≤ V)
    (hm : (m : ℝ) ≤ 2*U) (hn : (n : ℝ) ≤ 2*V)
    (hR : 2*U*V ≤ R*Real.exp L) (heq : m*n=2*e*h+1) :
    e*h ∈ Icc 1 ⌊R*Real.exp L⌋₊ := by
  apply mem_Icc.mpr
  refine ⟨Nat.one_le_iff_ne_zero.mpr (Nat.ne_of_gt (Nat.mul_pos he hh)),?_⟩
  apply Nat.le_floor
  have hprod := mul_le_mul hm hn (Nat.cast_nonneg n) (show 0 ≤ 2*U by positivity)
  have heqR : (m : ℝ)*n=2*e*h+1 := by exact_mod_cast heq
  push_cast
  nlinarith

theorem typeII_inner_full_coarse_box_eq (M H : Finset ℕ) (α aH : ℕ → ℂ)
    {e n : ℕ} {U V R L : ℝ} (he : 0 < e) (hH : ∀ h ∈ H, 0 < h)
    (hU : 0 ≤ U) (hV : 0 ≤ V) (hM : ∀ m ∈ M, (m : ℝ) ≤ 2*U)
    (hn : (n : ℝ) ≤ 2*V) (hR : 2*U*V ≤ R*Real.exp L) :
    typeIIInnerSum M H α (fun h => if e*h ∈ Icc 1 ⌊R*Real.exp L⌋₊ then aH h else 0) e n =
      typeIIInnerSum M H α aH e n := by
  apply typeII_inner_coarse_mask_eq
  intro m hm h hh heq
  exact typeII_equation_coarse_bounds he (hH h hh) hU hV (hM m hm) hn hR heq

end Bounty
end

section

/- The first-derivative exponential-sum test under local calculus hypotheses. -/

open Finset

namespace Bounty

theorem first_derivative_test (f f' : ℝ → ℝ) (a b k : ℤ)
    {δ : ℝ} (hδ : 0 < δ) (hδhalf : δ ≤ 1/2)
    (hf : ∀ x ∈ Set.Icc (a : ℝ) ((b : ℝ)+1), HasDerivAt f (f' x) x)
    (hband : ∀ x ∈ Set.Icc (a : ℝ) ((b : ℝ)+1),
      (k : ℝ)+δ ≤ f' x ∧ f' x ≤ (k : ℝ)+1-δ)
    (hmono : MonotoneOn f' (Set.Icc (a : ℝ) ((b : ℝ)+1)) ∨
      AntitoneOn f' (Set.Icc (a : ℝ) ((b : ℝ)+1))) :
    ‖∑ n ∈ Icc a b, realUnitPhase (f (n : ℝ))‖ ≤ 2/δ := by
  apply integer_first_derivative_sum_bound (fun n => f (n : ℝ)) a b k hδ hδhalf
  · intro n hn
    have hn' : (n : ℝ) ∈ Set.Icc (a : ℝ) (b : ℝ) := by
      obtain ⟨hn0,hn1⟩ := mem_Icc.mp hn
      exact ⟨by exact_mod_cast hn0, by exact_mod_cast hn1⟩
    simpa only [Int.cast_add,Int.cast_one] using first_derivative_unit_increment_bounds hf hband hn'
  · have hc {n : ℤ} (hn : n ∈ Set.Icc a b) : (n : ℝ) ∈ Set.Icc (a : ℝ) (b : ℝ) :=
      ⟨by exact_mod_cast hn.1,by exact_mod_cast hn.2⟩
    rcases hmono with hm | hm
    · left
      intro n hn m hm' hnm
      simpa only [Int.cast_add,Int.cast_one] using
        monotoneOn_unit_increment hf hm (hc hn) (hc hm') (by exact_mod_cast hnm)
    · right
      intro n hn m hm' hnm
      simpa only [Int.cast_add,Int.cast_one] using
        antitoneOn_unit_increment hf hm (hc hn) (hc hm') (by exact_mod_cast hnm)

end Bounty
end

section

/- The second derivative test applied to the actual logarithmic phase. -/

open Finset

namespace Bounty

theorem positive_logarithmic_second_derivative (c U : ℝ) {a b : ℕ}
    (hc : 0 < c) (hU : 1 ≤ U) (hab : a ≤ b)
    (ha : U ≤ (a : ℝ)) (hb : (b : ℝ) ≤ 2*U) :
    ‖∑ n ∈ Icc a b, realUnitPhase (c*Real.log n)‖ ≤
      36*(Real.sqrt c+U/Real.sqrt c) := by
  have hU0 : 0 < U := by linarith
  have hx (x : ℝ) (h : x ∈ Set.Icc (a : ℝ) (b+1)) : U ≤ x ∧ x ≤ 3*U := by
    constructor <;> linarith [h.1,h.2]
  have hlam : 0 < c/(3*U)^2 := by positivity
  have htest := second_derivative_sum_bound_negative
    (f := fun x => c*Real.log x) (f' := fun x => c/x)
    (f'' := fun x => -(c/x^2)) (lam := c/(3*U)^2) (A := 9) hab hlam (by norm_num)
    (fun x h => by
      have hx0 : x ≠ 0 := ne_of_gt (hU0.trans_le (hx x h).1)
      simpa only [div_eq_mul_inv] using (Real.hasDerivAt_log hx0).const_mul c)
    (fun x h => by
      have hx0 : x ≠ 0 := ne_of_gt (hU0.trans_le (hx x h).1)
      simpa only [zero_mul,mul_one,zero_sub,neg_div,id_eq] using
        (hasDerivAt_const x c).fun_div (hasDerivAt_id x) hx0)
    (fun x h => by
      have hx0 : 0 < x := hU0.trans_le (hx x h).1
      have hlo : U^2 ≤ x^2 := by nlinarith [(hx x h).1]
      have hhi : x^2 ≤ (3*U)^2 := by nlinarith [(hx x h).2]
      have h1 := div_le_div_of_nonneg_left hc.le (sq_pos_of_pos hx0) hhi
      have h2 := div_le_div_of_nonneg_left hc.le (sq_pos_of_pos hU0) hlo
      have heq : c/U^2 = 9*(c/(3*U)^2) := by field_simp; ring
      rw [heq] at h2
      constructor <;> linarith)
  have hs : Real.sqrt (c/(3*U)^2) = Real.sqrt c/(3*U) := by
    rw [Real.sqrt_div hc.le,Real.sqrt_sq (by positivity)]
  rw [hs] at htest
  have hN : (b : ℝ)-a+1 ≤ 2*U := by linarith
  have hsc : 0 < Real.sqrt c := Real.sqrt_pos.mpr hc
  have heq : 6*(9*((b : ℝ)-a+1)*(Real.sqrt c/(3*U))+2/(Real.sqrt c/(3*U))) =
      18*((b : ℝ)-a+1)/U*Real.sqrt c+36*U/Real.sqrt c := by
    field_simp
    ring
  rw [heq] at htest
  have hratio : ((b : ℝ)-a+1)/U ≤ 2 := (div_le_iff₀ hU0).mpr (by linarith)
  have hmain : 18*((b : ℝ)-a+1)/U*Real.sqrt c ≤ 36*Real.sqrt c := by
    have := mul_le_mul_of_nonneg_right hratio hsc.le
    calc
      _ = 18*(((b : ℝ)-a+1)/U*Real.sqrt c) := by ring
      _ ≤ 18*(2*Real.sqrt c) := mul_le_mul_of_nonneg_left this (by norm_num)
      _ = _ := by ring
  calc
    _ ≤ _ := htest
    _ ≤ 36*Real.sqrt c+36*U/Real.sqrt c := add_le_add hmain le_rfl
    _ = _ := by ring

end Bounty
end

section

/- The exceptional count for the actual reciprocal polynomial, using
the proved growing moment and its genuine derivative mean square. -/

open Finset MeasureTheory
open scoped Classical

namespace Bounty

theorem prime_exceptional_intervals_moment_bound (s : Finset ℕ)
    (hs : ∀ p ∈ s, Nat.Prime p) (P B : ℝ) (b : s → ℂ)
    (hP : 1 ≤ P) (hB : 0 ≤ B)
    (hband : ∀ p ∈ s, P ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2 * P)
    (hb : ∀ p : s, ‖b p‖ ≤ B) (j N : ℕ)
    (hN : 1 ≤ N) (hPN : (2 * P) ^ j ≤ (N : ℝ))
    (η R : ℝ) (hη : 0 < η) :
    ((primeExceptionalIntervals s b η R).card : ℝ) * (η ^ j) ^ 2 ≤
      3 * (1 + 2 * (1 + Real.log N)) *
        (((2 * (⌈R⌉₊ : ℝ) + 3) + 4 * (N : ℝ) * (1 + Real.log N)) *
          (j.factorial : ℝ) * (2 * B ^ 2 / P) ^ j) := by
  let w : s → ℂ := fun p => b p / (p.val : ℂ)
  let lo : ℝ := -(⌈R⌉₊ : ℝ) - 1
  let hi : ℝ := (⌈R⌉₊ : ℝ) + 2
  let M := (hi - lo) + 4 * (N : ℝ) * (1 + Real.log N)
  let F : ℝ → ℂ := fun t => (primeReciprocalPolynomial s b t) ^ j
  let F' : ℝ → ℂ := fun t => ∑ n ∈ primePolynomialSupport s j,
    (primePolynomialCoefficient s w j n * ((Real.log (n : ℝ) : ℂ) * Complex.I)) *
      Complex.exp (((Real.log (n : ℝ) * t : ℝ) : ℂ) * Complex.I)
  let Q := M * (j.factorial : ℝ) * (2 * B ^ 2 / P) ^ j
  have hab : lo ≤ hi := by
    dsimp only [lo, hi]
    have : (0 : ℝ) ≤ ⌈R⌉₊ := Nat.cast_nonneg _
    linarith
  have hM : 0 ≤ M := prime_polynomial_mean_square_factor_nonneg N hN lo hi hab
  have hbase : (∑ p : s, ‖w p‖ ^ 2) ≤ 2 * B ^ 2 / P := by
    simpa only [w, norm_div, Complex.norm_natCast, div_pow] using
      prime_dyadic_reciprocal_energy_le s P B b hP hB hband hb
  have hbase0 : 0 ≤ ∑ p : s, ‖w p‖ ^ 2 := sum_nonneg (fun _ _ => sq_nonneg _)
  have hP0 : 0 < P := zero_lt_one.trans_le hP
  have hQ : 0 ≤ Q := by dsimp only [Q]; positivity
  have hlog : 0 ≤ Real.log (N : ℝ) := Real.log_natCast_nonneg N
  have hF : ∀ t, HasDerivAt F (F' t) t := by
    intro t
    exact prime_polynomial_power_hasDerivAt s hs w j t
  have hF' : Continuous F' := by dsimp only [F']; fun_prop
  have he : (∫ t in lo..hi, ‖F t‖ ^ 2) ≤ Q := by
    have he0 := prime_polynomial_power_mean_square s hs w (2 * P)
      (fun p hp => (hband p hp).2) j N hN hPN lo hi hab
    refine he0.trans ?_
    exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hbase0 hbase j)
      (mul_nonneg hM (Nat.cast_nonneg _))
  have hd : (∫ t in lo..hi, ‖F' t‖ ^ 2) ≤ (1 + Real.log N) ^ 2 * Q := by
    have hd0 := prime_polynomial_power_derivative_mean_square s hs w (2 * P)
      (fun p hp => (hband p hp).2) j N hN hPN lo hi hab
    have hmul := mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hbase0 hbase j)
      (mul_nonneg (mul_nonneg hM (sq_nonneg (Real.log N))) (Nat.cast_nonneg j.factorial))
    have hd1 : (∫ t in lo..hi, ‖F' t‖ ^ 2) ≤ (Real.log N) ^ 2 * Q :=
      hd0.trans (hmul.trans_eq (by dsimp only [Q]; ring))
    refine hd1.trans (mul_le_mul_of_nonneg_right ?_ hQ)
    nlinarith
  have hout := occupied_unit_intervals_card_energy_le
    (Finset.Icc (-(⌈R⌉₊ : ℤ) - 1) (⌈R⌉₊ : ℤ))
    (primeExceptionalTimes s b η R) F F' hab
    (fun i hi => (prime_exceptional_window_bounds R i hi).1)
    (fun i hi => (prime_exceptional_window_bounds R i hi).2)
    (pow_pos hη j)
    (fun t ht => by
      dsimp only [F]
      rw [norm_pow]
      exact pow_le_pow_left₀ hη.le ht.2.le j)
    hF hF' (by linarith : 0 < 1 + Real.log (N : ℝ)) he hd
  convert hout using 1
  dsimp only [Q, M, hi, lo, primeExceptionalIntervals]
  ring

end Bounty
end

section

/- Absorption of sparse cardinality and coefficient energy in the interval-supremum bound. -/

open scoped BigOperators

namespace Bounty

theorem sparse_dirichlet_interval_log_bound (indices : Finset ℤ)
    (support : Finset ℕ) (c : ℕ → ℂ) (N : ℕ) {a b U E V : ℝ}
    (hU : 0 < U) (hE : 0 ≤ E)
    (hleft : ∀ j ∈ indices, a ≤ (j : ℝ))
    (hright : ∀ j ∈ indices, (j : ℝ) + 1 ≤ b) (hwidth : b - a ≤ N)
    (hkernel : ∀ z : ℝ, |z| ≤ N →
      ‖∑ n ∈ support, Complex.exp ((Real.log (n : ℝ) * z : ℝ) * Complex.I)‖ ≤
        U / (1 + |z|) + E)
    (hcard : (indices.card : ℝ) * E ≤ U)
    (henergy : (∑ n ∈ support, ‖c n‖ ^ 2) ≤ V / U) :
    (∑ j ∈ indices, unitIntervalEnergySup
      (fun t => ∑ n ∈ support, c n * Complex.exp ((Real.log (n : ℝ) * t : ℝ) * Complex.I)) j) ≤
      (10 + 6 * Real.log N) * V := by
  have hlog := Real.log_natCast_nonneg N
  have hcoef : 0 ≤ ∑ n ∈ support, ‖c n‖ ^ 2 := Finset.sum_nonneg (fun _ _ => sq_nonneg _)
  calc
    _ ≤ (3 * U * (1 + 2 * (1 + Real.log N)) + (indices.card : ℝ) * E) *
        ∑ n ∈ support, ‖c n‖ ^ 2 :=
      sparse_dirichlet_unit_interval_suprema indices support c N hU.le hE hleft hright hwidth hkernel
    _ ≤ (3 * U * (1 + 2 * (1 + Real.log N)) + U) * ∑ n ∈ support, ‖c n‖ ^ 2 :=
      mul_le_mul_of_nonneg_right (add_le_add le_rfl hcard) hcoef
    _ ≤ (3 * U * (1 + 2 * (1 + Real.log N)) + U) * (V / U) :=
      mul_le_mul_of_nonneg_left henergy (by positivity)
    _ = _ := by field_simp; ring

end Bounty
end

section

open Finset

namespace Bounty

theorem mixed_logarithmic_sum_bound
    (hs : List ℝ) (q a u lo hi : ℝ) (l r : ℕ)
    (hq : 0 < q) (hu : u ≠ 0) (hlr : l ≤ r)
    (hhs : ∀ h ∈ hs, 0 < h) (hlo : 0 < lo) (hlohi : lo ≤ hi)
    (hbox : ∀ x ∈ Set.Icc (l:ℝ) ((r:ℝ)+1),
      lo ≤ x+a/q ∧ x+a/q+hs.sum ≤ hi) :
    let d := hs.length+2
    let lam := hs.prod * |u| * ((hs.length+1).factorial:ℝ) / hi^d
    let A := (hi/lo)^d
    ‖∑ n ∈ Icc l r, realUnitPhase
      (mixedForwardDifference hs (fun y => u * Real.log (q*y+a)) (n:ℝ))‖ ≤
      6*(A*((r:ℝ)-l+1)*Real.sqrt lam+2/Real.sqrt lam) := by
  dsimp only
  let lam := hs.prod * |u| * ((hs.length+1).factorial:ℝ) / hi^(hs.length+2)
  let A := (hi/lo)^(hs.length+2)
  have hhi : 0 < hi := lt_of_lt_of_le hlo hlohi
  have hprod : 0 < hs.prod := List.prod_pos hhs
  have hlam : 0 < lam := by dsimp only [lam]; positivity
  have hA : 1 ≤ A := by
    apply one_le_pow₀
    exact (le_div_iff₀ hlo).mpr (by simpa using hlohi)
  have hhs0 : ∀ h ∈ hs, 0 ≤ h := fun h hh => (hhs h hh).le
  have hcurv : hs.prod * |u| * ((1+hs.length).factorial:ℝ) /
        lo^(1+hs.length+1) = A*lam := by
    have hd : 1+hs.length+1 = hs.length+2 := by omega
    have hf : 1+hs.length = hs.length+1 := by omega
    rw [hd, hf]
    dsimp only [A, lam]
    rw [div_pow]
    field_simp
  have hcurvlow : hs.prod * |u| * ((1+hs.length).factorial:ℝ) /
        hi^(1+hs.length+1) = lam := by
    have hd : 1+hs.length+1 = hs.length+2 := by omega
    rw [hd, Nat.add_comm 1 hs.length]
  have hf : ∀ x ∈ Set.Icc (l:ℝ) ((r:ℝ)+1),
      HasDerivAt (mixedForwardDifference hs (fun y => u*Real.log (q*y+a)))
        (mixedForwardDifference hs (logarithmicDerivativeChain u (a/q) 1) x) x := by
    intro x hx
    exact (mixed_affine_logarithmic_phase_derivatives hs q a u x hq hhs0
      (lt_of_lt_of_le hlo (hbox x hx).1)).1
  have hf' : ∀ x ∈ Set.Icc (l:ℝ) ((r:ℝ)+1),
      HasDerivAt (mixedForwardDifference hs (logarithmicDerivativeChain u (a/q) 1))
        (mixedForwardDifference hs (logarithmicDerivativeChain u (a/q) 2) x) x := by
    intro x hx
    exact (mixed_affine_logarithmic_phase_derivatives hs q a u x hq hhs0
      (lt_of_lt_of_le hlo (hbox x hx).1)).2
  rcases le_total 0 (u*(-1:ℝ)^(1+hs.length)) with hp | hn
  · apply second_derivative_sum_bound hlr hlam hA hf hf'
    intro x hx
    have hb := mixed_logarithmic_difference_positive_bounds_on_box hs u (a/q) 1 x lo hi
      hhs0 hlo (hbox x hx).1 (hbox x hx).2 hp
    rwa [hcurv, hcurvlow] at hb
  · apply second_derivative_sum_bound_negative hlr hlam hA hf hf'
    intro x hx
    have hb := mixed_logarithmic_difference_negative_bounds_on_box hs u (a/q) 1 x lo hi
      hhs0 hlo (hbox x hx).1 (hbox x hx).2 hn
    rw [hcurv, hcurvlow] at hb
    simpa only [neg_mul] using hb

end Bounty
end

