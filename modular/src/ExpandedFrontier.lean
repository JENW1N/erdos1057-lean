    let W : CleanFullMemoryState P J ell fullB → ℝ := productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (b g)) (fun g z => ν g z.1)
    let Tclean := fun (d : PhysicalSharedLists Ps J)
