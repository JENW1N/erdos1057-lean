/- Mixed big paths are the original physical big paths with multiplier k times the small shared product. -/

open scoped Classical
namespace Bounty
section Physical
variable {S K V : Type*} [Fintype S] {N J ell : ℕ}
  {Ps : S → Finset ℕ} {P : Fin N → Finset ℕ}
  (hPs : ∀ s p, p ∈ Ps s → Nat.Prime p)
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : ∀ s g, Disjoint (Ps s) (P g))
  (C : K → Fin N → Finset (Fin J)) (d : K → PhysicalSharedLists Ps J)
  (k : K → ℤ) (B : ℕ)

noncomputable def physicalMixedEffectiveBigPathEquiv (steps : List (Option (V ⊕ K)))
    (x : ProductBoundedOrderedState (fun g => ↥(P g))
      (fun g => UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) (fun _ => J + ell) B) :
    FullPermutationMixedPath (fun g (p : ↥(P g)) => p.val)
      (fun key g => physicalFullSharedIndices (ell := ell) (C key g)) B
      (fun key _ => PhysicalAuxLabels P (C key))
      (fun key => physicalMixedEdgeDelta (C key) (k key) (d key))
      (fun key => physicalMixedEdgeD (C key) (d key)) steps x ≃
    FullPermutationMixedPath (fun g (p : ↥(P g)) => p.val)
      (fun key g => physicalFullSharedIndices (ell := ell) (C key g)) B
      (fun key _ => PhysicalAuxLabels P (C key))
      (fun key => physicalFullEdgeDelta (C key) (k key * (physicalSharedProduct (d key) : ℕ)))
      (fun key => physicalFullEdgeD (C key)) steps x :=
  fullPermutationParameterPathEquiv _ _ B _ _ _ _ _
    (fun key => funext fun c => funext fun a => funext fun g =>
      physical_mixed_delta_effective_big_step (C key) (d key) (k key) c a g)
    (fun key c a g p => physical_mixed_dilation_divisibility hPs hP hdis (C key) (d key) c a g p)
    steps x

variable [∀ g, ∀ p : ↥(P g), NeZero p.val]

theorem physical_mixed_effective_big_path_action
    (ω : ∀ key, SharedActiveLabels (fun g => ↥(P g))
      (fun g => physicalFullSharedIndices (ell := ell) (C key g)) → PhysicalAuxLabels P (C key) → ℝ)
    (μ : ∀ g, ↥(P g) → ℝ) (q : V → ℝ) (ρ : ℝ) (Vb : Fin N → ℝ)
    (steps : List (Option (V ⊕ K)))
    (phase : ∀ x, FullPermutationMixedPath (fun g (p : ↥(P g)) => p.val)
      (fun key g => physicalFullSharedIndices (ell := ell) (C key g)) B
      (fun key _ => PhysicalAuxLabels P (C key))
      (fun key => physicalMixedEdgeDelta (C key) (k key) (d key))
      (fun key => physicalMixedEdgeD (C key) (d key)) steps x → ℂ)
    (f : ProductBoundedOrderedState (fun g => ↥(P g))
      (fun g => UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) (fun _ => J + ell) B → ℂ) :
    fullPermutationMixedPathAction (fun g (p : ↥(P g)) => p.val)
      (fun key g => physicalFullSharedIndices (ell := ell) (C key g)) B
      (fun key _ => PhysicalAuxLabels P (C key))
      (fun key => physicalMixedEdgeDelta (C key) (k key) (d key))
      (fun key => physicalMixedEdgeD (C key) (d key)) ω μ q ρ Vb steps phase f =
    fullPermutationMixedPathAction (fun g (p : ↥(P g)) => p.val)
      (fun key g => physicalFullSharedIndices (ell := ell) (C key g)) B
      (fun key _ => PhysicalAuxLabels P (C key))
      (fun key => physicalFullEdgeDelta (C key) (k key * (physicalSharedProduct (d key) : ℕ)))
      (fun key => physicalFullEdgeD (C key)) ω μ q ρ Vb steps
      (fun x p => phase x ((physicalMixedEffectiveBigPathEquiv hPs hP hdis C d k B steps x).symm p)) f :=
  full_permutation_parameter_path_action _ _ B _ _ _ _ _
    (fun key => funext fun c => funext fun a => funext fun g =>
      physical_mixed_delta_effective_big_step (C key) (d key) (k key) c a g)
    (fun key c a g p => physical_mixed_dilation_divisibility hPs hP hdis (C key) (d key) c a g p)
    ω μ q ρ Vb steps phase f

end Physical
