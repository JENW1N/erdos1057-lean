section

/- Algebraic normalization of the pair main term and its exponentially small remainder. -/

namespace Bounty

theorem pair_main_term_normalization {L θ K B C X V U P H A : ℝ}
    (hL : 0 < L) (hθ : 0 < θ) (hK : 0 ≤ K) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hX : 0 ≤ X) (hU : 0 ≤ U) (hA : 0 ≤ A)
    (harea : X ≤ B*Real.exp L) (hUbound : U ≤ 1/(θ*L))
    (hmass : P*H ≤ C*(L/Real.exp L)*A) :
    K*X*V^2*U*P*H ≤ (K*B*C/θ)*A*V^2 := by
  calc
    _ = (K*X*V^2*U)*(P*H) := by ring
    _ ≤ (K*X*V^2*U)*(C*(L/Real.exp L)*A) :=
      mul_le_mul_of_nonneg_left hmass (by positivity)
    _ ≤ (K*(B*Real.exp L)*V^2*U)*(C*(L/Real.exp L)*A) := by
      gcongr
    _ ≤ (K*(B*Real.exp L)*V^2*(1/(θ*L)))*(C*(L/Real.exp L)*A) := by
      gcongr
    _ = _ := by field_simp

theorem pair_error_term_normalization {L C H A E R : ℝ}
    (_hL : 0 < L) (_hC : 0 ≤ C) (hH : 0 ≤ H) (hA : 0 ≤ A)
    (hE : E ≤ 3*Real.exp ((69/100 : ℝ)*L))
    (hmass : H ≤ C*(L/Real.exp L)*A)
    (hprofile : (3*C)*L*Real.exp (-(31/100 : ℝ)*L) ≤ R) : E*H ≤ A*R := by
  calc
    _ ≤ (3*Real.exp ((69/100 : ℝ)*L))*H := mul_le_mul_of_nonneg_right hE hH
    _ ≤ (3*Real.exp ((69/100 : ℝ)*L))*(C*(L/Real.exp L)*A) :=
      mul_le_mul_of_nonneg_left hmass (by positivity)
    _ = ((3*C)*L*Real.exp (-(31/100 : ℝ)*L))*A := by
      have he : Real.exp ((69/100 : ℝ)*L) / Real.exp L = Real.exp (-(31/100 : ℝ)*L) := by
        rw [← Real.exp_sub]
        congr 1
        ring
      calc
        _ = ((3*C)*L*(Real.exp ((69/100 : ℝ)*L)/Real.exp L))*A := by ring
        _ = _ := by rw [he]
    _ ≤ R*A := mul_le_mul_of_nonneg_right hprofile hA
    _ = _ := mul_comm _ _

end Bounty
end

