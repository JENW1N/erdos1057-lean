section

/- The actual phased mixed action retains both small endpoints and all big event choices. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_mixed_phased_bare_expansion
    {S X : Type*} [Fintype S] {P : S → Finset ℕ} {J ell : ℕ}
    (V : S → ℝ) (q : ℝ)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (E : PhysicalSharedLists P J → X → Type*) [∀ d x, Fintype (E d x)]
    (target : ∀ d x, E d x → X)
    (a : PhysicalResidues P → ∀ d x, E d x → ℝ) (k : X → ℤ)
    (Φ : ∀ s : PhysicalSmallBigState P J ell X, PhysicalSmallBigEvent E s → ℂ)
    (F : PhysicalSmallBigState P J ell X → ℂ)
    (r : PhysicalResidues P) (L : PhysicalMarkLists P J ell) (x : X) :
    physicalSmallBigPhasedAction V q E target a k Φ F ((r, L), x) =
      ∑ R : PhysicalMarkLists P J ell, ∑ e : E (physicalSharedPrefix L) x,
        physicalBarePatternScalar V (fun _ => (∅ : Finset (Fin J))) 0
          (fun _ _ _ => 1) aux L R *
        ((physicalResidueVertexWeight L (Real.sqrt q) r *
          physicalResidueVertexWeight R (Real.sqrt q)
            (physicalTranslateResidues r (k x * (physicalSharedProduct (physicalSharedPrefix L) : ℕ))) : ℝ) : ℂ) *
        (a r (physicalSharedPrefix L) x e : ℂ) * Φ ((r, L), x) (R, e) *
        F ((physicalTranslateResidues r (k x * (physicalSharedProduct (physicalSharedPrefix L) : ℕ)), R),
          target (physicalSharedPrefix L) x e) := by
  unfold physicalSmallBigPhasedAction
  rw [Fintype.sum_prod_type]
  apply sum_congr rfl
  intro R hR
  apply sum_congr rfl
  intro e he
  rw [physical_bare_empty_prefix V 0 aux (fun _ => 1) L R]
  simp only [physicalSmallBigPositiveWeight, physicalSmallBigTarget,
    physical_phase_zero_frequency, mul_one]
  split_ifs <;> push_cast <;> ring

theorem physical_mixed_full_phased_bare_expansion
    {S G : Type*} [Fintype S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
    (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (kbig : SharedActiveLabels P shared → ℤ) (Vs : S → ℝ) (q : ℝ)
    (aux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))))
    (Φ : ∀ s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B),
      PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B Δ D) s → ℂ)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (r : PhysicalResidues Ps) (L : PhysicalMarkLists Ps J ell)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q Φ F ((r, L), x) =
      ∑ R : PhysicalMarkLists Ps J ell, ∑ e : PhysicalSmallBigFullEvent n shared B Δ D (physicalSharedPrefix L) x,
        physicalBarePatternScalar Vs (fun _ => (∅ : Finset (Fin J))) 0
          (fun _ _ _ => 1) aux L R *
        ((physicalResidueVertexWeight L (Real.sqrt q) r *
          physicalResidueVertexWeight R (Real.sqrt q)
            (physicalTranslateResidues r
              (kbig (productActiveMemorySplit shared B x).1 * (physicalSharedProduct (physicalSharedPrefix L) : ℕ))) : ℝ) : ℂ) *
        (physicalSmallBigFullWeight n shared B Δ D μ ρ V r (physicalSharedPrefix L) x e : ℂ) *
        Φ ((r, L), x) (R, e) *
        F ((physicalTranslateResidues r
          (kbig (productActiveMemorySplit shared B x).1 * (physicalSharedProduct (physicalSharedPrefix L) : ℕ)), R),
          physicalSmallBigFullTarget n shared B Δ D (physicalSharedPrefix L) x e) :=
  physical_mixed_phased_bare_expansion Vs q aux _ _ _ _ Φ F r L x

end Bounty
end

section

/- The mixed small residue moves by the full original physical displacement. -/

open scoped Classical
namespace Bounty

theorem physical_mixed_original_small_translation
    {G I : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    (small : G → Prop) {patterns : Finset I} (C : I → G → Finset (Fin J))
    (k : I → ℤ) (a : PhysicalEdgeLabels P J ell patterns C)
    (L : PhysicalMarkLists P J ell)
    (hC : ∀ g, small g → C a.2.2.1.val g = ∅)
    (r : PhysicalResidues (fun g : {g // small g} => P g.val)) :
    physicalTranslateResidues r (physicalBareStep C k a L) =
      physicalTranslateResidues r
        ((k a.2.2.1.val *
          (physicalD (fun g : {g // ¬small g} => C a.2.2.1.val g.val)
            (fun g => physicalPermuteLabels a.1 L g.val) (fun g => a.2.2.2 g.val) : ℕ)) *
          (physicalSharedProduct (physicalSharedPrefix
            (fun g : {g // small g} => physicalPermuteLabels a.1 L g.val)) : ℕ)) := by
  congr 1
  rw [physical_fixed_edge_displacement_split small,
    physical_D_empty_cut (fun g : {g // small g} => C a.2.2.1.val g.val)
      (fun g => hC g.val g.property)]
  ring

theorem physical_mixed_target_original_residue
    {G I X : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    (small : G → Prop) {patterns : Finset I} (C : I → G → Finset (Fin J))
    (k : I → ℤ) (a : PhysicalEdgeLabels P J ell patterns C)
    (L : PhysicalMarkLists P J ell)
    (hC : ∀ g, small g → C a.2.2.1.val g = ∅)
    (E : PhysicalSharedLists (fun g : {g // small g} => P g.val) J → X → Type*)
    (target : ∀ d x, E d x → X)
    (r : PhysicalResidues (fun g : {g // small g} => P g.val)) (x : X)
    (e : PhysicalSmallBigEvent E ((r,
      (fun g : {g // small g} => physicalPermuteLabels a.1 L g.val)), x)) :
    (physicalSmallBigTarget E target
      (fun _ => k a.2.2.1.val *
        (physicalD (fun g : {g // ¬small g} => C a.2.2.1.val g.val)
          (fun g => physicalPermuteLabels a.1 L g.val) (fun g => a.2.2.2 g.val) : ℕ))
      ((r, (fun g : {g // small g} => physicalPermuteLabels a.1 L g.val)), x) e).1.1 =
      physicalTranslateResidues r (physicalBareStep C k a L) := by
  exact (physical_mixed_original_small_translation small C k a L hC r).symm

end Bounty
end

section

/- The actual candidate-pool mixed promotion estimate. The scalar omission
probability and all per-choice operator bounds are discharged. A fixed
auxiliary draw is absorbed into the arbitrary retained-big-label factor. -/

open Finset Filter
open scoped Classical Topology

namespace Bounty

theorem eventually_candidate_mixed_promotion_energy_le
    {q vs scale : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hvs : 0 < vs) (hscale : 0 < scale)
    (ell : ℕ) (C₂ : ℝ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ᶠ L : ℝ in atTop,
      letI : DecidableEq (CandidateSmallGroup scale L) := Classical.decEq _
      letI : DecidableEq (CandidateBigGroup scale L) := Classical.decEq _
      letI : ∀ p : PhysicalPrime (candidateSmallPool scale L), NeZero p.2.val :=
        candidateSmallPrimeNeZero scale L
      letI : ∀ g p, NeZero (candidateBigModulus scale L g p) := candidateBigModulusNeZero scale L
      ∀ J B : ℕ,
      letI : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
      ∀ M : CandidateBigGroup scale L → ℕ,
      ∀ shared : ∀ g, Finset (Fin (M g)),
      ∀ D_B : SharedActiveLabels (CandidateBigLabel scale L) shared → ℕ,
      ∀ k : ℤ, k ≠ 0 → (k.natAbs : ℝ) ≤ L ^ C₂ →
      ∀ Vs : CandidateSmallGroup scale L → ℝ, (∀ g, vs ≤ Vs g) →
      ∀ μ : ∀ g, CandidateBigLabel scale L g → ℝ, ∀ ρ : ℝ,
      ∀ V : CandidateBigGroup scale L → ℝ,
      ∀ v vmin vmax : ℝ, 0 < ρ → ρ < 1 → 1 < v → 0 < vmin →
      (∀ g, vmin ≤ V g) → (∀ g, V g ≤ vmax) →
      (∀ g p, 0 ≤ μ g p) → (∀ g, ∑ p, μ g p ≤ 2) →
      ∀ T : ℕ, (∀ g, (shared g)ᶜ.card ≤ T) →
      ∀ Φ : ∀ s : PhysicalSmallBigState (candidateSmallPool scale L) J ell
        (ProductBoundedOrderedState (CandidateBigLabel scale L)
          (fun g => UnrestrictedResidueParticle (candidateBigModulus scale L g)) M B),
        PhysicalSmallBigEvent (PhysicalSmallBigFullEvent (candidateBigModulus scale L) shared B
          (fun d c _ => -(k * (D_B c * physicalSharedProduct d : ℕ)))
          (fun d c _ => (D_B c * physicalSharedProduct d : ℕ))) s → ℂ,
      ∀ H : ℝ, 0 ≤ H → (∀ s e, ‖Φ s e‖ ≤ H) →
      ∀ F : PhysicalSmallBigState (candidateSmallPool scale L) J ell
        (ProductBoundedOrderedState (CandidateBigLabel scale L)
          (fun g => UnrestrictedResidueParticle (candidateBigModulus scale L g)) M B) → ℂ,
      (∀ s, ProductMemorySymmetric (fun x => F (s, x))) →
      physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
        (physicalSmallBigAverage (fun s =>
          physicalSmallBigFullPhasedAction (candidateBigModulus scale L) shared B
            (fun d c _ => -(k * (D_B c * physicalSharedProduct d : ℕ)))
            (fun d c _ => (D_B c * physicalSharedProduct d : ℕ)) μ ρ V
            (fun c => k * D_B c) Vs q
            (fun y e => if ∃ g, (e.2.2 g).2.1.Nonempty then Φ y e else 0) F s)) ≤
      ((B : ℝ) / (((J + ell).choose ell) ^ (candidateSmallPIndices scale L).card : ℕ)) *
        (H ^ 2 * (A ^ (2 * (candidateSmallPIndices scale L).card) *
          unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ (candidateBigPIndices scale L).card)) *
        physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) F := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_small_big_promotion_average_energy_bound hq0 hq1 hvs ell
  refine ⟨A, hA, ?_⟩
  filter_upwards [eventually_candidate_mixed_eligibility_probability_le hscale ell C₂] with L hL
  let _ : DecidableEq (CandidateSmallGroup scale L) := Classical.decEq _
  let _ : DecidableEq (CandidateBigGroup scale L) := Classical.decEq _
  let _ : ∀ p : PhysicalPrime (candidateSmallPool scale L), NeZero p.2.val := candidateSmallPrimeNeZero scale L
  let _ : ∀ g p, NeZero (candidateBigModulus scale L g p) := candidateBigModulusNeZero scale L
  intro J B
  let _ : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
  intro M shared D_B k hk hkbound Vs hVs μ ρ V v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi
    hμ hmass T ht Φ H hH hΦ F hF
  let aux : PhysicalAuxLabels (candidateSmallPool scale L) (fun _ => (∅ : Finset (Fin J))) :=
    fun _ j => False.elim ((Finset.notMem_empty j.val) j.property)
  let π : PhysicalPermutations (CandidateSmallGroup scale L) J ell → ℝ :=
    fun _ => 1 / (Fintype.card (PhysicalPermutations (CandidateSmallGroup scale L) J ell) : ℝ)
  have hπ : ∀ σ, 0 ≤ π σ := fun _ => one_div_nonneg.mpr (Nat.cast_nonneg _)
  have hπmass : ∑ σ, π σ ≤ 1 := by
    simp only [π, sum_const, card_univ, nsmul_eq_mul, mul_one_div]
    exact div_self_le_one _
  have h := hbound (CandidateSmallGroup scale L) (CandidateBigGroup scale L)
    (PhysicalPermutations (CandidateSmallGroup scale L) J ell)
    (candidateSmallPool scale L) (CandidateBigLabel scale L) (candidateBigModulus scale L)
    J M shared B
    (fun _ d c _ => -(k * (D_B c * physicalSharedProduct d : ℕ)))
    (fun _ d c _ => (D_B c * physicalSharedProduct d : ℕ)) μ ρ V (fun _ c => k * D_B c)
    Vs hVs aux v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht π hπ hπmass
    (fun σ => σ) (fun s => productTotalMemory s.2 ≤ B) (fun _ => Φ) H hH (fun _ => hΦ)
    ((B : ℝ) / (((J + ell).choose ell) ^ (candidateSmallPIndices scale L).card : ℕ))
    (div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _))
    (fun s hs => hL J B M shared D_B k hk hkbound s hs) F hF
  have he : physicalSmallBigAverage (fun s =>
      physicalSmallBigFullPhasedAction (candidateBigModulus scale L) shared B
        (fun d c _ => -(k * (D_B c * physicalSharedProduct d : ℕ)))
        (fun d c _ => (D_B c * physicalSharedProduct d : ℕ)) μ ρ V (fun c => k * D_B c) Vs q
        (fun y e => if ∃ g, (e.2.2 g).2.1.Nonempty then Φ y e else 0) F s) =
    (fun s => ∑ σ, (π σ : ℂ) * (if productTotalMemory s.2 ≤ B then
      physicalSmallBigFullPhasedAction (candidateBigModulus scale L) shared B
        (fun d c _ => -(k * (D_B c * physicalSharedProduct d : ℕ)))
        (fun d c _ => (D_B c * physicalSharedProduct d : ℕ)) μ ρ V (fun c => k * D_B c) Vs q
        (fun y e => if ∃ g, (e.2.2 g).2.1.Nonempty then Φ y e else 0) F
        (physicalSmallBigPermutation σ s) else 0)) := by
    funext s
    rw [physical_small_big_average_uniform (inferInstance)]
    apply sum_congr rfl
    intro σ _
    apply congrArg (fun z : ℂ => (π σ : ℂ) * z)
    exact physical_small_big_full_phased_source_cap (candidateBigModulus scale L) shared B
      _ _ μ ρ V (fun c => k * D_B c) Vs q _ F (physicalSmallBigPermutation σ s)
  rw [he]
  simpa only [CandidateSmallGroup, CandidateBigGroup, Fintype.card_coe] using h

end Bounty
end

section

/- Candidate omission rarity in the reversed big-residue direction. -/

open Finset Filter
open scoped Classical Topology

namespace Bounty

theorem eventually_candidate_mixed_reverse_eligibility_probability_le
    {scale : ℝ} (hscale : 0 < scale) (ell : ℕ) (C₂ : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ J B : ℕ,
      ∀ M : ↥(candidateBigPIndices scale L) → ℕ,
      ∀ shared : ∀ g, Finset (Fin (M g)),
      ∀ D_B : SharedActiveLabels
        (fun g : ↥(candidateBigPIndices scale L) => ↥(candidatePBand (scale * L) g.val)) shared → ℕ,
      ∀ k : ℤ, k ≠ 0 → (k.natAbs : ℝ) ≤ L ^ C₂ →
      ∀ s : PhysicalSmallBigState
        (fun g : ↥(candidateSmallPIndices scale L) => candidatePBand (scale * L) g.val) J ell
        (ProductBoundedOrderedState
          (fun g : ↥(candidateBigPIndices scale L) => ↥(candidatePBand (scale * L) g.val))
          (fun g => UnrestrictedResidueParticle (fun p : ↥(candidatePBand (scale * L) g.val) => p.val)) M B),
      productTotalMemory s.2 ≤ B →
      letI : DecidableEq ↥(candidateSmallPIndices scale L) := Classical.decEq _
      letI : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
      (∑ σ : PhysicalPermutations ↥(candidateSmallPIndices scale L) J ell,
        if physicalSmallBigEligible
          (fun (g : ↥(candidateBigPIndices scale L)) (p : ↥(candidatePBand (scale * L) g.val)) => p.val)
          shared B (fun d c _ => -(-(k * (D_B c * physicalSharedProduct d : ℕ))))
          (fun d c _ => (D_B c * physicalSharedProduct d : ℕ))
          (physicalSmallBigPermutation σ s)
        then 1 / (Fintype.card (PhysicalPermutations ↥(candidateSmallPIndices scale L) J ell) : ℝ)
        else 0) ≤ (B : ℝ) / (((J + ell).choose ell) ^ (candidateSmallPIndices scale L).card : ℕ) := by
  filter_upwards [eventually_candidate_mixed_eligibility_probability_le hscale ell C₂] with L hL
  intro J B M shared D_B k hk hkbound s hB
  let _ : DecidableEq ↥(candidateSmallPIndices scale L) := Classical.decEq _
  let _ : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
  have he : (fun (d : PhysicalSharedLists
      (fun g : ↥(candidateSmallPIndices scale L) => candidatePBand (scale * L) g.val) J)
      (c : SharedActiveLabels
        (fun g : ↥(candidateBigPIndices scale L) => ↥(candidatePBand (scale * L) g.val)) shared)
      (_ : ↥(candidateBigPIndices scale L)) => -(-(k * (D_B c * physicalSharedProduct d : ℕ)))) =
      (fun d c _ => -((-k) * (D_B c * physicalSharedProduct d : ℕ))) := by
    funext d c g
    ring
  rw [he]
  exact hL J B M shared D_B (-k) (neg_ne_zero.mpr hk)
    (by simpa only [Int.natAbs_neg] using hkbound) s hB

end Bounty
end

section

/- Concrete mixed edge parameters retain the full small-times-big divisor. -/

open scoped Classical
namespace Bounty
section Parameters
variable {S G : Type*} [Fintype S] [Fintype G]
  {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell : ℕ}
  (C : G → Finset (Fin J))

noncomputable def physicalMixedSharedD (d : PhysicalSharedLists Ps J)
    (c : SharedActiveLabels (fun g => ↥(P g))
      (fun g => physicalFullSharedIndices (ell := ell) (C g)))
    (aux : PhysicalAuxLabels P C) : ℕ :=
  physicalSharedProduct d * physicalFullSharedD C c aux

noncomputable def physicalMixedEdgeD (d : PhysicalSharedLists Ps J)
    (c : SharedActiveLabels (fun g => ↥(P g))
      (fun g => physicalFullSharedIndices (ell := ell) (C g)))
    (aux : PhysicalAuxLabels P C) (_g : G) : ℤ := physicalMixedSharedD C d c aux

noncomputable def physicalMixedEdgeDelta (k : ℤ) (d : PhysicalSharedLists Ps J)
    (c : SharedActiveLabels (fun g => ↥(P g))
      (fun g => physicalFullSharedIndices (ell := ell) (C g)))
    (aux : PhysicalAuxLabels P C) (g : G) : ℤ := -k * physicalMixedEdgeD C d c aux g

end Parameters
section BigStep
variable {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
  (C : G → Finset (Fin J))

noncomputable def physicalMixedBigStep (k : ℤ)
    (c : SharedActiveLabels (fun g => ↥(P g))
      (fun g => physicalFullSharedIndices (ell := ell) (C g)))
    (aux : PhysicalAuxLabels P C) : ℤ := k * (physicalFullSharedD C c aux : ℕ)

end BigStep
section Encoded
variable {S G : Type*} [Fintype S] [Fintype G]
  {Ps : S → Finset ℕ} {P : G → Finset ℕ} {Z : G → Type*} {J ell B : ℕ}
  (C : G → Finset (Fin J)) (d : PhysicalSharedLists Ps J)
  (L : PhysicalMarkLists P J ell) (q : ∀ g, BoundedOrderedTuple (Z g) B)
  (aux : PhysicalAuxLabels P C)

theorem physical_mixed_shared_D_at_state :
    physicalMixedSharedD C d
      (productActiveMemorySplit (fun g => physicalFullSharedIndices (C g)) B
        (physicalFullMemoryState C L q)).1 aux =
      physicalSharedProduct d * physicalD C L aux := by
  rw [physicalMixedSharedD, physical_full_shared_D_eq]

theorem physical_mixed_edge_D_at_state (g : G) :
    physicalMixedEdgeD C d
      (productActiveMemorySplit (fun g => physicalFullSharedIndices (C g)) B
        (physicalFullMemoryState C L q)).1 aux g =
      (physicalSharedProduct d * physicalD C L aux : ℕ) := by
  rw [physicalMixedEdgeD, physical_mixed_shared_D_at_state]

theorem physical_mixed_edge_delta_at_state (k : ℤ) (g : G) :
    physicalMixedEdgeDelta C k d
      (productActiveMemorySplit (fun g => physicalFullSharedIndices (C g)) B
        (physicalFullMemoryState C L q)).1 aux g =
      -k * (physicalSharedProduct d * physicalD C L aux : ℕ) := by
  rw [physicalMixedEdgeDelta, physical_mixed_edge_D_at_state]

theorem physical_mixed_big_step_at_state (k : ℤ) :
    physicalMixedBigStep C k
      (productActiveMemorySplit (fun g => physicalFullSharedIndices (C g)) B
        (physicalFullMemoryState C L q)).1 aux = k * (physicalD C L aux : ℕ) := by
  rw [physicalMixedBigStep, physical_full_shared_D_eq]

theorem physical_mixed_step_times_small (k : ℤ) :
    physicalMixedBigStep C k
      (productActiveMemorySplit (fun g => physicalFullSharedIndices (C g)) B
        (physicalFullMemoryState C L q)).1 aux * (physicalSharedProduct d : ℕ) =
      k * (physicalMixedSharedD C d
        (productActiveMemorySplit (fun g => physicalFullSharedIndices (C g)) B
          (physicalFullMemoryState C L q)).1 aux : ℕ) := by
  rw [physical_mixed_big_step_at_state, physical_mixed_shared_D_at_state, Nat.cast_mul]
  ring

end Encoded
end Bounty
end

section

/- Positive mixed edges preserve permutation symmetry of the pending big
memory, including the small completion and its translated residue coordinate. -/

open Finset Classical

namespace Bounty

theorem full_active_external_positive_symmetric
    {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    {M : G → ℕ} (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : SharedActiveLabels P shared → Type*) [∀ c, Fintype (A c)]
    (Δ D : ∀ c, A c → G → ℤ) (ω : ∀ c, A c → ℝ)
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    {R : Type*} (τ : ∀ c, A c → R ≃ R)
    (F : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → R → ℂ)
    (hF : ∀ r, ProductMemorySymmetric (fun x => F x r)) :
    ∀ r, ProductMemorySymmetric (fun x =>
      fullActiveExternalPositiveAction n shared B A Δ D ω μ ρ V τ F x r) := by
  apply full_active_external_fiber_average_symmetric shared B ω _ τ _ F hF
  intro c a f hf
  rw [unrestricted_coupled_positive_cutoff_eq_product]
  exact unrestricted_positive_cutoff_product_symmetric n (Δ c a) (D c a) μ ρ V
    (fun g => (shared g)ᶜ.card) B univ f hf

theorem physical_small_big_full_positive_memory_symmetric
    {S G : Type*} [Fintype S] [DecidableEq S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    {J ell : ℕ} {M : G → ℕ} (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (kbig : SharedActiveLabels P shared → ℤ) (Vs : S → ℝ) (q : ℝ)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (hF : ∀ s, ProductMemorySymmetric (fun x => F (s, x))) :
    ∀ s, ProductMemorySymmetric (fun x =>
      physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q (fun _ _ => 1) F (s, x)) := by
  let aux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))) :=
    fun _ j => False.elim (notMem_empty j.val j.property)
  rw [← physical_small_big_full_positive_eq n shared B Δ D μ ρ V kbig Vs q aux F]
  rintro ⟨r, L⟩ x g σ
  dsimp only
  rw [physical_small_big_action_completion, physical_small_big_action_completion,
    physical_small_big_full_prefix_eq, physical_small_big_full_prefix_eq,
    ← full_active_external_positive_eq_sum, ← full_active_external_positive_eq_sum]
  apply congrArg
    (fun z : ℂ => ((physicalCompletionMass Vs (fun _ => (∅ : Finset (Fin J))) ell *
      physicalResidueVertexWeight L (Real.sqrt q) r : ℝ) : ℂ) * z)
  exact full_active_external_positive_symmetric n shared B (fun _ => Unit)
    (fun c _ => Δ (physicalSharedPrefix L) c) (fun c _ => D (physicalSharedPrefix L) c)
    (fun _ _ => 1) μ ρ V
    (fun c _ => physicalResidueTranslationEquiv (P := Ps)
      (kbig c * (physicalSharedProduct (physicalSharedPrefix L) : ℕ)))
    (physicalSmallBigCompletion q F (physicalSharedPrefix L))
    (fun r => physical_small_big_completion_memory_symmetric q F hF (physicalSharedPrefix L) r)
    r x g σ

end Bounty
end

section

/- Explicit finite determinant cutoffs for the actual Type-II energy. -/

open Finset

namespace Bounty

theorem typeII_off_determinant_bound {E N M H : Finset ℕ} {Elo U : ℝ}
    (hElo : 0 < Elo) (hE : ∀ e ∈ E, Elo ≤ (e : ℝ))
    (hM : ∀ m ∈ M, (m : ℝ) ≤ U) {x : TypeIIOffIndex}
    (hx : x ∈ typeIIOffDiagonalSupport E N M H) :
    |((typeIIShiftMap x).1.1 : ℝ)| ≤ U / (2 * Elo) := by
  obtain ⟨he, hn, hm, hh, hm', hh', hne, hfirst, hsecond⟩ := mem_typeII_off_diagonal_support.mp hx
  obtain ⟨k, hk, _⟩ := typeII_determinant_unique_nat hfirst hsecond hne
  have hdiff : |(x.2.2.1 : ℝ) - x.2.1.1| ≤ U := by
    apply abs_le.mpr
    constructor
    · linarith [hM _ hm, Nat.cast_nonneg (α := ℝ) x.2.2.1]
    · linarith [hM _ hm', Nat.cast_nonneg (α := ℝ) x.2.1.1]
  have hb := typeII_determinant_abs_le_of_difference hElo (hE _ he) hdiff hk.2.1
  simpa only [typeIIShiftMap, hk.2.2.2] using hb

theorem typeII_determinant_interval_coverage {E N M H : Finset ℕ} {Elo U : ℝ} {B : ℕ}
    (hElo : 0 < Elo) (hE : ∀ e ∈ E, Elo ≤ (e : ℝ))
    (hM : ∀ m ∈ M, (m : ℝ) ≤ U) (hB : U / (2 * Elo) ≤ B)
    {x : TypeIIOffIndex} (hx : x ∈ typeIIOffDiagonalSupport E N M H) :
    (typeIIShiftMap x).1.1 ∈ Icc (-(B : ℤ)) (B : ℤ) := by
  have hr := (typeII_off_determinant_bound hElo hE hM hx).trans hB
  have hi : |(typeIIShiftMap x).1.1| ≤ (B : ℤ) := by exact_mod_cast hr
  exact mem_Icc.mpr (abs_le.mp hi)

theorem typeII_cross_product_interval_coverage {E N M H : Finset ℕ} {x : TypeIIOffIndex}
    (hx : x ∈ typeIIOffDiagonalSupport E N M H) :
    (typeIIShiftMap x).1.2 ∈ Icc 0 (M.sup id * H.sup id) := by
  obtain ⟨he, hn, hm, hh, hm', hh', hne, hfirst, hsecond⟩ := mem_typeII_off_diagonal_support.mp hx
  apply mem_Icc.mpr
  exact ⟨Nat.zero_le _, Nat.mul_le_mul (le_sup (f := id) hm') (le_sup (f := id) hh)⟩

theorem typeII_off_diagonal_energy_eq_bounded_determinant_sum
    (E N M H : Finset ℕ) (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ)
    {Elo U W : ℝ} {B : ℕ}
    (hElo : 0 < Elo) (hE : ∀ e ∈ E, Elo ≤ (e : ℝ))
    (hM : ∀ m ∈ M, (m : ℝ) ≤ U) (hB : U / (2 * Elo) ≤ B) (hBW : (B : ℝ) ≤ W)
    (hrough : ∀ m ∈ M, ∀ p ∈ m.primeFactors, W < (p : ℝ)) :
    typeIIOffDiagonalEnergy E N M H η α aH =
      ∑ y ∈ typeIIDeterminantDomain E N M H (Icc (-(B : ℤ)) B) (Icc 0 (M.sup id * H.sup id)),
        typeIIShiftWeight η α aH y := by
  apply typeII_off_diagonal_energy_eq_determinant_sum E N M H _ _ η α aH hrough
  · intro k hk
    have hi : |k| ≤ (B : ℤ) := abs_le.mpr (mem_Icc.mp hk)
    have hr : |(k : ℝ)| ≤ (B : ℝ) := by exact_mod_cast hi
    exact hr.trans hBW
  · intro x hx
    exact typeII_determinant_interval_coverage hElo hE hM hB hx
  · intro x hx
    exact typeII_cross_product_interval_coverage hx

theorem typeII_determinant_sum_expanded (E N M H : Finset ℕ)
    (K : Finset ℤ) (Z : Finset ℕ) (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ) :
    (∑ y ∈ typeIIDeterminantDomain E N M H K Z, typeIIShiftWeight η α aH y) =
      ∑ k ∈ K, ∑ z ∈ Z, ∑ m ∈ M, ∑ h ∈ H, ∑ m' ∈ M, ∑ h' ∈ H,
        (by classical exact if TypeIIShiftConditions E N ((k, z), ((m, h), (m', h'))) then
          typeIIShiftWeight η α aH ((k, z), ((m, h), (m', h'))) else (0 : ℝ)) := by
  classical
  simp only [typeIIDeterminantDomain, sum_filter, sum_product]

end Bounty

end

section

/- Exact auxiliary disintegration of the positive mixed path edge. The
moving small prefix remains inside each literal full big-event operator. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_small_big_path_positive_edge_eq
    {H K S G : Type} [Fintype S] [Fintype G] [dG : DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Type} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] {J ell : ℕ} {M : G → ℕ}
    (shared : K → ∀ g, Finset (Fin (M g))) (B : ℕ) (A : K → Type) [∀ k, Fintype (A k)]
    (Δ D : ∀ k, PhysicalSharedLists Ps J → SharedActiveLabels P (shared k) → A k → G → ℤ)
    (kbig : ∀ k, SharedActiveLabels P (shared k) → A k → ℤ)
    (ω : ∀ k, A k → ℝ) (μ : ∀ g, P g → ℝ)
    (qghost : H → ℝ) (ρ : ℝ) (Vedge Vghost : G → ℝ) (Vs : S → ℝ) (qsmall : ℝ)
    (hVs : ∀ s, 0 < Vs s) (hω : ∀ k a, 0 ≤ ω k a)
    (hμ : ∀ g p, 0 ≤ μ g p) (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ Vedge g)
    (k : K)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ) :
    physicalSmallBigPathPositiveAction n shared B A Δ D kbig ω μ qghost ρ
      Vedge Vghost Vs qsmall (some (.inr k)) F =
      fun s => ∑ a : A k, (ω k a : ℂ) *
        physicalSmallBigFullPhasedAction n (shared k) B
          (fun d c => Δ k d c a) (fun d c => D k d c a) μ ρ Vedge
          (fun c => kbig k c a) Vs qsmall (fun _ _ => 1) F s := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  funext s
  unfold physicalSmallBigPathPositiveAction finiteLocalEventAction
  dsimp only [physicalSmallBigPathEventFintype, PhysicalSmallBigPathEvent]
  rw [Fintype.sum_prod_type]
  simp only [Fintype.sum_sigma]
  rw [sum_comm]
  simp only [physicalSmallBigFullPhasedAction, physicalSmallBigPhasedAction,
    Fintype.sum_prod_type, Fintype.sum_sigma, Fintype.sum_unique, mul_sum]
  apply sum_congr rfl
  intro a _
  apply sum_congr rfl
  intro L _
  apply sum_congr rfl
  intro e _
  have hw := physical_small_big_path_edge_weight_nonneg n shared B A Δ D kbig ω μ qghost ρ
    Vedge Vs qsmall hVs hω hμ hρ hV k s (L, ⟨a, e⟩)
  simp only [physicalSmallBigPathPositiveWeight, abs_of_nonneg hw]
  unfold physicalSmallBigPathEventWeight physicalSmallBigPathEventTarget
    physicalSmallBigPositiveWeight physicalSmallBigFullWeight physicalSmallBigTarget
    physicalSmallBigFullTarget fullActiveEdgeEventWeight fullActiveEdgeEventTarget
  dsimp only
  split_ifs <;> push_cast <;> ring

end Bounty
end

