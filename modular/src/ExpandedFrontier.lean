          (fun i => globalBirthJointMemoryTarget (steps i))) (List.range (2 * n + 1))
        (complexNormEnvelope (fun q => if ∀ g, (q g).1 = 0 then 1 else 0)) (fun _ => globalBirthEmptyMemory)).re := by
  exact global_birth_joint_raw_history_norm_le_abs_list (fun i g => physicalGroupBareAtomicActivity L g i)
    (physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β η V ρ hV cap) (fun _ => cap) (2 * n + 1)
    (fun q => if ∀ g, (q g).1 = 0 then 1 else 0) (fun g => ghostPhaseActivitySupport (physicalGroupBareAtomicActivity L g 0)) (fun _ => globalBirthEmptyMemory)

