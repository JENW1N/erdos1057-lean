      (fun _ => B) (fun _ => B) n =
    ghostPhaseCappedHistory a h η β V (fun _ => B) (fun _ => B) n := by
  have hH : Fintype.card H ≤ B := (Fintype.card_congr e).trans_le hB
  rw [ghost_phase_capped_history_eq_run_product _ _ _ _ _ _ _ (fun _ => hH) (fun _ => hH),
    ghost_phase_capped_history_eq_run_product _ _ _ _ _ _ _ (fun _ => hB) (fun _ => hB)]
