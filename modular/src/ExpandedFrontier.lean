section

/- Absorb the recovered local coefficient before expanding original freshness into forests. -/

open Finset
open scoped Classical
namespace Bounty

theorem finite_event_local_phase_multiply {I X : Type*}
    (E : I → X → Type*) (target : ∀ i x, E i x → X)
    (phase factor : ∀ i x, E i x → ℂ)
    (steps : List I) (x : X) (p : FiniteEventPath E target steps x) :
    finiteEventLocalPhase E target (fun i x e => phase i x e * factor i x e) steps x p =
      finiteEventLocalPhase E target phase steps x p *
        finiteEventLocalPhase E target factor steps x p := by
  simp only [finite_event_local_phase_occurrences, prod_mul_distrib]

section Enriched
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
  (cut : ℕ → Fin N → Finset (Fin J)) (ζ : Fin n → ℝ)
  (K : ∀ j, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C j) → ℂ)

noncomputable def physicalEnrichedEdgePhase (j : Fin n)
    (H : (g : Fin N) → Finset ↥(P g)) (x : PhysicalFullBoundedState P J ell B)
    (e : PhysicalFullEdgeEvent (C j) (k j) x) : ℂ :=
  physicalFullGlobalEdgePhase (C j) (k j) H (ω j) (fun g p => β g p / V g) ρ V x e *
    physicalFullCoefficientPhase C k cut ζ K (some (.inr j)) x e

noncomputable def physicalEnrichedLedgerPhase
    (tag : Option (Fin (n + 1) ⊕ Fin n))
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (e : PhysicalFullLedgerEvent C k tag s) : ℂ :=
  fullMixedLedgerPhase (fun g (p : ↥(P g)) => p.val)
    (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
    (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j))
    (physicalEnrichedEdgePhase C k ω β ρ V cut ζ K) tag s e

theorem physical_enriched_ledger_phase_factor
    (tag : Option (Fin (n + 1) ⊕ Fin n))
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (e : PhysicalFullLedgerEvent C k tag s) :
    physicalEnrichedLedgerPhase C k ω β ρ V cut ζ K tag s e =
      physicalFullLedgerEventPhase C k ω β ρ V tag s e *
        physicalLocalCoefficientPhase C k cut ζ K tag s e := by
  cases tag with
  | none => simp only [physicalEnrichedLedgerPhase, physicalFullLedgerEventPhase,
      fullMixedLedgerPhase, physicalLocalCoefficientPhase, mul_one]
  | some tag =>
    cases tag with
    | inl j => simp only [physicalEnrichedLedgerPhase, physicalFullLedgerEventPhase,
        fullMixedLedgerPhase, physicalLocalCoefficientPhase, mul_one]
    | inr j => rfl

theorem physical_enriched_ledger_path_factor
    (steps : List (Option (Fin (n + 1) ⊕ Fin n)))
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (p : FiniteEventPath (PhysicalFullLedgerEvent C k) (physicalFullLedgerEventTarget C k) steps s) :
    finiteEventLocalPhase (PhysicalFullLedgerEvent C k) (physicalFullLedgerEventTarget C k)
      (physicalEnrichedLedgerPhase C k ω β ρ V cut ζ K) steps s p =
      finiteEventLocalPhase (PhysicalFullLedgerEvent C k) (physicalFullLedgerEventTarget C k)
        (physicalFullLedgerEventPhase C k ω β ρ V) steps s p *
      finiteEventLocalPhase (PhysicalFullLedgerEvent C k) (physicalFullLedgerEventTarget C k)
        (physicalLocalCoefficientPhase C k cut ζ K) steps s p := by
  have he : physicalEnrichedLedgerPhase (B := B) C k ω β ρ V cut ζ K =
      (fun tag s e => physicalFullLedgerEventPhase C k ω β ρ V tag s e *
        physicalLocalCoefficientPhase C k cut ζ K tag s e) := by
    funext tag s e
    exact physical_enriched_ledger_phase_factor C k ω β ρ V cut ζ K tag s e
  rw [he]
  exact finite_event_local_phase_multiply _ _ _ _ _ _ _

end Enriched
end Bounty
