section

/- Prime-label forest constraints survive the exact optional-label representation of original births. -/

namespace Bounty

theorem birth_forest_equalValues_some_iff {m : ℕ} {α : Type*}
    (code : BirthForestCode m) (values : Fin m → α) :
    birthForestEqualValues code (fun i => some (values i)) ↔ birthForestEqualValues code values := by
  constructor
  · intro h i p hp
    exact Option.some.inj (h i p hp)
  · intro h i p hp
    exact congrArg some (h i p hp)

theorem birth_labels_anchored_join_iff {m : ℕ} {α : Type*}
    (anchors : Fin m → Option (Option α)) (values : Fin m → α)
    (hvalid : ∀ i, anchors i ≠ some none) :
    birthLabelsAnchored anchors (fun i => some (values i)) ↔
      birthLabelsAnchored (fun i => (anchors i).join) values := by
  constructor
  · intro h i a ha
    cases he : anchors i with
    | none => simp [he] at ha
    | some v =>
      cases v with
      | none => exact False.elim (hvalid i he)
      | some b =>
        have hb : b = a := by simpa only [he, Option.join_some, Option.some.injEq] using ha
        subst b
        exact Option.some.inj (h i (some a) he)
  · intro h i a ha
    cases a with
    | none => exact False.elim (hvalid i ha)
    | some a =>
      exact congrArg some (h i a (by simp only [ha, Option.join_some]))

theorem restricted_optional_anchors_valid {N m : ℕ} {α : Type*}
    (embed : Fin m → Fin N) (code : BirthForestCode N) (values : Fin N → Option α)
    (hparents : ∀ j p, code (embed j) = some p →
      values (birthForestParentEmbedding (embed j) p) ≠ none) :
    ∀ j, restrictedBirthAnchors embed code values j ≠ some none := by
  intro j
  cases hc : code (embed j) with
  | none => simp [restrictedBirthAnchors, hc]
  | some p =>
    by_cases he : ∃ k : Fin j.val,
      embed (birthForestParentEmbedding j k) = birthForestParentEmbedding (embed j) p
    · simp [restrictedBirthAnchors, hc, he]
    · simpa only [restrictedBirthAnchors, hc, if_neg he, ne_eq, Option.some.injEq]
        using hparents j p hc

theorem restricted_optional_forest_prime_iff {N m : ℕ} {α : Type*}
    (embed : Fin m → Fin N) (code : BirthForestCode N) (values : Fin N → Option α)
    (localValues : Fin m → α)
    (hlocal : ∀ j, values (embed j) = some (localValues j))
    (hparents : ∀ j p, code (embed j) = some p →
      values (birthForestParentEmbedding (embed j) p) ≠ none) :
    (∀ j p, code (embed j) = some p →
      values (embed j) = values (birthForestParentEmbedding (embed j) p)) ↔
    birthForestEqualValues (restrictedBirthCode embed code) localValues ∧
      birthLabelsAnchored (fun j => (restrictedBirthAnchors embed code values j).join) localValues := by
  rw [restricted_birth_forest_iff]
  have hl : values ∘ embed = fun j => some (localValues j) := funext hlocal
  rw [hl, birth_forest_equalValues_some_iff,
    birth_labels_anchored_join_iff _ _ (restricted_optional_anchors_valid embed code values hparents)]


theorem owner_optional_forest_past_iff {N m L : ℕ} {α : Type*}
    (embed : Fin m → Fin N) (hstrict : StrictMono embed)
    (owner : Fin N → Fin L) (hmono : Monotone owner) (u : Fin L)
    (howner : ∀ j, owner (embed j) = u) (performed : Fin N → Prop)
    (hcover : ∀ i, performed i → owner i = u → i ∈ Set.range embed)
    (code : BirthForestCode N) (values history : Fin N → Option α)
    (localValues : Fin m → α)
    (hlocal : ∀ j, values (embed j) = some (localValues j))
    (hchildren : ∀ i, owner i = u → code i ≠ none → performed i)
    (hparents : ∀ j p, code (embed j) = some p →
      performed (birthForestParentEmbedding (embed j) p))
    (hpresent : ∀ i, performed i → values i ≠ none)
    (hpast : ∀ i, owner i < u → values i = history i) :
    (∀ i, owner i = u → ∀ p, code i = some p →
      values i = values (birthForestParentEmbedding i p)) ↔
    birthForestEqualValues (restrictedBirthCode embed code) localValues ∧
      birthLabelsAnchored (fun j => (restrictedBirthAnchors embed code history j).join) localValues := by
  have ha := restricted_birth_anchors_past_local embed hstrict owner hmono u howner
    performed hcover code hparents values history hpast
  have hv := restricted_optional_anchors_valid embed code values
    (fun j p hp => hpresent _ (hparents j p hp))
  rw [owner_restricted_birth_forest_past_iff embed hstrict owner hmono u howner
    performed hcover code values history hchildren hparents hpast]
  have hl : values ∘ embed = fun j => some (localValues j) := funext hlocal
  rw [hl, birth_forest_equalValues_some_iff]
  rw [birth_labels_anchored_join_iff _ _ (by intro j; rw [← ha]; exact hv j)]

end Bounty
end

section

/- The actual capped storage average on candidate prime pools. The estimate
includes arbitrary choice-dependent external translations and derives the
inverse-direction rarity from arithmetic, without a rarity assumption. -/

open Finset Filter
open scoped Classical Topology

namespace Bounty

theorem eventually_candidate_storage_external_energy_le {R : Type*} [Fintype R] {s : ℝ} (hs : 0 < s)
    (ell : ℕ) (C₂ : ℝ) :
    ∀ᶠ L : ℝ in atTop,
      letI : ∀ g p, NeZero (candidateBigModulus s L g p) := candidateBigModulusNeZero s L
      ∀ J B : ℕ,
      ∀ labels : PhysicalMarkLists
        (fun g : ↥(candidateSmallPIndices s L) => candidatePBand (s * L) g.val) J ell,
      ∀ D_B : ℕ, ∀ k : ℤ, k ≠ 0 → (k.natAbs : ℝ) ≤ L ^ C₂ →
      ∀ μ : ∀ g, CandidateBigLabel s L g → ℝ, ∀ ρ : ℝ,
      ∀ V : CandidateBigGroup s L → ℝ, ∀ t : CandidateBigGroup s L → ℕ,
      ∀ v vmin vmax : ℝ, 0 < ρ → ρ < 1 → 1 < v → 0 < vmin →
      (∀ g, vmin ≤ V g) → (∀ g, V g ≤ vmax) →
      (∀ g p, 0 ≤ μ g p) → (∀ g, ∑ p, μ g p ≤ 2) →
      ∀ T : ℕ, (∀ g, t g ≤ T) →
      ∀ τ : (↥(candidateSmallPIndices s L) → Equiv.Perm (PhysicalSlots J ell)) → R ≃ R,
      ∀ f : ProductBoundedOrderedState (CandidateBigLabel s L)
        (fun g => UnrestrictedResidueParticle (candidateBigModulus s L g)) t B → R → ℂ,
      (∀ r, ProductMemorySymmetric (fun state => f state r)) →
      (∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
        (fun state => smallSourceStorageExternalAverage (candidateBigModulus s L)
          labels D_B k μ ρ V t B τ f state r)) ≤
      ((B : ℝ) / (((J + ell).choose ell) ^ (candidateSmallPIndices s L).card : ℕ)) *
        unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ (candidateBigPIndices s L).card *
          ∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
            (fun state => f state r) := by
  filter_upwards [eventually_candidate_omission_bounds hs ell C₂,
    eventually_candidate_small_source_omission_arithmetic hs ell C₂] with L hL harith
  let _ : ∀ g p, NeZero (candidateBigModulus s L g p) := candidateBigModulusNeZero s L
  intro J B labels D_B k hk hkbound μ ρ V t v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass
    T ht τ f hf
  have hP : ∀ (g : ↥(candidateSmallPIndices s L)) q, q ∈ candidatePBand (s * L) g.val → q.Prime := by
    intro g q hq
    exact hL.2.2.2.2.1 g.val (mem_union_left _ g.property) q hq
  have hdis : Pairwise (fun g h : ↥(candidateSmallPIndices s L) =>
      Disjoint (candidatePBand (s * L) g.val) (candidatePBand (s * L) h.val)) := by
    intro g h hne
    exact hL.2.2.2.2.2 (fun he => hne (Subtype.ext he))
  have hmem (g : CandidateBigGroup s L) (p : CandidateBigLabel s L g) :
      p.val ∈ (candidateBigPIndices s L).biUnion (candidatePBand (s * L)) :=
    mem_biUnion.mpr ⟨g.val, g.property, p.property⟩
  have h := small_source_storage_external_energy_le (candidateBigModulus s L) labels hP hdis D_B k
    (fun g p => (hL.2.2.2.1 g.val g.property p.val p.property).1)
    (fun g p => (harith J labels p.val (hmem g p) k hk hkbound).1)
    (fun g p A => (harith J labels p.val (hmem g p) k hk hkbound).2 A)
    μ ρ V t B hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht τ f hf
  simpa only [CandidateBigGroup, Fintype.card_coe] using h

end Bounty
end

section

/- Exact full-event formulas for storage without promotion and its reverse.
The formulas keep the same auxiliary weights and both total-memory caps. -/

open Finset Classical

namespace Bounty

section

variable {G : Type*} [Fintype G] [dG : DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ)
  {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
  {A : SharedActiveLabels P S → Type*} [∀ c, Fintype (A c)]
  (Δ D : ∀ c, A c → G → ℤ) (ω : ∀ c, A c → ℝ)
  (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  {R : Type*} (τ : ∀ c, A c → R ≃ R)

theorem full_active_storage_external_eq_sum
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → R → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) (r : R) :
    fullActiveStorageExternal n S B Δ D ω μ ρ V τ f x r =
      fullActiveExternalCoefficientAction n S B A Δ D ω μ ρ V τ
        (fun _ _ e => if (∀ g, (e.2 g).2.1 = ∅) ∧ (∃ g, (e.2 g).1 ≠ ∅)
          then 1 else 0) f x r := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  unfold fullActiveStorageExternal equivExternalFiberAverage finiteExternalFiberAverage
    unrestrictedStorageOnlyProduct fullActiveExternalCoefficientAction
  rw [Fintype.sum_sigma]
  apply sum_congr rfl
  intro a _
  dsimp only
  rw [unrestricted_coupled_cutoff_eq_joint_event_sum]
  simp only [mul_sum, fullActiveEdgeEventWeight, fullActiveEdgeEventTarget,
    Complex.ofReal_mul, mul_assoc]
  apply sum_congr
  · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
  · intro e _; rfl

theorem full_active_reverse_promotion_external_eq_sum
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → R → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) (r : R) :
    fullActiveReversePromotionExternal n S B Δ D ω μ ρ V τ f x r =
      fullActiveExternalCoefficientAction n S B A (fun c a g => -Δ c a g) D ω μ ρ V
        (fun c a => (τ c a).symm)
        (fun _ _ e => ((∏ g, V g ^ (e.2 g).2.1.card / V g ^ (e.2 g).1.card : ℝ) : ℂ) *
          (if (∀ g, (e.2 g).1 = ∅) ∧ (∃ g, (e.2 g).2.1 ≠ ∅) then 1 else 0))
        f x r := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  unfold fullActiveReversePromotionExternal equivExternalFiberAverage finiteExternalFiberAverage
    unrestrictedReversePromotionOnlyProduct fullActiveExternalCoefficientAction
  rw [Fintype.sum_sigma]
  apply sum_congr rfl
  intro a _
  dsimp only
  rw [unrestricted_coupled_cutoff_eq_joint_event_sum]
  simp only [mul_sum, fullActiveEdgeEventWeight, fullActiveEdgeEventTarget,
    Complex.ofReal_mul, mul_assoc]
  apply sum_congr
  · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
  · intro e _; rfl

end

end Bounty
end

section

/- Both forward and reverse eligibility rarity control the full nonclean
average, including arbitrary bounded coefficients. The factor four in
energy is the squared sum of the two square-root rarity bounds. -/

open Finset
open scoped Classical

namespace Bounty

section

variable {A G R : Type*} [Fintype A] [Fintype G] [Fintype R] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  (Δ D : A → G → ℤ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (t : G → ℕ) (B : ℕ) (π : A → ℝ) (τ : A → R ≃ R)

theorem unrestricted_dirty_external_average_energy_le
    (hπ : ∀ a, 0 ≤ π a) (hπmass : ∑ a, π a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, t g ≤ T) {δ : ℝ} (hδ : 0 ≤ δ)
    (hrareMinus : ∀ s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B,
      productTotalMemory s ≤ B →
      (∑ a, if ∃ g, (unrestrictedResidueEligible (n g) (-Δ a g) (D a g) (s g).2.2).Nonempty
        then π a else 0) ≤ δ)
    (hrarePlus : ∀ s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B,
      productTotalMemory s ≤ B →
      (∑ a, if ∃ g, (unrestrictedResidueEligible (n g) (Δ a g) (D a g) (s g).2.2).Nonempty
        then π a else 0) ≤ δ)
    (phase : ∀ a, R → UnrestrictedProductPhase n (Δ a) (D a) t B)
    (hphase : ∀ a r s e, ‖phase a r s e‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun j => UnrestrictedResidueParticle (n j)) t B → R → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun s => f s r)) :
    (∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fun s => unrestrictedDirtyExternalAverage n Δ D μ ρ V t B π τ phase f s r)) ≤
      4 * δ * unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        ∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
          (fun s => f s r) := by
  let F := fun s r => (‖f s r‖ : ℂ)
  have hF : ∀ r, ProductMemorySymmetric (fun s => F s r) :=
    fun r => complexNormEnvelope_memory_symmetric (fun s => f s r) (hf r)
  have hP := unrestricted_promotion_external_average_energy_le n Δ D μ ρ V t B π
    hπ hπmass hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht τ
    (fun _ _ _ _ => 1) (by intros; simp only [norm_one, le_refl]) hδ hrarePlus F hF
  have hS := unrestricted_storage_external_average_energy_le n Δ D μ ρ V t B π τ
    hπ hπmass hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht hδ hrareMinus F hF
  have hEF : (∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fun s => F s r)) = ∑ r, finiteWeightedEnergy
        (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) (fun s => f s r) := by
    apply sum_congr rfl
    intro r _
    exact complexNormEnvelope_energy _ (fun s => f s r)
  rw [hEF] at hP hS
  have h := finite_external_energy_domination_add
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productMemoryWeight_nonneg μ _ hμ (fun g z => hμ g z.1)) f
    (unrestrictedDirtyExternalAverage n Δ D μ ρ V t B π τ phase f)
    (unrestrictedPromotionExternalAverage n Δ D μ ρ V t B π τ (fun _ _ _ _ => 1) F)
    (unrestrictedStorageExternalAverage n Δ D μ ρ V t B π τ F)
    (δ * unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G) (by
      intro s r
      have hd := unrestricted_dirty_external_norm_le_positive_re n Δ D μ ρ V t B π τ
        hπ hρ0.le (fun g => (hvmin.trans_le (hVlo g)).le) hμ phase hphase f s r
      rw [unrestricted_dirty_external_positive_split] at hd
      exact hd.trans (Complex.re_le_norm _)) hP hS
  simpa only [mul_assoc] using h

end

end Bounty
end

section

/- One original memory edge with its small completion factor, exactly. -/

open scoped Classical
namespace Bounty

theorem physical_memory_labeled_group_factor
    {G I : Type*} [Fintype G] [dG : DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (small : G → Prop) (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (ζ : I → ℝ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (L R : PhysicalMarkLists P J ell) :
    physicalMemoryLabeledScalar V patterns C ζ K a L R =
      physicalMemoryLabeledScalar (fun g : {g // small g} => V g.val) patterns
        (fun i g => C i g.val) (fun _ => 0) (fun _ _ _ _ => 1)
        (physicalRestrictedEdge small patterns C a) (fun g => L g.val) (fun g => R g.val) *
      physicalMemoryLabeledScalar (fun g : {g // ¬small g} => V g.val) patterns
        (fun i g => C i g.val) (fun _ => 0)
        (physicalFixedEdgeBigCoefficient small patterns C ζ K a L R)
        (physicalRestrictedEdge (fun g => ¬small g) patterns C a)
        (fun g => L g.val) (fun g => R g.val) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  have hn := physical_permutation_group_normalization small J ell
  simp only [physicalMemoryLabeledScalar, physicalRestrictedEdge,
    ← physical_permute_group_restrict,
    physical_fixed_edge_big_coefficient_apply, physical_phase_zero_frequency, mul_one]
  simp only [← Nat.card_eq_fintype_card] at hn ⊢
  rw [hn, physical_list_admissible_group_split small,
    physical_aux_mass_group_split small, physical_D_group_split small]
  by_cases hs : physicalListAdmissible (fun g : {g // small g} => C a.2.2.1.val g.val)
      (fun g => a.2.2.2 g.val) (fun g => physicalPermuteLabels a.1 L g.val)
      (fun g => physicalPermuteLabels a.2.1 R g.val)
  · by_cases hb : physicalListAdmissible (fun g : {g // ¬small g} => C a.2.2.1.val g.val)
        (fun g => a.2.2.2 g.val) (fun g => physicalPermuteLabels a.1 L g.val)
        (fun g => physicalPermuteLabels a.2.1 R g.val)
    · simp only [hs, hb, and_self, if_true, Complex.ofReal_mul]
      ring
    · simp only [hs, hb, and_false, if_false, if_true, mul_zero]
  · simp only [hs, false_and, if_false, mul_zero, zero_mul]

theorem physical_partial_memory_labeled_group_factor
    {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (small : G → Prop) (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (ζ : I → ℝ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (L R : PhysicalMarkLists P J ell) :
    (physicalCompletionMass (fun g : {g // small g} => V g.val)
      (fun g => C a.2.2.1.val g.val) ell : ℂ) *
      physicalMemoryLabeledScalar V patterns C ζ K a L R =
      physicalBareLabeledScalar (fun g : {g // small g} => V g.val) patterns
        (fun i g => C i g.val) (fun _ => 0) (fun _ _ _ _ => 1)
        (physicalRestrictedEdge small patterns C a) (fun g => L g.val) (fun g => R g.val) *
      physicalMemoryLabeledScalar (fun g : {g // ¬small g} => V g.val) patterns
        (fun i g => C i g.val) (fun _ => 0)
        (physicalFixedEdgeBigCoefficient small patterns C ζ K a L R)
        (physicalRestrictedEdge (fun g => ¬small g) patterns C a)
        (fun g => L g.val) (fun g => R g.val) := by
  rw [physical_memory_labeled_group_factor small, physical_memory_labeled_scalar_factor]
  simp only [physical_restricted_edge_pattern, mul_assoc]

end Bounty
end

section

/- Uniform ordinary-prime asymptotics on logarithmic cells. -/

open Filter

namespace Bounty

theorem eventually_ordinary_theta_scaled_power_bound {a K : ℝ}
    (ha : 0 < a) (hK : 0 ≤ K) :
    ∀ᶠ L : ℝ in atTop, ∀ x : ℝ, Real.exp (a*L) ≤ x →
      |Chebyshev.theta x-x| ≤ a^(-K)*L^(-K)*x := by
  filter_upwards [eventually_ordinary_theta_uniform_log_power_bound ha K,
    eventually_gt_atTop (0 : ℝ)] with L hraw hL
  intro x hx
  have hx0 : 0 < x := (Real.exp_pos _).trans_le hx
  have hlog : a*L ≤ Real.log x := by
    have hh := Real.log_le_log (Real.exp_pos _) hx
    rwa [Real.log_exp] at hh
  have hp := Real.rpow_le_rpow_of_nonpos (mul_pos ha hL) hlog (neg_nonpos.mpr hK)
  calc
    _ ≤ x*(Real.log x)^(-K) := hraw x hx
    _ ≤ x*(a*L)^(-K) := mul_le_mul_of_nonneg_left hp hx0.le
    _ = _ := by rw [Real.mul_rpow ha.le hL.le]; ring

theorem exists_ordinary_prime_logarithmic_cell_asymptotic {a S : ℝ}
    (ha : 0 < a) (hS : 0 ≤ S) :
    ∃ C : ℝ, 0 < C ∧ ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, Real.exp (a*L) ≤ Y →
      |((primeBand Y (Real.exp (L^(-S))*Y)).card : ℝ) -
        ((Real.exp (L^(-S))-1)*Y)/Real.log Y| ≤
        (C/L) * (((Real.exp (L^(-S))-1)*Y)/Real.log Y) := by
  let A := a^(-(S+1))
  let C := 4*A+1/a
  have hA : 0 < A := Real.rpow_pos_of_pos ha _
  have hC : 0 < C := by dsimp [C]; positivity
  refine ⟨2*C, by positivity, ?_⟩
  filter_upwards [eventually_ordinary_theta_scaled_power_bound ha
      (show 0 ≤ S+1 by linarith), eventually_ge_atTop (1 : ℝ)] with L hraw hL1
  intro Y hY
  have hL : 0 < L := zero_lt_one.trans_le hL1
  have hY0 : 0 < Y := (Real.exp_pos _).trans_le hY
  have hY1 : 1 < Y := (Real.one_lt_exp_iff.mpr (mul_pos ha hL)).trans_le hY
  have hδ0 : 0 < L^(-S) := Real.rpow_pos_of_pos hL _
  have hδ1 : L^(-S) ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos hL1 (neg_nonpos.mpr hS)
  let B := Real.exp (L^(-S))*Y
  have hYB : Y ≤ B := by
    dsimp [B]
    exact le_mul_of_one_le_left hY0.le (Real.one_le_exp hδ0.le)
  have hB3 : B ≤ 3*Y := by
    dsimp [B]
    apply mul_le_mul_of_nonneg_right _ hY0.le
    exact (Real.exp_le_exp.mpr hδ1).trans (by linarith [Real.exp_one_lt_three])
  have hH : 0 ≤ B-Y := sub_nonneg.mpr hYB
  have hwidth : L^(-S)*Y ≤ B-Y := by
    have hh := Real.add_one_le_exp (L^(-S))
    have hm := mul_le_mul_of_nonneg_right hh hY0.le
    dsimp [B]
    nlinarith
  have hpow : L^(-(S+1)) = L^(-S)/L := by
    rw [show -(S+1) = -S + (-1 : ℝ) by ring, Real.rpow_add hL, Real.rpow_neg_one]
    ring
  have hθY := hraw Y hY
  have hθB := hraw B (hY.trans hYB)
  have hθ : |(Chebyshev.theta B-Chebyshev.theta Y)-(B-Y)| ≤ (C/L)*(B-Y) := by
    have hid : (Chebyshev.theta B-Chebyshev.theta Y)-(B-Y) =
        (Chebyshev.theta B-B)-(Chebyshev.theta Y-Y) := by ring
    rw [hid]
    calc
      _ ≤ |Chebyshev.theta B-B|+|Chebyshev.theta Y-Y| := abs_sub _ _
      _ ≤ A*L^(-(S+1))*B+A*L^(-(S+1))*Y := add_le_add hθB hθY
      _ ≤ A*L^(-(S+1))*(3*Y)+A*L^(-(S+1))*Y := by
        gcongr
      _ = (4*A/L)*(L^(-S)*Y) := by rw [hpow]; ring
      _ ≤ (4*A/L)*(B-Y) := mul_le_mul_of_nonneg_left hwidth (by positivity)
      _ ≤ (C/L)*(B-Y) := by
        apply mul_le_mul_of_nonneg_right _ hH
        apply div_le_div_of_nonneg_right _ hL.le
        dsimp [C]
        linarith [one_div_pos.mpr ha]
  have hlogY : a*L ≤ Real.log Y := by
    have hh := Real.log_le_log (Real.exp_pos _) hY
    rwa [Real.log_exp] at hh
  have hscale : 1 ≤ (C/L)*Real.log Y := by
    calc
      _ = ((1/a)/L)*(a*L) := by field_simp
      _ ≤ (C/L)*(Real.log Y) := by
        apply mul_le_mul _ hlogY (by positivity) (by positivity)
        apply div_le_div_of_nonneg_right _ hL.le
        dsimp [C]
        linarith [one_div_pos.mpr ha]
  have hlogB : Real.log B ≤ (1+C/L)*Real.log Y := by
    have heq : Real.log B = L^(-S)+Real.log Y := by
      dsimp [B]
      rw [Real.log_mul (Real.exp_ne_zero _) hY0.ne', Real.log_exp]
    rw [heq]
    nlinarith
  have hh := ordinary_prime_band_relative_error hY1 hYB
    (show 0 ≤ C/L by positivity) hθ hlogB
  have heq : B-Y = (Real.exp (L^(-S))-1)*Y := by dsimp [B]; ring
  rw [heq] at hh
  convert hh using 1 <;> ring

theorem eventually_ordinary_prime_logarithmic_cell_relative_error {a S ε : ℝ}
    (ha : 0 < a) (hS : 0 ≤ S) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, Real.exp (a*L) ≤ Y →
      |((primeBand Y (Real.exp (L^(-S))*Y)).card : ℝ) -
        ((Real.exp (L^(-S))-1)*Y)/Real.log Y| ≤
        ε * (((Real.exp (L^(-S))-1)*Y)/Real.log Y) := by
  obtain ⟨C, hC, hbound⟩ := exists_ordinary_prime_logarithmic_cell_asymptotic ha hS
  filter_upwards [hbound, eventually_ge_atTop (C/ε),
    eventually_ge_atTop (1 : ℝ)] with L hL hlarge hL1
  intro Y hY
  have hL0 : 0 < L := zero_lt_one.trans_le hL1
  have hY0 : 0 < Y := (Real.exp_pos _).trans_le hY
  have hY1 : 1 < Y := (Real.one_lt_exp_iff.mpr (mul_pos ha hL0)).trans_le hY
  have hδ : 0 ≤ L^(-S) := (Real.rpow_pos_of_pos hL0 _).le
  have hmain : 0 ≤ ((Real.exp (L^(-S))-1)*Y)/Real.log Y := by
    apply div_nonneg _ (Real.log_pos hY1).le
    exact mul_nonneg (sub_nonneg.mpr (Real.one_le_exp hδ)) hY0.le
  have hsmall : C/L ≤ ε := by
    apply (div_le_iff₀ hL0).mpr
    have hh := (div_le_iff₀ hε).mp hlarge
    nlinarith
  exact (hL Y hY).trans (mul_le_mul_of_nonneg_right hsmall hmain)

end Bounty
end

section

/- External translations depending on shared labels and auxiliary choices
preserve pending-memory symmetry of storage and reverse-promotion actions. -/

open Finset Classical

namespace Bounty

theorem full_active_external_fiber_average_symmetric
    {G : Type*} [DecidableEq G] {P Z : G → Type*}
    {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
    {A : SharedActiveLabels P S → Type*} [∀ c, Fintype (A c)]
    (ω : ∀ c, A c → ℝ)
    (T : ∀ c, A c →
      (ProductBoundedOrderedState P Z (fun g => (S g)ᶜ.card) B → ℂ) →
      ProductBoundedOrderedState P Z (fun g => (S g)ᶜ.card) B → ℂ)
    {R : Type*} (τ : ∀ c, A c → R ≃ R)
    (hT : ∀ c a F, ProductMemorySymmetric F → ProductMemorySymmetric (T c a F))
    (f : ProductBoundedOrderedState P Z M B → R → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun x => f x r)) :
    ∀ r, ProductMemorySymmetric (fun x =>
      equivExternalFiberAverage (productActiveMemorySplit S B) ω T τ f x r) := by
  intro r x g σ
  unfold equivExternalFiberAverage
  dsimp only
  rw [productActiveMemorySplit_permute S B x g σ]
  unfold finiteExternalFiberAverage
  apply sum_congr rfl
  intro a _
  apply congrArg (fun z : ℂ => (ω (productActiveMemorySplit S B x).1 a : ℂ) * z)
  exact hT (productActiveMemorySplit S B x).1 a _
    (productActiveMemorySlice_symmetric S B
      (fun y => f y (τ (productActiveMemorySplit S B x).1 a r))
      (hf _) (productActiveMemorySplit S B x).1)
    (productActiveMemorySplit S B x).2 g σ

section

variable {G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
  {A : SharedActiveLabels P S → Type*} [∀ c, Fintype (A c)]
  (Δ D : ∀ c, A c → G → ℤ) (ω : ∀ c, A c → ℝ)
  (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  {R : Type*} (τ : ∀ c, A c → R ≃ R)

theorem full_active_storage_external_symmetric
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → R → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun x => f x r)) :
    ∀ r, ProductMemorySymmetric (fun x =>
      fullActiveStorageExternal n S B Δ D ω μ ρ V τ f x r) := by
  exact full_active_external_fiber_average_symmetric S B ω _ τ
    (fun c a F hF => unrestricted_storage_only_product_symmetric n (Δ c a) (D c a)
      μ ρ V (fun g => (S g)ᶜ.card) B F hF) f hf

theorem full_active_reverse_promotion_external_symmetric
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → R → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun x => f x r)) :
    ∀ r, ProductMemorySymmetric (fun x =>
      fullActiveReversePromotionExternal n S B Δ D ω μ ρ V τ f x r) := by
  exact full_active_external_fiber_average_symmetric S B ω _ (fun c a => (τ c a).symm)
    (fun c a F hF => unrestricted_reverse_promotion_only_product_symmetric n (Δ c a) (D c a)
      μ ρ V (fun g => (S g)ᶜ.card) B F hF) f hf

end

end Bounty
end

section

/- Actual mixed capped edge actions with arbitrary dependence on both small
endpoints. Positive domination precedes small-prefix conditioning, so the
coefficient is not required to be a spectator of either small completion. -/

open Finset
open scoped Classical

namespace Bounty

section

variable {S G : Type*} [Fintype S] [Fintype G] [dG : DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
  (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
  (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (kbig : SharedActiveLabels P shared → ℤ)

noncomputable def physicalSmallBigFullWeight (_r : PhysicalResidues Ps)
    (d : PhysicalSharedLists Ps J)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : PhysicalSmallBigFullEvent n shared B Δ D d x) : ℝ :=
  fullActiveEdgeEventWeight n shared B (fun _ => Unit) (fun c _ => Δ d c)
    (fun c _ => D d c) (fun _ _ => 1) μ ρ V x e

noncomputable def physicalSmallBigFullPhasedAction (Vs : S → ℝ) (q : ℝ)
    (Φ : ∀ s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B),
      PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B Δ D) s → ℂ)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ) :=
  physicalSmallBigPhasedAction Vs q (PhysicalSmallBigFullEvent n shared B Δ D)
    (physicalSmallBigFullTarget n shared B Δ D)
    (physicalSmallBigFullWeight n shared B Δ D μ ρ V)
    (fun x => kbig (productActiveMemorySplit shared B x).1) Φ F

omit [Fintype S] [DecidableEq G] [∀ g, Fintype (P g)] in
theorem physical_small_big_full_weight_nonneg
    (hμ : ∀ g p, 0 ≤ μ g p) (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ V g)
    (r : PhysicalResidues Ps) (d : PhysicalSharedLists Ps J)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : PhysicalSmallBigFullEvent n shared B Δ D d x) :
    0 ≤ physicalSmallBigFullWeight n shared B Δ D μ ρ V r d x e := by
  exact fullActiveEdgeEventWeight_nonneg n shared B (fun _ => Unit) _ _ _ μ ρ V
    (fun _ _ => zero_le_one) hμ hρ hV x e

theorem physical_small_big_full_positive_eq (Vs : S → ℝ) (q : ℝ)
    (aux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))))
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ) :
    physicalSmallBigAction Vs q 0 aux (fun _ => 1)
      (PhysicalSmallBigFullEvent n shared B Δ D)
      (physicalSmallBigFullTarget n shared B Δ D)
      (physicalSmallBigFullCoefficient n shared B Δ D μ ρ V (fun _ _ _ _ => 1))
      (fun x => kbig (productActiveMemorySplit shared B x).1) F =
    physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q (fun _ _ => 1) F := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  funext s
  unfold physicalSmallBigAction physicalSmallBigFullPhasedAction physicalSmallBigPhasedAction
  apply sum_congr rfl
  intro e _
  change physicalSmallBigEventWeight Vs q 0 aux (fun _ => 1)
    (PhysicalSmallBigFullEvent n shared B Δ D)
    (fun r d x e => (physicalSmallBigFullWeight n shared B Δ D μ ρ V r d x e : ℂ) * 1)
    (fun x => kbig (productActiveMemorySplit shared B x).1) s e * _ = _
  rw [physical_small_big_event_weight_phase]
  simp only [physicalPhase, zero_mul, Complex.ofReal_zero, Complex.exp_zero, mul_one]

end

theorem exists_physical_small_big_phased_energy_bound
    {q vs : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hvs : 0 < vs) (ell : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (S G : Type) [Fintype S] [DecidableEq S]
      [Fintype G] [DecidableEq G]
      (Ps : S → Finset ℕ) [∀ p : PhysicalPrime Ps, NeZero p.2.val]
      (P : G → Type) [∀ g, Fintype (P g)] (n : ∀ g, P g → ℕ)
      [∀ g p, NeZero (n g p)] (J : ℕ) (M : G → ℕ)
      (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
      (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
      (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
      (kbig : SharedActiveLabels P shared → ℤ)
      (Vs : S → ℝ), (∀ s, vs ≤ Vs s) →
      ∀ (_aux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))))
        (v vmin vmax : ℝ), 0 < ρ → ρ < 1 → 1 < v → 0 < vmin →
      (∀ g, vmin ≤ V g) → (∀ g, V g ≤ vmax) →
      (∀ g p, 0 ≤ μ g p) → (∀ g, ∑ p, μ g p ≤ 2) →
      ∀ (T : ℕ), (∀ g, (shared g)ᶜ.card ≤ T) →
      ∀ (Φ : ∀ s : PhysicalSmallBigState Ps J ell
        (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B),
        PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B Δ D) s → ℂ)
        (H : ℝ), 0 ≤ H → (∀ s e, ‖Φ s e‖ ≤ H) →
      ∀ (F : PhysicalSmallBigState Ps J ell
        (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ),
      (∀ s, ProductMemorySymmetric (fun x => F (s, x))) →
      physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
        (physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q Φ F) ≤
        H ^ 2 * (A ^ (2 * Fintype.card S) *
          unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G) *
          physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) F := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_small_big_full_energy_bound hq0 hq1 hvs ell
  refine ⟨A, hA, ?_⟩
  intro S G _ dS _ dG
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  intro Ps _ P _ n _ J M shared B Δ D μ ρ V kbig Vs hVs aux
    v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht Φ H hH hΦ F hF
  let W : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℝ :=
    productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))
  have hW : ∀ x, 0 ≤ W x := productMemoryWeight_nonneg μ _ hμ (fun g z => hμ g z.1)
  have hVs' : ∀ s, 0 < Vs s := fun s => hvs.trans_le (hVs s)
  have hFn : ∀ s, ProductMemorySymmetric (fun x => complexNormEnvelope F (s, x)) := by
    intro s x g τ
    exact congrArg (fun z : ℂ => (‖z‖ : ℂ)) (hF s x g τ)
  have hp := hbound S G Ps P n J M shared B Δ D μ ρ V kbig Vs hVs
    0 aux (fun _ => 1) 1 zero_le_one (by intro; simp only [norm_one, le_refl])
    v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht
    (fun _ _ _ _ => 1) 1 zero_le_one (by intros; simp only [norm_one, le_refl])
    (complexNormEnvelope F) hFn
  rw [physical_small_big_full_positive_eq] at hp
  simp only [one_pow, mul_one, one_mul] at hp
  rw [← physical_small_big_energy_eq, ← physical_small_big_energy_eq,
    complexNormEnvelope_energy] at hp
  rw [← physical_small_big_energy_eq, ← physical_small_big_energy_eq]
  apply finite_weighted_energy_of_scaled_norm (physicalSmallBigMeasure Vs W)
    (physical_small_big_measure_nonneg Vs hVs' W hW) H hH
    (A ^ (2 * Fintype.card S) * unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G)
    F _ _ _ hp
  intro s
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hH]
  change ‖physicalSmallBigPhasedAction _ _ _ _ _ _ Φ F s‖ ≤
    H * ‖physicalSmallBigPhasedAction _ _ _ _ _ _ (fun _ _ => 1)
      (fun y => (‖F y‖ : ℂ)) s‖
  rw [physical_small_big_positive_norm Vs hVs' q _ _ _
    (physical_small_big_full_weight_nonneg n shared B Δ D μ ρ V hμ hρ0.le
      (fun g => (hvmin.trans_le (hVlo g)).le))]
  exact physical_small_big_phase_norm_le Vs hVs' q _ _ _
    (physical_small_big_full_weight_nonneg n shared B Δ D μ ρ V hμ hρ0.le
      (fun g => (hvmin.trans_le (hVlo g)).le)) _ Φ H hΦ F s

end Bounty
end

section

/- The actual reverse-promotion operator, including its volume ratios,
has the same energy constant as storage. This remains true after the full
shared-label lift and inversion of external residue translations. -/

open Finset Classical

namespace Bounty

theorem full_active_reverse_promotion_external_energy_le
    {G R : Type*} [Fintype G] [DecidableEq G] [Fintype R]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
    {A : SharedActiveLabels P S → Type*} [∀ c, Fintype (A c)]
    (Δ D : ∀ c, A c → G → ℤ) (ω : ∀ c, A c → ℝ)
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ) (τ : ∀ c, A c → R ≃ R)
    (hω : ∀ c a, 0 ≤ ω c a) (hωmass : ∀ c, ∑ a, ω c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, (S g)ᶜ.card ≤ T)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → R → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun x => f x r)) :
    (∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fun x => fullActiveReversePromotionExternal n S B Δ D ω μ ρ V τ f x r)) ≤
      unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        ∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
          (fun x => f x r) := by
  apply equiv_external_fiber_average_energy_le (productActiveMemorySplit S B)
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) (sharedActiveWeight S μ)
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productActiveMemorySplit_weight_symm S B μ _) (sharedActiveWeight_nonneg S μ hμ)
    (productMemoryWeight_nonneg μ _ hμ (fun g z => hμ g z.1)) ω hω hωmass _
    (fun c a => (τ c a).symm) f (pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _)
  intro c a r
  exact unrestricted_reverse_promotion_only_product_energy_le n (Δ c a) (D c a) μ ρ V
    (fun g => (S g)ᶜ.card) B hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht _
    (productActiveMemorySlice_symmetric S B (fun x => f x r) (hf r) c)

end Bounty
end

section

/- Norm envelopes of averaged inputs remain fixed by small-slot averaging.
This permits the genuine two-sided storage estimate to be used in positive
domination of an arbitrary endpoint-dependent dirty coefficient. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_small_big_average_add
    {S X : Type*} [Fintype S] [DecidableEq S]
    {P : S → Finset ℕ} {J ell : ℕ}
    (F G : PhysicalSmallBigState P J ell X → ℂ) :
    physicalSmallBigAverage (F + G) = physicalSmallBigAverage F + physicalSmallBigAverage G := by
  funext s
  simp only [physicalSmallBigAverage, Pi.add_apply, sum_add_distrib, mul_add]

theorem physical_small_big_average_of_invariant
    {S X : Type*} [Fintype S] [DecidableEq S]
    {P : S → Finset ℕ} {J ell : ℕ}
    (F : PhysicalSmallBigState P J ell X → ℂ)
    (hF : ∀ (σ : PhysicalPermutations S J ell) s, F (physicalSmallBigPermutation σ s) = F s) :
    physicalSmallBigAverage F = F := by
  funext s
  unfold physicalSmallBigAverage
  simp only [hF, sum_const, card_univ, nsmul_eq_mul]
  rw [← mul_assoc, inv_mul_cancel₀, one_mul]
  exact_mod_cast (Fintype.card_ne_zero : Fintype.card (PhysicalPermutations S J ell) ≠ 0)

theorem physical_small_big_average_envelope_fixed
    {S X : Type*} [Fintype S] [DecidableEq S]
    {P : S → Finset ℕ} {J ell : ℕ}
    (F : PhysicalSmallBigState P J ell X → ℂ) :
    physicalSmallBigAverage (complexNormEnvelope (physicalSmallBigAverage F)) =
      complexNormEnvelope (physicalSmallBigAverage F) := by
  apply physical_small_big_average_of_invariant
  intro σ s
  simp only [complexNormEnvelope, physical_small_big_average_invariant]

theorem physical_small_big_average_envelope_energy_le
    {S X : Type*} [Fintype S] [DecidableEq S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (hV : ∀ s, 0 < V s) (W : X → ℝ) (hW : ∀ x, 0 ≤ W x)
    (F : PhysicalSmallBigState P J ell X → ℂ) :
    physicalSmallBigEnergy V W (complexNormEnvelope (physicalSmallBigAverage F)) ≤
      physicalSmallBigEnergy V W F := by
  calc
    _ = physicalSmallBigEnergy V W (physicalSmallBigAverage F) := by
      simp only [physicalSmallBigEnergy, complexNormEnvelope_norm]
    _ ≤ _ := physical_small_big_average_energy_le V hV W hW F

theorem physical_small_big_average_norm_domination
    {S X : Type*} [Fintype S] [DecidableEq S]
    {P : S → Finset ℕ} {J ell : ℕ}
    (F G : PhysicalSmallBigState P J ell X → ℂ)
    (hdom : ∀ s, ‖F s‖ ≤ (G s).re)
    (s : PhysicalSmallBigState P J ell X) :
    ‖physicalSmallBigAverage F s‖ ≤ (physicalSmallBigAverage G s).re := by
  have hc : 0 ≤ (Fintype.card (PhysicalPermutations S J ell) : ℝ)⁻¹ :=
    inv_nonneg.mpr (Nat.cast_nonneg _)
  have hf : ‖physicalSmallBigAverage F s‖ ≤
      (Fintype.card (PhysicalPermutations S J ell) : ℝ)⁻¹ *
        ∑ σ : PhysicalPermutations S J ell, ‖F (physicalSmallBigPermutation σ s)‖ := by
    unfold physicalSmallBigAverage
    rw [norm_mul, ← Complex.ofReal_natCast, ← Complex.ofReal_inv,
      Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hc]
    exact mul_le_mul_of_nonneg_left (norm_sum_le _ _) hc
  apply hf.trans
  calc
    _ ≤ (Fintype.card (PhysicalPermutations S J ell) : ℝ)⁻¹ *
        ∑ σ : PhysicalPermutations S J ell, (G (physicalSmallBigPermutation σ s)).re :=
      mul_le_mul_of_nonneg_left (sum_le_sum fun σ _ => hdom _) hc
    _ = _ := by
      simp only [physicalSmallBigAverage, ← Complex.ofReal_natCast, ← Complex.ofReal_inv,
        Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero, Complex.re_sum]

end Bounty
end

section

/- The original complex full-mixed action with its actual forest mask is bounded by original positive mass. -/

open Finset Classical

namespace Bounty

section Mixed
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
    {M : Fin N → ℕ} (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
    (Δ D : ∀ k c, A k c → Fin N → ℤ) (ω : ∀ k c, A k c → ℝ)
    (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (steps : List (Option (J ⊕ K)))
    (Q : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → Prop)
    (phase : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)

include hphase

theorem full_mixed_masked_path_norm_le_integral :
    ‖fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps
      (fun s p => if Q s p
        then phase s p else 0) f s‖ ≤
    fullMixedPathAbsIntegral n S B A Δ D ω μ q ρ V steps s
      (fun p => if Q s p
        then ‖f (finiteEventPathTerminal (FullPermutationMixedEvent n S B A Δ D)
          (fullPermutationMixedEventTarget n S B A Δ D) steps s p)‖ else 0) := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
    fullPermutationMixedEventFintype n S B A Δ D
  exact finite_event_masked_path_norm_le_abs_integral (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V)
    steps Q phase hphase f s

theorem full_mixed_masked_path_norm_le_mass (L : ℝ) (hf : ∀ y, ‖f y‖ ≤ L) :
    ‖fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps
      (fun s p => if Q s p
        then phase s p else 0) f s‖ ≤
    L * fullMixedPathAbsIntegral n S B A Δ D ω μ q ρ V steps s
      (fun p => if Q s p
        then 1 else 0) := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
    fullPermutationMixedEventFintype n S B A Δ D
  exact finite_event_masked_path_norm_le_mass (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V)
    steps Q phase hphase f s L hf

end Mixed
end Bounty
