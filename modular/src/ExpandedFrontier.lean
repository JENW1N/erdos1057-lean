        (productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (baseline g))
          (fun g => unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g (baseline g)))) f := by
  let _ : ∀ g (p : P g), NeZero p.val := fun g p => ⟨Nat.ne_of_gt (hpositive g p)⟩
  apply unrestricted_coupled_cutoff_product_energy_le (fun g (p : P g) => p.val) Δ D
    (fun g => tiltedPhysicalBirthLaw V g (baseline g)) ρ V t B hρ0 hρ1 hv hvmin hVlo hVhi
    _ _ T ht phase hphase f hf
  · intro g p
    exact tiltedPhysicalBirthLaw_nonneg V g (baseline g) (hvmin.trans_le (hVlo g)).le
      (fun q => (by norm_num : (0 : ℝ) ≤ 1 / 2).trans (hbaseline g q).1) p
  · intro g
    exact (tiltedPhysicalBirthLaw_sum_bounds V g (baseline g)
      (hvmin.trans_le (hVlo g)) (hMass g) (hbaseline g)).2

/-- Logarithmically many physical big groups have a polynomial energy loss,
also for a phase that couples all simultaneous group events. -/
theorem physical_coupled_cutoff_product_energy_le_rpow
    {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (V : G → ℝ) (baseline : ∀ g, P g → ℝ)
    (hpositive : ∀ g (p : P g), 0 < p.val)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (hbaseline : ∀ g p, 1 / 2 ≤ baseline g p ∧ baseline g p ≤ 1)
    (Δ D : G → ℤ) {ρ v vmin vmax : ℝ}
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (t : G → ℕ) (B T : ℕ) (ht : ∀ g, t g ≤ T)
    (phase : UnrestrictedProductPhase (fun g (p : P g) => p.val) Δ D t B)
    (hphase : ∀ s e, ‖phase s e‖ ≤ 1) {L K : ℝ} (hL : 0 < L)
    (hcard : (Fintype.card G : ℝ) ≤ K * Real.log L)
    (f : ProductBoundedOrderedState (fun g => P g)
      (fun g => UnrestrictedResidueParticle (fun p : P g => p.val)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    let _ : ∀ g (p : P g), NeZero p.val := fun g p => ⟨Nat.ne_of_gt (hpositive g p)⟩
    finiteWeightedEnergy
      (productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (baseline g))
        (fun g => unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g (baseline g))))
      (unrestrictedCoupledCutoffProductOperator (fun g (p : P g) => p.val) Δ D
        (fun g => tiltedPhysicalBirthLaw V g (baseline g)) ρ V t B phase f) ≤
      L ^ (K * Real.log (max 1 (unrestrictedEdgeEnergyBound ρ v vmin vmax T))) *
        finiteWeightedEnergy
          (productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (baseline g))
            (fun g => unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g (baseline g)))) f := by
  let _ : ∀ g (p : P g), NeZero p.val := fun g p => ⟨Nat.ne_of_gt (hpositive g p)⟩
  have he := physical_coupled_cutoff_product_energy_le P V baseline hpositive hMass
    hbaseline Δ D hρ0 hρ1 hv hvmin hVlo hVhi t B T ht phase hphase f hf
  apply group_energy_bound_of_log_card (univ : Finset G)
    (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) hL _
    (by simpa only [card_univ] using hcard) (by simpa only [card_univ] using he)
  apply sum_nonneg
  intro s hs
  apply mul_nonneg _ (sq_nonneg _)
  exact (physical_product_memory_weight_pos P V baseline
    (fun g => hvmin.trans_le (hVlo g)) hpositive
    (fun g p => lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1 / 2) (hbaseline g p).1)
    t B s).le
end

