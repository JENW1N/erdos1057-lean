open Finset Filter
open scoped Topology
noncomputable def candidateRoughSlot (c L : ℝ) (r jStar : ℕ) (hr : 0 < r)
    (hj : jStar ∈ candidateQIndices c L) : (candidateQIndices c L) × Fin r :=
  (⟨jStar, hj⟩, ⟨0, hr⟩)

theorem candidate_Q_choices_eq_single_rough (c L : ℝ) (r jStar : ℕ) (hr : 0 < r)
    (hj : jStar ∈ candidateQIndices c L) :
    candidateQSlotChoices c L r jStar =
      fun slot => if slot = candidateRoughSlot c L r jStar hr hj then candidateRoughBand c L jStar
        else candidateQBand (c * L) slot.1.val := by
  funext slot
  have hiff : (slot.1.val = jStar ∧ slot.2.val = 0) ↔
      slot = candidateRoughSlot c L r jStar hr hj := by
    constructor
    · intro h
      exact Prod.ext (Subtype.ext h.1) (Fin.ext h.2)
    · intro h
      subst slot
      exact ⟨rfl, rfl⟩
  simp only [candidateQSlotChoices, hiff]

theorem candidate_Q_choices_eq_pure {c L : ℝ} {r jStar : ℕ}
    (hj : jStar ∉ candidateQIndices c L) :
    candidateQSlotChoices c L r jStar =
      fun slot => candidateQBand (c * L) slot.1.val := by
  funext slot
  have hnot : ¬(slot.1.val = jStar ∧ slot.2.val = 0) := by
    intro h
    exact hj (h.1 ▸ slot.1.property)
  exact if_neg hnot

theorem candidate_Q_group_disjoint {c L : ℝ} (hcL : 0 ≤ c * L) :
    Pairwise (fun i j : candidateQIndices c L =>
      Disjoint (candidateQBand (c * L) i.val) (candidateQBand (c * L) j.val)) := by
  have hpair : Pairwise (fun i j : ℕ =>
      Disjoint (candidateQBand (c * L) i) (candidateQBand (c * L) j)) :=
    pairwise_disjoint_dyadicPrimeBand hcL (by norm_num) (by norm_num)
  intro i j hij
  exact hpair (fun h => hij (Subtype.ext h))

theorem candidate_Q_weight_le_one_of_rough_absent {c L : ℝ} {r jStar : ℕ}
    (hcL : 0 ≤ c * L) (hj : jStar ∉ candidateQIndices c L) (n : ℕ) :
    candidateQWeight c L r jStar n ≤ 1 := by
  rw [candidateQWeight, candidate_Q_choices_eq_pure hj]
  simpa only [Fintype.card_coe] using
    grouped_prime_slot_weight_le_one
      (fun j : candidateQIndices c L => candidateQBand (c * L) j.val) r
      (fun _ _ hp => (mem_filter.mp hp).2) (candidate_Q_group_disjoint hcL) n

theorem eventually_candidateQBand_nonempty {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ j ∈ candidateQIndices c L, (candidateQBand (c * L) j).Nonempty := by
  obtain ⟨v, V, hv, _, hband⟩ := exists_candidateQBands_bounds hc
  filter_upwards [hband] with L hL
  intro j hj
  by_contra hempty
  have hm := (hL.2.2 j hj).2.2.1
  rw [not_nonempty_iff_eq_empty.mp hempty, sum_empty] at hm
  linarith
end

