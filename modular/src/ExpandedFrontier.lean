/- The vacuum-to-vacuum scalar of a full permutation/ghost/edge trajectory,
with phase comparisons restricted to the paths which contribute. -/

open Finset Classical

namespace Bounty

section

variable {J K G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  {M : G → ℕ} (S : K → ∀ g, Finset (Fin (M g)))
  (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
  (Δ D : ∀ k c, A k c → G → ℤ)
  (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)
  (steps : List (Option (J ⊕ K)))

noncomputable def fullPermutationVacuumScalar (B : ℕ)
    (phase : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → ℂ) : ℂ :=
  ∑ s, (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)) s : ℂ) *
    fullMemoryVacuum s *
      fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps phase fullMemoryVacuum s

theorem full_permutation_vacuum_scalar_congr (B : ℕ)
    (phase ψ : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → ℂ)
    (hphase : ∀ s p, fullMemoryVacuum s ≠ 0 →
      finiteEventPathWeight (FullPermutationMixedEvent n S B A Δ D)
        (fullPermutationMixedEventTarget n S B A Δ D)
        (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V) steps s p ≠ 0 →
      phase s p = ψ s p) :
    fullPermutationVacuumScalar n S A Δ D ω μ q ρ V steps B phase =
      fullPermutationVacuumScalar n S A Δ D ω μ q ρ V steps B ψ := by
  unfold fullPermutationVacuumScalar
  apply sum_congr rfl
  intro s _
  by_cases hs : fullMemoryVacuum s = 0
  · simp only [hs, mul_zero, zero_mul]
  · congr 1
    let _ : ∀ (k : Option (J ⊕ K)) x, Fintype (FullPermutationMixedEvent n S B A Δ D k x) :=
      fullPermutationMixedEventFintype n S B A Δ D
    exact finite_event_path_action_congr_on_support _ _ _ steps phase ψ fullMemoryVacuum s
      (fun p hp => hphase s p hs hp)

def FullPermutationCapConsistentPhases
    (phase : ∀ B s, FullPermutationMixedPath n S B A Δ D steps s → ℂ) : Prop :=
  ∀ (b B : ℕ) (h : b ≤ B) s p, fullMemoryVacuum s ≠ 0 →
    finiteEventPathWeight (FullPermutationMixedEvent n S b A Δ D)
      (fullPermutationMixedEventTarget n S b A Δ D)
      (fullPermutationMixedEventWeight n S b A Δ D ω μ q ρ V) steps s p ≠ 0 →
    phase b s p = fullPermutationMixedCapPhase n S A Δ D h ω μ q ρ V steps (phase B) s p

end

end Bounty
