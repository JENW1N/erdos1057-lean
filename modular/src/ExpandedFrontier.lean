/- The genuine window cutoff separates normalized four-factor harmonic polynomials. -/

open Finset MeasureTheory

namespace Bounty

private theorem box_weight_eq_phase_div (s x : ℝ) :
    harmonicMellinWeight s x = physicalMellinPhase s x / (x : ℂ) := by
  unfold harmonicMellinWeight physicalMellinPhase
  rw [mul_comm Complex.I]

private theorem normalized_box_phase_ratio {Y x : ℝ} (hY : 0 < Y) (hx : 0 < x)
    (s u : ℝ) :
    physicalMellinPhase s x * physicalMellinPhase (2 * Real.pi * u) (x / Y) =
      physicalMellinPhase (-2 * Real.pi * u) Y *
        physicalMellinPhase (s + 2 * Real.pi * u) x := by
  unfold physicalMellinPhase
  rw [Real.log_div hx.ne' hY.ne']
  simp only [← Complex.exp_add]
