/- Selected rows depend on continuations only at their prescribed target marks. -/

open Finset Classical
namespace Bounty

theorem physical_mark_raw_extension_marks_congr {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (L : PhysicalMarkLists P J ell) (F G : PhysicalBoundedMarkState P J ell B → ℂ)
    (hFG : ∀ t, t.1 = L → F t = G t) :
    physicalMarkRawExtension F L = physicalMarkRawExtension G L := by
  funext u
  unfold physicalMarkRawExtension
  split_ifs
  · exact hFG _ rfl
  · rfl

section Rows
variable {I K : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (retention : I → ℝ)
  (ρ : ℝ) (V : Fin N → ℝ) (hV : ∀ g, V g ≠ 0)

theorem physical_selected_visit_marks_congr (j : I)
    (L : PhysicalMarkLists P J ell) (F G : PhysicalBoundedMarkState P J ell B → ℂ)
    (hFG : ∀ t, t.1 = L → F t = G t) (s : PhysicalBoundedMarkState P J ell B) :
    physicalObservedMarkRow C k ω β retention ρ V hV (some (.inl j))
      (fun o t => if o = .inr none ∧ t.1 = L then F t else 0) s =
    physicalObservedMarkRow C k ω β retention ρ V hV (some (.inl j))
      (fun o t => if o = .inr none ∧ t.1 = L then G t else 0) s := by
  apply congrArg (fun f => physicalObservedMarkRow C k ω β retention ρ V hV (some (.inl j)) f s)
  funext o t
  split_ifs with h
  · exact hFG t h.2
  · rfl

theorem physical_selected_edge_marks_congr (j : K)
    (aux : PhysicalAuxLabels P (C j)) (σ τ : PhysicalPermutations (Fin N) J ell)
    (R : PhysicalMarkLists P J ell) (F G : PhysicalBoundedMarkState P J ell B → ℂ)
    (hFG : ∀ t, t.1 = R → F t = G t) (s : PhysicalBoundedMarkState P J ell B) :
    physicalSelectedStateEdgeBlock C k ω β retention ρ V hV j aux σ τ R F s =
      physicalSelectedStateEdgeBlock C k ω β retention ρ V hV j aux σ τ R G s := by
  rw [physical_selected_state_edge_block_eq, physical_selected_state_edge_block_eq,
    physical_mark_raw_extension_marks_congr R F G hFG]

theorem physical_selected_edge_zero_of_nonadmissible (j : K)
    (aux : PhysicalAuxLabels P (C j)) (σ τ : PhysicalPermutations (Fin N) J ell)
    (L R : PhysicalMarkLists P J ell)
    (hbad : ¬ physicalListAdmissible (C j) aux (physicalPermuteLabels σ L) (physicalPermuteLabels τ R))
    (F : PhysicalBoundedMarkState P J ell B → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) (hs : s.1 = L) :
    physicalSelectedStateEdgeBlock C k ω β retention ρ V hV j aux σ τ R F s = 0 := by
  rw [physical_selected_state_edge_block_eq, hs, if_neg hbad, mul_zero]

end Rows
end Bounty
