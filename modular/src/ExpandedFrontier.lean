open Finset Classical
theorem full_memory_vacuum_pairing_energy_le
    {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hν : ∀ g z, 0 ≤ ν g z)
    (M : G → ℕ) (B : ℕ) (F : ProductBoundedOrderedState P Z M B → ℂ) :
    ‖∑ s, (productMemoryWeight μ ν s : ℂ) * fullMemoryVacuum s * F s‖ ^ 2 ≤
      (∏ g, (∑ p, μ g p) ^ M g) * finiteWeightedEnergy (productMemoryWeight μ ν) F := by
  have h := finite_indicator_pairing_energy_le (productMemoryWeight μ ν)
    (productMemoryWeight_nonneg μ ν hμ hν)
    (fun s : ProductBoundedOrderedState P Z M B => ∀ g, (s g).2.1.val = 0) F
  change ‖∑ s, (productMemoryWeight μ ν s : ℂ) * fullMemoryVacuum s * F s‖ ^ 2 ≤
    finiteWeightedEnergy (productMemoryWeight μ ν) (fullMemoryVacuum (M := M) (B := B)) *
      finiteWeightedEnergy (productMemoryWeight μ ν) F at h
  rw [fullMemoryVacuum_energy] at h
  exact h

theorem full_memory_vacuum_pairing_le_of_energy
    {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hν : ∀ g z, 0 ≤ ν g z)
    (M : G → ℕ) (B : ℕ) (F : ProductBoundedOrderedState P Z M B → ℂ)
    {C : ℝ}
    (hF : finiteWeightedEnergy (productMemoryWeight μ ν) F ≤
      C * finiteWeightedEnergy (productMemoryWeight μ ν) (fullMemoryVacuum (M := M) (B := B))) :
    ‖∑ s, (productMemoryWeight μ ν s : ℂ) * fullMemoryVacuum s * F s‖ ^ 2 ≤
      C * (∏ g, (∑ p, μ g p) ^ M g) ^ 2 := by
  have h := finite_indicator_pairing_le_of_energy (productMemoryWeight μ ν)
    (productMemoryWeight_nonneg μ ν hμ hν)
    (fun s : ProductBoundedOrderedState P Z M B => ∀ g, (s g).2.1.val = 0) F hF
  change ‖∑ s, (productMemoryWeight μ ν s : ℂ) * fullMemoryVacuum s * F s‖ ^ 2 ≤
    C * (finiteWeightedEnergy (productMemoryWeight μ ν)
      (fullMemoryVacuum (M := M) (B := B))) ^ 2 at h
  rw [fullMemoryVacuum_energy] at h
  exact h
end

