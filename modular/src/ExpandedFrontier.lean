section

/- Coherent continuation substitution for original selected physical rows. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def PhysicalMarkCoherent {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (L : PhysicalMarkLists P J ell) (s : PhysicalBoundedMarkState P J ell B) : Prop :=
  s.1 = L ∧ GlobalBirthJointCoherent (fun g => physicalGroupPhaseActivity L g) (physicalMarkRawReadout s)

theorem physical_mark_raw_extension_coherent_congr {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (L : PhysicalMarkLists P J ell) (F G : PhysicalBoundedMarkState P J ell B → ℂ)
    (hFG : ∀ t, PhysicalMarkCoherent L t → F t = G t)
    (u : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val))
    (hu : GlobalBirthJointCoherent (fun g => physicalGroupPhaseActivity L g) u) :
    physicalMarkRawExtension F L u = physicalMarkRawExtension G L u := by
  unfold physicalMarkRawExtension
  split_ifs with hc
  · exact hFG _ ⟨rfl, hu⟩
  · rfl

theorem physical_mark_raw_extension_zero {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (L : PhysicalMarkLists P J ell) :
    physicalMarkRawExtension (fun _ : PhysicalBoundedMarkState P J ell B => 0) L = fun _ => 0 := by
  funext u
  unfold physicalMarkRawExtension
  split_ifs <;> rfl

section Rows
variable {I K : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (retention : I → ℝ)
  (ρ : ℝ) (V : Fin N → ℝ) (hV : ∀ g, V g ≠ 0)

variable [∀ g, ∀ p : ↥(P g), NeZero p.val]

theorem physical_selected_visit_coherent_congr (j : I)
    (L : PhysicalMarkLists P J ell) (F G : PhysicalBoundedMarkState P J ell B → ℂ)
    (hFG : ∀ t, PhysicalMarkCoherent L t → F t = G t)
    (s : PhysicalBoundedMarkState P J ell B) (hs : PhysicalMarkCoherent L s) :
    physicalObservedMarkRow C k ω β retention ρ V hV (some (.inl j))
      (fun o t => if o = .inr none ∧ t.1 = L then F t else 0) s =
    physicalObservedMarkRow C k ω β retention ρ V hV (some (.inl j))
      (fun o t => if o = .inr none ∧ t.1 = L then G t else 0) s := by
  rw [← hs.1, physical_observed_selected_state_visit, physical_observed_selected_state_visit]
  apply global_birth_joint_cut_raw_row_congr
  · intro u hu
    apply physical_mark_raw_extension_coherent_congr
    · intro t ht
      apply hFG
      simpa only [hs.1] using ht
    · exact hu
  · simpa only [hs.1] using hs.2

omit [∀ g, ∀ p : ↥(P g), NeZero p.val] in
theorem physical_selected_visit_zero (j : I) (L : PhysicalMarkLists P J ell)
    (s : PhysicalBoundedMarkState P J ell B) (hs : s.1 = L) :
    physicalObservedMarkRow C k ω β retention ρ V hV (some (.inl j))
      (fun o t => if o = .inr none ∧ t.1 = L then 0 else 0) s = 0 := by
  rw [← hs, physical_observed_selected_state_visit, physical_mark_raw_extension_zero]
  simpa only [zero_mul] using global_birth_joint_cut_raw_row_mul
    (fun g => GlobalBirthRawStep.visit (a := physicalGroupPhaseActivity s.1 g)
      (fun _ => 0) (β g) (1 - retention j) (V g) ρ (hV g) B) B B 0
    (fun _ => 0) (physicalMarkRawReadout s)

theorem physical_selected_edge_coherent_congr (j : K)
    (aux : PhysicalAuxLabels P (C j)) (σ τ : PhysicalPermutations (Fin N) J ell)
    (L R : PhysicalMarkLists P J ell)
    (hlist : physicalListAdmissible (C j) aux (physicalPermuteLabels σ L) (physicalPermuteLabels τ R))
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hk : ∀ g s, ¬ ((L g s).val : ℤ) ∣ k j)
    (F G : PhysicalBoundedMarkState P J ell B → ℂ)
    (hFG : ∀ t, PhysicalMarkCoherent R t → F t = G t)
    (s : PhysicalBoundedMarkState P J ell B) (hs : PhysicalMarkCoherent L s) :
    physicalSelectedStateEdgeBlock C k ω β retention ρ V hV j aux σ τ R F s =
      physicalSelectedStateEdgeBlock C k ω β retention ρ V hV j aux σ τ R G s := by
  simp only [physical_selected_state_edge_block_eq, hs.1, if_pos hlist]
  congr 1
  apply physical_raw_tensor_coherent_congr (C j) aux (k j)
    (physicalPermuteLabels σ L) (physicalPermuteLabels τ R) hlist hP hdis
    (fun g i => hk g (σ g i)) β ρ V
  · intro u hu
    apply physical_mark_raw_extension_coherent_congr R F G hFG
    simpa only [physical_group_phase_activity_permute] using hu
  · simpa only [physical_group_phase_activity_permute] using hs.2

omit [∀ g, ∀ p : ↥(P g), NeZero p.val] in
theorem physical_selected_edge_zero (j : K)
    (aux : PhysicalAuxLabels P (C j)) (σ τ : PhysicalPermutations (Fin N) J ell)
    (R : PhysicalMarkLists P J ell) (s : PhysicalBoundedMarkState P J ell B) :
    physicalSelectedStateEdgeBlock C k ω β retention ρ V hV j aux σ τ R (fun _ => 0) s = 0 := by
  rw [physical_selected_state_edge_block_eq, physical_mark_raw_extension_zero]
  split_ifs
  · rw [physical_full_edge_tensor_zero, mul_zero]
  · exact mul_zero _

omit [∀ g, ∀ p : ↥(P g), NeZero p.val] in
omit [∀ g, ∀ p : ↥(P g), NeZero p.val] in
theorem physical_selected_edge_zero_of_bad (j : K)
    (aux : PhysicalAuxLabels P (C j)) (σ τ : PhysicalPermutations (Fin N) J ell)
    (L R : PhysicalMarkLists P J ell)
    (hlist : physicalListAdmissible (C j) aux (physicalPermuteLabels σ L) (physicalPermuteLabels τ R))
    (hbad : ¬ ∀ g a b,
      ((physicalPermuteLabels σ L) g a).val = ((physicalPermuteLabels τ R) g b).val →
      (((physicalPermuteLabels σ L) g a).val : ℤ) ∣
        k j * (physicalD (C j) (physicalPermuteLabels σ L) aux : ℤ))
    (F : PhysicalBoundedMarkState P J ell B → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) (hs : PhysicalMarkCoherent L s) :
    physicalSelectedStateEdgeBlock C k ω β retention ρ V hV j aux σ τ R F s = 0 := by
  rw [physical_selected_state_edge_block_eq, hs.1, if_pos hlist]
  rw [physical_raw_tensor_zero_of_bad_edge (C j) aux (k j)
    (physicalPermuteLabels σ L) (physicalPermuteLabels τ R) hlist β ρ V hbad]
  · exact mul_zero _
  · simpa only [physical_group_phase_activity_permute] using hs.2

end Rows
end Bounty
end

section

/- Global nonprincipal Mellin cancellation for the actual count-matched rough-test proxy. -/

open Finset Filter

namespace Bounty

theorem eventually_rough_test_logarithmic_proxy_mellin_power_bound {a S T γ : ℝ}
    (ha : 0 < a) (hγ : 0 < γ) (hS : 0 ≤ S) (hT : 0 ≤ T) (Bsave : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, Real.exp (a*L) ≤ Y →
      ∀ (r : ℕ) [NeZero r] (χ : DirichletCharacter ℂ r), χ ≠ 1 → (r : ℝ) ≤ L^T →
      ∀ v : ℝ, |v| ≤ L^T → ∀ m n : ℕ, m ≤ n → Y ≤ (m+1 : ℕ) → (n : ℝ) ≤ 2*Y →
        ‖∑ i ∈ Ioc m n, (roughTestLogarithmicProxy γ L S i : ℂ)*
            harmonicMellinWeight v i*χ (i : ZMod r)‖ ≤ L^(-Bsave) := by
  classical
  have ha2 : 0 < a/2 := by positivity
  filter_upwards [eventually_logarithmic_cell_dyad_bounds ha hS,
    eventually_rough_test_proxy_cell_mellin_power_bound ha2 hγ hT S (Bsave+S+1)]
    with L hcells hlocal
  have hL := hcells.1
  have hδ : 0 < L^(-S) := Real.rpow_pos_of_pos hL _
  intro Y hY r hr χ hχ hrT v hv m n _hmn hYm hn
  let F := Ioc m n
  let f := fun i : ℕ => (roughTestLogarithmicProxy γ L S i : ℂ)*
    harmonicMellinWeight v i*χ (i : ZMod r)
  have hF : ∀ i ∈ F, Y ≤ (i : ℝ) ∧ (i : ℝ) ≤ 2*Y := by
    intro i hi
    exact ⟨hYm.trans (Nat.cast_le.mpr (mem_Ioc.mp hi).1),
      (Nat.cast_le.mpr (mem_Ioc.mp hi).2).trans hn⟩
  obtain ⟨hcount, hbases⟩ := hcells.2 Y hY F hF
  have hYsmall : Real.exp ((a/2)*L) ≤ Y := by
    apply le_trans _ hY
    exact Real.exp_le_exp.mpr (by nlinarith)
  have hfiber : ∀ k ∈ logarithmicCellIndices (L^(-S)) F,
      ‖∑ i ∈ F.filter (fun i => logarithmicCellIndex (L^(-S)) i = k), f i‖ ≤
        L^(-(Bsave+S+1)) := by
    intro k hk
    let Z := logarithmicCellBase (L^(-S)) k
    let lo := max m ⌊Z⌋₊
    let hi := min n ⌊Real.exp (L^(-S))*Z⌋₊
    have heq : (∑ i ∈ F.filter (fun i => logarithmicCellIndex (L^(-S)) i = k), f i) =
        ∑ i ∈ Ioc lo hi, (roughTestCellProxy γ L S Z i : ℂ)*harmonicMellinWeight v i*χ (i : ZMod r) := by
      change (∑ i ∈ (Ioc m n).filter (fun i => logarithmicCellIndex (L^(-S)) i = k), f i) = _
      rw [logarithmic_interval_fiber hδ]
      apply sum_congr rfl
      intro i hiI
      have hiC : i ∈ logarithmicCellSet (L^(-S)) k := mem_Ioc.mpr
        ⟨(le_max_right _ _).trans_lt (mem_Ioc.mp hiI).1,
          (mem_Ioc.mp hiI).2.trans (min_le_right _ _)⟩
      dsimp [f]
      rw [rough_test_logarithmic_proxy_eq_on_cell hL hiC]
    rw [heq]
    by_cases hlohi : lo ≤ hi
    · apply hlocal Y Z hYsmall (hbases k hk) r χ hχ hrT v hv lo hi hlohi
      · exact hYm.trans (Nat.cast_le.mpr (Nat.add_le_add_right (le_max_left _ _) 1))
      · exact (Nat.cast_le.mpr (min_le_left _ _)).trans hn
      · exact le_max_right _ _
      · exact min_le_right _ _
    · rw [Ioc_eq_empty_of_le (by omega : hi ≤ lo), sum_empty, norm_zero]
      positivity
  change ‖∑ i ∈ F, f i‖ ≤ _
  rw [← sum_logarithmic_cell_fibers (L^(-S)) F f]
  calc
    _ ≤ ∑ k ∈ logarithmicCellIndices (L^(-S)) F,
        ‖∑ i ∈ F.filter (fun i => logarithmicCellIndex (L^(-S)) i = k), f i‖ := norm_sum_le _ _
    _ ≤ ∑ _k ∈ logarithmicCellIndices (L^(-S)) F, L^(-(Bsave+S+1)) := sum_le_sum hfiber
    _ = ((logarithmicCellIndices (L^(-S)) F).card : ℝ)*L^(-(Bsave+S+1)) := by
      simp only [sum_const, nsmul_eq_mul]
    _ ≤ L^(S+1)*L^(-(Bsave+S+1)) := mul_le_mul_of_nonneg_right hcount (by positivity)
    _ = L^(-Bsave) := by rw [← Real.rpow_add hL]; congr 1; ring

end Bounty
end

section

/- Principal-character Mellin discrepancy for the actual global rough-test proxy. -/

open Finset Filter

namespace Bounty

theorem eventually_rough_test_proxy_mellin_difference_bound {a S T Bsave γ : ℝ}
    (ha : 0 < a) (hγ : 0 < γ) (hS : 0 ≤ S) (hT : 0 ≤ T) (hprecision : T+Bsave+2 ≤ S) :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, Real.exp (a*L) ≤ Y →
      ∀ v : ℝ, |v| ≤ L^T → ∀ m n : ℕ, m ≤ n → Y ≤ (m+1 : ℕ) → (n : ℝ) ≤ 2*Y →
        ‖∑ i ∈ Ioc m n,
          ((roughTestIndicator γ L i-roughTestLogarithmicProxy γ L S i : ℝ) : ℂ)*
            harmonicMellinWeight v i‖ ≤ L^(-Bsave) := by
  filter_upwards [eventually_rough_test_logarithmic_proxy_prefix_bound ha hγ hS,
    eventually_linear_exponential_profile_le_rpow ha ha 20 0 (Bsave+T),
    eventually_ge_atTop (10 : ℝ)] with L hpref hprofile hL10
  have hL : 0 < L := by linarith
  have hL1 : 1 ≤ L := by linarith
  intro Y hY v hv m n hmn hYm hn
  have hY0 : 0 < Y := (Real.exp_pos _).trans_le hY
  by_cases heq : m = n
  · subst n
    simp only [Ioc_self, sum_empty, norm_zero]
    positivity
  have hmn' : m < n := lt_of_le_of_ne hmn heq
  let g := fun i : ℕ => ((roughTestIndicator γ L i-roughTestLogarithmicProxy γ L S i : ℝ) : ℂ)
  have hh := norm_harmonic_mellin_interval_sum_le g hY0 hmn' hYm hn
    (v := v) (B := 8*L^(-S)*Y+2) (by positivity)
    (fun i hi => hpref Y hY m i hYm ((Nat.cast_le.mpr (mem_Icc.mp hi).2).trans hn))
  have hpow : 1 ≤ L^T := Real.one_le_rpow hL1 hT
  have hgain : 3+2*|v| ≤ 5*L^T := by nlinarith
  have hfirst : 40*L^T*L^(-S) ≤ L^(-Bsave)/2 := by
    have hcomp : L^(T-S) ≤ L^(-Bsave)/L^2 := by
      rw [show L^(-Bsave)/L^2 = L^(-Bsave+(-2)) by
        rw [Real.rpow_add hL, Real.rpow_neg hL.le]
        norm_num
        ring]
      apply Real.rpow_le_rpow_of_exponent_le hL1
      linarith
    calc
      _ = 40*L^(T-S) := by rw [sub_eq_add_neg, Real.rpow_add hL]; ring
      _ ≤ 40*(L^(-Bsave)/L^2) := mul_le_mul_of_nonneg_left hcomp (by norm_num)
      _ ≤ L^(-Bsave)/2 := by
        have hC : (40 : ℝ)/L^2 ≤ 1/2 := by
          apply (div_le_iff₀ (by positivity : (0 : ℝ) < L^2)).mpr
          nlinarith
        calc
          _ = (40/L^2)*L^(-Bsave) := by ring
          _ ≤ (1/2)*L^(-Bsave) := mul_le_mul_of_nonneg_right hC (by positivity)
          _ = _ := by ring
  have hsecond : 10*L^T/Y ≤ L^(-Bsave)/2 := by
    simp only [zero_mul, add_zero] at hprofile
    have hrecip : 1/Y ≤ Real.exp (-a*L) := by
      have hh := one_div_le_one_div_of_le (Real.exp_pos (a*L)) hY
      simpa only [one_div, Real.exp_neg, neg_mul] using hh
    calc
      _ = (L^T/2)*(20*(1/Y)) := by ring
      _ ≤ (L^T/2)*(20*Real.exp (-a*L)) := by gcongr
      _ ≤ (L^T/2)*L^(-(Bsave+T)) := mul_le_mul_of_nonneg_left hprofile (by positivity)
      _ = L^(-Bsave)/2 := by
        rw [div_mul_eq_mul_div, ← Real.rpow_add hL]
        congr 2
        ring
  calc
    _ = ‖∑ i ∈ Ioc m n, harmonicMellinWeight v i*g i‖ := by
      congr 1
      apply sum_congr rfl
      intro i _
      exact mul_comm _ _
    _ ≤ ((3+2*|v|)/Y)*(8*L^(-S)*Y+2) := hh
    _ ≤ ((5*L^T)/Y)*(8*L^(-S)*Y+2) := by gcongr
    _ = 40*L^T*L^(-S)+10*L^T/Y := by field_simp; ring
    _ ≤ L^(-Bsave)/2+L^(-Bsave)/2 := add_le_add hfirst hsecond
    _ = L^(-Bsave) := by ring

end Bounty
end

section

/- The actual samples at any owner realize the fixed original forest child counts. -/

open Finset Classical

namespace Bounty

section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K))) (u : Fin steps.length)
    (x s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x)

section Ghost
variable (j : J) (htag : steps.get u = some (.inl j))
    (sk : CoupledGhostSkeleton M B s) (births : CoupledGhostSamples M B s sk)
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))

theorem full_mixed_ghost_owner_selected_count (hocc : fullMixedOwnerOccurrence n S B A Δ D steps x p u =
      ⟨s, fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inl j)) htag s ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩)⟩) (hchildren : ∀ i, fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i) = u →
      code i ≠ none → fullMixedPathBirthPerformed n S B A Δ D steps x p (fullMixedBirthOrder S B steps i))
    (g : Fin N) :
    (univ.filter (fun i : Fin (sk g).1.val => code (fullMixedGhostOwnerSampleEmbedding S B j steps u htag s sk ⟨g, i⟩) ≠ none)).card =
      fullMixedSelectedCount S B steps code u g := by
  unfold fullMixedSelectedCount
  exact selected_fiber_card (fullMixedGhostOwnerSampleEmbedding S B j steps u htag s sk)
    (fun i => fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i) = u)
    (fun i => code i ≠ none) (fun i => (fullMixedBirthOrder S B steps i).2.1)
    (full_mixed_ghost_owner_sample_owner S B j steps u htag s sk)
    (full_mixed_ghost_owner_sample_group S B j steps u htag s sk)
    (fun i hi hs => (full_mixed_ghost_owner_sample_coverage n S B A Δ D steps u x s p
      j htag sk births hocc i).mp ⟨hchildren i hi hs, hi⟩) g

theorem full_mixed_ghost_owner_selected_count_le (hocc : fullMixedOwnerOccurrence n S B A Δ D steps x p u =
      ⟨s, fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inl j)) htag s ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩)⟩) (hchildren : ∀ i, fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i) = u →
      code i ≠ none → fullMixedPathBirthPerformed n S B A Δ D steps x p (fullMixedBirthOrder S B steps i))
    (g : Fin N) :
    fullMixedSelectedCount S B steps code u g ≤ (sk g).1.val := by
  rw [← full_mixed_ghost_owner_selected_count n S B A Δ D steps u x s p j htag sk births code hocc hchildren g]
  have h := card_filter_le (s := (univ : Finset (Fin (sk g).1.val)))
    (p := fun i => code (fullMixedGhostOwnerSampleEmbedding S B j steps u htag s sk ⟨g, i⟩) ≠ none)
  simpa only [card_univ, Fintype.card_fin, Fintype.card_subtype_compl, Fintype.card_coe] using h

end Ghost

section Edge
variable (k : K) (htag : steps.get u = some (.inr k))
    (sk : FullActiveEdgeSkeleton n (S k) B (A k) (Δ k) (D k) s) (fresh : FullActiveEdgeSamples n (S k) B (A k) (Δ k) (D k) s sk)
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))

theorem full_mixed_edge_owner_selected_count (hocc : fullMixedOwnerOccurrence n S B A Δ D steps x p u =
      ⟨s, fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inr k)) htag s ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm ⟨sk, fresh⟩)⟩) (hchildren : ∀ i, fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i) = u →
      code i ≠ none → fullMixedPathBirthPerformed n S B A Δ D steps x p (fullMixedBirthOrder S B steps i))
    (g : Fin N) :
    (univ.filter (fun i : {i : Fin (S k g)ᶜ.card // i ∉ (sk.2 g).2.1} => code (fullMixedEdgeOwnerSampleEmbedding n S B k steps u htag (A k) (Δ k) (D k) s sk ⟨g, i⟩) ≠ none)).card =
      fullMixedSelectedCount S B steps code u g := by
  unfold fullMixedSelectedCount
  exact selected_fiber_card (fullMixedEdgeOwnerSampleEmbedding n S B k steps u htag (A k) (Δ k) (D k) s sk)
    (fun i => fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i) = u)
    (fun i => code i ≠ none) (fun i => (fullMixedBirthOrder S B steps i).2.1)
    (full_mixed_edge_owner_sample_owner n S B k steps u htag (A k) (Δ k) (D k) s sk)
    (full_mixed_edge_owner_sample_group n S B k steps u htag (A k) (Δ k) (D k) s sk)
    (fun i hi hs => (full_mixed_edge_owner_sample_coverage n S B A Δ D steps u x s p
      k htag sk fresh hocc i).mp ⟨hchildren i hi hs, hi⟩) g

theorem full_mixed_edge_owner_selected_count_le (hocc : fullMixedOwnerOccurrence n S B A Δ D steps x p u =
      ⟨s, fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inr k)) htag s ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm ⟨sk, fresh⟩)⟩) (hchildren : ∀ i, fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i) = u →
      code i ≠ none → fullMixedPathBirthPerformed n S B A Δ D steps x p (fullMixedBirthOrder S B steps i))
    (g : Fin N) :
    fullMixedSelectedCount S B steps code u g ≤ (S k g)ᶜ.card - (sk.2 g).2.1.card := by
  rw [← full_mixed_edge_owner_selected_count n S B A Δ D steps u x s p k htag sk fresh code hocc hchildren g]
  have h := card_filter_le (s := (univ : Finset ({i : Fin (S k g)ᶜ.card // i ∉ (sk.2 g).2.1})))
    (p := fun i => code (fullMixedEdgeOwnerSampleEmbedding n S B k steps u htag (A k) (Δ k) (D k) s sk ⟨g, i⟩) ≠ none)
  simpa only [card_univ, Fintype.card_fin, Fintype.card_subtype_compl, Fintype.card_coe] using h

end Edge

end Full
end Bounty
