section

/- The literal total-memory cutoff for the lifted clean operator. Since
clean transport keeps all memory lengths, this cutoff commutes with the
clean action and with both adjacent active-slot averages. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def cleanFullMemoryCutoff {G R : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell B : ℕ}
    (f : CleanFullMemoryState P J ell B → R → ℂ)
    (x : CleanFullMemoryState P J ell B) (r : R) : ℂ :=
  productMemoryCutoff (fun y => f y r) x

theorem clean_full_memory_cutoff_slice {G R : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell B : ℕ}
    (f : CleanFullMemoryState P J ell B → R → ℂ)
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val)) :
    cleanFullMemorySlice (cleanFullMemoryCutoff f) N p =
      if (∑ g, (N g).val) ≤ B then cleanFullMemorySlice f N p else 0 := by
  by_cases h : (∑ g, (N g).val) ≤ B
  · rw [if_pos h]
    funext source r
    simp only [cleanFullMemorySlice, cleanFullMemoryCutoff, productMemoryCutoff,
      cleanFullMemoryState_total_memory]
    exact if_pos h
  · rw [if_neg h]
    funext source r
    simp only [cleanFullMemorySlice, cleanFullMemoryCutoff, productMemoryCutoff,
      cleanFullMemoryState_total_memory, Pi.zero_apply]
    exact if_neg h

theorem clean_full_memory_cutoff_idempotent {G R : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell B : ℕ}
    (f : CleanFullMemoryState P J ell B → R → ℂ) :
    cleanFullMemoryCutoff (cleanFullMemoryCutoff f) = cleanFullMemoryCutoff f := by
  funext x r
  exact congrFun (productMemoryCutoff_idempotent (fun y => f y r)) x

theorem clean_full_memory_cutoff_active_map {G R : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell B : ℕ}
    (f : CleanFullMemoryState P J ell B → R → ℂ) :
    cleanFullMemoryCutoff (cleanFullMemoryActiveMap f) =
      cleanFullMemoryActiveMap (cleanFullMemoryCutoff f) := by
  funext x r
  by_cases h : productTotalMemory x ≤ B <;>
    simp only [cleanFullMemoryCutoff, cleanFullMemoryActiveMap, productMemoryCutoff,
      fullActiveAverage, fullActivePermutation_total_memory, h, if_true, if_false,
      mul_zero, sum_const_zero]

theorem clean_full_memory_cutoff_damped_action {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell B : ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : I → G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ)
    (K : ∀ i, RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb (C i) → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : CleanFullMemoryState Pb J ell B → PhysicalResidues Ps → ℂ) :
    cleanFullMemoryCutoff (cleanFullMemoryPatternDampedAction Vb b C ζ θ ρ k K d f) =
      cleanFullMemoryPatternDampedAction Vb b C ζ θ ρ k K d (cleanFullMemoryCutoff f) := by
  apply clean_full_memory_slice_ext
  intro N p
  rw [clean_full_memory_cutoff_slice]
  unfold cleanFullMemoryPatternDampedAction
  rw [clean_full_memory_lift_slice, clean_full_memory_lift_slice, clean_full_memory_cutoff_slice]
  by_cases h : (∑ g, (N g).val) ≤ B
  · simp only [if_pos h]
  · simp only [if_neg h]
    funext source r
    simp only [cleanHybridPatternDampedAction, Pi.zero_apply, mul_zero, sum_const_zero]

theorem clean_full_memory_cutoff_projected_damped_action {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell B : ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : I → G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ)
    (K : ∀ i, RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb (C i) → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : CleanFullMemoryState Pb J ell B → PhysicalResidues Ps → ℂ) :
    cleanFullMemoryCutoff (cleanFullMemoryActiveMap
      (cleanFullMemoryPatternDampedAction Vb b C ζ θ ρ k K d (cleanFullMemoryActiveMap f))) =
      cleanFullMemoryActiveMap (cleanFullMemoryPatternDampedAction Vb b C ζ θ ρ k K d
        (cleanFullMemoryActiveMap (cleanFullMemoryCutoff f))) := by
  rw [clean_full_memory_cutoff_active_map, clean_full_memory_cutoff_damped_action,
    clean_full_memory_cutoff_active_map]

theorem clean_full_memory_double_cutoff_projected_damped_action {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell B : ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : I → G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ)
    (K : ∀ i, RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb (C i) → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : CleanFullMemoryState Pb J ell B → PhysicalResidues Ps → ℂ) :
    cleanFullMemoryCutoff (cleanFullMemoryActiveMap (cleanFullMemoryPatternDampedAction
      Vb b C ζ θ ρ k K d (cleanFullMemoryActiveMap (cleanFullMemoryCutoff f)))) =
      cleanFullMemoryCutoff (cleanFullMemoryActiveMap
        (cleanFullMemoryPatternDampedAction Vb b C ζ θ ρ k K d (cleanFullMemoryActiveMap f))) := by
  rw [← clean_full_memory_cutoff_projected_damped_action,
    clean_full_memory_cutoff_idempotent]

theorem clean_full_memory_cutoff_norm_le {G R : Type*}
    [Fintype G] [DecidableEq G] [Fintype R]
    {P : G → Finset ℕ} {J ell B : ℕ} [∀ g (p : P g), NeZero p.val]
    (μ ν : ∀ g, P g → ℝ) (hμ : ∀ g p, 0 ≤ μ g p) (hν : ∀ g p, 0 ≤ ν g p)
    (f : CleanFullMemoryState P J ell B → R → ℂ) :
    cleanWeightedNorm (productMemoryWeight μ (fun g z => ν g z.1)) (cleanFullMemoryCutoff f) ≤
      cleanWeightedNorm (productMemoryWeight μ (fun g z => ν g z.1)) f := by
  apply Real.sqrt_le_sqrt
  apply sum_le_sum
  intro x _
  apply mul_le_mul_of_nonneg_left _
    (productMemoryWeight_nonneg μ (fun g z => ν g z.1) hμ (fun g z => hν g z.1) x)
  apply sum_le_sum
  intro r _
  exact pow_le_pow_left₀ (norm_nonneg _) (productMemoryCutoff_norm_le (fun y => f y r) x) 2

theorem clean_full_memory_cutoff_sandwich_norm_le {G R : Type*}
    [Fintype G] [DecidableEq G] [Fintype R]
    {P : G → Finset ℕ} {J ell B : ℕ} [∀ g (p : P g), NeZero p.val]
    (μ ν : ∀ g, P g → ℝ) (hμ : ∀ g p, 0 ≤ μ g p) (hν : ∀ g p, 0 ≤ ν g p)
    (A : (CleanFullMemoryState P J ell B → R → ℂ) → CleanFullMemoryState P J ell B → R → ℂ)
    (M : ℝ) (hM : 0 ≤ M)
    (hA : ∀ f, cleanWeightedNorm (productMemoryWeight μ (fun g z => ν g z.1)) (A f) ≤
      M * cleanWeightedNorm (productMemoryWeight μ (fun g z => ν g z.1)) f)
    (f : CleanFullMemoryState P J ell B → R → ℂ) :
    cleanWeightedNorm (productMemoryWeight μ (fun g z => ν g z.1))
        (cleanFullMemoryCutoff (A (cleanFullMemoryCutoff f))) ≤
      M * cleanWeightedNorm (productMemoryWeight μ (fun g z => ν g z.1)) f :=
  (clean_full_memory_cutoff_norm_le μ ν hμ hν _).trans
    ((hA _).trans (mul_le_mul_of_nonneg_left (clean_full_memory_cutoff_norm_le μ ν hμ hν f) hM))

end Bounty
end

section

/- Every retained Q product remains disjoint from the full P pool. -/

open Finset

namespace Bounty

theorem candidate_micro_Q_product_free {c L : ℝ} (hcL : 0 ≤ c*L)
    (hpool : ∀ p ∈ (candidatePIndices c L).biUnion (candidatePBand (c*L)),
      (p : ℝ) ≤ Real.exp (Real.sqrt L)) (r jStar J : ℕ)
    (x : ∀ i, candidateMicroQSlotChoices c L r jStar J i) :
    Disjoint (orderedSlotProduct (candidateMicroQSlotChoices c L r jStar J) x).primeFactors
      ((candidatePIndices c L).biUnion (candidatePBand (c*L))) := by
  classical
  apply disjoint_left.mpr
  intro p hp hP
  obtain ⟨hpp, hpdvd, _⟩ := Nat.mem_primeFactors.mp hp
  obtain ⟨slot, _, hpslot⟩ := ((Nat.prime_iff.mp hpp).dvd_finsetProd_iff (fun slot => (x slot).val)).mp hpdvd
  let s : (candidateQIndices c L) × Fin r :=
    (⟨slot.1.val, (mem_filter.mp slot.1.property).1⟩, slot.2)
  have hmem : p ∈ (x slot).val.primeFactors := Nat.mem_primeFactors.mpr
    ⟨hpp, hpslot, candidate_Q_slot_nonzero c L r jStar s (x slot).property⟩
  exact disjoint_left.mp (candidate_Q_slot_primeFactors_disjoint hcL hpool s (x slot).property) hmem hP

end Bounty
end

section

/- Exact local birth factorization retains every non-ledger edge restriction. -/

open scoped Classical
namespace Bounty
section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, DecidableEq (P g)]
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ)
  (k : K) (target : (g : Fin N) → Fin (S k g)ᶜ.card → P g)
  (H : (g : Fin N) → Finset (P g))
  (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
  (e : FullPermutationMixedEvent (J := J) n S B A Δ D (some (.inr k)) s)

theorem full_mixed_edge_phase_birth_avoidance :
    fullEdgeLedgerPhase n (S k) B (A k) (Δ k) (D k) target H s e =
      (if FullMixedLocalBirthAvoids n S B A Δ D H (some (.inr k)) s e then 1 else 0) *
        fullEdgeLedgerPhase n (S k) B (A k) (Δ k) (D k) target (fun _ => ∅) s e := by
  rw [full_mixed_edge_birth_avoids_iff]
  have he := full_edge_ledger_phase_factor n (S k) B (A k) (Δ k) (D k) target H s e
  by_cases h : ∀ g i, (e.2 g).2.2.2 i ∉ H g
  · simpa only [if_pos h] using he
  · simpa only [if_neg h] using he

theorem full_mixed_edge_phase_birth_distinct
    (hphase : fullEdgeLedgerPhase n (S k) B (A k) (Δ k) (D k) target H s e ≠ 0)
    (htarget : ∀ g, Function.Injective (target g)) :
    FullMixedLocalBirthDistinct n S B A Δ D (some (.inr k)) s e := by
  rw [full_mixed_edge_birth_distinct_iff]
  exact full_edge_ledger_phase_fresh_injective n (S k) B (A k) (Δ k) (D k) target H s e
    hphase htarget

theorem full_mixed_edge_phase_birth_factor
    (htarget : ∀ g, Function.Injective (target g)) :
    fullEdgeLedgerPhase n (S k) B (A k) (Δ k) (D k) target H s e =
      (if FullMixedLocalBirthAvoids n S B A Δ D H (some (.inr k)) s e ∧
          FullMixedLocalBirthDistinct n S B A Δ D (some (.inr k)) s e then 1 else 0) *
        fullEdgeLedgerPhase n (S k) B (A k) (Δ k) (D k) target (fun _ => ∅) s e := by
  rw [full_mixed_edge_phase_birth_avoidance n S B A Δ D k target H s e]
  by_cases hz : fullEdgeLedgerPhase n (S k) B (A k) (Δ k) (D k) target (fun _ => ∅) s e = 0
  · simp only [hz, mul_zero]
  · have hd := full_mixed_edge_phase_birth_distinct n S B A Δ D k target (fun _ => ∅) s e hz htarget
    simp only [hd, and_true]

end Full
end Bounty
