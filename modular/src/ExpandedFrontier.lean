/- The weighted sum of selected fine histories is the original moment
paired against its exact initial mark mass, with both memory boundaries empty. -/

open Finset Classical
namespace Bounty

theorem physical_full_vacuum_terminal_encode
    {N J ell B : ℕ} {P : Fin N → Finset ℕ} (cut : Fin N → Finset (Fin J)) :
    (fun t : PhysicalBoundedMarkState P J ell B =>
      fullMemoryVacuum (physicalBoundedMarkEncode cut t).2) = physicalEmptyMemoryTerminal := by
  funext t
  simp only [fullMemoryVacuum, physicalBoundedMarkEncode, physicalFullMemoryState,
    physicalEmptyMemoryTerminal]
  split_ifs with h <;> simp [h]
  simpa only [Fin.ext_iff, Fin.val_zero] using not_forall.mp h

section Pairing
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g (p : P g), NeZero p.val]
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => P g)
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → P g → ℝ) (q : Fin (n + 1) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
  (cut : ℕ → Fin N → Finset (Fin J)) (ζ : Fin n → ℝ)
  (K : ∀ j, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C j) → ℂ)
  [Fintype (PhysicalSelectedData P ell C)]
  (hV : ∀ g, V g ≠ 0)
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hencode : ∀ i, PhysicalMarkRowEncoding C (physicalSelectedFineTag n i) (cut i) (cut (i + 1)))

include hP hdis hencode in
theorem physical_selected_initial_sum_eq_moment (L : PhysicalMarkLists P J ell) :
    (∑ d : PhysicalSelectedData P ell C, physicalSelectedCoefficient C ζ K d *
      finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
        (physicalSelectedFineRow C d.1 d.2.1 d.2.2.1 d.2.2.2 k β V ρ hV ω q)
        (4 * n + 1) physicalEmptyMemoryTerminal (physicalInitialMarkState B L)) =
    physicalOriginalSelectedMoment C k ω β q ρ V cut ζ K fullMemoryVacuum
      (physicalFullMemoryState (cut 0) L
        (fun g => fullEmptyBoundedMemory (UnrestrictedResidueParticle (fun p : P g => p.val)) B)) := by
  have h := physical_selected_record_action_eq_original_moment C k ω β q ρ V cut ζ K
    hV hP hdis hencode fullMemoryVacuum L
    (fun g => fullEmptyBoundedMemory (UnrestrictedResidueParticle (fun p : P g => p.val)) B)
  dsimp only at h
  rw [physical_selected_record_action_eq_sum C k β V ρ hV ω q cut univ
    (physicalSelectedCoefficient C ζ K) hP hdis hencode] at h
  rw [physical_full_vacuum_terminal_encode] at h
  simpa only [physical_full_initial_ledger, physicalInitialMarkState, fullEmptyBoundedMemory] using h

include hP hdis hencode in
theorem physical_selected_weighted_sum_eq_moment_pairing
    (a : PhysicalMarkLists P J ell → ℂ) :
    (∑ d : PhysicalSelectedData P ell C, a (d.2.1 0) * (physicalSelectedCoefficient C ζ K d *
      finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
        (physicalSelectedFineRow C d.1 d.2.1 d.2.2.1 d.2.2.2 k β V ρ hV ω q)
        (4 * n + 1) physicalEmptyMemoryTerminal (physicalInitialMarkState B (d.2.1 0)))) =
    ∑ L : PhysicalMarkLists P J ell, a L *
      physicalOriginalSelectedMoment C k ω β q ρ V cut ζ K fullMemoryVacuum
        (physicalFullMemoryState (cut 0) L
          (fun g => fullEmptyBoundedMemory (UnrestrictedResidueParticle (fun p : P g => p.val)) B)) := by
  rw [← physical_selected_initial_pairing C k β V ρ hV ω q univ
    (physicalSelectedCoefficient C ζ K) a physicalEmptyMemoryTerminal]
  apply sum_congr rfl
  intro L _
  rw [physical_selected_initial_sum_eq_moment C k ω β q ρ V cut ζ K hV hP hdis hencode]

end Pairing
end Bounty
end

