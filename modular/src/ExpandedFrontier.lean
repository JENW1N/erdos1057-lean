section

/- The actual small weight depends on big selected data only through the
original offset sequence; both small permutation averages remain explicit. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def physicalSelectedSmallWeight
    {S : Type*} [Fintype S] {Ps : S → Finset ℕ} {J ell n : ℕ}
    (Cs : Fin n → S → Finset (Fin J)) (Vs : S → ℝ) (q : ℝ)
    (r : PhysicalResidues Ps) (a : Fin (n + 1) → ℤ)
    (d : PhysicalGroupSelectedData Ps ell Cs) : ℂ :=
  ∏ j : Fin n, (Nat.card (PhysicalPermutations S J ell) : ℂ)⁻¹ *
    (Nat.card (PhysicalPermutations S J ell) : ℂ)⁻¹ *
    physicalBarePatternScalar Vs (Cs j) 0 (fun _ _ _ => 1) (d.1 j)
      (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc))
      (physicalPermuteLabels (d.2.2.2 j) (d.2.1 j.succ)) *
    ((physicalResidueVertexWeight (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc))
        (Real.sqrt q) (physicalTranslateResidues r (a j.castSucc)) *
      physicalResidueVertexWeight (physicalPermuteLabels (d.2.2.2 j) (d.2.1 j.succ))
        (Real.sqrt q) (physicalTranslateResidues r (a j.succ)) : ℝ) : ℂ)

theorem physical_root_small_weight_selected
    {I : Type} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    [∀ z : PhysicalPrime P, NeZero z.2.val]
    (groups : Finset (Fin N)) (patterns : Finset I)
    (C : I → Fin N → Finset (Fin J))
    (hC : ∀ i : patterns, ∀ g : ↥groupsᶜ, C i.val g.val = ∅)
    (V : Fin N → ℝ) {q : ℝ} (hq : 0 ≤ q) (k : ℕ → I → ℤ)
    (r : PhysicalGroupResidues P groupsᶜ)
    (p : PhysicalRootSmallPlan (P := P) (J := J) (ell := ell) (n := n) groups patterns)
    (db : PhysicalRootSmallPlanBigData groups patterns C hC p) :
    let old := physicalRootSmallPlanPath groups patterns C hC p db
    physicalRootPlanSmallWeight groups patterns C hC V q k r p db =
      physicalSelectedSmallWeight
        (fun j (g : ↥groupsᶜ) => C (physicalRootSmallPlanPattern groups patterns C hC p j).val g.val)
        (fun g => V g.val) q (physicalGroupResidueVector r)
        (physicalPathSelectedOffset C k old.1 old.2)
        (physicalRootSmallPlanSmallData groups patterns C hC p) := by
  dsimp only
  rw [physicalRootPlanSmallWeight, physical_small_vertex_walk_edges groupsᶜ patterns C V hq k]
  unfold physicalSelectedSmallWeight
  apply prod_congr rfl
  intro j _
  have he := physical_root_path_small_edge groups patterns C hC p db j
  have hσ := congrArg Prod.fst he
  have hτ := congrArg (fun a => a.2.1) he
  dsimp only [physicalRestrictedEdge] at hσ hτ
  have hL := physical_root_path_small_marks groups patterns C hC p db j.castSucc
  have hR := physical_root_path_small_marks groups patterns C hC p db j.succ
  dsimp only [Fin.val_castSucc, Fin.val_succ] at hL hR
  rw [he, hL, hR]
  rw [physical_permute_group_restrict, physical_permute_group_restrict]
  rw [hσ, hτ, hL, hR]
  simp only [physicalBareLabeledScalar, ← Nat.card_eq_fintype_card]

end Bounty
