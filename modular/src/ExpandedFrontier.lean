  (V η : Fin N → ℝ) (β : ℝ)
  (cut : ℕ → Fin N → Finset (Fin J)) (ζ : Fin n → ℝ)
  (K : ∀ j, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C j) → ℂ)

variable [Fintype (PhysicalSelectedData P ell C)]

theorem physical_original_selected_remainder_eq
    (hencode : ∀ i, PhysicalMarkRowEncoding C (physicalSelectedFineTag n i) (cut i) (cut (i + 1)))
    (encode : ((g : Fin N) × ↥(P g)) → ℤ) (hinj : Function.Injective encode)
    (f : PhysicalFullBoundedState P J ell B → ℂ) (x : PhysicalFullBoundedState P J ell B)
    (hx : FullActiveInjective x)
    (hcover : FullMixedLedgerCovers (fun g (p : ↥(P g)) => p.val) B (fullActiveInitialLedger x, x))
    (r₀ : ℕ) :
    physicalOriginalSelectedMoment C k ω b q ρ V cut ζ K f x -
      (∑ code ∈ univ.filter (fun code => birthForestRank code < r₀),
        (-1 : ℂ) ^ birthForestRank code * physicalEnrichedForestAction C k ω b q ρ V cut ζ K code f x) =
      ∑ code ∈ univ.filter (fun code => r₀ ≤ birthForestRank code),
        (-1 : ℂ) ^ birthForestRank code * physicalEnrichedForestAction C k ω b q ρ V cut ζ K code f x := by
  rw [physical_original_selected_forest_expansion C k ω b q ρ V cut ζ K hencode encode hinj f x hx hcover,
    sub_eq_iff_eq_add]
  simp only [sum_filter]
  rw [← sum_add_distrib]
  apply sum_congr rfl
  intro code _
  by_cases h : birthForestRank code < r₀
  · simp only [if_pos h, if_neg (Nat.not_le.mpr h), zero_add]
  · simp only [if_neg h, if_pos (Nat.le_of_not_gt h), add_zero]

theorem physical_original_selected_high_rank_remainder
    (hencode : ∀ i, PhysicalMarkRowEncoding C (physicalSelectedFineTag n i) (cut i) (cut (i + 1)))
    (encode : ((g : Fin N) × ↥(P g)) → ℤ) (hinj : Function.Injective encode)
    (hK : ∀ j L R a, ‖K j L R a‖ ≤ 1)
    (hω : ∀ j c a, 0 ≤ ω j c a) (hωmass : ∀ j c, ∑ a, ω j c a ≤ 1)
    (hμ : ∀ g p, 0 ≤ b g p / V g) (hmass : ∀ g, ∑ p, b g p / V g ≤ 2)
    (hη : ∀ g, 0 ≤ η g) (hμatom : ∀ g p, b g p / V g ≤ η g)
    (hβ : 0 ≤ β) (hghostAtom : ∀ j g, (|(1 - q j) * V g / ρ| * η g) * v ≤ β)
    (hedgeAtom : ∀ g, η g ≤ β) (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : ∀ g, vmin ≤ V g) (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ j g, (physicalFullSharedIndices (ell := ell) (C j g))ᶜ.card ≤ T)
    (f : PhysicalFullBoundedState P J ell B → ℂ) (x : PhysicalFullBoundedState P J ell B)
    (hx : FullActiveInjective x)
    (hcover : FullMixedLedgerCovers (fun g (p : ↥(P g)) => p.val) B (fullActiveInitialLedger x, x))
    {L : ℝ} (hL : 0 ≤ L) (hf : ∀ y, ‖f y‖ ≤ L) (r₀ : ℕ)
    (hδ : (Fintype.card (FullMixedBirthAddress
      (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B
      ((List.range (4 * n + 1)).map (physicalSelectedFineTag n))) : ℝ) ^ 2 * β < 1) :
    ‖physicalOriginalSelectedMoment C k ω b q ρ V cut ζ K f x -
      (∑ code ∈ univ.filter (fun code => birthForestRank code < r₀),
        (-1 : ℂ) ^ birthForestRank code * physicalEnrichedForestAction C k ω b q ρ V cut ζ K code f x)‖ ≤
    (((List.range (4 * n + 1)).map (physicalSelectedFineTag n)).map
      (fullMixedLengthRowFactor (fun g p => b g p / V g) q ρ v vmin V T)).prod *
      (L * productLengthLyapunov v x) *
      ((Fintype.card (FullMixedBirthAddress
        (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B
        ((List.range (4 * n + 1)).map (physicalSelectedFineTag n))) : ℝ) ^ 2 * β) ^ r₀ /
      (1 - (Fintype.card (FullMixedBirthAddress
        (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B
        ((List.range (4 * n + 1)).map (physicalSelectedFineTag n))) : ℝ) ^ 2 * β) := by
  rw [physical_original_selected_remainder_eq C k ω b q ρ V cut ζ K hencode encode hinj f x hx hcover r₀]
  exact physical_enriched_high_rank_tail C k ω b q ρ v vmin V η β cut ζ K hK
    hω hωmass hμ hmass hη hμatom hβ hghostAtom hedgeAtom hq0 hq1 hρ0 hρ1 hv hvmin hV hD T ht
    f x hL hf r₀ hδ

