theorem physical_group_phase_activity_permute {G : Type*}
    {P : G → Finset ℕ} {J ell : ℕ} (σ : PhysicalPermutations G J ell)
    (L : PhysicalMarkLists P J ell) (g : G) :
    physicalGroupPhaseActivity (physicalPermuteLabels σ L) g =
      physicalGroupPhaseActivity L g := by
  funext p
  simp only [physicalGroupPhaseActivity, physical_group_marks_permute]

section Edge
variable {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
  (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C) (k : ℤ)
  (σ τ : PhysicalPermutations G J ell) {x y : PhysicalState P J ell}
  (hadm : physicalAdmissible C aux k
    (physicalPermutationEquiv σ x) (physicalPermutationEquiv τ y))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (g : G)
  (hk : ∀ s, ¬ ((x.2.val g s).val : ℤ) ∣ k)
