theorem physical_joint_residue_history_memory_paths :
    let steps := physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β η V ρ hV cap
    let _ : ∀ i q, Fintype (GlobalBirthJointAmbientEvent (steps i) q) :=
      fun i q => globalBirthJointAmbientEventFintype (steps i) q
    physicalJointResidueRawHistory C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β η V ρ hV cap =
      finiteEventPathAction (fun i => GlobalBirthJointAmbientEvent (steps i))
        (fun i => globalBirthJointMemoryTarget (steps i))
        (fun i => globalBirthJointCappedEventWeight (steps i) cap cap) (List.range (2 * n + 1))
        (fun q p => if globalBirthJointMemoryPathAllowed
          (fun i g => physicalGroupBareAtomicActivity L g i) steps (fun _ => cap) (2 * n + 1)
          (fun g => ghostPhaseActivitySupport (physicalGroupBareAtomicActivity L g 0)) q p then 1 else 0)
        (fun q => if ∀ g, (q g).1 = 0 then 1 else 0) (fun _ => globalBirthEmptyMemory) := by
  exact global_birth_joint_raw_history_memory_paths (fun i g => physicalGroupBareAtomicActivity L g i)
    (physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β η V ρ hV cap) (fun _ => cap) (2 * n + 1)
    (fun q => if ∀ g, (q g).1 = 0 then 1 else 0) (fun g => ghostPhaseActivitySupport (physicalGroupBareAtomicActivity L g 0)) (fun _ => globalBirthEmptyMemory)

theorem physical_joint_residue_history_norm_le_abs_list :
    let steps := physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β η V ρ hV cap
    let _ : ∀ i q, Fintype (GlobalBirthJointAmbientEvent (steps i) q) :=
