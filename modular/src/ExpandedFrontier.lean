/- Split a bare edge while retaining an arbitrary coupled coefficient and the full phase. -/

open scoped Classical
namespace Bounty

theorem physical_phase_zero_frequency (D : ℕ) : physicalPhase 0 D = 1 := by
  simp only [physicalPhase, zero_mul, Complex.ofReal_zero, Complex.exp_zero]

section Groups
variable {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
  (small : G → Prop) (C : G → Finset (Fin J)) (ζ : ℝ)
  (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)

noncomputable def physicalCoupledBigCoefficient
    (Ls Rs : PhysicalMarkLists (fun g : {g // small g} => P g.val) J ell)
    (as : PhysicalAuxLabels (fun g : {g // small g} => P g.val) (fun g => C g.val))
    (Lb Rb : PhysicalMarkLists (fun g : {g // ¬small g} => P g.val) J ell)
    (ab : PhysicalAuxLabels (fun g : {g // ¬small g} => P g.val) (fun g => C g.val)) : ℂ :=
  K ((physicalMarkGroupSplit small P J ell).symm (Ls, Lb))
      ((physicalMarkGroupSplit small P J ell).symm (Rs, Rb))
      ((physicalAuxGroupSplit small P J C).symm (as, ab)) *
    physicalPhase ζ (physicalD (fun g : {g // small g} => C g.val) Ls as *
      physicalD (fun g : {g // ¬small g} => C g.val) Lb ab)

theorem physical_coupled_big_coefficient_restrict
    (a : PhysicalAuxLabels P C) (L R : PhysicalMarkLists P J ell) :
    physicalCoupledBigCoefficient small C ζ K
      (fun g => L g.val) (fun g => R g.val) (fun g => a g.val)
      (fun g => L g.val) (fun g => R g.val) (fun g => a g.val) =
      K L R a * physicalPhase ζ
        (physicalD (fun g : {g // small g} => C g.val) (fun g => L g.val) (fun g => a g.val) *
          physicalD (fun g : {g // ¬small g} => C g.val) (fun g => L g.val) (fun g => a g.val)) := by
  simp only [physicalCoupledBigCoefficient, physical_mark_group_merge_restrict,
    physical_aux_group_merge_restrict]

theorem physical_bare_pattern_group_factor (V : G → ℝ)
    (a : PhysicalAuxLabels P C) (L R : PhysicalMarkLists P J ell) :
    physicalBarePatternScalar V C ζ K a L R =
      physicalBarePatternScalar (fun g : {g // small g} => V g.val) (fun g => C g.val)
        0 (fun _ _ _ => 1) (fun g => a g.val) (fun g => L g.val) (fun g => R g.val) *
      physicalBarePatternScalar (fun g : {g // ¬small g} => V g.val) (fun g => C g.val)
        0 (physicalCoupledBigCoefficient small C ζ K
          (fun g => L g.val) (fun g => R g.val) (fun g => a g.val))
        (fun g => a g.val) (fun g => L g.val) (fun g => R g.val) := by
  simp only [physicalBarePatternScalar, physical_coupled_big_coefficient_restrict,
    physical_phase_zero_frequency, mul_one]
  rw [physical_list_admissible_group_split small C a L R,
    physical_aux_mass_group_split small C a V, physical_completion_mass_group_split small C V,
    physical_D_group_split small C a L]
  by_cases hs : physicalListAdmissible (fun g : {g // small g} => C g.val)
      (fun g => a g.val) (fun g => L g.val) (fun g => R g.val)
  · by_cases hb : physicalListAdmissible (fun g : {g // ¬small g} => C g.val)
        (fun g => a g.val) (fun g => L g.val) (fun g => R g.val)
    · simp only [hs, hb, and_self, if_true, Complex.ofReal_mul]
      ring
    · simp only [hs, hb, and_false, if_false, if_true, mul_zero]
  · simp only [hs, false_and, if_false, zero_mul]

end Groups
end Bounty
