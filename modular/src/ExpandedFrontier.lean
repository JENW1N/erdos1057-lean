/- The original root small weight uses the cumulative sum of the selected
big edge displacements, with no residual reference to reconstructed paths. -/

open scoped Classical
namespace Bounty

section Root
variable {I : Type} {N M J ell n : ℕ} {P : Fin N → Finset ℕ}
  (groups : Finset (Fin N)) (e : {g // g ∉ groupsᶜ} ≃ Fin M)
  (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
  (hC : ∀ i : patterns, ∀ g : ↥groupsᶜ, C i.val g.val = ∅)
  (k : ℕ → I → ℤ)
  (p : PhysicalRootSmallPlan (P := P) (J := J) (ell := ell) (n := n) groups patterns)

theorem physical_root_numbered_plan_offset_cumulative
    (d : PhysicalSelectedData (fun g => P (e.symm g).val) ell
      (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val)) :
    physicalRootNumberedPlanOffset groups e patterns C hC k p d =
      physicalSelectedCumulativeOffset
        (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val)
        (physicalRootPlanMultiplier groups patterns C hC k p) d := by
  funext j
  induction j using Fin.induction with
  | zero =>
    rw [physicalSelectedCumulativeOffset, Fin.partialSum_zero]
    exact physical_path_selected_offset_zero C k _ _
  | succ j ih =>
    rw [physical_root_numbered_plan_offset_step, ih,
      physicalSelectedCumulativeOffset, Fin.partialSum_succ]

theorem physical_root_numbered_small_weight_cumulative
    [∀ z : PhysicalPrime P, NeZero z.2.val]
    (V : Fin N → ℝ) {q : ℝ} (hq : 0 ≤ q)
    (r : PhysicalGroupResidues P groupsᶜ)
    (d : PhysicalSelectedData (fun g => P (e.symm g).val) ell
      (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val)) :
    physicalRootPlanSmallWeight groups patterns C hC V q k r p
      ((physicalSelectedGroupReindex e (fun g => P g.val)
        (fun j (g : {g // g ∉ groupsᶜ}) =>
          C (physicalRootSmallPlanPattern groups patterns C hC p j).val g.val)).symm d) =
      physicalSelectedSmallWeight
        (fun j (g : ↥groupsᶜ) => C (physicalRootSmallPlanPattern groups patterns C hC p j).val g.val)
        (fun g => V g.val) q (physicalGroupResidueVector r)
        (physicalSelectedCumulativeOffset
          (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val)
