section

/- Independent auxiliary subprobability averaging of the actual candidate
mixed dirty operator. Both small-slot projections and all event masks remain
literal, with no per-auxiliary norm hypothesis in the conclusion. -/

open Finset Filter
open scoped Classical Topology

namespace Bounty

theorem eventually_candidate_mixed_auxiliary_dirty_energy_le
    {q vs scale : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hvs : 0 < vs) (hscale : 0 < scale)
    (ell : ℕ) (C₂ : ℝ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ᶠ L : ℝ in atTop,
      letI : DecidableEq (CandidateSmallGroup scale L) := Classical.decEq _
      letI : DecidableEq (CandidateBigGroup scale L) := Classical.decEq _
      letI : ∀ p : PhysicalPrime (candidateSmallPool scale L), NeZero p.2.val :=
        candidateSmallPrimeNeZero scale L
      letI : ∀ g p, NeZero (candidateBigModulus scale L g p) := candidateBigModulusNeZero scale L
      ∀ J B : ℕ,
      letI : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
      ∀ M : CandidateBigGroup scale L → ℕ,
      ∀ shared : ∀ g, Finset (Fin (M g)),
      ∀ (Q : Type) [Fintype Q],
      ∀ π : Q → ℝ, (∀ a, 0 ≤ π a) → (∑ a, π a ≤ 1) →
      ∀ D_B : Q → SharedActiveLabels (CandidateBigLabel scale L) shared → ℕ,
      ∀ k : ℤ, k ≠ 0 → (k.natAbs : ℝ) ≤ L ^ C₂ →
      ∀ Vs : CandidateSmallGroup scale L → ℝ, (∀ g, vs ≤ Vs g) →
      ∀ μ : ∀ g, CandidateBigLabel scale L g → ℝ, ∀ ρ : ℝ,
      ∀ V : CandidateBigGroup scale L → ℝ,
      ∀ v vmin vmax : ℝ, 0 < ρ → ρ < 1 → 1 < v → 0 < vmin →
      (∀ g, vmin ≤ V g) → (∀ g, V g ≤ vmax) →
      (∀ g p, 0 ≤ μ g p) → (∀ g, ∑ p, μ g p ≤ 2) →
      ∀ T : ℕ, (∀ g, (shared g)ᶜ.card ≤ T) →
      ∀ Φ : ∀ a : Q, ∀ s : PhysicalSmallBigState (candidateSmallPool scale L) J ell
        (ProductBoundedOrderedState (CandidateBigLabel scale L)
          (fun g => UnrestrictedResidueParticle (candidateBigModulus scale L g)) M B),
        PhysicalSmallBigEvent (PhysicalSmallBigFullEvent (candidateBigModulus scale L) shared B
          (fun d c _ => -(k * (D_B a c * physicalSharedProduct d : ℕ)))
          (fun d c _ => (D_B a c * physicalSharedProduct d : ℕ))) s → ℂ,
      (∀ a s e, ‖Φ a s e‖ ≤ 1) →
      ∀ F : PhysicalSmallBigState (candidateSmallPool scale L) J ell
        (ProductBoundedOrderedState (CandidateBigLabel scale L)
          (fun g => UnrestrictedResidueParticle (candidateBigModulus scale L g)) M B) → ℂ,
      (∀ s, ProductMemorySymmetric (fun x => F (s, x))) →
      physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
        (physicalSmallBigAverage (fun s => ∑ a, (π a : ℂ) *
          physicalSmallBigFullPhasedAction (candidateBigModulus scale L) shared B
            (fun d c _ => -(k * (D_B a c * physicalSharedProduct d : ℕ)))
            (fun d c _ => (D_B a c * physicalSharedProduct d : ℕ)) μ ρ V
            (fun c => k * D_B a c) Vs q
            (fun y e => if ¬ (∀ g, (e.2.2 g).1 = ∅ ∧ (e.2.2 g).2.1 = ∅) then Φ a y e else 0)
            (physicalSmallBigAverage F) s)) ≤
      4 * ((B : ℝ) / (((J + ell).choose ell) ^ (candidateSmallPIndices scale L).card : ℕ)) *
        (A ^ (2 * (candidateSmallPIndices scale L).card) *
          unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ (candidateBigPIndices scale L).card) *
        physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) F := by
  obtain ⟨A, hA, hbound⟩ := eventually_candidate_mixed_dirty_energy_le hq0 hq1 hvs hscale ell C₂
  refine ⟨A, hA, ?_⟩
  filter_upwards [hbound] with L hL
  let _ : DecidableEq (CandidateSmallGroup scale L) := Classical.decEq _
  let _ : DecidableEq (CandidateBigGroup scale L) := Classical.decEq _
  let _ : ∀ p : PhysicalPrime (candidateSmallPool scale L), NeZero p.2.val := candidateSmallPrimeNeZero scale L
  let _ : ∀ g p, NeZero (candidateBigModulus scale L g p) := candidateBigModulusNeZero scale L
  intro J B
  let _ : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
  intro M shared Q _ π hπ hπmass D_B k hk hkbound Vs hVs μ ρ V v vmin vmax
    hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht Φ hΦ F hF
  rw [physical_small_big_average_weighted_sum]
  apply physical_small_big_auxiliary_energy_bound Vs (fun s => hvs.trans_le (hVs s))
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productMemoryWeight_nonneg μ _ hμ (fun g z => hμ g z.1)) π hπ hπmass _ F _
  · exact mul_nonneg (mul_nonneg (by norm_num) (div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _)))
      (mul_nonneg (pow_nonneg (zero_le_one.trans hA) _)
        (pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _))
  · intro a
    exact hL J B M shared (D_B a) k hk hkbound Vs hVs μ ρ V v vmin vmax
      hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht (Φ a) (hΦ a) F hF

end Bounty
