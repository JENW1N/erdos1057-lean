/- The actual auxiliary free factor inherits the prime and slot budgets. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_free_factor_exp_bound
    {G : Type*} [Fintype G] {P : G → Finset ℕ} {J : ℕ}
    (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    {B : ℝ} (hB : 0 ≤ B) (hp : ∀ g p, p ∈ P g → (p : ℝ) ≤ Real.exp B) :
    (physicalFreeFactor C aux : ℝ) ≤ Real.exp (B*((J*Fintype.card G : ℕ) : ℝ)) := by
  have hcard : ∀ g, (C g).card ≤ J := fun g =>
    (card_le_card (subset_univ (C g))).trans_eq (by simp)
  have hinner (g : G) : (∏ j : C g, ((aux g j).val : ℝ)) ≤ Real.exp (B*J) := by
    calc
      _ ≤ ∏ _j : C g, Real.exp B := prod_le_prod₀ (fun _ _ => Nat.cast_nonneg _) (fun j _ => hp g _ (aux g j).property)
      _ = Real.exp (B*(C g).card) := by
        rw [← Real.exp_sum]
        simp only [sum_const, card_univ, Fintype.card_coe, nsmul_eq_mul]
        congr 1
        ring
      _ ≤ Real.exp (B*J) := Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left (by exact_mod_cast hcard g) hB)
  calc
    _ = ∏ g, ∏ j : C g, ((aux g j).val : ℝ) := by
      simp only [physicalFreeFactor, Nat.cast_prod]
    _ ≤ ∏ _g : G, Real.exp (B*J) := prod_le_prod₀
      (fun g _ => prod_nonneg (fun _ _ => Nat.cast_nonneg _)) (fun g _ => hinner g)
    _ = _ := by
      rw [← Real.exp_sum]
      simp only [sum_const, card_univ, nsmul_eq_mul, Nat.cast_mul]
      congr 1
      ring

theorem physical_harmonic_ceiling_log_bound
    {G : Type*} [Fintype G] {P : G → Finset ℕ} {J : ℕ}
    (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    {B Z U : ℝ} (hB : 0 ≤ B) (hZ : 0 < Z)
    (hp : ∀ g p, p ∈ P g → (p : ℝ) ≤ Real.exp B)
    (hprod : 1 ≤ Z*(physicalFreeFactor C aux : ℝ)) (hZU : Z ≤ Real.exp U) :
    Real.log (⌈3*Z*(physicalFreeFactor C aux : ℝ)⌉₊ : ℝ) ≤
      Real.log 4 + U + B*((J*Fintype.card G : ℕ) : ℝ) := by
  have hd : 0 < physicalFreeFactor C aux :=
    prod_pos (fun g _ => prod_pos (fun j _ => (hprime g _ (aux g j).property).pos))
  simpa only [mul_assoc] using harmonic_ceiling_log_from_scales hZ
    (by exact_mod_cast hd) hprod hZU (physical_free_factor_exp_bound C aux hB hp)

theorem physical_harmonic_log_bound_of_original_cutoff
    {G : Type*} [Fintype G] {P : G → Finset ℕ} {J : ℕ}
    (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    {B Z L : ℝ} (hB : 0 ≤ B) (hZ : 0 < Z)
    (hp : ∀ g p, p ∈ P g → (p : ℝ) ≤ Real.exp B)
    (hprod : 1 ≤ Z*(physicalFreeFactor C aux : ℝ))
    (hcut : 3*Z < Real.exp (4*L)) :
    Real.log (⌈3*Z*(physicalFreeFactor C aux : ℝ)⌉₊ : ℝ) ≤
      Real.log 4 + 4*L + B*((J*Fintype.card G : ℕ) : ℝ) := by
  apply physical_harmonic_ceiling_log_bound C aux hprime hB hZ hp hprod
  linarith

end Bounty
