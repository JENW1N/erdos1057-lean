section

/- Arbitrary polynomial savings for the concrete prime-pattern perturbation
error, uniformly in the group type, probes, cutoffs, and density loss. -/

open Filter Finset

namespace Bounty

/-- The raw branch ensures that the numerical family budget dominates the
uniform density-smallness quantity. -/
theorem repeated_big_density_le_numeric_error (s m J ell Q : ℕ)
    (xi T P v : ℝ) (hT : 0 ≤ T) (hP : 0 < P) (hv : 0 < v) :
    (((2 * s * (ell + m) : ℕ) : ℝ) * T / P) ≤
      repeatedBigNumericError s m J ell Q xi T P v := by
  have hd : 0 ≤ (((2 * s * (ell + m) : ℕ) : ℝ) * T / P) := by positivity
  have hc : 0 ≤ (s : ℝ) * ((m : ℝ) * (2 * ((J + ell : ℕ) : ℝ))) / (v * P) := by
    positivity
  have hk : 0 ≤ (2 : ℝ) ^ (m * s) * (((Q * Q : ℕ) : ℝ) / xi) ^ 2 := by positivity
  unfold repeatedBigNumericError
  nlinarith

/-- The actual finite family has an arbitrarily small power error under the
manuscript prime lower bound and polynomial density loss. This also verifies
the uniform one-half density hypothesis used by every pattern. -/
theorem eventually_repeated_big_prime_pattern_error_small (m J ell : ℕ)
    {a q x tau v c : ℝ} (ha : 0 ≤ a) (hq : 0 ≤ q) (hx : 0 ≤ x)
    (htau : 0 ≤ tau) (hv : 0 < v) (hc : 0 < c) (E : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ {G : Type*} [Fintype G] [DecidableEq G]
      (V : G → ℝ) (probes : G → Finset (Fin J)) (r t : Finset G)
      (Q : ℕ) (xi T P : ℝ),
      Disjoint r t → (∀ g, (probes g).card ≤ m) →
      (Fintype.card G : ℝ) ≤ a * Real.log L → (∀ g, v ≤ V g) →
      (Q : ℝ) ≤ L ^ q → L ^ (-x) ≤ xi → 0 ≤ T → T ≤ L ^ tau →
      Real.exp (L ^ c) ≤ P →
      (((2 * Fintype.card G * (ell + m) : ℕ) : ℝ) * T / P ≤ 1 / 2) ∧
      (∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
        ‖repeatedBigPrimePatternWeight probes r t i‖ *
          repeatedBigPatternError (ell := ell) V (repeatedBigPrimePatternCut probes r t i)
            T P (repeatedBigPrimePatternBound probes r t Q xi i)) ≤ L ^ (-E) := by
  filter_upwards [eventually_repeated_big_numeric_error_small m J ell ha hq hx htau hv hc E,
    eventually_repeated_big_numeric_error_small m J ell ha hq hx htau hv hc 1,
    eventually_ge_atTop (2 : ℝ)] with L hE h1 hL
  intro G _ _ V probes r t Q xi T P hrt hp hs hV hQ hxi hT0 hT hP
  have hP0 : 0 < P := lt_of_lt_of_le (Real.exp_pos _) hP
  have hnum := hE (Fintype.card G) Q xi T P hs hQ hxi hT0 hT hP
  have hsmall := h1 (Fintype.card G) Q xi T P hs hQ hxi hT0 hT hP
  constructor
  · apply (repeated_big_density_le_numeric_error (Fintype.card G) m J ell Q xi T P v
      hT0 hP0 hv).trans
    apply hsmall.trans
    rw [Real.rpow_neg_one]
    rw [inv_eq_one_div]
    exact one_div_le_one_div_of_le (by norm_num) hL
  · apply (repeated_big_prime_pattern_error_sum_le_groups V probes r t hrt hp Q xi
      hv hV hT0 hP0).trans
    exact hnum

end Bounty
end

