      (fun j => C (finitePathLabels p.val j).2.2.1.val) ell (n + 1) : ℂ) *
      physicalMemoryWalkScalar V patterns C ζ K (finitePathLabels p.val) (finitePathMarks L p.val) (n + 1) *
      (poolPathResidueExpectation (fun a : PhysicalPrime P => a.2.val)
        (physicalPrimeGroups P groupsᶜ) (range (n + 2))
        (fun a => (range (n + 2)).filter (fun j => a ∈ physicalMarkedPrimes (finitePathMarks L p.val j)))
        (fun a j => -(physicalBareOffset C k (finitePathLabels p.val) (finitePathMarks L p.val)
          (n + 1) j : ZMod a.2.val))
        (fun j => 1 - physicalEndpointSchedule q (n + 1) j) : ℝ) *
