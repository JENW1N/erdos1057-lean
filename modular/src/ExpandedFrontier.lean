    (paths : Finset (FullPermutationMixedPath n S B A Δ D steps x))
    (w : FullPermutationMixedPath n S B A Δ D steps x → ℂ)

theorem full_mixed_distinct_birth_path_expansion (hencode : Function.Injective encode) :
    (∑ p ∈ paths, if Set.InjOn (fullMixedPathBirthLabel n S B A Δ D steps x p)
        {a | fullMixedPathBirthPerformed n S B A Δ D steps x p a} then w p else 0) =
      ∑ code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)),
        (-1 : ℂ) ^ birthForestRank code *
          birthForestPathSum paths w (fullMixedIndexedBirthPerformed n S B A Δ D steps x)
            (fullMixedIndexedBirthValue n S B A Δ D steps encode x) code := by
  have h := distinct_birth_path_expansion paths w
    (fullMixedIndexedBirthPerformed n S B A Δ D steps x)
    (fullMixedIndexedBirthValue n S B A Δ D steps encode x)
  simpa only [distinctBirthPathSum,
    full_mixed_indexed_birth_distinct_iff n S B A Δ D steps encode hencode] using h

theorem full_mixed_distinct_birth_path_expansion_same_some (hencode : Function.Injective encode) :
    (∑ p ∈ paths, if ∀ a b z,
        fullMixedPathBirthLabel n S B A Δ D steps x p a = some z →
        fullMixedPathBirthLabel n S B A Δ D steps x p b = some z → a = b
      then w p else 0) =
      ∑ code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)),
        (-1 : ℂ) ^ birthForestRank code *
          birthForestPathSum paths w (fullMixedIndexedBirthPerformed n S B A Δ D steps x)
            (fullMixedIndexedBirthValue n S B A Δ D steps encode x) code := by
  have h := distinct_birth_path_expansion paths w
    (fullMixedIndexedBirthPerformed n S B A Δ D steps x)
    (fullMixedIndexedBirthValue n S B A Δ D steps encode x)
  simpa only [distinctBirthPathSum,
    full_mixed_indexed_birth_distinct_iff_same_some n S B A Δ D steps encode hencode] using h

end Bounty
