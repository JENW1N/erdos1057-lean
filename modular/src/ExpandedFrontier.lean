open Finset Classical
theorem finite_product_delta_expansion {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)]
    (f : (∀ i, X i) → ℂ) (x : ∀ i, X i) :
    f x = ∑ y : (∀ i, X i), f y * ∏ i, (if x i = y i then (1 : ℂ) else 0) := by
  have hdelta (y : ∀ i, X i) :
      (∏ i, (if x i = y i then (1 : ℂ) else 0)) = if x = y then 1 else 0 := by
    rw [Fintype.prod_ite_zero]
    simp only [prod_const_one]
    congr 1
    exact propext ⟨fun h => funext h, fun h i => congrFun h i⟩
  simp only [hdelta]
  simp

theorem finite_product_event_sum {I : Type*} [Fintype I]
    {X : I → Type*} (E : ∀ i, X i → Type*) [∀ i x, Fintype (E i x)]
    (weight : ∀ i x, E i x → ℝ) (target : ∀ i x, E i x → X i)
    (phase : ∀ x : (∀ i, X i), (∀ i, E i (x i)) → ℂ)
    {K : Type*} (s : Finset K) (f : K → (∀ i, X i) → ℂ) (x : ∀ i, X i) :
    finiteProductEventAction E weight target phase (fun y => ∑ k ∈ s, f k y) x =
      ∑ k ∈ s, finiteProductEventAction E weight target phase (f k) x := by
  simp only [finiteProductEventAction, mul_sum]
  exact sum_comm

theorem finite_product_event_const_mul {I : Type*} [Fintype I]
    {X : I → Type*} (E : ∀ i, X i → Type*) [∀ i x, Fintype (E i x)]
    (weight : ∀ i x, E i x → ℝ) (target : ∀ i x, E i x → X i)
    (phase : ∀ x : (∀ i, X i), (∀ i, E i (x i)) → ℂ)
    (c : ℂ) (f : (∀ i, X i) → ℂ) (x : ∀ i, X i) :
    finiteProductEventAction E weight target phase (fun y => c * f y) x =
      c * finiteProductEventAction E weight target phase f x := by
  simp only [finiteProductEventAction, mul_sum]
  apply sum_congr rfl
  intro e _
  ring

theorem finite_product_event_tensor {I : Type*} [Fintype I]
    {X : I → Type*} (E : ∀ i, X i → Type*) [∀ i x, Fintype (E i x)]
    (weight : ∀ i x, E i x → ℝ) (target : ∀ i x, E i x → X i)
    (f : ∀ i, X i → ℂ) (x : ∀ i, X i) :
    finiteProductEventAction E weight target (fun _ _ => 1) (fun y => ∏ i, f i (y i)) x =
      ∏ i, finiteLocalEventAction E weight target i (f i) (x i) := by
  simp only [finiteProductEventAction, finiteLocalEventAction,
    mul_one, Complex.ofReal_prod, ← prod_mul_distrib]
  exact (Fintype.prod_sum (fun i (e : E i (x i)) =>
    (weight i (x i) e : ℂ) * f i (target i (x i) e))).symm

/-- Simultaneously drawing independent local events is exactly the composition
of their coordinate actions. The phase is identically one in this identity. -/
theorem finite_product_event_eq_coordinate_action {I : Type*} [Fintype I]
    [DecidableEq I] {X : I → Type*} [∀ i, Fintype (X i)]
    (E : ∀ i, X i → Type*) [∀ i x, Fintype (E i x)]
    (weight : ∀ i x, E i x → ℝ) (target : ∀ i x, E i x → X i)
    (f : (∀ i, X i) → ℂ) :
    finiteProductEventAction E weight target (fun _ _ => 1) f =
      finiteCoordinateFinsetAction (finiteLocalEventAction E weight target) univ f := by
  have hf : f = fun z => ∑ y : (∀ i, X i),
      f y * ∏ i, (if z i = y i then (1 : ℂ) else 0) :=
    funext (finite_product_delta_expansion f)
  rw [hf]
  funext x
  simp only [finite_product_event_sum, finite_product_event_const_mul,
    finite_local_event_finset_sum, finite_local_event_finset_const_mul]
  apply sum_congr rfl
  intro y _
  rw [finite_product_event_tensor E weight target
      (fun i a => if a = y i then (1 : ℂ) else 0) x,
    finite_local_event_univ_prod E weight target
      (fun i a => if a = y i then (1 : ℂ) else 0) x]
end

