noncomputable def candidateLocalizedWindowMass (c L eps q : ℝ) (r jStar J : ℕ) (hr : 0 < r) : ℝ :=
  ∑ p ∈ candidateSmallPSet c L (Real.exp ((c / 100) * L)),
