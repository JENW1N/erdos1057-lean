/- The original pattern index, both permutations and each auxiliary draw survive group reindexing. -/

open scoped Classical
namespace Bounty
section Reindex
variable {G H I : Type*} (e : G ≃ H) (P : G → Finset ℕ) (J ell : ℕ)
  (patterns : Finset I) (C : I → G → Finset (Fin J))

def physicalEdgeGroupReindex : PhysicalEdgeLabels P J ell patterns C ≃
    PhysicalEdgeLabels (fun h => P (e.symm h)) J ell patterns (fun i h => C i (e.symm h)) :=
  Equiv.prodCongr (physicalPermutationGroupReindex e J ell)
    (Equiv.prodCongr (physicalPermutationGroupReindex e J ell)
      (Equiv.sigmaCongrRight (fun i : patterns => physicalAuxGroupReindex e P J (C i.val))))

theorem physical_edge_group_reindex_pattern (a : PhysicalEdgeLabels P J ell patterns C) :
    (physicalEdgeGroupReindex e P J ell patterns C a).2.2.1 = a.2.2.1 := rfl

variable [Fintype G] [Fintype H]

theorem physical_bare_step_group_reindex (k : I → ℤ)
    (a : PhysicalEdgeLabels P J ell patterns C) (L : PhysicalMarkLists P J ell) :
    physicalBareStep (fun i h => C i (e.symm h)) k
      (physicalEdgeGroupReindex e P J ell patterns C a) (physicalMarkGroupReindex e P J ell L) =
      physicalBareStep C k a L := by
  change k a.2.2.1.val * (physicalD (fun h => C a.2.2.1.val (e.symm h))
    (physicalPermuteLabels (physicalPermutationGroupReindex e J ell a.1)
      (physicalMarkGroupReindex e P J ell L))
    (physicalAuxGroupReindex e P J (C a.2.2.1.val) a.2.2.2) : ℕ) = _
  rw [← physical_permute_group_reindex, physical_D_group_reindex]
  rfl

theorem physical_bare_labeled_group_reindex [DecidableEq G] [DecidableEq H]
    (V : G → ℝ) (ζ : I → ℝ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (L R : PhysicalMarkLists P J ell) :
    physicalBareLabeledScalar (fun h => V (e.symm h)) patterns (fun i h => C i (e.symm h)) ζ
      (fun i => physicalGroupReindexedCoefficient e (C i) (K i))
      (physicalEdgeGroupReindex e P J ell patterns C a)
      (physicalMarkGroupReindex e P J ell L) (physicalMarkGroupReindex e P J ell R) =
      physicalBareLabeledScalar V patterns C ζ K a L R := by
  unfold physicalBareLabeledScalar
  change (Fintype.card (PhysicalPermutations H J ell) : ℂ)⁻¹ *
    (Fintype.card (PhysicalPermutations H J ell) : ℂ)⁻¹ *
      physicalBarePatternScalar (fun h => V (e.symm h)) (fun h => C a.2.2.1.val (e.symm h))
        (ζ a.2.2.1.val) (physicalGroupReindexedCoefficient e (C a.2.2.1.val) (K a.2.2.1.val))
        (physicalAuxGroupReindex e P J (C a.2.2.1.val) a.2.2.2)
        (physicalPermuteLabels (physicalPermutationGroupReindex e J ell a.1)
          (physicalMarkGroupReindex e P J ell L))
        (physicalPermuteLabels (physicalPermutationGroupReindex e J ell a.2.1)
          (physicalMarkGroupReindex e P J ell R)) = _
  rw [← physical_permute_group_reindex, ← physical_permute_group_reindex,
    physical_bare_pattern_group_reindex]
  have hc := physical_permutation_group_reindex_card (J := J) (ell := ell) e
  simp only [← Nat.card_eq_fintype_card] at hc ⊢
  rw [hc]

end Reindex
end Bounty
