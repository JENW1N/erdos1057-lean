/- Iterating the original event updates recovers exactly the original path's fixed global birth labels. -/

open Classical

namespace Bounty

section History
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K)))

noncomputable def fullMixedStepHistoryUpdate (t : ℕ) (tag : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag s)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P)) :
    Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P) :=
  if ht : t < steps.length then
    if htag : steps.get ⟨t, ht⟩ = tag then
      fullMixedBirthHistoryWrite n S B A Δ D steps ⟨t, ht⟩ s
        (fullMixedTaggedOwnerEvent n S B A Δ D steps ⟨t, ht⟩ tag htag s e) history
    else history
  else history

theorem full_mixed_step_history_update_owner (u : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (steps.get u) s)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P)) :
    fullMixedStepHistoryUpdate n S B A Δ D steps u.val (steps.get u) s e history =
      fullMixedBirthHistoryWrite n S B A Δ D steps u s e history := by
  unfold fullMixedStepHistoryUpdate
  rw [dif_pos u.isLt, dif_pos rfl]
  rfl

theorem full_mixed_path_history_at
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps s)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P))
    (t : ℕ) (ht : t ≤ steps.length) :
    finiteEventPathHistoryAt (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D)
      (fullMixedStepHistoryUpdate n S B A Δ D steps) 0 steps s p history t =
      fullMixedPathBirthHistory n S B A Δ D steps s p history t := by
  induction t with
  | zero =>
    rw [finite_event_path_history_at_zero, full_mixed_path_birth_history_zero]
  | succ t ih =>
    have hlt : t < steps.length := Nat.lt_of_succ_le ht
    have h := finite_event_path_history_at_succ (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D)
      (fullMixedStepHistoryUpdate n S B A Δ D steps) 0 steps s p history ⟨t, hlt⟩
    simp only [Nat.zero_add] at h
    rw [h, ih (Nat.le_of_lt hlt)]
    exact (full_mixed_step_history_update_owner n S B A Δ D steps ⟨t, hlt⟩ _ _ _).trans
      (full_mixed_path_birth_history_write n S B A Δ D steps s p history ⟨t, hlt⟩)

theorem full_mixed_path_history_complete
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps s)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P)) :
    finiteEventPathHistoryAt (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D)
      (fullMixedStepHistoryUpdate n S B A Δ D steps) 0 steps s p history steps.length =
      fun i => fullMixedPathBirthLabel n S B A Δ D steps s p (fullMixedBirthOrder S B steps i) := by
  rw [full_mixed_path_history_at n S B A Δ D steps s p history steps.length le_rfl,
    full_mixed_path_birth_history_complete]

end History
end Bounty
end

section

/- One original event updates its fixed global birth coordinates without requiring a future path. -/

namespace Bounty

section Local
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K))) (u : Fin steps.length)
    (tag : Option (J ⊕ K)) (htag : steps.get u = tag)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag s)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P))

theorem full_mixed_tagged_history_write_here (a : FullMixedLocalBirthAddress S B tag) :
    fullMixedBirthHistoryWrite n S B A Δ D steps u s
      (fullMixedTaggedOwnerEvent n S B A Δ D steps u tag htag s e) history
      (fullMixedTaggedOccurrenceEmbedding S B steps u tag htag a) =
      fullMixedEventBirthLabel n S B A Δ D tag s e a := by
  subst tag
  exact full_mixed_birth_history_write_here n S B A Δ D steps u s e history a

theorem full_mixed_tagged_history_write_coverage
    (i : Fin (Fintype.card (FullMixedBirthAddress S B steps))) :
    ((fullMixedBirthHistoryWrite n S B A Δ D steps u s
      (fullMixedTaggedOwnerEvent n S B A Δ D steps u tag htag s e) history i).isSome = true ∧
      fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i) = u) ↔
    ∃ c : FullMixedEventBirthCoordinate n S B A Δ D tag s e,
      fullMixedTaggedOccurrenceEmbedding S B steps u tag htag
        (fullMixedBirthCoordinateEquiv n S B A Δ D tag s e c).val = i := by
  constructor
  · rintro ⟨hi, hu⟩
    obtain ⟨a, rfl⟩ := (full_mixed_tagged_occurrence_range S B steps u tag htag i).mp hu
    rw [full_mixed_tagged_history_write_here] at hi
    have ha : fullMixedEventBirthPerformed n S B A Δ D tag s e a := by
      simpa only [fullMixedEventBirthPerformed, fullMixedEventBirthLabel, Option.isSome_map] using hi
    refine ⟨(fullMixedBirthCoordinateEquiv n S B A Δ D tag s e).symm ⟨a, ha⟩, ?_⟩
    rw [Equiv.apply_symm_apply]
  · rintro ⟨c, rfl⟩
    refine ⟨?_, full_mixed_tagged_occurrence_owner S B steps u tag htag _⟩
    rw [full_mixed_tagged_history_write_here]
    simp only [fullMixedEventBirthLabel, Option.isSome_map]
    exact (fullMixedBirthCoordinateEquiv n S B A Δ D tag s e c).property

end Local
end Bounty
end

section

/- The support partition is independent of sampled labels and preserves the entire sample-dependent integrand. -/

open Finset Classical

namespace Bounty

theorem owner_sample_stage_sum {N m L : ℕ} {α Z : Type*} [Fintype Z]
    (embed : Fin m → Fin N) (hstrict : StrictMono embed)
    (owner : Fin N → Fin L) (hmono : Monotone owner) (u : Fin L)
    (howner : ∀ j, owner (embed j) = u) (code : BirthForestCode N)
    (values : Z → Fin N → Option α) (history : Fin N → Option α)
    (localValues : Z → Fin m → α)
    (hcover : ∀ z i, (values z i).isSome = true ∧ owner i = u ↔ i ∈ Set.range embed)
    (hother : ∀ z i, owner i ≠ u → values z i = history i)
    (hlocal : ∀ z j, values z (embed j) = some (localValues z j)) (F : Z → ℝ) :
    (∑ z, if birthForestStageCondition owner u (values z) code then F z else 0) =
      if birthForestStageSupport owner u (ownerSampleSupport embed owner u history) code then
        ∑ z, if birthForestEqualValues (restrictedBirthCode embed code) (localValues z) ∧
          birthLabelsAnchored (fun j => (restrictedBirthAnchors embed code history j).join) (localValues z)
          then F z else 0
      else 0 := by
  by_cases hs : birthForestStageSupport owner u (ownerSampleSupport embed owner u history) code
  · rw [if_pos hs]
    apply sum_congr rfl
    intro z _
    rw [owner_sample_stage_iff embed hstrict owner hmono u howner code
      (values z) history (localValues z) (hcover z) (hother z) (hlocal z)]
    simp only [hs, true_and]
  · rw [if_neg hs]
    apply sum_eq_zero
    intro z _
    rw [owner_sample_stage_iff embed hstrict owner hmono u howner code
      (values z) history (localValues z) (hcover z) (hother z) (hlocal z)]
    simp only [hs, false_and, if_false]

end Bounty
end

section

/- Supported owner forests retain exactly one atom exponent per original selected child. -/

open Finset Classical

namespace Bounty

theorem owner_supported_selected_fiber_card
    {G : Type*} [Fintype G] [DecidableEq G] (I : G → Type*) [∀ g, Fintype (I g)]
    {m N L : ℕ} {α : Type*} (ord : Fin m ≃ Sigma I) (f : Sigma I ↪ Fin N)
    (owner : Fin N → Fin L) (u : Fin L) (group : Fin N → G)
    (howner : ∀ i, owner (f i) = u) (hgroup : ∀ i, group (f i) = i.1)
    (code : BirthForestCode N) (history : Fin N → Option α)
    (hs : birthForestStageSupport owner u (ownerSampleSupport (f ∘ ord) owner u history) code)
    (g : G) :
    (univ.filter (fun i : I g => code (f ⟨g, i⟩) ≠ none)).card =
      (univ.filter (fun i => owner i = u ∧ group i = g ∧ code i ≠ none)).card := by
  apply selected_fiber_card f (fun i => owner i = u) (fun i => code i ≠ none) group howner hgroup
  intro i hi hc
  have hp := birth_forest_stage_support_children owner u _ code hs i hi hc
  obtain ⟨j, hj⟩ := owner_sample_support_cover (f ∘ ord) owner u history i hp hi
  exact ⟨ord j, hj⟩

theorem grouped_join_restricted_forest_cost_eq
    {G : Type*} [Fintype G] [DecidableEq G] (I : G → Type*) [∀ g, Fintype (I g)]
    {m N : ℕ} {α : Type*} (ord : Fin m ≃ Sigma I) (f : Sigma I → Fin N)
    (code : BirthForestCode N) (history : Fin N → Option α) (root atom : G → ℝ) (d : G → ℕ)
    (hvalid : ∀ j, restrictedBirthAnchors (f ∘ ord) code history j ≠ some none)
    (hd : ∀ g, (univ.filter (fun i : I g => code (f ⟨g, i⟩) ≠ none)).card = d g) :
    (∏ j, match restrictedBirthCode (f ∘ ord) code j with
      | some _ => atom (ord j).1
      | none => match (restrictedBirthAnchors (f ∘ ord) code history j).join with
        | none => root (ord j).1 | some _ => atom (ord j).1) =
      ∏ g, atom g ^ d g * root g ^ (Fintype.card (I g) - d g) := by
  apply grouped_forest_cost_eq I ord (restrictedBirthCode (f ∘ ord) code)
    (fun j => (restrictedBirthAnchors (f ∘ ord) code history j).join) root atom d
  intro g
  have he : (univ.filter (fun i : I g =>
      restrictedBirthCode (f ∘ ord) code (ord.symm ⟨g, i⟩) ≠ none ∨
      (restrictedBirthAnchors (f ∘ ord) code history (ord.symm ⟨g, i⟩)).join ≠ none)) =
      univ.filter (fun i : I g => code (f ⟨g, i⟩) ≠ none) := by
    ext i
    simp only [mem_filter, mem_univ, true_and, restricted_join_selected_iff _ _ _ hvalid,
      Function.comp_apply]
    exact Iff.of_eq (congrArg (fun k => code (f k) ≠ none) (ord.apply_symm_apply ⟨g, i⟩))
  rw [he]
  exact hd g

end Bounty
end

section

/- No forest incidence removes exactly the local forest factor, leaving initial avoidance. -/

open Finset Classical
namespace Bounty
section Local
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
    (steps : List (Option (J ⊕ K)))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))
    (θ : (Fin (Fintype.card (FullMixedBirthAddress S B steps)) ×
      Fin (Fintype.card (FullMixedBirthAddress S B steps))) → ℝ)
    (encode : ((g : Fin N) × P g) → ℤ) (i : Fin steps.length)
    (hi : i ∉ fullMixedBirthAffectedOperations S B steps code)

include hi in
theorem full_mixed_local_forest_factor_eq_one
    (labels : FullMixedLocalBirthAddress S B (steps.get i) → Option ((g : Fin N) × P g)) :
    fullMixedLocalForestFactor S B steps code θ encode i labels = 1 :=
  birthForestOperationMultiplier_eq_one code (fullMixedIndexedBirthOwner S B steps) θ _ _ i hi

include hi in
theorem full_mixed_birth_frequency_zero_of_unaffected
    (j : Fin (Fintype.card (FullMixedBirthAddress S B steps)))
    (hj : fullMixedIndexedBirthOwner S B steps j = i) :
    birthForestLocalFrequency code θ j = 0 := by
  apply birthForestLocalFrequency_eq_zero_of_not_touched
  intro ht
  apply hi
  simp only [fullMixedBirthAffectedOperations, birthForestAffectedOperations, mem_image]
  exact ⟨j, ht, hj⟩

end Local
section Stage
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
    [∀ g, Fintype (P g)] [∀ g, DecidableEq (P g)]
    (n : (g : Fin N) → P g → ℕ) [∀ g p, NeZero (n g p)]
    {M : Fin N → ℕ} (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (ω : ∀ k c, A k c → ℝ) (μ : (g : Fin N) → P g → ℝ)
    (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (steps : List (Option (J ⊕ K)))
    (residual : ∀ (tag : Option (J ⊕ K)) s, FullPermutationMixedEvent n S B A Δ D tag s → ℂ)
    (initial : (g : Fin N) → Finset (P g))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))
    (θ : (Fin (Fintype.card (FullMixedBirthAddress S B steps)) ×
      Fin (Fintype.card (FullMixedBirthAddress S B steps))) → ℝ)
    (encode : ((g : Fin N) × P g) → ℤ) (i : Fin steps.length)
    (hi : i ∉ fullMixedBirthAffectedOperations S B steps code)

include hi in
omit [∀ g, Fintype (P g)] [∀ g, DecidableEq (P g)]
  [∀ g p, NeZero (n g p)] [∀ k c, Fintype (A k c)] in
theorem full_mixed_untouched_stage_phase
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (steps.get i) s) :
    fullMixedForestStagePhase n S B A Δ D steps residual initial code θ encode i s e =
      residual (steps.get i) s e *
        (if FullMixedLocalBirthAvoids n S B A Δ D initial (steps.get i) s e then 1 else 0) := by
  rw [fullMixedForestStagePhase,
    full_mixed_local_forest_factor_eq_one S B steps code θ encode i hi, mul_one]

include hi in
omit [∀ g, DecidableEq (P g)] in
theorem full_mixed_untouched_stage_row
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    fullMixedForestStageRow n S B A Δ D ω μ q ρ V steps residual initial code θ encode i f s =
    let _ := fullPermutationMixedEventFintype n S B A Δ D (steps.get i) s
    ∑ e : FullPermutationMixedEvent n S B A Δ D (steps.get i) s,
      (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V (steps.get i) s e : ℂ) *
      (residual (steps.get i) s e *
        (if FullMixedLocalBirthAvoids n S B A Δ D initial (steps.get i) s e then 1 else 0)) *
      f (fullPermutationMixedEventTarget n S B A Δ D (steps.get i) s e) := by
  simp only [fullMixedForestStageRow,
    full_mixed_untouched_stage_phase n S B A Δ D steps residual initial code θ encode i hi]

end Stage
end Bounty
