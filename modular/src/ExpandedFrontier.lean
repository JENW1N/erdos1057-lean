section

/- The whole original integer common window at every rational center. -/

open Finset MeasureTheory
namespace Bounty

theorem exists_common_integer_mellin_energy_constants {j : ℕ} (hj : 2 ≤ j) :
    ∃ Cj Cerr : ℝ, 0 < Cj ∧ 0 < Cerr ∧
      ∀ (S : Finset ℤ) (f : ℤ → ℂ) (Y H c : ℝ),
      0 < Y → 1 ≤ H → H ≤ Y/64 →
      (∀ n ∈ S, Y/8 ≤ (n : ℝ) ∧ (n : ℝ) ≤ 4*Real.exp 2*Y) →
      (∫ x in Set.Icc (c-1/H) (c+1/H), ‖finiteFourierSum S f x‖^2) ≤
        (Cj/Y) * (∫ t : ℝ, (1+|(H/Y)*t|)^(-(j : ℝ))*
          ‖localMellinPolynomial (S.image Int.natAbs)
            (fun n => f n * fourier (n : ℤ) (c : AddCircle (1 : ℝ))) t‖^2) +
        Cerr*(H/Y)^2*(∑ n ∈ S, ‖f n‖^2) := by
  obtain ⟨Cj, Cerr, hCj, hCerr, hlocal⟩ := exists_common_window_fourier_mellin_energy_constants hj
  refine ⟨Cj, Cerr, hCj, hCerr, ?_⟩
  intro S f Y H c hY hH hHY hS
  have hpos (n : ℤ) (hn : n ∈ S) : 0 ≤ n := by
    have hnR : (0 : ℝ) ≤ n := (by positivity : (0 : ℝ) ≤ Y/8).trans (hS n hn).1
    exact_mod_cast hnR
  have himage : ∀ n ∈ S.image Int.natAbs, Y/8 ≤ (n : ℝ) ∧ (n : ℝ) ≤ 4*Real.exp 2*Y := by
    intro n hn
    obtain ⟨m, hm, rfl⟩ := mem_image.mp hn
    have he : (m.natAbs : ℝ) = (m : ℝ) := by
      simpa only [Int.cast_natCast] using
        congrArg (fun z : ℤ => (z : ℝ)) (Int.natAbs_of_nonneg (hpos m hm))
    rw [he]
    exact hS m hm
  rw [finite_fourier_centered_energy S f hpos c H (by linarith)]
  have hb := hlocal (S.image Int.natAbs)
    (fun n => f n * fourier (n : ℤ) (c : AddCircle (1 : ℝ))) Y H hY hH hHY himage
  simpa only [finite_fourier_modulated_energy S f hpos c] using hb

theorem exists_harmonic_common_center_energy_constants {j : ℕ} (hj : 2 ≤ j) :
    ∃ Cj Cerr : ℝ, 0 < Cj ∧ 0 < Cerr ∧
      ∀ (f : ℤ → ℂ) (Y H c : ℝ), 0 < Y → 1 ≤ H → H ≤ Y/64 →
      (∫ x in Set.Icc (c-1/H) (c+1/H),
        ‖finiteFourierSum (harmonicCommonSupport Y) f x‖^2) ≤
        (Cj/Y) * (∫ t : ℝ, (1+|(H/Y)*t|)^(-(j : ℝ))*
          ‖localMellinPolynomial ((harmonicCommonSupport Y).image Int.natAbs)
            (fun n => f n * fourier (n : ℤ) (c : AddCircle (1 : ℝ))) t‖^2) +
        Cerr*(H/Y)^2*(∑ n ∈ harmonicCommonSupport Y, ‖f n‖^2) := by
  obtain ⟨Cj,Cerr,hCj,hCerr,hbound⟩ := exists_common_integer_mellin_energy_constants hj
  refine ⟨Cj,Cerr,hCj,hCerr,?_⟩
  intro f Y H c hY hH hHY
  exact hbound (harmonicCommonSupport Y) f Y H c hY hH hHY
    (fun _ hn => mem_harmonic_common_support.mp hn)

end Bounty
