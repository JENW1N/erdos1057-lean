section

/- An exact separated expansion of the retained cell kernel. -/

open Finset
open scoped Classical
namespace Bounty

theorem finite_cell_kernel_expansion {X D I : Type*} [Fintype X] [Fintype I]
    [DecidableEq D] (μ : X → ℝ) (cell : X → D) (kept : Finset D)
    (ψ : I → X → ℂ) (x y : X) :
    finiteCellFrameKernel μ cell kept ψ x y =
      ∑ d ∈ kept, ∑ i, ((1 / finiteCellMass μ cell d : ℝ) : ℂ) *
        (if cell x = d then ψ i x else 0) *
        (if cell y = d then (starRingEnd ℂ) (ψ i y) else 0) := by
  by_cases hxy : cell x = cell y
  · by_cases hx : cell x ∈ kept
    · rw [finiteCellFrameKernel, if_pos ⟨hxy, hx⟩,
        sum_eq_single (cell x)]
      · simp only [← hxy, ite_true, finiteMeasureFrameKernel, mul_sum, mul_assoc]
      · intro d _ hd
        simp only [if_neg (Ne.symm hd), mul_zero, zero_mul, sum_const_zero]
      · exact fun h => (h hx).elim
    · rw [finiteCellFrameKernel, if_neg (by simp only [hx, and_false, not_false_eq_true])]
      symm
      apply sum_eq_zero
      intro d hd
      have hxd : cell x ≠ d := by intro he; exact hx (he.symm ▸ hd)
      simp only [if_neg hxd, mul_zero, zero_mul, sum_const_zero]
  · rw [finiteCellFrameKernel, if_neg (by simp only [hxy, false_and, not_false_eq_true])]
    symm
    apply sum_eq_zero
    intro d _
    by_cases hx : cell x = d
    · have hy : cell y ≠ d := by intro he; exact hxy (hx.trans he.symm)
      simp only [if_neg hy, mul_zero, sum_const_zero]
    · simp only [if_neg hx, mul_zero, zero_mul, sum_const_zero]

end Bounty
end

section

/- Exact Fourier identities for finitely supported integer correlations. -/

open Finset MeasureTheory
open scoped ComplexConjugate
namespace Bounty

theorem integral_shifted_fourier_cross (m n δ : ℤ) :
    (∫ x in (0 : ℝ)..1, conj (fourier m (x : AddCircle (1 : ℝ))) *
      fourier n (x : AddCircle (1 : ℝ)) * fourier (-δ) (x : AddCircle (1 : ℝ))) =
      if n = m+δ then 1 else 0 := by
  simp_rw [mul_assoc, ← fourier_add]
  rw [integral_fourier_cross]
  simp only [show (m = n + -δ) ↔ n = m+δ by omega]

theorem finite_fourier_shift_correlation (S T : Finset ℤ) (f g : ℤ → ℂ) (δ : ℤ) :
    (∫ x in (0 : ℝ)..1, conj (finiteFourierSum S f x) * finiteFourierSum T g x *
      fourier (-δ) (x : AddCircle (1 : ℝ))) =
      ∑ n ∈ S, if n+δ ∈ T then conj (f n) * g (n+δ) else 0 := by
  have hcont (m n : ℤ) : Continuous (fun x : ℝ =>
      (conj (f m)*g n) * (conj (fourier m (x : AddCircle (1 : ℝ))) *
        fourier n (x : AddCircle (1 : ℝ)) * fourier (-δ) (x : AddCircle (1 : ℝ)))) :=
    continuous_const.mul (((continuous_fourier_real m).star.mul
      (continuous_fourier_real n)).mul (continuous_fourier_real (-δ)))
  have hpoint (x : ℝ) :
      conj (finiteFourierSum S f x) * finiteFourierSum T g x *
          fourier (-δ) (x : AddCircle (1 : ℝ)) =
        ∑ m ∈ S, ∑ n ∈ T, (conj (f m)*g n) *
          (conj (fourier m (x : AddCircle (1 : ℝ))) *
            fourier n (x : AddCircle (1 : ℝ)) * fourier (-δ) (x : AddCircle (1 : ℝ))) := by
    simp only [finiteFourierSum, map_sum, map_mul, sum_mul, mul_sum]
    rw [sum_comm]
    apply sum_congr rfl
    intro m _
    apply sum_congr rfl
    intro n _
    ring
  simp_rw [hpoint]
  rw [intervalIntegral.integral_finsetSum
    (fun m _ => (continuous_finsetSum T (fun n _ => hcont m n)).intervalIntegrable _ _)]
  apply sum_congr rfl
  intro m _
  rw [intervalIntegral.integral_finsetSum (fun n _ => (hcont m n).intervalIntegrable _ _)]
  simp_rw [intervalIntegral.integral_const_mul, integral_shifted_fourier_cross]
  simp

end Bounty
end

section

/- Square-energy estimates for complex pairings with explicit measures. -/

open MeasureTheory
open scoped ComplexConjugate
namespace Bounty

theorem integral_pairing_energy {X : Type*} [MeasurableSpace X]
    (μ : Measure X) (f g : X → ℂ) (hf : MemLp f 2 μ) (hg : MemLp g 2 μ) :
    ‖∫ x, conj (f x)*g x ∂μ‖ ≤
      Real.sqrt (∫ x, ‖f x‖^2 ∂μ)*Real.sqrt (∫ x, ‖g x‖^2 ∂μ) := by
  calc
    _ ≤ ∫ x, ‖conj (f x)*g x‖ ∂μ := norm_integral_le_integral_norm _
    _ = ∫ x, ‖f x‖*‖g x‖ ∂μ := by simp only [norm_mul, RCLike.norm_conj]
    _ ≤ _ := by
      have h := integral_mul_norm_le_Lp_mul_Lq Real.HolderConjugate.two_two
        (by simpa using hf) (by simpa using hg)
      simpa only [Real.rpow_two, Real.sqrt_eq_rpow] using h

end Bounty
end

section

/- Fixed scalar losses for the common harmonic endpoint window. -/

namespace Bounty

theorem harmonic_common_window_ceiling_bounds {Y : ℝ} (hY : 1 ≤ Y) :
    (⌈4 * Real.exp 2 * Y⌉₊ : ℝ) ≤ 5 * Real.exp 2 * Y ∧
    (⌈4 * Real.exp 2 * Y⌉₊ : ℝ) / (Y / 8) ≤ 40 * Real.exp 2 ∧
    Real.log (⌈4 * Real.exp 2 * Y⌉₊ : ℝ) ≤ Real.log 5 + 2 + Real.log Y := by
  have hY0 : 0 < Y := zero_lt_one.trans_le hY
  have hE : 1 ≤ Real.exp (2 : ℝ) := Real.one_le_exp (by norm_num)
  have hEY : 1 ≤ Real.exp 2 * Y := by
    simpa only [one_mul] using mul_le_mul hE hY (by norm_num : (0 : ℝ) ≤ 1) (Real.exp_pos _).le
  have hceil := Nat.ceil_lt_add_one (by positivity : 0 ≤ 4 * Real.exp 2 * Y)
  have hbound : (⌈4 * Real.exp 2 * Y⌉₊ : ℝ) ≤ 5 * Real.exp 2 * Y := by nlinarith
  have hN : 0 < (⌈4 * Real.exp 2 * Y⌉₊ : ℝ) :=
    lt_of_lt_of_le (by positivity) (Nat.le_ceil _)
  refine ⟨hbound, ?_, ?_⟩
  · apply (div_le_iff₀ (by positivity : 0 < Y / 8)).mpr
    nlinarith
  · calc
      Real.log (⌈4 * Real.exp 2 * Y⌉₊ : ℝ) ≤ Real.log (5 * Real.exp 2 * Y) :=
        Real.log_le_log hN hbound
      _ = Real.log 5 + 2 + Real.log Y := by
        rw [Real.log_mul (by positivity) hY0.ne',
          Real.log_mul (by norm_num) (Real.exp_pos _).ne', Real.log_exp]

end Bounty
end

section

/- Integration over a finite cover without assuming disjointness. -/

open Finset MeasureTheory
namespace Bounty

theorem finite_cover_integral_le {X I : Type*} [MeasurableSpace X]
    (μ : Measure X) (s : Finset I) (B : Set X) (C : I → Set X) (f : X → ℝ)
    (hB : MeasurableSet B) (hC : ∀ i ∈ s, MeasurableSet (C i))
    (hf : ∀ x, 0 ≤ f x) (hIB : IntegrableOn f B μ)
    (hIC : ∀ i ∈ s, IntegrableOn f (C i) μ)
    (hcover : ∀ x ∈ B, ∃ i ∈ s, x ∈ C i) :
    (∫ x in B, f x ∂μ) ≤ ∑ i ∈ s, ∫ x in C i, f x ∂μ := by
  classical
  have hint (i : I) (hi : i ∈ s) : Integrable ((C i).indicator f) μ :=
    (hIC i hi).integrable_indicator (hC i hi)
  have hpos (i : I) (x : X) : 0 ≤ (C i).indicator f x := by
    by_cases hx : x ∈ C i
    · simpa only [Set.indicator_of_mem hx] using hf x
    · simp only [Set.indicator_of_notMem hx, le_refl]
  calc
    _ = ∫ x, B.indicator f x ∂μ := (integral_indicator hB).symm
    _ ≤ ∫ x, ∑ i ∈ s, (C i).indicator f x ∂μ := by
      apply integral_mono (hIB.integrable_indicator hB) (integrable_finsetSum s hint)
      intro x
      dsimp only
      by_cases hx : x ∈ B
      · obtain ⟨i, hi, hxi⟩ := hcover x hx
        rw [Set.indicator_of_mem hx]
        have h := single_le_sum (fun j _ => hpos j x) hi
        simpa only [Set.indicator_of_mem hxi] using h
      · rw [Set.indicator_of_notMem hx]
        exact sum_nonneg (fun i _ => hpos i x)
    _ = _ := by
      rw [integral_finsetSum s hint]
      apply sum_congr rfl
      intro i hi
      exact integral_indicator (hC i hi)

end Bounty
end

section

open MeasureTheory

namespace Bounty

noncomputable def dyadicAbsShell (R : ℝ) (n : ℕ) : Set ℝ :=
  {t | (2:ℝ)^n*R ≤ |t| ∧ |t| < (2:ℝ)^(n+1)*R}

theorem dyadic_abs_shell_measurable (R : ℝ) (n : ℕ) :
    MeasurableSet (dyadicAbsShell R n) := by
  unfold dyadicAbsShell
  exact (isClosed_le continuous_const continuous_abs).measurableSet.inter
    (isOpen_lt continuous_abs continuous_const).measurableSet

theorem dyadic_abs_shell_disjoint {R : ℝ} (hR : 0 < R) :
    Pairwise (fun i j => Disjoint (dyadicAbsShell R i) (dyadicAbsShell R j)) := by
  intro i j hij
  apply Set.disjoint_left.2
  intro t hi hj
  rcases lt_or_gt_of_ne hij with h | h
  · have hp : (2:ℝ)^(i+1) ≤ (2:ℝ)^j := pow_le_pow_right₀ (by norm_num) h
    exact (not_lt_of_ge (mul_le_mul_of_nonneg_right hp hR.le |>.trans hj.1)) hi.2
  · have hp : (2:ℝ)^(j+1) ≤ (2:ℝ)^i := pow_le_pow_right₀ (by norm_num) h
    exact (not_lt_of_ge (mul_le_mul_of_nonneg_right hp hR.le |>.trans hi.1)) hj.2

theorem dyadic_abs_shell_union {R : ℝ} (hR : 0 < R) :
    (⋃ n : ℕ, dyadicAbsShell R n) = {t : ℝ | R ≤ |t|} := by
  ext t
  constructor
  · intro ht
    obtain ⟨n, hn⟩ := Set.mem_iUnion.1 ht
    exact (le_mul_of_one_le_left hR.le (one_le_pow₀ (by norm_num))).trans hn.1
  · intro ht
    obtain ⟨n, hn, hn'⟩ := exists_nat_pow_near ((le_div_iff₀ hR).2 (by simpa using ht)) (show (1:ℝ)<2 by norm_num)
    exact Set.mem_iUnion.2 ⟨n, (le_div_iff₀ hR).1 hn, (div_lt_iff₀ hR).1 hn'⟩

theorem integral_dyadic_abs_shells {R : ℝ} (hR : 0 < R) {f : ℝ → ℝ}
    (hf : Integrable f) :
    (∫ t in {t : ℝ | R ≤ |t|}, f t) =
      ∑' n : ℕ, ∫ t in dyadicAbsShell R n, f t := by
  rw [← dyadic_abs_shell_union hR]
  exact integral_iUnion (dyadic_abs_shell_measurable R)
    (dyadic_abs_shell_disjoint hR) hf.integrableOn

end Bounty
end

section

open Filter

namespace Bounty

theorem local_scale_exp_ratio {b L Y H : ℝ}
    (hY : Real.exp (b*L) ≤ Y) (hH : H ≤ Real.exp ((b/2)*L)) :
    H/Y ≤ Real.exp (-(b/2)*L) := by
  have hYp : 0 < Y := (Real.exp_pos _).trans_le hY
  calc
    H/Y ≤ Real.exp ((b/2)*L)/Y := div_le_div_of_nonneg_right hH hYp.le
    _ ≤ Real.exp ((b/2)*L)/Real.exp (b*L) :=
      div_le_div_of_nonneg_left (Real.exp_pos _).le (Real.exp_pos _) hY
    _ = _ := by rw [← Real.exp_sub]; congr 1; ring

theorem eventually_local_scale_error {b C : ℝ} (hb : 0 < b) (hC : 0 ≤ C) (A B : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ Y H E : ℝ,
      Real.exp (b*L) ≤ Y → 1 ≤ H → H ≤ Real.exp ((b/2)*L) → E ≤ Y*L^B →
      H ≤ Y/64 ∧ C*(H/Y)^2*E ≤ Y*L^(-A)/2 := by
  have hs : Tendsto (fun L : ℝ => Real.exp (-(b/2)*L)) atTop (nhds 0) := by
    simpa only [Real.rpow_zero, one_mul] using
      tendsto_rpow_mul_exp_neg_mul_atTop_nhds_zero 0 (b/2) (by positivity)
  have he : Tendsto (fun L : ℝ => C*(L^(A+B)*Real.exp (-b*L))) atTop (nhds 0) := by
    simpa only [mul_zero] using
      (tendsto_rpow_mul_exp_neg_mul_atTop_nhds_zero (A+B) b hb).const_mul C
  filter_upwards [hs.eventually_le_const (by norm_num : (0:ℝ)<1/64),
    he.eventually_le_const (by norm_num : (0:ℝ)<1/2), eventually_gt_atTop (0:ℝ)] with L hs he hL
  intro Y H E hY hH hHu hE
  have hYp : 0 < Y := (Real.exp_pos _).trans_le hY
  have hHp : 0 < H := lt_of_lt_of_le zero_lt_one hH
  have hr := local_scale_exp_ratio hY hHu
  have hsmall : H ≤ Y/64 := by
    have hh := (div_le_iff₀ hYp).1 (hr.trans hs)
    linarith
  refine ⟨hsmall, ?_⟩
  have hr2 : (H/Y)^2 ≤ Real.exp (-b*L) := by
    calc
      (H/Y)^2 ≤ (Real.exp (-(b/2)*L))^2 := pow_le_pow_left₀ (by positivity) hr 2
      _ = _ := by rw [← Real.exp_nat_mul]; congr 1; norm_num; ring
  have hbound : C*Real.exp (-b*L)*L^B ≤ L^(-A)/2 := by
    have he' := mul_le_mul_of_nonneg_right he (Real.rpow_pos_of_pos hL (-A)).le
    have hpow : L^(A+B)*L^(-A) = L^B := by
      rw [← Real.rpow_add hL]
      congr 1
      ring
    calc
      _ = (C*(L^(A+B)*Real.exp (-b*L)))*L^(-A) := by rw [← hpow]; ring
      _ ≤ (1/2)*L^(-A) := he'
      _ = _ := by ring
  calc
    C*(H/Y)^2*E ≤ C*(H/Y)^2*(Y*L^B) := mul_le_mul_of_nonneg_left hE (by positivity)
    _ ≤ C*Real.exp (-b*L)*(Y*L^B) := by gcongr
    _ = Y*(C*Real.exp (-b*L)*L^B) := by ring
    _ ≤ Y*(L^(-A)/2) := mul_le_mul_of_nonneg_left hbound hYp.le
    _ = _ := by ring

end Bounty
end

section

/- Equal schedules preserve full-path terminal states, signed weights and local phases. -/

namespace Bounty
section Schedule
variable {K X : Type*} (E : K → X → Type*) (target : ∀ k x, E k x → X)

theorem finite_event_terminal_schedule_cast
    {ks ks' : List K} (h : ks = ks') (x : X) (p : FiniteEventPath E target ks x) :
    finiteEventPathTerminal E target ks' x
        (cast (congrArg (fun steps => FiniteEventPath E target steps x) h) p) =
      finiteEventPathTerminal E target ks x p := by
  cases h
  rfl

theorem finite_event_weight_schedule_cast (weight : ∀ k x, E k x → ℝ)
    {ks ks' : List K} (h : ks = ks') (x : X) (p : FiniteEventPath E target ks x) :
    finiteEventPathWeight E target weight ks' x
        (cast (congrArg (fun steps => FiniteEventPath E target steps x) h) p) =
