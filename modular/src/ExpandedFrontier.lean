    (hq0 : ∀ i, 0 ≤ retention i) (hq1 : ∀ i, retention i ≤ 1)
    (hD : ∀ i, retention i / ρ ^ 2 + ((1 - retention i) / ρ) / v ≤ 1)
    (hC : ∀ i g, retention i / ρ ^ 2 + ((1 - retention i) * V g / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ j g, ell + (C (pattern j).val g).card ≤ T)
    (hmask : ∀ d ∈ S, ‖mask d‖ ≤ 1)
    (A : ℝ) (hA : 0 < A)
    (hK : ∀ d ∈ S, ∀ j : Fin (r + 1),
      ‖K (r - j.val) (pattern j).val
        (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc))
        (physicalPermuteLabels (d.2.2.2 j) (d.2.1 j.succ)) (d.1 j)‖ ≤ A)
    (a : S → Fin (r + 2) → ℤ)
    (hstep : ∀ d : S, ∀ j : Fin (r + 1), a d j.succ = a d j.castSucc +
