open scoped BigOperators Classical
theorem prime_tuple_cell_norm_le {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ) (i : I)
    (hV : ∀ j, 0 < V j) (hp : ∀ j p, p ∈ P j → 0 < p)
    (hmass : ∀ j, ∑ p ∈ P j, 1 / (p : ℝ) = V j)
    {q : ℕ} (χ : DirichletCharacter ℂ q) (U W : ℝ) {B : ℝ} (hB : 0 ≤ B)
    (hinner : ∀ c : ℕ, 0 < c →
      ‖∑ p ∈ (P i).filter (fun p : ℕ => U < ((c * p : ℕ) : ℝ) ∧ ((c * p : ℕ) : ℝ) ≤ W),
        (1 / (p : ℝ)) • χ (p : ZMod q)‖ ≤ B) :
    ‖∑ x : (∀ j, P j), (finiteProductWeight (physicalLabelLaw V) x : ℂ) *
        (if U < ((∏ j, (x j).val : ℕ) : ℝ) ∧ ((∏ j, (x j).val : ℕ) : ℝ) ≤ W
        then χ ((∏ j, (x j).val : ℕ) : ZMod q) else 0)‖ ≤ B / V i := by
  let μ : ∀ j, P j → ℝ := physicalLabelLaw V
  let F : ℕ → ℂ := fun n => if U < (n : ℝ) ∧ (n : ℝ) ≤ W then χ (n : ZMod q) else 0
  let R := ∀ j : {j : I // j ≠ i}, P j.val
  let c : R → ℕ := fun z => ∏ j, (z j).val
  let ν : R → ℝ := fun z => ∏ j, μ j.val (z j)
  let S : R → Finset ℕ := fun z => (P i).filter (fun p : ℕ =>
    U < ((c z * p : ℕ) : ℝ) ∧ ((c z * p : ℕ) : ℝ) ≤ W)
  have hsplit := finite_product_value_expectation_split μ (fun j (p : P j) => p.val) i F
  change ‖∑ x, (finiteProductWeight μ x : ℂ) * F (∏ j, (x j).val)‖ ≤ B / V i
  rw [hsplit]
  have hrow (z : R) : (∑ y : P i, (μ i y : ℂ) * F (y.val * c z)) =
      ∑ p ∈ S z, (1 / (V i * (p : ℝ))) • χ ((c z * p : ℕ) : ZMod q) := by
    unfold S
    rw [Finset.sum_filter]
    rw [← Finset.sum_coe_sort (P i)]
    apply Finset.sum_congr rfl
    intro y _
    dsimp only [μ, physicalLabelLaw]
    rw [Nat.mul_comm y.val]
    dsimp only [F]
    split_ifs <;> simp only [mul_zero, Complex.real_smul]
  have heq : (∑ z : R, (ν z : ℂ) * ∑ y : P i, (μ i y : ℂ) * F (y.val * c z)) =
      ∑ z : R, (ν z : ℂ) * ∑ p ∈ S z,
        (1 / (V i * (p : ℝ))) • χ ((c z * p : ℕ) : ZMod q) := by
    apply Finset.sum_congr rfl
    intro z _
    rw [hrow]
  change ‖∑ z : R, (ν z : ℂ) * ∑ y : P i, (μ i y : ℂ) * F (y.val * c z)‖ ≤ _
  rw [heq]
  refine prime_band_product_mixture_bound χ S c ν ?_ ?_ (hV i) hB ?_
  · intro z
    exact Finset.prod_nonneg (fun j _ =>
      physical_label_law_nonneg V (fun j => (hV j).le) j.val (z j))
  · have hn := finite_product_weight_sum_one (fun (j : {j : I // j ≠ i}) (p : P j.val) => μ j.val p)
      (fun j => physical_label_law_sum V j.val (hV j.val) (hmass j.val))
    exact le_of_eq hn
  · intro z
    apply hinner
    exact Finset.prod_pos (fun j _ => hp j.val (z j).val (z j).property)

theorem prime_tuple_cell_bound_of_zero_free (hZ : PrimitiveZeroFreeHalfPlane) :
    ∃ C : ℝ, 0 < C ∧ ∀ (q : ℕ), 0 < q →
      ∀ χ : DirichletCharacter ℂ q, χ ≠ 1 →
      ∀ {I : Type*} [Fintype I] [DecidableEq I],
      ∀ (P : I → Finset ℕ) (V : I → ℝ) (i : I),
      (∀ j, 0 < V j) → (∀ j p, p ∈ P j → 0 < p) →
      (∀ j, ∑ p ∈ P j, 1 / (p : ℝ) = V j) →
      ∀ a b : ℝ, P i = primeBand a b → 2 ≤ a → 0 ≤ b →
      ∀ U W : ℝ, 0 ≤ U → 0 ≤ W →
        ‖∑ x : (∀ j, P j), (finiteProductWeight (physicalLabelLaw V) x : ℂ) *
          (if U < ((∏ j, (x j).val : ℕ) : ℝ) ∧ ((∏ j, (x j).val : ℕ) : ℝ) ≤ W
          then χ ((∏ j, (x j).val : ℕ) : ZMod q) else 0)‖ ≤
            (C / V i) * a ^ (-(1 : ℝ) / 32) * (1 + Real.log q / Real.log a) := by
  obtain ⟨C, hC, hbound⟩ := reciprocal_prime_band_product_interval_bound hZ
  refine ⟨C, hC, ?_⟩
  intro q hq χ hχ I _ _ P V i hV hp hmass a b hPi ha hb U W hU hW
  have hqR : (1 : ℝ) ≤ q := by exact_mod_cast hq
  have hlq : 0 ≤ Real.log (q : ℝ) := Real.log_nonneg hqR
  have hla : 0 < Real.log a := Real.log_pos (by linarith)
  have hB : 0 ≤ C * a ^ (-(1 : ℝ) / 32) * (1 + Real.log q / Real.log a) := by positivity
  have h := prime_tuple_cell_norm_le P V i hV hp hmass χ U W hB (fun c hc => by
    rw [hPi]
    simpa only [Nat.cast_mul] using
      hbound q hq χ hχ a b (c : ℝ) U W ha hb (by exact_mod_cast hc) hU hW)
  calc
    _ ≤ (C * a ^ (-(1 : ℝ) / 32) * (1 + Real.log q / Real.log a)) / V i := h
    _ = _ := by ring
end

