      (fullActiveUnrestrictedEdge n S B ω Δ D μ ρ V (fun _ _ _ _ => 1)
        (complexNormEnvelope f) x).re := by
  exact equiv_fiber_average_lift_norm_le (productActiveMemorySplit S B) ω hω
    (fun c a => unrestrictedCoupledCutoffProductOperator n (Δ c a) (D c a)
      μ ρ V (fun g => (S g)ᶜ.card) B (phase c a))
    (fun c a => unrestrictedCoupledCutoffProductOperator n (Δ c a) (D c a)
      μ ρ V (fun g => (S g)ᶜ.card) B (fun _ _ => 1))
    (fun c a F y => unrestricted_coupled_cutoff_norm_le_positive_re n (Δ c a) (D c a) μ ρ V
      (fun g => (S g)ᶜ.card) B hρ hV hμ (phase c a) (hphase c a) F y) f x

