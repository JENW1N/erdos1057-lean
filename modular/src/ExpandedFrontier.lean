/- The full edge reindex keeps its shared labels and auxiliary draw unchanged. -/

open Finset Classical
namespace Bounty
section Full
variable {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : SharedActiveLabels P S → Type*) (Δ D : ∀ c, A c → G → ℤ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (τ : ∀ g, Equiv.Perm (Fin (s g).2.1.val))

noncomputable def fullEdgeMemoryReindex : FullActiveEdgeEvent n S B A Δ D s ≃
    FullActiveEdgeEvent n S B A Δ D (productMemoryReindex s τ) :=
  Equiv.sigmaCongrRight fun a => jointEdgeMemoryReindex n
    (Δ (productActiveMemorySplit S B s).1 a) (D (productActiveMemorySplit S B s).1 a)
    (fun g => (S g)ᶜ.card) B (productActiveMemorySplit S B s).2 τ

omit [DecidableEq G] in
theorem full_edge_reindex_weight (ω : ∀ c, A c → ℝ)
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ) (e : FullActiveEdgeEvent n S B A Δ D s) :
    fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V (productMemoryReindex s τ)
      (fullEdgeMemoryReindex n S B A Δ D s τ e) =
    fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V s e := by
  exact congrArg (fun w => ω (productActiveMemorySplit S B s).1 e.1 * w)
    (joint_edge_reindex_weight n _ _ (fun g => (S g)ᶜ.card) B
      (productActiveMemorySplit S B s).2 τ μ ρ V e.2)

theorem full_edge_reindex_test (e : FullActiveEdgeEvent n S B A Δ D s)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    f (fullActiveEdgeEventTarget n S B A Δ D (productMemoryReindex s τ)
      (fullEdgeMemoryReindex n S B A Δ D s τ e)) =
    f (fullActiveEdgeEventTarget n S B A Δ D s e) := by
  exact joint_edge_reindex_test n _ _ (fun g => (S g)ᶜ.card) B
    (productActiveMemorySplit S B s).2 τ e.2
    (equivFiberSlice (productActiveMemorySplit S B) f (productActiveMemorySplit S B s).1)
    (productActiveMemorySlice_symmetric S B f hf _)

omit [Fintype G] [DecidableEq G] in
theorem full_edge_reindex_active (e : FullActiveEdgeEvent n S B A Δ D s) (g : G) :
    (fullActiveEdgeEventTarget n S B A Δ D (productMemoryReindex s τ)
      (fullEdgeMemoryReindex n S B A Δ D s τ e) g).1 =
    (fullActiveEdgeEventTarget n S B A Δ D s e g).1 := by
  exact congrArg (fun a => (activeTupleSplit (S g)).symm
      ((productActiveMemorySplit S B s).1 g, a))
    (joint_edge_reindex_active n _ _ (fun g => (S g)ᶜ.card) B
      (productActiveMemorySplit S B s).2 τ e.2 g)

end Full
end Bounty
