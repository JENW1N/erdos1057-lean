section

/- Power-saving centered Fourier reduction on the exact common integer support. -/

open Finset MeasureTheory Filter

namespace Bounty

theorem eventually_common_centered_fourier_of_mellin {b : ℝ} (hb : 0 < b)
    (A B : ℝ) :
    ∃ D : ℝ, A < D ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (Y H c : ℝ) (f : ℤ → ℂ),
      Real.exp (b*L) ≤ Y → Real.log Y ≤ 6*L →
      1 ≤ H → H ≤ Real.exp ((b/2)*L) →
      (∑ n ∈ harmonicCommonSupport Y, ‖f n‖^2) ≤ Y*L^B →
      (∫ t in {t : ℝ | |t| ≤ L*Y/H},
        ‖localMellinPolynomial ((harmonicCommonSupport Y).image Int.natAbs)
          (fun n => f n*fourier (n:ℤ) (c:AddCircle (1:ℝ))) t‖^2) ≤ Y^2*L^(-D) →
      (∫ x in Set.Icc (c-1/H) (c+1/H),
        ‖finiteFourierSum (harmonicCommonSupport Y) f x‖^2) ≤ Y*L^(-A) := by
  obtain ⟨D,hD,hred⟩ := eventually_local_fourier_of_mellin hb (by norm_num : (0:ℝ)≤64) A B
  refine ⟨D,hD,?_⟩
  filter_upwards [hred,eventually_harmonic_common_cutoff_geometry,
    eventually_ge_atTop (1:ℝ)] with L hred hcut hL
  intro Y H c f hY hlog hH hHu hE hM
  have hYp : 0 < Y := (Real.exp_pos _).trans_le hY
  have hY1 : 1 ≤ Y := (Real.one_le_exp (by positivity : 0 ≤ b*L)).trans hY
  have hHp : 0 < H := lt_of_lt_of_le zero_lt_one hH
  have hpos : ∀ n ∈ harmonicCommonSupport Y, 0 ≤ n :=
    fun n hn => (harmonic_common_support_positive hYp hn).le
  obtain ⟨hN,hlogN⟩ := hcut Y hY1 hlog
  have hSN : ∀ n ∈ (harmonicCommonSupport Y).image Int.natAbs,
      n ≤ ⌈4*Real.exp 2*Y⌉₊ :=
    fun n hn => (harmonic_common_natural_support_bound hYp hn).2
  have hS : ∀ n ∈ (harmonicCommonSupport Y).image Int.natAbs,
      Y/8 ≤ (n:ℝ) ∧ (n:ℝ) ≤ 64*Y := by
    intro n hn
    exact ⟨((mem_harmonic_common_natural_support hYp).mp hn).1,
      (Nat.cast_le.mpr (hSN n hn)).trans hN⟩
  rw [finite_fourier_centered_energy (harmonicCommonSupport Y) f hpos c H hHp]
  apply hred Y H ((harmonicCommonSupport Y).image Int.natAbs)
    (fun n => f n*fourier (n:ℤ) (c:AddCircle (1:ℝ))) ⌈4*Real.exp 2*Y⌉₊
    hY hH hHu hS hSN hN hlogN _ hM
  rw [finite_fourier_modulated_energy (harmonicCommonSupport Y) f hpos c]
  exact hE

end Bounty
end

section

/- Squared Schwartz tails absorb fixed polynomial mean-square costs at a fixed radius exponent. -/

open Filter MeasureTheory Real
namespace Bounty

theorem eventually_schwartz_squared_tail_polynomial (f : SchwartzMap ℝ ℂ)
    {r : ℝ} (hr : 0 < r) (K E F : ℝ) (hK : 0 ≤ K) :
    ∀ᶠ L : ℝ in atTop,
      (∫ u in {u : ℝ | L^r < ‖u‖}, ‖f u‖)^2 * (K*L^E) ≤ L^(-F) := by
  filter_upwards [eventually_schwartz_tail_polynomial f hr 1 0 0 (by norm_num),
    eventually_schwartz_tail_polynomial f hr K E F hK,
    eventually_gt_atTop (0 : ℝ)] with L hsmall hdecay hL
  have ht0 : 0 ≤ ∫ u in {u : ℝ | L^r < ‖u‖}, ‖f u‖ :=
    integral_nonneg (fun _ => norm_nonneg _)
  have ht1 : (∫ u in {u : ℝ | L^r < ‖u‖}, ‖f u‖) ≤ 1 := by
    simpa only [rpow_zero, neg_zero, one_mul, mul_one] using hsmall
  calc
    _ ≤ (∫ u in {u : ℝ | L^r < ‖u‖}, ‖f u‖) * (K*L^E) :=
      mul_le_mul_of_nonneg_right (by nlinarith only [ht0,ht1])
        (mul_nonneg hK (rpow_nonneg hL.le E))
    _ ≤ L^(-F) := by simpa only [mul_assoc] using hdecay

end Bounty
end

section

/- A fixed polynomial factor fits inside any positive linear exponential. -/

open Filter
namespace Bounty

theorem eventually_rpow_le_exp_linear (K : ℝ) {ε : ℝ} (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, L^K ≤ Real.exp (ε*L) := by
  filter_upwards [eventually_scaled_log_sublinear (A := max K 0)
    (le_max_right _ _) (s := 0) (by norm_num) hε,
    eventually_ge_atTop (1 : ℝ)] with L hscale hL
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  simp only [Real.rpow_zero, mul_one] at hscale
  rw [Real.rpow_def_of_pos hL0]
  apply Real.exp_le_exp.mpr
  calc
    Real.log L*K = K*Real.log L := mul_comm _ _
    _ ≤ max K 0*Real.log L :=
      mul_le_mul_of_nonneg_right (le_max_left _ _) (Real.log_nonneg hL)
    _ ≤ ε*L := hscale

end Bounty
end

section

/- Energy and retained-box geometry for the exact original common cutoff. -/

open Finset Filter MeasureTheory
namespace Bounty

theorem eventually_harmonic_four_dyadic_energy {Ω : Type*} [MeasurableSpace Ω] :
    ∀ᶠ L : ℝ in atTop, ∀ (μ : Measure Ω) (Y : ℝ), 1 ≤ Y → Real.log Y ≤ 6*L →
      ∀ (δ α β γ : ℕ → ℂ) (phase : Ω → ℕ → ℂ) (E : ℝ), 0 ≤ E →
      let S := (harmonicCommonSupport Y).image Int.natAbs
      let N := ⌈4*Real.exp 2*Y⌉₊
      let F := fun s (n : ℕ) => (harmonicCommonCutoff ((n : ℝ)/Y) : ℂ) / (n : ℂ) * phase s n
      (∀ i ∈ dyadicNatIndices (Icc 1 N), ∀ j ∈ dyadicNatIndices (Icc 1 N),
        ∀ k ∈ dyadicNatIndices (Icc 1 N), ∀ l ∈ dyadicNatIndices (Icc 1 N),
        retainedFourDyadicBox S N i j k l →
        Integrable (fun s => ‖fourDyadicBoxSum N δ α β γ (F s) i j k l‖ ^ 2) μ) →
      (∀ i ∈ dyadicNatIndices (Icc 1 N), ∀ j ∈ dyadicNatIndices (Icc 1 N),
        ∀ k ∈ dyadicNatIndices (Icc 1 N), ∀ l ∈ dyadicNatIndices (Icc 1 N),
        retainedFourDyadicBox S N i j k l →
        (∫ s, ‖fourDyadicBoxSum N δ α β γ (F s) i j k l‖ ^ 2 ∂μ) ≤ E) →
      (∫ s, ‖∑ n ∈ S, endpointFourConvolution δ α β γ n * F s n‖ ^ 2 ∂μ) ≤ L ^ 9 * E := by
  filter_upwards [eventually_dyadic_eighth_card_le 64,
    eventually_harmonic_common_cutoff_geometry] with L hcard hgeom
  intro μ Y hY hlog δ α β γ phase E hE0 S N F hf hE
  have hY0 : 0 < Y := by linarith
  have hS : ∀ n ∈ S, n ≤ N := fun n hn =>
    (harmonic_common_natural_support_bound hY0 hn).2
  have hF : ∀ s n, n ∉ S → F s n = 0 := by
    intro s n hn
    dsimp only [F]
    rw [harmonic_common_cutoff_zero_outside_natural hY0 hn, Complex.ofReal_zero, zero_div, zero_mul]
  exact (endpoint_four_dyadic_energy μ S N hS δ α β γ F hF E hE0 hf hE).trans
    (mul_le_mul_of_nonneg_right (hcard N (hgeom Y hY hlog).2) hE0)

theorem retained_harmonic_four_dyadic_scale {Y : ℝ} (hY : 0 < Y)
    {N i j k l : ℕ}
    (hbox : retainedFourDyadicBox ((harmonicCommonSupport Y).image Int.natAbs) N i j k l) :
    let X := (2 : ℝ)^i * 2^j * 2^k * 2^l
    Y/128 ≤ X ∧ X ≤ 4*Real.exp 2*Y := by
  have hp : ∀ n ∈ Icc 1 N, 0 < n := fun n hn => (mem_Icc.mp hn).1
  have h := retained_four_dyadic_scale _ (Icc 1 N) (Icc 1 N) (Icc 1 N) (Icc 1 N)
    hp hp hp hp (fun n hn => (mem_harmonic_common_natural_support hY).mp hn) hbox
  dsimp only at h ⊢
  constructor <;> linarith [h.1, h.2]

theorem retained_harmonic_four_dyadic_product_bounds {Y : ℝ} (hY : 0 < Y)
    {N i j k l d a b c : ℕ}
    (hbox : retainedFourDyadicBox ((harmonicCommonSupport Y).image Int.natAbs) N i j k l)
    (hd : d ∈ dyadicNatBucket (Icc 1 N) i) (ha : a ∈ dyadicNatBucket (Icc 1 N) j)
    (hb : b ∈ dyadicNatBucket (Icc 1 N) k) (hc : c ∈ dyadicNatBucket (Icc 1 N) l) :
    Y/128 ≤ ((d*a*b*c : ℕ) : ℝ) ∧ ((d*a*b*c : ℕ) : ℝ) ≤ 64*Real.exp 2*Y := by
  have hp : ∀ n ∈ Icc 1 N, 0 < n := fun n hn => (mem_Icc.mp hn).1
  have h := retained_four_dyadic_product_bounds _ (Icc 1 N) (Icc 1 N) (Icc 1 N) (Icc 1 N)
    hp hp hp hp (fun n hn => (mem_harmonic_common_natural_support hY).mp hn) hbox hd ha hb hc
  constructor <;> linarith [h.1, h.2]

end Bounty
end

