section ResiduePath
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (ζ : ∀ p : PhysicalPrime P, ZMod p.2.val)
  (hmarks : ∀ j : Fin (n + 1), ∀ p ∈ physicalMarkedPrimes (L j),
    ζ p = -(a j : ZMod p.2.val))
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ) (η : Fin N → Fin (n + 1) → ℝ)
  (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0) (B : ℕ)

theorem physical_joint_residue_edge_bounded_events (j : Fin n)
    (H : (g : Fin N) → Finset ↥(P g))
    (q : (g : Fin N) → BoundedOrderedTuple
      (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B)
    (F : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ) :
    let np := fun g (p : ↥(P g)) => p.val
    let d : ℤ := physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j)
    let Δ := fun _ : Fin N => -k j * d
    let D := fun _ : Fin N => d
    let t := fun g => ell + (C j g).card
    let source := fun g => physicalGroupUnsharedEmbedding (C j)
      (physicalPermuteLabels (σ j) (L j.castSucc)) g
    let target := fun g => physicalGroupUnsharedEmbedding (C j)
      (physicalPermuteLabels (τ j) (L j.succ)) g
    globalBirthJointCutRawRow
      (physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β η V (fun _ => ρ) hV B
        (2 * j.val + 1)) B B F (fun g => (H g, boundedOrderedTupleToFinite (q g))) =
    ∑ e : UnrestrictedJointEvent np Δ D t B (fun g => (source g, q g)),
      (unrestrictedJointCutoffEventWeight np Δ D (fun g p => β g p / V g) ρ V t B
        (fun g => (source g, q g)) e : ℂ) *
      boundedEdgeJointPhase np Δ D t B source target H q e *
        F (boundedEdgeJointRawTarget np Δ D t B source H q e) := by
  dsimp only
  apply global_birth_joint_cut_edge_events_of_rows
  intro g K
  exact physical_group_residue_finite_edge_bounded_events C aux k L a σ τ hstep ζ hmarks
    hlist hP hdis g (fun j => hk j g) (β g) (η g) (V g) ρ (hV g) B j
    (H g) (q g) (fun H' q' => K (H', q'))

end ResiduePath
end

section
open Finset Filter
open scoped Topology
theorem eventually_totient_sieve_noncoprime_mass_le :
    ∀ᶠ L : ℝ in atTop, ∀ N n : ℕ, (N : ℝ) ≤ Real.exp L → n ≠ 0 →
      (n : ℝ) ≤ 16 * Real.exp L → (∀ p ∈ n.primeFactors, L^20 ≤ (p : ℝ)) →
      (∑ d ∈ (Icc 1 N).filter (fun d => Squarefree d ∧ ¬ Nat.Coprime d n),
        1 / (Nat.totient d : ℝ)) ≤
          (16 * primeEulerProductUpperConstant) * L^(-18 : ℝ) := by
  filter_upwards [eventually_prime_factor_inverse_sum_le_four_rpow,
    eventually_ge_atTop (1 : ℝ), eventually_ge_atTop (Real.log 2)]
    with L hprime hL hlog2
  intro N n hN hn hsize hlarge
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hD : 1 ≤ Real.exp L := Real.one_le_exp hL0.le
  have hlog : Real.log (2 * Real.exp L) ≤ 2 * L := by
    rw [Real.log_mul (by norm_num) (Real.exp_ne_zero L), Real.log_exp]
    linarith
  have hS : 0 ≤ ∑ p ∈ n.primeFactors, 1 / ((p : ℝ) - 1) := by
    apply sum_nonneg
    intro p hp
    have hp1 : (1 : ℝ) ≤ p := by exact_mod_cast (Nat.prime_of_mem_primeFactors hp).one_le
    positivity
  have hconst : 0 ≤ 2 * primeEulerProductUpperConstant :=
    mul_nonneg (by norm_num) primeEulerProductUpperConstant_pos.le
  have hid : L^(-19 : ℝ) * L = L^(-18 : ℝ) := by
    calc
      _ = L^(-19 : ℝ) * L^(1 : ℝ) := by rw [Real.rpow_one]
      _ = L^((-19 : ℝ) + 1) := (Real.rpow_add hL0 _ _).symm
      _ = _ := by norm_num
  calc
    _ ≤ (∑ p ∈ n.primeFactors, 1 / ((p : ℝ) - 1)) *
        ((2 * primeEulerProductUpperConstant) * Real.log (2 * Real.exp L)) :=
      totient_sieve_noncoprime_mass_le_log N n hn hD hN
    _ ≤ (4 * L^(-19 : ℝ)) * ((2 * primeEulerProductUpperConstant) * (2 * L)) := by
      apply mul_le_mul (hprime n hn hsize hlarge)
        (mul_le_mul_of_nonneg_left hlog hconst)
      · exact mul_nonneg hconst (Real.log_nonneg (by linarith [Real.exp_pos L]))
      · positivity
    _ = (16 * primeEulerProductUpperConstant) * (L^(-19 : ℝ) * L) := by ring
    _ = _ := by rw [hid]
end

