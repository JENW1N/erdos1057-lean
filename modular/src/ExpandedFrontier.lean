/- The actual physical fixed-forest sum is the integral of its complete signed row composition. -/

open Finset Classical MeasureTheory
namespace Bounty

theorem physical_forest_path_sum_eq_fourier_rows
    {Ghost Edge : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    [∀ g, ∀ p : ↥(P g), NeZero p.val]
    (C : Edge → Fin N → Finset (Fin J)) (k : Edge → ℤ)
    (ω : ∀ a, SharedActiveLabels (fun g => ↥(P g))
      (fun g => physicalFullSharedIndices (ell := ell) (C a g)) → PhysicalAuxLabels P (C a) → ℝ)
    (μ : (g : Fin N) → ↥(P g) → ℝ) (q : Ghost → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (Θ : ∀ a, ((g : Fin N) → Fin (J + ell) → ↥(P g)) →
      ((g : Fin N) → Fin (J + ell) → ↥(P g)) → PhysicalAuxLabels P (C a) → ℂ)
    (steps : List (Option (Ghost ⊕ Edge)))
    (initial : (g : Fin N) → Finset ↥(P g))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress
      (fun a g => physicalFullSharedIndices (ell := ell) (C a g)) B steps)))
    (encode : ((g : Fin N) × ↥(P g)) → ℤ)
    (cut : Fin N → Finset (Fin J)) (terminalLedger : (g : Fin N) → Finset ↥(P g))
    (x : PhysicalFullBoundedState P J ell B) :
    let sizes := fun g (p : ↥(P g)) => p.val
    let shared := fun a g => physicalFullSharedIndices (ell := ell) (C a g)
    let aux := fun a (_ : SharedActiveLabels (fun g => ↥(P g)) (shared a)) => PhysicalAuxLabels P (C a)
    let delta := fun a => physicalFullEdgeDelta (C a) (k a)
    let displacement := fun a => physicalFullEdgeD (C a)
    let phase := fun a H s e => physicalFullGlobalEdgePhase (C a) (k a) H (ω a) μ ρ V s e *
      physicalFullActiveFactor (C a) (k a) (Θ a) s e
    let terminal := fun s : PhysicalFullBoundedState P J ell B =>
      physicalRecordedTerminalExtension cut physicalEmptyMemoryTerminal (terminalLedger, s)
    let _ : ∀ (tag : Option (Ghost ⊕ Edge)) s,
      Fintype (FullPermutationMixedEvent sizes shared B aux delta displacement tag s) :=
      fullPermutationMixedEventFintype sizes shared B aux delta displacement
    let _ := finiteEventPathFintype (FullPermutationMixedEvent sizes shared B aux delta displacement)
      (fullPermutationMixedEventTarget sizes shared B aux delta displacement) steps x
    birthForestPathSum (univ : Finset (FullPermutationMixedPath sizes shared B aux delta displacement steps x))
      (fun p => terminal (finiteEventPathTerminal
          (FullPermutationMixedEvent sizes shared B aux delta displacement)
          (fullPermutationMixedEventTarget sizes shared B aux delta displacement) steps x p) *
        fullMixedResidualPathWeight sizes shared B aux delta displacement phase ω μ q ρ V
          steps (fun _ => initial) x p)
      (fullMixedIndexedBirthPerformed sizes shared B aux delta displacement steps x)
      (fullMixedIndexedBirthValue sizes shared B aux delta displacement steps encode x) code =
      ∫ θ, finiteOperatorListAction
        (fullMixedForestStageRow sizes shared B aux delta displacement ω μ q ρ V steps
          (fullMixedBirthResidualPhase sizes shared B aux delta displacement phase) initial code θ encode)
        (List.finRange steps.length) terminal x
        ∂birthFourierCubeMeasure (Fin (Fintype.card (FullMixedBirthAddress shared B steps)) ×
          Fin (Fintype.card (FullMixedBirthAddress shared B steps))) := by
  dsimp only
  exact full_mixed_forest_path_sum_eq_fourier_rows
    (fun g (p : ↥(P g)) => p.val)
    (fun a g => physicalFullSharedIndices (ell := ell) (C a g)) B
    (fun a _ => PhysicalAuxLabels P (C a))
    (fun a => physicalFullEdgeDelta (C a) (k a)) (fun a => physicalFullEdgeD (C a))
    (fun a H s e => physicalFullGlobalEdgePhase (C a) (k a) H (ω a) μ ρ V s e *
      physicalFullActiveFactor (C a) (k a) (Θ a) s e)
    ω μ q ρ V steps initial code encode
    (fun s => physicalRecordedTerminalExtension cut physicalEmptyMemoryTerminal (terminalLedger, s)) x

end Bounty
