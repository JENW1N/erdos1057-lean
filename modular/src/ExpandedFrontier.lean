theorem full_mixed_ghost_history_sample_label (i : CoupledGhostSampleIndex M B s sk) :
    fullMixedBirthHistoryWrite n S B A Δ D steps u s
      (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inl j)) htag s ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩)) history (fullMixedGhostOwnerSampleEmbedding S B j steps u htag s sk i) = some ⟨i.1, (births i).1⟩ := by
  have h := full_mixed_tagged_history_write_here n S B A Δ D steps u (some (.inl j)) htag s
    ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩) history
    (fullMixedBirthCoordinateEquiv n S B A Δ D (some (.inl j)) s ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩) i).val
