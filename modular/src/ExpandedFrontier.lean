section

/- Quantitative decay survives every finite iteration of the vdC recurrence. -/

namespace Bounty

theorem van_der_corput_scalar_le_roots (H B C η : ℝ) (m : ℕ)
    (hη : 0 ≤ η) (hη1 : η ≤ 1) (hC : 1 ≤ C)
    (hH : 2/H ≤ C*η) (hB : B ≤ C*η) :
    vanDerCorputScalarBound H B m ≤ 5^m*C*repeatedSquareRoot m η := by
  induction m with
  | zero => simpa only [vanDerCorputScalarBound,repeatedSquareRoot,pow_zero,one_mul] using hB
  | succ m ih =>
    have hr := repeated_square_root_nonneg m hη
    have hηr := le_repeated_square_root m hη1
    have hp : (1 : ℝ) ≤ 5^m := one_le_pow₀ (by norm_num)
    have hc : 1 ≤ 5^m*C := by nlinarith
    have hCm : C ≤ 5^m*C := by nlinarith
    have hCη : C*η ≤ C*repeatedSquareRoot m η := mul_le_mul_of_nonneg_left hηr (by linarith)
    have hCr := mul_le_mul_of_nonneg_right hCm hr
    have hsum : 2/H+4*vanDerCorputScalarBound H B m ≤
        (5*(5^m*C))*repeatedSquareRoot m η := by nlinarith
    have hcoef : 5*(5^m*C) ≤ (5*(5^m*C))^2 := by nlinarith
    have hmul := mul_le_mul_of_nonneg_right hcoef hr
    have hsqrt := Real.sq_sqrt hr
    change Real.sqrt (2/H+4*vanDerCorputScalarBound H B m) ≤ _
    apply Real.sqrt_le_iff.mpr
    constructor
    · change 0 ≤ 5^(m+1)*C*Real.sqrt (repeatedSquareRoot m η)
      positivity
    · change 2/H+4*vanDerCorputScalarBound H B m ≤
        (5^(m+1)*C*Real.sqrt (repeatedSquareRoot m η))^2
      calc
        _ ≤ (5*(5^m*C))^2*repeatedSquareRoot m η := hsum.trans hmul
        _ = _ := by
          have hpow : 5^(m+1)*C = 5*(5^m*C) := by rw [pow_succ]; ring
          rw [hpow]
          symm
          rw [mul_pow,hsqrt]

theorem van_der_corput_scalar_le_rpow (H B C η : ℝ) (m : ℕ)
    (hη : 0 ≤ η) (hη1 : η ≤ 1) (hC : 1 ≤ C)
    (hH : 2/H ≤ C*η) (hB : B ≤ C*η) :
    vanDerCorputScalarBound H B m ≤ 5^m*C*η^((2:ℝ)^m)⁻¹ := by
  simpa only [repeated_square_root_eq_rpow m hη] using
    van_der_corput_scalar_le_roots H B C η m hη hη1 hC hH hB

end Bounty
end

section

/- A scale lower bound bounds the number of derivative orders needed. -/

namespace Bounty

theorem long_frequency_upper_power (K : ℕ) (x N τ ε : ℝ)
    (hx : 1 ≤ x) (hτ : 0 < τ) (hε : ε ≤ 1)
    (hscale : x^(τ/2) ≤ N) (hK : 4/τ+1 ≤ (K : ℝ)) :
    x^2 ≤ N^((K : ℝ)-ε) := by
  have hxp : 0 < x := lt_of_lt_of_le (by norm_num) hx
  have hquot : 0 < 4/τ := div_pos (by norm_num) hτ
  have hexp : 0 ≤ (K : ℝ)-ε := by linarith
  have hmul : 4 ≤ ((K : ℝ)-1)*τ := (div_le_iff₀ hτ).mp (by linarith)
  have he : 2 ≤ (τ/2)*((K : ℝ)-ε) := by nlinarith
  calc
    x^2 = x^(2 : ℝ) := by norm_num
    _ ≤ x^((τ/2)*((K : ℝ)-ε)) := Real.rpow_le_rpow_of_exponent_le hx he
    _ = (x^(τ/2))^((K : ℝ)-ε) := Real.rpow_mul hxp.le _ _
    _ ≤ N^((K : ℝ)-ε) := Real.rpow_le_rpow (Real.rpow_nonneg hxp.le _) hscale hexp

theorem exists_derivative_order_long_frequency (K : ℕ) (x N u τ ε : ℝ)
    (hx : 1 ≤ x) (hN : 1 < N) (hτ : 0 < τ) (hε : 0 < ε) (hεhalf : ε ≤ 1/2)
    (hscale : x^(τ/2) ≤ N) (hK : 4/τ+1 ≤ (K : ℝ))
    (hu : N ≤ u) (hux : u ≤ x^2) :
    ∃ k : ℕ, 2 ≤ k ∧ k ≤ K ∧ N^((k : ℝ)-2+ε) ≤ u ∧ u ≤ N^((k : ℝ)-ε) := by
  apply exists_derivative_order_power_band K N u ε hN hε hεhalf hu
  exact hux.trans (long_frequency_upper_power K x N τ ε hx hτ (by linarith) hscale hK)

end Bounty
end

section

/- A fixed indicator convention for transporting the shared bad-event weight. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def cleanAuxiliaryBadWeight {A P : Type*} [Fintype A] [DecidableEq A]
    (μ : P → ℝ) (T : Finset P) (s : A → P) : ℝ :=
  cleanAuxiliaryWeight μ s *
    (if (∃ a, s a ∈ T) ∨ ¬Function.Injective s then 1 else 0)

theorem clean_auxiliary_bad_weight_le {A P : Type*}
    [Fintype A] [DecidableEq A] [Fintype P]
    (μ : P → ℝ) (hμ0 : ∀ p, 0 ≤ μ p) (hμ : ∑ p, μ p = 1)
    (T : Finset P) (a₀ : ℝ) (ha₀ : 0 ≤ a₀) (hatom : ∀ p, μ p ≤ a₀) :
    (∑ s : A → P, cleanAuxiliaryBadWeight μ T s) ≤
      (Fintype.card A : ℝ) * (T.card + Fintype.card A) * a₀ := by
  exact clean_auxiliary_forbidden_or_repeated_mass_le μ hμ0 hμ T a₀ ha₀ hatom

end Bounty
end

section

/- Shared draws avoid endpoint prime divisors, free labels, and one another with
an explicit reciprocal-prime probability bound. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def physicalSharedForbidden {G : Type*} {P : G → Finset ℕ} {J : ℕ}
    (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C) (g : G) (w z : ℕ) : Finset (P g) :=
  univ.filter (fun p => p.val ∈ w.primeFactors ∪ z.primeFactors ∨ ∃ j, aux g j = p)

theorem physical_shared_forbidden_card {G : Type*} {P : G → Finset ℕ} {J : ℕ}
    (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C) (g : G) (w z : ℕ) :
    (physicalSharedForbidden C aux g w z).card ≤
      w.primeFactors.card + z.primeFactors.card + (C g).card := by
  have he : (physicalSharedForbidden C aux g w z).image Subtype.val ⊆
      (w.primeFactors ∪ z.primeFactors) ∪ univ.image (fun j : C g => (aux g j).val) := by
    intro p hp
    obtain ⟨a, ha, rfl⟩ := mem_image.mp hp
    rcases (mem_filter.mp ha).2 with h | ⟨j, hj⟩
    · exact mem_union_left _ h
    · exact mem_union_right _ (mem_image.mpr ⟨j, mem_univ _, congrArg Subtype.val hj⟩)
  calc
    _ = ((physicalSharedForbidden C aux g w z).image Subtype.val).card :=
      (card_image_of_injective _ Subtype.val_injective).symm
    _ ≤ ((w.primeFactors ∪ z.primeFactors) ∪ univ.image (fun j : C g => (aux g j).val)).card :=
      card_le_card he
    _ ≤ (w.primeFactors ∪ z.primeFactors).card +
        (univ.image (fun j : C g => (aux g j).val)).card := card_union_le _ _
    _ ≤ _ := add_le_add (card_union_le _ _) ((card_image_le).trans_eq (by simp))

theorem physical_shared_forbidden_log_card {G : Type*} {P : G → Finset ℕ} {J : ℕ}
    (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C) (g : G)
    {w z : ℕ} (hw : 0 < w) (hz : 0 < z) :
    ((physicalSharedForbidden C aux g w z).card : ℝ) ≤
      Real.log w / Real.log 2 + Real.log z / Real.log 2 + (C g).card := by
  calc
    _ ≤ (w.primeFactors.card : ℝ) + z.primeFactors.card + (C g).card := by
      exact_mod_cast physical_shared_forbidden_card C aux g w z
    _ ≤ _ := add_le_add (add_le_add (primeFactors_card_le_log_div_log_two hw)
      (primeFactors_card_le_log_div_log_two hz)) le_rfl

theorem physical_mem_shared_forbidden_iff {G : Type*} {P : G → Finset ℕ} {J : ℕ}
    (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C) (g : G)
    (hprime : ∀ p ∈ P g, p.Prime) {w z : ℕ} (hw : 0 < w) (hz : 0 < z) (p : P g) :
    p ∈ physicalSharedForbidden C aux g w z ↔
      p.val ∣ w ∨ p.val ∣ z ∨ ∃ j, aux g j = p := by
  simp only [physicalSharedForbidden, mem_filter, mem_univ, true_and, mem_union]
  constructor
  · rintro ((h | h) | h)
    · exact Or.inl (Nat.dvd_of_mem_primeFactors h)
    · exact Or.inr (Or.inl (Nat.dvd_of_mem_primeFactors h))
    · exact Or.inr (Or.inr h)
  · rintro (h | h | h)
    · exact Or.inl (Or.inl ((hprime _ p.property).mem_primeFactors h (by omega)))
    · exact Or.inl (Or.inr ((hprime _ p.property).mem_primeFactors h (by omega)))
    · exact Or.inr h

end Bounty
end

section

/- Actual finite shift products and frequency ranges imply the terminal curvature powers. -/

namespace Bounty

theorem terminal_shift_product_bounds (hs : List ℝ) {N eps : ℝ} {k : ℕ}
    (hN : 1 ≤ N) (heps : 0 ≤ eps) (hk : 2 ≤ k) (hlen : hs.length = k-2)
    (hhs : ∀ h ∈ hs, 1 ≤ h ∧ h ≤ (⌊N^(eps/(2*(k : ℝ)))⌋₊ : ℝ)) :
    1 ≤ hs.prod ∧ hs.prod ≤ N^(eps/2) := by
  have hN0 : 0 < N := by linarith
  have hk0 : (k : ℝ) ≠ 0 := by exact_mod_cast (show k ≠ 0 by omega)
  have he : 0 ≤ eps/(2*(k : ℝ)) := by positivity
  have hbase : 1 ≤ N^(eps/(2*(k : ℝ))) := Real.one_le_rpow hN he
  have hfloor : (⌊N^(eps/(2*(k : ℝ)))⌋₊ : ℝ) ≤ N^(eps/(2*(k : ℝ))) :=
    Nat.floor_le (by positivity)
  refine ⟨List.one_le_prod (fun h hh => (hhs h hh).1),?_⟩
  have hp : hs.prod ≤ (N^(eps/(2*(k : ℝ))))^hs.length := by
    have h := List.prod_map_le_prod_map₀ (s := hs)
      (fun x : ℝ => x) (fun _ : ℝ => N^(eps/(2*(k : ℝ))))
      (fun h hh => (show 0 ≤ h by linarith [(hhs h hh).1]))
      (fun h hh => ((hhs h hh).2).trans hfloor)
    simpa only [List.map_id',List.map_const',List.prod_replicate] using h
  calc
    hs.prod ≤ (N^(eps/(2*(k : ℝ))))^hs.length := hp
    _ ≤ (N^(eps/(2*(k : ℝ))))^k := pow_le_pow_right₀ hbase (by omega)
    _ = N^(eps/2) := by
      rw [← Real.rpow_mul_natCast hN0.le]
      congr 1
      field_simp

theorem scaled_curvature_power_bounds {N eps K P T : ℝ} {k : ℕ}
    (hN : 1 ≤ N) (hK : 0 ≤ K) (hPlo : 1 ≤ P) (hPhi : P ≤ N^(eps/2))
    (hTlo : N^((k : ℝ)-2+eps) ≤ T) (hThi : T ≤ N^((k : ℝ)-eps)) :
    K*N^(-2+eps) ≤ K*P*T/N^k ∧ K*P*T/N^k ≤ K*N^(-eps/2) := by
  have hN0 : 0 < N := by linarith
  have hT0 : 0 ≤ T := (Real.rpow_pos_of_pos hN0 _).le.trans hTlo
  have hp : N^((k : ℝ)-2+eps) ≤ P*T := by
    have h := mul_le_mul_of_nonneg_right hPlo hT0
    simp only [one_mul] at h
    exact hTlo.trans h
  have hq : P*T ≤ N^((k : ℝ)-eps/2) := by
    have h := mul_le_mul hPhi hThi hT0 (Real.rpow_nonneg hN0.le _)
    rw [← Real.rpow_add hN0] at h
    have he : eps/2+((k : ℝ)-eps) = (k : ℝ)-eps/2 := by ring
    rwa [he] at h
  have hquot (x : ℝ) : N^x/N^k = N^(x-(k : ℝ)) := by
    rw [Real.rpow_sub hN0,Real.rpow_natCast]
  constructor
  · calc
      K*N^(-2+eps) = K*N^((k : ℝ)-2+eps)/N^k := by
        rw [mul_div_assoc,hquot]
        congr 1
        congr 1
        ring
      _ ≤ K*(P*T)/N^k := div_le_div_of_nonneg_right
        (mul_le_mul_of_nonneg_left hp hK) (by positivity)
      _ = _ := by ring
  · calc
      K*P*T/N^k ≤ K*N^((k : ℝ)-eps/2)/N^k := div_le_div_of_nonneg_right
        (by simpa only [mul_assoc] using mul_le_mul_of_nonneg_left hq hK) (by positivity)
      _ = K*N^(-eps/2) := by
        rw [mul_div_assoc,hquot]
        congr 1
        congr 1
        ring

end Bounty
end

section

/- Literal progression sums transfer cancellation through a rough-integer divisor majorant. -/

open Finset

namespace Bounty

theorem rough_interval_oscillation_of_divisor_sums
    (a b : ℕ) (lam : ℕ → ℝ) (F : ℕ → ℂ) {z Y Q M E : ℝ}
    (hY : 0 ≤ Y) (hQ : 0 ≤ Q)
    (hpoint : ∀ n : ℕ, n ≠ 0 →
      (if ∀ p ∈ n.primeFactors, z < (p : ℝ) then (1 : ℝ) else 0) ≤
        ∑ d ∈ n.divisors, lam d)
    (hF : ∀ n ∈ Ioc a b, ‖F n‖ ≤ 1)
    (hover : (∑ n ∈ Ioc a b, ∑ d ∈ n.divisors, lam d)-
      (((Ioc a b).filter (fun n : ℕ => ∀ p ∈ n.primeFactors, z < (p : ℝ))).card : ℝ) ≤ E)
    (hmass : (∑ d ∈ Icc 1 b, |lam d|/(d : ℝ)) ≤ M)
    (hdiv : ∀ d ∈ Icc 1 b, lam d ≠ 0 →
      ‖∑ n ∈ (Ioc a b).filter (fun n => d ∣ n), F n‖ ≤ Y*Q/(d : ℝ)) :
    ‖∑ n ∈ (Ioc a b).filter (fun n : ℕ => ∀ p ∈ n.primeFactors, z < (p : ℝ)), F n‖ ≤
      E+Y*Q*M := by
  have hd := rough_divisor_majorant_complex_error lam a b F (by norm_num : (0 : ℝ) ≤ 1)
    hpoint hF hover
  rw [one_mul] at hd
  have hm := interval_divisor_sum_norm_bound a b (fun d => (lam d : ℂ)) F
    (fun d => Y*Q/(d : ℝ)) (by
      intro d hd hne
      apply hdiv d hd
      intro hz
      exact hne (by simp [hz]))
  have hcoeff : (∑ d ∈ Icc 1 b, ‖(lam d : ℂ)‖*(Y*Q/(d : ℝ))) ≤ Y*Q*M := by
    calc
      _ = Y*Q*(∑ d ∈ Icc 1 b, |lam d|/(d : ℝ)) := by
        rw [mul_sum]
        apply sum_congr rfl
        intro d hd
        rw [Complex.norm_real,Real.norm_eq_abs]
        ring
      _ ≤ _ := mul_le_mul_of_nonneg_left hmass (mul_nonneg hY hQ)
  have hm' : ‖∑ n ∈ Ioc a b, ((∑ d ∈ n.divisors, lam d : ℝ) : ℂ)*F n‖ ≤ Y*Q*M := by
    push_cast
    exact hm.trans hcoeff
  have ht := norm_sub_norm_le
    (∑ n ∈ (Ioc a b).filter (fun n : ℕ => ∀ p ∈ n.primeFactors, z < (p : ℝ)), F n)
    (∑ n ∈ Ioc a b, ((∑ d ∈ n.divisors, lam d : ℝ) : ℂ)*F n)
  linarith

end Bounty
end

section

/- Quotients by a pool-free divisor commute with removal of the pool part. -/

namespace Bounty

theorem primePoolFreePart_div_of_free (P : Finset ℕ) {d n : ℕ}
    (hn : n ≠ 0) (hd : d ∣ n) (hfree : Disjoint d.primeFactors P) :
    primePoolFreePart P (n / d) = primePoolFreePart P n / d := by
  have he : d * (n / d) = n := Nat.mul_div_cancel' hd
  have hd0 : d ≠ 0 := by intro h; apply hn; rw [← he, h, zero_mul]
  have hq0 : n / d ≠ 0 := by intro h; apply hn; rw [← he, h, mul_zero]
  have hf := congrArg (primePoolFreePart P) he
  rw [primePoolFreePart_mul P hd0 hq0,
    primePoolFreePart_eq_self_of_disjoint P hd0 hfree] at hf
  rw [← hf]
  exact (Nat.mul_div_cancel_left _ (Nat.pos_of_ne_zero hd0)).symm

theorem invariant_pool_free_divisor_weight (P : Finset ℕ) (W : ℕ → ℂ)
    (hW : ∀ a b : ℕ, b ≠ 0 → Disjoint b.primeFactors P → W (a * b) = W a)
    {d n : ℕ} (hn : n ≠ 0) (hd : d ∣ n) (hfree : Disjoint d.primeFactors P) :
    W n = W (n / d) := by
  have hd0 : d ≠ 0 := by
    intro h
    rw [h] at hd
    simp only [zero_dvd_iff] at hd
    exact hn hd
  simpa only [Nat.div_mul_cancel hd] using hW (n / d) d hd0 hfree

end Bounty
end

section

/- Assemble explicit analytic inputs with the ordered scalar saving budget. -/

open MeasureTheory Set

namespace Bounty

theorem three_regime_integral_decay (R : ℝ) (S Q M T : ℝ → ℂ)
    (hS : Continuous S) (hQ : Continuous Q) (hM : Continuous M) (hT : Continuous T)
    {L A Cmean Csparse s q t As H B B0 : ℝ} (hL : 4 ≤ L)
    (hAs : A + Cmean + 1 ≤ 2 * As)
    (hH : A + 2 * s + Csparse + 1 ≤ 2 * H)
    (hB : A + B0 + 2 * s + 2 * q + 2 * t + 1 ≤ 2 * B)
    (hSbound : ∀ u ∈ Icc (-R) R, ‖S u‖ ≤ L ^ s)
    (hQbound : ∀ u ∈ Icc (-R) R, ‖Q u‖ ≤ L ^ q)
    (hTbound : ∀ u ∈ Icc (-R) R, ‖T u‖ ≤ L ^ t)
    (hhigh : ∀ u ∈ Icc (-R) R, L ^ (-As) < ‖S u‖ →
      L ^ B0 < |u| → ‖Q u‖ ≤ L ^ (-H))
    (hlow : ∀ u ∈ Icc (-R) R, |u| ≤ L ^ B0 → ‖M u‖ ≤ L ^ (-B))
    (hmean : (∫ u in Icc (-R) R, ‖Q u * M u * T u‖ ^ 2) ≤ L ^ Cmean)
    (hsparse : (∫ u in {u ∈ Icc (-R) R | L ^ (-As) < ‖S u‖},
      ‖M u * T u‖ ^ 2) ≤ L ^ Csparse) :
    (∫ u in Icc (-R) R, ‖S u * Q u * M u * T u‖ ^ 2) ≤ L ^ (-A) := by
  have hL0 : 0 < L := by linarith
  have hn (z : ℝ) : 0 ≤ L ^ z := Real.rpow_nonneg hL0.le z
  calc
    _ ≤ (L ^ (-As)) ^ (2 : ℕ) * (∫ u in Icc (-R) R, ‖Q u * M u * T u‖ ^ 2) +
        (L ^ s) ^ (2 : ℕ) * (L ^ (-H)) ^ (2 : ℕ) *
          (∫ u in {u ∈ Icc (-R) R | L ^ (-As) < ‖S u‖}, ‖M u * T u‖ ^ 2) +
        2 * L ^ B0 * (L ^ s) ^ (2 : ℕ) * (L ^ q) ^ (2 : ℕ) *
          (L ^ (-B)) ^ (2 : ℕ) * (L ^ t) ^ (2 : ℕ) :=
      three_regime_integral_bound R (L ^ B0) (L ^ (-As)) (L ^ s) (L ^ q)
        (L ^ (-H)) (L ^ (-B)) (L ^ t) S Q M T hS hQ hM hT
        (hn _) (hn _) (hn _) (hn _) (hn _) (hn _) (hn _)
        hSbound hQbound hTbound hhigh hlow
    _ ≤ (L ^ (-As)) ^ (2 : ℕ) * L ^ Cmean +
        (L ^ s) ^ (2 : ℕ) * (L ^ (-H)) ^ (2 : ℕ) * L ^ Csparse +
        2 * L ^ B0 * (L ^ s) ^ (2 : ℕ) * (L ^ q) ^ (2 : ℕ) *
          (L ^ (-B)) ^ (2 : ℕ) * (L ^ t) ^ (2 : ℕ) := by
      gcongr
    _ ≤ _ := three_regime_power_budget hL hAs hH hB

end Bounty
end

section

/- A finite cover by unit intervals controls the integral over a measurable
exceptional set by the actual continuous squared-norm suprema. Overlap is
allowed; no disjointness or choice of sample points is required. -/

open Finset Set MeasureTheory
open scoped Classical

namespace Bounty

theorem unit_interval_energy_le_sup (F : ℝ → ℂ) (hF : Continuous F)
    (j : ℤ) {t : ℝ} (ht : t ∈ Icc (j : ℝ) ((j : ℝ) + 1)) :
    ‖F t‖ ^ 2 ≤ unitIntervalEnergySup F j := by
  apply le_csSup ((isCompact_Icc.image (hF.norm.pow 2)).bddAbove)
  exact mem_image_of_mem _ ht

theorem unit_interval_cover_energy (indices : Finset ℤ) (E : Set ℝ)
    (hE : MeasurableSet E) (F : ℝ → ℂ) (hF : Continuous F)
    (hcover : ∀ t ∈ E, ∃ j ∈ indices, t ∈ Icc (j : ℝ) ((j : ℝ) + 1)) :
    IntegrableOn (fun t => ‖F t‖ ^ 2) E ∧
      (∫ t in E, ‖F t‖ ^ 2) ≤ ∑ j ∈ indices, unitIntervalEnergySup F j := by
  let g (j : ℤ) : ℝ → ℝ :=
    (Icc (j : ℝ) ((j : ℝ) + 1)).indicator (fun _ => unitIntervalEnergySup F j)
  have hg0 (j : ℤ) (t : ℝ) : 0 ≤ g j t := by
    exact indicator_nonneg (fun _ _ => unit_interval_energy_sup_nonneg F hF j) t
  have hgi (j : ℤ) : Integrable (g j) := by
    apply (integrable_indicator_iff measurableSet_Icc).mpr
    exact integrableOn_const isCompact_Icc.measure_ne_top
  have hsum : Integrable (fun t => ∑ j ∈ indices, g j t) := by
    exact integrable_finsetSum indices (fun j _ => hgi j)
  have hdom (t : ℝ) : E.indicator (fun t => ‖F t‖ ^ 2) t ≤
      ∑ j ∈ indices, g j t := by
    by_cases ht : t ∈ E
    · rw [indicator_of_mem ht]
      obtain ⟨j, hj, htj⟩ := hcover t ht
      calc
        ‖F t‖ ^ 2 ≤ unitIntervalEnergySup F j := unit_interval_energy_le_sup F hF j htj
        _ = g j t := by simp only [g, indicator_of_mem htj]
        _ ≤ ∑ j ∈ indices, g j t := Finset.single_le_sum (fun k _ => hg0 k t) hj
    · rw [indicator_of_notMem ht]
      exact Finset.sum_nonneg (fun j _ => hg0 j t)
  have hfi : Integrable (E.indicator (fun t => ‖F t‖ ^ 2)) := by
    apply hsum.mono' ((hF.norm.pow 2).aestronglyMeasurable.indicator hE)
    apply Filter.Eventually.of_forall
    intro t
    change |E.indicator (fun t => ‖F t‖ ^ 2) t| ≤ _
    rw [abs_of_nonneg (indicator_nonneg (fun t _ => sq_nonneg ‖F t‖) t)]
    exact hdom t
  refine ⟨(integrable_indicator_iff hE).mp hfi, ?_⟩
  calc
    (∫ t in E, ‖F t‖ ^ 2) = ∫ t, E.indicator (fun t => ‖F t‖ ^ 2) t :=
      (integral_indicator hE).symm
    _ ≤ ∫ t, ∑ j ∈ indices, g j t := integral_mono hfi hsum hdom
    _ = ∑ j ∈ indices, ∫ t, g j t := integral_finsetSum indices (fun j _ => hgi j)
    _ = ∑ j ∈ indices, unitIntervalEnergySup F j := by
      apply Finset.sum_congr rfl
      intro j _
      simp only [g, integral_indicator_const _ measurableSet_Icc, Real.volume_real_Icc,
        add_sub_cancel_left, smul_eq_mul]
      norm_num

theorem exceptional_integral_le_unit_suprema (indices : Finset ℤ) (E : Set ℝ)
    (hE : MeasurableSet E) (F : ℝ → ℂ) (hF : Continuous F)
    (hcover : ∀ t ∈ E, ∃ j ∈ indices, t ∈ Icc (j : ℝ) ((j : ℝ) + 1)) :
    (∫ t in E, ‖F t‖ ^ 2) ≤ ∑ j ∈ indices, unitIntervalEnergySup F j :=
  (unit_interval_cover_energy indices E hE F hF hcover).2

end Bounty
end

section

/- Energy assembly for a finite dyadic decomposition, allowing overlaps. -/

open Finset Set MeasureTheory

namespace Bounty

theorem finite_sum_integral_norm_sq_le_card {ι : Type*} (s : Finset ι)
    (F : ι → ℝ → ℂ) (hF : ∀ j, Continuous (F j)) {E : Set ℝ} {R : ℝ}
    (hE : MeasurableSet E) (hER : E ⊆ Icc (-R) R) :
    (∫ t in E, ‖∑ j ∈ s, F j t‖ ^ 2) ≤
      (s.card : ℝ) * ∑ j ∈ s, ∫ t in E, ‖F j t‖ ^ 2 := by
  have hi (j : ι) : IntegrableOn (fun t => ‖F j t‖ ^ 2) E :=
    (((hF j).norm.pow 2).continuousOn.integrableOn_Icc).mono_set hER
  have hscont : Continuous (fun t => ‖∑ j ∈ s, F j t‖ ^ 2) := by fun_prop
  have hsi : IntegrableOn (fun t => ‖∑ j ∈ s, F j t‖ ^ 2) E :=
    hscont.continuousOn.integrableOn_Icc.mono_set hER
  have hr : IntegrableOn (fun t => (s.card : ℝ) * ∑ j ∈ s, ‖F j t‖ ^ 2) E :=
    (integrable_finsetSum s (fun j _ => hi j)).const_mul _
  calc
    _ ≤ ∫ t in E, (s.card : ℝ) * ∑ j ∈ s, ‖F j t‖ ^ 2 :=
      setIntegral_mono_on hsi hr hE (fun t _ => finite_complex_sum_norm_sq_le_card s (fun j => F j t))
    _ = _ := by rw [integral_const_mul, integral_finsetSum s (fun j _ => hi j)]

theorem finite_sum_integral_energy_power {ι : Type*} (s : Finset ι)
    (F : ι → ℝ → ℂ) (hF : ∀ j, Continuous (F j)) {E : Set ℝ} {R L C k : ℝ}
    (hE : MeasurableSet E) (hER : E ⊆ Icc (-R) R) (hL : 0 < L)
    (hcard : (s.card : ℝ) ≤ L ^ k)
    (henergy : ∀ j ∈ s, (∫ t in E, ‖F j t‖ ^ 2) ≤ L ^ C) :
    (∫ t in E, ‖∑ j ∈ s, F j t‖ ^ 2) ≤ L ^ (C + 2 * k) := by
  calc
    _ ≤ (s.card : ℝ) * ∑ j ∈ s, ∫ t in E, ‖F j t‖ ^ 2 :=
      finite_sum_integral_norm_sq_le_card s F hF hE hER
    _ ≤ (s.card : ℝ) * ∑ _j ∈ s, L ^ C :=
      mul_le_mul_of_nonneg_left (Finset.sum_le_sum henergy) (Nat.cast_nonneg _)
    _ = (s.card : ℝ) * ((s.card : ℝ) * L ^ C) := by simp
    _ ≤ L ^ k * (L ^ k * L ^ C) := by gcongr
    _ = L ^ (C + 2 * k) := by rw [← Real.rpow_add hL, ← Real.rpow_add hL]; congr 1; ring

end Bounty
end

section

/- Natural residue intervals embed exactly into integer progression intervals. -/

open Finset

namespace Bounty

theorem natural_residue_interval_cast (a b : ℕ) {q : ℕ} [NeZero q]
    (r : ZMod q) (F : ℤ → ℂ) :
    ∑ n ∈ (Ioc a b).filter (fun n : ℕ => (n : ZMod q) = r), F (n : ℤ) =
      ∑ z ∈ (Ioc (a : ℤ) (b : ℤ)).filter (fun z : ℤ => (z : ZMod q) = r), F z := by
  classical
  apply sum_bij (fun (n : ℕ) _ => (n : ℤ))
  · intro n hn
    obtain ⟨hn,hr⟩ := mem_filter.mp hn
    obtain ⟨hl,hu⟩ := mem_Ioc.mp hn
    exact mem_filter.mpr ⟨mem_Ioc.mpr ⟨by exact_mod_cast hl,by exact_mod_cast hu⟩,
      by simpa only [Int.cast_natCast] using hr⟩
  · intro n hn m hm he
    exact_mod_cast he
  · intro z hz
    obtain ⟨hz,hr⟩ := mem_filter.mp hz
    obtain ⟨hl,hu⟩ := mem_Ioc.mp hz
    have hz0 : 0 ≤ z := by omega
    have he : (z.toNat : ℤ) = z := Int.toNat_of_nonneg hz0
    refine ⟨z.toNat,mem_filter.mpr ⟨mem_Ioc.mpr ⟨by omega,by omega⟩,?_⟩,he⟩
    have hc := congrArg (fun t : ℤ => (t : ZMod q)) he
    simpa only [Int.cast_natCast] using hc.trans hr
  · intro n hn
    rfl

theorem natural_residue_interval_sum (a b : ℕ) {q : ℕ} [NeZero q]
    (r : ZMod q) (F : ℤ → ℂ) :
    ∑ n ∈ (Ioc a b).filter (fun n : ℕ => (n : ZMod q) = r), F (n : ℤ) =
      ∑ y ∈ Icc (((a : ℤ)-(r.val : ℤ))/(q : ℤ)+1) (((b : ℤ)-(r.val : ℤ))/(q : ℤ)),
        F (y*(q : ℤ)+r.val) := by
  rw [natural_residue_interval_cast,integer_residue_interval_sum]

end Bounty
end

section

/- The explicit sieve level leaves exponentially long progressions for polynomial moduli. -/

open Filter

namespace Bounty

theorem eventually_long_rough_sieve_scales {a : ℝ} (ha : 0 < a) (T N0 : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ Y q : ℝ, Real.exp (a*L) ≤ Y → 0 < q → q ≤ L^T →
      let Z := (Real.exp (Real.sqrt L))^(4*(roughCellSieveOrder L : ℝ)+2)
      N0 ≤ Y/(Z*q) ∧
      (Real.exp L)^(a/2) ≤ Y/(Z*q) ∧
      Z/Y ≤ Real.exp (-(a/2)*L) ∧
      Real.log (2*Real.exp (Real.sqrt L)) ≤ 2*L := by
  have hmod := eventually_exp_neg_rpow_mul_rpow_le
    (by norm_num : (0 : ℝ) < 1) (show 0 < a/4 by positivity) T 0
  have hthreshold := (Real.tendsto_exp_atTop.comp
    (tendsto_id.const_mul_atTop (half_pos ha))).eventually_ge_atTop N0
  filter_upwards [eventually_rough_cell_sieve_level_le (show 0 < a/2 by positivity),
    hmod,hthreshold,eventually_ge_atTop (1 : ℝ)] with L hlevel hmodL hthresholdL hL
  intro Y q hY hq hqT
  dsimp only
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hY0 : 0 < Y := (Real.exp_pos _).trans_le hY
  let Z := (Real.exp (Real.sqrt L))^(4*(roughCellSieveOrder L : ℝ)+2)
  have hZ0 : 0 < Z := by dsimp [Z]; positivity
  have hZ : Z ≤ Real.exp ((a/4)*L) := by
    have he : a/2/2 = a/4 := by ring
    simpa only [he] using hlevel
  have hmod' : L^T ≤ Real.exp ((a/4)*L) := by
    simp only [Real.rpow_one,neg_zero,Real.rpow_zero] at hmodL
    have hm := mul_le_mul_of_nonneg_left hmodL (Real.exp_pos ((a/4)*L)).le
    have he : Real.exp ((a/4)*L)*Real.exp (-(a/4)*L) = 1 := by
      rw [← Real.exp_add]
      have he' : (a/4)*L + -(a/4)*L = 0 := by ring
      rw [he',Real.exp_zero]
    simpa only [← mul_assoc,he,one_mul,mul_one] using hm
  have hprod : Z*q ≤ Real.exp ((a/2)*L) := by
    calc
      _ ≤ Real.exp ((a/4)*L)*Real.exp ((a/4)*L) :=
        mul_le_mul hZ (hqT.trans hmod') hq.le (Real.exp_pos _).le
      _ = _ := by rw [← Real.exp_add]; congr 1; ring
  have hN : Real.exp ((a/2)*L) ≤ Y/(Z*q) := by
    apply (le_div_iff₀ (mul_pos hZ0 hq)).mpr
    calc
      _ ≤ Real.exp ((a/2)*L)*Real.exp ((a/2)*L) :=
        mul_le_mul_of_nonneg_left hprod (Real.exp_pos _).le
      _ = Real.exp (a*L) := by rw [← Real.exp_add]; congr 1; ring
      _ ≤ Y := hY
  refine ⟨hthresholdL.trans hN,?_,?_,?_⟩
  · change (Real.exp L)^(a/2) ≤ Y/(Z*q)
    simpa only [← Real.exp_mul,mul_comm L] using hN
  · apply (div_le_iff₀ hY0).mpr
    calc
      Z ≤ Real.exp ((a/4)*L) := hZ
      _ ≤ Real.exp ((a/2)*L) := Real.exp_le_exp.mpr (by nlinarith)
      _ = Real.exp (-(a/2)*L)*Real.exp (a*L) := by
        rw [← Real.exp_add]; congr 1; ring
      _ ≤ _ := mul_le_mul_of_nonneg_left hY (Real.exp_pos _).le
  · rw [Real.log_mul (by norm_num) (Real.exp_ne_zero _),Real.log_exp]
    have hs : Real.sqrt L ≤ L := by
      apply (Real.sqrt_le_iff).mpr
      exact ⟨hL0.le,by nlinarith⟩
    have ht := Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 2)
    linarith

end Bounty
end

section

/- The residual gcd selects the quotient modulus without losing any characters. -/

open scoped BigOperators Classical

namespace Bounty

theorem rational_four_factor_residual_gcd_expansion {r Q : ℕ}
    (hr : 0 < r) (hrQ : r ≤ Q) (u : ℤ) (n : ℕ) :
    ∃ c : AddChar (Additive (ZMod (r / n.gcd r))ˣ) ℂ → ℂ,
      (∑ ψ, ‖c ψ‖) ≤ Real.sqrt (Q : ℝ) ∧
      ∀ m a p : ℕ, m.Coprime r → a.Coprime r → p.Coprime r →
        (∑ ψ, c ψ * unitAddCharDirichlet ψ (m : ZMod (r / n.gcd r)) *
          unitAddCharDirichlet ψ (a : ZMod (r / n.gcd r)) *
          unitAddCharDirichlet ψ (p : ZMod (r / n.gcd r)) *
          unitAddCharDirichlet ψ ((n / n.gcd r : ℕ) : ZMod (r / n.gcd r))) =
          Complex.exp (Complex.I * (2 * Real.pi * ((u : ℝ) / r * (m * a * p * n)) : ℝ)) := by
  have hd : 0 < n.gcd r := Nat.pos_of_ne_zero (Nat.gcd_ne_zero_right (Nat.ne_of_gt hr))
  have hq : 0 < r / n.gcd r := Nat.div_pos (Nat.gcd_le_right n hr) hd
  have hqr : r / n.gcd r ∣ r := Nat.div_dvd_of_dvd (Nat.gcd_dvd_right n r)
  obtain ⟨c, hc, he⟩ := rational_four_factor_unit_expansion hq
    ((Nat.div_le_self _ _).trans hrQ) u
  refine ⟨c, hc, ?_⟩
  intro m a p hm ha hp
  rw [he m a p (n / n.gcd r) (hm.of_dvd_right hqr) (ha.of_dvd_right hqr)
    (hp.of_dvd_right hqr) (Nat.coprime_div_gcd_div_gcd hd)]
  exact (rational_four_factor_phase_cancel hd hq
    (Nat.mul_div_cancel' (Nat.gcd_dvd_right n r))
    (Nat.mul_div_cancel' (Nat.gcd_dvd_left n r)) u m a p).symm

end Bounty
end

section

/- The literal nested divisor expression has the expected finite three-factor transform. -/

open Finset

namespace Bounty

theorem finite_natural_product_pos (A B : Finset ℕ)
    (hA : ∀ a ∈ A, 0 < a) (hB : ∀ b ∈ B, 0 < b) :
    ∀ n ∈ (A ×ˢ B).image (fun ab => ab.1*ab.2), 0 < n := by
  intro n hn
  obtain ⟨ab,hab,rfl⟩ := mem_image.mp hn
  exact Nat.mul_pos (hA _ (mem_product.mp hab).1) (hB _ (mem_product.mp hab).2)

theorem endpoint_triple_finite_support (A B C : Finset ℕ) (α β γ : ℕ → ℂ)
    (hA : ∀ a ∈ A, 0 < a) (hB : ∀ b ∈ B, 0 < b) (hC : ∀ c ∈ C, 0 < c)
    (hα : ∀ a, a ∉ A → α a = 0) (hβ : ∀ b, b ∉ B → β b = 0)
    (hγ : ∀ c, c ∉ C → γ c = 0) (n : ℕ)
    (hn : n ∉ (A ×ˢ ((B ×ˢ C).image (fun bc => bc.1*bc.2))).image
      (fun ar => ar.1*ar.2)) : endpointTripleConvolution α β γ n = 0 := by
  have hh := finite_divisor_convolution_support A ((B ×ˢ C).image (fun bc => bc.1*bc.2))
    α (fun r => ∑ b ∈ r.divisors, β b*γ (r/b)) hA
    (finite_natural_product_pos B C hB hC) hα
    (finite_divisor_convolution_support B C β γ hB hC hβ hγ) n hn
  simpa only [endpointTripleConvolution,mul_sum,mul_assoc] using hh

theorem endpoint_triple_finite_transform (S A B C : Finset ℕ) (α β γ F : ℕ → ℂ)
    (hA : ∀ a ∈ A, 0 < a) (hB : ∀ b ∈ B, 0 < b) (hC : ∀ c ∈ C, 0 < c)
    (hα : ∀ a, a ∉ A → α a = 0) (hβ : ∀ b, b ∉ B → β b = 0)
    (hγ : ∀ c, c ∉ C → γ c = 0)
    (hS : ∀ a ∈ A, ∀ b ∈ B, ∀ c ∈ C, a*b*c ∈ S) :
    (∑ n ∈ S, endpointTripleConvolution α β γ n*F n) =
      ∑ a ∈ A, ∑ b ∈ B, ∑ c ∈ C, α a*β b*γ c*F (a*b*c) := by
  classical
  let U := (B ×ˢ C).image (fun bc => bc.1*bc.2)
  let f : ℕ → ℂ := fun r => ∑ b ∈ r.divisors, β b*γ (r/b)
  have hU : ∀ r ∈ U, 0 < r := finite_natural_product_pos B C hB hC
  have hf : ∀ r, r ∉ U → f r = 0 :=
    finite_divisor_convolution_support B C β γ hB hC hβ hγ
  have hout := finite_divisor_convolution_transform S A U α f F hA hU hα hf (by
    intro a ha r hr
    obtain ⟨bc,hbc,rfl⟩ := mem_image.mp hr
    simpa only [Nat.mul_assoc] using hS a ha bc.1 (mem_product.mp hbc).1
      bc.2 (mem_product.mp hbc).2)
  calc
    _ = ∑ a ∈ A, ∑ r ∈ U, α a*f r*F (a*r) := by
      simpa only [endpointTripleConvolution,f,mul_sum,mul_assoc] using hout
    _ = _ := by
      apply sum_congr rfl
      intro a ha
      have hi := finite_divisor_convolution_transform U B C β γ (fun r => F (a*r))
        hB hC hβ hγ (fun b hb c hc => mem_image.mpr ⟨(b,c),mem_product.mpr ⟨hb,hc⟩,rfl⟩)
      calc
        _ = α a*(∑ r ∈ U, f r*F (a*r)) := by
          rw [mul_sum]
          apply sum_congr rfl
          intro r hr
          ring
        _ = α a*(∑ b ∈ B, ∑ c ∈ C, β b*γ c*F (a*(b*c))) := congrArg (fun z => α a*z) hi
        _ = _ := by simp only [mul_sum,mul_assoc]

end Bounty
end

section

/- Actual coefficient functions, with support restrictions retained, give exact dyadic polynomials. -/

open Finset

namespace Bounty

theorem finite_polynomial_dyadic_representation (S : Finset ℕ) (w : ℕ → ℂ)
    (U : ℝ) (hU : 0 ≤ U) (K : ℕ)
    (hsupport : ∀ n ∈ S, w n ≠ 0 → U < (n : ℝ) ∧ (n : ℝ) ≤ (2 : ℝ)^K*U)
    (t : ℝ) :
    (∑ n ∈ S, w n*Complex.exp (((Real.log (n : ℝ)*t : ℝ) : ℂ)*Complex.I)) =
      ∑ j : Fin K, ∑ n ∈ Icc (⌊(2 : ℝ)^j.val*U⌋₊+1) ⌊(2 : ℝ)^(j.val+1)*U⌋₊,
        (if n ∈ S then w n else 0)*Complex.exp (((Real.log (n : ℝ)*t : ℝ) : ℂ)*Complex.I) := by
  classical
  rw [sum_finite_dyadic_closed_intervals U hU K]
  apply sum_bij_ne_zero (fun n _ _ => n)
  · intro n hn hne
    have hw : w n ≠ 0 := by intro hz; exact hne (by rw [hz,zero_mul])
    have hh := hsupport n hn hw
    exact mem_Ioc.mpr ⟨(Nat.floor_lt hU).mpr hh.1,Nat.le_floor hh.2⟩
  · intro n hn hne m hm hme he
    exact he
  · intro n hn hne
    have hs : n ∈ S := by
      by_contra hh
      exact hne (by rw [if_neg hh,zero_mul])
    refine ⟨n,hs,?_,rfl⟩
    simpa only [if_pos hs] using hne
  · intro n hn hne
    rw [if_pos hn]

theorem harmonic_mellin_coefficient_phase (c : ℂ) (t : ℝ) (n : ℕ) :
    c*harmonicMellinWeight t n =
      (c/(n : ℂ))*Complex.exp (((Real.log (n : ℝ)*t : ℝ) : ℂ)*Complex.I) := by
  unfold harmonicMellinWeight
  have he : Complex.I*((t*Real.log (n : ℝ) : ℝ) : ℂ) =
      ((Real.log (n : ℝ)*t : ℝ) : ℂ)*Complex.I := by push_cast; ring
  rw [he]
  push_cast
  ring

theorem finite_mellin_dyadic_representation (S : Finset ℕ) (w : ℕ → ℂ)
    (U : ℝ) (hU : 0 ≤ U) (K : ℕ)
    (hsupport : ∀ n ∈ S, w n ≠ 0 → U < (n : ℝ) ∧ (n : ℝ) ≤ (2 : ℝ)^K*U)
    (t : ℝ) :
    (∑ n ∈ S, w n*harmonicMellinWeight t n) =
      ∑ j : Fin K, ∑ n ∈ Icc (⌊(2 : ℝ)^j.val*U⌋₊+1) ⌊(2 : ℝ)^(j.val+1)*U⌋₊,
        (if n ∈ S then w n/(n : ℂ) else 0)*
          Complex.exp (((Real.log (n : ℝ)*t : ℝ) : ℂ)*Complex.I) := by
  simp_rw [harmonic_mellin_coefficient_phase]
  apply finite_polynomial_dyadic_representation S (fun n => w n/(n : ℂ)) U hU K
  intro n hn hne
  apply hsupport n hn
  intro hz
  exact hne (by rw [hz,zero_div])

end Bounty
end

section

/- Literal products of characters and Mellin phases, including nonunit inputs. -/

open Filter

namespace Bounty

theorem product_level_characters_int_apply {q r : ℕ}
    (χ : DirichletCharacter ℂ q) (ψ : DirichletCharacter ℂ r) (a : ℤ) :
    (χ.changeLevel (Nat.dvd_mul_right q r)*ψ.changeLevel (Nat.dvd_mul_left r q))
        (a : ZMod (q*r)) = χ (a : ZMod q)*ψ (a : ZMod r) := by
  rw [MulChar.mul_apply]
  by_cases ha : IsCoprime a ((q*r : ℕ) : ℤ)
  · rw [DirichletCharacter.changeLevel_eq_cast_of_dvd' χ _ ha,
      DirichletCharacter.changeLevel_eq_cast_of_dvd' ψ _ ha]
  · rw [(χ.changeLevel (Nat.dvd_mul_right q r)).apply_eq_zero_iff a |>.mpr ha, zero_mul]
    have hh : ¬ (IsCoprime a (q : ℤ) ∧ IsCoprime a (r : ℤ)) := by
      simpa only [Nat.cast_mul, IsCoprime.mul_right_iff] using ha
    rcases not_and_or.mp hh with hqa | hra
    · rw [(χ.apply_eq_zero_iff a).mpr hqa, zero_mul]
    · rw [(ψ.apply_eq_zero_iff a).mpr hra, mul_zero]

theorem product_level_characters_nat_apply {q r : ℕ}
    (χ : DirichletCharacter ℂ q) (ψ : DirichletCharacter ℂ r) (n : ℕ) :
    (χ.changeLevel (Nat.dvd_mul_right q r)*ψ.changeLevel (Nat.dvd_mul_left r q))
        (n : ZMod (q*r)) = χ (n : ZMod q)*ψ (n : ZMod r) := by
  simpa only [Int.cast_natCast] using product_level_characters_int_apply χ ψ (n : ℤ)

theorem product_modulus_power_bound {L A B : ℝ} (hL : 0 < L) {q r : ℕ}
    (hq : (q : ℝ) ≤ L^A) (hr : (r : ℝ) ≤ L^B) :
    ((q*r : ℕ) : ℝ) ≤ L^(A+B) := by
  rw [Nat.cast_mul, Real.rpow_add hL]
  exact mul_le_mul hq hr (Nat.cast_nonneg _) (Real.rpow_nonneg hL.le A)

theorem harmonic_mellin_weight_cpow_shift (u σ : ℝ) {x : ℝ} (hx : 0 < x) :
    harmonicMellinWeight u x*(x : ℂ)^((σ : ℂ)*Complex.I) = harmonicMellinWeight (u+σ) x := by
  rw [Complex.cpow_def_of_ne_zero (Complex.ofReal_ne_zero.mpr hx.ne'),
    ← Complex.ofReal_log hx.le]
  unfold harmonicMellinWeight
  rw [div_mul_eq_mul_div, ← Complex.exp_add]
  congr 2
  push_cast
  ring

theorem eventually_add_frequency_power_bound (A B : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ σ τ : ℝ, |σ| ≤ L^A → |τ| ≤ L^B →
      |σ+τ| ≤ L^(max A B+1) := by
  filter_upwards [eventually_ge_atTop (2 : ℝ)] with L hL
  have hL1 : 1 ≤ L := by linarith
  have hLpos : 0 < L := by linarith
  intro σ τ hσ hτ
  have ha := Real.rpow_le_rpow_of_exponent_le hL1 (le_max_left A B)
  have hb := Real.rpow_le_rpow_of_exponent_le hL1 (le_max_right A B)
  calc
    |σ+τ| ≤ |σ|+|τ| := abs_add_le _ _
    _ ≤ 2*L^(max A B) := by linarith
    _ ≤ L*L^(max A B) := mul_le_mul_of_nonneg_right hL (Real.rpow_nonneg hLpos.le _)
    _ = _ := by rw [Real.rpow_add hLpos, Real.rpow_one]; ring

end Bounty
end

section

/- The five actual product dyads retain all scale hypotheses from their base scale. -/

namespace Bounty

theorem five_dyad_scale_bounds {V : ℝ} (hV : 0 ≤ V) (j : Fin 5) :
    V/2 ≤ (2 : ℝ)^j.val*(V/2) ∧ (2 : ℝ)^j.val*(V/2) ≤ 8*V := by
  constructor
  · exact le_mul_of_one_le_left (by positivity) (one_le_pow₀ (by norm_num))
  · have hp : (2 : ℝ)^j.val ≤ 2^(4 : ℕ) :=
      pow_le_pow_right₀ (by norm_num) (by omega)
    calc
      _ ≤ (2 : ℝ)^(4 : ℕ)*(V/2) := mul_le_mul_of_nonneg_right hp (by positivity)
      _ = _ := by norm_num; ring

theorem five_dyad_full_geometry {V c L : ℝ} (hV : 1 ≤ V/2)
    (hlog : Real.log (8*V) ≤ c*L) (j : Fin 5) :
    V/2 ≤ (2 : ℝ)^j.val*(V/2) ∧ 1 ≤ (2 : ℝ)^j.val*(V/2) ∧
      Real.log ((2 : ℝ)^j.val*(V/2)) ≤ c*L ∧
      (2 : ℝ)^j.val*(V/2) ≤ (⌊(2 : ℝ)^j.val*(V/2)⌋₊+1 : ℕ) ∧
      (⌊(2 : ℝ)^(j.val+1)*(V/2)⌋₊ : ℝ) ≤ 2*((2 : ℝ)^j.val*(V/2)) := by
  have hV0 : 0 ≤ V := by linarith
  obtain ⟨hlo,hhi⟩ := five_dyad_scale_bounds hV0 j
  have hpos : 0 < (2 : ℝ)^j.val*(V/2) := zero_lt_one.trans_le (hV.trans hlo)
  exact ⟨hlo,hV.trans hlo,(Real.log_le_log hpos hhi).trans hlog,
    finite_dyadic_interval_geometry (by positivity : 0 ≤ V/2) j.val⟩

end Bounty
end

section

/- Original product and time inequalities imply the scales used by the literal integral. -/

open Filter

namespace Bounty

theorem eventually_literal_four_factor_scales {beta gamma d eta Cmean Cres : ℝ}
    (hgamma : 0 < gamma) (hbetaGamma : beta < gamma) (hbeta : beta < 1)
    (hd : 0 < d) (heta : eta < (2/5 : ℝ)*d) (hCmean : 0 < Cmean) (hCres : 0 < Cres) :
    ∀ᶠ L : ℝ in atTop, ∀ Y P UQ UM UT h R : ℝ,
      0 < Y → 0 < P → 0 < UQ → 0 < h → d*L ≤ Real.log Y →
      P ≤ Real.exp (L^beta) → UQ ≤ Real.exp (eta*L) →
      Real.exp (L^gamma) ≤ Y*h → R ≤ 2*L/h →
      Y/(Cmean*P) ≤ UQ*UM*UT/2 → Y/(Cres*P*UQ) ≤ UM*UT/2 →
      R ≤ UQ*UM*UT/2 ∧ Y^(3/5 : ℝ) ≤ UM*UT/2 := by
  filter_upwards [eventually_four_factor_ordinary_scale hgamma hbetaGamma hCmean,
    eventually_four_factor_residual_scale hbeta hd heta hCres] with L hmean hres
  intro Y P UQ UM UT h R hY hP hQ hh hlog hsmall hQhi htime hR hmeanProd hresProd
  exact ⟨hR.trans (hmean Y P h (UQ*UM*UT/2) hY hP hh hsmall htime hmeanProd),
    hres Y P UQ (UM*UT/2) hY hP hQ hlog hsmall hQhi hresProd⟩

end Bounty
end

section

/- The original quantifier order fixes the rough slot before L tends to infinity. -/

open Finset Filter

namespace Bounty

theorem exists_candidate_rough_scale_parameters {c eta : ℝ} (hc : 0 < c) (heta : 0 < eta) :
    ∃ J : ℕ, ∀ j : ℕ, J < j → ∃ aLong : ℝ, 0 < aLong ∧
      aLong < c/2^j ∧ (6/5 : ℝ)*(c/2^j) ≤ eta := by
  obtain ⟨J,hJ⟩ := exists_nat_gt ((6/5 : ℝ)*c/eta)
  refine ⟨J,?_⟩
  intro j hj
  have hJj : (J : ℝ) ≤ (j : ℝ) := by exact_mod_cast hj.le
  have hjpow : (j : ℝ) ≤ (2 : ℝ)^j := by exact_mod_cast j.lt_two_pow_self.le
  have hscale := (div_le_iff₀ heta).mp (hJ.le.trans (hJj.trans hjpow))
  have hcj : 0 < c/(2 : ℝ)^j := by positivity
  refine ⟨(c/2^j)/2,by positivity,by linarith,?_⟩
  rw [← mul_div_assoc]
  apply (div_le_iff₀ (by positivity : (0 : ℝ) < 2^j)).mpr
  nlinarith only [hscale]

theorem exists_candidate_long_rough_dyadic_window {c eta : ℝ}
    (hc : 0 < c) (heta : 0 < eta) :
    ∃ J : ℕ, ∀ j : ℕ, J < j → ∃ aLong : ℝ, 0 < aLong ∧
      ∀ᶠ L : ℝ in atTop, ∀ U : ℝ, 0 < U →
      ((candidateRoughBand c L j).filter (fun n : ℕ => U < (n : ℝ) ∧ (n : ℝ) ≤ 2*U)).Nonempty →
      Real.exp (aLong*L) ≤ U ∧ U ≤ Real.exp (eta*L) ∧
      U ≤ max (Real.exp (c*L/2^j)) U ∧
      max (Real.exp (c*L/2^j)) U ≤ min (Real.exp ((6/5 : ℝ)*c*L/2^j)) (2*U) ∧
      min (Real.exp ((6/5 : ℝ)*c*L/2^j)) (2*U) ≤ 2*U ∧
      (candidateRoughBand c L j).filter (fun n : ℕ => U < (n : ℝ) ∧ (n : ℝ) ≤ 2*U) =
        roughBand (max (Real.exp (c*L/2^j)) U)
          (min (Real.exp ((6/5 : ℝ)*c*L/2^j)) (2*U)) (Real.exp (Real.sqrt L)) := by
  obtain ⟨J,hJ⟩ := exists_candidate_rough_scale_parameters hc heta
  refine ⟨J,?_⟩
  intro j hj
  obtain ⟨aLong,ha,hlo,hhi⟩ := hJ j hj
  refine ⟨aLong,ha,?_⟩
  filter_upwards [eventually_candidate_rough_dyadic_scales hc j j hlo hhi] with L hL
  exact hL j le_rfl le_rfl

end Bounty
end

section

/- An injective marked list leaves exactly the unmarked divisor count in its vertex weight. -/

open Finset
open scoped Classical
namespace Bounty

theorem finite_marked_vertex_as_indicator {T : Type*} [Fintype T]
    (marked : Finset T) (hit : T → Prop) (q : ℝ) :
    finiteMarkedVertex marked hit q =
      if ∀ p ∈ marked, hit p then q ^ ((univ.filter hit).card - marked.card) else 0 := by
  rw [finite_marked_vertex_factor, finite_divisibility_indicator_product]
  by_cases h : ∀ p ∈ marked, hit p
  · simp only [if_pos h, one_mul]
    have he : ((univ \ marked).filter hit) = (univ.filter hit) \ marked := by
      ext p
      simp only [mem_filter, mem_sdiff, mem_univ, true_and]
      tauto
    have hsub : marked ⊆ univ.filter hit := fun p hp => mem_filter.mpr ⟨mem_univ _,h p hp⟩
    rw [he, card_sdiff_of_subset hsub]
  · simp only [if_neg h, zero_mul]

theorem finite_marked_embedding_indicator {I T : Type*} [Fintype I] [Fintype T] [DecidableEq T]
    (e : I ↪ T) (hit : T → Prop) (q : ℝ) :
    finiteMarkedVertex (univ.image e) hit q =
      if ∀ i, hit (e i) then q ^ ((univ.filter hit).card - Fintype.card I) else 0 := by
  rw [finite_marked_vertex_as_indicator, card_image_of_injective _ e.injective, card_univ]
  simp only [forall_mem_image, mem_univ, forall_const]

end Bounty
end

section

/- Exact integer dyadic blocks in the open-left interval convention of roughBand. -/

open Finset

namespace Bounty

noncomputable def originalDyadicBase (k : ℕ) : ℝ := (2 : ℝ)^k-1/2

theorem originalDyadicBase_pos (k : ℕ) : 0 < originalDyadicBase k := by
  have h : (1 : ℝ) ≤ 2^k := one_le_pow₀ (by norm_num)
  unfold originalDyadicBase
  linarith

theorem dyadicNatBucket_eq_Ioc_filter (S : Finset ℕ) (hS : ∀ n ∈ S, 0 < n) (k : ℕ) :
    dyadicNatBucket S k = S.filter (fun n => n ∈ Ioc ((2 : ℕ)^k-1) ((2 : ℕ)^(k+1)-1)) := by
  rw [dyadicNatBucket_eq_filter_interval S hS]
  ext n
  simp only [mem_filter,mem_Ioc]
  have hpow : 1 ≤ (2 : ℕ)^k := Nat.one_le_pow k 2 (by norm_num)
  have hpow' : 1 ≤ (2 : ℕ)^(k+1) := Nat.one_le_pow (k+1) 2 (by norm_num)
  apply and_congr_right
  intro _
  constructor
  · rintro ⟨hlo,hhi⟩
    exact ⟨(Nat.sub_lt (by positivity : 0 < (2 : ℕ)^k) (by norm_num : 0 < 1)).trans_le hlo,
      Nat.le_sub_one_of_lt hhi⟩
  · rintro ⟨hlo,hhi⟩
    constructor
    · have h := Nat.succ_le_of_lt hlo
      simpa only [Nat.succ_eq_add_one,Nat.sub_add_cancel hpow] using h
    · exact hhi.trans_lt (Nat.sub_lt (by positivity : 0 < (2 : ℕ)^(k+1)) (by norm_num : 0 < 1))

theorem dyadicNatBucket_eq_real_interval (S : Finset ℕ) (hS : ∀ n ∈ S, 0 < n) (k : ℕ) :
    dyadicNatBucket S k = S.filter (fun n : ℕ => originalDyadicBase k < (n : ℝ) ∧
      (n : ℝ) ≤ 2*originalDyadicBase k) := by
  rw [dyadicNatBucket_eq_filter_interval S hS]
  ext n
  simp only [mem_filter]
  apply and_congr_right
  intro _
  have hpow : 1 ≤ (2 : ℕ)^k := Nat.one_le_pow k 2 (by norm_num)
  have hpow' : 1 ≤ (2 : ℕ)^(k+1) := Nat.one_le_pow (k+1) 2 (by norm_num)
  have he : (2 : ℝ)^(k+1) = 2*(2 : ℝ)^k := by rw [pow_succ]; ring
  unfold originalDyadicBase
  constructor
  · rintro ⟨hlo,hhi⟩
    have hlo' : (2 : ℝ)^k ≤ (n : ℝ) := by exact_mod_cast hlo
    have hhiNat : n+1 ≤ (2 : ℕ)^(k+1) := hhi
    have hhi' : (n : ℝ)+1 ≤ (2 : ℝ)^(k+1) := by exact_mod_cast hhiNat
    constructor <;> linarith
  · rintro ⟨hlo,hhi⟩
    constructor
    · by_contra hnot
      have hn : n+1 ≤ (2 : ℕ)^k := by omega
      have hn' : (n : ℝ)+1 ≤ (2 : ℝ)^k := by exact_mod_cast hn
      linarith
    · have hn' : (n : ℝ) < (2 : ℝ)^(k+1) := by linarith
      exact_mod_cast hn'

theorem dyadicNatBucket_Icc_eq_Ioc (N k : ℕ) :
    dyadicNatBucket (Icc 1 N) k = Ioc ((2 : ℕ)^k-1) (min N ((2 : ℕ)^(k+1)-1)) := by
  rw [dyadicNatBucket_eq_Ioc_filter (Icc 1 N) (fun n hn => (mem_Icc.mp hn).1)]
  ext n
  simp only [mem_filter,mem_Icc,mem_Ioc,le_min_iff]
  have hpow : 1 ≤ (2 : ℕ)^k := Nat.one_le_pow k 2 (by norm_num)
  omega

theorem dyadicNatBucket_roughBand_eq (A B W : ℝ) (hA : 0 ≤ A) (hB : 0 ≤ B) (k : ℕ) :
    dyadicNatBucket (roughBand A B W) k =
      roughBand (max A (originalDyadicBase k)) (min B (2*originalDyadicBase k)) W := by
  rw [dyadicNatBucket_eq_real_interval _ (fun _ hn => roughBand_pos hn)]
  have hk := originalDyadicBase_pos k
  exact roughBand_filter_real_interval hA hB hk.le (by positivity)

end Bounty
end

section

/- A harmonic pairing changes by the two actual endpoint square errors.
The finite support and lower endpoint are not enlarged. -/

open Finset
namespace Bounty

theorem finite_harmonic_pairing_cauchy (S : Finset ℤ) (θ f g : ℤ → ℂ)
    {Y K : ℝ} (hY : 0 < Y) (hK : 0 ≤ K)
    (hYlow : ∀ n ∈ S, Y ≤ (n : ℝ)) (hθ : ∀ n ∈ S, ‖θ n‖ ≤ K) :
    ‖∑ n ∈ S, (θ n / (n : ℂ)) * (starRingEnd ℂ) (f n) * g n‖ ≤
      (K/Y) * Real.sqrt (∑ n ∈ S, ‖f n‖^2) * Real.sqrt (∑ n ∈ S, ‖g n‖^2) := by
  have hw (n : ℤ) (hn : n ∈ S) : ‖θ n / (n : ℂ)‖ ≤ K/Y := by
    have hn0 : (0 : ℝ) < n := hY.trans_le (hYlow n hn)
    have hnC : ‖(n : ℂ)‖ = (n : ℝ) := by
      rw [← Complex.ofReal_intCast, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hn0]
    rw [norm_div, hnC]
    exact div_le_div₀ hK (hθ n hn) hY (hYlow n hn)
  have h := finite_weighted_pair_error S (fun _ => 1) (fun _ => 1) (fun _ => 1)
    f g (fun n => θ n / (n : ℂ)) (fun _ _ => by norm_num) (div_nonneg hK hY.le)
    (fun n hn => by simpa only [one_mul] using hw n hn)
  simpa only [Complex.ofReal_one, one_mul, mul_one, mul_comm, mul_left_comm, mul_assoc] using h

theorem finite_harmonic_endpoint_replacement (S : Finset ℤ) (θ f g f' g' : ℤ → ℂ)
    {Y K : ℝ} (hY : 0 < Y) (hK : 0 ≤ K)
    (hYlow : ∀ n ∈ S, Y ≤ (n : ℝ)) (hθ : ∀ n ∈ S, ‖θ n‖ ≤ K) :
    ‖(∑ n ∈ S, (θ n / (n : ℂ)) * (starRingEnd ℂ) (f n) * g n) -
      (∑ n ∈ S, (θ n / (n : ℂ)) * (starRingEnd ℂ) (f' n) * g' n)‖ ≤
      (K/Y) *
        (Real.sqrt (∑ n ∈ S, ‖f n-f' n‖^2) * Real.sqrt (∑ n ∈ S, ‖g n‖^2) +
        Real.sqrt (∑ n ∈ S, ‖f' n‖^2) * Real.sqrt (∑ n ∈ S, ‖g n-g' n‖^2)) := by
  have heq :
      (∑ n ∈ S, (θ n / (n : ℂ)) * (starRingEnd ℂ) (f n) * g n) -
      (∑ n ∈ S, (θ n / (n : ℂ)) * (starRingEnd ℂ) (f' n) * g' n) =
      (∑ n ∈ S, (θ n / (n : ℂ)) * (starRingEnd ℂ) (f n-f' n) * g n) +
      (∑ n ∈ S, (θ n / (n : ℂ)) * (starRingEnd ℂ) (f' n) * (g n-g' n)) := by
    rw [← sum_sub_distrib, ← sum_add_distrib]
    apply sum_congr rfl
    intro n _
    rw [map_sub]
    ring
  rw [heq]
  apply (norm_add_le _ _).trans
  have h1 := finite_harmonic_pairing_cauchy S θ (fun n => f n-f' n) g hY hK hYlow hθ
  have h2 := finite_harmonic_pairing_cauchy S θ f' (fun n => g n-g' n) hY hK hYlow hθ
  exact (add_le_add h1 h2).trans_eq (by ring)

end Bounty
end

section

/- Deterministic history phases commute with exact event-path transports. -/

namespace Bounty

theorem deterministic_ledger_phase_cast
    {K L X : Type*} (E : K → X → Type*) (target : ∀ k x, E k x → X)
    (update : ∀ k, L → (x : X) → E k x → L)
    (phase : ∀ k, L → (x : X) → E k x → ℂ)
    (ks : List K) (l : L) {x y : X} (h : x = y) (p : FiniteEventPath E target ks x) :
    deterministicLedgerPhase E target update phase ks l y
      (cast (congrArg (FiniteEventPath E target ks) h) p) =
      deterministicLedgerPhase E target update phase ks l x p := by
  cases h
  rfl

theorem deterministic_ledger_phase_equiv
    {K L X Y : Type*} (E : K → X → Type*) (F : K → Y → Type*)
    (t : ∀ k x, E k x → X) (u : ∀ k y, F k y → Y)
    (e : X → Y) (δ : ∀ k x, E k x ≃ F k (e x))
    (ht : ∀ k x a, e (t k x a) = u k (e x) (δ k x a))
    (v : ∀ k, L → (x : X) → E k x → L)
    (w : ∀ k, L → (y : Y) → F k y → L)
    (hv : ∀ k l x a, w k l (e x) (δ k x a) = v k l x a)
    (phase : ∀ k, L → (x : X) → E k x → ℂ)
    (phase' : ∀ k, L → (y : Y) → F k y → ℂ)
    (hp : ∀ k l x a, phase' k l (e x) (δ k x a) = phase k l x a)
    (ks : List K) (l : L) (x : X) (p : FiniteEventPath E t ks x) :
    deterministicLedgerPhase F u w phase' ks l (e x)
        (finiteEventPathEquiv E F t u e δ ht ks x p) =
      deterministicLedgerPhase E t v phase ks l x p := by
  induction ks generalizing l x with
  | nil => rfl
  | cons k ks ih =>
    rcases p with ⟨a, p⟩
    change phase' k l (e x) (δ k x a) *
      deterministicLedgerPhase F u w phase' ks (w k l (e x) (δ k x a)) _
        (cast (congrArg (FiniteEventPath F u ks) (ht k x a))
          (finiteEventPathEquiv E F t u e δ ht ks (t k x a) p)) = _
    rw [hp, hv, deterministic_ledger_phase_cast F u w phase' ks _ (ht k x a), ih]
    rfl

end Bounty
end

section

/- The character in a retained logarithmic cell has norm at most one. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def primeProductCellCharacter {I : Type*} [Fintype I]
    (P : I → Finset ℕ) (h : ℝ) (d : ℤ) {Q : ℕ} (χ : BoundedPrimitiveCharacter Q)
    (x : ∀ i, P i) : ℂ :=
  if upperLogCell h (Real.log (∏ i, (x i).val : ℕ)) = d then
    boundedPrimitiveValue χ ((∏ i, (x i).val : ℕ) : ZMod (boundedPrimitiveModulus χ))
  else 0

theorem prime_product_cell_character_norm {I : Type*} [Fintype I]
    (P : I → Finset ℕ) (h : ℝ) (d : ℤ) {Q : ℕ} (χ : BoundedPrimitiveCharacter Q)
    (x : ∀ i, P i) : ‖primeProductCellCharacter P h d χ x‖ ≤ 1 := by
  unfold primeProductCellCharacter
  split_ifs
  · exact (boundedPrimitiveValue χ).norm_le_one _
  · simp only [norm_zero, zero_le_one]

theorem prime_ideal_kernel_cell_expansion {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ) (Q : ℕ) (h : ℝ) (kept : Finset ℤ)
    (x y : ∀ i, P i) :
    primeProductIdealKernel P V Q h kept x y =
      ∑ d ∈ kept, ∑ χ : BoundedPrimitiveCharacter Q,
        ((1 / finiteCellMass (finiteProductWeight (physicalLabelLaw (P := P) V))
          (fun z => upperLogCell h (Real.log (∏ i, (z i).val : ℕ))) d : ℝ) : ℂ) *
        (starRingEnd ℂ) (primeProductCellCharacter P h d χ x) *
        primeProductCellCharacter P h d χ y := by
  unfold primeProductIdealKernel
  rw [finite_cell_kernel_expansion]
  apply sum_congr rfl
  intro d _
  apply sum_congr rfl
  intro χ _
  unfold primeProductCellCharacter
  split_ifs <;> simp_all

end Bounty
end

section

/- A deterministic phase can ignore an independent bookkeeping ledger,
while retaining its own history on the original events. -/

namespace Bounty

theorem deterministic_ledger_phase_forget
    {K H L X : Type*} (E : K → X → Type*) (target : ∀ k x, E k x → X)
    (history : ∀ k, H → (x : X) → E k x → H)
    (update : ∀ k, L → (x : X) → E k x → L)
    (phase : ∀ k, L → (x : X) → E k x → ℂ)
    (ks : List K) (h : H) (l : L) (x : X)
    (p : FiniteEventPath (fun k (s : H × X) => E k s.2)
      (finiteLedgerEventTarget E target history) ks (h, x)) :
    deterministicLedgerPhase (fun k (s : H × X) => E k s.2)
        (finiteLedgerEventTarget E target history)
        (fun k l s e => update k l s.2 e) (fun k l s e => phase k l s.2 e) ks l (h, x) p =
      deterministicLedgerPhase E target update phase ks l x
        (finiteLedgerEventPathEquiv E target history ks h x p) := by
  induction ks generalizing h l x with
  | nil => rfl
  | cons k ks ih =>
    rcases p with ⟨e, p⟩
    exact congrArg (phase k l x e * ·)
      (ih (history k h x e) (update k l x e) (target k x e) p)

end Bounty
end

section

/- A finite weighted shift average is exactly a Fourier multiplier. -/

open Finset MeasureTheory
open scoped ComplexConjugate
namespace Bounty

theorem finite_averaged_shift_fourier {I : Type*} (A : Finset I)
    (c : I → ℂ) (δ : I → ℤ) (S T : Finset ℤ) (f g : ℤ → ℂ) :
    (∑ a ∈ A, c a * ∑ n ∈ S, if n+δ a ∈ T then conj (f n)*g (n+δ a) else 0) =
      ∫ x in (0 : ℝ)..1, conj (finiteFourierSum S f x) * finiteFourierSum T g x *
        (∑ a ∈ A, c a * fourier (-δ a) (x : AddCircle (1 : ℝ))) := by
  have hcont (a : I) : Continuous (fun x : ℝ =>
      conj (finiteFourierSum S f x) * finiteFourierSum T g x *
        fourier (-δ a) (x : AddCircle (1 : ℝ))) :=
    ((continuous_finiteFourierSum S f).star.mul (continuous_finiteFourierSum T g)).mul
      (continuous_fourier_real (-δ a))
  simp_rw [← finite_fourier_shift_correlation S T f g]
  simp_rw [← intervalIntegral.integral_const_mul]
  have hint (a : I) : IntervalIntegrable (fun x : ℝ => c a *
      (conj (finiteFourierSum S f x) * finiteFourierSum T g x *
        fourier (-δ a) (x : AddCircle (1 : ℝ)))) volume 0 1 :=
    (continuous_const.mul (hcont a)).intervalIntegrable _ _
  rw [← intervalIntegral.integral_finsetSum (fun a _ => hint a)]
  apply intervalIntegral.integral_congr
  intro x _
  dsimp only
  rw [mul_sum]
  apply sum_congr rfl
  intro a _
  ring

end Bounty
end

section

/- The supported product estimate in the Fourier convention used for
integer shifted correlations. -/

open Finset
open scoped Classical
namespace Bounty

theorem fourier_product_phase (k : ℤ) (m n : ℕ) (x : ℝ) :
    fourier (-(k * (m*n : ℕ))) (x : AddCircle (1 : ℝ)) =
      (Complex.exp (Complex.I * (2 * Real.pi * (((-k : ℝ)*x)*n) : ℝ))) ^ m := by
  rw [fourier_coe_apply, ← Complex.exp_nat_mul]
  congr 1
  push_cast
  ring

theorem supported_product_fourier_dyadic_bound
    {X Y : Type*} [Fintype X] [Fintype Y]
    (π : X → ℕ) (τ : Y → ℕ) (U V : ℕ) (hU : 0 < U) (hV : 0 < V)
    (μ : X → ℝ) (ν : Y → ℝ) (hμ : ∀ x, 0 ≤ μ x) (hν : ∀ y, 0 ≤ ν y)
    (f : X → ℂ) (g : Y → ℂ)
    (hπrange : ∀ x, f x ≠ 0 → U ≤ π x ∧ π x < 2 * U)
    (hτrange : ∀ y, g y ≠ 0 → V ≤ τ y ∧ τ y < 2 * V)
    {C D : ℝ} (hC : 0 ≤ C) (hD : 0 ≤ D)
    (hμatom : ∀ m : ℕ,
      (∑ x ∈ univ.filter (fun x => π x = m), μ x) ≤ C / (m : ℝ))
    (hνatom : ∀ m : ℕ,
      (∑ y ∈ univ.filter (fun y => τ y = m), ν y) ≤ D / (m : ℝ))
    (k : ℤ) (θ : ℝ) {u : ℤ} {r : ℕ} (hr : 0 < r) (hcop : (r : ℤ).gcd u = 1)
    {β : ℝ} (hβ : |β| ≤ 1 / (r : ℝ) ^ 2) (hθ : (-k : ℝ)*θ = u/r+β) :
    ‖∑ x, ∑ y, ((μ x : ℂ)*f x)*((ν y : ℂ)*g y)*
      fourier (-(k * (π x * τ y : ℕ))) (θ : AddCircle (1 : ℝ))‖ ^ 2 ≤
      6*C*D*(1+Real.log r)*
        (1/(r : ℝ)+1/(U : ℝ)+1/(V : ℝ)+(r : ℝ)/((U : ℝ)*V))*
        (∑ x, μ x*‖f x‖^2)*∑ y, ν y*‖g y‖^2 := by
  simp_rw [fourier_product_phase, hθ]
  exact supported_weighted_product_dyadic_clean_bound π τ U V hU hV μ ν hμ hν f g
    hπrange hτrange hC hD hμatom hνatom hr hcop hβ

end Bounty
end

section

/- A multiplier small off a measurable major set is controlled by the
first endpoint's energy on that set and the total endpoint energies. -/

open MeasureTheory
open scoped ComplexConjugate
namespace Bounty

theorem multiplier_square_energy_bound {X : Type*} [MeasurableSpace X]
    (μ : Measure X) (f m : X → ℂ) (B : Set X) (hB : MeasurableSet B)
    {ε : ℝ} (hε : 0 ≤ ε) (hm : ∀ x, ‖m x‖ ≤ 1)
    (hminor : ∀ x, x ∉ B → ‖m x‖ ≤ ε)
    (hf : Integrable (fun x => ‖f x‖^2) μ)
    (hfm : Integrable (fun x => ‖f x‖^2 * ‖m x‖^2) μ) :
    (∫ x, ‖f x‖^2 * ‖m x‖^2 ∂μ) ≤
      ε^2*(∫ x, ‖f x‖^2 ∂μ) + ∫ x in B, ‖f x‖^2 ∂μ := by
  classical
  have hb : Integrable (B.indicator (fun x => ‖f x‖^2)) μ := hf.indicator hB
  calc
    _ ≤ ∫ x, ε^2*‖f x‖^2 + B.indicator (fun x => ‖f x‖^2) x ∂μ := by
      apply integral_mono hfm ((hf.const_mul _).add hb)
      intro x
      dsimp only [Pi.add_apply]
      by_cases hx : x ∈ B
      · rw [Set.indicator_of_mem hx]
        have hn : ‖m x‖^2 ≤ 1 := by nlinarith [norm_nonneg (m x), hm x]
        have hp := mul_le_mul_of_nonneg_left hn (sq_nonneg ‖f x‖)
        nlinarith [sq_nonneg ε, sq_nonneg ‖f x‖]
      · rw [Set.indicator_of_notMem hx, add_zero]
        have hn : ‖m x‖^2 ≤ ε^2 := by nlinarith [norm_nonneg (m x), hminor x hx]
        simpa only [mul_comm] using mul_le_mul_of_nonneg_left hn (sq_nonneg ‖f x‖)
    _ = _ := by rw [integral_add (hf.const_mul _) hb, integral_const_mul, integral_indicator hB]

theorem multiplier_pairing_major_energy {X : Type*} [MeasurableSpace X]
    (μ : Measure X) (f g m : X → ℂ) (B : Set X) (hB : MeasurableSet B)
    {ε : ℝ} (hε : 0 ≤ ε) (hm : ∀ x, ‖m x‖ ≤ 1)
    (hminor : ∀ x, x ∉ B → ‖m x‖ ≤ ε)
    (hf : MemLp f 2 μ) (hg : MemLp g 2 μ)
    (hfm : MemLp (fun x => conj (m x)*f x) 2 μ) :
    ‖∫ x, conj (f x)*g x*m x ∂μ‖ ≤
      Real.sqrt (ε^2*(∫ x, ‖f x‖^2 ∂μ) + ∫ x in B, ‖f x‖^2 ∂μ) *
        Real.sqrt (∫ x, ‖g x‖^2 ∂μ) := by
  have hfe := (memLp_two_iff_integrable_sq_norm hf.aestronglyMeasurable).mp hf
  have hfme := (memLp_two_iff_integrable_sq_norm hfm.aestronglyMeasurable).mp hfm
  have hnorm (x : X) : ‖conj (m x)*f x‖^2 = ‖f x‖^2*‖m x‖^2 := by
    simp only [norm_mul, RCLike.norm_conj, mul_pow]
    ring
  simp_rw [hnorm] at hfme
  have he := multiplier_square_energy_bound μ f m B hB hε hm hminor hfe hfme
  have hp := integral_pairing_energy μ (fun x => conj (m x)*f x) g hfm hg
  have heq (x : X) : conj (conj (m x)*f x)*g x = conj (f x)*g x*m x := by
    simp only [map_mul, starRingEnd_apply, star_star]
    ring
  simp_rw [heq, hnorm] at hp
  exact hp.trans (mul_le_mul_of_nonneg_right (Real.sqrt_le_sqrt he) (Real.sqrt_nonneg _))

end Bounty
end

section

/- A uniform polynomial bound for the fixed common-window harmonic energy cost. -/

open Filter Real

namespace Bounty

theorem eventually_harmonic_common_energy_polynomial :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, 1 ≤ Y → log Y ≤ 6*L →
      let N := ⌈4*exp 2*Y⌉₊
      2*((N : ℝ)/(Y/8))*(1+log (N : ℝ))^15 ≤ L^(31 : ℝ) := by
  filter_upwards [eventually_ge_atTop
    (max (1 : ℝ) (max (log 5+3) (80*exp 2*7^15)))] with L hthreshold
  intro Y hY hlogY
  dsimp only
  have hL : 1 ≤ L := (le_max_left _ _).trans hthreshold
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hlogL : log 5+3 ≤ L :=
    ((le_max_left _ _).trans (le_max_right _ _)).trans hthreshold
  have hcost : 80*exp 2*7^15 ≤ L :=
    ((le_max_right _ _).trans (le_max_right _ _)).trans hthreshold
  obtain ⟨_,hratio,hlog⟩ := harmonic_common_window_ceiling_bounds hY
  have hE : 1 ≤ exp (2 : ℝ) := one_le_exp (by norm_num)
  have hEY : 1 ≤ exp 2*Y := by
    simpa only [one_mul] using
      mul_le_mul hE hY (by norm_num : (0 : ℝ) ≤ 1) (exp_pos _).le
  have hN : 1 ≤ (⌈4*exp 2*Y⌉₊ : ℝ) :=
    (show (1 : ℝ) ≤ 4*exp 2*Y by nlinarith).trans (Nat.le_ceil _)
  have hnonneg : 0 ≤ 1+log (⌈4*exp 2*Y⌉₊ : ℝ) :=
    add_nonneg zero_le_one (log_nonneg hN)
  have hsum : 1+log (⌈4*exp 2*Y⌉₊ : ℝ) ≤ 7*L := by linarith
  calc
    _ ≤ (80*exp 2)*(1+log (⌈4*exp 2*Y⌉₊ : ℝ))^15 :=
      mul_le_mul_of_nonneg_right (by linarith) (pow_nonneg hnonneg _)
    _ ≤ (80*exp 2)*(7*L)^15 := mul_le_mul_of_nonneg_left
      (pow_le_pow_left₀ hnonneg hsum 15) (by positivity)
    _ = (80*exp 2*7^15)*L^15 := by rw [mul_pow]; ring
    _ ≤ L*L^15 := mul_le_mul_of_nonneg_right hcost (pow_nonneg hL0.le _)
    _ = L^(16 : ℝ) := by norm_num [rpow_ofNat]; ring
    _ ≤ L^(31 : ℝ) := rpow_le_rpow_of_exponent_le hL (by norm_num)

end Bounty
end

section

/- Reindexing an equal schedule preserves the deterministic phase. -/

namespace Bounty

theorem deterministic_ledger_phase_schedule_cast
    {K L X : Type*} (E : K → X → Type*) (target : ∀ k x, E k x → X)
    (update : ∀ k, L → (x : X) → E k x → L)
    (phase : ∀ k, L → (x : X) → E k x → ℂ)
    {ks ks' : List K} (h : ks = ks') (l : L) (x : X)
    (p : FiniteEventPath E target ks x) :
    deterministicLedgerPhase E target update phase ks' l x
      (cast (congrArg (fun steps => FiniteEventPath E target steps x) h) p) =
      deterministicLedgerPhase E target update phase ks l x p := by
  cases h
  rfl

end Bounty
end

section

/- Four coordinate dyadic partitions preserve arbitrary product-coupled summands. -/

open Finset

namespace Bounty

theorem sum_four_dyadicNatBuckets {E : Type*} [AddCommMonoid E]
    (D A B C : Finset ℕ) (F : ℕ → ℕ → ℕ → ℕ → E) :
    (∑ i ∈ dyadicNatIndices D, ∑ j ∈ dyadicNatIndices A,
      ∑ k ∈ dyadicNatIndices B, ∑ l ∈ dyadicNatIndices C,
      ∑ d ∈ dyadicNatBucket D i, ∑ a ∈ dyadicNatBucket A j,
      ∑ b ∈ dyadicNatBucket B k, ∑ c ∈ dyadicNatBucket C l, F d a b c) =
      ∑ d ∈ D, ∑ a ∈ A, ∑ b ∈ B, ∑ c ∈ C, F d a b c := by
  rw [← sum_dyadicNatBuckets_bilinear D A (fun d a => ∑ b ∈ B, ∑ c ∈ C, F d a b c)]
  apply sum_congr rfl
  intro i _
  apply sum_congr rfl
  intro j _
  simp_rw [sum_comm (s := dyadicNatIndices C) (t := dyadicNatBucket D i),
    sum_comm (s := dyadicNatIndices C) (t := dyadicNatBucket A j)]
  rw [sum_comm]
  apply sum_congr rfl
  intro d _
  rw [sum_comm]
  apply sum_congr rfl
  intro a _
  exact sum_dyadicNatBuckets_bilinear B C (F d a)

end Bounty
end

section

/- A measurable major set for the frequency -k*theta and the actual product
scale. The minor estimate uses the exact rational approximation dichotomy. -/

open MeasureTheory
namespace Bounty

def productMajorArcSet (k : ℤ) (L q U V : ℝ) : Set ℝ :=
  {θ | ∃ (u : ℤ) (r : ℕ), 0 < r ∧ r ≤ ⌊L^q⌋₊ ∧
    |(-k : ℝ)*θ-(u : ℝ)/r| * (U*V) ≤ L^q}

theorem product_major_arc_set_measurable (k : ℤ) (L q U V : ℝ) :
    MeasurableSet (productMajorArcSet k L q U V) := by
  have hsingle (u : ℤ) (r : ℕ) : MeasurableSet
      {θ : ℝ | 0 < r ∧ r ≤ ⌊L^q⌋₊ ∧ |(-k : ℝ)*θ-(u : ℝ)/r| * (U*V) ≤ L^q} := by
    by_cases hr : 0 < r
    · by_cases hb : r ≤ ⌊L^q⌋₊
      · simp only [hr, hb, true_and]
        exact measurableSet_le (by fun_prop) measurable_const
      · simp only [hb, and_false, false_and, Set.ofPred_false, MeasurableSet.empty]
    · simp only [hr, false_and, Set.ofPred_false, MeasurableSet.empty]
  simpa only [productMajorArcSet, Set.ofPred_exists] using
    MeasurableSet.iUnion (fun u => MeasurableSet.iUnion (fun r => hsingle u r))

theorem product_minor_arc_norm_bound
    {L C D U V κ t q B : ℝ} (hL : 512 ≤ L)
    (hC : 0 ≤ C) (hD : 0 ≤ D) (ht : 0 ≤ t) (hq : 0 ≤ q)
    (hparam : 2*κ+t+2*B+3 ≤ q) (hCb : C ≤ L^κ) (hDb : D ≤ L^κ)
    (hU : L^q ≤ U) (hV : L^q ≤ V) (hlog : Real.log (U*V) ≤ L^t)
    (k : ℤ) (θ : ℝ) (z : ℂ)
    (hbound : ∀ (u : ℤ) (r : ℕ) (β : ℝ), 0 < r → (r : ℤ).gcd u = 1 →
      |β| ≤ 1/(r : ℝ)^2 → (-k : ℝ)*θ = u/r+β →
      ‖z‖^2 ≤ 6*C*D*(1+Real.log r)*
        (1/(r : ℝ)+1/U+1/V+(r : ℝ)/(U*V)))
    (hminor : θ ∉ productMajorArcSet k L q U V) : ‖z‖ ≤ L^(-B) := by
  obtain ⟨u, r, β, hr, hcop, heq, hβ, hscale, hratio, hcase⟩ :=
    polynomial_dirichlet_dichotomy ((-k : ℝ)*θ) L q U V (by linarith) hq hU hV
  have hrlarge : L^q < (r : ℝ) := by
    rcases hcase with hs | hs
    · exact False.elim (hminor ⟨u, r, hr, hs, by simpa only [heq, add_sub_cancel_left] using hscale⟩)
    · exact hs
  have hs := minor_arc_uniform_factor_le hL hC hD ht hq hparam hCb hDb
    hU hV hrlarge.le hratio hlog
  have hb := hbound u r β hr hcop hβ heq
  have hz : ‖z‖ ≤ Real.sqrt (6*C*D*(1+Real.log r)*
      (1/(r : ℝ)+1/U+1/V+(r : ℝ)/(U*V))) := by
    exact Real.le_sqrt_of_sq_le hb
  nlinarith [Real.sqrt_nonneg (6*C*D*(1+Real.log r)*
    (1/(r : ℝ)+1/U+1/V+(r : ℝ)/(U*V)))]

end Bounty
end

section

namespace Bounty

theorem dyadic_decay_weight_le {L h t : ℝ} (hL : 1 ≤ L) (hh : 0 < h)
    (n M : ℕ) (ht : t ∈ dyadicAbsShell (L/h) n) :
    (1+|h*t|)^(-((M+2:ℕ):ℝ)) ≤ L^(-(M:ℝ)) * (1/4:ℝ)^n := by
  have hLp : 0 < L := lt_of_lt_of_le zero_lt_one hL
  have hb : 0 < 1+|h*t| := by positivity
  have hn : 1 ≤ (2:ℝ)^n := one_le_pow₀ (by norm_num)
  have hht : (2:ℝ)^n*L ≤ |h*t| := by
    rw [abs_mul, abs_of_pos hh]
    have ht' := mul_le_mul_of_nonneg_left ht.1 hh.le
    calc
      (2:ℝ)^n*L = h*((2:ℝ)^n*(L/h)) := by field_simp
      _ ≤ h*|t| := ht'
  have hbaseL : L ≤ 1+|h*t| := by nlinarith
  have hbase2 : (2:ℝ)^n ≤ 1+|h*t| := by nlinarith
  rw [Real.rpow_neg hb.le, Real.rpow_natCast, Real.rpow_neg hLp.le,
    Real.rpow_natCast, pow_add, mul_inv_rev, mul_comm]
  have hp := inv_le_inv₀ (pow_pos hb M) (pow_pos hLp M) |>.2
    (pow_le_pow_left₀ hLp.le hbaseL M)
  have hq := inv_le_inv₀ (pow_pos hb 2) (pow_pos (pow_pos (by norm_num : (0:ℝ)<2) n) 2) |>.2
    (pow_le_pow_left₀ (by positivity) hbase2 2)
  have heq : (((2:ℝ)^n)^2)⁻¹ = (1/4:ℝ)^n := by
    rw [← pow_mul, Nat.mul_comm n 2, pow_mul, ← inv_pow]
    norm_num
  rw [heq] at hq
  exact mul_le_mul hp hq (by positivity) (by positivity)

end Bounty
end

section

/- Absolute harmonic masses on finite dyadic blocks, uniformly in Mellin frequency. -/

open Finset Real

namespace Bounty

theorem harmonic_mass_le_card_div (S : Finset ℕ) (f : ℕ → ℂ) {U B : ℝ}
    (hU : 0 < U) (hB : 0 ≤ B) (hS : ∀ n ∈ S, U ≤ (n : ℝ))
    (hf : ∀ n ∈ S, ‖f n‖ ≤ B) :
    (∑ n ∈ S, ‖f n‖/(n : ℝ)) ≤ (S.card : ℝ)*(B/U) := by
  calc
    _ ≤ ∑ _n ∈ S, B/U := by
      apply sum_le_sum
      intro n hn
      exact (div_le_div_of_nonneg_right (hf n hn) (Nat.cast_nonneg n)).trans
        (div_le_div_of_nonneg_left hB hU (hS n hn))
    _ = _ := by rw [sum_const,nsmul_eq_mul]

theorem dyadic_nat_harmonic_mass_le (S : Finset ℕ) (f : ℕ → ℂ) {N : ℕ} {B : ℝ}
    (hN : 1 ≤ N) (hB : 0 ≤ B) (hS : S ⊆ Ico N (2*N))
    (hf : ∀ n ∈ S, ‖f n‖ ≤ B) :
    (∑ n ∈ S, ‖f n‖/(n : ℝ)) ≤ B := by
  have hN0 : (0 : ℝ) < N := by exact_mod_cast (show 0 < N by omega)
  have hcard : (S.card : ℝ) ≤ N := by
    have h := card_le_card hS
    rw [Nat.card_Ico] at h
    exact_mod_cast (show S.card ≤ N by omega)
  calc
    _ ≤ (S.card : ℝ)*(B/(N : ℝ)) := harmonic_mass_le_card_div S f hN0 hB
      (fun n hn => by exact_mod_cast (mem_Ico.mp (hS hn)).1) hf
    _ ≤ (N : ℝ)*(B/(N : ℝ)) := mul_le_mul_of_nonneg_right hcard (div_nonneg hB hN0.le)
    _ = B := by field_simp

theorem dyadic_harmonic_mass_le (S : Finset ℕ) (f : ℕ → ℂ) {U B : ℝ}
    (hU : 1 ≤ U) (hB : 0 ≤ B)
    (hS : ∀ n ∈ S, U ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*U)
    (hf : ∀ n ∈ S, ‖f n‖ ≤ B) :
    (∑ n ∈ S, ‖f n‖/(n : ℝ)) ≤ 2*B := by
  have hU0 : 0 < U := zero_lt_one.trans_le hU
  have hsub : S ⊆ Ioc 0 ⌊2*U⌋₊ := by
    intro n hn
    exact mem_Ioc.mpr ⟨by exact_mod_cast hU0.trans_le (hS n hn).1,Nat.le_floor (hS n hn).2⟩
  have hcard : (S.card : ℝ) ≤ 2*U := by
    have h : S.card ≤ ⌊2*U⌋₊ := by simpa only [Nat.card_Ioc,Nat.sub_zero] using card_le_card hsub
    exact (show (S.card : ℝ) ≤ (⌊2*U⌋₊ : ℝ) by exact_mod_cast h).trans
      (Nat.floor_le (by positivity))
  calc
    _ ≤ (S.card : ℝ)*(B/U) := harmonic_mass_le_card_div S f hU0 hB (fun n hn => (hS n hn).1) hf
    _ ≤ (2*U)*(B/U) := mul_le_mul_of_nonneg_right hcard (div_nonneg hB hU0.le)
    _ = 2*B := by field_simp

theorem harmonic_mellin_l1_eq_mass (S : Finset ℕ) (f : ℕ → ℂ) (t : ℝ)
    (hS : ∀ n ∈ S, 0 < n) :
    (∑ n ∈ S, ‖f n*harmonicMellinWeight t n‖) = ∑ n ∈ S, ‖f n‖/(n : ℝ) := by
  apply sum_congr rfl
  intro n hn
  rw [norm_mul,norm_harmonic_mellin_weight t (by exact_mod_cast hS n hn)]
  ring

theorem dyadic_nat_harmonic_mellin_l1_le (S : Finset ℕ) (f : ℕ → ℂ) (t : ℝ)
    {N : ℕ} {B : ℝ} (hN : 1 ≤ N) (hB : 0 ≤ B) (hS : S ⊆ Ico N (2*N))
    (hf : ∀ n ∈ S, ‖f n‖ ≤ B) :
    (∑ n ∈ S, ‖f n*harmonicMellinWeight t n‖) ≤ B := by
  rw [harmonic_mellin_l1_eq_mass S f t (fun n hn => by have := (mem_Ico.mp (hS hn)).1; omega)]
  exact dyadic_nat_harmonic_mass_le S f hN hB hS hf

theorem dyadic_nat_harmonic_mass_product_rpow {ι : Type*} (I : Finset ι)
    (S : ι → Finset ℕ) (f : ι → ℕ → ℂ) (N : ι → ℕ) (C : ι → ℝ)
    {L : ℝ} (hL : 0 < L) (hN : ∀ i ∈ I, 1 ≤ N i)
    (hS : ∀ i ∈ I, S i ⊆ Ico (N i) (2*N i))
    (hf : ∀ i ∈ I, ∀ n ∈ S i, ‖f i n‖ ≤ L^(C i)) :
    (∏ i ∈ I, ∑ n ∈ S i, ‖f i n‖/(n : ℝ)) ≤ L^(∑ i ∈ I, C i) := by
  calc
    _ ≤ ∏ i ∈ I, L^(C i) := prod_le_prod₀ (fun i hi => by positivity)
      (fun i hi => dyadic_nat_harmonic_mass_le (S i) (f i) (hN i hi)
        (rpow_nonneg hL.le _) (hS i hi) (hf i hi))
    _ = _ := (rpow_sum_of_pos hL C I).symm

theorem dyadic_harmonic_mass_product_rpow {ι : Type*} (I : Finset ι)
    (S : ι → Finset ℕ) (f : ι → ℕ → ℂ) (U C : ι → ℝ)
    {L : ℝ} (hL : 0 < L) (hU : ∀ i ∈ I, 1 ≤ U i)
    (hS : ∀ i ∈ I, ∀ n ∈ S i, U i ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*U i)
    (hf : ∀ i ∈ I, ∀ n ∈ S i, ‖f i n‖ ≤ L^(C i)) :
    (∏ i ∈ I, ∑ n ∈ S i, ‖f i n‖/(n : ℝ)) ≤ 2^I.card*L^(∑ i ∈ I, C i) := by
  calc
    _ ≤ ∏ i ∈ I, 2*L^(C i) := prod_le_prod₀ (fun i hi => by positivity)
      (fun i hi => dyadic_harmonic_mass_le (S i) (f i) (hU i hi)
        (rpow_nonneg hL.le _) (hS i hi) (hf i hi))
    _ = _ := by rw [prod_mul_distrib,prod_const,← rpow_sum_of_pos hL C I]

end Bounty
end

section

/- A phase independent of the auxiliary ledger is the original local path phase. -/

namespace Bounty

theorem deterministic_ledger_local_phase
    {K L X : Type*} (E : K → X → Type*) (target : ∀ k x, E k x → X)
    (update : ∀ k, L → (x : X) → E k x → L) (phase : ∀ k x, E k x → ℂ)
    (ks : List K) (l : L) (x : X) (p : FiniteEventPath E target ks x) :
    deterministicLedgerPhase E target update (fun k _ x e => phase k x e) ks l x p =
      finiteEventLocalPhase E target phase ks x p := by
  induction ks generalizing l x with
  | nil => rfl
  | cons k ks ih =>
    rcases p with ⟨e, p⟩
    exact congrArg (phase k x e * ·) (ih (update k l x e) (target k x e) p)

end Bounty
end

section

/- Ceiling and logarithm bounds for the exact common-support natural cutoff. -/

open Filter

namespace Bounty

theorem harmonic_common_ceiling_le_sixtyfour {Y : ℝ} (hY : 1 ≤ Y) :
    (⌈4*Real.exp 2*Y⌉₊ : ℝ) ≤ 64*Y := by
  have he : Real.exp (2:ℝ) = Real.exp 1*Real.exp 1 := by
    rw [← Real.exp_add]
    norm_num
  have he9 : Real.exp (2:ℝ) ≤ 9 := by
    rw [he]
    nlinarith [Real.exp_one_lt_three,Real.exp_pos 1]
  have hb := (harmonic_common_window_ceiling_bounds hY).1
  have hY0 : 0 ≤ Y := by linarith
  have hc := mul_le_mul_of_nonneg_right he9 hY0
  nlinarith

theorem eventually_harmonic_common_cutoff_geometry :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, 1 ≤ Y → Real.log Y ≤ 6*L →
      (⌈4*Real.exp 2*Y⌉₊ : ℝ) ≤ 64*Y ∧
      Real.log (⌈4*Real.exp 2*Y⌉₊ : ℝ) ≤ 64*L := by
  filter_upwards [eventually_ge_atTop (1:ℝ),
    eventually_ge_atTop (Real.log 5+2)] with L hL hLc
  intro Y hY hlog
  refine ⟨harmonic_common_ceiling_le_sixtyfour hY,?_⟩
  have hb := (harmonic_common_window_ceiling_bounds hY).2.2
  linarith

end Bounty
end

section

/- Integration of translated averages using shifted square-energy bounds. -/

open MeasureTheory

namespace Bounty

theorem integrated_translate_average_square
    (μ ν : Measure ℝ) [IsFiniteMeasure μ] [SFinite ν]
    {κ P : ℝ → ℂ} {M B : ℝ} (c : ℝ)
    (hκc : Continuous κ) (hκi : Integrable κ ν)
    (hP : Continuous P) (hM : 0 ≤ M) (hPM : ∀ s, ‖P s‖ ≤ M)
    (hB : ∀ u, (∫ s, ‖P (s+c*u)‖^2 ∂μ) ≤ B) :
    Integrable (fun s => ‖∫ u, κ u * P (s+c*u) ∂ν‖^2) μ ∧
    (∫ s, ‖∫ u, κ u * P (s+c*u) ∂ν‖^2 ∂μ) ≤
      (∫ u, ‖κ u‖ ∂ν)^2 * B := by
  let A := ∫ u, ‖κ u‖ ∂ν
  have hA : 0 ≤ A := integral_nonneg (fun u => norm_nonneg _)
  have hc : Continuous (fun p : ℝ × ℝ => κ p.2 * P (p.1+c*p.2)) := by fun_prop
  have hm : StronglyMeasurable (fun s => ∫ u, κ u * P (s+c*u) ∂ν) :=
    hc.stronglyMeasurable.integral_prod_right'
  have hEb (s : ℝ) : ‖∫ u, κ u * P (s+c*u) ∂ν‖ ≤ A*M := by
    change _ ≤ (∫ u, ‖κ u‖ ∂ν)*M
    rw [← integral_mul_const]
    apply norm_integral_le_of_norm_le (hκi.norm.mul_const M)
    filter_upwards [] with u
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (hPM _) (norm_nonneg _)
  have hEi : Integrable (fun s => ‖∫ u, κ u * P (s+c*u) ∂ν‖^2) μ := by
    apply (integrable_const ((A*M)^2)).mono' (hm.norm.pow 2).aestronglyMeasurable
    filter_upwards [] with s
    change ‖‖∫ u, κ u * P (s+c*u) ∂ν‖^2‖ ≤ (A*M)^2
    rw [Real.norm_of_nonneg (sq_nonneg _)]
    exact pow_le_pow_left₀ (norm_nonneg _) (hEb s) 2
  have hQc : Continuous (fun p : ℝ × ℝ => ‖κ p.2‖ * ‖P (p.1+c*p.2)‖^2) := by fun_prop
  have hQi : Integrable (fun p : ℝ × ℝ => ‖κ p.2‖ * ‖P (p.1+c*p.2)‖^2)
      (μ.prod ν) := by
    apply ((hκi.norm.mul_const (M^2)).comp_snd μ).mono' hQc.aestronglyMeasurable
    filter_upwards [] with p
    rw [Real.norm_of_nonneg (mul_nonneg (norm_nonneg _) (sq_nonneg _))]
    exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) (hPM _) 2) (norm_nonneg _)
  have hpoint (s : ℝ) : ‖∫ u, κ u * P (s+c*u) ∂ν‖^2 ≤
      A * ∫ u, ‖κ u‖ * ‖P (s+c*u)‖^2 ∂ν :=
    (bounded_weighted_integral_square hκi (by fun_prop) hM (fun u => hPM _)).2
  refine ⟨hEi, ?_⟩
  calc
    _ ≤ ∫ s, A * (∫ u, ‖κ u‖ * ‖P (s+c*u)‖^2 ∂ν) ∂μ :=
      integral_mono hEi (hQi.integral_prod_left.const_mul A) hpoint
    _ = A * ∫ u, (∫ s, ‖κ u‖ * ‖P (s+c*u)‖^2 ∂μ) ∂ν := by
      rw [integral_const_mul, integral_integral_swap hQi]
    _ ≤ A * ∫ u, ‖κ u‖ * B ∂ν := by
      apply mul_le_mul_of_nonneg_left _ hA
      apply integral_mono hQi.integral_prod_right (hκi.norm.mul_const B)
      intro u
      change (∫ s, ‖κ u‖ * ‖P (s+c*u)‖^2 ∂μ) ≤ ‖κ u‖ * B
      rw [integral_const_mul]
      exact mul_le_mul_of_nonneg_left (hB u) (norm_nonneg _)
    _ = _ := by rw [integral_mul_const]; dsimp [A]; ring

end Bounty
end

section

/- Uniform polynomial absorption of the retained-box mean-square scale. -/

open Filter Real

namespace Bounty

theorem eventually_harmonic_box_mean_square_scalar {c E : ℝ} (hc : 0 ≤ c) :
    ∀ᶠ L : ℝ in atTop, ∀ Y T W : ℝ,
      1 ≤ Y → log Y ≤ c*L → 0 ≤ T → T ≤ L*Y → 0 ≤ W → W ≤ L^E →
      let N := ⌈64*exp 2*Y⌉₊
      (2*T + 4*(N : ℝ)*(1 + log N)) *
        (W^2 * ((N : ℝ)*(1 + log N)^15) / (Y/128)^2) ≤ L^(2*E+17) := by
  let K : ℝ := 80*exp 2
  let B : ℝ := c+1
  let C : ℝ := (2+4*K*B)*K*B^15*128^2
  filter_upwards [eventually_ge_atTop (max (1 : ℝ) (max (log 5+log 16+3) C))]
    with L hthreshold
  intro Y T W hY hlogY hT hTY hW hWL
  dsimp only
  let N := ⌈64*exp 2*Y⌉₊
  have hL : 1 ≤ L := (le_max_left _ _).trans hthreshold
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hY0 : 0 < Y := zero_lt_one.trans_le hY
  have hK : 0 < K := by dsimp only [K]; positivity
  have hB : 0 < B := by dsimp only [B]; linarith
  have hClog : log 5+log 16+3 ≤ L :=
    ((le_max_left _ _).trans (le_max_right _ _)).trans hthreshold
  have hC : C ≤ L := ((le_max_right _ _).trans (le_max_right _ _)).trans hthreshold
  have hscaled := harmonic_common_window_ceiling_bounds (show 1 ≤ 16*Y by linarith)
  rw [show 4*exp 2*(16*Y) = 64*exp 2*Y by ring] at hscaled
  have hN : (N : ℝ) ≤ K*Y := by
    dsimp only [N, K]
    linarith [hscaled.1]
  have hlogN : 1 + log (N : ℝ) ≤ B*L := by
    have hlog := hscaled.2.2
    rw [log_mul (by norm_num : (16 : ℝ) ≠ 0) hY0.ne'] at hlog
    dsimp only [N, B]
    linarith
  have hlog0 : 0 ≤ 1 + log (N : ℝ) := by
    have hn := log_natCast_nonneg N
    linarith
  have hmean : 2*T + 4*(N : ℝ)*(1 + log N) ≤ (2+4*K*B)*L*Y := by
    calc
      _ ≤ 2*(L*Y) + 4*(K*Y)*(B*L) := by gcongr
      _ = _ := by ring
  have henergy : W^2 * ((N : ℝ)*(1 + log N)^15) / (Y/128)^2 ≤
      (L^E)^2 * ((K*Y)*(B*L)^15) / (Y/128)^2 := by
    gcongr
  have hpower : (L^E)^2 * L^16 = L^(2*E+16) := by
    rw [← rpow_mul_natCast hL0.le, ← rpow_natCast, ← rpow_add hL0]
    congr 1
    norm_num
    ring
  change (2*T + 4*(N : ℝ)*(1 + log N)) *
      (W^2 * ((N : ℝ)*(1 + log N)^15) / (Y/128)^2) ≤ _
  calc
    _ ≤ ((2+4*K*B)*L*Y) *
        ((L^E)^2 * ((K*Y)*(B*L)^15) / (Y/128)^2) := by
      apply mul_le_mul hmean henergy
      · positivity
      · positivity
    _ = C * ((L^E)^2 * L^16) := by
      dsimp only [C]
      field_simp
    _ = C * L^(2*E+16) := by rw [hpower]
    _ ≤ L * L^(2*E+16) := mul_le_mul_of_nonneg_right hC (rpow_nonneg hL0.le _)
    _ = L^(2*E+17) := by
      rw [show 2*E+17 = (2*E+16)+1 by ring, rpow_add_one hL0.ne' (2*E+16)]
      ring

end Bounty
end

section

/- Integrating the finite Cauchy bound without changing any summand. -/

open Finset MeasureTheory
namespace Bounty

theorem finite_integrated_energy_le_card_sq {Ω ι : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) (S : Finset ι) (f : ι → Ω → ℂ) (E : ℝ)
    (hf : ∀ i ∈ S, Integrable (fun s => ‖f i s‖ ^ 2) μ)
    (hE : ∀ i ∈ S, (∫ s, ‖f i s‖ ^ 2 ∂μ) ≤ E) :
    (∫ s, ‖∑ i ∈ S, f i s‖ ^ 2 ∂μ) ≤ (S.card : ℝ) ^ 2 * E := by
  have hi : Integrable (fun s => (S.card : ℝ) * ∑ i ∈ S, ‖f i s‖ ^ 2) μ :=
    (integrable_finsetSum S hf).const_mul _
  calc
    _ ≤ ∫ s, (S.card : ℝ) * ∑ i ∈ S, ‖f i s‖ ^ 2 ∂μ :=
      integral_mono_of_nonneg (Filter.Eventually.of_forall (fun s => sq_nonneg _)) hi
        (Filter.Eventually.of_forall (fun s => finite_sum_norm_square_le_card S (fun i => f i s)))
    _ = (S.card : ℝ) * ∑ i ∈ S, ∫ s, ‖f i s‖ ^ 2 ∂μ := by
      rw [integral_const_mul, integral_finsetSum S hf]
    _ ≤ (S.card : ℝ) * ∑ _i ∈ S, E :=
      mul_le_mul_of_nonneg_left (sum_le_sum hE) (Nat.cast_nonneg _)
    _ = _ := by simp only [sum_const, nsmul_eq_mul]; ring

theorem four_integrated_energy_le_card_eight {Ω ι : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) (S : Finset ι) (f : ι → ι → ι → ι → Ω → ℂ) (E : ℝ)
    (hf : ∀ i ∈ S, ∀ j ∈ S, ∀ k ∈ S, ∀ l ∈ S,
      Integrable (fun s => ‖f i j k l s‖ ^ 2) μ)
    (hE : ∀ i ∈ S, ∀ j ∈ S, ∀ k ∈ S, ∀ l ∈ S,
      (∫ s, ‖f i j k l s‖ ^ 2 ∂μ) ≤ E) :
    (∫ s, ‖∑ i ∈ S, ∑ j ∈ S, ∑ k ∈ S, ∑ l ∈ S, f i j k l s‖ ^ 2 ∂μ)
      ≤ (S.card : ℝ) ^ 8 * E := by
  have h := finite_integrated_energy_le_card_sq μ ((S ×ˢ S) ×ˢ (S ×ˢ S))
    (fun p s => f p.1.1 p.1.2 p.2.1 p.2.2 s) E
    (fun p hp => hf _ (mem_product.mp (mem_product.mp hp).1).1
      _ (mem_product.mp (mem_product.mp hp).1).2
      _ (mem_product.mp (mem_product.mp hp).2).1
      _ (mem_product.mp (mem_product.mp hp).2).2)
    (fun p hp => hE _ (mem_product.mp (mem_product.mp hp).1).1
      _ (mem_product.mp (mem_product.mp hp).1).2
      _ (mem_product.mp (mem_product.mp hp).2).1
      _ (mem_product.mp (mem_product.mp hp).2).2)
  simp only [sum_product, card_product, Nat.cast_mul] at h
  convert h using 1
  ring

end Bounty
end

section

/- A fixed logarithmic loss for four-coordinate dyadic energy assembly. -/

open Finset Filter
namespace Bounty

theorem eventually_dyadic_eighth_card_le (C : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ N : ℕ, Real.log N ≤ C * L →
      ((dyadicNatIndices (Icc 1 N)).card : ℝ) ^ 8 ≤ L ^ 9 := by
  let K : ℝ := C / Real.log 2 + 1
  filter_upwards [eventually_ge_atTop (1 : ℝ), eventually_ge_atTop (K ^ 8)] with L hL hK
  intro N hlog
  have htwo : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hc : ((dyadicNatIndices (Icc 1 N)).card : ℝ) ≤ K * L := by
    calc
      _ ≤ Real.log N / Real.log 2 + 1 :=
        dyadicNatIndices_card_le_log (Icc 1 N) N (fun n hn => (mem_Icc.mp hn).2)
      _ ≤ C * L / Real.log 2 + L :=
        _root_.add_le_add (div_le_div_of_nonneg_right hlog htwo.le) hL
      _ = K * L := by dsimp [K]; ring
  calc
    _ ≤ (K * L) ^ 8 := pow_le_pow_left₀ (Nat.cast_nonneg _) hc 8
    _ = K ^ 8 * L ^ 8 := mul_pow _ _ _
    _ ≤ L * L ^ 8 := mul_le_mul_of_nonneg_right hK (by positivity)
    _ = L ^ 9 := by ring

end Bounty
end

section

/- Bilinear consequences of the multiplicative large sieve for two independent finite sums. -/

open scoped BigOperators

namespace Bounty

theorem primitive_character_weighted_cauchy (Q : Finset ℕ) (w : ℕ → ℝ)
    (hw : ∀ q ∈ Q, 0 ≤ w q)
    (A B : (q : ℕ) → DirichletCharacter ℂ q → ℝ) :
    (∑ q ∈ Q, w q * ∑ χ ∈ primitiveCharacters q, A q χ * B q χ) ^ 2 ≤
      (∑ q ∈ Q, w q * ∑ χ ∈ primitiveCharacters q, A q χ ^ 2) *
        ∑ q ∈ Q, w q * ∑ χ ∈ primitiveCharacters q, B q χ ^ 2 := by
  classical
  have h := Finset.sum_sq_le_sum_mul_sum_of_sq_le_mul (Q.sigma primitiveCharacters)
    (r := fun v => w v.1 * (A v.1 v.2 * B v.1 v.2))
    (f := fun v => w v.1 * A v.1 v.2 ^ 2)
    (g := fun v => w v.1 * B v.1 v.2 ^ 2)
    (fun v hv => mul_nonneg (hw v.1 (Finset.mem_sigma.mp hv).1) (sq_nonneg _))
    (fun v hv => mul_nonneg (hw v.1 (Finset.mem_sigma.mp hv).1) (sq_nonneg _))
    (fun v _ => le_of_eq (by ring))
  simpa only [Finset.sum_sigma, ← Finset.mul_sum] using h

theorem multiplicative_large_sieve_bilinear_sq (Q : Finset ℕ) {R N M : ℝ}
    (hR : 1 ≤ R) (hQ0 : ∀ q ∈ Q, 0 < q) (hQR : ∀ q ∈ Q, (q : ℝ) ≤ R)
    (S T : Finset ℤ) (a b : ℤ → ℂ) (hN : 0 ≤ N) (hM : 0 ≤ M)
    (hS : ∀ n ∈ S, |(n : ℝ)| ≤ N) (hT : ∀ n ∈ T, |(n : ℝ)| ≤ M) :
    (∑ q ∈ Q, (q : ℝ) / q.totient * ∑ χ ∈ primitiveCharacters q,
      ‖∑ n ∈ S, a n * χ (n : ZMod q)‖ * ‖∑ n ∈ T, b n * χ (n : ZMod q)‖) ^ 2 ≤
      (6 + 8 * Real.pi) ^ 2 * (N + R ^ 2) * (M + R ^ 2) *
        (∑ n ∈ S, ‖a n‖ ^ 2) * ∑ n ∈ T, ‖b n‖ ^ 2 := by
  have hA := multiplicative_large_sieve Q hR hQ0 hQR S a hN hS
  have hB := multiplicative_large_sieve Q hR hQ0 hQR T b hM hT
  have hcs := primitive_character_weighted_cauchy Q (fun q => (q : ℝ) / q.totient)
    (fun q _ => by positivity)
    (fun q χ => ‖∑ n ∈ S, a n * χ (n : ZMod q)‖)
    (fun q χ => ‖∑ n ∈ T, b n * χ (n : ZMod q)‖)
  apply hcs.trans
  calc
    _ ≤ ((6 + 8 * Real.pi) * (N + R ^ 2) * ∑ n ∈ S, ‖a n‖ ^ 2) *
        ((6 + 8 * Real.pi) * (M + R ^ 2) * ∑ n ∈ T, ‖b n‖ ^ 2) :=
      mul_le_mul hA hB (by positivity) (by positivity)
    _ = _ := by ring

theorem multiplicative_large_sieve_bilinear (Q : Finset ℕ) {R N M : ℝ}
    (hR : 1 ≤ R) (hQ0 : ∀ q ∈ Q, 0 < q) (hQR : ∀ q ∈ Q, (q : ℝ) ≤ R)
    (S T : Finset ℤ) (a b : ℤ → ℂ) (hN : 0 ≤ N) (hM : 0 ≤ M)
    (hS : ∀ n ∈ S, |(n : ℝ)| ≤ N) (hT : ∀ n ∈ T, |(n : ℝ)| ≤ M) :
    (∑ q ∈ Q, (q : ℝ) / q.totient * ∑ χ ∈ primitiveCharacters q,
      ‖∑ n ∈ S, a n * χ (n : ZMod q)‖ * ‖∑ n ∈ T, b n * χ (n : ZMod q)‖) ≤
      (6 + 8 * Real.pi) * Real.sqrt ((N + R ^ 2) * (M + R ^ 2) *
        (∑ n ∈ S, ‖a n‖ ^ 2) * ∑ n ∈ T, ‖b n‖ ^ 2) := by
  have h := Real.le_sqrt_of_sq_le
    (multiplicative_large_sieve_bilinear_sq Q hR hQ0 hQR S T a b hN hM hS hT)
  have heq : (6 + 8 * Real.pi) ^ 2 * (N + R ^ 2) * (M + R ^ 2) *
      (∑ n ∈ S, ‖a n‖ ^ 2) * (∑ n ∈ T, ‖b n‖ ^ 2) =
      (6 + 8 * Real.pi) ^ 2 * ((N + R ^ 2) * (M + R ^ 2) *
        (∑ n ∈ S, ‖a n‖ ^ 2) * ∑ n ∈ T, ‖b n‖ ^ 2) := by ring
  rw [heq, Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq (by positivity : 0 ≤ 6 + 8 * Real.pi)] at h
  exact h

theorem multiplicative_large_sieve_bilinear_conductors (Q : Finset ℕ) {D R N M : ℝ}
    (hD : 0 < D) (hR : 1 ≤ R)
    (hQD : ∀ q ∈ Q, D ≤ (q : ℝ)) (hQR : ∀ q ∈ Q, (q : ℝ) ≤ R)
    (S T : Finset ℤ) (a b : ℤ → ℂ) (hN : 0 ≤ N) (hM : 0 ≤ M)
    (hS : ∀ n ∈ S, |(n : ℝ)| ≤ N) (hT : ∀ n ∈ T, |(n : ℝ)| ≤ M) :
    (∑ q ∈ Q, 1 / (q.totient : ℝ) * ∑ χ ∈ primitiveCharacters q,
      ‖∑ n ∈ S, a n * χ (n : ZMod q)‖ * ‖∑ n ∈ T, b n * χ (n : ZMod q)‖) ≤
      ((6 + 8 * Real.pi) / D) * Real.sqrt ((N + R ^ 2) * (M + R ^ 2) *
        (∑ n ∈ S, ‖a n‖ ^ 2) * ∑ n ∈ T, ‖b n‖ ^ 2) := by
  have hQ0 (q : ℕ) (hq : q ∈ Q) : 0 < q := by
    exact_mod_cast hD.trans_le (hQD q hq)
  have hweight (q : ℕ) (hq : q ∈ Q) :
      1 / (q.totient : ℝ) ≤ ((q : ℝ) / q.totient) / D := by
    apply (le_div_iff₀ hD).mpr
    simpa only [div_eq_mul_inv, one_mul, mul_one, mul_comm] using
      mul_le_mul_of_nonneg_right (hQD q hq) (inv_nonneg.mpr (Nat.cast_nonneg q.totient))
  calc
    _ ≤ ∑ q ∈ Q, D⁻¹ * ((q : ℝ) / q.totient * ∑ χ ∈ primitiveCharacters q,
        ‖∑ n ∈ S, a n * χ (n : ZMod q)‖ * ‖∑ n ∈ T, b n * χ (n : ZMod q)‖) := by
      apply Finset.sum_le_sum
      intro q hq
      have h := mul_le_mul_of_nonneg_right (hweight q hq)
        (show 0 ≤ ∑ χ ∈ primitiveCharacters q,
          ‖∑ n ∈ S, a n * χ (n : ZMod q)‖ * ‖∑ n ∈ T, b n * χ (n : ZMod q)‖ by positivity)
      convert h using 1; ring
    _ = D⁻¹ * (∑ q ∈ Q, (q : ℝ) / q.totient * ∑ χ ∈ primitiveCharacters q,
        ‖∑ n ∈ S, a n * χ (n : ZMod q)‖ * ‖∑ n ∈ T, b n * χ (n : ZMod q)‖) :=
      (Finset.mul_sum ..).symm
    _ ≤ D⁻¹ * ((6 + 8 * Real.pi) * Real.sqrt ((N + R ^ 2) * (M + R ^ 2) *
        (∑ n ∈ S, ‖a n‖ ^ 2) * ∑ n ∈ T, ‖b n‖ ^ 2)) :=
      mul_le_mul_of_nonneg_left
        (multiplicative_large_sieve_bilinear Q hR hQ0 hQR S T a b hN hM hS hT)
        (inv_nonneg.mpr hD.le)
    _ = _ := by ring

end Bounty
end

section

/- Character and coprimality factors in the actual candidate convolution. -/

open Finset Filter

namespace Bounty

theorem complex_character_coprime_convolution (S : Finset ℕ) (V : ℕ → Finset ℕ)
    (a b : ℕ → ℝ) (G : ℕ → ℂ) {d : ℕ} (χ : DirichletCharacter ℂ d) (h : ℕ) :
    (∑ p ∈ S, (a p : ℂ) * ∑ n ∈ V p, (b n : ℂ) *
      (if (p*n).Coprime h then χ (p*n : ZMod d) * G (p*n) else 0)) =
      ∑ p ∈ S.filter (fun p => p.Coprime h), (a p : ℂ) * χ (p : ZMod d) *
        ∑ n ∈ (V p).filter (fun n => n.Coprime h),
          (b n : ℂ) * χ (n : ZMod d) * G (p*n) := by
  classical
  rw [sum_filter]
  apply sum_congr rfl
  intro p _
  by_cases hp : p.Coprime h
  · rw [if_pos hp]
    rw [sum_filter, mul_sum, mul_sum]
    apply sum_congr rfl
    intro n _
    by_cases hn : n.Coprime h
    · have hpn : (p*n).Coprime h := Nat.coprime_mul_iff_left.mpr ⟨hp, hn⟩
      rw [if_pos hpn, if_pos hn, map_mul]
      ring
    · have hpn : ¬(p*n).Coprime h := fun hpn => hn (Nat.coprime_mul_iff_left.mp hpn).2
      simp only [if_neg hpn, if_neg hn, mul_zero]
  · simp only [Nat.coprime_mul_iff_left, hp, false_and, if_false, mul_zero, sum_const_zero]

theorem eventually_candidate_character_coprime_convolution {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar d h : ℕ)
      (χ : DirichletCharacter ℂ d) (G : ℕ → ℂ),
      (∑ u ∈ (arithmeticProductWindow 1 (Real.exp L)).filter (fun u => u.Coprime h),
        (candidateCoefficient c L q r jStar u : ℂ) * χ (u : ZMod d) * G u) =
      ∑ p ∈ (candidateSmallPSet c L (16 * Real.exp L + 1)).filter (fun p => p.Coprime h),
        (candidatePWeight c L q p : ℂ) * χ (p : ZMod d) *
          ∑ n ∈ (arithmeticProductWindow p (Real.exp L)).filter (fun n => n.Coprime h),
            (candidateQWeight c L r jStar n : ℂ) * χ (n : ZMod d) * G (p*n) := by
  filter_upwards [eventually_candidate_coefficient_complex_test hc] with L hL
  intro q r jStar d h χ G
  calc
    _ = ∑ u ∈ arithmeticProductWindow 1 (Real.exp L),
        (candidateCoefficient c L q r jStar u : ℂ) *
          (if u.Coprime h then χ (u : ZMod d) * G u else 0) := by
      rw [sum_filter]
      apply sum_congr rfl
      intro u _
      split_ifs <;> simp [mul_assoc]
    _ = ∑ p ∈ candidateSmallPSet c L (16 * Real.exp L + 1),
        (candidatePWeight c L q p : ℂ) * ∑ n ∈ arithmeticProductWindow p (Real.exp L),
          (candidateQWeight c L r jStar n : ℂ) *
            (if (p*n).Coprime h then χ (p*n : ZMod d) * G (p*n) else 0) :=
      by simpa only [Nat.cast_mul] using
        hL q r jStar (fun u => if u.Coprime h then χ (u : ZMod d) * G u else 0)
    _ = _ := complex_character_coprime_convolution _ _ _ _ G χ h

end Bounty

end

section

/- Exact complex-tested extraction of an actual Q-zero prime slot. -/

open Finset Filter

namespace Bounty

theorem candidate_Q_zero_complex_window_split (c L : ℝ) (r jStar : ℕ)
    (hr : 0 < r) (hj : 0 < jStar) (S : Finset ℕ) (F : ℕ → ℂ) :
    (∑ n ∈ S, (candidateQWeight c L r jStar n : ℂ) * F n) =
      ∑ p ∈ candidateQBand (c*L) 0,
        ∑ y : ∀ slot, candidateQRestChoices c L r jStar hr slot,
          if p * orderedSlotProduct (candidateQRestChoices c L r jStar hr) y ∈ S then
            (1 / (((r.factorial : ℝ)^(candidateQIndices c L).card) : ℂ)) *
              F (p * orderedSlotProduct (candidateQRestChoices c L r jStar hr) y) else 0 := by
  classical
  unfold candidateQWeight
  rw [ordered_slot_complex_window_split_finset _ (candidateFreeSlot c L r hr),
    candidate_Q_free_choice c L r jStar hr hj]
  apply sum_congr rfl
  intro p _
  apply sum_congr
  · rfl
  · intro y _
    have hp : orderedSlotProduct
        (fun j : {slot : (candidateQIndices c L) × Fin r // slot ≠ candidateFreeSlot c L r hr} =>
          candidateQSlotChoices c L r jStar j.val) y =
        orderedSlotProduct (candidateQRestChoices c L r jStar hr) y := rfl
    rw [hp]
    simp only [Complex.ofReal_pow]

theorem eventually_candidate_Q_zero_complex_convolution {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ)
      (hr : 0 < r), 0 < jStar → ∀ (F : ℕ → ℂ),
      (∑ u ∈ arithmeticProductWindow 1 (Real.exp L),
        (candidateCoefficient c L q r jStar u : ℂ) * F u) =
        ∑ a ∈ candidateSmallPSet c L (16*Real.exp L + 1),
          (candidatePWeight c L q a : ℂ) *
            ∑ p ∈ candidateQBand (c*L) 0,
              ∑ y : ∀ slot, candidateQRestChoices c L r jStar hr slot,
                if p * orderedSlotProduct (candidateQRestChoices c L r jStar hr) y ∈
                    arithmeticProductWindow a (Real.exp L) then
                  (1 / (((r.factorial : ℝ)^(candidateQIndices c L).card) : ℂ)) *
                    F (a * (p * orderedSlotProduct (candidateQRestChoices c L r jStar hr) y))
                else 0 := by
  filter_upwards [eventually_candidate_coefficient_complex_test hc] with L hL
  intro q r jStar hr hj F
  rw [hL q r jStar F]
  apply sum_congr rfl
  intro a _
  congr 1
  exact candidate_Q_zero_complex_window_split c L r jStar hr hj
    (arithmeticProductWindow a (Real.exp L)) (fun n => F (a*n))

end Bounty

end

section

/- All structural vanishing is discharged for the literal asymmetric comparison family. -/

namespace Bounty

open Finset
open scoped Classical

theorem finite_asymmetric_signed_block_envelope {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hμ : ∀ i x, 0 ≤ μ i x) (hmass : ∀ i, ∑ y, μ i y = 1)
    (active U V : Finset I) (hUV : Disjoint U V) (hμnz : ∀ i v, μ i v ≠ 0) (k : (∀ i, X i) → ℂ) (hk : ∀ x, ‖k x‖ ≤ 1)
    (F : ∀ A B : Finset I, (∀ i : ↥(active \ (A ∪ B)), X i.val) →
      (∀ i : A, X i.val) → (∀ i : B, X i.val) → ℂ)
    (f g : (∀ i, X i) → ℂ) (a b θA θB : ℝ)
    (hf : Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) f) ≤ a)
    (hg : Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) g) ≤ b)
    (hA : Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ U U.toList f)) ≤
      θA * a)
    (hB : Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ V V.toList g)) ≤
      θB * b)
    (ε : ℝ) (hε : 0 ≤ ε)
    (herr : ∀ S ∈ U.powerset, ∀ T ∈ V.powerset,
      ∀ A ∈ cleanNonemptySubsets (U \ S), ∀ B ∈ cleanNonemptySubsets (V \ T),
        ‖cleanKernelPairing (finiteProductWeight μ) (finiteAsymmetricComparisonKernel μ active F A B)
            (finiteCoordinateComponent μ S U.toList f)
            (finiteCoordinateComponent μ T V.toList g) -
          cleanRawPairing (finiteProductWeight μ) k
            (finiteCoordinateComponent μ S U.toList f)
            (finiteCoordinateComponent μ T V.toList g)‖ ≤
        ε * Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ)
          (finiteCoordinateComponent μ S U.toList f)) *
          Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ)
            (finiteCoordinateComponent μ T V.toList g))) :
    ‖cleanRawPairing (finiteProductWeight μ) k f g -
      ∑ A ∈ cleanNonemptySubsets U, ∑ B ∈ cleanNonemptySubsets V,
        (-1 : ℂ) ^ (A.card + B.card) * cleanKernelPairing (finiteProductWeight μ) (finiteAsymmetricComparisonKernel μ active F A B) f g‖ ≤
      (θA + θB + (3 : ℝ) ^ (U.card + V.card) * ε) * a * b := by
  apply finite_signed_ideal_block_envelope μ hμ hmass U V k hk
    (finiteAsymmetricComparisonKernel μ active F) f g a b θA θB hf hg hA hB
  · intro S hS T hT A hA B hB hnot
    exact finite_asymmetric_comparison_components_zero μ hmass hμnz active U V S T A B hUV
      (mem_powerset.mp hS) (mem_powerset.mp hT)
      ((clean_mem_nonempty_subsets U A).mp hA).2 ((clean_mem_nonempty_subsets V B).mp hB).2
      F f g hnot
  · exact hε
  · exact herr

end Bounty
end

section

/- The actual prime comparison kernel inherits exact coordinate annihilation. -/

open scoped BigOperators Classical

namespace Bounty

noncomputable def primeAsymmetricComparisonKernel {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ) (active : Finset I)
    (Q : ℕ) (h : ℝ) (keptA keptB : Finset I → Finset ℤ) (ζ Θ : ℝ)
    (A B : Finset I) : (∀ i, P i) → (∀ i, P i) → ℂ :=
  finiteAsymmetricComparisonKernel (physicalLabelLaw V) active
    (fun A B => primeAsymmetricValue P V (active \ (A ∪ B)) A B Q h
      (keptA A) (keptB B) ζ Θ) A B

theorem prime_asymmetric_comparison_components_zero
    {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ)
    (hV : ∀ i, 0 < V i) (hp : ∀ i p, p ∈ P i → 0 < p)
    (hmass : ∀ i, ∑ p ∈ P i, 1 / (p : ℝ) = V i)
    (active U W S T A B : Finset I) (hUW : Disjoint U W)
    (hS : S ⊆ U) (hT : T ⊆ W) (hA : A ⊆ U) (hB : B ⊆ W)
    (Q : ℕ) (h : ℝ) (keptA keptB : Finset I → Finset ℤ) (ζ Θ : ℝ)
    (f g : (∀ i, P i) → ℂ) (hnot : ¬(A ⊆ U \ S ∧ B ⊆ W \ T)) :
    cleanKernelPairing (finiteProductWeight (physicalLabelLaw V))
      (primeAsymmetricComparisonKernel P V active Q h keptA keptB ζ Θ A B)
      (finiteCoordinateComponent (physicalLabelLaw V) S U.toList f)
      (finiteCoordinateComponent (physicalLabelLaw V) T W.toList g) = 0 := by
  have hμ : ∀ i (v : P i), physicalLabelLaw V i v ≠ 0 := by
    intro i v
    unfold physicalLabelLaw
    apply div_ne_zero one_ne_zero
    apply mul_ne_zero (ne_of_gt (hV i))
    exact_mod_cast (ne_of_gt (hp i v.val v.property))
  exact finite_asymmetric_comparison_components_zero (physicalLabelLaw V)
    (fun i => physical_label_law_sum V i (hV i) (hmass i)) hμ
    active U W S T A B hUW hS hT hA hB
    (fun A B => primeAsymmetricValue P V (active \ (A ∪ B)) A B Q h
      (keptA A) (keptB B) ζ Θ) f g hnot

end Bounty
end

section

/- The actual fixed-target raw edge evaluates the continuation on its full
ledger target. Summing every physical target list then gives one bounded
endpoint phase, with the continuation unchanged. -/

open Finset
open scoped Classical
namespace Bounty

section Physical
variable {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin N → Finset (Fin J)) (k : ℤ) (L : PhysicalMarkLists P J ell)
  (H : (g : Fin N) → Finset ↥(P g))
  (q : (g : Fin N) → BoundedOrderedTuple
    (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B)
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (β : (g : Fin N) → ↥(P g) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
  (ω : ∀ _c : SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C g)), PhysicalAuxLabels P C → ℝ)
  (F : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ)

include hP hdis

theorem physical_full_fixed_edge_continuation (R : PhysicalMarkLists P J ell) :
    let n := fun g (p : ↥(P g)) => p.val
    let S := fun g => physicalFullSharedIndices (ell := ell) (C g)
    let A := fun _ : SharedActiveLabels (fun g => ↥(P g)) S => PhysicalAuxLabels P C
    let x := physicalFullMemoryState C L q
    let c := (productActiveMemorySplit S B x).1
    (∑ aux : PhysicalAuxLabels P C, (ω c aux : ℂ) *
      if physicalListAdmissible C aux L R then
        jointRawTensorCutoff B (physicalFullEdgeRawRow (B := B) C k L R β ρ V aux)
          (physicalFullContinuation C R F) (fun g => (H g, boundedOrderedTupleToFinite (q g))) else 0) =
    ∑ e : PhysicalFullEdgeEvent C k x,
      (fullActiveEdgeEventWeight n S B A (physicalFullEdgeDelta C k) (physicalFullEdgeD C)
        ω (fun g p => β g p / V g) ρ V x e : ℂ) * physicalFullEdgePhase C k L R H q e *
      F (fullEdgeLedgerUpdate n S B A (physicalFullEdgeDelta C k) (physicalFullEdgeD C) H x e,
        fullActiveEdgeEventTarget n S B A (physicalFullEdgeDelta C k) (physicalFullEdgeD C) x e) := by
  have h := physical_full_edge_auxiliary_rows C k L R H q hP hdis β ρ V ω
    (physicalFullContinuation C R F)
  refine h.trans ?_
  apply sum_congr rfl
  intro e _
  exact physical_full_edge_continuation_weighted C k L R H q ω (fun g p => β g p / V g) ρ V e F

theorem physical_full_all_endpoints_edge_continuation :
    let n := fun g (p : ↥(P g)) => p.val
    let S := fun g => physicalFullSharedIndices (ell := ell) (C g)
    let A := fun _ : SharedActiveLabels (fun g => ↥(P g)) S => PhysicalAuxLabels P C
    let x := physicalFullMemoryState C L q
    let c := (productActiveMemorySplit S B x).1
    (∑ R : PhysicalMarkLists P J ell, ∑ aux : PhysicalAuxLabels P C, (ω c aux : ℂ) *
      if physicalListAdmissible C aux L R then
        jointRawTensorCutoff B (physicalFullEdgeRawRow (B := B) C k L R β ρ V aux)
          (physicalFullContinuation C R F) (fun g => (H g, boundedOrderedTupleToFinite (q g))) else 0) =
    ∑ e : PhysicalFullEdgeEvent C k x,
      (fullActiveEdgeEventWeight n S B A (physicalFullEdgeDelta C k) (physicalFullEdgeD C)
        ω (fun g p => β g p / V g) ρ V x e : ℂ) *
      physicalFullEndpointPhase C k L H q ω (fun g p => β g p / V g) ρ V e *
      F (fullEdgeLedgerUpdate n S B A (physicalFullEdgeDelta C k) (physicalFullEdgeD C) H x e,
        fullActiveEdgeEventTarget n S B A (physicalFullEdgeDelta C k) (physicalFullEdgeD C) x e) := by
  dsimp only
  simp_rw [physical_full_fixed_edge_continuation C k L H q hP hdis β ρ V ω F]
  rw [sum_comm]
  apply sum_congr rfl
  intro e _
  rw [← sum_mul, ← physical_full_endpoint_phase_weighted]

end Physical
end Bounty
end

section

/- Supported joint ghost events transport between total-memory caps.
The comparison preserves signed coefficients and arbitrary event observables. -/

open Finset Classical

namespace Bounty

section

variable {G : Type*} {P Z : G → Type*} {t : G → ℕ} {b B : ℕ} (h : b ≤ B)

def coupledGhostEventCapEmbed (s : ProductBoundedOrderedState P Z t b)
    (e : CoupledGhostEvent t b s) : CoupledGhostEvent t B (productStateCapEmbed h s) :=
  fun g => boundedGhostEventCapEmbed h (s g) (e g)

theorem coupledGhostEventCapEmbed_injective (s : ProductBoundedOrderedState P Z t b) :
    Function.Injective (coupledGhostEventCapEmbed h s) := by
  intro e f hef
  funext g
  exact boundedGhostEventCapEmbed_injective h (s g) (congrFun hef g)

theorem coupledGhostJointEventWeight_support [Fintype G]
    (A D C ν : ∀ g, Z g → ℝ) (s : ProductBoundedOrderedState P Z t b)
    (e : CoupledGhostEvent t b s)
    (hw : coupledGhostJointEventWeight A D C ν t b s e ≠ 0) :
    (productTotalMemory s ≤ b ∧ productTotalMemory (coupledGhostJointEventTarget t b s e) ≤ b) ∧
      ∀ g, boundedGhostEventWeight (A g) (D g) (C g) (ν g) (t g) b (s g) (e g) ≠ 0 := by
  unfold coupledGhostJointEventWeight at hw
  split_ifs at hw with hc
  · exact ⟨hc, fun g => (prod_ne_zero_iff.mp hw) g (mem_univ g)⟩
  · exact False.elim (hw rfl)

theorem coupledGhostEventCapEmbed_target_of_local_ne_zero
    (A D C ν : ∀ g, Z g → ℝ) (s : ProductBoundedOrderedState P Z t b)
    (e : CoupledGhostEvent t b s)
    (hw : ∀ g, boundedGhostEventWeight (A g) (D g) (C g) (ν g) (t g) b (s g) (e g) ≠ 0) :
    coupledGhostJointEventTarget t B (productStateCapEmbed h s) (coupledGhostEventCapEmbed h s e) =
      productStateCapEmbed h (coupledGhostJointEventTarget t b s e) := by
  funext g
  exact boundedGhostEventCapEmbed_target_of_ne_zero h (A g) (D g) (C g) (ν g) (s g) (e g) (hw g)

theorem coupledGhostEventCapEmbed_target_of_ne_zero [Fintype G]
    (A D C ν : ∀ g, Z g → ℝ) (s : ProductBoundedOrderedState P Z t b)
    (e : CoupledGhostEvent t b s)
    (hw : coupledGhostJointEventWeight A D C ν t b s e ≠ 0) :
    coupledGhostJointEventTarget t B (productStateCapEmbed h s) (coupledGhostEventCapEmbed h s e) =
      productStateCapEmbed h (coupledGhostJointEventTarget t b s e) := by
  exact coupledGhostEventCapEmbed_target_of_local_ne_zero h A D C ν s e
    (coupledGhostJointEventWeight_support A D C ν s e hw).2

theorem coupledGhostEventCapEmbed_weight_of_ne_zero [Fintype G]
    (A D C ν : ∀ g, Z g → ℝ) (s : ProductBoundedOrderedState P Z t b)
    (e : CoupledGhostEvent t b s)
    (hw : coupledGhostJointEventWeight A D C ν t b s e ≠ 0) :
    coupledGhostJointEventWeight A D C ν t B (productStateCapEmbed h s) (coupledGhostEventCapEmbed h s e) =
      coupledGhostJointEventWeight A D C ν t b s e := by
  obtain ⟨hc, hl⟩ := coupledGhostJointEventWeight_support A D C ν s e hw
  have ht := coupledGhostEventCapEmbed_target_of_ne_zero h A D C ν s e hw
  unfold coupledGhostJointEventWeight
  rw [ht, productStateCapEmbed_totalMemory, productStateCapEmbed_totalMemory,
    if_pos ⟨hc.1.trans h, hc.2.trans h⟩, if_pos hc]
  apply prod_congr rfl
  intro g _
  exact boundedGhostEventCapEmbed_weight_of_ne_zero h (A g) (D g) (C g) (ν g) (s g) (e g) (hl g)

theorem coupledGhostEventCapEmbed_small_weight_of_large_ne_zero [Fintype G]
    (A D C ν : ∀ g, Z g → ℝ) (s : ProductBoundedOrderedState P Z t b)
    (hs : productTotalMemory s ≤ b) (e : CoupledGhostEvent t b s)
    (hw : coupledGhostJointEventWeight A D C ν t B (productStateCapEmbed h s)
      (coupledGhostEventCapEmbed h s e) ≠ 0)
    (ht : productTotalMemory (coupledGhostJointEventTarget t B (productStateCapEmbed h s)
      (coupledGhostEventCapEmbed h s e)) ≤ b) :
    coupledGhostJointEventWeight A D C ν t b s e =
      coupledGhostJointEventWeight A D C ν t B (productStateCapEmbed h s) (coupledGhostEventCapEmbed h s e) := by
  obtain ⟨hc, hl⟩ := coupledGhostJointEventWeight_support A D C ν
    (productStateCapEmbed h s) (coupledGhostEventCapEmbed h s e) hw
  have htlocal : ∀ g, (boundedGhostEventTarget (t g) B (boundedStateCapEmbed h (s g))
      (boundedGhostEventCapEmbed h (s g) (e g))).2.1.val ≤ b := by
    intro g
    exact (single_le_sum (fun j _ => Nat.zero_le _) (mem_univ g)).trans ht
  have hsmall : ∀ g, boundedGhostEventWeight (A g) (D g) (C g) (ν g) (t g) b (s g) (e g) ≠ 0 := by
    intro g
    exact (boundedGhostEventCapEmbed_support h (A g) (D g) (C g) (ν g) (s g) (e g)).mpr ⟨hl g, htlocal g⟩
  have htarget := coupledGhostEventCapEmbed_target_of_local_ne_zero h A D C ν s e hsmall
  have htsmall : productTotalMemory (coupledGhostJointEventTarget t b s e) ≤ b := by
    rw [htarget, productStateCapEmbed_totalMemory] at ht
    exact ht
  unfold coupledGhostJointEventWeight
  rw [if_pos ⟨hs, htsmall⟩, if_pos hc]
  apply prod_congr rfl
  intro g _
  exact (boundedGhostEventCapEmbed_weight_of_ne_zero h (A g) (D g) (C g) (ν g) (s g) (e g) (hsmall g)).symm

theorem coupledGhostEventCapEmbed_surjective_of_ne_zero [Fintype G]
    (A D C ν : ∀ g, Z g → ℝ) (s : ProductBoundedOrderedState P Z t b)
    (e : CoupledGhostEvent t B (productStateCapEmbed h s))
    (hw : coupledGhostJointEventWeight A D C ν t B (productStateCapEmbed h s) e ≠ 0)
    (ht : productTotalMemory (coupledGhostJointEventTarget t B (productStateCapEmbed h s) e) ≤ b) :
    ∃ d : CoupledGhostEvent t b s, coupledGhostEventCapEmbed h s d = e := by
  have hl := (coupledGhostJointEventWeight_support A D C ν (productStateCapEmbed h s) e hw).2
  have hd : ∀ g, ∃ d : BoundedGhostEvent (t g) b (s g), boundedGhostEventCapEmbed h (s g) d = e g := by
    intro g
    apply boundedGhostEventCapEmbed_surjective_of_ne_zero h (A g) (D g) (C g) (ν g) (s g) (e g) (hl g)
    exact (single_le_sum (fun j _ => Nat.zero_le _) (mem_univ g)).trans ht
  choose d hd using hd
  exact ⟨d, funext hd⟩

theorem coupledGhostEventCapEmbed_weight [Fintype G]
    (A D C ν : ∀ g, Z g → ℝ) (s : ProductBoundedOrderedState P Z t b)
    (hs : productTotalMemory s ≤ b) (e : CoupledGhostEvent t b s) :
    coupledGhostJointEventWeight A D C ν t b s e =
      if productTotalMemory (coupledGhostJointEventTarget t B (productStateCapEmbed h s)
          (coupledGhostEventCapEmbed h s e)) ≤ b then
        coupledGhostJointEventWeight A D C ν t B (productStateCapEmbed h s)
          (coupledGhostEventCapEmbed h s e)
      else 0 := by
  by_cases ht : productTotalMemory (coupledGhostJointEventTarget t B (productStateCapEmbed h s)
      (coupledGhostEventCapEmbed h s e)) ≤ b
  · rw [if_pos ht]
    by_cases hw : coupledGhostJointEventWeight A D C ν t B (productStateCapEmbed h s)
        (coupledGhostEventCapEmbed h s e) = 0
    · rw [hw]
      by_contra hwsmall
      exact hwsmall ((coupledGhostEventCapEmbed_weight_of_ne_zero h A D C ν s e hwsmall).symm.trans hw)
    · exact coupledGhostEventCapEmbed_small_weight_of_large_ne_zero h A D C ν s hs e hw ht
  · rw [if_neg ht]
    by_contra hwsmall
    have htarget := coupledGhostEventCapEmbed_target_of_ne_zero h A D C ν s e hwsmall
    apply ht
    rw [htarget, productStateCapEmbed_totalMemory]
    exact (coupledGhostJointEventWeight_support A D C ν s e hwsmall).1.2

theorem coupledGhostEventCapEmbed_support [Fintype G]
    (A D C ν : ∀ g, Z g → ℝ) (s : ProductBoundedOrderedState P Z t b)
    (hs : productTotalMemory s ≤ b) (e : CoupledGhostEvent t b s) :
    coupledGhostJointEventWeight A D C ν t b s e ≠ 0 ↔
      coupledGhostJointEventWeight A D C ν t B (productStateCapEmbed h s)
        (coupledGhostEventCapEmbed h s e) ≠ 0 ∧
      productTotalMemory (coupledGhostJointEventTarget t B (productStateCapEmbed h s)
        (coupledGhostEventCapEmbed h s e)) ≤ b := by
  rw [coupledGhostEventCapEmbed_weight h A D C ν s hs e]
  split_ifs <;> simp_all

noncomputable def coupledGhostEventCapSupportEquiv [Fintype G]
    (A D C ν : ∀ g, Z g → ℝ) (s : ProductBoundedOrderedState P Z t b)
    (hs : productTotalMemory s ≤ b) :
    {e : CoupledGhostEvent t b s // coupledGhostJointEventWeight A D C ν t b s e ≠ 0} ≃
    {e : CoupledGhostEvent t B (productStateCapEmbed h s) //
      coupledGhostJointEventWeight A D C ν t B (productStateCapEmbed h s) e ≠ 0 ∧
      productTotalMemory (coupledGhostJointEventTarget t B (productStateCapEmbed h s) e) ≤ b} :=
  Equiv.ofBijective (fun e => ⟨coupledGhostEventCapEmbed h s e.val,
    (coupledGhostEventCapEmbed_support h A D C ν s hs e.val).mp e.property⟩) ⟨by
      intro e f hef
      apply Subtype.ext
      exact coupledGhostEventCapEmbed_injective h s (congrArg Subtype.val hef), by
    intro e
    obtain ⟨d, hd⟩ := coupledGhostEventCapEmbed_surjective_of_ne_zero h A D C ν s e.val
      e.property.1 e.property.2
    have hw := (coupledGhostEventCapEmbed_support h A D C ν s hs d).mpr (by simpa only [hd] using e.property)
    exact ⟨⟨d, hw⟩, Subtype.ext hd⟩⟩

theorem coupled_ghost_event_cap_sum [Fintype G] [∀ g, Fintype (Z g)]
    (A D C ν : ∀ g, Z g → ℝ) (s : ProductBoundedOrderedState P Z t b)
    (hs : productTotalMemory s ≤ b)
    (F : CoupledGhostEvent t B (productStateCapEmbed h s) → ℂ) :
    (∑ e : CoupledGhostEvent t b s,
      (coupledGhostJointEventWeight A D C ν t b s e : ℂ) * F (coupledGhostEventCapEmbed h s e)) =
    ∑ e : CoupledGhostEvent t B (productStateCapEmbed h s),
      if productTotalMemory (coupledGhostJointEventTarget t B (productStateCapEmbed h s) e) ≤ b then
        (coupledGhostJointEventWeight A D C ν t B (productStateCapEmbed h s) e : ℂ) * F e
      else 0 := by
  apply Fintype.sum_of_injective (coupledGhostEventCapEmbed h s)
    (coupledGhostEventCapEmbed_injective h s)
  · intro e he
    by_cases ht : productTotalMemory (coupledGhostJointEventTarget t B (productStateCapEmbed h s) e) ≤ b
    · have hw : coupledGhostJointEventWeight A D C ν t B (productStateCapEmbed h s) e = 0 := by
        by_contra hw
        exact he (coupledGhostEventCapEmbed_surjective_of_ne_zero h A D C ν s e hw ht)
      simp [ht, hw]
    · simp [ht]
  · intro e
    rw [coupledGhostEventCapEmbed_weight h A D C ν s hs e]
    split_ifs <;> simp

theorem coupled_ghost_event_cap_target_sum [Fintype G] [∀ g, Fintype (Z g)]
    (A D C ν : ∀ g, Z g → ℝ) (s : ProductBoundedOrderedState P Z t b)
    (hs : productTotalMemory s ≤ b)
    (F : CoupledGhostEvent t B (productStateCapEmbed h s) → ProductBoundedOrderedState P Z t B → ℂ) :
    (∑ e : CoupledGhostEvent t b s,
      (coupledGhostJointEventWeight A D C ν t b s e : ℂ) *
        F (coupledGhostEventCapEmbed h s e) (productStateCapEmbed h (coupledGhostJointEventTarget t b s e))) =
    ∑ e : CoupledGhostEvent t B (productStateCapEmbed h s),
      if productTotalMemory (coupledGhostJointEventTarget t B (productStateCapEmbed h s) e) ≤ b then
        (coupledGhostJointEventWeight A D C ν t B (productStateCapEmbed h s) e : ℂ) *
          F e (coupledGhostJointEventTarget t B (productStateCapEmbed h s) e)
      else 0 := by
  refine Eq.trans ?_ (coupled_ghost_event_cap_sum h A D C ν s hs
    (fun e => F e (coupledGhostJointEventTarget t B (productStateCapEmbed h s) e)))
  apply sum_congr rfl
  intro e _
  by_cases hw : coupledGhostJointEventWeight A D C ν t b s e = 0
  · simp only [hw, Complex.ofReal_zero, zero_mul]
  · rw [coupledGhostEventCapEmbed_target_of_ne_zero h A D C ν s e hw]

end

end Bounty
end

section

/- Simultaneous edge transport across memory caps. The source total cap is
explicit. The smaller coefficient is the larger one restricted by the
larger event's output total, with no condition on signs or positivity. -/

open Finset Classical

namespace Bounty

def unrestrictedJointEventCapEquiv {G : Type*} {P : G → Type*}
    (n : ∀ g, P g → ℕ) (Δ D : G → ℤ) (t : G → ℕ) {b B : ℕ} (h : b ≤ B)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t b) :
    UnrestrictedJointEvent n Δ D t b s ≃
      UnrestrictedJointEvent n Δ D t B (productStateCapEmbed h s) := Equiv.refl _

theorem unrestrictedJointEventCapEquiv_apply {G : Type*} {P : G → Type*}
    (n : ∀ g, P g → ℕ) (Δ D : G → ℤ) (t : G → ℕ) {b B : ℕ} (h : b ≤ B)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t b)
    (e : UnrestrictedJointEvent n Δ D t b s) :
    unrestrictedJointEventCapEquiv n Δ D t h s e = e := rfl

theorem unrestrictedJointEventTarget_cap_of_local_weights {G : Type*} {P : G → Type*}
    (n : ∀ g, P g → ℕ) (Δ D : G → ℤ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (t : G → ℕ) {b B : ℕ} (h : b ≤ B)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t b)
    (e : UnrestrictedJointEvent n Δ D t b s)
    (hw : ∀ g, unrestrictedBoundedEventWeight (n g) (Δ g) (D g) (μ g) ρ (V g)
      (t g) b (s g) (e g) ≠ 0) :
    productStateCapEmbed h (unrestrictedJointEventTarget n Δ D t b s e) =
      unrestrictedJointEventTarget n Δ D t B (productStateCapEmbed h s)
        (unrestrictedJointEventCapEquiv n Δ D t h s e) := by
  funext g
  exact unrestrictedBoundedEventTarget_cap_of_weight_ne_zero (n g) (Δ g) (D g) (μ g)
    ρ (V g) (t g) h (s g) (e g) (hw g)

theorem unrestrictedJointEventTarget_cap_of_weight_ne_zero {G : Type*} [Fintype G]
    {P : G → Type*} (n : ∀ g, P g → ℕ) (Δ D : G → ℤ)
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ) (t : G → ℕ) {b B : ℕ} (h : b ≤ B)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t b)
    (e : UnrestrictedJointEvent n Δ D t b s)
    (hw : unrestrictedJointCutoffEventWeight n Δ D μ ρ V t b s e ≠ 0) :
    productStateCapEmbed h (unrestrictedJointEventTarget n Δ D t b s e) =
      unrestrictedJointEventTarget n Δ D t B (productStateCapEmbed h s)
        (unrestrictedJointEventCapEquiv n Δ D t h s e) := by
  apply unrestrictedJointEventTarget_cap_of_local_weights n Δ D μ ρ V t h s e
  have hp : (∏ g, unrestrictedBoundedEventWeight (n g) (Δ g) (D g) (μ g) ρ (V g)
      (t g) b (s g) (e g)) ≠ 0 := by
    intro hz
    exact hw (by simp only [unrestrictedJointCutoffEventWeight, hz, ite_self])
  intro g
  exact (prod_ne_zero_iff.mp hp) g (mem_univ g)

theorem unrestrictedJointCutoffEventWeight_cap {G : Type*} [Fintype G]
    {P : G → Type*} (n : ∀ g, P g → ℕ) (Δ D : G → ℤ)
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ) (t : G → ℕ) {b B : ℕ} (h : b ≤ B)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t b)
    (hs : productTotalMemory s ≤ b) (e : UnrestrictedJointEvent n Δ D t b s) :
    unrestrictedJointCutoffEventWeight n Δ D μ ρ V t b s e =
      if productTotalMemory (unrestrictedJointEventTarget n Δ D t B (productStateCapEmbed h s)
          (unrestrictedJointEventCapEquiv n Δ D t h s e)) ≤ b
      then unrestrictedJointCutoffEventWeight n Δ D μ ρ V t B (productStateCapEmbed h s)
        (unrestrictedJointEventCapEquiv n Δ D t h s e)
      else 0 := by
  have hsB : productTotalMemory (productStateCapEmbed h s) ≤ B := hs.trans h
  by_cases ht : productTotalMemory (unrestrictedJointEventTarget n Δ D t B (productStateCapEmbed h s)
      (unrestrictedJointEventCapEquiv n Δ D t h s e)) ≤ b
  · rw [if_pos ht]
    have hw (g : G) :
        unrestrictedBoundedEventWeight (n g) (Δ g) (D g) (μ g) ρ (V g) (t g) b (s g) (e g) =
        unrestrictedBoundedEventWeight (n g) (Δ g) (D g) (μ g) ρ (V g) (t g) B
          (boundedStateCapEmbed h (s g)) (unrestrictedBoundedEventCapEquiv (n g) (Δ g) (D g) (t g) h (s g) (e g)) := by
      rw [unrestrictedBoundedEventWeight_cap (n g) (Δ g) (D g) (μ g) ρ (V g) (t g) h (s g) (e g)]
      apply if_pos
      apply le_trans _ ht
      exact single_le_sum
        (f := fun j => (unrestrictedJointEventTarget n Δ D t B (productStateCapEmbed h s)
          (unrestrictedJointEventCapEquiv n Δ D t h s e) j).2.1.val)
        (fun _ _ => Nat.zero_le _) (mem_univ g)
    have hp := prod_congr (s₁ := (univ : Finset G)) rfl (fun g _ => hw g)
    by_cases hz : (∏ g, unrestrictedBoundedEventWeight (n g) (Δ g) (D g) (μ g) ρ (V g)
        (t g) b (s g) (e g)) = 0
    · have hzB : (∏ g, unrestrictedBoundedEventWeight (n g) (Δ g) (D g) (μ g) ρ (V g)
          (t g) B (productStateCapEmbed h s g)
          (unrestrictedJointEventCapEquiv n Δ D t h s e g)) = 0 := hp.symm.trans hz
      simp only [unrestrictedJointCutoffEventWeight, hz, hzB, ite_self]
    · have htarget := unrestrictedJointEventTarget_cap_of_local_weights n Δ D μ ρ V t h s e
        (fun g => (prod_ne_zero_iff.mp hz) g (mem_univ g))
      have hsmall : productTotalMemory (unrestrictedJointEventTarget n Δ D t b s e) ≤ b := by
        have he := congrArg productTotalMemory htarget
        exact he.trans_le ht
      have htB := ht.trans h
      simp only [unrestrictedJointCutoffEventWeight, hs, hsB, hsmall, htB, and_self, if_true]
      exact hp
  · rw [if_neg ht]
    by_contra hw
    have he := unrestrictedJointEventTarget_cap_of_weight_ne_zero n Δ D μ ρ V t h s e hw
    have hsmall : productTotalMemory (unrestrictedJointEventTarget n Δ D t b s e) ≤ b := by
      by_contra hn
      exact hw (by simp only [unrestrictedJointCutoffEventWeight, hn, and_false, if_false])
    apply ht
    rw [← he, productStateCapEmbed_totalMemory]
    exact hsmall

end Bounty
end

section

/- Exact removal of zero-weight event paths in arbitrary phased sums. -/

open Finset Classical

namespace Bounty

universe uK uX uE

noncomputable abbrev finiteNonzeroEventFintype {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) [∀ k x, Fintype (E k x)]
    (w : ∀ k x, E k x → ℝ) (k : K) (x : X) : Fintype (FiniteNonzeroEvent E w k x) :=
  inferInstance

theorem finite_nonzero_path_forget_injective {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (ks : List K) (x : X) : Function.Injective (finiteNonzeroPathForget E t w ks x) := by
  intro p q hpq
  apply (finiteNonzeroPathEquiv E t w ks x).injective
  exact Subtype.ext hpq

theorem finite_event_path_action_nonzero {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) [∀ k x, Fintype (E k x)]
    (t : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (ks : List K) (phase : ∀ x, FiniteEventPath E t ks x → ℂ)
    (f : X → ℂ) (x : X) :
    let _ : ∀ k x, Fintype (FiniteNonzeroEvent E w k x) := finiteNonzeroEventFintype E w
    finiteEventPathAction E t w ks phase f x =
      finiteEventPathAction (FiniteNonzeroEvent E w) (finiteNonzeroTarget E t w)
        (fun k x a => w k x a.val) ks
        (fun x p => phase x (finiteNonzeroPathForget E t w ks x p)) f x := by
  let _ : ∀ k x, Fintype (FiniteNonzeroEvent E w k x) := finiteNonzeroEventFintype E w
  let _ := finiteEventPathFintype E t ks x
  let _ := finiteEventPathFintype (FiniteNonzeroEvent E w) (finiteNonzeroTarget E t w) ks x
  have h := Fintype.sum_of_injective (finiteNonzeroPathForget E t w ks x)
    (finite_nonzero_path_forget_injective E t w ks x)
    (fun p => (finiteEventPathWeight (FiniteNonzeroEvent E w) (finiteNonzeroTarget E t w)
      (fun k x a => w k x a.val) ks x p : ℂ) *
      phase x (finiteNonzeroPathForget E t w ks x p) *
      f (finiteEventPathTerminal (FiniteNonzeroEvent E w) (finiteNonzeroTarget E t w) ks x p))
    (fun p => (finiteEventPathWeight E t w ks x p : ℂ) * phase x p *
      f (finiteEventPathTerminal E t ks x p))
    (by
      intro p hp
      have hw : finiteEventPathWeight E t w ks x p = 0 := by
        by_contra hne
        exact hp ⟨finiteNonzeroPathLift E t w ks x p hne,
          finite_nonzero_path_forget_lift E t w ks x p hne⟩
      simp only [hw, Complex.ofReal_zero, zero_mul])
    (by
      intro p
      rw [finite_nonzero_path_weight, finite_nonzero_path_terminal])
  exact h.symm

end Bounty
end

section

/- Exact restriction of arbitrary phased sums to selected events. -/

open Finset Classical

namespace Bounty

universe uK uX uE

noncomputable abbrev finiteSelectedEventFintype {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) [∀ k x, Fintype (E k x)]
    (Q : ∀ k x, E k x → Prop) (k : K) (x : X) : Fintype (FiniteSelectedEvent E Q k x) :=
  inferInstance

theorem finite_selected_path_forget_injective {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X) (Q : ∀ k x, E k x → Prop)
    (ks : List K) (x : X) : Function.Injective (finiteSelectedPathForget E t Q ks x) := by
  intro p q hpq
  apply (finiteSelectedPathEquiv E t Q ks x).injective
  exact Subtype.ext hpq

theorem finite_event_path_action_selected {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) [∀ k x, Fintype (E k x)]
    (t : ∀ k x, E k x → X) (Q : ∀ k x, E k x → Prop)
    (w : ∀ k x, E k x → ℝ) (ks : List K) (phase : ∀ x, FiniteEventPath E t ks x → ℂ)
    (f : X → ℂ) (x : X) :
    let _ : ∀ k x, Fintype (FiniteSelectedEvent E Q k x) := finiteSelectedEventFintype E Q
    finiteEventPathAction E t w ks
        (fun x p => if FiniteEventPathSelected E t Q ks x p then phase x p else 0) f x =
      finiteEventPathAction (FiniteSelectedEvent E Q) (finiteSelectedTarget E t Q)
        (fun k x a => w k x a.val) ks
        (fun x p => phase x (finiteSelectedPathForget E t Q ks x p)) f x := by
  let _ : ∀ k x, Fintype (FiniteSelectedEvent E Q k x) := finiteSelectedEventFintype E Q
  let _ := finiteEventPathFintype E t ks x
  let _ := finiteEventPathFintype (FiniteSelectedEvent E Q) (finiteSelectedTarget E t Q) ks x
  have h := Fintype.sum_of_injective (finiteSelectedPathForget E t Q ks x)
    (finite_selected_path_forget_injective E t Q ks x)
    (fun p => (finiteEventPathWeight (FiniteSelectedEvent E Q) (finiteSelectedTarget E t Q)
      (fun k x a => w k x a.val) ks x p : ℂ) *
      phase x (finiteSelectedPathForget E t Q ks x p) *
      f (finiteEventPathTerminal (FiniteSelectedEvent E Q) (finiteSelectedTarget E t Q) ks x p))
    (fun p => (finiteEventPathWeight E t w ks x p : ℂ) *
      (if FiniteEventPathSelected E t Q ks x p then phase x p else 0) *
      f (finiteEventPathTerminal E t ks x p))
    (by
      intro p hp
      have hn : ¬ FiniteEventPathSelected E t Q ks x p := by
        intro hsel
        exact hp ⟨finiteSelectedPathLift E t Q ks x p hsel,
          finite_selected_path_forget_lift E t Q ks x p hsel⟩
      simp only [if_neg hn, mul_zero, zero_mul])
    (by
      intro p
      rw [if_pos (finite_selected_path_selected E t Q ks x p),
        finite_selected_path_weight, finite_selected_path_terminal])
  exact h.symm

end Bounty
end

section

/- Eventual arbitrary-test comparison with actual retained prime-product kernels. -/

open Filter
open scoped BigOperators Classical

universe u

namespace Bounty

theorem eventually_prime_arbitrary_test_comparison
    (hZ : PrimitiveZeroFreeHalfPlane) (c κ s z v B : ℝ)
    (hc : 0 < c) (hκ : 0 ≤ κ) (hs : 0 ≤ s) (hz : 0 ≤ z) (hB : 0 ≤ B) :
    let A := B + 2 * (s + 1)
    let q := 2 * κ + (s + 1) + 2 * A + 3
    let w := 4 * q + max z q + A + 2
    let x := (s + w + 2) + 2 * A + 2
    ∀ᶠ L : ℝ in atTop,
    let Q := ⌊L ^ q⌋₊
    let h := L ^ (-w)
    let ξ := L ^ (-x)
    ∀ {I J : Type u} [Fintype I] [DecidableEq I] [Fintype J] [DecidableEq J],
    ∀ (P : I → Finset ℕ) (V : I → ℝ) (i : I)
      (R : J → Finset ℕ) (W : J → ℝ) (j : J),
    (∀ k, 0 < V k) → (∀ k, 0 < W k) →
    (∀ k p, p ∈ P k → p.Prime ∧ Q < p) →
    (∀ k p, p ∈ R k → p.Prime ∧ Q < p) →
    (∀ k, ∑ p ∈ P k, 1 / (p : ℝ) = V k) →
    (∀ k, ∑ p ∈ R k, 1 / (p : ℝ) = W k) →
    L ^ (-v) ≤ V i → L ^ (-v) ≤ W j →
    ∀ a b a' b' : ℝ, P i = primeBand a b → R j = primeBand a' b' →
    Real.exp (L ^ c) ≤ a → 0 ≤ b → Real.exp (L ^ c) ≤ a' → 0 ≤ b' →
    (∀ t : (∀ k, P k), Real.log (∏ k, (t k).val : ℕ) ≤ L ^ s) →
    (∀ t : (∀ k, R k), Real.log (∏ k, (t k).val : ℕ) ≤ L ^ s) →
    (∀ m : ℕ, (∑ t ∈ Finset.univ.filter (fun t : (∀ k, P k) => (∏ k, (t k).val : ℕ) = m),
      finiteProductWeight (physicalLabelLaw V) t) ≤ L ^ κ / (m : ℝ)) →
    (∀ m : ℕ, (∑ t ∈ Finset.univ.filter (fun t : (∀ k, R k) => (∏ k, (t k).val : ℕ) = m),
      finiteProductWeight (physicalLabelLaw W) t) ≤ L ^ κ / (m : ℝ)) →
    ∀ (f : (∀ k, P k) → ℂ) (g : (∀ k, R k) → ℂ),
    ∀ α ζ : ℝ, |ζ| ≤ L ^ z →
    let μ := finiteProductWeight (physicalLabelLaw (P := P) V)
    let ν := finiteProductWeight (physicalLabelLaw (P := R) W)
    let KA := primeProductIdealKernel P V Q h (primeProductRetainedCells P V h ξ)
    let KB := primeProductIdealKernel R W Q h (primeProductRetainedCells R W h ξ)
    let phase := fun (t : ∀ k, P k) (r : ∀ k, R k) => Complex.exp (Complex.I *
      (ζ * Real.log (((∏ k, (t k).val : ℕ) : ℝ) * (∏ k, (r k).val : ℕ)) +
        2 * Real.pi * (α * (((∏ k, (t k).val : ℕ) : ℝ) * (∏ k, (r k).val : ℕ))) : ℝ))
    ‖∑ t, ∑ r, ((μ t * ν r : ℝ) : ℂ) *
      ((phase t r - finiteTwoKernelAverage μ ν KA KB t r phase) * f t * g r)‖ ≤
      L ^ (-B) * Real.sqrt ((∑ t, μ t * ‖f t‖ ^ 2) * ∑ r, ν r * ‖g r‖ ^ 2) := by
  intro A q w x
  let n := s + w + 2
  let d := q + A + 2
  have hA : 0 ≤ A := by dsimp only [A]; positivity
  have hq : 0 ≤ q := by dsimp only [q]; positivity
  have hw : 1 ≤ w := by
    have hmax : 0 ≤ max z q := hz.trans (le_max_left _ _)
    dsimp only [w]
    linarith
  have hd : 0 ≤ d := by dsimp only [d]; positivity
  obtain ⟨CM, CE, hCM, hCE, hbound⟩ := prime_all_frequency_dyadic_pairing.{u} hZ
  filter_upwards [eventually_ge_atTop (512 : ℝ),
    eventually_prime_kernel_error_and_energy_small c CM q v x d hc hCM hd,
    eventually_prime_kernel_error_and_energy_small c CE q v x d hc hCE hd,
    eventually_prime_band_product_scale.{u} hc q] with L hL hM hE hprod
  intro Q h ξ I J _ _ _ _ P V i R W j hV hW hP hR hVP hWR hVi hWj
    a b a' b' hPi hRj ha hb ha' hb' hmaxP hmaxR hμatom hνatom f g α ζ hζ
  let μ := finiteProductWeight (physicalLabelLaw (P := P) V)
  let ν := finiteProductWeight (physicalLabelLaw (P := R) W)
  let π := fun t : ∀ k, P k => (∏ k, (t k).val : ℕ)
  let τ := fun t : ∀ k, R k => (∏ k, (t k).val : ℕ)
  let KA := primeProductIdealKernel P V Q h (primeProductRetainedCells P V h ξ)
  let KB := primeProductIdealKernel R W Q h (primeProductRetainedCells R W h ξ)
  let phase := fun (t : ∀ k, P k) (r : ∀ k, R k) => Complex.exp (Complex.I *
    (ζ * Real.log ((π t : ℝ) * τ r) + 2 * Real.pi * (α * ((π t : ℝ) * τ r)) : ℝ))
  let K := fun t r => phase t r - finiteTwoKernelAverage μ ν KA KB t r phase
  have hL0 : 0 < L := by linarith
  have hL1 : 1 ≤ L := by linarith
  have hQ : 0 < Q := Nat.floor_pos.mpr (Real.one_le_rpow hL1 hq)
  have hQb : (Q : ℝ) ≤ L ^ q := Nat.floor_le (Real.rpow_pos_of_pos hL0 q).le
  have hh : 0 < h := Real.rpow_pos_of_pos hL0 _
  have hξ : 0 < ξ := Real.rpow_pos_of_pos hL0 _
  have hh2 : h ≤ Real.log 2 := polynomial_width_le_log_two (by linarith) hw
  have ha2 : 2 ≤ a := by
    have he : 2 ≤ Real.exp (L ^ c) := by
      calc
        2 ≤ Real.exp 1 := by linarith [Real.add_one_le_exp (1 : ℝ)]
        _ ≤ Real.exp (L ^ c) := Real.exp_le_exp.mpr (Real.one_le_rpow hL1 hc.le)
    exact he.trans ha
  have ha2' : 2 ≤ a' := by
    have he : 2 ≤ Real.exp (L ^ c) := by
      calc
        2 ≤ Real.exp 1 := by linarith [Real.add_one_le_exp (1 : ℝ)]
        _ ≤ Real.exp (L ^ c) := Real.exp_le_exp.mpr (Real.one_le_rpow hL1 hc.le)
    exact he.trans ha'
  have hμ (t : ∀ k, P k) : 0 ≤ μ t :=
    Finset.prod_nonneg (fun k _ => physical_label_law_nonneg V (fun k => (hV k).le) k (t k))
  have hν (t : ∀ k, R k) : 0 ≤ ν t :=
    Finset.prod_nonneg (fun k _ => physical_label_law_nonneg W (fun k => (hW k).le) k (t k))
  have hπ (t : ∀ k, P k) : 0 < π t :=
    Finset.prod_pos (fun k _ => (hP k (t k).val (t k).property).1.pos)
  have hτ (t : ∀ k, R k) : 0 < τ t :=
    Finset.prod_pos (fun k _ => (hR k (t k).val (t k).property).1.pos)
  have hlogP (t : ∀ k, P k) : 0 ≤ Real.log (π t) ∧ Real.log (π t) ≤ L ^ s :=
    ⟨Real.log_nonneg (by exact_mod_cast hπ t), hmaxP t⟩
  have hlogR (t : ∀ k, R k) : 0 ≤ Real.log (τ t) ∧ Real.log (τ t) ≤ L ^ s :=
    ⟨Real.log_nonneg (by exact_mod_cast hτ t), hmaxR t⟩
  have hcells := two_upper_log_cell_cards_polynomial
    (fun t => Real.log (π t)) (fun t => Real.log (τ t)) (by linarith : 4 ≤ L) hs
    (show 0 ≤ w by linarith) hlogP hlogR
  have hminP := hprod P i (fun k p hp => (hP k p hp).1.pos) a b hPi ha hb
  have hminR := hprod R j (fun k p hp => (hR k p hp).1.pos) a' b' hRj ha' hb'
  have hMP := (hM Q (V i) ξ a hQ hQb hVi le_rfl ha).1
  have hMR := (hM Q (W j) ξ a' hQ hQb hWj le_rfl ha').1
  have hEP := (hE Q (V i) ξ a hQ hQb hVi le_rfl ha).2
  have hER := (hE Q (W j) ξ a' hQ hQb hWj le_rfl ha').2
  change ‖∑ t, ∑ r, ((μ t * ν r : ℝ) : ℂ) * (K t r * f t * g r)‖ ≤ _
  rw [finite_weighted_pairing_reorder]
  apply finite_dyadic_pairing_polynomial_bound π τ μ ν hμ hν f g K hL0
    (finite_dyadic_card_polynomial π hπ (by linarith) hs hmaxP)
    (finite_dyadic_card_polynomial τ hτ (by linarith) hs hmaxR)
  intro k _ l _
  by_cases hfk : ∃ t, finiteDyadicTest π k f t ≠ 0
  · by_cases hgl : ∃ r, finiteDyadicTest τ l g r ≠ 0
    · have hU := finite_dyadic_endpoint_scales π f hπ (fun t _ => hminP t) hmaxP hfk
      have hT := finite_dyadic_endpoint_scales τ g hτ (fun t _ => hminR t) hmaxR hgl
      have hlog := dyadic_log_product_polynomial
        (show (0 : ℝ) < (2 ^ k : ℕ) by positivity)
        (show (0 : ℝ) < (2 ^ l : ℕ) by positivity) (by linarith : 2 ≤ L) hU.2 hT.2
      have hp := hbound L q κ (s + 1) n x w z d A hL hq (by positivity) hd
        (by dsimp only [q]; linarith) (by dsimp only [x, n]; linarith)
        (by dsimp only [w]; linarith) (by dsimp only [d]; linarith) Q rfl hQ
        P V i R W j hV hW hP hR hVP hWR a b a' b' hPi hRj ha2 hb ha2' hb'
        h ξ hh hh2 hξ le_rfl le_rfl hEP hER hMP hMR hcells (2 ^ k) (2 ^ l) hU.1 hT.1 hlog
        (finiteDyadicTest π k f) (finiteDyadicTest τ l g)
        (finite_dyadic_test_range π f (fun t _ => hπ t) k)
        (finite_dyadic_test_range τ g (fun r _ => hτ r) l)
        (L ^ κ) (L ^ κ) (by positivity) (by positivity) le_rfl le_rfl hμatom hνatom α ζ hζ
      have he : -B - (s + 1) - (s + 1) = -A := by dsimp only [A]; ring
      rw [he, ← finite_weighted_pairing_reorder]
      exact hp
    · have hg0 : ∀ r, finiteDyadicTest τ l g r = 0 := by
        intro r
        by_contra hn
        exact hgl ⟨r, hn⟩
      simp [hg0]
  · have hf0 : ∀ t, finiteDyadicTest π k f t = 0 := by
      intro t
      by_contra hn
      exact hfk ⟨t, hn⟩
    simp [hf0]

end Bounty
end

section

/- Position-dependent observation records are transported through a named
finite schedule. Both the schedule position and its original event choices
remain available to the arbitrary terminal record condition. -/

namespace Bounty

section Schedule
variable {K X O : Type*} (E : K → X → Type*)
  (target : ∀ k x, E k x → X) (phase : ∀ k x, E k x → ℂ)
  (tag : ℕ → K) (observe : ∀ i x, E (tag i) x → O)

noncomputable def finiteRecordedSchedulePhase (steps : ℕ) (initial : X → List O)
    (F : List O → X → ℂ) (x : X)
    (p : FiniteEventPath E target ((List.range steps).map tag) x) : ℂ :=
  finiteRecordedPathPhase (fun i => E (tag i)) (fun i => target (tag i))
    (fun i => phase (tag i)) observe (List.range steps) initial F x
    ((finiteEventPathMapEquiv E target tag (List.range steps) x).symm p)

theorem finite_recorded_schedule_phase_norm_le
    (hphase : ∀ k x e, ‖phase k x e‖ ≤ 1)
    (steps : ℕ) (initial : X → List O) (F : List O → X → ℂ)
    (hF : ∀ r x, ‖F r x‖ ≤ 1) (x : X)
    (p : FiniteEventPath E target ((List.range steps).map tag) x) :
    ‖finiteRecordedSchedulePhase E target phase tag observe steps initial F x p‖ ≤ 1 :=
  finite_recorded_path_phase_norm_le _ _ _ _
    (fun i x e => hphase (tag i) x e) _ _ _ hF _ _

variable [∀ k x, Fintype (E k x)] (weight : ∀ k x, E k x → ℝ)

theorem finite_recorded_schedule_rows_eq_paths (steps : ℕ) (initial : X → List O)
    (F : List O → X → ℂ) (f : X → ℂ) :
    (fun x => finiteRowComposition (S := fun _ => List O × X)
      (finiteRecordedPhasedRow (fun i => E (tag i)) (fun i => target (tag i))
        (fun i => phase (tag i)) observe (fun i => weight (tag i))) steps
      (fun s => F s.1 s.2 * f s.2) (initial x, x)) =
    finiteEventPathAction E target weight ((List.range steps).map tag)
      (finiteRecordedSchedulePhase E target phase tag observe steps initial F) f := by
  simp_rw [finite_row_composition_eq_operator_list]
  rw [finite_recorded_phased_rows_eq_paths, finite_event_path_action_map]
  rfl

end Schedule
end Bounty
end

section

/- A predicate tested against each chronological observation is exactly a
local event filter. Fixed recorded trajectories can therefore be selected
without introducing a norm or measure on the record space. -/

open Finset Classical

namespace Bounty

section

variable {K X O : Type*} (E : K → X → Type*)
  (target : ∀ k x, E k x → X) (observe : ∀ k x, E k x → O)

theorem finite_event_path_observations_forall₂ (test : K → O → Prop)
    (ks : List K) (x : X) (p : FiniteEventPath E target ks x) :
    List.Forall₂ test ks (finiteEventPathObservations E target observe ks x p) ↔
      finiteEventPathAllowed E target (fun k x e => test k (observe k x e)) ks x p := by
  induction ks generalizing x with
  | nil => simp [finiteEventPathObservations, finiteEventPathAllowed]
  | cons k ks ih =>
    rcases p with ⟨e, p⟩
    simpa only [finiteEventPathObservations, List.forall₂_cons, finiteEventPathAllowed] using
      and_congr Iff.rfl (ih (target k x e) p)

omit observe in
theorem finite_event_local_phase_ledger {L : Type*}
    (update : ∀ k, L → (x : X) → E k x → L)
    (phase : ∀ k x, E k x → ℂ) (ks : List K) (l : L) (x : X)
    (p : FiniteEventPath (fun k (s : L × X) => E k s.2)
      (finiteLedgerEventTarget E target update) ks (l, x)) :
    finiteEventLocalPhase (fun k (s : L × X) => E k s.2)
        (finiteLedgerEventTarget E target update) (fun k s => phase k s.2) ks (l, x) p =
      finiteEventLocalPhase E target phase ks x (finiteLedgerEventPathEquiv E target update ks l x p) := by
  induction ks generalizing l x with
  | nil => rfl
  | cons k ks ih =>
    rcases p with ⟨e, p⟩
    exact congrArg (phase k x e * ·) (ih (update k l x e) (target k x e) p)

omit observe in
theorem finite_event_local_phase_filter (phase : ∀ k x, E k x → ℂ)
    (allowed : ∀ k x, E k x → Prop) (ks : List K) (x : X)
    (p : FiniteEventPath E target ks x) :
    finiteEventLocalPhase E target (fun k x e => if allowed k x e then phase k x e else 0) ks x p =
      if finiteEventPathAllowed E target allowed ks x p then finiteEventLocalPhase E target phase ks x p else 0 := by
  induction ks generalizing x with
  | nil => simp [finiteEventLocalPhase, finiteEventPathAllowed]
  | cons k ks ih =>
    rcases p with ⟨e, p⟩
    simp only [finiteEventLocalPhase, finiteEventPathAllowed, ih]
    split_ifs <;> simp_all

theorem finite_recorded_path_phase_filter (phase : ∀ k x, E k x → ℂ)
    (test : K → O → Prop) (ks : List K) (x : X) (p : FiniteEventPath E target ks x) :
    finiteRecordedPathPhase E target phase observe ks (fun _ => [])
        (fun record _ => if List.Forall₂ test ks record then 1 else 0) x p =
      if finiteEventPathAllowed E target (fun k x e => test k (observe k x e)) ks x p
        then finiteEventLocalPhase E target phase ks x p else 0 := by
  unfold finiteRecordedPathPhase
  rw [finite_event_local_phase_ledger, Equiv.apply_symm_apply]
  simp only [List.nil_append, finite_event_path_observations_forall₂]
  split_ifs <;> simp

variable [∀ k x, Fintype (E k x)]

theorem finite_recorded_filtered_rows_eq_path_action
    (phase : ∀ k x, E k x → ℂ) (weight : ∀ k x, E k x → ℝ)
    (test : K → O → Prop) (ks : List K) (f : X → ℂ) (x : X) :
    finiteOperatorListAction (finiteRecordedPhasedRow E target phase observe weight) ks
        (fun s => (if List.Forall₂ test ks s.1 then 1 else 0) * f s.2) ([], x) =
      finiteEventPathAction E target weight ks
        (fun x p => if finiteEventPathAllowed E target (fun k x e => test k (observe k x e)) ks x p
          then finiteEventLocalPhase E target phase ks x p else 0) f x := by
  have h := congrFun (finite_recorded_phased_rows_eq_paths E target phase observe weight ks
    (fun _ => []) (fun record _ => if List.Forall₂ test ks record then 1 else 0) f) x
  rw [h]
  unfold finiteEventPathAction
  apply sum_congr rfl
  intro p _
  rw [finite_recorded_path_phase_filter]

theorem finite_recorded_filtered_rows_eq_local_rows
    (phase : ∀ k x, E k x → ℂ) (weight : ∀ k x, E k x → ℝ)
    (test : K → O → Prop) (ks : List K) (f : X → ℂ) (x : X) :
    finiteOperatorListAction (finiteRecordedPhasedRow E target phase observe weight) ks
        (fun s => (if List.Forall₂ test ks s.1 then 1 else 0) * f s.2) ([], x) =
      finiteOperatorListAction
        (finiteLocalPhasedRow E target
          (fun k x e => if test k (observe k x e) then phase k x e else 0) weight) ks f x := by
  rw [finite_recorded_filtered_rows_eq_path_action, finite_phased_rows_eq_event_paths]
  unfold finiteEventPathAction
  apply sum_congr rfl
  intro p _
  rw [finite_event_local_phase_filter]

end

end Bounty
end

section

/- Conditional prime-sum estimates with an explicit zero-free boundary. -/

namespace Bounty

open OAI.Ostmann

theorem primitive_smoothed_estimate_right_of (b σ : ℝ) (hb : 7 / 8 ≤ b)
    (hbσ : b < σ) (hσ1 : σ < 1) (hZ : PrimitiveZeroFreeRightOf b) :
    ∃ C : ℝ, 0 < C ∧ ∀ (χ : PrimitiveComplexCharacter) (x : ℝ), 2 ≤ x →
      ‖smoothedTwistedPsi χ.character x‖ ≤
        C * x ^ σ * Real.log ((χ.modulus : ℝ) * x) := by
  obtain ⟨D, hD, hbound⟩ := character_riesz_bound_right_of b σ hb hbσ hσ1 hZ
  refine ⟨12 * D, by positivity, ?_⟩
  intro χ x hx
  rw [smoothedTwistedPsi_eq_riesz χ (by linarith)]
  have hl := riesz_conductor_log_bound (q := (χ.modulus : ℝ))
    (by exact_mod_cast χ.positive) hx
  calc
    _ ≤ D * x ^ σ * (1 + Real.log (24 * (χ.modulus : ℝ) * (x ^ 2 + 2))) :=
      hbound χ x hx
    _ ≤ D * x ^ σ * (12 * Real.log ((χ.modulus : ℝ) * x)) := by gcongr
    _ = _ := by ring

theorem primitive_twistedPsi_power_saving_right_of (b : ℝ) (hb : 7 / 8 ≤ b)
    (hb1 : b < 1) (hZ : PrimitiveZeroFreeRightOf b) :
    ∃ C : ℝ, 0 < C ∧ ∀ (χ : PrimitiveComplexCharacter) (x : ℝ), 2 ≤ x →
      ‖twistedPsi χ.character x‖ ≤
        C * x ^ ((3 + b) / 4) * Real.log ((χ.modulus : ℝ) * x) := by
  obtain ⟨C, hC, hbound⟩ := primitive_smoothed_estimate_right_of b ((1 + b) / 2)
    hb (by linarith) (by linarith) hZ
  refine ⟨28 * C + 6, by positivity, ?_⟩
  intro χ x hx
  have heq : (1 + (1 + b) / 2) / 2 = (3 + b) / 4 := by ring
  have h := twistedPsi_bound_of_smoothed_exponent (θ := (1 + b) / 2)
    (by linarith) (by linarith) χ.character χ.positive hC (hbound χ) hx
  simpa only [heq] using h

theorem primitive_twistedPsi_power_saving_23_24
    (hZ : PrimitiveZeroFreeRightOf (23 / 24)) :
    ∃ C : ℝ, 0 < C ∧ ∀ (χ : PrimitiveComplexCharacter) (x : ℝ), 2 ≤ x →
      ‖twistedPsi χ.character x‖ ≤
        C * x ^ ((95 : ℝ) / 96) * Real.log ((χ.modulus : ℝ) * x) := by
  have h := primitive_twistedPsi_power_saving_right_of (23 / 24)
    (by norm_num) (by norm_num) hZ
  norm_num only at h ⊢
  exact h

end Bounty
end

section

/- Actual averaged components factor through the coordinates they retain. -/

open Finset
open scoped BigOperators Classical

namespace Bounty

variable {I : Type*} {X : I → Type*}

theorem finite_product_nonempty_of_mass_one [∀ i, Fintype (X i)]
    (μ : ∀ i, X i → ℝ) (hmass : ∀ i, ∑ v, μ i v = 1) : Nonempty (∀ i, X i) := by
  have hx (i : I) : Nonempty (X i) := by
    by_contra h
    let _ : IsEmpty (X i) := not_nonempty_iff.mp h
    have hm := hmass i
    simp at hm
  exact ⟨fun i => Classical.choice (hx i)⟩

variable [Fintype I] [DecidableEq I]

theorem finite_four_function_factors_shared_b {Y : Type*} (shared A B tail : Finset I)
    (hsA : Disjoint shared A) (hsB : Disjoint shared B) (hsT : Disjoint shared tail)
    (hAB : Disjoint A B) (hAT : Disjoint A tail) (hBT : Disjoint B tail)
    (hcover : shared ∪ A ∪ B ∪ tail = univ)
    (f : (∀ i, X i) → Y) (x0 : ∀ i, X i)
    (hf : ∀ i ∈ A ∪ tail, ∀ x v, f (Function.update x i v) = f x) :
    ∃ F : (∀ i : shared, X i.1) → (∀ i : B, X i.1) → Y,
      ∀ x, f x = F (finiteCoordinateRestrict shared x) (finiteCoordinateRestrict B x) := by
  let E := finiteFourPartitionEquiv (X := X) shared A B tail hsA hsB hsT hAB hAT hBT hcover
  refine ⟨fun s b => f (E.symm (s, finiteCoordinateRestrict A x0, b,
    finiteCoordinateRestrict tail x0)), ?_⟩
  intro x
  apply finite_function_eq_of_coordinate_invariance (shared ∪ B) f
  · intro i hi y v
    have hall : i ∈ shared ∪ A ∪ B ∪ tail := by rw [hcover]; exact mem_univ i
    have hsi : i ∉ shared := fun hs => hi (mem_union_left B hs)
    have hbi : i ∉ B := fun hb => hi (mem_union_right shared hb)
    have hait : i ∈ A ∪ tail := by simpa [hsi, hbi] using hall
    exact hf i hait y v
  · intro i hi
    have he := E.apply_symm_apply (finiteCoordinateRestrict shared x,
      finiteCoordinateRestrict A x0, finiteCoordinateRestrict B x, finiteCoordinateRestrict tail x0)
    rcases mem_union.mp hi with hs | hb
    · exact (congrFun (congrArg Prod.fst he) ⟨i, hs⟩).symm
    · exact (congrFun (congrArg (fun q => q.2.2.1) he) ⟨i, hb⟩).symm

theorem finite_four_function_factors_shared_a {Y : Type*} (shared A B tail : Finset I)
    (hsA : Disjoint shared A) (hsB : Disjoint shared B) (hsT : Disjoint shared tail)
    (hAB : Disjoint A B) (hAT : Disjoint A tail) (hBT : Disjoint B tail)
    (hcover : shared ∪ A ∪ B ∪ tail = univ)
    (f : (∀ i, X i) → Y) (x0 : ∀ i, X i)
    (hf : ∀ i ∈ B ∪ tail, ∀ x v, f (Function.update x i v) = f x) :
    ∃ F : (∀ i : shared, X i.1) → (∀ i : A, X i.1) → Y,
      ∀ x, f x = F (finiteCoordinateRestrict shared x) (finiteCoordinateRestrict A x) := by
  let E := finiteFourPartitionEquiv (X := X) shared A B tail hsA hsB hsT hAB hAT hBT hcover
  refine ⟨fun s a => f (E.symm (s, a, finiteCoordinateRestrict B x0,
    finiteCoordinateRestrict tail x0)), ?_⟩
  intro x
  apply finite_function_eq_of_coordinate_invariance (shared ∪ A) f
  · intro i hi y v
    have hall : i ∈ shared ∪ A ∪ B ∪ tail := by rw [hcover]; exact mem_univ i
    have hsi : i ∉ shared := fun hs => hi (mem_union_left A hs)
    have hai : i ∉ A := fun ha => hi (mem_union_right shared ha)
    have hbit : i ∈ B ∪ tail := by simpa [hsi, hai] using hall
    exact hf i hbit y v
  · intro i hi
    have he := E.apply_symm_apply (finiteCoordinateRestrict shared x,
      finiteCoordinateRestrict A x, finiteCoordinateRestrict B x0, finiteCoordinateRestrict tail x0)
    rcases mem_union.mp hi with hs | ha
    · exact (congrFun (congrArg Prod.fst he) ⟨i, hs⟩).symm
    · exact (congrFun (congrArg (fun q => q.2.1) he) ⟨i, ha⟩).symm

theorem finite_four_component_factors_shared_b [∀ i, Fintype (X i)]
    (μ : ∀ i, X i → ℝ) (hmass : ∀ i, ∑ v, μ i v = 1)
    (shared A B tail : Finset I)
    (hsA : Disjoint shared A) (hsB : Disjoint shared B) (hsT : Disjoint shared tail)
    (hAB : Disjoint A B) (hAT : Disjoint A tail) (hBT : Disjoint B tail)
    (hcover : shared ∪ A ∪ B ∪ tail = univ)
    (U S0 : Finset I) (hA : A ⊆ U \ S0) (f : (∀ i, X i) → ℂ) :
    ∃ F : (∀ i : shared, X i.1) → (∀ i : B, X i.1) → ℂ,
      ∀ x, finiteCoordinateComponent μ S0 U.toList
        (finiteCoordinateComponent μ ∅ tail.toList f) x =
          F (finiteCoordinateRestrict shared x) (finiteCoordinateRestrict B x) := by
  obtain ⟨x0⟩ := finite_product_nonempty_of_mass_one μ hmass
  apply finite_four_function_factors_shared_b shared A B tail hsA hsB hsT hAB hAT hBT hcover
    (finiteCoordinateComponent μ S0 U.toList (finiteCoordinateComponent μ ∅ tail.toList f)) x0
  intro i hi x v
  rcases mem_union.mp hi with hiA | hiT
  · exact finite_component_missing_invariant μ hmass U S0 i (hA hiA)
      (finiteCoordinateComponent μ ∅ tail.toList f) x v
  · exact finite_component_tail_invariant μ hmass U S0 tail i hiT f x v

theorem finite_four_component_factors_shared_a [∀ i, Fintype (X i)]
    (μ : ∀ i, X i → ℝ) (hmass : ∀ i, ∑ v, μ i v = 1)
    (shared A B tail : Finset I)
    (hsA : Disjoint shared A) (hsB : Disjoint shared B) (hsT : Disjoint shared tail)
    (hAB : Disjoint A B) (hAT : Disjoint A tail) (hBT : Disjoint B tail)
    (hcover : shared ∪ A ∪ B ∪ tail = univ)
    (V T0 : Finset I) (hB : B ⊆ V \ T0) (f : (∀ i, X i) → ℂ) :
    ∃ F : (∀ i : shared, X i.1) → (∀ i : A, X i.1) → ℂ,
      ∀ x, finiteCoordinateComponent μ T0 V.toList
        (finiteCoordinateComponent μ ∅ tail.toList f) x =
          F (finiteCoordinateRestrict shared x) (finiteCoordinateRestrict A x) := by
  obtain ⟨x0⟩ := finite_product_nonempty_of_mass_one μ hmass
  apply finite_four_function_factors_shared_a shared A B tail hsA hsB hsT hAB hAT hBT hcover
    (finiteCoordinateComponent μ T0 V.toList (finiteCoordinateComponent μ ∅ tail.toList f)) x0
  intro i hi x v
  rcases mem_union.mp hi with hiB | hiT
  · exact finite_component_missing_invariant μ hmass V T0 i (hB hiB)
      (finiteCoordinateComponent μ ∅ tail.toList f) x v
  · exact finite_component_tail_invariant μ hmass V T0 tail i hiT f x v

end Bounty
end

section

/- Shared-label averaging recovers the original norms in the asymmetric pairing. -/

namespace Bounty

open Finset
open scoped Classical

theorem finite_three_way_source_energy {C A B : Type*} [Fintype C]
    [Fintype A] [Fintype B] (ρ : C → ℝ) (μ : A → ℝ) (ν : B → ℝ)
    (hμ : ∑ a, μ a = 1) (F : C → B → ℂ) :
    finiteWeightedEnergy (fun x : C × A × B => ρ x.1 * μ x.2.1 * ν x.2.2)
      (fun x => F x.1 x.2.2) = ∑ c, ρ c * finiteWeightedEnergy ν (F c) := by
  simp only [finiteWeightedEnergy, Fintype.sum_prod_type]
  apply sum_congr rfl
  intro c _
  rw [sum_comm, mul_sum]
  apply sum_congr rfl
  intro b _
  calc
    _ = (∑ a, μ a) * (ρ c * (ν b * ‖F c b‖ ^ 2)) := by
      rw [sum_mul]
      apply sum_congr rfl
      intro a _
      ring
    _ = _ := by rw [hμ, one_mul]

theorem finite_three_way_target_energy {C A B : Type*} [Fintype C]
    [Fintype A] [Fintype B] (ρ : C → ℝ) (μ : A → ℝ) (ν : B → ℝ)
    (hν : ∑ b, ν b = 1) (G : C → A → ℂ) :
    finiteWeightedEnergy (fun x : C × A × B => ρ x.1 * μ x.2.1 * ν x.2.2)
      (fun x => G x.1 x.2.1) = ∑ c, ρ c * finiteWeightedEnergy μ (G c) := by
  simp only [finiteWeightedEnergy, Fintype.sum_prod_type]
  apply sum_congr rfl
  intro c _
  rw [mul_sum]
  apply sum_congr rfl
  intro a _
  calc
    _ = (∑ b, ν b) * (ρ c * (μ a * ‖G c a‖ ^ 2)) := by
      rw [sum_mul]
      apply sum_congr rfl
      intro b _
      ring
    _ = _ := by rw [hν, one_mul]

theorem finite_three_way_pairing_error_identity {C A B : Type*} [Fintype C] [DecidableEq C]
    [Fintype A] [Fintype B] (ρ : C → ℝ) (μ : A → ℝ) (ν : B → ℝ)
    (hμ : ∑ a, μ a = 1) (hν : ∑ b, ν b = 1)
    (KA : A → A → ℂ) (KB : B → B → ℂ) (phase : C → A → B → ℂ)
    (F : C → B → ℂ) (G : C → A → ℂ) :
    cleanRawPairing (fun x : C × A × B => ρ x.1 * μ x.2.1 * ν x.2.2)
        (fun x => phase x.1 x.2.1 x.2.2) (fun x => F x.1 x.2.2) (fun x => G x.1 x.2.1) -
      cleanKernelPairing (fun x : C × A × B => ρ x.1 * μ x.2.1 * ν x.2.2)
        (finiteThreeWayKernel μ ν (fun c a b => finiteTwoKernelAverage μ ν KA KB a b (phase c)))
        (fun x => F x.1 x.2.2) (fun x => G x.1 x.2.1) =
      ∑ c, (ρ c : ℂ) * finiteTwoKernelPairingError μ ν KA KB (phase c) (G c)
        (fun b => (starRingEnd ℂ) (F c b)) := by
  rw [finite_three_way_raw_pairing, finite_three_way_kernel_pairing ρ μ ν hμ hν,
    ← sum_sub_distrib]
  apply sum_congr rfl
  intro c _
  rw [← mul_sub]
  congr 1
  rw [← sum_sub_distrib]
  unfold finiteTwoKernelPairingError
  apply sum_congr rfl
  intro a _
  rw [← sum_sub_distrib]
  apply sum_congr rfl
  intro b _
  ring

theorem finite_three_way_pairing_error_le {C A B : Type*} [Fintype C] [DecidableEq C]
    [Fintype A] [Fintype B] (ρ : C → ℝ) (μ : A → ℝ) (ν : B → ℝ)
    (hρ : ∀ c, 0 ≤ ρ c) (hμ : ∀ a, 0 ≤ μ a) (hν : ∀ b, 0 ≤ ν b)
    (hmμ : ∑ a, μ a = 1) (hmν : ∑ b, ν b = 1)
    (KA : A → A → ℂ) (KB : B → B → ℂ) (phase : C → A → B → ℂ)
    (F : C → B → ℂ) (G : C → A → ℂ) (ε : ℝ) (hε : 0 ≤ ε)
    (herr : ∀ c, ‖finiteTwoKernelPairingError μ ν KA KB (phase c) (G c)
        (fun b => (starRingEnd ℂ) (F c b))‖ ≤
      ε * Real.sqrt (finiteWeightedEnergy μ (G c)) * Real.sqrt (finiteWeightedEnergy ν (F c))) :
    ‖cleanRawPairing (fun x : C × A × B => ρ x.1 * μ x.2.1 * ν x.2.2)
        (fun x => phase x.1 x.2.1 x.2.2) (fun x => F x.1 x.2.2) (fun x => G x.1 x.2.1) -
      cleanKernelPairing (fun x : C × A × B => ρ x.1 * μ x.2.1 * ν x.2.2)
        (finiteThreeWayKernel μ ν (fun c a b => finiteTwoKernelAverage μ ν KA KB a b (phase c)))
        (fun x => F x.1 x.2.2) (fun x => G x.1 x.2.1)‖ ≤
      ε * Real.sqrt (finiteWeightedEnergy (fun x : C × A × B => ρ x.1 * μ x.2.1 * ν x.2.2)
        (fun x => F x.1 x.2.2)) *
      Real.sqrt (finiteWeightedEnergy (fun x : C × A × B => ρ x.1 * μ x.2.1 * ν x.2.2)
        (fun x => G x.1 x.2.1)) := by
  rw [finite_three_way_pairing_error_identity ρ μ ν hmμ hmν,
    finite_three_way_source_energy ρ μ ν hmμ, finite_three_way_target_energy ρ μ ν hmν]
  have hb := finite_shared_two_kernel_error_bound ρ μ ν hρ hμ hν KA KB phase G
    (fun c b => (starRingEnd ℂ) (F c b)) ε hε (by simpa only [finiteWeightedEnergy, Complex.norm_conj] using herr)
  simpa only [finiteWeightedEnergy, Complex.norm_conj, mul_assoc, mul_comm, mul_left_comm] using hb

end Bounty
end

section

/- Exact transport of the literal asymmetric row to shared/free/tail coordinates. -/

namespace Bounty

open Finset
open scoped Classical

theorem finite_four_partition_compl_shared {I : Type*} [Fintype I] [DecidableEq I]
    (S A B T : Finset I) (hSA : Disjoint S A) (hSB : Disjoint S B) (hST : Disjoint S T)
    (hcover : S ∪ A ∪ B ∪ T = univ) : Sᶜ = A ∪ B ∪ T := by
  ext i
  constructor
  · intro hi
    have hc : i ∈ S ∪ A ∪ B ∪ T := by rw [hcover]; exact mem_univ i
    simpa only [mem_union, mem_compl.mp hi, false_or] using hc
  · intro hi
    apply mem_compl.mpr
    intro hs
    rcases mem_union.mp hi with hab | ht
    · rcases mem_union.mp hab with ha | hb
      · exact disjoint_left.mp hSA hs ha
      · exact disjoint_left.mp hSB hs hb
    · exact disjoint_left.mp hST hs ht

theorem finite_fresh_mass_four_partition {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} (μ : ∀ i, X i → ℝ) (S A B T : Finset I)
    (hSA : Disjoint S A) (hSB : Disjoint S B) (hST : Disjoint S T)
    (hAB : Disjoint A B) (hAT : Disjoint A T) (hBT : Disjoint B T)
    (hcover : S ∪ A ∪ B ∪ T = univ) (x : ∀ i, X i) :
    finiteFreshMass μ S x =
      finiteProductWeight (fun i : A => μ i.1) (finiteCoordinateRestrict A x) *
      finiteProductWeight (fun i : B => μ i.1) (finiteCoordinateRestrict B x) *
      finiteProductWeight (fun i : T => μ i.1) (finiteCoordinateRestrict T x) := by
  unfold finiteFreshMass finiteProductWeight finiteCoordinateRestrict
  rw [finite_four_partition_compl_shared S A B T hSA hSB hST hcover,
    prod_union (disjoint_union_left.mpr ⟨hAT, hBT⟩), prod_union hAB]
  rw [prod_coe_sort A (fun i => μ i (x i)), prod_coe_sort B (fun i => μ i (x i)),
    prod_coe_sort T (fun i => μ i (x i))]

theorem finite_shared_compatible_iff_restrict {I : Type*} {X : I → Type*}
    (S : Finset I) (x y : ∀ i, X i) :
    finiteSharedCompatible S x y ↔ finiteCoordinateRestrict S x = finiteCoordinateRestrict S y := by
  constructor
  · intro h
    funext i
    exact h i.val i.property
  · intro h i hi
    exact congrFun h ⟨i, hi⟩

theorem finite_asymmetric_kernel_four_fill {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} (μ : ∀ i, X i → ℝ) (S A B T : Finset I)
    (hSA : Disjoint S A) (hSB : Disjoint S B) (hST : Disjoint S T)
    (hAB : Disjoint A B) (hAT : Disjoint A T) (hBT : Disjoint B T)
    (hcover : S ∪ A ∪ B ∪ T = univ)
    (H : (∀ i : S, X i.1) → (∀ i : A, X i.1) → (∀ i : B, X i.1) → ℂ)
    (s s' : ∀ i : S, X i.1) (a a' : ∀ i : A, X i.1)
    (b b' : ∀ i : B, X i.1) (t t' : ∀ i : T, X i.1) :
    finiteAsymmetricKernel μ S A B H
      (finiteFourPartitionFill S A B T hcover s a b t)
      (finiteFourPartitionFill S A B T hcover s' a' b' t') =
    finiteThreeWayKernel (finiteProductWeight (fun i : A => μ i.1))
      (fun bt => finiteProductWeight (fun i : B => μ i.1) bt.1 *
        finiteProductWeight (fun i : T => μ i.1) bt.2)
      (fun s a bt => H s a bt.1) (s, a, b, t) (s', a', b', t') := by
  unfold finiteAsymmetricKernel finiteThreeWayKernel
  rw [finite_shared_compatible_iff_restrict, finite_four_partition_fill_s, finite_four_partition_fill_s]
  split_ifs
  · rw [finite_fresh_mass_four_partition μ S A B T hSA hSB hST hAB hAT hBT hcover]
    simp only [finite_four_partition_fill_a S A B T hcover hSA,
      finite_four_partition_fill_b S A B T hcover hSB hAB,
      finite_four_partition_fill_t S A B T hcover hST hAT hBT, mul_assoc]
  · rfl

end Bounty
end

section

/- Uniform asymptotic counting in the actual logarithmic rough-integer cells. -/

open Finset Filter

namespace Bounty

noncomputable def roughLogarithmicCellMainTerm (L S Y : ℝ) : ℝ :=
  (Real.exp (L^(-S)) * Y - Y) *
    (∏ p ∈ primeBand 0 (Real.exp (Real.sqrt L)), (1 - 1 / (p : ℝ)))

theorem eventually_rough_logarithmic_cell_count {a : ℝ} (ha : 0 < a) (S B : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, Real.exp (a * L) ≤ Y →
      |((roughBand Y (Real.exp (L^(-S)) * Y) (Real.exp (Real.sqrt L))).card : ℝ) -
          roughLogarithmicCellMainTerm L S Y| ≤
        roughLogarithmicCellMainTerm L S Y * L^(-B) := by
  obtain ⟨K, hK, hcount⟩ := exists_real_rough_integer_interval_count
  let C : ℝ := 4 * primeEulerProductUpperConstant
  have hC : 0 < C := mul_pos (by norm_num) primeEulerProductUpperConstant_pos
  have hKC : 0 ≤ K * (C + 1) := by positivity
  filter_upwards [eventually_rough_cell_sieve_parameters ha,
    eventually_rough_cell_error_profile_le ha hKC S B,
    eventually_ge_atTop (1 : ℝ), eventually_ge_atTop (Real.log 2)]
    with L hpar hprofile hL hlog
  intro Y hY
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hY0 : 0 < Y := (Real.exp_pos _).trans_le hY
  let M := roughLogarithmicCellMainTerm L S Y
  let E := Real.exp (-L^(1/8 : ℝ))
  let T := L^(S + 1) * Real.exp (-(a/2)*L)
  have hMlo : Y / (C * L^(S + 1)) ≤ M :=
    rough_logarithmic_cell_main_term_lower hL hlog hY0.le S
  have hden : 0 < C * L^(S + 1) := by positivity
  have hM0 : 0 ≤ M := (div_pos hY0 hden).le.trans hMlo
  have hMexp : Real.exp (a*L) / (C * L^(S + 1)) ≤ M :=
    (div_le_div_of_nonneg_right hY hden.le).trans hMlo
  have hT0 : 0 ≤ T := by dsimp [T]; positivity
  have hE0 : 0 ≤ E := Real.exp_nonneg _
  have hlevel :
      (Real.exp (Real.sqrt L))^(4*(roughCellSieveOrder L : ℝ) + 2) ≤ M * (C*T) := by
    apply hpar.2.2.2.1.trans
    have hm := mul_le_mul_of_nonneg_right hMexp (mul_nonneg hC.le hT0)
    have hid : (Real.exp (a*L) / (C * L^(S + 1))) * (C*T) =
        Real.exp ((a/2)*L) := by
      dsimp [T]
      calc
        _ = Real.exp (a*L) * Real.exp (-(a/2)*L) := by field_simp
        _ = _ := by rw [← Real.exp_add]; congr 1; ring
    rwa [hid] at hm
  have hlength : Y ≤ Real.exp (L^(-S)) * Y := by
    have h := logarithmic_cell_length_lower (L := L) hY0.le S
    have hp : 0 ≤ Y * L^(-S) := by positivity
    linarith
  have hbase := hcount hY0.le hlength hpar.2.2.1 hpar.1 hpar.2.1
  change |((roughBand Y (Real.exp (L^(-S)) * Y) (Real.exp (Real.sqrt L))).card : ℝ) - M| ≤
    K * (M * Real.exp (-(roughCellSieveOrder L : ℝ)) +
      (Real.exp (Real.sqrt L))^(4*(roughCellSieveOrder L : ℝ) + 2)) at hbase
  have he : Real.exp (-(roughCellSieveOrder L : ℝ)) ≤ E := hpar.2.2.2.2
  have hsmall : E + C*T ≤ (C + 1) * (E + T) := by nlinarith
  calc
    _ ≤ K * (M * Real.exp (-(roughCellSieveOrder L : ℝ)) +
        (Real.exp (Real.sqrt L))^(4*(roughCellSieveOrder L : ℝ) + 2)) := hbase
    _ ≤ K * (M*E + M*(C*T)) :=
      mul_le_mul_of_nonneg_left
        (add_le_add (mul_le_mul_of_nonneg_left he hM0) hlevel) hK.le
    _ = M * (K * (E + C*T)) := by ring
    _ ≤ M * (K * ((C+1)*(E+T))) :=
      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hsmall hK.le) hM0
    _ = M * ((K*(C+1))*(E+T)) := by ring
    _ ≤ M * L^(-B) := mul_le_mul_of_nonneg_left hprofile hM0

end Bounty
end

section

/- Uniform rough-integer counts in unit residue classes, with exact totient density. -/

open Finset

namespace Bounty

theorem exists_residue_prime_avoidance_count :
    ∃ K : ℝ, 0 < K ∧ ∀ (P : Finset ℕ) (A B r u : ℕ) {z : ℝ} {h : ℕ},
      1 < z → A ≤ B → 0 < r → 1 ≤ h → Even h →
      (∀ p ∈ P, p.Prime) → (∀ p ∈ P, (p : ℝ) ≤ z) →
      (∀ p ∈ P, ¬p ∣ r) →
      |((((Ioc A B).filter (fun n => n % r = u % r)).filter
          (fun n => ∀ p ∈ P, ¬p ∣ n)).card : ℝ) -
        (((B : ℝ) - A) / r) * (∏ p ∈ P, (1 - 1 / (p : ℝ)))| ≤
        (((B : ℝ) - A) / r) * (∏ p ∈ P, (1 - 1 / (p : ℝ))) *
          K * Real.exp (-(h : ℝ)) + z^(4 * (h : ℝ) + 2) := by
  obtain ⟨K, hK, hsieve⟩ := exists_reciprocal_prime_sieve_events
  refine ⟨K, hK, ?_⟩
  intro P A B r u z h hz hAB hr hh heven hP hPz hPr
  have hX : 0 ≤ ((B : ℝ) - A) / r :=
    div_nonneg (sub_nonneg.mpr (Nat.cast_le.mpr hAB)) (Nat.cast_nonneg r)
  have hcount := hsieve P ((Ioc A B).filter (fun n => n % r = u % r))
    (fun _ => 1) (fun n p => p ∣ n) (intervalResidueDivisibilityRemainder A B r u)
    hz hX hh heven hP hPz (by intros; norm_num)
    (fun S hS => interval_residue_prime_intersection_moment P hP A B r u S (mem_powerset.mp hS))
  have hrem := interval_residue_divisibility_remainder_sum_le P hP r hPr A B u hAB hr
    (z^(4 * (h : ℝ) + 2)) (Real.rpow_nonneg (zero_lt_one.trans hz).le _)
  have hresult := hcount.trans (add_le_add le_rfl hrem)
  simpa only [sum_const, nsmul_eq_mul, mul_one] using hresult

theorem unit_residue_avoids_modulus_primes (r u n p : ℕ) (hu : u.Coprime r)
    (hn : n % r = u % r) (hp : p.Prime) (hpr : p ∣ r) : ¬p ∣ n := by
  intro hpn
  have hpmod : p ∣ u % r := hn ▸ Nat.dvd_mod_iff hpr |>.mpr hpn
  have hpu : p ∣ u := (Nat.dvd_mod_iff hpr).mp hpmod
  have hg := Nat.dvd_gcd hpu hpr
  rw [hu.gcd_eq_one] at hg
  exact hp.not_dvd_one hg

theorem unit_residue_small_prime_avoidance (r u n : ℕ) {z : ℝ}
    (hz : 0 ≤ z) (hu : u.Coprime r) (hn : n % r = u % r) (hn0 : n ≠ 0) :
    (∀ p ∈ (primeBand 0 z).filter (fun p => ¬p ∣ r), ¬p ∣ n) ↔
      ∀ p ∈ n.primeFactors, z < (p : ℝ) := by
  rw [← small_prime_avoidance_iff_rough hz hn0]
  constructor
  · intro h p hp
    by_cases hpr : p ∣ r
    · exact unit_residue_avoids_modulus_primes r u n p hu hn (small_prime_pool_prime hp) hpr
    · exact h p (mem_filter.mpr ⟨hp, hpr⟩)
  · intro h p hp
    exact h p (mem_filter.mp hp).1

theorem exists_unit_residue_rough_count :
    ∃ K : ℝ, 0 < K ∧ ∀ (A B r u : ℕ) {z : ℝ} {h : ℕ},
      1 < z → A ≤ B → 0 < r → u.Coprime r →
      (∀ p ∈ r.primeFactors, (p : ℝ) ≤ z) → 1 ≤ h → Even h →
      |(((Ioc A B).filter (fun n => n % r = u % r ∧
          ∀ p ∈ n.primeFactors, z < (p : ℝ))).card : ℝ) -
        (((B : ℝ) - A) / r.totient) *
          (∏ p ∈ primeBand 0 z, (1 - 1 / (p : ℝ)))| ≤
        (((B : ℝ) - A) / r.totient) *
          (∏ p ∈ primeBand 0 z, (1 - 1 / (p : ℝ))) *
            K * Real.exp (-(h : ℝ)) + z^(4 * (h : ℝ) + 2) := by
  obtain ⟨K, hK, hcount⟩ := exists_residue_prime_avoidance_count
  refine ⟨K, hK, ?_⟩
  intro A B r u z h hz hAB hr hu hpf hh heven
  have hz0 : 0 ≤ z := (zero_lt_one.trans hz).le
  have h := hcount ((primeBand 0 z).filter (fun p => ¬p ∣ r)) A B r u hz hAB hr hh heven
    (fun _ hp => small_prime_pool_prime (mem_filter.mp hp).1)
    (fun _ hp => small_prime_pool_le hz0 (mem_filter.mp hp).1)
    (fun _ hp => (mem_filter.mp hp).2)
  have hset : ((Ioc A B).filter (fun n => n % r = u % r)).filter
        (fun n => ∀ p ∈ (primeBand 0 z).filter (fun p => ¬p ∣ r), ¬p ∣ n) =
      (Ioc A B).filter (fun n => n % r = u % r ∧
        ∀ p ∈ n.primeFactors, z < (p : ℝ)) := by
    rw [filter_filter]
    apply filter_congr
    intro n hn
    have hn0 : n ≠ 0 := ne_of_gt (lt_of_le_of_lt (Nat.zero_le A) (mem_Ioc.mp hn).1)
    exact and_congr_right (fun hnr => unit_residue_small_prime_avoidance r u n hz0 hu hnr hn0)
  rw [hset] at h
  have heuler := small_prime_avoidance_unit_density hz0 r hr hpf
  have hmain : (((B : ℝ) - A) / r) *
      (∏ p ∈ (primeBand 0 z).filter (fun p => ¬p ∣ r), (1 - 1 / (p : ℝ))) =
      (((B : ℝ) - A) / r.totient) *
        (∏ p ∈ primeBand 0 z, (1 - 1 / (p : ℝ))) := by
    calc
      _ = ((B : ℝ) - A) *
          ((∏ p ∈ (primeBand 0 z).filter (fun p => ¬p ∣ r), (1 - 1 / (p : ℝ))) / r) := by ring
      _ = _ := by rw [heuler]; ring
  simpa only [hmain] using h

end Bounty
end

