theorem prime_ideal_kernel_zero_of_right_discarded {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ) (Q : ℕ) (h : ℝ) (kept : Finset ℤ)
    (x y : ∀ i, P i) (hy : upperLogCell h (Real.log (∏ i, (y i).val : ℕ)) ∉ kept) :
    primeProductIdealKernel P V Q h kept x y = 0 := by
  unfold primeProductIdealKernel finiteCellFrameKernel
  split_ifs with hxy
  · have he : upperLogCell h (Real.log (∏ i, (x i).val : ℕ)) =
        upperLogCell h (Real.log (∏ i, (y i).val : ℕ)) := hxy.1
    have hm : upperLogCell h (Real.log (∏ i, (x i).val : ℕ)) ∈ kept := hxy.2
    rw [he] at hm
    exact (hy hm).elim
  · rfl

