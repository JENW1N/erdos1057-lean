open Finset Classical
namespace Bounty

section
variable {S G : Type} [Fintype S] [Fintype G] [dG : DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Finset ℕ}
  [∀ g (p : P g), NeZero p.val] {J ell B : ℕ}

omit dG in
theorem physical_mixed_target_labels_reindex
    (C : G → Finset (Fin J)) (k : ℤ) (a : PhysicalAuxLabels P C)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B))
    (τ : ∀ g, Equiv.Perm (Fin (s.2 g).2.1.val)) (e : PhysicalMixedCoefficientEvent C k a s) :
    physicalMixedRepeatedLabels C
      (physicalMixedCoefficientTarget C k a (s.1, productMemoryReindex s.2 τ)
        (physicalMixedCoefficientReindex C k a s τ e)).2 =
      physicalMixedRepeatedLabels C (physicalMixedCoefficientTarget C k a s e).2 := by
  funext g j
  exact congrFun (full_edge_reindex_active (fun g (p : P g) => p.val)
    (fun g => physicalFullSharedIndices (ell := ell) (C g)) B (fun _ => Unit)
    (fun c _ g => physicalMixedEdgeDelta C k (physicalSharedPrefix s.1.2) c a g)
    (fun c _ g => physicalMixedEdgeD C (physicalSharedPrefix s.1.2) c a g)
    s.2 τ e.2 g) ((physicalFullSlotIndex (C g)).symm j)

theorem physical_mixed_prime_signed_memory_symmetric
    (V : G → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ) (Vs : S → ℝ) (q : ℝ)
    (probes : G → Finset (Fin J)) (r t : Finset G) (hrt : Disjoint r t)
    (Q : ℕ) (h ξ : ℝ) (k : ℤ) (initial : ∀ g, Finset (P g))
    (φ : ∀ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      ∀ a (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B)),
        PhysicalMixedCoefficientEvent (repeatedBigPrimePatternCut probes r t i) k a s → ℂ)
    (hφ : ∀ i a (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B))
      (τ : ∀ g, Equiv.Perm (Fin (s.2 g).2.1.val))
