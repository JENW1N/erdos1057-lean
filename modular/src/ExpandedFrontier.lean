/- The existing full active-label initial ledger is exactly the ledger of the encoded physical initial state. -/

namespace Bounty

theorem physical_active_initial_mark_encode
    {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (C : Fin N → Finset (Fin J)) (L : PhysicalMarkLists P J ell)
    (q : (g : Fin N) → BoundedOrderedTuple
      (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B) :
    physicalBoundedMarkEncode C
      (L, (fun g => ghostPhaseActivitySupport (physicalGroupPhaseActivity L g)), q) =
    (fullActiveInitialLedger (physicalFullMemoryState C L q), physicalFullMemoryState C L q) := by
  rw [physical_full_initial_ledger]
  rfl

theorem physical_initial_mark_state_encode
    {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (C : Fin N → Finset (Fin J)) (L : PhysicalMarkLists P J ell) :
    let x := physicalFullMemoryState C L (fun g => fullEmptyBoundedMemory
      (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B)
    physicalBoundedMarkEncode C (physicalInitialMarkState B L) = (fullActiveInitialLedger x, x) := by
  dsimp only
