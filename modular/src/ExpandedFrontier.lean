open Finset
open scoped Classical
theorem finite_operator_list_action_append {K X : Type*}
    (row : K → (X → ℂ) → X → ℂ) (ks ls : List K) (F : X → ℂ) :
    finiteOperatorListAction row (ks ++ ls) F =
      finiteOperatorListAction row ks (finiteOperatorListAction row ls F) := by
  induction ks with
  | nil => rfl
  | cons k ks ih => simp only [List.cons_append, finiteOperatorListAction, ih]

theorem finite_row_composition_eq_operator_list {X : Type*}
    (row : ℕ → (X → ℂ) → X → ℂ) (n : ℕ) (F : X → ℂ) :
    finiteRowComposition (S := fun _ => X) row n F =
      finiteOperatorListAction row (List.range n) F := by
  induction n generalizing F with
  | zero => rfl
  | succ n ih =>
      rw [finite_row_composition_succ, List.range_succ, finite_operator_list_action_append]
      exact ih (row n F)

def finiteEventPathAllowed {K X : Type*} (E : K → X → Type*)
    (target : ∀ k x, E k x → X) (allowed : ∀ k x, E k x → Prop) :
    ∀ ks x, FiniteEventPath E target ks x → Prop
  | [], _, _ => True
  | k :: ks, x, ⟨e, p⟩ => allowed k x e ∧ finiteEventPathAllowed E target allowed ks _ p

theorem finite_event_path_weight_restrict {K X : Type*} (E : K → X → Type*)
    (target : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (allowed : ∀ k x, E k x → Prop) (ks : List K) (x : X)
    (p : FiniteEventPath E target ks x) :
    finiteEventPathWeight E target (fun k x e => if allowed k x e then w k x e else 0) ks x p =
      if finiteEventPathAllowed E target allowed ks x p
        then finiteEventPathWeight E target w ks x p else 0 := by
  induction ks generalizing x with
  | nil => simp [finiteEventPathWeight, finiteEventPathAllowed]
  | cons k ks ih =>
      rcases p with ⟨e, p⟩
      simp only [finiteEventPathWeight, finiteEventPathAllowed, ih]
      split_ifs <;> simp_all

/-- Every local acceptance test becomes one conjunction on the complete path.
The additional phase is arbitrary and may inspect all event identities. -/
theorem finite_event_path_action_restrict {K X : Type*} (E : K → X → Type*)
    [∀ k x, Fintype (E k x)]
    (target : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (allowed : ∀ k x, E k x → Prop) (ks : List K)
    (phase : ∀ x, FiniteEventPath E target ks x → ℂ) (F : X → ℂ) (x : X) :
    finiteEventPathAction E target (fun k x e => if allowed k x e then w k x e else 0)
      ks phase F x =
    finiteEventPathAction E target w ks
      (fun x p => if finiteEventPathAllowed E target allowed ks x p then phase x p else 0) F x := by
  unfold finiteEventPathAction
  apply sum_congr rfl
  intro p _
  rw [finite_event_path_weight_restrict]
  split_ifs <;> simp_all

/-- Expanding actual finite event rows in chronological order retains every
event multiplicity and permits real weights of either sign. -/
theorem finite_row_composition_eq_event_paths {X : Type*} (E : ℕ → X → Type*)
    [∀ i x, Fintype (E i x)] (target : ∀ i x, E i x → X)
    (w : ∀ i x, E i x → ℝ) (n : ℕ) (F : X → ℂ) (x : X) :
    finiteRowComposition (S := fun _ => X) (finiteLocalEventAction E w target) n F x =
      finiteEventPathPositive E target w (List.range n) F x := by
  rw [finite_row_composition_eq_operator_list, finite_event_path_positive_eq_list]
end

