/- Exact normalization of one actual supported root-path term. -/

open Finset
open scoped Classical
namespace Bounty

section Normalization
variable {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  [∀ a : PhysicalPrime P, NeZero a.2.val]
  (V : Fin N → ℝ) (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
  (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
  (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
  (L : PhysicalMarkLists P J ell)
  (p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)
  (hp : physicalRootNormalizablePath V patterns C ζ k K L p)
  (hP : ∀ g a, a ∈ P g → Nat.Prime a)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin (n + 1), ∀ g s,
    ¬ (((physicalPathSelectedEquiv patterns C (L, p)).2.2.1 j.castSucc g s).val : ℤ) ∣
      physicalPathSelectedMultiplier C k p j)
  (b : PhysicalPrime P → ℝ)
  (hb : ∀ a, b a = 1 - (∑ j ∈ range (n + 2), (1 - physicalEndpointSchedule q (n + 1) j)) / a.2.val)
  (hb0 : ∀ a, b a ≠ 0)

include hp hP hdis hk hb hb0

theorem physical_finite_root_term_memory_normalization :
    (physicalStateMass V J ell : ℂ) * physicalFiniteReturnScalar V patterns C ζ k K n L p *
      (physicalFiniteVertexExpectation C q k n L p : ℂ) =
    (∏ a : PhysicalPrime P, (b a : ℂ)) *
      physicalMemoryWalkScalar V patterns C ζ K (finitePathLabels p) (finitePathMarks L p) (n + 1) *
      (∏ a : PhysicalPrime P, (ghostPhaseRunHistory
        (fun j => decide (a ∈ physicalMarkedPrimes (finitePathMarks L p j)))
        (fun j => -(physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p)
          (n + 1) j : ZMod a.2.val))
        (fun j => 1 - physicalEndpointSchedule q (n + 1) j)
        ((a.2.val : ℝ) * b a)⁻¹ (V a.1) (n + 1) : ℂ)) := by
  obtain ⟨r, hr⟩ := hp.2
  have hnew := physical_finite_path_new_marks V patterns C ζ k K L p hp.1 r hr hP hdis hk
  have he := physical_memory_walk_phase_factor_of_counts V patterns C ζ K
    (finitePathLabels p) (finitePathMarks L p) (n + 1)
    (fun (a : PhysicalPrime P) j => -(physicalBareOffset C k (finitePathLabels p)
      (finitePathMarks L p) (n + 1) j : ZMod a.2.val))
    (fun _ j => 1 - physicalEndpointSchedule q (n + 1) j)
    (fun a => ((a.2.val : ℝ) * b a)⁻¹) hnew
  rw [physical_root_normalizable_return_eq_walk V patterns C ζ k K L p hp,
    physical_finite_vertex_expectation_eq_phase C q k L p b hb hb0]
  rw [Complex.ofReal_mul, Complex.ofReal_prod, mul_left_comm, he, ← mul_assoc,
    Complex.ofReal_prod]

end Normalization
end Bounty
