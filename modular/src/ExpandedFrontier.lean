open OAI.Ostmann

theorem log_three_scale_le {q x y : ℝ} (hq : 1 ≤ q) (hx : 2 ≤ x)
    (hy : 0 < y) (hyx : y ≤ 3 * x) :
    Real.log (q * y) ≤ 3 * Real.log (q * x) := by
  have hq0 : 0 < q := by linarith
  have hx0 : 0 < x := by linarith
  have hqx : 2 ≤ q * x := by nlinarith
  have hlog2 := Real.log_le_log (by norm_num : (0 : ℝ) < 2) hqx
  have hlog3 : Real.log (3 : ℝ) ≤ 2 * Real.log 2 := by
    have hh := Real.log_le_log (by norm_num : (0 : ℝ) < 3) (by norm_num : (3 : ℝ) ≤ 2 ^ 2)
    simpa only [Real.log_pow, Nat.cast_ofNat] using hh
  have hlog := Real.log_le_log (mul_pos hq0 hy) (mul_le_mul_of_nonneg_left hyx hq0.le)
  have he : q * (3 * x) = 3 * (q * x) := by ring
  rw [he, Real.log_mul (by norm_num : (3 : ℝ) ≠ 0) (by positivity : q * x ≠ 0)] at hlog
  linarith

theorem power_three_scale_le {x y : ℝ} (hx : 0 < x) (hy : 0 ≤ y) (hyx : y ≤ 3 * x) :
    y ^ ((15 : ℝ) / 16) ≤ 3 * x ^ ((15 : ℝ) / 16) := by
  have hthree : (3 : ℝ) ^ ((15 : ℝ) / 16) ≤ 3 := by
    calc
      _ ≤ (3 : ℝ) ^ (1 : ℝ) := Real.rpow_le_rpow_of_exponent_le (by norm_num) (by norm_num)
      _ = _ := Real.rpow_one _
  calc
    _ ≤ (3 * x) ^ ((15 : ℝ) / 16) := Real.rpow_le_rpow hy hyx (by norm_num)
    _ = (3 : ℝ) ^ ((15 : ℝ) / 16) * x ^ ((15 : ℝ) / 16) := Real.mul_rpow (by norm_num) hx.le
    _ ≤ _ := mul_le_mul_of_nonneg_right hthree (Real.rpow_nonneg hx.le _)

/-- The triangular estimate at exponent 15/16 gives a sharp sum estimate at
31/32. Its constant is independent of the modulus and character. -/
theorem twistedPsi_bound_of_smoothed {q : ℕ} (χ : DirichletCharacter ℂ q)
    (hq : 0 < q) {C : ℝ} (hC : 0 < C)
    (hbound : ∀ y : ℝ, 2 ≤ y → ‖smoothedTwistedPsi χ y‖ ≤
      C * y ^ ((15 : ℝ) / 16) * Real.log ((q : ℝ) * y))
    {x : ℝ} (hx : 2 ≤ x) :
    ‖twistedPsi χ x‖ ≤ (28 * C + 6) * x ^ ((31 : ℝ) / 32) * Real.log ((q : ℝ) * x) := by
  let p : ℝ := x ^ ((31 : ℝ) / 32)
  let m : ℕ := ⌈p⌉₊
  let L : ℝ := Real.log ((q : ℝ) * x)
  have hx0 : 0 < x := by linarith
  have hq1 : (1 : ℝ) ≤ q := by exact_mod_cast hq
  have hq0 : (0 : ℝ) < q := by exact_mod_cast hq
  have hL : 0 ≤ L := Real.log_nonneg (by nlinarith)
  have hp1 : 1 ≤ p := Real.one_le_rpow (by linarith) (by norm_num)
  have hp0 : 0 < p := by linarith
  have hpx : p ≤ x := by
    calc
      _ ≤ x ^ (1 : ℝ) := Real.rpow_le_rpow_of_exponent_le (by linarith) (by norm_num)
      _ = x := Real.rpow_one _
  have hmp : p ≤ (m : ℝ) := Nat.le_ceil p
  have hm2p : (m : ℝ) ≤ 2 * p := by
    have hh := Nat.ceil_lt_add_one hp0.le
    dsimp [m]
    linarith
  have hm : 0 < m := Nat.ceil_pos.mpr hp0
  have hm0 : 0 < (m : ℝ) := by exact_mod_cast hm
  have hym : x + (m : ℝ) ≤ 3 * x := by linarith
  have hy2 : 2 ≤ x + (m : ℝ) := by linarith
  have hpow := power_three_scale_le hx0 (by positivity : 0 ≤ x + (m : ℝ)) hym
  have hlog := log_three_scale_le hq1 hx (by positivity : 0 < x + (m : ℝ)) hym
  have hlog0 : 0 ≤ Real.log ((q : ℝ) * (x + (m : ℝ))) :=
    Real.log_nonneg (by nlinarith)
  have hsmy : ‖smoothedTwistedPsi χ (x + m)‖ ≤
      9 * C * x ^ ((15 : ℝ) / 16) * L := by
    calc
      _ ≤ C * (x + m) ^ ((15 : ℝ) / 16) * Real.log ((q : ℝ) * (x + m)) := hbound _ hy2
      _ ≤ C * (3 * x ^ ((15 : ℝ) / 16)) * (3 * L) := by gcongr
      _ = _ := by ring
  have hsmx : ‖smoothedTwistedPsi χ x‖ ≤ C * x ^ ((15 : ℝ) / 16) * L := hbound x hx
  have hp2 : x * x ^ ((15 : ℝ) / 16) = p ^ 2 := by
    dsimp [p]
    calc
      _ = x ^ (1 : ℝ) * x ^ ((15 : ℝ) / 16) := by rw [Real.rpow_one]
      _ = x ^ ((1 : ℝ) + 15 / 16) := (Real.rpow_add hx0 _ _).symm
      _ = x ^ (((31 : ℝ) / 32) * 2) := by congr 1; norm_num
      _ = _ := by rw [Real.rpow_mul hx0.le, Real.rpow_two]
  have hpair : (x + m) * ‖smoothedTwistedPsi χ (x + m)‖ + x * ‖smoothedTwistedPsi χ x‖ ≤
      28 * C * p ^ 2 * L := by
    calc
      _ ≤ (3 * x) * (9 * C * x ^ ((15 : ℝ) / 16) * L) +
          x * (C * x ^ ((15 : ℝ) / 16) * L) := by gcongr
      _ = 28 * C * (x * x ^ ((15 : ℝ) / 16)) * L := by ring
      _ = _ := by rw [hp2]
  have hlogy : Real.log (x + (m : ℝ)) ≤ 3 * L := by
    apply le_trans _ hlog
    apply Real.log_le_log (by positivity)
    nlinarith
  have hpp : p ^ 2 ≤ p * m := by nlinarith
  have hmp2 : (m : ℝ) ^ 2 ≤ 2 * p * m := by nlinarith
  calc
    _ ≤ ((x + m) * ‖smoothedTwistedPsi χ (x + m)‖ + x * ‖smoothedTwistedPsi χ x‖ +
        (m : ℝ) ^ 2 * Real.log (x + m)) / m := riesz_unsmoothing_bound χ hx0 hm
    _ ≤ (28 * C + 6) * p * L := by
      apply (div_le_iff₀ hm0).mpr
      calc
        _ ≤ 28 * C * p ^ 2 * L + (m : ℝ) ^ 2 * (3 * L) := by gcongr
        _ = 28 * C * p ^ 2 * L + 3 * (m : ℝ) ^ 2 * L := by ring
        _ ≤ 28 * C * (p * m) * L + 3 * (2 * p * m) * L := by gcongr
        _ = _ := by ring

theorem primitive_twistedPsi_power_saving (hZ : PrimitiveZeroFreeHalfPlane) :
    ∃ C : ℝ, 0 < C ∧ ∀ (χ : PrimitiveComplexCharacter) (x : ℝ), 2 ≤ x →
      ‖twistedPsi χ.character x‖ ≤
        C * x ^ ((31 : ℝ) / 32) * Real.log ((χ.modulus : ℝ) * x) := by
  obtain ⟨D, hD, hbound⟩ := primitive_smoothed_estimate_of_zero_free hZ
  refine ⟨28 * D + 6, by positivity, ?_⟩
  intro χ x hx
  exact twistedPsi_bound_of_smoothed χ.character χ.positive hD (hbound χ) hx
end

section

open OAI.Ostmann

theorem prime_power_error_le_character_scale_weak {q x : ℝ} (hq : 1 ≤ q) (hx : 2 ≤ x) :
    2 * Real.sqrt x * Real.log x ≤
      4 * x ^ ((31 : ℝ) / 32) * (Real.log (q * x)) ^ 2 := by
  apply (prime_power_error_le_character_scale hq hx).trans
  have hp : x ^ ((7 : ℝ) / 8) ≤ x ^ ((31 : ℝ) / 32) :=
    Real.rpow_le_rpow_of_exponent_le (by linarith) (by norm_num)
  exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hp (by norm_num)) (sq_nonneg _)

theorem prime_sum_bound_of_twistedTheta_weak {q : ℕ} (χ : DirichletCharacter ℂ q)
    (hq : 0 < q) {C : ℝ} (hC : 0 ≤ C)
    (hbound : ∀ x : ℝ, 2 ≤ x →
      ‖twistedTheta χ x‖ ≤ C * x ^ ((31 : ℝ) / 32) * (Real.log ((q : ℝ) * x)) ^ 2)
    {y : ℝ} (hy : 2 ≤ y) :
    ‖∑ p ∈ ambientPrimes y, χ (p : ZMod q)‖ ≤
      (20 * C) * y ^ ((31 : ℝ) / 32) * (Real.log (5 * (q : ℝ) * y)) ^ 2 := by
  have hy0 : 0 < y := by linarith
  have hq0 : (0 : ℝ) < q := by exact_mod_cast hq
  have hq1 : (1 : ℝ) ≤ q := by exact_mod_cast hq
  let B : ℝ := C * (5 * y) ^ ((31 : ℝ) / 32) * (Real.log ((q : ℝ) * (5 * y))) ^ 2
  have hB : 0 ≤ B := by positivity
  have hprefix : ∀ k : ℕ, k ≤ ⌊5 * y⌋₊ → ‖twistedTheta χ k‖ ≤ B := by
    intro k hk
    by_cases hk2 : k < 2
    · rw [twistedTheta_nat_zero_one χ hk2, norm_zero]
      exact hB
    · have hkreal : (2 : ℝ) ≤ k := by exact_mod_cast (show 2 ≤ k by omega)
      have hk0 : (0 : ℝ) < k := by linarith
      have hkbound : (k : ℝ) ≤ 5 * y := (Nat.le_floor_iff (by positivity)).mp hk
      have hlog0 : 0 ≤ Real.log ((q : ℝ) * k) := Real.log_nonneg (by nlinarith)
      apply (hbound k hkreal).trans
      dsimp [B]
      gcongr
  rw [ambientPrimes_eq_filter_Ioc hy0.le]
  have hm : 1 ≤ ⌊2 * y⌋₊ := Nat.le_floor (by norm_num; linarith)
  have hmain := norm_prime_sum_Ioc_le χ hm hB hprefix
  apply hmain.trans
  dsimp [B]
  have hpow : (5 : ℝ) ^ ((31 : ℝ) / 32) ≤ 5 :=
    Real.rpow_le_self_of_one_le (by norm_num) (by norm_num)
  rw [Real.mul_rpow (by norm_num : (0 : ℝ) ≤ 5) hy0.le]
  have heq : (q : ℝ) * (5 * y) = 5 * q * y := by ring
  rw [heq]
  nlinarith [mul_le_mul_of_nonneg_right hpow
    (mul_nonneg (mul_nonneg hC (Real.rpow_nonneg hy0.le ((31 : ℝ) / 32))) (sq_nonneg (Real.log (5 * q * y))))]


theorem prime_sum_bound_of_twistedPsi_weak {q : ℕ} (χ : DirichletCharacter ℂ q)
    (hq : 0 < q) {C : ℝ} (hC : 0 ≤ C)
    (hbound : ∀ x : ℝ, 2 ≤ x →
      ‖twistedPsi χ x‖ ≤ C * x ^ ((31 : ℝ) / 32) * (Real.log ((q : ℝ) * x)) ^ 2)
    {y : ℝ} (hy : 2 ≤ y) :
    ‖∑ p ∈ ambientPrimes y, χ (p : ZMod q)‖ ≤
      (20 * (C + 4)) * y ^ ((31 : ℝ) / 32) * (Real.log (5 * (q : ℝ) * y)) ^ 2 := by
  apply prime_sum_bound_of_twistedTheta_weak χ hq (by linarith : 0 ≤ C + 4) _ hy
  intro x hx
  have htheta := norm_twistedTheta_le χ (by linarith : 1 ≤ x) (hbound x hx)
  have herr := prime_power_error_le_character_scale_weak
    (by exact_mod_cast hq : (1 : ℝ) ≤ q) hx
  nlinarith


def PrimitivePrimeCharacterEstimateWeak : Prop :=
  ∃ C : ℝ, 0 < C ∧ ∀ y : ℝ, 2 ≤ y → ∀ q : ℕ, 0 < q →
    ∀ χ : DirichletCharacter ℂ q, χ ≠ 1 → χ.IsPrimitive →
      ‖∑ p ∈ ambientPrimes y, χ (p : ZMod q)‖ ≤
        C * y ^ ((31 : ℝ) / 32) * (Real.log (5 * (q : ℝ) * y)) ^ 2

/-- Removing primitivity costs only an additive four in the uniform constant. -/
theorem uniformPrimeCharacterEstimate_of_primitive_weak
    (h : PrimitivePrimeCharacterEstimateWeak) : UniformPrimeCharacterEstimateAt ((31 : ℝ) / 32) := by
  obtain ⟨C, hC, hbound⟩ := h
  refine ⟨C + 4, by linarith, ?_⟩
  intro y hy q hq χ hχ
  let : NeZero q := ⟨hq.ne'⟩
  have hd : 0 < χ.conductor := Nat.pos_of_ne_zero χ.conductor_ne_zero
  have hdq : χ.conductor ≤ q := Nat.le_of_dvd hq χ.conductor_dvd_level
  have hprimitive : χ.primitiveCharacter ≠ 1 := by
    intro he
    apply hχ
    rw [← χ.changeLevel_primitiveCharacter, he, map_one]
  have hpbound := hbound y hy χ.conductor hd χ.primitiveCharacter hprimitive
    χ.primitiveCharacter_isPrimitive
  have hq1 : (1 : ℝ) ≤ q := by exact_mod_cast hq
  have hd1 : (1 : ℝ) ≤ χ.conductor := by exact_mod_cast hd
  have hq0 : (0 : ℝ) < q := by positivity
  have hy0 : 0 < y := by linarith
  have hlogd : 0 ≤ Real.log (5 * (χ.conductor : ℝ) * y) :=
    Real.log_nonneg (by nlinarith)
  have hlogs : Real.log (5 * (χ.conductor : ℝ) * y) ≤ Real.log (5 * (q : ℝ) * y) := by
    apply Real.log_le_log (by positivity)
    gcongr
  have hpbound' : ‖∑ p ∈ ambientPrimes y,
      χ.primitiveCharacter (p : ZMod χ.conductor)‖ ≤
      C * y ^ ((31 : ℝ) / 32) * (Real.log (5 * (q : ℝ) * y)) ^ 2 := by
    apply hpbound.trans
    gcongr
  have herr := norm_prime_sum_sub_primitive_le_two_log hq χ (ambientPrimes y)
    (fun p hp => ((mem_ambientPrimes_iff hy0.le).mp hp).1)
  have hlog2 : (1 : ℝ) / 2 ≤ Real.log 2 := by
    have hh := Real.one_sub_inv_le_log_of_pos (by norm_num : (0 : ℝ) < 2)
    norm_num at hh ⊢
    exact hh
  have hlogbig : (1 : ℝ) / 2 ≤ Real.log (5 * (q : ℝ) * y) :=
    hlog2.trans (Real.log_le_log (by norm_num) (by nlinarith))
  have hlogq : Real.log q ≤ Real.log (5 * (q : ℝ) * y) :=
    Real.log_le_log hq0 (by nlinarith)
  have hpow : 1 ≤ y ^ ((31 : ℝ) / 32) :=
    Real.one_le_rpow (by linarith) (by norm_num)
  have habsorb : 2 * Real.log q ≤
      4 * y ^ ((31 : ℝ) / 32) * (Real.log (5 * (q : ℝ) * y)) ^ 2 := by
    nlinarith [mul_nonneg (sub_nonneg.mpr hpow) (sq_nonneg (Real.log (5 * (q : ℝ) * y)))]
  calc
    ‖∑ p ∈ ambientPrimes y, χ (p : ZMod q)‖ =
        ‖((∑ p ∈ ambientPrimes y, χ (p : ZMod q)) -
          (∑ p ∈ ambientPrimes y, χ.primitiveCharacter (p : ZMod χ.conductor))) +
          (∑ p ∈ ambientPrimes y, χ.primitiveCharacter (p : ZMod χ.conductor))‖ := by
      rw [sub_add_cancel]
    _ ≤ ‖(∑ p ∈ ambientPrimes y, χ (p : ZMod q)) -
          (∑ p ∈ ambientPrimes y, χ.primitiveCharacter (p : ZMod χ.conductor))‖ +
          ‖∑ p ∈ ambientPrimes y, χ.primitiveCharacter (p : ZMod χ.conductor)‖ :=
      norm_add_le _ _
    _ ≤ 2 * Real.log q + C * y ^ ((31 : ℝ) / 32) * (Real.log (5 * (q : ℝ) * y)) ^ 2 :=
      add_le_add herr hpbound'
    _ ≤ (C + 4) * y ^ ((31 : ℝ) / 32) * (Real.log (5 * (q : ℝ) * y)) ^ 2 := by
      nlinarith


theorem primitive_prime_estimate_of_zero_free (hZ : PrimitiveZeroFreeHalfPlane) :
    PrimitivePrimeCharacterEstimateWeak := by
  obtain ⟨C, hC, hbound⟩ := primitive_twistedPsi_power_saving hZ
  refine ⟨20 * (2 * C + 4), by positivity, ?_⟩
  intro y hy q hq χ hχ hprim
  let ψ : PrimitiveComplexCharacter := ⟨q, hq, χ, hprim, hχ⟩
  apply prime_sum_bound_of_twistedPsi_weak χ hq (show 0 ≤ 2 * C by positivity) _ hy
  intro x hx
  have hb := hbound ψ x hx
  have hq1 : (1 : ℝ) ≤ q := by exact_mod_cast hq
  have hl2 : (1 : ℝ) / 2 ≤ Real.log 2 := by
    have h := Real.one_sub_inv_le_log_of_pos (by norm_num : (0 : ℝ) < 2)
    norm_num at h ⊢
    exact h
  have hl : (1 : ℝ) / 2 ≤ Real.log ((q : ℝ) * x) :=
    hl2.trans (Real.log_le_log (by norm_num) (by nlinarith))
  have hquad : Real.log ((q : ℝ) * x) ≤ 2 * (Real.log ((q : ℝ) * x)) ^ 2 := by nlinarith
  calc
    ‖twistedPsi χ x‖ ≤ C * x ^ ((31 : ℝ) / 32) * Real.log ((q : ℝ) * x) := hb
    _ ≤ C * x ^ ((31 : ℝ) / 32) * (2 * (Real.log ((q : ℝ) * x)) ^ 2) := by gcongr
    _ = _ := by ring

/-- The zero-free input alone supplies the ambient estimate through a
smoothed contour and finite unsmoothing. No sharp explicit formula is assumed. -/
theorem prime_estimate_of_zero_free (hZ : PrimitiveZeroFreeHalfPlane) :
    UniformPrimeCharacterEstimateAt ((31 : ℝ) / 32) :=
  uniformPrimeCharacterEstimate_of_primitive_weak (primitive_prime_estimate_of_zero_free hZ)

/-- The supplied proof now reduces to its two major external inputs only.
Neither the smooth-prime input nor the zero-free input is asserted here. -/
theorem target_of_smooth_primes_and_zero_free
    (hS : SmoothShiftedPrimeSupply) (hZ : PrimitiveZeroFreeHalfPlane) :
    fcTypeOfName% "Erdos1057.erdos_1057" :=
  target_of_smooth_primes_and_prime_estimate_at (by norm_num : (31 : ℝ) / 32 < 1)
    hS (prime_estimate_of_zero_free hZ)
end

section
open Finset Classical
theorem tiltedPhysicalBirthLaw_pos {G : Type*} {P : G → Finset ℕ}
    (V : G → ℝ) (g : G) (baseline : P g → ℝ) (hV : 0 < V g)
    (hpositive : ∀ p : P g, 0 < p.val) (hbaseline : ∀ p, 0 < baseline p)
    (p : P g) : 0 < tiltedPhysicalBirthLaw V g baseline p := by
  exact div_pos (div_pos zero_lt_one (mul_pos hV (Nat.cast_pos.mpr (hpositive p))))
    (hbaseline p)

theorem physical_bounded_ordered_state_weight_pos {G : Type*} {P : G → Finset ℕ}
    (V : G → ℝ) (g : G) (baseline : P g → ℝ) (hV : 0 < V g)
    (hpositive : ∀ p : P g, 0 < p.val) (hbaseline : ∀ p, 0 < baseline p)
    {t B : ℕ}
    (s : BoundedOrderedState (P g) (UnrestrictedResidueParticle (fun p : P g => p.val)) t B) :
    0 < boundedOrderedStateWeight (tiltedPhysicalBirthLaw V g baseline)
      (unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g baseline)) s := by
  apply mul_pos
  · exact prod_pos fun i _ => tiltedPhysicalBirthLaw_pos V g baseline hV hpositive hbaseline (s.1 i)
  · apply div_pos
    · exact prod_pos fun i _ => tiltedPhysicalBirthLaw_pos V g baseline hV hpositive hbaseline
        (s.2.2 i).1
    · exact Nat.cast_pos.mpr (Nat.factorial_pos _)

/-- The physical weighted square energy vanishes only for the zero function. -/
theorem physical_bounded_energy_eq_zero_iff {G : Type*} {P : G → Finset ℕ}
    (V : G → ℝ) (g : G) (baseline : P g → ℝ) (hV : 0 < V g)
    (hpositive : ∀ p : P g, 0 < p.val) (hbaseline : ∀ p, 0 < baseline p)
    (t B : ℕ)
    (f : BoundedOrderedState (P g) (UnrestrictedResidueParticle (fun p : P g => p.val)) t B → ℂ) :
    let _ : ∀ p : P g, NeZero p.val := fun p => ⟨Nat.ne_of_gt (hpositive p)⟩
    (∑ s : BoundedOrderedState (P g) (UnrestrictedResidueParticle (fun p : P g => p.val)) t B,
      boundedOrderedStateWeight (tiltedPhysicalBirthLaw V g baseline)
        (unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g baseline)) s * ‖f s‖ ^ 2) = 0 ↔
      f = 0 := by
  let _ : ∀ p : P g, NeZero p.val := fun p => ⟨Nat.ne_of_gt (hpositive p)⟩
  dsimp only
  have hw (s : BoundedOrderedState (P g)
      (UnrestrictedResidueParticle (fun p : P g => p.val)) t B) :=
    physical_bounded_ordered_state_weight_pos V g baseline hV hpositive hbaseline s
  rw [sum_eq_zero_iff_of_nonneg (fun s _ => mul_nonneg (hw s).le (sq_nonneg ‖f s‖))]
  constructor
  · intro hf
    funext s
    have hs := hf s (mem_univ s)
    exact norm_eq_zero.mp (sq_eq_zero_iff.mp ((mul_eq_zero.mp hs).resolve_left (hw s).ne'))
  · intro hf
    subst f
    simp

/-- The concrete tilted law supplies nonnegativity and fresh mass at most
two. The bound has no remaining abstract duality or column-estimate premise. -/
theorem physical_unrestricted_bounded_operator_energy_le {G : Type*} {P : G → Finset ℕ}
    (V : G → ℝ) (g : G) (baseline : P g → ℝ)
    (hpositive : ∀ p : P g, 0 < p.val)
    (hMass : ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (hbaseline : ∀ p, 1 / 2 ≤ baseline p ∧ baseline p ≤ 1)
    (Δ D : ℤ) {ρ v vmin vmax : ℝ}
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : vmin ≤ V g) (hVhi : V g ≤ vmax)
    (t B T : ℕ) (ht : t ≤ T)
    (phase : UnrestrictedBoundedPhase (fun p : P g => p.val) Δ D t B)
    (hphase : ∀ s stores promotions e fresh, ‖phase s stores promotions e fresh‖ ≤ 1)
    (f : BoundedOrderedState (P g) (UnrestrictedResidueParticle (fun p : P g => p.val)) t B → ℂ)
    (hf : BoundedOrderedSymmetric f) :
    let _ : ∀ p : P g, NeZero p.val := fun p => ⟨Nat.ne_of_gt (hpositive p)⟩
    (∑ s : BoundedOrderedState (P g) (UnrestrictedResidueParticle (fun p : P g => p.val)) t B,
      boundedOrderedStateWeight (tiltedPhysicalBirthLaw V g baseline)
        (unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g baseline)) s *
        ‖unrestrictedBoundedOperator (fun p : P g => p.val) Δ D
          (tiltedPhysicalBirthLaw V g baseline) ρ (V g) t B phase f s‖ ^ 2) ≤
      (unrestrictedEdgeRowBound ρ v vmin T) ^ 2 * unrestrictedEdgeReversalBound vmin vmax T *
        ∑ s : BoundedOrderedState (P g) (UnrestrictedResidueParticle (fun p : P g => p.val)) t B,
          boundedOrderedStateWeight (tiltedPhysicalBirthLaw V g baseline)
            (unrestrictedResidueWeight (tiltedPhysicalBirthLaw V g baseline)) s * ‖f s‖ ^ 2 := by
  let _ : ∀ p : P g, NeZero p.val := fun p => ⟨Nat.ne_of_gt (hpositive p)⟩
  have hV : 0 < V g := hvmin.trans_le hVlo
  apply unrestricted_bounded_operator_energy_le (fun p : P g => p.val) Δ D
    (tiltedPhysicalBirthLaw V g baseline) hρ0 hρ1 hv hvmin hVlo hVhi
    _ _ t B T ht phase hphase f hf
  · intro p
    exact tiltedPhysicalBirthLaw_nonneg V g baseline hV.le
      (fun q => (by norm_num : (0 : ℝ) ≤ 1 / 2).trans (hbaseline q).1) p
  · exact (tiltedPhysicalBirthLaw_sum_bounds V g baseline hV hMass hbaseline).2
end

section
open Finset Classical
noncomputable def finiteWeightedEnergy {X : Type*} [Fintype X]
    (μ : X → ℝ) (f : X → ℂ) : ℝ := ∑ x, μ x * ‖f x‖ ^ 2

noncomputable def finiteProductWeight {I : Type*} [Fintype I]
    {X : I → Type*} (μ : ∀ i, X i → ℝ) (x : ∀ i, X i) : ℝ := ∏ i, μ i (x i)

noncomputable def finiteCoordinateLift {I : Type*} [DecidableEq I]
    {X : I → Type*} (i : I) (A : (X i → ℂ) → X i → ℂ)
    (f : (∀ j, X j) → ℂ) (x : ∀ j, X j) : ℂ :=
  let E := Equiv.piSplitAt i X
  A (fun y => f (E.symm (y, (E x).2))) (E x).1

theorem finite_product_weight_split {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} (μ : ∀ i, X i → ℝ) (i : I) (x : ∀ j, X j) :
    finiteProductWeight μ x = μ i (x i) * ∏ j : {j : I // j ≠ i}, μ j.val (x j.val) := by
  have h := Fintype.prod_subtype_mul_prod_subtype (fun j => j = i) (fun j => μ j (x j))
  have heq (j : {j : I // j = i}) : μ j.val (x j.val) = μ i (x i) := by
    rcases j with ⟨j, rfl⟩
    rfl
  simpa only [finiteProductWeight, Fintype.prod_unique, heq] using h.symm

theorem finite_coordinate_lift_split {I : Type*} [DecidableEq I]
    {X : I → Type*} (i : I) (A : (X i → ℂ) → X i → ℂ)
    (f : (∀ j, X j) → ℂ) (y : X i) (z : ∀ j : {j : I // j ≠ i}, X j.val) :
    finiteCoordinateLift i A f ((Equiv.piSplitAt i X).symm (y, z)) =
      A (fun y' => f ((Equiv.piSplitAt i X).symm (y', z))) y := by
  simp only [finiteCoordinateLift, Equiv.apply_symm_apply]

/-- The split-coordinate definition is literal replacement of coordinate i. -/
theorem finite_split_replace_eq_update {I : Type*} [DecidableEq I]
    {X : I → Type*} (i : I) (x : ∀ j, X j) (y : X i) :
    (Equiv.piSplitAt i X).symm (y, (Equiv.piSplitAt i X x).2) = Function.update x i y := by
  funext j
  by_cases h : j = i
  · subst j
    simp [Equiv.piSplitAt]
  · simp [Equiv.piSplitAt, h]

theorem finite_coordinate_lift_eq_update {I : Type*} [DecidableEq I]
    {X : I → Type*} (i : I) (A : (X i → ℂ) → X i → ℂ)
    (f : (∀ j, X j) → ℂ) (x : ∀ j, X j) :
    finiteCoordinateLift i A f x = A (fun y => f (Function.update x i y)) (x i) := by
  unfold finiteCoordinateLift
  simp only [finite_split_replace_eq_update]
  rfl

/-- Exact energy disintegration into the chosen coordinate and its complement. -/
theorem finite_product_energy_split {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (i : I) (f : (∀ j, X j) → ℂ) :
    finiteWeightedEnergy (finiteProductWeight μ) f =
      ∑ z : (∀ j : {j : I // j ≠ i}, X j.val),
        (∏ j, μ j.val (z j)) *
          finiteWeightedEnergy (μ i) (fun y => f ((Equiv.piSplitAt i X).symm (y, z))) := by
  let E := Equiv.piSplitAt i X
  unfold finiteWeightedEnergy
  rw [← E.symm.sum_comp, Fintype.sum_prod_type, sum_comm]
  apply sum_congr rfl
  intro z hz
  rw [mul_sum]
  apply sum_congr rfl
  intro y hy
  rw [finite_product_weight_split μ i]
  have hE := E.apply_symm_apply (y, z)
  have hfirst : E.symm (y, z) i = y := congrArg Prod.fst hE
  have hrest : (fun j : {j : I // j ≠ i} => E.symm (y, z) j.val) = z :=
    congrArg Prod.snd hE
  have hprod : (∏ j : {j : I // j ≠ i}, μ j.val (E.symm (y, z) j.val)) =
      ∏ j, μ j.val (z j) := congrArg (fun q => ∏ j, μ j.val (q j)) hrest
  rw [hfirst, hprod]
  ring

/-- A full-domain coordinate energy bound lifts to the dependent product.
Only the complementary measure factors need nonnegativity. -/
theorem finite_coordinate_lift_energy_le {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hμ : ∀ i x, 0 ≤ μ i x) (i : I) (A : (X i → ℂ) → X i → ℂ) (C : ℝ)
    (hA : ∀ f, finiteWeightedEnergy (μ i) (A f) ≤ C * finiteWeightedEnergy (μ i) f)
    (f : (∀ j, X j) → ℂ) :
    finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateLift i A f) ≤
      C * finiteWeightedEnergy (finiteProductWeight μ) f := by
  rw [finite_product_energy_split μ i, finite_product_energy_split μ i]
  simp_rw [finite_coordinate_lift_split]
  rw [mul_sum]
  apply sum_le_sum
  intro z hz
  calc
    _ ≤ (∏ j : {j : I // j ≠ i}, μ j.val (z j)) *
        (C * finiteWeightedEnergy (μ i) (fun y => f ((Equiv.piSplitAt i X).symm (y, z)))) :=
      mul_le_mul_of_nonneg_left (hA _) (prod_nonneg fun j _ => hμ _ _)
    _ = _ := by ring

/-- An ordered composition of coordinate actions, with the head acting last.
The list may repeat coordinates and no commutation assumption is made. -/
noncomputable def finiteCoordinateCompose {I : Type*} [DecidableEq I]
    {X : I → Type*} (A : ∀ i, (X i → ℂ) → X i → ℂ) :
    List I → ((∀ i, X i) → ℂ) → ((∀ i, X i) → ℂ)
  | [], f => f
  | i :: is, f => finiteCoordinateLift i (A i) (finiteCoordinateCompose A is f)

/-- Coordinate energy constants multiply under arbitrary ordered composition. -/
theorem finite_coordinate_compose_energy_le {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hμ : ∀ i x, 0 ≤ μ i x) (A : ∀ i, (X i → ℂ) → X i → ℂ)
    (C : I → ℝ) (hC : ∀ i, 0 ≤ C i)
    (hA : ∀ i f, finiteWeightedEnergy (μ i) (A i f) ≤ C i * finiteWeightedEnergy (μ i) f)
    (is : List I) (f : (∀ i, X i) → ℂ) :
    finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateCompose A is f) ≤
      (is.map C).prod * finiteWeightedEnergy (finiteProductWeight μ) f := by
  induction is with
  | nil => simp [finiteCoordinateCompose]
  | cons i is ih =>
    calc
      _ ≤ C i * finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateCompose A is f) :=
        finite_coordinate_lift_energy_le μ hμ i (A i) (C i) (hA i) _
      _ ≤ C i * ((is.map C).prod * finiteWeightedEnergy (finiteProductWeight μ) f) :=
        mul_le_mul_of_nonneg_left ih (hC i)
      _ = _ := by simp only [List.map_cons, List.prod_cons, mul_assoc]

/-- A canonical ordered action of a finite set of coordinates. This definition
chooses an order; its energy estimate does not require order independence. -/
noncomputable def finiteCoordinateFinsetAction {I : Type*} [DecidableEq I]
    {X : I → Type*} (A : ∀ i, (X i → ℂ) → X i → ℂ)
    (s : Finset I) (f : (∀ i, X i) → ℂ) : (∀ i, X i) → ℂ :=
  finiteCoordinateCompose A s.toList f

theorem finite_coordinate_finset_energy_le {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hμ : ∀ i x, 0 ≤ μ i x) (A : ∀ i, (X i → ℂ) → X i → ℂ)
    (C : I → ℝ) (hC : ∀ i, 0 ≤ C i)
    (hA : ∀ i f, finiteWeightedEnergy (μ i) (A i f) ≤ C i * finiteWeightedEnergy (μ i) f)
    (s : Finset I) (f : (∀ i, X i) → ℂ) :
    finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateFinsetAction A s f) ≤
      (∏ i ∈ s, C i) * finiteWeightedEnergy (finiteProductWeight μ) f := by
  simpa only [finiteCoordinateFinsetAction, prod_map_toList] using
    finite_coordinate_compose_energy_le μ hμ A C hC hA s.toList f
end

section
open Finset Classical
/-- Jensen's inequality for the actual finite permutation average. -/
theorem birthPermutationAverage_norm_sq_le {Z : Type*} {n : ℕ}
    (φ : (Fin n → Z) → ℂ) (q : Fin n → Z) :
    ‖birthPermutationAverage φ q‖ ^ 2 ≤
      (Fintype.card (Equiv.Perm (Fin n)) : ℝ)⁻¹ *
        ∑ σ : Equiv.Perm (Fin n), ‖φ (fun j => q (σ j))‖ ^ 2 := by
  have hc : (0 : ℝ) < Fintype.card (Equiv.Perm (Fin n)) := by
    exact_mod_cast Fintype.card_pos
  have hsum := complex_row_weighted_cauchy (univ : Finset (Equiv.Perm (Fin n)))
    (fun _ => 1) (fun σ => φ (fun j => q (σ j))) (fun _ => 1) (by intros; norm_num)
  have hsum' : ‖∑ σ : Equiv.Perm (Fin n), φ (fun j => q (σ j))‖ ^ 2 ≤
      (Fintype.card (Equiv.Perm (Fin n)) : ℝ) *
        ∑ σ : Equiv.Perm (Fin n), ‖φ (fun j => q (σ j))‖ ^ 2 := by
    simpa using hsum
  unfold birthPermutationAverage
  rw [norm_mul, norm_inv, Complex.norm_natCast, mul_pow]
  calc
    _ ≤ ((Fintype.card (Equiv.Perm (Fin n)) : ℝ)⁻¹) ^ 2 *
        ((Fintype.card (Equiv.Perm (Fin n)) : ℝ) *
          ∑ σ : Equiv.Perm (Fin n), ‖φ (fun j => q (σ j))‖ ^ 2) :=
      mul_le_mul_of_nonneg_left hsum' (sq_nonneg _)
    _ = _ := by field_simp

/-- A real invariant weight gives an exact permutation change of variables. -/
theorem birth_permutation_weighted_energy_eq {Z : Type*} [Fintype Z] {n : ℕ}
    (W : (Fin n → Z) → ℝ) (φ : (Fin n → Z) → ℂ)
    (hW : ∀ q (σ : Equiv.Perm (Fin n)), W (fun j => q (σ j)) = W q)
    (σ : Equiv.Perm (Fin n)) :
    (∑ q : Fin n → Z, W q * ‖φ (fun j => q (σ j))‖ ^ 2) =
      ∑ q : Fin n → Z, W q * ‖φ q‖ ^ 2 := by
  have h := (birthAssignmentPermutation (α := Z) σ).sum_comp (fun q => W q * ‖φ q‖ ^ 2)
  simpa only [birthAssignmentPermutation, Equiv.coe_fn_mk, hW] using h

/-- Permutation averaging contracts energy under any nonnegative invariant
finite weight, without assuming that the test is symmetric. -/
theorem birthPermutationAverage_energy_le {Z : Type*} [Fintype Z] {n : ℕ}
    (W : (Fin n → Z) → ℝ) (φ : (Fin n → Z) → ℂ)
    (hW0 : ∀ q, 0 ≤ W q)
    (hW : ∀ q (σ : Equiv.Perm (Fin n)), W (fun j => q (σ j)) = W q) :
    (∑ q : Fin n → Z, W q * ‖birthPermutationAverage φ q‖ ^ 2) ≤
      ∑ q : Fin n → Z, W q * ‖φ q‖ ^ 2 := by
  have hc : (Fintype.card (Equiv.Perm (Fin n)) : ℝ) ≠ 0 := by
    exact_mod_cast Fintype.card_ne_zero
  calc
    _ ≤ ∑ q : Fin n → Z, W q *
        ((Fintype.card (Equiv.Perm (Fin n)) : ℝ)⁻¹ *
          ∑ σ : Equiv.Perm (Fin n), ‖φ (fun j => q (σ j))‖ ^ 2) :=
      sum_le_sum fun q _ => mul_le_mul_of_nonneg_left (birthPermutationAverage_norm_sq_le φ q) (hW0 q)
    _ = (Fintype.card (Equiv.Perm (Fin n)) : ℝ)⁻¹ *
        ∑ σ : Equiv.Perm (Fin n), ∑ q : Fin n → Z,
          W q * ‖φ (fun j => q (σ j))‖ ^ 2 := by
      rw [sum_comm]
      simp_rw [mul_sum]
      apply sum_congr rfl
      intro q _
      apply sum_congr rfl
      intro σ _
      ring
    _ = (Fintype.card (Equiv.Perm (Fin n)) : ℝ)⁻¹ *
        ∑ _σ : Equiv.Perm (Fin n), ∑ q : Fin n → Z, W q * ‖φ q‖ ^ 2 := by
      simp_rw [birth_permutation_weighted_energy_eq W φ hW]
    _ = _ := by
      simp only [sum_const, card_univ, nsmul_eq_mul]
      rw [← mul_assoc, inv_mul_cancel₀ hc, one_mul]

/-- Average only the memory indices, keeping active labels and length fixed. -/
noncomputable def boundedMemorySymmetrize {P Z : Type*} {t B : ℕ}
    (f : BoundedOrderedState P Z t B → ℂ)
    (s : BoundedOrderedState P Z t B) : ℂ :=
  birthPermutationAverage (fun q => f (s.1, ⟨s.2.1, q⟩)) s.2.2

theorem boundedMemorySymmetrize_symmetric {P Z : Type*} {t B : ℕ}
    (f : BoundedOrderedState P Z t B → ℂ) :
    BoundedOrderedSymmetric (boundedMemorySymmetrize f) := by
  intro active N q τ
  exact birthPermutationAverage_invariant (fun q => f (active, ⟨N, q⟩)) q τ

theorem boundedMemorySymmetrize_eq_self {P Z : Type*} {t B : ℕ}
    (f : BoundedOrderedState P Z t B → ℂ) (hf : BoundedOrderedSymmetric f) :
    boundedMemorySymmetrize f = f := by
  funext s
  have hc : (Fintype.card (Equiv.Perm (Fin s.2.1.val)) : ℂ) ≠ 0 := by
    exact_mod_cast Fintype.card_ne_zero
  have hs (σ : Equiv.Perm (Fin s.2.1.val)) :
      f (s.1, ⟨s.2.1, fun j => s.2.2 (σ j)⟩) = f s := hf s.1 s.2.1 s.2.2 σ
  unfold boundedMemorySymmetrize birthPermutationAverage
  simp_rw [hs]
  simp only [sum_const, card_univ, nsmul_eq_mul]
  rw [← mul_assoc, inv_mul_cancel₀ hc, one_mul]

theorem boundedMemorySymmetrize_idempotent {P Z : Type*} {t B : ℕ}
    (f : BoundedOrderedState P Z t B → ℂ) :
    boundedMemorySymmetrize (boundedMemorySymmetrize f) = boundedMemorySymmetrize f :=
  boundedMemorySymmetrize_eq_self _ (boundedMemorySymmetrize_symmetric f)

/-- The actual active-product and factorial-memory measure is invariant under
the local average, which therefore contracts its weighted energy. -/
theorem boundedMemorySymmetrize_energy_le {P Z : Type*} [Fintype P] [Fintype Z]
    {t B : ℕ} (μ : P → ℝ) (ν : Z → ℝ)
    (hμ : ∀ p, 0 ≤ μ p) (hν : ∀ z, 0 ≤ ν z)
    (f : BoundedOrderedState P Z t B → ℂ) :
    (∑ s : BoundedOrderedState P Z t B,
      boundedOrderedStateWeight μ ν s * ‖boundedMemorySymmetrize f s‖ ^ 2) ≤
    ∑ s : BoundedOrderedState P Z t B, boundedOrderedStateWeight μ ν s * ‖f s‖ ^ 2 := by
  rw [Fintype.sum_prod_type, Fintype.sum_prod_type]
  apply sum_le_sum
  intro active _
  rw [Fintype.sum_sigma, Fintype.sum_sigma]
  apply sum_le_sum
  intro N _
  apply birthPermutationAverage_energy_le
    (fun q => boundedOrderedStateWeight μ ν (active, ⟨N, q⟩))
    (fun q => f (active, ⟨N, q⟩))
  · intro q
    exact boundedOrderedStateWeight_nonneg μ ν hμ hν _
  · intro q σ
    unfold boundedOrderedStateWeight boundedOrderedMemoryWeight
    rw [Equiv.prod_comp σ (fun j => ν (q j))]

/-- Precomposing with the actual permutation average extends an energy
estimate on symmetric inputs to every bounded-state input. -/
theorem boundedMemorySymmetrize_transfer_energy_le {P Z : Type*}
    [Fintype P] [Fintype Z] {t B : ℕ} (μ : P → ℝ) (ν : Z → ℝ)
    (hμ : ∀ p, 0 ≤ μ p) (hν : ∀ z, 0 ≤ ν z) {C : ℝ} (hC : 0 ≤ C)
    (T : (BoundedOrderedState P Z t B → ℂ) → BoundedOrderedState P Z t B → ℂ)
    (hT : ∀ g, BoundedOrderedSymmetric g →
      (∑ s : BoundedOrderedState P Z t B, boundedOrderedStateWeight μ ν s * ‖T g s‖ ^ 2) ≤
        C * ∑ s : BoundedOrderedState P Z t B, boundedOrderedStateWeight μ ν s * ‖g s‖ ^ 2)
    (f : BoundedOrderedState P Z t B → ℂ) :
    (∑ s : BoundedOrderedState P Z t B,
      boundedOrderedStateWeight μ ν s * ‖T (boundedMemorySymmetrize f) s‖ ^ 2) ≤
      C * ∑ s : BoundedOrderedState P Z t B, boundedOrderedStateWeight μ ν s * ‖f s‖ ^ 2 :=
  (hT _ (boundedMemorySymmetrize_symmetric f)).trans
    (mul_le_mul_of_nonneg_left (boundedMemorySymmetrize_energy_le μ ν hμ hν f) hC)
end

section
open Finset Classical
abbrev ProductBoundedOrderedState {G : Type*} (P Z : G → Type*)
    (t : G → ℕ) (B : ℕ) :=
  ∀ g, BoundedOrderedState (P g) (Z g) (t g) B

noncomputable def productMemoryWeight {G : Type*} [Fintype G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (x : ProductBoundedOrderedState P Z t B) : ℝ :=
  ∏ g, boundedOrderedStateWeight (μ g) (ν g) (x g)

noncomputable def productTotalMemory {G : Type*} [Fintype G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (x : ProductBoundedOrderedState P Z t B) : ℕ :=
  ∑ g, (x g).2.1.val

noncomputable def productMemoryCutoff {G : Type*} [Fintype G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ} {K : Type*} [Zero K]
    (f : ProductBoundedOrderedState P Z t B → K)
    (x : ProductBoundedOrderedState P Z t B) : K :=
  if productTotalMemory x ≤ B then f x else 0

theorem productMemoryWeight_nonneg {G : Type*} [Fintype G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hν : ∀ g z, 0 ≤ ν g z)
    (x : ProductBoundedOrderedState P Z t B) : 0 ≤ productMemoryWeight μ ν x :=
  prod_nonneg fun g _ => boundedOrderedStateWeight_nonneg (μ g) (ν g) (hμ g) (hν g) (x g)

theorem productMemoryCutoff_norm_le {G : Type*} [Fintype G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (f : ProductBoundedOrderedState P Z t B → ℂ)
    (x : ProductBoundedOrderedState P Z t B) : ‖productMemoryCutoff f x‖ ≤ ‖f x‖ := by
  unfold productMemoryCutoff
  split_ifs
  · exact le_rfl
  · simpa only [norm_zero] using norm_nonneg (f x)

theorem productMemoryCutoff_energy_le {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    {t : G → ℕ} {B : ℕ}
    (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hν : ∀ g z, 0 ≤ ν g z)
    (f : ProductBoundedOrderedState P Z t B → ℂ) :
    (∑ x : ProductBoundedOrderedState P Z t B,
      productMemoryWeight μ ν x * ‖productMemoryCutoff f x‖ ^ 2) ≤
      ∑ x : ProductBoundedOrderedState P Z t B, productMemoryWeight μ ν x * ‖f x‖ ^ 2 := by
  apply sum_le_sum
  intro x hx
  apply mul_le_mul_of_nonneg_left _ (productMemoryWeight_nonneg μ ν hμ hν x)
  exact (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mpr (productMemoryCutoff_norm_le f x)

theorem productMemoryCutoff_idempotent {G : Type*} [Fintype G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ} {K : Type*} [Zero K]
    (f : ProductBoundedOrderedState P Z t B → K) :
    productMemoryCutoff (productMemoryCutoff f) = productMemoryCutoff f := by
  funext x
  unfold productMemoryCutoff
  split_ifs <;> rfl

/-- Reorder one group's old memory, leaving every active tuple and all
other groups unchanged. -/
def productMemoryPermuteAt {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (x : ProductBoundedOrderedState P Z t B) (g : G)
    (τ : Equiv.Perm (Fin (x g).2.1.val)) : ProductBoundedOrderedState P Z t B :=
  Function.update x g ((x g).1, ⟨(x g).2.1, (x g).2.2 ∘ τ⟩)

theorem productTotalMemory_permuteAt {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (x : ProductBoundedOrderedState P Z t B) (g : G)
    (τ : Equiv.Perm (Fin (x g).2.1.val)) :
    productTotalMemory (productMemoryPermuteAt x g τ) = productTotalMemory x := by
  apply sum_congr rfl
  intro h hh
  by_cases heq : h = g
  · subst h
    simp [productMemoryPermuteAt]
  · simp [productMemoryPermuteAt, heq]

def ProductMemorySymmetric {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ} {K : Type*}
    (f : ProductBoundedOrderedState P Z t B → K) : Prop :=
  ∀ x g τ, f (productMemoryPermuteAt x g τ) = f x

theorem productMemoryCutoff_symmetric {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ} {K : Type*} [Zero K]
    (f : ProductBoundedOrderedState P Z t B → K) (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric (productMemoryCutoff f) := by
  intro x g τ
  simp only [productMemoryCutoff, productTotalMemory_permuteAt, hf x g τ]
end

section
open Finset Filter
open scoped Topology
noncomputable def candidatePHarmonicTerm (s L q : ℝ) (n : ℕ) : ℝ :=
  oneMarkedGroupTerm (candidatePIndices s L) (candidatePBand (s * L)) q
    (fun j => ∑ p ∈ candidatePBand (s * L) j, 1 / (p : ℝ)) n

noncomputable def candidateSmallPHarmonicMass (s L q X : ℝ) : ℝ :=
  ∑' n : Nat.factoredNumbers ((candidatePIndices s L).biUnion (candidatePBand (s * L))),
    if (n.val : ℝ) < X then candidatePHarmonicTerm s L q n.val else 0

theorem candidate_P_harmonic_summable {s L : ℝ} (hsL : 0 ≤ s * L) (q : ℝ) :
    Summable (fun n : Nat.factoredNumbers ((candidatePIndices s L).biUnion (candidatePBand (s * L))) =>
      candidatePHarmonicTerm s L q n.val) := by
  have hpair := pairwise_disjoint_dyadicPrimeBand (s := s * L) (lower := (3/2 : ℝ))
    (upper := (9/5 : ℝ)) hsL (by norm_num) (by norm_num)
  exact (one_marked_groups_summable_and_sum (candidatePIndices s L) (candidatePBand (s * L))
    (fun i _ j _ hij => hpair hij) (fun _ _ _ hp => (mem_filter.mp hp).2) q _).1

theorem candidate_small_P_harmonic_summable {s L : ℝ} (hsL : 0 ≤ s * L) (q X : ℝ) :
    Summable (fun n : Nat.factoredNumbers ((candidatePIndices s L).biUnion (candidatePBand (s * L))) =>
      if (n.val : ℝ) < X then candidatePHarmonicTerm s L q n.val else 0) := by
  simpa only [Set.indicator, Set.mem_ofPred_eq] using!
    (candidate_P_harmonic_summable hsL q).indicator {n | (n.val : ℝ) < X}

theorem candidate_P_small_add_tail {s L : ℝ} (hsL : 0 ≤ s * L) (q X : ℝ) :
    candidateSmallPHarmonicMass s L q X + candidateMarkedSmoothTail s L q 1 X =
      candidateOneMarkedHarmonicMass s L q := by
  have hsmall := candidate_small_P_harmonic_summable hsL q X
  have hbig : Summable (fun n : Nat.factoredNumbers ((candidatePIndices s L).biUnion (candidatePBand (s * L))) =>
      if X ≤ (n.val : ℝ) then candidatePHarmonicTerm s L q n.val else 0) := by
    simpa only [Set.indicator, Set.mem_ofPred_eq] using!
      (candidate_P_harmonic_summable hsL q).indicator {n | X ≤ (n.val : ℝ)}
  change (∑' n : Nat.factoredNumbers ((candidatePIndices s L).biUnion (candidatePBand (s * L))),
    if (n.val : ℝ) < X then candidatePHarmonicTerm s L q n.val else 0) +
    (∑' n : Nat.factoredNumbers ((candidatePIndices s L).biUnion (candidatePBand (s * L))),
    if X ≤ (n.val : ℝ) then candidatePHarmonicTerm s L q n.val else 0) = _
  rw [← hsmall.tsum_add hbig]
  apply tsum_congr
  intro n
  by_cases hn : (n.val : ℝ) < X
  · simp only [hn, not_le.mpr hn, if_true, if_false, add_zero, candidatePHarmonicTerm]
  · simp only [hn, le_of_not_gt hn, if_true, if_false, zero_add, candidatePHarmonicTerm]

theorem candidate_small_P_harmonic_nonneg (s L q X : ℝ) (hq : 0 ≤ q) :
    0 ≤ candidateSmallPHarmonicMass s L q X := by
  apply tsum_nonneg
  intro n
  split_ifs
  · apply div_nonneg
    · exact marked_divisor_weight_nonneg _ _ hq _ _
        (fun _ _ => sum_nonneg (fun _ _ => by positivity)) _
    · exact Nat.cast_nonneg _
  · exact le_rfl

theorem eventually_candidate_small_P_half_mass {s q κ : ℝ}
    (hs : 0 < s) (hq0 : 0 ≤ q) (hq1 : q < 1) (hκ : 0 < κ) :
    ∀ᶠ L : ℝ in atTop,
      candidateOneMarkedHarmonicMass s L q / 2 ≤
        candidateSmallPHarmonicMass s L q (Real.exp (κ * L)) := by
  filter_upwards [eventually_candidate_one_marked_mass_ge_one hs hq0 hq1.le,
    eventually_candidate_marked_smooth_tail_power_saving hs hq0 hq1 hκ 1 1,
    eventually_ge_atTop (2 : ℝ)] with L hmass htail hL
  have hL0 : 0 < L := by linarith
  have hpart := candidate_P_small_add_tail (mul_nonneg hs.le hL0.le) q (Real.exp (κ * L))
  have hhalf : L^(-(1 : ℝ)) ≤ 1/2 := by
    rw [Real.rpow_neg_one]
    simpa only [one_div] using one_div_le_one_div_of_le (by norm_num : (0 : ℝ) < 2) hL
  linarith
end

section
open Finset
theorem ordered_slot_tuple_harmonic_sum {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) :
    (∑ x : ∀ i, choices i, 1 / (orderedSlotProduct choices x : ℝ)) =
      ∏ i, ∑ p ∈ choices i, 1 / (p : ℝ) := by
  classical
  simp_rw [orderedSlotProduct, Nat.cast_prod, one_div, ← Finset.prod_inv_distrib]
  calc
    _ = ∏ i, ∑ p : choices i, (p.val : ℝ)⁻¹ :=
      (Fintype.prod_sum (fun i (p : choices i) => (p.val : ℝ)⁻¹)).symm
    _ = _ := prod_congr rfl (fun i _ => Finset.sum_coe_sort (choices i) (fun p => (p : ℝ)⁻¹))

theorem ordered_slot_harmonic_eq_tuple_sum {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (normalization : ℝ) :
    (∑' n : ℕ, orderedSlotWeight choices normalization n / (n : ℝ)) =
      ∑ x : ∀ i, choices i, (1 / (orderedSlotProduct choices x : ℝ)) / normalization := by
  rw [ordered_slot_harmonic_sum, ← ordered_slot_tuple_harmonic_sum choices, sum_div]
end

section
open Finset Filter
open scoped Topology
noncomputable def candidatePrefixRestChoices (c L eps : ℝ) (r jStar J : ℕ) (hr : 0 < r)
    (slot : {slot : (candidateQIndices c L) × Fin r // slot ≠ candidateFreeSlot c L r hr}) : Finset ℕ :=
  candidatePrefixChoices c L eps r jStar J slot.val

noncomputable def candidatePrefixRestHarmonicMass (c L eps : ℝ) (r jStar J : ℕ) (hr : 0 < r) : ℝ :=
  ∑' n : ℕ,
    orderedSlotWeight
      (candidatePrefixRestChoices c L eps r jStar J hr)
      ((r.factorial : ℝ)^(candidateQIndices c L).card) n / (n : ℝ)

theorem candidate_free_slot_not_in_prefix (c L : ℝ) (r J : ℕ) (hr : 0 < r) :
    candidateFreeSlot c L r hr ∉ candidatePrefixSlots c L r J := by
  simp [candidateFreeSlot, candidatePrefixSlots]

theorem candidate_prefix_free_choice (c L eps : ℝ) (r jStar J : ℕ) (hr : 0 < r)
    (hJ : J < jStar) :
    candidatePrefixChoices c L eps r jStar J (candidateFreeSlot c L r hr) = candidateQBand (c * L) 0 := by
  rw [candidatePrefixChoices, restrictedSlotChoices,
    if_neg (candidate_free_slot_not_in_prefix c L r J hr)]
  have hnot : (0 : ℕ) ≠ jStar := by omega
  simp only [candidateQSlotChoices, candidateFreeSlot, hnot, false_and, if_false]

theorem candidate_prefix_mass_free_factor (c L eps : ℝ) (r jStar J : ℕ) (hr : 0 < r)
    (hJ : J < jStar) :
    candidatePrefixHarmonicMass c L eps r jStar J =
      (∑ p ∈ candidateQBand (c * L) 0, 1 / (p : ℝ)) *
        candidatePrefixRestHarmonicMass c L eps r jStar J hr := by
  have h := ordered_slot_harmonic_split (candidatePrefixChoices c L eps r jStar J)
    (candidateFreeSlot c L r hr) ((r.factorial : ℝ)^(candidateQIndices c L).card)
  rw [candidate_prefix_free_choice c L eps r jStar J hr hJ] at h
  exact h

theorem candidate_prefix_rest_mass_nonneg (c L eps : ℝ) (r jStar J : ℕ) (hr : 0 < r) :
    0 ≤ candidatePrefixRestHarmonicMass c L eps r jStar J hr := by
  apply tsum_nonneg
  intro n
  exact div_nonneg (ordered_slot_weight_nonneg _ (by positivity) n) (Nat.cast_nonneg n)

theorem exists_candidate_prefix_rest_mass_fraction {c eps : ℝ} (hc : 0 < c)
    (heps0 : 0 < eps) (heps1 : eps ≤ 1/10) (r J : ℕ) (hr : 0 < r) :
    ∃ rho : ℝ, 0 < rho ∧ ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, J < jStar →
      rho * candidateQHarmonicMass c L r jStar ≤
        candidatePrefixRestHarmonicMass c L eps r jStar J hr := by
  obtain ⟨rho, hrho, hmass⟩ := exists_candidate_prefix_harmonic_fraction hc heps0 heps1 r J
  obtain ⟨v, V, _, hV, hband⟩ := exists_candidateQBands_bounds hc
  refine ⟨rho / V, div_pos hrho hV, ?_⟩
  filter_upwards [hmass, hband] with L hm hb
  intro jStar hJ
  have hzero : 0 ∈ candidateQIndices c L := by simp [candidateQIndices]
  have hupper := (hb.2.2 0 hzero).2.2.2
  have h := hm jStar hJ
  rw [candidate_prefix_mass_free_factor c L eps r jStar J hr hJ] at h
  have h' := h.trans (mul_le_mul_of_nonneg_right hupper
    (candidate_prefix_rest_mass_nonneg c L eps r jStar J hr))
  calc
    (rho / V) * candidateQHarmonicMass c L r jStar =
        (rho * candidateQHarmonicMass c L r jStar) / V := by ring
    _ ≤ _ := (div_le_iff₀ hV).mpr (by simpa only [mul_comm V] using h')
end

section
open Finset
theorem indexed_free_prime_mass_lower {T : Type*} [Fintype T]
    (S P : Finset ℕ) (W : ℕ → ℝ) (R : T → ℕ) (N X H : ℝ)
    (hN : 0 ≤ N) (hW : ∀ n ∈ S, 0 ≤ W n)
    (hcount : ∀ n ∈ S, ∀ t : T,
      (X / ((n * R t : ℕ) : ℝ)) * H ≤
        ((primeProductWindow P ((n * R t : ℕ) : ℝ) X).card : ℝ)) :
    X * H * (∑ n ∈ S, W n / (n : ℝ)) *
      (∑ t : T, (1 / (R t : ℝ)) / N) ≤
      ∑ n ∈ S, ∑ t : T,
        (W n / N) * ((primeProductWindow P ((n * R t : ℕ) : ℝ) X).card : ℝ) := by
  classical
  calc
    _ = ∑ n ∈ S, ∑ t : T,
        (W n / N) * ((X / ((n * R t : ℕ) : ℝ)) * H) := by
      simp only [mul_sum, sum_mul]
      rw [sum_comm]
      apply sum_congr rfl
      intro n hn
      apply sum_congr rfl
      intro t ht
      simp only [Nat.cast_mul, div_eq_mul_inv, mul_inv]
      ring
    _ ≤ _ := by
      apply sum_le_sum
      intro n hn
      apply sum_le_sum
      intro t ht
      exact mul_le_mul_of_nonneg_left (hcount n hn t) (div_nonneg (hW n hn) hN)

/-- Use the already harmonic small-factor coefficient directly. The ordinary
weight in the count is `n * h n`, and no factorial is removed with the free slot. -/
theorem indexed_free_prime_mass_lower_harmonic {T : Type*} [Fintype T]
    (S P : Finset ℕ) (h : ℕ → ℝ) (R : T → ℕ) (N X H : ℝ)
    (hN : 0 ≤ N) (hS : ∀ n ∈ S, n ≠ 0) (hh : ∀ n ∈ S, 0 ≤ h n)
    (hcount : ∀ n ∈ S, ∀ t : T,
      (X / ((n * R t : ℕ) : ℝ)) * H ≤
        ((primeProductWindow P ((n * R t : ℕ) : ℝ) X).card : ℝ)) :
    X * H * (∑ n ∈ S, h n) * (∑ t : T, (1 / (R t : ℝ)) / N) ≤
      ∑ n ∈ S, ∑ t : T,
        (((n : ℝ) * h n) / N) *
          ((primeProductWindow P ((n * R t : ℕ) : ℝ) X).card : ℝ) := by
  have he : (∑ n ∈ S, ((n : ℝ) * h n) / (n : ℝ)) = ∑ n ∈ S, h n := by
    apply sum_congr rfl
    intro n hn
    have hn0 : (n : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (hS n hn)
    exact mul_div_cancel_left₀ (h n) hn0
  have hb := indexed_free_prime_mass_lower S P (fun n => (n : ℝ) * h n) R N X H hN
    (fun n hn => mul_nonneg (Nat.cast_nonneg n) (hh n hn)) hcount
  rwa [he] at hb
end

section
open Finset
theorem primeProductWindow_card_eq_sum (P : Finset ℕ) (R X : ℝ) :
    ((primeProductWindow P R X).card : ℝ) =
      ∑ p : P, if X < (p.val : ℝ) * R ∧ (p.val : ℝ) * R ≤ 16 * X then (1 : ℝ) else 0 := by
  classical
  have hsum := sum_coe_sort P (fun p => if X < (p : ℝ) * R ∧ (p : ℝ) * R ≤ 16 * X then (1 : ℝ) else 0)
  rw [hsum]
  simp only [primeProductWindow, ← sum_filter, sum_const, nsmul_eq_mul, mul_one]

theorem ordered_slot_window_sum_split {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (i : I) (N : ℝ) (p : ℕ) (X : ℝ) :
    (∑ x : ∀ j, choices j,
      if X < (p * orderedSlotProduct choices x : ℕ) ∧
        (p * orderedSlotProduct choices x : ℕ) ≤ 16 * X then 1 / N else 0) =
      ∑ y : ∀ j : {j : I // j ≠ i}, choices j.val,
        ((primeProductWindow (choices i)
          ((p * orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y : ℕ) : ℝ) X).card : ℝ) / N := by
  classical
  rw [ordered_slot_sum_test_split choices i
    (fun n => if X < (p * n : ℕ) ∧ (p * n : ℕ) ≤ 16 * X then 1 / N else 0)]
  rw [sum_comm]
  apply sum_congr rfl
  intro y _
  rw [primeProductWindow_card_eq_sum, sum_div]
  apply sum_congr rfl
  intro a _
  have heq : ((p * (a.val *
      orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y) : ℕ) : ℝ) =
      (a.val : ℝ) * ((p * orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y : ℕ) : ℝ) := by
    simp only [Nat.cast_mul]
    ring
  rw [heq]
  split_ifs <;> simp
end

section
open Finset
theorem ordered_slot_weight_window_sum {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (normalization : ℝ) (S : Finset ℕ) :
    (∑ n ∈ S, orderedSlotWeight choices normalization n) =
      ∑ x : ∀ i, choices i,
        if orderedSlotProduct choices x ∈ S then 1 / normalization else 0 := by
  classical
  simp only [orderedSlotWeight]
  rw [sum_comm]
  apply sum_congr
  · ext x
    simp
  · intro x _
    simp

theorem ordered_slot_weighted_window_sum {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (normalization : ℝ) (S : Finset ℕ) (F : ℕ → ℝ) :
    (∑ n ∈ S, orderedSlotWeight choices normalization n * F n) =
      ∑ x : ∀ i, choices i,
        if orderedSlotProduct choices x ∈ S then
          (1 / normalization) * F (orderedSlotProduct choices x) else 0 := by
  classical
  simp only [orderedSlotWeight, sum_mul]
  rw [sum_comm]
  apply sum_congr
  · ext x
    simp
  · intro x _
    simp only [ite_mul, zero_mul]
    simp
end

section
open Finset
theorem ordered_slot_product_sum_mono {I : Type*} [Fintype I] [DecidableEq I]
    (A B : I → Finset ℕ) (hAB : ∀ i, A i ⊆ B i) (F : ℕ → ℝ)
    (hF : ∀ n, 0 ≤ F n) :
    (∑ x : ∀ i, A i, F (orderedSlotProduct A x)) ≤
      ∑ y : ∀ i, B i, F (orderedSlotProduct B y) := by
  classical
  let f : (∀ i, A i) → (∀ i, B i) := fun x i => ⟨(x i).val, hAB i (x i).property⟩
  have hf : Function.Injective f := by
    intro x y hxy
    funext i
    exact Subtype.ext (congrArg (fun z => (z i).val) hxy)
  calc
    _ = ∑ y ∈ univ.image f, F (orderedSlotProduct B y) := by
      rw [sum_image]
      · rfl
      · intro x hx y hy hxy
        exact hf hxy
    _ ≤ _ := sum_le_sum_of_subset_of_nonneg (subset_univ _)
      (fun y _ _ => hF (orderedSlotProduct B y))

theorem ordered_slot_weight_mono {I : Type*} [Fintype I]
    (A B : I → Finset ℕ) (hAB : ∀ i, A i ⊆ B i)
    {N : ℝ} (hN : 0 ≤ N) (n : ℕ) :
    orderedSlotWeight A N n ≤ orderedSlotWeight B N n := by
  classical
  exact ordered_slot_product_sum_mono A B hAB
    (fun k => if k = n then 1 / N else 0) (fun k => by split_ifs <;> positivity)
end

section

open Finset

theorem repeated_big_unshared_iff_physical {G : Type*} {J ell : ℕ}
    (C : G → Finset (Fin J)) (g : G) (s : PhysicalSlots J ell) :
    repeatedBigUnshared C g s ↔ s ∈ physicalUnsharedSlots (ell := ell) (C g) := by
  classical
  cases s <;> simp [repeatedBigUnshared, physicalUnsharedSlots, physicalSharedSlots]

theorem repeated_big_target_mass_physical {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (target : RepeatedBigLists P J ell) :
    repeatedBigTargetMass V b C target =
      ∏ g, ∏ s ∈ physicalUnsharedSlots (ell := ell) (C g),
        tiltedPhysicalBirthLaw V g (b g) (target g s) := by
  classical
  apply prod_congr rfl
  intro g hg
  exact (prod_subtype (physicalUnsharedSlots (ell := ell) (C g))
    (fun s => (repeated_big_unshared_iff_physical C g s).symm)
    (fun s => tiltedPhysicalBirthLaw V g (b g) (target g s))).symm

/-- The conjugation preserves both endpoint collision bans and the untilted auxiliary law.
It only changes the actual tilted fresh-target law to the baseline-one law. -/
theorem repeated_big_kernel_density_conjugation {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (hb : ∀ g p, 0 < b g p) (C : G → Finset (Fin J)) (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (source target : RepeatedBigLists P J ell) :
    ((Real.sqrt (cleanActiveDensity b source) / Real.sqrt (cleanActiveDensity b target) : ℝ) : ℂ) *
        repeatedBigKernel V b C ζ K aux source target =
      (Real.sqrt (cleanUnsharedDensity b C source * cleanUnsharedDensity b C target) : ℂ) *
        repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target := by
  classical
  unfold repeatedBigKernel
  split_ifs with h
  · rw [repeated_big_target_mass_physical, repeated_big_target_mass_physical]
    simpa only [tiltedPhysicalBirthLaw, div_one, mul_assoc] using
      clean_physical_fresh_coefficient_conjugation V b hb C source target h.1 aux
        (K source target aux * physicalPhase ζ (repeatedBigD C source aux))
  · simp
end

section
open Finset
/-- Only unshared slots contribute to the conjugated density error. Each slot
is counted once at the source and once at the target. -/
theorem clean_unshared_endpoint_lifespan_density_bounds {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (b : (g : G) → P g → ℝ)
    (C : G → Finset (Fin J)) (source target : (g : G) → PhysicalSlots J ell → P g)
    {T Pmin : ℝ} (hT : 0 ≤ T) (hPmin : 0 < Pmin)
    (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (hb : ∀ g (p : P g), b g p = 1 - T / (p.val : ℝ))
    (hsmall : ((2 * ∑ g, (ell + (C g).card) : ℕ) : ℝ) * T / Pmin ≤ 1 / 2) :
    (1 ≤ cleanUnsharedDensity b C source * cleanUnsharedDensity b C target ∧
      cleanUnsharedDensity b C source * cleanUnsharedDensity b C target ≤
        1 + 2 * (((2 * ∑ g, (ell + (C g).card) : ℕ) : ℝ) * T / Pmin)) ∧
    (0 ≤ Real.sqrt (cleanUnsharedDensity b C source * cleanUnsharedDensity b C target) - 1 ∧
      Real.sqrt (cleanUnsharedDensity b C source * cleanUnsharedDensity b C target) - 1 ≤
        ((2 * ∑ g, (ell + (C g).card) : ℕ) : ℝ) * T / Pmin) := by
  classical
  let I := Bool × ((g : G) × ↥(physicalUnsharedSlots (ell := ell) (C g)))
  let labels (i : I) : P i.2.1 :=
    if i.1 then source i.2.1 i.2.2.val else target i.2.1 i.2.2.val
  have hcard : Fintype.card I = 2 * ∑ g, (ell + (C g).card) := by
    simp [I, Fintype.card_sigma, physical_unshared_slots_card]
  have hprod : (∏ i : I, 1 / b i.2.1 (labels i)) =
      cleanUnsharedDensity b C source * cleanUnsharedDensity b C target := by
    simp only [I, Fintype.prod_prod_type, Fintype.prod_bool, Fintype.prod_sigma,
      labels, ↓reduceIte, Bool.false_eq_true, cleanUnsharedDensity]
    apply congrArg₂ (· * ·)
    · exact prod_congr rfl (fun g _ =>
        prod_coe_sort (physicalUnsharedSlots (C g)) (fun s => 1 / b g (source g s)))
    · exact prod_congr rfl (fun g _ =>
        prod_coe_sort (physicalUnsharedSlots (C g)) (fun s => 1 / b g (target g s)))
  have h := physical_lifespan_tilt_density_bounds (fun i : I => i.2.1) labels b hT hPmin
    (fun i => hp _ _) (fun i => hb _ _) (by simpa only [hcard] using hsmall)
  simpa only [hcard, hprod] using h

/-- The exact conjugation multiplier perturbs any complex row coefficient by
at most the total endpoint lifespan loss times its norm. -/
theorem clean_unshared_endpoint_lifespan_coefficient_error {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (b : (g : G) → P g → ℝ)
    (C : G → Finset (Fin J)) (source target : (g : G) → PhysicalSlots J ell → P g)
    {T Pmin : ℝ} (hT : 0 ≤ T) (hPmin : 0 < Pmin)
    (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (hb : ∀ g (p : P g), b g p = 1 - T / (p.val : ℝ))
    (hsmall : ((2 * ∑ g, (ell + (C g).card) : ℕ) : ℝ) * T / Pmin ≤ 1 / 2)
    (K : ℂ) :
    ‖(Real.sqrt (cleanUnsharedDensity b C source * cleanUnsharedDensity b C target) : ℂ) * K - K‖ ≤
      (((2 * ∑ g, (ell + (C g).card) : ℕ) : ℝ) * T / Pmin) * ‖K‖ := by
  obtain ⟨_, h0, h1⟩ := clean_unshared_endpoint_lifespan_density_bounds
    b C source target hT hPmin hp hb hsmall
  have heq :
      (Real.sqrt (cleanUnsharedDensity b C source * cleanUnsharedDensity b C target) : ℂ) * K - K =
      ((Real.sqrt (cleanUnsharedDensity b C source * cleanUnsharedDensity b C target) - 1 : ℝ) : ℂ) * K := by
    push_cast
    ring
  rw [heq, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg h0]
  exact mul_le_mul_of_nonneg_right h1 (norm_nonneg K)
end

section

open Finset
open scoped Classical

/-- Both small-prime and ordered pending-prime residues follow the same integer step. -/
def cleanHybridResidueDirection {S G : Type*} {Ps : S → Finset ℕ}
    {Pb : G → Finset ℕ} {N : G → ℕ} (p : FixedOrderedMemoryLabels Pb N) :
    ℤ →+ (PhysicalResidues Ps × FixedOrderedResidues p) where
  toFun n := (physicalResiduesOfInt Ps n, fixedOrderedResidueDirection p n)
  map_zero' := by
    apply Prod.ext
    · funext q
      exact Int.cast_zero
    · exact map_zero _
  map_add' a b := by
    apply Prod.ext
    · funext q
      exact Int.cast_add a b
    · exact map_add _ a b

theorem clean_hybrid_residue_translation {S G : Type*} {Ps : S → Finset ℕ}
    {Pb : G → Finset ℕ} {N : G → ℕ} (p : FixedOrderedMemoryLabels Pb N)
    (r : PhysicalResidues Ps × FixedOrderedResidues p) (n : ℤ) :
    r + cleanHybridResidueDirection p n =
      (physicalTranslateResidues r.1 n, fixedOrderedResidueTranslate p r.2 n) := rfl

/-- The residue-independent coefficient after the two memory damping factors are
absorbed into the endpoint functions. -/
noncomputable def cleanHybridCoreCoefficient {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : G → Finset (Fin J)) (ζ θ : ℝ) (k : ℤ)
    (K : RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb C → ℂ)
    (d : PhysicalSharedLists Ps J) (aux : PhysicalAuxLabels Pb C)
    (source target : RepeatedBigLists Pb J ell) : ℂ :=
  repeatedBigKernel Vb b C ζ K aux source target *
    physicalReturnPhase θ (cleanHybridStep k C source aux d) *
    physicalPhase ζ (physicalSharedProduct d)

noncomputable def cleanHybridCoreAction {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : G → Finset (Fin J)) (ζ θ : ℝ) (k : ℤ)
    (p : FixedOrderedMemoryLabels Pb N)
    (K : RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb C → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : RepeatedBigLists Pb J ell → (PhysicalResidues Ps × FixedOrderedResidues p) → ℂ)
    (source : RepeatedBigLists Pb J ell) (r : PhysicalResidues Ps × FixedOrderedResidues p) : ℂ :=
  ∑ aux, ∑ target, cleanHybridCoreCoefficient Vb b C ζ θ k K d aux source target *
    f target (physicalTranslateResidues r.1 (cleanHybridStep k C source aux d),
      fixedOrderedResidueTranslate p r.2 (cleanHybridStep k C source aux d))

theorem clean_hybrid_core_action_translated {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : G → Finset (Fin J)) (ζ θ : ℝ) (k : ℤ)
    (p : FixedOrderedMemoryLabels Pb N)
    (K : RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb C → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : RepeatedBigLists Pb J ell → (PhysicalResidues Ps × FixedOrderedResidues p) → ℂ) :
    cleanHybridCoreAction Vb b C ζ θ k p K d f =
      cleanTranslatedSumOperator (cleanHybridCoreCoefficient Vb b C ζ θ k K d)
        (fun aux source _ => cleanHybridResidueDirection p (cleanHybridStep k C source aux d)) f := rfl

theorem clean_hybrid_core_fourier_coefficients {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : G → Finset (Fin J)) (ζ θ : ℝ) (k : ℤ)
    (p : FixedOrderedMemoryLabels Pb N)
    [∀ q : PhysicalPrime Ps, NeZero q.2.val] [∀ g j, NeZero (p g j).val]
    (K : RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb C → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : RepeatedBigLists Pb J ell → (PhysicalResidues Ps × FixedOrderedResidues p) → ℂ)
    (χ : AddChar (PhysicalResidues Ps × FixedOrderedResidues p) ℂ)
    (source : RepeatedBigLists Pb J ell) :
    cleanFourierCoefficients (cleanHybridCoreAction Vb b C ζ θ k p K d f source) χ =
      cleanFourierSumBlock (cleanHybridCoreCoefficient Vb b C ζ θ k K d)
        (fun aux source _ => cleanHybridResidueDirection p (cleanHybridStep k C source aux d))
        χ (fun target => cleanFourierCoefficients (f target) χ) source := by
  rw [clean_hybrid_core_action_translated]
  exact clean_fourier_coefficients_sum_translated _ _ _ _ _

/-- Absorb the exact memory cutoff and the two rho powers into the endpoint tests. -/
theorem clean_hybrid_core_memory_pairing {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ) (B : G → ℕ) (p : FixedOrderedMemoryLabels Pb N)
    (r : FixedOrderedResidues p)
    (K : RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb C → ℂ)
    (d : PhysicalSharedLists Ps J) (aux : PhysicalAuxLabels Pb C)
    (source target : RepeatedBigLists Pb J ell) (u v : ℂ) :
    (starRingEnd ℂ) u * (cleanHybridBetweenKernel Vb b C ζ θ ρ k B p r K d aux source target *
        physicalPhase ζ (physicalSharedProduct d)) * v =
      (starRingEnd ℂ) ((cleanMemoryInputWeight ρ p r : ℂ) * u) *
        cleanHybridCoreCoefficient Vb b C ζ θ k K d aux source target *
        ((cleanMemoryOutputWeight ρ B p
          (fixedOrderedResidueTranslate p r (cleanHybridStep k C source aux d)) : ℂ) * v) := by
  have h := clean_hybrid_memory_factor_pairing ρ B p r (cleanHybridStep k C source aux d)
    u (cleanHybridCoreCoefficient Vb b C ζ θ k K d aux source target) v
  convert h using 1
  unfold cleanHybridBetweenKernel cleanHybridCoreCoefficient
  ring

/-- A character contributes one real frequency, uniform over every active endpoint
and free auxiliary label. All cancellation in the free-label sum remains intact. -/
theorem clean_hybrid_fourier_block_real_frequency {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : G → Finset (Fin J)) (ζ θ : ℝ) (k : ℤ)
    (p : FixedOrderedMemoryLabels Pb N)
    [∀ q : PhysicalPrime Ps, NeZero q.2.val] [∀ g j, NeZero (p g j).val]
    (K : RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb C → ℂ)
    (d : PhysicalSharedLists Ps J)
    (χ : AddChar (PhysicalResidues Ps × FixedOrderedResidues p) ℂ) :
    ∃ Θ : ℝ, ∀ (v : RepeatedBigLists Pb J ell → ℂ) source,
      cleanFourierSumBlock (cleanHybridCoreCoefficient Vb b C ζ θ k K d)
        (fun aux source _ => cleanHybridResidueDirection p (cleanHybridStep k C source aux d))
        χ v source =
      physicalPhase ζ (physicalSharedProduct d) *
        ∑ target, (∑ aux, repeatedBigKernel Vb b C ζ K aux source target *
          physicalReturnPhase Θ (repeatedBigD C source aux)) * v target := by
  obtain ⟨Θ, hΘ⟩ := exists_physical_character_return_frequency χ
    (cleanHybridResidueDirection (Ps := Ps) p) θ (k * (physicalSharedProduct d : ℤ))
  refine ⟨Θ, ?_⟩
  intro v source
  rw [clean_fourier_sum_block_matrix, mul_sum]
  apply sum_congr rfl
  intro target ht
  rw [← mul_assoc]
  congr 1
  rw [mul_sum]
  apply sum_congr rfl
  intro aux ha
  have hstep : cleanHybridStep k C source aux d =
      (k * (physicalSharedProduct d : ℤ)) * (repeatedBigD C source aux : ℤ) := by
    unfold cleanHybridStep
    ring
  unfold cleanHybridCoreCoefficient
  rw [hstep]
  have h := hΘ (repeatedBigD C source aux : ℤ)
  calc
    _ = physicalPhase ζ (physicalSharedProduct d) *
        (repeatedBigKernel Vb b C ζ K aux source target *
          (χ (cleanHybridResidueDirection p
            ((k * (physicalSharedProduct d : ℤ)) * (repeatedBigD C source aux : ℤ))) *
            physicalReturnPhase θ
              ((k * (physicalSharedProduct d : ℤ)) * (repeatedBigD C source aux : ℤ)))) := by ring
    _ = _ := by rw [h]

/-- Exact weighted Parseval for the actual hybrid core action. -/
theorem clean_hybrid_core_weighted_energy {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : G → Finset (Fin J)) (ζ θ : ℝ) (k : ℤ)
    (p : FixedOrderedMemoryLabels Pb N)
    [∀ q : PhysicalPrime Ps, NeZero q.2.val] [∀ g j, NeZero (p g j).val]
    (K : RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb C → ℂ)
    (d : PhysicalSharedLists Ps J) (w : RepeatedBigLists Pb J ell → ℝ)
    (f : RepeatedBigLists Pb J ell → (PhysicalResidues Ps × FixedOrderedResidues p) → ℂ) :
    ∑ source, w source * ∑ r, ‖cleanHybridCoreAction Vb b C ζ θ k p K d f source r‖ ^ 2 =
      (Fintype.card (PhysicalResidues Ps × FixedOrderedResidues p) : ℝ) *
        ∑ χ, ∑ source, w source *
          ‖cleanFourierSumBlock (cleanHybridCoreCoefficient Vb b C ζ θ k K d)
            (fun aux source _ => cleanHybridResidueDirection p (cleanHybridStep k C source aux d))
            χ (fun target => cleanFourierCoefficients (f target) χ) source‖ ^ 2 := by
  rw [clean_hybrid_core_action_translated]
  exact clean_sum_translated_weighted_energy _ _ _ _

/-- A uniform bound for the explicit real-frequency big-list matrices bounds the
actual translated core action on the same active subspace. -/
theorem clean_hybrid_core_norm_le_of_ideal_blocks {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : G → Finset (Fin J)) (ζ θ : ℝ) (k : ℤ)
    (p : FixedOrderedMemoryLabels Pb N)
    [∀ q : PhysicalPrime Ps, NeZero q.2.val] [∀ g j, NeZero (p g j).val]
    (K : RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb C → ℂ)
    (d : PhysicalSharedLists Ps J) (w : RepeatedBigLists Pb J ell → ℝ) (hw : ∀ x, 0 ≤ w x)
    (U : Submodule ℂ (RepeatedBigLists Pb J ell → ℂ)) (M : ℝ) (hM : 0 ≤ M)
    (hblock : ∀ (Θ : ℝ) (v : RepeatedBigLists Pb J ell → ℂ), v ∈ U →
      cleanActiveNorm w (fun source => ∑ target,
        (∑ aux, repeatedBigKernel Vb b C ζ K aux source target *
          physicalReturnPhase Θ (repeatedBigD C source aux)) * v target) ≤
        M * cleanActiveNorm w v)
    (f : RepeatedBigLists Pb J ell → (PhysicalResidues Ps × FixedOrderedResidues p) → ℂ)
    (hf : ∀ r, (fun source => f source r) ∈ U) :
    cleanWeightedNorm w (cleanHybridCoreAction Vb b C ζ θ k p K d f) ≤
      M * cleanWeightedNorm w f := by
  rw [clean_hybrid_core_action_translated]
  apply clean_sum_translated_norm_le_of_active_norm_blocks w hw _ _ U M hM _ f hf
  intro χ v hv
  obtain ⟨Θ, hΘ⟩ := clean_hybrid_fourier_block_real_frequency Vb b C ζ θ k p K d χ
  simpa only [cleanActiveNorm, hΘ, norm_mul, physical_phase_norm, one_mul] using hblock Θ v hv
end

section
open scoped BigOperators Classical
theorem finite_weighted_sum_cauchy {X : Type*} (s : Finset X)
    (μ : X → ℝ) (hμ : ∀ x ∈ s, 0 ≤ μ x) (f : X → ℂ) :
    ‖∑ x ∈ s, (μ x : ℂ) * f x‖ ^ 2 ≤
      (∑ x ∈ s, μ x) * ∑ x ∈ s, μ x * ‖f x‖ ^ 2 := by
  have h := complex_row_weighted_cauchy s (fun x => (μ x : ℂ)) f (fun _ => 1)
    (fun _ _ => by norm_num)
  simp only [Complex.norm_real, Real.norm_eq_abs, mul_one, div_one] at h
  have ha : ∀ x ∈ s, |μ x| = μ x := fun x hx => abs_of_nonneg (hμ x hx)
  simpa only [Finset.sum_congr rfl ha,
    Finset.sum_congr rfl (fun x hx => congrArg (fun a => a * ‖f x‖ ^ 2) (ha x hx))] using h

theorem finite_weighted_fiber_energy_le {X Y : Type*} [Fintype X]
    (values : Finset Y) (π : X → Y) (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x)
    (f : X → ℂ) {B : ℝ} (hB : 0 ≤ B)
    (hmass : ∀ y ∈ values, (∑ x ∈ Finset.univ.filter (fun x => π x = y), μ x) ≤ B) :
    (∑ y ∈ values, ‖∑ x ∈ Finset.univ.filter (fun x => π x = y), (μ x : ℂ) * f x‖ ^ 2) ≤
      B * ∑ x, μ x * ‖f x‖ ^ 2 := by
  have hc (y : Y) (hy : y ∈ values) :
      ‖∑ x ∈ Finset.univ.filter (fun x => π x = y), (μ x : ℂ) * f x‖ ^ 2 ≤
      B * ∑ x ∈ Finset.univ.filter (fun x => π x = y), μ x * ‖f x‖ ^ 2 := by
    exact (finite_weighted_sum_cauchy _ μ (fun x _ => hμ x) f).trans
      (mul_le_mul_of_nonneg_right (hmass y hy)
        (Finset.sum_nonneg (fun x _ => mul_nonneg (hμ x) (sq_nonneg _))))
  calc
    _ ≤ ∑ y ∈ values, B * ∑ x ∈ Finset.univ.filter (fun x => π x = y), μ x * ‖f x‖ ^ 2 :=
      Finset.sum_le_sum hc
    _ = B * ∑ x, ∑ y ∈ values, if π x = y then μ x * ‖f x‖ ^ 2 else 0 := by
      simp only [Finset.sum_filter]
      rw [← Finset.mul_sum, Finset.sum_comm]
    _ ≤ B * ∑ x, μ x * ‖f x‖ ^ 2 := by
      apply mul_le_mul_of_nonneg_left _ hB
      apply Finset.sum_le_sum
      intro x _
      by_cases hx : π x ∈ values
      · simp [Finset.sum_ite_eq, hx]
      · simp [Finset.sum_ite_eq, hx, mul_nonneg (hμ x) (sq_nonneg _)]
end

