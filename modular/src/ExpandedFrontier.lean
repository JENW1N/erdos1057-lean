    (i : CoupledGhostSampleIndex M B s sk) :
    fullMixedPathBirthLabel n S B A Δ D steps x p (fullMixedBirthOrder S B steps
      (fullMixedGhostOwnerSampleEmbedding S B j steps u htag s sk i)) = some ⟨i.1, (births i).1⟩ := by
  unfold fullMixedPathBirthLabel
  rw [full_mixed_ghost_owner_sample_data n S B A Δ D steps u x s p j htag sk births hocc i]
  rfl

theorem full_mixed_ghost_owner_sample_coverage (hocc : fullMixedOwnerOccurrence n S B A Δ D steps x p u =
      ⟨s, fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inl j)) htag s ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩)⟩)
    (i : Fin (Fintype.card (FullMixedBirthAddress S B steps))) :
    (fullMixedPathBirthPerformed n S B A Δ D steps x p (fullMixedBirthOrder S B steps i) ∧
      fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i) = u) ↔
      ∃ c, fullMixedGhostOwnerSampleEmbedding S B j steps u htag s sk c = i :=
  full_mixed_tagged_owner_coordinate_coverage n S B A Δ D steps u (some (.inl j)) htag s
    ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩) x p hocc i

end Ghost

section Edge
variable (k : K) (htag : steps.get u = some (.inr k))
