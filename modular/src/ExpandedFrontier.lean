/- The exact selected-child exponents on the original chronological schedule. -/

open Finset Classical

namespace Bounty

theorem finite_prod_pow_le_common_power {I : Type*} [Fintype I]
    (a : I → ℝ) (d : I → ℕ) (β : ℝ)
    (ha : ∀ i, 0 ≤ a i) (hab : ∀ i, a i ≤ β) :
    (∏ i, a i ^ d i) ≤ β ^ (∑ i, d i) := by
  rw [← prod_pow_eq_pow_sum]
  exact prod_le_prod₀ (s := univ) (fun i _ => pow_nonneg (ha i) _)
    (fun i _ => pow_le_pow_left₀ (ha i) (hab i) _)

section Factor
variable {J K : Type*} {N : ℕ} {M : Fin N → ℕ}
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ) (steps : List (Option (J ⊕ K)))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))

noncomputable def fullMixedSelectedAt (t : ℕ) : ℕ :=
  if ht : t < steps.length then ∑ g, fullMixedSelectedCount S B steps code ⟨t, ht⟩ g else 0

theorem full_mixed_selected_at_owner (u : Fin steps.length) :
    fullMixedSelectedAt S B steps code u.val = ∑ g, fullMixedSelectedCount S B steps code u g := by
  unfold fullMixedSelectedAt
  rw [dif_pos u.isLt]

theorem full_mixed_selected_at_sum :
    (∑ u : Fin steps.length, fullMixedSelectedAt S B steps code u.val) = birthForestRank code := by
  simp only [full_mixed_selected_at_owner]
  exact full_mixed_selected_count_sum S B steps code

variable {P : Fin N → Type*} [∀ g, Fintype (P g)]
    (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ v vmin : ℝ) (V : Fin N → ℝ) (T : ℕ) (β : ℝ)

noncomputable def fullMixedForestRowFactor (t : ℕ) (tag : Option (J ⊕ K)) : ℝ :=
  β ^ fullMixedSelectedAt S B steps code t * fullMixedLengthRowFactor μ q ρ v vmin V T tag

theorem full_mixed_forest_row_factor_nonneg
    (hβ : 0 ≤ β) (hρ : ρ < 1) (hv : 0 ≤ v) (t : ℕ) (tag : Option (J ⊕ K)) :
    0 ≤ fullMixedForestRowFactor S B steps code μ q ρ v vmin V T β t tag :=
  mul_nonneg (pow_nonneg hβ _)
    (fullMixedLengthRowFactor_nonneg μ q ρ v vmin V T hρ hv tag)

theorem full_mixed_forest_row_factor_product :
    finiteEventIndexedProduct (fullMixedForestRowFactor S B steps code μ q ρ v vmin V T β) 0 steps =
      β ^ birthForestRank code * ∏ u : Fin steps.length, fullMixedLengthRowFactor μ q ρ v vmin V T (steps.get u) := by
  rw [finite_event_indexed_product_eq_prod]
  simp only [Nat.zero_add, fullMixedForestRowFactor, prod_mul_distrib,
    prod_pow_eq_pow_sum, full_mixed_selected_at_sum]

end Factor
end Bounty
