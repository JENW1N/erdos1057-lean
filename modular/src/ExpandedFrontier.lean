namespace Bounty

section Physical
variable {I K : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g, ∀ p : ↥(P g), NeZero p.val]
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (retention : I → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
  (hV : ∀ g, V g ≠ 0)

noncomputable def physicalObservedMarkRow : Option (I ⊕ K) →
    (PhysicalMarkObservation P ell C → PhysicalBoundedMarkState P J ell B → ℂ) → PhysicalBoundedMarkState P J ell B → ℂ
  | none, F, s =>
      ∑ σ : PhysicalPermutations (Fin N) J ell,
        ((Fintype.card (PhysicalPermutations (Fin N) J ell) : ℝ)⁻¹ : ℂ) *
          F (.inl σ) (physicalPermuteLabels σ s.1, s.2.1, s.2.2)
  | some (.inl j), F, s =>
      globalBirthJointCutRawRow
        (fun g => GlobalBirthRawStep.visit (a := physicalGroupPhaseActivity s.1 g)
          (fun _ => 0) (β g) (1 - retention j) (V g) ρ (hV g) B) B B
        (physicalMarkRawExtension (F (.inr none)) s.1)
        (fun g => (s.2.1 g, boundedOrderedTupleToFinite (s.2.2 g)))
  | some (.inr j), F, s =>
      ∑ R : PhysicalMarkLists P J ell, ∑ aux : PhysicalAuxLabels P (C j),
        (ω j (productActiveMemorySplit (fun g => physicalFullSharedIndices (C j g)) B
          (physicalFullMemoryState (C j) s.1 s.2.2)).1 aux : ℂ) *
        if physicalListAdmissible (C j) aux s.1 R then
          jointRawTensorCutoff B (physicalFullEdgeRawRow (B := B) (C j) (k j) s.1 R β ρ V aux)
            (physicalMarkRawExtension (F (.inr (some ⟨j, aux⟩))) R)
            (fun g => (s.2.1 g, boundedOrderedTupleToFinite (s.2.2 g))) else 0

