lemma ZetaInvBound2 :
    ∃ C > 0, ∀ {σ : ℝ} (_ : σ ∈ Ioc 1 2) (t : ℝ) (_ : 3 < |t|),
    1 / ‖riemannZeta (σ + t * I)‖ ≤ C * (σ - 1) ^ (-(3 : ℝ) / 4) * (Real.log |t|) ^ ((1 : ℝ) / 4) := by
  obtain ⟨A, ha, C, hC, h⟩ := ZetaUpperBnd
  obtain ⟨c, hc, h_inv⟩ := ZetaNear1BndExact
  refine ⟨(2 * C) ^ ((1 : ℝ)/ 4) * c ^ ((3 : ℝ)/ 4), by positivity, ?_⟩
  intro σ hσ t t_gt
  obtain ⟨σ_gt, σ_le⟩ := hσ
  have ht' : 3 < |2 * t| := by simp only [abs_mul, Nat.abs_ofNat]; linarith
  have hnezero: ((σ - 1) / c) ^ (-3 / 4 : ℝ) ≠ 0 := by
    have : (σ - 1) / c ≠ 0 := ne_of_gt <| div_pos (by linarith) hc
    contrapose! this
    rwa [Real.rpow_eq_zero (div_nonneg (by linarith) hc.le) (by norm_num)] at this
  calc
    _ ≤ ‖‖riemannZeta σ‖ ^ (3 / 4 : ℝ) * ‖riemannZeta (↑σ + 2 * ↑t * I)‖ ^ (1 / 4 : ℝ)‖ := ?_
    _ ≤ ‖((σ - 1) / c) ^ (-3 / 4 : ℝ) * ‖riemannZeta (↑σ + 2 * ↑t * I)‖ ^ (1 / 4 : ℝ)‖ := ?_
    _ ≤ ‖((σ - 1) / c) ^ (-3 / 4 : ℝ) * C ^ (1 / 4 : ℝ) * (Real.log |2 * t|) ^ (1 / 4 : ℝ)‖ := ?_
    _ ≤ ‖((σ - 1) / c) ^ (-3 / 4 : ℝ) * C ^ (1 / 4 : ℝ) * (Real.log (|t| ^ 2)) ^ (1 / 4 : ℝ)‖ := ?_
    _ = ‖((σ - 1)) ^ (-3 / 4 : ℝ) * c ^ (3 / 4 : ℝ) * (C ^ (1 / 4 : ℝ) * (Real.log (|t| ^ 2)) ^ (1 / 4 : ℝ))‖ := ?_
    _ = ‖((σ - 1)) ^ (-3 / 4 : ℝ) * c ^ (3 / 4 : ℝ) * ((2 * C) ^ (1 / 4 : ℝ) * Real.log |t| ^ (1 / 4 : ℝ))‖ := ?_
    _ = _ := ?_
  · simp only [norm_mul]
    convert ZetaInvBound1 σ_gt using 2
    <;> exact abs_eq_self.mpr <| Real.rpow_nonneg (norm_nonneg _) _
  · have bnd1: ‖riemannZeta σ‖ ^ (3 / 4 : ℝ) ≤ ((σ - 1) / c) ^ (-(3 : ℝ) / 4) := by
      have : ((σ - 1) / c) ^ (-(3 : ℝ) / 4) = (((σ - 1) / c) ^ (-1 : ℝ)) ^ (3 / 4 : ℝ) := by
        rw [← Real.rpow_mul ?_]
        · ring_nf
        · exact div_nonneg (by linarith) hc.le
      rw [this]
      apply Real.rpow_le_rpow (by simp [norm_nonneg]) ?_ (by norm_num)
      convert! h_inv σ ⟨σ_gt, σ_le⟩ using 1; simp [Real.rpow_neg_one, inv_div]
    simp only [norm_mul]
    apply (mul_le_mul_iff_left₀ ?_).mpr
    · convert! bnd1 using 1
      · exact abs_eq_self.mpr <| Real.rpow_nonneg (norm_nonneg _) _
      · exact abs_eq_self.mpr <| Real.rpow_nonneg (div_nonneg (by linarith) hc.le) _
    · apply lt_iff_le_and_ne.mpr ⟨(by simp), ?_⟩
      have : riemannZeta (↑σ + 2 * ↑t * I) ≠ 0 := by
        apply riemannZeta_ne_zero_of_one_le_re (by simp [σ_gt.le])
      symm; exact fun h2 ↦ this (by simpa using h2)
  · replace h := h σ (2 * t) (by simpa using ht') ⟨?_, σ_le⟩
    · have : 0 ≤ Real.log |2 * t| := Real.log_nonneg (by linarith)
      conv => rhs; rw [mul_assoc, ← Real.mul_rpow hC.le this]
      rw [norm_mul, norm_mul]
      conv => rhs; rhs; rw [Real.norm_rpow_of_nonneg <| mul_nonneg hC.le this]
      conv => lhs; rhs; rw [Real.norm_rpow_of_nonneg <| norm_nonneg _]
      apply (mul_le_mul_iff_right₀ ?_).mpr
      · apply Real.rpow_le_rpow (norm_nonneg _) ?_ (by norm_num)
        convert h using 1
        · simp
        · rw [Real.norm_eq_abs, abs_eq_self.mpr <| mul_nonneg hC.le this]
      · simpa only [Real.norm_eq_abs, abs_pos]
    · linarith [(div_nonneg ha.1.le (Real.log_nonneg (by linarith)) : 0 ≤ A / Real.log |2 * t|)]
  · simp only [Real.log_abs, norm_mul]
    apply (mul_le_mul_iff_right₀ ?_).mpr
    · rw [← Real.log_abs, Real.norm_rpow_of_nonneg <| Real.log_nonneg (by linarith)]
      have : 1 ≤ |(|t| ^ 2)| := by
        simp only [_root_.sq_abs, _root_.abs_pow, one_le_sq_iff_one_le_abs]
        linarith
      conv => rhs; rw [← Real.log_abs, Real.norm_rpow_of_nonneg <| Real.log_nonneg this]
      apply Real.rpow_le_rpow (abs_nonneg _) ?_ (by norm_num)
      · rw [Real.norm_eq_abs, abs_eq_self.mpr <| Real.log_nonneg (by linarith)]
        rw [abs_eq_self.mpr <| Real.log_nonneg this, abs_mul, Real.log_abs, Nat.abs_ofNat]
        apply Real.log_le_log (mul_pos (by norm_num) (by linarith)) (by nlinarith)
    · apply mul_pos (abs_pos.mpr hnezero) (abs_pos.mpr ?_)
      have : C ≠ 0 := ne_of_gt hC
      contrapose! this; rwa [Real.rpow_eq_zero (by linarith) (by norm_num)] at this
  · have : (-3 : ℝ) / 4 = -((3 : ℝ)/ 4) := by norm_num
    simp only [norm_mul, mul_eq_mul_right_iff, this, ← mul_assoc]; left; left
    conv => lhs; rw [Real.div_rpow (by linarith) hc.le, Real.rpow_neg hc.le, div_inv_eq_mul, norm_mul]
  · simp only [Real.log_pow, Nat.cast_ofNat, norm_mul, Real.norm_eq_abs]
    congr! 1
    rw [Real.mul_rpow (by norm_num) hC.le, Real.mul_rpow (by norm_num) <|
        Real.log_nonneg (by linarith), abs_mul, abs_mul, ← mul_assoc, mul_comm _ |2 ^ (1 / 4)|]
  · simp only [norm_mul, Real.norm_eq_abs]
    have : (2 * C) ^ ((1 : ℝ)/ 4) * c ^ ((3 : ℝ)/ 4) =
      |(2 * C) ^ ((1 : ℝ)/ 4) * c ^ ((3 : ℝ)/ 4)| := by
      rw [abs_eq_self.mpr (by apply mul_nonneg <;> (apply Real.rpow_nonneg; linarith))]
    rw [this, abs_mul, abs_eq_self.mpr (by apply Real.rpow_nonneg; linarith), abs_eq_self.mpr (by positivity),
      abs_eq_self.mpr (by positivity), abs_eq_self.mpr (by apply Real.rpow_nonneg (Real.log_nonneg (by linarith)))]
    ring_nf

lemma deriv_fun_re {t : ℝ} {f : ℂ → ℂ} (diff : ∀ (σ : ℝ), DifferentiableAt ℂ f (↑σ + ↑t * I)) :
    (deriv fun {σ₂ : ℝ} ↦ f (σ₂ + t * I)) = fun (σ : ℝ) ↦ deriv f (σ + t * I) := by
  ext σ
  have := deriv_comp (h := fun (σ : ℝ) ↦ σ + t * I) (h₂ := f) σ (diff σ) ?_
  · simp only [deriv_add_const', Complex.deriv_ofReal, mul_one] at this
    exact this
  · apply DifferentiableAt.add_const _ <| differentiableAt_ofReal σ

lemma Zeta_eq_int_derivZeta {σ₁ σ₂ t : ℝ} (t_ne_zero : t ≠ 0) :
    (∫ σ in σ₁..σ₂, (deriv riemannZeta) (σ + t * I)) = riemannZeta (σ₂ + t * I) - riemannZeta (σ₁ + t * I) := by
  have diff : ∀ (σ : ℝ), DifferentiableAt ℂ riemannZeta (σ + t * I) := by
    intro σ
    refine differentiableAt_riemannZeta ?_
    contrapose! t_ne_zero; apply And.right; simpa [Complex.ext_iff] using t_ne_zero
  apply intervalIntegral.integral_deriv_eq_sub'
  · exact deriv_fun_re diff
  · intro s _
    apply DifferentiableAt.comp
    · exact (diff s).restrictScalars ℝ
    · exact DifferentiableAt.add_const (c := t * I) <| differentiableAt_ofReal _
  · apply ContinuousOn.comp (g := (deriv riemannZeta)) ?_ ?_ (mapsTo_image _ _)
    · apply HasDerivAt.continuousOn (f' := deriv <| (deriv riemannZeta))
      intro x hx
      apply hasDerivAt_deriv_iff.mpr
      replace hx : x ≠ 1 := by
        contrapose! hx
        simp only [hx, mem_image, Complex.ext_iff, add_re, ofReal_re, mul_re, I_re, mul_zero, ofReal_im,
          I_im, mul_one, sub_self, add_zero, one_re, add_im, mul_im, zero_add, one_im, not_exists,
          not_and]
        exact fun _ _ _ ↦ t_ne_zero
      exact differentiableAt_deriv_riemannZeta hx
    · exact continuous_ofReal.continuousOn.add continuousOn_const

lemma Zeta_diff_Bnd :
    ∃ (A : ℝ) (_ : A ∈ Ioc 0 (1 / 2)) (C : ℝ) (_ : 0 < C), ∀ (σ₁ σ₂ : ℝ) (t : ℝ) (_ : 3 < |t|)
    (_ : 1 - A / Real.log |t| ≤ σ₁) (_ : σ₂ ≤ 2) (_ : σ₁ < σ₂),
    ‖riemannZeta (σ₂ + t * I) - riemannZeta (σ₁ + t * I)‖ ≤  C * Real.log |t| ^ 2 * (σ₂ - σ₁) := by
  obtain ⟨A, hA, C, Cpos, hC⟩ := ZetaDerivUpperBnd
  refine ⟨A, hA, C, Cpos, ?_⟩
  intro σ₁ σ₂ t t_gt σ₁_ge σ₂_le σ₁_lt_σ₂
  have t_ne_zero : t ≠ 0 := by contrapose! t_gt; simp only [t_gt, abs_zero, Nat.ofNat_nonneg]
  rw [← Zeta_eq_int_derivZeta t_ne_zero]
  convert intervalIntegral.norm_integral_le_of_norm_le_const ?_ using 1
  · congr; rw [_root_.abs_of_nonneg (by linarith)]
  · intro σ hσ; rw [uIoc_of_le σ₁_lt_σ₂.le, mem_Ioc] at hσ
    exact hC σ t t_gt ⟨le_trans σ₁_ge hσ.1.le, le_trans hσ.2 σ₂_le⟩

lemma ZetaInvBnd_aux' {t : ℝ} (logt_gt_one : 1 < Real.log |t|) : Real.log |t| < Real.log |t| ^ (9 : ℝ) := by
  nth_rewrite 1 [← Real.rpow_one <| Real.log |t|]
  exact mod_cast Real.rpow_lt_rpow_left_iff (y := 1) (z := 9) logt_gt_one |>.mpr (by norm_num)

lemma ZetaInvBnd_aux {t : ℝ} (logt_gt_one : 1 < Real.log |t|) : Real.log |t| ≤ Real.log |t| ^ (9 : ℝ) :=
    ZetaInvBnd_aux' logt_gt_one |>.le

lemma ZetaInvBnd_aux2 {A C₁ C₂ : ℝ} (Apos : 0 < A) (C₁pos : 0 < C₁) (C₂pos : 0 < C₂)
    (hA : A ≤ 1 / 2 * (C₁ / (C₂ * 2)) ^ (4 : ℝ)) :
    0 < (C₁ * A ^ (3 / 4 : ℝ) - C₂ * 2 * A)⁻¹ := by
  simp only [inv_pos, sub_pos]
  apply div_lt_iff₀ (by positivity) |>.mp
  rw [div_eq_mul_inv, ← Real.rpow_neg (by positivity), mul_assoc]
  apply lt_div_iff₀' (by positivity) |>.mp
  nth_rewrite 1 [← Real.rpow_one A]
  rw [← Real.rpow_add (by positivity)]
  norm_num
  apply Real.rpow_lt_rpow_iff (z := 4) (by positivity) (by positivity) (by positivity) |>.mp
  rw [← Real.rpow_mul (by positivity)]
  norm_num
  apply lt_of_le_of_lt hA
  rw [div_mul_comm, mul_one, Real.rpow_ofNat]
  apply half_lt_self
  positivity

lemma ZetaInvBnd :
    ∃ (A : ℝ) (_ : A ∈ Ioc 0 (1 / 2)) (C : ℝ) (_ : 0 < C), ∀ (σ : ℝ) (t : ℝ) (_ : 3 < |t|)
    (_ : σ ∈ Ico (1 - A / (Real.log |t|) ^ (9 : ℝ)) (1 + A / (Real.log |t|) ^ (9 : ℝ))),
    1 / ‖riemannZeta (σ + t * I)‖ ≤ C * (Real.log |t|) ^ (7 : ℝ) := by
  obtain ⟨C', C'pos, hC₁⟩ := ZetaInvBound2
  obtain ⟨A', hA', C₂, C₂pos, hC₂⟩ := Zeta_diff_Bnd
  set C₁ := 1 / C'
  let A := min A' <| (1 / 2 : ℝ) * (C₁ / (C₂ * 2)) ^ (4 : ℝ)
  have Apos : 0 < A := by have := hA'.1; positivity
  have Ale : A ≤ 1 / 2 := by dsimp only [A]; apply min_le_iff.mpr; left; exact hA'.2
  set C := (C₁ * A ^ (3 / 4 : ℝ) - C₂ * 2 * A)⁻¹
  have Cpos : 0 < C := by
    refine ZetaInvBnd_aux2 (by positivity) (by positivity) (by positivity) ?_
    apply min_le_right
  refine ⟨A, ⟨Apos, by linarith [hA'.2]⟩ , C, Cpos, ?_⟩
  intro σ t t_gt hσ
  have logt_gt_one := logt_gt_one t_gt.le
  have σ_ge : 1 - A / Real.log |t| ≤ σ := by
    apply le_trans ?_ hσ.1
    suffices A / Real.log |t| ^ (9 : ℝ) ≤ A / Real.log |t| by linarith
    exact div_le_div₀ Apos.le (by rfl) (by positivity) <| ZetaInvBnd_aux logt_gt_one
  obtain ⟨_, _, neOne⟩ := UpperBnd_aux ⟨Apos, Ale⟩ t_gt σ_ge
  set σ' := 1 + A / Real.log |t| ^ (9 : ℝ)
  have σ'_gt : 1 < σ' := by simp only [σ', lt_add_iff_pos_right]; positivity
  have σ'_le : σ' ≤ 2 := by
    simp only [σ']
    suffices A / Real.log |t| ^ (9 : ℝ) < 1 by linarith
    apply div_lt_one (by positivity) |>.mpr
    exact lt_trans₄ (by linarith) logt_gt_one <| ZetaInvBnd_aux' logt_gt_one
  set s := σ + t * I
  set s' := σ' + t * I
  by_cases h0 : ‖riemannZeta s‖ ≠ 0
  swap
  · simp only [ne_eq, not_not] at h0; simp only [h0, div_zero]; positivity
  apply div_le_iff₀ (by positivity) |>.mpr <| div_le_iff₀' (by positivity) |>.mp ?_
  have pos_aux : 0 < (σ' - 1) := by linarith
  calc
    _ ≥ ‖riemannZeta s'‖ - ‖riemannZeta s - riemannZeta s'‖ := ?_
    _ ≥ C₁ * (σ' - 1) ^ ((3 : ℝ)/ 4) * Real.log |t|  ^ ((-1 : ℝ)/ 4) - C₂ * Real.log |t| ^ 2 * (σ' - σ) := ?_
    _ ≥ C₁ * (A / Real.log |t| ^ (9 : ℝ)) ^ ((3 : ℝ)/ 4) * Real.log |t| ^ ((-1 : ℝ)/ 4) - C₂ * Real.log |t| ^ (2 : ℝ) * 2 * A / Real.log |t| ^ (9 : ℝ) := ?_
    _ ≥ C₁ * A ^ ((3 : ℝ)/ 4) * Real.log |t| ^ (-7 : ℝ) - C₂ * 2 * A * Real.log |t| ^ (-7 : ℝ) := ?_
    _ = (C₁ * A ^ ((3 : ℝ)/ 4) - C₂ * 2 * A) * Real.log |t| ^ (-7 : ℝ) := by ring
    _ ≥ _ := ?_
  · apply ge_iff_le.mpr
    convert norm_sub_norm_le (a := riemannZeta s') (b := riemannZeta s' - riemannZeta s) using 1
    · rw [(by simp : riemannZeta s' - riemannZeta s = -(riemannZeta s - riemannZeta s'))]; simp only [norm_neg]
    · simp
  · apply sub_le_sub
    · have := one_div_le ?_ (by positivity) |>.mp <| hC₁ ⟨σ'_gt, σ'_le⟩ t t_gt
      · convert this using 1
        rw [one_div, mul_inv_rev, mul_comm, mul_inv_rev, mul_comm _ C'⁻¹]
        simp only [one_div C', C₁]
        congr <;> (rw [← Real.rpow_neg (by linarith), neg_div]); rw [neg_neg]
      · apply norm_pos_iff.mpr <| riemannZeta_ne_zero_of_one_lt_re (by simp [σ'_gt])
    · rw [(by simp : riemannZeta s - riemannZeta s' = -(riemannZeta s' - riemannZeta s)), norm_neg]
      refine hC₂ σ σ' t t_gt ?_ σ'_le <| by rw [Set.mem_Ico] at hσ; exact hσ.2
      apply le_trans ?_ hσ.1
      rw [tsub_le_iff_right, ← add_sub_right_comm, le_sub_iff_add_le, add_le_add_iff_left]
      exact div_le_div₀ hA'.1.le (by simp [A]) (by positivity) <| ZetaInvBnd_aux logt_gt_one
  · apply sub_le_sub (by simp only [add_sub_cancel_left, σ']; exact_mod_cast le_rfl) ?_
    rw [mul_div_assoc, mul_assoc _ 2 _]
    apply mul_le_mul (by exact_mod_cast le_rfl) ?_ (by linarith [hσ.2]) (by positivity)
    suffices h : σ' + (1 - A / Real.log |t| ^ (9 : ℝ)) ≤ (1 + A / Real.log |t| ^ (9 : ℝ)) + σ by
      simp only [tsub_le_iff_right]
      convert! le_sub_right_of_add_le h using 1; ring_nf
    exact add_le_add (by linarith) (by linarith [hσ.1])
  · simp_rw [tsub_le_iff_right, div_eq_mul_inv _ (Real.log |t| ^ (9 : ℝ))]
    rw [← Real.rpow_neg (by positivity), Real.mul_rpow (by positivity) (by positivity)]
    rw [← Real.rpow_mul (by positivity)]
    ring_nf
    conv => rhs; lhs; rw [mul_assoc, ← Real.rpow_add (by positivity)]
    rw [(by ring : C₂ * Real.log |t| ^ (2 : ℝ) * A * Real.log |t| ^ (-9 : ℝ) * 2 = C₂ * (Real.log |t| ^ (2 : ℝ) * Real.log |t| ^ (-9 : ℝ) ) * A * 2)]
    rw [← Real.rpow_add (by positivity)]; norm_num; group; exact le_rfl
  · apply div_le_iff₀ (by positivity) |>.mpr
    conv => rw [mul_assoc]; rhs; rhs; rw [mul_comm C, ← mul_assoc, ← Real.rpow_add (by positivity)]
    have := inv_inv C ▸ mul_inv_cancel₀ (a := C⁻¹) (by positivity) |>.symm.le
    simpa [C] using this

lemma ZetaLowerBnd :
    ∃ (A : ℝ) (_ : A ∈ Ioc 0 (1 / 2)) (c : ℝ) (_ : 0 < c),
    ∀ (σ : ℝ)
    (t : ℝ) (_ : 3 < |t|)
    (_ : σ ∈ Ico (1 - A / (Real.log |t|) ^ (9 : ℝ)) 1),
    c / (Real.log |t|) ^ (7 : ℝ) ≤ ‖riemannZeta (σ + t * I)‖ := by
  obtain ⟨C₁, C₁pos, hC₁⟩ := ZetaLowerBound3
  obtain ⟨A', hA', C₂, C₂pos, hC₂⟩ := Zeta_diff_Bnd

                                                                                       

  let A := min A' ((C₁ / (4 * C₂)) ^ 4)
  have hA : A ∈ Ioc 0 (1 / 2) :=
    ⟨lt_min hA'.1 (by positivity), (min_le_left A' _).trans hA'.2⟩

  let C := C₁ * A ^ ((3:ℝ) /4) - 2 * C₂ * A
  have hc_pos : 0 < C := by
    have:= A.rpow_le_rpow hA.1.le (min_le_right _ _) (inv_pos.mpr four_pos).le
    erw [Real.pow_rpow_inv_natCast (div_pos C₁pos (mul_pos four_pos C₂pos)).le four_ne_zero,
      le_div_iff₀ (mul_pos four_pos C₂pos)] at this
    norm_num [mul_assoc, C, mul_left_comm, C₂pos, hA.1,
      (mul_le_mul_of_nonneg_right this (A.rpow_nonneg hA.1.le _)).trans_lt', ←A.rpow_add]

  refine ⟨A, hA, C, hc_pos, fun σ t L ⟨σ_low_bound, σ_le_one⟩=>?_⟩

  let σ' := 1 + A / Real.log |t| ^  (9 : ℝ)

  have triangular :  ‖riemannZeta (σ + t * I)‖ ≥  ‖riemannZeta (σ' + t * I)‖ -  ‖riemannZeta (σ + t * I) - riemannZeta (σ' + t * I)‖ := by
    apply sub_le_iff_le_add.mpr.comp (sub_sub_self @_ (@_ : ℂ)▸norm_sub_le _ _).trans
      (by rw [add_comm])

  have one_leLogT : 1 ≤ Real.log |t| := (logt_gt_one L.le).le
  have one_half_le_log_pow : 1 / 2 ≤ Real.log |t| ^ 9 :=
    one_half_lt_one.le.trans <| one_le_pow₀ one_leLogT

  have σ'_ge : 1 ≤ σ' := by
    simp_all only [gt_iff_lt, mem_Ioc, Real.log_abs, one_div, and_imp, tsub_le_iff_right,
      lt_inf_iff, div_pos_iff_of_pos_left, Nat.ofNat_pos, mul_pos_iff_of_pos_left, pow_pos,
      and_self, inf_le_iff, true_or, sub_pos, mem_Ico, and_true, ofReal_add, ofReal_one,
      ofReal_div, ge_iff_le, le_add_iff_nonneg_right, A, C, σ']
    apply div_nonneg
    · apply le_min
      · linarith
      · have : (C₁ / (4 * C₂)) ^ 4 = ((C₁ / (4 * C₂)) ^ 2) ^ 2 := by ring
        rw [this]
        apply sq_nonneg
    · positivity

  have right_sub :  -‖riemannZeta (σ + t * I) -  riemannZeta (σ' + t * I)‖ ≥ - C₂ * Real.log |t| ^ 2 * (σ' - σ) := by
    change - C₂ * Real.log |t| ^ 2 * (σ' - σ) ≤ -‖riemannZeta (σ + t * I) -  riemannZeta (σ' + t * I)‖
    have := hC₂ σ σ' t L ?_ ?_ ?_
    · convert! neg_le_neg this using 1
      · ring
      · congr! 1
        have : riemannZeta (↑σ + ↑t * I) - riemannZeta (↑σ' + ↑t * I) =
            - (riemannZeta (↑σ' + ↑t * I) - riemannZeta (↑σ + ↑t * I)) := by ring
        rw [this, norm_neg]
    · have : 1 - A' / Real.log |t| ≤ (1 : ℝ) - A / (Real.log |t|) ^ (9 : ℝ) := by
        gcongr
        · exact hA'.1.le
        · bound
        · rw [← Real.rpow_one (Real.log |t|), ← Real.rpow_mul (by linarith), one_mul]
          exact Real.rpow_le_rpow_of_exponent_le one_leLogT Nat.one_le_ofNat
      linarith
    · have : σ' ≤ 1 + A := by
        simp_all only [gt_iff_lt, mem_Ioc, Real.log_abs, one_div, and_imp, tsub_le_iff_right,
          lt_inf_iff, div_pos_iff_of_pos_left, Nat.ofNat_pos, mul_pos_iff_of_pos_left, pow_pos,
          and_self, inf_le_iff, true_or, sub_pos, mem_Ico, and_true, ofReal_add, ofReal_one,
          ofReal_div, ge_iff_le, le_add_iff_nonneg_right, add_le_add_iff_left, le_inf_iff,
          σ', A, C]
        have : 1 ≤ Real.log t ^ (9 : ℝ) := Real.one_le_rpow one_leLogT (Nat.ofNat_nonneg' 9)
        refine ⟨?_, ?_⟩
        · rw [← min_div_div_right]
          · rw [min_le_iff]
            left
            bound
          · exact le_trans (zero_le_one) this
        · rw [← min_div_div_right]
          · rw [min_le_iff]
            right
            bound
          · exact le_trans (zero_le_one) this
      · bound [hA.2]
    · linarith

  have right' : -‖riemannZeta (σ + t * I) -  riemannZeta (σ' + t * I)‖   ≥ - C₂ * 2 * A / Real.log |t| ^ 7 := by
    have := (abs t).log_pos (by bound)
    refine right_sub.trans' ((div_le_iff₀ (pow_pos this 7)).2 @?_|>.trans
      (mul_le_mul_of_nonpos_left (sub_le_sub_left σ_low_bound (1+_) )
        (by ·linear_combination C₂*this*(.log |t|))))
    exact (mod_cast (by linear_combination (2 *_* A) *div_self ↑(pow_pos this 09).ne'))

  have left_sub : ‖riemannZeta (σ' + t * I)‖ ≥ C₁ * (σ' - 1) ^ ((3:ℝ) /4) / Real.log |t| ^ 4 := by
    use (hC₁ ⟨lt_add_of_pos_right (1) (by bound[hA.1]),
      add_le_of_le_sub_left ((div_le_iff₀ (by bound)).2 (hA.2.trans (?_)))⟩ t L).trans' ?_
    · norm_num only [one_mul, Real.rpow_ofNat, one_half_le_log_pow]
    · simp_all only [gt_iff_lt, mem_Ioc, lt_inf_iff, div_pos_iff_of_pos_left, Nat.ofNat_pos,
        mul_pos_iff_of_pos_left, pow_pos, and_self, inf_le_iff, true_or, sub_pos, mem_Ico,
        ofReal_add, ofReal_one, ofReal_div, ge_iff_le, le_add_iff_nonneg_right, neg_mul,
        neg_le_neg_iff, add_sub_cancel_left, σ', A, C]
      gcongr
      have :  Real.log |t| ^ ((1 : ℝ) / 4) ≤ Real.log |t| ^ (4 : ℝ) :=
        Real.rpow_le_rpow_of_exponent_le one_leLogT (by norm_num)
      exact_mod_cast this

  have left' : ‖riemannZeta (σ' + t * I)‖ ≥ C₁ * A ^ ((3:ℝ) /4) / Real.log |t| ^ 7 := by
    contrapose! hC₁
    use σ', ⟨lt_add_of_pos_right 1<|by bound[hA'.1],
      add_le_of_le_sub_left ((div_le_iff₀ (by bound)).2 (hA.2.trans ?_))⟩, t, L, hC₁.trans_le ?_
    · norm_num only [one_mul, Real.rpow_ofNat, one_half_le_log_pow]
    · norm_num only [σ', add_sub_cancel_left, A.div_rpow hA.1.le, mul_div, pow_pos, L.trans',
        ←Real.rpow_natCast, ←Real.rpow_mul, le_of_lt, Real.log_pos, refl, div_div, ←Real.rpow_sub]
      rw [Real.div_rpow hA.1.le, ← Real.rpow_mul (by linarith), ← mul_div_assoc, div_div, ← Real.rpow_add (by linarith)]
      · norm_num
      · apply Real.rpow_nonneg (by linarith)
  have ineq : ‖riemannZeta (σ + t * I)‖ ≥ (C₁ * A ^ ((3:ℝ) /4) - C₂ * 2 * A) / Real.log |t| ^ 7 := by
    linear_combination left'+triangular+right'

  rw [mul_comm C₂] at ineq
  exact_mod_cast ineq

def ZetaZeroFreeGenProp (n : ℝ) : Prop := ∃ (A : ℝ) (_ : A ∈ Ioc 0 (1 / 2)),
    ∀ (σ : ℝ) (t : ℝ) (_ : 3 < |t|) (_ : σ ∈ Ico (1 - A / (Real.log |t|) ^ n) 1),
    riemannZeta (σ + t * I) ≠ 0

lemma ZetaZeroFree9 : ZetaZeroFreeGenProp 9 := by
  obtain ⟨A, hA, c, hc, h_lower⟩ := ZetaLowerBnd

  refine ⟨A, hA, ?_⟩

  intro σ t ht hσ h_zero

  have := h_lower σ t ht hσ

  rw [h_zero, norm_zero] at this

  have pos_bound : 0 < c / (Real.log |t|) ^ (7 : ℝ) := by
    apply div_pos hc
    apply Real.rpow_pos_of_pos
    apply Real.log_pos
    linarith
  linarith

lemma LogDerivZetaBnd :
    ∃ (A : ℝ) (_ : A ∈ Ioc 0 (1 / 2)) (C : ℝ) (_ : 0 < C), ∀ (σ : ℝ) (t : ℝ) (_ : 3 < |t|)
    (_ : σ ∈ Ico (1 - A / Real.log |t| ^ (9 : ℝ)) (1 + A / Real.log |t| ^ (9 : ℝ))),
      ‖(deriv riemannZeta) (σ + t * I) / riemannZeta (σ + t * I)‖ ≤ C * Real.log |t| ^ (9 : ℝ) := by
  obtain ⟨A, hA, C, hC, h⟩ := ZetaInvBnd
  obtain ⟨A', hA', C', hC', h'⟩ := ZetaDerivUpperBnd
  use min A A', ⟨lt_min hA.1 hA'.1, min_le_of_right_le hA'.2⟩, C * C', mul_pos hC hC'
  intro σ t t_gt ⟨σ_ge, σ_lt⟩
  have logt_gt : (1 : ℝ) < Real.log |t| := logt_gt_one t_gt.le
  have σ_ge' : 1 - A / Real.log |t| ^ (9 : ℝ) ≤ σ := by
    apply le_trans (tsub_le_tsub_left ?_ 1) σ_ge
    apply div_le_div_of_nonneg_right (min_le_left A A')
    apply Real.rpow_nonneg
    linarith
  have σ_ge'' : 1 - A' / Real.log |t| ≤ σ := by
    apply le_trans (tsub_le_tsub_left ?_ 1) σ_ge
    apply div_le_div₀ hA'.1.le (min_le_right A A') (lt_trans (by norm_num) logt_gt) ?_
    rw [← Real.rpow_one (Real.log |t|), ← Real.rpow_mul (by linarith), one_mul]
    exact Real.rpow_le_rpow_of_exponent_le logt_gt.le Nat.one_le_ofNat
  replace h := h σ t t_gt ⟨σ_ge', by calc
    σ < 1 + min A A' / Real.log |t| ^ (9 : ℝ) := σ_lt
    _ ≤ 1 + A / Real.log |t| ^ (9 : ℝ) := by gcongr; simp⟩
  replace h' := h' σ t t_gt ⟨σ_ge'', by
   calc
    σ ≤ 1 + min A A' / Real.log |t| ^ (9 : ℝ) := by linarith [σ_lt]
    _ ≤ 1 + (1/2) / Real.log |t| ^ (9 : ℝ) := by gcongr; simp [Set.mem_Ioc] at hA' hA ⊢ ; simp [hA.2]
    _ ≤ 1 + (1/2) / 1 := by
          gcongr
          calc
            1 ≤ Real.log |t| := by linarith
            _ ≤ (Real.log |t|) ^ (9 : ℝ) := Real.self_le_rpow_of_one_le (by linarith) (by linarith)
    _ ≤ 2 := by linarith
    ⟩
  simp only [norm_div]
  convert! mul_le_mul h h' (by simp) ?_ using 1 <;> (norm_cast; ring_nf); positivity

                                                                                                

                                                             

  

  

 

             

  

  

           

lemma ZetaNoZerosOn1Line (t : ℝ) : riemannZeta (1 + t * I) ≠ 0 := by
  refine riemannZeta_ne_zero_of_one_le_re ?_
  simp

lemma ZetaCont : ContinuousOn riemannZeta (univ \ {1}) := by
  apply continuousOn_of_forall_continuousAt (fun x hx ↦ ?_)
  apply DifferentiableAt.continuousAt (𝕜 := ℂ)
  convert differentiableAt_riemannZeta ?_
  simp only [Set.mem_sdiff, mem_univ, mem_singleton_iff, true_and] at hx
  exact hx

lemma ZetaNoZerosInBox (T : ℝ) :
    ∃ (σ : ℝ) (_ : σ < 1), ∀ (t : ℝ) (_ : |t| ≤ T)
    (σ' : ℝ) (_ : σ' ≥ σ), riemannZeta (σ' + t * I) ≠ 0 := by
  by_contra! h
  have hn (n : ℕ) := h (1 - 1 / (n + 1)) (sub_lt_self _ (by positivity))

  have : ∃ (tn : ℕ → ℝ) (σn : ℕ → ℝ), (∀ n, σn n ≤ 1) ∧
    (∀ n, (1 : ℝ) - 1 / (n + 1) ≤ σn n) ∧ (∀ n, |tn n| ≤ T) ∧
    (∀ n, riemannZeta (σn n + tn n * I) = 0) := by
    choose t ht σ' hσ' hζ using hn
    refine ⟨t, σ', ?_, hσ', ht, hζ⟩
    intro n
    by_contra! hσn
    have := riemannZeta_ne_zero_of_one_lt_re (s := σ' n + t n * I)
    simp only [add_re, ofReal_re, mul_re, I_re, mul_zero, ofReal_im, I_im, mul_one, sub_self,
      add_zero, ne_eq] at this
    exact this hσn (hζ n)

  choose t σ' hσ'_le hσ'_ge ht hζ using this

  have σTo1 : Filter.Tendsto σ' Filter.atTop (𝓝 1) := by
    use sub_zero (1: ℝ)▸tendsto_order.2 ⟨fun A B=>? _,fun A B=>?_⟩
    · apply (((tendsto_inv_atTop_nhds_zero_nat.comp
        (Filter.tendsto_add_atTop_nat (1))).congr (by norm_num)).const_sub 1).eventually_const_lt
          B|>.mono (hσ'_ge ·|>.trans_lt')
    · norm_num[(hσ'_le _).trans_lt, B.trans_le']

  have : ∃ (t₀ : ℝ) (subseq : ℕ → ℕ),
      Filter.Tendsto (t ∘ subseq) Filter.atTop (𝓝 t₀) ∧
      Filter.Tendsto subseq Filter.atTop Filter.atTop := by
    refine (isCompact_Icc.isSeqCompact fun and => abs_le.1 (ht and)).imp fun and ⟨x, A, B, _⟩ => ?_
    use A, by omega, B.tendsto_atTop

  obtain ⟨t₀, subseq, tTendsto, subseqTendsto⟩ := this

  have σTo1 : Filter.Tendsto (σ' ∘ subseq) Filter.atTop (𝓝 1) :=
    σTo1.comp subseqTendsto

  have (n : ℕ) : riemannZeta (σ' (subseq n) + I * (t (subseq n))) = 0 := by
    convert hζ (subseq n) using 3
    ring

  have ToOneT0 : Filter.Tendsto (fun n ↦ (σ' (subseq n) : ℂ) + Complex.I * (t (subseq n))) Filter.atTop
      (𝓝[≠]((1 : ℂ) + I * t₀)) := by
    simp_rw [tendsto_nhdsWithin_iff, Function.comp_def] at tTendsto ⊢
    constructor
    · exact (σTo1.ofReal.add (tTendsto.ofReal.const_mul _)).trans (by simp)
    · filter_upwards with n
      apply ne_of_apply_ne riemannZeta
      rw [this]
      apply Ne.symm
      apply riemannZeta_ne_zero_of_one_le_re
      simp only [add_re, one_re, mul_re, I_re, ofReal_re, zero_mul, I_im, ofReal_im, mul_zero,
        sub_self, add_zero, le_refl]

  by_cases ht₀ : t₀ = 0
  · have ZetaBlowsUp : ∀ᶠ s in 𝓝[≠](1 : ℂ), ‖riemannZeta s‖ ≥ 1 := by
      simp_all only [ge_iff_le, one_div, tsub_le_iff_right, Function.comp_def, ofReal_zero,
        mul_zero, add_zero, norm_eq_sqrt_real_inner, Complex.inner, mul_re, conj_re, conj_im,
        mul_neg, sub_neg_eq_add, Real.one_le_sqrt, eventually_nhdsWithin_iff, mem_compl_iff,
        mem_singleton_iff]
      contrapose! h
      simp_all only [ne_eq]
      delta abs at*
      exfalso
      simp_rw [Metric.nhds_basis_ball.frequently_iff]at*
      choose! I A B using h
      choose a s using exists_seq_strictAnti_tendsto (0: ℝ)
      apply ((isCompact_closedBall _ _).isSeqCompact
        fun and=>(A _ (s.2.1 and)).le.trans (s.2.2.bddAbove_range.some_mem ⟨and, rfl⟩)).elim
      simp only [Metric.mem_ball, dist_eq_norm_sub] at A
      refine fun and ⟨a, H, S, M⟩=> ?_
      refine absurd (tendsto_nhds_unique M (tendsto_sub_nhds_zero_iff.1
        (( squeeze_zero_norm fun and=>le_of_lt (A _ (s.2.1 _) ) )
          (s.2.2.comp S.tendsto_atTop)))) fun and=>?_
      norm_num[*,Function.comp_def] at M
      have:=@riemannZeta_residue_one
      use one_ne_zero (tendsto_nhds_unique (this.comp (tendsto_nhdsWithin_iff.2
        ⟨ M,.of_forall (by norm_num[*])⟩)) ( squeeze_zero_norm ?_
          ((M.sub_const 1).norm.trans (by rw [sub_self,norm_zero]))))
      use fun and =>.trans (norm_mul_le_of_le ↑(le_rfl) (Complex.norm_def _▸Real.sqrt_le_one.mpr
        (B ↑_ (s.2.1 ↑_)).right.le)) (by rw [mul_one])

    have ZetaNonZ : ∀ᶠ s in 𝓝[≠](1 : ℂ), riemannZeta s ≠ 0 := by
      filter_upwards [ZetaBlowsUp]
      intro s hs hfalse
      rw [hfalse] at hs
      simp only [norm_zero, ge_iff_le] at hs
      linarith

    rw [ht₀] at ToOneT0
    simp only [ofReal_zero, mul_zero, add_zero] at ToOneT0
    rcases (ToOneT0.eventually ZetaNonZ).exists with ⟨n, hn⟩
    exact hn (this n)

  · have zetaIsZero : riemannZeta (1 + Complex.I * t₀) = 0 := by
      have cont := @ZetaCont
      use isClosed_singleton.isSeqClosed
        this
        (.comp
          (cont.continuousAt.comp (eventually_ne_nhds (by field_simp; simp [ht₀])).mono
            fun and=>.intro ⟨⟩)
          (ToOneT0.trans (inf_le_left)))

    exact riemannZeta_ne_zero_of_one_le_re (s := 1 + I * t₀) (by simp) zetaIsZero

lemma LogDerivZetaHoloOn {S : Set ℂ} (s_ne_one : 1 ∉ S)
    (nonzero : ∀ s ∈ S, riemannZeta s ≠ 0) :
    HolomorphicOn (fun s ↦ (deriv riemannZeta) s / riemannZeta s) S := by
  apply DifferentiableOn.div _ _ nonzero <;> intro s hs <;> apply DifferentiableAt.differentiableWithinAt
  · apply differentiableAt_deriv_riemannZeta
    exact ne_of_mem_of_not_mem hs s_ne_one
  · apply differentiableAt_riemannZeta
    exact ne_of_mem_of_not_mem hs s_ne_one

theorem LogDerivZetaHolcSmallT :
    ∃ (σ₂ : ℝ) (_ : σ₂ < 1), HolomorphicOn (fun (s : ℂ) ↦ (deriv riemannZeta) s / (riemannZeta s))
      (( [[ σ₂, 2 ]] ×ℂ [[ -3, 3 ]]) \ {1}) := by
  obtain ⟨σ₂, hσ₂_lt_one, hζ_ne_zero⟩ := ZetaNoZerosInBox 3
  refine ⟨σ₂, hσ₂_lt_one, ?_⟩
  let U := ([[σ₂, 2]] ×ℂ [[-3, 3]]) \ {1}
  have s_in_U_im_le3 : ∀ s ∈ U, |s.im| ≤ 3 := by
    intro s hs
    rw [Set.mem_sdiff_singleton] at hs
    rcases hs with ⟨hbox, _hne⟩
    rcases hbox with ⟨hre, him⟩
    simp only [Set.mem_preimage] at him
    obtain ⟨him_lower, him_upper⟩ := him
    apply abs_le.2
    simp only [neg_le_self_iff, Nat.ofNat_nonneg, inf_of_le_left] at him_lower
    simp only [neg_le_self_iff, Nat.ofNat_nonneg, sup_of_le_right] at him_upper
    exact ⟨him_lower, him_upper⟩

  have s_in_U_re_ges2 : ∀ s ∈ U, σ₂ ≤ s.re := by
    intro s hs
    rw [Set.mem_sdiff_singleton] at hs
    rcases hs with ⟨hbox, _hne⟩
    rcases hbox with ⟨hre, _him⟩
    simp only [Set.mem_preimage] at hre
    obtain ⟨hre_lower, hre_upper⟩ := hre
    have : min σ₂ 2 = σ₂ := by
      apply min_eq_left
      linarith [hσ₂_lt_one]
    rwa [← this]

  apply LogDerivZetaHoloOn
  · exact Set.notMem_sdiff_of_mem rfl
  · intro s hs
    rw[← re_add_im s]
    apply hζ_ne_zero
    · apply s_in_U_im_le3 _ hs
    · apply s_in_U_re_ges2 _ hs

lemma LogDerivZetaHolcSmallT' : ∃ (σ₂ : ℝ)
  (_ : σ₂ ∈ Ioo 0 1), HolomorphicOn (fun (s : ℂ) ↦ (deriv riemannZeta) s / (riemannZeta s))
    (( [[ σ₂, 2 ]] ×ℂ [[ -3, 3 ]]) \ {1}) := by
  obtain ⟨σ₂', σ₂'_lt_one, holo2'⟩ := LogDerivZetaHolcSmallT
  let σ₂ : ℝ := max σ₂' (1 / 2)
  have σ₂_pos : 0 < σ₂ := by bound
  have σ₂_lt_one : σ₂ < 1 := by bound
  refine ⟨σ₂, ⟨σ₂_pos, σ₂_lt_one⟩, holo2'.mono (fun s hs ↦ ?_)⟩
  simp only [neg_le_self_iff, Nat.ofNat_nonneg, uIcc_of_le, Set.mem_sdiff, mem_reProdIm, mem_Icc,
    mem_singleton_iff] at hs ⊢
  refine ⟨?_, hs.2⟩
  refine ⟨?_, hs.1.2⟩
  rcases hs.1.1 with ⟨left, right⟩
  constructor
  · apply le_trans _ left
    apply min_le_min_right
    apply le_max_left
  · rw [max_eq_right (by linarith)] at right ⊢
    exact right

def LogDerivZetaHolcLargeTGenProp (n : ℝ) : Prop := ∃ (A : ℝ) (_ : A ∈ Ioc 0 (1 / 2)),
    ∀ (T : ℝ) (_ : 3 ≤ T),
    HolomorphicOn (fun (s : ℂ) ↦ (deriv riemannZeta) s / (riemannZeta s))
      (( (Icc ((1 : ℝ) - A / Real.log T ^ n) 2)  ×ℂ (Icc (-T) T) ) \ {1})

lemma LogDerivZetaHolcLargeTGen {n : ℝ} (ZetaZeroFree : ZetaZeroFreeGenProp n) (n_pos : 0 < n) :
  LogDerivZetaHolcLargeTGenProp n := by
  obtain ⟨A, A_inter, restOfZetaZeroFree⟩ := ZetaZeroFree
  obtain ⟨σ₁, σ₁_lt_one, noZerosInBox⟩ := ZetaNoZerosInBox 3
  let A₀ := min A ((1 - σ₁) * Real.log 3 ^ n)
  refine ⟨A₀, ?_, ?_⟩
  · constructor
    · apply lt_min A_inter.1
      bound
    · exact le_trans (min_le_left _ _) A_inter.2
  intro T hT
  apply LogDerivZetaHoloOn
  · exact Set.notMem_sdiff_of_mem rfl
  intro s hs
  rcases le_or_gt 1 s.re with one_le|lt_one
  · exact riemannZeta_ne_zero_of_one_le_re one_le
  rw [← re_add_im s]
  have := Complex.mem_reProdIm.mp hs.1
  rcases lt_or_ge 3 |s.im| with gt3|le3
  · apply restOfZetaZeroFree _ _ gt3
    refine ⟨?_, lt_one⟩
    calc
      _ ≤ 1 - A₀ / Real.log T ^ n := by
        gcongr
        · exact A_inter.1.le
        · bound
        · bound
        · bound
        · exact abs_le.mpr ⟨this.2.1, this.2.2⟩
      _ ≤ _:= by exact this.1.1
  · apply noZerosInBox _ le3
    calc
      _ ≥ 1 - A₀ / Real.log T ^ n := by exact this.1.1
      _ ≥ 1 - A₀ / Real.log 3 ^ n := by
        gcongr
        apply le_min A_inter.1.le
        bound
      _ ≥ 1 - (((1 - σ₁) * Real.log 3 ^ n)) / Real.log 3 ^ n := by
        gcongr
        apply min_le_right
      _ = _ := by field_simp; simp

theorem LogDerivZetaHolcLargeT9 : LogDerivZetaHolcLargeTGenProp 9 := by
  apply LogDerivZetaHolcLargeTGen ZetaZeroFree9 Nat.ofNat_pos'

theorem summable_complex_then_summable_real_part (f : ℕ → ℂ)
    (h : Summable f) : Summable (fun n ↦ (f n).re) := by
  rcases h with ⟨s, hs⟩
  exact ⟨s.re,  hasSum_re hs⟩

open ArithmeticFunction (vonMangoldt)

open scoped ComplexOrder in
theorem dlog_riemannZeta_bdd_on_vertical_lines_generalized
    (σ₀ σ₁ t : ℝ) (σ₀_gt_one : 1 < σ₀) (σ₀_lt_σ₁ : σ₀ ≤ σ₁) :
    ‖(- (deriv riemannZeta) (σ₁ + t * I) / riemannZeta (σ₁ + t * I))‖ ≤ ‖(deriv riemannZeta) σ₀ / riemannZeta σ₀‖ := by
  let s₁ := σ₁ + t * I
  have s₁_re_eq_sigma : s₁.re = σ₁ := by
    rw [add_re, ofReal_re, mul_I_re, ofReal_im]
    ring

  have s₀_re_eq_sigma : (↑σ₀ : ℂ).re = σ₀ := by
    rw [ofReal_re]

  let s₀ := σ₀

  have σ₁_gt_one : 1 < σ₁ := by exact lt_of_le_of_lt' σ₀_lt_σ₁ σ₀_gt_one
  have s₀_gt_one : 1 < (↑σ₀ : ℂ).re := by exact σ₀_gt_one

  have s₁_re_geq_one : 1 < s₁.re := by exact lt_of_lt_of_eq σ₁_gt_one (id (Eq.symm s₁_re_eq_sigma))
  rw [← (ArithmeticFunction.LSeries_vonMangoldt_eq_deriv_riemannZeta_div s₁_re_geq_one)]
  unfold LSeries

  have summable_von_mangoldt_at_σ₀ : Summable (fun i ↦ LSeries.term (fun n ↦ ↑(ArithmeticFunction.vonMangoldt n)) σ₀ i) := by
    exact ArithmeticFunction.LSeriesSummable_vonMangoldt σ₀_gt_one

  have summable_re_von_mangoldt_at_σ₀ :
      Summable (fun i ↦ (LSeries.term (fun n ↦ ↑(ArithmeticFunction.vonMangoldt n)) σ₀ i).re) := by
    exact summable_complex_then_summable_real_part (LSeries.term (fun n ↦ ↑(ArithmeticFunction.vonMangoldt n)) σ₀)
      summable_von_mangoldt_at_σ₀

  have summable_abs_value : Summable (fun i ↦ ‖LSeries.term (fun n ↦ ↑(ArithmeticFunction.vonMangoldt n)) s₁ i‖) := by
    rw [summable_norm_iff]
    exact ArithmeticFunction.LSeriesSummable_vonMangoldt s₁_re_geq_one
  apply le_trans <| norm_tsum_le_tsum_norm summable_abs_value
  rw [← norm_neg, ← neg_div, ← ArithmeticFunction.LSeries_vonMangoldt_eq_deriv_riemannZeta_div s₀_gt_one]
  unfold LSeries
  rw [← re_eq_norm.mpr, re_tsum summable_von_mangoldt_at_σ₀]
  · apply Summable.tsum_mono summable_abs_value summable_re_von_mangoldt_at_σ₀
    intro n
    beta_reduce
    apply le_trans <| LSeries.norm_term_le_of_re_le_re (s := σ₀) _ _ _
    · rw [re_eq_norm.mpr]
      apply LSeries.term_nonneg
      exact_mod_cast ArithmeticFunction.vonMangoldt_nonneg
    · rwa [s₁_re_eq_sigma, s₀_re_eq_sigma]
  · apply tsum_nonneg
    intro n
    apply LSeries.term_nonneg
    exact_mod_cast ArithmeticFunction.vonMangoldt_nonneg

theorem triv_bound_zeta :  ∃C ≥ 0, ∀(σ₀ t : ℝ), 1 < σ₀ →
    ‖- (deriv riemannZeta) (σ₀ + t * I) / riemannZeta (σ₀ + t * I)‖ ≤ (σ₀ - 1)⁻¹ + C := by
  let ⟨U, ⟨U_in_nhds, zeta_residue_on_U⟩⟩ := riemannZetaLogDerivResidue
  let ⟨open_in_U, ⟨open_in_U_subs_U, open_in_U_is_open, one_in_open_U⟩⟩ :=
    mem_nhds_iff.mp U_in_nhds
  let ⟨ε₀, ⟨ε_pos, metric_ball_around_1_is_in_U'⟩⟩ :=
    EMetric.isOpen_iff.mp open_in_U_is_open (1 : ℂ) one_in_open_U

  let ε := if ε₀ = ⊤ then ENNReal.ofReal 1 else ε₀
  have O1 : ε ≠ ⊤ := by
    unfold ε
    by_cases h : ε₀ = ⊤ <;> simp [*]

  have metric_ball_around_1_is_in_U :
    Metric.eball (1 : ℂ) ε ⊆ U := by
      unfold ε
      by_cases h : ε₀ = ⊤
      · simp only [↓reduceIte, ENNReal.ofReal_one, h]
        have T : Metric.eball (1 : ℂ) 1 ⊆ Metric.eball 1 ε₀ := by
          simp [*]
        exact subset_trans (subset_trans T metric_ball_around_1_is_in_U') open_in_U_subs_U

      · simp only [h, ↓reduceIte]
        exact subset_trans metric_ball_around_1_is_in_U' open_in_U_subs_U

  have O2 : ε ≠ 0 := by
    unfold ε
    by_cases h : ε₀ = ⊤
    · simp [*]
    · simp only [↓reduceIte, ne_eq, h]
      exact pos_iff_ne_zero.mp ε_pos

  let metric_ball_around_1 := Metric.eball (1 : ℂ) ε
  let ε_div_two := ε / 2
  let boundary := ENNReal.toReal (1 + ε_div_two)

  let ⟨bound, ⟨bound_pos, bound_prop⟩⟩ :=
      BddAbove.exists_ge zeta_residue_on_U 0

  have boundary_geq_one : 1 < boundary := by
      unfold boundary
      have Z : (1 : ENNReal).toReal = 1 := by rfl
      rw [←Z]
      have U : ε_div_two ≠ ⊤ := by
        refine ENNReal.div_ne_top O1 ?_
        simp
      simp only [ENNReal.toReal_one, ne_eq, ENNReal.one_ne_top, not_false_eq_true,
        ENNReal.toReal_add _ U, lt_add_iff_pos_right, gt_iff_lt]
      refine ENNReal.toReal_pos ?_ ?_
      · unfold ε_div_two
        simp [*]
      · exact U

  let const : ℝ := bound
  let final_const : ℝ := (boundary - 1)⁻¹ + const
  have final_const_pos : final_const ≥ 0 := by bound
  have const_le_final_const : const ≤ final_const := by bound

  refine ⟨final_const, final_const_pos, fun σ₀ t σ₀_gt ↦ ?_⟩
  have U4 : ENNReal.ofReal 1 ≠ ⊤ := by exact ENNReal.ofReal_ne_top
  have Z0 : ε_div_two.toReal < ε.toReal := by
    exact ENNReal.toReal_strict_mono O1 <| ENNReal.half_lt_self O2 O1

                                                                     

  by_cases! h : σ₀ ≤ boundary
  · have σ₀_in_ball : (↑σ₀ : ℂ) ∈ metric_ball_around_1 := by
      unfold metric_ball_around_1
      unfold Metric.eball
      simp only [mem_ofPred_eq]
      rw [edist_dist, dist_eq_norm]
      norm_cast
      have U : 0 ≤ σ₀ - 1 := by linarith
      simp only [Real.norm_of_nonneg U, gt_iff_lt]
      simp only [ENNReal.ofReal_lt_iff_lt_toReal U O1]
      calc
        _ ≤ boundary - 1 := by linarith
        _ = ENNReal.toReal (1 + ε_div_two) - 1 := rfl
        _ = ENNReal.toReal (1 + ε_div_two) - ENNReal.toReal (ENNReal.ofReal 1) := by simp
        _ ≤ ENNReal.toReal (1 + ε_div_two - ENNReal.ofReal 1) := ENNReal.le_toReal_sub U4
        _ = ENNReal.toReal (ε_div_two) := by
          simp only [ENNReal.ofReal_one, ENNReal.addLECancellable_iff_ne, ne_eq,
            ENNReal.one_ne_top, not_false_eq_true, AddLECancellable.add_tsub_cancel_left]
        _ < ε.toReal := Z0

    have σ₀_in_U : (↑σ₀ : ℂ) ∈ (U \ {1}) := by
      refine Set.mem_sdiff_singleton.mpr ?_
      constructor
      · exact metric_ball_around_1_is_in_U σ₀_in_ball
      · by_contra a
        have U : σ₀ = 1 := by exact ofReal_eq_one.mp a
        rw [U] at σ₀_gt
        linarith

    have bdd := Set.forall_mem_image.mp bound_prop (σ₀_in_U)
    simp only [Function.comp_apply, Pi.sub_apply, Pi.neg_apply, Pi.div_apply] at bdd

    calc
      _ ≤ ‖(deriv riemannZeta) σ₀ / riemannZeta σ₀‖ := by
        exact dlog_riemannZeta_bdd_on_vertical_lines_generalized σ₀ σ₀ t (σ₀_gt) (by simp)
      _ = ‖- (deriv riemannZeta) σ₀ / riemannZeta σ₀‖ := by simp only [Complex.norm_div, norm_neg]
      _ = ‖(- (deriv riemannZeta) σ₀ / riemannZeta σ₀ - (σ₀ - 1)⁻¹) + (σ₀ - 1)⁻¹‖ := by
        simp only [Complex.norm_div, norm_neg, ofReal_inv, ofReal_sub, ofReal_one, sub_add_cancel]
      _ ≤ ‖(- (deriv riemannZeta) σ₀ / riemannZeta σ₀ - (σ₀ - 1)⁻¹)‖ + ‖(σ₀ - 1)⁻¹‖ := by
        have Z := norm_add_le (- (deriv riemannZeta) σ₀ / riemannZeta σ₀ - (σ₀ - 1)⁻¹) ((σ₀ - 1)⁻¹)
        norm_cast at Z
      _ ≤ const + ‖(σ₀ - 1)⁻¹‖ := by
        have U := add_le_add_left bdd ‖(σ₀ - 1)⁻¹‖
        ring_nf at U
        ring_nf
        norm_cast at U
        norm_cast
      _ ≤ const + (σ₀ - 1)⁻¹ := by
        simp [norm_inv]
        have pos : 0 ≤ σ₀ - 1 := by
          linarith
        simp [abs_of_nonneg pos]
      _ = (σ₀ - 1)⁻¹ + const := by
        rw [add_comm]
      _ ≤ (σ₀ - 1)⁻¹ + final_const := by
        simp [const_le_final_const]

  · have boundary_in_ball : (↑boundary : ℂ) ∈ metric_ball_around_1 := by
      unfold metric_ball_around_1
      unfold Metric.eball
      simp only [mem_ofPred_eq]
      rw [edist_dist, dist_eq_norm]
      norm_cast
      have U : 0 ≤ boundary - 1 := by linarith
      simp only [Real.norm_of_nonneg U, gt_iff_lt]
      simp only [ENNReal.ofReal_lt_iff_lt_toReal U O1]
      calc
        _ = ENNReal.toReal (1 + ε_div_two) - 1 := rfl
        _ = ENNReal.toReal (1 + ε_div_two) - ENNReal.toReal (ENNReal.ofReal 1) := by simp
        _ ≤ ENNReal.toReal (1 + ε_div_two - ENNReal.ofReal 1) := ENNReal.le_toReal_sub U4
        _ = ENNReal.toReal (ε_div_two) := by
          simp only [ENNReal.ofReal_one, ENNReal.addLECancellable_iff_ne, ne_eq,
            ENNReal.one_ne_top, not_false_eq_true, AddLECancellable.add_tsub_cancel_left]
        _ < ε.toReal := Z0

    have boundary_in_U : (↑boundary : ℂ) ∈ U \ {1} := by
      refine Set.mem_sdiff_singleton.mpr ?_
      constructor
      · exact metric_ball_around_1_is_in_U boundary_in_ball
      · by_contra a
        norm_cast at a
        norm_cast at boundary_geq_one
        simp [←a] at boundary_geq_one

    have bdd := Set.forall_mem_image.mp bound_prop (boundary_in_U)

    calc
      _ ≤ ‖(deriv riemannZeta) boundary / riemannZeta boundary‖ := by
        exact dlog_riemannZeta_bdd_on_vertical_lines_generalized boundary σ₀ t
          (boundary_geq_one) (by linarith)
      _ = ‖- (deriv riemannZeta) boundary / riemannZeta boundary‖ := by simp only [Complex.norm_div, norm_neg]
      _ = ‖(- (deriv riemannZeta) boundary / riemannZeta boundary - (boundary - 1)⁻¹) + (boundary - 1)⁻¹‖ := by
        simp only [Complex.norm_div, norm_neg, ofReal_inv, ofReal_sub, ofReal_one, sub_add_cancel]
      _ ≤ ‖(- (deriv riemannZeta) boundary / riemannZeta boundary - (boundary - 1)⁻¹)‖ + ‖(boundary - 1)⁻¹‖ := by
        have Z := norm_add_le (- (deriv riemannZeta) boundary / riemannZeta boundary - (boundary - 1)⁻¹) ((boundary - 1)⁻¹)
        norm_cast at Z
      _ ≤ const + ‖(boundary - 1)⁻¹‖ := by
        have U9 := add_le_add_left bdd ‖(boundary - 1)⁻¹‖
        ring_nf at U9
        ring_nf
        norm_cast at U9
        norm_cast
        simpa [*] using! U9
      _ ≤ const + (boundary - 1)⁻¹ := by
        simp [norm_inv]
        have pos : 0 ≤ boundary - 1 := by
          linarith
        simp [abs_of_nonneg pos]
      _ = (boundary - 1)⁻¹ + const := by
        rw [add_comm]
      _ = final_const := by rfl
      _ ≤ _ := by bound

def LogDerivZetaBndUnifGenProp (n₁ n₂ : ℝ) : Prop := ∃ (A : ℝ) (_ : A ∈ Ioc 0 (1 / 2))
  (C : ℝ) (_ : 0 < C), ∀ (σ : ℝ) (t : ℝ) (_ : 3 < |t|)
    (_ : σ ∈ Ici (1 - A / Real.log |t| ^ n₁)), ‖(deriv riemannZeta) (σ + t * I) / riemannZeta (σ + t * I)‖ ≤
      C * Real.log |t| ^ n₂

lemma LogDerivZetaBndUnif99 : LogDerivZetaBndUnifGenProp 9 9 := by
  let ⟨A, pf_A, C, C_pos, ζbd_in⟩ := LogDerivZetaBnd
  let ⟨C_triv, ⟨pf_C_triv, ζbd_out⟩⟩ := triv_bound_zeta
  have T0 : A > 0 := pf_A.1

  have ha : 1 ≤ A⁻¹ := by
    simp only [one_div, mem_Ioc, true_and, T0] at pf_A
    have U := (inv_le_inv₀ (by positivity) (by positivity)).mpr pf_A
    simp only [inv_inv] at U
    linarith

  refine ⟨A, pf_A, ((1 + C + C_triv) * A⁻¹), (by positivity), fun σ t hyp_t hyp_σ ↦ ?_⟩
  have logt_gt' : (1 : ℝ) < Real.log |t| ^ (9 : ℝ) := by
    calc
      1 < Real.log |t| := logt_gt_one hyp_t.le
      _ ≤ (Real.log |t|) ^ (9 : ℝ) := ZetaInvBnd_aux (logt_gt_one hyp_t.le)

  have logt_gt'' : (1 : ℝ) < 1 + A / Real.log |t| ^ (9 : ℝ) := by
    simp only [lt_add_iff_pos_right, div_pos_iff_of_pos_left, T0]
    positivity

  have T1 : ∀⦃σ : ℝ⦄, 1 + A / Real.log |t| ^ (9 : ℝ) ≤ σ → 1 < σ := by
    intros
    linarith

  have T2 : ∀⦃σ : ℝ⦄, 1 + A / Real.log |t| ^ (9 : ℝ) ≤ σ → A / Real.log |t| ^ (9 : ℝ) ≤ σ - 1 := by
    intro σ' hyp_σ'
    calc
      A / Real.log |t| ^ (9 : ℝ) = (1 + A / Real.log |t| ^ (9 : ℝ)) - 1 := by ring_nf
      _ ≤ σ' - 1 := by gcongr

  by_cases h : σ ∈ Ico (1 - A / Real.log |t| ^ (9 : ℝ)) (1 + A / Real.log |t| ^ (9 : ℝ))
  · calc
      ‖(deriv riemannZeta) (↑σ + ↑t * I) / riemannZeta (↑σ + ↑t * I)‖ ≤ C * Real.log |t| ^ 9 := ζbd_in σ t hyp_t h
      _ ≤ ((1 + C + C_triv) * A⁻¹) * Real.log |t| ^ (9 : ℝ) := by
          gcongr
          · calc
              C ≤ 1 + C := by simp only [le_add_iff_nonneg_left, zero_le_one]
              _ ≤ (1 + C + C_triv) * 1 := by simp only [mul_one, le_add_iff_nonneg_right]; positivity
              _ ≤ (1 + C + C_triv) * A⁻¹ := by gcongr

  · simp only [mem_Ico, tsub_le_iff_right, not_and, not_lt, mem_Ici] at h hyp_σ
    replace h := h hyp_σ
    calc
      ‖(deriv riemannZeta) (σ + t * I) / riemannZeta (σ + t * I)‖ = ‖-(deriv riemannZeta) (σ + t * I) / riemannZeta (σ + t * I)‖ := by simp only [Complex.norm_div,
        norm_neg]
      _ ≤ (σ - 1)⁻¹ + C_triv := ζbd_out σ t (by exact T1 h)
      _ ≤ (A / Real.log |t| ^ (9 : ℝ))⁻¹ + C_triv := by
          gcongr
          · exact T2 h
      _ ≤ (A / Real.log |t| ^ (9 : ℝ))⁻¹ + C_triv * A⁻¹ := by
          gcongr
          exact le_mul_of_one_le_right pf_C_triv ha
      _ ≤ (1 + C_triv) * A⁻¹ * Real.log |t| ^ (9 : ℝ) := by
          simp only [inv_div]
          ring_nf
          gcongr
          · simp only [inv_pos, le_mul_iff_one_le_left, T0]
            linarith
      _ ≤ (1 + C + C_triv) * A⁻¹ * Real.log |t| ^ (9 : ℝ) := by gcongr; simp only [le_add_iff_nonneg_right]; positivity
end

section

/-
Uniform continuous reciprocal-prime test functions, including variable endpoints.

A single Mertens remainder threshold controls all exponential prime bands whose
left logarithmic endpoint is bounded below by a positive constant. On a compact
rectangle, uniform continuity and boundedness then give convergence uniformly
in the test-function parameter and both endpoints. The number of equal grid
cells is fixed across all intervals; the endpoints of the cells may vary.

Only `PrimeReciprocalMeasure` and its already checked dependencies are used.
No additional analytic hypothesis is introduced.
-/

namespace Bounty

open Finset Filter Real MeasureTheory
open scoped Topology

theorem exponential_prime_band_harmonic_uniform_error
    {a ε : ℝ} (ha : 0 < a) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ u v : ℝ, a ≤ u → u ≤ v →
      |primeBandHarmonic (exp (u*L)) (exp (v*L))-log (v/u)| < ε := by
  have hr := Metric.tendsto_nhds.mp Mertens.prime_reciprocal_error_tendsto
    (ε/2) (by positivity)
  obtain ⟨X, hX⟩ := eventually_atTop.mp hr
  have he : Tendsto (fun L : ℝ => exp (a*L)) atTop atTop :=
    tendsto_exp_atTop.comp (tendsto_id.const_mul_atTop ha)
  filter_upwards [eventually_gt_atTop (0 : ℝ), he.eventually_ge_atTop X] with L hL hLX
  intro u v hau huv
  have hu := ha.trans_le hau
  have hv := hu.trans_le huv
  have hxu := hLX.trans (exp_le_exp.mpr (mul_le_mul_of_nonneg_right hau hL.le))
  have hxv := hxu.trans (exp_le_exp.mpr (mul_le_mul_of_nonneg_right huv hL.le))
  have hU := hX (exp (u*L)) hxu
  have hV := hX (exp (v*L)) hxv
  rw [Real.dist_eq] at hU hV
  rw [prime_band_harmonic_eq_prefix_sub (exp_pos _).le
    (exp_le_exp.mpr (mul_le_mul_of_nonneg_right huv hL.le))]
  have heq : primeBandHarmonic 0 (exp (v*L)) -
      primeBandHarmonic 0 (exp (u*L)) - log (v/u) =
      ((∑ p ∈ (Ioc 0 ⌊exp (v*L)⌋₊).filter Nat.Prime, 1/(p:ℝ)) -
        log (log (exp (v*L))) - Mertens.M) -
      ((∑ p ∈ (Ioc 0 ⌊exp (u*L)⌋₊).filter Nat.Prime, 1/(p:ℝ)) -
        log (log (exp (u*L))) - Mertens.M) := by
    simp only [primeBandHarmonic, primeBand, Nat.floor_zero, log_exp,
      log_mul hv.ne' hL.ne', log_mul hu.ne' hL.ne', log_div hv.ne' hu.ne']
    ring
  rw [heq]
  exact (abs_sub _ _).trans_lt (by linarith)

theorem exists_uniform_reciprocal_grid_oscillation
    {a b c d : ℝ} (hab : a < b) (F : ℝ × ℝ → ℝ)
    (hF : ContinuousOn F ((Set.Icc c d) ×ˢ (Set.Icc a b)))
    {η : ℝ} (hη : 0 < η) :
    ∃ N : ℕ, 0 < N ∧ ∀ w ∈ Set.Icc c d, ∀ u v : ℝ,
      a ≤ u → u ≤ v → v ≤ b → ∀ i : ℕ, i < N →
        ∀ x ∈ Set.Icc (reciprocalGrid u v N i) (reciprocalGrid u v N (i+1)),
          |F (w,x)-F (w,reciprocalGrid u v N i)| ≤ η := by
  have hu := (isCompact_Icc.prod isCompact_Icc).uniformContinuousOn_of_continuous hF
  obtain ⟨δ, hδ, hclose⟩ := Metric.uniformContinuousOn_iff_le.mp hu η hη
  obtain ⟨N, hN⟩ := exists_nat_gt ((b-a)/δ)
  have hN0 : 0 < N := by
    have hpos : (0 : ℝ) < N := (div_pos (sub_pos.mpr hab) hδ).trans hN
    exact_mod_cast hpos
  have hNr : (0 : ℝ) < N := by exact_mod_cast hN0
  have hstep : (b-a)/(N : ℝ) ≤ δ := by
    apply (div_le_iff₀ hNr).mpr
    have h := (div_lt_iff₀ hδ).mp hN
    nlinarith
  refine ⟨N, hN0, ?_⟩
  intro w hw u v hau huv hvb i hi x hx
  have hiN := reciprocal_grid_mem huv hN0 hi.le
  have hi1N := reciprocal_grid_mem huv hN0 (Nat.succ_le_of_lt hi)
  have hleft : reciprocalGrid u v N i ∈ Set.Icc a b :=
    ⟨hau.trans hiN.1, hiN.2.trans hvb⟩
  have hxmem : x ∈ Set.Icc a b :=
    ⟨hleft.1.trans hx.1, hx.2.trans (hi1N.2.trans hvb)⟩
  have hd : dist (w,x) (w,reciprocalGrid u v N i) ≤ δ := by
    simp only [Prod.dist_eq, dist_self, max_eq_right (dist_nonneg)]
    rw [Real.dist_eq, abs_of_nonneg (sub_nonneg.mpr hx.1)]
    calc
      _ ≤ reciprocalGrid u v N (i+1)-reciprocalGrid u v N i := sub_le_sub_right hx.2 _
      _ = (v-u)/(N : ℝ) := reciprocal_grid_step u v N i
      _ ≤ (b-a)/(N : ℝ) := div_le_div_of_nonneg_right (by linarith) hNr.le
      _ ≤ δ := hstep
  simpa only [Real.dist_eq] using hclose (w,x) ⟨hw,hxmem⟩
    (w,reciprocalGrid u v N i) ⟨hw,hleft⟩ hd

theorem exponential_prime_band_harmonic_mono
    {a b u v L : ℝ} (hL : 0 ≤ L) (hau : a ≤ u) (hvb : v ≤ b) :
    primeBandHarmonic (exp (u*L)) (exp (v*L)) ≤
      primeBandHarmonic (exp (a*L)) (exp (b*L)) := by
  apply sum_le_sum_of_subset_of_nonneg
  · intro p hp
    obtain ⟨hp, hpu, hpv⟩ := (mem_primeBand_iff (exp_pos _).le (exp_pos _).le p).mp hp
    exact (mem_primeBand_iff (exp_pos _).le (exp_pos _).le p).mpr ⟨hp,
      (exp_le_exp.mpr (mul_le_mul_of_nonneg_right hau hL)).trans_lt hpu,
      hpv.trans (exp_le_exp.mpr (mul_le_mul_of_nonneg_right hvb hL))⟩
  · intro p hp hpn
    positivity

theorem reciprocal_grid_sample_uniform_error
    (f : ℝ → ℝ) {a u v L C δ : ℝ} (hau : a ≤ u) (huv : u ≤ v)
    (hC : 0 ≤ C) {N : ℕ} (hN : 0 < N)
    (hbound : ∀ t ∈ Set.Icc u v, |f t| ≤ C)
    (herr : ∀ x y : ℝ, a ≤ x → x ≤ y →
      |primeBandHarmonic (exp (x*L)) (exp (y*L))-log (y/x)| ≤ δ) :
    |(∑ i ∈ range N, f (reciprocalGrid u v N i) *
        primeBandHarmonic (exp (reciprocalGrid u v N i*L))
          (exp (reciprocalGrid u v N (i+1)*L))) -
      (∑ i ∈ range N, f (reciprocalGrid u v N i) *
        log (reciprocalGrid u v N (i+1)/reciprocalGrid u v N i))| ≤
      (N : ℝ)*C*δ := by
  rw [← sum_sub_distrib]
  calc
    _ ≤ ∑ i ∈ range N, |f (reciprocalGrid u v N i) *
        primeBandHarmonic (exp (reciprocalGrid u v N i*L))
          (exp (reciprocalGrid u v N (i+1)*L)) -
      f (reciprocalGrid u v N i)*
        log (reciprocalGrid u v N (i+1)/reciprocalGrid u v N i)| := abs_sum_le_sum_abs _ _
    _ ≤ ∑ i ∈ range N, C*δ := by
      apply sum_le_sum
      intro i hi
      rw [← mul_sub, abs_mul]
      exact mul_le_mul (hbound _ (reciprocal_grid_mem huv hN (mem_range.mp hi).le))
        (herr _ _ (hau.trans (reciprocal_grid_mem huv hN (mem_range.mp hi).le).1)
          (reciprocal_grid_monotone huv N (Nat.le_succ i))) (abs_nonneg _) hC
    _ = _ := by simp [mul_assoc]

theorem exponential_prime_weighted_reciprocal_uniform_error
    {a b c d : ℝ} (ha : 0 < a) (hab : a < b) (F : ℝ × ℝ → ℝ)
    (hF : ContinuousOn F ((Set.Icc c d) ×ˢ (Set.Icc a b)))
    {ε : ℝ} (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ w ∈ Set.Icc c d, ∀ u v : ℝ,
      a ≤ u → u ≤ v → v ≤ b →
        |(∑ p ∈ primeBand (exp (u*L)) (exp (v*L)),
          F (w,log (p : ℝ)/L)/(p : ℝ)) -
          (∫ t in u..v, F (w,t)/t)| < ε := by
  obtain ⟨C₀, hC₀⟩ := (isCompact_Icc.prod isCompact_Icc).exists_bound_of_continuousOn hF
  let C : ℝ := |C₀|+1
  have hC : 0 < C := by dsimp [C]; positivity
  have hbound : ∀ w ∈ Set.Icc c d, ∀ t ∈ Set.Icc a b, |F (w,t)| ≤ C := by
    intro w hw t ht
    have h := hC₀ (w,t) ⟨hw,ht⟩
    rw [Real.norm_eq_abs] at h
    exact h.trans (by dsimp [C]; linarith [le_abs_self C₀])
  let B : ℝ := (|log (b/a)|+1)+(b-a)/a+1
  have hB : 0 < B := by dsimp [B]; positivity
  let η : ℝ := ε/(4*B)
  have hη : 0 < η := by dsimp [η]; positivity
  obtain ⟨N, hN, hosc⟩ := exists_uniform_reciprocal_grid_oscillation hab F hF hη
  have hNr : (0 : ℝ) < N := by exact_mod_cast hN
  let δ : ℝ := ε/(4*(N : ℝ)*C)
  have hδ : 0 < δ := by dsimp [δ]; positivity
  have hsample_budget : (N : ℝ)*C*δ = ε/4 := by dsimp [δ]; field_simp
  have happrox_budget : η*(|log (b/a)|+1)+(η/a)*(b-a) ≤ ε/4 := by
    have heq : η*B = ε/4 := by dsimp [η]; field_simp
    calc
      _ = η*(B-1) := by dsimp [B]; ring
      _ ≤ η*B := mul_le_mul_of_nonneg_left (by linarith) hη.le
      _ = ε/4 := heq
  have hmass := (exponential_prime_band_harmonic_tendsto ha hab.le).eventually_lt_const
    (show log (b/a) < |log (b/a)|+1 by linarith [le_abs_self (log (b/a))])
  filter_upwards [eventually_gt_atTop (0 : ℝ), hmass,
    exponential_prime_band_harmonic_uniform_error ha hδ] with L hL hm herr
  intro w hw u v hau huv hvb
  have hu := ha.trans_le hau
  let f : ℝ → ℝ := fun t => F (w,t)
  have hf : ContinuousOn f (Set.Icc u v) := by
    exact hF.comp (continuousOn_const.prodMk continuousOn_id) (by
      intro t ht
      exact ⟨hw, hau.trans ht.1, ht.2.trans hvb⟩)
  have hoscu := hosc w hw u v hau huv hvb
  let A : ℝ := ∑ i ∈ range N, f (reciprocalGrid u v N i) *
    primeBandHarmonic (exp (reciprocalGrid u v N i*L))
      (exp (reciprocalGrid u v N (i+1)*L))
  let J : ℝ := ∑ i ∈ range N, f (reciprocalGrid u v N i) *
    log (reciprocalGrid u v N (i+1)/reciprocalGrid u v N i)
  have hp : |(∑ p ∈ primeBand (exp (u*L)) (exp (v*L)),
      f (log (p : ℝ)/L)/(p : ℝ))-A| ≤ η*(|log (b/a)|+1) := by
    exact (reciprocal_grid_prime_approximation f huv hL hN hoscu).trans
      (mul_le_mul_of_nonneg_left
        ((exponential_prime_band_harmonic_mono hL.le hau hvb).trans hm.le) hη.le)
  have hs : |A-J| ≤ ε/4 := by
    rw [← hsample_budget]
    exact reciprocal_grid_sample_uniform_error f hau huv hC.le hN
      (fun t ht => hbound w hw t ⟨hau.trans ht.1, ht.2.trans hvb⟩)
      (fun x y hax hxy => (herr x y hax hxy).le)
  have hint : |(∫ t in u..v, f t/t)-J| ≤ (η/a)*(b-a) := by
    exact (reciprocal_grid_integral_approximation f hu huv hη.le hf hN hoscu).trans
      (mul_le_mul (div_le_div_of_nonneg_left hη.le ha hau)
        (by linarith) (sub_nonneg.mpr huv) (div_nonneg hη.le ha.le))
  have hi : |J-(∫ t in u..v, f t/t)| ≤ (η/a)*(b-a) := by
    simpa only [abs_sub_comm] using hint
  have htri := abs_sub_le (∑ p ∈ primeBand (exp (u*L)) (exp (v*L)),
    f (log (p : ℝ)/L)/(p : ℝ)) A (∫ t in u..v, f t/t)
  have htri' := abs_sub_le A J (∫ t in u..v, f t/t)
  change |(∑ p ∈ primeBand (exp (u*L)) (exp (v*L)),
    f (log (p : ℝ)/L)/(p : ℝ))-(∫ t in u..v, f t/t)| < ε
  linarith

theorem exponential_prime_weighted_reciprocal_uniform_tendsto
    {a b c d : ℝ} (ha : 0 < a) (hab : a < b) (F : ℝ × ℝ → ℝ)
    (hF : ContinuousOn F ((Set.Icc c d) ×ˢ (Set.Icc a b))) :
    TendstoUniformlyOn
      (fun (L : ℝ) (x : ℝ × ℝ × ℝ) =>
        ∑ p ∈ primeBand (exp (x.2.1*L)) (exp (x.2.2*L)),
          F (x.1,log (p : ℝ)/L)/(p : ℝ))
      (fun x => ∫ t in x.2.1..x.2.2, F (x.1,t)/t) atTop
      {x | x.1 ∈ Set.Icc c d ∧ a ≤ x.2.1 ∧ x.2.1 ≤ x.2.2 ∧ x.2.2 ≤ b} := by
  apply Metric.tendstoUniformlyOn_iff.mpr
  intro ε hε
  filter_upwards [exponential_prime_weighted_reciprocal_uniform_error ha hab F hF hε]
    with L hL
  rintro ⟨w,u,v⟩ ⟨hw,hau,huv,hvb⟩
  simpa only [Real.dist_eq, abs_sub_comm] using hL w hw u v hau huv hvb

theorem exponential_prime_weighted_reciprocal_moving_error_tendsto
    {a b c d : ℝ} (ha : 0 < a) (hab : a < b) (F : ℝ × ℝ → ℝ)
    (hF : ContinuousOn F ((Set.Icc c d) ×ˢ (Set.Icc a b)))
    (w u v : ℝ → ℝ)
    (hdom : ∀ᶠ L : ℝ in atTop,
      w L ∈ Set.Icc c d ∧ a ≤ u L ∧ u L ≤ v L ∧ v L ≤ b) :
    Tendsto (fun L : ℝ =>
      (∑ p ∈ primeBand (exp (u L*L)) (exp (v L*L)),
        F (w L,log (p : ℝ)/L)/(p : ℝ)) -
      (∫ t in u L..v L, F (w L,t)/t)) atTop (nhds 0) := by
  rw [Metric.tendsto_nhds]
  intro ε hε
  filter_upwards [exponential_prime_weighted_reciprocal_uniform_error ha hab F hF hε,
    hdom] with L hL hd
  simpa only [Real.dist_eq, sub_zero] using hL (w L) hd.1 (u L) (v L) hd.2.1 hd.2.2.1 hd.2.2.2

end Bounty

/- Public declaration closure audit. -/
end

section

/- Positivity, integrability, and compact bounds for Buchstab densities and their recursion kernel. -/

open Filter MeasureTheory
open scoped Topology

namespace Bounty

theorem buchstab_depth_density_ge_prime_term (n : ℕ) {γ w : ℝ}
    (hγ : 0 < γ) (hw : 0 < w) : 1 / w ≤ buchstabDepthDensity n γ w := by
  induction n generalizing γ w with
  | zero => exact le_refl _
  | succ n ih =>
    change 1 / w ≤ 1 / w + ∫ α in γ..max γ (w / 2), buchstabDepthDensity n α (w - α) / α
    apply le_add_of_nonneg_right
    by_cases hhalf : w / 2 ≤ γ
    · simp only [max_eq_left hhalf, intervalIntegral.integral_same, le_refl]
    · have hγhalf : γ ≤ w / 2 := (lt_of_not_ge hhalf).le
      rw [max_eq_right hγhalf]
      apply intervalIntegral.integral_nonneg hγhalf
      intro α hα
      have hα0 : 0 < α := hγ.trans_le hα.1
      have hwα : 0 < w - α := by linarith [hα.2]
      exact div_nonneg ((one_div_pos.mpr hwα).le.trans (ih hα0 hwα)) hα0.le

theorem buchstab_depth_density_pos (n : ℕ) {γ w : ℝ}
    (hγ : 0 < γ) (hw : 0 < w) : 0 < buchstabDepthDensity n γ w :=
  (one_div_pos.mpr hw).trans_le (buchstab_depth_density_ge_prime_term n hγ hw)

theorem buchstab_depth_density_nonneg (n : ℕ) {γ w : ℝ}
    (hγ : 0 < γ) (hw : 0 < w) : 0 ≤ buchstabDepthDensity n γ w :=
  (buchstab_depth_density_pos n hγ hw).le

theorem buchstab_density_ge_prime_term {γ w : ℝ}
    (hγ : 0 < γ) (hw : 0 < w) : 1 / w ≤ buchstabDensity γ w :=
  buchstab_depth_density_ge_prime_term ⌊w / γ⌋₊ hγ hw

theorem buchstab_density_pos {γ w : ℝ}
    (hγ : 0 < γ) (hw : 0 < w) : 0 < buchstabDensity γ w :=
  buchstab_depth_density_pos ⌊w / γ⌋₊ hγ hw

theorem buchstab_density_nonneg {γ w : ℝ}
    (hγ : 0 < γ) (hw : 0 < w) : 0 ≤ buchstabDensity γ w :=
  (buchstab_density_pos hγ hw).le

theorem buchstab_density_kernel_continuous :
    ContinuousOn (fun p : ℝ × ℝ => buchstabDensity p.2 (p.1 - p.2) / p.2)
      {p | 0 < p.2 ∧ p.2 < p.1} := by
  have hc : ContinuousOn (fun p : ℝ × ℝ => (p.2, p.1 - p.2))
      {p | 0 < p.2 ∧ p.2 < p.1} := by fun_prop
  have hnum := buchstab_density_continuous.comp hc (fun p hp => ⟨hp.1, sub_pos.mpr hp.2⟩)
  exact hnum.div (by fun_prop) (fun p hp => hp.1.ne')

theorem buchstab_density_kernel_continuousOn_interval {γ w : ℝ}
    (hγ : 0 < γ) (hγhalf : γ ≤ w / 2) :
    ContinuousOn (fun α : ℝ => buchstabDensity α (w - α) / α) (Set.Icc γ (w / 2)) := by
  have hw : 0 < w := by linarith
  apply buchstab_density_kernel_continuous.comp
    (show ContinuousOn (fun α : ℝ => (w, α)) (Set.Icc γ (w / 2)) by fun_prop)
  intro α hα
  exact ⟨hγ.trans_le hα.1, by linarith [hα.2]⟩

theorem buchstab_density_kernel_intervalIntegrable {γ w : ℝ}
    (hγ : 0 < γ) (hγhalf : γ ≤ w / 2) :
    IntervalIntegrable (fun α : ℝ => buchstabDensity α (w - α) / α) volume γ (w / 2) := by
  apply ContinuousOn.intervalIntegrable
  rw [Set.uIcc_of_le hγhalf]
  exact buchstab_density_kernel_continuousOn_interval hγ hγhalf

theorem buchstab_density_compact_bound {K : Set (ℝ × ℝ)} (hK : IsCompact K)
    (hKpos : ∀ p ∈ K, 0 < p.1 ∧ 0 < p.2) :
    ∃ C : ℝ, 0 < C ∧ ∀ p ∈ K, 0 ≤ buchstabDensity p.1 p.2 ∧ buchstabDensity p.1 p.2 ≤ C := by
  obtain ⟨C, hC⟩ := hK.bddAbove_image (buchstab_density_continuous.mono hKpos)
  refine ⟨|C| + 1, by positivity, ?_⟩
  intro p hp
  refine ⟨buchstab_density_nonneg (hKpos p hp).1 (hKpos p hp).2, ?_⟩
  have hh := hC (Set.mem_image_of_mem (fun p : ℝ × ℝ => buchstabDensity p.1 p.2) hp)
  exact hh.trans ((le_abs_self C).trans (le_add_of_nonneg_right (by norm_num)))

theorem buchstab_density_rectangle_bound {γ₀ γ₁ w₀ w₁ : ℝ}
    (hγ₀ : 0 < γ₀) (hw₀ : 0 < w₀) :
    ∃ C : ℝ, 0 < C ∧ ∀ γ w : ℝ, γ₀ ≤ γ → γ ≤ γ₁ → w₀ ≤ w → w ≤ w₁ →
      0 ≤ buchstabDensity γ w ∧ buchstabDensity γ w ≤ C := by
  obtain ⟨C, hC, hbound⟩ := buchstab_density_compact_bound
    (K := Set.Icc γ₀ γ₁ ×ˢ Set.Icc w₀ w₁) (isCompact_Icc.prod isCompact_Icc)
    (fun p hp => ⟨hγ₀.trans_le hp.1.1, hw₀.trans_le hp.2.1⟩)
  exact ⟨C, hC, fun γ w hγlo hγhi hwlo hwhi => hbound (γ, w) ⟨⟨hγlo, hγhi⟩, ⟨hwlo, hwhi⟩⟩⟩

theorem buchstab_density_kernel_triangle_bound {γ₀ w₀ w₁ : ℝ}
    (hγ₀ : 0 < γ₀) (hw₀ : 0 < w₀) :
    ∃ C : ℝ, 0 < C ∧ ∀ w α : ℝ, w₀ ≤ w → w ≤ w₁ → γ₀ ≤ α → α ≤ w / 2 →
      0 ≤ buchstabDensity α (w - α) / α ∧ buchstabDensity α (w - α) / α ≤ C := by
  obtain ⟨C, hC, hbound⟩ := buchstab_density_rectangle_bound
    (γ₁ := w₁) (w₁ := w₁) hγ₀ (half_pos hw₀)
  refine ⟨C / γ₀, div_pos hC hγ₀, ?_⟩
  intro w α hwlo hwhi hαlo hαhi
  have hα0 : 0 < α := hγ₀.trans_le hαlo
  have hαw₁ : α ≤ w₁ := by linarith
  have hlastlo : w₀ / 2 ≤ w - α := by linarith
  have hlasthi : w - α ≤ w₁ := by linarith
  obtain ⟨hD0, hDC⟩ := hbound α (w - α) hαlo hαw₁ hlastlo hlasthi
  refine ⟨div_nonneg hD0 hα0.le, ?_⟩
  exact (div_le_div_of_nonneg_right hDC hα0.le).trans
    (div_le_div_of_nonneg_left hC.le hγ₀ hαlo)

end Bounty

end

section

/- An output specified by testing against a conditioned function inherits
an energy estimate from the conditioning map and the intermediate vector.
No linearity, symmetry, or positivity of the maps is required. -/

open Finset Classical

namespace Bounty

theorem finite_conditioned_energy_le {X Y : Type*} [Fintype X] [Fintype Y]
    (μ : X → ℝ) (ν : Y → ℝ) (hμ : ∀ x, 0 ≤ μ x) (hν : ∀ y, 0 ≤ ν y)
    (C : (X → ℂ) → Y → ℂ) {A B : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hC : ∀ u, finiteWeightedEnergy ν (C u) ≤ A * finiteWeightedEnergy μ u)
    (f output : X → ℂ) (v : Y → ℂ)
    (hv : finiteWeightedEnergy ν v ≤ B * finiteWeightedEnergy μ f)
    (hpair : ∀ u, (∑ x, (μ x : ℂ) * (starRingEnd ℂ) (u x) * output x) =
      ∑ y, (ν y : ℂ) * (starRingEnd ℂ) (C u y) * v y) :
    finiteWeightedEnergy μ output ≤ A * B * finiteWeightedEnergy μ f := by
  have hf0 : 0 ≤ finiteWeightedEnergy μ f :=
    sum_nonneg fun x _ => mul_nonneg (hμ x) (sq_nonneg _)
  have ho0 : 0 ≤ finiteWeightedEnergy μ output :=
    sum_nonneg fun x _ => mul_nonneg (hμ x) (sq_nonneg _)
  have hn : cleanActiveNorm μ output ≤
      (Real.sqrt A * Real.sqrt B) * Real.sqrt (finiteWeightedEnergy μ f) := by
    apply clean_active_norm_le_of_self_pairing μ hμ output
      (mul_nonneg (mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)) (Real.sqrt_nonneg _))
    rw [hpair output]
    have hc := finite_weighted_bilinear_cauchy ν hν
      (fun y => (starRingEnd ℂ) (C output y)) v
    simp only [finiteWeightedEnergy, Complex.norm_conj] at hc
    have hc' := Real.sqrt_le_sqrt (hC output)
    have hv' := Real.sqrt_le_sqrt hv
    rw [Real.sqrt_mul hA] at hc'
    rw [Real.sqrt_mul hB] at hv'
    calc
      _ ≤ Real.sqrt (finiteWeightedEnergy ν (C output)) * Real.sqrt (finiteWeightedEnergy ν v) := hc
      _ ≤ (Real.sqrt A * Real.sqrt (finiteWeightedEnergy μ output)) *
          (Real.sqrt B * Real.sqrt (finiteWeightedEnergy μ f)) :=
        mul_le_mul hc' hv' (Real.sqrt_nonneg _) (mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _))
      _ = _ := by change _ = (Real.sqrt A * Real.sqrt B) * Real.sqrt (finiteWeightedEnergy μ f) *
          Real.sqrt (finiteWeightedEnergy μ output); ring
  have hs := (sq_le_sq₀ (Real.sqrt_nonneg (finiteWeightedEnergy μ output))
    (mul_nonneg (mul_nonneg (Real.sqrt_nonneg A) (Real.sqrt_nonneg B)) (Real.sqrt_nonneg _))).mpr hn
  rw [mul_pow, mul_pow, Real.sq_sqrt hA, Real.sq_sqrt hB, Real.sq_sqrt hf0,
    Real.sq_sqrt ho0] at hs
  exact hs

end Bounty
end

section

/- The norm conversion for the mixed model. The small measure is counting
on residue-valid injective lists, multiplied by the original constant state
mass. It is not replaced by a product law on repeated small labels. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def physicalSmallBigEnergy {S X : Type*} [Fintype S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (W : X → ℝ) (f : PhysicalSmallBigState P J ell X → ℂ) : ℝ :=
  ∑ x, W x * ∑ r : PhysicalResidues P, ∑ L : PhysicalResidueMarksAt P J ell r,
    physicalStateMass V J ell * ‖f ((r, L.val), x)‖ ^ 2

noncomputable def physicalSmallBigCondition {S X : Type*} [Fintype S] [DecidableEq S]
    {P : S → Finset ℕ} {J ell : ℕ} (V : S → ℝ) (q : ℝ)
    (f : PhysicalSmallBigState P J ell X → ℂ)
    (d : PhysicalSharedLists P J) (x : X) (r : PhysicalResidues P) : ℂ :=
  physicalSmallCondition V q r d (fun L => f ((r, L), x))

noncomputable def physicalSmallBigConditionEnergy {S X : Type*} [Fintype S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J : ℕ}
    (W : X → ℝ) (F : PhysicalSharedLists P J → X → PhysicalResidues P → ℂ) : ℝ :=
  ∑ d, ∑ r, finiteWeightedEnergy W (fun x => F d x r)

theorem physical_small_big_condition_energy_reindex
    {S X : Type*} [Fintype S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J : ℕ}
    (W : X → ℝ) (F : PhysicalSharedLists P J → X → PhysicalResidues P → ℂ) :
    physicalSmallBigConditionEnergy W F =
      ∑ x, W x * ∑ r, ∑ d, ‖F d x r‖ ^ 2 := by
  unfold physicalSmallBigConditionEnergy finiteWeightedEnergy
  simp only [mul_sum]
  rw [sum_comm]
  calc
    (∑ r, ∑ d, ∑ x, W x * ‖F d x r‖ ^ 2) =
        ∑ r, ∑ x, ∑ d, W x * ‖F d x r‖ ^ 2 := by
      apply sum_congr rfl
      intro r _
      exact sum_comm
    _ = _ := sum_comm

theorem exists_physical_small_big_condition_energy_bound
    {q v : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (ell : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (S X : Type) [Fintype S] [DecidableEq S] [Fintype X]
      (P : S → Finset ℕ) [∀ p : PhysicalPrime P, NeZero p.2.val]
      (J : ℕ) (V : S → ℝ), (∀ s, v ≤ V s) →
      ∀ (W : X → ℝ), (∀ x, 0 ≤ W x) →
      ∀ f : PhysicalSmallBigState P J ell X → ℂ,
      physicalSmallBigConditionEnergy W (physicalSmallBigCondition V q f) ≤
        A ^ Fintype.card S * physicalSmallBigEnergy V W f := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_small_conditioning_energy_bound hq0 hq1 hv ell
  refine ⟨A, hA, ?_⟩
  intro S X _ dS _
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  intro P _ J V hV W hW f
  rw [physical_small_big_condition_energy_reindex]
  calc
    _ ≤ ∑ x, W x * ∑ r : PhysicalResidues P,
        A ^ Fintype.card S * ∑ L : PhysicalResidueMarksAt P J ell r,
          physicalStateMass V J ell * ‖f ((r, L.val), x)‖ ^ 2 := by
      apply sum_le_sum
      intro x _
      apply mul_le_mul_of_nonneg_left _ (hW x)
      apply sum_le_sum
      intro r _
      exact hbound S P J V hV r (fun L => f ((r, L), x))
    _ = _ := by
      simp only [← mul_sum, physicalSmallBigEnergy]
      rw [mul_sum]
      apply sum_congr rfl
      intro x _
      ring

noncomputable def physicalSmallBigMeasure {S X : Type*} [Fintype S]
    {P : S → Finset ℕ} {J ell : ℕ}
    (V : S → ℝ) (W : X → ℝ) (s : PhysicalSmallBigState P J ell X) : ℝ :=
  if physicalResidueMarksValid s.1.1 s.1.2 then physicalStateMass V J ell * W s.2 else 0

theorem physical_small_big_measure_nonneg {S X : Type*} [Fintype S]
    {P : S → Finset ℕ} {J ell : ℕ}
    (V : S → ℝ) (hV : ∀ s, 0 < V s) (W : X → ℝ) (hW : ∀ x, 0 ≤ W x)
    (s : PhysicalSmallBigState P J ell X) : 0 ≤ physicalSmallBigMeasure V W s := by
  unfold physicalSmallBigMeasure
  split_ifs
  · exact mul_nonneg (physical_state_mass_pos V hV J ell).le (hW s.2)
  · exact le_rfl

theorem physical_small_big_energy_eq {S X : Type*} [Fintype S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (W : X → ℝ) (f : PhysicalSmallBigState P J ell X → ℂ) :
    finiteWeightedEnergy (physicalSmallBigMeasure V W) f = physicalSmallBigEnergy V W f := by
  unfold finiteWeightedEnergy physicalSmallBigEnergy
  rw [Fintype.sum_prod_type, sum_comm]
  apply sum_congr rfl
  intro x _
  rw [Fintype.sum_prod_type, mul_sum]
  apply sum_congr rfl
  intro r _
  have hs := Finset.sum_subtype (p := physicalResidueMarksValid r) (F := inferInstance) (univ.filter (physicalResidueMarksValid r))
    (by intro L; simp only [mem_filter, mem_univ, true_and])
    (fun L => physicalStateMass V J ell * ‖f ((r, L), x)‖ ^ 2)
  rw [← hs, sum_filter, mul_sum]
  apply sum_congr rfl
  intro L _
  unfold physicalSmallBigMeasure
  split_ifs <;> ring

end Bounty
end

section

/- Positive mixed event weights and arbitrary endpoint-dependent phases.
The extra multiplier may see both small lists and every big event choice;
no spectator factorization of that multiplier is asserted. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def physicalSmallBigPositiveWeight {S X : Type*} [Fintype S]
    {P : S → Finset ℕ} {J ell : ℕ} (V : S → ℝ) (q : ℝ)
    (E : PhysicalSharedLists P J → X → Type*)
    (a : PhysicalResidues P → ∀ d x, E d x → ℝ) (k : X → ℤ)
    (s : PhysicalSmallBigState P J ell X) (e : PhysicalSmallBigEvent E s) : ℝ :=
  if physicalSharedPrefix s.1.2 = physicalSharedPrefix e.1 then
    physicalCompletionMass V (fun _ => (∅ : Finset (Fin J))) ell *
      (physicalResidueVertexWeight s.1.2 (Real.sqrt q) s.1.1 *
        physicalResidueVertexWeight e.1 (Real.sqrt q)
          (physicalTranslateResidues s.1.1
            (k s.2 * (physicalSharedProduct (physicalSharedPrefix s.1.2) : ℕ)))) *
      a s.1.1 (physicalSharedPrefix s.1.2) s.2 e.2
  else 0

noncomputable def physicalSmallBigPhasedAction {S X : Type*} [Fintype S]
    {P : S → Finset ℕ} {J ell : ℕ} (V : S → ℝ) (q : ℝ)
    (E : PhysicalSharedLists P J → X → Type*) [∀ d x, Fintype (E d x)]
    (target : ∀ d x, E d x → X)
    (a : PhysicalResidues P → ∀ d x, E d x → ℝ) (k : X → ℤ)
    (Φ : ∀ s : PhysicalSmallBigState P J ell X, PhysicalSmallBigEvent E s → ℂ)
    (F : PhysicalSmallBigState P J ell X → ℂ) (s : PhysicalSmallBigState P J ell X) : ℂ :=
  ∑ e : PhysicalSmallBigEvent E s,
    (physicalSmallBigPositiveWeight V q E a k s e : ℂ) * Φ s e *
      F (physicalSmallBigTarget E target k s e)

theorem physical_small_big_positive_weight_nonneg {S X : Type*} [Fintype S]
    {P : S → Finset ℕ} {J ell : ℕ} (V : S → ℝ) (hV : ∀ s, 0 < V s) (q : ℝ)
    (E : PhysicalSharedLists P J → X → Type*)
    (a : PhysicalResidues P → ∀ d x, E d x → ℝ)
    (ha : ∀ r d x e, 0 ≤ a r d x e) (k : X → ℤ)
    (s : PhysicalSmallBigState P J ell X) (e : PhysicalSmallBigEvent E s) :
    0 ≤ physicalSmallBigPositiveWeight V q E a k s e := by
  unfold physicalSmallBigPositiveWeight
  split_ifs
  · exact mul_nonneg (mul_nonneg (physical_completion_mass_pos V _ ell hV).le
      (mul_nonneg (physical_residue_vertex_weight_nonneg _ (Real.sqrt_nonneg q) _)
        (physical_residue_vertex_weight_nonneg _ (Real.sqrt_nonneg q) _))) (ha _ _ _ _)
  · exact le_rfl

theorem physical_small_big_event_weight_phase {S X : Type*} [Fintype S]
    {P : S → Finset ℕ} {J ell : ℕ} (V : S → ℝ) (q ζ : ℝ)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (κ : PhysicalSharedLists P J → ℂ)
    (E : PhysicalSharedLists P J → X → Type*)
    (a : PhysicalResidues P → ∀ d x, E d x → ℝ)
    (Ψ : PhysicalResidues P → ∀ d x, E d x → ℂ) (k : X → ℤ)
    (s : PhysicalSmallBigState P J ell X) (e : PhysicalSmallBigEvent E s) :
    physicalSmallBigEventWeight V q ζ aux κ E
      (fun r d x e => (a r d x e : ℂ) * Ψ r d x e) k s e =
    (physicalSmallBigPositiveWeight V q E a k s e : ℂ) *
      (κ (physicalSharedPrefix s.1.2) *
        physicalPhase ζ (physicalSharedProduct (physicalSharedPrefix s.1.2)) *
        Ψ s.1.1 (physicalSharedPrefix s.1.2) s.2 e.2) := by
  unfold physicalSmallBigEventWeight physicalSmallBigPositiveWeight
  rw [physical_bare_empty_prefix]
  split_ifs <;> push_cast <;> ring

theorem physical_small_big_action_eq_phased {S X : Type*} [Fintype S]
    {P : S → Finset ℕ} {J ell : ℕ} (V : S → ℝ) (q ζ : ℝ)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (κ : PhysicalSharedLists P J → ℂ)
    (E : PhysicalSharedLists P J → X → Type*) [∀ d x, Fintype (E d x)]
    (target : ∀ d x, E d x → X)
    (a : PhysicalResidues P → ∀ d x, E d x → ℝ)
    (Ψ : PhysicalResidues P → ∀ d x, E d x → ℂ) (k : X → ℤ)
    (F : PhysicalSmallBigState P J ell X → ℂ) :
    physicalSmallBigAction V q ζ aux κ E target
      (fun r d x e => (a r d x e : ℂ) * Ψ r d x e) k F =
    physicalSmallBigPhasedAction V q E target a k
      (fun s e => κ (physicalSharedPrefix s.1.2) *
        physicalPhase ζ (physicalSharedProduct (physicalSharedPrefix s.1.2)) *
        Ψ s.1.1 (physicalSharedPrefix s.1.2) s.2 e.2) F := by
  funext s
  simp only [physicalSmallBigAction, physicalSmallBigPhasedAction,
    physical_small_big_event_weight_phase]

theorem physical_small_big_phase_norm_le {S X : Type*} [Fintype S]
    {P : S → Finset ℕ} {J ell : ℕ} (V : S → ℝ) (hV : ∀ s, 0 < V s) (q : ℝ)
    (E : PhysicalSharedLists P J → X → Type*) [∀ d x, Fintype (E d x)]
    (target : ∀ d x, E d x → X)
    (a : PhysicalResidues P → ∀ d x, E d x → ℝ)
    (ha : ∀ r d x e, 0 ≤ a r d x e) (k : X → ℤ)
    (Φ : ∀ s : PhysicalSmallBigState P J ell X, PhysicalSmallBigEvent E s → ℂ)
    (H : ℝ) (hΦ : ∀ s e, ‖Φ s e‖ ≤ H)
    (F : PhysicalSmallBigState P J ell X → ℂ) (s : PhysicalSmallBigState P J ell X) :
    ‖physicalSmallBigPhasedAction V q E target a k Φ F s‖ ≤
      H * (∑ e : PhysicalSmallBigEvent E s, physicalSmallBigPositiveWeight V q E a k s e *
        ‖F (physicalSmallBigTarget E target k s e)‖) := by
  unfold physicalSmallBigPhasedAction
  calc
    _ ≤ ∑ e : PhysicalSmallBigEvent E s,
        ‖(physicalSmallBigPositiveWeight V q E a k s e : ℂ) * Φ s e *
          F (physicalSmallBigTarget E target k s e)‖ := norm_sum_le _ _
    _ ≤ ∑ e : PhysicalSmallBigEvent E s, H *
        (physicalSmallBigPositiveWeight V q E a k s e * ‖F (physicalSmallBigTarget E target k s e)‖) := by
      apply sum_le_sum
      intro e _
      rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (physical_small_big_positive_weight_nonneg V hV q E a ha k s e)]
      nlinarith [mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left (hΦ s e)
          (physical_small_big_positive_weight_nonneg V hV q E a ha k s e))
        (norm_nonneg (F (physicalSmallBigTarget E target k s e)))]
    _ = _ := (mul_sum ..).symm

theorem physical_small_big_positive_norm {S X : Type*} [Fintype S]
    {P : S → Finset ℕ} {J ell : ℕ} (V : S → ℝ) (hV : ∀ s, 0 < V s) (q : ℝ)
    (E : PhysicalSharedLists P J → X → Type*) [∀ d x, Fintype (E d x)]
    (target : ∀ d x, E d x → X)
    (a : PhysicalResidues P → ∀ d x, E d x → ℝ)
    (ha : ∀ r d x e, 0 ≤ a r d x e) (k : X → ℤ)
    (F : PhysicalSmallBigState P J ell X → ℂ) (s : PhysicalSmallBigState P J ell X) :
    ‖physicalSmallBigPhasedAction V q E target a k (fun _ _ => 1)
      (fun y => (‖F y‖ : ℂ)) s‖ =
    ∑ e : PhysicalSmallBigEvent E s, physicalSmallBigPositiveWeight V q E a k s e *
      ‖F (physicalSmallBigTarget E target k s e)‖ := by
  simp only [physicalSmallBigPhasedAction, mul_one, ← Complex.ofReal_mul, ← Complex.ofReal_sum,
    Complex.norm_real, Real.norm_eq_abs]
  exact abs_of_nonneg (sum_nonneg fun e _ => mul_nonneg
    (physical_small_big_positive_weight_nonneg V hV q E a ha k s e) (norm_nonneg _))

end Bounty
end

section

/- Positive history-dependent row estimates iterate on the original dependent paths. -/

open Finset Classical

namespace Bounty

universe u v w z

section Rows
variable {K : Type u} {X : Type v} {H : Type z} (E : K → X → Type w)
    [∀ k x, Fintype (E k x)] (target : ∀ k x, E k x → X)
    (weight : ∀ k x, E k x → ℝ)
    (update : ∀ (_t : ℕ) k x, E k x → H → H)
    (gain : ∀ (_t : ℕ) k x, E k x → H → ℝ)

def finiteEventHistoryFactor : ∀ (_t : ℕ) (steps : List K) (x : X),
    FiniteEventPath E target steps x → H → ℝ
  | _, [], _, _, _ => 1
  | t, k :: ks, x, ⟨e, p⟩, h => gain t k x e h *
      finiteEventHistoryFactor (t + 1) ks (target k x e) p (update t k x e h)

omit [∀ k x, Fintype (E k x)] in
theorem finite_event_history_factor_eq_prod (t : ℕ) (steps : List K) (x : X)
    (p : FiniteEventPath E target steps x) (history : H) :
    finiteEventHistoryFactor E target update gain t steps x p history =
      ∏ i : Fin steps.length,
        let e := finiteEventPathOccurrence E target steps x p i
        gain (t + i.val) (steps.get i) e.1 e.2
          (finiteEventPathHistoryAt E target update t steps x p history i.val) := by
  induction steps generalizing t x history with
  | nil => simp only [finiteEventHistoryFactor, List.length_nil, Finset.univ_eq_empty, prod_empty]
  | cons k ks ih =>
    rcases p with ⟨e, p⟩
    erw [Fin.prod_univ_succ]
    change gain t k x e history *
        finiteEventHistoryFactor E target update gain (t + 1) ks (target k x e) p
          (update t k x e history) =
      gain t k x e history * ∏ i : Fin ks.length,
        gain (t + (i.val + 1)) (ks.get i)
          (finiteEventPathOccurrence E target ks (target k x e) p i).1
          (finiteEventPathOccurrence E target ks (target k x e) p i).2
          (finiteEventPathHistoryAt E target update (t + 1) ks (target k x e) p
            (update t k x e history) i.val)
    rw [ih]
    congr 1
    apply prod_congr rfl
    intro i _
    rw [show t + 1 + i.val = t + (i.val + 1) by omega]

def finiteEventIndexedProduct (C : ℕ → K → ℝ) : ℕ → List K → ℝ
  | _, [] => 1
  | t, k :: ks => C t k * finiteEventIndexedProduct C (t + 1) ks

theorem finite_event_indexed_product_eq_prod (C : ℕ → K → ℝ) (t : ℕ) (steps : List K) :
    finiteEventIndexedProduct C t steps =
      ∏ i : Fin steps.length, C (t + i.val) (steps.get i) := by
  induction steps generalizing t with
  | nil => simp only [finiteEventIndexedProduct, List.length_nil, univ_eq_empty, prod_empty]
  | cons k ks ih =>
    erw [Fin.prod_univ_succ]
    change C t k * finiteEventIndexedProduct C (t + 1) ks =
      C t k * ∏ i : Fin ks.length, C (t + (i.val + 1)) (ks.get i)
    rw [ih]
    congr 1
    apply prod_congr rfl
    intro i _
    rw [show t + 1 + i.val = t + (i.val + 1) by omega]

theorem finite_event_indexed_product_nonneg (C : ℕ → K → ℝ)
    (hC : ∀ t k, 0 ≤ C t k) (t : ℕ) (steps : List K) :
    0 ≤ finiteEventIndexedProduct C t steps := by
  induction steps generalizing t with
  | nil => exact zero_le_one
  | cons k ks ih => exact mul_nonneg (hC t k) (ih (t + 1))

theorem finite_event_path_integral_const_mul (steps : List K) (x : X)
    (F : FiniteEventPath E target steps x → ℝ) (c : ℝ) :
    finiteEventPathIntegral E target weight steps x (fun p => c * F p) =
      c * finiteEventPathIntegral E target weight steps x F := by
  unfold finiteEventPathIntegral
  rw [mul_sum]
  apply sum_congr rfl
  intro p _
  ring

theorem finite_event_history_integral_le_rows
    (hw : ∀ k x e, 0 ≤ weight k x e)
    (hgain : ∀ t k x e h, 0 ≤ gain t k x e h)
    (potential : X → ℝ) (C : ℕ → K → ℝ) (hC : ∀ t k, 0 ≤ C t k)
    (hrow : ∀ t k x h, (∑ e : E k x,
      weight k x e * gain t k x e h * potential (target k x e)) ≤ C t k * potential x)
    (t : ℕ) (steps : List K) (x : X) (history : H)
    (F : FiniteEventPath E target steps x → ℝ) {L : ℝ} (hL : 0 ≤ L)
    (hF : ∀ p, F p ≤ L * potential (finiteEventPathTerminal E target steps x p)) :
    finiteEventPathIntegral E target weight steps x
      (fun p => finiteEventHistoryFactor E target update gain t steps x p history * F p) ≤
      finiteEventIndexedProduct C t steps * (L * potential x) := by
  induction steps generalizing t x history with
  | nil =>
    simpa only [finite_event_path_integral_nil, finiteEventHistoryFactor,
      finiteEventIndexedProduct, one_mul, finiteEventPathTerminal] using hF PUnit.unit
  | cons k ks ih =>
    rw [finite_event_path_integral_cons]
    have hp := finite_event_indexed_product_nonneg C hC (t + 1) ks
    calc
      _ = ∑ e : E k x, weight k x e * gain t k x e history *
          finiteEventPathIntegral E target weight ks (target k x e)
            (fun p => finiteEventHistoryFactor E target update gain (t + 1) ks
              (target k x e) p (update t k x e history) * F ⟨e, p⟩) := by
        apply sum_congr rfl
        intro e _
        simp only [finiteEventHistoryFactor, mul_assoc,
          finite_event_path_integral_const_mul]
      _ ≤ ∑ e : E k x, weight k x e * gain t k x e history *
          (finiteEventIndexedProduct C (t + 1) ks * (L * potential (target k x e))) := by
        apply sum_le_sum
        intro e _
        exact mul_le_mul_of_nonneg_left
          (ih (t + 1) (target k x e) (update t k x e history) (fun p => F ⟨e, p⟩)
            (fun p => hF ⟨e, p⟩))
          (mul_nonneg (hw k x e) (hgain t k x e history))
      _ = (finiteEventIndexedProduct C (t + 1) ks * L) *
          ∑ e : E k x, weight k x e * gain t k x e history * potential (target k x e) := by
        rw [mul_sum]
        apply sum_congr rfl
        intro e _
        ring
      _ ≤ (finiteEventIndexedProduct C (t + 1) ks * L) * (C t k * potential x) :=
        mul_le_mul_of_nonneg_left (hrow t k x history) (mul_nonneg hp hL)
      _ = finiteEventIndexedProduct C t (k :: ks) * (L * potential x) := by
        simp only [finiteEventIndexedProduct]
        ring

end Rows
end Bounty
end

section

/- Exact finite partition of weighted pairs by adjacent exponential prime intervals. -/

open Finset Real

namespace Bounty

noncomputable def primeGridPairBin (b q : ℝ) (N : ℕ) (L : ℝ)
    (F : Finset (ℕ × ℕ)) (i : ℕ) : Finset (ℕ × ℕ) := by
  classical
  exact F.filter (fun v => v.1 ∈ primeBand (exp (reciprocalGrid b q N i*L))
    (exp (reciprocalGrid b q N (i+1)*L)))

theorem mem_prime_grid_pair_bin {b q L : ℝ} {N i : ℕ}
    {F : Finset (ℕ × ℕ)} {v : ℕ × ℕ} :
    v ∈ primeGridPairBin b q N L F i ↔ v ∈ F ∧
      v.1 ∈ primeBand (exp (reciprocalGrid b q N i*L))
        (exp (reciprocalGrid b q N (i+1)*L)) := by
  classical
  exact mem_filter

theorem prime_grid_pair_bin_subset (b q : ℝ) (N : ℕ) (L : ℝ)
    (F : Finset (ℕ × ℕ)) (i : ℕ) : primeGridPairBin b q N L F i ⊆ F :=
  filter_subset _ _

theorem prime_grid_pair_bin_log_bounds {b q L : ℝ} (hL : 0 < L)
    {N i : ℕ} {F : Finset (ℕ × ℕ)} {v : ℕ × ℕ}
    (hv : v ∈ primeGridPairBin b q N L F i) :
    reciprocalGrid b q N i < log (v.1 : ℝ)/L ∧
      log (v.1 : ℝ)/L ≤ reciprocalGrid b q N (i+1) :=
  prime_log_coordinate_mem hL (mem_prime_grid_pair_bin.mp hv).2

theorem sum_pairs_eq_sum_prime_grid_bins_range {M : Type*} [AddCommMonoid M]
    {b q L : ℝ} (hbq : b ≤ q) (hL : 0 ≤ L) {N : ℕ} (hN : 0 < N)
    (F : Finset (ℕ × ℕ)) (f : ℕ × ℕ → M)
    (hF : ∀ v ∈ F, v.1 ∈ primeBand (exp (b*L)) (exp (q*L))) :
    (∑ v ∈ F, f v) = ∑ i ∈ range N, ∑ v ∈ primeGridPairBin b q N L F i, f v := by
  classical
  have ht : Monotone (fun i => exp (reciprocalGrid b q N i*L)) := by
    intro i j hij
    exact exp_le_exp.mpr (mul_le_mul_of_nonneg_right (reciprocal_grid_monotone hbq N hij) hL)
  have hadj := sum_prime_bands_adjacent (fun p => ∑ v ∈ F.filter (fun v => v.1 = p), f v)
    (fun i => exp (reciprocalGrid b q N i*L)) ht N
  simp only [reciprocal_grid_zero, reciprocal_grid_end b q hN] at hadj
  calc
    _ = ∑ p ∈ primeBand (exp (b*L)) (exp (q*L)),
        ∑ v ∈ F.filter (fun v => v.1 = p), f v :=
      (sum_fiberwise_of_maps_to hF f).symm
    _ = ∑ i ∈ range N, ∑ p ∈ primeBand (exp (reciprocalGrid b q N i*L))
        (exp (reciprocalGrid b q N (i+1)*L)), ∑ v ∈ F.filter (fun v => v.1 = p), f v := hadj.symm
    _ = _ := by
      apply sum_congr rfl
      intro i hi
      exact sum_fiberwise_eq_sum_filter F _ Prod.fst f

theorem sum_pairs_eq_sum_prime_grid_bins {M : Type*} [AddCommMonoid M]
    {b q L : ℝ} (hbq : b ≤ q) (hL : 0 ≤ L) {N : ℕ} (hN : 0 < N)
    (F : Finset (ℕ × ℕ)) (f : ℕ × ℕ → M)
    (hF : ∀ v ∈ F, v.1 ∈ primeBand (exp (b*L)) (exp (q*L))) :
    (∑ v ∈ F, f v) = ∑ i : Fin N, ∑ v ∈ primeGridPairBin b q N L F i, f v := by
  exact (sum_pairs_eq_sum_prime_grid_bins_range hbq hL hN F f hF).trans
    (Finset.sum_range (fun i : ℕ => ∑ v ∈ primeGridPairBin b q N L F i, f v))

theorem sum_pairs_eq_sum_prime_grid_filters {M : Type*} [AddCommMonoid M]
    {b q L : ℝ} (hbq : b ≤ q) (hL : 0 ≤ L) {N : ℕ} (hN : 0 < N)
    (F : Finset (ℕ × ℕ)) (f : ℕ × ℕ → M)
    (hF : ∀ v ∈ F, v.1 ∈ primeBand (exp (b*L)) (exp (q*L))) :
    (∑ v ∈ F, f v) = ∑ i : Fin N,
      ∑ v ∈ F.filter (fun v => v.1 ∈ primeBand (exp (reciprocalGrid b q N i*L))
        (exp (reciprocalGrid b q N ((i : ℕ)+1)*L))), f v := by
  exact sum_pairs_eq_sum_prime_grid_bins hbq hL hN F f hF

end Bounty
end

section

/- Exact shifted-value Buchstab decomposition into ordered least-prime factor pairs. -/

open Finset
namespace Bounty

noncomputable def shiftedBuchstabPair (u : ℕ) : ℕ × ℕ :=
  ((2*u+1).minFac, (2*u+1)/(2*u+1).minFac)

def shiftedPairIndex (v : ℕ × ℕ) : ℕ := (v.1*v.2-1)/2

noncomputable def shiftedBuchstabPairs (T : Finset ℕ) (z : ℝ) : Finset (ℕ × ℕ) := by
  classical
  exact ((shiftedRoughSet T z).filter (fun u => ¬(2*u+1).Prime)).image shiftedBuchstabPair

theorem shifted_buchstab_pair_product (u : ℕ) :
    (shiftedBuchstabPair u).1*(shiftedBuchstabPair u).2=2*u+1 :=
  Nat.mul_div_cancel' (Nat.minFac_dvd (2*u+1))

theorem shifted_buchstab_pair_index (u : ℕ) : shiftedPairIndex (shiftedBuchstabPair u)=u := by
  unfold shiftedPairIndex
  rw [shifted_buchstab_pair_product]
  omega

theorem shifted_buchstab_pair_injective : Function.Injective shiftedBuchstabPair := by
  intro u v huv
  have := congrArg shiftedPairIndex huv
  simpa only [shifted_buchstab_pair_index] using this

theorem weighted_shifted_buchstab_pair_identity {M : Type*} [AddCommMonoid M]
    (T : Finset ℕ) (z : ℝ) (μ : ℕ → M) :
    (∑ u ∈ shiftedRoughSet T z, μ u) =
      (∑ u ∈ (shiftedRoughSet T z).filter (fun u => (2*u+1).Prime), μ u)+
      ∑ v ∈ shiftedBuchstabPairs T z, μ (shiftedPairIndex v) := by
  classical
  unfold shiftedBuchstabPairs
  rw [sum_image (fun u _ v _ huv => shifted_buchstab_pair_injective huv)]
  simp only [shifted_buchstab_pair_index]
  exact (sum_filter_add_sum_filter_not (shiftedRoughSet T z) (fun u => (2*u+1).Prime) μ).symm

theorem shifted_buchstab_pair_properties (T : Finset ℕ) (z : ℝ)
    (hT : ∀ u ∈ T, 0 < u) {v : ℕ × ℕ} (hv : v ∈ shiftedBuchstabPairs T z) :
    v.1.Prime ∧ v.1 ≤ v.2 ∧ shiftedPairIndex v ∈ T ∧
      v.1*v.2=2*shiftedPairIndex v+1 ∧ z < (v.1 : ℝ) ∧
      ∀ p ∈ v.2.primeFactors, v.1 ≤ p := by
  classical
  obtain ⟨u, hu, rfl⟩ := mem_image.mp hv
  obtain ⟨huR, huNP⟩ := mem_filter.mp hu
  obtain ⟨huT, huRough⟩ := (mem_shifted_rough_set_iff T z u).mp huR
  have hu0 := hT u huT
  have hn0 : 0 < 2*u+1 := by omega
  have hn1 : 2*u+1 ≠ 1 := by omega
  have hp := Nat.minFac_prime hn1
  rw [shifted_buchstab_pair_index]
  refine ⟨hp, Nat.minFac_le_div hn0 huNP, huT, shifted_buchstab_pair_product u, ?_, ?_⟩
  · exact huRough _ (Nat.mem_primeFactors.mpr ⟨hp,Nat.minFac_dvd _,hn0.ne'⟩)
  · exact buchstab_cofactor_prime_factors (2*u+1)

end Bounty
end

section

/- Exact physical lift with the endpoint damping combined with the edge damping. -/

open scoped BigOperators InnerProductSpace

namespace Bounty

theorem physical_damping_square_vertex {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (x : PhysicalState P J ell)
    {q : ℝ} (hq : 0 ≤ q) :
    physicalDamping P J ell q x.1 ^ 2 = physicalVertexWeight x.2.val q x.1 := by
  rw [physicalVertexWeight, if_pos x.2.property, physical_damping_square P J ell hq]

theorem physical_damped_edge_pairing {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    {q : ℝ} (hq : 0 ≤ q) (ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (x y : PhysicalState P J ell) (f g : ℤ → ℂ) :
    (starRingEnd ℂ) (f x.1 * (physicalDamping P J ell q x.1 : ℂ)) *
      physicalEdgeCoeff V C q ζ k K aux x y *
        (g y.1 * (physicalDamping P J ell q y.1 : ℂ)) =
      if y.1 = x.1 + k * (physicalD C x.2.val aux : ℕ) then
        (starRingEnd ℂ) (f x.1) * physicalBarePatternScalar V C ζ K aux x.2.val y.2.val *
          g y.1 * ((physicalVertexWeight x.2.val q x.1 *
            physicalVertexWeight y.2.val q y.1 : ℝ) : ℂ)
      else 0 := by
  classical
  rw [physical_edge_scalar_factor]
  split_ifs
  · rw [map_mul, Complex.conj_ofReal, ← physical_damping_square_vertex x hq,
      ← physical_damping_square_vertex y hq]
    push_cast
    ring
  · simp only [mul_zero, zero_mul]

theorem physical_endpoint_pairing_eq_bare {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (patterns : Finset I) (C : I → G → Finset (Fin J))
    {q : ℝ} (hq : 0 ≤ q) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ) (positions : Finset ℤ) (f g : ℤ → ℂ) :
    inner ℂ (physicalEndpointVector P V J ell q positions f)
      (physicalHilbertOperator V patterns C q ζ k K positions
        (physicalEndpointVector P V J ell q positions g)) =
      (physicalStateMass V J ell : ℂ) *
        ∑ x ∈ physicalCutoff P J ell positions, ∑ y ∈ physicalCutoff P J ell positions,
          ∑ i ∈ patterns, ∑ aux : PhysicalAuxLabels P (C i),
            if y.1 = x.1 + k i * (physicalD (C i) x.2.val aux : ℕ) then
              (starRingEnd ℂ) (f x.1) *
                physicalBarePatternScalar V (C i) (ζ i) (K i) aux x.2.val y.2.val *
                g y.1 * ((physicalVertexWeight x.2.val q x.1 *
                  physicalVertexWeight y.2.val q y.1 : ℝ) : ℂ)
            else 0 := by
  classical
  rw [physicalEndpointVector, physicalEndpointVector, physicalHilbertOperator,
    physical_position_kernel_pairing P V hV J ell positions]
  congr 1
  apply Finset.sum_congr rfl
  intro x _
  apply Finset.sum_congr rfl
  intro y _
  simp only [physicalPatternKernel, Finset.mul_sum, Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro aux _
  exact physical_damped_edge_pairing V (C i) hq (ζ i) (k i) (K i) aux x y f g

end Bounty
end

section

/- A concrete endpoint pairing is controlled by the original alternating root moment. -/

open scoped BigOperators InnerProductSpace

namespace Bounty

theorem physical_endpoint_gram_bound {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (patterns : Finset I) (C : I → G → Finset (Fin J)) (q : ℝ)
    (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ) (starts : Finset ℤ) (R b : ℕ) (hR : 0 < R)
    (f g : ℤ → ℂ)
    (hf : ∀ n ∈ reachablePositions starts (2 * R * b), n ∉ starts → f n = 0) :
    let positions := reachablePositions starts (2 * R * b)
    let A := physicalHilbertOperator V patterns C q ζ k K positions
    let F := physicalEndpointVector P V J ell q positions f
    let H := physicalEndpointVector P V J ell q positions g
    ‖inner ℂ F (A H)‖ ≤
      (∑ n ∈ starts, ‖f n * (physicalDamping P J ell q n : ℂ)‖ ^ 2) ^
        (1 / (2 * (R : ℝ))) *
      (‖H‖ * ‖F‖ ^ (1 - 1 / (R : ℝ)) *
        ((starts.card : ℝ) *
          (physicalRootMoment V patterns C q
            (fun j i => if j % 2 = 0 then -ζ i else ζ i)
            (fun j i => if j % 2 = 0 then -k i else k i)
            (fun j i a c aux => if j % 2 = 0 then (starRingEnd ℂ) (K i c a aux)
              else K i a c aux) starts (2 * R - 1) b).re) ^
          (1 / (2 * (R : ℝ)))) := by
  classical
  dsimp only
  let positions := reachablePositions starts (2 * R * b)
  let A := physicalHilbertOperator V patterns C q ζ k K positions
  let F := physicalEndpointVector P V J ell q positions f
  let H := physicalEndpointVector P V J ell q positions g
  let u : ℤ → EuclideanSpace ℂ (physicalCutoff P J ell positions) := fun n =>
    finiteFiberVector (fun x : physicalCutoff P J ell positions => x.val.1)
      (physicalStateMass V J ell) n
  let c : ℤ → ℂ := fun n => f n * (physicalDamping P J ell q n : ℂ)
  have hF : F = ∑ n : starts, c n.val • u n.val := by
    rw [Finset.sum_coe_sort starts (fun n => c n • u n)]
    exact physical_endpoint_vector_fiber_sum P V J ell q positions starts f hf
  have hcoef : (∑ n : starts, ‖c n.val‖ ^ 2) ≤ ∑ n ∈ starts, ‖c n‖ ^ 2 := by
    rw [Finset.sum_coe_sort starts (fun n => ‖c n‖ ^ 2)]
  have hp := finite_pairing_gram_bound A F H (fun n : starts => c n.val)
    (fun n : starts => u n.val) hF hcoef (by omega : 1 ≤ R)
  rw [Finset.sum_coe_sort starts
    (fun n => (inner ℂ (u n) (((A * A.adjoint) ^ R) (u n))).re)] at hp
  have hr := physical_root_moment_re_eq_fiber_gram V hV patterns C q ζ k K starts R b hR
  dsimp only at hr
  have hsum : (starts.card : ℝ) *
      (physicalRootMoment V patterns C q
        (fun j i => if j % 2 = 0 then -ζ i else ζ i)
        (fun j i => if j % 2 = 0 then -k i else k i)
        (fun j i a c aux => if j % 2 = 0 then (starRingEnd ℂ) (K i c a aux)
          else K i a c aux) starts (2 * R - 1) b).re =
      ∑ n ∈ starts, (inner ℂ (u n) (((A * A.adjoint) ^ R) (u n))).re := by
    by_cases hs : starts.card = 0
    · have he : starts = ∅ := Finset.card_eq_zero.mp hs
      simp only [he, Finset.card_empty, Nat.cast_zero, zero_mul, Finset.sum_empty]
    · have hsr : (starts.card : ℝ) ≠ 0 := by exact_mod_cast hs
      have hh := (eq_div_iff hsr).mp hr
      rw [mul_comm] at hh
      exact hh
  rw [← hsum] at hp
  exact hp

end Bounty
end

section

/- Per-list divisor estimates give endpoint energy without a loss growing with the mark count. -/

open scoped BigOperators

namespace Bounty

theorem physical_endpoint_energy_of_list_bounds {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (J ell : ℕ) {q : ℝ} (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (positions : Finset ℤ) (f : ℤ → ℂ) {A : ℝ} (hA : 0 ≤ A)
    (hlist : ∀ L : PhysicalMarkLists P J ell,
      (∑ n ∈ positions, if ∀ g s, ((L g s).val : ℤ) ∣ n then ‖f n‖ ^ 2 else 0) ≤
        A * ∏ g, ∏ s, 1 / ((L g s).val : ℝ)) :
    ‖physicalEndpointVector P V J ell q positions f‖ ^ 2 ≤ A := by
  classical
  have hm := (physical_state_mass_pos V hV J ell).le
  rw [physicalEndpointVector, finite_position_vector_norm_sq _ hm]
  calc
    _ ≤ physicalStateMass V J ell *
        ∑ x : physicalCutoff P J ell positions, ‖f x.val.1‖ ^ 2 := by
      apply mul_le_mul_of_nonneg_left _ hm
      apply Finset.sum_le_sum
      intro x _
      have hd := physical_damping_unit P J ell hq0 hq1 x.val.1
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hd.1, mul_pow]
      have hsq : physicalDamping P J ell q x.val.1 ^ 2 ≤ 1 := by nlinarith [hd.1, hd.2]
      simpa using mul_le_mul_of_nonneg_left hsq (sq_nonneg ‖f x.val.1‖)
    _ = physicalStateMass V J ell *
        ∑ n ∈ positions, ∑ L : PhysicalMarksAt P J ell n, ‖f n‖ ^ 2 := by
      rw [Finset.sum_coe_sort (physicalCutoff P J ell positions)
        (fun x : PhysicalState P J ell => ‖f x.1‖ ^ 2), physical_cutoff_sum]
    _ = physicalStateMass V J ell * ∑ L : PhysicalMarkLists P J ell,
        ∑ n ∈ positions, if ∀ g s, ((L g s).val : ℤ) ∣ n then ‖f n‖ ^ 2 else 0 := by
      congr 1
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro n _
      have h := physical_marks_sum_all P J ell n
        (fun L => if ∀ g s, ((L g s).val : ℤ) ∣ n then ‖f n‖ ^ 2 else 0)
        (fun L hL => if_neg hL)
      calc
        _ = ∑ L : PhysicalMarksAt P J ell n,
            if ∀ g s, ((L.val g s).val : ℤ) ∣ n then ‖f n‖ ^ 2 else 0 := by
          apply Finset.sum_congr rfl
          intro L _
          exact (if_pos L.property).symm
        _ = _ := h
    _ ≤ physicalStateMass V J ell *
        ∑ L : PhysicalMarkLists P J ell, A * ∏ g, ∏ s, 1 / ((L g s).val : ℝ) := by
      exact mul_le_mul_of_nonneg_left (Finset.sum_le_sum (fun L _ => hlist L)) hm
    _ = A * ∑ L : PhysicalMarkLists P J ell, physicalMarkPriorMass V L := by
      simp only [physical_mark_prior_factor, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro L _
      ring
    _ ≤ A * 1 := mul_le_mul_of_nonneg_left (physical_mark_prior_total_mass V hV hMass) hA
    _ = A := mul_one A

end Bounty
end

section

/- Positive-natural solutions retain signed determinants and exact parity. -/

namespace Bounty

theorem typeII_shifted_equation_coprime {m n e h : ℤ}
    (ha : m * n = 2 * e * h + 1) : IsCoprime m (2 * e) ∧ IsCoprime n (2 * e) := by
  constructor
  · exact ⟨n, -h, by linear_combination ha⟩
  · exact ⟨m, -h, by linear_combination ha⟩

theorem typeII_shifted_equations_odd {m m' n e h h' : ℤ}
    (ha : m * n = 2 * e * h + 1) (hb : m' * n = 2 * e * h' + 1) :
    Odd m ∧ Odd m' ∧ Odd n := by
  have hoa : Odd (m * n) := ⟨e * h, by linear_combination ha⟩
  have hob : Odd (m' * n) := ⟨e * h', by linear_combination hb⟩
  exact ⟨(Int.odd_mul.mp hoa).1, (Int.odd_mul.mp hob).1, (Int.odd_mul.mp hoa).2⟩

theorem typeII_determinant_unique_nat {m m' n e h h' : ℕ}
    (ha : m * n = 2 * e * h + 1) (hb : m' * n = 2 * e * h' + 1)
    (hne : m ≠ m') :
    ∃! k : ℤ, k ≠ 0 ∧ (m' : ℤ) - m = 2 * e * k ∧
      (h' : ℤ) - h = k * n ∧ (m : ℤ) * h' - m' * h = k := by
  apply typeII_determinant_unique
  · exact_mod_cast ha
  · exact_mod_cast hb
  · exact_mod_cast hne

theorem typeII_determinant_reconstruct_nat {m m' e h h' : ℕ} {k : ℤ}
    (hm : 0 < m) (hepos : 0 < e) (hc : Nat.Coprime m k.natAbs)
    (hd : (m : ℤ) * h' - m' * h = k)
    (he : (m' : ℤ) - m = 2 * e * k) :
    ∃! n : ℕ, 0 < n ∧ m * n = 2 * e * h + 1 ∧
      m' * n = 2 * e * h' + 1 ∧ (h' : ℤ) - h = k * n := by
  have hc' : IsCoprime (m : ℤ) k := by
    rw [Int.isCoprime_iff_nat_coprime]
    simpa only [Int.natAbs_natCast] using hc
  obtain ⟨n, hn, huniq⟩ := typeII_determinant_reconstruct_positive
    (show (0 : ℤ) < m by exact_mod_cast hm)
    (show (0 : ℤ) < e by exact_mod_cast hepos)
    (show (0 : ℤ) ≤ h by exact_mod_cast Nat.zero_le h) hc' hd he
  have hncast : (n.toNat : ℤ) = n := Int.toNat_of_nonneg hn.1.le
  refine ⟨n.toNat, ?_, ?_⟩
  · refine ⟨?_, ?_, ?_, ?_⟩
    · exact_mod_cast (show (0 : ℤ) < n.toNat by simpa only [hncast] using hn.1)
    · exact_mod_cast (show (m : ℤ) * n.toNat = 2 * e * h + 1 by
        simpa only [hncast] using hn.2.1)
    · exact_mod_cast (show (m' : ℤ) * n.toNat = 2 * e * h' + 1 by
        simpa only [hncast] using hn.2.2.1)
    · simpa only [hncast] using hn.2.2.2
  · intro n' hn'
    apply Int.natCast_inj.mp
    rw [hncast]
    apply huniq
    refine ⟨?_, ?_, ?_, hn'.2.2.2⟩
    · exact_mod_cast hn'.1
    · exact_mod_cast hn'.2.1
    · exact_mod_cast hn'.2.2.1

end Bounty
end

section

/- The exact solution fiber equivalence, with all arithmetic conditions retained. -/

namespace Bounty

def TypeIIOriginalFiber (m m' h h' : ℤ) :=
  {en : ℤ × ℤ // 0 < en.1 ∧ 0 < en.2 ∧
    m * en.2 = 2 * en.1 * h + 1 ∧ m' * en.2 = 2 * en.1 * h' + 1 ∧
    IsCoprime m (m * h' - m' * h)}

def TypeIIDeterminantFiber (m m' h h' : ℤ) :=
  {k : ℤ // k ≠ 0 ∧ m * h' - m' * h = k ∧ IsCoprime m k ∧
    Int.ModEq (2 * |k|) m m' ∧ 0 < (m' - m) / (2 * k)}

def typeIIDeterminantMap {m m' h h' : ℤ} (hne : m ≠ m')
    (x : TypeIIOriginalFiber m m' h h') : TypeIIDeterminantFiber m m' h h' := by
  refine ⟨m * h' - m' * h, ?_⟩
  obtain ⟨hm, _⟩ := typeII_determinant_identities x.property.2.2.1 x.property.2.2.2.1
  have hk : m * h' - m' * h ≠ 0 := by
    intro hz
    have hz' : m' - m = 0 := by simpa only [hz, mul_zero] using hm
    exact hne (sub_eq_zero.mp hz').symm
  refine ⟨hk, rfl, x.property.2.2.2.2,
    typeII_determinant_congruence hm, ?_⟩
  rw [typeII_determinant_e_quotient hk hm]
  exact x.property.1

theorem typeII_original_fiber_unique {m m' h h' : ℤ} (hm : m ≠ 0) (hne : m ≠ m')
    (x y : TypeIIOriginalFiber m m' h h') : x = y := by
  have hx := typeII_determinant_identities x.property.2.2.1 x.property.2.2.2.1
  have hy := typeII_determinant_identities y.property.2.2.1 y.property.2.2.2.1
  have hk := (typeIIDeterminantMap hne x).property.1
  have he : x.val.1 = y.val.1 :=
    (typeII_determinant_e_quotient hk hx.1).symm.trans
      (typeII_determinant_e_quotient hk hy.1)
  apply Subtype.ext
  apply Prod.ext he
  apply mul_left_cancel₀ hm
  rw [x.property.2.2.1, y.property.2.2.1, he]

noncomputable def typeIIDeterminantEquiv {m m' h h' : ℤ}
    (hm : 0 < m) (hh : 0 ≤ h) (hne : m ≠ m') :
    TypeIIOriginalFiber m m' h h' ≃ TypeIIDeterminantFiber m m' h h' := by
  classical
  apply Equiv.ofBijective (typeIIDeterminantMap hne)
  constructor
  · intro x y _
    exact typeII_original_fiber_unique hm.ne' hne x y
  · intro k
    obtain ⟨en, hen, _⟩ := typeII_determinant_from_congruence hm hh k.property.1
      k.property.2.2.1 k.property.2.1 k.property.2.2.2.1 k.property.2.2.2.2
    have hc : IsCoprime m (m * h' - m' * h) := by
      rw [k.property.2.1]
      exact k.property.2.2.1
    refine ⟨⟨en, hen.1, hen.2.1, hen.2.2.1, hen.2.2.2.1, hc⟩, ?_⟩
    apply Subtype.ext
    exact k.property.2.1

theorem typeII_determinant_equiv_apply {m m' h h' : ℤ}
    (hm : 0 < m) (hh : 0 ≤ h) (hne : m ≠ m')
    (x : TypeIIOriginalFiber m m' h h') :
    (typeIIDeterminantEquiv hm hh hne x).val = m * h' - m' * h := rfl

theorem typeII_determinant_equiv_symm_fst {m m' h h' : ℤ}
    (hm : 0 < m) (hh : 0 ≤ h) (hne : m ≠ m')
    (k : TypeIIDeterminantFiber m m' h h') :
    ((typeIIDeterminantEquiv hm hh hne).symm k).val.1 =
      (m' - m) / (2 * k.val) := by
  let x := (typeIIDeterminantEquiv hm hh hne).symm k
  have hx := typeII_determinant_identities x.property.2.2.1 x.property.2.2.2.1
  have he : m' - m = 2 * x.val.1 * k.val := by
    simpa only [k.property.2.1] using hx.1
  exact (typeII_determinant_e_quotient k.property.1 he).symm

theorem typeII_determinant_equiv_symm_snd {m m' h h' : ℤ}
    (hm : 0 < m) (hh : 0 ≤ h) (hne : m ≠ m')
    (k : TypeIIDeterminantFiber m m' h h') :
    ((typeIIDeterminantEquiv hm hh hne).symm k).val.2 =
      (2 * ((m' - m) / (2 * k.val)) * h + 1) / m := by
  let x := (typeIIDeterminantEquiv hm hh hne).symm k
  have hn := (typeII_determinant_n_quotient hm.ne' x.property.2.2.1).symm
  simpa only [show x.val.1 = (m' - m) / (2 * k.val) from
    typeII_determinant_equiv_symm_fst hm hh hne k] using hn

end Bounty
end

section

/- Absolute fourth divisor moments and their transport along injective indices. -/

open Finset

namespace Bounty

theorem divisor_fourth_moment_Ioc (N : ℕ) :
    (∑ n ∈ Ioc 0 N, (n.divisors.card : ℝ) ^ 4) ≤
      (N : ℝ) * (1 + Real.log N) ^ 15 := by
  calc
    _ ≤ ∑ n ∈ Ioc 0 N, ((ArithmeticFunction.zeta ^ 16) n : ℝ) := by
      apply sum_le_sum
      intro n _
      exact_mod_cast divisor_fourth_power_le_zeta_sixteen n
    _ ≤ (N : ℝ) * divisorHarmonic N ^ 15 := by
      simpa only [Nat.reduceAdd] using divisor_zeta_summatory_bound 15 N
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (pow_le_pow_left₀ (divisor_harmonic_nonneg N) (divisor_harmonic_log_bound N) 15)
      (Nat.cast_nonneg N)

theorem divisor_fourth_moment (N : ℕ) :
    (∑ n ∈ Icc 1 N, (n.divisors.card : ℝ) ^ 4) ≤
      (N : ℝ) * (1 + Real.log N) ^ 15 := by
  have hs : Icc 1 N = Ioc 0 N := by ext n; simp only [mem_Icc, mem_Ioc]; omega
  rw [hs]
  exact divisor_fourth_moment_Ioc N

theorem divisor_fourth_moment_Iic (N : ℕ) :
    (∑ n ∈ Iic N, (n.divisors.card : ℝ) ^ 4) ≤
      (N : ℝ) * (1 + Real.log N) ^ 15 := by
  have hs : Iic N = insert 0 (Ioc 0 N) := by
    ext n
    simp only [mem_Iic, mem_insert, mem_Ioc]
    omega
  rw [hs, sum_insert (by simp)]
  simpa using divisor_fourth_moment_Ioc N

theorem divisor_fourth_moment_injective {α : Type*} [DecidableEq α]
    (S : Finset α) (f : α → ℕ) (N : ℕ) (hf : Set.InjOn f S)
    (hN : ∀ x ∈ S, f x ≤ N) :
    (∑ x ∈ S, ((f x).divisors.card : ℝ) ^ 4) ≤
      (N : ℝ) * (1 + Real.log N) ^ 15 := by
  classical
  have hs : S.image f ⊆ Iic N := by
    intro n hn
    obtain ⟨x, hx, rfl⟩ := mem_image.mp hn
    exact mem_Iic.mpr (hN x hx)
  calc
    _ = ∑ n ∈ S.image f, (n.divisors.card : ℝ) ^ 4 := by
      rw [sum_image]
      intro x hx y hy hxy
      exact hf hx hy hxy
    _ ≤ ∑ n ∈ Iic N, (n.divisors.card : ℝ) ^ 4 :=
      sum_le_sum_of_subset_of_nonneg hs (fun n _ _ => by positivity)
    _ ≤ _ := divisor_fourth_moment_Iic N

theorem divisor_fourth_moment_shift (N t : ℕ) :
    (∑ n ∈ Icc 1 N, ((n + t).divisors.card : ℝ) ^ 4) ≤
      ((N + t : ℕ) : ℝ) * (1 + Real.log (N + t : ℕ)) ^ 15 := by
  apply divisor_fourth_moment_injective (Icc 1 N) (fun n => n + t) (N + t)
  · intro a _ b _ h
    change a + t = b + t at h
    omega
  · intro n hn
    exact Nat.add_le_add_right (mem_Icc.mp hn).2 t

end Bounty
end

section

/- Passing uniform local interval estimates to arbitrary positive intervals. -/

open Finset

namespace Bounty

theorem dyadicNatBucket_Ioc_eq (m n k : ℕ) :
    dyadicNatBucket (Ioc m n) k =
      Ioc (max m (2 ^ k - 1)) (min n (2 ^ (k + 1) - 1)) := by
  ext i
  rw [mem_dyadicNatBucket]
  simp only [mem_Ioc, max_lt_iff, le_min_iff]
  have hpow : 0 < (2 : ℕ) ^ k := by positivity
  constructor
  · rintro ⟨⟨hmi, hin⟩, hik⟩
    have hi : i ≠ 0 := by omega
    obtain ⟨hlo, hhi⟩ := (Nat.log2_eq_iff hi).mp hik
    omega
  · rintro ⟨⟨hmi, hlo⟩, hin, hhi⟩
    refine ⟨⟨hmi, hin⟩, (Nat.log2_eq_iff (by omega : i ≠ 0)).mpr ?_⟩
    omega

theorem norm_Ioc_sum_le_dyadic_card (g : ℕ → ℂ) (m n : ℕ)
    {A U E : ℝ} (hA : 0 < A) (hE : 0 ≤ E)
    (hm : A ≤ ((m + 1 : ℕ) : ℝ)) (hn : (n : ℝ) ≤ U)
    (hlocal : ∀ Y : ℝ, A / 2 ≤ Y → Y ≤ U →
      ∀ lo hi : ℕ, lo ≤ hi → Y ≤ ((lo + 1 : ℕ) : ℝ) →
        (hi : ℝ) ≤ 2 * Y → ‖∑ i ∈ Ioc lo hi, g i‖ ≤ E) :
    ‖∑ i ∈ Ioc m n, g i‖ ≤ ((dyadicNatIndices (Ioc m n)).card : ℝ) * E := by
  have hbucket : ∀ k ∈ dyadicNatIndices (Ioc m n),
      ‖∑ i ∈ dyadicNatBucket (Ioc m n) k, g i‖ ≤ E := by
    intro k hk
    obtain ⟨i, hi, hik⟩ := mem_image.mp hk
    have hmi : m < i := (mem_Ioc.mp hi).1
    have hin : i ≤ n := (mem_Ioc.mp hi).2
    obtain ⟨hlo, hhi⟩ := (Nat.log2_eq_iff (by omega : i ≠ 0)).mp hik
    have hpow : 0 < (2 : ℕ) ^ k := by positivity
    have hpow' : 0 < (2 : ℕ) ^ (k + 1) := by positivity
    have hloR : (2 : ℝ) ^ k ≤ (i : ℝ) := by exact_mod_cast hlo
    have hhiR : (i : ℝ) < (2 : ℝ) ^ (k + 1) := by exact_mod_cast hhi
    have hmiR : ((m + 1 : ℕ) : ℝ) ≤ (i : ℝ) := by exact_mod_cast hmi
    have hinR : (i : ℝ) ≤ (n : ℝ) := by exact_mod_cast hin
    have hYA : A / 2 ≤ (2 : ℝ) ^ k := by
      rw [pow_succ] at hhiR
      linarith
    have hYU : (2 : ℝ) ^ k ≤ U := hloR.trans (hinR.trans hn)
    have hends : max m (2 ^ k - 1) ≤ min n (2 ^ (k + 1) - 1) := by omega
    have hleft : (2 : ℝ) ^ k ≤
        ((max m (2 ^ k - 1) + 1 : ℕ) : ℝ) := by
      exact_mod_cast (show (2 : ℕ) ^ k ≤ max m (2 ^ k - 1) + 1 by omega)
    have hright : ((min n (2 ^ (k + 1) - 1) : ℕ) : ℝ) ≤
        2 * (2 : ℝ) ^ k := by
      have hnat : min n (2 ^ (k + 1) - 1) ≤ (2 : ℕ) ^ (k + 1) := by omega
      have hreal : ((min n (2 ^ (k + 1) - 1) : ℕ) : ℝ) ≤
          (2 : ℝ) ^ (k + 1) := by exact_mod_cast hnat
      simpa only [pow_succ, mul_comm] using hreal
    rw [dyadicNatBucket_Ioc_eq]
    exact hlocal ((2 : ℝ) ^ k) hYA hYU _ _ hends hleft hright
  calc
    ‖∑ i ∈ Ioc m n, g i‖ =
        ‖∑ k ∈ dyadicNatIndices (Ioc m n),
          ∑ i ∈ dyadicNatBucket (Ioc m n) k, g i‖ := by
      rw [sum_dyadicNatBuckets]
    _ ≤ ∑ k ∈ dyadicNatIndices (Ioc m n),
        ‖∑ i ∈ dyadicNatBucket (Ioc m n) k, g i‖ := norm_sum_le _ _
    _ ≤ ∑ _k ∈ dyadicNatIndices (Ioc m n), E := sum_le_sum hbucket
    _ = _ := by simp

theorem dyadicNatIndices_Ioc_card_le_exp_window {L : ℝ} (hL : 0 ≤ L)
    (m n : ℕ) (hn : (n : ℝ) ≤ Real.exp (2 * L)) :
    ((dyadicNatIndices (Ioc m n)).card : ℝ) ≤ 2 * L / Real.log 2 + 2 := by
  have h := dyadic_indices_card_window (Ioc m n) (a := 0) (b := 2 * L)
    (by linarith) (by
      intro i hi
      obtain ⟨hmi, hin⟩ := mem_Ioc.mp hi
      have hi0 : 0 < i := by omega
      refine ⟨hi0, ?_, ?_⟩
      · simpa only [Real.exp_zero] using
          (show (1 : ℝ) ≤ (i : ℝ) by exact_mod_cast hi0)
      · exact (Nat.cast_le.mpr hin).trans hn)
  simpa only [sub_zero] using h


end Bounty
end

section

/- A suffix-sum criterion for the deterministic allocation invariant. -/

open Finset Real

namespace Bounty

noncomputable def smoothAllocationFuture (n : ℕ) (v : Fin n → ℝ)
    (active : Fin n → Bool) (i : Fin n) : ℝ :=
  ∑ j, if i < j ∧ active j = true then v j else 0

theorem smooth_allocation_future_zero (n : ℕ) (v : Fin (n+1) → ℝ)
    (active : Fin (n+1) → Bool) :
    smoothAllocationFuture (n+1) v active 0 =
      smoothAllocationInventory n (Fin.tail v) (Fin.tail active) := by
  rw [Fin.tail_def, Fin.tail_def]
  unfold smoothAllocationFuture smoothAllocationInventory
  rw [Fin.sum_univ_succ]
  simp only [lt_self_iff_false, false_and, if_false, Fin.succ_pos, true_and, zero_add]

theorem smooth_allocation_future_succ (n : ℕ) (v : Fin (n+1) → ℝ)
    (active : Fin (n+1) → Bool) (i : Fin n) :
    smoothAllocationFuture (n+1) v active i.succ =
      smoothAllocationFuture n (Fin.tail v) (Fin.tail active) i := by
  rw [Fin.tail_def, Fin.tail_def]
  unfold smoothAllocationFuture
  rw [Fin.sum_univ_succ]
  simp only [Fin.not_lt_zero, false_and, if_false, Fin.succ_lt_succ_iff, zero_add]

theorem smooth_allocation_room_of_future_bound (n : ℕ) (v s : Fin n → ℝ)
    (active : Fin n → Bool) (A : ℝ)
    (h : ∀ i, active i = true → v i+s i ≤ smoothAllocationFuture n v active i+A) :
    SmoothAllocationRoom n v s active A := by
  induction n with
  | zero => trivial
  | succ n ih =>
    constructor
    · intro ha
      simpa only [smooth_allocation_future_zero] using h 0 ha
    · apply ih (Fin.tail v) (Fin.tail s) (Fin.tail active)
      intro i ha
      have hh := h i.succ ha
      rw [smooth_allocation_future_succ] at hh
      simpa only [Fin.tail_def] using hh

end Bounty
end

section

/- The actual allocation processes lower-indexed bands first. -/

open Finset Real

namespace Bounty

theorem candidate_allocation_band_strict {c L : ℝ} {r : ℕ}
    {i j : Fin ((candidateQIndices c L).card*r)}
    (h : (candidateAllocationOrder c L r i).1.val <
      (candidateAllocationOrder c L r j).1.val) : i < j := by
  have hh : i.divNat < j.divNat := by
    apply ((candidateQIndices c L).orderIsoOfFin rfl).lt_iff_lt.mp
    exact h
  change i.val / r < j.val / r at hh
  change i.val < j.val
  by_contra hn
  exact (not_lt_of_ge (Nat.div_le_div_right (Nat.le_of_not_gt hn))) hh

theorem candidate_last_band_scale_lt {c L : ℝ} (hc : 0 < c) (hL : 0 < L)
    (hlog : 0 < log L) :
    c*L/2^⌊log (c*L/(20*log L))/log 2⌋₊ < 40*log L := by
  let J := ⌊log (c*L/(20*log L))/log 2⌋₊
  have hd : 0 < (20*log L) := by positivity
  have hz : 0 < c*L/(20*log L) := by positivity
  have hl2 : 0 < log (2 : ℝ) := by positivity
  have hf : log (c*L/(20*log L))/log 2 < (J : ℝ)+1 := Nat.lt_floor_add_one _
  have hp : c*L/(20*log L) < (2 : ℝ)^(J+1) := by
    apply (log_lt_log_iff hz (by positivity)).mp
    rw [log_pow]
    norm_cast
    have hh := (div_lt_iff₀ hl2).mp hf
    simpa only [Nat.cast_add, Nat.cast_one] using hh
  have hm := (div_lt_iff₀ hd).mp hp
  rw [pow_succ] at hm
  apply (div_lt_iff₀ (by positivity : (0 : ℝ) < 2^J)).mpr
  nlinarith

end Bounty
end

section

/- The initial allocatable inventory is the full product after removing exactly the group and rough factors. -/

open Finset Real

namespace Bounty

theorem candidate_allocation_active_iff (c L : ℝ) (r jStar : ℕ)
    (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (i : Fin ((candidateQIndices c L).card*r)) :
    candidateAllocationActive c L r jStar i = true ↔
      candidateAllocationOrder c L r i ≠ candidateRoughSlot c L r jStar hr hj := by
  have he : ((candidateAllocationOrder c L r i).1.val = jStar ∧
      (candidateAllocationOrder c L r i).2.val = 0) ↔
      candidateAllocationOrder c L r i = candidateRoughSlot c L r jStar hr hj := by
    constructor
    · intro h
      exact Prod.ext (Subtype.ext h.1) (Fin.ext h.2)
    · intro h
      rw [h]
      exact ⟨rfl,rfl⟩
  simp only [candidateAllocationActive, he, decide_eq_true_eq]

theorem candidate_initially_retained_factor (c L : ℝ) (r jStar P : ℕ)
    (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) :
    candidateRetainedFactor c L r jStar P x (candidateAllocationActive c L r jStar) =
      P*(x (candidateRoughSlot c L r jStar hr hj)).val := by
  classical
  let i := (candidateAllocationOrder c L r).symm (candidateRoughSlot c L r jStar hr hj)
  have he : candidateAllocationOrder c L r i = candidateRoughSlot c L r jStar hr hj :=
    Equiv.apply_symm_apply _ _
  have ha : candidateAllocationActive c L r jStar i = false := by
    simp only [candidateAllocationActive, he, candidateRoughSlot, and_self,
      not_true_eq_false, decide_false]
  unfold candidateRetainedFactor
  congr 1
  rw [prod_eq_single i]
  · rw [ha]
    simp only [Bool.false_eq_true, if_false, candidateAllocationValue]
    exact congrArg (fun slot => (x slot).val) he
  · intro j hj' hji
    have hjact : candidateAllocationActive c L r jStar j = true := by
      apply (candidate_allocation_active_iff c L r jStar hr hj j).mpr
      intro hh
      have heq : j = i := (candidateAllocationOrder c L r).injective (hh.trans he.symm)
      exact hji heq
    rw [hjact]
    rfl
  · intro hn
    exact (hn (mem_univ i)).elim

theorem candidate_allocation_inventory_exp (c L : ℝ) (r jStar : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) :
    exp (smoothAllocationInventory _
      (fun i => log (candidateAllocationValue c L r jStar x i))
      (candidateAllocationActive c L r jStar)) =
      (candidateAllocatedFactor c L r jStar x (candidateAllocationActive c L r jStar) : ℝ) :=
  allocation_natural_product_exp_log _ (candidate_allocation_value_pos c L r jStar x) _

theorem candidate_allocation_inventory_of_product_bounds (c L : ℝ) (r jStar P : ℕ)
    (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) (B H : ℝ)
    (htotal : exp B ≤ (P*orderedSlotProduct (candidateQSlotChoices c L r jStar) x : ℕ))
    (hretained : (P*(x (candidateRoughSlot c L r jStar hr hj)).val : ℕ) ≤ exp H) :
    B-H ≤ smoothAllocationInventory _
      (fun i => log (candidateAllocationValue c L r jStar x i))
      (candidateAllocationActive c L r jStar) := by
  have hfac := candidate_allocation_factorization c L r jStar P x
    (candidateAllocationActive c L r jStar)
  rw [candidate_initially_retained_factor c L r jStar P hr hj x] at hfac
  have hreal := congrArg (fun n : ℕ => (n : ℝ)) hfac
  push_cast at hreal
  rw [← candidate_allocation_inventory_exp] at hreal
  have hh : exp B ≤ exp (smoothAllocationInventory _
      (fun i => log (candidateAllocationValue c L r jStar x i))
      (candidateAllocationActive c L r jStar)+H) := by
    rw [exp_add]
    have ht : exp B ≤ exp (smoothAllocationInventory _
        (fun i => log (candidateAllocationValue c L r jStar x i))
        (candidateAllocationActive c L r jStar)) *
        (P*(x (candidateRoughSlot c L r jStar hr hj)).val : ℕ) := by
      simpa only [Nat.cast_mul, hreal] using htotal
    exact ht.trans (mul_le_mul_of_nonneg_left hretained (exp_pos _).le)
  have he := exp_le_exp.mp hh
  linarith

end Bounty
end

section

/- A finite displacement kernel pairs each source block with only its three neighboring blocks. -/

open scoped BigOperators InnerProductSpace

namespace Bounty

theorem position_block_kernel_localization {X : Type*} [Fintype X]
    (position : X → ℤ) {mass : ℝ} (hmass : 0 ≤ mass)
    (K : X → X → ℂ) {H : ℤ} (hH : 0 < H) (j : ℤ) (f g : ℤ → ℂ)
    (hK : ∀ x y, H < |position x - position y| → K x y = 0) :
    inner ℂ (finitePositionVector position mass (integerBlockMask id H j f))
      (finiteKernelOperator K (finitePositionVector position mass g)) =
    inner ℂ (finitePositionVector position mass (integerBlockMask id H j f))
      (finiteKernelOperator K
        (finitePositionVector position mass (integerBlockNearMask id H j g))) := by
  classical
  rw [finite_position_vector_kernel_pairing position hmass,
    finite_position_vector_kernel_pairing position hmass]
  congr 1
  have h := integerBlock_kernel_localization Finset.univ position hH j K
    (fun x => f (position x)) (fun x => g (position x)) (fun x _ y _ => hK x y)
  simpa only [starRingEnd_apply, Finset.mul_sum, mul_assoc, integerBlockMask, integerBlockNearMask, id_eq] using h

theorem position_block_kernel_pairing {X : Type*} [Fintype X]
    (position : X → ℤ) {mass : ℝ} (hmass : 0 ≤ mass)
    (K : X → X → ℂ) (S : Finset ℤ) {H : ℤ} (hH : 0 < H) (f g : ℤ → ℂ)
    (hf : ∀ x, position x ∉ S → f (position x) = 0)
    (hK : ∀ x y, H < |position x - position y| → K x y = 0) :
    inner ℂ (finitePositionVector position mass f)
      (finiteKernelOperator K (finitePositionVector position mass g)) =
    ∑ j ∈ S.image (fun n => n / H),
      inner ℂ (finitePositionVector position mass (integerBlockMask id H j f))
        (finiteKernelOperator K
          (finitePositionVector position mass (integerBlockNearMask id H j g))) := by
  rw [← position_block_vector_sum position mass S H f hf, sum_inner]
  apply Finset.sum_congr rfl
  intro j _
  exact position_block_kernel_localization position hmass K hH j f g hK

end Bounty
end

section

/- Localized fibers recover a source block and partition its full Gram trace exactly. -/

open scoped BigOperators InnerProductSpace

namespace Bounty

noncomputable def positionBlockFiber {X : Type*} (position : X → ℤ) (mass : ℝ)
    (H j n : ℤ) : EuclideanSpace ℂ X :=
  if n / H = j then finiteFiberVector position mass n else 0

theorem position_block_coefficients_bound (S : Finset ℤ) {H : ℤ} (hH : 0 < H)
    (j : ℤ) (f : ℤ → ℂ) {M : ℝ} (hM : 0 ≤ M) (hf : ∀ n ∈ S, ‖f n‖ ≤ M) :
    (∑ n : S, ‖integerBlockMask id H j f n.val‖ ^ 2) ≤ (H.toNat : ℝ) * M ^ 2 := by
  classical
  rw [Finset.sum_coe_sort S (fun n : ℤ => ‖integerBlockMask id H j f n‖ ^ 2)]
  have h := integerBlock_sq_norm_le_card_mul S hH j f hM hf
  have ht (n : ℤ) : ‖integerBlockMask id H j f n‖ ^ 2 =
      if n / H = j then ‖f n‖ ^ 2 else 0 := by
    by_cases hn : n / H = j <;> simp [integerBlockMask, hn]
  simpa only [ht, Finset.sum_filter] using h

theorem position_block_fiber_sum {X : Type*} [Fintype X]
    (position : X → ℤ) (mass : ℝ) (S : Finset ℤ) (H j : ℤ) (f : ℤ → ℂ)
    (hf : ∀ x, position x ∉ S → f (position x) = 0) :
    finitePositionVector position mass (integerBlockMask id H j f) =
      ∑ n : S, integerBlockMask id H j f n.val • positionBlockFiber position mass H j n.val := by
  classical
  rw [finite_position_vector_fiber_sum position mass (integerBlockMask id H j f) S
    (by intro x hx; simp [integerBlockMask, hf x hx]),
    Finset.sum_coe_sort S (fun n : ℤ => integerBlockMask id H j f n • positionBlockFiber position mass H j n)]
  apply Finset.sum_congr rfl
  intro n _
  by_cases hn : n / H = j <;> simp [positionBlockFiber, integerBlockMask, hn]

theorem position_block_fiber_trace {X : Type*} [Fintype X]
    (position : X → ℤ) (mass : ℝ) (S : Finset ℤ) (H : ℤ)
    (T : EuclideanSpace ℂ X →ₗ[ℂ] EuclideanSpace ℂ X) :
    (∑ j : S.image (fun n => n / H), ∑ n : S,
      (inner ℂ (positionBlockFiber position mass H j.val n.val)
        (T (positionBlockFiber position mass H j.val n.val))).re) =
      ∑ n ∈ S, (inner ℂ (finiteFiberVector position mass n)
        (T (finiteFiberVector position mass n))).re := by
  classical
  have ht (j n : ℤ) : (inner ℂ (positionBlockFiber position mass H j n)
      (T (positionBlockFiber position mass H j n))).re =
      if n / H = j then (inner ℂ (finiteFiberVector position mass n)
        (T (finiteFiberVector position mass n))).re else 0 := by
    by_cases hn : n / H = j <;> simp [positionBlockFiber, hn]
  simp_rw [ht]
  rw [Finset.sum_comm, Finset.sum_coe_sort S (fun n : ℤ =>
    ∑ j : S.image (fun n => n / H), if n / H = j.val then
      (inner ℂ (finiteFiberVector position mass n) (T (finiteFiberVector position mass n))).re else 0)]
  apply Finset.sum_congr rfl
  intro n hn
  rw [Finset.sum_coe_sort (S.image (fun n => n / H)) (fun j : ℤ =>
    if n / H = j then (inner ℂ (finiteFiberVector position mass n)
      (T (finiteFiberVector position mass n))).re else 0), Finset.sum_eq_single (n / H)]
  · simp
  · intro j _ hj
    simp [Ne.symm hj]
  · intro h
    exact (h (Finset.mem_image_of_mem (fun n => n / H) hn)).elim

end Bounty
end

section

/- A single explicit cutoff controls the high-rank tail and loses only a small fraction of edges. -/

open Filter

namespace Bounty

theorem eventually_forest_rank_split_parameters {a c ε C E : ℝ}
    (ha : 0 < a) (hc : 0 < c) (hε : 0 < ε) (hC : 0 ≤ C) (hE : 0 ≤ E) :
    ∀ᶠ L : ℝ in atTop, ∀ N : ℕ, L ^ a ≤ (N : ℝ) →
      ∀ b A z : ℝ, L ^ c ≤ b → A ≤ L ^ (C * ((N : ℝ) + 1)) →
        0 ≤ z → z ≤ Real.exp (-b) →
        let r := Nat.ceil (((2 * C + E + 1) * N * Real.log L) / b)
        A * z ^ r / (1 - z) ≤ L ^ (-(E * N)) ∧ (r : ℝ) / N ≤ ε := by
  have hK : 0 ≤ 2 * C + E + 1 := by positivity
  filter_upwards [eventually_ge_atTop (2 : ℝ),
    (tendsto_rpow_atTop hc).eventually_ge_atTop (Real.log 2),
    eventually_forest_rank_cutoff_small ha hc hε hK] with L hL hb hsmall
  intro N hN b A z hbc hA hz hzb
  have hL0 : 0 < L := lt_of_lt_of_le (by norm_num) hL
  have hNpos : (0 : ℝ) < N := (Real.rpow_pos_of_pos hL0 a).trans_le hN
  have hN1 : 1 ≤ N := by
    have hp : 0 < N := by exact_mod_cast hNpos
    omega
  exact ⟨forest_rank_cutoff_tail N hL hC (hb.trans hbc) hN1 hA hz hzb,
    hsmall N hN b hbc⟩

end Bounty
end

section

/- Exact shared/free dilation factors and removal of supported endpoint factors. -/

open Finset

namespace Bounty

abbrev PhysicalSharedIndex {G : Type*} {J : ℕ} (C : G → Finset (Fin J)) :=
  Σ g, ↥(univ \ C g)

noncomputable def physicalSharedFactor {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) : ℕ :=
  ∏ a : PhysicalSharedIndex C, (L a.1 (Sum.inl a.2.val)).val

noncomputable def physicalFreeFactor {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) : ℕ := ∏ g, ∏ j : C g, (aux g j).val

theorem physical_D_shared_free {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C) :
    physicalD C L aux = physicalSharedFactor C L * physicalFreeFactor C aux := by
  classical
  simp only [physicalD, physicalGroupD, prod_mul_distrib, physicalSharedFactor,
    physicalFreeFactor, Fintype.prod_sigma]
  congr 1
  apply prod_congr rfl
  intro g _
  exact (prod_coe_sort (univ \ C g) (fun j => (L g (Sum.inl j)).val)).symm

theorem physical_shared_factor_pos {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (hprime : ∀ g p, p ∈ P g → p.Prime) :
    0 < physicalSharedFactor C L := by
  classical
  exact prod_pos (fun a _ => (hprime a.1 _ (L a.1 (Sum.inl a.2.val)).property).pos)

theorem physical_shared_factor_dvd {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (n : ℤ)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hmarks : ∀ g s, ((L g s).val : ℤ) ∣ n) :
    (physicalSharedFactor C L : ℤ) ∣ n := by
  classical
  unfold physicalSharedFactor
  rw [Nat.cast_prod]
  apply prod_dvd_of_coprime _ (fun a _ => hmarks a.1 (Sum.inl a.2.val))
  intro a _ b _ hab
  change IsCoprime (((L a.1 (Sum.inl a.2.val)).val : ℕ) : ℤ)
    (((L b.1 (Sum.inl b.2.val)).val : ℕ) : ℤ)
  apply (physical_prime_pool_coprime hdis hprime
    (i := ⟨a.1, L a.1 (Sum.inl a.2.val)⟩)
    (j := ⟨b.1, L b.1 (Sum.inl b.2.val)⟩) ?_).isCoprime
  intro he
  have hg : a.1 = b.1 := congrArg (fun p : PhysicalPrime P => p.1) he
  rcases a with ⟨g, a⟩
  rcases b with ⟨h, b⟩
  dsimp only at hg
  subst h
  have hp := eq_of_heq (Sigma.mk.inj_iff.mp he).2
  have hj : a.val = b.val := Sum.inl.inj ((L g).injective hp)
  exact hab (by congr; exact Subtype.ext hj)

theorem physical_shared_factor_supported {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (hprime : ∀ g p, p ∈ P g → p.Prime) :
    physicalSharedFactor C L ∈ Nat.factoredNumbers (univ.biUnion P) := by
  classical
  have hp : ∀ a : PhysicalSharedIndex C,
      (L a.1 (Sum.inl a.2.val)).val ∈ Nat.factoredNumbers (univ.biUnion P) := by
    intro a
    apply Nat.mem_factoredNumbers_of_primeFactors_subset
      (hprime a.1 _ (L a.1 (Sum.inl a.2.val)).property).ne_zero
    rw [(hprime a.1 _ (L a.1 (Sum.inl a.2.val)).property).primeFactors]
    exact singleton_subset_iff.mpr (mem_biUnion.mpr
      ⟨a.1, mem_univ _, (L a.1 (Sum.inl a.2.val)).property⟩)
  unfold physicalSharedFactor
  induction (univ : Finset (PhysicalSharedIndex C)) using Finset.induction_on with
  | empty =>
      rw [prod_empty]
      exact Nat.mem_factoredNumbers_of_primeFactors_subset (by decide) (by simp)
  | @insert a s ha ih =>
      rw [prod_insert ha]
      exact Nat.mul_mem_factoredNumbers (hp a) ih

theorem invariant_triple_endpoint_int_div {P : Finset ℕ} {a : ℕ}
    (ha : a ∈ Nat.factoredNumbers P) (α β γ : ℕ → ℂ) (n : ℤ)
    (hd : (a : ℤ) ∣ n) :
    invariantTripleEndpoint P α β γ n.natAbs =
      invariantTripleEndpoint P α β γ (n / a).natAbs := by
  have hn : n = (a : ℤ) * (n / a) := (Int.mul_ediv_cancel' hd).symm
  conv_lhs => rw [hn]
  simpa only [Int.natAbs_mul, Int.natAbs_natCast] using
    invariant_triple_endpoint_mul_supported ha α β γ (n / a).natAbs

theorem physical_shared_quotient_step {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C)
    (hprime : ∀ g p, p ∈ P g → p.Prime) (n k : ℤ) :
    (n + k * (physicalD C L aux : ℕ)) / physicalSharedFactor C L =
      n / physicalSharedFactor C L + k * (physicalFreeFactor C aux : ℕ) := by
  have hpos : 0 < (physicalSharedFactor C L : ℤ) := by
    exact_mod_cast physical_shared_factor_pos C L hprime
  rw [physical_D_shared_free, Nat.cast_mul]
  calc
    _ = (n + (k * (physicalFreeFactor C aux : ℕ)) * physicalSharedFactor C L) /
        physicalSharedFactor C L := by ring_nf
    _ = _ := Int.add_mul_ediv_right _ _ (ne_of_gt hpos)

end Bounty
end

section

open MeasureTheory Finset

namespace Bounty

noncomputable def typeIIFourierProductWeight {N : ℕ} (A : ℝ) (branch : Fin N → Bool)
    (ξ : Fin N → ℝ) : ℂ := ∏ i, typeIICutoffFourier A (branch i) (ξ i)

noncomputable def typeIIFourierProductIntegrand {N : ℕ} (A : ℝ) (branch : Fin N → Bool)
    (t ξ : Fin N → ℝ) : ℂ := ∏ i, typeIICutoffFourierIntegrand A (branch i) (t i) (ξ i)

noncomputable def typeIIFourierBoxMeasure (N : ℕ) (R : ℝ) : Measure (Fin N → ℝ) :=
  Measure.pi (fun _ : Fin N => volume.restrict {ξ : ℝ | ‖ξ‖ ≤ R})

theorem typeII_fourier_product_weight_integrable {N : ℕ} (A : ℝ) (branch : Fin N → Bool) :
    Integrable (typeIIFourierProductWeight A branch) :=
  Integrable.fintype_prod (fun i => typeII_cutoff_fourier_integrable A (branch i))

theorem typeII_fourier_product_integrand_integrable {N : ℕ} (A : ℝ)
    (branch : Fin N → Bool) (t : Fin N → ℝ) :
    Integrable (typeIIFourierProductIntegrand A branch t) :=
  Integrable.fintype_prod (fun i => typeII_cutoff_fourier_integrand_integrable A (t i) (branch i))

theorem typeII_fourier_product_integrand_norm {N : ℕ} (A : ℝ)
    (branch : Fin N → Bool) (t ξ : Fin N → ℝ) :
    ‖typeIIFourierProductIntegrand A branch t ξ‖ = ‖typeIIFourierProductWeight A branch ξ‖ := by
  simp only [typeIIFourierProductIntegrand, typeIIFourierProductWeight, norm_prod,
    typeII_cutoff_fourier_integrand_norm]

theorem typeII_fourier_product_inversion {N : ℕ} (A : ℝ)
    (branch : Fin N → Bool) (t : Fin N → ℝ) :
    (∏ i, (typeIISmoothCutoff A (branch i) (t i) : ℂ)) =
      ∫ ξ : Fin N → ℝ, typeIIFourierProductIntegrand A branch t ξ := by
  unfold typeIIFourierProductIntegrand
  rw [integral_fintype_prod_volume_eq_prod]
  apply prod_congr rfl
  intro i hi
  exact typeII_cutoff_fourier_inversion A (t i) (branch i)

theorem typeII_fourier_product_box_integrable {N : ℕ} (A R : ℝ)
    (branch : Fin N → Bool) (t : Fin N → ℝ) :
    Integrable (typeIIFourierProductIntegrand A branch t) (typeIIFourierBoxMeasure N R) :=
  Integrable.fintype_prod (fun i =>
    (typeII_cutoff_fourier_integrand_integrable A (t i) (branch i)).integrableOn)

theorem typeII_fourier_product_box_factorization {N : ℕ} (A R : ℝ)
    (branch : Fin N → Bool) (t : Fin N → ℝ) :
    (∫ ξ : Fin N → ℝ, typeIIFourierProductIntegrand A branch t ξ
      ∂typeIIFourierBoxMeasure N R) =
      ∏ i, ∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ R}, typeIICutoffFourierIntegrand A (branch i) (t i) ξ :=
  integral_fintype_prod_eq_prod _

theorem typeII_fourier_product_l1_factorization {N : ℕ} (A : ℝ) (branch : Fin N → Bool) :
    (∫ ξ : Fin N → ℝ, ‖typeIIFourierProductWeight A branch ξ‖) =
      ∏ i, ∫ ξ : ℝ, ‖typeIICutoffFourier A (branch i) ξ‖ := by
  simp only [typeIIFourierProductWeight, norm_prod]
  exact integral_fintype_prod_volume_eq_prod (fun (i : Fin N) (ξ : ℝ) =>
    ‖typeIICutoffFourier A (branch i) ξ‖)

theorem typeII_fourier_product_l1_le {N : ℕ} (A C : ℝ)
    (hC : ∀ active : Bool, (∫ ξ : ℝ, ‖typeIICutoffFourier A active ξ‖) ≤ C)
    (branch : Fin N → Bool) :
    (∫ ξ : Fin N → ℝ, ‖typeIIFourierProductWeight A branch ξ‖) ≤ C ^ N := by
  rw [typeII_fourier_product_l1_factorization]
  calc
    _ ≤ ∏ _i : Fin N, C := prod_le_prod₀ (fun _ _ => integral_nonneg (fun _ => norm_nonneg _))
      (fun i _ => hC (branch i))
    _ = C ^ N := by simp

theorem typeII_fourier_all_branches_l1_le (N : ℕ) (A C : ℝ)
    (hC : ∀ active : Bool, (∫ ξ : ℝ, ‖typeIICutoffFourier A active ξ‖) ≤ C) :
    (∑ branch : Fin N → Bool, ∫ ξ : Fin N → ℝ,
      ‖typeIIFourierProductWeight A branch ξ‖) ≤ (2 * C) ^ N := by
  calc
    _ ≤ ∑ _branch : Fin N → Bool, C ^ N :=
      sum_le_sum (fun branch _ => typeII_fourier_product_l1_le A C hC branch)
    _ = (2 * C) ^ N := by simp [mul_pow]

end Bounty
end

section

/- Actual large group-prime-part coefficient mass as a supported/free convolution. -/

open Finset Filter Real

namespace Bounty

noncomputable def candidateLargePWindowMass (c L q : ℝ) (r jStar : ℕ) (X : ℝ) : ℝ :=
  ∑ u ∈ (arithmeticProductWindow 1 (exp L)).filter
    (fun u => X < (primePoolPart ((candidatePIndices c L).biUnion (candidatePBand (c*L))) u : ℝ)),
      candidateCoefficient c L q r jStar u

theorem candidate_coefficient_real_test_of_free (c L q : ℝ) (r jStar : ℕ) (F : ℕ → ℝ)
    (hfree : ∀ n, candidateQWeight c L r jStar n ≠ 0 →
      n ≠ 0 ∧ Disjoint n.primeFactors
        ((candidatePIndices c L).biUnion (candidatePBand (c*L)))) :
    (∑ u ∈ arithmeticProductWindow 1 (exp L), candidateCoefficient c L q r jStar u*F u) =
      ∑ p ∈ candidateSmallPSet c L (16*exp L+1), candidatePWeight c L q p *
        ∑ n ∈ arithmeticProductWindow p (exp L), candidateQWeight c L r jStar n*F (p*n) := by
  have h := candidate_coefficient_complex_test_of_free c L q r jStar (fun n => (F n : ℂ)) hfree
  have hh := congrArg Complex.re h
  simpa using hh

theorem candidate_large_P_window_convolution (c L q : ℝ) (r jStar : ℕ) (X : ℝ)
    (hfree : ∀ n, candidateQWeight c L r jStar n ≠ 0 →
      n ≠ 0 ∧ Disjoint n.primeFactors
        ((candidatePIndices c L).biUnion (candidatePBand (c*L)))) :
    candidateLargePWindowMass c L q r jStar X =
      ∑ p ∈ (candidateSmallPSet c L (16*exp L+1)).filter (fun p : ℕ => X < (p : ℝ)),
        candidatePWeight c L q p *
          ∑ n ∈ arithmeticProductWindow p (exp L), candidateQWeight c L r jStar n := by
  classical
  have hh := candidate_coefficient_real_test_of_free c L q r jStar
    (fun u => if X < (primePoolPart ((candidatePIndices c L).biUnion (candidatePBand (c*L))) u : ℝ)
      then 1 else 0) hfree
  unfold candidateLargePWindowMass
  rw [sum_filter]
  simp only [mul_ite, mul_one, mul_zero] at hh
  rw [hh, sum_filter]
  apply sum_congr rfl
  intro p hp
  have hsupport := ((mem_candidateSmallPSet_iff c L _ p).mp hp).2
  have hin : (∑ n ∈ arithmeticProductWindow p (exp L),
      if X < (primePoolPart ((candidatePIndices c L).biUnion (candidatePBand (c*L))) (p*n) : ℝ)
      then candidateQWeight c L r jStar n else 0) =
      ∑ n ∈ arithmeticProductWindow p (exp L),
        if X < (p : ℝ) then candidateQWeight c L r jStar n else 0 := by
    apply sum_congr rfl
    intro n hn
    by_cases hz : candidateQWeight c L r jStar n = 0
    · simp only [hz, ite_self]
    · rw [primePoolPart_mul_of_free hsupport (hfree n hz).1 (hfree n hz).2]
  rw [hin]
  by_cases hX : X < (p : ℝ) <;> simp only [hX, if_true, if_false, sum_const_zero, mul_zero]

theorem candidate_large_P_window_le_tail {c L q : ℝ} (hcL : 0 ≤ c*L) (hq : 0 ≤ q)
    (r jStar : ℕ) (X : ℝ)
    (hfree : ∀ n, candidateQWeight c L r jStar n ≠ 0 →
      n ≠ 0 ∧ Disjoint n.primeFactors
        ((candidatePIndices c L).biUnion (candidatePBand (c*L)))) :
    candidateLargePWindowMass c L q r jStar X ≤
      16*exp L*candidateMarkedSmoothTail c L q 1 X*candidateQHarmonicMass c L r jStar := by
  classical
  rw [candidate_large_P_window_convolution c L q r jStar X hfree]
  let S := (candidateSmallPSet c L (16*exp L+1)).filter (fun p : ℕ => X < (p : ℝ))
  have hQ : 0 ≤ candidateQHarmonicMass c L r jStar :=
    tsum_nonneg (fun n => div_nonneg (candidate_Q_weight_nonneg c L r jStar n) (Nat.cast_nonneg n))
  calc
    _ ≤ ∑ p ∈ S, candidatePWeight c L q p *
        ((16*exp L/(p : ℝ))*candidateQHarmonicMass c L r jStar) := by
      apply sum_le_sum
      intro p hp
      exact mul_le_mul_of_nonneg_left (candidate_Q_window_le_harmonic c L r jStar
        (candidate_small_P_set_nonzero (mem_filter.mp hp).1)) (candidate_P_weight_nonneg c L hq p)
    _ = 16*exp L*(∑ p ∈ S, candidatePWeight c L q p/(p : ℝ))*
        candidateQHarmonicMass c L r jStar := by
      rw [mul_sum, sum_mul]
      apply sum_congr rfl
      intro p hp
      ring
    _ ≤ _ := mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_left (candidate_finite_P_tail_le hcL hq X S
        (fun p hp => ((mem_candidateSmallPSet_iff c L _ p).mp (mem_filter.mp hp).1).2)
        (fun p hp => (mem_filter.mp hp).2.le)) (by positivity)) hQ

end Bounty
end

section

/- Fixed allocation patterns separate the actual labelled Q slots, with the full original normalization. -/

open Finset

namespace Bounty

abbrev CandidateTakenSlot (c L : ℝ) (r : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) :=
  {slot : (candidateQIndices c L) × Fin r // take ((candidateAllocationOrder c L r).symm slot) = true}

abbrev CandidateRemainingSlot (c L : ℝ) (r : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) :=
  {slot : (candidateQIndices c L) × Fin r // ¬take ((candidateAllocationOrder c L r).symm slot) = true}

noncomputable def candidateTakenComplexCoefficient (c L : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (e : ℕ) : ℂ :=
  orderedSlotComplexWeight
    (fun slot : CandidateTakenSlot c L r take => candidateQSlotChoices c L r jStar slot.val)
    (fun slot => twist slot.val) e

noncomputable def candidateRemainingComplexCoefficient (c L : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (h : ℕ) : ℂ :=
  orderedSlotComplexWeight
    (fun slot : CandidateRemainingSlot c L r take => candidateQSlotChoices c L r jStar slot.val)
    (fun slot => twist slot.val) h /
      (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ)

noncomputable def candidateTwistedQWeight (c L : ℝ) (r jStar : ℕ)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (n : ℕ) : ℂ :=
  orderedSlotComplexWeight (candidateQSlotChoices c L r jStar) twist n /
    (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ)

theorem candidate_twisted_Q_convolution (c L : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (n : ℕ) :
    candidateTwistedQWeight c L r jStar twist n =
      ∑ e ∈ orderedSlotProductSupport
        (fun slot : CandidateTakenSlot c L r take => candidateQSlotChoices c L r jStar slot.val),
      ∑ h ∈ orderedSlotProductSupport
        (fun slot : CandidateRemainingSlot c L r take => candidateQSlotChoices c L r jStar slot.val),
        if e*h=n then candidateTakenComplexCoefficient c L r jStar take twist e *
          candidateRemainingComplexCoefficient c L r jStar take twist h else 0 := by
  unfold candidateTwistedQWeight candidateTakenComplexCoefficient candidateRemainingComplexCoefficient
  rw [ordered_slot_complex_convolution _
    (fun slot => take ((candidateAllocationOrder c L r).symm slot) = true)]
  simp only [sum_div, ite_div, zero_div, mul_div_assoc]

theorem candidate_twisted_Q_one (c L : ℝ) (r jStar n : ℕ) :
    candidateTwistedQWeight c L r jStar (fun _ _ => 1) n = (candidateQWeight c L r jStar n : ℂ) := by
  classical
  unfold candidateTwistedQWeight orderedSlotComplexWeight candidateQWeight orderedSlotWeight
  simp only [prod_const_one, Complex.ofReal_sum, Complex.ofReal_div, Complex.ofReal_one,
    Complex.ofReal_zero, apply_ite, sum_div, ite_div, zero_div]
  apply sum_congr
  · ext x
    simp only [mem_univ]
  · intro x _
    rfl

theorem candidate_slot_twisted_split_test (c L : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (F : ℕ → ℂ) :
    (∑ x : ∀ slot, candidateQSlotChoices c L r jStar slot,
      (∏ slot, twist slot (x slot).val) * F (orderedSlotProduct _ x)) /
        (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ) =
      ∑ e ∈ orderedSlotProductSupport
        (fun slot : CandidateTakenSlot c L r take => candidateQSlotChoices c L r jStar slot.val),
      ∑ h ∈ orderedSlotProductSupport
        (fun slot : CandidateRemainingSlot c L r take => candidateQSlotChoices c L r jStar slot.val),
        candidateTakenComplexCoefficient c L r jStar take twist e *
          candidateRemainingComplexCoefficient c L r jStar take twist h * F (e*h) := by
  rw [ordered_slot_twisted_split_test _
    (fun slot => take ((candidateAllocationOrder c L r).symm slot) = true)]
  simp only [sum_div, candidateTakenComplexCoefficient, candidateRemainingComplexCoefficient]
  apply sum_congr rfl
  intro e _
  apply sum_congr rfl
  intro h _
  ring

noncomputable def candidateRemainingRoughSlot (c L : ℝ) (r jStar : ℕ)
    (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm (candidateRoughSlot c L r jStar hr hj)) = false) :
    CandidateRemainingSlot c L r take :=
  ⟨candidateRoughSlot c L r jStar hr hj, by simp only [hkeep, Bool.false_eq_true, not_false_eq_true]⟩

noncomputable def candidateResidualPrimeCoefficient (c L : ℝ) (r jStar : ℕ)
    (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm (candidateRoughSlot c L r jStar hr hj)) = false)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (q : ℕ) : ℂ :=
  orderedSlotComplexWeight
    (fun slot : {slot : CandidateRemainingSlot c L r take //
        slot ≠ candidateRemainingRoughSlot c L r jStar hr hj take hkeep} =>
      candidateQSlotChoices c L r jStar slot.val.val)
    (fun slot => twist slot.val.val) q /
      (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ)

theorem candidate_remaining_rough_convolution (c L : ℝ) (r jStar : ℕ)
    (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm (candidateRoughSlot c L r jStar hr hj)) = false)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (h : ℕ) :
    candidateRemainingComplexCoefficient c L r jStar take twist h =
      ∑ p : candidateRoughBand c L jStar,
      ∑ q ∈ orderedSlotProductSupport
        (fun slot : {slot : CandidateRemainingSlot c L r take //
          slot ≠ candidateRemainingRoughSlot c L r jStar hr hj take hkeep} =>
          candidateQSlotChoices c L r jStar slot.val.val),
        if p.val*q=h then twist (candidateRoughSlot c L r jStar hr hj) p.val *
          candidateResidualPrimeCoefficient c L r jStar hr hj take hkeep twist q else 0 := by
  unfold candidateRemainingComplexCoefficient
  rw [ordered_slot_complex_single_convolution _ _
    (candidateRemainingRoughSlot c L r jStar hr hj take hkeep)]
  have hchoice : candidateQSlotChoices c L r jStar
      (candidateRemainingRoughSlot c L r jStar hr hj take hkeep).val = candidateRoughBand c L jStar := by
    simp only [candidateRemainingRoughSlot, candidateQSlotChoices, candidateRoughSlot,
      and_self, if_true]
  simp only [sum_div, ite_div, zero_div, candidateResidualPrimeCoefficient, mul_div_assoc]
  rw [hchoice]
  rfl

theorem candidate_allocated_factor_eq_taken_product (c L : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) :
    candidateAllocatedFactor c L r jStar x take =
      orderedSlotProduct
        (fun slot : CandidateTakenSlot c L r take => candidateQSlotChoices c L r jStar slot.val)
        (fun slot => x slot.val) := by
  classical
  unfold candidateAllocatedFactor orderedSlotProduct
  calc
    _ = ∏ slot : (candidateQIndices c L) × Fin r,
        if take ((candidateAllocationOrder c L r).symm slot) = true then (x slot).val else 1 := by
      apply Fintype.prod_equiv (candidateAllocationOrder c L r)
      intro i
      simp only [Equiv.symm_apply_apply, candidateAllocationValue]
    _ = ∏ slot ∈ univ.filter
        (fun slot => take ((candidateAllocationOrder c L r).symm slot) = true), (x slot).val := by
      rw [prod_filter]
    _ = _ := prod_subtype _ (by simp) (fun slot => (x slot).val)

theorem candidate_retained_factor_eq_remaining_product (c L : ℝ) (r jStar P : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) :
    candidateRetainedFactor c L r jStar P x take =
      P * orderedSlotProduct
        (fun slot : CandidateRemainingSlot c L r take => candidateQSlotChoices c L r jStar slot.val)
        (fun slot => x slot.val) := by
  classical
  unfold candidateRetainedFactor orderedSlotProduct
  congr 1
  calc
    _ = ∏ slot : (candidateQIndices c L) × Fin r,
        if ¬take ((candidateAllocationOrder c L r).symm slot) = true then (x slot).val else 1 := by
      apply Fintype.prod_equiv (candidateAllocationOrder c L r)
      intro i
      simp only [Equiv.symm_apply_apply, candidateAllocationValue]
      cases take i <;> rfl
    _ = ∏ slot ∈ univ.filter
        (fun slot => ¬take ((candidateAllocationOrder c L r).symm slot) = true), (x slot).val := by
      rw [prod_filter]
    _ = _ := prod_subtype _ (by simp) (fun slot => (x slot).val)

theorem candidate_Q_complex_test_separated (c L : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (S : Finset ℕ) (F : ℕ → ℂ) :
    (∑ n ∈ S, (candidateQWeight c L r jStar n : ℂ)*F n) =
      ∑ e ∈ orderedSlotProductSupport
        (fun slot : CandidateTakenSlot c L r take => candidateQSlotChoices c L r jStar slot.val),
      ∑ h ∈ orderedSlotProductSupport
        (fun slot : CandidateRemainingSlot c L r take => candidateQSlotChoices c L r jStar slot.val),
        if e*h ∈ S then candidateTakenComplexCoefficient c L r jStar take (fun _ _ => 1) e *
          candidateRemainingComplexCoefficient c L r jStar take (fun _ _ => 1) h * F (e*h) else 0 := by
  classical
  have hsep := candidate_slot_twisted_split_test c L r jStar take (fun _ _ => 1)
    (fun n => if n ∈ S then F n else 0)
  simp only [prod_const_one, one_mul, mul_ite, mul_zero] at hsep
  rw [← hsep]
  simp only [candidateQWeight]
  rw [ordered_slot_complex_window_sum]
  simp only [sum_div, ite_div, zero_div]
  apply sum_congr
  · ext x
    simp only [mem_univ]
  · intro x _
    split_ifs <;> ring

theorem eventually_candidate_coefficient_complex_test_separated {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in Filter.atTop, ∀ (q : ℝ) (r jStar : ℕ)
      (take : Fin ((candidateQIndices c L).card*r) → Bool) (F : ℕ → ℂ),
      (∑ u ∈ arithmeticProductWindow 1 (Real.exp L),
        (candidateCoefficient c L q r jStar u : ℂ)*F u) =
      ∑ p ∈ candidateSmallPSet c L (16*Real.exp L+1), (candidatePWeight c L q p : ℂ)*
        ∑ e ∈ orderedSlotProductSupport
          (fun slot : CandidateTakenSlot c L r take => candidateQSlotChoices c L r jStar slot.val),
        ∑ h ∈ orderedSlotProductSupport
          (fun slot : CandidateRemainingSlot c L r take => candidateQSlotChoices c L r jStar slot.val),
          if e*h ∈ arithmeticProductWindow p (Real.exp L) then
            candidateTakenComplexCoefficient c L r jStar take (fun _ _ => 1) e *
            candidateRemainingComplexCoefficient c L r jStar take (fun _ _ => 1) h * F (p*(e*h))
          else 0 := by
  filter_upwards [eventually_candidate_coefficient_complex_test hc] with L hL
  intro q r jStar take F
  rw [hL q r jStar F]
  apply sum_congr rfl
  intro p _
  rw [candidate_Q_complex_test_separated c L r jStar take]


end Bounty
end

section

/- Each Fourier L1 moment is controlled by finitely many spatial Schwartz seminorms. -/

open Finset MeasureTheory
open scoped FourierTransform

namespace Bounty

theorem fourier_moment_le_finite_schwartz_seminorms (M : ℕ) :
    ∃ S : Finset (ℕ × ℕ), ∃ C : ℝ, 0 ≤ C ∧
      ∀ f : SchwartzMap (EuclideanSpace ℝ (Fin 3)) ℂ,
        (∫ ξ : EuclideanSpace ℝ (Fin 3), ‖ξ‖^M*‖𝓕 f ξ‖) ≤
          C*S.sup (schwartzSeminormFamily ℂ (EuclideanSpace ℝ (Fin 3)) ℂ) f := by
  let N := (volume : Measure (EuclideanSpace ℝ (Fin 3))).integrablePower
  let B : ℝ := 2^N*(∫ ξ : EuclideanSpace ℝ (Fin 3), (1+‖ξ‖)^(-(N : ℝ)))
  have hB : 0 ≤ B := by
    apply mul_nonneg (by positivity)
    exact integral_nonneg (fun ξ => Real.rpow_nonneg (by positivity) _)
  let T := FourierTransform.fourierCLM ℂ (SchwartzMap (EuclideanSpace ℝ (Fin 3)) ℂ)
  let q := ((SchwartzMap.seminorm ℂ 0 0)+(SchwartzMap.seminorm ℂ (M+N) 0)).comp T.toLinearMap
  have hc0 : Continuous (SchwartzMap.seminorm ℂ 0 0 :
      SchwartzMap (EuclideanSpace ℝ (Fin 3)) ℂ → ℝ) :=
    (schwartz_withSeminorms ℂ (EuclideanSpace ℝ (Fin 3)) ℂ).continuous_seminorm (0,0)
  have hc1 : Continuous (SchwartzMap.seminorm ℂ (M+N) 0 :
      SchwartzMap (EuclideanSpace ℝ (Fin 3)) ℂ → ℝ) :=
    (schwartz_withSeminorms ℂ (EuclideanSpace ℝ (Fin 3)) ℂ).continuous_seminorm (M+N,0)
  have hq : Continuous q := (hc0.add hc1).comp T.continuous
  obtain ⟨S,K,hK,hbound⟩ := Seminorm.bound_of_continuous
    (schwartz_withSeminorms ℂ (EuclideanSpace ℝ (Fin 3)) ℂ) q hq
  refine ⟨S,B*(K : ℝ),mul_nonneg hB K.coe_nonneg,?_⟩
  intro f
  have hi := (𝓕 f).integral_pow_mul_iteratedFDeriv_le ℂ volume M 0
  simp only [norm_iteratedFDeriv_zero] at hi
  calc
    _ ≤ B*q f := hi
    _ ≤ B*((K : ℝ)*S.sup (schwartzSeminormFamily ℂ (EuclideanSpace ℝ (Fin 3)) ℂ) f) :=
      mul_le_mul_of_nonneg_left (hbound f) hB
    _ = _ := by ring

end Bounty
end

section

open MeasureTheory Finset
open scoped ContDiff FourierTransform

namespace Bounty

noncomputable def typeIIEMajorant (q t : ℝ) : ℝ :=
  Real.smoothTransition (2 * q * t - 1) * Real.smoothTransition (2 - t)

noncomputable def typeIINMajorant (t : ℝ) : ℝ :=
  Real.smoothTransition (2 * t - 1) * Real.smoothTransition (3 - t)

noncomputable def typeIIThreeLocalizer (A : ℝ) (t : EuclideanSpace ℝ (Fin 3)) : ℝ :=
  ∏ i, typeIISmoothRho A (t i)

noncomputable def typeIIPulledE (a : ℝ) (t : EuclideanSpace ℝ (Fin 3)) : ℝ :=
  a * (Real.exp (t 1) - Real.exp (t 0))

noncomputable def typeIIPulledN (b c : ℝ) (t : EuclideanSpace ℝ (Fin 3)) : ℝ :=
  b * (Real.exp (t 2 - t 0) - Real.exp (t 2 - t 1)) + c * Real.exp (-t 0)

noncomputable def typeIIPulledCutoff (A q a b c : ℝ)
    (t : EuclideanSpace ℝ (Fin 3)) : ℝ :=
  typeIIThreeLocalizer A t * typeIIEMajorant q (typeIIPulledE a t) *
    typeIINMajorant (typeIIPulledN b c t)

theorem typeII_transition_product_bounds (u v : ℝ) :
    0 ≤ Real.smoothTransition u * Real.smoothTransition v ∧
      Real.smoothTransition u * Real.smoothTransition v ≤ 1 := by
  constructor
  · exact mul_nonneg (Real.smoothTransition.nonneg _) (Real.smoothTransition.nonneg _)
  · exact (mul_le_mul_of_nonneg_right (Real.smoothTransition.le_one _)
      (Real.smoothTransition.nonneg _)).trans (by simpa using Real.smoothTransition.le_one v)

theorem typeII_e_majorant_bounds (q t : ℝ) :
    0 ≤ typeIIEMajorant q t ∧ typeIIEMajorant q t ≤ 1 :=
  typeII_transition_product_bounds _ _

theorem typeII_n_majorant_bounds (t : ℝ) :
    0 ≤ typeIINMajorant t ∧ typeIINMajorant t ≤ 1 :=
  typeII_transition_product_bounds _ _

theorem typeII_e_majorant_eq_one {q t : ℝ} (hq : 1 ≤ q * t) (ht : t ≤ 1) :
    typeIIEMajorant q t = 1 := by
  unfold typeIIEMajorant
  rw [Real.smoothTransition.one_of_one_le (by linarith),
    Real.smoothTransition.one_of_one_le (by linarith), mul_one]

theorem typeII_n_majorant_eq_one {t : ℝ} (ht : t ∈ Set.Icc 1 2) :
    typeIINMajorant t = 1 := by
  unfold typeIINMajorant
  rw [Real.smoothTransition.one_of_one_le (by linarith [ht.1]),
    Real.smoothTransition.one_of_one_le (by linarith [ht.2]), mul_one]

theorem typeII_e_majorant_eq_zero {q t : ℝ} (ht : 2 * q * t ≤ 1 ∨ 2 ≤ t) :
    typeIIEMajorant q t = 0 := by
  rcases ht with ht | ht
  · simp only [typeIIEMajorant, Real.smoothTransition.zero_of_nonpos (by linarith : 2*q*t-1≤0), zero_mul]
  · simp only [typeIIEMajorant, Real.smoothTransition.zero_of_nonpos (by linarith : 2-t≤0), mul_zero]

theorem typeII_n_majorant_eq_zero {t : ℝ} (ht : 2 * t ≤ 1 ∨ 3 ≤ t) :
    typeIINMajorant t = 0 := by
  rcases ht with ht | ht
  · simp only [typeIINMajorant, Real.smoothTransition.zero_of_nonpos (by linarith : 2*t-1≤0), zero_mul]
  · simp only [typeIINMajorant, Real.smoothTransition.zero_of_nonpos (by linarith : 3-t≤0), mul_zero]

theorem typeII_three_localizer_bounds (A : ℝ) (t : EuclideanSpace ℝ (Fin 3)) :
    0 ≤ typeIIThreeLocalizer A t ∧ typeIIThreeLocalizer A t ≤ 1 := by
  constructor
  · exact prod_nonneg (fun i _ => (typeII_smooth_rho_bounds A (t i)).1)
  · exact prod_le_one₀ (fun i _ => (typeII_smooth_rho_bounds A (t i)).1)
      (fun i _ => (typeII_smooth_rho_bounds A (t i)).2)

theorem typeII_three_localizer_eq_one {A : ℝ} {t : EuclideanSpace ℝ (Fin 3)}
    (ht : ∀ i, t i ∈ Set.Icc (-A) A) : typeIIThreeLocalizer A t = 1 := by
  apply prod_eq_one
  intro i hi
  exact typeII_smooth_rho_eq_one (ht i)

theorem typeII_three_localizer_hasCompactSupport (A : ℝ) :
    HasCompactSupport (typeIIThreeLocalizer A) := by
  let K : Set (Fin 3 → ℝ) := {t | ∀ i, t i ∈ Set.Icc (-A-1) (A+1)}
  have hK : IsCompact K := isCompact_pi_infinite (fun _ => isCompact_Icc)
  apply HasCompactSupport.intro ((PiLp.homeomorph 2 (fun _ : Fin 3 => ℝ)).isCompact_preimage.mpr hK)
  intro t ht
  have hn : ¬ ∀ i, t i ∈ Set.Icc (-A-1) (A+1) := ht
  push Not at hn
  obtain ⟨i, hi⟩ := hn
  exact prod_eq_zero (mem_univ i) (typeII_smooth_rho_eq_zero hi)

theorem typeII_three_localizer_contDiff (A : ℝ) :
    ContDiff ℝ ∞ (typeIIThreeLocalizer A) := by
  apply contDiff_prod
  intro i hi
  exact (typeII_smooth_rho_contDiff A).comp (PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin 3 => ℝ) i).contDiff

theorem typeII_pulled_cutoff_contDiff (A q a b c : ℝ) :
    ContDiff ℝ ∞ (typeIIPulledCutoff A q a b c) := by
  have hp (i : Fin 3) : ContDiff ℝ ∞ (fun t : EuclideanSpace ℝ (Fin 3) => t i) :=
    (PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin 3 => ℝ) i).contDiff
  unfold typeIIPulledCutoff typeIIEMajorant typeIINMajorant typeIIPulledE typeIIPulledN
  apply ContDiff.mul
  · exact (typeII_three_localizer_contDiff A).mul (by fun_prop)
  · fun_prop

theorem typeII_pulled_cutoff_hasCompactSupport (A q a b c : ℝ) :
    HasCompactSupport (typeIIPulledCutoff A q a b c) :=
  (typeII_three_localizer_hasCompactSupport A).mul_right.mul_right

theorem typeII_pulled_cutoff_bounds (A q a b c : ℝ) (t : EuclideanSpace ℝ (Fin 3)) :
    0 ≤ typeIIPulledCutoff A q a b c t ∧ typeIIPulledCutoff A q a b c t ≤ 1 := by
  have h0 := typeII_three_localizer_bounds A t
  have h1 := typeII_e_majorant_bounds q (typeIIPulledE a t)
  have h2 := typeII_n_majorant_bounds (typeIIPulledN b c t)
  constructor
  · exact mul_nonneg (mul_nonneg h0.1 h1.1) h2.1
  · exact (mul_le_mul_of_nonneg_right
      ((mul_le_mul_of_nonneg_right h0.2 h1.1).trans (by simpa using h1.2)) h2.1).trans
      (by simpa using h2.2)

theorem typeII_pulled_cutoff_eq_one {A q a b c : ℝ} {t : EuclideanSpace ℝ (Fin 3)}
    (ht : ∀ i, t i ∈ Set.Icc (-A) A) (he : 1 ≤ q * typeIIPulledE a t)
    (he1 : typeIIPulledE a t ≤ 1) (hn : typeIIPulledN b c t ∈ Set.Icc 1 2) :
    typeIIPulledCutoff A q a b c t = 1 := by
  rw [typeIIPulledCutoff, typeII_three_localizer_eq_one ht, typeII_e_majorant_eq_one he he1,
    typeII_n_majorant_eq_one hn, one_mul, one_mul]

noncomputable def typeIIPulledSchwartz (A q a b c : ℝ) :
    SchwartzMap (EuclideanSpace ℝ (Fin 3)) ℂ :=
  ((typeII_pulled_cutoff_hasCompactSupport A q a b c).comp_left
    (g := fun x : ℝ => (x : ℂ)) (by simp)).toSchwartzMap
    (Complex.ofRealCLM.contDiff.comp (typeII_pulled_cutoff_contDiff A q a b c))

noncomputable def typeIIPulledFourier (A q a b c : ℝ) :
    SchwartzMap (EuclideanSpace ℝ (Fin 3)) ℂ := 𝓕 (typeIIPulledSchwartz A q a b c)

theorem typeII_pulled_fourier_integrable (A q a b c : ℝ) :
    Integrable (typeIIPulledFourier A q a b c) := (typeIIPulledFourier A q a b c).integrable

theorem typeII_pulled_fourier_moment_integrable (A q a b c : ℝ) (M : ℕ) :
    Integrable (fun ξ : EuclideanSpace ℝ (Fin 3) => ‖ξ‖^M * ‖typeIIPulledFourier A q a b c ξ‖) :=
  (typeIIPulledFourier A q a b c).integrable_pow_mul volume M

theorem typeII_pulled_fourier_inversion (A q a b c : ℝ) (t : EuclideanSpace ℝ (Fin 3)) :
    (typeIIPulledCutoff A q a b c t : ℂ) =
      ∫ ξ : EuclideanSpace ℝ (Fin 3),
        Complex.exp (((2 * Real.pi * inner ℝ ξ t : ℝ) : ℂ) * Complex.I) *
          typeIIPulledFourier A q a b c ξ := by
  have hi := congrArg (fun f : SchwartzMap (EuclideanSpace ℝ (Fin 3)) ℂ => f t)
    (FourierPair.fourierInv_fourier_eq (E := SchwartzMap (EuclideanSpace ℝ (Fin 3)) ℂ)
      (F := SchwartzMap (EuclideanSpace ℝ (Fin 3)) ℂ) (typeIIPulledSchwartz A q a b c))
  rw [SchwartzMap.fourierInv_coe, Real.fourierInv_eq'] at hi
  change (∫ ξ : EuclideanSpace ℝ (Fin 3),
    Complex.exp (((2 * Real.pi * inner ℝ ξ t : ℝ) : ℂ) * Complex.I) •
      typeIIPulledFourier A q a b c ξ) = (typeIIPulledCutoff A q a b c t : ℂ) at hi
  simpa only [smul_eq_mul] using hi.symm

end Bounty
end

section

open Filter
open scoped ContDiff Topology

namespace Bounty

theorem smoothTransition_fderiv_hasCompactSupport :
    HasCompactSupport (fderiv ℝ Real.smoothTransition) := by
  apply HasCompactSupport.intro (isCompact_Icc : IsCompact (Set.Icc (0 : ℝ) 1))
  intro x hx
  by_cases hlo : x < 0
  · have heq : Real.smoothTransition =ᶠ[𝓝 x] (fun _ => (0 : ℝ)) := by
      filter_upwards [eventually_lt_nhds hlo] with y hy
      exact Real.smoothTransition.zero_of_nonpos hy.le
    rw [heq.fderiv_eq]
    simp
  · have hhi : 1 < x := lt_of_not_ge (fun h => hx ⟨le_of_not_gt hlo, h⟩)
    have heq : Real.smoothTransition =ᶠ[𝓝 x] (fun _ => (1 : ℝ)) := by
      filter_upwards [eventually_gt_nhds hhi] with y hy
      exact Real.smoothTransition.one_of_one_le hy.le
    rw [heq.fderiv_eq]
    simp

theorem smoothTransition_hasTemperateGrowth :
    Function.HasTemperateGrowth Real.smoothTransition := by
  have hcd : ContDiff ℝ ∞ Real.smoothTransition := Real.smoothTransition.contDiff
  apply Function.HasTemperateGrowth.of_fderiv
    (smoothTransition_fderiv_hasCompactSupport.hasTemperateGrowth ?_)
    (hcd.differentiable (by simp)) (k := 0) (C := 1)
  · intro x
    simpa only [pow_zero, mul_one, Real.norm_eq_abs,
      abs_of_nonneg (Real.smoothTransition.nonneg x)] using Real.smoothTransition.le_one x
  · exact hcd.fderiv_right (by simp)

end Bounty
end

section

/- Exact finite cross-pair coefficient factorization, before removing any support mask. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

noncomputable def typeIISeparatedH (W : ℕ → ℝ) (H : ℕ → ℂ) (ρ : ℝ) (h : ℕ) : ℂ :=
  typeIIPhase ρ h * (W h : ℂ) * H h

noncomputable def typeIIDirectEndpoint (M H : Finset ℕ) (A B : ℕ → ℂ)
    (t : ℝ) (v : ℕ) : ℂ :=
  ∑ m ∈ M, ∑ h ∈ H, if m*h=v then A m * typeIIPhase t m * conj (B h) else 0

noncomputable def typeIICrossPairCoefficient (M H : Finset ℕ) (A : ℕ → ℂ)
    (W : ℕ → ℝ) (B : ℕ → ℂ) (ρ ξ₁ ξ₂ ξ₃ : ℝ) (z w : ℕ) : ℂ :=
  ∑ m ∈ M, ∑ h' ∈ H, ∑ m' ∈ M, ∑ h ∈ H,
    if m'*h=z ∧ m*h'=w then
      A m * conj (A m') * typeIISeparatedH W B ρ h * conj (typeIISeparatedH W B ρ h') *
        typeIIPhase ξ₁ m * typeIIPhase ξ₂ m' * typeIIPhase ξ₃ z else 0

theorem typeII_cross_pair_coefficient_factorization
    (M H : Finset ℕ) (A : ℕ → ℂ) (W : ℕ → ℝ) (B : ℕ → ℂ)
    (ρ ξ₁ ξ₂ ξ₃ : ℝ) (z w : ℕ)
    (hM : ∀ m ∈ M, 0 < m) (hH : ∀ h ∈ H, 0 < h)
    (hW : ∀ m ∈ M, ∀ h ∈ H, W (m*h)=W h) :
    typeIICrossPairCoefficient M H A W B ρ ξ₁ ξ₂ ξ₃ z w =
      typeIIPhase (ρ+ξ₃) z * typeIIPhase (-ρ) w *
        conj (typeIIDirectEndpoint M H A B (ρ-ξ₂) z) *
        typeIIDirectEndpoint M H A B (ξ₁+ρ) w * (W z : ℂ) * (W w : ℂ) := by
  classical
  have hconj (b : Prop) [Decidable b] (x y : ℂ) :
      conj (if b then x else y) = if b then conj x else conj y := by
    split_ifs <;> rfl
  unfold typeIICrossPairCoefficient typeIIDirectEndpoint typeIISeparatedH
  simp only [map_sum, hconj, map_mul, map_zero, Complex.conj_ofReal, starRingEnd_self_apply,
    mul_sum, sum_mul]
  apply sum_congr rfl
  intro m hm
  apply sum_congr rfl
  intro h' hh'
  apply sum_congr rfl
  intro m' hm'
  apply sum_congr rfl
  intro h hh
  by_cases hz : m'*h=z
  · by_cases hw : m*h'=w
    · simp only [hz, hw, and_self, if_true]
      have hWz : W h=W z := by rw [← hz, hW m' hm' h hh]
      have hWw : W h'=W w := by rw [← hw, hW m hm h' hh']
      rw [hWz, hWw]
      have hp := typeIIPhase_endpoint_factorization_of_eq ξ₁ ξ₂ ξ₃ ρ
        (hM m hm) (hM m' hm') (hH h hh) (hH h' hh') hz.symm hw.symm
      linear_combination (A m * conj (A m') * B h * conj (B h') * (W z : ℂ) * (W w : ℂ)) * hp
    · simp only [hz, hw, and_false, if_false, if_true, mul_zero, zero_mul]
  · simp only [hz, false_and, if_false, mul_zero, zero_mul]

theorem prime_pool_part_mul_free_left {P : Finset ℕ} {m h : ℕ}
    (hm : m ≠ 0) (hh : h ≠ 0) (hfree : Disjoint m.primeFactors P) :
    primePoolPart P (m*h) = primePoolPart P h := by
  rw [primePoolPart_mul P hm hh,
    primePoolPart_eq_one_of_disjoint hfree.symm
      (Nat.mem_factoredNumbers_of_primeFactors_subset hm (subset_refl _)), one_mul]

theorem prime_pool_free_part_mul_free_left {P : Finset ℕ} {m h : ℕ}
    (hm : m ≠ 0) (hh : h ≠ 0) (hfree : Disjoint m.primeFactors P) :
    primePoolFreePart P (m*h) = m*primePoolFreePart P h := by
  unfold primePoolFreePart
  rw [prime_pool_part_mul_free_left hm hh hfree, Nat.mul_div_assoc m (primePoolPart_dvd P h)]

theorem prime_factors_disjoint_of_rough {P : Finset ℕ} {m : ℕ} {W : ℝ}
    (hP : ∀ p ∈ P, (p : ℝ) ≤ W)
    (hm : ∀ p ∈ m.primeFactors, W < (p : ℝ)) : Disjoint m.primeFactors P := by
  apply disjoint_left.mpr
  intro p hp hpP
  exact (hm p hp).not_ge (hP p hpP)


end Bounty
end

section

/- Exact finite collars around the two endpoints of the product window. -/

open Finset

namespace Bounty

noncomputable def typeIIBoundaryWindow (x δ : ℝ) : Finset ℕ :=
  Icc ⌈(1 - δ) * x⌉₊ ⌊(1 + δ) * x⌋₊ ∪
    Icc ⌈(16 - δ) * x⌉₊ ⌊(16 + δ) * x⌋₊

theorem mem_typeII_boundary_window_iff {x δ : ℝ} {u : ℕ}
    (hx : 0 ≤ x) (hδ0 : 0 ≤ δ) :
    u ∈ typeIIBoundaryWindow x δ ↔
      ((1 - δ) * x ≤ (u : ℝ) ∧ (u : ℝ) ≤ (1 + δ) * x) ∨
        ((16 - δ) * x ≤ (u : ℝ) ∧ (u : ℝ) ≤ (16 + δ) * x) := by
  have hupper1 : 0 ≤ (1 + δ) * x := mul_nonneg (by linarith) hx
  have hupper16 : 0 ≤ (16 + δ) * x := mul_nonneg (by linarith) hx
  simp only [typeIIBoundaryWindow, mem_union, mem_Icc, Nat.ceil_le,
    Nat.le_floor_iff hupper1, Nat.le_floor_iff hupper16]

private theorem boundary_interval_card_le {a b : ℝ} (ha : 0 ≤ a) (hab : a ≤ b) :
    ((Icc ⌈a⌉₊ ⌊b⌋₊).card : ℝ) ≤ b - a + 1 := by
  apply nat_finset_card_le_real_span _ hab
  intro n hn
  obtain ⟨hlo, hhi⟩ := mem_Icc.mp hn
  exact ⟨(Nat.le_ceil a).trans (Nat.cast_le.mpr hlo),
    (Nat.cast_le.mpr hhi).trans (Nat.floor_le (ha.trans hab))⟩

theorem typeII_boundary_window_card_le {x δ : ℝ}
    (hx : 1 ≤ x) (hδ0 : 0 ≤ δ) (hδhalf : δ ≤ 1 / 2) :
    ((typeIIBoundaryWindow x δ).card : ℝ) ≤ 4 * δ * x + 2 := by
  have hx0 : 0 ≤ x := zero_le_one.trans hx
  have hspan1 : (1 - δ) * x ≤ (1 + δ) * x :=
    mul_le_mul_of_nonneg_right (by linarith) hx0
  have hspan16 : (16 - δ) * x ≤ (16 + δ) * x :=
    mul_le_mul_of_nonneg_right (by linarith) hx0
  have h1 := boundary_interval_card_le
    (mul_nonneg (by linarith : 0 ≤ 1 - δ) hx0) hspan1
  have h16 := boundary_interval_card_le
    (mul_nonneg (by linarith : 0 ≤ 16 - δ) hx0) hspan16
  have hcard := Nat.cast_le (α := ℝ).mpr
    (card_union_le (Icc ⌈(1 - δ) * x⌉₊ ⌊(1 + δ) * x⌋₊)
      (Icc ⌈(16 - δ) * x⌉₊ ⌊(16 + δ) * x⌋₊))
  rw [Nat.cast_add] at hcard
  change ((typeIIBoundaryWindow x δ).card : ℝ) ≤ _ at hcard
  linarith

theorem mem_typeII_boundary_window_bounds {x δ : ℝ} {u : ℕ}
    (hx : 1 ≤ x) (hδ0 : 0 ≤ δ) (hδhalf : δ ≤ 1 / 2)
    (hu : u ∈ typeIIBoundaryWindow x δ) :
    0 < u ∧ (u : ℝ) ≤ 17 * x := by
  have hx0 : 0 ≤ x := zero_le_one.trans hx
  have hxpos : 0 < x := zero_lt_one.trans_le hx
  have hlower1 : 0 < (1 - δ) * x := mul_pos (by linarith) hxpos
  have hlower16 : 0 < (16 - δ) * x := mul_pos (by linarith) hxpos
  have hupper1 : (1 + δ) * x ≤ 17 * x :=
    mul_le_mul_of_nonneg_right (by linarith) hx0
  have hupper16 : (16 + δ) * x ≤ 17 * x :=
    mul_le_mul_of_nonneg_right (by linarith) hx0
  rcases (mem_typeII_boundary_window_iff hx0 hδ0).mp hu with hu1 | hu16
  · exact ⟨Nat.cast_pos.mp (hlower1.trans_le hu1.1), hu1.2.trans hupper1⟩
  · exact ⟨Nat.cast_pos.mp (hlower16.trans_le hu16.1), hu16.2.trans hupper16⟩


end Bounty
end

section

/- The original auxiliary draw and complete full state are preserved by dilation congruence. -/

open Finset
open scoped Classical
namespace Bounty
section Full
variable {G : Type*} {P : G → Type*}
  (n : ∀ g, P g → ℕ) {M : G → ℕ}
  (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : SharedActiveLabels P S → Type*)
  (Δ D D' : ∀ c, A c → G → ℤ)
  (hD : ∀ c a g p, ((n g p : ℤ) ∣ D c a g ↔ (n g p : ℤ) ∣ D' c a g))

noncomputable def fullActiveDilationEventEquiv
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    FullActiveEdgeEvent n S B A Δ D x ≃ FullActiveEdgeEvent n S B A Δ D' x :=
  Equiv.sigmaCongrRight (fun a => unrestrictedJointDilationEventEquiv n
    (Δ (productActiveMemorySplit S B x).1 a)
    (D (productActiveMemorySplit S B x).1 a)
    (D' (productActiveMemorySplit S B x).1 a)
    (hD (productActiveMemorySplit S B x).1 a)
    (fun g => (S g)ᶜ.card) B (productActiveMemorySplit S B x).2)

theorem full_active_dilation_auxiliary
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullActiveEdgeEvent n S B A Δ D x) :
    (fullActiveDilationEventEquiv n S B A Δ D D' hD x e).1 = e.1 := rfl

theorem full_active_dilation_target
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullActiveEdgeEvent n S B A Δ D x) :
    fullActiveEdgeEventTarget n S B A Δ D' x (fullActiveDilationEventEquiv n S B A Δ D D' hD x e) =
      fullActiveEdgeEventTarget n S B A Δ D x e := by
  exact congrArg
    (fun y => (productActiveMemorySplit S B).symm ((productActiveMemorySplit S B x).1, y))
    (unrestricted_joint_dilation_target n
      (Δ (productActiveMemorySplit S B x).1 e.1)
      (D (productActiveMemorySplit S B x).1 e.1)
      (D' (productActiveMemorySplit S B x).1 e.1)
      (hD (productActiveMemorySplit S B x).1 e.1)
      (fun g => (S g)ᶜ.card) B (productActiveMemorySplit S B x).2 e.2)

theorem full_active_dilation_weight [Fintype G]
    (ω : ∀ c, A c → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullActiveEdgeEvent n S B A Δ D x) :
    fullActiveEdgeEventWeight n S B A Δ D' ω μ ρ V x (fullActiveDilationEventEquiv n S B A Δ D D' hD x e) =
      fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V x e := by
  unfold fullActiveEdgeEventWeight
  apply congrArg (ω (productActiveMemorySplit S B x).1 e.1 * ·)
  exact unrestricted_joint_dilation_weight n _ _ _ (hD _ e.1) _ B μ ρ V _ e.2

theorem full_active_dilation_event_sum [Fintype G] [∀ g, Fintype (P g)] [∀ c, Fintype (A c)]
    (ω : ∀ c, A c → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (phase : FullActiveEdgeEvent n S B A Δ D x → ℂ)
    (F : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ) :
    (∑ e : FullActiveEdgeEvent n S B A Δ D x,
      (fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V x e : ℂ) * phase e *
        F (fullActiveEdgeEventTarget n S B A Δ D x e)) =
    ∑ e : FullActiveEdgeEvent n S B A Δ D' x,
      (fullActiveEdgeEventWeight n S B A Δ D' ω μ ρ V x e : ℂ) *
        phase ((fullActiveDilationEventEquiv n S B A Δ D D' hD x).symm e) *
        F (fullActiveEdgeEventTarget n S B A Δ D' x e) := by
  rw [← (fullActiveDilationEventEquiv n S B A Δ D D' hD x).sum_comp]
  apply sum_congr rfl
  intro e _
  rw [full_active_dilation_weight, full_active_dilation_target, Equiv.symm_apply_apply]

end Full
end Bounty
end

section

/- Removing one small-group mark preserves every other group's marked weight. -/

open Finset

namespace Bounty

theorem marked_divisor_weight_remove_prime {G : Type*} [DecidableEq G]
    (groups : Finset G) (P : G → Finset ℕ) (q : ℝ) (V : G → ℝ) (t : G → ℕ)
    (hprime : ∀ g ∈ groups, ∀ p ∈ P g, p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (g : G) (hg : g ∈ groups) (k : ℕ) (ht : t g = k + 1) (n : ℕ)
    (hsq : ∀ p ∈ P g, ¬ p ^ 2 ∣ n) :
    markedDivisorWeight groups P q V t (n : ℤ) =
      (1 / V g) * ∑ p ∈ P g, if p ∣ n then
        markedDivisorWeight groups P q V (Function.update t g k) ((n / p : ℕ) : ℤ) else 0 := by
  classical
  let R := fun m : ℕ => ∏ h ∈ groups.erase g,
    markedDivisorFactor q (V h) (physicalOmega P h (m : ℤ)) (t h)
  have hR (p : ℕ) (hp : p ∈ P g) (hpn : p ∣ n) : R (n / p) = R n := by
    apply prod_congr rfl
    intro h hh
    have hne : h ≠ g := (mem_erase.mp hh).1
    have hpout : p ∉ P h := by
      intro hph
      exact disjoint_left.mp (hdis hne.symm) hp hph
    have he := physical_divisor_pool_div_other_prime P h
      (hprime h (mem_of_mem_erase hh)) (hprime g hg p hp) hpout hpn
    rw [show physicalOmega P h ((n / p : ℕ) : ℤ) = physicalOmega P h (n : ℤ) from
      congrArg Finset.card he]
  have hsplit (m : ℕ) :
      markedDivisorWeight groups P q V (Function.update t g k) (m : ℤ) =
        markedDivisorFactor q (V g) (physicalOmega P g (m : ℤ)) k * R m := by
    unfold markedDivisorWeight
    rw [← mul_prod_erase groups _ hg, Function.update_self]
    congr 1
    apply prod_congr rfl
    intro h hh
    rw [Function.update_of_ne (mem_erase.mp hh).1]
  calc
    _ = markedDivisorFactor q (V g) (physicalOmega P g (n : ℤ)) (k + 1) * R n := by
      unfold markedDivisorWeight
      rw [← mul_prod_erase groups _ hg, ht]
    _ = ((1 / V g) * ∑ p ∈ P g, if p ∣ n then
        markedDivisorFactor q (V g) (physicalOmega P g ((n / p : ℕ) : ℤ)) k else 0) * R n := by
      rw [marked_divisor_factor_remove_prime P g (hprime g hg) q (V g) n k hsq]
    _ = (1 / V g) * ∑ p ∈ P g, if p ∣ n then
        markedDivisorFactor q (V g) (physicalOmega P g ((n / p : ℕ) : ℤ)) k * R (n / p) else 0 := by
      rw [mul_assoc, sum_mul]
      congr 1
      apply sum_congr rfl
      intro p hp
      by_cases hpn : p ∣ n
      · simp only [if_pos hpn, hR p hp hpn]
      · simp only [if_neg hpn, zero_mul]
    _ = _ := by simp_rw [← hsplit]

end Bounty
end

section

/- Embed each original complement-indexed birth into its actual full target slot. -/

open Finset Classical
namespace Bounty
section Embedding
variable {J K : Type*} {N : ℕ} {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)

noncomputable def fullMixedCommonSlotEmbedding : (tag : Option (J ⊕ K)) → (g : Fin N) →
    Fin (fullMixedBirthCapacity S B tag g) ↪ Fin (fullMixedCommonCapacity M B tag g)
  | none, _ => Function.Embedding.refl _
  | some (.inl _), _ => Function.Embedding.refl _
  | some (.inr k), g => ((S k g)ᶜ.equivFin.symm.toEmbedding).trans (Function.Embedding.subtype _)

noncomputable def fullMixedCommonLocalEmbedding (tag : Option (J ⊕ K)) :
    FullMixedLocalBirthAddress S B tag ↪ FullMixedCommonLocalAddress M B tag :=
  Function.Embedding.sigmaMap (Function.Embedding.refl _) (fullMixedCommonSlotEmbedding S B tag)

noncomputable def fullMixedCommonStepEmbedding (steps : List (Option (J ⊕ K))) :
    FullMixedBirthAddress S B steps ↪ FullMixedCommonStepAddress M B steps :=
  Function.Embedding.sigmaMap (Function.Embedding.refl _)
    (fun i => fullMixedCommonLocalEmbedding S B (steps.get i))

theorem full_mixed_common_slot_edge (k : K) (g : Fin N) (i : Fin (S k g)ᶜ.card) :
    fullMixedCommonSlotEmbedding (J := J) S B (some (.inr k)) g i =
      ((S k g)ᶜ.equivFin.symm i).val := rfl

theorem full_mixed_common_local_group (tag : Option (J ⊕ K))
    (a : FullMixedLocalBirthAddress S B tag) :
    (fullMixedCommonLocalEmbedding S B tag a).1 = a.1 := rfl

theorem full_mixed_common_step_owner (steps : List (Option (J ⊕ K)))
    (a : FullMixedBirthAddress S B steps) :
    (fullMixedCommonStepEmbedding S B steps a).1 = a.1 := rfl

theorem full_mixed_common_edge_slot_range (k : K) (g : Fin N) (j : Fin (M g)) :
    (∃ i, fullMixedCommonSlotEmbedding (J := J) S B (some (.inr k)) g i = j) ↔ j ∉ S k g := by
  constructor
  · rintro ⟨i, rfl⟩
    exact mem_compl.mp ((S k g)ᶜ.equivFin.symm i).property
  · intro hj
    refine ⟨(S k g)ᶜ.equivFin ⟨j, mem_compl.mpr hj⟩, ?_⟩
    exact congrArg Subtype.val ((S k g)ᶜ.equivFin.symm_apply_apply _)

end Embedding
end Bounty
end

section

/- Initial common addresses retain group tags and exactly enumerate the original active ledger. -/

open Finset Classical
namespace Bounty
section Initial
variable {N : ℕ} {P Z : Fin N → Type*} {M : Fin N → ℕ} {B : ℕ}
  (x : ProductBoundedOrderedState P Z M B)

def fullMixedCommonInitialPrime (a : FullMixedCommonInitialAddress M) : (g : Fin N) × P g :=
  ⟨a.1, (x a.1).1 a.2⟩

theorem full_mixed_common_initial_injective (hx : FullActiveInjective x) :
    Function.Injective (fullMixedCommonInitialPrime x) :=
  (Function.Embedding.sigmaMap (Function.Embedding.refl (Fin N))
    (fun g => ⟨(x g).1, hx g⟩)).injective

variable [∀ g, DecidableEq (P g)]

theorem full_mixed_common_initial_range (z : (g : Fin N) × P g) :
    z.2 ∈ fullActiveInitialLedger x z.1 ↔ ∃ a, fullMixedCommonInitialPrime x a = z := by
  constructor
  · intro hz
    obtain ⟨i, _, hi⟩ := mem_image.mp hz
    refine ⟨⟨z.1, i⟩, ?_⟩
    exact congrArg (Sigma.mk z.1) hi
  · rintro ⟨a, rfl⟩
    exact mem_image.mpr ⟨a.2, mem_univ _, rfl⟩

theorem full_mixed_common_initial_avoids_iff {A : Type*}
    (birth : A → Option ((g : Fin N) × P g)) :
    (∀ i a, birth a ≠ some (fullMixedCommonInitialPrime x i)) ↔
      (∀ a z, birth a = some z → z.2 ∉ fullActiveInitialLedger x z.1) := by
  constructor
  · intro h a z hz hmem
    obtain ⟨i, hi⟩ := (full_mixed_common_initial_range x z).mp hmem
    exact h i a (hz.trans (congrArg some hi.symm))
  · intro h i a ha
    exact h a (fullMixedCommonInitialPrime x i) ha
      ((full_mixed_common_initial_range x _).mpr ⟨i, rfl⟩)

end Initial
end Bounty
end

section

/- One chronological enumeration, independent of the shared-slot pattern, places all initial slots before all event slots. -/

namespace Bounty
variable {J K : Type*} {N : ℕ} (M : Fin N → ℕ) (B : ℕ)
  (steps : List (Option (J ⊕ K)))

abbrev FullMixedCommonLexAddress :=
  Lex ((Lex ((g : Fin N) × Fin (M g))) ⊕
    (Lex ((i : Fin steps.length) ×
      Lex ((g : Fin N) × Fin (fullMixedCommonCapacity M B (steps.get i) g)))))

def fullMixedCommonLexEquiv : FullMixedCommonLexAddress M B steps ≃
    FullMixedCommonBirthAddress M B steps where
  toFun a := match ofLex a with
    | .inl b => .inl (ofLex b)
    | .inr b => .inr ⟨(ofLex b).1, ofLex (ofLex b).2⟩
  invFun a := toLex (match a with
    | .inl b => .inl (toLex b)
    | .inr b => .inr (toLex ⟨b.1, toLex b.2⟩))
  left_inv a := by cases a <;> rfl
  right_inv a := by cases a <;> rfl

noncomputable def fullMixedCommonBirthOrder :
    Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) ≃
      FullMixedCommonBirthAddress M B steps :=
  (Fintype.orderIsoFinOfCardEq (FullMixedCommonLexAddress M B steps)
    (Fintype.card_congr (fullMixedCommonLexEquiv M B steps))).toEquiv.trans
      (fullMixedCommonLexEquiv M B steps)

def fullMixedCommonBirthStage : FullMixedCommonBirthAddress M B steps → ℕ
  | .inl _ => 0
  | .inr a => a.1.val + 1

theorem full_mixed_common_lex_stage_monotone :
    Monotone (fun a => fullMixedCommonBirthStage M B steps
      (fullMixedCommonLexEquiv M B steps a)) := by
  intro a b h
  cases h with
  | inl h => exact le_rfl
  | sep a b => exact Nat.zero_le _
  | inr h =>
    rcases Sigma.Lex.le_def.mp h with hlt | ⟨heq, _⟩
    · exact Nat.add_le_add_right (Fin.le_iff_val_le_val.mp hlt.le) 1
    · exact Nat.add_le_add_right (Fin.le_iff_val_le_val.mp heq.le) 1

theorem full_mixed_common_order_stage_monotone :
    Monotone (fun i => fullMixedCommonBirthStage M B steps
      (fullMixedCommonBirthOrder M B steps i)) :=
  (full_mixed_common_lex_stage_monotone M B steps).comp
    (Fintype.orderIsoFinOfCardEq (FullMixedCommonLexAddress M B steps)
      (Fintype.card_congr (fullMixedCommonLexEquiv M B steps))).monotone

theorem full_mixed_common_order_exact_address (a : FullMixedCommonBirthAddress M B steps) :
    fullMixedCommonBirthOrder M B steps ((fullMixedCommonBirthOrder M B steps).symm a) = a :=
  (fullMixedCommonBirthOrder M B steps).apply_symm_apply a

theorem full_mixed_common_order_index_lt_of_stage_lt
    (a b : FullMixedCommonBirthAddress M B steps)
    (h : fullMixedCommonBirthStage M B steps a < fullMixedCommonBirthStage M B steps b) :
    (fullMixedCommonBirthOrder M B steps).symm a <
      (fullMixedCommonBirthOrder M B steps).symm b := by
  apply lt_of_not_ge
  intro hba
  have h' := full_mixed_common_order_stage_monotone M B steps hba
  simp only [full_mixed_common_order_exact_address] at h'
  exact (not_le_of_gt h) h'

theorem full_mixed_common_order_initial_before_event
    (a : FullMixedCommonInitialAddress M) (b : FullMixedCommonStepAddress M B steps) :
    (fullMixedCommonBirthOrder M B steps).symm (.inl a) <
      (fullMixedCommonBirthOrder M B steps).symm (.inr b) :=
  full_mixed_common_order_index_lt_of_stage_lt M B steps (.inl a) (.inr b)
    (Nat.zero_lt_succ _)

end Bounty
end

section

/- The explicit local kernel has a Fourier transform bounded below on the unit interval. -/

open MeasureTheory
open scoped FourierTransform

namespace Bounty

theorem local_mellin_kernel_fourier_formula (ξ : ℝ) :
    𝓕 localMellinKernelSchwartz ξ =
      ∫ x : ℝ, Complex.exp (((-2 * Real.pi * x * ξ : ℝ) : ℂ) * Complex.I) *
        (localMellinKernel x : ℂ) := by
  rw [SchwartzMap.fourier_coe, Real.fourier_eq']
  apply integral_congr_ae
  filter_upwards [] with x
  simp only [RCLike.inner_apply, starRingEnd_apply, star_trivial, smul_eq_mul]
  congr 2
  push_cast
  ring

theorem local_mellin_kernel_fourier_deviation (ξ : ℝ) :
    ‖𝓕 localMellinKernelSchwartz ξ - 1‖ ≤
      (4 * Real.pi / (16 * Real.pi + 1)) * |ξ| := by
  let phase : ℝ → ℂ := fun x => Complex.exp (((-2 * Real.pi * x * ξ : ℝ) : ℂ) * Complex.I)
  have hiR : Integrable localMellinKernel :=
    local_mellin_kernel_contDiff.continuous.integrable_of_hasCompactSupport local_mellin_kernel_compact
  have hi : Integrable (fun x => (localMellinKernel x : ℂ)) := hiR.ofReal
  have hphase : ∀ x, ‖phase x‖ = 1 := fun x => Complex.norm_exp_ofReal_mul_I _
  have hfi : Integrable (fun x => phase x * (localMellinKernel x : ℂ)) := by
    apply hi.norm.mono'
    · have hc : Continuous (fun x => phase x * (localMellinKernel x : ℂ)) := by
        dsimp only [phase]
        apply Continuous.mul
        · fun_prop
        · exact Complex.continuous_ofReal.comp local_mellin_kernel_contDiff.continuous
      exact hc.aestronglyMeasurable
    · filter_upwards [] with x
      rw [norm_mul, hphase, one_mul]
  have hone : (∫ x : ℝ, (localMellinKernel x : ℂ)) = 1 := by
    rw [integral_complex_ofReal, local_mellin_kernel_integral]
    norm_num
  have hp (x : ℝ) : ‖phase x - 1‖ ≤ 2 * Real.pi * |x| * |ξ| := by
    have h := Real.norm_exp_I_mul_ofReal_sub_one_le (x := -2 * Real.pi * x * ξ)
    rw [mul_comm Complex.I] at h
    dsimp only [phase]
    calc
      _ ≤ ‖-2 * Real.pi * x * ξ‖ := h
      _ = _ := by simp [Real.norm_eq_abs, abs_of_pos Real.pi_pos]
  have hbound (x : ℝ) : ‖phase x * (localMellinKernel x : ℂ) - (localMellinKernel x : ℂ)‖ ≤
      ((4 * Real.pi / (16 * Real.pi + 1)) * |ξ|) * localMellinKernel x := by
    by_cases hz : localMellinKernel x = 0
    · simp [hz]
    · have hx : |x| ≤ 2 / (16 * Real.pi + 1) :=
        le_of_not_gt (fun h => hz (local_mellin_kernel_support h))
      rw [← sub_one_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (local_mellin_kernel_nonneg x)]
      apply mul_le_mul_of_nonneg_right _ (local_mellin_kernel_nonneg x)
      apply (hp x).trans
      have hh := mul_le_mul_of_nonneg_left hx (show 0 ≤ 2 * Real.pi * |ξ| by positivity)
      convert hh using 1 <;> ring
  rw [local_mellin_kernel_fourier_formula]
  change ‖(∫ x, phase x * (localMellinKernel x : ℂ)) - 1‖ ≤ _
  rw [← hone, ← integral_sub hfi hi]
  apply (norm_integral_le_integral_norm _).trans
  calc
    _ ≤ ∫ x, ((4 * Real.pi / (16 * Real.pi + 1)) * |ξ|) * localMellinKernel x := by
      apply integral_mono_of_nonneg (Filter.Eventually.of_forall (fun x => norm_nonneg _))
        (hiR.const_mul _)
      exact Filter.Eventually.of_forall hbound
    _ = _ := by rw [integral_const_mul, local_mellin_kernel_integral, mul_one]

theorem local_mellin_kernel_fourier_lower {ξ : ℝ} (hξ : |ξ| ≤ 1) :
    1 / 2 ≤ ‖𝓕 localMellinKernelSchwartz ξ‖ := by
  have hd := local_mellin_kernel_fourier_deviation ξ
  have hc : 0 ≤ 4 * Real.pi / (16 * Real.pi + 1) := by positivity
  have hcoef : 4 * Real.pi / (16 * Real.pi + 1) ≤ 1 / 2 := by
    apply (div_le_iff₀ (by positivity : 0 < 16 * Real.pi + 1)).mpr
    linarith [Real.pi_pos]
  have hh := mul_le_mul_of_nonneg_left hξ hc
  have hn := norm_sub_norm_le (1 : ℂ) (𝓕 localMellinKernelSchwartz ξ)
  rw [norm_one, norm_sub_rev] at hn
  nlinarith

end Bounty
end

section

/- The union of additive and logarithmic kernel supports remains in a short interval. -/

open Finset
open scoped NNReal

namespace Bounty

theorem logarithmic_kernel_support_close {K : ℝ → ℂ}
    (hK : ∀ t, 1 < |t| → K t = 0) {w v H : ℝ}
    (hw : 0 < w) (hv : 0 < v) (hH : 0 < H) (hHv : H ≤ v)
    (hnz : K (v * Real.log (w/v) / H) ≠ 0) : |w-v| ≤ 2*H := by
  have hb : |v * Real.log (w/v) / H| ≤ 1 :=
    le_of_not_gt (fun h => hnz (hK _ h))
  rw [abs_div, abs_mul, abs_of_pos hv, abs_of_pos hH] at hb
  have hmul : v * |Real.log (w/v)| ≤ H := (div_le_one hH).mp hb
  have hlog : |Real.log (w/v)| ≤ 1 := by nlinarith
  have he := Real.abs_exp_sub_one_le hlog
  rw [Real.exp_log (div_pos hw hv)] at he
  have heq : |w-v| = v * |w/v-1| := by
    calc
      _ = |v * (w/v-1)| := by congr 1; field_simp
      _ = _ := by rw [abs_mul, abs_of_pos hv]
  rw [heq]
  nlinarith [mul_le_mul_of_nonneg_left he hv.le]

theorem additive_log_kernel_difference_support {K : ℝ → ℂ}
    (hK : ∀ t, 1 < |t| → K t = 0) {w v H : ℝ}
    (hw : 0 < w) (hv : 0 < v) (hH : 0 < H) (hHv : H ≤ v)
    (hnz : K ((w-v)/H) - K (v*Real.log (w/v)/H) ≠ 0) : |w-v| ≤ 2*H := by
  by_cases ha : K ((w-v)/H) = 0
  · have hb : K (v*Real.log (w/v)/H) ≠ 0 := by intro h; simp [ha,h] at hnz
    exact logarithmic_kernel_support_close hK hw hv hH hHv hb
  · have hb : |(w-v)/H| ≤ 1 := le_of_not_gt (fun h => ha (hK _ h))
    rw [abs_div, abs_of_pos hH] at hb
    have hc : |w-v| ≤ H := (div_le_one hH).mp hb
    linarith

theorem short_nat_interval_card (S : Finset ℕ) {v H : ℝ} (hH : 0 ≤ H) :
    ((S.filter (fun (n : ℕ) => |(n:ℝ)-v| ≤ 2*H)).card : ℝ) ≤ 4*H+1 := by
  have hc := nat_finset_card_le_real_span (S.filter (fun (n : ℕ) => |(n:ℝ)-v| ≤ 2*H))
    (a := v-2*H) (b := v+2*H) (by linarith) (fun n hn => by
      have hb := abs_le.mp (mem_filter.mp hn).2
      constructor <;> linarith)
  linarith

theorem finite_complex_kernel_error_bound {ι : Type*} (S : Finset ι) (a b : ι → ℂ)
    {C : ℝ} (_hC : 0 ≤ C) (hb : ∀ n ∈ S, ‖b n‖ ≤ C) :
    ‖∑ n ∈ S, a n*b n‖^2 ≤ (S.card : ℝ)*C^2*(∑ n ∈ S, ‖a n‖^2) := by
  have ht : ‖∑ n ∈ S, a n*b n‖ ≤ C * ∑ n ∈ S, ‖a n‖ := by
    apply (norm_sum_le _ _).trans
    rw [mul_sum]
    apply sum_le_sum
    intro n hn
    rw [norm_mul, mul_comm C]
    exact mul_le_mul_of_nonneg_left (hb n hn) (norm_nonneg _)
  have hc := sum_mul_sq_le_sq_mul_sq S (fun _ => (1 : ℝ)) (fun n => ‖a n‖)
  simp only [one_mul, one_pow, sum_const, nsmul_eq_mul, mul_one] at hc
  have hs := pow_le_pow_left₀ (norm_nonneg _) ht 2
  rw [mul_pow] at hs
  nlinarith [mul_le_mul_of_nonneg_left hc (sq_nonneg C)]

end Bounty
end

section

/- The restricted list sum equals the original all-label sum with its divisibility gate. -/

open Finset
open scoped Classical

namespace Bounty

theorem group_marked_sum_eq_indicator {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (t : G → ℕ) (n : ℤ) (b : GroupMarkedLists P t → ℂ) :
    (∑ L : GroupMarkedListsAt P t n, b L.val) =
      ∑ L : GroupMarkedLists P t, if ∀ g s, ((L g s).val : ℤ) ∣ n then b L else 0 := by
  classical
  rw [← sum_filter]
  exact (sum_subtype _ (by simp) b).symm

theorem weighted_group_marked_indicator_eq_average {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (q : ℝ) (V : G → ℝ) (t : G → ℕ) (n : ℤ)
    (b : GroupMarkedLists P t → ℂ) :
    ((∏ g, q ^ (physicalOmega P g n - t g) / V g ^ t g : ℝ) : ℂ) *
        (∑ L : GroupMarkedLists P t, if ∀ g s, ((L g s).val : ℤ) ∣ n then b L else 0) =
      (markedDivisorWeight univ P q V t n : ℂ) * groupMarkedAverage P t n b := by
  rw [← group_marked_sum_eq_indicator]
  exact weighted_group_marked_sum_eq_average P q V t n b

theorem weighted_product_sum_eq_partial_average {A B : Type*} [Fintype A] [Fintype B]
    (c : ℂ) (b : A → ℂ) :
    c * (∑ x : A × B, b x.1) =
      (c * ((Fintype.card A : ℂ) * (Fintype.card B : ℂ))) *
        ((Fintype.card A : ℂ)⁻¹ * ∑ x : A, b x) := by
  classical
  by_cases hz : Fintype.card A = 0
  · let : IsEmpty A := Fintype.card_eq_zero_iff.mp hz
    simp only [Fintype.sum_empty, mul_zero]
  · have hne : (Fintype.card A : ℂ) ≠ 0 := by exact_mod_cast hz
    rw [Fintype.sum_prod_type]
    simp only [sum_const, card_univ, nsmul_eq_mul, ← mul_sum]
    field_simp

end Bounty
end

section

open MeasureTheory
open scoped ComplexConjugate

namespace Bounty

theorem oscillatory_cauchy_kernel_integrable (C : ℝ) :
    Integrable (fun x : ℝ => C / (1+(x/(2*Real.pi))^2)) := by
  have hi := integrable_inv_one_add_sq.comp_mul_left'
    (inv_ne_zero (ne_of_gt (mul_pos (by norm_num : (0:ℝ)<2) Real.pi_pos)))
  simpa only [div_eq_mul_inv, mul_comm] using hi.const_mul C

theorem oscillatory_cauchy_kernel_integral (C : ℝ) :
    (∫ x : ℝ, C / (1+(x/(2*Real.pi))^2)) = C * (2*Real.pi^2) := by
  simp_rw [div_eq_mul_inv C]
  rw [integral_const_mul, Measure.integral_comp_div (fun x : ℝ => (1+x^2)⁻¹) (2*Real.pi)]
  rw [abs_of_pos (mul_pos (by norm_num : (0:ℝ)<2) Real.pi_pos), smul_eq_mul,
    integral_univ_inv_one_add_sq]
  ring

theorem oscillatory_gram_phase (a : ℝ → ℝ → ℂ) (h t r u : ℝ) :
    (Complex.exp (((-t*u:ℝ):ℂ)*Complex.I) * a (h*t) u) *
      conj (Complex.exp (((-r*u:ℝ):ℂ)*Complex.I) * a (h*r) u) =
    Complex.exp (((-2*Real.pi*((t-r)/(2*Real.pi))*u:ℝ):ℂ)*Complex.I) *
      a (h*t) u * conj (a (h*r) u) := by
  have hpi : (2:ℝ)*Real.pi ≠ 0 := ne_of_gt (mul_pos (by norm_num) Real.pi_pos)
  simp only [map_mul, ← Complex.exp_conj, Complex.conj_ofReal, Complex.conj_I]
  calc
    _ = (Complex.exp (((-t*u:ℝ):ℂ)*Complex.I) *
        Complex.exp (((-r*u:ℝ):ℂ)*(-Complex.I))) * (a (h*t) u * conj (a (h*r) u)) := by ring
    _ = _ := by
      rw [← Complex.exp_add]
      have he : (((-t*u:ℝ):ℂ)*Complex.I) + (((-r*u:ℝ):ℂ)*(-Complex.I)) =
          (((-2*Real.pi*((t-r)/(2*Real.pi))*u:ℝ):ℂ)*Complex.I) := by
        have hr : -t*u - (-r*u) = -2*Real.pi*((t-r)/(2*Real.pi))*u := by field_simp; ring
        rw [← hr]
        push_cast
        ring
      rw [he]
      ring

theorem oscillatory_schur_energy_integrable
    {a : ℝ → ℝ → ℂ} {f : ℝ → ℂ} {M : ℝ}
    (ha : Continuous (Function.uncurry a)) (hM : 0 ≤ M)
    (hab : ∀ v u, ‖a v u‖ ≤ M)
    (has : ∀ v u, u ∉ Set.Icc (-3:ℝ) 3 → a v u = 0)
    (hf : Continuous f) (hfi : Integrable f) (h : ℝ) :
    Integrable (fun u : ℝ => ‖∫ t : ℝ, Complex.exp (((-t*u:ℝ):ℂ)*Complex.I) *
      a (h*t) u * f t‖^2) := by
  classical
  let A : ℝ → ℝ → ℂ := fun u t => Complex.exp (((-t*u:ℝ):ℂ)*Complex.I) * a (h*t) u
  have hAc : Continuous (Function.uncurry A) := by dsimp [A]; fun_prop
  have hAb (u t : ℝ) : ‖A u t‖ ≤ M := by
    dsimp [A]
    rw [norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]
    exact hab (h*t) u
  have hi := bounded_amplitude_energy_integrable
    (volume.restrict (Set.Icc (-3:ℝ) 3)) hAc hf hfi hM hAb
  have he : (Set.Icc (-3:ℝ) 3).indicator (fun u : ℝ => ‖∫ t : ℝ, A u t * f t‖^2) =
      (fun u : ℝ => ‖∫ t : ℝ, A u t * f t‖^2) := by
    funext u
    by_cases hu : u ∈ Set.Icc (-3:ℝ) 3
    · exact Set.indicator_of_mem hu _
    · rw [Set.indicator_of_notMem hu]
      have hz : (fun t => A u t * f t) = fun _ => (0:ℂ) := by
        funext t
        dsimp [A]
        rw [has (h*t) u hu, mul_zero, zero_mul]
      rw [hz, integral_zero, norm_zero, zero_pow (by decide : 2 ≠ 0)]
  have hii := IntegrableOn.integrable_indicator hi measurableSet_Icc
  rw [he] at hii
  exact hii

theorem oscillatory_schur_energy_bound
    {a : ℝ → ℝ → ℂ} {f : ℝ → ℂ} {M C : ℝ}
    (ha : Continuous (Function.uncurry a)) (hM : 0 ≤ M)
    (hab : ∀ v u, ‖a v u‖ ≤ M)
    (has : ∀ v u, u ∉ Set.Icc (-3:ℝ) 3 → a v u = 0)
    (hC : 0 ≤ C)
    (hFourier : ∀ v w ξ : ℝ,
      ‖∫ u : ℝ, Complex.exp (((-2*Real.pi*ξ*u:ℝ):ℂ)*Complex.I) *
        a v u * conj (a w u)‖ ≤ C/(1+ξ^2))
    (hf : Continuous f) (hfi : Integrable f)
    (hf2 : Integrable (fun t => ‖f t‖^2)) (h : ℝ) :
    (∫ u : ℝ, ‖∫ t : ℝ, Complex.exp (((-t*u:ℝ):ℂ)*Complex.I) *
      a (h*t) u * f t‖^2) ≤ C*(2*Real.pi^2) * ∫ t : ℝ, ‖f t‖^2 := by
  let A : ℝ → ℝ → ℂ := fun u t => Complex.exp (((-t*u:ℝ):ℂ)*Complex.I) * a (h*t) u
  let K : ℝ → ℝ := fun x => C/(1+(x/(2*Real.pi))^2)
  have hAc : Continuous (Function.uncurry A) := by dsimp [A]; fun_prop
  have hAb (u t : ℝ) : ‖A u t‖ ≤ M := by
    dsimp [A]
    rw [norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]
    exact hab (h*t) u
  have hKc : Continuous K := by
    dsimp [K]
    apply Continuous.div continuous_const (by fun_prop)
    intro x
    positivity
  have hK0 (x : ℝ) : 0 ≤ K x := div_nonneg hC (by positivity)
  have hKe (x : ℝ) : K (-x) = K x := by dsimp [K]; congr 2; ring
  have hGram (t r : ℝ) :
      ‖∫ u in Set.Icc (-3:ℝ) 3, A u t * conj (A u r)‖ ≤ K (t-r) := by
    rw [setIntegral_eq_integral_of_forall_compl_eq_zero (fun u hu => ?_)]
    · have heq : (fun u => A u t * conj (A u r)) =
          (fun u => Complex.exp (((-2*Real.pi*((t-r)/(2*Real.pi))*u:ℝ):ℂ)*Complex.I) *
            a (h*t) u * conj (a (h*r) u)) := funext (oscillatory_gram_phase a h t r)
      rw [heq]
      exact hFourier (h*t) (h*r) ((t-r)/(2*Real.pi))
    · dsimp [A]
      rw [has (h*t) u hu, mul_zero, zero_mul]
  have hb := bounded_amplitude_energy_le_of_gram
    (volume.restrict (Set.Icc (-3:ℝ) 3)) hAc hf hfi hf2 hM hAb
    hKc (oscillatory_cauchy_kernel_integrable C) hK0 hKe hGram
  rw [oscillatory_cauchy_kernel_integral C] at hb
  have he : (∫ u in Set.Icc (-3:ℝ) 3, ‖∫ t : ℝ, A u t * f t‖^2) =
      ∫ u : ℝ, ‖∫ t : ℝ, A u t * f t‖^2 := by
    apply setIntegral_eq_integral_of_forall_compl_eq_zero
    intro u hu
    have hz : (fun t => A u t * f t) = fun _ => (0:ℂ) := by
      funext t
      dsimp [A]
      rw [has (h*t) u hu, mul_zero, zero_mul]
    rw [hz, integral_zero, norm_zero, zero_pow (by decide : 2 ≠ 0)]
  rw [he] at hb
  exact hb

end Bounty
end

