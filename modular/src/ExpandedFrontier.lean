section

/- Nonzero blocks of the actual ambient discrepancies have the required Type-II sizes. -/

open Finset Filter

namespace Bounty

theorem eventually_ambient_rough_active_dyadic_bounds {aMin vMax : ℝ}
    (haMin : 0 < aMin) (hvMax : vMax < 1) :
    ∀ᶠ L : ℝ in atTop, ∀ (γ S a v : ℝ), aMin ≤ a → v ≤ vMax →
      ∀ (T : Finset ℕ) (μ : ℕ → ℝ) (H i j : ℕ),
      shiftedTypeIIBilinear T μ
        (typeIIRestrict (dyadicNatBucket (Icc 1 H) i) (ambientRoughIntervalTypeIIAlpha γ L S a v))
        (typeIIRestrict (dyadicNatBucket (Icc 1 H) j)
          (ambientRoughTypeIIBeta (Real.exp (a*L)) (Real.exp (v*L)))) ≠ 0 →
      Real.exp ((min ((1-vMax)/2) (aMin/2))*L) ≤ originalDyadicBase i ∧ originalDyadicBase i ≤ Real.exp L ∧
      Real.exp ((min ((1-vMax)/2) (aMin/2))*L) ≤ originalDyadicBase j ∧ originalDyadicBase j ≤ Real.exp L := by
  filter_upwards [eventually_exponential_dyadic_base_bounds (a := 1-vMax) (b := 1-aMin)
      (C := (33 : ℝ)) (by linarith) (by linarith) (by norm_num),
    eventually_exponential_dyadic_base_bounds (a := aMin) (b := vMax)
      (C := (1 : ℝ)) haMin hvMax (by norm_num),eventually_ge_atTop (0 : ℝ)]
    with L hmBase hnBase hL
  intro γ S a v ha hv T μ H i j hne
  obtain ⟨w,_,hwm,hwn⟩ := shifted_typeII_nonzero_factors T μ _ _ hne
  obtain ⟨hmi,hα⟩ := (typeIIRestrict_ne_zero_iff _ _ _).mp hwm
  obtain ⟨hnj,hβ⟩ := (typeIIRestrict_ne_zero_iff _ _ _).mp hwn
  have hmrange := ambient_rough_interval_typeII_support γ L S a v hα
  have hnmem := (ambient_rough_typeII_beta_properties (Real.exp (a*L)) (Real.exp (v*L)) w.2).2 hβ
  have hnrange := (mem_primeBand_iff (Real.exp_pos _).le (Real.exp_pos _).le w.2).mp hnmem.1
  have hmlo : Real.exp ((1-vMax)*L) ≤ (w.1 : ℝ) :=
    (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right (by linarith) hL)).trans hmrange.2.2.1
  have hmhi : (w.1 : ℝ) ≤ 33*Real.exp ((1-aMin)*L) :=
    hmrange.2.2.2.trans (mul_le_mul_of_nonneg_left
      (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right (by linarith) hL)) (by norm_num))
  have hnlo : Real.exp (aMin*L) ≤ (w.2 : ℝ) :=
    (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right ha hL)).trans hnrange.2.1.le
  have hnhi : (w.2 : ℝ) ≤ 1*Real.exp (vMax*L) := by
    simpa only [one_mul] using hnrange.2.2.trans
      (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right hv hL))
  have hmb := original_dyadic_member_bounds H i w.1 hmi
  have hnb := original_dyadic_member_bounds H j w.2 hnj
  obtain ⟨hmlo',hmhi'⟩ := hmBase _ _ hmlo hmhi hmb.1 hmb.2
  obtain ⟨hnlo',hnhi'⟩ := hnBase _ _ hnlo hnhi hnb.1 hnb.2
  refine ⟨?_,hmhi',?_,hnhi'⟩
  · exact (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right (min_le_left _ _) hL)).trans hmlo'
  · exact (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right (min_le_right _ _) hL)).trans hnlo'

theorem eventually_ambient_prime_active_dyadic_bounds :
    ∀ᶠ L : ℝ in atTop, ∀ (κ S : ℝ), 0 ≤ κ → κ ≤ 1/50 →
      ∀ (proxy : Bool) (T : Finset ℕ) (μ : ℕ → ℝ) (H i j : ℕ),
      shiftedTypeIIBilinear T μ
        (typeIIRestrict (dyadicNatBucket (Icc 1 H) i) (ambientPrimeTypeIIAlpha κ L S))
        (typeIIRestrict (dyadicNatBucket (Icc 1 H) j)
          (if proxy then ambientProxyTypeIIBeta κ L S else ambientPrimeTypeIIBeta κ L)) ≠ 0 →
      Real.exp ((1/5 : ℝ)*L) ≤ originalDyadicBase i ∧ originalDyadicBase i ≤ Real.exp L ∧
      Real.exp ((1/5 : ℝ)*L) ≤ originalDyadicBase j ∧ originalDyadicBase j ≤ Real.exp L := by
  filter_upwards [eventually_exponential_dyadic_base_bounds (a := (2/5 : ℝ)) (b := (3/5 : ℝ))
    (C := (1 : ℝ)) (by norm_num) (by norm_num) (by norm_num),eventually_ge_atTop (0 : ℝ)]
    with L hBase hL
  intro κ S hκ hκmax proxy T μ H i j hne
  obtain ⟨w,_,hwm,hwn⟩ := shifted_typeII_nonzero_factors T μ _ _ hne
  obtain ⟨hmi,hα⟩ := (typeIIRestrict_ne_zero_iff _ _ _).mp hwm
  obtain ⟨hnj,hβ⟩ := (typeIIRestrict_ne_zero_iff _ _ _).mp hwn
  have hmrange := (ambient_balanced_typeII_support κ L S).1 hα
  have hnrange : w.2 ∈ ambientBalancedTypeIIRange κ L := by
    cases proxy with
    | false => exact (ambient_balanced_typeII_support κ L S).2.1 hβ
    | true => exact (ambient_balanced_typeII_support κ L S).2.2 hβ
  have hrange (n : ℕ) (hn : n ∈ ambientBalancedTypeIIRange κ L) :
      Real.exp ((2/5 : ℝ)*L) ≤ (n : ℝ) ∧ (n : ℝ) ≤ 1*Real.exp ((3/5 : ℝ)*L) := by
    obtain ⟨hlo,hhi⟩ := (mem_ambientBalancedTypeIIRange κ L n).mp hn
    constructor
    · exact (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right (by linarith) hL)).trans hlo
    · simpa only [one_mul] using hhi.trans
        (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right (by linarith) hL))
  have hmr := hrange w.1 hmrange
  have hnr := hrange w.2 hnrange
  have hmb := original_dyadic_member_bounds H i w.1 hmi
  have hnb := original_dyadic_member_bounds H j w.2 hnj
  have hm := hBase _ _ hmr.1 hmr.2 hmb.1 hmb.2
  have hn := hBase _ _ hnr.1 hnr.2 hnb.1 hnb.2
  norm_num at hm hn
  exact ⟨hm.1,hm.2,hn.1,hn.2⟩

end Bounty
end

