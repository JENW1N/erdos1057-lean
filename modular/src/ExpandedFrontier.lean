section

/- One extra power absorbs the fixed Fourier L1 mass, uniformly in the central radius. -/

open MeasureTheory Filter
namespace Bounty

theorem eventually_harmonic_central_integral_decay (D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (Y R : ℝ) (G : ℝ → ℂ), 0 < Y →
      (∀ v : ℝ, ‖v‖ ≤ R → ‖G v‖ ≤ Y*L^(-(D+1))) →
      ‖(Y : ℂ)⁻¹ * ∫ v in {v : ℝ | ‖v‖ ≤ R}, harmonicLogFourier v * G v‖ ≤ L^(-D) := by
  filter_upwards [eventually_ge_atTop (max 1 (∫ v : ℝ, ‖harmonicLogFourier v‖))]
    with L hL
  intro Y R G hY hG
  have hL0 : 0 < L := zero_lt_one.trans_le ((le_max_left _ _).trans hL)
  have hmass := (le_max_right _ _).trans hL
  have hs : MeasurableSet {v : ℝ | ‖v‖ ≤ R} :=
    (isClosed_le continuous_norm continuous_const).measurableSet
  have hGe : ∀ᵐ v ∂volume.restrict {v : ℝ | ‖v‖ ≤ R}, ‖G v‖ ≤ Y*L^(-(D+1)) :=
    (ae_restrict_mem hs).mono (fun v hv => hG v hv)
  refine (normalized_harmonic_central_bound hY
    (Real.rpow_pos_of_pos hL0 _).le _ G hGe).trans ?_
  calc
    _ ≤ L * L^(-(D+1)) := mul_le_mul_of_nonneg_right hmass
      (Real.rpow_pos_of_pos hL0 _).le
    _ = L^(-D) := by
      calc
        _ = L^(1 : ℝ) * L^(-(D+1)) := by rw [Real.rpow_one]
        _ = _ := by rw [← Real.rpow_add hL0]; congr 1; ring

end Bounty
end

section

/- The original physical initial mass and finite selected-path sum obey one scalar energy estimate. -/

open Finset
namespace Bounty

section Energy
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g, ∀ p : ↥(P g), NeZero p.val]
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)
  (S : Finset (PhysicalSelectedData P ell C)) (w : PhysicalSelectedData P ell C → ℂ)

omit [∀ g, ∀ p : ↥(P g), NeZero p.val] in
theorem physical_selected_initial_pairing
    (a : PhysicalMarkLists P J ell → ℂ)
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    (∑ M : PhysicalMarkLists P J ell, a M *
      (∑ d ∈ S, w d *
        finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
          (physicalSelectedFineRow C d.1 d.2.1 d.2.2.1 d.2.2.2 k β V ρ hV ω retention)
          (4 * n + 1) F (physicalInitialMarkState B M))) =
    ∑ d ∈ S, a (d.2.1 0) * (w d *
      finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
        (physicalSelectedFineRow C d.1 d.2.1 d.2.2.1 d.2.2.2 k β V ρ hV ω retention)
        (4 * n + 1) F (physicalInitialMarkState B (d.2.1 0))) := by
  apply finite_selected_source_pairing
  intro d hd M
  have h := physical_selected_fine_initial_mark_indicator C d.1 d.2.1 d.2.2.1 d.2.2.2
    k β V ρ hV ω retention F M
  split_ifs with hM
  · simpa only [if_pos hM] using h
  · simpa only [if_neg hM] using h

theorem physical_selected_outer_path_scalar_le
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hω : ∀ j c a, 0 ≤ ω j c a) (hωmass : ∀ j c, ∑ a, ω j c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 < β g p / V g) (hmass : ∀ g, ∑ p, β g p / V g ≤ 2)
    (hq0 : ∀ i, 0 ≤ retention i) (hq1 : ∀ i, retention i ≤ 1)
    (hD : ∀ i, retention i / ρ ^ 2 + ((1 - retention i) / ρ) / v ≤ 1)
    (hC : ∀ i g, retention i / ρ ^ 2 + ((1 - retention i) * V g / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ j g, ell + (C j g).card ≤ T)
    (hw : ∀ d ∈ S, ‖w d‖ ≤ 1)
    :
    ‖∑ d ∈ S,
      ((∏ g, ∏ i : PhysicalSlots J ell, β g (d.2.1 0 g i) / V g : ℝ) : ℂ) * (w d *
        finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
          (physicalSelectedFineRow C d.1 d.2.1 d.2.2.1 d.2.2.2 k β V ρ hV ω retention)
          (4 * n + 1) physicalEmptyMemoryTerminal (physicalInitialMarkState B (d.2.1 0)))‖ ^ 2 ≤
      physicalMarkMass (J := J) (ell := ell) (fun g p => β g p / V g) *
        (physicalGhostUniformEnergyBound ρ vmax v ^ (N * (n + 1)) *
          unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ (N * n) *
          ∏ g, (∑ p, β g p / V g) ^ (J + ell)) := by
  have he := physical_selected_outer_vacuum_scalar_le (B := B) C k β V ρ hV ω retention
    (physicalSelectedFineCut C) S w hP hdis (physical_selected_fine_cut_encoding C)
    hω hωmass hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass hq0 hq1 hD hC T ht
    fullActiveInitialLedger hw
  simp only [physical_full_initial_ledger] at he
  change ‖∑ M : PhysicalMarkLists P J ell,
    ((∏ g, ∏ i : PhysicalSlots J ell, β g (M g i) / V g : ℝ) : ℂ) *
      (∑ d ∈ S, w d *
        finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
          (physicalSelectedFineRow C d.1 d.2.1 d.2.2.1 d.2.2.2 k β V ρ hV ω retention)
          (4 * n + 1) physicalEmptyMemoryTerminal (physicalInitialMarkState B M))‖ ^ 2 ≤ _ at he
  rw [physical_selected_initial_pairing C k β V ρ hV ω retention S w] at he
  exact he

end Energy
end Bounty
end

section

/- The actual root residue model equals the baseline times its original memory-history sum. -/

open Finset
open scoped Classical
namespace Bounty

section Normalization
variable {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  [∀ a : PhysicalPrime P, NeZero a.2.val]
  (V : Fin N → ℝ) (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
  (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
  (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
  (hP : ∀ g a, a ∈ P g → Nat.Prime a)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ t < n + 1, ∀ i ∈ patterns, ∀ g a, a ∈ P g → ¬ (a : ℤ) ∣ k t i)
  (b : PhysicalPrime P → ℝ)
  (hb : ∀ a, b a = 1 - (∑ j ∈ range (n + 2), (1 - physicalEndpointSchedule q (n + 1) j)) / a.2.val)
  (hb0 : ∀ a, b a ≠ 0)

include hP hdis hk hb hb0

theorem physical_root_residue_model_memory_normalization :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    physicalRootResidueModel V patterns C q ζ k K n =
      (∏ a : PhysicalPrime P, (b a : ℂ)) * ∑ L : PhysicalMarkLists P J ell,
        ∑ p : {p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell //
          physicalRootNormalizablePath V patterns C ζ k K L p},
          physicalMemoryWalkScalar V patterns C ζ K (finitePathLabels p.val) (finitePathMarks L p.val) (n + 1) *
            (∏ a : PhysicalPrime P, (ghostPhaseRunHistory
              (fun j => decide (a ∈ physicalMarkedPrimes (finitePathMarks L p.val j)))
              (fun j => -(physicalBareOffset C k (finitePathLabels p.val) (finitePathMarks L p.val)
                (n + 1) j : ZMod a.2.val))
              (fun j => 1 - physicalEndpointSchedule q (n + 1) j)
              ((a.2.val : ℝ) * b a)⁻¹ (V a.1) (n + 1) : ℂ)) := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  rw [physical_root_residue_model_normalizable V patterns C ζ k K hP hdis q]
  simp only [mul_sum]
  apply sum_congr rfl
  intro L _
  apply sum_congr rfl
  intro p _
  have hkp : ∀ j : Fin (n + 1), ∀ g s,
      ¬ (((physicalPathSelectedEquiv patterns C (L, p.val)).2.2.1 j.castSucc g s).val : ℤ) ∣
        physicalPathSelectedMultiplier C k p.val j := by
    intro j g s
    exact hk (n - j.val) (by omega) (p.val j).1.2.2.1.val (p.val j).1.2.2.1.property g _
      ((physicalPathSelectedEquiv patterns C (L, p.val)).2.2.1 j.castSucc g s).property
  simpa only [mul_assoc] using physical_finite_root_term_memory_normalization
    V patterns C q ζ k K L p.val p.property hP hdis hkp b hb hb0

end Normalization
end Bounty
end

section

/- Incompatible residue paths have zero complete normalized phase product. -/

open Finset
open scoped Classical
namespace Bounty

theorem ghost_phase_run_product_eq {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (a : I → ℕ → Bool) (h : (i : I) → ℕ → R i) (η : I → ℕ → ℝ)
    (β V : I → ℝ) (n : ℕ) :
    (∏ i, ghostPhaseRunHistory (a i) (h i) (η i) (β i) (V i) n) =
      (∏ i, (V i)⁻¹ ^ ghostPhaseRunCount (a i) n) * ghostPhaseTensorHistory a h η β n := by
  simp_rw [ghost_phase_run_history_eq]
  rw [prod_mul_distrib, ghost_phase_tensor_history_factor]

section Finite
variable {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  [∀ a : PhysicalPrime P, NeZero a.2.val]
  (V : Fin N → ℝ) {patterns : Finset I} (C : I → Fin N → Finset (Fin J))
  (q : ℝ) (k : ℕ → I → ℤ) (b : PhysicalPrime P → ℝ)
  (L : PhysicalMarkLists P J ell)
  (p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)

noncomputable def physicalFiniteRunProduct : ℝ :=
  ∏ a : PhysicalPrime P, ghostPhaseRunHistory
    (fun j => decide (a ∈ physicalMarkedPrimes (finitePathMarks L p j)))
    (fun j => -(physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p)
      (n + 1) j : ZMod a.2.val))
    (fun j => 1 - physicalEndpointSchedule q (n + 1) j)
    ((a.2.val : ℝ) * b a)⁻¹ (V a.1) (n + 1)

theorem physical_finite_run_product_zero_of_incompatible
    (hP : ∀ g a, a ∈ P g → Nat.Prime a)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hb : ∀ a, b a = 1 - (∑ j ∈ range (n + 2), (1 - physicalEndpointSchedule q (n + 1) j)) / a.2.val)
    (hb0 : ∀ a, b a ≠ 0)
    (hi : ¬ ∃ r : PhysicalResidues P, physicalFinitePathResidueCompatible C k n r L p) :
    physicalFiniteRunProduct V C q k b L p = 0 := by
  have he := physical_finite_vertex_expectation_eq_phase C q k L p b hb hb0
  rw [physical_finite_vertex_expectation_zero_of_incompatible hdis hP C q k n L p hi] at he
  have hz := (mul_eq_zero.mp he.symm).resolve_left (prod_ne_zero_iff.mpr (fun a _ => hb0 a))
  unfold physicalFiniteRunProduct
  rw [ghost_phase_run_product_eq, hz, mul_zero]

theorem physical_finite_capped_eq_run_product (B : ℕ)
    (hB : Fintype.card (PhysicalPrime P) ≤ B) :
    ghostPhaseCappedHistory
      (fun a : PhysicalPrime P => fun j => globalBirthFiniteActivity
        (physicalGroupBareFiniteActivity (physicalPathSelectedEquiv patterns C (L, p)).2.2.1 a.1) j a.2)
      (fun a => physicalResidueAbsoluteHit (physicalPathSelectedOffset C k L p) a.1 a.2)
      (fun _ j => 1 - physicalEndpointSchedule q (n + 1) (globalBirthFiniteIndex (n + 1) j).val)
      (fun a => ((a.2.val : ℝ) * b a)⁻¹) (fun a => V a.1)
      (fun _ => B) (fun _ => B) (n + 1) = physicalFiniteRunProduct V C q k b L p :=
  physical_finite_path_capped_eq_run_product C k L p
    (fun j => 1 - physicalEndpointSchedule q (n + 1) j)
    (fun a => ((a.2.val : ℝ) * b a)⁻¹) V B hB

end Finite
end Bounty
end

section

/- The recovered trace coefficient is a product of local active-endpoint factors. -/

open Finset
open scoped Classical
namespace Bounty
section Record
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J))
  (cut : ℕ → Fin N → Finset (Fin J)) (ζ : Fin n → ℝ)
  (K : ∀ j, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C j) → ℂ)

noncomputable def physicalObservedCoefficient (j : Fin n)
    (o : PhysicalMarkObservation P ell C)
    (s t : (g : Fin N) → Fin (J + ell) → ↥(P g)) : ℂ :=
  if h : ∃ a : PhysicalAuxLabels P (C j), o = .inr (some ⟨j, a⟩) then
    physicalActiveCoefficient (cut (4 * j.val + 2)) (cut (4 * j.val + 3))
      (C j) (ζ j) (K j) s t h.choose
  else 0

theorem physical_observed_coefficient_aux (j : Fin n) (a : PhysicalAuxLabels P (C j))
    (s t : (g : Fin N) → Fin (J + ell) → ↥(P g)) :
    physicalObservedCoefficient C cut ζ K j (.inr (some ⟨j, a⟩)) s t =
      physicalActiveCoefficient (cut (4 * j.val + 2)) (cut (4 * j.val + 3))
        (C j) (ζ j) (K j) s t a := by
  have h : ∃ b : PhysicalAuxLabels P (C j),
      (Sum.inr (some ⟨j, a⟩) : PhysicalMarkObservation P ell C) = .inr (some ⟨j, b⟩) := ⟨a, rfl⟩
  unfold physicalObservedCoefficient
  rw [dif_pos h]
  have he : h.choose = a := by
    exact (eq_of_heq (Sigma.mk.inj_iff.mp (Option.some.inj (Sum.inr.inj h.choose_spec))).2).symm
  rw [he]

noncomputable def physicalRecordCoefficient
    (r : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C)) : ℂ :=
  ∏ j : Fin n,
    match r[4 * j.val + 1]?, r[4 * j.val + 2]? with
    | some s, some t => physicalObservedCoefficient C cut ζ K j t.2.1
        (fun g => (s.2.2.2 g).1) (fun g => (t.2.2.2 g).1)
    | _, _ => 0

theorem physical_record_coefficient_decoded
    (o : ℕ → PhysicalMarkObservation P ell C)
    (t : ℕ → PhysicalBoundedMarkState P J ell B)
    (r : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C))
    (hlen : r.length = 4 * n + 1)
    (ho : ∀ (i : ℕ) (hi : i < r.length), (r.get ⟨i, hi⟩).2.1 = o i)
    (ht : ∀ (i : ℕ) (hi : i < r.length), (r.get ⟨i, hi⟩).2.2 =
      physicalBoundedMarkEncode (cut (i + 1)) (t i))
    (a : ∀ j, PhysicalAuxLabels P (C j))
    (ha : ∀ j, o (4 * j.val + 2) = .inr (some ⟨j, a j⟩)) :
    physicalRecordCoefficient C cut ζ K r =
      ∏ j : Fin n, K j (t (4 * j.val + 1)).1 (t (4 * j.val + 2)).1 (a j) *
        physicalPhase (ζ j) (physicalD (C j) (t (4 * j.val + 1)).1 (a j)) := by
  unfold physicalRecordCoefficient
  apply prod_congr rfl
  intro j _
  have h1 : 4 * j.val + 1 < r.length := by omega
  have h2 : 4 * j.val + 2 < r.length := by omega
  rw [List.getElem?_eq_getElem h1, List.getElem?_eq_getElem h2]
  change physicalObservedCoefficient C cut ζ K j (r.get ⟨_, h2⟩).2.1
    (fun g => ((r.get ⟨_, h1⟩).2.2.2 g).1)
    (fun g => ((r.get ⟨_, h2⟩).2.2.2 g).1) = _
  rw [ho _ h2, ha j, physical_observed_coefficient_aux, ht _ h1, ht _ h2]
  exact physical_active_coefficient_encode _ _ _ _ _ _ _ _

theorem physical_coherent_record_local_coefficient
    [Fintype (PhysicalSelectedData P ell C)]
    (o : ℕ → PhysicalMarkObservation P ell C)
    (t : ℕ → PhysicalBoundedMarkState P J ell B)
    (r : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C))
    (h : PhysicalFineHistoryCoherent C o t) (hlen : r.length = 4 * n + 1)
    (ho : ∀ (i : ℕ) (hi : i < r.length), (r.get ⟨i, hi⟩).2.1 = o i)
    (ht : ∀ (i : ℕ) (hi : i < r.length), (r.get ⟨i, hi⟩).2.2 =
      physicalBoundedMarkEncode (cut (i + 1)) (t i)) :
    physicalSelectedDataRecordPhase C cut Finset.univ (physicalSelectedCoefficient C ζ K) r =
      physicalRecordCoefficient C cut ζ K r := by
  choose a ha using h.2.2.1
  rw [physical_coherent_record_coefficient_sum C cut o t r hlen ho ht h ζ K a ha,
    physical_record_coefficient_decoded C cut ζ K o t r hlen ho ht a ha]

end Record
end Bounty
end

section

/- A supported original root term, with memory expansion confined to selected groups. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_finite_root_term_partial_memory_normalization
    {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    [∀ a : PhysicalPrime P, NeZero a.2.val]
    (groups : Finset (Fin N)) (V : Fin N → ℝ) (patterns : Finset I)
    (C : I → Fin N → Finset (Fin J)) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ)
    (L : PhysicalMarkLists P J ell)
    (p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)
    (hp : physicalRootNormalizablePath V patterns C ζ k K L p)
    (hP : ∀ g a, a ∈ P g → Nat.Prime a)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hk : ∀ j : Fin (n + 1), ∀ g s,
      ¬ (((physicalPathSelectedEquiv patterns C (L, p)).2.2.1 j.castSucc g s).val : ℤ) ∣
        physicalPathSelectedMultiplier C k p j)
    (b : PhysicalPrime P → ℝ)
    (hb : ∀ a : PhysicalPrime P, a.1 ∈ groups →
      b a = 1 - (∑ j ∈ range (n + 2), (1 - physicalEndpointSchedule q (n + 1) j)) / a.2.val)
    (hb0 : ∀ a : PhysicalPrime P, a.1 ∈ groups → b a ≠ 0) :
    (physicalStateMass V J ell : ℂ) * physicalFiniteReturnScalar V patterns C ζ k K n L p *
      (physicalFiniteVertexExpectation C q k n L p : ℂ) =
    (physicalGroupPathMass V groupsᶜ
      (fun j => C (finitePathLabels p j).2.2.1.val) ell (n + 1) : ℂ) *
      physicalMemoryWalkScalar V patterns C ζ K (finitePathLabels p) (finitePathMarks L p) (n + 1) *
      (poolPathResidueExpectation (fun a : PhysicalPrime P => a.2.val)
        (physicalPrimeGroups P groupsᶜ) (range (n + 2))
        (fun a => (range (n + 2)).filter (fun j => a ∈ physicalMarkedPrimes (finitePathMarks L p j)))
        (fun a j => -(physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p)
          (n + 1) j : ZMod a.2.val))
        (fun j => 1 - physicalEndpointSchedule q (n + 1) j) : ℝ) *
      (∏ a ∈ physicalPrimeGroups P groups, b a : ℝ) *
      (∏ a ∈ physicalPrimeGroups P groups,
        ghostPhaseRunHistory (fun j => decide (a ∈ physicalMarkedPrimes (finitePathMarks L p j)))
          (fun j => -(physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p)
            (n + 1) j : ZMod a.2.val))
          (fun j => 1 - physicalEndpointSchedule q (n + 1) j)
          ((a.2.val : ℝ) * b a)⁻¹ (V a.1) (n + 1) : ℝ) := by
  obtain ⟨r, hr⟩ := hp.2
  have hn := physical_finite_path_new_marks V patterns C ζ k K L p hp.1 r hr hP hdis hk
  rw [physical_root_normalizable_return_eq_walk V patterns C ζ k K L p hp]
  exact physical_partial_memory_walk_normalization groups V patterns C ζ K
    (finitePathLabels p) (finitePathMarks L p) (n + 1) _ _ b
    (fun j hj g _ => hn j hj g) hb hb0

end Bounty
end

section

/- With unit endpoint coefficient and empty small cuts, only the small shared prefix remains. -/

open Finset
open scoped Classical
namespace Bounty
section Groups
variable {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    (small : G → Prop) (C : G → Finset (Fin J))
    (hC : ∀ g, small g → C g = ∅) (ζ : ℝ)

include hC in
theorem physical_D_small_empty (L : PhysicalMarkLists P J ell) (a : PhysicalAuxLabels P C) :
    physicalD C L a =
      physicalSharedProduct (physicalSharedPrefix (fun g : {g // small g} => L g.val)) *
      physicalD (fun g : {g // ¬small g} => C g.val) (fun g => L g.val) (fun g => a g.val) := by
  rw [physical_D_group_split small C a L,
    physical_D_empty_cut (fun g : {g // small g} => C g.val)
      (fun g => hC g.val g.property)]

include hC in
theorem physical_coupled_big_coefficient_one
    (Ls Rs : PhysicalMarkLists (fun g : {g // small g} => P g.val) J ell)
    (as : PhysicalAuxLabels (fun g : {g // small g} => P g.val) (fun g => C g.val))
    (Lb Rb : PhysicalMarkLists (fun g : {g // ¬small g} => P g.val) J ell)
    (ab : PhysicalAuxLabels (fun g : {g // ¬small g} => P g.val) (fun g => C g.val)) :
    physicalCoupledBigCoefficient small C ζ (fun _ _ _ => 1) Ls Rs as Lb Rb ab =
      physicalPhase ζ (physicalSharedProduct (physicalSharedPrefix Ls) *
        physicalD (fun g : {g // ¬small g} => C g.val) Lb ab) := by
  simpa only [one_mul] using physical_coupled_big_coefficient_small_empty
    small C hC ζ (fun _ _ _ => 1) Ls Rs as Lb Rb ab

include hC in
theorem physical_coupled_big_coefficient_one_prefix_congr
    (Ls Ls' Rs Rs' : PhysicalMarkLists (fun g : {g // small g} => P g.val) J ell)
    (as as' : PhysicalAuxLabels (fun g : {g // small g} => P g.val) (fun g => C g.val))
    (Lb Rb Rb' : PhysicalMarkLists (fun g : {g // ¬small g} => P g.val) J ell)
    (ab : PhysicalAuxLabels (fun g : {g // ¬small g} => P g.val) (fun g => C g.val))
    (hprefix : physicalSharedPrefix Ls = physicalSharedPrefix Ls') :
    physicalCoupledBigCoefficient small C ζ (fun _ _ _ => 1) Ls Rs as Lb Rb ab =
      physicalCoupledBigCoefficient small C ζ (fun _ _ _ => 1) Ls' Rs' as' Lb Rb' ab := by
  rw [physical_coupled_big_coefficient_one small C hC,
    physical_coupled_big_coefficient_one small C hC, hprefix]

include hC in
theorem physical_bare_pattern_one_small_big (V : G → ℝ)
    (a : PhysicalAuxLabels P C) (L R : PhysicalMarkLists P J ell) :
    physicalBarePatternScalar V C ζ (fun _ _ _ => 1) a L R =
      (if physicalSharedPrefix (fun g : {g // small g} => L g.val) =
          physicalSharedPrefix (fun g : {g // small g} => R g.val)
        then ((∏ g : {g // small g}, 1 / (V g.val) ^ ell : ℝ) : ℂ) else 0) *
      physicalBarePatternScalar (fun g : {g // ¬small g} => V g.val) (fun g => C g.val) 0
        (fun Lb _ ab => physicalPhase ζ
          (physicalSharedProduct (physicalSharedPrefix (fun g : {g // small g} => L g.val)) *
            physicalD (fun g : {g // ¬small g} => C g.val) Lb ab))
        (fun g => a g.val) (fun g => L g.val) (fun g => R g.val) := by
  rw [physical_bare_pattern_small_big_factor small C hC ζ (fun _ _ _ => 1) V a L R]
  congr 2
  funext Lb Rb ab
  exact physical_coupled_big_coefficient_one small C hC ζ _ _ _ Lb Rb ab

end Groups

theorem physical_active_coefficient_one_small_empty
    {N J ell : ℕ} {P : Fin N → Finset ℕ}
    (small : Fin N → Prop) (before after C : Fin N → Finset (Fin J))
    (hC : ∀ g, small g → C g = ∅) (ζ : ℝ)
    (s t : (g : Fin N) → Fin (J + ell) → ↥(P g)) (a : PhysicalAuxLabels P C) :
    physicalActiveCoefficient before after C ζ (fun _ _ _ => 1) s t a =
      if hs : ∀ g, Function.Injective (s g) then
        if _ht : ∀ g, Function.Injective (t g) then
          physicalPhase ζ
            (physicalSharedProduct (physicalSharedPrefix
              (fun g : {g // small g} => physicalActiveMarkLabels before s hs g.val)) *
            physicalD (fun g : {g // ¬small g} => C g.val)
              (fun g => physicalActiveMarkLabels before s hs g.val) (fun g => a g.val))
        else 0
      else 0 := by
  simp only [physicalActiveCoefficient, one_mul]
  split_ifs with hs ht
  · rw [physical_D_small_empty small C hC]
  · rfl
  · rfl

end Bounty
end

section

/- The balanced candidate bound for the actual global prime proxies. -/

open Finset Filter
namespace Bounty

theorem exists_candidate_balanced_logarithmic_prime_proxy_bound {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ)*(r : ℝ)*c = 1) :
    ∃ C : ℝ, 0 < C ∧ ∃ J : ℕ, ∀ S : ℝ, 0 ≤ S →
      ∀ᶠ L : ℝ in atTop, ∀ κ : ℝ, 0 ≤ κ → κ ≤ 1/50 →
      ∀ jStar : ℕ, J < jStar → ∀ (F : Finset (ℕ × ℕ)) (u : ℕ × ℕ → ℕ),
        (∀ v ∈ F, balancedPairWindow κ L v) →
        (∀ v ∈ F, v.1*v.2=2*u v+1) →
        (∑ v ∈ F, candidateCoefficient c L q r jStar (u v)*
          primeLogarithmicProxy L S v.1*primeLogarithmicProxy L S v.2) ≤
          C*(κ+1/L)*candidateCoefficientWindowMass c L q r jStar/L := by
  obtain ⟨C,hC,J,hbound⟩ := exists_candidate_balanced_prime_proxy_bound
    hc hr hq0 hq1 hcenter (by norm_num : (0:ℝ)<1/5)
  refine ⟨C,hC,J,?_⟩
  intro S hS
  filter_upwards [hbound S,eventually_ge_atTop (5:ℝ)] with L hb hL
  intro κ hκ hκup jStar hj F u hF hprod
  have hL1 : 1 ≤ L := by linarith
  have hL0 : 0 < L := by linarith
  have hδ : 0 < L^(-S) := by positivity
  have hδ1 : L^(-S) ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos hL1 (by linarith)
  have hsmall : L^(-S) ≤ (2/5:ℝ)*L/2 := by linarith
  let Y : ℕ → ℝ := fun n => logarithmicCellBase (L^(-S)) (logarithmicCellIndex (L^(-S)) n)
  have hbase (n : ℕ) (hn : Real.exp (((1/2:ℝ)-2*κ)*L) ≤ (n:ℝ)) :
      Real.exp ((1/5:ℝ)*L) ≤ Y n := by
    have hlow : Real.exp ((2/5:ℝ)*L) ≤ (n:ℝ) := by
      apply le_trans _ hn
      apply Real.exp_le_exp.mpr
      exact mul_le_mul_of_nonneg_right (by linarith) hL0.le
    simpa only [show (2/5:ℝ)/2=1/5 by norm_num] using
      logarithmic_cell_base_lower hδ hsmall hlow
  have hh := hb κ hκ hκup jStar hj F u Y Y hF hprod
    (fun v hv => ⟨hbase v.1 (hF v hv).1,hbase v.2 (hF v hv).2.2.1⟩)
  exact hh

end Bounty
end

section

/- Concrete ambient enlargement and prime-mass lower bound with all spectral errors explicit. -/

open Finset Filter Real

namespace Bounty

noncomputable def ambientBuchstabUnbalancedTest (T : Finset ℕ) (μ : ℕ → ℝ)
    (b q L : ℝ) (N : ℕ) : ℝ :=
  ∑ i : Fin N, ∑ v ∈ shiftedPrimeBandPairs T (exp (reciprocalGrid b q N i*L))
    (exp (reciprocalGrid b q N ((i : ℕ)+1)*L)),
      μ (shiftedPairIndex v)*roughTestIndicator (reciprocalGrid b q N i) L v.2

noncomputable def ambientBuchstabBalancedTest (T : Finset ℕ) (μ : ℕ → ℝ)
    (κ L : ℝ) : ℝ :=
  ∑ v ∈ shiftedBalancedPairs T κ L, μ (shiftedPairIndex v)*
    (if v.1.Prime then 1 else 0 : ℝ)*(if v.2.Prime then 1 else 0 : ℝ)

noncomputable def ambientBuchstabUnbalancedProxy (T : Finset ℕ) (μ : ℕ → ℝ)
    (b q L S : ℝ) (N : ℕ) : ℝ :=
  ∑ i : Fin N, ∑ v ∈ shiftedPrimeBandPairs T (exp (reciprocalGrid b q N i*L))
    (exp (reciprocalGrid b q N ((i : ℕ)+1)*L)),
      μ (shiftedPairIndex v)*roughTestLogarithmicProxy (reciprocalGrid b q N i) L S v.2

noncomputable def ambientBuchstabBalancedProxy (T : Finset ℕ) (μ : ℕ → ℝ)
    (κ L S : ℝ) : ℝ :=
  ∑ v ∈ shiftedBalancedPairs T κ L, μ (shiftedPairIndex v)*
    primeLogarithmicProxy L S v.1*primeLogarithmicProxy L S v.2

noncomputable def ambientBuchstabMeshError (T : Finset ℕ) (μ : ℕ → ℝ)
    (b q κ L S : ℝ) (N : ℕ) : ℝ :=
  (∑ i : Fin N, ambientRoughProxyError T μ (reciprocalGrid b q N i) L S
    (exp (reciprocalGrid b q N i*L)) (exp (reciprocalGrid b q N ((i : ℕ)+1)*L)))+
    ambientPrimeProxyError T μ κ L S

theorem shifted_buchstab_mesh_bin_subset_ambient {T : Finset ℕ}
    (hT : ∀ u ∈ T, 0 < u) (b q L : ℝ) (N i : ℕ) :
    shiftedBuchstabMeshBin T b q L N i ⊆
      shiftedPrimeBandPairs T (exp (reciprocalGrid b q N i*L))
        (exp (reciprocalGrid b q N (i+1)*L)) := by
  intro v hv
  have hm := mem_shifted_buchstab_mesh_bin.mp hv
  apply mem_filter.mpr
  exact ⟨shifted_buchstab_pairs_subset_factor_pairs T _ hT
    (mem_shifted_buchstab_unbalanced_pairs.mp hm.1).1, hm.2⟩

theorem shifted_buchstab_balanced_subset_ambient {T : Finset ℕ}
    (hT : ∀ u ∈ T, 0 < u) {b q κ L : ℝ}
    (hwindow : ∀ v ∈ shiftedBuchstabBalancedPairs T b q L, balancedPairWindow κ L v) :
    shiftedBuchstabBalancedPairs T b q L ⊆ shiftedBalancedPairs T κ L := by
  classical
  intro v hv
  apply mem_filter.mpr
  exact ⟨shifted_buchstab_pairs_subset_factor_pairs T _ hT
    (mem_shifted_buchstab_balanced_pairs.mp hv).1, hwindow v hv⟩

theorem ambient_buchstab_tests_eq_proxy_add_error (T : Finset ℕ) (μ : ℕ → ℝ)
    (b q κ L S : ℝ) (N : ℕ) :
    ambientBuchstabUnbalancedTest T μ b q L N+ambientBuchstabBalancedTest T μ κ L =
      ambientBuchstabUnbalancedProxy T μ b q L S N+ambientBuchstabBalancedProxy T μ κ L S+
        ambientBuchstabMeshError T μ b q κ L S N := by
  unfold ambientBuchstabUnbalancedTest ambientBuchstabBalancedTest
    ambientBuchstabUnbalancedProxy ambientBuchstabBalancedProxy ambientBuchstabMeshError
  simp_rw [ambient_rough_test_sum_eq_proxy_add_error T μ _ L S]
  rw [sum_add_distrib, ambient_prime_test_sum_eq_proxy_add_error T μ κ L S]
  ring

theorem weighted_shifted_ambient_mesh_test_upper (T : Finset ℕ) (μ : ℕ → ℝ)
    {b q κ L : ℝ} (hbq : b ≤ q) (hL : 0 ≤ L) {N : ℕ} (hN : 0 < N)
    (hT : ∀ u ∈ T, 0 < u) (hμ : ∀ u ∈ T, 0 ≤ μ u)
    (hbal : ∀ v ∈ shiftedBuchstabBalancedPairs T b q L,
      v.2.Prime ∧ balancedPairWindow κ L v) :
    (∑ u ∈ shiftedRoughSet T (exp (b*L)), μ u) ≤
      (∑ u ∈ (shiftedRoughSet T (exp (b*L))).filter (fun u => (2*u+1).Prime), μ u)+
      ambientBuchstabUnbalancedTest T μ b q L N+ambientBuchstabBalancedTest T μ κ L := by
  have hU : (∑ i : Fin N, ∑ v ∈ shiftedBuchstabMeshBin T b q L N i, μ (shiftedPairIndex v)) ≤
      ambientBuchstabUnbalancedTest T μ b q L N := by
    apply sum_le_sum
    intro i hi
    apply shifted_buchstab_mesh_bin_le_ambient_rough_test hT _ μ
      (shifted_buchstab_mesh_bin_subset_ambient hT b q L N i)
    intro v hv
    exact hμ _ (shifted_prime_band_pair_data T _ _ hv).1
  have hB := shifted_buchstab_balanced_le_ambient_prime_test hT
    (shiftedBalancedPairs T κ L) μ
    (shifted_buchstab_balanced_subset_ambient hT (fun v hv => (hbal v hv).2))
    (fun v hv => hμ _ (shifted_balanced_pair_data T κ L hv).1)
    (fun v hv => (hbal v hv).1)
  change (∑ v ∈ shiftedBuchstabBalancedPairs T b q L, μ (shiftedPairIndex v)) ≤
    ∑ v ∈ shiftedBalancedPairs T κ L, μ (shiftedPairIndex v)*
      ((if v.1.Prime then 1 else 0)*(if v.2.Prime then 1 else 0)) at hB
  simp only [← mul_assoc] at hB
  have h := weighted_shifted_buchstab_mesh_identity T μ hbq hL hN hT
  change (∑ v ∈ shiftedBuchstabBalancedPairs T b q L, μ (shiftedPairIndex v)) ≤
    ambientBuchstabBalancedTest T μ κ L at hB
  linarith

theorem eventually_shifted_ambient_mesh_prime_lower {κ b : ℝ}
    (hκ : 0 < κ) (hκmax : κ ≤ 1/50) (hb : b ≤ (1/2 : ℝ)-κ)
    {N : ℕ} (hN : 0 < N) :
    ∀ᶠ L : ℝ in atTop, ∀ (μ : ℕ → ℝ) (S : ℝ),
      (∀ u ∈ arithmeticProductWindow 1 (exp L), 0 ≤ μ u) →
      (∑ u ∈ shiftedRoughSet (arithmeticProductWindow 1 (exp L)) (exp (b*L)), μ u)-
        ambientBuchstabUnbalancedProxy (arithmeticProductWindow 1 (exp L)) μ b ((1/2 : ℝ)-κ) L S N-
        ambientBuchstabBalancedProxy (arithmeticProductWindow 1 (exp L)) μ κ L S-
        ambientBuchstabMeshError (arithmeticProductWindow 1 (exp L)) μ b ((1/2 : ℝ)-κ) κ L S N ≤
      ∑ u ∈ (shiftedRoughSet (arithmeticProductWindow 1 (exp L)) (exp (b*L))).filter
        (fun u => (2*u+1).Prime), μ u := by
  filter_upwards [eventually_shifted_buchstab_balanced_prime hκ hκmax,
    eventually_ge_atTop (0 : ℝ)] with L hbalanced hL
  intro μ S hμ
  have hT : ∀ u ∈ arithmeticProductWindow 1 (exp L), 0 < u :=
    fun u hu => arithmetic_product_window_one_pos L hu
  have hbal : ∀ v ∈ shiftedBuchstabBalancedPairs (arithmeticProductWindow 1 (exp L))
      b ((1/2 : ℝ)-κ) L, v.2.Prime ∧ balancedPairWindow κ L v := by
    intro v hv
    have hh := mem_shifted_buchstab_balanced_pairs.mp hv
    exact hbalanced (exp (b*L)) v hh.1 hh.2.le
  have h := weighted_shifted_ambient_mesh_test_upper
    (arithmeticProductWindow 1 (exp L)) μ hb hL hN hT hμ hbal
  have heq := ambient_buchstab_tests_eq_proxy_add_error
    (arithmeticProductWindow 1 (exp L)) μ b ((1/2 : ℝ)-κ) κ L S N
  linarith

end Bounty
end

section

/- Exact divisor/cofactor reindexing of full ambient shifted-product pair sums. -/

open Finset

namespace Bounty

theorem shifted_pair_index_of_dvd {p u : ℕ} (hd : p ∣ 2*u+1) :
    shiftedPairIndex (p,(2*u+1)/p) = u := by
  unfold shiftedPairIndex
  dsimp only
  rw [Nat.mul_div_cancel' hd]
  omega

theorem sum_shifted_factor_pairs_first_fiber {M : Type*} [AddCommMonoid M]
    (T : Finset ℕ) {p : ℕ} (hp : 0 < p) (F : ℕ × ℕ → M) :
    (∑ v ∈ (shiftedFactorPairs T).filter (fun v => v.1=p), F v) =
      ∑ u ∈ T.filter (fun u => p ∣ 2*u+1), F (p,(2*u+1)/p) := by
  classical
  have hrec (v : ℕ × ℕ) (hv : v ∈ (shiftedFactorPairs T).filter (fun v => v.1=p)) :
      (p,(2*shiftedPairIndex v+1)/p) = v := by
    obtain ⟨hv,hvp⟩ := mem_filter.mp hv
    have hh := shifted_factor_pair_properties T hv
    apply Prod.ext
    · exact hvp.symm
    · change (2*shiftedPairIndex v+1)/p = v.2
      rw [← hh.2.2.2, hvp, Nat.mul_div_right _ hp]
  apply sum_bij' (fun v _ => shiftedPairIndex v) (fun u _ => (p,(2*u+1)/p))
  · intro v hv
    obtain ⟨hv,hvp⟩ := mem_filter.mp hv
    have hh := shifted_factor_pair_properties T hv
    apply mem_filter.mpr
    refine ⟨hh.2.2.1, ?_⟩
    rw [← hh.2.2.2, hvp]
    exact dvd_mul_right p v.2
  · intro u hu
    obtain ⟨hu,hd⟩ := mem_filter.mp hu
    apply mem_filter.mpr
    exact ⟨(mem_shifted_factor_pairs_iff T _).mpr ⟨u,hu,Nat.mul_div_cancel' hd⟩, rfl⟩
  · exact hrec
  · intro u hu
    exact shifted_pair_index_of_dvd (mem_filter.mp hu).2
  · intro v hv
    exact congrArg F (hrec v hv).symm

theorem sum_shifted_prime_band_pairs {M : Type*} [AddCommMonoid M]
    (T : Finset ℕ) (A B : ℝ) (F : ℕ × ℕ → M) :
    (∑ v ∈ shiftedPrimeBandPairs T A B, F v) =
      ∑ p ∈ primeBand A B, ∑ u ∈ T.filter (fun u => p ∣ 2*u+1), F (p,(2*u+1)/p) := by
  classical
  calc
    _ = ∑ p ∈ primeBand A B,
        ∑ v ∈ (shiftedPrimeBandPairs T A B).filter (fun v => v.1=p), F v :=
      (sum_fiberwise_of_maps_to (fun v hv => (shifted_prime_band_pair_data T A B hv).2.1) F).symm
    _ = _ := by
      apply sum_congr rfl
      intro p hp
      have hfilter : (shiftedPrimeBandPairs T A B).filter (fun v => v.1=p) =
          (shiftedFactorPairs T).filter (fun v => v.1=p) := by
        ext v
        simp only [shiftedPrimeBandPairs, mem_filter]
        constructor
        · exact fun h => ⟨h.1.1,h.2⟩
        · rintro ⟨hv,hvp⟩
          exact ⟨⟨hv,hvp ▸ hp⟩,hvp⟩
      rw [hfilter]
      exact sum_shifted_factor_pairs_first_fiber T (mem_filter.mp hp).2.pos F

theorem ambient_rough_proxy_error_divisor_sum (T : Finset ℕ) (μ : ℕ → ℝ)
    (γ L S A B : ℝ) :
    ambientRoughProxyError T μ γ L S A B =
      ∑ p ∈ primeBand A B, ∑ u ∈ T.filter (fun u => p ∣ 2*u+1),
        μ u*(roughTestIndicator γ L ((2*u+1)/p)-roughTestLogarithmicProxy γ L S ((2*u+1)/p)) := by
  unfold ambientRoughProxyError
  rw [sum_shifted_prime_band_pairs]
  apply sum_congr rfl
  intro p hp
  apply sum_congr rfl
  intro u hu
  simp only [shifted_pair_index_of_dvd (mem_filter.mp hu).2]

theorem sum_shifted_factor_pairs {M : Type*} [AddCommMonoid M]
    (T : Finset ℕ) (F : ℕ × ℕ → M) :
    (∑ v ∈ shiftedFactorPairs T, F v) =
      ∑ u ∈ T, ∑ p ∈ (2*u+1).divisors, F (p,(2*u+1)/p) := by
  classical
  have hprod (u : ℕ) (v : ℕ × ℕ)
      (hv : v ∈ (2*u+1).divisors.image (fun p => (p,(2*u+1)/p))) :
      v.1*v.2 = 2*u+1 := by
    obtain ⟨p,hp,rfl⟩ := mem_image.mp hv
    exact Nat.mul_div_cancel' (Nat.mem_divisors.mp hp).1
  have hd : Set.PairwiseDisjoint (↑T) (fun u =>
      (2*u+1).divisors.image (fun p => (p,(2*u+1)/p))) := by
    intro u hu w hw huw
    apply disjoint_left.mpr
    intro v hvu hvw
    have h1 := hprod u v hvu
    have h2 := hprod w v hvw
    exact huw (by omega)
  unfold shiftedFactorPairs
  rw [sum_biUnion hd]
  apply sum_congr rfl
  intro u hu
  rw [sum_image]
  intro p hp q hq hpq
  exact congrArg Prod.fst hpq

noncomputable def shiftedBalancedDivisors (κ L : ℝ) (u : ℕ) : Finset ℕ := by
  classical
  exact (2*u+1).divisors.filter (fun p => balancedPairWindow κ L (p,(2*u+1)/p))

theorem sum_shifted_balanced_pairs {M : Type*} [AddCommMonoid M]
    (T : Finset ℕ) (κ L : ℝ) (F : ℕ × ℕ → M) :
    (∑ v ∈ shiftedBalancedPairs T κ L, F v) =
      ∑ u ∈ T, ∑ p ∈ shiftedBalancedDivisors κ L u, F (p,(2*u+1)/p) := by
  classical
  simpa only [shiftedBalancedPairs, shiftedBalancedDivisors, sum_filter] using
    sum_shifted_factor_pairs T (fun v => if balancedPairWindow κ L v then F v else 0)

theorem ambient_prime_proxy_error_divisor_sum (T : Finset ℕ) (μ : ℕ → ℝ)
    (κ L S : ℝ) :
    ambientPrimeProxyError T μ κ L S =
      ∑ u ∈ T, ∑ p ∈ shiftedBalancedDivisors κ L u, μ u*
        ((if p.Prime then 1 else 0 : ℝ)*(if ((2*u+1)/p).Prime then 1 else 0 : ℝ)-
          primeLogarithmicProxy L S p*primeLogarithmicProxy L S ((2*u+1)/p)) := by
  classical
  unfold ambientPrimeProxyError
  rw [sum_shifted_balanced_pairs]
  apply sum_congr rfl
  intro u hu
  apply sum_congr rfl
  intro p hp
  have hd : p ∣ 2*u+1 := (Nat.mem_divisors.mp (mem_filter.mp hp).1).1
  simp only [shifted_pair_index_of_dvd hd]

end Bounty
end

