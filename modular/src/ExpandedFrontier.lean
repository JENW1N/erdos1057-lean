/- Exact Mellin-phase separation with the full coarse mask and allocation range retained. -/

open Finset

namespace Bounty

noncomputable def typeIIMellinPhase (ν : ℝ) (n : ℕ) : ℂ :=
  (n : ℂ)^(((2*Real.pi*ν : ℝ) : ℂ)*Complex.I)

theorem typeII_mellin_phase_mul (ν : ℝ) (e h : ℕ) :
    typeIIMellinPhase ν (e*h) = typeIIMellinPhase ν e*typeIIMellinPhase ν h := by
  unfold typeIIMellinPhase
  simpa only [Nat.cast_mul,Complex.ofReal_natCast] using
    Complex.mul_cpow_ofReal_nonneg (Nat.cast_nonneg e : (0 : ℝ) ≤ e)
      (Nat.cast_nonneg h : (0 : ℝ) ≤ h) (((2*Real.pi*ν : ℝ) : ℂ)*Complex.I)

theorem typeII_mellin_phase_norm (ν : ℝ) {n : ℕ} (hn : 0 < n) :
    ‖typeIIMellinPhase ν n‖ = 1 := by
  unfold typeIIMellinPhase
  change ‖((n : ℝ) : ℂ)^(((2*Real.pi*ν : ℝ) : ℂ)*Complex.I)‖ = 1
  rw [Complex.norm_cpow_eq_rpow_re_of_pos (by exact_mod_cast hn)]
  simp

theorem finite_mellin_divisor_typeII_masked (T M N H S : Finset ℕ)
    (aE α β aH : ℕ → ℂ) (L X ν : ℝ)
    (hα : ∀ m, m ∉ M → α m = 0) (hβ : ∀ n, n ∉ N → β n = 0) :
    (∑ e ∈ T, ∑ h ∈ H, aE e*aH h*candidateBoxFiniteTest L X S
      (fun u => typeIIMellinPhase ν u*∑ m ∈ (2*u+1).divisors, α m*β ((2*u+1)/m)) e h) =
      ∑ e ∈ T.filter (fun e : ℕ => X/L^88 ≤ (e : ℝ) ∧ (e : ℝ) ≤ X), ∑ n ∈ N,
        (aE e*typeIIMellinPhase ν e)*β n*
          typeIIInnerSum M H α (fun h => if e*h ∈ S then aH h*typeIIMellinPhase ν h else 0) e n := by
  classical
  rw [sum_filter]
  apply sum_congr rfl
  intro e he
  by_cases hr : X/L^88 ≤ (e : ℝ) ∧ (e : ℝ) ≤ X
  · simp only [candidateBoxFiniteTest,hr,true_and,if_true]
    have hrow := congrArg (fun z : ℂ => (aE e*typeIIMellinPhase ν e)*z)
      (shifted_divisor_typeII_row e M N H α β
        (fun h => if e*h ∈ S then aH h*typeIIMellinPhase ν h else 0) hα hβ)
    calc
      _ = (aE e*typeIIMellinPhase ν e)*
          ∑ h ∈ H, (if e*h ∈ S then aH h*typeIIMellinPhase ν h else 0)*
            ∑ m ∈ (2*e*h+1).divisors, α m*β ((2*e*h+1)/m) := by
        rw [mul_sum]
        apply sum_congr rfl
        intro h hh
        by_cases hs : e*h ∈ S
        · simp only [hs,if_true,typeII_mellin_phase_mul]
          simp only [mul_assoc]
          ring
        · simp only [hs,if_false,mul_zero,zero_mul]
      _ = _ := by simpa only [mul_sum,mul_assoc] using hrow
  · simp only [candidateBoxFiniteTest,hr,false_and,if_false,mul_zero,sum_const_zero]

theorem finite_mellin_divisor_typeII_compatible (T M N H S : Finset ℕ)
    (aE α β aH : ℕ → ℂ) (L X ν : ℝ)
    (hα : ∀ m, m ∉ M → α m = 0) (hβ : ∀ n, n ∉ N → β n = 0)
    (hcompat : ∀ e ∈ T, X/L^88 ≤ (e : ℝ) ∧ (e : ℝ) ≤ X →
      ∀ n ∈ N, ∀ m ∈ M, ∀ h ∈ H, m*n=2*e*h+1 → e*h ∈ S) :
    (∑ e ∈ T, ∑ h ∈ H, aE e*aH h*candidateBoxFiniteTest L X S
      (fun u => typeIIMellinPhase ν u*∑ m ∈ (2*u+1).divisors, α m*β ((2*u+1)/m)) e h) =
      ∑ e ∈ T.filter (fun e : ℕ => X/L^88 ≤ (e : ℝ) ∧ (e : ℝ) ≤ X), ∑ n ∈ N,
        (aE e*typeIIMellinPhase ν e)*β n*
          typeIIInnerSum M H α (fun h => aH h*typeIIMellinPhase ν h) e n := by
  rw [finite_mellin_divisor_typeII_masked T M N H S aE α β aH L X ν hα hβ]
  apply sum_congr rfl
  intro e he
  obtain ⟨he,hr⟩ := mem_filter.mp he
  apply sum_congr rfl
  intro n hn
  rw [typeII_inner_coarse_mask_eq M H S α (fun h => aH h*typeIIMellinPhase ν h) e n
    (hcompat e he hr n hn)]

end Bounty
end

section

/- Actual fixed-skeleton ghost stages pay exactly their original selected-child atom costs. -/

open Finset Classical

namespace Bounty

section Ghost
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
    [∀ g, DecidableEq (P g)] {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K))) (u : Fin steps.length) (j : J)
    (htag : steps.get u = some (.inl j))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P))
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))
    (sk : CoupledGhostSkeleton M B s)
    (μ : ∀ g, P g → ℝ) (q ρ v : ℝ) (V η : Fin N → ℝ)

theorem full_mixed_common_ghost_skeleton_stage_le
    (hη : ∀ g, 0 ≤ η g) (hμ : ∀ g p, 0 ≤ μ g p) (hμatom : ∀ g p, μ g p ≤ η g) (hv : 0 ≤ v) :
    let d := fullMixedCommonSelectedCount M B steps code u
    (∑ births : CoupledGhostSamples M B s sk,
      if birthForestStageCondition
        (fullMixedCommonIndexStage M B steps) u.succ
        (fullMixedCommonHistoryWrite n S B A Δ D steps u s
          (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inl j)) htag s
            ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩)) history) code then
        |coupledGhostJointEventWeight
          (fun g => physicalGhostRetention (n g) q ρ)
          (fun g => physicalGhostTermination (n g) q ρ)
          (fun g => physicalGhostBirth (n g) q ρ (V g))
          (fun g => unrestrictedResidueWeight (μ g)) M B s
          ((coupledGhostSkeletonEquiv M B s).symm ⟨sk, births⟩)| *
        productLengthLyapunov v
          (coupledGhostJointEventTarget M B s ((coupledGhostSkeletonEquiv M B s).symm ⟨sk, births⟩))
      else 0) ≤
    if ∀ g, d g ≤ (sk g).1.val then
      coupledGhostSkeletonAbsMass
        (fun g => physicalGhostRetention (n g) q ρ)
        (fun g => physicalGhostTermination (n g) q ρ) M B s sk *
        v ^ (∑ g, boundedGhostSkeletonOutputCount (M g) B (s g) (sk g).1 (sk g).2) *
        ∏ g, (|(1 - q) * V g / ρ| * η g) ^ d g *
          (|(1 - q) * V g / ρ| * ∑ p, μ g p) ^ ((sk g).1.val - d g)
    else 0 := by
  dsimp only
  let ord := fullMixedCommonGhostSampleOrder S B j steps u htag s sk
  let f := fullMixedCommonGhostSampleEmbedding S B j steps u htag s sk
  let owner := fullMixedCommonIndexStage M B steps
  let d := fullMixedCommonSelectedCount M B steps code u
  let root := fun g => |(1 - q) * V g / ρ| * ∑ p, μ g p
  let atom := fun g => |(1 - q) * V g / ρ| * η g
  rw [full_mixed_common_ghost_skeleton_stage_sum n S B A Δ D steps u s history code j htag sk]
  by_cases hs : birthForestStageSupport owner u.succ (ownerSampleSupport (f ∘ ord) owner u.succ history) code
  · dsimp only [owner, f, ord, Function.comp] at hs
    erw [if_pos hs]
    have hd : ∀ g, (univ.filter (fun i : Fin (sk g).1.val => code (f ⟨g, i⟩) ≠ none)).card = d g := by
      intro g
      exact owner_supported_selected_fiber_card (fun g => Fin (sk g).1.val) ord f owner u.succ
        (fun i => fullMixedCommonBirthGroup M B steps (fullMixedCommonBirthOrder M B steps i))
        (full_mixed_common_ghost_sample_owner S B j steps u htag s sk)
        (full_mixed_common_ghost_sample_group S B j steps u htag s sk) code history hs g
    have hcap : ∀ g, d g ≤ (sk g).1.val := by
      intro g
      rw [← hd g]
      exact (card_filter_le _ _).trans_eq (by simp only [card_univ, Fintype.card_fin])
    rw [if_pos hcap]
    have hvalid := owner_sample_support_anchors_valid (f ∘ ord)
      (full_mixed_common_ghost_sample_strictMono S B j steps u htag s sk)
      owner (full_mixed_common_index_stage_monotone M B steps) u.succ
      (fun i => full_mixed_common_ghost_sample_owner S B j steps u htag s sk (ord i)) history code hs
    have hcost := grouped_join_restricted_forest_cost_eq (fun g => Fin (sk g).1.val)
      ord f code history root atom d hvalid hd
    have hb := coupled_ghost_forest_continuation_le n μ q ρ V M B s sk ord
      (restrictedBirthCode (f ∘ ord) code) (fun i => (restrictedBirthAnchors (f ∘ ord) code history i).join)
      η hη hμ hμatom v 1 hv zero_le_one
      (fun births => productLengthLyapunov v
        (coupledGhostJointEventTarget M B s ((coupledGhostSkeletonEquiv M B s).symm ⟨sk, births⟩)))
      (fun _ => by simp only [one_mul]; exact le_rfl)
    rw [one_mul] at hb
    dsimp only [root, atom] at hcost
    refine le_trans (le_of_eq ?_) (le_trans hb (le_of_eq ?_))
    · apply sum_congr rfl
      intro births _
      dsimp only [f, ord, Function.comp]
      split_ifs <;> first | rfl | contradiction
    · congr 1
      convert hcost using 1
      · apply prod_congr rfl
        intro i _
        cases restrictedBirthCode (f ∘ ord) code i <;>
          cases (restrictedBirthAnchors (f ∘ ord) code history i).join <;> rfl
      · simp only [Fintype.card_fin, d]
  · dsimp only [owner, f, ord, Function.comp] at hs
    erw [if_neg hs]
    split_ifs
    · exact mul_nonneg
        (mul_nonneg (coupled_ghost_skeleton_abs_mass_nonneg _ _ _ _ _ _) (pow_nonneg hv _))
        (prod_nonneg fun g _ => mul_nonneg
          (pow_nonneg (mul_nonneg (abs_nonneg _) (hη g)) _)
          (pow_nonneg (mul_nonneg (abs_nonneg _) (sum_nonneg fun p _ => hμ g p)) _))
    · exact le_rfl

end Ghost
end Bounty
end

section

/- Actual fixed-skeleton full-edge stages pay exactly their original selected-child atom costs. -/

open Finset Classical

namespace Bounty

section Edge
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
    [∀ g, DecidableEq (P g)] {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K))) (u : Fin steps.length) (k : K)
    (htag : steps.get u = some (.inr k))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P))
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))
    (sk : FullActiveEdgeSkeleton n (S k) B (A k) (Δ k) (D k) s)
    (ω : ∀ c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (ρ v : ℝ) (V η : Fin N → ℝ)

theorem full_mixed_common_edge_skeleton_stage_le
    (hη : ∀ g, 0 ≤ η g) (hμ : ∀ g p, 0 ≤ μ g p) (hμatom : ∀ g p, μ g p ≤ η g) (hv : 0 ≤ v) :
    let d := fullMixedCommonSelectedCount M B steps code u
    (∑ fresh : FullActiveEdgeSamples n (S k) B (A k) (Δ k) (D k) s sk,
      if birthForestStageCondition
        (fullMixedCommonIndexStage M B steps) u.succ
        (fullMixedCommonHistoryWrite n S B A Δ D steps u s
          (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inr k)) htag s
            ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm ⟨sk, fresh⟩)) history) code then
        |fullActiveEdgeEventWeight n (S k) B (A k) (Δ k) (D k) ω μ ρ V s ((fullActiveEdgeSkeletonEquiv n (S k) B (A k) (Δ k) (D k) s).symm ⟨sk, fresh⟩)| * productLengthLyapunov v (fullActiveEdgeEventTarget n (S k) B (A k) (Δ k) (D k) s ((fullActiveEdgeSkeletonEquiv n (S k) B (A k) (Δ k) (D k) s).symm ⟨sk, fresh⟩))
      else 0) ≤
    if ∀ g, d g ≤ ((S k g)ᶜ.card - (sk.2 g).2.1.card) then
      fullActiveEdgeSkeletonAbsMass n (S k) B (A k) (Δ k) (D k) ω ρ V s sk * v ^ (∑ g, unrestrictedSkeletonOutputCount (n g)
          (Δ k (productActiveMemorySplit (S k) B s).1 sk.1 g)
          (D k (productActiveMemorySplit (S k) B s).1 sk.1 g)
          (S k g)ᶜ.card B ((productActiveMemorySplit (S k) B s).2 g) (sk.2 g)) *
        ∏ g, η g ^ d g * (∑ p, μ g p) ^ (((S k g)ᶜ.card - (sk.2 g).2.1.card) - d g)
    else 0 := by
  dsimp only
  let ord := fullMixedCommonEdgeSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk
  let f := fullMixedCommonEdgeSampleEmbedding n S B k steps u htag (A k) (Δ k) (D k) s sk
  let owner := fullMixedCommonIndexStage M B steps
  let d := fullMixedCommonSelectedCount M B steps code u
  rw [full_mixed_common_edge_skeleton_stage_sum n S B A Δ D steps u s history code k htag sk]
  by_cases hs : birthForestStageSupport owner u.succ (ownerSampleSupport (f ∘ ord) owner u.succ history) code
  · dsimp only [owner, f, ord, Function.comp] at hs
    erw [if_pos hs]
    have hd : ∀ g, (univ.filter (fun i : {i : Fin (S k g)ᶜ.card // i ∉ (sk.2 g).2.1} => code (f ⟨g, i⟩) ≠ none)).card = d g := by
      intro g
      exact owner_supported_selected_fiber_card (fun g => {i : Fin (S k g)ᶜ.card // i ∉ (sk.2 g).2.1}) ord f owner u.succ
        (fun i => fullMixedCommonBirthGroup M B steps (fullMixedCommonBirthOrder M B steps i))
        (full_mixed_common_edge_sample_owner n S B k steps u htag (A k) (Δ k) (D k) s sk)
        (full_mixed_common_edge_sample_group n S B k steps u htag (A k) (Δ k) (D k) s sk) code history hs g
    have hcap : ∀ g, d g ≤ ((S k g)ᶜ.card - (sk.2 g).2.1.card) := by
      intro g
      rw [← hd g]
      have h := card_filter_le (s := (univ : Finset ({i : Fin (S k g)ᶜ.card // i ∉ (sk.2 g).2.1})))
        (p := fun i => code (f ⟨g, i⟩) ≠ none)
      simpa only [card_univ, Fintype.card_subtype_compl, Fintype.card_fin, Fintype.card_coe] using h
    rw [if_pos hcap]
    have hvalid := owner_sample_support_anchors_valid (f ∘ ord)
      (full_mixed_common_edge_sample_strictMono n S B k steps u htag (A k) (Δ k) (D k) s sk)
      owner (full_mixed_common_index_stage_monotone M B steps) u.succ
      (fun i => full_mixed_common_edge_sample_owner n S B k steps u htag (A k) (Δ k) (D k) s sk (ord i)) history code hs
    have hb := full_edge_grouped_restricted_continuation_le n (S k) B (A k) (Δ k) (D k) ω μ ρ V s sk ord
      f code history d hvalid hd
      η hη hμ hμatom v 1 hv zero_le_one
      (fun fresh => productLengthLyapunov v (fullActiveEdgeEventTarget n (S k) B (A k) (Δ k) (D k) s ((fullActiveEdgeSkeletonEquiv n (S k) B (A k) (Δ k) (D k) s).symm ⟨sk, fresh⟩)))
      (fun _ => by simp only [one_mul]; exact le_rfl)
    rw [one_mul] at hb
    refine le_trans (le_of_eq ?_) hb
    apply sum_congr rfl
    intro fresh _
    dsimp only [f, ord, Function.comp]
    split_ifs <;> first | rfl | contradiction
  · dsimp only [owner, f, ord, Function.comp] at hs
    erw [if_neg hs]
    split_ifs
    · exact mul_nonneg
        (mul_nonneg (full_active_edge_skeleton_abs_mass_nonneg _ _ _ _ _ _ _ _ _ _ _) (pow_nonneg hv _))
        (prod_nonneg fun g _ => mul_nonneg (pow_nonneg (hη g) _)
          (pow_nonneg (sum_nonneg fun p _ => hμ g p) _))
    · exact le_rfl

end Edge
end Bounty
end

section

/- The high-frequency estimate on literal real-endpoint rough bands. -/

open Finset Filter

namespace Bounty

theorem eventually_long_roughBand_harmonic_power_bound {a : ℝ} (ha : 0 < a)
    (T Bsave : ℝ) :
    ∃ B0 : ℝ, 0 < B0 ∧ ∀ᶠ L : ℝ in atTop,
      ∀ Y : ℝ, Real.exp (a*L) ≤ Y →
      ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q), (q : ℝ) ≤ L^T →
      ∀ u : ℝ, L^B0 ≤ |u| → |u| ≤ (Real.exp L)^2 →
      ∀ A B : ℝ, Y ≤ A → A ≤ B → B ≤ 2*Y →
        ‖∑ i ∈ roughBand A B (Real.exp (Real.sqrt L)),
            harmonicMellinWeight u i*χ (i : ZMod q)‖ ≤ L^(-Bsave) := by
  obtain ⟨B0,hB0,hbound⟩ := eventually_long_rough_harmonic_power_bound ha T Bsave
  refine ⟨B0,hB0,?_⟩
  filter_upwards [hbound] with L hL
  intro Y hY q hqInst χ hqT u hu huX A B hYA hAB hBY
  have hA : 0 ≤ A := ((Real.exp_pos _).trans_le (hY.trans hYA)).le
  have hB : 0 ≤ B := hA.trans hAB
  exact hL Y hY q χ hqT u hu huX ⌊A⌋₊ ⌊B⌋₊ (Nat.floor_le_floor hAB)
    (hYA.trans (Nat.lt_floor_add_one A).le) ((Nat.floor_le hB).trans hBY)

end Bounty
end

section

/- The common forest's actual edge multiplier is an allowed observable of
the physical mixed coefficient row. Original performed guards are retained. -/

open Finset Classical
namespace Bounty

section Mixed
variable {I K S : Type} [Fintype S] {N J ell B : ℕ}
  {Ps : S → Finset ℕ} {P : Fin N → Finset ℕ}
  [∀ g (p : P g), NeZero p.val]
  (C : Fin N → Finset (Fin J)) (k : ℤ)
  (steps : List (Option (I ⊕ K)))
  (code : BirthForestCode
    (Fintype.card (FullMixedCommonBirthAddress (fun _ : Fin N => J + ell) B steps)))
  (θ : (Fin (Fintype.card (FullMixedCommonBirthAddress (fun _ : Fin N => J + ell) B steps)) ×
    Fin (Fintype.card (FullMixedCommonBirthAddress (fun _ : Fin N => J + ell) B steps))) → ℝ)
  (encode : ((g : Fin N) × P g) → ℤ)
  (i : Fin steps.length) (tag : K) (hi : steps.get i = some (.inr tag))

noncomputable def physicalMixedCommonForestObservable :
    PhysicalBareResidueState Ps J ell → PhysicalBareResidueState Ps J ell →
    (∀ g, Fin (J + ell) → P g) → (∀ g, Fin (J + ell) → P g) →
    (∀ g, EdgeDrawObservation (P g) (physicalFullSharedIndices (ell := ell) (C g))ᶜ.card) → ℂ :=
  fun _ _ _ _ draw => commonForestEdgeOperationObservation
    (fun (_ : K) g => physicalFullSharedIndices (ell := ell) (C g)) B
    steps code θ encode i tag hi draw

noncomputable def physicalMixedCommonForestEventPhase
    (a : PhysicalAuxLabels P C)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B))
    (e : PhysicalMixedCoefficientEvent C k a s) : ℂ :=
  commonForestObservedMultiplier (fun _ : Fin N => J + ell) B steps code θ encode
    (commonForestEventLabels (fun _ : Fin N => J + ell) B steps i
      (fun z => fullMixedCommonEventBirthLabel (fun g (p : P g) => p.val)
        (fun (_ : K) g => physicalFullSharedIndices (ell := ell) (C g)) B
        (fun _ _ => Unit)
        (fun _ c _ g => physicalMixedEdgeDelta C k (physicalSharedPrefix s.1.2) c a g)
        (fun _ c _ g => physicalMixedEdgeD C (physicalSharedPrefix s.1.2) c a g)
        (some (.inr tag)) s.2 e.2 (hi ▸ z))) (some i)

omit [∀ g (p : P g), NeZero p.val] in
theorem physical_mixed_common_forest_eq_observable
    (a : PhysicalAuxLabels P C)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B))
    (e : PhysicalMixedCoefficientEvent C k a s) :
    physicalMixedCommonForestEventPhase C k steps code θ encode i tag hi a s e =
      physicalMixedCoefficientObservablePhase C k a
        (physicalMixedCommonForestObservable C steps code θ encode i tag hi) s e := by
  unfold physicalMixedCommonForestEventPhase
  change _ = commonForestObservedMultiplier (fun _ : Fin N => J + ell) B steps code θ encode
    (commonForestEventLabels (fun _ : Fin N => J + ell) B steps i
      (fun z => commonForestEdgeLabels
        (fun (_ : K) g => physicalFullSharedIndices (ell := ell) (C g)) B tag
        (fun g => ⟨(e.2.2 g).1, (e.2.2 g).2.1, (e.2.2 g).2.2.2⟩) (hi ▸ z))) (some i)
  apply congrArg (fun label => commonForestObservedMultiplier
    (fun _ : Fin N => J + ell) B steps code θ encode label (some i))
  apply congrArg (commonForestEventLabels (fun _ : Fin N => J + ell) B steps i)
  funext z
  exact congrArg (fun label => label (hi ▸ z))
    (full_mixed_common_edge_labels_eq_observation
      (fun (_ : K) g => physicalFullSharedIndices (ell := ell) (C g)) B tag
      (fun g (p : P g) => p.val) (fun _ _ => Unit)
      (fun _ c _ g => physicalMixedEdgeDelta C k (physicalSharedPrefix s.1.2) c a g)
      (fun _ c _ g => physicalMixedEdgeD C (physicalSharedPrefix s.1.2) c a g) s.2 e.2)

omit [Fintype S] [∀ g (p : P g), NeZero p.val] in
theorem physical_mixed_common_forest_observable_norm_le_one
    (s t : PhysicalBareResidueState Ps J ell)
    (x y : ∀ g, Fin (J + ell) → P g)
    (draw : ∀ g, EdgeDrawObservation (P g) (physicalFullSharedIndices (ell := ell) (C g))ᶜ.card) :
    ‖physicalMixedCommonForestObservable C steps code θ encode i tag hi s t x y draw‖ ≤ 1 :=
  common_forest_edge_operation_observation_norm_le_one _ _ _ _ _ _ _ _ _ _

omit [∀ g (p : P g), NeZero p.val] in
theorem physical_mixed_common_forest_event_norm_le_one
    (a : PhysicalAuxLabels P C)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B))
    (e : PhysicalMixedCoefficientEvent C k a s) :
    ‖physicalMixedCommonForestEventPhase C k steps code θ encode i tag hi a s e‖ ≤ 1 :=
  common_forest_observed_multiplier_norm_le_one _ _ _ _ _ _ _ _

theorem physical_mixed_common_forest_event_reindex
    (a : PhysicalAuxLabels P C)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B))
    (τ : ∀ g, Equiv.Perm (Fin (s.2 g).2.1.val))
    (e : PhysicalMixedCoefficientEvent C k a s) :
    physicalMixedCommonForestEventPhase C k steps code θ encode i tag hi a
      (s.1, productMemoryReindex s.2 τ) (physicalMixedCoefficientReindex C k a s τ e) =
      physicalMixedCommonForestEventPhase C k steps code θ encode i tag hi a s e := by
  rw [physical_mixed_common_forest_eq_observable, physical_mixed_common_forest_eq_observable]
  exact physical_mixed_coefficient_observable_reindex C k a _ s τ e

end Mixed
end Bounty
end

section

/- Both original shared-overlap branches combine into the marked-pair
approximation. The coefficient is identified only on the good event. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_whole_pair_comparison {G : Type*} [Fintype G] [dG : DecidableEq G]
    (P : G → Finset ℕ) {J ell : ℕ} (C : G → Finset (Fin J))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    {q : ℝ} (hq0 : 0 < q) (hq1 : q ≤ 1)
    (aux : PhysicalAuxLabels P C) {w z : ℕ} (hw : 0 < w) (hz : 0 < z)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → ℂ)
    (b : GroupMarkedLists P (fun g => ell + (C g).card) →
      GroupMarkedLists P (fun g => ell + (C g).card) → ℂ)
    {H : ℝ} (hH : 0 ≤ H)
    (hK : ∀ L R, physicalSharedCompatible C L R → ‖K L R‖ ≤ H)
    (hb : ∀ (u : GroupMarkedListsAt P (fun g => ell + (C g).card) (w : ℤ))
      (v : GroupMarkedListsAt P (fun g => ell + (C g).card) (z : ℤ)), ‖b u.val v.val‖ ≤ H)
    (hgood : ∀ L R, physicalSharedCompatible C L R →
      (∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z) →
      K L R = b (physicalGroupUnsharedEmbedding C L) (physicalGroupUnsharedEmbedding C R)) :
    ‖physicalFullPairCorrelation P C V q w z K -
      (markedDivisorWeight univ P q V (fun g => ell + (C g).card) (w : ℤ) : ℂ) *
      (markedDivisorWeight univ P q V (fun g => ell + (C g).card) (z : ℤ) : ℂ) *
      groupMarkedAverage P (fun g => ell + (C g).card) (w : ℤ) (fun u =>
        groupMarkedAverage P (fun g => ell + (C g).card) (z : ℤ) (b u))‖ ≤
      (markedDivisorWeight univ P q V (fun g => ell + (C g).card) (w : ℤ) *
        markedDivisorWeight univ P q V (fun g => ell + (C g).card) (z : ℤ)) *
      ((∑ g, (J - (C g).card : ℕ) *
          (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) / (V g * Pmin)) *
        (H + H / q ^ (2 * ∑ g : G, (J - (C g).card)))) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  let W0 := markedDivisorWeight univ P q V (fun g => ell + (C g).card) (w : ℤ)
  let W1 := markedDivisorWeight univ P q V (fun g => ell + (C g).card) (z : ℤ)
  let δ : ℝ := ∑ g, (J - (C g).card : ℕ) *
    (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) / (V g * Pmin)
  let T : ℂ := (W0 : ℂ) * (W1 : ℂ) *
    groupMarkedAverage P (fun g => ell + (C g).card) (w : ℤ) (fun u =>
      groupMarkedAverage P (fun g => ell + (C g).card) (z : ℤ) (b u))
  let Kg : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → ℂ := fun L R =>
    if ∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z then K L R else 0
  let Kb : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → ℂ := fun L R =>
    if ¬(∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z) then K L R else 0
  have hsplit : physicalFullPairCorrelation P C V q w z K =
      physicalFullPairCorrelation P C V q w z Kg + physicalFullPairCorrelation P C V q w z Kb := by
    rw [← physical_full_pair_add]
    apply physical_full_pair_congr
    intro L R _
    dsimp only [Kg, Kb]
    by_cases ha : ∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z
    · simp only [if_pos ha, if_neg (not_not.mpr ha), add_zero]
    · simp only [if_neg ha, if_pos ha, zero_add]
  have hg : ‖physicalFullPairCorrelation P C V q w z Kg - T‖ ≤ (W0 * W1) * (δ * H) := by
    have he : physicalFullPairCorrelation P C V q w z Kg =
        physicalFullPairCorrelation P C V q w z (fun L R =>
          if ∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z then
            b (physicalGroupUnsharedEmbedding C L) (physicalGroupUnsharedEmbedding C R) else 0) := by
      apply physical_full_pair_congr
      intro L R hLR
      dsimp only [Kg]
      by_cases ha : ∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z
      · rw [if_pos ha, if_pos ha, hgood L R hLR ha]
      · rw [if_neg ha, if_neg ha]
    rw [he]
    exact physical_good_pair_comparison P C hprime hdis V hV hMass hq0.le aux hw hz hPmin hp b hH hb
  have hbad : ‖physicalFullPairCorrelation P C V q w z Kb‖ ≤
      (W0 * W1) * (δ * (H / q ^ (2 * ∑ g : G, (J - (C g).card)))) := by
    simpa only [physicalFullPairCorrelation, Kb, mul_ite, mul_zero] using
      physical_bad_original_pair_norm_le P C hprime hdis V hV hMass hq0 hq1
        aux hw hz hPmin hp K hH hK
  change ‖physicalFullPairCorrelation P C V q w z K - T‖ ≤
    (W0 * W1) * (δ * (H + H / q ^ (2 * ∑ g : G, (J - (C g).card))))
  calc
    _ = ‖(physicalFullPairCorrelation P C V q w z Kg - T) +
        physicalFullPairCorrelation P C V q w z Kb‖ := by
      rw [hsplit]
      congr 1
      ring
    _ ≤ ‖physicalFullPairCorrelation P C V q w z Kg - T‖ +
        ‖physicalFullPairCorrelation P C V q w z Kb‖ := norm_add_le _ _
    _ ≤ (W0 * W1) * (δ * H) +
        (W0 * W1) * (δ * (H / q ^ (2 * ∑ g : G, (J - (C g).card)))) := add_le_add hg hbad
    _ = _ := by ring

end Bounty
end

section

/- Literal retained prime coefficients with all auxiliary exclusions and the
three logarithmic phases, before and after removal of shared coordinates. -/

open Finset
open scoped Classical
namespace Bounty

section Coefficient
variable {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
  (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
  (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ)
  (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
  (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
  (a b : ℝ) (w z : ℕ)

noncomputable def physicalOriginalPrimePairCoefficient
    (L R : PhysicalMarkLists P J ell) : ℂ :=
  let C := repeatedBigPrimePatternCut probes r t i
  let kept := fun U : Finset (RepeatedBigFlatIndex G J ell) =>
    primeProductRetainedCells (fun j : U => P j.val.1) (fun j => V j.val.1) h ξ
  if physicalListAdmissible C aux L R then
    (repeatedBigPrimePatternWeight probes r t i *
      repeatedBigPrimePatternKernel P V probes r t hrt Q h kept i
        (fun g s => L g s) (fun g s => R g s) aux) *
      physicalPhase a (physicalSharedFactor C L * w) *
      physicalPhase b (physicalSharedFactor C L * z) *
      physicalPhase (-(a+b)) (physicalD C L aux)
  else 0

noncomputable def physicalUnsharedPrimePairCoefficient
    (u v : GroupMarkedLists P (fun g => ell + (repeatedBigPrimePatternCut probes r t i g).card)) : ℂ :=
  let C := repeatedBigPrimePatternCut probes r t i
  let kept := fun U : Finset (RepeatedBigFlatIndex G J ell) =>
    primeProductRetainedCells (fun j : U => P j.val.1) (fun j => V j.val.1) h ξ
  if physicalUnsharedAuxAvoids C aux u ∧ physicalUnsharedAuxAvoids C aux v then
    (repeatedBigPrimePatternWeight probes r t i *
      physicalUnsharedPrimePatternKernel P V probes r t hrt Q h kept i u v aux) *
      physicalPhase a w * physicalPhase b z * physicalPhase (-(a+b)) (physicalFreeFactor C aux)
  else 0

theorem physical_original_prime_pair_coefficient_norm_le (hξ : 0 < ξ)
    (L R : PhysicalMarkLists P J ell) :
    ‖physicalOriginalPrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w z L R‖ ≤
      repeatedBigPrimePatternBound probes r t Q ξ i := by
  unfold physicalOriginalPrimePairCoefficient
  dsimp only
  split_ifs
  · rw [physical_prime_pattern_kernel_factors_unshared]
    simpa only [norm_mul, physical_phase_norm, mul_one] using
      physical_unshared_weighted_prime_pattern_norm_le P V probes r t hrt Q h ξ hξ i
        (physicalGroupUnsharedEmbedding (repeatedBigPrimePatternCut probes r t i) L)
        (physicalGroupUnsharedEmbedding (repeatedBigPrimePatternCut probes r t i) R) aux
  · simpa only [norm_zero] using repeated_big_prime_pattern_bound_nonneg probes r t Q ξ i

theorem physical_unshared_prime_pair_coefficient_norm_le (hξ : 0 < ξ)
    (u v : GroupMarkedLists P (fun g => ell + (repeatedBigPrimePatternCut probes r t i g).card)) :
    ‖physicalUnsharedPrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w z u v‖ ≤
      repeatedBigPrimePatternBound probes r t Q ξ i := by
  unfold physicalUnsharedPrimePairCoefficient
  dsimp only
  split_ifs
  · exact physical_unshared_prime_three_phase_norm_le P V probes r t hrt Q h ξ hξ
      i u v aux a b (-(a+b)) w z _
  · simpa only [norm_zero] using repeated_big_prime_pattern_bound_nonneg probes r t Q ξ i

theorem physical_prime_pair_coefficient_eq_of_good_shared
    (hprime : ∀ g p, p ∈ P g → p.Prime) (hw : 0 < w) (hz : 0 < z)
    (L R : PhysicalMarkLists P J ell)
    (hLR : physicalSharedCompatible (repeatedBigPrimePatternCut probes r t i) L R)
    (hgood : ∀ g j, physicalSharedAux (repeatedBigPrimePatternCut probes r t i) L g j ∉
      physicalSharedForbidden (repeatedBigPrimePatternCut probes r t i) aux g w z) :
    physicalOriginalPrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w z L R =
      physicalUnsharedPrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w z
        (physicalGroupUnsharedEmbedding (repeatedBigPrimePatternCut probes r t i) L)
        (physicalGroupUnsharedEmbedding (repeatedBigPrimePatternCut probes r t i) R) := by
  unfold physicalOriginalPrimePairCoefficient physicalUnsharedPrimePairCoefficient
  dsimp only
  rw [physical_list_admissible_iff_of_good_shared _ aux L R w z hLR hgood]
  split_ifs
  · rw [physical_prime_pattern_kernel_factors_unshared, physical_D_shared_free]
    have hd : 0 < physicalFreeFactor (repeatedBigPrimePatternCut probes r t i) aux :=
      prod_pos (fun g _ => prod_pos (fun j _ => (hprime g _ (aux g j).property).pos))
    have he := physical_shared_phase_cancel a b
      (physical_shared_factor_pos (repeatedBigPrimePatternCut probes r t i) L hprime) hw hz hd
    simp only [mul_assoc] at he ⊢
    rw [he]
  · rfl

end Coefficient
end Bounty
end

section

/- Cutoff guards are removed only on the nonzero support of the actual outer test. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_fixed_root_full_pair_of_coverage
    {G : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (V : G → ℝ) (C : G → Finset (Fin J)) (q a b : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (positions W : Finset ℤ)
    (hW : ∀ L : PhysicalMarkLists P J ell, ∀ n ∈ positions,
      n / physicalSharedFactor C L ∈ W)
    (f g : ℤ → ℂ) (Ψ : ℝ → ℂ) (Z : ℝ)
    (hf : ∀ (L : PhysicalMarkLists P J ell) w,
      f ((physicalSharedFactor C L : ℤ) * w) = f w)
    (hg : ∀ (L : PhysicalMarkLists P J ell) w,
      g ((physicalSharedFactor C L : ℤ) * w) = g w)
    (hcover : ∀ w ∈ W,
      Ψ ((w : ℝ) / (Z * physicalFreeFactor C aux)) * (w : ℂ)⁻¹ *
        (starRingEnd ℂ) (f w) * g (w + k * (physicalFreeFactor C aux : ℕ)) ≠ 0 →
      ∀ L : PhysicalMarkLists P J ell,
        (physicalSharedFactor C L : ℤ) * w ∈ positions ∧
        (physicalSharedFactor C L : ℤ) *
          (w + k * (physicalFreeFactor C aux : ℕ)) ∈ positions) :
    physicalFixedRootCorrelation V C q (-(a+b)) k K aux positions
      (fun n => physicalPhase (-a) n.natAbs * f n)
      (fun n => physicalPhase b n.natAbs * g n) Ψ Z =
    (physicalAuxMass V C aux : ℂ) * ∑ w ∈ W,
      (Ψ ((w : ℝ) / (Z * physicalFreeFactor C aux)) * (w : ℂ)⁻¹ *
        (starRingEnd ℂ) (f w) * g (w + k * (physicalFreeFactor C aux : ℕ))) *
      physicalFullPairCorrelation P C V q w.natAbs
        (w + k * (physicalFreeFactor C aux : ℕ)).natAbs
        (physicalPhasedPairCoefficient C K aux a b w.natAbs
          (w + k * (physicalFreeFactor C aux : ℕ)).natAbs) := by
  rw [physical_fixed_root_full_pair_guarded hdis hprime V C q a b k K aux positions W hW
    f g Ψ Z hf hg]
  congr 1
  apply sum_congr rfl
  intro w hw
  by_cases ht : Ψ ((w : ℝ) / (Z * physicalFreeFactor C aux)) * (w : ℂ)⁻¹ *
      (starRingEnd ℂ) (f w) * g (w + k * (physicalFreeFactor C aux : ℕ)) = 0
  · rw [ht, zero_mul, zero_mul]
  · congr 1
    apply physical_full_pair_congr
    intro L R _
    exact if_pos (hcover w hw ht L)

theorem physical_shifted_closure_covers_test
    {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (k : ℤ) (aux : PhysicalAuxLabels P C)
    (positions S : Finset ℤ)
    (hclosure : physicalShiftedPositionClosure P C ell k S ⊆ positions)
    (T : ℤ → ℂ) (hsupport : ∀ w, T w ≠ 0 → w ∈ S)
    (w : ℤ) (hw : T w ≠ 0) (L : PhysicalMarkLists P J ell) :
    (physicalSharedFactor C L : ℤ) * w ∈ positions ∧
    (physicalSharedFactor C L : ℤ) * (w + k * (physicalFreeFactor C aux : ℕ)) ∈ positions := by
  have h := physical_shifted_position_coverage P C k S L aux (hsupport w hw)
  refine ⟨hclosure h.1, ?_⟩
  have he : (physicalSharedFactor C L : ℤ) * w + k * (physicalD C L aux : ℕ) =
      (physicalSharedFactor C L : ℤ) * (w + k * (physicalFreeFactor C aux : ℕ)) := by
    rw [physical_D_shared_free, Nat.cast_mul]
    ring
  exact hclosure (he ▸ h.2)

end Bounty
end

section

/- The two unshared endpoint exclusions hold away from the original free-label
divisibility set, since every free label divides the actual shift. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_unshared_aux_avoids_of_no_free_divisor {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (n : ℤ) (hn : ∀ p ∈ physicalFreePrimeSet C aux, ¬ (p : ℤ) ∣ n)
    (u : GroupMarkedListsAt P (fun g => ell + (C g).card) n) :
    physicalUnsharedAuxAvoids C aux u.val := by
  intro g j s he
  have hp : (aux g j).val ∈ physicalFreePrimeSet C aux :=
    (physical_mem_free_prime_set C aux _).mpr ⟨g, j, rfl⟩
  have hd := u.property g s
  rw [← he] at hd
  exact hn _ hp hd

theorem physical_no_free_divisor_shift {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J : ℕ} (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (n k : ℤ) (hn : ∀ p ∈ physicalFreePrimeSet C aux, ¬ (p : ℤ) ∣ n) :
    ∀ p ∈ physicalFreePrimeSet C aux, ¬ (p : ℤ) ∣ n + k * (physicalFreeFactor C aux : ℕ) := by
  intro p hp hz
  apply hn p hp
  simpa only [add_sub_cancel_right] using dvd_sub hz (physical_free_prime_set_dvd_step C aux k hp)

theorem physical_marked_pair_aux_restriction_eq {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (n k : ℤ) (hn : ∀ p ∈ physicalFreePrimeSet C aux, ¬ (p : ℤ) ∣ n)
    (b : GroupMarkedLists P (fun g => ell + (C g).card) →
      GroupMarkedLists P (fun g => ell + (C g).card) → ℂ) :
    groupMarkedAverage P (fun g => ell + (C g).card) n (fun u =>
      groupMarkedAverage P (fun g => ell + (C g).card) (n + k * (physicalFreeFactor C aux : ℕ))
        (fun v => if physicalUnsharedAuxAvoids C aux u ∧ physicalUnsharedAuxAvoids C aux v
          then b u v else 0)) =
    groupMarkedAverage P (fun g => ell + (C g).card) n (fun u =>
      groupMarkedAverage P (fun g => ell + (C g).card) (n + k * (physicalFreeFactor C aux : ℕ))
        (b u)) := by
  have hz := physical_no_free_divisor_shift C aux n k hn
  unfold groupMarkedAverage
  congr 1
  apply sum_congr rfl
  intro u _
  dsimp only
  congr 1
  apply sum_congr rfl
  intro v _
  exact if_pos ⟨physical_unshared_aux_avoids_of_no_free_divisor C aux n hn u,
    physical_unshared_aux_avoids_of_no_free_divisor C aux _ hz v⟩

end Bounty
end

section

/- The actual free-label divisor set has the support and prime lower bounds
required by the invariant endpoint exclusion estimate. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_free_prime_set_supported {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J : ℕ} (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (hprime : ∀ g p, p ∈ P g → p.Prime) (Q : Finset ℕ) (hQ : ∀ g, P g ⊆ Q)
    {p : ℕ} (hp : p ∈ physicalFreePrimeSet C aux) : p ∈ Nat.factoredNumbers Q := by
  obtain ⟨g, j, rfl⟩ := (physical_mem_free_prime_set C aux p).mp hp
  have h := hprime g _ (aux g j).property
  apply Nat.mem_factoredNumbers_of_primeFactors_subset h.ne_zero
  rw [h.primeFactors]
  exact singleton_subset_iff.mpr (hQ g (aux g j).property)

theorem physical_free_prime_set_lower {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J : ℕ} (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    {Pmin : ℝ} (hP : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    {p : ℕ} (hp : p ∈ physicalFreePrimeSet C aux) : Pmin ≤ (p : ℝ) := by
  obtain ⟨g, j, rfl⟩ := (physical_mem_free_prime_set C aux p).mp hp
  exact hP g (aux g j)

end Bounty
end

section

/- Absolute errors averaged over all original auxiliary labels and patterns. -/

open Finset Real
open scoped Classical
namespace Bounty

theorem physical_pattern_absolute_error {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ)
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1/(p : ℝ) = V g)
    (probes : G → Finset (Fin J)) (r t : Finset G) {B : ℝ}
    (F : ∀ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i) → ℂ)
    (hF : ∀ i aux, ‖F i aux‖ ≤ B) :
    ‖∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      ∑ aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i),
        (physicalAuxMass V (repeatedBigPrimePatternCut probes r t i) aux : ℂ)*F i aux‖ ≤
      (Fintype.card (RepeatedBigPrimePatternIndex (ell := ell) probes r t) : ℝ)*B := by
  apply (norm_sum_le _ _).trans
  calc
    _ ≤ ∑ _i : RepeatedBigPrimePatternIndex (ell := ell) probes r t, B := by
      apply sum_le_sum
      intro i _
      exact physical_auxiliary_error_average V _ hV hMass (F i) (hF i)
    _ = _ := by simp

theorem physical_pattern_error_power {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ)
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1/(p : ℝ) = V g)
    (probes : G → Finset (Fin J)) (r t : Finset G) {L A D : ℝ} (hL : 0 < L)
    (hcard : (Fintype.card (RepeatedBigPrimePatternIndex (ell := ell) probes r t) : ℝ) ≤ L^A)
    (F : ∀ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i) → ℂ)
    (hF : ∀ i aux, ‖F i aux‖ ≤ L^(-(D+A))) :
    ‖∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      ∑ aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i),
        (physicalAuxMass V (repeatedBigPrimePatternCut probes r t i) aux : ℂ)*F i aux‖ ≤ L^(-D) := by
  apply (physical_pattern_absolute_error V hV hMass probes r t F hF).trans
  calc
    _ ≤ L^A*L^(-(D+A)) := mul_le_mul_of_nonneg_right hcard (rpow_nonneg hL.le _)
    _ = _ := by rw [← rpow_add hL]; congr 1; ring

end Bounty
end

section

/- The actual four-factor estimate needs no separate exponential radius restriction.
Adapted from LongRoughFourFactorIntegral; R <= Y and log Y <= c * L provide
the fixed exponential radius needed by the generalized rough-band estimate. -/

open Filter Finset Set MeasureTheory

namespace Bounty

theorem exists_long_rough_four_factor_integral_decay_log_radius
    {a beta c d Bcoeff A As H Cmean Cres kmean kres q t aLong : ℝ}
    (ha : 0 < a) (ha1 : a ≤ 1) (hbeta : beta < 1) (hc : 0 ≤ c) (hd : 0 < d)
    (hBcoeff : 1 ≤ Bcoeff) (hAs0 : 0 ≤ As) (haLong : 0 < aLong)
    (hAs : A + (Cmean + 2 + 2 * kmean) + 1 ≤ 2 * As)
    (hH : A + 2 + (Cres + 2 + 2 * kres) + 1 ≤ 2 * H) (Tmod Sshift : ℝ) :
    ∃ B0 : ℝ, 0 < B0 ∧ ∀ Bsave : ℝ,
      A + B0 + 2 + 2 * q + 2 * t + 1 ≤ 2 * Bsave →
    ∀ᶠ L : ℝ in atTop, ∀ (s : Finset ℕ), (∀ p ∈ s, Nat.Prime p) →
      ∀ (coeff : s → ℂ) (Y P R : ℝ),
      1 ≤ Y → d * L ≤ Real.log Y → Real.log Y ≤ c * L →
      Real.exp (L ^ a) / 2 ≤ P → P ≤ Real.exp (L ^ beta) →
      0 ≤ R → R ≤ Y →
      (∀ p ∈ s, P ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2 * P) →
      (∀ p : s, ‖coeff p‖ ≤ Bcoeff) →
      ∀ (Q M T : ℝ → ℂ), Continuous M → Continuous T →
      ∀ (Ylong Alo Blo σ : ℝ) (r : ℕ) [NeZero r] (χ : DirichletCharacter ℂ r),
      Real.exp (aLong * L) ≤ Ylong → Ylong ≤ Alo → Alo ≤ Blo → Blo ≤ 2 * Ylong →
      (r : ℝ) ≤ L ^ Tmod → |σ| ≤ L ^ Sshift →
      (∀ u, Q u = ∑ i ∈ roughBand Alo Blo (Real.exp (Real.sqrt L)),
        harmonicMellinWeight (u + σ) i * χ (i : ZMod r)) →
      (∀ u ∈ Set.Icc (-R) R, ‖Q u‖ ≤ L ^ q) →
      (∀ u ∈ Set.Icc (-R) R, ‖T u‖ ≤ L ^ t) →
      (∀ u ∈ Set.Icc (-R) R, |u| ≤ L ^ B0 → ‖M u‖ ≤ L ^ (-Bsave)) →
      ∀ (Km Kr : ℕ) (lom him : Fin Km → ℕ) (lor hir : Fin Kr → ℕ)
        (wm : Fin Km → ℕ → ℂ) (wr : Fin Kr → ℕ → ℂ)
        (Um : Fin Km → ℝ) (Ur : Fin Kr → ℝ),
      (Km : ℝ) ≤ L ^ kmean → (Kr : ℝ) ≤ L ^ kres →
      (∀ j, 1 ≤ Um j ∧ R ≤ Um j ∧ Real.log (Um j) ≤ c * L ∧
        Um j ≤ (lom j : ℝ) ∧ (him j : ℝ) ≤ 2 * Um j ∧
        (∑ n ∈ Finset.Icc (lom j) (him j), ‖wm j n‖ ^ 2) ≤ L ^ Cmean / Um j) →
      (∀ j, Y ^ (3 / 5 : ℝ) ≤ Ur j ∧ Ur j ≤ (lor j : ℝ) ∧
        (hir j : ℝ) ≤ 2 * Ur j ∧
        (∑ n ∈ Finset.Icc (lor j) (hir j), ‖wr j n‖ ^ 2) ≤ L ^ Cres / Ur j) →
      (∀ u, Q u * M u * T u = ∑ j : Fin Km, ∑ n ∈ Finset.Icc (lom j) (him j),
        wm j n * Complex.exp ((Real.log (n : ℝ) * u : ℝ) * Complex.I)) →
      (∀ u, M u * T u = ∑ j : Fin Kr, ∑ n ∈ Finset.Icc (lor j) (hir j),
        wr j n * Complex.exp ((Real.log (n : ℝ) * u : ℝ) * Complex.I)) →
      (∫ u in Set.Icc (-R) R, ‖primeReciprocalPolynomial s coeff u * Q u * M u * T u‖ ^ 2)
        ≤ L ^ (-A) := by
  obtain ⟨B0, hB0, hhigh⟩ := eventually_long_roughBand_shifted_power_bound_radius haLong
    (show 0 < max 1 c from zero_lt_one.trans_le (le_max_left _ _)) Tmod Sshift H
  refine ⟨B0, hB0, ?_⟩
  intro Bsave hBsave
  filter_upwards [hhigh, eventually_prime_four_factor_integral_decay
    ha ha1 hbeta hc hd hBcoeff hAs0 hAs hH hBsave,
    eventually_ge_atTop (0 : ℝ)] with L hrough hmain hL
  intro s hs coeff Y P R hY hloglo hloghi hPlo hPhi hR hRY hband hcoeff
    Q M T hM hT Ylong Alo Blo σ r hr χ hYlong hAlo hAB hBlo hmod hσ hQeq
    hQbound hTbound hlow Km Kr lom him lor hir wm wr Um Ur hKm hKr hmdata hrdata hmrep hrrep
  have hRexp : R ≤ Real.exp (max 1 c * L) := by
    calc
      R ≤ Y := hRY
      _ = Real.exp (Real.log Y) := (Real.exp_log (zero_lt_one.trans_le hY)).symm
      _ ≤ Real.exp (max 1 c * L) := Real.exp_le_exp.mpr
        (hloghi.trans (mul_le_mul_of_nonneg_right (le_max_right _ _) hL))
  have hQ : Continuous Q := by
    have hh : Continuous (fun u => ∑ i ∈ roughBand Alo Blo (Real.exp (Real.sqrt L)),
        harmonicMellinWeight (u + σ) i * χ (i : ZMod r)) := by
      unfold harmonicMellinWeight
      fun_prop
    exact hh.congr (fun u => (hQeq u).symm)
  apply hmain s hs coeff Y P R hY hloglo hloghi hPlo hPhi hR hRY hband hcoeff
    Q M T hQ hM hT hQbound hTbound _ hlow Km Kr lom him lor hir wm wr Um Ur
    hKm hKr hmdata hrdata hmrep hrrep
  intro u hu hlarge
  rw [hQeq u]
  exact hrough Ylong hYlong r χ hmod u σ hlarge.le ((abs_le.mpr hu).trans hRexp)
    hσ Alo Blo hAlo hAB hBlo

end Bounty
end

section

/- The recorded-history identity applies to every physical terminal test,
using the exact inverse of the encoding on its image. -/

open scoped Classical
namespace Bounty

noncomputable def physicalRecordedTerminalExtension {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (A : Fin N → Finset (Fin J)) (F : PhysicalBoundedMarkState P J ell B → ℂ)
    (y : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B) : ℂ :=
  if hy : FullActiveInjective y.2 then F (physicalBoundedMarkDecode A y hy) else 0

theorem physical_recorded_terminal_extension_encode {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (A : Fin N → Finset (Fin J)) (F : PhysicalBoundedMarkState P J ell B → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) :
    physicalRecordedTerminalExtension A F (physicalBoundedMarkEncode A s) = F s := by
  unfold physicalRecordedTerminalExtension
  rw [dif_pos (physical_bounded_mark_encode_full_injective A s), physical_bounded_mark_decode_encode]

section Terminal
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g, ∀ p : ↥(P g), NeZero p.val]
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (k : Fin n → ℤ) (β : (g : Fin N) → ↥(P g) → ℝ)
  (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)

theorem physical_selected_fine_history_eq_recorded_terminal
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (cut : ℕ → Fin N → Finset (Fin J))
    (hencode : ∀ i, PhysicalMarkRowEncoding C (physicalSelectedFineTag n i) (cut i) (cut (i + 1)))
    (steps : ℕ) (F : PhysicalBoundedMarkState P J ell B → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) :
    finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
      (physicalSelectedFineRow C aux L σ τ k β V ρ hV ω retention) steps F s =
    finiteRowComposition (S := fun _ =>
      List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C) × PhysicalBoundedMarkState P J ell B)
      (fun i => physicalRecordedMarkRow C k ω β retention ρ V hV
        (physicalSelectedFineTag n i) (cut i) (cut (i + 1)) (physicalFullTraceAppend C)) steps
      (fun r => physicalSelectedFineRecordMask C aux L σ τ cut steps r.1 * F r.2) ([], s) := by
  have he := physical_selected_fine_history_eq_recorded C aux L σ τ k β V ρ hV ω retention
    hP hdis cut hencode steps (physicalRecordedTerminalExtension (cut steps) F) s
  have hterm : physicalRecordedTerminalExtension (cut steps) F ∘ physicalBoundedMarkEncode (cut steps) = F := by
    funext t
    exact physical_recorded_terminal_extension_encode (cut steps) F t
  rw [hterm] at he
  have hrecord :
      ((fun r : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C) ×
          FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B =>
          physicalSelectedFineRecordMask C aux L σ τ cut steps r.1 *
            physicalRecordedTerminalExtension (cut steps) F r.2) ∘
        Prod.map id (physicalBoundedMarkEncode (cut steps))) =
      (fun r : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C) ×
          PhysicalBoundedMarkState P J ell B =>
        physicalSelectedFineRecordMask C aux L σ τ cut steps r.1 * F r.2) := by
    funext r
    exact congrArg (physicalSelectedFineRecordMask C aux L σ τ cut steps r.1 * ·)
      (physical_recorded_terminal_extension_encode (cut steps) F r.2)
  rw [hrecord] at he
  exact he

end Terminal
end Bounty
end

section

/- Each fixed selection of marks, permutations and auxiliary draws inherits
the original physical recorded-history energy bound with no path-count factor. -/

namespace Bounty

section Energy
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g, ∀ p : ↥(P g), NeZero p.val]
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (k : Fin n → ℤ) (β : (g : Fin N) → ↥(P g) → ℝ)
  (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)

theorem physical_selected_fine_history_energy_le
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (cut : ℕ → Fin N → Finset (Fin J))
    (hencode : ∀ i, PhysicalMarkRowEncoding C (physicalSelectedFineTag n i) (cut i) (cut (i + 1)))
    (hω : ∀ j c a, 0 ≤ ω j c a) (hωmass : ∀ j c, ∑ a, ω j c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 < β g p / V g) (hmass : ∀ g, ∑ p, β g p / V g ≤ 2)
    (hq0 : ∀ i, 0 ≤ retention i) (hq1 : ∀ i, retention i ≤ 1)
    (hD : ∀ i, retention i / ρ ^ 2 + ((1 - retention i) / ρ) / v ≤ 1)
    (hC : ∀ i g, retention i / ρ ^ 2 + ((1 - retention i) * V g / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ j g, ell + (C j g).card ≤ T)
    (initial : PhysicalFullBoundedState P J ell B → (g : Fin N) → Finset ↥(P g))
    (f : PhysicalFullBoundedState P J ell B → ℂ) (hf : ProductMemorySymmetric f) :
    physicalMarkMemoryEnergy (fun g p => β g p / V g)
      (fun g => unrestrictedResidueWeight (fun p => β g p / V g))
      (fun M q =>
        let x := physicalFullMemoryState (cut 0) M q
        finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
          (physicalSelectedFineRow C aux L σ τ k β V ρ hV ω retention) (4 * n + 1)
          (fun t => f (physicalBoundedMarkEncode (cut (4 * n + 1)) t).2)
          (M, initial x, q)) ≤
      (((List.range (4 * n + 1)).map (physicalSelectedFineTag n)).map
        (fullPermutationMixedStepEnergy ρ v vmin vmax T N)).prod *
        finiteWeightedEnergy (productMemoryWeight (fun g p => β g p / V g)
          (fun g => unrestrictedResidueWeight (fun p => β g p / V g))) f := by
  have he := physical_recorded_trace_history_energy_le C k ω β retention ρ V hV hP hdis
    (physicalSelectedFineTag n) cut hencode hω hωmass hρ0 hρ1 hv hvmin hVlo hVhi
    hμ hmass hq0 hq1 hD hC T ht (4 * n + 1) initial (fun _ => [])
    (fun r _ => physicalSelectedFineRecordMask C aux L σ τ cut (4 * n + 1) r)
    (fun r _ => physical_selected_fine_record_mask_norm C aux L σ τ cut (4 * n + 1) r) f hf
  have hident := physical_selected_fine_history_eq_recorded C aux L σ τ k β V ρ hV ω retention
    hP hdis cut hencode (4 * n + 1) (fun y => f y.2)
  simp only [← hident] at he
  exact he

end Energy
end Bounty
end

section

/- Each full chronological record can select at most one prescribed physical path. -/

open Finset
open scoped Classical
namespace Bounty

section Fine
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J))
  (cut : ℕ → Fin N → Finset (Fin J))

theorem physical_selected_fine_record_data_unique
    {aux aux' : ∀ j, PhysicalAuxLabels P (C j)}
    {L L' : Fin (n + 1) → PhysicalMarkLists P J ell}
    {σ τ σ' τ' : Fin n → PhysicalPermutations (Fin N) J ell}
    (r : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C))
    (h : List.Forall₂ (physicalSelectedFineTraceTest C aux L σ τ cut) (List.range (4 * n + 1)) r)
    (h' : List.Forall₂ (physicalSelectedFineTraceTest C aux' L' σ' τ' cut) (List.range (4 * n + 1)) r) :
    aux = aux' ∧ L = L' ∧ σ = σ' ∧ τ = τ' := by
  apply physical_selected_fine_data_unique_of_joint_tests C
  intro i hi
  have hir : i < r.length := by simpa only [← h.length_eq, List.length_range] using hi
  have hil : i < (List.range (4 * n + 1)).length := by simpa only [List.length_range] using hi
  have ha : physicalSelectedFineTraceTest C aux L σ τ cut i (r.get ⟨i, hir⟩) := by
    simpa only [List.get_eq_getElem, List.getElem_range] using h.get hil hir
  have hb : physicalSelectedFineTraceTest C aux' L' σ' τ' cut i (r.get ⟨i, hir⟩) := by
    simpa only [List.get_eq_getElem, List.getElem_range] using h'.get hil hir
  obtain ⟨t, het, ht⟩ := ha
  obtain ⟨u, heu, hu⟩ := hb
  have he : u = t := physical_bounded_mark_encode_injective (cut (i + 1)) (heu.trans het.symm)
  exact ⟨(r.get ⟨i, hir⟩).2.1, t, ht, he ▸ hu⟩

noncomputable def physicalSelectedDataRecordTest (d : PhysicalSelectedData P ell C)
    (r : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C)) : Prop :=
  List.Forall₂ (physicalSelectedFineTraceTest C d.1 d.2.1 d.2.2.1 d.2.2.2 cut)
    (List.range (4 * n + 1)) r

theorem physical_selected_data_record_unique {d e : PhysicalSelectedData P ell C}
    (r : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C))
    (hd : physicalSelectedDataRecordTest C cut d r)
    (he : physicalSelectedDataRecordTest C cut e r) : d = e := by
  obtain ⟨ha, hL, hσ, hτ⟩ := physical_selected_fine_record_data_unique C cut r hd he
  exact Prod.ext ha (Prod.ext hL (Prod.ext hσ hτ))

noncomputable def physicalSelectedDataRecordPhase
    (S : Finset (PhysicalSelectedData P ell C))
    (w : PhysicalSelectedData P ell C → ℂ)
    (r : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C)) : ℂ :=
  ∑ d ∈ S, if physicalSelectedDataRecordTest C cut d r then w d else 0

theorem physical_selected_data_record_phase_norm_le_one
    (S : Finset (PhysicalSelectedData P ell C))
    (w : PhysicalSelectedData P ell C → ℂ)
    (r : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C))
    (hw : ∀ d ∈ S, physicalSelectedDataRecordTest C cut d r → ‖w d‖ ≤ 1) :
    ‖physicalSelectedDataRecordPhase C cut S w r‖ ≤ 1 := by
  exact finite_disjoint_phase_norm_le_one S (fun d => physicalSelectedDataRecordTest C cut d r) w
    (fun _ _ _ _ hd he => physical_selected_data_record_unique C cut r hd he) hw

end Fine
end Bounty
end

section

/- Exact packing of original labeled physical paths by their indexed pattern sequence. -/

open Finset
namespace Bounty

section Packing
variable {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    (patterns : Finset I) (C : I → Fin N → Finset (Fin J))

def physicalPathSelectedEquiv :
    (PhysicalMarkLists P J ell ×
      (Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)) ≃
    (Σ pattern : Fin n → patterns, PhysicalSelectedData P ell (fun j => C (pattern j).val)) where
  toFun x :=
    ⟨(fun j => (x.2 j).1.2.2.1), (fun j => (x.2 j).1.2.2.2),
      Fin.cons x.1 (fun j => (x.2 j).2),
      (fun j => (x.2 j).1.1), (fun j => (x.2 j).1.2.1)⟩
  invFun y :=
    (y.2.2.1 0, fun j =>
      ((y.2.2.2.1 j, y.2.2.2.2 j, ⟨y.1 j, y.2.1 j⟩), y.2.2.1 j.succ))
  left_inv x := by
    apply Prod.ext
    · rfl
    · funext j
      change (((x.2 j).1.1, (x.2 j).1.2.1,
        ⟨(x.2 j).1.2.2.1, (x.2 j).1.2.2.2⟩), (x.2 j).2) = x.2 j
      rcases x.2 j with ⟨⟨σ, τ, ⟨i, aux⟩⟩, L⟩
      rfl
  right_inv y := by
    rcases y with ⟨pattern, aux, L, σ, τ⟩
    change (⟨pattern, aux, Fin.cons (L 0) (fun j => L j.succ), σ, τ⟩ :
      Σ pattern : Fin n → patterns, PhysicalSelectedData P ell (fun j => C (pattern j).val)) =
      ⟨pattern, aux, L, σ, τ⟩
    have hL : Fin.cons (L 0) (fun j => L j.succ) = L := by
      funext j
      refine Fin.cases ?_ (fun i => ?_) j <;> rfl
    rw [hL]

theorem physical_path_selected_patterns
    (L : PhysicalMarkLists P J ell)
    (p : Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) :
    (physicalPathSelectedEquiv patterns C (L, p)).1 = fun j => (p j).1.2.2.1 := rfl

theorem physical_path_selected_aux
    (L : PhysicalMarkLists P J ell)
    (p : Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) :
    (physicalPathSelectedEquiv patterns C (L, p)).2.1 = fun j => (p j).1.2.2.2 := rfl

theorem physical_path_selected_marks_zero
    (L : PhysicalMarkLists P J ell)
    (p : Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) :
    (physicalPathSelectedEquiv patterns C (L, p)).2.2.1 0 = L := rfl

theorem physical_path_selected_marks_succ
    (L : PhysicalMarkLists P J ell)
    (p : Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)
    (j : Fin n) :
    (physicalPathSelectedEquiv patterns C (L, p)).2.2.1 j.succ = (p j).2 := rfl

theorem physical_path_selected_sigma
    (L : PhysicalMarkLists P J ell)
    (p : Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) :
    (physicalPathSelectedEquiv patterns C (L, p)).2.2.2.1 = fun j => (p j).1.1 := rfl

theorem physical_path_selected_tau
    (L : PhysicalMarkLists P J ell)
    (p : Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) :
    (physicalPathSelectedEquiv patterns C (L, p)).2.2.2.2 = fun j => (p j).1.2.1 := rfl

theorem physical_path_selected_marks_eq_finite_path
    (L : PhysicalMarkLists P J ell)
    (p : Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) :
    (physicalPathSelectedEquiv patterns C (L, p)).2.2.1 = fun j => finitePathMarks L p j.val := by
  funext j
  refine Fin.cases ?_ (fun i => ?_) j
  · rfl
  · simp only [physical_path_selected_marks_succ, Fin.val_succ, finitePathMarks, dif_pos i.isLt]

theorem physical_path_selected_inverse_initial
    (pattern : Fin n → patterns) (d : PhysicalSelectedData P ell (fun j => C (pattern j).val)) :
    ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d⟩).1 = d.2.1 0 := rfl

theorem physical_path_selected_inverse_step
    (pattern : Fin n → patterns) (d : PhysicalSelectedData P ell (fun j => C (pattern j).val))
    (j : Fin n) :
    ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d⟩).2 j =
      ((d.2.2.1 j, d.2.2.2 j, ⟨pattern j, d.1 j⟩), d.2.1 j.succ) := rfl

theorem physical_selected_inverse_finite_path_marks
    (pattern : Fin n → patterns) (d : PhysicalSelectedData P ell (fun j => C (pattern j).val)) :
    (fun j : Fin (n + 1) => finitePathMarks
      ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d⟩).1
      ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d⟩).2 j.val) = d.2.1 := by
  funext j
  refine Fin.cases ?_ (fun i => ?_) j
  · rfl
  · simp only [Fin.val_succ, finitePathMarks, dif_pos i.isLt,
      physical_path_selected_inverse_step]

end Packing
end Bounty
end

section

/- The complete list coefficient and unit phase of a selected physical path. -/

open Finset
namespace Bounty

section Coefficient
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (ζ : Fin n → ℝ)
  (K : ∀ j, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C j) → ℂ)

noncomputable def physicalSelectedCoefficient (d : PhysicalSelectedData P ell C) : ℂ :=
  ∏ j : Fin n,
    K j (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc))
      (physicalPermuteLabels (d.2.2.2 j) (d.2.1 j.succ)) (d.1 j) *
    physicalPhase (ζ j) (physicalD (C j)
      (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc)) (d.1 j))

theorem physical_selected_coefficient_norm_le
    (d : PhysicalSelectedData P ell C) (A : Fin n → ℝ)
    (hK : ∀ j, ‖K j (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc))
      (physicalPermuteLabels (d.2.2.2 j) (d.2.1 j.succ)) (d.1 j)‖ ≤ A j) :
    ‖physicalSelectedCoefficient C ζ K d‖ ≤ ∏ j, A j := by
  unfold physicalSelectedCoefficient
  apply (Finset.norm_prod_le _ _).trans
  apply prod_le_prod₀ (fun _ _ => norm_nonneg _)
  intro j hj
  simpa only [norm_mul, physical_phase_norm, mul_one] using hK j

theorem physical_selected_coefficient_norm_le_pow
    (d : PhysicalSelectedData P ell C) (A : ℝ)
    (hK : ∀ j, ‖K j (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc))
      (physicalPermuteLabels (d.2.2.2 j) (d.2.1 j.succ)) (d.1 j)‖ ≤ A) :
    ‖physicalSelectedCoefficient C ζ K d‖ ≤ A ^ n := by
  simpa using physical_selected_coefficient_norm_le C ζ K d (fun _ => A) hK

end Coefficient
end Bounty
end

section

/- Arbitrary power decay for the actual signed prime family on the full
bounded product memory measure, retaining both active-slot averages. All
memory sectors and residue occurrences are integrated in the conclusion. -/

open Finset Filter
open scoped Classical

namespace Bounty

theorem eventually_repeated_big_prime_full_memory_power_bound
    (hZ : PrimitiveZeroFreeHalfPlane) (c s z a v D ε E beta tau : ℝ)
    (m J ell : ℕ)
    (hc : 0 < c) (hs : 0 ≤ s) (hz : 0 ≤ z) (ha : 0 ≤ a)
    (hv : 0 < v) (hD : 0 ≤ D) (hε : 0 < ε) (htau : 0 ≤ tau)
    (hell : 0 < ell) (hml : ell ≤ m)
    (hgap : beta * Real.log ((ell : ℝ) ^ ell / (m : ℝ) ^ ell) / 2 ≤ -(E + 2))
    (hDgap : (m : ℝ) * a * Real.log 3 + E + 2 ≤ D) :
    let κ := a * Real.log (primeFiberFactorBound v m)
    let s' := s + ε
    let A₀ := D + 2 * (s' + 1)
    let q := 2 * κ + (s' + 1) + 2 * A₀ + 3
    let w := 4 * q + max z q + A₀ + 2
    let x := (s' + w + 2) + 2 * A₀ + 2
    ∀ᶠ L : ℝ in atTop,
    let Q := ⌊L ^ q⌋₊
    let h := L ^ (-w)
    let ξ := L ^ (-x)
    ∀ {G : Type} [Fintype G] [DecidableEq G],
    ∀ (P : G → Finset ℕ) (V : G → ℝ),
    Pairwise (fun g h => Disjoint (P g) (P h)) →
    ∀ hP : ∀ g p, p ∈ P g → p.Prime ∧ Q < p,
    (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) →
    (∀ g, v ≤ V g) →
    (∀ g p, p ∈ P g → Real.log p ≤ L ^ s) →
    (Fintype.card G : ℝ) ≤ a * Real.log L →
    (∀ g, ∃ a b : ℝ, P g = primeBand a b ∧ Real.exp (L ^ c) ≤ a ∧ 0 ≤ b) →
    ∀ probes : G → Finset (Fin J), (∀ g, (probes g).card = m) →
    ∀ r t : Finset G, ∀ hrt : Disjoint r t,
    beta * Real.log L ≤ (r.card : ℝ) → beta * Real.log L ≤ (t.card : ℝ) →
    ∀ ζ θ : ℝ, |ζ| ≤ L ^ z →
    let kept := fun U : Finset (RepeatedBigFlatIndex G J ell) => primeProductRetainedCells
      (fun i : U => P i.1.1) (fun i => V i.1.1) h ξ
    let C := repeatedBigPrimePatternCut (ell := ell) probes r t
    let K := repeatedBigPrimePatternKernel P V probes r t hrt Q h kept
    let weights := repeatedBigPrimePatternWeight (ell := ell) probes r t
    ∀ (b : ∀ g, P g → ℝ),
    ∀ T Pmin : ℝ, 0 ≤ T → T ≤ L ^ tau → Real.exp (L ^ c) ≤ Pmin →
    (∀ g (p : P g), Pmin ≤ (p.val : ℝ)) →
    (∀ g (p : P g), b g p = 1 - T / (p.val : ℝ)) →
    ∀ (S : Type) [Fintype S] (Ps : S → Finset ℕ) (fullB : ℕ) (k : ℤ)
      (ν : ∀ g, P g → ℝ) (ρ : ℝ),
    (∀ g p, 0 ≤ ν g p) → 0 ≤ ρ → ρ ≤ 1 →
