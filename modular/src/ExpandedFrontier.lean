theorem physical_group_finite_path_capped_eq_run_product
    {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    [∀ a : PhysicalPrime P, NeZero a.2.val]
    {patterns : Finset I} (groups : Finset (Fin N))
    (C : I → Fin N → Finset (Fin J)) (k : ℕ → I → ℤ)
    (L : PhysicalMarkLists P J ell)
    (p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)
    (η : ℕ → ℝ) (β : PhysicalPrime P → ℝ) (V : Fin N → ℝ)
    (B : ℕ) (hB : (physicalPrimeGroups P groups).card ≤ B) :
    ghostPhaseCappedHistory
      (fun a : ↥(physicalPrimeGroups P groups) => fun j => globalBirthFiniteActivity
        (physicalGroupBareFiniteActivity (physicalPathSelectedEquiv patterns C (L, p)).2.2.1 a.val.1) j a.val.2)
      (fun a => physicalResidueAbsoluteHit (physicalPathSelectedOffset C k L p) a.val.1 a.val.2)
      (fun _ j => η (globalBirthFiniteIndex (n + 1) j).val)
      (fun a => β a.val) (fun a => V a.val.1) (fun _ => B) (fun _ => B) (n + 1) =
    ∏ a ∈ physicalPrimeGroups P groups, ghostPhaseRunHistory
      (fun j => decide (a ∈ physicalMarkedPrimes (finitePathMarks L p j)))
      (fun j => -(physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p)
        (n + 1) j : ZMod a.2.val)) η (β a) (V a.1) (n + 1) := by
  rw [ghost_phase_capped_history_eq_run_product _ _ _ _ _ _ _
    (fun _ => by simpa only [Fintype.card_coe] using hB)
    (fun _ => by simpa only [Fintype.card_coe] using hB)]
  calc
    _ = ∏ a : ↥(physicalPrimeGroups P groups), ghostPhaseRunHistory
      (fun j => decide (a.val ∈ physicalMarkedPrimes (finitePathMarks L p j)))
      (fun j => -(physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p)
        (n + 1) j : ZMod a.val.2.val)) η (β a.val) (V a.val.1) (n + 1) := by
      apply prod_congr rfl
      intro a ha
      exact physical_finite_path_run_alignment C k L p η β V a.val
    _ = _ := prod_coe_sort (physicalPrimeGroups P groups) (fun a : PhysicalPrime P =>
      ghostPhaseRunHistory (fun j => decide (a ∈ physicalMarkedPrimes (finitePathMarks L p j)))
        (fun j => -(physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p)
          (n + 1) j : ZMod a.2.val)) η (β a) (V a.1) (n + 1))

