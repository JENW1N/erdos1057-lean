theorem physical_enriched_untouched_edge_row
    (i : Fin (((List.range (4 * n + 1)).map (physicalSelectedFineTag n)).length))
    (hi : i ∉ fullMixedBirthAffectedOperations
      (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B
