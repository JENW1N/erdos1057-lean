section

open MeasureTheory Filter

namespace Bounty

theorem eventually_local_fourier_of_mellin {b c : ℝ} (hb : 0 < b) (hc : 0 ≤ c)
    (A B : ℝ) :
    ∃ D : ℝ, A < D ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (Y H : ℝ) (S : Finset ℕ) (a : ℕ → ℂ) (N : ℕ),
      Real.exp (b*L) ≤ Y → 1 ≤ H → H ≤ Real.exp ((b/2)*L) →
      (∀ n ∈ S, Y/8 ≤ (n:ℝ) ∧ (n:ℝ) ≤ 64*Y) →
      (∀ n ∈ S, n ≤ N) → (N:ℝ) ≤ c*Y → Real.log N ≤ c*L →
      (∑ n ∈ S, ‖a n‖^2) ≤ Y*L^B →
      (∫ t in {t : ℝ | |t| ≤ L*Y/H}, ‖localMellinPolynomial S a t‖^2) ≤ Y^2*L^(-D) →
      (∫ β in {β : ℝ | |β| ≤ 1/H}, ‖localAdditivePolynomial S a β‖^2) ≤ Y*L^(-A) := by
  obtain ⟨j,hj,htail⟩ := eventually_local_mellin_geometric_truncation hc B (A+1)
  obtain ⟨Cj,Cerr,hCj,hCerr,hwide⟩ := exists_wide_local_fourier_mellin_energy_constants hj
  refine ⟨A+1,by linarith,?_⟩
  filter_upwards [htail, eventually_local_scale_error hb hCerr.le A B,
    eventually_ge_atTop (1:ℝ), eventually_ge_atTop (4*Cj)] with L htail hscale hL hLC
  intro Y H S a N hY hH hHu hS hNS hN hlog hE hlow
  have hYp : 0 < Y := (Real.exp_pos _).trans_le hY
  have hHp : 0 < H := lt_of_lt_of_le zero_lt_one hH
  have hLp : 0 < L := lt_of_lt_of_le zero_lt_one hL
  have hh : 0 < H/Y := div_pos hHp hYp
  have hinv : (H/Y)⁻¹ ≤ Y := by
    rw [inv_div]
    exact div_le_self hYp.le hH
  have hSN : ∀ n ∈ S, 1 ≤ n ∧ n ≤ N := by
    intro n hn
    have hnpos : 0 < (n:ℝ) := (by positivity : 0 < Y/8).trans_le (hS n hn).1
    exact ⟨by exact_mod_cast hnpos,hNS n hn⟩
  obtain ⟨hsmall,herror⟩ := hscale Y H (∑ n ∈ S, ‖a n‖^2) hY hH hHu hE
  have ht := htail Y (H/Y) S a N hYp hh hinv hSN hN hlog hE
  have hcut : L/(H/Y) = L*Y/H := by field_simp
  rw [hcut] at ht
  have hI : (∫ t : ℝ, (1+|(H/Y)*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2) ≤
      2*Y^2*L^(-(A+1)) := by linarith
  have hcoef : 2*Cj*L^(-(A+1)) ≤ L^(-A)/2 := by
    rw [show -(A+1) = -A-1 by ring, Real.rpow_sub hLp, Real.rpow_one]
    have hp := mul_le_mul_of_nonneg_right hLC (Real.rpow_pos_of_pos hLp (-A)).le
    calc
      2*Cj*(L^(-A)/L) = (2*Cj*L^(-A))/L := by ring
      _ ≤ L^(-A)/2 := (div_le_iff₀ hLp).2 (by nlinarith)

  calc
    _ ≤ (Cj/Y)*(∫ t : ℝ, (1+|(H/Y)*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2) +
        Cerr*(H/Y)^2*(∑ n ∈ S, ‖a n‖^2) := hwide S a Y H hYp hH hsmall hS
    _ ≤ (Cj/Y)*(2*Y^2*L^(-(A+1)))+Y*L^(-A)/2 := by
      exact _root_.add_le_add (mul_le_mul_of_nonneg_left hI (by positivity)) herror
    _ = Y*(2*Cj*L^(-(A+1)))+Y*L^(-A)/2 := by field_simp
    _ ≤ Y*(L^(-A)/2)+Y*L^(-A)/2 := by
      exact _root_.add_le_add (mul_le_mul_of_nonneg_left hcoef hYp.le) le_rfl
    _ = _ := by ring

end Bounty
end

section

/- The actual shifted rough mass of the candidate in its full arithmetic window. -/

open Finset Filter

namespace Bounty

noncomputable def candidateShiftedRoughMass (c L q : ℝ) (r jStar : ℕ) (z : ℝ) : ℝ :=
  ∑ u ∈ shiftedRoughSet (arithmeticProductWindow 1 (Real.exp L)) z,
    candidateCoefficient c L q r jStar u

theorem exists_candidate_shifted_rough_mass_estimate (hZ : PrimitiveZeroFreeHalfPlane) :
    ∃ K : ℝ, 0 < K ∧ ∀ (c q b : ℝ) (r h : ℕ),
      0 < c → 0 < r → 0 ≤ q → q < 1 →
      (11/5 : ℝ) * (r : ℝ) * c = 1 →
      0 < b → 1 ≤ h → Even h → b * (4 * (h : ℝ) + 2) < 1/2 →
      ∃ J : ℕ, ∀ jStar : ℕ, J < jStar → ∀ᶠ L : ℝ in atTop,
        |candidateShiftedRoughMass c L q r jStar (Real.exp (b * L)) -
            candidateCoefficientWindowMass c L q r jStar *
              shiftedPrimeAvoidanceProduct (Real.exp (b * L))| ≤
          candidateCoefficientWindowMass c L q r jStar *
            shiftedPrimeAvoidanceProduct (Real.exp (b * L)) *
            (K * Real.exp (-(h : ℝ)) + L^(-16 : ℝ)) := by
  obtain ⟨K, hK, hsieve⟩ := exists_shifted_totient_rough_sieve
  refine ⟨K, hK, ?_⟩
  intro c q b r h hc hr hq0 hq1 hcenter hb hh heven hlevel
  let theta : ℝ := (b * (4 * (h : ℝ) + 2) + 1/2) / 2
  have htheta : theta < 1/2 := by dsimp [theta]; linarith only [hlevel]
  obtain ⟨J, hdist⟩ := exists_candidate_relative_typeI_remainder_power_bound
    hZ hc hr hq0 hq1 hcenter htheta (18 : ℝ)
  refine ⟨J, ?_⟩
  intro jStar hj
  filter_upwards [hdist jStar hj, eventually_candidate_midpoint_sieve_scale hb h hlevel,
    eventually_shifted_avoidance_absorbs_power hb (1 + 16 * primeEulerProductUpperConstant)
      (by positivity [primeEulerProductUpperConstant_pos])]
    with L hd hscale habs
  let N : ℕ := ⌊Real.exp (theta * L)⌋₊
  have hN : (N : ℝ) ≤ Real.exp (theta * L) := Nat.floor_le (Real.exp_pos _).le
  have hXA : 0 ≤ candidateCoefficientWindowMass c L q r jStar := by
    apply sum_nonneg
    intro u _
    exact candidate_coefficient_nonneg c L hq0 r jStar u
  have hsub : blockSieveModuli ((primeBand 0 (Real.exp (b * L))).erase 2)
      ((Real.exp (b * L))^(4 * (h : ℝ) + 2)) ⊆ oddSquarefreeModuli N := by
    apply odd_sieve_moduli_subset
    · intro p hp
      exact small_prime_pool_prime (mem_of_mem_erase hp)
    · intro p hp
      exact (mem_erase.mp hp).1
    · exact hscale.2.1
  have herror : (∑ d ∈ blockSieveModuli ((primeBand 0 (Real.exp (b * L))).erase 2)
        ((Real.exp (b * L))^(4 * (h : ℝ) + 2)),
        |shiftedTotientSieveRemainder (arithmeticProductWindow 1 (Real.exp L))
          (candidateCoefficient c L q r jStar) d|) ≤
      candidateCoefficientWindowMass c L q r jStar *
        shiftedPrimeAvoidanceProduct (Real.exp (b * L)) * L^(-16 : ℝ) := by
    calc
      _ ≤ ∑ d ∈ oddSquarefreeModuli N,
          |shiftedTotientSieveRemainder (arithmeticProductWindow 1 (Real.exp L))
            (candidateCoefficient c L q r jStar) d| :=
        sum_le_sum_of_subset_of_nonneg hsub (fun _ _ _ => abs_nonneg _)
      _ ≤ candidateCoefficientWindowMass c L q r jStar *
          (L^(-18 : ℝ) + (16 * primeEulerProductUpperConstant) * L^(-18 : ℝ)) := hd N hN
      _ = candidateCoefficientWindowMass c L q r jStar *
          ((1 + 16 * primeEulerProductUpperConstant) * L^(-18 : ℝ)) := by ring
      _ ≤ candidateCoefficientWindowMass c L q r jStar *
          (shiftedPrimeAvoidanceProduct (Real.exp (b * L)) * L^(-16 : ℝ)) :=
        mul_le_mul_of_nonneg_left habs hXA
      _ = _ := by ring
  have hs := hsieve (arithmeticProductWindow 1 (Real.exp L))
    (candidateCoefficient c L q r jStar) hscale.1 hh heven
    (fun u _ => candidate_coefficient_nonneg c L hq0 r jStar u)
  change |candidateShiftedRoughMass c L q r jStar (Real.exp (b * L)) -
      candidateCoefficientWindowMass c L q r jStar *
        shiftedPrimeAvoidanceProduct (Real.exp (b * L))| ≤
    candidateCoefficientWindowMass c L q r jStar *
      shiftedPrimeAvoidanceProduct (Real.exp (b * L)) * K * Real.exp (-(h : ℝ)) + _ at hs
  calc
    _ ≤ candidateCoefficientWindowMass c L q r jStar *
        shiftedPrimeAvoidanceProduct (Real.exp (b * L)) * K * Real.exp (-(h : ℝ)) +
        ∑ d ∈ blockSieveModuli ((primeBand 0 (Real.exp (b * L))).erase 2)
          ((Real.exp (b * L))^(4 * (h : ℝ) + 2)),
          |shiftedTotientSieveRemainder (arithmeticProductWindow 1 (Real.exp L))
            (candidateCoefficient c L q r jStar) d| := hs
    _ ≤ candidateCoefficientWindowMass c L q r jStar *
        shiftedPrimeAvoidanceProduct (Real.exp (b * L)) * K * Real.exp (-(h : ℝ)) +
        candidateCoefficientWindowMass c L q r jStar *
          shiftedPrimeAvoidanceProduct (Real.exp (b * L)) * L^(-16 : ℝ) :=
      add_le_add le_rfl herror
    _ = _ := by ring

end Bounty
end

section

/- Exact all-state zero extensions of the original selected physical rows. -/

open Finset
open scoped Classical
namespace Bounty

section ResiduePath
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (ζ : ∀ p : PhysicalPrime P, ZMod p.2.val)
  (hmarks : ∀ j : Fin (n + 1), ∀ p ∈ physicalMarkedPrimes (L j),
    ζ p = -(a j : ZMod p.2.val))
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ) (η : Fin N → Fin (n + 1) → ℝ)
  (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0) (B : ℕ)

variable
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)

theorem physical_selected_original_edge_extension (j : Fin n)
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    physicalMarkRawExtension
      (physicalSelectedStateEdgeBlock C k ω β retention ρ V hV j (aux j) (σ j) (τ j)
        (L j.succ) F) (L j.castSucc) =
      fun s => (((Fintype.card (PhysicalPermutations (Fin N) J ell) : ℝ)⁻¹ : ℂ) ^ 2) *
        (ω j (physicalSharedMarkLabels (C j) (physicalPermuteLabels (σ j) (L j.castSucc)))
          (aux j) : ℂ) *
      globalBirthJointCutRawRow
        (physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β η V
          (fun _ => ρ) hV B (2 * j.val + 1)) B B
        (physicalMarkRawExtension F (L j.succ)) s := by
  apply physical_mark_raw_extension_eq_of_total_cutoff
  · intro s hs
    simp only [globalBirthJointCutRawRow, globalBirthJointRawCutoff,
      if_neg (Nat.not_le_of_gt hs), mul_zero]
  · intro s hs
    have he := physical_selected_original_state_edge_block C aux k L a σ τ hstep ζ
      hmarks hlist hP hdis hk β η V ρ hV B ω retention j F s hs
    simpa only [physical_full_memory_state_shared_labels] using he

theorem physical_selected_original_visit_extension (j : Fin (n + 1))
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    physicalMarkRawExtension
      (physicalObservedMarkRow C k ω β retention ρ V hV (some (.inl j))
        (fun o t => if o = .inr none ∧ t.1 = L j then F t else 0)) (L j) =
      globalBirthJointCutRawRow
        (physicalJointResidueStep C aux k L a σ τ hstep ζ hmarks hlist hP hdis hk β
          (fun _ i => 1 - retention i) V (fun _ => ρ) hV B (2 * j.val))
        B B (physicalMarkRawExtension F (L j)) := by
  apply physical_mark_raw_extension_eq_of_total_cutoff
  · intro s hs
    simp only [globalBirthJointCutRawRow, globalBirthJointRawCutoff,
      if_neg (Nat.not_le_of_gt hs)]
  · intro s hs
    have he := physical_selected_original_state_visit C aux k L a σ τ hstep ζ
      hmarks hlist hP hdis hk β V ρ hV B ω retention j F s
    have hstate : (L j, s.2) = s := by rw [← hs]
    rw [hstate] at he
    exact he

end ResiduePath
end Bounty
end

section

/- The actual masked pair count averaged over Bernoulli choices. -/

open Finset

namespace Bounty

theorem exists_masked_pair_average_upper :
    ∃ K : ℝ, 0 < K ∧ ∀ (L : ℝ) (a b c d m : ℕ) [NeZero m]
      (W z q : ℝ) (P : Finset ℕ),
      1 ≤ L → (m : ℝ) ≤ Real.exp L →
      (∀ p ∈ m.primeFactors, L^2 ≤ (p : ℝ)) →
      a ≤ b → c ≤ d → 0 ≤ W → W ≤ z → 1 < z →
      0 ≤ q → q ≤ 1 → (∀ p ∈ P, 2 ≤ p) →
      (∑ S ∈ P.powerset, bernoulliSubsetWeight q P S *
        ((maskedPairBox a b c d m W z S).card : ℝ)) ≤
        K * (((b : ℝ)-a)*((d : ℝ)-c)/(m : ℝ)) *
          (∏ p ∈ primeBand 0 W, (1 - 1/(p : ℝ)))^2 *
          (∏ p ∈ primeBand 0 z, (1 - 1/(p : ℝ))) *
          (∏ p ∈ P, (1 + q/((p : ℝ)-1))) +
        ((m : ℝ)*(z^(10 : ℝ))^3 + (((b : ℝ)-a)+((d : ℝ)-c))*(z^(10 : ℝ))^2) := by
  obtain ⟨K, hK, hb⟩ := exists_masked_pair_box_upper
  refine ⟨K, hK, ?_⟩
  intro L a b c d m hm W z q P hL hmL hmin hab hcd hW hWz hz hq0 hq1 hP
  let M := K * (((b : ℝ)-a)*((d : ℝ)-c)/(m : ℝ)) *
    (∏ p ∈ primeBand 0 W, (1 - 1/(p : ℝ)))^2 * (∏ p ∈ primeBand 0 z, (1 - 1/(p : ℝ)))
  let E := (m : ℝ)*(z^(10 : ℝ))^3 + (((b : ℝ)-a)+((d : ℝ)-c))*(z^(10 : ℝ))^2
  have hbound (S : Finset ℕ) (hS : S ∈ P.powerset) :
      bernoulliSubsetWeight q P S * ((maskedPairBox a b c d m W z S).card : ℝ) ≤
        bernoulliSubsetWeight q P S * (M * (∏ p ∈ S, (1 - 1/(p : ℝ))⁻¹) + E) := by
    exact mul_le_mul_of_nonneg_left
      (hb L a b c d m W z S hL hmL hmin hab hcd hW hWz hz
        (fun p hp => hP p (mem_powerset.mp hS hp)))
      (bernoulliSubsetWeight_nonneg hq0 hq1 P S)
  have hid : (∑ S ∈ P.powerset, bernoulliSubsetWeight q P S *
        (M * (∏ p ∈ S, (1 - 1/(p : ℝ))⁻¹) + E)) =
      M * (∑ S ∈ P.powerset, bernoulliSubsetWeight q P S *
        (∏ p ∈ S, (1 - 1/(p : ℝ))⁻¹)) + E * (∑ S ∈ P.powerset, bernoulliSubsetWeight q P S) := by
    rw [mul_sum, mul_sum, ← sum_add_distrib]
    apply sum_congr rfl
    intro S _
    ring
  calc
    _ ≤ _ := sum_le_sum hbound
    _ = _ := hid
    _ = _ := by rw [bernoulli_mask_inverse_avoidance P q hP, sum_bernoulliSubsetWeight, mul_one]

end Bounty
end

section

/- A single finite physical pattern family for the raw row minus the
alternating prime-comparison rows. The raw pattern is kept explicitly. -/

open Finset
open scoped Classical

namespace Bounty

def repeatedBigPrimeProbeSlots {G : Type*} {J ell : ℕ}
    (probes : G → Finset (Fin J)) (g : G) : Finset (PhysicalSlots J ell) :=
  (probes g).map (Function.Embedding.inl (β := Fin ell))

abbrev RepeatedBigPrimePatternPair {G : Type*} [DecidableEq G] {J ell : ℕ}
    (probes : G → Finset (Fin J)) (r t : Finset G) :=
  ↥(cleanNonemptySubsets (r.sigma (repeatedBigPrimeProbeSlots (ell := ell) probes))) ×
    ↥(cleanNonemptySubsets (t.sigma (repeatedBigPrimeProbeSlots (ell := ell) probes)))

abbrev RepeatedBigPrimePatternIndex {G : Type*} [DecidableEq G] {J ell : ℕ}
    (probes : G → Finset (Fin J)) (r t : Finset G) :=
  Unit ⊕ RepeatedBigPrimePatternPair (ell := ell) probes r t

theorem repeated_big_prime_pattern_pair_valid {G : Type*} [Fintype G] [DecidableEq G]
    {J ell : ℕ} (probes : G → Finset (Fin J)) (r t : Finset G) (hrt : Disjoint r t)
    (ab : RepeatedBigPrimePatternPair (ell := ell) probes r t) :
    ab.1.val ⊆ repeatedBigFlatActive J ell ∧
      ab.2.val ⊆ repeatedBigFlatActive J ell ∧ Disjoint ab.1.val ab.2.val := by
  have hsub (u : Finset G) :
      u.sigma (repeatedBigPrimeProbeSlots (ell := ell) probes) ⊆ repeatedBigFlatActive J ell := by
    rintro ⟨g, i⟩ hi
    rcases mem_map.mp (mem_sigma.mp hi).2 with ⟨j, _, rfl⟩
    exact repeatedBigFlatActive_mem_inl J ell g j
  have ha := ((clean_mem_nonempty_subsets _ _).mp ab.1.property).2
  have hb := ((clean_mem_nonempty_subsets _ _).mp ab.2.property).2
  refine ⟨ha.trans (hsub r), hb.trans (hsub t), ?_⟩
  apply disjoint_left.mpr
  intro i hi hj
  exact disjoint_left.mp hrt (mem_sigma.mp (ha hi)).1 (mem_sigma.mp (hb hj)).1

noncomputable def repeatedBigPrimePatternCut {G : Type*} [DecidableEq G] {J ell : ℕ}
    (probes : G → Finset (Fin J)) (r t : Finset G) :
    RepeatedBigPrimePatternIndex (ell := ell) probes r t → G → Finset (Fin J)
  | .inl _ => fun _ => ∅
  | .inr ab => repeatedBigAuxCut ab.1.val ab.2.val

noncomputable def repeatedBigPrimePatternWeight {G : Type*} [DecidableEq G] {J ell : ℕ}
    (probes : G → Finset (Fin J)) (r t : Finset G) :
    RepeatedBigPrimePatternIndex (ell := ell) probes r t → ℂ
  | .inl _ => 1
  | .inr ab => -(-1 : ℂ) ^ (ab.1.val.card + ab.2.val.card)

noncomputable def repeatedBigPrimePatternKernel {G : Type*}
    [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h : ℝ)
    (kept : Finset (RepeatedBigFlatIndex G J ell) → Finset ℤ) :
    ∀ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      RepeatedBigLists P J ell → RepeatedBigLists P J ell →
        PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i) → ℂ
  | .inl _ => fun _ _ _ => 1
  | .inr ab =>
      let hv := repeated_big_prime_pattern_pair_valid probes r t hrt ab
      repeatedBigPrimeCoefficient P V ab.1.val ab.2.val
        (repeated_big_active_pair_avoids_tail hv.1 hv.2.1) hv.2.2
        Q h (kept ab.1.val) (kept ab.2.val)

theorem repeated_big_prime_pattern_raw_row {G : Type*}
    [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h : ℝ)
    (kept : Finset (RepeatedBigFlatIndex G J ell) → Finset ℤ)
    (ζ Θ : ℝ) (source target : RepeatedBigLists P J ell) :
    (∑ aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut (ell := ell) probes r t (.inl ())),
      repeatedBigPrimePatternWeight (ell := ell) probes r t (.inl ()) *
        repeatedBigUnbannedKernel V (fun _ _ => 1)
          (repeatedBigPrimePatternCut (ell := ell) probes r t (.inl ())) ζ
          (repeatedBigPrimePatternKernel P V probes r t hrt Q h kept (.inl ())) aux source target *
        physicalReturnPhase Θ
          (repeatedBigD (repeatedBigPrimePatternCut (ell := ell) probes r t (.inl ())) source aux)) =
      repeatedBigPrimeRawRow P V ζ Θ source target := by
  simp only [repeatedBigPrimePatternWeight, one_mul]
  rfl

theorem repeated_big_prime_pattern_pair_row {G : Type*}
    [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h : ℝ)
    (kept : Finset (RepeatedBigFlatIndex G J ell) → Finset ℤ)
    (ζ Θ : ℝ) (source target : RepeatedBigLists P J ell)
    (ab : RepeatedBigPrimePatternPair (ell := ell) probes r t) :
    (∑ aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t (.inr ab)),
      repeatedBigPrimePatternWeight probes r t (.inr ab) *
        repeatedBigUnbannedKernel V (fun _ _ => 1)
          (repeatedBigPrimePatternCut probes r t (.inr ab)) ζ
          (repeatedBigPrimePatternKernel P V probes r t hrt Q h kept (.inr ab)) aux source target *
        physicalReturnPhase Θ
          (repeatedBigD (repeatedBigPrimePatternCut probes r t (.inr ab)) source aux)) =
      -(-1 : ℂ) ^ (ab.1.val.card + ab.2.val.card) *
        repeatedBigPrimeComparisonRow P V ab.1.val ab.2.val Q h kept kept ζ Θ source target := by
  have hv := repeated_big_prime_pattern_pair_valid probes r t hrt ab
  rw [repeatedBigPrimeComparisonRow_eq P V ab.1.val ab.2.val hv.1 hv.2.1 hv.2.2]
  change (∑ aux, -(-1 : ℂ) ^ (ab.1.val.card + ab.2.val.card) * _ * _) =
    -(-1 : ℂ) ^ (ab.1.val.card + ab.2.val.card) * (∑ aux, _ * _)
  rw [mul_sum]
  apply sum_congr rfl
  intro aux haux
  dsimp only [repeatedBigPrimePatternCut, repeatedBigPrimePatternKernel]
  ring

theorem repeated_big_prime_pattern_family_kernel {G : Type*}
    [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h : ℝ)
    (kept : Finset (RepeatedBigFlatIndex G J ell) → Finset ℤ)
    (ζ Θ : ℝ) (source target : RepeatedBigLists P J ell) :
    (∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      ∑ aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i),
        repeatedBigPrimePatternWeight probes r t i *
          repeatedBigUnbannedKernel V (fun _ _ => 1)
            (repeatedBigPrimePatternCut probes r t i) ζ
            (repeatedBigPrimePatternKernel P V probes r t hrt Q h kept i) aux source target *
          physicalReturnPhase Θ (repeatedBigD (repeatedBigPrimePatternCut probes r t i) source aux)) =
      repeatedBigPrimeDifferenceKernel P V probes r t Q h kept ζ Θ source target := by
  rw [Fintype.sum_sum_type]
  simp only [Fintype.sum_unique, repeated_big_prime_pattern_raw_row,
    repeated_big_prime_pattern_pair_row]
  rw [Fintype.sum_prod_type]
  simp only [repeatedBigPrimeDifferenceKernel, Pi.sub_apply, Finset.sum_apply,
    Pi.smul_apply, smul_eq_mul]
  rw [sub_eq_add_neg]
  congr 1
  simp only [neg_mul, ← sum_neg_distrib]
  let As := cleanNonemptySubsets (r.sigma (repeatedBigPrimeProbeSlots (ell := ell) probes))
  let Bs := cleanNonemptySubsets (t.sigma (repeatedBigPrimeProbeSlots (ell := ell) probes))
  let F := fun a b : Finset (RepeatedBigFlatIndex G J ell) =>
    -((-1 : ℂ) ^ (a.card + b.card) *
      repeatedBigPrimeComparisonRow P V a b Q h kept kept ζ Θ source target)
  change (∑ a : As, ∑ b : Bs, F a.val b.val) = ∑ a ∈ As, ∑ b ∈ Bs, F a b
  calc
    _ = ∑ a : As, ∑ b ∈ Bs, F a.val b := by
      apply sum_congr rfl
      intro a ha
      exact sum_coe_sort Bs (F a.val)
    _ = _ := sum_coe_sort As (fun a => ∑ b ∈ Bs, F a b)

theorem repeated_big_prime_pattern_family_action {G : Type*}
    [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h : ℝ)
    (kept : Finset (RepeatedBigFlatIndex G J ell) → Finset ℤ)
    (ζ Θ : ℝ) (u : RepeatedBigLists P J ell → ℂ) (source : RepeatedBigLists P J ell) :
    (∑ target, (∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      ∑ aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i),
        repeatedBigPrimePatternWeight probes r t i *
          repeatedBigUnbannedKernel V (fun _ _ => 1)
            (repeatedBigPrimePatternCut probes r t i) ζ
            (repeatedBigPrimePatternKernel P V probes r t hrt Q h kept i) aux source target *
          physicalReturnPhase Θ (repeatedBigD (repeatedBigPrimePatternCut probes r t i) source aux)) *
        u target) =
      ∑ target, repeatedBigPrimeDifferenceKernel P V probes r t Q h kept ζ Θ source target *
        u target := by
  simp only [repeated_big_prime_pattern_family_kernel]

end Bounty
end

section

/- An actual rough pair box avoiding the nonallowed shifted divisibility classes. -/

open Finset

namespace Bounty

noncomputable def oddMaskedPairBox (a b c d m : ℕ) (W z : ℝ) (A : Finset ℕ) : Finset (ℕ × ℕ) := by
  classical
  exact (pairSieveBaseBox a b c d m).filter (fun v =>
    (∀ p ∈ primeBand 0 W, ¬p ∣ v.1*v.2) ∧
    (∀ p ∈ primeBand 0 z, p ≠ 2 → ¬p ∣ m → p ∉ A → (v.1*v.2) % p ≠ 1 % p))

theorem odd_masked_pair_box_subset (a b c d m : ℕ) (W z : ℝ)
    (hW : 0 ≤ W) (hWz : W ≤ z) (A : Finset ℕ) :
    oddMaskedPairBox a b c d m W z A ⊆
      pairSieveAvoidance a b c d m (maskedPairPrimes m z)
        (maskedPairRoughFlag W) (maskedPairBannedFlag A) := by
  classical
  have hz := hW.trans hWz
  intro v hv
  obtain ⟨hvbase, hvrough, hvban⟩ := mem_filter.mp hv
  apply mem_filter.mpr
  refine ⟨hvbase, ?_⟩
  intro p hp hbad
  obtain ⟨hprime, hpz, hp2, hpm⟩ := (mem_masked_pair_primes hz).mp hp
  rcases hbad with ⟨hr, hzero⟩ | ⟨hb, hone⟩
  · have hpW : (p : ℝ) ≤ W := by simpa [maskedPairRoughFlag] using hr
    exact hvrough p ((mem_primeBand_iff le_rfl hW p).mpr
      ⟨hprime, Nat.cast_pos.mpr hprime.pos, hpW⟩) (Nat.dvd_of_mod_eq_zero hzero)
  · have hpA : p ∉ A := by simpa [maskedPairBannedFlag] using hb
    exact hvban p ((mem_primeBand_iff le_rfl hz p).mpr
      ⟨hprime, Nat.cast_pos.mpr hprime.pos, hpz⟩) hp2 hpm hpA hone

theorem exists_odd_masked_pair_box_upper :
    ∃ K : ℝ, 0 < K ∧ ∀ (L : ℝ) (a b c d m : ℕ) [NeZero m]
      (W z : ℝ) (A : Finset ℕ),
      1 ≤ L → (m : ℝ) ≤ Real.exp L →
      (∀ p ∈ m.primeFactors, L^2 ≤ (p : ℝ)) →
      a ≤ b → c ≤ d → 0 ≤ W → W ≤ z → 1 < z →
      (∀ p ∈ A, 2 ≤ p) →
      ((oddMaskedPairBox a b c d m W z A).card : ℝ) ≤
        K * (((b : ℝ)-a)*((d : ℝ)-c)/(m : ℝ)) *
          (∏ p ∈ primeBand 0 W, (1 - 1/(p : ℝ)))^2 *
          (∏ p ∈ primeBand 0 z, (1 - 1/(p : ℝ))) *
          (∏ p ∈ A, (1 - 1/(p : ℝ))⁻¹) +
        ((m : ℝ)*(z^(10 : ℝ))^3 + (((b : ℝ)-a)+((d : ℝ)-c))*(z^(10 : ℝ))^2) := by
  classical
  obtain ⟨K, hK, hb⟩ := exists_finite_pair_sieve_product_upper
  refine ⟨K*(8*Real.exp 12), by positivity, ?_⟩
  intro L a b c d m hm W z A hL hmL hmin hab hcd hW hWz hz hA
  have hprop := fun (p : ℕ) (hp : p ∈ maskedPairPrimes m z) =>
    (mem_masked_pair_primes (zero_lt_one.trans hz).le).mp hp
  have hprime : ∀ p ∈ maskedPairPrimes m z, p.Prime := fun p hp => (hprop p hp).1
  have h3 : ∀ p ∈ maskedPairPrimes m z, 3 ≤ p := by
    intro p hp
    have h2 := (hprime p hp).two_le
    have hn := (hprop p hp).2.2.1
    omega
  have h := hb a b c d m (maskedPairPrimes m z) (maskedPairRoughFlag W) (maskedPairBannedFlag A)
    hab hcd hz hprime h3 (fun p hp => (hprop p hp).2.2.2) (fun p hp => (hprop p hp).2.1)
  have hrf : (maskedPairPrimes m z).filter (fun p => maskedPairRoughFlag W p = true) =
      maskedPairRoughPrimes m W z := by ext p; simp [maskedPairRoughPrimes, maskedPairRoughFlag]
  have hbf : (maskedPairPrimes m z).filter (fun p => maskedPairBannedFlag A p = true) =
      maskedPairBannedPrimes m z A := by ext p; simp [maskedPairBannedPrimes, maskedPairBannedFlag]
  rw [hrf, hbf] at h
  have hcard : ((oddMaskedPairBox a b c d m W z A).card : ℝ) ≤
      ((pairSieveAvoidance a b c d m (maskedPairPrimes m z)
        (maskedPairRoughFlag W) (maskedPairBannedFlag A)).card : ℝ) :=
    Nat.cast_le.mpr (card_le_card (odd_masked_pair_box_subset a b c d m W z hW hWz A))
  have hX : 0 ≤ (b : ℝ)-a := sub_nonneg.mpr (Nat.cast_le.mpr hab)
  have hY : 0 ≤ (d : ℝ)-c := sub_nonneg.mpr (Nat.cast_le.mpr hcd)
  have hc : 0 ≤ K * (((b : ℝ)-a)*((d : ℝ)-c)/(m : ℝ)) := by positivity
  have he := mul_le_mul_of_nonneg_left
    (masked_pair_euler_uniform_bound hL m (NeZero.ne m) hmL hmin W z hW hWz A hA) hc
  apply (hcard.trans h).trans
  apply add_le_add _ le_rfl
  convert he using 1 <;> ring

end Bounty
end

section

/- The original coefficient is retained exactly, including the zero-weight support. -/

open scoped Classical
namespace Bounty
section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, DecidableEq (P g)]
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ)
  (edgePhase : ∀ k, ((g : Fin N) → Finset (P g)) →
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) →
    FullActiveEdgeEvent n (S k) B (A k) (Δ k) (D k) x → ℂ)
  (hedge : ∀ k H x e,
    edgePhase k H x e =
      (if FullMixedLocalBirthAvoids (J := J) n S B A Δ D H (some (.inr k)) x e ∧
          FullMixedLocalBirthDistinct (J := J) n S B A Δ D (some (.inr k)) x e then 1 else 0) *
        edgePhase k (fun _ => ∅) x e)
  (ω : ∀ k c, A k c → ℝ) (μ : (g : Fin N) → P g → ℝ)
  (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
  (steps : List (Option (J ⊕ K)))
  (initial : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B →
    (g : Fin N) → Finset (P g))
  (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
  (p : FullPermutationMixedPath n S B A Δ D steps x)

include hedge in
theorem full_mixed_physical_weighted_phase_factor
    (hx : FullMixedLedgerCovers n B (initial x, x)) :
    let w := finiteEventPathWeight (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D)
      (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V) steps x p
    (w : ℂ) * (
    fullMixedLedgerInducedPhase n S B A Δ D steps initial
      (finiteEventLocalPhase
        (fun tag (s : FullMixedLedgerState n (M := M) B) =>
          FullPermutationMixedEvent n S B A Δ D tag s.2)
        (fullMixedLedgerTarget n S B A Δ D) (fullMixedLedgerPhase n S B A Δ D edgePhase) steps) x p) =
    (w : ℂ) * (
    (if ∀ (a : FullMixedBirthAddress S B steps) (z : (g : Fin N) × P g),
        fullMixedPathBirthLabel n S B A Δ D steps x p a = some z → z.2 ∉ initial x z.1
      then 1 else 0) *
    (if ∀ (a b : FullMixedBirthAddress S B steps) z,
        fullMixedPathBirthLabel n S B A Δ D steps x p a = some z →
        fullMixedPathBirthLabel n S B A Δ D steps x p b = some z → a = b
      then 1 else 0) *
    finiteEventLocalPhase (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D)
      (fullMixedBirthResidualPhase n S B A Δ D edgePhase) steps x p) := by
  dsimp only
  by_cases hw : finiteEventPathWeight (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D)
      (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V) steps x p = 0
  · simp only [hw, Complex.ofReal_zero, zero_mul]
  · rw [full_mixed_physical_path_phase_factor n S B A Δ D edgePhase hedge
      ω μ q ρ V steps initial x p hx hw]

end Full
end Bounty
end

section

/- Actual permutation and ghost events give the decoded mark relations. -/

namespace Bounty
section Physical
variable {I K : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)

theorem physical_encoded_permutation_marks
    (before after : Fin N → Finset (Fin J))
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (e : PhysicalFullLedgerEvent C k (none : Option (I ⊕ K)) s)
    (L R : PhysicalBoundedMarkState P J ell B)
    (hs : physicalBoundedMarkEncode before L = s)
    (ht : physicalBoundedMarkEncode after R = physicalFullLedgerEventTarget C k none s e) :
    R.1 = physicalPermuteLabels ((physicalTransitionPermutationEquiv before after).symm e.down) L.1 := by
  subst s
  have hfull := congrArg Prod.snd ht
  have hperm := physical_full_memory_transition_permute before after L.1 L.2.2
    ((physicalTransitionPermutationEquiv before after).symm e.down)
  rw [Equiv.apply_symm_apply] at hperm
  exact physical_full_state_labels_of_eq after _ _ _ _ (hfull.trans hperm.symm)

theorem physical_encoded_ghost_marks
    (cut : Fin N → Finset (Fin J)) (j : I)
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (e : PhysicalFullLedgerEvent C k (some (.inl j)) s)
    (L R : PhysicalBoundedMarkState P J ell B)
    (hs : physicalBoundedMarkEncode cut L = s)
    (ht : physicalBoundedMarkEncode cut R = physicalFullLedgerEventTarget C k (some (.inl j)) s e) :
    R.1 = L.1 := by
  subst s
  funext g
  apply Function.Embedding.ext
  intro a
  have h := congrArg (fun t => (t.2 g).1 ((physicalFullSlotIndex (cut g)).symm a)) ht
  change R.1 g (physicalFullSlotIndex (cut g) ((physicalFullSlotIndex (cut g)).symm a)) =
    ((fullPermutationMixedEventTarget _ _ _ _ _ _ (some (.inl j))
      (physicalFullMemoryState cut L.1 L.2.2) e) g).1 ((physicalFullSlotIndex (cut g)).symm a) at h
  have hg := fullPermutationMixedEventTarget_ghost_active
    (fun g (p : ↥(P g)) => p.val) (fun j g => physicalFullSharedIndices (C j g)) B
    (fun j _ => PhysicalAuxLabels P (C j)) (fun j => physicalFullEdgeDelta (C j) (k j))
    (fun j => physicalFullEdgeD (C j)) j (physicalFullMemoryState cut L.1 L.2.2) e g
  simpa only [physicalFullMemoryState, Equiv.apply_symm_apply] using
    h.trans (congrFun hg ((physicalFullSlotIndex (cut g)).symm a))

end Physical
end Bounty
