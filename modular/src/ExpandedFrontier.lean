open scoped BigOperators Classical
theorem finite_kernel_transform_nonzero_term {D X : Type*} [Fintype X]
    (μ : X → ℝ) (K : D → X → ℂ) (f : X → ℂ) (d : D)
    (hd : (∑ x, (μ x : ℂ) * K d x * f x) ≠ 0) :
    ∃ x, μ x ≠ 0 ∧ K d x ≠ 0 ∧ f x ≠ 0 := by
  obtain ⟨x, _, hx⟩ := Finset.exists_ne_zero_of_sum_ne_zero hd
  refine ⟨x, ?_, ?_, ?_⟩
  · intro he
    simp [he] at hx
  · intro he
    simp [he] at hx
  · intro he
    simp [he] at hx

theorem log_localized_kernel_transform_range {D X : Type*} [Fintype X]
    (π : D → ℝ) (τ : X → ℝ) (μ : X → ℝ) (K : D → X → ℂ) (f : X → ℂ)
    (hK : ∀ d x, K d x ≠ 0 →
      0 < π d ∧ 0 < τ x ∧ |Real.log (π d) - Real.log (τ x)| ≤ Real.log 2)
    {a b : ℝ} (hf : ∀ x, f x ≠ 0 → a ≤ τ x ∧ τ x ≤ b)
    (d : D) (hd : (∑ x, (μ x : ℂ) * K d x * f x) ≠ 0) :
    a / 2 ≤ π d ∧ π d ≤ 2 * b := by
  obtain ⟨x, _, hxK, hxf⟩ := finite_kernel_transform_nonzero_term μ K f d hd
  obtain ⟨hp, hq, hlog⟩ := hK d x hxK
  have hc := positive_log_distance_le_factor_two hp hq hlog
  have hs := hf x hxf
  constructor <;> linarith

theorem log_localized_kernel_transform_dyadic_support {D X : Type*} [Fintype X]
    (π : D → ℝ) (τ : X → ℝ) (μ : X → ℝ) (K : D → X → ℂ) (f : X → ℂ)
    (hK : ∀ d x, K d x ≠ 0 →
      0 < π d ∧ 0 < τ x ∧ |Real.log (π d) - Real.log (τ x)| ≤ Real.log 2)
    {U : ℝ} (hf : ∀ x, f x ≠ 0 → U ≤ τ x ∧ τ x ≤ 2 * U)
    (d : D) (hd : (∑ x, (μ x : ℂ) * K d x * f x) ≠ 0) :
    U / 2 ≤ π d ∧ π d ≤ 4 * U := by
  have h := log_localized_kernel_transform_range π τ μ K f hK hf d hd
  constructor <;> linarith

theorem log_localized_kernel_transform_zero_outside {D X : Type*} [Fintype X]
    (π : D → ℝ) (τ : X → ℝ) (μ : X → ℝ) (K : D → X → ℂ) (f : X → ℂ)
    (hK : ∀ d x, K d x ≠ 0 →
      0 < π d ∧ 0 < τ x ∧ |Real.log (π d) - Real.log (τ x)| ≤ Real.log 2)
    {U : ℝ} (hf : ∀ x, f x ≠ 0 → U ≤ τ x ∧ τ x ≤ 2 * U)
    (d : D) (hd : π d < U / 2 ∨ 4 * U < π d) :
    (∑ x, (μ x : ℂ) * K d x * f x) = 0 := by
  by_contra hn
  have hh := log_localized_kernel_transform_dyadic_support π τ μ K f hK hf d hn
  rcases hd with hd | hd <;> linarith
end

section
open scoped BigOperators Classical
theorem unit_test_modulation_ne_zero_iff {X : Type*}
    (χ f : X → ℂ) (hχ : ∀ x, ‖χ x‖ = 1) (x : X) :
    χ x * f x ≠ 0 ↔ f x ≠ 0 := by
  have hx : χ x ≠ 0 := by
    intro he
    have hn := hχ x
    simp [he] at hn
  simp only [ne_eq, mul_eq_zero, hx, false_or]

theorem unit_test_modulation_energy {X : Type*} [Fintype X]
    (μ : X → ℝ) (χ f : X → ℂ) (hχ : ∀ x, ‖χ x‖ = 1) :
    (∑ x, μ x * ‖χ x * f x‖ ^ 2) = ∑ x, μ x * ‖f x‖ ^ 2 := by
  simp only [norm_mul, hχ, one_mul]

theorem real_mellin_factor_norm (ζ p : ℝ) :
    ‖Complex.exp ((ζ * Real.log p : ℝ) * Complex.I)‖ = 1 := by
  rw [Complex.norm_exp]
  simp only [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, Complex.I_re,
    Complex.I_im, mul_zero, zero_mul, sub_self, Real.exp_zero]

theorem mellin_test_modulation_ne_zero_iff {X : Type*}
    (π : X → ℝ) (ζ : ℝ) (f : X → ℂ) (x : X) :
    Complex.exp ((ζ * Real.log (π x) : ℝ) * Complex.I) * f x ≠ 0 ↔ f x ≠ 0 :=
  unit_test_modulation_ne_zero_iff _ f (fun x => real_mellin_factor_norm ζ (π x)) x

theorem mellin_test_modulation_energy {X : Type*} [Fintype X]
    (π : X → ℝ) (μ : X → ℝ) (ζ : ℝ) (f : X → ℂ) :
    (∑ x, μ x * ‖Complex.exp ((ζ * Real.log (π x) : ℝ) * Complex.I) * f x‖ ^ 2) =
      ∑ x, μ x * ‖f x‖ ^ 2 :=
  unit_test_modulation_energy μ _ f (fun x => real_mellin_factor_norm ζ (π x))
end

section

open Finset
open scoped Classical

theorem finite_probe_complement_energy_add {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hμ : ∀ i x, 0 ≤ μ i x) (hmass : ∀ i, ∑ y, μ i y = 1)
    (U : Finset I) (f : (∀ i, X i) → ℂ) :
    finiteWeightedEnergy (finiteProductWeight μ) (f - finiteCoordinateComponent μ U U.toList f) +
      finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ U U.toList f) =
      finiteWeightedEnergy (finiteProductWeight μ) f := by
  have he := finite_weighted_orthogonal_energy (U.powerset.erase U) (finiteProductWeight μ)
    (fun x => prod_nonneg (fun i _ => hμ i (x i)))
    (fun S => finiteCoordinateComponent μ S U.toList f)
    (fun S hS T hT hST => finite_coordinate_components_orthogonal μ hmass U.toList S T
      (by simpa using mem_powerset.mp (mem_erase.mp hS).2)
      (by simpa using mem_powerset.mp (mem_erase.mp hT).2) hST f f)
  rw [clean_component_erase_sum] at he
  rw [he, sum_erase_add _ _ (show U ∈ U.powerset by simp)]
  simpa using finite_coordinate_component_energy_sum μ hμ hmass U.toList U.nodup_toList f

theorem finite_probe_complement_energy_le {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hμ : ∀ i x, 0 ≤ μ i x) (hmass : ∀ i, ∑ y, μ i y = 1)
    (U : Finset I) (f : (∀ i, X i) → ℂ) :
    finiteWeightedEnergy (finiteProductWeight μ) (f - finiteCoordinateComponent μ U U.toList f) ≤
      finiteWeightedEnergy (finiteProductWeight μ) f := by
  have he := finite_probe_complement_energy_add μ hμ hmass U f
  have hn : 0 ≤ finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ U U.toList f) :=
    sum_nonneg fun x _ => mul_nonneg (prod_nonneg fun i _ => hμ i (x i)) (sq_nonneg _)
  linarith

theorem finite_probe_complement_norm_le {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hμ : ∀ i x, 0 ≤ μ i x) (hmass : ∀ i, ∑ y, μ i y = 1)
    (U : Finset I) (f : (∀ i, X i) → ℂ) :
    Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (f - finiteCoordinateComponent μ U U.toList f)) ≤
      Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) f) :=
  Real.sqrt_le_sqrt (finite_probe_complement_energy_le μ hμ hmass U f)
end

