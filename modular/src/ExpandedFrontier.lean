section

/- Weighted Cauchy bounds with all integrability supplied by a uniform bound. -/

open MeasureTheory

namespace Bounty

theorem bounded_weighted_integral_square {μ : Measure ℝ} {κ F : ℝ → ℂ} {M : ℝ}
    (hκ : Integrable κ μ) (hF : AEStronglyMeasurable F μ)
    (hM : 0 ≤ M) (hFM : ∀ u, ‖F u‖ ≤ M) :
    Integrable (fun u => κ u * F u) μ ∧
    ‖∫ u, κ u * F u ∂μ‖^2 ≤
      (∫ u, ‖κ u‖ ∂μ) * ∫ u, ‖κ u‖ * ‖F u‖^2 ∂μ := by
  have hnorm : Integrable (fun u => ‖κ u‖ * ‖F u‖) μ := by
    apply (hκ.norm.mul_const M).mono' (hκ.aestronglyMeasurable.norm.mul hF.norm)
    filter_upwards [] with u
    change ‖‖κ u‖ * ‖F u‖‖ ≤ ‖κ u‖ * M
    rw [Real.norm_of_nonneg (mul_nonneg (norm_nonneg _) (norm_nonneg _))]
    exact mul_le_mul_of_nonneg_left (hFM u) (norm_nonneg _)
  have hsq : Integrable (fun u => ‖κ u‖ * ‖F u‖^2) μ := by
    apply (hκ.norm.mul_const (M^2)).mono' (hκ.aestronglyMeasurable.norm.mul (hF.norm.pow 2))
    filter_upwards [] with u
    change ‖‖κ u‖ * ‖F u‖^2‖ ≤ ‖κ u‖ * M^2
    rw [Real.norm_of_nonneg (mul_nonneg (norm_nonneg _) (sq_nonneg _))]
    apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
    simpa only [pow_two] using mul_le_mul (hFM u) (hFM u) (norm_nonneg _) hM
  have hint : Integrable (fun u => κ u * F u) μ := by
    apply hnorm.mono' (hκ.aestronglyMeasurable.mul hF)
    filter_upwards [] with u
    change ‖κ u * F u‖ ≤ ‖κ u‖ * ‖F u‖
    exact (norm_mul _ _).le
  refine ⟨hint, ?_⟩
  let A := ∫ u, ‖κ u‖ ∂μ
  let B := ∫ u, ‖κ u‖ * ‖F u‖ ∂μ
  let C := ∫ u, ‖κ u‖ * ‖F u‖^2 ∂μ
  have hA : 0 ≤ A := integral_nonneg (fun u => norm_nonneg _)
  have hB : 0 ≤ B := integral_nonneg (fun u => mul_nonneg (norm_nonneg _) (norm_nonneg _))
  have hbound : ‖∫ u, κ u * F u ∂μ‖ ≤ B := by
    simpa only [B, norm_mul] using norm_integral_le_integral_norm (fun u => κ u * F u)
  have hquad (x : ℝ) : 0 ≤ C - 2*x*B + x^2*A := by
    have hq : 0 ≤ ∫ u, ‖κ u‖ * (‖F u‖ - x)^2 ∂μ :=
      integral_nonneg (fun u => mul_nonneg (norm_nonneg (κ u)) (sq_nonneg (‖F u‖ - x)))
    have heq : (fun u => ‖κ u‖ * (‖F u‖ - x)^2) =
        (fun u => (‖κ u‖*‖F u‖^2 - (2*x)*(‖κ u‖*‖F u‖)) + x^2*‖κ u‖) := by
      funext u
      ring
    have hlin : Integrable (fun u => (2*x)*(‖κ u‖*‖F u‖)) μ := hnorm.const_mul _
    have hcon : Integrable (fun u => x^2*‖κ u‖) μ := hκ.norm.const_mul _
    have hsub : Integrable (fun u => ‖κ u‖*‖F u‖^2 - (2*x)*(‖κ u‖*‖F u‖)) μ :=
      hsq.sub hlin
    rw [heq, integral_add hsub hcon, integral_sub hsq hlin,
      integral_const_mul, integral_const_mul] at hq
    exact hq
  have hBC : B^2 ≤ A*C := by
    by_cases hAz : A = 0
    · have hBM : B ≤ M*A := by
        calc
          B ≤ ∫ u, ‖κ u‖*M ∂μ := integral_mono hnorm (hκ.norm.mul_const M)
            (fun u => mul_le_mul_of_nonneg_left (hFM u) (norm_nonneg _))
          _ = M*A := by rw [integral_mul_const]; ring
      have hBz : B = 0 := by rw [hAz, mul_zero] at hBM; exact le_antisymm hBM hB
      rw [hBz,hAz]
      simp
    · have hq := mul_nonneg hA (hquad (B/A))
      have heq : A * (C - 2*(B/A)*B + (B/A)^2*A) = A*C - B^2 := by
        field_simp
        ring
      rw [heq] at hq
      nlinarith
  exact (pow_le_pow_left₀ (norm_nonneg _) hbound 2).trans hBC

end Bounty
end

section

/- Polynomial bounds for the number and denominators of the actual rational arcs. -/

open Finset
namespace Bounty

theorem rational_major_arc_polynomial_count {L q K : ℝ} {k : ℤ}
    (hL : 5 ≤ L) (hq : 0 ≤ q) (hK : 0 ≤ K)
    (hk : (k.natAbs : ℝ) ≤ L^K) :
    (⌊L^q⌋₊ : ℝ)*(2*((⌊L^q⌋₊*(k.natAbs+1) : ℕ) : ℝ)+1) ≤
      L^(2*q+K+1) := by
  have hLp : 0 < L := by linarith
  have hL1 : 1 ≤ L := by linarith
  have hq1 : 1 ≤ L^q := Real.one_le_rpow hL1 hq
  have hK1 : 1 ≤ L^K := Real.one_le_rpow hL1 hK
  have hf : (⌊L^q⌋₊ : ℝ) ≤ L^q := Nat.floor_le (by positivity)
  have hh : 1 ≤ L^q*L^K := by
    simpa using mul_le_mul hq1 hK1 zero_le_one (by positivity : 0 ≤ L^q)
  push_cast
  calc
    (⌊L^q⌋₊ : ℝ)*(2*((⌊L^q⌋₊ : ℝ)*((k.natAbs : ℝ)+1))+1) ≤
        L^q*(2*(L^q*(2*L^K))+1) := by gcongr; linarith
    _ ≤ 5*(L^q*L^q*L^K) := by nlinarith [Real.rpow_pos_of_pos hLp q]
    _ ≤ L*(L^q*L^q*L^K) := mul_le_mul_of_nonneg_right hL (by positivity)
    _ = L^(2*q+K+1) := by
      calc
        _ = L*L^(q+q+K) := by
          rw [Real.rpow_add hLp (q+q) K, Real.rpow_add hLp q q]
        _ = L^(1+(q+q+K)) := by
          rw [Real.rpow_add hLp 1 (q+q+K), Real.rpow_one]
        _ = _ := by congr 1; ring

theorem rational_major_arc_denominator {L q K : ℝ} {k : ℤ}
    (hL : 0 < L) (hk : k ≠ 0) (hkB : (k.natAbs : ℝ) ≤ L^K)
    {r : ℕ} (hr : r ∈ Icc 1 ⌊L^q⌋₊) :
    0 < k.natAbs*r ∧ ((k.natAbs*r : ℕ) : ℝ) ≤ L^(K+q) := by
  have hrp : 0 < r := (mem_Icc.mp hr).1
  have hkp : 0 < k.natAbs := Int.natAbs_pos.mpr hk
  refine ⟨Nat.mul_pos hkp hrp, ?_⟩
  have hrf : (r : ℝ) ≤ (⌊L^q⌋₊ : ℝ) := by exact_mod_cast (mem_Icc.mp hr).2
  have hrB : (r : ℝ) ≤ L^q := hrf.trans (Nat.floor_le (by positivity))
  push_cast
  rw [Real.rpow_add hL]
  exact mul_le_mul hkB hrB (by positivity) (by positivity)

end Bounty
end

section

/- Square-energy transfer from an approximation and its error. -/

open MeasureTheory

namespace Bounty

theorem integral_square_le_twice_error_add_approximation
    (μ : Measure ℝ) (f g : ℝ → ℂ)
    (hf : Integrable (fun t => ‖f t‖^2) μ)
    (he : Integrable (fun t => ‖f t - g t‖^2) μ)
    (hg : Integrable (fun t => ‖g t‖^2) μ) :
    (∫ t, ‖f t‖^2 ∂μ) ≤
      2*(∫ t, ‖f t - g t‖^2 ∂μ) + 2*(∫ t, ‖g t‖^2 ∂μ) := by
  calc
    _ ≤ ∫ t, 2*‖f t - g t‖^2 + 2*‖g t‖^2 ∂μ := by
      apply integral_mono hf ((he.const_mul 2).add (hg.const_mul 2))
      intro t
      change ‖f t‖^2 ≤ 2*‖f t - g t‖^2 + 2*‖g t‖^2
      have ht : ‖f t‖ ≤ ‖f t - g t‖ + ‖g t‖ := by
        simpa only [sub_add_cancel] using norm_add_le (f t - g t) (g t)
      have hs := pow_le_pow_left₀ (norm_nonneg (f t)) ht 2
      nlinarith only [hs, sq_nonneg (‖f t - g t‖ - ‖g t‖)]
    _ = _ := by
      rw [integral_add (he.const_mul 2) (hg.const_mul 2), integral_const_mul,
        integral_const_mul]

end Bounty
end

section

/- Integrated weighted Cauchy bounds for finite and dependent finite families. -/

open Finset MeasureTheory

namespace Bounty

theorem finite_weighted_family_energy_integrable {ι : Type*}
    (S : Finset ι) (c : ι → ℂ) (P : ι → ℝ → ℂ) (a b : ℝ)
    (hP : ∀ i ∈ S, ContinuousOn (P i) (Set.Icc a b)) :
    IntegrableOn (fun t => ‖∑ i ∈ S, c i * P i t‖^2) (Set.Icc a b) := by
  have hc : ContinuousOn (fun t => ∑ i ∈ S, c i * P i t) (Set.Icc a b) := by
    apply continuousOn_finsetSum
    intro i hi
    exact continuousOn_const.mul (hP i hi)
  exact (hc.norm.pow 2).integrableOn_Icc

theorem finite_weighted_family_energy_le {ι : Type*}
    (S : Finset ι) (c : ι → ℂ) (P : ι → ℝ → ℂ) (a b B : ℝ)
    (hP : ∀ i ∈ S, ContinuousOn (P i) (Set.Icc a b))
    (henergy : ∀ i ∈ S, (∫ t in Set.Icc a b, ‖P i t‖^2) ≤ B) :
    (∫ t in Set.Icc a b, ‖∑ i ∈ S, c i * P i t‖^2) ≤
      (∑ i ∈ S, ‖c i‖)^2 * B := by
  have hi : ∀ i ∈ S, IntegrableOn (fun t => ‖c i‖ * ‖P i t‖^2) (Set.Icc a b) := by
    intro i hi
    exact ((hP i hi).norm.pow 2).integrableOn_Icc.const_mul _
  have hsum : IntegrableOn (fun t => ∑ i ∈ S, ‖c i‖ * ‖P i t‖^2) (Set.Icc a b) :=
    integrable_finsetSum S hi
  have hpoint (t : ℝ) : ‖∑ i ∈ S, c i * P i t‖^2 ≤
      (∑ i ∈ S, ‖c i‖) * ∑ i ∈ S, ‖c i‖ * ‖P i t‖^2 := by
    simpa only [mul_one, div_one] using
      complex_row_weighted_cauchy S c (fun i => P i t) (fun _ => 1) (by intros; norm_num)
  calc
    _ ≤ ∫ t in Set.Icc a b,
        (∑ i ∈ S, ‖c i‖) * ∑ i ∈ S, ‖c i‖ * ‖P i t‖^2 :=
      integral_mono (finite_weighted_family_energy_integrable S c P a b hP)
        (hsum.const_mul _) hpoint
    _ = (∑ i ∈ S, ‖c i‖) *
        ∑ i ∈ S, ‖c i‖ * ∫ t in Set.Icc a b, ‖P i t‖^2 := by
      rw [integral_const_mul, integral_finsetSum S hi]
      simp only [integral_const_mul]
    _ ≤ (∑ i ∈ S, ‖c i‖) * ∑ i ∈ S, ‖c i‖ * B := by
      apply mul_le_mul_of_nonneg_left _ (sum_nonneg (by intros; positivity))
      exact sum_le_sum (fun i hi => mul_le_mul_of_nonneg_left (henergy i hi) (norm_nonneg _))
    _ = _ := by rw [← sum_mul]; ring

theorem dependent_weighted_family_energy_le {ι : Type*} {κ : ι → Type*}
    [∀ i, Fintype (κ i)] (S : Finset ι)
    (c : (i : ι) → κ i → ℂ) (P : (i : ι) → κ i → ℝ → ℂ) (a b B : ℝ)
    (hP : ∀ i ∈ S, ∀ j, ContinuousOn (P i j) (Set.Icc a b))
    (henergy : ∀ i ∈ S, ∀ j, (∫ t in Set.Icc a b, ‖P i j t‖^2) ≤ B) :
    (∫ t in Set.Icc a b, ‖∑ i ∈ S, ∑ j, c i j * P i j t‖^2) ≤
      (∑ i ∈ S, ∑ j, ‖c i j‖)^2 * B := by
  classical
  have h := finite_weighted_family_energy_le (S.sigma fun _ => univ)
    (fun q => c q.1 q.2) (fun q => P q.1 q.2) a b B
    (fun q hq => hP q.1 (mem_sigma.mp hq).1 q.2)
    (fun q hq => henergy q.1 (mem_sigma.mp hq).1 q.2)
  simpa only [sum_sigma] using h

end Bounty
end

section

/- The gap between the actual small- and big-prime exponents absorbs any
fixed polynomial and the retained-box mean-scale constant. -/

open Filter
namespace Bounty

theorem eventually_small_prime_scale_le_big (q : ℝ) :
    ∀ᶠ L : ℝ in atTop,
      4096 * Real.exp (L^(1/5 : ℝ)) * L^q ≤ Real.exp (L^(3/10 : ℝ)-1) := by
  filter_upwards [eventually_mul_rpow_le_exp_rpow q (4096*Real.exp 1)
      (c := (1/5 : ℝ)) (by norm_num),
    eventually_mul_rpow_log_add_le_rpow
      (a := (1/5 : ℝ)) (b := (3/10 : ℝ)) (c := 1)
      (by norm_num) (by norm_num) (by norm_num) 2 0,
    eventually_ge_atTop (Real.exp 1)] with L hpoly hscale hL
  have hL0 : 0 < L := (Real.exp_pos 1).trans_le hL
  have hlog : 1 ≤ Real.log L := by
    simpa only [Real.log_exp] using Real.log_le_log (Real.exp_pos 1) hL
  have hpower : 2*L^(1/5 : ℝ) ≤ L^(3/10 : ℝ) := by
    have hh := mul_le_mul_of_nonneg_left hlog
      (show 0 ≤ 2*L^(1/5 : ℝ) by positivity)
    simp only [mul_one, add_zero, one_mul] at hh hscale
    exact hh.trans hscale
  apply le_of_mul_le_mul_left (a := Real.exp 1)
  · calc
      Real.exp 1 * (4096*Real.exp (L^(1/5 : ℝ))*L^q) =
          (4096*Real.exp 1*L^q)*Real.exp (L^(1/5 : ℝ)) := by ring
      _ ≤ Real.exp (L^(1/5 : ℝ))*Real.exp (L^(1/5 : ℝ)) :=
        mul_le_mul_of_nonneg_right hpoly (Real.exp_pos _).le
      _ = Real.exp (2*L^(1/5 : ℝ)) := by rw [← Real.exp_add]; congr 1; ring
      _ ≤ Real.exp (L^(3/10 : ℝ)) := Real.exp_le_exp.mpr hpower
      _ = Real.exp 1 * Real.exp (L^(3/10 : ℝ)-1) := by
        rw [← Real.exp_add]
        congr 1
        ring
  · exact Real.exp_pos 1

end Bounty
end

section

/- Two finite coefficient expansions preserve a uniform bound with the product L1 cost. -/

open Finset
open scoped Classical
namespace Bounty

theorem finite_two_cell_expansion_norm {X Y : Type*} [Fintype X] [Fintype Y]
    (S T : Finset ℤ) (a b : ℤ → ℂ) (F : ℤ → X → ℤ → Y → ℂ)
    {A B E : ℝ} (hA : 0 ≤ A) (hE : 0 ≤ E)
    (ha : (∑ d ∈ S, ∑ _x : X, ‖a d‖) ≤ A)
    (hb : (∑ e ∈ T, ∑ _y : Y, ‖b e‖) ≤ B)
    (hF : ∀ d ∈ S, ∀ x, ∀ e ∈ T, ∀ y, ‖F d x e y‖ ≤ E) :
    ‖∑ d ∈ S, ∑ x : X, ∑ e ∈ T, ∑ y : Y, a d * b e * F d x e y‖ ≤ A*B*E := by
  calc
    _ ≤ ∑ d ∈ S, ∑ x : X, ∑ e ∈ T, ∑ y : Y,
        ‖a d‖ * ‖b e‖ * E := by
      apply (norm_sum_le _ _).trans
      apply sum_le_sum
      intro d hd
      apply (norm_sum_le _ _).trans
      apply sum_le_sum
      intro x _
      apply (norm_sum_le _ _).trans
      apply sum_le_sum
      intro e he
      apply (norm_sum_le _ _).trans
      apply sum_le_sum
      intro y _
      simpa only [norm_mul] using
        mul_le_mul_of_nonneg_left (hF d hd x e he y)
          (mul_nonneg (norm_nonneg _) (norm_nonneg _))
    _ = (∑ d ∈ S, ∑ _x : X, ‖a d‖) * (∑ e ∈ T, ∑ _y : Y, ‖b e‖) * E := by
      simp only [sum_mul]
      simp_rw [mul_sum, sum_mul]
    _ ≤ A*B*E := mul_le_mul_of_nonneg_right
      (mul_le_mul ha hb (sum_nonneg (fun _ _ => sum_nonneg (fun _ _ => norm_nonneg _))) hA) hE

end Bounty
end

section

/- The multiplicative large sieve for finite families of primitive Dirichlet characters. -/

open scoped BigOperators

namespace Bounty

theorem multiplicative_large_sieve (Q : Finset ℕ) {R N : ℝ} (hR : 1 ≤ R)
    (hQ0 : ∀ q ∈ Q, 0 < q) (hQR : ∀ q ∈ Q, (q : ℝ) ≤ R)
    (freq : Finset ℤ) (a : ℤ → ℂ) (hN : 0 ≤ N)
    (hfreq : ∀ n ∈ freq, |(n : ℝ)| ≤ N) :
    (∑ q ∈ Q, (q : ℝ) / q.totient *
      ∑ χ ∈ primitiveCharacters q, ‖∑ n ∈ freq, a n * χ (n : ZMod q)‖ ^ 2) ≤
      (6 + 8 * Real.pi) * (N + R ^ 2) * ∑ n ∈ freq, ‖a n‖ ^ 2 := by
  calc
    _ ≤ ∑ q ∈ Q, ∑ k ∈ reducedResidues q,
        ‖finiteFourierSum freq a ((k : ℝ) / q)‖ ^ 2 := by
      apply Finset.sum_le_sum
      intro q hq
      have h := @primitive_character_sum_sq_le_additive q ⟨(hQ0 q hq).ne'⟩
        ℤ freq a (fun n => (n : ZMod q))
      exact h.trans_eq (@sum_unit_stdAddChar_energy_eq_reducedResidues q
        ⟨(hQ0 q hq).ne'⟩ freq a)
    _ ≤ _ := additive_large_sieve_moduli Q hR hQ0 hQR freq a hN hfreq

theorem multiplicative_large_sieve_Icc {R N : ℝ} (hR : 1 ≤ R)
    (freq : Finset ℤ) (a : ℤ → ℂ) (hN : 0 ≤ N)
    (hfreq : ∀ n ∈ freq, |(n : ℝ)| ≤ N) :
    (∑ q ∈ Finset.Icc 1 ⌊R⌋₊, (q : ℝ) / q.totient *
      ∑ χ ∈ primitiveCharacters q, ‖∑ n ∈ freq, a n * χ (n : ZMod q)‖ ^ 2) ≤
      (6 + 8 * Real.pi) * (N + R ^ 2) * ∑ n ∈ freq, ‖a n‖ ^ 2 := by
  apply multiplicative_large_sieve _ hR _ _ freq a hN hfreq
  · intro q hq
    exact (Finset.mem_Icc.mp hq).1
  · intro q hq
    exact (Nat.le_floor_iff (zero_le_one.trans hR)).mp (Finset.mem_Icc.mp hq).2

end Bounty
end

section

/- Regrouping large conductors by the complementary squarefree modulus. -/

open Finset

namespace Bounty

theorem large_conductor_mass_le_complementary (N R : ℕ) (F : ℕ → ℕ → ℝ)
    (hF : ∀ f h, 0 ≤ F f h) :
    (∑ d ∈ (Icc 1 N).filter Squarefree,
      ∑ f ∈ d.divisors.filter (fun f => 1 < f ∧ R < f),
        F f (d / f) / (d.totient : ℝ)) ≤
      ∑ h ∈ (Icc 1 N).filter Squarefree, (1 / (h.totient : ℝ)) *
        ∑ f ∈ Icc (max 2 (R + 1)) (N / h), F f h / (f.totient : ℝ) := by
  classical
  let A := ((Icc 1 N).filter Squarefree).sigma
    (fun d => d.divisors.filter (fun f => 1 < f ∧ R < f))
  let B := ((Icc 1 N).filter Squarefree).sigma
    (fun h => Icc (max 2 (R + 1)) (N / h))
  let τ : (Σ _ : ℕ, ℕ) → (Σ _ : ℕ, ℕ) := fun v => ⟨v.1 / v.2, v.2⟩
  let G : (Σ _ : ℕ, ℕ) → ℝ := fun v =>
    (1 / (v.1.totient : ℝ)) * (F v.2 v.1 / (v.2.totient : ℝ))
  have hmem (v : Σ _ : ℕ, ℕ) (hv : v ∈ A) :
      1 ≤ v.1 ∧ v.1 ≤ N ∧ Squarefree v.1 ∧ v.2 ∣ v.1 ∧ 1 < v.2 ∧ R < v.2 := by
    obtain ⟨hd, hf⟩ := mem_sigma.mp hv
    obtain ⟨hdrange, hdsq⟩ := mem_filter.mp hd
    obtain ⟨hdiv, hf1, hfR⟩ := mem_filter.mp hf
    exact ⟨(mem_Icc.mp hdrange).1, (mem_Icc.mp hdrange).2, hdsq,
      (Nat.mem_divisors.mp hdiv).1, hf1, hfR⟩
  have hinj : Set.InjOn τ A := by
    intro v hv w hw heq
    have hquot : v.1 / v.2 = w.1 / w.2 := congrArg Sigma.fst heq
    have hf : v.2 = w.2 := by
      simpa only [τ] using congrArg (fun z : Σ _ : ℕ, ℕ => z.2) heq
    have hd : v.1 = w.1 := by
      calc
        v.1 = v.2 * (v.1 / v.2) := (Nat.mul_div_cancel' (hmem v hv).2.2.2.1).symm
        _ = w.2 * (w.1 / w.2) := by rw [hquot, hf]
        _ = w.1 := Nat.mul_div_cancel' (hmem w hw).2.2.2.1
    rcases v with ⟨d, f⟩
    rcases w with ⟨e, g⟩
    dsimp at hd hf
    subst e
    subst g
    rfl
  have hsub : A.image τ ⊆ B := by
    intro w hw
    obtain ⟨v, hv, rfl⟩ := mem_image.mp hw
    obtain ⟨hd0, hdN, hdsq, hfd, hf1, hfR⟩ := hmem v hv
    have hf0 : 0 < v.2 := by omega
    have hh0 : 0 < v.1 / v.2 := Nat.div_pos (Nat.le_of_dvd hd0 hfd) hf0
    apply mem_sigma.mpr
    constructor
    · apply mem_filter.mpr
      exact ⟨mem_Icc.mpr ⟨hh0, (Nat.div_le_self _ _).trans hdN⟩,
        hdsq.squarefree_of_dvd (Nat.div_dvd_of_dvd hfd)⟩
    · apply mem_Icc.mpr
      constructor
      · change max 2 (R + 1) ≤ v.2
        omega
      · change v.2 ≤ N / (v.1 / v.2)
        apply (Nat.le_div_iff_mul_le hh0).mpr
        rwa [Nat.mul_div_cancel' hfd]
  calc
    _ = ∑ v ∈ A, F v.2 (v.1 / v.2) / (v.1.totient : ℝ) := by
      simp only [A, sum_sigma]
    _ = ∑ v ∈ A, G (τ v) := by
      apply sum_congr rfl
      intro v hv
      obtain ⟨_, _, hdsq, hfd, _, _⟩ := hmem v hv
      dsimp [G, τ]
      rw [squarefree_conductor_quotient_totient _ _ hdsq hfd, Nat.cast_mul]
      simp only [div_eq_mul_inv, mul_inv_rev, one_mul]
      ring
    _ = ∑ v ∈ A.image τ, G v := (sum_image hinj).symm
    _ ≤ ∑ v ∈ B, G v := sum_le_sum_of_subset_of_nonneg hsub
      (fun v _ _ => mul_nonneg (by positivity) (div_nonneg (hF _ _) (by positivity)))
    _ = _ := by
      simp only [B, sum_sigma]
      apply sum_congr rfl
      intro h _
      dsimp only [G]
      rw [mul_sum]

noncomputable def complementaryConductorNormTerm {Ω : Type*} (f h : ℕ)
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) : ℝ := by
  classical
  exact ∑ ψ ∈ (univ : Finset (DirichletCharacter ℂ f)).filter
    (fun ψ => ψ.IsPrimitive ∧ ψ ≠ 1),
    ‖∑ t ∈ T.filter (fun t => (value t).Coprime h),
      μ t * ψ (value t : ZMod f)‖

theorem complementary_conductor_norm_nonneg {Ω : Type*} (f h : ℕ)
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) :
    0 ≤ complementaryConductorNormTerm f h T μ value := by
  unfold complementaryConductorNormTerm
  positivity

theorem primitive_conductor_norm_eq_complementary {Ω : Type*} (d f : ℕ)
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) :
    primitiveConductorNormTerm d f T μ value =
      complementaryConductorNormTerm f (d / f) T μ value := rfl

theorem large_primitive_conductor_mass_le_complementary {Ω : Type*} (N R : ℕ)
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) :
    (∑ d ∈ (Icc 1 N).filter Squarefree,
      largePrimitiveConductorNormSum d R T μ value / (d.totient : ℝ)) ≤
      ∑ h ∈ (Icc 1 N).filter Squarefree, (1 / (h.totient : ℝ)) *
        ∑ f ∈ Icc (max 2 (R + 1)) (N / h),
          complementaryConductorNormTerm f h T μ value / (f.totient : ℝ) := by
  have h := large_conductor_mass_le_complementary N R
    (fun f h => complementaryConductorNormTerm f h T μ value)
    (fun f h => complementary_conductor_norm_nonneg f h T μ value)
  simpa only [largePrimitiveConductorNormSum, sum_div,
    primitive_conductor_norm_eq_complementary] using h

theorem candidate_large_primitive_mass_le_complementary (c L q : ℝ)
    (r jStar N R : ℕ) :
    candidateLargePrimitiveTypeIMass c L q r jStar N R ≤
      ∑ h ∈ (Icc 1 N).filter Squarefree, (1 / (h.totient : ℝ)) *
        ∑ f ∈ Icc (max 2 (R + 1)) (N / h),
          complementaryConductorNormTerm f h (arithmeticProductWindow 1 (Real.exp L))
            (fun u => (candidateCoefficient c L q r jStar u : ℂ)) (fun u => u) /
              (f.totient : ℝ) := by
  apply le_trans _ (large_primitive_conductor_mass_le_complementary N R
    (arithmeticProductWindow 1 (Real.exp L))
    (fun u => (candidateCoefficient c L q r jStar u : ℂ)) (fun u => u))
  unfold candidateLargePrimitiveTypeIMass
  apply sum_le_sum_of_subset_of_nonneg
  · intro d hd
    exact mem_filter.mpr ⟨(mem_filter.mp hd).1, (mem_filter.mp hd).2.1⟩
  · intro d _ _
    exact div_nonneg (large_primitive_conductor_norm_nonneg d R _ _ _) (Nat.cast_nonneg _)

end Bounty
end

section

/- Disjoint rectangle layers preserve the square-root energy bound. -/

open Finset

namespace Bounty

theorem disjoint_list_mass_le {α : Type*} (L : List (Finset α))
    (M : Finset α) (w : α → ℝ) (hw : ∀ x, 0 ≤ w x)
    (hpair : L.Pairwise Disjoint) (hsub : ∀ A ∈ L, A ⊆ M) :
    (L.map (fun A => ∑ x ∈ A, w x)).sum ≤ ∑ x ∈ M, w x := by
  classical
  induction L generalizing M with
  | nil => simpa using sum_nonneg (fun x _ => hw x)
  | cons A L ih =>
    obtain ⟨hAL, hLL⟩ := List.pairwise_cons.mp hpair
    have hAM : A ⊆ M := hsub A List.mem_cons_self
    have hLM : ∀ B ∈ L, B ⊆ M \ A := by
      intro B hB x hx
      apply mem_sdiff.mpr
      refine ⟨hsub B (List.mem_cons_of_mem A hB) hx, ?_⟩
      intro hxA
      exact disjoint_left.mp (hAL B hB) hxA hx
    calc
      (List.map (fun A => ∑ x ∈ A, w x) (A :: L)).sum =
          (∑ x ∈ A, w x) + (L.map (fun B => ∑ x ∈ B, w x)).sum := rfl
      _ ≤ (∑ x ∈ A, w x) + ∑ x ∈ M \ A, w x := add_le_add le_rfl (ih _ hLL hLM)
      _ = ∑ x ∈ M, w x := by rw [add_comm, sum_sdiff hAM]

theorem disjoint_rectangle_layer_sqrt_le {α β : Type*}
    (L : List (Finset α × Finset β)) (M : Finset α) (N : Finset β)
    (a : α → ℝ) (b : β → ℝ) (ha : ∀ m, 0 ≤ a m) (hb : ∀ n, 0 ≤ b n)
    (hpair : L.Pairwise (fun r s => Disjoint r.1 s.1 ∧ Disjoint r.2 s.2))
    (hsub : ∀ r ∈ L, r.1 ⊆ M ∧ r.2 ⊆ N) :
    (L.map (fun r => Real.sqrt ((∑ m ∈ r.1, a m) * ∑ n ∈ r.2, b n))).sum ≤
      Real.sqrt ((∑ m ∈ M, a m) * ∑ n ∈ N, b n) := by
  classical
  have hrow : (L.map (fun r => ∑ m ∈ r.1, a m)).sum ≤ ∑ m ∈ M, a m := by
    simpa only [List.map_map, Function.comp_def] using
      disjoint_list_mass_le (L.map Prod.fst) M a ha
        (List.pairwise_map.mpr (hpair.imp (fun h => h.1)))
        (by intro A hA; obtain ⟨r, hr, rfl⟩ := List.mem_map.mp hA; exact (hsub r hr).1)
  have hcol : (L.map (fun r => ∑ n ∈ r.2, b n)).sum ≤ ∑ n ∈ N, b n := by
    simpa only [List.map_map, Function.comp_def] using
      disjoint_list_mass_le (L.map Prod.snd) N b hb
        (List.pairwise_map.mpr (hpair.imp (fun h => h.2)))
        (by intro A hA; obtain ⟨r, hr, rfl⟩ := List.mem_map.mp hA; exact (hsub r hr).2)
  have hcs := Real.sum_sqrt_mul_sqrt_le (univ : Finset (Fin L.length))
    (f := fun i => ∑ m ∈ L[i.val].1, a m)
    (g := fun i => ∑ n ∈ L[i.val].2, b n)
    (fun _ => sum_nonneg (fun m _ => ha m))
    (fun _ => sum_nonneg (fun n _ => hb n))
  have hcs' :
      (L.map (fun r => Real.sqrt (∑ m ∈ r.1, a m) *
        Real.sqrt (∑ n ∈ r.2, b n))).sum ≤
      Real.sqrt ((L.map (fun r => ∑ m ∈ r.1, a m)).sum) *
        Real.sqrt ((L.map (fun r => ∑ n ∈ r.2, b n)).sum) := by
    have hconv (f : Finset α × Finset β → ℝ) :
        (∑ i : Fin L.length, f L[i.val]) = (L.map f).sum := by
      rw [← List.sum_ofFn]
      exact congrArg List.sum (List.ofFn_getElem_eq_map L f)
    rw [← hconv, ← hconv, ← hconv]
    exact hcs
  calc
    _ = (L.map (fun r => Real.sqrt (∑ m ∈ r.1, a m) *
        Real.sqrt (∑ n ∈ r.2, b n))).sum := by
      congr 1
      apply List.map_congr_left
      intro r hr
      exact Real.sqrt_mul (sum_nonneg (fun m _ => ha m)) _
    _ ≤ Real.sqrt ((L.map (fun r => ∑ m ∈ r.1, a m)).sum) *
        Real.sqrt ((L.map (fun r => ∑ n ∈ r.2, b n)).sum) := hcs'
    _ ≤ Real.sqrt (∑ m ∈ M, a m) * Real.sqrt (∑ n ∈ N, b n) :=
      mul_le_mul (Real.sqrt_le_sqrt hrow) (Real.sqrt_le_sqrt hcol)
        (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)
    _ = _ := (Real.sqrt_mul (sum_nonneg (fun m _ => ha m)) _).symm

theorem disjoint_rectangle_layer_bound {α β : Type*}
    (L : List (Finset α × Finset β)) (M : Finset α) (N : Finset β)
    (a : α → ℝ) (b : β → ℝ) (ha : ∀ m, 0 ≤ a m) (hb : ∀ n, 0 ≤ b n)
    (hpair : L.Pairwise (fun r s => Disjoint r.1 s.1 ∧ Disjoint r.2 s.2))
    (hsub : ∀ r ∈ L, r.1 ⊆ M ∧ r.2 ⊆ N)
    (f : Finset α × Finset β → ℝ) {C : ℝ} (hC : 0 ≤ C)
    (hf : ∀ r ∈ L, f r ≤ C * Real.sqrt ((∑ m ∈ r.1, a m) * ∑ n ∈ r.2, b n)) :
    (L.map f).sum ≤ C * Real.sqrt ((∑ m ∈ M, a m) * ∑ n ∈ N, b n) := by
  calc
    _ ≤ (L.map (fun r => C * Real.sqrt ((∑ m ∈ r.1, a m) * ∑ n ∈ r.2, b n))).sum :=
      List.sum_le_sum hf
    _ = C * (L.map (fun r => Real.sqrt ((∑ m ∈ r.1, a m) * ∑ n ∈ r.2, b n))).sum :=
      List.sum_map_mul_left _ _ _
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (disjoint_rectangle_layer_sqrt_le L M N a b ha hb hpair hsub) hC


theorem subadditive_list_sum_le {E : Type*} [AddCommMonoid E]
    (p : E → ℝ) (hp0 : p 0 = 0) (hpadd : ∀ x y, p (x + y) ≤ p x + p y)
    (L : List E) : p L.sum ≤ (L.map p).sum := by
  induction L with
  | nil => simp [hp0]
  | cons x L ih =>
    simpa only [List.sum_cons, List.map_cons] using
      (hpadd x L.sum).trans (add_le_add le_rfl ih)

theorem subadditive_finset_sum_le {α E : Type*} [AddCommMonoid E]
    (p : E → ℝ) (hp0 : p 0 = 0) (hpadd : ∀ x y, p (x + y) ≤ p x + p y)
    (S : Finset α) (f : α → E) : p (∑ x ∈ S, f x) ≤ ∑ x ∈ S, p (f x) := by
  classical
  induction S using Finset.induction_on with
  | empty => simp [hp0]
  | @insert x S hx ih =>
    simp only [sum_insert hx]
    exact (hpadd _ _).trans (add_le_add le_rfl ih)

theorem dyadic_prefix_subadditive_bound {α E : Type*} [AddCommMonoid E]
    (K : ℕ) (M : Finset α) (κ : α → ℕ) (hκ : ∀ m ∈ M, κ m ≤ 2 ^ K)
    (a : α → ℝ) (b : ℕ → ℝ) (ha : ∀ m, 0 ≤ a m) (hb : ∀ n, 0 ≤ b n)
    (F : α → ℕ → E) (p : E → ℝ) (hp0 : p 0 = 0)
    (hpadd : ∀ x y, p (x + y) ≤ p x + p y)
    {C : ℝ} (hC : 0 ≤ C)
    (hrect : ∀ A ⊆ M, ∀ B ⊆ range (2 ^ K),
      p (∑ m ∈ A, ∑ n ∈ B, F m n) ≤
        C * Real.sqrt ((∑ m ∈ A, a m) * ∑ n ∈ B, b n)) :
    p (∑ m ∈ M, ∑ n ∈ range (κ m), F m n) ≤
      (K + 1 : ℝ) * C * Real.sqrt ((∑ m ∈ M, a m) * ∑ n ∈ range (2 ^ K), b n) := by
  classical
  rw [dyadicPrefixLayer_weighted_sum K M κ hκ F]
  calc
    _ ≤ ∑ d ∈ range (K + 1), p (prefixLayerSum F (dyadicPrefixLayer K d M κ)) :=
      subadditive_finset_sum_le p hp0 hpadd _ _
    _ ≤ ∑ d ∈ range (K + 1),
        C * Real.sqrt ((∑ m ∈ M, a m) * ∑ n ∈ range (2 ^ K), b n) := by
      apply sum_le_sum
      intro d hd
      have htri := subadditive_list_sum_le p hp0 hpadd
        ((dyadicPrefixLayer K d M κ).map (prefixRectangleSum F))
      simp only [List.map_map, Function.comp_def] at htri
      apply htri.trans
      apply disjoint_rectangle_layer_bound _ M (range (2 ^ K)) a b ha hb
        (dyadicPrefixLayer_pairwise K d M κ) (dyadicPrefixLayer_bounds K d M κ) _ hC
      intro r hr
      obtain ⟨hrM, hrN⟩ := dyadicPrefixLayer_bounds K d M κ r hr
      exact hrect r.1 hrM r.2 hrN
    _ = _ := by simp [sum_const, nsmul_eq_mul]; ring


end Bounty
end

section

/- The actual candidate coefficient tested against arbitrary complex functions. -/

open Finset Filter
open scoped Topology

namespace Bounty

theorem candidate_coefficient_complex_test_of_free (c L q : ℝ) (r jStar : ℕ) (F : ℕ → ℂ)
    (hfree : ∀ n, candidateQWeight c L r jStar n ≠ 0 →
      n ≠ 0 ∧ Disjoint n.primeFactors
        ((candidatePIndices c L).biUnion (candidatePBand (c * L)))) :
    (∑ u ∈ arithmeticProductWindow 1 (Real.exp L),
        (candidateCoefficient c L q r jStar u : ℂ) * F u) =
      ∑ p ∈ candidateSmallPSet c L (16 * Real.exp L + 1),
        (candidatePWeight c L q p : ℂ) *
          ∑ n ∈ arithmeticProductWindow p (Real.exp L), (candidateQWeight c L r jStar n : ℂ) * F (p*n) := by
  symm
  apply supported_free_window_complex_test_eq
    ((candidatePIndices c L).biUnion (candidatePBand (c * L)))
    (candidateSmallPSet c L (16 * Real.exp L + 1))
    (candidatePWeight c L q) (candidateQWeight c L r jStar)
    (candidateCoefficient c L q r jStar) F (Real.exp L)
  · intro p hp
    exact ((mem_candidateSmallPSet_iff c L _ p).mp hp).2
  · exact hfree
  · intro p hp n hn
    exact candidate_coefficient_mul_of_free c L q r jStar
      ((mem_candidateSmallPSet_iff c L _ p).mp hp).2 (hfree n hn).1 (hfree n hn).2
  · intro u hu hWu
    let P := (candidatePIndices c L).biUnion (candidatePBand (c * L))
    let p := primePoolPart P u
    let n := primePoolFreePart P u
    have hurange : Real.exp L < (u : ℝ) ∧ (u : ℝ) ≤ 16 * Real.exp L := by
      simpa only [one_mul] using
        (mem_arithmeticProductWindow_iff one_ne_zero (Real.exp L)).mp hu
    have hu0 : u ≠ 0 := by
      have hpos : (0 : ℝ) < u := (Real.exp_pos L).trans hurange.1
      exact_mod_cast ne_of_gt hpos
    have hpu : p ≤ u := Nat.le_of_dvd (Nat.pos_of_ne_zero hu0) (primePoolPart_dvd P u)
    have hpSupport : p ∈ Nat.factoredNumbers P := primePoolPart_mem_factoredNumbers P u
    have hpn : p * n = u := primePoolPart_mul_primePoolFreePart P u
    have hp : p ∈ candidateSmallPSet c L (16 * Real.exp L + 1) := by
      apply (mem_candidateSmallPSet_iff c L _ p).mpr
      refine ⟨?_, hpSupport⟩
      have hpuR : (p : ℝ) ≤ u := Nat.cast_le.mpr hpu
      linarith [hurange.2]
    have hn : n ∈ arithmeticProductWindow p (Real.exp L) := by
      apply (mem_arithmeticProductWindow_iff (primePoolPart_ne_zero P u) (Real.exp L)).mpr
      change Real.exp L < (p * n : ℕ) ∧ (p * n : ℕ) ≤ 16 * Real.exp L
      simpa only [hpn] using hurange
    exact ⟨p, hp, n, hn, left_ne_zero_of_mul hWu, hpn⟩

/- The threshold is uniform over the test function and all auxiliary parameters. -/
theorem eventually_candidate_coefficient_complex_test {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ) (F : ℕ → ℂ),
      (∑ u ∈ arithmeticProductWindow 1 (Real.exp L),
        (candidateCoefficient c L q r jStar u : ℂ) * F u) =
        ∑ p ∈ candidateSmallPSet c L (16 * Real.exp L + 1),
          (candidatePWeight c L q p : ℂ) *
            ∑ n ∈ arithmeticProductWindow p (Real.exp L),
              (candidateQWeight c L r jStar n : ℂ) * F (p*n) := by
  filter_upwards [eventually_candidate_P_pool_below_rough_cutoff hc,
    eventually_ge_atTop (0 : ℝ)] with L hpool hL
  intro q r jStar F
  apply candidate_coefficient_complex_test_of_free
  intro n hn
  obtain ⟨x, hx⟩ := ordered_slot_weight_ne_zero_support _ _ hn
  refine ⟨?_, ?_⟩
  · rw [← hx]
    exact prod_ne_zero_iff.mpr
      (fun slot _ => candidate_Q_slot_nonzero c L r jStar slot (x slot).property)
  · rw [← hx]
    exact candidate_Q_tuple_primeFactors_disjoint (mul_nonneg hc.le hL) hpool x

end Bounty

end

section

/- A natural-prime index for complex one-slot extraction. -/

open Finset

namespace Bounty

theorem ordered_slot_complex_window_split_finset {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (i : I) (normalization : ℝ) (S : Finset ℕ) (F : ℕ → ℂ) :
    (∑ n ∈ S, (orderedSlotWeight choices normalization n : ℂ) * F n) =
      ∑ p ∈ choices i, ∑ y : ∀ j : {j : I // j ≠ i}, choices j.val,
        if p * orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y ∈ S then
          (1 / (normalization : ℂ)) *
            F (p * orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y) else 0 := by
  rw [ordered_slot_complex_window_split choices i normalization S F]
  exact Finset.sum_coe_sort (choices i) (fun p =>
    ∑ y : ∀ j : {j : I // j ≠ i}, choices j.val,
      if p * orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y ∈ S then
        (1 / (normalization : ℂ)) *
          F (p * orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y) else 0)

end Bounty

end

section

/- Exact coordinate omission for the asymmetric fresh-label comparison. -/

namespace Bounty

open Finset
open scoped Classical

theorem finite_shared_density_update_left {I : Type*} [DecidableEq I] {X : I → Type*}
    (μ : ∀ i, X i → ℝ) (s : Finset I) (i : I) (hi : i ∉ s)
    (x y : ∀ i, X i) (v : X i) :
    finiteSharedDensity μ s (Function.update x i v) y = finiteSharedDensity μ s x y := by
  unfold finiteSharedDensity
  apply prod_congr rfl
  intro j hj
  have hji : j ≠ i := fun he => hi (he ▸ hj)
  rw [Function.update_of_ne hji]

theorem finite_shared_density_update_right {I : Type*} [DecidableEq I] {X : I → Type*}
    (μ : ∀ i, X i → ℝ) (s : Finset I) (i : I) (hi : i ∉ s)
    (x y : ∀ i, X i) (v : X i) :
    finiteSharedDensity μ s x (Function.update y i v) = finiteSharedDensity μ s x y := by
  unfold finiteSharedDensity
  apply prod_congr rfl
  intro j hj
  have hji : j ≠ i := fun he => hi (he ▸ hj)
  rw [Function.update_of_ne hji]

theorem finite_asymmetric_density_update_left {I : Type*} [DecidableEq I] {X : I → Type*}
    (μ : ∀ i, X i → ℝ) (shared A B : Finset I)
    (F : (∀ i : shared, X i.val) → (∀ i : A, X i.val) → (∀ i : B, X i.val) → ℂ)
    (i : I) (his : i ∉ shared) (hiB : i ∉ B) (x y : ∀ i, X i) (v : X i) :
    finiteAsymmetricDensity μ shared A B F (Function.update x i v) y =
      finiteAsymmetricDensity μ shared A B F x y := by
  simp only [finiteAsymmetricDensity, finite_shared_density_update_left μ shared i his,
    finite_coordinate_restrict_update shared i his, finite_coordinate_restrict_update B i hiB]

theorem finite_asymmetric_density_update_right {I : Type*} [DecidableEq I] {X : I → Type*}
    (μ : ∀ i, X i → ℝ) (shared A B : Finset I)
    (F : (∀ i : shared, X i.val) → (∀ i : A, X i.val) → (∀ i : B, X i.val) → ℂ)
    (i : I) (his : i ∉ shared) (hiA : i ∉ A) (x y : ∀ i, X i) (v : X i) :
    finiteAsymmetricDensity μ shared A B F x (Function.update y i v) =
      finiteAsymmetricDensity μ shared A B F x y := by
  simp only [finiteAsymmetricDensity, finite_shared_density_update_right μ shared i his,
    finite_coordinate_restrict_update A i hiA]

theorem finite_asymmetric_components_zero {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)]
    (μ : ∀ i, X i → ℝ) (hmass : ∀ i, ∑ v, μ i v = 1)
    (shared U V S T A B : Finset I) (hS : S ⊆ U) (hT : T ⊆ V)
    (hA : A ⊆ U) (hB : B ⊆ V) (hAB : Disjoint A B)
    (hsA : Disjoint shared A) (hsB : Disjoint shared B)
    (hμ : ∀ i ∈ shared, ∀ v, μ i v ≠ 0)
    (F : (∀ i : shared, X i.val) → (∀ i : A, X i.val) → (∀ i : B, X i.val) → ℂ)
    (f g : (∀ i, X i) → ℂ) (hnot : ¬(A ⊆ U \ S ∧ B ⊆ V \ T)) :
    cleanKernelPairing (finiteProductWeight μ) (finiteAsymmetricKernel μ shared A B F)
      (finiteCoordinateComponent μ S U.toList f)
      (finiteCoordinateComponent μ T V.toList g) = 0 := by
  have heq : finiteAsymmetricKernel μ shared A B F =
      fun x y => (finiteProductWeight μ y : ℂ) * finiteAsymmetricDensity μ shared A B F x y := by
    funext x y
    exact finite_asymmetric_kernel_eq_density μ shared A B hμ F x y
  rw [heq]
  apply clean_kernel_components_zero_of_not_admissible μ hmass U V S T A B hS hT hA hB
    (finiteAsymmetricDensity μ shared A B F) f g
  · intro i hi x y v
    exact finite_asymmetric_density_update_left μ shared A B F i
      (fun hs => disjoint_left.mp hsA hs hi) (fun hb => disjoint_left.mp hAB hi hb) x y v
  · intro i hi x y v
    exact finite_asymmetric_density_update_right μ shared A B F i
      (fun hs => disjoint_left.mp hsB hs hi) (fun ha => disjoint_left.mp hAB ha hi) x y v
  · exact hnot

noncomputable def finiteAsymmetricComparisonKernel {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} (μ : ∀ i, X i → ℝ) (active : Finset I)
    (F : ∀ A B : Finset I, (∀ i : ↥(active \ (A ∪ B)), X i.val) →
      (∀ i : A, X i.val) → (∀ i : B, X i.val) → ℂ) (A B : Finset I) :
    (∀ i, X i) → (∀ i, X i) → ℂ :=
  finiteAsymmetricKernel μ (active \ (A ∪ B)) A B (F A B)

theorem finite_asymmetric_comparison_components_zero {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)]
    (μ : ∀ i, X i → ℝ) (hmass : ∀ i, ∑ v, μ i v = 1) (hμ : ∀ i v, μ i v ≠ 0)
    (active U V S T A B : Finset I) (hUV : Disjoint U V)
    (hS : S ⊆ U) (hT : T ⊆ V) (hA : A ⊆ U) (hB : B ⊆ V)
    (F : ∀ A B : Finset I, (∀ i : ↥(active \ (A ∪ B)), X i.val) →
      (∀ i : A, X i.val) → (∀ i : B, X i.val) → ℂ)
    (f g : (∀ i, X i) → ℂ) (hnot : ¬(A ⊆ U \ S ∧ B ⊆ V \ T)) :
    cleanKernelPairing (finiteProductWeight μ) (finiteAsymmetricComparisonKernel μ active F A B)
      (finiteCoordinateComponent μ S U.toList f)
      (finiteCoordinateComponent μ T V.toList g) = 0 := by
  apply finite_asymmetric_components_zero μ hmass (active \ (A ∪ B)) U V S T A B hS hT hA hB
  · exact hUV.mono hA hB
  · apply disjoint_left.mpr
    intro i hs hi
    exact (mem_sdiff.mp hs).2 (mem_union_left B hi)
  · apply disjoint_left.mpr
    intro i hs hi
    exact (mem_sdiff.mp hs).2 (mem_union_right A hi)
  · intro i _ v
    exact hμ i v
  · exact hnot

end Bounty
end

section

/- Full continuations at a fixed physical target list are recovered from
raw ledger/memory, and coincide with the true full target on contributing
edge events. -/

open scoped Classical
namespace Bounty

section Physical
variable {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin N → Finset (Fin J)) (R : PhysicalMarkLists P J ell)

noncomputable def physicalFullContinuation
    (F : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ) :=
  fixedActiveRawExtension (fun g (p : ↥(P g)) => p.val) B
    (fun g i => R g (physicalFullSlotIndex (C g) i)) F

theorem physical_full_continuation_decode
    (F : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ)
    (H : (g : Fin N) → Finset ↥(P g)) (x : PhysicalFullBoundedState P J ell B) :
    physicalFullContinuation C R F
      (fullMixedLedgerDecode (fun g (p : ↥(P g)) => p.val) B (H, x)) =
      F (H, physicalFullMemoryState C R (fun g => (x g).2)) :=
  fixed_active_raw_extension_decode _ _ _ F (H, x)

end Physical

section Edge
variable {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin N → Finset (Fin J)) (k : ℤ) (L R : PhysicalMarkLists P J ell)
  (H : (g : Fin N) → Finset ↥(P g))
  (q : (g : Fin N) → BoundedOrderedTuple
    (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B)
  (ω : ∀ _c : SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C g)), PhysicalAuxLabels P C → ℝ)
  (μ : (g : Fin N) → ↥(P g) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
  (e : PhysicalFullEdgeEvent C k (physicalFullMemoryState C L q))

theorem physical_full_edge_continuation_of_nonzero
    (hw : fullActiveEdgeEventWeight (fun g (p : ↥(P g)) => p.val)
      (fun g => physicalFullSharedIndices (C g)) B (fun _ => PhysicalAuxLabels P C)
      (physicalFullEdgeDelta C k) (physicalFullEdgeD C) ω μ ρ V
      (physicalFullMemoryState C L q) e ≠ 0)
    (hp : physicalFullEdgePhase C k L R H q e ≠ 0)
    (F : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ) :
    let n := fun g (p : ↥(P g)) => p.val
    let S := fun g => physicalFullSharedIndices (ell := ell) (C g)
    let A := fun _ : SharedActiveLabels (fun g => ↥(P g)) S => PhysicalAuxLabels P C
    let x := physicalFullMemoryState C L q
    physicalFullContinuation C R F
      (fullEdgeLedgerRawTarget n S B A (physicalFullEdgeDelta C k) (physicalFullEdgeD C) H x e) =
      F (fullEdgeLedgerUpdate n S B A (physicalFullEdgeDelta C k) (physicalFullEdgeD C) H x e,
        fullActiveEdgeEventTarget n S B A (physicalFullEdgeDelta C k) (physicalFullEdgeD C) x e) := by
  dsimp only
  rw [show fullEdgeLedgerRawTarget (fun g (p : ↥(P g)) => p.val)
      (fun g => physicalFullSharedIndices (C g)) B (fun _ => PhysicalAuxLabels P C)
      (physicalFullEdgeDelta C k) (physicalFullEdgeD C) H (physicalFullMemoryState C L q) e =
      fullMixedLedgerDecode (fun g (p : ↥(P g)) => p.val) B
        (fullEdgeLedgerUpdate (fun g (p : ↥(P g)) => p.val)
          (fun g => physicalFullSharedIndices (C g)) B (fun _ => PhysicalAuxLabels P C)
          (physicalFullEdgeDelta C k) (physicalFullEdgeD C) H (physicalFullMemoryState C L q) e,
        fullActiveEdgeEventTarget (fun g (p : ↥(P g)) => p.val)
          (fun g => physicalFullSharedIndices (C g)) B (fun _ => PhysicalAuxLabels P C)
          (physicalFullEdgeDelta C k) (physicalFullEdgeD C) (physicalFullMemoryState C L q) e) from rfl]
  rw [physical_full_continuation_decode]
  rw [← physical_full_edge_target_of_nonzero C k L R H q ω μ ρ V e hw hp]

theorem physical_full_edge_continuation_weighted
    (F : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ) :
    let n := fun g (p : ↥(P g)) => p.val
    let S := fun g => physicalFullSharedIndices (ell := ell) (C g)
    let A := fun _ : SharedActiveLabels (fun g => ↥(P g)) S => PhysicalAuxLabels P C
    let x := physicalFullMemoryState C L q
    let w := fullActiveEdgeEventWeight n S B A (physicalFullEdgeDelta C k)
      (physicalFullEdgeD C) ω μ ρ V x e
    (w : ℂ) * physicalFullEdgePhase C k L R H q e * physicalFullContinuation C R F
      (fullEdgeLedgerRawTarget n S B A (physicalFullEdgeDelta C k) (physicalFullEdgeD C) H x e) =
    (w : ℂ) * physicalFullEdgePhase C k L R H q e *
      F (fullEdgeLedgerUpdate n S B A (physicalFullEdgeDelta C k) (physicalFullEdgeD C) H x e,
        fullActiveEdgeEventTarget n S B A (physicalFullEdgeDelta C k) (physicalFullEdgeD C) x e) := by
  dsimp only
  by_cases hw : fullActiveEdgeEventWeight (fun g (p : ↥(P g)) => p.val)
      (fun g => physicalFullSharedIndices (C g)) B (fun _ => PhysicalAuxLabels P C)
      (physicalFullEdgeDelta C k) (physicalFullEdgeD C) ω μ ρ V
      (physicalFullMemoryState C L q) e = 0
  · simp only [hw, Complex.ofReal_zero, zero_mul]
  · by_cases hp : physicalFullEdgePhase C k L R H q e = 0
    · simp only [hp, mul_zero, zero_mul]
    · rw [physical_full_edge_continuation_of_nonzero C k L R H q ω μ ρ V e hw hp F]

end Edge
end Bounty
end

section

/- A ghost row carries a full-state continuation exactly through raw
memory: the active tuple is unchanged, even for invalid fallback events. -/

open Finset
namespace Bounty

section Full
variable {I K : Type*} {N : ℕ} {P : Fin N → Type*}
  [∀ g, DecidableEq (P g)] (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*) (Δ D : ∀ k c, A k c → Fin N → ℤ)

theorem full_mixed_ghost_continuation_target (j : I)
    (F : FullMixedLedgerState n (M := M) B → ℂ)
    (s : FullMixedLedgerState n (M := M) B)
    (e : FullPermutationMixedEvent n S B A Δ D (some (.inl j)) s.2) :
    fixedActiveRawExtension n B (fun g => (s.2 g).1) F
      (fullMixedLedgerDecode n B (fullMixedLedgerTarget n S B A Δ D (some (.inl j)) s e)) =
      F (fullMixedLedgerTarget n S B A Δ D (some (.inl j)) s e) := by
  apply fixed_active_raw_extension_self
  intro g
  exact fullPermutationMixedEventTarget_ghost_active n S B A Δ D j s.2 e g

variable [∀ g, Fintype (P g)] [∀ g p, NeZero (n g p)] [∀ k c, Fintype (A k c)]
  (edgePhase : ∀ k, ((g : Fin N) → Finset (P g)) →
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) →
    FullActiveEdgeEvent n (S k) B (A k) (Δ k) (D k) x → ℂ)
  (ω : ∀ k c, A k c → ℝ) (β : (g : Fin N) → P g → ℝ)
  (q : I → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

theorem full_mixed_raw_ghost_continuation (a : (g : Fin N) → P g → Bool)
    (hV : ∀ g, V g ≠ 0) (j : I) (F : FullMixedLedgerState n (M := M) B → ℂ)
    (s : FullMixedLedgerState n (M := M) B) :
    globalBirthJointCutRawRow
      (fun g => GlobalBirthRawStep.visit (a := a g) (fun _ => 0) (β g)
        (1 - q j) (V g) ρ (hV g) B) B B
      (fixedActiveRawExtension n B (fun g => (s.2 g).1) F) (fullMixedLedgerDecode n B s) =
    fullMixedLedgerRow n S B A Δ D edgePhase ω (fun g p => β g p / V g) q ρ V
      (some (.inl j)) F s := by
  refine (full_mixed_ledger_raw_visit_row n S B A Δ D edgePhase ω q ρ V β a hV j
    (fixedActiveRawExtension n B (fun g => (s.2 g).1) F) s).trans ?_
  unfold fullMixedLedgerRow finiteLocalPhasedRow
  apply sum_congr rfl
  intro e _
  dsimp only [Function.comp_apply]
  rw [full_mixed_ghost_continuation_target]

end Full
end Bounty
