/-! Direct weighted selected rows give the original full-path moment. -/

open Finset Classical
namespace Bounty
section Paths
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g (p : P g), NeZero p.val]
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => P g)
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → P g → ℝ) (q : Fin (n + 1) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
  (cut : ℕ → Fin N → Finset (Fin J))
  (w : PhysicalSelectedData P ell C → ℂ)
  [Fintype (PhysicalSelectedData P ell C)]

 theorem physical_direct_selected_rows_eq_weighted_moment
    (hV : ∀ g, V g ≠ 0)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hencode : ∀ i, PhysicalMarkRowEncoding C (physicalSelectedFineTag n i) (cut i) (cut (i + 1)))
    (f : PhysicalFullBoundedState P J ell B → ℂ)
    (L : PhysicalMarkLists P J ell)
    (memory : ∀ g, BoundedOrderedTuple (UnrestrictedResidueParticle (fun p : P g => p.val)) B) :
    let x := physicalFullMemoryState (cut 0) L memory
    (∑ d : PhysicalSelectedData P ell C, w d *
      finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
        (physicalSelectedFineRow C d.1 d.2.1 d.2.2.1 d.2.2.2 k β V ρ hV ω q)
        (4 * n + 1) ((fun s => f s.2) ∘ physicalBoundedMarkEncode (cut (4 * n + 1)))
        (L, fullActiveInitialLedger x, memory)) =
      physicalOriginalWeightedMoment C k ω β q ρ V cut w f x := by
  intro x
  let _ : ∀ t s, Fintype (PhysicalFullLedgerEvent (I := Fin (n + 1)) (P := P) (ell := ell) (B := B) C k t s) :=
    fun t s => physicalFullLedgerEventFintype C k t s
  rw [physical_direct_selected_weighted_fiber C k β V ρ hV ω q cut univ w hP hdis hencode]
  simp_rw [physical_direct_selector_eq_record_phase]
  rw [finite_event_path_action_map (PhysicalFullLedgerEvent (P := P) (ell := ell) (B := B) C k)
    (physicalFullLedgerEventTarget C k) (physicalSelectedFineTag n)
    (physicalFullLedgerEventWeight C k ω β q ρ V)]
  rw [physical_original_weighted_moment_eq_trace_action]
  change _ = finiteEventPathAction (PhysicalFullLedgerEvent C k)
    (physicalFullLedgerEventTarget C k) (physicalFullLedgerEventWeight C k ω β q ρ V)
    ((List.range (4 * n + 1)).map (physicalSelectedFineTag n))
    (physicalFullRecordedTracePhase C k ω β ρ V (physicalSelectedFineTag n) cut (4 * n + 1)
      (fun _ => []) (fun r _ => physicalSelectedDataRecordPhase C cut univ w r))
    (fun s => f s.2) (fullActiveInitialLedger x, x)
  congr 1
  funext s p
  rw [finite_event_path_map_local_phase]
  simp only [Equiv.apply_symm_apply]
  unfold physicalFullRecordedTracePhase
  rw [finite_recorded_schedule_phase_factor]
  simp only [List.nil_append]
  exact mul_comm _ _

 theorem physical_direct_initial_rows_eq_weighted_moment
    (hV : ∀ g, V g ≠ 0)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hencode : ∀ i, PhysicalMarkRowEncoding C (physicalSelectedFineTag n i) (cut i) (cut (i + 1)))
    (L : PhysicalMarkLists P J ell) :
    (∑ d : PhysicalSelectedData P ell C, w d *
      finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
        (physicalSelectedFineRow C d.1 d.2.1 d.2.2.1 d.2.2.2 k β V ρ hV ω q)
        (4 * n + 1) physicalEmptyMemoryTerminal (physicalInitialMarkState B L)) =
      physicalOriginalWeightedMoment C k ω β q ρ V cut w fullMemoryVacuum
        (physicalFullMemoryState (cut 0) L
          (fun g => fullEmptyBoundedMemory (UnrestrictedResidueParticle (fun p : P g => p.val)) B)) := by
  have h := physical_direct_selected_rows_eq_weighted_moment C k ω β q ρ V cut w
    hV hP hdis hencode fullMemoryVacuum L
    (fun g => fullEmptyBoundedMemory (UnrestrictedResidueParticle (fun p : P g => p.val)) B)
  dsimp only at h
  simp only [Function.comp_def, physical_full_vacuum_terminal_encode] at h
  simpa only [physical_full_initial_ledger, physicalInitialMarkState, fullEmptyBoundedMemory] using h

end Paths
