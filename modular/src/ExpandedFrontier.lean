/- The actual physical phase and empty-memory terminal satisfy every suffix symmetry hypothesis. -/

open Finset Classical
namespace Bounty

theorem physical_forest_suffix_symmetric
    {Ghost Edge : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    [∀ g, ∀ p : ↥(P g), NeZero p.val]
    (C : Edge → Fin N → Finset (Fin J)) (k : Edge → ℤ)
    (ω : ∀ a, SharedActiveLabels (fun g => ↥(P g))
      (fun g => physicalFullSharedIndices (ell := ell) (C a g)) → PhysicalAuxLabels P (C a) → ℝ)
    (μ : (g : Fin N) → ↥(P g) → ℝ) (q : Ghost → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (steps : List (Option (Ghost ⊕ Edge)))
    (initial : (g : Fin N) → Finset ↥(P g))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress
      (fun a g => physicalFullSharedIndices (ell := ell) (C a g)) B steps)))
    (θ : (Fin (Fintype.card (FullMixedBirthAddress
      (fun a g => physicalFullSharedIndices (ell := ell) (C a g)) B steps)) ×
      Fin (Fintype.card (FullMixedBirthAddress
      (fun a g => physicalFullSharedIndices (ell := ell) (C a g)) B steps))) → ℝ)
    (encode : ((g : Fin N) × ↥(P g)) → ℤ)
    (cut : Fin N → Finset (Fin J)) (terminalLedger : (g : Fin N) → Finset ↥(P g))
    (start : ℕ) :
    ProductMemorySymmetric
      (finiteOperatorListAction
        (fullMixedForestStageRow (fun g (p : ↥(P g)) => p.val)
          (fun a g => physicalFullSharedIndices (ell := ell) (C a g)) B
          (fun a _ => PhysicalAuxLabels P (C a))
          (fun a => physicalFullEdgeDelta (C a) (k a))
          (fun a => physicalFullEdgeD (C a)) ω μ q ρ V steps
          (fullMixedBirthResidualPhase (fun g (p : ↥(P g)) => p.val)
            (fun a g => physicalFullSharedIndices (ell := ell) (C a g)) B
            (fun a _ => PhysicalAuxLabels P (C a))
            (fun a => physicalFullEdgeDelta (C a) (k a))
            (fun a => physicalFullEdgeD (C a))
            (fun a H => physicalFullGlobalEdgePhase (C a) (k a) H (ω a) μ ρ V))
          initial code θ encode)
        ((List.finRange steps.length).drop start)
        (fun x => physicalRecordedTerminalExtension cut physicalEmptyMemoryTerminal
          (terminalLedger, x))) := by
  apply full_mixed_forest_suffix_symmetric
  · exact physical_residual_phase_memory_invariant C k ω μ ρ V
  · exact physical_recorded_empty_terminal_symmetric cut terminalLedger

theorem physical_weighted_forest_suffix_symmetric
    {Ghost Edge : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    [∀ g, ∀ p : ↥(P g), NeZero p.val]
    (C : Edge → Fin N → Finset (Fin J)) (k : Edge → ℤ)
    (ω : ∀ a, SharedActiveLabels (fun g => ↥(P g))
      (fun g => physicalFullSharedIndices (ell := ell) (C a g)) → PhysicalAuxLabels P (C a) → ℝ)
    (μ : (g : Fin N) → ↥(P g) → ℝ) (q : Ghost → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (Θ : ∀ a, ((g : Fin N) → Fin (J + ell) → ↥(P g)) →
      ((g : Fin N) → Fin (J + ell) → ↥(P g)) → PhysicalAuxLabels P (C a) → ℂ)
    (steps : List (Option (Ghost ⊕ Edge)))
    (initial : (g : Fin N) → Finset ↥(P g))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress
      (fun a g => physicalFullSharedIndices (ell := ell) (C a g)) B steps)))
    (θ : (Fin (Fintype.card (FullMixedBirthAddress
      (fun a g => physicalFullSharedIndices (ell := ell) (C a g)) B steps)) ×
      Fin (Fintype.card (FullMixedBirthAddress
      (fun a g => physicalFullSharedIndices (ell := ell) (C a g)) B steps))) → ℝ)
    (encode : ((g : Fin N) × ↥(P g)) → ℤ)
    (cut : Fin N → Finset (Fin J)) (terminalLedger : (g : Fin N) → Finset ↥(P g))
    (start : ℕ) :
    ProductMemorySymmetric
      (finiteOperatorListAction
        (fullMixedForestStageRow (fun g (p : ↥(P g)) => p.val)
          (fun a g => physicalFullSharedIndices (ell := ell) (C a g)) B
          (fun a _ => PhysicalAuxLabels P (C a))
          (fun a => physicalFullEdgeDelta (C a) (k a))
          (fun a => physicalFullEdgeD (C a)) ω μ q ρ V steps
          (fullMixedBirthResidualPhase (fun g (p : ↥(P g)) => p.val)
            (fun a g => physicalFullSharedIndices (ell := ell) (C a g)) B
            (fun a _ => PhysicalAuxLabels P (C a))
            (fun a => physicalFullEdgeDelta (C a) (k a))
            (fun a => physicalFullEdgeD (C a))
            (fun a H x e => physicalFullGlobalEdgePhase (C a) (k a) H (ω a) μ ρ V x e *
              physicalFullActiveFactor (C a) (k a) (Θ a) x e))
          initial code θ encode)
        ((List.finRange steps.length).drop start)
        (fun x => physicalRecordedTerminalExtension cut physicalEmptyMemoryTerminal
          (terminalLedger, x))) := by
  apply full_mixed_forest_suffix_symmetric
  · exact physical_weighted_residual_phase_memory_invariant C k ω μ ρ V Θ
  · exact physical_recorded_empty_terminal_symmetric cut terminalLedger

end Bounty
end

section

/- One shared pattern sequence packs the original edge and mark paths by groups. -/

open Finset
open scoped Classical
namespace Bounty

abbrev PhysicalSplitSelectedPaths {I : Type*} {N J ell n : ℕ} (P : Fin N → Finset ℕ)
    (small : Fin N → Prop) (patterns : Finset I) (C : I → Fin N → Finset (Fin J)) :=
  Σ pattern : Fin n → patterns,
    PhysicalGroupSelectedData (fun g : {g // small g} => P g.val) ell
      (fun j g => C (pattern j).val g.val) ×
    PhysicalGroupSelectedData (fun g : {g // ¬small g} => P g.val) ell
      (fun j g => C (pattern j).val g.val)

noncomputable def physicalPathGroupSplitEquiv
    {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    (small : Fin N → Prop) (patterns : Finset I) (C : I → Fin N → Finset (Fin J)) :
    (PhysicalMarkLists P J ell ×
      (Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)) ≃
    PhysicalSplitSelectedPaths (ell := ell) (n := n) P small patterns C :=
  (physicalPathSelectedEquiv patterns C).trans
    (Equiv.sigmaCongrRight fun pattern => physicalGroupSelectedSplit small
      (fun j => C (pattern j).val))

theorem physical_path_group_split_pattern
    {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    (small : Fin N → Prop) (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
    (L : PhysicalMarkLists P J ell)
    (p : Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) :
    (physicalPathGroupSplitEquiv small patterns C (L, p)).1 =
      fun j => (p j).1.2.2.1 := rfl

theorem physical_path_group_split_inverse_initial
    {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    (small : Fin N → Prop) (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
    (y : PhysicalSplitSelectedPaths (ell := ell) (n := n) P small patterns C) :
    ((physicalPathGroupSplitEquiv small patterns C).symm y).1 =
      (physicalMarkGroupSplit small P J ell).symm (y.2.1.2.1 0, y.2.2.2.1 0) := rfl

theorem physical_path_group_split_inverse_step
    {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    (small : Fin N → Prop) (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
    (y : PhysicalSplitSelectedPaths (ell := ell) (n := n) P small patterns C) (j : Fin n) :
    ((physicalPathGroupSplitEquiv small patterns C).symm y).2 j =
      (((physicalPermutationGroupSplit small J ell).symm
          (y.2.1.2.2.1 j, y.2.2.2.2.1 j),
        (physicalPermutationGroupSplit small J ell).symm
          (y.2.1.2.2.2 j, y.2.2.2.2.2 j),
        ⟨y.1 j, (physicalAuxGroupSplit small P J (C (y.1 j).val)).symm
          (y.2.1.1 j, y.2.2.1 j)⟩),
        (physicalMarkGroupSplit small P J ell).symm (y.2.1.2.1 j.succ, y.2.2.2.1 j.succ)) := rfl

noncomputable abbrev physicalGroupSelectedDataFintype
    {G : Type*} [Fintype G] {J ell n : ℕ} {P : G → Finset ℕ}
    (C : Fin n → G → Finset (Fin J)) : Fintype (PhysicalGroupSelectedData P ell C) := by
  letI : Fintype (PhysicalMarkLists P J ell) := inferInstance
  letI : Fintype (PhysicalPermutations G J ell) := inferInstance
  letI : ∀ j, Fintype (PhysicalAuxLabels P (C j)) := fun _ => inferInstance
  exact inferInstance

section Sums
variable {I R : Type*} [AddCommMonoid R] {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (small : Fin N → Prop) (patterns : Finset I) (C : I → Fin N → Finset (Fin J))

theorem physical_path_group_split_sum
    (F : PhysicalSplitSelectedPaths (ell := ell) (n := n) P small patterns C → R) :
    let := physicalLabeledPathFintype (P := P) (ell := ell) (n := n) patterns C
    let : ∀ pattern : Fin n → patterns,
      Fintype (PhysicalGroupSelectedData (fun g : {g // small g} => P g.val) ell
        (fun j g => C (pattern j).val g.val)) := fun pattern =>
          physicalGroupSelectedDataFintype (P := fun g : {g // small g} => P g.val)
            (fun j g => C (pattern j).val g.val)
    let : ∀ pattern : Fin n → patterns,
      Fintype (PhysicalGroupSelectedData (fun g : {g // ¬small g} => P g.val) ell
        (fun j g => C (pattern j).val g.val)) := fun pattern =>
          physicalGroupSelectedDataFintype (P := fun g : {g // ¬small g} => P g.val)
            (fun j g => C (pattern j).val g.val)
    (∑ L : PhysicalMarkLists P J ell,
      ∑ p : Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
        F (physicalPathGroupSplitEquiv small patterns C (L, p))) =
    ∑ pattern : Fin n → patterns,
      ∑ ds : PhysicalGroupSelectedData (fun g : {g // small g} => P g.val) ell
        (fun j g => C (pattern j).val g.val),
      ∑ db : PhysicalGroupSelectedData (fun g : {g // ¬small g} => P g.val) ell
        (fun j g => C (pattern j).val g.val), F ⟨pattern, ds, db⟩ := by
  let := physicalLabeledPathFintype (P := P) (ell := ell) (n := n) patterns C
  let : ∀ pattern : Fin n → patterns,
    Fintype (PhysicalGroupSelectedData (fun g : {g // small g} => P g.val) ell
      (fun j g => C (pattern j).val g.val)) := fun pattern =>
        physicalGroupSelectedDataFintype (P := fun g : {g // small g} => P g.val)
          (fun j g => C (pattern j).val g.val)
  let : ∀ pattern : Fin n → patterns,
    Fintype (PhysicalGroupSelectedData (fun g : {g // ¬small g} => P g.val) ell
      (fun j g => C (pattern j).val g.val)) := fun pattern =>
        physicalGroupSelectedDataFintype (P := fun g : {g // ¬small g} => P g.val)
          (fun j g => C (pattern j).val g.val)
  have h := (physicalPathGroupSplitEquiv (P := P) (ell := ell) (n := n) small patterns C).sum_comp F
  simpa only [Fintype.sum_prod_type, Fintype.sum_sigma] using h

end Sums
end Bounty
