  have hsb := physical_root_group_pools_disjoint groups e hdis
  dsimp only
  rw [physical_root_integrand_sum_eq_weighted_moment groups e patterns C hC V q ζ k K r θ p
    hP hdis hk β ρ hV hρ hB cut hencode]
  congr 1
  apply sum_congr rfl
  intro L _
  congr 1
  exact physical_root_weighted_moment_mixed_sum groups e patterns C hC k p
    (fun s => hP s.val) (fun g => hP (e.symm g).val) hsb V hq r ζ K θ
    (fun j _ aux => physicalAuxMass (fun g => V (e.symm g).val)
      (fun g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val) aux)
    (fun g z => β ⟨(e.symm g).val, z⟩)
    (fun j => physicalEndpointSchedule q (n + 1) j.val) ρ cut hencode
    (physicalFullMemoryState (cut 0) L
      (fun g => fullEmptyBoundedMemory
        (UnrestrictedResidueParticle (fun z : P (e.symm g).val => z.val)) B))
    (physical_full_state_injective (cut 0) L
      (fun g => fullEmptyBoundedMemory
        (UnrestrictedResidueParticle (fun z : P (e.symm g).val => z.val)) B))
