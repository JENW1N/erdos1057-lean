          (fullMixedIndexedBirthPerformed n S B A Δ D steps x)
          (fullMixedIndexedBirthValue n S B A Δ D steps encode x) code := by
  rw [← full_mixed_distinct_birth_path_expansion_same_some n S B A Δ D steps encode x paths
    (fun p => F p * fullMixedResidualPathWeight n S B A Δ D edgePhase ω μ q ρ V steps initial x p) hencode]
  apply sum_congr rfl
  intro p _
  rw [mul_assoc, full_mixed_physical_weighted_phase_factor n S B A Δ D edgePhase hedge
    ω μ q ρ V steps initial x p hx]
  unfold fullMixedResidualPathWeight
  split_ifs <;> ring

