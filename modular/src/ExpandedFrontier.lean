theorem physical_root_direct_integrand_sum_eq_weighted_moment
    {B : ℕ}
    [Fintype (PhysicalRootSmallPlanBigData groups patterns C hC p)]
    [Fintype (PhysicalSelectedData (fun g => P (e.symm g).val) ell
      (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val))]
    (hP : ∀ g a, a ∈ P g → Nat.Prime a)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hk : ∀ t < n + 1, ∀ i ∈ patterns, ∀ g a, a ∈ P g → ¬ (a : ℤ) ∣ k t i)
    (β : PhysicalPrime P → ℝ) (ρ : ℝ)
    (hV : ∀ g, V g ≠ 0) (hρ : ρ ≠ 0)
    (hB : (physicalPrimeGroups P groups).card ≤ B)
    (cut : ℕ → Fin M → Finset (Fin J))
    (hencode : ∀ i, PhysicalMarkRowEncoding
      (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val)
      (physicalSelectedFineTag (n + 1) i) (cut i) (cut (i + 1))) :
    let _ : ∀ g (z : P (e.symm g).val), NeZero z.val :=
      fun g z => inferInstanceAs (NeZero (⟨(e.symm g).val, z⟩ : PhysicalPrime P).2.val)
    let Pn := fun g => P (e.symm g).val
    let Cn := fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val
    let Vn := fun g => V (e.symm g).val
    let βn := fun (g : Fin M) (z : Pn g) => β ⟨(e.symm g).val, z⟩
    (∑ db : PhysicalRootSmallPlanBigData groups patterns C hC p,
      let old := physicalRootSmallPlanPath groups patterns C hC p db
      physicalRootMixedPathIntegrand groups patterns C V q ζ k K β B r θ old.1 old.2) =
    (physicalStateMass (fun g : ↥groupsᶜ => V g.val) J ell : ℂ) *
    ∑ L : PhysicalMarkLists Pn J ell,
      ((∏ g, ∏ s : PhysicalSlots J ell, βn g (L g s) / Vn g : ℝ) : ℂ) *
      physicalOriginalWeightedMoment Cn (physicalRootPlanMultiplier groups patterns C hC k p)
        (fun j _ aux => physicalAuxMass Vn (Cn j) aux) βn
        (fun j => physicalEndpointSchedule q (n + 1) j.val) ρ Vn cut
        (physicalRootNumberedCompleteWeight groups e patterns C hC V q ζ k K r θ p)
        fullMemoryVacuum
        (physicalFullMemoryState (cut 0) L
          (fun g => fullEmptyBoundedMemory (UnrestrictedResidueParticle (fun z : Pn g => z.val)) B)) := by
  let _ : ∀ g (z : P (e.symm g).val), NeZero z.val :=
    fun g z => inferInstanceAs (NeZero (⟨(e.symm g).val, z⟩ : PhysicalPrime P).2.val)
  dsimp only
  rw [← (physicalSelectedGroupReindex e (fun g => P g.val)
    (fun j (g : {g // g ∉ groupsᶜ}) => C (physicalRootSmallPlanPattern groups patterns C hC p j).val g.val)).symm.sum_comp
      (fun db => let old := physicalRootSmallPlanPath groups patterns C hC p db
        physicalRootMixedPathIntegrand groups patterns C V q ζ k K β B r θ old.1 old.2)]
  rw [physical_root_numbered_integrand_sum_selected_rows groups e patterns C hC V q ζ k K r θ p β hB
    hP hdis hk ρ hV hρ]
  congr 1
  apply sum_congr rfl
  intro L _
  congr 1
  exact physical_direct_initial_rows_eq_weighted_moment
    (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val)
    (physicalRootPlanMultiplier groups patterns C hC k p)
    (fun j _ aux => physicalAuxMass (fun g => V (e.symm g).val)
      (fun g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val) aux)
    (fun g z => β ⟨(e.symm g).val, z⟩)
    (fun j => physicalEndpointSchedule q (n + 1) j.val) ρ (fun g => V (e.symm g).val) cut
    (physicalRootNumberedCompleteWeight groups e patterns C hC V q ζ k K r θ p)
    (fun g => hV (e.symm g).val) (fun g => hP (e.symm g).val)
    (physical_numbered_big_pools_disjoint groups e hdis) hencode L

