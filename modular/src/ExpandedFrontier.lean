/- Signed full rows preserve memory symmetry with fixed initial avoidance and local birth factors. -/

open Finset Classical
namespace Bounty
section Row
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
    [∀ g, Fintype (P g)] [∀ g, DecidableEq (P g)]
    (n : (g : Fin N) → P g → ℕ) [∀ g p, NeZero (n g p)]
    {M : Fin N → ℕ} (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (ω : ∀ k c, A k c → ℝ) (μ : (g : Fin N) → P g → ℝ)
    (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

/-- An explicit event-correspondence hypothesis, not merely a bound on the phase. -/
def FullMixedPhaseMemoryInvariant
    (phase : ∀ (tag : Option (J ⊕ K)) s, FullPermutationMixedEvent n S B A Δ D tag s → ℂ) : Prop :=
  ∀ tag s τ e, phase tag (productMemoryReindex s τ)
    (fullMixedMemoryReindex n S B A Δ D tag s τ e) = phase tag s e

omit [∀ g, DecidableEq (P g)] in
theorem full_mixed_phased_row_symmetric
    (phase : ∀ (tag : Option (J ⊕ K)) s, FullPermutationMixedEvent n S B A Δ D tag s → ℂ)
    (hp : FullMixedPhaseMemoryInvariant n S B A Δ D phase)
    (tag : Option (J ⊕ K))
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
    ProductMemorySymmetric (finiteLocalPhasedRow (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) phase
      (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V) tag f) := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
    fullPermutationMixedEventFintype n S B A Δ D
  dsimp only
  intro s g τ
  rw [← product_memory_reindex_at s g τ]
  unfold finiteLocalPhasedRow
  rw [← (fullMixedMemoryReindex n S B A Δ D tag s
    (Function.update (fun h => Equiv.refl (Fin (s h).2.1.val)) g τ)).sum_comp]
  apply sum_congr rfl
  intro e _
  rw [full_mixed_reindex_weight, hp, full_mixed_reindex_test n S B A Δ D tag s _ e f hf]

noncomputable def fullMixedBirthLocalPhase
    (residual : ∀ (tag : Option (J ⊕ K)) s, FullPermutationMixedEvent n S B A Δ D tag s → ℂ)
    (initial : (g : Fin N) → Finset (P g))
    (ψ : ∀ (tag : Option (J ⊕ K)), (FullMixedLocalBirthAddress S B tag → Option ((g : Fin N) × P g)) → ℂ)
    (tag : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag s) : ℂ :=
  residual tag s e * (if FullMixedLocalBirthAvoids n S B A Δ D initial tag s e then 1 else 0) *
    ψ tag (fullMixedEventBirthLabel n S B A Δ D tag s e)

omit [∀ g, Fintype (P g)] [∀ g, DecidableEq (P g)]
  [∀ g p, NeZero (n g p)] [∀ k c, Fintype (A k c)] in
theorem full_mixed_birth_local_phase_invariant
    (residual : ∀ (tag : Option (J ⊕ K)) s, FullPermutationMixedEvent n S B A Δ D tag s → ℂ)
    (hp : FullMixedPhaseMemoryInvariant n S B A Δ D residual)
    (initial : (g : Fin N) → Finset (P g))
    (ψ : ∀ (tag : Option (J ⊕ K)), (FullMixedLocalBirthAddress S B tag → Option ((g : Fin N) × P g)) → ℂ) :
    FullMixedPhaseMemoryInvariant n S B A Δ D
      (fullMixedBirthLocalPhase n S B A Δ D residual initial ψ) := by
  intro tag s τ e
  unfold fullMixedBirthLocalPhase FullMixedLocalBirthAvoids
  rw [hp, full_mixed_reindex_birth_labels]

end Row
end Bounty
