/- Relabeling full-event keys preserves terminal states and the original signed real weights. -/

open scoped Classical
namespace Bounty
section Keys
variable {I K J G : Type*} {P : G → Type*}
  (n : ∀ g, P g → ℕ) {M : G → ℕ}
  (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → G → ℤ) (f : I → K)

theorem full_permutation_key_path_terminal (steps : List (Option (J ⊕ I)))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n (fun i => S (f i)) B (fun i => A (f i))
      (fun i => Δ (f i)) (fun i => D (f i)) steps x) :
    finiteEventPathTerminal _ (fullPermutationMixedEventTarget n S B A Δ D)
      (steps.map (Option.map (Sum.map id f))) x
      (fullPermutationKeyPathEquiv n S B A Δ D f steps x p) =
    finiteEventPathTerminal _ (fullPermutationMixedEventTarget n (fun i => S (f i)) B
      (fun i => A (f i)) (fun i => Δ (f i)) (fun i => D (f i))) steps x p := by
  let e := finiteEventPathEquiv _ _ _ _ id
    (fullPermutationKeyEventEquiv n S B A Δ D f)
    (fun tag x e => (full_permutation_key_target n S B A Δ D f tag x e).symm) steps x p
  exact (finite_event_path_map_terminal (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) (Option.map (Sum.map id f)) steps x e).symm.trans
    (finite_event_path_equiv_terminal _ _ _ _ id _ _ steps x p)

variable [Fintype G] [DecidableEq G]
  (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)

theorem full_permutation_key_weight
    (tag : Option (J ⊕ I))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n (fun i => S (f i)) B (fun i => A (f i))
      (fun i => Δ (f i)) (fun i => D (f i)) tag x) :
    fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V
      (tag.map (Sum.map id f)) x (fullPermutationKeyEventEquiv n S B A Δ D f tag x e) =
    fullPermutationMixedEventWeight n (fun i => S (f i)) B (fun i => A (f i))
      (fun i => Δ (f i)) (fun i => D (f i)) (fun i => ω (f i)) μ q ρ V tag x e := by
  cases tag with
  | none => rfl
  | some tag => cases tag <;> rfl

theorem full_permutation_key_path_weight (steps : List (Option (J ⊕ I)))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n (fun i => S (f i)) B (fun i => A (f i))
      (fun i => Δ (f i)) (fun i => D (f i)) steps x) :
    finiteEventPathWeight _ (fullPermutationMixedEventTarget n S B A Δ D)
      (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V)
      (steps.map (Option.map (Sum.map id f))) x
      (fullPermutationKeyPathEquiv n S B A Δ D f steps x p) =
    finiteEventPathWeight _ (fullPermutationMixedEventTarget n (fun i => S (f i)) B
      (fun i => A (f i)) (fun i => Δ (f i)) (fun i => D (f i)))
      (fullPermutationMixedEventWeight n (fun i => S (f i)) B (fun i => A (f i))
        (fun i => Δ (f i)) (fun i => D (f i)) (fun i => ω (f i)) μ q ρ V) steps x p := by
  let e := finiteEventPathEquiv _ _ _ _ id
    (fullPermutationKeyEventEquiv n S B A Δ D f)
    (fun tag x e => (full_permutation_key_target n S B A Δ D f tag x e).symm) steps x p
  exact (finite_event_path_map_weight (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) (Option.map (Sum.map id f))
    (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V) steps x e).symm.trans
    (finite_event_path_equiv_weight _ _ _ _ id _ _ _ _
      (full_permutation_key_weight n S B A Δ D f ω μ q ρ V) steps x p)

end Keys
end Bounty
