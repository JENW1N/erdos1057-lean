open scoped BigOperators Classical
theorem rational_phase_zmod {r : ℕ} [NeZero r] (u : ℤ) (n : ℕ) :
    (AddChar.zmod r (u : ZMod r) (n : ZMod r) : ℂ) =
      Complex.exp (Complex.I * (2 * Real.pi * ((u : ℝ) / r * n) : ℝ)) := by
  have ht := congrArg (fun z : Circle => (z : ℂ)) (AddChar.zmod_intCast r u (n : ℤ))
  simp only [Int.cast_natCast, Circle.coe_exp] at ht
  rw [ht]
  congr 1
  push_cast
  ring

theorem rational_unit_character_expansion {r Q : ℕ} (hr : 0 < r) (hrQ : r ≤ Q)
    (u : ℤ) :
    ∃ c : AddChar (Additive (ZMod r)ˣ) ℂ → ℂ,
      (∑ ψ, ‖c ψ‖) ≤ Real.sqrt (Q : ℝ) ∧
      ∀ n : ℕ, n.Coprime r →
        (∑ ψ, c ψ * unitAddCharDirichlet ψ (n : ZMod r)) =
          Complex.exp (Complex.I * (2 * Real.pi * ((u : ℝ) / r * n) : ℝ)) := by
  let : NeZero r := ⟨Nat.ne_of_gt hr⟩
  obtain ⟨c, hc, he⟩ := finite_unit_character_expansion hr hrQ
    (fun z => (AddChar.zmod r (u : ZMod r) z : ℂ)) (fun v => (Circle.norm_coe _).le)
  exact ⟨c, hc, fun n hn => (he n hn).trans (rational_phase_zmod u n)⟩

theorem rational_bilinear_character_expansion {r Q : ℕ} (hr : 0 < r) (hrQ : r ≤ Q)
    (u : ℤ) :
    ∃ c : AddChar (Additive (ZMod r)ˣ) ℂ → ℂ,
      (∑ ψ, ‖c ψ‖) ≤ Real.sqrt (Q : ℝ) ∧
      ∀ m n : ℕ, m.Coprime r → n.Coprime r →
        (∑ ψ, c ψ * unitAddCharDirichlet ψ (m : ZMod r) *
          unitAddCharDirichlet ψ (n : ZMod r)) =
          Complex.exp (Complex.I * (2 * Real.pi * ((u : ℝ) / r * (m * n)) : ℝ)) := by
  obtain ⟨c, hc, he⟩ := rational_unit_character_expansion hr hrQ u
  refine ⟨c, hc, ?_⟩
  intro m n hm hn
  simpa only [Nat.cast_mul, map_mul, mul_assoc] using he (m * n) (hm.mul_left hn)
end

section

open Finset
open scoped Classical

noncomputable def cleanProbeComparisonError {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (U V : Finset I) (k : (∀ i, X i) → ℂ)
    (K : Finset I → Finset I → (∀ i, X i) → (∀ i, X i) → ℂ)
    (f g : (∀ i, X i) → ℂ) : ℂ :=
  cleanSignedComponentError U V
    (fun S T => cleanRawPairing (finiteProductWeight μ) k
      (finiteCoordinateComponent μ S U.toList f) (finiteCoordinateComponent μ T V.toList g))
    (fun S T A B => cleanKernelPairing (finiteProductWeight μ) (K A B)
      (finiteCoordinateComponent μ S U.toList f) (finiteCoordinateComponent μ T V.toList g))

theorem finite_probe_signed_cancellation {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (U V : Finset I) (k : (∀ i, X i) → ℂ)
    (K : Finset I → Finset I → (∀ i, X i) → (∀ i, X i) → ℂ)
    (f g : (∀ i, X i) → ℂ)
    (hzero : ∀ S ∈ U.powerset, ∀ T ∈ V.powerset,
      ∀ A ∈ cleanNonemptySubsets U, ∀ B ∈ cleanNonemptySubsets V,
        ¬(A ⊆ U \ S ∧ B ⊆ V \ T) →
        cleanKernelPairing (finiteProductWeight μ) (K A B)
          (finiteCoordinateComponent μ S U.toList f)
          (finiteCoordinateComponent μ T V.toList g) = 0) :
    cleanRawPairing (finiteProductWeight μ) k f g -
      (∑ A ∈ cleanNonemptySubsets U, ∑ B ∈ cleanNonemptySubsets V,
        (-1 : ℂ) ^ (A.card + B.card) * cleanKernelPairing (finiteProductWeight μ) (K A B) f g) =
      (cleanRawPairing (finiteProductWeight μ) k (finiteCoordinateComponent μ U U.toList f) g +
        cleanRawPairing (finiteProductWeight μ) k
          (f - finiteCoordinateComponent μ U U.toList f) (finiteCoordinateComponent μ V V.toList g)) -
        cleanProbeComparisonError μ U V k K f g := by
  let r S T := cleanRawPairing (finiteProductWeight μ) k
    (finiteCoordinateComponent μ S U.toList f) (finiteCoordinateComponent μ T V.toList g)
  let q S T A B := cleanKernelPairing (finiteProductWeight μ) (K A B)
    (finiteCoordinateComponent μ S U.toList f) (finiteCoordinateComponent μ T V.toList g)
  have h := (clean_pattern_block_eq_component_block U V r q hzero).trans
    (clean_signed_block_cancellation U V r q)
  unfold cleanSignedPatternBlock at h
  dsimp only [r, q] at h
  rw [clean_raw_component_pairing_sum] at h
  simp_rw [clean_kernel_component_pairing_sum] at h
  rw [clean_raw_component_exceptional_pairing] at h
  exact h

/-- The full signed comparison block cancels every nonexceptional component.
The two exceptional raw pairings are combined before taking an absolute value.
Only comparison errors incur the three-state count. -/
theorem finite_probe_signed_cancellation_bound {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hμ : ∀ i x, 0 ≤ μ i x) (hmass : ∀ i, ∑ y, μ i y = 1)
    (U V : Finset I) (k : (∀ i, X i) → ℂ)
    (K : Finset I → Finset I → (∀ i, X i) → (∀ i, X i) → ℂ)
    (f g : (∀ i, X i) → ℂ)
    (hzero : ∀ S ∈ U.powerset, ∀ T ∈ V.powerset,
      ∀ A ∈ cleanNonemptySubsets U, ∀ B ∈ cleanNonemptySubsets V,
        ¬(A ⊆ U \ S ∧ B ⊆ V \ T) →
        cleanKernelPairing (finiteProductWeight μ) (K A B)
          (finiteCoordinateComponent μ S U.toList f)
          (finiteCoordinateComponent μ T V.toList g) = 0)
    (ε : ℝ) (hε : 0 ≤ ε)
    (herr : ∀ S ∈ U.powerset, ∀ T ∈ V.powerset,
      ∀ A ∈ cleanNonemptySubsets (U \ S), ∀ B ∈ cleanNonemptySubsets (V \ T),
        ‖cleanKernelPairing (finiteProductWeight μ) (K A B)
            (finiteCoordinateComponent μ S U.toList f)
            (finiteCoordinateComponent μ T V.toList g) -
          cleanRawPairing (finiteProductWeight μ) k
            (finiteCoordinateComponent μ S U.toList f)
            (finiteCoordinateComponent μ T V.toList g)‖ ≤
        ε * Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ)
          (finiteCoordinateComponent μ S U.toList f)) *
          Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ)
            (finiteCoordinateComponent μ T V.toList g))) :
    ‖cleanRawPairing (finiteProductWeight μ) k f g -
      ∑ A ∈ cleanNonemptySubsets U, ∑ B ∈ cleanNonemptySubsets V,
        (-1 : ℂ) ^ (A.card + B.card) * cleanKernelPairing (finiteProductWeight μ) (K A B) f g‖ ≤
      ‖cleanRawPairing (finiteProductWeight μ) k (finiteCoordinateComponent μ U U.toList f) g +
        cleanRawPairing (finiteProductWeight μ) k
          (f - finiteCoordinateComponent μ U U.toList f) (finiteCoordinateComponent μ V V.toList g)‖ +
      (3 : ℝ) ^ (U.card + V.card) * ε *
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) f) *
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) g) := by
  let r S T := cleanRawPairing (finiteProductWeight μ) k
    (finiteCoordinateComponent μ S U.toList f) (finiteCoordinateComponent μ T V.toList g)
  let q S T A B := cleanKernelPairing (finiteProductWeight μ) (K A B)
    (finiteCoordinateComponent μ S U.toList f) (finiteCoordinateComponent μ T V.toList g)
  have h := clean_signed_pattern_block_bound U V r q hzero
    (ε * Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) f) *
      Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) g))
    (mul_nonneg (mul_nonneg hε (Real.sqrt_nonneg _)) (Real.sqrt_nonneg _))
    (fun S hS T hT A hA B hB => finite_probe_comparison_error_uniform μ hμ hmass U V S T
      (mem_powerset.mp hS) (mem_powerset.mp hT) f g ε hε _ (herr S hS T hT A hA B hB))
  unfold cleanSignedPatternBlock at h
  dsimp only [r, q] at h
  rw [clean_raw_component_pairing_sum] at h
  simp_rw [clean_kernel_component_pairing_sum] at h
  rw [clean_raw_component_exceptional_pairing] at h
  simpa only [mul_assoc] using h
end

section
open Finset Classical
noncomputable def mixedMemoryUniformEnergy (ρ v vmin vmax : ℝ) (T : ℕ) : ℝ :=
  max 1 (max (physicalGhostUniformEnergyBound ρ vmax v)
    (unrestrictedEdgeEnergyBound ρ v vmin vmax T))

theorem mixedMemoryUniformEnergy_ge_one (ρ v vmin vmax : ℝ) (T : ℕ) :
    1 ≤ mixedMemoryUniformEnergy ρ v vmin vmax T := le_max_left _ _

theorem mixedMemoryStepEnergy_nonneg {J K : Type*} (ρ v vmin vmax : ℝ) (T groups : ℕ)
    (k : J ⊕ K) : 0 ≤ mixedMemoryStepEnergy ρ v vmin vmax T groups k := by
  cases k with
  | inl j => exact pow_nonneg (Real.exp_pos _).le _
  | inr k => exact pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _

theorem mixedMemoryStepEnergy_le_uniform {J K : Type*} (ρ v vmin vmax : ℝ) (T groups : ℕ)
    (k : J ⊕ K) : mixedMemoryStepEnergy ρ v vmin vmax T groups k ≤
      mixedMemoryUniformEnergy ρ v vmin vmax T ^ groups := by
  cases k with
  | inl j =>
    exact pow_le_pow_left₀ (Real.exp_pos _).le
      ((le_max_left _ _).trans (le_max_right _ _)) _
  | inr k =>
    exact pow_le_pow_left₀ (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T)
      ((le_max_right _ _).trans (le_max_right _ _)) _

theorem fullPermutationMixed_product_filter {J K : Type*}
    (ρ v vmin vmax : ℝ) (T groups : ℕ) (steps : List (Option (J ⊕ K))) :
    (steps.map (fullPermutationMixedStepEnergy ρ v vmin vmax T groups)).prod =
      ((steps.filterMap id).map (mixedMemoryStepEnergy ρ v vmin vmax T groups)).prod := by
  induction steps with
  | nil => rfl
  | cons k steps ih =>
    cases k <;> simp [fullPermutationMixedStepEnergy, ih]

theorem fullPermutationMixed_product_le_uniform {J K : Type*}
    (ρ v vmin vmax : ℝ) (T groups : ℕ) (steps : List (Option (J ⊕ K))) :
    (steps.map (fullPermutationMixedStepEnergy ρ v vmin vmax T groups)).prod ≤
      (mixedMemoryUniformEnergy ρ v vmin vmax T ^ groups) ^ (steps.filterMap id).length := by
  rw [fullPermutationMixed_product_filter]
  have h := List.prod_map_le_prod_map₀
    (s := steps.filterMap id) (mixedMemoryStepEnergy (J := J) (K := K) ρ v vmin vmax T groups)
    (fun _ => mixedMemoryUniformEnergy ρ v vmin vmax T ^ groups)
    (fun k _ => mixedMemoryStepEnergy_nonneg ρ v vmin vmax T groups k)
    (fun k _ => mixedMemoryStepEnergy_le_uniform ρ v vmin vmax T groups k)
  simpa only [List.map_const', List.prod_replicate] using h

theorem fullPermutationMixed_product_le_rpow {J K : Type*}
    (ρ v vmin vmax : ℝ) (T groups : ℕ) (steps : List (Option (J ⊕ K)))
    {L A : ℝ} (hL : 0 < L) (hgroups : (groups : ℝ) ≤ A * Real.log L) :
    (steps.map (fullPermutationMixedStepEnergy ρ v vmin vmax T groups)).prod ≤
      L ^ ((steps.filterMap id).length * A * Real.log (mixedMemoryUniformEnergy ρ v vmin vmax T)) := by
  have hC := mixedMemoryUniformEnergy_ge_one ρ v vmin vmax T
  have hC0 := (zero_le_one : (0 : ℝ) ≤ 1).trans hC
  have hp : mixedMemoryUniformEnergy ρ v vmin vmax T ^ groups ≤
      L ^ (A * Real.log (mixedMemoryUniformEnergy ρ v vmin vmax T)) := by
    simpa only [prod_const, card_univ, Fintype.card_fin] using
      group_product_bound_of_log_card (univ : Finset (Fin groups))
        (fun _ => mixedMemoryUniformEnergy ρ v vmin vmax T) hC hL
        (fun _ _ => hC0) (fun _ _ => le_rfl)
        (by simpa only [card_univ, Fintype.card_fin] using hgroups)
  calc
    _ ≤ (mixedMemoryUniformEnergy ρ v vmin vmax T ^ groups) ^ (steps.filterMap id).length :=
      fullPermutationMixed_product_le_uniform ρ v vmin vmax T groups steps
    _ ≤ (L ^ (A * Real.log (mixedMemoryUniformEnergy ρ v vmin vmax T))) ^ (steps.filterMap id).length :=
      pow_le_pow_left₀ (pow_nonneg hC0 _) hp _
    _ = _ := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hL.le]
      congr 1
      ring
end

