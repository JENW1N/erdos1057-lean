section

/- The disjoint record phase is exactly the complex weighted sum of the selected physical histories. -/

open Finset
open scoped Classical
namespace Bounty

section Sum
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g, ∀ p : ↥(P g), NeZero p.val]
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ) (cut : ℕ → Fin N → Finset (Fin J))
  (S : Finset (PhysicalSelectedData P ell C)) (w : PhysicalSelectedData P ell C → ℂ)

theorem physical_selected_record_action_eq_sum
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hencode : ∀ i, PhysicalMarkRowEncoding C (physicalSelectedFineTag n i) (cut i) (cut (i + 1)))
    (f : PhysicalFullBoundedState P J ell B → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) :
    physicalSelectedRecordAction C k β V ρ hV ω retention cut S w f s =
      ∑ d ∈ S, w d *
        finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
          (physicalSelectedFineRow C d.1 d.2.1 d.2.2.1 d.2.2.2 k β V ρ hV ω retention)
          (4 * n + 1) (fun t => f (physicalBoundedMarkEncode (cut (4 * n + 1)) t).2) s := by
  let F : PhysicalSelectedData P ell C →
      List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C) ×
        PhysicalBoundedMarkState P J ell B → ℂ := fun d u =>
    physicalSelectedFineRecordMask C d.1 d.2.1 d.2.2.1 d.2.2.2 cut (4 * n + 1) u.1 *
      f (physicalBoundedMarkEncode (cut (4 * n + 1)) u.2).2
  have hterminal :
      ((fun r => physicalSelectedDataRecordPhase C cut S w r.1 * f r.2.2) ∘
        Prod.map id (physicalBoundedMarkEncode (cut (4 * n + 1)))) =
      (fun u => ∑ d ∈ S, w d * F d u) := by
    funext u
    simp only [Function.comp_apply, Prod.map_fst, Prod.map_snd, id_eq,
      physicalSelectedDataRecordPhase, sum_mul]
    apply sum_congr rfl
    intro d hd
    dsimp only [F, physicalSelectedFineRecordMask, physicalSelectedDataRecordTest]
    split_ifs with h <;> simp [h]
  unfold physicalSelectedRecordAction
  rw [hterminal, physical_recorded_mark_history_weighted_sum]
  apply sum_congr rfl
  intro d hd
  congr 1
  exact (physical_selected_fine_history_eq_recorded C d.1 d.2.1 d.2.2.1 d.2.2.2
    k β V ρ hV ω retention hP hdis cut hencode (4 * n + 1) (fun y => f y.2) s).symm

end Sum
end Bounty
end

section

/- Nonzero original return coefficients enforce every structural list condition. -/

open Finset
open scoped Classical
namespace Bounty

section Support
variable {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (V : Fin N → ℝ) (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
  (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
  (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
  (L : PhysicalMarkLists P J ell)
  (p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)

theorem physical_finite_return_scalar_edge_nonzero
    (h : physicalFiniteReturnScalar V patterns C ζ k K n L p ≠ 0) (j : Fin (n + 1)) :
    physicalBareLabeledScalar V patterns C (ζ (n - j.val)) (K (n - j.val)) (p j).1
      (finitePathMarks L p j.val) (finitePathMarks L p (j.val + 1)) ≠ 0 := by
  unfold physicalFiniteReturnScalar physicalBareReturnScalar at h
  split_ifs at h with he
  · unfold physicalBareWalkScalar at h
    have hj := (prod_ne_zero_iff.mp h) j.val (mem_range.mpr j.isLt)
    have ha : finitePathLabels p j.val = (p j).1 := by
      simp only [finitePathLabels, dif_pos j.isLt]
    simpa only [Nat.add_sub_cancel, ha] using hj
  · exact (h rfl).elim

theorem physical_finite_return_scalar_selected_lists
    (h : physicalFiniteReturnScalar V patterns C ζ k K n L p ≠ 0) :
    ∀ j : Fin (n + 1),
      physicalListAdmissible (C ((physicalPathSelectedEquiv patterns C (L, p)).1 j).val)
        ((physicalPathSelectedEquiv patterns C (L, p)).2.1 j)
        (physicalPermuteLabels ((physicalPathSelectedEquiv patterns C (L, p)).2.2.2.1 j)
          ((physicalPathSelectedEquiv patterns C (L, p)).2.2.1 j.castSucc))
        (physicalPermuteLabels ((physicalPathSelectedEquiv patterns C (L, p)).2.2.2.2 j)
          ((physicalPathSelectedEquiv patterns C (L, p)).2.2.1 j.succ)) := by
  intro j
  rw [physical_path_selected_marks_eq_finite_path]
  change physicalListAdmissible (C (p j).1.2.2.1.val) (p j).1.2.2.2
    (physicalPermuteLabels (p j).1.1 (finitePathMarks L p j.val))
    (physicalPermuteLabels (p j).1.2.1 (finitePathMarks L p (j.val + 1)))
  by_contra hn
  exact physical_finite_return_scalar_edge_nonzero V patterns C ζ k K L p h j
    (physical_bare_scalar_zero_of_incompatible V patterns C (ζ (n - j.val))
      (K (n - j.val)) (p j).1 (finitePathMarks L p j.val) (finitePathMarks L p (j.val + 1)) hn)

end Support
end Bounty
end

section

/- Multiplier nondivisibility requires an explicit nonzero short-step hypothesis. -/

open Finset
namespace Bounty

section Multipliers
variable {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (patterns : Finset I) (C : I → Fin N → Finset (Fin J)) (k : ℕ → I → ℤ)
  (L : PhysicalMarkLists P J ell)
  (p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)

theorem physical_path_selected_multiplier_not_dvd_of_bounds
    (pmin : ℕ)
    (hk0 : ∀ t < n + 1, ∀ i ∈ patterns, k t i ≠ 0)
    (hshort : ∀ t < n + 1, ∀ i ∈ patterns, (k t i).natAbs < pmin)
    (hpool : ∀ g a, a ∈ P g → pmin ≤ a) :
    ∀ j : Fin (n + 1), ∀ g s,
      ¬ (((physicalPathSelectedEquiv patterns C (L, p)).2.2.1 j.castSucc g s).val : ℤ) ∣
        physicalPathSelectedMultiplier C k p j := by
  intro j g s
  apply nat_not_dvd_int_of_natAbs_lt
  · exact Int.natAbs_pos.mpr (hk0 (n - j.val) (by omega) _ (p j).1.2.2.1.property)
  · exact (hshort (n - j.val) (by omega) _ (p j).1.2.2.1.property).trans_le
      (hpool g _ ((physicalPathSelectedEquiv patterns C (L, p)).2.2.1 j.castSucc g s).property)

end Multipliers
end Bounty
end

section

/- The original finite-path histories agree with their clamped selected coordinates. -/

open Finset
open scoped Classical
namespace Bounty

section Alignment
variable {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  [∀ a : PhysicalPrime P, NeZero a.2.val]
  {patterns : Finset I} (C : I → Fin N → Finset (Fin J)) (k : ℕ → I → ℤ)
  (L : PhysicalMarkLists P J ell)
  (p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)
  (η : ℕ → ℝ) (β : PhysicalPrime P → ℝ) (V : Fin N → ℝ)

theorem physical_finite_path_run_alignment (a : PhysicalPrime P) :
    ghostPhaseRunHistory
      (fun j => globalBirthFiniteActivity
        (physicalGroupBareFiniteActivity (physicalPathSelectedEquiv patterns C (L, p)).2.2.1 a.1) j a.2)
      (physicalResidueAbsoluteHit (physicalPathSelectedOffset C k L p) a.1 a.2)
      (fun j => η (globalBirthFiniteIndex (n + 1) j).val) (β a) (V a.1) (n + 1) =
    ghostPhaseRunHistory
      (fun j => decide (a ∈ physicalMarkedPrimes (finitePathMarks L p j)))
      (fun j => -(physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p)
        (n + 1) j : ZMod a.2.val)) η (β a) (V a.1) (n + 1) := by
  apply ghost_phase_run_history_congr
  · intro j hj
    have hi : globalBirthFiniteIndex (n + 1) j = ⟨j, by omega⟩ :=
      global_birth_finite_index_at (⟨j, by omega⟩ : Fin (n + 2))
    simp only [globalBirthFiniteActivity, hi, physicalGroupBareFiniteActivity,
      physicalGroupPhaseActivity, physical_path_selected_marks_eq_finite_path,
      mem_physical_marked_primes]
  · intro j hj
    have hi : globalBirthFiniteIndex (n + 1) j = ⟨j, by omega⟩ :=
      global_birth_finite_index_at (⟨j, by omega⟩ : Fin (n + 2))
    simp only [physicalResidueAbsoluteHit, hi, physicalPathSelectedOffset]
  · intro j hj
    congr 1
    exact min_eq_left hj

theorem physical_finite_path_capped_eq_run_product (B : ℕ)
    (hB : Fintype.card (PhysicalPrime P) ≤ B) :
    ghostPhaseCappedHistory
      (fun a : PhysicalPrime P => fun j => globalBirthFiniteActivity
        (physicalGroupBareFiniteActivity (physicalPathSelectedEquiv patterns C (L, p)).2.2.1 a.1) j a.2)
      (fun a => physicalResidueAbsoluteHit (physicalPathSelectedOffset C k L p) a.1 a.2)
      (fun _ j => η (globalBirthFiniteIndex (n + 1) j).val)
      β (fun a => V a.1) (fun _ => B) (fun _ => B) (n + 1) =
    ∏ a : PhysicalPrime P, ghostPhaseRunHistory
      (fun j => decide (a ∈ physicalMarkedPrimes (finitePathMarks L p j)))
      (fun j => -(physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p)
        (n + 1) j : ZMod a.2.val)) η (β a) (V a.1) (n + 1) := by
  rw [ghost_phase_capped_history_eq_run_product _ _ _ _ _ _ _ (fun _ => hB) (fun _ => hB)]
  apply prod_congr rfl
  intro a _
  exact physical_finite_path_run_alignment C k L p η β V a

end Alignment
end Bounty
end

section

/- Exact reindexing retains a support predicate on the original physical paths. -/

open Finset
open scoped Classical
namespace Bounty

theorem finite_sum_subtype_indicator {X R : Type*} [Fintype X] [AddCommMonoid R]
    (p : X → Prop) (f : X → R) :
    (∑ x : {x // p x}, f x.val) = ∑ x, if p x then f x else 0 := by
  rw [← sum_subtype (univ.filter p) (by simp)]
  exact sum_filter p f

theorem physical_supported_path_sum {I R : Type*} [AddCommMonoid R]
    {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
    (H : PhysicalMarkLists P J ell →
      (Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) → Prop)
    (F : PhysicalMarkLists P J ell →
      (Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) → R) :
    let := physicalLabeledPathFintype (P := P) (ell := ell) (n := n) patterns C
    let : ∀ pattern : Fin n → patterns,
      Fintype (PhysicalSelectedData P ell (fun j => C (pattern j).val)) :=
      fun pattern => physicalSelectedDataFintype (fun j => C (pattern j).val)
    (∑ L : PhysicalMarkLists P J ell,
      ∑ p : {p : Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell // H L p},
        F L p.val) =
      ∑ pattern : Fin n → patterns,
        ∑ d : {d : PhysicalSelectedData P ell (fun j => C (pattern j).val) //
          H ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d⟩).1
            ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d⟩).2},
          F ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d.val⟩).1
            ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d.val⟩).2 := by
  let := physicalLabeledPathFintype (P := P) (ell := ell) (n := n) patterns C
  let : ∀ pattern : Fin n → patterns,
    Fintype (PhysicalSelectedData P ell (fun j => C (pattern j).val)) :=
    fun pattern => physicalSelectedDataFintype (fun j => C (pattern j).val)
  have hp := physical_path_sum_eq_selected_data patterns C (fun L p => if H L p then F L p else 0)
  dsimp only at hp ⊢
  convert hp using 1
  · apply sum_congr rfl
    intro L _
    exact finite_sum_subtype_indicator (H L) (F L)
  · apply sum_congr rfl
    intro pattern _
    exact finite_sum_subtype_indicator
      (fun d => H ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d⟩).1
        ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d⟩).2)
      (fun d => F ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d⟩).1
        ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d⟩).2)

end Bounty
end

section

/- Summing all consistent selectors recovers the original observed local coefficients. -/

open Finset
open scoped Classical
namespace Bounty
section Fine
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J))
  (o : ℕ → PhysicalMarkObservation P ell C)
  (t : ℕ → PhysicalBoundedMarkState P J ell B)
  (h : PhysicalFineHistoryCoherent C o t)
  [Fintype (PhysicalSelectedData P ell C)]

include h

theorem physical_coherent_selector_partition :
    ∑ d : PhysicalSelectedData P ell C,
      (if physicalSelectedDataTest C d o t then (1 : ℂ) else 0) = 1 := by
  obtain ⟨d, hd, hu⟩ := physical_coherent_fine_history_has_selection C o t h
  have ht (e : PhysicalSelectedData P ell C) : physicalSelectedDataTest C e o t ↔ e = d :=
    ⟨hu e, fun he => he ▸ hd⟩
  simp_rw [ht]
  simp

omit [Fintype (PhysicalSelectedData P ell C)] in
theorem physical_coherent_selected_coefficient
    (ζ : Fin n → ℝ)
    (K : ∀ j, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C j) → ℂ)
    (a : ∀ j, PhysicalAuxLabels P (C j))
    (ha : ∀ j, o (4 * j.val + 2) = .inr (some ⟨j, a j⟩))
    (d : PhysicalSelectedData P ell C) (hd : physicalSelectedDataTest C d o t) :
    physicalSelectedCoefficient C ζ K d =
      ∏ j : Fin n, K j (t (4 * j.val + 1)).1 (t (4 * j.val + 2)).1 (a j) *
        physicalPhase (ζ j) (physicalD (C j) (t (4 * j.val + 1)).1 (a j)) := by
  apply prod_congr rfl
  intro j _
  have hs := physical_coherent_selected_source_marks C o t h d hd j
  have he := ((physical_selected_data_test_iff_four C d o t).mp hd).2.2.1 j
  have haux : d.1 j = a j := by
    have hh := Option.some.inj (Sum.inr.inj (he.1.symm.trans (ha j)))
    exact eq_of_heq (Sigma.mk.inj_iff.mp hh).2
  rw [hs, ← he.2, haux]

theorem physical_coherent_coefficient_sum
    (ζ : Fin n → ℝ)
    (K : ∀ j, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C j) → ℂ)
    (a : ∀ j, PhysicalAuxLabels P (C j))
    (ha : ∀ j, o (4 * j.val + 2) = .inr (some ⟨j, a j⟩)) :
    ∑ d : PhysicalSelectedData P ell C,
      (if physicalSelectedDataTest C d o t then physicalSelectedCoefficient C ζ K d else 0) =
      ∏ j : Fin n, K j (t (4 * j.val + 1)).1 (t (4 * j.val + 2)).1 (a j) *
        physicalPhase (ζ j) (physicalD (C j) (t (4 * j.val + 1)).1 (a j)) := by
  obtain ⟨d, hd, hu⟩ := physical_coherent_fine_history_has_selection C o t h
  have ht (e : PhysicalSelectedData P ell C) : physicalSelectedDataTest C e o t ↔ e = d :=
    ⟨hu e, fun he => he ▸ hd⟩
  simp_rw [ht]
  rw [Finset.sum_ite_eq']
  simp only [mem_univ, if_true]
  exact physical_coherent_selected_coefficient C o t h ζ K a ha d hd

end Fine
end Bounty
end

section

/- The complete balanced rough-pair sum, with a constant independent of the balance width. -/

open Finset Filter
open scoped Topology

namespace Bounty

def balancedPairWindow (κ L : ℝ) (v : ℕ × ℕ) : Prop :=
  Real.exp (((1/2 : ℝ)-2*κ)*L) ≤ (v.1 : ℝ) ∧
  (v.1 : ℝ) ≤ Real.exp (((1/2 : ℝ)+2*κ)*L) ∧
  Real.exp (((1/2 : ℝ)-2*κ)*L) ≤ (v.2 : ℝ) ∧
  (v.2 : ℝ) ≤ Real.exp (((1/2 : ℝ)+2*κ)*L) ∧
  Real.exp L ≤ ((v.1*v.2 : ℕ) : ℝ) ∧ ((v.1*v.2 : ℕ) : ℝ) ≤ 33*Real.exp L

theorem exists_candidate_balanced_rough_pair_bound {c q θ : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ)*(r : ℝ)*c = 1) (hθ : 0 < θ) (J : ℕ)
    (hcut : θ < 2*c/(2 : ℝ)^J)
    (hsize : (12/5 : ℝ)*(r : ℝ)*c/(2 : ℝ)^J ≤ 1/25) (hθsmall : 10*θ ≤ 1/20) :
    ∃ C : ℝ, 0 < C ∧ ∃ J0 : ℕ, J ≤ J0 ∧
      ∀ᶠ L : ℝ in atTop, ∀ (κ : ℝ), 0 ≤ κ → κ ≤ 1/50 →
      ∀ jStar : ℕ, J0 < jStar → ∀ (W : ℝ) (S : Finset (ℕ × ℕ)) (u : ℕ × ℕ → ℕ),
        1 ≤ W → W ≤ Real.exp (θ*L) →
        (∀ v ∈ S, balancedPairWindow κ L v) →
        (∀ v ∈ S, v.1*v.2 = 2*u v+1) →
        (∀ v ∈ S, ∀ p ∈ primeBand 0 W, ¬p ∣ v.1*v.2) →
        (∑ v ∈ S, candidateCoefficient c L q r jStar (u v)) ≤
          C*(κ*L+1)*candidateCoefficientWindowMass c L q r jStar *
            (∏ p ∈ primeBand 0 W, (1-1/(p : ℝ)))^2 := by
  classical
  obtain ⟨Cp, hCp, J0, hJJ0, hp⟩ := exists_candidate_pair_mass_bound hc hr hq0 hq1 hcenter hθ
    (by norm_num : (0 : ℝ) < 33) J hcut hsize hθsmall
  let Cd := 36/Real.log 2+18
  have hCd : 0 < Cd := by dsimp [Cd]; positivity [Real.log_pos (by norm_num : (1 : ℝ) < 2)]
  refine ⟨Cd*(Cp+1), by positivity, J0, hJJ0, ?_⟩
  filter_upwards [hp 4, eventually_power_four_le_avoidance_square hθ,
    eventually_gt_atTop (0 : ℝ)] with L hpair havoid hL
  intro κ hκ hκup jStar hj W S u hW hWup hS hv hrough
  let XA := candidateCoefficientWindowMass c L q r jStar
  let V := ∏ p ∈ primeBand 0 W, (1-1/(p : ℝ))
  have hXA : 0 ≤ XA := sum_nonneg (fun n _ => candidate_coefficient_nonneg c L hq0 r jStar n)
  have hpos : ∀ v ∈ S, 0 < v.1 ∧ 0 < v.2 := by
    intro v hvs
    exact ⟨Nat.cast_pos.mp ((Real.exp_pos _).trans_le (hS v hvs).1),
      Nat.cast_pos.mp ((Real.exp_pos _).trans_le (hS v hvs).2.2.1)⟩
  have hupper : ((1/2 : ℝ)+2*κ)*L ≤ (27/50 : ℝ)*L :=
    mul_le_mul_of_nonneg_right (by linarith) hL.le
  have hlocal (k : ℕ × ℕ) (hk : k ∈ dyadicPairIndices S) :
      (∑ v ∈ dyadicPairBucket S k, candidateCoefficient c L q r jStar (u v)) ≤ (Cp+1)*XA*V^2 := by
    obtain ⟨v, hvs, hkm, hkn, hkprod⟩ := dyadic_pair_bucket_scales S hpos hk
    have hm : (2 : ℝ)^k.1 ≤ Real.exp ((27/50 : ℝ)*L) :=
      hkm.trans ((hS v hvs).2.1.trans (Real.exp_le_exp.mpr hupper))
    have hn : (2 : ℝ)^k.2 ≤ Real.exp ((27/50 : ℝ)*L) :=
      hkn.trans ((hS v hvs).2.2.2.1.trans (Real.exp_le_exp.mpr hupper))
    have harea : (2 : ℝ)^k.1 * (2 : ℝ)^k.2 ≤ 33*Real.exp L :=
      hkprod.trans (hS v hvs).2.2.2.2.2
    have hend (i : ℕ) : 2^i-1 ≤ 2^(i+1)-1 := by
      have hpow : (2 : ℕ)^i ≤ 2^(i+1) := Nat.pow_le_pow_right (by omega) (by omega)
      omega
    have ht := hpair jStar hj (2^k.1-1) (2^(k.1+1)-1) (2^k.2-1) (2^(k.2+1)-1)
      W (dyadicPairBucket S k) u (hend _) (hend _) (zero_le_one.trans hW) hWup
      (by simpa only [dyadic_index_side_length] using hm)
      (by simpa only [dyadic_index_side_length] using hn)
      (by simpa only [dyadic_index_side_length] using harea)
      (fun v hvk => hv v (mem_filter.mp hvk).1)
      (fun v hvk => dyadic_pair_bucket_rectangle S hpos k hvk)
      (fun v hvk => hrough v (mem_filter.mp hvk).1)
    have he := mul_le_mul_of_nonneg_left (havoid W hW hWup) hXA
    calc
      _ ≤ Cp*XA*V^2 + XA*L^(-(4 : ℝ)) := ht
      _ ≤ Cp*XA*V^2 + XA*V^2 := add_le_add le_rfl he
      _ = _ := by ring
  have hcount := dyadic_balanced_pair_count S hκ hL.le (fun v hvs =>
    ⟨(hpos v hvs).1, (hpos v hvs).2, (hS v hvs).1, (hS v hvs).2.1, (hS v hvs).2.2.2.2⟩)
  calc
    _ = ∑ k ∈ dyadicPairIndices S, ∑ v ∈ dyadicPairBucket S k,
        candidateCoefficient c L q r jStar (u v) := (sum_dyadic_pair_buckets S _).symm
    _ ≤ ∑ _k ∈ dyadicPairIndices S, (Cp+1)*XA*V^2 := sum_le_sum hlocal
    _ = ((dyadicPairIndices S).card : ℝ)*((Cp+1)*XA*V^2) := by simp only [sum_const, nsmul_eq_mul]
    _ ≤ (Cd*(κ*L+1))*((Cp+1)*XA*V^2) := mul_le_mul_of_nonneg_right hcount (by positivity)
    _ = _ := by dsimp [Cd, XA, V]; ring

end Bounty
end

section

/- Adjacent actual fine events and their decoded targets give the required history coherence. -/

namespace Bounty
section Fine
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (cut : ℕ → Fin N → Finset (Fin J))
  (hencode : ∀ i, PhysicalMarkRowEncoding C (physicalSelectedFineTag n i) (cut i) (cut (i + 1)))
  (s : Fin (4 * n + 1) → FullMixedLedgerState (fun g (p : ↥(P g)) => p.val)
    (M := fun _ => J + ell) B)
  (e : ∀ i, PhysicalFullLedgerEvent C k (physicalSelectedFineTag n i.val) (s i))
  (hnext : ∀ (i : ℕ) (hi : i + 1 < 4 * n + 1),
    s ⟨i + 1, hi⟩ = physicalFullLedgerEventTarget C k (physicalSelectedFineTag n i)
      (s ⟨i, by omega⟩) (e ⟨i, by omega⟩))
  (o : ℕ → PhysicalMarkObservation P ell C)
  (t : ℕ → PhysicalBoundedMarkState P J ell B)
  (ho : ∀ i : Fin (4 * n + 1), o i.val = physicalFullEventObservation C k
    (cut i.val) (cut (i.val + 1)) (physicalSelectedFineTag n i.val) (s i) (e i))
  (ht : ∀ i : Fin (4 * n + 1), physicalBoundedMarkEncode (cut (i.val + 1)) (t i.val) =
    physicalFullLedgerEventTarget C k (physicalSelectedFineTag n i.val) (s i) (e i))

include hencode hnext ho ht in
theorem physical_fine_events_coherent : PhysicalFineHistoryCoherent C o t := by
  have hs (i : ℕ) (hi : i + 1 < 4 * n + 1) :
      physicalBoundedMarkEncode (cut (i + 1)) (t i) = s ⟨i + 1, hi⟩ :=
    (ht ⟨i, by omega⟩).trans (hnext i hi).symm
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro j
    let i : Fin (4 * n + 1) := ⟨4 * j.val, by have := j.isLt; omega⟩
    exact (ho i).trans (physical_encoded_observation_ghost C k (cut i.val) (cut (i.val + 1))
      (physicalSelectedFineTag n i.val) (s i) (e i) j (physical_fine_tag_visit j))
  · intro j
    let i : Fin (4 * n + 1) := ⟨4 * j.val + 1, by have := j.isLt; omega⟩
    obtain ⟨σ, hσ, hm⟩ := physical_encoded_observation_permutation C k
      (cut i.val) (cut (i.val + 1)) (physicalSelectedFineTag n i.val) (s i) (e i)
      (physical_fine_tag_source_permutation j) (t (4 * j.val)) (t i.val)
      (hs (4 * j.val) (by have := j.isLt; omega)) (ht i)
    exact ⟨σ, (ho i).trans hσ, hm⟩
  · intro j
    let i : Fin (4 * n + 1) := ⟨4 * j.val + 2, by have := j.isLt; omega⟩
    obtain ⟨a, ha⟩ := physical_encoded_observation_edge C k
      (cut i.val) (cut (i.val + 1)) (physicalSelectedFineTag n i.val) (s i) (e i)
      j (physical_fine_tag_edge j)
    exact ⟨a, (ho i).trans ha⟩
  · intro j
    let i : Fin (4 * n + 1) := ⟨4 * j.val + 3, by have := j.isLt; omega⟩
    obtain ⟨κ, hκ, hm⟩ := physical_encoded_observation_permutation C k
      (cut i.val) (cut (i.val + 1)) (physicalSelectedFineTag n i.val) (s i) (e i)
      (physical_fine_tag_target_permutation j) (t (4 * j.val + 2)) (t i.val)
      (hs (4 * j.val + 2) (by have := j.isLt; omega)) (ht i)
    have htag : physicalSelectedFineTag n (4 * j.val + 4) = some (.inl j.succ) := by
      simpa only [Fin.val_succ, Nat.mul_add, Nat.mul_one] using physical_fine_tag_visit j.succ
    have hc : cut (4 * j.val + 4) = cut (4 * j.val + 5) := by
      simpa only [htag, PhysicalMarkRowEncoding] using hencode (4 * j.val + 4)
    let l : Fin (4 * n + 1) := ⟨4 * j.val + 4, by have := j.isLt; omega⟩
    have hg := physical_encoded_ghost_mark_step C k (cut l.val) (cut (l.val + 1))
      (physicalSelectedFineTag n l.val) (s l) (e l) j.succ htag hc
      (t i.val) (t l.val) (hs (4 * j.val + 3) (by have := j.isLt; omega)) (ht l)
    exact ⟨κ, (ho i).trans hκ, hg.trans hm⟩

end Fine
end Bounty
end

