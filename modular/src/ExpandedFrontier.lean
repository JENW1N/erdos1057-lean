/- At the original empty-memory root, disjoint physical pools supply the prime encoding and all coverage hypotheses. -/

open Finset Classical
namespace Bounty
section Physical
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g, ∀ p : ↥(P g), NeZero p.val]
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (b : (g : Fin N) → ↥(P g) → ℝ) (q : Fin (n + 1) → ℝ) (ρ v vmin : ℝ)
  (V η : Fin N → ℝ) (β : ℝ)
  (cut : ℕ → Fin N → Finset (Fin J)) (ζ : Fin n → ℝ)
  (K : ∀ j, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C j) → ℂ)

variable [Fintype (PhysicalSelectedData P ell C)]

theorem physical_initial_selected_high_rank_remainder
    (hencode : ∀ i, PhysicalMarkRowEncoding C (physicalSelectedFineTag n i) (cut i) (cut (i + 1)))
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hK : ∀ j L R a, ‖K j L R a‖ ≤ 1)
    (hω : ∀ j c a, 0 ≤ ω j c a) (hωmass : ∀ j c, ∑ a, ω j c a ≤ 1)
    (hμ : ∀ g p, 0 ≤ b g p / V g) (hmass : ∀ g, ∑ p, b g p / V g ≤ 2)
    (hη : ∀ g, 0 ≤ η g) (hμatom : ∀ g p, b g p / V g ≤ η g)
    (hβ : 0 ≤ β) (hghostAtom : ∀ j g, (|(1 - q j) * V g / ρ| * η g) * v ≤ β)
    (hedgeAtom : ∀ g, η g ≤ β) (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : ∀ g, vmin ≤ V g) (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ j g, (physicalFullSharedIndices (ell := ell) (C j g))ᶜ.card ≤ T)
    (f : PhysicalFullBoundedState P J ell B → ℂ) (L₀ : PhysicalMarkLists P J ell)
    {L : ℝ} (hL : 0 ≤ L) (hf : ∀ y, ‖f y‖ ≤ L) (r₀ : ℕ)
    (hδ : (Fintype.card (FullMixedBirthAddress
      (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B
      ((List.range (4 * n + 1)).map (physicalSelectedFineTag n))) : ℝ) ^ 2 * β < 1) :
    let x := physicalFullMemoryState (cut 0) L₀ (fun g => fullEmptyBoundedMemory
      (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B)
    ‖physicalOriginalSelectedMoment C k ω b q ρ V cut ζ K f x -
      (∑ code ∈ univ.filter (fun code => birthForestRank code < r₀),
        (-1 : ℂ) ^ birthForestRank code * physicalEnrichedForestAction C k ω b q ρ V cut ζ K code f x)‖ ≤
    (((List.range (4 * n + 1)).map (physicalSelectedFineTag n)).map
      (fullMixedLengthRowFactor (fun g p => b g p / V g) q ρ v vmin V T)).prod *
      L *
      ((Fintype.card (FullMixedBirthAddress
        (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B
        ((List.range (4 * n + 1)).map (physicalSelectedFineTag n))) : ℝ) ^ 2 * β) ^ r₀ /
      (1 - (Fintype.card (FullMixedBirthAddress
        (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B
        ((List.range (4 * n + 1)).map (physicalSelectedFineTag n))) : ℝ) ^ 2 * β) := by
  dsimp only
  let x := physicalFullMemoryState (cut 0) L₀ (fun g => fullEmptyBoundedMemory
    (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B)
  have hi : Function.Injective (fun z : (g : Fin N) × ↥(P g) => (z.2.val : ℤ)) := by
    intro a b hab
    apply physical_prime_value_injective hdis
    exact Int.ofNat_inj.mp hab
  have hx : productTotalMemory x = 0 := by
    simp only [x, productTotalMemory, physicalFullMemoryState, fullEmptyBoundedMemory, sum_const_zero]
  have h := physical_original_selected_high_rank_remainder C k ω b q ρ v vmin V η β cut ζ K
    hencode (fun z => (z.2.val : ℤ)) hi hK hω hωmass hμ hmass hη hμatom hβ hghostAtom hedgeAtom
    hq0 hq1 hρ0 hρ1 hv hvmin hV hD T ht f x
    (physical_full_state_injective (cut 0) L₀ _)
    (physical_full_empty_initial_ledger_covers (cut 0) L₀)
    hL hf r₀ hδ
  simpa only [productLengthLyapunov_empty v x hx, mul_one] using h

end Physical
end Bounty
