/- Three consecutive selected physical rows retain both normalized
permutation factors and the original signed edge action. -/

open Finset
open scoped Classical
namespace Bounty

section Physical
variable {I K : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (retention : I → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
  (hV : ∀ g, V g ≠ 0)

noncomputable def physicalSelectedStateEdgeBlock (j : K) (aux : PhysicalAuxLabels P (C j))
    (σ τ : PhysicalPermutations (Fin N) J ell) (R : PhysicalMarkLists P J ell)
    (F : PhysicalBoundedMarkState P J ell B → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) : ℂ :=
  physicalObservedMarkRow C k ω β retention ρ V hV none
    (fun o t => if o = .inl σ then
      physicalObservedMarkRow C k ω β retention ρ V hV (some (.inr j))
        (fun o u => if o = .inr (some ⟨j, aux⟩) ∧ u.1 = physicalPermuteLabels τ R then
          physicalObservedMarkRow C k ω β retention ρ V hV none
            (fun o v => if o = .inl (physicalInversePermutations τ) then F v else 0) u
          else 0) t
      else 0) s

theorem physical_selected_state_edge_block_readout (j : K) (aux : PhysicalAuxLabels P (C j))
    (σ τ : PhysicalPermutations (Fin N) J ell) (R : PhysicalMarkLists P J ell)
    (F : PhysicalBoundedMarkState P J ell B → ℂ) (s : PhysicalBoundedMarkState P J ell B) :
    physicalSelectedStateEdgeBlock C k ω β retention ρ V hV j aux σ τ R F s =
      physicalSelectedEdgeBlock C k ω β retention ρ V hV j aux σ τ R
        (physicalMarkRawExtension F R) s := by
  unfold physicalSelectedStateEdgeBlock physicalSelectedEdgeBlock
  apply congrArg (fun f => physicalObservedMarkRow C k ω β retention ρ V hV none f s)
  funext o t
  split_ifs with ho
  · apply congrArg (fun f => physicalObservedMarkRow C k ω β retention ρ V hV (some (.inr j)) f t)
    funext ob u
    split_ifs with hu
    · rw [physical_observed_selected_permutation_state, physical_observed_selected_permutation]
      congr 1
      have hm : physicalPermuteLabels (physicalInversePermutations τ) u.1 = R := by
        rw [hu.2, physical_permute_inverse]
      calc
        F (physicalPermuteLabels (physicalInversePermutations τ) u.1, u.2) =
            physicalMarkRawExtension F
              (physicalPermuteLabels (physicalInversePermutations τ) u.1)
              (physicalMarkRawReadout (physicalPermuteLabels (physicalInversePermutations τ) u.1, u.2)) :=
          (physical_mark_extension_roundtrip F
            (physicalPermuteLabels (physicalInversePermutations τ) u.1, u.2)).symm
        _ = physicalMarkRawExtension F R (physicalMarkRawReadout u) := by rw [hm]; rfl
    · rfl
  · rfl

theorem physical_selected_state_edge_block_eq (j : K) (aux : PhysicalAuxLabels P (C j))
    (σ τ : PhysicalPermutations (Fin N) J ell) (R : PhysicalMarkLists P J ell)
    (F : PhysicalBoundedMarkState P J ell B → ℂ) (s : PhysicalBoundedMarkState P J ell B) :
    physicalSelectedStateEdgeBlock C k ω β retention ρ V hV j aux σ τ R F s =
      (((Fintype.card (PhysicalPermutations (Fin N) J ell) : ℝ)⁻¹ : ℂ) ^ 2) *
        (ω j (productActiveMemorySplit (fun g => physicalFullSharedIndices (C j g)) B
          (physicalFullMemoryState (C j) (physicalPermuteLabels σ s.1) s.2.2)).1 aux : ℂ) *
        if physicalListAdmissible (C j) aux (physicalPermuteLabels σ s.1) (physicalPermuteLabels τ R) then
          jointRawTensorCutoff B
            (physicalFullEdgeRawRow (B := B) (C j) (k j) (physicalPermuteLabels σ s.1)
              (physicalPermuteLabels τ R) β ρ V aux)
            (physicalMarkRawExtension F R) (physicalMarkRawReadout s)
        else 0 := by
  rw [physical_selected_state_edge_block_readout, physical_selected_edge_block_eq]

end Physical
end Bounty
end

section

/- A fixed-order pair-sieve upper bound, uniform over all local flags. -/

open Finset

namespace Bounty

theorem exists_finite_pair_sieve_upper :
    ∃ K : ℝ, 0 < K ∧ ∀ (A B C D m : ℕ) [NeZero m]
      (P : Finset ℕ) (rough banned : ℕ → Bool) {z : ℝ},
      A ≤ B → C ≤ D → 1 < z →
      (∀ p ∈ P, p.Prime) → (∀ p ∈ P, 3 ≤ p) →
      (∀ p ∈ P, ¬p ∣ m) → (∀ p ∈ P, (p : ℝ) ≤ z) →
      ((pairSieveAvoidance A B C D m P rough banned).card : ℝ) ≤
        K * (((B : ℝ)-A)*((D : ℝ)-C)/(m : ℝ)) *
          (∏ p ∈ P, (1 - pairSieveDensity p (rough p) (banned p))) +
        ((m : ℝ)*(z^(10 : ℝ))^3 + (((B : ℝ)-A)+((D : ℝ)-C))*(z^(10 : ℝ))^2) := by
  obtain ⟨K, hK, hb⟩ := exists_finite_pair_sieve_estimate
  refine ⟨1+K*Real.exp (-2), by positivity, ?_⟩
  intro A B C D m hm P rough banned z hAB hCD hz hP hP3 hPm hPz
  have h := hb A B C D m P rough banned hAB hCD hz (h := 2)
    (by norm_num) (by decide) hP hP3 hPm hPz
  norm_num only [Nat.cast_ofNat] at h
  let V := ∏ p ∈ P, (1 - pairSieveDensity p (rough p) (banned p))
  have hV : 0 ≤ V := prod_nonneg (fun p hp => by
    have hg := (pair_sieve_density_bounds (hP3 p hp) (rough p) (banned p)).2.1
    linarith)
  have hX : 0 ≤ (B : ℝ)-A := sub_nonneg.mpr (Nat.cast_le.mpr hAB)
  have hY : 0 ≤ (D : ℝ)-C := sub_nonneg.mpr (Nat.cast_le.mpr hCD)
  have hm0 : (0 : ℝ) < m := Nat.cast_pos.mpr (Nat.pos_of_ne_zero (NeZero.ne m))
  have hphi : (m.totient : ℝ) ≤ m := Nat.cast_le.mpr (Nat.totient_le m)
  have hmain : ((B : ℝ)-A)*((D : ℝ)-C)*(m.totient : ℝ)/(m : ℝ)^2 ≤
      ((B : ℝ)-A)*((D : ℝ)-C)/(m : ℝ) := by
    apply (div_le_iff₀ (sq_pos_of_pos hm0)).mpr
    have hid : (((B : ℝ)-A)*((D : ℝ)-C)/(m : ℝ))*(m : ℝ)^2 =
        ((B : ℝ)-A)*((D : ℝ)-C)*(m : ℝ) := by field_simp
    rw [hid]
    exact mul_le_mul_of_nonneg_left hphi (mul_nonneg hX hY)
  have hsmall := (le_abs_self _).trans h
  have hmainV := mul_le_mul_of_nonneg_right hmain hV
  have hcoeff : 0 ≤ 1+K*Real.exp (-2) := by positivity
  have hscaled := mul_le_mul_of_nonneg_left hmainV hcoeff
  dsimp [V] at hscaled
  nlinarith

theorem exists_finite_pair_sieve_product_upper :
    ∃ K : ℝ, 0 < K ∧ ∀ (A B C D m : ℕ) [NeZero m]
      (P : Finset ℕ) (rough banned : ℕ → Bool) {z : ℝ},
      A ≤ B → C ≤ D → 1 < z →
      (∀ p ∈ P, p.Prime) → (∀ p ∈ P, 3 ≤ p) →
      (∀ p ∈ P, ¬p ∣ m) → (∀ p ∈ P, (p : ℝ) ≤ z) →
      ((pairSieveAvoidance A B C D m P rough banned).card : ℝ) ≤
        K * (((B : ℝ)-A)*((D : ℝ)-C)/(m : ℝ)) *
          (∏ p ∈ P.filter (fun p => rough p = true), (1 - 1/(p : ℝ)))^2 *
          (∏ p ∈ P.filter (fun p => banned p = true), (1 - 1/(p : ℝ))) +
        ((m : ℝ)*(z^(10 : ℝ))^3 + (((B : ℝ)-A)+((D : ℝ)-C))*(z^(10 : ℝ))^2) := by
  obtain ⟨K, hK, hb⟩ := exists_finite_pair_sieve_upper
  refine ⟨4*K, by positivity, ?_⟩
  intro A B C D m hm P rough banned z hAB hCD hz hP hP3 hPm hPz
  have h := hb A B C D m P rough banned hAB hCD hz hP hP3 hPm hPz
  have hX : 0 ≤ (B : ℝ)-A := sub_nonneg.mpr (Nat.cast_le.mpr hAB)
  have hY : 0 ≤ (D : ℝ)-C := sub_nonneg.mpr (Nat.cast_le.mpr hCD)
  have hc : 0 ≤ K * (((B : ℝ)-A)*((D : ℝ)-C)/(m : ℝ)) := by positivity
  have he := mul_le_mul_of_nonneg_left (pair_sieve_euler_product_le P hP3 rough banned) hc
  apply h.trans
  exact add_le_add (he.trans_eq (by ring)) le_rfl

end Bounty
end

section

/- Arbitrary complex weights on terminal tests commute with physical recorded histories. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_mark_raw_extension_mul {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (c : ℂ) (F : PhysicalBoundedMarkState P J ell B → ℂ) (R : PhysicalMarkLists P J ell) :
    physicalMarkRawExtension (fun s => c * F s) R =
      fun s => c * physicalMarkRawExtension F R s := by
  funext s
  unfold physicalMarkRawExtension
  split_ifs <;> simp only [mul_zero]

section Physical
variable {I K A H : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (retention : I → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
  (hV : ∀ g, V g ≠ 0)

theorem physical_observed_mark_row_mul (tag : Option (I ⊕ K)) (c : ℂ)
    (F : PhysicalMarkObservation P ell C → PhysicalBoundedMarkState P J ell B → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) :
    physicalObservedMarkRow C k ω β retention ρ V hV tag (fun o u => c * F o u) s =
      c * physicalObservedMarkRow C k ω β retention ρ V hV tag F s := by
  classical
  cases tag with
  | none =>
    simp only [physicalObservedMarkRow, mul_sum]
    apply sum_congr rfl
    intro σ _
    ring
  | some tag =>
    cases tag with
    | inl j =>
      simp only [physicalObservedMarkRow]
      rw [physical_mark_raw_extension_mul, global_birth_joint_cut_raw_row_mul]
    | inr j =>
      simp only [physicalObservedMarkRow, mul_sum]
      apply sum_congr rfl
      intro R _
      apply sum_congr rfl
      intro aux _
      split_ifs
      · rw [physical_mark_raw_extension_mul,
          joint_raw_tensor_cutoff_mul B _
            (fun g => physical_full_edge_raw_row_mul (C j) (k j) s.1 R β ρ V aux g)]
        ring
      · simp only [mul_zero]

theorem physical_recorded_mark_row_mul
    (tag : Option (I ⊕ K)) (before after : Fin N → Finset (Fin J))
    (update : H → FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B →
      PhysicalMarkObservation P ell C →
      FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → H)
    (c : ℂ) (F : H × PhysicalBoundedMarkState P J ell B → ℂ)
    (s : H × PhysicalBoundedMarkState P J ell B) :
    physicalRecordedMarkRow C k ω β retention ρ V hV tag before after update
      (fun u => c * F u) s =
    c * physicalRecordedMarkRow C k ω β retention ρ V hV tag before after update F s := by
  unfold physicalRecordedMarkRow finiteObservedRecordRow
  exact physical_observed_mark_row_mul C k ω β retention ρ V hV tag c _ s.2

theorem physical_recorded_mark_history_mul
    (tags : ℕ → Option (I ⊕ K)) (cut : ℕ → Fin N → Finset (Fin J))
    (update : ℕ → H → FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B →
      PhysicalMarkObservation P ell C →
      FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → H)
    (steps : ℕ) (c : ℂ) (F : H × PhysicalBoundedMarkState P J ell B → ℂ) :
    finiteRowComposition (S := fun _ => H × PhysicalBoundedMarkState P J ell B)
      (fun i => physicalRecordedMarkRow C k ω β retention ρ V hV
        (tags i) (cut i) (cut (i + 1)) (update i)) steps (fun u => c * F u) =
    fun s => c *
      finiteRowComposition (S := fun _ => H × PhysicalBoundedMarkState P J ell B)
        (fun i => physicalRecordedMarkRow C k ω β retention ρ V hV
          (tags i) (cut i) (cut (i + 1)) (update i)) steps F s := by
  apply finite_row_composition_mul
  intro i hi
  exact physical_recorded_mark_row_mul C k ω β retention ρ V hV
    (tags i) (cut i) (cut (i + 1)) (update i)

theorem physical_recorded_mark_history_weighted_sum
    (tags : ℕ → Option (I ⊕ K)) (cut : ℕ → Fin N → Finset (Fin J))
    (update : ℕ → H → FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B →
      PhysicalMarkObservation P ell C →
      FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → H)
    (steps : ℕ) (t : Finset A) (w : A → ℂ)
    (F : A → H × PhysicalBoundedMarkState P J ell B → ℂ) :
    finiteRowComposition (S := fun _ => H × PhysicalBoundedMarkState P J ell B)
      (fun i => physicalRecordedMarkRow C k ω β retention ρ V hV
        (tags i) (cut i) (cut (i + 1)) (update i)) steps (fun u => ∑ a ∈ t, w a * F a u) =
    fun s => ∑ a ∈ t, w a *
      finiteRowComposition (S := fun _ => H × PhysicalBoundedMarkState P J ell B)
        (fun i => physicalRecordedMarkRow C k ω β retention ρ V hV
          (tags i) (cut i) (cut (i + 1)) (update i)) steps (F a) s := by
  rw [physical_recorded_mark_history_sum C k ω β retention ρ V hV tags cut update steps]
  simp_rw [physical_recorded_mark_history_mul C k ω β retention ρ V hV tags cut update steps]

end Physical
end Bounty
end

section

/- The eventual disjoint-pool comparison for literal repeated-list rows.
Both pairings use the original symmetric tests and the untilted physical mass.
The error is raw minus the signed sum over nonempty active probe subsets. -/

open Finset Filter
open scoped Classical

namespace Bounty

theorem eventually_repeated_big_prime_disjoint_pool_comparison
    (hZ : PrimitiveZeroFreeHalfPlane) (c s z a v D ε : ℝ) (m : ℕ)
    (hc : 0 < c) (hs : 0 ≤ s) (hz : 0 ≤ z) (ha : 0 ≤ a)
    (hv : 0 < v) (hD : 0 ≤ D) (hε : 0 < ε) (hm : 0 < m) :
    let κ := a * Real.log (primeFiberFactorBound v m)
    let s' := s + ε
    let A₀ := D + 2 * (s' + 1)
    let q := 2 * κ + (s' + 1) + 2 * A₀ + 3
    let w := 4 * q + max z q + A₀ + 2
    let x := (s' + w + 2) + 2 * A₀ + 2
    ∀ᶠ L : ℝ in atTop,
    let Q := ⌊L ^ q⌋₊
    let h := L ^ (-w)
    let ξ := L ^ (-x)
    ∀ {G : Type} [Fintype G] [DecidableEq G] (J ell : ℕ),
    ∀ (P : G → Finset ℕ) (V : G → ℝ),
    Pairwise (fun g h => Disjoint (P g) (P h)) →
    (∀ g p, p ∈ P g → p.Prime ∧ Q < p) →
    (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) →
    (∀ g, v ≤ V g) →
    (∀ g p, p ∈ P g → Real.log p ≤ L ^ s) →
    (Fintype.card G : ℝ) ≤ a * Real.log L →
    (∀ g, ∃ a b : ℝ, P g = primeBand a b ∧ Real.exp (L ^ c) ≤ a ∧ 0 ≤ b) →
    ∀ probes : G → Finset (Fin J), (∀ g, (probes g).card = m) →
    ∀ r t : Finset G, Disjoint r t →
    ∀ ζ Θ : ℝ, |ζ| ≤ L ^ z →
    ∀ f g : RepeatedBigLists P J ell → ℂ,
    f ∈ repeatedBigSymmetricSubspace → g ∈ repeatedBigSymmetricSubspace →
    let slots := fun g => (probes g).map (Function.Embedding.inl (β := Fin ell))
    let kept := fun U : Finset (RepeatedBigFlatIndex G J ell) => primeProductRetainedCells
      (fun i : U => P i.1.1) (fun i => V i.1.1) h ξ
    ‖cleanKernelPairing (repeatedBigActiveMass V (fun _ _ => 1))
        (repeatedBigPrimeRawRow P V ζ Θ) f g -
      ∑ A ∈ cleanNonemptySubsets (r.sigma slots), ∑ B ∈ cleanNonemptySubsets (t.sigma slots),
        (-1 : ℂ) ^ (A.card + B.card) *
          cleanKernelPairing (repeatedBigActiveMass V (fun _ _ => 1))
            (repeatedBigPrimeComparisonRow P V A B Q h kept kept ζ Θ) f g‖ ≤
      (Real.sqrt (((ell : ℝ) ^ ell / (m : ℝ) ^ ell) ^ r.card) +
        Real.sqrt (((ell : ℝ) ^ ell / (m : ℝ) ^ ell) ^ t.card) +
        (3 : ℝ) ^ ((r.sigma slots).card + (t.sigma slots).card) * L ^ (-D)) *
        Real.sqrt (finiteWeightedEnergy (repeatedBigActiveMass V (fun _ _ => 1)) f) *
        Real.sqrt (finiteWeightedEnergy (repeatedBigActiveMass V (fun _ _ => 1)) g) := by
  intro κ s' A₀ q w x
  filter_upwards [eventually_prime_grouped_disjoint_pool_comparison.{0}
    hZ c s z a v D ε m hc hs hz ha hv hD hε hm] with L hcomp
  intro Q h ξ G _ _ J ell P V hdisj hP hmass hV hlog hcard hband
    probes hp r t hrt ζ Θ hζ f g hf hg slots kept
  have hVpos (j : G) : 0 < V j := hv.trans_le (hV j)
  have hPpos (j : G) (p : ℕ) (hp : p ∈ P j) : 0 < p := (hP j p hp).1.pos
  have hμ (j : G) (p : P j) : physicalLabelLaw V j p ≠ 0 := by
    unfold physicalLabelLaw
    apply div_ne_zero one_ne_zero
    exact mul_ne_zero (hVpos j).ne' (by exact_mod_cast (hPpos j p.val p.property).ne')
  have hslots (j : G) : Disjoint (slots j) (repeatedBigPrimeTailSlots J ell) := by
    apply disjoint_left.mpr
    intro i hi ht
    rcases mem_map.mp hi with ⟨k, _, rfl⟩
    rcases mem_map.mp ht with ⟨l, _, he⟩
    cases he
  have hcount (j : G) : (slots j).card = m := by
    simpa only [slots, card_map] using hp j
  have htailcount (j : G) : (repeatedBigPrimeTailSlots J ell).card = ell := by
    simp only [repeatedBigPrimeTailSlots, card_map, card_univ, Fintype.card_fin]
  have hbound := hcomp P V hdisj hP hmass hV hlog hcard hband slots
    (fun _ => repeatedBigPrimeTailSlots J ell) hslots ell hcount htailcount
    r t hrt (repeatedBigFlatActive J ell) (repeatedBigPrimeTailSlots_compl J ell)
    ζ Θ hζ f g ((repeated_big_symmetric_iff_group_slot_symmetric f).mp hf)
      ((repeated_big_symmetric_iff_group_slot_symmetric g).mp hg)
  have hraw := repeated_big_prime_raw_pairing P V
    (fun j => physical_label_law_sum V j (hVpos j) (hmass j)) hμ ζ Θ f g
  change cleanKernelPairing (repeatedBigActiveMass V (fun _ _ => 1))
    (repeatedBigPrimeRawRow P V ζ Θ) f g = _ at hraw
  have hsub (u : Finset G) : u.sigma slots ⊆ repeatedBigFlatActive J ell := by
    rintro ⟨j, i⟩ hi
    rcases mem_map.mp (mem_sigma.mp hi).2 with ⟨k, _, rfl⟩
    exact repeatedBigFlatActive_mem_inl J ell j k
  have hrt' : Disjoint (r.sigma slots) (t.sigma slots) := by
    apply disjoint_left.mpr
    intro i hi hj
    exact disjoint_left.mp hrt (mem_sigma.mp hi).1 (mem_sigma.mp hj).1
  have hpair (A : Finset (RepeatedBigFlatIndex G J ell))
      (hA : A ∈ cleanNonemptySubsets (r.sigma slots))
      (B : Finset (RepeatedBigFlatIndex G J ell))
      (hB : B ∈ cleanNonemptySubsets (t.sigma slots)) :
      cleanKernelPairing (repeatedBigActiveMass V (fun _ _ => 1))
          (repeatedBigPrimeComparisonRow P V A B Q h kept kept ζ Θ) f g =
        cleanKernelPairing
          (finiteProductWeight (fun i : RepeatedBigFlatIndex G J ell => physicalLabelLaw V i.1))
          (primeAsymmetricComparisonKernel (fun i : RepeatedBigFlatIndex G J ell => P i.1)
            (fun i => V i.1) (repeatedBigFlatActive J ell) Q h kept kept ζ Θ A B)
          (finiteGroupedTailTest (physicalLabelLaw V) (fun _ => repeatedBigPrimeTailSlots J ell) f)
          (finiteGroupedTailTest (physicalLabelLaw V) (fun _ => repeatedBigPrimeTailSlots J ell) g) := by
    have ha := ((clean_mem_nonempty_subsets _ _).mp hA).2
    have hb := ((clean_mem_nonempty_subsets _ _).mp hB).2
    simpa only [finiteGroupedTailTest, repeatedBigPrimeTailSlots_compl] using
      repeated_big_prime_comparison_pairing_tail_eq P V hVpos hPpos hmass A B
        (ha.trans (hsub r)) (hb.trans (hsub t)) (hrt'.mono ha hb)
        Q h kept kept ζ Θ f g
  have hsum :
      (∑ A ∈ cleanNonemptySubsets (r.sigma slots), ∑ B ∈ cleanNonemptySubsets (t.sigma slots),
        (-1 : ℂ) ^ (A.card + B.card) *
          cleanKernelPairing (repeatedBigActiveMass V (fun _ _ => 1))
            (repeatedBigPrimeComparisonRow P V A B Q h kept kept ζ Θ) f g) =
      ∑ A ∈ cleanNonemptySubsets (r.sigma slots), ∑ B ∈ cleanNonemptySubsets (t.sigma slots),
        (-1 : ℂ) ^ (A.card + B.card) *
          cleanKernelPairing
            (finiteProductWeight (fun i : RepeatedBigFlatIndex G J ell => physicalLabelLaw V i.1))
            (primeAsymmetricComparisonKernel (fun i : RepeatedBigFlatIndex G J ell => P i.1)
              (fun i => V i.1) (repeatedBigFlatActive J ell) Q h kept kept ζ Θ A B)
            (finiteGroupedTailTest (physicalLabelLaw V) (fun _ => repeatedBigPrimeTailSlots J ell) f)
            (finiteGroupedTailTest (physicalLabelLaw V) (fun _ => repeatedBigPrimeTailSlots J ell) g) := by
    apply sum_congr rfl
    intro A hA
    apply sum_congr rfl
    intro B hB
    rw [hpair A hA B hB]
  rw [hraw, hsum, repeated_big_active_mass_product V]
  exact hbound

end Bounty
end

section

/- Exact phase products separate initial avoidance, global distinctness, and local residuals. -/

open scoped Classical
namespace Bounty
section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, DecidableEq (P g)]
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ)
  (edgePhase : ∀ k, ((g : Fin N) → Finset (P g)) →
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) →
    FullActiveEdgeEvent n (S k) B (A k) (Δ k) (D k) x → ℂ)
  (hedge : ∀ k H x e,
    edgePhase k H x e =
      (if FullMixedLocalBirthAvoids (J := J) n S B A Δ D H (some (.inr k)) x e ∧
          FullMixedLocalBirthDistinct (J := J) n S B A Δ D (some (.inr k)) x e then 1 else 0) *
        edgePhase k (fun _ => ∅) x e)
  (ω : ∀ k c, A k c → ℝ) (μ : (g : Fin N) → P g → ℝ)
  (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

include hedge in
theorem full_mixed_ledger_path_phase_factor (steps : List (Option (J ⊕ K)))
    (x : FullMixedLedgerState n (M := M) B) (p : FullMixedLedgerPath n S B A Δ D steps x)
    (hx : FullMixedLedgerCovers n B x)
    (hp : finiteEventPathWeight
      (fun tag (s : FullMixedLedgerState n (M := M) B) =>
        FullPermutationMixedEvent n S B A Δ D tag s.2)
      (fullMixedLedgerTarget n S B A Δ D)
      (fun tag s => fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V tag s.2)
      steps x p ≠ 0) :
    finiteEventLocalPhase
      (fun tag (s : FullMixedLedgerState n (M := M) B) =>
        FullPermutationMixedEvent n S B A Δ D tag s.2)
      (fullMixedLedgerTarget n S B A Δ D) (fullMixedLedgerPhase n S B A Δ D edgePhase)
      steps x p =
    (if ∀ (a : FullMixedBirthAddress S B steps) (z : (g : Fin N) × P g),
        fullMixedLedgerPathBirthLabel n S B A Δ D steps x p a = some z → z.2 ∉ x.1 z.1
      then 1 else 0) *
    (if ∀ (a b : FullMixedBirthAddress S B steps) z,
        fullMixedLedgerPathBirthLabel n S B A Δ D steps x p a = some z →
        fullMixedLedgerPathBirthLabel n S B A Δ D steps x p b = some z → a = b
      then 1 else 0) *
    finiteEventLocalPhase
      (fun tag (s : FullMixedLedgerState n (M := M) B) =>
        FullPermutationMixedEvent n S B A Δ D tag s.2)
      (fullMixedLedgerTarget n S B A Δ D)
      (fun tag s => fullMixedBirthResidualPhase n S B A Δ D edgePhase tag s.2) steps x p := by
  have h := finite_event_local_phase_indicator_factor
    (fun tag (s : FullMixedLedgerState n (M := M) B) =>
      FullPermutationMixedEvent n S B A Δ D tag s.2)
    (fullMixedLedgerTarget n S B A Δ D)
    (fullMixedLedgerPhase n S B A Δ D edgePhase)
    (fun tag s => fullMixedBirthResidualPhase n S B A Δ D edgePhase tag s.2)
    (fun tag s e => FullMixedLocalBirthAvoids n S B A Δ D s.1 tag s.2 e ∧
      FullMixedLocalBirthDistinct n S B A Δ D tag s.2 e)
    (fun tag s e => by
      have hlocal := full_mixed_local_freshness_factor n S B A Δ D edgePhase hedge tag s e
      by_cases hc : FullMixedLocalBirthAvoids n S B A Δ D s.1 tag s.2 e ∧
          FullMixedLocalBirthDistinct n S B A Δ D tag s.2 e
      · simpa only [if_pos hc] using hlocal
      · simpa only [if_neg hc] using hlocal) steps x p
  refine h.trans ?_
  apply congrArg (fun z : ℂ => z * _)
  exact complex_indicator_and_of_iff _ _ _ _ _ _
    (full_mixed_path_local_freshness_global_iff n S B A Δ D steps x p ω μ q ρ V hx hp)

end Full
end Bounty
end

