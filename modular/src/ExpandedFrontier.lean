section

/- Exact physical history normalization under adjacent common-mark compatibility.
No global residue assignment is supplied; all original local rows and cutoffs remain. -/

open Finset
open scoped Classical
namespace Bounty

section ResiduePath
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (hcompat : ∀ j : Fin n, ∀ g s t,
    ((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val =
      ((physicalPermuteLabels (τ j) (L j.succ)) g t).val →
    (((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val : ℤ) ∣
      k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ) (η : Fin N → Fin (n + 1) → ℝ)
  (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0) (B : ℕ)

variable
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)

include hstep in
theorem physical_selected_coarse_adjacent_raw_history
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    physicalMarkRawExtension
      (finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
        (physicalSelectedCoarseRow (B := B) C aux k L σ τ β V ρ hV ω retention) (2 * n + 1) F)
      (L 0) =
      fun s => (∏ i ∈ range (2 * n + 1), physicalSelectedCoarseScalar C aux L σ ω i) *
        globalBirthJointRawHistory (fun i g => physicalGroupBareAtomicActivity L g i)
          (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β
            (fun _ j => 1 - retention j) V (fun _ => ρ) hV B)
          (fun _ => B) (2 * n + 1) (physicalMarkRawExtension F (L (Fin.last n))) s := by
  rw [physical_selected_coarse_adjacent_composition C aux k L a σ τ hstep hcompat hlist hP hdis hk
    β V ρ hV B ω retention F]
  exact global_birth_joint_raw_history_weighted
    (fun i g => physicalGroupBareAtomicActivity L g i)
    (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β
      (fun _ j => 1 - retention j) V (fun _ => ρ) hV B)
    (fun _ => B) (physicalSelectedCoarseScalar C aux L σ ω) (2 * n + 1) _

include hstep in
theorem physical_selected_fixed_path_eq_adjacent :
    finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
      (physicalSelectedCoarseRow (B := B) C aux k L σ τ β V ρ hV ω retention)
      (2 * n + 1) physicalEmptyMemoryTerminal (physicalInitialMarkState B (L 0)) =
      (∏ i ∈ range (2 * n + 1), physicalSelectedCoarseScalar C aux L σ ω i) *
        physicalJointAdjacentRawHistory C aux k L a σ τ hcompat hlist hP hdis hk β
          (fun _ j => 1 - retention j) V (fun _ => ρ) hV B := by
  have h := congrFun (physical_selected_coarse_adjacent_raw_history C aux k L a σ τ hstep hcompat
    hlist hP hdis hk β V ρ hV B ω retention (physicalEmptyMemoryTerminal (B := B)))
    (physicalMarkRawReadout (physicalInitialMarkState B (L 0)))
  have hext := physical_mark_extension_roundtrip
    (finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
      (physicalSelectedCoarseRow (B := B) C aux k L σ τ β V ρ hV ω retention)
      (2 * n + 1) physicalEmptyMemoryTerminal) (physicalInitialMarkState B (L 0))
  change physicalMarkRawExtension _ (L 0) _ = _ at hext
  rw [hext, physical_empty_memory_terminal_extension, physical_initial_mark_state_readout] at h
  exact h

end ResiduePath
end Bounty
end

section

/- Enrich the original physical edge phase before restoring it as a signed forest sum. -/

open Finset Classical
namespace Bounty

theorem physical_enriched_forest_expansion
    {Ghost Edge : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (C : Edge → Fin N → Finset (Fin J)) (k : Edge → ℤ)
    (ω : ∀ a, SharedActiveLabels (fun g => ↥(P g))
      (fun g => physicalFullSharedIndices (ell := ell) (C a g)) → PhysicalAuxLabels P (C a) → ℝ)
    (μ : (g : Fin N) → ↥(P g) → ℝ) (q : Ghost → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (Θ : ∀ a, ((g : Fin N) → Fin (J + ell) → ↥(P g)) →
      ((g : Fin N) → Fin (J + ell) → ↥(P g)) → PhysicalAuxLabels P (C a) → ℂ)
    (steps : List (Option (Ghost ⊕ Edge)))
    (initial : PhysicalFullBoundedState P J ell B → (g : Fin N) → Finset ↥(P g))
    (x : PhysicalFullBoundedState P J ell B)
    (hx : FullMixedLedgerCovers (fun g (p : ↥(P g)) => p.val) B (initial x, x))
    (encode : ((g : Fin N) × ↥(P g)) → ℤ) (hencode : Function.Injective encode) :
    let sizes := fun g (p : ↥(P g)) => p.val
    let shared := fun a g => physicalFullSharedIndices (ell := ell) (C a g)
    let aux := fun a (_ : SharedActiveLabels (fun g => ↥(P g)) (shared a)) => PhysicalAuxLabels P (C a)
    let delta := fun a => physicalFullEdgeDelta (C a) (k a)
    let displacement := fun a => physicalFullEdgeD (C a)
    let phase := fun a H s e => physicalFullGlobalEdgePhase (C a) (k a) H (ω a) μ ρ V s e *
      physicalFullActiveFactor (C a) (k a) (Θ a) s e
    ∀ (paths : Finset (FullPermutationMixedPath sizes shared B aux delta displacement steps x))
      (F : FullPermutationMixedPath sizes shared B aux delta displacement steps x → ℂ),
    (∑ p ∈ paths, F p *
      (finiteEventPathWeight (FullPermutationMixedEvent sizes shared B aux delta displacement)
        (fullPermutationMixedEventTarget sizes shared B aux delta displacement)
        (fullPermutationMixedEventWeight sizes shared B aux delta displacement ω μ q ρ V) steps x p : ℂ) *
      fullMixedLedgerInducedPhase sizes shared B aux delta displacement steps initial
        (finiteEventLocalPhase
          (fun tag (s : FullMixedLedgerState sizes (M := fun _ => J + ell) B) =>
            FullPermutationMixedEvent sizes shared B aux delta displacement tag s.2)
          (fullMixedLedgerTarget sizes shared B aux delta displacement)
          (fullMixedLedgerPhase sizes shared B aux delta displacement phase) steps) x p) =
    ∑ code : BirthForestCode (Fintype.card (FullMixedBirthAddress shared B steps)),
      (-1 : ℂ) ^ birthForestRank code *
        birthForestPathSum paths
          (fun p => F p * fullMixedResidualPathWeight sizes shared B aux delta displacement
            phase ω μ q ρ V steps initial x p)
          (fullMixedIndexedBirthPerformed sizes shared B aux delta displacement steps x)
          (fullMixedIndexedBirthValue sizes shared B aux delta displacement steps encode x) code := by
  dsimp only
  intro paths F
  exact full_mixed_ledger_phase_forest_expansion
    (fun g (p : ↥(P g)) => p.val)
    (fun a g => physicalFullSharedIndices (ell := ell) (C a g)) B
    (fun a _ => PhysicalAuxLabels P (C a))
    (fun a => physicalFullEdgeDelta (C a) (k a)) (fun a => physicalFullEdgeD (C a))
    (fun a H s e => physicalFullGlobalEdgePhase (C a) (k a) H (ω a) μ ρ V s e *
      physicalFullActiveFactor (C a) (k a) (Θ a) s e)
    (physical_enriched_schedule_birth_factor C k ω μ ρ V Θ)
    ω μ q ρ V steps initial x hx paths F encode hencode

end Bounty
end

section

/- Passing the sharp short-cell sieve bound to the actual Buchstab density. -/

namespace Bounty

open Filter Real
open scoped Topology

theorem exists_buchstab_density_sieve_upper :
    ∃ K : ℝ, 0 < K ∧ ∀ b : ℝ, 0 < b →
      ∀ h : ℕ, 1 ≤ h → Even h → b*(4*(h : ℝ)+2) < 1 →
        buchstabDensity b 1 ≤
          (Mertens.primeProductLimitConstant/b)*(1+K*exp (-(h : ℝ))) := by
  obtain ⟨K,hK,hbound⟩ := exists_short_cell_rough_density_sieve_upper
  refine ⟨K,hK,?_⟩
  intro b hb h hh heven hlevel
  have hhreal : (1 : ℝ) ≤ h := by exact_mod_cast hh
  have hb1 : b < 1 := by nlinarith
  have ht := normalized_exponential_rough_cell_tendsto (S := 1) (by norm_num) hb hb1
  by_contra hn
  have hstrict : (Mertens.primeProductLimitConstant/b)*(1+K*exp (-(h : ℝ))) <
      buchstabDensity b 1 := lt_of_not_ge hn
  let ε := (buchstabDensity b 1-
    (Mertens.primeProductLimitConstant/b)*(1+K*exp (-(h : ℝ))))/2
  have hε : 0 < ε := by dsimp [ε]; linarith
  have hlo := ht.eventually_const_lt (show
    (Mertens.primeProductLimitConstant/b)*(1+K*exp (-(h : ℝ)))+ε <
      buchstabDensity b 1 by dsimp [ε]; linarith)
  have hhi : ∀ᶠ L : ℝ in atTop,
      normalizedRoughCellCount L 1 (exp (1*L)) (exp (b*L)) ≤
        (Mertens.primeProductLimitConstant/b)*(1+K*exp (-(h : ℝ)))+ε := by
    filter_upwards [hbound 1 b 1 (by norm_num) hb h hh heven hlevel ε hε] with L hL
    exact hL (exp (1*L)) le_rfl
  obtain ⟨L,hloL,hhiL⟩ := (hlo.and hhi).exists
  exact (not_lt_of_ge hhiL) hloL

end Bounty

/- Public declaration closure audit. -/
end

section

/- Sharp candidate prime-band upper density at the actual proxy cutoff. -/

open Finset Filter
open scoped Topology
namespace Bounty

theorem sqrt_shifted_prime_avoidance_product_tendsto :
    Tendsto (fun L : ℝ => Real.sqrt L * shiftedPrimeAvoidanceProduct (Real.exp (Real.sqrt L)))
      atTop (𝓝 (shiftedSieveRatioConstant*Mertens.primeProductLimitConstant)) := by
  have h := logarithmic_shifted_prime_avoidance_product_tendsto.comp
    (Real.tendsto_exp_atTop.comp Real.tendsto_sqrt_atTop)
  change Tendsto (fun L : ℝ => Real.log (Real.exp (Real.sqrt L))*shiftedPrimeAvoidanceProduct (Real.exp (Real.sqrt L))) atTop _ at h
  simpa only [Real.log_exp] using h

theorem exists_candidate_prime_band_sqrt_rough_mass_density_upper
    (hZ : PrimitiveZeroFreeHalfPlane) {c q a v : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ)*(r : ℝ)*c = 1)
    (ha : 0 < a) (hav : a ≤ v) (hvhalf : v < 1/2) :
    ∃ J : ℕ, ∀ jStar : ℕ, J < jStar → ∀ ε : ℝ, 0 < ε → ∀ᶠ L : ℝ in atTop,
      candidatePrimeBandRoughMass c L q r jStar
          (Real.exp (a*L)) (Real.exp (v*L)) (Real.exp (Real.sqrt L)) ≤
        (shiftedSieveRatioConstant*Mertens.primeProductLimitConstant*Real.log (v/a)+ε)*
          candidateCoefficientWindowMass c L q r jStar / Real.sqrt L := by
  obtain ⟨K, hK, hmass⟩ := exists_candidate_prime_band_sqrt_rough_mass_estimate hZ
  obtain ⟨J, hJ⟩ := hmass c q a v r hc hr hq0 hq1 hcenter ha hav hvhalf
  refine ⟨J, ?_⟩
  intro jStar hj ε hε
  have hinv : Tendsto (fun L : ℝ => L^(-1 : ℝ)) atTop (𝓝 0) :=
    tendsto_rpow_neg_atTop (by norm_num : (0 : ℝ) < 1)
  have hpow : Tendsto (fun L : ℝ => L^(-17 : ℝ)) atTop (𝓝 0) :=
    tendsto_rpow_neg_atTop (by norm_num : (0 : ℝ) < 17)
  have hlim := ((sqrt_shifted_prime_avoidance_product_tendsto.mul
    (exponential_prime_predecessor_reciprocal_tendsto ha hav)).mul (hinv.const_add 1)).add
      (hpow.const_mul (1+16*primeEulerProductUpperConstant))
  simp only [add_zero, mul_one, mul_zero] at hlim
  have hev := hlim.eventually_lt_const (show
    shiftedSieveRatioConstant*Mertens.primeProductLimitConstant*Real.log (v/a) <
      shiftedSieveRatioConstant*Mertens.primeProductLimitConstant*Real.log (v/a)+ε by linarith)
  filter_upwards [hJ jStar hj, hev,
    eventually_rough_cell_order_error_le ha hK.le (-1) 1,
    eventually_ge_atTop (1 : ℝ)] with L hm hd heL hL
  let X := candidateCoefficientWindowMass c L q r jStar
  let V := shiftedPrimeAvoidanceProduct (Real.exp (Real.sqrt L))
  let H := ∑ p ∈ primeBand (Real.exp (a*L)) (Real.exp (v*L)), 1/((p : ℝ)-1)
  let C := 1+16*primeEulerProductUpperConstant
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hsqrt : 0 < Real.sqrt L := Real.sqrt_pos.mpr hL0
  have hX : 0 ≤ X := by
    apply sum_nonneg
    intro u _
    exact candidate_coefficient_nonneg c L hq0 r jStar u
  have hV : 0 ≤ V := (shifted_prime_avoidance_product_pos _).le
  have hH : 0 ≤ H := by
    apply sum_nonneg
    intro p hp
    have hpprime := ((mem_primeBand_iff (Real.exp_pos _).le (Real.exp_pos _).le p).mp hp).1
    have hp2 : (2 : ℝ) ≤ p := by exact_mod_cast hpprime.two_le
    exact div_nonneg (by norm_num) (by linarith)
  have hC : 0 ≤ C := by dsimp [C]; positivity [primeEulerProductUpperConstant_pos]
  have he : K*Real.exp (-(roughCellSieveOrder L : ℝ)) ≤ L^(-1 : ℝ) := by
    have hp : 0 ≤ L^((-1 : ℝ)+1)*Real.exp (-(a/2)*L) := by positivity
    nlinarith only [heL, hp, hK]
  have hpow_id : L*L^(-18 : ℝ)=L^(-17 : ℝ) := by
    calc
      _ = L^(1 : ℝ)*L^(-18 : ℝ) := by rw [Real.rpow_one]
      _ = _ := by rw [← Real.rpow_add hL0]; norm_num
  have hpow_bound : Real.sqrt L*L^(-18 : ℝ) ≤ L^(-17 : ℝ) := by
    rw [← hpow_id]
    exact mul_le_mul_of_nonneg_right (Real.sqrt_le_self_iff.mpr (Or.inr hL)) (by positivity)
  have hmain : 0 ≤ X*V*H := mul_nonneg (mul_nonneg hX hV) hH
  have hupper : candidatePrimeBandRoughMass c L q r jStar
      (Real.exp (a*L)) (Real.exp (v*L)) (Real.exp (Real.sqrt L)) ≤
      X*V*H*(1+L^(-1 : ℝ))+X*C*L^(-18 : ℝ) := by
    have hb := (le_abs_self _).trans hm
    change _ ≤ X*V*H*K*Real.exp (-(roughCellSieveOrder L : ℝ))+
      X*(C*L^(-18 : ℝ)) at hb
    have he' := mul_le_mul_of_nonneg_left he hmain
    nlinarith only [hb, he']
  apply (le_div_iff₀ hsqrt).mpr
  calc
    _ ≤ (X*V*H*(1+L^(-1 : ℝ))+X*C*L^(-18 : ℝ))*Real.sqrt L :=
      mul_le_mul_of_nonneg_right hupper hsqrt.le
    _ = X*((Real.sqrt L*V*H)*(1+L^(-1 : ℝ))+C*(Real.sqrt L*L^(-18 : ℝ))) := by ring
    _ ≤ X*((Real.sqrt L*V*H)*(1+L^(-1 : ℝ))+C*L^(-17 : ℝ)) := by gcongr
    _ ≤ _ := by
      have hh := mul_le_mul_of_nonneg_left hd.le hX
      change X*((Real.sqrt L*V*H)*(1+L^(-1 : ℝ))+C*L^(-17 : ℝ)) ≤ _ at hh
      simpa only [mul_comm] using hh

end Bounty
end

section

/- The actual count-matched roughness proxy on the common Mertens density scale. -/

open Filter Real
open scoped Topology

namespace Bounty

theorem density_ratio_error_bound {N D q K C η ε : ℝ}
    (hK : 0 < K) (hq : K/2 ≤ q) (hD : 0 ≤ D) (hDC : D ≤ C)
    (hη : 0 ≤ η) (hε : 0 ≤ ε) (hN : |N-D| ≤ η) (hQ : |q-K| ≤ η)
    (hsmall : (K+C)*η ≤ ε*(K*K/2)) : |N/q-D/K| ≤ ε := by
  have hq0 : 0 < q := (half_pos hK).trans_le hq
  rw [div_sub_div _ _ hq0.ne' hK.ne', abs_div, abs_of_pos (mul_pos hq0 hK)]
  apply (div_le_iff₀ (mul_pos hq0 hK)).mpr
  calc
    |N*K-q*D| = |K*(N-D)+D*(K-q)| := by congr 1; ring
    _ ≤ |K*(N-D)|+|D*(K-q)| := abs_add_le _ _
    _ = K*|N-D|+D*|q-K| := by
      rw [abs_mul, abs_mul, abs_of_pos hK, abs_of_nonneg hD, abs_sub_comm K q]
    _ ≤ K*η+D*η := add_le_add (mul_le_mul_of_nonneg_left hN hK.le)
      (mul_le_mul_of_nonneg_left hQ hD)
    _ ≤ (K+C)*η := by nlinarith
    _ ≤ ε*(K*K/2) := hsmall
    _ ≤ ε*(q*K) := by
      apply mul_le_mul_of_nonneg_left _ hε
      nlinarith

theorem eventually_sqrt_rough_test_proxy_coefficient_error
    {S a b γ₀ gap ε : ℝ} (hS : 0 ≤ S) (ha : 0 < a) (hγ₀ : 0 < γ₀)
    (hgap : 0 < gap) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ w γ : ℝ,
      a ≤ w → w ≤ b → γ₀ ≤ γ → gap ≤ w-γ →
      |sqrt L*roughTestCellProxyCoefficient γ L S (exp (w*L))-
        buchstabDensity γ w/Mertens.primeProductLimitConstant| ≤ ε := by
  let K := Mertens.primeProductLimitConstant
  have hK : 0 < K := Mertens.prime_product_limit_constant_pos
  obtain ⟨C, hC, hbound⟩ := buchstab_density_rectangle_bound
    (γ₁ := b) (w₁ := b) hγ₀ ha
  let η := min (K/2) (ε*(K*K)/(2*(K+C)))
  have hη : 0 < η := lt_min (half_pos hK) (by positivity)
  have hηK : η ≤ K/2 := min_le_left _ _
  have hηε : (K+C)*η ≤ ε*(K*K/2) := by
    have h := (le_div_iff₀ (show 0 < 2*(K+C) by positivity)).mp (min_le_right (K/2)
      (ε*(K*K)/(2*(K+C))))
    dsimp [η]
    nlinarith
  filter_upwards [eventually_normalized_rough_buchstab_error hS ha hγ₀ hgap hη,
    eventually_sqrt_normalized_rough_base_error ha hη S,
    eventually_gt_atTop (0 : ℝ)] with L hnum hden hL
  intro w γ hw hwb hγ hsep
  have hγb : γ ≤ b := by linarith
  obtain ⟨hD, hDC⟩ := hbound γ w hγ hγb hw hwb
  have hY : exp (a*L) ≤ exp (w*L) :=
    exp_le_exp.mpr (mul_le_mul_of_nonneg_right hw hL.le)
  have hQ := hden (exp (w*L)) hY
  have hN := hnum w γ hw hwb hγ hsep
  have hq : K/2 ≤ normalizedRoughCellCount L S (exp (w*L)) (exp (sqrt L))/sqrt L := by
    have hh := (abs_le.mp hQ).1
    change -η ≤ normalizedRoughCellCount L S (exp (w*L)) (exp (sqrt L))/sqrt L-K at hh
    linarith
  have hr := density_ratio_error_bound hK hq hD hDC hη.le hε.le hN hQ hηε
  have hs : sqrt L ≠ 0 := (sqrt_pos.2 hL).ne'
  have hc : logarithmicCellCountScale L S (exp (w*L)) ≠ 0 :=
    (logarithmic_cell_count_scale_pos (S := S) hL (exp_pos _)).ne'
  have hid : normalizedRoughCellCount L S (exp (w*L)) (exp (γ*L)) /
      (normalizedRoughCellCount L S (exp (w*L)) (exp (sqrt L))/sqrt L) =
      sqrt L*roughTestCellProxyCoefficient γ L S (exp (w*L)) := by
    unfold normalizedRoughCellCount roughTestCellProxyCoefficient
    field_simp
  rwa [hid] at hr

theorem sqrt_rough_test_proxy_coefficient_tendsto
    {S γ w : ℝ} (hS : 0 ≤ S) (hγ : 0 < γ) (hγw : γ < w) :
    Tendsto (fun L : ℝ => sqrt L*roughTestCellProxyCoefficient γ L S (exp (w*L)))
      atTop (𝓝 (buchstabDensity γ w/Mertens.primeProductLimitConstant)) := by
  rw [Metric.tendsto_nhds]
  intro ε hε
  have hh := eventually_sqrt_rough_test_proxy_coefficient_error
    (a := w) (b := w) (γ₀ := γ) (gap := w-γ) hS (hγ.trans hγw) hγ
    (sub_pos.mpr hγw) (show 0 < ε/2 by positivity)
  filter_upwards [hh] with L hL
  rw [Real.dist_eq]
  exact (hL w γ le_rfl le_rfl le_rfl le_rfl).trans_lt (by linarith)

theorem eventually_rough_test_proxy_coefficient_upper
    {S a b γ₀ gap ε : ℝ} (hS : 0 ≤ S) (ha : 0 < a) (hγ₀ : 0 < γ₀)
    (hgap : 0 < gap) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ w γ : ℝ,
      a ≤ w → w ≤ b → γ₀ ≤ γ → gap ≤ w-γ →
      roughTestCellProxyCoefficient γ L S (exp (w*L)) ≤
        (buchstabDensity γ w+ε)/(Mertens.primeProductLimitConstant*sqrt L) := by
  have hK := Mertens.prime_product_limit_constant_pos
  filter_upwards [eventually_sqrt_rough_test_proxy_coefficient_error
    (b := b) hS ha hγ₀ hgap (div_pos hε hK),
    eventually_gt_atTop (0 : ℝ)] with L hraw hL
  intro w γ hw hwb hγ hsep
  have hh := (abs_le.mp (hraw w γ hw hwb hγ hsep)).2
  have hs := sqrt_pos.2 hL
  apply (le_div_iff₀ (mul_pos hK hs)).mpr
  have ht : sqrt L*roughTestCellProxyCoefficient γ L S (exp (w*L)) ≤
      (buchstabDensity γ w+ε)/Mertens.primeProductLimitConstant := by
    rw [add_div]
    linarith
  have hu := (le_div_iff₀ hK).mp ht
  nlinarith

end Bounty
end

section

/- Uniform Lyapunov rows for an original owner, paying one common atom bound per selected child. -/

open Finset Classical

namespace Bounty

section Owner
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
    [∀ g, DecidableEq (P g)] {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
    (Δ D : ∀ k c, A k c → Fin N → ℤ) (ω : ∀ k c, A k c → ℝ)
    (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ v vmin : ℝ) (V η : Fin N → ℝ) (β : ℝ)
    (steps : List (Option (J ⊕ K)))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))

theorem full_mixed_owner_stage_row_le
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hη : ∀ g, 0 ≤ η g) (hμatom : ∀ g p, μ g p ≤ η g)
    (hghostAtom : ∀ j g, (|(1 - q j) * V g / ρ| * η g) * v ≤ β)
    (hedgeAtom : ∀ g, η g ≤ β)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : ∀ g, vmin ≤ V g)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (u : Fin steps.length) (tag : Option (J ⊕ K)) (htag : steps.get u = tag)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (history : Fin (Fintype.card (FullMixedBirthAddress S B steps)) → Option (Sigma P)) :
    let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
    (∑ e : FullPermutationMixedEvent n S B A Δ D tag s,
      |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V tag s e| *
        fullMixedForestHistoryGain n S B A Δ D steps code u.val tag s e history *
        productLengthLyapunov v (fullPermutationMixedEventTarget n S B A Δ D tag s e)) ≤
      (β ^ (∑ g, fullMixedSelectedCount S B steps code u g) *
        fullMixedLengthRowFactor μ q ρ v vmin V T tag) * productLengthLyapunov v s := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
  have hv0 := (zero_lt_one.trans hv).le
  have hH := productLengthLyapunov_nonneg hv0 s
  cases tag with
  | none =>
    simp_rw [full_mixed_forest_history_gain_none n S B A Δ D steps code u htag, mul_one]
    simp only [full_mixed_none_selected_count S B steps code u htag, sum_const_zero, pow_zero, one_mul]
    exact full_permutation_mixed_length_row_le n S B A Δ D ω μ q ρ v vmin V
      hω hωmass hμ hmass hq0 hq1 hρ0 hρ1 hv hvmin hV hD T ht none s
  | some tag =>
    cases tag with
    | inl j =>
      have hb := full_mixed_ghost_original_stage_le n S B A Δ D ω μ q ρ v V steps u s history code j htag
        η hη hμ hμatom (zero_lt_one.trans hv) (hq0 j) (hq1 j) hρ0 (hD j)
      have hp := finite_prod_pow_le_common_power
        (fun g => (|(1 - q j) * V g / ρ| * η g) * v)
        (fullMixedSelectedCount S B steps code u) β
        (fun g => mul_nonneg (mul_nonneg (abs_nonneg _) (hη g)) hv0) (hghostAtom j)
      exact hb.trans (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right hp (prod_nonneg fun _ _ => (Real.exp_pos _).le)) hH)
    | inr k =>
      have hb := full_mixed_edge_original_stage_le n S B A Δ D ω μ q ρ v V steps u s history code k htag
        η hη hμ hμatom hv (hω k) (hωmass k) vmin hρ0 hρ1 hvmin hV hmass T (ht k)
      have hp := finite_prod_pow_le_common_power η (fullMixedSelectedCount S B steps code u) β hη hedgeAtom
      have hh := hb.trans (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hp hH)
        (pow_nonneg (unrestricted_edge_row_bound_nonneg hρ1 hv0 T) N))
      simpa only [fullMixedLengthRowFactor, Fintype.card_fin, mul_assoc, mul_left_comm, mul_comm] using hh

end Owner
end Bounty
end

