section

/- Simultaneous upper bounds for a finite family of unbalanced rough-proxy bins. -/

open Finset Filter

namespace Bounty

theorem exists_candidate_unbalanced_rough_finite_bins_upper_uniform_precision
    {ι : Type*} [Fintype ι]
    (hZ : PrimitiveZeroFreeHalfPlane) {c q : ℝ} {r : ℕ}
    {γ a v M : ι → ℝ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11 / 5 : ℝ) * (r : ℝ) * c = 1)
    (hγ : ∀ i, 0 < γ i) (ha : ∀ i, 0 < a i) (hav : ∀ i, a i ≤ v i)
    (hvhalf : ∀ i, v i < 1 / 2) (hvγ : ∀ i, v i < 1 - γ i)
    (hM : ∀ i, 0 ≤ M i)
    (hdensity : ∀ i, ∀ α ∈ Set.Icc (a i) (v i), buchstabDensity (γ i) (1 - α) ≤ M i) :
    ∃ J : ℕ, ∀ S : ℝ, 0 ≤ S → ∀ jStar : ℕ, J < jStar → ∀ ε : ℝ, 0 < ε →
      ∀ᶠ L : ℝ in atTop,
        ∀ (F : ι → Finset (ℕ × ℕ)) (u : ι → ℕ × ℕ → ℕ),
        (∀ i, ∀ w ∈ F i, u i w ∈ arithmeticProductWindow 1 (Real.exp L) ∧
          w.1 ∈ primeBand (Real.exp (a i * L)) (Real.exp (v i * L)) ∧
          w.1 * w.2 = 2 * u i w + 1) →
        (∑ i, ∑ w ∈ F i, candidateCoefficient c L q r jStar (u i w) *
          roughTestLogarithmicProxy (γ i) L S w.2) ≤
          (shiftedSieveRatioConstant * (∑ i, M i * Real.log (v i / a i)) + ε) *
            candidateCoefficientWindowMass c L q r jStar / L := by
  classical
  have hbins := fun i => exists_candidate_unbalanced_rough_bin_upper_uniform_precision
    hZ hc hr hq0 hq1 hcenter (hγ i) (ha i) (hav i) (hvhalf i) (hvγ i)
    (hM i) (hdensity i)
  choose Js hJs using hbins
  refine ⟨Finset.univ.sup Js, ?_⟩
  intro S hS jStar hj ε hε
  let δ := ε / ((Fintype.card ι : ℝ) + 1)
  have hden : 0 < (Fintype.card ι : ℝ) + 1 := by positivity
  have hδ : 0 < δ := div_pos hε hden
  have hδeq : ((Fintype.card ι : ℝ) + 1) * δ = ε := by
    dsimp [δ]
    field_simp
  have hδerror : (Fintype.card ι : ℝ) * δ ≤ ε := by nlinarith
  have hbinEvent := fun i => hJs i S hS jStar
    (lt_of_le_of_lt (Finset.le_sup (Finset.mem_univ i)) hj) δ hδ
  have hEvent := Filter.eventually_all.mpr hbinEvent
  filter_upwards [hEvent, eventually_gt_atTop (0 : ℝ)] with L hbound hL
  intro F u hdata
  have hX : 0 ≤ candidateCoefficientWindowMass c L q r jStar := by
    apply sum_nonneg
    intro n hn
    exact candidate_coefficient_nonneg c L hq0 r jStar n
  have hsum :
      (∑ i, (shiftedSieveRatioConstant * M i * Real.log (v i / a i) + δ)) =
        shiftedSieveRatioConstant * (∑ i, M i * Real.log (v i / a i)) +
          (Fintype.card ι : ℝ) * δ := by
    simp only [sum_add_distrib, sum_const, card_univ, nsmul_eq_mul]
    rw [mul_sum]
    congr 1
    apply sum_congr rfl
    intro i hi
    ring
  calc
    (∑ i, ∑ w ∈ F i, candidateCoefficient c L q r jStar (u i w) *
        roughTestLogarithmicProxy (γ i) L S w.2) ≤
        ∑ i, (shiftedSieveRatioConstant * M i * Real.log (v i / a i) + δ) *
          candidateCoefficientWindowMass c L q r jStar / L := by
      apply sum_le_sum
      intro i hi
      exact hbound i (F i) (u i) (hdata i)
    _ = (shiftedSieveRatioConstant * (∑ i, M i * Real.log (v i / a i)) +
          (Fintype.card ι : ℝ) * δ) * candidateCoefficientWindowMass c L q r jStar / L := by
      rw [← sum_div, ← sum_mul, hsum]
    _ ≤ (shiftedSieveRatioConstant * (∑ i, M i * Real.log (v i / a i)) + ε) *
          candidateCoefficientWindowMass c L q r jStar / L := by
      apply div_le_div_of_nonneg_right _ hL.le
      exact mul_le_mul_of_nonneg_right (by linarith [hδerror]) hX

end Bounty

end

section

/- The actual retained prime pair has arbitrarily small relative shared-draw
error for logarithmic list lengths and exponentially large prime pools. -/

open Finset Filter
open scoped Classical
namespace Bounty

theorem eventually_physical_prime_pair_comparison {c v A B : ℝ} (hc : 0 < c) (hv : 0 < v) (hA : 0 ≤ A) (hB : 0 ≤ B) (E D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (G : Type*) [Fintype G] [DecidableEq G] (J ell : ℕ) (P : G → Finset ℕ) (V : G → ℝ)
      (probes : G → Finset (Fin J)),
      (∀ g p, p ∈ P g → p.Prime) → Pairwise (fun g h => Disjoint (P g) (P h)) →
      (∀ g, v ≤ V g) → (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) →
      (J * Fintype.card G : ℕ) ≤ A * Real.log L → (∀ g (p : P g), Real.exp (L^c) ≤ (p.val : ℝ)) →
      ∀ (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ), 0 < ξ →
      ∀ (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
        (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
        (a b : ℝ) (w z : ℕ), 0 < w → 0 < z →
      Real.log w / Real.log 2 + Real.log z / Real.log 2 + J ≤ B * L →
      repeatedBigPrimePatternBound probes r t Q ξ i ≤ L^E →
      let C := repeatedBigPrimePatternCut probes r t i
      let W0 := markedDivisorWeight univ P (1/2) V (fun g => ell + (C g).card) (w : ℤ)
      let W1 := markedDivisorWeight univ P (1/2) V (fun g => ell + (C g).card) (z : ℤ)
      ‖physicalFullPairCorrelation P C V (1/2) w z
          (physicalOriginalPrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w z) -
        (W0 : ℂ) * (W1 : ℂ) *
          groupMarkedAverage P (fun g => ell + (C g).card) (w : ℤ) (fun u =>
            groupMarkedAverage P (fun g => ell + (C g).card) (z : ℤ)
              (physicalUnsharedPrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w z u))‖ ≤
        (W0 * W1) * L^(-D) := by
  filter_upwards [eventually_physical_shared_error_decay hc hv hA hB E D] with L hdec
  intro G _ dG J ell P V probes hprime hdis hV hMass hJ hp r t hrt Q h ξ hξ i aux a b w z hw hz hT hH
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  dsimp only
  have hV0 : ∀ g, 0 < V g := fun g => hv.trans_le (hV g)
  have hnH := repeated_big_prime_pattern_bound_nonneg probes r t Q ξ i
  have hT0 : 0 ≤ Real.log w / Real.log 2 + Real.log z / Real.log 2 + J := by
    have hw1 : (1 : ℝ) ≤ w := by exact_mod_cast hw
    have hz1 : (1 : ℝ) ≤ z := by exact_mod_cast hz
    exact add_nonneg (add_nonneg
      (div_nonneg (Real.log_nonneg hw1) (Real.log_nonneg (by norm_num)))
      (div_nonneg (Real.log_nonneg hz1) (Real.log_nonneg (by norm_num)))) (Nat.cast_nonneg J)
  have he := hdec G J (repeatedBigPrimePatternCut probes r t i) V
    (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J)
    (repeatedBigPrimePatternBound probes r t Q ξ i) (Real.exp (L^c))
    hV hJ hT0 hT hnH hH le_rfl
  apply (physical_prime_pair_comparison P probes hprime hdis V hV0 hMass
    (by norm_num : (0 : ℝ) < 1/2) (by norm_num : (1/2 : ℝ) ≤ 1)
    r t hrt Q h ξ hξ i aux a b hw hz (Real.exp_pos _) hp).trans
  apply mul_le_mul_of_nonneg_left he
  exact mul_nonneg
    (marked_divisor_weight_nonneg univ P (by norm_num) V _ (fun g _ => (hV0 g).le) _)
    (marked_divisor_weight_nonneg univ P (by norm_num) V _ (fun g _ => (hV0 g).le) _)

end Bounty
end

section

/- The literal difference between the original full prime pair and its
unshared marked-average comparison at density one half. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def physicalPrimePairError {G : Type*} [Fintype G] [DecidableEq G]
    {J ell : ℕ} (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
    (a b : ℝ) (w z : ℕ) : ℂ :=
  let C := repeatedBigPrimePatternCut probes r t i
  physicalFullPairCorrelation P C V (1/2) w z
      (physicalOriginalPrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w z) -
    (markedDivisorWeight univ P (1/2) V (fun g => ell + (C g).card) (w : ℤ) : ℂ) *
    (markedDivisorWeight univ P (1/2) V (fun g => ell + (C g).card) (z : ℤ) : ℂ) *
    groupMarkedAverage P (fun g => ell + (C g).card) (w : ℤ) (fun u =>
      groupMarkedAverage P (fun g => ell + (C g).card) (z : ℤ)
        (physicalUnsharedPrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w z u))

theorem physical_prime_pair_error_bound {G : Type*} [Fintype G] [dG : DecidableEq G]
    {J ell : ℕ} (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1/(p : ℝ) = V g)
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ) (hξ : 0 < ξ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
    (a b : ℝ) {w z : ℕ} (hw : 0 < w) (hz : 0 < z)
    {Pmin ε : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (herror :
      let C := repeatedBigPrimePatternCut probes r t i
      let H := repeatedBigPrimePatternBound probes r t Q ξ i
      (∑ g, (J - (C g).card : ℕ) *
        (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) / (V g * Pmin)) *
        (H + H / (1/2 : ℝ) ^ (2 * ∑ g : G, (J - (C g).card))) ≤ ε) :
    let C := repeatedBigPrimePatternCut probes r t i
    ‖physicalPrimePairError P V probes r t hrt Q h ξ i aux a b w z‖ ≤
      (markedDivisorWeight univ P (1/2) V (fun g => ell + (C g).card) (w : ℤ) *
        markedDivisorWeight univ P (1/2) V (fun g => ell + (C g).card) (z : ℤ)) * ε := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  dsimp only at herror ⊢
  apply (physical_prime_pair_comparison P probes hprime hdis V hV hMass
    (by norm_num : (0 : ℝ) < 1/2) (by norm_num : (1/2 : ℝ) ≤ 1)
    r t hrt Q h ξ hξ i aux a b hw hz hPmin hp).trans
  apply mul_le_mul_of_nonneg_left herror
  exact mul_nonneg
    (marked_divisor_weight_nonneg univ P (by norm_num) V _ (fun g _ => (hV g).le) _)
    (marked_divisor_weight_nonneg univ P (by norm_num) V _ (fun g _ => (hV g).le) _)

end Bounty
end

section

/- The position bridge for the original retained prime kernel and invariant endpoints. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def physicalRootPrimeKernel
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (L R : PhysicalMarkLists P J ell)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i)) : ℂ :=
  repeatedBigPrimePatternWeight probes r t i *
    repeatedBigPrimePatternKernel P V probes r t hrt Q h
      (fun U : Finset (RepeatedBigFlatIndex G J ell) =>
        primeProductRetainedCells (fun j : U => P j.val.1) (fun j => V j.val.1) h ξ)
      i (fun g s => L g s) (fun g s => R g s) aux

theorem physical_prime_phased_pair_coefficient
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
    (a b : ℝ) (w z : ℕ) :
    physicalPhasedPairCoefficient (repeatedBigPrimePatternCut probes r t i)
      (physicalRootPrimeKernel P V probes r t hrt Q h ξ i) aux a b w z =
      physicalOriginalPrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w z := by
  rfl

theorem physical_prime_invariant_root_full_pair
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (q a b : ℝ) (k : ℤ) (positions : Finset ℤ)
    (α₀ β₀ γ₀ α₁ β₁ γ₁ : ℕ → ℂ) (Ψ : ℝ → ℂ) (Z : ℝ)
    (hcover : ∀ w ∈ physicalQuotientPositions P
        (repeatedBigPrimePatternCut probes r t i) ell positions,
      Ψ ((w : ℝ) / (Z * physicalFreeFactor (repeatedBigPrimePatternCut probes r t i) aux)) *
        (w : ℂ)⁻¹ *
        (starRingEnd ℂ) (invariantTripleEndpoint (univ.biUnion P) α₀ β₀ γ₀ w.natAbs) *
        invariantTripleEndpoint (univ.biUnion P) α₁ β₁ γ₁
          (w + k * (physicalFreeFactor (repeatedBigPrimePatternCut probes r t i) aux : ℕ)).natAbs ≠ 0 →
      ∀ L : PhysicalMarkLists P J ell,
        (physicalSharedFactor (repeatedBigPrimePatternCut probes r t i) L : ℤ) * w ∈ positions ∧
        (physicalSharedFactor (repeatedBigPrimePatternCut probes r t i) L : ℤ) *
          (w + k * (physicalFreeFactor (repeatedBigPrimePatternCut probes r t i) aux : ℕ)) ∈ positions) :
    physicalFixedRootCorrelation V (repeatedBigPrimePatternCut probes r t i) q (-(a+b)) k
      (physicalRootPrimeKernel P V probes r t hrt Q h ξ i) aux positions
      (fun n => physicalPhase (-a) n.natAbs *
        invariantTripleEndpoint (univ.biUnion P) α₀ β₀ γ₀ n.natAbs)
      (fun n => physicalPhase b n.natAbs *
        invariantTripleEndpoint (univ.biUnion P) α₁ β₁ γ₁ n.natAbs) Ψ Z =
    (physicalAuxMass V (repeatedBigPrimePatternCut probes r t i) aux : ℂ) *
      ∑ w ∈ physicalQuotientPositions P (repeatedBigPrimePatternCut probes r t i) ell positions,
        (Ψ ((w : ℝ) / (Z * physicalFreeFactor (repeatedBigPrimePatternCut probes r t i) aux)) *
          (w : ℂ)⁻¹ *
          (starRingEnd ℂ) (invariantTripleEndpoint (univ.biUnion P) α₀ β₀ γ₀ w.natAbs) *
          invariantTripleEndpoint (univ.biUnion P) α₁ β₁ γ₁
            (w + k * (physicalFreeFactor (repeatedBigPrimePatternCut probes r t i) aux : ℕ)).natAbs) *
        physicalFullPairCorrelation P (repeatedBigPrimePatternCut probes r t i) V q w.natAbs
          (w + k * (physicalFreeFactor (repeatedBigPrimePatternCut probes r t i) aux : ℕ)).natAbs
          (physicalOriginalPrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w.natAbs
            (w + k * (physicalFreeFactor (repeatedBigPrimePatternCut probes r t i) aux : ℕ)).natAbs) := by
  simpa only [physical_prime_phased_pair_coefficient] using
    physical_fixed_root_full_pair_of_coverage hdis hprime V
      (repeatedBigPrimePatternCut probes r t i) q a b k
      (physicalRootPrimeKernel P V probes r t hrt Q h ξ i) aux positions
      (physicalQuotientPositions P (repeatedBigPrimePatternCut probes r t i) ell positions)
      (fun L n hn => physical_mem_quotient_positions P _ positions L hn)
      (fun n => invariantTripleEndpoint (univ.biUnion P) α₀ β₀ γ₀ n.natAbs)
      (fun n => invariantTripleEndpoint (univ.biUnion P) α₁ β₁ γ₁ n.natAbs) Ψ Z
      (physical_invariant_endpoint_shared_scale _ hprime α₀ β₀ γ₀)
      (physical_invariant_endpoint_shared_scale _ hprime α₁ β₁ γ₁) hcover

theorem physical_prime_invariant_root_on_support
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (q a b : ℝ) (k : ℤ) (positions S : Finset ℤ)
    (α₀ β₀ γ₀ α₁ β₁ γ₁ : ℕ → ℂ) (Ψ : ℝ → ℂ) (Z : ℝ)
    (hclosure : physicalShiftedPositionClosure P
      (repeatedBigPrimePatternCut probes r t i) ell k S ⊆ positions)
    (hsupport : ∀ w : ℤ,
      Ψ ((w : ℝ) / (Z * physicalFreeFactor (repeatedBigPrimePatternCut probes r t i) aux)) *
        (w : ℂ)⁻¹ *
        (starRingEnd ℂ) (invariantTripleEndpoint (univ.biUnion P) α₀ β₀ γ₀ w.natAbs) *
        invariantTripleEndpoint (univ.biUnion P) α₁ β₁ γ₁
          (w + k * (physicalFreeFactor (repeatedBigPrimePatternCut probes r t i) aux : ℕ)).natAbs ≠ 0 → w ∈ S) :
    physicalFixedRootCorrelation V (repeatedBigPrimePatternCut probes r t i) q (-(a+b)) k
      (physicalRootPrimeKernel P V probes r t hrt Q h ξ i) aux positions
      (fun n => physicalPhase (-a) n.natAbs *
        invariantTripleEndpoint (univ.biUnion P) α₀ β₀ γ₀ n.natAbs)
      (fun n => physicalPhase b n.natAbs *
        invariantTripleEndpoint (univ.biUnion P) α₁ β₁ γ₁ n.natAbs) Ψ Z =
    (physicalAuxMass V (repeatedBigPrimePatternCut probes r t i) aux : ℂ) *
      ∑ w ∈ S,
        (Ψ ((w : ℝ) / (Z * physicalFreeFactor (repeatedBigPrimePatternCut probes r t i) aux)) *
          (w : ℂ)⁻¹ *
          (starRingEnd ℂ) (invariantTripleEndpoint (univ.biUnion P) α₀ β₀ γ₀ w.natAbs) *
          invariantTripleEndpoint (univ.biUnion P) α₁ β₁ γ₁
            (w + k * (physicalFreeFactor (repeatedBigPrimePatternCut probes r t i) aux : ℕ)).natAbs) *
        physicalFullPairCorrelation P (repeatedBigPrimePatternCut probes r t i) V q w.natAbs
          (w + k * (physicalFreeFactor (repeatedBigPrimePatternCut probes r t i) aux : ℕ)).natAbs
          (physicalOriginalPrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w.natAbs
            (w + k * (physicalFreeFactor (repeatedBigPrimePatternCut probes r t i) aux : ℕ)).natAbs) := by
  simpa only [physical_prime_phased_pair_coefficient] using
    physical_fixed_root_full_pair_on_support hdis hprime V
      (repeatedBigPrimePatternCut probes r t i) q a b k
      (physicalRootPrimeKernel P V probes r t hrt Q h ξ i) aux positions S hclosure
      (fun n => invariantTripleEndpoint (univ.biUnion P) α₀ β₀ γ₀ n.natAbs)
      (fun n => invariantTripleEndpoint (univ.biUnion P) α₁ β₁ γ₁ n.natAbs) Ψ Z
      (physical_invariant_endpoint_shared_scale _ hprime α₀ β₀ γ₀)
      (physical_invariant_endpoint_shared_scale _ hprime α₁ β₁ γ₁) hsupport

end Bounty
end

section

/- Fixed-auxiliary cutoff coverage, without coverage of unrelated auxiliary shifts. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def physicalFixedAuxPositionClosure {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {J : ℕ} (C : G → Finset (Fin J)) (ell : ℕ)
    (k : ℤ) (aux : PhysicalAuxLabels P C) (S : Finset ℤ) : Finset ℤ :=
  univ.biUnion (fun L : PhysicalMarkLists P J ell =>
    S.image (fun w => (physicalSharedFactor C L : ℤ) * w) ∪
    S.image (fun w => (physicalSharedFactor C L : ℤ) *
      (w + k * (physicalFreeFactor C aux : ℕ))))

theorem physical_fixed_aux_position_coverage {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {J ell : ℕ} (C : G → Finset (Fin J))
    (k : ℤ) (aux : PhysicalAuxLabels P C) (S : Finset ℤ)
    (L : PhysicalMarkLists P J ell) {w : ℤ} (hw : w ∈ S) :
    (physicalSharedFactor C L : ℤ) * w ∈ physicalFixedAuxPositionClosure P C ell k aux S ∧
    (physicalSharedFactor C L : ℤ) * (w + k * (physicalFreeFactor C aux : ℕ)) ∈
      physicalFixedAuxPositionClosure P C ell k aux S := by
  constructor
  · exact mem_biUnion.mpr ⟨L, mem_univ _, mem_union_left _ (mem_image.mpr ⟨w, hw, rfl⟩)⟩
  · exact mem_biUnion.mpr ⟨L, mem_univ _, mem_union_right _ (mem_image.mpr ⟨w, hw, rfl⟩)⟩

theorem physical_fixed_aux_closure_subset_iff {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {J ell : ℕ} (C : G → Finset (Fin J))
    (k : ℤ) (aux : PhysicalAuxLabels P C) (S positions : Finset ℤ) :
    physicalFixedAuxPositionClosure P C ell k aux S ⊆ positions ↔
    ∀ (L : PhysicalMarkLists P J ell) w, w ∈ S →
      (physicalSharedFactor C L : ℤ) * w ∈ positions ∧
      (physicalSharedFactor C L : ℤ) * (w + k * (physicalFreeFactor C aux : ℕ)) ∈ positions := by
  constructor
  · intro h L w hw
    have hc := physical_fixed_aux_position_coverage P C k aux S L hw
    exact ⟨h hc.1, h hc.2⟩
  · intro h n hn
    obtain ⟨L, _, hn⟩ := mem_biUnion.mp hn
    rcases mem_union.mp hn with hn | hn
    · obtain ⟨w, hw, rfl⟩ := mem_image.mp hn
      exact (h L w hw).1
    · obtain ⟨w, hw, rfl⟩ := mem_image.mp hn
      exact (h L w hw).2

end Bounty
end

section

/- Literal positive support of the original harmonic dyadic cutoff. -/

open Finset
namespace Bounty

theorem typeII_harmonic_dyadic_support {t : ℝ} (h : typeIIHarmonicDyadic t ≠ 0) :
    t ∈ Set.Ioo (1/2) 2 := by
  apply typeII_smooth_dyadic_support
  intro hz
  exact h (by simp only [typeIIHarmonicDyadic, hz, mul_zero])

noncomputable def harmonicPositiveSupport (Z : ℝ) (k : ℤ) (d : ℕ) : Finset ℤ :=
  (Icc 1 ⌊2*Z*(d : ℝ)⌋).filter
    (fun w => Z*(d : ℝ)/2 < (w : ℝ) ∧ 0 < w + k*(d : ℤ))

theorem mem_harmonic_positive_support {Z : ℝ} {k w : ℤ} {d : ℕ}
    (hw : w ∈ harmonicPositiveSupport Z k d) :
    0 < w ∧ Z*(d : ℝ)/2 < (w : ℝ) ∧ (w : ℝ) ≤ 2*Z*(d : ℝ) ∧
      0 < w + k*(d : ℤ) := by
  have h := mem_filter.mp hw
  have hi := mem_Icc.mp h.1
  exact ⟨by omega, h.2.1, (Int.le_floor.mp hi.2), h.2.2⟩

theorem original_harmonic_test_support
    (P : Finset ℕ) (α₀ β₀ γ₀ α₁ β₁ γ₁ : ℕ → ℂ)
    {Z : ℝ} (hZ : 0 < Z) (k : ℤ) {d : ℕ} (hd : 0 < d) (w : ℤ)
    (h : (typeIIHarmonicDyadic ((w : ℝ)/(Z*(d : ℝ))) : ℂ) * (w : ℂ)⁻¹ *
      (starRingEnd ℂ) (positiveInvariantEndpoint P α₀ β₀ γ₀ w) *
      positiveInvariantEndpoint P α₁ β₁ γ₁ (w+k*(d : ℤ)) ≠ 0) :
    w ∈ harmonicPositiveSupport Z k d := by
  have hψ : typeIIHarmonicDyadic ((w : ℝ)/(Z*(d : ℝ))) ≠ 0 := by
    intro hz
    apply h
    simp only [hz, Complex.ofReal_zero, zero_mul]
  have hs := typeII_harmonic_dyadic_support hψ
  have hZd : 0 < Z*(d : ℝ) := mul_pos hZ (by exact_mod_cast hd)
  have hlo : Z*(d : ℝ)/2 < (w : ℝ) := by
    have hh := (lt_div_iff₀ hZd).mp hs.1
    linarith
  have hhi : (w : ℝ) < 2*Z*(d : ℝ) := by
    have hh := (div_lt_iff₀ hZd).mp hs.2
    linarith
  have hwpos : 0 < w := by
    have : 0 < (w : ℝ) := lt_trans (half_pos hZd) hlo
    exact_mod_cast this
  have htpos : 0 < w+k*(d : ℤ) := by
    apply positive_invariant_endpoint_nonzero P α₁ β₁ γ₁
    intro hz
    exact h (by rw [hz, mul_zero])
  exact mem_filter.mpr ⟨mem_Icc.mpr ⟨by omega, Int.le_floor.mpr hhi.le⟩, hlo, htpos⟩

theorem harmonic_positive_support_upper_shift {Z : ℝ} (k : ℤ) {d : ℕ}
    (hk : |(k : ℝ)| ≤ Z) {w : ℤ} (hw : w ∈ harmonicPositiveSupport Z k d) :
    (w + k*(d : ℤ) : ℤ) ≤ ⌊3*Z*(d : ℝ)⌋ := by
  have hs := mem_harmonic_positive_support hw
  apply Int.le_floor.mpr
  have hh := mul_le_mul_of_nonneg_right (le_trans (le_abs_self (k : ℝ)) hk)
    (Nat.cast_nonneg d : (0 : ℝ) ≤ d)
  push_cast
  linarith [hs.2.2.1]

end Bounty
end

section

/- The exact error from deleting the two remaining auxiliary indicators is
supported on the free-label divisibility set. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def physicalFreePrimePairError {G : Type*} [Fintype G] [DecidableEq G]
    {J ell : ℕ} (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
    (a b : ℝ) (w z : ℕ) : ℂ :=
  let marks := fun g => ell + (repeatedBigPrimePatternCut probes r t i g).card
  groupMarkedAverage P marks (w : ℤ) (fun u => groupMarkedAverage P marks (z : ℤ)
      (physicalUnsharedPrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w z u)) -
    groupMarkedAverage P marks (w : ℤ) (fun u => groupMarkedAverage P marks (z : ℤ)
      (physicalFreePrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w z u))

theorem physical_free_prime_pair_error_zero {G : Type*} [Fintype G] [dG : DecidableEq G]
    {J ell : ℕ} (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
    (a b : ℝ) (n k : ℤ)
    (hn : ∀ p ∈ physicalFreePrimeSet (repeatedBigPrimePatternCut probes r t i) aux,
      ¬ (p : ℤ) ∣ n) :
    physicalFreePrimePairError P V probes r t hrt Q h ξ i aux a b
      n.natAbs (n + k * (physicalFreeFactor (repeatedBigPrimePatternCut probes r t i) aux : ℕ)).natAbs = 0 := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  unfold physicalFreePrimePairError
  apply sub_eq_zero.mpr
  exact physical_marked_pair_aux_restriction_eq_signed _ aux n k hn _

theorem physical_free_prime_pair_error_norm_le {G : Type*} [Fintype G] [dG : DecidableEq G]
    {J ell : ℕ} (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ) (hξ : 0 < ξ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
    (a b : ℝ) (w z : ℕ) :
    ‖physicalFreePrimePairError P V probes r t hrt Q h ξ i aux a b w z‖ ≤
      2 * repeatedBigPrimePatternBound probes r t Q ξ i := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  unfold physicalFreePrimePairError
  dsimp only
  apply (norm_sub_le _ _).trans
  have hH := repeated_big_prime_pattern_bound_nonneg probes r t Q ξ i
  have hr := group_marked_pair_average_norm_le P _ (w : ℤ) (z : ℤ) _ hH
    (fun u v => physical_unshared_prime_pair_coefficient_norm_le
      P V probes r t hrt Q h ξ i aux a b w z hξ u.val v.val)
  have hf := group_marked_pair_average_norm_le P _ (w : ℤ) (z : ℤ) _ hH
    (fun u v => physical_free_prime_pair_coefficient_norm_le
      P V probes r t hrt Q h ξ i aux a b w z hξ u.val v.val)
  exact (add_le_add hr hf).trans_eq (by ring)

end Bounty
end

section

/- The actual unrestricted prime pair is a product of the two marked
endpoint averages, with the original three phases and pattern sign. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_free_prime_average_separable {G : Type*} [Fintype G] [DecidableEq G]
    {J ell : ℕ} (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ) (hξ : 0 < ξ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i)) :
    let cut := repeatedBigPrimePatternCut probes r t i
    let marks := fun j => ell + (cut j).card
    let W := fun n : ℤ => markedDivisorWeight univ P (1/2) V marks n
    ∃ f g : GroupMarkedLists P marks → ℂ,
      (∀ u, ‖f u‖ ≤ 1 + (Q * Q : ℕ) / ξ) ∧
      (∀ v, ‖g v‖ ≤ 1 + (Q * Q : ℕ) / ξ) ∧
      ∀ (a b : ℝ) (w z : ℕ),
        ((W w * W z : ℝ) : ℂ) * groupMarkedAverage P marks (w : ℤ) (fun u =>
          groupMarkedAverage P marks (z : ℤ)
            (physicalFreePrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w z u)) =
        (repeatedBigPrimePatternWeight probes r t i * physicalPhase a w *
          physicalPhase b z * physicalPhase (-(a+b)) (physicalFreeFactor cut aux)) *
          ((W w : ℂ) * groupMarkedAverage P marks (w : ℤ) f) *
          ((W z : ℂ) * groupMarkedAverage P marks (z : ℤ) g) := by
  dsimp only
  obtain ⟨f, g, hfg, hf, hg⟩ := physical_unshared_prime_kernel_separable P V probes r t hrt Q h ξ hξ i aux
  refine ⟨f, g, hf, hg, ?_⟩
  intro a b w z
  let c := repeatedBigPrimePatternWeight probes r t i * physicalPhase a w *
    physicalPhase b z * physicalPhase (-(a+b)) (physicalFreeFactor (repeatedBigPrimePatternCut probes r t i) aux)
  have heq u v : physicalFreePrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w z u v =
      c * (f u * g v) := by
    unfold physicalFreePrimePairCoefficient
    dsimp only
    rw [hfg]
    dsimp only [c]
    ring
  have heqfun u : physicalFreePrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w z u =
      fun v => c * (f u * g v) := funext (heq u)
  simp_rw [heqfun]
  simp only [← mul_assoc, group_marked_average_mul_left, group_marked_average_mul_right]
  dsimp only [c]
  push_cast
  ring

end Bounty
end

section

/- Uniqueness of selected data makes the exact record phase multiplicative. -/

open Finset
open scoped Classical
namespace Bounty
section Product
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (cut : ℕ → Fin N → Finset (Fin J))
  (S : Finset (PhysicalSelectedData P ell C))
  (r : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C))

theorem physical_selected_record_phase_at
    (w : PhysicalSelectedData P ell C → ℂ) (d : PhysicalSelectedData P ell C)
    (hd : d ∈ S) (ht : physicalSelectedDataRecordTest C cut d r) :
    physicalSelectedDataRecordPhase C cut S w r = w d := by
  unfold physicalSelectedDataRecordPhase
  rw [sum_eq_single d]
  · exact if_pos ht
  · intro e _ he
    apply if_neg
    intro ht'
    exact he (physical_selected_data_record_unique C cut r ht' ht)
  · exact fun hn => (hn hd).elim

theorem physical_selected_record_phase_mul
    (w v : PhysicalSelectedData P ell C → ℂ) :
    physicalSelectedDataRecordPhase C cut S (fun d => w d * v d) r =
      physicalSelectedDataRecordPhase C cut S w r *
      physicalSelectedDataRecordPhase C cut S v r := by
  by_cases h : ∃ d ∈ S, physicalSelectedDataRecordTest C cut d r
  · obtain ⟨d, hd, ht⟩ := h
    rw [physical_selected_record_phase_at C cut S r _ d hd ht,
      physical_selected_record_phase_at C cut S r w d hd ht,
      physical_selected_record_phase_at C cut S r v d hd ht]
  · have hz (f : PhysicalSelectedData P ell C → ℂ) :
        physicalSelectedDataRecordPhase C cut S f r = 0 := by
      unfold physicalSelectedDataRecordPhase
      apply sum_eq_zero
      intro d hd
      exact if_neg (fun ht => h ⟨d, hd, ht⟩)
    rw [hz, hz, zero_mul]

end Product
end Bounty
end

section

/- The unrestricted physical prime pair is expressed using only its selected
big-group averages, while the full marked weights retain every empty fiber. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_free_prime_average_selected {G : Type*} [Fintype G] [DecidableEq G]
    {J ell : ℕ} (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ) (hξ : 0 < ξ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i)) :
    let cut := repeatedBigPrimePatternCut probes r t i
    let marks := fun j => ell + (cut j).card
    let W := fun n : ℤ => markedDivisorWeight univ P (1/2) V marks n
    ∃ f g : GroupMarkedLists (fun j : ↥(r ∪ t) => P j.val) (fun j : ↥(r ∪ t) => marks j.val) → ℂ,
      (∀ u, ‖f u‖ ≤ 1 + (Q * Q : ℕ) / ξ) ∧
      (∀ v, ‖g v‖ ≤ 1 + (Q * Q : ℕ) / ξ) ∧
      ∀ (a b : ℝ) (w z : ℕ),
        ((W w * W z : ℝ) : ℂ) * groupMarkedAverage P marks (w : ℤ) (fun u =>
          groupMarkedAverage P marks (z : ℤ)
            (physicalFreePrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w z u)) =
        (repeatedBigPrimePatternWeight probes r t i * physicalPhase a w *
          physicalPhase b z * physicalPhase (-(a+b)) (physicalFreeFactor cut aux)) *
          ((W w : ℂ) * groupMarkedAverage (fun j : ↥(r ∪ t) => P j.val)
            (fun j : ↥(r ∪ t) => marks j.val) (w : ℤ) f) *
          ((W z : ℂ) * groupMarkedAverage (fun j : ↥(r ∪ t) => P j.val)
            (fun j : ↥(r ∪ t) => marks j.val) (z : ℤ) g) := by
  intro cut marks W
  obtain ⟨f, g, hfg, hf, hg⟩ := physical_unshared_prime_kernel_selected P V probes r t hrt Q h ξ hξ i aux
  refine ⟨f, g, hf, hg, ?_⟩
  intro a b w z
  let c := repeatedBigPrimePatternWeight probes r t i * physicalPhase a w *
    physicalPhase b z * physicalPhase (-(a+b)) (physicalFreeFactor cut aux)
  have heq u v : physicalFreePrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w z u v =
      c * (f (fun j : ↥(r ∪ t) => u j.val) * g (fun j : ↥(r ∪ t) => v j.val)) := by
    unfold physicalFreePrimePairCoefficient
    dsimp only
    rw [hfg]
    dsimp only [c, cut]
    ring
  have heqfun u : physicalFreePrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w z u =
      fun v => c * (f (fun j : ↥(r ∪ t) => u j.val) * g (fun j : ↥(r ∪ t) => v j.val)) := funext (heq u)
  have havg : groupMarkedAverage P marks (w : ℤ) (fun u => groupMarkedAverage P marks (z : ℤ)
      (physicalFreePrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w z u)) =
      c * groupMarkedAverage P marks (w : ℤ) (fun u => groupMarkedAverage P marks (z : ℤ)
        (fun v => f (fun j : ↥(r ∪ t) => u j.val) * g (fun j : ↥(r ∪ t) => v j.val))) := by
    simp_rw [heqfun]
    simp only [groupMarkedAverage, mul_sum]
    apply sum_congr rfl
    intro u _
    apply sum_congr rfl
    intro v _
    ring
  rw [havg]
  calc
    _ = c * (((W w * W z : ℝ) : ℂ) * groupMarkedAverage P marks (w : ℤ)
      (fun u => groupMarkedAverage P marks (z : ℤ)
        (fun v => f (fun j : ↥(r ∪ t) => u j.val) * g (fun j : ↥(r ∪ t) => v j.val)))) := by ring
    _ = c * (((W w : ℂ) * groupMarkedAverage (fun j : ↥(r ∪ t) => P j.val)
        (fun j : ↥(r ∪ t) => marks j.val) (w : ℤ) f) *
      ((W z : ℂ) * groupMarkedAverage (fun j : ↥(r ∪ t) => P j.val)
        (fun j : ↥(r ∪ t) => marks j.val) (z : ℤ) g)) := by
      rw [weighted_group_marked_pair_restrict]
    _ = _ := by dsimp only [c]; ring

end Bounty
end

section

/- Cumulative original big-edge displacement for selected physical data. -/

namespace Bounty

noncomputable def physicalSelectedCumulativeOffset
    {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
    (d : PhysicalSelectedData P ell C) : Fin (n + 1) → ℤ :=
  Fin.partialSum (fun j => k j *
    (physicalD (C j) (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc)) (d.1 j) : ℤ))

end Bounty
