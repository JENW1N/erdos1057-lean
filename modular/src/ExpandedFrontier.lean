section

/- The compact allocation integral with the original finite P factor retained. -/

open Finset MeasureTheory

namespace Bounty

theorem candidate_retained_factor_eq_mul_one (c L : ℝ) (r jStar p : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) :
    candidateRetainedFactor c L r jStar p x take =
      p * candidateRetainedFactor c L r jStar 1 x take := by
  simp only [candidateRetainedFactor, one_mul]

noncomputable def candidateFullPAllocationIntegrand (c L q : ℝ) (r jStar : ℕ)
    (R : ℝ) (S : Finset ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) (F : ℕ → ℕ → ℂ)
    (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ) : ℂ :=
  ∑ p ∈ S, (candidatePWeight c L q p : ℂ) *
    candidateSeparatedAllocationIntegrand c L r jStar R take
      (fun e n => F e (p*n)) ξ

theorem candidate_full_P_allocation_integrable (c L q : ℝ) (r jStar : ℕ)
    (R : ℝ) (S : Finset ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) (F : ℕ → ℕ → ℂ) :
    Integrable (candidateFullPAllocationIntegrand c L q r jStar R S take F) := by
  apply integrable_finsetSum
  intro p hp
  exact (candidate_separated_allocation_integrable c L r jStar R take
    (fun e n => F e (p*n))).const_mul _

theorem candidate_full_P_compact_allocation_integral (c L q : ℝ) (r jStar : ℕ)
    (R : ℝ) (S : Finset ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hkeep : ∀ i, candidateAllocationActive c L r jStar i = false → take i = false)
    (F : ℕ → ℕ → ℂ) :
    (∑ p ∈ S, (candidatePWeight c L q p : ℂ) *
      ((∑ x : ∀ slot, candidateQSlotChoices c L r jStar slot,
        (candidateCompactAllocationWeight c L r jStar x R take : ℂ) *
          F (candidateAllocatedFactor c L r jStar x take)
            (candidateRetainedFactor c L r jStar p x take)) /
          (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ))) =
      ∫ ξ, candidateFullPAllocationIntegrand c L q r jStar R S take F ξ := by
  unfold candidateFullPAllocationIntegrand
  rw [integral_finsetSum]
  · apply sum_congr rfl
    intro p hp
    rw [integral_const_mul]
    congr 1
    simp_rw [candidate_retained_factor_eq_mul_one c L r jStar p]
    exact candidate_compact_allocation_separated_integral c L r jStar R take hkeep
      (fun e n => F e (p*n))
  · intro p hp
    exact (candidate_separated_allocation_integrable c L r jStar R take
      (fun e n => F e (p*n))).const_mul _


end Bounty
end

section

/- Permutation occurrences have no birth addresses and keep their original active averaging row. -/

open Finset Classical
namespace Bounty
section Local
variable {J K : Type*} {N : ℕ} {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (steps : List (Option (J ⊕ K)))
  (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))

theorem full_mixed_permutation_unaffected (i : Fin steps.length) (htag : steps.get i = none) :
    i ∉ fullMixedBirthAffectedOperations S B steps code := by
  intro hi
  simp only [fullMixedBirthAffectedOperations, birthForestAffectedOperations, mem_image] at hi
  obtain ⟨j, _, hj⟩ := hi
  change (fullMixedBirthOrder S B steps j).1 = i at hj
  have a : FullMixedLocalBirthAddress S B (steps.get i) := hj ▸ (fullMixedBirthOrder S B steps j).2
  rw [htag] at a
  exact Fin.elim0 a.2

end Local
section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ) (steps : List (Option (J ⊕ K)))
  (residual : ∀ (tag : Option (J ⊕ K)) s, FullPermutationMixedEvent n S B A Δ D tag s → ℂ)
  (initial : (g : Fin N) → Finset (P g))
  (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))
  (θ : (Fin (Fintype.card (FullMixedBirthAddress S B steps)) ×
    Fin (Fintype.card (FullMixedBirthAddress S B steps))) → ℝ)
  (encode : ((g : Fin N) × P g) → ℤ)

theorem full_mixed_permutation_stage_phase
    (hnone : ∀ s e, residual none s e = 1)
    (i : Fin steps.length) (htag : steps.get i = none)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (steps.get i) s) :
    fullMixedForestStagePhase n S B A Δ D steps residual initial code θ encode i s e = 1 := by
  rw [full_mixed_untouched_stage_phase n S B A Δ D steps residual initial code θ encode i
    (full_mixed_permutation_unaffected S B steps code i htag)]
  have ha : FullMixedLocalBirthAvoids n S B A Δ D initial (steps.get i) s e := by
    intro a
    have a' : FullMixedLocalBirthAddress S B none := htag ▸ a
    exact Fin.elim0 a'.2
  rw [if_pos ha, mul_one]
  generalize ht : steps.get i = tag at e ⊢
  have ht' : tag = none := ht.symm.trans htag
  clear ht
  subst tag
  exact hnone s e

variable [∀ g, Fintype (P g)] [∀ g p, NeZero (n g p)] [∀ k c, Fintype (A k c)]
  (ω : ∀ k c, A k c → ℝ) (μ : (g : Fin N) → P g → ℝ)
  (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

theorem full_mixed_permutation_stage_row
    (hnone : ∀ s e, residual none s e = 1)
    (i : Fin steps.length) (htag : steps.get i = none)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    fullMixedForestStageRow n S B A Δ D ω μ q ρ V steps residual initial code θ encode i f s =
      fullActiveAverage f s := by
  unfold fullMixedForestStageRow
  simp_rw [full_mixed_permutation_stage_phase n S B A Δ D steps residual initial code θ encode hnone i htag]
  generalize ht : steps.get i = tag
  have ht' : tag = none := ht.symm.trans htag
  clear ht
  subst tag
  exact congrFun (full_permutation_phased_row_permutation n S B A Δ D (fun _ _ _ => 1)
    ω μ q ρ V (fun _ _ => rfl) f) s

end Full
end Bounty
end

section

/- Box truncation keeps the original Q normalization and full marked coefficient. -/

open Finset MeasureTheory

namespace Bounty

noncomputable def candidateBoxRangeQWeight (c L : ℝ) (r jStar : ℕ) (E R : ℝ) (n : ℕ) : ℂ :=
  ∑ x : ∀ slot, candidateQSlotChoices c L r jStar slot,
    if orderedSlotProduct (candidateQSlotChoices c L r jStar) x=n
    then candidateBoxRangeAllocationMass c L r jStar x E R /
      (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ) else 0

noncomputable def candidateBoxRangeCoefficient (c L q : ℝ) (r jStar : ℕ) (E R : ℝ) (u : ℕ) : ℂ :=
  candidateBoxRangeQWeight c L r jStar E R
    (primePoolFreePart ((candidatePIndices c L).biUnion (candidatePBand (c*L))) u) *
  (markedDivisorWeight (candidatePIndices c L) (candidatePBand (c*L)) q
    (fun j => ∑ p ∈ candidatePBand (c*L) j, 1/(p : ℝ)) (fun _ => 1) (u : ℤ) : ℝ)

theorem candidate_box_Q_error (c L : ℝ) (r jStar : ℕ) (E R : ℝ) (n : ℕ) {err : ℝ}
    (herror : ∀ x, ‖(candidateRangeAllocationMass c L r jStar x E : ℂ) -
      candidateBoxRangeAllocationMass c L r jStar x E R‖ ≤ err) :
    ‖(candidateCompactRangeQWeight c L r jStar E n : ℂ) -
      candidateBoxRangeQWeight c L r jStar E R n‖ ≤ err*candidateQWeight c L r jStar n := by
  have hh := ordered_slot_complex_error_bound (candidateQSlotChoices c L r jStar)
    (show 0 < (r.factorial : ℝ)^(candidateQIndices c L).card by positivity) n
    (fun x => (candidateRangeAllocationMass c L r jStar x E : ℂ))
    (fun x => candidateBoxRangeAllocationMass c L r jStar x E R) herror
  simpa only [candidateCompactRangeQWeight, candidateBoxRangeQWeight, candidateQWeight,
    Complex.ofReal_sum, apply_ite, Complex.ofReal_div, Complex.ofReal_zero] using hh

theorem candidate_box_coefficient_error (c L : ℝ) {q : ℝ} (hq : 0 ≤ q)
    (r jStar : ℕ) (E R : ℝ) (u : ℕ) {err : ℝ}
    (herror : ∀ x, ‖(candidateRangeAllocationMass c L r jStar x E : ℂ) -
      candidateBoxRangeAllocationMass c L r jStar x E R‖ ≤ err) :
    ‖(candidateCompactRangeCoefficient c L q r jStar E u : ℂ) -
      candidateBoxRangeCoefficient c L q r jStar E R u‖ ≤ err*candidateCoefficient c L q r jStar u := by
  have hw := marked_divisor_weight_nonneg (candidatePIndices c L) (candidatePBand (c*L)) hq
    (fun j => ∑ p ∈ candidatePBand (c*L) j, 1/(p : ℝ)) (fun _ => 1)
    (fun _ _ => sum_nonneg (fun _ _ => by positivity)) (u : ℤ)
  unfold candidateCompactRangeCoefficient candidateBoxRangeCoefficient candidateCoefficient
  rw [Complex.ofReal_mul, ← sub_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hw]
  simpa only [mul_assoc] using mul_le_mul_of_nonneg_right
    (candidate_box_Q_error c L r jStar E R _ herror) hw

end Bounty
end

section

/- A concrete finite geometric localization and its fixed logarithmic box. -/

open Finset

namespace Bounty

noncomputable def typeIIDyadicIndex (Z z : ℝ) : ℕ := ⌊Real.logb 2 (z / Z)⌋₊

theorem typeII_dyadic_index_interval {Z z : ℝ} (hZ : 0 < Z) (hz : Z ≤ z) :
    z ∈ Set.Ico (Z * 2 ^ typeIIDyadicIndex Z z) (2 * (Z * 2 ^ typeIIDyadicIndex Z z)) := by
  have hone : 1 ≤ z / Z := (le_div_iff₀ hZ).mpr (by simpa using hz)
  have hp : 0 < z / Z := zero_lt_one.trans_le hone
  have hlog : 0 ≤ Real.logb 2 (z / Z) := Real.logb_nonneg (by norm_num) hone
  have hlo : (2 : ℝ) ^ typeIIDyadicIndex Z z ≤ z / Z := by
    rw [← Real.rpow_natCast]
    apply (Real.le_logb_iff_rpow_le (by norm_num) hp).mp
    exact Nat.floor_le hlog
  have hhi : z / Z < (2 : ℝ) ^ (typeIIDyadicIndex Z z + 1) := by
    rw [← Real.rpow_natCast]
    apply (Real.logb_lt_iff_lt_rpow (by norm_num) hp).mp
    simpa only [typeIIDyadicIndex, Nat.cast_add, Nat.cast_one] using
      Nat.lt_floor_add_one (Real.logb 2 (z / Z))
  constructor
  · have hh := (le_div_iff₀ hZ).mp hlo
    nlinarith
  · have hh := (div_lt_iff₀ hZ).mp hhi
    rw [pow_succ] at hh
    nlinarith

theorem typeII_dyadic_index_bound {Z z R : ℝ} (hZ : 0 < Z) (hz : Z ≤ z)
    (hzR : z ≤ R * Z) : typeIIDyadicIndex Z z ≤ ⌈Real.logb 2 R⌉₊ := by
  have hone : 1 ≤ z / Z := (le_div_iff₀ hZ).mpr (by simpa using hz)
  have hp : 0 < z / Z := zero_lt_one.trans_le hone
  have hratio : z / Z ≤ R := (div_le_iff₀ hZ).mpr hzR
  have hlog : Real.logb 2 (z / Z) ≤ Real.logb 2 R :=
    (Real.logb_le_logb (by norm_num) hp (hp.trans_le hratio)).mpr hratio
  have hf : (typeIIDyadicIndex Z z : ℝ) ≤ Real.logb 2 R :=
    (Nat.floor_le (Real.logb_nonneg (by norm_num) hone)).trans hlog
  exact_mod_cast hf.trans (Nat.le_ceil _)

theorem typeII_factor_two_log_box {s t : ℝ} (hs : 0 < s)
    (ht : t ∈ Set.Icc s (2 * s)) : Real.log (t / s) ∈ Set.Icc (-1) 1 := by
  have hlo : 1 ≤ t / s := (le_div_iff₀ hs).mpr (by simpa using ht.1)
  have hhi : t / s ≤ 2 := (div_le_iff₀ hs).mpr (by nlinarith [ht.2])
  have hp : 0 < t / s := zero_lt_one.trans_le hlo
  have hlog := Real.log_le_sub_one_of_pos hp
  have hnonneg := Real.log_nonneg hlo
  constructor <;> linarith

theorem typeII_three_factor_two_log_box {U Z m m' z : ℝ}
    (hU : 0 < U) (hZ : 0 < Z)
    (hm : m ∈ Set.Icc U (2 * U)) (hm' : m' ∈ Set.Icc U (2 * U))
    (hz : z ∈ Set.Icc Z (2 * Z)) :
    ∀ i, typeIILogCoordinates ![m, m', z] ![U, U, Z] i ∈ Set.Icc (-1) 1 := by
  intro i
  fin_cases i
  · exact typeII_factor_two_log_box hU hm
  · exact typeII_factor_two_log_box hU hm'
  · exact typeII_factor_two_log_box hZ hz

theorem typeII_finite_sum_dyadic_partition {ι : Type*} (S : Finset ι)
    (z : ι → ℝ) (f : ι → ℂ) {Z R : ℝ} (hZ : 0 < Z)
    (hz : ∀ i ∈ S, Z ≤ z i ∧ z i ≤ R * Z) :
    ∑ i ∈ S, f i = ∑ j ∈ range (⌈Real.logb 2 R⌉₊ + 1),
      ∑ i ∈ S with typeIIDyadicIndex Z (z i) = j, f i := by
  classical
  simp only [sum_filter]
  rw [sum_comm]
  apply sum_congr rfl
  intro i hi
  rw [sum_ite_eq]
  have hj : typeIIDyadicIndex Z (z i) ∈ range (⌈Real.logb 2 R⌉₊ + 1) :=
    mem_range.mpr (Nat.lt_succ_of_le (typeII_dyadic_index_bound hZ (hz i hi).1 (hz i hi).2))
  simp [hj]

end Bounty
end

section

/- Separated Mellin powers for the actual three-variable real majorant. -/

open Finset MeasureTheory

namespace Bounty

noncomputable def typeIICrossFourierPowers (y : TypeIIShiftIndex)
    (ξ : EuclideanSpace ℝ (Fin 3)) : ℂ :=
  typeIIPhase (2*Real.pi*ξ 0) y.2.1.1 * typeIIPhase (2*Real.pi*ξ 1) y.2.2.1 *
    typeIIPhase (2*Real.pi*ξ 2) y.1.2

noncomputable def typeIICrossFourierScale (A L U V E Z : ℝ) (k : ℤ)
    (ξ : EuclideanSpace ℝ (Fin 3)) : ℂ :=
  (∏ i, ((![U,U,Z] : Fin 3 → ℝ) i : ℂ)^(-((2*Real.pi*ξ i : ℝ):ℂ)*Complex.I)) *
    typeIIPulledFourier A (L^88) (U/(2*(k:ℝ)*E)) (Z/((k:ℝ)*U*V)) (1/(U*V)) ξ

theorem typeII_cross_fourier_powers_eq (y : TypeIIShiftIndex)
    (hm : 0 < y.2.1.1) (hm' : 0 < y.2.2.1) (hz : 0 < y.1.2)
    (ξ : EuclideanSpace ℝ (Fin 3)) :
    typeIICrossFourierPowers y ξ =
      ∏ i, ((![(y.2.1.1:ℝ),(y.2.2.1:ℝ),(y.1.2:ℝ)] : Fin 3 → ℝ) i : ℂ)^
        (((2*Real.pi*ξ i : ℝ):ℂ)*Complex.I) := by
  simp [typeIICrossFourierPowers, Fin.prod_univ_three,
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Complex.ofReal_natCast,
    typeIIPhase_eq_cpow _ hm, typeIIPhase_eq_cpow _ hm', typeIIPhase_eq_cpow _ hz]

theorem typeII_cross_fourier_kernel_eq (A L U V E Z : ℝ) (k : ℤ) (y : TypeIIShiftIndex)
    (hU : 0 < U) (hZ : 0 < Z) (hm : 0 < y.2.1.1) (hm' : 0 < y.2.2.1)
    (hz : 0 < y.1.2) (ξ : EuclideanSpace ℝ (Fin 3)) :
    typeIICrossFourierScale A L U V E Z k ξ * typeIICrossFourierPowers y ξ =
      typeIIPulledFourierIntegrand A (L^88) (U/(2*(k:ℝ)*E)) (Z/((k:ℝ)*U*V)) (1/(U*V))
        (typeIILogCoordinates ![(y.2.1.1:ℝ),(y.2.2.1:ℝ),(y.1.2:ℝ)] ![U,U,Z]) ξ := by
  rw [typeIICrossFourierScale, typeII_cross_fourier_powers_eq y hm hm' hz ξ,
    typeIIPulledFourierIntegrand, typeII_pulled_logarithmic_phase_separation]
  · ring
  · intro i
    fin_cases i
    · change (0:ℝ) < (y.2.1.1:ℝ)
      exact_mod_cast hm
    · change (0:ℝ) < (y.2.2.1:ℝ)
      exact_mod_cast hm'
    · change (0:ℝ) < (y.1.2:ℝ)
      exact_mod_cast hz
  · intro i
    fin_cases i
    · exact hU
    · exact hU
    · exact hZ

theorem typeII_cross_fourier_kernel_integrable (A L U V E Z : ℝ) (k : ℤ)
    (y : TypeIIShiftIndex) (hU : 0 < U) (hZ : 0 < Z)
    (hm : 0 < y.2.1.1) (hm' : 0 < y.2.2.1) (hz : 0 < y.1.2) :
    Integrable (fun ξ : EuclideanSpace ℝ (Fin 3) =>
      typeIICrossFourierScale A L U V E Z k ξ * typeIICrossFourierPowers y ξ) := by
  apply (typeII_pulled_fourier_integrand_integrable A (L^88) (U/(2*(k:ℝ)*E))
    (Z/((k:ℝ)*U*V)) (1/(U*V))
    (typeIILogCoordinates ![(y.2.1.1:ℝ),(y.2.2.1:ℝ),(y.1.2:ℝ)] ![U,U,Z])).congr
  apply Filter.Eventually.of_forall
  intro ξ
  exact (typeII_cross_fourier_kernel_eq A L U V E Z k y hU hZ hm hm' hz ξ).symm

theorem typeII_cross_majorant_fourier_inversion {A L U V E Z : ℝ} {k : ℤ}
    {y : TypeIIShiftIndex} (hU : 0 < U) (hV : 0 < V) (hZ : 0 < Z) (hk : k ≠ 0)
    (hyk : y.1.1 = k) (hm : 0 < y.2.1.1) (hm' : 0 < y.2.2.1) (hz : 0 < y.1.2)
    (hbox : ∀ i, typeIILogCoordinates ![(y.2.1.1:ℝ),(y.2.2.1:ℝ),(y.1.2:ℝ)]
      ![U,U,Z] i ∈ Set.Icc (-A) A) :
    ((typeIIEMajorant (L^88) (typeIIRealE y / E) *
      typeIINMajorant (typeIIRealN y / V) : ℝ):ℂ) =
      ∫ ξ : EuclideanSpace ℝ (Fin 3),
        typeIICrossFourierScale A L U V E Z k ξ * typeIICrossFourierPowers y ξ := by
  have h := typeII_scale_majorant_fourier_inversion (A := A) (L := L) (E := E) (k := (k:ℝ))
    (m := (y.2.1.1:ℝ)) (m' := (y.2.2.1:ℝ)) (z := (y.1.2:ℝ))
    (by exact_mod_cast hm) (by exact_mod_cast hm') (by exact_mod_cast hz)
    hU hV hZ (by exact_mod_cast hk) hbox
  change ((typeIIEMajorant (L^88) (typeIIRealE y / E) *
      typeIINMajorant (typeIIRealN y / V) : ℝ):ℂ) = _
  rw [typeIIRealE, typeIIRealN, hyk]
  apply h.trans
  apply integral_congr_ae
  apply Filter.Eventually.of_forall
  intro ξ
  dsimp only
  rw [typeII_cross_fourier_powers_eq y hm hm' hz ξ, typeIICrossFourierScale]
  ring

end Bounty
end

section

/- The actual enlarged smooth energy retains an outside factor proportional to EV. -/

open Finset

namespace Bounty

theorem typeII_sum_norm_sq_of_range (S : Finset ℕ) (f : ℕ → ℂ) {X A : ℝ}
    (hX : 0 ≤ X) (hpos : ∀ n ∈ S, 0 < n) (hupper : ∀ n ∈ S, (n : ℝ) ≤ X)
    (hf : ∀ n ∈ S, ‖f n‖ ≤ A) : ∑ n ∈ S, ‖f n‖ ^ 2 ≤ X * A ^ 2 := by
  have hsub : S ⊆ Icc 1 ⌊X⌋₊ := by
    intro n hn
    exact mem_Icc.mpr ⟨hpos n hn, Nat.le_floor (hupper n hn)⟩
  have hcard : S.card ≤ ⌊X⌋₊ := by simpa using card_le_card hsub
  have hcardR : (S.card : ℝ) ≤ X :=
    (by exact_mod_cast hcard : (S.card : ℝ) ≤ (⌊X⌋₊ : ℝ)).trans (Nat.floor_le hX)
  calc
    _ ≤ ∑ _n ∈ S, A ^ 2 := sum_le_sum (fun n hn =>
      pow_le_pow_left₀ (norm_nonneg _) (hf n hn) 2)
    _ = (S.card : ℝ) * A ^ 2 := by simp
    _ ≤ _ := mul_le_mul_of_nonneg_right hcardR (sq_nonneg _)

theorem typeII_actual_smooth_cauchy (E₀ N₀ M H : Finset ℕ)
    (aE β α aH : ℕ → ℂ) {L E V A B : ℝ}
    (hL : 0 < L) (hE : 0 < E) (hV : 0 < V)
    (he : ∀ e ∈ E₀, E / L ^ 88 ≤ (e : ℝ) ∧ (e : ℝ) ≤ E)
    (hn : ∀ n ∈ N₀, V ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2 * V)
    (haE : ∀ e ∈ E₀, ‖aE e‖ ≤ A) (hβ : ∀ n ∈ N₀, ‖β n‖ ≤ B) :
    let EF := Icc ⌈E / (2 * L ^ 88)⌉₊ ⌊2 * E⌋₊
    let NF := Icc ⌈V / 2⌉₊ ⌊3 * V⌋₊
    let η := fun e n : ℕ => typeIIEMajorant (L ^ 88) ((e : ℝ) / E) *
      typeIINMajorant ((n : ℝ) / V)
    ‖∑ e ∈ E₀, ∑ n ∈ N₀, aE e * β n * typeIIInnerSum M H α aH e n‖ ^ 2 ≤
      (2 * E * V * A ^ 2 * B ^ 2) *
        (typeIIDiagonalEnergy EF NF M H η α aH + typeIIOffDiagonalEnergy EF NF M H η α aH) := by
  dsimp only
  let EF := Icc ⌈E / (2 * L ^ 88)⌉₊ ⌊2 * E⌋₊
  let NF := Icc ⌈V / 2⌉₊ ⌊3 * V⌋₊
  let η := fun e n : ℕ => typeIIEMajorant (L ^ 88) ((e : ℝ) / E) *
    typeIINMajorant ((n : ℝ) / V)
  have hP : 0 < L ^ 88 := pow_pos hL _
  have hlow : E / (2 * L ^ 88) ≤ E / L ^ 88 :=
    div_le_div_of_nonneg_left hE.le hP (by nlinarith)
  have hEE : E₀ ⊆ EF := by
    intro e he₀
    exact mem_Icc.mpr ⟨Nat.ceil_le.mpr (hlow.trans (he e he₀).1),
      Nat.le_floor ((he e he₀).2.trans (by linarith))⟩
  have hNN : N₀ ⊆ NF := by
    intro n hn₀
    exact mem_Icc.mpr ⟨Nat.ceil_le.mpr (by linarith [(hn n hn₀).1]),
      Nat.le_floor (by linarith [(hn n hn₀).2])⟩
  have hEF : ∀ e ∈ EF, 0 < e := by
    intro e heF
    have hlo := (Nat.le_ceil (E / (2 * L ^ 88))).trans
      (by exact_mod_cast (mem_Icc.mp heF).1 : (⌈E / (2 * L ^ 88)⌉₊ : ℝ) ≤ e)
    have hp : (0 : ℝ) < e := lt_of_lt_of_le (by positivity) hlo
    exact_mod_cast hp
  have hη : ∀ e ∈ EF, ∀ n ∈ NF, 0 ≤ η e n := by
    intro e _ n _
    exact mul_nonneg (typeII_e_majorant_bounds _ _).1 (typeII_n_majorant_bounds _).1
  have hη₀ : ∀ e ∈ E₀, ∀ n ∈ N₀, 1 ≤ η e n := by
    intro e he₀ n hn₀
    have helo : (L ^ 88)⁻¹ ≤ (e : ℝ) / E := by
      apply (le_div_iff₀ hE).mpr
      calc
        (L ^ 88)⁻¹ * E = E / L ^ 88 := by ring
        _ ≤ e := (he e he₀).1
    have hehi : (e : ℝ) / E ≤ 1 := (div_le_one hE).mpr (he e he₀).2
    have hnlo : 1 ≤ (n : ℝ) / V := (le_div_iff₀ hV).mpr (by simpa using (hn n hn₀).1)
    have hnhi : (n : ℝ) / V ≤ 2 := (div_le_iff₀ hV).mpr (hn n hn₀).2
    have heq := typeII_e_majorant_log_scale_eq_one hL ⟨helo, hehi⟩
    change 1 ≤ typeIIEMajorant (L ^ 88) ((e : ℝ) / E) * typeIINMajorant ((n : ℝ) / V)
    rw [heq, typeII_n_majorant_eq_one ⟨hnlo, hnhi⟩]
    norm_num
  have henergy : 0 ≤ typeIIDiagonalEnergy EF NF M H η α aH +
      typeIIOffDiagonalEnergy EF NF M H η α aH := by
    rw [← typeII_energy_split EF NF M H η α aH hEF]
    exact sum_nonneg (fun e heF => sum_nonneg (fun n hnF =>
      mul_nonneg (hη e heF n hnF) (sq_nonneg _)))
  have hEA := typeII_sum_norm_sq_of_range E₀ aE hE.le
    (fun e he₀ => hEF e (hEE he₀)) (fun e he₀ => (he e he₀).2) haE
  have hNB := typeII_sum_norm_sq_of_range N₀ β (by linarith : 0 ≤ 2 * V)
    (fun n hn₀ => by have hp : (0 : ℝ) < n := hV.trans_le (hn n hn₀).1; exact_mod_cast hp)
    (fun n hn₀ => (hn n hn₀).2) hβ
  have hout : (∑ e ∈ E₀, ‖aE e‖ ^ 2) * (∑ n ∈ N₀, ‖β n‖ ^ 2) ≤
      2 * E * V * A ^ 2 * B ^ 2 := by
    calc
      _ ≤ (E * A ^ 2) * ((2 * V) * B ^ 2) :=
        mul_le_mul hEA hNB (by positivity) (by positivity)
      _ = 2 * E * V * A ^ 2 * B ^ 2 := by ring
  exact (typeII_cauchy_enlarged_majorant E₀ N₀ EF NF M H aE β α aH η
    hEE hNN hEF hη hη₀).trans (mul_le_mul_of_nonneg_right hout henergy)

end Bounty
end

section

/- Total variation of all actual pre-Cauchy Fourier variables, independent of the allocation target. -/

open Finset Filter MeasureTheory Real

namespace Bounty

noncomputable def candidateMixedFourierVariation (c L : ℝ) (r jStar : ℕ)
    (B R T : ℝ) : ℝ :=
  (∫ ν in {ν : ℝ | ‖ν‖ ≤ T}, ‖typeIIWindowFourier (L^B) ν‖) *
    ∑ take ∈ (univ : Finset (Fin ((candidateQIndices c L).card*r) → Bool)).filter
      (fun take => ∀ i, candidateAllocationActive c L r jStar i = false → take i = false),
      ∫ ξ, ‖activeAllocationFourierWeight (candidateAllocationRadius r)
        (candidateAllocationActive c L r jStar) take ξ‖
        ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) R

theorem exists_candidate_mixed_fourier_variation_bound {c B : ℝ}
    (hc : 0 < c) (hB : 0 ≤ B) (r : ℕ) :
    ∃ Cf : ℝ, 0 < Cf ∧ ∀ᶠ L : ℝ in atTop, ∀ (jStar : ℕ) (R T : ℝ),
      candidateMixedFourierVariation c L r jStar B R T ≤ L^Cf := by
  obtain ⟨C,hC,hCl1⟩ := typeII_cutoff_fourier_l1_bound (candidateAllocationRadius r)
  have h2C : 1 ≤ 2*C := by linarith
  obtain ⟨H,hH,hwin⟩ := typeII_window_fourier_polynomial_cost hB
  refine ⟨H+candidateSlotCostExponent r (2*C),
    add_pos_of_pos_of_nonneg hH (candidate_slot_cost_exponent_nonneg r h2C),?_⟩
  filter_upwards [hwin, eventually_candidate_slot_power_le_rpow hc h2C r,
    eventually_gt_atTop (0 : ℝ)] with L hwinL hslotL hL
  intro jStar R T
  have hw : (∫ ν in {ν : ℝ | ‖ν‖ ≤ T}, ‖typeIIWindowFourier (L^B) ν‖) ≤ L^H := by
    exact (setIntegral_le_integral (typeII_window_fourier_integrable (L^B)).norm
      (Filter.Eventually.of_forall (fun ν => norm_nonneg _))).trans hwinL
  have hs := (active_allocation_all_patterns_variation (candidateAllocationRadius r) C R
    hC hCl1 (candidateAllocationActive c L r jStar)).trans hslotL
  unfold candidateMixedFourierVariation
  calc
    _ ≤ L^H*L^candidateSlotCostExponent r (2*C) :=
      mul_le_mul hw hs
        (sum_nonneg (fun take ht => integral_nonneg (fun ξ => norm_nonneg _)))
        (rpow_nonneg hL.le _)
    _ = _ := (rpow_add hL _ _).symm

end Bounty
end

section

/- Common forest constraints on original paths depend only on their completed chronological history. -/

namespace Bounty
section History
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ) (steps : List (Option (J ⊕ K)))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps s)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P))
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))

theorem full_mixed_common_forest_stage_history_iff (u : Fin steps.length) :
    birthForestStageCondition (fullMixedCommonIndexStage M B steps) u.succ
      (fullMixedCommonPathHistory n S B A Δ D steps s p history (u.val + 1)) code ↔
    birthForestStageCondition (fullMixedCommonIndexStage M B steps) u.succ
      (fun i => fullMixedCommonBirthLabel n S B A Δ D steps s p (fullMixedCommonBirthOrder M B steps i)) code := by
  apply birth_forest_stage_congr _ (full_mixed_common_index_stage_monotone M B steps)
  intro i hi
  exact if_pos hi

theorem full_mixed_common_forest_compatible_iff_history_stages
    (hcode : ∀ i, fullMixedCommonIndexStage M B steps i = 0 → code i = none) :
    birthForestCompatible
      (fun i => fullMixedCommonBirthPerformed n S B A Δ D steps s p (fullMixedCommonBirthOrder M B steps i))
      (fun i => fullMixedCommonBirthLabel n S B A Δ D steps s p (fullMixedCommonBirthOrder M B steps i)) code ↔
    ∀ u : Fin steps.length, birthForestStageCondition (fullMixedCommonIndexStage M B steps) u.succ
      (fullMixedCommonPathHistory n S B A Δ D steps s p history (u.val + 1)) code := by
  change birthForestCompatible
    (fun i => (fullMixedCommonBirthLabel n S B A Δ D steps s p (fullMixedCommonBirthOrder M B steps i)).isSome = true) _ _ ↔ _
  rw [birth_forest_compatible_iff_event_stages (fullMixedCommonIndexStage M B steps) code hcode]
  exact forall_congr' fun u => (full_mixed_common_forest_stage_history_iff n S B A Δ D steps s p history code u).symm

end History
end Bounty
end

section

/- With no selected initial child, forest rank is exactly the number of selected original event births. -/

open Finset Classical
namespace Bounty
variable {J K : Type*} {N : ℕ} (M : Fin N → ℕ) (B : ℕ)
  (steps : List (Option (J ⊕ K)))

def fullMixedCommonBirthGroup : FullMixedCommonBirthAddress M B steps → Fin N
  | .inl a => a.1
  | .inr a => a.2.1

noncomputable def fullMixedCommonSelectedCount
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))
    (u : Fin steps.length) (g : Fin N) : ℕ :=
  (univ.filter (fun i => fullMixedCommonIndexStage M B steps i = u.succ ∧
    fullMixedCommonBirthGroup M B steps (fullMixedCommonBirthOrder M B steps i) = g ∧ code i ≠ none)).card

theorem full_mixed_common_selected_count_sum
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))
    (hcode : ∀ i, fullMixedCommonIndexStage M B steps i = 0 → code i = none) :
    (∑ u, ∑ g, fullMixedCommonSelectedCount M B steps code u g) = birthForestRank code := by
  have h := forest_rank_partition code (fullMixedCommonIndexStage M B steps)
    (fun i => fullMixedCommonBirthGroup M B steps (fullMixedCommonBirthOrder M B steps i))
  rw [Fin.sum_univ_succ] at h
  have hz : ∀ g : Fin N,
      (univ.filter (fun i => fullMixedCommonIndexStage M B steps i = 0 ∧
        fullMixedCommonBirthGroup M B steps (fullMixedCommonBirthOrder M B steps i) = g ∧ code i ≠ none)).card = 0 := by
    intro g
    apply card_eq_zero.mpr
    apply eq_empty_iff_forall_notMem.mpr
    intro i hi
    have hm := (mem_filter.mp hi).2
    exact hm.2.2 (hcode i hm.1)
  simp only [hz, sum_const_zero, zero_add] at h
  exact h

theorem full_mixed_common_selected_power_prod
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))
    (hcode : ∀ i, fullMixedCommonIndexStage M B steps i = 0 → code i = none) (x : ℝ) :
    (∏ u, ∏ g, x ^ fullMixedCommonSelectedCount M B steps code u g) = x ^ birthForestRank code := by
  simp_rw [prod_pow_eq_pow_sum]
  rw [full_mixed_common_selected_count_sum M B steps code hcode]

end Bounty
end

section

/- Actual sparse mean-square bounds for integer Dirichlet polynomials on a dyad. -/

open scoped BigOperators

namespace Bounty

theorem logarithmic_sparse_unit_interval_suprema (indices : Finset ℤ)
    (a b : ℕ) (c : ℕ → ℂ) (N : ℕ) {l r U : ℝ}
    (hU : 1 ≤ U) (ha : U ≤ (a : ℝ)) (hb : (b : ℝ) ≤ 2 * U)
    (hleft : ∀ j ∈ indices, l ≤ (j : ℝ))
    (hright : ∀ j ∈ indices, (j : ℝ) + 1 ≤ r) (hwidth : r - l ≤ N) :
    (∑ j ∈ indices, unitIntervalEnergySup
      (fun t => ∑ n ∈ Finset.Icc a b, c n *
        Complex.exp ((Real.log (n : ℝ) * t : ℝ) * Complex.I)) j) ≤
      (3 * (24 * Real.pi * U) * (1 + 2 * (1 + Real.log N)) +
        (indices.card : ℝ) * (216 * Real.sqrt N)) *
        ∑ n ∈ Finset.Icc a b, ‖c n‖ ^ 2 := by
  apply sparse_dirichlet_unit_interval_suprema indices (Finset.Icc a b) c N
    (by positivity) (by positivity) hleft hright hwidth
  intro z hz
  simpa only [mul_comm] using logarithmic_sparse_gram_kernel a b U N z hU ha hb hz

theorem logarithmic_sparse_interval_energy_bound (indices : Finset ℤ)
    (a b : ℕ) (c : ℕ → ℂ) (N : ℕ) {l r U V : ℝ}
    (hU : 1 ≤ U) (ha : U ≤ (a : ℝ)) (hb : (b : ℝ) ≤ 2 * U)
    (hleft : ∀ j ∈ indices, l ≤ (j : ℝ))
    (hright : ∀ j ∈ indices, (j : ℝ) + 1 ≤ r) (hwidth : r - l ≤ N)
    (hcard : (indices.card : ℝ) * (216 * Real.sqrt N) ≤ U)
    (henergy : (∑ n ∈ Finset.Icc a b, ‖c n‖ ^ 2) ≤ V / U) :
    (∑ j ∈ indices, unitIntervalEnergySup
      (fun t => ∑ n ∈ Finset.Icc a b, c n *
        Complex.exp ((Real.log (n : ℝ) * t : ℝ) * Complex.I)) j) ≤
      (72 * Real.pi * (1 + 2 * (1 + Real.log N)) + 1) * V := by
  have hU0 : 0 < U := lt_of_lt_of_le zero_lt_one hU
  have hlog := Real.log_natCast_nonneg N
  have hc0 : 0 ≤ ∑ n ∈ Finset.Icc a b, ‖c n‖ ^ 2 :=
    Finset.sum_nonneg (fun _ _ => sq_nonneg _)
  calc
    _ ≤ (3 * (24 * Real.pi * U) * (1 + 2 * (1 + Real.log N)) +
        (indices.card : ℝ) * (216 * Real.sqrt N)) * ∑ n ∈ Finset.Icc a b, ‖c n‖ ^ 2 :=
      logarithmic_sparse_unit_interval_suprema indices a b c N hU ha hb hleft hright hwidth
    _ ≤ (3 * (24 * Real.pi * U) * (1 + 2 * (1 + Real.log N)) + U) *
        ∑ n ∈ Finset.Icc a b, ‖c n‖ ^ 2 :=
      mul_le_mul_of_nonneg_right (add_le_add le_rfl hcard) hc0
    _ ≤ (3 * (24 * Real.pi * U) * (1 + 2 * (1 + Real.log N)) + U) * (V / U) :=
      mul_le_mul_of_nonneg_left henergy (by positivity)
    _ = _ := by field_simp; ring

end Bounty
end

section

/- Fixed positive power cancellation for logarithmic progressions at every large scale. -/

open Finset Filter

namespace Bounty

theorem eventually_uniform_affine_logarithmic_phase (K : ℕ) (C ε : ℝ)
    (hK : 2 ≤ K) (hC : 1 ≤ C) (hε : 0 < ε) (hεhalf : ε ≤ 1/2) :
    ∃ D : ℝ, 0 < D ∧ ∀ᶠ N : ℝ in atTop, ∀ (q c u : ℝ) (a b : ℤ),
      0 < q → u ≠ 0 → |u| ≤ N^((K : ℝ)-ε) →
      N ≤ (a : ℝ)+c/q → (b : ℝ)+1+c/q ≤ C*N →
      ‖∑ n ∈ Icc a b, Complex.exp (((u*Real.log (q*(n : ℝ)+c) : ℝ) : ℂ)*Complex.I)‖ ≤
        D*N*(1/|u|+N^(-(ε/((K : ℝ)*(2:ℝ)^(K-1))))) := by
  obtain ⟨D,hD,hbound⟩ := exists_uniform_affine_logarithmic_phase_bound K C hK hC
  have hKR : (0 : ℝ) < K := by exact_mod_cast (show 0 < K by omega)
  have hθ : 0 < ε/(2*(K : ℝ)) := by positivity
  refine ⟨D,hD,?_⟩
  filter_upwards [eventually_gt_atTop (1 : ℝ),eventually_ge_atTop ((K : ℝ)^2),
    (tendsto_rpow_atTop hθ).eventually (eventually_ge_atTop (2 : ℝ))]
    with N hN hKN hpow
  intro q c u a b hq hu huK ha hb
  exact hbound N ε q c u a b hN hε hεhalf hKN hpow hq hu huK ha hb

theorem eventually_long_affine_logarithmic_phase (τ C : ℝ) (hτ : 0 < τ) (hC : 1 ≤ C) :
    ∃ δ D : ℝ, 0 < δ ∧ 0 < D ∧ ∀ᶠ N : ℝ in atTop,
      ∀ (x q c u : ℝ) (a b : ℤ),
      1 ≤ x → x^(τ/2) ≤ N → 0 < q → u ≠ 0 → |u| ≤ x^2 →
      N ≤ (a : ℝ)+c/q → (b : ℝ)+1+c/q ≤ C*N →
      ‖∑ n ∈ Icc a b, Complex.exp (((u*Real.log (q*(n : ℝ)+c) : ℝ) : ℂ)*Complex.I)‖ ≤
        D*N*(1/|u|+N^(-δ)) := by
  let K := Nat.ceil (4/τ)+3
  have hK : 2 ≤ K := by dsimp [K]; omega
  have hKR : (0 : ℝ) < K := by exact_mod_cast (show 0 < K by omega)
  have hKτ : 4/τ+1 ≤ (K : ℝ) := by
    have hc := Nat.le_ceil (4/τ)
    dsimp [K]
    push_cast
    linarith
  obtain ⟨D,hD,hbound⟩ := eventually_uniform_affine_logarithmic_phase K C (1/10)
    hK hC (by norm_num) (by norm_num)
  refine ⟨(1/10)/((K : ℝ)*(2:ℝ)^(K-1)),D,by positivity,hD,?_⟩
  filter_upwards [hbound] with N hb
  intro x q c u a b hx hxN hq hu hux ha hb'
  apply hb q c u a b hq hu _ ha hb'
  exact hux.trans (long_frequency_upper_power K x N τ (1/10) hx hτ (by norm_num) hxN hKτ)

end Bounty
end

section

/- The actual allocation frequencies fit one fixed polynomial shift window. -/

open Finset Filter

namespace Bounty

theorem eventually_candidate_allocation_reciprocal_scale_bound {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ r : ℕ,
      (∑ i : Fin ((candidateQIndices c L).card*r),
        1/(c*L/2^(candidateAllocationOrder c L r i).1.val)) ≤
          (1/Real.log 2+1)*(r : ℝ)/20 := by
  filter_upwards [eventually_candidateQIndices_parameters hc,
    eventually_candidateQIndices_geometry hc] with L hpar hgeom
  intro r
  have hden : 0 < 20*Real.log L := by linarith [hpar.2.1]
  have hlogne : Real.log L ≠ 0 := by linarith [hpar.2.1]
  calc
    _ ≤ ∑ _i : Fin ((candidateQIndices c L).card*r), 1/(20*Real.log L) := by
      apply sum_le_sum
      intro i _
      exact one_div_le_one_div_of_le hden (hgeom.2 _ (candidateAllocationOrder c L r i).1.property).1
    _ = (((candidateQIndices c L).card : ℝ)*(r : ℝ))/(20*Real.log L) := by
      simp only [sum_const, card_univ, Fintype.card_fin, nsmul_eq_mul, Nat.cast_mul]
      ring
    _ ≤ (((1/Real.log 2+1)*Real.log L)*(r : ℝ))/(20*Real.log L) := by
      exact div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right hgeom.1 (Nat.cast_nonneg r)) hden.le
    _ = _ := by field_simp [hlogne]

theorem eventually_candidate_allocation_frequency_power_bound {c : ℝ}
    (hc : 0 < c) (r : ℕ) (F : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (jStar : ℕ)
      (take : Fin ((candidateQIndices c L).card*r) → Bool)
      (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ),
      (∀ i, |ξ i| ≤ L^F) →
      ∀ slot : (candidateQIndices c L) × Fin r,
        |orderedSlotFrequency (fun i => if take i then 1 else 0)
          (activeAllocationFrequencyInput (candidateAllocationActive c L r jStar)
            (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val) ξ)
          ((candidateAllocationOrder c L r).symm slot)| ≤ L^(F+1) := by
  filter_upwards [eventually_candidate_allocation_reciprocal_scale_bound hc,
    eventually_ge_atTop (1 : ℝ),
    eventually_ge_atTop (2*Real.pi*((1/Real.log 2+1)*(r : ℝ)/20))] with L hrec hL hlarge
  intro jStar take ξ hξ slot
  have hLpos : 0 < L := zero_lt_one.trans_le hL
  have hs : ∀ i : Fin ((candidateQIndices c L).card*r),
      0 < c*L/2^(candidateAllocationOrder c L r i).1.val := by intro i; positivity
  have hh := active_allocation_frequency_bound (candidateAllocationActive c L r jStar)
    take (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val) hs ξ
    (Real.rpow_nonneg hLpos.le F) hξ ((candidateAllocationOrder c L r).symm slot)
  calc
    _ ≤ (2*Real.pi*L^F)*(∑ i : Fin ((candidateQIndices c L).card*r),
        1/(c*L/2^(candidateAllocationOrder c L r i).1.val)) := hh
    _ ≤ (2*Real.pi*L^F)*((1/Real.log 2+1)*(r : ℝ)/20) :=
      mul_le_mul_of_nonneg_left (hrec r) (by positivity)
    _ = (2*Real.pi*((1/Real.log 2+1)*(r : ℝ)/20))*L^F := by ring
    _ ≤ L*L^F := mul_le_mul_of_nonneg_right hlarge (Real.rpow_nonneg hLpos.le F)
    _ = _ := by rw [Real.rpow_add hLpos, Real.rpow_one]; ring

theorem candidate_allocation_twist_mellin_shift (c L : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ)
    (slot : (candidateQIndices c L) × Fin r) (u : ℝ) {n : ℕ} (hn : 0 < n) :
    harmonicMellinWeight u n*candidateAllocationFourierTwist c L r jStar take ξ slot n =
      harmonicMellinWeight
        (u+orderedSlotFrequency (fun i => if take i then 1 else 0)
          (activeAllocationFrequencyInput (candidateAllocationActive c L r jStar)
            (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val) ξ)
          ((candidateAllocationOrder c L r).symm slot)) n := by
  unfold candidateAllocationFourierTwist
  exact harmonic_mellin_weight_cpow_shift u _ (Nat.cast_pos.mpr hn)

end Bounty
end

section

/- The actual residual coefficient has the polynomial bound required by the literal integral. -/

open Finset

namespace Bounty

theorem candidate_marked_residual_coefficient_norm {G : Type*}
    (groups : Finset G) (P : G → Finset ℕ) {q v L K c : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (hL : 0 < L) (hcL : 0 ≤ c*L)
    (V : G → ℝ) (t : G → ℕ) (T : ℕ)
    (hV : ∀ g ∈ groups, v ≤ V g) (ht : ∀ g ∈ groups, t g ≤ T)
    (hcard : (groups.card : ℝ) ≤ K*Real.log L)
    {r jStar : ℕ} (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm (candidateRoughSlot c L r jStar hr hj)) = false)
    (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ)
    (Q : Finset ℕ) (θ : ℕ → ℂ) (hθ : ∀ n, ‖θ n‖ ≤ 1) (n : ℕ) :
    ‖(markedDivisorWeight groups P q V t (n : ℤ) : ℂ)*
        candidateResidualPrimeCoefficient c L r jStar hr hj take hkeep
          (candidateAllocationFourierTwist c L r jStar take ξ) (primePoolFreePart Q n)*θ n‖ ≤
      L^(K*Real.log (markedDivisorBound q v T)) := by
  have hmark : ‖(markedDivisorWeight groups P q V t (n : ℤ) : ℂ)‖ ≤
      L^(K*Real.log (markedDivisorBound q v T)) := by
    rw [Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg
      (marked_divisor_weight_nonneg groups P hq0 V t (fun g hg => hv.le.trans (hV g hg)) _)]
    exact marked_divisor_weight_le_rpow groups P hq0 hq1 hv hL V t T hV ht hcard _
  have hres := norm_candidate_residual_prime_coefficient_le_one hcL hr hj take hkeep
    (candidateAllocationFourierTwist c L r jStar take ξ) (by
      intro slot p hp
      exact (candidate_allocation_fourier_twist_norm c L r jStar take ξ slot
        (Nat.pos_of_ne_zero (candidate_Q_slot_nonzero c L r jStar slot hp))).le)
    (primePoolFreePart Q n)
  rw [norm_mul,norm_mul]
  calc
    _ ≤ (L^(K*Real.log (markedDivisorBound q v T))*1)*1 :=
      mul_le_mul (mul_le_mul hmark hres (norm_nonneg _) (Real.rpow_nonneg hL.le _))
        (hθ n) (norm_nonneg _) (by positivity)
    _ = _ := by ring

end Bounty
end

section

/- The residual coefficient in the selected original candidate endpoint. -/

open Finset Filter
open scoped ComplexConjugate

namespace Bounty

noncomputable def candidateSelectedResidualCoefficient
    (c L q : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm
      (candidateRoughSlot c L r jStar hr hj)) = false)
    (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ)
    (t u : candidatePIndices c L → ℕ) (big : Finset (candidatePIndices c L))
    (b : GroupMarkedLists (fun g : big => candidatePBand (c*L) g.val.val)
      (fun g : big => u g.val) → ℂ) (κ θ : ℕ → ℂ) (n : ℕ) : ℂ :=
  selectedMarkedWeight (fun g : candidatePIndices c L => candidatePBand (c*L) g.val)
    ((candidatePIndices c L).biUnion (candidatePBand (c*L))) q
    (fun g => ∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ)) t u big b κ n *
    conj (candidateResidualPrimeCoefficient c L r jStar hr hj take hkeep
      (candidateAllocationFourierTwist c L r jStar take ξ)
      (primePoolFreePart ((candidatePIndices c L).biUnion (candidatePBand (c*L))) n)) * θ n

theorem exists_candidate_selected_residual_power_bound {c q : ℝ}
    (hc : 0 < c) (hq0 : 0 ≤ q) (hq1 : q < 1) (T : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ L : ℝ in atTop, ∀ B : ℝ,
      ∀ (r jStar : ℕ) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
      (take : Fin ((candidateQIndices c L).card*r) → Bool)
      (hkeep : take ((candidateAllocationOrder c L r).symm
        (candidateRoughSlot c L r jStar hr hj)) = false)
      (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ)
      (t u : candidatePIndices c L → ℕ) (big : Finset (candidatePIndices c L))
      (b : GroupMarkedLists (fun g : big => candidatePBand (c*L) g.val.val)
        (fun g : big => u g.val) → ℂ) (κ θ : ℕ → ℂ),
      (∀ g, t g ≤ T) → (∀ l, ‖b l‖ ≤ L^B) →
      (∀ d, ‖κ d‖ ≤ 1) → (∀ n, ‖θ n‖ ≤ 1) → ∀ n : ℕ,
      ‖candidateSelectedResidualCoefficient c L q r jStar hr hj take hkeep ξ
        t u big b κ θ n‖ ≤ L^(C+B) := by
  obtain ⟨v,V,hv,_,hpool⟩ := exists_candidate_P_pool_bounds hc
  refine ⟨(2/(5*Real.log 2))*Real.log (markedDivisorBound q v T),
    mul_nonneg (by positivity) (Real.log_nonneg (one_le_markedDivisorBound q v T)), ?_⟩
  filter_upwards [hpool] with L hp
  rcases hp with ⟨hL,_,_,hcard,_,hdata⟩
  have hLpos : 0 < L := zero_lt_one.trans_le hL
  intro B r jStar hr hj take hkeep ξ t u big b κ θ ht hb hκ hθ n
  have hw := selected_marked_weight_norm_le_rpow
    (fun g : candidatePIndices c L => candidatePBand (c*L) g.val)
    ((candidatePIndices c L).biUnion (candidatePBand (c*L))) hq0 hq1 hv hLpos
    (fun g => ∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ)) t u T big
    (fun g => (hdata g.val g.property).1) ht (by simpa using hcard) b hb κ hκ n
  have hr' := norm_candidate_residual_prime_coefficient_le_one
    (mul_nonneg hc.le hLpos.le) hr hj take hkeep
    (candidateAllocationFourierTwist c L r jStar take ξ) (by
      intro slot p hp
      exact (candidate_allocation_fourier_twist_norm c L r jStar take ξ slot
        (Nat.pos_of_ne_zero (candidate_Q_slot_nonzero c L r jStar slot hp))).le)
    (primePoolFreePart ((candidatePIndices c L).biUnion (candidatePBand (c*L))) n)
  rw [candidateSelectedResidualCoefficient,norm_mul,norm_mul,Complex.norm_conj]
  calc
    _ ≤ (L^((2/(5*Real.log 2))*Real.log (markedDivisorBound q v T)+B)*1)*1 :=
      mul_le_mul (mul_le_mul hw hr' (norm_nonneg _) (Real.rpow_nonneg hLpos.le _))
        (hθ n) (norm_nonneg _) (by positivity)
    _ = _ := by ring

end Bounty
end

section

/- Exact conditional marked-list averages for both stripped endpoints. -/

open Finset
open scoped Classical
namespace Bounty

theorem group_marked_average_mul_left {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (t : G → ℕ) (n : ℤ)
    (c : ℂ) (b : GroupMarkedLists P t → ℂ) :
    groupMarkedAverage P t n (fun L => c * b L) =
      c * groupMarkedAverage P t n b := by
  unfold groupMarkedAverage
  rw [← mul_sum]
  ring

theorem completion_marked_pair_sum_eq_average {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {J ell : ℕ} (C : G → Finset (Fin J))
    (q : ℝ) (V : G → ℝ) (w z : ℤ)
    (b : GroupMarkedLists P (fun g => ell + (C g).card) →
      GroupMarkedLists P (fun g => ell + (C g).card) → ℂ) :
    (physicalCompletionMass V C ell : ℂ) ^ 2 *
      (∑ u : GroupMarkedLists P (fun g => ell + (C g).card),
      ∑ v : GroupMarkedLists P (fun g => ell + (C g).card),
        (groupMarkedVertexWeight P q (fun g => ell + (C g).card) w u : ℂ) *
        (groupMarkedVertexWeight P q (fun g => ell + (C g).card) z v : ℂ) * b u v) =
      (markedDivisorWeight univ P q V (fun g => ell + (C g).card) w : ℂ) *
      (markedDivisorWeight univ P q V (fun g => ell + (C g).card) z : ℂ) *
      groupMarkedAverage P (fun g => ell + (C g).card) w
        (fun u => groupMarkedAverage P (fun g => ell + (C g).card) z (b u)) := by
  calc
    _ = (physicalCompletionMass V C ell : ℂ) *
        ∑ u : GroupMarkedLists P (fun g => ell + (C g).card),
          (groupMarkedVertexWeight P q (fun g => ell + (C g).card) w u : ℂ) *
          ((physicalCompletionMass V C ell : ℂ) *
            ∑ v : GroupMarkedLists P (fun g => ell + (C g).card),
              (groupMarkedVertexWeight P q (fun g => ell + (C g).card) z v : ℂ) * b u v) := by
      simp only [mul_sum]
      apply sum_congr rfl
      intro u _
      apply sum_congr rfl
      intro v _
      ring
    _ = (physicalCompletionMass V C ell : ℂ) *
        ∑ u : GroupMarkedLists P (fun g => ell + (C g).card),
          (groupMarkedVertexWeight P q (fun g => ell + (C g).card) w u : ℂ) *
          ((markedDivisorWeight univ P q V (fun g => ell + (C g).card) z : ℂ) *
            groupMarkedAverage P (fun g => ell + (C g).card) z (b u)) := by
      simp only [completion_marked_vertex_sum_eq_average]
    _ = _ := by
      rw [completion_marked_vertex_sum_eq_average, group_marked_average_mul_left]
      ring

end Bounty
end

section

/- The original compatible-completion restriction and auxiliary ban use the
same quantitative shared-draw exclusion estimate on the actual divisor fibers. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_cut_shared_constant_error {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (hprime : ∀ g p, p ∈ P g → p.Prime) (V : G → ℝ)
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (u v : GroupMarkedLists P (fun g => ell + (C g).card))
    (aux : PhysicalAuxLabels P C) {w z : ℕ} (hw : 0 < w) (hz : 0 < z)
    (hu : ∀ g i, (u g i).val ∣ w) (hv : ∀ g i, (v g i).val ∣ z)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (c : ℂ) :
    ‖(∑ s : PhysicalAuxLabels P (fun g => univ \ C g),
      if physicalRawCutGood C u v s then
        if ∀ g j, s g j ∉ physicalSharedForbidden C aux g w z
          then (physicalAuxMass V (fun g => univ \ C g) s : ℂ) * c else 0
      else 0) - c‖ ≤
      (∑ g, (J - (C g).card : ℕ) *
        (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) / (V g * Pmin)) * ‖c‖ := by
  rw [physical_cut_avoiding_mean_eq_shared_good_mean C hprime u v aux hw hz hu hv]
  exact physical_shared_scalar_removal_error V C hV hMass aux hw hz hPmin hp c

theorem group_marked_average_sub {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (t : G → ℕ) (n : ℤ) (a b : GroupMarkedLists P t → ℂ) :
    groupMarkedAverage P t n (fun L => a L - b L) =
      groupMarkedAverage P t n a - groupMarkedAverage P t n b := by
  unfold groupMarkedAverage
  rw [sum_sub_distrib, mul_sub]

theorem group_marked_pair_average_norm_le {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (t : G → ℕ) (w z : ℤ)
    (b : GroupMarkedLists P t → GroupMarkedLists P t → ℂ)
    {H : ℝ} (hH : 0 ≤ H)
    (hb : ∀ (u : GroupMarkedListsAt P t w) (v : GroupMarkedListsAt P t z),
      ‖b u.val v.val‖ ≤ H) :
    ‖groupMarkedAverage P t w (fun u => groupMarkedAverage P t z (b u))‖ ≤ H := by
  apply group_marked_average_norm_le P t w _ hH
  intro u
  exact group_marked_average_norm_le P t z (b u.val) hH (hb u)

end Bounty
