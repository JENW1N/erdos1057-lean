theorem polynomial_dirichlet_dichotomy (α L q U V : ℝ)
    (hL : 1 ≤ L) (hq : 0 ≤ q) (hU : L ^ q ≤ U) (hV : L ^ q ≤ V) :
    ∃ (u : ℤ) (r : ℕ) (β : ℝ), 0 < r ∧ (r : ℤ).gcd u = 1 ∧
      α = (u : ℝ) / r + β ∧ |β| ≤ 1 / (r : ℝ) ^ 2 ∧
      |β| * (U * V) ≤ L ^ q ∧ (r : ℝ) / (U * V) ≤ L ^ (-q) ∧
      (r ≤ ⌊L ^ q⌋₊ ∨ L ^ q < (r : ℝ)) := by
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL
  have hp : 0 < L ^ q := Real.rpow_pos_of_pos hL0 q
  have hp1 : 1 ≤ L ^ q := Real.one_le_rpow hL hq
  have hU0 : 0 < U := hp.trans_le hU
  have hV1 : 1 ≤ V := hp1.trans hV
  have hV0 : 0 < V := lt_of_lt_of_le zero_lt_one hV1
  have hprod : L ^ q ≤ U * V := hU.trans (le_mul_of_one_le_right hU0.le hV1)
  obtain ⟨u, r, β, hr, hrb, hcop, heq, hβ, hscale⟩ :=
    dirichlet_scaled_decomposition α (U * V) (L ^ q) (mul_pos hU0 hV0) hp
      ((one_le_div hp).mpr hprod)
  have hr1 : (1 : ℝ) ≤ r := by exact_mod_cast hr
  refine ⟨u, r, β, hr, hcop, heq, hβ, hscale.trans ?_, ?_, ?_⟩
  · exact div_le_self hp.le hr1
  · rw [Real.rpow_neg hL0.le, ← one_div]
    apply (div_le_iff₀ (mul_pos hU0 hV0)).mpr
    calc
      (r : ℝ) ≤ U * V / L ^ q := hrb
      _ = 1 / L ^ q * (U * V) := by ring
  · by_cases h : r ≤ ⌊L ^ q⌋₊
    · exact Or.inl h
    · exact Or.inr ((Nat.floor_lt hp.le).mp (Nat.lt_of_not_ge h))

theorem minor_arc_factor_absorption {L H B : ℝ}
    (hL : 33 ≤ L) (hH : H ≤ L ^ (-2 * B - 2)) :
    33 * Real.sqrt H ≤ L ^ (-B) := by
  have hL0 : 0 < L := by linarith
  have hs : Real.sqrt H ≤ L ^ (-B - 1) := by
    apply (Real.sqrt_le_left (by positivity)).mpr
    calc
      H ≤ L ^ (-2 * B - 2) := hH
      _ = (L ^ (-B - 1)) ^ 2 := by
        rw [show -2 * B - 2 = (-B - 1) + (-B - 1) by ring, Real.rpow_add hL0]
        ring
  calc
    _ ≤ L * L ^ (-B - 1) := mul_le_mul hL hs (Real.sqrt_nonneg _) (by positivity)
    _ = L ^ (-B) := by
      calc
        _ = L ^ (1 + (-B - 1)) := by rw [Real.rpow_add hL0, Real.rpow_one]
        _ = _ := by congr 1; ring
end

section
open Filter
theorem prime_kernel_gram_error_le {C V a ξ : ℝ} {Q : ℕ}
    (hC : 0 ≤ C) (hV : 0 ≤ V) (ha : 2 ≤ a) (hξ : 0 ≤ ξ) (hQ : 0 < Q) :
    (Q * Q - 1 : ℕ) * (((C / V) * a ^ (-(1 : ℝ) / 32) *
      (1 + Real.log (Q * Q : ℕ) / Real.log a)) / ξ) ≤ primeKernelError C Q V a ξ := by
  have hlog : 0 < Real.log a := Real.log_pos (by linarith)
  have hq : (1 : ℝ) ≤ (Q * Q : ℕ) := by exact_mod_cast Nat.mul_pos hQ hQ
  have hlogq := Real.log_nonneg hq
  unfold primeKernelError
  apply mul_le_mul_of_nonneg_right
  · exact_mod_cast Nat.sub_le (Q * Q) 1
  · positivity

theorem prime_kernel_error_mono_constant {C C' V a ξ : ℝ} {Q : ℕ}
    (hCC : C ≤ C') (hV : 0 ≤ V) (ha : 2 ≤ a) (hξ : 0 ≤ ξ) (hQ : 0 < Q) :
    primeKernelError C Q V a ξ ≤ primeKernelError C' Q V a ξ := by
  have hlog : 0 < Real.log a := Real.log_pos (by linarith)
  have hq : (1 : ℝ) ≤ (Q * Q : ℕ) := by exact_mod_cast Nat.mul_pos hQ hQ
  have hlogq := Real.log_nonneg hq
  unfold primeKernelError
  gcongr

theorem eventually_prime_kernel_error_and_energy_small (c C q v x D : ℝ)
    (hc : 0 < c) (hC : 0 < C) (hD : 0 ≤ D) :
    ∀ᶠ L : ℝ in atTop, ∀ (Q : ℕ) (V ξ a : ℝ), 0 < Q →
      (Q : ℝ) ≤ L ^ q → L ^ (-v) ≤ V → L ^ (-x) ≤ ξ → Real.exp (L ^ c) ≤ a →
      primeKernelError C Q V a ξ ≤ L ^ (-D) ∧
      (Q * Q - 1 : ℕ) * (((C / V) * a ^ (-(1 : ℝ) / 32) *
        (1 + Real.log (Q * Q : ℕ) / Real.log a)) / ξ) ≤ 1 := by
  filter_upwards [eventually_prime_kernel_reproduction_error_small c C q v x D hc hC,
    eventually_ge_atTop (1 : ℝ)] with L herror hL
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL
  intro Q V ξ a hQ hQb hV hξ ha
  have herr : primeKernelError C Q V a ξ ≤ L ^ (-D) := herror Q V ξ a hQ hQb hV hξ ha
  have ha2 : 2 ≤ a := by
    calc
      2 ≤ Real.exp 1 := by linarith [Real.add_one_le_exp (1 : ℝ)]
      _ ≤ Real.exp (L ^ c) := Real.exp_le_exp.mpr (Real.one_le_rpow hL hc.le)
      _ ≤ a := ha
  refine ⟨herr, (prime_kernel_gram_error_le hC.le ?_ ha2 ?_ hQ).trans (herr.trans ?_)⟩
  · exact (Real.rpow_pos_of_pos hL0 (-v)).le.trans hV
  · exact (Real.rpow_pos_of_pos hL0 (-x)).le.trans hξ
  · simpa only [Real.rpow_zero] using Real.rpow_le_rpow_of_exponent_le hL (show -D ≤ 0 by linarith)
end

section
open Finset Classical
noncomputable def fullDoubledGhostStepEnergy {J K : Type*}
    (ρ v vmin vmax : ℝ) (T groups : ℕ) : Option (J ⊕ K) → ℝ
  | none => 1
  | some (Sum.inl _) => physicalGhostUniformEnergyBound ρ (2 * vmax) v ^ groups
  | some (Sum.inr _) => unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ groups

section

variable {J K G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  {M : G → ℕ} (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
  (Δ D : ∀ k c, A k c → G → ℤ) (ω : ∀ k c, A k c → ℝ)
  (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)

noncomputable def fullDoubledGhostPathAction (steps : List (Option (J ⊕ K)))
    (phase : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → ℂ)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ) :=
  let _ : ∀ (k : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D k s) := fullPermutationMixedEventFintype n S B A Δ D
  finiteEventPathAction (FullPermutationMixedEvent n S B A Δ D) (fullPermutationMixedEventTarget n S B A Δ D)
    (fullDoubledGhostEventWeight n S B A Δ D ω μ q ρ V) steps phase f

theorem full_doubled_ghost_path_norm_le_positive_list
    (hω : ∀ k c a, 0 ≤ ω k c a)
    (hμ : ∀ g p, 0 ≤ μ g p) (hq : ∀ j, 0 ≤ q j) (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ V g)
    (steps : List (Option (J ⊕ K))) (phase : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    ‖fullDoubledGhostPathAction n S B A Δ D ω μ q ρ V steps phase f s‖ ≤
      (finiteOperatorListAction (fullDoubledGhostPositiveOperator n S B A Δ D ω μ q ρ V)
        steps (complexNormEnvelope f) s).re := by
  let _ : ∀ (k : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D k s) := fullPermutationMixedEventFintype n S B A Δ D
  have h := finite_event_path_norm_le_abs_list_re (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) (fullDoubledGhostEventWeight n S B A Δ D ω μ q ρ V)
    steps phase hphase f s
  rw [full_doubled_ghost_absolute_actions_eq n S B A Δ D ω μ q ρ V hω hμ hq hρ hV] at h
  exact h

theorem full_doubled_ghost_path_energy_le
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 < μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (hC : ∀ j g, q j / ρ ^ 2 + ((1 - q j) * (2 * V g) / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (steps : List (Option (J ⊕ K))) (phase : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fullDoubledGhostPathAction n S B A Δ D ω μ q ρ V steps phase f) ≤
    (steps.map (fullDoubledGhostStepEnergy ρ v vmin vmax T (Fintype.card G))).prod *
      finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  have hμ0 : ∀ g p, 0 ≤ μ g p := fun g p => (hμ g p).le
  have hV0 : ∀ g, 0 ≤ V g := fun g => (hvmin.trans_le (hVlo g)).le
  apply finiteWeightedEnergy_le_of_envelope_domination
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productMemoryWeight_nonneg μ (fun g => unrestrictedResidueWeight (μ g)) hμ0
      (fun g z => hμ0 g z.1)) f _
    (finiteOperatorListAction (fullDoubledGhostPositiveOperator n S B A Δ D ω μ q ρ V) steps)
  · intro s
    exact (full_doubled_ghost_path_norm_le_positive_list n S B A Δ D ω μ q ρ V hω hμ0 hq0 hρ0.le hV0
      steps phase hphase f s).trans (Complex.re_le_norm _)
  · apply finite_operator_list_energy_le _ ProductMemorySymmetric
      (fullDoubledGhostPositiveOperator n S B A Δ D ω μ q ρ V)
      (full_doubled_ghost_positive_symmetric n S B A Δ D ω μ q ρ V)
      (fullDoubledGhostStepEnergy ρ v vmin vmax T (Fintype.card G))
    · intro k
      cases k with
      | none => exact zero_le_one
      | some k =>
        cases k with
        | inl j => exact pow_nonneg (Real.exp_pos _).le _
        | inr k => exact pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _
    · intro k F hF
      cases k with
      | none =>
        simpa only [fullDoubledGhostPositiveOperator, fullPermutationMixedPositiveOperator,
          fullDoubledGhostStepEnergy, one_mul] using
          fullActiveAverage_energy_le μ (fun g => unrestrictedResidueWeight (μ g)) hμ0
            (fun g z => hμ0 g z.1) F
      | some k =>
        cases k with
        | inl j =>
          have hVfun : fullDoubledGhostV V (some (Sum.inl j) : Option (J ⊕ K)) =
              fun g => 2 * V g := by
            funext g
            rfl
          simpa only [fullDoubledGhostPositiveOperator, fullPermutationMixedPositiveOperator,
            fullMixedMemoryPositiveOperator, hVfun, fullDoubledGhostStepEnergy, card_univ] using
            physical_ghost_absolute_cutoff_product_energy_le n μ (q j) ρ (fun g => 2 * V g) v (2 * vmax) M B
              hμ hmass (hq0 j) (hq1 j) hρ0
              (fun g => mul_nonneg (by norm_num) (hV0 g))
              (fun g => mul_le_mul_of_nonneg_left (hVhi g) (by norm_num)) (zero_lt_one.trans hv)
              (hD j) (hC j) univ F hF
        | inr k =>
          exact full_active_unrestricted_edge_energy_le n (S k) B (ω k) (Δ k) (D k) μ ρ V
            (hω k) (hωmass k) hρ0 hρ1 hv hvmin hVlo hVhi hμ0 hmass T (ht k)
            (fun _ _ _ _ => 1) (by intros; simp) F hF
    · exact complexNormEnvelope_memory_symmetric f hf

theorem full_doubled_ghost_path_mask_energy_le
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 < μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (hC : ∀ j g, q j / ρ ^ 2 + ((1 - q j) * (2 * V g) / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (steps : List (Option (J ⊕ K)))
    (allowed : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → Prop)
    (phase : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fullDoubledGhostPathAction n S B A Δ D ω μ q ρ V steps
        (fun s p => if allowed s p then phase s p else 0) f) ≤
    (steps.map (fullDoubledGhostStepEnergy ρ v vmin vmax T (Fintype.card G))).prod *
      finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  apply full_doubled_ghost_path_energy_le n S B A Δ D ω μ q ρ V hω hωmass hρ0 hρ1 hv hvmin hVlo hVhi
    hμ hmass hq0 hq1 hD hC T ht steps _ _ f hf
  intro s p
  split_ifs
  · exact hphase s p
  · simp

end
