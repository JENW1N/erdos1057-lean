  have he : globalBirthJointHistoryKernel a steps cap =
      finiteInputMaskedKernel (fun i z => globalBirthJointPending z ≤ cap i)
        (fun i => globalBirthJointKernel (steps i) (cap (i + 1))) := by
    funext i z w
    unfold globalBirthJointHistoryKernel globalBirthJointCutKernel finiteInputMaskedKernel
    split_ifs <;> rfl
