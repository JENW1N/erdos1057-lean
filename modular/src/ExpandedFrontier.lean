variable {J K G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  {M : G → ℕ} (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
  (Δ D : ∀ k c, A k c → G → ℤ) (ω : ∀ k c, A k c → ℝ)
  (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)


theorem full_ghost_birth_tail_energy_le
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 < μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (hC : ∀ j g, q j / ρ ^ 2 + ((1 - q j) * (2 * V g) / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (steps : List (Option (J ⊕ K)))
    (r : ℕ)
    (allowed : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → Prop)
    (phase : ∀ s, FullPermutationMixedPath n S B A Δ D steps s → ℂ)
    (hphase : ∀ s p, ‖phase s p‖ ≤ 1)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps
        (fun s p => if r ≤ fullGhostPathBirthCount n S B A Δ D steps s p then
          (if allowed s p then phase s p else 0) else 0) f) ≤
    ((2 : ℝ) ^ r)⁻¹ ^ 2 *
      (steps.map (fullDoubledGhostStepEnergy ρ v vmin vmax T (Fintype.card G))).prod *
      finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  let _ : ∀ (k : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D k s) :=
    fullPermutationMixedEventFintype n S B A Δ D
  let ψ := fun s p => if allowed s p then phase s p else 0
  let χ := fun s p => countTailPhase 2 r (fullGhostPathBirthCount n S B A Δ D steps s p) (ψ s p)
  have hχ : ∀ s p, ‖χ s p‖ ≤ 1 := by
    intro s p
    apply countTailPhase_norm_le_one (by norm_num)
    dsimp only [ψ]
    split_ifs
    · exact hphase s p
    · simp
  have heq : fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps
        (fun s p => if r ≤ fullGhostPathBirthCount n S B A Δ D steps s p then ψ s p else 0) f =
      fun s => ((((2 : ℝ) ^ r)⁻¹ : ℝ) : ℂ) *
        fullDoubledGhostPathAction n S B A Δ D ω μ q ρ V steps χ f s := by
    funext s
    exact finite_event_path_counted_tail_eq
      (FullPermutationMixedEvent n S B A Δ D) (fullPermutationMixedEventTarget n S B A Δ D)
      (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V)
      (fullDoubledGhostEventWeight n S B A Δ D ω μ q ρ V) steps
      (fullGhostPathBirthCount n S B A Δ D steps) (by norm_num : (0 : ℝ) < 2)
      (full_doubled_ghost_path_weight_eq n S B A Δ D ω μ q ρ V steps) r ψ f s
  have he := full_doubled_ghost_path_energy_le n S B A Δ D ω μ q ρ V
    hω hωmass hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass hq0 hq1 hD hC T ht steps χ hχ f hf
  change finiteWeightedEnergy _
    (fullPermutationMixedPathAction n S B A Δ D ω μ q ρ V steps
      (fun s p => if r ≤ fullGhostPathBirthCount n S B A Δ D steps s p then ψ s p else 0) f) ≤ _
  rw [heq, finiteWeightedEnergy_const_mul]
  have hc : ‖((((2 : ℝ) ^ r)⁻¹ : ℝ) : ℂ)‖ = ((2 : ℝ) ^ r)⁻¹ := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by positivity)]
  rw [hc, mul_assoc]
  exact mul_le_mul_of_nonneg_left he (sq_nonneg _)

end
