noncomputable def physicalGroupFiniteVertexWeight
    {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    {patterns : Finset I} (groups : Finset (Fin N))
    (C : I → Fin N → Finset (Fin J)) (q : ℝ) (k : ℕ → I → ℤ)
    (L : PhysicalMarkLists P J ell)
    (p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)
    (r : PhysicalGroupResidues P groups) : ℝ :=
  ∏ j ∈ range (n + 2), physicalResidueVertexWeight
    (fun g : ↥groups => finitePathMarks L p j g.val)
    (physicalEndpointSchedule q (n + 1) j)
    (physicalTranslateResidues (physicalGroupResidueVector r)
      (physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p) (n + 1) j))

noncomputable def physicalGroupFiniteCappedHistory
    {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    [∀ a : PhysicalPrime P, NeZero a.2.val]
    {patterns : Finset I} (groups : Finset (Fin N))
    (C : I → Fin N → Finset (Fin J)) (q : ℝ) (k : ℕ → I → ℤ)
    (β : PhysicalPrime P → ℝ) (V : Fin N → ℝ) (B : ℕ)
    (L : PhysicalMarkLists P J ell)
    (p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) : ℝ :=
  ghostPhaseCappedHistory
    (fun a : ↥(physicalPrimeGroups P groups) => fun j => globalBirthFiniteActivity
      (physicalGroupBareFiniteActivity (physicalPathSelectedEquiv patterns C (L, p)).2.2.1 a.val.1) j a.val.2)
    (fun a => physicalResidueAbsoluteHit (physicalPathSelectedOffset C k L p) a.val.1 a.val.2)
    (fun _ j => 1 - physicalEndpointSchedule q (n + 1) (globalBirthFiniteIndex (n + 1) j).val)
    (fun a => β a.val) (fun a => V a.val.1) (fun _ => B) (fun _ => B) (n + 1)

end Bounty
