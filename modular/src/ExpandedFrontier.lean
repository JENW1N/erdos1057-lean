    (fun j _ aux => physicalAuxMass (fun g => V (e.symm g).val) (Cn j) aux) β retention ρ (fun g => V (e.symm g).val) cut
    (physicalRootNumberedCompleteWeight groups e patterns C hC V q ζ k K r θ pl) f x =
  physicalRootEffectivePathSum groups e patterns C hC k pl V q ζ K r θ β retention ρ f x := by
  let _ : ∀ g (z : P (e.symm g).val), NeZero z.val :=
    fun g z => inferInstanceAs (NeZero (⟨(e.symm g).val, z⟩ : PhysicalPrime P).2.val)
  let Cn := fun j g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val (e.symm g).val
  let kn := physicalRootPlanMultiplier groups patterns C hC k pl
  let _ := fullPermutationMixedEventFintype (J := Fin (n + 2))
    (fun g (p : P (e.symm g).val) => p.val)
    (fun j g => physicalFullSharedIndices (ell := ell) (Cn j g)) B
    (fun j _ => PhysicalAuxLabels (fun g => P (e.symm g).val) (Cn j))
    (fun j => physicalFullEdgeDelta (Cn j) (kn j)) (fun j => physicalFullEdgeD (Cn j))
  let _ := finiteEventPathFintype (FullPermutationMixedEvent (fun g (p : P (e.symm g).val) => p.val)
      (fun j g => physicalFullSharedIndices (ell := ell) (Cn j g)) B
      (fun j _ => PhysicalAuxLabels (fun g => P (e.symm g).val) (Cn j))
      (fun j => physicalFullEdgeDelta (Cn j) (kn j)) (fun j => physicalFullEdgeD (Cn j))) (fullPermutationMixedEventTarget (fun g (p : P (e.symm g).val) => p.val)
      (fun j g => physicalFullSharedIndices (ell := ell) (Cn j g)) B
      (fun j _ => PhysicalAuxLabels (fun g => P (e.symm g).val) (Cn j))
      (fun j => physicalFullEdgeDelta (Cn j) (kn j)) (fun j => physicalFullEdgeD (Cn j))) ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1))) x
  let _ : Fintype (PhysicalEffectivePlannedBigPath (fun (i : patterns) g => C i.val (e.symm g).val) (fun (j : Fin (n + 1)) (i : patterns) => k (n - j.val) i.val) B ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1))) pl.1 pl.2 x) :=
    Fintype.ofEquiv (FullPermutationMixedPath (fun g (p : P (e.symm g).val) => p.val)
      (fun j g => physicalFullSharedIndices (ell := ell) (Cn j g)) B
      (fun j _ => PhysicalAuxLabels (fun g => P (e.symm g).val) (Cn j))
      (fun j => physicalFullEdgeDelta (Cn j) (kn j)) (fun j => physicalFullEdgeD (Cn j))
      ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1))) x)
      (physicalRootSelectedEffectivePathEquiv groups e patterns C hC k pl x)
  unfold physicalOriginalWeightedMoment physicalRootEffectivePathSum
  dsimp only
  refine Eq.trans ?_ ((physicalRootSelectedEffectivePathEquiv groups e patterns C hC k pl x).sum_comp
    (physicalRootEffectiveIntegrand groups e patterns C hC k pl V q ζ K r θ β retention ρ f x))
  apply Finset.sum_congr rfl
  intro path _
  exact physical_root_effective_integrand groups e patterns C hC k pl V q ζ K r θ β retention ρ
    hq cut hencode f x hx path

end Sum
end Bounty
