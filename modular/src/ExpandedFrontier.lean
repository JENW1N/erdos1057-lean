section

/- The allocation gap is chosen after every pre-Cauchy coefficient exponent. -/

open Real

namespace Bounty

theorem typeII_diagonal_scalar_saving {L K U V aE aN aM aH D : ℝ}
    (hL : 2 ≤ L) (hK : 2*aE+2*aN+2*aM+2*aH+17+D ≤ K) :
    (2*(U*L^(-K))*V*(L^aE)^2*(L^aN)^2) *
      ((L^aM)^2*(L^aH)^2*((U*V)*L^(16 : ℝ))) ≤ (U*V)^2*L^(-D) := by
  have hL0 : 0 < L := by linarith
  let s : ℝ := -K+aE*2+aN*2+aM*2+aH*2+16
  have heq : (2*(U*L^(-K))*V*(L^aE)^2*(L^aN)^2) *
      ((L^aM)^2*(L^aH)^2*((U*V)*L^(16 : ℝ))) = 2*(U*V)^2*L^s := by
    dsimp [s]
    have hs (a : ℝ) : L^(a*2) = (L^a)^2 := by
      simpa only [Nat.cast_ofNat] using rpow_mul_natCast hL0.le a 2
    simp only [rpow_add hL0, hs]
    ring
  rw [heq]
  calc
    _ ≤ L*(U*V)^2*L^s := mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right hL (sq_nonneg _)) (rpow_nonneg hL0.le _)
    _ = (U*V)^2*L^(1+s) := by rw [rpow_add hL0 1 s, rpow_one]; ring
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (rpow_le_rpow_of_exponent_le (by linarith) (by dsimp [s]; linarith)) (sq_nonneg _)

end Bounty
end

section

/- Remove the original sharp window and truncate the allocation Fourier integrals together. -/

open Finset Filter MeasureTheory Real

namespace Bounty

theorem exists_candidate_original_finite_mellin_reduction {c b q : ℝ}
    (hc : 0 < c) (hb : 0 < b) (hq0 : 0 ≤ q) (hq1 : q < 1) (R : ℝ) (hR : 1 ≤ R) {r : ℕ} (hr : 6 ≤ r) :
    ∃ J : ℕ, ∀ jStar : ℕ, J < jStar → ∀ A D : ℝ,
      ∃ B : ℝ, 1 ≤ B ∧ ∃ K : ℝ, 0 < K ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (E : ℝ) (S : Finset ℕ) (F : ℕ → ℕ → ℂ),
        (∀ u ∈ S, 0 < u ∧ (u : ℝ) ≤ R*exp L) →
        arithmeticProductWindow 1 (exp L) ⊆ S →
        1 ≤ E → log E ≤ (1-b)*L →
        (∀ u, ∀ m ∈ (2*u+1).divisors, ‖F u m‖ ≤ L^A) →
        (∀ u ∈ arithmeticProductWindow 1 (exp L), ∀ m ∈ (2*u+1).divisors,
          ¬(∀ p ∈ m.primeFactors, exp (sqrt L) ≤ (p : ℝ)) → F u m = 0) →
        Integrable (candidateFiniteMellinIntegrand c L q r jStar E B S F) ∧
        ‖(∑ u ∈ arithmeticProductWindow 1 (exp L),
            (candidateCoefficient c L q r jStar u : ℂ)*∑ m ∈ (2*u+1).divisors, F u m) -
          (∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ L^K},
            candidateFiniteMellinIntegrand c L q r jStar E B S F ξ)‖ ≤ exp L*L^(-D) := by
  obtain ⟨J,hJ⟩ := exists_candidate_original_box_reduction hc hb hq0 hq1 hr
  refine ⟨J,fun jStar hj A D => ?_⟩
  have hr0 : 0 < r := by omega
  obtain ⟨B,hB,hsmooth⟩ := exists_candidate_actual_window_smoothing_error_bound
    hc hr0 hq0 hq1 A (D+1)
  obtain ⟨K,hK,htrunc⟩ := exists_candidate_finite_smooth_mellin_bound
    hc hr0 hq0 hq1 R hR B (by linarith) A (D+1)
  refine ⟨B,hB,K,hK,?_⟩
  filter_upwards [hJ jStar hj A (D+1), hsmooth, htrunc,
    eventually_ge_atTop (3 : ℝ)] with L hboxL hsL htL hL
  intro E S F hS hSW hE hlogE hF hsupp
  have hL0 : 0 < L := by linarith
  let Fψ : ℕ → ℕ → ℂ := fun u m =>
    (typeIIWindowSmooth (L^(-B)) ((u : ℝ)/exp L) : ℂ)*F u m
  have hψF : ∀ u ∈ arithmeticProductWindow 1 (exp L),
      ∀ m ∈ (2*u+1).divisors, ‖Fψ u m‖ ≤ L^A := by
    intro u hu m hm
    dsimp only [Fψ]
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (typeII_window_smooth_bounds _ _).1]
    exact (mul_le_mul_of_nonneg_right (typeII_window_smooth_bounds _ _).2
      (norm_nonneg _)).trans (by simpa only [one_mul] using hF u m hm)
  have hψsupp : ∀ u ∈ arithmeticProductWindow 1 (exp L), ∀ m ∈ (2*u+1).divisors,
      ¬(∀ p ∈ m.primeFactors, exp (sqrt L) ≤ (p : ℝ)) → Fψ u m = 0 := by
    intro u hu m hm hp
    simp only [Fψ, hsupp u hu m hm hp, mul_zero]
  have hs := hsL jStar (S) F hSW hF
  have ha := hboxL E Fψ hE hlogE hψF hψsupp
  change ‖(∑ u ∈ arithmeticProductWindow 1 (exp L),
      (candidateCoefficient c L q r jStar u : ℂ) *
        ∑ m ∈ (2*u+1).divisors,
          (typeIIWindowSmooth (L^(-B)) ((u : ℝ)/exp L) : ℂ)*F u m) -
    (∑ u ∈ arithmeticProductWindow 1 (exp L),
      candidateBoxRangeCoefficient c L q r jStar E L u *
        ∑ m ∈ (2*u+1).divisors,
          (typeIIWindowSmooth (L^(-B)) ((u : ℝ)/exp L) : ℂ)*F u m)‖ ≤ _ at ha
  rw [← typeII_finite_smooth_divisor_sum_restrict hL0 S hSW, ← typeII_finite_smooth_divisor_sum_restrict hL0 S hSW] at ha
  have ht := htL jStar E S F hS (fun u hu m hm => hF u m hm)
  refine ⟨candidate_finite_mellin_integrable c L q r jStar E B S F (fun u hu => (hS u hu).1), ?_⟩
  let s₁ : ℂ := ∑ u ∈ S,
    (candidateCoefficient c L q r jStar u : ℂ) *
      (typeIIWindowSmooth (L^(-B)) ((u : ℝ)/exp L) : ℂ) *
        ∑ m ∈ (2*u+1).divisors, F u m
  let s₂ : ℂ := ∑ u ∈ S,
    candidateBoxRangeCoefficient c L q r jStar E L u *
      (typeIIWindowSmooth (L^(-B)) ((u : ℝ)/exp L) : ℂ) *
        ∑ m ∈ (2*u+1).divisors, F u m
  calc
    _ ≤ ‖(∑ u ∈ arithmeticProductWindow 1 (exp L),
          (candidateCoefficient c L q r jStar u : ℂ)*∑ m ∈ (2*u+1).divisors, F u m)-s₁‖ +
        ‖s₁-(∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ L^K},
          candidateFiniteMellinIntegrand c L q r jStar E B S F ξ)‖ :=
      norm_sub_le_norm_sub_add_norm_sub _ s₁ _
    _ ≤ exp L*L^(-(D+1)) + (‖s₁-s₂‖ +
        ‖s₂-(∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ L^K},
          candidateFiniteMellinIntegrand c L q r jStar E B S F ξ)‖) :=
      add_le_add hs (norm_sub_le_norm_sub_add_norm_sub _ s₂ _)
    _ ≤ exp L*L^(-(D+1)) + (exp L*L^(-(D+1)) + exp L*L^(-(D+1))) :=
      add_le_add le_rfl (add_le_add ha ht)
    _ = 3*(exp L*L^(-(D+1))) := by ring
    _ ≤ L*(exp L*L^(-(D+1))) := mul_le_mul_of_nonneg_right hL (by positivity)
    _ = exp L*(L^(1:ℝ)*L^(-(D+1))) := by rw [rpow_one]; ring
    _ = exp L*L^(-D) := by rw [← rpow_add hL0]; congr 2; ring

end Bounty
end

section

/- The exact performed coordinates of an original event exhaust its written common slots, including the none extension at shared slots. -/

namespace Bounty
section Index
variable {J K : Type*} {N : ℕ} (M : Fin N → ℕ) (B : ℕ)
  (steps : List (Option (J ⊕ K))) (u : Fin steps.length)
  (i : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)))

theorem full_mixed_common_index_stage_succ_iff :
    fullMixedCommonIndexStage M B steps i = u.succ ↔
      ∃ a, fullMixedCommonBirthOrder M B steps i = .inr ⟨u, a⟩ := by
  unfold fullMixedCommonIndexStage
  cases h : fullMixedCommonBirthOrder M B steps i with
  | inl a =>
    constructor
    · intro he
      exact ((Fin.succ_ne_zero u) he.symm).elim
    · rintro ⟨b, hb⟩
      cases hb
  | inr a =>
    rcases a with ⟨v, a⟩
    constructor
    · intro hv
      have hv' : v = u := Fin.succ_injective _ hv
      subst v
      exact ⟨a, rfl⟩
    · rintro ⟨b, hb⟩
      have hv : v = u := congrArg Sigma.fst (Sum.inr.inj hb)
      subst v
      rfl

theorem full_mixed_common_history_owner_ne
    (h : fullMixedCommonIndexStage M B steps i ≠ u.succ) :
    fullMixedCommonOwner M B steps (fullMixedCommonBirthOrder M B steps i) ≠ some u := by
  intro he
  apply h
  unfold fullMixedCommonIndexStage
  cases ha : fullMixedCommonBirthOrder M B steps i with
  | inl a => simp [ha, fullMixedCommonOwner] at he
  | inr a =>
    have hv : a.1 = u := by simpa only [ha, fullMixedCommonOwner, Option.some.injEq] using he
    exact congrArg Fin.succ hv
end Index

section Local
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K))) (u : Fin steps.length)
    (tag : Option (J ⊕ K)) (htag : steps.get u = tag)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag s)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P))

theorem full_mixed_common_tagged_history_write_here (a : FullMixedLocalBirthAddress S B tag) :
    fullMixedCommonHistoryWrite n S B A Δ D steps u s
      (fullMixedTaggedOwnerEvent n S B A Δ D steps u tag htag s e) history
      (fullMixedCommonOldIndexEmbedding S B steps (fullMixedTaggedOccurrenceEmbedding S B steps u tag htag a)) =
      fullMixedEventBirthLabel n S B A Δ D tag s e a := by
  subst tag
  change fullMixedCommonHistoryWrite n S B A Δ D steps u s e history
    ((fullMixedCommonBirthOrder M B steps).symm (.inr (fullMixedCommonStepEmbedding S B steps
      (fullMixedBirthOrder S B steps ((fullMixedBirthOrder S B steps).symm ⟨u, a⟩))))) = _
  rw [Equiv.apply_symm_apply]
  exact (full_mixed_common_history_write_here n S B A Δ D steps u s e history
    (fullMixedCommonLocalEmbedding S B (steps.get u) a)).trans
      (full_mixed_common_event_label_embed n S B A Δ D (steps.get u) s e a)

theorem full_mixed_common_tagged_history_write_coverage
    (i : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps))) :
    ((fullMixedCommonHistoryWrite n S B A Δ D steps u s
      (fullMixedTaggedOwnerEvent n S B A Δ D steps u tag htag s e) history i).isSome = true ∧
      fullMixedCommonIndexStage M B steps i = u.succ) ↔
    ∃ c : FullMixedEventBirthCoordinate n S B A Δ D tag s e,
      fullMixedCommonOldIndexEmbedding S B steps (fullMixedTaggedOccurrenceEmbedding S B steps u tag htag
        (fullMixedBirthCoordinateEquiv n S B A Δ D tag s e c).val) = i := by
  constructor
  · rintro ⟨hi, hu⟩
    subst tag
    obtain ⟨a, ha⟩ := (full_mixed_common_index_stage_succ_iff M B steps u i).mp hu
    have hi' : i = (fullMixedCommonBirthOrder M B steps).symm (.inr ⟨u, a⟩) := by
      rw [← ha, Equiv.symm_apply_apply]
    rw [hi', full_mixed_common_history_write_here] at hi
    have hp : fullMixedCommonEventBirthPerformed n S B A Δ D (steps.get u) s e a :=
      (full_mixed_common_event_label_present n S B A Δ D (steps.get u) s e a).mpr hi
    obtain ⟨b, hb, hp⟩ := (full_mixed_common_event_performed_iff n S B A Δ D (steps.get u) s e a).mp hp
    refine ⟨(fullMixedBirthCoordinateEquiv n S B A Δ D (steps.get u) s e).symm ⟨b, hp⟩, ?_⟩
    rw [Equiv.apply_symm_apply]
    apply (fullMixedCommonBirthOrder M B steps).injective
    rw [full_mixed_common_old_index_address, ha]
    change Sum.inr (fullMixedCommonStepEmbedding S B steps
      (fullMixedBirthOrder S B steps ((fullMixedBirthOrder S B steps).symm ⟨u, b⟩))) = _
    rw [Equiv.apply_symm_apply]
    exact congrArg (fun a => Sum.inr (⟨u, a⟩ : FullMixedCommonStepAddress M B steps)) hb
  · rintro ⟨c, rfl⟩
    refine ⟨?_, ?_⟩
    · rw [full_mixed_common_tagged_history_write_here]
      simp only [fullMixedEventBirthLabel, Option.isSome_map]
      exact (fullMixedBirthCoordinateEquiv n S B A Δ D tag s e c).property
    · rw [full_mixed_common_old_index_stage, full_mixed_tagged_occurrence_owner]

end Local
end Bounty
end

section

/- Ordinary and exceptional energies for finite families of actual dyads. -/

open Filter Finset Set MeasureTheory

namespace Bounty

theorem eventually_dyadic_family_mean_energy {c C k : ℝ} (hc : 0 ≤ c) :
    ∀ᶠ L : ℝ in atTop, ∀ (K : ℕ) (lo hi : Fin K → ℕ)
      (w : Fin K → ℕ → ℂ) (U : Fin K → ℝ) (R : ℝ),
      (K : ℝ) ≤ L ^ k → 0 ≤ R →
      (∀ j, 1 ≤ U j ∧ R ≤ U j ∧ Real.log (U j) ≤ c * L ∧
        U j ≤ (lo j : ℝ) ∧ (hi j : ℝ) ≤ 2 * U j ∧
        (∑ n ∈ Finset.Icc (lo j) (hi j), ‖w j n‖ ^ 2) ≤ L ^ C / U j) →
      (∫ t in Set.Icc (-R) R,
        ‖∑ j : Fin K, ∑ n ∈ Finset.Icc (lo j) (hi j), w j n *
          Complex.exp ((Real.log (n : ℝ) * t : ℝ) * Complex.I)‖ ^ 2) ≤ L ^ (C + 2 + 2 * k) := by
  filter_upwards [eventually_dyadic_polynomial_mean_square_power (C := C) hc,
    eventually_gt_atTop (0 : ℝ)] with L hmean hL
  intro K lo hi w U R hcard hR hdata
  apply finite_sum_integral_energy_power Finset.univ _ (by intro j; fun_prop)
    measurableSet_Icc (by exact fun _ ht => ht) hL
  · simpa only [Finset.card_univ, Fintype.card_fin] using hcard
  · intro j _
    obtain ⟨hU, hRU, hlog, hlo, hhi, henergy⟩ := hdata j
    apply hmean (Finset.Icc (lo j) (hi j)) (w j) (U j) R hU hR hRU hlog _ henergy
    intro n hn
    obtain ⟨hnlo, hnhi⟩ := Finset.mem_Icc.mp hn
    exact ⟨hlo.trans (Nat.cast_le.mpr hnlo), (Nat.cast_le.mpr hnhi).trans hhi⟩

theorem eventually_prime_exceptional_dyadic_family_energy
    {a beta c A B d C k : ℝ}
    (ha : 0 < a) (ha1 : a ≤ 1) (hbeta : beta < 1) (hc : 0 ≤ c) (hA : 0 ≤ A)
    (hB : 1 ≤ B) (hd : 0 < d) :
    ∀ᶠ L : ℝ in atTop, ∀ (s : Finset ℕ), (∀ p ∈ s, Nat.Prime p) →
      ∀ (coeff : s → ℂ) (Y P R : ℝ),
      1 ≤ Y → d * L ≤ Real.log Y → Real.log Y ≤ c * L →
      Real.exp (L ^ a) / 2 ≤ P → P ≤ Real.exp (L ^ beta) →
      0 ≤ R → R ≤ Y →
      (∀ p ∈ s, P ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2 * P) →
      (∀ p : s, ‖coeff p‖ ≤ B) →
      ∀ (K : ℕ) (lo hi : Fin K → ℕ) (w : Fin K → ℕ → ℂ) (U : Fin K → ℝ),
      (K : ℝ) ≤ L ^ k →
      (∀ j, Y ^ (3 / 5 : ℝ) ≤ U j ∧ U j ≤ (lo j : ℝ) ∧ (hi j : ℝ) ≤ 2 * U j ∧
        (∑ n ∈ Finset.Icc (lo j) (hi j), ‖w j n‖ ^ 2) ≤ L ^ C / U j) →
      (∫ t in primeExceptionalTimes s coeff (L ^ (-A)) R,
        ‖∑ j : Fin K, ∑ n ∈ Finset.Icc (lo j) (hi j), w j n *
          Complex.exp ((Real.log (n : ℝ) * t : ℝ) * Complex.I)‖ ^ 2) ≤ L ^ (C + 2 + 2 * k) := by
  filter_upwards [eventually_prime_exceptional_residual_energy (C := C)
    ha ha1 hbeta hc hA hB hd, eventually_gt_atTop (0 : ℝ)] with L hsparse hL
  intro s hs coeff Y P R hY hlo hhi hPlo hPhi hR hRY hband hcoeff K lo hi w U hcard hdata
  refine finite_sum_integral_energy_power Finset.univ _ (by intro j; fun_prop)
    (prime_exceptional_times_measurable s coeff (L ^ (-A)) R) (R := R) ?_ hL ?_ ?_
  · intro t ht
    exact abs_le.mp ht.1
  · simpa only [Finset.card_univ, Fintype.card_fin] using hcard
  · intro j _
    obtain ⟨hU, hlow, hhigh, henergy⟩ := hdata j
    exact hsparse s hs coeff Y P R (U j) hY hlo hhi hPlo hPhi hR hRY hband hcoeff
      hU (lo j) (hi j) (w j) hlow hhigh henergy

end Bounty
end

section

/- Actual upper sieve weights transfer the proven phase bound to rough integers. -/

open Finset

namespace Bounty

theorem exists_rough_logarithmic_sieve_bound (τ : ℝ) (hτ : 0 < τ) :
    ∃ δ C K N0 : ℝ, 0 < δ ∧ 0 < C ∧ 0 < K ∧ 1 ≤ N0 ∧
      ∀ (z : ℝ) (h : ℕ), 1 < z → 1 ≤ h → Even h →
      ∀ (Y x u : ℝ) (a b q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q),
      a ≤ b → Y ≤ (a : ℝ)+1 → (b : ℝ) ≤ 2*Y →
      N0 ≤ Y/(z^(4*(h : ℝ)+2)*(q : ℝ)) →
      1 ≤ x → x^(τ/2) ≤ Y/(z^(4*(h : ℝ)+2)*(q : ℝ)) →
      u ≠ 0 → |u| ≤ x^2 →
      ‖∑ n ∈ (Ioc a b).filter (fun n : ℕ => ∀ p ∈ n.primeFactors, z < (p : ℝ)),
        χ (n : ZMod q)*Complex.exp (((u*Real.log (n : ℝ) : ℝ) : ℂ)*Complex.I)‖ ≤
        K*(2*Y*Real.exp (-(h : ℝ))+z^(4*(h : ℝ)+2))+
          Y*(C*(1/|u|+(Y/(z^(4*(h : ℝ)+2)*(q : ℝ)))^(-δ)))*(K*Real.log (2*z)) := by
  obtain ⟨δ,C,N0,hδ,hC,hN0,hdiv⟩ := exists_divisor_character_logarithmic_bound τ hτ
  obtain ⟨K,hK,hweights⟩ := exists_rough_integer_polynomial
  refine ⟨δ,C,K,N0,hδ,hC,hK,hN0,?_⟩
  intro z h hz hh heven Y x u a b q hqInst χ hab hYa hbY hN hx hxN hu hux
  obtain ⟨lam,habs,hsupport,hpoint,hmass,hover⟩ := hweights hz h hh heven
  have hz0 : 0 < z := lt_trans zero_lt_one hz
  have hqR : 0 < (q : ℝ) := by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne q)
  have hlevel : 0 < z^(4*(h : ℝ)+2) := Real.rpow_pos_of_pos hz0 _
  have hNpos : 0 < Y/(z^(4*(h : ℝ)+2)*(q : ℝ)) :=
    lt_of_lt_of_le (lt_of_lt_of_le zero_lt_one hN0) hN
  have hY : 0 < Y := (div_pos_iff.mp hNpos).resolve_right (by
    intro ht
    exact (not_lt_of_ge (mul_pos hlevel hqR).le) ht.2) |>.1
  have hfinite : Summable (fun d : ℕ => |lam d|/(d : ℝ)) := by
    apply summable_of_ne_finset_zero (s := Icc 1 ⌊z^(4*(h : ℝ)+2)⌋₊)
    intro d hd
    have hl : lam d = 0 := by
      by_contra hn
      exact hd (mem_Icc.mpr ⟨(hsupport d hn).1, Nat.le_floor (hsupport d hn).2.1⟩)
    simp only [hl,abs_zero,zero_div]
  have hm : (∑ d ∈ Icc 1 b, |lam d|/(d : ℝ)) ≤ K*Real.log (2*z) :=
    (hfinite.sum_le_tsum (Icc 1 b) (fun d hd => by positivity)).trans hmass
  have ho := (hover (a : ℝ) (b : ℝ) (Nat.cast_nonneg _) (Nat.cast_le.mpr hab)).2
  simp only [Nat.floor_natCast,roughBand] at ho
  apply rough_interval_oscillation_of_divisor_sums a b lam _ hY.le
    (show 0 ≤ C*(1/|u|+(Y/(z^(4*(h : ℝ)+2)*(q : ℝ)))^(-δ)) by positivity)
    (fun n hn => (hpoint n hn).2)
  · intro n hn
    rw [norm_mul,Complex.norm_exp_ofReal_mul_I,mul_one]
    exact χ.norm_le_one _
  · apply ho.trans
    apply mul_le_mul_of_nonneg_left _ hK.le
    apply add_le_add _ le_rfl
    apply mul_le_mul_of_nonneg_right _ (Real.exp_pos _).le
    have ha : 0 ≤ (a : ℝ) := Nat.cast_nonneg _
    linarith
  · exact hm
  · intro d hd hne
    have hdpos := (hsupport d hne).1
    have hdR : 0 < (d : ℝ) := by exact_mod_cast hdpos
    have hscale : Y/(z^(4*(h : ℝ)+2)*(q : ℝ)) ≤ Y/((d : ℝ)*(q : ℝ)) := by
      apply div_le_div_of_nonneg_left hY.le (mul_pos hdR hqR)
      exact mul_le_mul_of_nonneg_right (hsupport d hne).2.1 hqR.le
    have hb := hdiv Y x u a b d q χ hdpos hYa hbY (hN.trans hscale)
      hx (hxN.trans hscale) hu hux
    have hp := Real.rpow_le_rpow_of_nonpos hNpos hscale (neg_nonpos.mpr hδ.le)
    calc
      _ ≤ C*(Y/(d : ℝ))*(1/|u|+(Y/((d : ℝ)*(q : ℝ)))^(-δ)) := hb
      _ ≤ C*(Y/(d : ℝ))*(1/|u|+(Y/(z^(4*(h : ℝ)+2)*(q : ℝ)))^(-δ)) := by
        gcongr
      _ = _ := by ring

end Bounty
end

section

/- The original weighted prime coefficient factors through unshared marks.
The surrounding shared exclusions and dilation phase remain explicit. -/

open Finset Classical
namespace Bounty

section Phase
variable {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
  (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
  (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h : ℝ)
  (kept : Finset (RepeatedBigFlatIndex G J ell) → Finset ℤ)
  (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
  (L R : PhysicalMarkLists P J ell)
  (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))

theorem physical_weighted_prime_coefficient_factors_unshared :
    repeatedBigPrimePatternWeight probes r t i *
      repeatedBigPrimePatternKernel P V probes r t hrt Q h kept i
        (fun g s => L g s) (fun g s => R g s) aux =
      repeatedBigPrimePatternWeight probes r t i *
        physicalUnsharedPrimePatternKernel P V probes r t hrt Q h kept i
          (physicalGroupUnsharedEmbedding (repeatedBigPrimePatternCut probes r t i) L)
          (physicalGroupUnsharedEmbedding (repeatedBigPrimePatternCut probes r t i) R) aux :=
  congrArg (fun z => repeatedBigPrimePatternWeight probes r t i * z)
    (physical_prime_pattern_kernel_factors_unshared P V probes r t hrt Q h kept i L R aux)

theorem physical_prime_bare_scalar_unshared (ζ : ℝ) :
    let C := repeatedBigPrimePatternCut probes r t i
    physicalBarePatternScalar V C ζ
      (fun l₀ r₀ a => repeatedBigPrimePatternWeight probes r t i *
        repeatedBigPrimePatternKernel P V probes r t hrt Q h kept i
          (fun g s => l₀ g s) (fun g s => r₀ g s) a) aux L R =
      if physicalListAdmissible C aux L R then
        ((physicalAuxMass V C aux * physicalCompletionMass V C ell : ℝ) : ℂ) *
          (repeatedBigPrimePatternWeight probes r t i *
            physicalUnsharedPrimePatternKernel P V probes r t hrt Q h kept i
              (physicalGroupUnsharedEmbedding C L) (physicalGroupUnsharedEmbedding C R) aux) *
          physicalPhase ζ (physicalSharedFactor C L * physicalFreeFactor C aux)
      else 0 := by
  dsimp only
  unfold physicalBarePatternScalar
  dsimp only
  rw [physical_prime_pattern_kernel_factors_unshared, physical_D_shared_free]

theorem physical_prime_weighted_shifted_phase_strip
    (hprime : ∀ g p, p ∈ P g → p.Prime) (n k : ℤ)
    (hdiv : (physicalSharedFactor (repeatedBigPrimePatternCut probes r t i) L : ℤ) ∣ n)
    (hn : n ≠ 0)
    (ht : n + k * (physicalD (repeatedBigPrimePatternCut probes r t i) L aux : ℕ) ≠ 0)
    (a b : ℝ) :
    let C := repeatedBigPrimePatternCut probes r t i
    physicalPhase a n.natAbs * physicalPhase b (n + k * (physicalD C L aux : ℕ)).natAbs *
      (repeatedBigPrimePatternWeight probes r t i *
        repeatedBigPrimePatternKernel P V probes r t hrt Q h kept i
          (fun g s => L g s) (fun g s => R g s) aux) *
      physicalPhase (-(a + b)) (physicalD C L aux) =
    (repeatedBigPrimePatternWeight probes r t i *
      physicalUnsharedPrimePatternKernel P V probes r t hrt Q h kept i
        (physicalGroupUnsharedEmbedding C L) (physicalGroupUnsharedEmbedding C R) aux) *
      physicalPhase a (n / physicalSharedFactor C L).natAbs *
      physicalPhase b (n / physicalSharedFactor C L + k * (physicalFreeFactor C aux : ℕ)).natAbs *
      physicalPhase (-(a + b)) (physicalFreeFactor C aux) := by
  dsimp only
  rw [physical_weighted_prime_coefficient_factors_unshared]
  let C := repeatedBigPrimePatternCut probes r t i
  let z := repeatedBigPrimePatternWeight probes r t i *
    physicalUnsharedPrimePatternKernel P V probes r t hrt Q h kept i
      (physicalGroupUnsharedEmbedding C L) (physicalGroupUnsharedEmbedding C R) aux
  change physicalPhase a n.natAbs * physicalPhase b (n + k * (physicalD C L aux : ℕ)).natAbs *
      z * physicalPhase (-(a+b)) (physicalD C L aux) = _
  calc
    _ = z * (physicalPhase a n.natAbs *
        physicalPhase b (n + k * (physicalD C L aux : ℕ)).natAbs *
        physicalPhase (-(a+b)) (physicalD C L aux)) := by ring
    _ = _ := by
      rw [physical_shifted_phase_strip C L aux hprime n k hdiv hn ht a b]
      ring

end Phase
end Bounty
end

section

/- The shared-draw exclusion removes the exact original overlap corrections. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_shared_avoidance_from_draw {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C)
    (hprime : ∀ g p, p ∈ P g → p.Prime) {w z : ℕ} (hw : 0 < w) (hz : 0 < z)
    (havoid : ∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z) :
    ∀ p ∈ physicalSharedPrimes C L,
      ¬(p.2.val : ℤ) ∣ (w : ℤ) ∧ ¬(p.2.val : ℤ) ∣ (z : ℤ) := by
  intro p hp
  obtain ⟨s, hs, he⟩ := (mem_physical_shared_primes C L p).mp hp
  obtain ⟨j, hj, rfl⟩ := (physical_mem_shared_slots_iff (C p.1) s).mp hs
  let a : ↥(univ \ C p.1) := ⟨j, mem_sdiff.mpr ⟨mem_univ _, hj⟩⟩
  have hn : ¬((physicalSharedAux C L p.1 a).val ∣ w ∨
      (physicalSharedAux C L p.1 a).val ∣ z ∨ ∃ i, aux p.1 i = physicalSharedAux C L p.1 a) := by
    intro h
    exact havoid p.1 a ((physical_mem_shared_forbidden_iff C aux p.1
      (hprime p.1) hw hz (physicalSharedAux C L p.1 a)).mpr h)
  constructor
  · intro hd
    apply hn
    left
    change (L p.1 (Sum.inl j)).val ∣ w
    rw [he]
    exact_mod_cast hd
  · intro hd
    apply hn
    right
    left
    change (L p.1 (Sum.inl j)).val ∣ z
    rw [he]
    exact_mod_cast hd

theorem physical_shared_vertex_pair_of_draw_avoids {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L R : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C)
    (hshared : physicalSharedCompatible C L R)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (q : ℝ) {w z : ℕ} (hw : 0 < w) (hz : 0 < z)
    (havoid : ∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z) :
    physicalVertexWeight L q ((physicalSharedFactor C L : ℤ) * (w : ℤ)) *
      physicalVertexWeight R q ((physicalSharedFactor C L : ℤ) * (z : ℤ)) =
        physicalUnsharedVertex C L q (w : ℤ) * physicalUnsharedVertex C R q (z : ℤ) := by
  have ha := physical_shared_avoidance_from_draw C L aux hprime hw hz havoid
  have he := physical_shared_vertex_pair_removal C L R hshared hprime hdis q (w : ℤ) (z : ℤ)
  rw [physical_shared_overlap_eq_one C L q (w : ℤ) (fun p hp => (ha p hp).1),
    physical_shared_overlap_eq_one C L q (z : ℤ) (fun p hp => (ha p hp).2), one_mul, mul_one] at he
  exact he

end Bounty
end

section

/- Direct retained-cell bounds on every pair of unshared marked lists.
No compatible shared completion is required. -/

open Finset Classical
namespace Bounty

theorem physical_unshared_prime_coefficient_norm_le
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (Q : ℕ) (h ξ : ℝ) (hξ : 0 < ξ)
    (u v : GroupMarkedLists P (fun g => ell + (repeatedBigAuxCut A B g).card))
    (aux : PhysicalAuxLabels P (repeatedBigAuxCut A B)) :
    ‖physicalUnsharedPrimeCoefficient P V A B hU hAB Q h
      (primeProductRetainedCells (fun i : A => P i.val.1) (fun i => V i.val.1) h ξ)
      (primeProductRetainedCells (fun i : B => P i.val.1) (fun i => V i.val.1) h ξ)
      u v aux‖ ≤ ((Q * Q : ℕ) / ξ) ^ 2 := by
  unfold physicalUnsharedPrimeCoefficient
  rw [norm_mul, pow_two]
  apply mul_le_mul
    (prime_ideal_kernel_norm_le _ _ Q h _ hξ
      (fun _ hd => prime_product_retained_cell_mass _ _ h ξ hd) _ _)
    (prime_ideal_kernel_norm_le _ _ Q h _ hξ
      (fun _ hd => prime_product_retained_cell_mass _ _ h ξ hd) _ _)
    (norm_nonneg _)
  positivity

section Pattern
variable {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
  (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
  (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ) (hξ : 0 < ξ)
  (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
  (u v : GroupMarkedLists P (fun g => ell + (repeatedBigPrimePatternCut probes r t i g).card))
  (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))

include hξ

theorem physical_unshared_prime_pattern_kernel_norm_le :
    let kept := fun U : Finset (RepeatedBigFlatIndex G J ell) =>
      primeProductRetainedCells (fun j : U => P j.val.1) (fun j => V j.val.1) h ξ
    ‖physicalUnsharedPrimePatternKernel P V probes r t hrt Q h kept i u v aux‖ ≤
      repeatedBigPrimePatternBound probes r t Q ξ i := by
  intro kept
  cases i with
  | inl x => simp only [physicalUnsharedPrimePatternKernel, repeatedBigPrimePatternBound, norm_one, le_refl]
  | inr ab =>
    exact physical_unshared_prime_coefficient_norm_le P V ab.1.val ab.2.val
      _ _ Q h ξ hξ u v aux

theorem physical_unshared_weighted_prime_pattern_norm_le :
    let kept := fun U : Finset (RepeatedBigFlatIndex G J ell) =>
      primeProductRetainedCells (fun j : U => P j.val.1) (fun j => V j.val.1) h ξ
    ‖repeatedBigPrimePatternWeight probes r t i *
      physicalUnsharedPrimePatternKernel P V probes r t hrt Q h kept i u v aux‖ ≤
      repeatedBigPrimePatternBound probes r t Q ξ i := by
  intro kept
  rw [norm_mul, repeated_big_prime_pattern_weight_norm, one_mul]
  exact physical_unshared_prime_pattern_kernel_norm_le P V probes r t hrt Q h ξ hξ i u v aux

end Pattern
end Bounty
