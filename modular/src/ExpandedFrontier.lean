/- Full ambient domains and the precise remaining candidate-weighted proxy errors. -/

open Finset Filter
namespace Bounty

noncomputable def shiftedPrimeBandPairs (T : Finset ℕ) (A B : ℝ) : Finset (ℕ × ℕ) := by
  classical
  exact (shiftedFactorPairs T).filter (fun v => v.1 ∈ primeBand A B)

noncomputable def shiftedBalancedPairs (T : Finset ℕ) (κ L : ℝ) : Finset (ℕ × ℕ) := by
  classical
  exact (shiftedFactorPairs T).filter (balancedPairWindow κ L)

noncomputable def ambientRoughProxyError (T : Finset ℕ) (μ : ℕ → ℝ)
    (γ L S A B : ℝ) : ℝ :=
  ∑ v ∈ shiftedPrimeBandPairs T A B, μ (shiftedPairIndex v)*
    (roughTestIndicator γ L v.2-roughTestLogarithmicProxy γ L S v.2)

noncomputable def ambientPrimeProxyError (T : Finset ℕ) (μ : ℕ → ℝ)
    (κ L S : ℝ) : ℝ := by
  classical
  exact ∑ v ∈ shiftedBalancedPairs T κ L, μ (shiftedPairIndex v)*
    ((if v.1.Prime then 1 else 0 : ℝ)*(if v.2.Prime then 1 else 0 : ℝ)-
      primeLogarithmicProxy L S v.1*primeLogarithmicProxy L S v.2)

theorem shifted_prime_band_pair_data (T : Finset ℕ) (A B : ℝ)
    {v : ℕ × ℕ} (hv : v ∈ shiftedPrimeBandPairs T A B) :
    shiftedPairIndex v ∈ T ∧ v.1 ∈ primeBand A B ∧ v.1*v.2=2*shiftedPairIndex v+1 := by
  classical
  have h := shifted_factor_pair_properties T (mem_filter.mp hv).1
  exact ⟨h.2.2.1,(mem_filter.mp hv).2,h.2.2.2⟩

theorem shifted_balanced_pair_data (T : Finset ℕ) (κ L : ℝ)
    {v : ℕ × ℕ} (hv : v ∈ shiftedBalancedPairs T κ L) :
    shiftedPairIndex v ∈ T ∧ balancedPairWindow κ L v ∧ v.1*v.2=2*shiftedPairIndex v+1 := by
  classical
  have h := shifted_factor_pair_properties T (mem_filter.mp hv).1
  exact ⟨h.2.2.1,(mem_filter.mp hv).2,h.2.2.2⟩

theorem ambient_rough_test_sum_eq_proxy_add_error (T : Finset ℕ) (μ : ℕ → ℝ)
    (γ L S A B : ℝ) :
    (∑ v ∈ shiftedPrimeBandPairs T A B, μ (shiftedPairIndex v)*roughTestIndicator γ L v.2) =
      (∑ v ∈ shiftedPrimeBandPairs T A B, μ (shiftedPairIndex v)*roughTestLogarithmicProxy γ L S v.2)+
      ambientRoughProxyError T μ γ L S A B := by
  unfold ambientRoughProxyError
  rw [← sum_add_distrib]
  apply sum_congr rfl
  intro v hv
  ring

theorem ambient_prime_test_sum_eq_proxy_add_error (T : Finset ℕ) (μ : ℕ → ℝ)
    (κ L S : ℝ) :
    (∑ v ∈ shiftedBalancedPairs T κ L, μ (shiftedPairIndex v)*
      (if v.1.Prime then 1 else 0 : ℝ)*(if v.2.Prime then 1 else 0 : ℝ)) =
      (∑ v ∈ shiftedBalancedPairs T κ L, μ (shiftedPairIndex v)*
        primeLogarithmicProxy L S v.1*primeLogarithmicProxy L S v.2)+
      ambientPrimeProxyError T μ κ L S := by
  classical
  unfold ambientPrimeProxyError
  rw [← sum_add_distrib]
  apply sum_congr rfl
  intro v hv
  ring

end Bounty
end

