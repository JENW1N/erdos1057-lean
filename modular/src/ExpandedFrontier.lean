section

/- Uniform prime Mellin cancellation across a polynomial number of logarithmic dyads. -/

open Finset Filter

namespace Bounty

theorem dyadic_prime_band_bucket (A B : ℝ) (k : ℕ) :
    dyadicNatBucket (primeBand A B) k =
      (Ioc (max ⌊A⌋₊ (2^k-1)) (min ⌊B⌋₊ (2^(k+1)-1))).filter Nat.Prime := by
  ext p
  by_cases hp : p.Prime
  · have hp0 := hp.pos
    have hk0 : 0 < 2^k := by positivity
    have hk1 : 0 < 2^(k+1) := by positivity
    simp only [dyadicNatBucket, primeBand, mem_filter, mem_Ioc, hp, and_true,
      Nat.log2_eq_iff hp.ne_zero, max_lt_iff, le_min_iff]
    omega
  · simp only [dyadicNatBucket, primeBand, mem_filter, hp, and_false, false_and]

theorem eventually_prime_mellin_band_power_bound (hZ : PrimitiveZeroFreeHalfPlane)
    {a C T : ℝ} (ha : 0 < a) (hC : 0 < C) (hT : 0 ≤ T) (Bsave : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ A B : ℝ, Real.exp (a*L) ≤ A → 0 ≤ B → B ≤ Real.exp (C*L) →
      ∀ (r : ℕ), 0 < r → (r : ℝ) ≤ L^T →
      ∀ χ : DirichletCharacter ℂ r, χ ≠ 1 → ∀ v : ℝ, |v| ≤ L^T →
        ‖∑ p ∈ primeBand A B, harmonicMellinWeight v p*χ (p : ZMod r)‖ ≤ L^(-Bsave) := by
  classical
  have ha2 : 0 < a/2 := by positivity
  filter_upwards [eventually_prime_interval_mellin_power_bound hZ ha2 hT (Bsave+2),
    eventually_ge_atTop (1 : ℝ), eventually_ge_atTop (2*Real.log 2/a),
    eventually_ge_atTop (C/Real.log 2+1)] with L hprime hL1 hLa hLc
  have hL : 0 < L := zero_lt_one.trans_le hL1
  intro A B hA hB hBmax r hr hrT χ hχ v hv
  have hA0 : 0 ≤ A := (Real.exp_pos _).le.trans hA
  let F := primeBand A B
  let w := fun p : ℕ => harmonicMellinWeight v p*χ (p : ZMod r)
  have hFpos : ∀ p ∈ F, 0 < p := fun p hp => ((mem_primeBand_iff hA0 hB p).mp hp).1.pos
  have hFlow : ∀ p ∈ F, Real.exp (a*L) < (p : ℝ) := fun p hp =>
    hA.trans_lt ((mem_primeBand_iff hA0 hB p).mp hp).2.1
  have hFupper : ∀ p ∈ F, p ≤ ⌊Real.exp (C*L)⌋₊ := fun p hp =>
    Nat.le_floor (((mem_primeBand_iff hA0 hB p).mp hp).2.2.trans hBmax)
  have hcount : ((dyadicNatIndices F).card : ℝ) ≤ L^2 := by
    have hraw := dyadicNatIndices_card_le_log F ⌊Real.exp (C*L)⌋₊ hFupper
    have hNpos : 0 < ⌊Real.exp (C*L)⌋₊ := Nat.floor_pos.mpr (Real.one_le_exp (by positivity))
    have hlog : Real.log (⌊Real.exp (C*L)⌋₊ : ℝ) ≤ C*L := by
      simpa only [Real.log_exp] using Real.log_le_log (Nat.cast_pos.mpr hNpos)
        (Nat.floor_le (Real.exp_pos _).le)
    have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
    calc
      _ ≤ Real.log (⌊Real.exp (C*L)⌋₊ : ℝ)/Real.log 2+1 := hraw
      _ ≤ (C*L)/Real.log 2+1 := add_le_add (div_le_div_of_nonneg_right hlog hlog2.le) le_rfl
      _ ≤ (C*L)/Real.log 2+L := add_le_add le_rfl hL1
      _ = (C/Real.log 2+1)*L := by ring
      _ ≤ L*L := mul_le_mul_of_nonneg_right hLc hL.le
      _ = L^2 := (pow_two L).symm
  have htwo : 2 ≤ Real.exp ((a/2)*L) := by
    apply (Real.log_le_iff_le_exp (by norm_num : (0 : ℝ) < 2)).mp
    have hh := (div_le_iff₀ ha).mp hLa
    nlinarith
  have hexp : 2*Real.exp ((a/2)*L) ≤ Real.exp (a*L) := by
    have hm := mul_le_mul_of_nonneg_right htwo (Real.exp_pos ((a/2)*L)).le
    have he : Real.exp ((a/2)*L)*Real.exp ((a/2)*L) = Real.exp (a*L) := by
      rw [← Real.exp_add]
      congr 1
      ring
    rwa [he] at hm
  have hbucket : ∀ k ∈ dyadicNatIndices F, ‖∑ p ∈ dyadicNatBucket F k, w p‖ ≤ L^(-(Bsave+2)) := by
    intro k hk
    obtain ⟨p, hp⟩ := (dyadicNatBucket_nonempty_iff F k).mpr hk
    have hpb := dyadicNatBucket_bounds F hFpos hp
    have hpF := (mem_dyadicNatBucket F k p).mp hp |>.1
    let Y : ℝ := (2 : ℝ)^k
    have hY0 : 0 < Y := by positivity
    have hYlow : Real.exp ((a/2)*L) ≤ Y := by
      have hpY : (p : ℝ) < 2*Y := by
        have hh : (p : ℝ) < (2 : ℝ)^(k+1) := by exact_mod_cast hpb.2
        simpa only [pow_succ, Y, mul_comm] using hh
      have hpL := hFlow p hpF
      nlinarith
    let lo := max ⌊A⌋₊ (2^k-1)
    let hi := min ⌊B⌋₊ (2^(k+1)-1)
    have hrepr : dyadicNatBucket F k = (Ioc lo hi).filter Nat.Prime := dyadic_prime_band_bucket A B k
    have hpI : p ∈ Ioc lo hi := (mem_filter.mp (hrepr ▸ hp)).1
    have hlohi : lo ≤ hi := (mem_Ioc.mp hpI).1.le.trans (mem_Ioc.mp hpI).2
    have hYm : Y ≤ (lo+1 : ℕ) := by
      have hkpos : 0 < 2^k := by positivity
      have hh : 2^k ≤ lo+1 := by dsimp [lo]; omega
      dsimp [Y]
      exact_mod_cast hh
    have hhiY : (hi : ℝ) ≤ 2*Y := by
      have hh : hi ≤ 2^(k+1) := (min_le_right _ _).trans (Nat.sub_le _ _)
      have hhR : (hi : ℝ) ≤ (2 : ℝ)^(k+1) := by exact_mod_cast hh
      simpa only [pow_succ, Y, mul_comm] using hhR
    rw [hrepr]
    exact hprime Y hYlow r hr hrT χ hχ v hv lo hi hlohi hYm hhiY
  change ‖∑ p ∈ F, w p‖ ≤ _
  rw [← sum_dyadicNatBuckets F w]
  calc
    _ ≤ ∑ k ∈ dyadicNatIndices F, ‖∑ p ∈ dyadicNatBucket F k, w p‖ := norm_sum_le _ _
    _ ≤ ∑ _k ∈ dyadicNatIndices F, L^(-(Bsave+2)) := sum_le_sum hbucket
    _ = ((dyadicNatIndices F).card : ℝ)*L^(-(Bsave+2)) := by simp only [sum_const, nsmul_eq_mul]
    _ ≤ L^2*L^(-(Bsave+2)) := mul_le_mul_of_nonneg_right hcount (by positivity)
    _ = L^(-Bsave) := by
      rw [← Real.rpow_natCast L 2, ← Real.rpow_add hL]
      congr 1
      norm_num

end Bounty
end

section

/- The marked skeleton estimate for the original physical ghost parameters. -/

open Finset Classical

namespace Bounty

theorem coupled_physical_ghost_marked_length_row_le
    {G : Type*} [Fintype G] [DecidableEq G] {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) (μ : ∀ g, P g → ℝ) (q ρ v : ℝ) (V ε : G → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hε : ∀ g, 0 ≤ ε g)
    (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (hρ : 0 < ρ) (hv : 0 < v)
    (hD : q / ρ ^ 2 + ((1 - q) / ρ) / v ≤ 1)
    (t : G → ℕ) (B : ℕ) (d : G → ℕ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) :
    (∑ sk : CoupledGhostSkeleton t B s, if ∀ g, d g ≤ (sk g).1.val then
      coupledGhostSkeletonAbsMass (fun g => physicalGhostRetention (n g) q ρ)
        (fun g => physicalGhostTermination (n g) q ρ) t B s sk *
        v ^ (∑ g, boundedGhostSkeletonOutputCount (t g) B (s g) (sk g).1 (sk g).2) *
        ∏ g, ε g ^ d g * (|(1 - q) * V g / ρ| * ∑ p, μ g p) ^ ((sk g).1.val - d g) else 0) ≤
      (∏ g, (ε g * v) ^ d g) *
        (∏ g, Real.exp ((|(1 - q) * V g / ρ| * ∑ p, μ g p) * v)) * productLengthLyapunov v s := by
  have hA : ∀ g z, 0 ≤ physicalGhostRetention (n g) q ρ z := by
    intro g z
    unfold physicalGhostRetention
    split_ifs
    · exact div_nonneg hq0 (sq_nonneg _)
    · exact zero_le_one
  have h := coupled_ghost_marked_length_row_le
    (fun g => physicalGhostRetention (n g) q ρ)
    (fun g => physicalGhostTermination (n g) q ρ) hA
    (fun g => |(1 - q) * V g / ρ| * ∑ p, μ g p) ε v
    (fun g => mul_nonneg (abs_nonneg _) (sum_nonneg fun p _ => hμ g p)) hε hv.le
    (fun g => physical_ghost_length_damping (n g) q ρ v hq1 hρ hv hD) t B d s
  simpa only [prod_mul_distrib, productLengthLyapunov] using h

end Bounty
end

section

/- Actual birth coordinates at any owner embed into the fixed original chronological index set. -/

open Classical

namespace Bounty

section Owner
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K))) (u : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (steps.get u) s)

noncomputable def fullMixedOwnerCoordinateEmbedding :
    FullMixedEventBirthCoordinate n S B A Δ D (steps.get u) s e ↪
      Fin (Fintype.card (FullMixedBirthAddress S B steps)) where
  toFun c := fullMixedOccurrenceAddressEmbedding S B steps u
    (fullMixedBirthCoordinateEquiv n S B A Δ D (steps.get u) s e c).val
  inj' := by
    intro a b h
    apply (fullMixedBirthCoordinateEquiv n S B A Δ D (steps.get u) s e).injective
    apply Subtype.ext
    exact (fullMixedOccurrenceAddressEmbedding S B steps u).injective h

theorem full_mixed_owner_coordinate_owner
    (c : FullMixedEventBirthCoordinate n S B A Δ D (steps.get u) s e) :
    fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps
      (fullMixedOwnerCoordinateEmbedding n S B A Δ D steps u s e c)) = u :=
  full_mixed_occurrence_address_owner S B steps u _

theorem full_mixed_owner_coordinate_address
    (c : FullMixedEventBirthCoordinate n S B A Δ D (steps.get u) s e) :
    fullMixedBirthOrder S B steps
      (fullMixedOwnerCoordinateEmbedding n S B A Δ D steps u s e c) =
      ⟨u, (fullMixedBirthCoordinateEquiv n S B A Δ D (steps.get u) s e c).val⟩ :=
  (fullMixedBirthOrder S B steps).apply_symm_apply _

end Owner

section Path
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K)))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps s) (u : Fin steps.length)

noncomputable abbrev fullMixedOwnerOccurrence :=
  finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) steps s p u

theorem full_mixed_owner_coordinate_path
    (c : FullMixedEventBirthCoordinate n S B A Δ D (steps.get u)
      (fullMixedOwnerOccurrence n S B A Δ D steps s p u).1
      (fullMixedOwnerOccurrence n S B A Δ D steps s p u).2) :
    (fullMixedChronologicalCoordinateEquiv n S B A Δ D steps s p ⟨u, c⟩).val =
      fullMixedOwnerCoordinateEmbedding n S B A Δ D steps u
        (fullMixedOwnerOccurrence n S B A Δ D steps s p u).1
        (fullMixedOwnerOccurrence n S B A Δ D steps s p u).2 c := rfl

theorem full_mixed_owner_coordinate_coverage
    (i : Fin (Fintype.card (FullMixedBirthAddress S B steps))) :
    (fullMixedPathBirthPerformed n S B A Δ D steps s p (fullMixedBirthOrder S B steps i) ∧
      fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i) = u) ↔
    ∃ c, fullMixedOwnerCoordinateEmbedding n S B A Δ D steps u
      (fullMixedOwnerOccurrence n S B A Δ D steps s p u).1
      (fullMixedOwnerOccurrence n S B A Δ D steps s p u).2 c = i := by
  constructor
  · rintro ⟨hi, hu⟩
    obtain ⟨c, hc⟩ := full_mixed_chronological_coordinate_owner_fiber n S B A Δ D steps s p u i hi hu
    exact ⟨c, hc⟩
  · rintro ⟨c, rfl⟩
    exact ⟨(fullMixedChronologicalCoordinateEquiv n S B A Δ D steps s p ⟨u, c⟩).property,
      full_mixed_owner_coordinate_owner n S B A Δ D steps u _ _ c⟩

theorem full_mixed_owner_coordinate_label
    (c : FullMixedEventBirthCoordinate n S B A Δ D (steps.get u)
      (fullMixedOwnerOccurrence n S B A Δ D steps s p u).1
      (fullMixedOwnerOccurrence n S B A Δ D steps s p u).2) :
    fullMixedPathBirthLabel n S B A Δ D steps s p
      (fullMixedBirthOrder S B steps (fullMixedOwnerCoordinateEmbedding n S B A Δ D steps u
        (fullMixedOwnerOccurrence n S B A Δ D steps s p u).1
        (fullMixedOwnerOccurrence n S B A Δ D steps s p u).2 c)) =
      some (fullMixedBornPrime n (fullMixedBirthCoordinateData n S B A Δ D (steps.get u)
        (fullMixedOwnerOccurrence n S B A Δ D steps s p u).1
        (fullMixedOwnerOccurrence n S B A Δ D steps s p u).2 c)) :=
  full_mixed_chronological_coordinate_label n S B A Δ D steps s p ⟨u, c⟩

end Path
end Bounty
