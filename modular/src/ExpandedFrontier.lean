/- Original common-window harmonic pairings from rational local energy and minor bounds. -/

open Finset MeasureTheory
open scoped Classical ComplexConjugate
namespace Bounty

theorem harmonic_cell_aux_local_energy_decay
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (k : ℤ)
    (bA : (∀ i : A, P i.val.1) → ℂ) (bB : (∀ i : B, P i.val.1) → ℂ)
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1/(p : ℝ) = V g)
    (hA : ∀ a, ‖bA a‖ ≤ 1) (hB : ∀ b, ‖bB b‖ ≤ 1)
    (Z a b v : ℝ) (F₀ G₀ : ℤ → ℂ) {L q K HA HB Y E D : ℝ}
    (hk : k ≠ 0) (hL : 5 ≤ L) (hq : 0 ≤ q) (hK : 0 ≤ K)
    (hkB : (k.natAbs : ℝ) ≤ L^K) (hHA : 0 < HA) (hHB : 0 < HB)
    (hY : 0 < Y) (hscale : L^q ≤ HA*HB)
    (hf : (∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellSource Y Z a v F₀ n‖^2) ≤ Y*L^E)
    (hg : (∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellTarget Y b G₀ n‖^2) ≤ Y*L^E)
    (hminor : ∀ θ, θ ∉ productMajorArcSet k L q HA HB →
      ‖physicalAuxFourierMultiplier P V A B hU hAB k bA bB θ‖ ≤ L^(-(D+E+1)))
    (hlocal : ∀ (r : ℕ), 0 < r → (r : ℝ) ≤ L^(K+q) → ∀ u : ℤ,
      (∫ x in Set.Icc
        ((u : ℝ)/r-1/(|(k : ℝ)| *(HA*HB)/L^q))
        ((u : ℝ)/r+1/(|(k : ℝ)| *(HA*HB)/L^q)),
        ‖finiteFourierSum (harmonicCommonSupport Y) (harmonicCellSource Y Z a v F₀) x‖^2) ≤ Y*L^(-((2*D+E+2)+2*q+K+1))) :
    ‖∑ aux : PhysicalAuxLabels P (repeatedBigAuxCut A B),
      (physicalAuxMass V (repeatedBigAuxCut A B) aux : ℂ)*
        bA (repeatedBigAuxSplitEquiv P A B hU hAB aux).1 *
        bB (repeatedBigAuxSplitEquiv P A B hU hAB aux).2 *
        harmonicCellPairing Y Z a b v
          (k*(∏ g, ∏ j : repeatedBigAuxCut A B g, (aux g j).val : ℕ)) F₀ G₀‖ ≤ Y*L^(-D) := by
  simp_rw [harmonic_cell_pairing_eq_masked_sum hY]
  exact physical_aux_shift_local_energy_decay P V A B hU hAB k bA bB hV hMass hA hB
    (harmonicCommonSupport Y) (harmonicCommonSupport Y)
    (harmonicCellSource Y Z a v F₀) (harmonicCellTarget Y b G₀)
    hk hL hq hK hkB hHA hHB hY.le hscale hf hg hminor hlocal

end Bounty
end

section

/- Polynomial source-frequency windows and exact enclosing-interval energy bounds. -/

open Filter MeasureTheory Real

namespace Bounty

theorem eventually_harmonic_source_frequency_window (A V r : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ a v u : ℝ,
      |a| ≤ L^A → |v| ≤ L^V → |u| ≤ L^r →
      |-(a+v) + 2*Real.pi*u| ≤ L^(max (max A V) r + 2) := by
  filter_upwards [eventually_harmonic_mellin_frequency_bound (max A V) r,
    eventually_ge_atTop (1 : ℝ)] with L hbound hL
  intro a v u ha hv hu
  have ha' : |a| ≤ L^(max A V) :=
    ha.trans (rpow_le_rpow_of_exponent_le hL (le_max_left _ _))
  have hv' : |v| ≤ L^(max A V) :=
    hv.trans (rpow_le_rpow_of_exponent_le hL (le_max_right _ _))
  have h := hbound a v (-u) ha' hv' (by simpa only [abs_neg] using hu)
  rw [show -(a+v+2*Real.pi*(-u)) = -(a+v)+2*Real.pi*u by ring] at h
  exact h.trans (rpow_le_rpow_of_exponent_le hL (by linarith))

theorem harmonic_frequency_shift_mem_Icc {T R w t : ℝ}
    (hTR : T + |w| ≤ R) (ht : t ∈ Set.Icc (-T) T) :
    t+w ∈ Set.Icc (-R) R := by
  constructor <;> linarith [ht.1, ht.2, neg_abs_le w, le_abs_self w]

theorem harmonic_shifted_energy_le_enclosing (P : ℝ → ℂ) (hP : Continuous P)
    {T R w : ℝ} (hTR : T + |w| ≤ R) :
    (∫ t in Set.Icc (-T) T, ‖P (t+w)‖^2) ≤
      ∫ s in Set.Icc (-R) R, ‖P s‖^2 := by
  by_cases hT : 0 ≤ T
  · have htranslate : (∫ t in Set.Icc (-T) T, ‖P (t+w)‖^2) =
        ∫ s in Set.Icc (-T+w) (T+w), ‖P s‖^2 := by
      calc
        _ = ∫ t in (-T)..T, ‖P (t+w)‖^2 := by
          rw [intervalIntegral.integral_of_le (by linarith), ← integral_Icc_eq_integral_Ioc]
        _ = ∫ s in (-T+w)..(T+w), ‖P s‖^2 :=
          intervalIntegral.integral_comp_add_right (fun s => ‖P s‖^2) w
        _ = _ := by
          rw [intervalIntegral.integral_of_le (by linarith), ← integral_Icc_eq_integral_Ioc]
    rw [htranslate]
    apply setIntegral_mono_set ((hP.norm.pow 2).integrableOn_Icc)
      (Filter.Eventually.of_forall (fun s => sq_nonneg ‖P s‖))
    apply Filter.Eventually.of_forall
    intro s hs
    have ht : s-w ∈ Set.Icc (-T) T := by constructor <;> linarith [hs.1, hs.2]
    have hmem := harmonic_frequency_shift_mem_Icc hTR ht
    constructor <;> linarith [hmem.1, hmem.2]
  · have hempty : Set.Icc (-T) T = ∅ := Set.Icc_eq_empty_of_lt (by linarith)
    rw [hempty, setIntegral_empty]
    exact integral_nonneg (fun s => sq_nonneg ‖P s‖)

end Bounty
end

section

/- The exact common-source Mellin energy is the normalized cutoff energy times Y squared. -/

open Finset MeasureTheory
namespace Bounty

theorem common_source_mellin_polynomial {Y Z : ℝ} (hY : 0 < Y) (hZ : 0 < Z)
    (a v t c : ℝ) (F : ℤ → ℂ) :
    (Y : ℂ)⁻¹ * localMellinPolynomial ((harmonicCommonSupport Y).image Int.natAbs)
      (fun n => harmonicCellSource Y Z a v F n * fourier (n : ℤ) (c : AddCircle (1 : ℝ))) t =
      physicalMellinPhase v Z * ∑ n ∈ (harmonicCommonSupport Y).image Int.natAbs,
        F n * ((harmonicCommonCutoff ((n : ℝ)/Y) : ℂ)/(n : ℂ)) *
          physicalMellinPhase (t-a-v) n *
          Complex.exp (Complex.I * (2*Real.pi*(c*n) : ℝ)) := by
  unfold localMellinPolynomial
  rw [mul_sum, mul_sum]
  apply sum_congr rfl
  intro n hn
  exact normalized_harmonic_source_factor hY hZ a v t c F
    (harmonic_common_natural_support_bound hY hn).1

theorem common_source_mellin_norm_sq {Y Z : ℝ} (hY : 0 < Y) (hZ : 0 < Z)
    (a v t c : ℝ) (F : ℤ → ℂ) :
    ‖localMellinPolynomial ((harmonicCommonSupport Y).image Int.natAbs)
      (fun n => harmonicCellSource Y Z a v F n * fourier (n : ℤ) (c : AddCircle (1 : ℝ))) t‖^2 =
      Y^2 * ‖∑ n ∈ (harmonicCommonSupport Y).image Int.natAbs,
        F n * ((harmonicCommonCutoff ((n : ℝ)/Y) : ℂ)/(n : ℂ)) *
          physicalMellinPhase (t-a-v) n *
          Complex.exp (Complex.I * (2*Real.pi*(c*n) : ℝ))‖^2 := by
  have hYC : (Y : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hY.ne'
  have he := congrArg (fun z : ℂ => ‖(Y : ℂ)*z‖^2)
    (common_source_mellin_polynomial hY hZ a v t c F)
  simpa only [← mul_assoc, mul_inv_cancel₀ hYC, one_mul, norm_mul,
    physical_mellin_phase_norm, mul_one, Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos hY, mul_pow] using he

theorem common_source_mellin_energy (μ : Measure ℝ)
    {Y Z : ℝ} (hY : 0 < Y) (hZ : 0 < Z) (a v c : ℝ) (F : ℤ → ℂ) :
    (∫ t, ‖localMellinPolynomial ((harmonicCommonSupport Y).image Int.natAbs)
      (fun n => harmonicCellSource Y Z a v F n * fourier (n : ℤ) (c : AddCircle (1 : ℝ))) t‖^2 ∂μ) =
      Y^2 * ∫ t, ‖∑ n ∈ (harmonicCommonSupport Y).image Int.natAbs,
        F n * ((harmonicCommonCutoff ((n : ℝ)/Y) : ℂ)/(n : ℂ)) *
          physicalMellinPhase (t-a-v) n *
          Complex.exp (Complex.I * (2*Real.pi*(c*n) : ℝ))‖^2 ∂μ := by
  simp_rw [common_source_mellin_norm_sq hY hZ a v _ c F]
  exact integral_const_mul _ _

end Bounty
end

section

/- A supported original root-pattern sum satisfies the finite-memory energy bound. -/

open Finset
namespace Bounty

section Sum
variable {I : Type*} {N J ell r B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g, ∀ p : ↥(P g), NeZero p.val]
  (V : Fin N → ℝ) (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
  (phase : ℕ → I → ℝ)
  (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
  (pattern : Fin (r + 1) → patterns) (k : ℕ → I → ℤ) (q : ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (ρ : ℝ)
  (S : Finset (PhysicalSelectedData P ell (fun j => C (pattern j).val)))
  (mask : PhysicalSelectedData P ell (fun j => C (pattern j).val) → ℂ)

theorem physical_selected_root_term_sum_bound
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 < β g p / V g) (hmass : ∀ g, ∑ p, β g p / V g ≤ 2)
    (hq0 : ∀ i : Fin (r + 2), 0 ≤ physicalEndpointSchedule q (r + 1) i.val) (hq1 : ∀ i : Fin (r + 2), physicalEndpointSchedule q (r + 1) i.val ≤ 1)
    (hD : ∀ i : Fin (r + 2), physicalEndpointSchedule q (r + 1) i.val / ρ ^ 2 + ((1 - physicalEndpointSchedule q (r + 1) i.val) / ρ) / v ≤ 1)
    (hC : ∀ (i : Fin (r + 2)) g, physicalEndpointSchedule q (r + 1) i.val / ρ ^ 2 + ((1 - physicalEndpointSchedule q (r + 1) i.val) * V g / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ j g, ell + (C (pattern j).val g).card ≤ T)
    (hmask : ∀ d ∈ S, ‖mask d‖ ≤ 1)
    (A : ℝ) (hA : 0 < A)
    (hK : ∀ d ∈ S, ∀ j : Fin (r + 1),
      ‖K (r - j.val) (pattern j).val
        (physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc))
        (physicalPermuteLabels (d.2.2.2 j) (d.2.1 j.succ)) (d.1 j)‖ ≤ A)
    (hpath : ∀ d : S, physicalRootNormalizablePath V patterns C phase k K
      ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d.val⟩).1
      ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d.val⟩).2)
    (hk : ∀ t < r + 1, ∀ i ∈ patterns, ∀ g p, p ∈ P g → ¬ (p : ℤ) ∣ k t i) :
    ‖(∑ d : S, mask d.val * physicalSelectedRootCappedTerm V patterns C q phase k K
      (fun p => β p.1 p.2) B pattern d.val)‖ ^ 2 ≤
      (A ^ (r + 1)) ^ 2 * (physicalMarkMass (J := J) (ell := ell) (fun g p => β g p / V g) *
        (physicalGhostUniformEnergyBound ρ vmax v ^ (N * (r + 2)) *
          unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ (N * (r + 1)) *
          ∏ g, (∑ p, β g p / V g) ^ (J + ell))) := by
  let path := fun d : S => (physicalPathSelectedEquiv patterns C).symm ⟨pattern, d.val⟩
  let a := fun d : S => physicalPathSelectedOffset C k (path d).1 (path d).2
  let ζ := fun d : S => Classical.choose (hpath d).2
  have he (d : S) : physicalPathSelectedEquiv patterns C (path d) = ⟨pattern, d.val⟩ :=
    Equiv.apply_symm_apply _ _
  have hstep (d : S) (j : Fin (r + 1)) : a d j.succ = a d j.castSucc +
      k (r - j.val) (pattern j).val *
        (physicalD (C (pattern j).val) (physicalPermuteLabels (d.val.2.2.1 j)
          (d.val.2.1 j.castSucc)) (d.val.1 j) : ℤ) := by
    have hh := physical_path_selected_offset_step C k (path d).1 (path d).2 j
    change a d j.succ = a d j.castSucc + _ at hh
    rw [show ((path d).1, (path d).2) = path d from Prod.eta _, he d] at hh
    simpa only [physicalPathSelectedMultiplier, path, physical_path_selected_inverse_step] using hh
  have hmarks (d : S) : ∀ j : Fin (r + 2), ∀ p ∈ physicalMarkedPrimes (d.val.2.1 j),
      ζ d p = -(a d j : ZMod p.2.val) := by
    have hh := physical_path_selected_marks_of_compatible C k (path d).1 (path d).2
      (ζ d) (Classical.choose_spec (hpath d).2)
    rw [show ((path d).1, (path d).2) = path d from Prod.eta _, he d] at hh
    exact hh
  have hlist (d : S) : ∀ j : Fin (r + 1), physicalListAdmissible (C (pattern j).val) (d.val.1 j)
      (physicalPermuteLabels (d.val.2.2.1 j) (d.val.2.1 j.castSucc))
      (physicalPermuteLabels (d.val.2.2.2 j) (d.val.2.1 j.succ)) := by
    have hh := physical_finite_return_scalar_selected_lists V patterns C phase k K
      (path d).1 (path d).2 (hpath d).1
    rw [show ((path d).1, (path d).2) = path d from Prod.eta _, he d] at hh
    exact hh
  have hkm (d : S) (j : Fin (r + 1)) (g : Fin N) (t : PhysicalSlots J ell) :
      ¬ ((d.val.2.1 j.castSucc g t).val : ℤ) ∣ k (r - j.val) (pattern j).val :=
    hk (r - j.val) (by omega) _ (pattern j).property g _ (d.val.2.1 j.castSucc g t).property
  have hb := physical_selected_memory_capped_sum_bound (B := B) V patterns C phase K pattern
    (fun j => k (r - j.val) (pattern j).val) β ρ
    (fun j => physicalEndpointSchedule q (r + 1) j.val) S mask
    hP hdis hMass hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass hq0 hq1 hD hC T ht
    hmask A hA hK a hstep ζ hmarks hlist hkm
  convert hb using 1
  congr 2
  apply sum_congr rfl
  intro d _
  simp only [physicalSelectedRootCappedTerm, a, path, mul_assoc]

end Sum
end Bounty
end

section

/- The coefficient phase forgets the ledger and acts on the original full event path. -/

open scoped Classical
namespace Bounty
section Full
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (cut : ℕ → Fin N → Finset (Fin J)) (ζ : Fin n → ℝ)
  (K : ∀ j, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C j) → ℂ)

noncomputable def physicalFullCoefficientPhase (tag : Option (Fin (n + 1) ⊕ Fin n))
    (x : PhysicalFullBoundedState P J ell B)
    (e : PhysicalFullLedgerEvent C k tag (fullActiveInitialLedger x, x)) : ℂ :=
  physicalLocalCoefficientPhase C k cut ζ K tag (fullActiveInitialLedger x, x) e

theorem physical_local_coefficient_forgets_ledger
    (tag : Option (Fin (n + 1) ⊕ Fin n))
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (e : PhysicalFullLedgerEvent C k tag s) :
    physicalLocalCoefficientPhase C k cut ζ K tag s e =
      physicalFullCoefficientPhase C k cut ζ K tag s.2 e := by
  cases tag with
  | none => rfl
  | some tag => cases tag <;> rfl

theorem physical_original_coefficient_full_phase
    (x : PhysicalFullBoundedState P J ell B)
    (p : FullPermutationMixedPath (fun g (p : ↥(P g)) => p.val)
      (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j))
      ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)) x) :
    physicalOriginalCoefficientPhase C k cut ζ K x p =
      finiteEventLocalPhase (FullPermutationMixedEvent (fun g (p : ↥(P g)) => p.val)
        (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
        (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j)))
        (fullPermutationMixedEventTarget (fun g (p : ↥(P g)) => p.val)
          (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
          (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j)))
        (physicalFullCoefficientPhase C k cut ζ K)
        ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)) x p := by
  let E := FullPermutationMixedEvent (J := Fin (n + 1)) (fun g (p : ↥(P g)) => p.val)
    (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
    (fun j => physicalFullEdgeDelta (ell := ell) (C j) (k j)) (fun j => physicalFullEdgeD (ell := ell) (C j))
  let target := fullPermutationMixedEventTarget (J := Fin (n + 1)) (fun g (p : ↥(P g)) => p.val)
    (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
    (fun j => physicalFullEdgeDelta (ell := ell) (C j) (k j)) (fun j => physicalFullEdgeD (ell := ell) (C j))
  let update := fullMixedLedgerUpdate (J := Fin (n + 1)) (fun g (p : ↥(P g)) => p.val)
    (fun j g => physicalFullSharedIndices (ell := ell) (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
    (fun j => physicalFullEdgeDelta (ell := ell) (C j) (k j)) (fun j => physicalFullEdgeD (ell := ell) (C j))
  let steps := (List.range (4 * n + 1)).map (physicalSelectedFineTag n)
  let lift := (finiteLedgerEventPathEquiv E target update steps (fullActiveInitialLedger x) x).symm p
  change finiteEventLocalPhase (fun tag (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val)
      (M := fun _ => J + ell) B) => E tag s.2)
    (finiteLedgerEventTarget E target update)
    (fun tag s e => physicalLocalCoefficientPhase C k cut ζ K tag s e)
    steps (fullActiveInitialLedger x, x) lift =
      finiteEventLocalPhase E target (physicalFullCoefficientPhase C k cut ζ K) steps x p
  simp_rw [physical_local_coefficient_forgets_ledger]
  exact (finite_ledger_event_local_phase E target update
    (fun tag y e => physicalFullCoefficientPhase C k cut ζ K tag y e)
    steps (fullActiveInitialLedger x) x lift).trans
      (congrArg (finiteEventLocalPhase E target (physicalFullCoefficientPhase C k cut ζ K) steps x)
        ((finiteLedgerEventPathEquiv E target update steps (fullActiveInitialLedger x) x).apply_symm_apply p))

end Full
end Bounty
end

section

/- Common cell and index thresholds for finitely many eventual component hypotheses. -/

open Filter

namespace Bounty

theorem finite_eventual_component_thresholds {ι : Type*} [Finite ι]
    (P : ι → ℝ → ℕ → ℝ → Prop)
    (hP : ∀ i, ∃ S₀ : ℝ, 0 ≤ S₀ ∧ ∀ S : ℝ, S₀ ≤ S →
      ∃ J : ℕ, ∀ j : ℕ, J < j → ∀ᶠ L : ℝ in atTop, P i S j L) :
    ∃ S₀ : ℝ, 0 ≤ S₀ ∧ ∀ S : ℝ, S₀ ≤ S →
      ∃ J : ℕ, ∀ j : ℕ, J < j → ∀ᶠ L : ℝ in atTop, ∀ i, P i S j L := by
  choose s hs h using hP
  obtain ⟨S₁,hS₁⟩ := Finite.exists_le s
  refine ⟨max 0 S₁, le_max_left _ _, ?_⟩
  intro S hS
  have hall (i : ι) := h i S ((hS₁ i).trans ((le_max_right _ _).trans hS))
  choose j hj using hall
  obtain ⟨J,hJ⟩ := Finite.exists_le j
  refine ⟨J, ?_⟩
  intro n hn
  exact Filter.eventually_all.mpr (fun i => hj i n ((hJ i).trans_lt hn))

/-- Separate large-cell-exponent analytic hypotheses; no component bound is
asserted here. Thresholds may initially depend on the component. -/
def CandidateAmbientLargeSComponentBounds : Prop :=
  ∀ (c q : ℝ) (r : ℕ), 0<c → 0<r → 0≤q → q<1 →
    (11/5 : ℝ)*(r : ℝ)*c=1 →
    ∀ (κ b : ℝ) (N : ℕ), 0<κ → κ≤1/50 → 0<b → b<1/2-κ → 0<N →
      (∀ i : Fin N, ∃ S₀ : ℝ, 0≤S₀ ∧ ∀ S : ℝ, S₀≤S →
        ∃ J : ℕ, ∀ jStar : ℕ, J<jStar → ∀ᶠ L : ℝ in atTop,
          |ambientRoughProxyError (arithmeticProductWindow 1 (Real.exp L))
            (candidateCoefficient c L q r jStar) (reciprocalGrid b (1/2-κ) N i) L S
            (Real.exp (reciprocalGrid b (1/2-κ) N i*L))
            (Real.exp (reciprocalGrid b (1/2-κ) N ((i : ℕ)+1)*L))| ≤
              candidateCoefficientWindowMass c L q r jStar*L^(-2 : ℝ)) ∧
      (∃ S₀ : ℝ, 0≤S₀ ∧ ∀ S : ℝ, S₀≤S →
        ∃ J : ℕ, ∀ jStar : ℕ, J<jStar → ∀ᶠ L : ℝ in atTop,
          |ambientPrimeProxyError (arithmeticProductWindow 1 (Real.exp L))
            (candidateCoefficient c L q r jStar) κ L S| ≤
              candidateCoefficientWindowMass c L q r jStar*L^(-2 : ℝ))

theorem candidate_ambient_components_of_large_s_bounds
    (hlarge : CandidateAmbientLargeSComponentBounds) : CandidateAmbientComponentBounds := by
  intro c q r hc hr hq0 hq1 hcenter κ b N hκ hκmax hb hbq hN
  obtain ⟨hrough,hprime⟩ := hlarge c q r hc hr hq0 hq1 hcenter κ b N hκ hκmax hb hbq hN
  let P : Option (Fin N) → ℝ → ℕ → ℝ → Prop := fun i S j L =>
    match i with
    | none => |ambientPrimeProxyError (arithmeticProductWindow 1 (Real.exp L))
        (candidateCoefficient c L q r j) κ L S| ≤ candidateCoefficientWindowMass c L q r j*L^(-2 : ℝ)
    | some i => |ambientRoughProxyError (arithmeticProductWindow 1 (Real.exp L))
        (candidateCoefficient c L q r j) (reciprocalGrid b (1/2-κ) N i) L S
        (Real.exp (reciprocalGrid b (1/2-κ) N i*L))
        (Real.exp (reciprocalGrid b (1/2-κ) N ((i : ℕ)+1)*L))| ≤
          candidateCoefficientWindowMass c L q r j*L^(-2 : ℝ)
  have hall : ∀ i, ∃ S₀ : ℝ, 0 ≤ S₀ ∧ ∀ S : ℝ, S₀ ≤ S →
      ∃ J : ℕ, ∀ j : ℕ, J < j → ∀ᶠ L : ℝ in atTop, P i S j L := by
    intro i
    cases i with
    | none => exact hprime
    | some i => exact hrough i
  obtain ⟨S,hS,hallS⟩ := finite_eventual_component_thresholds P hall
  obtain ⟨J,hJ⟩ := hallS S le_rfl
  refine ⟨S,hS,J,?_⟩
  intro j hj
  have hev := hJ j hj
  exact ⟨fun i => hev.mono (fun L hL => hL (some i)), hev.mono (fun L hL => hL none)⟩

theorem candidate_ambient_replacement_of_large_s_component_bounds
    (hlarge : CandidateAmbientLargeSComponentBounds) : CandidateAmbientReplacement :=
  candidate_ambient_replacement_of_component_bounds (candidate_ambient_components_of_large_s_bounds hlarge)

end Bounty
end

section

/- The complete mixed word is a sum of original full big-memory path actions.
All small factors, residues, and arbitrary coupled coefficients remain in the
pulled-back path phase. No measure normalization is inserted. -/

open Finset
open scoped Classical
namespace Bounty
section Sum
variable {S G I V K : Type} [Fintype S] [Fintype G] [DecidableEq G] [Fintype I]
  {Ps : S → Finset ℕ} {P : G → Type} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] {J ell : ℕ} {M : G → ℕ}
  (shared : I → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : I → Type) [∀ i, Fintype (A i)]
  (Δ D : ∀ _k : K, ∀ i, PhysicalSharedLists Ps J → SharedActiveLabels P (shared i) → A i → G → ℤ)
  (kbig : ∀ _k : K, ∀ i, SharedActiveLabels P (shared i) → A i → ℤ)
  (ω : ∀ i, SharedActiveLabels P (shared i) → A i → ℝ)
  (μ : ∀ g, P g → ℝ) (qghost : V → ℝ) (ρ : ℝ) (Vb : G → ℝ)
  (Vs : S → ℝ) (qedge : K → ℝ)

theorem physical_mixed_paths_eq_original_big_paths (ks : List (Option (V ⊕ K)))
    (phase : ∀ s, FiniteEventPath (PhysicalMixedWordEvent (ell := ell) n shared B A Δ D)
      (physicalMixedWordTarget n shared B A Δ D kbig) ks s → ℂ)
    (F : PhysicalMixedWordState (Ps := Ps) (J := J) (ell := ell) (M := M) n B → ℂ) r L x :
    let _ := physicalMixedSmallPlanFintype (Ps := Ps) (J := J) (ell := ell) (I := I) ks
    physicalMixedWordPathAction n shared B A Δ D kbig ω μ qghost ρ Vb Vs qedge ks phase F ((r, L), x) =
    ∑ pl : PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) ks,
      physicalMixedPlannedBigAction n shared B A Δ D ω μ qghost ρ Vb ks L pl
        (fun y p =>
          (physicalMixedPlanSmallFactor n shared B A Δ D kbig Vs qedge ks r L pl y p : ℂ) *
          phase ((r, L), y) (physicalMixedPathPack n shared B A Δ D kbig ks r L y ⟨pl, p⟩) *
          F (finiteEventPathTerminal (PhysicalMixedWordEvent n shared B A Δ D)
            (physicalMixedWordTarget n shared B A Δ D kbig) ks ((r, L), y)
            (physicalMixedPathPack n shared B A Δ D kbig ks r L y ⟨pl, p⟩))) (fun _ => 1) x := by
  let _ := physicalMixedSmallPlanFintype (Ps := Ps) (J := J) (ell := ell) (I := I) ks
  let _ : ∀ pl : PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) ks,
      Fintype (PhysicalMixedPlannedBigPath n shared B A Δ D ks L pl x) :=
    fun pl => physicalMixedPlannedBigPathFintype n shared B A Δ D ks L pl x
  let _ : ∀ tag s, Fintype (PhysicalMixedWordEvent (V := V) (ell := ell) n shared B A Δ D tag s) :=
    physicalMixedWordEventFintype n shared B A Δ D
  let _ := finiteEventPathFintype (PhysicalMixedWordEvent (ell := ell) n shared B A Δ D)
    (physicalMixedWordTarget n shared B A Δ D kbig) ks ((r, L), x)
  unfold physicalMixedWordPathAction finiteEventPathAction
  rw [← (physicalMixedPathPackingEquiv n shared B A Δ D kbig ks r L x).symm.sum_comp]
  rw [Fintype.sum_sigma]
  apply sum_congr rfl
  intro pl _
  unfold physicalMixedPlannedBigAction fullPermutationMixedPathAction finiteEventPathAction
  apply sum_congr
  · exact congrArg (fun inst : Fintype _ => @Finset.univ _ inst) (Subsingleton.elim _ _)
  · intro p _
    change ((finiteEventPathWeight _ _ _ ks ((r, L), x)
      (physicalMixedPathPack n shared B A Δ D kbig ks r L x ⟨pl, p⟩) : ℝ) : ℂ) * _ * _ = _
    rw [physical_mixed_planned_weight_factor]
    change ((physicalMixedPlanSmallFactor n shared B A Δ D kbig Vs qedge ks r L pl x p *
      physicalMixedPlannedBigWeight n shared B A Δ D ω μ qghost ρ Vb ks L pl x p : ℝ) : ℂ) * _ * _ =
      (physicalMixedPlannedBigWeight n shared B A Δ D ω μ qghost ρ Vb ks L pl x p : ℂ) * _ * 1
    simp only [Complex.ofReal_mul]
    ring_nf
    rfl

theorem physical_mixed_word_eq_original_big_paths (ks : List (Option (V ⊕ K)))
    (phase : ∀ tag s, PhysicalMixedWordEvent (ell := ell) n shared B A Δ D tag s → ℂ)
    (F : PhysicalMixedWordState (Ps := Ps) (J := J) (ell := ell) (M := M) n B → ℂ) r L x :
    let _ := physicalMixedSmallPlanFintype (Ps := Ps) (J := J) (ell := ell) (I := I) ks
    finiteOperatorListAction
      (physicalMixedWordRow n shared B A Δ D kbig ω μ qghost ρ Vb Vs qedge phase) ks F ((r, L), x) =
    ∑ pl : PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) ks,
      physicalMixedPlannedBigAction n shared B A Δ D ω μ qghost ρ Vb ks L pl
        (fun y p =>
          (physicalMixedPlanSmallFactor n shared B A Δ D kbig Vs qedge ks r L pl y p : ℂ) *
          finiteEventLocalPhase (PhysicalMixedWordEvent n shared B A Δ D)
            (physicalMixedWordTarget n shared B A Δ D kbig) phase ks ((r, L), y)
            (physicalMixedPathPack n shared B A Δ D kbig ks r L y ⟨pl, p⟩) *
          F (finiteEventPathTerminal (PhysicalMixedWordEvent n shared B A Δ D)
            (physicalMixedWordTarget n shared B A Δ D kbig) ks ((r, L), y)
            (physicalMixedPathPack n shared B A Δ D kbig ks r L y ⟨pl, p⟩))) (fun _ => 1) x := by
  rw [physical_mixed_word_eq_paths]
  exact physical_mixed_paths_eq_original_big_paths n shared B A Δ D kbig ω μ qghost ρ Vb Vs qedge ks _ F r L x

end Sum
end Bounty
end

section

/- The packed mixed word uses the literal original physical big-event path family. -/

open scoped Classical
namespace Bounty
section Planned
variable {S I V K : Type} [Fintype S] {N J ell : ℕ}
  {Ps : S → Finset ℕ} {P : Fin N → Finset ℕ}
  [∀ g, ∀ p : ↥(P g), NeZero p.val]
  (hPs : ∀ s p, p ∈ Ps s → Nat.Prime p)
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : ∀ s g, Disjoint (Ps s) (P g))
  (C : I → Fin N → Finset (Fin J)) (k : K → I → ℤ) (B : ℕ)
  (ω : ∀ i, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C i g)) → PhysicalAuxLabels P (C i) → ℝ)
  (μ : ∀ g, ↥(P g) → ℝ) (q : V → ℝ) (ρ : ℝ) (Vb : Fin N → ℝ)

theorem physical_mixed_planned_effective_action
    (ks : List (Option (V ⊕ K))) (L : PhysicalMarkLists Ps J ell)
    (pl : PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) ks)
    (phase : ∀ x, PhysicalMixedPlannedBigPath (fun g (p : ↥(P g)) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i => PhysicalAuxLabels P (C i))
      (fun t i => physicalMixedEdgeDelta (C i) (k t i))
      (fun _ i => physicalMixedEdgeD (C i)) ks L pl x → ℂ)
    (f : PhysicalFullBoundedState P J ell B → ℂ) :
    physicalMixedPlannedBigAction (fun g (p : ↥(P g)) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i => PhysicalAuxLabels P (C i))
      (fun t i => physicalMixedEdgeDelta (C i) (k t i))
      (fun _ i => physicalMixedEdgeD (C i)) ω μ q ρ Vb ks L pl phase f =
    let Cb := fun key : PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K) => C key.2.1
    let db := fun key : PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K) => physicalSharedPrefix key.2.2.1
    let kb := fun key : PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K) => k key.1 key.2.1
    let steps := physicalMixedBigSteps ks L pl
    fullPermutationMixedPathAction (fun g (p : ↥(P g)) => p.val)
      (fun key g => physicalFullSharedIndices (ell := ell) (Cb key g)) B
      (fun key _ => PhysicalAuxLabels P (Cb key))
      (fun key => physicalFullEdgeDelta (Cb key) (kb key * (physicalSharedProduct (db key) : ℕ)))
      (fun key => physicalFullEdgeD (Cb key)) (fun key => ω key.2.1) μ q ρ Vb steps
      (fun x p => phase x ((physicalMixedEffectiveBigPathEquiv hPs hP hdis Cb db kb B steps x).symm p)) f := by
  exact physical_mixed_effective_big_path_action hPs hP hdis
    (fun key : PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K) => C key.2.1)
    (fun key => physicalSharedPrefix key.2.2.1) (fun key => k key.1 key.2.1) B
    (fun key => ω key.2.1) μ q ρ Vb (physicalMixedBigSteps ks L pl) phase f

end Planned
end Bounty
end

section

/- A single pattern sequence remains shared with arbitrary coupled big data. -/

open scoped Classical
namespace Bounty

variable {S I : Type} {Ps : S → Finset ℕ} {J ell n : ℕ}

noncomputable def physicalSmallSelectedCoupledEquiv (C : I → S → Finset (Fin J))
    (hC : ∀ i g, C i g = ∅) (B : (Fin n → I) → Type) :
    (Σ i : Fin n → I, PhysicalGroupSelectedData Ps ell (fun j => C (i j)) × B i) ≃
    (Σ p : PhysicalMarkLists Ps J ell ×
      PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I)
        ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)),
      B (((physicalSmallSelectedPlanEquiv C hC).symm p).1)) :=
  ({ toFun := fun d => ⟨⟨d.1, d.2.1⟩, d.2.2⟩
     invFun := fun d => ⟨d.1.1, d.1.2, d.2⟩
     left_inv := by rintro ⟨_, _, _⟩; rfl
     right_inv := by rintro ⟨⟨_, _⟩, _⟩; rfl } :
    (Σ i : Fin n → I, PhysicalGroupSelectedData Ps ell (fun j => C (i j)) × B i) ≃
      (Σ d : PhysicalSmallSelectedChoices Ps ell n C, B d.1)).trans
    (Equiv.sigmaCongrLeft' (physicalSmallSelectedPlanEquiv C hC))

noncomputable def physicalPathSmallPlanEquiv
    {N : ℕ} {P : Fin N → Finset ℕ} (small : Fin N → Prop)
    (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
    (hC : ∀ i : patterns, ∀ g : {g // small g}, C i.val g.val = ∅) :
    (PhysicalMarkLists P J ell ×
      (Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)) ≃
    (Σ p : PhysicalMarkLists (fun g : {g // small g} => P g.val) J ell ×
      PhysicalMixedSmallPlan (Ps := fun g : {g // small g} => P g.val)
        (J := J) (ell := ell) (I := patterns)
        ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)),
      PhysicalGroupSelectedData (fun g : {g // ¬small g} => P g.val) ell
        (fun j g => C ((((physicalSmallSelectedPlanEquiv
          (fun (i : patterns) (g : {g // small g}) => C i.val g.val) hC).symm p).1 j).val)
          g.val)) :=
  (physicalPathGroupSplitEquiv small patterns C).trans
    (physicalSmallSelectedCoupledEquiv
      (fun (i : patterns) (g : {g // small g}) => C i.val g.val) hC
      (fun i => PhysicalGroupSelectedData (fun g : {g // ¬small g} => P g.val) ell
        (fun j g => C (i j).val g.val)))

end Bounty
end

section

/- The decoded big schedule is the original fine word with its selected endpoints. -/

namespace Bounty

variable {S I V K : Type} {Ps : S → Finset ℕ} {J ell : ℕ}

theorem physical_mixed_big_steps_cast {ks ks' : List (Option (V ⊕ K))}
    (h : ks = ks') (L : PhysicalMarkLists Ps J ell)
    (p : PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) ks) :
    physicalMixedBigSteps ks' L
      (cast (congrArg (PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I)) h) p) =
      physicalMixedBigSteps ks L p := by
  subst ks'
  rfl

theorem physical_block_fine_steps_map {V' K' : Type}
    (bs : List (V × K)) (last : V) (f : V → V') (g : K → K') :
    (physicalBlockFineSteps bs last).map (Option.map (Sum.map f g)) =
      physicalBlockFineSteps (bs.map (fun b => (f b.1, g b.2))) (f last) := by
  simp [physicalBlockFineSteps, List.map_flatMap, List.flatMap_map]

theorem physical_small_selected_arrays_cast {m n : ℕ} (h : m = n)
    (d : PhysicalSmallSelectedArrays Ps J ell m I) :
    cast (congrArg (fun n => PhysicalSmallSelectedArrays Ps J ell n I) h) d =
      ((fun j => d.1 (Fin.cast h.symm j)),
        (fun j => d.2.1 (Fin.cast (congrArg (fun n => n + 1) h.symm) j)),
        (fun j => d.2.2.1 (Fin.cast h.symm j)),
        (fun j => d.2.2.2 (Fin.cast h.symm j))) := by
  subst n
  rfl

theorem physical_small_selected_fine_initial {n : ℕ}
    (d : PhysicalSmallSelectedArrays Ps J ell n I) :
    (physicalSmallSelectedFinePlanEquiv d).1 = d.2.1 0 := by
  simp only [physicalSmallSelectedFinePlanEquiv, physicalSmallSelectedBlockPlanEquiv,
    physicalSmallSelectedBlockEquiv, Equiv.trans_apply, Equiv.prodCongr_apply,
    Equiv.cast_apply, Equiv.coe_fn_mk, Prod.map_fst, Equiv.refl_apply]
  have hlen : n = (List.ofFn (fun j : Fin n => (j.castSucc, j))).length := by simp
  rw [physical_small_selected_arrays_cast hlen d]
  rfl

theorem physical_small_selected_fine_big_steps {n : ℕ}
    (d : PhysicalSmallSelectedArrays Ps J ell n I) :
    physicalMixedBigSteps ((List.range (4 * n + 1)).map (physicalSelectedFineTag n))
      (physicalSmallSelectedFinePlanEquiv d).1 (physicalSmallSelectedFinePlanEquiv d).2 =
      ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)).map
        (Option.map (Sum.map id (fun j =>
          (j, d.1 j, physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc),
            physicalPermuteLabels (d.2.2.2 j) (d.2.1 j.succ))))) := by
  rw [physical_small_selected_fine_initial]
  simp only [physicalSmallSelectedFinePlanEquiv, Equiv.trans_apply, Equiv.prodCongr_apply,
    Equiv.cast_apply, physicalSmallSelectedBlockPlanEquiv, physicalSmallSelectedBlockEquiv,
    physicalSmallBlockPlanEquiv, Equiv.coe_fn_mk, Prod.map_snd]
  have hlen : n = (List.ofFn (fun j : Fin n => (j.castSucc, j))).length := by simp
  rw [physical_small_selected_arrays_cast hlen d]
  rw [physical_mixed_big_steps_cast (physical_selected_fine_block_schedule n).symm]
  refine (physical_selected_big_block_schedule (Fin.last n)
    (List.ofFn (fun j : Fin n => (j.castSucc, j)))
    (fun j => d.1 (Fin.cast hlen.symm j))
    (fun j => d.2.1 (Fin.cast (congrArg (fun n => n + 1) hlen.symm) j))
    (fun j => d.2.2.1 (Fin.cast hlen.symm j))
    (fun j => d.2.2.2 (Fin.cast hlen.symm j))).trans ?_
  rw [physical_selected_fine_block_schedule, physical_block_fine_steps_map]
  simp only [List.map_ofFn, List.get_ofFn, id_eq]
  exact congrArg (fun bs => physicalBlockFineSteps bs (Fin.last n))
    (List.ofFn_congr hlen (fun j : Fin n => (j.castSucc,
      (j, d.1 j, physicalPermuteLabels (d.2.2.1 j) (d.2.1 j.castSucc),
        physicalPermuteLabels (d.2.2.2 j) (d.2.1 j.succ))))).symm

end Bounty
end

section

/- Exact finite spatial decomposition and harmonic normalization of cross endpoints. -/

open Finset

namespace Bounty

theorem typeII_cross_slice_sum_singletons (M H Zs : Finset ℕ) (k : ℤ)
    (W : TypeIIShiftIndex → ℂ) (hM : ∀ m ∈ M, 0 < m) (hk : k ≠ 0) :
    (∑ y ∈ typeIICrossSlice M H Zs k, W y) =
      ∑ z ∈ Zs, ∑ y ∈ typeIICrossSlice M H {z} k, W y := by
  rw [typeII_cross_slice_sum_reindex M H Zs k W hM hk]
  apply sum_congr rfl
  intro z hz
  rw [typeII_cross_slice_sum_reindex M H {z} k W hM hk, sum_singleton]

theorem typeII_character_cross_fourier_sum_singletons
    (A L U V E Z : ℝ) (k : ℤ) (M H Zs : Finset ℕ)
    (ψ : ℝ → ℝ) (α aH : ℕ → ℂ) (χ : DirichletCharacter ℂ (2*k.natAbs))
    (hM : ∀ m ∈ M, 0 < m) (hk : k ≠ 0) (ξ : EuclideanSpace ℝ (Fin 3)) :
    typeIICrossCharacterFourierIntegrand A L U V E Z k M H Zs ψ α aH χ ξ =
      ∑ z ∈ Zs,
        typeIICrossCharacterFourierIntegrand A L U V E Z k M H {z} ψ α aH χ ξ := by
  unfold typeIICrossCharacterFourierIntegrand typeIIFiniteCrossFourierIntegrand
  rw [typeII_cross_slice_sum_singletons M H Zs k _ hM hk, mul_sum]

theorem typeII_character_cross_fourier_eq_harmonic_cross_pairs
    (A L U V E Z : ℝ) (k : ℤ) (M H Zs : Finset ℕ)
    (α : ℕ → ℂ) (W : ℕ → ℝ) (B : ℕ → ℂ) (ρ : ℝ)
    (χ : DirichletCharacter ℂ (2*k.natAbs))
    (hM : ∀ m ∈ M, 0 < m) (hk : k ≠ 0) (hZ : 0 < Z)
    (hpos : ∀ z ∈ Zs, 0 < z ∧ 0 < (z : ℤ)+k)
    (ξ : EuclideanSpace ℝ (Fin 3)) :
    typeIICrossCharacterFourierIntegrand A L U V E Z k M H Zs
        typeIISmoothDyadic α (typeIISeparatedH W B ρ) χ ξ =
      typeIICrossFourierScale A L U V E Z k ξ * (Z : ℂ) *
        ∑ z ∈ Zs, ((typeIIHarmonicDyadic ((z : ℝ)/Z)/(z : ℝ) : ℝ) : ℂ) *
          typeIICrossPairCoefficient M H
            (fun m => α m * χ (m : ZMod (2*k.natAbs))) W B ρ
            (2*Real.pi*ξ 0) (2*Real.pi*ξ 1) (2*Real.pi*ξ 2) z
            ((z : ℤ)+k).toNat := by
  rw [typeII_character_cross_fourier_sum_singletons A L U V E Z k M H Zs
    typeIISmoothDyadic α (typeIISeparatedH W B ρ) χ hM hk ξ]
  calc
    _ = ∑ z ∈ Zs, typeIICrossFourierScale A L U V E Z k ξ *
        ((typeIISmoothDyadic ((z : ℝ)/Z) : ℂ) *
          typeIICrossPairCoefficient M H
            (fun m => α m * χ (m : ZMod (2*k.natAbs))) W B ρ
            (2*Real.pi*ξ 0) (2*Real.pi*ξ 1) (2*Real.pi*ξ 2) z
            ((z : ℤ)+k).toNat) := by
      apply sum_congr rfl
      intro z hz
      exact typeII_character_cross_fourier_singleton_eq A L U V E Z k M H z
        ((z : ℤ)+k).toNat typeIISmoothDyadic α W B ρ χ hM hk
        (Int.toNat_of_nonneg (hpos z hz).2.le).symm ξ
    _ = _ := by
      rw [← mul_sum, typeII_finite_harmonic_normalization Zs hZ typeIISmoothDyadic
        _ (fun z hz => (hpos z hz).1)]
      simp only [typeIIHarmonicDyadic, mul_assoc]


end Bounty
