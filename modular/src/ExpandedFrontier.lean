section

/- Exact candidate assembly over row, column, and conductor dyads. -/

open Finset Filter

namespace Bounty

noncomputable def candidateRemainderCharacterVector (c L q : ℝ) (r jStar : ℕ)
    (hr : 0 < r) (h p n : ℕ) : (f : ℕ) → DirichletCharacter ℂ f → ℂ := by
  classical
  exact fun f χ =>
    if Real.exp L < (p * n : ℕ) ∧ (p * n : ℕ) ≤ 16 * Real.exp L then
      (if p.Coprime h then (1 : ℂ) else 0) *
        (if n.Coprime h then
          (candidateRemainderCoefficient c L q r jStar hr n : ℂ) else 0) *
        χ ((p * n : ℕ) : ZMod f)
    else 0

theorem candidate_large_mass_le_dyadic_blocks {c L : ℝ} (hcL : 0 ≤ c * L)
    (q : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : 0 < jStar) (N R : ℕ)
    {X H B : ℝ} (hX : 1 ≤ X) (hNX : (N : ℝ) ≤ X) (hH : 0 ≤ H) (hB : 0 ≤ B)
    (hcount : ∀ h ∈ (Icc 1 N).filter Squarefree,
      ((dyadicNatIndices (Icc (max 2 (R + 1)) (N / h))).card : ℝ) ≤ H)
    (hblock : ∀ h ∈ (Icc 1 N).filter Squarefree,
      ∀ k ∈ dyadicNatIndices (Icc (max 2 (R + 1)) (N / h)),
      ∀ i ∈ dyadicNatIndices (candidateQBand (c * L) 0),
      ∀ j ∈ dyadicNatIndices (Icc 1 ⌊16 * Real.exp L⌋₊),
      primitiveCharacterBlockNorm (dyadicNatBucket (Icc (max 2 (R + 1)) (N / h)) k)
        (∑ p ∈ dyadicNatBucket (candidateQBand (c * L) 0) i,
          ∑ n ∈ dyadicNatBucket (Icc 1 ⌊16 * Real.exp L⌋₊) j,
            candidateRemainderCharacterVector c L q r jStar hr h p n) ≤ B) :
    candidateLargePrimitiveTypeIMass c L q r jStar N R ≤
      ((2 * primeEulerProductUpperConstant) * Real.log (2 * X)) * H *
        (dyadicNatIndices (candidateQBand (c * L) 0)).card *
        (dyadicNatIndices (Icc 1 ⌊16 * Real.exp L⌋₊)).card * B := by
  classical
  let CS : ℝ := (dyadicNatIndices (candidateQBand (c * L) 0)).card
  let CT : ℝ := (dyadicNatIndices (Icc 1 ⌊16 * Real.exp L⌋₊)).card
  have hY : 0 ≤ H * CS * CT * B := by dsimp [CS, CT]; positivity
  have hbound : ∀ h ∈ (Icc 1 N).filter Squarefree,
      (∑ f ∈ Icc (max 2 (R + 1)) (N / h),
        complementaryConductorNormTerm f h (arithmeticProductWindow 1 (Real.exp L))
          (fun u => (candidateCoefficient c L q r jStar u : ℂ)) (fun u => u) /
            (f.totient : ℝ)) ≤ H * CS * CT * B := by
    intro h hh
    let Q := Icc (max 2 (R + 1)) (N / h)
    let F := candidateRemainderCharacterVector c L q r jStar hr h
    have hcomp := complementary_conductor_sum_le_character_blockNorm Q h
      (arithmeticProductWindow 1 (Real.exp L))
      (fun u => (candidateCoefficient c L q r jStar u : ℂ)) (fun u => u)
      (∑ p ∈ candidateQBand (c * L) 0, ∑ n ∈ Icc 1 ⌊16 * Real.exp L⌋₊, F p n)
      (by
        intro f hf χ
        simpa only [Finset.sum_apply, F, candidateRemainderCharacterVector] using
          candidate_prime_remainder_character_positive_cutoff hcL q r jStar hr hj χ h)
    have hdyad := primitiveCharacterBlockNorm_le_dyadic_blocks Q
      (candidateQBand (c * L) 0) (Icc 1 ⌊16 * Real.exp L⌋₊) F (hblock h hh)
    apply hcomp.trans (hdyad.trans _)
    change ((dyadicNatIndices Q).card : ℝ) * CS * CT * B ≤ H * CS * CT * B
    exact mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right (hcount h hh) (by dsimp [CS]; positivity))
        (by dsimp [CT]; positivity)) hB
  have h := candidate_large_mass_le_uniform_complementary c L q r jStar N R hX hNX hY hbound
  convert h using 1
  dsimp [CS, CT]
  ring


end Bounty
end

section

/- The active phase depends only on the shared, target, and source tuples. -/

open Finset
open scoped Classical

namespace Bounty

theorem finite_active_value_three_partition {I M : Type*} [DecidableEq I] [CommMonoid M]
    (v : I → M) (active A B : Finset I) (hA : A ⊆ active) (hB : B ⊆ active)
    (hAB : Disjoint A B) :
    (∏ i ∈ active, v i) = (∏ i : ↥(active \ (A ∪ B)), v i.1) *
      (∏ i : A, v i.1) * ∏ i : B, v i.1 := by
  rw [prod_coe_sort (active \ (A ∪ B)) v, prod_coe_sort A v, prod_coe_sort B v,
    ← prod_sdiff (union_subset hA hB), prod_union hAB, mul_assoc]

theorem finite_active_product_restrict {I M : Type*} [DecidableEq I] [CommMonoid M]
    {X : I → Type*} (v : ∀ i, X i → M) (active A B : Finset I)
    (hA : A ⊆ active) (hB : B ⊆ active) (hAB : Disjoint A B) (x : ∀ i, X i) :
    (∏ i ∈ active, v i (x i)) =
      (∏ i : ↥(active \ (A ∪ B)),
        v i.1 (finiteCoordinateRestrict (active \ (A ∪ B)) x i)) *
      (∏ i : A, v i.1 (finiteCoordinateRestrict A x i)) *
      ∏ i : B, v i.1 (finiteCoordinateRestrict B x i) :=
  finite_active_value_three_partition (fun i => v i (x i)) active A B hA hB hAB

theorem prime_active_phase_three_partition {I : Type*} [DecidableEq I]
    (P : I → Finset ℕ) (active A B : Finset I)
    (hA : A ⊆ active) (hB : B ⊆ active) (hAB : Disjoint A B)
    (ζ Θ : ℝ) (x : ∀ i, P i) :
    primeActivePhase P active ζ Θ x = primeTuplePhase ζ Θ
      ((∏ i : ↥(active \ (A ∪ B)), (finiteCoordinateRestrict (active \ (A ∪ B)) x i).val) *
        (∏ i : A, (finiteCoordinateRestrict A x i).val) *
        ∏ i : B, (finiteCoordinateRestrict B x i).val) := by
  unfold primeActivePhase
  congr 1
  exact finite_active_product_restrict (fun _ p => p.val) active A B hA hB hAB x

end Bounty
end

section

/- Bounded physical memory decodes to the original joint raw state. The
local zero extension is invisible behind the existing total output cutoff. -/

open Finset
open scoped Classical
namespace Bounty

def physicalMarkRawReadout {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (s : PhysicalBoundedMarkState P J ell B) :
    GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) :=
  fun g => (s.2.1 g, boundedOrderedTupleToFinite (s.2.2 g))

theorem global_birth_joint_local_length_le_total {N : ℕ} {P : Fin N → Type*}
    {R : (g : Fin N) → P g → Type*} (s : GlobalBirthJointState R) (g : Fin N) :
    (s g).2.1 ≤ globalBirthJointLength s :=
  Finset.single_le_sum (fun i _ => Nat.zero_le (s i).2.1) (Finset.mem_univ g)

theorem physical_mark_raw_extension_readout {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (R : PhysicalMarkLists P J ell)
    (F : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ)
    (s : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val))
    (hs : ∀ g, (s g).2.1 ≤ B) :
    physicalMarkRawExtension (B := B) (F ∘ physicalMarkRawReadout) R s = F s := by
  unfold physicalMarkRawExtension
  rw [dif_pos hs]
  rfl

theorem physical_mark_raw_readout_cutoff {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (R : PhysicalMarkLists P J ell)
    (F : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ) :
    globalBirthJointRawCutoff B (physicalMarkRawExtension (B := B) (F ∘ physicalMarkRawReadout) R) =
      globalBirthJointRawCutoff B F := by
  funext s
  unfold globalBirthJointRawCutoff
  by_cases hs : globalBirthJointLength s ≤ B
  · rw [if_pos hs, if_pos hs, physical_mark_raw_extension_readout]
    exact fun g => (global_birth_joint_local_length_le_total s g).trans hs
  · rw [if_neg hs, if_neg hs]

theorem physical_mark_raw_tensor_readout {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (R : PhysicalMarkLists P J ell)
    (row : (g : Fin N) → (GlobalBirthHistoryState (fun p : ↥(P g) => ZMod p.val) → ℂ) →
      GlobalBirthHistoryState (fun p : ↥(P g) => ZMod p.val) → ℂ)
    (F : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ) :
    jointRawTensorCutoff B row (physicalMarkRawExtension (B := B) (F ∘ physicalMarkRawReadout) R) =
      jointRawTensorCutoff B row F := by
  unfold jointRawTensorCutoff
  rw [physical_mark_raw_readout_cutoff]

theorem physical_mark_raw_extension_mark_indicator {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (L R : PhysicalMarkLists P J ell) (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    physicalMarkRawExtension (fun s => if s.1 = R then F s else 0) L =
      if L = R then physicalMarkRawExtension F L else fun _ => 0 := by
  funext s
  by_cases h : L = R
  · simp only [physicalMarkRawExtension, h, if_true]
  · simp only [physicalMarkRawExtension, h, if_false, dite_eq_ite, ite_self]

end Bounty
end

section

/- The exact density of a simultaneous base congruence and local pair-sieve events. -/

open Finset

namespace Bounty

theorem actual_pair_sieve_residue_density (m : ℕ) [NeZero m]
    (P : Finset ℕ) (rough banned : ℕ → Bool)
    (hP : ∀ p ∈ P, p.Prime) (hPm : ∀ p ∈ P, ¬p ∣ m) :
    ((natPairSieveResidues m (natPairBaseResidues m) P
      (fun p => natPairBadResidues p (rough p) (banned p))).card : ℝ) /
        ((m : ℝ) * ∏ p ∈ P, (p : ℝ))^2 =
      ((m.totient : ℝ)/(m : ℝ)^2) * ∏ p ∈ P, pairSieveDensity p (rough p) (banned p) := by
  have hprod : (∏ p ∈ P, (natPairBadResidues p (rough p) (banned p)).card : ℝ) /
      (∏ p ∈ P, (p : ℝ))^2 = ∏ p ∈ P, pairSieveDensity p (rough p) (banned p) := by
    rw [← prod_pow, ← prod_div_distrib]
    apply prod_congr rfl
    intro p hp
    exact @nat_pair_bad_residue_density p ⟨hP p hp⟩ (rough p) (banned p)
  rw [actual_pair_sieve_residue_card m P rough banned hP hPm, Nat.cast_mul, Nat.cast_prod,
    mul_pow, mul_div_mul_comm, hprod]

theorem nat_pair_base_mod_iff (m : ℕ) (hm : 0 < m) (x y : ℕ) :
    (x % m, y % m) ∈ natPairBaseResidues m ↔ (x*y) % m = 1 % m := by
  simp only [natPairBaseResidues, mem_filter, Finset.product_eq_sprod, mem_product, mem_range,
    Nat.mod_lt _ hm, and_self, true_and, ← Nat.mul_mod]

theorem nat_pair_bad_mod_iff (p : ℕ) (hp : 0 < p) (rough banned : Bool) (x y : ℕ) :
    (x % p, y % p) ∈ natPairBadResidues p rough banned ↔
      (rough = true ∧ (x*y) % p = 0) ∨ (banned = true ∧ (x*y) % p = 1 % p) := by
  simp only [natPairBadResidues, mem_filter, Finset.product_eq_sprod, mem_product, mem_range,
    Nat.mod_lt _ hp, and_self, true_and, ← Nat.mul_mod]

end Bounty
end

section

/- The mask-averaged Euler correction is bounded by the actual marked harmonic mass. -/

open Filter Finset
open scoped Topology

namespace Bounty

theorem one_marked_groups_euler_lower {G : Type*} [DecidableEq G]
    (groups : Finset G) (P : G → Finset ℕ)
    (hdisj : (groups : Set G).PairwiseDisjoint P)
    (hP : ∀ g ∈ groups, ∀ p ∈ P g, p.Prime)
    {q : ℝ} (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (mass : G → ℝ)
    (hpos : ∀ g ∈ groups, 0 < mass g)
    (hmass : ∀ g ∈ groups, (∑ p ∈ P g, 1/(p : ℝ)) = mass g) :
    (∏ p ∈ groups.biUnion P, (1 + q/((p : ℝ)-1))) ≤
      ∑' n : Nat.factoredNumbers (groups.biUnion P), oneMarkedGroupTerm groups P q mass n.val := by
  rw [(one_marked_groups_summable_and_sum groups P hdisj hP q mass).2, prod_biUnion hdisj]
  apply Finset.prod_le_prod₀
  · intro g hg
    apply prod_nonneg
    intro p hp
    have hpR : (1 : ℝ) < p := Nat.one_lt_cast.mpr (hP g hg p hp).one_lt
    positivity
  · intro g hg
    rw [one_marked_harmonic_mass_eq_normalized]
    exact normalized_one_marked_harmonic_lower (P g) (hP g hg) hq0 hq1 (hpos g hg) (hmass g hg)

theorem eventually_candidate_unmarked_euler_lower {c q : ℝ}
    (hc : 0 < c) (hq0 : 0 ≤ q) (hq1 : q ≤ 1) :
    ∀ᶠ L : ℝ in atTop,
      (∏ p ∈ (candidatePIndices c L).biUnion (candidatePBand (c*L)), (1 + q/((p : ℝ)-1))) ≤
        candidateOneMarkedHarmonicMass c L q := by
  obtain ⟨v, V, hv, _, hpool⟩ := exists_candidate_P_pool_bounds hc
  filter_upwards [hpool] with L hp
  rcases hp with ⟨_, _, _, _, hpair, hdata⟩
  exact one_marked_groups_euler_lower (candidatePIndices c L) (candidatePBand (c*L))
    (fun i _ j _ hij => hpair hij) (fun j hj p hp => ((hdata j hj).2.2 p hp).1)
    hq0 hq1 _ (fun j hj => hv.trans_le (hdata j hj).1) (fun _ _ => rfl)

theorem eventually_candidate_mask_inverse_bound {c q : ℝ}
    (hc : 0 < c) (hq0 : 0 ≤ q) (hq1 : q ≤ 1) :
    ∀ᶠ L : ℝ in atTop, ∀ P : Finset ℕ,
      P ⊆ (candidatePIndices c L).biUnion (candidatePBand (c*L)) →
      (∑ S ∈ P.powerset, bernoulliSubsetWeight q P S *
        ∏ p ∈ S, (1 - 1/(p : ℝ))⁻¹) ≤ candidateOneMarkedHarmonicMass c L q := by
  obtain ⟨v, V, hv, _, hpool⟩ := exists_candidate_P_pool_bounds hc
  filter_upwards [hpool, eventually_candidate_unmarked_euler_lower hc hq0 hq1] with L hp he
  rcases hp with ⟨_, _, _, _, _, hdata⟩
  have hprime : ∀ p ∈ (candidatePIndices c L).biUnion (candidatePBand (c*L)), p.Prime := by
    intro p hp
    obtain ⟨j, hj, hpj⟩ := mem_biUnion.mp hp
    exact ((hdata j hj).2.2 p hpj).1
  intro P hP
  rw [bernoulli_mask_inverse_avoidance P q (fun p hp => (hprime p (hP hp)).two_le)]
  apply le_trans _ he
  apply prod_le_prod_of_subset_of_one_le₀ hP
  · intro p hp
    have hpR : (1 : ℝ) < p := Nat.one_lt_cast.mpr (hprime p (hP hp)).one_lt
    positivity
  · intro p hp _
    have hpR : (1 : ℝ) < p := Nat.one_lt_cast.mpr (hprime p hp).one_lt
    exact le_add_of_nonneg_right (div_nonneg hq0 (by linarith))

end Bounty
end

section

/- The full physical record determines the mark list, ledger and pending memory. -/

namespace Bounty

theorem physical_full_memory_state_injective
    {G : Type*} {P : G → Finset ℕ} {Z : G → Type*} {J ell B : ℕ}
    (C : G → Finset (Fin J)) :
    Function.Injective (fun s : PhysicalMarkLists P J ell ×
      ((g : G) → BoundedOrderedTuple (Z g) B) => physicalFullMemoryState C s.1 s.2) := by
  intro s t h
  apply (physicalFullStateEquiv C).injective
  exact Subtype.ext h

section Bounded

variable {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (C : Fin N → Finset (Fin J))

theorem physical_bounded_mark_encode_injective :
    Function.Injective (physicalBoundedMarkEncode (P := P) (ell := ell) (B := B) C) := by
  intro s t h
  have hm : (s.1, s.2.2) = (t.1, t.2.2) :=
    physical_full_memory_state_injective C (congrArg Prod.snd h)
  have hmarks := congrArg Prod.fst hm
  have hmemory := congrArg Prod.snd hm
  have hledger := congrArg Prod.fst h
  exact Prod.ext hmarks (Prod.ext hledger hmemory)

theorem physical_bounded_mark_encode_eq_iff
    (s t : PhysicalBoundedMarkState P J ell B) :
    physicalBoundedMarkEncode C s = physicalBoundedMarkEncode C t ↔ s = t :=
  (physical_bounded_mark_encode_injective C).eq_iff

theorem physical_bounded_mark_encode_full_injective
    (s : PhysicalBoundedMarkState P J ell B) :
    FullActiveInjective (physicalBoundedMarkEncode C s).2 :=
  physical_full_state_injective C s.1 s.2.2

noncomputable def physicalBoundedMarkDecode
    (x : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val)
      (M := fun _ => J + ell) B)
    (hx : FullActiveInjective x.2) : PhysicalBoundedMarkState P J ell B :=
  (physicalFullStateLabels C x.2 hx, x.1, fun g => (x.2 g).2)

theorem physical_bounded_mark_decode_encode
    (s : PhysicalBoundedMarkState P J ell B) :
    physicalBoundedMarkDecode C (physicalBoundedMarkEncode C s)
      (physical_bounded_mark_encode_full_injective C s) = s := by
  apply Prod.ext
  · exact physical_full_state_labels_encode C s.1 s.2.2
  · rfl

theorem physical_bounded_mark_encode_decode
    (x : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val)
      (M := fun _ => J + ell) B)
    (hx : FullActiveInjective x.2) :
    physicalBoundedMarkEncode C (physicalBoundedMarkDecode C x hx) = x := by
  apply Prod.ext
  · rfl
  · exact physical_full_state_encode_labels C x.2 hx

noncomputable def physicalBoundedMarkEquiv :
    PhysicalBoundedMarkState P J ell B ≃
      {x : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val)
        (M := fun _ => J + ell) B // FullActiveInjective x.2} where
  toFun s := ⟨physicalBoundedMarkEncode C s, physical_bounded_mark_encode_full_injective C s⟩
  invFun x := physicalBoundedMarkDecode C x.val x.property
  left_inv := physical_bounded_mark_decode_encode C
  right_inv x := Subtype.ext (physical_bounded_mark_encode_decode C x.val x.property)

theorem physical_bounded_mark_encode_range :
    Set.range (physicalBoundedMarkEncode (P := P) (ell := ell) (B := B) C) =
      {x | FullActiveInjective x.2} := by
  ext x
  constructor
  · rintro ⟨s, rfl⟩
    exact physical_bounded_mark_encode_full_injective C s
  · intro hx
    exact ⟨physicalBoundedMarkDecode C x hx, physical_bounded_mark_encode_decode C x hx⟩

end Bounded

end Bounty
end

section

/- Full Euler-product control for the actual masked pair-sieve prime sets. -/

open Finset

namespace Bounty

theorem masked_pair_euler_bound (m : ℕ) (hm : m ≠ 0) (W z : ℝ)
    (hW : 0 ≤ W) (hWz : W ≤ z) (A : Finset ℕ) (hA : ∀ p ∈ A, 2 ≤ p) :
    (∏ p ∈ maskedPairRoughPrimes m W z, (1 - 1/(p : ℝ)))^2 *
      (∏ p ∈ maskedPairBannedPrimes m z A, (1 - 1/(p : ℝ))) ≤
      8 * (∏ p ∈ primeBand 0 W, (1 - 1/(p : ℝ)))^2 *
        (∏ p ∈ primeBand 0 z, (1 - 1/(p : ℝ))) *
        (∏ p ∈ m.primeFactors, (1 - 1/(p : ℝ))⁻¹)^3 *
        (∏ p ∈ A, (1 - 1/(p : ℝ))⁻¹) := by
  have hz := hW.trans hWz
  have hR := masked_pair_rough_omission m hm W z hW hWz
  have hB := masked_pair_banned_omission m hm z hz A hA
  have hR0 : 0 ≤ ∏ p ∈ maskedPairRoughPrimes m W z, (1 - 1/(p : ℝ)) := by
    apply prod_nonneg
    intro p hp
    exact (avoidance_factor_bounds
      ((mem_masked_pair_primes hz).mp (mem_filter.mp hp).1).1.two_le).1.le
  have hB0 : 0 ≤ ∏ p ∈ maskedPairBannedPrimes m z A, (1 - 1/(p : ℝ)) := by
    apply prod_nonneg
    intro p hp
    exact (avoidance_factor_bounds
      ((mem_masked_pair_primes hz).mp (mem_sdiff.mp hp).1).1.two_le).1.le
  have h := mul_le_mul (pow_le_pow_left₀ hR0 hR 2) hB hB0 (sq_nonneg _)
  exact h.trans_eq (by ring)

theorem masked_pair_euler_uniform_bound {L : ℝ} (hL : 1 ≤ L)
    (m : ℕ) (hm : m ≠ 0) (hmL : (m : ℝ) ≤ Real.exp L)
    (hmin : ∀ p ∈ m.primeFactors, L^2 ≤ (p : ℝ))
    (W z : ℝ) (hW : 0 ≤ W) (hWz : W ≤ z)
    (A : Finset ℕ) (hA : ∀ p ∈ A, 2 ≤ p) :
    (∏ p ∈ maskedPairRoughPrimes m W z, (1 - 1/(p : ℝ)))^2 *
      (∏ p ∈ maskedPairBannedPrimes m z A, (1 - 1/(p : ℝ))) ≤
      (8 * Real.exp 12) * (∏ p ∈ primeBand 0 W, (1 - 1/(p : ℝ)))^2 *
        (∏ p ∈ primeBand 0 z, (1 - 1/(p : ℝ))) *
        (∏ p ∈ A, (1 - 1/(p : ℝ))⁻¹) := by
  have hz := hW.trans hWz
  have hV : 0 ≤ ∏ p ∈ primeBand 0 z, (1 - 1/(p : ℝ)) := prod_nonneg (fun p hp =>
    (avoidance_factor_bounds ((mem_primeBand_iff le_rfl hz p).mp hp).1.two_le).1.le)
  have hI : 0 ≤ ∏ p ∈ A, (1 - 1/(p : ℝ))⁻¹ :=
    prod_nonneg (fun p hp => inv_nonneg.mpr (avoidance_factor_bounds (hA p hp)).1.le)
  have hb := masked_pair_euler_bound m hm W z hW hWz A hA
  have hc := mul_le_mul_of_nonneg_left (large_prime_modulus_inverse_cube_bound hL m hm hmL hmin)
    (show 0 ≤ 8 * (∏ p ∈ primeBand 0 W, (1 - 1/(p : ℝ)))^2 *
      (∏ p ∈ primeBand 0 z, (1 - 1/(p : ℝ))) *
      (∏ p ∈ A, (1 - 1/(p : ℝ))⁻¹) by positivity)
  apply hb.trans
  convert hc using 1 <;> ring

end Bounty
end

section

/- Exact signed pairing transport for the concrete physical prime rows. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def repeatedBigPrimeRow
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (Q : ℕ) (h : ℝ)
    (keptA keptB : Finset (RepeatedBigFlatIndex G J ell) → Finset ℤ)
    (ζ Θ : ℝ) (source target : RepeatedBigLists P J ell) : ℂ :=
  ∑ aux : PhysicalAuxLabels P (repeatedBigAuxCut A B),
    repeatedBigUnbannedKernel V (fun _ _ => 1) (repeatedBigAuxCut A B) ζ
      (repeatedBigPrimeCoefficient P V A B hU hAB Q h (keptA A) (keptB B))
      aux source target * physicalReturnPhase Θ (repeatedBigD (repeatedBigAuxCut A B) source aux)

theorem repeated_big_prime_pairing_eq
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (Q : ℕ) (h : ℝ)
    (keptA keptB : Finset (RepeatedBigFlatIndex G J ell) → Finset ℤ)
    (ζ Θ : ℝ) (f g : RepeatedBigLists P J ell → ℂ) :
    cleanKernelPairing (repeatedBigActiveMass V (fun _ _ => 1))
      (repeatedBigPrimeRow P V A B hU hAB Q h keptA keptB ζ Θ) f g =
    cleanKernelPairing
      (finiteProductWeight (fun i : RepeatedBigFlatIndex G J ell => physicalLabelLaw V i.1))
      (primeAsymmetricComparisonKernel (fun i : RepeatedBigFlatIndex G J ell => P i.1)
        (fun i => V i.1) (repeatedBigFlatActive J ell) Q h keptA keptB ζ Θ A B)
      (fun x => f ((repeatedBigFlatEquiv P J ell).symm x))
      (fun x => g ((repeatedBigFlatEquiv P J ell).symm x)) := by
  rw [← repeated_big_clean_kernel_pairing_flat]
  congr 1
  funext x y
  exact (repeated_big_prime_unbanned_kernel_eq P V A B hU hAB Q h keptA keptB ζ Θ
    ((repeatedBigFlatEquiv P J ell).symm x) ((repeatedBigFlatEquiv P J ell).symm y)).trans
      (by simp only [Equiv.apply_symm_apply])

theorem repeated_big_prime_signed_pairing_eq
    {T G : Type*} [Fintype T] [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : T → Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ t g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A t ∪ B t)
    (hAB : ∀ t, Disjoint (A t) (B t)) (Q : ℕ) (h : ℝ)
    (keptA keptB : Finset (RepeatedBigFlatIndex G J ell) → Finset ℤ)
    (ζ Θ : ℝ) (c : T → ℂ) (f g : RepeatedBigLists P J ell → ℂ) :
    cleanKernelPairing (repeatedBigActiveMass V (fun _ _ => 1))
      (∑ t, c t • repeatedBigPrimeRow P V (A t) (B t) (hU t) (hAB t) Q h keptA keptB ζ Θ)
      f g =
    ∑ t, c t * cleanKernelPairing
      (finiteProductWeight (fun i : RepeatedBigFlatIndex G J ell => physicalLabelLaw V i.1))
      (primeAsymmetricComparisonKernel (fun i : RepeatedBigFlatIndex G J ell => P i.1)
        (fun i => V i.1) (repeatedBigFlatActive J ell) Q h keptA keptB ζ Θ (A t) (B t))
      (fun x => f ((repeatedBigFlatEquiv P J ell).symm x))
      (fun x => g ((repeatedBigFlatEquiv P J ell).symm x)) := by
  rw [clean_kernel_pairing_sum_kernel]
  apply sum_congr rfl
  intro t _
  rw [clean_kernel_pairing_smul_kernel, repeated_big_prime_pairing_eq]

end Bounty
end

section

/- Prime-factor support of every actual microscopic assignment product. -/

open Finset Filter
open scoped Topology

namespace Bounty

theorem eventually_candidate_micro_assignment_primeFactors_range {c δ : ℝ}
    (hc : 0 < c) (hsmall : (6/5 : ℝ)*c ≤ δ) :
    ∀ᶠ L : ℝ in atTop, ∀ r jStar J : ℕ,
      ∀ x : ∀ i, candidateMicroAssignmentChoices c L r jStar J i,
        ∀ p ∈ (orderedSlotProduct (candidateMicroAssignmentChoices c L r jStar J) x).primeFactors,
          L^20 < (p : ℝ) ∧ (p : ℝ) ≤ Real.exp (δ*L) := by
  have hδ : 0 < δ := (by positivity : 0 < (6/5 : ℝ)*c).trans_le hsmall
  filter_upwards [eventually_candidateQIndices_geometry hc,
    eventually_candidate_P_pool_prime_range hc hδ, eventually_rpow_le_exp_sqrt 20,
    eventually_gt_atTop (0 : ℝ)] with L hQ hP hrough hL
  have hr : L^20 ≤ Real.exp (Real.sqrt L) := by
    change L ^ ((20 : ℕ) : ℝ) ≤ _ at hrough
    rw [Real.rpow_natCast] at hrough
    exact hrough
  have hregular : ∀ j ∈ candidateQIndices c L, L^20 ≤ Real.exp (c*L/(2 : ℝ)^j) := by
    intro j hj
    have hpow : L^20 = Real.exp (20*Real.log L) := by
      rw [mul_comm, Real.exp_mul, Real.exp_log hL]
      norm_num
    rw [hpow]
    exact Real.exp_le_exp.mpr (hQ.2 j hj).1
  intro r jStar J x
  refine ordered_slot_product_primeFactors_inherit (candidateMicroAssignmentChoices c L r jStar J) ?_
    (fun p => L^20 < (p : ℝ) ∧ (p : ℝ) ≤ Real.exp (δ*L)) ?_ x
  · intro i n hn
    cases i with
    | inl slot =>
      exact candidate_Q_slot_nonzero c L r jStar
        (⟨slot.1.val, (mem_filter.mp slot.1.property).1⟩, slot.2) hn
    | inr g => exact (mem_filter.mp hn).2.ne_zero
  · intro i n hn p hp
    cases i with
    | inl slot =>
      exact candidate_Q_slot_primeFactors_range (mul_nonneg hc.le hL.le) hr
        (mul_le_mul_of_nonneg_right hsmall hL.le) hregular
        (⟨slot.1.val, (mem_filter.mp slot.1.property).1⟩, slot.2) hn p hp
    | inr g =>
      have hnprime : n.Prime := (mem_filter.mp hn).2
      have hpn : p = n := ((Nat.dvd_prime hnprime).mp (Nat.dvd_of_mem_primeFactors hp)).resolve_left
        (Nat.mem_primeFactors.mp hp).1.ne_one
      subst p
      exact hP n (mem_biUnion.mpr ⟨g.val, g.property, hn⟩)

end Bounty
end

section

/- The explicit raw physical pattern has no freed first-block slots and
coefficient one. Its exact pairing is the diagonal prime phase on tail averages. -/

open Finset
open scoped Classical

namespace Bounty

def repeatedBigPrimeTailSlots (J ell : ℕ) : Finset (PhysicalSlots J ell) :=
  univ.map Function.Embedding.inr

theorem repeatedBigPrimeTailSlots_compl {G : Type*} [Fintype G] [DecidableEq G]
    (J ell : ℕ) : (repeatedBigFlatActive (G := G) J ell)ᶜ =
      univ.sigma (fun _ : G => repeatedBigPrimeTailSlots J ell) := by
  ext ⟨g, j | j⟩ <;> simp [repeatedBigFlatActive, repeatedBigPrimeTailSlots]

theorem repeatedBigFlatShared_empty {G : Type*} [Fintype G] [DecidableEq G]
    (J ell : ℕ) : repeatedBigFlatShared (G := G) (ell := ell) (fun _ => (∅ : Finset (Fin J))) =
      repeatedBigFlatActive J ell := by
  ext ⟨g, j | j⟩ <;> simp [repeatedBigFlatShared, repeatedBigFlatActive, physicalSharedSlots]

theorem repeated_big_prime_raw_D {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (source : RepeatedBigLists P J ell)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J)))) :
    repeatedBigD (fun _ => ∅) source aux =
      ∏ i ∈ repeatedBigFlatActive J ell, (repeatedBigFlatEquiv P J ell source i).val := by
  have hs := repeated_big_shared_label_product_flat (fun _ : G => (∅ : Finset (Fin J))) source
  rw [repeatedBigFlatShared_empty] at hs
  calc
    _ = ∏ i : repeatedBigFlatActive J ell, (repeatedBigFlatEquiv P J ell source i.val).val := by
      simpa [repeatedBigD] using hs
    _ = _ := prod_coe_sort (repeatedBigFlatActive J ell)
      (fun i => (repeatedBigFlatEquiv P J ell source i).val)

theorem repeated_big_prime_raw_kernel_eq {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) {J ell : ℕ} (V : G → ℝ) (ζ Θ : ℝ)
    (source target : RepeatedBigLists P J ell) :
    (∑ aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))),
      repeatedBigUnbannedKernel V (fun _ _ => 1) (fun _ => ∅) ζ (fun _ _ _ => 1)
        aux source target * physicalReturnPhase Θ (repeatedBigD (fun _ => ∅) source aux)) =
      if finiteSharedCompatible (repeatedBigFlatActive J ell)
          (repeatedBigFlatEquiv P J ell source) (repeatedBigFlatEquiv P J ell target) then
        (finiteFreshMass (fun i : RepeatedBigFlatIndex G J ell => physicalLabelLaw V i.1)
          (repeatedBigFlatActive J ell) (repeatedBigFlatEquiv P J ell target) : ℂ) *
        primeActivePhase (fun i : RepeatedBigFlatIndex G J ell => P i.1)
          (repeatedBigFlatActive J ell) ζ Θ (repeatedBigFlatEquiv P J ell source)
      else 0 := by
  have hc := repeated_big_shared_compatible_flat (fun _ : G => (∅ : Finset (Fin J))) source target
  rw [repeatedBigFlatShared_empty] at hc
  simp only [repeatedBigUnbannedKernel, hc, physicalAuxMass,
    mul_one, repeated_big_prime_raw_D, repeated_big_target_mass_flat,
    repeatedBigFlatShared_empty]
  split_ifs
  · simp only [primeActivePhase, primeTuplePhase, mul_assoc]
    simp
  · simp

theorem prime_raw_fresh_pairing_tail_average {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ)
    (hmass : ∀ i, ∑ v : P i, physicalLabelLaw V i v = 1)
    (active : Finset I) (hμ : ∀ i ∈ active, ∀ v : P i, physicalLabelLaw V i v ≠ 0)
    (ζ Θ : ℝ) (f g : (∀ i, P i) → ℂ) :
    cleanKernelPairing (finiteProductWeight (physicalLabelLaw V))
        (fun x y => if finiteSharedCompatible active x y then
          (finiteFreshMass (physicalLabelLaw V) active y : ℂ) * primeActivePhase P active ζ Θ x
          else 0) f g =
      cleanRawPairing (finiteProductWeight (physicalLabelLaw V)) (primeActivePhase P active ζ Θ)
        (finiteCoordinateComponent (physicalLabelLaw V) ∅ activeᶜ.toList f)
        (finiteCoordinateComponent (physicalLabelLaw V) ∅ activeᶜ.toList g) := by
  let F := fun (A B : Finset I) (c : ∀ i : ↥(active \ (A ∪ B)), P i.val)
      (_ : ∀ i : A, P i.val) (_ : ∀ i : B, P i.val) =>
    primeTuplePhase ζ Θ (∏ i : ↥(active \ (A ∪ B)), (c i).val)
  have hK : finiteAsymmetricComparisonKernel (physicalLabelLaw V) active F ∅ ∅ =
      fun x y => if finiteSharedCompatible active x y then
        (finiteFreshMass (physicalLabelLaw V) active y : ℂ) * primeActivePhase P active ζ Θ x
        else 0 := by
    funext x y
    unfold finiteAsymmetricComparisonKernel finiteAsymmetricKernel F
    simp only [finiteCoordinateRestrict, primeActivePhase]
    have hp := prod_coe_sort (active \ ((∅ : Finset I) ∪ ∅)) (fun i => (x i).val)
    rw [hp]
    simp only [union_self, sdiff_empty]
  have hp := finite_asymmetric_comparison_pairing_tail_projection
    (physicalLabelLaw V) hmass active ∅ ∅ (empty_subset _) (empty_subset _)
    (by simpa only [union_self, sdiff_empty] using hμ) F f g
  rw [hK] at hp
  exact hp.trans (finite_shared_raw_pairing_tail_average
    (physicalLabelLaw V) hmass active (primeActivePhase P active ζ Θ) f g)

theorem repeated_big_prime_raw_pairing {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) {J ell : ℕ} (V : G → ℝ)
    (hmass : ∀ g, ∑ v : P g, physicalLabelLaw V g v = 1)
    (hμ : ∀ g (v : P g), physicalLabelLaw V g v ≠ 0)
    (ζ Θ : ℝ) (f g : RepeatedBigLists P J ell → ℂ) :
    cleanKernelPairing (repeatedBigActiveMass V (fun _ _ => 1))
        (fun source target => ∑ aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))),
          repeatedBigUnbannedKernel V (fun _ _ => 1) (fun _ => ∅) ζ (fun _ _ _ => 1)
            aux source target * physicalReturnPhase Θ (repeatedBigD (fun _ => ∅) source aux)) f g =
      cleanRawPairing (finiteProductWeight
          (fun i : RepeatedBigFlatIndex G J ell => physicalLabelLaw V i.1))
        (primeActivePhase (fun i : RepeatedBigFlatIndex G J ell => P i.1)
          (repeatedBigFlatActive J ell) ζ Θ)
        (finiteGroupedTailTest (physicalLabelLaw V) (fun _ => repeatedBigPrimeTailSlots J ell) f)
        (finiteGroupedTailTest (physicalLabelLaw V) (fun _ => repeatedBigPrimeTailSlots J ell) g) := by
  rw [clean_kernel_pairing_equiv (repeatedBigFlatEquiv P J ell)]
  simp only [repeated_big_prime_raw_kernel_eq, repeated_big_active_mass_flat,
    Equiv.apply_symm_apply]
  have hp := prime_raw_fresh_pairing_tail_average
    (fun i : RepeatedBigFlatIndex G J ell => P i.1) (fun i => V i.1)
    (fun i => hmass i.1) (repeatedBigFlatActive J ell) (fun i _ v => hμ i.1 v)
    ζ Θ (finiteGroupFlattenFunction f) (finiteGroupFlattenFunction g)
  rw [repeatedBigPrimeTailSlots_compl] at hp
  exact hp

end Bounty
end

section

/- Exact group-tagged ledger increments are the performed original birth slots. -/

open Finset
open scoped Classical
namespace Bounty

section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
  [∀ g, DecidableEq (P g)] (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ)

noncomputable def fullMixedLedgerGroupImage
    (s : FullMixedLedgerState n (M := M) B) (g : Fin N) : Finset ((h : Fin N) × P h) :=
  (s.1 g).image (Sigma.mk g)

theorem full_mixed_ledger_group_image_update
    (ω : ∀ k c, A k c → ℝ) (μ : (g : Fin N) → P g → ℝ)
    (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ) (tag : Option (J ⊕ K))
    (s : FullMixedLedgerState n (M := M) B)
    (e : FullPermutationMixedEvent n S B A Δ D tag s.2)
    (hs : FullMixedLedgerCovers n B s)
    (hw : fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V tag s.2 e ≠ 0)
    (g : Fin N) :
    fullMixedLedgerGroupImage n B (fullMixedLedgerTarget n S B A Δ D tag s e) g =
      fullMixedLedgerGroupImage n B s g ∪ fullMixedEventGroupBirthImage n S B A Δ D tag s.2 e g := by
  cases tag with
  | none =>
    simp only [fullMixedLedgerGroupImage, fullMixedLedgerTarget, finiteLedgerEventTarget,
      fullMixedLedgerUpdate, fullMixedEventGroupBirthImage, fullMixedBirthCapacity]
    simp
  | some tag =>
    cases tag with
    | inl j =>
      rw [full_mixed_ghost_group_birth_image]
      change (s.1 g ∪ univ.image (fun i => ((e.down g).2.2 i).1)).image (Sigma.mk g) = _
      rw [image_union, image_image]
      ext z
      simp only [fullMixedLedgerGroupImage, mem_union, mem_image, Function.comp_apply]
    | inr k =>
      rw [full_mixed_edge_group_birth_image]
      have hl := full_edge_ledger_local_weight_ne_zero n (S k) B (A k) (Δ k) (D k)
        (ω k) μ ρ V s.2 e hw g
      have hu := bounded_edge_ledger_union_of_nonzero (n g)
        (Δ k (productActiveMemorySplit (S k) B s.2).1 e.1 g)
        (D k (productActiveMemorySplit (S k) B s.2).1 e.1 g)
        (S k g)ᶜ.card B (s.1 g) (μ g) ρ (V g)
        ((productActiveMemorySplit (S k) B s.2).2 g) (e.2 g) (hs g).2 hl
      unfold fullMixedLedgerGroupImage
      change (fullEdgeLedgerUpdate n (S k) B (A k) (Δ k) (D k) s.1 s.2 e g).image
        (Sigma.mk g) = _
      unfold fullEdgeLedgerUpdate fullActiveEdgeEventTarget
      simp only [Equiv.apply_symm_apply]
      change (s.1 g ∪ univ.image (unrestrictedBoundedEventTarget (n g)
        (Δ k (productActiveMemorySplit (S k) B s.2).1 e.1 g)
        (D k (productActiveMemorySplit (S k) B s.2).1 e.1 g)
        (S k g)ᶜ.card B ((productActiveMemorySplit (S k) B s.2).2 g) (e.2 g)).1).image
          (Sigma.mk g) = _
      rw [hu, image_union, image_image]
      ext z
      simp only [ mem_union, mem_image, Function.comp_apply]

end Full
end Bounty
end

section

/- The actual coefficient is bounded by its fully normalized microscopic assignments. -/

open Finset Filter
open scoped Topology

namespace Bounty

noncomputable def candidateMicroAssignmentMajorant (c L q : ℝ) (r jStar J : ℕ)
    (z : ℝ) (u : ℕ) : ℝ :=
  ∑ x : ∀ i, candidateMicroAssignmentChoices c L r jStar J i,
    primeAssignmentTerm ((candidatePIndices c L).biUnion (candidatePBand (c*L))) q z
      (candidateMicroAssignmentNormalization c L r J) u
      (orderedSlotProduct (candidateMicroAssignmentChoices c L r jStar J) x)

theorem candidate_coefficient_le_micro_assignment {c L q z : ℝ}
    (hcL : 0 ≤ c*L) (hq : 0 ≤ q)
    (hpool : ∀ p ∈ (candidatePIndices c L).biUnion (candidatePBand (c*L)),
      (p : ℝ) ≤ Real.exp (Real.sqrt L)) (r jStar J : ℕ) (hJ : J ≤ jStar)
    (hz : ∀ j ∈ candidateMacroQIndices c L J, ∀ p ∈ candidateQBand (c*L) j, z < (p : ℝ))
    (u : ℕ) : candidateCoefficient c L q r jStar u ≤
      candidateMicroAssignmentMajorant c L q r jStar J z u := by
  classical
  let P : candidatePIndices c L → Finset ℕ := fun g => candidatePBand (c*L) g.val
  have hprime : ∀ g p, p ∈ P g → p.Prime := fun _ _ hp => (mem_filter.mp hp).2
  have hdisj : Pairwise (fun g h => Disjoint (P g) (P h)) := by
    intro g h hne
    exact pairwise_disjoint_dyadicPrimeBand hcL (by norm_num) (by norm_num)
      (fun he => hne (Subtype.ext he))
  have hUnion : univ.biUnion P = (candidatePIndices c L).biUnion (candidatePBand (c*L)) := by
    ext p
    simp [P]
  have hW : 0 ≤ markedDivisorWeight (candidatePIndices c L) (candidatePBand (c*L)) q
      (fun j => ∑ p ∈ candidatePBand (c*L) j, 1/(p : ℝ)) (fun _ => 1) (u : ℤ) :=
    marked_divisor_weight_nonneg _ _ hq _ _ (fun _ _ => sum_nonneg (fun _ _ => by positivity)) _
  unfold candidateCoefficient
  refine (mul_le_mul_of_nonneg_right
    (candidate_Q_free_weight_le_micro_majorant hcL r jStar J hJ hz _ u) hW).trans ?_
  rw [one_marked_weight_unmarked_sum _ _ q _ hdisj u]
  unfold candidateMicroQFreeMajorant candidateMicroAssignmentMajorant
  rw [candidateMicroAssignmentChoices, ordered_slot_sum_test_sum, sum_mul]
  simp_rw [mul_sum]
  apply sum_le_sum
  intro x _
  apply sum_le_sum
  intro y _
  have hfree : Disjoint
      (orderedSlotProduct (candidateMicroQSlotChoices c L r jStar J) x).primeFactors (univ.biUnion P) := by
    rw [hUnion]
    exact candidate_micro_Q_product_free hcL hpool r jStar J x
  have h := free_mark_assignment_term P hprime hdisj y
    (candidate_micro_Q_product_pos c L r jStar J x).ne' hfree hq
    (by positivity : 0 ≤ (r.factorial : ℝ)^(candidateMicroQIndices c L J).card)
    (show 0 ≤ ∏ g ∈ candidatePIndices c L, ∑ p ∈ candidatePBand (c*L) g, 1/(p : ℝ) from
      prod_nonneg (fun _ _ => sum_nonneg (fun _ _ => by positivity))) z u
  rw [hUnion] at h
  by_cases hd : orderedSlotProduct (candidateMicroQSlotChoices c L r jStar J) x ∣ u ∧
      ∀ p : ℕ, p.Prime → (p : ℝ) ≤ z →
        p ∉ (candidatePIndices c L).biUnion (candidatePBand (c*L)) →
          p ∣ u → p ∣ orderedSlotProduct (candidateMicroQSlotChoices c L r jStar J) x
  · simpa only [primeAssignmentCondition, hd, if_true, candidateMicroAssignmentNormalization, P] using h
  · simpa only [primeAssignmentCondition, hd, if_false, candidateMicroAssignmentNormalization, P] using h

theorem eventually_candidate_coefficient_le_micro_assignment {c q θ : ℝ}
    (hc : 0 < c) (hq : 0 ≤ q) (r J : ℕ) (hθ : θ < 2*c/(2 : ℝ)^J) :
    ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, J ≤ jStar → ∀ u : ℕ,
      candidateCoefficient c L q r jStar u ≤
        candidateMicroAssignmentMajorant c L q r jStar J (Real.exp (θ*L)) u := by
  filter_upwards [eventually_candidate_P_pool_below_rough_cutoff hc,
    eventually_gt_atTop (0 : ℝ)] with L hpool hL
  intro jStar hj u
  exact candidate_coefficient_le_micro_assignment (mul_nonneg hc.le hL.le) hq hpool r jStar J hj
    (candidate_macro_Q_band_above hc.le hL J hθ) u

end Bounty
end

section

/- Summing reciprocal main terms and explicit lattice errors over actual assignments. -/

open Finset

namespace Bounty

theorem weighted_modulus_error_sum {I : Type*} [Fintype I]
    (w D : I → ℝ) (hw : ∀ i, 0 ≤ w i) {A B C M H : ℝ}
    (hB : 0 ≤ B) (hC : 0 ≤ C) (hM : 0 ≤ M)
    (hD : ∀ i, D i ≤ M) (hrec : (∑ i, w i / D i) = H)
    (hmass : (∑ i, w i) ≤ M*H) :
    (∑ i, w i * (A / D i + B*D i + C)) ≤ (A + B*M^2 + C*M)*H := by
  have herr : (∑ i, w i * (B*D i+C)) ≤ (B*M+C)*(M*H) := by
    calc
      _ ≤ ∑ i, w i * (B*M+C) := sum_le_sum (fun i _ =>
        mul_le_mul_of_nonneg_left (add_le_add (mul_le_mul_of_nonneg_left (hD i) hB) le_rfl) (hw i))
      _ = (B*M+C)*(∑ i, w i) := by rw [mul_sum]; apply sum_congr rfl; intro i _; ring
      _ ≤ _ := mul_le_mul_of_nonneg_left hmass (by positivity)
  have heq : (∑ i, w i * (A / D i + B*D i+C)) =
      A*(∑ i, w i/D i) + ∑ i, w i*(B*D i+C) := by
    rw [mul_sum, ← sum_add_distrib]
    apply sum_congr rfl
    intro i _
    ring
  rw [heq, hrec]
  calc
    _ ≤ A*H + (B*M+C)*(M*H) := add_le_add le_rfl herr
    _ = _ := by ring

theorem candidate_assignment_error_sum (c L : ℝ) (r jStar J : ℕ)
    {A B C M : ℝ} (hB : 0 ≤ B) (hC : 0 ≤ C) (hM : 0 ≤ M)
    (hN : 0 ≤ candidateMicroAssignmentNormalization c L r J)
    (hD : ∀ x : ∀ i, candidateMicroAssignmentChoices c L r jStar J i,
      (orderedSlotProduct (candidateMicroAssignmentChoices c L r jStar J) x : ℝ) ≤ M)
    (hrec : (∑ x : ∀ i, candidateMicroAssignmentChoices c L r jStar J i,
      (1 / candidateMicroAssignmentNormalization c L r J) /
        (orderedSlotProduct (candidateMicroAssignmentChoices c L r jStar J) x : ℝ)) =
          candidateMicroQHarmonicMass c L r jStar J)
    (hmass : (∑ _x : ∀ i, candidateMicroAssignmentChoices c L r jStar J i,
      1 / candidateMicroAssignmentNormalization c L r J) ≤
        M*candidateMicroQHarmonicMass c L r jStar J) :
    (∑ x : ∀ i, candidateMicroAssignmentChoices c L r jStar J i,
      (1 / candidateMicroAssignmentNormalization c L r J) *
        (A / (orderedSlotProduct (candidateMicroAssignmentChoices c L r jStar J) x : ℝ) +
          B*(orderedSlotProduct (candidateMicroAssignmentChoices c L r jStar J) x : ℝ) + C)) ≤
      (A+B*M^2+C*M)*candidateMicroQHarmonicMass c L r jStar J := by
  classical
  exact weighted_modulus_error_sum _ _ (fun _ => by positivity) hB hC hM hD hrec hmass

end Bounty
end

section

/- The remaining local phase acts on the original event and carries every edge restriction. -/

open scoped Classical
namespace Bounty
section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, DecidableEq (P g)]
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ)
  (edgePhase : ∀ k, ((g : Fin N) → Finset (P g)) →
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) →
    FullActiveEdgeEvent n (S k) B (A k) (Δ k) (D k) x → ℂ)

noncomputable def fullMixedBirthResidualPhase : (tag : Option (J ⊕ K)) →
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) →
    FullPermutationMixedEvent n S B A Δ D tag x → ℂ
  | none, _, _ => 1
  | some (.inl _), _, _ => 1
  | some (.inr k), x, e => edgePhase k (fun _ => ∅) x e

omit [∀ g, DecidableEq (P g)] in
theorem full_mixed_local_freshness_factor
    (hedge : ∀ k H x e,
      edgePhase k H x e =
        (if FullMixedLocalBirthAvoids (J := J) n S B A Δ D H (some (.inr k)) x e ∧
            FullMixedLocalBirthDistinct (J := J) n S B A Δ D (some (.inr k)) x e then 1 else 0) *
          edgePhase k (fun _ => ∅) x e)
    (tag : Option (J ⊕ K)) (s : FullMixedLedgerState n (M := M) B)
    (e : FullPermutationMixedEvent n S B A Δ D tag s.2) :
    fullMixedLedgerPhase n S B A Δ D edgePhase tag s e =
      (if FullMixedLocalBirthAvoids n S B A Δ D s.1 tag s.2 e ∧
          FullMixedLocalBirthDistinct n S B A Δ D tag s.2 e then 1 else 0) *
        fullMixedBirthResidualPhase n S B A Δ D edgePhase tag s.2 e := by
  cases tag with
  | none =>
    have ha : FullMixedLocalBirthAvoids n S B A Δ D s.1 none s.2 e := by
      intro a
      exact Fin.elim0 a.2
    have hd : FullMixedLocalBirthDistinct n S B A Δ D none s.2 e := by
      intro a
      exact Fin.elim0 a.2
    simp only [fullMixedLedgerPhase, fullMixedBirthResidualPhase, if_pos (And.intro ha hd), mul_one]
  | some tag =>
    cases tag with
    | inl j =>
      change fullMixedGhostFreshnessPhase n S B A Δ D j (fun g => (s.1 g, s.2 g)) e = _
      rw [full_mixed_ghost_freshness_phase_birth_mask n S B A Δ D j s.1 s.2 e]
      simp only [fullMixedBirthResidualPhase, mul_one]
    | inr k => exact hedge k s.1 s.2 e

end Full
end Bounty
