section

/- Actual auxiliary weights and tests acting on fixed harmonic cell endpoints. -/

open Finset MeasureTheory
open scoped Classical ComplexConjugate

namespace Bounty

theorem harmonic_cell_physical_aux_pairing_eq_fourier
    {I : Type*} [Fintype I] [DecidableEq I] {J ell : ℕ}
    (P : I → Finset ℕ) (V : I → ℝ)
    (A B : Finset (RepeatedBigFlatIndex I J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex I J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (k : ℤ)
    (bA : (∀ i : A, P i.val.1) → ℂ) (bB : (∀ i : B, P i.val.1) → ℂ)
    {Y : ℝ} (hY : 0 < Y) (Z a b v : ℝ) (F G : ℤ → ℂ) :
    (∑ aux : PhysicalAuxLabels P (repeatedBigAuxCut A B),
      (physicalAuxMass V (repeatedBigAuxCut A B) aux : ℂ) *
        bA (repeatedBigAuxSplitEquiv P A B hU hAB aux).1 *
        bB (repeatedBigAuxSplitEquiv P A B hU hAB aux).2 *
        harmonicCellPairing Y Z a b v
          (k * (∏ g, ∏ j : repeatedBigAuxCut A B g, (aux g j).val : ℕ)) F G) =
      ∫ x in (0 : ℝ)..1,
        conj (finiteFourierSum (harmonicCommonSupport Y) (harmonicCellSource Y Z a v F) x) *
          finiteFourierSum (harmonicCommonSupport Y) (harmonicCellTarget Y b G) x *
          physicalAuxFourierMultiplier P V A B hU hAB k bA bB x := by
  simp_rw [harmonic_cell_pairing_eq_masked_sum hY]
  exact physical_aux_averaged_shift_fourier P V A B hU hAB k bA bB
    (harmonicCommonSupport Y) (harmonicCommonSupport Y)
    (harmonicCellSource Y Z a v F) (harmonicCellTarget Y b G)

theorem harmonic_cell_physical_aux_major_energy
    {I : Type*} [Fintype I] [DecidableEq I] {J ell : ℕ}
    (P : I → Finset ℕ) (V : I → ℝ)
    (A B : Finset (RepeatedBigFlatIndex I J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex I J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (k : ℤ)
    (bA : (∀ i : A, P i.val.1) → ℂ) (bB : (∀ i : B, P i.val.1) → ℂ)
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (hA : ∀ a, ‖bA a‖ ≤ 1) (hB : ∀ b, ‖bB b‖ ≤ 1)
    {Y : ℝ} (hY : 0 < Y) (Z a b v : ℝ) (F G : ℤ → ℂ)
    (M : Set ℝ) (hM : MeasurableSet M) {ε : ℝ} (hε : 0 ≤ ε)
    (hminor : ∀ θ, θ ∉ M →
      ‖physicalAuxFourierMultiplier P V A B hU hAB k bA bB θ‖ ≤ ε) :
    ‖∑ aux : PhysicalAuxLabels P (repeatedBigAuxCut A B),
      (physicalAuxMass V (repeatedBigAuxCut A B) aux : ℂ) *
        bA (repeatedBigAuxSplitEquiv P A B hU hAB aux).1 *
        bB (repeatedBigAuxSplitEquiv P A B hU hAB aux).2 *
        harmonicCellPairing Y Z a b v
          (k * (∏ g, ∏ j : repeatedBigAuxCut A B g, (aux g j).val : ℕ)) F G‖ ≤
      Real.sqrt (ε ^ 2 * (∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellSource Y Z a v F n‖ ^ 2) +
        ∫ x in M ∩ Set.Ioc 0 1,
          ‖finiteFourierSum (harmonicCommonSupport Y) (harmonicCellSource Y Z a v F) x‖ ^ 2) *
      Real.sqrt (∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellTarget Y b G n‖ ^ 2) := by
  simp_rw [harmonic_cell_pairing_eq_masked_sum hY]
  exact physical_aux_shift_major_energy P V A B hU hAB k bA bB hV hMass hA hB
    (harmonicCommonSupport Y) (harmonicCommonSupport Y)
    (harmonicCellSource Y Z a v F) (harmonicCellTarget Y b G) M hM hε hminor

end Bounty
end

