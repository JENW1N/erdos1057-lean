universe u v w

def finiteEventPathMaximum {K : Type u} {X : Type v} (E : K → X → Type w)
    (target : ∀ k x, E k x → X) (height : X → ℕ) :
    ∀ steps x, FiniteEventPath E target steps x → ℕ
  | [], x, _ => height x
  | _ :: steps, x, ⟨_, p⟩ => max (height x) (finiteEventPathMaximum E target height steps _ p)

theorem finite_event_path_terminal_le_maximum {K : Type u} {X : Type v}
    (E : K → X → Type w) (target : ∀ k x, E k x → X) (height : X → ℕ)
    (steps : List K) (x : X) (p : FiniteEventPath E target steps x) :
    height (finiteEventPathTerminal E target steps x p) ≤
      finiteEventPathMaximum E target height steps x p := by
  induction steps generalizing x with
  | nil => exact le_rfl
  | cons k steps ih =>
    rcases p with ⟨e, p⟩
    exact (ih _ p).trans (le_max_right _ _)

theorem boundedGhostEventTarget_memory_le {P Z : Type*} (t B : ℕ)
    (s : BoundedOrderedState P Z t B) (e : BoundedGhostEvent t B s) :
    (boundedGhostEventTarget t B s e).2.1.val ≤ s.2.1.val + e.1.val := by
  unfold boundedGhostEventTarget
  dsimp only
  split_ifs
  · change e.2.1.card + e.1.val ≤ s.2.1.val + e.1.val
    exact Nat.add_le_add_right (by simpa only [Fintype.card_fin] using card_le_univ e.2.1) _
  · exact Nat.le_add_right _ _

theorem coupledGhostJointEventTarget_memory_le {G : Type*} [Fintype G]
    {P Z : G → Type*} (t : G → ℕ) (B : ℕ)
    (s : ProductBoundedOrderedState P Z t B) (e : CoupledGhostEvent t B s) :
    productTotalMemory (coupledGhostJointEventTarget t B s e) ≤
      productTotalMemory s + ∑ g, (e g).1.val := by
  rw [productTotalMemory, productTotalMemory, ← sum_add_distrib]
  exact sum_le_sum fun g _ => boundedGhostEventTarget_memory_le (t g) B (s g) (e g)

theorem unrestrictedBoundedEventTarget_memory_le {P : Type*} (n : P → ℕ)
    (Δ D : ℤ) (t B : ℕ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (e : UnrestrictedBoundedEvent n Δ D t B s) :
    (unrestrictedBoundedEventTarget n Δ D t B s e).2.1.val ≤ s.2.1.val + t := by
  unfold unrestrictedBoundedEventTarget
  dsimp only
  split_ifs
  · change (unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
      (unrestrictedResidueTransport n Δ) e.1 e.2.1 e.2.2.1).1 ≤ _
    simp only [unrestrictedEdgeOutput, unrestrictedEdgeMemory_length]
    have hstore : e.1.card ≤ t := by simpa only [Fintype.card_fin] using card_le_univ e.1
    omega
  · exact Nat.le_add_right _ _

theorem unrestrictedJointEventTarget_memory_le {G : Type*} [Fintype G]
    {P : G → Type*} (n : ∀ g, P g → ℕ) (Δ D : G → ℤ) (t : G → ℕ) (B : ℕ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B)
    (e : UnrestrictedJointEvent n Δ D t B s) :
    productTotalMemory (unrestrictedJointEventTarget n Δ D t B s e) ≤
      productTotalMemory s + ∑ g, t g := by
  rw [productTotalMemory, productTotalMemory, ← sum_add_distrib]
  exact sum_le_sum fun g _ => unrestrictedBoundedEventTarget_memory_le
    (n g) (Δ g) (D g) (t g) B (s g) (e g)

def fullMemoryEdgeIndicator {J K : Type*} : Option (J ⊕ K) → ℕ
  | some (.inr _) => 1
  | _ => 0

def fullMemoryEdgeCount {J K : Type*} (steps : List (Option (J ⊕ K))) : ℕ :=
  (steps.map fullMemoryEdgeIndicator).sum

