      (some (.inl j) :: steps) s
      ⟨(fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩, tail⟩ 0 i hi hu
    change CoupledGhostSampleIndex M B s sk at c
    exact ⟨c, (full_mixed_ghost_head_coordinate n S B A Δ D steps s j sk births tail c).symm.trans hc⟩
  · rintro ⟨c, rfl⟩
    constructor
    · have h := (fullMixedChronologicalCoordinateEquiv n S B A Δ D (some (.inl j) :: steps) s
        ⟨(fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩, tail⟩
        ⟨0, by change CoupledGhostSampleIndex M B s sk; exact c⟩).property
      rw [full_mixed_ghost_head_coordinate] at h
      exact h
    · exact full_mixed_ghost_head_sample_owner S B j steps s sk c

