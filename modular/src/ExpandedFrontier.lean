section

/- Precision-independent coefficient bounds for the actual global prime proxy. -/

open Finset Filter

namespace Bounty

theorem exists_prime_logarithmic_proxy_uniform_bound {a : ℝ} (ha : 0 < a) :
    ∃ C : ℝ, 0 < C ∧ ∀ S : ℝ, 0 ≤ S → ∀ᶠ L : ℝ in atTop,
      ∀ n : ℕ, Real.exp (a*L) ≤ (n : ℝ) →
        0 ≤ primeLogarithmicProxy L S n ∧ primeLogarithmicProxy L S n ≤ 1 ∧
        primeLogarithmicProxy L S n ≤
          C/(L*(∏ p ∈ primeBand 0 (Real.exp (Real.sqrt L)), (1-1/(p : ℝ)))) ∧
        |(if n.Prime then 1 else 0 : ℝ)-primeLogarithmicProxy L S n| ≤ 1 := by
  have ha2 : 0 < a/2 := by positivity
  obtain ⟨C, hC, hproxy⟩ := exists_prime_cell_proxy_uniform_bound ha2
  refine ⟨C, hC, ?_⟩
  intro S hS
  filter_upwards [eventually_logarithmic_cell_dyad_bounds ha hS, hproxy S]
    with L hcells hb
  intro n hn
  have hn0 : 0 < (n : ℝ) := (Real.exp_pos _).trans_le hn
  have hF : ∀ i ∈ ({n} : Finset ℕ), (n : ℝ) ≤ (i : ℝ) ∧ (i : ℝ) ≤ 2*n := by
    intro i hi
    obtain rfl := mem_singleton.mp hi
    exact ⟨le_rfl, by linarith⟩
  have hbase := (hcells.2 (n : ℝ) hn {n} hF).2 (logarithmicCellIndex (L^(-S)) n)
    (mem_image.mpr ⟨n, mem_singleton_self n, rfl⟩)
  have hv := hb _ hbase n
  change 0 ≤ primeLogarithmicProxy L S n ∧ primeLogarithmicProxy L S n ≤ 1 ∧
    primeLogarithmicProxy L S n ≤ C/(L*(∏ p ∈ primeBand 0 (Real.exp (Real.sqrt L)), (1-1/(p : ℝ)))) at hv
  refine ⟨hv.1, hv.2.1, hv.2.2, ?_⟩
  split <;> rw [abs_le] <;> constructor <;> linarith [hv.1, hv.2.1]

end Bounty
end

section

/- Global nonprincipal Mellin cancellation for the actual count-matched prime proxy. -/

open Finset Filter

namespace Bounty

theorem eventually_prime_logarithmic_proxy_mellin_power_bound {a S T : ℝ}
    (ha : 0 < a) (hS : 0 ≤ S) (hT : 0 ≤ T) (Bsave : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, Real.exp (a*L) ≤ Y →
      ∀ (r : ℕ) [NeZero r] (χ : DirichletCharacter ℂ r), χ ≠ 1 → (r : ℝ) ≤ L^T →
      ∀ v : ℝ, |v| ≤ L^T → ∀ m n : ℕ, m ≤ n → Y ≤ (m+1 : ℕ) → (n : ℝ) ≤ 2*Y →
        ‖∑ i ∈ Ioc m n, (primeLogarithmicProxy L S i : ℂ)*
            harmonicMellinWeight v i*χ (i : ZMod r)‖ ≤ L^(-Bsave) := by
  classical
  have ha2 : 0 < a/2 := by positivity
  filter_upwards [eventually_logarithmic_cell_dyad_bounds ha hS,
    eventually_prime_proxy_cell_mellin_power_bound ha2 hT S (Bsave+S+1)]
    with L hcells hlocal
  have hL := hcells.1
  have hδ : 0 < L^(-S) := Real.rpow_pos_of_pos hL _
  intro Y hY r hr χ hχ hrT v hv m n _hmn hYm hn
  let F := Ioc m n
  let f := fun i : ℕ => (primeLogarithmicProxy L S i : ℂ)*
    harmonicMellinWeight v i*χ (i : ZMod r)
  have hF : ∀ i ∈ F, Y ≤ (i : ℝ) ∧ (i : ℝ) ≤ 2*Y := by
    intro i hi
    exact ⟨hYm.trans (Nat.cast_le.mpr (mem_Ioc.mp hi).1),
      (Nat.cast_le.mpr (mem_Ioc.mp hi).2).trans hn⟩
  obtain ⟨hcount, hbases⟩ := hcells.2 Y hY F hF
  have hYsmall : Real.exp ((a/2)*L) ≤ Y := by
    apply le_trans _ hY
    exact Real.exp_le_exp.mpr (by nlinarith)
  have hfiber : ∀ k ∈ logarithmicCellIndices (L^(-S)) F,
      ‖∑ i ∈ F.filter (fun i => logarithmicCellIndex (L^(-S)) i = k), f i‖ ≤
        L^(-(Bsave+S+1)) := by
    intro k hk
    let Z := logarithmicCellBase (L^(-S)) k
    let lo := max m ⌊Z⌋₊
    let hi := min n ⌊Real.exp (L^(-S))*Z⌋₊
    have heq : (∑ i ∈ F.filter (fun i => logarithmicCellIndex (L^(-S)) i = k), f i) =
        ∑ i ∈ Ioc lo hi, (primeCellProxy L S Z i : ℂ)*harmonicMellinWeight v i*χ (i : ZMod r) := by
      change (∑ i ∈ (Ioc m n).filter (fun i => logarithmicCellIndex (L^(-S)) i = k), f i) = _
      rw [logarithmic_interval_fiber hδ]
      apply sum_congr rfl
      intro i hiI
      have hiC : i ∈ logarithmicCellSet (L^(-S)) k := mem_Ioc.mpr
        ⟨(le_max_right _ _).trans_lt (mem_Ioc.mp hiI).1,
          (mem_Ioc.mp hiI).2.trans (min_le_right _ _)⟩
      dsimp [f]
      rw [prime_logarithmic_proxy_eq_on_cell hL hiC]
    rw [heq]
    by_cases hlohi : lo ≤ hi
    · apply hlocal Y Z hYsmall (hbases k hk) r χ hχ hrT v hv lo hi hlohi
      · exact hYm.trans (Nat.cast_le.mpr (Nat.add_le_add_right (le_max_left _ _) 1))
      · exact (Nat.cast_le.mpr (min_le_left _ _)).trans hn
      · exact le_max_right _ _
      · exact min_le_right _ _
    · rw [Ioc_eq_empty_of_le (by omega : hi ≤ lo), sum_empty, norm_zero]
      positivity
  change ‖∑ i ∈ F, f i‖ ≤ _
  rw [← sum_logarithmic_cell_fibers (L^(-S)) F f]
  calc
    _ ≤ ∑ k ∈ logarithmicCellIndices (L^(-S)) F,
        ‖∑ i ∈ F.filter (fun i => logarithmicCellIndex (L^(-S)) i = k), f i‖ := norm_sum_le _ _
    _ ≤ ∑ _k ∈ logarithmicCellIndices (L^(-S)) F, L^(-(Bsave+S+1)) := sum_le_sum hfiber
    _ = ((logarithmicCellIndices (L^(-S)) F).card : ℝ)*L^(-(Bsave+S+1)) := by
      simp only [sum_const, nsmul_eq_mul]
    _ ≤ L^(S+1)*L^(-(Bsave+S+1)) := mul_le_mul_of_nonneg_right hcount (by positivity)
    _ = L^(-Bsave) := by rw [← Real.rpow_add hL]; congr 1; ring

end Bounty
end

section

/- Actual prime-minus-proxy prefix sums are controlled solely by the boundary cells. -/

open Finset Filter

namespace Bounty

theorem eventually_prime_logarithmic_proxy_prefix_bound {a S : ℝ}
    (ha : 0 < a) (hS : 0 ≤ S) :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, Real.exp (a*L) ≤ Y →
      ∀ m n : ℕ, Y ≤ (m+1 : ℕ) → (n : ℝ) ≤ 2*Y →
        ‖∑ i ∈ Ioc m n,
          (((if i.Prime then 1 else 0 : ℝ)-primeLogarithmicProxy L S i : ℝ) : ℂ)‖ ≤
          8*L^(-S)*Y+2 := by
  classical
  have ha2 : 0 < a/2 := by positivity
  obtain ⟨C, _, hproxy⟩ := exists_prime_cell_proxy_uniform_bound ha2
  filter_upwards [eventually_logarithmic_cell_dyad_bounds ha hS,
    eventually_rough_logarithmic_cell_count_pos ha2 S, hproxy S,
    eventually_ge_atTop (1 : ℝ)] with L hcells hden hunit hL1
  have hL := hcells.1
  have hδ : 0 < L^(-S) := Real.rpow_pos_of_pos hL _
  have hδ1 : L^(-S) ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos hL1 (by linarith)
  intro Y hY m n hYm hn
  let δ := L^(-S)
  let g := fun i : ℕ => (((if i.Prime then 1 else 0 : ℝ)-primeLogarithmicProxy L S i : ℝ) : ℂ)
  have hY0 : 0 < Y := (Real.exp_pos _).trans_le hY
  have hF : ∀ i ∈ Ioc m n, Y ≤ (i : ℝ) ∧ (i : ℝ) ≤ 2*Y := by
    intro i hi
    exact ⟨hYm.trans (Nat.cast_le.mpr (mem_Ioc.mp hi).1),
      (Nat.cast_le.mpr (mem_Ioc.mp hi).2).trans hn⟩
  have hbases := (hcells.2 Y hY (Ioc m n) hF).2
  have hzero : ∀ k ∈ logarithmicCellIndices δ (Ioc m n),
      ∑ i ∈ logarithmicCellSet δ k, g i = 0 := by
    intro k hk
    have hR := (hden (logarithmicCellBase δ k) (hbases k hk)).1
    have hz := prime_cell_proxy_full_cell_zero_sum hR
    have heq : (∑ i ∈ logarithmicCellSet δ k, g i) =
        ∑ i ∈ logarithmicCellSet δ k,
          (((if i.Prime then 1 else 0 : ℝ)-primeCellProxy L S (logarithmicCellBase δ k) i : ℝ) : ℂ) := by
      apply sum_congr rfl
      intro i hi
      dsimp [g]
      rw [prime_logarithmic_proxy_eq_on_cell hL hi]
    rw [heq]
    dsimp [logarithmicCellSet, δ]
    exact_mod_cast hz
  have hmass : ∀ k ∈ logarithmicCellIndices δ (Ioc m n),
      (∑ i ∈ logarithmicCellSet δ k, ‖g i‖) ≤ 4*δ*Y+1 := by
    intro k hk
    let Z := logarithmicCellBase δ k
    have hZ : 0 < Z := logarithmic_cell_base_pos δ k
    have hZsmall : Z ≤ 2*Y := by
      obtain ⟨i, hi, hiK⟩ := mem_image.mp hk
      have hi0 : 0 < i := lt_of_le_of_lt (Nat.zero_le _) (mem_Ioc.mp hi).1
      have hiC := (mem_logarithmic_cell_iff hδ hi0 k).mpr hiK
      exact (Nat.lt_of_floor_lt (mem_Ioc.mp hiC).1).le.trans (hF i hi).2
    have hu := hunit Z (hbases k hk)
    have hnorm : ∀ i ∈ logarithmicCellSet δ k, ‖g i‖ ≤ 1 := by
      intro i hi
      dsimp [g]
      rw [prime_logarithmic_proxy_eq_on_cell hL hi, Complex.norm_real, Real.norm_eq_abs]
      have hlo := (hu i).1
      have hup := (hu i).2.1
      split <;> rw [abs_le] <;> constructor <;> linarith
    have hZB : Z ≤ Real.exp δ*Z := le_mul_of_one_le_left hZ.le (Real.one_le_exp hδ.le)
    have hcard : ((logarithmicCellSet δ k).card : ℝ) ≤ Real.exp δ*Z-Z+1 := by
      apply nat_finset_card_le_real_span _ hZB
      intro i hi
      exact ⟨(Nat.lt_of_floor_lt (mem_Ioc.mp hi).1).le,
        (Nat.cast_le.mpr (mem_Ioc.mp hi).2).trans (Nat.floor_le (by positivity))⟩
    have hexp : Real.exp δ-1 ≤ 2*δ := by
      have he := Real.abs_exp_sub_one_le (show |δ| ≤ 1 by rwa [abs_of_pos hδ])
      rw [abs_of_pos hδ] at he
      exact (le_abs_self _).trans he
    calc
      _ ≤ ∑ _i ∈ logarithmicCellSet δ k, (1 : ℝ) := sum_le_sum hnorm
      _ = ((logarithmicCellSet δ k).card : ℝ) := by simp only [sum_const, nsmul_eq_mul, mul_one]
      _ ≤ Real.exp δ*Z-Z+1 := hcard
      _ = (Real.exp δ-1)*Z+1 := by ring
      _ ≤ (2*δ)*Z+1 := by gcongr
      _ ≤ 4*δ*Y+1 := by nlinarith [mul_le_mul_of_nonneg_left hZsmall hδ.le]
  have hb := logarithmic_interval_cancellation_bound hδ m n g
    (M := 4*δ*Y+1) (by positivity) hzero hmass
  convert hb using 1
  dsimp [δ, g]
  ring

end Bounty
end

section

/- Ledger-independent active coefficients preserve the actual physical birth factorization. -/

open Finset Classical
namespace Bounty
section Enriched
variable {Ghost Edge : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (C : Edge → Fin N → Finset (Fin J)) (k : Edge → ℤ)
    (ω : ∀ a, SharedActiveLabels (fun g => ↥(P g))
      (fun g => physicalFullSharedIndices (ell := ell) (C a g)) → PhysicalAuxLabels P (C a) → ℝ)
    (μ : (g : Fin N) → ↥(P g) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (Θ : ∀ a, ((g : Fin N) → Fin (J + ell) → ↥(P g)) →
      ((g : Fin N) → Fin (J + ell) → ↥(P g)) → PhysicalAuxLabels P (C a) → ℂ)

theorem physical_enriched_schedule_birth_factor
    (a : Edge) (H : (g : Fin N) → Finset ↥(P g))
    (x : PhysicalFullBoundedState P J ell B) (e : PhysicalFullEdgeEvent (C a) (k a) x) :
    let sizes := fun g (p : ↥(P g)) => p.val
    let shared := fun a g => physicalFullSharedIndices (ell := ell) (C a g)
    let aux := fun a (_ : SharedActiveLabels (fun g => ↥(P g)) (shared a)) => PhysicalAuxLabels P (C a)
    let delta := fun a => physicalFullEdgeDelta (C a) (k a)
    let displacement := fun a => physicalFullEdgeD (C a)
    physicalFullGlobalEdgePhase (C a) (k a) H (ω a) μ ρ V x e *
      physicalFullActiveFactor (C a) (k a) (Θ a) x e =
      (if FullMixedLocalBirthAvoids (J := Ghost) sizes shared B aux delta displacement H (some (.inr a)) x e ∧
          FullMixedLocalBirthDistinct (J := Ghost) sizes shared B aux delta displacement (some (.inr a)) x e
        then 1 else 0) *
      (physicalFullGlobalEdgePhase (C a) (k a) (fun _ => ∅) (ω a) μ ρ V x e *
        physicalFullActiveFactor (C a) (k a) (Θ a) x e) := by
  dsimp only
  have ha := full_mixed_edge_birth_avoids_iff (J := Ghost) (fun g (p : ↥(P g)) => p.val)
    (fun a g => physicalFullSharedIndices (ell := ell) (C a g)) B
    (fun a _ => PhysicalAuxLabels P (C a))
    (fun a => physicalFullEdgeDelta (C a) (k a)) (fun a => physicalFullEdgeD (C a)) a H x e
  have hd := full_mixed_edge_birth_distinct_iff (J := Ghost) (fun g (p : ↥(P g)) => p.val)
    (fun a g => physicalFullSharedIndices (ell := ell) (C a g)) B
    (fun a _ => PhysicalAuxLabels P (C a))
    (fun a => physicalFullEdgeDelta (C a) (k a)) (fun a => physicalFullEdgeD (C a)) a x e
  have h := congrArg (fun z : ℂ => z * physicalFullActiveFactor (C a) (k a) (Θ a) x e)
    (physical_full_global_birth_factor (C a) (k a) H (ω a) μ ρ V x e)
  simpa only [ha, hd, mul_assoc] using h

end Enriched
end Bounty
end

section

/- Uniform nonprincipal Mellin cancellation for an actual rough-test proxy on a truncated cell. -/

open Finset Filter

namespace Bounty

theorem eventually_rough_test_proxy_cell_mellin_power_bound {a T γ : ℝ}
    (ha : 0 < a) (hγ : 0 < γ) (hT : 0 ≤ T) (S Bsave : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ Y Z : ℝ, Real.exp (a*L) ≤ Y → Real.exp (a*L) ≤ Z →
      ∀ (r : ℕ) [NeZero r] (χ : DirichletCharacter ℂ r), χ ≠ 1 → (r : ℝ) ≤ L^T →
      ∀ v : ℝ, |v| ≤ L^T → ∀ m n : ℕ, m ≤ n → Y ≤ (m+1 : ℕ) → (n : ℝ) ≤ 2*Y →
        ⌊Z⌋₊ ≤ m → n ≤ ⌊Real.exp (L^(-S))*Z⌋₊ →
        ‖∑ i ∈ Ioc m n, (roughTestCellProxy γ L S Z i : ℂ)*
            harmonicMellinWeight v i*χ (i : ZMod r)‖ ≤ L^(-Bsave) := by
  filter_upwards [eventually_rough_interval_mellin_power_bound ha hT Bsave, eventually_rough_test_proxy_cutoff hγ]
    with L hrough hcut
  intro Y Z hY _hZ r hr χ hχ hrT v hv m n hmn hYm hn hZm hnZ
  have hc := rough_test_cell_coefficient_bounds (S := S) (Y := Z) hcut
  have hraw := hrough Y hY r χ hχ hrT v hv m n hmn hYm hn
  have hid : (∑ i ∈ Ioc m n, (roughTestCellProxy γ L S Z i : ℂ)*
      harmonicMellinWeight v i*χ (i : ZMod r)) =
      (roughTestCellProxyCoefficient γ L S Z : ℂ)*
        ∑ i ∈ (Ioc m n).filter (fun i : ℕ =>
          ∀ p ∈ i.primeFactors, Real.exp (Real.sqrt L) < (p : ℝ)),
          harmonicMellinWeight v i*χ (i : ZMod r) := by
    rw [mul_sum, sum_filter]
    apply sum_congr rfl
    intro i hi
    have hiI : i ∈ Ioc ⌊Z⌋₊ ⌊Real.exp (L^(-S))*Z⌋₊ :=
      mem_Ioc.mpr ⟨hZm.trans_lt (mem_Ioc.mp hi).1, (mem_Ioc.mp hi).2.trans hnZ⟩
    by_cases hp : ∀ p ∈ i.primeFactors, Real.exp (Real.sqrt L) < (p : ℝ)
    · have hiR : i ∈ roughBand Z (Real.exp (L^(-S))*Z) (Real.exp (Real.sqrt L)) :=
        mem_filter.mpr ⟨hiI, hp⟩
      simp only [roughTestCellProxy, if_pos hiR, if_pos hp, mul_assoc]
    · have hiR : i ∉ roughBand Z (Real.exp (L^(-S))*Z) (Real.exp (Real.sqrt L)) :=
        fun hh => hp (mem_filter.mp hh).2
      simp only [roughTestCellProxy, if_neg hiR, if_neg hp, Complex.ofReal_zero, zero_mul]
  rw [hid, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hc.1]
  exact (mul_le_mul hc.2 hraw (norm_nonneg _) zero_le_one).trans_eq (one_mul _)

end Bounty
end

section

/- Exact principal-character reduction on the rough-test difference support. -/

open Finset Filter

namespace Bounty

theorem rough_test_logarithmic_proxy_principal_identity (γ L S : ℝ) {n r : ℕ}
    (hcut : Real.sqrt L ≤ γ*L) (hn : 0 < n)
    (hr : 0 < r) (hrW : (r : ℝ) ≤ Real.exp (Real.sqrt L)) :
    ((roughTestIndicator γ L n-roughTestLogarithmicProxy γ L S n : ℝ) : ℂ)*
      (1 : DirichletCharacter ℂ r) (n : ZMod r) =
    ((roughTestIndicator γ L n-roughTestLogarithmicProxy γ L S n : ℝ) : ℂ) := by
  classical
  by_cases ht : exponentialRoughTest γ L n
  · have hcop : n.Coprime r := coprime_of_small_prime_avoidance hr hrW (by
      intro p hp hpn
      have hpf : p ∈ n.primeFactors := Nat.mem_primeFactors.mpr ⟨(mem_filter.mp hp).2, hpn, hn.ne'⟩
      have hlarge := (Real.exp_le_exp.mpr hcut).trans_lt (ht p hpf)
      have hsmall := (Nat.cast_le.mpr (mem_Ioc.mp (mem_filter.mp hp).1).2).trans
        (Nat.floor_le (Real.exp_pos (Real.sqrt L)).le)
      exact (not_lt_of_ge hsmall) hlarge)
    rw [MulChar.one_apply ((ZMod.isUnit_iff_coprime _ _).mpr hcop), mul_one]
  · by_cases hz : roughTestLogarithmicProxy γ L S n = 0
    · simp only [roughTestIndicator, if_neg ht, hz, sub_zero, Complex.ofReal_zero, zero_mul]
    · have hcop : n.Coprime r := coprime_of_small_prime_avoidance hr hrW
        (rough_band_avoids_small_primes (rough_test_cell_proxy_ne_zero_mem hz))
      rw [MulChar.one_apply ((ZMod.isUnit_iff_coprime _ _).mpr hcop), mul_one]

theorem eventually_rough_test_proxy_principal_identity {γ : ℝ}
    (hγ : 0 < γ) (S T : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ n : ℕ, 0 < n → ∀ r : ℕ, 0 < r → (r : ℝ) ≤ L^T →
      ((roughTestIndicator γ L n-roughTestLogarithmicProxy γ L S n : ℝ) : ℂ)*
        (1 : DirichletCharacter ℂ r) (n : ZMod r) =
      ((roughTestIndicator γ L n-roughTestLogarithmicProxy γ L S n : ℝ) : ℂ) := by
  classical
  filter_upwards [eventually_rpow_le_exp_sqrt T, eventually_rough_test_proxy_cutoff hγ]
    with L hmod hcut
  intro n hn r hr hrT
  exact rough_test_logarithmic_proxy_principal_identity γ L S hcut hn hr (hrT.trans hmod)

end Bounty
end

section

/- Actual prime-minus-proxy prefix sums are controlled solely by the boundary cells. -/

open Finset Filter

namespace Bounty

theorem eventually_rough_test_logarithmic_proxy_prefix_bound {a S γ : ℝ}
    (ha : 0 < a) (hγ : 0 < γ) (hS : 0 ≤ S) :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, Real.exp (a*L) ≤ Y →
      ∀ m n : ℕ, Y ≤ (m+1 : ℕ) → (n : ℝ) ≤ 2*Y →
        ‖∑ i ∈ Ioc m n,
          ((roughTestIndicator γ L i-roughTestLogarithmicProxy γ L S i : ℝ) : ℂ)‖ ≤
          8*L^(-S)*Y+2 := by
  classical
  have ha2 : 0 < a/2 := by positivity
  filter_upwards [eventually_logarithmic_cell_dyad_bounds ha hS,
    eventually_rough_logarithmic_cell_count_pos ha2 S, eventually_rough_test_proxy_cutoff hγ,
    eventually_ge_atTop (1 : ℝ)] with L hcells hden hcut hL1
  have hL := hcells.1
  have hδ : 0 < L^(-S) := Real.rpow_pos_of_pos hL _
  have hδ1 : L^(-S) ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos hL1 (by linarith)
  intro Y hY m n hYm hn
  let δ := L^(-S)
  let g := fun i : ℕ => ((roughTestIndicator γ L i-roughTestLogarithmicProxy γ L S i : ℝ) : ℂ)
  have hY0 : 0 < Y := (Real.exp_pos _).trans_le hY
  have hF : ∀ i ∈ Ioc m n, Y ≤ (i : ℝ) ∧ (i : ℝ) ≤ 2*Y := by
    intro i hi
    exact ⟨hYm.trans (Nat.cast_le.mpr (mem_Ioc.mp hi).1),
      (Nat.cast_le.mpr (mem_Ioc.mp hi).2).trans hn⟩
  have hbases := (hcells.2 Y hY (Ioc m n) hF).2
  have hzero : ∀ k ∈ logarithmicCellIndices δ (Ioc m n),
      ∑ i ∈ logarithmicCellSet δ k, g i = 0 := by
    intro k hk
    have hR := (hden (logarithmicCellBase δ k) (hbases k hk)).1
    have hz := rough_test_cell_proxy_full_cell_zero_sum (γ := γ) hR
    have heq : (∑ i ∈ logarithmicCellSet δ k, g i) =
        ∑ i ∈ logarithmicCellSet δ k,
          ((roughTestIndicator γ L i-roughTestCellProxy γ L S (logarithmicCellBase δ k) i : ℝ) : ℂ) := by
      apply sum_congr rfl
      intro i hi
      dsimp [g]
      rw [rough_test_logarithmic_proxy_eq_on_cell hL hi]
    rw [heq]
    dsimp [logarithmicCellSet, δ]
    exact_mod_cast hz
  have hmass : ∀ k ∈ logarithmicCellIndices δ (Ioc m n),
      (∑ i ∈ logarithmicCellSet δ k, ‖g i‖) ≤ 4*δ*Y+1 := by
    intro k hk
    let Z := logarithmicCellBase δ k
    have hZ : 0 < Z := logarithmic_cell_base_pos δ k
    have hZsmall : Z ≤ 2*Y := by
      obtain ⟨i, hi, hiK⟩ := mem_image.mp hk
      have hi0 : 0 < i := lt_of_le_of_lt (Nat.zero_le _) (mem_Ioc.mp hi).1
      have hiC := (mem_logarithmic_cell_iff hδ hi0 k).mpr hiK
      exact (Nat.lt_of_floor_lt (mem_Ioc.mp hiC).1).le.trans (hF i hi).2
    have hu := rough_test_cell_proxy_bounds (γ := γ) (L := L) (S := S) (Y := Z) hcut
    have hnorm : ∀ i ∈ logarithmicCellSet δ k, ‖g i‖ ≤ 1 := by
      intro i hi
      dsimp [g]
      rw [rough_test_logarithmic_proxy_eq_on_cell hL hi, Complex.norm_real, Real.norm_eq_abs]
      have hlo := (hu i).1
      have hup := (hu i).2
      unfold roughTestIndicator
      split <;> rw [abs_le] <;> constructor <;> linarith
    have hZB : Z ≤ Real.exp δ*Z := le_mul_of_one_le_left hZ.le (Real.one_le_exp hδ.le)
    have hcard : ((logarithmicCellSet δ k).card : ℝ) ≤ Real.exp δ*Z-Z+1 := by
      apply nat_finset_card_le_real_span _ hZB
      intro i hi
      exact ⟨(Nat.lt_of_floor_lt (mem_Ioc.mp hi).1).le,
        (Nat.cast_le.mpr (mem_Ioc.mp hi).2).trans (Nat.floor_le (by positivity))⟩
    have hexp : Real.exp δ-1 ≤ 2*δ := by
      have he := Real.abs_exp_sub_one_le (show |δ| ≤ 1 by rwa [abs_of_pos hδ])
      rw [abs_of_pos hδ] at he
      exact (le_abs_self _).trans he
    calc
      _ ≤ ∑ _i ∈ logarithmicCellSet δ k, (1 : ℝ) := sum_le_sum hnorm
      _ = ((logarithmicCellSet δ k).card : ℝ) := by simp only [sum_const, nsmul_eq_mul, mul_one]
      _ ≤ Real.exp δ*Z-Z+1 := hcard
      _ = (Real.exp δ-1)*Z+1 := by ring
      _ ≤ (2*δ)*Z+1 := by gcongr
      _ ≤ 4*δ*Y+1 := by nlinarith [mul_le_mul_of_nonneg_left hZsmall hδ.le]
  have hb := logarithmic_interval_cancellation_bound hδ m n g
    (M := 4*δ*Y+1) (by positivity) hzero hmass
  convert hb using 1
  dsimp [δ, g]
  ring

end Bounty
end

section

/- Rank is exactly the sum of selected-child counts over original owners and groups. -/

open Finset Classical

namespace Bounty

theorem forest_rank_partition {n : ℕ} {O G : Type*}
    [Fintype O] [DecidableEq O] [Fintype G] [DecidableEq G]
    (code : BirthForestCode n) (owner : Fin n → O) (group : Fin n → G) :
    (∑ u, ∑ g, (univ.filter (fun i => owner i = u ∧ group i = g ∧ code i ≠ none)).card) =
      birthForestRank code := by
  have h := sum_card_fiberwise_eq_card_filter
    (univ.filter (fun i => code i ≠ none)) (univ : Finset (O × G)) (fun i => (owner i, group i))
  simp only [mem_univ, filter_true] at h
  rw [Fintype.sum_prod_type] at h
  calc
    _ = ∑ u, ∑ g, ((univ.filter (fun i => code i ≠ none)).filter
        (fun i => (owner i, group i) = (u, g))).card := by
      apply sum_congr rfl
      intro u _
      apply sum_congr rfl
      intro g _
      congr 1
      ext i
      simp only [mem_filter, mem_univ, true_and, Prod.mk.injEq]
      tauto
    _ = (univ.filter (fun i => code i ≠ none)).card := h
    _ = birthForestRank code := by
      rw [birthForestRank_eq_card_isSome]
      congr 1
      ext i
      simp only [mem_filter, mem_univ, true_and]
      cases code i <;> simp

noncomputable def fullMixedSelectedCount
    {J K : Type*} {N : ℕ} {M : Fin N → ℕ}
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ) (steps : List (Option (J ⊕ K)))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps)))
    (u : Fin steps.length) (g : Fin N) : ℕ :=
  (univ.filter (fun i => fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i) = u ∧
    (fullMixedBirthOrder S B steps i).2.1 = g ∧ code i ≠ none)).card

theorem full_mixed_selected_count_sum
    {J K : Type*} {N : ℕ} {M : Fin N → ℕ}
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ) (steps : List (Option (J ⊕ K)))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps))) :
    (∑ u, ∑ g, fullMixedSelectedCount S B steps code u g) = birthForestRank code :=
  forest_rank_partition code (fun i => fullMixedBirthOwner S B steps (fullMixedBirthOrder S B steps i))
    (fun i => (fullMixedBirthOrder S B steps i).2.1)

theorem full_mixed_head_selected_count_eq
    {J K : Type*} {N : ℕ} {M : Fin N → ℕ}
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (tag : Option (J ⊕ K)) (steps : List (Option (J ⊕ K)))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B (tag :: steps)))) (g : Fin N) :
    fullMixedHeadSelectedCount S B tag steps code g =
      fullMixedSelectedCount S B (tag :: steps) code 0 g := rfl

theorem full_mixed_selected_power_prod
    {J K : Type*} {N : ℕ} {M : Fin N → ℕ}
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ) (steps : List (Option (J ⊕ K)))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B steps))) (x : ℝ) :
    (∏ u, ∏ g, x ^ fullMixedSelectedCount S B steps code u g) = x ^ birthForestRank code := by
  simp_rw [prod_pow_eq_pow_sum]
  rw [full_mixed_selected_count_sum]

end Bounty
end

section

/- The actual chronological forest product has the fixed original selected-child exponents. -/

open Finset Classical

namespace Bounty

section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K)))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)

section Ghost
variable (j : J) (sk : CoupledGhostSkeleton M B s) (births : CoupledGhostSamples M B s sk)
    (tail : FullPermutationMixedPath n S B A Δ D steps
      (fullPermutationMixedEventTarget n S B A Δ D (some (.inl j)) s ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩)))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B (some (.inl j) :: steps))))

theorem full_mixed_ghost_head_forest_cost_eq {α : Type*}
    (hchildren : ∀ i, code i ≠ none →
      fullMixedPathBirthPerformed n S B A Δ D (some (.inl j) :: steps) s ⟨(fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩, tail⟩
        (fullMixedBirthOrder S B (some (.inl j) :: steps) i))
    (values : Fin (Fintype.card (FullMixedBirthAddress S B (some (.inl j) :: steps))) → α)
    (root atom : Fin N → ℝ) :
    let ord := fullMixedGhostHeadSampleOrder S B j steps s sk
    let embed := (fun c => (fullMixedGhostHeadSampleEmbedding S B j steps s sk) c) ∘ ord
    (∏ i, match restrictedBirthCode embed code i with
      | some _ => atom (ord i).1
      | none => match restrictedBirthAnchors embed code values i with
        | none => root (ord i).1 | some _ => atom (ord i).1) =
      ∏ g, atom g ^ (fullMixedHeadSelectedCount S B (some (.inl j)) steps code g) * root g ^ ((sk g).1.val - fullMixedHeadSelectedCount S B (some (.inl j)) steps code g) := by
  have h := grouped_restricted_forest_cost_eq (fun g => Fin (sk g).1.val)
    (fullMixedGhostHeadSampleOrder S B j steps s sk) (fun c => (fullMixedGhostHeadSampleEmbedding S B j steps s sk) c)
    code values root atom (fullMixedHeadSelectedCount S B (some (.inl j)) steps code)
    (fun g => full_mixed_ghost_head_selected_count n S B A Δ D steps s j sk births tail code hchildren g)
  convert h using 1
  · apply prod_congr rfl
    intro i _
    split <;> (try split) <;> simp_all
  · simp only [Fintype.card_fin]

end Ghost

section Edge
variable (k : K) (sk : FullActiveEdgeSkeleton n (S k) B (A k) (Δ k) (D k) s) (fresh : FullActiveEdgeSamples n (S k) B (A k) (Δ k) (D k) s sk)
    (tail : FullPermutationMixedPath n S B A Δ D steps
      (fullPermutationMixedEventTarget n S B A Δ D (some (.inr k)) s ((fullPermutationEdgeBirthEquiv (J := J) n S B A Δ D s k).symm ⟨sk, fresh⟩)))
    (code : BirthForestCode (Fintype.card (FullMixedBirthAddress S B (some (.inr k) :: steps))))

theorem full_mixed_edge_head_forest_cost_eq {α : Type*}
    (hchildren : ∀ i, code i ≠ none →
      fullMixedPathBirthPerformed n S B A Δ D (some (.inr k) :: steps) s ⟨(fullPermutationEdgeBirthEquiv (J := J) n S B A Δ D s k).symm ⟨sk, fresh⟩, tail⟩
        (fullMixedBirthOrder S B (some (.inr k) :: steps) i))
    (values : Fin (Fintype.card (FullMixedBirthAddress S B (some (.inr k) :: steps))) → α)
    (root atom : Fin N → ℝ) :
    let ord := fullMixedEdgeHeadSampleOrder n S B k steps (A k) (Δ k) (D k) s sk
    let embed := (fun c => (fullMixedEdgeHeadSampleEmbedding n S B k steps (A k) (Δ k) (D k) s sk) c) ∘ ord
    (∏ i, match restrictedBirthCode embed code i with
      | some _ => atom (ord i).1
      | none => match restrictedBirthAnchors embed code values i with
        | none => root (ord i).1 | some _ => atom (ord i).1) =
      ∏ g, atom g ^ (fullMixedHeadSelectedCount S B (some (.inr k)) steps code g) * root g ^ (((S k g)ᶜ.card - (sk.2 g).2.1.card) - fullMixedHeadSelectedCount S B (some (.inr k)) steps code g) := by
  have h := grouped_restricted_forest_cost_eq (fun g => {i : Fin (S k g)ᶜ.card // i ∉ (sk.2 g).2.1})
    (fullMixedEdgeHeadSampleOrder n S B k steps (A k) (Δ k) (D k) s sk) (fun c => (fullMixedEdgeHeadSampleEmbedding n S B k steps (A k) (Δ k) (D k) s sk) c)
    code values root atom (fullMixedHeadSelectedCount S B (some (.inr k)) steps code)
    (fun g => full_mixed_edge_head_selected_count n S B A Δ D steps s k sk fresh tail code hchildren g)
  convert h using 1
  · apply prod_congr rfl
    intro i _
    split <;> (try split) <;> simp_all
  · simp only [Fintype.card_subtype_compl, Fintype.card_fin, Fintype.card_coe]

end Edge

end Full
end Bounty
