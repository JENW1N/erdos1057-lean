section

/- Uniform size and product bounds for factor-two blocks meeting the candidate window. -/

open Finset Filter

namespace Bounty

theorem candidate_Q_zero_factor_two_geometry {c L : ℝ} {r p n : ℕ} {P U : ℝ}
    (hc : 0 < c) (hr : 0 < r)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1) (hL : 0 ≤ L)
    (hp : p ∈ candidateQBand (c*L) 0)
    (hprod : p*n ∈ arithmeticProductWindow 1 (Real.exp L))
    (hpP : (p : ℝ) ≤ P) (hPp : P ≤ 2*(p : ℝ))
    (hnU : (n : ℝ) ≤ U) (hUn : U ≤ 2*(n : ℝ)) :
    Real.exp (c*L) < P ∧ Real.exp (c*L) < U ∧
      P ≤ 32*Real.exp ((1-c)*L) ∧ U ≤ 32*Real.exp ((1-c)*L) ∧
      P ≤ 32*Real.exp L ∧ U ≤ 32*Real.exp L ∧ P*U ≤ 64*Real.exp L := by
  obtain ⟨hpLo, hnLo, hnHi, hpHi, hpL, hnL, hpn⟩ :=
    candidate_Q_zero_prime_remainder_geometry hc hr hcenter hL hp hprod
  refine ⟨hpLo.trans_le hpP, hnLo.trans_le hnU, ?_, ?_, ?_, ?_, ?_⟩
  · nlinarith [Real.exp_pos ((1-c)*L)]
  · linarith
  · linarith
  · linarith
  · calc
      P*U ≤ (2*(p : ℝ))*(2*(n : ℝ)) :=
        mul_le_mul hPp hUn ((Nat.cast_nonneg n).trans hnU) (by positivity)
      _ = 4*((p : ℝ)*(n : ℝ)) := by ring
      _ ≤ 64*Real.exp L := by linarith

theorem eventually_candidate_Q_zero_factor_two_margin {c : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1) :
    ∀ᶠ L : ℝ in atTop, ∀ (p n : ℕ) (P U : ℝ),
      p ∈ candidateQBand (c*L) 0 →
      p*n ∈ arithmeticProductWindow 1 (Real.exp L) →
      (p : ℝ) ≤ P → P ≤ 2*(p : ℝ) → (n : ℝ) ≤ U → U ≤ 2*(n : ℝ) →
      Real.exp (c*L) < P ∧ Real.exp (c*L) < U ∧
        P ≤ Real.exp ((1-c/2)*L) ∧ U ≤ Real.exp ((1-c/2)*L) ∧
        P*U ≤ 64*Real.exp L := by
  filter_upwards [eventually_ge_atTop ((2*Real.log 32)/c),
    eventually_ge_atTop (0 : ℝ)] with L hthreshold hL
  intro p n P U hp hprod hpP hPp hnU hUn
  obtain ⟨hPLo, hULo, hPHi, hUHi, _, _, hPU⟩ :=
    candidate_Q_zero_factor_two_geometry hc hr hcenter hL hp hprod hpP hPp hnU hUn
  have hlog : Real.log 32 ≤ (c/2)*L := by
    have h := (div_le_iff₀ hc).mp hthreshold
    nlinarith
  have h32 : (32 : ℝ) ≤ Real.exp ((c/2)*L) := by
    calc
      _ = Real.exp (Real.log 32) := (Real.exp_log (by norm_num)).symm
      _ ≤ _ := Real.exp_le_exp.mpr hlog
  have hupper : 32*Real.exp ((1-c)*L) ≤ Real.exp ((1-c/2)*L) := by
    calc
      _ ≤ Real.exp ((c/2)*L)*Real.exp ((1-c)*L) :=
        mul_le_mul_of_nonneg_right h32 (Real.exp_nonneg _)
      _ = _ := by rw [← Real.exp_add]; congr 1; ring
  exact ⟨hPLo, hULo, hPHi.trans hupper, hUHi.trans hupper, hPU⟩

end Bounty

end

