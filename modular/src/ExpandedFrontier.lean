/- Absolute coefficient-mass control for the new harmonic source frequency. -/

open Finset MeasureTheory

namespace Bounty

theorem harmonic_source_four_box_integrand_norm (Y s u : ℝ) (D A B C : Finset ℕ)
    (δ α β γ : ℕ → ℂ) :
    ‖harmonicSourceLogFourier u * physicalMellinPhase (-2 * Real.pi * u) Y *
      ((∑ d ∈ D, δ d * physicalMellinPhase (s + 2 * Real.pi * u) d) *
        (∑ a ∈ A, α a * physicalMellinPhase (s + 2 * Real.pi * u) a) *
        (∑ b ∈ B, β b * physicalMellinPhase (s + 2 * Real.pi * u) b) *
        (∑ c ∈ C, γ c * physicalMellinPhase (s + 2 * Real.pi * u) c))‖ ≤
      ‖harmonicSourceLogFourier u‖ *
        ((∑ d ∈ D, ‖δ d‖) * (∑ a ∈ A, ‖α a‖) *
          (∑ b ∈ B, ‖β b‖) * (∑ c ∈ C, ‖γ c‖)) := by
  have hb (S : Finset ℕ) (f : ℕ → ℂ) :
      ‖∑ n ∈ S, f n * physicalMellinPhase (s + 2 * Real.pi * u) n‖ ≤
        ∑ n ∈ S, ‖f n‖ := by
    apply (norm_sum_le _ _).trans
    simp only [norm_mul, physical_mellin_phase_norm, mul_one, le_refl]
  simp only [norm_mul, physical_mellin_phase_norm, mul_one]
  exact mul_le_mul_of_nonneg_left
    (mul_le_mul (mul_le_mul (mul_le_mul (hb D δ) (hb A α)
      (norm_nonneg _) (by positivity)) (hb B β) (norm_nonneg _) (by positivity))
      (hb C γ) (norm_nonneg _) (by positivity)) (norm_nonneg _)

end Bounty
