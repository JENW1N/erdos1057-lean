theorem clean_hybrid_between_density_conjugation {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (hb : ∀ g p, 0 < b g p)
    (C : G → Finset (Fin J)) (ζ θ ρ : ℝ) (k : ℤ) (B : G → ℕ)
    (p : FixedOrderedMemoryLabels Pb N) (r : FixedOrderedResidues p)
    (K : RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb C → ℂ)
    (d : PhysicalSharedLists Ps J) (aux : PhysicalAuxLabels Pb C)
    (source target : RepeatedBigLists Pb J ell) :
    ((Real.sqrt (cleanActiveDensity b source) / Real.sqrt (cleanActiveDensity b target) : ℝ) : ℂ) *
        cleanHybridBetweenKernel Vb b C ζ θ ρ k B p r K d aux source target =
      (Real.sqrt (cleanUnsharedDensity b C source * cleanUnsharedDensity b C target) : ℂ) *
        cleanHybridBetweenKernel Vb (fun _ _ => 1) C ζ θ ρ k B p r K d aux source target := by
  unfold cleanHybridBetweenKernel
  simp only [← mul_assoc]
  rw [repeated_big_kernel_density_conjugation Vb b hb]
end

section

open Finset
open scoped Classical

theorem repeated_big_shared_compatible_symm {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) {source target : RepeatedBigLists P J ell}
    (h : repeatedBigSharedCompatible C source target) :
    repeatedBigSharedCompatible C target source := fun g j hj => (h g j hj).symm

/-- The shared factors cancel between the source and target product measures.
The identity even holds for an arbitrary baseline, before positivity or normalization. -/
theorem repeated_big_active_target_mass_balance {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) {source target : RepeatedBigLists P J ell}
    (h : repeatedBigSharedCompatible C source target) :
    repeatedBigActiveMass V b source * repeatedBigTargetMass V b C target =
      repeatedBigActiveMass V b target * repeatedBigTargetMass V b C source := by
  let shared (L : RepeatedBigLists P J ell) : ℝ :=
    ∏ g, ∏ s ∈ physicalSharedSlots (ell := ell) (C g), tiltedPhysicalBirthLaw V g (b g) (L g s)
  have hsplit (L : RepeatedBigLists P J ell) :
      repeatedBigActiveMass V b L = shared L * repeatedBigTargetMass V b C L := by
    rw [repeated_big_target_mass_physical]
    unfold repeatedBigActiveMass shared physicalUnsharedSlots
    rw [← prod_mul_distrib]
    apply prod_congr rfl
    intro g hg
    exact (prod_mul_prod_compl _ _).symm
  have hshared : shared source = shared target := by
    apply prod_congr rfl
    intro g hg
    apply prod_congr rfl
    intro s hs
    obtain ⟨j, hj, rfl⟩ := mem_map.mp hs
    change tiltedPhysicalBirthLaw V g (b g) (source g (Sum.inl j)) =
      tiltedPhysicalBirthLaw V g (b g) (target g (Sum.inl j))
    rw [h g j (mem_sdiff.mp hj).2]
  rw [hsplit source, hsplit target, hshared]
  ring

/-- Reversing the endpoints preserves the two auxiliary bans and the untilted
auxiliary law. Swapping K gives an exact weighted transpose identity. -/
theorem repeated_big_kernel_weighted_transpose {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (source target : RepeatedBigLists P J ell) :
    (repeatedBigActiveMass V b source : ℂ) * repeatedBigKernel V b C ζ K aux source target =
      (repeatedBigActiveMass V b target : ℂ) *
        repeatedBigKernel V b C ζ (fun x y a => K y x a) aux target source := by
  have hs : repeatedBigSharedCompatible C source target ↔
      repeatedBigSharedCompatible C target source :=
    ⟨repeated_big_shared_compatible_symm C, repeated_big_shared_compatible_symm C⟩
  by_cases h : repeatedBigSharedCompatible C source target ∧
      repeatedBigAuxAvoids C aux source ∧ repeatedBigAuxAvoids C aux target
  · have hr : repeatedBigSharedCompatible C target source ∧
        repeatedBigAuxAvoids C aux target ∧ repeatedBigAuxAvoids C aux source :=
      ⟨hs.mp h.1, h.2.2, h.2.1⟩
    simp only [repeatedBigKernel]
    rw [if_pos h, if_pos hr]
    rw [← repeated_big_D_eq_of_shared C h.1 aux]
    have hm := congrArg (fun x : ℝ => (x : ℂ))
      (repeated_big_active_target_mass_balance V b C h.1)
    push_cast at hm ⊢
    linear_combination (physicalAuxMass V C aux : ℂ) * K source target aux *
      physicalPhase ζ (repeatedBigD C source aux) * hm
  · have hr : ¬ (repeatedBigSharedCompatible C target source ∧
        repeatedBigAuxAvoids C aux target ∧ repeatedBigAuxAvoids C aux source) := by
      rintro ⟨hc, ht, hs'⟩
      exact h ⟨hs.mpr hc, hs', ht⟩
    simp [repeatedBigKernel, h, hr]

theorem repeated_big_untilted_active_mass_nonneg {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (hV : ∀ g, 0 ≤ V g)
    (source : RepeatedBigLists P J ell) :
    0 ≤ repeatedBigActiveMass V (fun _ _ => 1) source := by
  unfold repeatedBigActiveMass
  apply prod_nonneg
  intro g hg
  apply prod_nonneg
  intro s hs
  simpa only [tiltedPhysicalBirthLaw, div_one] using physical_label_law_nonneg V hV g (source g s)

theorem repeated_big_untilted_kernel_weighted_norm_reverse {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (hV : ∀ g, 0 ≤ V g)
    (C : G → Finset (Fin J)) (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (source target : RepeatedBigLists P J ell) :
    repeatedBigActiveMass V (fun _ _ => 1) source *
        ‖repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target‖ =
      repeatedBigActiveMass V (fun _ _ => 1) target *
        ‖repeatedBigKernel V (fun _ _ => 1) C ζ (fun x y a => K y x a) aux target source‖ := by
  have h := congrArg norm (repeated_big_kernel_weighted_transpose V (fun _ _ => 1) C ζ K aux source target)
  simpa only [norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (repeated_big_untilted_active_mass_nonneg V hV source),
    abs_of_nonneg (repeated_big_untilted_active_mass_nonneg V hV target)] using h
end

section

/-- The logarithm in a character prefix estimate loses only a logarithmic ratio. -/
theorem reciprocal_character_shell_scale_le {q x C : ℝ}
    (hq : 1 ≤ q) (hx : 2 ≤ x) (hC : 0 ≤ C) :
    2 * (1 / (x * Real.log x)) *
      (C * (2 * x) ^ ((31 : ℝ) / 32) * Real.log (q * (2 * x))) ≤
    8 * C * x ^ (-(1 : ℝ) / 32) * (1 + Real.log q / Real.log x) := by
  have hx0 : 0 < x := by linarith
  have hq0 : 0 < q := by linarith
  have hlx : 0 < Real.log x := Real.log_pos (by linarith)
  have hlq : 0 ≤ Real.log q := Real.log_nonneg hq
  have hltwo : Real.log 2 ≤ Real.log x := Real.log_le_log (by norm_num) hx
  have hp : (2 : ℝ) ^ ((31 : ℝ) / 32) ≤ 2 :=
    Real.rpow_le_self_of_one_le (by norm_num) (by norm_num)
  have hxpow : x ^ ((31 : ℝ) / 32) = x * x ^ (-(1 : ℝ) / 32) := by
    calc
      _ = x ^ ((1 : ℝ) + (-(1 : ℝ) / 32)) := by norm_num
      _ = x ^ (1 : ℝ) * x ^ (-(1 : ℝ) / 32) := Real.rpow_add hx0 _ _
      _ = _ := by rw [Real.rpow_one]
  have hl : Real.log (q * (2 * x)) ≤ 2 * (Real.log x + Real.log q) := by
    rw [Real.log_mul hq0.ne' (by positivity), Real.log_mul (by norm_num) hx0.ne']
    linarith
  have hratio : Real.log (q * (2 * x)) / Real.log x ≤
      2 * (1 + Real.log q / Real.log x) := by
    apply (div_le_iff₀ hlx).mpr
    calc
      _ ≤ 2 * (Real.log x + Real.log q) := hl
      _ = _ := by field_simp
  have hr0 : 0 ≤ Real.log (q * (2 * x)) / Real.log x := by
    apply div_nonneg _ hlx.le
    exact Real.log_nonneg (by nlinarith)
  calc
    _ = (2 * C * (2 : ℝ) ^ ((31 : ℝ) / 32) * x ^ (-(1 : ℝ) / 32)) *
        (Real.log (q * (2 * x)) / Real.log x) := by
      rw [Real.mul_rpow (by norm_num) hx0.le, hxpow]
      field_simp
    _ ≤ (2 * C * 2 * x ^ (-(1 : ℝ) / 32)) *
        (2 * (1 + Real.log q / Real.log x)) := by
      have hfirst : 2 * C * (2 : ℝ) ^ ((31 : ℝ) / 32) * x ^ (-(1 : ℝ) / 32) ≤
          2 * C * 2 * x ^ (-(1 : ℝ) / 32) :=
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hp (by positivity))
          (Real.rpow_nonneg hx0.le _)
      exact mul_le_mul hfirst hratio hr0 (by positivity)
    _ = _ := by ring

/-- Every subinterval ending within twice its lower endpoint has a true
reciprocal-prime power saving. The prefix hypothesis is the actual twisted theta sum. -/
theorem reciprocal_prime_partial_dyadic_shell_bound {q : ℕ}
    (χ : DirichletCharacter ℂ q) (hq : 0 < q) {C : ℝ} (hC : 0 ≤ C)
    (hbound : ∀ z : ℝ, 2 ≤ z → ‖twistedTheta χ z‖ ≤
      C * z ^ ((31 : ℝ) / 32) * Real.log ((q : ℝ) * z))
    {x y : ℝ} (hx : 2 ≤ x) (hxy : x ≤ y) (hy : y ≤ 2 * x) :
    ‖∑ p ∈ (Finset.Ioc ⌊x⌋₊ ⌊y⌋₊).filter Nat.Prime,
      (1 / (p : ℝ)) • χ (p : ZMod q)‖ ≤
      8 * C * x ^ (-(1 : ℝ) / 32) * (1 + Real.log q / Real.log x) := by
  have hx0 : 0 < x := by linarith
  have hy0 : 0 ≤ y := by linarith
  have hq1 : (1 : ℝ) ≤ q := by exact_mod_cast hq
  let B := C * (2 * x) ^ ((31 : ℝ) / 32) * Real.log ((q : ℝ) * (2 * x))
  have hB : 0 ≤ B := by
    have hl : 0 ≤ Real.log ((q : ℝ) * (2 * x)) := Real.log_nonneg (by nlinarith)
    positivity
  have hm : 2 ≤ ⌊x⌋₊ := by
    apply Nat.le_floor
    norm_num
    exact hx
  have hprefix : ∀ k ∈ Finset.Icc ⌊x⌋₊ ⌊y⌋₊, ‖twistedTheta χ k‖ ≤ B := by
    intro k hk
    obtain ⟨hmk, hkn⟩ := Finset.mem_Icc.mp hk
    have hk2 : (2 : ℝ) ≤ k := by exact_mod_cast hm.trans hmk
    have hkx : (k : ℝ) ≤ 2 * x := ((Nat.le_floor_iff hy0).mp hkn).trans hy
    have hl : 0 ≤ Real.log ((q : ℝ) * k) := Real.log_nonneg (by nlinarith)
    apply (hbound k hk2).trans
    dsimp [B]
    gcongr
  exact (norm_reciprocal_prime_sum_real_Ioc_le χ hx hB hprefix).trans
    (reciprocal_character_shell_scale_le hq1 hx hC)
end

