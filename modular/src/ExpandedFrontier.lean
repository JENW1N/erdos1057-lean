/- The candidate mixed dirty estimate with the original physical auxiliary
law, concrete mixed displacement and divisor, and tilted physical birth law.
Both small-slot projections, endpoint phases, and memory cutoffs are retained. -/

open Finset Filter
open scoped Classical Topology

namespace Bounty

theorem eventually_candidate_physical_mixed_dirty_energy_le
    {q vs scale : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hvs : 0 < vs) (hscale : 0 < scale)
    (ell : ℕ) (C₂ : ℝ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ᶠ L : ℝ in atTop,
      letI : DecidableEq (CandidateSmallGroup scale L) := Classical.decEq _
      letI : DecidableEq (CandidateBigGroup scale L) := Classical.decEq _
      letI : ∀ p : PhysicalPrime (candidateSmallPool scale L), NeZero p.2.val :=
        candidateSmallPrimeNeZero scale L
      letI : ∀ g p, NeZero (candidateBigModulus scale L g p) := candidateBigModulusNeZero scale L
      ∀ J B : ℕ,
      letI : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
      ∀ C : CandidateBigGroup scale L → Finset (Fin J),
      ∀ k : ℤ, k ≠ 0 → (k.natAbs : ℝ) ≤ L ^ C₂ →
      ∀ Vs : CandidateSmallGroup scale L → ℝ, (∀ g, vs ≤ Vs g) →
      ∀ V : CandidateBigGroup scale L → ℝ,
      ∀ baseline : ∀ g, CandidateBigLabel scale L g → ℝ,
      ∀ ρ v vmin vmax : ℝ, 0 < ρ → ρ < 1 → 1 < v → 0 < vmin →
      (∀ g, vmin ≤ V g) → (∀ g, V g ≤ vmax) →
      (∀ g : CandidateBigGroup scale L, ∑ p ∈ candidatePBand (scale * L) g.val, 1 / (p : ℝ) = V g) →
      (∀ g p, 1 / 2 ≤ baseline g p ∧ baseline g p ≤ 1) →
      ∀ T : ℕ, (∀ g, ell + (C g).card ≤ T) →
      ∀ Φ : ∀ a : PhysicalAuxLabels
        (fun g : CandidateBigGroup scale L => candidatePBand (scale * L) g.val) C,
        ∀ s : PhysicalSmallBigState (candidateSmallPool scale L) J ell
          (ProductBoundedOrderedState (CandidateBigLabel scale L)
            (fun g => UnrestrictedResidueParticle (candidateBigModulus scale L g))
            (fun _ => J + ell) B),
        PhysicalSmallBigEvent (PhysicalSmallBigFullEvent (candidateBigModulus scale L)
          (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
          (fun d c g => physicalMixedEdgeDelta C k d c a g)
          (fun d c g => physicalMixedEdgeD C d c a g)) s → ℂ,
      (∀ a s e, ‖Φ a s e‖ ≤ 1) →
      ∀ F : PhysicalSmallBigState (candidateSmallPool scale L) J ell
        (ProductBoundedOrderedState (CandidateBigLabel scale L)
          (fun g => UnrestrictedResidueParticle (candidateBigModulus scale L g))
          (fun _ => J + ell) B) → ℂ,
      (∀ s, ProductMemorySymmetric (fun x => F (s, x))) →
      physicalSmallBigEnergy Vs
        (productMemoryWeight (P := CandidateBigLabel scale L)
          (Z := fun g => UnrestrictedResidueParticle (candidateBigModulus scale L g))
          (t := fun _ => J + ell) (B := B) (fun g => tiltedPhysicalBirthLaw (P := fun g : CandidateBigGroup scale L => candidatePBand (scale * L) g.val) V g (baseline g))
          (fun g => unrestrictedResidueWeight (tiltedPhysicalBirthLaw (P := fun g : CandidateBigGroup scale L => candidatePBand (scale * L) g.val) V g (baseline g))))
        (physicalSmallBigAverage (fun s => ∑ a, (physicalAuxMass V C a : ℂ) *
          physicalSmallBigFullPhasedAction (candidateBigModulus scale L)
            (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
            (fun d c g => physicalMixedEdgeDelta C k d c a g)
            (fun d c g => physicalMixedEdgeD C d c a g)
            (fun g => tiltedPhysicalBirthLaw (P := fun g : CandidateBigGroup scale L => candidatePBand (scale * L) g.val) V g (baseline g)) ρ V
            (fun c => physicalMixedBigStep C k c a) Vs q
            (fun y e => if ¬ (∀ g, (e.2.2 g).1 = ∅ ∧ (e.2.2 g).2.1 = ∅) then Φ a y e else 0)
            (physicalSmallBigAverage F) s)) ≤
      4 * ((B : ℝ) / (((J + ell).choose ell) ^ (candidateSmallPIndices scale L).card : ℕ)) *
        (A ^ (2 * (candidateSmallPIndices scale L).card) *
          unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ (candidateBigPIndices scale L).card) *
        physicalSmallBigEnergy Vs
          (productMemoryWeight (P := CandidateBigLabel scale L)
          (Z := fun g => UnrestrictedResidueParticle (candidateBigModulus scale L g))
          (t := fun _ => J + ell) (B := B) (fun g => tiltedPhysicalBirthLaw (P := fun g : CandidateBigGroup scale L => candidatePBand (scale * L) g.val) V g (baseline g))
            (fun g => unrestrictedResidueWeight (tiltedPhysicalBirthLaw (P := fun g : CandidateBigGroup scale L => candidatePBand (scale * L) g.val) V g (baseline g)))) F := by
  obtain ⟨A, hA, hbound⟩ :=
    eventually_candidate_mixed_auxiliary_dirty_energy_le hq0 hq1 hvs hscale ell C₂
  refine ⟨A, hA, ?_⟩
  filter_upwards [hbound] with L hL
  let _ : DecidableEq (CandidateSmallGroup scale L) := Classical.decEq _
  let _ : DecidableEq (CandidateBigGroup scale L) := Classical.decEq _
  let _ : ∀ p : PhysicalPrime (candidateSmallPool scale L), NeZero p.2.val := candidateSmallPrimeNeZero scale L
  let _ : ∀ g p, NeZero (candidateBigModulus scale L g p) := candidateBigModulusNeZero scale L
  intro J B
  let _ : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
  intro C k hk hkbound Vs hVs V baseline ρ v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi hMass hbaseline T ht
  have hV : ∀ g, 0 < V g := fun g => hvmin.trans_le (hVlo g)
  have hμ : ∀ g p, 0 ≤ tiltedPhysicalBirthLaw (P := fun g : CandidateBigGroup scale L => candidatePBand (scale * L) g.val) V g (baseline g) p := by
    intro g p
    exact tiltedPhysicalBirthLaw_nonneg (P := fun g : CandidateBigGroup scale L => candidatePBand (scale * L) g.val) V g (baseline g) (hV g).le
      (fun p => (by norm_num : (0 : ℝ) ≤ 1 / 2).trans (hbaseline g p).1) p
  have hmass : ∀ g, ∑ p, tiltedPhysicalBirthLaw (P := fun g : CandidateBigGroup scale L => candidatePBand (scale * L) g.val) V g (baseline g) p ≤ 2 := fun g =>
    (tiltedPhysicalBirthLaw_sum_bounds (P := fun g : CandidateBigGroup scale L => candidatePBand (scale * L) g.val) V g (baseline g) (hV g) (hMass g) (hbaseline g)).2
  have hdelta : physicalMixedEdgeDelta (Ps := candidateSmallPool scale L)
      (P := fun g : CandidateBigGroup scale L => candidatePBand (scale * L) g.val) (ell := ell) C k =
      fun d c a _ => -(k * (physicalFullSharedD C c a * physicalSharedProduct d : ℕ)) := by
    funext d c a g
    exact physical_mixed_edge_delta_big_first C k d c a g
  have hdivisor : physicalMixedEdgeD (Ps := candidateSmallPool scale L)
      (P := fun g : CandidateBigGroup scale L => candidatePBand (scale * L) g.val) (ell := ell) C =
      fun d c a _ => ((physicalFullSharedD C c a * physicalSharedProduct d : ℕ) : ℤ) := by
    funext d c a g
    exact physical_mixed_edge_D_big_first C d c a g
  rw [hdelta, hdivisor]
  simp only [physicalMixedBigStep]
  exact hL J B (fun _ => J + ell) (fun g => physicalFullSharedIndices (ell := ell) (C g))
    (PhysicalAuxLabels (fun g : CandidateBigGroup scale L => candidatePBand (scale * L) g.val) C)
    (physicalAuxMass V C) (physical_aux_mass_nonneg V C (fun g => (hV g).le))
    (physical_aux_mass_sum V C hV hMass).le (fun a c => physicalFullSharedD C c a)
    k hk hkbound Vs hVs (fun g => tiltedPhysicalBirthLaw (P := fun g : CandidateBigGroup scale L => candidatePBand (scale * L) g.val) V g (baseline g)) ρ V
    v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T
    (fun g => by simpa only [physical_full_unshared_indices_card] using ht g)

end Bounty
