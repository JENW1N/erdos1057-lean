theorem bounded_ghost_joint_row_decode
    (F : GlobalBirthJointState (fun g p => ZMod (n g p)) → ℂ)
    (s : BoundedGhostJointLedgerState n t B) :
    boundedGhostJointRow n β η V ρ t B (F ∘ boundedGhostJointDecode n t B) s =
      finTensorRow N (fun g (K : GlobalBirthHistoryState (fun p => ZMod (n g p)) → ℂ)
        (u : GlobalBirthHistoryState (fun p => ZMod (n g p))) =>
          globalBirthGhostVisitRawRow (fun _ => 0) (β g) (η g) (V g) (ρ g) B u.1 u.2.2
            (fun H q => K (H, q))) F (boundedGhostJointDecode n t B s) := by
