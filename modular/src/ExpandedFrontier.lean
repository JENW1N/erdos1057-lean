theorem eventually_finite_triple_five_dyad_data {c E : ℝ} (hc : 0 ≤ c) :
    ∀ᶠ L : ℝ in atTop, ∀ (A B C : Finset ℕ) (α β γ : ℕ → ℂ) (UA UB UC A0 B0 C0 : ℝ),
      0 < UA → 0 < UB → 0 < UC → 0 ≤ A0 → 0 ≤ B0 → 0 ≤ C0 → A0*B0*C0 ≤ L^E →
      (∀ n ∈ A, ‖α n‖ ≤ A0) → (∀ n ∈ B, ‖β n‖ ≤ B0) → (∀ n ∈ C, ‖γ n‖ ≤ C0) →
      (∀ n ∈ A, UA ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*UA) →
      (∀ n ∈ B, UB ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*UB) →
      (∀ n ∈ C, UC ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*UC) →
      1 ≤ UA*UB*UC/2 → Real.log (8*(UA*UB*UC)) ≤ c*L →
      ∃ (lo hi : Fin 5 → ℕ) (w : Fin 5 → ℕ → ℂ) (U : Fin 5 → ℝ),
        (∀ j, UA*UB*UC/2 ≤ U j ∧ 1 ≤ U j ∧ Real.log (U j) ≤ c*L ∧
          U j ≤ (lo j : ℝ) ∧ (hi j : ℝ) ≤ 2*U j ∧
          (∑ n ∈ Icc (lo j) (hi j), ‖w j n‖^2) ≤ L^(2*E+16)/U j) ∧
        ∀ t : ℝ, (∑ a ∈ A, α a*harmonicMellinWeight t a)*
          (∑ b ∈ B, β b*harmonicMellinWeight t b)*(∑ d ∈ C, γ d*harmonicMellinWeight t d) =
          ∑ j : Fin 5, ∑ n ∈ Icc (lo j) (hi j),
            w j n*Complex.exp (((Real.log (n : ℝ)*t : ℝ) : ℂ)*Complex.I) := by
  classical
  filter_upwards [eventually_triple_convolution_reciprocal_power_energy (E := E) hc] with L henergy
  intro A B C α β γ UA UB UC A0 B0 C0 hUA hUB hUC hA0 hB0 hC0 hprod hα hβ hγ hA hB hC hV hlog
  let V := UA*UB*UC
  let α' := fun n => if n ∈ A then α n else 0
  let β' := fun n => if n ∈ B then β n else 0
  let γ' := fun n => if n ∈ C then γ n else 0
  have hα' : ∀ n, ‖α' n‖ ≤ A0 := by
    intro n
    dsimp [α']
    split_ifs with hn
    · exact hα n hn
    · simpa only [norm_zero] using hA0
  have hβ' : ∀ n, ‖β' n‖ ≤ B0 := by
    intro n
    dsimp [β']
    split_ifs with hn
    · exact hβ n hn
    · simpa only [norm_zero] using hB0
  have hγ' : ∀ n, ‖γ' n‖ ≤ C0 := by
    intro n
    dsimp [γ']
    split_ifs with hn
    · exact hγ n hn
    · simpa only [norm_zero] using hC0
  refine ⟨(fun j => ⌊(2 : ℝ)^j.val*(V/2)⌋₊+1),
    (fun j => ⌊(2 : ℝ)^(j.val+1)*(V/2)⌋₊),
    (fun _ n => if n ∈ Icc 1 ⌊16*V⌋₊ then endpointTripleConvolution α' β' γ' n/(n : ℂ) else 0),
    (fun j => (2 : ℝ)^j.val*(V/2)),?_,?_⟩
  · intro j
    have hg := five_dyad_full_geometry hV hlog j
    refine ⟨hg.1,hg.2.1,hg.2.2.1,hg.2.2.2.1,hg.2.2.2.2,?_⟩
    refine (finite_masked_energy_le _ _ _).trans ?_
    apply henergy α' β' γ' A0 B0 C0 _ hA0 hB0 hC0 hg.2.1 hg.2.2.1 hprod hα' hβ' hγ'
    intro n hn
    obtain ⟨hnlo,hnhi⟩ := mem_Icc.mp hn
    exact ⟨hg.2.2.2.1.trans (Nat.cast_le.mpr hnlo),
      (Nat.cast_le.mpr hnhi).trans hg.2.2.2.2⟩
  · intro t
    exact finite_triple_polynomial_five_dyads A B C α β γ hUA hUB hUC hA hB hC t

