  (e : PhysicalFullEdgeEvent C k (physicalFullMemoryState C L q))

theorem physical_full_edge_endpoint_unique
    (hw : fullActiveEdgeEventWeight (fun g (p : ↥(P g)) => p.val)
      (fun g => physicalFullSharedIndices (C g)) B (fun _ => PhysicalAuxLabels P C)
      (physicalFullEdgeDelta C k) (physicalFullEdgeD C) ω μ ρ V
      (physicalFullMemoryState C L q) e ≠ 0)
    (R T : PhysicalMarkLists P J ell)
    (hR : physicalFullEdgePhase C k L R H q e ≠ 0)
    (hT : physicalFullEdgePhase C k L T H q e ≠ 0) : R = T := by
  have hr := physical_full_edge_target_of_nonzero C k L R H q ω μ ρ V e hw hR
  have ht := physical_full_edge_target_of_nonzero C k L T H q ω μ ρ V e hw hT
  exact physical_full_state_labels_of_eq C R T _ _ (hr.symm.trans ht)

theorem physical_full_edge_endpoint_sum_norm_le
    (hw : fullActiveEdgeEventWeight (fun g (p : ↥(P g)) => p.val)
      (fun g => physicalFullSharedIndices (C g)) B (fun _ => PhysicalAuxLabels P C)
      (physicalFullEdgeDelta C k) (physicalFullEdgeD C) ω μ ρ V
      (physicalFullMemoryState C L q) e ≠ 0) :
    ‖∑ R : PhysicalMarkLists P J ell, physicalFullEdgePhase C k L R H q e‖ ≤ 1 := by
  by_cases hz : ∀ R : PhysicalMarkLists P J ell, physicalFullEdgePhase C k L R H q e = 0
  · simp only [hz, sum_const_zero, norm_zero, zero_le_one]
  · obtain ⟨R, hR⟩ := not_forall.mp hz
    rw [sum_eq_single R]
    · exact physical_full_edge_phase_norm_le C k L R H q e
    · intro T _ hT
      by_contra hn
      exact hT (physical_full_edge_endpoint_unique C k L H q ω μ ρ V e hw T R hn hR)
    · simp only [mem_univ, not_true_eq_false, false_implies]

noncomputable def physicalFullEndpointPhase : ℂ :=
  if fullActiveEdgeEventWeight (fun g (p : ↥(P g)) => p.val)
      (fun g => physicalFullSharedIndices (C g)) B (fun _ => PhysicalAuxLabels P C)
      (physicalFullEdgeDelta C k) (physicalFullEdgeD C) ω μ ρ V
      (physicalFullMemoryState C L q) e = 0 then 0
  else ∑ R : PhysicalMarkLists P J ell, physicalFullEdgePhase C k L R H q e

theorem physical_full_endpoint_phase_norm_le :
    ‖physicalFullEndpointPhase C k L H q ω μ ρ V e‖ ≤ 1 := by
  unfold physicalFullEndpointPhase
  split_ifs with hw
  · simp only [norm_zero, zero_le_one]
  · exact physical_full_edge_endpoint_sum_norm_le C k L H q ω μ ρ V e hw

theorem physical_full_endpoint_phase_weighted :
    let w := fullActiveEdgeEventWeight (fun g (p : ↥(P g)) => p.val)
      (fun g => physicalFullSharedIndices (C g)) B (fun _ => PhysicalAuxLabels P C)
      (physicalFullEdgeDelta C k) (physicalFullEdgeD C) ω μ ρ V
      (physicalFullMemoryState C L q) e
    (w : ℂ) * physicalFullEndpointPhase C k L H q ω μ ρ V e =
      ∑ R : PhysicalMarkLists P J ell, (w : ℂ) * physicalFullEdgePhase C k L R H q e := by
  dsimp only
  unfold physicalFullEndpointPhase
  split_ifs with hw
  · simp only [hw, Complex.ofReal_zero, zero_mul, sum_const_zero]
  · exact mul_sum _ _ _

end Physical
end

section
open scoped BigOperators Classical
theorem finite_set_sum_four_swap {A B X Y M : Type*} [AddCommMonoid M]
    (s : Finset A) (t : Finset B) (u : Finset X) (v : Finset Y)
    (F : A → B → X → Y → M) :
    (∑ a ∈ s, ∑ b ∈ t, ∑ x ∈ u, ∑ y ∈ v, F a b x y) =
      ∑ x ∈ u, ∑ y ∈ v, ∑ a ∈ s, ∑ b ∈ t, F a b x y := by
  have h : (∑ ab ∈ s ×ˢ t, ∑ xy ∈ u ×ˢ v, F ab.1 ab.2 xy.1 xy.2) =
      ∑ xy ∈ u ×ˢ v, ∑ ab ∈ s ×ˢ t, F ab.1 ab.2 xy.1 xy.2 := Finset.sum_comm
  simpa only [Finset.sum_product] using h

theorem finite_dyadic_pairing_sum {X Y : Type*} [Fintype X] [Fintype Y]
    (π : X → ℕ) (τ : Y → ℕ) (μ : X → ℝ) (ν : Y → ℝ)
    (f : X → ℂ) (g : Y → ℂ) (K : X → Y → ℂ) :
    (∑ i ∈ finiteDyadicIndices π, ∑ j ∈ finiteDyadicIndices τ,
      ∑ x, ∑ y, ((μ x : ℂ) * finiteDyadicTest π i f x) *
        ((ν y : ℂ) * finiteDyadicTest τ j g y) * K x y) =
      ∑ x, ∑ y, ((μ x : ℂ) * f x) * ((ν y : ℂ) * g y) * K x y := by
  rw [finite_set_sum_four_swap]
  apply Finset.sum_congr rfl
  intro x _
  apply Finset.sum_congr rfl
  intro y _
  simp only [← Finset.mul_sum, ← Finset.sum_mul, finite_dyadic_test_sum]

theorem finite_dyadic_pairing_bound {X Y : Type*} [Fintype X] [Fintype Y]
    (π : X → ℕ) (τ : Y → ℕ) (μ : X → ℝ) (ν : Y → ℝ)
    (hμ : ∀ x, 0 ≤ μ x) (hν : ∀ y, 0 ≤ ν y)
    (f : X → ℂ) (g : Y → ℂ) (K : X → Y → ℂ) {ε : ℝ} (hε : 0 ≤ ε)
    (hdyad : ∀ i ∈ finiteDyadicIndices π, ∀ j ∈ finiteDyadicIndices τ,
      ‖∑ x, ∑ y, ((μ x : ℂ) * finiteDyadicTest π i f x) *
        ((ν y : ℂ) * finiteDyadicTest τ j g y) * K x y‖ ≤
        ε * Real.sqrt ((∑ x, μ x * ‖finiteDyadicTest π i f x‖ ^ 2) *
          ∑ y, ν y * ‖finiteDyadicTest τ j g y‖ ^ 2)) :
    ‖∑ x, ∑ y, ((μ x : ℂ) * f x) * ((ν y : ℂ) * g y) * K x y‖ ≤
      ((finiteDyadicIndices π).card : ℝ) * (finiteDyadicIndices τ).card * ε *
        Real.sqrt ((∑ x, μ x * ‖f x‖ ^ 2) * ∑ y, ν y * ‖g y‖ ^ 2) := by
  have he (i j : ℕ) :
      Real.sqrt ((∑ x, μ x * ‖finiteDyadicTest π i f x‖ ^ 2) *
        ∑ y, ν y * ‖finiteDyadicTest τ j g y‖ ^ 2) ≤
      Real.sqrt ((∑ x, μ x * ‖f x‖ ^ 2) * ∑ y, ν y * ‖g y‖ ^ 2) := by
    apply Real.sqrt_le_sqrt
    apply mul_le_mul (finite_dyadic_test_energy_le π μ hμ f i)
      (finite_dyadic_test_energy_le τ ν hν g j)
    · exact Finset.sum_nonneg (fun y _ => mul_nonneg (hν y) (sq_nonneg _))
    · exact Finset.sum_nonneg (fun x _ => mul_nonneg (hμ x) (sq_nonneg _))
  rw [← finite_dyadic_pairing_sum π τ μ ν f g K]
  calc
    _ ≤ ∑ i ∈ finiteDyadicIndices π, ∑ j ∈ finiteDyadicIndices τ,
        ‖∑ x, ∑ y, ((μ x : ℂ) * finiteDyadicTest π i f x) *
          ((ν y : ℂ) * finiteDyadicTest τ j g y) * K x y‖ := by
      exact (norm_sum_le _ _).trans (Finset.sum_le_sum (fun i _ => norm_sum_le _ _))
    _ ≤ ∑ _i ∈ finiteDyadicIndices π, ∑ _j ∈ finiteDyadicIndices τ,
        ε * Real.sqrt ((∑ x, μ x * ‖f x‖ ^ 2) * ∑ y, ν y * ‖g y‖ ^ 2) := by
      apply Finset.sum_le_sum
      intro i hi
      apply Finset.sum_le_sum
      intro j hj
      exact (hdyad i hi j hj).trans (mul_le_mul_of_nonneg_left (he i j) hε)
    _ = _ := by simp only [Finset.sum_const, nsmul_eq_mul]; ring

theorem finite_dyadic_pairing_polynomial_bound
    {X Y : Type*} [Fintype X] [Fintype Y]
    (π : X → ℕ) (τ : Y → ℕ) (μ : X → ℝ) (ν : Y → ℝ)
    (hμ : ∀ x, 0 ≤ μ x) (hν : ∀ y, 0 ≤ ν y)
    (f : X → ℂ) (g : Y → ℂ) (K : X → Y → ℂ)
    {L a b B : ℝ} (hL : 0 < L)
    (hπ : ((finiteDyadicIndices π).card : ℝ) ≤ L ^ a)
    (hτ : ((finiteDyadicIndices τ).card : ℝ) ≤ L ^ b)
    (hdyad : ∀ i ∈ finiteDyadicIndices π, ∀ j ∈ finiteDyadicIndices τ,
      ‖∑ x, ∑ y, ((μ x : ℂ) * finiteDyadicTest π i f x) *
        ((ν y : ℂ) * finiteDyadicTest τ j g y) * K x y‖ ≤
        L ^ (-B - a - b) * Real.sqrt ((∑ x, μ x * ‖finiteDyadicTest π i f x‖ ^ 2) *
          ∑ y, ν y * ‖finiteDyadicTest τ j g y‖ ^ 2)) :
    ‖∑ x, ∑ y, ((μ x : ℂ) * f x) * ((ν y : ℂ) * g y) * K x y‖ ≤
      L ^ (-B) * Real.sqrt ((∑ x, μ x * ‖f x‖ ^ 2) * ∑ y, ν y * ‖g y‖ ^ 2) := by
  refine (finite_dyadic_pairing_bound π τ μ ν hμ hν f g K (by positivity) hdyad).trans ?_
  calc
    _ ≤ L ^ a * L ^ b * L ^ (-B - a - b) *
        Real.sqrt ((∑ x, μ x * ‖f x‖ ^ 2) * ∑ y, ν y * ‖g y‖ ^ 2) := by gcongr
    _ = _ := by
      rw [← Real.rpow_add hL, ← Real.rpow_add hL]
      congr 2
      ring
end

section
open Finset
theorem conductor_divisors_filter_eq (d R : ℕ) (hd : d ≠ 0) :
    d.divisors.filter (fun f => 1 < f ∧ f ≤ R) =
      (Icc 2 R).filter (fun f => f ∣ d) := by
  ext f
  simp only [mem_filter, Nat.mem_divisors, mem_Icc]
  omega

theorem conductor_sum_reindex (N R : ℕ) (F : ℕ → ℕ → ℝ) :
    (∑ d ∈ (Icc 1 N).filter Squarefree,
      ∑ f ∈ d.divisors.filter (fun f => 1 < f ∧ f ≤ R), F d f) =
      ∑ f ∈ Icc 2 R,
        ∑ d ∈ (Icc 1 N).filter (fun d => Squarefree d ∧ f ∣ d), F d f := by
  classical
  calc
    _ = ∑ d ∈ (Icc 1 N).filter Squarefree,
        ∑ f ∈ Icc 2 R, if f ∣ d then F d f else 0 := by
      apply sum_congr rfl
      intro d hd
      rw [conductor_divisors_filter_eq d R (by
        have := (mem_Icc.mp (mem_filter.mp hd).1).1
        omega), sum_filter]
    _ = ∑ f ∈ Icc 2 R,
        ∑ d ∈ (Icc 1 N).filter Squarefree, if f ∣ d then F d f else 0 := sum_comm
    _ = _ := by
      apply sum_congr rfl
      intro f _
      rw [← sum_filter, filter_filter]

theorem small_conductor_totient_mass_le (N R : ℕ) (B : ℕ → ℝ)
    (hB : ∀ f ∈ Icc 2 R, 0 ≤ B f) {D : ℝ} (hD : 1 ≤ D)
    (hND : (N : ℝ) ≤ D) :
    (∑ d ∈ (Icc 1 N).filter Squarefree,
      ∑ f ∈ d.divisors.filter (fun f => 1 < f ∧ f ≤ R),
        (Nat.totient f : ℝ) * B f / (Nat.totient d : ℝ)) ≤
      ((2 * primeEulerProductUpperConstant) * Real.log (2 * D)) *
        ∑ f ∈ Icc 2 R, B f := by
  rw [conductor_sum_reindex, mul_sum]
  apply sum_le_sum
  intro f hf
  have hfpos : 0 < f := by have := (mem_Icc.mp hf).1; omega
  have hphi : (0 : ℝ) < Nat.totient f := by exact_mod_cast Nat.totient_pos.mpr hfpos
  calc
    _ = ((Nat.totient f : ℝ) * B f) *
        ∑ d ∈ (Icc 1 N).filter (fun d => Squarefree d ∧ f ∣ d),
          1 / (Nat.totient d : ℝ) := by
      rw [mul_sum]
      apply sum_congr rfl
      intro d _
      ring
    _ ≤ ((Nat.totient f : ℝ) * B f) *
        ((1 / (Nat.totient f : ℝ)) *
          ((2 * primeEulerProductUpperConstant) * Real.log (2 * D))) :=
      mul_le_mul_of_nonneg_left (conductor_totient_mass_le_log N f hfpos hD hND)
        (mul_nonneg hphi.le (hB f hf))
    _ = _ := by field_simp

theorem primitive_character_sum_le_card (f : ℕ) (hf : 0 < f)
    [DecidablePred (fun ψ : DirichletCharacter ℂ f => ψ.IsPrimitive ∧ ψ ≠ 1)]
    (F : DirichletCharacter ℂ f → ℝ) {B : ℝ} (hB : 0 ≤ B)
    (hF : ∀ ψ : DirichletCharacter ℂ f, ψ.IsPrimitive → ψ ≠ 1 → F ψ ≤ B) :
    (∑ ψ ∈ (univ : Finset (DirichletCharacter ℂ f)).filter
      (fun ψ => ψ.IsPrimitive ∧ ψ ≠ 1), F ψ) ≤ (Nat.totient f : ℝ) * B := by
  classical
  have hcard : Fintype.card (DirichletCharacter ℂ f) = Nat.totient f := by
    rw [← Nat.card_eq_fintype_card]
    exact @DirichletCharacter.card_eq_totient_of_hasEnoughRootsOfUnity ℂ _ f
      ⟨hf.ne'⟩ _
  calc
    _ ≤ ∑ _ψ ∈ (univ : Finset (DirichletCharacter ℂ f)).filter
        (fun ψ => ψ.IsPrimitive ∧ ψ ≠ 1), B := by
      apply sum_le_sum
      intro ψ hψ
      exact hF ψ (mem_filter.mp hψ).2.1 (mem_filter.mp hψ).2.2
    _ ≤ ∑ _ψ : DirichletCharacter ℂ f, B :=
      sum_le_sum_of_subset_of_nonneg (filter_subset _ _) (by intros; exact hB)
    _ = _ := by simp [hcard]

theorem small_primitive_conductor_mass_le {Ω : Type*} (N R : ℕ)
    [∀ f : ℕ, DecidablePred (fun ψ : DirichletCharacter ℂ f => ψ.IsPrimitive ∧ ψ ≠ 1)]
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) (B : ℕ → ℝ)
    (hB : ∀ f ∈ Icc 2 R, 0 ≤ B f) {D : ℝ} (hD : 1 ≤ D)
    (hND : (N : ℝ) ≤ D)
    (hbound : ∀ d ∈ (Icc 1 N).filter Squarefree,
      ∀ f ∈ d.divisors.filter (fun f => 1 < f ∧ f ≤ R),
      ∀ ψ : DirichletCharacter ℂ f, ψ.IsPrimitive → ψ ≠ 1 →
        ‖∑ t ∈ T.filter (fun t => (value t).Coprime (d / f)),
          μ t * ψ (value t : ZMod f)‖ ≤ B f) :
    (∑ d ∈ (Icc 1 N).filter Squarefree,
      (∑ f ∈ d.divisors.filter (fun f => 1 < f ∧ f ≤ R),
        ∑ ψ ∈ (univ : Finset (DirichletCharacter ℂ f)).filter
          (fun ψ => ψ.IsPrimitive ∧ ψ ≠ 1),
          ‖∑ t ∈ T.filter (fun t => (value t).Coprime (d / f)),
            μ t * ψ (value t : ZMod f)‖) / (Nat.totient d : ℝ)) ≤
      ((2 * primeEulerProductUpperConstant) * Real.log (2 * D)) *
        ∑ f ∈ Icc 2 R, B f := by
  classical
  apply le_trans _ (small_conductor_totient_mass_le N R B hB hD hND)
  apply sum_le_sum
  intro d hd
  rw [sum_div]
  apply sum_le_sum
  intro f hf
  have hfR : f ∈ Icc 2 R := by
    obtain ⟨_, h1, hR⟩ := mem_filter.mp hf
    exact mem_Icc.mpr ⟨by omega, hR⟩
  apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg _)
  exact primitive_character_sum_le_card f (by have := (mem_Icc.mp hfR).1; omega)
    _ (hB f hfR) (hbound d hd f hf)
end

section
open Finset
theorem primeBand_product_clip_upper {a b c U V : ℝ}
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 < c) (hU : 0 ≤ U) (hV : 0 ≤ V) :
    (primeBand a b).filter (fun p : ℕ => U < c * (p : ℝ) ∧ c * (p : ℝ) ≤ V) =
      (primeBand a (min b (V / c))).filter
        (fun p : ℕ => U < c * (p : ℝ) ∧ c * (p : ℝ) ≤ V) := by
  rw [primeBand_product_interval ha hb hc hU hV,
    primeBand_product_interval ha (le_min hb (div_nonneg hV hc.le)) hc hU hV,
    min_assoc, min_self]

theorem ordinary_prime_band_product_relative_bound
    (hZ : PrimitiveZeroFreeHalfPlane) :
    ∃ C : ℝ, 0 < C ∧ ∀ (q : ℕ), 0 < q →
      ∀ χ : DirichletCharacter ℂ q, χ ≠ 1 →
      ∀ a b c U V : ℝ, 2 ≤ a → 0 ≤ b → 0 < c → 0 ≤ U → 0 ≤ V →
        ‖∑ p ∈ (primeBand a b).filter
            (fun p : ℕ => U < c * (p : ℝ) ∧ c * (p : ℝ) ≤ V), χ (p : ZMod q)‖ ≤
          2 * (V / c) * C * a ^ (-(1 : ℝ) / 32) *
            (1 + Real.log q / Real.log a) := by
  obtain ⟨C, hC, hbound⟩ := ordinary_prime_band_product_interval_bound hZ
  refine ⟨C, hC, ?_⟩
  intro q hq χ hχ a b c U V ha hb hc hU hV
  have hqlog : 0 ≤ Real.log (q : ℝ) := Real.log_nonneg (by exact_mod_cast hq)
  have halog : 0 < Real.log a := Real.log_pos (by linarith)
  rw [primeBand_product_clip_upper (by linarith) hb hc hU hV]
  apply (hbound q hq χ hχ a (min b (V / c)) c U V ha
    (le_min hb (div_nonneg hV hc.le)) hc hU hV).trans
  gcongr
  exact min_le_right _ _

theorem prime_sum_filter_coprime_relative_error (S : Finset ℕ)
    (hS : ∀ p ∈ S, p.Prime) (F : ℕ → ℂ) (hF : ∀ p ∈ S, ‖F p‖ ≤ 1)
    {a B : ℝ} (ha : 0 < a) (hB : 0 ≤ B)
    (hlower : ∀ p ∈ S, a ≤ (p : ℝ)) (hupper : ∀ p ∈ S, (p : ℝ) ≤ B)
    {m : ℕ} (hm : m ≠ 0) :
    ‖∑ p ∈ S.filter (fun p => p.Coprime m), F p‖ ≤
      ‖∑ p ∈ S, F p‖ + (B / a) * (m.primeFactors.card : ℝ) := by
  classical
  let E := S.filter (fun p => ¬ p.Coprime m)
  have hE : E ⊆ m.primeFactors := by
    intro p hp
    obtain ⟨hpS, hpc⟩ := mem_filter.mp hp
    apply (hS p hpS).mem_primeFactors _ hm
    simpa only [(hS p hpS).coprime_iff_not_dvd, not_not] using hpc
  have herr : ‖∑ p ∈ E, F p‖ ≤ (B / a) * (m.primeFactors.card : ℝ) := by
    calc
      _ ≤ ∑ p ∈ E, ‖F p‖ := norm_sum_le _ _
      _ ≤ ∑ _p ∈ E, B / a := by
        apply sum_le_sum
        intro p hp
        have hpS := (mem_filter.mp hp).1
        apply (hF p hpS).trans
        exact (one_le_div ha).mpr ((hlower p hpS).trans (hupper p hpS))
      _ = (B / a) * (E.card : ℝ) := by simp [mul_comm]
      _ ≤ (B / a) * (m.primeFactors.card : ℝ) :=
        mul_le_mul_of_nonneg_left (Nat.cast_le.mpr (card_le_card hE)) (div_nonneg hB ha.le)
  have hsplit : (∑ p ∈ S.filter (fun p => p.Coprime m), F p) =
      (∑ p ∈ S, F p) - ∑ p ∈ E, F p := by
    apply eq_sub_iff_add_eq.mpr
    rw [show E = S.filter (fun p => ¬ p.Coprime m) from rfl,
      sum_filter, sum_filter, ← sum_add_distrib]
    apply sum_congr rfl
    intro p _
    by_cases h : p.Coprime m <;> simp [h]
  rw [hsplit]
  exact (norm_sub_le _ _).trans (add_le_add le_rfl herr)

theorem ordinary_prime_band_product_coprime_relative_bound
    (hZ : PrimitiveZeroFreeHalfPlane) :
    ∃ C : ℝ, 0 < C ∧ ∀ (q : ℕ), 0 < q →
      ∀ χ : DirichletCharacter ℂ q, χ ≠ 1 →
      ∀ a b c U V : ℝ, 2 ≤ a → 0 ≤ b → 0 < c → 0 ≤ U → 0 ≤ V →
      ∀ m : ℕ, m ≠ 0 →
        ‖∑ p ∈ ((primeBand a b).filter
            (fun p : ℕ => U < c * (p : ℝ) ∧ c * (p : ℝ) ≤ V)).filter
              (fun p => p.Coprime m), χ (p : ZMod q)‖ ≤
          (V / c) * (2 * C * a ^ (-(1 : ℝ) / 32) *
            (1 + Real.log q / Real.log a) + (m.primeFactors.card : ℝ) / a) := by
  obtain ⟨C, hC, hbound⟩ := ordinary_prime_band_product_relative_bound hZ
  refine ⟨C, hC, ?_⟩
  intro q hq χ hχ a b c U V ha hb hc hU hV m hm
  let S := (primeBand a b).filter
    (fun p : ℕ => U < c * (p : ℝ) ∧ c * (p : ℝ) ≤ V)
  have hS (p : ℕ) (hp : p ∈ S) : p.Prime ∧ a < (p : ℝ) ∧ (p : ℝ) ≤ b :=
    (mem_primeBand_iff (by linarith) hb p).mp (mem_filter.mp hp).1
  have hupper (p : ℕ) (hp : p ∈ S) : (p : ℝ) ≤ V / c := by
    apply (le_div_iff₀ hc).mpr
    simpa only [mul_comm] using (mem_filter.mp hp).2.2
  have herr := prime_sum_filter_coprime_relative_error S (fun p hp => (hS p hp).1)
    (fun p => χ (p : ZMod q)) (fun p _ => χ.norm_le_one _)
    (by linarith : 0 < a) (div_nonneg hV hc.le)
    (fun p hp => (hS p hp).2.1.le) hupper hm
  apply herr.trans
  apply le_trans (add_le_add (hbound q hq χ hχ a b c U V ha hb hc hU hV) le_rfl)
  exact le_of_eq (by ring)
end

section
open scoped BigOperators
theorem finiteFourierSum_separated_bound {ι : Type*}
    (samples : Finset ι) (x : ι → ℝ) {δ N : ℝ}
    (hδ : 0 < δ) (hδ1 : δ ≤ 1)
    (hx : ∀ i ∈ samples, 0 ≤ x i ∧ x i ≤ 1)
    (hsep : ∀ i ∈ samples, ∀ j ∈ samples, i ≠ j → δ ≤ |x i - x j|)
    (freq : Finset ℤ) (a : ℤ → ℂ) (hN : 0 ≤ N)
    (hfreq : ∀ n ∈ freq, |(n : ℝ)| ≤ N) :
    (∑ i ∈ samples, ‖finiteFourierSum freq a (x i)‖ ^ 2) ≤
      2 * (δ⁻¹ + 2 + 4 * Real.pi * N) * ∑ n ∈ freq, ‖a n‖ ^ 2 := by
  have henergy : 0 ≤ 2 * ∑ n ∈ freq, ‖a n‖ ^ 2 := by positivity
  have hK : 0 < 1 + 2 * Real.pi * N := by positivity
  have hK2 : (2 * Real.pi * N) ^ 2 ≤ (1 + 2 * Real.pi * N) ^ 2 := by
    nlinarith [mul_nonneg (by positivity : 0 ≤ 2 * Real.pi) hN]
  have hderiv : (∫ y in (0 : ℝ)..2, ‖finiteFourierDerivative freq a y‖ ^ 2) ≤
      (1 + 2 * Real.pi * N) ^ 2 * (2 * ∑ n ∈ freq, ‖a n‖ ^ 2) :=
    (finiteFourierDerivative_energy_two_le freq a hN hfreq).trans
      (mul_le_mul_of_nonneg_right hK2 henergy)
  have h := separated_samples_norm_sq_le_energy samples x hδ (by norm_num : (0 : ℝ) ≤ 2)
    (fun i hi => (hx i hi).1) (fun i hi => by linarith [(hx i hi).2]) hsep
    (finiteFourierSum freq a) (finiteFourierDerivative freq a)
    (hasDerivAt_finiteFourierSum freq a) (continuous_finiteFourierDerivative freq a)
    hK (finiteFourierSum_energy_two freq a).le hderiv
  convert h using 1; ring

theorem additive_large_sieve_reduced_fractions
    (samples : Finset (ℕ × ℕ)) {R N : ℝ} (hR : 1 ≤ R)
    (hsamples : ∀ v ∈ samples,
      0 < v.2 ∧ v.1 < v.2 ∧ v.1.Coprime v.2 ∧ (v.2 : ℝ) ≤ R)
    (freq : Finset ℤ) (a : ℤ → ℂ) (hN : 0 ≤ N)
    (hfreq : ∀ n ∈ freq, |(n : ℝ)| ≤ N) :
    (∑ v ∈ samples, ‖finiteFourierSum freq a ((v.1 : ℝ) / v.2)‖ ^ 2) ≤
      2 * (R ^ 2 + 2 + 4 * Real.pi * N) * ∑ n ∈ freq, ‖a n‖ ^ 2 := by
  have hR0 : 0 < R := lt_of_lt_of_le zero_lt_one hR
  have hδ : 0 < 1 / R ^ 2 := by positivity
  have hδ1 : 1 / R ^ 2 ≤ 1 :=
    (div_le_one (sq_pos_of_pos hR0)).mpr (one_le_pow₀ hR)
  obtain ⟨hrange, hsep⟩ := reduced_fraction_samples_data samples hsamples
  have h := finiteFourierSum_separated_bound samples (fun v => (v.1 : ℝ) / v.2)
    hδ hδ1 (fun v hv => ⟨(hrange v hv).1, (hrange v hv).2.le⟩)
    hsep freq a hN hfreq
  simpa only [one_div, inv_inv] using h

theorem additive_large_sieve_reduced_fractions_coarse
    (samples : Finset (ℕ × ℕ)) {R N : ℝ} (hR : 1 ≤ R)
    (hsamples : ∀ v ∈ samples,
      0 < v.2 ∧ v.1 < v.2 ∧ v.1.Coprime v.2 ∧ (v.2 : ℝ) ≤ R)
    (freq : Finset ℤ) (a : ℤ → ℂ) (hN : 0 ≤ N)
    (hfreq : ∀ n ∈ freq, |(n : ℝ)| ≤ N) :
    (∑ v ∈ samples, ‖finiteFourierSum freq a ((v.1 : ℝ) / v.2)‖ ^ 2) ≤
      (6 + 8 * Real.pi) * (N + R ^ 2) * ∑ n ∈ freq, ‖a n‖ ^ 2 := by
  apply (additive_large_sieve_reduced_fractions samples hR hsamples freq a hN hfreq).trans
  apply mul_le_mul_of_nonneg_right _ (by positivity)
  have hR2 : 1 ≤ R ^ 2 := one_le_pow₀ hR
  nlinarith [mul_nonneg (by positivity : 0 ≤ Real.pi) hN,
    mul_nonneg (by positivity : 0 ≤ Real.pi) (sq_nonneg R)]
end

