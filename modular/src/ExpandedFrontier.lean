open Finset
noncomputable def physicalGroupBareRawEdge {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) (L R : PhysicalMarkLists P J ell) (n : ℤ)
    (hlist : physicalListAdmissible C aux L R)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hcompat : ∀ g s t, (L g s).val = (R g t).val →
      ((L g s).val : ℤ) ∣ k * (physicalD C L aux : ℤ))
    (g : G) (hk : ∀ s, ¬ ((L g s).val : ℤ) ∣ k)
    (β : ↥(P g) → ℝ) (ρ V : ℝ) (cap : ℕ) :
    GlobalBirthRawStep (R := fun p : ↥(P g) => ZMod p.val)
      (physicalGroupPhaseActivity L g) (physicalGroupPhaseActivity R g) :=
  .edge (physicalGroupPhaseDelta n (n + k * (physicalD C L aux : ℤ)) g)
    (physical_group_phase_shared_delta_zero_of_common_marks L R n
      (n + k * (physicalD C L aux : ℤ)) g (by
        intro s t he
        simpa only [add_sub_cancel_left] using hcompat g s t he))
    (physicalGroupUnsharedEmbedding C L g)
    (physicalGroupUnsharedEmbedding C R g)
    (physical_group_phase_images_of_bare C aux k L R hlist hP hdis hcompat g hk).1
    (physical_group_phase_images_of_bare C aux k L R hlist hP hdis hcompat g hk).2
    β ρ V cap

/-- The displacement depends only on the physical step, not its starting offset. -/
theorem physical_group_bare_phase_delta {G : Type*} [Fintype G] {P : G → Finset ℕ}
    {J ell : ℕ} (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (k : ℤ) (L : PhysicalMarkLists P J ell) (n : ℤ) (g : G) (p : ↥(P g)) :
    physicalGroupPhaseDelta n (n + k * (physicalD C L aux : ℤ)) g p =
      -((k * (physicalD C L aux : ℤ) : ℤ) : ZMod p.val) := by
  rw [physical_group_phase_delta_eq_neg_step]
  simp only [add_sub_cancel_left]

theorem physical_group_bare_raw_edge_cap {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) (L R : PhysicalMarkLists P J ell) (n : ℤ)
    (hlist : physicalListAdmissible C aux L R)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hcompat : ∀ g s t, (L g s).val = (R g t).val →
      ((L g s).val : ℤ) ∣ k * (physicalD C L aux : ℤ))
    (g : G) (hk : ∀ s, ¬ ((L g s).val : ℤ) ∣ k)
    (β : ↥(P g) → ℝ) (ρ V : ℝ) (cap : ℕ) :
    globalBirthRawStepCap
      (physicalGroupBareRawEdge C aux k L R n hlist hP hdis hcompat g hk β ρ V cap) = cap := rfl

/-- The constructed edge evaluates the literal unrestricted event row using
the physical unshared slots and the exact transported-hit eligibility set. -/
theorem physical_group_bare_raw_edge_row {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) (L R : PhysicalMarkLists P J ell) (n : ℤ)
    (hlist : physicalListAdmissible C aux L R)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hcompat : ∀ g s t, (L g s).val = (R g t).val →
      ((L g s).val : ℤ) ∣ k * (physicalD C L aux : ℤ))
    (g : G) (hk : ∀ s, ¬ ((L g s).val : ℤ) ∣ k)
    (β : ↥(P g) → ℝ) (ρ V : ℝ) (cap : ℕ)
    (F : Finset ↥(P g) → FiniteOrderedTuple (Σ p : ↥(P g), ZMod p.val) → ℂ)
    (H : Finset ↥(P g)) (q : FiniteOrderedTuple (Σ p : ↥(P g), ZMod p.val)) :
    globalBirthRawStepRow
      (physicalGroupBareRawEdge C aux k L R n hlist hP hdis hcompat g hk β ρ V cap) F H q =
      globalBirthEdgeRawRow (physicalGroupUnsharedEmbedding C L g)
        (physicalGroupUnsharedEmbedding C R g)
        (physicalGroupPhaseDelta n (n + k * (physicalD C L aux : ℤ)) g)
        H q.2
        (globalBirthRawHitIndices
          (physicalGroupPhaseDelta n (n + k * (physicalD C L aux : ℤ)) g) q)
        β ρ V cap F := rfl

/-- Exact full-row correspondence for bare physical lists. The continuation
is constrained only on coherent target memories inside the actual cutoff. -/
theorem physical_group_bare_raw_edge_intertwines {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) (L R : PhysicalMarkLists P J ell) (n : ℤ)
    (hlist : physicalListAdmissible C aux L R)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hcompat : ∀ g s t, (L g s).val = (R g t).val →
      ((L g s).val : ℤ) ∣ k * (physicalD C L aux : ℤ))
    (g : G) [∀ p : ↥(P g), NeZero p.val]
    (hk : ∀ s, ¬ ((L g s).val : ℤ) ∣ k)
    (β : ↥(P g) → ℝ) (ρ V : ℝ) (cap : ℕ)
    (H : Finset ↥(P g)) (q : FiniteOrderedTuple (Σ p : ↥(P g), ZMod p.val))
    (hq : GlobalBirthMemoryCoherent
      (ghostPhaseActivitySupport (physicalGroupPhaseActivity L g)) H q)
    (F : Finset ↥(P g) → FiniteOrderedTuple (Σ p : ↥(P g), ZMod p.val) → ℂ)
    (f : ((p : ↥(P g)) → GhostPhaseState (ZMod p.val)) → ℂ)
    (hF : ∀ H' q', GlobalBirthMemoryCoherent
      (ghostPhaseActivitySupport (physicalGroupPhaseActivity R g)) H' q' → q'.1 ≤ cap →
      F H' q' = f (globalBirthMemoryReadout
        (ghostPhaseActivitySupport (physicalGroupPhaseActivity R g)) H' q')) :
    globalBirthEdgeRawRow (physicalGroupUnsharedEmbedding C L g)
      (physicalGroupUnsharedEmbedding C R g)
      (physicalGroupPhaseDelta n (n + k * (physicalD C L aux : ℤ)) g)
      H q.2
      (globalBirthRawHitIndices
        (physicalGroupPhaseDelta n (n + k * (physicalD C L aux : ℤ)) g) q)
      β ρ V cap F =
      globalBirthRawStepPhaseRow
        (physicalGroupBareRawEdge C aux k L R n hlist hP hdis hcompat g hk β ρ V cap) f
        (globalBirthMemoryReadout (ghostPhaseActivitySupport (physicalGroupPhaseActivity L g)) H q) :=
  global_birth_raw_step_intertwines
    (physicalGroupBareRawEdge C aux k L R n hlist hP hdis hcompat g hk β ρ V cap)
    H q hq F f hF

/-- Marked constraints in independent residue coordinates discharge all
common-mark divisibility assumptions of the bare edge constructor. -/
noncomputable def physicalGroupResidueRawEdge {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) (L R : PhysicalMarkLists P J ell) (n : ℤ)
    (hlist : physicalListAdmissible C aux L R)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (ζ : ∀ p : PhysicalPrime P, ZMod p.2.val)
    (hL : ∀ p ∈ physicalMarkedPrimes L, ζ p = -(n : ZMod p.2.val))
    (hR : ∀ p ∈ physicalMarkedPrimes R,
      ζ p = -((n + k * (physicalD C L aux : ℤ) : ℤ) : ZMod p.2.val))
    (g : G) (hk : ∀ s, ¬ ((L g s).val : ℤ) ∣ k)
    (β : ↥(P g) → ℝ) (ρ V : ℝ) (cap : ℕ) :
    GlobalBirthRawStep (R := fun p : ↥(P g) => ZMod p.val)
      (physicalGroupPhaseActivity L g) (physicalGroupPhaseActivity R g) :=
  physicalGroupBareRawEdge C aux k L R n hlist hP hdis
    (physical_bare_step_compatibility_of_residues C aux k L R ζ n hL hR) g hk β ρ V cap

/-- The independent-residue constructor has the same complete row identity;
no realization by an integer-valued physical state is assumed. -/
theorem physical_group_residue_raw_edge_intertwines {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) (L R : PhysicalMarkLists P J ell) (n : ℤ)
    (hlist : physicalListAdmissible C aux L R)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (ζ : ∀ p : PhysicalPrime P, ZMod p.2.val)
    (hL : ∀ p ∈ physicalMarkedPrimes L, ζ p = -(n : ZMod p.2.val))
    (hR : ∀ p ∈ physicalMarkedPrimes R,
      ζ p = -((n + k * (physicalD C L aux : ℤ) : ℤ) : ZMod p.2.val))
    (g : G) [∀ p : ↥(P g), NeZero p.val]
    (hk : ∀ s, ¬ ((L g s).val : ℤ) ∣ k)
    (β : ↥(P g) → ℝ) (ρ V : ℝ) (cap : ℕ)
    (H : Finset ↥(P g)) (q : FiniteOrderedTuple (Σ p : ↥(P g), ZMod p.val))
    (hq : GlobalBirthMemoryCoherent
      (ghostPhaseActivitySupport (physicalGroupPhaseActivity L g)) H q)
    (F : Finset ↥(P g) → FiniteOrderedTuple (Σ p : ↥(P g), ZMod p.val) → ℂ)
    (f : ((p : ↥(P g)) → GhostPhaseState (ZMod p.val)) → ℂ)
    (hF : ∀ H' q', GlobalBirthMemoryCoherent
      (ghostPhaseActivitySupport (physicalGroupPhaseActivity R g)) H' q' → q'.1 ≤ cap →
      F H' q' = f (globalBirthMemoryReadout
        (ghostPhaseActivitySupport (physicalGroupPhaseActivity R g)) H' q')) :
    globalBirthRawStepRow
      (physicalGroupResidueRawEdge C aux k L R n hlist hP hdis ζ hL hR g hk β ρ V cap) F H q =
      globalBirthRawStepPhaseRow
        (physicalGroupResidueRawEdge C aux k L R n hlist hP hdis ζ hL hR g hk β ρ V cap) f
        (globalBirthMemoryReadout (ghostPhaseActivitySupport (physicalGroupPhaseActivity L g)) H q) :=
  global_birth_raw_step_intertwines
    (physicalGroupResidueRawEdge C aux k L R n hlist hP hdis ζ hL hR g hk β ρ V cap)
    H q hq F f hF
end

