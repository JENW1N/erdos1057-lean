    ((∏ s : PhysicalSlots J ell, β ((x 0).2.val g s) / V : ℝ) : ℂ) *
      physicalGroupPermutedFiniteRawHistory C aux k x σ τ hadm hP hdis g hk β η V ρ hV cap =
