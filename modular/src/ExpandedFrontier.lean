/- The actual normalized candidate residual produces the two invariant endpoints. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

theorem candidate_cross_pair_eq_original_invariant_endpoints
    (c L q : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm
      (candidateRoughSlot c L r jStar hr hj)) = false)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (σ : ℝ)
    (hphase : ∀ p ∈ candidateRoughBand c L jStar,
      twist (candidateRoughSlot c L r jStar hr hj) p = typeIIPhase σ p)
    (marks : ℕ → ℕ) (M H : Finset ℕ) (α : ℕ → ℂ)
    (modulus : ℕ) (χ : DirichletCharacter ℂ modulus) (ρ ξ₁ ξ₂ ξ₃ : ℝ)
    {z w : ℕ} (hz : 0 < z) (hw : 0 < w)
    (hM : ∀ m ∈ M, 0 < m) (hH : ∀ h ∈ H, 0 < h)
    (hfree : ∀ m ∈ M, Disjoint m.primeFactors
      ((candidatePIndices c L).biUnion (candidatePBand (c*L))))
    (hHz : ∀ m ∈ M, m ∣ z → z/m ∈ H) (hHw : ∀ m ∈ M, m ∣ w → w/m ∈ H)
    (hα : ∀ m, m ∉ M → α m=0) :
    let P := (candidatePIndices c L).biUnion (candidatePBand (c*L))
    let W : ℕ → ℝ := fun n => markedDivisorWeight (candidatePIndices c L)
      (candidatePBand (c*L)) q (fun j => ∑ p ∈ candidatePBand (c*L) j, 1/(p : ℝ)) marks (n : ℤ)
    let cr := candidateResidualPrimeCoefficient c L r jStar hr hj take hkeep twist
    let F₀ := invariantTripleEndpoint P
      (fun m => α m * χ (m : ZMod modulus) * typeIIPhase (ρ-ξ₂) m)
      (fun p => if p ∈ candidateRoughBand c L jStar then typeIIPhase (-σ) p else 0)
      (fun s => conj (cr s))
    let G₀ := invariantTripleEndpoint P
      (fun m => α m * χ (m : ZMod modulus) * typeIIPhase (ξ₁+ρ) m)
      (fun p => if p ∈ candidateRoughBand c L jStar then typeIIPhase (-σ) p else 0)
      (fun s => conj (cr s))
    typeIICrossPairCoefficient M H (fun m => α m * χ (m : ZMod modulus)) W
      (fun h => candidateRemainingComplexCoefficient c L r jStar take twist (primePoolFreePart P h))
      ρ ξ₁ ξ₂ ξ₃ z w =
      typeIIPhase (ρ+ξ₃) z * typeIIPhase (-ρ) w * conj (F₀ z) * G₀ w * (W z : ℂ) * (W w : ℂ) := by
  dsimp only
  let P := (candidatePIndices c L).biUnion (candidatePBand (c*L))
  let C := candidateResidualPrimeSupport c L r jStar hr hj take hkeep
  let cr := candidateResidualPrimeCoefficient c L r jStar hr hj take hkeep twist
  have hB : (fun h => candidateRemainingComplexCoefficient c L r jStar take twist
      (primePoolFreePart P h)) =
      (fun h => typeIIRoughConvolution (candidateRoughBand c L jStar) C σ cr (primePoolFreePart P h)) := by
    funext h
    exact candidate_remaining_eq_typeIIRoughConvolution c L r jStar hr hj take hkeep twist σ hphase _
  rw [hB]
  refine typeII_character_cross_pair_eq_original_endpoints P M H (candidateRoughBand c L jStar) C α cr _
    modulus χ ρ σ ξ₁ ξ₂ ξ₃ hz hw hM hH hfree ?_ hHz hHw hα ?_
  · intro m hm h _
    apply marked_divisor_weight_mul_free_left (candidatePIndices c L) (candidatePBand (c*L)) q _ marks
    · intro j _ p hp
      exact (mem_filter.mp hp).2
    · exact (hM m hm).ne'
    · exact hfree m hm
  · intro s hs
    exact candidate_residual_prime_coefficient_eq_zero_of_not_mem c L r jStar hr hj take hkeep twist hs


end Bounty
