      (fun j g => physicalFullSharedIndices (ell := ell) (Cn j g)) B
      (fun j _ => PhysicalAuxLabels (fun g => P (e.symm g).val) (Cn j))
      (fun j => physicalFullEdgeDelta (Cn j) (kn j)) (fun j => physicalFullEdgeD (Cn j))) ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1))) x
  let _ : Fintype (PhysicalEffectivePlannedBigPath (fun (i : patterns) g => C i.val (e.symm g).val) (fun (j : Fin (n + 1)) (i : patterns) => k (n - j.val) i.val) B ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1))) pl.1 pl.2 x) :=
    Fintype.ofEquiv (FullPermutationMixedPath (fun g (p : P (e.symm g).val) => p.val)
      (fun j g => physicalFullSharedIndices (ell := ell) (Cn j g)) B
      (fun j _ => PhysicalAuxLabels (fun g => P (e.symm g).val) (Cn j))
      (fun j => physicalFullEdgeDelta (Cn j) (kn j)) (fun j => physicalFullEdgeD (Cn j))
      ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1))) x)
      (physicalRootSelectedEffectivePathEquiv groups e patterns C hC k pl x)
  unfold physicalOriginalWeightedMoment physicalRootEffectivePathSum
  dsimp only
  refine Eq.trans ?_ ((physicalRootSelectedEffectivePathEquiv groups e patterns C hC k pl x).sum_comp
    (physicalRootEffectiveIntegrand groups e patterns C hC k pl V q ζ K r θ β retention ρ f x))
  apply Finset.sum_congr rfl
  intro path _
  exact physical_root_direct_effective_integrand groups e patterns C hC k pl V q ζ K r θ β retention ρ
    hq cut hencode f x hx path

end Sum
end Bounty

section

/- The original root scalar equals the literal mixed path action averaged over its initial marks. -/

open Finset Classical
namespace Bounty
section Scalar
variable {I : Type} {N M J ell n B : ℕ} {P : Fin N → Finset ℕ}
  [∀ z : PhysicalPrime P, NeZero z.2.val]
  (groups : Finset (Fin N)) (e : {g // g ∉ groupsᶜ} ≃ Fin M)
  (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
  (hC : ∀ i : patterns, ∀ g : ↥groupsᶜ, C i.val g.val = ∅)
  (V : Fin N → ℝ) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
  (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
    PhysicalAuxLabels P (C i) → ℂ)
  (r : PhysicalGroupResidues P groupsᶜ) (θ : ℝ)
  (β : PhysicalPrime P → ℝ) (ρ : ℝ)
  (hP : ∀ g a, a ∈ P g → Nat.Prime a)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))

noncomputable def physicalRootMixedScalar : ℂ :=
  (physicalStateMass (fun s : ↥groupsᶜ => V s.val) J ell : ℂ) *
  ∑ Ls : PhysicalMarkLists (fun s : ↥groupsᶜ => P s.val) J ell,
    ∑ Lb : PhysicalMarkLists (fun g => P (e.symm g).val) J ell,
      ((∏ g, ∏ s : PhysicalSlots J ell,
        β ⟨(e.symm g).val, Lb g s⟩ / V (e.symm g).val : ℝ) : ℂ) *
      physicalRootMixedAction (n := n) groups e patterns C hC k V q ζ K r θ
        (fun (g : Fin M) (z : P (e.symm g).val) => β ⟨(e.symm g).val, z⟩) (fun j => physicalEndpointSchedule q (n + 1) j.val) ρ
        (fun (s : ↥groupsᶜ) => hP s.val) (fun (g : Fin M) => hP (e.symm g).val)
        (physical_root_group_pools_disjoint groups e hdis)
        fullMemoryVacuum Ls (physicalFullMemoryState (fun _ => ∅) Lb
          (fun g => fullEmptyBoundedMemory (UnrestrictedResidueParticle (fun z : P (e.symm g).val => z.val)) B))

theorem physical_root_compact_small_plan_eq_mixed_scalar
    (hk : ∀ t < n + 1, ∀ i ∈ patterns, ∀ g a, a ∈ P g → ¬ (a : ℤ) ∣ k t i)
    (hV : ∀ g, V g ≠ 0) (hρ : ρ ≠ 0)
    (hB : (physicalPrimeGroups P groups).card ≤ B) (hq : 0 ≤ q) :
    physicalRootSmallPlanSum (n := n) groups patterns C hC V q ζ k K β B r θ =
      physicalRootMixedScalar (n := n) (B := B) groups e patterns C hC V q ζ k K r θ β ρ hP hdis := by
  let _ := physicalMixedSmallPlanFintype (Ps := (fun s : ↥groupsᶜ => P s.val))
    (J := J) (ell := ell) (I := patterns) ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1)))
  let _ : ∀ p : PhysicalRootSmallPlan (P := P) (J := J) (ell := ell) (n := n) groups patterns, Fintype (PhysicalRootSmallPlanBigData groups patterns C hC p) :=
    fun p => physicalGroupSelectedDataFintype
      (P := fun g : {g // g ∉ groupsᶜ} => P g.val)
      (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val g.val)
  let _ : ∀ p : PhysicalRootSmallPlan (P := P) (J := J) (ell := ell) (n := n) groups patterns, Fintype (PhysicalSelectedData (fun g => P (e.symm g).val) ell
      (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val)) :=
    fun p => physicalSelectedDataFintype
      (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val)
  have hf : ∀ p : PhysicalRootSmallPlan (P := P) (J := J) (ell := ell) (n := n) groups patterns,
      (∑ db : PhysicalRootSmallPlanBigData groups patterns C hC p,
        physicalRootSmallPlanIntegrand groups patterns C hC V q ζ k K β B r θ p db) =
      (physicalStateMass (fun s : ↥groupsᶜ => V s.val) J ell : ℂ) * ∑ Lb : PhysicalMarkLists (fun g => P (e.symm g).val) J ell,
        ((∏ g, ∏ s : PhysicalSlots J ell,
        β ⟨(e.symm g).val, Lb g s⟩ / V (e.symm g).val : ℝ) : ℂ) * physicalRootEffectivePathSum groups e patterns C hC k p V q ζ K r θ
        (fun (g : Fin M) (z : P (e.symm g).val) => β ⟨(e.symm g).val, z⟩) (fun j => physicalEndpointSchedule q (n + 1) j.val) ρ
        fullMemoryVacuum (physicalFullMemoryState (fun _ => ∅) Lb
          (fun g => fullEmptyBoundedMemory (UnrestrictedResidueParticle (fun z : P (e.symm g).val => z.val)) B)) := by
    intro p
    unfold physicalRootSmallPlanIntegrand
    let Cn := fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val
    let cut := physicalSelectedFineCut Cn
    have hencode := physical_selected_fine_cut_encoding Cn
    rw [physical_root_direct_integrand_sum_eq_weighted_moment groups e patterns C hC V q ζ k K r θ p
      hP hdis hk β ρ hV hρ hB cut hencode]
    simp only [cut, physical_selected_fine_cut_zero]
    congr 1
    apply sum_congr rfl
    intro L _
    congr 1
    exact physical_root_direct_moment_eq_effective_path_sum groups e patterns C hC k p V q ζ K r θ
      (fun g z => β ⟨(e.symm g).val, z⟩)
      (fun j => physicalEndpointSchedule q (n + 1) j.val) ρ hq cut hencode fullMemoryVacuum
      (physicalFullMemoryState (fun _ => ∅) L
        (fun g => fullEmptyBoundedMemory
          (UnrestrictedResidueParticle (fun z : P (e.symm g).val => z.val)) B))
      (physical_full_state_injective (fun _ => ∅) L
        (fun g => fullEmptyBoundedMemory
          (UnrestrictedResidueParticle (fun z : P (e.symm g).val => z.val)) B))
  rw [physical_root_small_plan_sigma]
  simp_rw [hf]
  rw [← Finset.mul_sum, Fintype.sum_prod_type]
  unfold physicalRootMixedScalar
  congr 1
  apply sum_congr rfl
  intro Ls _
  rw [Finset.sum_comm]
  apply sum_congr rfl
  intro Lb _
  rw [← Finset.mul_sum]
  congr 1
  exact (physical_root_mixed_action_eq_plan_sum (n := n) groups e patterns C hC k V q ζ K r θ
    (fun (g : Fin M) (z : P (e.symm g).val) => β ⟨(e.symm g).val, z⟩)
    (fun j => physicalEndpointSchedule q (n + 1) j.val) ρ
    (fun (s : ↥groupsᶜ) => hP s.val) (fun (g : Fin M) => hP (e.symm g).val)
    (physical_root_group_pools_disjoint groups e hdis)
    fullMemoryVacuum Ls (physicalFullMemoryState (fun _ => ∅) Lb
      (fun g => fullEmptyBoundedMemory
        (UnrestrictedResidueParticle (fun z : P (e.symm g).val => z.val)) B))).symm

theorem physical_root_small_plan_eq_mixed_scalar
    (hk : ∀ t < n + 1, ∀ i ∈ patterns, ∀ g a, a ∈ P g → ¬ (a : ℤ) ∣ k t i)
    (hV : ∀ g, V g ≠ 0) (hρ : ρ ≠ 0)
    (hB : (physicalPrimeGroups P groups).card ≤ B) (hq : 0 ≤ q) :
    physicalRootSmallPlanSum (n := n) groups patterns C hC V q ζ k K β B r θ =
      physicalRootMixedScalar (n := n) (B := B) groups e patterns C hC V q ζ k K r θ β ρ hP hdis := by
  exact physical_root_compact_small_plan_eq_mixed_scalar groups e patterns C hC
    V q ζ k K r θ β ρ hP hdis hk hV hρ hB hq

end Scalar
end Bounty
end

section

/- The full original residue model is expressed using the literal mixed path action and its exact history phase. -/

open Finset MeasureTheory
open scoped Classical
namespace Bounty

theorem physical_root_residue_model_mixed_action
    {I : Type} {N M J ell n : ℕ} {P : Fin N → Finset ℕ}
    [∀ a : PhysicalPrime P, NeZero a.2.val]
    (groups : Finset (Fin N)) (e : {g // g ∉ groupsᶜ} ≃ Fin M)
    (V : Fin N → ℝ) (patterns : Finset I)
    (C : I → Fin N → Finset (Fin J))
    (hC : ∀ i : patterns, ∀ g : ↥groupsᶜ, C i.val g.val = ∅)
    (q : ℝ) (hq : 0 ≤ q) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ)
    (hV : ∀ g, 0 < V g) (hP : ∀ g a, a ∈ P g → Nat.Prime a)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hk : ∀ t < n + 1, ∀ i ∈ patterns, ∀ g a, a ∈ P g → ¬ (a : ℤ) ∣ k t i)
    (b : PhysicalPrime P → ℝ)
    (hb : ∀ a : PhysicalPrime P, a.1 ∈ groups →
      b a = 1 - (∑ j ∈ range (n + 2), (1 - physicalEndpointSchedule q (n + 1) j)) / a.2.val)
    (hb0 : ∀ a : PhysicalPrime P, a.1 ∈ groups → b a ≠ 0)
    (B : ℕ) (hB : (physicalPrimeGroups P groups).card ≤ B) :
    physicalRootResidueModel V patterns C q ζ k K n =
      (∏ a ∈ physicalPrimeGroups P groups, b a : ℝ) *
      ∑ r : PhysicalGroupResidues P groupsᶜ,
        (∏ a : ↥(physicalPrimeGroups P groupsᶜ), 1 / (a.val.2.val : ℝ)) *
        ∫ θ : ℝ in (0 : ℝ)..1,
        physicalRootMixedScalar (n := n) (B := B) groups e patterns C hC V q ζ k K r θ
          (fun a => ((a.2.val : ℝ) * b a)⁻¹) 1 hP hdis := by
  rw [physical_root_residue_model_small_plan groups V patterns C hC q ζ k K hV hP hdis hk b hb hb0 B hB]
  apply congrArg (fun z : ℂ => ((∏ a ∈ physicalPrimeGroups P groups, b a : ℝ) : ℂ) * z)
  apply sum_congr rfl
  intro r _
  apply congrArg (fun z : ℂ =>
    ((∏ a : ↥(physicalPrimeGroups P groupsᶜ), 1 / (a.val.2.val : ℝ) : ℝ) : ℂ) * z)
  apply congrArg (fun f : ℝ → ℂ => ∫ θ : ℝ in (0 : ℝ)..1, f θ)
  funext θ
  exact physical_root_small_plan_eq_mixed_scalar groups e patterns C hC V q ζ k K r θ
    (fun a => ((a.2.val : ℝ) * b a)⁻¹) 1 hP hdis hk (fun g => ne_of_gt (hV g))
    one_ne_zero hB hq

end Bounty
end
