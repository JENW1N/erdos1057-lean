      ∑ x : Fin (n + 1) → GlobalBirthJointPhase R,
        F (x (Fin.last n)) * finiteChronologicalPrefix
          (globalBirthJointHistoryKernel a steps cap)
          (fun z => if z = globalBirthJointReadout (a 0) s then 1 else 0) n x := by
  rw [global_birth_joint_raw_history_intertwines a steps cap n G F hGF s hs]
