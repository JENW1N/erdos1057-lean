/- The harmonic cross sum with the original marked weights and invariant endpoints. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

theorem candidate_harmonic_cross_pairs_eq_original_endpoints
    (c L q : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm
      (candidateRoughSlot c L r jStar hr hj)) = false)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (σ : ℝ)
    (hphase : ∀ p ∈ candidateRoughBand c L jStar,
      twist (candidateRoughSlot c L r jStar hr hj) p = typeIIPhase σ p)
    (marks : ℕ → ℕ) (Z : ℝ) (k : ℤ) (M H Zs : Finset ℕ)
    (α : ℕ → ℂ) (ρ : ℝ) (χ : DirichletCharacter ℂ (2*k.natAbs))
    (hM : ∀ m ∈ M, 0 < m) (hH : ∀ h ∈ H, 0 < h)
    (hpos : ∀ z ∈ Zs, 0 < z ∧ 0 < (z : ℤ)+k)
    (hfree : ∀ m ∈ M, Disjoint m.primeFactors
      ((candidatePIndices c L).biUnion (candidatePBand (c*L))))
    (hHz : ∀ z ∈ Zs, ∀ m ∈ M, m ∣ z → z/m ∈ H)
    (hHw : ∀ z ∈ Zs, ∀ m ∈ M, m ∣ ((z : ℤ)+k).toNat → ((z : ℤ)+k).toNat/m ∈ H)
    (hα : ∀ m, m ∉ M → α m=0) (ξ : EuclideanSpace ℝ (Fin 3)) :
    let P := (candidatePIndices c L).biUnion (candidatePBand (c*L))
    let W : ℕ → ℝ := fun n => markedDivisorWeight (candidatePIndices c L)
      (candidatePBand (c*L)) q (fun j => ∑ p ∈ candidatePBand (c*L) j, 1/(p : ℝ)) marks (n : ℤ)
    let cr := candidateResidualPrimeCoefficient c L r jStar hr hj take hkeep twist
    let F₀ := invariantTripleEndpoint P
      (fun m => α m * χ (m : ZMod (2*k.natAbs)) * typeIIPhase (ρ-2*Real.pi*ξ 1) m)
      (fun p => if p ∈ candidateRoughBand c L jStar then typeIIPhase (-σ) p else 0)
      (fun s => conj (cr s))
    let G₀ := invariantTripleEndpoint P
      (fun m => α m * χ (m : ZMod (2*k.natAbs)) * typeIIPhase (2*Real.pi*ξ 0+ρ) m)
      (fun p => if p ∈ candidateRoughBand c L jStar then typeIIPhase (-σ) p else 0)
      (fun s => conj (cr s))
    (∑ z ∈ Zs, ((typeIIHarmonicDyadic ((z : ℝ)/Z)/(z : ℝ) : ℝ) : ℂ) *
      typeIICrossPairCoefficient M H
        (fun m => α m * χ (m : ZMod (2*k.natAbs))) W
        (fun h => candidateRemainingComplexCoefficient c L r jStar take twist (primePoolFreePart P h))
        ρ (2*Real.pi*ξ 0) (2*Real.pi*ξ 1) (2*Real.pi*ξ 2) z ((z : ℤ)+k).toNat) =
      ∑ z ∈ Zs, ((typeIIHarmonicDyadic ((z : ℝ)/Z)/(z : ℝ) : ℝ) : ℂ) *
        (typeIIPhase (ρ+2*Real.pi*ξ 2) z * typeIIPhase (-ρ) ((z : ℤ)+k).toNat *
          conj (F₀ z) * G₀ ((z : ℤ)+k).toNat * (W z : ℂ) * (W ((z : ℤ)+k).toNat : ℂ)) := by
  dsimp only
  apply sum_congr rfl
  intro z hz
  rw [candidate_cross_pair_eq_original_invariant_endpoints c L q r jStar hr hj take hkeep
    twist σ hphase marks M H α (2*k.natAbs) χ ρ (2*Real.pi*ξ 0) (2*Real.pi*ξ 1)
    (2*Real.pi*ξ 2) (hpos z hz).1 (Int.pos_iff_toNat_pos.mp (hpos z hz).2) hM hH hfree
    (hHz z hz) (hHw z hz) hα]

theorem candidate_character_cross_fourier_eq_harmonic_original_endpoints
    (c L q : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm
      (candidateRoughSlot c L r jStar hr hj)) = false)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (σ : ℝ)
    (hphase : ∀ p ∈ candidateRoughBand c L jStar,
      twist (candidateRoughSlot c L r jStar hr hj) p = typeIIPhase σ p)
    (marks : ℕ → ℕ) (A U V E Z : ℝ) (k : ℤ) (M H Zs : Finset ℕ)
    (α : ℕ → ℂ) (ρ : ℝ) (χ : DirichletCharacter ℂ (2*k.natAbs))
    (hM : ∀ m ∈ M, 0 < m) (hH : ∀ h ∈ H, 0 < h)
    (hk : k ≠ 0) (hZ : 0 < Z)
    (hpos : ∀ z ∈ Zs, 0 < z ∧ 0 < (z : ℤ)+k)
    (hfree : ∀ m ∈ M, Disjoint m.primeFactors
      ((candidatePIndices c L).biUnion (candidatePBand (c*L))))
    (hHz : ∀ z ∈ Zs, ∀ m ∈ M, m ∣ z → z/m ∈ H)
    (hHw : ∀ z ∈ Zs, ∀ m ∈ M, m ∣ ((z : ℤ)+k).toNat → ((z : ℤ)+k).toNat/m ∈ H)
    (hα : ∀ m, m ∉ M → α m=0) (ξ : EuclideanSpace ℝ (Fin 3)) :
    let P := (candidatePIndices c L).biUnion (candidatePBand (c*L))
    let W : ℕ → ℝ := fun n => markedDivisorWeight (candidatePIndices c L)
      (candidatePBand (c*L)) q (fun j => ∑ p ∈ candidatePBand (c*L) j, 1/(p : ℝ)) marks (n : ℤ)
    let cr := candidateResidualPrimeCoefficient c L r jStar hr hj take hkeep twist
    let F₀ := invariantTripleEndpoint P
      (fun m => α m * χ (m : ZMod (2*k.natAbs)) * typeIIPhase (ρ-2*Real.pi*ξ 1) m)
      (fun p => if p ∈ candidateRoughBand c L jStar then typeIIPhase (-σ) p else 0)
      (fun s => conj (cr s))
    let G₀ := invariantTripleEndpoint P
      (fun m => α m * χ (m : ZMod (2*k.natAbs)) * typeIIPhase (2*Real.pi*ξ 0+ρ) m)
      (fun p => if p ∈ candidateRoughBand c L jStar then typeIIPhase (-σ) p else 0)
      (fun s => conj (cr s))
    typeIICrossCharacterFourierIntegrand A L U V E Z k M H Zs typeIISmoothDyadic α
      (typeIISeparatedH W
        (fun h => candidateRemainingComplexCoefficient c L r jStar take twist (primePoolFreePart P h)) ρ) χ ξ =
      typeIICrossFourierScale A L U V E Z k ξ * (Z : ℂ) *
        ∑ z ∈ Zs, ((typeIIHarmonicDyadic ((z : ℝ)/Z)/(z : ℝ) : ℝ) : ℂ) *
          (typeIIPhase (ρ+2*Real.pi*ξ 2) z * typeIIPhase (-ρ) ((z : ℤ)+k).toNat *
            conj (F₀ z) * G₀ ((z : ℤ)+k).toNat * (W z : ℂ) * (W ((z : ℤ)+k).toNat : ℂ)) := by
  dsimp only
  rw [typeII_character_cross_fourier_eq_harmonic_cross_pairs A L U V E Z k M H Zs
    α _ _ ρ χ hM hk hZ hpos ξ]
  apply congrArg (fun v : ℂ => typeIICrossFourierScale A L U V E Z k ξ * (Z : ℂ) * v)
  apply sum_congr rfl
  intro z hz
  have hw : 0 < ((z : ℤ)+k).toNat := by
    have heq := Int.toNat_of_nonneg (hpos z hz).2.le
    have hpos' := (hpos z hz).2
    omega
  rw [candidate_cross_pair_eq_original_invariant_endpoints c L q r jStar hr hj take hkeep
    twist σ hphase marks M H α (2*k.natAbs) χ ρ (2*Real.pi*ξ 0) (2*Real.pi*ξ 1)
    (2*Real.pi*ξ 2) (hpos z hz).1 hw hM hH hfree (hHz z hz) (hHw z hz) hα]


end Bounty
