section

/- Four-factor integral decay with actual small-prime exceptional sets.
Both integral-energy inputs are discharged from literal dyadic coefficients.
The high- and low-frequency pointwise estimates remain explicit. -/

open Filter Finset Set MeasureTheory

namespace Bounty

theorem eventually_prime_four_factor_integral_decay
    {a beta c d Bcoeff A As H Bsave B0 Cmean Cres kmean kres q t : ℝ}
    (ha : 0 < a) (ha1 : a ≤ 1) (hbeta : beta < 1) (hc : 0 ≤ c) (hd : 0 < d)
    (hBcoeff : 1 ≤ Bcoeff) (hAs0 : 0 ≤ As)
    (hAs : A + (Cmean + 2 + 2 * kmean) + 1 ≤ 2 * As)
    (hH : A + 2 + (Cres + 2 + 2 * kres) + 1 ≤ 2 * H)
    (hBsave : A + B0 + 2 + 2 * q + 2 * t + 1 ≤ 2 * Bsave) :
    ∀ᶠ L : ℝ in atTop, ∀ (s : Finset ℕ), (∀ p ∈ s, Nat.Prime p) →
      ∀ (coeff : s → ℂ) (Y P R : ℝ),
      1 ≤ Y → d * L ≤ Real.log Y → Real.log Y ≤ c * L →
      Real.exp (L ^ a) / 2 ≤ P → P ≤ Real.exp (L ^ beta) →
      0 ≤ R → R ≤ Y →
      (∀ p ∈ s, P ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2 * P) →
      (∀ p : s, ‖coeff p‖ ≤ Bcoeff) →
      ∀ (Q M T : ℝ → ℂ), Continuous Q → Continuous M → Continuous T →
      (∀ u ∈ Set.Icc (-R) R, ‖Q u‖ ≤ L ^ q) →
      (∀ u ∈ Set.Icc (-R) R, ‖T u‖ ≤ L ^ t) →
      (∀ u ∈ Set.Icc (-R) R, L ^ B0 < |u| → ‖Q u‖ ≤ L ^ (-H)) →
      (∀ u ∈ Set.Icc (-R) R, |u| ≤ L ^ B0 → ‖M u‖ ≤ L ^ (-Bsave)) →
      ∀ (Km Kr : ℕ) (lom him : Fin Km → ℕ) (lor hir : Fin Kr → ℕ)
        (wm : Fin Km → ℕ → ℂ) (wr : Fin Kr → ℕ → ℂ)
        (Um : Fin Km → ℝ) (Ur : Fin Kr → ℝ),
      (Km : ℝ) ≤ L ^ kmean → (Kr : ℝ) ≤ L ^ kres →
      (∀ j, 1 ≤ Um j ∧ R ≤ Um j ∧ Real.log (Um j) ≤ c * L ∧
        Um j ≤ (lom j : ℝ) ∧ (him j : ℝ) ≤ 2 * Um j ∧
        (∑ n ∈ Finset.Icc (lom j) (him j), ‖wm j n‖ ^ 2) ≤ L ^ Cmean / Um j) →
      (∀ j, Y ^ (3 / 5 : ℝ) ≤ Ur j ∧ Ur j ≤ (lor j : ℝ) ∧
        (hir j : ℝ) ≤ 2 * Ur j ∧
        (∑ n ∈ Finset.Icc (lor j) (hir j), ‖wr j n‖ ^ 2) ≤ L ^ Cres / Ur j) →
      (∀ u, Q u * M u * T u = ∑ j : Fin Km, ∑ n ∈ Finset.Icc (lom j) (him j),
        wm j n * Complex.exp ((Real.log (n : ℝ) * u : ℝ) * Complex.I)) →
      (∀ u, M u * T u = ∑ j : Fin Kr, ∑ n ∈ Finset.Icc (lor j) (hir j),
        wr j n * Complex.exp ((Real.log (n : ℝ) * u : ℝ) * Complex.I)) →
      (∫ u in Set.Icc (-R) R, ‖primeReciprocalPolynomial s coeff u * Q u * M u * T u‖ ^ 2)
        ≤ L ^ (-A) := by
  filter_upwards [eventually_dyadic_family_mean_energy (C := Cmean) (k := kmean) hc,
    eventually_prime_exceptional_dyadic_family_energy (C := Cres) (k := kres)
      ha ha1 hbeta hc hAs0 hBcoeff hd,
    eventually_ge_atTop (4 : ℝ), eventually_ge_atTop (2 * Bcoeff)]
    with L hmean hsparse hL hLB
  intro s hs coeff Y P R hY hloglo hloghi hPlo hPhi hR hRY hband hcoeff
    Q M T hQ hM hT hQbound hTbound hhigh hlow
    Km Kr lom him lor hir wm wr Um Ur hKm hKr hmdata hrdata hmrep hrrep
  have hL1 : 1 ≤ L := by linarith
  have hP1 : 1 ≤ P := by
    have hx : 1 ≤ L ^ a := Real.one_le_rpow hL1 ha.le
    have he : Real.exp 1 ≤ Real.exp (L ^ a) := Real.exp_le_exp.mpr hx
    have htwo : 2 ≤ Real.exp (1 : ℝ) := by
      have hh := Real.add_one_le_exp (1 : ℝ)
      norm_num at hh ⊢
      exact hh
    linarith
  have hS : Continuous (primeReciprocalPolynomial s coeff) := by
    unfold primeReciprocalPolynomial
    fun_prop
  have hSbound : ∀ u ∈ Set.Icc (-R) R,
      ‖primeReciprocalPolynomial s coeff u‖ ≤ L ^ (1 : ℝ) := by
    intro u _
    simpa only [Real.rpow_one] using
      (prime_reciprocal_polynomial_norm_le s coeff hP1
        (zero_le_one.trans hBcoeff) hband hcoeff u).trans hLB
  have hmean' := hmean Km lom him wm Um R hKm hR hmdata
  simp_rw [← hmrep] at hmean'
  have hsparse' := hsparse s hs coeff Y P R hY hloglo hloghi hPlo hPhi hR hRY
    hband hcoeff Kr lor hir wr Ur hKr hrdata
  simp_rw [← hrrep] at hsparse'
  have hE : {u ∈ Set.Icc (-R) R | L ^ (-As) < ‖primeReciprocalPolynomial s coeff u‖} =
      primeExceptionalTimes s coeff (L ^ (-As)) R := by
    ext u
    change ((-R ≤ u ∧ u ≤ R) ∧ _) ↔ (|u| ≤ R ∧ _)
    rw [abs_le]
  refine three_regime_integral_decay R (primeReciprocalPolynomial s coeff) Q M T
    hS hQ hM hT hL hAs (by simpa using hH) (by simpa using hBsave)
    hSbound hQbound hTbound ?_ hlow hmean' ?_
  · intro u hu _ hlarge
    exact hhigh u hu hlarge
  · simpa only [hE] using hsparse'

end Bounty
end

section

/- Partial summation of the oscillatory rough count keeps the frequency in the coefficients. -/

open Finset

namespace Bounty

theorem exists_rough_harmonic_phase_bound (τ : ℝ) (hτ : 0 < τ) :
    ∃ δ C K N0 : ℝ, 0 < δ ∧ 0 < C ∧ 0 < K ∧ 1 ≤ N0 ∧
      ∀ (z : ℝ) (h : ℕ), 1 < z → 1 ≤ h → Even h →
      ∀ (Y x u : ℝ) (a b q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q),
      a ≤ b → Y ≤ (a : ℝ)+1 → (b : ℝ) ≤ 2*Y →
      N0 ≤ Y/(z^(4*(h : ℝ)+2)*(q : ℝ)) →
      1 ≤ x → x^(τ/2) ≤ Y/(z^(4*(h : ℝ)+2)*(q : ℝ)) →
      u ≠ 0 → |u| ≤ x^2 →
      ‖∑ n ∈ (Ioc a b).filter (fun n : ℕ => ∀ p ∈ n.primeFactors, z < (p : ℝ)),
        harmonicMellinWeight u n*χ (n : ZMod q)‖ ≤
        3*K*(2*Real.exp (-(h : ℝ))+z^(4*(h : ℝ)+2)/Y+
          C*Real.log (2*z)*(1/|u|+(Y/(z^(4*(h : ℝ)+2)*(q : ℝ)))^(-δ))) := by
  obtain ⟨δ,C,K,N0,hδ,hC,hK,hN0,hraw⟩ := exists_rough_logarithmic_sieve_bound τ hτ
  refine ⟨δ,C,K,N0,hδ,hC,hK,hN0,?_⟩
  intro z h hz hh heven Y x u a b q hqInst χ hab hYa hbY hN hx hxN hu hux
  have hz0 : 0 < z := lt_trans zero_lt_one hz
  have hqR : 0 < (q : ℝ) := by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne q)
  have hlevel : 0 < z^(4*(h : ℝ)+2) := Real.rpow_pos_of_pos hz0 _
  have hNpos : 0 < Y/(z^(4*(h : ℝ)+2)*(q : ℝ)) :=
    lt_of_lt_of_le (lt_of_lt_of_le zero_lt_one hN0) hN
  have hY : 0 < Y := (div_pos_iff.mp hNpos).resolve_right (by
    intro ht
    exact (not_lt_of_ge (mul_pos hlevel hqR).le) ht.2) |>.1
  have hlog : 0 ≤ Real.log (2*z) := Real.log_nonneg (by linarith)
  by_cases heq : a = b
  · subst b
    simp only [Ioc_self,filter_empty,sum_empty,norm_zero]
    positivity
  have hab' : a < b := lt_of_le_of_ne hab heq
  let g : ℕ → ℂ := fun n => if ∀ p ∈ n.primeFactors, z < (p : ℝ)
    then χ (n : ZMod q)*Complex.exp (((u*Real.log (n : ℝ) : ℝ) : ℂ)*Complex.I) else 0
  let B : ℝ := K*(2*Y*Real.exp (-(h : ℝ))+z^(4*(h : ℝ)+2))+
    Y*(C*(1/|u|+(Y/(z^(4*(h : ℝ)+2)*(q : ℝ)))^(-δ)))*(K*Real.log (2*z))
  have hB : 0 ≤ B := by dsimp [B]; positivity
  have hprefix : ∀ i ∈ Icc a b, ‖∑ n ∈ Ioc a i, g n‖ ≤ B := by
    intro i hi
    have hi' := mem_Icc.mp hi
    have hb := hraw z h hz hh heven Y x u a i q χ hi'.1 hYa
      ((Nat.cast_le.mpr hi'.2).trans hbY) hN hx hxN hu hux
    simpa only [sum_filter,g,B] using hb
  have hb := norm_harmonic_mellin_interval_sum_le (v := 0) g hY hab'
    (by simpa only [Nat.cast_add,Nat.cast_one] using hYa) hbY hB hprefix
  simp only [abs_zero,mul_zero,add_zero] at hb
  have he : (∑ n ∈ (Ioc a b).filter (fun n : ℕ => ∀ p ∈ n.primeFactors, z < (p : ℝ)),
      harmonicMellinWeight u n*χ (n : ZMod q)) =
      ∑ n ∈ Ioc a b, harmonicMellinWeight 0 n*g n := by
    rw [sum_filter]
    apply sum_congr rfl
    intro n hn
    simp only [g,harmonicMellinWeight,zero_mul,Complex.ofReal_zero,
      mul_zero,Complex.exp_zero]
    rw [mul_comm Complex.I]
    split_ifs <;> ring
  rw [he]
  apply hb.trans_eq
  dsimp [B]
  field_simp

end Bounty
end

section

/- Exact original full-vertex pair sum on the shared good event. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_good_original_pair_sum_eq_marked_averages
    {G : Type*} [Fintype G] [dG : DecidableEq G]
    (P : G → Finset ℕ) {J ell : ℕ} (C : G → Finset (Fin J))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (V : G → ℝ) (q : ℝ) (aux : PhysicalAuxLabels P C)
    {w z : ℕ} (hw : 0 < w) (hz : 0 < z)
    (b : GroupMarkedLists P (fun g => ell + (C g).card) →
      GroupMarkedLists P (fun g => ell + (C g).card) → ℂ) :
    (∑ L : PhysicalMarkLists P J ell, ∑ R : PhysicalMarkLists P J ell,
      if physicalSharedCompatible C L R then
        ((physicalStateMass V J ell * physicalCompletionMass V C ell /
          (physicalSharedFactor C L : ℝ) : ℝ) : ℂ) *
        (if ∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z then
          ((physicalVertexWeight L q ((physicalSharedFactor C L : ℤ) * (w : ℤ)) *
            physicalVertexWeight R q ((physicalSharedFactor C L : ℤ) * (z : ℤ)) : ℝ) : ℂ) *
          b (physicalGroupUnsharedEmbedding C L) (physicalGroupUnsharedEmbedding C R)
        else 0)
      else 0) =
      (markedDivisorWeight univ P q V (fun g => ell + (C g).card) (w : ℤ) : ℂ) *
      (markedDivisorWeight univ P q V (fun g => ell + (C g).card) (z : ℤ) : ℂ) *
      groupMarkedAverage P (fun g => ell + (C g).card) (w : ℤ) (fun u =>
        groupMarkedAverage P (fun g => ell + (C g).card) (z : ℤ) (fun v =>
          ∑ s : PhysicalAuxLabels P (fun g => univ \ C g),
            if physicalRawCutGood C u v s then
              if ∀ g j, s g j ∉ physicalSharedForbidden C aux g w z
                then (physicalAuxMass V (fun g => univ \ C g) s : ℂ) * b u v else 0
            else 0)) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  calc
    _ = ∑ L : PhysicalMarkLists P J ell, ∑ R : PhysicalMarkLists P J ell,
        if physicalSharedCompatible C L R then
          ((physicalStateMass V J ell * physicalCompletionMass V C ell /
            (physicalSharedFactor C L : ℝ) : ℝ) : ℂ) *
          ((physicalUnsharedVertex C L q (w : ℤ) : ℂ) *
            (physicalUnsharedVertex C R q (z : ℤ) : ℂ) *
            (if ∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z then
              b (physicalGroupUnsharedEmbedding C L) (physicalGroupUnsharedEmbedding C R) else 0))
        else 0 := by
      apply sum_congr rfl
      intro L _
      apply sum_congr rfl
      intro R _
      by_cases hLR : physicalSharedCompatible C L R
      · simp only [if_pos hLR]
        by_cases ha : ∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z
        · simp only [if_pos ha]
          rw [physical_shared_vertex_pair_of_draw_avoids C L R aux hLR hprime hdis q hw hz ha,
            Complex.ofReal_mul]
        · simp only [if_neg ha, mul_zero]
      · simp only [if_neg hLR]
    _ = _ := by
      have he := physical_stripped_pair_sum_eq_marked_averages P C V q (w : ℤ) (z : ℤ)
        (fun u v s => if ∀ g j, s g j ∉ physicalSharedForbidden C aux g w z then b u v else 0)
      refine he.trans ?_
      apply congrArg (fun x : ℂ =>
        (markedDivisorWeight univ P q V (fun g => ell + (C g).card) (w : ℤ) : ℂ) *
        (markedDivisorWeight univ P q V (fun g => ell + (C g).card) (z : ℤ) : ℂ) * x)
      apply congrArg (groupMarkedAverage P (fun g => ell + (C g).card) (w : ℤ))
      funext u
      apply congrArg (groupMarkedAverage P (fun g => ell + (C g).card) (z : ℤ))
      funext v
      apply sum_congr rfl
      intro s _
      by_cases hc : physicalRawCutGood C u v s
      · simp only [if_pos hc, mul_ite, mul_zero]
      · simp only [if_neg hc]

end Bounty
end

section

/- The actual common forest action is the Fourier integral of chronological
signed rows, with the common initial-birth multiplier kept outside the rows. -/

open Finset Classical MeasureTheory
namespace Bounty

section Fourier
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
  [∀ g, Fintype (P g)] [∀ g, DecidableEq (P g)]
  (n : (g : Fin N) → P g → ℕ) [∀ g p, NeZero (n g p)]
  {M : Fin N → ℕ} (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
  (Δ D : ∀ k c, A k c → Fin N → ℤ)
  (edgePhase : ∀ k, ((g : Fin N) → Finset (P g)) →
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) →
    FullActiveEdgeEvent n (S k) B (A k) (Δ k) (D k) s → ℂ)
  (ω : ∀ k c, A k c → ℝ) (μ : (g : Fin N) → P g → ℝ)
  (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ) (steps : List (Option (J ⊕ K)))
  (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))
  (encode : ((g : Fin N) × P g) → ℤ)
  (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
  (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)

omit [∀ g, DecidableEq (P g)] in
theorem full_mixed_common_rows_eq_weighted_paths
    (θ : (Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) ×
      Fin (Fintype.card (FullMixedCommonBirthAddress M B steps))) → ℝ) :
    let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
    let _ := finiteEventPathFintype (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x
    finiteOperatorListAction
      (fullMixedCommonStageRow n S B A Δ D steps
        (fullMixedBirthResidualPhase n S B A Δ D edgePhase) code θ encode ω μ q ρ V)
      (List.finRange steps.length) f x =
      ∑ p : FullPermutationMixedPath n S B A Δ D steps x,
        f (finiteEventPathTerminal (FullPermutationMixedEvent n S B A Δ D)
          (fullPermutationMixedEventTarget n S B A Δ D) steps x p) *
        fullMixedCommonResidualWeight n S B A Δ D edgePhase ω μ q ρ V steps x p *
        ∏ i : Fin steps.length,
          fullMixedCommonOperationMultiplier n S B A Δ D steps code θ encode x p (some i) := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
    fullPermutationMixedEventFintype n S B A Δ D
  let _ := finiteEventPathFintype (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) steps x
  dsimp only
  have heq := congrFun (finite_occurrence_phased_rows_eq_paths
    (FullPermutationMixedEvent n S B A Δ D) (fullPermutationMixedEventTarget n S B A Δ D)
    (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V) steps
    (fullMixedCommonStagePhase n S B A Δ D steps
      (fullMixedBirthResidualPhase n S B A Δ D edgePhase) code θ encode) f) x
  change finiteOperatorListAction
    (fullMixedCommonStageRow n S B A Δ D steps
      (fullMixedBirthResidualPhase n S B A Δ D edgePhase) code θ encode ω μ q ρ V)
    (List.finRange steps.length) f x = _ at heq
  rw [heq]
  unfold finiteEventPathAction
  apply sum_congr rfl
  intro p _
  dsimp only
  rw [full_mixed_common_stage_phase_product]
  unfold fullMixedCommonResidualWeight
  ring

omit [∀ g, DecidableEq (P g)] in
theorem full_mixed_common_initial_rows_eq_weighted_paths
    (θ : (Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) ×
      Fin (Fintype.card (FullMixedCommonBirthAddress M B steps))) → ℝ) :
    let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
    let _ := finiteEventPathFintype (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x
    commonForestObservedMultiplier M B steps code θ encode
      (commonForestInitialLabels M B steps (fullMixedCommonInitialPrime x)) none *
      finiteOperatorListAction
        (fullMixedCommonStageRow n S B A Δ D steps
          (fullMixedBirthResidualPhase n S B A Δ D edgePhase) code θ encode ω μ q ρ V)
        (List.finRange steps.length) f x =
      ∑ p : FullPermutationMixedPath n S B A Δ D steps x,
        f (finiteEventPathTerminal (FullPermutationMixedEvent n S B A Δ D)
          (fullPermutationMixedEventTarget n S B A Δ D) steps x p) *
        fullMixedCommonResidualWeight n S B A Δ D edgePhase ω μ q ρ V steps x p *
        ∏ o : Option (Fin steps.length),
          fullMixedCommonOperationMultiplier n S B A Δ D steps code θ encode x p o := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
    fullPermutationMixedEventFintype n S B A Δ D
  let _ := finiteEventPathFintype (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) steps x
  dsimp only
  rw [full_mixed_common_rows_eq_weighted_paths, mul_sum]
  apply sum_congr rfl
  intro p _
  rw [Fintype.prod_option, full_mixed_common_operation_multiplier_initial]
  ring

omit [∀ g, DecidableEq (P g)] in
theorem full_mixed_common_forest_action_eq_fourier_rows
    (hinj : Function.Injective encode) :
    fullMixedCommonForestAction n S B A Δ D edgePhase ω μ q ρ V steps code f x =
      ∫ θ, commonForestObservedMultiplier M B steps code θ encode
          (commonForestInitialLabels M B steps (fullMixedCommonInitialPrime x)) none *
        finiteOperatorListAction
          (fullMixedCommonStageRow n S B A Δ D steps
            (fullMixedBirthResidualPhase n S B A Δ D edgePhase) code θ encode ω μ q ρ V)
          (List.finRange steps.length) f x
        ∂birthFourierCubeMeasure (Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) ×
          Fin (Fintype.card (FullMixedCommonBirthAddress M B steps))) := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
    fullPermutationMixedEventFintype n S B A Δ D
  let _ := finiteEventPathFintype (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) steps x
  rw [full_mixed_common_forest_action_eq n S B A Δ D edgePhase ω μ q ρ V steps encode hinj]
  rw [← birthForestPathSum_fourier_integral]
  apply integral_congr_ae
  filter_upwards [] with θ
  rw [full_mixed_common_initial_rows_eq_weighted_paths]
  apply sum_congr rfl
  intro p _
  rw [full_mixed_common_operation_multiplier_product]
  split_ifs <;> simp

end Fourier
end Bounty
end

section

/- Pointwise norm comparison for the actual compatible endpoint-pair sum. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_pair_sum_norm_le_from_bound {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {J ell : ℕ} (C : G → Finset (Fin J))
    (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (F : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → ℂ)
    (B : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → ℝ)
    (hB : ∀ L R, physicalSharedCompatible C L R → ‖F L R‖ ≤ B L R) :
    ‖∑ L : PhysicalMarkLists P J ell, ∑ R : PhysicalMarkLists P J ell,
      if physicalSharedCompatible C L R then
        ((physicalStateMass V J ell * physicalCompletionMass V C ell /
          (physicalSharedFactor C L : ℝ) : ℝ) : ℂ) * F L R else 0‖ ≤
    ‖∑ L : PhysicalMarkLists P J ell, ∑ R : PhysicalMarkLists P J ell,
      if physicalSharedCompatible C L R then
        ((physicalStateMass V J ell * physicalCompletionMass V C ell /
          (physicalSharedFactor C L : ℝ) : ℝ) : ℂ) * (B L R : ℂ) else 0‖ := by
  rw [physical_compatible_pair_sum_eq_cut_sum, physical_compatible_pair_sum_eq_cut_sum]
  apply finite_weighted_norm_le_majorant_norm
  · intro d
    exact div_nonneg
      (mul_nonneg (physical_state_mass_pos V hV J ell).le (physical_completion_mass_pos V C ell hV).le)
      (Nat.cast_nonneg _)
  · intro d
    apply hB
    rw [physical_cut_shared_compatible_iff, physical_cut_glue_shared, physical_cut_glue_shared]

end Bounty
end

section

/- On the good shared draw, the original auxiliary exclusions are exactly
the exclusions against the unshared endpoint lists. -/

open Finset
open scoped Classical
namespace Bounty

def physicalUnsharedAuxAvoids {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (u : GroupMarkedLists P (fun g => ell + (C g).card)) : Prop :=
  ∀ g (j : C g) s, aux g j ≠ u g s

theorem physical_aux_avoids_iff_of_good_shared {G : Type*} {P : G → Finset ℕ}
    {J ell : ℕ} (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (L : PhysicalMarkLists P J ell) (w z : ℕ)
    (hgood : ∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z) :
    physicalAuxAvoids C aux L ↔
      physicalUnsharedAuxAvoids C aux (physicalGroupUnsharedEmbedding C L) := by
  rw [physical_aux_avoids_shared_unshared_iff]
  have hs : ∀ g (j : C g) (s : ↥(univ \ C g)), aux g j ≠ L g (Sum.inl s.val) := by
    intro g j s he
    apply hgood g s
    exact mem_filter.mpr ⟨mem_univ _, Or.inr ⟨j, he⟩⟩
  exact and_iff_right hs

theorem physical_list_admissible_iff_of_good_shared {G : Type*} {P : G → Finset ℕ}
    {J ell : ℕ} (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (L R : PhysicalMarkLists P J ell) (w z : ℕ)
    (hLR : physicalSharedCompatible C L R)
    (hgood : ∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z) :
    physicalListAdmissible C aux L R ↔
      physicalUnsharedAuxAvoids C aux (physicalGroupUnsharedEmbedding C L) ∧
        physicalUnsharedAuxAvoids C aux (physicalGroupUnsharedEmbedding C R) := by
  have hgR : ∀ g j, physicalSharedAux C R g j ∉ physicalSharedForbidden C aux g w z := by
    rw [← physical_shared_aux_eq_of_compatible C hLR]
    exact hgood
  rw [physicalListAdmissible, and_iff_right hLR,
    physical_aux_avoids_iff_of_good_shared C aux L w z hgood,
    physical_aux_avoids_iff_of_good_shared C aux R w z hgR]

end Bounty
end

section

/- Exact full-pair summation at a single shared quotient position. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_scaled_root_sum_full_pair
    {G : Type*} [Fintype G] [dG : DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (V : G → ℝ) (C : G → Finset (Fin J)) (q a b : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (positions : Finset ℤ) (w : ℤ)
    (f g : ℤ → ℂ) (Ψ : ℝ → ℂ) (Z : ℝ)
    (hf : ∀ (L : PhysicalMarkLists P J ell) w,
      f ((physicalSharedFactor C L : ℤ) * w) = f w)
    (hg : ∀ (L : PhysicalMarkLists P J ell) w,
      g ((physicalSharedFactor C L : ℤ) * w) = g w) :
    (physicalStateMass V J ell : ℂ) *
      (∑ L : PhysicalMarkLists P J ell, ∑ R : PhysicalMarkLists P J ell,
        if (physicalSharedFactor C L : ℤ) * w ∈ positions ∧
            (physicalSharedFactor C L : ℤ) *
              (w + k * (physicalFreeFactor C aux : ℕ)) ∈ positions then
          physicalRootPositionTerm V C q (-(a+b)) k K aux
            (fun n => physicalPhase (-a) n.natAbs * f n)
            (fun n => physicalPhase b n.natAbs * g n) Ψ Z L R
            ((physicalSharedFactor C L : ℤ) * w)
        else 0) =
    (physicalAuxMass V C aux : ℂ) *
      (Ψ ((w : ℝ) / (Z * physicalFreeFactor C aux)) * (w : ℂ)⁻¹ *
        (starRingEnd ℂ) (f w) * g (w + k * (physicalFreeFactor C aux : ℕ))) *
      physicalFullPairCorrelation P C V q w.natAbs
        (w + k * (physicalFreeFactor C aux : ℕ)).natAbs (fun L R =>
          if (physicalSharedFactor C L : ℤ) * w ∈ positions ∧
              (physicalSharedFactor C L : ℤ) *
                (w + k * (physicalFreeFactor C aux : ℕ)) ∈ positions then
            physicalPhasedPairCoefficient C K aux a b w.natAbs
              (w + k * (physicalFreeFactor C aux : ℕ)).natAbs L R
          else 0) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  unfold physicalFullPairCorrelation
  simp only [mul_sum]
  apply sum_congr rfl
  intro L _
  apply sum_congr rfl
  intro R _
  by_cases hguard : (physicalSharedFactor C L : ℤ) * w ∈ positions ∧
      (physicalSharedFactor C L : ℤ) *
        (w + k * (physicalFreeFactor C aux : ℕ)) ∈ positions
  · rw [if_pos hguard, physical_phased_root_term_scaled hprime V C q a b k K aux f g Ψ Z
      L R w (hf L w) (hg L _)]
    by_cases hshared : physicalSharedCompatible C L R
    · rw [if_pos hshared, if_pos hguard]
      push_cast
      ring
    · have hc : physicalPhasedPairCoefficient C K aux a b w.natAbs
          (w + k * (physicalFreeFactor C aux : ℕ)).natAbs L R = 0 := by
        apply if_neg
        exact fun h => hshared h.1
      rw [if_neg hshared, hc]
      simp only [mul_zero]
  · rw [if_neg hguard]
    by_cases hshared : physicalSharedCompatible C L R
    · rw [if_pos hshared, if_neg hguard]
      simp only [mul_zero]
    · rw [if_neg hshared]
      simp only [mul_zero]

end Bounty
end

section

/- Polynomial envelopes for the actual finite comparison patterns. -/

open Finset Real
open scoped Classical
namespace Bounty

theorem harmonic_pattern_bound_power {G : Type*} [DecidableEq G]
    {J ell : ℕ} (probes : G → Finset (Fin J)) (r t : Finset G)
    {L q x ξ : ℝ} (hL : 1 ≤ L) (hq : 0 ≤ q) (hx : 0 ≤ x)
    (Q : ℕ) (hQ : (Q : ℝ) ≤ L^q) (hξ : L^(-x) ≤ ξ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t) :
    repeatedBigPrimePatternBound probes r t Q ξ i ≤ L^(4*q+2*x) := by
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL
  have hξ0 : 0 < ξ := (rpow_pos_of_pos hL0 (-x)).trans_le hξ
  have hQQ : ((Q*Q : ℕ) : ℝ) ≤ L^(2*q) := by
    rw [Nat.cast_mul]
    calc
      _ ≤ L^q*L^q := mul_self_le_mul_self (Nat.cast_nonneg _) hQ
      _ = _ := by rw [← rpow_add hL0]; congr 1; ring
  have hf : ((Q*Q : ℕ) : ℝ)/ξ ≤ L^(2*q+x) := by
    apply (div_le_iff₀ hξ0).mpr
    calc
      _ ≤ L^(2*q) := hQQ
      _ = L^(2*q+x)*L^(-x) := by rw [← rpow_add hL0]; congr 1; ring
      _ ≤ L^(2*q+x)*ξ := mul_le_mul_of_nonneg_left hξ (rpow_nonneg hL0.le _)
  cases i with
  | inl u => exact one_le_rpow hL (by positivity)
  | inr ab =>
      change (((Q*Q : ℕ) : ℝ)/ξ)^2 ≤ _
      calc
        _ ≤ (L^(2*q+x))^2 := by
          simpa only [pow_two] using mul_self_le_mul_self
            (div_nonneg (Nat.cast_nonneg _) hξ0.le) hf
        _ = _ := by rw [pow_two, ← rpow_add hL0]; congr 1; ring

theorem harmonic_pattern_card_power {G : Type*} [Fintype G] [DecidableEq G]
    {J ell : ℕ} (probes : G → Finset (Fin J)) (r t : Finset G) (hrt : Disjoint r t)
    {L A : ℝ} (hL : 2 ≤ L) (hA : 0 ≤ A)
    (hslots : ((J*Fintype.card G : ℕ) : ℝ) ≤ A*log L) :
    (Fintype.card (RepeatedBigPrimePatternIndex (ell := ell) probes r t) : ℝ) ≤
      L^(A*log 2+1) := by
  have hL0 : 0 < L := by linarith
  have hL1 : 1 ≤ L := by linarith
  have hc : Fintype.card (RepeatedBigPrimePatternIndex (ell := ell) probes r t) ≤
      1+2^(J*Fintype.card G) := by
    simpa only [RepeatedBigPrimePatternIndex, Fintype.card_sum, Fintype.card_unit, Fintype.card_fin] using
      Nat.add_le_add_left (repeated_big_prime_pattern_pair_card_le_groups (ell := ell)
        probes r t hrt (fun _ => card_le_univ _)) 1
  have hp : (2 : ℝ)^(J*Fintype.card G) ≤ L^(A*log 2) := by
    calc
      _ = exp (log 2*((J*Fintype.card G : ℕ) : ℝ)) := by
        rw [← rpow_natCast, rpow_def_of_pos (by norm_num : (0 : ℝ) < 2)]
      _ ≤ exp (log 2*(A*log L)) := exp_le_exp.mpr
        (mul_le_mul_of_nonneg_left hslots (log_nonneg (by norm_num)))
      _ = _ := by rw [rpow_def_of_pos hL0]; congr 1; ring
  have hone : 1 ≤ L^(A*log 2) := one_le_rpow hL1 (mul_nonneg hA (log_nonneg (by norm_num)))
  calc
    _ ≤ (1 : ℝ)+2^(J*Fintype.card G) := by exact_mod_cast hc
    _ ≤ 1+L^(A*log 2) := add_le_add le_rfl hp
    _ ≤ L^(A*log 2)+L^(A*log 2) := add_le_add hone le_rfl
    _ = 2*L^(A*log 2) := by ring
    _ ≤ L*L^(A*log 2) := mul_le_mul_of_nonneg_right hL (rpow_nonneg hL0.le _)
    _ = L^(A*log 2+1) := by
      nth_rw 1 [← rpow_one L]
      rw [← rpow_add hL0]
      congr 1
      ring

end Bounty
end

section

/- In each cell/character term, the two weighted selected endpoint averages
are independent of the auxiliary prime draws. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_prime_cell_average
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (Q : ℕ) (h : ℝ) (keptA keptB : Finset ℤ)
    (S : Finset G) (hA : ∀ i ∈ A, i.1 ∈ S) (hB : ∀ i ∈ B, i.1 ∈ S)
    (q : ℝ) (w z : ℤ) (aux : PhysicalAuxLabels P (repeatedBigAuxCut A B)) :
    let PA := fun i : A => P i.val.1
    let PB := fun i : B => P i.val.1
    let VA := fun i : A => V i.val.1
    let VB := fun i : B => V i.val.1
    let a := fun d => ((1 / finiteCellMass (finiteProductWeight (physicalLabelLaw (P := PA) VA))
      (fun x => upperLogCell h (Real.log (∏ i, (x i).val : ℕ))) d : ℝ) : ℂ)
    let b := fun e => ((1 / finiteCellMass (finiteProductWeight (physicalLabelLaw (P := PB) VB))
      (fun x => upperLogCell h (Real.log (∏ i, (x i).val : ℕ))) e : ℝ) : ℂ)
    let marks := fun g => ell + (repeatedBigAuxCut A B g).card
    let W := fun n => markedDivisorWeight univ P q V marks n
    let split := repeatedBigAuxSplitEquiv P A B hU hAB aux
    ((W w*W z : ℝ) : ℂ) * groupMarkedAverage P marks w (fun u =>
      groupMarkedAverage P marks z (fun v =>
        physicalUnsharedPrimeCoefficient P V A B hU hAB Q h keptA keptB u v aux)) =
      ∑ d ∈ keptA, ∑ χ : BoundedPrimitiveCharacter Q,
        ∑ e ∈ keptB, ∑ ψ : BoundedPrimitiveCharacter Q,
          ((a d*b e) *
            ((starRingEnd ℂ) (primeProductCellCharacter PA h d χ split.1) *
              (starRingEnd ℂ) (primeProductCellCharacter PB h e ψ split.2))) *
            (((W w : ℂ) * groupMarkedAverage (fun g : S => P g.val)
                (fun g : S => marks g.val) w
                (fun u => primeProductCellCharacter PB h e ψ
                  (physicalSelectedPrimeRestriction A B B subset_union_right S hB u))) *
              ((W z : ℂ) * groupMarkedAverage (fun g : S => P g.val)
                (fun g : S => marks g.val) z
                (fun v => primeProductCellCharacter PA h d χ
                  (physicalSelectedPrimeRestriction A B A subset_union_left S hA v)))) := by
  dsimp only
  simp_rw [physical_prime_cell_expansion P V A B hU hAB Q h keptA keptB S hA hB]
  simp_rw [group_marked_average_sum]
  simp only [mul_sum]
  apply sum_congr rfl
  intro d _
  apply sum_congr rfl
  intro χ _
  apply sum_congr rfl
  intro e _
  apply sum_congr rfl
  intro ψ _
  have he := weighted_marked_pair_finite_expansion P q V
    (fun g => ell + (repeatedBigAuxCut A B g).card) w z S (univ : Finset Unit)
    (fun _ =>
      (((1 / finiteCellMass (finiteProductWeight (physicalLabelLaw (P := fun i : A => P i.val.1)
          (fun i => V i.val.1)))
        (fun x => upperLogCell h (Real.log (∏ i, (x i).val : ℕ))) d : ℝ) : ℂ) *
       ((1 / finiteCellMass (finiteProductWeight (physicalLabelLaw (P := fun i : B => P i.val.1)
          (fun i => V i.val.1)))
        (fun x => upperLogCell h (Real.log (∏ i, (x i).val : ℕ))) e : ℝ) : ℂ)) *
      ((starRingEnd ℂ) (primeProductCellCharacter (fun i : A => P i.val.1) h d χ
          (repeatedBigAuxSplitEquiv P A B hU hAB aux).1) *
        (starRingEnd ℂ) (primeProductCellCharacter (fun i : B => P i.val.1) h e ψ
          (repeatedBigAuxSplitEquiv P A B hU hAB aux).2)))
    (fun _ u => primeProductCellCharacter (fun i : B => P i.val.1) h e ψ
      (physicalSelectedPrimeRestriction A B B subset_union_right S hB u))
    (fun _ v => primeProductCellCharacter (fun i : A => P i.val.1) h d χ
      (physicalSelectedPrimeRestriction A B A subset_union_left S hA v))
  dsimp only at he
  simpa only [univ_unique, sum_singleton] using he

end Bounty
end

