open Finset Classical
noncomputable def unrestrictedEdgeEnergyBound (ρ v vmin vmax : ℝ) (T : ℕ) : ℝ :=
  unrestrictedEdgeRowBound ρ v vmin T ^ 2 * unrestrictedEdgeReversalBound vmin vmax T

theorem unrestrictedEdgeEnergyBound_nonneg (ρ v vmin vmax : ℝ) (T : ℕ) :
    0 ≤ unrestrictedEdgeEnergyBound ρ v vmin vmax T := by
  unfold unrestrictedEdgeEnergyBound unrestrictedEdgeReversalBound
  positivity

noncomputable def unrestrictedProjectedOperator {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (Δ D : ℤ) (μ : P → ℝ) (ρ V : ℝ)
    (t B : ℕ) (phase : UnrestrictedBoundedPhase n Δ D t B)
    (f : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ) :=
  unrestrictedBoundedOperator n Δ D μ ρ V t B phase (boundedMemorySymmetrize f)

theorem unrestrictedProjectedOperator_eq_of_symmetric {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (Δ D : ℤ) (μ : P → ℝ) (ρ V : ℝ)
    (t B : ℕ) (phase : UnrestrictedBoundedPhase n Δ D t B)
    (f : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
    (hf : BoundedOrderedSymmetric f) :
    unrestrictedProjectedOperator n Δ D μ ρ V t B phase f =
      unrestrictedBoundedOperator n Δ D μ ρ V t B phase f := by
  unfold unrestrictedProjectedOperator
  rw [boundedMemorySymmetrize_eq_self f hf]

theorem unrestricted_projected_operator_energy_le {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (Δ D : ℤ) (μ : P → ℝ)
    {ρ V v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : vmin ≤ V) (hVhi : V ≤ vmax)
    (hμ : ∀ p, 0 ≤ μ p) (hmass : ∑ p, μ p ≤ 2)
    (t B T : ℕ) (ht : t ≤ T)
    (phase : UnrestrictedBoundedPhase n Δ D t B)
    (hphase : ∀ s stores promotions e fresh, ‖phase s stores promotions e fresh‖ ≤ 1)
    (f : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ) :
    finiteWeightedEnergy (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ))
      (unrestrictedProjectedOperator n Δ D μ ρ V t B phase f) ≤
    unrestrictedEdgeEnergyBound ρ v vmin vmax T *
      finiteWeightedEnergy (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ)) f := by
  apply boundedMemorySymmetrize_transfer_energy_le μ (unrestrictedResidueWeight μ)
    hμ (fun z => hμ z.1) (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T)
    (unrestrictedBoundedOperator n Δ D μ ρ V t B phase)
  intro g hg
  exact unrestricted_bounded_operator_energy_le n Δ D μ hρ0 hρ1 hv hvmin hVlo hVhi
    hμ hmass t B T ht phase hphase g hg
end

section
open Finset
noncomputable def candidateSmallPSet (s L X : ℝ) : Finset ℕ := by
  classical
  exact (Iio ⌈X⌉₊).filter (fun n => n ∈
    Nat.factoredNumbers ((candidatePIndices s L).biUnion (candidatePBand (s * L))))

theorem mem_candidateSmallPSet_iff (s L X : ℝ) (n : ℕ) :
    n ∈ candidateSmallPSet s L X ↔ (n : ℝ) < X ∧
      n ∈ Nat.factoredNumbers ((candidatePIndices s L).biUnion (candidatePBand (s * L))) := by
  classical
  simp only [candidateSmallPSet, mem_filter, mem_Iio, Nat.lt_ceil]

theorem candidate_small_P_set_nonzero {s L X : ℝ} {n : ℕ}
    (hn : n ∈ candidateSmallPSet s L X) : n ≠ 0 :=
  Nat.ne_zero_of_mem_factoredNumbers ((mem_candidateSmallPSet_iff s L X n).mp hn).2

theorem candidate_small_P_set_log_bound {s L κ : ℝ} {n : ℕ}
    (hn : n ∈ candidateSmallPSet s L (Real.exp (κ * L))) : Real.log n < κ * L := by
  have hn0 : (0 : ℝ) < n := by exact_mod_cast Nat.pos_of_ne_zero (candidate_small_P_set_nonzero hn)
  exact (Real.log_lt_iff_lt_exp hn0).mpr ((mem_candidateSmallPSet_iff s L _ n).mp hn).1

theorem candidate_small_P_mass_eq_finite_sum (s L q X : ℝ) :
    candidateSmallPHarmonicMass s L q X =
      ∑ n ∈ candidateSmallPSet s L X, candidatePHarmonicTerm s L q n := by
  classical
  let P := (candidatePIndices s L).biUnion (candidatePBand (s * L))
  let S := candidateSmallPSet s L X
  let T : Finset (Nat.factoredNumbers P) := S.subtype (fun n => n ∈ Nat.factoredNumbers P)
  have hcut : ∀ n ∈ T, (n.val : ℝ) < X := by
    intro n hn
    exact ((mem_candidateSmallPSet_iff s L X n.val).mp (mem_subtype.mp hn)).1
  change (∑' n : Nat.factoredNumbers P, if (n.val : ℝ) < X then candidatePHarmonicTerm s L q n.val else 0) = _
  calc
    _ = ∑ n ∈ T, if (n.val : ℝ) < X then candidatePHarmonicTerm s L q n.val else 0 := by
      apply tsum_eq_sum
      intro n hn
      have hnot : ¬(n.val : ℝ) < X := by
        intro h
        apply hn
        exact mem_subtype.mpr ((mem_candidateSmallPSet_iff s L X n.val).mpr ⟨h, n.property⟩)
      simp only [if_neg hnot]
    _ = ∑ n ∈ T, candidatePHarmonicTerm s L q n.val :=
      sum_congr rfl (fun n hn => if_pos (hcut n hn))
    _ = ∑ n ∈ S, candidatePHarmonicTerm s L q n := by
      apply sum_subtype_of_mem
      intro n hn
      exact ((mem_candidateSmallPSet_iff s L X n).mp hn).2
end

section
open Finset
noncomputable def arithmeticProductWindow (p : ℕ) (X : ℝ) : Finset ℕ :=
  (Iic ⌊16 * X⌋₊).filter (fun n => X < (p * n : ℕ) ∧ (p * n : ℕ) ≤ 16 * X)

theorem mem_arithmeticProductWindow_iff {p n : ℕ} (hp : p ≠ 0) (X : ℝ) :
    n ∈ arithmeticProductWindow p X ↔ X < (p * n : ℕ) ∧ (p * n : ℕ) ≤ 16 * X := by
  simp only [arithmeticProductWindow, mem_filter, mem_Iic]
  constructor
  · exact And.right
  · intro h
    refine ⟨Nat.le_floor ?_, h⟩
    have hn : n ≤ p * n := Nat.le_mul_of_pos_left n (Nat.pos_of_ne_zero hp)
    exact (by exact_mod_cast hn : (n : ℝ) ≤ (p * n : ℕ)).trans h.2

theorem ordered_slot_arithmetic_window_sum {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (N : ℝ) {p : ℕ} (hp : p ≠ 0) (X : ℝ) :
    (∑ n ∈ arithmeticProductWindow p X, orderedSlotWeight choices N n) =
      ∑ x : ∀ i, choices i,
        if X < (p * orderedSlotProduct choices x : ℕ) ∧
          (p * orderedSlotProduct choices x : ℕ) ≤ 16 * X then 1 / N else 0 := by
  rw [ordered_slot_weight_window_sum]
  simp only [mem_arithmeticProductWindow_iff hp]

theorem ordered_slot_arithmetic_window_split {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (i : I) (N : ℝ) {p : ℕ} (hp : p ≠ 0) (X : ℝ) :
    (∑ n ∈ arithmeticProductWindow p X, orderedSlotWeight choices N n) =
      ∑ y : ∀ j : {j : I // j ≠ i}, choices j.val,
        ((primeProductWindow (choices i)
          ((p * orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y : ℕ) : ℝ) X).card : ℝ) / N := by
  rw [ordered_slot_arithmetic_window_sum choices N hp X]
  exact ordered_slot_window_sum_split choices i N p X
end

