/- The physical edge with every target list and auxiliary draw is one
unified full-state row. Its globally extended phase is bounded everywhere. -/

open Finset
open scoped Classical
namespace Bounty

section Physical
variable {I K : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g, ∀ p : ↥(P g), NeZero p.val]
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (retention : I → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

theorem physical_full_observed_permutation_row
    (before after : Fin N → Finset (Fin J))
    (F : PhysicalMarkObservation P ell C →
      FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ)
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B) :
    physicalFullObservedRow C k ω β retention ρ V before after none F s =
    ∑ τ : FullActiveSlotPermutations (fun _ : Fin N => J + ell),
      (fullActivePermutationWeight (fun _ : Fin N => J + ell) τ : ℂ) *
        F (.inl ((physicalTransitionPermutationEquiv before after).symm τ))
          (s.1, fullActivePermutation τ s.2) := by
  unfold physicalFullObservedRow fullMixedObservedRow
  refine Eq.trans ?_ (Equiv.sum_comp
    (Equiv.ulift : ULift.{0} (FullActiveSlotPermutations (fun _ : Fin N => J + ell)) ≃ _)
    (fun τ => (fullActivePermutationWeight (fun _ : Fin N => J + ell) τ : ℂ) *
      F (.inl ((physicalTransitionPermutationEquiv before after).symm τ))
        (s.1, fullActivePermutation τ s.2)))
  apply sum_congr
  · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
  · intro e _
    simp only [fullMixedLedgerPhase, mul_one]
    rfl

theorem physical_full_observed_ghost_row
    (before after : Fin N → Finset (Fin J)) (j : I)
    (F : PhysicalMarkObservation P ell C →
      FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ)
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B) :
    physicalFullObservedRow C k ω β retention ρ V before after (some (.inl j)) F s =
      physicalFullLedgerRow C k ω β retention ρ V (some (.inl j)) (F (.inr none)) s := by
  unfold physicalFullObservedRow fullMixedObservedRow physicalFullLedgerRow
    fullMixedLedgerRow finiteLocalPhasedRow
  apply sum_congr
  · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
  · intro e _
    rfl

end Physical
end Bounty
