theorem tilted_mass_le_of_inverse_bound {G : Type*} {P : G → Finset ℕ}
    (V : G → ℝ) (g : G) (b : P g → ℝ) (hV : 0 < V g)
    (hMass : ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    {C : ℝ} (hb : ∀ p, 1 / b p ≤ C) :
    (∑ p : P g, tiltedPhysicalBirthLaw V g b p) ≤ C := by
  calc
    _ = ∑ p : P g, physicalLabelLaw V g p * (1 / b p) := by
      apply sum_congr rfl
      intro p _
      simp only [tiltedPhysicalBirthLaw, div_eq_mul_inv, one_mul]
    _ ≤ ∑ p : P g, physicalLabelLaw V g p * C := by
      apply sum_le_sum
      intro p _
      exact mul_le_mul_of_nonneg_left (hb p)
        (div_nonneg zero_le_one (mul_nonneg hV.le (Nat.cast_nonneg p.val)))
    _ = C := by rw [← sum_mul, physical_label_law_sum V g hV hMass, one_mul]

theorem tilted_linear_mass_le {G : Type*} {P : G → Finset ℕ}
    (V : G → ℝ) (g : G) (d : P g → ℝ) (hV : 0 < V g)
    (hMass : ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    {T P₀ : ℝ} (hP₀ : 0 < P₀) (hT : 0 ≤ T) (hTP : 2 * T ≤ P₀)
    (hd0 : ∀ p, 0 ≤ d p) (hdT : ∀ p, d p ≤ T)
    (hp : ∀ p : P g, P₀ ≤ (p.val : ℝ)) :
    (∑ p : P g, tiltedPhysicalBirthLaw V g (fun p => 1 - d p / p.val) p) ≤
      1 + 2 * T / P₀ := by
  apply tilted_mass_le_of_inverse_bound V g _ hV hMass
  intro p
  have hp0 : 0 < (p.val : ℝ) := hP₀.trans_le (hp p)
  have hdp : 2 * d p ≤ (p.val : ℝ) := (by linarith [hdT p] : 2 * d p ≤ P₀).trans (hp p)
  have hb := (memory_baseline_distortion (hd0 p) hp0 hdp).2
  have hdiv : 2 * d p / (p.val : ℝ) ≤ 2 * T / P₀ := by
    calc
      _ ≤ 2 * T / (p.val : ℝ) := div_le_div_of_nonneg_right (by linarith [hdT p]) hp0.le
      _ ≤ 2 * T / P₀ := div_le_div_of_nonneg_left (by positivity) hP₀ (hp p)
  linarith

theorem finite_product_powers_le_exp {G : Type*} [Fintype G]
    (a ε : G → ℝ) (M : G → ℕ) (ha : ∀ g, 0 ≤ a g)
    (hε : ∀ g, a g ≤ 1 + ε g) :
    (∏ g, a g ^ M g) ≤ Real.exp (∑ g, ε g * M g) := by
  calc
    _ ≤ ∏ g, (Real.exp (ε g)) ^ M g := by
      apply prod_le_prod₀
      · intro g _
        exact pow_nonneg (ha g) _
      · intro g _
        exact pow_le_pow_left₀ (ha g) ((hε g).trans (by linarith [Real.add_one_le_exp (ε g)])) _
    _ = ∏ g, Real.exp (ε g * M g) := by
      apply prod_congr rfl
      intro g _
      rw [mul_comm (ε g), Real.exp_nat_mul]
    _ = _ := (Real.exp_sum _ _).symm

theorem full_vacuum_energy_le_exp {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ) (M : G → ℕ) (B : ℕ)
    (ε : G → ℝ) (hμ : ∀ g p, 0 ≤ μ g p)
    (hmass : ∀ g, ∑ p, μ g p ≤ 1 + ε g) :
    finiteWeightedEnergy (productMemoryWeight μ ν) (fullMemoryVacuum (M := M) (B := B)) ≤
      Real.exp (∑ g, ε g * M g) := by
  rw [fullMemoryVacuum_energy]
  exact finite_product_powers_le_exp (fun g => ∑ p, μ g p) ε M
    (fun g => sum_nonneg fun p _ => hμ g p) hmass

theorem tilted_linear_vacuum_energy_le_exp
    {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) {Z : G → Type*} [∀ g, Fintype (Z g)]
    (V : G → ℝ) (d : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (M : G → ℕ) (B : ℕ) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    {T P₀ : ℝ} (hP₀ : 0 < P₀) (hT : 0 ≤ T) (hTP : 2 * T ≤ P₀)
    (hd0 : ∀ g p, 0 ≤ d g p) (hdT : ∀ g p, d g p ≤ T)
    (hp : ∀ g (p : P g), P₀ ≤ (p.val : ℝ)) :
    finiteWeightedEnergy
      (productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (fun p => 1 - d g p / p.val)) ν)
      (fullMemoryVacuum (M := M) (B := B)) ≤
        Real.exp ((2 * T / P₀) * ∑ g, (M g : ℝ)) := by
  have hμ : ∀ g (p : P g), 0 ≤ tiltedPhysicalBirthLaw V g (fun p => 1 - d g p / p.val) p := by
    intro g p
    apply tiltedPhysicalBirthLaw_nonneg V g _ (hV g).le
    intro p
    have hp0 : 0 < (p.val : ℝ) := hP₀.trans_le (hp g p)
    have hdp : 2 * d g p ≤ (p.val : ℝ) :=
      (by linarith [hdT g p] : 2 * d g p ≤ P₀).trans (hp g p)
    exact (by norm_num : (0 : ℝ) ≤ 1 / 2).trans
      (memory_baseline_bounds (hd0 g p) hp0 hdp).1
  have h := full_vacuum_energy_le_exp
    (fun g => tiltedPhysicalBirthLaw V g (fun p => 1 - d g p / p.val)) ν M B
    (fun _ => 2 * T / P₀) hμ
    (fun g => tilted_linear_mass_le V g (d g) (hV g) (hMass g) hP₀ hT hTP (hd0 g) (hdT g) (hp g))
  simpa only [mul_sum] using h

theorem tilted_linear_vacuum_energy_le_exp_one
    {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) {Z : G → Type*} [∀ g, Fintype (Z g)]
    (V : G → ℝ) (d : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (M : G → ℕ) (B : ℕ) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    {T P₀ : ℝ} (hP₀ : 0 < P₀) (hT : 0 ≤ T) (hTP : 2 * T ≤ P₀)
    (hd0 : ∀ g p, 0 ≤ d g p) (hdT : ∀ g p, d g p ≤ T)
    (hp : ∀ g (p : P g), P₀ ≤ (p.val : ℝ))
    (hsmall : (2 * T / P₀) * ∑ g, (M g : ℝ) ≤ 1) :
    finiteWeightedEnergy
      (productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (fun p => 1 - d g p / p.val)) ν)
      (fullMemoryVacuum (M := M) (B := B)) ≤ Real.exp 1 :=
  (tilted_linear_vacuum_energy_le_exp P V d ν M B hV hMass hP₀ hT hTP hd0 hdT hp).trans
    (Real.exp_le_exp.mpr hsmall)
end

section
open Finset Classical
def fullDoubledGhostV {J K G : Type*} (V : G → ℝ) : Option (J ⊕ K) → G → ℝ
  | some (Sum.inl _), g => 2 * V g
  | _, g => V g

section

variable {J K G : Type*} {P : G → Type*}
  (n : ∀ g, P g → ℕ) {M : G → ℕ}
  (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → G → ℤ)

noncomputable def fullDoubledGhostEventWeight [Fintype G] [DecidableEq G]
    (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)
    (k : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    FullPermutationMixedEvent n S B A Δ D k s → ℝ :=
  fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ (fullDoubledGhostV V k) k s

noncomputable def fullDoubledGhostPositiveOperator [Fintype G] [DecidableEq G]
    [∀ g, Fintype (P g)] [∀ g p, NeZero (n g p)] [∀ k c, Fintype (A k c)]
    (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)
    (k : Option (J ⊕ K)) :=
  fullPermutationMixedPositiveOperator n S B A Δ D ω μ q ρ (fullDoubledGhostV V k) k

theorem full_doubled_ghost_absolute_actions_eq [Fintype G] [DecidableEq G]
    [∀ g, Fintype (P g)] [∀ g p, NeZero (n g p)] [∀ k c, Fintype (A k c)]
    (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)
    (hω : ∀ k c a, 0 ≤ ω k c a)
    (hμ : ∀ g p, 0 ≤ μ g p) (hq : ∀ j, 0 ≤ q j) (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ V g) :
    let _ : ∀ (k : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D k s) :=
      fullPermutationMixedEventFintype n S B A Δ D
    finiteLocalEventAction (FullPermutationMixedEvent n S B A Δ D)
      (fun k s e => |fullDoubledGhostEventWeight n S B A Δ D ω μ q ρ V k s e|)
      (fullPermutationMixedEventTarget n S B A Δ D) =
        fullDoubledGhostPositiveOperator n S B A Δ D ω μ q ρ V := by
  let _ : ∀ (k : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D k s) :=
    fullPermutationMixedEventFintype n S B A Δ D
  funext k f s
  have hVk : ∀ g, 0 ≤ fullDoubledGhostV V k g := by
    intro g
    cases k with
    | none => exact hV g
    | some k =>
      cases k with
      | inl j => exact mul_nonneg (by norm_num) (hV g)
      | inr k => exact hV g
  exact congrFun (congrFun (congrFun
    (full_permutation_mixed_absolute_actions_eq n S B A Δ D ω μ q ρ
      (fullDoubledGhostV V k) hω hμ hq hρ hVk) k) f) s

theorem full_doubled_ghost_positive_symmetric [Fintype G] [DecidableEq G]
    [∀ g, Fintype (P g)] [∀ g p, NeZero (n g p)] [∀ k c, Fintype (A k c)]
    (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)
    (k : Option (J ⊕ K))
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric (fullDoubledGhostPositiveOperator n S B A Δ D ω μ q ρ V k f) :=
  full_permutation_mixed_positive_symmetric n S B A Δ D ω μ q ρ (fullDoubledGhostV V k) k f hf

end
end

section
open Finset Classical
noncomputable def countTailPhase (a : ℝ) (r c : ℕ) (z : ℂ) : ℂ :=
  if r ≤ c then ((a ^ r / a ^ c : ℝ) : ℂ) * z else 0

theorem countTailPhase_norm_le_one {a : ℝ} (ha : 1 ≤ a)
    (r c : ℕ) {z : ℂ} (hz : ‖z‖ ≤ 1) : ‖countTailPhase a r c z‖ ≤ 1 := by
  have ha0 : 0 < a := zero_lt_one.trans_le ha
  by_cases hrc : r ≤ c
  · simp only [countTailPhase, if_pos hrc, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (div_nonneg (pow_nonneg ha0.le _) (pow_nonneg ha0.le _))]
    calc
      _ ≤ (a ^ r / a ^ c) * 1 := mul_le_mul_of_nonneg_left hz (by positivity)
      _ ≤ 1 := by
        rw [mul_one]
        exact (div_le_one (pow_pos ha0 _)).mpr (pow_le_pow_right₀ ha hrc)
  · simp [countTailPhase, hrc]

theorem count_tail_weight_identity {a : ℝ} (ha : 0 < a)
    (r c : ℕ) (w : ℝ) (z : ℂ) :
    (w : ℂ) * (if r ≤ c then z else 0) =
      (((a ^ r)⁻¹ : ℝ) : ℂ) * ((a ^ c * w : ℝ) : ℂ) * countTailPhase a r c z := by
  by_cases hrc : r ≤ c
  · have har : ((a ^ r : ℝ) : ℂ) ≠ 0 := by exact_mod_cast (pow_ne_zero r (ne_of_gt ha))
    have hac : ((a ^ c : ℝ) : ℂ) ≠ 0 := by exact_mod_cast (pow_ne_zero c (ne_of_gt ha))
    simp only [countTailPhase, if_pos hrc, Complex.ofReal_inv, Complex.ofReal_mul, Complex.ofReal_div]
    field_simp
  · simp [countTailPhase, hrc]

theorem finite_event_path_counted_tail_eq {K X : Type*}
    (E : K → X → Type*) [∀ k x, Fintype (E k x)]
    (target : ∀ k x, E k x → X) (w w' : ∀ k x, E k x → ℝ)
    (steps : List K) (count : ∀ x, FiniteEventPath E target steps x → ℕ)
    {a : ℝ} (ha : 0 < a)
    (hw : ∀ x p, finiteEventPathWeight E target w' steps x p =
      a ^ count x p * finiteEventPathWeight E target w steps x p)
    (r : ℕ) (phase : ∀ x, FiniteEventPath E target steps x → ℂ)
    (f : X → ℂ) (x : X) :
    finiteEventPathAction E target w steps
        (fun x p => if r ≤ count x p then phase x p else 0) f x =
      (((a ^ r)⁻¹ : ℝ) : ℂ) * finiteEventPathAction E target w' steps
        (fun x p => countTailPhase a r (count x p) (phase x p)) f x := by
  simp only [finiteEventPathAction, mul_sum]
  apply sum_congr rfl
  intro p _
  rw [hw]
  have h := count_tail_weight_identity ha r (count x p)
    (finiteEventPathWeight E target w steps x p) (phase x p)
  simpa only [mul_assoc] using congrArg (fun z => z * f (finiteEventPathTerminal E target steps x p)) h

theorem finiteWeightedEnergy_const_mul {X : Type*} [Fintype X]
    (μ : X → ℝ) (c : ℂ) (f : X → ℂ) :
    finiteWeightedEnergy μ (fun x => c * f x) = ‖c‖ ^ 2 * finiteWeightedEnergy μ f := by
  simp only [finiteWeightedEnergy, norm_mul, mul_pow, mul_sum]
  apply sum_congr rfl
  intro x _
  ring
end

section
open scoped BigOperators Classical
theorem prime_ideal_kernel_factor_two {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ) (Q : ℕ)
    (hp : ∀ i p, p ∈ P i → 0 < p) {h : ℝ} (hh : 0 < h) (hh2 : h ≤ Real.log 2)
    (kept : Finset ℤ) (d x : ∀ i, P i)
    (hne : primeProductIdealKernel P V Q h kept d x ≠ 0) :
    ((∏ i, (x i).val : ℕ) : ℝ) / 2 ≤ ((∏ i, (d i).val : ℕ) : ℝ) ∧
      ((∏ i, (d i).val : ℕ) : ℝ) ≤ 2 * ((∏ i, (x i).val : ℕ) : ℝ) := by
  have hd : (0 : ℝ) < (∏ i, (d i).val : ℕ) := by
    exact_mod_cast Finset.prod_pos (fun i _ => hp i (d i).val (d i).property)
  have hx : (0 : ℝ) < (∏ i, (x i).val : ℕ) := by
    exact_mod_cast Finset.prod_pos (fun i _ => hp i (x i).val (x i).property)
  exact positive_log_distance_le_factor_two hd hx
    ((prime_ideal_kernel_log_localized P V Q hh kept d x hne).le.trans hh2)

theorem prime_kernel_pair_dyadic_cap {I J : Type*}
    [Fintype I] [DecidableEq I] [Fintype J] [DecidableEq J]
    (P : I → Finset ℕ) (V : I → ℝ) (R : J → Finset ℕ) (W : J → ℝ) (Q : ℕ)
    (hP : ∀ i p, p ∈ P i → 0 < p) (hR : ∀ j p, p ∈ R j → 0 < p)
    {h : ℝ} (hh : 0 < h) (hh2 : h ≤ Real.log 2) (keptP keptR : Finset ℤ)
    {U T : ℝ} (hU : 0 ≤ U) (hT : 0 ≤ T)
    (x : ∀ i, P i) (y : ∀ j, R j)
    (hx : ((∏ i, (x i).val : ℕ) : ℝ) ≤ 2 * U)
    (hy : ((∏ j, (y j).val : ℕ) : ℝ) ≤ 2 * T) :
    ((∏ i, (x i).val : ℕ) : ℝ) * ((∏ j, (y j).val : ℕ) : ℝ) ≤ 16 * U * T ∧
    ∀ (d : ∀ i, P i) (e : ∀ j, R j),
      primeProductIdealKernel P V Q h keptP d x * primeProductIdealKernel R W Q h keptR e y ≠ 0 →
      ((∏ i, (d i).val : ℕ) : ℝ) * ((∏ j, (e j).val : ℕ) : ℝ) ≤ 16 * U * T := by
  have hcap {p q : ℝ} (hp : 0 ≤ p) (hq : 0 ≤ q)
      (hpU : p ≤ 4 * U) (hqT : q ≤ 4 * T) : p * q ≤ 16 * U * T := by
    have hm := mul_le_mul hpU hqT hq (by positivity : 0 ≤ 4 * U)
    nlinarith
  constructor
  · exact hcap (Nat.cast_nonneg _) (Nat.cast_nonneg _) (by linarith) (by linarith)
  · intro d e hde
    have hd := (prime_ideal_kernel_factor_two P V Q hP hh hh2 keptP d x
      (mul_ne_zero_iff.mp hde).1).2
    have he := (prime_ideal_kernel_factor_two R W Q hR hh hh2 keptR e y
      (mul_ne_zero_iff.mp hde).2).2
    exact hcap (Nat.cast_nonneg _) (Nat.cast_nonneg _) (by linarith) (by linarith)
end

section
open scoped Classical
def finiteGroupFlattenEquiv {G : Type*} {I X : G → Type*} :
    (∀ g, I g → X g) ≃ (∀ a : Sigma I, X a.1) :=
  (Equiv.piCurry (fun (g : G) (_ : I g) => X g)).symm

theorem finite_group_flatten_apply {G : Type*} {I X : G → Type*}
    (x : ∀ g, I g → X g) (g : G) (i : I g) :
    finiteGroupFlattenEquiv x ⟨g, i⟩ = x g i := rfl

theorem finite_group_unflatten_apply {G : Type*} {I X : G → Type*}
    (x : ∀ a : Sigma I, X a.1) (g : G) (i : I g) :
    finiteGroupFlattenEquiv.symm x g i = x ⟨g, i⟩ := rfl

def finiteGroupFlattenFunction {G E : Type*} {I X : G → Type*}
    (f : (∀ g, I g → X g) → E) : (∀ a : Sigma I, X a.1) → E :=
  fun x => f (finiteGroupFlattenEquiv.symm x)

def finiteGroupUnflattenFunction {G E : Type*} {I X : G → Type*}
    (f : (∀ a : Sigma I, X a.1) → E) : (∀ g, I g → X g) → E :=
  fun x => f (finiteGroupFlattenEquiv x)

theorem finite_group_unflatten_flatten {G E : Type*} {I X : G → Type*}
    (f : (∀ g, I g → X g) → E) :
    finiteGroupUnflattenFunction (finiteGroupFlattenFunction f) = f := by
  funext x
  exact congrArg f (finiteGroupFlattenEquiv.symm_apply_apply x)

theorem finite_group_flatten_unflatten {G E : Type*} {I X : G → Type*}
    (f : (∀ a : Sigma I, X a.1) → E) :
    finiteGroupFlattenFunction (finiteGroupUnflattenFunction f) = f := by
  funext x
  exact congrArg f (finiteGroupFlattenEquiv.apply_symm_apply x)

theorem finite_product_weight_flatten {G : Type*} [Fintype G]
    {I X : G → Type*} [∀ g, Fintype (I g)] (μ : ∀ g, X g → ℝ)
    (x : ∀ g, I g → X g) :
    finiteProductWeight (fun a : Sigma I => μ a.1) (finiteGroupFlattenEquiv x) =
      finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g)) x := by
  unfold finiteProductWeight
  exact Fintype.prod_sigma (fun a : Sigma I => μ a.1 (x a.1 a.2))

theorem finite_product_weight_unflatten {G : Type*} [Fintype G]
    {I X : G → Type*} [∀ g, Fintype (I g)] (μ : ∀ g, X g → ℝ)
    (x : ∀ a : Sigma I, X a.1) :
    finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g))
        (finiteGroupFlattenEquiv.symm x) =
      finiteProductWeight (fun a : Sigma I => μ a.1) x := by
  simpa only [Equiv.apply_symm_apply] using
    (finite_product_weight_flatten μ (finiteGroupFlattenEquiv.symm x)).symm

theorem finite_group_flatten_energy {G : Type*} [Fintype G]
    {I X : G → Type*} [∀ g, Fintype (I g)] [∀ g, Fintype (X g)]
    (μ : ∀ g, X g → ℝ) (f : (∀ g, I g → X g) → ℂ) :
    finiteWeightedEnergy (finiteProductWeight (fun a : Sigma I => μ a.1))
        (finiteGroupFlattenFunction f) =
      finiteWeightedEnergy (finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g))) f := by
  have h := (finiteGroupFlattenEquiv (I := I) (X := X)).symm.sum_comp
    (fun x => finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g)) x * ‖f x‖ ^ 2)
  simpa only [finiteWeightedEnergy, finiteGroupFlattenFunction, finite_product_weight_unflatten] using h

theorem finite_group_unflatten_energy {G : Type*} [Fintype G]
    {I X : G → Type*} [∀ g, Fintype (I g)] [∀ g, Fintype (X g)]
    (μ : ∀ g, X g → ℝ) (f : (∀ a : Sigma I, X a.1) → ℂ) :
    finiteWeightedEnergy (finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g)))
        (finiteGroupUnflattenFunction f) =
      finiteWeightedEnergy (finiteProductWeight (fun a : Sigma I => μ a.1)) f := by
  simpa only [finite_group_flatten_unflatten] using
    (finite_group_flatten_energy μ (finiteGroupUnflattenFunction f)).symm

theorem finite_group_flatten_norm {G : Type*} [Fintype G]
    {I X : G → Type*} [∀ g, Fintype (I g)] [∀ g, Fintype (X g)]
    (μ : ∀ g, X g → ℝ) (f : (∀ g, I g → X g) → ℂ) :
    Real.sqrt (finiteWeightedEnergy (finiteProductWeight (fun a : Sigma I => μ a.1))
        (finiteGroupFlattenFunction f)) =
      Real.sqrt (finiteWeightedEnergy
        (finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g))) f) :=
  congrArg Real.sqrt (finite_group_flatten_energy μ f)

theorem finite_group_unflatten_norm {G : Type*} [Fintype G]
    {I X : G → Type*} [∀ g, Fintype (I g)] [∀ g, Fintype (X g)]
    (μ : ∀ g, X g → ℝ) (f : (∀ a : Sigma I, X a.1) → ℂ) :
    Real.sqrt (finiteWeightedEnergy
        (finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g)))
        (finiteGroupUnflattenFunction f)) =
      Real.sqrt (finiteWeightedEnergy (finiteProductWeight (fun a : Sigma I => μ a.1)) f) :=
  congrArg Real.sqrt (finite_group_unflatten_energy μ f)
end

section
open Finset
theorem finite_sigma_toList_perm {G : Type*} [DecidableEq G]
    {I : G → Type*} [∀ g, DecidableEq (I g)] (s : Finset G) (B : ∀ g, Finset (I g)) :
    (s.toList.sigma (fun g => (B g).toList)).Perm (s.sigma B).toList := by
  apply List.perm_of_nodup_nodup_toFinset_eq
    (s.nodup_toList.sigma (fun g => (B g).nodup_toList)) (s.sigma B).nodup_toList
  ext a
  rcases a with ⟨g, i⟩
  simp

theorem finite_sigma_outside_inside_disjoint {G : Type*} [Fintype G] [DecidableEq G]
    {I : G → Type*} [∀ g, DecidableEq (I g)]
    (s : Finset G) (A B : ∀ g, Finset (I g)) :
    Disjoint ((sᶜ).sigma B) (s.sigma (fun g => A g ∪ B g)) := by
  apply disjoint_left.mpr
  intro a ha hb
  exact (mem_compl.mp (mem_sigma.mp ha).1) (mem_sigma.mp hb).1

theorem finite_sigma_outside_inside_union {G : Type*} [Fintype G] [DecidableEq G]
    {I : G → Type*} [∀ g, DecidableEq (I g)]
    (s : Finset G) (A B : ∀ g, Finset (I g)) :
    (sᶜ).sigma B ∪ s.sigma (fun g => A g ∪ B g) = s.sigma A ∪ univ.sigma B := by
  ext a
  by_cases h : a.1 ∈ s <;> simp [h]

theorem finite_sigma_disjoint_of_fiber_disjoint {G : Type*} [DecidableEq G]
    {I : G → Type*} [∀ g, DecidableEq (I g)]
    (s t : Finset G) (A B : ∀ g, Finset (I g)) (hAB : ∀ g, Disjoint (A g) (B g)) :
    Disjoint (s.sigma A) (t.sigma B) := by
  apply disjoint_left.mpr
  intro a ha hb
  exact disjoint_left.mp (hAB a.1) (mem_sigma.mp ha).2 (mem_sigma.mp hb).2

theorem finite_sigma_probe_tail_disjoint {G : Type*} [Fintype G] [DecidableEq G]
    {I : G → Type*} [∀ g, DecidableEq (I g)]
    (s : Finset G) (A B : ∀ g, Finset (I g)) (hAB : ∀ g, Disjoint (A g) (B g)) :
    Disjoint (s.sigma A) (univ.sigma B) :=
  finite_sigma_disjoint_of_fiber_disjoint s univ A B hAB

theorem finite_disjoint_toList_append_perm {I : Type*} [DecidableEq I]
    (A B : Finset I) (hAB : Disjoint A B) :
    (A.toList ++ B.toList).Perm (A ∪ B).toList := by
  have hdis : List.Disjoint A.toList B.toList := by
    intro i hiA hiB
    exact disjoint_left.mp hAB (mem_toList.mp hiA) (mem_toList.mp hiB)
  apply List.perm_of_nodup_nodup_toFinset_eq
    (A.nodup_toList.append B.nodup_toList hdis) (A ∪ B).nodup_toList
  simp
end

section
open Finset
universe u v w

section Phase
variable {K : Type u} {X : Type v} (E : K → X → Type w)
  (target : ∀ k x, E k x → X) (phase : ∀ k x, E k x → ℂ)

def finiteEventLocalPhase : ∀ ks x, FiniteEventPath E target ks x → ℂ
  | [], _, _ => 1
  | k :: ks, x, ⟨e, p⟩ => phase k x e * finiteEventLocalPhase ks (target k x e) p

theorem finite_event_local_phase_norm_le
    (hphase : ∀ k x e, ‖phase k x e‖ ≤ 1)
    (ks : List K) (x : X) (p : FiniteEventPath E target ks x) :
    ‖finiteEventLocalPhase E target phase ks x p‖ ≤ 1 := by
  induction ks generalizing x with
  | nil => simp only [finiteEventLocalPhase, norm_one, le_refl]
  | cons k ks ih =>
    rcases p with ⟨e, p⟩
    rw [finiteEventLocalPhase, norm_mul]
    exact mul_le_one₀ (hphase k x e) (norm_nonneg _) (ih _ p)

variable [∀ k x, Fintype (E k x)] (weight : ∀ k x, E k x → ℝ)

noncomputable def finiteLocalPhasedRow (k : K) (F : X → ℂ) (x : X) : ℂ :=
  ∑ e : E k x, (weight k x e : ℂ) * phase k x e * F (target k x e)

theorem finite_event_local_phase_cons (k : K) (ks : List K) (F : X → ℂ) (x : X) :
    finiteEventPathAction E target weight (k :: ks)
      (finiteEventLocalPhase E target phase (k :: ks)) F x =
    finiteLocalPhasedRow E target phase weight k
      (finiteEventPathAction E target weight ks (finiteEventLocalPhase E target phase ks) F) x := by
  classical
  let _ : ∀ e : E k x, Fintype (FiniteEventPath E target ks (target k x e)) :=
    fun e => finiteEventPathFintype E target ks (target k x e)
  change (∑ p : (Σ e : E k x, FiniteEventPath E target ks (target k x e)),
    ((weight k x p.1 * finiteEventPathWeight E target weight ks _ p.2 : ℝ) : ℂ) *
      (phase k x p.1 * finiteEventLocalPhase E target phase ks _ p.2) *
      F (finiteEventPathTerminal E target ks _ p.2)) = _
  rw [Fintype.sum_sigma]
  unfold finiteLocalPhasedRow finiteEventPathAction
  simp only [mul_sum, Complex.ofReal_mul]
  apply sum_congr rfl
  intro e _
  apply sum_congr rfl
  intro p _
  ring

theorem finite_phased_rows_eq_event_paths (ks : List K) (F : X → ℂ) :
    finiteOperatorListAction (finiteLocalPhasedRow E target phase weight) ks F =
    finiteEventPathAction E target weight ks (finiteEventLocalPhase E target phase ks) F := by
  induction ks with
  | nil =>
    funext x
    change F x = ∑ _p : PUnit.{w + 1}, (1 : ℂ) * 1 * F x
    simp
  | cons k ks ih =>
    funext x
    rw [finite_event_local_phase_cons]
    change finiteLocalPhasedRow E target phase weight k
      (finiteOperatorListAction (finiteLocalPhasedRow E target phase weight) ks F) x = _
    rw [ih]

end Phase
end

section
open Finset
universe uJ uK uP uA

section Full
variable {J : Type uJ} {K : Type uK} {N : ℕ} {P : Fin N → Type uP}
  [∀ g, DecidableEq (P g)] (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type uA)
  (Δ D : ∀ k c, A k c → Fin N → ℤ)

abbrev FullMixedLedgerState :=
  ((g : Fin N) → Finset (P g)) ×
    ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B

def fullMixedLedgerDecode (s : FullMixedLedgerState n (M := M) B) :
    GlobalBirthJointState (fun g p => ZMod (n g p)) :=
  fun g => (s.1 g, boundedOrderedTupleToFinite (s.2 g).2)

noncomputable def fullMixedLedgerUpdate : (i : Option (J ⊕ K)) →
    ((g : Fin N) → Finset (P g)) →
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) →
    FullPermutationMixedEvent n S B A Δ D i x → (g : Fin N) → Finset (P g)
  | none, H, _, _ => H
  | some (.inl j), H, x, e =>
      fun g => (fullMixedGhostLedgerTarget n S B A Δ D j (fun g => (H g, x g)) e g).1
  | some (.inr k), H, x, e => fullEdgeLedgerUpdate n (S k) B (A k) (Δ k) (D k) H x e

noncomputable def fullMixedLedgerTarget (i : Option (J ⊕ K))
    (s : FullMixedLedgerState n (M := M) B)
    (e : FullPermutationMixedEvent n S B A Δ D i s.2) : FullMixedLedgerState n (M := M) B :=
  finiteLedgerEventTarget (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) (fullMixedLedgerUpdate n S B A Δ D) i s e

theorem full_mixed_ledger_target_state (i : Option (J ⊕ K))
    (s : FullMixedLedgerState n (M := M) B)
    (e : FullPermutationMixedEvent n S B A Δ D i s.2) :
    (fullMixedLedgerTarget n S B A Δ D i s e).2 =
      fullPermutationMixedEventTarget n S B A Δ D i s.2 e := rfl

theorem full_mixed_ledger_permutation_decode
    (s : FullMixedLedgerState n (M := M) B)
    (e : FullPermutationMixedEvent (J := J) n S B A Δ D none s.2) :
    fullMixedLedgerDecode n B (fullMixedLedgerTarget n S B A Δ D none s e) =
      fullMixedLedgerDecode n B s := rfl

theorem full_mixed_ledger_ghost_target (j : J)
    (s : FullMixedLedgerState n (M := M) B)
    (e : FullPermutationMixedEvent n S B A Δ D (some (.inl j)) s.2) :
    (fun g => ((fullMixedLedgerTarget n S B A Δ D (some (.inl j)) s e).1 g,
      (fullMixedLedgerTarget n S B A Δ D (some (.inl j)) s e).2 g)) =
    fullMixedGhostLedgerTarget n S B A Δ D j (fun g => (s.1 g, s.2 g)) e := rfl

theorem full_mixed_ledger_edge_decode (k : K)
    (s : FullMixedLedgerState n (M := M) B)
    (e : FullPermutationMixedEvent (J := J) n S B A Δ D (some (.inr k)) s.2) :
    fullMixedLedgerDecode n B (fullMixedLedgerTarget n S B A Δ D (some (.inr k)) s e) =
      fullEdgeLedgerRawTarget n (S k) B (A k) (Δ k) (D k) s.1 s.2 e := rfl

omit [∀ g, DecidableEq (P g)] in
theorem full_mixed_ledger_decode_length (s : FullMixedLedgerState n (M := M) B) :
    globalBirthJointLength (fullMixedLedgerDecode n B s) = productTotalMemory s.2 := rfl

end Full
end

section
open Finset
def FullActiveInjective {G : Type*} {P Z : G → Type*} {M : G → ℕ} {B : ℕ}
    (x : ProductBoundedOrderedState P Z M B) : Prop :=
  ∀ g, Function.Injective (x g).1

section Physical
variable {G : Type*} {P : G → Finset ℕ} {Z : G → Type*} {J ell B : ℕ}
  (C : G → Finset (Fin J))

noncomputable def physicalFullStateLabels
    (x : ProductBoundedOrderedState (fun g => ↥(P g)) Z (fun _ => J + ell) B)
    (hx : FullActiveInjective x) : PhysicalMarkLists P J ell :=
  fun g => ⟨(x g).1 ∘ (physicalFullSlotIndex (C g)).symm,
    (hx g).comp (physicalFullSlotIndex (C g)).symm.injective⟩

theorem physical_full_state_injective (L : PhysicalMarkLists P J ell)
    (q : ∀ g, BoundedOrderedTuple (Z g) B) :
    FullActiveInjective (physicalFullMemoryState C L q) :=
  fun g => (L g).injective.comp (physicalFullSlotIndex (C g)).injective

theorem physical_full_state_labels_encode (L : PhysicalMarkLists P J ell)
    (q : ∀ g, BoundedOrderedTuple (Z g) B) :
    physicalFullStateLabels C (physicalFullMemoryState C L q)
      (physical_full_state_injective C L q) = L := by
  funext g
  apply Function.Embedding.ext
  intro i
  change L g (physicalFullSlotIndex (C g) ((physicalFullSlotIndex (C g)).symm i)) = L g i
  rw [Equiv.apply_symm_apply]

theorem physical_full_state_encode_labels
    (x : ProductBoundedOrderedState (fun g => ↥(P g)) Z (fun _ => J + ell) B)
    (hx : FullActiveInjective x) :
    physicalFullMemoryState C (physicalFullStateLabels C x hx) (fun g => (x g).2) = x := by
  funext g
  apply Prod.ext
  · funext i
    change (x g).1 ((physicalFullSlotIndex (C g)).symm (physicalFullSlotIndex (C g) i)) = (x g).1 i
    rw [Equiv.symm_apply_apply]
  · rfl

noncomputable def physicalFullStateEquiv :
    (PhysicalMarkLists P J ell × ((g : G) → BoundedOrderedTuple (Z g) B)) ≃
    {x : ProductBoundedOrderedState (fun g => ↥(P g)) Z (fun _ => J + ell) B // FullActiveInjective x} where
  toFun s := ⟨physicalFullMemoryState C s.1 s.2, physical_full_state_injective C s.1 s.2⟩
  invFun x := (physicalFullStateLabels C x.val x.property, fun g => (x.val g).2)
  left_inv s := by
    apply Prod.ext
    · exact physical_full_state_labels_encode C s.1 s.2
    · rfl
  right_inv x := by
    apply Subtype.ext
    exact physical_full_state_encode_labels C x.val x.property

end Physical
end

section
open scoped BigOperators Classical
noncomputable def finiteDyadicTest {X : Type*} (π : X → ℕ) (j : ℕ)
    (f : X → ℂ) (x : X) : ℂ := if Nat.log 2 (π x) = j then f x else 0

noncomputable def finiteDyadicIndices {X : Type*} [Fintype X] (π : X → ℕ) : Finset ℕ :=
  Finset.univ.image (fun x => Nat.log 2 (π x))

theorem finite_dyadic_test_sum {X : Type*} [Fintype X] (π : X → ℕ)
    (f : X → ℂ) (x : X) :
    (∑ j ∈ finiteDyadicIndices π, finiteDyadicTest π j f x) = f x := by
  have hm : Nat.log 2 (π x) ∈ finiteDyadicIndices π :=
    Finset.mem_image.mpr ⟨x, Finset.mem_univ _, rfl⟩
  simp [finiteDyadicTest, hm]

theorem finite_dyadic_test_range {X : Type*} (π : X → ℕ) (f : X → ℂ)
    (hπ : ∀ x, f x ≠ 0 → 0 < π x) (j : ℕ) (x : X)
    (hx : finiteDyadicTest π j f x ≠ 0) : 2 ^ j ≤ π x ∧ π x < 2 * 2 ^ j := by
  have hj : Nat.log 2 (π x) = j := by
    by_contra h
    exact hx (if_neg h)
  have hfx : f x ≠ 0 := by simpa [finiteDyadicTest, hj] using hx
  rw [← hj]
  exact ⟨Nat.pow_log_le_self 2 (hπ x hfx).ne', by
    simpa only [pow_succ, mul_comm] using Nat.lt_pow_succ_log_self (by norm_num : 1 < (2 : ℕ)) (π x)⟩

theorem finite_dyadic_test_energy_le {X : Type*} [Fintype X]
    (π : X → ℕ) (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (f : X → ℂ) (j : ℕ) :
    (∑ x, μ x * ‖finiteDyadicTest π j f x‖ ^ 2) ≤ ∑ x, μ x * ‖f x‖ ^ 2 := by
  apply Finset.sum_le_sum
  intro x _
  unfold finiteDyadicTest
  split_ifs
  · exact le_rfl
  · simp only [norm_zero, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow, mul_zero]
    exact mul_nonneg (hμ x) (sq_nonneg _)

theorem nat_log_two_le_real_log {n : ℕ} (hn : 0 < n) :
    (Nat.log 2 n : ℝ) ≤ Real.log n / Real.log 2 := by
  have h2 : (0 : ℝ) < Real.log 2 := Real.log_pos (by norm_num)
  apply (le_div_iff₀ h2).mpr
  have hpow : (2 : ℝ) ^ Nat.log 2 n ≤ n := by
    exact_mod_cast Nat.pow_log_le_self 2 hn.ne'
  have hl := Real.log_le_log (by positivity : (0 : ℝ) < 2 ^ Nat.log 2 n) hpow
  simpa only [Real.log_pow] using hl

theorem finite_dyadic_indices_card_le {X : Type*} [Fintype X]
    (π : X → ℕ) (hπ : ∀ x, 0 < π x) {H : ℝ} (hH : 0 ≤ H)
    (hlog : ∀ x, Real.log (π x) ≤ H) :
    ((finiteDyadicIndices π).card : ℝ) ≤ H / Real.log 2 + 1 := by
  have h2 : (0 : ℝ) < Real.log 2 := Real.log_pos (by norm_num)
  have hsub : finiteDyadicIndices π ⊆ Finset.range (⌊H / Real.log 2⌋₊ + 1) := by
    intro j hj
    obtain ⟨x, _, rfl⟩ := Finset.mem_image.mp hj
    have hb : (Nat.log 2 (π x) : ℝ) ≤ H / Real.log 2 :=
      (nat_log_two_le_real_log (hπ x)).trans (div_le_div_of_nonneg_right (hlog x) h2.le)
    have := (Nat.le_floor_iff (div_nonneg hH h2.le)).mpr hb
    exact Finset.mem_range.mpr (by omega)
  have hc : (finiteDyadicIndices π).card ≤ ⌊H / Real.log 2⌋₊ + 1 :=
    (Finset.card_le_card hsub).trans_eq (Finset.card_range _)
  have hf : (⌊H / Real.log 2⌋₊ : ℝ) ≤ H / Real.log 2 := Nat.floor_le (div_nonneg hH h2.le)
  exact (by exact_mod_cast hc : ((finiteDyadicIndices π).card : ℝ) ≤ (⌊H / Real.log 2⌋₊ : ℝ) + 1).trans (by linarith)
end

section
open Filter
theorem minor_arc_dyad_coefficient_small {L C D U V r κ t q B : ℝ}
    (hL : 48 ≤ L) (_hC : 0 ≤ C) (hD : 0 ≤ D) (ht : 0 ≤ t) (hq : 0 ≤ q)
    (hparam : 2 * κ + t + 2 * B + 1 ≤ q)
    (hCU : C ≤ L ^ κ) (hDU : D ≤ L ^ κ)
    (hU : L ^ q ≤ U) (hV : L ^ q ≤ V) (hr : L ^ q ≤ r)
    (hrUV : r / (U * V) ≤ L ^ (-q)) (hlog : Real.log r ≤ L ^ t) :
    6 * C * D * (1 + Real.log r) * (1 / r + 1 / U + 1 / V + r / (U * V)) ≤
      L ^ (-2 * B) := by
  have hL0 : 0 < L := by linarith
  have hL1 : 1 ≤ L := by linarith
  have hpowq : 0 < L ^ q := Real.rpow_pos_of_pos hL0 q
  have hU0 : 0 < U := hpowq.trans_le hU
  have hV0 : 0 < V := hpowq.trans_le hV
  have hr0 : 0 < r := hpowq.trans_le hr
  have hpq : (1 : ℝ) ≤ L ^ q := Real.one_le_rpow hL1 hq
  have hpt : (1 : ℝ) ≤ L ^ t := Real.one_le_rpow hL1 ht
  have hlog0 : 0 ≤ Real.log r := Real.log_nonneg (hpq.trans hr)
  have hinv {z : ℝ} (hz : L ^ q ≤ z) : 1 / z ≤ L ^ (-q) := by
    rw [Real.rpow_neg hL0.le, ← one_div]
    exact one_div_le_one_div_of_le hpowq hz
  have hs : 1 / r + 1 / U + 1 / V + r / (U * V) ≤ 4 * L ^ (-q) := by
    linarith [hinv hr, hinv hU, hinv hV]
  have hproduct :
      6 * C * D * (1 + Real.log r) * (1 / r + 1 / U + 1 / V + r / (U * V)) ≤
      48 * L ^ (2 * κ + t - q) := by
    calc
      _ ≤ 6 * L ^ κ * L ^ κ * (2 * L ^ t) * (4 * L ^ (-q)) := by
        apply mul_le_mul
        · apply mul_le_mul
          · exact mul_le_mul (mul_le_mul_of_nonneg_left hCU (by norm_num)) hDU hD (by positivity)
          · linarith
          · linarith
          · positivity
        · exact hs
        · positivity
        · positivity
      _ = 48 * L ^ (2 * κ + t - q) := by
        rw [show 2 * κ + t - q = κ + κ + t + -q by ring]
        rw [Real.rpow_add hL0, Real.rpow_add hL0, Real.rpow_add hL0]
        ring
  calc
    _ ≤ 48 * L ^ (2 * κ + t - q) := hproduct
    _ ≤ L * L ^ (-2 * B - 1) := by
      apply mul_le_mul hL
      · exact Real.rpow_le_rpow_of_exponent_le hL1 (by linarith)
      · positivity
      · positivity
    _ = L ^ (-2 * B) := by
      calc
        _ = L ^ (1 + (-2 * B - 1)) := by rw [Real.rpow_add hL0, Real.rpow_one]
        _ = _ := by congr 1; ring

theorem eventually_minor_arc_pool_scales {c : ℝ} (hc : 0 < c) (q : ℝ) :
    ∀ᶠ L : ℝ in atTop, L ^ q ≤ Real.exp (L ^ c) := by
  simpa only [one_mul] using eventually_mul_rpow_le_exp_rpow q 1 hc
end

section

theorem major_arc_coefficient_small
    {L Q N ξ h Z W εA εB q n x w z s d B : ℝ}
    (hL : 512 ≤ L) (hQ : 0 ≤ Q) (_hN : 0 ≤ N) (hξ : 0 ≤ ξ)
    (_hh : 0 ≤ h) (hZ : 0 ≤ Z) (hW : 0 ≤ W)
    (hεA : 0 ≤ εA) (hεB : 0 ≤ εB) (hq : 0 ≤ q) (hd : 0 ≤ d)
    (hQb : Q ≤ L ^ q) (hNb : N ≤ L ^ n) (hξb : ξ ≤ L ^ (-x))
    (hhb : h ≤ L ^ (-w)) (hZb : Z ≤ L ^ z) (hWb : W ≤ L ^ s)
    (hεAb : εA ≤ L ^ (-d)) (hεBb : εB ≤ L ^ (-d))
    (hxp : n + 2 * B + 2 ≤ x)
    (hwp : 4 * q + max z s + B + 2 ≤ w)
    (hdp : q + B + 2 ≤ d) :
    Real.sqrt (N * ξ) + 2 * h * (Z + 32 * Real.pi * W) * Q ^ 4 +
      Real.sqrt Q * (εA + εB + εA * εB) ≤ L ^ (-B) := by
  have hL0 : 0 < L := by linarith
  have hL1 : 1 ≤ L := by linarith
  have hpow (a b : ℝ) (hab : a ≤ b) : L ^ a ≤ L ^ b :=
    Real.rpow_le_rpow_of_exponent_le hL1 hab
  have hshift (a : ℝ) : L * L ^ (a - 1) = L ^ a := by
    calc
      _ = L ^ (1 + (a - 1)) := by rw [Real.rpow_add hL0, Real.rpow_one]
      _ = _ := by congr 1; ring
  have hdiscard : Real.sqrt (N * ξ) ≤ L ^ (-B - 1) := by
    have hp : N * ξ ≤ (L ^ (-B - 1)) ^ 2 := by
      calc
        _ ≤ L ^ n * L ^ (-x) := mul_le_mul hNb hξb hξ (by positivity)
        _ = L ^ (n - x) := by rw [sub_eq_add_neg, Real.rpow_add hL0]
        _ ≤ L ^ ((-B - 1) + (-B - 1)) := hpow _ _ (by linarith)
        _ = _ := by rw [Real.rpow_add hL0]; ring
    simpa only [Real.sqrt_sq (by positivity : 0 ≤ L ^ (-B - 1))] using Real.sqrt_le_sqrt hp
  have hphase : 2 * h * (Z + 32 * Real.pi * W) * Q ^ 4 ≤ L ^ (-B - 1) := by
    have hz : Z ≤ L ^ max z s := hZb.trans (hpow _ _ (le_max_left _ _))
    have hw : W ≤ L ^ max z s := hWb.trans (hpow _ _ (le_max_right _ _))
    have hp : Z + 32 * Real.pi * W ≤ 129 * L ^ max z s := by
      have hpw : 32 * Real.pi * W ≤ 128 * L ^ max z s := by
        exact mul_le_mul (by nlinarith [Real.pi_lt_four]) hw hW (by positivity)
      linarith
    calc
      _ ≤ 2 * L ^ (-w) * (129 * L ^ max z s) * (L ^ q) ^ 4 := by
        gcongr
      _ = 258 * L ^ (-w + max z s + 4 * q) := by
        rw [show -w + max z s + 4 * q = -w + max z s + q + q + q + q by ring]
        simp only [Real.rpow_add hL0]
        ring
      _ ≤ 258 * L ^ (-B - 2) := mul_le_mul_of_nonneg_left (hpow _ _ (by linarith)) (by norm_num)
      _ ≤ L * L ^ (-B - 2) := by gcongr; linarith
      _ = L ^ (-B - 1) := by rw [show -B - 2 = (-B - 1) - 1 by ring, hshift]
  have heps : Real.sqrt Q * (εA + εB + εA * εB) ≤ L ^ (-B - 1) := by
    have hs : Real.sqrt Q ≤ L ^ q :=
      (Real.sqrt_le_sqrt hQb).trans (Real.sqrt_le_self_iff.mpr (Or.inr (Real.one_le_rpow hL1 hq)))
    have hsmall : L ^ (-d) ≤ 1 := by
      simpa only [Real.rpow_zero] using hpow (-d) 0 (by linarith)
    have hprod : εA * εB ≤ L ^ (-d) := by
      calc
        _ ≤ L ^ (-d) * L ^ (-d) := mul_le_mul hεAb hεBb hεB (by positivity)
        _ ≤ L ^ (-d) * 1 := mul_le_mul_of_nonneg_left hsmall (by positivity)
        _ = _ := mul_one _
    calc
      _ ≤ L ^ q * (3 * L ^ (-d)) := by
        apply mul_le_mul hs (by linarith)
        · positivity
        · positivity
      _ = 3 * L ^ (q - d) := by rw [sub_eq_add_neg, Real.rpow_add hL0]; ring
      _ ≤ 3 * L ^ (-B - 2) := mul_le_mul_of_nonneg_left (hpow _ _ (by linarith)) (by norm_num)
      _ ≤ L * L ^ (-B - 2) := by gcongr; linarith
      _ = L ^ (-B - 1) := by rw [show -B - 2 = (-B - 1) - 1 by ring, hshift]
  calc
    _ ≤ 3 * L ^ (-B - 1) := by linarith
    _ ≤ L * L ^ (-B - 1) := by gcongr; linarith
    _ = L ^ (-B) := hshift (-B)
end

section
open Finset
theorem squarefree_conductor_quotient_totient (d f : ℕ)
    (hd : Squarefree d) (hf : f ∣ d) :
    Nat.totient d = Nat.totient f * Nat.totient (d / f) := by
  have hc : Nat.Coprime f (d / f) := by
    apply Nat.coprime_of_squarefree_mul
    rwa [Nat.mul_div_cancel' hf]
  rw [← Nat.totient_mul hc, Nat.mul_div_cancel' hf]

theorem conductor_weighted_totient_mass_le (N f : ℕ) (hf : 0 < f) (F : ℕ → ℝ)
    (hF : ∀ h ∈ (Icc 1 N).filter Squarefree, 0 ≤ F h) :
    (∑ d ∈ (Icc 1 N).filter (fun d => Squarefree d ∧ f ∣ d),
      F (d / f) / (Nat.totient d : ℝ)) ≤
      (1 / (Nat.totient f : ℝ)) *
        ∑ h ∈ (Icc 1 N).filter Squarefree, F h / (Nat.totient h : ℝ) := by
  let M := (Icc 1 N).filter (fun d => Squarefree d ∧ f ∣ d)
  have hinj : Set.InjOn (fun d => d / f) M := by
    intro d hd e he hde
    change d / f = e / f at hde
    have hfd := (mem_filter.mp hd).2.2
    have hfe := (mem_filter.mp he).2.2
    calc
      d = f * (d / f) := (Nat.mul_div_cancel' hfd).symm
      _ = f * (e / f) := by rw [hde]
      _ = e := Nat.mul_div_cancel' hfe
  have hsub : M.image (fun d => d / f) ⊆ (Icc 1 N).filter Squarefree := by
    intro h hh
    obtain ⟨d, hd, rfl⟩ := mem_image.mp hh
    obtain ⟨hdrange, hdsq, hfd⟩ := mem_filter.mp hd
    obtain ⟨hd0, hdN⟩ := mem_Icc.mp hdrange
    apply mem_filter.mpr
    exact ⟨mem_Icc.mpr ⟨Nat.div_pos (Nat.le_of_dvd hd0 hfd) hf,
      (Nat.div_le_self d f).trans hdN⟩, hdsq.squarefree_of_dvd (Nat.div_dvd_of_dvd hfd)⟩
  calc
    _ = (1 / (Nat.totient f : ℝ)) * ∑ d ∈ M, F (d / f) / (Nat.totient (d / f) : ℝ) := by
      rw [mul_sum]
      apply sum_congr rfl
      intro d hd
      rw [squarefree_conductor_quotient_totient d f (mem_filter.mp hd).2.1 (mem_filter.mp hd).2.2,
        Nat.cast_mul]
      simp only [div_eq_mul_inv, mul_inv_rev, one_mul]
      ring
    _ = (1 / (Nat.totient f : ℝ)) *
        ∑ h ∈ M.image (fun d => d / f), F h / (Nat.totient h : ℝ) := by
      rw [sum_image hinj]
    _ ≤ _ := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      exact sum_le_sum_of_subset_of_nonneg hsub
        (fun h hh _ => div_nonneg (hF h hh) (Nat.cast_nonneg _))

theorem conductor_totient_mass_le_log (N f : ℕ) (hf : 0 < f) {D : ℝ}
    (hD : 1 ≤ D) (hND : (N : ℝ) ≤ D) :
    (∑ d ∈ (Icc 1 N).filter (fun d => Squarefree d ∧ f ∣ d),
      1 / (Nat.totient d : ℝ)) ≤
      (1 / (Nat.totient f : ℝ)) *
        ((2 * primeEulerProductUpperConstant) * Real.log (2 * D)) := by
  have h := conductor_weighted_totient_mass_le N f hf (fun _ => 1) (by intros; norm_num)
  exact h.trans (mul_le_mul_of_nonneg_left (totient_sieve_squarefree_mass_le_log N hD hND)
    (by positivity))
end

section
open Finset
theorem norm_sum_Ioc_smul_le_of_monotone
    (f : ℕ → ℝ) (g : ℕ → ℂ) {m n : ℕ} (hmn : m < n) {B : ℝ}
    (hf : ∀ i ∈ Icc (m + 1) n, 0 ≤ f i)
    (hmono : MonotoneOn f (Set.Icc (m + 1) n))
    (hprefix : ∀ i ∈ Icc m n, ‖∑ j ∈ range (i + 1), g j‖ ≤ B) :
    ‖∑ i ∈ Ioc m n, f i • g i‖ ≤ 2 * f n * B := by
  have hm1 : m + 1 ≤ n := by omega
  have hm1mem : m + 1 ∈ Icc (m + 1) n := mem_Icc.mpr ⟨le_rfl, hm1⟩
  have hnmem : n ∈ Icc (m + 1) n := mem_Icc.mpr ⟨hm1, le_rfl⟩
  have hsum : ∀ i ∈ Ioc m (n - 1),
      ‖(f (i + 1) - f i) • (∑ j ∈ range (i + 1), g j)‖ ≤
        (f (i + 1) - f i) * B := by
    intro i hi
    obtain ⟨hmi, hin⟩ := mem_Ioc.mp hi
    have hdiff : f i ≤ f (i + 1) :=
      hmono ⟨by omega, by omega⟩ ⟨by omega, by omega⟩ (by omega)
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (sub_nonneg.mpr hdiff)]
    exact mul_le_mul_of_nonneg_left (hprefix i (mem_Icc.mpr ⟨by omega, by omega⟩))
      (sub_nonneg.mpr hdiff)
  have htel : (∑ i ∈ Ioc m (n - 1), (f (i + 1) - f i)) = f n - f (m + 1) := by
    rw [← Ico_add_one_add_one_eq_Ioc, Nat.sub_add_cancel (by omega : 1 ≤ n)]
    exact sum_Ico_sub f hm1
  rw [sum_Ioc_by_parts f g hmn]
  calc
    _ ≤ ‖f n • (∑ j ∈ range (n + 1), g j)‖ +
        ‖f (m + 1) • (∑ j ∈ range (m + 1), g j)‖ +
        ‖∑ i ∈ Ioc m (n - 1),
          (f (i + 1) - f i) • (∑ j ∈ range (i + 1), g j)‖ :=
      (norm_sub_le _ _).trans (add_le_add (norm_sub_le _ _) le_rfl)
    _ ≤ f n * B + f (m + 1) * B +
        ∑ i ∈ Ioc m (n - 1), (f (i + 1) - f i) * B := by
      gcongr
      · rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (hf n hnmem)]
        exact mul_le_mul_of_nonneg_left (hprefix n (mem_Icc.mpr ⟨hmn.le, le_rfl⟩))
          (hf n hnmem)
      · rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (hf (m + 1) hm1mem)]
        exact mul_le_mul_of_nonneg_left (hprefix m (mem_Icc.mpr ⟨le_rfl, hmn.le⟩))
          (hf (m + 1) hm1mem)
      · exact (norm_sum_le _ _).trans (sum_le_sum hsum)
    _ = 2 * f n * B := by rw [← sum_mul, htel]; ring

theorem ordinary_sum_le_of_reciprocal_prefix (S : Finset ℕ) (F : ℕ → ℂ)
    {b B : ℝ} (hb : 0 ≤ b) (hB : 0 ≤ B)
    (hpos : ∀ p ∈ S, 0 < p) (hupper : ∀ p ∈ S, (p : ℝ) ≤ b)
    (hprefix : ∀ k : ℕ,
      ‖∑ p ∈ S.filter (fun p => p ≤ k), (1 / (p : ℝ)) • F p‖ ≤ B) :
    ‖∑ p ∈ S, F p‖ ≤ 2 * b * B := by
  classical
  let N := ⌊b⌋₊
  have hsub : S ⊆ Ioc 0 N := by
    intro p hp
    exact mem_Ioc.mpr ⟨hpos p hp, Nat.le_floor (hupper p hp)⟩
  by_cases hN : 0 < N
  · let g : ℕ → ℂ := fun p => if p ∈ S then (1 / (p : ℝ)) • F p else 0
    have hpref (k : ℕ) : (∑ j ∈ range (k + 1), g j) =
        ∑ p ∈ S.filter (fun p => p ≤ k), (1 / (p : ℝ)) • F p := by
      dsimp only [g]
      rw [← sum_filter]
      apply sum_congr
      · ext p
        simp only [mem_filter, mem_range, Nat.lt_succ_iff, and_comm]
      · intro p _
        rfl
    have hsum : (∑ p ∈ Ioc 0 N, (p : ℝ) • g p) = ∑ p ∈ S, F p := by
      calc
        _ = ∑ p ∈ Ioc 0 N, if p ∈ S then F p else 0 := by
          apply sum_congr rfl
          intro p _
          dsimp only [g]
          by_cases hp : p ∈ S
          · rw [if_pos hp, if_pos hp, smul_smul]
            have hp0 : (p : ℝ) ≠ 0 := by exact_mod_cast (hpos p hp).ne'
            simp [hp0]
          · simp [hp]
        _ = ∑ p ∈ (Ioc 0 N).filter (fun p => p ∈ S), F p := (sum_filter _ _).symm
        _ = ∑ p ∈ S, F p := by
          congr 1
          ext p
          simp only [mem_filter]
          exact ⟨fun h => h.2, fun hp => ⟨hsub hp, hp⟩⟩
    have h := norm_sum_Ioc_smul_le_of_monotone (fun n => (n : ℝ)) g hN
      (fun n _ => Nat.cast_nonneg n)
      (fun _ _ _ _ h => Nat.cast_le.mpr h)
      (fun k _ => by rw [hpref]; exact hprefix k)
    rw [hsum] at h
    exact h.trans (mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_left (Nat.floor_le hb) (by norm_num)) hB)
  · have hN0 : N = 0 := by omega
    have hS : S = ∅ := by
      apply eq_empty_iff_forall_notMem.mpr
      intro p hp
      have h := mem_Ioc.mp (hsub hp)
      omega
    rw [hS, sum_empty, norm_zero]
    positivity

theorem primeBand_product_filter_prefix {a b c U V : ℝ}
    (ha : 0 ≤ a) (hb : 0 ≤ b) (k : ℕ) :
    ((primeBand a b).filter
      (fun p : ℕ => U < c * (p : ℝ) ∧ c * (p : ℝ) ≤ V)).filter (fun p => p ≤ k) =
    (primeBand a (min b (k : ℝ))).filter
      (fun p : ℕ => U < c * (p : ℝ) ∧ c * (p : ℝ) ≤ V) := by
  ext p
  simp only [mem_filter, mem_primeBand_iff ha hb,
    mem_primeBand_iff ha (le_min hb (Nat.cast_nonneg k)), le_min_iff, Nat.cast_le]
  tauto

theorem ordinary_prime_band_product_interval_bound
    (hZ : PrimitiveZeroFreeHalfPlane) :
    ∃ C : ℝ, 0 < C ∧ ∀ (q : ℕ), 0 < q →
      ∀ χ : DirichletCharacter ℂ q, χ ≠ 1 →
      ∀ a b c U V : ℝ, 2 ≤ a → 0 ≤ b → 0 < c → 0 ≤ U → 0 ≤ V →
        ‖∑ p ∈ (primeBand a b).filter
            (fun p : ℕ => U < c * (p : ℝ) ∧ c * (p : ℝ) ≤ V),
          χ (p : ZMod q)‖ ≤
            2 * b * C * a ^ (-(1 : ℝ) / 32) * (1 + Real.log q / Real.log a) := by
  obtain ⟨C, hC, hbound⟩ := reciprocal_prime_band_product_interval_bound hZ
  refine ⟨C, hC, ?_⟩
  intro q hq χ hχ a b c U V ha hb hc hU hV
  have haq : 0 ≤ Real.log (q : ℝ) := Real.log_nonneg (by exact_mod_cast hq)
  have haa : 0 < Real.log a := Real.log_pos (by linarith)
  have ha0 : 0 ≤ a := by linarith
  have hB : 0 ≤ C * a ^ (-(1 : ℝ) / 32) * (1 + Real.log q / Real.log a) := by
    positivity
  have h := ordinary_sum_le_of_reciprocal_prefix
    ((primeBand a b).filter (fun p : ℕ => U < c * (p : ℝ) ∧ c * (p : ℝ) ≤ V))
    (fun p => χ (p : ZMod q)) hb hB
    (fun p hp => ((mem_primeBand_iff ha0 hb p).mp (mem_filter.mp hp).1).1.pos)
    (fun p hp => ((mem_primeBand_iff ha0 hb p).mp (mem_filter.mp hp).1).2.2)
    (fun k => by
      rw [primeBand_product_filter_prefix ha0 hb]
      exact hbound q hq χ hχ a (min b (k : ℝ)) c U V ha
        (le_min hb (Nat.cast_nonneg k)) hc hU hV)
  convert h using 1
  ring
end

section
open Set MeasureTheory
open scoped BigOperators
theorem endpoint_le_average_add_integral {f B : ℝ → ℝ} {a b : ℝ}
    (hab : a < b) (hfc : ContinuousOn f (Icc a b))
    (hfd : DifferentiableOn ℝ f (Ioo a b))
    (hB : ∀ x ∈ Icc a b, 0 ≤ B x)
    (hfB : ∀ x ∈ Ioo a b, ‖deriv f x‖ ≤ B x)
    (hBi : IntervalIntegrable B volume a b) :
    f a ≤ (b - a)⁻¹ * (∫ x in a..b, f x) + ∫ x in a..b, B x := by
  have hfI : IntervalIntegrable f volume a b := hfc.intervalIntegrable_of_Icc hab.le
  have hpoint (y : ℝ) (hy : y ∈ Icc a b) :
      f a ≤ f y + ∫ x in a..b, B x := by
    have hsub : Icc a y ⊆ Icc a b := Icc_subset_Icc le_rfl hy.2
    have hspeed := norm_sub_le_integral_of_norm_deriv_le_of_le hy.1
      (hfc.mono hsub) (hfd.mono (Ioo_subset_Ioo le_rfl hy.2))
      (Filter.Eventually.of_forall (fun x hx => hfB x ⟨hx.1, hx.2.trans_le hy.2⟩))
      (hBi.mono_set (by simpa only [uIcc_of_le hy.1, uIcc_of_le hab.le] using hsub))
    have hmono : (∫ x in a..y, B x) ≤ ∫ x in a..b, B x :=
      intervalIntegral.integral_mono_interval le_rfl hy.1 hy.2
        ((ae_restrict_iff' measurableSet_Ioc).mpr
          (Filter.Eventually.of_forall (fun x hx => hB x ⟨hx.1.le, hx.2⟩))) hBi
    have hdiff : f a - f y ≤ ‖f y - f a‖ := by
      rw [Real.norm_eq_abs, abs_sub_comm]
      exact le_abs_self _
    linarith
  have hint := intervalIntegral.integral_mono_on hab.le
    (intervalIntegrable_const : IntervalIntegrable (fun _ : ℝ => f a) volume a b)
    (hfI.add intervalIntegrable_const) hpoint
  rw [intervalIntegral.integral_add hfI intervalIntegrable_const,
    intervalIntegral.integral_const, intervalIntegral.integral_const] at hint
  simp only [smul_eq_mul] at hint
  have hlen : 0 < b - a := sub_pos.mpr hab
  apply (mul_le_mul_iff_right₀ hlen).mp
  calc
    (b - a) * f a ≤ (∫ x in a..b, f x) + (b - a) * ∫ x in a..b, B x := hint
    _ = (b - a) * ((b - a)⁻¹ * (∫ x in a..b, f x) + ∫ x in a..b, B x) := by
      field_simp

theorem sum_disjoint_interval_integrals_le {ι : Type*} (s : Finset ι)
    (l r : ι → ℝ) {a b : ℝ} (hab : a ≤ b)
    (hlr : ∀ i ∈ s, l i ≤ r i) (hal : ∀ i ∈ s, a ≤ l i)
    (hrb : ∀ i ∈ s, r i ≤ b)
    (hdisj : Set.Pairwise (↑s) (Function.onFun Disjoint (fun i => Ioc (l i) (r i))))
    {f : ℝ → ℝ} (hfc : ContinuousOn f (Icc a b))
    (hf0 : ∀ x ∈ Icc a b, 0 ≤ f x) :
    (∑ i ∈ s, ∫ x in l i..r i, f x) ≤ ∫ x in a..b, f x := by
  have hfI : IntervalIntegrable f volume a b := hfc.intervalIntegrable_of_Icc hab
  have hlocal (i : ι) (hi : i ∈ s) : IntegrableOn f (Ioc (l i) (r i)) :=
    hfI.1.mono_set (Ioc_subset_Ioc (hal i hi) (hrb i hi))
  have hsum : (∑ i ∈ s, ∫ x in l i..r i, f x) =
      ∑ i ∈ s, ∫ x in Ioc (l i) (r i), f x :=
    Finset.sum_congr rfl (fun i hi => intervalIntegral.integral_of_le (hlr i hi))
  rw [hsum]
  rw [← integral_biUnion_finset s (fun _ _ => measurableSet_Ioc) hdisj hlocal,
    intervalIntegral.integral_of_le hab]
  apply setIntegral_mono_set hfI.1
  · exact (ae_restrict_iff' measurableSet_Ioc).mpr
      (Filter.Eventually.of_forall (fun x hx => hf0 x ⟨hx.1.le, hx.2⟩))
  · apply Filter.Eventually.of_forall
    intro x hx
    obtain ⟨i, hi, hxi⟩ := mem_iUnion₂.mp hx
    exact ⟨(hal i hi).trans_lt hxi.1, hxi.2.trans (hrb i hi)⟩

theorem separated_right_intervals_disjoint {ι : Type*} (s : Finset ι)
    (x : ι → ℝ) {δ : ℝ}
    (hsep : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → δ ≤ |x i - x j|) :
    Set.Pairwise (↑s) (Function.onFun Disjoint (fun i => Ioc (x i) (x i + δ))) := by
  intro i hi j hj hij
  apply Set.disjoint_left.mpr
  intro y hyi hyj
  have hd := hsep i hi j hj hij
  rcases le_total (x i) (x j) with h | h
  · rw [abs_of_nonpos (sub_nonpos.mpr h)] at hd
    linarith [hyi.2, hyj.1]
  · rw [abs_of_nonneg (sub_nonneg.mpr h)] at hd
    linarith [hyj.2, hyi.1]

theorem separated_samples_le_integrals {ι : Type*} (s : Finset ι)
    (x : ι → ℝ) {δ a b : ℝ} (hδ : 0 < δ) (hab : a ≤ b)
    (hleft : ∀ i ∈ s, a ≤ x i) (hright : ∀ i ∈ s, x i + δ ≤ b)
    (hsep : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → δ ≤ |x i - x j|)
    {f B : ℝ → ℝ} (hfc : ContinuousOn f (Icc a b))
    (hfd : DifferentiableOn ℝ f (Ioo a b))
    (hf0 : ∀ y ∈ Icc a b, 0 ≤ f y) (hBc : ContinuousOn B (Icc a b))
    (hB0 : ∀ y ∈ Icc a b, 0 ≤ B y)
    (hfB : ∀ y ∈ Ioo a b, ‖deriv f y‖ ≤ B y) :
    (∑ i ∈ s, f (x i)) ≤ δ⁻¹ * (∫ y in a..b, f y) + ∫ y in a..b, B y := by
  have horder (i : ι) (hi : i ∈ s) : x i ≤ x i + δ := le_add_of_nonneg_right hδ.le
  have hdisj := separated_right_intervals_disjoint s x hsep
  have hpoint (i : ι) (hi : i ∈ s) : f (x i) ≤
      δ⁻¹ * (∫ y in x i..x i + δ, f y) + ∫ y in x i..x i + δ, B y := by
    have hcsub : Icc (x i) (x i + δ) ⊆ Icc a b :=
      Icc_subset_Icc (hleft i hi) (hright i hi)
    have hosub : Ioo (x i) (x i + δ) ⊆ Ioo a b :=
      Ioo_subset_Ioo (hleft i hi) (hright i hi)
    simpa only [add_sub_cancel_left] using endpoint_le_average_add_integral
      (lt_add_of_pos_right (x i) hδ) (hfc.mono hcsub) (hfd.mono hosub)
      (fun y hy => hB0 y (hcsub hy)) (fun y hy => hfB y (hosub hy))
      ((hBc.mono hcsub).intervalIntegrable_of_Icc (horder i hi))
  calc
    (∑ i ∈ s, f (x i)) ≤ ∑ i ∈ s,
        (δ⁻¹ * (∫ y in x i..x i + δ, f y) + ∫ y in x i..x i + δ, B y) :=
      Finset.sum_le_sum hpoint
    _ = δ⁻¹ * (∑ i ∈ s, ∫ y in x i..x i + δ, f y) +
        ∑ i ∈ s, ∫ y in x i..x i + δ, B y := by
      rw [Finset.sum_add_distrib, Finset.mul_sum]
    _ ≤ δ⁻¹ * (∫ y in a..b, f y) + ∫ y in a..b, B y :=
      add_le_add
        (mul_le_mul_of_nonneg_left
          (sum_disjoint_interval_integrals_le s x (fun i => x i + δ)
            hab horder hleft hright hdisj hfc hf0) (inv_nonneg.mpr hδ.le))
        (sum_disjoint_interval_integrals_le s x (fun i => x i + δ)
          hab horder hleft hright hdisj hBc hB0)

theorem separated_samples_norm_sq_le {ι E : Type*}
    [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (s : Finset ι) (x : ι → ℝ) {δ a b : ℝ} (hδ : 0 < δ) (hab : a ≤ b)
    (hleft : ∀ i ∈ s, a ≤ x i) (hright : ∀ i ∈ s, x i + δ ≤ b)
    (hsep : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → δ ≤ |x i - x j|)
    (F F' : ℝ → E) (hF : ∀ y, HasDerivAt F (F' y) y) (hF' : Continuous F') :
    (∑ i ∈ s, ‖F (x i)‖ ^ 2) ≤
      δ⁻¹ * (∫ y in a..b, ‖F y‖ ^ 2) +
        2 * ∫ y in a..b, ‖F y‖ * ‖F' y‖ := by
  have hFc : Continuous F := continuous_iff_continuousAt.mpr (fun y => (hF y).continuousAt)
  have hbound (y : ℝ) :
      ‖deriv (fun y => ‖F y‖ ^ 2) y‖ ≤ 2 * (‖F y‖ * ‖F' y‖) := by
    rw [(hF y).norm_sq.deriv, norm_mul, Real.norm_eq_abs, abs_of_pos (by norm_num : (0:ℝ) < 2)]
    exact mul_le_mul_of_nonneg_left (abs_real_inner_le_norm (F y) (F' y)) (by norm_num)
  have h := separated_samples_le_integrals s x hδ hab hleft hright hsep
    (hFc.norm.pow 2).continuousOn
    (fun y _ => (hF y).norm_sq.differentiableAt.differentiableWithinAt)
    (fun y _ => sq_nonneg ‖F y‖)
    ((hFc.norm.mul hF'.norm).const_mul 2).continuousOn
    (fun y _ => by dsimp; positivity) (fun y _ => hbound y)
  simpa only [Pi.pow_apply, Pi.mul_apply, intervalIntegral.integral_const_mul] using h

theorem separated_samples_norm_sq_le_energy {ι E : Type*}
    [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (s : Finset ι) (x : ι → ℝ) {δ a b K Q : ℝ} (hδ : 0 < δ) (hab : a ≤ b)
    (hleft : ∀ i ∈ s, a ≤ x i) (hright : ∀ i ∈ s, x i + δ ≤ b)
    (hsep : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → δ ≤ |x i - x j|)
    (F F' : ℝ → E) (hF : ∀ y, HasDerivAt F (F' y) y) (hF' : Continuous F')
    (hK : 0 < K) (henergy : (∫ y in a..b, ‖F y‖ ^ 2) ≤ Q)
    (hderiv : (∫ y in a..b, ‖F' y‖ ^ 2) ≤ K ^ 2 * Q) :
    (∑ i ∈ s, ‖F (x i)‖ ^ 2) ≤ (δ⁻¹ + 2 * K) * Q := by
  have hFc : Continuous F := continuous_iff_continuousAt.mpr (fun y => (hF y).continuousAt)
  have hFI : IntervalIntegrable (fun y => ‖F y‖ ^ 2) volume a b :=
    (hFc.norm.pow 2).intervalIntegrable _ _
  have hF'I : IntervalIntegrable (fun y => ‖F' y‖ ^ 2) volume a b :=
    (hF'.norm.pow 2).intervalIntegrable _ _
  have hprodI : IntervalIntegrable (fun y => ‖F y‖ * ‖F' y‖) volume a b :=
    (hFc.norm.mul hF'.norm).intervalIntegrable _ _
  have hyoung := intervalIntegral.integral_mono_on hab
    (hprodI.const_mul (2 * K)) ((hFI.const_mul (K ^ 2)).add hF'I)
    (fun y _ => show 2 * K * (‖F y‖ * ‖F' y‖) ≤ K ^ 2 * ‖F y‖ ^ 2 + ‖F' y‖ ^ 2 by
      nlinarith [sq_nonneg (K * ‖F y‖ - ‖F' y‖)])
  rw [intervalIntegral.integral_add (hFI.const_mul (K ^ 2)) hF'I,
    intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul] at hyoung
  have hscaled := mul_le_mul_of_nonneg_left henergy (sq_nonneg K)
  have hcross : 2 * (∫ y in a..b, ‖F y‖ * ‖F' y‖) ≤ 2 * K * Q := by
    apply (mul_le_mul_iff_right₀ hK).mp
    nlinarith only [hyoung, hderiv, hscaled]
  calc
    (∑ i ∈ s, ‖F (x i)‖ ^ 2) ≤
        δ⁻¹ * (∫ y in a..b, ‖F y‖ ^ 2) +
          2 * ∫ y in a..b, ‖F y‖ * ‖F' y‖ :=
      separated_samples_norm_sq_le s x hδ hab hleft hright hsep F F' hF hF'
    _ ≤ δ⁻¹ * Q + 2 * K * Q :=
      add_le_add (mul_le_mul_of_nonneg_left henergy (inv_nonneg.mpr hδ.le)) hcross
    _ = (δ⁻¹ + 2 * K) * Q := by ring
end

section

theorem reduced_nat_cross_mul_injective {a b c d : ℕ}
    (hb : 0 < b) (hd : 0 < d) (hab : a.Coprime b) (hcd : c.Coprime d)
    (hcross : a * d = c * b) : a = c ∧ b = d := by
  have hbd : b ∣ d := hab.symm.dvd_of_dvd_mul_left (by rw [hcross]; exact dvd_mul_left b c)
  have hdb : d ∣ b := hcd.symm.dvd_of_dvd_mul_left (by rw [← hcross]; exact dvd_mul_left d a)
  have heq : b = d := Nat.dvd_antisymm hbd hdb
  subst d
  exact ⟨Nat.eq_of_mul_eq_mul_right hb hcross, rfl⟩

theorem nat_fraction_separation {a b c d : ℕ}
    (hb : 0 < b) (hd : 0 < d) (hcross : a * d ≠ c * b) :
    1 / ((b : ℝ) * d) ≤ |(a : ℝ) / b - (c : ℝ) / d| := by
  have hbR : (0 : ℝ) < b := by exact_mod_cast hb
  have hdR : (0 : ℝ) < d := by exact_mod_cast hd
  have hgap : (1 : ℝ) ≤ |(a : ℝ) * d - (c : ℝ) * b| := by
    rcases lt_or_gt_of_ne hcross with h | h
    · have hh : (a : ℝ) * d + 1 ≤ (c : ℝ) * b := by
        exact_mod_cast Nat.succ_le_of_lt h
      rw [abs_of_nonpos (by linarith)]
      linarith
    · have hh : (c : ℝ) * b + 1 ≤ (a : ℝ) * d := by
        exact_mod_cast Nat.succ_le_of_lt h
      rw [abs_of_nonneg (by linarith)]
      linarith
  rw [div_sub_div _ _ hbR.ne' hdR.ne', abs_div, abs_of_pos (mul_pos hbR hdR)]
  simpa only [mul_comm (b : ℝ) (c : ℝ)] using
    div_le_div_of_nonneg_right hgap (mul_pos hbR hdR).le

theorem bounded_reduced_fraction_separation {a b c d : ℕ} {R : ℝ}
    (hb : 0 < b) (hd : 0 < d) (hab : a.Coprime b) (hcd : c.Coprime d)
    (hneq : (a, b) ≠ (c, d)) (hbR : (b : ℝ) ≤ R) (hdR : (d : ℝ) ≤ R) :
    1 / R ^ 2 ≤ |(a : ℝ) / b - (c : ℝ) / d| := by
  have hb0 : (0 : ℝ) < b := by exact_mod_cast hb
  have hd0 : (0 : ℝ) < d := by exact_mod_cast hd
  have hR : 0 < R := hb0.trans_le hbR
  have hcross : a * d ≠ c * b := by
    intro heq
    obtain ⟨h1, h2⟩ := reduced_nat_cross_mul_injective hb hd hab hcd heq
    exact hneq (Prod.ext h1 h2)
  have hbdR : (b : ℝ) * d ≤ R ^ 2 := by
    simpa only [pow_two] using mul_le_mul hbR hdR hd0.le hR.le
  exact (one_div_le_one_div_of_le (mul_pos hb0 hd0) hbdR).trans
    (nat_fraction_separation hb hd hcross)

theorem reduced_fraction_samples_data (s : Finset (ℕ × ℕ)) {R : ℝ}
    (hs : ∀ v ∈ s, 0 < v.2 ∧ v.1 < v.2 ∧ v.1.Coprime v.2 ∧ (v.2 : ℝ) ≤ R) :
    (∀ v ∈ s, (0 : ℝ) ≤ (v.1 : ℝ) / v.2 ∧ (v.1 : ℝ) / v.2 < 1) ∧
      (∀ v ∈ s, ∀ w ∈ s, v ≠ w →
        1 / R ^ 2 ≤ |(v.1 : ℝ) / v.2 - (w.1 : ℝ) / w.2|) := by
  constructor
  · intro v hv
    obtain ⟨hd, ha, _, _⟩ := hs v hv
    refine ⟨by positivity, (div_lt_one (by exact_mod_cast hd)).mpr ?_⟩
    exact_mod_cast ha
  · intro v hv w hw hneq
    obtain ⟨hb, _, hab, hbR⟩ := hs v hv
    obtain ⟨hd, _, hcd, hdR⟩ := hs w hw
    exact bounded_reduced_fraction_separation hb hd hab hcd (by simpa using hneq) hbR hdR
end

section
open Finset MeasureTheory
open scoped ComplexConjugate Real
noncomputable def finiteFourierSum (s : Finset ℤ) (a : ℤ → ℂ) (x : ℝ) : ℂ :=
  ∑ n ∈ s, a n * fourier n (x : AddCircle (1 : ℝ))

noncomputable def finiteFourierDerivative (s : Finset ℤ) (a : ℤ → ℂ) : ℝ → ℂ :=
  finiteFourierSum s (fun n => a n * (2 * Real.pi * Complex.I * n))

theorem continuous_fourier_real (n : ℤ) :
    Continuous (fun x : ℝ => fourier n (x : AddCircle (1 : ℝ))) :=
  continuous_iff_continuousAt.mpr (fun x => (hasDerivAt_fourier 1 n x).continuousAt)

theorem continuous_finiteFourierSum (s : Finset ℤ) (a : ℤ → ℂ) :
    Continuous (finiteFourierSum s a) := by
  apply continuous_finsetSum
  intro n _
  exact continuous_const.mul (continuous_fourier_real n)

theorem continuous_finiteFourierDerivative (s : Finset ℤ) (a : ℤ → ℂ) :
    Continuous (finiteFourierDerivative s a) :=
  continuous_finiteFourierSum s _

theorem hasDerivAt_finiteFourierSum (s : Finset ℤ) (a : ℤ → ℂ) (x : ℝ) :
    HasDerivAt (finiteFourierSum s a) (finiteFourierDerivative s a x) x := by
  have h := HasDerivAt.sum (u := s)
    (fun n _ => (hasDerivAt_fourier 1 n x).const_mul (a n))
  have hf : (∑ n ∈ s, fun y : ℝ => a n * fourier n (y : AddCircle (1 : ℝ))) =
      finiteFourierSum s a := by
    funext y
    simp only [Finset.sum_apply, finiteFourierSum]
  rw [hf] at h
  have hd : (∑ n ∈ s, a n * (2 * Real.pi * Complex.I * n / (1 : ℂ) *
      fourier n (x : AddCircle (1 : ℝ)))) = finiteFourierDerivative s a x := by
    simp only [finiteFourierDerivative, finiteFourierSum, div_one, mul_assoc]
  exact hd ▸ h

theorem finiteFourierSum_periodic (s : Finset ℤ) (a : ℤ → ℂ) :
    Function.Periodic (finiteFourierSum s a) 1 := by
  intro x
  simp only [finiteFourierSum, AddCircle.coe_add_period]

theorem integral_fourier_cross (m n : ℤ) :
    (∫ x in (0 : ℝ)..1, conj (fourier m (x : AddCircle (1 : ℝ))) *
      fourier n (x : AddCircle (1 : ℝ))) = if m = n then 1 else 0 := by
  have h := congrFun (fourierCoeff_fourier (T := (1 : ℝ)) n) m
  rw [fourierCoeff_eq_intervalIntegral (fourier n) m 0] at h
  simpa only [one_div_one, one_smul, zero_add, fourier_neg, smul_eq_mul,
    Pi.single_apply, eq_comm] using h

theorem finiteFourierSum_energy_one (s : Finset ℤ) (a : ℤ → ℂ) :
    (∫ x in (0 : ℝ)..1, ‖finiteFourierSum s a x‖^2) = ∑ n ∈ s, ‖a n‖^2 := by
  have hcont (m n : ℤ) : Continuous (fun x : ℝ =>
      (conj (a m) * a n) * (conj (fourier m (x : AddCircle (1 : ℝ))) *
        fourier n (x : AddCircle (1 : ℝ)))) := by
    exact continuous_const.mul ((continuous_fourier_real m).star.mul (continuous_fourier_real n))
  have hpoint (x : ℝ) : conj (finiteFourierSum s a x) * finiteFourierSum s a x =
      ∑ m ∈ s, ∑ n ∈ s, (conj (a m) * a n) *
        (conj (fourier m (x : AddCircle (1 : ℝ))) * fourier n (x : AddCircle (1 : ℝ))) := by
    simp only [finiteFourierSum, map_sum, map_mul, sum_mul, mul_sum]
    rw [sum_comm]
    apply sum_congr rfl
    intro m _
    apply sum_congr rfl
    intro n _
    ring
  have hc : (∫ x in (0 : ℝ)..1, conj (finiteFourierSum s a x) * finiteFourierSum s a x) =
      ∑ n ∈ s, conj (a n) * a n := by
    simp_rw [hpoint]
    rw [intervalIntegral.integral_finsetSum
      (fun m _ => (continuous_finsetSum s (fun n _ => hcont m n)).intervalIntegrable _ _)]
    apply sum_congr rfl
    intro m hm
    rw [intervalIntegral.integral_finsetSum (fun n _ => (hcont m n).intervalIntegrable _ _)]
    simp_rw [intervalIntegral.integral_const_mul, integral_fourier_cross]
    simp [hm]
  have hnorm (z : ℂ) : conj z * z = ((‖z‖^2 : ℝ) : ℂ) := by
    rw [← Complex.normSq_eq_conj_mul_self, Complex.normSq_eq_norm_sq]
  simp_rw [hnorm] at hc
  rw [intervalIntegral.integral_ofReal] at hc
  exact_mod_cast hc

theorem finiteFourierSum_energy_two (s : Finset ℤ) (a : ℤ → ℂ) :
    (∫ x in (0 : ℝ)..2, ‖finiteFourierSum s a x‖^2) = 2 * ∑ n ∈ s, ‖a n‖^2 := by
  have hp : Function.Periodic (fun x => ‖finiteFourierSum s a x‖^2) 1 :=
    (finiteFourierSum_periodic s a).comp (fun z : ℂ => ‖z‖^2)
  have h := hp.intervalIntegral_add_zsmul_eq (2 : ℤ) 0
    (fun u v => ((continuous_finiteFourierSum s a).norm.pow 2).intervalIntegrable u v)
  norm_num only [zero_add, zsmul_eq_mul, Int.cast_ofNat, mul_one] at h
  rw [h, finiteFourierSum_energy_one]

private theorem finiteFourierDerivative_coefficient_bound
    (s : Finset ℤ) (a : ℤ → ℂ) {N : ℝ} (_hN : 0 ≤ N)
    (hfreq : ∀ n ∈ s, |(n : ℝ)| ≤ N) :
    (∑ n ∈ s, ‖a n * (2 * Real.pi * Complex.I * n)‖^2) ≤
      (2 * Real.pi * N)^2 * ∑ n ∈ s, ‖a n‖^2 := by
  rw [mul_sum]
  apply sum_le_sum
  intro n hn
  have hcoeff : ‖(2 * Real.pi * Complex.I * n : ℂ)‖ = 2 * Real.pi * |(n : ℝ)| := by
    simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos Real.pi_pos, Complex.norm_I, mul_one, Complex.norm_intCast]
    norm_num
  rw [norm_mul, hcoeff, mul_pow]
  have hmono : (2 * Real.pi * |(n : ℝ)|)^2 ≤ (2 * Real.pi * N)^2 :=
    pow_le_pow_left₀ (by positivity)
      (mul_le_mul_of_nonneg_left (hfreq n hn) (by positivity)) 2
  nlinarith [mul_le_mul_of_nonneg_left hmono (sq_nonneg ‖a n‖)]

theorem finiteFourierDerivative_energy_one_le
    (s : Finset ℤ) (a : ℤ → ℂ) {N : ℝ} (hN : 0 ≤ N)
    (hfreq : ∀ n ∈ s, |(n : ℝ)| ≤ N) :
    (∫ x in (0 : ℝ)..1, ‖finiteFourierDerivative s a x‖^2) ≤
      (2 * Real.pi * N)^2 * ∑ n ∈ s, ‖a n‖^2 := by
  rw [finiteFourierDerivative, finiteFourierSum_energy_one]
  exact finiteFourierDerivative_coefficient_bound s a hN hfreq

theorem finiteFourierDerivative_energy_two_le
    (s : Finset ℤ) (a : ℤ → ℂ) {N : ℝ} (hN : 0 ≤ N)
    (hfreq : ∀ n ∈ s, |(n : ℝ)| ≤ N) :
    (∫ x in (0 : ℝ)..2, ‖finiteFourierDerivative s a x‖^2) ≤
      (2 * Real.pi * N)^2 * (2 * ∑ n ∈ s, ‖a n‖^2) := by
  rw [finiteFourierDerivative, finiteFourierSum_energy_two]
  have h := mul_le_mul_of_nonneg_left (finiteFourierDerivative_coefficient_bound s a hN hfreq)
    (by norm_num : (0 : ℝ) ≤ 2)
  nlinarith
end

section
open Finset ZMod
theorem primitive_gaussSum_mul_star {q : ℕ} [NeZero q]
    {χ : DirichletCharacter ℂ q} (hχ : χ.IsPrimitive) :
    gaussSum χ ZMod.stdAddChar * star (gaussSum χ ZMod.stdAddChar) = (q : ℂ) := by
  have hs : (∑ a : ZMod q, ZMod.stdAddChar a * χ⁻¹ (-a)) =
      gaussSum χ⁻¹ (ZMod.stdAddChar)⁻¹ := by
    rw [gaussSum]
    apply Fintype.sum_equiv (Equiv.neg (ZMod q))
    intro a
    simp only [Equiv.neg_apply, AddChar.inv_apply, neg_neg, mul_comm]
  have hh := congrFun (ZMod.dft_dft (χ : ZMod q → ℂ)) (-1)
  rw [ZMod.dft_apply] at hh
  simp only [hχ.fourierTransform_eq_inv_mul_gaussSum, mul_neg_one, neg_neg,
    smul_eq_mul, map_one] at hh
  simp_rw [← mul_assoc] at hh
  rw [← sum_mul, hs, ← star_gaussSum_eq] at hh
  simpa only [mul_comm, mul_one] using hh

theorem primitive_gaussSum_norm_sq {q : ℕ} [NeZero q]
    {χ : DirichletCharacter ℂ q} (hχ : χ.IsPrimitive) :
    ‖gaussSum χ ZMod.stdAddChar‖ ^ 2 = (q : ℝ) := by
  have h := congrArg Complex.re (primitive_gaussSum_mul_star hχ)
  simpa only [Complex.star_def, Complex.mul_conj, Complex.ofReal_re, Complex.natCast_re,
    Complex.sq_norm] using h
end

section
open scoped BigOperators Classical
noncomputable def minorProductPhase (ζ α : ℝ) (p q : ℕ) : ℂ :=
  Complex.exp (Complex.I * (ζ * Real.log ((p : ℝ) * q) +
    2 * Real.pi * (α * ((p : ℝ) * q)) : ℝ))

theorem minor_product_phase_factor (ζ α : ℝ) {p q : ℕ} (hp : 0 < p) (hq : 0 < q) :
    minorProductPhase ζ α p q =
      Complex.exp ((ζ * Real.log (p : ℝ) : ℝ) * Complex.I) *
      Complex.exp ((ζ * Real.log (q : ℝ) : ℝ) * Complex.I) *
      (Complex.exp (Complex.I * (2 * Real.pi * (α * q) : ℝ))) ^ p := by
  unfold minorProductPhase
  rw [← Complex.exp_nat_mul, ← Complex.exp_add, ← Complex.exp_add,
    Real.log_mul (by exact_mod_cast Nat.ne_of_gt hp) (by exact_mod_cast Nat.ne_of_gt hq)]
  congr 1
  push_cast
  ring

theorem minor_product_phase_dyadic_bound
    {X Y : Type*} [Fintype X] [Fintype Y]
    (π : X → ℕ) (τ : Y → ℕ) (hπ : ∀ x, 0 < π x) (hτ : ∀ y, 0 < τ y)
    (U V : ℕ) (hU : 0 < U) (hV : 0 < V)
    (μ : X → ℝ) (ν : Y → ℝ) (hμ : ∀ x, 0 ≤ μ x) (hν : ∀ y, 0 ≤ ν y)
    (f : X → ℂ) (g : Y → ℂ)
    (hf : ∀ x, f x ≠ 0 → U ≤ π x ∧ π x < 2 * U)
    (hg : ∀ y, g y ≠ 0 → V ≤ τ y ∧ τ y < 2 * V)
    {C D : ℝ} (hC : 0 ≤ C) (hD : 0 ≤ D)
    (hμatom : ∀ m : ℕ,
      (∑ x ∈ Finset.univ.filter (fun x => π x = m), μ x) ≤ C / (m : ℝ))
    (hνatom : ∀ m : ℕ,
      (∑ y ∈ Finset.univ.filter (fun y => τ y = m), ν y) ≤ D / (m : ℝ))
    {u : ℤ} {r : ℕ} (hr : 0 < r) (hcop : (r : ℤ).gcd u = 1)
    {β : ℝ} (hβ : |β| ≤ 1 / (r : ℝ) ^ 2) (ζ : ℝ) :
    ‖∑ x, ∑ y, ((μ x : ℂ) * f x) * ((ν y : ℂ) * g y) *
      minorProductPhase ζ ((u : ℝ) / r + β) (π x) (τ y)‖ ^ 2 ≤
      6 * C * D * (1 + Real.log r) *
        (1 / (r : ℝ) + 1 / (U : ℝ) + 1 / (V : ℝ) + (r : ℝ) / ((U : ℝ) * V)) *
        (∑ x, μ x * ‖f x‖ ^ 2) * ∑ y, ν y * ‖g y‖ ^ 2 := by
  let χ := fun x => Complex.exp ((ζ * Real.log (π x : ℝ) : ℝ) * Complex.I)
  let ψ := fun y => Complex.exp ((ζ * Real.log (τ y : ℝ) : ℝ) * Complex.I)
  have hχ : ∀ x, ‖χ x‖ = 1 := fun x => real_mellin_factor_norm ζ (π x)
  have hψ : ∀ y, ‖ψ y‖ = 1 := fun y => real_mellin_factor_norm ζ (τ y)
  have hb := supported_weighted_product_dyadic_clean_bound π τ U V hU hV μ ν hμ hν
    (fun x => χ x * f x) (fun y => ψ y * g y)
    (fun x hx => hf x ((unit_test_modulation_ne_zero_iff χ f hχ x).mp hx))
    (fun y hy => hg y ((unit_test_modulation_ne_zero_iff ψ g hψ y).mp hy))
    hC hD hμatom hνatom hr hcop hβ
  rw [unit_test_modulation_energy μ χ f hχ, unit_test_modulation_energy ν ψ g hψ] at hb
  convert hb using 2
  congr 1
  apply Finset.sum_congr rfl
  intro x _
  apply Finset.sum_congr rfl
  intro y _
  rw [minor_product_phase_factor ζ _ (hπ x) (hτ y)]
  dsimp only [χ, ψ]
  ring
end

