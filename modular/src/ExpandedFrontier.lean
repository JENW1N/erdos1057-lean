/- The original root scalar is the exact effective-path sum over small plans and both initial mark lists. -/

open Finset Classical
namespace Bounty
section Sum
variable {I : Type} {N M J ell n B : ℕ} {P : Fin N → Finset ℕ}
  [∀ z : PhysicalPrime P, NeZero z.2.val]
  (groups : Finset (Fin N)) (e : {g // g ∉ groupsᶜ} ≃ Fin M)
  (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
  (hC : ∀ i : patterns, ∀ g : ↥groupsᶜ, C i.val g.val = ∅)
  (V : Fin N → ℝ) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
  (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
    PhysicalAuxLabels P (C i) → ℂ)
  (r : PhysicalGroupResidues P groupsᶜ) (θ : ℝ)

theorem physical_root_small_plan_effective_sum
    (hP : ∀ g a, a ∈ P g → Nat.Prime a)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hk : ∀ t < n + 1, ∀ i ∈ patterns, ∀ g a, a ∈ P g → ¬ (a : ℤ) ∣ k t i)
    (β : PhysicalPrime P → ℝ) (ρ : ℝ)
    (hV : ∀ g, V g ≠ 0) (hρ : ρ ≠ 0)
    (hB : (physicalPrimeGroups P groups).card ≤ B) (hq : 0 ≤ q) :
  let _ := physicalMixedSmallPlanFintype (Ps := (fun s : ↥groupsᶜ => P s.val))
    (J := J) (ell := ell) (I := patterns) ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1)))
  physicalRootSmallPlanSum (n := n) groups patterns C hC V q ζ k K β B r θ =
  (physicalStateMass (fun s : ↥groupsᶜ => V s.val) J ell : ℂ) *
  ∑ Ls : PhysicalMarkLists (fun s : ↥groupsᶜ => P s.val) J ell,
    ∑ Lb : PhysicalMarkLists (fun g => P (e.symm g).val) J ell,
      ((∏ g, ∏ s : PhysicalSlots J ell,
        β ⟨(e.symm g).val, Lb g s⟩ / V (e.symm g).val : ℝ) : ℂ) *
      ∑ sp : PhysicalMixedSmallPlan (Ps := (fun s : ↥groupsᶜ => P s.val)) (J := J) (ell := ell) (I := patterns) ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1))),
        physicalRootEffectivePathSum groups e patterns C hC k (Ls, sp) V q ζ K r θ
        (fun (g : Fin M) (z : P (e.symm g).val) => β ⟨(e.symm g).val, z⟩) (fun j => physicalEndpointSchedule q (n + 1) j.val) ρ
        fullMemoryVacuum (physicalFullMemoryState (fun _ => ∅) Lb
          (fun g => fullEmptyBoundedMemory (UnrestrictedResidueParticle (fun z : P (e.symm g).val => z.val)) B)) := by
  let _ := physicalMixedSmallPlanFintype (Ps := (fun s : ↥groupsᶜ => P s.val))
    (J := J) (ell := ell) (I := patterns) ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1)))
  let _ : ∀ p : PhysicalRootSmallPlan (P := P) (J := J) (ell := ell) (n := n) groups patterns, Fintype (PhysicalRootSmallPlanBigData groups patterns C hC p) :=
    fun p => physicalGroupSelectedDataFintype
      (P := fun g : {g // g ∉ groupsᶜ} => P g.val)
      (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val g.val)
  let _ : ∀ p : PhysicalRootSmallPlan (P := P) (J := J) (ell := ell) (n := n) groups patterns, Fintype (PhysicalSelectedData (fun g => P (e.symm g).val) ell
      (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val)) :=
    fun p => physicalSelectedDataFintype
      (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val)
  have hf : ∀ p : PhysicalRootSmallPlan (P := P) (J := J) (ell := ell) (n := n) groups patterns,
      (∑ db : PhysicalRootSmallPlanBigData groups patterns C hC p,
        physicalRootSmallPlanIntegrand groups patterns C hC V q ζ k K β B r θ p db) =
      (physicalStateMass (fun s : ↥groupsᶜ => V s.val) J ell : ℂ) * ∑ Lb : PhysicalMarkLists (fun g => P (e.symm g).val) J ell,
        ((∏ g, ∏ s : PhysicalSlots J ell,
        β ⟨(e.symm g).val, Lb g s⟩ / V (e.symm g).val : ℝ) : ℂ) * physicalRootEffectivePathSum groups e patterns C hC k p V q ζ K r θ
        (fun (g : Fin M) (z : P (e.symm g).val) => β ⟨(e.symm g).val, z⟩) (fun j => physicalEndpointSchedule q (n + 1) j.val) ρ
        fullMemoryVacuum (physicalFullMemoryState (fun _ => ∅) Lb
          (fun g => fullEmptyBoundedMemory (UnrestrictedResidueParticle (fun z : P (e.symm g).val => z.val)) B)) := by
    intro p
    exact physical_root_integrand_sum_eq_effective_empty_cut groups e patterns C hC V q ζ k K r θ p
      hP hdis hk β ρ hV hρ hB hq
  rw [physical_root_small_plan_sigma]
  simp_rw [hf]
  rw [← Finset.mul_sum, Fintype.sum_prod_type]
  congr 1
  apply sum_congr rfl
  intro Ls _
  rw [Finset.sum_comm]
  apply sum_congr rfl
  intro Lb _
  rw [Finset.mul_sum]

end Sum
end Bounty
end

section

/- The actual mixed small factor separates without changing the root history or coefficient phase. -/

open scoped Classical
namespace Bounty
section Factor
variable {I : Type} {N M J ell n B : ℕ} {P : Fin N → Finset ℕ}
  [∀ z : PhysicalPrime P, NeZero z.2.val]
  (groups : Finset (Fin N)) (e : {g // g ∉ groupsᶜ} ≃ Fin M)
  (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
  (hC : ∀ i : patterns, ∀ g : ↥groupsᶜ, C i.val g.val = ∅)
  (k : ℕ → I → ℤ)
  (pl : PhysicalRootSmallPlan (P := P) (J := J) (ell := ell) (n := n) groups patterns)
  (V : Fin N → ℝ) (q : ℝ) (ζ : ℕ → I → ℝ)
  (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
    PhysicalAuxLabels P (C i) → ℂ)
  (r : PhysicalGroupResidues P groupsᶜ) (θ : ℝ)
  (β : (g : Fin M) → P (e.symm g).val → ℝ)
  (retention : Fin (n + 2) → ℝ) (ρ : ℝ)

  (hPs : ∀ (s : ↥groupsᶜ) p, p ∈ P s.val → Nat.Prime p)
  (hPb : ∀ (g : Fin M) p, p ∈ P (e.symm g).val → Nat.Prime p)
  (hdis : ∀ (s : ↥groupsᶜ) (g : Fin M), Disjoint (P s.val) (P (e.symm g).val))

noncomputable def physicalRootPlannedRemainder
    (x : PhysicalFullBoundedState (fun g => P (e.symm g).val) J ell B)
    (path : PhysicalRootPlannedPath groups e patterns C k pl x) : ℂ :=
  physicalRootEffectiveRemainder groups e patterns C hC k pl V ζ K θ β ρ x
    (physicalRootPlannedEffectiveEquiv groups e patterns C k hPs hPb hdis pl x path)

omit [∀ z : PhysicalPrime P, NeZero z.2.val] in
theorem physical_root_planned_phase_factor
    (x : PhysicalFullBoundedState (fun g => P (e.symm g).val) J ell B)
    (path : PhysicalRootPlannedPath groups e patterns C k pl x) :
    physicalRootEffectivePhase groups e patterns C hC k pl V q ζ K r θ β ρ x
      (physicalRootPlannedEffectiveEquiv groups e patterns C k hPs hPb hdis pl x path) =
    (physicalMixedPlanSmallFactor (fun g (p : P (e.symm g).val) => p.val)
      (fun (i : patterns) g => physicalFullSharedIndices (ell := ell) (C i.val (e.symm g).val)) B
      (fun (i : patterns) => PhysicalAuxLabels (fun g => P (e.symm g).val) (fun g => C i.val (e.symm g).val))
      (fun (j : Fin (n + 1)) (i : patterns) => physicalMixedEdgeDelta (fun g => C i.val (e.symm g).val) (k (n - j.val) i.val))
      (fun (_ : Fin (n + 1)) (i : patterns) => physicalMixedEdgeD (fun g => C i.val (e.symm g).val))
      (fun (j : Fin (n + 1)) (i : patterns) => physicalMixedBigStep (fun g => C i.val (e.symm g).val) (k (n - j.val) i.val))
      (fun s : ↥groupsᶜ => V s.val) (fun _ => q) ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1)))
      (physicalGroupResidueVector r) pl.1 pl.2 x path : ℂ) *
    physicalRootPlannedRemainder groups e patterns C hC k pl V ζ K θ β ρ hPs hPb hdis x path := by
  have h := physical_mixed_plan_small_factor_effective (fun (i : patterns) g => C i.val (e.symm g).val) (fun (j : Fin (n + 1)) (i : patterns) => k (n - j.val) i.val) B hPs hPb hdis
    (fun s : ↥groupsᶜ => V s.val) (fun _ => q) ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1)))
    (physicalGroupResidueVector r) pl.1 pl.2 x path
  rw [physical_root_effective_phase_factor]
  exact congrArg (fun z : ℂ => z * physicalRootPlannedRemainder groups e patterns C hC k pl V ζ K θ β ρ hPs hPb hdis x path) h.symm

end Factor
end Bounty
end

