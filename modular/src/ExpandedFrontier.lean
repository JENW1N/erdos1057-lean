/- Finite component thresholds with the fixed slot chosen before precision. -/

open Filter
namespace Bounty

theorem finite_fixed_slot_component_thresholds {ι : Type*} [Finite ι]
    (P : ι → ℝ → ℕ → ℝ → Prop)
    (hP : ∀ i, ∃ J : ℕ, ∀ j : ℕ, J < j → ∃ S₀ : ℝ, 0 ≤ S₀ ∧
      ∀ S : ℝ, S₀ ≤ S → ∀ᶠ L : ℝ in atTop, P i S j L) :
    ∃ J : ℕ, ∀ j : ℕ, J < j → ∃ S₀ : ℝ, 0 ≤ S₀ ∧
      ∀ S : ℝ, S₀ ≤ S → ∀ᶠ L : ℝ in atTop, ∀ i, P i S j L := by
  choose js h using hP
  obtain ⟨J, hJ⟩ := Finite.exists_le js
  refine ⟨J, ?_⟩
  intro j hj
  have hall (i : ι) := h i j ((hJ i).trans_lt hj)
  choose s hs hbound using hall
  obtain ⟨S₁, hS₁⟩ := Finite.exists_le s
  refine ⟨max 0 S₁, le_max_left _ _, ?_⟩
  intro S hS
  exact Filter.eventually_all.mpr (fun i =>
    hbound i S ((hS₁ i).trans ((le_max_right _ _).trans hS)))

end Bounty
end

