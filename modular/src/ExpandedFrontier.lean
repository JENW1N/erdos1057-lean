open Finset Filter
open scoped Topology
theorem candidate_Q_weight_le_roughDivisors_of_present {c L : ℝ} {r jStar : ℕ}
    (hcL : 0 ≤ c * L) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (hband : (candidateQBand (c * L) jStar).Nonempty)
    {n : ℕ} (hn : n ≠ 0) :
    candidateQWeight c L r jStar n ≤
      ((roughDivisors (Real.exp (Real.sqrt L)) n).card : ℝ) := by
  classical
  obtain ⟨q0, hq0⟩ := hband
  let P := fun j : candidateQIndices c L => candidateQBand (c * L) j.val
  let R := candidateRoughBand c L jStar
  let e := candidateRoughSlot c L r jStar hr hj
  have heq : candidateQSlotChoices c L r jStar = oneExceptionPrimeChoices P R e := by
    exact candidate_Q_choices_eq_single_rough c L r jStar hr hj
  have h := one_exception_ordered_slot_weight_le P R r e
    (fun _ _ hp => (mem_filter.mp hp).2) (candidate_Q_group_disjoint hcL)
    (fun _ hd => (roughBand_pos hd).ne') q0 hq0 n
  rw [candidateQWeight, heq]
  have h' : orderedSlotWeight (oneExceptionPrimeChoices P R e)
      ((r.factorial : ℝ)^(candidateQIndices c L).card) n ≤
        ((R.filter (fun d => d ∣ n)).card : ℝ) := by
    simpa only [Fintype.card_coe] using h
  refine h'.trans ?_
  exact Nat.cast_le.mpr (roughBand_divisor_filter_card_le hn)

theorem eventually_candidate_Q_weight_le_roughDivisors {c : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) :
    ∀ᶠ L : ℝ in atTop, ∀ jStar n : ℕ,
      candidateQWeight c L r jStar n ≤ ((roughDivisors (Real.exp (Real.sqrt L)) n).card : ℝ) := by
  filter_upwards [eventually_candidateQBand_nonempty hc, eventually_ge_atTop (0 : ℝ)] with L hb hL
  intro jStar n
  by_cases hn : n = 0
  · subst n
    rw [candidate_Q_weight_zero_at_zero]
    positivity
  · by_cases hj : jStar ∈ candidateQIndices c L
    · exact candidate_Q_weight_le_roughDivisors_of_present (mul_nonneg hc.le hL) hr hj (hb jStar hj) hn
    · exact (candidate_Q_weight_le_one_of_rough_absent (mul_nonneg hc.le hL) hj n).trans
        (by exact_mod_cast one_le_roughDivisors_card (Real.exp (Real.sqrt L)) hn)

theorem eventually_candidate_Q_weight_le_divisors {c : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) :
    ∀ᶠ L : ℝ in atTop, ∀ jStar n : ℕ,
      candidateQWeight c L r jStar n ≤ (n.divisors.card : ℝ) := by
  filter_upwards [eventually_candidate_Q_weight_le_roughDivisors hc hr] with L hL
  intro jStar n
  refine (hL jStar n).trans ?_
  exact_mod_cast card_filter_le n.divisors (fun d => ∀ p ∈ d.primeFactors, Real.exp (Real.sqrt L) ≤ (p : ℝ))

theorem wide_window_nat_le_exp_twice {L : ℝ} (hL : Real.log 16 ≤ L)
    {n : ℕ} (hn : (n : ℝ) ≤ 16 * Real.exp L) : (n : ℝ) ≤ Real.exp (2 * L) := by
  have h16 : (16 : ℝ) ≤ Real.exp L :=
    (Real.log_le_iff_le_exp (by norm_num : (0 : ℝ) < 16)).mp hL
  calc
    _ ≤ 16 * Real.exp L := hn
    _ ≤ Real.exp L * Real.exp L := mul_le_mul_of_nonneg_right h16 (Real.exp_pos _).le
    _ = Real.exp (2 * L) := by rw [← Real.exp_add]; congr 1; ring

theorem eventually_candidate_Q_weight_le_exp_sqrt {c : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) :
    ∀ᶠ L : ℝ in atTop, ∀ jStar n : ℕ, (n : ℝ) ≤ 16 * Real.exp L →
      candidateQWeight c L r jStar n ≤ Real.exp ((2 * Real.log 2) * Real.sqrt L) := by
  filter_upwards [eventually_candidate_Q_weight_le_roughDivisors hc hr,
    eventually_ge_atTop (Real.log 16), eventually_gt_atTop (0 : ℝ)] with L hq hlarge hL
  intro jStar n hn
  by_cases hn0 : n = 0
  · subst n
    rw [candidate_Q_weight_zero_at_zero]
    exact (Real.exp_pos _).le
  · exact (hq jStar n).trans (roughDivisors_card_le_exp_sqrt hL hn0 (wide_window_nat_le_exp_twice hlarge hn))
end

section
open Finset
open scoped Classical
section PhysicalPath
variable {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell n : ℕ}
  (C : Fin n → G → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (x : Fin (n + 1) → PhysicalState P J ell)
  (hadm : ∀ j : Fin n, physicalAdmissible (C j) (aux j) (k j) (x j.castSucc) (x j.succ))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (g : G)
  (hk : ∀ j : Fin n, ∀ s, ¬ (((x j.castSucc).2.val g s).val : ℤ) ∣ k j)
  (β : ↥(P g) → ℝ) (η : Fin (n + 1) → ℝ) (V ρ : ℝ) (hV : V ≠ 0) (cap : ℕ)

/-- The activity at each actual vertex of the finite physical path. -/
def physicalGroupFiniteActivity (j : Fin (n + 1)) : ↥(P g) → Bool :=
  physicalGroupPhaseActivity (x j).2.val g

/-- All visits use the zero hit in their own moving frame. -/
noncomputable def physicalGroupFiniteVisit (j : Fin (n + 1)) :
    GlobalBirthRawStep (R := fun p : ↥(P g) => ZMod p.val)
      (physicalGroupFiniteActivity x g j) (physicalGroupFiniteActivity x g j) :=
  physicalGroupRawVisit (x j).2.val g β (η j) V ρ hV cap

/-- Each actual edge uses its physical positions and unshared slot lists. -/
noncomputable def physicalGroupFiniteEdge (j : Fin n) :
    GlobalBirthRawStep (R := fun p : ↥(P g) => ZMod p.val)
      (physicalGroupFiniteActivity x g j.castSucc) (physicalGroupFiniteActivity x g j.succ) :=
  physicalGroupRawEdge (C j) (aux j) (k j) (hadm j) hP hdis g (hk j) β ρ V cap

/-- The extended atomic activity is used only through cut 2*n+1. -/
def physicalGroupAtomicActivity (i : ℕ) : ↥(P g) → Bool :=
  globalBirthFiniteActivity (physicalGroupFiniteActivity x g) (i / 2)

/-- Interleave n+1 physical visits with precisely n physical edges. -/
noncomputable def physicalGroupFiniteStep (i : ℕ) :
    GlobalBirthRawStep (R := fun p : ↥(P g) => ZMod p.val)
      (physicalGroupAtomicActivity x g i) (physicalGroupAtomicActivity x g (i + 1)) :=
  globalBirthFiniteAlternatingStep (physicalGroupFiniteActivity x g)
    (physicalGroupFiniteVisit x g β η V ρ hV cap)
    (physicalGroupFiniteEdge C aux k x hadm hP hdis g hk β V ρ cap) i

omit [Fintype G] in
theorem physical_group_atomic_activity_initial :
    physicalGroupAtomicActivity x g 0 = physicalGroupPhaseActivity (x 0).2.val g := by
  simpa only [physicalGroupAtomicActivity, Nat.zero_div, physicalGroupFiniteActivity, Fin.val_zero] using
    (global_birth_finite_activity_at (physicalGroupFiniteActivity x g) (0 : Fin (n + 1)))

omit [Fintype G] in
theorem physical_group_atomic_activity_terminal :
    physicalGroupAtomicActivity x g (2 * n + 1) =
      physicalGroupPhaseActivity (x (Fin.last n)).2.val g := by
  unfold physicalGroupAtomicActivity
  rw [show (2 * n + 1) / 2 = n by omega]
  exact global_birth_finite_activity_tail (physicalGroupFiniteActivity x g) n le_rfl

theorem physical_group_finite_visit_row (j : Fin (n + 1))
    (F : Finset ↥(P g) → FiniteOrderedTuple (Σ p : ↥(P g), ZMod p.val) → ℂ)
    (H : Finset ↥(P g)) (q : FiniteOrderedTuple (Σ p : ↥(P g), ZMod p.val)) :
    globalBirthRawStepRow
      (physicalGroupFiniteStep C aux k x hadm hP hdis g hk β η V ρ hV cap (2 * j.val)) F H q =
      globalBirthGhostVisitRawRow (fun _ => 0) β (η j) V ρ cap H q.2 F := by
  exact global_birth_finite_alternating_row_even (physicalGroupFiniteActivity x g)
    (physicalGroupFiniteVisit x g β η V ρ hV cap)
    (physicalGroupFiniteEdge C aux k x hadm hP hdis g hk β V ρ cap) j F H q

theorem physical_group_finite_edge_row (j : Fin n)
    (F : Finset ↥(P g) → FiniteOrderedTuple (Σ p : ↥(P g), ZMod p.val) → ℂ)
    (H : Finset ↥(P g)) (q : FiniteOrderedTuple (Σ p : ↥(P g), ZMod p.val)) :
    globalBirthRawStepRow
      (physicalGroupFiniteStep C aux k x hadm hP hdis g hk β η V ρ hV cap (2 * j.val + 1)) F H q =
      globalBirthEdgeRawRow (physicalGroupUnsharedEmbedding (C j) (x j.castSucc).2.val g)
        (physicalGroupUnsharedEmbedding (C j) (x j.succ).2.val g)
        (physicalGroupPhaseDelta (x j.castSucc).1 (x j.succ).1 g) H q.2
        (globalBirthRawHitIndices (physicalGroupPhaseDelta (x j.castSucc).1 (x j.succ).1 g) q)
        β ρ V cap F := by
  exact global_birth_finite_alternating_row_odd (physicalGroupFiniteActivity x g)
    (physicalGroupFiniteVisit x g β η V ρ hV cap)
    (physicalGroupFiniteEdge C aux k x hadm hP hdis g hk β V ρ cap) j F H q

variable [∀ p : ↥(P g), NeZero p.val]

/-- The literal finite physical-group memory history starts with no pending
memory and ends with the same condition, retaining its full born ledger. -/
noncomputable def physicalGroupFiniteRawHistory : ℂ :=
  globalBirthRawHistory (physicalGroupAtomicActivity x g)
    (physicalGroupFiniteStep C aux k x hadm hP hdis g hk β η V ρ hV cap) (2 * n + 1)
    (fun _ q => if q.1 = 0 then 1 else 0)
    (ghostPhaseActivitySupport (physicalGroupAtomicActivity x g 0))
    (globalBirthEmptyMemory (R := fun p : ↥(P g) => ZMod p.val))

/-- Exact full trace of a finite physical path. Source/target slot equations,
shared residue compatibility and the visit-edge schedule are now supplied by
physical data; they are not separate phase-history hypotheses. -/
theorem physical_group_finite_raw_history_trace :
    ((∏ p, if physicalGroupAtomicActivity x g 0 p then β p else 1 : ℝ) : ℂ) *
      physicalGroupFiniteRawHistory C aux k x hadm hP hdis g hk β η V ρ hV cap =
    ∑ z : Fin (2 * n + 2) → (p : ↥(P g)) → GhostPhaseState (ZMod p.val),
      ((∏ p, ghostPhaseTerminal (physicalGroupAtomicActivity x g (2 * n + 1) p)
        (z (Fin.last (2 * n + 1)) p) : ℝ) : ℂ) *
      (((∏ p, ghostPhaseInitial (physicalGroupAtomicActivity x g 0 p) (β p) (z 0 p) : ℝ) : ℂ) *
        ∏ j : Fin (2 * n + 1), globalBirthRawStepKernel
          (physicalGroupFiniteStep C aux k x hadm hP hdis g hk β η V ρ hV cap j.val)
          (z j.succ) (z j.castSucc)) :=
  global_birth_weighted_empty_history_product (physicalGroupAtomicActivity x g)
    (physicalGroupFiniteStep C aux k x hadm hP hdis g hk β η V ρ hV cap) β (2 * n + 1)

end PhysicalPath
end

