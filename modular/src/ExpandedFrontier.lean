section

/- The original invariant triple endpoints satisfy the required shared dilation identity. -/

open Finset
namespace Bounty

theorem physical_invariant_endpoint_shared_scale
    {G : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (hprime : ∀ g p, p ∈ P g → p.Prime)
    (α β γ : ℕ → ℂ) (L : PhysicalMarkLists P J ell) (w : ℤ) :
    invariantTripleEndpoint (univ.biUnion P) α β γ
      ((physicalSharedFactor C L : ℤ) * w).natAbs =
    invariantTripleEndpoint (univ.biUnion P) α β γ w.natAbs := by
  simpa only [Int.natAbs_mul, Int.natAbs_natCast] using
    invariant_triple_endpoint_mul_supported (physical_shared_factor_supported C L hprime)
      α β γ w.natAbs

