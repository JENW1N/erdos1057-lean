+import Mathlib.LinearAlgebra.Matrix.StdBasis
+import Mathlib.Basic.Complex.Basic
+import Mathlib.Algebra.Field.ZMod
+import Mathlib.RingTheory.Nullstellensatz
+import Mathlib.Analysis.SpecialFunctions.Pow.Real
+import Mathlib.Data.Fintype.Powerset
+import Mathlib.Data.Fintype.Pi
+import Mathlib.Data.Finset.Lattice.Fold
+import Mathlib.Algebra.BigOperators.Group.Finset.Powerset
+import Mathlib.Tactic.NormNum
+import Mathlib.Tactic.Linarith
+import Mathlib.Tactic.Tauto
+import Mathlib.Tactic.FinCases
+
+/-!
+# Statements 16–21: matrix multiplication and Boolean complexity
+
+These are proposition-valued definitions, not assertions that the open targets hold.
+Matrix products are exact unless `zariskiClosure` is explicitly used. Boolean inputs
+are total functions on the finite cube, and polynomial degree is real multilinear
+degree. See `MATRIX_BOOLEAN.md` for sources, quantifiers, and verification scope.
+-/
+
+open scoped BigOperators
+
+noncomputable section
+
+namespace Math30
+namespace MatrixBoolean
+
+abbrev SquareMatrix (K : Type*) (n : ℕ) := Matrix (Fin n) (Fin n) K
+
+/-- An exact bilinear algorithm with `r` scalar products. Zero terms are allowed,
+so existence with `r` products means "at most `r`". -/
+def HasBilinearAlgorithm (K : Type*) [Field K] (n r : ℕ) : Prop :=
+  ∃ (left right : Fin r → SquareMatrix K n →ₗ[K] K)
+    (output : Fin r → SquareMatrix K n),
+    ∀ A B : SquareMatrix K n,
+      A * B = ∑ t : Fin r, (left t A * right t B) • output t
+
+/-- Zero products can be appended without changing any matrix output. -/
+theorem hasBilinearAlgorithm_pad {K : Type*} [Field K] {n r : ℕ}
+    (h : HasBilinearAlgorithm K n r) (k : ℕ) : HasBilinearAlgorithm K n (r + k) := by
+  rcases h with ⟨a, b, c, habc⟩
+  refine ⟨Fin.addCases a (fun _ => 0), Fin.addCases b (fun _ => 0),
+    Fin.addCases c (fun _ => 0), ?_⟩
+  intro A B
+  simpa [Fin.sum_univ_add] using habc A B
+
+ theorem hasBilinearAlgorithm_mono {K : Type*} [Field K] {n r s : ℕ}
+    (hrs : r ≤ s) (h : HasBilinearAlgorithm K n r) : HasBilinearAlgorithm K n s := by
+  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hrs
+  exact hasBilinearAlgorithm_pad h k
+
+ theorem hasBilinearAlgorithm_iff_at_most {K : Type*} [Field K] (n s : ℕ) :
+    HasBilinearAlgorithm K n s ↔ ∃ r ≤ s, HasBilinearAlgorithm K n r := by
+  constructor
+  · intro h
+    exact ⟨s, le_rfl, h⟩
+  · rintro ⟨r, hrs, h⟩
+    exact hasBilinearAlgorithm_mono hrs h
+
+/-- 16. A complex 4-by-4 multiplication algorithm using at most 47 products. -/
+def Statement16 : Prop := HasBilinearAlgorithm ℂ 4 47
+
+/-- 17. Exact bilinear rank 23 over the two-element field. -/
+def Statement17 : Prop :=
+  HasBilinearAlgorithm (ZMod 2) 3 23 ∧
+  ∀ r : ℕ, r < 23 → ¬ HasBilinearAlgorithm (ZMod 2) 3 r
+
+/-- A verified 22-product construction would refute target 17. -/
+theorem products22_refute_statement17
+    (h : HasBilinearAlgorithm (ZMod 2) 3 22) : ¬ Statement17 := by
+  intro hs
+  exact hs.2 22 (by norm_num) h
+
+abbrev MatrixIndex (n : ℕ) := Fin n × Fin n
+abbrev TensorIndex (n : ℕ) := MatrixIndex n × MatrixIndex n × MatrixIndex n
+abbrev CoordinateTensor (n : ℕ) := TensorIndex n → ℂ
+
+/-- Structure constants of ordinary square matrix multiplication, in the standard
+matrix-unit bases: left `(i,j)`, right `(k,l)`, output `(a,b)`. -/
+def multiplicationTensor (n : ℕ) : CoordinateTensor n := fun q =>
+  if q.1.2 = q.2.1.1 ∧ q.1.1 = q.2.2.1 ∧ q.2.1.2 = q.2.2.2 then 1 else 0
+
+/-- Contract tensor coefficients with the entries of two input matrices. -/
+noncomputable def contractTensor {n : ℕ} (T : CoordinateTensor n)
+    (A B : SquareMatrix ℂ n) : SquareMatrix ℂ n := fun i j =>
+  ∑ a : MatrixIndex n, ∑ b : MatrixIndex n,
+    T (a, b, (i, j)) * A a.1 a.2 * B b.1 b.2
+
+/-- The coordinate tensor used for border rank represents exactly the usual
+matrix product, so its indexing convention is checked rather than assumed. -/
+theorem contract_multiplicationTensor {n : ℕ} (A B : SquareMatrix ℂ n) :
+    contractTensor (multiplicationTensor n) A B = A * B := by
+  ext i j
+  simp [contractTensor, multiplicationTensor, Fintype.sum_prod_type,
+    Matrix.mul_apply, ite_and, ite_mul, and_left_comm]
+
+/-- Concrete rank-at-most locus in affine tensor-coordinate space. Every summand
+is decomposable; zero vectors permit padding shorter decompositions. -/
+def TensorRankAtMost (n r : ℕ) (T : CoordinateTensor n) : Prop :=
+  ∃ a b c : Fin r → MatrixIndex n → ℂ,
+    ∀ q : TensorIndex n, T q = ∑ t : Fin r, a t q.1 * b t q.2.1 * c t q.2.2
+
+/-- The common zero set of a set of complex multivariate polynomials. -/
+def polynomialZeroSet {ι : Type*} (P : Set (MvPolynomial ι ℂ)) : Set (ι → ℂ) :=
+  {x | ∀ p ∈ P, MvPolynomial.eval x p = 0}
+
+/-- The affine Zariski closure, concretely the zero set of *all* polynomials
+vanishing on the set. This is not closure in the usual complex metric topology. -/
+def zariskiClosure {ι : Type*} (S : Set (ι → ℂ)) : Set (ι → ℂ) :=
+  polynomialZeroSet {p | ∀ x ∈ S, MvPolynomial.eval x p = 0}
+
+/-- Membership is exactly the polynomial-vanishing characterization of Zariski
+closure, with every complex multivariate polynomial quantified. -/
+theorem mem_zariskiClosure_iff {ι : Type*} (S : Set (ι → ℂ)) (x : ι → ℂ) :
+    x ∈ zariskiClosure S ↔
+      ∀ p : MvPolynomial ι ℂ,
+        (∀ y ∈ S, MvPolynomial.eval y p = 0) → MvPolynomial.eval x p = 0 := Iff.rfl
+
+theorem subset_zariskiClosure {ι : Type*} (S : Set (ι → ℂ)) :
+    S ⊆ zariskiClosure S := by
+  intro x hx p hp
+  exact hp x hx
+
+/-- The closure is contained in every polynomial zero set containing `S`. -/
+theorem zariskiClosure_minimal {ι : Type*} (S : Set (ι → ℂ))
+    (P : Set (MvPolynomial ι ℂ)) (h : S ⊆ polynomialZeroSet P) :
+    zariskiClosure S ⊆ polynomialZeroSet P := by
+  intro x hx p hp
+  exact hx p (fun y hy => h hy p hp)
+
+/-- It is itself a polynomial zero set. Together with minimality, this certifies
+that the definition is the intersection of all algebraic closed sets containing S. -/
+theorem zariskiClosure_is_zeroSet {ι : Type*} (S : Set (ι → ℂ)) :
+    ∃ P : Set (MvPolynomial ι ℂ), zariskiClosure S = polynomialZeroSet P :=
+  ⟨_, rfl⟩
+
+/-- Direct agreement with Mathlib's algebraic zero-locus/vanishing-ideal API. -/
+theorem zariskiClosure_eq_mathlib_zeroLocus {ι : Type*} (S : Set (ι → ℂ)) :
+    zariskiClosure S = MvPolynomial.zeroLocus ℂ (MvPolynomial.vanishingIdeal ℂ S) := rfl
+
+/-- Complex border rank at most `r`, using the actual affine Zariski closure. -/
+def TensorBorderRankAtMost (n r : ℕ) (T : CoordinateTensor n) : Prop :=
+  T ∈ zariskiClosure {U | TensorRankAtMost n r U}
+
+/-- 18. Complex 3-by-3 multiplication has border rank at least 18. -/
+def Statement18 : Prop := ¬ TensorBorderRankAtMost 3 17 (multiplicationTensor 3)
+
+theorem tensorRank_implies_borderRank {n r : ℕ} {T : CoordinateTensor n}
+    (h : TensorRankAtMost n r T) : TensorBorderRankAtMost n r T :=
+  subset_zariskiClosure _ h
+
+theorem tensorRank_zero_iff {n : ℕ} (T : CoordinateTensor n) :
+    TensorRankAtMost n 0 T ↔ T = 0 := by
+  constructor
+  · rintro ⟨a, b, c, h⟩
+    funext q
+    simpa using h q
+  · intro h
+    subst T
+    exact ⟨fun t => Fin.elim0 t, fun t => Fin.elim0 t,
+      fun t => Fin.elim0 t, by simp⟩
+
+/-- Zero-rank border closure contains only zero: coordinate polynomials separate
+any nonzero tensor from the rank-zero locus. -/
+theorem tensorBorderRank_zero_iff {n : ℕ} (T : CoordinateTensor n) :
+    TensorBorderRankAtMost n 0 T ↔ T = 0 := by
+  constructor
+  · intro h
+    funext q
+    have hq := h (MvPolynomial.X q) (by
+      intro U hU
+      have hz := (tensorRank_zero_iff U).mp hU
+      subst U
+      simp)
+    simpa using hq
+  · intro h
+    exact tensorRank_implies_borderRank ((tensorRank_zero_iff T).mpr h)
+
+abbrev BooleanInput (n : ℕ) := Fin n → Bool
+abbrev BooleanFunction (n : ℕ) := BooleanInput n → Bool
+
+def boolReal (b : Bool) : ℝ := if b then 1 else 0
+
+def zeroInput (n : ℕ) : BooleanInput n := fun _ => false
+
+def unitInput {n : ℕ} (i : Fin n) : BooleanInput n := fun j => decide (j = i)
+
+/-- Flip exactly the coordinates in one finite block. -/
+def flipBlock {n : ℕ} (x : BooleanInput n) (B : Finset (Fin n)) : BooleanInput n :=
+  fun i => if i ∈ B then !(x i) else x i
+
+def flipBit {n : ℕ} (x : BooleanInput n) (i : Fin n) : BooleanInput n :=
+  flipBlock x {i}
+
+noncomputable def sensitivityAt {n : ℕ} (f : BooleanFunction n)
+    (x : BooleanInput n) : ℕ :=
+  (Finset.univ.filter fun i => f (flipBit x i) ≠ f x).card
+
+noncomputable def sensitivity {n : ℕ} (f : BooleanFunction n) : ℕ :=
+  Finset.univ.sup (sensitivityAt f)
+
+/-- Blocks are distinct (a finset), pairwise disjoint, and each block separately
+changes the value at `x`. An empty block can never satisfy the changing condition. -/
+def SensitiveBlockFamily {n : ℕ} (f : BooleanFunction n) (x : BooleanInput n)
+    (F : Finset (Finset (Fin n))) : Prop :=
+  (∀ B ∈ F, ∀ C ∈ F, B ≠ C → Disjoint B C) ∧
+  ∀ B ∈ F, f (flipBlock x B) ≠ f x
+
+noncomputable def blockSensitivityAt {n : ℕ} (f : BooleanFunction n)
+    (x : BooleanInput n) : ℕ := by
+  classical
+  exact Finset.univ.sup fun F : Finset (Finset (Fin n)) =>
+    if SensitiveBlockFamily f x F then F.card else 0
+
+noncomputable def blockSensitivity {n : ℕ} (f : BooleanFunction n) : ℕ :=
+  Finset.univ.sup (blockSensitivityAt f)
+
+/-- Coefficients of a genuinely multilinear real polynomial. A monomial is
+indexed by a *set* of variables, so repeated powers cannot enter this definition. -/
+abbrev MultilinearCoefficients (n : ℕ) := Finset (Fin n) → ℝ
+
+noncomputable def evalMultilinear {n : ℕ} (c : MultilinearCoefficients n)
+    (x : BooleanInput n) : ℝ :=
+  ∑ S : Finset (Fin n), c S * ∏ i ∈ S, boolReal (x i)
+
+/-- Exact equality on every input of the total Boolean cube; not approximation. -/
+def Represents {n : ℕ} (f : BooleanFunction n) (c : MultilinearCoefficients n) : Prop :=
+  ∀ x, evalMultilinear c x = boolReal (f x)
+
+/-- Real multilinear degree at most `d`. All coefficients of monomials with more
+than `d` distinct variables must vanish. -/
+def RealDegreeAtMost {n : ℕ} (f : BooleanFunction n) (d : ℕ) : Prop :=
+  ∃ c : MultilinearCoefficients n,
+    Represents f c ∧ ∀ S, d < S.card → c S = 0
+
+/-- The exact least possible real multilinear degree, with degree zero for both
+constant Boolean functions. This does not take the degree of an arbitrary witness. -/
+def ExactRealDegree {n : ℕ} (f : BooleanFunction n) (d : ℕ) : Prop :=
+  RealDegreeAtMost f d ∧ ∀ e : ℕ, e < d → ¬ RealDegreeAtMost f e
+
+/-- Exact degree is unique, independent of a chosen representing polynomial. -/
+theorem exactRealDegree_unique {n d e : ℕ} {f : BooleanFunction n}
+    (hd : ExactRealDegree f d) (he : ExactRealDegree f e) : d = e := by
+  rcases lt_trichotomy d e with h | h | h
+  · exact False.elim (he.2 d h hd.1)
+  · exact h
+  · exact False.elim (hd.2 e h he.1)
+
+/-- Every function admitting a multilinear representation has an exact degree;
+there is no choice of a non-minimal witness in the target definitions. -/
+theorem exists_exactRealDegree_of_representation {n : ℕ} {f : BooleanFunction n}
+    (h : ∃ d, RealDegreeAtMost f d) : ∃ d, ExactRealDegree f d := by
+  classical
+  refine ⟨Nat.find h, Nat.find_spec h, ?_⟩
+  intro e he
+  exact Nat.find_min h he
+
+/-- The characteristic Boolean input of a finite set of coordinates. -/
+def setInput {n : ℕ} (S : Finset (Fin n)) : BooleanInput n := fun i => decide (i ∈ S)
+
+/-- Evaluate a multilinear polynomial at a characteristic vector by summing
+exactly the coefficients indexed by subsets of that vector's support. -/
+theorem evalMultilinear_setInput {n : ℕ} (c : MultilinearCoefficients n)
+    (S : Finset (Fin n)) : evalMultilinear c (setInput S) = ∑ T ∈ S.powerset, c T := by
+  classical
+  have hfilter : Finset.univ.filter (fun T : Finset (Fin n) => T ⊆ S) = S.powerset := by
+    ext T
+    simp
+  simp only [evalMultilinear, setInput, boolReal, decide_eq_true_eq]
+  simp_rw [Finset.prod_boole, ← Finset.subset_iff, mul_ite, mul_one, mul_zero]
+  rw [← Finset.sum_filter, hfilter]
+
+/-- The triangular interpolation coefficients: subtract all proper-subset
+coefficients from the function value at the characteristic input. -/
+noncomputable def interpolationCoefficients {n : ℕ} (f : BooleanFunction n)
+    (S : Finset (Fin n)) : ℝ :=
+  Finset.strongInductionOn S fun S rec =>
+    boolReal (f (setInput S)) -
+      ∑ T ∈ S.powerset, if h : T ⊂ S then rec T h else 0
+
+ theorem interpolationCoefficients_eq {n : ℕ} (f : BooleanFunction n)
+    (S : Finset (Fin n)) :
+    interpolationCoefficients f S = boolReal (f (setInput S)) -
+      ∑ T ∈ S.powerset, if T ⊂ S then interpolationCoefficients f T else 0 := by
+  rw [interpolationCoefficients, Finset.strongInductionOn_eq]
+  rfl
+
+ theorem strictSubset_filter {n : ℕ} (S : Finset (Fin n)) :
+    S.powerset.filter (fun T => T ⊂ S) = S.powerset.erase S := by
+  ext T
+  simp only [Finset.mem_filter, Finset.mem_powerset, Finset.mem_erase,
+    Finset.ssubset_iff_subset_ne]
+  tauto
+
+ theorem sum_interpolationCoefficients {n : ℕ} (f : BooleanFunction n)
+    (S : Finset (Fin n)) :
+    (∑ T ∈ S.powerset, interpolationCoefficients f T) = boolReal (f (setInput S)) := by
+  have heq := interpolationCoefficients_eq f S
+  rw [← Finset.sum_filter, strictSubset_filter] at heq
+  rw [← Finset.sum_erase_add _ _ (Finset.mem_powerset_self S)]
+  linarith
+
+/-- Every total Boolean function has a multilinear representation; thus neither
+the real-degree relation nor the universal statement relies on missing objects. -/
+theorem interpolation_represents {n : ℕ} (f : BooleanFunction n) :
+    Represents f (interpolationCoefficients f) := by
+  intro x
+  let S : Finset (Fin n) := Finset.univ.filter fun i => x i = true
+  have hS : setInput S = x := by
+    funext i
+    simp [setInput, S]
+  rw [← hS, evalMultilinear_setInput, sum_interpolationCoefficients]
+
+ theorem realDegreeAtMost_dimension {n : ℕ} (f : BooleanFunction n) :
+    RealDegreeAtMost f n := by
+  refine ⟨interpolationCoefficients f, interpolation_represents f, ?_⟩
+  intro S hS
+  have hc : S.card ≤ n := by simpa using Finset.card_le_card (Finset.subset_univ S)
+  omega
+
+ theorem exists_exactRealDegree {n : ℕ} (f : BooleanFunction n) :
+    ∃ d, ExactRealDegree f d :=
+  exists_exactRealDegree_of_representation ⟨n, realDegreeAtMost_dimension f⟩
+
+/-- The real multilinear representation is unique, not just its least degree. -/
+theorem represents_unique {n : ℕ} {f : BooleanFunction n}
+    {c d : MultilinearCoefficients n} (hc : Represents f c) (hd : Represents f d) :
+    c = d := by
+  funext S
+  induction S using Finset.strongInductionOn
+  rename_i S ih
+  have heq : (∑ T ∈ S.powerset, c T) = ∑ T ∈ S.powerset, d T := by
+    rw [← evalMultilinear_setInput, ← evalMultilinear_setInput, hc, hd]
+  have hs : (∑ T ∈ S.powerset.erase S, c T) = ∑ T ∈ S.powerset.erase S, d T := by
+    apply Finset.sum_congr rfl
+    intro T hT
+    apply ih T
+    rcases Finset.mem_erase.mp hT with ⟨hne, hsub⟩
+    exact Finset.ssubset_iff_subset_ne.mpr ⟨Finset.mem_powerset.mp hsub, hne⟩
+  rw [← Finset.sum_erase_add _ _ (Finset.mem_powerset_self S),
+    ← Finset.sum_erase_add _ _ (Finset.mem_powerset_self S), hs] at heq
+  exact add_left_cancel heq
+
+/-- 19. A 14-variable Boolean function of real degree at most five which is
+fully sensitive at zero, normalized by f(0)=0 and f(e_i)=1. -/
+def Statement19 : Prop :=
+  ∃ f : BooleanFunction 14,
+    RealDegreeAtMost f 5 ∧ f (zeroInput 14) = false ∧ ∀ i, f (unitInput i) = true
+
+/-- Nonconstant is witnessed by two cube points with different outputs. -/
+def Nonconstant {n : ℕ} (f : BooleanFunction n) : Prop := ∃ x y, f x ≠ f y
+
+/-- 20. A uniform subquadratic sensitivity/real-degree bound. The exact degree is
+existentially required for every f, so failure to have a degree cannot make this
+statement vacuous. Real exponentiation is used, not natural truncated powers. -/
+def Statement20 : Prop :=
+  ∃ C ε : ℝ, 0 < C ∧ 0 < ε ∧ ε < 1 ∧
+    ∀ n : ℕ, ∀ f : BooleanFunction n, Nonconstant f →
+      ∃ d : ℕ, ExactRealDegree f d ∧
+        (sensitivity f : ℝ) ≤ C * Real.rpow (d : ℝ) (2 - ε)
+
+/-- 21. A uniform cubic upper bound of block sensitivity by sensitivity. -/
+def Statement21 : Prop :=
+  ∃ C : ℝ, 0 < C ∧ ∀ n : ℕ, ∀ f : BooleanFunction n,
+    (blockSensitivity f : ℝ) ≤ C * (sensitivity f : ℝ) ^ 3
+
+end MatrixBoolean
+end Math30
