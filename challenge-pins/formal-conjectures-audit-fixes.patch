+import Mathlib.Combinatorics.SimpleGraph.Finite
+import Mathlib.Tactic
+
+/-! Exact unrestricted graph-existence targets. Books are ordinary subgraphs. -/
+namespace Math15.Ramsey
+
+open Finset
+
+def CommonBound {n : ℕ} (G : SimpleGraph (Fin n)) (a : ℕ) : Prop :=
+  ∀ u v, G.Adj u v →
+    ∀ S : Finset (Fin n), (∀ w ∈ S, G.Adj u w ∧ G.Adj v w) → S.card ≤ a
+
+def Admissible {n : ℕ} (G : SimpleGraph (Fin n)) (a b : ℕ) : Prop :=
+  CommonBound G a ∧ CommonBound Gᶜ b
+
+def Target01 : Prop := ∃ G : SimpleGraph (Fin 22), Admissible G 3 6
+def Target02 : Prop := ∃ G : SimpleGraph (Fin 27), Admissible G 3 8
+def Target03 : Prop := ∃ G : SimpleGraph (Fin 37), Admissible G 6 10
+
+/-- Exact finite certificate. Symmetry and the zero diagonal are checked, not assumed. -/
+structure MatrixCertificate (n a b : ℕ) where
+  adjacency : Fin n → Fin n → Bool
+  symmetric : ∀ u v, adjacency u v = adjacency v u
+  irreflexive : ∀ u, adjacency u u = false
+  edgeBound : ∀ u v, adjacency u v = true →
+    ((univ : Finset (Fin n)).filter (fun w => adjacency u w && adjacency v w)).card ≤ a
+  nonedgeBound : ∀ u v, u ≠ v → adjacency u v = false →
+    ((univ : Finset (Fin n)).filter
+      (fun w => w ≠ u ∧ w ≠ v ∧ adjacency u w = false ∧ adjacency v w = false)).card ≤ b
+
+def MatrixCertificate.graph {n a b : ℕ} (c : MatrixCertificate n a b) : SimpleGraph (Fin n) where
+  Adj u v := c.adjacency u v = true
+  symm := ⟨by intro u v h; simpa [c.symmetric v u] using h⟩
+  loopless := ⟨by intro u h; simp [c.irreflexive] at h⟩
+
+theorem MatrixCertificate.sound {n a b : ℕ} (c : MatrixCertificate n a b) :
+    Admissible c.graph a b := by
+  constructor
+  · intro u v huv S hS
+    apply le_trans (Finset.card_le_card (show S ⊆ _ from ?_)) (c.edgeBound u v huv)
+    intro w hw
+    simpa only [Finset.mem_filter, Finset.mem_univ, true_and, Bool.and_eq_true, MatrixCertificate.graph]
+      using hS w hw
+  · intro u v huv S hS
+    have huv' : u ≠ v ∧ c.adjacency u v = false := by
+      simpa [MatrixCertificate.graph, SimpleGraph.compl_adj] using huv
+    apply le_trans (Finset.card_le_card (show S ⊆ _ from ?_))
+      (c.nonedgeBound u v huv'.1 huv'.2)
+    intro w hw
+    have hw' := hS w hw
+    simp only [SimpleGraph.compl_adj, MatrixCertificate.graph] at hw'
+    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
+    exact ⟨Ne.symm hw'.1.1, Ne.symm hw'.2.1,
+      Bool.eq_false_iff.mpr hw'.1.2, Bool.eq_false_iff.mpr hw'.2.2⟩
+
+theorem accept01 (c : MatrixCertificate 22 3 6) : Target01 := ⟨c.graph, c.sound⟩
+theorem accept02 (c : MatrixCertificate 27 3 8) : Target02 := ⟨c.graph, c.sound⟩
+theorem accept03 (c : MatrixCertificate 37 6 10) : Target03 := ⟨c.graph, c.sound⟩
+
+end Math15.Ramsey
