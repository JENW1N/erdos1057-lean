+import Math30.WilfMinimal
+
+/-! Executable proof fixtures for the six statement definitions. None is a proof
+of an open target. The examples check invariant conventions and equation polarity. -/
+
+namespace Math30.Wilf
+namespace Fixtures
+
+/-- The ordinary numerical semigroup `{0} ∪ {k, k+1, ...}`. -/
+def ordinary (k : ℕ) (hk : 2 ≤ k) : NumericalSemigroup where
+  carrier := {
+    carrier := {n | n = 0 ∨ k ≤ n}
+    zero_mem' := Or.inl rfl
+    add_mem' := by
+      intro a b ha hb
+      simp only [Set.mem_ofPred_eq] at *
+      omega }
+  finite_gaps := by
+    apply (Finset.range k).finite_toSet.subset
+    intro n hn
+    change ¬ (n = 0 ∨ k ≤ n) at hn
+    simp only [Finset.mem_coe, Finset.mem_range]
+    omega
+  proper := by
+    intro h
+    have hmem : (1 : ℕ) ∈ (⊤ : AddSubmonoid ℕ) := by trivial
+    rw [← h] at hmem
+    change 1 = 0 ∨ k ≤ 1 at hmem
+    omega
+
+@[simp] theorem ordinary_mem (k : ℕ) (hk : 2 ≤ k) (n : ℕ) :
+    n ∈ (ordinary k hk).carrier ↔ n = 0 ∨ k ≤ n := Iff.rfl
+
+@[simp] theorem ordinary_conductor (k : ℕ) (hk : 2 ≤ k) :
+    (ordinary k hk).conductor = k := by
+  apply Nat.le_antisymm
+  · apply NumericalSemigroup.conductor_le
+    intro n hn
+    exact Or.inr hn
+  · have h := (ordinary k hk).conductor_spec _ (Nat.le_refl _)
+    have hp := (ordinary k hk).conductor_pos
+    rw [ordinary_mem] at h
+    omega
+
+@[simp] theorem ordinary_multiplicity (k : ℕ) (hk : 2 ≤ k) :
+    (ordinary k hk).multiplicity = k := by
+  apply Nat.le_antisymm
+  · exact (ordinary k hk).multiplicity_le (by omega) (Or.inr (Nat.le_refl _))
+  · have h := (ordinary k hk).multiplicity_mem
+    have hp := (ordinary k hk).multiplicity_pos
+    rw [ordinary_mem] at h
+    omega
+
+theorem ordinary_primitive_iff (k : ℕ) (hk : 2 ≤ k) (n : ℕ) :
+    (ordinary k hk).IsPrimitive n ↔ k ≤ n ∧ n < k + k := by
+  constructor
+  · intro h
+    have hmem := h.1
+    rw [ordinary_mem] at hmem
+    have hn : k ≤ n := by have := h.2.1; omega
+    refine ⟨hn, ?_⟩
+    by_contra hlarge
+    have hsub : k ≤ n - k := by omega
+    have hz := h.2.2 k (n - k) (Or.inr (Nat.le_refl _)) (Or.inr hsub) (by omega)
+    omega
+  · rintro ⟨hn, hnlt⟩
+    refine ⟨Or.inr hn, by omega, ?_⟩
+    intro a b ha hb heq
+    rw [ordinary_mem] at ha hb
+    omega
+
+@[simp] theorem ordinary_primitives (k : ℕ) (hk : 2 ≤ k) :
+    (ordinary k hk).primitiveElements = Finset.Ico k (k + k) := by
+  ext n
+  simp only [NumericalSemigroup.mem_primitiveElements, ordinary_primitive_iff, Finset.mem_Ico]
+
+@[simp] theorem ordinary_embeddingDimension (k : ℕ) (hk : 2 ≤ k) :
+    (ordinary k hk).embeddingDimension = k := by
+  simp [NumericalSemigroup.embeddingDimension]
+
+@[simp] theorem ordinary_leftElements (k : ℕ) (hk : 2 ≤ k) :
+    (ordinary k hk).leftElements = {0} := by
+  ext n
+  simp only [NumericalSemigroup.mem_leftElements, ordinary_conductor, ordinary_mem,
+    Finset.mem_singleton]
+  omega
+
+@[simp] theorem ordinary_leftCount (k : ℕ) (hk : 2 ≤ k) :
+    (ordinary k hk).leftCount = 1 := by
+  simp [NumericalSemigroup.leftCount]
+
+theorem ordinary_satisfiesWilf (k : ℕ) (hk : 2 ≤ k) :
+    (ordinary k hk).SatisfiesWilf := by
+  simp [NumericalSemigroup.SatisfiesWilf]
+
+example : (ordinary 4 (by omega)).embeddingDimension = 4 := by simp
+example : (ordinary 4 (by omega)).conductor = 4 := by simp
+example : (ordinary 4 (by omega)).multiplicity = 4 := by simp
+example : (ordinary 4 (by omega)).leftCount = 1 := by simp
+example : (ordinary 4 (by omega)).SatisfiesWilf := ordinary_satisfiesWilf _ _
+
+/-- Explicit numerical semigroup generated by 3 and 5: `{0,3,5,6} ∪ [8,∞)`. -/
+def threeFive : NumericalSemigroup where
+  carrier := {
+    carrier := {n | n = 0 ∨ n = 3 ∨ n = 5 ∨ n = 6 ∨ 8 ≤ n}
+    zero_mem' := Or.inl rfl
+    add_mem' := by
+      intro a b ha hb
+      simp only [Set.mem_ofPred_eq] at *
+      omega }
+  finite_gaps := by
+    apply (Finset.range 8).finite_toSet.subset
+    intro n hn
+    change ¬ (n = 0 ∨ n = 3 ∨ n = 5 ∨ n = 6 ∨ 8 ≤ n) at hn
+    simp only [Finset.mem_coe, Finset.mem_range]
+    omega
+  proper := by
+    intro h
+    have hmem : (1 : ℕ) ∈ (⊤ : AddSubmonoid ℕ) := by trivial
+    rw [← h] at hmem
+    change 1 = 0 ∨ 1 = 3 ∨ 1 = 5 ∨ 1 = 6 ∨ 8 ≤ 1 at hmem
+    omega
+
+@[simp] theorem threeFive_mem (n : ℕ) :
+    n ∈ threeFive.carrier ↔ n = 0 ∨ n = 3 ∨ n = 5 ∨ n = 6 ∨ 8 ≤ n := Iff.rfl
+
+@[simp] theorem threeFive_conductor : threeFive.conductor = 8 := by
+  have hle : threeFive.conductor ≤ 8 := by
+    apply threeFive.conductor_le
+    intro n hn
+    exact Or.inr (Or.inr (Or.inr (Or.inr hn)))
+  have hgap : 7 ∉ threeFive.carrier := by simp
+  have hgt : 7 < threeFive.conductor := by
+    by_contra h
+    exact hgap (threeFive.conductor_spec 7 (by omega))
+  omega
+
+@[simp] theorem threeFive_multiplicity : threeFive.multiplicity = 3 := by
+  have hle : threeFive.multiplicity ≤ 3 :=
+    threeFive.multiplicity_le (by omega) (by simp)
+  have hmem := threeFive.multiplicity_mem
+  have hp := threeFive.multiplicity_pos
+  rw [threeFive_mem] at hmem
+  omega
+
+theorem threeFive_primitive_iff (n : ℕ) :
+    threeFive.IsPrimitive n ↔ n = 3 ∨ n = 5 := by
+  constructor
+  · intro h
+    have hmem := h.1
+    rw [threeFive_mem] at hmem
+    have hp := h.2.1
+    have h33 := h.2.2 3 3 (by simp) (by simp)
+    have h55 := h.2.2 5 5 (by simp) (by simp)
+    have h3sub := h.2.2 3 (n - 3) (by simp)
+    simp only [threeFive_mem] at h3sub
+    omega
+  · intro h
+    refine ⟨by simp; omega, by omega, ?_⟩
+    intro a b ha hb heq
+    rw [threeFive_mem] at ha hb
+    omega
+
+@[simp] theorem threeFive_primitives : threeFive.primitiveElements = {3, 5} := by
+  ext n
+  simp [threeFive_primitive_iff]
+
+@[simp] theorem threeFive_embeddingDimension : threeFive.embeddingDimension = 2 := by
+  simp [NumericalSemigroup.embeddingDimension]
+
+@[simp] theorem threeFive_leftElements : threeFive.leftElements = {0, 3, 5, 6} := by
+  ext n
+  simp only [NumericalSemigroup.mem_leftElements, threeFive_conductor, threeFive_mem,
+    Finset.mem_insert, Finset.mem_singleton]
+  omega
+
+@[simp] theorem threeFive_leftCount : threeFive.leftCount = 4 := by
+  simp [NumericalSemigroup.leftCount]
+
+example : threeFive.SatisfiesWilf := by simp [NumericalSemigroup.SatisfiesWilf]
+example : threeFive.multiplicity ≤ 4 * threeFive.embeddingDimension := by simp
+example : ¬ threeFive.multiplicity ∣ threeFive.conductor := by simp
+example : 0 ∈ threeFive.leftElements := threeFive.zero_mem_leftElements
+
+end Fixtures
+end Math30.Wilf
+
+namespace Math30.MinimalGraphs
+namespace Fixtures
+
+open MvPolynomial
+
+/-- Generic affine polynomial, allowing arbitrary constant and linear coefficients. -/
+noncomputable def affinePolynomial {n : ℕ} (b : ℝ) (a : Fin n → ℝ) : RealPolynomial n :=
+  C b + ∑ i : Fin n, C (a i) * X i
+
+ theorem affinePolynomial_pderiv {n : ℕ} (b : ℝ) (a : Fin n → ℝ) (j : Fin n) :
+    pderiv j (affinePolynomial b a) = C (a j) := by
+  classical
+  simp [affinePolynomial, map_add, map_sum, Pi.single_apply]
+
+ theorem affinePolynomial_second_pderiv {n : ℕ} (b : ℝ) (a : Fin n → ℝ)
+    (i j : Fin n) : pderiv i (pderiv j (affinePolynomial b a)) = 0 := by
+  rw [affinePolynomial_pderiv, pderiv_C]
+
+ theorem affinePolynomial_satisfies {n : ℕ} (b : ℝ) (a : Fin n → ℝ) :
+    SatisfiesMinimalGraphEquation (affinePolynomial b a) := by
+  simp [SatisfiesMinimalGraphEquation, minimalGraphOperator, affinePolynomial_second_pderiv]
+
+ theorem affinePolynomial_isAffine {n : ℕ} (b : ℝ) (a : Fin n → ℝ) :
+    IsAffine (affinePolynomial b a) := by
+  unfold IsAffine affinePolynomial
+  apply (totalDegree_add _ _).trans
+  apply max_le
+  · simp
+  · apply totalDegree_finsetSum_le
+    intro i hi
+    exact (totalDegree_mul _ _).trans (by simp)
+
+ theorem constant_satisfies (n : ℕ) (b : ℝ) :
+    SatisfiesMinimalGraphEquation (C b : RealPolynomial n) := by
+  simp [SatisfiesMinimalGraphEquation, minimalGraphOperator]
+
+ theorem constant_isAffine (n : ℕ) (b : ℝ) : IsAffine (C b : RealPolynomial n) := by
+  simp [IsAffine]
+
+example (n : ℕ) : SatisfiesMinimalGraphEquation (0 : RealPolynomial n) := by
+  simpa using constant_satisfies n 0
+example (n : ℕ) : IsAffine (0 : RealPolynomial n) := by simp [IsAffine]
+
+/-- A nonaffine polynomial used to ensure the equation predicate is not vacuous. -/
+noncomputable def quadratic : RealPolynomial 1 := X 0 ^ 2
+
+ theorem quadratic_degree : quadratic.totalDegree = 2 := by
+  simp [quadratic]
+
+ theorem quadratic_not_affine : ¬ IsAffine quadratic := by
+  simp [IsAffine, quadratic_degree]
+
+ theorem quadratic_operator : minimalGraphOperator quadratic = C 2 := by
+  have h2 : pderiv (0 : Fin 1) (2 : RealPolynomial 1) = 0 :=
+    Derivation.map_natCast _ 2
+  simp [minimalGraphOperator, quadratic, h2]
+  calc
+    _ = (2 : RealPolynomial 1) := by ring
+    _ = C 2 := (map_natCast (C : ℝ →+* RealPolynomial 1) 2).symm
+
+
+ theorem quadratic_not_satisfies : ¬ SatisfiesMinimalGraphEquation quadratic := by
+  unfold SatisfiesMinimalGraphEquation
+  rw [quadratic_operator]
+  norm_num
+
+example : quadratic.totalDegree ≤ 4 := by rw [quadratic_degree]; omega
+
+/-- The mixed monomial detects omission of the off-diagonal Hessian terms. -/
+noncomputable def mixedQuadratic : RealPolynomial 2 := X 0 * X 1
+
+ theorem mixedQuadratic_degree : mixedQuadratic.totalDegree = 2 := by
+  rw [mixedQuadratic, totalDegree_mul_of_isDomain (by simp) (by simp)]
+  simp
+
+ theorem mixedQuadratic_operator :
+    minimalGraphOperator mixedQuadratic = -(2 * X 0 * X 1) := by
+  simp [minimalGraphOperator, mixedQuadratic, Fin.sum_univ_two,
+    map_add, Pi.single_apply]
+  ring
+
+ theorem mixedQuadratic_not_satisfies : ¬ SatisfiesMinimalGraphEquation mixedQuadratic := by
+  intro h
+  change minimalGraphOperator mixedQuadratic = 0 at h
+  rw [mixedQuadratic_operator] at h
+  have he := congrArg (MvPolynomial.eval (fun _ : Fin 2 => (1 : ℝ))) h
+  norm_num at he
+
+ theorem mixedQuadratic_not_affine : ¬ IsAffine mixedQuadratic := by
+  simp [IsAffine, mixedQuadratic_degree]
+
+end Fixtures
+end Math30.MinimalGraphs
