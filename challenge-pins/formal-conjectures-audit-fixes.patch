@@ -0,0 +1,58 @@
+import Mathlib.Data.Finset.Card
+import Mathlib.Order.Interval.Finset.Nat
+import Mathlib.Logic.Function.Iterate
+import Mathlib.Tactic
+
+namespace Math15.Collatz
+
+def step (n : ℕ) : ℕ := if n % 2 = 0 then n / 2 else (3 * n + 1) / 2
+def ReachesOne (n : ℕ) : Prop := ∃ k : ℕ, step^[k] n = 1
+noncomputable def count (N : ℕ) : ℕ := by
+  classical
+  exact ((Finset.Icc 1 N).filter ReachesOne).card
+
+def Target13 : Prop := ∃ A N₀ : ℕ, 0 < A ∧ 0 < N₀ ∧
+  ∀ N, N₀ ≤ N → N ^ 23 ≤ A * count N ^ 25
+
+def LeastPeriod (n p : ℕ) : Prop :=
+  0 < p ∧ step^[p] n = n ∧ ∀ k, 0 < k → k < p → step^[k] n ≠ n
+
+def LocalMinimum (n p i : ℕ) : Prop :=
+  step^[i] n < step^[((i + p - 1) % p)] n ∧
+  step^[i] n < step^[((i + 1) % p)] n
+
+instance (n p i : ℕ) : Decidable (LocalMinimum n p i) :=
+  inferInstanceAs (Decidable (_ ∧ _))
+
+def minimaCount (n p : ℕ) : ℕ :=
+  ((Finset.range p).filter (LocalMinimum n p)).card
+
+def Target14 : Prop := ¬ ∃ n p : ℕ, 0 < n ∧ LeastPeriod n p ∧
+  (∀ i < p, step^[i] n ≠ 1 ∧ step^[i] n ≠ 2) ∧ minimaCount n p = 96
+
+def Target15 : Prop := ∀ n : ℕ, 1 ≤ n → n < 2 ^ 72 → ReachesOne n
+
+/-- A descent certificate must cover every input in the exact interval. -/
+def DescentCoverage (B : ℕ) : Prop :=
+  ∀ n, 2 ≤ n → n < B → ∃ k, 1 ≤ step^[k] n ∧ step^[k] n < n
+
+theorem reaches_one : ReachesOne 1 := ⟨0, rfl⟩
+
+theorem reaches_of_iterate {n k : ℕ} (h : ReachesOne (step^[k] n)) : ReachesOne n := by
+  obtain ⟨j, hj⟩ := h
+  exact ⟨j + k, by simpa only [Function.iterate_add_apply] using hj⟩
+
+theorem coverage_sound {B : ℕ} (h : DescentCoverage B) :
+    ∀ n, 1 ≤ n → n < B → ReachesOne n := by
+  intro n
+  induction n using Nat.strong_induction_on with
+  | h n ih =>
+    intro hn hB
+    by_cases he : n = 1
+    · simpa [he] using reaches_one
+    · obtain ⟨k, hkpos, hkn⟩ := h n (by omega) hB
+      exact reaches_of_iterate (ih _ hkn hkpos (by omega))
+
+theorem accept15 (h : DescentCoverage (2 ^ 72)) : Target15 := coverage_sound h
+
+end Math15.Collatz
diff --git a/Math15/CollatzCertificates.lean b/Math15/CollatzCertificates.lean
new file mode 100644
index 0000000000000000000000000000000000000000..2c9e1215b3ce50d380b733f62cc162af312b56b1
--- /dev/null
+++ b/Math15/CollatzCertificates.lean
@@ -0,0 +1,170 @@
+import Math15.Collatz
+
+/-!
+A concrete finite certificate format for Collatz descent on [2, B).
+Each shard stores a starting value and one iteration-count witness per integer.
+The Boolean checker checks all orbit descents and exact contiguous coverage.
+This format is a sound reference checker, not a practical 2^72 certificate.
+-/
+
+namespace Math15.CollatzCertificates
+open Math15.Collatz
+
+/-- This shard covers [start, start + steps.length). Entry i certifies start+i. -/
+structure IntervalShard where
+  start : ℕ
+  steps : List ℕ
+  deriving DecidableEq, Repr
+
+/-- Recompute the exact shortcut orbit; check positivity and strict descent. -/
+def checkDescent (n k : ℕ) : Bool :=
+  decide (1 ≤ step^[k] n ∧ step^[k] n < n)
+
+/-- A finite row checker; no unbounded convergence predicate is evaluated. -/
+def checkSteps : ℕ → List ℕ → Bool
+  | _, [] => true
+  | n, k :: ks => checkDescent n k && checkSteps (n + 1) ks
+
+/-- Shards must be nonempty, in order, adjacent, and end at exactly B. -/
+def checkFrom (expected B : ℕ) : List IntervalShard → Bool
+  | [] => decide (expected = B)
+  | shard :: rest =>
+      (decide (shard.start = expected) && decide (0 < shard.steps.length)) &&
+      (checkSteps shard.start shard.steps &&
+        checkFrom (shard.start + shard.steps.length) B rest)
+
+/-- The bound is an external checker parameter, not taken on faith from a file. -/
+def checkCertificate (B : ℕ) (shards : List IntervalShard) : Bool :=
+  decide (2 ≤ B) && checkFrom 2 B shards
+
+/-- This reference format uses one stored witness per checked starting value. -/
+def entryCount : List IntervalShard → ℕ
+  | [] => 0
+  | shard :: rest => shard.steps.length + entryCount rest
+
+theorem checkDescent_sound {n k : ℕ} (h : checkDescent n k = true) :
+    1 ≤ step^[k] n ∧ step^[k] n < n := by
+  exact of_decide_eq_true h
+
+theorem checkSteps_sound {start : ℕ} {ks : List ℕ}
+    (h : checkSteps start ks = true) :
+    ∀ n, start ≤ n → n < start + ks.length →
+      ∃ k, 1 ≤ step^[k] n ∧ step^[k] n < n := by
+  induction ks generalizing start with
+  | nil =>
+      intro n hlo hhi
+      simp only [List.length_nil, Nat.add_zero] at hhi
+      omega
+  | cons k ks ih =>
+      rcases Bool.and_eq_true_iff.mp h with ⟨hk, hks⟩
+      intro n hlo hhi
+      by_cases he : n = start
+      · subst n
+        exact ⟨k, checkDescent_sound hk⟩
+      · apply ih hks n
+        · omega
+        · simp only [List.length_cons] at hhi
+          omega
+
+theorem checkFrom_sound {start B : ℕ} {shards : List IntervalShard}
+    (h : checkFrom start B shards = true) :
+    ∀ n, start ≤ n → n < B →
+      ∃ k, 1 ≤ step^[k] n ∧ step^[k] n < n := by
+  induction shards generalizing start with
+  | nil =>
+      have he : start = B := of_decide_eq_true h
+      intro n hlo hhi
+      omega
+  | cons shard rest ih =>
+      rcases Bool.and_eq_true_iff.mp h with ⟨hshape, hbody⟩
+      rcases Bool.and_eq_true_iff.mp hshape with ⟨hstart, _⟩
+      rcases Bool.and_eq_true_iff.mp hbody with ⟨hsteps, hrest⟩
+      have he : shard.start = start := of_decide_eq_true hstart
+      intro n hlo hhi
+      by_cases hn : n < shard.start + shard.steps.length
+      · exact checkSteps_sound hsteps n (by omega) hn
+      · exact ih hrest n (by omega) hhi
+
+/-- The checker also proves the exact total size of the covered interval. -/
+theorem checkFrom_size {start B : ℕ} {shards : List IntervalShard}
+    (h : checkFrom start B shards = true) : start + entryCount shards = B := by
+  induction shards generalizing start with
+  | nil =>
+      have he : start = B := of_decide_eq_true h
+      simpa [entryCount] using he
+  | cons shard rest ih =>
+      rcases Bool.and_eq_true_iff.mp h with ⟨hshape, hbody⟩
+      rcases Bool.and_eq_true_iff.mp hshape with ⟨hstart, _⟩
+      rcases Bool.and_eq_true_iff.mp hbody with ⟨_, hrest⟩
+      have he : shard.start = start := of_decide_eq_true hstart
+      have hs := ih hrest
+      simp only [entryCount]
+      omega
+
+theorem certificate_size {B : ℕ} {shards : List IntervalShard}
+    (h : checkCertificate B shards = true) : 2 + entryCount shards = B :=
+  checkFrom_size (Bool.and_eq_true_iff.mp h).2
+
+/-- The executable checker discharges the abstract coverage obligation. -/
+theorem certificate_coverage {B : ℕ} {shards : List IntervalShard}
+    (h : checkCertificate B shards = true) : DescentCoverage B := by
+  exact checkFrom_sound (Bool.and_eq_true_iff.mp h).2
+
+theorem certificate_convergence {B : ℕ} {shards : List IntervalShard}
+    (h : checkCertificate B shards = true) :
+    ∀ n, 1 ≤ n → n < B → ReachesOne n :=
+  coverage_sound (certificate_coverage h)
+
+/-- A passing concrete certificate for the exact requested bound proves Target15. -/
+theorem acceptTarget15 {shards : List IntervalShard}
+    (h : checkCertificate (2 ^ 72) shards = true) : Target15 :=
+  certificate_convergence h
+
+/-! Kernel-checked, bounded data and adversarial controls. -/
+
+/-- The two shards cover [2,11) and [11,21), respectively. -/
+def sampleCertificate21 : List IntervalShard :=
+  [⟨2, [1, 4, 1, 2, 1, 7, 1, 2, 1]⟩,
+   ⟨11, [5, 1, 2, 1, 7, 1, 2, 1, 4, 1]⟩]
+
+theorem sample21_passes : checkCertificate 21 sampleCertificate21 = true := by
+  decide
+
+theorem sample21_has_nineteen_rows : entryCount sampleCertificate21 = 19 := by
+  decide
+
+theorem sample21_converges : ∀ n, 1 ≤ n → n < 21 → ReachesOne n :=
+  certificate_convergence sample21_passes
+
+theorem empty_range_passes : checkCertificate 2 [] = true := by decide
+
+theorem bound_below_two_rejected : checkCertificate 1 [] = false := by decide
+
+theorem empty_shard_rejected : checkCertificate 2 [⟨2, []⟩] = false := by decide
+
+theorem zero_step_rejected (n : ℕ) : checkDescent n 0 = false := by
+  simp [checkDescent]
+
+theorem wrong_orbit_witness_rejected : checkDescent 3 1 = false := by decide
+
+theorem bad_row_rejected : checkCertificate 3 [⟨2, [0]⟩] = false := by decide
+
+theorem gap_rejected :
+    checkCertificate 5 [⟨2, [1]⟩, ⟨4, [1]⟩] = false := by decide
+
+theorem overlap_rejected :
+    checkCertificate 4 [⟨2, [1]⟩, ⟨2, [1]⟩] = false := by decide
+
+theorem missing_suffix_rejected :
+    checkCertificate 4 [⟨2, [1]⟩] = false := by decide
+
+theorem overshoot_rejected :
+    checkCertificate 2 [⟨2, [1]⟩] = false := by decide
+
+theorem reordered_shards_rejected :
+    checkCertificate 21 sampleCertificate21.reverse = false := by decide
+
+theorem small_data_cannot_prove_large_range :
+    checkCertificate (2 ^ 72) sampleCertificate21 = false := by decide
+
+end Math15.CollatzCertificates
