index 0000000000000000000000000000000000000000..92e4bd2738d9f2f9016cbcb85868d4f74fd8f198
--- /dev/null
+++ b/Math30/PolyaMinmax.lean
@@ -0,0 +1,85 @@
+import Math30.Polya
+import Mathlib.LinearAlgebra.Dimension.Free
+
+/-!
+# Index monotonicity of the concrete Dirichlet min–max values
+
+A finite-dimensional trial space contains trial spaces of every smaller
+dimension. Restriction decreases the Rayleigh supremum, hence the actual
+extended-real Courant–Fischer construction is monotone in its index.
+-/
+
+noncomputable section
+
+open Set MeasureTheory
+open scoped ENNReal NNReal
+
+namespace Math30.Polya
+
+/-- Every trial space contains trial spaces of every smaller dimension. -/
+theorem TrialSpace.exists_subtrial {Ω : Set Plane} {k m : ℕ}
+    (V : TrialSpace Ω m) (hkm : k ≤ m) :
+    ∃ W : TrialSpace Ω k, W.space ≤ V.space := by
+  let := V.finiteDimensional
+  have hdim : Module.finrank ℝ (Fin k → ℝ) ≤ Module.finrank ℝ V.space := by
+    simpa [V.dimension] using hkm
+  obtain ⟨f, hf⟩ := finrank_le_iff_exists_linearMap.mp hdim
+  let g : (Fin k → ℝ) →ₗ[ℝ] SobolevAmbient := V.space.subtype.comp f
+  have hg : Function.Injective g := V.space.subtype_injective.comp hf
+  have hle : LinearMap.range g ≤ V.space := by
+    rintro w ⟨x, rfl⟩
+    exact (f x).property
+  refine ⟨{
+    space := LinearMap.range g
+    finiteDimensional := inferInstance
+    dimension := ?_
+    contained := fun w hw => V.contained (hle hw)
+  }, hle⟩
+  rw [LinearMap.finrank_range_of_inj hg]
+  simp
+
+/-- Restricting a trial space cannot increase its Rayleigh supremum. -/
+theorem trialSup_mono {Ω : Set Plane} {k m : ℕ}
+    {V : TrialSpace Ω k} {W : TrialSpace Ω m} (hVW : V.space ≤ W.space) :
+    trialSup V ≤ trialSup W := by
+  unfold trialSup
+  apply iSup_le
+  intro w
+  exact le_iSup_of_le ⟨w.val, hVW w.property.1, w.property.2⟩ le_rfl
+
+/-- The actual extended-real min–max sequence is nondecreasing in its index. -/
+theorem dirichletMinmax_monotone (Ω : Set Plane) : Monotone (dirichletMinmax Ω) := by
+  intro k m hkm
+  apply le_iInf
+  intro V
+  obtain ⟨W, hWV⟩ := V.exists_subtrial hkm
+  exact (dirichletMinmax_le_trialSup W).trans (trialSup_mono hWV)
+
+/-- The zero-dimensional trial space, available on every set. -/
+def TrialSpace.zero (Ω : Set Plane) : TrialSpace Ω 0 where
+  space := ⊥
+  finiteDimensional := inferInstance
+  dimension := by simp
+  contained := by
+    intro w hw
+    have hwzero : w = 0 := by simpa using hw
+    exact hwzero ▸ zero_mem_h01Graph Ω
+
+@[simp] theorem trialSup_zero (Ω : Set Plane) : trialSup (TrialSpace.zero Ω) = 0 := by
+  apply le_antisymm _ zero_le
+  unfold trialSup
+  apply iSup_le
+  rintro ⟨w, hw, hne⟩
+  exact (hne (by simpa [TrialSpace.zero] using hw)).elim
+
+/-- The auxiliary index zero has value zero; positive spectral indices start
+at one. -/
+@[simp] theorem dirichletMinmax_zero (Ω : Set Plane) : dirichletMinmax Ω 0 = 0 := by
+  apply le_antisymm _ zero_le
+  exact (dirichletMinmax_le_trialSup (TrialSpace.zero Ω)).trans_eq (trialSup_zero Ω)
+
+@[simp] theorem dirichletEigenvalue_zero (Ω : Set Plane) :
+    dirichletEigenvalue Ω 0 = 0 := by
+  simp [dirichletEigenvalue]
+
+end Math30.Polya
diff --git a/Math30/PolyaPoincare.lean b/Math30/PolyaPoincare.lean
new file mode 100644
index 0000000000000000000000000000000000000000..a2286dd00259373b9c39be898bbdb46b4478f7c2
--- /dev/null
+++ b/Math30/PolyaPoincare.lean
@@ -0,0 +1,144 @@
+import Math30.PolyaSobolev
+import Math30.PolyaClosability
+import Mathlib.Analysis.FunctionalSpaces.SobolevInequality
+import Mathlib.MeasureTheory.Function.LpSeminorm.CompareExp
+import Mathlib.Tactic.NormNum
+import Mathlib.Tactic.Linarith
+
+/-!
+A Poincaré bound for the concrete zero-boundary Sobolev graph.  It is obtained
+from the existing dimension-two Gagliardo–Nirenberg–Sobolev inequality followed
+by Hölder on the finite-area support.  The constant is unrelated to the
+conjectural Pólya constants and no eigenvalue bound is assumed.
+-/
+
+noncomputable section
+open Set MeasureTheory
+open scoped ENNReal NNReal Topology
+
+namespace Math30.Polya
+
+def poincareFactor (Ω : Set Plane) : ℝ≥0∞ :=
+  (eLpNormLESNormFDerivOneConst (volume : Measure Plane) 2 : ℝ≥0∞) *
+    (volume Ω) ^ (1 / 2 : ℝ)
+
+def poincareConstant (Ω : Set Plane) : ℝ := 1 + (poincareFactor Ω).toReal
+
+theorem poincareConstant_pos (Ω : Set Plane) : 0 < poincareConstant Ω := by
+  have := ENNReal.toReal_nonneg (a := poincareFactor Ω)
+  unfold poincareConstant
+  linarith
+
+theorem poincareFactor_ne_top (Ω : PlanarLipschitzDomain) :
+    poincareFactor Ω.carrier ≠ ⊤ := by
+  apply ENNReal.mul_ne_top ENNReal.coe_ne_top
+  exact ENNReal.rpow_ne_top_of_nonneg (by norm_num) Ω.finiteArea
+
+theorem smooth_poincare_eLpNorm (Ω : PlanarLipschitzDomain)
+    {φ : Plane → ℝ} (hφ : IsTestFunction Ω.carrier φ) :
+    eLpNorm φ 2 volume ≤ poincareFactor Ω.carrier * eLpNorm (gradient φ) 2 volume := by
+  have hdim : Module.finrank ℝ Plane = 2 := by simp [Plane]
+  have hholder : NNReal.HolderConjugate (Module.finrank ℝ Plane) 2 := by
+    simpa [hdim] using NNReal.HolderConjugate.two_two
+  have hgns := eLpNorm_le_eLpNorm_fderiv_one (volume : Measure Plane)
+    (hφ.1.of_le (by simp)) hφ.2.1 hholder
+  have hsupp : Function.support (fderiv ℝ φ) ⊆ Ω.carrier :=
+    (support_fderiv_subset ℝ).trans hφ.2.2
+  have hfdCont : Continuous (fderiv ℝ φ) := hφ.1.continuous_fderiv (by simp)
+  have hholderNorm : eLpNorm (fderiv ℝ φ) 1 volume ≤
+      eLpNorm (fderiv ℝ φ) 2 volume * (volume Ω.carrier) ^ (1 / 2 : ℝ) := by
+    have h := eLpNorm_le_eLpNorm_mul_rpow_measure_univ
+      (f := fderiv ℝ φ) (μ := volume.restrict Ω.carrier) (p := 1) (q := 2)
+      (by norm_num) hfdCont.aestronglyMeasurable
+    rw [eLpNorm_restrict_eq_of_support_subset (f := fderiv ℝ φ)
+      (μ := (volume : Measure Plane)) (p := 1) hfdCont.aestronglyMeasurable hsupp,
+      eLpNorm_restrict_eq_of_support_subset (f := fderiv ℝ φ)
+      (μ := (volume : Measure Plane)) (p := 2) hfdCont.aestronglyMeasurable hsupp] at h
+    convert h using 1
+    norm_num
+  have hgradNorm : eLpNorm (fderiv ℝ φ) 2 volume = eLpNorm (gradient φ) 2 volume := by
+    have hgradCont : Continuous (gradient φ) :=
+      (InnerProductSpace.toDual ℝ Plane).symm.continuous.comp hfdCont
+    apply eLpNorm_congr_norm_ae hfdCont.aestronglyMeasurable hgradCont.aestronglyMeasurable
+    exact Filter.Eventually.of_forall fun x => by simp [gradient]
+  calc
+    eLpNorm φ 2 volume ≤
+        (eLpNormLESNormFDerivOneConst (volume : Measure Plane) 2 : ℝ≥0∞) *
+          eLpNorm (fderiv ℝ φ) 1 volume := hgns
+    _ ≤ (eLpNormLESNormFDerivOneConst (volume : Measure Plane) 2 : ℝ≥0∞) *
+        (eLpNorm (fderiv ℝ φ) 2 volume * (volume Ω.carrier) ^ (1 / 2 : ℝ)) :=
+      by gcongr
+    _ = poincareFactor Ω.carrier * eLpNorm (gradient φ) 2 volume := by
+      rw [hgradNorm, poincareFactor]
+      ac_rfl
+
+theorem smoothGraph_poincare (Ω : PlanarLipschitzDomain) {w : SobolevAmbient}
+    (hw : w ∈ smoothGraph Ω.carrier) :
+    ‖w.1‖ ≤ poincareConstant Ω.carrier * ‖w.2‖ := by
+  obtain ⟨φ, hφ, hv, hg⟩ := hw
+  have hvnorm := eLpNorm_congr_ae (p := 2) hv
+  have hgnorm := eLpNorm_congr_ae (p := 2) hg
+  have hbound := smooth_poincare_eLpNorm Ω hφ
+  rw [← hvnorm, ← hgnorm] at hbound
+  have hfinite : poincareFactor Ω.carrier * eLpNorm w.2 2 volume ≠ ⊤ :=
+    ENNReal.mul_ne_top (poincareFactor_ne_top Ω) (Lp.eLpNorm_ne_top w.2)
+  have hreal := ENNReal.toReal_mono hfinite hbound
+  rw [ENNReal.toReal_mul, ← Lp.norm_def, ← Lp.norm_def] at hreal
+  exact hreal.trans (mul_le_mul_of_nonneg_right
+    (by simp [poincareConstant]) (norm_nonneg _))
+
+/-- Coercivity on the entire graph closure, not merely on smooth functions. -/
+theorem h01Graph_poincare (Ω : PlanarLipschitzDomain) {w : SobolevAmbient}
+    (hw : w ∈ h01Graph Ω.carrier) :
+    ‖w.1‖ ≤ poincareConstant Ω.carrier * ‖w.2‖ := by
+  have hclosed : IsClosed {z : SobolevAmbient |
+      ‖z.1‖ ≤ poincareConstant Ω.carrier * ‖z.2‖} :=
+    isClosed_le continuous_fst.norm (continuous_const.mul continuous_snd.norm)
+  exact closure_minimal (fun z hz => smoothGraph_poincare Ω hz) hclosed hw
+
+theorem h01Graph_zero_gradient (Ω : PlanarLipschitzDomain) {w : SobolevAmbient}
+    (hw : w ∈ h01Graph Ω.carrier) (hg : w.2 = 0) : w = 0 := by
+  have hp := h01Graph_poincare Ω hw
+  have hu : w.1 = 0 := norm_eq_zero.mp (le_antisymm (by simpa [hg] using hp) (norm_nonneg _))
+  exact Prod.ext hu hg
+
+/-- A uniform strictly positive lower bound for every nonzero Rayleigh
+quotient in the graph.  This is ordinary Poincaré coercivity, not Pólya's bound. -/
+theorem h01Graph_rayleigh_lower (Ω : PlanarLipschitzDomain) {w : SobolevAmbient}
+    (hw : w ∈ h01Graph Ω.carrier) (hne : w ≠ 0) :
+    ENNReal.ofReal (1 / poincareConstant Ω.carrier ^ 2) ≤ rayleigh w := by
+  have hC := poincareConstant_pos Ω.carrier
+  have hm := h01Graph_mass_pos hw hne
+  have hp := h01Graph_poincare Ω hw
+  have hs : mass w ≤ poincareConstant Ω.carrier ^ 2 * energy w := by
+    have hsq := (sq_le_sq₀ (norm_nonneg w.1)
+      (mul_nonneg hC.le (norm_nonneg w.2))).mpr hp
+    simpa only [mass, energy, mul_pow] using hsq
+  rw [rayleigh, ← ENNReal.ofReal_div_of_pos hm]
+  apply ENNReal.ofReal_le_ofReal
+  apply (div_le_div_iff₀ (sq_pos_of_pos hC) hm).mpr
+  simpa only [one_mul, mul_comm] using hs
+
+/-- Positive-index min–max values have a uniform positive lower bound. -/
+theorem dirichletMinmax_lower (Ω : PlanarLipschitzDomain) {k : ℕ} (hk : 0 < k) :
+    ENNReal.ofReal (1 / poincareConstant Ω.carrier ^ 2) ≤
+      dirichletMinmax Ω.carrier k := by
+  apply le_iInf
+  intro V
+  let := V.finiteDimensional
+  have hd : 0 < Module.finrank ℝ V.space := by rw [V.dimension]; exact hk
+  obtain ⟨w, hw⟩ := Module.finrank_pos_iff_exists_ne_zero.mp hd
+  have hcoe : (w : SobolevAmbient) ≠ 0 := by
+    intro h
+    apply hw
+    exact Subtype.ext h
+  exact (h01Graph_rayleigh_lower Ω (V.contained w.property) hcoe).trans
+    (le_iSup (fun z : {z : SobolevAmbient // z ∈ V.space ∧ z ≠ 0} => rayleigh z.val)
+      ⟨w, w.property, hcoe⟩)
+
+theorem dirichletMinmax_pos (Ω : PlanarLipschitzDomain) {k : ℕ} (hk : 0 < k) :
+    0 < dirichletMinmax Ω.carrier k := by
+  apply lt_of_lt_of_le _ (dirichletMinmax_lower Ω hk)
+  exact ENNReal.ofReal_pos.mpr (one_div_pos.mpr (sq_pos_of_pos (poincareConstant_pos Ω.carrier)))
+
+end Math30.Polya
