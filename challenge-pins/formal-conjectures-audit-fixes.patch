+import Mathlib.Analysis.Calculus.Gradient.Basic
+import Mathlib.Analysis.Distribution.ContDiffMapSupportedIn
+import Mathlib.Analysis.InnerProductSpace.PiL2
+import Mathlib.Analysis.Convex.Basic
+import Mathlib.Analysis.SpecialFunctions.Trigonometric.Basic
+import Mathlib.MeasureTheory.Function.L2Space
+import Mathlib.MeasureTheory.Measure.Lebesgue.EqHaar
+import Mathlib.Analysis.Normed.Lp.MeasurableSpace
+
+/-!
+# Targets 25–27: planar Dirichlet Pólya inequalities
+
+The spectral quantity below is constructed from the actual Euclidean gradient,
+Lebesgue `L²` spaces, and the closure of the `C∞c(Ω)` gradient graph.  There is no
+eigenvalue parameter, spectral oracle, or assumed Pólya estimate.
+
+`h01Graph Ω` is the zero-extension graph realization of `H₀¹(Ω)`.  Its topology is
+the product `L² × L²` topology, equivalent to the usual Sobolev graph norm.
+`dirichletMinmax Ω k` is the extended-real Courant–Fischer variational value.
+Using `ℝ≥0∞` for the infimum and supremum avoids the arbitrary empty/unbounded
+set conventions of conditionally complete `ℝ`.  `dirichletEigenvalue` takes its
+real value; the intended uses all have `k ≥ 1` and a bounded nonempty open domain.
+
+The companion modules prove the graph is a closed linear subspace, its
+distributional integration-by-parts identity and gradient closability,
+injectivity of its value projection, Poincaré coercivity, actual trial spaces
+of every finite dimension, and finite positive ordered min–max values.  They
+also prove that real conversion is lossless, and give exact variational
+equivalences for the three unchanged targets.  `PolyaReadiness` proves that the
+product graph topology is the standard square-sum Sobolev norm topology.
+
+The package adopts the standard Courant–Fischer variational definition of the
+Dirichlet spectral values, with k-dimensional spaces encoding multiplicities.
+It does not separately construct an unbounded Laplace operator, prove Rellich
+compactness, or claim an operator-identification theorem.  That separate
+operator reconstruction is not silently assumed as an axiom.  The Pólya
+targets themselves remain named `Prop` definitions, not claimed proofs.
+
+Sources: Jiang–Lin, arXiv:2507.04307v3, §1.1, and Frank–Larson,
+arXiv:2410.04769v2, §1.  The dimension-two specialization is `A λₖ ≥ 4πk`.
+The exact H₀¹ closure and whole-space min–max convention is also stated in
+De Philippis–Lamboley–Pierre–Velichkov, *Regularity of minimizers of shape
+optimization problems involving perimeter*, §§2.1 and 2.4.
+-/
+
+noncomputable section
+
+open Set MeasureTheory
+open scoped ENNReal NNReal Topology ContDiff
+
+namespace Math30.Polya
+
+/-- Euclidean two-space, with its Euclidean norm and canonical Lebesgue measure. -/
+abbrev Plane := EuclideanSpace ℝ (Fin 2)
+
+/-- The boundary is locally a one-sided Lipschitz graph after an orthogonal
+change of coordinates and translation.  The graph function is globally
+Lipschitz; a local graph function can be extended without changing the local
+condition.  Disconnected domains are allowed. -/
+def HasLipschitzBoundary (Ω : Set Plane) : Prop :=
+  ∀ p ∈ frontier Ω, ∃ r : ℝ, 0 < r ∧
+    ∃ R : Plane ≃ₗᵢ[ℝ] Plane, ∃ f : ℝ → ℝ, ∃ K : ℝ≥0,
+      LipschitzWith K f ∧ f 0 = 0 ∧
+      ∀ x ∈ Metric.ball p r,
+        (x ∈ Ω ↔ f ((R (x - p)) 0) < (R (x - p)) 1)
+
+/-- Exactly the geometric hypotheses used in targets 25–27.  Finiteness of
+area is recorded explicitly, though it also follows from boundedness here. -/
+structure PlanarLipschitzDomain where
+  carrier : Set Plane
+  isOpen : IsOpen carrier
+  nonempty : carrier.Nonempty
+  bounded : Bornology.IsBounded carrier
+  lipschitzBoundary : HasLipschitzBoundary carrier
+  finiteArea : volume carrier ≠ (⊤ : ℝ≥0∞)
+
+/-- Actual Lebesgue area, converted to a real number. -/
+def area (Ω : Set Plane) : ℝ := (volume Ω).toReal
+
+theorem area_pos (Ω : PlanarLipschitzDomain) : 0 < area Ω.carrier := by
+  exact ENNReal.toReal_pos (ne_of_gt (Ω.isOpen.measure_pos volume Ω.nonempty)) Ω.finiteArea
+
+/-- Values and vector-valued weak gradients, both modulo almost-everywhere
+equality with respect to actual planar Lebesgue measure. -/
+abbrev SobolevAmbient :=
+  Lp ℝ 2 (volume : Measure Plane) × Lp Plane 2 (volume : Measure Plane)
+
+/-- A genuine compactly supported smooth function inside Ω. -/
+def IsTestFunction (Ω : Set Plane) (φ : Plane → ℝ) : Prop :=
+  ContDiff ℝ ∞ φ ∧ HasCompactSupport φ ∧ tsupport φ ⊆ Ω
+
+/-- The smooth gradient graph inside the two actual `L²` spaces. -/
+def smoothGraph (Ω : Set Plane) : Set SobolevAmbient :=
+  {w | ∃ φ : Plane → ℝ, IsTestFunction Ω φ ∧
+    (∀ᵐ x ∂(volume : Measure Plane), w.1 x = φ x) ∧
+    (∀ᵐ x ∂(volume : Measure Plane), w.2 x = gradient φ x)}
+
+/-- Zero-boundary Sobolev space represented by its value/gradient graph.
+This is a concrete closure, not an unspecified Sobolev-space predicate. -/
+def h01Graph (Ω : Set Plane) : Set SobolevAmbient := closure (smoothGraph Ω)
+
+theorem isTestFunction_mono {Ω Ω' : Set Plane} (h : Ω ⊆ Ω')
+    {φ : Plane → ℝ} (hφ : IsTestFunction Ω φ) : IsTestFunction Ω' φ :=
+  ⟨hφ.1, hφ.2.1, hφ.2.2.trans h⟩
+
+theorem smoothGraph_mono {Ω Ω' : Set Plane} (h : Ω ⊆ Ω') :
+    smoothGraph Ω ⊆ smoothGraph Ω' := by
+  rintro w ⟨φ, hφ, hu, hg⟩
+  exact ⟨φ, isTestFunction_mono h hφ, hu, hg⟩
+
+theorem h01Graph_mono {Ω Ω' : Set Plane} (h : Ω ⊆ Ω') :
+    h01Graph Ω ⊆ h01Graph Ω' := closure_mono (smoothGraph_mono h)
+
+theorem smoothGraph_subset_h01Graph (Ω : Set Plane) :
+    smoothGraph Ω ⊆ h01Graph Ω := subset_closure
+
+theorem isClosed_h01Graph (Ω : Set Plane) : IsClosed (h01Graph Ω) := isClosed_closure
+
+theorem zero_mem_smoothGraph (Ω : Set Plane) : (0 : SobolevAmbient) ∈ smoothGraph Ω := by
+  refine ⟨0, ⟨contDiff_const, HasCompactSupport.zero, ?_⟩, ?_, ?_⟩
+  · simp
+  · exact Lp.coeFn_zero ℝ 2 volume
+  · change ∀ᵐ x ∂(volume : Measure Plane),
+      (0 : Lp Plane 2 (volume : Measure Plane)) x = gradient (fun _ : Plane => (0 : ℝ)) x
+    filter_upwards [Lp.coeFn_zero Plane 2 (volume : Measure Plane)] with x hx
+    rw [gradient_fun_const]
+    exact hx
+
+theorem zero_mem_h01Graph (Ω : Set Plane) : (0 : SobolevAmbient) ∈ h01Graph Ω :=
+  smoothGraph_subset_h01Graph Ω (zero_mem_smoothGraph Ω)
+
+/-- `k`-dimensional trial spaces in the concrete Sobolev graph.  These premises
+contain no bound on a Rayleigh quotient or eigenvalue. -/
+structure TrialSpace (Ω : Set Plane) (k : ℕ) where
+  space : Submodule ℝ SobolevAmbient
+  finiteDimensional : FiniteDimensional ℝ space
+  dimension : Module.finrank ℝ space = k
+  contained : (space : Set SobolevAmbient) ⊆ h01Graph Ω
+
+/-- Squared `L²` norm of the value component: the integral of `u²`. -/
+def mass (w : SobolevAmbient) : ℝ := ‖w.1‖ ^ 2
+
+/-- Squared `L²` norm of the Euclidean gradient: the Dirichlet energy. -/
+def energy (w : SobolevAmbient) : ℝ := ‖w.2‖ ^ 2
+
+theorem mass_eq_integral (w : SobolevAmbient) :
+    mass w = ∫ x : Plane, (w.1 x) ^ 2 := by
+  rw [mass, ← real_inner_self_eq_norm_sq, L2.inner_def]
+  congr 1
+  ext x
+  simp only [Real.inner_apply, pow_two]
+
+theorem energy_eq_integral (w : SobolevAmbient) :
+    energy w = ∫ x : Plane, ‖w.2 x‖ ^ 2 := by
+  rw [energy, ← real_inner_self_eq_norm_sq, L2.inner_def]
+  congr 1
+  ext x
+  exact real_inner_self_eq_norm_sq _
+
+theorem mass_pos {w : SobolevAmbient} (h : w.1 ≠ 0) : 0 < mass w := by
+  exact sq_pos_of_pos (norm_pos_iff.mpr h)
+
+theorem energy_nonneg (w : SobolevAmbient) : 0 ≤ energy w := sq_nonneg _
+
+/-- Extended-real Rayleigh quotient.  `PolyaClosability` proves its denominator
+is positive for every nonzero element of the actual Sobolev graph. -/
+def rayleigh (w : SobolevAmbient) : ℝ≥0∞ :=
+  ENNReal.ofReal (energy w) / ENNReal.ofReal (mass w)
+
+theorem rayleigh_lt_top {w : SobolevAmbient} (h : w.1 ≠ 0) : rayleigh w < (⊤ : ℝ≥0∞) := by
+  exact ENNReal.div_lt_top ENNReal.ofReal_ne_top
+    (ne_of_gt (ENNReal.ofReal_pos.mpr (mass_pos h)))
+
+theorem rayleigh_zero : rayleigh (0 : SobolevAmbient) = 0 := by
+  simp [rayleigh, energy, mass]
+
+/-- The supremum of the Rayleigh quotient on a nonzero finite-dimensional
+trial space; `0` itself is excluded. -/
+def trialSup {Ω : Set Plane} {k : ℕ} (V : TrialSpace Ω k) : ℝ≥0∞ :=
+  ⨆ w : {w : SobolevAmbient // w ∈ V.space ∧ w ≠ 0}, rayleigh w.val
+
+/-- Courant–Fischer inf–sup, indexed by actual `k`-dimensional trial spaces.
+The dimension is why repeated eigenvalues are counted with multiplicity. -/
+def dirichletMinmax (Ω : Set Plane) (k : ℕ) : ℝ≥0∞ :=
+  ⨅ V : TrialSpace Ω k, trialSup V
+
+/-- Real form of the standard Dirichlet variational value. `PolyaFiniteness`
+proves all min–max values finite on admissible domains and this conversion
+lossless; its positive-index values are positive and nondecreasing. -/
+def dirichletEigenvalue (Ω : Set Plane) (k : ℕ) : ℝ :=
+  (dirichletMinmax Ω k).toReal
+
+theorem dirichletEigenvalue_nonneg (Ω : Set Plane) (k : ℕ) :
+    0 ≤ dirichletEigenvalue Ω k := ENNReal.toReal_nonneg
+
+theorem dirichletMinmax_le_trialSup {Ω : Set Plane} {k : ℕ}
+    (V : TrialSpace Ω k) : dirichletMinmax Ω k ≤ trialSup V := iInf_le _ V
+
+/-- Enlarging the geometric domain enlarges the available trial spaces. -/
+def TrialSpace.enlarge {Ω Ω' : Set Plane} {k : ℕ}
+    (V : TrialSpace Ω k) (h : Ω ⊆ Ω') : TrialSpace Ω' k where
+  space := V.space
+  finiteDimensional := V.finiteDimensional
+  dimension := V.dimension
+  contained := V.contained.trans (h01Graph_mono h)
+
+/-- Domain monotonicity of the actual extended-real variational construction. -/
+theorem dirichletMinmax_antitone {Ω Ω' : Set Plane} (h : Ω ⊆ Ω') (k : ℕ) :
+    dirichletMinmax Ω' k ≤ dirichletMinmax Ω k := by
+  apply le_iInf
+  intro V
+  exact (iInf_le (fun W : TrialSpace Ω' k => trialSup W) (V.enlarge h))
+
+/-- Target 25: the third planar Dirichlet Pólya inequality. -/
+def Target25 : Prop :=
+  ∀ Ω : PlanarLipschitzDomain,
+    12 * Real.pi ≤ area Ω.carrier * dirichletEigenvalue Ω.carrier 3
+
+/-- Target 26: the fourth planar Dirichlet Pólya inequality. -/
+def Target26 : Prop :=
+  ∀ Ω : PlanarLipschitzDomain,
+    16 * Real.pi ≤ area Ω.carrier * dirichletEigenvalue Ω.carrier 4
+
+/-- Target 27: all positive indices on convex planar domains. -/
+def Target27 : Prop :=
+  ∀ Ω : PlanarLipschitzDomain, Convex ℝ Ω.carrier →
+    ∀ k : ℕ, 1 ≤ k →
+      4 * Real.pi * (k : ℝ) ≤ area Ω.carrier * dirichletEigenvalue Ω.carrier k
+
+end Math30.Polya
