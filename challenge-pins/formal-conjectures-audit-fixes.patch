+import Math30.Polya
+import Mathlib.Tactic.NormNum
+import Mathlib.Tactic.Ring
+import Mathlib.Analysis.Calculus.BumpFunction.FiniteDimension
+import Mathlib.MeasureTheory.Function.LpSpace.Indicator
+
+/-!
+Sanity checks for the concrete definitions.  None proves or assumes a Pólya
+target.  The final two checks merely specialize an explicitly supplied
+hypothetical proof of target 27 to its third and fourth indices.
+-/
+
+noncomputable section
+
+open Set MeasureTheory
+open scoped ENNReal
+
+namespace Math30.Polya.Fixtures
+
+example (Ω : PlanarLipschitzDomain) : 0 < area Ω.carrier := area_pos Ω
+
+example (Ω : Set Plane) : (0 : SobolevAmbient) ∈ h01Graph Ω := zero_mem_h01Graph Ω
+
+example : rayleigh (0 : SobolevAmbient) = 0 := rayleigh_zero
+
+example (w : SobolevAmbient) (h : w.1 ≠ 0) : rayleigh w < ∞ := rayleigh_lt_top h
+
+example (w : SobolevAmbient) : mass w = ∫ x : Plane, (w.1 x) ^ 2 := mass_eq_integral w
+
+example (w : SobolevAmbient) : energy w = ∫ x : Plane, ‖w.2 x‖ ^ 2 := energy_eq_integral w
+
+/-- Genuine domain monotonicity of the constructed variational quantity. -/
+example (Ω Ω' : Set Plane) (h : Ω ⊆ Ω') (k : ℕ) :
+    dirichletMinmax Ω' k ≤ dirichletMinmax Ω k := dirichletMinmax_antitone h k
+
+/-- The local graph boundary condition alone admits the empty set, while the
+actual target domain structure separately and explicitly excludes it. -/
+example : HasLipschitzBoundary (∅ : Set Plane) := by
+  simp [HasLipschitzBoundary]
+
+example : ¬(∅ : Set Plane).Nonempty := Set.not_nonempty_empty
+
+/-- A nonvacuous test of the one-sided local graph condition. This unbounded
+half-plane is only a boundary-definition fixture, not a target-domain witness. -/
+theorem upperHalfPlane_lipschitz :
+    HasLipschitzBoundary {x : Plane | 0 < x 1} := by
+  intro p hp
+  have hc : Continuous (fun x : Plane => x 1) :=
+    PiLp.continuous_apply 2 (fun _ : Fin 2 => ℝ) 1
+  have hboundary := hc.frontier_preimage_subset (Set.Ioi (0 : ℝ)) hp
+  have hp1 : p 1 = 0 := by simpa using hboundary
+  refine ⟨1, zero_lt_one, LinearIsometryEquiv.refl ℝ Plane, (fun _ => 0), 0,
+    LipschitzWith.const _, rfl, ?_⟩
+  intro x hx
+  simp [hp1]
+
+/-- Every target domain has an actual nonzero compactly supported smooth
+function.  This does not assume the existence of an eigenfunction. -/
+theorem exists_nonzero_testFunction (Ω : PlanarLipschitzDomain) :
+    ∃ φ : Plane → ℝ, IsTestFunction Ω.carrier φ ∧ φ ≠ 0 := by
+  obtain ⟨p, hp⟩ := Ω.nonempty
+  obtain ⟨φ, hsupp, hcompact, hsmooth, _, hone⟩ :=
+    exists_contDiff_tsupport_subset (n := ⊤) (Ω.isOpen.mem_nhds hp)
+  refine ⟨φ, ⟨hsmooth, hcompact, hsupp⟩, ?_⟩
+  intro hzero
+  have hz : φ p = 0 := congrFun hzero p
+  rw [hone] at hz
+  exact one_ne_zero hz
+
+/-- Nontriviality of the actual smooth graph, including its nonzero L² value
+component.  This checks the measure/gradient/Sobolev construction together. -/
+theorem exists_nonzero_smoothGraph (Ω : PlanarLipschitzDomain) :
+    ∃ w ∈ smoothGraph Ω.carrier, w.1 ≠ 0 := by
+  obtain ⟨φ, hφ, hnonzero⟩ := exists_nonzero_testFunction Ω
+  have hvalue : MemLp φ 2 (volume : Measure Plane) :=
+    hφ.1.continuous.memLp_of_hasCompactSupport hφ.2.1
+  have hgradContinuous : Continuous (gradient φ) :=
+    (InnerProductSpace.toDual ℝ Plane).symm.continuous.comp
+      (hφ.1.continuous_fderiv (by simp))
+  have hgradCompact : HasCompactSupport (gradient φ) := by
+    apply hφ.2.1.mono'
+    intro x hx
+    by_contra hnot
+    exact hx (by simp [gradient, fderiv_of_notMem_tsupport ℝ hnot])
+  have hgrad : MemLp (gradient φ) 2 (volume : Measure Plane) :=
+    hgradContinuous.memLp_of_hasCompactSupport hgradCompact
+  let u := hvalue.toLp φ
+  let g := hgrad.toLp (gradient φ)
+  refine ⟨(u, g), ⟨φ, hφ, hvalue.coeFn_toLp, hgrad.coeFn_toLp⟩, ?_⟩
+  intro hzero
+  change u = 0 at hzero
+  have huae : (fun x => u x) =ᵐ[(volume : Measure Plane)] (0 : Plane → ℝ) := by
+    rw [hzero]
+    exact Lp.coeFn_zero ℝ 2 volume
+  exact hnonzero (MeasureTheory.Measure.eq_of_ae_eq
+    (hvalue.coeFn_toLp.symm.trans huae) hφ.1.continuous continuous_const)
+
+theorem target27_third (h : Target27) (Ω : PlanarLipschitzDomain)
+    (hconvex : Convex ℝ Ω.carrier) :
+    12 * Real.pi ≤ area Ω.carrier * dirichletEigenvalue Ω.carrier 3 := by
+  have h3 := h Ω hconvex 3 (by norm_num)
+  norm_num at h3
+  convert h3 using 1
+  ring
+
+theorem target27_fourth (h : Target27) (Ω : PlanarLipschitzDomain)
+    (hconvex : Convex ℝ Ω.carrier) :
+    16 * Real.pi ≤ area Ω.carrier * dirichletEigenvalue Ω.carrier 4 := by
+  have h4 := h Ω hconvex 4 (by norm_num)
+  norm_num at h4
+  convert h4 using 1
+  ring
+
+end Math30.Polya.Fixtures
diff --git a/Math30/PolyaMinmax.lean b/Math30/PolyaMinmax.lean
