@@ -0,0 +1,45 @@
+import Mathlib.Data.Finset.Lattice.Union
+import Mathlib.Tactic
+
+namespace Math15.Frankl
+open Finset
+abbrev Family := Finset (Finset ℕ)
+def ground (F : Family) : Finset ℕ := F.biUnion id
+def frequency (F : Family) (x : ℕ) : ℕ := (F.filter (x ∈ ·)).card
+def UnionClosed (F : Family) : Prop := ∀ A ∈ F, ∀ B ∈ F, A ∪ B ∈ F
+/-- Height counts members, so a chain of six is forbidden. -/
+def HeightAtMostFive (F : Family) : Prop :=
+  ¬ ∃ c : Fin 6 → Finset ℕ, (∀ i, c i ∈ F) ∧
+    (∀ i j, i < j → c i ⊂ c j)
+def CounterexampleFive (F : Family) : Prop :=
+  F.Nonempty ∧ ∅ ∉ F ∧ UnionClosed F ∧ HeightAtMostFive F ∧
+  ∀ x ∈ ground F, 2 * frequency F x ≤ F.card
+/-- Global lexicographic minimality, across every finite family on ℕ. -/
+def MinimalFive (F : Family) : Prop :=
+  CounterexampleFive F ∧ ∀ G : Family, CounterexampleFive G →
+    F.card ≤ G.card ∧ (F.card = G.card → (ground F).card ≤ (ground G).card)
+def JoinIrreducible (F : Family) (B : Finset ℕ) : Prop :=
+  B ∈ F ∧ ∀ A ∈ F, ∀ C ∈ F, A ∪ C = B → A = B ∨ C = B
+def critical (F : Family) : Finset ℕ :=
+  (ground F).filter (fun x => 2 * frequency F x = F.card)
+def CriticalCover (F C : Family) : Prop :=
+  C ⊆ F ∧ (∀ B ∈ C, JoinIrreducible F B) ∧ critical F ⊆ ground C
+def RhoEq (F : Family) (r : ℕ) : Prop :=
+  (∃ C, CriticalCover F C ∧ C.card = r) ∧ ∀ C, CriticalCover F C → r ≤ C.card
+
+def Target07 : Prop := ∀ F, MinimalFive F → RhoEq F 4 →
+  (∃ C, CriticalCover F C ∧ C.card = 4 ∧ ground C ≠ ground F) → False
+def Target08 : Prop := ∀ F, MinimalFive F → RhoEq F 3 → False
+def Target09 : Prop := ∀ F, MinimalFive F → RhoEq F 4 →
+  (∃ C, CriticalCover F C ∧ C.card = 4 ∧ ground C = ground F) → False
+
+/-- The two existential cover cases exhaust rho=4, but need not be disjoint. -/
+theorem rho_four_split {F : Family} (h : RhoEq F 4) :
+    (∃ C, CriticalCover F C ∧ C.card = 4 ∧ ground C ≠ ground F) ∨
+    (∃ C, CriticalCover F C ∧ C.card = 4 ∧ ground C = ground F) := by
+  obtain ⟨C, hc, hn⟩ := h.1
+  by_cases he : ground C = ground F
+  · exact Or.inr ⟨C, hc, hn, he⟩
+  · exact Or.inl ⟨C, hc, hn, he⟩
+
+end Math15.Frankl
