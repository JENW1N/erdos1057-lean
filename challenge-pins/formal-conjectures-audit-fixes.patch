+import Math30.PolyaSobolev
+import Mathlib.Analysis.Calculus.LineDeriv.IntegrationByParts
+import Mathlib.Analysis.Distribution.AEEqOfIntegralContDiff
+
+/-!
+# Closability of the concrete smooth gradient graph
+
+Integration by parts persists under closure in the two actual Lebesgue L²
+spaces. The fundamental lemma for compactly supported smooth test functions
+then proves that a graph element with zero value has zero gradient.
+-/
+
+noncomputable section
+
+open Set MeasureTheory
+open scoped ENNReal NNReal Topology ContDiff
+
+namespace Math30.Polya
+
+private theorem continuous_test_pairing
+    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
+    (f : Plane → E) (hf : MemLp f 2 (volume : Measure Plane)) :
+    Continuous (fun g : Lp E 2 (volume : Measure Plane) =>
+      ∫ x : Plane, inner ℝ (f x) (g x)) := by
+  have hfun : (fun g : Lp E 2 (volume : Measure Plane) =>
+      ∫ x : Plane, inner ℝ (f x) (g x)) =
+      (fun g => inner ℝ (hf.toLp f) g) := by
+    funext g
+    rw [L2.inner_def]
+    apply integral_congr_ae
+    filter_upwards [hf.coeFn_toLp] with x hx
+    rw [hx]
+  rw [hfun]
+  exact continuous_const.inner continuous_id
+
+private theorem continuous_directional_test {ψ : Plane → ℝ}
+    (hψ : ContDiff ℝ ∞ ψ) (v : Plane) :
+    Continuous (fun x => fderiv ℝ ψ x v) :=
+  (hψ.continuous_fderiv (by simp)).clm_apply continuous_const
+
+private theorem compact_directional_test {ψ : Plane → ℝ}
+    (hψ : HasCompactSupport ψ) (v : Plane) :
+    HasCompactSupport (fun x => fderiv ℝ ψ x v) := by
+  apply hψ.mono'
+  intro x hx
+  by_contra hnot
+  exact hx (by simp [fderiv_of_notMem_tsupport ℝ hnot])
+
+/-- Every element of the graph closure satisfies the distributional gradient
+identity against an arbitrary compactly supported smooth test function. -/
+theorem h01Graph_integration_by_parts {Ω : Set Plane} {w : SobolevAmbient}
+    (hw : w ∈ h01Graph Ω) {ψ : Plane → ℝ}
+    (hψ : ContDiff ℝ ∞ ψ) (hcψ : HasCompactSupport ψ) (v : Plane) :
+    (∫ x : Plane, ψ x * inner ℝ v (w.2 x)) =
+      -(∫ x : Plane, fderiv ℝ ψ x v * w.1 x) := by
+  have hvec : MemLp (fun x : Plane => ψ x • v) 2 (volume : Measure Plane) :=
+    (hψ.continuous.smul continuous_const).memLp_of_hasCompactSupport hcψ.smul_right
+  have hdir : MemLp (fun x : Plane => fderiv ℝ ψ x v) 2 (volume : Measure Plane) :=
+    (continuous_directional_test hψ v).memLp_of_hasCompactSupport
+      (compact_directional_test hcψ v)
+  have hleft : Continuous (fun z : SobolevAmbient =>
+      ∫ x : Plane, ψ x * inner ℝ v (z.2 x)) := by
+    simpa only [Function.comp_def, inner_smul_left, conj_trivial] using
+      (continuous_test_pairing _ hvec).comp continuous_snd
+  have hright : Continuous (fun z : SobolevAmbient =>
+      -(∫ x : Plane, fderiv ℝ ψ x v * z.1 x)) := by
+    convert ((continuous_test_pairing _ hdir).comp
+      (continuous_fst : Continuous (fun z : SobolevAmbient => z.1))).neg using 1
+    ext z
+    simp [mul_comm]
+  have hclosed := isClosed_eq hleft hright
+  apply (closure_minimal (s := smoothGraph Ω) ?_ hclosed) hw
+  rintro z ⟨φ, hφ, hz₁, hz₂⟩
+  change (∫ x : Plane, ψ x * inner ℝ v (z.2 x)) =
+    -(∫ x : Plane, fderiv ℝ ψ x v * z.1 x)
+  have hL : (∫ x : Plane, ψ x * inner ℝ v (z.2 x)) =
+      ∫ x : Plane, ψ x * fderiv ℝ φ x v := by
+    apply integral_congr_ae
+    filter_upwards [hz₂] with x hx
+    rw [hx, inner_gradient_right]
+    rfl
+  have hR : (∫ x : Plane, fderiv ℝ ψ x v * z.1 x) =
+      ∫ x : Plane, fderiv ℝ ψ x v * φ x := by
+    apply integral_congr_ae
+    filter_upwards [hz₁] with x hx
+    rw [hx]
+  rw [hL, hR]
+  apply integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable
+  · exact ((continuous_directional_test hψ v).mul hφ.1.continuous).integrable_of_hasCompactSupport hφ.2.1.mul_left
+  · exact (hψ.continuous.mul (continuous_directional_test hφ.1 v)).integrable_of_hasCompactSupport hcψ.mul_right
+  · exact (hψ.continuous.mul hφ.1.continuous).integrable_of_hasCompactSupport hcψ.mul_right
+  · intro x _
+    exact hψ.differentiable (by simp) x
+  · intro x _
+    exact hφ.1.differentiable (by simp) x
+
+/-- Closability of the Euclidean gradient in actual Lebesgue L²: a graph
+closure element whose value component vanishes also has zero gradient. -/
+theorem h01Graph_zero_fst {Ω : Set Plane} {w : SobolevAmbient}
+    (hw : w ∈ h01Graph Ω) (hzero : w.1 = 0) : w.2 = 0 := by
+  have hlocal : LocallyIntegrable (fun x : Plane => w.2 x) volume :=
+    (Lp.memLp w.2).locallyIntegrable (by norm_num)
+  have hae : ∀ᵐ x : Plane ∂volume, w.2 x = 0 := by
+    apply ae_eq_zero_of_integral_contDiff_smul_eq_zero hlocal
+    intro ψ hψ hcψ
+    apply integral_eq_zero_of_forall_integral_inner_eq_zero ℝ _
+      (hlocal.integrable_smul_left_of_hasCompactSupport hψ.continuous hcψ)
+    intro v
+    have h := h01Graph_integration_by_parts hw hψ hcψ v
+    have hright : (∫ x : Plane, fderiv ℝ ψ x v * w.1 x) = 0 := by
+      rw [hzero]
+      calc
+        (∫ x : Plane, fderiv ℝ ψ x v * (0 : Lp ℝ 2 (volume : Measure Plane)) x) =
+            ∫ x : Plane, (0 : ℝ) := by
+          apply integral_congr_ae
+          filter_upwards [Lp.coeFn_zero ℝ 2 (volume : Measure Plane)] with x hx
+          simp
+        _ = 0 := integral_zero _ _
+    simpa only [inner_smul_right, hright, neg_zero] using h
+  apply Lp.ext
+  filter_upwards [hae, Lp.coeFn_zero Plane 2 (volume : Measure Plane)] with x hx hz
+  exact hx.trans hz.symm
+
+/-- The value component determines whether a graph element is zero. -/
+theorem h01Graph_eq_zero_of_fst_eq_zero {Ω : Set Plane} {w : SobolevAmbient}
+    (hw : w ∈ h01Graph Ω) (hzero : w.1 = 0) : w = 0 :=
+  Prod.ext hzero (h01Graph_zero_fst hw hzero)
+
+/-- The first projection is injective on the concrete Sobolev graph. -/
+theorem h01Graph_fst_injective (Ω : Set Plane) :
+    Set.InjOn Prod.fst (h01Graph Ω) := by
+  intro w hw z hz heq
+  apply sub_eq_zero.mp
+  apply h01Graph_eq_zero_of_fst_eq_zero (h01Graph_sub hw hz)
+  change w.1 - z.1 = 0
+  exact sub_eq_zero.mpr heq
+
+/-- A nonzero Sobolev graph element has strictly positive actual L² mass. -/
+theorem h01Graph_mass_pos {Ω : Set Plane} {w : SobolevAmbient}
+    (hw : w ∈ h01Graph Ω) (hne : w ≠ 0) : 0 < mass w :=
+  mass_pos (fun hzero => hne (h01Graph_eq_zero_of_fst_eq_zero hw hzero))
+
+/-- Every nonzero Sobolev graph element has a finite Rayleigh quotient. -/
+theorem h01Graph_rayleigh_lt_top {Ω : Set Plane} {w : SobolevAmbient}
+    (hw : w ∈ h01Graph Ω) (hne : w ≠ 0) : rayleigh w < (⊤ : ℝ≥0∞) :=
+  rayleigh_lt_top (fun hzero => hne (h01Graph_eq_zero_of_fst_eq_zero hw hzero))
+
+end Math30.Polya
