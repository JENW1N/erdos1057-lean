+import Math15.Ramsey
+import Math15.LonelyRunner
+import Math15.Frankl
+import Math15.Graceful
+import Math15.Collatz
+
+namespace Math15
+inductive CandidateId
+  | c01 | c02 | c03 | c04 | c05 | c06 | c07 | c08 | c09 | c10 | c11 | c12 | c13 | c14 | c15
+  deriving DecidableEq, Repr
+
+def statement : CandidateId → Prop
+  | .c01 => Ramsey.Target01
+  | .c02 => Ramsey.Target02
+  | .c03 => Ramsey.Target03
+  | .c04 => LonelyRunner.Target04
+  | .c05 => LonelyRunner.Target05
+  | .c06 => LonelyRunner.Target06
+  | .c07 => Frankl.Target07
+  | .c08 => Frankl.Target08
+  | .c09 => Frankl.Target09
+  | .c10 => Graceful.Target10
+  | .c11 => Graceful.Target11
+  | .c12 => Graceful.Target12
+  | .c13 => Collatz.Target13
+  | .c14 => Collatz.Target14
+  | .c15 => Collatz.Target15
+
+def Proof (id : CandidateId) : Prop := statement id
+def Refutation (id : CandidateId) : Prop := ¬ statement id
+
+theorem proof_refutation_incompatible {id : CandidateId}
+    (p : Proof id) (r : Refutation id) : False := r p
+
+/-- A disproof is a theorem of the exact negation, never a failed search. -/
+theorem refutation_iff (id : CandidateId) : Refutation id ↔ (statement id → False) := Iff.rfl
+end Math15
