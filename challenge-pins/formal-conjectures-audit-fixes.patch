@@ -0,0 +1,104 @@
+import Math30.PolyaFiniteness
+import Math30.PolyaDomainFixture
+import Mathlib.Analysis.Real.Sqrt
+
+/-!
+# Verified standard variational formulation of targets 25–27
+
+This module collects the exact normalization and well-formedness theorems for
+the unchanged target propositions.  Dirichlet spectral values are defined by
+the standard k-dimensional Courant–Fischer formula on H₀¹.  There is no
+independently constructed unbounded Laplace operator in this package, and no
+operator-identification theorem or Rellich theorem is claimed.
+
+The whole-space zero-extension H₀¹ closure and inf–sup convention match
+De Philippis–Lamboley–Pierre–Velichkov, *Regularity of minimizers of shape
+optimization problems involving perimeter*, §§2.1 and 2.4.
+-/
+
+noncomputable section
+open Set MeasureTheory Filter
+open scoped ENNReal Topology
+
+namespace Math30.Polya
+
+/-- The usual square-sum Sobolev graph norm, expressed in the actual L² factors. -/
+def sobolevGraphNorm (w : SobolevAmbient) : ℝ := Real.sqrt (mass w + energy w)
+
+theorem norm_le_sobolevGraphNorm (w : SobolevAmbient) : ‖w‖ ≤ sobolevGraphNorm w := by
+  rw [Prod.norm_def, max_le_iff]
+  constructor
+  · calc
+      ‖w.1‖ = Real.sqrt (mass w) := by simp [mass]
+      _ ≤ sobolevGraphNorm w := Real.sqrt_le_sqrt (le_add_of_nonneg_right (energy_nonneg w))
+  · calc
+      ‖w.2‖ = Real.sqrt (energy w) := by simp [energy]
+      _ ≤ sobolevGraphNorm w := Real.sqrt_le_sqrt (le_add_of_nonneg_left (sq_nonneg ‖w.1‖))
+
+theorem sobolevGraphNorm_le_two_norm (w : SobolevAmbient) :
+    sobolevGraphNorm w ≤ 2 * ‖w‖ := by
+  apply Real.sqrt_le_iff.mpr
+  refine ⟨mul_nonneg (by norm_num) (norm_nonneg w), ?_⟩
+  have hf := norm_fst_le w
+  have hg := norm_snd_le w
+  have hfn := norm_nonneg w.1
+  have hgn := norm_nonneg w.2
+  have hn := norm_nonneg w
+  dsimp [mass, energy]
+  nlinarith
+
+/-- The product topology used for the graph closure is exactly the topology
+of the standard square-sum Sobolev norm, as witnessed on every filter. -/
+theorem tendsto_zero_iff_sobolevGraphNorm {ι : Type*} {l : Filter ι}
+    {u : ι → SobolevAmbient} :
+    Tendsto u l (𝓝 0) ↔ Tendsto (fun i => sobolevGraphNorm (u i)) l (𝓝 0) := by
+  constructor
+  · intro h
+    have hc : Continuous sobolevGraphNorm :=
+      Real.continuous_sqrt.comp
+        ((continuous_fst.norm.pow 2).add (continuous_snd.norm.pow 2))
+    simpa [Function.comp_def, sobolevGraphNorm, mass, energy] using hc.continuousAt.tendsto.comp h
+  · intro h
+    apply tendsto_zero_iff_norm_tendsto_zero.mpr
+    exact squeeze_zero (fun _ => norm_nonneg _) (fun i => norm_le_sobolevGraphNorm (u i)) h
+
+/-- The canonical variational sequence has finite, positive, ordered values
+at every requested index.  This establishes no Pólya inequality. -/
+theorem dirichlet_variational_sequence_wellFormed (Ω : PlanarLipschitzDomain) :
+    (∀ k : ℕ, dirichletMinmax Ω.carrier k < ⊤) ∧
+    (∀ k : ℕ, 0 < k → 0 < dirichletEigenvalue Ω.carrier k) ∧
+    Monotone (dirichletEigenvalue Ω.carrier) :=
+  ⟨dirichletMinmax_lt_top Ω, fun _ hk => dirichletEigenvalue_pos Ω hk,
+    dirichletEigenvalue_monotone Ω⟩
+
+/-- Exact whole-space Courant–Fischer form of target 25. -/
+theorem target25_iff_variational : Target25 ↔
+    ∀ Ω : PlanarLipschitzDomain, ∀ V : TrialSpace Ω.carrier 3,
+      ENNReal.ofReal (12 * Real.pi / area Ω.carrier) ≤ trialSup V := by
+  unfold Target25
+  exact forall_congr' fun Ω => area_mul_dirichletEigenvalue_lower_bound_iff Ω 3 _
+
+/-- Exact whole-space Courant–Fischer form of target 26. -/
+theorem target26_iff_variational : Target26 ↔
+    ∀ Ω : PlanarLipschitzDomain, ∀ V : TrialSpace Ω.carrier 4,
+      ENNReal.ofReal (16 * Real.pi / area Ω.carrier) ≤ trialSup V := by
+  unfold Target26
+  exact forall_congr' fun Ω => area_mul_dirichletEigenvalue_lower_bound_iff Ω 4 _
+
+/-- Exact whole-space Courant–Fischer form of target 27. -/
+theorem target27_iff_variational : Target27 ↔
+    ∀ Ω : PlanarLipschitzDomain, Convex ℝ Ω.carrier → ∀ k : ℕ, 1 ≤ k →
+      ∀ V : TrialSpace Ω.carrier k,
+        ENNReal.ofReal (4 * Real.pi * (k : ℝ) / area Ω.carrier) ≤ trialSup V := by
+  unfold Target27
+  apply forall_congr'
+  intro Ω
+  apply forall_congr'
+  intro _
+  apply forall_congr'
+  intro k
+  apply forall_congr'
+  intro _
+  exact area_mul_dirichletEigenvalue_lower_bound_iff Ω k _
+
+end Math30.Polya
diff --git a/Math30/PolyaSobolev.lean b/Math30/PolyaSobolev.lean
