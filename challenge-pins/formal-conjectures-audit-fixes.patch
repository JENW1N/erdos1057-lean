@@ -0,0 +1,159 @@
+import Math30.Polya
+import Mathlib.Tactic.Linarith
+import Mathlib.Tactic.Ring
+import Mathlib.Tactic.NormNum
+
+/-! An explicit bounded nonempty planar Lipschitz domain. This fixture establishes
+nonvacuity of the geometric target class; it proves no spectral estimate. -/
+
+noncomputable section
+open Set MeasureTheory
+open scoped ENNReal NNReal
+
+namespace Math30.Polya.DomainFixture
+
+def gauge (x : Plane) : ℝ := |x 0| + |x 1|
+def diamond : Set Plane := {x | gauge x < 1}
+
+lemma continuous_gauge : Continuous gauge := by
+  exact ((PiLp.continuous_apply 2 _ 0).abs).add ((PiLp.continuous_apply 2 _ 1).abs)
+
+lemma diamond_isOpen : IsOpen diamond :=
+  isOpen_lt continuous_gauge continuous_const
+
+lemma diamond_nonempty : diamond.Nonempty := by
+  refine ⟨0, ?_⟩
+  norm_num [diamond, gauge]
+
+lemma diamond_bounded : Bornology.IsBounded diamond := by
+  apply (Metric.isBounded_ball (x := (0 : Plane)) (r := 1)).subset
+  intro x hx
+  have hg : |x 0| + |x 1| < 1 := hx
+  have hnorm : ‖x‖ ^ 2 = (x 0) ^ 2 + (x 1) ^ 2 := by
+    simpa [Fin.sum_univ_two] using EuclideanSpace.real_norm_sq_eq x
+  have ha := abs_nonneg (x 0)
+  have hb := abs_nonneg (x 1)
+  have hs0 := sq_abs (x 0)
+  have hs1 := sq_abs (x 1)
+  have hm := mul_nonneg ha hb
+  have hn := norm_nonneg x
+  have hsq : (|x 0| + |x 1|) ^ 2 < 1 := by nlinarith
+  have hnormlt : ‖x‖ < 1 := by nlinarith
+  simpa [Metric.mem_ball, dist_zero_right] using hnormlt
+
+lemma frontier_gauge {p : Plane} (hp : p ∈ frontier diamond) : gauge p = 1 := by
+  have h := continuous_gauge.frontier_preimage_subset (Iio 1) hp
+  simpa [frontier_Iio] using h
+
+private def swapAxes : Plane ≃ₗᵢ[ℝ] Plane :=
+  LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ (Equiv.swap 0 1)
+
+private lemma swapAxes_zero (x : Plane) : swapAxes x 0 = x 1 := by
+  rfl
+private lemma swapAxes_one (x : Plane) : swapAxes x 1 = x 0 := by
+  rfl
+private lemma gauge_swap (x : Plane) : gauge (swapAxes x) = gauge x := by
+  simp only [gauge, swapAxes_zero, swapAxes_one]
+  ring
+private lemma gauge_neg (x : Plane) : gauge (-x) = gauge x := by
+  simp [gauge]
+
+/-- An orthogonal coordinate system with negative normal coordinate at a
+nonzero diamond boundary point; the diamond gauge is unchanged. -/
+private lemma orient_boundary (p : Plane) (hp : gauge p = 1) :
+    ∃ R : Plane ≃ₗᵢ[ℝ] Plane,
+      (∀ x, gauge (R x) = gauge x) ∧ (R p) 1 < 0 := by
+  by_cases h1 : p 1 = 0
+  · have h0 : p 0 ≠ 0 := by
+      intro hz
+      simp [gauge, h1, hz] at hp
+    by_cases hn : p 0 < 0
+    · exact ⟨swapAxes, gauge_swap, by simpa only [swapAxes_one] using hn⟩
+    · refine ⟨swapAxes.trans (LinearIsometryEquiv.neg ℝ), ?_, ?_⟩
+      · intro x
+        simpa only [LinearIsometryEquiv.trans_apply, LinearIsometryEquiv.coe_neg,
+          gauge_neg] using gauge_swap x
+      · change -(swapAxes p 1) < 0
+        rw [swapAxes_one]
+        have hpos : 0 < p 0 := lt_of_le_of_ne (le_of_not_gt hn) (Ne.symm h0)
+        linarith
+  · by_cases hn : p 1 < 0
+    · exact ⟨LinearIsometryEquiv.refl ℝ Plane, fun _ => rfl, hn⟩
+    · refine ⟨LinearIsometryEquiv.neg ℝ, ?_, ?_⟩
+      · exact gauge_neg
+      · change -(p 1) < 0
+        have hpos : 0 < p 1 := lt_of_le_of_ne (le_of_not_gt hn) (Ne.symm h1)
+        linarith
+
+private lemma graph_lipschitz (a : ℝ) :
+    LipschitzWith 1 (fun s : ℝ => |a + s| - |a|) := by
+  rw [lipschitzWith_iff_dist_le_mul]
+  intro x y
+  simp only [NNReal.coe_one, one_mul, Real.dist_eq]
+  calc
+    |(|a + x| - |a|) - (|a + y| - |a|)| = abs (|a + x| - |a + y|) := by
+      congr 1
+      ring
+    _ ≤ |(a + x) - (a + y)| := abs_abs_sub_abs_le_abs_sub _ _
+    _ = |x - y| := by congr 1; ring
+
+lemma diamond_lipschitzBoundary : HasLipschitzBoundary diamond := by
+  intro p hp
+  obtain ⟨R, hR, hn⟩ := orient_boundary p (frontier_gauge hp)
+  have hopen : IsOpen {x : Plane | (R x) 1 < 0} :=
+    isOpen_lt ((PiLp.continuous_apply 2 _ 1).comp R.continuous) continuous_const
+  obtain ⟨r, hr, hball⟩ := Metric.isOpen_iff.mp hopen p hn
+  refine ⟨r, hr, R, (fun s : ℝ => |(R p) 0 + s| - |(R p) 0|), 1,
+    graph_lipschitz _, by simp, ?_⟩
+  intro x hx
+  have hxn : (R x) 1 < 0 := hball hx
+  have hpg : |(R p) 0| - (R p) 1 = 1 := by
+    have h := (hR p).trans (frontier_gauge hp)
+    simpa [gauge, abs_of_neg hn, sub_eq_add_neg] using h
+  have hxg : gauge x = |(R x) 0| - (R x) 1 := by
+    rw [← hR x]
+    simp [gauge, abs_of_neg hxn, sub_eq_add_neg]
+  change gauge x < 1 ↔ _
+  rw [hxg, map_sub]
+  change |(R x) 0| - (R x) 1 < 1 ↔
+    |(R p) 0 + ((R x) 0 - (R p) 0)| - |(R p) 0| < (R x) 1 - (R p) 1
+  have hadd : (R p) 0 + ((R x) 0 - (R p) 0) = (R x) 0 := by ring
+  rw [hadd]
+  constructor <;> intro h <;> linarith
+
+
+lemma diamond_convex : Convex ℝ diamond := by
+  intro x hx y hy a b ha hb hab
+  have hbound : gauge (a • x + b • y) ≤ a * gauge x + b * gauge y := by
+    have h0 := abs_add_le (a * x 0) (b * y 0)
+    have h1 := abs_add_le (a * x 1) (b * y 1)
+    simp only [abs_mul, abs_of_nonneg ha, abs_of_nonneg hb] at h0 h1
+    simp only [gauge, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]
+    nlinarith
+  change gauge (a • x + b • y) < 1
+  change gauge x < 1 at hx
+  change gauge y < 1 at hy
+  by_cases ha0 : a = 0
+  · have hb1 : b = 1 := by linarith
+    simpa [ha0, hb1] using hy
+  · have hap : 0 < a := lt_of_le_of_ne ha (Ne.symm ha0)
+    have hax : a * gauge x < a := by
+      simpa only [mul_one] using mul_lt_mul_of_pos_left hx hap
+    have hby : b * gauge y ≤ b := by
+      simpa only [mul_one] using mul_le_mul_of_nonneg_left (le_of_lt hy) hb
+    exact hbound.trans_lt (by linarith)
+
+/-- The concrete unit ℓ¹ diamond inhabits the full geometric domain class. -/
+def diamondDomain : PlanarLipschitzDomain where
+  carrier := diamond
+  isOpen := diamond_isOpen
+  nonempty := diamond_nonempty
+  bounded := diamond_bounded
+  lipschitzBoundary := diamond_lipschitzBoundary
+  finiteArea := diamond_bounded.measure_lt_top.ne
+
+theorem domain_class_nonempty : Nonempty PlanarLipschitzDomain := ⟨diamondDomain⟩
+
+theorem diamond_area_pos : 0 < area diamond := area_pos diamondDomain
+
+end Math30.Polya.DomainFixture
diff --git a/Math30/PolyaFiniteness.lean b/Math30/PolyaFiniteness.lean
new file mode 100644
index 0000000000000000000000000000000000000000..b5979fde146c0f3a9524a67a1b91916ff93b121c
--- /dev/null
+++ b/Math30/PolyaFiniteness.lean
@@ -0,0 +1,142 @@
+import Math30.PolyaClosability
+import Math30.PolyaTrialSpaces
+import Math30.PolyaMinmax
+import Math30.PolyaPoincare
+import Mathlib.Analysis.Normed.Module.FiniteDimension
+
+/-!
+# Finiteness of finite-dimensional Dirichlet trial spaces
+
+Finite-dimensionality and injectivity of the value projection suffice to
+bound the Rayleigh quotient.  This elementary part does not use Rellich
+compactness or any assertion of the Pólya conjecture.
+-/
+
+noncomputable section
+
+open Set MeasureTheory
+open scoped ENNReal NNReal
+
+namespace Math30.Polya
+
+/-- The quotient is uniformly bounded on a finite-dimensional graph subspace
+whose value projection is injective. -/
+theorem TrialSpace.trialSup_lt_top_of_value_injective {Ω : Set Plane} {k : ℕ}
+    (V : TrialSpace Ω k)
+    (hvalue : ∀ w ∈ V.space, w.1 = 0 → w = 0) : trialSup V < ∞ := by
+  let := V.finiteDimensional
+  let f : V.space →ₗ[ℝ] Lp ℝ 2 (volume : Measure Plane) :=
+    (LinearMap.fst ℝ _ _).comp V.space.subtype
+  have hf : Function.Injective f := by
+    intro x y hxy
+    apply Subtype.ext
+    apply sub_eq_zero.mp
+    apply hvalue (x - y) (V.space.sub_mem x.property y.property)
+    change x.val.1 - y.val.1 = 0
+    exact sub_eq_zero.mpr hxy
+  obtain ⟨K, hK, hbound⟩ := f.injective_iff_antilipschitz.mp hf
+  have hquot : ∀ w ∈ V.space, w ≠ 0 → rayleigh w ≤ ENNReal.ofReal ((K : ℝ) ^ 2) := by
+    intro w hw hnz
+    have hfst : w.1 ≠ 0 := fun hz => hnz (hvalue w hw hz)
+    have hnorm : ‖w.2‖ ≤ (K : ℝ) * ‖w.1‖ := by
+      exact (norm_snd_le w).trans (ZeroHomClass.bound_of_antilipschitz f hbound ⟨w, hw⟩)
+    have henergy : energy w ≤ (K : ℝ) ^ 2 * mass w := by
+      dsimp [energy, mass]
+      calc
+        ‖w.2‖ ^ 2 ≤ ((K : ℝ) * ‖w.1‖) ^ 2 :=
+          pow_le_pow_left₀ (norm_nonneg _) hnorm 2
+        _ = (K : ℝ) ^ 2 * ‖w.1‖ ^ 2 := mul_pow _ _ _
+    rw [rayleigh, ← ENNReal.ofReal_div_of_pos (mass_pos hfst)]
+    exact ENNReal.ofReal_le_ofReal ((div_le_iff₀ (mass_pos hfst)).mpr henergy)
+  apply lt_of_le_of_lt (b := ENNReal.ofReal ((K : ℝ) ^ 2)) ?_ ENNReal.ofReal_lt_top
+  unfold trialSup
+  exact iSup_le fun w => hquot w.val w.property.1 w.property.2
+
+/-- One suitable trial space proves the concrete min–max value finite. -/
+theorem dirichletMinmax_lt_top_of_trialSpace {Ω : Set Plane} {k : ℕ}
+    (V : TrialSpace Ω k)
+    (hvalue : ∀ w ∈ V.space, w.1 = 0 → w = 0) :
+    dirichletMinmax Ω k < ∞ :=
+  (dirichletMinmax_le_trialSup V).trans_lt
+    (V.trialSup_lt_top_of_value_injective hvalue)
+
+/-- Every finite-dimensional trial space in the actual Sobolev graph has a
+finite Rayleigh supremum.  The needed projection injectivity follows from the
+proved distributional closability theorem. -/
+theorem TrialSpace.trialSup_lt_top {Ω : Set Plane} {k : ℕ}
+    (V : TrialSpace Ω k) : trialSup V < ∞ := by
+  apply V.trialSup_lt_top_of_value_injective
+  intro w hw hz
+  exact h01Graph_eq_zero_of_fst_eq_zero (V.contained hw) hz
+
+/-- Existence of any k-dimensional trial space suffices for finite min–max. -/
+theorem dirichletMinmax_lt_top_of_nonempty {Ω : Set Plane} {k : ℕ}
+    (h : Nonempty (TrialSpace Ω k)) : dirichletMinmax Ω k < ∞ := by
+  obtain ⟨V⟩ := h
+  exact (dirichletMinmax_le_trialSup V).trans_lt V.trialSup_lt_top
+
+/-- The concrete Dirichlet min–max is finite at every natural index on every
+admissible domain. This follows from actual smooth trial spaces, not from any
+spectral oracle or conjectural estimate. -/
+theorem dirichletMinmax_lt_top (Ω : PlanarLipschitzDomain) (k : ℕ) :
+    dirichletMinmax Ω.carrier k < ∞ := by
+  obtain ⟨V, _⟩ := exists_trialSpace_injective Ω k
+  exact dirichletMinmax_lt_top_of_nonempty ⟨V⟩
+
+theorem dirichletMinmax_ne_top (Ω : PlanarLipschitzDomain) (k : ℕ) :
+    dirichletMinmax Ω.carrier k ≠ ∞ := (dirichletMinmax_lt_top Ω k).ne
+
+/-- Conversion to the real variational value loses no information: the
+extended-real min–max is never infinity on the target domain class. -/
+theorem ofReal_dirichletEigenvalue (Ω : PlanarLipschitzDomain) (k : ℕ) :
+    ENNReal.ofReal (dirichletEigenvalue Ω.carrier k) = dirichletMinmax Ω.carrier k :=
+  ENNReal.ofReal_toReal (dirichletMinmax_ne_top Ω k)
+
+/-- Real-valued domain monotonicity, now justified by proved finiteness. -/
+theorem dirichletEigenvalue_antitone (Ω Ω' : PlanarLipschitzDomain)
+    (h : Ω.carrier ⊆ Ω'.carrier) (k : ℕ) :
+    dirichletEigenvalue Ω'.carrier k ≤ dirichletEigenvalue Ω.carrier k :=
+  (ENNReal.toReal_le_toReal (dirichletMinmax_ne_top Ω' k)
+    (dirichletMinmax_ne_top Ω k)).mpr (dirichletMinmax_antitone h k)
+
+/-- An exact variational lower-bound criterion, using the now lossless real
+conversion.  This is an equivalence of concrete formulas, not a spectral
+identification theorem. -/
+theorem dirichletEigenvalue_lower_bound_iff (Ω : PlanarLipschitzDomain)
+    (k : ℕ) (c : ℝ) :
+    c ≤ dirichletEigenvalue Ω.carrier k ↔
+      ∀ V : TrialSpace Ω.carrier k, ENNReal.ofReal c ≤ trialSup V := by
+  rw [dirichletEigenvalue, ← ENNReal.ofReal_le_iff_le_toReal
+    (dirichletMinmax_ne_top Ω k)]
+  exact le_iInf_iff
+
+/-- Exact area-scaled variational reformulation of each Pólya target. -/
+theorem area_mul_dirichletEigenvalue_lower_bound_iff (Ω : PlanarLipschitzDomain)
+    (k : ℕ) (c : ℝ) :
+    c ≤ area Ω.carrier * dirichletEigenvalue Ω.carrier k ↔
+      ∀ V : TrialSpace Ω.carrier k,
+        ENNReal.ofReal (c / area Ω.carrier) ≤ trialSup V := by
+  rw [← dirichletEigenvalue_lower_bound_iff Ω k]
+  rw [div_le_iff₀ (area_pos Ω), mul_comm]
+
+/-- The finite real variational sequence is ordered nondecreasingly in its
+index, with k-dimensional subspaces encoding multiplicity. -/
+theorem dirichletEigenvalue_monotone (Ω : PlanarLipschitzDomain) :
+    Monotone (dirichletEigenvalue Ω.carrier) := by
+  intro i j hij
+  exact ENNReal.toReal_mono (dirichletMinmax_ne_top Ω j)
+    (dirichletMinmax_monotone Ω.carrier hij)
+
+/-- Every positive-index real variational value is strictly positive. -/
+theorem dirichletEigenvalue_pos (Ω : PlanarLipschitzDomain) {k : ℕ} (hk : 0 < k) :
+    0 < dirichletEigenvalue Ω.carrier k :=
+  ENNReal.toReal_pos (dirichletMinmax_pos Ω hk).ne' (dirichletMinmax_ne_top Ω k)
+
+/-- A proved ordinary coercive lower bound on each real variational value. -/
+theorem dirichletEigenvalue_poincare_lower (Ω : PlanarLipschitzDomain)
+    {k : ℕ} (hk : 0 < k) :
+    1 / poincareConstant Ω.carrier ^ 2 ≤ dirichletEigenvalue Ω.carrier k :=
+  (ENNReal.ofReal_le_iff_le_toReal (dirichletMinmax_ne_top Ω k)).mp
+    (dirichletMinmax_lower Ω hk)
+
+end Math30.Polya
