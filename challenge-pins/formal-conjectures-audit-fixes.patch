+import Mathlib.Algebra.Group.Submonoid.Basic
+import Mathlib.Algebra.MvPolynomial.PDeriv
+import Mathlib.Algebra.MvPolynomial.NoZeroDivisors
+import Mathlib.Data.Finset.Lattice.Fold
+import Mathlib.Data.Nat.Find
+import Mathlib.Basic.Real.Basic
+import Mathlib.Data.Set.Finite.Basic
+import Mathlib.Tactic
+
+/-!
+# Statement targets 22–24 and 28–30
+
+These declarations encode propositions; they do **not** assert proofs of the six targets.
+The supporting lemmas establish that the numerical-semigroup invariants exist and
+that their finite implementations have the intended meanings.
+
+Polynomial minimal graphs are scalar real polynomial functions on the whole of
+`ℝ^n`. The minimal-surface equation is imposed as an exact polynomial identity.
+See `WilfMinimal.md` for the interpretation, sources, and limitations.
+-/
+
+namespace Math30
+namespace Wilf
+
+/-- A proper numerical semigroup: an additive submonoid of the natural numbers
+with finite complement, excluding the whole of `ℕ`. -/
+structure NumericalSemigroup where
+  carrier : AddSubmonoid ℕ
+  finite_gaps : Set.Finite {n : ℕ | n ∉ carrier}
+  proper : carrier ≠ ⊤
+
+namespace NumericalSemigroup
+
+/-- `c` is a conductor threshold, not necessarily the least one. -/
+def IsConductor (S : NumericalSemigroup) (c : ℕ) : Prop :=
+  ∀ n : ℕ, c ≤ n → n ∈ S.carrier
+
+/-- Cofiniteness guarantees a conductor threshold. -/
+theorem exists_conductor (S : NumericalSemigroup) : ∃ c, S.IsConductor c := by
+  classical
+  let gaps := S.finite_gaps.toFinset
+  refine ⟨gaps.sup id + 1, ?_⟩
+  intro n hn
+  by_contra hnot
+  have hmem : n ∈ gaps := by simpa [gaps] using hnot
+  have hle : n ≤ gaps.sup id := Finset.le_sup (f := id) hmem
+  omega
+
+/-- The least conductor; no default value is used. -/
+noncomputable def conductor (S : NumericalSemigroup) : ℕ := by
+  classical
+  exact Nat.find S.exists_conductor
+
+theorem conductor_spec (S : NumericalSemigroup) : S.IsConductor S.conductor := by
+  classical
+  exact Nat.find_spec S.exists_conductor
+
+theorem conductor_le (S : NumericalSemigroup) {c : ℕ} (hc : S.IsConductor c) :
+    S.conductor ≤ c := by
+  classical
+  exact Nat.find_min' S.exists_conductor hc
+
+theorem conductor_pos (S : NumericalSemigroup) : 0 < S.conductor := by
+  by_contra h
+  have hc : S.conductor = 0 := by omega
+  apply S.proper
+  ext n
+  simp only [AddSubmonoid.mem_top, iff_true]
+  exact S.conductor_spec n (by omega)
+
+theorem exists_positive (S : NumericalSemigroup) : ∃ m : ℕ, 0 < m ∧ m ∈ S.carrier := by
+  exact ⟨S.conductor + 1, by omega, S.conductor_spec _ (by omega)⟩
+
+/-- The least positive element; its defining witness is proved to exist. -/
+noncomputable def multiplicity (S : NumericalSemigroup) : ℕ := by
+  classical
+  exact Nat.find S.exists_positive
+
+theorem multiplicity_pos (S : NumericalSemigroup) : 0 < S.multiplicity := by
+  classical
+  exact (Nat.find_spec S.exists_positive).1
+
+theorem multiplicity_mem (S : NumericalSemigroup) : S.multiplicity ∈ S.carrier := by
+  classical
+  exact (Nat.find_spec S.exists_positive).2
+
+theorem multiplicity_le (S : NumericalSemigroup) {n : ℕ}
+    (hn : 0 < n) (hmem : n ∈ S.carrier) : S.multiplicity ≤ n := by
+  classical
+  exact Nat.find_min' S.exists_positive ⟨hn, hmem⟩
+
+/-- A positive indecomposable element, equivalently an element of the unique
+minimal generating set of a numerical semigroup. -/
+def IsPrimitive (S : NumericalSemigroup) (n : ℕ) : Prop :=
+  n ∈ S.carrier ∧ 0 < n ∧
+    ∀ a b : ℕ, a ∈ S.carrier → b ∈ S.carrier → n = a + b → a = 0 ∨ b = 0
+
+theorem multiplicity_isPrimitive (S : NumericalSemigroup) :
+    S.IsPrimitive S.multiplicity := by
+  refine ⟨S.multiplicity_mem, S.multiplicity_pos, ?_⟩
+  intro a b ha hb heq
+  by_cases ha0 : a = 0
+  · exact Or.inl ha0
+  · by_cases hb0 : b = 0
+    · exact Or.inr hb0
+    · have hma := S.multiplicity_le (by omega : 0 < a) ha
+      omega
+
+/-- Every primitive lies below `c + m`, so there are only finitely many. -/
+theorem primitive_lt (S : NumericalSemigroup) {n : ℕ} (hn : S.IsPrimitive n) :
+    n < S.conductor + S.multiplicity := by
+  by_contra h
+  have hc := S.conductor_pos
+  have hm := S.multiplicity_pos
+  have hsub : n - S.multiplicity ∈ S.carrier :=
+    S.conductor_spec _ (by omega)
+  have heq : n = S.multiplicity + (n - S.multiplicity) := by omega
+  rcases hn.2.2 S.multiplicity (n - S.multiplicity) S.multiplicity_mem hsub heq with h | h
+  · omega
+  · omega
+
+/-- Exactly the positive indecomposables; the cutoff is justified by `primitive_lt`. -/
+noncomputable def primitiveElements (S : NumericalSemigroup) : Finset ℕ := by
+  classical
+  exact (Finset.range (S.conductor + S.multiplicity)).filter S.IsPrimitive
+
+@[simp] theorem mem_primitiveElements (S : NumericalSemigroup) (n : ℕ) :
+    n ∈ S.primitiveElements ↔ S.IsPrimitive n := by
+  classical
+  simp only [primitiveElements, Finset.mem_filter, Finset.mem_range]
+  exact ⟨And.right, fun h => ⟨S.primitive_lt h, h⟩⟩
+
+theorem finite_primitives (S : NumericalSemigroup) : Set.Finite {n | S.IsPrimitive n} := by
+  have heq : {n | S.IsPrimitive n} = (S.primitiveElements : Set ℕ) := by
+    ext n
+    simp
+  rw [heq]
+  exact S.primitiveElements.finite_toSet
+
+/-- The primitive elements really generate the semigroup. This is proved rather
+than assumed as an additional structure field. -/
+theorem closure_primitives (S : NumericalSemigroup) :
+    AddSubmonoid.closure {n | S.IsPrimitive n} = S.carrier := by
+  apply le_antisymm
+  · apply AddSubmonoid.closure_le.mpr
+    intro n hn
+    exact hn.1
+  · have hgen : ∀ n : ℕ, n ∈ S.carrier →
+        n ∈ AddSubmonoid.closure {n | S.IsPrimitive n} := by
+      intro n
+      induction n using Nat.strong_induction_on with
+      | h n ih =>
+        intro hn
+        by_cases hz : n = 0
+        · subst n
+          exact AddSubmonoid.zero_mem _
+        · by_cases hp : S.IsPrimitive n
+          · exact AddSubmonoid.subset_closure hp
+          · have hdec : ¬ ∀ a b : ℕ, a ∈ S.carrier → b ∈ S.carrier →
+                n = a + b → a = 0 ∨ b = 0 := by
+              intro hall
+              exact hp ⟨hn, by omega, hall⟩
+            push Not at hdec
+            obtain ⟨a, b, ha, hb, heq, ha0, hb0⟩ := hdec
+            rw [heq]
+            exact AddSubmonoid.add_mem _ (ih a (by omega) ha) (ih b (by omega) hb)
+    exact hgen
+
+/-- Embedding dimension is the number of positive indecomposable generators. -/
+noncomputable def embeddingDimension (S : NumericalSemigroup) : ℕ :=
+  S.primitiveElements.card
+
+theorem embeddingDimension_pos (S : NumericalSemigroup) : 0 < S.embeddingDimension := by
+  unfold embeddingDimension
+  apply Finset.card_pos.mpr
+  exact ⟨S.multiplicity, (S.mem_primitiveElements _).mpr S.multiplicity_isPrimitive⟩
+
+/-- The semigroup elements strictly below the conductor, including zero. -/
+noncomputable def leftElements (S : NumericalSemigroup) : Finset ℕ := by
+  classical
+  exact (Finset.range S.conductor).filter (fun n => n ∈ S.carrier)
+
+@[simp] theorem mem_leftElements (S : NumericalSemigroup) (n : ℕ) :
+    n ∈ S.leftElements ↔ n < S.conductor ∧ n ∈ S.carrier := by
+  classical
+  simp [leftElements]
+
+theorem zero_mem_leftElements (S : NumericalSemigroup) : 0 ∈ S.leftElements := by
+  exact (S.mem_leftElements 0).2 ⟨S.conductor_pos, S.carrier.zero_mem⟩
+
+noncomputable def leftCount (S : NumericalSemigroup) : ℕ := S.leftElements.card
+
+/-- Wilf's inequality in the `e · |L| ≥ c` convention. -/
+def SatisfiesWilf (S : NumericalSemigroup) : Prop :=
+  S.conductor ≤ S.embeddingDimension * S.leftCount
+
+end NumericalSemigroup
+end Wilf
+
+/-- Target 22: Wilf's inequality at embedding dimension four. -/
+def Problem22 : Prop :=
+  ∀ S : Wilf.NumericalSemigroup,
+    S.embeddingDimension = 4 → S.SatisfiesWilf
+
+/-- Target 23: Wilf's inequality when `c ≤ 4m`. -/
+def Problem23 : Prop :=
+  ∀ S : Wilf.NumericalSemigroup,
+    S.conductor ≤ 4 * S.multiplicity → S.SatisfiesWilf
+
+/-- Target 24: Wilf's inequality when `m ≤ 4e`, with no divisibility condition. -/
+def Problem24 : Prop :=
+  ∀ S : Wilf.NumericalSemigroup,
+    S.multiplicity ≤ 4 * S.embeddingDimension → S.SatisfiesWilf
+
+namespace MinimalGraphs
+
+/-- A scalar real polynomial on the entire `n`-dimensional real affine space. -/
+abbrev RealPolynomial (n : ℕ) := MvPolynomial (Fin n) ℝ
+
+/-- The numerator of the scalar minimal graph equation:
+`(1 + Σᵢ Pᵢ²) (Σᵢ Pᵢᵢ) − Σᵢ Σⱼ Pᵢ Pⱼ Pᵢⱼ`.
+The equation is a polynomial identity, not a finite set of numerical samples. -/
+noncomputable def minimalGraphOperator {n : ℕ} (P : RealPolynomial n) :
+    RealPolynomial n :=
+  (1 + ∑ i : Fin n, (MvPolynomial.pderiv i P) ^ 2) *
+      (∑ i : Fin n, MvPolynomial.pderiv i (MvPolynomial.pderiv i P)) -
+    ∑ i : Fin n, ∑ j : Fin n,
+      MvPolynomial.pderiv i P * MvPolynomial.pderiv j P *
+        MvPolynomial.pderiv i (MvPolynomial.pderiv j P)
+
+/-- Exact formal minimal-surface equation for an entire real scalar graph. -/
+def SatisfiesMinimalGraphEquation {n : ℕ} (P : RealPolynomial n) : Prop :=
+  minimalGraphOperator P = 0
+
+/-- Affineness includes constants and the zero polynomial. Mathlib's natural-valued
+`totalDegree` is zero on the zero polynomial; the bound `≤ 1` handles it correctly. -/
+def IsAffine {n : ℕ} (P : RealPolynomial n) : Prop := P.totalDegree ≤ 1
+
+end MinimalGraphs
+
+/-- Target 28: polynomial minimal graphs of degree at most four are affine,
+in every dimension. This is not restricted to dimension eight. -/
+def Problem28 : Prop :=
+  ∀ (n : ℕ) (P : MinimalGraphs.RealPolynomial n),
+    P.totalDegree ≤ 4 → MinimalGraphs.SatisfiesMinimalGraphEquation P →
+      MinimalGraphs.IsAffine P
+
+/-- Target 29: every entire scalar real polynomial minimal graph on `ℝ⁸` is affine,
+with no upper bound assumed on its degree. -/
+def Problem29 : Prop :=
+  ∀ P : MinimalGraphs.RealPolynomial 8,
+    MinimalGraphs.SatisfiesMinimalGraphEquation P → MinimalGraphs.IsAffine P
+
+/-- Target 30: in each dimension at least eight there is a uniform degree bound
+for scalar real polynomial minimal graphs. The bound is chosen before `P`. -/
+def Problem30 : Prop :=
+  ∀ n : ℕ, 8 ≤ n → ∃ B : ℕ,
+    ∀ P : MinimalGraphs.RealPolynomial n,
+      MinimalGraphs.SatisfiesMinimalGraphEquation P → P.totalDegree ≤ B
+
+end Math30
