@@ -0,0 +1,95 @@
+import Math30.Polya
+import Mathlib.Analysis.Calculus.FDeriv.Add
+import Mathlib.Topology.Algebra.Module.Basic
+
+/-!
+Linear and topological infrastructure for the concrete zero-boundary Sobolev
+graph used in the Pólya statements.  These are proofs about the existing graph;
+the definitions of the targets and of their spectral quantity are unchanged.
+-/
+
+noncomputable section
+open Set MeasureTheory
+open scoped Topology ContDiff
+
+namespace Math30.Polya
+
+theorem isTestFunction_add {Ω : Set Plane} {φ ψ : Plane → ℝ}
+    (hφ : IsTestFunction Ω φ) (hψ : IsTestFunction Ω ψ) :
+    IsTestFunction Ω (φ + ψ) := by
+  refine ⟨hφ.1.add hψ.1, hφ.2.1.add hψ.2.1, ?_⟩
+  exact (tsupport_add φ ψ).trans (union_subset hφ.2.2 hψ.2.2)
+
+theorem isTestFunction_smul {Ω : Set Plane} {φ : Plane → ℝ}
+    (hφ : IsTestFunction Ω φ) (c : ℝ) : IsTestFunction Ω (c • φ) := by
+  refine ⟨hφ.1.const_smul c, ?_, ?_⟩
+  · exact hφ.2.1.mono (Function.support_const_smul_subset c φ)
+  · exact (closure_mono (Function.support_const_smul_subset c φ)).trans hφ.2.2
+
+theorem gradient_add_of_smooth {φ ψ : Plane → ℝ}
+    (hφ : ContDiff ℝ ∞ φ) (hψ : ContDiff ℝ ∞ ψ) (x : Plane) :
+    gradient (φ + ψ) x = gradient φ x + gradient ψ x := by
+  simp only [gradient, fderiv_add (hφ.differentiable (by simp) x)
+    (hψ.differentiable (by simp) x), map_add]
+
+theorem gradient_smul_of_smooth {φ : Plane → ℝ}
+    (hφ : ContDiff ℝ ∞ φ) (c : ℝ) (x : Plane) :
+    gradient (c • φ) x = c • gradient φ x := by
+  rw [gradient, fderiv_const_smul (hφ.differentiable (by simp) x) c]
+  change (InnerProductSpace.toDual ℝ Plane).symm (c • fderiv ℝ φ x) = _
+  simp only [map_smul, gradient]
+
+theorem smoothGraph_add {Ω : Set Plane} {w z : SobolevAmbient}
+    (hw : w ∈ smoothGraph Ω) (hz : z ∈ smoothGraph Ω) :
+    w + z ∈ smoothGraph Ω := by
+  obtain ⟨φ, hφ, hwφ, hwg⟩ := hw
+  obtain ⟨ψ, hψ, hzψ, hzg⟩ := hz
+  refine ⟨φ + ψ, isTestFunction_add hφ hψ, ?_, ?_⟩
+  · filter_upwards [Lp.coeFn_add w.1 z.1, hwφ, hzψ] with x hadd hwx hzx
+    exact hadd.trans (by simp [hwx, hzx])
+  · filter_upwards [Lp.coeFn_add w.2 z.2, hwg, hzg] with x hadd hwx hzx
+    exact hadd.trans (by simp [hwx, hzx, gradient_add_of_smooth hφ.1 hψ.1])
+
+theorem smoothGraph_smul {Ω : Set Plane} {w : SobolevAmbient}
+    (hw : w ∈ smoothGraph Ω) (c : ℝ) : c • w ∈ smoothGraph Ω := by
+  obtain ⟨φ, hφ, hwφ, hwg⟩ := hw
+  refine ⟨c • φ, isTestFunction_smul hφ c, ?_, ?_⟩
+  · filter_upwards [Lp.coeFn_smul c w.1, hwφ] with x hsmul hwx
+    exact hsmul.trans (by simp [hwx])
+  · filter_upwards [Lp.coeFn_smul c w.2, hwg] with x hsmul hwx
+    exact hsmul.trans (by simp [hwx, gradient_smul_of_smooth hφ.1])
+
+/-- The actual smooth gradient graph is an ℝ-linear subspace. -/
+def smoothGraphSubmodule (Ω : Set Plane) : Submodule ℝ SobolevAmbient where
+  carrier := smoothGraph Ω
+  zero_mem' := zero_mem_smoothGraph Ω
+  add_mem' := smoothGraph_add
+  smul_mem' := fun c _ hw => smoothGraph_smul hw c
+
+@[simp] theorem smoothGraphSubmodule_coe (Ω : Set Plane) :
+    (smoothGraphSubmodule Ω : Set SobolevAmbient) = smoothGraph Ω := rfl
+
+/-- The actual closed Sobolev gradient graph as a submodule. -/
+def h01Submodule (Ω : Set Plane) : Submodule ℝ SobolevAmbient :=
+  (smoothGraphSubmodule Ω).topologicalClosure
+
+@[simp] theorem h01Submodule_coe (Ω : Set Plane) :
+    (h01Submodule Ω : Set SobolevAmbient) = h01Graph Ω := rfl
+
+theorem h01Graph_add {Ω : Set Plane} {w z : SobolevAmbient}
+    (hw : w ∈ h01Graph Ω) (hz : z ∈ h01Graph Ω) : w + z ∈ h01Graph Ω :=
+  (h01Submodule Ω).add_mem hw hz
+
+theorem h01Graph_smul {Ω : Set Plane} {w : SobolevAmbient}
+    (hw : w ∈ h01Graph Ω) (c : ℝ) : c • w ∈ h01Graph Ω :=
+  (h01Submodule Ω).smul_mem c hw
+
+theorem h01Graph_sub {Ω : Set Plane} {w z : SobolevAmbient}
+    (hw : w ∈ h01Graph Ω) (hz : z ∈ h01Graph Ω) : w - z ∈ h01Graph Ω :=
+  (h01Submodule Ω).sub_mem hw hz
+
+instance h01Submodule_isClosed (Ω : Set Plane) :
+    IsClosed ((h01Submodule Ω : Submodule ℝ SobolevAmbient) : Set SobolevAmbient) :=
+  isClosed_h01Graph Ω
+
+end Math30.Polya
diff --git a/Math30/PolyaTrialSpaces.lean b/Math30/PolyaTrialSpaces.lean
new file mode 100644
index 0000000000000000000000000000000000000000..ee426a98cee3d3857aed56c0e7913eb9694f0d0b
--- /dev/null
+++ b/Math30/PolyaTrialSpaces.lean
@@ -0,0 +1,170 @@
+import Math30.PolyaSobolev
+import Mathlib.Analysis.Calculus.BumpFunction.FiniteDimension
+import Mathlib.LinearAlgebra.Dimension.Constructions
+
+/-!
+Finite-dimensional trial spaces for the concrete planar Dirichlet graph.
+The construction uses compactly supported smooth functions separating a finite
+set of interior points. All L² representatives and all dimension and injectivity
+claims are proved, without spectral assumptions.
+-/
+
+noncomputable section
+open Set MeasureTheory
+open scoped Topology ContDiff
+
+namespace Math30.Polya
+
+/-- A test function gives an actual value/gradient pair in the smooth L² graph. -/
+theorem IsTestFunction.exists_smoothGraph {Ω : Set Plane} {φ : Plane → ℝ}
+    (hφ : IsTestFunction Ω φ) :
+    ∃ w ∈ smoothGraph Ω, (∀ᵐ x ∂(volume : Measure Plane), w.1 x = φ x) := by
+  have hvalue : MemLp φ 2 (volume : Measure Plane) :=
+    hφ.1.continuous.memLp_of_hasCompactSupport hφ.2.1
+  have hc : Continuous (gradient φ) :=
+    (InnerProductSpace.toDual ℝ Plane).symm.continuous.comp
+      (hφ.1.continuous_fderiv (by simp))
+  have hs : HasCompactSupport (gradient φ) := by
+    apply hφ.2.1.mono'
+    intro x hx
+    by_contra hnot
+    exact hx (by simp [gradient, fderiv_of_notMem_tsupport ℝ hnot])
+  have hg : MemLp (gradient φ) 2 (volume : Measure Plane) :=
+    hc.memLp_of_hasCompactSupport hs
+  exact ⟨(hvalue.toLp φ, hg.toLp (gradient φ)),
+    ⟨φ, hφ, hvalue.coeFn_toLp, hg.coeFn_toLp⟩, hvalue.coeFn_toLp⟩
+
+/-- Pointwise equality follows from L² equality for the continuous smooth
+representatives, so the smooth graph has no vertical elements. -/
+theorem smoothGraph_value_eq_zero {Ω : Set Plane} {w : SobolevAmbient}
+    (hw : w ∈ smoothGraph Ω) (hzero : w.1 = 0) : w = 0 := by
+  obtain ⟨φ, hφ, hv, hg⟩ := hw
+  have hφae : φ =ᵐ[(volume : Measure Plane)] (0 : Plane → ℝ) := by
+    have hwae : (fun x => w.1 x) =ᵐ[(volume : Measure Plane)] (0 : Plane → ℝ) := by
+      rw [hzero]
+      exact Lp.coeFn_zero ℝ 2 volume
+    filter_upwards [hv, hwae] with x hvx hwx
+    exact hvx.symm.trans hwx
+  have hφzero : φ = 0 := MeasureTheory.Measure.eq_of_ae_eq hφae
+    hφ.1.continuous continuous_const
+  have hgrad : w.2 = 0 := by
+    apply Lp.ext
+    filter_upwards [hg, Lp.coeFn_zero Plane 2 (volume : Measure Plane)] with x hx hz
+    simp only [hφzero, Pi.zero_def, gradient_fun_const] at hx
+    exact hx.trans hz.symm
+  exact Prod.ext hzero hgrad
+
+/-- Every finite collection of distinct interior points has compactly supported
+smooth interpolation functions with Kronecker-delta values. -/
+theorem exists_testFunction_interpolation {Ω : Set Plane} (hΩ : IsOpen Ω)
+    {k : ℕ} (p : Fin k → Plane) (hp : ∀ i, p i ∈ Ω) (hinj : Function.Injective p) :
+    ∃ φ : Fin k → Plane → ℝ,
+      (∀ i, IsTestFunction Ω (φ i)) ∧
+      (∀ i j, φ i (p j) = if i = j then 1 else 0) := by
+  classical
+  have hex (i : Fin k) : ∃ φ : Plane → ℝ,
+      IsTestFunction Ω φ ∧ ∀ j, φ (p j) = if i = j then 1 else 0 := by
+    let s : Set Plane := p '' {j | j ≠ i}
+    have hsfin : s.Finite := (Set.toFinite _).image p
+    have hpi : p i ∉ s := by
+      rintro ⟨j, hj, heq⟩
+      exact hj (hinj heq)
+    have hnhds : Ω \ s ∈ 𝓝 (p i) :=
+      (hΩ.sdiff hsfin.isClosed).mem_nhds ⟨hp i, hpi⟩
+    obtain ⟨φ, hsupp, hcompact, hsmooth, _, hone⟩ :=
+      exists_contDiff_tsupport_subset (n := ⊤) hnhds
+    refine ⟨φ, ⟨hsmooth, hcompact, hsupp.trans sdiff_subset⟩, ?_⟩
+    intro j
+    split_ifs with hij
+    · simpa [← hij] using hone
+    · apply image_eq_zero_of_notMem_tsupport
+      intro hmem
+      exact (hsupp hmem).2 ⟨j, Ne.symm hij, rfl⟩
+  choose φ hφ hvalues using hex
+  exact ⟨φ, hφ, hvalues⟩
+
+/-- Every nonempty open planar set contains arbitrarily many distinct points. -/
+theorem exists_injective_points {Ω : Set Plane} (hΩ : IsOpen Ω)
+    (hne : Ω.Nonempty) (k : ℕ) :
+    ∃ p : Fin k → Plane, (∀ i, p i ∈ Ω) ∧ Function.Injective p := by
+  obtain ⟨x, hx⟩ := hne
+  have hinfinite : Ω.Infinite := infinite_of_mem_nhds x (hΩ.mem_nhds hx)
+  let e := hinfinite.natEmbedding Ω
+  refine ⟨fun i => (e i.val).val, fun i => (e i.val).property, ?_⟩
+  intro i j hij
+  apply Fin.ext
+  exact e.injective (Subtype.ext hij)
+
+/-- Coercion of a finite sum of L² functions agrees almost everywhere with the
+pointwise sum of any chosen representatives. -/
+private theorem lp_finset_sum_ae {ι : Type*} [DecidableEq ι]
+    (s : Finset ι) (u : ι → Lp ℝ 2 (volume : Measure Plane))
+    (φ : ι → Plane → ℝ)
+    (h : ∀ i, ∀ᵐ x ∂(volume : Measure Plane), u i x = φ i x) :
+    ∀ᵐ x ∂(volume : Measure Plane), (∑ i ∈ s, u i) x = ∑ i ∈ s, φ i x := by
+  induction s using Finset.induction_on with
+  | empty =>
+    simp only [Finset.sum_empty]
+    exact Lp.coeFn_zero ℝ 2 (volume : Measure Plane)
+  | @insert a s ha ih =>
+    simp only [Finset.sum_insert ha]
+    filter_upwards [Lp.coeFn_add (u a) (∑ i ∈ s, u i), h a, ih] with x hadd hx hs
+    exact hadd.trans (congrArg₂ (· + ·) hx hs)
+
+/-- Actual smooth graph vectors whose L² value components are linearly independent. -/
+theorem exists_independent_smoothGraph {Ω : Set Plane} (hΩ : IsOpen Ω)
+    (hne : Ω.Nonempty) (k : ℕ) :
+    ∃ w : Fin k → SobolevAmbient,
+      (∀ i, w i ∈ smoothGraph Ω) ∧ LinearIndependent ℝ (fun i => (w i).1) := by
+  classical
+  obtain ⟨p, hp, hinj⟩ := exists_injective_points hΩ hne k
+  obtain ⟨φ, hφ, hvalues⟩ := exists_testFunction_interpolation hΩ p hp hinj
+  choose w hw hrep using fun i => (hφ i).exists_smoothGraph
+  refine ⟨w, hw, Fintype.linearIndependent_iff.mpr ?_⟩
+  intro c hc i
+  have hsum : ∀ᵐ x ∂(volume : Measure Plane),
+      (∑ j, c j • (w j).1) x = ∑ j, c j * φ j x := by
+    apply lp_finset_sum_ae
+    intro j
+    filter_upwards [Lp.coeFn_smul (c j) (w j).1, hrep j] with x hsmul hx
+    exact hsmul.trans (by simp [hx])
+  have hae : (fun x => ∑ j, c j * φ j x) =ᵐ[(volume : Measure Plane)]
+      (0 : Plane → ℝ) := by
+    rw [hc] at hsum
+    filter_upwards [hsum, Lp.coeFn_zero ℝ 2 (volume : Measure Plane)] with x hx hz
+    exact hx.symm.trans hz
+  have heq : (fun x => ∑ j, c j * φ j x) = (0 : Plane → ℝ) :=
+    MeasureTheory.Measure.eq_of_ae_eq hae
+      (continuous_finsetSum _ (fun j _ => continuous_const.mul (hφ j).1.continuous))
+      continuous_const
+  have hi := congrFun heq (p i)
+  simpa [hvalues] using hi
+
+/-- Arbitrarily large finite-dimensional trial spaces exist already inside the
+smooth graph, before taking its Sobolev closure. Their value projection is injective. -/
+theorem exists_trialSpace_injective (Ω : PlanarLipschitzDomain) (k : ℕ) :
+    ∃ V : TrialSpace Ω.carrier k,
+      Function.Injective (fun w : V.space => (w : SobolevAmbient).1) := by
+  classical
+  obtain ⟨w, hw, hli⟩ := exists_independent_smoothGraph Ω.isOpen Ω.nonempty k
+  let S := Submodule.span ℝ (Set.range w)
+  have hS : S ≤ smoothGraphSubmodule Ω.carrier := by
+    apply Submodule.span_le.mpr
+    rintro _ ⟨i, rfl⟩
+    exact hw i
+  have hliw : LinearIndependent ℝ w :=
+    hli.of_comp (LinearMap.fst ℝ (Lp ℝ 2 (volume : Measure Plane))
+      (Lp Plane 2 (volume : Measure Plane)))
+  let V : TrialSpace Ω.carrier k :=
+    { space := S
+      finiteDimensional := FiniteDimensional.span_of_finite ℝ (Set.finite_range w)
+      dimension := (finrank_span_eq_card hliw).trans (Fintype.card_fin k)
+      contained := fun _ hs => smoothGraph_subset_h01Graph _ (hS hs) }
+  refine ⟨V, ?_⟩
+  intro u v huv
+  apply Subtype.ext
+  apply sub_eq_zero.mp
+  apply smoothGraph_value_eq_zero (hS (S.sub_mem u.property v.property))
+  exact sub_eq_zero.mpr huv
+
+end Math30.Polya
