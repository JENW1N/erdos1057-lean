+import Math30.MatrixBoolean
+
+open scoped BigOperators
+
+noncomputable section
+
+namespace Math30.MatrixBoolean
+
+/-- The one-by-one entry is an actual linear form, not an arbitrary function. -/
+def scalarEntry (K : Type*) [Field K] : SquareMatrix K 1 →ₗ[K] K where
+  toFun A := A 0 0
+  map_add' _ _ := rfl
+  map_smul' _ _ := rfl
+
+ theorem scalar_multiplication_one_product (K : Type*) [Field K] :
+    HasBilinearAlgorithm K 1 1 := by
+  refine ⟨fun _ => scalarEntry K, fun _ => scalarEntry K, fun _ => 1, ?_⟩
+  intro A B
+  ext i j
+  fin_cases i
+  fin_cases j
+  simp [scalarEntry, Matrix.mul_apply]
+  rfl
+
+ theorem scalar_multiplication_not_zero_products (K : Type*) [Field K] :
+    ¬ HasBilinearAlgorithm K 1 0 := by
+  rintro ⟨a, b, c, h⟩
+  have hh := congrArg (fun M : SquareMatrix K 1 => M 0 0) (h 1 1)
+  simp at hh
+
+ theorem zero_tensor_rank_fixture (n r : ℕ) : TensorRankAtMost n r 0 := by
+  exact ⟨fun _ _ => 0, fun _ _ => 0, fun _ _ => 0, by simp⟩
+
+ theorem multiplication_border_rank_positive_fixture :
+    ¬ TensorBorderRankAtMost 3 0 (multiplicationTensor 3) := by
+  intro h
+  have heq := (tensorBorderRank_zero_iff (multiplicationTensor 3)).mp h
+  have hq := congrFun heq ((0, 0), (0, 0), (0, 0))
+  simp [multiplicationTensor] at hq
+
+ theorem zariski_empty_fixture {ι : Type*} :
+    zariskiClosure (∅ : Set (ι → ℂ)) = ∅ := by
+  ext x
+  constructor
+  · intro hx
+    have h1 := hx 1 (by simp)
+    simp at h1
+  · simp
+
+@[simp] theorem flipBlock_empty {n : ℕ} (x : BooleanInput n) : flipBlock x ∅ = x := by
+  funext i
+  simp [flipBlock]
+
+/-- Empty blocks cannot falsely increase block sensitivity. -/
+ theorem sensitiveBlockFamily_nonempty_blocks {n : ℕ} {f : BooleanFunction n}
+    {x : BooleanInput n} {F : Finset (Finset (Fin n))} (hF : SensitiveBlockFamily f x F)
+    {B : Finset (Fin n)} (hB : B ∈ F) : B.Nonempty := by
+  by_contra h
+  have hz : B = ∅ := Finset.not_nonempty_iff_eq_empty.mp h
+  have hc := hF.2 B hB
+  simp [hz] at hc
+
+ theorem flipBit_zero_eq_unit {n : ℕ} (i : Fin n) :
+    flipBit (zeroInput n) i = unitInput i := by
+  funext j
+  by_cases h : j = i <;> simp [flipBit, flipBlock, zeroInput, unitInput, h]
+
+/-- The normalization in statement19 really gives sensitivity14 at zero. -/
+ theorem statement19_witness_full_sensitivity
+    (f : BooleanFunction 14) (h0 : f (zeroInput 14) = false)
+    (h1 : ∀ i, f (unitInput i) = true) : sensitivityAt f (zeroInput 14) = 14 := by
+  simp [sensitivityAt, flipBit_zero_eq_unit, h0, h1]
+
+ theorem sensitivityAt_constant (n : ℕ) (b : Bool) (x : BooleanInput n) :
+    sensitivityAt (fun _ : BooleanInput n => b) x = 0 := by
+  simp [sensitivityAt]
+
+ theorem sensitivity_constant (n : ℕ) (b : Bool) :
+    sensitivity (fun _ : BooleanInput n => b) = 0 := by
+  simp [sensitivity, sensitivityAt_constant]
+
+ theorem sensitiveBlockFamily_constant_iff (n : ℕ) (b : Bool) (x : BooleanInput n)
+    (F : Finset (Finset (Fin n))) :
+    SensitiveBlockFamily (fun _ : BooleanInput n => b) x F ↔ F = ∅ := by
+  constructor
+  · intro h
+    apply Finset.eq_empty_iff_forall_notMem.mpr
+    intro B hB
+    exact h.2 B hB rfl
+  · intro h
+    subst F
+    simp [SensitiveBlockFamily]
+
+ theorem blockSensitivity_constant (n : ℕ) (b : Bool) :
+    blockSensitivity (fun _ : BooleanInput n => b) = 0 := by
+  simp [blockSensitivity, blockSensitivityAt, sensitiveBlockFamily_constant_iff]
+
+noncomputable def constantCoefficients (n : ℕ) (b : Bool) : MultilinearCoefficients n :=
+  fun S => if S = ∅ then boolReal b else 0
+
+ theorem constant_representation (n : ℕ) (b : Bool) :
+    Represents (fun _ : BooleanInput n => b) (constantCoefficients n b) := by
+  intro x
+  simp [evalMultilinear, constantCoefficients, ite_mul]
+
+ theorem exactRealDegree_constant (n : ℕ) (b : Bool) :
+    ExactRealDegree (fun _ : BooleanInput n => b) 0 := by
+  refine ⟨⟨constantCoefficients n b, constant_representation n b, ?_⟩, ?_⟩
+  · intro S hS
+    have hne : S ≠ ∅ := by intro he; simp [he] at hS
+    simp [constantCoefficients, hne]
+  · intro e he
+    omega
+
+/-- No zero-variable function can be a spurious nonconstant case. -/
+ theorem not_nonconstant_zero_dimension (f : BooleanFunction 0) : ¬ Nonconstant f := by
+  rintro ⟨x, y, hxy⟩
+  have h : x = y := Subsingleton.elim _ _
+  exact hxy (congrArg f h)
+
+/-- Degree-zero multilinear polynomials are constant on the entire cube. -/
+ theorem degree_zero_values_equal {n : ℕ} {f : BooleanFunction n}
+    (h : RealDegreeAtMost f 0) (x y : BooleanInput n) : f x = f y := by
+  classical
+  rcases h with ⟨c, hc, hdeg⟩
+  have heval (z : BooleanInput n) : evalMultilinear c z = c ∅ := by
+    unfold evalMultilinear
+    rw [Finset.sum_eq_single ∅]
+    · simp
+    · intro S _ hS
+      have hp : 0 < S.card := Finset.card_pos.mpr (Finset.nonempty_iff_ne_empty.mpr hS)
+      simp [hdeg S hp]
+    · simp
+  have hb : boolReal (f x) = boolReal (f y) := by rw [← hc x, ← hc y, heval, heval]
+  cases hx : f x <;> cases hy : f y <;> simp_all [boolReal]
+
+ theorem nonconstant_degree_positive {n d : ℕ} {f : BooleanFunction n}
+    (hf : Nonconstant f) (hd : ExactRealDegree f d) : 0 < d := by
+  rcases hf with ⟨x, y, hxy⟩
+  by_contra h
+  have hzero : d = 0 := by omega
+  subst d
+  exact hxy (degree_zero_values_equal hd.1 x y)
+
+noncomputable def dictatorCoefficients {n : ℕ} (i : Fin n) : MultilinearCoefficients n :=
+  fun S => if S = {i} then 1 else 0
+
+ theorem dictator_representation {n : ℕ} (i : Fin n) :
+    Represents (fun x => x i) (dictatorCoefficients i) := by
+  intro x
+  simp [evalMultilinear, dictatorCoefficients, ite_mul]
+
+ theorem dictator_exact_degree {n : ℕ} (i : Fin n) : ExactRealDegree (fun x => x i) 1 := by
+  constructor
+  · refine ⟨dictatorCoefficients i, dictator_representation i, ?_⟩
+    intro S hS
+    have hne : S ≠ {i} := by intro he; simp [he] at hS
+    simp [dictatorCoefficients, hne]
+  · intro d hd hrep
+    have hz : d = 0 := by omega
+    subst d
+    have hh := degree_zero_values_equal hrep (zeroInput n) (unitInput i)
+    simp [zeroInput, unitInput] at hh
+
+ theorem dictator_sensitivity_at {n : ℕ} (i : Fin n) (x : BooleanInput n) :
+    sensitivityAt (fun x => x i) x = 1 := by
+  classical
+  have hfilter : (Finset.univ.filter fun j => flipBit x j i ≠ x i) = {i} := by
+    ext j
+    by_cases h : j = i
+    · subst j
+      cases hx : x i <;> simp [flipBit, flipBlock, hx]
+    · simp [flipBit, flipBlock, h, Ne.symm h]
+  simp only [sensitivityAt, hfilter, Finset.card_singleton]
+
+/-- Two-bit full parity, used to test degree and individual versus joint flips. -/
+def parityTwo (x : BooleanInput 2) : Bool := Bool.xor (x 0) (x 1)
+
+noncomputable def parityTwoCoefficients : MultilinearCoefficients 2 := fun S =>
+  (if S = {0} then 1 else 0) + (if S = {1} then 1 else 0) -
+    2 * (if S = Finset.univ then 1 else 0)
+
+ theorem parityTwo_representation : Represents parityTwo parityTwoCoefficients := by
+  intro x
+  simp [evalMultilinear, parityTwoCoefficients, add_mul, sub_mul,
+    Finset.sum_add_distrib, Finset.sum_sub_distrib, ite_mul, mul_ite,
+    Fin.prod_univ_two, parityTwo, boolReal]
+  cases x 0 <;> cases x 1 <;> norm_num
+
+ theorem parityTwo_exact_degree : ExactRealDegree parityTwo 2 := by
+  constructor
+  · refine ⟨parityTwoCoefficients, parityTwo_representation, ?_⟩
+    intro S hS
+    have hc : S.card ≤ 2 := by simpa using Finset.card_le_card (Finset.subset_univ S)
+    omega
+  · intro d hd hrep
+    rcases hrep with ⟨c, hc, hdeg⟩
+    have heq := represents_unique hc parityTwo_representation
+    have hz := hdeg Finset.univ (by simpa using hd)
+    rw [heq] at hz
+    have hu0 : (Finset.univ : Finset (Fin 2)) ≠ {0} := by decide
+    have hu1 : (Finset.univ : Finset (Fin 2)) ≠ {1} := by decide
+    norm_num [parityTwoCoefficients, hu0, hu1] at hz
+
+ theorem parityTwo_separate_blocks_fixture :
+    SensitiveBlockFamily parityTwo (zeroInput 2) {{0}, {1}} := by
+  unfold SensitiveBlockFamily
+  decide
+
+ theorem parityTwo_joint_flip_fixture :
+    parityTwo (flipBlock (zeroInput 2) Finset.univ) = parityTwo (zeroInput 2) := by decide
+
+ theorem parityTwo_sensitivity_fixture : sensitivityAt parityTwo (zeroInput 2) = 2 := by decide
+
+end Math30.MatrixBoolean
