structure FixedFourierGeometry (c:fixedFrequencyEis) (h:fixedFrequencyEis⧸Ideal.span {c}) where
  a0 : fixedFrequencyEis
  c0 : fixedFrequencyEis
  denominator_ne_zero : c0≠0
  denominator_dvd : c0∣c
  coprime : IsCoprime a0 c0
  point : eisEmbedding a0/eisEmbedding c0=thetaFourierTranslation c h
  mode : Bool
  primary : if mode then lambda^2∣a0-1 else lambda^2∣c0-1
  shape : FixedCuspShape (ControlledStratumArithmetic.fixedCusp a0 c0 mode)

lemma exists_fixedFourierGeometry (c:fixedFrequencyEis) (hc:c≠0) (h:fixedFrequencyEis⧸Ideal.span {c}) :
    Nonempty (FixedFourierGeometry c h) := by
  obtain ⟨a0,c0,hc0,hdiv,hcop,hpoint,ha,hcp⟩:=
    ShortDraftCRT.exists_normalized_rational_cusp (-3*Quotient.out h) c hc
  have hp:eisEmbedding a0/eisEmbedding c0=thetaFourierTranslation c h := by
    rw [hpoint,thetaFourierTranslation,TraceLambdaPhase.eisLam_sq]
    simp only [map_mul,map_neg,map_ofNat]
  by_cases hl:lambda∣c0
  · obtain ⟨s⟩:=exists_fixedCuspShape (ControlledStratumArithmetic.fixedCusp a0 c0 true)
    exact ⟨⟨a0,c0,hc0,hdiv,hcop,hp,true,ha hl,s⟩⟩
  · obtain ⟨s⟩:=exists_fixedCuspShape (ControlledStratumArithmetic.fixedCusp a0 c0 false)
    exact ⟨⟨a0,c0,hc0,hdiv,hcop,hp,false,hcp hl,s⟩⟩

def fixedFourierGeometry (c:fixedFrequencyEis) (hc:c≠0) (h:fixedFrequencyEis⧸Ideal.span {c}) :
    FixedFourierGeometry c h := Classical.choice (exists_fixedFourierGeometry c hc h)

namespace FixedFourierGeometry
variable {c:fixedFrequencyEis} {h:fixedFrequencyEis⧸Ideal.span {c}} (G:FixedFourierGeometry c h)

abbrev PhaseResidue := fixedFrequencyEis⧸Ideal.span {ramifiedTraceLambda^3*G.c0}

theorem phaseResidue_finite : Finite G.PhaseResidue :=
  finite_quotient_span (A4_bad_modulus_ne_zero G.c0 G.denominator_ne_zero)

def levelScale : ℝ := fixedCuspLevelScale G.shape.index G.c0

lemma levelScale_pos : 0<G.levelScale :=
  fixedCuspLevelScale_pos G.shape.index G.c0 G.denominator_ne_zero

lemma levelScale_le (hc:c≠0) : G.levelScale≤fixedCuspLevelBound c :=
  fixedCuspLevelScale_le G.shape.index G.c0 c hc G.denominator_dvd

def dualNumerator (u:fixedFrequencyEisˣ) (m:ℕ) (I J:Ideal fixedFrequencyEis) : fixedFrequencyEis :=
  sourceCuspPhaseNumerator G.shape.index (G.shape.upper 0 0)
    (fixedCuspArrayIndex u m I J)

def staticPhase (v:G.PhaseResidue) (u:fixedFrequencyEisˣ) (m:ℕ) (I J:Ideal fixedFrequencyEis) : ℂ :=
  G.shape.reflectionStaticPhase G.c0 G.denominator_ne_zero v (G.dualNumerator u) u m I J

lemma staticPhase_norm_le_one (v:G.PhaseResidue) (u:fixedFrequencyEisˣ) (m:ℕ) (I J:Ideal fixedFrequencyEis) :
    ‖G.staticPhase v u m I J‖≤1 :=
  G.shape.reflectionStaticPhase_norm_le_one G.c0 G.denominator_ne_zero v _ u m I J

def array (v:G.PhaseResidue) (u:fixedFrequencyEisˣ) (m:ℕ) (I J:Ideal fixedFrequencyEis) : ℂ :=
  fixedCuspArrayWithPhase G.shape.index u (G.staticPhase v u) m I J

lemma array_norm_le_one (v:G.PhaseResidue) (u:fixedFrequencyEisˣ) (m:ℕ) (I J:Ideal fixedFrequencyEis) :
    ‖G.array v u m I J‖≤1 :=
  fixedCuspArrayWithPhase_norm_le_one G.shape.index u _ (G.staticPhase_norm_le_one v u) m I J




end FixedFourierGeometry

def FixedReflectionRay (c:fixedFrequencyEis) (hc:c≠0) :=
  Σh:fixedFrequencyEis⧸Ideal.span {c},(fixedFourierGeometry c hc h).PhaseResidue×fixedFrequencyEisˣ

theorem fixedReflectionRay_finite (c:fixedFrequencyEis) (hc:c≠0) : Finite (FixedReflectionRay c hc) := by
  let:Finite (fixedFrequencyEis⧸Ideal.span {c}):=finite_quotient_span hc
  let:Finite fixedFrequencyEisˣ:=PrimaryIdealUnitReindex.finite_units
  let (h : fixedFrequencyEis⧸Ideal.span {c}) : Finite (fixedFourierGeometry c hc h).PhaseResidue :=
    FixedFourierGeometry.phaseResidue_finite _
  unfold FixedReflectionRay
  infer_instance

noncomputable abbrev fixedReflectionRay_fintype (c:fixedFrequencyEis) (hc:c≠0) :
    Fintype (FixedReflectionRay c hc) := by
  let : Finite (FixedReflectionRay c hc) := fixedReflectionRay_finite c hc
  exact Fintype.ofFinite _

def fixedReflectionRayCount (c:fixedFrequencyEis) (hc:c≠0) : ℕ := by
  let : Fintype (FixedReflectionRay c hc) := fixedReflectionRay_fintype c hc
  exact Fintype.card (FixedReflectionRay c hc)

def fixedReflectionRayEquiv (c:fixedFrequencyEis) (hc:c≠0) :
    FixedReflectionRay c hc≃Fin (fixedReflectionRayCount c hc) := by
  let : Fintype (FixedReflectionRay c hc) := fixedReflectionRay_fintype c hc
  exact Fintype.equivFin _




