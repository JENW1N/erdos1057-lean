open Finset
open scoped Classical

/- Both small-prime and ordered pending-prime residues follow the same integer step. -/
def cleanHybridResidueDirection {S G : Type*} {Ps : S → Finset ℕ}
    {Pb : G → Finset ℕ} {N : G → ℕ} (p : FixedOrderedMemoryLabels Pb N) :
    ℤ →+ (PhysicalResidues Ps × FixedOrderedResidues p) where
  toFun n := (physicalResiduesOfInt Ps n, fixedOrderedResidueDirection p n)
  map_zero' := by
    apply Prod.ext
    · funext q
      exact Int.cast_zero
    · exact map_zero _
  map_add' a b := by
    apply Prod.ext
    · funext q
      exact Int.cast_add a b
    · exact map_add _ a b

theorem clean_hybrid_residue_translation {S G : Type*} {Ps : S → Finset ℕ}
    {Pb : G → Finset ℕ} {N : G → ℕ} (p : FixedOrderedMemoryLabels Pb N)
    (r : PhysicalResidues Ps × FixedOrderedResidues p) (n : ℤ) :
    r + cleanHybridResidueDirection p n =
      (physicalTranslateResidues r.1 n, fixedOrderedResidueTranslate p r.2 n) := rfl

/- The residue-independent coefficient after the two memory damping factors are
absorbed into the endpoint functions. -/
noncomputable def cleanHybridCoreCoefficient {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : G → Finset (Fin J)) (ζ θ : ℝ) (k : ℤ)
    (K : RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb C → ℂ)
    (d : PhysicalSharedLists Ps J) (aux : PhysicalAuxLabels Pb C)
    (source target : RepeatedBigLists Pb J ell) : ℂ :=
  repeatedBigKernel Vb b C ζ K aux source target *
    physicalReturnPhase θ (cleanHybridStep k C source aux d) *
    physicalPhase ζ (physicalSharedProduct d)

noncomputable def cleanHybridCoreAction {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : G → Finset (Fin J)) (ζ θ : ℝ) (k : ℤ)
    (p : FixedOrderedMemoryLabels Pb N)
    (K : RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb C → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : RepeatedBigLists Pb J ell → (PhysicalResidues Ps × FixedOrderedResidues p) → ℂ)
    (source : RepeatedBigLists Pb J ell) (r : PhysicalResidues Ps × FixedOrderedResidues p) : ℂ :=
  ∑ aux, ∑ target, cleanHybridCoreCoefficient Vb b C ζ θ k K d aux source target *
    f target (physicalTranslateResidues r.1 (cleanHybridStep k C source aux d),
      fixedOrderedResidueTranslate p r.2 (cleanHybridStep k C source aux d))


















