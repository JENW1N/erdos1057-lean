/- Conditioning the original small residue labels does not alter the
independent permutation symmetry of the big pending-memory coordinates. -/

namespace Bounty

theorem physical_small_big_condition_memory_symmetric
    {S G : Type*} [Fintype S] [DecidableEq S] [DecidableEq G]
    {Ps : S → Finset ℕ} {P Z : G → Type*} {J ell B : ℕ} {M : G → ℕ}
    (V : S → ℝ) (q : ℝ)
    (F : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ)
    (hF : ∀ s, ProductMemorySymmetric (fun x => F (s, x)))
    (d : PhysicalSharedLists Ps J) (r : PhysicalResidues Ps) :
    ProductMemorySymmetric (fun x => physicalSmallBigCondition V q F d x r) := by
  intro x g τ
  unfold physicalSmallBigCondition
  apply congrArg (physicalSmallCondition V q r d)
  funext L
  exact hF (r, L) x g τ

end Bounty
