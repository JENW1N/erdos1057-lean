open Finset
open scoped Classical
noncomputable def finiteTwoKernelAverage {X Y : Type*} [Fintype X] [Fintype Y]
    (μ : X → ℝ) (ν : Y → ℝ) (KA : X → X → ℂ) (KB : Y → Y → ℂ)
    (x : X) (y : Y) (F : X → Y → ℂ) : ℂ :=
  ∑ d, ∑ e, ((μ d : ℂ) * KA d x) * ((ν e : ℂ) * KB e y) * F d e

theorem finite_two_kernel_average_separable {X Y : Type*} [Fintype X] [Fintype Y]
    (μ : X → ℝ) (ν : Y → ℝ) (KA : X → X → ℂ) (KB : Y → Y → ℂ)
    (x : X) (y : Y) (f : X → ℂ) (g : Y → ℂ) :
    finiteTwoKernelAverage μ ν KA KB x y (fun d e => f d * g e) =
      (∑ d, (μ d : ℂ) * KA d x * f d) * (∑ e, (ν e : ℂ) * KB e y * g e) := by
  simp only [finiteTwoKernelAverage, sum_mul, mul_sum]
  rw [sum_comm]
  apply sum_congr rfl
  intro d _
  apply sum_congr rfl
  intro e _
  ring

theorem finite_two_kernel_average_sum {I X Y : Type*} [Fintype X] [Fintype Y]
    (s : Finset I) (μ : X → ℝ) (ν : Y → ℝ) (KA : X → X → ℂ) (KB : Y → Y → ℂ)
    (x : X) (y : Y) (F : I → X → Y → ℂ) :
    finiteTwoKernelAverage μ ν KA KB x y (∑ i ∈ s, F i) =
      ∑ i ∈ s, finiteTwoKernelAverage μ ν KA KB x y (F i) := by
  simp only [finiteTwoKernelAverage, Finset.sum_apply, mul_sum]
  simp_rw [sum_comm (s := (univ : Finset Y))]
  rw [sum_comm]

section

variable
  {X Y : Type*}
  [sharedInstance1 : Fintype X]
  [sharedInstance2 : Fintype Y]
  (μ : X → ℝ)
  (ν : Y → ℝ)
  (KA : X → X → ℂ)
  (KB : Y → Y → ℂ)
  (x : X)
  (y : Y)

include X Y sharedInstance1 sharedInstance2 μ ν KA KB x y

theorem finite_two_kernel_average_mul  (c : ℂ) (F : X → Y → ℂ) :
    finiteTwoKernelAverage μ ν KA KB x y (fun d e => c * F d e) =
      c * finiteTwoKernelAverage μ ν KA KB x y F := by
  simp only [finiteTwoKernelAverage, mul_sum]
  apply sum_congr rfl
  intro d _
  apply sum_congr rfl
  intro e _
  ring

theorem finite_two_kernel_average_sub  (F H : X → Y → ℂ) :
    finiteTwoKernelAverage μ ν KA KB x y (F - H) =
      finiteTwoKernelAverage μ ν KA KB x y F - finiteTwoKernelAverage μ ν KA KB x y H := by
  simp only [finiteTwoKernelAverage, Pi.sub_apply, mul_sub, sum_sub_distrib]

end


theorem complex_product_reproduction_error (a b u v : ℂ) (εA εB : ℝ)
    (hεA : 0 ≤ εA) (hεB : 0 ≤ εB) (ha : ‖a‖ ≤ 1) (hb : ‖b‖ ≤ 1)
    (hu : ‖u - a‖ ≤ εA) (hv : ‖v - b‖ ≤ εB) :
    ‖u * v - a * b‖ ≤ εA + εB + εA * εB := by
  have hvnorm : ‖v‖ ≤ εB + 1 := by
    calc
      _ = ‖(v - b) + b‖ := by congr 1; ring
      _ ≤ ‖v - b‖ + ‖b‖ := norm_add_le _ _
      _ ≤ εB + 1 := add_le_add hv hb
  calc
    _ = ‖(u - a) * v + a * (v - b)‖ := by congr 1; ring
    _ ≤ ‖(u - a) * v‖ + ‖a * (v - b)‖ := norm_add_le _ _
    _ = ‖u - a‖ * ‖v‖ + ‖a‖ * ‖v - b‖ := by rw [norm_mul, norm_mul]
    _ ≤ εA * (εB + 1) + 1 * εB :=
      add_le_add (mul_le_mul hu hvnorm (norm_nonneg _) hεA)
        ((mul_le_mul_of_nonneg_left hv (norm_nonneg _)).trans
          (mul_le_mul_of_nonneg_right ha hεB))
    _ = _ := by ring

theorem finite_two_kernel_character_error {X Y : Type*} [Fintype X] [Fintype Y]
    (μ : X → ℝ) (ν : Y → ℝ) (KA : X → X → ℂ) (KB : Y → Y → ℂ)
    (x : X) (y : Y) (χA : X → ℂ) (χB : Y → ℂ) (εA εB : ℝ)
    (hεA : 0 ≤ εA) (hεB : 0 ≤ εB) (hχA : ‖χA x‖ ≤ 1) (hχB : ‖χB y‖ ≤ 1)
    (hA : ‖(∑ d, (μ d : ℂ) * KA d x * χA d) - χA x‖ ≤ εA)
    (hB : ‖(∑ e, (ν e : ℂ) * KB e y * χB e) - χB y‖ ≤ εB) :
    ‖finiteTwoKernelAverage μ ν KA KB x y (fun d e => χA d * χB e) - χA x * χB y‖ ≤
      εA + εB + εA * εB := by
  rw [finite_two_kernel_average_separable]
  exact complex_product_reproduction_error _ _ _ _ εA εB hεA hεB hχA hχB hA hB

theorem finite_two_kernel_expansion_error {I X Y : Type*} [Fintype X] [Fintype Y]
    (s : Finset I) (μ : X → ℝ) (ν : Y → ℝ) (KA : X → X → ℂ) (KB : Y → Y → ℂ)
    (x : X) (y : Y) (c : I → ℂ) (χA : I → X → ℂ) (χB : I → Y → ℂ)
    (εA εB H : ℝ) (hεA : 0 ≤ εA) (hεB : 0 ≤ εB)
    (hc : ∑ i ∈ s, ‖c i‖ ≤ H)
    (hχA : ∀ i ∈ s, ‖χA i x‖ ≤ 1) (hχB : ∀ i ∈ s, ‖χB i y‖ ≤ 1)
    (hA : ∀ i ∈ s, ‖(∑ d, (μ d : ℂ) * KA d x * χA i d) - χA i x‖ ≤ εA)
    (hB : ∀ i ∈ s, ‖(∑ e, (ν e : ℂ) * KB e y * χB i e) - χB i y‖ ≤ εB) :
    ‖finiteTwoKernelAverage μ ν KA KB x y (fun d e => ∑ i ∈ s, c i * (χA i d * χB i e)) -
        ∑ i ∈ s, c i * (χA i x * χB i y)‖ ≤ H * (εA + εB + εA * εB) := by
  have hrewrite : finiteTwoKernelAverage μ ν KA KB x y
      (fun d e => ∑ i ∈ s, c i * (χA i d * χB i e)) =
      ∑ i ∈ s, c i * finiteTwoKernelAverage μ ν KA KB x y (fun d e => χA i d * χB i e) := by
    have hfun : (fun d e => ∑ i ∈ s, c i * (χA i d * χB i e)) =
        ∑ i ∈ s, fun d e => c i * (χA i d * χB i e) := by
      funext d e
      simp only [Finset.sum_apply]
    rw [hfun, finite_two_kernel_average_sum]
    simp_rw [finite_two_kernel_average_mul]
  rw [hrewrite, ← sum_sub_distrib]
  calc
    _ ≤ ∑ i ∈ s, ‖c i * finiteTwoKernelAverage μ ν KA KB x y (fun d e => χA i d * χB i e) -
        c i * (χA i x * χB i y)‖ := norm_sum_le _ _
    _ ≤ ∑ i ∈ s, ‖c i‖ * (εA + εB + εA * εB) := by
      apply sum_le_sum
      intro i hi
      rw [← mul_sub, norm_mul]
      exact mul_le_mul_of_nonneg_left
        (finite_two_kernel_character_error μ ν KA KB x y (χA i) (χB i) εA εB hεA hεB
          (hχA i hi) (hχB i hi) (hA i hi) (hB i hi)) (norm_nonneg _)
    _ = (∑ i ∈ s, ‖c i‖) * (εA + εB + εA * εB) := (sum_mul _ _ _).symm
    _ ≤ _ := mul_le_mul_of_nonneg_right hc (by positivity)

