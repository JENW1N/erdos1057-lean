section

/- Uniform nonprincipal Mellin cancellation for an actual prime proxy on a truncated cell. -/

open Finset Filter

namespace Bounty

theorem eventually_prime_proxy_cell_mellin_power_bound {a T : ℝ}
    (ha : 0 < a) (hT : 0 ≤ T) (S Bsave : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ Y Z : ℝ, Real.exp (a*L) ≤ Y → Real.exp (a*L) ≤ Z →
      ∀ (r : ℕ) [NeZero r] (χ : DirichletCharacter ℂ r), χ ≠ 1 → (r : ℝ) ≤ L^T →
      ∀ v : ℝ, |v| ≤ L^T → ∀ m n : ℕ, m ≤ n → Y ≤ (m+1 : ℕ) → (n : ℝ) ≤ 2*Y →
        ⌊Z⌋₊ ≤ m → n ≤ ⌊Real.exp (L^(-S))*Z⌋₊ →
        ‖∑ i ∈ Ioc m n, (primeCellProxy L S Z i : ℂ)*
            harmonicMellinWeight v i*χ (i : ZMod r)‖ ≤ L^(-Bsave) := by
  obtain ⟨C, _, hcoeff⟩ := exists_prime_cell_proxy_bound ha
  filter_upwards [eventually_rough_interval_mellin_power_bound ha hT Bsave, hcoeff S]
    with L hrough hco
  intro Y Z hY hZ r hr χ hχ hrT v hv m n hmn hYm hn hZm hnZ
  have hc := hco Z hZ
  have hraw := hrough Y hY r χ hχ hrT v hv m n hmn hYm hn
  have hid : (∑ i ∈ Ioc m n, (primeCellProxy L S Z i : ℂ)*
      harmonicMellinWeight v i*χ (i : ZMod r)) =
      (primeCellProxyCoefficient L S Z : ℂ)*
        ∑ i ∈ (Ioc m n).filter (fun i : ℕ =>
          ∀ p ∈ i.primeFactors, Real.exp (Real.sqrt L) < (p : ℝ)),
          harmonicMellinWeight v i*χ (i : ZMod r) := by
    rw [mul_sum, sum_filter]
    apply sum_congr rfl
    intro i hi
    have hiI : i ∈ Ioc ⌊Z⌋₊ ⌊Real.exp (L^(-S))*Z⌋₊ :=
      mem_Ioc.mpr ⟨hZm.trans_lt (mem_Ioc.mp hi).1, (mem_Ioc.mp hi).2.trans hnZ⟩
    by_cases hp : ∀ p ∈ i.primeFactors, Real.exp (Real.sqrt L) < (p : ℝ)
    · have hiR : i ∈ roughBand Z (Real.exp (L^(-S))*Z) (Real.exp (Real.sqrt L)) :=
        mem_filter.mpr ⟨hiI, hp⟩
      simp only [primeCellProxy, if_pos hiR, if_pos hp, mul_assoc]
    · have hiR : i ∉ roughBand Z (Real.exp (L^(-S))*Z) (Real.exp (Real.sqrt L)) :=
        fun hh => hp (mem_filter.mp hh).2
      simp only [primeCellProxy, if_neg hiR, if_neg hp, Complex.ofReal_zero, zero_mul]
  rw [hid, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hc.1]
  exact (mul_le_mul hc.2.1 hraw (norm_nonneg _) zero_le_one).trans_eq (one_mul _)

end Bounty
end

