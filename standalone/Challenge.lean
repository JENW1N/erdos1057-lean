      (fullEdgeMemoryReindex n S B A Δ D s τ e)) =
    f (fullActiveEdgeEventTarget n S B A Δ D s e) := by
  exact joint_edge_reindex_test n _ _ (fun g => (S g)ᶜ.card) B
