  simp only [cleanHybridPatternCoreAction, cleanHybridCoreAction, cleanTranslatedSumOperator,
    cleanTranslatedOperator, Fintype.sum_sigma, clean_hybrid_residue_translation]

/- The frequency is independent of the pattern, so all signed patterns remain
inside a single real-frequency ideal block. -/
theorem clean_hybrid_pattern_block_real_frequency 
    [∀ q : PhysicalPrime Ps, NeZero q.2.val] [∀ g j, NeZero (p g j).val]
    (K : ∀ i, RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb (C i) → ℂ)
    (d : PhysicalSharedLists Ps J)
    (χ : AddChar (PhysicalResidues Ps × FixedOrderedResidues p) ℂ) :
    ∃ Θ : ℝ, ∀ (v : RepeatedBigLists Pb J ell → ℂ) source,
      cleanFourierSumBlock
        (fun a : (i : I) × PhysicalAuxLabels Pb (C i) =>
          cleanHybridCoreCoefficient Vb b (C a.1) ζ θ k (K a.1) d a.2)
        (fun a source _ => cleanHybridResidueDirection p (cleanHybridStep k (C a.1) source a.2 d))
        χ v source = physicalPhase ζ (physicalSharedProduct d) *
          ∑ target, (∑ i, ∑ aux, repeatedBigKernel Vb b (C i) ζ (K i) aux source target *
            physicalReturnPhase Θ (repeatedBigD (C i) source aux)) * v target := by
  obtain ⟨Θ, hΘ⟩ := exists_physical_character_return_frequency χ
    (cleanHybridResidueDirection (Ps := Ps) p) θ (k * (physicalSharedProduct d : ℤ))
  refine ⟨Θ, ?_⟩
  intro v source
  rw [clean_fourier_sum_block_matrix, mul_sum]
  apply sum_congr rfl
  intro target ht
  rw [← mul_assoc]
  congr 1
  rw [Fintype.sum_sigma, mul_sum]
  apply sum_congr rfl
  intro i hi
  rw [mul_sum]
  apply sum_congr rfl
  intro aux ha
  have hstep : cleanHybridStep k (C i) source aux d =
      (k * (physicalSharedProduct d : ℤ)) * (repeatedBigD (C i) source aux : ℤ) := by
    unfold cleanHybridStep
    ring
  unfold cleanHybridCoreCoefficient
  rw [hstep]
  have h := hΘ (repeatedBigD (C i) source aux : ℤ)
