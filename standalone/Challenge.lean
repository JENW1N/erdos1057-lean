theorem finite_cutoff_fiber_gram_eq_return_root {X : Type*}
    (rows : Finset X) (position : X → ℤ) {mass : ℝ} (hmass : 0 ≤ mass)
    (K : X → X → ℂ) (starts : Finset ℤ) (R : ℕ) :
    (∑ n ∈ starts, inner ℂ (finiteFiberVector (fun x : rows => position x.val) mass n)
      (((finiteKernelOperator (fun a b : rows => K a.val b.val) *
          (finiteKernelOperator (fun a b : rows => K a.val b.val)).adjoint) ^ R)
        (finiteFiberVector (fun x : rows => position x.val) mass n))) =
      (mass : ℂ) * ∑ n ∈ starts, ∑ x ∈ rows.filter (fun x => position x = n),
        finiteCutoffAction rows (finiteGramAlternatingKernel K)
          (fun y => if position y = n then 1 else 0) (2 * R) x := by
  classical
  rw [sum_finiteFiberVector_inner_operator (fun x : rows => position x.val) hmass]
  congr 1
  apply Finset.sum_congr rfl
  intro n _
  rw [Finset.sum_filter, Finset.sum_filter, ← Finset.sum_coe_sort rows]
  apply Finset.sum_congr rfl
  intro x _
  split_ifs with hx
  · exact (finite_cutoff_alternating_action_eq_gram_power rows K
      (fun y => if position y = n then 1 else 0) R x).symm
  · rfl



end

section

open scoped BigOperators ComplexConjugate

noncomputable def cleanFourierSynthesis {R : Type*} [AddCommGroup R] [Fintype R]
    (c : AddChar R ℂ → ℂ) (r : R) : ℂ :=
  ∑ χ, c χ * χ r

noncomputable def cleanFourierCoefficients {R : Type*} [AddCommGroup R] [Fintype R]
    (f : R → ℂ) (χ : AddChar R ℂ) : ℂ :=
  (AddChar.complexBasis R).repr f χ

noncomputable def cleanTranslatedOperator {X R : Type*} [Fintype X]
    [AddCommGroup R] (K : X → X → ℂ) (δ : X → X → R)
    (f : X → R → ℂ) (x : X) (r : R) : ℂ :=
  ∑ y, K x y * f y (r + δ x y)

noncomputable def cleanFourierBlock {X R : Type*} [Fintype X]
    [AddCommGroup R] (K : X → X → ℂ) (δ : X → X → R)
    (χ : AddChar R ℂ) (v : X → ℂ) (x : X) : ℂ :=
  ∑ y, (K x y * χ (δ x y)) * v y

theorem clean_fourier_synthesis_coefficients {R : Type*} [AddCommGroup R] [Fintype R]
    (f : R → ℂ) (r : R) :
    cleanFourierSynthesis (cleanFourierCoefficients f) r = f r := by
  have h := congr_fun ((AddChar.complexBasis R).sum_repr f) r
  simpa only [cleanFourierSynthesis, cleanFourierCoefficients, AddChar.complexBasis_apply,
    Finset.sum_apply, Pi.smul_apply, smul_eq_mul] using h

theorem clean_character_orthogonality {R : Type*} [AddCommGroup R] [Fintype R]
    (χ ψ : AddChar R ℂ) :
    ∑ r, χ r * conj (ψ r) = if χ = ψ then (Fintype.card R : ℂ) else 0 := by
  classical
  have h := AddChar.sum_eq_ite (χ - ψ)
  simpa only [AddChar.sub_apply, AddChar.map_neg_eq_inv, AddChar.inv_apply_eq_conj,
    sub_eq_zero] using h

theorem clean_fourier_synthesis_pairing {R : Type*} [AddCommGroup R] [Fintype R]
    (c d : AddChar R ℂ → ℂ) :
    ∑ r, cleanFourierSynthesis c r * conj (cleanFourierSynthesis d r) =
      (Fintype.card R : ℂ) * ∑ χ, c χ * conj (d χ) := by
  classical
  simp only [cleanFourierSynthesis, map_sum, map_mul, Fintype.sum_mul_sum]
  calc
    ∑ r, ∑ χ, ∑ ψ, c χ * χ r * (conj (d ψ) * conj (ψ r)) =
        ∑ χ, ∑ ψ, (c χ * conj (d ψ)) * ∑ r, χ r * conj (ψ r) := by
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro χ hχ
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro ψ hψ
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro r hr
      ring
    _ = (Fintype.card R : ℂ) * ∑ χ, c χ * conj (d χ) := by
      simp_rw [clean_character_orthogonality]
      simp only [mul_ite, mul_zero, Finset.sum_ite_eq, Finset.mem_univ, if_true]
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro χ hχ
      ring

theorem clean_fourier_synthesis_energy {R : Type*} [AddCommGroup R] [Fintype R]
    (c : AddChar R ℂ → ℂ) :
    ∑ r, ‖cleanFourierSynthesis c r‖ ^ 2 =
      (Fintype.card R : ℝ) * ∑ χ, ‖c χ‖ ^ 2 := by
  have h := clean_fourier_synthesis_pairing c c
  simp only [Complex.mul_conj, Complex.normSq_eq_norm_sq] at h
  exact_mod_cast h

theorem clean_fourier_translated_synthesis {X R : Type*} [Fintype X]
    [AddCommGroup R] [Fintype R] (K : X → X → ℂ) (δ : X → X → R)
    (c : AddChar R ℂ → X → ℂ) (x : X) (r : R) :
    cleanTranslatedOperator K δ (fun y => cleanFourierSynthesis (fun χ => c χ y)) x r =
      cleanFourierSynthesis (fun χ => cleanFourierBlock K δ χ (c χ) x) r := by
  simp only [cleanTranslatedOperator, cleanFourierBlock, cleanFourierSynthesis,
    AddChar.map_add_eq_mul, Finset.mul_sum, Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro χ hχ
  apply Finset.sum_congr rfl
  intro y hy
  ring

/- Parseval with an arbitrary weight on the active states. -/
theorem clean_fourier_weighted_energy {X R : Type*} [Fintype X]
    [AddCommGroup R] [Fintype R] (w : X → ℝ) (c : AddChar R ℂ → X → ℂ) :
    ∑ x, w x * ∑ r, ‖cleanFourierSynthesis (fun χ => c χ x) r‖ ^ 2 =
      (Fintype.card R : ℝ) * ∑ χ, ∑ x, w x * ‖c χ x‖ ^ 2 := by
  simp_rw [clean_fourier_synthesis_energy, ← mul_assoc, mul_comm (w _) (Fintype.card R : ℝ), mul_assoc,
    Finset.mul_sum]
  rw [Finset.sum_comm]













/- Weighted counting-measure L² norm on active states and residues. -/
noncomputable def cleanWeightedNorm {X R : Type*} [Fintype X] [Fintype R]
    (w : X → ℝ) (f : X → R → ℂ) : ℝ :=
  Real.sqrt (∑ x, w x * ∑ r, ‖f x r‖ ^ 2)










/- Weighted L² norm on the active states alone. -/
noncomputable def cleanActiveNorm {X : Type*} [Fintype X]
    (w : X → ℝ) (v : X → ℂ) : ℝ :=
  Real.sqrt (∑ x, w x * ‖v x‖ ^ 2)

theorem clean_active_norm_sq {X : Type*} [Fintype X]
    (w : X → ℝ) (hw : ∀ x, 0 ≤ w x) (v : X → ℂ) :
    cleanActiveNorm w v ^ 2 = ∑ x, w x * ‖v x‖ ^ 2 := by
  apply Real.sq_sqrt
  exact Finset.sum_nonneg (fun x _ => mul_nonneg (hw x) (sq_nonneg _))






end

