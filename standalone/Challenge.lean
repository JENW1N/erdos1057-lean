section

/- The powers of the interval length cancel in the localized Gram estimate. -/

namespace Bounty

theorem block_gram_scaling_bound {R : ℕ} (hR : 1 ≤ R)
    {X U T : ℝ} (hX : 0 < X) (hU : 1 ≤ U) (hT : 0 ≤ T) :
    (3 * (X * U ^ 2)) ^ (1 / 2 : ℝ) *
      (X * U ^ 2) ^ ((1 - 1 / (R : ℝ)) / 2) *
      (X * T ^ (2 * R)) ^ (1 / (2 * (R : ℝ))) ≤
        Real.sqrt 3 * X * U ^ 2 * T := by
  have hR0 : (0 : ℝ) < R := by exact_mod_cast (by omega : 0 < R)
  have hU0 : 0 < U := lt_of_lt_of_le zero_lt_one hU
  have hXU : 0 < X * U ^ 2 := mul_pos hX (sq_pos_of_pos hU0)
  have he : (1 / 2 : ℝ) + (1 - 1 / (R : ℝ)) / 2 = 1 - 1 / (2 * (R : ℝ)) := by ring
  have ht : (T ^ (2 * R)) ^ (1 / (2 * (R : ℝ))) = T := by
    rw [← Real.rpow_natCast_mul hT]
    have he' : ((2 * R : ℕ) : ℝ) * (1 / (2 * (R : ℝ))) = 1 := by
      push_cast
      field_simp
    rw [he', Real.rpow_one]
  have hu : (U ^ 2) ^ (1 - 1 / (2 * (R : ℝ))) = U ^ (2 - 1 / (R : ℝ)) := by
    rw [← Real.rpow_natCast_mul hU0.le]
    congr 1
    norm_num
    ring
  have hcomb : (X * U ^ 2) ^ (1 - 1 / (2 * (R : ℝ))) *
      (X * T ^ (2 * R)) ^ (1 / (2 * (R : ℝ))) =
      X * U ^ (2 - 1 / (R : ℝ)) * T := by
    rw [Real.mul_rpow hX.le (sq_nonneg U), Real.mul_rpow hX.le (pow_nonneg hT _), ht, hu]
    calc
      _ = (X ^ (1 - 1 / (2 * (R : ℝ))) * X ^ (1 / (2 * (R : ℝ)))) *
          U ^ (2 - 1 / (R : ℝ)) * T := by ring
      _ = _ := by rw [← Real.rpow_add hX]; simp
  calc
    _ = (3 : ℝ) ^ (1 / 2 : ℝ) *
        ((X * U ^ 2) ^ (1 - 1 / (2 * (R : ℝ))) *
          (X * T ^ (2 * R)) ^ (1 / (2 * (R : ℝ)))) := by
      rw [Real.mul_rpow (by norm_num : (0 : ℝ) ≤ 3) hXU.le,
        ← mul_assoc, mul_assoc ((3 : ℝ) ^ (1 / 2 : ℝ)), ← Real.rpow_add hXU, he]
    _ = Real.sqrt 3 * X * U ^ (2 - 1 / (R : ℝ)) * T := by
      rw [hcomb, Real.sqrt_eq_rpow]
      ring
    _ ≤ _ := by
      apply mul_le_mul_of_nonneg_right _ hT
      apply mul_le_mul_of_nonneg_left _ (mul_nonneg (Real.sqrt_nonneg _) hX.le)
      have h := Real.rpow_le_rpow_of_exponent_le hU
        (show 2 - 1 / (R : ℝ) ≤ 2 by linarith [one_div_pos.mpr hR0])
      simpa only [Real.rpow_two] using h

theorem block_gram_of_energy_bounds {R : ℕ} (hR : 1 ≤ R)
    {Q F G Z B X U T : ℝ} (hF0 : 0 ≤ F) (hG0 : 0 ≤ G) (hZ0 : 0 ≤ Z)
    (hB : 0 ≤ B) (hX : 0 < X) (hU : 1 ≤ U) (hT : 0 ≤ T)
    (hblock : Q ^ (1 / (2 * (R : ℝ))) ≤ B)
    (hF : F ≤ X * U ^ 2) (hG : G ≤ X * U ^ 2) (hZ : Z ≤ X * T ^ (2 * R)) :
    Q ^ (1 / (2 * (R : ℝ))) * (3 * G) ^ (1 / 2 : ℝ) *
      F ^ ((1 - 1 / (R : ℝ)) / 2) * Z ^ (1 / (2 * (R : ℝ))) ≤
        B * Real.sqrt 3 * X * U ^ 2 * T := by
  have hR1 : (1 : ℝ) ≤ R := by exact_mod_cast hR
  have hR0 : (0 : ℝ) < R := lt_of_lt_of_le zero_lt_one hR1
  have htheta : 0 ≤ (1 - 1 / (R : ℝ)) / 2 := by
    have hh : 1 / (R : ℝ) ≤ 1 := (div_le_one hR0).mpr hR1
    linarith
  calc
    _ ≤ B * (3 * (X * U ^ 2)) ^ (1 / 2 : ℝ) *
        (X * U ^ 2) ^ ((1 - 1 / (R : ℝ)) / 2) *
        (X * T ^ (2 * R)) ^ (1 / (2 * (R : ℝ))) := by
      gcongr
    _ = B * ((3 * (X * U ^ 2)) ^ (1 / 2 : ℝ) *
        (X * U ^ 2) ^ ((1 - 1 / (R : ℝ)) / 2) *
        (X * T ^ (2 * R)) ^ (1 / (2 * (R : ℝ)))) := by ring
    _ ≤ B * (Real.sqrt 3 * X * U ^ 2 * T) :=
      mul_le_mul_of_nonneg_left (block_gram_scaling_bound hR hX hU hT) hB
    _ = _ := by ring

end Bounty
end

section

/- Explicit exponential rank tails retain the required saving in the whole path length. -/

namespace Bounty

theorem geometric_rank_tail_le_exp {A a b c E : ℝ} (r : ℕ)
    (hAc : A ≤ Real.exp c) (ha : 0 ≤ a) (ha2 : a ≤ 1 / 2)
    (hab : a ≤ Real.exp (-b)) (hmargin : c + E + Real.log 2 ≤ b * r) :
    A * a ^ r / (1 - a) ≤ Real.exp (-E) := by
  have hden : 0 < 1 - a := by linarith
  have hp : a ^ r ≤ Real.exp (-b * r) := by
    calc
      _ ≤ Real.exp (-b) ^ r := pow_le_pow_left₀ ha hab r
      _ = _ := by rw [← Real.exp_nat_mul]; congr 1; ring
  have hnum : A * a ^ r ≤ Real.exp (-E) / 2 := by
    calc
      _ ≤ Real.exp c * Real.exp (-b * r) := mul_le_mul hAc hp (pow_nonneg ha _) (Real.exp_pos c).le
      _ = Real.exp (c - b * r) := by rw [← Real.exp_add]; congr 1; ring
      _ ≤ Real.exp (-E - Real.log 2) := Real.exp_le_exp.mpr (by linarith)
      _ = _ := by rw [Real.exp_sub, Real.exp_log (by norm_num : (0 : ℝ) < 2)]
  apply (div_le_iff₀ hden).mpr
  calc
    _ ≤ Real.exp (-E) / 2 := hnum
    _ ≤ Real.exp (-E) * (1 - a) := by nlinarith [Real.exp_pos (-E)]

theorem forest_rank_cutoff_tail {L C E b A a : ℝ} (N : ℕ)
    (hL : 2 ≤ L) (hC : 0 ≤ C) (hb : Real.log 2 ≤ b)
    (hN : 1 ≤ N) (hAb : A ≤ L ^ (C * ((N : ℝ) + 1)))
    (ha : 0 ≤ a) (hab : a ≤ Real.exp (-b)) :
    A * a ^ (Nat.ceil (((2 * C + E + 1) * N * Real.log L) / b)) / (1 - a) ≤
      L ^ (-(E * N)) := by
  have hL0 : 0 < L := lt_of_lt_of_le (by norm_num) hL
  have hlog : 0 < Real.log L := Real.log_pos (by linarith)
  have hb0 : 0 < b := (Real.log_pos (by norm_num : (1 : ℝ) < 2)).trans_le hb
  have hN1 : (1 : ℝ) ≤ N := by exact_mod_cast hN
  have hceil := Nat.le_ceil (((2 * C + E + 1) * N * Real.log L) / b)
  have hprod : (2 * C + E + 1) * N * Real.log L ≤
      b * (Nat.ceil (((2 * C + E + 1) * N * Real.log L) / b) : ℝ) := by
    have h := (div_le_iff₀ hb0).mp hceil
    nlinarith
  have hlog2 : Real.log 2 ≤ Real.log L := Real.log_le_log (by norm_num) hL
  have hmargin : C * ((N : ℝ) + 1) * Real.log L + (E * N) * Real.log L + Real.log 2 ≤
      b * (Nat.ceil (((2 * C + E + 1) * N * Real.log L) / b) : ℝ) := by
    have hcN : 0 ≤ C * ((N : ℝ) - 1) * Real.log L := by positivity
    have hnlog : Real.log 2 ≤ (N : ℝ) * Real.log L := by nlinarith
    nlinarith
  have ha2 : a ≤ 1 / 2 := by
    calc
      a ≤ Real.exp (-b) := hab
      _ ≤ Real.exp (-Real.log 2) := Real.exp_le_exp.mpr (by linarith)
      _ = 1 / 2 := by rw [Real.exp_neg, Real.exp_log (by norm_num : (0 : ℝ) < 2)]; norm_num
  have hAc : A ≤ Real.exp (C * ((N : ℝ) + 1) * Real.log L) := by
    simpa only [Real.rpow_def_of_pos hL0, mul_comm (Real.log L)] using hAb
  have h := geometric_rank_tail_le_exp
    (Nat.ceil (((2 * C + E + 1) * N * Real.log L) / b)) hAc ha ha2 hab hmargin
  simpa only [Real.rpow_def_of_pos hL0, neg_mul, mul_neg, mul_comm (Real.log L)] using h

end Bounty
end

section

/- Explicit compact smooth Type-II transitions and their Schwartz Fourier transforms. -/

open MeasureTheory
open scoped FourierTransform ContDiff

namespace Bounty

noncomputable def typeIISmoothRho (A t : ℝ) : ℝ :=
  Real.smoothTransition (t + A + 1) * Real.smoothTransition (A + 1 - t)

noncomputable def typeIISmoothCutoff (A : ℝ) (active : Bool) (t : ℝ) : ℝ :=
  typeIISmoothRho A t *
    (if active then Real.smoothTransition t else 1 - Real.smoothTransition t)

theorem typeII_smooth_rho_bounds (A t : ℝ) :
    0 ≤ typeIISmoothRho A t ∧ typeIISmoothRho A t ≤ 1 := by
  constructor
  · exact mul_nonneg (Real.smoothTransition.nonneg _) (Real.smoothTransition.nonneg _)
  · calc
      _ ≤ 1 * Real.smoothTransition (A + 1 - t) :=
        mul_le_mul_of_nonneg_right (Real.smoothTransition.le_one _) (Real.smoothTransition.nonneg _)
      _ ≤ 1 := by simpa using Real.smoothTransition.le_one (A + 1 - t)

theorem typeII_smooth_rho_eq_one {A t : ℝ} (ht : t ∈ Set.Icc (-A) A) :
    typeIISmoothRho A t = 1 := by
  unfold typeIISmoothRho
  rw [Real.smoothTransition.one_of_one_le (by linarith [ht.1]),
    Real.smoothTransition.one_of_one_le (by linarith [ht.2]), mul_one]

theorem typeII_smooth_rho_eq_zero {A t : ℝ} (ht : t ∉ Set.Icc (-A - 1) (A + 1)) :
    typeIISmoothRho A t = 0 := by
  unfold typeIISmoothRho
  by_cases hlo : t < -A - 1
  · rw [Real.smoothTransition.zero_of_nonpos (by linarith), zero_mul]
  · have hhi : A + 1 < t := lt_of_not_ge (fun h => ht ⟨le_of_not_gt hlo, h⟩)
    rw [Real.smoothTransition.zero_of_nonpos (by linarith : A + 1 - t ≤ 0), mul_zero]

theorem typeII_smooth_rho_contDiff (A : ℝ) : ContDiff ℝ ∞ (typeIISmoothRho A) := by
  unfold typeIISmoothRho
  fun_prop

theorem typeII_smooth_rho_hasCompactSupport (A : ℝ) : HasCompactSupport (typeIISmoothRho A) :=
  HasCompactSupport.intro isCompact_Icc (fun _ ht => typeII_smooth_rho_eq_zero ht)

theorem typeII_smooth_cutoff_contDiff (A : ℝ) (active : Bool) :
    ContDiff ℝ ∞ (typeIISmoothCutoff A active) := by
  cases active <;> unfold typeIISmoothCutoff <;> simp only [Bool.false_eq_true, if_false, if_true]
  · exact (typeII_smooth_rho_contDiff A).mul (contDiff_const.sub Real.smoothTransition.contDiff)
  · exact (typeII_smooth_rho_contDiff A).mul Real.smoothTransition.contDiff

theorem typeII_smooth_cutoff_hasCompactSupport (A : ℝ) (active : Bool) :
    HasCompactSupport (typeIISmoothCutoff A active) :=
  (typeII_smooth_rho_hasCompactSupport A).mul_right

theorem typeII_smooth_cutoff_bounds (A t : ℝ) (active : Bool) :
    0 ≤ typeIISmoothCutoff A active t ∧ typeIISmoothCutoff A active t ≤ 1 := by
  have hr := typeII_smooth_rho_bounds A t
  have ht0 := Real.smoothTransition.nonneg t
  have ht1 := Real.smoothTransition.le_one t
  cases active <;> simp only [typeIISmoothCutoff, Bool.false_eq_true, if_false, if_true]
  · constructor
    · exact mul_nonneg hr.1 (by linarith)
    · calc
        _ ≤ typeIISmoothRho A t * 1 := mul_le_mul_of_nonneg_left (by linarith) hr.1
        _ ≤ 1 := by simpa using hr.2
  · constructor
    · exact mul_nonneg hr.1 ht0
    · calc
        _ ≤ typeIISmoothRho A t * 1 := mul_le_mul_of_nonneg_left ht1 hr.1
        _ ≤ 1 := by simpa using hr.2







theorem typeII_smooth_cutoff_eq_transition {A t : ℝ} (active : Bool)
    (ht : t ∈ Set.Icc (-A) A) :
    typeIISmoothCutoff A active t =
      (if active then Real.smoothTransition t else 1 - Real.smoothTransition t) := by
  rw [typeIISmoothCutoff, typeII_smooth_rho_eq_one ht, one_mul]

theorem typeII_complex_cutoff_contDiff (A : ℝ) (active : Bool) :
    ContDiff ℝ ∞ (fun t => (typeIISmoothCutoff A active t : ℂ)) :=
  Complex.ofRealCLM.contDiff.comp (typeII_smooth_cutoff_contDiff A active)

theorem typeII_complex_cutoff_hasCompactSupport (A : ℝ) (active : Bool) :
    HasCompactSupport (fun t => (typeIISmoothCutoff A active t : ℂ)) :=
  (typeII_smooth_cutoff_hasCompactSupport A active).comp_left
    (g := fun x : ℝ => (x : ℂ)) (by simp)

noncomputable def typeIICutoffSchwartz (A : ℝ) (active : Bool) : SchwartzMap ℝ ℂ :=
  (typeII_complex_cutoff_hasCompactSupport A active).toSchwartzMap
    (typeII_complex_cutoff_contDiff A active)

noncomputable def typeIICutoffFourier (A : ℝ) (active : Bool) : SchwartzMap ℝ ℂ :=
  𝓕 (typeIICutoffSchwartz A active)




theorem typeII_cutoff_fourier_integrable (A : ℝ) (active : Bool) :
    Integrable (typeIICutoffFourier A active) := (typeIICutoffFourier A active).integrable




theorem typeII_cutoff_fourier_inversion (A t : ℝ) (active : Bool) :
    (typeIISmoothCutoff A active t : ℂ) =
      ∫ ξ : ℝ, Complex.exp ((2 * Real.pi * ξ * t : ℝ) * Complex.I) *
        typeIICutoffFourier A active ξ := by
  have hi := congrArg (fun f : SchwartzMap ℝ ℂ => f t)
    (FourierPair.fourierInv_fourier_eq (E := SchwartzMap ℝ ℂ)
      (F := SchwartzMap ℝ ℂ) (typeIICutoffSchwartz A active))
  rw [SchwartzMap.fourierInv_coe, Real.fourierInv_eq'] at hi
  change (∫ ξ : ℝ, Complex.exp ((2 * Real.pi * inner ℝ ξ t : ℝ) * Complex.I) •
    typeIICutoffFourier A active ξ) = (typeIISmoothCutoff A active t : ℂ) at hi
  rw [← hi]
  apply integral_congr_ae
  filter_upwards [] with ξ
  simp only [RCLike.inner_apply, starRingEnd_apply, star_trivial, smul_eq_mul]
  congr 2
  push_cast
  ring

end Bounty
end

section

/- Quantitative tails obtained from actual integrable Schwartz moments. -/

open MeasureTheory

namespace Bounty

theorem schwartz_norm_tail_le_moment (g : SchwartzMap ℝ ℂ) (M : ℕ)
    {R : ℝ} (hR : 0 < R) :
    (∫ x in {x : ℝ | R < ‖x‖}, ‖g x‖) ≤
      (∫ x : ℝ, ‖x‖ ^ M * ‖g x‖) / R ^ M := by
  have hs : MeasurableSet {x : ℝ | R < ‖x‖} :=
    (isOpen_lt continuous_const continuous_norm).measurableSet
  have hw := g.integrable_pow_mul volume M
  have hcomp :
      (∫ x in {x : ℝ | R < ‖x‖}, R ^ M * ‖g x‖) ≤
        ∫ x in {x : ℝ | R < ‖x‖}, ‖x‖ ^ M * ‖g x‖ := by
    apply setIntegral_mono_on (g.integrable.norm.const_mul (R ^ M)).integrableOn
      hw.integrableOn hs
    intro x hx
    exact mul_le_mul_of_nonneg_right (pow_le_pow_left₀ hR.le hx.le M) (norm_nonneg _)
  rw [integral_const_mul] at hcomp
  have hwhole : (∫ x in {x : ℝ | R < ‖x‖}, ‖x‖ ^ M * ‖g x‖) ≤
      ∫ x : ℝ, ‖x‖ ^ M * ‖g x‖ := by
    exact setIntegral_le_integral hw
      (Filter.Eventually.of_forall (fun x => mul_nonneg (pow_nonneg (norm_nonneg x) M)
        (norm_nonneg (g x))))
  apply (le_div_iff₀ (pow_pos hR M)).2
  calc
    _ = R ^ M * (∫ x in {x : ℝ | R < ‖x‖}, ‖g x‖) := mul_comm _ _
    _ ≤ _ := hcomp.trans hwhole

theorem schwartz_norm_rapid_tail (g : SchwartzMap ℝ ℂ) (M : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ R : ℝ, 1 ≤ R →
      (∫ x in {x : ℝ | R < ‖x‖}, ‖g x‖) ≤ C * R ^ (-(M : ℝ)) := by
  let I : ℝ := ∫ x : ℝ, ‖x‖ ^ M * ‖g x‖
  have hI : 0 ≤ I := integral_nonneg (fun x =>
    mul_nonneg (pow_nonneg (norm_nonneg x) M) (norm_nonneg (g x)))
  refine ⟨I + 1, by linarith, ?_⟩
  intro R hR
  have hRpos : 0 < R := lt_of_lt_of_le zero_lt_one hR
  calc
    _ ≤ I / R ^ M := schwartz_norm_tail_le_moment g M hRpos
    _ ≤ (I + 1) / R ^ M := div_le_div_of_nonneg_right (by linarith) (pow_nonneg hRpos.le M)
    _ = (I + 1) * R ^ (-(M : ℝ)) := by
      rw [Real.rpow_neg hRpos.le, Real.rpow_natCast, div_eq_mul_inv]

end Bounty
end

section

open Finset

namespace Bounty

theorem complex_finset_product_error {ι : Type*} (s : Finset ι) (f g : ι → ℂ)
    {C ε : ℝ} (hC : 0 ≤ C) (hε : 0 ≤ ε)
    (hf : ∀ i ∈ s, ‖f i‖ ≤ C) (hg : ∀ i ∈ s, ‖g i‖ ≤ C)
    (he : ∀ i ∈ s, ‖f i - g i‖ ≤ ε) :
    ‖(∏ i ∈ s, f i) - ∏ i ∈ s, g i‖ ≤ s.card * ε * C ^ (s.card - 1) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih =>
    have hfs : ∀ i ∈ s, ‖f i‖ ≤ C := fun i hi => hf i (mem_insert_of_mem hi)
    have hgs : ∀ i ∈ s, ‖g i‖ ≤ C := fun i hi => hg i (mem_insert_of_mem hi)
    have hes : ∀ i ∈ s, ‖f i - g i‖ ≤ ε := fun i hi => he i (mem_insert_of_mem hi)
    have hp : ‖∏ i ∈ s, g i‖ ≤ C ^ s.card := by
      rw [norm_prod]
      calc
        _ ≤ ∏ _i ∈ s, C := prod_le_prod₀ (fun i _ => norm_nonneg (g i)) hgs
        _ = _ := by simp
    rw [prod_insert ha, prod_insert ha]
    have hid : f a * (∏ i ∈ s, f i) - g a * (∏ i ∈ s, g i) =
        f a * ((∏ i ∈ s, f i) - ∏ i ∈ s, g i) +
          (f a - g a) * ∏ i ∈ s, g i := by ring
    rw [hid]
    apply (norm_add_le _ _).trans
    rw [norm_mul, norm_mul]
    have hb := add_le_add
      (mul_le_mul (hf a (mem_insert_self a s)) (ih hfs hgs hes)
        (norm_nonneg _) hC)
      (mul_le_mul (he a (mem_insert_self a s)) hp (norm_nonneg _) hε)
    apply hb.trans
    rw [card_insert_of_notMem ha]
    cases hn : s.card with
    | zero => simp
    | succ n =>
      simp only [Nat.succ_sub_one, Nat.cast_succ, pow_succ]
      ring_nf
      exact le_rfl

end Bounty
end

section

/- Every finite supported P-tail is bounded by the actual marked harmonic tail. -/

open Finset Real

namespace Bounty

theorem candidate_P_harmonic_term_nonneg (c L : ℝ) {q : ℝ} (hq : 0 ≤ q) (n : ℕ) :
    0 ≤ candidatePHarmonicTerm c L q n := by
  apply div_nonneg
  · exact marked_divisor_weight_nonneg _ _ hq _ _
      (fun _ _ => sum_nonneg (fun _ _ => by positivity)) _
  · exact Nat.cast_nonneg _

theorem candidate_finite_P_tail_le {c L q : ℝ} (hcL : 0 ≤ c*L) (hq : 0 ≤ q)
    (X : ℝ) (S : Finset ℕ)
    (hsupport : ∀ p ∈ S, p ∈ Nat.factoredNumbers
      ((candidatePIndices c L).biUnion (candidatePBand (c*L))))
    (hcut : ∀ p ∈ S, X ≤ (p : ℝ)) :
    (∑ p ∈ S, candidatePWeight c L q p / (p : ℝ)) ≤
      candidateMarkedSmoothTail c L q 1 X := by
  classical
  let P := (candidatePIndices c L).biUnion (candidatePBand (c*L))
  let T : Finset (Nat.factoredNumbers P) := S.subtype (fun p => p ∈ Nat.factoredNumbers P)
  have hbig : Summable (fun p : Nat.factoredNumbers P =>
      if X ≤ (p.val : ℝ) then candidatePHarmonicTerm c L q p.val else 0) := by
    simpa only [Set.indicator, Set.mem_ofPred_eq] using!
      (candidate_P_harmonic_summable hcL q).indicator {p | X ≤ (p.val : ℝ)}
  calc
    _ = ∑ p ∈ S, candidatePHarmonicTerm c L q p := by
      apply sum_congr rfl
      intro p hp
      exact candidate_P_weight_harmonic c L q (Nat.ne_zero_of_mem_factoredNumbers (hsupport p hp))
    _ = ∑ p ∈ T, candidatePHarmonicTerm c L q p.val := by
      symm
      exact sum_subtype_of_mem _ hsupport
    _ = ∑ p ∈ T, if X ≤ (p.val : ℝ) then candidatePHarmonicTerm c L q p.val else 0 := by
      apply sum_congr rfl
      intro p hp
      exact (if_pos (hcut p.val (mem_subtype.mp hp))).symm
    _ ≤ ∑' p : Nat.factoredNumbers P,
        if X ≤ (p.val : ℝ) then candidatePHarmonicTerm c L q p.val else 0 := by
      apply hbig.sum_le_tsum
      intro p hp
      split_ifs
      · exact candidate_P_harmonic_term_nonneg c L hq p.val
      · rfl
    _ = candidateMarkedSmoothTail c L q 1 X := rfl

theorem candidate_Q_window_le_harmonic (c L : ℝ) (r jStar : ℕ) {p : ℕ} (hp : p ≠ 0) :
    (∑ n ∈ arithmeticProductWindow p (exp L), candidateQWeight c L r jStar n) ≤
      (16*exp L/(p : ℝ))*candidateQHarmonicMass c L r jStar := by
  have hp0 : (0 : ℝ) < p := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hp)
  calc
    _ ≤ ∑ n ∈ arithmeticProductWindow p (exp L),
        (16*exp L/(p : ℝ))*(candidateQWeight c L r jStar n/(n : ℝ)) := by
      apply sum_le_sum
      intro n hn
      have hwin := (mem_arithmeticProductWindow_iff hp (exp L)).mp hn
      have hn0 : (0 : ℝ) < n := by
        have hh : 0 < (p : ℝ)*(n : ℝ) := by
          simpa only [Nat.cast_mul] using (exp_pos L).trans hwin.1
        exact (mul_pos_iff_of_pos_left hp0).mp hh
      have hnle : (n : ℝ) ≤ 16*exp L/(p : ℝ) := by
        apply (le_div_iff₀ hp0).mpr
        simpa only [Nat.cast_mul, mul_comm] using hwin.2
      calc
        _ = (n : ℝ)*(candidateQWeight c L r jStar n/(n : ℝ)) := by field_simp
        _ ≤ _ := mul_le_mul_of_nonneg_right hnle
          (div_nonneg (candidate_Q_weight_nonneg c L r jStar n) hn0.le)
    _ = (16*exp L/(p : ℝ))*∑ n ∈ arithmeticProductWindow p (exp L),
        candidateQWeight c L r jStar n/(n : ℝ) := (mul_sum _ _ _).symm
    _ ≤ _ := mul_le_mul_of_nonneg_left
      ((candidate_Q_harmonic_summable c L r jStar).sum_le_tsum _
        (fun n _ => div_nonneg (candidate_Q_weight_nonneg c L r jStar n) (Nat.cast_nonneg n)))
      (by positivity)

end Bounty
end

section

/- Complex weighted product fibers for labelled prime slots in disjoint pools. -/

open Finset

namespace Bounty

section

variable
  {I G Ω : Type*}
  [sharedInstance1 : Fintype I]
  [sharedInstance2 : Fintype G]
  [sharedInstance3 : DecidableEq G]
  [sharedInstance4 : Fintype Ω]
  (group : I → G)
  (P : G → Finset ℕ)
  (hprime : ∀ g p, p ∈ P g → p.Prime)
  (hdisj : Pairwise (fun g h => Disjoint (P g) (P h)))
  (x : Ω → I → ℕ)
  (hxinj : Function.Injective x)
  (hx : ∀ a i, x a i ∈ P (group i))

include I G Ω sharedInstance1 sharedInstance2 sharedInstance3 sharedInstance4 group P hprime hdisj x hxinj hx

/- Labelled slots may have arbitrary finite index types and arbitrary finite restrictions.
The factorial cost is determined separately in each disjoint prime pool. -/
theorem card_labelled_prime_product_fiber
     (n : ℕ) :
    Nat.card {a : Ω // (∏ i, x a i) = n} ≤
      ∏ g, (Fintype.card {i : I // group i = g}).factorial := by
  classical
  let K (g : G) := {i : I // group i = g}
  let e (g : G) : Fin (Fintype.card (K g)) ≃ K g := (Fintype.equivFin (K g)).symm
  let y (a : Ω) (g : G) (j : Fin (Fintype.card (K g))) : ℕ := x a (e g j).val
  have hyinj : Function.Injective y := by
    intro a b hab
    apply hxinj
    funext i
    have hi := congrFun (congrFun hab (group i)) ((e (group i)).symm ⟨i, rfl⟩)
    simpa only [y, Equiv.apply_symm_apply] using hi
  have hy : ∀ a g j, y a g j ∈ P g := by
    intro a g j
    dsimp only [y]
    simpa only [(e g j).property] using hx a (e g j).val
  have hyprod (a : Ω) : (∏ g, ∏ j, y a g j) = ∏ i, x a i := by
    calc
      _ = ∏ g, ∏ i : K g, x a i.val := by
        apply prod_congr rfl
        intro g _
        exact Fintype.prod_equiv (e g) _ _ (fun _ => rfl)
      _ = _ := Fintype.prod_fiberwise group (x a)
  have h := card_prime_group_product_fiber P (fun g => Fintype.card (K g))
    hprime hdisj y hyinj hy n
  simpa only [hyprod, K] using h

/- Unit-bounded complex weights preserve the unweighted factorial fiber bound. -/
theorem norm_labelled_prime_product_fiber_sum_le
    
    (w : Ω → ℂ) (hw : ∀ a, ‖w a‖ ≤ 1) (n : ℕ) :
    ‖∑ a : Ω, if (∏ i, x a i) = n then w a else 0‖ ≤
      ∏ g, ((Fintype.card {i : I // group i = g}).factorial : ℝ) := by
  classical
  calc
    _ ≤ ∑ a : Ω, ‖if (∏ i, x a i) = n then w a else 0‖ := norm_sum_le _ _
    _ ≤ ∑ a : Ω, if (∏ i, x a i) = n then (1 : ℝ) else 0 := by
      apply sum_le_sum
      intro a _
      split_ifs with ha
      · exact hw a
      · simp
    _ = (Nat.card {a : Ω // (∏ i, x a i) = n} : ℝ) := by
      simp [Nat.card_eq_fintype_card, Fintype.card_subtype]
    _ ≤ _ := by
      exact_mod_cast card_labelled_prime_product_fiber group P hprime hdisj x hxinj hx n

end















end Bounty
end

section

/- The full Q-slot factorial normalization has fixed polynomial growth. -/

open Finset Filter

namespace Bounty

theorem eventually_candidate_factorial_normalization_le_rpow {c : ℝ}
    (hc : 0 < c) (r : ℕ) :
    ∀ᶠ L : ℝ in atTop,
      (r.factorial : ℝ) ^ (candidateQIndices c L).card ≤
        L ^ ((1 / Real.log 2 + 1) * Real.log (r.factorial : ℝ)) := by
  have hfac : (1 : ℝ) ≤ r.factorial := by
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr (Nat.factorial_ne_zero r)
  filter_upwards [eventually_candidateQIndices_geometry hc,
    eventually_gt_atTop (0 : ℝ)] with L hgeom hL
  simpa only [prod_const] using
    group_product_bound_of_log_card (candidateQIndices c L) (fun _ => (r.factorial : ℝ))
      hfac hL (fun _ _ => Nat.cast_nonneg _) (fun _ _ => le_rfl) hgeom.1

theorem exists_candidate_factorial_normalization_polynomial_bound {c : ℝ}
    (hc : 0 < c) (r : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ L : ℝ in atTop,
      (r.factorial : ℝ) ^ (candidateQIndices c L).card ≤ L ^ C := by
  have hfac : (1 : ℝ) ≤ r.factorial := by
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr (Nat.factorial_ne_zero r)
  refine ⟨(1 / Real.log 2 + 1) * Real.log (r.factorial : ℝ), ?_,
    eventually_candidate_factorial_normalization_le_rpow hc r⟩
  exact mul_nonneg (by positivity) (Real.log_nonneg hfac)


end Bounty
end

section

/- Uniform polynomial derivative bounds on fixed compact support control all Schwartz seminorms. -/

open Finset MeasureTheory
open scoped FourierTransform

namespace Bounty

section

variable
  {I : Type*}
  (f : I → SchwartzMap (EuclideanSpace ℝ (Fin 3)) ℂ)
  (w : I → ℝ)
  (hw : ∀ p, 1 ≤ w p)

include I f w hw

theorem schwartz_seminorm_polynomial_of_fixed_support  (R : ℝ) (hR : 0 ≤ R)
    (hsupport : ∀ p, tsupport (f p) ⊆ Metric.closedBall 0 R)
    (hderiv : ∀ n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p x, ‖iteratedFDeriv ℝ n (f p) x‖ ≤ C*(w p)^d) :
    ∀ k n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p, SchwartzMap.seminorm ℂ k n (f p) ≤ C*(w p)^d := by
  intro k n
  obtain ⟨d,C,hC,hbound⟩ := hderiv n
  refine ⟨d,R^k*C,mul_nonneg (pow_nonneg hR _) hC,?_⟩
  intro p
  have hwp : 0 ≤ w p := zero_le_one.trans (hw p)
  apply SchwartzMap.seminorm_le_bound ℂ k n (f p) (by positivity)
  intro x
  by_cases hz : iteratedFDeriv ℝ n (f p) x = 0
  · rw [hz, norm_zero, mul_zero]
    positivity
  · have hx : x ∈ tsupport (f p) := (support_iteratedFDeriv_subset n) hz
    have hxR : ‖x‖ ≤ R := by
      simpa only [Metric.mem_closedBall, dist_zero_right] using hsupport p hx
    calc
      _ ≤ R^k*(C*(w p)^d) := mul_le_mul (pow_le_pow_left₀ (norm_nonneg _) hxR _)
        (hbound p x) (norm_nonneg _) (pow_nonneg hR _)
      _ = _ := by ring

theorem continuous_schwartz_seminorm_polynomial 
    (hsemi : ∀ k n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p, SchwartzMap.seminorm ℂ k n (f p) ≤ C*(w p)^d)
    (q : Seminorm ℂ (SchwartzMap (EuclideanSpace ℝ (Fin 3)) ℂ)) (hq : Continuous q) :
    ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ p, q (f p) ≤ C*(w p)^d := by
  classical
  choose d C hC hbound using hsemi
  obtain ⟨s,K,hK,hqK⟩ := Seminorm.bound_of_continuous
    (schwartz_withSeminorms ℂ (EuclideanSpace ℝ (Fin 3)) ℂ) q hq
  let D := s.sup (fun kn => d kn.1 kn.2)
  let M := ∑ kn ∈ s, C kn.1 kn.2
  have hM : 0 ≤ M := sum_nonneg (fun kn _ => hC kn.1 kn.2)
  refine ⟨D,(K : ℝ)*M,mul_nonneg K.coe_nonneg hM,?_⟩
  intro p
  have hwp : 0 ≤ w p := zero_le_one.trans (hw p)
  have hs : s.sup (schwartzSeminormFamily ℂ (EuclideanSpace ℝ (Fin 3)) ℂ) (f p) ≤ M*(w p)^D := by
    apply Seminorm.finset_sup_apply_le (by positivity)
    intro kn hkn
    have hCM : C kn.1 kn.2 ≤ M := single_le_sum (fun kn _ => hC kn.1 kn.2) hkn
    have hdD : d kn.1 kn.2 ≤ D := Finset.le_sup (f := fun kn => d kn.1 kn.2) hkn
    exact (hbound kn.1 kn.2 p).trans (mul_le_mul hCM
      (pow_le_pow_right₀ (hw p) hdD) (pow_nonneg (zero_le_one.trans (hw p)) _) hM)
  calc
    _ ≤ (K : ℝ)*s.sup (schwartzSeminormFamily ℂ (EuclideanSpace ℝ (Fin 3)) ℂ) (f p) := hqK (f p)
    _ ≤ (K : ℝ)*(M*(w p)^D) := mul_le_mul_of_nonneg_left hs K.coe_nonneg
    _ = _ := by ring

end


end Bounty
end

section

open scoped ContDiff

namespace Bounty

theorem norm_iteratedFDeriv_slice_le {P E F : Type*}
    [NormedAddCommGroup P] [NormedSpace ℝ P]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F]
    {G : P × E → F} (hG : ContDiff ℝ ∞ G) (p : P) (x : E) (n : ℕ) :
    ‖iteratedFDeriv ℝ n (fun x => G (p, x)) x‖ ≤ ‖iteratedFDeriv ℝ n G (p, x)‖ := by
  let j : E →L[ℝ] P × E := ContinuousLinearMap.inr ℝ P E
  let H : P × E → F := fun y => G (y + (p, 0))
  have hH : ContDiff ℝ ∞ H := hG.comp (contDiff_id.add contDiff_const)
  have heq : (fun x => G (p, x)) = H ∘ j := by
    funext y
    simp [H, j]
  rw [heq, j.iteratedFDeriv_comp_right hH x (i := n) (by exact WithTop.coe_le_coe.mpr le_top)]
  apply (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans
  have hj : ‖j‖ ≤ 1 := ContinuousLinearMap.norm_inr_le_one ℝ P E
  have hprod : (∏ _i : Fin n, ‖j‖) ≤ 1 :=
    Finset.prod_le_one₀ (fun _ _ => norm_nonneg j) (fun _ _ => hj)
  calc
    _ ≤ ‖iteratedFDeriv ℝ n H (j x)‖ * 1 := mul_le_mul_of_nonneg_left hprod (norm_nonneg _)
    _ = _ := by
      simp only [mul_one, H, iteratedFDeriv_comp_add_right]
      simp [j]

end Bounty
end

section

/- Quantitative tails obtained from actual integrable Schwartz moments. -/

open MeasureTheory

namespace Bounty

theorem euclidean_schwartz_norm_tail_le_moment {N : ℕ} (g : SchwartzMap (EuclideanSpace ℝ (Fin N)) ℂ) (M : ℕ)
    {R : ℝ} (hR : 0 < R) :
    (∫ x in {x : EuclideanSpace ℝ (Fin N) | R < ‖x‖}, ‖g x‖) ≤
      (∫ x : EuclideanSpace ℝ (Fin N), ‖x‖ ^ M * ‖g x‖) / R ^ M := by
  have hs : MeasurableSet {x : EuclideanSpace ℝ (Fin N) | R < ‖x‖} :=
    (isOpen_lt continuous_const continuous_norm).measurableSet
  have hw := g.integrable_pow_mul volume M
  have hcomp :
      (∫ x in {x : EuclideanSpace ℝ (Fin N) | R < ‖x‖}, R ^ M * ‖g x‖) ≤
        ∫ x in {x : EuclideanSpace ℝ (Fin N) | R < ‖x‖}, ‖x‖ ^ M * ‖g x‖ := by
    apply setIntegral_mono_on (g.integrable.norm.const_mul (R ^ M)).integrableOn
      hw.integrableOn hs
    intro x hx
    exact mul_le_mul_of_nonneg_right (pow_le_pow_left₀ hR.le hx.le M) (norm_nonneg _)
  rw [integral_const_mul] at hcomp
  have hwhole : (∫ x in {x : EuclideanSpace ℝ (Fin N) | R < ‖x‖}, ‖x‖ ^ M * ‖g x‖) ≤
      ∫ x : EuclideanSpace ℝ (Fin N), ‖x‖ ^ M * ‖g x‖ := by
    exact setIntegral_le_integral hw
      (Filter.Eventually.of_forall (fun x => mul_nonneg (pow_nonneg (norm_nonneg x) M)
        (norm_nonneg (g x))))
  apply (le_div_iff₀ (pow_pos hR M)).2
  calc
    _ = R ^ M * (∫ x in {x : EuclideanSpace ℝ (Fin N) | R < ‖x‖}, ‖g x‖) := mul_comm _ _
    _ ≤ _ := hcomp.trans hwhole


end Bounty
end

section

/- Scalar costs for the actual candidate allocation slots. The truncation
constant may depend on its chosen order; the order threshold does not depend
on that constant or on the allocation target and initial scale. -/

open Finset Filter

namespace Bounty

noncomputable def candidateSlotCostExponent (r : ℕ) (C : ℝ) : ℝ :=
  (1 / Real.log 2 + 1) * (r : ℝ) * Real.log C

theorem candidate_slot_cost_exponent_nonneg (r : ℕ) {C : ℝ} (hC : 1 ≤ C) :
    0 ≤ candidateSlotCostExponent r C := by
  unfold candidateSlotCostExponent
  exact mul_nonneg (mul_nonneg (by positivity) (Nat.cast_nonneg _))
    (Real.log_nonneg hC)

theorem eventually_candidate_slot_power_le_rpow {c C : ℝ}
    (hc : 0 < c) (hC : 1 ≤ C) (r : ℕ) :
    ∀ᶠ L : ℝ in atTop,
      C ^ ((candidateQIndices c L).card * r) ≤
        L ^ candidateSlotCostExponent r C := by
  filter_upwards [eventually_candidateQIndices_geometry hc,
    eventually_gt_atTop (0 : ℝ)] with L hgeom hL
  have hp := group_product_bound_of_log_card (candidateQIndices c L)
    (fun _ => C ^ r) (one_le_pow₀ hC) hL
    (fun _ _ => pow_nonneg (by linarith) _) (fun _ _ => le_rfl) hgeom.1
  simpa only [prod_const, ← pow_mul, Nat.mul_comm r, Real.log_pow,
    candidateSlotCostExponent, mul_assoc] using hp

theorem all_pattern_truncation_cost_le (N : ℕ) {C D : ℝ}
    (hC : 1 ≤ C) (hD : 0 ≤ D) :
    (2 : ℝ) ^ N * N * D * C ^ (N - 1) ≤ D * (4 * C) ^ N := by
  have hN : (N : ℝ) ≤ (2 : ℝ) ^ N := by
    exact_mod_cast (Nat.lt_two_pow_self (n := N)).le
  have hC0 : 0 ≤ C := zero_le_one.trans hC
  have hp : C ^ (N - 1) ≤ C ^ N := pow_le_pow_right₀ hC (Nat.sub_le _ _)
  calc
    _ = D * ((2 : ℝ) ^ N * ((N : ℝ) * C ^ (N - 1))) := by ring
    _ ≤ D * ((2 : ℝ) ^ N * ((2 : ℝ) ^ N * C ^ N)) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left (mul_le_mul hN hp (pow_nonneg hC0 _) (by positivity))
          (by positivity)) hD
    _ = _ := by rw [mul_pow, show (4 : ℝ) = 2 * 2 by norm_num, mul_pow]; ring

theorem eventually_candidate_truncation_cost_le {c C D B : ℝ}
    (hc : 0 < c) (hC : 1 ≤ C) (hD : 0 ≤ D) (r M : ℕ)
    (hM : candidateSlotCostExponent r (4 * C) + B + 1 ≤ (M : ℝ)) :
    ∀ᶠ L : ℝ in atTop,
      (2 : ℝ) ^ ((candidateQIndices c L).card * r) *
        ((candidateQIndices c L).card * r : ℕ) * D *
        C ^ ((candidateQIndices c L).card * r - 1) * L ^ (-(M : ℝ)) ≤
          L ^ (-B) := by
  have h4C : 1 ≤ 4 * C := by linarith
  filter_upwards [eventually_candidate_slot_power_le_rpow hc h4C r,
    eventually_ge_atTop (1 : ℝ), eventually_ge_atTop D] with L hp hL hDL
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  calc
    _ ≤ (D * (4 * C) ^ ((candidateQIndices c L).card * r)) * L ^ (-(M : ℝ)) :=
      mul_le_mul_of_nonneg_right (all_pattern_truncation_cost_le _ hC hD)
        (Real.rpow_nonneg hL0.le _)
    _ ≤ (L * L ^ candidateSlotCostExponent r (4 * C)) * L ^ (-(M : ℝ)) :=
      mul_le_mul_of_nonneg_right
        (mul_le_mul hDL hp (by positivity) hL0.le) (Real.rpow_nonneg hL0.le _)
    _ = L ^ (1 + candidateSlotCostExponent r (4 * C) - (M : ℝ)) := by
      rw [sub_eq_add_neg, Real.rpow_add hL0, Real.rpow_add hL0, Real.rpow_one]
    _ ≤ L ^ (-B) := Real.rpow_le_rpow_of_exponent_le hL (by linarith)

theorem exists_candidate_truncation_order {c C : ℝ}
    (hc : 0 < c) (hC : 1 ≤ C) (r : ℕ) (B : ℝ) :
    ∃ M₀ : ℕ, ∀ M : ℕ, M₀ ≤ M → ∀ D : ℝ, 0 ≤ D →
      ∀ᶠ L : ℝ in atTop,
        (2 : ℝ) ^ ((candidateQIndices c L).card * r) *
          ((candidateQIndices c L).card * r : ℕ) * D *
          C ^ ((candidateQIndices c L).card * r - 1) * L ^ (-(M : ℝ)) ≤
            L ^ (-B) := by
  obtain ⟨M₀, hM₀⟩ := exists_nat_ge (candidateSlotCostExponent r (4 * C) + B + 1)
  refine ⟨M₀, fun M hM D hD => eventually_candidate_truncation_cost_le hc hC hD r M ?_⟩
  exact hM₀.trans (by exact_mod_cast hM)

end Bounty
end

section

/- Finite perturbations supported on a boundary set, with arbitrary complex inner sums. -/

open Finset

namespace Bounty

theorem finite_boundary_perturbation_norm_le
    (T S : Finset ℕ) (μ : ℕ → ℝ) (ε G : ℕ → ℂ)
    (hμ : ∀ u, 0 ≤ μ u)
    (hsupport : ∀ u ∈ T, u ∉ S → ε u = 0)
    (hε : ∀ u ∈ T ∩ S, ‖ε u‖ ≤ 1) :
    ‖∑ u ∈ T, (μ u : ℂ) * ε u * G u‖ ≤ ∑ u ∈ S, μ u * ‖G u‖ := by
  classical
  have hrestrict : (∑ u ∈ T, (μ u : ℂ) * ε u * G u) =
      ∑ u ∈ T ∩ S, (μ u : ℂ) * ε u * G u := by
    symm
    apply sum_subset inter_subset_left
    intro u hu hnot
    have huS : u ∉ S := fun hs => hnot (mem_inter.mpr ⟨hu, hs⟩)
    rw [hsupport u hu huS, mul_zero, zero_mul]
  rw [hrestrict]
  calc
    _ ≤ ∑ u ∈ T ∩ S, ‖(μ u : ℂ) * ε u * G u‖ := norm_sum_le _ _
    _ ≤ ∑ u ∈ T ∩ S, μ u * ‖G u‖ := by
      apply sum_le_sum
      intro u hu
      rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hμ u)]
      simpa only [mul_one] using
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (hε u hu) (hμ u)) (norm_nonneg (G u))
    _ ≤ _ := sum_le_sum_of_subset_of_nonneg inter_subset_right
      (fun u _ _ => mul_nonneg (hμ u) (norm_nonneg (G u)))




/- Both sharp and smoothed terms use the same outer finite domain. -/
theorem finite_sharp_smoothed_difference_eq
    (T W : Finset ℕ) (μ ψ : ℕ → ℝ) (G : ℕ → ℂ) :
    (∑ u ∈ T ∩ W, (μ u : ℂ) * G u) -
        (∑ u ∈ T, (μ u : ℂ) * (ψ u : ℂ) * G u) =
      ∑ u ∈ T, (μ u : ℂ) * (((if u ∈ W then 1 else 0 : ℝ) - ψ u : ℝ) : ℂ) * G u := by
  classical
  rw [← filter_mem_eq_inter, sum_filter, ← sum_sub_distrib]
  apply sum_congr rfl
  intro u _
  by_cases hu : u ∈ W <;>
    simp only [hu, if_true, if_false, Complex.ofReal_sub, Complex.ofReal_one, Complex.ofReal_zero] <;>
    ring

theorem finite_sharp_smoothed_difference_norm_le
    (T S W : Finset ℕ) (μ ψ : ℕ → ℝ) (G : ℕ → ℂ)
    (hμ : ∀ u, 0 ≤ μ u) (hψ : ∀ u ∈ T, 0 ≤ ψ u ∧ ψ u ≤ 1)
    (hmatch : ∀ u ∈ T, u ∉ S → ψ u = if u ∈ W then 1 else 0) :
    ‖(∑ u ∈ T ∩ W, (μ u : ℂ) * G u) -
        (∑ u ∈ T, (μ u : ℂ) * (ψ u : ℂ) * G u)‖ ≤
      ∑ u ∈ S, μ u * ‖G u‖ := by
  rw [finite_sharp_smoothed_difference_eq]
  apply finite_boundary_perturbation_norm_le T S μ _ G hμ
  · intro u hu hnot
    rw [hmatch u hu hnot, sub_self, Complex.ofReal_zero]
  · intro u hu
    obtain ⟨hψ0, hψ1⟩ := hψ u (mem_inter.mp hu).1
    rw [Complex.norm_real, Real.norm_eq_abs, abs_le]
    by_cases huW : u ∈ W
    · simp only [if_pos huW]
      constructor <;> linarith
    · simp only [if_neg huW]
      constructor <;> linarith

theorem finite_divisor_sharp_smoothed_difference_norm_le
    (T S W : Finset ℕ) (μ ψ : ℕ → ℝ) (F : ℕ → ℕ → ℂ)
    (hμ : ∀ u, 0 ≤ μ u) (hψ : ∀ u ∈ T, 0 ≤ ψ u ∧ ψ u ≤ 1)
    (hmatch : ∀ u ∈ T, u ∉ S → ψ u = if u ∈ W then 1 else 0) :
    ‖(∑ u ∈ T ∩ W, (μ u : ℂ) * (∑ m ∈ (2 * u + 1).divisors, F u m)) -
        (∑ u ∈ T, (μ u : ℂ) * (ψ u : ℂ) * (∑ m ∈ (2 * u + 1).divisors, F u m))‖ ≤
      ∑ u ∈ S, μ u * (∑ m ∈ (2 * u + 1).divisors, ‖F u m‖) := by
  apply (finite_sharp_smoothed_difference_norm_le T S W μ ψ
    (fun u => ∑ m ∈ (2 * u + 1).divisors, F u m) hμ hψ hmatch).trans
  apply sum_le_sum
  intro u _
  exact mul_le_mul_of_nonneg_left (norm_sum_le _ _) (hμ u)


end Bounty
end

section

/- Include the initial active labels in the same distinctness condition as every later birth. -/

open Classical

namespace Bounty

def initialAndBirthLabels {I J α : Type*} (initial : I → α) (birth : J → Option α) :
    I ⊕ J → Option α := Sum.elim (fun i => some (initial i)) birth

theorem initial_birth_distinctness_iff {I J α : Type*}
    (initial : I → α) (birth : J → Option α) :
    (∀ a b z, initialAndBirthLabels initial birth a = some z →
      initialAndBirthLabels initial birth b = some z → a = b) ↔
      Function.Injective initial ∧
        (∀ a b z, birth a = some z → birth b = some z → a = b) ∧
        (∀ i j, birth j ≠ some (initial i)) := by
  constructor
  · intro h
    refine ⟨?_, ?_, ?_⟩
    · intro i j hij
      exact Sum.inl.inj (h (.inl i) (.inl j) (initial i) rfl (by
        change some (initial j) = some (initial i)
        rw [hij]))
    · intro a b z ha hb
      exact Sum.inr.inj (h (.inr a) (.inr b) z ha hb)
    · intro i j hj
      have hbad := h (.inl i) (.inr j) (initial i) rfl hj
      cases hbad
  · rintro ⟨hinj, hbirth, havoid⟩ a b z ha hb
    cases a with
    | inl i =>
      cases b with
      | inl j =>
        exact congrArg Sum.inl (hinj (Option.some.inj (ha.trans hb.symm)))
      | inr j =>
        exact False.elim (havoid i j (hb.trans ha.symm))
    | inr i =>
      cases b with
      | inl j =>
        exact False.elim (havoid j i (ha.trans hb.symm))
      | inr j =>
        exact congrArg Sum.inr (hbirth i j z ha hb)




end Bounty
end

section

/- Dilation enters the original full event through divisibility tests only.
Equal tests give an exact event bijection, including fallback targets and caps. -/

open Finset
open scoped Classical
namespace Bounty

section Dilation
variable {P : Type*} (n : P → ℕ) (Δ D D' : ℤ)
  (hD : ∀ p, ((n p : ℤ) ∣ D ↔ (n p : ℤ) ∣ D'))




include hD in
theorem unrestricted_residue_storage_dilation_congr {t : ℕ}
    (source : Fin t → P) (stores : Finset (Fin t)) :
    unrestrictedResidueStorageAllowed n D source stores ↔
      unrestrictedResidueStorageAllowed n D' source stores := by
  simp only [unrestrictedResidueStorageAllowed, hD]

def unrestrictedDilationEventMap {t B : ℕ}
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (e : UnrestrictedBoundedEvent n Δ D t B s) :
    UnrestrictedBoundedEvent n Δ D' t B s :=
  ⟨e.1, e.2.1,
    ⟨{ toFun := fun i => ⟨(e.2.2.1 i).val, by
          have h := (mem_unrestrictedResidueEligible n Δ D s.2.2 (e.2.2.1 i).val).mp (e.2.2.1 i).property
          exact (mem_unrestrictedResidueEligible n Δ D' s.2.2 (e.2.2.1 i).val).mpr
            ⟨h.1, fun hd => h.2 ((hD _).mpr hd)⟩⟩
       inj' := by
          intro i j hij
          apply e.2.2.1.injective
          exact Subtype.ext (congrArg (fun z : ↥(unrestrictedResidueEligible n Δ D' s.2.2) => z.val) hij) },
      e.2.2.2⟩⟩

def unrestrictedDilationEventEquiv {t B : ℕ}
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B) :
    UnrestrictedBoundedEvent n Δ D t B s ≃ UnrestrictedBoundedEvent n Δ D' t B s where
  toFun := unrestrictedDilationEventMap n Δ D D' hD s
  invFun := unrestrictedDilationEventMap n Δ D' D (fun p => (hD p).symm) s
  left_inv e := by rcases e with ⟨stores, promotions, e, fresh⟩; rfl
  right_inv e := by rcases e with ⟨stores, promotions, e, fresh⟩; rfl

theorem unrestricted_dilation_event_target {t B : ℕ}
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (e : UnrestrictedBoundedEvent n Δ D t B s) :
    unrestrictedBoundedEventTarget n Δ D' t B s (unrestrictedDilationEventEquiv n Δ D D' hD s e) =
      unrestrictedBoundedEventTarget n Δ D t B s e := by
  rfl

theorem unrestricted_dilation_event_weight (μ : P → ℝ) (ρ V : ℝ) {t B : ℕ}
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (e : UnrestrictedBoundedEvent n Δ D t B s) :
    unrestrictedBoundedEventWeight n Δ D' μ ρ V t B s
      (unrestrictedDilationEventEquiv n Δ D D' hD s e) =
      unrestrictedBoundedEventWeight n Δ D μ ρ V t B s e := by
  let out := unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
    (unrestrictedResidueTransport n Δ) e.1 e.2.1 e.2.2.1
  let mass := unrestrictedEdgeEventMass s.1 s.2.2 (unrestrictedResidueSeed n)
    (unrestrictedResidueTransport n Δ) unrestrictedResidueHit μ ρ V e.1 e.2.1 e.2.2.1 e.2.2.2
  change (if unrestrictedResidueStorageAllowed n D' s.1 e.1 ∧ out.1 ≤ B then mass else 0) =
    (if unrestrictedResidueStorageAllowed n D s.1 e.1 ∧ out.1 ≤ B then mass else 0)
  by_cases hd : unrestrictedResidueStorageAllowed n D s.1 e.1
  · have hd' := (unrestricted_residue_storage_dilation_congr n D D' hD s.1 e.1).mp hd
    simp only [hd, hd', true_and]
  · have hd' : ¬ unrestrictedResidueStorageAllowed n D' s.1 e.1 :=
      fun h => hd ((unrestricted_residue_storage_dilation_congr n D D' hD s.1 e.1).mpr h)
    simp only [hd, hd', false_and, ite_false]

end Dilation
end Bounty
end

section

/- Uniform polynomial derivative bounds on fixed compact support control all Schwartz seminorms. -/

open Finset MeasureTheory
open scoped FourierTransform

namespace Bounty

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

theorem schwartz_domain_seminorm_polynomial_of_fixed_support {I : Type*}
    (f : I → SchwartzMap E ℂ) (w : I → ℝ)
    (hw : ∀ p, 1 ≤ w p) (R : ℝ) (hR : 0 ≤ R)
    (hsupport : ∀ p, tsupport (f p) ⊆ Metric.closedBall 0 R)
    (hderiv : ∀ n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p x, ‖iteratedFDeriv ℝ n (f p) x‖ ≤ C*(w p)^d) :
    ∀ k n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p, SchwartzMap.seminorm ℂ k n (f p) ≤ C*(w p)^d := by
  intro k n
  obtain ⟨d,C,hC,hbound⟩ := hderiv n
  refine ⟨d,R^k*C,mul_nonneg (pow_nonneg hR _) hC,?_⟩
  intro p
  have hwp : 0 ≤ w p := zero_le_one.trans (hw p)
  apply SchwartzMap.seminorm_le_bound ℂ k n (f p) (by positivity)
  intro x
  by_cases hz : iteratedFDeriv ℝ n (f p) x = 0
  · rw [hz, norm_zero, mul_zero]
    positivity
  · have hx : x ∈ tsupport (f p) := (support_iteratedFDeriv_subset n) hz
    have hxR : ‖x‖ ≤ R := by
      simpa only [Metric.mem_closedBall, dist_zero_right] using hsupport p hx
    calc
      _ ≤ R^k*(C*(w p)^d) := mul_le_mul (pow_le_pow_left₀ (norm_nonneg _) hxR _)
        (hbound p x) (norm_nonneg _) (pow_nonneg hR _)
      _ = _ := by ring

theorem continuous_schwartz_domain_seminorm_polynomial {I : Type*}
    (f : I → SchwartzMap E ℂ) (w : I → ℝ)
    (hw : ∀ p, 1 ≤ w p)
    (hsemi : ∀ k n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p, SchwartzMap.seminorm ℂ k n (f p) ≤ C*(w p)^d)
    (q : Seminorm ℂ (SchwartzMap E ℂ)) (hq : Continuous q) :
    ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ p, q (f p) ≤ C*(w p)^d := by
  classical
  choose d C hC hbound using hsemi
  obtain ⟨s,K,hK,hqK⟩ := Seminorm.bound_of_continuous
    (schwartz_withSeminorms ℂ E ℂ) q hq
  let D := s.sup (fun kn => d kn.1 kn.2)
  let M := ∑ kn ∈ s, C kn.1 kn.2
  have hM : 0 ≤ M := sum_nonneg (fun kn _ => hC kn.1 kn.2)
  refine ⟨D,(K : ℝ)*M,mul_nonneg K.coe_nonneg hM,?_⟩
  intro p
  have hwp : 0 ≤ w p := zero_le_one.trans (hw p)
  have hs : s.sup (schwartzSeminormFamily ℂ E ℂ) (f p) ≤ M*(w p)^D := by
    apply Seminorm.finset_sup_apply_le (by positivity)
    intro kn hkn
    have hCM : C kn.1 kn.2 ≤ M := single_le_sum (fun kn _ => hC kn.1 kn.2) hkn
    have hdD : d kn.1 kn.2 ≤ D := Finset.le_sup (f := fun kn => d kn.1 kn.2) hkn
    exact (hbound kn.1 kn.2 p).trans (mul_le_mul hCM
      (pow_le_pow_right₀ (hw p) hdD) (pow_nonneg (zero_le_one.trans (hw p)) _) hM)
  calc
    _ ≤ (K : ℝ)*s.sup (schwartzSeminormFamily ℂ E ℂ) (f p) := hqK (f p)
    _ ≤ (K : ℝ)*(M*(w p)^D) := mul_le_mul_of_nonneg_left hs K.coe_nonneg
    _ = _ := by ring

end Bounty
end

section

/- Removing a simple prime factor deletes exactly that prime from its divisor pool. -/

open Finset

namespace Bounty

theorem physical_divisor_pool_div_simple_prime {G : Type*}
    (P : G → Finset ℕ) (g : G) (hP : ∀ r ∈ P g, r.Prime)
    {n p : ℕ} (hp : p ∈ P g) (hpn : p ∣ n) (hpp : ¬ p ^ 2 ∣ n) :
    physicalDivisorPool P g ((n / p : ℕ) : ℤ) =
      (physicalDivisorPool P g (n : ℤ)).erase p := by
  classical
  have hpprime := hP p hp
  have hmul : n / p * p = n := Nat.div_mul_cancel hpn
  have hpnot : ¬ p ∣ n / p := by
    intro h
    apply hpp
    have hd := Nat.mul_dvd_mul_right h p
    simpa only [← pow_two, hmul] using hd
  ext r
  simp only [physicalDivisorPool, mem_filter, mem_erase, Int.natCast_dvd_natCast]
  constructor
  · rintro ⟨hr, hrn⟩
    refine ⟨?_, hr, dvd_trans hrn (Nat.div_dvd_of_dvd hpn)⟩
    intro he
    subst r
    exact hpnot hrn
  · rintro ⟨hrp, hr, hrn⟩
    refine ⟨hr, ?_⟩
    rw [← hmul] at hrn
    rcases (hP r hr).dvd_mul.mp hrn with hq | hpdiv
    · exact hq
    · rcases (Nat.dvd_prime hpprime).mp hpdiv with hone | heq
      · exact False.elim ((hP r hr).ne_one hone)
      · exact False.elim (hrp heq)

theorem physical_omega_div_simple_prime {G : Type*}
    (P : G → Finset ℕ) (g : G) (hP : ∀ r ∈ P g, r.Prime)
    {n p : ℕ} (hp : p ∈ P g) (hpn : p ∣ n) (hpp : ¬ p ^ 2 ∣ n) :
    physicalOmega P g ((n / p : ℕ) : ℤ) = physicalOmega P g (n : ℤ) - 1 := by
  unfold physicalOmega
  rw [physical_divisor_pool_div_simple_prime P g hP hp hpn hpp, card_erase_of_mem]
  exact mem_filter.mpr ⟨hp, by exact_mod_cast hpn⟩

theorem physical_divisor_pool_div_other_prime {G : Type*}
    (P : G → Finset ℕ) (g : G) (hP : ∀ r ∈ P g, r.Prime)
    {n p : ℕ} (hp : p.Prime) (hpout : p ∉ P g) (hpn : p ∣ n) :
    physicalDivisorPool P g ((n / p : ℕ) : ℤ) = physicalDivisorPool P g (n : ℤ) := by
  classical
  have hmul : n / p * p = n := Nat.div_mul_cancel hpn
  ext r
  simp only [physicalDivisorPool, mem_filter, Int.natCast_dvd_natCast]
  constructor
  · rintro ⟨hr, hrn⟩
    exact ⟨hr, dvd_trans hrn (Nat.div_dvd_of_dvd hpn)⟩
  · rintro ⟨hr, hrn⟩
    refine ⟨hr, ?_⟩
    rw [← hmul] at hrn
    rcases (hP r hr).dvd_mul.mp hrn with hq | hpdiv
    · exact hq
    · rcases (Nat.dvd_prime hp).mp hpdiv with hone | heq
      · exact False.elim ((hP r hr).ne_one hone)
      · exact False.elim (hpout (heq ▸ hr))

end Bounty
end

section

/- Extending a birth label by none creates no performed births or collisions outside its embedded addresses. -/

open Classical
namespace Bounty

noncomputable def optionalBirthExtension {A B Z : Type*} (e : A ↪ B)
    (label : A → Option Z) : B → Option Z :=
  Function.extend e label (fun _ => none)

section

variable
  {A B Z : Type*}
  (e : A ↪ B)
  (label : A → Option Z)

include A B Z e label

theorem optional_birth_extension_apply  (a : A) : optionalBirthExtension e label (e a) = label a :=
  e.injective.extend_apply label (fun _ => none) a

theorem optional_birth_extension_none  (b : B) (hb : ¬∃ a, e a = b) :
    optionalBirthExtension e label b = none :=
  Function.extend_apply' label (fun _ => none) b hb

theorem optional_birth_extension_some_iff  (b : B) (z : Z) :
    optionalBirthExtension e label b = some z ↔ ∃ a, e a = b ∧ label a = some z := by
  constructor
  · intro h
    by_cases hb : ∃ a, e a = b
    · obtain ⟨a, rfl⟩ := hb
      exact ⟨a, rfl, (optional_birth_extension_apply e label a).symm.trans h⟩
    · rw [optional_birth_extension_none e label b hb] at h
      cases h
  · rintro ⟨a, rfl, h⟩
    exact (optional_birth_extension_apply e label a).trans h

theorem optional_birth_extension_distinct_iff  :
    (∀ a b z, optionalBirthExtension e label a = some z →
      optionalBirthExtension e label b = some z → a = b) ↔
    (∀ a b z, label a = some z → label b = some z → a = b) := by
  constructor
  · intro h a b z ha hb
    apply e.injective
    exact h (e a) (e b) z ((optional_birth_extension_apply e label a).trans ha)
      ((optional_birth_extension_apply e label b).trans hb)
  · intro h a b z ha hb
    obtain ⟨a', rfl, ha'⟩ := (optional_birth_extension_some_iff e label a z).mp ha
    obtain ⟨b', rfl, hb'⟩ := (optional_birth_extension_some_iff e label b z).mp hb
    exact congrArg e (h a' b' z ha' hb')

theorem optional_birth_extension_all_iff  (Q : Z → Prop) :
    (∀ b z, optionalBirthExtension e label b = some z → Q z) ↔
      (∀ a z, label a = some z → Q z) := by
  constructor
  · intro h a z ha
    exact h (e a) z ((optional_birth_extension_apply e label a).trans ha)
  · intro h b z hb
    obtain ⟨a, _, ha⟩ := (optional_birth_extension_some_iff e label b z).mp hb
    exact h a z ha

end


theorem optional_birth_extension_map {A B Z Y : Type*} (e : A ↪ B)
    (label : A → Option Z) (f : Z → Y) (b : B) :
    (optionalBirthExtension e label b).map f =
      optionalBirthExtension e (fun a => (label a).map f) b := by
  by_cases hb : ∃ a, e a = b
  · obtain ⟨a, rfl⟩ := hb
    rw [optional_birth_extension_apply, optional_birth_extension_apply]
  · rw [optional_birth_extension_none e label b hb,
      optional_birth_extension_none e (fun a => (label a).map f) b hb]
    rfl

end Bounty
end

section

/- Quantitative additive/logarithmic kernel comparison on positive dyadic centers. -/

open scoped NNReal

namespace Bounty

theorem abs_log_one_add_sub_self_le {x : ℝ} (hx : |x| ≤ 1 / 2) :
    |Real.log (1 + x) - x| ≤ 2 * x ^ 2 := by
  have hh := Real.abs_log_sub_add_sum_range_le
    (x := -x) (by simpa only [abs_neg] using (lt_of_le_of_lt hx (by norm_num : (1 : ℝ) / 2 < 1))) 1
  simp only [Finset.sum_range_one, Nat.cast_zero, zero_add, pow_one, div_one,
    sub_neg_eq_add, abs_neg] at hh
  have hden : 0 < 1 - |x| := by linarith
  have hb : |x| ^ 2 / (1 - |x|) ≤ 2 * x ^ 2 := by
    apply (div_le_iff₀ hden).mpr
    rw [sq_abs]
    nlinarith [sq_nonneg x, mul_nonneg (sq_nonneg x) (show 0 ≤ 1 - 2 * |x| by linarith)]
  have hh' : |Real.log (1 + x) - x| ≤ |x|^2 / (1-|x|) := by
    simpa only [neg_add_eq_sub] using hh
  exact hh'.trans hb

theorem additive_log_displacement_bound {w v : ℝ} (hv : 0 < v)
    (hclose : |w - v| ≤ v / 2) :
    |(w - v) - v * Real.log (w / v)| ≤ 2 * (w - v) ^ 2 / v := by
  have hx : |(w - v) / v| ≤ 1 / 2 := by
    rw [abs_div, abs_of_pos hv]
    exact (div_le_iff₀ hv).mpr (by linarith)
  have ht := abs_log_one_add_sub_self_le hx
  have harg : 1 + (w - v) / v = w / v := by field_simp; ring
  rw [harg] at ht
  calc
    _ = |v * (Real.log (w / v) - (w - v) / v)| := by
      rw [abs_sub_comm]
      congr 1
      field_simp
    _ = v * |Real.log (w / v) - (w - v) / v| := by rw [abs_mul, abs_of_pos hv]
    _ ≤ v * (2 * ((w - v) / v) ^ 2) := mul_le_mul_of_nonneg_left ht hv.le
    _ = _ := by field_simp

theorem normalized_additive_log_displacement_bound {w v H : ℝ}
    (hv : 0 < v) (hH : 0 < H) (hclose : |w - v| ≤ v / 2) :
    |(w - v) / H - v * Real.log (w / v) / H| ≤
      2 * (w - v) ^ 2 / (v * H) := by
  rw [← sub_div, abs_div, abs_of_pos hH]
  exact (div_le_div_of_nonneg_right (additive_log_displacement_bound hv hclose) hH.le).trans_eq (by ring)

theorem normalized_log_displacement_dyadic_bound {w v H Y R : ℝ}
    (hY : 0 < Y) (hH : 0 < H) (_hR : 0 ≤ R) (hv : Y / 2 ≤ v)
    (hsmall : R * H ≤ Y / 4) (hclose : |w - v| ≤ R * H) :
    |(w - v) / H - v * Real.log (w / v) / H| ≤ 4 * R ^ 2 * H / Y := by
  have hv0 : 0 < v := by linarith
  have hc : |w-v| ≤ v/2 := by linarith
  apply (normalized_additive_log_displacement_bound hv0 hH hc).trans
  apply (div_le_div_iff₀ (mul_pos hv0 hH) hY).mpr
  have hs : (w-v)^2 ≤ (R*H)^2 := by
    simpa only [sq_abs] using pow_le_pow_left₀ (abs_nonneg (w-v)) hclose 2
  have hmul : R^2*H^2*Y ≤ 2*R^2*H^2*v := by
    nlinarith [mul_nonneg (sq_nonneg R) (sq_nonneg H),
      mul_nonneg (mul_nonneg (sq_nonneg R) (sq_nonneg H)) (show 0≤2*v-Y by linarith)]
  nlinarith [mul_le_mul_of_nonneg_right hs hY.le]

theorem lipschitz_log_kernel_comparison {K : ℝ → ℂ} {C : ℝ≥0}
    (hK : LipschitzWith C K) {w v H Y R : ℝ}
    (hY : 0 < Y) (hH : 0 < H) (hR : 0 ≤ R) (hv : Y / 2 ≤ v)
    (hsmall : R * H ≤ Y / 4) (hclose : |w - v| ≤ R * H) :
    ‖K ((w-v)/H) - K (v*Real.log (w/v)/H)‖ ≤ (C : ℝ) * (4*R^2*H/Y) := by
  exact (hK.norm_sub_le _ _).trans (mul_le_mul_of_nonneg_left
    (by simpa only [Real.norm_eq_abs] using
      normalized_log_displacement_dyadic_bound hY hH hR hv hsmall hclose) C.coe_nonneg)

end Bounty
end

section

/- Variable-length ordered mark lists and their exact divisor-pool fibers. -/

open Finset

namespace Bounty

abbrev GroupMarkedLists {G : Type*} (P : G → Finset ℕ) (t : G → ℕ) :=
  ∀ g, Fin (t g) ↪ ↥(P g)

abbrev GroupMarkedListsAt {G : Type*} (P : G → Finset ℕ) (t : G → ℕ) (n : ℤ) :=
  {L : GroupMarkedLists P t // ∀ g s, ((L g s).val : ℤ) ∣ n}

def groupMarkedListsAtEquiv {G : Type*} (P : G → Finset ℕ) (t : G → ℕ) (n : ℤ) :
    GroupMarkedListsAt P t n ≃ (∀ g, Fin (t g) ↪ ↥(physicalDivisorPool P g n)) where
  toFun L g := {
    toFun := fun s => ⟨(L.val g s).val, mem_filter.mpr ⟨(L.val g s).property, L.property g s⟩⟩
    inj' := by
      intro i j h
      apply (L.val g).injective
      exact Subtype.ext (congrArg (fun p : ↥(physicalDivisorPool P g n) => p.val) h) }
  invFun L := ⟨fun g => {
    toFun := fun s => ⟨(L g s).val, (mem_filter.mp (L g s).property).1⟩
    inj' := by
      intro i j h
      apply (L g).injective
      exact Subtype.ext (congrArg (fun p : ↥(P g) => p.val) h) },
    fun g s => (mem_filter.mp (L g s).property).2⟩
  left_inv L := by
    apply Subtype.ext
    funext g
    apply Function.Embedding.ext
    intro s
    rfl
  right_inv L := by
    funext g
    apply Function.Embedding.ext
    intro s
    rfl

theorem group_marked_lists_at_card {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (t : G → ℕ) (n : ℤ) :
    Nat.card (GroupMarkedListsAt P t n) =
      ∏ g, (physicalOmega P g n).descFactorial (t g) := by
  classical
  rw [Nat.card_congr (groupMarkedListsAtEquiv P t n), Nat.card_eq_fintype_card,
    Fintype.card_pi]
  apply prod_congr rfl
  intro g _
  rw [Fintype.card_embedding_eq]
  simp only [Fintype.card_coe, Fintype.card_fin, physicalOmega]

theorem marked_divisor_weight_eq_fiber_mass {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (q : ℝ) (V : G → ℝ) (t : G → ℕ) (n : ℤ) :
    markedDivisorWeight univ P q V t n =
      (∏ g, q ^ (physicalOmega P g n - t g) / V g ^ t g) *
        (Nat.card (GroupMarkedListsAt P t n) : ℝ) := by
  classical
  rw [group_marked_lists_at_card, Nat.cast_prod, ← prod_mul_distrib]
  unfold markedDivisorWeight markedDivisorFactor
  apply prod_congr rfl
  intro g _
  ring

end Bounty
end

section

/- The full big-active projection is self-adjoint for the original product
memory measure. This identity does not move any small-tail endpoint gate. -/

open Finset
open scoped Classical

namespace Bounty

section

variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  [sharedInstance2 : DecidableEq G]
  {P Z : G → Type*}

include G sharedInstance1 sharedInstance2 P Z

theorem fullActiveAverage_pairing  [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    {M : G → ℕ} {B : ℕ} (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (f h : ProductBoundedOrderedState P Z M B → ℂ) :
    (∑ x, (productMemoryWeight μ ν x : ℂ) * f x * fullActiveAverage h x) =
      ∑ x, (productMemoryWeight μ ν x : ℂ) * fullActiveAverage f x * h x := by
  simp only [fullActiveAverage, mul_sum, sum_mul]
  rw [sum_comm]
  conv_rhs => rw [sum_comm]
  let inv : FullActiveSlotPermutations M ≃ FullActiveSlotPermutations M :=
    Equiv.piCongrRight (fun _ => Equiv.inv _)
  have hi := inv.sum_comp (fun τ : FullActiveSlotPermutations M =>
    ∑ x, (productMemoryWeight μ ν x : ℂ) *
      ((fullActivePermutationWeight M τ : ℂ) * f (fullActivePermutation τ x)) * h x)
  rw [← hi]
  apply sum_congr rfl
  intro τ _
  have hx := (fullActivePermutation τ).sum_comp (fun x =>
    (productMemoryWeight μ ν x : ℂ) *
      ((fullActivePermutationWeight M (inv τ) : ℂ) *
        f ((fullActivePermutation τ).symm x)) * h x)
  have he : fullActivePermutation (P := P) (Z := Z) (B := B) (inv τ) =
      (fullActivePermutation τ).symm := by
    apply Equiv.ext
    intro x
    rfl
  simp only [fullActivePermutation_weight, Equiv.symm_apply_apply] at hx
  rw [he]
  calc
    _ = ∑ x, (productMemoryWeight μ ν x : ℂ) *
        ((fullActivePermutationWeight M (inv τ) : ℂ) * f x) *
          h (fullActivePermutation τ x) := by
      apply sum_congr rfl
      intro x _
      unfold fullActivePermutationWeight
      ring
    _ = _ := hx

theorem fullActiveAverage_conj  {M : G → ℕ} {B : ℕ}
    (f : ProductBoundedOrderedState P Z M B → ℂ) (x) :
    fullActiveAverage (fun y => (starRingEnd ℂ) (f y)) x =
      (starRingEnd ℂ) (fullActiveAverage f x) := by
  simp only [fullActiveAverage, map_sum, map_mul, Complex.conj_ofReal]

theorem fullActiveAverage_self_adjoint  [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    {M : G → ℕ} {B : ℕ} (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (f h : ProductBoundedOrderedState P Z M B → ℂ) :
    (∑ x, (productMemoryWeight μ ν x : ℂ) * (starRingEnd ℂ) (f x) * fullActiveAverage h x) =
      ∑ x, (productMemoryWeight μ ν x : ℂ) * (starRingEnd ℂ) (fullActiveAverage f x) * h x := by
  simpa only [fullActiveAverage_conj] using
    fullActiveAverage_pairing μ ν (fun x => (starRingEnd ℂ) (f x)) h

end


end Bounty
end

section

/- Uniform integrable Fourier envelopes for compact families with two controlled derivatives. -/

open MeasureTheory Set Real
open scoped FourierTransform

namespace Bounty

theorem compact_integral_norm_bound (f : ℝ → ℂ) (R C : ℝ)
    (hs : ∀ x, x ∉ Icc (-R) R → f x = 0) (hb : ∀ x, ‖f x‖ ≤ C) :
    (∫ x, ‖f x‖) ≤ C * volume.real (Icc (-R) R) := by
  rw [← setIntegral_eq_integral_of_forall_compl_eq_zero
    (fun x hx => by rw [hs x hx, norm_zero])]
  calc
    _ ≤ ‖∫ x in Icc (-R) R, ‖f x‖‖ := le_abs_self _
    _ ≤ _ := norm_setIntegral_le_of_norm_le_const (measure_Icc_lt_top)
      (fun x _ => by simpa only [norm_norm] using hb x)

theorem schwartz_fourier_deriv_formula (f : SchwartzMap ℝ ℂ) (s : ℝ) :
    𝓕 (SchwartzMap.derivCLM ℂ ℂ f) s =
      (2 * (Real.pi : ℂ) * Complex.I * (s : ℂ)) * 𝓕 f s := by
  rw [SchwartzMap.fourier_coe]
  change 𝓕 (deriv f) s = _
  rw [Real.fourier_deriv f.integrable f.differentiable
    (SchwartzMap.derivCLM ℂ ℂ f).integrable]
  rfl

theorem compact_schwartz_fourier_envelope {ι : Type*} (f : ι → SchwartzMap ℝ ℂ)
    (R C₀ C₂ : ℝ) (hC₀ : 0 ≤ C₀) (hC₂ : 0 ≤ C₂)
    (hs : ∀ i x, x ∉ Icc (-R) R → f i x = 0)
    (hs₂ : ∀ i x, x ∉ Icc (-R) R →
      SchwartzMap.derivCLM ℂ ℂ (SchwartzMap.derivCLM ℂ ℂ (f i)) x = 0)
    (h₀ : ∀ i x, ‖f i x‖ ≤ C₀)
    (h₂ : ∀ i x, ‖SchwartzMap.derivCLM ℂ ℂ
      (SchwartzMap.derivCLM ℂ ℂ (f i)) x‖ ≤ C₂) :
    ∃ C : ℝ, 0 ≤ C ∧ Integrable (fun s : ℝ => C/(1+s^2)) ∧
      ∀ i s, ‖𝓕 (f i) s‖ ≤ C/(1+s^2) := by
  let V := volume.real (Icc (-R) R)
  refine ⟨(C₀+C₂)*V, mul_nonneg (add_nonneg hC₀ hC₂) (ENNReal.toReal_nonneg), ?_, ?_⟩
  · simpa only [div_eq_mul_inv] using integrable_inv_one_add_sq.const_mul ((C₀+C₂)*V)
  intro i s
  have hf : ‖𝓕 (f i) s‖ ≤ C₀*V := by
    apply (VectorFourier.norm_fourierIntegral_le_integral_norm _ _ _ _ _).trans
    exact compact_integral_norm_bound (f i) R C₀ (hs i) (h₀ i)
  have hd : ‖𝓕 (SchwartzMap.derivCLM ℂ ℂ (SchwartzMap.derivCLM ℂ ℂ (f i))) s‖ ≤ C₂*V := by
    apply (VectorFourier.norm_fourierIntegral_le_integral_norm _ _ _ _ _).trans
    exact compact_integral_norm_bound _ R C₂ (hs₂ i) (h₂ i)
  rw [schwartz_fourier_deriv_formula, schwartz_fourier_deriv_formula] at hd
  simp only [norm_mul, Complex.norm_ofNat, Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos pi_pos, Complex.norm_I, mul_one] at hd
  have hp : 1 ≤ (2*Real.pi)^2 := by nlinarith [two_le_pi]
  have hn : 0 ≤ s^2*‖𝓕 (f i) s‖ := mul_nonneg (sq_nonneg _) (norm_nonneg _)
  have hd' : s^2*‖𝓕 (f i) s‖ ≤ C₂*V := by
    calc
      _ ≤ (2*Real.pi)^2*(s^2*‖𝓕 (f i) s‖) := by
        simpa only [one_mul] using mul_le_mul_of_nonneg_right hp hn
      _ = 2*Real.pi* |s| *(2*Real.pi* |s| *‖𝓕 (f i) s‖) := by rw [← sq_abs s]; ring
      _ ≤ _ := hd
  apply (le_div_iff₀ (by positivity : 0 < 1+s^2)).mpr
  nlinarith

end Bounty
end

section

/- Schwartz decay controls polynomial weights uniformly over scales bounded away from zero. -/

open Real

namespace Bounty

theorem schwartz_scaled_polynomial_weight_bound (f : SchwartzMap ℝ ℂ)
    (j k : ℕ) {a : ℝ} (ha : 0 < a) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ t : ℝ, a ≤ t → ∀ v : ℝ,
      (1+v^2)^((j : ℝ)/4) * |t*v|^k * ‖f (t*v)‖ ≤ C := by
  let Q : ℝ := 1+a⁻¹
  have hQ : 1 ≤ Q := by dsimp [Q]; exact le_add_of_nonneg_right (inv_nonneg.mpr ha.le)
  let B : ℝ := 2^(2*j+k) * (Finset.Iic (2*j+k,0)).sup
    (fun m : ℕ × ℕ => SchwartzMap.seminorm ℂ m.1 m.2) f
  have hB : 0 ≤ B := by dsimp [B]; positivity
  refine ⟨Q^(2*j)*B, mul_nonneg (pow_nonneg (by linarith) _) hB, ?_⟩
  intro t ht v
  have ht0 : 0 < t := ha.trans_le ht
  have hx : |v| ≤ Q*|t*v| := by
    rw [abs_mul, abs_of_pos ht0]
    have hqt : 1 ≤ Q*t := by
      have hat : a⁻¹*a ≤ a⁻¹*t := mul_le_mul_of_nonneg_left ht (inv_nonneg.mpr ha.le)
      rw [inv_mul_cancel₀ ha.ne'] at hat
      dsimp [Q]
      nlinarith
    nlinarith [abs_nonneg v]
  have hbase : 1+v^2 ≤ Q^2*(1+|t*v|)^2 := by
    have hlin : 1+|v| ≤ Q*(1+|t*v|) := by nlinarith
    have hp := pow_le_pow_left₀ (show 0 ≤ 1+|v| by positivity) hlin 2
    rw [mul_pow] at hp
    nlinarith [sq_abs v, abs_nonneg v]
  have hweight : (1+v^2)^((j : ℝ)/4) ≤ Q^(2*j)*(1+|t*v|)^(2*j) := by
    calc
      _ ≤ (1+v^2)^(j : ℝ) := rpow_le_rpow_of_exponent_le (by nlinarith [sq_nonneg v])
        (by have hj : (0 : ℝ) ≤ j := Nat.cast_nonneg _; linarith)
      _ = (1+v^2)^j := rpow_natCast _ _
      _ ≤ (Q^2*(1+|t*v|)^2)^j := pow_le_pow_left₀ (by positivity) hbase _
      _ = _ := by rw [mul_pow, ← pow_mul, ← pow_mul]
  have hdecay : (1+|t*v|)^(2*j+k)*‖f (t*v)‖ ≤ B := by
    simpa only [norm_iteratedFDeriv_zero, Real.norm_eq_abs] using
      (SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℂ)
        (m := (2*j+k,0)) (k := 2*j+k) (n := 0) le_rfl le_rfl f (t*v))
  calc
    _ ≤ (Q^(2*j)*(1+|t*v|)^(2*j)) * (1+|t*v|)^k * ‖f (t*v)‖ := by
      gcongr
      exact le_add_of_nonneg_left zero_le_one
    _ = Q^(2*j)*((1+|t*v|)^(2*j+k)*‖f (t*v)‖) := by rw [pow_add]; ring
    _ ≤ Q^(2*j)*B := mul_le_mul_of_nonneg_left hdecay (pow_nonneg (by linarith) _)

end Bounty
end

section

/- Two explicit derivatives of a Schwartz profile at an exponential scale. -/

namespace Bounty

noncomputable def exponentialProfileArgument (v u : ℝ) : ℝ := Real.exp (-u)*v/(2*Real.pi)

noncomputable def exponentialProfile (g f : SchwartzMap ℝ ℂ) (v u : ℝ) : ℂ :=
  g u * f (exponentialProfileArgument v u)

noncomputable def exponentialProfileFirst (g f : SchwartzMap ℝ ℂ) (v u : ℝ) : ℂ :=
  deriv g u * f (exponentialProfileArgument v u) -
    g u * (exponentialProfileArgument v u : ℂ) * deriv f (exponentialProfileArgument v u)

noncomputable def exponentialProfileSecond (g f : SchwartzMap ℝ ℂ) (v u : ℝ) : ℂ :=
  deriv (deriv g) u * f (exponentialProfileArgument v u) +
    (g u - 2*deriv g u) * (exponentialProfileArgument v u : ℂ) *
      deriv f (exponentialProfileArgument v u) +
    g u * (exponentialProfileArgument v u : ℂ)^2 * deriv (deriv f) (exponentialProfileArgument v u)

theorem exponential_profile_argument_hasDerivAt (v u : ℝ) :
    HasDerivAt (exponentialProfileArgument v) (-exponentialProfileArgument v u) u := by
  have h : HasDerivAt (fun z : ℝ => Real.exp (-z)*v/(2*Real.pi))
      (Real.exp (-u)*(-1)*v/(2*Real.pi)) u :=
    (((Real.hasDerivAt_exp (-u)).comp u (hasDerivAt_neg u)).mul_const v).div_const (2*Real.pi)
  have he : -exponentialProfileArgument v u = Real.exp (-u)*(-1)*v/(2*Real.pi) := by
    unfold exponentialProfileArgument
    ring
  rw [he]
  exact h

theorem exponential_profile_hasDerivAt (g f : SchwartzMap ℝ ℂ) (v u : ℝ) :
    HasDerivAt (exponentialProfile g f v) (exponentialProfileFirst g f v u) u := by
  have hx := exponential_profile_argument_hasDerivAt v u
  have hf := (f.hasDerivAt (exponentialProfileArgument v u)).scomp u hx
  have he : exponentialProfileFirst g f v u =
      deriv g u*f (exponentialProfileArgument v u) +
        g u*((-exponentialProfileArgument v u) • deriv f (exponentialProfileArgument v u)) := by
    simp only [exponentialProfileFirst,Complex.real_smul,Complex.ofReal_neg]
    ring
  rw [he]
  exact (g.hasDerivAt u).mul hf

theorem exponential_profile_first_hasDerivAt (g f : SchwartzMap ℝ ℂ) (v u : ℝ) :
    HasDerivAt (exponentialProfileFirst g f v) (exponentialProfileSecond g f v u) u := by
  let x := exponentialProfileArgument v u
  have hx := exponential_profile_argument_hasDerivAt v u
  have hxC := hx.ofReal_comp
  have hg := g.hasDerivAt u
  have hg' : HasDerivAt (deriv g) (deriv (deriv g) u) u :=
    (SchwartzMap.derivCLM ℂ ℂ g).hasDerivAt u
  have hf := (f.hasDerivAt (exponentialProfileArgument v u)).scomp u hx
  have hf' : HasDerivAt (fun z => deriv f (exponentialProfileArgument v z))
      ((-x) • deriv (deriv f) x) u :=
    ((SchwartzMap.derivCLM ℂ ℂ f).hasDerivAt (exponentialProfileArgument v u)).scomp u hx
  have he : exponentialProfileSecond g f v u =
      (deriv (deriv g) u*f x+deriv g u*((-x) • deriv f x)) -
        ((deriv g u*(x : ℂ)+g u*((-x : ℝ) : ℂ))*deriv f x+
          (g u*(x : ℂ))*((-x) • deriv (deriv f) x)) := by
    simp only [exponentialProfileSecond,Complex.real_smul,Complex.ofReal_neg]
    dsimp only [x]
    ring
  rw [he]
  exact (hg'.mul hf).sub ((hg.mul hxC).mul hf')

end Bounty
end

section

open MeasureTheory

namespace Bounty

section

variable
  {K : ℝ → ℝ}
  {f : ℝ → ℂ}
  (hK : Continuous K)
  (hKi : Integrable K)
  (hK0 : ∀ t, 0 ≤ K t)

include K f hK hKi hK0

theorem translated_kernel_square_integrable
     (hf : Continuous f)
    (hf2 : Integrable (fun t => ‖f t‖^2)) :
    Integrable (fun p : ℝ × ℝ => K (p.1-p.2) * ‖f p.1‖^2)
      (volume.prod volume) := by
  have hc : Continuous (fun p : ℝ × ℝ => K (p.1-p.2) * ‖f p.1‖^2) := by
    fun_prop
  apply (integrable_prod_iff hc.aestronglyMeasurable).mpr
  constructor
  · filter_upwards [] with t
    exact (hKi.comp_sub_left t).mul_const _
  · have heq : (fun t => ∫ r : ℝ, ‖K (t-r) * ‖f t‖^2‖) =
        (fun t => (∫ r : ℝ, K r) * ‖f t‖^2) := by
      funext t
      simp_rw [Real.norm_of_nonneg (mul_nonneg (hK0 _) (sq_nonneg _))]
      rw [integral_mul_const, integral_sub_left_eq_self]
    rw [heq]
    exact hf2.const_mul _

theorem translated_kernel_square_integral
     (hf : Continuous f)
    (hf2 : Integrable (fun t => ‖f t‖^2)) :
    (∫ p : ℝ × ℝ, K (p.1-p.2) * ‖f p.1‖^2 ∂(volume.prod volume)) =
      (∫ t : ℝ, K t) * ∫ t : ℝ, ‖f t‖^2 := by
  rw [integral_prod _ (translated_kernel_square_integrable hK hKi hK0 hf hf2)]
  simp_rw [integral_mul_const, integral_sub_left_eq_self]
  exact integral_const_mul _ _

theorem schur_quadratic_bound
     (hKe : ∀ t, K (-t) = K t) (hf : Continuous f)
    (hf2 : Integrable (fun t => ‖f t‖^2)) :
    Integrable (fun p : ℝ × ℝ => K (p.1-p.2) * ‖f p.1‖ * ‖f p.2‖)
        (volume.prod volume) ∧
    (∫ p : ℝ × ℝ, K (p.1-p.2) * ‖f p.1‖ * ‖f p.2‖ ∂(volume.prod volume)) ≤
      (∫ t : ℝ, K t) * ∫ t : ℝ, ‖f t‖^2 := by
  have hleft := translated_kernel_square_integrable hK hKi hK0 hf hf2
  have hright : Integrable (fun p : ℝ × ℝ => K (p.1-p.2) * ‖f p.2‖^2)
      (volume.prod volume) := by
    have heq : (fun p : ℝ × ℝ => K (p.1-p.2) * ‖f p.2‖^2) =
        (fun p : ℝ × ℝ => K (p.1-p.2) * ‖f p.1‖^2) ∘ Prod.swap := by
      funext p
      dsimp
      rw [← neg_sub p.1 p.2, hKe]
    rw [heq]
    exact hleft.swap
  have hmaj := (hleft.add hright).div_const 2
  have hpoint (p : ℝ × ℝ) : K (p.1-p.2) * ‖f p.1‖ * ‖f p.2‖ ≤
      (K (p.1-p.2) * ‖f p.1‖^2 + K (p.1-p.2) * ‖f p.2‖^2) / 2 := by
    nlinarith [mul_nonneg (hK0 (p.1-p.2)) (sq_nonneg (‖f p.1‖-‖f p.2‖))]
  have hcross : Integrable (fun p : ℝ × ℝ => K (p.1-p.2) * ‖f p.1‖ * ‖f p.2‖)
      (volume.prod volume) := by
    apply hmaj.mono' (by fun_prop)
    filter_upwards [] with p
    rw [Real.norm_of_nonneg (mul_nonneg (mul_nonneg (hK0 _) (norm_nonneg _)) (norm_nonneg _))]
    exact hpoint p
  refine ⟨hcross, (integral_mono hcross hmaj hpoint).trans_eq ?_⟩
  change (∫ p : ℝ × ℝ, (K (p.1-p.2) * ‖f p.1‖^2 +
      K (p.1-p.2) * ‖f p.2‖^2) / 2 ∂(volume.prod volume)) = _
  rw [integral_div, integral_add hleft hright]
  have hr : (∫ p : ℝ × ℝ, K (p.1-p.2) * ‖f p.2‖^2 ∂(volume.prod volume)) =
      ∫ p : ℝ × ℝ, K (p.1-p.2) * ‖f p.1‖^2 ∂(volume.prod volume) := by
    rw [← MeasureTheory.integral_prod_swap]
    apply integral_congr_ae
    filter_upwards [] with p
    dsimp
    rw [← neg_sub p.1 p.2, hKe]
  rw [hr, translated_kernel_square_integral hK hKi hK0 hf hf2]
  ring

end


end Bounty
end

section

open scoped BigOperators ComplexConjugate
open MeasureTheory

namespace Bounty

theorem complex_finite_norm_sq {ι : Type*} (s : Finset ι) (z : ι → ℂ) :
    ‖∑ i ∈ s, z i‖ ^ 2 = ∑ i ∈ s, ∑ j ∈ s, (z i * conj (z j)).re := by
  have h := congrArg Complex.re (Complex.mul_conj' (∑ i ∈ s, z i))
  simp only [map_sum, Finset.sum_mul, Finset.mul_sum, Complex.re_sum,
    ← Complex.ofReal_pow, Complex.ofReal_re] at h
  exact h.symm.trans (Finset.sum_comm)

theorem interval_finite_gram_energy {ι : Type*} (s : Finset ι)
    (u : ι → ℝ → ℂ) (c : ι → ℂ) (a b : ℝ)
    (hu : ∀ i ∈ s, Continuous (u i)) :
    (∫ t in a..b, ‖∑ i ∈ s, c i * u i t‖ ^ 2) =
      ∑ i ∈ s, ∑ j ∈ s,
        (c i * conj (c j) * (∫ t in a..b, u i t * conj (u j t))).re := by
  simp_rw [complex_finite_norm_sq]
  rw [intervalIntegral.integral_finsetSum]
  · apply Finset.sum_congr rfl
    intro i hi
    rw [intervalIntegral.integral_finsetSum]
    · apply Finset.sum_congr rfl
      intro j hj
      have he : (fun t => (c i * u i t * conj (c j * u j t)).re) =
          (fun t => (c i * conj (c j) * (u i t * conj (u j t))).re) := by
        funext t
        congr 1
        simp only [map_mul]
        ring
      rw [he]
      have hij : IntervalIntegrable
          (fun t => c i * conj (c j) * (u i t * conj (u j t))) volume a b :=
        (continuous_const.mul ((hu i hi).mul (hu j hj).star)).intervalIntegrable a b
      change (∫ t in a..b, RCLike.re (c i * conj (c j) * (u i t * conj (u j t)))) = _
      rw [intervalIntegral.intervalIntegral_re hij, intervalIntegral.integral_const_mul]
      rfl
    · intro j hj
      have hui := hu i hi
      have huj := hu j hj
      apply Continuous.intervalIntegrable
      fun_prop
  · intro i hi
    apply Continuous.intervalIntegrable
    apply continuous_finsetSum
    intro j hj
    have hui := hu i hi
    have huj := hu j hj
    fun_prop

end Bounty
end

section

open scoped BigOperators ComplexConjugate
open MeasureTheory

namespace Bounty

theorem oscillatory_interval_norm_le {a b w : ℝ} (hw : w ≠ 0) :
    ‖∫ t in a..b, Complex.exp ((w * t : ℝ) * Complex.I)‖ ≤ 2 / |w| := by
  have he : (fun t : ℝ => Complex.exp ((w * t : ℝ) * Complex.I)) =
      (fun t : ℝ => Complex.exp (((w : ℂ) * Complex.I) * t)) := by
    funext t
    congr 1
    push_cast
    ring
  rw [he, integral_exp_mul_complex (mul_ne_zero (by exact_mod_cast hw) Complex.I_ne_zero),
    norm_div, norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs]
  apply div_le_div_of_nonneg_right _ (abs_nonneg w)
  calc
    ‖Complex.exp (↑w * Complex.I * ↑b) - Complex.exp (↑w * Complex.I * ↑a)‖ ≤
        ‖Complex.exp (↑w * Complex.I * ↑b)‖ + ‖Complex.exp (↑w * Complex.I * ↑a)‖ :=
      norm_sub_le _ _
    _ = 2 := by
      have h (t : ℝ) : ‖Complex.exp (↑w * Complex.I * ↑t)‖ = 1 := by
        have he : (w : ℂ) * Complex.I * (t : ℂ) = ((w * t : ℝ) : ℂ) * Complex.I := by
          push_cast
          ring
        rw [he]
        exact Complex.norm_exp_ofReal_mul_I (w * t)
      rw [h, h]
      norm_num




theorem logarithmic_gap_lower {x y N : ℝ} (hx : 0 < x) (hxy : x < y)
    (hyN : y ≤ N) : (y - x) / N ≤ Real.log y - Real.log x := by
  have hy : 0 < y := hx.trans hxy
  have h := Real.one_sub_inv_le_log_of_pos (div_pos hy hx)
  rw [Real.log_div hy.ne' hx.ne', inv_div] at h
  calc
    (y - x) / N ≤ (y - x) / y := div_le_div_of_nonneg_left (sub_nonneg.mpr hxy.le) hy hyN
    _ = 1 - x / y := by field_simp
    _ ≤ _ := h

end Bounty
end

section

open scoped BigOperators

namespace Bounty

theorem sum_inverse_lower_distances_le (s : Finset ℕ) (n N : ℕ)
    (hn : n ≤ N) :
    (∑ m ∈ s.filter (· < n), ((n - m : ℕ) : ℝ)⁻¹) ≤ 1 + Real.log N := by
  classical
  have hinj : Set.InjOn (fun m => n - m) (s.filter (· < n)) := by
    intro x hx y hy he
    dsimp only at he
    have hx' := (Finset.mem_filter.mp hx).2
    have hy' := (Finset.mem_filter.mp hy).2
    omega
  have hsub : (s.filter (· < n)).image (fun m => n - m) ⊆ Finset.Icc 1 N := by
    intro k hk
    obtain ⟨m, hm, rfl⟩ := Finset.mem_image.mp hk
    simp only [Finset.mem_filter] at hm
    simp only [Finset.mem_Icc]
    omega
  calc
    _ = ∑ k ∈ (s.filter (· < n)).image (fun m => n - m), (k : ℝ)⁻¹ :=
      (Finset.sum_image hinj).symm
    _ ≤ ∑ k ∈ Finset.Icc 1 N, (k : ℝ)⁻¹ :=
      Finset.sum_le_sum_of_subset_of_nonneg hsub (by intros; positivity)
    _ = (harmonic N : ℝ) := by
      simp only [harmonic_eq_sum_Icc, Rat.cast_sum, Rat.cast_inv, Rat.cast_natCast]
    _ ≤ _ := harmonic_le_one_add_log N

theorem sum_inverse_upper_distances_le (s : Finset ℕ) (n N : ℕ)
    (hs : ∀ m ∈ s, m ≤ N) :
    (∑ m ∈ s.filter (n < ·), ((m - n : ℕ) : ℝ)⁻¹) ≤ 1 + Real.log N := by
  classical
  have hinj : Set.InjOn (fun m => m - n) (s.filter (n < ·)) := by
    intro x hx y hy he
    dsimp only at he
    have hx' := (Finset.mem_filter.mp hx).2
    have hy' := (Finset.mem_filter.mp hy).2
    omega
  have hsub : (s.filter (n < ·)).image (fun m => m - n) ⊆ Finset.Icc 1 N := by
    intro k hk
    obtain ⟨m, hm, rfl⟩ := Finset.mem_image.mp hk
    have hm' := Finset.mem_filter.mp hm
    have hN := hs m hm'.1
    simp only [Finset.mem_Icc]
    omega
  calc
    _ = ∑ k ∈ (s.filter (n < ·)).image (fun m => m - n), (k : ℝ)⁻¹ :=
      (Finset.sum_image hinj).symm
    _ ≤ ∑ k ∈ Finset.Icc 1 N, (k : ℝ)⁻¹ :=
      Finset.sum_le_sum_of_subset_of_nonneg hsub (by intros; positivity)
    _ = (harmonic N : ℝ) := by
      simp only [harmonic_eq_sum_Icc, Rat.cast_sum, Rat.cast_inv, Rat.cast_natCast]
    _ ≤ _ := harmonic_le_one_add_log N

theorem sum_inverse_abs_distances_le (s : Finset ℕ) (n N : ℕ)
    (hn : n ≤ N) (hs : ∀ m ∈ s, m ≤ N) :
    (∑ m ∈ s, if m = n then 0 else |(n : ℝ) - m|⁻¹) ≤ 2 * (1 + Real.log N) := by
  have he : (∑ m ∈ s, if m = n then 0 else |(n : ℝ) - m|⁻¹) =
      (∑ m ∈ s.filter (· < n), ((n - m : ℕ) : ℝ)⁻¹) +
      (∑ m ∈ s.filter (n < ·), ((m - n : ℕ) : ℝ)⁻¹) := by
    rw [Finset.sum_filter, Finset.sum_filter, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro m _
    rcases lt_trichotomy m n with h | rfl | h
    · have hc : (m : ℝ) ≤ n := by exact_mod_cast h.le
      simp [h, h.ne, not_lt.mpr h.le, Nat.cast_sub h.le, abs_of_nonneg (sub_nonneg.mpr hc)]
    · simp
    · have hc : (n : ℝ) ≤ m := by exact_mod_cast h.le
      simp [h, h.ne', not_lt.mpr h.le, Nat.cast_sub h.le, abs_of_nonpos (sub_nonpos.mpr hc), neg_sub]
  rw [he]
  linarith [sum_inverse_lower_distances_le s n N hn, sum_inverse_upper_distances_le s n N hs]

end Bounty
end

