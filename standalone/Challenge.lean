  have hzero : finiteSquarefreeRow (fun i => Ideal.span {p i}) hg S c ^ 6 = 0 := by
    rw [← FirstPassCubeLabels.row_pow, finiteSquarefreeRow_sixth_power, if_pos ⟨i,hi,hc⟩]
  exact pow_ne_zero 6 h hzero

