def globalBirthFiniteIndex (n i : ℕ) : Fin (n + 1) :=
  ⟨min i n, lt_of_le_of_lt (min_le_right _ _) (Nat.lt_succ_self _)⟩

theorem global_birth_finite_index_at {n : ℕ} (j : Fin (n + 1)) :
    globalBirthFiniteIndex n j.val = j := by
  apply Fin.ext
  exact min_eq_left (Nat.le_of_lt_succ j.isLt)

theorem global_birth_finite_index_tail (n i : ℕ) (hi : n ≤ i) :
    globalBirthFiniteIndex n i = Fin.last n := by
  apply Fin.ext
  exact min_eq_right hi

def globalBirthFiniteActivity {P : Type*} {n : ℕ}
    (a : Fin (n + 1) → P → Bool) (i : ℕ) : P → Bool :=
  a (globalBirthFiniteIndex n i)

theorem global_birth_finite_activity_at {P : Type*} {n : ℕ}
    (a : Fin (n + 1) → P → Bool) (j : Fin (n + 1)) :
    globalBirthFiniteActivity a j.val = a j := by
  rw [globalBirthFiniteActivity, global_birth_finite_index_at]

theorem global_birth_finite_activity_tail {P : Type*} {n : ℕ}
    (a : Fin (n + 1) → P → Bool) (i : ℕ) (hi : n ≤ i) :
    globalBirthFiniteActivity a i = a (Fin.last n) := by
  rw [globalBirthFiniteActivity, global_birth_finite_index_tail n i hi]

section Steps
variable {P : Type*} [Fintype P] [DecidableEq P]
  {R : P → Type*} [∀ p, AddGroup (R p)] {n : ℕ}
  (a : Fin (n + 1) → P → Bool)
  (visit : ∀ j, GlobalBirthRawStep (R := R) (a j) (a j))
  (edge : ∀ j : Fin n, GlobalBirthRawStep (R := R) (a j.castSucc) (a j.succ))

def globalBirthFiniteVisit (i : ℕ) :
    GlobalBirthRawStep (R := R) (globalBirthFiniteActivity a i)
      (globalBirthFiniteActivity a i) :=
  visit (globalBirthFiniteIndex n i)

def globalBirthFiniteEdge (i : ℕ) :
    GlobalBirthRawStep (R := R) (globalBirthFiniteActivity a i)
      (globalBirthFiniteActivity a (i + 1)) := by
  by_cases hi : i < n
  · exact globalBirthReindexStep
      (global_birth_finite_activity_at a (Fin.castSucc ⟨i, hi⟩)).symm
      (global_birth_finite_activity_at a (Fin.succ ⟨i, hi⟩)).symm (edge ⟨i, hi⟩)
  · exact globalBirthReindexStep
      (global_birth_finite_activity_tail a i (by omega)).symm
      (global_birth_finite_activity_tail a (i + 1) (by omega)).symm
      (visit (Fin.last n))

noncomputable def globalBirthFiniteAlternatingStep (i : ℕ) :
    GlobalBirthRawStep (R := R) (globalBirthFiniteActivity a (i / 2))
      (globalBirthFiniteActivity a ((i + 1) / 2)) :=
  globalBirthAlternatingStep (globalBirthFiniteActivity a)
    (globalBirthFiniteVisit a visit) (globalBirthFiniteEdge a visit edge) i

variable [∀ p, DecidableEq (R p)]

theorem global_birth_finite_visit_row (j : Fin (n + 1))
    (G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p)) :
    globalBirthRawStepRow (globalBirthFiniteVisit a visit j.val) G H q =
      globalBirthRawStepRow (visit j) G H q := by
  unfold globalBirthFiniteVisit
  exact congrArg (fun k => globalBirthRawStepRow (visit k) G H q)
    (global_birth_finite_index_at j)

theorem global_birth_finite_edge_row (j : Fin n)
    (G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p)) :
    globalBirthRawStepRow (globalBirthFiniteEdge a visit edge j.val) G H q =
      globalBirthRawStepRow (edge j) G H q := by
  simp only [globalBirthFiniteEdge, dif_pos j.isLt, global_birth_reindex_step_row]

theorem global_birth_finite_alternating_row_even (j : Fin (n + 1))
    (G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p)) :
    globalBirthRawStepRow (globalBirthFiniteAlternatingStep a visit edge (2 * j.val)) G H q =
      globalBirthRawStepRow (visit j) G H q := by
  rw [globalBirthFiniteAlternatingStep, global_birth_alternating_step_row_even,
    global_birth_finite_visit_row]

theorem global_birth_finite_alternating_row_odd (j : Fin n)
    (G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p)) :
    globalBirthRawStepRow (globalBirthFiniteAlternatingStep a visit edge (2 * j.val + 1)) G H q =
      globalBirthRawStepRow (edge j) G H q := by
  rw [globalBirthFiniteAlternatingStep, global_birth_alternating_step_row_odd,
    global_birth_finite_edge_row]

variable [∀ p, Fintype (R p)]

theorem global_birth_finite_visit_kernel (j : Fin (n + 1))
    (z w : (p : P) → GhostPhaseState (R p)) :
    globalBirthRawStepKernel (globalBirthFiniteVisit a visit j.val) z w =
      globalBirthRawStepKernel (visit j) z w := by
  unfold globalBirthFiniteVisit
  exact congrArg (fun k => globalBirthRawStepKernel (visit k) z w)
    (global_birth_finite_index_at j)

theorem global_birth_finite_edge_kernel (j : Fin n)
    (z w : (p : P) → GhostPhaseState (R p)) :
    globalBirthRawStepKernel (globalBirthFiniteEdge a visit edge j.val) z w =
      globalBirthRawStepKernel (edge j) z w := by
  simp only [globalBirthFiniteEdge, dif_pos j.isLt, global_birth_reindex_step_kernel]

theorem global_birth_finite_alternating_kernel_even (j : Fin (n + 1))
    (z w : (p : P) → GhostPhaseState (R p)) :
    globalBirthRawStepKernel (globalBirthFiniteAlternatingStep a visit edge (2 * j.val)) z w =
      globalBirthRawStepKernel (visit j) z w := by
  rw [globalBirthFiniteAlternatingStep, global_birth_alternating_step_kernel_even,
    global_birth_finite_visit_kernel]

theorem global_birth_finite_alternating_kernel_odd (j : Fin n)
    (z w : (p : P) → GhostPhaseState (R p)) :
