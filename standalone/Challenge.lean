def reflectionInactiveStratumWeight (I F Q Q0:Ideal (_root_.OAI.ActualEisensteinCubic.O)) (A:Finset (pool I Q Q0)) : ℂ :=
  letI explicitWitness9 := @OAI.CompletedGauss.FreeReflection.poolField
  letI explicitWitness10 := @OAI.CompletedGauss.FreeReflection.poolFintype
  letI explicitWitness8 := @OAI.CompletedGauss.FreeReflection.poolMaximal
  ∏P∈(Finset.univ:Finset (pool I Q Q0))\A,
      zeroFourierCoefficient (actualSextic P.val (pool_good I Q Q0 P))
        (completedLocalExponent I F P.val)

lemma reflectionInactiveStratumWeight_norm_le_one (I F Q Q0:Ideal (_root_.OAI.ActualEisensteinCubic.O))
    (A:Finset (pool I Q Q0)) : ‖reflectionInactiveStratumWeight I F Q Q0 A‖≤1 :=
  letI explicitWitness9 := @OAI.CompletedGauss.FreeReflection.poolField
  letI explicitWitness10 := @OAI.CompletedGauss.FreeReflection.poolFintype
  letI explicitWitness8 := @OAI.CompletedGauss.FreeReflection.poolMaximal
  by
    rw [reflectionInactiveStratumWeight,norm_prod]
    apply Finset.prod_le_one₀ (fun _ _=>norm_nonneg _)
    intro P _
    by_cases hj:completedLocalExponent I F P.val=0
    · rw [hj]
      exact zeroFourierCoefficient_zero_norm_le_one _
    · have he:=canonical_zeroFourierCoefficient P.val (pool_good I Q Q0 P)
        (pool_odd I Q Q0 P) (completedLocalExponent I F P.val)
        (Nat.mod_lt _ (by decide : 0<6))
      have hz:zeroFourierCoefficient (actualSextic P.val (pool_good I Q Q0 P))
          (completedLocalExponent I F P.val)=0 := by
        simpa only [actualSextic,if_neg hj] using he
      rw [hz]
      simp

def reflectionSixInactiveWeight (I F Q Q0:Ideal (_root_.OAI.ActualEisensteinCubic.O)) (e:pool I Q Q0→Fin 6) : ℂ :=
  if reflectionSixValid e then reflectionInactiveStratumWeight I F Q Q0 (reflectionSixSupport e) else 0

lemma reflectionSixInactiveWeight_norm_le_one (I F Q Q0:Ideal (_root_.OAI.ActualEisensteinCubic.O))
    (e:pool I Q Q0→Fin 6) : ‖reflectionSixInactiveWeight I F Q Q0 e‖≤1 := by
  unfold reflectionSixInactiveWeight
  split_ifs
  · exact reflectionInactiveStratumWeight_norm_le_one I F Q Q0 _
  · simp

lemma sum_reflectionSixInactiveWeight_unpad (I F Q Q0:Ideal (_root_.OAI.ActualEisensteinCubic.O))
    (G:(pool I Q Q0→Fin 6)→ℂ) :
    (∑e:pool I Q Q0→Fin 6,reflectionSixInactiveWeight I F Q Q0 e*G e)=
      ∑A:Finset (pool I Q Q0),∑e:A→Fin 3,
        reflectionInactiveStratumWeight I F Q Q0 A*G (encodeReflectionSix ⟨A,e⟩) := by
  rw [sum_active_exceptional_eq_six]
  apply Finset.sum_congr rfl
  intro e _
  by_cases he:reflectionSixValid e
  · rw [if_pos he,encode_decodeReflectionSix e he]
    simp only [reflectionSixInactiveWeight,if_pos he,decodeReflectionSix]
  · simp only [if_neg he,reflectionSixInactiveWeight,zero_mul]

abbrev SixReflectionIndex (rays:ℕ) (I Q Q0:Ideal (_root_.OAI.ActualEisensteinCubic.O)) :=
  Fin rays×(pool I Q Q0→Fin 6)

