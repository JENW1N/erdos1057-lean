theorem unrestricted_fixed_target_phase_coefficients {P : Type*}
    [Fintype P] [DecidableEq P] {R : P → Type*}
    [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    {N t : ℕ} (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (source target : Fin t ↪ P)
    (hsource : ∀ j, asrc (source j) = true)
    (hdepart : ∀ j, atgt (source j) = false)
    (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
    (old : (j : Fin N) → R (f.val j))
    (hold : ∀ j, w (f.val j) = some (some (some (old j))))
    (eligible : Finset (Fin N)) (e : distinctPromotedTargetSlots f.val target ↪ eligible)
    (hmatch : ∀ s : distinctPromotedTargetSlots f.val target, f.val (e s).val = target s.val)
    (hc : ∀ p, ghostPhaseMovingEdgeCompatible (atgt p) (asrc p) (delta p) (w p) = true)
    (β : P → ℝ) (ρ V : ℝ) (B : ℕ)
    (phase : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ eligible) → UnrestrictedFreshLabels P promotions → ℂ)
    (F : (Fin t → P) → FiniteOrderedTuple (Σ p, R p) → ℂ) :
    unrestrictedEdgeAction source (fun j => (⟨f.val j, old j⟩ : Σ p, R p)) Sigma.fst
      (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) (fun z => z.2 = 0)
      (fun p => β p / V) ρ V eligible B
      (fun stores promotions g fresh =>
        if FixedTargetEdgeEventValid f.val target ⟨promotions, g, fresh⟩
          then phase stores promotions g fresh else 0) F =
      ∑ stores : Finset (Fin t),
        ((∏ p, (if atgt p && !(asrc p) then V⁻¹ else 1) *
          ghostPhaseDampedMovingEdge (atgt p) (asrc p) (delta p) (β p) ρ ρ
            (ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p)
              (distinctUnrestrictedStorageChoice source stores p) (w p)) (w p) : ℝ) : ℂ) *
        phase stores (distinctPromotedTargetSlots f.val target) e
          (distinctCanonicalFresh f.val target) *
        (if (unrestrictedEdgeOutput source (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
            (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) stores
            (distinctPromotedTargetSlots f.val target) e).1 ≤ B then
          F target (unrestrictedEdgeOutput source (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
            (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) stores
            (distinctPromotedTargetSlots f.val target) e) else 0) := by
  rw [unrestricted_edge_action_fixed_target source
    (fun j => (⟨f.val j, old j⟩ : Σ p, R p)) Sigma.fst
    (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) (fun z => z.2 = 0)
    (fun p => β p / V) ρ V eligible B f.val (fun _ => rfl) target e hmatch phase F]
  apply sum_congr rfl
  intro stores _
  rw [distinct_unrestricted_phase_event_mass atgt asrc delta w hw source target stores
    hsource (fun j _ => hdepart j) htarget f old hold eligible e hmatch hc β ρ V]
end

