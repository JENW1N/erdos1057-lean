/- The finite P cutoff gives exact support for the original retained coefficient. -/

open Finset Filter

namespace Bounty

noncomputable def candidateRetainedCutoffWeight (c L q : ℝ) (S : Finset ℕ) (h : ℕ) : ℝ :=
  if primePoolPart ((candidatePIndices c L).biUnion (candidatePBand (c*L))) h ∈ S then
    markedDivisorWeight (candidatePIndices c L) (candidatePBand (c*L)) q
      (fun j => ∑ p ∈ candidatePBand (c*L) j, 1/(p : ℝ)) (fun _ => 1) (h : ℤ)
  else 0

noncomputable def candidateRetainedCutoffCoefficient (c L q : ℝ) (r jStar : ℕ)
    (S : Finset ℕ) (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (h : ℕ) : ℂ :=
  if primePoolPart ((candidatePIndices c L).biUnion (candidatePBand (c*L))) h ∈ S then
