section

/- Uniform ordinary-prime asymptotics on logarithmic cells. -/

open Filter

namespace Bounty

theorem eventually_ordinary_theta_scaled_power_bound {a K : ℝ}
    (ha : 0 < a) (hK : 0 ≤ K) :
    ∀ᶠ L : ℝ in atTop, ∀ x : ℝ, Real.exp (a*L) ≤ x →
      |Chebyshev.theta x-x| ≤ a^(-K)*L^(-K)*x := by
  filter_upwards [eventually_ordinary_theta_uniform_log_power_bound ha K,
    eventually_gt_atTop (0 : ℝ)] with L hraw hL
  intro x hx
  have hx0 : 0 < x := (Real.exp_pos _).trans_le hx
  have hlog : a*L ≤ Real.log x := by
    have hh := Real.log_le_log (Real.exp_pos _) hx
    rwa [Real.log_exp] at hh
  have hp := Real.rpow_le_rpow_of_nonpos (mul_pos ha hL) hlog (neg_nonpos.mpr hK)
  calc
    _ ≤ x*(Real.log x)^(-K) := hraw x hx
    _ ≤ x*(a*L)^(-K) := mul_le_mul_of_nonneg_left hp hx0.le
    _ = _ := by rw [Real.mul_rpow ha.le hL.le]; ring

theorem exists_ordinary_prime_logarithmic_cell_asymptotic {a S : ℝ}
    (ha : 0 < a) (hS : 0 ≤ S) :
    ∃ C : ℝ, 0 < C ∧ ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, Real.exp (a*L) ≤ Y →
      |((primeBand Y (Real.exp (L^(-S))*Y)).card : ℝ) -
        ((Real.exp (L^(-S))-1)*Y)/Real.log Y| ≤
        (C/L) * (((Real.exp (L^(-S))-1)*Y)/Real.log Y) := by
  let A := a^(-(S+1))
  let C := 4*A+1/a
  have hA : 0 < A := Real.rpow_pos_of_pos ha _
  have hC : 0 < C := by dsimp [C]; positivity
  refine ⟨2*C, by positivity, ?_⟩
  filter_upwards [eventually_ordinary_theta_scaled_power_bound ha
      (show 0 ≤ S+1 by linarith), eventually_ge_atTop (1 : ℝ)] with L hraw hL1
  intro Y hY
  have hL : 0 < L := zero_lt_one.trans_le hL1
  have hY0 : 0 < Y := (Real.exp_pos _).trans_le hY
  have hY1 : 1 < Y := (Real.one_lt_exp_iff.mpr (mul_pos ha hL)).trans_le hY
  have hδ0 : 0 < L^(-S) := Real.rpow_pos_of_pos hL _
  have hδ1 : L^(-S) ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos hL1 (neg_nonpos.mpr hS)
  let B := Real.exp (L^(-S))*Y
  have hYB : Y ≤ B := by
    dsimp [B]
    exact le_mul_of_one_le_left hY0.le (Real.one_le_exp hδ0.le)
  have hB3 : B ≤ 3*Y := by
    dsimp [B]
    apply mul_le_mul_of_nonneg_right _ hY0.le
    exact (Real.exp_le_exp.mpr hδ1).trans (by linarith [Real.exp_one_lt_three])
  have hH : 0 ≤ B-Y := sub_nonneg.mpr hYB
  have hwidth : L^(-S)*Y ≤ B-Y := by
    have hh := Real.add_one_le_exp (L^(-S))
    have hm := mul_le_mul_of_nonneg_right hh hY0.le
    dsimp [B]
    nlinarith
  have hpow : L^(-(S+1)) = L^(-S)/L := by
    rw [show -(S+1) = -S + (-1 : ℝ) by ring, Real.rpow_add hL, Real.rpow_neg_one]
    ring
  have hθY := hraw Y hY
  have hθB := hraw B (hY.trans hYB)
  have hθ : |(Chebyshev.theta B-Chebyshev.theta Y)-(B-Y)| ≤ (C/L)*(B-Y) := by
    have hid : (Chebyshev.theta B-Chebyshev.theta Y)-(B-Y) =
        (Chebyshev.theta B-B)-(Chebyshev.theta Y-Y) := by ring
    rw [hid]
    calc
      _ ≤ |Chebyshev.theta B-B|+|Chebyshev.theta Y-Y| := abs_sub _ _
      _ ≤ A*L^(-(S+1))*B+A*L^(-(S+1))*Y := add_le_add hθB hθY
      _ ≤ A*L^(-(S+1))*(3*Y)+A*L^(-(S+1))*Y := by
        gcongr
      _ = (4*A/L)*(L^(-S)*Y) := by rw [hpow]; ring
      _ ≤ (4*A/L)*(B-Y) := mul_le_mul_of_nonneg_left hwidth (by positivity)
      _ ≤ (C/L)*(B-Y) := by
        apply mul_le_mul_of_nonneg_right _ hH
        apply div_le_div_of_nonneg_right _ hL.le
        dsimp [C]
        linarith [one_div_pos.mpr ha]
  have hlogY : a*L ≤ Real.log Y := by
    have hh := Real.log_le_log (Real.exp_pos _) hY
    rwa [Real.log_exp] at hh
  have hscale : 1 ≤ (C/L)*Real.log Y := by
    calc
      _ = ((1/a)/L)*(a*L) := by field_simp
      _ ≤ (C/L)*(Real.log Y) := by
        apply mul_le_mul _ hlogY (by positivity) (by positivity)
        apply div_le_div_of_nonneg_right _ hL.le
        dsimp [C]
        linarith [one_div_pos.mpr ha]
  have hlogB : Real.log B ≤ (1+C/L)*Real.log Y := by
    have heq : Real.log B = L^(-S)+Real.log Y := by
      dsimp [B]
      rw [Real.log_mul (Real.exp_ne_zero _) hY0.ne', Real.log_exp]
    rw [heq]
    nlinarith
  have hh := ordinary_prime_band_relative_error hY1 hYB
    (show 0 ≤ C/L by positivity) hθ hlogB
  have heq : B-Y = (Real.exp (L^(-S))-1)*Y := by dsimp [B]; ring
  rw [heq] at hh
  convert hh using 1 <;> ring

theorem eventually_ordinary_prime_logarithmic_cell_relative_error {a S ε : ℝ}
    (ha : 0 < a) (hS : 0 ≤ S) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, Real.exp (a*L) ≤ Y →
      |((primeBand Y (Real.exp (L^(-S))*Y)).card : ℝ) -
        ((Real.exp (L^(-S))-1)*Y)/Real.log Y| ≤
        ε * (((Real.exp (L^(-S))-1)*Y)/Real.log Y) := by
  obtain ⟨C, hC, hbound⟩ := exists_ordinary_prime_logarithmic_cell_asymptotic ha hS
  filter_upwards [hbound, eventually_ge_atTop (C/ε),
    eventually_ge_atTop (1 : ℝ)] with L hL hlarge hL1
  intro Y hY
  have hL0 : 0 < L := zero_lt_one.trans_le hL1
  have hY0 : 0 < Y := (Real.exp_pos _).trans_le hY
  have hY1 : 1 < Y := (Real.one_lt_exp_iff.mpr (mul_pos ha hL0)).trans_le hY
  have hδ : 0 ≤ L^(-S) := (Real.rpow_pos_of_pos hL0 _).le
  have hmain : 0 ≤ ((Real.exp (L^(-S))-1)*Y)/Real.log Y := by
    apply div_nonneg _ (Real.log_pos hY1).le
    exact mul_nonneg (sub_nonneg.mpr (Real.one_le_exp hδ)) hY0.le
  have hsmall : C/L ≤ ε := by
    apply (div_le_iff₀ hL0).mpr
    have hh := (div_le_iff₀ hε).mp hlarge
    nlinarith
  exact (hL Y hY).trans (mul_le_mul_of_nonneg_right hsmall hmain)

end Bounty
end

