section

/- Direct comparison of the actual tilted target law with the untilted law. -/

open Finset Real
open scoped Classical
namespace ThirdCleanTransfer
open Bounty


theorem target_mass_density {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (x : RepeatedBigLists P J ell) :
    repeatedBigTargetMass V b C x =
      repeatedBigTargetMass V (fun _ _ => 1) C x * cleanUnsharedDensity b C x := by
  classical
  simp only [repeated_big_target_mass_physical, cleanUnsharedDensity,
    tiltedPhysicalBirthLaw, div_eq_mul_inv, one_mul,
    prod_mul_distrib, inv_one, mul_one]

theorem unshared_density_bounds {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (b : ∀ g, P g → ℝ)
    (hb : ∀ g p, 0 < b g p ∧ b g p ≤ 1)
    (C : G → Finset (Fin J)) (x : RepeatedBigLists P J ell) :
    1 ≤ cleanUnsharedDensity b C x ∧
    cleanUnsharedDensity b C x ≤ cleanActiveDensity b x := by
  have hfactor (g : G) (p : P g) : 1 ≤ 1 / b g p :=
    (le_div_iff₀ (hb g p).1).2 (by simpa using (hb g p).2)
  have hu : 1 ≤ cleanUnsharedDensity b C x :=
    one_le_prod₀ fun g _ => one_le_prod₀ fun s _ => hfactor g (x g s)
  refine ⟨hu, ?_⟩
  have hs : 1 ≤ cleanSharedDensity b C x :=
    one_le_prod₀ fun g _ => one_le_prod₀ fun s _ => hfactor g (x g s)
  rw [clean_active_density_split b C x]
  exact le_mul_of_one_le_left (zero_le_one.trans hu) hs

theorem banned_density {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (a : PhysicalAuxLabels P C) (x y : RepeatedBigLists P J ell) :
    repeatedBigKernel V b C ζ K a x y =
      (cleanUnsharedDensity b C y : ℂ) *
        repeatedBigKernel V (fun _ _ => 1) C ζ K a x y := by
  classical
  unfold repeatedBigKernel
  split_ifs
  · rw [target_mass_density]
    push_cast
    ring
  · simp

theorem scalar_error {d δ : ℝ} (hd : 1 ≤ d) (hδ : d ≤ 1 + δ) (z : ℂ) :
    ‖(d : ℂ)*z-z‖ ≤ δ*‖z‖ := by
  have heq : (d : ℂ)*z-z = ((d-1 : ℝ) : ℂ)*z := by push_cast; ring
  rw [heq, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by linarith)]
  exact mul_le_mul_of_nonneg_right (by linarith) (norm_nonneg _)

theorem banned_density_error {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (hb : ∀ g p, 0 < b g p ∧ b g p ≤ 1) {δ : ℝ}
    (hd : ∀ x : RepeatedBigLists P J ell, cleanActiveDensity b x ≤ 1 + δ)
    (C : G → Finset (Fin J)) (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (a : PhysicalAuxLabels P C) (x y : RepeatedBigLists P J ell) :
    ‖repeatedBigKernel V b C ζ K a x y -
      repeatedBigKernel V (fun _ _ => 1) C ζ K a x y‖ ≤
      δ*‖repeatedBigKernel V (fun _ _ => 1) C ζ K a x y‖ := by
  rw [banned_density]
  have h := unshared_density_bounds b hb C y
  exact scalar_error h.1 (h.2.trans (hd y)) _

noncomputable def bannedAction {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (f : RepeatedBigLists P J ell → ℂ) : RepeatedBigLists P J ell → ℂ :=
  fun x => ∑ y, (∑ a, repeatedBigKernel V b C ζ K a x y) * f y

noncomputable def unbannedAction {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (f : RepeatedBigLists P J ell → ℂ) : RepeatedBigLists P J ell → ℂ :=
  fun x => ∑ y, (∑ a, repeatedBigUnbannedKernel V b C ζ K a x y) * f y

theorem tilt_operator_error {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (hb : ∀ g p, 0 < b g p ∧ b g p ≤ 1) {δ : ℝ} (hδ : 0 ≤ δ)
    (hd : ∀ x : RepeatedBigLists P J ell, cleanActiveDensity b x ≤ 1 + δ)
    (C : G → Finset (Fin J)) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (B : ℝ) (hB : 0 ≤ B) (hK : ∀ x y a, ‖K x y a‖ ≤ B)
    (f : RepeatedBigLists P J ell → ℂ) :
    cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
      (bannedAction V b C ζ K f - bannedAction V (fun _ _ => 1) C ζ K f) ≤
      (δ * B) * cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f := by
  classical
  have h := repeated_big_dominated_schur V C hV hMass ζ K B hB hK
    (fun x y => ∑ a, (repeatedBigKernel V b C ζ K a x y -
      repeatedBigKernel V (fun _ _ => 1) C ζ K a x y)) δ hδ (fun x y => by
      calc
        _ ≤ ∑ a, ‖repeatedBigKernel V b C ζ K a x y -
          repeatedBigKernel V (fun _ _ => 1) C ζ K a x y‖ := norm_sum_le _ _
        _ ≤ ∑ a, δ * ‖repeatedBigKernel V (fun _ _ => 1) C ζ K a x y‖ :=
          sum_le_sum fun a _ => banned_density_error V b hb hd C ζ K a x y
        _ = _ := (mul_sum ..).symm) f
  simpa only [Pi.sub_def, bannedAction, sum_sub_distrib, sub_mul] using h

theorem full_operator_error {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (hb : ∀ g p, 0 < b g p ∧ b g p ≤ 1) {δ : ℝ} (hδ : 0 ≤ δ)
    (hd : ∀ x : RepeatedBigLists P J ell, cleanActiveDensity b x ≤ 1 + δ)
    (C : G → Finset (Fin J)) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (B : ℝ) (hB : 0 ≤ B) (hK : ∀ x y a, ‖K x y a‖ ≤ B)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (f : RepeatedBigLists P J ell → ℂ) :
    cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
      (bannedAction V b C ζ K f - unbannedAction V (fun _ _ => 1) C ζ K f) ≤
      (B * (δ + ∑ g, (C g).card * (2 * (J + ell : ℕ)) / (V g * Pmin))) *
        cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f := by
  classical
  have ht := tilt_operator_error V b hb hδ hd C hV hMass ζ K B hB hK f
  have he := repeated_big_ban_removal_operator_error V C hV hMass ζ K B hB hK hPmin hp f
  simp only [sum_sub_distrib, sub_mul] at he
  change cleanActiveNorm _ (unbannedAction V (fun _ _ => 1) C ζ K f -
    bannedAction V (fun _ _ => 1) C ζ K f) ≤ _ at he
  have htriangle := clean_active_norm_sub_le (repeatedBigActiveMass V (fun _ _ => 1))
    (fun x => repeated_big_untilted_active_mass_nonneg V (fun g => (hV g).le) x)
    (bannedAction V b C ζ K f - bannedAction V (fun _ _ => 1) C ζ K f)
    (unbannedAction V (fun _ _ => 1) C ζ K f - bannedAction V (fun _ _ => 1) C ζ K f)
  have hid : (bannedAction V b C ζ K f - bannedAction V (fun _ _ => 1) C ζ K f) -
      (unbannedAction V (fun _ _ => 1) C ζ K f - bannedAction V (fun _ _ => 1) C ζ K f) =
      bannedAction V b C ζ K f - unbannedAction V (fun _ _ => 1) C ζ K f := by abel
  rw [hid] at htriangle
  exact htriangle.trans ((add_le_add ht he).trans_eq (by ring))

theorem initial_operator_error {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (hb : ∀ g p, 0 < b g p ∧ b g p ≤ 1) {δ : ℝ} (hδ : 0 ≤ δ)
    (hd : ∀ x : RepeatedBigLists P J ell, cleanActiveDensity b x ≤ 1 + δ)
    (C : G → Finset (Fin J)) (F : ∀ g, Finset (P g)) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (B : ℝ) (hB : 0 ≤ B) (hK : ∀ x y a, ‖K x y a‖ ≤ B)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (f : RepeatedBigLists P J ell → ℂ) :
    cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
      (bannedAction V b C ζ (cleanInitialBirthKernel F C K) f -
        unbannedAction V (fun _ _ => 1) C ζ K f) ≤
      (B * (δ + (∑ g, (C g).card * (2 * (J + ell : ℕ)) / (V g * Pmin)) +
        sqrt (repeatedBigInitialForbiddenProbability (ell := ell) V C F Pmin))) *
        cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f := by
  have ht := full_operator_error V b hb hδ hd C hV hMass ζ
    (cleanInitialBirthKernel F C K) B hB
    (clean_initial_birth_kernel_norm_le F C K B hB hK) hPmin hp f
  have he := repeated_big_initial_birth_unbanned_error V C F hV hMass ζ K B hB hK hPmin hp f
  change cleanActiveNorm _ (unbannedAction V (fun _ _ => 1) C ζ K f -
    unbannedAction V (fun _ _ => 1) C ζ (cleanInitialBirthKernel F C K) f) ≤ _ at he
  have htriangle := clean_active_norm_sub_le (repeatedBigActiveMass V (fun _ _ => 1))
    (fun x => repeated_big_untilted_active_mass_nonneg V (fun g => (hV g).le) x)
    (bannedAction V b C ζ (cleanInitialBirthKernel F C K) f -
      unbannedAction V (fun _ _ => 1) C ζ (cleanInitialBirthKernel F C K) f)
    (unbannedAction V (fun _ _ => 1) C ζ K f -
      unbannedAction V (fun _ _ => 1) C ζ (cleanInitialBirthKernel F C K) f)
  have hid : (bannedAction V b C ζ (cleanInitialBirthKernel F C K) f -
      unbannedAction V (fun _ _ => 1) C ζ (cleanInitialBirthKernel F C K) f) -
      (unbannedAction V (fun _ _ => 1) C ζ K f -
      unbannedAction V (fun _ _ => 1) C ζ (cleanInitialBirthKernel F C K) f) =
      bannedAction V b C ζ (cleanInitialBirthKernel F C K) f -
      unbannedAction V (fun _ _ => 1) C ζ K f := by abel
  rw [hid] at htriangle
  exact htriangle.trans ((add_le_add ht he).trans_eq (by ring))

end ThirdCleanTransfer
end

section

/- A signed family estimate under the actual tilted law and initial exclusions. -/

open Finset Real
open scoped Classical
namespace ThirdCleanFamily
open Bounty ThirdCleanTransfer


theorem projected_family_norm {I X : Type*} [Fintype I] [Fintype X]
    (μ ν : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) {C M : ℝ} (hC : 0 ≤ C) (hM : 0 ≤ M)
    (hlower : ∀ x, μ x ≤ ν x) (hupper : ∀ x, ν x ≤ C*μ x)
    (P : (X → ℂ) →ₗ[ℂ] (X → ℂ))
    (hP : ∀ g, cleanActiveNorm μ (P g) ≤ cleanActiveNorm μ g)
    (A B : I → X → ℂ) (ε : I → ℝ) (hε : ∀ i, 0 ≤ ε i) (f : X → ℂ)
    (herr : ∀ i, cleanActiveNorm μ (B i - A i) ≤ ε i * cleanActiveNorm μ f)
    (hmain : cleanActiveNorm μ (P (∑ i, A i)) ≤ M * cleanActiveNorm μ f) :
    cleanActiveNorm ν (P (∑ i, B i)) ≤
      (sqrt C * (M + ∑ i, ε i)) * cleanActiveNorm ν f := by
  have herror : cleanActiveNorm μ (P (∑ i, (B i - A i))) ≤
      (∑ i, ε i) * cleanActiveNorm μ f := by
    apply (hP _).trans
    apply (clean_active_norm_sum_le μ hμ _ _).trans
    simpa only [sum_mul] using sum_le_sum (fun i _ => herr i)
  have heq : P (∑ i, B i) = P (∑ i, A i) + P (∑ i, (B i - A i)) := by
    rw [sum_sub_distrib, map_sub]
    abel
  calc
    _ ≤ sqrt C * cleanActiveNorm μ (P (∑ i, B i)) :=
      ThirdCleanEnergy.norm_le_scaled μ ν hC hupper _
    _ ≤ sqrt C * ((M + ∑ i, ε i) * cleanActiveNorm μ f) := by
      apply mul_le_mul_of_nonneg_left _ (sqrt_nonneg _)
      rw [heq]
      exact (clean_active_norm_add_le μ hμ _ _).trans
        ((add_le_add hmain herror).trans_eq (by ring))
    _ = (sqrt C * (M + ∑ i, ε i)) * cleanActiveNorm μ f := by ring
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (ThirdCleanEnergy.norm_mono μ ν hlower f)
      (mul_nonneg (sqrt_nonneg _) (add_nonneg hM (sum_nonneg fun i _ => hε i)))

theorem literal_family_norm {I G : Type*} [Fintype I] [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (hb : ∀ g p, 0 < b g p ∧ b g p ≤ 1) {δ : ℝ} (hδ : 0 ≤ δ)
    (hd : ∀ x : RepeatedBigLists P J ell,
      1 ≤ cleanActiveDensity b x ∧ cleanActiveDensity b x ≤ 1 + δ)
    (C : I → G → Finset (Fin J)) (F : ∀ g, Finset (P g)) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) (ζ : ℝ)
    (K : ∀ i, RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (B : I → ℝ) (hB : ∀ i, 0 ≤ B i) (hK : ∀ i x y a, ‖K i x y a‖ ≤ B i)
    {Pmin M : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (hM : 0 ≤ M) (f : RepeatedBigLists P J ell → ℂ)
    (hsigned : cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
      (repeatedBigSymmetrizeLinear (∑ i, unbannedAction V (fun _ _ => 1) (C i) ζ (K i) f)) ≤
      M * cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f) :
    cleanActiveNorm (repeatedBigActiveMass V b)
      (repeatedBigSymmetrizeLinear
        (∑ i, bannedAction V b (C i) ζ (cleanInitialBirthKernel F (C i) (K i)) f)) ≤
      (sqrt (1 + δ) * (M + ∑ i, B i *
        (δ + (∑ g, (C i g).card * (2 * (J + ell : ℕ)) / (V g * Pmin)) +
          sqrt (repeatedBigInitialForbiddenProbability (ell := ell) V (C i) F Pmin)))) *
        cleanActiveNorm (repeatedBigActiveMass V b) f := by
  have hμ := repeated_big_untilted_active_mass_nonneg (P := P) (J := J) (ell := ell)
    V (fun g => (hV g).le)
  apply projected_family_norm _ _ hμ (by positivity) hM
    (fun x => by
      rw [repeated_big_active_mass_density V b x]
      exact le_mul_of_one_le_right (hμ x) (hd x).1)
    (fun x => by
      rw [repeated_big_active_mass_density V b x, mul_comm (1 + δ)]
      exact mul_le_mul_of_nonneg_left (hd x).2 (hμ x))
    repeatedBigSymmetrizeLinear
    (fun v => repeated_big_symmetrize_norm_le _ hμ (repeated_big_active_mass_permutation V _) v)
    _ _ _ _ f _ hsigned
  · intro i
    apply mul_nonneg (hB i)
    apply add_nonneg _ (sqrt_nonneg _)
    exact add_nonneg hδ (sum_nonneg fun g _ => div_nonneg (by positivity) (mul_nonneg (hV g).le hPmin.le))
  · intro i
    exact initial_operator_error V b hb hδ (fun x => (hd x).2) (C i) F hV hMass
      ζ (K i) (B i) (hB i) (hK i) hPmin hp f

end ThirdCleanFamily
end

section

/- Return phases and signed coefficients for the direct family estimate. -/

open Finset Real
open scoped Classical
namespace ThirdCleanFamily
open Bounty ThirdCleanTransfer


theorem literal_phase_family_norm {I G : Type*} [Fintype I] [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (hb : ∀ g p, 0 < b g p ∧ b g p ≤ 1) {δ : ℝ} (hδ : 0 ≤ δ)
    (hd : ∀ x : RepeatedBigLists P J ell,
      1 ≤ cleanActiveDensity b x ∧ cleanActiveDensity b x ≤ 1 + δ)
    (C : I → G → Finset (Fin J)) (F : ∀ g, Finset (P g)) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) (ζ Θ : ℝ) (c : I → ℂ) (hc : ∀ i, ‖c i‖ ≤ 1)
    (K : ∀ i, RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (B : I → ℝ) (hB : ∀ i, 0 ≤ B i) (hK : ∀ i x y a, ‖K i x y a‖ ≤ B i)
    {Pmin M : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (hM : 0 ≤ M) (f : RepeatedBigLists P J ell → ℂ)
    (hsigned : cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
      (repeatedBigSymmetrizeLinear (fun x => ∑ y,
        (∑ i, ∑ aux, c i * repeatedBigUnbannedKernel V (fun _ _ => 1) (C i) ζ
          (K i) aux x y * physicalReturnPhase Θ (repeatedBigD (C i) x aux)) * f y)) ≤
      M * cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f) :
    cleanActiveNorm (repeatedBigActiveMass V b)
      (repeatedBigSymmetrizeLinear (fun x => ∑ y,
        (∑ i, ∑ aux, repeatedBigKernel V b (C i) ζ
          (fun x y a => c i * cleanInitialBirthKernel F (C i) (K i) x y a) aux x y *
          physicalReturnPhase Θ (repeatedBigD (C i) x aux)) * f y)) ≤
      (sqrt (1 + δ) * (M + ∑ i, B i *
        (δ + (∑ g, (C i g).card * (2 * (J + ell : ℕ)) / (V g * Pmin)) +
          sqrt (repeatedBigInitialForbiddenProbability (ell := ell) V (C i) F Pmin)))) *
        cleanActiveNorm (repeatedBigActiveMass V b) f := by
  let H := fun i x y a => c i * K i x y a * physicalReturnPhase Θ (repeatedBigD (C i) x a)
  have hu (i : I) (aux : PhysicalAuxLabels P (C i)) (x y : RepeatedBigLists P J ell) :
      repeatedBigUnbannedKernel V (fun _ _ => 1) (C i) ζ (H i) aux x y =
        c i * repeatedBigUnbannedKernel V (fun _ _ => 1) (C i) ζ (K i) aux x y *
          physicalReturnPhase Θ (repeatedBigD (C i) x aux) := by
    unfold repeatedBigUnbannedKernel H
    split_ifs <;> (try simp_all only [↓reduceIte]) <;> ring
  have hb' (i : I) (aux : PhysicalAuxLabels P (C i)) (x y : RepeatedBigLists P J ell) :
      repeatedBigKernel V b (C i) ζ (cleanInitialBirthKernel F (C i) (H i)) aux x y =
        repeatedBigKernel V b (C i) ζ
          (fun x y a => c i * cleanInitialBirthKernel F (C i) (K i) x y a) aux x y *
          physicalReturnPhase Θ (repeatedBigD (C i) x aux) := by
    unfold repeatedBigKernel cleanInitialBirthKernel H
    split_ifs <;> (try simp_all only [↓reduceIte]) <;> ring
  have hU : (∑ i, unbannedAction V (fun _ _ => 1) (C i) ζ (H i) f) =
      fun x => ∑ y, (∑ i, ∑ aux, c i * repeatedBigUnbannedKernel V (fun _ _ => 1)
        (C i) ζ (K i) aux x y * physicalReturnPhase Θ (repeatedBigD (C i) x aux)) * f y := by
    ext x
    simp only [Finset.sum_apply, unbannedAction, hu]
    rw [sum_comm]
    simp only [sum_mul]
  have hB' : (∑ i, bannedAction V b (C i) ζ (cleanInitialBirthKernel F (C i) (H i)) f) =
      fun x => ∑ y, (∑ i, ∑ aux, repeatedBigKernel V b (C i) ζ
        (fun x y a => c i * cleanInitialBirthKernel F (C i) (K i) x y a) aux x y *
        physicalReturnPhase Θ (repeatedBigD (C i) x aux)) * f y := by
    ext x
    simp only [Finset.sum_apply, bannedAction, hb']
    rw [sum_comm]
    simp only [sum_mul]
  have hH (i : I) (x y : RepeatedBigLists P J ell) (a : PhysicalAuxLabels P (C i)) :
      ‖H i x y a‖ ≤ B i := by
    simp only [H, norm_mul, physicalReturnPhase_norm, mul_one]
    exact (mul_le_mul (hc i) (hK i x y a) (norm_nonneg _) zero_le_one).trans_eq (one_mul _)
  have h := literal_family_norm V b hb hδ hd C F hV hMass ζ H B hB hH hPmin hp hM f
    (by rw [hU]; exact hsigned)
  rwa [hB'] at h

end ThirdCleanFamily
end

section

/- Numerical bounds for the direct global-density perturbation. -/

open Finset Real
open scoped Classical
namespace ThirdCleanNumeric
open Bounty


theorem global_loss_le_numeric (s m J ell Q : ℕ) (xi T P v : ℝ)
    (hT : 0 ≤ T) (hP : 0 < P) (hv : 0 < v) :
    2 * ((s : ℝ) * (J + ell : ℕ)) * T / P ≤
      repeatedBigNumericError s (m + J) J ell Q xi T P v := by
  apply le_trans _ (repeated_big_density_le_numeric_error s (m + J) J ell Q xi T P v hT hP hv)
  apply div_le_div_of_nonneg_right _ hP.le
  apply mul_le_mul_of_nonneg_right _ hT
  push_cast
  nlinarith [mul_nonneg (show 0 ≤ (s : ℝ) by positivity) (show 0 ≤ (m : ℝ) by positivity)]

theorem family_error_le_numeric {G : Type*} [Fintype G] [DecidableEq G]
    {J ell m : ℕ} (V : G → ℝ) (probes : G → Finset (Fin J)) (r t : Finset G)
    (hrt : Disjoint r t) (hp : ∀ g, (probes g).card ≤ m) (Q : ℕ) (xi T P v : ℝ)
    (hv : 0 < v) (hV : ∀ g, v ≤ V g) (hT : 0 ≤ T) (hP : 0 < P) :
    (∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      repeatedBigPrimePatternBound probes r t Q xi i *
        (2 * ((Fintype.card G : ℝ) * (J + ell : ℕ)) * T / P +
          ∑ g, (repeatedBigPrimePatternCut probes r t i g).card *
            (2 * (J + ell : ℕ)) / (V g * P))) ≤
      repeatedBigNumericError (Fintype.card G) (m + J) J ell Q xi T P v := by
  let loss := (((2 * Fintype.card G * (ell + (m + J)) : ℕ) : ℝ) * T / P) +
    (Fintype.card G : ℝ) * (((m + J : ℕ) : ℝ) * (2 * (J + ell : ℕ))) / (v * P)
  have hp' : ∀ g, (probes g).card ≤ m + J := fun g => (hp g).trans (Nat.le_add_right m J)
  have hzero : 0 ≤ loss := by dsimp [loss]; positivity
  have hrow (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t) :
      2 * ((Fintype.card G : ℝ) * (J + ell : ℕ)) * T / P +
        (∑ g, (repeatedBigPrimePatternCut probes r t i g).card *
          (2 * (J + ell : ℕ)) / (V g * P)) ≤ loss := by
    apply add_le_add
    · apply div_le_div_of_nonneg_right _ hP.le
      apply mul_le_mul_of_nonneg_right _ hT
      push_cast
      nlinarith [mul_nonneg (show 0 ≤ (Fintype.card G : ℝ) by positivity) (show 0 ≤ (m : ℝ) by positivity)]
    · calc
        _ ≤ ∑ _g : G, ((m + J : ℕ) : ℝ) * (2 * (J + ell : ℕ)) / (v * P) := by
          apply sum_le_sum
          intro g _
          have hc : (repeatedBigPrimePatternCut probes r t i g).card ≤ m + J :=
            repeated_big_prime_pattern_cut_card_le probes r t hp' i g
          apply div_le_div₀ (by positivity)
            (mul_le_mul_of_nonneg_right (Nat.cast_le.mpr hc) (by positivity))
            (mul_pos hv hP)
            (mul_le_mul_of_nonneg_right (hV g) hP.le)
        _ = _ := by simp only [sum_const, card_univ, nsmul_eq_mul]; ring
  have hcard : r.card + t.card ≤ Fintype.card G := by
    rw [← card_union_of_disjoint hrt]
    exact card_le_univ _
  calc
    _ ≤ ∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
        repeatedBigPrimePatternBound probes r t Q xi i * loss :=
      sum_le_sum fun i _ => mul_le_mul_of_nonneg_left (hrow i)
        (repeated_big_prime_pattern_bound_nonneg probes r t Q xi i)
    _ = (∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
        repeatedBigPrimePatternBound probes r t Q xi i) * loss := (sum_mul ..).symm
    _ ≤ (1 + (2 : ℝ) ^ ((m + J) * (r.card + t.card)) * ((Q * Q : ℕ) / xi) ^ 2) * loss :=
      mul_le_mul_of_nonneg_right (repeated_big_prime_pattern_bound_sum_le probes r t hp' Q xi) hzero
    _ ≤ (1 + (2 : ℝ) ^ ((m + J) * Fintype.card G) * ((Q * Q : ℕ) / xi) ^ 2) * loss := by
      apply mul_le_mul_of_nonneg_right _ hzero
      apply add_le_add le_rfl
      apply mul_le_mul_of_nonneg_right _ (sq_nonneg _)
      exact pow_le_pow_right₀ (by norm_num) (Nat.mul_le_mul_left (m + J) hcard)
    _ = _ := rfl

end ThirdCleanNumeric
end

section

/- Global density control after the number of active slots is fixed. -/

open Finset Filter Real
namespace ThirdCleanDensity
open Bounty


theorem global_density_bound {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (b : ∀ g, P g → ℝ)
    {T Pmin : ℝ} (hT : 0 ≤ T) (hPmin : 0 < Pmin)
    (hp : ∀ g (p : P g), Pmin ≤ (p.val:ℝ))
    (hb : ∀ g (p : P g), b g p = 1-T/(p.val:ℝ))
    (hsmall : ((Fintype.card G:ℝ)*(J+ell:ℕ))*T/Pmin ≤ 1/2)
    (l : RepeatedBigLists P J ell) :
    1 ≤ cleanActiveDensity b l ∧
    cleanActiveDensity b l ≤ 1+2*(((Fintype.card G:ℝ)*(J+ell:ℕ))*T/Pmin) := by
  have h := physical_lifespan_tilt_density_bounds
    (I := G × PhysicalSlots J ell) (fun i => i.1) (fun i => l i.1 i.2)
    b hT hPmin (fun i => hp i.1 _) (fun i => hb i.1 _) (by
      simpa only [Fintype.card_prod, Fintype.card_sum, Fintype.card_fin, Nat.cast_mul]
        using hsmall)
  simpa only [cleanActiveDensity, Fintype.prod_prod_type, Fintype.card_prod,
    Fintype.card_sum, Fintype.card_fin, Nat.cast_mul] using h.1

end ThirdCleanDensity
