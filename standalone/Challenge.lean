section

/- The actual physical ghost coefficients satisfy the length-weighted row estimate. -/

open Finset Classical

namespace Bounty

theorem physical_ghost_length_damping {P : Type*} (n : P → ℕ) (q ρ v : ℝ)
    (hq1 : q ≤ 1) (hρ : 0 < ρ) (hv : 0 < v)
    (hD : q / ρ ^ 2 + ((1 - q) / ρ) / v ≤ 1) (z : UnrestrictedResidueParticle n) :
    physicalGhostRetention n q ρ z * v + |physicalGhostTermination n q ρ z| ≤ v := by
  have hd : 0 ≤ (1 - q) / ρ := div_nonneg (sub_nonneg.mpr hq1) hρ.le
  unfold physicalGhostRetention physicalGhostTermination
  split_ifs
  · rw [abs_neg, abs_of_nonneg hd]
    have h := mul_le_mul_of_nonneg_right hD hv.le
    rwa [add_mul, div_mul_cancel₀ _ hv.ne', one_mul] at h
  · simp

theorem physical_bounded_ghost_length_row_le {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (q ρ V v : ℝ)
    (hμ : ∀ p, 0 ≤ μ p) (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (hρ : 0 < ρ) (hv : 0 < v)
    (hD : q / ρ ^ 2 + ((1 - q) / ρ) / v ≤ 1)
    (t B : ℕ) (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B) :
    (∑ e : BoundedGhostEvent t B s,
      |boundedGhostEventWeight (physicalGhostRetention n q ρ) (physicalGhostTermination n q ρ)
        (physicalGhostBirth n q ρ V) (unrestrictedResidueWeight μ) t B s e| *
          v ^ (boundedGhostEventTarget t B s e).2.1.val) ≤
      Real.exp ((|(1 - q) * V / ρ| * ∑ p, μ p) * v) * v ^ s.2.1.val := by
  have hA : ∀ z, 0 ≤ physicalGhostRetention n q ρ z := by
    intro z
    unfold physicalGhostRetention
    split_ifs
    · exact div_nonneg hq0 (sq_nonneg _)
    · exact zero_le_one
  have h := bounded_ghost_length_row_le
    (physicalGhostRetention n q ρ) (physicalGhostTermination n q ρ) (physicalGhostBirth n q ρ V)
    (unrestrictedResidueWeight μ) v hA (fun z => hμ z.1) hv.le
    (physical_ghost_length_damping n q ρ v hq1 hρ hv hD) t B s
  change _ ≤ Real.exp ((∑ z, physicalGhostBirthAtom n μ q ρ V z) * v) * v ^ s.2.1.val at h
  rw [physical_ghost_birth_atom_total] at h
  exact h

theorem coupled_physical_ghost_length_row_le {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (μ : ∀ g, P g → ℝ) (q ρ v : ℝ) (V : G → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (hρ : 0 < ρ) (hv : 0 < v)
    (hD : q / ρ ^ 2 + ((1 - q) / ρ) / v ≤ 1)
    (t : G → ℕ) (B : ℕ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) :
    (∑ e : CoupledGhostEvent t B s,
      |coupledGhostJointEventWeight (fun g => physicalGhostRetention (n g) q ρ)
        (fun g => physicalGhostTermination (n g) q ρ) (fun g => physicalGhostBirth (n g) q ρ (V g))
        (fun g => unrestrictedResidueWeight (μ g)) t B s e| *
          productLengthLyapunov v (coupledGhostJointEventTarget t B s e)) ≤
      (∏ g, Real.exp ((|(1 - q) * V g / ρ| * ∑ p, μ g p) * v)) * productLengthLyapunov v s := by
  have h := finite_product_gated_row_le
    (fun g => boundedGhostEventWeight (physicalGhostRetention (n g) q ρ)
      (physicalGhostTermination (n g) q ρ) (physicalGhostBirth (n g) q ρ (V g))
      (unrestrictedResidueWeight (μ g)) (t g) B (s g))
    (fun g e => v ^ (boundedGhostEventTarget (t g) B (s g) e).2.1.val)
    (fun _ _ => pow_nonneg hv.le _)
    (fun g => Real.exp ((|(1 - q) * V g / ρ| * ∑ p, μ g p) * v) * v ^ (s g).2.1.val)
    (fun g => physical_bounded_ghost_length_row_le (n g) (μ g) q ρ (V g) v
      (hμ g) hq0 hq1 hρ hv hD (t g) B (s g))
    (fun e => productTotalMemory s ≤ B ∧ productTotalMemory (coupledGhostJointEventTarget t B s e) ≤ B)
  simpa only [coupledGhostJointEventWeight, coupledGhostJointEventTarget,
    productLengthLyapunov, prod_mul_distrib] using h

end Bounty
end

section

/- Pinning current birth primes leaves the length potential unchanged at a fixed original skeleton. -/

open Finset

namespace Bounty

theorem productLengthLyapunov_ghost_skeleton {G : Type*} [Fintype G]
    {P Z : G → Type*} (t : G → ℕ) (B : ℕ) (v : ℝ)
    (s : ProductBoundedOrderedState P Z t B) (sk : CoupledGhostSkeleton t B s)
    (births : CoupledGhostSamples t B s sk) :
    productLengthLyapunov v (coupledGhostJointEventTarget t B s
      ((coupledGhostSkeletonEquiv t B s).symm ⟨sk, births⟩)) =
      v ^ (∑ g, boundedGhostSkeletonOutputCount (t g) B (s g) (sk g).1 (sk g).2) := by
  rw [productLengthLyapunov_eq_total, coupled_ghost_skeleton_target_memory]




theorem productLengthLyapunov_edge_skeleton {G : Type*} [Fintype G]
    {P : G → Type*} (n : ∀ g, P g → ℕ) {M : G → ℕ}
    (S : ∀ g, Finset (Fin (M g))) (B : ℕ) (A : SharedActiveLabels P S → Type*)
    (Δ D : ∀ c, A c → G → ℤ) (v : ℝ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (sk : FullActiveEdgeSkeleton n S B A Δ D s) (fresh : FullActiveEdgeSamples n S B A Δ D s sk) :
    productLengthLyapunov v (fullActiveEdgeEventTarget n S B A Δ D s
      ((fullActiveEdgeSkeletonEquiv n S B A Δ D s).symm ⟨sk, fresh⟩)) =
      v ^ (∑ g, unrestrictedSkeletonOutputCount (n g)
        (Δ (productActiveMemorySplit S B s).1 sk.1 g)
        (D (productActiveMemorySplit S B s).1 sk.1 g)
        (S g)ᶜ.card B ((productActiveMemorySplit S B s).2 g) (sk.2 g)) := by
  unfold fullActiveEdgeEventTarget
  rw [productLengthLyapunov_reassemble, productLengthLyapunov_eq_total]
  rcases sk with ⟨a, sk⟩
  exact congrArg (fun m : ℕ => v ^ m)
    (full_active_edge_skeleton_target_memory n S B A Δ D s ⟨a, sk⟩ fresh)




end Bounty
