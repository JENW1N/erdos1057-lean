/- Actual physical ghost bounds for signed birth-observable multipliers on
the genuine mixed measure. The fixed initial gate and both adjacent joint
slot averages remain in the operator. No local operator norm is assumed. -/

open Finset Classical
namespace Bounty

section Energy
variable {S G : Type*} [Fintype S] [Fintype G] [dG : DecidableEq G]
  {Ps : S → Finset ℕ} [∀ p : PhysicalPrime Ps, NeZero p.2.val]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] {J ell : ℕ}
  (Vs : S → ℝ) (hVs : ∀ s, 0 < Vs s) (μ : ∀ g, P g → ℝ)
  (q ρ : ℝ) (V : G → ℝ) (v vmax : ℝ) (M : G → ℕ) (B : ℕ)
  (hμ : ∀ g p, 0 < μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
  (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (hρ : 0 < ρ)
  (hV : ∀ g, 0 ≤ V g) (hVmax : ∀ g, V g ≤ vmax) (hv : 0 < v)
  (hD : q / ρ ^ 2 + ((1 - q) / ρ) / v ≤ 1)
  (hC : ∀ g, q / ρ ^ 2 + ((1 - q) * V g / ρ) / v ≤ 1)

include hVs hμ hmass hq0 hq1 hρ hV hVmax hv hD hC in
theorem physical_small_big_ghost_phase_energy_le_uniform
    (phase : ∀ s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B),
      CoupledGhostEvent M B s.2 → ℂ)
    (hphase : ∀ s e, ‖phase s e‖ ≤ 1)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (hF : ∀ s, ProductMemorySymmetric (fun x => F (s, x))) :
    physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (physicalSmallBigGhostAction (fun g => physicalGhostRetention (n g) q ρ)
        (fun g => physicalGhostTermination (n g) q ρ)
        (fun g => physicalGhostBirth (n g) q ρ (V g))
        (fun g => unrestrictedResidueWeight (μ g)) M B phase F) ≤
      physicalGhostUniformEnergyBound ρ vmax v ^ Fintype.card G *
        physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) F := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  apply physical_small_big_fiber_energy_le Vs hVs _ F _ _
  intro s
