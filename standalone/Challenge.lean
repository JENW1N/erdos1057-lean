section

/- Exact unrestricted-mark formula for each original root contribution. -/

open Finset
open scoped Classical
namespace Bounty

section

variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  [sharedInstance2 : DecidableEq G]
  {P : G → Finset ℕ}
  {J ell : ℕ}
  (V : G → ℝ)
  (C : G → Finset (Fin J))
  (q ζ : ℝ)
  (k : ℤ)
  (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
  (aux : PhysicalAuxLabels P C)
  (positions : Finset ℤ)
  (f g : ℤ → ℂ)
  (Ψ : ℝ → ℂ)
  (Z : ℝ)

include G sharedInstance1 sharedInstance2 P J ell V C q ζ k K aux positions f g Ψ Z

theorem physical_fixed_root_fibers
     :
    physicalFixedRootCorrelation V C q ζ k K aux positions f g Ψ Z =
      (physicalStateMass V J ell : ℂ) *
      ∑ n ∈ positions, ∑ L : PhysicalMarksAt P J ell n,
        if n + k * (physicalD C L.val aux : ℕ) ∈ positions then
          ∑ R : PhysicalMarksAt P J ell (n + k * (physicalD C L.val aux : ℕ)),
            physicalRootPositionTerm V C q ζ k K aux f g Ψ Z L.val R.val n
        else 0 := by
  unfold physicalFixedRootCorrelation
  rw [physical_cutoff_sum]
  congr 1
  apply sum_congr rfl
  intro n _
  apply sum_congr rfl
  intro L _
  rw [← physical_cutoff_sum_at P J ell positions
    (n + k * (physicalD C L.val aux : ℕ))
    (fun R => physicalRootPositionTerm V C q ζ k K aux f g Ψ Z L.val R n)]
  apply sum_congr rfl
  intro y _
  split_ifs with h
  · simp only [physicalRootPositionTerm, h]
  · rfl

theorem physical_fixed_root_all_lists
     :
    physicalFixedRootCorrelation V C q ζ k K aux positions f g Ψ Z =
      (physicalStateMass V J ell : ℂ) *
      ∑ L : PhysicalMarkLists P J ell, ∑ R : PhysicalMarkLists P J ell,
        ∑ n ∈ positions, if n + k * (physicalD C L aux : ℕ) ∈ positions then
          physicalRootPositionTerm V C q ζ k K aux f g Ψ Z L R n else 0 := by
  rw [physical_fixed_root_fibers]
  congr 1
  have hf (n : ℤ) :
      (∑ L : PhysicalMarksAt P J ell n,
        if n + k * (physicalD C L.val aux : ℕ) ∈ positions then
          ∑ R : PhysicalMarksAt P J ell (n + k * (physicalD C L.val aux : ℕ)),
            physicalRootPositionTerm V C q ζ k K aux f g Ψ Z L.val R.val n else 0) =
      ∑ L : PhysicalMarkLists P J ell, ∑ R : PhysicalMarkLists P J ell,
        if n + k * (physicalD C L aux : ℕ) ∈ positions then
          physicalRootPositionTerm V C q ζ k K aux f g Ψ Z L R n else 0 := by
    trans ∑ L : PhysicalMarksAt P J ell n, ∑ R : PhysicalMarkLists P J ell,
      if n + k * (physicalD C L.val aux : ℕ) ∈ positions then
        physicalRootPositionTerm V C q ζ k K aux f g Ψ Z L.val R n else 0
    · apply sum_congr rfl
      intro L _
      split_ifs with ht
      · rw [← physical_marks_sum_all P J ell _
          (fun R => physicalRootPositionTerm V C q ζ k K aux f g Ψ Z L.val R n)]
        intro R hR
        simp only [physicalRootPositionTerm, physicalVertexWeight, if_neg hR, mul_zero,
          Complex.ofReal_zero]
      · simp only [sum_const_zero]
    · apply physical_marks_sum_all P J ell n (fun L =>
        ∑ R : PhysicalMarkLists P J ell,
          if n + k * (physicalD C L aux : ℕ) ∈ positions then
            physicalRootPositionTerm V C q ζ k K aux f g Ψ Z L R n else 0)
      intro L hL
      apply sum_eq_zero
      intro R _
      split_ifs
      · simp only [physicalRootPositionTerm, physicalVertexWeight, if_neg hL, zero_mul,
          Complex.ofReal_zero, mul_zero]
      · rfl
  simp only [hf]
  rw [sum_comm]
  apply sum_congr rfl
  intro L _
  rw [sum_comm]

end


end Bounty
