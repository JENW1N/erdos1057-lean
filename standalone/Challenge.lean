section

/- An inward smooth product window, with exact agreement off the endpoint collars. -/

open Set
open scoped ContDiff

namespace Bounty

noncomputable def typeIIWindowSmooth (δ t : ℝ) : ℝ :=
  Real.smoothTransition ((t - 1) / δ) * Real.smoothTransition ((16 - t) / δ)

noncomputable def typeIISharpWindow (t : ℝ) : ℝ := if 1 < t ∧ t ≤ 16 then 1 else 0

def typeIIWindowCollar (δ : ℝ) : Set ℝ :=
  Icc (1 - δ) (1 + δ) ∪ Icc (16 - δ) (16 + δ)

theorem typeII_window_smooth_bounds (δ t : ℝ) :
    0 ≤ typeIIWindowSmooth δ t ∧ typeIIWindowSmooth δ t ≤ 1 :=
  typeII_transition_product_bounds _ _

theorem typeII_window_smooth_eq_zero {δ t : ℝ} (hδ : 0 < δ) (ht : t ≤ 1 ∨ 16 ≤ t) :
    typeIIWindowSmooth δ t = 0 := by
  rcases ht with ht | ht
  · rw [typeIIWindowSmooth, Real.smoothTransition.zero_of_nonpos
      (show (t - 1) / δ ≤ 0 from div_nonpos_of_nonpos_of_nonneg (by linarith) hδ.le), zero_mul]
  · rw [typeIIWindowSmooth, Real.smoothTransition.zero_of_nonpos
      (show (16 - t) / δ ≤ 0 from div_nonpos_of_nonpos_of_nonneg (by linarith) hδ.le), mul_zero]







theorem typeII_window_smooth_eq_one {δ t : ℝ} (hδ : 0 < δ)
    (ht : t ∈ Icc (1 + δ) (16 - δ)) : typeIIWindowSmooth δ t = 1 := by
  have h1 : 1 ≤ (t - 1) / δ := (le_div_iff₀ hδ).mpr (by linarith [ht.1])
  have h2 : 1 ≤ (16 - t) / δ := (le_div_iff₀ hδ).mpr (by linarith [ht.2])
  rw [typeIIWindowSmooth, Real.smoothTransition.one_of_one_le h1,
    Real.smoothTransition.one_of_one_le h2, mul_one]

theorem typeII_window_smooth_support {δ t : ℝ} (hδ : 0 < δ)
    (ht : typeIIWindowSmooth δ t ≠ 0) : t ∈ Ioo 1 16 := by
  exact ⟨lt_of_not_ge (fun h => ht (typeII_window_smooth_eq_zero hδ (Or.inl h))),
    lt_of_not_ge (fun h => ht (typeII_window_smooth_eq_zero hδ (Or.inr h)))⟩

theorem typeII_window_smooth_eq_sharp_off_collar {δ t : ℝ} (hδ : 0 < δ)
    (ht : t ∉ typeIIWindowCollar δ) : typeIIWindowSmooth δ t = typeIISharpWindow t := by
  by_cases hw : 1 < t ∧ t ≤ 16
  · have hlo : 1 + δ ≤ t := by
      by_contra h
      apply ht
      exact Or.inl ⟨by linarith [hw.1], by linarith⟩
    have hhi : t ≤ 16 - δ := by
      by_contra h
      apply ht
      exact Or.inr ⟨by linarith, by linarith [hw.2]⟩
    rw [typeII_window_smooth_eq_one hδ ⟨hlo, hhi⟩, typeIISharpWindow, if_pos hw]
  · have hout : t ≤ 1 ∨ 16 ≤ t := by
      by_cases h1 : t ≤ 1
      · exact Or.inl h1
      · exact Or.inr (le_of_lt (lt_of_not_ge (fun h => hw ⟨lt_of_not_ge h1, h⟩)))
    rw [typeII_window_smooth_eq_zero hδ hout, typeIISharpWindow, if_neg hw]




theorem typeII_window_ratio_sharp {x : ℝ} (hx : 0 < x) (u : ℕ) :
    typeIISharpWindow ((u : ℝ) / x) = if u ∈ arithmeticProductWindow 1 x then 1 else 0 := by
  have heq : (1 < (u : ℝ) / x ∧ (u : ℝ) / x ≤ 16) ↔ u ∈ arithmeticProductWindow 1 x := by
    rw [mem_arithmeticProductWindow_iff one_ne_zero]
    simp only [one_mul, lt_div_iff₀ hx, div_le_iff₀ hx]
  simp only [typeIISharpWindow, heq]

theorem typeII_window_smooth_ratio_eq_off_boundary {x δ : ℝ} (hx : 0 < x)
    (hδ : 0 < δ) {u : ℕ} (hu : u ∉ typeIIBoundaryWindow x δ) :
    typeIIWindowSmooth δ ((u : ℝ) / x) = if u ∈ arithmeticProductWindow 1 x then 1 else 0 := by
  rw [← typeII_window_ratio_sharp hx u]
  apply typeII_window_smooth_eq_sharp_off_collar hδ
  intro ht
  apply hu
  apply (mem_typeII_boundary_window_iff hx.le hδ.le).mpr
  rcases ht with ht | ht
  · exact Or.inl ⟨(le_div_iff₀ hx).mp ht.1, (div_le_iff₀ hx).mp ht.2⟩
  · exact Or.inr ⟨(le_div_iff₀ hx).mp ht.1, (div_le_iff₀ hx).mp ht.2⟩

end Bounty
end

section

/- Uniform control of the small-prime extraction, including its exceptional set. -/

open Finset

namespace Bounty

theorem physical_omega_le_two_log {G : Type*} (P : G → Finset ℕ) (g : G)
    (hP : ∀ p ∈ P g, p.Prime) {n : ℕ} (hn : 0 < n) :
    (physicalOmega P g (n : ℤ) : ℝ) ≤ 2 * Real.log n := by
  apply le_trans _ (primeFactors_card_le_two_log hn)
  apply Nat.cast_le.mpr
  apply card_le_card
  intro p hp
  obtain ⟨hp, hpn⟩ := mem_filter.mp hp
  exact (hP p hp).mem_primeFactors (Int.natCast_dvd_natCast.mp hpn) hn.ne'

noncomputable def markedPrimePeel {G : Type*} [DecidableEq G]
    (groups : Finset G) (P : G → Finset ℕ) (q : ℝ) (V : G → ℝ)
    (t : G → ℕ) (g : G) (k : ℕ) (f : ℕ → ℂ) (n : ℕ) : ℂ :=
  (1 / (V g : ℂ)) * ∑ p ∈ P g, if p ∣ n then
    (markedDivisorWeight groups P q V (Function.update t g k) ((n / p : ℕ) : ℤ) : ℂ) *
      f (n / p) else 0

theorem marked_prime_peel_exact {G : Type*} [DecidableEq G]
    (groups : Finset G) (P : G → Finset ℕ) (q : ℝ) (V : G → ℝ) (t : G → ℕ)
    (hprime : ∀ g ∈ groups, ∀ p ∈ P g, p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (g : G) (hg : g ∈ groups) (k : ℕ) (ht : t g = k + 1) (n : ℕ)
    (hsq : ∀ p ∈ P g, ¬ p ^ 2 ∣ n) (f : ℕ → ℂ)
    (hf : ∀ p ∈ P g, p ∣ n → f (n / p) = f n) :
    (markedDivisorWeight groups P q V t (n : ℤ) : ℂ) * f n =
      markedPrimePeel groups P q V t g k f n := by
  rw [marked_divisor_weight_remove_prime groups P q V t hprime hdis g hg k ht n hsq]
  unfold markedPrimePeel
  push_cast
  rw [mul_assoc, sum_mul]
  congr 1
  apply sum_congr rfl
  intro p hp
  by_cases hpn : p ∣ n
  · simp only [if_pos hpn, hf p hp hpn]
  · simp only [if_neg hpn, Complex.ofReal_zero, zero_mul]

section

variable
  {G : Type*}
  [sharedInstance1 : DecidableEq G]
  (groups : Finset G)
  (P : G → Finset ℕ)
  {q v : ℝ}
  (hq0 : 0 ≤ q)
  (hq1 : q < 1)
  (hv : 0 < v)
  (V : G → ℝ)
  (t : G → ℕ)
  (T : ℕ)
  (hV : ∀ g ∈ groups, v ≤ V g)
  (ht : ∀ g ∈ groups, t g ≤ T)
  (g : G)
  (hg : g ∈ groups)
  (k : ℕ)
  (hk : k ≤ t g)

include G sharedInstance1 groups P q v hq0 hq1 hv V t T hV ht g hg k hk

theorem marked_prime_peel_norm_le 
    (f : ℕ → ℂ) (n : ℕ) (hf : ∀ p ∈ P g, p ∣ n → f (n / p) = f n) :
    ‖markedPrimePeel groups P q V t g k f n‖ ≤
      ((physicalOmega P g (n : ℤ) : ℝ) / v) *
        (markedDivisorBound q v T) ^ groups.card * ‖f n‖ := by
  classical
  have ht' : ∀ h ∈ groups, Function.update t g k h ≤ T := by
    intro h hh
    by_cases he : h = g
    · subst h
      simpa only [Function.update_self] using hk.trans (ht g hg)
    · simpa only [Function.update_of_ne he] using ht h hh
  have hV0 : ∀ h ∈ groups, 0 ≤ V h := fun h hh => hv.le.trans (hV h hh)
  have hVg : 0 < V g := hv.trans_le (hV g hg)
  have hnorm (p : ℕ) :
      ‖(markedDivisorWeight groups P q V (Function.update t g k) ((n / p : ℕ) : ℤ) : ℂ)‖ ≤
        (markedDivisorBound q v T) ^ groups.card := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg
      (marked_divisor_weight_nonneg groups P hq0 V _ hV0 _)]
    exact marked_divisor_weight_le_pow groups P hq0 hq1 hv V _ T hV ht' _
  have hc : (((P g).filter (fun p => p ∣ n)).card : ℝ) =
      (physicalOmega P g (n : ℤ) : ℝ) := by
    simp only [physicalOmega, physicalDivisorPool, Int.natCast_dvd_natCast]
  unfold markedPrimePeel
  rw [← sum_filter, norm_mul, norm_div, norm_one, Complex.norm_real,
    Real.norm_eq_abs, abs_of_pos hVg]
  calc
    _ ≤ (1 / V g) * ∑ p ∈ (P g).filter (fun p => p ∣ n),
        ‖(markedDivisorWeight groups P q V (Function.update t g k) ((n / p : ℕ) : ℤ) : ℂ) *
          f (n / p)‖ := mul_le_mul_of_nonneg_left (norm_sum_le _ _) (by positivity)
    _ ≤ (1 / V g) * ∑ _p ∈ (P g).filter (fun p => p ∣ n),
        (markedDivisorBound q v T) ^ groups.card * ‖f n‖ := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      apply sum_le_sum
      intro p hp
      rw [norm_mul, hf p (mem_filter.mp hp).1 (mem_filter.mp hp).2]
      exact mul_le_mul_of_nonneg_right (hnorm p) (norm_nonneg _)
    _ = (1 / V g) * ((physicalOmega P g (n : ℤ) : ℝ) *
        ((markedDivisorBound q v T) ^ groups.card * ‖f n‖)) := by
      rw [sum_const, nsmul_eq_mul, hc]
    _ ≤ (1 / v) * ((physicalOmega P g (n : ℤ) : ℝ) *
        ((markedDivisorBound q v T) ^ groups.card * ‖f n‖)) := by
      apply mul_le_mul_of_nonneg_right (one_div_le_one_div_of_le hv (hV g hg))
      exact mul_nonneg (by positivity)
        (mul_nonneg (pow_nonneg (zero_le_one.trans (one_le_markedDivisorBound q v T)) _) (norm_nonneg _))
    _ = _ := by ring

theorem marked_prime_peel_error_norm_le 
    (hP : ∀ p ∈ P g, p.Prime) (f : ℕ → ℂ) (n N : ℕ)
    (hn : 0 < n) (hN : n ≤ N) (hf : ∀ p ∈ P g, p ∣ n → f (n / p) = f n) :
    ‖(markedDivisorWeight groups P q V t (n : ℤ) : ℂ) * f n -
      markedPrimePeel groups P q V t g k f n‖ ≤
      ((markedDivisorBound q v T) ^ groups.card * (1 + 2 * Real.log N / v)) * ‖f n‖ := by
  have hV0 : ∀ h ∈ groups, 0 ≤ V h := fun h hh => hv.le.trans (hV h hh)
  have hw : ‖(markedDivisorWeight groups P q V t (n : ℤ) : ℂ)‖ ≤
      (markedDivisorBound q v T) ^ groups.card := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg
      (marked_divisor_weight_nonneg groups P hq0 V t hV0 _)]
    exact marked_divisor_weight_le_pow groups P hq0 hq1 hv V t T hV ht _
  have homega := physical_omega_le_two_log P g hP hn
  have hlog := Real.log_le_log (Nat.cast_pos.mpr hn) (Nat.cast_le.mpr hN)
  have hsize : (physicalOmega P g (n : ℤ) : ℝ) / v ≤ 2 * Real.log N / v :=
    div_le_div_of_nonneg_right (homega.trans (by linarith)) hv.le
  calc
    _ ≤ ‖(markedDivisorWeight groups P q V t (n : ℤ) : ℂ) * f n‖ +
        ‖markedPrimePeel groups P q V t g k f n‖ := norm_sub_le _ _
    _ ≤ (markedDivisorBound q v T) ^ groups.card * ‖f n‖ +
        (((physicalOmega P g (n : ℤ) : ℝ) / v) *
          (markedDivisorBound q v T) ^ groups.card * ‖f n‖) := by
      apply add_le_add
      · rw [norm_mul]
        exact mul_le_mul_of_nonneg_right hw (norm_nonneg _)
      · exact marked_prime_peel_norm_le groups P hq0 hq1 hv V t T hV ht g hg k hk f n hf
    _ ≤ (markedDivisorBound q v T) ^ groups.card * ‖f n‖ +
        ((2 * Real.log N / v) * (markedDivisorBound q v T) ^ groups.card * ‖f n‖) := by
      apply add_le_add le_rfl
      apply mul_le_mul_of_nonneg_right _ (norm_nonneg _)
      exact mul_le_mul_of_nonneg_right hsize
        (pow_nonneg (zero_le_one.trans (one_le_markedDivisorBound q v T)) _)
    _ = _ := by ring

end


end Bounty
end

section

/- The partial residue/run factorization is valid before any new-mark count is imposed. -/

open Finset
open scoped Classical
namespace Bounty
section Factor
variable {G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Finset ℕ} [∀ a : PhysicalPrime P, NeZero a.2.val] {J ell : ℕ}
  (groups : Finset G) (V : G → ℝ) (L : ℕ → PhysicalMarkLists P J ell) (n : ℕ)
  (h : (a : PhysicalPrime P) → ℕ → ZMod a.2.val) (η : ℕ → ℝ) (b : PhysicalPrime P → ℝ)
  (hb : ∀ a : PhysicalPrime P, a.1 ∈ groups → b a = 1 - (∑ j ∈ range (n + 1), η j) / a.2.val)
  (hb0 : ∀ a : PhysicalPrime P, a.1 ∈ groups → b a ≠ 0)

include hb hb0 in
theorem physical_group_run_residue_factor :
    (∏ a ∈ physicalPrimeGroups P groups, b a) *
      (∏ a ∈ physicalPrimeGroups P groups,
        ghostPhaseRunHistory (fun j => decide (a ∈ physicalMarkedPrimes (L j)))
          (h a) η ((a.2.val : ℝ) * b a)⁻¹ (V a.1) n) =
    (∏ a ∈ physicalPrimeGroups P groups,
      (V a.1)⁻¹ ^ ghostPhaseRunCount (fun j => decide (a ∈ physicalMarkedPrimes (L j))) n) *
    poolPathResidueExpectation (fun a : PhysicalPrime P => a.2.val)
      (physicalPrimeGroups P groups) (range (n + 1))
      (fun a => (range (n + 1)).filter (fun j => a ∈ physicalMarkedPrimes (L j))) h η := by
  unfold poolPathResidueExpectation
  rw [← prod_mul_distrib, ← prod_mul_distrib]
  apply prod_congr rfl
  intro a ha
  have hag : a.1 ∈ groups := by simpa [physicalPrimeGroups] using ha
  simpa only [ZMod.card, decide_eq_true_eq] using
    ghost_phase_run_history_residue_identity
      (fun j => decide (a ∈ physicalMarkedPrimes (L j))) (h a) η (V a.1) n (b a)
      (by simpa only [ZMod.card] using hb a hag) (hb0 a hag)

include hb hb0 in
theorem physical_partial_run_residue_factor :
    (∏ a ∈ physicalPrimeGroups P groups, b a) *
      (poolPathResidueExpectation (fun a : PhysicalPrime P => a.2.val)
        (physicalPrimeGroups P groupsᶜ) (range (n + 1))
        (fun a => (range (n + 1)).filter (fun j => a ∈ physicalMarkedPrimes (L j))) h η *
        ∏ a ∈ physicalPrimeGroups P groups,
          ghostPhaseRunHistory (fun j => decide (a ∈ physicalMarkedPrimes (L j)))
            (h a) η ((a.2.val : ℝ) * b a)⁻¹ (V a.1) n) =
    (∏ a ∈ physicalPrimeGroups P groups,
      (V a.1)⁻¹ ^ ghostPhaseRunCount (fun j => decide (a ∈ physicalMarkedPrimes (L j))) n) *
    poolPathResidueExpectation (fun a : PhysicalPrime P => a.2.val) univ (range (n + 1))
      (fun a => (range (n + 1)).filter (fun j => a ∈ physicalMarkedPrimes (L j))) h η := by
  have hs := physical_prime_groups_split groups (fun a : PhysicalPrime P =>
    (∑ r, activeResidueWeight (range (n + 1))
      ((range (n + 1)).filter (fun j => a ∈ physicalMarkedPrimes (L j))) (h a) η r) / (a.2.val : ℝ))
  change poolPathResidueExpectation _ univ _ _ _ _ =
    poolPathResidueExpectation _ (physicalPrimeGroups P groups) _ _ _ _ *
      poolPathResidueExpectation _ (physicalPrimeGroups P groupsᶜ) _ _ _ _ at hs
  rw [hs]
  have hr := physical_group_run_residue_factor groups V L n h η b hb hb0
  linear_combination
    poolPathResidueExpectation (fun a : PhysicalPrime P => a.2.val)
      (physicalPrimeGroups P groupsᶜ) (range (n + 1))
      (fun a => (range (n + 1)).filter (fun j => a ∈ physicalMarkedPrimes (L j))) h η * hr

include hb hb0 in
theorem physical_partial_run_residue_zero
    (hz : poolPathResidueExpectation (fun a : PhysicalPrime P => a.2.val) univ (range (n + 1))
      (fun a => (range (n + 1)).filter (fun j => a ∈ physicalMarkedPrimes (L j))) h η = 0) :
    poolPathResidueExpectation (fun a : PhysicalPrime P => a.2.val)
      (physicalPrimeGroups P groupsᶜ) (range (n + 1))
      (fun a => (range (n + 1)).filter (fun j => a ∈ physicalMarkedPrimes (L j))) h η *
      (∏ a ∈ physicalPrimeGroups P groups,
        ghostPhaseRunHistory (fun j => decide (a ∈ physicalMarkedPrimes (L j)))
          (h a) η ((a.2.val : ℝ) * b a)⁻¹ (V a.1) n) = 0 := by
  have he := physical_partial_run_residue_factor groups V L n h η b hb hb0
  rw [hz, mul_zero] at he
  exact (mul_eq_zero.mp he).resolve_left (prod_ne_zero_iff.mpr (fun a ha =>
    hb0 a (by simpa [physicalPrimeGroups] using ha)))

end Factor
end Bounty
end

section

/- Common full-slot birth data are the exact original event data extended by none. -/

open Classical
namespace Bounty
section Event
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ)
  (tag : Option (J ⊕ K))
  (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
  (e : FullPermutationMixedEvent n S B A Δ D tag s)

noncomputable def fullMixedCommonEventBornData : FullMixedCommonLocalAddress M B tag → Option (FullMixedBornData n) :=
  optionalBirthExtension (fullMixedCommonLocalEmbedding S B tag) (fullMixedEventBornData n S B A Δ D tag s e)

noncomputable def fullMixedCommonEventBirthLabel (a : FullMixedCommonLocalAddress M B tag) :
    Option ((g : Fin N) × P g) :=
  (fullMixedCommonEventBornData n S B A Δ D tag s e a).map (fullMixedBornPrime n)

noncomputable def fullMixedCommonEventBirthPerformed (a : FullMixedCommonLocalAddress M B tag) : Prop :=
  (fullMixedCommonEventBornData n S B A Δ D tag s e a).isSome = true

theorem full_mixed_common_event_data_embed (a : FullMixedLocalBirthAddress S B tag) :
    fullMixedCommonEventBornData n S B A Δ D tag s e (fullMixedCommonLocalEmbedding S B tag a) =
      fullMixedEventBornData n S B A Δ D tag s e a :=
  optional_birth_extension_apply _ _ _

theorem full_mixed_common_event_label_embed (a : FullMixedLocalBirthAddress S B tag) :
    fullMixedCommonEventBirthLabel n S B A Δ D tag s e (fullMixedCommonLocalEmbedding S B tag a) =
      fullMixedEventBirthLabel n S B A Δ D tag s e a := by
  unfold fullMixedCommonEventBirthLabel fullMixedEventBirthLabel
  rw [full_mixed_common_event_data_embed]




theorem full_mixed_common_event_performed_iff (a : FullMixedCommonLocalAddress M B tag) :
    fullMixedCommonEventBirthPerformed n S B A Δ D tag s e a ↔
      ∃ b, fullMixedCommonLocalEmbedding S B tag b = a ∧ fullMixedEventBirthPerformed n S B A Δ D tag s e b :=
  optional_birth_extension_performed_iff _ _ _

theorem full_mixed_common_event_label_extension (a : FullMixedCommonLocalAddress M B tag) :
    fullMixedCommonEventBirthLabel n S B A Δ D tag s e a =
      optionalBirthExtension (fullMixedCommonLocalEmbedding S B tag)
        (fullMixedEventBirthLabel n S B A Δ D tag s e) a :=
  optional_birth_extension_map _ _ _ _

theorem full_mixed_common_event_label_present (a : FullMixedCommonLocalAddress M B tag) :
    fullMixedCommonEventBirthPerformed n S B A Δ D tag s e a ↔
      (fullMixedCommonEventBirthLabel n S B A Δ D tag s e a).isSome = true := by
  simp only [fullMixedCommonEventBirthPerformed, fullMixedCommonEventBirthLabel, Option.isSome_map]

end Event
end Bounty
