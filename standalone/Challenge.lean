lemma fixedThetaTwist_mul (φ χ:(_root_.OAI.ActualEisensteinCubic.O)→*ℂ) (n:(_root_.OAI.ActualEisensteinCubic.O)) :
    fixedThetaTwist (φ*χ) n=fixedThetaTwist φ n*χ n := by
  by_cases hn:lambda^2∣n-1
  · rw [fixedThetaTwist_primary _ n hn,fixedThetaTwist_primary _ n hn,MonoidHom.mul_apply]
    ring
  · rw [fixedThetaTwist_not_primary _ n hn,fixedThetaTwist_not_primary _ n hn,zero_mul]

def fixedThetaRowCoeff (c:(_root_.OAI.ActualEisensteinCubic.O)) (hc:c≠0) [Fintype ((_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {c})]
    (φ:(_root_.OAI.ActualEisensteinCubic.O)→*ℂ) (h:(_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {c}) : ℂ :=
  finiteAdditiveFourierCoeff (quotientTrace c hc) (fixedThetaQuotient φ c) h

lemma fixedThetaRowCoeff_norm (c:(_root_.OAI.ActualEisensteinCubic.O)) (hc:c≠0) [Fintype ((_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {c})]
    (φ:(_root_.OAI.ActualEisensteinCubic.O)→*ℂ) (hφ:∀n,‖φ n‖≤1) (h:(_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {c}) :
    ‖fixedThetaRowCoeff c hc φ h‖≤1 :=
  finiteAdditiveFourierCoeff_norm _ _ (fixedThetaQuotient_norm_le_one φ hφ c) h

theorem fixedThetaTwist_fixed_fourier (c:(_root_.OAI.ActualEisensteinCubic.O)) (hc:c≠0) [Fintype ((_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {c})]
    (Q:Ideal (_root_.OAI.ActualEisensteinCubic.O)) (hcQ:Ideal.span {c}≤Ideal.span {(9:(_root_.OAI.ActualEisensteinCubic.O))}*Q)
    (φ χ:(_root_.OAI.ActualEisensteinCubic.O)→*ℂ) (hφ:CanonicalCoefficientClass.FactorsModulo Q φ) (n:(_root_.OAI.ActualEisensteinCubic.O)) :
    fixedThetaTwist (φ*χ) n=
      ∑h:(_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {c},fixedThetaRowCoeff c hc φ h*fixedRowFourierPhase c hc h n*χ n := by
  rw [←Finset.sum_mul,fixedThetaTwist_mul]
  congr 1
  have h:=finiteAdditiveFourier_inversion (quotientTrace c hc)
    (GeneralPrimitiveTrace.eisTraceModChar_breveE_primitive c hc) (fixedThetaQuotient φ c)
    (Ideal.Quotient.mk _ n)
  rw [fixedThetaQuotient_mk φ Q hφ c hcQ n] at h
  exact h.symm







