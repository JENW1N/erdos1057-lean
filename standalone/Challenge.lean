    if ht : t.1 ∣ d then DirichletCharacter.changeLevel ht t.2 else 1) h
  simpa only [dif_pos χ.conductor_dvd_level, dif_pos ψ.conductor_dvd_level,
    DirichletCharacter.changeLevel_primitiveCharacter] using hh

noncomputable def typeIPrimitiveConductorNormSum {Ω : Type*} (d : ℕ)
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) : ℝ := by
  classical
  exact ∑ f ∈ d.divisors.filter (fun f => 1 < f),
    ∑ ψ ∈ (univ : Finset (DirichletCharacter ℂ f)).filter
      (fun ψ => ψ.IsPrimitive ∧ ψ ≠ 1),
      ‖∑ t ∈ T.filter (fun t => (value t).Coprime (d / f)),
        μ t * ψ (value t : ZMod f)‖

theorem character_conductor_norm_sum_le {Ω : Type*} (d : ℕ) [NeZero d]
    (C : Finset (DirichletCharacter ℂ d)) (hC : ∀ χ ∈ C, χ ≠ 1)
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) :
    (∑ χ ∈ C, ‖typeICharacterSum T μ value χ‖) ≤
      typeIPrimitiveConductorNormSum d T μ value := by
  classical
  let pair := fun χ : DirichletCharacter ℂ d =>
    (⟨χ.conductor, χ.primitiveCharacter⟩ : (f : ℕ) × DirichletCharacter ℂ f)
  let D : Finset ((f : ℕ) × DirichletCharacter ℂ f) :=
    (d.divisors.filter (fun f => 1 < f)).sigma (fun f =>
      (univ : Finset (DirichletCharacter ℂ f)).filter (fun ψ => ψ.IsPrimitive ∧ ψ ≠ 1))
  let w : ((f : ℕ) × DirichletCharacter ℂ f) → ℝ := fun x =>
    ‖∑ t ∈ T.filter (fun t => (value t).Coprime (d / x.1)),
      μ t * x.2 (value t : ZMod x.1)‖
  have hinj : Set.InjOn pair C := (character_conductor_pair_injective d).injOn
  have hsub : C.image pair ⊆ D := by
    intro x hx
    obtain ⟨χ, hχ, rfl⟩ := mem_image.mp hx
    apply mem_sigma.mpr
    constructor
    · exact mem_filter.mpr ⟨Nat.mem_divisors.mpr ⟨χ.conductor_dvd_level, NeZero.ne d⟩,
        nonprincipal_conductor_one_lt χ (hC χ hχ)⟩
    · exact mem_filter.mpr ⟨mem_univ _, χ.primitiveCharacter_isPrimitive,
        nonprincipal_primitiveCharacter_ne_one χ (hC χ hχ)⟩
  calc
    _ = ∑ x ∈ C.image pair, w x := by
      rw [sum_image hinj]
      apply sum_congr rfl
      intro χ _
      change ‖∑ t ∈ T, μ t * χ (value t : ZMod d)‖ = _
      rw [character_weighted_sum_eq_primitive_filtered]
    _ ≤ ∑ x ∈ D, w x :=
      sum_le_sum_of_subset_of_nonneg hsub (fun x _ _ => norm_nonneg _)
    _ = typeIPrimitiveConductorNormSum d T μ value := by
      rw [show D = (d.divisors.filter (fun f => 1 < f)).sigma (fun f =>
        (univ : Finset (DirichletCharacter ℂ f)).filter (fun ψ => ψ.IsPrimitive ∧ ψ ≠ 1)) from rfl,
        sum_sigma]
      rfl

theorem typeI_nonprincipal_norm_sum_le_conductors {Ω : Type*} (d : ℕ) [NeZero d]
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) :
    typeINonprincipalNormSum d T μ value ≤ typeIPrimitiveConductorNormSum d T μ value := by
  classical
  unfold typeINonprincipalNormSum
  apply character_conductor_norm_sum_le
  intro χ hχ
  simpa only [mem_erase, mem_univ, and_true] using hχ



end

