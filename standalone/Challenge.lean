theorem physical_small_big_path_positive_edge_eq
    {H K S G : Type} [Fintype S] [Fintype G] [dG : DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Type} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] {J ell : ℕ} {M : G → ℕ}
    (shared : K → ∀ g, Finset (Fin (M g))) (B : ℕ) (A : K → Type) [∀ k, Fintype (A k)]
    (Δ D : ∀ k, PhysicalSharedLists Ps J → SharedActiveLabels P (shared k) → A k → G → ℤ)
    (kbig : ∀ k, SharedActiveLabels P (shared k) → A k → ℤ)
    (ω : ∀ k, A k → ℝ) (μ : ∀ g, P g → ℝ)
    (qghost : H → ℝ) (ρ : ℝ) (Vedge Vghost : G → ℝ) (Vs : S → ℝ) (qsmall : ℝ)
    (hVs : ∀ s, 0 < Vs s) (hω : ∀ k a, 0 ≤ ω k a)
    (hμ : ∀ g p, 0 ≤ μ g p) (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ Vedge g)
    (k : K)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ) :
    physicalSmallBigPathPositiveAction n shared B A Δ D kbig ω μ qghost ρ
      Vedge Vghost Vs qsmall (some (.inr k)) F =
      fun s => ∑ a : A k, (ω k a : ℂ) *
        physicalSmallBigFullPhasedAction n (shared k) B
          (fun d c => Δ k d c a) (fun d c => D k d c a) μ ρ Vedge
          (fun c => kbig k c a) Vs qsmall (fun _ _ => 1) F s := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  funext s
  unfold physicalSmallBigPathPositiveAction finiteLocalEventAction
  dsimp only [physicalSmallBigPathEventFintype, PhysicalSmallBigPathEvent]
  rw [Fintype.sum_prod_type]
  simp only [Fintype.sum_sigma]
  rw [sum_comm]
  simp only [physicalSmallBigFullPhasedAction, physicalSmallBigPhasedAction,
    Fintype.sum_prod_type, Fintype.sum_sigma, Fintype.sum_unique, mul_sum]
  apply sum_congr rfl
  intro a _
  apply sum_congr rfl
  intro L _
  apply sum_congr rfl
  intro e _
  have hw := physical_small_big_path_edge_weight_nonneg n shared B A Δ D kbig ω μ qghost ρ
    Vedge Vs qsmall hVs hω hμ hρ hV k s (L, ⟨a, e⟩)
  simp only [physicalSmallBigPathPositiveWeight, abs_of_nonneg hw]
  unfold physicalSmallBigPathEventWeight physicalSmallBigPathEventTarget
    physicalSmallBigPositiveWeight physicalSmallBigFullWeight physicalSmallBigTarget
    physicalSmallBigFullTarget fullActiveEdgeEventWeight fullActiveEdgeEventTarget
  dsimp only
  split_ifs <;> push_cast <;> ring

