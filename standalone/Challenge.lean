theorem eventually_ambient_rough_dyadic_coefficient_properties {γ : ℝ} (hγ : 0 < γ) :
    ∀ᶠ L : ℝ in atTop, ∀ (S a v : ℝ) (H i j n : ℕ),
      |typeIIRestrict (dyadicNatBucket (Icc 1 H) i) (ambientRoughIntervalTypeIIAlpha γ L S a v) n| ≤ 1 ∧
      |typeIIRestrict (dyadicNatBucket (Icc 1 H) j)
        (ambientRoughTypeIIBeta (Real.exp (a*L)) (Real.exp (v*L))) n| ≤ 1 ∧
      (typeIIRestrict (dyadicNatBucket (Icc 1 H) i) (ambientRoughIntervalTypeIIAlpha γ L S a v) n ≠ 0 →
        ∀ p ∈ n.primeFactors, Real.exp (Real.sqrt L) < (p : ℝ)) := by
  filter_upwards [eventually_rough_typeII_restriction_properties hγ] with L hprop
  intro S a v H i j n
  have ha (m : ℕ) := hprop S (ambientRoughCofactorRange L a v) m
  refine ⟨typeIIRestrict_abs_le zero_le_one (fun m _ => (ha m).1) n,
    typeIIRestrict_abs_le zero_le_one
      (fun m _ => (ambient_rough_typeII_beta_properties (Real.exp (a*L)) (Real.exp (v*L)) m).1) n, ?_⟩
  intro hn
  exact ((ha n).2 ((typeIIRestrict_ne_zero_iff _ _ _).mp hn).2).2

theorem eventually_ambient_prime_dyadic_coefficient_properties (S : ℝ) (hS : 0 ≤ S) :
    ∀ᶠ L : ℝ in atTop, ∀ κ : ℝ, 0 ≤ κ → κ ≤ 1/50 → ∀ (proxy : Bool) (H i j n : ℕ),
      |typeIIRestrict (dyadicNatBucket (Icc 1 H) i) (ambientPrimeTypeIIAlpha κ L S) n| ≤ 1 ∧
      |typeIIRestrict (dyadicNatBucket (Icc 1 H) j)
        (if proxy then ambientProxyTypeIIBeta κ L S else ambientPrimeTypeIIBeta κ L) n| ≤ 1 ∧
      (typeIIRestrict (dyadicNatBucket (Icc 1 H) i) (ambientPrimeTypeIIAlpha κ L S) n ≠ 0 →
        ∀ p ∈ n.primeFactors, Real.exp (Real.sqrt L) < (p : ℝ)) := by
  filter_upwards [eventually_balanced_typeII_coefficient_properties S hS] with L hprop
  intro κ hκ hκmax proxy H i j n
  have ha := hprop κ hκ hκmax
  refine ⟨typeIIRestrict_abs_le zero_le_one (fun m _ => (ha m).1) n, ?_, ?_⟩
  · apply typeIIRestrict_abs_le zero_le_one
    intro m hm
    cases proxy with
    | false => exact (ha m).2.1
    | true => exact (ha m).2.2.1
  · intro hn
    exact ((ha n).2.2.2 ((typeIIRestrict_ne_zero_iff _ _ _).mp hn).2).2

