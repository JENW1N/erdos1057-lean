  (cut : ℕ → Fin N → Finset (Fin J)) (ζ : Fin n → ℝ)
  (K : ∀ j, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C j) → ℂ)

theorem physical_record_coefficient_local_phase
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (p : FiniteEventPath (fun i => PhysicalFullLedgerEvent C k (physicalSelectedFineTag n i))
      (fun i => physicalFullLedgerEventTarget C k (physicalSelectedFineTag n i))
      (List.range (4 * n + 1)) s) :
    physicalRecordCoefficient C cut ζ K
      (finiteEventPathObservations (fun i => PhysicalFullLedgerEvent C k (physicalSelectedFineTag n i))
        (fun i => physicalFullLedgerEventTarget C k (physicalSelectedFineTag n i))
        (physicalFullTraceObservation C k (physicalSelectedFineTag n) cut)
        (List.range (4 * n + 1)) s p) =
      finiteEventLocalPhase (fun i => PhysicalFullLedgerEvent C k (physicalSelectedFineTag n i))
        (fun i => physicalFullLedgerEventTarget C k (physicalSelectedFineTag n i))
        (fun i => physicalLocalCoefficientPhase C k cut ζ K (physicalSelectedFineTag n i))
        (List.range (4 * n + 1)) s p := by
  let E := fun i => PhysicalFullLedgerEvent (P := P) (ell := ell) (B := B) C k (physicalSelectedFineTag n i)
  let target := fun i => physicalFullLedgerEventTarget (P := P) (ell := ell) (B := B) C k (physicalSelectedFineTag n i)
  let observe := physicalFullTraceObservation (P := P) (ell := ell) (B := B) C k (physicalSelectedFineTag n) cut
  let r := finiteEventPathObservations E target observe (List.range (4 * n + 1)) s p
  let occ := finiteScheduleOccurrence E target (4 * n + 1) s p
  rw [finite_schedule_local_phase_product, four_step_sparse_product _ _
    (fun i hi => physical_local_coefficient_nonedge C k cut ζ K i.val hi _ _)]
  unfold physicalRecordCoefficient
  apply prod_congr rfl
  intro j _
  have hlen : r.length = 4 * n + 1 := by
    simp only [r, finite_event_path_observations_length, List.length_range]
  have h1 : 4 * j.val + 1 < r.length := by omega
  have h2 : 4 * j.val + 2 < r.length := by omega
  change (match r[4 * j.val + 1]?, r[4 * j.val + 2]? with
    | some a, some b => physicalObservedCoefficient C cut ζ K j b.2.1
        (fun g => (a.2.2.2 g).1) (fun g => (b.2.2.2 g).1)
    | _, _ => 0) = _
  rw [List.getElem?_eq_getElem h1, List.getElem?_eq_getElem h2]
  change physicalObservedCoefficient C cut ζ K j (r.get ⟨_, h2⟩).2.1
    (fun g => ((r.get ⟨_, h1⟩).2.2.2 g).1)
    (fun g => ((r.get ⟨_, h2⟩).2.2.2 g).1) = _
  rw [finite_schedule_observations_get E target observe _ s p ⟨_, by omega⟩,
    finite_schedule_observations_get E target observe _ s p ⟨_, by omega⟩]
  change physicalObservedCoefficient C cut ζ K j
    (physicalFullEventObservation C k (cut (4 * j.val + 2)) (cut (4 * j.val + 2 + 1))
      (physicalSelectedFineTag n (4 * j.val + 2)) (occ ⟨4 * j.val + 2, by omega⟩).1
      (occ ⟨4 * j.val + 2, by omega⟩).2)
    (fun g => ((target (4 * j.val + 1) (occ ⟨4 * j.val + 1, by omega⟩).1
      (occ ⟨4 * j.val + 1, by omega⟩).2).2 g).1)
    (fun g => ((target (4 * j.val + 2) (occ ⟨4 * j.val + 2, by omega⟩).1
      (occ ⟨4 * j.val + 2, by omega⟩).2).2 g).1) = _
  have hs := finite_schedule_source_after E target (4 * n + 1) s p
    (4 * j.val + 1) (by omega)
  change (occ ⟨4 * j.val + 2, by omega⟩).1 =
    target (4 * j.val + 1) (occ ⟨4 * j.val + 1, by omega⟩).1
      (occ ⟨4 * j.val + 1, by omega⟩).2 at hs
  rw [← hs]
  exact (physical_local_coefficient_edge_observation C k cut ζ K j _ _ _
    (physical_fine_tag_edge j) _ _).symm

end Locality
end Bounty
