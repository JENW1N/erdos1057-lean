theorem finite_coordinate_lift_preserves_own {I : Type*} [DecidableEq I]
    {X : I → Type*} (i : I) (R : X i → X i → Prop)
    (A : (X i → ℂ) → X i → ℂ)
    (hA : ∀ q, FiniteLocalInvariant R q → FiniteLocalInvariant R (A q))
    (f : (∀ j, X j) → ℂ) (hf : FiniteCoordinateInvariant i R f) :
    FiniteCoordinateInvariant i R (finiteCoordinateLift i A f) := by
  intro x y hxy
  simp only [finite_coordinate_lift_eq_update, Function.update_self, Function.update_idem]
  exact hA _ (finite_coordinate_invariant_slice i R f hf x) (x i) y hxy

theorem finite_coordinate_lift_preserves_all {I : Type*} [DecidableEq I]
    {X : I → Type*} (R : ∀ i, X i → X i → Prop) (j : I)
    (A : (X j → ℂ) → X j → ℂ)
    (hA : ∀ q, FiniteLocalInvariant (R j) q → FiniteLocalInvariant (R j) (A q))
    (f : (∀ i, X i) → ℂ) (hf : ∀ i, FiniteCoordinateInvariant i (R i) f) :
    ∀ i, FiniteCoordinateInvariant i (R i) (finiteCoordinateLift j A f) := by
  intro i
  by_cases hij : i = j
  · subst i
    exact finite_coordinate_lift_preserves_own j (R j) A hA f (hf j)
  · exact finite_coordinate_lift_preserves_other i j hij (R i) A f (hf i)

theorem finite_coordinate_compose_preserves_all {I : Type*} [DecidableEq I]
    {X : I → Type*} (R : ∀ i, X i → X i → Prop)
    (A : ∀ i, (X i → ℂ) → X i → ℂ)
    (hA : ∀ i q, FiniteLocalInvariant (R i) q → FiniteLocalInvariant (R i) (A i q))
    (is : List I) (f : (∀ i, X i) → ℂ) (hf : ∀ i, FiniteCoordinateInvariant i (R i) f) :
    ∀ i, FiniteCoordinateInvariant i (R i) (finiteCoordinateCompose A is f) := by
  induction is with
  | nil => exact hf
  | cons j js ih =>
    exact finite_coordinate_lift_preserves_all R j (A j) (hA j)
      (finiteCoordinateCompose A js f) ih

