  let : Countable periodLattice := instCountableSubtypeComplexMemSubmoduleIntPeriodLattice
  let : VAddInvariantMeasure periodLattice ℂ volume :=
    instVAddInvariantMeasureSubtypeComplexMemSubmoduleIntPeriodLatticeVolume
  have hp (p : periodLattice) (z : ℂ) : f (p+ᵥz)=f z ∧ g (p+ᵥz)=g z := by
    obtain ⟨n,rfl⟩ := periodEquiv.surjective p
    change f (3*eisEmbedding n+z)=f z ∧ g (3*eisEmbedding n+z)=g z
