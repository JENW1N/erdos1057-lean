section

/- The strict Buchstab recursion, with its repeated-least-prime error retained explicitly. -/

open Finset

namespace Bounty

noncomputable def strictBuchstabComposites (A B z : ℝ) : Finset ℕ := by
  classical
  exact (roughBand A B z).filter (fun n => ¬ n.Prime ∧ ¬ n.minFac ∣ n / n.minFac)

noncomputable def strictBuchstabRemainder (A B z : ℝ) : Finset ℕ := by
  classical
  exact (roughBand A B z).filter (fun n => ¬ n.Prime ∧ n.minFac ∣ n / n.minFac)

theorem strict_buchstab_fiber_image {A B z : ℝ} (hA : 1 ≤ A) (hB : 0 ≤ B)
    {p : ℕ} (hp : p.Prime) (hpz : z < (p : ℝ)) :
    (strictBuchstabComposites A B z).filter (fun n => n.minFac = p) =
      (roughBand (max 1 (A / (p : ℝ))) (B / (p : ℝ)) (p : ℝ)).image (fun m => p * m) := by
  classical
  have hpR : (0 : ℝ) < p := Nat.cast_pos.mpr hp.pos
  have hA0 : 0 ≤ A := by linarith
  have hmax : 0 ≤ max 1 (A / (p : ℝ)) := le_trans (by norm_num) (le_max_left _ _)
  have hBp : 0 ≤ B / (p : ℝ) := div_nonneg hB hpR.le
  ext n
  constructor
  · intro hn
    obtain ⟨hnC, hnp⟩ := mem_filter.mp hn
    obtain ⟨hnR, hnprime, hndiv⟩ := mem_filter.mp hnC
    have hn0 := roughBand_pos hnR
    have hpdiv : p ∣ n := hnp ▸ Nat.minFac_dvd n
    have hmul : p * (n / p) = n := Nat.mul_div_cancel' hpdiv
    have hmlo : 2 ≤ n / p := hp.two_le.trans (by simpa only [hnp] using Nat.minFac_le_div hn0 hnprime)
    have hnA : A < (n : ℝ) := Nat.lt_of_floor_lt (mem_Ioc.mp (mem_filter.mp hnR).1).1
    have hnB : (n : ℝ) ≤ B :=
      (Nat.cast_le.mpr (mem_Ioc.mp (mem_filter.mp hnR).1).2).trans (Nat.floor_le hB)
    have hmulR : (p : ℝ) * (n / p : ℕ) = n := by exact_mod_cast hmul
    apply mem_image.mpr
    refine ⟨n / p, mem_filter.mpr ⟨mem_Ioc.mpr ⟨?_, ?_⟩, ?_⟩, hmul⟩
    · apply (Nat.floor_lt hmax).mpr
      apply max_lt_iff.mpr
      constructor
      · exact_mod_cast hmlo
      · apply (div_lt_iff₀ hpR).mpr
        nlinarith
    · apply Nat.le_floor
      apply (le_div_iff₀ hpR).mpr
      nlinarith
    · intro q hq
      have hpq : p ≤ q := by
        simpa only [hnp] using buchstab_cofactor_prime_factors n q (by simpa only [hnp] using hq)
      have hpne : p ≠ q := by
        intro he
        apply hndiv
        simpa only [hnp, he] using Nat.dvd_of_mem_primeFactors hq
      exact_mod_cast lt_of_le_of_ne hpq hpne
  · intro hn
    obtain ⟨m, hm, rfl⟩ := mem_image.mp hn
    have hm0 := roughBand_pos hm
    have hmlo : max 1 (A / (p : ℝ)) < (m : ℝ) :=
      Nat.lt_of_floor_lt (mem_Ioc.mp (mem_filter.mp hm).1).1
    have hm1 : m ≠ 1 := by
      have hh := (le_max_left 1 (A / (p : ℝ))).trans_lt hmlo
      intro he
      simp only [he, Nat.cast_one, lt_self_iff_false] at hh
    have hmB : (m : ℝ) ≤ B / (p : ℝ) :=
      (Nat.cast_le.mpr (mem_Ioc.mp (mem_filter.mp hm).1).2).trans (Nat.floor_le hBp)
    have hrough := (mem_filter.mp hm).2
    have hmin : (p * m).minFac = p := buchstab_minFac_mul hp hm0.ne'
      (fun q hq => by exact_mod_cast (hrough q hq).le)
    have hpndiv : ¬ p ∣ m := by
      intro hdiv
      have hh := hrough p (hp.mem_primeFactors hdiv hm0.ne')
      exact lt_irrefl _ hh
    have hquot : p * m / p = m := Nat.mul_div_cancel_left m hp.pos
    apply mem_filter.mpr
    refine ⟨mem_filter.mpr ⟨?_, Nat.not_prime_mul hp.ne_one hm1, ?_⟩, hmin⟩
    · apply mem_filter.mpr
      refine ⟨mem_Ioc.mpr ⟨?_, ?_⟩, ?_⟩
      · apply (Nat.floor_lt hA0).mpr
        have hh := (div_lt_iff₀ hpR).mp ((le_max_right 1 (A / (p : ℝ))).trans_lt hmlo)
        simpa only [Nat.cast_mul, mul_comm] using hh
      · apply Nat.le_floor
        have hh := (le_div_iff₀ hpR).mp hmB
        simpa only [Nat.cast_mul, mul_comm] using hh
      · intro q hq
        rw [Nat.primeFactors_mul hp.ne_zero hm0.ne', hp.primeFactors] at hq
        rcases mem_union.mp hq with hqp | hqm
        · simpa only [mem_singleton.mp hqp] using hpz
        · exact hpz.trans (hrough q hqm)
    · simpa only [hmin, hquot] using hpndiv

theorem strict_buchstab_composites_count {A B z : ℝ}
    (hA : 1 ≤ A) (hB : 0 ≤ B) (hz : 0 ≤ z) :
    (strictBuchstabComposites A B z).card =
      ∑ p ∈ primeBand z (Real.sqrt B),
        (roughBand (max 1 (A / (p : ℝ))) (B / (p : ℝ)) (p : ℝ)).card := by
  classical
  have hmap : ∀ n ∈ strictBuchstabComposites A B z,
      n.minFac ∈ primeBand z (Real.sqrt B) := by
    intro n hn
    obtain ⟨hnR, hnprime, _⟩ := mem_filter.mp hn
    have hn0 := roughBand_pos hnR
    have hnA : A < (n : ℝ) := Nat.lt_of_floor_lt (mem_Ioc.mp (mem_filter.mp hnR).1).1
    have hn1 : n ≠ 1 := by
      intro he
      simp only [he, Nat.cast_one] at hnA
      linarith
    have hp := Nat.minFac_prime hn1
    have hnB : (n : ℝ) ≤ B :=
      (Nat.cast_le.mpr (mem_Ioc.mp (mem_filter.mp hnR).1).2).trans (Nat.floor_le hB)
    apply (mem_primeBand_iff hz (Real.sqrt_nonneg _) _).mpr
    refine ⟨hp, (mem_filter.mp hnR).2 n.minFac
      (Nat.mem_primeFactors.mpr ⟨hp, Nat.minFac_dvd n, hn0.ne'⟩), ?_⟩
    apply Real.le_sqrt_of_sq_le
    have hsq : (n.minFac : ℝ) ^ 2 ≤ n := by exact_mod_cast Nat.minFac_sq_le_self hn0 hnprime
    exact hsq.trans hnB
  rw [card_eq_sum_card_fiberwise hmap]
  apply sum_congr rfl
  intro p hp
  obtain ⟨hpp, hpz, _⟩ := (mem_primeBand_iff hz (Real.sqrt_nonneg _) p).mp hp
  rw [strict_buchstab_fiber_image hA hB hpp hpz]
  exact card_image_of_injective _ (fun a b hab => Nat.eq_of_mul_eq_mul_left hpp.pos hab)

theorem strict_buchstab_count_with_remainder {A B z : ℝ}
    (hA : 1 ≤ A) (hB : 0 ≤ B) (hz : 0 ≤ z) :
    (roughBand A B z).card = (primeBand (max A z) B).card +
      (∑ p ∈ primeBand z (Real.sqrt B),
        (roughBand (max 1 (A / (p : ℝ))) (B / (p : ℝ)) (p : ℝ)).card) +
      (strictBuchstabRemainder A B z).card := by
  classical
  have hprime := card_filter_add_card_filter_not (s := roughBand A B z) Nat.Prime
  have hcomp := card_filter_add_card_filter_not
    (s := (roughBand A B z).filter (fun n => ¬ n.Prime))
    (fun n => ¬ n.minFac ∣ n / n.minFac)
  have hgood : ((roughBand A B z).filter (fun n => ¬ n.Prime)).filter
      (fun n => ¬ n.minFac ∣ n / n.minFac) = strictBuchstabComposites A B z := by
    simp only [filter_filter, strictBuchstabComposites]
  have hbad : ((roughBand A B z).filter (fun n => ¬ n.Prime)).filter
      (fun n => ¬ ¬ n.minFac ∣ n / n.minFac) = strictBuchstabRemainder A B z := by
    simp only [not_not, filter_filter, strictBuchstabRemainder]
  rw [hgood, hbad, strict_buchstab_composites_count hA hB hz] at hcomp
  rw [prime_part_of_rough_band (by linarith : 0 ≤ A) hB] at hprime
  omega

theorem strict_buchstab_remainder_subset_nonsquarefree {A B z : ℝ} (hA : 1 ≤ A) :
    strictBuchstabRemainder A B z ⊆ (roughBand A B z).filter (fun n => ¬ Squarefree n) := by
  classical
  intro n hn
  obtain ⟨hnR, _, hdiv⟩ := mem_filter.mp hn
  have hnA : A < (n : ℝ) := Nat.lt_of_floor_lt (mem_Ioc.mp (mem_filter.mp hnR).1).1
  have hn1 : n ≠ 1 := by
    intro he
    simp only [he, Nat.cast_one] at hnA
    linarith
  refine mem_filter.mpr ⟨hnR, ?_⟩
  intro hsq
  exact (Nat.squarefree_iff_prime_squarefree.mp hsq) n.minFac (Nat.minFac_prime hn1)
    (Nat.mul_dvd_of_dvd_div (Nat.minFac_dvd n) hdiv)







end Bounty


end

