variable
  {I S G : Type*}
  [sharedInstance1 : Fintype I]
  [sharedInstance2 : Fintype S]
  [sharedInstance3 : Fintype G]
  [dG : DecidableEq G]
  {Ps : S → Finset ℕ}
  {P : G → Finset ℕ}
  {J ell B : ℕ}
  [sharedInstance8 : ∀ g (p : P g), NeZero p.val]
  (V : G → ℝ)
  (b : ∀ g, P g → ℝ)
  (C : I → G → Finset (Fin J))
  (ζ θ ρ : ℝ)
  (k : ℤ)
  (D : ∀ i, SharedActiveLabels (fun g => ↥(P g)) (cleanFullSharedSlots (ell := ell) (C i)) →
      PhysicalAuxLabels P (C i) → G → ℤ)
  (K : ∀ i, RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
  (d : PhysicalSharedLists Ps J)
  (f : CleanFullMemoryState P J ell B → PhysicalResidues Ps → ℂ)
  (hf : ∀ r, ProductMemorySymmetric (fun x => f x r))

include I S G sharedInstance1 sharedInstance2 sharedInstance3 dG Ps P J ell B sharedInstance8 V b C ζ θ ρ k D K d f hf

theorem clean_full_memory_pattern_event_action  :
    cleanFullMemoryPatternEventAction V b C ζ θ ρ k D K d f =
      cleanFullMemoryCutoff (cleanFullMemoryPatternDampedAction V b C ζ θ ρ k K d f) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  apply clean_full_memory_slice_ext
  intro N p
  funext source r
  change (∑ i, cleanFullMemoryEventAction V b (C i) ζ θ ρ k (D i) (K i) d f
      (cleanFullMemoryState N p source r.2) r.1) = _
  change _ = if productTotalMemory (cleanFullMemoryState N p source r.2) ≤ B then
    cleanFullMemoryPatternDampedAction V b C ζ θ ρ k K d f
      (cleanFullMemoryState N p source r.2) r.1 else 0
  rw [cleanFullMemoryState_total_memory, clean_full_memory_pattern_damped_apply]
  by_cases h : (∑ g, (N g).val) ≤ B
  · rw [if_pos h]
    apply sum_congr rfl
    intro i _
    have hi := clean_full_memory_event_action_apply V b (C i) ζ θ ρ k (D i) (K i)
      d f hf N p source r.2 r.1
    simp only [if_pos h] at hi
    convert hi using 1
    · congr 1
    · apply sum_congr
      · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
      · intro aux _
        apply sum_congr
        · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
        · intro target _
          rfl
  · rw [if_neg h]
    apply sum_eq_zero
    intro i _
    have hi := clean_full_memory_event_action_apply V b (C i) ζ θ ρ k (D i) (K i)
      d f hf N p source r.2 r.1
    simp only [if_neg h] at hi
    convert hi using 1
    congr 1

/- Both adjacent averages and both total-memory cutoffs agree with the
kernel operator occurring in the existing full-memory norm bound. -/
theorem clean_full_memory_projected_event_action  :
    cleanFullMemoryActiveMap (cleanFullMemoryPatternEventAction V b C ζ θ ρ k D K d
      (cleanFullMemoryActiveMap f)) =
      cleanFullMemoryCutoff (cleanFullMemoryActiveMap (cleanFullMemoryPatternDampedAction
        V b C ζ θ ρ k K d (cleanFullMemoryActiveMap (cleanFullMemoryCutoff f)))) := by
  have hsym : ∀ r, ProductMemorySymmetric (fun x => cleanFullMemoryActiveMap f x r) :=
    fun r => fullActiveAverage_symmetric (fun x => f x r) (hf r)
  rw [clean_full_memory_pattern_event_action V b C ζ θ ρ k D K d _ hsym,
    ← clean_full_memory_cutoff_active_map,
    clean_full_memory_double_cutoff_projected_damped_action]

