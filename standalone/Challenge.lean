section Volume

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]

/- Borel σ-algebra on the model space `E`. -/
abbrev instMeasurableSpaceEL2CompactnessCompactness : MeasurableSpace E := borel E
abbrev instBorelSpaceEL2CompactnessCompactness :
    let : MeasurableSpace E := instMeasurableSpaceEL2CompactnessCompactness (E := E)
    BorelSpace E := by
  let : MeasurableSpace E := instMeasurableSpaceEL2CompactnessCompactness (E := E)
  exact ⟨rfl⟩







variable {K : Set E}
variable {ψ : E → ℝ}

/- The natural compact codomain for smoothing on `K` by a compactly supported kernel `ψ`. -/
def Kψ : Set E :=
  K + tsupport ψ

omit [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] in
lemma isCompact_Kψ (hK : IsCompact K) (hψcs : HasCompactSupport ψ) :
    IsCompact (Kψ (K := K) (ψ := ψ)) :=
  IsCompact.add hK hψcs.isCompact

/- Restrict the smoothed function to its compact domain as a continuous map. -/
def smoothOn (hKm : let : MeasurableSpace E := instMeasurableSpaceEL2CompactnessCompactness (E := E); MeasurableSet K) (hψc : Continuous ψ) (hψcs : HasCompactSupport ψ)
