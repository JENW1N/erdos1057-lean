  apply sum_nonneg
  intro r _
  apply mul_nonneg
  · exact prod_nonneg (fun p _ => div_nonneg zero_le_one (Nat.cast_nonneg _))
  · exact physical_residue_vertex_product_nonneg _ _ _ _
      (fun j _ => physical_endpoint_schedule_nonneg hq (N + 1) j) r

theorem physical_bare_return_scalar_norm_le {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
