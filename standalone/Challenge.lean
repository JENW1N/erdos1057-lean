/- Finite Abel summation with the exact weight `1/(n log n)`. -/
theorem norm_reciprocal_prime_sum_Ioc_le {q : ℕ} (χ : DirichletCharacter ℂ q)
    {m n : ℕ} (hm : 1 ≤ m) {B : ℝ} (hB : 0 ≤ B)
    (hprefix : ∀ k ∈ Finset.Icc m n, ‖twistedTheta χ k‖ ≤ B) :
    ‖∑ p ∈ (Finset.Ioc m n).filter Nat.Prime,
      (1 / (p : ℝ)) • χ (p : ZMod q)‖ ≤
      2 * (1 / ((m + 1 : ℕ) * Real.log (m + 1 : ℕ))) * B := by
  classical
  by_cases hmn : m < n
  · have hpos : ∀ i : ℕ, m + 1 ≤ i → 0 < (i : ℝ) := by
      intro i hi
      exact_mod_cast (show 0 < i by omega)
    have hlog : ∀ i : ℕ, m + 1 ≤ i → 0 < Real.log i := by
      intro i hi
      apply Real.log_pos
      exact_mod_cast (show 1 < i by omega)
    have hf : ∀ i ∈ Finset.Icc (m + 1) n, 0 ≤ 1 / ((i : ℝ) * Real.log i) := by
      intro i hi
      exact (one_div_pos.mpr (mul_pos (hpos i (Finset.mem_Icc.mp hi).1)
        (hlog i (Finset.mem_Icc.mp hi).1))).le
    have hanti : AntitoneOn (fun i : ℕ => 1 / ((i : ℝ) * Real.log i))
        (Set.Icc (m + 1) n) := by
      intro i hi j hj hij
      apply one_div_le_one_div_of_le (mul_pos (hpos i hi.1) (hlog i hi.1))
      apply mul_le_mul (by exact_mod_cast hij)
        (Real.log_le_log (hpos i hi.1) (by exact_mod_cast hij)) (hlog i hi.1).le
        (hpos j hj.1).le
    have hab := norm_sum_Ioc_smul_le_of_antitone
      (fun i : ℕ => 1 / ((i : ℝ) * Real.log i)) (primeLogTerm χ)
      hmn hf hanti (fun k hk => by
        rw [sum_primeLogTerm_range]
        exact hprefix k hk)
    have heq : (∑ i ∈ Finset.Ioc m n,
        (1 / ((i : ℝ) * Real.log i)) • primeLogTerm χ i) =
        ∑ p ∈ (Finset.Ioc m n).filter Nat.Prime,
          (1 / (p : ℝ)) • χ (p : ZMod q) := by
      rw [Finset.sum_filter]
      apply Finset.sum_congr rfl
      intro i hi
      by_cases hp : i.Prime
      · simp only [primeLogTerm, hp, ↓reduceIte]
        rw [← Complex.real_smul, smul_smul]
        congr 1
        field_simp [(hlog i (by have := (Finset.mem_Ioc.mp hi).1; omega)).ne']
      · simp [primeLogTerm, hp]
    rwa [heq] at hab
  · simp only [Finset.Ioc_eq_empty_of_le (by omega : n ≤ m), Finset.filter_empty,
      Finset.sum_empty, norm_zero]
    have hlog : 0 ≤ Real.log (m + 1 : ℕ) := Real.log_nonneg (by
      exact_mod_cast (show 1 ≤ m + 1 by omega))
    positivity

/- Real endpoints cost only the reciprocal logarithmic weight at the lower endpoint. -/
theorem norm_reciprocal_prime_sum_real_Ioc_le {q : ℕ} (χ : DirichletCharacter ℂ q)
    {x y B : ℝ} (hx : 2 ≤ x) (hB : 0 ≤ B)
    (hprefix : ∀ k ∈ Finset.Icc ⌊x⌋₊ ⌊y⌋₊, ‖twistedTheta χ k‖ ≤ B) :
    ‖∑ p ∈ (Finset.Ioc ⌊x⌋₊ ⌊y⌋₊).filter Nat.Prime,
      (1 / (p : ℝ)) • χ (p : ZMod q)‖ ≤ 2 * (1 / (x * Real.log x)) * B := by
  have hx0 : 0 < x := by linarith
  have hlogx : 0 < Real.log x := Real.log_pos (by linarith)
  have hm : 1 ≤ ⌊x⌋₊ := by
    apply Nat.le_floor
    norm_num
    linarith
  have hmx : x ≤ (⌊x⌋₊ + 1 : ℕ) := by
    exact_mod_cast (Nat.lt_floor_add_one x).le
  have hlog : Real.log x ≤ Real.log (⌊x⌋₊ + 1 : ℕ) := Real.log_le_log hx0 hmx
  have hinv : 1 / ((⌊x⌋₊ + 1 : ℕ) * Real.log (⌊x⌋₊ + 1 : ℕ)) ≤
      1 / (x * Real.log x) := by
    apply one_div_le_one_div_of_le (mul_pos hx0 hlogx)
    exact mul_le_mul hmx hlog hlogx.le (hx0.le.trans hmx)
  exact (norm_reciprocal_prime_sum_Ioc_le χ hm hB hprefix).trans
    (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hinv (by norm_num)) hB)
end

