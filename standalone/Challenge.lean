/- Choose the clean parameters before the polynomial cost, and the fixed
omission parameter afterwards. This is a scalar budget, not an operator
decomposition or a physical-state identification. -/

open Filter
open scoped Topology

namespace Bounty

theorem rpow_next_saving_le_half (E L : ℝ) (hL : 2 ≤ L) :
    L ^ (-(E + 1)) ≤ (1 / 2 : ℝ) * L ^ (-E) := by
  have hL0 : 0 < L := by linarith
  rw [show -(E + 1) = -E - 1 by ring, Real.rpow_sub hL0, Real.rpow_one]
  apply (div_le_iff₀ hL0).mpr
  have h := mul_le_mul_of_nonneg_left hL (Real.rpow_nonneg hL0.le (-E))
  nlinarith







