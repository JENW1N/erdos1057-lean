            ((k * (physicalSharedProduct d : ℤ)) * (repeatedBigD (C i) source aux : ℤ))) *
            physicalReturnPhase θ
              ((k * (physicalSharedProduct d : ℤ)) * (repeatedBigD (C i) source aux : ℤ)))) := by ring
    _ = _ := by rw [h]

theorem clean_hybrid_pattern_projected_norm_le 
    [∀ q : PhysicalPrime Ps, NeZero q.2.val] [∀ g j, NeZero (p g j).val]
    (K : ∀ i, RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb (C i) → ℂ)
    (d : PhysicalSharedLists Ps J) (w : RepeatedBigLists Pb J ell → ℝ) (hw : ∀ x, 0 ≤ w x)
    (Proj : (RepeatedBigLists Pb J ell → ℂ) →ₗ[ℂ] (RepeatedBigLists Pb J ell → ℂ))
    (U : Submodule ℂ (RepeatedBigLists Pb J ell → ℂ)) (hProjU : ∀ v, Proj v ∈ U)
    (hProj : ∀ v, cleanActiveNorm w (Proj v) ≤ cleanActiveNorm w v)
    (M : ℝ) (hM : 0 ≤ M)
    (hblock : ∀ (Θ : ℝ) (v : RepeatedBigLists Pb J ell → ℂ), v ∈ U →
      cleanActiveNorm w (Proj (fun source => ∑ target,
        (∑ i, ∑ aux, repeatedBigKernel Vb b (C i) ζ (K i) aux source target *
          physicalReturnPhase Θ (repeatedBigD (C i) source aux)) * v target)) ≤
        M * cleanActiveNorm w v)
    (f : RepeatedBigLists Pb J ell → (PhysicalResidues Ps × FixedOrderedResidues p) → ℂ) :
    cleanWeightedNorm w (cleanActiveMap Proj
        (cleanHybridPatternCoreAction Vb b C ζ θ k p K d (cleanActiveMap Proj f))) ≤
      M * cleanWeightedNorm w f := by
  rw [clean_hybrid_pattern_core_translated]
  change cleanWeightedNorm w (cleanProjectedTranslatedSum Proj _ _ f) ≤ _
