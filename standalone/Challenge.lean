section

/- The fixed smooth logarithmic Fourier weight for the common window cutoff. -/

open MeasureTheory
open scoped FourierTransform ContDiff

namespace Bounty

noncomputable def harmonicWindowLogCutoff (u : ℝ) : ℂ :=
  (harmonicCommonCutoff (Real.exp u) : ℂ)

theorem harmonic_window_log_cutoff_contDiff : ContDiff ℝ ∞ harmonicWindowLogCutoff := by
  apply Complex.ofRealCLM.contDiff.comp
  exact harmonic_common_cutoff_contDiff.comp Real.contDiff_exp

theorem harmonic_window_log_cutoff_support {u : ℝ} (hu : harmonicWindowLogCutoff u ≠ 0) :
    u ∈ Set.Icc (-Real.log 8) (Real.log 4 + 2) := by
  have hcut : harmonicCommonCutoff (Real.exp u) ≠ 0 := by
    intro hz
    apply hu
    simp only [harmonicWindowLogCutoff, hz, Complex.ofReal_zero]
  have hs := harmonic_common_cutoff_support hcut
  have hlo := Real.log_lt_log (by norm_num : (0 : ℝ) < 1/8) hs.1
  have hhi := Real.log_lt_log (Real.exp_pos u) hs.2
  rw [Real.log_div (by norm_num : (1 : ℝ) ≠ 0) (by norm_num : (8 : ℝ) ≠ 0),
    Real.log_one, zero_sub, Real.log_exp] at hlo
  rw [Real.log_exp, Real.log_mul (by norm_num : (4 : ℝ) ≠ 0) (Real.exp_ne_zero 2),
    Real.log_exp] at hhi
  exact ⟨hlo.le, hhi.le⟩

theorem harmonic_window_log_cutoff_hasCompactSupport : HasCompactSupport harmonicWindowLogCutoff := by
  apply HasCompactSupport.intro (K := Set.Icc (-Real.log 8) (Real.log 4 + 2)) isCompact_Icc
  intro u hu
  by_contra hne
  exact hu (harmonic_window_log_cutoff_support hne)

noncomputable def harmonicWindowLogSchwartz : SchwartzMap ℝ ℂ :=
  harmonic_window_log_cutoff_hasCompactSupport.toSchwartzMap harmonic_window_log_cutoff_contDiff

noncomputable def harmonicWindowLogFourier : SchwartzMap ℝ ℂ := 𝓕 harmonicWindowLogSchwartz

theorem harmonic_window_log_fourier_integrable : Integrable harmonicWindowLogFourier :=
  harmonicWindowLogFourier.integrable




theorem harmonic_window_log_fourier_inversion (u : ℝ) :
    harmonicWindowLogCutoff u = ∫ v : ℝ,
      Complex.exp ((2*Real.pi*v*u : ℝ)*Complex.I) * harmonicWindowLogFourier v := by
  have hi := congrArg (fun f : SchwartzMap ℝ ℂ => f u)
    (FourierPair.fourierInv_fourier_eq (E := SchwartzMap ℝ ℂ)
      (F := SchwartzMap ℝ ℂ) harmonicWindowLogSchwartz)
  rw [SchwartzMap.fourierInv_coe, Real.fourierInv_eq'] at hi
  change (∫ v : ℝ, Complex.exp ((2*Real.pi*inner ℝ v u : ℝ)*Complex.I) •
    harmonicWindowLogFourier v) = harmonicWindowLogCutoff u at hi
  rw [← hi]
  apply integral_congr_ae
  filter_upwards [] with v
  simp only [RCLike.inner_apply, starRingEnd_apply, star_trivial, smul_eq_mul]
  congr 2
  push_cast
  ring




end Bounty
end

section

/- One extra power absorbs the fixed Fourier L1 mass, uniformly in the central radius. -/

open MeasureTheory Filter
namespace Bounty

theorem eventually_harmonic_central_integral_decay (D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (Y R : ℝ) (G : ℝ → ℂ), 0 < Y →
      (∀ v : ℝ, ‖v‖ ≤ R → ‖G v‖ ≤ Y*L^(-(D+1))) →
      ‖(Y : ℂ)⁻¹ * ∫ v in {v : ℝ | ‖v‖ ≤ R}, harmonicLogFourier v * G v‖ ≤ L^(-D) := by
  filter_upwards [eventually_ge_atTop (max 1 (∫ v : ℝ, ‖harmonicLogFourier v‖))]
    with L hL
  intro Y R G hY hG
  have hL0 : 0 < L := zero_lt_one.trans_le ((le_max_left _ _).trans hL)
  have hmass := (le_max_right _ _).trans hL
  have hs : MeasurableSet {v : ℝ | ‖v‖ ≤ R} :=
    (isClosed_le continuous_norm continuous_const).measurableSet
  have hGe : ∀ᵐ v ∂volume.restrict {v : ℝ | ‖v‖ ≤ R}, ‖G v‖ ≤ Y*L^(-(D+1)) :=
    (ae_restrict_mem hs).mono (fun v hv => hG v hv)
  refine (normalized_harmonic_central_bound hY
    (Real.rpow_pos_of_pos hL0 _).le _ G hGe).trans ?_
  calc
    _ ≤ L * L^(-(D+1)) := mul_le_mul_of_nonneg_right hmass
      (Real.rpow_pos_of_pos hL0 _).le
    _ = L^(-D) := by
      calc
        _ = L^(1 : ℝ) * L^(-(D+1)) := by rw [Real.rpow_one]
        _ = _ := by rw [← Real.rpow_add hL0]; congr 1; ring

end Bounty
end

