section

/- Explicit exponent bookkeeping for the normalized major/minor pairing. -/

open MeasureTheory
namespace Bounty

theorem major_minor_pairing_decay {L Y B D Ef Eg M : ℝ}
    (hL : 2 ≤ L) (hY : 0 ≤ Y) (hf0 : 0 ≤ Ef) (hg0 : 0 ≤ Eg) (hM0 : 0 ≤ M)
    (hf : Ef ≤ Y*L^B) (hg : Eg ≤ Y*L^B)
    (hM : M ≤ Y*L^(-(2*D+B+2))) :
    Real.sqrt ((L^(-(D+B+1)))^2*Ef+M)*Real.sqrt Eg ≤ Y*L^(-D) := by
  have hLp : 0 < L := by linarith
  have hpower : (L^(-(D+B+1)))^2*(Y*L^B) = Y*L^(-(2*D+B+2)) := by
    calc
      _ = Y*(L^(-(D+B+1))*L^(-(D+B+1))*L^B) := by ring
      _ = _ := by
        rw [← Real.rpow_add hLp, ← Real.rpow_add hLp]
        congr 2
        ring
  have hfirst : (L^(-(D+B+1)))^2*Ef+M ≤ 2*Y*L^(-(2*D+B+2)) := by
    have hh := mul_le_mul_of_nonneg_left hf (sq_nonneg (L^(-(D+B+1))))
    rw [hpower] at hh
    linarith
  have hproduct : ((L^(-(D+B+1)))^2*Ef+M)*Eg ≤
      2*Y^2*L^(-(2*D+2)) := by
    calc
      _ ≤ (2*Y*L^(-(2*D+B+2)))*(Y*L^B) :=
        mul_le_mul hfirst hg hg0 (by positivity)
      _ = 2*Y^2*(L^(-(2*D+B+2))*L^B) := by ring
      _ = _ := by
        rw [← Real.rpow_add hLp]
        congr 2
        ring
  have hsquare : (Y*L^(-D))^2 = Y^2*L^(-2*D) := by
    rw [mul_pow, pow_two (L^(-D)), ← Real.rpow_add hLp]
    congr 2
    ring
  have hsmall : 2*Y^2*L^(-(2*D+2)) ≤ (Y*L^(-D))^2 := by
    rw [hsquare, show -(2*D+2) = -2*D-2 by ring,
      Real.rpow_sub hLp, Real.rpow_two, ← mul_div_assoc]
    apply (div_le_iff₀ (sq_pos_of_pos hLp)).2
    have hsq : 2 ≤ L^2 := by nlinarith
    nlinarith [mul_le_mul_of_nonneg_left hsq
      (mul_nonneg (sq_nonneg Y) (Real.rpow_pos_of_pos hLp (-2*D)).le)]
  rw [← Real.sqrt_mul (add_nonneg (mul_nonneg (sq_nonneg _) hf0) hM0)]
  exact (Real.sqrt_le_iff).2 ⟨by positivity, hproduct.trans hsmall⟩

end Bounty
end

section

/- Character cancellation normalized by the actual candidate coefficient mass. -/

open Finset Filter

namespace Bounty

theorem exists_candidate_character_relative_power_bound
    (hZ : PrimitiveZeroFreeHalfPlane) {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1) (B : ℝ) :
    ∃ J : ℕ, ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, J < jStar →
      ∀ (f : ℕ), 0 < f → (f : ℝ) ≤ Real.exp L →
      ∀ χ : DirichletCharacter ℂ f, χ ≠ 1 →
      ∀ (m : ℕ), m ≠ 0 → (m : ℝ) ≤ Real.exp L →
        ‖∑ u ∈ (arithmeticProductWindow 1 (Real.exp L)).filter (fun u => u.Coprime m),
          (candidateCoefficient c L q r jStar u : ℂ) * χ (u : ZMod f)‖ ≤
          candidateCoefficientWindowMass c L q r jStar * L^(-B) := by
  obtain ⟨V, hV, hrest⟩ := exists_candidate_Q_rest_harmonic_upper hc r hr
  obtain ⟨K, hK, J, hlower⟩ :=
    exists_candidate_coefficient_window_mass_lower hc hr hq0 hq1 hcenter
  refine ⟨J, ?_⟩
  filter_upwards [eventually_candidate_character_cancellation hZ hc (B+2), hrest, hlower,
    eventually_candidate_one_marked_mass_ge_one hc hq0 hq1.le,
    eventually_ge_atTop ((16*V)/K), eventually_gt_atTop (0 : ℝ)] with
      L hcancel hrestL hlowerL hPone hlarge hL
  intro jStar hj f hf hfL χ hχ m hm hmL
  have hj0 : 0 < jStar := (Nat.zero_le J).trans_lt hj
  have hP : 0 ≤ candidateOneMarkedHarmonicMass c L q := zero_le_one.trans hPone
  have hQ : 0 ≤ candidateQHarmonicMass c L r jStar := by
    apply tsum_nonneg
    intro n
    exact div_nonneg (candidate_Q_weight_nonneg c L r jStar n) (Nat.cast_nonneg n)
  have hconst : 16*V ≤ K*L := by
    simpa only [mul_comm L K] using (div_le_iff₀ hK).mp hlarge
  have hpowers : L^(-(B+2)) = L^(-B) / L^2 := by
    rw [show -(B+2) = -B - 2 by ring, Real.rpow_sub hL, Real.rpow_two]
  calc
    _ ≤ (16*Real.exp L) * L^(-(B+2)) * candidateOneMarkedHarmonicMass c L q *
        candidateQRestHarmonicMass c L r jStar hr :=
      hcancel q hq0 r jStar hr hj0 f hf hfL χ hχ m hm hmL
    _ ≤ (16*Real.exp L) * L^(-(B+2)) * candidateOneMarkedHarmonicMass c L q *
        (V * candidateQHarmonicMass c L r jStar) :=
      mul_le_mul_of_nonneg_left (hrestL jStar hj0) (by positivity)
    _ = (16*V) * (Real.exp L * candidateOneMarkedHarmonicMass c L q *
        candidateQHarmonicMass c L r jStar * L^(-(B+2))) := by ring
    _ ≤ (K*L) * (Real.exp L * candidateOneMarkedHarmonicMass c L q *
        candidateQHarmonicMass c L r jStar * L^(-(B+2))) :=
      mul_le_mul_of_nonneg_right hconst (by positivity)
    _ = (K * (Real.exp L/L) * candidateOneMarkedHarmonicMass c L q *
        candidateQHarmonicMass c L r jStar) * L^(-B) := by
      rw [hpowers]
      field_simp
    _ ≤ _ := mul_le_mul_of_nonneg_right (hlowerL jStar hj) (Real.rpow_nonneg hL.le _)

end Bounty

end

section

/- The energy of the literal physical history is the injective part of
its full-state realization. This comparison retains every physical list
and pending tuple, with the original product weights. -/

namespace Bounty

section Physical
variable {I K : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g, ∀ p : ↥(P g), NeZero p.val]
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (retention : I → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
