/- Explicit finite tilt and collision budgets for the actual prime-pattern
family. Only the already defined physical perturbation error is estimated. -/

open Finset
open scoped Classical

namespace Bounty










theorem repeated_big_prime_pattern_bound_sum_le {G : Type*} [DecidableEq G]
    {J ell m : ℕ} (probes : G → Finset (Fin J)) (r t : Finset G)
    (hp : ∀ g, (probes g).card ≤ m) (Q : ℕ) (ξ : ℝ) :
    (∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      repeatedBigPrimePatternBound probes r t Q ξ i) ≤
      1 + (2 : ℝ) ^ (m * (r.card + t.card)) * ((Q * Q : ℕ) / ξ) ^ 2 := by
  rw [Fintype.sum_sum_type]
  simp only [repeatedBigPrimePatternBound, sum_const, card_univ, nsmul_eq_mul,
    Fintype.card_unit, Nat.cast_one, mul_one]
  apply add_le_add le_rfl
  apply mul_le_mul_of_nonneg_right _ (sq_nonneg _)
  exact_mod_cast repeated_big_prime_pattern_pair_card_le (ell := ell) probes r t hp







end Bounty
