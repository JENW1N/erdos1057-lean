open Finset
/- The initial phase test never starts with an inactive pending particle. -/
theorem ghost_phase_initial_diagonal_one {R : Type*} [DecidableEq R]
    (a : Bool) (hit : R) (β ρ : ℝ) (z : GhostPhaseState R)
    (hz : ghostPhaseInitial a β z ≠ 0) :
    ghostPhaseDiagonal hit ρ z = 1 := by
  cases a <;> rcases z with _ | (_ | (_ | r)) <;>
    simp_all [ghostPhaseInitial, ghostFiniteInitial, ghostPhaseDiagonal]

/- The terminal phase test excludes all inactive pending particles. -/
theorem ghost_phase_terminal_diagonal_one {R : Type*} [DecidableEq R]
    (a : Bool) (hit : R) (ρ : ℝ) (z : GhostPhaseState R)
    (hz : ghostPhaseTerminal a z ≠ 0) :
    ghostPhaseDiagonal hit ρ z = 1 := by
  cases a <;> rcases z with _ | (_ | (_ | r)) <;>
    simp_all [ghostPhaseTerminal, ghostFiniteTerminal, ghostPhaseDiagonal]












