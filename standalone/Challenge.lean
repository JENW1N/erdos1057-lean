noncomputable abbrev inactiveField (P:Ideal (_root_.OAI.ActualEisensteinCubic.O)) [P.IsMaximal] : Field ((_root_.OAI.ActualEisensteinCubic.O)⧸P) :=
  Ideal.Quotient.field P
noncomputable abbrev inactiveFintype (P:Ideal (_root_.OAI.ActualEisensteinCubic.O)) [P.IsMaximal] : Fintype ((_root_.OAI.ActualEisensteinCubic.O)⧸P) :=
  Fintype.ofFinite _

lemma finiteAdditiveFourierCoeff_zero {R:Type*} [Field R] [Fintype R]
    (ψ:AddChar R ℂ) (χ:MulChar R ℂ) (j:ℕ) :
    finiteAdditiveFourierCoeff ψ (fun x=>(χ^j) x) 0=zeroFourierCoefficient χ j := by
  simp only [finiteAdditiveFourierCoeff,zeroFourierCoefficient,neg_zero,zero_mul,
    AddChar.map_zero_eq_one,mul_one,div_eq_mul_inv]
  ring

lemma prime_zeroFourier_norm_formula (p:(_root_.OAI.ActualEisensteinCubic.O)) [(Ideal.span {p}).IsMaximal]
    (hp:p≠0) (hg:lambda∉Ideal.span {p}) (hodd:ringChar ((_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {p})≠2)
    (j:ℕ) (hj:j<6) :
    letI : Field ((_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {p}) := inactiveField (Ideal.span {p})
    letI : Fintype ((_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {p}) := inactiveFintype (Ideal.span {p})
    finiteAdditiveFourierCoeff (quotientTrace p hp)
      (fun x=>(actualSextic (Ideal.span {p}) hg^j) x) 0=
      if j=0 then 1-(Ideal.absNorm (Ideal.span {p}):ℂ)⁻¹ else 0 := by
  letI : Field ((_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {p}) := inactiveField (Ideal.span {p})
  letI : Fintype ((_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {p}) := inactiveFintype (Ideal.span {p})
  rw [finiteAdditiveFourierCoeff_zero]
  have he:=canonical_zeroFourierCoefficient (Ideal.span {p}) hg hodd j hj
  convert he using 1
  exact congrArg (fun n:ℕ=>(if j=0 then 1-(n:ℂ)⁻¹ else 0)) (by rw [Ideal.absNorm_apply,Submodule.cardQuot_apply,Nat.card_eq_fintype_card])

end CubicEisenstein

