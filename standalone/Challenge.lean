/- Pull a terminal test at cut `n` backwards through rows `n-1,...,0`.
The resulting function is on the initial state space. -/
def finiteRowComposition {S : Nat → Type*} {V : Type*}
    (row : (i : Nat) → (S (i + 1) → V) → S i → V) :
    (n : Nat) → (S n → V) → S 0 → V
  | 0, F => F
  | n + 1, F => finiteRowComposition row n (row n F)

section

variable
  {S : Nat → Type*}
  {V : Type*}
  (row : (i : Nat) → (S (i + 1) → V) → S i → V)

include S V row

theorem finite_row_composition_zero  (F : S 0 → V) :
    finiteRowComposition row 0 F = F := rfl

theorem finite_row_composition_succ 
    (n : Nat) (F : S (n + 1) → V) :
    finiteRowComposition row (n + 1) F = finiteRowComposition row n (row n F) := rfl

end


/- If each actual row pulls readout tests back to the corresponding target
row, the complete finite chronological compositions satisfy the same exact
readout identity. The maps and both state spaces may vary at every cut. -/
theorem finite_row_composition_intertwines {S T : Nat → Type*} {V : Type*}
    (rowS : (i : Nat) → (S (i + 1) → V) → S i → V)
    (rowT : (i : Nat) → (T (i + 1) → V) → T i → V)
    (readout : (i : Nat) → S i → T i)
    (hrow : ∀ i (F : T (i + 1) → V),
      rowS i (F ∘ readout (i + 1)) = (rowT i F) ∘ readout i)
    (n : Nat) (F : T n → V) :
    finiteRowComposition rowS n (F ∘ readout n) =
      (finiteRowComposition rowT n F) ∘ readout 0 := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [finite_row_composition_succ, hrow n F, finite_row_composition_succ]
      exact ih (rowT n F)



end

section
open Finset
/- Active labels read directly from the phase snapshot. -/
noncomputable def ghostPhaseStateActiveSupport {P : Type*} [Fintype P]
    {R : P → Type*} (z : (p : P) → GhostPhaseState (R p)) : Finset P := by
  classical
  exact univ.filter (fun p => z p = none)

theorem ghost_phase_mem_state_active_support {P : Type*} [Fintype P]
    {R : P → Type*} (z : (p : P) → GhostPhaseState (R p)) (p : P) :
    p ∈ ghostPhaseStateActiveSupport z ↔ z p = none := by
  classical
  unfold ghostPhaseStateActiveSupport
  exact mem_filter.trans (and_iff_right (mem_univ p))

theorem ghost_phase_state_active_subset_born {P : Type*} [Fintype P]
    {R : P → Type*} (z : (p : P) → GhostPhaseState (R p)) :
    ghostPhaseStateActiveSupport z ⊆ ghostPhaseBornSupport z := by
  intro p hp
  rw [ghost_phase_mem_state_active_support] at hp
  rw [ghost_phase_mem_born_support, hp]
  simp

/- The state-level active support agrees with the physical activity mask. -/
theorem ghost_phase_state_active_support_of_mask {P : Type*} [Fintype P]
    {R : P → Type*} (a : P → Bool) (z : (p : P) → GhostPhaseState (R p))
    (hz : ghostPhaseMask a z) :
    ghostPhaseStateActiveSupport z = ghostPhaseActivitySupport a := by
  classical
  ext p
  rw [ghost_phase_mem_state_active_support]
  simp only [ghostPhaseActivitySupport, mem_filter, mem_univ, true_and]
  have hp := hz p
  cases ha : a p <;> cases he : z p <;> simp_all

/- Active labels are active; other previously born labels are completed;
all remaining labels are unborn. Pending particles are supplied separately. -/
noncomputable def globalBirthMemoryBase {P : Type*} {R : P → Type*}
    (active born : Finset P) : (p : P) → GhostPhaseState (R p) := by
  classical
  exact fun p => if p ∈ active then none else
    if p ∈ born then some (some none) else some none

/- A uniform snapshot readout. Compatible pending particles override the
base only at inactive born labels. On an incompatible arbitrary tuple, the
pending preference may override active or unborn metadata; exact reconstruction
below supplies compatibility through support and particle agreement. -/
noncomputable def globalBirthMemoryReadout {P : Type*} {R : P → Type*}
    (active born : Finset P) (q : FiniteOrderedTuple (Σ p, R p)) :
    (p : P) → GhostPhaseState (R p) :=
  ghostPhaseMemoryReadout (globalBirthMemoryBase active born) q

/- Off the pending support, the cumulative-born base already reconstructs
the complete phase tag. -/
theorem global_birth_memory_base_eq_outside_pending {P : Type*} [Fintype P]
    {R : P → Type*} (z : (p : P) → GhostPhaseState (R p)) (p : P)
    (hp : p ∉ ghostPhasePendingSupport z) :
    globalBirthMemoryBase (ghostPhaseStateActiveSupport z) (ghostPhaseBornSupport z) p =
      z p := by
  classical
  have hn : ¬ ∃ r, z p = some (some (some r)) := by
    simpa only [ghostPhasePendingSupport, mem_filter, mem_univ, true_and] using hp
  cases he : z p with
  | none => simp [globalBirthMemoryBase, ghost_phase_mem_state_active_support, he]
  | some c =>
      cases c with
      | none => simp [globalBirthMemoryBase, ghost_phase_mem_state_active_support,
          ghost_phase_mem_born_support, he]
      | some c =>
          cases c with
          | none => simp [globalBirthMemoryBase, ghost_phase_mem_state_active_support,
              ghost_phase_mem_born_support, he]
          | some r => exact (hn ⟨r, he⟩).elim

/- Exact snapshot reconstruction. Particle consistency and complete support
suffice; distinctness is only needed for the ordered-memory sector and norm. -/
theorem global_birth_memory_readout_eq {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (z : (p : P) → GhostPhaseState (R p))
    (q : FiniteOrderedTuple (Σ p, R p))
    (hsupport : univ.image (fun j => (q.2 j).1) = ghostPhasePendingSupport z)
    (hparticle : ∀ j, z (q.2 j).1 = some (some (some (q.2 j).2))) :
    globalBirthMemoryReadout (ghostPhaseStateActiveSupport z) (ghostPhaseBornSupport z) q =
      z := by
  exact ghost_phase_memory_readout_eq _ z q hsupport hparticle
    (global_birth_memory_base_eq_outside_pending z)

/- The same reconstruction with a supplied physical activity mask. -/
theorem global_birth_memory_readout_eq_of_mask {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (a : P → Bool) (z : (p : P) → GhostPhaseState (R p))
    (hz : ghostPhaseMask a z) (q : FiniteOrderedTuple (Σ p, R p))
    (hsupport : univ.image (fun j => (q.2 j).1) = ghostPhasePendingSupport z)
    (hparticle : ∀ j, z (q.2 j).1 = some (some (some (q.2 j).2))) :
    globalBirthMemoryReadout (ghostPhaseActivitySupport a) (ghostPhaseBornSupport z) q =
      z := by
  rw [← ghost_phase_state_active_support_of_mask a z hz]
  exact global_birth_memory_readout_eq z q hsupport hparticle















end

section
open Finset
