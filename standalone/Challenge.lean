theorem eventually_rough_test_proxy_character_discrepancy (hZ : PrimitiveZeroFreeRightOf (23 / 24))
    {a γ C S T Bsave : ℝ} (ha : 0 < a) (hγ : 0 < γ) (hC : 0 < C)
