section

/- Full signed edge coefficients with an auxiliary-dependent permutation
of an external finite coordinate. The external permutation is applied before
the auxiliary average. No dimension factor for the external space is used. -/

open Finset Classical

namespace Bounty

theorem finite_external_energy_of_scaled_norm {X R : Type*} [Fintype X] [Fintype R]
    (w : X → ℝ) (hw : ∀ x, 0 ≤ w x) (H : ℝ) (hH : 0 ≤ H) (K : ℝ)
    (f output majorant : X → R → ℂ)
    (hdom : ∀ x r, ‖output x r‖ ≤ ‖(H : ℂ) * majorant x r‖)
    (hbase : (∑ r, finiteWeightedEnergy w (fun x => majorant x r)) ≤
      K * ∑ r, finiteWeightedEnergy w (fun x => f x r)) :
    (∑ r, finiteWeightedEnergy w (fun x => output x r)) ≤
      H ^ 2 * K * ∑ r, finiteWeightedEnergy w (fun x => f x r) := by
  calc
    _ ≤ ∑ r, H ^ 2 * finiteWeightedEnergy w (fun x => majorant x r) := by
      apply sum_le_sum
      intro r _
      simpa only [mul_one] using finite_weighted_energy_of_scaled_norm w hw H hH 1
        (fun x => majorant x r) (fun x => output x r) (fun x => majorant x r)
        (fun x => hdom x r) (by simp only [one_mul, le_refl])
    _ = H ^ 2 * ∑ r, finiteWeightedEnergy w (fun x => majorant x r) := (mul_sum ..).symm
    _ ≤ _ := (mul_le_mul_of_nonneg_left hbase (sq_nonneg H)).trans_eq (by ring)

section

variable {G : Type*} [Fintype G] [dG : DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : SharedActiveLabels P S → Type*) [∀ c, Fintype (A c)]
  (Δ D : ∀ c, A c → G → ℤ)
  (ω : ∀ c, A c → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  {R : Type*} (τ : ∀ c, A c → R ≃ R)

noncomputable def fullActiveExternalCoefficientAction
    (Ψ : ∀ x, R → FullActiveEdgeEvent n S B A Δ D x → ℂ)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → R → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) (r : R) : ℂ :=
  ∑ e : FullActiveEdgeEvent n S B A Δ D x,
    (fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V x e : ℂ) * Ψ x r e *
      f (fullActiveEdgeEventTarget n S B A Δ D x e) (τ (productActiveMemorySplit S B x).1 e.1 r)

noncomputable def fullActiveExternalPositiveAction
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → R → ℂ) :=
  equivExternalFiberAverage (productActiveMemorySplit S B) ω
    (fun c a => unrestrictedCoupledCutoffProductOperator n (Δ c a) (D c a) μ ρ V
      (fun g => (S g)ᶜ.card) B (fun _ _ => 1)) τ f

omit [∀ g p, NeZero (n g p)] in
theorem full_active_external_positive_eq_sum
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → R → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) (r : R) :
    fullActiveExternalPositiveAction n S B A Δ D ω μ ρ V τ f x r =
      fullActiveExternalCoefficientAction n S B A Δ D ω μ ρ V τ (fun _ _ _ => 1) f x r := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  unfold fullActiveExternalPositiveAction equivExternalFiberAverage finiteExternalFiberAverage
    fullActiveExternalCoefficientAction
  rw [Fintype.sum_sigma]
  apply sum_congr rfl
  intro a _
  dsimp only
  rw [unrestricted_coupled_cutoff_eq_joint_event_sum]
  simp only [mul_sum, fullActiveEdgeEventWeight, fullActiveEdgeEventTarget,
    Complex.ofReal_mul, mul_one, mul_assoc]
  apply sum_congr
  · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
  · intro e _; rfl

omit [∀ g p, NeZero (n g p)] in
theorem full_active_external_coefficient_norm_le
    (hω : ∀ c a, 0 ≤ ω c a) (hμ : ∀ g p, 0 ≤ μ g p)
    (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ V g)
    (Ψ : ∀ x, R → FullActiveEdgeEvent n S B A Δ D x → ℂ)
    (H : ℝ) (hH : 0 ≤ H) (hΨ : ∀ x r e, ‖Ψ x r e‖ ≤ H)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → R → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) (r : R) :
    ‖fullActiveExternalCoefficientAction n S B A Δ D ω μ ρ V τ Ψ f x r‖ ≤
      ‖(H : ℂ) * fullActiveExternalPositiveAction n S B A Δ D ω μ ρ V τ
        (fun y s => (‖f y s‖ : ℂ)) x r‖ := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  have hw (e : FullActiveEdgeEvent n S B A Δ D x) :=
    fullActiveEdgeEventWeight_nonneg n S B A Δ D ω μ ρ V hω hμ hρ hV x e
  have he : fullActiveExternalPositiveAction n S B A Δ D ω μ ρ V τ
      (fun y s => (‖f y s‖ : ℂ)) x r =
      ((∑ e : FullActiveEdgeEvent n S B A Δ D x,
        fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V x e *
          ‖f (fullActiveEdgeEventTarget n S B A Δ D x e)
            (τ (productActiveMemorySplit S B x).1 e.1 r)‖ : ℝ) : ℂ) := by
    rw [full_active_external_positive_eq_sum]
    simp only [fullActiveExternalCoefficientAction, mul_one, Complex.ofReal_sum, Complex.ofReal_mul]
  rw [he, norm_mul]
  simp only [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hH]
  rw [abs_of_nonneg (sum_nonneg fun e _ => mul_nonneg (hw e) (norm_nonneg _))]
  unfold fullActiveExternalCoefficientAction
  calc
    _ ≤ ∑ e : FullActiveEdgeEvent n S B A Δ D x,
        ‖(fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V x e : ℂ) * Ψ x r e *
          f (fullActiveEdgeEventTarget n S B A Δ D x e)
            (τ (productActiveMemorySplit S B x).1 e.1 r)‖ := norm_sum_le _ _
    _ ≤ ∑ e : FullActiveEdgeEvent n S B A Δ D x,
        fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V x e * H *
          ‖f (fullActiveEdgeEventTarget n S B A Δ D x e)
            (τ (productActiveMemorySplit S B x).1 e.1 r)‖ := by
      apply sum_le_sum
      intro e _
      rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hw e)]
      exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (hΨ x r e) (hw e)) (norm_nonneg _)
    _ = _ := by
      rw [mul_sum]
      apply sum_congr rfl
      intro e _
      ring

variable [Fintype R]

theorem full_active_external_positive_energy_le
    (hω : ∀ c a, 0 ≤ ω c a) (hωmass : ∀ c, ∑ a, ω c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, (S g)ᶜ.card ≤ T)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → R → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun x => f x r)) :
    (∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fun x => fullActiveExternalPositiveAction n S B A Δ D ω μ ρ V τ f x r)) ≤
      unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        ∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
          (fun x => f x r) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  apply equiv_external_fiber_average_energy_le (productActiveMemorySplit S B)
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) (sharedActiveWeight S μ)
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productActiveMemorySplit_weight_symm S B μ _) (sharedActiveWeight_nonneg S μ hμ)
    (productMemoryWeight_nonneg μ _ hμ (fun g z => hμ g z.1)) ω hω hωmass _ τ f
    (pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _)
  intro c a r
  exact unrestricted_coupled_cutoff_product_energy_le n (Δ c a) (D c a) μ ρ V
    (fun g => (S g)ᶜ.card) B hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht
    (fun _ _ => 1) (by intros; simp only [norm_one, le_refl]) _
    (productActiveMemorySlice_symmetric S B (fun x => f x r) (hf r) c)

theorem full_active_external_coefficient_energy_le
    (hω : ∀ c a, 0 ≤ ω c a) (hωmass : ∀ c, ∑ a, ω c a ≤ 1)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, (S g)ᶜ.card ≤ T)
    (Ψ : ∀ x, R → FullActiveEdgeEvent n S B A Δ D x → ℂ)
    (H : ℝ) (hH : 0 ≤ H) (hΨ : ∀ x r e, ‖Ψ x r e‖ ≤ H)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → R → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun x => f x r)) :
    (∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fun x => fullActiveExternalCoefficientAction n S B A Δ D ω μ ρ V τ Ψ f x r)) ≤
      H ^ 2 * unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        ∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
          (fun x => f x r) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  have hp := full_active_external_positive_energy_le n S B A Δ D ω μ ρ V τ
    hω hωmass hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht (fun x r => (‖f x r‖ : ℂ))
    (fun r => complexNormEnvelope_memory_symmetric (fun x => f x r) (hf r))
  have he : (∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (fun x => (‖f x r‖ : ℂ))) =
      ∑ r, finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
        (fun x => f x r) := by
    apply sum_congr rfl
    intro r _
    exact complexNormEnvelope_energy _ (fun x => f x r)
  rw [he] at hp
  exact finite_external_energy_of_scaled_norm
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productMemoryWeight_nonneg μ _ hμ (fun g z => hμ g z.1)) H hH
    (unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G) f
    (fullActiveExternalCoefficientAction n S B A Δ D ω μ ρ V τ Ψ f)
    (fullActiveExternalPositiveAction n S B A Δ D ω μ ρ V τ (fun x r => (‖f x r‖ : ℂ)))
    (full_active_external_coefficient_norm_le n S B A Δ D ω μ ρ V τ hω hμ hρ0.le
      (fun g => (hvmin.trans_le (hVlo g)).le) Ψ H hH hΨ f) hp




end

end Bounty
end

section

/- Polynomial costs for the complete finite signed pattern family at an
exceptional operation. The local physical energy constant remains explicit;
no cancellation or small-norm premise is assumed. -/

namespace Bounty

noncomputable def repeatedBigFamilyEnvelope (s m Q : ℕ) (xi : ℝ) : ℝ :=
  1 + (2 : ℝ) ^ (m * s) * (((Q * Q : ℕ) : ℝ) / xi) ^ 2

theorem repeated_big_family_envelope_nonneg (s m Q : ℕ) (xi : ℝ) :
    0 ≤ repeatedBigFamilyEnvelope s m Q xi := by
  unfold repeatedBigFamilyEnvelope
  positivity

theorem repeated_big_family_envelope_le {L a q x xi : ℝ} (s m Q : ℕ)
    (hL : 1 ≤ L) (ha : 0 ≤ a) (hq : 0 ≤ q) (hx : 0 ≤ x)
    (hs : (s : ℝ) ≤ a * Real.log L) (hQ : (Q : ℝ) ≤ L ^ q)
    (hxi : L ^ (-x) ≤ xi) :
    repeatedBigFamilyEnvelope s m Q xi ≤
      2 * L ^ ((m : ℝ) * a * Real.log 2 + 4 * q + 2 * x) := by
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hxi0 : 0 < xi := (Real.rpow_pos_of_pos hL0 _).trans_le hxi
  have htwo := repeated_big_log_count_pow_le (L := L) (a := a) (b := 2) m s hL0
    (by norm_num) hs
  have hQ2 : ((Q * Q : ℕ) : ℝ) ≤ L ^ (2 * q) := by
    push_cast
    calc
      (Q : ℝ) * Q ≤ L ^ q * L ^ q :=
        mul_le_mul hQ hQ (Nat.cast_nonneg _) (Real.rpow_nonneg hL0.le _)
      _ = L ^ (2 * q) := by rw [← Real.rpow_add hL0]; congr 1; ring
  have hratio : ((Q * Q : ℕ) : ℝ) / xi ≤ L ^ (2 * q + x) := by
    calc
      _ ≤ L ^ (2 * q) / L ^ (-x) := div_le_div₀ (by positivity) hQ2
        (Real.rpow_pos_of_pos hL0 _) hxi
      _ = _ := by rw [← Real.rpow_sub hL0]; congr 1; ring
  have hB : (((Q * Q : ℕ) : ℝ) / xi) ^ 2 ≤ L ^ (4 * q + 2 * x) := by
    calc
      _ ≤ (L ^ (2 * q + x)) ^ (2 : ℕ) := pow_le_pow_left₀ (by positivity) hratio 2
      _ = _ := by rw [← Real.rpow_natCast, ← Real.rpow_mul hL0.le]; congr 1; ring
  have hgamma : 0 ≤ (m : ℝ) * a * Real.log 2 + 4 * q + 2 * x := by
    have hl : 0 ≤ Real.log 2 := Real.log_nonneg (by norm_num)
    positivity
  have hp := mul_le_mul htwo hB (sq_nonneg _) (Real.rpow_nonneg hL0.le _)
  rw [← Real.rpow_add hL0, ← add_assoc] at hp
  have hone := Real.one_le_rpow hL hgamma
  unfold repeatedBigFamilyEnvelope
  linarith

theorem repeated_big_group_energy_cost_le {L a K : ℝ} (s : ℕ)
    (hL : 0 < L) (hK : 0 ≤ K) (hs : (s : ℝ) ≤ a * Real.log L) :
    K ^ s ≤ L ^ (a * Real.log (max 1 K)) := by
  calc
    K ^ s ≤ (max 1 K) ^ s := pow_le_pow_left₀ hK (le_max_right 1 K) s
    _ ≤ _ := by
      simpa only [one_mul, Nat.cast_one] using
        repeated_big_log_count_pow_le (L := L) (a := a) (b := max 1 K)
          1 s hL (le_max_left 1 K) hs







end Bounty
end

section

/- Exact physical history normalization under adjacent common-mark compatibility.
No global residue assignment is supplied; all original local rows and cutoffs remain. -/

open Finset
namespace Bounty

section ResiduePath
variable {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell n : ℕ}
  (C : Fin n → G → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations G J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (hcompat : ∀ j : Fin n, ∀ g s t,
    ((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val =
      ((physicalPermuteLabels (τ j) (L j.succ)) g t).val →
    (((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val : ℤ) ∣
      k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))

variable
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (g : G)
  (hk : ∀ j : Fin n, ∀ s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : ↥(P g) → ℝ) (η : Fin (n + 1) → ℝ) (V ρ : ℝ) (hV : V ≠ 0) (cap : ℕ)

noncomputable def physicalAdjacentFiniteEdge (j : Fin n) :
    GlobalBirthRawStep (R := fun p : ↥(P g) => ZMod p.val)
      (physicalGroupBareFiniteActivity L g j.castSucc) (physicalGroupBareFiniteActivity L g j.succ) :=
  physicalGroupBareFiniteEdge C aux k L a σ τ hlist hP hdis
    hcompat
    g hk β V ρ cap j

variable [∀ p : ↥(P g), NeZero p.val]

include hstep in
theorem physical_adjacent_edge_kernel_to_real (j : Fin n)
    (z w : (p : ↥(P g)) → GhostPhaseState (ZMod p.val)) :
    globalBirthRawStepKernel
      (physicalAdjacentFiniteEdge C aux k L a σ τ hcompat hlist hP hdis g hk β V ρ cap j) z w =
      (physicalResidueCappedMovingEdgeKernel L a g β V ρ cap j.val z w : ℂ) := by
  unfold physicalResidueCappedMovingEdgeKernel
  rw [show globalBirthFiniteActivity (physicalGroupBareFiniteActivity L g) (j.val + 1) =
      physicalGroupBareFiniteActivity L g j.succ from
    global_birth_finite_activity_at _ j.succ]
  rw [show globalBirthFiniteActivity (physicalGroupBareFiniteActivity L g) j.val =
      physicalGroupBareFiniteActivity L g j.castSucc from
    global_birth_finite_activity_at _ j.castSucc]
  simp_rw [physical_residue_absolute_hit_step a g j]
  refine (physical_group_permuted_bare_raw_edge_kernel (C j) (aux j) (k j)
    (L j.castSucc) (L j.succ) (a j.castSucc) (σ j) (τ j) (hlist j) hP hdis
    (hcompat j)
    g (hk j) β ρ V cap z w).trans ?_
  simp only [physicalGroupBareRawEdge, global_birth_raw_step_kernel_edge,
    ← hstep j, physical_group_phase_activity_permute]
  unfold ghostPhaseCappedDampedMovingEdge
  split_ifs <;> rfl

/- The finite atomic physical kernels are exactly the real capped kernels,
after their canonical complex embedding. Only used time indices are compared. -/
include hstep in
theorem physical_adjacent_atomic_kernel_to_real (i : ℕ) (hi : i < 2 * n + 1)
    (z w : (p : ↥(P g)) → GhostPhaseState (ZMod p.val)) :
    globalBirthRawStepKernel
      (physicalGroupAdjacentFiniteStep C aux k L a σ τ hcompat hlist hP hdis g hk β η V ρ hV cap i) z w =
      ((finiteAlternatingKernel (physicalResidueCappedVisitKernel L g β η ρ cap)
        (physicalResidueCappedMovingEdgeKernel L a g β V ρ cap) i z w : ℝ) : ℂ) := by
  by_cases hp : i % 2 = 0
  · let j : Fin (n + 1) := ⟨i / 2, by omega⟩
    have hi' : i = 2 * j.val := by dsimp [j]; omega
    rw [hi', finite_alternating_kernel_even]
    exact (global_birth_finite_alternating_kernel_even (physicalGroupBareFiniteActivity L g)
      (physicalGroupBareFiniteVisit L g β η V ρ hV cap)
      (physicalAdjacentFiniteEdge C aux k L a σ τ hcompat hlist hP hdis g hk β V ρ cap) j z w).trans
      (physical_residue_visit_kernel_to_real L g β η V ρ hV cap j z w)
  · let j : Fin n := ⟨i / 2, by omega⟩
    have hi' : i = 2 * j.val + 1 := by dsimp [j]; omega
    rw [hi', finite_alternating_kernel_odd]
    exact (global_birth_finite_alternating_kernel_odd (physicalGroupBareFiniteActivity L g)
      (physicalGroupBareFiniteVisit L g β η V ρ hV cap)
      (physicalAdjacentFiniteEdge C aux k L a σ τ hcompat hlist hP hdis g hk β V ρ cap) j z w).trans
      (physical_adjacent_edge_kernel_to_real C aux k L a σ τ hstep hcompat hlist hP hdis g hk β V ρ cap j z w)

end ResiduePath
end Bounty
end

section

/- Exact physical history normalization under adjacent common-mark compatibility.
No global residue assignment is supplied; all original local rows and cutoffs remain. -/

open Finset
open scoped Classical
namespace Bounty

section ResiduePath
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (hcompat : ∀ j : Fin n, ∀ g s t,
    ((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val =
      ((physicalPermuteLabels (τ j) (L j.succ)) g t).val →
    (((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val : ℤ) ∣
      k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))

variable
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ) (η : Fin N → Fin (n + 1) → ℝ)
  (V ρ : Fin N → ℝ) (hV : ∀ g, V g ≠ 0) (cap : ℕ)


noncomputable def physicalJointAdjacentStep (i : ℕ) (g : Fin N) :
    GlobalBirthRawStep (R := fun p : ↥(P g) => ZMod p.val)
      (physicalGroupBareAtomicActivity L g i) (physicalGroupBareAtomicActivity L g (i + 1)) :=
  physicalGroupAdjacentFiniteStep C aux k L a σ τ hcompat hlist hP hdis
    g (fun j => hk j g) (β g) (η g) (V g) (ρ g) (hV g) cap i

variable [∀ g, ∀ p : ↥(P g), NeZero p.val]

/- All groups move simultaneously, with the total cutoff applied once to
all input memories and once to all output memories at each atomic step. -/
noncomputable def physicalJointAdjacentRawHistory : ℂ :=
  globalBirthJointRawHistory (fun i g => physicalGroupBareAtomicActivity L g i)
    (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β η V ρ hV cap)
    (fun _ => cap) (2 * n + 1)
    (fun s => if ∀ g, (s g).2.1 = 0 then 1 else 0)
    (globalBirthJointInitial (fun g => physicalGroupBareAtomicActivity L g 0))

/- Exact normalized physical residue trace across all groups. The total
memory cap and every local row cap remain in the literal joint kernels. -/
theorem physical_joint_adjacent_normalized_history_trace :
    ((∏ g, ∏ s : PhysicalSlots J ell, β g (L 0 g s) / V g : ℝ) : ℂ) *
      physicalJointAdjacentRawHistory C aux k L a σ τ hcompat hlist hP hdis hk β η V ρ hV cap =
    ∑ z : Fin (2 * n + 2) → (g : Fin N) → (p : ↥(P g)) → GhostPhaseState (ZMod p.val),
      ((∏ g, ∏ p, ghostPhaseTerminal (physicalGroupPhaseActivity (L (Fin.last n)) g p)
        (z (Fin.last (2 * n + 1)) g p) : ℝ) : ℂ) *
      (((∏ g, ∏ p, ghostPhaseRunInitial (physicalGroupPhaseActivity (L 0) g p)
        (β g p) (V g) (z 0 g p) : ℝ) : ℂ) *
        ∏ j : Fin (2 * n + 1), globalBirthJointHistoryKernel
          (fun i g => physicalGroupBareAtomicActivity L g i)
          (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β η V ρ hV cap)
          (fun _ => cap) j.val (z j.succ) (z j.castSucc)) := by
  have h := global_birth_joint_weighted_empty_history_product
    (fun i g => physicalGroupBareAtomicActivity L g i)
    (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β η V ρ hV cap)
    (fun _ => cap) (fun g p => β g p / V g) (2 * n + 1)
  simpa only [physicalJointAdjacentRawHistory, physical_group_bare_atomic_activity_initial,
    physical_group_bare_atomic_activity_terminal, physical_group_initial_tilt_eq_active,
    ghost_phase_run_initial_eq_tilted] using h

end ResiduePath
end Bounty
