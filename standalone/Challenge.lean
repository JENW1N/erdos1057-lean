section

/- Exact separation of original big path weights from small scalar factors. -/

open Finset
open scoped Classical
namespace Bounty
section Weights
variable {S G I V K : Type} [Fintype S] [Fintype G] [DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Type}
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : I → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : I → Type)
  (Δ D : ∀ _k : K, ∀ i, PhysicalSharedLists Ps J → SharedActiveLabels P (shared i) → A i → G → ℤ)
  (kbig : ∀ _k : K, ∀ i, SharedActiveLabels P (shared i) → A i → ℤ)
  (ω : ∀ i, SharedActiveLabels P (shared i) → A i → ℝ)
  (μ : ∀ g, P g → ℝ) (qghost : V → ℝ) (ρ : ℝ) (Vb : G → ℝ)
  (Vs : S → ℝ) (qedge : K → ℝ)

noncomputable def physicalMixedPlannedBigWeight (ks : List (Option (V ⊕ K))) L
    (pl : PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) ks) x
    (p : PhysicalMixedPlannedBigPath n shared B A Δ D ks L pl x) : ℝ :=
  let C := fun key : PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K) => shared key.2.1
  let Ab := fun (key : PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K)) (_ : SharedActiveLabels P (C key)) => A key.2.1
  let Δb := fun key c a => Δ key.1 key.2.1 (physicalSharedPrefix key.2.2.1) c a
  let Db := fun key c a => D key.1 key.2.1 (physicalSharedPrefix key.2.2.1) c a
  finiteEventPathWeight (FullPermutationMixedEvent n C B Ab Δb Db)
    (fullPermutationMixedEventTarget n C B Ab Δb Db)
    (fullPermutationMixedEventWeight n C B Ab Δb Db (fun key => ω key.2.1) μ qghost ρ Vb)
    (physicalMixedBigSteps ks L pl) x p

noncomputable def physicalMixedPlanSmallFactor (ks : List (Option (V ⊕ K))) (r : PhysicalResidues Ps) L
    (pl : PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) ks) x
    (p : PhysicalMixedPlannedBigPath n shared B A Δ D ks L pl x) : ℝ :=
  finiteEventPathWeight (PhysicalMixedWordEvent (ell := ell) n shared B A Δ D)
    (physicalMixedWordTarget n shared B A Δ D kbig)
    (physicalMixedSmallWeight n shared B A Δ D kbig Vs qedge) ks ((r, L), x)
    (physicalMixedPathPack n shared B A Δ D kbig ks r L x ⟨pl, p⟩)

theorem physical_mixed_planned_weight_factor (ks : List (Option (V ⊕ K))) r L
    (pl : PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) ks) x
    (p : PhysicalMixedPlannedBigPath n shared B A Δ D ks L pl x) :
    finiteEventPathWeight (PhysicalMixedWordEvent (ell := ell) n shared B A Δ D)
      (physicalMixedWordTarget n shared B A Δ D kbig)
      (physicalMixedWordWeight n shared B A Δ D kbig ω μ qghost ρ Vb Vs qedge) ks ((r, L), x)
      (physicalMixedPathPack n shared B A Δ D kbig ks r L x ⟨pl, p⟩) =
    physicalMixedPlanSmallFactor n shared B A Δ D kbig Vs qedge ks r L pl x p *
    physicalMixedPlannedBigWeight n shared B A Δ D ω μ qghost ρ Vb ks L pl x p := by
  induction ks generalizing r L x with
  | nil => simp only [physicalMixedPlanSmallFactor, physicalMixedPlannedBigWeight, physicalMixedBigSteps, finiteEventPathWeight, mul_one]
  | cons tag ks ih =>
    cases tag with
    | none =>
      rcases pl with ⟨σ, pl⟩
      rcases p with ⟨⟨τ⟩, p⟩
      simp only [physicalMixedPlanSmallFactor, physicalMixedPlannedBigWeight,
        physicalMixedPathPack, physicalMixedBigSteps, finiteEventPathWeight,
        physicalMixedWordWeight, physicalMixedSmallWeight,
        fullPermutationMixedEventWeight] at ih ⊢
      erw [ih]
      ring_nf
      rfl
    | some tag =>
      cases tag with
      | inl j =>
        rcases p with ⟨⟨e⟩, p⟩
        simp only [physicalMixedPlanSmallFactor, physicalMixedPlannedBigWeight,
          physicalMixedPathPack, physicalMixedBigSteps, finiteEventPathWeight,
          physicalMixedWordWeight, physicalMixedSmallWeight,
          fullPermutationMixedEventWeight, fullMixedMemoryEventWeight] at ih ⊢
        erw [ih]
        ring_nf
        rfl
      | inr k =>
        rcases pl with ⟨⟨i, R⟩, pl⟩
        rcases p with ⟨⟨a, e⟩, p⟩
        simp only [physicalMixedPlanSmallFactor, physicalMixedPlannedBigWeight,
          physicalMixedPathPack, physicalMixedBigSteps, finiteEventPathWeight,
          fullPermutationMixedEventWeight, fullMixedMemoryEventWeight] at ih ⊢
        rw [physical_mixed_word_edge_weight_factor]
        erw [ih]
        dsimp only [physicalMixedWordTarget, physicalSmallBigTarget,
          physicalSmallBigFullTarget, fullPermutationMixedEventTarget, fullMixedMemoryEventTarget,
          fullActiveFixedAuxEvent, fullActiveEdgeEventTarget]
        ring

end Weights
end Bounty
