    (fun a => (range (N + 2)).filter (fun j => a ∈ physicalMarkedPrimes (finitePathMarks L₀ p j)))
    (fun a j => -(physicalBareOffset C k (finitePathLabels p) (finitePathMarks L₀ p) (N + 1) j : ZMod a.2.val))
    (fun j => 1 - physicalEndpointSchedule q (N + 1) j)

theorem physical_finite_residue_expectation_nonneg {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ} {patterns : Finset I}
