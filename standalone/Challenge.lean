section

/- The actual bounded edge skeleton has the existing damping and length cost before fresh masses are inserted. -/

open Finset Classical

namespace Bounty

theorem unrestricted_bounded_skeleton_length_cost {P : Type*}
    (n : P → ℕ) (Δ D : ℤ) (ρ V v : ℝ)
    (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1) (hV : 0 ≤ V) (hv : 0 < v)
    (t B : ℕ) (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (sk : UnrestrictedLocalEdgeSkeleton n Δ D t B s) :
    |unrestrictedBoundedSkeletonMass n Δ D ρ V t B s sk.1 sk.2.1 sk.2.2| *
      v ^ unrestrictedSkeletonOutputCount n Δ D t B s sk ≤
    (ρ ^ ((unrestrictedResidueEligible n Δ D s.2.2).card - sk.2.1.card) / V ^ sk.2.1.card) *
      (v ^ s.2.1.val * (v ^ sk.1.card / v ^ sk.2.1.card)) := by
  have hout : v ^ (unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
      (unrestrictedResidueTransport n Δ) sk.1 sk.2.1 sk.2.2).1 =
      v ^ s.2.1.val * (v ^ sk.1.card / v ^ sk.2.1.card) := by
    simpa only [unrestrictedEdgeOutput, Fintype.card_coe] using
      unrestrictedEdgeMemory_weight s.2.2 (unrestrictedResidueTransport n Δ)
        (unrestrictedStoredTuple s.1 (unrestrictedResidueSeed n) sk.1) sk.2.2 hv.ne'
  have hdamp : ρ ^ orderedPredicateCount ⟨s.2.1.val, s.2.2⟩ unrestrictedResidueHit *
      ρ ^ orderedPredicateCount (unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
        (unrestrictedResidueTransport n Δ) sk.1 sk.2.1 sk.2.2) unrestrictedResidueHit ≤
      ρ ^ ((unrestrictedResidueEligible n Δ D s.2.2).card - sk.2.1.card) := by
    simpa only [unrestrictedEdgeOutput, Fintype.card_coe] using
      unrestrictedEdgeMemory_two_damping_le s.2.2 (unrestrictedResidueTransport n Δ)
        (unrestrictedStoredTuple s.1 (unrestrictedResidueSeed n) sk.1) unrestrictedResidueHit sk.2.2
        (unrestrictedResidueEligible_translated_hit n Δ D s.2.2) hρ0 hρ1
  rw [abs_of_nonneg (unrestricted_bounded_skeleton_mass_nonneg n Δ D ρ V hρ0 hV t B s sk.1 sk.2.1 sk.2.2)]
  by_cases hc : unrestrictedResidueStorageAllowed n D s.1 sk.1 ∧
      (unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
        (unrestrictedResidueTransport n Δ) sk.1 sk.2.1 sk.2.2).1 ≤ B
  · simp only [unrestrictedBoundedSkeletonMass, hc, if_true, unrestrictedSkeletonOutputCount]
    rw [hout]
    exact mul_le_mul_of_nonneg_right
      (div_le_div_of_nonneg_right hdamp (pow_nonneg hV _))
      (mul_nonneg (pow_nonneg hv.le _) (div_nonneg (pow_nonneg hv.le _) (pow_nonneg hv.le _)))
  · simp only [unrestrictedBoundedSkeletonMass, hc, if_false, zero_mul]
    exact mul_nonneg (div_nonneg (pow_nonneg hρ0 _) (pow_nonneg hV _))
      (mul_nonneg (pow_nonneg hv.le _) (div_nonneg (pow_nonneg hv.le _) (pow_nonneg hv.le _)))

end Bounty
end

