open Finset






























/- An atomic actual phase transition, selected from a visit or an edge. -/
noncomputable def ghostPhaseMixedStep {R : Type*} [Fintype R] [DecidableEq R]
    (isVisit atgt asrc : Bool) (htgt hsrc : R) (η β : ℝ)
    (z w : GhostPhaseState R) : ℝ :=
  if isVisit then ghostPhaseVisit atgt htgt η β z w
  else ghostPhaseEdge atgt asrc htgt hsrc β z w












