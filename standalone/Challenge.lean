    ((Ioc lo hi).filter (fun n =>
      (typeIIRestrict (Ioc lo hi) (ambientPrimeTypeIIAlpha κM L S) n : ℂ) ≠ 0)) F
    δ α β γ Bcoeff 1 1 (L^(C+B)) (zero_le_one.trans hBcoeff) zero_le_one zero_le_one
