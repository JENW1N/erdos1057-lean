section

/- Repeated physical lists in the flat group-slot coordinates of the
asymmetric kernel. The shared set contains precisely the first-block slots
outside the cut; all remaining coordinates retain their actual label law. -/

open Finset Classical

namespace Bounty

abbrev RepeatedBigFlatIndex (G : Type*) (J ell : ℕ) :=
  Sigma (fun _ : G => PhysicalSlots J ell)

def repeatedBigFlatEquiv {G : Type*} (P : G → Finset ℕ) (J ell : ℕ) :
    RepeatedBigLists P J ell ≃ (∀ i : RepeatedBigFlatIndex G J ell, P i.1) :=
  finiteGroupFlattenEquiv







def repeatedBigFlatActive {G : Type*} [Fintype G] (J ell : ℕ) :
    Finset (RepeatedBigFlatIndex G J ell) :=
  univ.sigma (fun _ => (univ : Finset (Fin J)).map Function.Embedding.inl)

def repeatedBigFlatShared {G : Type*} [Fintype G] {J ell : ℕ}
    (C : G → Finset (Fin J)) : Finset (RepeatedBigFlatIndex G J ell) :=
  univ.sigma (fun g => physicalSharedSlots (ell := ell) (C g))




theorem repeatedBigFlatActive_mem_inl {G : Type*} [Fintype G] (J ell : ℕ)
    (g : G) (j : Fin J) : (⟨g, Sum.inl j⟩ : RepeatedBigFlatIndex G J ell) ∈ repeatedBigFlatActive J ell := by
  simp [repeatedBigFlatActive]

theorem repeatedBigFlatActive_not_mem_inr {G : Type*} [Fintype G] (J ell : ℕ)
    (g : G) (j : Fin ell) : (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ repeatedBigFlatActive J ell := by
  simp [repeatedBigFlatActive]

section

variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  {J ell : ℕ}
  (C : G → Finset (Fin J))
  (g : G)

include G sharedInstance1 J ell C g

theorem repeatedBigFlatShared_mem_iff  (s : PhysicalSlots J ell) :
    (⟨g, s⟩ : RepeatedBigFlatIndex G J ell) ∈ repeatedBigFlatShared C ↔
      ¬ repeatedBigUnshared C g s := by
  cases s <;> simp [repeatedBigFlatShared, physicalSharedSlots, repeatedBigUnshared]

theorem repeatedBigFlatShared_mem_inl  (j : Fin J) :
    (⟨g, Sum.inl j⟩ : RepeatedBigFlatIndex G J ell) ∈ repeatedBigFlatShared C ↔ j ∉ C g := by
  simp only [repeatedBigFlatShared_mem_iff, repeatedBigUnshared]

theorem repeatedBigFlatShared_not_mem_inr  (j : Fin ell) :
    (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ repeatedBigFlatShared C := by
  simp only [repeatedBigFlatShared_mem_iff, repeatedBigUnshared, not_true_eq_false, not_false_eq_true]

end











section

variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  {P : G → Finset ℕ}
  {J ell : ℕ}

include G sharedInstance1 P J ell

theorem repeated_big_shared_compatible_flat  (C : G → Finset (Fin J))
    (source target : RepeatedBigLists P J ell) :
    repeatedBigSharedCompatible C source target ↔
      finiteSharedCompatible (repeatedBigFlatShared C)
        (repeatedBigFlatEquiv P J ell source) (repeatedBigFlatEquiv P J ell target) := by
  constructor
  · intro h i hi
    rcases i with ⟨g, j | j⟩
    · exact h g j ((repeatedBigFlatShared_mem_inl C g j).mp hi)
    · exact False.elim (repeatedBigFlatShared_not_mem_inr C g j hi)
  · intro h g j hj
    exact h ⟨g, Sum.inl j⟩ ((repeatedBigFlatShared_mem_inl C g j).mpr hj)

theorem repeated_big_active_mass_flat_tilted  (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (source : RepeatedBigLists P J ell) :
    repeatedBigActiveMass V b source =
      finiteProductWeight (fun i : RepeatedBigFlatIndex G J ell => tiltedPhysicalBirthLaw V i.1 (b i.1))
        (repeatedBigFlatEquiv P J ell source) := by
  exact (finite_product_weight_flatten (fun g => tiltedPhysicalBirthLaw V g (b g)) source).symm

theorem repeated_big_active_mass_flat  (V : G → ℝ) (source : RepeatedBigLists P J ell) :
    repeatedBigActiveMass V (fun _ _ => 1) source =
      finiteProductWeight (fun i : RepeatedBigFlatIndex G J ell => physicalLabelLaw V i.1)
        (repeatedBigFlatEquiv P J ell source) := by
  have hlaw : (fun i : RepeatedBigFlatIndex G J ell => tiltedPhysicalBirthLaw (P := P) V i.1 (fun _ => 1)) =
      (fun i : RepeatedBigFlatIndex G J ell => physicalLabelLaw (P := P) V i.1) := by
    funext i p
    exact div_one _
  simpa only [hlaw] using repeated_big_active_mass_flat_tilted V (fun _ _ => 1) source

end


theorem repeated_big_target_mass_flat_tilted {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (target : RepeatedBigLists P J ell) :
    repeatedBigTargetMass V b C target =
      finiteFreshMass (fun i : RepeatedBigFlatIndex G J ell => tiltedPhysicalBirthLaw V i.1 (b i.1))
        (repeatedBigFlatShared C) (repeatedBigFlatEquiv P J ell target) := by
  symm
  unfold finiteFreshMass
  have hset : (repeatedBigFlatShared (ell := ell) C)ᶜ =
      univ.sigma (fun g => univ.filter (repeatedBigUnshared (ell := ell) C g)) := by
    ext ⟨g, s⟩
    simp [repeatedBigFlatShared_mem_iff]
  rw [hset, prod_sigma]
  unfold repeatedBigTargetMass
  apply prod_congr rfl
  intro g _
  exact prod_subtype (univ.filter (repeatedBigUnshared C g)) (fun s => by simp)
    (fun s => tiltedPhysicalBirthLaw V g (b g) (target g s))

theorem repeated_big_target_mass_flat {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ)
    (C : G → Finset (Fin J)) (target : RepeatedBigLists P J ell) :
    repeatedBigTargetMass V (fun _ _ => 1) C target =
      finiteFreshMass (fun i : RepeatedBigFlatIndex G J ell => physicalLabelLaw V i.1)
        (repeatedBigFlatShared C) (repeatedBigFlatEquiv P J ell target) := by
  have hlaw : (fun i : RepeatedBigFlatIndex G J ell => tiltedPhysicalBirthLaw (P := P) V i.1 (fun _ => 1)) =
      (fun i : RepeatedBigFlatIndex G J ell => physicalLabelLaw (P := P) V i.1) := by
    funext i p
    exact div_one _
  simpa only [hlaw] using repeated_big_target_mass_flat_tilted V (fun _ _ => 1) C target

theorem repeated_big_flat_shared_prod {G H : Type*} [Fintype G] [CommMonoid H]
    {J ell : ℕ} (C : G → Finset (Fin J)) (F : G → PhysicalSlots J ell → H) :
    (∏ g, ∏ j ∈ univ \ C g, F g (Sum.inl j)) =
      ∏ i : repeatedBigFlatShared (ell := ell) C, F i.val.1 i.val.2 := by
  refine Eq.trans ?_ (prod_coe_sort (repeatedBigFlatShared (ell := ell) C)
    (fun i : RepeatedBigFlatIndex G J ell => F i.1 i.2)).symm
  rw [repeatedBigFlatShared, prod_sigma]
  apply prod_congr rfl
  intro g _
  exact (prod_map _ Function.Embedding.inl (F g)).symm

theorem repeated_big_shared_label_product_flat {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (source : RepeatedBigLists P J ell) :
    (∏ g, ∏ j ∈ univ \ C g, (source g (Sum.inl j)).val) =
      ∏ i : repeatedBigFlatShared (ell := ell) C,
        (repeatedBigFlatEquiv P J ell source i.val).val :=
  repeated_big_flat_shared_prod C (fun g s => (source g s).val)

end Bounty
end

section

/- Omitting a fixed prefix of pure Q bands costs only a fixed harmonic factor. -/

open Finset Filter
open scoped Topology

namespace Bounty

theorem exists_candidate_micro_Q_harmonic_comparison {c : ℝ} (hc : 0 < c) (r J : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, J ≤ jStar →
      candidateMicroQHarmonicMass c L r jStar J ≤ C * candidateQHarmonicMass c L r jStar := by
  obtain ⟨v, V, hv, _, hbands⟩ := exists_candidateQBands_bounds hc
  let u := min 1 (v^r / (r.factorial : ℝ))
  have hu0 : 0 < u := lt_min (by norm_num) (by positivity)
  have hu1 : u ≤ 1 := min_le_left _ _
  refine ⟨1/u^J, by positivity, ?_⟩
  filter_upwards [hbands] with L hL
  intro jStar hjStar
  let S := (candidateQIndices c L).filter (fun j => j < J)
  have hcard : S.card ≤ J := by
    have hsub : S ⊆ range J := fun j hj => mem_range.mpr (mem_filter.mp hj).2
    simpa only [card_range] using card_le_card hsub
  have hlocal : ∀ j ∈ S, u ≤ candidateQBandHarmonicFactor c L r jStar j := by
    intro j hj
    have hjs := (mem_filter.mp hj).2
    have hjQ := (mem_filter.mp hj).1
    rw [candidate_Q_band_factor_pure c L r jStar j (by omega)]
    apply (min_le_right _ _).trans
    exact div_le_div_of_nonneg_right
      (pow_le_pow_left₀ hv.le (hL.2.2 j hjQ).2.2.1 r) (Nat.cast_nonneg _)
  have hprefix : u^J ≤ ∏ j ∈ S, candidateQBandHarmonicFactor c L r jStar j := by
    calc
      _ ≤ u^S.card := pow_le_pow_of_le_one hu0.le hu1 hcard
      _ = ∏ _j ∈ S, u := (prod_const u).symm
      _ ≤ _ := Finset.prod_le_prod₀ (fun _ _ => hu0.le) hlocal
  have hmass := mul_le_mul_of_nonneg_right hprefix (candidate_micro_Q_harmonic_nonneg c L r jStar J)
  rw [show (∏ j ∈ S, candidateQBandHarmonicFactor c L r jStar j) *
      candidateMicroQHarmonicMass c L r jStar J = candidateQHarmonicMass c L r jStar from
    (candidate_Q_harmonic_split_micro c L r jStar J).symm] at hmass
  calc
    _ ≤ candidateQHarmonicMass c L r jStar / u^J :=
      (le_div_iff₀ (pow_pos hu0 _)).mpr (by simpa only [mul_comm] using hmass)
    _ = _ := by ring

end Bounty
end

section

/- Actual microscopic Q-slot and P-mark assignments with full normalization. -/

open Finset Filter
open scoped Topology

namespace Bounty

noncomputable def candidateMicroAssignmentChoices (c L : ℝ) (r jStar J : ℕ) :
    ((candidateMicroQIndices c L J) × Fin r) ⊕ (candidatePIndices c L) → Finset ℕ :=
  Sum.elim (candidateMicroQSlotChoices c L r jStar J)
    (fun g => candidatePBand (c*L) g.val)

noncomputable def candidateMicroAssignmentNormalization (c L : ℝ) (r J : ℕ) : ℝ :=
  (r.factorial : ℝ)^(candidateMicroQIndices c L J).card *
    ∏ g ∈ candidatePIndices c L, ∑ p ∈ candidatePBand (c*L) g, 1/(p : ℝ)

noncomputable def candidateMicroAssignmentWeight (c L : ℝ) (r jStar J n : ℕ) : ℝ :=
  orderedSlotWeight (candidateMicroAssignmentChoices c L r jStar J)
    (candidateMicroAssignmentNormalization c L r J) n







section

variable
  (c L : ℝ)
  (r jStar J : ℕ)
  (hP : ∀ g ∈ candidatePIndices c L, (∑ p ∈ candidatePBand (c*L) g, 1/(p : ℝ)) ≠ 0)

include c L r jStar J hP

theorem candidate_micro_assignment_harmonic_eq  :
    (∑' n : ℕ, candidateMicroAssignmentWeight c L r jStar J n / (n : ℝ)) =
      candidateMicroQHarmonicMass c L r jStar J := by
  classical
  have hprod : (∏ g ∈ candidatePIndices c L, ∑ p ∈ candidatePBand (c*L) g, 1/(p : ℝ)) ≠ 0 :=
    prod_ne_zero_iff.mpr hP
  unfold candidateMicroAssignmentWeight candidateMicroQHarmonicMass candidateMicroQWeight
  rw [ordered_slot_harmonic_sum, ordered_slot_harmonic_sum, Fintype.prod_sum_type]
  simp only [candidateMicroAssignmentChoices, Sum.elim_inl, Sum.elim_inr,
    candidateMicroAssignmentNormalization]
  have hPprod : (∏ g : candidatePIndices c L, ∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ)) =
      ∏ g ∈ candidatePIndices c L, ∑ p ∈ candidatePBand (c*L) g, 1/(p : ℝ) :=
    prod_coe_sort (candidatePIndices c L) (fun g : ℕ => ∑ p ∈ candidatePBand (c*L) g, 1/(p : ℝ))
  rw [hPprod]
  field_simp

theorem candidate_micro_assignment_reciprocal_sum  :
    (∑ x : ∀ i, candidateMicroAssignmentChoices c L r jStar J i,
      (1 / candidateMicroAssignmentNormalization c L r J) /
        (orderedSlotProduct (candidateMicroAssignmentChoices c L r jStar J) x : ℝ)) =
      candidateMicroQHarmonicMass c L r jStar J := by
  classical
  rw [← candidate_micro_assignment_harmonic_eq c L r jStar J hP]
  unfold candidateMicroAssignmentWeight orderedSlotWeight
  simp only [Finset.sum_div]
  rw [Summable.tsum_finsetSum]
  · apply Finset.sum_congr (by ext; simp)
    intro x _
    simp_rw [ite_div, zero_div]
    rw [tsum_ite_eq']
  · intro x _
    apply (hasSum_single (orderedSlotProduct (candidateMicroAssignmentChoices c L r jStar J) x) ?_).summable
    intro n hn
    simp [Ne.symm hn]

end


theorem eventually_candidate_micro_assignment_normalization {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ r jStar J : ℕ,
      0 < candidateMicroAssignmentNormalization c L r J ∧
      (∑ x : ∀ i, candidateMicroAssignmentChoices c L r jStar J i,
        (1 / candidateMicroAssignmentNormalization c L r J) /
          (orderedSlotProduct (candidateMicroAssignmentChoices c L r jStar J) x : ℝ)) =
        candidateMicroQHarmonicMass c L r jStar J := by
  obtain ⟨v, V, hv, _, hpool⟩ := exists_candidate_P_pool_bounds hc
  filter_upwards [hpool] with L hL
  rcases hL with ⟨_, _, _, _, _, hdata⟩
  have hP : ∀ g ∈ candidatePIndices c L, 0 < ∑ p ∈ candidatePBand (c*L) g, 1/(p : ℝ) :=
    fun g hg => hv.trans_le (hdata g hg).1
  intro r jStar J
  refine ⟨?_, candidate_micro_assignment_reciprocal_sum c L r jStar J (fun g hg => (hP g hg).ne')⟩
  unfold candidateMicroAssignmentNormalization
  exact mul_pos (by positivity) (prod_pos hP)

end Bounty
end

section

/- Local birth data retain ghost residues and distinguish fresh edge labels. -/

open scoped Classical

namespace Bounty

abbrev FullMixedBornData {N : ℕ} {P : Fin N → Type*}
    (n : (g : Fin N) → P g → ℕ) :=
  ((g : Fin N) × UnrestrictedResidueParticle (n g)) ⊕ ((g : Fin N) × P g)

def fullMixedBornPrime {N : ℕ} {P : Fin N → Type*}
    (n : (g : Fin N) → P g → ℕ) : FullMixedBornData n → ((g : Fin N) × P g)
  | .inl d => ⟨d.1, d.2.1⟩
  | .inr d => d

section Events

variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
    (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
    (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)

noncomputable def fullMixedEventBornData :
    (tag : Option (J ⊕ K)) →
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) →
    FullPermutationMixedEvent n S B A Δ D tag s →
    FullMixedLocalBirthAddress S B tag → Option (FullMixedBornData n)
  | none, _, _, a => Fin.elim0 a.2
  | some (.inl _), _, e, ⟨g, i⟩ =>
      if h : i.val < (e.down g).1.val then
        some (.inl ⟨g, (e.down g).2.2 ⟨i.val, h⟩⟩)
      else none
  | some (.inr _), _, e, ⟨g, i⟩ =>
      if h : i ∈ (e.2 g).2.1 then none
      else some (.inr ⟨g, (e.2 g).2.2.2 ⟨i, h⟩⟩)

noncomputable def fullMixedEventBirthLabel (tag : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag s)
    (a : FullMixedLocalBirthAddress S B tag) : Option ((g : Fin N) × P g) :=
  (fullMixedEventBornData n S B A Δ D tag s e a).map (fullMixedBornPrime n)

noncomputable def fullMixedEventBirthPerformed (tag : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag s)
    (a : FullMixedLocalBirthAddress S B tag) : Prop :=
  (fullMixedEventBornData n S B A Δ D tag s e a).isSome = true

theorem full_mixed_ghost_born_data (j : J)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (some (.inl j)) s)
    (g : Fin N) (i : Fin B) (hi : i.val < (e.down g).1.val) :
    fullMixedEventBornData n S B A Δ D (some (.inl j)) s e ⟨g, i⟩ =
      some (.inl ⟨g, (e.down g).2.2 ⟨i.val, hi⟩⟩) := by
  simp only [fullMixedEventBornData, dif_pos hi]

theorem full_mixed_ghost_birth_performed_iff (j : J)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (some (.inl j)) s)
    (g : Fin N) (i : Fin B) :
    fullMixedEventBirthPerformed n S B A Δ D (some (.inl j)) s e ⟨g, i⟩ ↔
      i.val < (e.down g).1.val := by
  simp only [fullMixedEventBirthPerformed, fullMixedEventBornData]
  split_ifs <;> simp_all

theorem full_mixed_edge_born_data (k : K)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent (J := J) n S B A Δ D (some (.inr k)) s)
    (g : Fin N) (i : Fin (S k g)ᶜ.card) (hi : i ∉ (e.2 g).2.1) :
    fullMixedEventBornData n S B A Δ D (some (.inr k)) s e ⟨g, i⟩ =
      some (.inr ⟨g, (e.2 g).2.2.2 ⟨i, hi⟩⟩) := by
  simp only [fullMixedEventBornData]
  split_ifs with h
  · exact (hi h).elim
  · rfl

theorem full_mixed_edge_birth_performed_iff (k : K)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent (J := J) n S B A Δ D (some (.inr k)) s)
    (g : Fin N) (i : Fin (S k g)ᶜ.card) :
    fullMixedEventBirthPerformed n S B A Δ D (some (.inr k)) s e ⟨g, i⟩ ↔
      i ∉ (e.2 g).2.1 := by
  simp only [fullMixedEventBirthPerformed, fullMixedEventBornData]
  split_ifs with h
  · constructor
    · intro hf
      cases hf
    · intro hn
      exact (hn h).elim
  · constructor
    · intro _
      exact h
    · intro _
      rfl




end Events

end Bounty
end

section

/- Removing the deterministic ledger preserves every owning full event. -/

namespace Bounty

theorem finite_ledger_event_path_occurrence
    {K L X : Type*} (E : K → X → Type*) (target : ∀ k x, E k x → X)
    (update : ∀ k, L → (x : X) → E k x → L)
    (steps : List K) (l : L) (x : X)
    (p : FiniteEventPath (fun k (s : L × X) => E k s.2)
      (finiteLedgerEventTarget E target update) steps (l, x)) (i : Fin steps.length) :
    (let e := finiteEventPathOccurrence (fun k (s : L × X) => E k s.2)
      (finiteLedgerEventTarget E target update) steps (l, x) p i
     (⟨e.1.2, e.2⟩ : Σ y, E (steps.get i) y)) =
    finiteEventPathOccurrence E target steps x
      (finiteLedgerEventPathEquiv E target update steps l x p) i := by
  induction steps generalizing l x with
  | nil => exact Fin.elim0 i
  | cons k steps ih =>
    rcases p with ⟨e, p⟩
    refine Fin.cases ?_ (fun j => ?_) i
    · rfl
    · exact ih (update k l x e) (target k x e) p j

end Bounty
end

section

/- Kernel pairings give the projected norm of the literal finite row action. -/

open Finset
open scoped Classical

namespace Bounty

theorem clean_kernel_pairing_sub_kernel {X Y : Type*} [Fintype X] [Fintype Y]
    (w : X → ℝ) (K H : X → Y → ℂ) (f : X → ℂ) (g : Y → ℂ) :
    cleanKernelPairing w (K - H) f g =
      cleanKernelPairing w K f g - cleanKernelPairing w H f g := by
  simp only [cleanKernelPairing, Pi.sub_apply, mul_sub, sub_mul, sum_sub_distrib]

theorem clean_kernel_pairing_row_action {X Y : Type*} [Fintype X] [Fintype Y]
    (w : X → ℝ) (K : X → Y → ℂ) (f : X → ℂ) (g : Y → ℂ) :
    cleanKernelPairing w K f g =
      ∑ x, (w x : ℂ) * (starRingEnd ℂ) (f x) * (∑ y, K x y * g y) := by
  simp only [cleanKernelPairing, mul_sum, mul_assoc]

theorem repeated_big_kernel_norm_le_of_bilinear {G : Type*}
    [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (hV : ∀ g, 0 ≤ V g)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → ℂ)
    {M : ℝ} (hM : 0 ≤ M)
    (hpair : ∀ f v : RepeatedBigLists P J ell → ℂ,
      f ∈ repeatedBigSymmetricSubspace → v ∈ repeatedBigSymmetricSubspace →
      ‖cleanKernelPairing (repeatedBigActiveMass V (fun _ _ => 1)) K f v‖ ≤
        M * cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f *
          cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) v)
    (v : RepeatedBigLists P J ell → ℂ) (hv : v ∈ repeatedBigSymmetricSubspace) :
    cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
      (repeatedBigSymmetrizeLinear (fun x => ∑ y, K x y * v y)) ≤
      M * cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) v := by
  apply repeated_big_untilted_operator_norm_le_of_symmetric_pairing V hV _ hM _ v hv
  intro f g hf hg
  rw [← clean_kernel_pairing_row_action]
  exact hpair f g hf hg

end Bounty
end

section

/- A chronological finite enumeration of the existing potential birth addresses. -/

namespace Bounty

variable {J K : Type*} {N : ℕ} {M : Fin N → ℕ}
