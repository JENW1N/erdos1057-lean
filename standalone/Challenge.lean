  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ g s, ¬ ((L g s).val : ℤ) ∣ k)
  (β : (g : Fin N) → ↥(P g) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

noncomputable def physicalJointBareEdgeStep
    (hcompat : ∀ g s t, (L g s).val = (R g t).val →
      ((L g s).val : ℤ) ∣ k * (physicalD C L aux : ℤ)) (g : Fin N) :
    GlobalBirthRawStep (R := fun p : ↥(P g) => ZMod p.val)
      (physicalGroupPhaseActivity L g) (physicalGroupPhaseActivity R g) :=
  physicalGroupBareRawEdge C aux k L R 0 hlist hP hdis hcompat g (hk g) (β g) ρ (V g) B

theorem physical_raw_tensor_eq_bare_step
    (hcompat : ∀ g s t, (L g s).val = (R g t).val →
      ((L g s).val : ℤ) ∣ k * (physicalD C L aux : ℤ))
    (F : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ)
    (s : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val)) :
    jointRawTensorCutoff B (physicalFullEdgeRawRow (B := B) C k L R β ρ V aux) F s =
      globalBirthJointCutRawRow
        (physicalJointBareEdgeStep (B := B) C aux k L R hlist hP hdis hk β ρ V hcompat) B B F s := by
  have hr : (fun g (K : GlobalBirthHistoryState (fun p : ↥(P g) => ZMod p.val) → ℂ)
      (u : GlobalBirthHistoryState (fun p : ↥(P g) => ZMod p.val)) =>
        globalBirthRawStepRow
          (physicalJointBareEdgeStep (B := B) C aux k L R hlist hP hdis hk β ρ V hcompat g)
          (fun H q => K (H, q)) u.1 u.2) =
      physicalFullEdgeRawRow (B := B) C k L R β ρ V aux := by
    funext g K u
    unfold physicalJointBareEdgeStep
    rw [physical_group_bare_raw_edge_row]
    have hd := physical_group_phase_delta_as_integer_step (P := P)
      0 (0 + k * (physicalD C L aux : ℤ)) k (physicalD C L aux : ℤ) rfl g
    rw [hd]
    rfl
  unfold jointRawTensorCutoff globalBirthJointCutRawRow globalBirthJointRawRow
  rw [hr]

include hlist in
theorem physical_raw_tensor_zero_of_bad_edge
    (hbad : ¬ ∀ g s t, (L g s).val = (R g t).val →
      ((L g s).val : ℤ) ∣ k * (physicalD C L aux : ℤ))
    (F : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ)
    (s : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val))
    (hs : GlobalBirthJointCoherent (fun g => physicalGroupPhaseActivity L g) s) :
    jointRawTensorCutoff B (physicalFullEdgeRawRow (B := B) C k L R β ρ V aux) F s = 0 := by
  push Not at hbad
  obtain ⟨g, i, j, he, hn⟩ := hbad
  unfold jointRawTensorCutoff globalBirthJointRawCutoff
  split_ifs
  · refine fin_tensor_row_zero_at N _ s ?_ g ?_ _
    · intro h
      simpa only [zero_mul] using
        physical_full_edge_raw_row_mul (B := B) C k L R β ρ V aux h 0 (fun _ => 0) (s h)
    · intro K
      exact physical_full_edge_raw_zero_of_bad_common_mark C aux k L R hlist β ρ V
        g i j he hn (s g) (hs g) K
  · rfl

include hlist hP hdis hk in
theorem physical_raw_tensor_coherent_congr
    [∀ g, ∀ p : ↥(P g), NeZero p.val]
    (F G : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ)
    (hFG : ∀ t, GlobalBirthJointCoherent (fun g => physicalGroupPhaseActivity R g) t → F t = G t)
    (s : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val))
    (hs : GlobalBirthJointCoherent (fun g => physicalGroupPhaseActivity L g) s) :
    jointRawTensorCutoff B (physicalFullEdgeRawRow (B := B) C k L R β ρ V aux) F s =
      jointRawTensorCutoff B (physicalFullEdgeRawRow (B := B) C k L R β ρ V aux) G s := by
  by_cases hc : ∀ g i j, (L g i).val = (R g j).val →
      ((L g i).val : ℤ) ∣ k * (physicalD C L aux : ℤ)
  · rw [physical_raw_tensor_eq_bare_step C aux k L R hlist hP hdis hk β ρ V hc,
      physical_raw_tensor_eq_bare_step C aux k L R hlist hP hdis hk β ρ V hc]
    exact global_birth_joint_cut_raw_row_congr _ B B F G hFG s hs
  · rw [physical_raw_tensor_zero_of_bad_edge C aux k L R hlist β ρ V hc F s hs,
      physical_raw_tensor_zero_of_bad_edge C aux k L R hlist β ρ V hc G s hs]

