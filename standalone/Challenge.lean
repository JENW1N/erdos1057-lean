open scoped BigOperators
theorem finite_geometric_sum_le {ι : Type*} [Fintype ι]
    (x y : ι → ℝ) (hx : ∀ i, 0 ≤ x i) (hy : ∀ i, 0 ≤ y i)
    {θ : ℝ} (hθ : 0 < θ) (hθ1 : θ < 1) :
    ∑ i, (x i) ^ θ * (y i) ^ (1 - θ) ≤
      (∑ i, x i) ^ θ * (∑ i, y i) ^ (1 - θ) := by
  have hconj : (1 / θ).HolderConjugate (1 / (1 - θ)) := by
    rw [Real.holderConjugate_iff]
    constructor
    · exact (lt_div_iff₀ hθ).2 (by linarith)
    · simp
  have h := Real.inner_le_Lp_mul_Lq_of_nonneg Finset.univ hconj
    (fun i _ => Real.rpow_nonneg (hx i) θ)
    (fun i _ => Real.rpow_nonneg (hy i) (1 - θ))
  have hxpow (i : ι) : ((x i) ^ θ) ^ (1 / θ) = x i := by
    rw [← Real.rpow_mul (hx i), mul_one_div_cancel hθ.ne', Real.rpow_one]
  have hypow (i : ι) : ((y i) ^ (1 - θ)) ^ (1 / (1 - θ)) = y i := by
    rw [← Real.rpow_mul (hy i), mul_one_div_cancel (by linarith : 1 - θ ≠ 0),
      Real.rpow_one]
  simpa only [hxpow, hypow, one_div_one_div] using h

theorem finite_block_holder {ι : Type*} [Fintype ι]
    (g f d : ι → ℝ) (hg : ∀ i, 0 ≤ g i) (hf : ∀ i, 0 ≤ f i)
    (hd : ∀ i, 0 ≤ d i) {θ : ℝ} (hθ : 0 < θ) (hθ1 : θ < 1) :
    ∑ i, g i * (f i) ^ θ * (d i) ^ ((1 - θ) / 2) ≤
      (∑ i, (g i) ^ 2) ^ (1 / 2 : ℝ) *
      (∑ i, (f i) ^ 2) ^ (θ / 2) * (∑ i, d i) ^ ((1 - θ) / 2) := by
  have hconj : (2 : ℝ).HolderConjugate 2 := by
    rw [Real.holderConjugate_iff]
    norm_num
  have hcs := Real.inner_le_Lp_mul_Lq_of_nonneg Finset.univ hconj
    (fun i _ => hg i)
    (fun i _ => mul_nonneg (Real.rpow_nonneg (hf i) θ)
      (Real.rpow_nonneg (hd i) ((1 - θ) / 2)))
  have hpower (i : ι) : ((f i) ^ θ * (d i) ^ ((1 - θ) / 2)) ^ (2 : ℝ) =
      ((f i) ^ 2) ^ θ * (d i) ^ (1 - θ) := by
    rw [Real.mul_rpow (Real.rpow_nonneg (hf i) θ)
      (Real.rpow_nonneg (hd i) ((1 - θ) / 2)),
      ← Real.rpow_mul (hf i), ← Real.rpow_mul (hd i)]
    rw [show (1 - θ) / 2 * 2 = 1 - θ by ring]
    congr 1
    rw [← Real.rpow_natCast, ← Real.rpow_mul (hf i)]
    congr 1
    ring
  simp only [hpower, Real.rpow_two] at hcs
  have hgeom := finite_geometric_sum_le (fun i => (f i) ^ 2) d
    (fun i => sq_nonneg _) hd hθ hθ1
  have hmono := Real.rpow_le_rpow
    (Finset.sum_nonneg (fun i _ => mul_nonneg (Real.rpow_nonneg (sq_nonneg _) θ)
      (Real.rpow_nonneg (hd i) (1 - θ)))) hgeom (by norm_num : (0 : ℝ) ≤ 1 / 2)
  have hmul := mul_le_mul_of_nonneg_left hmono
    (Real.rpow_nonneg (show 0 ≤ ∑ i, (g i) ^ 2 from
      Finset.sum_nonneg (fun i _ => sq_nonneg (g i))) (1 / 2))
  have hx : 0 ≤ ∑ i, (f i) ^ 2 := Finset.sum_nonneg (fun i _ => sq_nonneg _)
  have hy : 0 ≤ ∑ i, d i := Finset.sum_nonneg (fun i _ => hd i)
  rw [Real.mul_rpow (Real.rpow_nonneg hx θ) (Real.rpow_nonneg hy (1 - θ)),
    ← Real.rpow_mul hx, ← Real.rpow_mul hy] at hmul
  simp only [mul_one_div] at hmul
  simpa only [mul_assoc] using hcs.trans hmul
end

section
open scoped BigOperators InnerProductSpace
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
  [FiniteDimensional ℂ E]

theorem finite_pairing_gram_bound {ι : Type*} [Fintype ι]
    (A : E →ₗ[ℂ] E) (f g : E) (c : ι → ℂ) (u : ι → E)
    (hf : f = ∑ i, c i • u i) {C : ℝ} (hC : ∑ i, ‖c i‖ ^ 2 ≤ C)
    {R : ℕ} (hR : 1 ≤ R) :
    ‖inner ℂ f (A g)‖ ≤
      C ^ (1 / (2 * (R : ℝ))) *
        (‖g‖ * ‖f‖ ^ (1 - 1 / (R : ℝ)) *
          (∑ i, (inner ℂ (u i) (((A * A.adjoint) ^ R) (u i))).re) ^
            (1 / (2 * (R : ℝ)))) := by
  have hsym : (A * A.adjoint).IsSymmetric := LinearMap.isSymmetric_self_comp_adjoint A
  have hpos (v : E) : 0 ≤ (inner ℂ v ((A * A.adjoint) v)).re := by
    rw [Module.End.mul_apply, ← LinearMap.adjoint_inner_left]
    exact inner_self_nonneg (𝕜 := ℂ) (x := A.adjoint v)
  have hmpos (v : E) : 0 ≤ (inner ℂ v (((A * A.adjoint) ^ R) v)).re :=
    positive_spectral_moment_nonneg (A * A.adjoint) hsym hpos R v
  have hd : 0 ≤ ∑ i, (inner ℂ (u i) (((A * A.adjoint) ^ R) (u i))).re :=
    Finset.sum_nonneg (fun i _ => hmpos (u i))
  have hCpos : 0 ≤ C := (Finset.sum_nonneg (fun i _ => sq_nonneg ‖c i‖)).trans hC
  have hm : (inner ℂ f (((A * A.adjoint) ^ R) f)).re ≤
      C * ∑ i, (inner ℂ (u i) (((A * A.adjoint) ^ R) (u i))).re := by
    rw [hf]
    exact (gram_power_quadratic_bound A R c u).trans
      (mul_le_mul_of_nonneg_right hC hd)
  have hp := Real.rpow_le_rpow (hmpos f) hm
    (by positivity : 0 ≤ 1 / (2 * (R : ℝ)))
  rw [Real.mul_rpow hCpos hd] at hp
  calc
    ‖inner ℂ f (A g)‖ ≤ ‖g‖ * ‖f‖ ^ (1 - 1 / (R : ℝ)) *
        (inner ℂ f (((A * A.adjoint) ^ R) f)).re ^ (1 / (2 * (R : ℝ))) :=
      finite_pairing_moment A f g hR
    _ ≤ ‖g‖ * ‖f‖ ^ (1 - 1 / (R : ℝ)) *
        (C ^ (1 / (2 * (R : ℝ))) *
          (∑ i, (inner ℂ (u i) (((A * A.adjoint) ^ R) (u i))).re) ^
            (1 / (2 * (R : ℝ)))) :=
      mul_le_mul_of_nonneg_left hp
        (mul_nonneg (norm_nonneg _) (Real.rpow_nonneg (norm_nonneg _) _))
    _ = _ := by ring

theorem finite_endpoint_block_bound {J ι : Type*} [Fintype J] [Fintype ι]
    (A : E →ₗ[ℂ] E) (f g : J → E) (c : J → ι → ℂ) (u : J → ι → E)
    (hf : ∀ j, f j = ∑ i, c j i • u j i)
    {C : ℝ} (hC : ∀ j, ∑ i, ‖c j i‖ ^ 2 ≤ C)
    {R : ℕ} (hR : 2 ≤ R) :
    ∑ j, ‖inner ℂ (f j) (A (g j))‖ ≤
      C ^ (1 / (2 * (R : ℝ))) *
      (∑ j, ‖g j‖ ^ 2) ^ (1 / 2 : ℝ) *
      (∑ j, ‖f j‖ ^ 2) ^ ((1 - 1 / (R : ℝ)) / 2) *
      (∑ j, ∑ i, (inner ℂ (u j i) (((A * A.adjoint) ^ R) (u j i))).re) ^
        (1 / (2 * (R : ℝ))) := by
  classical
  rcases isEmpty_or_nonempty J with hJ | hJ
  · simp
  · let j₀ : J := Classical.choice hJ
    have hCpos : 0 ≤ C :=
      (Finset.sum_nonneg (fun i _ => sq_nonneg ‖c j₀ i‖)).trans (hC j₀)
    have hsym : (A * A.adjoint).IsSymmetric := LinearMap.isSymmetric_self_comp_adjoint A
    have hpos (v : E) : 0 ≤ (inner ℂ v ((A * A.adjoint) v)).re := by
      rw [Module.End.mul_apply, ← LinearMap.adjoint_inner_left]
      exact inner_self_nonneg (𝕜 := ℂ) (x := A.adjoint v)
    let d : J → ℝ := fun j =>
      ∑ i, (inner ℂ (u j i) (((A * A.adjoint) ^ R) (u j i))).re
    have hd (j : J) : 0 ≤ d j := Finset.sum_nonneg (fun i _ =>
      positive_spectral_moment_nonneg (A * A.adjoint) hsym hpos R (u j i))
    have hRpos : (0 : ℝ) < R := by exact_mod_cast (by omega : 0 < R)
    have hRone : (1 : ℝ) < R := by exact_mod_cast hR
    have hθ : 0 < 1 - 1 / (R : ℝ) := by
      have := (div_lt_one hRpos).2 hRone
      linarith
    have hθ1 : 1 - 1 / (R : ℝ) < 1 := by
      have := one_div_pos.mpr hRpos
      linarith
    have hexp : (1 - (1 - 1 / (R : ℝ))) / 2 = 1 / (2 * (R : ℝ)) := by ring
    have hh := finite_block_holder (fun j => ‖g j‖) (fun j => ‖f j‖) d
      (fun _ => norm_nonneg _) (fun _ => norm_nonneg _) hd hθ hθ1
    rw [hexp] at hh
    calc
      ∑ j, ‖inner ℂ (f j) (A (g j))‖ ≤
          ∑ j, C ^ (1 / (2 * (R : ℝ))) *
            (‖g j‖ * ‖f j‖ ^ (1 - 1 / (R : ℝ)) * (d j) ^ (1 / (2 * (R : ℝ)))) :=
        Finset.sum_le_sum (fun j _ =>
          finite_pairing_gram_bound A (f j) (g j) (c j) (u j) (hf j) (hC j) (by omega))
      _ = C ^ (1 / (2 * (R : ℝ))) *
          ∑ j, ‖g j‖ * ‖f j‖ ^ (1 - 1 / (R : ℝ)) * (d j) ^ (1 / (2 * (R : ℝ))) :=
        (Finset.mul_sum _ _ _).symm
      _ ≤ C ^ (1 / (2 * (R : ℝ))) *
          ((∑ j, ‖g j‖ ^ 2) ^ (1 / 2 : ℝ) *
          (∑ j, ‖f j‖ ^ 2) ^ ((1 - 1 / (R : ℝ)) / 2) *
          (∑ j, d j) ^ (1 / (2 * (R : ℝ)))) :=
        mul_le_mul_of_nonneg_left hh (Real.rpow_nonneg hCpos _)
      _ = _ := by dsimp only [d]; ring
end

section
open Filter
open scoped Topology
theorem moment_root_le_exp_of_log {M R C : ℝ} (hM : 0 < M) (hR : 0 < R)
    (hlog : Real.log M ≤ R * C) : M ^ (1 / R) ≤ Real.exp C := by
  rw [Real.rpow_def_of_pos hM]
  apply Real.exp_le_exp.mpr
  rw [mul_one_div]
  exact (div_le_iff₀ hR).mpr (by nlinarith)

theorem eventually_block_sup_moment_bound {a d C : ℝ}
    (ha : (1 / 2 : ℝ) < a) (hd : d < a) (hC : 0 ≤ C) (D : ℝ) :
    ∀ᶠ T : ℝ in atTop, ∀ H : ℝ, 0 < H →
      Real.log H ≤ D * T ^ d * Real.log T →
      (H * Real.exp (C * Real.sqrt T) ^ 2) ^
        (1 / (2 * (Nat.ceil (T ^ a) : ℝ))) ≤ Real.exp 1 := by
  have ha0 : 0 < a := by linarith
  filter_upwards [eventually_mul_rpow_log_add_le_rpow ha0 hd
      (show (0 : ℝ) < 1 by norm_num) D 0,
    eventually_mul_rpow_log_add_le_rpow ha0 ha
      (show (0 : ℝ) < 1 by norm_num) (2 * C) 0,
    Real.tendsto_log_atTop.eventually_ge_atTop 1,
    eventually_gt_atTop (0 : ℝ)] with T hD hCbound hlogT hT
  intro H hH hlogH
  have hsqrt : Real.sqrt T = T ^ (1 / 2 : ℝ) := Real.sqrt_eq_rpow T
  have hClog : 2 * C * Real.sqrt T ≤ 2 * C * T ^ (1 / 2 : ℝ) * Real.log T := by
    rw [hsqrt]
    exact le_mul_of_one_le_right (by positivity) hlogT
  have hceil : T ^ a ≤ (Nat.ceil (T ^ a) : ℝ) := Nat.le_ceil _
  have hR : 0 < 2 * (Nat.ceil (T ^ a) : ℝ) := by
    have : 0 < T ^ a := Real.rpow_pos_of_pos hT a
    linarith
  apply moment_root_le_exp_of_log (mul_pos hH (sq_pos_of_pos (Real.exp_pos _))) hR
  rw [Real.log_mul hH.ne' (pow_ne_zero 2 (Real.exp_ne_zero _)),
    Real.log_pow, Real.log_exp]
  norm_num only [Nat.cast_ofNat]
  nlinarith
end

