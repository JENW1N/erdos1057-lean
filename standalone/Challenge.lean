section

/- The exact right-closed logarithmic partition used by the count-matched proxies. -/

open Finset

namespace Bounty

noncomputable def logarithmicCellIndex (δ : ℝ) (n : ℕ) : ℤ :=
  ⌈Real.log (n : ℝ)/δ⌉-1

noncomputable def logarithmicCellBase (δ : ℝ) (k : ℤ) : ℝ :=
  Real.exp ((k : ℝ)*δ)

noncomputable def logarithmicCellSet (δ : ℝ) (k : ℤ) : Finset ℕ :=
  Ioc ⌊logarithmicCellBase δ k⌋₊ ⌊Real.exp δ*logarithmicCellBase δ k⌋₊

noncomputable def logarithmicCellIndices (δ : ℝ) (F : Finset ℕ) : Finset ℤ :=
  F.image (logarithmicCellIndex δ)

noncomputable def primeLogarithmicProxy (L S : ℝ) (n : ℕ) : ℝ :=
  primeCellProxy L S (logarithmicCellBase (L^(-S)) (logarithmicCellIndex (L^(-S)) n)) n

theorem logarithmic_cell_base_pos (δ : ℝ) (k : ℤ) : 0 < logarithmicCellBase δ k :=
  Real.exp_pos _

theorem logarithmic_cell_index_bounds {δ : ℝ} (hδ : 0 < δ) (n : ℕ) :
    (logarithmicCellIndex δ n : ℝ)*δ < Real.log (n : ℝ) ∧
      Real.log (n : ℝ) ≤ ((logarithmicCellIndex δ n : ℝ)+1)*δ := by
  have h := Int.ceil_eq_iff.mp (rfl : ⌈Real.log (n : ℝ)/δ⌉ = ⌈Real.log (n : ℝ)/δ⌉)
  constructor
  · apply (lt_div_iff₀ hδ).mp
    simpa only [logarithmicCellIndex, Int.cast_sub, Int.cast_one] using h.1
  · apply (div_le_iff₀ hδ).mp
    simpa only [logarithmicCellIndex, Int.cast_sub, Int.cast_one, sub_add_cancel] using h.2

theorem mem_logarithmic_cell_iff {δ : ℝ} (hδ : 0 < δ) {n : ℕ} (hn : 0 < n) (k : ℤ) :
    n ∈ logarithmicCellSet δ k ↔ logarithmicCellIndex δ n = k := by
  have hnR : 0 < (n : ℝ) := Nat.cast_pos.mpr hn
  have he : Real.exp δ*logarithmicCellBase δ k = Real.exp (((k : ℝ)+1)*δ) := by
    dsimp [logarithmicCellBase]
    rw [← Real.exp_add]
    congr 1
    ring
  simp only [logarithmicCellSet, mem_Ioc, Nat.floor_lt (logarithmic_cell_base_pos δ k).le,
    Nat.le_floor_iff (mul_nonneg (Real.exp_pos δ).le (logarithmic_cell_base_pos δ k).le)]
  rw [he]
  change Real.exp ((k : ℝ)*δ) < (n : ℝ) ∧ (n : ℝ) ≤ Real.exp (((k : ℝ)+1)*δ) ↔ _
  nth_rw 1 [← Real.exp_log hnR]
  nth_rw 2 [← Real.exp_log hnR]
  rw [Real.exp_lt_exp, Real.exp_le_exp]
  rw [logarithmicCellIndex, sub_eq_iff_eq_add, Int.ceil_eq_iff]
  simp only [Int.cast_add, Int.cast_one, add_sub_cancel_right]
  rw [lt_div_iff₀ hδ, div_le_iff₀ hδ]




theorem logarithmic_cell_pos {δ : ℝ} {k : ℤ} {n : ℕ}
    (hn : n ∈ logarithmicCellSet δ k) : 0 < n :=
  lt_of_le_of_lt (Nat.zero_le _) (mem_Ioc.mp hn).1

theorem logarithmic_interval_fiber {δ : ℝ} (hδ : 0 < δ) (m n : ℕ) (k : ℤ) :
    (Ioc m n).filter (fun i => logarithmicCellIndex δ i = k) =
      Ioc (max m ⌊logarithmicCellBase δ k⌋₊)
        (min n ⌊Real.exp δ*logarithmicCellBase δ k⌋₊) := by
  ext i
  simp only [mem_filter, mem_Ioc, max_lt_iff, le_min_iff]
  constructor
  · rintro ⟨⟨hmi, hin⟩, hik⟩
    have hi0 : 0 < i := lt_of_le_of_lt (Nat.zero_le _) hmi
    have hc := (mem_Ioc.mp ((mem_logarithmic_cell_iff hδ hi0 k).mpr hik))
    exact ⟨⟨hmi, hc.1⟩, hin, hc.2⟩
  · rintro ⟨⟨hmi, hki⟩, hin, hik⟩
    have hi0 : 0 < i := lt_of_le_of_lt (Nat.zero_le _) hmi
    exact ⟨⟨hmi, hin⟩, (mem_logarithmic_cell_iff hδ hi0 k).mp (mem_Ioc.mpr ⟨hki, hik⟩)⟩

theorem sum_logarithmic_cell_fibers {M : Type*} [AddCommMonoid M]
    (δ : ℝ) (F : Finset ℕ) (f : ℕ → M) :
    (∑ k ∈ logarithmicCellIndices δ F, ∑ n ∈ F.filter (fun n => logarithmicCellIndex δ n = k), f n) =
      ∑ n ∈ F, f n := by
  classical
  exact sum_fiberwise_of_maps_to (fun n hn => mem_image.mpr ⟨n, hn, rfl⟩) _

theorem prime_logarithmic_proxy_eq_on_cell {L S : ℝ} (hL : 0 < L) {k : ℤ} {n : ℕ}
    (hn : n ∈ logarithmicCellSet (L^(-S)) k) :
    primeLogarithmicProxy L S n = primeCellProxy L S (logarithmicCellBase (L^(-S)) k) n := by
  unfold primeLogarithmicProxy
  rw [(mem_logarithmic_cell_iff (by positivity) (logarithmic_cell_pos hn) k).mp hn]

end Bounty
end

