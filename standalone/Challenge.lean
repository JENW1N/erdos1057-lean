lemma euclideanC1c_supported_range :
  letI := @OAI.CubicEisenstein.instMeasurableSpaceEuclideanSpatial
  letI := @OAI.CubicEisenstein.instBorelSpaceEuclideanSpatial
  ∀ (K : Set EuclideanSpatial) (hK : MeasurableSet K)
    (f : C1c (E := EuclideanSpatial)) (hf : Function.support f.1⊆K),
    toL2 («μ» := volume) f∈LinearMap.range
      (Lp.extendByZeroₗᵢ («μ» := (volume : Measure EuclideanSpatial)) (p := (2:ℝ≥0∞)) hK).toLinearMap :=
  letI := @OAI.CubicEisenstein.instMeasurableSpaceEuclideanSpatial
  letI := @OAI.CubicEisenstein.instBorelSpaceEuclideanSpatial
  fun (K : Set EuclideanSpatial) (hK : MeasurableSet K)
    (f : C1c (E := EuclideanSpatial)) (hf : Function.support f.1⊆K) =>
    by
      have hmem := memLp_of_mem_C1c («μ» := (volume : Measure EuclideanSpatial)) f.2
      have hres : MemLp f.1 2 (volume.restrict K) := hmem.mono_measure Measure.restrict_le_self
      refine ⟨hres.toLp f.1,?_⟩
      apply Lp.ext
      have hext := Lp.extendByZeroₗᵢ_ae_eq («μ» := (volume : Measure EuclideanSpatial)) hK (hres.toLp f.1)
      have hr : ∀ᵐx ∂(volume : Measure EuclideanSpatial),x∈K→hres.toLp f.1 x=f.1 x :=
        (ae_restrict_iff' hK).mp hres.coeFn_toLp
      have hg : (toL2 («μ» := volume) f : EuclideanSpatial→ℝ)=ᵐ[volume]f.1 := hmem.coeFn_toLp
      filter_upwards [hext,hr,hg] with x hx hrx hgx
      simp only [LinearIsometry.coe_toLinearMap]
      rw [hx,hgx]
      by_cases hxm : x∈K
      · simpa only [Set.indicator_of_mem hxm] using hrx hxm
      · rw [Set.indicator_of_notMem hxm]
        symm
        by_contra hne
        exact hxm (hf hne)







theorem euclidean_C1c_family_precompact :
  letI := @OAI.CubicEisenstein.instMeasurableSpaceEuclideanSpatial
  letI := @OAI.CubicEisenstein.instBorelSpaceEuclideanSpatial
  ∀ (K : Set EuclideanSpatial) (hK : IsCompact K)
    (family : Set (C1c (E := EuclideanSpatial))) (R : ℝ)
    (hsupp : ∀f∈family, Function.support f.1 ⊆ K)
    (hmass : ∀f∈family, ‖toL2 («μ» := volume) f‖ ≤ R)
    (hgrad : ∀f∈family, ‖toL2Grad («μ» := volume) f‖ ≤ R),
    IsCompact (closure (toL2 («μ» := (volume : Measure EuclideanSpatial)) '' family)) :=
  letI := @OAI.CubicEisenstein.instMeasurableSpaceEuclideanSpatial
  letI := @OAI.CubicEisenstein.instBorelSpaceEuclideanSpatial
  fun (K : Set EuclideanSpatial) (hK : IsCompact K)
    (family : Set (C1c (E := EuclideanSpatial))) (R : ℝ)
    (hsupp : ∀f∈family, Function.support f.1 ⊆ K)
    (hmass : ∀f∈family, ‖toL2 («μ» := volume) f‖ ≤ R)
    (hgrad : ∀f∈family, ‖toL2Grad («μ» := volume) f‖ ≤ R) =>
    by
      let A : Set (Lp ℝ 2 ((volume : Measure EuclideanSpatial).restrict K)) :=
        {u | L2Compactness.extendByZeroL2 hK.measurableSet u ∈ toL2 («μ» := volume) '' family}
      let R₀ : ℝ := max R 0
      have hR₀ : 0 ≤ R₀ := le_max_right _ _
      have hA : A ⊆ Metric.closedBall 0 R₀ := by
        intro u hu
        obtain ⟨f,hf,he⟩ := hu
        have hm := (hmass f hf).trans (le_max_left R 0)
        rw [he,L2Compactness.norm_extendByZeroL2] at hm
        simpa only [Metric.mem_closedBall,dist_zero_right] using hm
      have happrox : ∀ ε : ℝ, 0 < ε →
          ∃ ψ : EuclideanSpatial → ℝ, Continuous ψ ∧ HasCompactSupport ψ ∧
            (∀ x, 0 ≤ ψ x) ∧ (∫ x, ψ x ∂(volume : Measure EuclideanSpatial)) = 1 ∧
            ∀ u ∈ A, (∫ t, ‖translateL2 («μ» := volume) (-t)
              (L2Compactness.extendByZeroL2 hK.measurableSet u) -
              L2Compactness.extendByZeroL2 hK.measurableSet u‖^2
              ∂L2Compactness.kernelMeasure ψ) ≤ (ε/2)^2 := by
        intro ε hε
        let radiusLocal : ℝ := (ε/2)/(R₀+1)
        have hradiusLocal : 0 < radiusLocal := by dsimp [radiusLocal]; positivity
        obtain ⟨ψ,hψc,hψs,hψ0,hψint,hψsupp⟩ :=
          L2Compactness.exists_kernel_tsupport_subset_ball_integral_eq_one
            (E := EuclideanSpatial) (deltaLoss := radiusLocal) hradiusLocal
        refine ⟨ψ,hψc,hψs,hψ0,hψint,?_⟩
        intro u hu
        apply L2Compactness.integral_norm_sq_translateL2_sub_le_sq_of_tsupport_subset_ball
          hψc hψs hψ0 hψint (show 0 ≤ ε/2 by positivity) hψsupp
        dsimp only
        intro t ht
        obtain ⟨f,hf,he⟩ := hu
        rw [← he]
        have htradiusLocal : ‖t‖ ≤ radiusLocal := le_of_lt (by simpa only [Metric.mem_ball,dist_zero_right] using ht)
        have hgR : ‖toL2Grad («μ» := volume) f‖ ≤ R₀ := (hgrad f hf).trans (le_max_left R 0)
        have hradiusLocalR : radiusLocal*R₀ ≤ ε/2 := by
          have hd : radiusLocal*(R₀+1) = ε/2 := div_mul_cancel₀ _ (by positivity : R₀+1 ≠ 0)
          nlinarith
        calc
          _ ≤ ‖-t‖ * ‖toL2Grad («μ» := volume) f‖ := norm_translateL2_sub_toL2_le (E := EuclideanSpatial)
            («μ» := (volume : Measure EuclideanSpatial)) (-t) f
          _ ≤ radiusLocal*R₀ := by rw [norm_neg]; exact mul_le_mul htradiusLocal hgR (norm_nonneg _) hradiusLocal.le
          _ ≤ ε/2 := hradiusLocalR
      have hc := L2Compactness.isCompact_closure_extendByZeroL2_image_of_forall_exists_translationIntegral_small
        hK hK.measurableSet hR₀ hA happrox
      have himage : L2Compactness.extendByZeroL2 hK.measurableSet '' A =
          toL2 («μ» := (volume : Measure EuclideanSpatial)) '' family := by
        apply Set.Subset.antisymm
        · rintro _ ⟨u,hu,rfl⟩
          exact hu
        · rintro _ ⟨f,hf,rfl⟩
          obtain ⟨u,hu⟩ := euclideanC1c_supported_range K hK.measurableSet f (hsupp f hf)
          have he : L2Compactness.extendByZeroL2 hK.measurableSet u = toL2 («μ» := volume) f := by
            rw [L2Compactness.extendByZeroL2_eq_extendByZeroₗᵢ]
            exact hu
          refine ⟨u,?_,he⟩
          change L2Compactness.extendByZeroL2 hK.measurableSet u ∈ toL2 («μ» := volume) '' family
          rw [he]
          exact ⟨f,hf,rfl⟩
      rw [himage] at hc
      exact hc

end CubicEisenstein

