theorem finite_coordinate_component_sum {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (is : List I) (hnodup : is.Nodup) (f : (∀ j, X j) → ℂ) :
    (∑ S ∈ is.toFinset.powerset, finiteCoordinateComponent μ S is f) = f := by
  induction is with
  | nil => simp [finiteCoordinateComponent]
  | cons i is ih =>
    obtain ⟨hi, hrest⟩ := List.nodup_cons.mp hnodup
    have hi' : i ∉ is.toFinset := by simpa only [List.mem_toFinset] using hi
    rw [List.toFinset_cons, Finset.sum_powerset_insert hi', ← Finset.sum_add_distrib]
    calc
      _ = ∑ S ∈ is.toFinset.powerset, finiteCoordinateComponent μ S is f := by
        apply Finset.sum_congr rfl
        intro S hS
        have his : i ∉ S := fun h => hi' ((Finset.mem_powerset.mp hS) h)
        have hc : finiteCoordinateComponent μ (insert i S) is f =
            finiteCoordinateComponent μ S is f := by
          apply finite_coordinate_component_congr
          intro j hj
          have hji : j ≠ i := by intro he; subst j; exact hi hj
          simp only [Finset.mem_insert, hji, false_or]
        simp only [finiteCoordinateComponent, finiteCoordinateChoice, if_neg his,
          Finset.mem_insert_self, if_true, hc]
        abel
      _ = f := ih hrest

theorem finite_coordinate_components_orthogonal {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hmass : ∀ i, ∑ y, μ i y = 1) (is : List I) (S T : Finset I)
    (hS : S ⊆ is.toFinset) (hT : T ⊆ is.toFinset) (hST : S ≠ T)
    (f g : (∀ j, X j) → ℂ) :
    (∑ x, (finiteProductWeight μ x : ℂ) *
      ((starRingEnd ℂ) (finiteCoordinateComponent μ S is f x) *
        finiteCoordinateComponent μ T is g x)) = 0 := by
  have hne : ¬ ∀ i, i ∈ S ↔ i ∈ T := fun h => hST (Finset.ext h)
  obtain ⟨i, hi⟩ := not_forall.mp hne
  by_cases his : i ∈ S
  · have hit : i ∉ T := fun ht => hi (iff_of_true his ht)
    have hil : i ∈ is := List.mem_toFinset.mp (hS his)
    have h := finite_coordinate_average_selfadjoint μ i
      (finiteCoordinateComponent μ S is f) (finiteCoordinateComponent μ T is g)
    rw [finite_coordinate_component_average μ hmass S is i hil,
      finite_coordinate_component_average μ hmass T is i hil, if_pos his, if_neg hit] at h
    simpa only [Pi.zero_apply, map_zero, zero_mul, mul_zero, Finset.sum_const_zero] using h.symm
  · have hit : i ∈ T := by
      by_contra ht
      exact hi (iff_of_false his ht)
    have hil : i ∈ is := List.mem_toFinset.mp (hT hit)
    have h := finite_coordinate_average_selfadjoint μ i
      (finiteCoordinateComponent μ S is f) (finiteCoordinateComponent μ T is g)
    rw [finite_coordinate_component_average μ hmass S is i hil,
      finite_coordinate_component_average μ hmass T is i hil, if_neg his, if_pos hit] at h
    simpa only [Pi.zero_apply, map_zero, zero_mul, mul_zero, Finset.sum_const_zero] using h
end

section
open Finset
theorem finite_bad_event_indicator_product {α : Type*} [DecidableEq α]
    (S : Finset α) (bad : α → Prop) [DecidablePred bad] :
    (∏ p ∈ S, if bad p then (1 : ℝ) else 0) =
      if ∀ p ∈ S, bad p then 1 else 0 := by
  classical
  by_cases hall : ∀ p ∈ S, bad p
  · rw [if_pos hall]
    exact prod_eq_one (fun p hp => if_pos (hall p hp))
  · rw [if_neg hall]
    push Not at hall
    obtain ⟨p, hp, hbad⟩ := hall
    exact prod_eq_zero hp (if_neg hbad)

theorem finite_bad_event_avoidance_product {α : Type*} [DecidableEq α]
    (S : Finset α) (bad : α → Prop) [DecidablePred bad] :
    (∏ p ∈ S, ((1 : ℝ) - (if bad p then 1 else 0))) =
      if ∀ p ∈ S, ¬bad p then 1 else 0 := by
  classical
  calc
    _ = ∏ p ∈ S, if ¬bad p then (1 : ℝ) else 0 := by
      apply prod_congr rfl
      intro p _
      by_cases hp : bad p <;> simp [hp]
    _ = _ := finite_bad_event_indicator_product S (fun p => ¬bad p)

