  have hqpos : (0 : ℝ) < Fintype.card F := lt_of_lt_of_le zero_lt_one hq
  have hinv : (Fintype.card F : ℝ)⁻¹ ≤ 1 := by
    apply (inv_le_one₀ hqpos).mpr
