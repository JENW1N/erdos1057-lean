theorem finite_disjoint_toList_append_perm {I : Type*} [DecidableEq I]
    (A B : Finset I) (hAB : Disjoint A B) :
    (A.toList ++ B.toList).Perm (A ∪ B).toList := by
  have hdis : List.Disjoint A.toList B.toList := by
    intro i hiA hiB
    exact disjoint_left.mp hAB (mem_toList.mp hiA) (mem_toList.mp hiB)
  apply List.perm_of_nodup_nodup_toFinset_eq
    (A.nodup_toList.append B.nodup_toList hdis) (A ∪ B).nodup_toList
  simp
