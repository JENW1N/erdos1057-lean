      ((physicalMarkGroupSplit small P J ell).symm (Rs, Rb))
      ((physicalAuxGroupSplit small P J C).symm (as, ab)) *
    physicalPhase ζ (physicalD (fun g : {g // small g} => C g.val) Ls as *
