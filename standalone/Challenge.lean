noncomputable def fullMemoryVacuum {G : Type*} {P Z : G → Type*}
    {M : G → ℕ} {B : ℕ} (x : ProductBoundedOrderedState P Z M B) : ℂ :=
  if ∀ g, (x g).2.1.val = 0 then 1 else 0

theorem fullMemoryVacuum_symmetric {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ} :
    ProductMemorySymmetric (fullMemoryVacuum (P := P) (Z := Z) (M := M) (B := B)) := by
  intro x g τ
  have hlen (i : G) : (productMemoryPermuteAt x g τ i).2.1.val = (x i).2.1.val := by
    by_cases hi : i = g
    · subst i
      simp [productMemoryPermuteAt]
    · simp [productMemoryPermuteAt, hi]
  simp only [fullMemoryVacuum, hlen]

theorem fullMemoryVacuum_norm_sq {G : Type*} [Fintype G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ}
    (x : ProductBoundedOrderedState P Z M B) :
    ‖fullMemoryVacuum x‖ ^ 2 =
      ∏ g, (if (x g).2.1.val = 0 then (1 : ℝ) else 0) := by
  rw [Fintype.prod_ite_zero]
  by_cases h : ∀ g, (x g).2.1.val = 0
  · simp only [fullMemoryVacuum, if_pos h, norm_one, one_pow, prod_const_one]
  · simp only [fullMemoryVacuum, if_neg h, norm_zero]
    norm_num

theorem bounded_empty_memory_mass {Z : Type*} [Fintype Z]
    (ν : Z → ℝ) (B : ℕ) :
    (∑ q : BoundedOrderedTuple Z B,
      boundedOrderedMemoryWeight ν q * (if q.1.val = 0 then 1 else 0)) = 1 := by
  rw [Fintype.sum_sigma, sum_eq_single (0 : Fin (B + 1))]
  · change (∑ y : Fin 0 → Z,
      ((∏ j, ν (y j)) / (Nat.factorial 0 : ℝ)) * (if 0 = 0 then 1 else 0)) = 1
    simp
  · intro N _ hN
    have hval : N.val ≠ 0 := fun h => hN (Fin.ext h)
    simp [hval]
  · simp

theorem bounded_empty_state_mass {P Z : Type*} [Fintype P] [Fintype Z]
    (μ : P → ℝ) (ν : Z → ℝ) (M B : ℕ) :
    (∑ s : BoundedOrderedState P Z M B,
      boundedOrderedStateWeight μ ν s * (if s.2.1.val = 0 then 1 else 0)) =
      (∑ p, μ p) ^ M := by
  rw [Fintype.sum_prod_type]
  simp only [boundedOrderedStateWeight, mul_assoc, ← mul_sum, bounded_empty_memory_mass, mul_one]
  exact (Fintype.sum_pow μ M).symm

theorem fullMemoryVacuum_energy {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ) (M : G → ℕ) (B : ℕ) :
    finiteWeightedEnergy (productMemoryWeight μ ν)
      (fullMemoryVacuum (M := M) (B := B)) =
      ∏ g, (∑ p, μ g p) ^ M g := by
  unfold finiteWeightedEnergy productMemoryWeight
  simp only [fullMemoryVacuum_norm_sq, ← prod_mul_distrib]
  rw [← Fintype.prod_sum (fun g (s : BoundedOrderedState (P g) (Z g) (M g) B) =>
    boundedOrderedStateWeight (μ g) (ν g) s * (if s.2.1.val = 0 then (1 : ℝ) else 0))]
  apply prod_congr rfl
  intro g _
  exact bounded_empty_state_mass (μ g) (ν g) (M g) B









end

section
open Filter
theorem prime_kernel_log_factor_le (Q : ℕ) (a : ℝ) (hQ : 0 < Q)
    (ha : 1 ≤ Real.log a) :
    1 + Real.log ((Q * Q : ℕ) : ℝ) / Real.log a ≤ 2 * (Q : ℝ) ^ 2 := by
  have hQone : (1 : ℝ) ≤ Q := by exact_mod_cast hQ
  have hQsq : (1 : ℝ) ≤ (Q : ℝ) ^ 2 := by nlinarith
  have hQcast : ((Q * Q : ℕ) : ℝ) = (Q : ℝ) ^ 2 := by push_cast; ring
  rw [hQcast]
  have hlog0 : 0 ≤ Real.log ((Q : ℝ) ^ 2) := Real.log_nonneg hQsq
  have hlog : Real.log ((Q : ℝ) ^ 2) ≤ (Q : ℝ) ^ 2 := Real.log_le_self (by positivity)
  have hdiv : Real.log ((Q : ℝ) ^ 2) / Real.log a ≤ Real.log ((Q : ℝ) ^ 2) := by
    apply (div_le_iff₀ (by linarith : 0 < Real.log a)).mpr
    exact le_mul_of_one_le_right hlog0 ha
  linarith

/- The logarithmic factor is bounded crudely by another `Q²`, leaving a
uniform exponential-times-power majorant. The exponent bounds may be any reals. -/
theorem prime_kernel_reproduction_error_majorant (c C q v x L : ℝ)
    (hc : 0 < c) (hC : 0 < C) (hL : 1 < L) (Q : ℕ) (V ξ a : ℝ)
    (hQ : 0 < Q) (hQbound : (Q : ℝ) ≤ L ^ q)
    (hV : L ^ (-v) ≤ V) (hξ : L ^ (-x) ≤ ξ) (ha : Real.exp (L ^ c) ≤ a) :
    ((Q * Q : ℕ) : ℝ) *
        (((C / V) * a ^ (-(1 : ℝ) / 32) *
          (1 + Real.log ((Q * Q : ℕ) : ℝ) / Real.log a)) / ξ) ≤
      (2 * C) * Real.exp (-(1 / 32 : ℝ) * L ^ c) * L ^ (4 * q + v + x) := by
  have hL0 : 0 < L := by linarith
  have hV0 : 0 < V := (Real.rpow_pos_of_pos hL0 (-v)).trans_le hV
  have hξ0 : 0 < ξ := (Real.rpow_pos_of_pos hL0 (-x)).trans_le hξ
  have ha0 : 0 < a := (Real.exp_pos _).trans_le ha
  have halog : 1 ≤ Real.log a := by
    have hh := Real.log_le_log (Real.exp_pos (L ^ c)) ha
    rw [Real.log_exp] at hh
    exact (Real.one_le_rpow hL.le hc.le).trans hh
  have hVinv : 1 / V ≤ L ^ v := by
    calc
      _ ≤ 1 / L ^ (-v) := one_div_le_one_div_of_le (Real.rpow_pos_of_pos hL0 (-v)) hV
      _ = _ := by rw [Real.rpow_neg hL0.le]; simp
  have hξinv : 1 / ξ ≤ L ^ x := by
    calc
      _ ≤ 1 / L ^ (-x) := one_div_le_one_div_of_le (Real.rpow_pos_of_pos hL0 (-x)) hξ
      _ = _ := by rw [Real.rpow_neg hL0.le]; simp
  have hadecay : a ^ (-(1 : ℝ) / 32) ≤ Real.exp (-(1 / 32 : ℝ) * L ^ c) := by
    calc
      _ ≤ (Real.exp (L ^ c)) ^ (-(1 : ℝ) / 32) :=
        Real.rpow_le_rpow_of_nonpos (Real.exp_pos _) ha (by norm_num)
      _ = _ := by rw [← Real.exp_mul]; congr 1; ring
  have hQsq : (Q : ℝ) ^ 2 ≤ (L ^ q) ^ 2 :=
    pow_le_pow_left₀ (Nat.cast_nonneg Q) hQbound 2
  have hlogbound : 1 + Real.log ((Q * Q : ℕ) : ℝ) / Real.log a ≤ 2 * (L ^ q) ^ 2 :=
    (prime_kernel_log_factor_le Q a hQ halog).trans (by linarith)
  have hlog0 : 0 ≤ 1 + Real.log ((Q * Q : ℕ) : ℝ) / Real.log a := by
    have hQQ : (1 : ℝ) ≤ ((Q * Q : ℕ) : ℝ) := by
      exact_mod_cast (show 1 ≤ Q * Q by nlinarith)
    have hh := Real.log_nonneg hQQ
    positivity
  calc
    _ = (Q : ℝ) ^ 2 * C * (1 / V) * a ^ (-(1 : ℝ) / 32) *
        (1 + Real.log ((Q * Q : ℕ) : ℝ) / Real.log a) * (1 / ξ) := by
      push_cast
      ring
    _ ≤ (L ^ q) ^ 2 * C * L ^ v * Real.exp (-(1 / 32 : ℝ) * L ^ c) *
        (2 * (L ^ q) ^ 2) * L ^ x := by
      gcongr
    _ = _ := by
      rw [show 4 * q + v + x = q + q + v + q + q + x by ring]
      simp only [Real.rpow_add hL0]
      ring

/- One threshold in `L` works for every allowed modulus bound, mass,
cell width, and prime-band starting point. -/
theorem eventually_prime_kernel_reproduction_error_small (c C q v x D : ℝ)
    (hc : 0 < c) (hC : 0 < C) :
    ∀ᶠ L : ℝ in atTop, ∀ (Q : ℕ) (V ξ a : ℝ), 0 < Q →
      (Q : ℝ) ≤ L ^ q → L ^ (-v) ≤ V → L ^ (-x) ≤ ξ → Real.exp (L ^ c) ≤ a →
      ((Q * Q : ℕ) : ℝ) *
        (((C / V) * a ^ (-(1 : ℝ) / 32) *
          (1 + Real.log ((Q * Q : ℕ) : ℝ) / Real.log a)) / ξ) ≤ L ^ (-D) := by
  filter_upwards [eventually_exp_neg_rpow_mul_rpow_le hc (by norm_num : (0 : ℝ) < 1 / 32)
      (4 * q + v + x + 1) D,
    eventually_gt_atTop (1 : ℝ), eventually_ge_atTop (2 * C)] with L hdecay hL hCL
  intro Q V ξ a hQ hQbound hV hξ ha
  have hL0 : 0 < L := by linarith
  calc
    _ ≤ (2 * C) * Real.exp (-(1 / 32 : ℝ) * L ^ c) * L ^ (4 * q + v + x) :=
      prime_kernel_reproduction_error_majorant c C q v x L hc hC hL Q V ξ a
        hQ hQbound hV hξ ha
    _ ≤ L * Real.exp (-(1 / 32 : ℝ) * L ^ c) * L ^ (4 * q + v + x) := by
      gcongr
    _ = Real.exp (-(1 / 32 : ℝ) * L ^ c) * L ^ (4 * q + v + x + 1) := by
      rw [Real.rpow_add hL0 (4 * q + v + x) 1, Real.rpow_one]
      ring
    _ ≤ L ^ (-D) := hdecay
end

section
open scoped BigOperators Classical
theorem finite_subtype_sum_eq_of_zero_off {X M : Type*} [Fintype X] [AddCommMonoid M]
    (S : X → Prop) [DecidablePred S] (F : X → M) (hF : ∀ x, ¬ S x → F x = 0) :
    (∑ x : {x // S x}, F x.val) = ∑ x, F x := by
  exact (Finset.sum_congr_set {x | S x} F (fun x => F x.val) (fun _ _ => rfl) hF).symm

theorem finite_subtype_sum_le_of_nonneg {X : Type*} [Fintype X]
    (S : X → Prop) [DecidablePred S] (w : X → ℝ) (hw : ∀ x, 0 ≤ w x) :
    (∑ x : {x // S x}, w x.val) ≤ ∑ x, w x := by
  rw [← Finset.sum_subtype (Finset.univ.filter S) (by simp)]
  exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
    (fun x _ _ => hw x)

theorem finite_subtype_fiber_mass_le {X : Type*} [Fintype X]
    (S : X → Prop) [DecidablePred S] (π : X → ℕ) (μ : X → ℝ)
    (hμ : ∀ x, 0 ≤ μ x) (m : ℕ) :
    (∑ x ∈ Finset.univ.filter (fun x : {x // S x} => π x.val = m), μ x.val) ≤
      ∑ x ∈ Finset.univ.filter (fun x => π x = m), μ x := by
  simp only [Finset.sum_filter]
  exact finite_subtype_sum_le_of_nonneg S (fun x => if π x = m then μ x else 0)
    (fun x => by split_ifs; exact hμ x; exact le_rfl)

theorem finite_test_support_energy {X : Type*} [Fintype X]
    (μ : X → ℝ) (f : X → ℂ) :
    (∑ x : {x // f x ≠ 0}, μ x.val * ‖f x.val‖ ^ 2) =
      ∑ x, μ x * ‖f x‖ ^ 2 := by
  apply finite_subtype_sum_eq_of_zero_off (fun x => f x ≠ 0) (fun x => μ x * ‖f x‖ ^ 2)
  intro x hx
  have hf : f x = 0 := not_not.mp hx
  simp [hf]

theorem finite_test_support_bilinear {X Y : Type*} [Fintype X] [Fintype Y]
    (μ : X → ℝ) (ν : Y → ℝ) (f : X → ℂ) (g : Y → ℂ) (K : X → Y → ℂ) :
    (∑ x : {x // f x ≠ 0}, ∑ y : {y // g y ≠ 0},
      ((μ x.val : ℂ) * f x.val) * ((ν y.val : ℂ) * g y.val) * K x.val y.val) =
      ∑ x, ∑ y, ((μ x : ℂ) * f x) * ((ν y : ℂ) * g y) * K x y := by
  calc
    _ = ∑ x : {x // f x ≠ 0}, ∑ y,
        ((μ x.val : ℂ) * f x.val) * ((ν y : ℂ) * g y) * K x.val y := by
      apply Finset.sum_congr rfl
      intro x _
      apply finite_subtype_sum_eq_of_zero_off (fun y => g y ≠ 0)
        (fun y => ((μ x.val : ℂ) * f x.val) * ((ν y : ℂ) * g y) * K x.val y)
      intro y hy
      have hg : g y = 0 := not_not.mp hy
      simp [hg]
    _ = _ := by
      apply finite_subtype_sum_eq_of_zero_off (fun x => f x ≠ 0)
        (fun x => ∑ y, ((μ x : ℂ) * f x) * ((ν y : ℂ) * g y) * K x y)
      intro x hx
      have hf : f x = 0 := not_not.mp hx
      simp [hf]
end

