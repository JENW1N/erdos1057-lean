section

/- Current birth support is fixed by the sample slots; only earlier-label presence comes from history. -/

open Classical

namespace Bounty

noncomputable def ownerSampleSupport {N m L : ℕ} {α : Type*}
    (embed : Fin m → Fin N) (owner : Fin N → Fin L) (u : Fin L)
    (history : Fin N → Option α) (i : Fin N) : Prop :=
  if owner i = u then i ∈ Set.range embed else (history i).isSome = true

section

variable
  {N m L : ℕ}
  {α : Type*}
  (embed : Fin m → Fin N)

include N m L α embed

theorem owner_sample_support_cover  (owner : Fin N → Fin L) (u : Fin L)
    (history : Fin N → Option α) :
    ∀ i, ownerSampleSupport embed owner u history i → owner i = u → i ∈ Set.range embed := by
  intro i hi hu
  simpa only [ownerSampleSupport, if_pos hu] using hi

theorem owner_sample_support_presence  (owner : Fin N → Fin L) (u : Fin L)
    (values history : Fin N → Option α)
    (hcover : ∀ i, (values i).isSome = true ∧ owner i = u ↔ i ∈ Set.range embed)
    (hother : ∀ i, owner i ≠ u → values i = history i) :
    ∀ i, ownerSampleSupport embed owner u history i ↔ (values i).isSome = true := by
  intro i
  by_cases hi : owner i = u
  · simp only [ownerSampleSupport, if_pos hi]
    exact ⟨fun h => ((hcover i).mpr h).1, fun h => (hcover i).mp ⟨h, hi⟩⟩
  · simp only [ownerSampleSupport, if_neg hi, hother i hi]

theorem owner_sample_support_anchors_valid  (hstrict : StrictMono embed)
    (owner : Fin N → Fin L) (hmono : Monotone owner) (u : Fin L)
    (howner : ∀ j, owner (embed j) = u) (history : Fin N → Option α) (code : BirthForestCode N)
    (hs : birthForestStageSupport owner u (ownerSampleSupport embed owner u history) code) :
    ∀ j, restrictedBirthAnchors embed code history j ≠ some none := by
  intro j
  cases hc : code (embed j) with
  | none => simp [restrictedBirthAnchors, hc]
  | some p =>
    by_cases he : ∃ k : Fin j.val,
      embed (birthForestParentEmbedding j k) = birthForestParentEmbedding (embed j) p
    · simp [restrictedBirthAnchors, hc, he]
    · have hp := (hs (embed j) (howner j) p hc).1
      have hlt := restricted_birth_external_parent_owner_lt embed hstrict owner hmono u howner
        (ownerSampleSupport embed owner u history) (owner_sample_support_cover embed owner u history)
        j p hp he
      have hv : (history (birthForestParentEmbedding (embed j) p)).isSome = true := by
        simpa only [ownerSampleSupport, if_neg (ne_of_lt hlt)] using hp
      have hn : history (birthForestParentEmbedding (embed j) p) ≠ none := by
        intro h
        rw [h] at hv
        cases hv
      simpa only [restrictedBirthAnchors, hc, if_neg he, ne_eq, Option.some.injEq] using hn

theorem owner_sample_stage_iff  (hstrict : StrictMono embed)
    (owner : Fin N → Fin L) (hmono : Monotone owner) (u : Fin L)
    (howner : ∀ j, owner (embed j) = u) (code : BirthForestCode N)
    (values history : Fin N → Option α) (localValues : Fin m → α)
    (hcover : ∀ i, (values i).isSome = true ∧ owner i = u ↔ i ∈ Set.range embed)
    (hother : ∀ i, owner i ≠ u → values i = history i)
    (hlocal : ∀ j, values (embed j) = some (localValues j)) :
    birthForestStageCondition owner u values code ↔
      birthForestStageSupport owner u (ownerSampleSupport embed owner u history) code ∧
        birthForestEqualValues (restrictedBirthCode embed code) localValues ∧
          birthLabelsAnchored (fun j => (restrictedBirthAnchors embed code history j).join) localValues :=
  owner_stage_support_forest_iff embed hstrict owner hmono u howner
    (ownerSampleSupport embed owner u history) (owner_sample_support_cover embed owner u history)
    code values history localValues (owner_sample_support_presence embed owner u values history hcover hother)
    hlocal (fun i hi => hother i (ne_of_lt hi))

end


end Bounty
end

