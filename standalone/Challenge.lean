section

/- Dyadic index counts sensitive to the width of a logarithmic window. -/

open Finset

namespace Bounty

theorem nat_finset_card_le_real_span (S : Finset ℕ) {a b : ℝ} (hab : a ≤ b)
    (hS : ∀ n ∈ S, a ≤ (n : ℝ) ∧ (n : ℝ) ≤ b) : (S.card : ℝ) ≤ b-a+1 := by
  classical
  by_cases hs : S.Nonempty
  · let lo := S.min' hs
    let hi := S.max' hs
    have hlh : lo ≤ hi := S.min'_le_max' hs
    have hsub : S ⊆ Icc lo hi := by
      intro n hn
      exact mem_Icc.mpr ⟨S.min'_le n hn, S.le_max' n hn⟩
    have hc : S.card ≤ hi-lo+1 := by
      have h := card_le_card hsub
      rw [Nat.card_Icc] at h
      omega
    have hcR := Nat.cast_le (α := ℝ).mpr hc
    rw [Nat.cast_add, Nat.cast_sub hlh, Nat.cast_one] at hcR
    have hlo := (hS lo (S.min'_mem hs)).1
    have hhi := (hS hi (S.max'_mem hs)).2
    linarith
  · rw [not_nonempty_iff_eq_empty.mp hs, card_empty, Nat.cast_zero]
    linarith

theorem dyadic_log2_real_bounds {n : ℕ} (hn : 0 < n) :
    Real.log (n : ℝ)/Real.log 2 - 1 < (n.log2 : ℝ) ∧
      (n.log2 : ℝ) ≤ Real.log (n : ℝ)/Real.log 2 := by
  have htwo : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hpow := (Nat.log2_eq_iff hn.ne').mp (rfl : n.log2 = n.log2)
  have hupper : (n : ℝ) < (2 : ℝ)^(n.log2+1) := by exact_mod_cast hpow.2
  have hlog := Real.log_lt_log (Nat.cast_pos.mpr hn) hupper
  rw [Real.log_pow] at hlog
  constructor
  · rw [div_sub_one htwo.ne', div_lt_iff₀ htwo]
    push_cast at hlog
    nlinarith
  · exact Real.log2_le_logb n

theorem dyadic_indices_card_window (S : Finset ℕ) {a b : ℝ} (hab : a ≤ b)
    (hS : ∀ n ∈ S, 0 < n ∧ Real.exp a ≤ (n : ℝ) ∧ (n : ℝ) ≤ Real.exp b) :
    ((dyadicNatIndices S).card : ℝ) ≤ (b-a)/Real.log 2 + 2 := by
  have htwo : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hspan : a/Real.log 2-1 ≤ b/Real.log 2 := by
    have := div_le_div_of_nonneg_right hab htwo.le
    linarith
  have hbound : ∀ k ∈ dyadicNatIndices S,
      a/Real.log 2-1 ≤ (k : ℝ) ∧ (k : ℝ) ≤ b/Real.log 2 := by
    intro k hk
    obtain ⟨n, hn, rfl⟩ := mem_image.mp hk
    obtain ⟨hn0, hnlo, hnhi⟩ := hS n hn
    have hb := dyadic_log2_real_bounds hn0
    have hlo : a ≤ Real.log (n : ℝ) := by
      simpa only [Real.log_exp] using Real.log_le_log (Real.exp_pos a) hnlo
    have hhi : Real.log (n : ℝ) ≤ b := by
      simpa only [Real.log_exp] using Real.log_le_log (Nat.cast_pos.mpr hn0) hnhi
    constructor
    · have := div_le_div_of_nonneg_right hlo htwo.le
      linarith
    · exact hb.2.trans (div_le_div_of_nonneg_right hhi htwo.le)
  have h := nat_finset_card_le_real_span (dyadicNatIndices S) hspan hbound
  convert h using 1; ring

end Bounty
end

section

/- Scalar retention and birth sums for length-weighted original ghost events. -/

open Finset Classical

namespace Bounty

theorem ghost_retention_length_sum {Z : Type*} {d : ℕ}
    (old : Fin d → Z) (A D : Z → ℝ) (v : ℝ) :
    (∑ r : Finset (Fin d), ((∏ i ∈ r, A (old i)) *
      (∏ i ∈ univ \ r, |D (old i)|)) * v ^ r.card) =
      ∏ i, (A (old i) * v + |D (old i)|) := by
  rw [Finset.prod_add, powerset_univ]
  apply sum_congr rfl
  intro r _
  rw [prod_mul_distrib, prod_const]
  ring

theorem ghost_uncut_length_sum {P Z : Type*} [Fintype Z]
    (A D C ν : Z → ℝ) (v : ℝ) (t B : ℕ) (s : BoundedOrderedState P Z t B) :
    (∑ b : Fin (B + 1), ∑ r : Finset (Fin s.2.1.val), ∑ births : Fin b.val → Z,
      (((∏ i ∈ r, A (s.2.2 i)) * (∏ i ∈ univ \ r, |D (s.2.2 i)|)) *
        (∏ i, |C (births i)| * ν (births i)) / (b.val.factorial : ℝ)) * v ^ (r.card + b.val)) =
      (∏ i, (A (s.2.2 i) * v + |D (s.2.2 i)|)) *
        ∑ b ∈ range (B + 1), ((∑ z, |C z| * ν z) * v) ^ b / (b.factorial : ℝ) := by
  have hb (b : Fin (B + 1)) (r : Finset (Fin s.2.1.val)) :
      (∑ births : Fin b.val → Z,
        (((∏ i ∈ r, A (s.2.2 i)) * (∏ i ∈ univ \ r, |D (s.2.2 i)|)) *
          (∏ i, |C (births i)| * ν (births i)) / (b.val.factorial : ℝ)) * v ^ (r.card + b.val)) =
        (((∏ i ∈ r, A (s.2.2 i)) * (∏ i ∈ univ \ r, |D (s.2.2 i)|)) * v ^ r.card) *
          (((∑ z, |C z| * ν z) * v) ^ b.val / (b.val.factorial : ℝ)) := by
    calc
      _ = (((∏ i ∈ r, A (s.2.2 i)) * (∏ i ∈ univ \ r, |D (s.2.2 i)|)) * v ^ r.card) *
          (v ^ b.val / (b.val.factorial : ℝ)) *
          ∑ births : Fin b.val → Z, ∏ i, |C (births i)| * ν (births i) := by
            rw [mul_sum]
            apply sum_congr rfl
            intro births _
            rw [pow_add]
            ring
      _ = _ := by
        rw [← Fintype.prod_sum (fun (_ : Fin b.val) (z : Z) => |C z| * ν z), Fin.prod_const, mul_pow]
        ring
  simp_rw [hb]
  rw [sum_comm]
  simp_rw [← mul_sum]
  rw [← sum_mul, ghost_retention_length_sum,
    Fin.sum_univ_eq_sum_range (fun b => ((∑ z, |C z| * ν z) * v) ^ b / (b.factorial : ℝ)) (B + 1)]

end Bounty
end

