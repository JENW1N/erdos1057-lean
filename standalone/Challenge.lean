section

/- Reduction of a separated monotone slope sum to its first-derivative interval bounds. -/

open Finset

namespace Bounty

theorem discrete_slope_band_sum_bound {a b : ℕ} {d : ℕ → ℝ} {z : ℕ → ℂ}
    {δ C : ℝ} (hδ : 0 < δ) (hC : 0 ≤ C)
    (hmono : MonotoneOn d (Set.Icc a b))
    (hfirst : ∀ l r : ℕ, ∀ k : ℤ, a ≤ l → r ≤ b → l ≤ r →
      (∀ n ∈ Icc l r, (k : ℝ)+δ ≤ d n ∧ d n ≤ k+1-δ) →
      ‖∑ n ∈ Icc l r, z n‖ ≤ C/δ) (k : ℤ) :
    ‖∑ n ∈ discreteSlopeBand a b d (k+δ) (k+1-δ), z n‖ ≤ C/δ := by
  classical
  let S := discreteSlopeBand a b d (k+δ) (k+1-δ)
  by_cases hne : S.Nonempty
  · have heq := discrete_slope_band_interval hmono hne
    have hlo := mem_filter.mp (S.min'_mem hne)
    have hhi := mem_filter.mp (S.max'_mem hne)
    rw [heq]
    apply hfirst _ _ k (mem_Icc.mp hlo.1).1 (mem_Icc.mp hhi.1).2 (S.min'_le_max' hne)
    intro n hn
    have hnS : n ∈ discreteSlopeBand a b d (k+δ) (k+1-δ) := heq.symm ▸ hn
    exact (mem_filter.mp hnS).2
  · have he : S = ∅ := not_nonempty_iff_eq_empty.mp hne
    change ‖∑ n ∈ S, z n‖ ≤ C/δ
    rw [he,sum_empty,norm_zero]
    positivity

theorem discrete_slope_fiber_sum_bound {a b : ℕ} {d : ℕ → ℝ} {z : ℕ → ℂ}
    {lam δ C : ℝ} (hlam : 0 < lam) (hδ : 0 < δ) (hC : 0 ≤ C)
    (hmono : MonotoneOn d (Set.Icc a b))
    (hsep : ∀ i ∈ Icc a b, ∀ j ∈ Icc a b, i ≤ j → lam*((j : ℝ)-i) ≤ d j-d i)
    (hz : ∀ n ∈ Icc a b, ‖z n‖ ≤ 1)
    (hfirst : ∀ l r : ℕ, ∀ k : ℤ, a ≤ l → r ≤ b → l ≤ r →
      (∀ n ∈ Icc l r, (k : ℝ)+δ ≤ d n ∧ d n ≤ k+1-δ) →
      ‖∑ n ∈ Icc l r, z n‖ ≤ C/δ) (k : ℤ) :
    ‖∑ n ∈ (Icc a b).filter (fun n => ⌊d n⌋ = k), z n‖ ≤ C/δ+2*(δ/lam+1) := by
  classical
  let S := (Icc a b).filter (fun n => ⌊d n⌋ = k)
  let G := fun n => (k : ℝ)+δ ≤ d n ∧ d n ≤ k+1-δ
  have hg : S.filter G = discreteSlopeBand a b d (k+δ) (k+1-δ) := by
    ext n
    simp only [S,G,discreteSlopeBand,mem_filter]
    constructor
    · rintro ⟨⟨hn,hfloor⟩,hg⟩
      exact ⟨hn,hg⟩
    · rintro ⟨hn,hg⟩
      exact ⟨⟨hn,Int.floor_eq_iff.mpr ⟨by linarith [hg.1],by linarith [hg.2]⟩⟩,hg⟩
  have hbad : S.filter (fun n => ¬G n) ⊆
      discreteSlopeBand a b d k (k+δ) ∪ discreteSlopeBand a b d (k+1-δ) (k+1) := by
    intro n hn
    obtain ⟨hn,hnot⟩ := mem_filter.mp hn
    obtain ⟨hn,hfloor⟩ := mem_filter.mp hn
    have hf := Int.floor_eq_iff.mp hfloor
    apply mem_union.mpr
    by_cases hlo : (k : ℝ)+δ ≤ d n
    · right
      exact mem_filter.mpr ⟨hn,⟨by simp only [G,not_and] at hnot; exact le_of_lt (lt_of_not_ge (hnot hlo)),hf.2.le⟩⟩
    · left
      exact mem_filter.mpr ⟨hn,⟨hf.1,le_of_lt (lt_of_not_ge hlo)⟩⟩
  have hbcard : ((S.filter (fun n => ¬G n)).card : ℝ) ≤ 2*(δ/lam+1) := by
    have hc := (card_le_card hbad).trans (card_union_le _ _)
    have hcR : ((S.filter (fun n => ¬G n)).card : ℝ) ≤
        ((discreteSlopeBand a b d k (k+δ)).card : ℝ)+
        ((discreteSlopeBand a b d (k+1-δ) (k+1)).card : ℝ) := by exact_mod_cast hc
    have hl := discrete_slope_band_card_bound hlam (show (k : ℝ) ≤ k+δ by linarith) hsep
    have hr := discrete_slope_band_card_bound hlam (show (k : ℝ)+1-δ ≤ k+1 by linarith) hsep
    have hl' : ((discreteSlopeBand a b d k (k+δ)).card : ℝ) ≤ δ/lam+1 := by
      simpa only [add_sub_cancel_left] using hl
    have hr' : ((discreteSlopeBand a b d (k+1-δ) (k+1)).card : ℝ) ≤ δ/lam+1 := by
      convert hr using 1 <;> ring
    linarith
  have hbnorm : ‖∑ n ∈ S.filter (fun n => ¬G n), z n‖ ≤ 2*(δ/lam+1) := by
    calc
      _ ≤ ∑ n ∈ S.filter (fun n => ¬G n), ‖z n‖ := norm_sum_le _ _
      _ ≤ ∑ n ∈ S.filter (fun n => ¬G n), (1 : ℝ) :=
        sum_le_sum (fun n hn => hz n (mem_filter.mp (mem_filter.mp hn).1).1)
      _ = ((S.filter (fun n => ¬G n)).card : ℝ) := by simp
      _ ≤ _ := hbcard
  change ‖∑ n ∈ S, z n‖ ≤ _
  rw [← sum_filter_add_sum_filter_not S G z]
  exact (norm_add_le _ _).trans (add_le_add
    (by rw [hg]; exact discrete_slope_band_sum_bound hδ hC hmono hfirst k) hbnorm)

theorem discrete_slope_partition_bound {a b : ℕ} {d : ℕ → ℝ} {z : ℕ → ℂ}
    {lam δ C : ℝ} (hab : a ≤ b) (hlam : 0 < lam) (hδ : 0 < δ) (hC : 0 ≤ C)
    (hmono : MonotoneOn d (Set.Icc a b))
    (hsep : ∀ i ∈ Icc a b, ∀ j ∈ Icc a b, i ≤ j → lam*((j : ℝ)-i) ≤ d j-d i)
    (hz : ∀ n ∈ Icc a b, ‖z n‖ ≤ 1)
    (hfirst : ∀ l r : ℕ, ∀ k : ℤ, a ≤ l → r ≤ b → l ≤ r →
      (∀ n ∈ Icc l r, (k : ℝ)+δ ≤ d n ∧ d n ≤ k+1-δ) →
      ‖∑ n ∈ Icc l r, z n‖ ≤ C/δ) :
    ‖∑ n ∈ Icc a b, z n‖ ≤ (d b-d a+2)*(C/δ+2*(δ/lam+1)) := by
  classical
  have hmap : ∀ n ∈ Icc a b, ⌊d n⌋ ∈ Icc ⌊d a⌋ ⌊d b⌋ := by
    intro n hn
    obtain ⟨han,hnb⟩ := mem_Icc.mp hn
    exact mem_Icc.mpr ⟨Int.floor_mono (hmono ⟨le_rfl,hab⟩ ⟨han,hnb⟩ han),
      Int.floor_mono (hmono ⟨han,hnb⟩ ⟨hab,le_rfl⟩ hnb)⟩
  rw [← sum_fiberwise_of_maps_to hmap z]
  calc
    _ ≤ ∑ k ∈ Icc ⌊d a⌋ ⌊d b⌋, ‖∑ n ∈ (Icc a b).filter (fun n => ⌊d n⌋=k), z n‖ := norm_sum_le _ _
    _ ≤ ∑ k ∈ Icc ⌊d a⌋ ⌊d b⌋, (C/δ+2*(δ/lam+1)) :=
      sum_le_sum (fun k _ => discrete_slope_fiber_sum_bound hlam hδ hC hmono hsep hz hfirst k)
    _ = ((Icc ⌊d a⌋ ⌊d b⌋).card : ℝ)*(C/δ+2*(δ/lam+1)) := by
      simp only [sum_const,nsmul_eq_mul]
    _ ≤ _ := mul_le_mul_of_nonneg_right (floor_slope_range_card hab hmono) (by positivity)

end Bounty
end

section

/- Coefficients of a power of a finite prime polynomial, grouped by the
integer product of an ordered tuple. Repeated prime entries are allowed.
The squared coefficient sum has the factorial bound from unique factorization. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def primePolynomialSupport (P : Finset ℕ) (j : ℕ) : Finset ℕ :=
  univ.image (primeTupleProduct P j)

noncomputable def primePolynomialCoefficient (P : Finset ℕ) (w : P → ℂ) (j n : ℕ) : ℂ :=
  ∑ a ∈ univ.filter (fun a : Fin j → P => primeTupleProduct P j a = n), ∏ r, w (a r)

theorem prime_polynomial_support_pos (P : Finset ℕ)
    (hP : ∀ p ∈ P, Nat.Prime p) (j n : ℕ) (hn : n ∈ primePolynomialSupport P j) :
    0 < n := by
  obtain ⟨a, _, rfl⟩ := mem_image.mp hn
  exact prod_pos fun r _ => (hP (a r).val (a r).property).pos







theorem prime_polynomial_coefficients_sum_mul (P : Finset ℕ) (w : P → ℂ)
    (j : ℕ) (χ : ℕ → ℂ) :
    (∑ n ∈ primePolynomialSupport P j, primePolynomialCoefficient P w j n * χ n) =
      ∑ a : Fin j → P, (∏ r, w (a r)) * χ (primeTupleProduct P j a) :=
  finite_fiber_sum_mul (primeTupleProduct P j) (fun a => ∏ r, w (a r)) χ

theorem prime_tuple_weight_sq_sum (P : Finset ℕ) (w : P → ℂ) (j : ℕ) :
    (∑ a : Fin j → P, ‖∏ r, w (a r)‖ ^ 2) = (∑ p : P, ‖w p‖ ^ 2) ^ j := by
  simp only [norm_prod, ← prod_pow]
  exact (Fintype.sum_pow (fun p : P => ‖w p‖ ^ 2) j).symm

theorem prime_polynomial_coefficients_sq_le_factorial (P : Finset ℕ)
    (hP : ∀ p ∈ P, Nat.Prime p) (w : P → ℂ) (j : ℕ) :
    (∑ n ∈ primePolynomialSupport P j, ‖primePolynomialCoefficient P w j n‖ ^ 2) ≤
      (j.factorial : ℝ) * (∑ p : P, ‖w p‖ ^ 2) ^ j := by
  have hh := finite_fiber_sum_norm_sq_le (primeTupleProduct P j)
    (fun a => ∏ r, w (a r)) j.factorial
    (fun n _ => prime_tuple_product_fiber_card_le_factorial P hP j n)
  exact hh.trans_eq (congrArg (fun x : ℝ => (j.factorial : ℝ) * x)
    (prime_tuple_weight_sq_sum P w j))




end Bounty
end

section

/- An explicit exponential bound for the factorial prime-moment budget.
The constant depends only on the fixed coefficient and polynomial-growth
parameters; the upper prime-scale exponent remains arbitrary. -/

namespace Bounty

noncomputable def primeMomentExceptionalExponent (c C d : ℝ) : ℝ :=
  1 + Real.log (2 * C) + d + c * (Real.log (2 * C * (c + 1)) + d + 1)

theorem prime_moment_exceptional_exponent_one_le {c C d : ℝ}
    (hc : 0 ≤ c) (hC : 1 ≤ C) (hd : 0 ≤ d) :
    1 ≤ primeMomentExceptionalExponent c C d := by
  have hlog : 0 ≤ Real.log (2 * C) := Real.log_nonneg (by linarith)
  have hbase : 1 ≤ 2 * C * (c + 1) := by nlinarith
  have hlog' : 0 ≤ Real.log (2 * C * (c + 1)) := Real.log_nonneg hbase
  have hh := mul_nonneg hc (add_nonneg (add_nonneg hlog' hd) zero_le_one)
  unfold primeMomentExceptionalExponent
  linarith only [hlog, hd, hh]

theorem prime_moment_exceptional_budget_le_exp {N L Y P a b c C d : ℝ}
    (ha0 : 0 ≤ a) (ha1 : a ≤ 1) (hc : 0 ≤ c) (hC : 1 ≤ C) (hd : 0 ≤ d)
    (hL : Real.exp 1 ≤ L) (hY : 1 ≤ Y) (hlogY : Real.log Y ≤ c * L)
    (hPlo : Real.exp (L ^ a) / 2 ≤ P) (hPhi : P ≤ Real.exp (L ^ b))
    (hN : N ≤ (C * L ^ d) * Y * (primeMomentDegree Y P).factorial *
      ((C * L ^ d) / P) ^ primeMomentDegree Y P) :
    N ≤ Real.exp (primeMomentExceptionalExponent c C d *
      (L ^ b + L ^ (1 - a) * Real.log L)) := by
  have hL0 : 0 < L := (Real.exp_pos 1).trans_le hL
  have hL1 : 1 ≤ L := (Real.one_le_exp (by norm_num : (0 : ℝ) ≤ 1)).trans hL
  have hlogL : 1 ≤ Real.log L := (Real.le_log_iff_exp_le hL0).mpr hL
  have hC0 : 0 < C := zero_lt_one.trans_le hC
  have hP0 : 0 < P := (div_pos (Real.exp_pos _) (by norm_num : (0 : ℝ) < 2)).trans_le hPlo
  have hP1 : 1 < 2 * P := by
    have he := Real.one_lt_exp_iff.mpr (Real.rpow_pos_of_pos hL0 a)
    linarith
  let j := primeMomentDegree Y P
  let R := L ^ (1 - a)
  have hR1 : 1 ≤ R := Real.one_le_rpow hL1 (by linarith)
  have hRL : R ≤ L := by
    simpa only [Real.rpow_one] using
      (Real.rpow_le_rpow_of_exponent_le hL1 (show 1 - a ≤ 1 by linarith))
  have hj : (j : ℝ) ≤ c * R := prime_moment_degree_le hL0 hY hlogY hPlo
  have hjmax : max 1 (j : ℝ) ≤ (c + 1) * L := by
    apply max_le
    · nlinarith only [hL1, mul_nonneg hc hL0.le]
    · have hh := mul_le_mul_of_nonneg_left hRL hc
      linarith only [hj, hh, hL0]
  have hLd : 0 < L ^ d := Real.rpow_pos_of_pos hL0 d
  have hB : 0 < C * L ^ d := mul_pos hC0 hLd
  have hmax : 0 < max 1 (j : ℝ) := zero_lt_one.trans_le (le_max_left _ _)
  have hbase : 0 < 2 * (C * L ^ d) * max 1 (j : ℝ) := by positivity
  have hbudget : N ≤ (C * L ^ d) * (2 * P) *
      (2 * (C * L ^ d) * max 1 (j : ℝ)) ^ j :=
    hN.trans (prime_moment_scalar_budget hY hP1 hB.le hB.le)
  have htotal : 0 < (C * L ^ d) * (2 * P) *
      (2 * (C * L ^ d) * max 1 (j : ℝ)) ^ j := by positivity
  apply hbudget.trans
  apply (Real.log_le_iff_le_exp htotal).mp
  have hlogP : Real.log P ≤ L ^ b := (Real.log_le_iff_le_exp hP0).mpr hPhi
  have htwoC : 0 < 2 * C := by positivity
  have hcc : 0 < 2 * C * (c + 1) := by positivity
  have hpref : Real.log ((C * L ^ d) * (2 * P)) ≤
      Real.log (2 * C) + d * Real.log L + L ^ b := by
    rw [show (C * L ^ d) * (2 * P) = ((2 * C) * L ^ d) * P by ring,
      Real.log_mul (mul_pos htwoC hLd).ne' hP0.ne', Real.log_mul htwoC.ne' hLd.ne',
      Real.log_rpow hL0]
    linarith
  have hbnd : 2 * (C * L ^ d) * max 1 (j : ℝ) ≤
      (2 * C * (c + 1)) * L ^ (d + 1) := by
    calc
      _ ≤ 2 * (C * L ^ d) * ((c + 1) * L) :=
        mul_le_mul_of_nonneg_left hjmax (by positivity)
      _ = _ := by rw [Real.rpow_add hL0, Real.rpow_one]; ring
  have hlogBase : Real.log (2 * (C * L ^ d) * max 1 (j : ℝ)) ≤
      Real.log (2 * C * (c + 1)) + (d + 1) * Real.log L := by
    have hh := Real.log_le_log hbase hbnd
    rwa [Real.log_mul hcc.ne' (Real.rpow_pos_of_pos hL0 _).ne', Real.log_rpow hL0] at hh
  have hlog2C : 0 ≤ Real.log (2 * C) := Real.log_nonneg (by linarith)
  have hlogCC : 0 ≤ Real.log (2 * C * (c + 1)) := Real.log_nonneg (by nlinarith)
  have hlogBound0 : 0 ≤ Real.log (2 * C * (c + 1)) + (d + 1) * Real.log L := by positivity
  have hpowered : (j : ℝ) * Real.log (2 * (C * L ^ d) * max 1 (j : ℝ)) ≤
      c * R * (Real.log (2 * C * (c + 1)) + (d + 1) * Real.log L) :=
    (mul_le_mul_of_nonneg_left hlogBase (Nat.cast_nonneg j)).trans
      (mul_le_mul_of_nonneg_right hj hlogBound0)
  rw [Real.log_mul (mul_pos hB (by positivity)).ne' (pow_pos hbase j).ne', Real.log_pow]
  have hfirst : Real.log (2 * C) + d * Real.log L ≤
      (Real.log (2 * C) + d) * (R * Real.log L) := by
    have hRlog : 1 ≤ R * Real.log L := one_le_mul_of_one_le_of_one_le hR1 hlogL
    have h1 := mul_le_mul_of_nonneg_left hRlog hlog2C
    have h2 := mul_le_mul_of_nonneg_right hR1 (mul_nonneg hd (by linarith : 0 ≤ Real.log L))
    nlinarith only [h1, h2]
  have hsecond : c * R * (Real.log (2 * C * (c + 1)) + (d + 1) * Real.log L) ≤
      (c * (Real.log (2 * C * (c + 1)) + d + 1)) * (R * Real.log L) := by
    have hh := mul_le_mul_of_nonneg_left hlogL hlogCC
    have hh' := mul_le_mul_of_nonneg_left hh (mul_nonneg hc (by linarith : 0 ≤ R))
    nlinarith only [hh']
  have hsum : Real.log ((C * L ^ d) * (2 * P)) +
      (j : ℝ) * Real.log (2 * (C * L ^ d) * max 1 (j : ℝ)) ≤
      (Real.log (2 * C) + d + c * (Real.log (2 * C * (c + 1)) + d + 1)) *
        (R * Real.log L) + L ^ b := by
    linarith only [add_le_add hpref hpowered, add_le_add hfirst hsecond]
  refine hsum.trans ?_
  have hcoeff : 0 ≤ Real.log (2 * C) + d + c * (Real.log (2 * C * (c + 1)) + d + 1) := by positivity
  have hpos := mul_nonneg hcoeff (Real.rpow_nonneg hL0.le b)
  have hRlog0 : 0 ≤ R * Real.log L := by positivity
  dsimp only [primeMomentExceptionalExponent]
  change _ ≤ (1 + Real.log (2 * C) + d + c * (Real.log (2 * C * (c + 1)) + d + 1)) *
    (L ^ b + R * Real.log L)
  nlinarith only [hpos, hRlog0]

end Bounty
end

section

/- Removing a positive exceptional-value threshold from a moment count. -/

namespace Bounty

theorem prime_moment_remove_threshold {X B D η : ℝ} (j : ℕ) (hη : 0 < η)
    (h : X * (η ^ j) ^ 2 ≤ B * D ^ j) :
    X ≤ B * (D / η ^ 2) ^ j := by
  have he : (η ^ j) ^ 2 = (η ^ 2) ^ j := by
    rw [← pow_mul, ← pow_mul, Nat.mul_comm j 2]
  rw [he] at h
  calc
    X ≤ (B * D ^ j) / (η ^ 2) ^ j := (le_div_iff₀ (pow_pos (sq_pos_of_pos hη) j)).mpr h
    _ = B * (D / η ^ 2) ^ j := by rw [div_pow]; ring

theorem prime_moment_rpow_threshold_ratio (P A : ℝ) {L : ℝ} (hL : 0 < L) :
    (2 / P) / (L ^ (-A)) ^ 2 = 2 * L ^ (2 * A) / P := by
  rw [Real.rpow_neg hL.le, inv_pow, div_inv_eq_mul]
  have he : (L ^ A) ^ (2 : ℕ) = L ^ (2 * A) := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hL.le]
    congr 1
    ring
  rw [he]
  ring

end Bounty
end

section

/- Finite separated sampling estimates for exponential polynomials. -/

open scoped BigOperators

namespace Bounty

theorem separated_reciprocal_row_bound {ι : Type*} (s : Finset ι) (x : ι → ℝ)
    (N : ℕ) (i : ι) (hi : i ∈ s)
    (hsep : ∀ j ∈ s, ∀ k ∈ s, j ≠ k → 1 ≤ |x j - x k|)
    (hspan : ∀ j ∈ s, |x i - x j| ≤ N) :
    (∑ j ∈ s, (1 + |x i - x j|)⁻¹) ≤ 1 + 2 * (1 + Real.log N) := by
  classical
  have hl := separated_positive_reciprocal_sum (s.filter (fun j => x j < x i))
    (fun j => x i - x j) N
    (fun j hj => by
      have hj' := Finset.mem_filter.mp hj
      have hji : i ≠ j := by intro h; subst j; exact (lt_irrefl _ hj'.2)
      simpa only [abs_of_nonneg (sub_nonneg.mpr hj'.2.le)] using hsep i hi j hj'.1 hji)
    (fun j hj => by
      have hj' := Finset.mem_filter.mp hj
      simpa only [abs_of_nonneg (sub_nonneg.mpr hj'.2.le)] using hspan j hj'.1)
    (fun j hj k hk hjk => by
      have h := hsep k (Finset.mem_filter.mp hk).1 j (Finset.mem_filter.mp hj).1 hjk.symm
      convert h using 1
      congr 1
      ring)
  have hr := separated_positive_reciprocal_sum (s.filter (fun j => x i < x j))
    (fun j => x j - x i) N
    (fun j hj => by
      have hj' := Finset.mem_filter.mp hj
      have hji : j ≠ i := by intro h; subst j; exact (lt_irrefl _ hj'.2)
      simpa only [abs_of_nonneg (sub_nonneg.mpr hj'.2.le)] using hsep j hj'.1 i hi hji)
    (fun j hj => by
      have hj' := Finset.mem_filter.mp hj
      simpa only [abs_of_nonpos (sub_nonpos.mpr hj'.2.le), neg_sub] using hspan j hj'.1)
    (fun j hj k hk hjk => by
      simpa only [sub_sub_sub_cancel_right] using
        hsep j (Finset.mem_filter.mp hj).1 k (Finset.mem_filter.mp hk).1 hjk)
  have he : (∑ j ∈ s, (1 + |x i - x j|)⁻¹) = 1 +
      (∑ j ∈ s.filter (fun j => x j < x i), (1 + (x i - x j))⁻¹) +
      (∑ j ∈ s.filter (fun j => x i < x j), (1 + (x j - x i))⁻¹) := by
    have hp (j : ι) (hj : j ∈ s) : (1 + |x i - x j|)⁻¹ =
        (if j = i then 1 else 0) +
        (if x j < x i then (1 + (x i - x j))⁻¹ else 0) +
        (if x i < x j then (1 + (x j - x i))⁻¹ else 0) := by
      by_cases hji : j = i
      · subst j
        simp
      · have hne : x j ≠ x i := by
          intro h
          have h := hsep j hj i hi hji
          norm_num [‹x j = x i›] at h
        rcases lt_or_gt_of_ne hne with h | h
        · simp [hji, h, not_lt.mpr h.le, abs_of_nonneg (sub_nonneg.mpr h.le)]
        · simp [hji, h, not_lt.mpr h.le, abs_of_nonpos (sub_nonpos.mpr h.le), neg_sub]
    rw [Finset.sum_congr rfl hp]
    simp only [Finset.sum_add_distrib, Finset.sum_filter]
    simp [hi]
  rw [he]
  linarith

end Bounty
end

section

namespace Bounty

noncomputable def logarithmicDerivativeChain (u c : ℝ) : ℕ → ℝ → ℝ
  | 0, x => u * Real.log (x+c)
  | k+1, x => u * (-1:ℝ)^k * (k.factorial:ℝ) / (x+c)^(k+1)

theorem logarithmic_derivative_chain_hasDerivAt
    (u c : ℝ) (k : ℕ) (x : ℝ) (hx : 0 < x+c) :
    HasDerivAt (logarithmicDerivativeChain u c k)
      (logarithmicDerivativeChain u c (k+1) x) x := by
  cases k with
  | zero =>
    have hf : logarithmicDerivativeChain u c 0 = (fun y => u * Real.log (y+c)) := by
      funext y; rfl
    rw [hf]
    have h := (((hasDerivAt_id x).add_const c).log (ne_of_gt hx)).const_mul u
    simpa only [logarithmicDerivativeChain, id_eq, one_div, div_eq_mul_inv,
      pow_zero, pow_one, Nat.factorial_zero, Nat.cast_one, mul_one, one_mul, Nat.zero_add] using h
  | succ k =>
    change HasDerivAt (fun y => u * (-1:ℝ)^k * (k.factorial:ℝ) / (y+c)^(k+1))
      (u * (-1:ℝ)^(k+1) * ((k+1).factorial:ℝ) / (x+c)^(k+1+1)) x
    have h := (hasDerivAt_const x (u * (-1:ℝ)^k * (k.factorial:ℝ))).div
      (((hasDerivAt_id x).add_const c).pow (k+1)) (pow_ne_zero _ (ne_of_gt hx))
    simp only [Pi.pow_apply, id_eq] at h
    convert h using 1 <;> try rfl
    all_goals
      try simp only [Nat.factorial_succ, Nat.cast_mul,
        Nat.cast_add, Nat.cast_one, Nat.add_sub_cancel, mul_one, zero_mul, zero_sub,
        pow_succ]
    all_goals field_simp




section

variable
  (hs : List ℝ)
  (u c : ℝ)
  (k : ℕ)
  (x : ℝ)
  (hhs : ∀ h ∈ hs, 0 ≤ h)
  (hx : 0 < x+c)

include hs u c k x hhs hx

theorem mixed_logarithmic_difference_mean_value
     :
    ∃ y ∈ Set.Icc x (x+hs.sum),
      mixedForwardDifference hs (logarithmicDerivativeChain u c k) x =
        hs.prod * logarithmicDerivativeChain u c (k+hs.length) y := by
  apply mixed_forward_difference_mean_value hs (logarithmicDerivativeChain u c)
    (-c) hhs
  · intro k y hy
    exact logarithmic_derivative_chain_hasDerivAt u c k y (by linarith)
  · linarith

theorem mixed_logarithmic_difference_hasDerivAt
     :
    HasDerivAt (mixedForwardDifference hs (logarithmicDerivativeChain u c k))
      (mixedForwardDifference hs (logarithmicDerivativeChain u c (k+1)) x) x := by
  apply mixed_forward_difference_hasDerivAt hs _ _ (-c) hhs
  · intro y hy
    exact logarithmic_derivative_chain_hasDerivAt u c k y (by linarith)
  · linarith

end


end Bounty
end

section

namespace Bounty

theorem mixed_forward_difference_append (hs ts : List ℝ) (f : ℝ → ℝ) (x : ℝ) :
    mixedForwardDifference (hs++ts) f x =
      mixedForwardDifference hs (mixedForwardDifference ts f) x := by
  induction hs generalizing x with
  | nil => rfl
  | cons h hs ih => simp only [List.cons_append, mixedForwardDifference, ih]

end Bounty
end

section

/- Quantitative decay survives every finite iteration of the vdC recurrence. -/

namespace Bounty

section

variable
  (H B C η : ℝ)
  (m : ℕ)
  (hη : 0 ≤ η)
  (hη1 : η ≤ 1)
  (hC : 1 ≤ C)
  (hH : 2/H ≤ C*η)
  (hB : B ≤ C*η)

include H B C η m hη hη1 hC hH hB

theorem van_der_corput_scalar_le_roots  :
    vanDerCorputScalarBound H B m ≤ 5^m*C*repeatedSquareRoot m η := by
  induction m with
  | zero => simpa only [vanDerCorputScalarBound,repeatedSquareRoot,pow_zero,one_mul] using hB
  | succ m ih =>
    have hr := repeated_square_root_nonneg m hη
    have hηr := le_repeated_square_root m hη1
    have hp : (1 : ℝ) ≤ 5^m := one_le_pow₀ (by norm_num)
    have hc : 1 ≤ 5^m*C := by nlinarith
    have hCm : C ≤ 5^m*C := by nlinarith
    have hCη : C*η ≤ C*repeatedSquareRoot m η := mul_le_mul_of_nonneg_left hηr (by linarith)
    have hCr := mul_le_mul_of_nonneg_right hCm hr
    have hsum : 2/H+4*vanDerCorputScalarBound H B m ≤
        (5*(5^m*C))*repeatedSquareRoot m η := by nlinarith
    have hcoef : 5*(5^m*C) ≤ (5*(5^m*C))^2 := by nlinarith
    have hmul := mul_le_mul_of_nonneg_right hcoef hr
    have hsqrt := Real.sq_sqrt hr
    change Real.sqrt (2/H+4*vanDerCorputScalarBound H B m) ≤ _
    apply Real.sqrt_le_iff.mpr
    constructor
    · change 0 ≤ 5^(m+1)*C*Real.sqrt (repeatedSquareRoot m η)
      positivity
    · change 2/H+4*vanDerCorputScalarBound H B m ≤
        (5^(m+1)*C*Real.sqrt (repeatedSquareRoot m η))^2
      calc
        _ ≤ (5*(5^m*C))^2*repeatedSquareRoot m η := hsum.trans hmul
        _ = _ := by
          have hpow : 5^(m+1)*C = 5*(5^m*C) := by rw [pow_succ]; ring
          rw [hpow]
          symm
          rw [mul_pow,hsqrt]

theorem van_der_corput_scalar_le_rpow  :
    vanDerCorputScalarBound H B m ≤ 5^m*C*η^((2:ℝ)^m)⁻¹ := by
  simpa only [repeated_square_root_eq_rpow m hη] using
    van_der_corput_scalar_le_roots H B C η m hη hη1 hC hH hB

end


end Bounty
end

section

/- A scale lower bound bounds the number of derivative orders needed. -/

namespace Bounty

theorem long_frequency_upper_power (K : ℕ) (x N τ ε : ℝ)
    (hx : 1 ≤ x) (hτ : 0 < τ) (hε : ε ≤ 1)
    (hscale : x^(τ/2) ≤ N) (hK : 4/τ+1 ≤ (K : ℝ)) :
    x^2 ≤ N^((K : ℝ)-ε) := by
  have hxp : 0 < x := lt_of_lt_of_le (by norm_num) hx
  have hquot : 0 < 4/τ := div_pos (by norm_num) hτ
  have hexp : 0 ≤ (K : ℝ)-ε := by linarith
  have hmul : 4 ≤ ((K : ℝ)-1)*τ := (div_le_iff₀ hτ).mp (by linarith)
  have he : 2 ≤ (τ/2)*((K : ℝ)-ε) := by nlinarith
  calc
    x^2 = x^(2 : ℝ) := by norm_num
    _ ≤ x^((τ/2)*((K : ℝ)-ε)) := Real.rpow_le_rpow_of_exponent_le hx he
    _ = (x^(τ/2))^((K : ℝ)-ε) := Real.rpow_mul hxp.le _ _
    _ ≤ N^((K : ℝ)-ε) := Real.rpow_le_rpow (Real.rpow_nonneg hxp.le _) hscale hexp




end Bounty
end

section

/- A fixed indicator convention for transporting the shared bad-event weight. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def cleanAuxiliaryBadWeight {A P : Type*} [Fintype A] [DecidableEq A]
    (μ : P → ℝ) (T : Finset P) (s : A → P) : ℝ :=
  cleanAuxiliaryWeight μ s *
    (if (∃ a, s a ∈ T) ∨ ¬Function.Injective s then 1 else 0)

theorem clean_auxiliary_bad_weight_le {A P : Type*}
    [Fintype A] [DecidableEq A] [Fintype P]
    (μ : P → ℝ) (hμ0 : ∀ p, 0 ≤ μ p) (hμ : ∑ p, μ p = 1)
    (T : Finset P) (a₀ : ℝ) (ha₀ : 0 ≤ a₀) (hatom : ∀ p, μ p ≤ a₀) :
    (∑ s : A → P, cleanAuxiliaryBadWeight μ T s) ≤
      (Fintype.card A : ℝ) * (T.card + Fintype.card A) * a₀ := by
  exact clean_auxiliary_forbidden_or_repeated_mass_le μ hμ0 hμ T a₀ ha₀ hatom

end Bounty
end

section

/- Shared draws avoid endpoint prime divisors, free labels, and one another with
an explicit reciprocal-prime probability bound. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def physicalSharedForbidden {G : Type*} {P : G → Finset ℕ} {J : ℕ}
    (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C) (g : G) (w z : ℕ) : Finset (P g) :=
  univ.filter (fun p => p.val ∈ w.primeFactors ∪ z.primeFactors ∨ ∃ j, aux g j = p)

theorem physical_shared_forbidden_card {G : Type*} {P : G → Finset ℕ} {J : ℕ}
    (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C) (g : G) (w z : ℕ) :
    (physicalSharedForbidden C aux g w z).card ≤
      w.primeFactors.card + z.primeFactors.card + (C g).card := by
  have he : (physicalSharedForbidden C aux g w z).image Subtype.val ⊆
      (w.primeFactors ∪ z.primeFactors) ∪ univ.image (fun j : C g => (aux g j).val) := by
    intro p hp
    obtain ⟨a, ha, rfl⟩ := mem_image.mp hp
    rcases (mem_filter.mp ha).2 with h | ⟨j, hj⟩
    · exact mem_union_left _ h
    · exact mem_union_right _ (mem_image.mpr ⟨j, mem_univ _, congrArg Subtype.val hj⟩)
  calc
    _ = ((physicalSharedForbidden C aux g w z).image Subtype.val).card :=
      (card_image_of_injective _ Subtype.val_injective).symm
    _ ≤ ((w.primeFactors ∪ z.primeFactors) ∪ univ.image (fun j : C g => (aux g j).val)).card :=
      card_le_card he
    _ ≤ (w.primeFactors ∪ z.primeFactors).card +
        (univ.image (fun j : C g => (aux g j).val)).card := card_union_le _ _
    _ ≤ _ := add_le_add (card_union_le _ _) ((card_image_le).trans_eq (by simp))

theorem physical_shared_forbidden_log_card {G : Type*} {P : G → Finset ℕ} {J : ℕ}
    (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C) (g : G)
    {w z : ℕ} (hw : 0 < w) (hz : 0 < z) :
    ((physicalSharedForbidden C aux g w z).card : ℝ) ≤
      Real.log w / Real.log 2 + Real.log z / Real.log 2 + (C g).card := by
  calc
    _ ≤ (w.primeFactors.card : ℝ) + z.primeFactors.card + (C g).card := by
      exact_mod_cast physical_shared_forbidden_card C aux g w z
    _ ≤ _ := add_le_add (add_le_add (primeFactors_card_le_log_div_log_two hw)
      (primeFactors_card_le_log_div_log_two hz)) le_rfl

theorem physical_mem_shared_forbidden_iff {G : Type*} {P : G → Finset ℕ} {J : ℕ}
    (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C) (g : G)
    (hprime : ∀ p ∈ P g, p.Prime) {w z : ℕ} (hw : 0 < w) (hz : 0 < z) (p : P g) :
    p ∈ physicalSharedForbidden C aux g w z ↔
      p.val ∣ w ∨ p.val ∣ z ∨ ∃ j, aux g j = p := by
  simp only [physicalSharedForbidden, mem_filter, mem_univ, true_and, mem_union]
  constructor
  · rintro ((h | h) | h)
    · exact Or.inl (Nat.dvd_of_mem_primeFactors h)
    · exact Or.inr (Or.inl (Nat.dvd_of_mem_primeFactors h))
    · exact Or.inr (Or.inr h)
  · rintro (h | h | h)
    · exact Or.inl (Or.inl ((hprime _ p.property).mem_primeFactors h (by omega)))
    · exact Or.inl (Or.inr ((hprime _ p.property).mem_primeFactors h (by omega)))
    · exact Or.inr h

end Bounty
end

section

/- Actual finite shift products and frequency ranges imply the terminal curvature powers. -/

namespace Bounty

theorem terminal_shift_product_bounds (hs : List ℝ) {N eps : ℝ} {k : ℕ}
    (hN : 1 ≤ N) (heps : 0 ≤ eps) (hk : 2 ≤ k) (hlen : hs.length = k-2)
    (hhs : ∀ h ∈ hs, 1 ≤ h ∧ h ≤ (⌊N^(eps/(2*(k : ℝ)))⌋₊ : ℝ)) :
    1 ≤ hs.prod ∧ hs.prod ≤ N^(eps/2) := by
  have hN0 : 0 < N := by linarith
  have hk0 : (k : ℝ) ≠ 0 := by exact_mod_cast (show k ≠ 0 by omega)
  have he : 0 ≤ eps/(2*(k : ℝ)) := by positivity
  have hbase : 1 ≤ N^(eps/(2*(k : ℝ))) := Real.one_le_rpow hN he
  have hfloor : (⌊N^(eps/(2*(k : ℝ)))⌋₊ : ℝ) ≤ N^(eps/(2*(k : ℝ))) :=
    Nat.floor_le (by positivity)
  refine ⟨List.one_le_prod (fun h hh => (hhs h hh).1),?_⟩
  have hp : hs.prod ≤ (N^(eps/(2*(k : ℝ))))^hs.length := by
    have h := List.prod_map_le_prod_map₀ (s := hs)
      (fun x : ℝ => x) (fun _ : ℝ => N^(eps/(2*(k : ℝ))))
      (fun h hh => (show 0 ≤ h by linarith [(hhs h hh).1]))
      (fun h hh => ((hhs h hh).2).trans hfloor)
    simpa only [List.map_id',List.map_const',List.prod_replicate] using h
  calc
    hs.prod ≤ (N^(eps/(2*(k : ℝ))))^hs.length := hp
    _ ≤ (N^(eps/(2*(k : ℝ))))^k := pow_le_pow_right₀ hbase (by omega)
    _ = N^(eps/2) := by
      rw [← Real.rpow_mul_natCast hN0.le]
      congr 1
      field_simp

theorem scaled_curvature_power_bounds {N eps K P T : ℝ} {k : ℕ}
    (hN : 1 ≤ N) (hK : 0 ≤ K) (hPlo : 1 ≤ P) (hPhi : P ≤ N^(eps/2))
    (hTlo : N^((k : ℝ)-2+eps) ≤ T) (hThi : T ≤ N^((k : ℝ)-eps)) :
    K*N^(-2+eps) ≤ K*P*T/N^k ∧ K*P*T/N^k ≤ K*N^(-eps/2) := by
  have hN0 : 0 < N := by linarith
  have hT0 : 0 ≤ T := (Real.rpow_pos_of_pos hN0 _).le.trans hTlo
  have hp : N^((k : ℝ)-2+eps) ≤ P*T := by
    have h := mul_le_mul_of_nonneg_right hPlo hT0
    simp only [one_mul] at h
    exact hTlo.trans h
  have hq : P*T ≤ N^((k : ℝ)-eps/2) := by
    have h := mul_le_mul hPhi hThi hT0 (Real.rpow_nonneg hN0.le _)
    rw [← Real.rpow_add hN0] at h
    have he : eps/2+((k : ℝ)-eps) = (k : ℝ)-eps/2 := by ring
    rwa [he] at h
  have hquot (x : ℝ) : N^x/N^k = N^(x-(k : ℝ)) := by
    rw [Real.rpow_sub hN0,Real.rpow_natCast]
  constructor
  · calc
      K*N^(-2+eps) = K*N^((k : ℝ)-2+eps)/N^k := by
        rw [mul_div_assoc,hquot]
        congr 1
        congr 1
        ring
      _ ≤ K*(P*T)/N^k := div_le_div_of_nonneg_right
        (mul_le_mul_of_nonneg_left hp hK) (by positivity)
      _ = _ := by ring
  · calc
      K*P*T/N^k ≤ K*N^((k : ℝ)-eps/2)/N^k := div_le_div_of_nonneg_right
        (by simpa only [mul_assoc] using mul_le_mul_of_nonneg_left hq hK) (by positivity)
      _ = K*N^(-eps/2) := by
        rw [mul_div_assoc,hquot]
        congr 1
        congr 1
        ring

end Bounty
end

section

/- Literal progression sums transfer cancellation through a rough-integer divisor majorant. -/

open Finset

namespace Bounty

theorem rough_interval_oscillation_of_divisor_sums
    (a b : ℕ) (lam : ℕ → ℝ) (F : ℕ → ℂ) {z Y Q M E : ℝ}
    (hY : 0 ≤ Y) (hQ : 0 ≤ Q)
    (hpoint : ∀ n : ℕ, n ≠ 0 →
      (if ∀ p ∈ n.primeFactors, z < (p : ℝ) then (1 : ℝ) else 0) ≤
        ∑ d ∈ n.divisors, lam d)
    (hF : ∀ n ∈ Ioc a b, ‖F n‖ ≤ 1)
    (hover : (∑ n ∈ Ioc a b, ∑ d ∈ n.divisors, lam d)-
      (((Ioc a b).filter (fun n : ℕ => ∀ p ∈ n.primeFactors, z < (p : ℝ))).card : ℝ) ≤ E)
    (hmass : (∑ d ∈ Icc 1 b, |lam d|/(d : ℝ)) ≤ M)
    (hdiv : ∀ d ∈ Icc 1 b, lam d ≠ 0 →
      ‖∑ n ∈ (Ioc a b).filter (fun n => d ∣ n), F n‖ ≤ Y*Q/(d : ℝ)) :
    ‖∑ n ∈ (Ioc a b).filter (fun n : ℕ => ∀ p ∈ n.primeFactors, z < (p : ℝ)), F n‖ ≤
      E+Y*Q*M := by
  have hd := rough_divisor_majorant_complex_error lam a b F (by norm_num : (0 : ℝ) ≤ 1)
    hpoint hF hover
  rw [one_mul] at hd
  have hm := interval_divisor_sum_norm_bound a b (fun d => (lam d : ℂ)) F
    (fun d => Y*Q/(d : ℝ)) (by
      intro d hd hne
      apply hdiv d hd
      intro hz
      exact hne (by simp [hz]))
  have hcoeff : (∑ d ∈ Icc 1 b, ‖(lam d : ℂ)‖*(Y*Q/(d : ℝ))) ≤ Y*Q*M := by
    calc
      _ = Y*Q*(∑ d ∈ Icc 1 b, |lam d|/(d : ℝ)) := by
        rw [mul_sum]
        apply sum_congr rfl
        intro d hd
        rw [Complex.norm_real,Real.norm_eq_abs]
        ring
      _ ≤ _ := mul_le_mul_of_nonneg_left hmass (mul_nonneg hY hQ)
  have hm' : ‖∑ n ∈ Ioc a b, ((∑ d ∈ n.divisors, lam d : ℝ) : ℂ)*F n‖ ≤ Y*Q*M := by
    push_cast
    exact hm.trans hcoeff
  have ht := norm_sub_norm_le
    (∑ n ∈ (Ioc a b).filter (fun n : ℕ => ∀ p ∈ n.primeFactors, z < (p : ℝ)), F n)
    (∑ n ∈ Ioc a b, ((∑ d ∈ n.divisors, lam d : ℝ) : ℂ)*F n)
  linarith

end Bounty
end

section

/- Quotients by a pool-free divisor commute with removal of the pool part. -/

namespace Bounty

theorem primePoolFreePart_div_of_free (P : Finset ℕ) {d n : ℕ}
    (hn : n ≠ 0) (hd : d ∣ n) (hfree : Disjoint d.primeFactors P) :
    primePoolFreePart P (n / d) = primePoolFreePart P n / d := by
  have he : d * (n / d) = n := Nat.mul_div_cancel' hd
  have hd0 : d ≠ 0 := by intro h; apply hn; rw [← he, h, zero_mul]
  have hq0 : n / d ≠ 0 := by intro h; apply hn; rw [← he, h, mul_zero]
  have hf := congrArg (primePoolFreePart P) he
  rw [primePoolFreePart_mul P hd0 hq0,
    primePoolFreePart_eq_self_of_disjoint P hd0 hfree] at hf
  rw [← hf]
  exact (Nat.mul_div_cancel_left _ (Nat.pos_of_ne_zero hd0)).symm

theorem invariant_pool_free_divisor_weight (P : Finset ℕ) (W : ℕ → ℂ)
    (hW : ∀ a b : ℕ, b ≠ 0 → Disjoint b.primeFactors P → W (a * b) = W a)
    {d n : ℕ} (hn : n ≠ 0) (hd : d ∣ n) (hfree : Disjoint d.primeFactors P) :
    W n = W (n / d) := by
  have hd0 : d ≠ 0 := by
    intro h
    rw [h] at hd
    simp only [zero_dvd_iff] at hd
    exact hn hd
  simpa only [Nat.div_mul_cancel hd] using hW (n / d) d hd0 hfree

end Bounty
end

section

/- Assemble explicit analytic inputs with the ordered scalar saving budget. -/

open MeasureTheory Set

namespace Bounty

theorem three_regime_integral_decay (R : ℝ) (S Q M T : ℝ → ℂ)
    (hS : Continuous S) (hQ : Continuous Q) (hM : Continuous M) (hT : Continuous T)
    {L A Cmean Csparse s q t As H B B0 : ℝ} (hL : 4 ≤ L)
    (hAs : A + Cmean + 1 ≤ 2 * As)
    (hH : A + 2 * s + Csparse + 1 ≤ 2 * H)
    (hB : A + B0 + 2 * s + 2 * q + 2 * t + 1 ≤ 2 * B)
    (hSbound : ∀ u ∈ Icc (-R) R, ‖S u‖ ≤ L ^ s)
    (hQbound : ∀ u ∈ Icc (-R) R, ‖Q u‖ ≤ L ^ q)
    (hTbound : ∀ u ∈ Icc (-R) R, ‖T u‖ ≤ L ^ t)
    (hhigh : ∀ u ∈ Icc (-R) R, L ^ (-As) < ‖S u‖ →
      L ^ B0 < |u| → ‖Q u‖ ≤ L ^ (-H))
    (hlow : ∀ u ∈ Icc (-R) R, |u| ≤ L ^ B0 → ‖M u‖ ≤ L ^ (-B))
    (hmean : (∫ u in Icc (-R) R, ‖Q u * M u * T u‖ ^ 2) ≤ L ^ Cmean)
    (hsparse : (∫ u in {u ∈ Icc (-R) R | L ^ (-As) < ‖S u‖},
      ‖M u * T u‖ ^ 2) ≤ L ^ Csparse) :
    (∫ u in Icc (-R) R, ‖S u * Q u * M u * T u‖ ^ 2) ≤ L ^ (-A) := by
  have hL0 : 0 < L := by linarith
  have hn (z : ℝ) : 0 ≤ L ^ z := Real.rpow_nonneg hL0.le z
  calc
    _ ≤ (L ^ (-As)) ^ (2 : ℕ) * (∫ u in Icc (-R) R, ‖Q u * M u * T u‖ ^ 2) +
        (L ^ s) ^ (2 : ℕ) * (L ^ (-H)) ^ (2 : ℕ) *
          (∫ u in {u ∈ Icc (-R) R | L ^ (-As) < ‖S u‖}, ‖M u * T u‖ ^ 2) +
        2 * L ^ B0 * (L ^ s) ^ (2 : ℕ) * (L ^ q) ^ (2 : ℕ) *
          (L ^ (-B)) ^ (2 : ℕ) * (L ^ t) ^ (2 : ℕ) :=
      three_regime_integral_bound R (L ^ B0) (L ^ (-As)) (L ^ s) (L ^ q)
        (L ^ (-H)) (L ^ (-B)) (L ^ t) S Q M T hS hQ hM hT
        (hn _) (hn _) (hn _) (hn _) (hn _) (hn _) (hn _)
        hSbound hQbound hTbound hhigh hlow
    _ ≤ (L ^ (-As)) ^ (2 : ℕ) * L ^ Cmean +
        (L ^ s) ^ (2 : ℕ) * (L ^ (-H)) ^ (2 : ℕ) * L ^ Csparse +
        2 * L ^ B0 * (L ^ s) ^ (2 : ℕ) * (L ^ q) ^ (2 : ℕ) *
          (L ^ (-B)) ^ (2 : ℕ) * (L ^ t) ^ (2 : ℕ) := by
      gcongr
    _ ≤ _ := three_regime_power_budget hL hAs hH hB

end Bounty
end

section

/- A finite cover by unit intervals controls the integral over a measurable
exceptional set by the actual continuous squared-norm suprema. Overlap is
allowed; no disjointness or choice of sample points is required. -/

open Finset Set MeasureTheory
open scoped Classical

namespace Bounty

theorem unit_interval_energy_le_sup (F : ℝ → ℂ) (hF : Continuous F)
    (j : ℤ) {t : ℝ} (ht : t ∈ Icc (j : ℝ) ((j : ℝ) + 1)) :
    ‖F t‖ ^ 2 ≤ unitIntervalEnergySup F j := by
  apply le_csSup ((isCompact_Icc.image (hF.norm.pow 2)).bddAbove)
  exact mem_image_of_mem _ ht

theorem unit_interval_cover_energy (indices : Finset ℤ) (E : Set ℝ)
    (hE : MeasurableSet E) (F : ℝ → ℂ) (hF : Continuous F)
    (hcover : ∀ t ∈ E, ∃ j ∈ indices, t ∈ Icc (j : ℝ) ((j : ℝ) + 1)) :
    IntegrableOn (fun t => ‖F t‖ ^ 2) E ∧
      (∫ t in E, ‖F t‖ ^ 2) ≤ ∑ j ∈ indices, unitIntervalEnergySup F j := by
  let g (j : ℤ) : ℝ → ℝ :=
    (Icc (j : ℝ) ((j : ℝ) + 1)).indicator (fun _ => unitIntervalEnergySup F j)
  have hg0 (j : ℤ) (t : ℝ) : 0 ≤ g j t := by
    exact indicator_nonneg (fun _ _ => unit_interval_energy_sup_nonneg F hF j) t
  have hgi (j : ℤ) : Integrable (g j) := by
    apply (integrable_indicator_iff measurableSet_Icc).mpr
    exact integrableOn_const isCompact_Icc.measure_ne_top
  have hsum : Integrable (fun t => ∑ j ∈ indices, g j t) := by
    exact integrable_finsetSum indices (fun j _ => hgi j)
  have hdom (t : ℝ) : E.indicator (fun t => ‖F t‖ ^ 2) t ≤
      ∑ j ∈ indices, g j t := by
    by_cases ht : t ∈ E
    · rw [indicator_of_mem ht]
      obtain ⟨j, hj, htj⟩ := hcover t ht
      calc
        ‖F t‖ ^ 2 ≤ unitIntervalEnergySup F j := unit_interval_energy_le_sup F hF j htj
        _ = g j t := by simp only [g, indicator_of_mem htj]
        _ ≤ ∑ j ∈ indices, g j t := Finset.single_le_sum (fun k _ => hg0 k t) hj
    · rw [indicator_of_notMem ht]
      exact Finset.sum_nonneg (fun j _ => hg0 j t)
  have hfi : Integrable (E.indicator (fun t => ‖F t‖ ^ 2)) := by
    apply hsum.mono' ((hF.norm.pow 2).aestronglyMeasurable.indicator hE)
    apply Filter.Eventually.of_forall
    intro t
    change |E.indicator (fun t => ‖F t‖ ^ 2) t| ≤ _
    rw [abs_of_nonneg (indicator_nonneg (fun t _ => sq_nonneg ‖F t‖) t)]
    exact hdom t
  refine ⟨(integrable_indicator_iff hE).mp hfi, ?_⟩
  calc
    (∫ t in E, ‖F t‖ ^ 2) = ∫ t, E.indicator (fun t => ‖F t‖ ^ 2) t :=
      (integral_indicator hE).symm
    _ ≤ ∫ t, ∑ j ∈ indices, g j t := integral_mono hfi hsum hdom
    _ = ∑ j ∈ indices, ∫ t, g j t := integral_finsetSum indices (fun j _ => hgi j)
    _ = ∑ j ∈ indices, unitIntervalEnergySup F j := by
      apply Finset.sum_congr rfl
      intro j _
      simp only [g, integral_indicator_const _ measurableSet_Icc, Real.volume_real_Icc,
        add_sub_cancel_left, smul_eq_mul]
      norm_num

theorem exceptional_integral_le_unit_suprema (indices : Finset ℤ) (E : Set ℝ)
    (hE : MeasurableSet E) (F : ℝ → ℂ) (hF : Continuous F)
    (hcover : ∀ t ∈ E, ∃ j ∈ indices, t ∈ Icc (j : ℝ) ((j : ℝ) + 1)) :
    (∫ t in E, ‖F t‖ ^ 2) ≤ ∑ j ∈ indices, unitIntervalEnergySup F j :=
  (unit_interval_cover_energy indices E hE F hF hcover).2

end Bounty
end

section

/- Energy assembly for a finite dyadic decomposition, allowing overlaps. -/

open Finset Set MeasureTheory

namespace Bounty

theorem finite_sum_integral_norm_sq_le_card {ι : Type*} (s : Finset ι)
    (F : ι → ℝ → ℂ) (hF : ∀ j, Continuous (F j)) {E : Set ℝ} {R : ℝ}
    (hE : MeasurableSet E) (hER : E ⊆ Icc (-R) R) :
    (∫ t in E, ‖∑ j ∈ s, F j t‖ ^ 2) ≤
      (s.card : ℝ) * ∑ j ∈ s, ∫ t in E, ‖F j t‖ ^ 2 := by
  have hi (j : ι) : IntegrableOn (fun t => ‖F j t‖ ^ 2) E :=
    (((hF j).norm.pow 2).continuousOn.integrableOn_Icc).mono_set hER
  have hscont : Continuous (fun t => ‖∑ j ∈ s, F j t‖ ^ 2) := by fun_prop
  have hsi : IntegrableOn (fun t => ‖∑ j ∈ s, F j t‖ ^ 2) E :=
    hscont.continuousOn.integrableOn_Icc.mono_set hER
  have hr : IntegrableOn (fun t => (s.card : ℝ) * ∑ j ∈ s, ‖F j t‖ ^ 2) E :=
    (integrable_finsetSum s (fun j _ => hi j)).const_mul _
  calc
    _ ≤ ∫ t in E, (s.card : ℝ) * ∑ j ∈ s, ‖F j t‖ ^ 2 :=
      setIntegral_mono_on hsi hr hE (fun t _ => finite_complex_sum_norm_sq_le_card s (fun j => F j t))
    _ = _ := by rw [integral_const_mul, integral_finsetSum s (fun j _ => hi j)]

theorem finite_sum_integral_energy_power {ι : Type*} (s : Finset ι)
    (F : ι → ℝ → ℂ) (hF : ∀ j, Continuous (F j)) {E : Set ℝ} {R L C k : ℝ}
    (hE : MeasurableSet E) (hER : E ⊆ Icc (-R) R) (hL : 0 < L)
    (hcard : (s.card : ℝ) ≤ L ^ k)
    (henergy : ∀ j ∈ s, (∫ t in E, ‖F j t‖ ^ 2) ≤ L ^ C) :
    (∫ t in E, ‖∑ j ∈ s, F j t‖ ^ 2) ≤ L ^ (C + 2 * k) := by
  calc
    _ ≤ (s.card : ℝ) * ∑ j ∈ s, ∫ t in E, ‖F j t‖ ^ 2 :=
      finite_sum_integral_norm_sq_le_card s F hF hE hER
    _ ≤ (s.card : ℝ) * ∑ _j ∈ s, L ^ C :=
      mul_le_mul_of_nonneg_left (Finset.sum_le_sum henergy) (Nat.cast_nonneg _)
    _ = (s.card : ℝ) * ((s.card : ℝ) * L ^ C) := by simp
    _ ≤ L ^ k * (L ^ k * L ^ C) := by gcongr
    _ = L ^ (C + 2 * k) := by rw [← Real.rpow_add hL, ← Real.rpow_add hL]; congr 1; ring

end Bounty
end

section

/- Natural residue intervals embed exactly into integer progression intervals. -/

open Finset

namespace Bounty

theorem natural_residue_interval_cast (a b : ℕ) {q : ℕ} [NeZero q]
    (r : ZMod q) (F : ℤ → ℂ) :
    ∑ n ∈ (Ioc a b).filter (fun n : ℕ => (n : ZMod q) = r), F (n : ℤ) =
      ∑ z ∈ (Ioc (a : ℤ) (b : ℤ)).filter (fun z : ℤ => (z : ZMod q) = r), F z := by
  classical
  apply sum_bij (fun (n : ℕ) _ => (n : ℤ))
  · intro n hn
    obtain ⟨hn,hr⟩ := mem_filter.mp hn
    obtain ⟨hl,hu⟩ := mem_Ioc.mp hn
    exact mem_filter.mpr ⟨mem_Ioc.mpr ⟨by exact_mod_cast hl,by exact_mod_cast hu⟩,
      by simpa only [Int.cast_natCast] using hr⟩
  · intro n hn m hm he
    exact_mod_cast he
  · intro z hz
    obtain ⟨hz,hr⟩ := mem_filter.mp hz
    obtain ⟨hl,hu⟩ := mem_Ioc.mp hz
    have hz0 : 0 ≤ z := by omega
    have he : (z.toNat : ℤ) = z := Int.toNat_of_nonneg hz0
    refine ⟨z.toNat,mem_filter.mpr ⟨mem_Ioc.mpr ⟨by omega,by omega⟩,?_⟩,he⟩
    have hc := congrArg (fun t : ℤ => (t : ZMod q)) he
    simpa only [Int.cast_natCast] using hc.trans hr
  · intro n hn
    rfl

theorem natural_residue_interval_sum (a b : ℕ) {q : ℕ} [NeZero q]
    (r : ZMod q) (F : ℤ → ℂ) :
    ∑ n ∈ (Ioc a b).filter (fun n : ℕ => (n : ZMod q) = r), F (n : ℤ) =
      ∑ y ∈ Icc (((a : ℤ)-(r.val : ℤ))/(q : ℤ)+1) (((b : ℤ)-(r.val : ℤ))/(q : ℤ)),
        F (y*(q : ℤ)+r.val) := by
  rw [natural_residue_interval_cast,integer_residue_interval_sum]

end Bounty
end

section

/- The explicit sieve level leaves exponentially long progressions for polynomial moduli. -/

open Filter

namespace Bounty

theorem eventually_long_rough_sieve_scales {a : ℝ} (ha : 0 < a) (T N0 : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ Y q : ℝ, Real.exp (a*L) ≤ Y → 0 < q → q ≤ L^T →
      let Z := (Real.exp (Real.sqrt L))^(4*(roughCellSieveOrder L : ℝ)+2)
      N0 ≤ Y/(Z*q) ∧
      (Real.exp L)^(a/2) ≤ Y/(Z*q) ∧
      Z/Y ≤ Real.exp (-(a/2)*L) ∧
      Real.log (2*Real.exp (Real.sqrt L)) ≤ 2*L := by
  have hmod := eventually_exp_neg_rpow_mul_rpow_le
    (by norm_num : (0 : ℝ) < 1) (show 0 < a/4 by positivity) T 0
  have hthreshold := (Real.tendsto_exp_atTop.comp
    (tendsto_id.const_mul_atTop (half_pos ha))).eventually_ge_atTop N0
  filter_upwards [eventually_rough_cell_sieve_level_le (show 0 < a/2 by positivity),
    hmod,hthreshold,eventually_ge_atTop (1 : ℝ)] with L hlevel hmodL hthresholdL hL
  intro Y q hY hq hqT
  dsimp only
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hY0 : 0 < Y := (Real.exp_pos _).trans_le hY
  let Z := (Real.exp (Real.sqrt L))^(4*(roughCellSieveOrder L : ℝ)+2)
  have hZ0 : 0 < Z := by dsimp [Z]; positivity
  have hZ : Z ≤ Real.exp ((a/4)*L) := by
    have he : a/2/2 = a/4 := by ring
    simpa only [he] using hlevel
  have hmod' : L^T ≤ Real.exp ((a/4)*L) := by
    simp only [Real.rpow_one,neg_zero,Real.rpow_zero] at hmodL
    have hm := mul_le_mul_of_nonneg_left hmodL (Real.exp_pos ((a/4)*L)).le
    have he : Real.exp ((a/4)*L)*Real.exp (-(a/4)*L) = 1 := by
      rw [← Real.exp_add]
      have he' : (a/4)*L + -(a/4)*L = 0 := by ring
      rw [he',Real.exp_zero]
    simpa only [← mul_assoc,he,one_mul,mul_one] using hm
  have hprod : Z*q ≤ Real.exp ((a/2)*L) := by
    calc
      _ ≤ Real.exp ((a/4)*L)*Real.exp ((a/4)*L) :=
        mul_le_mul hZ (hqT.trans hmod') hq.le (Real.exp_pos _).le
      _ = _ := by rw [← Real.exp_add]; congr 1; ring
  have hN : Real.exp ((a/2)*L) ≤ Y/(Z*q) := by
    apply (le_div_iff₀ (mul_pos hZ0 hq)).mpr
    calc
      _ ≤ Real.exp ((a/2)*L)*Real.exp ((a/2)*L) :=
        mul_le_mul_of_nonneg_left hprod (Real.exp_pos _).le
      _ = Real.exp (a*L) := by rw [← Real.exp_add]; congr 1; ring
      _ ≤ Y := hY
  refine ⟨hthresholdL.trans hN,?_,?_,?_⟩
  · change (Real.exp L)^(a/2) ≤ Y/(Z*q)
    simpa only [← Real.exp_mul,mul_comm L] using hN
  · apply (div_le_iff₀ hY0).mpr
    calc
      Z ≤ Real.exp ((a/4)*L) := hZ
      _ ≤ Real.exp ((a/2)*L) := Real.exp_le_exp.mpr (by nlinarith)
      _ = Real.exp (-(a/2)*L)*Real.exp (a*L) := by
        rw [← Real.exp_add]; congr 1; ring
      _ ≤ _ := mul_le_mul_of_nonneg_left hY (Real.exp_pos _).le
  · rw [Real.log_mul (by norm_num) (Real.exp_ne_zero _),Real.log_exp]
    have hs : Real.sqrt L ≤ L := by
      apply (Real.sqrt_le_iff).mpr
      exact ⟨hL0.le,by nlinarith⟩
    have ht := Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 2)
    linarith

end Bounty
end

