/- The actual local Fourier scale is large and subexponential for every
nonzero pair of occupied cell-character tests. -/

open Finset Filter
open scoped Classical
namespace Bounty

theorem eventually_candidate_cell_local_scale {c b : ℝ}
    (hc : 0 < c) (hb : 0 < b) (J : ℕ) (K q W : ℝ) (hq : 0 ≤ q) (hW : 0 ≤ W) :
    ∀ᶠ L : ℝ in atTop, ∀ (S : Finset ℕ), S ⊆ candidatePIndices c L →
      let P := fun g : S => candidatePBand (c*L) g.val
      ∀ (ell : ℕ) (probes : S → Finset (Fin J)) (r t : Finset S)
        (A B : Finset (RepeatedBigFlatIndex S J ell)),
        A ⊆ r.sigma (repeatedBigPrimeProbeSlots probes) → A.Nonempty →
        B ⊆ t.sigma (repeatedBigPrimeProbeSlots probes) → B.Nonempty →
      ∀ (Q : ℕ) (h : ℝ), 0 < h → h ≤ 1 →
      ∀ (d e : ℤ) (χ ψ : BoundedPrimitiveCharacter Q) (ζ : ℝ),
        (∃ x : (∀ i : A, P i.val.1),
          (starRingEnd ℂ) (primeProductCellCharacter (fun i : A => P i.val.1) h d χ x) *
            physicalPhase ζ (∏ i, (x i).val) ≠ 0) →
        (∃ y : (∀ i : B, P i.val.1),
          (starRingEnd ℂ) (primeProductCellCharacter (fun i : B => P i.val.1) h e ψ y) *
            physicalPhase ζ (∏ i, (y i).val) ≠ 0) →
      ∀ (k : ℤ), k ≠ 0 → |(k : ℝ)| ≤ L^K →
        let HA := Real.exp (((d : ℝ)-1)*h)
        let HB := Real.exp (((e : ℝ)-1)*h)
        let H := |(k : ℝ)| *HA*HB/L^q
        L^W ≤ H ∧ H ≤ Real.exp ((b/2)*L) := by
  filter_upwards [eventually_candidate_occupied_cell_scale hc
      (show 0 < b/8 by positivity) J (q+W),
    eventually_rpow_le_exp_linear K (show 0 < b/4 by positivity),
    eventually_ge_atTop (1 : ℝ)] with L hcell hpoly hL
  intro S hS P ell probes r t A B hA hAne hB hBne Q h hh hh1 d e χ ψ ζ hXA hXB k hk hkK
  let HA := Real.exp (((d : ℝ)-1)*h)
  let HB := Real.exp (((e : ℝ)-1)*h)
  change L^W ≤ |(k : ℝ)| *HA*HB/L^q ∧ |(k : ℝ)| *HA*HB/L^q ≤ Real.exp ((b/2)*L)
  obtain ⟨hAl, hAu⟩ : L^(q+W) ≤ HA ∧ HA ≤ Real.exp ((b/8)*L) :=
    hcell S hS ell probes r A hA hAne Q h hh hh1 d χ ζ hXA
  obtain ⟨hBl, hBu⟩ : L^(q+W) ≤ HB ∧ HB ≤ Real.exp ((b/8)*L) :=
    hcell S hS ell probes t B hB hBne Q h hh hh1 e ψ ζ hXB
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hp : 0 < L^q := Real.rpow_pos_of_pos hL0 q
  have hp1 : 1 ≤ L^q := Real.one_le_rpow hL hq
  have hHA0 : 0 ≤ HA := (Real.exp_pos _).le
  have hHB0 : 0 ≤ HB := (Real.exp_pos _).le
  have hnum0 : 0 ≤ |(k : ℝ)| *HA*HB :=
    mul_nonneg (mul_nonneg (abs_nonneg _) hHA0) hHB0
  have hHB1 : 1 ≤ HB := (Real.one_le_rpow hL (add_nonneg hq hW)).trans hBl
  have hk1 : 1 ≤ |(k : ℝ)| := by
    have hz : (0 : ℤ) < |k| := abs_pos.mpr hk
    have hi : (1 : ℤ) ≤ |k| := by omega
    exact_mod_cast hi
  constructor
  · apply (le_div_iff₀ hp).mpr
    calc
      L^W*L^q = L^(q+W) := by
        rw [← Real.rpow_add hL0]
        congr 1
        ring
      _ = 1*L^(q+W)*1 := by ring
      _ ≤ |(k : ℝ)| *HA*HB := by gcongr
  · have hkexp : |(k : ℝ)| ≤ Real.exp ((b/4)*L) := hkK.trans hpoly
    calc
      _ ≤ |(k : ℝ)| *HA*HB := div_le_self hnum0 hp1
      _ ≤ Real.exp ((b/4)*L)*Real.exp ((b/8)*L)*Real.exp ((b/8)*L) := by gcongr
      _ = Real.exp ((b/2)*L) := by
        rw [← Real.exp_add, ← Real.exp_add]
        congr 1
        ring

end Bounty
end

