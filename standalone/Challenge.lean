lemma idealRowHom_two_prime (p:(_root_.OAI.ActualEisensteinCubic.O)) (hp:Prime p) (hprimary:lambda^2∣p-1)
    (hs:Supported (Ideal.span {p})) :
    idealRowHom (2:(_root_.OAI.ActualEisensteinCubic.O)) (Ideal.span {p})=twoSupplement p := by
  letI := @OAI.ConcretePrimeRowBridge.instIsPrincipalIdealRingO
  letI := cubicTwoIdeal_isMaximal
  let:(Ideal.span {p}).IsMaximal:=PrincipalIdealRing.isMaximal_of_irreducible hp.irreducible
  let:Field ((_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {p}):=Ideal.Quotient.field _
  let:Fintype ((_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {p}):=Fintype.ofFinite _
  obtain ⟨hg,hc⟩:=supported_prime_data p hp hs
  have h2:idealRowHom (2:(_root_.OAI.ActualEisensteinCubic.O)) (Ideal.span {p})^2=cubicTwoSupplement p:=by
    rw [idealRowHom_prime _ _ hg]
    have he:=canonicalSextic_four_eq_fixed_two (Ideal.span {p}) hg p rfl hprimary
    have hfour:Ideal.Quotient.mk (Ideal.span {p}) (4:(_root_.OAI.ActualEisensteinCubic.O))=
      (Ideal.Quotient.mk (Ideal.span {p}) (2:(_root_.OAI.ActualEisensteinCubic.O)))^2:=by norm_num [map_ofNat]
    rw [hfour,map_pow] at he
    change (actualSextic (Ideal.span {p}) hg) (Ideal.Quotient.mk _ 2)^2=
      (actualSextic cubicTwoIdeal cubicTwoIdeal_good ^ 2) (Ideal.Quotient.mk cubicTwoIdeal p)
    rw [canonicalSextic_pow_two]
    exact he
  have h3:idealRowHom (2:(_root_.OAI.ActualEisensteinCubic.O)) (Ideal.span {p})^3=quadraticTwoSupplement p:=by
    rw [idealRowHom_prime _ _ hg,←MulChar.pow_apply' _ (by decide : (3:ℕ)≠0),actualSextic_cube_quadratic]
    change ((quadraticChar ((_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {p}) (Ideal.Quotient.mk _ (2:(_root_.OAI.ActualEisensteinCubic.O))):ℤ):ℂ)=_
    simp only [map_ofNat]
    rw [quadraticChar_two hc]
    have hn:Ideal.absNorm (Ideal.span {p})=Fintype.card ((_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {p}):=by
      rw [Ideal.absNorm_apply,Submodule.cardQuot_apply,Nat.card_eq_fintype_card]
    change ((ZMod.χ₈ (Fintype.card ((_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {p})):ℤ):ℂ)=
      ((ZMod.χ₈ (Ideal.absNorm (Ideal.span {p})):ℤ):ℂ)
    rw [hn]
  have hn2:(2:(_root_.OAI.ActualEisensteinCubic.O))∉Ideal.span {p}:=by
    intro hz
    have he: (2:(_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {p})=0:=by
      simpa only [map_ofNat] using Ideal.Quotient.eq_zero_iff_mem.mpr hz
    exact Ring.two_ne_zero hc he
  have h6:idealRowHom (2:(_root_.OAI.ActualEisensteinCubic.O)) (Ideal.span {p})^6=1:=by
    rw [idealRowHom_prime _ _ hg]
    have he:=canonicalSextic_sixth_power_mask (Ideal.span {p}) hg (2:(_root_.OAI.ActualEisensteinCubic.O))
    change actualSextic _ hg (Ideal.Quotient.mk _ ((2:(_root_.OAI.ActualEisensteinCubic.O))^6))=_ at he
    simpa only [map_pow,if_neg hn2] using he
  calc
    _=idealRowHom (2:(_root_.OAI.ActualEisensteinCubic.O)) (Ideal.span {p})*idealRowHom (2:(_root_.OAI.ActualEisensteinCubic.O)) (Ideal.span {p})^6:=by rw [h6,mul_one]
    _=idealRowHom (2:(_root_.OAI.ActualEisensteinCubic.O)) (Ideal.span {p})^3*(idealRowHom (2:(_root_.OAI.ActualEisensteinCubic.O)) (Ideal.span {p})^2)^2:=by ring
    _=twoSupplement p:=by
      rw [h2,h3]
      change quadraticTwoSupplement p*cubicTwoSupplement p^2=cubicTwoSupplement p^2*quadraticTwoSupplement p
      ring

theorem idealRowHom_two_formula (n:(_root_.OAI.ActualEisensteinCubic.O)) (hn:lambda^2∣n-1)
    (hs:Supported (Ideal.span {n})) :
    idealRowHom (2:(_root_.OAI.ActualEisensteinCubic.O)) (Ideal.span {n})=twoSupplement n := by
  have hn0:n≠0:=by intro hz;apply hs.1;simp [hz]
  obtain ⟨s,hprod,hfactors⟩:=exists_primary_prime_factorization n hn0 hn
  rw [←hprod] at hs ⊢
  clear hprod hn hn0 n
  induction s using Multiset.induction_on with
  | empty=>simp only [Multiset.prod_zero,Ideal.span_singleton_one,←Ideal.one_eq_top,map_one]
  | @cons p s ih=>
    have hp:=hfactors p (Multiset.mem_cons_self _ _)
    have htail:∀q∈s,Prime q ∧ lambda^2∣q-1:=fun q hq=>hfactors q (Multiset.mem_cons_of_mem hq)
    have hsplit:Supported (Ideal.span {p}) ∧ Supported (Ideal.span {s.prod}):=by
      simpa only [Multiset.prod_cons,←Ideal.span_singleton_mul_span_singleton,supported_mul_iff] using hs
    rw [Multiset.prod_cons,←Ideal.span_singleton_mul_span_singleton,map_mul,
      idealRowHom_two_prime p hp.1 hp.2 hsplit.1,ih hsplit.2 htail,map_mul]

