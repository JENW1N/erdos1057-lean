theorem fullActivePermutation_mul {G : Type*} {P Z : G → Type*} {M : G → ℕ} {B : ℕ}
    (σ τ : FullActiveSlotPermutations M) (x : ProductBoundedOrderedState P Z M B) :
    fullActivePermutation σ (fullActivePermutation τ x) = fullActivePermutation (τ * σ) x := rfl

theorem fullActiveAverage_invariant {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ}
    (f : ProductBoundedOrderedState P Z M B → ℂ) (τ : FullActiveSlotPermutations M)
    (x : ProductBoundedOrderedState P Z M B) :
    fullActiveAverage f (fullActivePermutation τ x) = fullActiveAverage f x := by
  simp only [fullActiveAverage, fullActivePermutation_mul, fullActivePermutationWeight]
  exact Equiv.sum_comp (Equiv.mulLeft τ)
    (fun σ => (((Fintype.card (FullActiveSlotPermutations M) : ℝ)⁻¹ : ℝ) : ℂ) *
      f (fullActivePermutation σ x))









end

section
open Finset
open scoped Classical
noncomputable def globalBirthBoundedEdgePhase {P : Type*} [DecidableEq P]
    (n : P → ℕ) (Δ D : ℤ) (t B : ℕ) (target : Fin t → P) (H : Finset P) :
    UnrestrictedBoundedPhase n Δ D t B :=
  fun s _stores promotions e fresh =>
    if unrestrictedEdgeTarget s.2.2 Sigma.fst promotions e fresh = target ∧
      (∀ i, fresh i ∉ H) then 1 else 0

theorem global_birth_bounded_edge_phase_norm_le {P : Type*} [DecidableEq P]
    (n : P → ℕ) (Δ D : ℤ) (t B : ℕ) (target : Fin t → P) (H : Finset P)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (stores promotions : Finset (Fin t))
    (e : promotions ↪ unrestrictedResidueEligible n Δ D s.2.2)
    (fresh : UnrestrictedFreshLabels P promotions) :
    ‖globalBirthBoundedEdgePhase n Δ D t B target H s stores promotions e fresh‖ ≤ 1 := by
  unfold globalBirthBoundedEdgePhase
  split_ifs <;> norm_num

theorem global_birth_edge_raw_row_bounded_events {P : Type*}
    [Fintype P] [DecidableEq P] (n : P → ℕ) (Δ D : ℤ) (t B : ℕ)
    (source target : Fin t ↪ P)
    (hsource : ∀ i, ¬ (n (source i) : ℤ) ∣ D)
    (htarget : ∀ i, ¬ (n (target i) : ℤ) ∣ D)
    (H : Finset P) (q : BoundedOrderedTuple (UnrestrictedResidueParticle n) B)
    (β : P → ℝ) (ρ V : ℝ)
    (F : Finset P → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    globalBirthEdgeRawRow source target (fun p => (Δ : ZMod (n p))) H q.2
      (globalBirthRawHitIndices (fun p => (Δ : ZMod (n p)))
        (boundedOrderedTupleToFinite q)) β ρ V B F =
    ∑ e : UnrestrictedBoundedEvent n Δ D t B (source, q),
      (unrestrictedBoundedEventWeight n Δ D (fun p => β p / V) ρ V t B (source, q) e : ℂ) *
        globalBirthBoundedEdgePhase n Δ D t B target H (source, q)
          e.1 e.2.1 e.2.2.1 e.2.2.2 *
        F (H ∪ univ.image (unrestrictedBoundedEventTarget n Δ D t B (source, q) e).1)
          (boundedOrderedTupleToFinite (unrestrictedBoundedEventTarget n Δ D t B (source, q) e).2) := by
  refine (global_birth_edge_raw_row_eq_residue_action n Δ D source target hsource htarget
    H q.2 β ρ V B F).trans ?_
  exact unrestricted_residue_action_raw_event_sum n Δ D (fun p => β p / V) ρ V t B
    (globalBirthBoundedEdgePhase n Δ D t B target H)
    (fun target' q' => F (H ∪ univ.image target') q') (source, q)
end

section
open Finset
theorem exists_rough_interval_count_bound :
    ∃ K : ℝ, 0 < K ∧ ∀ (P : Finset ℕ) (A B : ℕ) {z : ℝ} {h : ℕ},
      1 < z → A ≤ B → 1 ≤ h → Even h →
      (∀ p ∈ P, p.Prime) → (∀ p ∈ P, (p : ℝ) ≤ z) →
      |(((Ioc A B).filter (fun n => ∀ p ∈ P, ¬p ∣ n)).card : ℝ) -
          ((B : ℝ) - A) * (∏ p ∈ P, (1 - 1 / (p : ℝ)))| ≤
        ((B : ℝ) - A) * (∏ p ∈ P, (1 - 1 / (p : ℝ))) * K * Real.exp (-(h : ℝ)) +
          z^(4 * (h : ℝ) + 2) := by
  obtain ⟨K, hK, hsieve⟩ := exists_reciprocal_prime_sieve_events
  refine ⟨K, hK, ?_⟩
  intro P A B z h hz hAB hh heven hP hPz
  have hX : 0 ≤ (B : ℝ) - A := sub_nonneg.mpr (Nat.cast_le.mpr hAB)
  have hcount := hsieve P (Ioc A B) (fun _ => 1) (fun n p => p ∣ n)
    (intervalDivisibilityRemainder A B) hz hX hh heven hP hPz (by intros; norm_num)
    (fun S hS => interval_prime_intersection_moment P hP A B S (mem_powerset.mp hS))
  have hrem := interval_divisibility_remainder_sum_le P hP A B hAB
    (z^(4 * (h : ℝ) + 2)) (Real.rpow_nonneg (zero_lt_one.trans hz).le _)
  have hresult := hcount.trans (add_le_add le_rfl hrem)
  simpa only [sum_const, nsmul_eq_mul, mul_one] using hresult
end

section
open Finset
noncomputable def natSieveCoefficient (P : Finset ℕ) (D : ℝ)
    (a : Finset ℕ → ℝ) (d : ℕ) : ℝ :=
  if d ∈ blockSieveModuli P D then a d.primeFactors else 0

theorem block_sieve_modulus_primeFactors_subset (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) (D : ℝ) {d : ℕ} (hd : d ∈ blockSieveModuli P D) :
    d.primeFactors ⊆ P := by
  have hm := block_sieve_modulus_properties P hP D hd
  have hp0 : (∏ p ∈ P, p) ≠ 0 :=
    prod_ne_zero_iff.mpr (fun p hp => (hP p hp).ne_zero)
  simpa only [Nat.primeFactors_prod hP] using Nat.primeFactors_mono hm.2.2.2 hp0

theorem nat_sieve_coefficient_abs_le_one (P : Finset ℕ) (D : ℝ)
    (a : Finset ℕ → ℝ) (hP : ∀ p ∈ P, p.Prime)
    (ha : ∀ S ∈ P.powerset, |a S| ≤ 1) (d : ℕ) :
    |natSieveCoefficient P D a d| ≤ 1 := by
  unfold natSieveCoefficient
  split_ifs with hd
  · exact ha _ (mem_powerset.mpr (block_sieve_modulus_primeFactors_subset P hP D hd))
  · norm_num

theorem nat_sieve_coefficient_support (P : Finset ℕ) (D : ℝ)
    (a : Finset ℕ → ℝ) (hP : ∀ p ∈ P, p.Prime) {d : ℕ}
    (hd : natSieveCoefficient P D a d ≠ 0) :
    0 < d ∧ (d : ℝ) ≤ D ∧ Squarefree d ∧ d ∣ ∏ p ∈ P, p := by
  have hm : d ∈ blockSieveModuli P D := by
    by_contra hm
    exact hd (by simp [natSieveCoefficient, hm])
  exact block_sieve_modulus_properties P hP D hm

theorem block_sieve_moduli_eq_subset_products (P : Finset ℕ) (D : ℝ)
    (hP : ∀ p ∈ P, p.Prime) :
    blockSieveModuli P D =
      (P.powerset.filter (fun S => ((∏ p ∈ S, p : ℕ) : ℝ) ≤ D)).image
        (fun S => ∏ p ∈ S, p) := by
  ext d
  constructor
  · intro hd
    have hm := block_sieve_modulus_properties P hP D hd
    have heq := Nat.prod_primeFactors_of_squarefree hm.2.2.1
    refine mem_image.mpr ⟨d.primeFactors, mem_filter.mpr ⟨?_, ?_⟩, heq⟩
    · exact mem_powerset.mpr (block_sieve_modulus_primeFactors_subset P hP D hd)
    · simpa only [heq] using hm.2.1
  · intro hd
    obtain ⟨S, hS, rfl⟩ := mem_image.mp hd
    obtain ⟨hS, hD⟩ := mem_filter.mp hS
    have hSP : S ⊆ P := mem_powerset.mp hS
    apply mem_filter.mpr
    refine ⟨mem_Icc.mpr ⟨?_, Nat.le_floor hD⟩, ?_⟩
    · exact prod_pos (fun p hp => (hP p (hSP hp)).pos)
    · exact prod_dvd_prod_of_subset S P (fun p => p) hSP

section

variable
  (P : Finset ℕ)
  (D : ℝ)
  (a : Finset ℕ → ℝ)
  (hP : ∀ p ∈ P, p.Prime)

include P D a hP

theorem nat_sieve_coefficient_sum 
    (hlevel : ∀ S ∈ P.powerset, a S ≠ 0 → ((∏ p ∈ S, p : ℕ) : ℝ) ≤ D)
    (F : ℕ → ℝ) :
    (∑ S ∈ P.powerset, a S * F (∏ p ∈ S, p)) =
      ∑ d ∈ blockSieveModuli P D, natSieveCoefficient P D a d * F d := by
  let L := P.powerset.filter (fun S => ((∏ p ∈ S, p : ℕ) : ℝ) ≤ D)
  have hLP : L ⊆ P.powerset := filter_subset _ _
  have himage : blockSieveModuli P D = L.image (fun S => ∏ p ∈ S, p) :=
    block_sieve_moduli_eq_subset_products P D hP
  have hinj : Set.InjOn (fun S : Finset ℕ => ∏ p ∈ S, p) L := by
    intro S hS T hT heq
    have hs : (∏ p ∈ S, p).primeFactors = S :=
      Nat.primeFactors_prod (fun p hp => hP p ((mem_powerset.mp (hLP hS)) hp))
    have ht : (∏ p ∈ T, p).primeFactors = T :=
      Nat.primeFactors_prod (fun p hp => hP p ((mem_powerset.mp (hLP hT)) hp))
    rw [← hs, ← ht]
    exact congrArg Nat.primeFactors heq
  have hcoef : ∀ S ∈ L, natSieveCoefficient P D a (∏ p ∈ S, p) = a S := by
    intro S hS
    have hm : (∏ p ∈ S, p) ∈ blockSieveModuli P D := by
      rw [himage]
      exact mem_image.mpr ⟨S, hS, rfl⟩
    have hpf : (∏ p ∈ S, p).primeFactors = S :=
      Nat.primeFactors_prod (fun p hp => hP p ((mem_powerset.mp (hLP hS)) hp))
    simp only [natSieveCoefficient, if_pos hm, hpf]
  symm
  calc
    _ = ∑ S ∈ L, natSieveCoefficient P D a (∏ p ∈ S, p) * F (∏ p ∈ S, p) := by
      rw [himage, sum_image hinj]
    _ = ∑ S ∈ L, a S * F (∏ p ∈ S, p) :=
      sum_congr rfl (fun S hS => by rw [hcoef S hS])
    _ = _ := by
      apply sum_subset hLP
      intro S hS hn
      have hz : a S = 0 := by
        by_contra hz
        exact hn (mem_filter.mpr ⟨hS, hlevel S hS hz⟩)
      rw [hz, zero_mul]

theorem nat_sieve_coefficient_harmonic_bound 
    (ha : ∀ S ∈ P.powerset, |a S| ≤ 1)
    (hlevel : ∀ S ∈ P.powerset, a S ≠ 0 → ((∏ p ∈ S, p : ℕ) : ℝ) ≤ D) :
    (∑ d ∈ blockSieveModuli P D, |natSieveCoefficient P D a d| / (d : ℝ)) ≤
      ∏ p ∈ P, (1 + 1 / (p : ℝ)) := by
  have hlevel' : ∀ S ∈ P.powerset, |a S| ≠ 0 → ((∏ p ∈ S, p : ℕ) : ℝ) ≤ D := by
    intro S hS hz
    exact hlevel S hS (abs_ne_zero.mp hz)
  calc
    _ = ∑ d ∈ blockSieveModuli P D,
        natSieveCoefficient P D (fun S => |a S|) d * (1 / (d : ℝ)) := by
      apply sum_congr rfl
      intro d hd
      simp only [natSieveCoefficient, if_pos hd]
      ring
    _ = ∑ S ∈ P.powerset, |a S| * (1 / ((∏ p ∈ S, p : ℕ) : ℝ)) :=
      (nat_sieve_coefficient_sum P D (fun S => |a S|) hP hlevel' (fun d => 1 / (d : ℝ))).symm
    _ ≤ ∑ S ∈ P.powerset, 1 / ((∏ p ∈ S, p : ℕ) : ℝ) := by
      apply sum_le_sum
      intro S hS
      exact mul_le_of_le_one_left (by positivity) (ha S hS)
    _ = ∑ S ∈ P.powerset, ∏ p ∈ S, 1 / (p : ℝ) := by
      apply sum_congr rfl
      intro S _
      simp only [Nat.cast_prod, one_div, prod_inv_distrib]
    _ = _ := (prod_one_add P).symm

theorem nat_sieve_polynomial_eq_divisor_sum 
    (hlevel : ∀ S ∈ P.powerset, a S ≠ 0 → ((∏ p ∈ S, p : ℕ) : ℝ) ≤ D)
    (n : ℕ) :
    subsetPolynomial P a (fun p => if p ∣ n then 1 else 0) =
      ∑ d ∈ blockSieveModuli P D, if d ∣ n then natSieveCoefficient P D a d else 0 := by
  calc
    _ = ∑ S ∈ P.powerset, a S * (if (∏ p ∈ S, p) ∣ n then 1 else 0) := by
      apply sum_congr rfl
      intro S hS
      rw [finite_bad_event_indicator_product]
      simp only [prime_subset_product_dvd_iff S
        (fun p hp => hP p ((mem_powerset.mp hS) hp)) n]
    _ = ∑ d ∈ blockSieveModuli P D,
        natSieveCoefficient P D a d * (if d ∣ n then 1 else 0) :=
      nat_sieve_coefficient_sum P D a hP hlevel (fun d => if d ∣ n then 1 else 0)
    _ = _ := by
      apply sum_congr rfl
      intro d _
      split_ifs <;> simp

theorem nat_sieve_polynomial_eq_sum_divisors 
    (hlevel : ∀ S ∈ P.powerset, a S ≠ 0 → ((∏ p ∈ S, p : ℕ) : ℝ) ≤ D)
    {n : ℕ} (hn : n ≠ 0) :
    subsetPolynomial P a (fun p => if p ∣ n then 1 else 0) =
      ∑ d ∈ n.divisors, natSieveCoefficient P D a d := by
  rw [nat_sieve_polynomial_eq_divisor_sum P D a hP hlevel n, ← sum_filter]
  apply sum_subset
  · intro d hd
    exact Nat.mem_divisors.mpr ⟨(mem_filter.mp hd).2, hn⟩
  · intro d hd hnot
    have hm : d ∉ blockSieveModuli P D := by
      intro hm
      exact hnot (mem_filter.mpr ⟨hm, Nat.dvd_of_mem_divisors hd⟩)
    simp only [natSieveCoefficient, if_neg hm]

end

end

section
open Finset
noncomputable def roughBlockUpper (J : Finset ℕ) (B : ℕ → Finset ℕ) (h n : ℕ) : ℝ :=
  blockSieveUpper J B (fun p => if p ∣ n then 1 else 0) (fun j => (j + 1) * h)

theorem interval_block_sieve_overcount (J : Finset ℕ) (P : ℕ → Finset ℕ)
    (A B : ℕ) {z C : ℝ} {h : ℕ} (hz : 1 < z) (hC : 0 ≤ C)
    (hAB : A ≤ B) (hh : 1 ≤ h) (heven : Even h)
    (hdisj : (J : Set ℕ).PairwiseDisjoint P)
    (hprime : ∀ j ∈ J, ∀ p ∈ P j, p.Prime)
    (hsize : ∀ j ∈ J, ∀ p ∈ P j, Real.log (p : ℝ) ≤ Real.log z / (2 : ℝ)^j)
    (hsum : ∀ j ∈ J, (∑ p ∈ P j, 1 / (p : ℝ)) ≤ C) :
    let M := (∑ n ∈ Ioc A B, roughBlockUpper J P h n) -
      (((Ioc A B).filter (fun n => ∀ p ∈ J.biUnion P, ¬p ∣ n)).card : ℝ)
    0 ≤ M ∧ M ≤ ((B : ℝ) - A) * blockSieveModelErrorConstant C (1/2) *
      Real.exp (-(h : ℝ)) + z^(4 * (h : ℝ) + 2) := by
  have hX : 0 ≤ (B : ℝ) - A := sub_nonneg.mpr (Nat.cast_le.mpr hAB)
  have hP : ∀ p ∈ J.biUnion P, p.Prime := by
    intro p hp
    obtain ⟨j, hj, hp⟩ := mem_biUnion.mp hp
    exact hprime j hj p hp
  have hg : ∀ j ∈ J, ∀ p ∈ P j, 0 ≤ 1 / (p : ℝ) ∧ 1 / (p : ℝ) ≤ 1 - (1/2 : ℝ) := by
    intro j hj p hp
    have hp2 : (2 : ℝ) ≤ p := Nat.cast_le.mpr (hprime j hj p hp).two_le
    refine ⟨by positivity, ?_⟩
    have hd := one_div_le_one_div_of_le (by norm_num : (0 : ℝ) < 2) hp2
    norm_num at hd ⊢
    exact hd
  have hresult := finite_block_sieve_event_overcount J P (Ioc A B) (fun _ => 1)
    (fun n p => p ∣ n) (fun p => 1 / (p : ℝ)) (intervalDivisibilityRemainder A B)
    hz.le hX hC (by norm_num) hh heven hdisj hprime hsize (by intros; norm_num) hg hsum
    (fun S hS => interval_prime_intersection_moment (J.biUnion P) hP A B S (mem_powerset.mp hS))
  dsimp only at hresult ⊢
  simp only [one_mul, sum_const, nsmul_eq_mul, mul_one] at hresult
  have hproduct : (∏ p ∈ J.biUnion P, (1 - 1 / (p : ℝ))) ≤ 1 := by
    apply prod_le_one₀
    · intro p hp
      have hp1 : (1 : ℝ) ≤ p := by exact_mod_cast (hP p hp).one_lt.le
      apply sub_nonneg.mpr
      simpa only [div_one] using one_div_le_one_div_of_le (by norm_num : (0 : ℝ) < 1) hp1
    · intro p _
      exact sub_le_self 1 (by positivity)
  have hmain : ((B : ℝ) - A) * (∏ p ∈ J.biUnion P, (1 - 1 / (p : ℝ))) *
      blockSieveModelErrorConstant C (1/2) * Real.exp (-(h : ℝ)) ≤
      ((B : ℝ) - A) * blockSieveModelErrorConstant C (1/2) * Real.exp (-(h : ℝ)) := by
    apply mul_le_mul_of_nonneg_right _ (Real.exp_pos _).le
    apply mul_le_mul_of_nonneg_right _ (block_sieve_model_error_constant_pos C (1/2)).le
    exact mul_le_of_le_one_right hX hproduct
  have hrem := interval_divisibility_remainder_sum_le (J.biUnion P) hP A B hAB
    (z^(4 * (h : ℝ) + 2)) (Real.rpow_nonneg (zero_lt_one.trans hz).le _)
  exact ⟨hresult.1, hresult.2.trans (add_le_add hmain hrem)⟩

theorem exists_rough_interval_sieve_blocks :
    ∃ K : ℝ, 0 < K ∧ ∀ (P : Finset ℕ) {z : ℝ}, 1 < z →
      (∀ p ∈ P, p.Prime) → (∀ p ∈ P, (p : ℝ) ≤ z) →
      ∃ (J : Finset ℕ) (B : ℕ → Finset ℕ), J.biUnion B = P ∧
        (J : Set ℕ).PairwiseDisjoint B ∧
        (∀ j ∈ J, ∀ p ∈ B j, Real.log (p : ℝ) ≤ Real.log z / (2 : ℝ)^j) ∧
        ∀ h : ℕ, 1 ≤ h → Even h →
          (∀ n : ℕ, 0 ≤ roughBlockUpper J B h n ∧
            (if ∀ p ∈ P, ¬p ∣ n then (1 : ℝ) else 0) ≤ roughBlockUpper J B h n) ∧
          (∀ a b : ℕ, a ≤ b →
            let M := (∑ n ∈ Ioc a b, roughBlockUpper J B h n) -
              (((Ioc a b).filter (fun n => ∀ p ∈ P, ¬p ∣ n)).card : ℝ)
            0 ≤ M ∧ M ≤ ((b : ℝ) - a) * K * Real.exp (-(h : ℝ)) + z^(4 * (h : ℝ) + 2)) := by
  obtain ⟨C, hC, hshell⟩ := exists_finite_prime_reciprocal_shell_bound
  refine ⟨blockSieveModelErrorConstant C (1/2), block_sieve_model_error_constant_pos C (1/2), ?_⟩
  intro P z hz hP hPz
  obtain ⟨J, B, hunion, hdisj, hsub, hband⟩ := exists_dyadic_sieve_blocks_log P hP hPz
  refine ⟨J, B, hunion, hdisj, fun j hj p hp => (hband j hj p hp).2, ?_⟩
  intro h hh heven
  constructor
  · intro n
    have hw : ∀ j ∈ J, ∀ p ∈ B j, 0 ≤ (if p ∣ n then (1 : ℝ) else 0) ∧
        (if p ∣ n then (1 : ℝ) else 0) ≤ 1 := by
      intros
      split_ifs <;> norm_num
    have hc : ∀ j ∈ J, Even ((j + 1) * h) := fun j _ => heven.mul_left (j + 1)
    refine ⟨block_sieve_upper_nonneg J B _ _ hw hc, ?_⟩
    have hs := (block_sieve_sandwich J B _ _ hw hc).2
    rw [← prod_biUnion hdisj, hunion, finite_bad_event_avoidance_product] at hs
    exact hs
  · intro a b hab
    have hm := interval_block_sieve_overcount J B a b hz hC hab hh heven hdisj
      (fun j _ p hp => hP p (hsub j hp)) (fun j hj p hp => (hband j hj p hp).2) (by
        intro j hj
        exact dyadic_sieve_block_mass P (B j) (fun p => 1 / (p : ℝ)) hz j hP
          (by intros; positivity) (hsub j) (fun p hp => (hband j hj p hp).1)
          (fun p hp => (hband j hj p hp).2) (hshell P hP))
    simpa only [hunion] using hm
end

section
open scoped BigOperators Classical
theorem prime_product_ideal_character_reproduction (hZ : PrimitiveZeroFreeHalfPlane) :
    ∃ C : ℝ, 0 < C ∧ ∀ Q : ℕ, 0 < Q →
      ∀ {I : Type*} [Fintype I] [DecidableEq I],
      ∀ (P : I → Finset ℕ) (V : I → ℝ) (i : I),
      (∀ j, 0 < V j) →
      (∀ j p, p ∈ P j → p.Prime ∧ Q < p) →
      (∀ j, ∑ p ∈ P j, 1 / (p : ℝ) = V j) →
      ∀ a b : ℝ, P i = primeBand a b → 2 ≤ a → 0 ≤ b →
      ∀ h ξ : ℝ, 0 < h → 0 < ξ → ∀ kept : Finset ℤ,
      (∀ d ∈ kept, ξ ≤ finiteCellMass (finiteProductWeight (physicalLabelLaw (P := P) V))
        (fun x => upperLogCell h (Real.log (∏ j, (x j).val : ℕ))) d) →
      ∀ (t : BoundedPrimitiveCharacter Q) (y : ∀ j, P j),
      upperLogCell h (Real.log (∏ j, (y j).val : ℕ)) ∈ kept →
        ‖(∑ x, (finiteProductWeight (physicalLabelLaw V) x : ℂ) *
            primeProductIdealKernel P V Q h kept x y *
            boundedPrimitiveValue t ((∏ j, (x j).val : ℕ) : ZMod (boundedPrimitiveModulus t))) -
          boundedPrimitiveValue t ((∏ j, (y j).val : ℕ) : ZMod (boundedPrimitiveModulus t))‖ ≤
        (Q * Q : ℕ) * (((C / V i) * a ^ (-(1 : ℝ) / 32) *
          (1 + Real.log (Q * Q : ℕ) / Real.log a)) / ξ) := by
  obtain ⟨C, hC, hbnd⟩ := prime_family_log_cell_gram hZ
  refine ⟨C, hC, ?_⟩
  intro Q hQ I _ _ P V i hV hp hmass a b hPi ha hb h ξ hh hξ kept hkept t y hy
  let ψ : BoundedPrimitiveCharacter Q → (∀ j, P j) → ℂ := fun s x =>
    star (boundedPrimitiveValue s ((∏ j, (x j).val : ℕ) : ZMod (boundedPrimitiveModulus s)))
