section
open Finset
/- An actual ordered tuple of distinct labels whose image is exactly `S`. -/
abbrev DistinctOrderedSupport (J : Type*) {P : Type*} (S : Finset P) :=
  {f : J ↪ P // ∀ p, p ∈ S ↔ ∃ j, f j = p}

/- Read an actual distinct tuple as an enumeration of its specified support. -/
noncomputable def distinctOrderedSupportAsEquiv {J P : Type*} {S : Finset P}
    (f : DistinctOrderedSupport J S) : J ≃ S :=
  Equiv.ofBijective
    (fun j => ⟨f.val j, (f.property (f.val j)).2 ⟨j, rfl⟩⟩)
    ⟨by
      intro j k hjk
      exact f.val.injective (congrArg Subtype.val hjk),
     by
      intro p
      obtain ⟨j, hj⟩ := (f.property p.val).1 p.property
      exact ⟨j, Subtype.ext hj⟩⟩

/- Forget the subtype tag on each label in a support enumeration. -/
def distinctOrderedSupportOfEquiv {J P : Type*} {S : Finset P}
    (e : J ≃ S) : DistinctOrderedSupport J S :=
  ⟨{ toFun := fun j => (e j).val
     inj' := by
       intro j k hjk
       exact e.injective (Subtype.ext hjk) },
   by
    intro p
    constructor
    · intro hp
      obtain ⟨j, hj⟩ := e.surjective ⟨p, hp⟩
      exact ⟨j, congrArg Subtype.val hj⟩
    · rintro ⟨j, rfl⟩
      exact (e j).property⟩












end

section
open Finset
/- Occupancy of the retained positions of an ordered tuple. -/
noncomputable def retainedTupleOccupancy {ι : Type*} [DecidableEq ι] {n : ℕ}
    (p : Fin n → ι) (s : Finset (Fin n)) : ι → ℕ :=
  ∑ j ∈ s, Pi.single (p j) 1




/- Position products can be grouped by the species occupancy of the tuple. -/
theorem tuple_prod_eq_occupancy_prod {ι M : Type*} [Fintype ι] [DecidableEq ι]
    [CommMonoid M] {n : ℕ} (p : Fin n → ι) (z : ι → M) :
    (∏ j, z (p j)) = ∏ i, z i ^ tupleOccupancy p i := by
  rw [← Finset.prod_fiberwise' univ p z]
  simp only [Finset.prod_const, tupleOccupancy_apply]

section

variable
  {ι : Type*}
  [sharedInstance1 : Fintype ι]
  [sharedInstance2 : DecidableEq ι]
  {n : ℕ}
  (p : Fin n → ι)

include ι sharedInstance1 sharedInstance2 n p

/- The retention polynomial, expanded by retained positions and by species. -/
theorem retained_occupancy_generating_identity  (A D : ι → ℝ) :
    (∑ s ∈ (univ : Finset (Fin n)).powerset,
      AddMonoidAlgebra.single (retainedTupleOccupancy p s)
        ((∏ j ∈ s, A (p j)) * ∏ j ∈ univ \ s, D (p j))) =
    ∑ k ∈ Fintype.piFinset (fun i => range (tupleOccupancy p i + 1)),
      AddMonoidAlgebra.single k
        (∏ i, (Nat.choose (tupleOccupancy p i) (k i) : ℝ) *
          A i ^ k i * D i ^ (tupleOccupancy p i - k i)) := by
  let z : ι → AddMonoidAlgebra ℝ (ι → ℕ) := fun i =>
    AddMonoidAlgebra.single (Pi.single i 1) (A i) +
      AddMonoidAlgebra.single 0 (D i)
  have hpos : (∏ j, z (p j)) =
      ∑ s ∈ (univ : Finset (Fin n)).powerset,
        AddMonoidAlgebra.single (retainedTupleOccupancy p s)
          ((∏ j ∈ s, A (p j)) * ∏ j ∈ univ \ s, D (p j)) := by
    simp only [z, Finset.prod_add, AddMonoidAlgebra.prod_single,
      AddMonoidAlgebra.single_mul_single, Finset.sum_const_zero, add_zero,
      retainedTupleOccupancy]
  have hpow (i : ι) : z i ^ tupleOccupancy p i =
      ∑ k ∈ range (tupleOccupancy p i + 1),
        AddMonoidAlgebra.single (k • Pi.single i 1)
          ((Nat.choose (tupleOccupancy p i) k : ℝ) * A i ^ k *
            D i ^ (tupleOccupancy p i - k)) := by
    rw [show z i = _ from rfl, add_pow]
    apply Finset.sum_congr rfl
    intro k hk
    simp only [AddMonoidAlgebra.single_pow, nsmul_zero,
      AddMonoidAlgebra.single_mul_single, add_zero]
    rw [mul_comm, ← nsmul_eq_mul]
    simp [mul_assoc]
  rw [← hpos, tuple_prod_eq_occupancy_prod p z]
  simp_rw [hpow]
  rw [Finset.prod_univ_sum]
  apply Finset.sum_congr rfl
  intro k hk
  have hexp : (∑ i, k i • Pi.single i (1 : ℕ)) = k := by
    ext i
    simp [Finset.sum_apply, Pi.single_apply]
  simp only [AddMonoidAlgebra.prod_single, hexp]

/- Group retained index subsets by occupancy. Repeated numerical species are
allowed, and the test is an arbitrary function of the whole retained vector. -/
theorem sum_retained_eq_occupancy  (A D : ι → ℝ) (F : (ι → ℕ) → ℝ) :
    (∑ s ∈ (univ : Finset (Fin n)).powerset,
      ((∏ j ∈ s, A (p j)) * ∏ j ∈ univ \ s, D (p j)) *
        F (retainedTupleOccupancy p s)) =
    ∑ k ∈ Fintype.piFinset (fun i => range (tupleOccupancy p i + 1)),
      (∏ i, (Nat.choose (tupleOccupancy p i) (k i) : ℝ) *
        A i ^ k i * D i ^ (tupleOccupancy p i - k i)) * F k := by
  let T : AddMonoidAlgebra ℝ (ι → ℕ) →+ ℝ :=
    (Finsupp.liftAddHom (fun k => AddMonoidHom.mulRight (F k))).comp
      AddMonoidAlgebra.coeffAddEquiv.toAddMonoidHom
  have hT (k : ι → ℕ) (r : ℝ) : T (AddMonoidAlgebra.single k r) = r * F k := by
    simp [T]
  have h := congrArg T (retained_occupancy_generating_identity p A D)
  simpa only [map_sum, hT] using h

/- Retain old positions, then append an ordered birth batch with its `1/b!`
weight. The result is the exact coupled occupancy sum; births may repeat species.
No positivity assumption or factorization of the output test is used. -/
theorem sum_retained_ordered_births_eq_occupancy  (A D C ν : ι → ℝ)
    (b : ℕ) (F : (ι → ℕ) → ℝ) :
    (∑ s ∈ (univ : Finset (Fin n)).powerset,
      ((∏ j ∈ s, A (p j)) * ∏ j ∈ univ \ s, D (p j)) *
        ((∑ q : Fin b → ι, (∏ j, C (q j) * ν (q j)) *
          F (retainedTupleOccupancy p s + tupleOccupancy q)) /
            (b.factorial : ℝ))) =
    ∑ k ∈ Fintype.piFinset (fun i => range (tupleOccupancy p i + 1)),
      (∏ i, (Nat.choose (tupleOccupancy p i) (k i) : ℝ) *
        A i ^ k i * D i ^ (tupleOccupancy p i - k i)) *
        ∑ l ∈ (univ : Finset ι).piAntidiag b,
          (∏ i, (C i * ν i) ^ l i / ((l i).factorial : ℝ)) * F (k + l) := by
  rw [sum_retained_eq_occupancy p A D (fun k =>
    (∑ q : Fin b → ι, (∏ j, C (q j) * ν (q j)) *
      F (k + tupleOccupancy q)) / (b.factorial : ℝ))]
  apply Finset.sum_congr rfl
  intro k hk
  congr 1
  exact sum_tuple_div_factorial_eq_occupancy (fun i => C i * ν i) b
    (fun l => F (k + l))

end

end

section
open Finset
/- All occupancy vectors with total size at most `B`. -/
noncomputable def ghostOccupancyBall {ι : Type*} [Fintype ι] [DecidableEq ι]
    (B : ℕ) : Finset (ι → ℕ) :=
  (range (B + 1)).biUnion (fun b => (univ : Finset ι).piAntidiag b)

theorem mem_ghostOccupancyBall {ι : Type*} [Fintype ι] [DecidableEq ι]
    (B : ℕ) (m : ι → ℕ) : m ∈ ghostOccupancyBall B ↔ (∑ i, m i) ≤ B := by
  classical
  simp only [ghostOccupancyBall, mem_biUnion, mem_range, mem_piAntidiag,
    mem_univ, implies_true, and_true]
  constructor
  · rintro ⟨b, hb, hm⟩
    exact hm ▸ Nat.le_of_lt_succ hb
  · intro hm
    exact ⟨∑ i, m i, by omega, rfl⟩

theorem sum_ghostOccupancyBall {ι : Type*} [Fintype ι] [DecidableEq ι]
    (B : ℕ) (f : (ι → ℕ) → ℝ) :
    (∑ b ∈ range (B + 1), ∑ m ∈ (univ : Finset ι).piAntidiag b, f m) =
      ∑ m ∈ ghostOccupancyBall B, f m := by
  classical
  unfold ghostOccupancyBall
  rw [sum_biUnion]
  intro b hb c hc hbc
  apply disjoint_left.mpr
  intro m hm hn
  exact hbc ((mem_piAntidiag.mp hm).1.symm.trans (mem_piAntidiag.mp hn).1)

/- Translate births to total output occupancy, preserving the total cutoff. -/
theorem ghost_occupancy_translate_sum {ι : Type*} [Fintype ι] [DecidableEq ι]
    (B : ℕ) (k : ι → ℕ) (f : (ι → ℕ) → ℝ) :
    (∑ l ∈ ghostOccupancyBall B,
      if (∑ i, (k + l) i) ≤ B then f l else 0) =
    ∑ m ∈ ghostOccupancyBall B, if ∀ i, k i ≤ m i then f (m - k) else 0 := by
  classical
  rw [← sum_filter, ← sum_filter]
  apply sum_bij (fun l _ => k + l)
  · intro l hl
    rw [mem_filter] at hl ⊢
    exact ⟨(mem_ghostOccupancyBall B _).mpr hl.2, fun i => Nat.le_add_right _ _⟩
  · intro l hl l' hl' h
    exact add_left_cancel h
  · intro m hm
    rw [mem_filter] at hm
    have hsum : (∑ i, (m - k) i) ≤ B :=
      (sum_le_sum (fun i _ => Nat.sub_le (m i) (k i))).trans
        ((mem_ghostOccupancyBall B m).mp hm.1)
    have heq : k + (m - k) = m := by
      ext i
      exact Nat.add_sub_of_le (hm.2 i)
    refine ⟨m - k, ?_, heq⟩
    exact mem_filter.mpr ⟨(mem_ghostOccupancyBall B _).mpr hsum,
      by simpa only [heq] using (mem_ghostOccupancyBall B m).mp hm.1⟩
  · intro l hl
    congr 1
    ext i
    exact (Nat.add_sub_cancel_left (k i) (l i)).symm

/- A finite vector version of birth-and-retention triangular reindexing. -/
theorem ghost_occupancy_triangular_sum {ι : Type*} [Fintype ι] [DecidableEq ι]
    (n : ι → ℕ) (B : ℕ) (f : (ι → ℕ) → (ι → ℕ) → ℝ) :
    (∑ k ∈ Fintype.piFinset (fun i => range (n i + 1)),
      ∑ l ∈ ghostOccupancyBall B,
        if (∑ i, (k + l) i) ≤ B then f k l else 0) =
    ∑ m ∈ ghostOccupancyBall B,
      ∑ k ∈ Fintype.piFinset (fun i => range (min (n i) (m i) + 1)),
        f k (m - k) := by
  classical
  simp_rw [ghost_occupancy_translate_sum]
  rw [sum_comm]
  apply sum_congr rfl
  intro m hm
  rw [← sum_filter]
  have hset : (Fintype.piFinset (fun i => range (n i + 1))).filter
      (fun k => ∀ i, k i ≤ m i) =
      Fintype.piFinset (fun i => range (min (n i) (m i) + 1)) := by
    ext k
    simp only [mem_filter, Fintype.mem_piFinset, mem_range, Nat.lt_succ_iff,
      le_min_iff]
    exact forall_and.symm
  rw [hset]

/- Product coefficient for retaining `k` old particles of each species. -/
noncomputable def ghostRetainedCoefficient {ι : Type*} [Fintype ι]
    (n : ι → ℕ) (A D : ι → ℝ) (k : ι → ℕ) : ℝ :=
  ∏ i, (Nat.choose (n i) (k i) : ℝ) * A i ^ k i * D i ^ (n i - k i)

/- The ordered-birth factorial measure after grouping by species. -/
noncomputable def ghostBirthCoefficient {ι : Type*} [Fintype ι]
    (C ν : ι → ℝ) (l : ι → ℕ) : ℝ :=
  ∏ i, (C i * ν i) ^ l i / ((l i).factorial : ℝ)

theorem ghost_kernel_product_retained_births {ι : Type*} [Fintype ι]
    [DecidableEq ι] (n m : ι → ℕ) (A D C ν : ι → ℝ) :
    (∏ i, ghostKernel (A i) (D i) (C i) (ν i) (n i) (m i)) =
    ∑ k ∈ Fintype.piFinset (fun i => range (min (n i) (m i) + 1)),
      ghostRetainedCoefficient n A D k * ghostBirthCoefficient C ν (m - k) := by
  simp only [ghostKernel]
  rw [prod_univ_sum]
  apply sum_congr rfl
  intro k hk
  unfold ghostRetainedCoefficient ghostBirthCoefficient
  rw [← prod_mul_distrib]
  apply prod_congr rfl
  intro i hi
  simp only [Pi.sub_apply]
  ring

/- Exact ordered-particle row with total output occupancy at most `B`.
The birth-length sum only needs `b ≤ B`; rejected outputs have zero test value. -/
theorem ordered_ghost_row_eq_kernel_product {ι : Type*} [Fintype ι]
    [DecidableEq ι] {N : ℕ} (p : Fin N → ι) (A D C ν : ι → ℝ)
    (B : ℕ) (F : (ι → ℕ) → ℝ) :
    (∑ b ∈ range (B + 1), ∑ s ∈ (univ : Finset (Fin N)).powerset,
      ((∏ j ∈ s, A (p j)) * ∏ j ∈ univ \ s, D (p j)) *
        ((∑ q : Fin b → ι, (∏ j, C (q j) * ν (q j)) *
          (if (∑ i, (retainedTupleOccupancy p s + tupleOccupancy q) i) ≤ B then
            F (retainedTupleOccupancy p s + tupleOccupancy q) else 0)) /
              (b.factorial : ℝ))) =
    ∑ m ∈ ghostOccupancyBall B,
      (∏ i, ghostKernel (A i) (D i) (C i) (ν i) (tupleOccupancy p i) (m i)) *
        F m := by
  classical
  calc
    _ = ∑ b ∈ range (B + 1),
        ∑ k ∈ Fintype.piFinset (fun i => range (tupleOccupancy p i + 1)),
          ghostRetainedCoefficient (tupleOccupancy p) A D k *
            ∑ l ∈ (univ : Finset ι).piAntidiag b,
              ghostBirthCoefficient C ν l *
                (if (∑ i, (k + l) i) ≤ B then F (k + l) else 0) := by
      apply sum_congr rfl
      intro b hb
      exact sum_retained_ordered_births_eq_occupancy p A D C ν b
        (fun m => if (∑ i, m i) ≤ B then F m else 0)
    _ = ∑ k ∈ Fintype.piFinset (fun i => range (tupleOccupancy p i + 1)),
        ∑ l ∈ ghostOccupancyBall B,
          if (∑ i, (k + l) i) ≤ B then
            ghostRetainedCoefficient (tupleOccupancy p) A D k *
              ghostBirthCoefficient C ν l * F (k + l) else 0 := by
      rw [sum_comm]
      apply sum_congr rfl
      intro k hk
      simp_rw [mul_sum]
      rw [← sum_ghostOccupancyBall]
      apply sum_congr rfl
      intro b hb
      apply sum_congr rfl
      intro l hl
      split_ifs <;> ring
    _ = ∑ m ∈ ghostOccupancyBall B,
        ∑ k ∈ Fintype.piFinset (fun i => range (min (tupleOccupancy p i) (m i) + 1)),
          ghostRetainedCoefficient (tupleOccupancy p) A D k *
            ghostBirthCoefficient C ν (m - k) * F (k + (m - k)) :=
      ghost_occupancy_triangular_sum (tupleOccupancy p) B _
    _ = _ := by
      apply sum_congr rfl
      intro m hm
      rw [ghost_kernel_product_retained_births, sum_mul]
      apply sum_congr rfl
      intro k hk
      have hkm : k ≤ m := by
        intro i
        have h := (Fintype.mem_piFinset.mp hk) i
        simp only [mem_range, Nat.lt_succ_iff, le_min_iff] at h
        exact h.2
      have heq : k + (m - k) = m := by
        ext i
        exact Nat.add_sub_of_le (hkm i)
      rw [heq]
end

section
open Finset
/- The actual ordered row, including repeated species and the birth `1/b!`.
Each ordered event is tested only when its total output size is at most `B`. -/
noncomputable def complexOrderedGhostRow {ι : Type*} [Fintype ι] [DecidableEq ι]
    {N : ℕ} (p : Fin N → ι) (A D C ν : ι → ℝ) (B : ℕ)
    (F : (ι → ℕ) → ℂ) : ℂ :=
  ∑ b ∈ range (B + 1), ∑ s ∈ (univ : Finset (Fin N)).powerset,
    ∑ q : Fin b → ι,
      ((((∏ j ∈ s, A (p j)) * ∏ j ∈ univ \ s, D (p j)) *
        (∏ j, C (q j) * ν (q j)) / (b.factorial : ℝ) : ℝ) : ℂ) *
        (if (∑ i, (retainedTupleOccupancy p s + tupleOccupancy q) i) ≤ B then
          F (retainedTupleOccupancy p s + tupleOccupancy q) else 0)

theorem complex_ordered_ghost_row_eq_kernel_product {ι : Type*} [Fintype ι]
    [DecidableEq ι] {N : ℕ} (p : Fin N → ι) (A D C ν : ι → ℝ)
    (B : ℕ) (F : (ι → ℕ) → ℂ) :
    complexOrderedGhostRow p A D C ν B F =
      ∑ m ∈ ghostOccupancyBall B,
        ((∏ i, ghostKernel (A i) (D i) (C i) (ν i) (tupleOccupancy p i) (m i) : ℝ) : ℂ) *
          F m := by
  have hr (f : (ι → ℕ) → ℝ) :
      (∑ b ∈ range (B + 1), ∑ s ∈ (univ : Finset (Fin N)).powerset,
        ∑ q : Fin b → ι,
          (((∏ j ∈ s, A (p j)) * ∏ j ∈ univ \ s, D (p j)) *
            (∏ j, C (q j) * ν (q j)) / (b.factorial : ℝ)) *
            (if (∑ i, (retainedTupleOccupancy p s + tupleOccupancy q) i) ≤ B then
              f (retainedTupleOccupancy p s + tupleOccupancy q) else 0)) =
      ∑ m ∈ ghostOccupancyBall B,
        (∏ i, ghostKernel (A i) (D i) (C i) (ν i) (tupleOccupancy p i) (m i)) * f m := by
    simpa only [sum_div, mul_sum, div_mul_eq_mul_div, mul_div_assoc, mul_assoc] using
      ordered_ghost_row_eq_kernel_product p A D C ν B f
  apply Complex.ext
  · simpa only [complexOrderedGhostRow, Complex.re_sum, Complex.mul_re,
      Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero, apply_ite,
      Complex.zero_re] using hr (fun m => (F m).re)
  · simpa only [complexOrderedGhostRow, Complex.im_sum, Complex.mul_im,
      Complex.ofReal_re, Complex.ofReal_im, zero_mul, add_zero, apply_ite,
      Complex.zero_im] using hr (fun m => (F m).im)

/- The total-size cutoff inside the existing bounded occupancy state space. -/
noncomputable def ghostBoundedTotalCutoff {ι : Type*} [Fintype ι] [DecidableEq ι]
    (B : ℕ) : Finset (ι → Fin (B + 1)) :=
  univ.filter (fun x => (∑ i, (x i : ℕ)) ≤ B)

/- Extend a bounded occupancy test by zero outside its coordinate box. -/
noncomputable def ghostBoundedTest {ι : Type*} [Fintype ι] (B : ℕ)
    (f : (ι → Fin (B + 1)) → ℂ) (m : ι → ℕ) : ℂ :=
  if h : ∀ i, m i ≤ B then f (fun i => ⟨m i, Nat.lt_succ_of_le (h i)⟩) else 0

theorem ghostBoundedTest_coe {ι : Type*} [Fintype ι] (B : ℕ)
    (f : (ι → Fin (B + 1)) → ℂ) (x : ι → Fin (B + 1)) :
    ghostBoundedTest B f (fun i => (x i : ℕ)) = f x := by
  unfold ghostBoundedTest
  rw [dif_pos (fun i => Nat.le_of_lt_succ (x i).isLt)]

/- Natural occupancy vectors in the total-size ball give exactly the same
kernel row as bounded `Fin` occupancies in `ghostMemoryAction`. -/
theorem ghost_nat_row_eq_memory_action {ι : Type*} [Fintype ι] [DecidableEq ι]
    (B : ℕ) (A D C ν : ι → ℝ) (f : (ι → Fin (B + 1)) → ℂ)
    (x : ι → Fin (B + 1)) :
    (∑ m ∈ ghostOccupancyBall B,
      ((∏ i, ghostKernel (A i) (D i) (C i) (ν i) (x i) (m i) : ℝ) : ℂ) *
        ghostBoundedTest B f m) =
      ghostMemoryAction (ghostBoundedTotalCutoff B) A D C ν f x := by
  classical
  symm
  unfold ghostMemoryAction
  apply sum_bij (fun y _ => fun i => (y i : ℕ))
  · intro y hy
    apply (mem_ghostOccupancyBall B _).mpr
    simpa only [ghostBoundedTotalCutoff, mem_filter, mem_univ, true_and] using hy
  · intro y hy z hz heq
    funext i
    exact Fin.ext (congrFun heq i)
  · intro m hm
    have htotal := (mem_ghostOccupancyBall B m).mp hm
    have hbound (i : ι) : m i ≤ B :=
      (single_le_sum (fun j _ => Nat.zero_le (m j)) (mem_univ i)).trans htotal
    let y : ι → Fin (B + 1) := fun i => ⟨m i, Nat.lt_succ_of_le (hbound i)⟩
    refine ⟨y, ?_, rfl⟩
    simpa only [ghostBoundedTotalCutoff, mem_filter, mem_univ, true_and] using htotal
  · intro y hy
    rw [ghostBoundedTest_coe]
    simp only [ghostMemoryKernel, Complex.ofReal_prod]




/- A canonical ordered representative of a bounded occupancy vector. -/
noncomputable def ghostOccupancyTuple {ι : Type*} [Fintype ι] {B : ℕ}
    (x : ι → Fin (B + 1)) :
    Fin (Fintype.card (Σ i, Fin (x i : ℕ))) → ι :=
  fun j => ((Fintype.equivFin (Σ i, Fin (x i : ℕ))).symm j).1

theorem ghostOccupancyTuple_occupancy {ι : Type*} [Fintype ι] [DecidableEq ι]
    {B : ℕ} (x : ι → Fin (B + 1)) :
    tupleOccupancy (ghostOccupancyTuple x) = fun i => (x i : ℕ) := by
  unfold tupleOccupancy ghostOccupancyTuple
  rw [(Fintype.equivFin (Σ i, Fin (x i : ℕ))).symm.sum_comp
    (fun a : Σ i, Fin (x i : ℕ) => (Pi.single a.1 1 : ι → ℕ))]
  rw [Fintype.sum_sigma]
  ext i
  simp [Finset.sum_apply, Pi.single_apply]









end

