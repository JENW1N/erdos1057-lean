section

/- Finite injection from unbalanced prime-factor proxy sums into candidate prime-band rough mass. -/

open Finset

namespace Bounty

theorem prime_cofactor_rough_product {W : ℝ} {p m u : ℕ}
    (hp : p.Prime) (hpW : W < (p : ℝ)) (hprod : p * m = 2 * u + 1)
    (hm : ∀ q ∈ m.primeFactors, W < (q : ℝ)) :
    ∀ q ∈ (2 * u + 1).primeFactors, W < (q : ℝ) := by
  have hm0 : m ≠ 0 := by intro hzero; simp only [hzero, mul_zero] at hprod; omega
  rw [← hprod, Nat.primeFactors_mul hp.ne_zero hm0, hp.primeFactors]
  intro q hq
  rcases mem_union.mp hq with hqp | hqm
  · simpa only [mem_singleton.mp hqp] using hpW
  · exact hm q hqm

theorem prime_cofactor_to_shifted_index_injective (F : Finset (ℕ × ℕ))
    (u : ℕ × ℕ → ℕ) (hpos : ∀ v ∈ F, 0 < v.1)
    (hprod : ∀ v ∈ F, v.1 * v.2 = 2 * u v + 1) :
    Set.InjOn (fun v : ℕ × ℕ => (v.1, u v)) F := by
  intro x hx y hy hxy
  have hpair : (x.1, u x) = (y.1, u y) := hxy
  have hp := congrArg (fun z : ℕ × ℕ => z.1) hpair
  have hu := congrArg (fun z : ℕ × ℕ => z.2) hpair
  change x.1 = y.1 at hp
  change u x = u y at hu
  have hmul : x.1 * x.2 = x.1 * y.2 := by rw [hprod x hx, hp, hprod y hy, hu]
  exact Prod.ext hp (Nat.eq_of_mul_eq_mul_left (hpos x hx) hmul)

theorem finite_prime_factor_proxy_bound (T Q : Finset ℕ) (F : Finset (ℕ × ℕ))
    (μ f : ℕ → ℝ) (u : ℕ × ℕ → ℕ) {W C : ℝ} (hC : 0 ≤ C)
    (hμ : ∀ v ∈ T, 0 ≤ μ v)
    (hQ : ∀ p ∈ Q, p.Prime ∧ W < (p : ℝ))
    (hdata : ∀ v ∈ F, u v ∈ T ∧ v.1 ∈ Q ∧ v.1 * v.2 = 2 * u v + 1)
    (hf : ∀ v ∈ F, 0 ≤ f v.2 ∧ f v.2 ≤ C)
    (hrough : ∀ v ∈ F, f v.2 ≠ 0 → ∀ p ∈ v.2.primeFactors, W < (p : ℝ)) :
    (∑ v ∈ F, μ (u v) * f v.2) ≤
      C * ∑ p ∈ Q, ∑ v ∈ (shiftedRoughSet T W).filter (fun v => p ∣ 2 * v + 1), μ v := by
  classical
  let G := F.filter (fun v => f v.2 ≠ 0)
  let H := (Q ×ˢ shiftedRoughSet T W).filter (fun v => v.1 ∣ 2 * v.2 + 1)
  let φ := fun v : ℕ × ℕ => (v.1, u v)
  have hinj : Set.InjOn φ G :=
    (prime_cofactor_to_shifted_index_injective F u
      (fun v hv => (hQ v.1 (hdata v hv).2.1).1.pos)
      (fun v hv => (hdata v hv).2.2)).mono (filter_subset _ _)
  have hmap : G.image φ ⊆ H := by
    intro x hx
    obtain ⟨v, hv, rfl⟩ := mem_image.mp hx
    obtain ⟨hvF, hvf⟩ := mem_filter.mp hv
    obtain ⟨huT, hpQ, hprod⟩ := hdata v hvF
    obtain ⟨hpp, hpW⟩ := hQ v.1 hpQ
    have huR : u v ∈ shiftedRoughSet T W := (mem_shifted_rough_set_iff T W (u v)).mpr
      ⟨huT, prime_cofactor_rough_product hpp hpW hprod (hrough v hvF hvf)⟩
    apply mem_filter.mpr
    refine ⟨mem_product.mpr ⟨hpQ, huR⟩, ?_⟩
    change v.1 ∣ 2 * u v + 1
    rw [← hprod]
    exact dvd_mul_right _ _
  have hsum : (∑ v ∈ F, μ (u v) * f v.2) = ∑ v ∈ G, μ (u v) * f v.2 := by
    symm
    apply sum_subset (filter_subset _ _)
    intro v hv hnot
    have hz : f v.2 = 0 := by
      by_contra hn
      exact hnot (mem_filter.mpr ⟨hv, hn⟩)
    rw [hz, mul_zero]
  have hμsum : (∑ v ∈ G, μ (u v)) ≤ ∑ x ∈ H, μ x.2 := by
    change (∑ v ∈ G, (fun x : ℕ × ℕ => μ x.2) (φ v)) ≤ _
    rw [← sum_image (f := fun x : ℕ × ℕ => μ x.2) hinj]
    apply sum_le_sum_of_subset_of_nonneg hmap
    intro x hx hnot
    have hxR : x.2 ∈ shiftedRoughSet T W := (mem_product.mp (mem_filter.mp hx).1).2
    exact hμ x.2 ((mem_shifted_rough_set_iff T W x.2).mp hxR).1
  have hH : (∑ x ∈ H, μ x.2) =
      ∑ p ∈ Q, ∑ v ∈ (shiftedRoughSet T W).filter (fun v => p ∣ 2 * v + 1), μ v := by
    simp only [H, sum_filter, sum_product]
  rw [hsum]
  calc
    _ ≤ ∑ v ∈ G, μ (u v) * C := by
      apply sum_le_sum
      intro v hv
      have hvF := (mem_filter.mp hv).1
      exact mul_le_mul_of_nonneg_left (hf v hvF).2 (hμ (u v) (hdata v hvF).1)
    _ = C * ∑ v ∈ G, μ (u v) := by rw [← sum_mul, mul_comm]
    _ ≤ C * ∑ x ∈ H, μ x.2 := mul_le_mul_of_nonneg_left hμsum hC
    _ = _ := by rw [hH]

theorem rough_test_logarithmic_proxy_nonneg (γ L S : ℝ) (n : ℕ) :
    0 ≤ roughTestLogarithmicProxy γ L S n :=
  rough_test_cell_proxy_nonneg γ L S
    (logarithmicCellBase (L ^ (-S)) (logarithmicCellIndex (L ^ (-S)) n)) n

theorem rough_test_logarithmic_proxy_le_coefficient {γ L S C : ℝ} (hC : 0 ≤ C) {n : ℕ}
    (hcoef : roughTestCellProxyCoefficient γ L S
      (logarithmicCellBase (L ^ (-S)) (logarithmicCellIndex (L ^ (-S)) n)) ≤ C) :
    roughTestLogarithmicProxy γ L S n ≤ C := by
  unfold roughTestLogarithmicProxy roughTestCellProxy
  split
  · exact hcoef
  · exact hC

theorem rough_test_logarithmic_proxy_support {γ L S : ℝ} {n : ℕ}
    (hn : roughTestLogarithmicProxy γ L S n ≠ 0) :
    ∀ p ∈ n.primeFactors, Real.exp (Real.sqrt L) < (p : ℝ) := by
  have hmem := rough_test_cell_proxy_ne_zero_mem
    (show roughTestCellProxy γ L S
      (logarithmicCellBase (L ^ (-S)) (logarithmicCellIndex (L ^ (-S)) n)) n ≠ 0 from hn)
  exact (mem_filter.mp hmem).2




theorem candidate_prime_factor_proxy_bound {c L q A B W C : ℝ} (r jStar : ℕ)
    (hq : 0 ≤ q) (hA : 0 ≤ A) (hB : 0 ≤ B) (hWA : W ≤ A) (hC : 0 ≤ C)
    (F : Finset (ℕ × ℕ)) (f : ℕ → ℝ) (u : ℕ × ℕ → ℕ)
    (hdata : ∀ v ∈ F, u v ∈ arithmeticProductWindow 1 (Real.exp L) ∧
      v.1 ∈ primeBand A B ∧ v.1 * v.2 = 2 * u v + 1)
    (hf : ∀ v ∈ F, 0 ≤ f v.2 ∧ f v.2 ≤ C)
    (hrough : ∀ v ∈ F, f v.2 ≠ 0 → ∀ p ∈ v.2.primeFactors, W < (p : ℝ)) :
    (∑ v ∈ F, candidateCoefficient c L q r jStar (u v) * f v.2) ≤
      C * candidatePrimeBandRoughMass c L q r jStar A B W := by
  apply finite_prime_factor_proxy_bound (arithmeticProductWindow 1 (Real.exp L))
    (primeBand A B) F (candidateCoefficient c L q r jStar) f u hC
    (fun n hn => candidate_coefficient_nonneg c L hq r jStar n) _ hdata hf hrough
  intro p hp
  obtain ⟨hpp, hAp, _⟩ := (mem_primeBand_iff hA hB p).mp hp
  exact ⟨hpp, hWA.trans_lt hAp⟩




end Bounty


