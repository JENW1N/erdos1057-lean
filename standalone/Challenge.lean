/- A single nonnegative term of Vandermonde's identity bounds the numerator. -/
theorem hoeffding_retained_choose_mul_le (M m ell j : ℕ)
    (hmj : m ≤ j) (hjM : j + ell ≤ M) :
    (M - m - ell).choose (j - m) * (m + ell).choose m ≤ M.choose j := by
  have hsum := Nat.add_choose_eq (M - m - ell) (m + ell) j
  have hadd : M - m - ell + (m + ell) = M := by omega
  rw [hadd] at hsum
  rw [hsum]
  exact single_le_sum (f := fun ij : ℕ × ℕ => (M - m - ell).choose ij.1 * (m + ell).choose ij.2) (fun _ _ => Nat.zero_le _)
    (show (j - m, m) ∈ antidiagonal j from by
      rw [Finset.HasAntidiagonal.mem_antidiagonal]
      omega)

/- A crude binomial lower bound is enough for the required polynomial decay. -/
theorem hoeffding_probe_power_le_choose (m ell : ℕ) :
    m ^ ell ≤ ell ^ ell * (m + ell).choose m := by
  have h := Nat.pow_sub_le_descFactorial (m + ell) ell
  have hsub : m + ell + 1 - ell = m + 1 := by omega
  rw [hsub, Nat.descFactorial_eq_factorial_mul_choose] at h
  calc
    m ^ ell ≤ (m + 1) ^ ell := Nat.pow_le_pow_left (by omega) ell
    _ ≤ ell.factorial * (m + ell).choose ell := h
    _ ≤ ell ^ ell * (m + ell).choose ell :=
      Nat.mul_le_mul_right _ (Nat.factorial_le_pow ell)
    _ = _ := by rw [Nat.choose_symm_add]















