theorem eisensteinTorusMul_measurePreserving (b : ActualEisensteinCubic.O) (hb : b≠0) :
    letI explicitWitness16 := @OAI.CubicEisenstein.instMeasureSpaceUnitAddCircle_oAI_2
    MeasurePreserving (eisensteinTorusMul b) volume volume :=
  letI explicitWitness35 := @OAI.CubicEisenstein.instIsAddHaarMeasureUnitAddCircleVolume_oAI_2
  letI explicitWitness16 := @OAI.CubicEisenstein.instMeasureSpaceUnitAddCircle_oAI_2
