theorem harmonic_two_errors_absorb {L D : ℝ} (hL : 2 ≤ L) :
    L^(-D-1)+L^(-D-1) ≤ L^(-D) := by
  have hL0 : 0 < L := by linarith
  calc
    _ = 2*L^(-D-1) := by ring
    _ ≤ L*L^(-D-1) := mul_le_mul_of_nonneg_right hL (Real.rpow_nonneg hL0.le _)
    _ = _ := by
      nth_rw 1 [← Real.rpow_one L]
