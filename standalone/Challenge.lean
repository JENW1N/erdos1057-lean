section

/- The actual count-matched roughness proxy on the common Mertens density scale. -/

open Filter Real
open scoped Topology

namespace Bounty

theorem density_ratio_error_bound {N D q K C η ε : ℝ}
    (hK : 0 < K) (hq : K/2 ≤ q) (hD : 0 ≤ D) (hDC : D ≤ C)
    (hη : 0 ≤ η) (hε : 0 ≤ ε) (hN : |N-D| ≤ η) (hQ : |q-K| ≤ η)
    (hsmall : (K+C)*η ≤ ε*(K*K/2)) : |N/q-D/K| ≤ ε := by
  have hq0 : 0 < q := (half_pos hK).trans_le hq
  rw [div_sub_div _ _ hq0.ne' hK.ne', abs_div, abs_of_pos (mul_pos hq0 hK)]
  apply (div_le_iff₀ (mul_pos hq0 hK)).mpr
  calc
    |N*K-q*D| = |K*(N-D)+D*(K-q)| := by congr 1; ring
    _ ≤ |K*(N-D)|+|D*(K-q)| := abs_add_le _ _
    _ = K*|N-D|+D*|q-K| := by
      rw [abs_mul, abs_mul, abs_of_pos hK, abs_of_nonneg hD, abs_sub_comm K q]
    _ ≤ K*η+D*η := add_le_add (mul_le_mul_of_nonneg_left hN hK.le)
      (mul_le_mul_of_nonneg_left hQ hD)
    _ ≤ (K+C)*η := by nlinarith
    _ ≤ ε*(K*K/2) := hsmall
    _ ≤ ε*(q*K) := by
      apply mul_le_mul_of_nonneg_left _ hε
      nlinarith

theorem eventually_sqrt_rough_test_proxy_coefficient_error
    {S a b γ₀ gap ε : ℝ} (hS : 0 ≤ S) (ha : 0 < a) (hγ₀ : 0 < γ₀)
    (hgap : 0 < gap) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ w γ : ℝ,
      a ≤ w → w ≤ b → γ₀ ≤ γ → gap ≤ w-γ →
      |sqrt L*roughTestCellProxyCoefficient γ L S (exp (w*L))-
        buchstabDensity γ w/Mertens.primeProductLimitConstant| ≤ ε := by
  let K := Mertens.primeProductLimitConstant
  have hK : 0 < K := Mertens.prime_product_limit_constant_pos
  obtain ⟨C, hC, hbound⟩ := buchstab_density_rectangle_bound
    (γ₁ := b) (w₁ := b) hγ₀ ha
  let η := min (K/2) (ε*(K*K)/(2*(K+C)))
  have hη : 0 < η := lt_min (half_pos hK) (by positivity)
  have hηK : η ≤ K/2 := min_le_left _ _
  have hηε : (K+C)*η ≤ ε*(K*K/2) := by
    have h := (le_div_iff₀ (show 0 < 2*(K+C) by positivity)).mp (min_le_right (K/2)
      (ε*(K*K)/(2*(K+C))))
    dsimp [η]
    nlinarith
  filter_upwards [eventually_normalized_rough_buchstab_error hS ha hγ₀ hgap hη,
    eventually_sqrt_normalized_rough_base_error ha hη S,
    eventually_gt_atTop (0 : ℝ)] with L hnum hden hL
  intro w γ hw hwb hγ hsep
  have hγb : γ ≤ b := by linarith
  obtain ⟨hD, hDC⟩ := hbound γ w hγ hγb hw hwb
  have hY : exp (a*L) ≤ exp (w*L) :=
    exp_le_exp.mpr (mul_le_mul_of_nonneg_right hw hL.le)
  have hQ := hden (exp (w*L)) hY
  have hN := hnum w γ hw hwb hγ hsep
  have hq : K/2 ≤ normalizedRoughCellCount L S (exp (w*L)) (exp (sqrt L))/sqrt L := by
    have hh := (abs_le.mp hQ).1
    change -η ≤ normalizedRoughCellCount L S (exp (w*L)) (exp (sqrt L))/sqrt L-K at hh
    linarith
  have hr := density_ratio_error_bound hK hq hD hDC hη.le hε.le hN hQ hηε
  have hs : sqrt L ≠ 0 := (sqrt_pos.2 hL).ne'
  have hc : logarithmicCellCountScale L S (exp (w*L)) ≠ 0 :=
    (logarithmic_cell_count_scale_pos (S := S) hL (exp_pos _)).ne'
  have hid : normalizedRoughCellCount L S (exp (w*L)) (exp (γ*L)) /
      (normalizedRoughCellCount L S (exp (w*L)) (exp (sqrt L))/sqrt L) =
      sqrt L*roughTestCellProxyCoefficient γ L S (exp (w*L)) := by
    unfold normalizedRoughCellCount roughTestCellProxyCoefficient
    field_simp
  rwa [hid] at hr




theorem eventually_rough_test_proxy_coefficient_upper
    {S a b γ₀ gap ε : ℝ} (hS : 0 ≤ S) (ha : 0 < a) (hγ₀ : 0 < γ₀)
    (hgap : 0 < gap) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ w γ : ℝ,
      a ≤ w → w ≤ b → γ₀ ≤ γ → gap ≤ w-γ →
      roughTestCellProxyCoefficient γ L S (exp (w*L)) ≤
        (buchstabDensity γ w+ε)/(Mertens.primeProductLimitConstant*sqrt L) := by
  have hK := Mertens.prime_product_limit_constant_pos
  filter_upwards [eventually_sqrt_rough_test_proxy_coefficient_error
    (b := b) hS ha hγ₀ hgap (div_pos hε hK),
    eventually_gt_atTop (0 : ℝ)] with L hraw hL
  intro w γ hw hwb hγ hsep
  have hh := (abs_le.mp (hraw w γ hw hwb hγ hsep)).2
  have hs := sqrt_pos.2 hL
  apply (le_div_iff₀ (mul_pos hK hs)).mpr
  have ht : sqrt L*roughTestCellProxyCoefficient γ L S (exp (w*L)) ≤
      (buchstabDensity γ w+ε)/Mertens.primeProductLimitConstant := by
    rw [add_div]
    linarith
  have hu := (le_div_iff₀ hK).mp ht
  nlinarith

end Bounty
