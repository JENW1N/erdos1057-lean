/- Literal logarithmic phases and the original finite pattern family preserve
the direct unshared prime-kernel bounds, without shared-completion premises. -/

open Finset Classical
namespace Bounty

section Envelope
variable {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
  (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
  (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ) (hξ : 0 < ξ)

include hξ

theorem physical_unshared_prime_three_phase_norm_le
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (u v : GroupMarkedLists P (fun g => ell + (repeatedBigPrimePatternCut probes r t i g).card))
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
    (a b c : ℝ) (w z d : ℕ) :
    let kept := fun U : Finset (RepeatedBigFlatIndex G J ell) =>
      primeProductRetainedCells (fun j : U => P j.val.1) (fun j => V j.val.1) h ξ
    ‖(repeatedBigPrimePatternWeight probes r t i *
      physicalUnsharedPrimePatternKernel P V probes r t hrt Q h kept i u v aux) *
        physicalPhase a w * physicalPhase b z * physicalPhase c d‖ ≤
      repeatedBigPrimePatternBound probes r t Q ξ i := by
  intro kept
  simpa only [norm_mul, physical_phase_norm, mul_one] using
    physical_unshared_weighted_prime_pattern_norm_le P V probes r t hrt Q h ξ hξ i u v aux







end Envelope
end Bounty
