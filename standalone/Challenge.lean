section

/- The fourth divisor moment controls an invariant endpoint on every divisibility fibre. -/

open Finset

namespace Bounty

theorem natural_log_mono {a b : ℕ} (hab : a ≤ b) : Real.log a ≤ Real.log b := by
  by_cases ha : a = 0
  · simpa [ha] using Real.log_natCast_nonneg b
  · exact Real.log_le_log (by exact_mod_cast Nat.pos_of_ne_zero ha) (by exact_mod_cast hab)

theorem divisor_fourth_moment_quotient (S : Finset ℕ) (d N : ℕ)
    (hdiv : ∀ n ∈ S, d ∣ n) (hN : ∀ n ∈ S, n ≤ N) :
    (∑ n ∈ S, ((n / d).divisors.card : ℝ) ^ 4) ≤
      ((N : ℝ) / d) * (1 + Real.log N) ^ 15 := by
  by_cases hd : d = 0
  · simp [hd]
  have hmoment := divisor_fourth_moment_injective S (fun n => n / d) (N / d)
    (by
      intro a ha b hb hab
      have hae := Nat.mul_div_cancel' (hdiv a ha)
      have hbe := Nat.mul_div_cancel' (hdiv b hb)
      dsimp at hab
      rw [hab, hbe] at hae
      exact hae.symm)
    (by intro n hn; exact Nat.div_le_div_right (hN n hn))
  apply hmoment.trans
  apply mul_le_mul
  · exact Nat.cast_div_le
  · exact pow_le_pow_left₀ (by positivity) (by
      linarith [natural_log_mono (Nat.div_le_self N d)]) 15
  · positivity
  · positivity

theorem prime_pool_free_part_divisors_le (P : Finset ℕ) (n : ℕ) :
    (primePoolFreePart P n).divisors.card ≤ n.divisors.card := by
  by_cases hn : n = 0
  · simp [hn, primePoolFreePart]
  · apply card_le_card
    exact Nat.divisors_subset_of_dvd hn
      (Nat.div_dvd_of_dvd (primePoolPart_dvd P n))

section

variable
  (P : Finset ℕ)
  (α β γ : ℕ → ℂ)
  {A B C : ℝ}
  (hA : 0 ≤ A)
  (hB : 0 ≤ B)
  (hC : 0 ≤ C)
  (hα : ∀ m, ‖α m‖ ≤ A)
  (hβ : ∀ p, ‖β p‖ ≤ B)
  (hγ : ∀ r, ‖γ r‖ ≤ C)

include P α β γ A B C hA hB hC hα hβ hγ

theorem invariant_triple_endpoint_norm_divisors 
    (n : ℕ) :
    ‖invariantTripleEndpoint P α β γ n‖ ≤
      A * B * C * (n.divisors.card : ℝ) ^ 2 := by
  apply (invariant_triple_endpoint_norm_le P α β γ hA hB hC hα hβ hγ n).trans
  apply mul_le_mul_of_nonneg_left _ (by positivity)
  exact pow_le_pow_left₀ (by positivity) (by exact_mod_cast prime_pool_free_part_divisors_le P n) 2

theorem invariant_triple_endpoint_divisible_energy 
    (S : Finset ℕ) (d N : ℕ) (hd : d ∈ Nat.factoredNumbers P)
    (hdiv : ∀ n ∈ S, d ∣ n) (hN : ∀ n ∈ S, n ≤ N) :
    (∑ n ∈ S, ‖invariantTripleEndpoint P α β γ n‖ ^ 2) ≤
      (A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15 / d := by
  have hnorm (n : ℕ) (hn : n ∈ S) :
      ‖invariantTripleEndpoint P α β γ n‖ ^ 2 ≤
        (A * B * C) ^ 2 * ((n / d).divisors.card : ℝ) ^ 4 := by
    have he := invariant_triple_endpoint_mul_supported hd α β γ (n / d)
    rw [Nat.mul_div_cancel' (hdiv n hn)] at he
    rw [he]
    have hb := invariant_triple_endpoint_norm_divisors P α β γ hA hB hC hα hβ hγ (n / d)
    calc
      _ ≤ (A * B * C * ((n / d).divisors.card : ℝ) ^ 2) ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) hb 2
      _ = _ := by ring
  calc
    _ ≤ ∑ n ∈ S, (A * B * C) ^ 2 * ((n / d).divisors.card : ℝ) ^ 4 :=
      sum_le_sum hnorm
    _ = (A * B * C) ^ 2 * ∑ n ∈ S, ((n / d).divisors.card : ℝ) ^ 4 :=
      (mul_sum ..).symm
    _ ≤ (A * B * C) ^ 2 * (((N : ℝ) / d) * (1 + Real.log N) ^ 15) :=
      mul_le_mul_of_nonneg_left (divisor_fourth_moment_quotient S d N hdiv hN) (sq_nonneg _)
    _ = _ := by ring

end


end Bounty
end

section

/- Exact disintegration over the unchanged small state. The original
residue-valid injective-list measure is retained in every fiber. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_small_big_energy_by_small
    {S X : Type*} [Fintype S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (W : X → ℝ) (F : PhysicalSmallBigState P J ell X → ℂ) :
    physicalSmallBigEnergy V W F =
      ∑ s : PhysicalBareResidueState P J ell,
        (if physicalResidueMarksValid s.1 s.2 then physicalStateMass V J ell else 0) *
          finiteWeightedEnergy W (fun x => F (s, x)) := by
  rw [← physical_small_big_energy_eq]
  unfold finiteWeightedEnergy
  rw [Fintype.sum_prod_type]
  apply sum_congr rfl
  intro s _
  rw [mul_sum]
  apply sum_congr rfl
  intro x _
  unfold physicalSmallBigMeasure
  split_ifs <;> ring

theorem physical_small_big_fiber_energy_le
    {S X : Type*} [Fintype S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (hV : ∀ s, 0 < V s) (W : X → ℝ)
    (F output : PhysicalSmallBigState P J ell X → ℂ) (K : ℝ)
    (hbound : ∀ s, finiteWeightedEnergy W (fun x => output (s, x)) ≤
      K * finiteWeightedEnergy W (fun x => F (s, x))) :
    physicalSmallBigEnergy V W output ≤ K * physicalSmallBigEnergy V W F := by
  rw [physical_small_big_energy_by_small, physical_small_big_energy_by_small, mul_sum]
  apply sum_le_sum
  intro s _
  have hs : 0 ≤ if physicalResidueMarksValid s.1 s.2 then physicalStateMass V J ell else 0 := by
    split_ifs
    · exact (physical_state_mass_pos V hV J ell).le
    · exact le_rfl
  exact (mul_le_mul_of_nonneg_left (hbound s) hs).trans_eq (by ring)

end Bounty
end

section

/- The candidate's next band supplies five active slots. The terminal loss is at most 88 log L. -/

open Finset Real

namespace Bounty

theorem finite_sum_le_of_injective_nonneg {I J : Type*} [Fintype I] [Fintype J]
    [DecidableEq J] (f : I → J) (hf : Function.Injective f)
    (g : J → ℝ) (hg : ∀ j, 0 ≤ g j) : (∑ i, g (f i)) ≤ ∑ j, g j := by
  rw [← sum_image (fun i _ j _ h => hf h)]
  exact sum_le_sum_of_subset_of_nonneg (subset_univ _) (fun j _ _ => hg j)

theorem candidate_allocation_room {c L : ℝ} (hc : 0 < c) (hL : 0 < L)
    (hlog : 0 < log L) {r jStar : ℕ} (hr : 6 ≤ r)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) :
    SmoothAllocationRoom ((candidateQIndices c L).card*r)
      (fun i => log (candidateAllocationValue c L r jStar x i))
      (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val)
      (candidateAllocationActive c L r jStar) (88*log L) := by
  classical
  have hval (i : Fin ((candidateQIndices c L).card*r)) :=
    candidate_Q_slot_log_bounds c L r jStar (candidateAllocationOrder c L r i) (x _).property
  have hv0 (i : Fin ((candidateQIndices c L).card*r)) :
      0 ≤ log (candidateAllocationValue c L r jStar x i) := by
    exact (by positivity : (0 : ℝ) ≤ c*L/2^(candidateAllocationOrder c L r i).1.val).trans
      (hval i).1.le
  have hfuture0 (i : Fin ((candidateQIndices c L).card*r)) :
      0 ≤ smoothAllocationFuture _ (fun k => log (candidateAllocationValue c L r jStar x k))
        (candidateAllocationActive c L r jStar) i := by
    apply sum_nonneg
    intro k hk
    split_ifs
    · exact hv0 k
    · rfl
  apply smooth_allocation_room_of_future_bound
  intro i hai
  let j := (candidateAllocationOrder c L r i).1.val
  let J := ⌊log (c*L/(20*log L))/log 2⌋₊
  have hj : j ≤ J := (mem_Icc.mp (candidateAllocationOrder c L r i).1.property).2
  have hs : 0 < c*L/2^j := by positivity
  have hv : log (candidateAllocationValue c L r jStar x i) ≤ (6/5 : ℝ)*(c*L/2^j) := by
    simpa only [candidateAllocationValue, j, mul_div_assoc] using (hval i).2
  by_cases hjlt : j < J
  · let next : candidateQIndices c L := ⟨j+1, mem_Icc.mpr ⟨Nat.zero_le _, hjlt⟩⟩
    let f : Fin 5 → Fin ((candidateQIndices c L).card*r) := fun k =>
      (candidateAllocationOrder c L r).symm (next, ⟨k.val+1, by have hk := k.isLt; omega⟩)
    have hf : Function.Injective f := by
      intro k k' h
      have hh := congrArg (candidateAllocationOrder c L r) h
      simp only [f, Equiv.apply_symm_apply] at hh
      have he := congrArg (fun z : (candidateQIndices c L) × Fin r => z.2.val) hh
      apply Fin.ext
      dsimp at he
      omega
    have hfi (k : Fin 5) : i < f k := by
      apply candidate_allocation_band_strict
      simp only [f, Equiv.apply_symm_apply, next]
      exact Nat.lt_succ_self j
    have hfa (k : Fin 5) : candidateAllocationActive c L r jStar (f k) = true := by
      simp [candidateAllocationActive, f]
    let g : Fin ((candidateQIndices c L).card*r) → ℝ := fun k =>
      if i < k ∧ candidateAllocationActive c L r jStar k = true
      then log (candidateAllocationValue c L r jStar x k) else 0
    have hg (k) : 0 ≤ g k := by
      dsimp [g]
      split_ifs
      · exact hv0 k
      · rfl
    have hlow (k : Fin 5) : c*L/2^(j+1) ≤ g (f k) := by
      dsimp only [g]
      rw [if_pos ⟨hfi k,hfa k⟩]
      have hh := (hval (f k)).1.le
      simpa only [candidateAllocationValue, f, Equiv.apply_symm_apply, next] using hh
    have hsum : 5*(c*L/2^(j+1)) ≤ smoothAllocationFuture _
        (fun k => log (candidateAllocationValue c L r jStar x k))
        (candidateAllocationActive c L r jStar) i := by
      have hh := (sum_le_sum (fun k (_ : k ∈ (univ : Finset (Fin 5))) => hlow k)).trans
        (finite_sum_le_of_injective_nonneg f hf g hg)
      simpa only [smoothAllocationFuture, g, sum_const, card_univ, Fintype.card_fin, nsmul_eq_mul, Nat.cast_ofNat] using hh
    have he : c*L/2^(j+1) = (c*L/2^j)/2 := by rw [pow_succ, div_mul_eq_div_div]
    rw [he] at hsum
    change log (candidateAllocationValue c L r jStar x i)+c*L/2^j ≤ _
    nlinarith
  · have hjEq : j = J := Nat.le_antisymm hj (Nat.le_of_not_gt hjlt)
    have hlast := candidate_last_band_scale_lt hc hL hlog
    change c*L/2^J < 40*log L at hlast
    rw [← hjEq] at hlast
    have hnonneg := hfuture0 i
    change log (candidateAllocationValue c L r jStar x i)+c*L/2^j ≤ _
    nlinarith

end Bounty
end

section

/- Rough factors are coprime to a smaller nonzero signed determinant. -/

namespace Bounty

section

variable
  {m : ℕ}
  {k : ℤ}
  {W : ℝ}
  (hm : 0 < m)
  (hk : k ≠ 0)
  (hrough : ∀ p ∈ m.primeFactors, W < (p : ℝ))

include m k W hm hk hrough

theorem typeII_rough_coprime_natAbs 
    (hsmall : (k.natAbs : ℝ) ≤ W) : Nat.Coprime m k.natAbs := by
  apply Nat.coprime_of_dvd
  intro p hp hpm hpk
  have hlarge := hrough p (Nat.mem_primeFactors.mpr ⟨hp, hpm, hm.ne'⟩)
  have hle : p ≤ k.natAbs := Nat.le_of_dvd (Int.natAbs_pos.mpr hk) hpk
  have hle' : (p : ℝ) ≤ k.natAbs := by exact_mod_cast hle
  linarith

theorem typeII_rough_coprime_determinant 
    (hsmall : |(k : ℝ)| ≤ W) : IsCoprime (m : ℤ) k := by
  rw [Int.isCoprime_iff_nat_coprime, Int.natAbs_natCast]
  apply typeII_rough_coprime_natAbs hm hk hrough
  have habs : (k.natAbs : ℝ) = |(k : ℝ)| := by
    simpa only [Int.cast_abs, Int.cast_natCast] using
      congrArg (fun z : ℤ => (z : ℝ)) (Int.natCast_natAbs k)
  rwa [habs]

end


theorem typeII_determinant_abs_le_of_difference {m m' e : ℕ} {k : ℤ} {E D : ℝ}
    (hE : 0 < E) (he : E ≤ (e : ℝ))
    (hdiff : |(m' : ℝ) - m| ≤ D)
    (hdet : (m' : ℤ) - m = 2 * e * k) : |(k : ℝ)| ≤ D / (2 * E) := by
  have hid : (m' : ℝ) - m = 2 * (e : ℝ) * (k : ℝ) := by exact_mod_cast hdet
  have he0 : 0 ≤ (e : ℝ) := Nat.cast_nonneg e
  have hh : |(m' : ℝ) - m| = 2 * (e : ℝ) * |(k : ℝ)| := by
    rw [hid, abs_mul, abs_of_nonneg (by positivity : 0 ≤ 2 * (e : ℝ))]
  apply (le_div_iff₀ (by positivity : (0 : ℝ) < 2 * E)).mpr
  rw [hh] at hdiff
  nlinarith [abs_nonneg (k : ℝ)]

end Bounty

end

section

/- The actual short-block Gram estimate, with no factor from the total number of positions. -/

open scoped BigOperators InnerProductSpace

namespace Bounty

theorem finite_position_block_gram_bound {X : Type*} [Fintype X]
    (position : X → ℤ) {mass : ℝ} (hmass : 0 ≤ mass)
    (K : X → X → ℂ) (S : Finset ℤ) {H : ℤ} (hH : 0 < H) (f g : ℤ → ℂ)
    (hf : ∀ x, position x ∉ S → f (position x) = 0)
    (hK : ∀ x y, H < |position x - position y| → K x y = 0)
    {M : ℝ} (hM : 0 ≤ M) (hfM : ∀ n ∈ S, ‖f n‖ ≤ M)
    {R : ℕ} (hR : 2 ≤ R) :
    ‖inner ℂ (finitePositionVector position mass f)
      (finiteKernelOperator K (finitePositionVector position mass g))‖ ≤
      ((H.toNat : ℝ) * M ^ 2) ^ (1 / (2 * (R : ℝ))) *
        (3 * ‖finitePositionVector position mass g‖ ^ 2) ^ (1 / 2 : ℝ) *
        (‖finitePositionVector position mass f‖ ^ 2) ^ ((1 - 1 / (R : ℝ)) / 2) *
        (∑ n ∈ S, (inner ℂ (finiteFiberVector position mass n)
          (((finiteKernelOperator K * (finiteKernelOperator K).adjoint) ^ R)
            (finiteFiberVector position mass n))).re) ^ (1 / (2 * (R : ℝ))) := by
  classical
  let J := S.image (fun n => n / H)
  let F : J → EuclideanSpace ℂ X := fun j =>
    finitePositionVector position mass (integerBlockMask id H j.val f)
  let G : J → EuclideanSpace ℂ X := fun j =>
    finitePositionVector position mass (integerBlockNearMask id H j.val g)
  let A := finiteKernelOperator K
  have hbound := finite_endpoint_block_bound A F G
    (fun j (n : S) => integerBlockMask id H j.val f n.val)
    (fun j (n : S) => positionBlockFiber position mass H j.val n.val)
    (fun j => position_block_fiber_sum position mass S H j.val f hf)
    (fun j => position_block_coefficients_bound S hH j.val f hM hfM) hR
  have hfe : (∑ j, ‖F j‖ ^ 2) = ‖finitePositionVector position mass f‖ ^ 2 := by
    rw [Finset.sum_coe_sort J (fun j : ℤ =>
      ‖finitePositionVector position mass (integerBlockMask id H j f)‖ ^ 2)]
    exact position_block_energy_sum position hmass S H f hf
  have hge : (∑ j, ‖G j‖ ^ 2) ≤ 3 * ‖finitePositionVector position mass g‖ ^ 2 := by
    rw [Finset.sum_coe_sort J (fun j : ℤ =>
      ‖finitePositionVector position mass (integerBlockNearMask id H j g)‖ ^ 2)]
    exact position_near_block_energy_sum position hmass J H g
  have htrace := position_block_fiber_trace position mass S H ((A * A.adjoint) ^ R)
  rw [hfe, htrace] at hbound
  have htrace0 : 0 ≤ ∑ n ∈ S, (inner ℂ (finiteFiberVector position mass n)
      (((A * A.adjoint) ^ R) (finiteFiberVector position mass n))).re := by
    apply Finset.sum_nonneg
    intro n _
    apply positive_spectral_moment_nonneg (A * A.adjoint)
      (LinearMap.isSymmetric_self_comp_adjoint A)
    intro v
    rw [Module.End.mul_apply, ← LinearMap.adjoint_inner_left]
    exact inner_self_nonneg (𝕜 := ℂ) (x := A.adjoint v)
  have hpair : ‖inner ℂ (finitePositionVector position mass f)
      (A (finitePositionVector position mass g))‖ ≤ ∑ j, ‖inner ℂ (F j) (A (G j))‖ := by
    rw [position_block_kernel_pairing position hmass K S hH f g hf hK,
      Finset.sum_coe_sort J (fun j : ℤ =>
        ‖inner ℂ (finitePositionVector position mass (integerBlockMask id H j f))
          (A (finitePositionVector position mass (integerBlockNearMask id H j g)))‖)]
    exact norm_sum_le _ _
  apply hpair.trans (hbound.trans ?_)
  dsimp only [A]
  have hpow := Real.rpow_le_rpow
    (Finset.sum_nonneg (fun j _ => sq_nonneg ‖G j‖)) hge (by norm_num : (0 : ℝ) ≤ 1 / 2)
  apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg htrace0 _)
  apply mul_le_mul_of_nonneg_right _ (by positivity)
  exact mul_le_mul_of_nonneg_left hpow (by positivity)

end Bounty
