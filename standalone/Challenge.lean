section

/- Ordinary mean square on a dyad, normalized by its coefficient energy. -/

open Finset Set MeasureTheory Filter

namespace Bounty

theorem dyadic_polynomial_mean_square_le (s : Finset ℕ) (w : ℕ → ℂ)
    {U R V : ℝ} (hU : 1 ≤ U) (hR : 0 ≤ R) (hRU : R ≤ U)
    (hband : ∀ n ∈ s, U ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2 * U)
    (henergy : (∑ n ∈ s, ‖w n‖ ^ 2) ≤ V / U) :
    (∫ t in Set.Icc (-R) R, ‖∑ n ∈ s, w n *
      Complex.exp ((Real.log (n : ℝ) * t : ℝ) * Complex.I)‖ ^ 2) ≤
      (72 * Real.pi * (1 + 2 * (1 + Real.log ⌈2 * U⌉₊)) + 1) * V := by
  have hU0 : 0 < U := zero_lt_one.trans_le hU
  have hN : (⌈2 * U⌉₊ : ℝ) ≤ 3 * U := by
    have hh := Nat.ceil_lt_add_one (by linarith : 0 ≤ 2 * U)
    linarith
  have hs : ∀ n ∈ s, 1 ≤ n ∧ n ≤ ⌈2 * U⌉₊ := by
    intro n hn
    constructor
    · exact_mod_cast hU.trans (hband n hn).1
    · exact_mod_cast (hband n hn).2.trans (Nat.le_ceil (2 * U))
  have hraw := dirichlet_polynomial_mean_square s w ⌈2 * U⌉₊ (-R) R (by linarith) hs
  rw [intervalIntegral.integral_of_le (by linarith : -R ≤ R),
    ← integral_Icc_eq_integral_Ioc] at hraw
  have hlog := Real.log_natCast_nonneg ⌈2 * U⌉₊
  have hcoef : (R - -R) + 4 * (⌈2 * U⌉₊ : ℝ) * (1 + Real.log ⌈2 * U⌉₊) ≤
      (2 + 12 * (1 + Real.log ⌈2 * U⌉₊)) * U := by
    have hh := mul_le_mul_of_nonneg_right hN (by linarith : 0 ≤ 1 + Real.log ⌈2 * U⌉₊)
    nlinarith
  have hpref : 2 + 12 * (1 + Real.log ⌈2 * U⌉₊) ≤
      72 * Real.pi * (1 + 2 * (1 + Real.log ⌈2 * U⌉₊)) + 1 := by
    have hpi := Real.pi_gt_three
    have hh := mul_nonneg (by linarith : 0 ≤ 144 * Real.pi - 12) hlog
    nlinarith
  have hV : 0 ≤ V := by
    have hh : 0 ≤ V / U := (Finset.sum_nonneg (fun _ _ => sq_nonneg _)).trans henergy
    simpa only [zero_mul] using (le_div_iff₀ hU0).mp hh
  calc
    _ ≤ ((R - -R) + 4 * (⌈2 * U⌉₊ : ℝ) * (1 + Real.log ⌈2 * U⌉₊)) *
        ∑ n ∈ s, ‖w n‖ ^ 2 := hraw
    _ ≤ ((2 + 12 * (1 + Real.log ⌈2 * U⌉₊)) * U) * (V / U) :=
      mul_le_mul hcoef henergy (Finset.sum_nonneg (fun _ _ => sq_nonneg _)) (by positivity)
    _ = (2 + 12 * (1 + Real.log ⌈2 * U⌉₊)) * V := by field_simp
    _ ≤ _ := mul_le_mul_of_nonneg_right hpref hV

theorem eventually_dyadic_polynomial_mean_square_power {c C : ℝ} (hc : 0 ≤ c) :
    ∀ᶠ L : ℝ in atTop, ∀ (s : Finset ℕ) (w : ℕ → ℂ) (U R : ℝ),
      1 ≤ U → 0 ≤ R → R ≤ U → Real.log U ≤ c * L →
      (∀ n ∈ s, U ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2 * U) →
      (∑ n ∈ s, ‖w n‖ ^ 2) ≤ L ^ C / U →
      (∫ t in Set.Icc (-R) R, ‖∑ n ∈ s, w n *
        Complex.exp ((Real.log (n : ℝ) * t : ℝ) * Complex.I)‖ ^ 2) ≤ L ^ (C + 2) := by
  filter_upwards [eventually_sparse_logarithmic_prefactor_le_square hc,
    eventually_gt_atTop (0 : ℝ)] with L hbudget hL
  intro s w U R hU hR hRU hlog hband henergy
  have hU0 : 0 < U := zero_lt_one.trans_le hU
  have hNpos : 0 < ⌈2 * U⌉₊ := Nat.ceil_pos.mpr (by linarith)
  have hNU : (⌈2 * U⌉₊ : ℝ) ≤ 4 * U := by
    have hh := Nat.ceil_lt_add_one (by linarith : 0 ≤ 2 * U)
    linarith
  have hpref := hbudget U ⌈2 * U⌉₊ hU0 hNpos hNU hlog
  calc
    _ ≤ (72 * Real.pi * (1 + 2 * (1 + Real.log ⌈2 * U⌉₊)) + 1) * L ^ C :=
      dyadic_polynomial_mean_square_le s w hU hR hRU hband henergy
    _ ≤ L ^ (2 : ℕ) * L ^ C := mul_le_mul_of_nonneg_right hpref (Real.rpow_nonneg hL.le C)
    _ = L ^ (C + 2) := by rw [← Real.rpow_two, ← Real.rpow_add hL]; congr 1; ring

end Bounty
end

