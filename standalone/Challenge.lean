theorem finite_index_period_unfold_of_summable (q:(_root_.OAI.ActualEisensteinCubic.O)) (hq:q≠0) (f:ℂ→ℂ) (hf:Integrable f)
    (hsum:Summable (fun n:(_root_.OAI.ActualEisensteinCubic.O)=>∫z in periodDomain,f (z+3*eisEmbedding n/eisEmbedding q))) :
    (∑'n:(_root_.OAI.ActualEisensteinCubic.O),∫z in periodDomain,f (z+3*eisEmbedding n/eisEmbedding q))=
      (Ideal.absNorm (Ideal.span {q}):ℂ)*(∫z:ℂ,f z) := by
  let : Finite ((_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {q}):=finite_quotient_span hq
  let : Fintype ((_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {q}):=Fintype.ofFinite _
  let I:(_root_.OAI.ActualEisensteinCubic.O)→ℂ:=fun n=>∫z in periodDomain,f (z+3*eisEmbedding n/eisEmbedding q)
  have hinner (r:(_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {q}) :
      (∑'n:((Ideal.Quotient.mk (Ideal.span {q})) ⁻¹' {r}),I n.val)=∫z:ℂ,f z := by
    rw [GaussianFiberEquiv.fiber_tsum q hq r (GaussianShiftedPartition.representative q r)
      (GaussianShiftedPartition.representative_spec q r)]
    let b:=3*eisEmbedding (GaussianShiftedPartition.representative q r)/eisEmbedding q
    have he (n:(_root_.OAI.ActualEisensteinCubic.O)) (z:ℂ) :
        z+3*eisEmbedding (GaussianShiftedPartition.representative q r+q*n)/eisEmbedding q=
          (z+3*eisEmbedding n)+b := by
      dsimp [b]
      simp only [map_add,map_mul]
      field_simp [eisEmbedding_ne_zero hq]
      ;ring
    change (∑'n:(_root_.OAI.ActualEisensteinCubic.O),∫z in periodDomain,f (z+3*eisEmbedding
      (GaussianShiftedPartition.representative q r+q*n)/eisEmbedding q))=_
    simp_rw [he]
    rw [←integral_eq_period_integrals (fun z=>f (z+b)) (hf.comp_add_right b)]
    exact integral_add_right_eq_self f b
  have hsplit:=(hsum.hasSum.tsum_fiberwise (Ideal.Quotient.mk (Ideal.span {q}))).tsum_eq.symm
  change (∑'n:(_root_.OAI.ActualEisensteinCubic.O),I n)=_ at hsplit ⊢
  rw [hsplit]
  change (∑'r:(_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {q},∑'n:((Ideal.Quotient.mk (Ideal.span {q})) ⁻¹' {r}),I n.val)=_
  simp only [hinner,tsum_fintype,Finset.sum_const,Finset.card_univ,nsmul_eq_mul]
  congr 1
  change (Fintype.card ((_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {q}):ℂ)=(Nat.card ((_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {q}):ℂ)
  rw [Nat.card_eq_fintype_card]

lemma finite_index_period_lintegral (q:(_root_.OAI.ActualEisensteinCubic.O)) (hq:q≠0) (f:ℂ→ℝ≥0∞) :
    (∑'n:(_root_.OAI.ActualEisensteinCubic.O),∫⁻z in periodDomain,f (z+3*eisEmbedding n/eisEmbedding q))=
      (Ideal.absNorm (Ideal.span {q}):ℝ≥0∞)*(∫⁻z:ℂ,f z) := by
  let : Finite ((_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {q}):=finite_quotient_span hq
  let : Fintype ((_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {q}):=Fintype.ofFinite _
  let I:(_root_.OAI.ActualEisensteinCubic.O)→ℝ≥0∞:=fun n=>∫⁻z in periodDomain,f (z+3*eisEmbedding n/eisEmbedding q)
  have hinner (r:(_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {q}) :
      (∑'n:((Ideal.Quotient.mk (Ideal.span {q})) ⁻¹' {r}),I n.val)=∫⁻z:ℂ,f z := by
    rw [←(GaussianFiberEquiv.fiberEquiv q hq r (GaussianShiftedPartition.representative q r)
      (GaussianShiftedPartition.representative_spec q r)).tsum_eq]
    change (∑'n:(_root_.OAI.ActualEisensteinCubic.O),∫⁻z in periodDomain,f (z+3*eisEmbedding
      (GaussianShiftedPartition.representative q r+q*n)/eisEmbedding q))=_
    let b:=3*eisEmbedding (GaussianShiftedPartition.representative q r)/eisEmbedding q
    have he (n:(_root_.OAI.ActualEisensteinCubic.O)) (z:ℂ) :
        z+3*eisEmbedding (GaussianShiftedPartition.representative q r+q*n)/eisEmbedding q=
          (z+3*eisEmbedding n)+b := by
      dsimp [b]
      simp only [map_add,map_mul]
      field_simp [eisEmbedding_ne_zero hq]
      ;ring
    simp_rw [he]
    rw [←lintegral_eq_period_lintegrals (fun z=>f (z+b))]
    exact lintegral_add_right_eq_self f b
  change (∑'n:(_root_.OAI.ActualEisensteinCubic.O),I n)=_
  rw [←ENNReal.tsum_fiberwise I (Ideal.Quotient.mk (Ideal.span {q}))]
  simp only [hinner,tsum_fintype,Finset.sum_const,Finset.card_univ,nsmul_eq_mul]
  congr 1
  change (Fintype.card ((_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {q}):ℝ≥0∞)=(Nat.card ((_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {q}):ℝ≥0∞)
  rw [Nat.card_eq_fintype_card]

lemma finite_index_period_integrals_summable (q:(_root_.OAI.ActualEisensteinCubic.O)) (hq:q≠0) (f:ℂ→ℂ) (hf:Integrable f) :
    Summable (fun n:(_root_.OAI.ActualEisensteinCubic.O)=>∫z in periodDomain,f (z+3*eisEmbedding n/eisEmbedding q)) := by
  apply Summable.of_enorm
  apply ne_of_lt
  apply lt_of_le_of_lt (ENNReal.tsum_le_tsum (fun n=>enorm_integral_le_lintegral_enorm _))
  rw [finite_index_period_lintegral q hq (fun z=>‖f z‖ₑ)]
  exact ENNReal.mul_lt_top (by simp) hf.hasFiniteIntegral

theorem finite_index_period_unfold (q:(_root_.OAI.ActualEisensteinCubic.O)) (hq:q≠0) (f:ℂ→ℂ) (hf:Integrable f) :
    (∑'n:(_root_.OAI.ActualEisensteinCubic.O),∫z in periodDomain,f (z+3*eisEmbedding n/eisEmbedding q))=
      (Ideal.absNorm (Ideal.span {q}):ℂ)*(∫z:ℂ,f z) :=
  finite_index_period_unfold_of_summable q hq f hf
    (finite_index_period_integrals_summable q hq f hf)

