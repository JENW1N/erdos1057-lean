theorem finite_dyadic_test_norm_le_one {X : Type*} (π : X → ℕ) (f : X → ℂ)
    (hf : ∀ x, ‖f x‖ ≤ 1) (j : ℕ) (x : X) :
    ‖finiteDyadicTest π j f x‖ ≤ 1 := by
  unfold finiteDyadicTest
  split_ifs
  · exact hf x
  · simp

theorem finite_dyadic_card_le_three_mul {X : Type*} [Fintype X]
    (π : X → ℕ) (hπ : ∀ x, 0 < π x) {L : ℝ} (hL : 1 ≤ L)
    (hlog : ∀ x, Real.log (π x) ≤ L) :
    ((finiteDyadicIndices π).card : ℝ) ≤ 3*L := by
  have hb := finite_dyadic_indices_card_le π hπ (zero_le_one.trans hL) hlog
  have hhalf : (1/2 : ℝ) ≤ Real.log 2 := by linarith [Real.log_two_gt_d9]
  have hdiv : L/Real.log 2 ≤ 2*L := by
    apply (div_le_iff₀ (Real.log_pos (by norm_num : (1 : ℝ)<2))).mpr
    nlinarith
  linarith

