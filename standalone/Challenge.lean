    (sector:ι→Q) (a r:ι→_root_.OAI.ActualEisensteinCubic.O)
    (haPrimary:∀i,lambda^2∣a i-1) (hrPrimary:∀i,lambda^2∣r i-1)
    (hcop:∀i,IsCoprime (a i) (c*r i)) (hr:∀i,IsCoprime (r i) (M*c))
    (ha:∀i j,sector i=sector j→M*c∣a i-a j)
    (hrr:∀i j,sector i=sector j→M∣r i-r j) :
    ∃(b d:ι→_root_.OAI.ActualEisensteinCubic.O) (C:Q→Matrix (Fin 2) (Fin 2) (_root_.OAI.ActualEisensteinCubic.O⧸Ideal.span {M})),
      (∀i,a i*d i-b i*(c*r i)=1) ∧ (∀i,(9:_root_.OAI.ActualEisensteinCubic.O)∣b i) ∧ (∀i,(3:_root_.OAI.ActualEisensteinCubic.O)∣d i-1) ∧
      ∀i,(!![a i,b i;c*r i,d i]:Matrix (Fin 2) (Fin 2) _root_.OAI.ActualEisensteinCubic.O).map
        (Ideal.Quotient.mk (Ideal.span {M}))=C (sector i) := by
  have h3M:(3:_root_.OAI.ActualEisensteinCubic.O)∣M:=(show (3:_root_.OAI.ActualEisensteinCubic.O)∣9 from ⟨3,by norm_num⟩).trans h9M
  have hlocal (q:Q) :
