/- Extend a complex character of the unit group by zero on nonunits. -/
noncomputable def dirichletOfUnitCharacter {L : ℕ} (ξ : (ZMod L)ˣ →* ℂ) :
    DirichletCharacter ℂ L :=
  MulChar.ofUnitHom ξ.toHomUnits

theorem dirichletOfUnitCharacter_apply {L : ℕ} (ξ : (ZMod L)ˣ →* ℂ)
    (u : (ZMod L)ˣ) : dirichletOfUnitCharacter ξ (u : ZMod L) = ξ u := by
  exact MulChar.ofUnitHom_coe ξ.toHomUnits u

/- Extension preserves and reflects principality. -/
theorem dirichletOfUnitCharacter_eq_one_iff {L : ℕ} (ξ : (ZMod L)ˣ →* ℂ) :
    dirichletOfUnitCharacter ξ = 1 ↔ ξ = 1 := by
  constructor
  · intro h
    ext u
    have hu := congrArg (fun χ : DirichletCharacter ℂ L => χ (u : ZMod L)) h
    simpa only [dirichletOfUnitCharacter_apply, MulChar.one_apply_coe,
      MonoidHom.one_apply] using hu
  · intro h
    apply MulChar.ext
    intro u
    rw [dirichletOfUnitCharacter_apply, MulChar.one_apply_coe, h, MonoidHom.one_apply]

theorem dirichletOfUnitCharacter_ne_one {L : ℕ} {ξ : (ZMod L)ˣ →* ℂ}
    (hξ : ξ ≠ 1) : dirichletOfUnitCharacter ξ ≠ 1 :=
  fun h => hξ ((dirichletOfUnitCharacter_eq_one_iff ξ).mp h)

/- Compatible unit labels give exactly the conventional character value on a natural number. -/
theorem dirichletOfUnitCharacter_apply_label {L : ℕ} (ξ : (ZMod L)ˣ →* ℂ)
    {g : ℕ → (ZMod L)ˣ} {p : ℕ} (hcompat : (g p : ZMod L) = p) :
    dirichletOfUnitCharacter ξ (p : ZMod L) = ξ (g p) := by
  rw [← hcompat, dirichletOfUnitCharacter_apply]




theorem dirichletOfUnitCharacter_sum_eq {L : ℕ} (ξ : (ZMod L)ˣ →* ℂ)
    (S : Finset ℕ) (g : ℕ → (ZMod L)ˣ)
    (hcompat : ∀ p ∈ S, (g p : ZMod L) = p) :
    ∑ p ∈ S, dirichletOfUnitCharacter ξ (p : ZMod L) = ∑ p ∈ S, ξ (g p) := by
  apply Finset.sum_congr rfl
  intro p hp
  exact dirichletOfUnitCharacter_apply_label ξ (hcompat p hp)

/- A character-sum estimate stated for Dirichlet characters transfers to compatible unit labels. -/
theorem unitCharacter_sum_bound_of_dirichlet {L : ℕ} (S : Finset ℕ)
    (g : ℕ → (ZMod L)ˣ) (hcompat : ∀ p ∈ S, (g p : ZMod L) = p) {R : ℝ}
    (hbound : ∀ χ : DirichletCharacter ℂ L, χ ≠ 1 → ‖∑ p ∈ S, χ (p : ZMod L)‖ ≤ R)
    (ξ : (ZMod L)ˣ →* ℂ) (hξ : ξ ≠ 1) : ‖∑ p ∈ S, ξ (g p)‖ ≤ R := by
  rw [← dirichletOfUnitCharacter_sum_eq ξ S g hcompat]
  exact hbound _ (dirichletOfUnitCharacter_ne_one hξ)
end

