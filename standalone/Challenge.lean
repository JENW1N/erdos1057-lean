section Boundary
variable {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
  [∀ g, DecidableEq (P g)] {R : (g : Fin N) → P g → Type*}

noncomputable def globalBirthJointInitial (a : (g : Fin N) → P g → Bool) : GlobalBirthJointState R :=
  fun g => (ghostPhaseActivitySupport (a g), globalBirthEmptyMemory)

theorem global_birth_joint_initial_coherent (a : (g : Fin N) → P g → Bool) :
    GlobalBirthJointCoherent a (globalBirthJointInitial (R := R) a) :=
  fun g => global_birth_empty_memory_coherent (ghostPhaseActivitySupport (a g))

theorem global_birth_joint_initial_readout (a : (g : Fin N) → P g → Bool) :
    globalBirthJointReadout a (globalBirthJointInitial (R := R) a) =
      fun g p => if a g p then none else some none := by
  funext g
  exact global_birth_initial_phase (a g)

theorem global_birth_joint_terminal_tensor (a : (g : Fin N) → P g → Bool)
    (s : GlobalBirthJointState R) (hs : GlobalBirthJointCoherent a s) :
    (∏ g, ∏ p, ghostPhaseTerminal (a g p) (globalBirthJointReadout a s g p)) =
      if ∀ g, (s g).2.1 = 0 then 1 else 0 := by
  have he (g : Fin N) : (∏ p, ghostPhaseTerminal (a g p)
      (globalBirthJointReadout a s g p)) = if (s g).2.1 = 0 then 1 else 0 :=
    global_birth_coherent_terminal_tensor (a g) (s g).1 (s g).2 (hs g)
  simp_rw [he]
  by_cases h : ∀ g, (s g).2.1 = 0
  · simp only [h, if_pos, prod_const_one, implies_true]
  · rw [if_neg h]
    obtain ⟨g, hg⟩ := not_forall.mp h
    exact prod_eq_zero (mem_univ g) (if_neg hg)




variable [∀ g p, AddGroup (R g p)] [∀ g p, Fintype (R g p)]
  [∀ g p, DecidableEq (R g p)]

/- The actual joint history with every total input/output cutoff agrees
with the full terminal phase tensor, evaluated at the actual initial state. -/
theorem global_birth_joint_raw_history_empty_boundary
    (a : ℕ → (g : Fin N) → P g → Bool)
    (steps : (i : ℕ) → (g : Fin N) → GlobalBirthRawStep (R := R g) (a i g) (a (i + 1) g))
    (cap : ℕ → ℕ) (n : ℕ) :
    globalBirthJointRawHistory a steps cap n
      (fun s => if ∀ g, (s g).2.1 = 0 then 1 else 0) (globalBirthJointInitial (a 0)) =
      globalBirthJointPhaseHistory a steps cap n
        (fun z => ((∏ g, ∏ p, ghostPhaseTerminal (a n g p) (z g p) : ℝ) : ℂ))
        (fun g p => if a 0 g p then none else some none) := by
  have he := global_birth_joint_raw_history_intertwines a steps cap n
    (fun s => if ∀ g, (s g).2.1 = 0 then (1 : ℂ) else 0)
    (fun z => ((∏ g, ∏ p, ghostPhaseTerminal (a n g p) (z g p) : ℝ) : ℂ))
    (by
      intro s hs
      rw [global_birth_joint_terminal_tensor (a n) s hs]
      split_ifs <;> rfl)
    (globalBirthJointInitial (a 0)) (global_birth_joint_initial_coherent (a 0))
  rw [global_birth_joint_initial_readout] at he
  exact he

end Boundary
