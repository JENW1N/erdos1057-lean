  (hrt : Disjoint r t)
  (Q : ℕ)
  (h ξ : ℝ)

include G sharedInstance1 dG J ell P V probes r t hrt Q h ξ

theorem physical_free_prime_pair_error_zero 
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
    (a b : ℝ) (n k : ℤ)
    (hn : ∀ p ∈ physicalFreePrimeSet (repeatedBigPrimePatternCut probes r t i) aux,
      ¬ (p : ℤ) ∣ n) :
    physicalFreePrimePairError P V probes r t hrt Q h ξ i aux a b
      n.natAbs (n + k * (physicalFreeFactor (repeatedBigPrimePatternCut probes r t i) aux : ℕ)).natAbs = 0 := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  unfold physicalFreePrimePairError
  apply sub_eq_zero.mpr
  exact physical_marked_pair_aux_restriction_eq_signed _ aux n k hn _

theorem physical_free_prime_pair_error_norm_le  (hξ : 0 < ξ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
    (a b : ℝ) (w z : ℕ) :
    ‖physicalFreePrimePairError P V probes r t hrt Q h ξ i aux a b w z‖ ≤
      2 * repeatedBigPrimePatternBound probes r t Q ξ i := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  unfold physicalFreePrimePairError
  dsimp only
  apply (norm_sub_le _ _).trans
  have hH := repeated_big_prime_pattern_bound_nonneg probes r t Q ξ i
  have hr := group_marked_pair_average_norm_le P _ (w : ℤ) (z : ℤ) _ hH
    (fun u v => physical_unshared_prime_pair_coefficient_norm_le
      P V probes r t hrt Q h ξ i aux a b w z hξ u.val v.val)
  have hf := group_marked_pair_average_norm_le P _ (w : ℤ) (z : ℤ) _ hH
    (fun u v => physical_free_prime_pair_coefficient_norm_le
      P V probes r t hrt Q h ξ i aux a b w z hξ u.val v.val)
  exact (add_le_add hr hf).trans_eq (by ring)

end


