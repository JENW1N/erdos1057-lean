section Map
variable {I K X : Type*} (E : K → X → Type*)
  (target : ∀ k x, E k x → X) (tag : I → K)

def finiteEventPathMapEquiv : ∀ ks x,
    FiniteEventPath (fun i => E (tag i)) (fun i => target (tag i)) ks x ≃
      FiniteEventPath E target (ks.map tag) x
  | [], _ => Equiv.refl _
  | i :: ks, x => Equiv.sigmaCongrRight (fun e : E (tag i) x =>
      finiteEventPathMapEquiv ks (target (tag i) x e))

theorem finite_event_path_map_terminal (ks : List I) (x : X)
    (p : FiniteEventPath (fun i => E (tag i)) (fun i => target (tag i)) ks x) :
    finiteEventPathTerminal (fun i => E (tag i)) (fun i => target (tag i)) ks x p =
      finiteEventPathTerminal E target (ks.map tag) x (finiteEventPathMapEquiv E target tag ks x p) := by
  induction ks generalizing x with
  | nil => rfl
  | cons i ks ih =>
    rcases p with ⟨e, p⟩
    exact ih (target (tag i) x e) p

theorem finite_event_path_map_weight (w : ∀ k x, E k x → ℝ) (ks : List I) (x : X)
    (p : FiniteEventPath (fun i => E (tag i)) (fun i => target (tag i)) ks x) :
    finiteEventPathWeight (fun i => E (tag i)) (fun i => target (tag i))
      (fun i => w (tag i)) ks x p =
    finiteEventPathWeight E target w (ks.map tag) x (finiteEventPathMapEquiv E target tag ks x p) := by
  induction ks generalizing x with
  | nil => rfl
  | cons i ks ih =>
    rcases p with ⟨e, p⟩
    exact congrArg (w (tag i) x e * ·) (ih (target (tag i) x e) p)

variable [∀ k x, Fintype (E k x)]

theorem finite_event_path_action_map (w : ∀ k x, E k x → ℝ) (ks : List I)
    (phase : ∀ x, FiniteEventPath (fun i => E (tag i)) (fun i => target (tag i)) ks x → ℂ)
    (F : X → ℂ) :
    finiteEventPathAction (fun i => E (tag i)) (fun i => target (tag i))
      (fun i => w (tag i)) ks phase F =
    finiteEventPathAction E target w (ks.map tag)
      (fun x p => phase x ((finiteEventPathMapEquiv E target tag ks x).symm p)) F := by
  classical
  funext x
  let _ := finiteEventPathFintype (fun i => E (tag i)) (fun i => target (tag i)) ks x
  let _ := finiteEventPathFintype E target (ks.map tag) x
  unfold finiteEventPathAction
  rw [← (finiteEventPathMapEquiv E target tag ks x).symm.sum_comp]
  apply sum_congr rfl
  intro p _
  rw [finite_event_path_map_weight, finite_event_path_map_terminal]
  simp only [Equiv.apply_symm_apply]

end Map
