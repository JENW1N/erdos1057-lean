section

/- The original ghost skeleton sum pays one atom for each fixed marked birth and no address-count factor. -/

open Finset Classical

namespace Bounty

theorem bounded_ghost_marked_coefficient_le {P Z : Type*}
    (A D : Z → ℝ) (hA : ∀ z, 0 ≤ A z)
    (ℓ ε v : ℝ) (hℓ : 0 ≤ ℓ) (hε : 0 ≤ ε) (hv : 0 ≤ v)
    (t B d : ℕ) (s : BoundedOrderedState P Z t B)
    (b : Fin (B + 1)) (r : Finset (Fin s.2.1.val)) :
    (if d ≤ b.val then boundedGhostSkeletonAbsMass A D t B s b r *
      v ^ boundedGhostSkeletonOutputCount t B s b r * ε ^ d * ℓ ^ (b.val - d) else 0) ≤
    (((∏ i ∈ r, A (s.2.2 i)) * (∏ i ∈ univ \ r, |D (s.2.2 i)|)) * v ^ r.card) *
      (if d ≤ b.val then ε ^ d * ℓ ^ (b.val - d) * v ^ b.val / (b.val.factorial : ℝ) else 0) := by
  by_cases hd : d ≤ b.val
  · simp only [hd, if_true]
    by_cases hc : r.card + b.val ≤ B
    · simp only [boundedGhostSkeletonAbsMass, boundedGhostSkeletonOutputCount, hc, if_true]
      rw [abs_div, abs_mul, abs_of_nonneg (prod_nonneg fun i _ => hA _), abs_prod,
        abs_of_nonneg (Nat.cast_nonneg _), pow_add]
      exact (by ring : _ = _).le
    · simp only [boundedGhostSkeletonAbsMass, hc, if_false, zero_mul]
      exact mul_nonneg
        (mul_nonneg (mul_nonneg (prod_nonneg fun i _ => hA _) (prod_nonneg fun i _ => abs_nonneg _))
          (pow_nonneg hv _))
        (div_nonneg (mul_nonneg (mul_nonneg (pow_nonneg hε _) (pow_nonneg hℓ _)) (pow_nonneg hv _))
          (Nat.cast_nonneg _))
  · simp only [hd, if_false, mul_zero, le_refl]

theorem bounded_ghost_marked_length_row_le {P Z : Type*}
    (A D : Z → ℝ) (hA : ∀ z, 0 ≤ A z)
    (ℓ ε v : ℝ) (hℓ : 0 ≤ ℓ) (hε : 0 ≤ ε) (hv : 0 ≤ v)
    (hdamp : ∀ z, A z * v + |D z| ≤ v)
    (t B d : ℕ) (s : BoundedOrderedState P Z t B) :
    (∑ b : Fin (B + 1), ∑ r : Finset (Fin s.2.1.val),
      if d ≤ b.val then boundedGhostSkeletonAbsMass A D t B s b r *
        v ^ boundedGhostSkeletonOutputCount t B s b r * ε ^ d * ℓ ^ (b.val - d) else 0) ≤
      (ε * v) ^ d * Real.exp (ℓ * v) * v ^ s.2.1.val := by
  have hret : 0 ≤ ∏ i : Fin s.2.1.val, (A (s.2.2 i) * v + |D (s.2.2 i)|) :=
    prod_nonneg fun i _ => add_nonneg (mul_nonneg (hA _) hv) (abs_nonneg _)
  calc
    _ ≤ ∑ b : Fin (B + 1), ∑ r : Finset (Fin s.2.1.val),
        (((∏ i ∈ r, A (s.2.2 i)) * (∏ i ∈ univ \ r, |D (s.2.2 i)|)) * v ^ r.card) *
          (if d ≤ b.val then ε ^ d * ℓ ^ (b.val - d) * v ^ b.val / (b.val.factorial : ℝ) else 0) := by
      apply sum_le_sum
      intro b _
      exact sum_le_sum fun r _ => bounded_ghost_marked_coefficient_le A D hA ℓ ε v hℓ hε hv t B d s b r
    _ = (∏ i : Fin s.2.1.val, (A (s.2.2 i) * v + |D (s.2.2 i)|)) *
        ∑ b ∈ range (B + 1), if d ≤ b then ε ^ d * ℓ ^ (b - d) * v ^ b / (b.factorial : ℝ) else 0 := by
      simp_rw [← sum_mul, ghost_retention_length_sum]
      rw [← mul_sum, Fin.sum_univ_eq_sum_range
        (fun b => if d ≤ b then ε ^ d * ℓ ^ (b - d) * v ^ b / (b.factorial : ℝ) else 0) (B + 1)]
    _ ≤ (∏ i : Fin s.2.1.val, (A (s.2.2 i) * v + |D (s.2.2 i)|)) *
        ((ε * v) ^ d * Real.exp (ℓ * v)) :=
      mul_le_mul_of_nonneg_left (marked_ghost_series_le ℓ ε v hℓ hε hv B d) hret
    _ ≤ v ^ s.2.1.val * ((ε * v) ^ d * Real.exp (ℓ * v)) := by
      apply mul_le_mul_of_nonneg_right _ (mul_nonneg (pow_nonneg (mul_nonneg hε hv) _) (Real.exp_pos _).le)
      rw [← Fin.prod_const]
      exact prod_le_prod₀ (fun i _ => add_nonneg (mul_nonneg (hA _) hv) (abs_nonneg _)) (fun i _ => hdamp _)
    _ = _ := by ring

end Bounty
end

section

/- Static selected-child counts agree with performed sample counts when all selected children are covered. -/

open Finset Classical

namespace Bounty

theorem selected_fiber_card {G : Type*} [DecidableEq G] {I : G → Type*}
    [∀ g, Fintype (I g)] {J : Type*} [Fintype J]
    (f : Sigma I ↪ J) (owner selected : J → Prop) [DecidablePred owner] [DecidablePred selected] (group : J → G)
    (howner : ∀ c, owner (f c)) (hgroup : ∀ c, group (f c) = c.1)
    (hcover : ∀ j, owner j → selected j → ∃ c, f c = j) (g : G) :
    (univ.filter (fun i : I g => selected (f ⟨g, i⟩))).card =
      (univ.filter (fun j => owner j ∧ group j = g ∧ selected j)).card := by
  apply card_bij (fun i _ => f ⟨g, i⟩)
  · intro i hi
    simp only [mem_filter, mem_univ, true_and] at hi ⊢
    exact ⟨howner _, hgroup _, hi⟩
  · intro a ha b hb hab
    have he := f.injective hab
    simpa only [Sigma.mk.inj_iff, heq_eq_eq, true_and] using he
  · intro j hj
    simp only [mem_filter, mem_univ, true_and] at hj
    obtain ⟨⟨h, c⟩, hc⟩ := hcover j hj.1 hj.2.2
    have hh : h = g := by
      exact (hgroup ⟨h, c⟩).symm.trans ((congrArg group hc).trans hj.2.1)
    subst h
    refine ⟨c, ?_, hc⟩
    simp only [mem_filter, mem_univ, true_and]
    rw [hc]
    exact hj.2.2




theorem restricted_birth_selected_iff {N m : ℕ} {α : Type*}
    (embed : Fin m → Fin N) (code : BirthForestCode N) (values : Fin N → α) (j : Fin m) :
    (restrictedBirthCode embed code j ≠ none ∨ restrictedBirthAnchors embed code values j ≠ none) ↔
      code (embed j) ≠ none := by
  cases hc : code (embed j) with
  | none => simp [restrictedBirthCode, restrictedBirthAnchors, hc]
  | some p =>
    by_cases he : ∃ k : Fin j.val,
        embed (birthForestParentEmbedding j k) = birthForestParentEmbedding (embed j) p
    · simp [restrictedBirthCode, restrictedBirthAnchors, hc, he]
    · simp [restrictedBirthCode, restrictedBirthAnchors, hc, he]

end Bounty
