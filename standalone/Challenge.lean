theorem harmonic_cell_source_square_energy {Y : ℝ} (hY : 0 < Y)
    (Z a v : ℝ) (F : ℤ → ℂ) :
    (∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellSource Y Z a v F n‖^2) ≤
      64*∑ n ∈ harmonicCommonSupport Y, ‖(harmonicCommonCutoff ((n : ℝ)/Y) : ℂ)*F n‖^2 := by
  rw [mul_sum]
