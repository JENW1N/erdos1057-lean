section

/- Exact packing of original labeled physical paths by their indexed pattern sequence. -/

open Finset
namespace Bounty

section Packing
variable {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    (patterns : Finset I) (C : I → Fin N → Finset (Fin J))

def physicalPathSelectedEquiv :
    (PhysicalMarkLists P J ell ×
      (Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)) ≃
    (Σ pattern : Fin n → patterns, PhysicalSelectedData P ell (fun j => C (pattern j).val)) where
  toFun x :=
    ⟨(fun j => (x.2 j).1.2.2.1), (fun j => (x.2 j).1.2.2.2),
      Fin.cons x.1 (fun j => (x.2 j).2),
      (fun j => (x.2 j).1.1), (fun j => (x.2 j).1.2.1)⟩
  invFun y :=
    (y.2.2.1 0, fun j =>
      ((y.2.2.2.1 j, y.2.2.2.2 j, ⟨y.1 j, y.2.1 j⟩), y.2.2.1 j.succ))
  left_inv x := by
    apply Prod.ext
    · rfl
    · funext j
      change (((x.2 j).1.1, (x.2 j).1.2.1,
        ⟨(x.2 j).1.2.2.1, (x.2 j).1.2.2.2⟩), (x.2 j).2) = x.2 j
      rcases x.2 j with ⟨⟨σ, τ, ⟨i, aux⟩⟩, L⟩
      rfl
  right_inv y := by
    rcases y with ⟨pattern, aux, L, σ, τ⟩
    change (⟨pattern, aux, Fin.cons (L 0) (fun j => L j.succ), σ, τ⟩ :
      Σ pattern : Fin n → patterns, PhysicalSelectedData P ell (fun j => C (pattern j).val)) =
      ⟨pattern, aux, L, σ, τ⟩
    have hL : Fin.cons (L 0) (fun j => L j.succ) = L := by
      funext j
      refine Fin.cases ?_ (fun i => ?_) j <;> rfl
    rw [hL]

theorem physical_path_selected_patterns
    (L : PhysicalMarkLists P J ell)
    (p : Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) :
    (physicalPathSelectedEquiv patterns C (L, p)).1 = fun j => (p j).1.2.2.1 := rfl

theorem physical_path_selected_aux
    (L : PhysicalMarkLists P J ell)
    (p : Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) :
    (physicalPathSelectedEquiv patterns C (L, p)).2.1 = fun j => (p j).1.2.2.2 := rfl




theorem physical_path_selected_marks_succ
    (L : PhysicalMarkLists P J ell)
    (p : Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)
    (j : Fin n) :
    (physicalPathSelectedEquiv patterns C (L, p)).2.2.1 j.succ = (p j).2 := rfl

theorem physical_path_selected_sigma
    (L : PhysicalMarkLists P J ell)
    (p : Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) :
    (physicalPathSelectedEquiv patterns C (L, p)).2.2.2.1 = fun j => (p j).1.1 := rfl




theorem physical_path_selected_marks_eq_finite_path
    (L : PhysicalMarkLists P J ell)
    (p : Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) :
    (physicalPathSelectedEquiv patterns C (L, p)).2.2.1 = fun j => finitePathMarks L p j.val := by
  funext j
  refine Fin.cases ?_ (fun i => ?_) j
  · rfl
  · simp only [physical_path_selected_marks_succ, Fin.val_succ, finitePathMarks, dif_pos i.isLt]




theorem physical_path_selected_inverse_step
    (pattern : Fin n → patterns) (d : PhysicalSelectedData P ell (fun j => C (pattern j).val))
    (j : Fin n) :
    ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d⟩).2 j =
      ((d.2.2.1 j, d.2.2.2 j, ⟨pattern j, d.1 j⟩), d.2.1 j.succ) := rfl

theorem physical_selected_inverse_finite_path_marks
    (pattern : Fin n → patterns) (d : PhysicalSelectedData P ell (fun j => C (pattern j).val)) :
    (fun j : Fin (n + 1) => finitePathMarks
      ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d⟩).1
      ((physicalPathSelectedEquiv patterns C).symm ⟨pattern, d⟩).2 j.val) = d.2.1 := by
  funext j
  refine Fin.cases ?_ (fun i => ?_) j
  · rfl
  · simp only [Fin.val_succ, finitePathMarks, dif_pos i.isLt,
      physical_path_selected_inverse_step]

end Packing
end Bounty
