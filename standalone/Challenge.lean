open Finset Classical
universe u v w

def FiniteEventPath {K : Type u} {X : Type v} (E : K → X → Type w)
    (target : ∀ k x, E k x → X) : List K → X → Type w
  | [], _ => PUnit.{w + 1}
  | k :: ks, x => Σ e : E k x, FiniteEventPath E target ks (target k x e)

noncomputable abbrev finiteEventPathFintype {K : Type u} {X : Type v} (E : K → X → Type w)
    [∀ k x, Fintype (E k x)] (target : ∀ k x, E k x → X) :
    ∀ ks x, Fintype (FiniteEventPath E target ks x)
  | [], _ => inferInstanceAs (Fintype PUnit.{w + 1})
  | k :: ks, x =>
    let _ : ∀ e : E k x, Fintype (FiniteEventPath E target ks (target k x e)) :=
      fun e => finiteEventPathFintype E target ks (target k x e)
    inferInstanceAs (Fintype (Σ e : E k x, FiniteEventPath E target ks (target k x e)))

def finiteEventPathTerminal {K : Type u} {X : Type v} (E : K → X → Type w)
    (target : ∀ k x, E k x → X) : ∀ ks x, FiniteEventPath E target ks x → X
  | [], x, _ => x
  | _ :: ks, _, ⟨_e, p⟩ => finiteEventPathTerminal E target ks _ p

def finiteEventPathWeight {K : Type u} {X : Type v} (E : K → X → Type w)
    (target : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ) :
    ∀ ks x, FiniteEventPath E target ks x → ℝ
  | [], _, _ => 1
  | k :: ks, x, ⟨e, p⟩ => w k x e * finiteEventPathWeight E target w ks _ p




noncomputable def finiteEventPathPositive {K : Type u} {X : Type v} (E : K → X → Type w)
    [∀ k x, Fintype (E k x)] (target : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (ks : List K) (f : X → ℂ) (x : X) : ℂ :=
  let _ := finiteEventPathFintype E target ks x
  ∑ p : FiniteEventPath E target ks x,
    (finiteEventPathWeight E target w ks x p : ℂ) * f (finiteEventPathTerminal E target ks x p)

noncomputable def finiteEventPathAction {K : Type u} {X : Type v} (E : K → X → Type w)
    [∀ k x, Fintype (E k x)] (target : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (ks : List K) (phase : ∀ x, FiniteEventPath E target ks x → ℂ) (f : X → ℂ) (x : X) : ℂ :=
  let _ := finiteEventPathFintype E target ks x
  ∑ p : FiniteEventPath E target ks x,
    (finiteEventPathWeight E target w ks x p : ℂ) * phase x p *
      f (finiteEventPathTerminal E target ks x p)

