        (((u : ℝ) / r + β) * t y) : ℝ))) ^ (a + n.val)‖ ^ 2 ≤
      ((1 + 3 * (V : ℝ) / r) *
        (2 * (N : ℝ) + 2 * (r : ℝ) * (1 + Real.log r))) *
          (∑ n : Fin N, ‖c n‖ ^ 2) * ∑ y, ‖b y‖ ^ 2 := by
  apply circle_bilinear_norm_sq_le (fun y => ((u : ℝ) / r + β) * t y) a N c b
  intro y
  exact rational_phase_fintype_interval_row_sum_le t hinj A V N ht hr hcop hβ
    (((u : ℝ) / r + β) * t y)
