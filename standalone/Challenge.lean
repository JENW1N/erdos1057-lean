section

/- Positivity and total weight of the actual microscopic assignment family. -/

open Finset Filter
open scoped Topology

namespace Bounty

theorem candidate_micro_assignment_product_ne_zero (c L : ℝ) (r jStar J : ℕ)
    (x : ∀ i, candidateMicroAssignmentChoices c L r jStar J i) :
    orderedSlotProduct (candidateMicroAssignmentChoices c L r jStar J) x ≠ 0 := by
  apply prod_ne_zero_iff.mpr
  intro i _
  cases i with
  | inl slot =>
    exact candidate_Q_slot_nonzero c L r jStar
      (⟨slot.1.val, (mem_filter.mp slot.1.property).1⟩, slot.2) (x (Sum.inl slot)).property
  | inr g =>
    exact (mem_filter.mp (x (Sum.inr g)).property).2.ne_zero

theorem eventually_candidate_micro_assignment_total_weight {c : ℝ} (hc : 0 < c) (r J : ℕ)
    (hJ : (12/5 : ℝ)*(r : ℝ)*c/(2 : ℝ)^J ≤ 1/25) :
    ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ,
      (∑ _x : ∀ i, candidateMicroAssignmentChoices c L r jStar J i,
        1 / candidateMicroAssignmentNormalization c L r J) ≤
        Real.exp ((1/20 : ℝ)*L) * candidateMicroQHarmonicMass c L r jStar J := by
  filter_upwards [eventually_candidate_micro_assignment_size hc r J hJ,
    eventually_candidate_micro_assignment_normalization hc] with L hsize hnorm
  intro jStar
  obtain ⟨hnorm0, hnormeq⟩ := hnorm r jStar J
  have hpoint (x : ∀ i, candidateMicroAssignmentChoices c L r jStar J i) :
      1 / candidateMicroAssignmentNormalization c L r J ≤
        Real.exp ((1/20 : ℝ)*L) * ((1 / candidateMicroAssignmentNormalization c L r J) /
          (orderedSlotProduct (candidateMicroAssignmentChoices c L r jStar J) x : ℝ)) := by
    have hD : (0 : ℝ) < orderedSlotProduct (candidateMicroAssignmentChoices c L r jStar J) x :=
      Nat.cast_pos.mpr (Nat.pos_of_ne_zero (candidate_micro_assignment_product_ne_zero c L r jStar J x))
    calc
      _ = (orderedSlotProduct (candidateMicroAssignmentChoices c L r jStar J) x : ℝ) *
          ((1 / candidateMicroAssignmentNormalization c L r J) /
            (orderedSlotProduct (candidateMicroAssignmentChoices c L r jStar J) x : ℝ)) := by field_simp
      _ ≤ _ := mul_le_mul_of_nonneg_right (hsize jStar x) (by positivity)
  calc
    _ ≤ ∑ x : ∀ i, candidateMicroAssignmentChoices c L r jStar J i,
        Real.exp ((1/20 : ℝ)*L) * ((1 / candidateMicroAssignmentNormalization c L r J) /
          (orderedSlotProduct (candidateMicroAssignmentChoices c L r jStar J) x : ℝ)) :=
      sum_le_sum (fun x _ => hpoint x)
    _ = Real.exp ((1/20 : ℝ)*L) *
        (∑ x : ∀ i, candidateMicroAssignmentChoices c L r jStar J i,
          (1 / candidateMicroAssignmentNormalization c L r J) /
          (orderedSlotProduct (candidateMicroAssignmentChoices c L r jStar J) x : ℝ)) := (mul_sum _ _ _).symm
    _ = _ := by rw [hnormeq]

end Bounty
end

section

/- An explicit admissible microscopic cutoff and sieve exponent. -/

namespace Bounty

theorem exists_candidate_micro_cutoff {c : ℝ} (hc : 0 < c) (r : ℕ) :
    ∃ J : ℕ, ∃ θ : ℝ, 0 < θ ∧
      (6/5 : ℝ)*c/(2 : ℝ)^J < θ ∧ θ < 2*c/(2 : ℝ)^J ∧
      10*θ ≤ 1/20 ∧ (12/5 : ℝ)*(r : ℝ)*c/(2 : ℝ)^J ≤ 1/25 := by
  obtain ⟨J, hJ⟩ := pow_unbounded_of_one_lt
    (max (320*c) (60*(r : ℝ)*c)) (by norm_num : (1 : ℝ) < 2)
  have hpow : (0 : ℝ) < 2^J := by positivity
  have hlarge : 320*c < (2 : ℝ)^J := (le_max_left _ _).trans_lt hJ
  have hsize : 60*(r : ℝ)*c < (2 : ℝ)^J := (le_max_right _ _).trans_lt hJ
  refine ⟨J, (8/5 : ℝ)*c/(2 : ℝ)^J, by positivity, ?_, ?_, ?_, ?_⟩
  · exact (div_lt_div_iff_of_pos_right hpow).mpr (by linarith)
  · exact (div_lt_div_iff_of_pos_right hpow).mpr (by linarith)
  · rw [← mul_div_assoc]
    apply (div_le_iff₀ hpow).mpr
    linarith
  · apply (div_le_iff₀ hpow).mpr
    linarith

end Bounty
