/- Common forest constraints on original paths depend only on their completed chronological history. -/

namespace Bounty
section History
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ) (steps : List (Option (J ⊕ K)))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps s)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P))
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))

theorem full_mixed_common_forest_stage_history_iff (u : Fin steps.length) :
    birthForestStageCondition (fullMixedCommonIndexStage M B steps) u.succ
      (fullMixedCommonPathHistory n S B A Δ D steps s p history (u.val + 1)) code ↔
    birthForestStageCondition (fullMixedCommonIndexStage M B steps) u.succ
      (fun i => fullMixedCommonBirthLabel n S B A Δ D steps s p (fullMixedCommonBirthOrder M B steps i)) code := by
  apply birth_forest_stage_congr _ (full_mixed_common_index_stage_monotone M B steps)
  intro i hi
  exact if_pos hi

theorem full_mixed_common_forest_compatible_iff_history_stages
    (hcode : ∀ i, fullMixedCommonIndexStage M B steps i = 0 → code i = none) :
    birthForestCompatible
      (fun i => fullMixedCommonBirthPerformed n S B A Δ D steps s p (fullMixedCommonBirthOrder M B steps i))
      (fun i => fullMixedCommonBirthLabel n S B A Δ D steps s p (fullMixedCommonBirthOrder M B steps i)) code ↔
    ∀ u : Fin steps.length, birthForestStageCondition (fullMixedCommonIndexStage M B steps) u.succ
      (fullMixedCommonPathHistory n S B A Δ D steps s p history (u.val + 1)) code := by
  change birthForestCompatible
    (fun i => (fullMixedCommonBirthLabel n S B A Δ D steps s p (fullMixedCommonBirthOrder M B steps i)).isSome = true) _ _ ↔ _
  rw [birth_forest_compatible_iff_event_stages (fullMixedCommonIndexStage M B steps) code hcode]
  exact forall_congr' fun u => (full_mixed_common_forest_stage_history_iff n S B A Δ D steps s p history code u).symm

end History
