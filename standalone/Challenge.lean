open MeasureTheory Filter

namespace Bounty

theorem eventually_local_mellin_geometric_truncation {c : ℝ} (hc : 0 ≤ c) (B D : ℝ) :
    ∃ j : ℕ, 2 ≤ j ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (Y h : ℝ) (S : Finset ℕ) (a : ℕ → ℂ) (N : ℕ),
      0 < Y → 0 < h → h⁻¹ ≤ Y →
      (∀ n ∈ S, 1 ≤ n ∧ n ≤ N) →
      (N:ℝ) ≤ c*Y → Real.log N ≤ c*L →
      (∑ n ∈ S, ‖a n‖^2) ≤ Y*L^B →
      (∫ t : ℝ, (1+|h*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2) ≤
        (∫ t in {t : ℝ | |t| ≤ L/h}, ‖localMellinPolynomial S a t‖^2)+Y^2*L^(-D) := by
  obtain ⟨j,hj,htrunc⟩ := local_mellin_truncation_power_saving 2 B D
  refine ⟨j,hj,?_⟩
  filter_upwards [eventually_ge_atTop (16:ℝ), eventually_ge_atTop (c*(c+1))] with L hL hcL
  intro Y h S a N hY hh hhi hS hN hlog hE
  apply htrunc L Y h S a N hL hY hh hhi hS _ hE
  have hL1 : 1 ≤ L := by linarith
  have hL0 : 0 ≤ L := by linarith
  have hlog0 : 0 ≤ Real.log N := Real.log_natCast_nonneg N
  calc
    (N:ℝ)*(1+Real.log N) ≤ (c*Y)*(1+c*L) := by gcongr
    _ ≤ (c*Y)*((c+1)*L) := mul_le_mul_of_nonneg_left (by nlinarith) (mul_nonneg hc hY.le)
    _ = Y*(c*(c+1)*L) := by ring
    _ ≤ Y*(L*L) := mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hcL hL0) hY.le
    _ = Y*L^2 := by ring
    _ = Y*L^(2:ℝ) := by rw [Real.rpow_two]

end Bounty
