/- A total local damping at most half the residue modulus leaves a baseline
between one half and one. -/
theorem memory_baseline_bounds {T p : ℝ} (hT : 0 ≤ T) (hp : 0 < p)
    (hTp : 2 * T ≤ p) : 1 / 2 ≤ 1 - T / p ∧ 1 - T / p ≤ 1 := by
  have hlo : 0 ≤ T / p := div_nonneg hT hp.le
  have hhi : T / p ≤ 1 / 2 := (div_le_iff₀ hp).2 (by linarith)
  constructor <;> linarith




/- Dividing by an admissible baseline changes a nonnegative weight by a
factor between one and two. -/
theorem memory_baseline_inv_bounds {b : ℝ} (hb : 1 / 2 ≤ b ∧ b ≤ 1) :
    1 ≤ 1 / b ∧ 1 / b ≤ 2 := by
  have hb0 : 0 < b := by linarith [hb.1]
  constructor
  · exact (le_div_iff₀ hb0).2 (by linarith [hb.2])
  · exact (div_le_iff₀ hb0).2 (by linarith [hb.1])




/- Abstract tilted finite mass: any weights of total mass `V` are multiplied
by at most two when every baseline lies between one half and one. -/
theorem memory_tilted_mass_bounds {ι : Type*} (S : Finset ι) (w b : ι → ℝ)
    (V : ℝ) (hV : 0 < V) (hw : ∀ i ∈ S, 0 ≤ w i)
    (hMass : ∑ i ∈ S, w i = V) (hb : ∀ i ∈ S, 1 / 2 ≤ b i ∧ b i ≤ 1) :
    1 ≤ (∑ i ∈ S, w i / b i) / V ∧ (∑ i ∈ S, w i / b i) / V ≤ 2 := by
  have hterm : ∀ i ∈ S, w i ≤ w i / b i ∧ w i / b i ≤ 2 * w i := by
    intro i hi
    have hbi := memory_baseline_inv_bounds (hb i hi)
    constructor
    · calc
        w i = w i * 1 := by ring
        _ ≤ w i * (1 / b i) := mul_le_mul_of_nonneg_left hbi.1 (hw i hi)
        _ = _ := by ring
    · calc
        w i / b i = w i * (1 / b i) := by ring
        _ ≤ w i * 2 := mul_le_mul_of_nonneg_left hbi.2 (hw i hi)
        _ = _ := by ring
  have hlo : V ≤ ∑ i ∈ S, w i / b i := by
    rw [← hMass]
    exact sum_le_sum (fun i hi => (hterm i hi).1)
  have hhi : (∑ i ∈ S, w i / b i) ≤ 2 * V := by
    rw [← hMass, mul_sum]
    exact sum_le_sum (fun i hi => (hterm i hi).2)
  constructor
  · exact (le_div_iff₀ hV).2 (by simpa using hlo)
  · exact (div_le_iff₀ hV).2 hhi




/- The existing normalized physical label law obeys the same factor-two tilt. -/
theorem memory_tilted_physical_label_mass {G : Type*} {P : G → Finset ℕ}
    (V : G → ℝ) (g : G) (b : P g → ℝ) (hV : 0 < V g)
    (hMass : ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (hb : ∀ p, 1 / 2 ≤ b p ∧ b p ≤ 1) :
    1 ≤ ∑ p : P g, physicalLabelLaw V g p / b p ∧
      (∑ p : P g, physicalLabelLaw V g p / b p) ≤ 2 := by
  have hl : ∀ p : P g, 0 ≤ physicalLabelLaw V g p := by
    intro p
    exact div_nonneg zero_le_one (mul_nonneg hV.le (Nat.cast_nonneg p.val))
  simpa only [div_one] using memory_tilted_mass_bounds univ (physicalLabelLaw V g)
    b 1 zero_lt_one (fun p _ => hl p) (physical_label_law_sum V g hV hMass)
    (fun p _ => hb p)

/- Any finite product of admissible baselines is positive and at most one. -/
theorem memory_baseline_prod_bounds {ι : Type*} (S : Finset ι) (b : ι → ℝ)
    (hb : ∀ i ∈ S, 1 / 2 ≤ b i ∧ b i ≤ 1) :
    0 < ∏ i ∈ S, b i ∧ (∏ i ∈ S, b i) ≤ 1 := by
  have hb0 : ∀ i ∈ S, 0 < b i := by
    intro i hi
    linarith [(hb i hi).1]
  exact ⟨prod_pos hb0, prod_le_one₀ (fun i hi => (hb0 i hi).le) (fun i hi => (hb i hi).2)⟩



end

