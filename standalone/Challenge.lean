section

/- Concrete ambient enlargement and prime-mass lower bound with all spectral errors explicit. -/

open Finset Filter Real

namespace Bounty

noncomputable def ambientBuchstabUnbalancedTest (T : Finset ℕ) (μ : ℕ → ℝ)
    (b q L : ℝ) (N : ℕ) : ℝ :=
  ∑ i : Fin N, ∑ v ∈ shiftedPrimeBandPairs T (exp (reciprocalGrid b q N i*L))
    (exp (reciprocalGrid b q N ((i : ℕ)+1)*L)),
      μ (shiftedPairIndex v)*roughTestIndicator (reciprocalGrid b q N i) L v.2

noncomputable def ambientBuchstabBalancedTest (T : Finset ℕ) (μ : ℕ → ℝ)
    (κ L : ℝ) : ℝ :=
  ∑ v ∈ shiftedBalancedPairs T κ L, μ (shiftedPairIndex v)*
    (if v.1.Prime then 1 else 0 : ℝ)*(if v.2.Prime then 1 else 0 : ℝ)

noncomputable def ambientBuchstabUnbalancedProxy (T : Finset ℕ) (μ : ℕ → ℝ)
    (b q L S : ℝ) (N : ℕ) : ℝ :=
  ∑ i : Fin N, ∑ v ∈ shiftedPrimeBandPairs T (exp (reciprocalGrid b q N i*L))
    (exp (reciprocalGrid b q N ((i : ℕ)+1)*L)),
      μ (shiftedPairIndex v)*roughTestLogarithmicProxy (reciprocalGrid b q N i) L S v.2

noncomputable def ambientBuchstabBalancedProxy (T : Finset ℕ) (μ : ℕ → ℝ)
    (κ L S : ℝ) : ℝ :=
  ∑ v ∈ shiftedBalancedPairs T κ L, μ (shiftedPairIndex v)*
    primeLogarithmicProxy L S v.1*primeLogarithmicProxy L S v.2

noncomputable def ambientBuchstabMeshError (T : Finset ℕ) (μ : ℕ → ℝ)
    (b q κ L S : ℝ) (N : ℕ) : ℝ :=
  (∑ i : Fin N, ambientRoughProxyError T μ (reciprocalGrid b q N i) L S
    (exp (reciprocalGrid b q N i*L)) (exp (reciprocalGrid b q N ((i : ℕ)+1)*L)))+
    ambientPrimeProxyError T μ κ L S

theorem shifted_buchstab_mesh_bin_subset_ambient {T : Finset ℕ}
    (hT : ∀ u ∈ T, 0 < u) (b q L : ℝ) (N i : ℕ) :
    shiftedBuchstabMeshBin T b q L N i ⊆
      shiftedPrimeBandPairs T (exp (reciprocalGrid b q N i*L))
        (exp (reciprocalGrid b q N (i+1)*L)) := by
  intro v hv
  have hm := mem_shifted_buchstab_mesh_bin.mp hv
  apply mem_filter.mpr
  exact ⟨shifted_buchstab_pairs_subset_factor_pairs T _ hT
    (mem_shifted_buchstab_unbalanced_pairs.mp hm.1).1, hm.2⟩

theorem shifted_buchstab_balanced_subset_ambient {T : Finset ℕ}
    (hT : ∀ u ∈ T, 0 < u) {b q κ L : ℝ}
    (hwindow : ∀ v ∈ shiftedBuchstabBalancedPairs T b q L, balancedPairWindow κ L v) :
    shiftedBuchstabBalancedPairs T b q L ⊆ shiftedBalancedPairs T κ L := by
  classical
  intro v hv
  apply mem_filter.mpr
  exact ⟨shifted_buchstab_pairs_subset_factor_pairs T _ hT
    (mem_shifted_buchstab_balanced_pairs.mp hv).1, hwindow v hv⟩

theorem ambient_buchstab_tests_eq_proxy_add_error (T : Finset ℕ) (μ : ℕ → ℝ)
    (b q κ L S : ℝ) (N : ℕ) :
    ambientBuchstabUnbalancedTest T μ b q L N+ambientBuchstabBalancedTest T μ κ L =
      ambientBuchstabUnbalancedProxy T μ b q L S N+ambientBuchstabBalancedProxy T μ κ L S+
        ambientBuchstabMeshError T μ b q κ L S N := by
  unfold ambientBuchstabUnbalancedTest ambientBuchstabBalancedTest
    ambientBuchstabUnbalancedProxy ambientBuchstabBalancedProxy ambientBuchstabMeshError
  simp_rw [ambient_rough_test_sum_eq_proxy_add_error T μ _ L S]
  rw [sum_add_distrib, ambient_prime_test_sum_eq_proxy_add_error T μ κ L S]
  ring

theorem weighted_shifted_ambient_mesh_test_upper (T : Finset ℕ) (μ : ℕ → ℝ)
    {b q κ L : ℝ} (hbq : b ≤ q) (hL : 0 ≤ L) {N : ℕ} (hN : 0 < N)
    (hT : ∀ u ∈ T, 0 < u) (hμ : ∀ u ∈ T, 0 ≤ μ u)
    (hbal : ∀ v ∈ shiftedBuchstabBalancedPairs T b q L,
      v.2.Prime ∧ balancedPairWindow κ L v) :
    (∑ u ∈ shiftedRoughSet T (exp (b*L)), μ u) ≤
      (∑ u ∈ (shiftedRoughSet T (exp (b*L))).filter (fun u => (2*u+1).Prime), μ u)+
      ambientBuchstabUnbalancedTest T μ b q L N+ambientBuchstabBalancedTest T μ κ L := by
  have hU : (∑ i : Fin N, ∑ v ∈ shiftedBuchstabMeshBin T b q L N i, μ (shiftedPairIndex v)) ≤
      ambientBuchstabUnbalancedTest T μ b q L N := by
    apply sum_le_sum
    intro i hi
    apply shifted_buchstab_mesh_bin_le_ambient_rough_test hT _ μ
      (shifted_buchstab_mesh_bin_subset_ambient hT b q L N i)
    intro v hv
    exact hμ _ (shifted_prime_band_pair_data T _ _ hv).1
  have hB := shifted_buchstab_balanced_le_ambient_prime_test hT
    (shiftedBalancedPairs T κ L) μ
    (shifted_buchstab_balanced_subset_ambient hT (fun v hv => (hbal v hv).2))
    (fun v hv => hμ _ (shifted_balanced_pair_data T κ L hv).1)
    (fun v hv => (hbal v hv).1)
  change (∑ v ∈ shiftedBuchstabBalancedPairs T b q L, μ (shiftedPairIndex v)) ≤
    ∑ v ∈ shiftedBalancedPairs T κ L, μ (shiftedPairIndex v)*
      ((if v.1.Prime then 1 else 0)*(if v.2.Prime then 1 else 0)) at hB
  simp only [← mul_assoc] at hB
  have h := weighted_shifted_buchstab_mesh_identity T μ hbq hL hN hT
  change (∑ v ∈ shiftedBuchstabBalancedPairs T b q L, μ (shiftedPairIndex v)) ≤
    ambientBuchstabBalancedTest T μ κ L at hB
  linarith

theorem eventually_shifted_ambient_mesh_prime_lower {κ b : ℝ}
    (hκ : 0 < κ) (hκmax : κ ≤ 1/50) (hb : b ≤ (1/2 : ℝ)-κ)
    {N : ℕ} (hN : 0 < N) :
    ∀ᶠ L : ℝ in atTop, ∀ (μ : ℕ → ℝ) (S : ℝ),
      (∀ u ∈ arithmeticProductWindow 1 (exp L), 0 ≤ μ u) →
      (∑ u ∈ shiftedRoughSet (arithmeticProductWindow 1 (exp L)) (exp (b*L)), μ u)-
        ambientBuchstabUnbalancedProxy (arithmeticProductWindow 1 (exp L)) μ b ((1/2 : ℝ)-κ) L S N-
        ambientBuchstabBalancedProxy (arithmeticProductWindow 1 (exp L)) μ κ L S-
        ambientBuchstabMeshError (arithmeticProductWindow 1 (exp L)) μ b ((1/2 : ℝ)-κ) κ L S N ≤
      ∑ u ∈ (shiftedRoughSet (arithmeticProductWindow 1 (exp L)) (exp (b*L))).filter
        (fun u => (2*u+1).Prime), μ u := by
  filter_upwards [eventually_shifted_buchstab_balanced_prime hκ hκmax,
    eventually_ge_atTop (0 : ℝ)] with L hbalanced hL
  intro μ S hμ
  have hT : ∀ u ∈ arithmeticProductWindow 1 (exp L), 0 < u :=
    fun u hu => arithmetic_product_window_one_pos L hu
  have hbal : ∀ v ∈ shiftedBuchstabBalancedPairs (arithmeticProductWindow 1 (exp L))
      b ((1/2 : ℝ)-κ) L, v.2.Prime ∧ balancedPairWindow κ L v := by
    intro v hv
    have hh := mem_shifted_buchstab_balanced_pairs.mp hv
    exact hbalanced (exp (b*L)) v hh.1 hh.2.le
  have h := weighted_shifted_ambient_mesh_test_upper
    (arithmeticProductWindow 1 (exp L)) μ hb hL hN hT hμ hbal
  have heq := ambient_buchstab_tests_eq_proxy_add_error
    (arithmeticProductWindow 1 (exp L)) μ b ((1/2 : ℝ)-κ) κ L S N
  linarith

end Bounty
end

