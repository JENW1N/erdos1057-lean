open Finset Classical
section

variable {G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  (Δ D : G → ℤ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (t : G → ℕ) (B : ℕ)

noncomputable def unrestrictedProductOperator
    (phase : ∀ g, UnrestrictedBoundedPhase (n g) (Δ g) (D g) (t g) B)
    (groups : Finset G)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ) :=
  finiteCoordinateFinsetAction
    (fun g => unrestrictedBoundedOperator (n g) (Δ g) (D g) (μ g) ρ (V g) (t g) B (phase g))
    groups f

noncomputable def unrestrictedProjectedProductOperator
    (phase : ∀ g, UnrestrictedBoundedPhase (n g) (Δ g) (D g) (t g) B)
    (groups : Finset G)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ) :=
  finiteCoordinateFinsetAction
    (fun g => unrestrictedProjectedOperator (n g) (Δ g) (D g) (μ g) ρ (V g) (t g) B (phase g))
    groups f

noncomputable def unrestrictedCutoffProductOperator
    (phase : ∀ g, UnrestrictedBoundedPhase (n g) (Δ g) (D g) (t g) B)
    (groups : Finset G)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ) :=
  productMemoryCutoff
