theorem two_kernel_supported_rational_bound
    {X Y : Type*} [Fintype X] [Fintype Y]
    (π : X → ℕ) (τ : Y → ℕ) (a N : ℕ) (A : ℤ) (V : ℕ)
    (μ : X → ℝ) (ν : Y → ℝ) (hμ : ∀ x, 0 ≤ μ x) (hν : ∀ y, 0 ≤ ν y)
    (KA : X → X → ℂ) (KB : Y → Y → ℂ) (f : X → ℂ) (g : Y → ℂ)
    (χ : X → ℂ) (ψ : Y → ℂ) (hχ : ∀ x, ‖χ x‖ = 1) (hψ : ∀ y, ‖ψ y‖ = 1)
    (hπrange : ∀ x, finiteKernelTestTransform μ KA f x ≠ 0 → a ≤ π x ∧ π x < a + N)
    (hτrange : ∀ y, finiteKernelTestTransform ν KB g y ≠ 0 →
      A ≤ (τ y : ℤ) ∧ (τ y : ℤ) ≤ A + (V : ℤ))
    {C D P Q BA BB : ℝ} (hC : 0 ≤ C) (hD : 0 ≤ D) (hP : 0 < P) (hQ : 0 < Q)
    (hπ : ∀ x, finiteKernelTestTransform μ KA f x ≠ 0 → P ≤ (π x : ℝ))
    (hτ : ∀ y, finiteKernelTestTransform ν KB g y ≠ 0 → Q ≤ (τ y : ℝ))
    (hEA : (∑ x, μ x * ‖finiteKernelTestTransform μ KA f x‖ ^ 2) ≤
      BA * ∑ x, μ x * ‖f x‖ ^ 2)
    (hEB : (∑ y, ν y * ‖finiteKernelTestTransform ν KB g y‖ ^ 2) ≤
      BB * ∑ y, ν y * ‖g y‖ ^ 2)
    (hμatom : ∀ m : ℕ,
      (∑ x ∈ Finset.univ.filter (fun x => π x = m), μ x) ≤ C / (m : ℝ))
    (hνatom : ∀ m : ℕ,
      (∑ y ∈ Finset.univ.filter (fun y => τ y = m), ν y) ≤ D / (m : ℝ))
    {u : ℤ} {r : ℕ} (hr : 0 < r) (hcop : (r : ℤ).gcd u = 1)
    {β : ℝ} (hβ : |β| ≤ 1 / (r : ℝ) ^ 2) :
    ‖∑ x, ∑ y, ((μ x : ℂ) * f x) * ((ν y : ℂ) * g y) *
      finiteTwoKernelAverage μ ν KA KB x y (fun d e => χ d * ψ e *
        (Complex.exp (Complex.I * (2 * Real.pi *
          (((u : ℝ) / r + β) * τ e) : ℝ))) ^ (π d))‖ ^ 2 ≤
      ((1 + 3 * (V : ℝ) / r) *
        (2 * (N : ℝ) + 2 * (r : ℝ) * (1 + Real.log r))) *
          ((C / P) * BA * ∑ x, μ x * ‖f x‖ ^ 2) *
          ((D / Q) * BB * ∑ y, ν y * ‖g y‖ ^ 2) := by
  rw [finite_two_kernel_pairing_modulated]
  have hb := supported_weighted_product_rational_bilinear_bound π τ a N A V μ ν hμ hν
    (fun x => χ x * finiteKernelTestTransform μ KA f x)
    (fun y => ψ y * finiteKernelTestTransform ν KB g y)
    (fun x hx => hπrange x ((unit_test_modulation_ne_zero_iff χ _ hχ x).mp hx))
    (fun y hy => hτrange y ((unit_test_modulation_ne_zero_iff ψ _ hψ y).mp hy))
    hC hD hP hQ
    (fun x hx => hπ x ((unit_test_modulation_ne_zero_iff χ _ hχ x).mp hx))
    (fun y hy => hτ y ((unit_test_modulation_ne_zero_iff ψ _ hψ y).mp hy))
    hμatom hνatom hr hcop hβ
  rw [unit_test_modulation_energy μ χ _ hχ, unit_test_modulation_energy ν ψ _ hψ] at hb
  have hR : 0 ≤ (1 + 3 * (V : ℝ) / r) *
      (2 * (N : ℝ) + 2 * (r : ℝ) * (1 + Real.log r)) := by
    have hl := Real.log_nonneg (by exact_mod_cast hr : (1 : ℝ) ≤ r)
    positivity
  have hCP : 0 ≤ C / P := div_nonneg hC hP.le
  have hDQ : 0 ≤ D / Q := div_nonneg hD hQ.le
  have hTA : 0 ≤ ∑ x, μ x * ‖finiteKernelTestTransform μ KA f x‖ ^ 2 :=
    Finset.sum_nonneg (fun x _ => mul_nonneg (hμ x) (sq_nonneg _))
  have hTB : 0 ≤ ∑ y, ν y * ‖finiteKernelTestTransform ν KB g y‖ ^ 2 :=
    Finset.sum_nonneg (fun y _ => mul_nonneg (hν y) (sq_nonneg _))
  have hCA := mul_le_mul_of_nonneg_left hEA hCP
  have hCB := mul_le_mul_of_nonneg_left hEB hDQ
  have hbound := mul_le_mul (mul_le_mul_of_nonneg_left hCA hR) hCB
    (mul_nonneg hDQ hTB) (mul_nonneg hR ((mul_nonneg hCP hTA).trans hCA))
  exact hb.trans (by simpa only [mul_assoc] using hbound)
end

